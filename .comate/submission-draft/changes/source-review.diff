@@ -0,0 +1,22 @@
+import { AbilityConstant, ConfigurationConstant, UIAbility, Want } from "@kit.AbilityKit";
+import { window } from "@kit.ArkUI";
+import { IBestUIInitializer } from "ibestui";
+import { ContextUtil } from "util";
+
+/** Test source set only. No main EntryAbility or route graph is changed. */
+export default class FixtureAbility extends UIAbility {
+  onCreate(want: Want, launchParam: AbilityConstant.LaunchParam): void {
+    try {
+      ContextUtil.init(this.context);
+      this.context.getApplicationContext().setColorMode(ConfigurationConstant.ColorMode.COLOR_MODE_NOT_SET);
+    } catch (error) { console.error("[CML24FixtureControl] ability initialization failed"); }
+  }
+
+  onWindowStageCreate(stage: window.WindowStage): void {
+    try {
+      stage.loadContent("pages/GoodsCategoryFixturePage", (): void => {
+        IBestUIInitializer.initIBestUI(stage, this.context);
+      });
+    } catch (error) { console.error("[CML24FixtureControl] fixture page load failed"); }
+  }
+}
diff --git a/entry/src/ohosTest/ets/fixture/FixtureController.ets b/entry/src/ohosTest/ets/fixture/FixtureController.ets
new file mode 100644
index 0000000000000000000000000000000000000000..54db8fa762c5ca87c8e75e71991c3e9c8e6e06bd
--- /dev/null
+++ b/entry/src/ohosTest/ets/fixture/FixtureController.ets
@@ -0,0 +1,92 @@
+import { GoodsRepository } from "data";
+import { GoodsCategoryParam } from "navigation";
+import GoodsCategoryViewModel from "goods/src/main/ets/viewmodel/GoodsCategoryViewModel";
+import { ControlledGoodsDataSource } from "./ControlledGoodsDataSource";
+import { FixtureRequestQueue } from "./FixtureProtocol";
+
+export class FixtureRouteParam implements GoodsCategoryParam {
+  instanceId: number;
+  keyword?: string;
+  typeId?: string;
+  featured?: boolean;
+  recommend?: boolean;
+  minPrice?: string;
+  constructor(instanceId: number, keyword: string, scenario: string) {
+    this.instanceId = instanceId;
+    this.keyword = keyword.trim().length > 0 ? keyword.trim() : undefined;
+    this.typeId = scenario === "root" ? "900001" : undefined;
+    if (scenario === "flags") {
+      this.keyword = this.keyword ?? "X";
+      this.typeId = "920001";
+      this.featured = false;
+      this.recommend = true;
+      this.minPrice = "50";
+    }
+  }
+}
+
+class FixtureSession {
+  vm: GoodsCategoryViewModel;
+  constructor(vm: GoodsCategoryViewModel) { this.vm = vm; }
+}
+
+/** Owns stable instances and actual Navigation actions; no direct VM state manipulation. */
+@ObservedV2
+export class FixtureController {
+  readonly stack: NavPathStack = new NavPathStack();
+  readonly queue: FixtureRequestQueue = new FixtureRequestQueue();
+  @Trace scenario: string = "manual";
+  @Trace keyword: string = "";
+  @Trace result: string = "normal";
+  @Trace requestId: string = "";
+  @Trace currentInstance: number = 0;
+  private sessions: Map<number, FixtureSession> = new Map();
+  private instanceSequence: number = 0;
+
+  reset(): void {
+    this.stack.clear(false);
+    this.queue.note("nav clear");
+    this.open();
+  }
+
+  open(): void {
+    const scenario: string = this.scenario.trim();
+    if (!["manual", "root", "empty", "fullEnd", "missingMeta", "flags"].includes(scenario)) {
+      this.queue.note(`invalid scenario ${scenario}`);
+      return;
+    }
+    const instanceId: number = ++this.instanceSequence;
+    const dataSource: ControlledGoodsDataSource = new ControlledGoodsDataSource(this.queue, instanceId, scenario);
+    this.sessions.set(instanceId, new FixtureSession(new GoodsCategoryViewModel(new GoodsRepository(dataSource))));
+    this.currentInstance = instanceId;
+    const param: FixtureRouteParam = new FixtureRouteParam(instanceId, this.keyword, scenario);
+    this.stack.pushPath({ name: `gcf.goods.${instanceId}`, param: param }, false);
+    this.queue.note(`nav open instance=${instanceId} scenario=${scenario}`);
+  }
+
+  vmFor(instanceId: number): GoodsCategoryViewModel {
+    const session: FixtureSession | undefined = this.sessions.get(instanceId);
+    if (session === undefined) { throw new Error(`missing fixture instance ${instanceId}`); }
+    return session.vm;
+  }
+
+  cover(): void {
+    this.stack.pushPath({ name: "gcf.cover" }, false);
+    this.queue.note("nav cover");
+  }
+
+  back(): void {
+    this.stack.pop(false);
+    this.queue.note("nav pop");
+  }
+
+  resolve(): void {
+    if (!["normal", "empty", "business", "missingMeta", "wrongPage"].includes(this.result.trim())) {
+      this.queue.note(`invalid result ${this.result}`);
+      return;
+    }
+    this.queue.resolve(Number(this.requestId.trim()), this.result.trim());
+  }
+
+  reject(): void { this.queue.reject(Number(this.requestId.trim())); }
+}
diff --git a/entry/src/ohosTest/ets/fixture/FixtureProtocol.ets b/entry/src/ohosTest/ets/fixture/FixtureProtocol.ets
new file mode 100644
index 0000000000000000000000000000000000000000..e4586ae6d6fad425f847fcb46d586fc6775977c6
--- /dev/null
+++ b/entry/src/ohosTest/ets/fixture/FixtureProtocol.ets
@@ -0,0 +1,128 @@
+import { GoodsSearchRequest, NetworkResponse } from "model";
+
+export class FixtureRequestRecord {
+  id: number;
+  instanceId: number;
+  scenario: string;
+  kind: string;
+  request?: GoodsSearchRequest;
+  state: string = "pending";
+  startedAt: number = Date.now();
+  completedAt?: number;
+  responseJson?: string;
+  responseIds: number[] = [];
+  responseCode?: number;
+  error?: string;
+
+  constructor(id: number, instanceId: number, scenario: string, kind: string, request?: GoodsSearchRequest) {
+    this.id = id;
+    this.instanceId = instanceId;
+    this.scenario = scenario;
+    this.kind = kind;
+    if (request !== undefined) {
+      this.request = new GoodsSearchRequest(request);
+      this.request.typeId = request.typeId?.slice();
+    }
+  }
+}
+
+class FixtureAuditEvent {
+  seq: number;
+  event: string;
+  id: number;
+  owner: number;
+  scenario: string;
+  kind: string;
+  request?: GoodsSearchRequest;
+  ids: number[];
+  code?: number;
+  error?: string;
+  at: number = Date.now();
+  constructor(seq: number, event: string, record: FixtureRequestRecord) {
+    this.seq = seq; this.event = event; this.id = record.id; this.owner = record.instanceId;
+    this.scenario = record.scenario; this.kind = record.kind; this.request = record.request;
+    this.ids = record.responseIds.slice(); this.code = record.responseCode; this.error = record.error;
+  }
+}
+
+class FixturePendingOperation {
+  resolve: (result: string) => void;
+  reject: () => void;
+  constructor(resolve: (result: string) => void, reject: () => void) {
+    this.resolve = resolve;
+    this.reject = reject;
+  }
+}
+
+/** External IO control only: does not access a ViewModel or implement paging state. */
+@ObservedV2
+export class FixtureRequestQueue {
+  @Trace records: FixtureRequestRecord[] = [];
+  @Trace eventSeq: number = 0;
+  @Trace lastEvent: string = "idle";
+  private sequence: number = 0;
+  private operations: Map<number, FixturePendingOperation> = new Map();
+
+  get pending(): FixtureRequestRecord[] {
+    return this.records.filter((record: FixtureRequestRecord): boolean => record.state === "pending");
+  }
+
+  enqueue<T>(instanceId: number, scenario: string, kind: string, request: GoodsSearchRequest | undefined,
+    produce: (result: string) => NetworkResponse<T>, responseIds: (data: T | null) => number[]): Promise<NetworkResponse<T>> {
+    const record: FixtureRequestRecord = new FixtureRequestRecord(++this.sequence, instanceId, scenario, kind, request);
+    return new Promise<NetworkResponse<T>>((resolve, reject): void => {
+      this.operations.set(record.id, new FixturePendingOperation((result: string): void => {
+        const response: NetworkResponse<T> = produce(result);
+        record.state = "resolved";
+        record.completedAt = Date.now();
+        record.responseJson = JSON.stringify(response);
+        record.responseIds = responseIds(response.data);
+        record.responseCode = response.code;
+        this.operations.delete(record.id);
+        this.records = this.records.slice();
+        this.log("resolve", record);
+        resolve(response);
+      }, (): void => {
+        record.state = "rejected";
+        record.error = `fixture transport failure ${record.id}`;
+        record.completedAt = Date.now();
+        this.operations.delete(record.id);
+        this.records = this.records.slice();
+        this.log("reject", record);
+        reject(new Error(`fixture transport failure ${record.id}`));
+      }));
+      this.records = [...this.records, record];
+      this.log("request", record);
+    });
+  }
+
+  resolve(id: number, result: string): void {
+    const operation: FixturePendingOperation | undefined = this.operations.get(id);
+    if (operation === undefined) { this.note(`unknown pending request ${id}`); return; }
+    operation.resolve(result);
+  }
+
+  reject(id: number): void {
+    const operation: FixturePendingOperation | undefined = this.operations.get(id);
+    if (operation === undefined) { this.note(`unknown pending request ${id}`); return; }
+    operation.reject();
+  }
+
+  note(message: string): void {
+    this.eventSeq++;
+    this.lastEvent = message;
+    console.info(`[CML24FixtureControl] seq=${this.eventSeq} ${message}`);
+  }
+
+  private log(event: string, record: FixtureRequestRecord): void {
+    this.eventSeq++;
+    this.lastEvent = `${event} id=${record.id} instance=${record.instanceId} kind=${record.kind} page=${record.request?.page ?? 0}`;
+    console.info("[CML24Fixture] " + JSON.stringify(new FixtureAuditEvent(this.eventSeq, event, record)));
+    const text: string = JSON.stringify(record);
+    const count: number = Math.ceil(text.length / 650);
+    for (let index: number = 0; index < count; index++) {
+      console.info(`[CML24FixtureRaw] seq=${this.eventSeq} event=${event} part=${index + 1}/${count} ` +
+        text.substring(index * 650, (index + 1) * 650));
+    }
+  }
+}
