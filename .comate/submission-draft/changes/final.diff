+[{"id":17501,"word":"弊帷不弃","pinyin":"bì wéi bù qì","abbr":"bwbq","explanation":"帷：帐幕。破旧的帐幕也不轻易抛弃。指物品虽已破旧，却有用处。","source":{"text":"仲尼之畜狗死，使子贡埋之，曰：‘吾闻之也，敝帷不弃，为埋马也；敝盖不弃，为埋狗也。’","book":"《礼记·檀弓下》"}},{"id":17502,"word":"弊绝风清","pinyin":"bì jué fēng qīng","abbr":"bjfq","explanation":"弊：坏事；清：洁净。贪污、舞弊的事情没有了。形容坏事绝迹，社会风气良好。","source":{"text":"上安下顺，弊绝风清。","book":"宋·周敦颐《拙赋》"},"example":{"text":"从前的“赌痞”，现在自己在那里禁赌了，农会势盛的地方和牌一样～。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["夜不闭户","道不拾遗"],"opposite":["官官相护","贿赂公行","营私舞弊"],"usage":"作谓语、宾语、定语；形容风气好"},{"id":17503,"word":"弊衣疏食","pinyin":"bì yī shū shí","abbr":"byss","explanation":"破旧的衣着，粗粝的饭食。指生活清苦。","source":{"text":"弊衣疏食，未尝改操。","book":"《周书·柳虯传》"},"similar":["弊衣箪食"],"opposite":["锦衣玉食"],"usage":"作谓语、宾语、定语；指贫困生活"},{"id":17504,"word":"弊衣箪食","pinyin":"bì yī dān shí","abbr":"byds","explanation":"破旧的衣服和粗粝的饭食。指生活清苦。","source":{"text":"其沉默孤微者，亦笃志于章句，以先王之道，饰腐儒之姿，达则不过侍讲训胄，穷则终于弊衣箪食。","book":"《周书·儒林传论》"},"similar":["弊衣疏食"],"opposite":["锦衣玉食"],"usage":"作谓语、宾语、定语；指贫困生活"},{"id":17505,"word":"弊衣蔬食","pinyin":"bì yī shū shí","abbr":"byss","explanation":"破旧的衣服和粗粝的饭食。指生活俭朴。同“弊衣箪食”。","source":{"text":"弊衣蔬食，未尝到改操。","book":"《周书·柳虯传》"},"example":{"text":"我们现在体会不到～的艰苦。"},"similar":["弊衣疏食"],"opposite":["锦衣玉食"],"usage":"作谓语、宾语、定语；指贫困生活"},{"id":17506,"word":"弊车羸马","pinyin":"bì chē léi mǎ","abbr":"bclm","explanation":"弊：破；羸：瘦弱。破车瘦马。比喻处境贫穷。","source":{"text":"家不藏贿，无重宝器，恒菲饮食，薄衣服，弊车羸马，号为窭陋。","book":"晋·陈寿《三国志·吴志·刘繇传》：“繇伯父宠为汉太尉。”裴松之注引晋·司马彪《续汉书》"},"example":{"text":"譬如～而引丘山之载，幸而无虞，犹恐不能胜。","book":"宋·苏辙《上皇帝书》"},"opposite":["宝马香车"],"usage":"作宾语、定语；形容人贫穷"},{"id":17507,"word":"弊车驽马","pinyin":"bì chē nú mǎ","abbr":"bcnm","explanation":"弊：破；驽马：劣马。破车劣马。比喻处境贫穷。","source":{"text":"臣得暖以饱食，弊车驽马，以奉其身，于臣足矣。","book":"汉·刘向《说苑·臣术》"},"similar":["敝车羸马"],"usage":"作主语、宾语、定语；指装备差"},{"id":17508,"word":"弋不射宿","pinyin":"yì bù shè sù","abbr":"ybss","explanation":"弋：射鸟器；宿：歇宿了的鸟。射箭者不射杀已归巢的鸟。比喻贤者隐逸不仕以远避暴乱之害。","source":{"text":"子钓而不纲，弋不射宿。","book":"《论语·述而》"},"example":{"text":"钓而不纲，～，可见孔子有钓鱼射箭的相当本领。","book":"林语堂《林语堂自传》第一辑"},"usage":"作宾语、定语；用于处事"},{"id":17509,"word":"弋人何篡","pinyin":"yì rén hé cuàn","abbr":"yrhc","explanation":"弋人：射鸟的人；篡：取得。射鸟的人无法取得。旧喻贤者隐处，免落入暴乱者之手。","source":{"text":"鸿飞冥冥，弋人何篡焉？","book":"汉·扬雄《法言·问明》"},"similar":["弋者何篡"],"usage":"作谓语、定语；指隐居起来"},{"id":17510,"word":"弋者何慕","pinyin":"yì zhě hé mù","abbr":"yzhm","explanation":"弋者：射鸟的人。射手对高飞的鸟束手无策。旧喻贤者隐居，免落入暴乱者之手。","source":{"text":"今我游冥冥，弋者何所慕。","book":"唐·张九龄《感遇十二首》其四"},"similar":["弋者何篡"],"usage":"作谓语、定语；指隐居起来"},{"id":17511,"word":"弋者何篡","pinyin":"yì zhě hé cuàn","abbr":"yzhc","explanation":"弋者：射鸟的人；篡：取得。射鸟的人无法取得。比喻贤者隐处，免落入暴乱者之手。","source":{"text":"鸿飞冥冥，弋人何篡焉？","book":"汉·扬雄《法言·问明》"},"example":{"text":"南朝·宋·范晔《后汉书·逸民传序》：“扬雄曰：‘鸿飞冥冥，～焉。’言其违患之远矣。”"},"similar":["弋者何慕"],"usage":"作谓语、定语；指隐居起来"},{"id":17512,"word":"式好之情","pinyin":"shì hǎo zhī qíng","abbr":"shzq","explanation":"式：古代发语词；好：指兄弟和睦。兄弟和睦友好的情谊。","source":{"text":"兄及弟矣，式相好矣，无相犹矣。","book":"《诗经·小雅·斯干》"},"example":{"text":"弟兄相助，真耽～；朋友交推，又见同声之谊。","book":"清·吴敬梓《儒林外史》第四十四回"}},{"id":17513,"word":"式歌式舞","pinyin":"shì gē shì wǔ","abbr":"sgsw","explanation":"式：语助词，无实义。边唱歌，边跳舞。形容尽情欢乐。","source":{"text":"遐迩大小一心，同欢同喜逸豫，式歌式舞。","book":"汉·蔡邕《上始加元服与群臣上寿表》"},"example":{"text":"三江靡浪，五岭奚尘，～，仁哉至仁，公其飨福，于万斯春。（南朝·陈·徐陵《广州刺史欧阳頠德政碑》）"}},{"id":17514,"word":"式遏之功","pinyin":"shì è zhī gōng","abbr":"sezg","explanation":"遏：阻止。旧指作官建功立业。","source":{"text":"戴安道既厉操东山，而其兄欲建式遏之功。","book":"南朝·宋·刘义庆《世说新语·栖逸》"}},{"id":17515,"word":"式遏寇虐","pinyin":"shì è kòu nüè","abbr":"sekn","explanation":"遏：阻止；虐：残暴狠毒。阻止坏人为虐作恶。","source":{"text":"式恶寇虐，无俾民忧。","book":"《诗经·大雅·民劳》"},"example":{"text":"公严恭寅畏，底平四国，～，苛厉不作，是用锡公武贲之士三百人。","book":"《晋书·文帝纪》"}},{"id":17516,"word":"弓上弦，刀出鞘","pinyin":"gōng shàng xián，dāo chū qiào","abbr":"gsxdcq","explanation":"弦：弓上的牛筋绳子；鞘：装刀剑的套子。弓张上弦，刀拔出鞘。形容做好了战斗准备。","source":{"text":"一个个弓上弦，刀出鞘，支更坐夜。","book":"明·吴承恩《西游记》第71回"},"example":{"text":"～，人马悄悄转过宋营。","book":"绍剧《龙虎斗》第八场"},"similar":["弓弩上弦，刀剑出鞘"],"usage":"作宾语、定语、分句；用于战争"},{"id":17517,"word":"弓弩上弦，刀剑出鞘","pinyin":"gōng nǔ shàng xián，dāo jiàn chū qiào","abbr":"gnsxdjcq","explanation":"弦：弓上的牛筋绳子；鞘：装刀剑的套子。弓张上弦，刀拔出鞘。形容做好了战斗准备。","source":{"text":"不许交头接耳，不许语笑喧哗，弓弩上弦，刀剑出鞘。","book":"元·关汉卿《单刀会》第三折"},"similar":["弓上弦，刀出鞘"],"usage":"作宾语、定语、分句；用于战争"},{"id":17518,"word":"弓影杯蛇","pinyin":"gōng yǐng bēi shé","abbr":"gybs","explanation":"见“弓影浮杯”。犹言杯弓蛇影。形容疑神疑鬼，自相惊扰。","source":{"text":"一灯如豆，罗帐低垂，弓影杯蛇，惊神未定。","book":"清·沈复《浮生六记·闺房记乐》"},"similar":["杯弓蛇影"],"usage":"作谓语、定语；比喻把虚幻误作真实"},{"id":17519,"word":"弓影浮杯","pinyin":"gōng yǐng fú bēi","abbr":"gyfb","explanation":"形容疑神疑鬼，自相惊扰。","source":{"text":"弓影浮杯疑老病，鸡声牵梦动离愁。","book":"明·刘炳《鄱城归舟》诗"},"similar":["杯弓蛇影"],"usage":"作主语、定语；同“杯弓蛇影”","story":["晋朝河南人乐广十分好客，见一朋友好久不来家里，十分奇怪，就去拜会他，朋友说上次在你家喝酒杯中有蛇，喝后回来后就生病。乐广不解，回到家便查原因，原来是挂在墙上的角弓影子倒射在酒杯所至，朋友闻知后就病愈"]},{"id":17520,"word":"弓折刀尽","pinyin":"gōng zhé dāo jìn","abbr":"gzdj","explanation":"比喻战斗力没有了，无法可想。","source":{"text":"今日拟打罗山寨，弓折刀尽。","book":"宋·释道原《景德传灯录》"},"similar":["山穷水尽"],"usage":"作宾语、定语；用于人的处境"},{"id":17521,"word":"弓调马服","pinyin":"gōng diào mǎ fú","abbr":"gdmf","explanation":"比喻办任何事情，应先做好准备工作。","source":{"text":"弓调而后求劲焉，马服而后求良焉。","book":"《荀子·哀公》"},"usage":"作宾语、定语；用于做事"},{"id":17522,"word":"弓马娴熟","pinyin":"gōng mǎ xián shú","abbr":"gmxs","explanation":"十分熟练拉弓射箭与马术。指人善于骑射。","source":{"text":"若得此人，可以攻打贼巢。更兼他深通武艺，弓马娴熟。","book":"明·施耐庵《水浒传》第55回"},"usage":"作谓语、定语；用于书面语"},{"id":17523,"word":"引为口实","pinyin":"yǐn wéi kǒu shí","abbr":"ywks","explanation":"作为谈资。也指作为指责、攻击他人的把柄。","source":{"text":"若不恤其患，而以为口实，其无乃不堪任命，而翦为仇雠，敝邑是惧。","book":"《左传·襄公二十二年》"},"example":{"text":"今不少施法力，益令狂妄者～。","book":"清·蒲松龄《聊斋志异·齐天大圣》"},"similar":["以为口实"],"usage":"作谓语、定语；用于书面语"},{"id":17524,"word":"引为同调","pinyin":"yǐn wéi tóng diào","abbr":"ywtd","explanation":"同调：声调相同一致，比喻志趣相同。把某人视为是志同道合者或言论主张相同的人。","source":{"text":"余素以孤傲得狂名，路然之狂，不减于余，一见知心，引为同调。","book":"清·归庄《蒋路然诗序》"},"example":{"text":"但晏好清谈，与夏侯玄荀粲王弼等，～，虽身已受戮，尚煽余风，魏晋清谈的流弊，实自晏始。","book":"蔡东藩《后汉演义》第九十七回"}},{"id":17525,"word":"引为鉴戒","pinyin":"yǐn wéi jiàn jiè","abbr":"ywjj","explanation":"引：用；戒：鉴戒。指把过去犯错误的教训拿来作为警戒，避免重犯。","source":{"text":"人之求多闻善败，以鉴戒也。","book":"《国语·楚语下》"},"example":{"text":"此事关系少林荣辱，等下明断曲直；阎寺憎人，俱当～。","book":"梁羽生《江湖三女侠》第十回"}},{"id":17526,"word":"引人入胜","pinyin":"yǐn rén rù shèng","abbr":"yrrs","explanation":"胜：胜境。引人进入佳境。现多用来指风景或文艺作品特别吸引人。","source":{"text":"王卫军云，酒正自引人着胜地。","book":"南朝宋·刘义庆《世说新语·任诞》"},"example":{"text":"扇画小幅，苏州园林，格局很小，却总是那么～。","book":"秦牧《虾趣》"},"similar":["令人神往"],"opposite":["味同嚼蜡"],"usage":"作谓语、定语、状语、宾语；指吸引人"},{"id":17527,"word":"引人注目","pinyin":"yǐn rén zhù mù","abbr":"yrzm","explanation":"注目：注视。吸引人们注意。","source":{"text":"也有敲锣打鼓，高举旗帜，引人注目的。","book":"毛泽东《湖南农民运动考察报告》"},"example":{"text":"他这样做就是要～。"},"similar":["有目共睹"],"opposite":["隐姓埋名"],"usage":"作谓语、定语、状语；指吸引人观看"},{"id":17528,"word":"引人瞩目","pinyin":"yǐn rén zhǔ mù","abbr":"yrzm","explanation":"瞩目：注视。吸引人们注意","example":{"text":"三峡工程～，造福人类"},"similar":["引人注目"],"usage":"作谓语、定语、状语；指吸引人观看"},{"id":17529,"word":"引人胜地","pinyin":"yǐn rén shèng dì","abbr":"yrsd","explanation":"胜：胜境。引人进入佳境。现多用来指风景或文艺作品特别吸引人。","source":{"text":"王卫军云，酒正自引人着胜地。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"盖此老善结构，能就目前所见，一一运之纸，一经其笔，虽极无异物，亦有如许灵异，故往往～。","book":"清·周亮工《读画录·叶荣木》"}},{"id":17530,"word":"引以为乐","pinyin":"yǐn yǐ wéi lè","abbr":"yywl","explanation":"把任何活动都视为一种快乐。"},{"id":17531,"word":"引以为憾","pinyin":"yǐn yǐ wéi hàn","abbr":"yywh","explanation":"以此事为遗憾。","example":{"text":"这篇精妙的论文，因为名额有限，未能入选，颇令人～。"}},{"id":17532,"word":"引以为戒","pinyin":"yǐn yǐ wéi jiè","abbr":"yywj","explanation":"引：用；戒：鉴戒。指把过去犯错误的教训拿来作为警戒，避免重犯。","source":{"text":"人之求多闻善败，以鉴戒也。","book":"《国语·楚语下》"},"example":{"text":"所以近七八年来，历任巡抚者～，不敢委他事情。","book":"清·李宝嘉《官场现形记》第十八回"},"similar":["殷鉴不远"],"opposite":["不足为训"],"usage":"作谓语、定语、宾语；指吸取教训"},{"id":17533,"word":"引以为耻","pinyin":"yǐn yǐ wéi chǐ","abbr":"yywc","explanation":"以此事为自己的羞耻。","example":{"text":"巴黎和谈，国人皆～。"}},{"id":17534,"word":"引以为荣","pinyin":"yǐn yǐ wéi róng","abbr":"yywr","explanation":"以此事为光荣。","source":{"text":"他们一向规规矩矩，也把儿女们调教的规规矩矩，这是他们引以为荣的事。","book":"老舍《四世同堂》七四"},"example":{"text":"中国是一个伟大的国家，有永远值得～的历史和文化，但是现在确实需要发展。","book":"《心愿》"},"usage":"作谓语、定语；用于人或事物等"},{"id":17535,"word":"引以自豪","pinyin":"yǐn yǐ zì háo","abbr":"yyzh","explanation":"可以感到自豪或骄傲的事。","example":{"text":"在平原，有一长串名字是足可以让呼天成～的。","book":"李佩甫《羊的门》第十二章"}},{"id":17536,"word":"引伸触类","pinyin":"yǐn shēn chù lèi","abbr":"yscl","explanation":"指从某一事物的原则，延展推广到同类的事物。亦作“引申触类”。","source":{"text":"引而伸之，触类而长之。","book":"语出《易·系辞上》"},"example":{"text":"精研三十年，～，始得贯通其旨。","book":"清·江藩《汉学师承记·惠周惕》"},"similar":["引申触类"],"usage":"作谓语、定语；用于书面语"},{"id":17537,"word":"引入歧途","pinyin":"yǐn rù qí tú","abbr":"yrqt","explanation":"歧途：岔路。带到错误的道路上。","source":{"text":"尤其是你又知道什么是对？没叫她引入歧途，你替她着什么急？","book":"王朔《我是你爸爸》"},"example":{"text":"我被他～了。"},"similar":["误入歧途"],"usage":"作谓语、定语；指带错路"},{"id":17538,"word":"引入迷途","pinyin":"yǐn rù mí tú","abbr":"yrmt","explanation":"带进虚假之中。","example":{"text":"你不要被他～。"},"similar":["引入歧途"],"usage":"作谓语、宾语；指带人学坏"},{"id":17539,"word":"引决自裁","pinyin":"yǐn jué zì cái","abbr":"yjzc","explanation":"引决：自杀；自裁：自己裁决，即自杀。以自杀的方式自己裁决。","source":{"text":"此人皆身至王侯将相，声闻邻国，及罪至罔加，不能引决自裁。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"只因贾谊前上治安策中，有言公卿得罪，不宜拘辱，但当使他～，方是待臣以礼等语。","book":"蔡东藩《前汉演义》第五十回"},"similar":["自寻短见"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":17540,"word":"引古喻今","pinyin":"yǐn gǔ yù jīn","abbr":"ygyj","explanation":"征引古代史实或文献来喻说当前的现实。","source":{"text":"引古喻今，言微理举。","book":"晋·葛洪《抱朴子·疾谬》"},"similar":["引古证今"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":17541,"word":"引古绳今","pinyin":"yǐn gǔ shéng jīn","abbr":"ygsj","explanation":"援引古代的准则来衡量、匡正今天的事物。","source":{"text":"以含今日之所行，移博士使案礼文，必也放勋之殂，遏密三载，世祖之崩，数旬即吉，引古绳今，阖世有贬，何但李含不应除服。","book":"《晋书·李含传》"},"example":{"text":"太宗之崩，曾不数旬，释然即吉，～，阖代皆应有贬，何但李含不应除服！","book":"唐·杜佑《通典》卷八十八"}},{"id":17542,"word":"引古证今","pinyin":"yǐn gǔ zhèng jīn","abbr":"ygzj","explanation":"用古代的经验教训，证明现实中的事情。","source":{"text":"儒家之教，宪章祖述，引古证今，于学易悟。今树以前因，报以后果，业行交酬，连锁相袭。","book":"《南齐书·高逸传》"},"example":{"text":"鲁迅《南腔北调集·祝》：“那幸运也是缺点之处，是总喜欢～带些学究气。”"},"similar":["引古喻今"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":17543,"word":"引吭一鸣","pinyin":"yǐn háng yī míng","abbr":"ykym","explanation":"吭：喉咙。禽鸟放开嗓子一声鸣叫。比喻放声发表意见或充分发泄愤慨情绪。","source":{"text":"去年秋，予不量狂僭，欲引吭一鸣，弟毅然赞之，既而坐罪削籍，投窜象郡。","book":"宋·胡梦昱《竹林愚隐集·象州祭弟利用行十八文》"},"example":{"text":"独为天下无告之穷民，所以不避斧钺之诛，～，不能自己。","book":"宋·阳觌《鸿庆居士文集·上皇帝书》"}},{"id":17544,"word":"引吭悲歌","pinyin":"yǐn háng bēi gē","abbr":"yhbg","explanation":"引：拉，伸。吭：喉咙，嗓子。放开嗓子大声歌唱。","source":{"text":"墓地里尽是些阴郁的低头扫墓的人，间以喝多了酒引吭悲歌的醉客。","book":"冰心《樱花赞》"}},{"id":17545,"word":"引吭高唱","pinyin":"yǐn háng gāo chàng","abbr":"yhgc","explanation":"吭：嗓子，喉咙。喉咙高声歌唱。","source":{"text":"一个叫花子又从后台我来一根连响棍，边敲边唱。志摩也引吭高唱一曲英国民歌。","book":"王蕙玲《人间四月天》第二卷一"}},{"id":17546,"word":"引吭高声","pinyin":"yǐn háng gāo shēng","abbr":"yhgs","explanation":"引吭：放开嗓子。放开喉咙，高声歌唱。亦作“引吭高歌”、“啭喉高歌”。","source":{"text":"这就是合该有事了，我由于酒兴高，所以一路“引吭高声”，唱的是“满江红”，从“怒发冲冠”开始，进屋之后，刚好唱到“壮志饥餐胡虏肉”。","book":"倪匡《暗号之二》一"}},{"id":17547,"word":"引吭高歌","pinyin":"yǐn háng gāo gē","abbr":"yhgg","explanation":"引：拉长；吭：嗓子，喉咙。放开嗓子大声歌唱。","source":{"text":"殷勤更谢华亭鹤，引吭高声送我归。","book":"晋·张华《禽经》：“鸣则引吭。”宋·吕希纯《朱氏园》"},"example":{"text":"她们～的时候，曳声很长，抑扬起落。","book":"叶圣陶《醉后》"},"opposite":["默不做声","浅酌低吟"],"usage":"作谓语、定语、宾语；指唱歌"},{"id":17548,"word":"引咎自责","pinyin":"yǐn jiù zì zé","abbr":"yjzz","explanation":"咎：罪责。主动承担错误的责任并作自我批评。","source":{"text":"亮甚惧，及见侃，引咎自责，风止可观。","book":"《晋书·庾亮传》"},"example":{"text":"反覆开陈，～，泪涔涔渍衣袂。","book":"清·纪昀《阅微草堂笔记·滦阳录一》"},"similar":["严以律己"],"opposite":["以邻为壑"],"usage":"作谓语；指主动承认错误"},{"id":17549,"word":"引咎责躬","pinyin":"yǐn jiù zé gōng","abbr":"yjzg","explanation":"主动承担错误的责任并作自我批评。同“引咎自责”。","source":{"text":"权信任校事吕壹，壹性苛惨，用法深刻。太子登数谏，权不纳，大臣由是莫敢言。后壹奸罪发露伏诛，权引咎自躬。","book":"《三国志·吴志·吴主传》"},"example":{"text":"《旧五代史·周书·世宗纪》：“虽古人有～，因灾致惧，亦无以过此也。”"},"usage":"作谓语、定语、宾语；用于处事"},{"id":17550,"word":"引商刻羽","pinyin":"yǐn shāng kè yǔ","abbr":"ysky","explanation":"商、羽：古代乐律中的两个音名。指讲究声律、有很高成就的音乐演奏。","source":{"text":"引商刻羽，杂以流徵，国中属而和者，不过数人而已。是其曲弥高，其和弥寡。","book":"战国楚·宋玉《对楚王问》"},"example":{"text":"一个小小子走到鲍廷玺身边站着，拍着手，唱李太白《清平调》。真乃穿云裂石之声，～之奏。","book":"清·吴敬梓《儒林外史》第二十九回"},"similar":["引商角羽"],"usage":"作谓语；指音乐演奏高超"},{"id":17551,"word":"引商刻角","pinyin":"yǐn shāng kè jiǎo","abbr":"yskj","explanation":"指讲究声律、有很高成就的音乐演奏。同“引商刻羽”。","source":{"text":"引商刻角，杂以流徵。","book":"西汉·刘向《新序·杂事一》"},"example":{"text":"唐·阎伯嬩《歌赋》：“或～，或溃渭通泾。”"},"similar":["引商刻羽"],"usage":"作谓语、定语；指音乐演奏高超"},{"id":17552,"word":"引喻失义","pinyin":"yǐn yù shī yì","abbr":"yysy","explanation":"引喻：引用类似的例证来说明事理。义：公正合宜的道理。指说话不恰当，不合道理。","source":{"text":"不宜妄自菲薄，引喻失义，以塞忠谏之路也。","book":"三国蜀·诸葛亮《前出师表》"},"usage":"作谓语、宾语；指比喻失当"},{"id":17553,"word":"引嫌辞退","pinyin":"yǐn xián cí tuì","abbr":"yxct","explanation":"引嫌：避嫌疑。为了避免嫌疑而请求退避。","source":{"text":"近岁，中书舍人当制，而兄弟有除授，多引嫌，俾以次官行。","book":"宋·徐度《却扫篇》卷中"}},{"id":17554,"word":"引年求退","pinyin":"yǐn nián qiú tuì","abbr":"ynqt","explanation":"自陈年纪大，请求辞退。","source":{"text":"以卿先朝勋臣之后，特委以三公重任，自秉政以来，效竭忠勤，朕甚嘉之。今引年求退，甚得宰相体，然未得代卿者，以是难从，汝勉之哉。","book":"《金史·完颜守道传》"},"example":{"text":"溥时年七十，～，不许。诏风雨寒暑免朝参。","book":"《明史·徐溥传》"},"usage":"作谓语、定语；用于处事"},{"id":17555,"word":"引律比附","pinyin":"yǐn lǜ bǐ fù","abbr":"ylbf","explanation":"古代法律用语。援引律令，类比定罪。","source":{"text":"凡律令该载不尽事理，若断罪而无正条者，引律比附。","book":"《明律·名例·刑律》"},"usage":"作宾语、定语；用于书面语"},{"id":17556,"word":"引手投足","pinyin":"yǐn shǒu tóu zú","abbr":"ystz","explanation":"比喻出微力便能援救别人。","source":{"text":"庸讵知有力者不哀其穷，而忘一举手一投足之劳而转之清波乎？","book":"语出唐·韩愈《应科目时与人书》"},"example":{"text":"明·李贽《复顾冲庵翁书》：“公独鳌钓通海，视等乡邻，不一～，又何其忍耶！”"},"similar":["举手投足"],"usage":"作谓语、定语；用于书面语"},{"id":17557,"word":"引新吐故","pinyin":"yǐn xīn tǔ gù","abbr":"yxtg","explanation":"犹言吐故纳新。古代道家的养生之术，即吐纳术。","source":{"text":"引新吐故，云饮霞餐。","book":"晋·陆机《列仙赋》"},"similar":["吐故纳新"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":17558,"word":"引日成岁","pinyin":"yǐn rì chéng suì","abbr":"yrcs","explanation":"捱过一天像度过一年。形容思念的深切。","source":{"text":"众之思公，引日成岁，愿勿稽留，以慰众望也。","book":"《周书·文帝纪上》"},"similar":["一日三秋"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":17559,"word":"引水入墙","pinyin":"yǐn shuǐ rù qiáng","abbr":"ysrq","explanation":"比喻自招灾祸。","source":{"text":"这不是我自己引水入墙，开门揖盗么。","book":"清·文康《儿女英雄传》第四回"},"similar":["引狼入室"],"usage":"作谓语、宾语、定语；指引狼入室"},{"id":17560,"word":"引火烧身","pinyin":"yǐn huǒ shāo shēn","abbr":"yhss","explanation":"原比喻自讨苦吃或自取灭亡。现多比喻主动暴露自己的缺点错误，以争取大家的批评帮助。","source":{"text":"庄上人见典史亲来捉获，不知一件什么天大的事，生怕引火烧身，连忙把余琳并冯都送将出来。","book":"明·东鲁古狂生《醉醒石》第三回"},"example":{"text":"借洋兵是～的事，最好请他慎重一点。","book":"欧阳予倩《忠王李秀成》第一幕"},"similar":["自作自受","玩火自焚"],"opposite":["漠不关心"],"usage":"作谓语、定语、宾语；指对自己不利的事"},{"id":17561,"word":"引物连类","pinyin":"yǐn wù lián lèi","abbr":"ywll","explanation":"指引证或引喻某一事物，而连带及于同类的其它事物。","source":{"text":"其言简而明，信而通，引物连类，折之于至理。","book":"唐·韩愈《送权秀才序》“权生之貌，固若常人耳。其文辞引物连类，穷情尽变。”宋·苏轼《〈居士集〉叙》"},"example":{"text":"往往～，委曲譬喻。","book":"清·梁绍壬《两般秋雨庵随笔·粤歌》"},"similar":["比物连类"],"usage":"作谓语、定语；用于书面语"},{"id":17562,"word":"引狗入寨","pinyin":"yǐn gǒu rù zhai","abbr":"ygrz","explanation":"犹言引狼入室。比喻把坏人或敌人引入内部。","source":{"text":"抑且那家没胡姬妾，肯引狗入寨，都拒绝不留。","book":"明·东鲁古狂生《醉醒石》"},"similar":["引狼入室"],"usage":"作谓语、定语；指引狼入室"},{"id":17563,"word":"引狼入室","pinyin":"yǐn láng rù shì","abbr":"ylrs","explanation":"引：招引。把狼招引到室内。比喻把坏人或敌人引入内部。","source":{"text":"我不是引的狼来屋里窝，寻的蚰蜒钻耳朵。","book":"元·张国宾《罗李郎》第一折"},"example":{"text":"再娶者，皆～耳，况将于野合逃窜中求贤妇哉。","book":"清·蒲松龄《聊斋志异·黎氏》"},"similar":["开门揖盗"],"opposite":["拒之门外"],"usage":"作谓语、定语；指招引坏人"},{"id":17564,"word":"引狼拒虎","pinyin":"yǐn láng jù hǔ","abbr":"yljh","explanation":"比喻引进另一种恶势力来抗拒原来的恶势力，其祸患将更甚。同“引虎拒狼”。","source":{"text":"而引狼拒虎之祸，势又缘兹以起，且至不可收拾。","book":"李大钊《警告全国父老书》"},"similar":["引虎拒狼"],"usage":"作宾语、定语；用于比喻句"},{"id":17565,"word":"引狼自卫","pinyin":"yǐn láng zì wèi","abbr":"ylzw","explanation":"犹言引虎自卫。比喻企图依仗恶人，结果反受其害。","source":{"text":"命下之日，太后抱太子痛哭，言者交章论谏，且有引狼自卫之喻。","book":"王树楠《武汉战纪》"},"similar":["引虎自卫"],"usage":"作宾语、定语；用于比喻句"},{"id":17566,"word":"引玉之砖","pinyin":"yǐn yù zhī zhuān","abbr":"yyzz","explanation":"自己表示谦虚的话。比喻为了引出别人高明的意见而发表的粗浅的不成熟的意见。","source":{"text":"比来抛砖引玉，却引得个坠子。","book":"宋·释道原《景德传灯录》第十卷"},"example":{"text":"我们的东西，只当作～，千虑之一得。","book":"毛泽东《新民主主义论》"},"similar":["抛砖引玉"],"usage":"作宾语；指抛砖引玉的话"},{"id":17567,"word":"引申触类","pinyin":"yǐn shēn chù lèi","abbr":"yscl","explanation":"指从某一事物的原则，延展推广到同类的事物。同“引伸触类”。","source":{"text":"故事何足拘泥？但天下事有牵一发而全身为之动者，不得不引申触类及之也。","book":"清·龚自珍《上大学士书》"},"similar":["引伸触类"],"usage":"作谓语、定语；用于书面语"},{"id":17568,"word":"引盗入闼","pinyin":"yǐn dào rù tà","abbr":"ydrt","explanation":"闼：门。把小偷引到屋里。比喻把坏人引入内部。","source":{"text":"边邻四面皆楚歌，引盗入闼谁实使？","book":"清·陈士芑《甲辰二十八初度自述一百韵》"}},{"id":17569,"word":"引短推长","pinyin":"yǐn duǎn tuī cháng","abbr":"ydtc","explanation":"指有意不露才以形己之短，显人之长。","source":{"text":"武帝每集文士策经史事，时范云、沈约之徒皆引短推长，帝乃悦，加其赏赍。","book":"《南史·刘峻传》"},"example":{"text":"明·李贽《读史·曹公二首》：“况沈、谢～，僧虔秃笔自免，孝标空续《辨命》哉？”"},"usage":"作谓语、定语；用于处事","story":["南朝时期，梁武帝经常召集文人谈经论史，范云、沈约等人引短推长，武帝十分高兴，经常给他们赏赐。一次武帝在别人说完后要刘峻发表看法，刘峻毫不犹豫用笔写了十多件事，切中时弊，在座的人大惊，武帝十分别满，再也不见刘峻了"]},{"id":17570,"word":"引类呼朋","pinyin":"yǐn lèi hū péng","abbr":"ylhp","explanation":"引：招来；类：同类；呼：叫。指招引志趣相同的人。","source":{"text":"奈何引类呼朋，摇头鼓翼。","book":"宋·欧阳修《憎苍蝇赋》"},"example":{"text":"因而～，群相效尤，遂成痼习。","book":"清·林则徐《颁发查禁营兵吸食鸦片规条稿》"},"similar":["呼朋引类"],"usage":"作谓语、定语；指朋友交往"},{"id":17571,"word":"引线穿针","pinyin":"yǐn xiàn chuān zhēn","abbr":"yxcz","explanation":"使线的一头通过针眼。比喻从中联系、拉拢。","source":{"text":"万乞吴二娘怎生做个方便，到黄府亲见小姐询其下落，做个穿针引线之人。","book":"汉·刘向《说苑·善说》：“缕困针而入，不因针而急；嫁女因媒而成，不因媒而亲。”明·周楫《西湖二集》卷一二"},"example":{"text":"安老爷、安太太便在这边暗暗的排兵布阵，舅太便在那边密密的～。","book":"清·文康《儿女英雄传》第二十四回"},"similar":["穿针引线"],"usage":"作谓语、宾语、定语；指牵线联系"},{"id":17572,"word":"引经据义","pinyin":"yǐn jīng jù yì","abbr":"yjjy","explanation":"引：援引；据：依据。引用经典书籍作为论证的依据。","source":{"text":"时人多不行妻服，虽在亲忧犹有吊问丧疾者，又私谥其君父及诸名士，爽皆引据大义，正之经典，虽不悉变，亦颇有改。","book":"《后汉书·荀爽传》"}},{"id":17573,"word":"引经据典","pinyin":"yǐn jīng jù diǎn","abbr":"yjjd","explanation":"引用经典书籍作为论证的依据。","source":{"text":"爽皆引据大义，正之经典。","book":"《后汉书·荀爽传》"},"example":{"text":"吃到这些臭东西，还要替他考证，你也忒爱～了。","book":"清·李汝珍《镜花缘》第九十二回"},"similar":["旁征博引"],"opposite":["信口开河"],"usage":"作谓语、定语、状语；用于谈话与写作方面"},{"id":17574,"word":"引经据古","pinyin":"yǐn jīng jù gǔ","abbr":"yjjg","explanation":"引用经史古籍中的文句或故事作为根据。","source":{"text":"万一颠沛于郊庙坛壝之前，有污大仪，则臣死不足以塞责，是以不复更敢引经据古；直述情素，投告君父。","book":"宋·楼钥《再乞致仕第二札》"},"example":{"text":"清·徐喈凤《会仙记》：“淑贞执妇道甚谨，与汉昭叙谈，～，无一俚语。”"},"similar":["引经据典"],"usage":"作谓语、宾语、定语；用于说话或作文等"},{"id":17575,"word":"引经据礼","pinyin":"yǐn jīng jù lǐ","abbr":"yjjl","explanation":"引：援引；据：依据。引用经典书籍作为论证的依据。","source":{"text":"珙六上奏恳辞，引经据礼，词甚切。","book":"《宋史·刘珙传》"}},{"id":17576,"word":"引绳切墨","pinyin":"yǐn shéng qiē mò","abbr":"ysqm","explanation":"木工拉墨线裁直。用以比喻刚直不阿。","source":{"text":"引绳切墨，不少假易。","book":"清·钱谦益《刘公墓志铭》"},"example":{"text":"章炳麟《馗书·订文》：“若是，则布政之言，明清长弟，较然如～，品庶昭苏，而韶偷者竞矣。”"},"usage":"作宾语、定语；用于比喻句"},{"id":17577,"word":"引绳削墨","pinyin":"yǐn shéng xuē mò","abbr":"ysxm","explanation":"指木工弹拉墨线后据以锯削。比喻恪守、拘泥于成法。","source":{"text":"昉思在阮翁门，每有异同。其诗引绳削墨，不失尺寸。惜才力窘弱，对其篇幅，都无生气。","book":"清·赵执信《谈龙录》"}},{"id":17578,"word":"引绳批根","pinyin":"yǐn shéng pī gēn","abbr":"yspg","explanation":"引绳：挽绳，比喻勾结。指勾结起来排斥异己。","source":{"text":"及魏其侯失势，亦欲倚灌夫引绳批根生平慕之后弃之者。","book":"《史记·魏其武安侯列传》"},"example":{"text":"梁启超《新民说·论自尊》：“己不办事，立于办事者之后，～以嘲讽掊击。”"},"similar":["引绳排根"],"usage":"作谓语、宾语、定语；用于处事"},{"id":17579,"word":"引绳排根","pinyin":"yǐn shéng pái gēn","abbr":"yspg","explanation":"指勾结起来排斥异己。","source":{"text":"及窦婴失势，亦欲倚夫引绳排根生平慕之后弃者。","book":"《汉书·灌夫传》"},"example":{"text":"宋·程大昌《考古编·庄子》：“古今多罪周之诋訾尧、舜、孔子，则相与～，一切斥为异端。”"},"similar":["引绳批根"],"usage":"作谓语、定语；指排斥异己"},{"id":17580,"word":"引绳棋布","pinyin":"yǐn shéng qí bù","abbr":"ysqb","explanation":"形容纵横整齐。","source":{"text":"庐舍道巷，引绳棋布。","book":"宋·苏轼《故龙图阁学士滕公墓志铭》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":17581,"word":"引而不发","pinyin":"yǐn ér bù fā","abbr":"yebf","explanation":"引：拉弓；发：射箭。拉开弓却不把箭射出去。比喻善于启发引导。也比喻做好准备暂不行动，以待时机。","source":{"text":"君子引而不发，跃如也。中道而立，能者从之。","book":"《孟子·尽心上》"},"example":{"text":"共产党对于这些东西的宣传政策应当是：“～，跃如也。”","book":"毛泽东《湖南农民运动考察报告》"},"similar":["枕戈待旦"],"opposite":["盘马弯弓"],"usage":"作谓语、定语；指待机而动"},{"id":17582,"word":"引而伸之","pinyin":"yǐn ér shēn zhī","abbr":"yesz","explanation":"由某件事或某种思想推衍到其他有关的意义，并进一步加以发挥。","source":{"text":"是故四营而成《易》，十有八变而成卦，八卦而小成。引而伸之，触类而长之，天下之能事毕矣。","book":"《周易·系辞上》"},"example":{"text":"其微辞隐义，则～；而其所未备者，复为说以补其阙。","book":"《元史·儒学传·陈栎》"},"similar":["引而申之"],"usage":"作谓语、定语；用于书面语"},{"id":17583,"word":"引而申之","pinyin":"yǐn ér shēn zhī","abbr":"yesz","explanation":"由某件事或某种思想推衍到其他有关的意义，并进一步加以发挥。","source":{"text":"是故四营而成《易》，十有八变而成卦，八卦而小成。引而伸之，触类而长之，天下之能事毕矣。","book":"《周易·系辞上》"},"example":{"text":"太常少卿郑愔又～，播于舞咏，亦受厚赏。","book":"《旧唐书·后妃传》"},"similar":["引而伸之"],"usage":"作谓语、定语；用于书面语"},{"id":17584,"word":"引脰增劳","pinyin":"yǐn dòu zēng láo","abbr":"ydzl","explanation":"脰：颈。伸直脖子远望，使心神疲劳。形容盼望十分殷切。","source":{"text":"永言荷春之非常，重以违颜之积久，向风结想，引脰增劳。","book":"宋·王安石《服阙谢河间帅张显谟启》"}},{"id":17585,"word":"引船就岸","pinyin":"yǐn chuán jiù àn","abbr":"ycja","explanation":"移动船只靠近岸边。比喻引诱别人主动凑上来办成某件事情。","source":{"text":"原来三荷包进来的时候，本想做个反跌文章，先说个不成功，好等他哥来还价，他用的是‘引船就岸’的计策。","book":"清·李宝嘉《官场现形记》第五回"},"similar":["移船就岸"],"usage":"作宾语、定语；比喻就范"},{"id":17586,"word":"引虎入室","pinyin":"yǐn hǔ rù shì","abbr":"yhrs","explanation":"犹言引狼入室。比喻把坏人或敌人引入内部。","source":{"text":"是不但引虎入室，并且为虎添翼。","book":"清·夏燮《中西纪事·外夷助剿》"},"similar":["引狼入室"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":17587,"word":"引虎拒狼","pinyin":"yǐn hǔ jù láng","abbr":"yhjl","explanation":"比喻引进另一种恶势力来抗拒原来的恶势力，其祸患将更甚。亦作“引狼拒虎”。","source":{"text":"断不可借外洋之兵，那引虎拒狼大下策，劝列位万万莫做。","book":"清·陈天华《猛回头》"},"similar":["引狼拒虎"],"usage":"作宾语、定语；用于比喻句"},{"id":17588,"word":"引虎自卫","pinyin":"yǐn hǔ zì wèi","abbr":"yhzw","explanation":"引：招引。引来老虎，保卫自己。比喻企图依仗恶人，结果反受其害。","source":{"text":"严颜在巴郡，闻刘璋差法正请玄德入川，拊心而叹曰：‘此所谓独坐穷山，引虎自卫者也！’","book":"明·罗贯中《三国演义》第63回"},"example":{"text":"这正是无异～。","book":"杨玉如《辛亥革命先著记》第三章第七节"},"similar":["引狼自卫"],"usage":"作定语；指人的选择不当"},{"id":17589,"word":"引蛇出洞","pinyin":"yǐn shé chū dòng","abbr":"yscd","explanation":"比喻引诱坏人进行活动，使之暴露。","source":{"text":"如果说，父亲与会是中了‘引蛇出洞’之计，那么，储安平6月1日在中央统战部的发言，则被许多人视为‘自投罗网’。","book":"章诒和《往事并不如烟·两片落叶，偶尔吹在一起》"},"example":{"text":"他这一招叫～。"},"usage":"作谓语、宾语、定语；指引诱坏人进行活动"},{"id":17590,"word":"引譬援类","pinyin":"yǐn pì yuán lèi","abbr":"ypyl","explanation":"引：援引；譬：比方。援引相类似的例证来说明事理。","source":{"text":"言天地四时而不引譬援类，则不知精微。","book":"《举证南子·要略训》"}},{"id":17591,"word":"引贼入家","pinyin":"yǐn zéi rù jiā","abbr":"yzrj","explanation":"把小偷引到家里。比喻把敌对分子或坏人引入内部。","source":{"text":"此所谓引贼入家，养虎贻患，是何等计策乎？","book":"明·张居正《答宣大巡抚计处黄把二虏书》"}},{"id":17592,"word":"引足救经","pinyin":"yǐn zú jiù jīng","abbr":"yzjj","explanation":"引：拉；经：缢死。救上吊的人却去拉他的脚。比喻行动与目的相反，越做越离目的越远。","source":{"text":"志不免乎奸心，行不免乎奸道，而求有君子、圣人之名，辟之是犹伏而咶天，救经而引其足也。","book":"《荀子·仲尼》"},"similar":["北辕适楚","缘木求鱼"],"usage":"作谓语、定语；指行为方式不对"},{"id":17593,"word":"引车卖浆","pinyin":"yǐn chē mài jiāng","abbr":"ycmj","explanation":"拉大车的，做小买卖的。指平民百胜。","source":{"text":"公子引车入市，侯生下见其客朱亥。","book":"西汉·司马迁《史记·魏公子列传》"},"example":{"text":"因为文体卑下，是‘～者流’所用的话。","book":"鲁迅《呐喊·阿Q正传》"},"usage":"作宾语、定语；指平民百胜"},{"id":17594,"word":"引过自责","pinyin":"yǐn guò zì zé","abbr":"ygzz","explanation":"主动承担错误的责任并作自我批评。","source":{"text":"灾变恶征，何为至乎？引过自责，恐有罪。","book":"汉·王充《论衡·感类篇》"}},{"id":17595,"word":"引重致远","pinyin":"yǐn zhòng zhì yuǎn","abbr":"yzzy","explanation":"指负载沉重而可以到达远方。比喻抱负远大，能闯出新的天地，做出宏伟的业绩。","source":{"text":"服牛乘马，引重致远。","book":"《周易·系辞下》"},"similar":["任重致远"],"usage":"作谓语；指有压力才会有动力"},{"id":17596,"word":"引针拾芥","pinyin":"yǐn zhēn shí jiè","abbr":"yzsj","explanation":"比喻事物互相感应。","source":{"text":"语出汉·王充《论衡·乱龙》：“顿牟掇芥，磁石引针，皆以其真是，不假他类。”顿牟，琥珀。一说为玳瑁。"},"example":{"text":"蠲忿忘忧，其感应也何故？～，其情性也何居？","book":"明·王廷相《策问》"},"usage":"作宾语、定语；用于比喻句"},{"id":17597,"word":"引锥刺股","pinyin":"yǐn zhuī cì gǔ","abbr":"yzcg","explanation":"锥：锥子；股：大腿。晚间读书时想睡觉，就用锥子刺自己的大腿，以保持清醒。形容学习勤奋刻苦。","source":{"text":"（苏秦）读书欲睡，引锥自刺其股。","book":"西汉·刘向《战国策·秦策一》"},"example":{"text":"要知男儿知悔后，～并非难。","book":"清·李绿园《歧路灯》第95回"},"usage":"作谓语、定语；指勤奋学习","story":["战国时期，著名纵横家苏秦到秦国游说他的纵横学说，被秦王拒绝。他失败以后，为博取功名就发愤读书，每天读书到深夜，每当要打瞌睡时，他就用铁锥子刺一下大腿来提神，时间一长，他考取功名，当上了六国的宰相联合抗秦"]},{"id":17598,"word":"引领以望","pinyin":"yǐn lǐng yǐ wàng","abbr":"ylyw","explanation":"引领：伸长脖子。伸长脖子远望。形容殷切盼望。","source":{"text":"如有不嗜杀人者，则天下之民皆引领而望之矣。","book":"《孟子·梁惠王上》"},"example":{"text":"君侯不泯卫之社稷，许复故君，举国臣民，咸～高义。","book":"明·冯梦龙《东周列国志》第四十二回"}},{"id":17599,"word":"引领企踵","pinyin":"yǐn lǐng qǐ zhǒng","abbr":"ylqz","explanation":"伸长脖子，踮起脚跟。形容殷切盼望。","source":{"text":"分手未遥，翘心且积，引领企踵，朝夕不忘。","book":"南朝·梁·萧统《大吕十二月》"},"example":{"text":"宋·秦观《李泌论》：“而范阳之人独以为主，～，惟恐其不兴，此所谓家臣不知国。”"},"similar":["延颈企踵"],"usage":"作谓语、状语；指盼望心切"},{"id":17600,"word":"引领成劳","pinyin":"yǐn lǐng chéng láo","abbr":"ylcl","explanation":"引领：伸长脖子。伸长脖子盼望并心神为之疲劳。形容盼望非常殷切。","source":{"text":"而幄里余香，从风且歇，掩屏为疾，引领成劳，镜想分鸾，琴悲别鹤，心如膏火，独夜自煎，思等流波，终朝不息。","book":"唐·欧阳询《艺文类聚》卷三十二"},"example":{"text":"忽忽三年，红尘永隔；盈盈一水，青鸟难通，结想为梦，～。","book":"清·蒲松龄《聊斋志异·罗刹海市》"}},{"id":17601,"word":"引领翘首","pinyin":"yǐn lǐng qiào shǒu","abbr":"ylqs","explanation":"引领：伸长脖子。伸长脖子，扬着头远望。形容殷切盼望。","source":{"text":"今并因商人密送诚款，引领翘首，愿为臣妾。","book":"《隋书·裴矩传》"},"usage":"作宾语、定语、状语；用于书面语"},{"id":17602,"word":"引领而望","pinyin":"yǐn lǐng ér wàng","abbr":"ylew","explanation":"引领：伸长脖子。伸长脖子远望。形容殷切盼望。","source":{"text":"如有不嗜杀人者，则天下之民皆引领而望之矣。","book":"《孟子·梁惠王上》"},"similar":["引颈而望","翘首以待"],"usage":"作谓语、定语；指渴望"},{"id":17603,"word":"引颈受戮","pinyin":"yǐn jǐng shòu lù","abbr":"yjsl","explanation":"戮：杀。伸长脖子等待被杀。指不作抵抗而等死。","source":{"text":"天兵到日，尚不引颈受戮，乃敢拒敌大兵！","book":"明·许仲琳《封神演义》第36回"},"example":{"text":"这些人都成了～的囚犯，现在只不过是在挨日子罢了。","book":"王宗汉《关东响马》"},"similar":["束手待毙","束手受戮"],"opposite":["揭竿而起"],"usage":"作谓语、定语、宾语；指坐以待毙"},{"id":17604,"word":"引颈而望","pinyin":"yǐn jǐng ér wàng","abbr":"yjew","explanation":"引颈：伸长脖子。伸长脖子远望。形容殷切盼望。","source":{"text":"如有不嗜杀人者，则天下之民皆引领而望之矣。","book":"《孟子·梁惠王上》"},"example":{"text":"枚喜悦不已，学闲鸥～。","book":"清·袁枚《小仓山房尺牍》第七十三首"},"similar":["引领而望","引首以望"],"usage":"作谓语、定语；指渴望"},{"id":17605,"word":"引风吹火","pinyin":"yǐn fēng chuī huǒ","abbr":"yfch","explanation":"引：招来。利用风来吹火，使火越烧越旺。比喻从中煽动，挑起事端。","source":{"text":"因风吹火，用力不多。","book":"宋·释道原《景德传灯录》卷十三"},"example":{"text":"坐山观虎斗，借刀杀人，～，站干岸儿，推倒了油瓶不扶，都是全桂子的本事。"},"similar":["兴风作浪"],"usage":"作谓语、定语；指煽风点火"},{"id":17606,"word":"引首以望","pinyin":"yǐn shǒu yǐ wàng","abbr":"ysyw","explanation":"抬头远望。形容殷切盼望。","source":{"text":"况今大号已建，自河以北，人皆引首以望成功而思休息。","book":"《孟子·梁惠王上》：“如有不嗜杀人者，则天下之民皆引领而望之矣。”《新五代史·唐臣传·郭崇韬》"},"similar":["引颈而望","引领而望"],"usage":"作谓语、定语；指渴望"},{"id":17607,"word":"引鬼上门","pinyin":"yǐn guǐ shàng mén","abbr":"ygsm","explanation":"比喻招来坏人。","source":{"text":"吾本等好意，却叫得‘引鬼上门’，我而今不便追究，只不理他罢了。","book":"明·凌濛初《初刻拍案惊奇》卷二十二"},"similar":["引狼入室"],"usage":"作谓语、定语；指引狼入室"},{"id":17608,"word":"弗敢专也","pinyin":"fei gan zhuan ye","abbr":"fgzy","explanation":"不敢独自专有。"},{"id":17609,"word":"弗欺暗室","pinyin":"fú qī àn shì","abbr":"fqas","explanation":"暗室：比喻暗中。在无人看见的地方，也不做昧心事。","source":{"text":"弗欺暗室，岂况三光。","book":"《梁书·简文帝纪》"},"example":{"text":"为人要正直，～。"},"similar":["不欺暗室"],"usage":"作谓语、定语；形容不做亏心事"},{"id":17610,"word":"弘奖风流","pinyin":"hóng jiǎng fēng liú","abbr":"hjfl","explanation":"弘：大；风流：指才华出众的人。对才华出众的人大加奖赏或大量任用人才，以鼓励其他人奋发上进。","source":{"text":"岂所以弘奖风流，希向后进？","book":"《梁书·武帝纪上》"}},{"id":17611,"word":"弘此远谟","pinyin":"hong chi yuan mo","abbr":"hcym","explanation":"发挥你那胸中的深谋远策。"},{"id":17612,"word":"弘毅宽厚","pinyin":"hóng yì kuān hòu","abbr":"hykh","explanation":"弘毅：意志坚强，志向远大。志向远大而待人宽大厚道。","source":{"text":"先主之弘毅宽厚，知人待士，疬有高祖之风，英雄之器焉。","book":"《三国志·蜀志·先主（刘备）传评》"},"usage":"作谓语、定语；用于为人"},{"id":17613,"word":"弘济时艰","pinyin":"hóng jì shí jiān","abbr":"hjsj","explanation":"弘：大；济：接济。对当时出现的困难进行大力援救和资助。","source":{"text":"弘济于艰难。","book":"《尚书·顾命》"}},{"id":17614,"word":"弘誓大愿","pinyin":"hóng shì dà yuàn","abbr":"hsdy","explanation":"弘：大。指发大誓，许大愿。形容有很大的决心和愿望。","source":{"text":"我已发了弘誓大愿，不取真经，永堕沉沦地狱。","book":"明·吴承恩《西游记》第十二回"},"usage":"作主语、宾语、定语；指人的决心"},{"id":17615,"word":"弛声走誉","pinyin":"chí shēng zǒu yù","abbr":"cszy","explanation":"指名声传扬。","source":{"text":"三代而下，尽是此一种人，弛声走誉，比善人有恒，更觉完美。","book":"明袁宏道《钦叔阳秀才》"}},{"id":17616,"word":"弛高骛远","pinyin":"chí gāo wù yuǎn","abbr":"cgwy","explanation":"犹好高骛远。比喻不切合实际地追求过高过远的目标。","source":{"text":"但其构思落笔之初，未免弛高骛远。","book":"清李渔《闲情偶寄·器玩·制度》"}},{"id":17617,"word":"弛魂宕魄","pinyin":"chí hún dàng pò","abbr":"chdp","explanation":"形容振憾心灵。亦作“驰魂夺魄”。","source":{"text":"还有吹不满旗的灵风推着云车，满载霓裳缥缈、彩佩玲珑的仙娥，给予人们颂送着弛魂宕魄的天乐。","book":"闻一多《李白之死》诗"},"example":{"text":"各种印象，新鲜而又庄严，使他目不暇给，弛魂夺魄。","book":"徐迟《地质之光》"}},{"id":17618,"word":"弟子孩儿","pinyin":"dì zǐ hái ér","abbr":"dzhe","explanation":"骂人话。即娼妓所生的孩子。","source":{"text":"这个穷弟子孩儿，要钱则要钱，题名道姓怎的。","book":"元·郑廷玉《忍字记》第一折"},"example":{"text":"叵耐这没廉耻的小～。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"usage":"作主语、宾语；用于骂人"},{"id":17619,"word":"弟男子侄","pinyin":"dì nán zǐ zhí","abbr":"dnzz","explanation":"泛指晚辈男子。","source":{"text":"《元典章》有‘新附军人、弟男子侄结连恶少为害’，四字始见。","book":"清翟灏《通俗编·伦常》"},"example":{"text":"不一时，催命鬼领了几个～来到庙前。","book":"《何典》第二回"},"usage":"作宾语；指晚辈男子"},{"id":17620,"word":"张三吕四","pinyin":"zhāng sān lǚ sì","abbr":"zsls","explanation":"泛指某人或某些人","source":{"text":"晓来狗吠张三妇，日暮猿啼吕四妻。","book":"宋·何承裕《戏为举子对句》诗"},"similar":["张三李四","阿猫阿狗","张甲李乙"],"usage":"作主语、宾语、定语；用于书面语"},{"id":17621,"word":"张三李四","pinyin":"zhāng sān lǐ sì","abbr":"zsls","explanation":"假设的名字，泛指某人或某些人。","source":{"text":"张三裤口窄，李四帽檐长。","book":"宋·王安石《拟寒山拾得》诗"},"example":{"text":"宋·王安石《拟寒山拾得》诗：“张三裤口窄，李四帽檐长。”"},"similar":["张王赵李","张三吕四","张甲李乙"],"usage":"作主语、宾语、定语；泛指某人或某些人"},{"id":17622,"word":"张公吃酒李公醉","pinyin":"zhāng gōng chī jiǔ lǐ gōng zuì","abbr":"zgcjlgz","explanation":"比喻由于误会而代人受过。","source":{"text":"天后时，谣言曰：‘张公吃酒李公醉。’张公者，斥易之兄弟也；李公者，言李氏大盛也。","book":"唐·张鷟《朝野佥载》卷一"},"example":{"text":"世上有如此不公之事，正是～，桑树上脱枝柳树上报。","book":"明·兰陵笑笑生《金瓶梅词话》第七十六回"},"similar":["李代桃僵","移花接木"],"usage":"作宾语、定语；指代人受过"},{"id":17623,"word":"张公吃酒李公颠","pinyin":"zhāng gōng chī jiǔ lǐ gōng diān","abbr":"zgcjlgd","explanation":"后有移花接木或顶缸之义。同“张公吃酒李公醉”。","source":{"text":"曲中唱曰：张公吃酒李公颠，盛六生儿郑九怜。","book":"宋·李棨《北里志·张住住》"},"similar":["张公吃酒李公醉"],"usage":"作宾语、定语；用于比喻句"},{"id":17624,"word":"张冠李戴","pinyin":"zhāng guān lǐ dài","abbr":"zgld","explanation":"把姓张的帽子戴到姓李的头上。比喻认错了对象，弄错了事实。","source":{"text":"谚云：‘张公帽掇在李公头上。’有人作赋云：‘物各有主，貌贵相宜。窃张公之帽也，假李老而戴之。’","book":"明·田艺蘅《留青日札》卷二十二《张公帽赋》"},"example":{"text":"但老船夫却作错了一件事情，把昨晚唱歌人“～”了。","book":"沈从文《边城》十四"},"similar":["破绽百出","似是而非"],"opposite":["无可非议","毫厘不爽"],"usage":"作谓语、状语；指弄错了对象"},{"id":17625,"word":"张口吐舌","pinyin":"zhāng kǒu tǔ shé","abbr":"zkts","explanation":"张着嘴说不出话来。形容理屈词穷，或因紧张害怕而发愣。","source":{"text":"公孙龙口呿而不合，舌举而不下，乃逸而走。","book":"《庄子·秋水》"},"example":{"text":"向欧阳锋那艘大船瞧去，见船头扯着一面大白旗，旗上绣着一条～双头怪蛇，心中甚是不喜。（金庸《射雕英雄传》第十九回）"},"usage":"作谓语、状语、定语；用于惊讶等"},{"id":17626,"word":"张口掉舌","pinyin":"zhāng kǒu diào shé","abbr":"zkds","explanation":"指发表言论。","source":{"text":"张口掉舌，则谓之讪谤；俯首避事，则谓之诡随，是时难事也。","book":"唐·罗隐《谗书·叙二狂生》"},"usage":"作谓语、宾语；用于书面语"},{"id":17627,"word":"张口结舌","pinyin":"zhāng kǒu jié shé","abbr":"zkjs","explanation":"结舌：舌头不能转动。张着嘴说不出话来。形容理屈词穷，或因紧张害怕而发愣。","source":{"text":"公孙龙口呿而不合，舌举而不下，乃逸而走。","book":"《庄子·秋水》"},"example":{"text":"凶手感到这声音象是一个铁棒击打在他的头上，他转头一看，大惊失措，～。","book":"曲波《林海雪原》二十八"},"similar":["哑口无言","瞠目结舌"],"opposite":["口若悬河","滔滔不绝"],"usage":"作谓语、状语、定语；指惊讶或害怕"},{"id":17628,"word":"张唇植髭","pinyin":"zhāng chún zhí zī","abbr":"zczz","explanation":"指唇吻开合。形容滔滔不绝地论列是非的样子。","source":{"text":"其一则极守旧之人，夙负盛名，为天下所归往，及见西法，不欲有一事为彼所不知不能也，乃举声光化电之粗迹，兵商工艺之末流，毛举糠秕，附会经训，张唇植髭，不自愧汗。","book":"严复《论中国分党》"},"similar":["口若悬河"],"usage":"作谓语、定语；用于书面语"},{"id":17629,"word":"张嘴挢舌","pinyin":"zhāng zuǐ jiǎo shé","abbr":"zzjs","explanation":"犹张口结舌。","source":{"text":"重庆道一见了他，也不暇多叙寒暄，便把领事的一番话述了出来。某观察听了，不觉张嘴挢舌。","book":"清·吴研人《二十年目睹之怪现状》第八十一回"},"similar":["张口结舌","张嘴结舌"],"usage":"作谓语、状语、定语；指惊讶或害怕"},{"id":17630,"word":"张嘴结舌","pinyin":"zhāng zuǐ jié shé","abbr":"zzjs","explanation":"张着嘴说不出话来。形容理屈词穷、害怕或惊愕","source":{"text":"三娘这阵连珠炮，说得老刘张嘴结舌，不知怎么辩白是好……","book":"茹志鹃《里程》"},"similar":["张口结舌","张嘴挢舌"],"usage":"作谓语、状语、定语；指惊讶或害怕"},{"id":17631,"word":"张大其事","pinyin":"zhāng dà qí shì","abbr":"zdqs","explanation":"张：夸张。把原来的事情夸大。形容言过其实。亦作“张皇其事”、“张大其辞（词）”、“张扬其事”。","source":{"text":"太史氏又能张大其事，为传继二疏踪迹否？","book":"唐·韩愈《送杨少尹序》"},"example":{"text":"襄公欲以举闻于诸侯，故意用此极刑，～也。","book":"《东周列国志》第十三回"},"similar":["张大其词"],"usage":"作谓语、定语；用于说话等"},{"id":17632,"word":"张大其词","pinyin":"zhāng dà qí cí","abbr":"zdqc","explanation":"张大：夸大。说话写文章将内容夸大。","source":{"text":"太史氏又能张大其事，为传继二疏踪迹否？","book":"唐·韩愈《送杨少尹序》"},"example":{"text":"傅二棒锤索性～，说得天花乱坠，不但身到其处，且一一都考较过。","book":"清·吴敬梓《官场现形记》第五十二回"},"similar":["张大其事","夸大其词"],"opposite":["实事求是"],"usage":"作谓语、宾语、定语；指浮夸"},{"id":17633,"word":"张大其辞","pinyin":"zhāng dà qí cí","abbr":"zdqc","explanation":"把原来的事情夸大。形容言过其实。同“张大其词”。","source":{"text":"卿于席间，张大其辞，虽然存了齐国一时体面，只恐三杰之后，难乎其继。如之奈何？","book":"《东周列国志》第七十一回"}},{"id":17634,"word":"张家长李家短","pinyin":"zhāng jiā cháng lǐ jiā duǎn","abbr":"zjzljd","explanation":"说张家的长，李家的短。比喻与己无关的闲话。","source":{"text":"那婆子吃了许多酒，口里只管夹七带八嘈，正在那里，张家长，李家短，说白道绿。","book":"明·施耐庵《水浒传》第21回"},"example":{"text":"女人在一起就爱～地说过没完。"},"similar":["说白道绿","说三道四"],"usage":"作宾语、定语；指闲话"},{"id":17635,"word":"张家长，李家短","pinyin":"zhāng jiā cháng，lǐ jiā duǎn","abbr":"zjzljd","explanation":"指无聊地议论别人家的琐事。","source":{"text":"那婆子吃了许多酒，口里只管夹七带八嘈。正在那里张家长，李家短，白说绿道。","book":"明·施耐庵《水浒全传》第二十一回"},"example":{"text":"船中人你说张家长，我说李家短，不一时，行至湖中央。（明·凌濛初《二刻拍案惊奇》卷一）"}},{"id":17636,"word":"张徨失措","pinyin":"zhāng huáng shī cuò","abbr":"zhsc","explanation":"慌乱失常，不知所措。同“张皇失措”。","source":{"text":"这突然的袭击使我张徨失措。","book":"朱自清《白种人——上帝的骄子》"},"similar":["张皇失措","张惶失措"],"usage":"作谓语、宾语、状语；指惊慌"},{"id":17637,"word":"张惶失措","pinyin":"zhāng huáng shī cuò","abbr":"zhsc","explanation":"惊慌得不知怎么办才好","example":{"text":"我一时～，不知如何应对"},"similar":["张徨失措","张皇失措"],"usage":"作谓语、宾语、状语；指惊慌"},{"id":17638,"word":"张慌失措","pinyin":"zhāng huāng shī cuò","abbr":"zhsc","explanation":"慌张得不知如何是好。","example":{"text":"凡事先有心理准备，遇到变故时不致～。"}},{"id":17639,"word":"张扬其事","pinyin":"zhāng yáng qí shì","abbr":"zyqs","explanation":"张扬：宣扬。把事情加以宣扬。","source":{"text":"太史氏又能张大其事，为传继二疏踪迹否？","book":"唐·韩愈《送杨少尹序》"},"example":{"text":"他向下山的诸弟子一再叮嘱，千万不可～。（金庸《笑傲江湖》第二十九回）"}},{"id":17640,"word":"张敞画眉","pinyin":"zhāng chǎng huà méi","abbr":"zchm","explanation":"张敞：汉时平阳人，宣帝时为京兆尹。张敞替妻子画眉毛。旧时比喻夫妻感情好。","source":{"text":"然敞无威仪，时罢朝会，过走马章台街，使御史驱，自以便面拊马。又为妇画眉，长安中传张京兆眉抚。","book":"《汉书·张敞传》"},"example":{"text":"假如～，相如病渴，虽为儒者所讥，然夫妇之情，人伦之本，此谓之正色。","book":"明·冯梦龙《醒世恒言》卷十五"},"similar":["京兆画眉","画眉张敞"],"usage":"作宾语、定语；指夫妻恩爱","story":["汉朝时期，京兆尹张敞为官没有官架子，经常在散朝后步行回家。他们夫妻十分恩爱，每天都为他的妻子画眉毛，而且技艺十分娴熟，画出的眉毛十分漂亮，当时的汉宣帝得知后为此召见他们，将他们树立夫妻恩爱的典范"]},{"id":17641,"word":"张本继末","pinyin":"zhāng běn jì mò","abbr":"zbjm","explanation":"把事情的本末说明白。","source":{"text":"［《左传》］其书善礼，多膏腴美辞，张本继末，以发明经意，信多奇伟，学者好之。","book":"《宋书·礼志一》"},"usage":"作谓语、定语；用于书面语"},{"id":17642,"word":"张机设阱","pinyin":"zhāng jī shè jǐng","abbr":"zjsj","explanation":"张机：设机关；阱：陷坑。暗设机关，布置陷阱，捕捉敌人。也形容故意陷害对方。","source":{"text":"制人于危难，扼人于深绝，诱人于伏内，张机设阱，必度其不可脱而后发。","book":"明·揭喧《兵经百篇·发字》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":17643,"word":"张火伞","pinyin":"zhāng huǒ sǎn","abbr":"zhs","explanation":"张：展开；火伞：比喻夏天太阳酷烈。形容夏天烈日当空，十分炎热。","source":{"text":"光华闪壁见神鬼，赫赫炎官张火伞。","book":"唐·韩愈《游青龙寺赠崔太补阙》诗"},"example":{"text":"今夏天气，酷热异常，赤日当空，若～，几于铄石流金。（清·王韬《淞隐漫录·冯佩伯》）"},"similar":["火伞高张"],"usage":"作谓语、定语；形容十分炎热"},{"id":17644,"word":"张灯挂彩","pinyin":"zhāng dēng guà cǎi","abbr":"zdgc","explanation":"张：设置；挂：悬挂；彩：彩绸。挂上灯笼，系上彩绸。形容节日或有喜庆事情的景象。","source":{"text":"张灯结绮笼驰道，六六洞天连夜到。","book":"宋·贺铸《木兰花·东邻妙》"},"example":{"text":"伯芬便叫人把阖衙门里里外外，一齐～。（清·吴趼人《二十年目睹之怪现状》第九十一回）"},"similar":["张灯结彩"],"usage":"作谓语、状语；指喜庆气氛"},{"id":17645,"word":"张灯结彩","pinyin":"zhāng dēng jié cǎi","abbr":"zdjc","explanation":"挂上灯笼，系上彩绸。形容节日或有喜庆事情的景象。","source":{"text":"告谕城内居民，尽张灯结彩，庆赏佳节。","book":"明·罗贯中《三国演义》第六十九回"},"example":{"text":"国庆节期间，广场上～，好不热闹。"},"similar":["披红戴绿"],"opposite":["披麻戴孝"],"usage":"作谓语、状语；指喜庆气氛"},{"id":17646,"word":"张灯结采","pinyin":"zhāng dēng jié cǎi","abbr":"zdjc","explanation":"形容节日或有喜庆事情的景象。同“张灯结彩”。"},{"id":17647,"word":"张牙切齿","pinyin":"zhāng yá qiè chǐ","abbr":"zyqc","explanation":"切齿：咬紧牙齿，表示痛恨。形容极端仇视或痛恨。也形容把某种情绪或感觉竭力抑制住。","source":{"text":"亦有雪山象王、金毛狮子，震目扬眉，张牙切齿，奋迅毛衣，摇头摆尾。","book":"《敦煌变文集·降魔变文》"}},{"id":17648,"word":"张牙舞爪","pinyin":"zhāng yá wǔ zhǎo","abbr":"zywz","explanation":"张：张开；舞：挥舞。形容猛兽凶恶可怕。也比喻猖狂凶恶。","source":{"text":"鱼生三日游于江湖，龙生三日张牙舞爪。","book":"《敦煌变文集·孔子项托相问书》附录二《新编小儿难孔子》"},"example":{"text":"见了州官，州判老爷胆子也壮了，～，有句没句，跟着教习说了一大泡。","book":"清·李宝嘉《官场现形记》第五十五回"},"similar":["呲牙咧嘴","凶相毕露","青面獠牙"],"opposite":["和颜悦色","和蔼可亲","喜眉笑眼"],"usage":"作谓语、定语、状语；指人的外表神态"},{"id":17649,"word":"张狂妄行","pinyin":"zhāng kuáng wàng xíng","abbr":"zkwx","explanation":"张狂：嚣张，轻狂。气焰嚣张，胡作非为。","source":{"text":"智不别扬，张狂妄行。","book":"汉·焦延寿《易林·噬嗑》"}},{"id":17650,"word":"张王李赵","pinyin":"zhāng wáng lǐ zhào","abbr":"zwlz","explanation":"四者皆最常见的姓，连用泛指一般人。","source":{"text":"亦可张甲之情，寄王乙之躯，李丙之性，托赵丁之体。","book":"《梁书·儒林传·范缜》"},"example":{"text":"俚语有～之语，犹言是何等人，无足挂齿牙之意也。宣和间，张子能、王履道、李士美、赵圣从俱在政府，是时张王李赵之语，喧于朝野，闻者莫不笑之。","book":"宋·朱弁《"},"similar":["张三李四"],"usage":"作宾语、定语；泛指一般人"},{"id":17651,"word":"张王赵李","pinyin":"zhāng wáng zhào lǐ","abbr":"zwzl","explanation":"泛指一些人。也指寻常之辈。","source":{"text":"亦可张甲之情寄王乙之躯，李丙之性托赵丁之体。","book":"《梁书·范缜传》"},"similar":["张三李四"],"usage":"作宾语、定语；泛指一些人"},{"id":17652,"word":"张甲李乙","pinyin":"zhāng jiǎ lǐ yǐ","abbr":"zjly","explanation":"犹言张三李四。","source":{"text":"张甲李乙，尚犹先之，此主人意待之不优之效也。","book":"汉·张奂《诫兄弟书》：“不自克责，反云张甲谤我，李乙怨我，我无是过，尔亦已矣。”三国·魏·曹操《与王修书》"},"example":{"text":"三国·魏·曹操《与王修书》：“～，尚犹先之，此主人意待之不优之效也。”"},"similar":["张三李四","张三吕四","阿猫阿狗"],"usage":"作主语、宾语；用于书面语"},{"id":17653,"word":"张皇其事","pinyin":"zhāng huáng qí shì","abbr":"zhqs","explanation":"把原来的事情夸大。形容言过其实。同“张大其词”。","source":{"text":"祖道及庄擅兴师旅，启衅邀功，妄言诸蛮效顺，纳款得地。当时柄臣揽为绥抚四夷之功。奏贺行赏，张皇其事。自昔欺君，无大于此。","book":"《宋史·张庄传》"},"example":{"text":"贾似道料定恭宗年少胆怯，故意将元兵消息，～，奏闻天子，自请统军行边。","book":"明·冯梦龙《喻世明言》第二十二卷"}},{"id":17654,"word":"张皇失措","pinyin":"zhāng huáng shī cuò","abbr":"zhsc","explanation":"张皇：慌张；失措：举止失去常态。惊慌得不知怎么办才好。","source":{"text":"遍索新郎不得，合家大噪，远近寻觅，廪生与表妹亦张皇失措。","book":"清·采蘅子《虫鸣漫录》"},"example":{"text":"不管风浪多大，他也不会～的。"},"similar":["惊慌失措","张惶失措","张皇失错"],"opposite":["从容不迫","处之泰然","泰然自若"],"usage":"作谓语、宾语、状语；指惊慌"},{"id":17655,"word":"张皇失错","pinyin":"zhāng huáng shī cuò","abbr":"zhsc","explanation":"张皇：慌张。惊慌得不知怎么办才好","source":{"text":"你看他胁肩谄笑，趋前退后，张皇失错。","book":"元·杨景贤《西游记·三官逢盗》"},"similar":["张皇失措","张皇莫措"],"opposite":["从容不迫","处之泰然"],"usage":"作谓语、宾语、状语；指惊慌"},{"id":17656,"word":"张皇幽眇","pinyin":"zhāng huáng yōu miǎo","abbr":"zhym","explanation":"皇：大，显。指阐发、张扬思想或著述中的深妙精微之处。","source":{"text":"先生之业，可谓勤矣。抵排异端，攘斥佛老，补苴罅漏，张皇幽眇。","book":"唐·韩愈《进学解》"}},{"id":17657,"word":"张皇无措","pinyin":"zhāng huáng wú cuò","abbr":"zhwc","explanation":"张皇：慌张；无措：举止失去常态。惊慌得不知怎么办才好。","source":{"text":"你看他胁肩谄笑，趋前退后，张皇失错。","book":"元·杨景贤《西游记·三官逢盛》"},"example":{"text":"尹子崇虽然也同他周旋，毕竟是贼人胆虚，终不免失魂落魄，～。（清·李宝嘉《官场现形记》第五十三回）"}},{"id":17658,"word":"张皇莫措","pinyin":"zhāng huáng mò cuò","abbr":"zhmc","explanation":"张皇：慌张；措：举止。惊慌得不知怎么办才好。","source":{"text":"你看他胁肩谄笑，趋前退后，张皇失错。","book":"元·杨景贤《西游记·三官逢盛》"},"example":{"text":"先兄晴湖曰，饮卤汁者血凝而死，无药可医。里有妇人饮此者，方～。（清·纪昀《阅微草堂笔记·如是我闻一》）"},"similar":["张皇失措","张皇失错"],"opposite":["从容不迫","处之泰然"],"usage":"作谓语、宾语、状语；指惊慌"},{"id":17659,"word":"张皇铺饰","pinyin":"zhāng huáng pū shì","abbr":"zhps","explanation":"铺：铺张；饰：装饰。夸张炫耀，大加修饰。","source":{"text":"区区一郡，何直得如此张皇？","book":"清·蒲松龄《聊斋志异·公孙夏》"}},{"id":17660,"word":"张眉努目","pinyin":"zhāng méi nǔ mù","abbr":"zmnm","explanation":"扬起眉毛，瞪着眼睛。比喻粗犷浅露。","source":{"text":"山僧今日向诸人面前，说家门已是不著便，岂可更去胞堂入室，拈槌竖拂，东喝西棒，张眉努目，如痫病发相似。","book":"宋·释普济《五灯会元·芙蓉道楷禅师》"},"example":{"text":"若文及翁之，‘借问孤山林处士，但掉头笑指梅花蕊，天下事，可知矣。’不免有～之态。","book":"清·陈廷焯《白雨斋词话》卷二"},"similar":["张眉努眼"],"usage":"作定语、状语；用于人的神态"},{"id":17661,"word":"张眉努眼","pinyin":"zhāng méi nǔ yǎn","abbr":"zmny","explanation":"扬起眉毛，瞪着眼睛。指善于作态。","source":{"text":"而今人所以知于人者，都是两边作得来，张眉努眼，大惊小怪。","book":"宋·朱熹《朱子语类》卷四四"},"similar":["张眉努目"],"usage":"作定语、状语；用于人的神态"},{"id":17662,"word":"张眉张眼","pinyin":"zhāng méi zhāng yǎn","abbr":"zmzy","explanation":"惊惶不安的样子。","source":{"text":"堂屋里的洋灯依旧燃着，正中摆着一口白木棺材，棺材附近站着两三个兵士，显出一种张眉张眼的惊惶神气。","book":"沙汀《在祠堂里》"},"usage":"作定语、状语；用于人的神态"},{"id":17663,"word":"张眼露睛","pinyin":"zhāng yǎn lù jīng","abbr":"zylj","explanation":"指瞪着眼睛说瞎话。","source":{"text":"这晁大哥可是听着人张眼露睛的没要紧！","book":"清·西周生《醒世姻缘传》第八回"},"usage":"作定语、状语；用于书面语"},{"id":17664,"word":"张筵设戏","pinyin":"zhāng yán shè xì","abbr":"zysx","explanation":"张筵：摆酒席。喝酒看戏曲。形容大摆排场，铺张浪费。","example":{"text":"旧时王府经常～招待那些达官贵人"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":17665,"word":"张红燃爆","pinyin":"zhāng hóng rán bào","abbr":"zhrb","explanation":"张：张贴。张贴红对联或喜报，燃放爆竹。形容节日或逢喜事时喜庆的样子。","source":{"text":"考选入校，则张红燃爆以示宠荣。","book":"梁启超《新民说》第11节"},"example":{"text":"考选入校，则～有示宠荣。（清·梁启超《新民说》）"},"similar":["张灯挂彩"],"usage":"作谓语、定语；用于书面语"},{"id":17666,"word":"张纲埋轮","pinyin":"zhāng gāng mái lún","abbr":"zgml","explanation":"张纲：汉朝人。张纲埋车轮。比喻敢于弹劾当权者。","source":{"text":"其可称者，若朱云折槛以抗愤，张纲埋轮而献直。余人受命之部，而纲独埋其车轮于洛阳都亭，曰：‘豺狼当路，安问狐狸！’","book":"《后汉书·张纲传》"},"example":{"text":"其可称者，若朱云折槛以抗愤，～而献直。（唐·刘知己《史通·言语》）"}},{"id":17667,"word":"张脉偾兴","pinyin":"zhāng mài fèn xīng","abbr":"zmfx","explanation":"血管膨胀，青脉突起。张，通“胀”。后以指因冲动而举措失宜。","source":{"text":"气狡愤於外，则血脉必周身而作，随气张动。","book":"《左传·僖公十五年》：“乱气狡愤，阴血周作，张脉偾兴，外彊中乾。”杜预注"},"example":{"text":"清·谭嗣同《思纬氤氲台短书——报贝元徵》：“迄乎今日，奄奄一息，自救之不遑，顾不度德，不量力，～，忽起而与能变法之日本战。”"},"usage":"作定语、状语；用于书面语"},{"id":17668,"word":"张舌骗口","pinyin":"zhāng shé piàn kǒu","abbr":"zspk","explanation":"卖弄口舌，顛倒是非。","source":{"text":"动不动神头鬼脸，投河奔井，拽巷逻街，张舌骗口，花言巧语，指皂为白。","book":"元·武汉臣《玉壶春》第三折"}},{"id":17669,"word":"张良借箸","pinyin":"zhāng liáng jiè zhù","abbr":"zljz","explanation":"张良：西汉时刘邦的谋臣。箸：筷子。张良借（刘邦的）筷子为他筹画指点。比喻出谋划策。"},{"id":17670,"word":"张良慕赤松","pinyin":"zhāng liáng mù chì sōng","abbr":"zlmcs","explanation":"慕：羡慕；赤松：仙人赤松子。张良羡慕赤松子。比喻功成名就后，想要隐退，摆脱世俗，追随神仙。","source":{"text":"家世相韩，及韩灭，不爱万金之资，为韩报仇强秦，天下振动，今以三寸舌为帝者师，封万户，位列侯，此布衣之极，于良足矣，愿弃人间事，欲从赤松子游耳。","book":"《史记·留侯世家》"}},{"id":17671,"word":"张袂成帷","pinyin":"zhāng mèi chéng wéi","abbr":"zmcw","explanation":"张开袖子成为帷幕。形容人多。","source":{"text":"齐之临淄三百闾，张袂成帷，挥汗成雨，比肩继踵而在，何为无人？","book":"汉·刘向《说苑·奉使》"},"similar":["张袂成阴"],"usage":"作定语；用于书面语"},{"id":17672,"word":"张袂成阴","pinyin":"zhāng mèi chéng yīn","abbr":"zmcy","explanation":"张开袖子能遮掩天日，成为阴天。形容人多。","source":{"text":"晏子对曰：‘齐之临淄三百闾，张袂成阴，挥汗成雨，比肩继踵而在，何为无人？’","book":"《晏子春秋·杂下九》"},"similar":["张袂成帷"],"usage":"作定语；用于书面语"},{"id":17673,"word":"张设布列","pinyin":"zhāng shè bù liè","abbr":"zsbl","explanation":"指陈设安排","source":{"text":"此言其张设布列不易者也。","book":"唐·孔颖达《周易正义序》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":17674,"word":"弢迹匿光","pinyin":"tāo jì nì guāng","abbr":"tjng","explanation":"指隐藏行迹与光采，不使外露。","source":{"text":"彭越观时，弢迹匿光，人具而瞻，翼尔鹰扬。","book":"晋·陆机《汉高祖功臣颂》"},"similar":["韬光养晦"],"usage":"作谓语、宾语；指不出风头"},{"id":17675,"word":"弥天之罪","pinyin":"mí tiān zhī zuì","abbr":"mtzz","explanation":"弥天：满天。形容极大的罪恶。","source":{"text":"虞臣计有弥天罪，今将草命献王前。","book":"《敦煌变文集·李陵变文》"},"example":{"text":"臣有～，亦有弥天之功。","book":"宋·王偁《东都事略·丁渭》"}},{"id":17676,"word":"弥天亘地","pinyin":"mí tiān gèn dì","abbr":"mtgd","explanation":"弥：满；亘：横贯。山上和田野里到处都是。形容数量很多。","source":{"text":"允曰：‘董贼之罪，弥天亘地，不可胜言。’","book":"明·罗贯中《三国演义》第九回"},"similar":["弥山亘野"],"usage":"作谓语、定语、状语；形容人或动植物"},{"id":17677,"word":"弥天大祸","pinyin":"mí tiān dà huò","abbr":"mtdh","explanation":"弥：满。天大的灾祸。","source":{"text":"这都是你不合自揽着这场弥天大祸。","book":"元·无名氏《盆儿鬼》"},"example":{"text":"他意识到自己闯了～。"},"similar":["灭顶之灾"],"opposite":["吉星高照"],"usage":"作主语、宾语；形容犯了很大的过错"},{"id":17678,"word":"弥天大罪","pinyin":"mí tiān dà zuì","abbr":"mtdz","explanation":"弥天：满天。形容极大的罪恶。","source":{"text":"纵有那弥天罪，也难赎。","book":"《敦煌变文集·李陵变文》：“虞臣计有弥天罪，今将草命献王前。”元·无名氏《谢金吾》第四折"},"example":{"text":"他家两房只有这一子，任是犯了～，何至于把他撵出大门。","book":"清·吴趼人《情变》第五回"},"similar":["滔天罪行"],"opposite":["丰功伟绩"],"usage":"作主语、宾语；指极大的罪恶"},{"id":17679,"word":"弥天大谎","pinyin":"mí tiān dà huǎng","abbr":"mtdh","explanation":"弥天：满天。形容天大的谎话。","source":{"text":"那厮主置定乱宫心，酝酿着漫天谎。","book":"元·王伯成《李太白贬夜郎》"},"example":{"text":"‘谁撒这个～啊，’胖老婆道：‘那可丧尽天良啊！’","book":"冯德英《迎春花》第14章"},"similar":["欺人之谈"],"opposite":["肺腑之言"],"usage":"作宾语；形容非常荒谬的谎言"},{"id":17680,"word":"弥天盖地","pinyin":"mí tiān gài dì","abbr":"mtgd","explanation":"弥：充满。布满天空，盖遍大地。形容来势很猛。","source":{"text":"忽见喽罗来报道：‘前面遮天盖地的番兵败下来了。’","book":"清·钱彩《说岳全传》第二十七回"},"example":{"text":"江南冬天湿冷的大雾，～。","book":"张抗抗《隐形伴侣》第三章"}},{"id":17681,"word":"弥山亘野","pinyin":"mí shān gèn yě","abbr":"msgy","explanation":"指满山遍野。","source":{"text":"二花在江东弥山亘野，殆与榛莽相似。","book":"宋·洪迈《容斋随笔·王蕊杜鹃》"},"example":{"text":"明兵～，且战且走，六镇兵皆溃入杏山。","book":"清·魏源《圣武记》第一卷"},"similar":["弥山遍野"],"usage":"作谓语、定语、状语；形容人或动植物"},{"id":17682,"word":"弥山跨谷","pinyin":"mí shān kuà gǔ","abbr":"mskg","explanation":"弥：满；跨：超越一定限度。遍布山谷。形容数量多，到处都是。","source":{"text":"于是乎离宫别馆，弥山跨谷。","book":"汉·司马相如《上林赋》"}},{"id":17683,"word":"弥山遍野","pinyin":"mí shān biàn yě","abbr":"msby","explanation":"弥：满；遍：遍及。山上和田野里到处都是。形容数量很多、范围很广、声势很大。","source":{"text":"忽然山谷之中，金鼓之声四起，蛮兵弥山遍野而来。","book":"明·冯梦龙《喻世明言》第八卷"},"similar":["漫山遍野","弥山亘野"],"opposite":["寥寥无几"],"usage":"作谓语、定语、状语；形容人或动植物"},{"id":17684,"word":"弥患无形","pinyin":"mí huàn wú xíng","abbr":"mhwx","explanation":"弥：消除。把祸患消除在没有形成之前。","source":{"text":"现在外国人已无话说，足见他能够弥患无形，办事切实。","book":"清·李宝嘉《文明小史》第六回"},"similar":["防患未然"],"usage":"作谓语、宾语、定语；用于预防"},{"id":17685,"word":"弥日亘时","pinyin":"mí rì gèn shí","abbr":"mrgs","explanation":"弥：满；亘：连续。指一天到晚。","source":{"text":"言谈赏笑，弥日亘时，未尝倦苦。","book":"《南史·刘穆之传》"},"usage":"作谓语；指一天到晚"},{"id":17686,"word":"弥日累夜","pinyin":"mí rì lèi yè","abbr":"mrly","explanation":"连日连夜，夜以继日。","source":{"text":"遂留共语，弥日累夜。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"南朝·梁·任昉《述异记》：“绍之见群鼠大者如豚，鲜泽五色，或纯或驳，或著平上帻，或著龙头，大小百数，～。”"},"similar":["夜以继日"],"usage":"作谓语、状语；同“夜以继日”"},{"id":17687,"word":"弥留之际","pinyin":"mí liú zhī jì","abbr":"mlzj","explanation":"弥留：本指久病不愈，后多指病重将死；际：时候。病危将死的时候。","source":{"text":"病日臻，既弥留。","book":"《尚书·顾命》"},"example":{"text":"他在～说出了他心中的秘密。"},"similar":["日落西山"],"usage":"作宾语；指病危将死的时候"},{"id":17688,"word":"弥缝其阙","pinyin":"mí féng qí què","abbr":"mfqq","explanation":"弥缝：补救；阙：过错。补救行事的过失。","source":{"text":"弥缝其阙而匡救其灾，昭旧职也。","book":"《左传·僖公二十六年》"},"example":{"text":"天子君临四海，日有万机，懋建诤臣，～。","book":"《宋史·杨昭俭传》"},"usage":"作谓语、定语；用于书面语"},{"id":17689,"word":"弦外之响","pinyin":"xián wài zhī xiǎng","abbr":"xwzx","explanation":"比喻言外之意。","source":{"text":"古今词人格调之高无如白石，惜不于意境上用力，故觉无言外之味，弦外之响。","book":"王国维《人间词话》四二"},"similar":["弦外之音","弦外有音","弦外之意"],"usage":"作宾语；用于说话等"},{"id":17690,"word":"弦外之意","pinyin":"xián wài zhī yì","abbr":"xwzy","explanation":"弦：乐器上发音的丝线。比喻言外之意，即在话里间接透露，而不是明说出来的意思。","source":{"text":"其中体趣，言之不可尽。弦外之意，虚响之音，不知所从而来。","book":"《南史·范晔传》"},"example":{"text":"他～已经很明了。"},"similar":["弦外有音","意在言外","弦外之音"],"usage":"作主语、宾语；指言外之意"},{"id":17691,"word":"弦外之音","pinyin":"xián wài zhī yīn","abbr":"xwzy","explanation":"原指音乐的余音。比喻言外之意，即在话里间接透露，而不是明说出来的意思。","source":{"text":"弦外之意，虚响之音，不知所从而来。","book":"南朝宋·范晔《狱中与诸甥侄书》"},"example":{"text":"自以为这一句是一唱三叹，那一句是～。","book":"刘半农《奉答王敬轩先生》"},"similar":["言外之意"],"opposite":["直言直语","实话实说"],"usage":"作主语、宾语；比喻言外之意"},{"id":17692,"word":"弦外有音","pinyin":"xián wài yǒu yīn","abbr":"xwyy","explanation":"比喻话语中另有间接透露、没有明说的意思。","source":{"text":"然至于一绝处，亦复何耶！其中体趣，言之不尽。弦外之意，不知所从而来。","book":"南朝·宋·范晔《狱中与诸甥侄书》"},"example":{"text":"其中一个秃头顶的人，过去是行政科长，～地说：‘老厂长，别看你把我们忘了。’","book":"蒋子龙《乔厂长上任记》"},"similar":["弦外之音","言外之意"],"opposite":["实话实说"],"usage":"作谓语、宾语、状语；用于人"},{"id":17693,"word":"弦外遗音","pinyin":"xián wài yí yīn","abbr":"xwyy","explanation":"指乐声中蕴含有令人难忘的韵味。比喻文辞、语言中的言外之意。","source":{"text":"清庙之瑟，朱弦而疏越，壹倡而三叹，有遗音者矣。","book":"《礼记·乐记》"},"example":{"text":"只叹鼻端无妙斫，岂知弦外有遗音。","book":"宋·陆游《雨后殊有秋意》"},"similar":["弦外有音","言外之意","弦外之音"],"usage":"作宾语、定语；用于说话等"},{"id":17694,"word":"弦无虚发","pinyin":"xián wú xū fā","abbr":"xwxf","explanation":"指射箭百发百中。","source":{"text":"又有西域胡，妙于弓矢，弦无虚发，众军尤惮之。","book":"《陈书·萧摩诃传》"},"similar":["百发百中","矢无虚发"],"usage":"作谓语、定语；指人武艺高"},{"id":17695,"word":"弦歌不绝","pinyin":"xián gē bù jué","abbr":"xgbj","explanation":"弹琴、歌吟之声不断。","source":{"text":"兄元信，杖气豪侈，每食方丈，坐客恒满，弦歌不绝；而善独恭己率素，爱乐闲静。","book":"《北史·薛善传》"},"example":{"text":"所以在举国闹学潮的期间，只有神易大学的师生依旧～的修业乐道。","book":"老舍《赵子曰》第八章"},"usage":"作谓语、定语；用于书面语"},{"id":17696,"word":"弦歌之声","pinyin":"xián gē zhī shēng","abbr":"xgzs","explanation":"弹琴和唱歌吟诗的声音。古时学校重视音乐教育，也泛指教育或教学活动。","source":{"text":"子之武城，闻弦歌之声。","book":"《论语·阳货》"},"example":{"text":"自吾之东，今将三十年，归视吾里，～相闻，儒服者于他州为多，善矣。","book":"宋·苏辙《伯父墓表》"},"similar":["弦歌之音"],"usage":"作宾语；用于教学"},{"id":17697,"word":"弦歌之音","pinyin":"xián gē zhī yīn","abbr":"xgzy","explanation":"弹琴和唱歌吟诗的声音。古时学校重视音乐教育，也泛指教育或教学活动。","source":{"text":"及高皇帝诛项籍，举兵围鲁，鲁中诸儒尚讲诵习礼乐，弦歌之音不绝，岂非圣人之遗化，好礼乐之国哉？","book":"《论语·阳货》：“子之武城，闻弦歌之声。”《史记·儒林列传》"},"example":{"text":"因魏氏丧乱，属尔硃残酷，文章咸荡，礼乐同奔，～且绝，俎豆之容将尽。","book":"《北史·儒林传》"},"similar":["弦歌之声"],"usage":"作宾语；用于教学"},{"id":17698,"word":"弦而鼓之","pinyin":"xián ér gǔ zhī","abbr":"xegz","explanation":"弦：琴弦，装上弦；鼓：弹。装上弦开始弹奏音乐。","source":{"text":"斫而为琴，弦而鼓之，金声而玉应。","book":"明·刘基《郁离子·千里马篇》"},"usage":"作谓语；指演奏"},{"id":17699,"word":"弩下逃箭","pinyin":"nǔ xià táo jiàn","abbr":"nxtj","explanation":"比喻近者反能免遭祸殃。因弩箭射远不射近，故有此比喻。","source":{"text":"今若匿得吾一身，则脱汝辈数家之祸，然万无搜近之理，所谓‘弩下逃箭’也。","book":"宋文莹《湘山野录》卷下"},"usage":"作宾语、定语；指近处反而安全"},{"id":17700,"word":"弩张剑拔","pinyin":"nǔ zhāng jiàn bá","abbr":"nzjb","explanation":"比喻雄健。亦作“剑拔弩张”。","source":{"text":"昔者周穆巡狩，至乎坛山，吉日癸巳，亲题材石间，弩张剑拔，虎跳龙盘。","book":"明丰道生《真赏斋赋》"},"example":{"text":"轻裾长袖难为伍，一卷吟哦蓬藿门。莫道而今诗思澹，～气犹存。","book":"沈砺《题近作后》诗"},"similar":["剑拔弩张"],"usage":"作谓语、定语、状语；形容双方冲突"},{"id":17701,"word":"弩箭离弦","pinyin":"nǔ jiàn lí xián","abbr":"njlx","explanation":"弩：利用机械力射箭的弓。搭在弩弓上的箭射出了弓弦。形容极其迅速。","source":{"text":"前走的如流星过度，后走的如弩箭离弦。","book":"明·吴承恩《西游记》第42回"},"usage":"作宾语；指十分迅速"},{"id":17702,"word":"弭口无言","pinyin":"mǐ kǒu wú yán","abbr":"mkwy","explanation":"紧闭着嘴，什么也不说。","source":{"text":"吾事善矣！子其弭口无言，以待吾事子其弭口无言，以待吾事。","book":"《战国策·秦策二》"}},{"id":17703,"word":"弭患无形","pinyin":"mǐ huàn wú xíng","abbr":"mhwx","explanation":"弭：消除；患：祸患；形：形成。消除祸患于未形成之前。","source":{"text":"必有消患未形，而为朝野所利赖，远人所折服也。","book":"清·黎庶昌《上沈相国书》"},"example":{"text":"现在外国人无话说，足见他能～，办事切实。","book":"清·李宝嘉《文明小史》第六回"},"similar":["防微杜渐"],"usage":"作谓语、定语；用于处事"},{"id":17704,"word":"弭盗安民","pinyin":"mǐ dào ān mín","abbr":"mdam","explanation":"弭：平息；安：稳定。平息盗贼，稳定民生。","source":{"text":"弭盗安民，事为至重，宜即议行之。","book":"《元史·武宗纪一》"},"example":{"text":"象这盗贼横行，全不肯讲究一个～的良法。","book":"清·吴敬梓《儒林外史》第三十四回"},"usage":"作宾语、定语；指稳定民生"},{"id":17705,"word":"弭耳俯伏","pinyin":"mǐ ěr fǔ fú","abbr":"meff","explanation":"弭耳：温驯的样子。俯首帖耳的样子。","source":{"text":"猛兽将搏，弭耳俯伏；圣人将动，必有愚色。","book":"《六韬·武韬·发启》"},"example":{"text":"鸷鸟之击也，卑飞敛翼；猛兽之搏也，～。","book":"《慎子·外篇》"},"similar":["俯首帖耳"],"usage":"作谓语；指臣服"},{"id":17706,"word":"弭耳受教","pinyin":"mǐ ěr shòu jiào","abbr":"mesj","explanation":"弭耳：温驯的样子。形容非常听话。","source":{"text":"且等我收伏了这个贯索奴，作个引线，不怕那条孽龙不弭耳受教。","book":"清·文康《儿女英雄传》第16回"},"usage":"作谓语；指非常驯服"},{"id":17707,"word":"弯弓饮羽","pinyin":"wān gōng yǐn yǔ","abbr":"wgyy","explanation":"形容勇猛善射。","source":{"text":"昔者楚熊渠子夜行，寝石以为伏虎，弯弓而射之，没金饮羽，下视知其为石，石为之开，而况人乎！","book":"《韩诗外传》卷六"},"example":{"text":"却敌吹笳刘越石，～李将军。","book":"清梁标《送萧都阃之云中》"},"similar":["射石饮羽"],"usage":"作定语；用于书面语","story":["春秋时期，楚国的熊渠子箭术相当精湛。一次从外地赶夜回家，借着月光看见前面好像有一只老虎在蹲着，于是拔出箭来，弯弓一射，正中目标。上前一看，原来虚惊一场，只见箭已经射到石头里，隐没了箭尾的羽毛"]},{"id":17708,"word":"弯弯曲曲","pinyin":"wān wān qū qū","abbr":"wwqq","explanation":"曲折不直的。","source":{"text":"于是二人别了惜春，离了蓼风轩，弯弯曲曲，走近潇湘馆，忽听得叮咚之声。","book":"清·曹雪芹《红楼梦》第87回"},"example":{"text":"一条～的小路伸向远方。"},"similar":["曲曲折折"],"opposite":["正正直直","笔笔直直"],"usage":"作谓语、定语；指弯曲不直","story":["妙玉来大观园探望惜春，贾宝玉自作多情要去送妙玉，两人来到弯弯曲曲的园内小路上，听到潇湘馆内传来叮咚的琴声，两人坐在石头上听这凄惨悠扬的琴声，突然琴弦断了。妙玉要回寺庙，弄得宝玉满肚疑团，没精打采地回到怡红院中"]},{"id":17709,"word":"弯腰捧腹","pinyin":"wān yāo pěng fù","abbr":"wypf","explanation":"形容大笑的样子。","source":{"text":"述农忙叫快去打听，那当差的答应着去了。一会回来，笑了个弯腰捧腹。","book":"《二十年目睹之怪现状》第六二回"},"similar":["捧腹大笑"],"usage":"作定语、宾语；指大笑"},{"id":17710,"word":"弱不好弄","pinyin":"ruò bù hǎo nòng","abbr":"rbhn","explanation":"弱：年少；好：喜欢；弄：玩耍。年幼时不爱玩耍。","source":{"text":"夷吾弱不好弄，能斗不过，长亦不改，不知其他。","book":"春秋·鲁·左丘明《左传·僖公九年》"},"example":{"text":"才三岁便行，～；至五六岁，虽不能言，所为雅有高致。","book":"《河东记·萧洞玄》"},"similar":["少年老成"],"usage":"作谓语、补语；指年轻而不爱玩"},{"id":17711,"word":"弱不禁风","pinyin":"ruò bù jīn fēng","abbr":"rbjf","explanation":"禁：承受。形容身体娇弱，连风吹都经受不起。","source":{"text":"乱波纷披已打岸，弱云狼藉不禁风。","book":"唐·杜甫《江雨有怀郑典设诗》"},"example":{"text":"如果不参加劳动，也就会沾上资产阶级的思想意识，而且～。","book":"茅盾《一九六０年短篇小说漫评》"},"similar":["瘦骨嶙峋","弱不胜衣"],"opposite":["虎背熊腰","心宽体胖","身强力壮"],"usage":"作谓语、补语、定语、宾语；形容女子"},{"id":17712,"word":"弱不胜衣","pinyin":"ruò bù shèng yī","abbr":"rbsy","explanation":"胜：禁得起。形容人很瘦弱，连衣服都承受不起。","source":{"text":"叶公子高微小短瘠，行若将不胜其衣。","book":"《荀子·非相》"},"example":{"text":"众人见黛玉年纪虽小，其举止言谈不俗，身体面貌虽～，却有一段风流态度，便知他有不足之症。","book":"清·曹雪芹《红楼梦》第三回"},"similar":["弱不禁风","质似薄柳"],"opposite":["钢筋铁骨","年富力强"],"usage":"作谓语、定语、宾语；指十分虚弱"},{"id":17713,"word":"弱冠之年","pinyin":"ruò guàn zhī nián","abbr":"rgzn","explanation":"冠：古代仪礼，男子二十岁时举行加冠礼，表示已成年。指年纪刚到成年的时候。","source":{"text":"二十曰弱冠。","book":"《礼记·曲礼上》"},"example":{"text":"所谓才子者，须是王子安～，学问文章，如江如海，乃可称之。","book":"清·吴骞《拜经楼诗话》卷四"},"usage":"作宾语；多用于男子"},{"id":17714,"word":"弱势群体","pinyin":"ruò shì qún tǐ","abbr":"rsqt","explanation":"原指在社会中处于不利地位的群体。现指在市场经济条件下，社会成员中处于竞争弱势的阶层或群体。"},{"id":17715,"word":"弱如扶病","pinyin":"ruò rú fú bìng","abbr":"rrfb","explanation":"扶病：支持病体。弱得像支撑着病体一样。形容身体非常虚弱。","source":{"text":"大约骚人咏士以此花红若施脂，弱如扶病，近乎闺阁风度，故以女命名。","book":"清·曹雪芹《红楼梦》第17回"},"usage":"作谓语、定语；用于书面语"},{"id":17716,"word":"弱本强末","pinyin":"ruò běn qiáng mò","abbr":"rbqm","explanation":"指中央权力削弱而地方势力强大。","source":{"text":"倘有结盟联党之事，是下有自固之术，私有倚倚之端，外为假公济私之举，内藏弱本强末之弊。","book":"太平天国·洪仁玕《资政新篇》"},"usage":"作宾语、定语；用于比喻句"},{"id":17717,"word":"弱水之隔","pinyin":"ruò shuǐ zhī gé","abbr":"rszg","explanation":"比喻相隔极远，到达不了。","source":{"text":"远不能到，云如有弱水之隔。","book":"宋·胡继宗《书言故事·地理类》"},"usage":"作宾语；用于书面语"},{"id":17718,"word":"弱管轻丝","pinyin":"ruo guan qing si","abbr":"rgqs","explanation":"形容乐声轻柔细弱。"},{"id":17719,"word":"弱肉强食","pinyin":"ruò ròu qiáng shí","abbr":"rrqs","explanation":"原指动物中弱者被强者吞食。比喻弱的被强的吞并。","source":{"text":"有生不幸遭乱世，弱肉强食官无诛。","book":"唐·韩愈《送浮屠文暢师序》：“弱之肉，强之食。”明·刘基《秦女体行》"},"example":{"text":"在这样“～”的情况下，“生活”是终于不易保全的。","book":"邹韬奋《抗战以来·“诸葛亮”和“阿斗”》"},"similar":["以强凌弱","仗势欺人"],"opposite":["和平共处"],"usage":"作谓语、宾语、定语；指自然竞争"},{"id":17720,"word":"弸中彪外","pinyin":"péng zhōng biāo wài","abbr":"pzbw","explanation":"弸：充满；彪：文采。指人内有才德，则有文采，自然外露。赞美德才兼备的人。","source":{"text":"或问：‘君子言则成文，动则成德，何以也？’曰：‘以其弸中而彪外也。’","book":"汉·扬雄《法言·君子》"},"example":{"text":"予读百氏，～，驰骋不可抑遏。","book":"清·薛福成《序》"},"usage":"作谓语、定语；指赞美德才兼备的人"},{"id":17721,"word":"弸中肆外","pinyin":"péng zhōng sì wài","abbr":"pzsw","explanation":"弸：充满。指人内有才德，则有文采，自然外露。赞美德才兼备的人。","source":{"text":"或问：‘君子言则成文，动则成德，何以也？’曰：‘以其弸中而彪外也。’","book":"汉·扬雄《法言·君子》"},"example":{"text":"若数年或十数年以后，其～之力，或更倍蓗于今日。","book":"清·梁启超《饮冰室文集》十九"}},{"id":17722,"word":"弹丝品竹","pinyin":"tán sī pǐn zhú","abbr":"tspz","explanation":"吹弹乐器，谙熟音乐。","source":{"text":"尽称我弹丝品竹，沉李浮瓜，此处当追赏。","book":"宋·无名氏《张协状元》戏文开场：“但咱们，虽宦裔，总皆通。弹丝品竹，那堪咏月与嘲风。”明·杨柔胜《玉环记·皋谒延赏》"},"example":{"text":"富贵的备了佳肴美酒，携妓傲游，～，直要闹到月落西山，方才人影散乱。","book":"清·刘璋《凤凰池》第四回"},"usage":"作谓语、宾语、定语；指会音乐"},{"id":17723,"word":"弹丸之地","pinyin":"dàn wán zhī dì","abbr":"dwzd","explanation":"弹丸：弹弓所用的铁丸或泥丸。弹丸那么大的地方。形容地方非常狭小。","source":{"text":"此弹丸之地弗予，令秦来年复攻王，王得无割其内而媾乎？","book":"《史记·平原君虞卿列传》"},"example":{"text":"西歧城不过～，姜子牙不过浅行之夫。","book":"明·许仲琳《封神演义》第四十四回"},"similar":["立锥之地","置锥之地"],"opposite":["地大物博","地广人稀"],"usage":"作主语、宾语；形容地盘非常狭小","story":["战国时期，秦国出兵大败赵军，秦国要赵国割六座城池讲和。赵王向曾经担任秦国丞相的赵人楼缓请教，楼缓认为还是割地求和吧。谋士虞卿则认为秦军疲惫不宜再攻就不能割地。楼缓认为给了这六座弹丸之地可以换取来年的和平"]},{"id":17724,"word":"弹丸脱手","pinyin":"tán wán tuō shǒu","abbr":"twts","explanation":"比喻作诗圆润精美、敏捷流暢。","source":{"text":"新诗如弹丸，脱手不移晷。","book":"宋·苏轼《次韵王定国谢韩子华饮》"},"example":{"text":"诸联皆琢句清新，～。","book":"清·平步青《霞外攟屑·诗话下·赓缦堂诗》"},"usage":"作宾语、定语；用于作文等"},{"id":17725,"word":"弹丸黑子","pinyin":"dàn wán hēi zǐ","abbr":"dwhz","explanation":"比喻极小。亦作“弹丸黑志”。","source":{"text":"地惟黑子，城犹弹丸。","book":"语出北周·庾信《哀江南赋》"},"example":{"text":"名都大邑，所向皆破，而吾桐独完，桐小县，仅～。","book":"清·戴名世《自序》"},"similar":["弹丸黑志"],"usage":"作宾语、定语；指小东西"},{"id":17726,"word":"弹丸黑志","pinyin":"dàn wán hēi zhì","abbr":"dwhz","explanation":"比喻极小。","source":{"text":"地惟黑子，城犹弹丸。","book":"语出北周·庾信《哀江南赋》"},"example":{"text":"太原当西北二边，使一举而下，则二边之患，我独当之，何不姑留以俟削平诸国，则～之地，将无所逃。","book":"宋·朱熹《五朝名臣言行录·赵普》"},"similar":["弹丸黑子"],"usage":"作宾语、定语；指小东西"},{"id":17727,"word":"弹冠振衣","pinyin":"tán guān zhèn yī","abbr":"tgzy","explanation":"整洁衣冠。后多以比喻将欲出仕。","source":{"text":"新沐者必弹冠，新浴者必振衣。","book":"语出《楚辞·渔父》"},"example":{"text":"是以岩穴幽人，智术之士，～，乐欲为用，四海欣然，归服圣德。","book":"《后汉书·李固传》"},"similar":["弹冠振衿"],"usage":"作谓语、宾语、定语；用于官场"},{"id":17728,"word":"弹冠振衿","pinyin":"tán guān zhèn jīn","abbr":"tgzj","explanation":"整洁衣冠。后多以比喻将欲出仕。","source":{"text":"新沐者必弹冠，新浴者必振衣。","book":"语出《楚辞·渔父》"},"example":{"text":"会今天子聪明神圣，四海之内，薰蒸浸渍，莫不～，辐辏而出。","book":"清·戴名世《序》"},"similar":["弹冠振衣"],"usage":"作谓语、宾语、定语；用于官场"},{"id":17729,"word":"弹冠相庆","pinyin":"tán guān xiāng qìng","abbr":"tgxq","explanation":"弹冠：掸去帽子上的灰尘，准备做官。指官场中一人当了官或升了官，同伙就互相庆贺将有官可做。","source":{"text":"一日无促，则三子者，可以弹冠而相庆矣。","book":"《汉书·王吉传》：“吉与贡禹为友，世称‘王阳在位，贡禹弹冠。’”宋·苏洵《管仲论》"},"example":{"text":"哥哥既已做官呵，～浑难已，怎得把樁庭消息临歧寄，使两地相思顷刻除。","book":"明·汪迁讷《种玉记·登隽》"},"similar":["额手称庆","鸡犬升天","相庆弹冠"],"opposite":["如丧考妣"],"usage":"作谓语、状语；指坏人得意的样子","story":["汉宣帝时，琅琊人王吉和贡禹是很好的朋友，贡禹多次被免职，王吉在官场也很不得志。汉元帝时，王吉被召去当谏议大夫，贡禹听到这个消息很高兴，就把自己的官帽取出，弹去灰尘，准备戴用。果然没多久贡禹也被任命为谏议大夫"]},{"id":17730,"word":"弹冠结绶","pinyin":"tán guān jié shòu","abbr":"tgjs","explanation":"朋友之间互相援引出仕。","source":{"text":"[育]少与陈咸、朱博为友，著闻当世。往者有王阳、贡公，故长安语曰：‘萧朱结绶，王贡弹冠’，言其相荐达也。","book":"《汉书·萧育传》"},"example":{"text":"建原庙以安祖考，正六宫而修典弄，百废具兴，多士爱集，～，共欣千载之逢；掩面向隅，不忍一夫之泣。","book":"宋·苏轼《谢量移汝州表》"},"usage":"作宾语、定语；用于官场"},{"id":17731,"word":"弹剑作歌","pinyin":"tán jiàn zuò gē","abbr":"tjzg","explanation":"比喻怀才不遇。","source":{"text":"弹剑作歌奏苦声，曳裾王门不称情。","book":"唐·李白《行路难·其二》"},"usage":"作宾语、定语；用于生活"},{"id":17732,"word":"弹压山川","pinyin":"tán yā shān chuān","abbr":"dysc","explanation":"旧时形容帝王的威力很大，足以制服山河。","source":{"text":"秉太一者，牢笼天地，弹压山川，含吐阴阳，伸曳四时，纪纲八极，经纬六合。","book":"《淮南子·本经训》"}},{"id":17733,"word":"弹射利病","pinyin":"tán shè lì bìng","abbr":"tslb","explanation":"弹射：直率地指摘；病：弊病。直率的批评有利于改正缺点和错误。","source":{"text":"吾好直言，无所回避，每弹射利病，为世人所讥嫌。","book":"《三国志·蜀志·孟光传》"}},{"id":17734,"word":"弹射臧否","pinyin":"tán shè zāng pǐ","abbr":"tszp","explanation":"弹射：直率地指摘；臧：好；否：坏。臧否：褒贬，评论。直率地进行批评。","source":{"text":"街谈巷议，弹射臧否，剖析毫厘，擘肌分理。","book":"汉·张衡《西京赋》"}},{"id":17735,"word":"弹尽援绝","pinyin":"dàn jìn yuán jué","abbr":"djyj","explanation":"作战中弹药用完了，援兵断绝了。也比喻处境非常困难。","source":{"text":"公挺身与兵，屡捷。七年，粮尽援绝，势不能复支，遂率所部数千人南归。","book":"宋·杨万里《钤辖赵公墓志铭》"},"example":{"text":"迄今晨三时，敌～，全线动摇。","book":"郭沫若《洪波曲》第五章"},"similar":["弹尽粮绝"],"opposite":["兵强马壮"],"usage":"作谓语、分句、宾语、定语；指陷入绝境"},{"id":17736,"word":"弹尽粮绝","pinyin":"dàn jìn liáng jué","abbr":"djlj","explanation":"作战中弹药用完了，粮食也断绝了。指无法继续作战的危险处境。","source":{"text":"血战三日夜，矢尽援绝，遂死之。","book":"宋·魏了翁《故太府寺丞兼知兴元府利州路安抚郭公墓志铭》"},"example":{"text":"他们已陷入～的地步。"},"similar":["山穷水尽","危在旦夕","危在旦夕"],"opposite":["源源不断","方兴未艾"],"usage":"作谓语、定语；形容陷入困境"},{"id":17737,"word":"弹指之间","pinyin":"tán zhǐ zhī jiān","abbr":"tzzj","explanation":"弹指：按佛经说法，二十念为一瞬，二十瞬为一弹指。比喻时间极短暂。","source":{"text":"平生多少事，弹指一时休。","book":"唐·司空图《偶书之四》"},"example":{"text":"～，心九百六十转，一日一夕十三忆意。（康僧会《安般守意经序》）"},"similar":["转瞬之间"],"usage":"作宾语；比喻时间极短暂"},{"id":17738,"word":"弹斤估两","pinyin":"tán jīn gū liǎng","abbr":"tjgl","explanation":"形容掂量轻重。","source":{"text":"言真道假、弹斤估两的在日光中烜耀。惹得一市人都来观看，不住声的有人喝采。","book":"明·冯梦龙《喻世明言》第一卷"},"similar":["弹筋估两"],"usage":"作定语、状语；用于估算"},{"id":17739,"word":"弹无虚发","pinyin":"dàn wú xū fā","abbr":"dwxf","explanation":"弹：弹子或子弹。弹子或子弹颗颗中靶，没有一颗打出靶外。形容百发百中。","source":{"text":"弓弦响处，那弹子如雨点一般打将出去，真是：‘弹无虚发’，每发一弹，岸上即倒一人。","book":"清·李汝珍《镜花缘》第26回"},"example":{"text":"俟其近，乃以机关枪扫射之，～。","book":"章炳麟《书十九路军御日本事》"},"similar":["箭不虚发","百发百中","万无一失"],"opposite":["百无一存","无的放矢"],"usage":"作谓语、宾语；指百发百中"},{"id":17740,"word":"弹空说嘴","pinyin":"tán kōng shuō zuǐ","abbr":"tksz","explanation":"犹言唱高调说空话。","source":{"text":"莫要弹空说嘴。假如不幸我庄周死后，你这般如花似玉的年纪，难道捱得过三年五载？","book":"《警世通言·庄子休鼓盆成大道》"},"usage":"作谓语、宾语；指说大话"},{"id":17741,"word":"弹筋估两","pinyin":"tán jīn gū liǎng","abbr":"djgl","explanation":"形容掂量轻重。","source":{"text":"这里陈大郎拿着东西，又不放手，又不增添，故意走出屋檐，件件的翻覆认看，言真道假、弹筋估两的在日光中烜耀。","book":"《古今小说·蒋兴哥重会珍珠衫》"},"similar":["弹斤估两"],"usage":"作定语、状语；用于估算"},{"id":17742,"word":"弹铗无鱼","pinyin":"tán jiá wú yú","abbr":"djwy","explanation":"铗：剑把。指处境窘困，有求于人。","source":{"text":"长铗归来乎，食无鱼。","book":"《战国策·齐策四》"},"example":{"text":"寒灯欹枕听夜雨，堪怜～。","book":"明·张凤翼《红拂记·英豪羁旅》"},"usage":"作宾语、定语；指引起人注意","story":["战国时期，齐国孟尝君的门客有几千人，他把他们分为三等，上等有肉吃出门有车，中等有鱼吃，下等只能吃蔬菜。冯谖属于下等门客，他靠在门柱上击剑抱怨没有鱼吃。孟尝君把他升为中等门客。他又抱怨没有车，接着升为上等，这才悉心辅佐孟尝君"]},{"id":17743,"word":"弹铗求通","pinyin":"tán jiá qiú tōng","abbr":"djqt","explanation":"铗：剑把。弹着剑把唱歌，以表示自己的要求。后形容有求于别人的行为。","source":{"text":"不肯扫门觅仕，复懒弹铗求通。","book":"南朝·梁·陶弘景《答赵英才书》"}},{"id":17744,"word":"弹雨枪林","pinyin":"dàn yǔ qiāng lín","abbr":"dyql","explanation":"弹下如雨，枪立如林。形容战斗剧烈。","source":{"text":"且划策，弹雨枪林，木坏山隤，江城付动灰。","book":"清·孙雨林《皖江血·拒敌》"},"example":{"text":"无论两军对垒，～，而观战之侦探队，须履险如夷，电传消息。","book":"贯公《拒约须急设机关日报议》"},"similar":["枪林弹雨"],"usage":"作宾语、定语；形容战斗激烈"},{"id":17745,"word":"强不凌弱","pinyin":"qiáng bù líng ruò","abbr":"qblr","explanation":"指力量强大的不欺侮弱小的。","source":{"text":"故其治国也，正明法，陈严刑，将以救群生之乱，去天下之祸，使强不凌弱，众不暴寡。","book":"《韩非子·奸劫弑臣》"},"example":{"text":"仁如春阳，威若秋零。～，隐恤孤茕。","book":"《魏书·卫操传》"},"usage":"作宾语、定语；用于处世"},{"id":17746,"word":"强不凌弱，众不暴寡","pinyin":"qiáng bù líng ruò，zhòng bù bào guǎ","abbr":"qblrzbbg","explanation":"指力量强大的不欺侮弱小的，人数多的不欺负人数少的。","source":{"text":"故其治国也，正明法，陈严刑，将以救群生之乱，去天下之祸，使强不凌弱，众不暴寡。","book":"《韩非子·奸劫弑臣》"},"example":{"text":"张廷尉论定律令，明法以绳天下，诛奸猾，绝幷兼之徒，而～。","book":"汉·桓宽《盐铁论·轻重》"},"similar":["强不犯弱，众不暴寡"],"usage":"作宾语、定语；用于处世"},{"id":17747,"word":"强不犯弱，众不暴寡","pinyin":"qiáng bù fàn ruò，zhòng bù bào guǎ","abbr":"qbfrzbbg","explanation":"指力量强大的不欺侮弱小的，人数多的不欺负人数少的。","source":{"text":"强不犯弱，众不暴寡，而弟达乎州巷矣。","book":"《礼记·祭义》"},"example":{"text":"若此，则教义日深，而礼让兴；礼让兴，则～。此由太学而来者也。","book":"《旧唐书·归崇敬传》"},"similar":["强不凌弱，众不暴寡"],"usage":"作宾语、定语；用于处世"},{"id":17748,"word":"强不知以为知","pinyin":"qiǎng bù zhī yǐ wéi zhī","abbr":"qbzywz","explanation":"不懂装懂。","source":{"text":"都管强不知以为知，逐叶翻翻，一直翻到后面去。","book":"明·凌蒙初《二刻拍案惊奇》第一卷"},"example":{"text":"从此再不敢～了。","book":"清·文康《儿女英雄传》"},"similar":["不懂装懂"],"usage":"作分句、谓语；指不懂装懂"},{"id":17749,"word":"强中更有强中手","pinyin":"qiáng zhōng gèng yǒu qiáng zhōng shǒu","abbr":"qzgyqzs","explanation":"比喻技艺无止境，不能自满自大。","source":{"text":"他若是相持厮杀统戈矛，端的是强中更有强中手。","book":"元·无名氏《衣袄车》第一折"},"example":{"text":"列位看官，你道～，丫环之中，尚有……顶天立地之人。","book":"明·周楫《西湖二集·侠女散财殉节》"},"similar":["恶人更有恶人磨","强中自有强中手"],"usage":"作宾语、分句；指人不能自满自大"},{"id":17750,"word":"强中自有强中手","pinyin":"qiáng zhōng zì yǒu qiáng zhōng shǒu","abbr":"qzzyqzs","explanation":"比喻技艺无止境，不能自满自大。同“强中更有强中手”。","source":{"text":"你个萧何休夸蒯彻舌，这的是强中自有强中手。","book":"元·无名氏《隋何赚风魔蒯彻》第三折"},"example":{"text":"～，用诈还逢识诈人。","book":"明·罗贯中《三国演义》第17回"},"similar":["强中更有强中手"],"usage":"作宾语、分句；指人不能自满自大"},{"id":17751,"word":"强为欢笑","pinyin":"qiǎng wéi huān xiào","abbr":"qwhx","explanation":"强：勉强。心里不畅快，但脸上勉强装出欢笑的样子。","source":{"text":"‘汝狡兔三窟，何归为？’柴俯不对。女肘之，柴始强颜为笑。","book":"清·蒲松龄《聊斋志异·邵女》"},"example":{"text":"到了晚上，何璟应约而至，见面是～的光景。","book":"高阳《慈禧全传》五十七"},"similar":["强颜为笑"],"usage":"作谓语、定语、状语；指勉强装出欢笑的样子"},{"id":17752,"word":"强买强卖","pinyin":"qiǎng mǎi qiǎng mài","abbr":"qmqm","explanation":"强迫买或卖。","source":{"text":"再说，做买卖也没有强买强卖的。","book":"王朔《橡皮人》"},"example":{"text":"我们要打击～的行为。"},"similar":["欺行霸市"],"usage":"作主语、宾语、定语；指欺行霸市"},{"id":17753,"word":"强人所难","pinyin":"qiǎng rén suǒ nán","abbr":"qrsn","explanation":"勉强人家去做他不能做或不愿做的事情。","source":{"text":"那人王乃四海九州之主，代天宣化，岂肯颠倒，强人所难。","book":"清·李汝珍《镜花缘》第二回"},"example":{"text":"别～了，他不会答应的。"},"similar":["强按牛头","勉为其难"],"opposite":["悉听尊便","挺身而出"],"usage":"作谓语、宾语；指勉为其难"},{"id":17754,"word":"强作解事","pinyin":"qiǎng zuò jiě shì","abbr":"qzjs","explanation":"比喻本不明事情的真意而妄加解释、议论。","source":{"text":"小儿强解事，故索苦李餐。","book":"唐·杜甫《彭衙行》"},"example":{"text":"无其识而～，固不如庸俗之犹免于怪妄也。","book":"清·章学诚《文史通义·记与戴东原论修志》"}},{"id":17755,"word":"强作解人","pinyin":"qiǎng zuò jiě rén","abbr":"qzjr","explanation":"指不明真意而乱发议论的人。","source":{"text":"谢安年少时，请阮光禄道《白马论》，为论以示谢。于时谢不即解阮语，重相咨尽。阮乃叹曰：‘非但能言人不可得，正索解人亦不得。’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"你给我胡乱编派是哪一派的剑法，～，不是太可笑了吗？”","book":"梁羽生《牧野流星》第十四回"},"similar":["自作解人"],"usage":"作谓语；指乱发议论的人","story":["东晋时期，谢安年轻时对战国时期赵国公孙龙著的《白马论》不能理解，就去向金紫光禄大夫阮裕请教。阮裕写了一篇解说《白马论》的文章交给谢安。谢安对他的解说文更加看不明白，又去请教他。阮裕自叹道自己是强做解人"]},{"id":17756,"word":"强做解人","pinyin":"qiǎng zuò jiě rén","abbr":"qzjr","explanation":"强：勉强；解人：能够理解和通达其中意趣的人。指不明真意而乱发议论的人","example":{"text":"我这是在～罢了"},"similar":["强作解人"],"usage":"作谓语；指不明真意而乱发议论的人","story":["东晋时期，谢安年轻时对战国时期赵国公孙龙著的《白马论》不能理解，就去向金紫光禄大夫阮裕请教。阮裕写了一篇解说《白马论》的文章交给谢安。谢安对他的解说文更加看不明白，又去请教他。阮裕自叹道自己是强做解人"]},{"id":17757,"word":"强兵富国","pinyin":"qiáng bīng fù guó","abbr":"qbfg","explanation":"使兵力强大，国家富足。","source":{"text":"使兵力强大，国家富足。"},"example":{"text":"主上以圣德登大位，臣民之所推戴，列圣之所听闻，公当～，尊主庇民，奈可自卑辱至此，非开所敢闻也。","book":"《宋史·曾开传》"},"similar":["强国富民"],"usage":"作宾语、定语；用于政策等"},{"id":17758,"word":"强兵猛将","pinyin":"qiáng bīng měng jiàng","abbr":"qbmj","explanation":"强兵：强大的军队；猛将：威猛的武将。指军队强大而有战斗力。","source":{"text":"又没强兵猛将，如何收捕得这伙强人？","book":"明·施耐庵《水浒传》第20回"},"example":{"text":"清·李汝珍《镜花缘》第99回：“文芸看看手下虽有～，无奈这阵围在关前，不能攻打城池，徒自发急。”"},"similar":["精兵强将"],"usage":"作宾语、定语；用于书面语"},{"id":17759,"word":"强凫变鹤","pinyin":"qiǎng fú biàn hè","abbr":"qfbh","explanation":"指硬把野鸭变作仙鹤。喻滥竽充数，徒多无益。","source":{"text":"凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"语出《庄子·骈拇》"},"example":{"text":"清·李渔《闲情偶寄·词曲·宾白》：“予所谓多，谓不可删逸之多，非唱沙作米，～之多也。”"},"usage":"作谓语、定语、宾语；用于处事"},{"id":17760,"word":"强加于人","pinyin":"qiáng jiā yú rén","abbr":"qjyr","explanation":"把一个人或一方的意见、看法勉强加诸于别人。","source":{"text":"你就是这么霸道！你所做的一切都是强加于人，而我不吃这一套！","book":"王朔《过把瘾就死》"},"example":{"text":"不论所谈论的是政治、宗教或社会问题，均不应把自己的意见～，硬要别人接受。"},"usage":"作谓语、定语；用于处事"},{"id":17761,"word":"强取豪夺","pinyin":"qiáng qǔ háo duó","abbr":"qqhd","explanation":"凭强力或权势夺取。","example":{"text":"我们不能靠～来取得。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":17762,"word":"强唇劣嘴","pinyin":"qiáng chún liè zuǐ","abbr":"qclz","explanation":"指说话厉害，不肯让人。","source":{"text":"也则为公心直道，从没分毫诈。也不是强唇劣嘴，要做乡村霸。","book":"元·无名氏《盆儿鬼》第四折"},"usage":"作谓语、定语、宾语；用于说话"},{"id":17763,"word":"强嘴拗舌","pinyin":"jiàng zuǐ niù shé","abbr":"jzns","explanation":"说话倔强的样子。","source":{"text":"谢庆元倒了威了，但还是强嘴拗舌：‘我家里的事，要你们管吗？’","book":"周立波《山乡巨变》下十一"}},{"id":17764,"word":"强嘴硬牙","pinyin":"jiàng zuǐ yìng yá","abbr":"jzyy","explanation":"指能说会道。","source":{"text":"花永喜娘们，胆大心尖，强嘴硬牙，老花说不过她，干仗总是吃败仗。","book":"周立波《暴风骤雨》第二部"}},{"id":17765,"word":"强奸民意","pinyin":"qiáng jiān mín yì","abbr":"qjmy","explanation":"反动统治者把自己阴谋做的坏事硬说是人民的意愿。","source":{"text":"后来老袁强奸民意，凡政、绅、军、商各界，无不有请愿书。","book":"蔡东藩《民国通俗演义》第72回"},"example":{"text":"政客一般都会～，造谣惑众。"},"similar":["强人所难"],"opposite":["顺天应人"],"usage":"作谓语、宾语；用于掌权者"},{"id":17766,"word":"强媒硬保","pinyin":"qiǎng méi yìng bǎo","abbr":"qmyb","explanation":"强迫做媒，包办成亲。","example":{"text":"现在社会不能再出现～的行为了。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":17767,"word":"强宗右姓","pinyin":"qiáng zōng yòu xìng","abbr":"qzyx","explanation":"强宗：豪门大族；右姓：世族大姓。指有权势的豪门大族。","source":{"text":"强宗右姓，各拥众保营，莫肯先附。","book":"南朝·宋·范晔《后汉书·郭彶传》"},"usage":"作主语、宾语、定语；用于豪门"},{"id":17768,"word":"强宾不压主","pinyin":"qiáng bīn bù yā zhǔ","abbr":"qbbyz","explanation":"强：强势。指客人应当让主人。","source":{"text":"陈宫曰：‘强宾不压主，请使君勿疑。’","book":"明·罗贯中《三国演义》第十三回"},"example":{"text":"晁盖道：“不可。自古‘～。’晁盖强杀，只是个远来新到的人，安敢便来占上。”","book":"明·施耐庵《水浒全传》第十九回"},"usage":"作宾语、定语；用于主客关系"},{"id":17769,"word":"强将之下无弱兵","pinyin":"qiáng jiàng zhī xià wú ruò bīng","abbr":"qjzxwrb","explanation":"弱：软弱。比喻好的领导能带出好的部属。","source":{"text":"强将之下无弱兵。恁样的姐姐须得恁样的梅香姐，方为厮称。","book":"明·凌濛初《二刻拍案惊奇》第九卷"},"similar":["强将手下无弱兵"],"usage":"作宾语、定语、分句；指名师出高徒"},{"id":17770,"word":"强将手下无弱兵","pinyin":"qiáng jiàng shǒu xià wú ruò bīng","abbr":"qjsxwrb","explanation":"英勇的将领部下没有软弱无能的士兵。比喻好的领导能带出一支好的队伍。","source":{"text":"俗语曰：‘强将手下无弱兵。’真可信。","book":"宋·苏轼《题连公壁》"},"example":{"text":"～”。安水心先生的世兄既有乃翁的那等酒量，岂没有乃翁那等胸襟。 ★清·文康《儿女英雄传》第三十回","book":"真正俗语说的不"},"similar":["名师出高徒"],"opposite":["以其昏昏"],"usage":"作宾语、定语；指名师出高徒"},{"id":17771,"word":"强干弱枝","pinyin":"qiáng gān ruò zhī","abbr":"qgrz","explanation":"加强树干，削弱枝叶。比喻削减地方势力，加强中央权力。","source":{"text":"而汉郡八九十，形错诸侯间，犬牙相临，秉其厄塞地利，强本干弱枝叶之势，尊卑明而万事各得其所矣。","book":"《史记·汉兴以来诸侯王年表序》"},"example":{"text":"幕府惟～之义，且不登叛人之党，帮复援旌擐甲，席卷起征，金鼓响振，布众奔沮。","book":"明·罗贯中《三国演义》第二十四回"},"opposite":["强枝弱干"],"usage":"作定语、宾语；比喻削减地方势力，加强中央"},{"id":17772,"word":"强弓劲弩","pinyin":"qiáng gōng jìn nǔ","abbr":"qgjn","explanation":"强：强劲的，有力的。强有力的弓，坚硬的弩。","source":{"text":"韩地方九百余里，带甲数十万，然天下之强弓劲弩，皆从韩出。","book":"明·冯梦龙《东周列国志》第九十回"},"example":{"text":"前后多是强弓硬弩，兵马如林，都被射转。","book":"清·陈忱《水浒后传》第二十六回"},"similar":["强弓硬弩"],"usage":"作宾语、定语；指装备精良","story":["战国时期，纵横家苏秦到韩国去游说韩王联合六国共同对付秦国。韩王接见了他，他分析了韩国有利的地势，还有强弓劲弩、坚甲利兵，训练有素，十分英勇，如果西面事秦，那就只有让世人耻笑。韩王听后激动地说：“寡人虽死，必不事秦！”"]},{"id":17773,"word":"强弓硬弩","pinyin":"qiáng gōng yìng nǔ","abbr":"qgyn","explanation":"强：强劲的，有力的；弩：古代发箭的机械。强有力的弓，坚硬的弩。形容武器精良。","source":{"text":"天下之强弓劲弩，皆出自韩。","book":"《战国策·韩策一》"},"example":{"text":"前后多是～，兵马如林，都被射转。","book":"清·陈忱《水浒后传》第二十六回"},"similar":["强弓劲弩"],"usage":"作宾语、定语；指装备精良"},{"id":17774,"word":"强弩之末","pinyin":"qiáng nǔ zhī mò","abbr":"qnzm","explanation":"强弩所发的矢，飞行已达末程。比喻强大的力量已经衰弱，起不了什么作用。","source":{"text":"且臣闻之，冲风之衰，不能起毛羽；强弩之末，力不能入鲁缟。","book":"《史记·韩安国列传》：“强弩之极，矢不能穿鲁缟。”《汉书·韩安国传》"},"example":{"text":"至于军阀，那是～了。","book":"欧阳山《三家巷》二四"},"similar":["师老兵疲","罢夫羸老","强弩末矢"],"opposite":["势不可挡","势如破竹"],"usage":"作宾语、定语；指力尽了","story":["汉武帝时期，北方匈奴经常侵扰西汉，大臣王恢认为匈奴人不守信义，只有把他们彻底打垮才能保证边境的安宁。御史大夫韩安国认为汉军已经是长途跋涉，千里远征就像强弩之末不能穿鲁缟一样，汉武帝采纳他的意见同意匈奴的求和"]},{"id":17775,"word":"强弩之极","pinyin":"qiáng nǔ zhī jí","abbr":"qnzj","explanation":"犹强弩之末。比喻强大的力量已经衰弱，起不了什么作用。","source":{"text":"且强弩之极，矢不能穿鲁缟；冲风之末，力不能漂鸿毛。","book":"西汉·司马迁《史记·韩长孺列传》"},"similar":["强弩之末","强弩末矢"],"usage":"作宾语、定语；指力尽了"},{"id":17776,"word":"强弩末矢","pinyin":"qiáng nǔ mò shǐ","abbr":"qnms","explanation":"比喻强大的力量已经衰弱，起不了什么作用。同“强弩之末”。","source":{"text":"又强弩末矢，理无穿于鲁缟；冲风余力，讵能动于鸿毛。","book":"《旧唐书·李密传》"},"similar":["强弩之末","强弩之极"],"usage":"作宾语、定语；指力尽了"},{"id":17777,"word":"强弱异势","pinyin":"qiáng ruò yì shì","abbr":"qrys","explanation":"异势：形势悬殊。比喻双方力量相关极远。","source":{"text":"臣又闻小大异形，强弱异势，险易异备。","book":"《汉书·晁错传》"},"example":{"text":"今日战事，～，愚人犹知必胜，今乃反是，实因机为吴人，北土旧将，不肯服从，所以有此挫失呢。","book":"蔡东藩《两晋演义》第十五回"}},{"id":17778,"word":"强得易贫","pinyin":"qiǎng dé yì pín","abbr":"qdyp","explanation":"指非分之得容易失去。","source":{"text":"结果必然不成东西，徒然使自己后悔，供人家嘲笑，这便是‘强得易贫’了。","book":"叶圣陶《文心》"},"usage":"作宾语、定语；用于劝诫人"},{"id":17779,"word":"强打精神","pinyin":"qiǎng dǎ jīng shén","abbr":"qdjs","explanation":"强：勉强。勉强打起精神。","source":{"text":"六师强打精神，奏其王曰：‘我法之内，灵变卒无尽期。’","book":"《敦煌变文集·降魔变文》"},"example":{"text":"他的神经也已紧张到了一触即溃的边沿，～说：“看不出来。实在不行，等泰必图的兵到了，就硬动手！”","book":"二月河《康熙大帝》四七"}},{"id":17780,"word":"强扭的瓜不甜","pinyin":"qiǎng niǔ de guā bù tián","abbr":"qndgbt","explanation":"比喻强人所难，非两厢情愿而办成的事情不可能美满。","source":{"text":"相思病染，前生欠少，今世加添。无明烈火心头焰，恨蹙眉尖。霹雳性生来好闪，强扭瓜到底难甜。","book":"明·刘效祖《词脔·满庭芳》"},"example":{"text":"王朔《谁比谁傻多少》：“～，我等你想通了——过这村可没这店了。”"},"usage":"作宾语、定语；用于劝诫人"},{"id":17781,"word":"强文假醋","pinyin":"qiǎng wén jiǎ cù","abbr":"qwjc","explanation":"指假斯文。","source":{"text":"有一等寒俭的泛泛之徒，他出来的不诚心，无实行，一个个强文假醋。","book":"元·刘君锡《来生债》第二折"},"usage":"作谓语、定语；用于书面语"},{"id":17782,"word":"强文浉醋","pinyin":"qiǎng wén jiǎ cù","abbr":"qwsc","explanation":"指假斯文。同“强文假醋”。"},{"id":17783,"word":"强本弱支","pinyin":"qiáng běn ruò zhī","abbr":"qbrz","explanation":"比喻削减地方势力，加强中央权力。同“强本弱枝”。","source":{"text":"强本弱支，自古常事。","book":"《新唐书·高季辅传》"},"similar":["强本弱枝"],"usage":"作宾语、定语；用于政策等"},{"id":17784,"word":"强本弱末","pinyin":"qiáng běn ruò mò","abbr":"qbrm","explanation":"犹强干弱枝。比喻削减地方势力，加强中央权力。","source":{"text":"无事，可以备胡；诸侯有变，亦足率以东伐，此强本弱末之术也。","book":"《史记·刘敬叔孙通列传》"},"example":{"text":"这未始非～的法制，还请陛下采纳施行！","book":"蔡东蕃《前汉演义》第三十六回"},"similar":["强本弱枝"],"opposite":["本末倒置"],"usage":"作宾语、定语；用于政策等"},{"id":17785,"word":"强本弱枝","pinyin":"qiáng běn ruò zhī","abbr":"qbrz","explanation":"本：树干；枝：枝叶。加强树干，削弱枝叶。比喻削减地方势力，加强中央权力。","source":{"text":"而汉郡八九十，形错诸侯间，犬牙相临，秉其厄塞地利，强本干弱枝叶之势，尊卑明而万事各得其所矣。","book":"《史记·汉兴以来诸侯王年表序》"},"similar":["强本弱末","强本弱支"],"opposite":["强枝弱本"],"usage":"作宾语、定语；用于政策等"},{"id":17786,"word":"强本节用","pinyin":"qiáng běn jié yòng","abbr":"qbjy","explanation":"本：我国古代以农为本。加强农业生产，节约费用。","source":{"text":"强本而节用，则天不能贫。","book":"《荀子·天论》"},"example":{"text":"墨者俭而难遵，是以其事不可遍循；然其～，不可废也。","book":"《史记·太史公自序》"},"similar":["开源节流"],"usage":"作谓语、定语；指增收节支"},{"id":17787,"word":"强枝弱本","pinyin":"qiáng zhī ruò běn","abbr":"qzrb","explanation":"比喻地方势力强于中央，成尾大不掉之势。","source":{"text":"强枝弱本，千古同患。同姓犹然，况犬羊乎？","book":"明·李贽《史纲评要·唐玄宗》"},"similar":["尾大不掉"],"opposite":["强本弱枝"],"usage":"作宾语、定语；用于局势等"},{"id":17788,"word":"强死强活","pinyin":"qiǎng sǐ qiǎng huó","abbr":"qsqh","explanation":"比喻非常勉强。","source":{"text":"西门庆还把他强死强活拉到李瓶儿房内，下了一盘棋，吃了一回酒。","book":"明·兰陵笑笑生《金瓶梅词话》第38回"},"example":{"text":"却被湘云、香菱、李纨等三四个人，～，灌了一钟才罢。","book":"清·曹雪芹《红楼梦》第63回"},"similar":["强死赖活"],"usage":"作宾语、状语；指非常勉强"},{"id":17789,"word":"强死赖活","pinyin":"qiǎng sǐ lài huó","abbr":"qslh","explanation":"比喻非常勉强。同“强死强活”。","source":{"text":"大国强死赖活地把她拉到地里。","book":"谷峪《三十张工票》"},"similar":["强死强活"],"usage":"作状语；指非常勉强"},{"id":17790,"word":"强毅果敢","pinyin":"qiáng yì guǒ gǎn","abbr":"qygg","explanation":"果敢：有决断，敢作敢为。形容顽强坚毅，敢作敢为。","source":{"text":"强毅果敢则贤。","book":"《国语·晋语九》"}},{"id":17791,"word":"强盗挂念珠","pinyin":"qiáng dào guà niàn zhū","abbr":"qdgnz","explanation":"念珠：信佛的人念佛时用的数珠。形容假装行善。"},{"id":17792,"word":"强直自遂","pinyin":"qiáng zhí zì suí","abbr":"qzzs","explanation":"指刚正而自行其意，不为人所动摇。","source":{"text":"晖好节概，有所拔用，皆厉行之士，表善黜恶，抑强绝邪，岁常丰熟，吏民畏而爱之，为之歌曰：‘强直自遂，南阳朱季，吏畏其威，民怀其惠。’","book":"《东观汉记·朱晖传》"},"example":{"text":"拱以旧学蒙眷注，性～。","book":"《明史·高拱传》"},"usage":"作谓语、定语；用于人的性格"},{"id":17793,"word":"强者反己","pinyin":"qiáng zhě fǎn jǐ","abbr":"qzfj","explanation":"强者：有权势的人；反己：反省自己。指有权有势的人自我反省。","source":{"text":"乡绅此语，足令强者反己，殊为可传。","book":"《雪涛谐史》"},"usage":"作宾语、定语；指自我反省","story":["黄郡一位孝廉买老百姓的田地时先买旁边的痩薄土地，留下中间的肥田，为的是想便宜得到，当田被人买走时，他却告到官府。在公堂上忍无可忍的农民满口唾沫吐到他的脸上，其他孝廉群起攻之，一乡绅说“孝廉面是面，百姓口是口”，让强者反省自己"]},{"id":17794,"word":"强而后可","pinyin":"qiǎng ér hòu kě","abbr":"qehk","explanation":"强：硬要，迫使。经强求后才答应。","source":{"text":"良曰：‘请复之。’强而后可，一朝而获十禽。","book":"《孟子·滕文公下》"},"example":{"text":"一人初不即抬，及～，先以眼光一瞬，似于看人，而实非看人。","book":"清·李渔《闲情偶寄·态度》"},"usage":"作谓语、定语；用于处事"},{"id":17795,"word":"强而示弱","pinyin":"qiáng ér shì ruò","abbr":"qesr","explanation":"示：示形，伪装。比喻力量强大，却故意装作力量很小，造成对方的错觉，给予意外的打击。","source":{"text":"凡与敌占，我众强，可伪示怯弱，以诱之来与我战；吾以锐卒击之，其军必败。","book":"明·刘伯温《百战奇略·强战》"}},{"id":17796,"word":"强聒不舍","pinyin":"qiǎng guō bù shě","abbr":"qgbs","explanation":"聒：声音吵闹；舍：舍弃。形容别人不愿意听，还絮絮叨叨说个不停。","source":{"text":"以此周行天下，上说下教，虽天下不取，强聒而不舍者也。","book":"《庄子·天下》"},"example":{"text":"“～”虽然是勇壮的行为，但我所奉行的，却是“不可与言而与之言，失言”这一句古老话。","book":"鲁迅《二心集·关于翻译的通信》"},"usage":"作谓语；指絮絮叨叨说个不停"},{"id":17797,"word":"强自取折","pinyin":"qiáng zì qǔ shé","abbr":"qzqs","explanation":"指物性过硬则反易折断。同“强自取柱”。","source":{"text":"强自取折，柔自取束。","book":"《大戴礼记·劝学》"},"similar":["强自取柱"],"usage":"作宾语、定语；用于劝诫人"},{"id":17798,"word":"强自取柱","pinyin":"qiáng zì qǔ zhù","abbr":"qzqz","explanation":"指物性过硬则反易折断。","source":{"text":"强自取柱，柔自取束。","book":"战国·赵·荀况《荀子·劝学》"},"similar":["强自取折"],"usage":"作宾语、定语；用于劝诫人"},{"id":17799,"word":"强记博闻","pinyin":"qiáng jì bó wén","abbr":"qjbw","explanation":"指记忆力强，见闻广博。","source":{"text":"英姿达识，事洞照于几先；强记博闻，言必稽于古训。","book":"宋·陆游《贺皇太子受册笺》"},"similar":["博闻强记","洽闻强记"],"usage":"作谓语、定语；用于称颂人"},{"id":17800,"word":"强识博闻","pinyin":"qiǎng shí bó wén","abbr":"qsbw","explanation":"指记忆力强，见闻广博。同“强记博闻”。","source":{"text":"博闻强志，明于治乱，娴于辞令。","book":"《荀子·解蔽》：“博闻强志，不合王制，君子贱之。”《礼记·曲礼上》：“博闻强识而让，敦善行而不怠，谓之君子。”《史记·屈原贾生列传》"},"example":{"text":"粲～，故太祖游观出入，多得骖乘，至其见敬不及洽、袭。","book":"《三国志·魏志·杜袭传》"},"similar":["强记博闻","博闻强记"],"usage":"作谓语、定语；用于称颂人"},{"id":17801,"word":"强词夺正","pinyin":"qiǎng cí duó zhèng","abbr":"qcdz","explanation":"指无理强辩，明明没理硬说有理。同“强词夺理”。","source":{"text":"但酒醒，硬打挣，强词夺正，则除是醉时节酒淘真性。","book":"元·关汉卿《金线池》第三折"},"similar":["强词夺理"],"usage":"作谓语、定语、状语；指无理强辩"},{"id":17802,"word":"强词夺理","pinyin":"qiǎng cí duó lǐ","abbr":"qcdl","explanation":"强词：强辩；夺：争。指无理强辩，明明没理硬说有理。","source":{"text":"座上一人忽日：‘孔明所言，皆强词夺理，均非正论，不必再言。","book":"明·罗贯中《三国演义》第四十三回"},"example":{"text":"他的话简直就是～，你不要信他。"},"similar":["满嘴胡缠","蛮不讲理","蛮横无理"],"opposite":["理直气壮","不言而喻"],"usage":"作谓语、定语、状语；指无理强辩","story":["战国时期，宋国大夫高阳应最喜欢强辩，而且强词夺理一定要赢。一次高阳应要盖一幢房子，有经验的木匠见湿木料去做梁柱，用不了多久就会造成房屋倒塌。高阳应则强行说湿木盖房有好处，就安排人盖，结果一年后该房屋就倒塌了"]},{"id":17803,"word":"强颜为笑","pinyin":"qiǎng yán wéi xiào","abbr":"qywx","explanation":"心里不畅快，但脸上勉强装出喜笑的样子。","source":{"text":"‘汝狡兔三窟，何归为？’柴俯不对。女肘之，柴始强颜为笑。","book":"清·蒲松龄《聊斋志异·邵女》"},"example":{"text":"面对此事，我只好～了。"},"similar":["强为欢笑"],"usage":"作谓语、定语；指勉强装出欢笑的样子"},{"id":17804,"word":"强颜欢笑","pinyin":"qiǎng yán huān xiào","abbr":"qyhx","explanation":"心里不畅快，但脸上勉强装出喜笑的样子。","source":{"text":"‘汝狡兔三窟，何归为？’柴俯不对。女肘之，柴始强颜为笑。","book":"清·蒲松龄《聊斋志异·邵女》"},"example":{"text":"难道我竟能随着大家，吃林师弟的饭，使林师弟的钱？再～，恭贺他和小师妹举案齐眉，白头偕老。","book":"金庸《笑傲江湖》第十三回"},"similar":["强颜为笑"],"usage":"作谓语、宾语、状语；用于处事"},{"id":17805,"word":"强食弱肉","pinyin":"qiáng shí ruò ròu","abbr":"qsrr","explanation":"比喻弱者被强者欺凌吞并。同“弱肉强食”。","source":{"text":"元失其鹿，天下共逐，扰扰纷纷，强食弱肉。","book":"明·刘基《瑞麦颂》"},"example":{"text":"为被征服者，亦熟听～之不平公例。","book":"李石曾《无政府说》"},"similar":["弱肉强食"],"opposite":["和平共处"],"usage":"作谓语、宾语、定语；指自然竞争"},{"id":17806,"word":"强食自爱","pinyin":"qiǎng shí zì ài","abbr":"qsza","explanation":"劝慰人的话。指努力加餐，保重身体。","source":{"text":"专精神，近医药，强食自爱。","book":"东汉·班固《汉书·匡衡传》"},"example":{"text":"明公～，应之于后，以遂初心，则海内幸甚！","book":"宋·朱熹《与龚参政书》"},"usage":"作谓语、定语；用于劝慰人"},{"id":17807,"word":"强食靡角","pinyin":"qiǎng shí mí jiǎo","abbr":"qsmj","explanation":"指饱食而角力求胜。","source":{"text":"《列子·说符》：“强食靡角，胜者为制，是禽兽也。”殷敬顺释文：“《韩诗外传》云：‘靡，共也。’《吕氏春秋》云：‘角，试力也。’此言人重利而轻道，唯食而已，亦犹禽兽饱食而相共角力以求胜也。”一说，靡读为摩，谓以角相摩。见俞樾《诸子平"},"usage":"作谓语、定语；用于书面语"},{"id":17808,"word":"强龙不压地头蛇","pinyin":"qiáng lóng bù yā dì tóu shé","abbr":"qlbydts","explanation":"比喻实力强大者也难对付当地的势力。","source":{"text":"你也忒自重了，更不让我远乡之僧--也罢，这正是'强龙不压地头蛇'。","book":"明·吴承恩《西游记》第45回"},"example":{"text":"有什么话说呢？这就叫～！","book":"姚雪垠《李自成》第一卷第24章"},"similar":["恶龙不斗地头蛇"],"opposite":["针锋相对"],"usage":"作宾语、定语；用于口语","story":["唐僧师徒四人西行取经到车迟国，在倒换关文时与假国师虎力大仙发生了冲突，门外百姓要求国师求雨。孙悟空与他打赌求雨，虎力大仙当仁不让，孙悟空见强龙不压地头蛇就让他先求雨，自己暗中买通众神，让虎力大仙一败涂地"]},{"id":17809,"word":"归之如市","pinyin":"guī zhī rú shì","abbr":"gzrs","explanation":"归附的人很多，像闹市一样。形容人心所向。","source":{"text":"从之者如归市。","book":"《孟子·梁惠王下》"},"example":{"text":"由是士无贤愚，～。","book":"明·冯梦龙《东周列国志》第九十四回"},"usage":"作谓语、定语；用于书面语"},{"id":17810,"word":"归之若水","pinyin":"guī zhī ruò shuǐ","abbr":"gzrs","explanation":"归附好似流水之汇流大海。比喻人心所向。","source":{"text":"德行教训，加于诸侯；慈爱利泽，加于百姓。故海内归之若流水。","book":"《晏子春秋·内篇问上》"},"usage":"作谓语、定语；用于书面语"},{"id":17811,"word":"归之若流","pinyin":"guī zhī ruò liú","abbr":"gzrl","explanation":"归附好似流水之汇流大海。比喻人心所向。","source":{"text":"德行教训，加于诸侯；慈爱利泽，加于百姓。故海内归之若流水。","book":"《晏子春秋·内篇问上》"}},{"id":17812,"word":"归了包堆","pinyin":"guī le bāo duī","abbr":"glbd","explanation":"所有的都包括在内，总共。","source":{"text":"归了包堆今天你这一趟你一共要多少钱？","book":"老舍《四世同堂》"}},{"id":17813,"word":"归全反真","pinyin":"guī quán fǎn zhēn","abbr":"gqfz","explanation":"回归到完善的、原本的境界。","source":{"text":"无室家累，无子孙忧，屈伸宠辱，委顺而已，未尝一日戚戚其心颜，以至于归全反真，故予所谓达人之徒欤？信矣！","book":"唐·白居易《故侥州刺史吴府君神道碑铭序》"},"usage":"作宾语、定语；指回归到完善的本原的境界"},{"id":17814,"word":"归全返真","pinyin":"guī quán fǎn zhēn","abbr":"gqfz","explanation":"回复到完满的本原的境界。","source":{"text":"无子孙忧，屈伸宠辱，委顺而已，未尝一日戚戚其心颜，以至于归全返真，故予所谓达人之徒欤？","book":"唐·白居易《故饶州刺史吴府君神道碑铭序》"},"usage":"作谓语、宾语；用于书面语"},{"id":17815,"word":"归十归一","pinyin":"guī shí guī yī","abbr":"gsgy","explanation":"指有条有理。","source":{"text":"你看他，又背红缨枪又拿手榴弹，收拾得归十归一，真像个久经锻炼的红军战士了。","book":"白诚仁、何纪光《小红军》"},"usage":"作定语、状语；用于口语"},{"id":17816,"word":"归华别业","pinyin":"guī huá bié yè","abbr":"ghby","explanation":"华：花。花已落下，叶已离枝。形容秋风过后，花木凋零。","source":{"text":"归华先委露，别叶早辞风。","book":"南朝·宋·鲍照《玩月城西门廨中》"}},{"id":17817,"word":"归去来兮","pinyin":"guī qù lái xī","abbr":"gqlx","explanation":"归：返回。回去吧。指归隐乡里。","source":{"text":"归去来兮！田园将芜，胡不归？","book":"晋·陶渊明《归去来辞》"},"example":{"text":"自不合刚下山来惹是非，不如～。","book":"元·马致远《陈抟高卧》第三折"},"similar":["归心似箭","告老还乡"],"opposite":["浪迹天涯","四海为家"],"usage":"作宾语、定语、分句；指回去"},{"id":17818,"word":"归奇顾怪","pinyin":"guī qí gù guài","abbr":"gqgg","explanation":"归：清代归庄；顾：清代顾炎武。归庄奇特，顾炎武怪异。","source":{"text":"读书一目十行，性耿介，绝不与人交，独与晨庄归庄善，同游复社，相传有归奇顾怪之目。","book":"清·江藩《汉学师承记·顾炎武》"},"example":{"text":"国初，昆山归处士庄与亭林齐名，时有～之目。","book":"清·陈康奇《郎潜纪闻》卷八"},"usage":"作宾语、定语；用于书面语"},{"id":17819,"word":"归师勿掩，穷寇勿追","pinyin":"guī shī wù yǎn，qóng kòu wù zhuī","abbr":"gswyqkwz","explanation":"掩：乘人不备进行袭击。不能袭击撤退的军队，也不能追杀走投无路的敌人。指特定情况下要防止敌人拼死反击，以免不测的牺牲。","source":{"text":"归师勿遏，师必阙，穷寇勿追。","book":"《孙子·军事》"},"example":{"text":"～，汝可从小路抄箕谷退兵。吾自引兵当斜谷之兵。","book":"明·罗贯中《三国演义》第九十五回"},"similar":["归师勿掩，穷寇莫追"],"usage":"作宾语、定语、分句；用于战争等"},{"id":17820,"word":"归师勿掩，穷寇莫追","pinyin":"guī shī wù yǎn，qóng kòu mò zhuī","abbr":"gswyqkmz","explanation":"归师：撤退的军队；掩：乘人不备进行袭击；穷寇：走投无路的敌人。不能袭击撤退的军队，也不能追杀走投无路的敌人。","source":{"text":"‘归师勿掩，穷寇莫追。’汝可从小路抄箕谷退兵。吾自引兵当斜谷之兵。","book":"清·罗贯中《三国演义》第95回"},"similar":["归师勿掩，穷寇勿追"],"usage":"作宾语、定语、分句；用于战争等"},{"id":17821,"word":"归心似箭","pinyin":"guī xīn sì jiàn","abbr":"gxsj","explanation":"想回家的心情象射出的箭一样快。形容回家心切。","source":{"text":"承长兄厚爱，本当领教，只奈归心似箭，今日立刻就要行了。","book":"明·名教中人《好俅传》第十二回"},"example":{"text":"不多时，穿过松林，渡过小溪，过了水月村，越过镜花岭，真是～。","book":"清·李汝珍《镜花缘》第二十一回"},"similar":["归去来兮","归心如箭"],"opposite":["浪迹天涯"],"usage":"作谓语、宾语、定语；形容回家心切"},{"id":17822,"word":"归心如箭","pinyin":"guī xīn rú jiàn","abbr":"gxrj","explanation":"想回家的心情象射出的箭一样快。形容回家心切。","source":{"text":"承长兄厚爱，本当领教，只奈归心似箭，今日立刻就要行了。","book":"明·名教中人《好俅传》第十二回"},"example":{"text":"卢师越离家已久，～，恐怕淹留，连忙催促安道全作别。","book":"清·陈忱《水浒后传》第十三回"},"similar":["归去来兮","归心似箭"],"opposite":["浪迹天涯"],"usage":"作谓语、定语；形容回家心切"},{"id":17823,"word":"归心如飞","pinyin":"guī xīn rú fēi","abbr":"gxrf","explanation":"归心：回家的念头。想回家的心情像射出的箭一样飞快。形容回家心情十分急切。","source":{"text":"兼又新得罪于人，意况不佳，虽欲陪款语而归心如飞，破雨东渡，但剧怅仰。","book":"宋·陈亮《复陆伯寿书》"},"similar":["归心如箭","归心似箭"],"usage":"作谓语、定语；形容回家心切"},{"id":17824,"word":"归忌往亡","pinyin":"guī jì wǎng wáng","abbr":"gjww","explanation":"归：回；忌：忌讳；往亡：旧黄历上不吉利的日子。旧时指不宜回家的忌日。","source":{"text":"归：回；忌：忌讳；往亡：旧黄历上不吉利的日子。旧时指不宜回家的忌日。"},"example":{"text":"《后汉书·郭躬传》附陈伯敬：“桓帝时，汝南有陈伯敬者，行必规步，坐必端膝，呵叱狗马，终不言死，目有所见，不食其肉，行路闻凶，便解驾留止，还触归忌，则寄宿乡亭。”"}},{"id":17825,"word":"归根到底","pinyin":"guī gēn dào dǐ","abbr":"ggdd","explanation":"归结到根本上。","source":{"text":"归根结柢，把一场着水人命一盘摙归去，还亏有钱使得鬼推磨。","book":"清·张南庄《何典》第二回"},"example":{"text":"但是～它是细致的工作，精雕细刻的工作，很深入的工作，结果得益处大，兵就不跑。","book":"邓小平《提倡深入细致的工作》"},"similar":["归根结底"],"usage":"作状语、分句；指归结到根本上"},{"id":17826,"word":"归根究柢","pinyin":"guī gēn jiū dǐ","abbr":"ggjd","explanation":"追究底细。","source":{"text":"归根究柢，害你哥哥的人，就是张大户。","book":"欧阳予倩《潘金莲》第五幕"},"similar":["归根结柢","归根结底","归根结蒂"],"usage":"作状语、分句；指归结到根本上"},{"id":17827,"word":"归根结底","pinyin":"guī gēn jié dǐ","abbr":"ggjd","explanation":"归结到根本上。同“归根结蒂”。","source":{"text":"如今是人力世界，归根结底，还是靠做。","book":"周立波《山乡巨变》"},"example":{"text":"～，还是体制上出了问题。"},"similar":["归根结柢","归根结蒂","归根究柢"],"usage":"作状语、分句；指归结到根本上"},{"id":17828,"word":"归根结柢","pinyin":"guī gēn jié dǐ","abbr":"ggjd","explanation":"归结到根本上。同“归根结蒂”。","source":{"text":"归根结柢，把一场着水人命一盘摙归去，还亏有钱使得鬼推磨。","book":"清·张南庄《何典》第二回"},"example":{"text":"～，谁能不为着自己呢？","book":"洪深《五奎桥》第一幕"},"similar":["归根结底","归根究柢","归根结蒂"],"usage":"作状语、分句；指归结到根本上"},{"id":17829,"word":"归根结蒂","pinyin":"guī gēn jié dì","abbr":"ggjd","explanation":"归结到根本上。","source":{"text":"天才们无论怎样说大话，归根结蒂，还是不能凭空创造。","book":"鲁迅《且介亭杂文二集·叶紫作〈丰收〉序》"},"example":{"text":"～，俄国的力量是在工农兵苏维埃这方面。","book":"毛泽东《和美国记者安娜·路易斯·斯特朗的谈话》"},"similar":["究本究源","归根到底"],"usage":"作状语、分句；指归结到根本上"},{"id":17830,"word":"归正反本","pinyin":"guī zhèng fǎn běn","abbr":"gzfb","explanation":"指返归于根本之源。","source":{"text":"海内怨愤，归正反本，暨于氐、羌率服，獯鬻慕义。","book":"《三国志·蜀志·马超传》"},"example":{"text":"上书劝寿～，释帝称王。","book":"晋·常璩《华阳国志·李特雄寿势志》"},"similar":["归正返本"],"usage":"作谓语、宾语；用于书面语"},{"id":17831,"word":"归正守丘","pinyin":"guī zhèng shǒu qiū","abbr":"gzsq","explanation":"传说狐狸将死时，头必朝向出生的山丘。比喻不忘本。也比喻暮年思念故乡。","source":{"text":"狐死正丘首，仁也。","book":"《礼记·檀弓上》"}},{"id":17832,"word":"归正返本","pinyin":"guī zhèng fǎn běn","abbr":"gzfb","explanation":"归：回返。返归于根本之源。","source":{"text":"上书劝寿归正返本，释帝称王。","book":"晋·常璩《华阳国志·李特雄寿势志》"},"similar":["归正反本"],"usage":"作谓语、宾语；用于书面语"},{"id":17833,"word":"归正邱首","pinyin":"guī zhèng qiū shǒu","abbr":"gzqs","explanation":"指死后归葬于故乡。同“归正首丘”。","source":{"text":"吾出千成死至此，吾意能归正邱首，岂知死于道路。","book":"明·宋濂《故检校孔君权厝志》"},"similar":["归正首丘","归正首邱"],"usage":"作谓语、定语；指死后归葬于故乡"},{"id":17834,"word":"归正首丘","pinyin":"guī zhèng shǒu qiū","abbr":"gzsq","explanation":"首：向；丘：土丘。传说狐狸即将死在外边，也要把头朝向所住洞穴的方向。指死后归葬于故乡。","source":{"text":"礼，不忘其本。古之有言曰：狐死正丘首，仁也。","book":"西汉·戴圣《礼记·檀弓上》"},"example":{"text":"从此故乡日离日远，我们几个人，看这光景，不知还有～的日子么？","book":"《苦社会》第25回"},"similar":["归正邱首"],"usage":"作谓语、定语；指死后归葬于故乡"},{"id":17835,"word":"归正首邱","pinyin":"guī zhèng shǒu qiū","abbr":"gzsq","explanation":"指死后归葬于故乡。同“归正首丘”。","source":{"text":"我昨天说叫他回去调理的话，就是叫他早点归正首邱了。","book":"《二十年目睹之怪现象状》第八五回"},"similar":["归正首丘","归正邱首"],"usage":"作谓语、定语；指死后归葬于故乡"},{"id":17836,"word":"归真反朴","pinyin":"guī zhēn fǎn pǔ","abbr":"gzfp","explanation":"比喻回复原来的自然状态。同“归真反璞”。","source":{"text":"他（鲁迅）赞成语言的欧化而反对刘半农先生‘归真反朴’的主张。","book":"朱自清《鲁迅先生的中国语文观》"},"similar":["归真返璞"],"usage":"作谓语、宾语；用于人或事物等"},{"id":17837,"word":"归真反璞","pinyin":"guī zhēn fǎn pú","abbr":"gzfp","explanation":"归：返回；真：天然，自然；璞：蕴藏有玉的石头，也指未雕琢的玉。去掉外饰，还其本质。比喻回复原来的自然状态。","source":{"text":"归真反璞，则终身不辱。","book":"《战国策·齐策四》"},"example":{"text":"“～”是要回到现在的口语，还有语录派，更主张回到中古的的口语。","book":"朱自清《鲁迅先生的中国语文观》"},"similar":["返朴归真","归真反朴"],"usage":"作谓语；指去掉外饰，还其本质"},{"id":17838,"word":"归真返璞","pinyin":"guī zhēn fǎn pǔ","abbr":"gzfp","explanation":"真：本真；璞：未加工的玉。指去掉外饰，恢复其自然原始的面貌。","source":{"text":"归真返璞，则终身不辱也。","book":"西汉·刘向《战国策·齐策》"},"similar":["归真反朴","返璞归真"],"usage":"作谓语、宾语；用于人或事物等"},{"id":17839,"word":"归老林下","pinyin":"guī lǎo lín xià","abbr":"gllx","explanation":"林下：指隐居之地。回到林间幽境安度晚年。","source":{"text":"赵雄因见满朝之人都生忌妒，遂上表辞朝而回，归老林泉。","book":"明·周楫《西湖二集·愚郡守玉殿生春》"},"example":{"text":"大业已～，意侄已死，忽携佳孙美妇归，喜如获宝。","book":"清·蒲松龄《聊斋志异·翩翩》"},"similar":["归老林泉","归老田间"],"usage":"作谓语、宾语；指退休"},{"id":17840,"word":"归老林泉","pinyin":"guī lǎo lín quán","abbr":"gllq","explanation":"林泉：山林泉水之境，指隐居之地。回到林间幽境安度晚年。","source":{"text":"赵雄因见满朝之人都生忌妒，遂上表辞朝而回，归老林泉。","book":"明·周楫《西湖二集·愚郡守玉殿生春》"},"similar":["归老林下","归老田间"],"usage":"作谓语、宾语；指退休"},{"id":17841,"word":"归老田间","pinyin":"guī lǎo tián jiān","abbr":"gltj","explanation":"指回到幽雅处所，度过晚年。","source":{"text":"我明日即行辞职，还是归老田间罢。","book":"蔡东藩《民国通俗演义》第11回"},"similar":["归老林下","归老林泉"],"usage":"作谓语、宾语；指退休"},{"id":17842,"word":"归老菟裘","pinyin":"guī lǎo tú qiú","abbr":"gltq","explanation":"菟裘：古邑名。本指鲁隐公想归老于菟裘。后用以指归隐。","source":{"text":"为其少故也，吾将授之矣。使营菟裘，吾将老焉。","book":"《左传·隐公十一年》"},"example":{"text":"望吾王仁愍，太傅哀怜，与一小镇，休兵养疾，一二年间即～，幸也。","book":"《旧五代史·梁书·李罕之传》"},"usage":"作谓语、宾语；指退隐"},{"id":17843,"word":"归遗细君","pinyin":"guī yí xì jūn","abbr":"gyxj","explanation":"归：回家；遗：给予；细君：妻子。指夫妻情深。","source":{"text":"归遗细君，又何仁也。","book":"东汉·班固《汉书·东方朔传》"},"usage":"作谓语、定语；指丈夫爱妻子","story":["西汉时期，汉武帝杀了几头牲口准备分给群臣吃，东方朔亲自拔剑劈了一大块回家。汉武帝不悦，问东方朔为什么不等一会儿。东方朔回答说：“是您说分给群臣吃的，我自己割显示壮士本事，把肉拿回家去留给妻子吃表示我的爱情。”"]},{"id":17844,"word":"归邪转曜","pinyin":"guī xié zhuǎn yào","abbr":"gxzy","explanation":"曜：光明。改除邪恶，归依正道。","source":{"text":"周虽不纲，孔实嗣圣，《诗》、《书》、载删，《礼》、《乐》大定，片恶劝善，归邪反正。","book":"唐·韦表微《麟台碑铭》"},"example":{"text":"～，不烦一矢之加；飞盅全收，已倍万箱之贮。","book":"清·林则徐《祭海神文》"},"similar":["归邪返正"],"usage":"作谓语、宾语；用于书面语"},{"id":17845,"word":"归邪返正","pinyin":"guī xié fǎn zhèng","abbr":"gxfz","explanation":"返：回归。指改正错误，返回正确道路。","source":{"text":"周虽不纲，孔实嗣圣，《诗》《书》载删，《礼》《乐》大定，惩恶劝善，归邪返正。","book":"唐·韦表微《麟台碑铭》"},"similar":["归邪转曜"],"usage":"作谓语、宾语；用于书面语"},{"id":17846,"word":"归马放牛","pinyin":"guī mǎ fàng niú","abbr":"gmfn","explanation":"把作战用的牛马牧放。比喻战争结束，不再用兵。","source":{"text":"乃偃武修文，归马于华山之阳，放牛于桃林之野，示天下弗服。","book":"《尚书·武成》"},"example":{"text":"那些王侯将相何尝得一日的安闲？好容易海晏河清，～。","book":"清·文康《儿女英雄传》第二十一回"},"similar":["放牛归马","散马休牛"],"usage":"作谓语、定语、宾语；用于战后","story":["商朝末年，商纣王荒淫无度，百姓怨声载道。周武王率领大军把商都包围起来，商纣王登上鹿台放火自杀。周武王建立周朝，定都镐京，让士兵回家从事农业生产，把征用的牛马全部退还，让全国老百姓过上安居乐业的日子"]},{"id":17847,"word":"当一天和尚撞一天钟","pinyin":"dāng yī tiān hé shàng zhuàng yī tiān zhōng","abbr":"dythszytz","explanation":"比喻做事情敷衍消极，混一天算一天，没有积极主动的精神。","source":{"text":"所以就有点自暴自弃，破罐破摔，得过且过，当一天和尚撞一天钟既辜负了人民又放荡了自己……","book":"王朔《你不是一个俗人》"},"example":{"text":"她～，得过且过。"},"similar":["做一天和尚撞一天钟"],"usage":"作谓语、宾语、定语；指人得过且过"},{"id":17848,"word":"当世儒宗","pinyin":"dāng shì rú zōng","abbr":"dsrz","explanation":"儒：儒学；宗：为众人所师法的人物，即大师。指当世的儒学大师。","source":{"text":"朝廷嘉其能，令教育生徒，号为当世儒宗。","book":"《晋书·贺循传》"}},{"id":17849,"word":"当世取舍","pinyin":"dāng shì qǔ shě","abbr":"dsqs","explanation":"指进取与退舍能符合时代潮流，能随顺世俗。","source":{"text":"安国为人多大略，知足以当世取舍，而出于忠厚。","book":"《汉书·窦田灌韩传》"}},{"id":17850,"word":"当世得失","pinyin":"dāng shì dé shī","abbr":"dsds","explanation":"得失：指政治上的得志与失意。现世人们得意与挫败的不同境遇。","source":{"text":"居今之世，志古之道，所以自镜也，未必尽同。帝王者，各殊礼而异务，要以成功为统纪，它可绲乎？观其所以得尊宠及所以废辱，亦当世得失之林也，何必旧闻。","book":"《史记·高祖功臣年表》"}},{"id":17851,"word":"当世才具","pinyin":"dāng shì cái jù","abbr":"dscj","explanation":"当世：当代，现世；才：才华。当代具有才华的人。","source":{"text":"崔季书长于尺牍，有当世才具。","book":"宋·叶廷珪《海录碎事·人事·才能》"}},{"id":17852,"word":"当世才度","pinyin":"dāng shì cái dù","abbr":"dscd","explanation":"当世：当代，现世；才：才华；度：气度。当代具有才华气度的人。","source":{"text":"肇有当世才度，为散骑常侍，屯骑校尉。","book":"《三国志·魏志·曹肇传》"},"usage":"作主语、宾语、定语；用于人"},{"id":17853,"word":"当世无双","pinyin":"dāng shì wú shuāng","abbr":"dsws","explanation":"当代独一无二，首屈一指。","source":{"text":"东方朔自称辨略，消坚释石，当世无双。","book":"汉·桓宽《盐铁论·褒贤》"},"example":{"text":"陈康肃公尧咨善射，～，公亦以此自矜。","book":"宋·欧阳修《卖油翁》"},"similar":["举世无双","独一无二"],"opposite":["无独有偶"],"usage":"作谓语、定语、状语；指当代独一无二"},{"id":17854,"word":"当为秋霜，无为槛羊","pinyin":"dāng wéi qiū shuāng，wú wéi jiàn yáng","abbr":"dwqswwky","explanation":"槛：关家畜的栅栏。指应当成为秋霜而不是栅栏中的羔羊。比喻做事要有自己的主见，不能受制于人，任人摆布。","source":{"text":"荆书与东海王疆曰：‘当为秋霜，无为槛羊。’","book":"南朝·宋·范晔《后汉书·广陵思王荆传》"},"usage":"作宾语、定语；用于处事"},{"id":17855,"word":"当之无愧","pinyin":"dāng zhī wú kuì","abbr":"dzwk","explanation":"无愧：毫无愧色。当得起某种称号或荣誉，无须感到惭愧。","source":{"text":"夫人有厚己而自如者，恃其中有所以当之而不愧也。","book":"宋·欧阳修《回丁判官书》"},"example":{"text":"尊翁一生，清慎勤三字，可～。","book":"高阳《清宫外史》上册"},"similar":["名副其实","名不虚传","受之无愧"],"opposite":["名不副实","虚有其表","当之有愧"],"usage":"作谓语、定语；指当得起某种称号"},{"id":17856,"word":"当之有愧","pinyin":"dāng zhī yǒu kuì","abbr":"dzyk","explanation":"当：承受；愧：惭愧。承受某种荣誉或称号与事实不相符，感到惭愧。常作自谦之词。","example":{"text":"我只为大家做了一点儿好事，却得到同志们的高度赞扬，我真是当之有愧呀！"},"similar":["愧不敢当"],"opposite":["理所应当","当之无愧"],"usage":"作谓语、定语；指不能胜任"},{"id":17857,"word":"当仁不让","pinyin":"dāng rén bù ràng","abbr":"drbr","explanation":"原指以仁为任，无所谦让。后指遇到应该做的事就积极主动去做，不推让。","source":{"text":"原指以仁为任，无所谦让。后指遇到应该做的事就积极主动去做，不推让。"},"example":{"text":"人家骂小弟鱼肉乡愚，这句话仔细想来，在小弟却是～。","book":"清·李宝嘉《官场现形记》第十七回"},"similar":["义不容辞","理所当然"],"opposite":["推三阻四","临阵脱逃"],"usage":"作谓语、状语、定语；指该做就做","story":["春秋时期，孔子主张施行仁政，为人要有仁义，孔子回答学生子张说做到恭、宽、信、敏、惠等五点就做到了仁。没有放肆的心叫恭，心地不狭窄叫宽，没有欺诈的心叫信，没有怠惰之心叫敏，没有苛刻之心叫惠。为人应该当仁不让"]},{"id":17858,"word":"当今之务","pinyin":"dāng jīn zhī wù","abbr":"djzw","explanation":"当前最紧急的任务。","source":{"text":"当今之务，宜君臣上下，并且筹策，计较府库，量入为出。","book":"《三国志·魏志·卫凯传》"},"example":{"text":"～，宜早正东储，立师傅以保护，立官司以防卫，以系苍生之心。","book":"《魏书·阳尼传附阳固》"},"similar":["当务之急"],"usage":"作主语、宾语；用于判断语句中"},{"id":17859,"word":"当今无辈","pinyin":"dāng jīn wú bèi","abbr":"djwb","explanation":"目前没人能比得上。辈，比。","source":{"text":"［孙权］问公卿曰：‘温当今与谁为比？’大农刘基曰：‘可与全琮为辈。’太常顾雍曰：‘基未详其为人也。温当今无辈。’","book":"《三国志·吴志·张温传》"},"usage":"作谓语、定语；用于称赞别人"},{"id":17860,"word":"当刑而王","pinyin":"dāng xíng ér wáng","abbr":"dxew","explanation":"谓先经受磨难而后飞腾黄达。","source":{"text":"少时客相之，当刑而王。及壮，坐法黥，布欣然笑曰：‘人相我当刑而王，几是乎？’","book":"《汉书·黥布传》"},"example":{"text":"我爹爹是个大儒，指望立身行道；今遭此患难，那有出头之日。这时节难道是～？","book":"明·沈鲸《双珠记·僧榻传音》"},"usage":"作谓语、定语；用于人处世"},{"id":17861,"word":"当前决意","pinyin":"dāng qián jué yì","abbr":"dqjy","explanation":"当前：目前，眼前。现在所决定的事情。","source":{"text":"当前决意一呼再喏者，人隶也。","book":"汉·韩婴《韩诗外传》卷五"}},{"id":17862,"word":"当务之急","pinyin":"dāng wù zhī jí","abbr":"dwzj","explanation":"当务：指应当办理的事。当前任务中最急切要办的事。","source":{"text":"知者无不知也，当务之为急；仁者无不爱也，急亲贤之为务。","book":"《孟子·尽心上》"},"example":{"text":"今学者～，曰中国古今史，曰泰东西古近史。","book":"清·沈惟贤《万国演义序》"},"similar":["燃眉之急","迫在眉睫","事不宜迟"],"opposite":["一拖再拖","遥遥无期"],"usage":"作主语、宾语；用于判断语句中","story":["战国时期，孟子的弟子问他现在要办的事情很多该如何处理，孟子说应该知道要做的事情中哪些是最急需办的就先办，不能面面俱到。如果父母死子女在服丧期间吃饭狼吞虎咽，喝汤时响声很大，这就是舍本逐末，不知自己当前该干什么"]},{"id":17863,"word":"当务始终","pinyin":"dāng wù shǐ zhōng","abbr":"dwsz","explanation":"应当力求有始有终。"},{"id":17864,"word":"当场出丑","pinyin":"dāng chǎng chū chǒu","abbr":"dccc","explanation":"在大庭广众露出丑相，丢脸。","source":{"text":"自古道宁分数斗，莫增一口。你今休怪，当场出丑。","book":"明·徐霖《绣襦记·教唱莲花》"},"example":{"text":"真是不怕～，好笑极了。","book":"《两地书·许广平》"},"similar":["当场出彩","当场献丑"],"usage":"作谓语、宾语；指丢脸"},{"id":17865,"word":"当场出彩","pinyin":"dāng chǎng chū cǎi","abbr":"dccc","explanation":"旧戏表演杀伤时，用红色水涂沫，装做流血的样子，叫做出彩。比喻当着众人的面败露秘密或显出丑态。","source":{"text":"吾夫妇目下当受此杖，不如私下请牌头来，完了这业绩，省得当场出彩。","book":"明·凌濛初《二刻拍案惊奇》卷三十"},"example":{"text":"反本透赢～，弄巧成拙蓦地撤差。","book":"清·李宝嘉《官场现形记》第二十一回回目"},"similar":["当众出丑"],"usage":"作谓语；指当众出丑"},{"id":17866,"word":"当场献丑","pinyin":"dāng chǎng xiàn chǒu","abbr":"dcxc","explanation":"当：对着，向着。在大庭广众露出丑相，丢脸。","source":{"text":"我今年已六十，尚无子嗣，你若肯时，便请个先生教你，也强如当场献丑。","book":"明·冯梦龙《醒世恒言》第20卷"},"similar":["当场出丑"],"usage":"作谓语、宾语；指丢脸"},{"id":17867,"word":"当头一棒","pinyin":"dāng tóu yī bàng","abbr":"dtyb","explanation":"迎头一棍子。比喻受到严重警告或突然的打击。","source":{"text":"上堂，僧问：‘如何是佛法大意？’师亦竖拂子，僧便喝，师亦喝。僧拟议，师便打。","book":"《五灯会元·黄檗运禅师法嗣·临济义玄禅师》"},"example":{"text":"孔子好像受了～，亡魂失魄地坐着，恰如一段呆木头。","book":"鲁迅《故事新编·出头》"},"similar":["当头棒喝"],"usage":"作谓语、宾语；比喻受到严重警告或突然打击"},{"id":17868,"word":"当头对面","pinyin":"dāng tóu duì miàn","abbr":"dtdm","explanation":"当面商量或面对面辩论。"},{"id":17869,"word":"当头棒喝","pinyin":"dāng tóu bàng hè","abbr":"dtbh","explanation":"佛教禅宗和尚接待初学的人常常用棒一击或大喝一声，促他醒悟。比喻严厉警告，促使人猛醒过来。","source":{"text":"上堂，僧问：‘如何是佛法大意？’师亦竖拂子，僧便喝，师亦喝。僧拟议，师便打。","book":"宋·释普济《五灯会元·黄檗运禅师法嗣·临济义玄禅师》"},"example":{"text":"那日程希明～，未免触动了天良。","book":"清·李绿园《歧路灯》第十四回"},"similar":["晨钟暮鼓","当头一棒"],"usage":"作主语、宾语；多用于书面语","story":["唐朝时期，佛教的临济宗师以棒喝作为传道的方法，传说禅师马祖在弟子百丈参见时对他大喝一声，震得他三天之内还耳聋眼花。黄檗向弟子临济传道时，举棒就打，并且连打三次，临济只好自己苦心研究，终于弄清佛法的奥秘"]},{"id":17870,"word":"当家作主","pinyin":"dāng jiā zuò zhǔ","abbr":"djzz","explanation":"当家：主持家务。本指主管家政，有权对家事做出决定。比喻在单位或国家中居主人翁地位。","source":{"text":"看到自己的名字，端端正正写在那选民名单上时，一个公民当家做主的光荣感，会涌上心头的。","book":"阿凤《夜景》"},"example":{"text":"沙汀《风浪》：“申大嫂可以说是全家真正～的人，申大哥也事事听她安排。”"},"similar":["当家做主","当家理纪"],"usage":"作谓语、宾语、定语；指处于主人翁地位"},{"id":17871,"word":"当家做主","pinyin":"dāng jiā zuò zhǔ","abbr":"djzz","explanation":"当家：主持家务。本指主管家政，有权对家事做出决定。比喻在单位或国家中居主人翁地位","source":{"text":"我一直梦想有一间自己的店铺，好当家做主，从领导、父母给我气受那天起。","book":"王朔《浮出海面》"},"example":{"text":"阿凤《夜景》：“看到自己的名字，端端正正写在那选民名单上时，一个公民～的光荣感，会涌上心头的。”"},"similar":["当家作主"],"usage":"作谓语、宾语、定语；指处于主人翁地位"},{"id":17872,"word":"当家理纪","pinyin":"dāng jiā lǐ jì","abbr":"djlj","explanation":"指管理家务。","source":{"text":"如今大街坊张二官府，要破五百两金银，娶你做二房娘子，当家理纪。","book":"明·兰陵笑笑生《金瓶梅词话》第八十回"},"example":{"text":"你老本本等等另娶个正经亲家婆，叫他出来随人情～的。","book":"清·西周生《醒世姻缘传》第十一回"},"similar":["当家立纪"],"usage":"作谓语、定语；指管家"},{"id":17873,"word":"当家立业","pinyin":"dāng jiā lì yè","abbr":"djly","explanation":"主持家业。","source":{"text":"清·曹雪芹《红楼梦》第三十一回：“偏偏晴雯上来换衣服，不防又把扇子失了手，掉在地下，将骨子跌折。宝玉因叹道：‘蠢才，蠢才！将来怎么样！明日你自己当家立业，难道也是这么顾前不顾后的？”一本作“当家立事”。"},"similar":["当家立事"],"usage":"作谓语、宾语；用于治家"},{"id":17874,"word":"当家立事","pinyin":"dāng jiā lì shì","abbr":"djls","explanation":"主持家业。","source":{"text":"偏生晴雯上来换衣服，不防又把扇子失了手跌在地下，将股子跌折。宝玉因叹道：‘蠢才，蠢才！将来怎么样？明日你自己当家立事，难道也是这么顾前不顾后的？’","book":"清·曹雪芹《红楼梦》第三一回"},"example":{"text":"不～就不知为人之艰辛。"},"similar":["当家立业"],"usage":"作谓语、宾语；用于治家"},{"id":17875,"word":"当家立纪","pinyin":"dāng jiā lì jì","abbr":"djlj","explanation":"指管理家务。","source":{"text":"这娘子今年不上二十五六岁，生的长挑身材，一表人物，打扮起来就是个灯人儿。风流俊俏，百伶百俐，当家立纪、针指女工、双陆棋子，不消说。","book":"明·兰陵笑笑生《金瓶梅词话》第七回"},"similar":["当家理纪"],"usage":"作谓语、定语；指管家"},{"id":17876,"word":"当家立计","pinyin":"dāng jiā lì jì","abbr":"djlj","explanation":"当家：主持家政。主持家政，谋划生计。","source":{"text":"贾政本是不知当家立计的人，一听贾母的话，一一领命。","book":"清·曹雪芹《红楼梦》第一○七回"},"example":{"text":"那些少年托着老子娘的福吃喝惯了的，那知～的道理。","book":"清·曹雪芹《红楼梦》第一百十七回"},"similar":["当家立事"],"usage":"作谓语、宾语、定语；用于治家"},{"id":17877,"word":"当局者迷","pinyin":"dāng jú zhě mí","abbr":"djzm","explanation":"迷：糊涂，迷惑。指当事人反而糊涂。","source":{"text":"我自是笑别人的，却元来当局者迷。","book":"宋·辛弃疾《恋绣衾·无题》"},"example":{"text":"希望我们大家互相勉励……～，旁观者清，我们应该有则改之，无则加勉。","book":"邹韬奋《事业管理与职业修养·关于工作与学习五》"},"similar":["当局者迷，旁观者清"],"opposite":["旁观者清"],"usage":"作主语、宾语、定语；指当事人糊涂","story":["唐朝大臣魏光上书唐玄宗要求把魏征整理修订的《类礼》列为经书。唐玄宗命元澹校阅，右丞相张说认为已经有郑玄作注成为经书。元澹写《释疑》表明自己观点：郑玄的注过时了，魏征不是下棋人，他是旁观者所以注解得比较真实"]},{"id":17878,"word":"当局者迷，旁观者清","pinyin":"dāng jú zhě mí，páng guān zhě qīng","abbr":"djzmpgzq","explanation":"当局者：下棋的人；旁观者：看棋的人。当事人被碰到的事情搞糊涂了，旁观的人却看得很清楚。","source":{"text":"当局称迷，傍（旁）观见审。","book":"《旧唐书·元行冲传》"},"example":{"text":"谁怪着你呢，实在说的不错，倒是没有人说过的话！可见“～。”","book":"清·刘鹗《老残游记》第十三回"},"usage":"作宾语、定语；用于劝诫人","story":["唐朝大臣魏光上书唐玄宗要求把魏征整理修订的《类礼》列为经书。唐玄宗命元澹校阅，右丞相张说认为已经有郑玄作注成为经书。元澹写《释疑》表明自己观点：郑玄的注过时了，魏征不是下棋人，他是旁观者所以注解得比较真实"]},{"id":17879,"word":"当断不断","pinyin":"dāng duàn bù duàn","abbr":"ddbd","explanation":"指应该决断的时候不能决断。","source":{"text":"当断不断，反受其乱。","book":"《史记·齐悼惠王世空》"},"example":{"text":"段失之太刚，黎又失之太柔，～，反受其乱。","book":"蔡东藩、许廑父《民国通俗演义》第八十一回"},"similar":["优柔寡断","瞻前顾后","犹豫不决"],"opposite":["当机立断","英名果断","多谋善断"],"usage":"作谓语、定语；指应该决断的时候不决断"},{"id":17880,"word":"当断不断，反受其乱","pinyin":"dāng duàn bù duàn，fǎn shòu qí luàn","abbr":"ddbdfsql","explanation":"断：决断；乱：祸乱。应该作出决断而犹豫不决，就要产生祸乱。指做事应当机立断，否则后患无穷。","source":{"text":"道家之言‘当断不断，反受其乱’，乃是也。","book":"西汉·司马迁《史记·齐悼惠王世家》"},"example":{"text":"这是他走向革命的最好时机，要当机立断；～。","book":"薄一波《师长与战友——回忆刘伯承同志》"},"similar":["当断不断"],"usage":"作宾语、定语；用于处事"},{"id":17881,"word":"当时谈宗","pinyin":"dāng shí tán zōng","abbr":"dstz","explanation":"谈宗：善于言谈，为世人所尊崇。指当代清谈大师。","source":{"text":"王衍当时谈宗，自以论《易》略尽，然有所未了，研之终莫悟，每云‘不知比没当见能通之者不。’衍族子敦谓衍曰：‘阮宣子可与言。’","book":"《晋书·阮修传》"}},{"id":17882,"word":"当机立决","pinyin":"dāng jī lì jué","abbr":"djlj","explanation":"抓住时机，立即做出决断。","source":{"text":"秉青萍干将之器，拂钟无声，应机立断。","book":"汉·陈琳《答东阿王笺》"},"example":{"text":"所患者，不能～，必待报而后施行。","book":"清·采蘅子《虫鸣漫录》卷一"},"similar":["当机立断"],"opposite":["优柔寡断"],"usage":"作谓语、宾语、定语；形容人很果断"},{"id":17883,"word":"当机立断","pinyin":"dāng jī lì duàn","abbr":"djld","explanation":"当机：抓住时机。在紧要时刻立即做出决断。","source":{"text":"秉青萍干将之器，拂钟无声，应机立断。","book":"汉·陈琳《答东阿王笺》"},"example":{"text":"哥哥，国姓爷就在城下，你应该～。","book":"郭沫若《郑成功》第七章"},"similar":["英明果断","多谋善断"],"opposite":["举棋不定","优柔寡断","犹豫不决"],"usage":"作谓语、宾语、定语；形容人很果断"},{"id":17884,"word":"当机贵断","pinyin":"dāng jī guì duàn","abbr":"djgd","explanation":"当机：抓住时机；断：决断。抓住关键时机，最可贵的是立即做出决断。","source":{"text":"临事尚乎守，当机贵乎断，兆谋先乎密。","book":"《宋史·宋绶传》"},"similar":["当机立断"],"usage":"作谓语、宾语、定语；形容人很果断"},{"id":17885,"word":"当着不着","pinyin":"dāng zhuó bù zhuó","abbr":"dzbz","explanation":"指应该做的事不做，而不该做的事却做了。","source":{"text":"指应该做的事不做，而不该做的事却做了。"},"example":{"text":"世事莫有成心，成心专会认错，任是大圣大贤，也要～。","book":"明·凌濛初《二刻拍案惊奇》卷十二"},"usage":"作谓语、定语；用于处事"},{"id":17886,"word":"当立之年","pinyin":"dāng lì zhī nián","abbr":"dlzn","explanation":"指三十岁。","source":{"text":"吾十有五而志于学，三十而立。","book":"《论语·为政》"},"example":{"text":"今汝将及～，犹未纳室。","book":"明·冯梦龙《警世通言·宿香亭张浩遇莺莺》"},"similar":["三十而立","而立之年"],"usage":"作宾语；指三十岁","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，孔子与弟子们谈起自己的经历，说他从30岁开始立志弘道，到现在快七十岁没能推销出仁政，感慨万千……宰予立即过来安慰孔子"]},{"id":17887,"word":"当耳旁风","pinyin":"dāng ěr páng fēng","abbr":"depf","explanation":"见“当耳边风”。当做耳边吹过的风。比喻对所听的话不放在心上。","source":{"text":"富贵之於我，如秋风之过耳。","book":"语出汉·赵晔《吴越春秋·吴王寿梦传》"},"example":{"text":"袭人道：‘一百年还记着呢！比不得你，拿着我的话～，夜里说了，早起就忘了。’","book":"清·曹雪芹《红楼梦》第二十一"},"similar":["当耳边风"],"usage":"作谓语、宾语；形容对别人毫不在意"},{"id":17888,"word":"当耳边风","pinyin":"dāng ěr biān fēng","abbr":"debf","explanation":"比喻对听到的话毫不在意。","source":{"text":"富贵之于我，如秋风之过耳。","book":"《吴越春秋·吴王寿梦传》"},"example":{"text":"他把爹妈的劝告～，结果一误再误，后来竟铸成大错。"},"similar":["漠不关心","毫不在意"],"usage":"作谓语、宾语；形容对别人毫不在意"},{"id":17889,"word":"当行出色","pinyin":"dāng háng chū sè","abbr":"dhcs","explanation":"当行：内行。指做本行本业的事，成绩特别显著。","source":{"text":"禅道在妙语，诗道亦然。惟悟乃为当行，乃为本色。","book":"明·王骥德《曲律·杂论》"},"example":{"text":"越发谈得高兴了，道是今年的会墨，那篇逼真大家，那篇～。","book":"清·文康《儿女英雄传》第三十七回"},"usage":"作谓语、定语；指在该行业中很优秀"},{"id":17890,"word":"当行本色","pinyin":"dāng háng běn sè","abbr":"dxbs","explanation":"当行：内行。指做本行本业的事，成绩特别显著。","source":{"text":"禅道在妙语，诗道亦然。惟悟乃为当行，乃为本色。","book":"明·王骥德《曲律·杂论》"},"usage":"作宾语、定语；用于作文等"},{"id":17891,"word":"当轴之士","pinyin":"dāng zhóu zhī shì","abbr":"dzzs","explanation":"当：承担；轴：车轴。比喻身居要职的人。","source":{"text":"秉钧当轴之士，身兼官以十数。","book":"晋·干宝《晋纪总论》"}},{"id":17892,"word":"当轴处中","pinyin":"dāng zhóu chǔ zhōng","abbr":"dzcz","explanation":"正处在车轴的中间。比喻官居要位。","source":{"text":"车承相即周鲁之列，当轴处中，括囊不言，容身而去，彼哉！彼哉！","book":"汉·桓宽《盐铁论·杂论》"},"example":{"text":"公～，率下以义。","book":"《宋书·武帝纪中》"},"usage":"作谓语；比喻官居要位"},{"id":17893,"word":"当道撅坑","pinyin":"dāng dào juē kēng","abbr":"ddjk","explanation":"指拼个你死我活。","source":{"text":"我从来个路见不平，爱与人当道撅坑。","book":"元·高文秀《黑旋风》第一折"}},{"id":17894,"word":"当门抵户","pinyin":"dāng mén dǐ hù","abbr":"dmdh","explanation":"指撑持门户。","source":{"text":"他两人没有嬷嬷，只是盼奴当门抵户。","book":"明·凌濛初《初刻拍案惊奇》卷二十五"},"usage":"作谓语、定语；用于家庭主心骨"},{"id":17895,"word":"当面一套，背后一套","pinyin":"dāng miàn yī tào，bèi hòu yī tào","abbr":"dmytbhyt","explanation":"当面说的是一样，背后说的又是一样。比喻表里不一，口是心非。"},{"id":17896,"word":"当面出丑","pinyin":"dāng miàn chū chǒu","abbr":"dmcc","explanation":"在大庭广众暴露自己的弱点。","example":{"text":"我不想～了。"},"similar":["当场出丑"],"usage":"作谓语、宾语；指出丑"},{"id":17897,"word":"当面是人背后是鬼","pinyin":"dāng miàn shì rén bèi hòu shì guǐ","abbr":"dmsrbhsg","explanation":"两面派。","source":{"text":"人世间是有这样一种角色——当面是人，背后是鬼。","book":"海涛《硝烟》"},"similar":["两面三刀"],"usage":"作谓语、定语；指两面派"},{"id":17898,"word":"当面是人，背后是鬼","pinyin":"dāng miàn shì rén，bèi hòu shì guǐ","abbr":"dmsrbhsg","explanation":"比喻当面一套，背后一套，耍阴谋诡计的两面派人物。"},{"id":17899,"word":"当面输心背面笑","pinyin":"dāng miàn shū xīn bèi miàn xiào","abbr":"dmsxbmx","explanation":"比喻当面显得十分亲热，背后却在捣鬼。","source":{"text":"因为中国向来就是‘当面输心背面笑’，正不必‘新的时代’的青年才这样。","book":"鲁迅《华盖集续编·海上通信》"},"example":{"text":"你不要～了。"},"similar":["两面三刀"],"usage":"作谓语、宾语；指两面派"},{"id":17900,"word":"当面错过","pinyin":"dāng miàn cuò guò","abbr":"dmcg","explanation":"面对面地失去了机会。","source":{"text":"一起便觉，一觉便转，此是转祸为福、起死回生的关头，切莫当面错过。","book":"明·施耐庵《水浒传》第一回：“洪太尉道：‘我直如此有眼不识真师，当面错过！’”明·洪应明《菜根谭·闲适》"},"example":{"text":"报仇事小，婚姻事大。只这个赵公子，如此英雄，果是无双，今若舍了，岂不～？","book":"清·吴璿《飞龙全传》第十一回"},"similar":["失之交臂"],"usage":"作谓语、定语；用于机遇等"},{"id":17901,"word":"当面锣，对面鼓","pinyin":"dāng miàn luó，duì miàn gǔ","abbr":"dmldmg","explanation":"比喻面对面地商量、对证或争论。","source":{"text":"他听见俺娘说不拘几时要对这活，他如何就慌了。要着我，你两个当面锣、对面鼓的对不是！","book":"明·兰陵笑笑生《金瓶梅词话》第五十一回"},"example":{"text":"就说媳妇儿也罢，也有这样～的说亲的吗？","book":"清·文康《儿女英雄传》第九回"},"similar":["当面鼓，对面锣"],"usage":"作状语；指当面对质或交锋"},{"id":17902,"word":"当风秉烛","pinyin":"dāng fēng bǐng zhú","abbr":"dfbz","explanation":"秉：举着。迎着风举着蜡烛。比喻身陷危险境地。","source":{"text":"我性命恰便似当风秉烛，恰便似水不浮沤。","book":"明·无名氏《勘金环》第三折"},"usage":"作宾语、定语；指情况危急"},{"id":17903,"word":"录用弃瑕","pinyin":"lù yòng qì xiá","abbr":"lyqx","explanation":"录用：录取使用；瑕：玉上的斑点，比喻错误。指对犯过错误、有游击战的人不予任用。","source":{"text":"大易之戒，遏恶扬善，为国之体，录用弃瑕。","book":"唐·李翰《进张巡中丞传表》"},"example":{"text":"《春秋》以功覆过，《书》赦过宥刑，在《易》遏恶扬善，为国者～。","book":"《新唐书·文艺下》"}},{"id":17904,"word":"彗汜画涂","pinyin":"huì sì huà tú","abbr":"hsht","explanation":"彗：扫帚；汜：水洒地；涂：泥土。用帚扫洒水在地上，用刀划泥土。比喻极容易做的事。","source":{"text":"水断蛟龙，陆剸犀革，忽若彗汜画涂。","book":"《汉书·王褒传》"},"similar":["轻而易举"],"usage":"作定语；比喻极容易做"},{"id":17905,"word":"彗泛画涂","pinyin":"huì fàn huà tú","abbr":"hfht","explanation":"彗：扫帚；汜：以水洒地。涂：泥。谓以帚扫秽，以刀划泥。比喻极其容易。","source":{"text":"彗，帚也。汜，把洒地也。涂，泥也。加以帚扫汜洒之地，以刀画泥中，言其易。","book":"《汉书·王褒传》：“及至巧冶铸干将之朴，清水焠其锋，越砥敛其咢。水断蛟龙，陆犀革。忽若彗汜画涂。”颜师古注"}},{"id":17906,"word":"彘子孩儿","pinyin":"zhì zǐ hái ér","abbr":"zzhe","explanation":"骂人话。即娼妓所生的孩子。","source":{"text":"这个彘子孩儿，人也不识，买饭吃的！","book":"元·施惠《幽闺记》第二十五出"}},{"id":17907,"word":"彘肩斗酒","pinyin":"zhì jiān dòu jiǔ","abbr":"zjdj","explanation":"形容英雄豪壮之气。","source":{"text":"哙遂入，披帷西乡立，瞋目视项王……项王曰：‘壮士，赐之卮酒。’则与斗卮酒。哙拜谢，起，立而饮之。项王曰：‘赐之彘肩。’则与一生彘肩。樊哙覆其盾於地，加彘肩上，拔剑切而啗之……","book":"《史记·项羽本纪》"},"example":{"text":"～渡江人，南部莺花每怆神。","book":"吴梅《马鞍山麓吊刘龙洲墓》诗"},"usage":"作主语、宾语、定语；指人有豪气","story":["公元前208年，项羽率40万大军开往咸阳，项伯请刘邦到鸿门赴宴。刘邦到鸿门后，项羽设计让项庄舞剑助兴，乘机想杀刘邦。刘邦手下樊哙冲进营帐来保护刘邦。项羽称赞他勇敢，就赐他狗肉和美酒，樊哙拔剑切肉就吃。刘邦借机逃离鸿门"]},{"id":17908,"word":"彝伦攸斁","pinyin":"yí lún yōu dù","abbr":"ylyy","explanation":"彝伦：指伦常；攸：语助词，无义；斁：败坏。指伦常败坏。","source":{"text":"帝乃震怒，不畀洪范九畴，彝伦攸斁。","book":"《尚书·洪范》"},"example":{"text":"晋·范宁《春秋谷梁传序》：“昔周道衰陵，乾纲绝纽。礼乐崩坏，～。”"},"usage":"作谓语、宾语；用于书面语"},{"id":17909,"word":"彝鼎圭璋","pinyin":"yí dǐng guī zhāng","abbr":"ydgz","explanation":"比喻典雅出众。","source":{"text":"大家围着一看，只见状元清华丰采，榜眼凝重安详；到了那个探花，说甚么潘安般貌，子建般才，只他那气宇轩昂之中不露一些纨袴，温文儒雅之内不粘一点寒酸。真真是彝鼎圭璋，熙朝人瑞。","book":"清·文康《儿女英雄传》第三十六回"}},{"id":17910,"word":"形不吊影","pinyin":"xíng bù diào yǐng","abbr":"xbdy","explanation":"形容无依无靠，非常孤独。","source":{"text":"外无期功强近之亲，内无应门五尺之童，茕茕孑立，形影相吊。","book":"晋·李密《陈情表》"},"example":{"text":"尔来索居仙台，又复匝月，～，弥觉无聊。","book":"鲁迅《书信集·致蒋抑卮》"}},{"id":17911,"word":"形之笔墨","pinyin":"xíng zhī bǐ mò","abbr":"xzbm","explanation":"形：描写。用笔墨把它写出来。","source":{"text":"遂使当时身被拘国的孤臣，闻其事而含哀，兴感形之笔墨，咏成诗词。","book":"清·褚人获《隋唐演义》第九十三回"},"example":{"text":"不知道为什么晚年来，在沈师母故世之后，忽然态度一变，对令俊深致不惬，不惜～。","book":"施蛰存《怀孔令俊》"}},{"id":17912,"word":"形于言色","pinyin":"xíng yú yán sè","abbr":"xyys","explanation":"指内心活动表露在脸上和言辞之中。","source":{"text":"少有大志，忠亮任气，人有不称其心者，辄形于言色。","book":"《晋书·何无忌传》"},"example":{"text":"《魏书·任城王传》：“每怀郁怏，～，遂纵酒欢娱，不亲政事。”"},"similar":["形于辞色","形于颜色"],"usage":"作谓语、定语；用于处事"},{"id":17913,"word":"形于辞色","pinyin":"xíng yú cí sè","abbr":"xycs","explanation":"指内心活动表露在脸上和言辞之中。","source":{"text":"少有大志，忠亮任气，人有不称其心者，辄形于言色。","book":"《晋书·何无忌传》"},"similar":["形于言色","形于颜色"],"usage":"作谓语、定语；用于处事"},{"id":17914,"word":"形于颜色","pinyin":"xíng yú yán sè","abbr":"xyys","explanation":"指内心活动表露在脸面上。","source":{"text":"忧瘁泣涕，形于颜色。","book":"宋·范祖禹《论德政》"},"similar":["形于辞色","形于言色"],"usage":"作谓语、定语；用于处事"},{"id":17915,"word":"形亲之国","pinyin":"xíng qīn zhī guó","abbr":"xqzg","explanation":"指边界相邻而友好的国家","source":{"text":"今秦与楚，接境壤界，固形亲之国。","book":"西汉·司马迁《史记·张仪传》"},"usage":"作宾语；用于书面语"},{"id":17916,"word":"形具神生","pinyin":"xíng jù shén shēng","abbr":"xjss","explanation":"形：形体；神：精神。人的形体具备，精神随之产生。","source":{"text":"天职既立，天功既成，形具而神生，好恶喜怒哀乐臧（藏）焉，夫是之谓天情。","book":"《荀子·天论》"},"usage":"作谓语；指人"},{"id":17917,"word":"形制之势","pinyin":"xíng zhì zhī shì","abbr":"xzzs","explanation":"依靠有利的地形条件去制服对方。","source":{"text":"愿足下急复进兵，收取荥阳，据敖仓之粟，塞成皋之险，杜大行之道，距蜚狐之口，守白马之津，以示诸侯效实形制之势，则天下知所归矣。","book":"《史记·郦生陆贾列传》"},"usage":"作宾语；用于书面语"},{"id":17918,"word":"形劫势禁","pinyin":"xíng jié shì jìn","abbr":"xjsj","explanation":"指受形势的阻碍或限制，事情难于进行。同“形格势禁”。","source":{"text":"夫解杂乱纷纠者不控捲，救斗者不搏戟，批亢捣虚，形格势禁，则自为解耳。","book":"《史记·孙子吴起列传》"},"example":{"text":"夫奴虏之于主人，特～，无可如何已耳，非心悦诚服，有爱于其国与主，而共保持之也。","book":"清·严复《原强》"},"similar":["形格势禁"],"usage":"作谓语、定语；指事情难于进行"},{"id":17919,"word":"形势之途","pinyin":"xíng shì zhī tú","abbr":"xszt","explanation":"形势：指人事上强弱之势，指人际关系。指官员升迁的道路","source":{"text":"伺候于公卿之门，奔走于形势之途。","book":"唐·韩愈《送李愿归盘谷序》"},"usage":"作宾语；用于书面语"},{"id":17920,"word":"形势逼人","pinyin":"xíng shì bī rén","abbr":"xsbr","explanation":"指形势发展很快，迫使人不得不更加努力。","source":{"text":"‘热’可以逼得喜冷的人也热起来，形势逼人，不热不可。","book":"谢觉哉《冷和热》"},"example":{"text":"～，我们得赶紧行动。"},"similar":["局势逼人"],"usage":"作宾语、分局；用于分析时局"},{"id":17921,"word":"形单影单","pinyin":"xíng dān yǐng dān","abbr":"xdyd","explanation":"形：身体；单：单独。只有自己的身体和自己的影子。形容孤独，没有同伴。","source":{"text":"承先人后者，在孙惟汝，在子惟吾，两世一身，形单影只。","book":"唐·韩愈《祭十二郎文》"},"example":{"text":"我怎敢忘却些儿灯边枕边！只愁你～，只愁你食寒枕寒，哭得我哽咽喉干。","book":"明·高濂《玉簪记·追别》"},"similar":["形单影只","形只影单","影单形只"],"opposite":["前呼后拥","门庭若市"],"usage":"作谓语、定语；指孤独"},{"id":17922,"word":"形单影双","pinyin":"xíng dān yǐng shuāng","abbr":"xdys","explanation":"形容人无亲无友、孤独无依。","example":{"text":"他的性情孤僻，所到之处总见他～，无人为伴。"}},{"id":17923,"word":"形单影只","pinyin":"xíng dān yǐng zhī","abbr":"xdyz","explanation":"形：身体；只：单独。只有自己的身体和自己的影子。形容孤独，没有同伴。","source":{"text":"承先人后者，在孙惟汝，在子惟吾，两世一身，形单影只。","book":"唐·韩愈《祭十二郎文》"},"example":{"text":"因得常哭于芸娘之墓，影单形只，备极凄凉。","book":"清·沈复《浮生六记·坎坷记愁》"},"similar":["形影相吊","孤苦伶仃","形单影单"],"opposite":["前呼后拥","门庭若市"],"usage":"作谓语、定语；指孤独"},{"id":17924,"word":"形只影单","pinyin":"xíng zhī yǐng dān","abbr":"xzyd","explanation":"形容孤单。","source":{"text":"但臣亲老鬓发白，筋力皆癯瘁。形只影单，无兄弟，谁奉侍？","book":"明·高明《琵琶记·丹陛陈情》"},"example":{"text":"太后因妇人一生衣食莫不倚于其夫，其有夫死而孀居者，既无丈夫衣食可恃，～，饥寒谁恤。","book":"清·李汝珍《镜花缘》第四十回"},"similar":["形单影只","形单影单","影单形只"],"opposite":["前呼后拥","门庭若市"],"usage":"作谓语、定语；指孤独"},{"id":17925,"word":"形夸骨佳","pinyin":"xíng kuā gǔ jiā","abbr":"xkgj","explanation":"夸：柔软，美好。形容女子外貌美丽，体形优美。","source":{"text":"曼颊皓齿，形夸骨佳，不待脂粉芳泽而性可说者，西施、阳文也。","book":"《淮南子·修务训》"},"usage":"作谓语、定语；用于书面语"},{"id":17926,"word":"形如槁木","pinyin":"xíng rú gǎo mù","abbr":"xrgm","explanation":"槁：干枯。形态象干枯的树木。","source":{"text":"形固可使如槁木，心固可使如死灰乎？","book":"《庄子·齐物论》"},"example":{"text":"我心上的伤痕只有我一个人知道。我纵然～，心如死灰，我也如何能够忘记！","book":"巴金《春》四"},"usage":"作谓语、定语；用于书面语"},{"id":17927,"word":"形孤影只","pinyin":"xíng gū yǐng zhī","abbr":"xgyz","explanation":"形容孤独，没有同伴。同“形单影只”。","source":{"text":"承先人后者，在孙惟汝，在子惟吾，两世一身，形单影只。","book":"唐·韩愈《祭十二郎文》"},"example":{"text":"盘缠尽有，我上京听选，留贤妻在家，～。","book":"明·冯梦龙《警世通言》卷三十一"},"similar":["形孤影寡","形单影只","影单形只"],"opposite":["前呼后拥"],"usage":"作谓语、定语；指孤独"},{"id":17928,"word":"形孤影孑","pinyin":"xíng gū yǐng jié","abbr":"xgyj","explanation":"形：身体；孑：单独。只有自己的身体和自己的影子。形容孤独，没有同伴。","source":{"text":"顾后瞻前，形孤影孑。","book":"唐·李商隐《为李郎中祭舅窦端州文》"}},{"id":17929,"word":"形孤影寡","pinyin":"xíng gū yǐng guǎ","abbr":"xgyg","explanation":"形容孤独，没有同伴。同“形单影只”。","source":{"text":"顾后瞻前，形孤影孑。","book":"唐·李商隐《为李郎中祭舅窦端州文》"},"example":{"text":"他金雀钗头双凤朵，奴家若带了啊，可不羞杀人～。","book":"元·高明《琵琶记》第三十五出"},"similar":["形单影只","形只影单","形孤影只"],"opposite":["前呼后拥","门庭若市"],"usage":"作谓语、定语；指孤独"},{"id":17930,"word":"形容憔悴","pinyin":"xíng róng qiáo cuì","abbr":"xrqc","explanation":"憔悴；精神萎靡，面色不好。身体瘦弱，面色枯黄。","source":{"text":"颜色憔悴，形容枯槁。","book":"战国·楚·屈原《渔父》"},"example":{"text":"丰即引孙乾入见绍，呈上书信。只见绍～，衣冠不整。","book":"明·罗贯中《三国演义》第二十四回"},"opposite":["容光焕发","红光满面"],"usage":"作谓语、定语、状语；用于人的外表"},{"id":17931,"word":"形容枯槁","pinyin":"xíng róng kū gǎo","abbr":"xrkg","explanation":"槁：枯干。指形体容貌消瘦不堪。","source":{"text":"屈原既放，游于江潭，行吟泽畔，颜色憔悴，形容枯槁。","book":"战国·楚·屈原《楚辞·渔父》"},"example":{"text":"看见王夫人～，众人眼肿腮红，便也大哭起来。","book":"清·曹雪芹《红楼梦》第一百一十九回"},"similar":["形销骨立","骨瘦如柴"],"opposite":["容光焕发","神采奕奕"],"usage":"作谓语、定语；指人的外表"},{"id":17932,"word":"形式主义","pinyin":"xíng shì zhǔ yì","abbr":"xszy","explanation":"给予形而上学的诸形式以首要地位的一种哲学。","source":{"text":"这种单纯建立在‘上级’观念上的形式主义的态度是很不对的。","book":"毛泽东《反对本本主义》"},"example":{"text":"我不想那样搞～。"},"usage":"作主语、宾语、定语；指做样子"},{"id":17933,"word":"形形色色","pinyin":"xíng xíng sè sè","abbr":"xxss","explanation":"形形：原指生出这种形体；色色：原指生出这种颜色。指各式各样，种类很多。","source":{"text":"有形者，有形形者，有色者，有色色者。","book":"《列子·天瑞》"},"example":{"text":"人上一百，～，难免良莠不一，何况是上千上万。","book":"姚雪垠《李自成》第一卷第六章"},"similar":["五花八门","千奇百怪","应有尽有"],"opposite":["千篇一律","如出一辙"],"usage":"作谓语、定语；形容人或事物"},{"id":17934,"word":"形影不离","pinyin":"xíng yǐng bù lí","abbr":"xybl","explanation":"象形体和它的影子那样分不开。形容彼此关系亲密，经常在一起。","source":{"text":"青县农家少妇，性轻佻，随其夫操作，形影不离。","book":"清·纪昀《阅微草堂笔记》卷二"},"example":{"text":"他们俩是一对～的好朋友。"},"similar":["如影随形","难舍难分","寸步不离"],"opposite":["天各一方","水火不容"],"usage":"作谓语、定语、状语；形容两者关系密"},{"id":17935,"word":"形影相亲","pinyin":"xíng yǐng xiāng qīn","abbr":"xyxq","explanation":"象形体和它的影子那样分不开。形容彼此关系亲密，经常在一起。","source":{"text":"羁旅无俦匹，形影自相亲。","book":"南朝·梁·何逊《赠族人秣陵兄弟》"},"similar":["形影不离"],"usage":"作谓语、定语；用于交往等"},{"id":17936,"word":"形影相依","pinyin":"xíng yǐng xiāng yī","abbr":"xyxy","explanation":"①指在孤寂的处境中相依相伴。②形容孤单无依。③互相依靠，紧密相连。","source":{"text":"风霜渐逼岁时晚，形影相依灯光明。","book":"宋·陆游《书巢冬夜待旦》"},"example":{"text":"引得这位玄宗皇帝，特别爱怜，居然与她朝欢暮乐，～。","book":"蔡东藩《唐史演义》第四十四回"},"similar":["形影相附"],"usage":"作谓语、定语；用于书面语"},{"id":17937,"word":"形影相吊","pinyin":"xíng yǐng xiāng diào","abbr":"xyxd","explanation":"吊：慰问。孤身一人，只有和自己的身影相互慰问。形容无依无靠，非常孤单。","source":{"text":"茕茕孑立，形影相吊。","book":"三国·魏·曹植《上责躬应诏诗表》：“窃感《相鼠》之篇，无礼遄死之义，形影相吊，五情愧郝。”晋·李密《陈情表》"},"example":{"text":"～，衣我食我，岁使交道。","book":"宋·黄庭坚《祭李之叔文》"},"similar":["形单影只","孤苦伶仃","孤家寡人"],"opposite":["前呼后拥","门庭若市","济济一堂"],"usage":"作谓语、宾语、定语；指孤单","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母，尊重老人。他想启用西蜀尚书郎李密，就下诏书任命李密为郎中。李密不愿出来做官，就写《陈情表》上书晋武帝，说自己与祖母形影相吊、相依为命，待伺候祖母后再出来做官"]},{"id":17938,"word":"形影相守","pinyin":"xíng yǐng xiāng shǒu","abbr":"xyxs","explanation":"象形体和它的影子那样分不开。形容彼此关系亲密，经常在一起。","source":{"text":"反旋在国，揵门退扫，形影相守，出入二载。","book":"三国·魏·曹植《黄初六年令》"}},{"id":17939,"word":"形影相对","pinyin":"xíng yǐng xiāng duì","abbr":"xyxd","explanation":"形容无依无靠，非常孤单。同“形影相吊”。","source":{"text":"窃感《相鼠》之篇，无礼遄死之义，形影相吊，五情愧郝。","book":"三国·魏·曹植《上责躬应诏诗表》"},"example":{"text":"余外就～，差不多眼儿望穿，也不得周庸祐到来一看。","book":"清·黄小配《廿载繁华梦》第二十一回"},"similar":["形影相吊","形影相顾"],"usage":"作谓语、定语；指人孤独"},{"id":17940,"word":"形影相怜","pinyin":"xíng yǐng xiāng lián","abbr":"xyxl","explanation":"象形体和它的影子那样分不开。形容彼此关系亲密，经常在一起。","source":{"text":"宿昔青云志，蹉跎白发年。谁知明镜里，形影自相怜。","book":"唐·张九龄《照镜见白发》"},"example":{"text":"娘孤独，女共依，～难暂弃。","book":"《清忠谱》第十九折"}},{"id":17941,"word":"形影相携","pinyin":"xíng yǐng xiāng xié","abbr":"xyxx","explanation":"象形体和它的影子那样分不开。形容彼此关系亲密，经常在一起。","source":{"text":"复自思念，方痛未定时，形影相携，奉头鼠窜。","book":"宋·范成大《代乐先生还乡上季太守书》"}},{"id":17942,"word":"形影相追","pinyin":"xíng yǐng xiāng zhuī","abbr":"xyxz","explanation":"形：形体；影：身影；追：追随。像影子离不开形体一样，一刻也不分离。形容彼此关系密切。","source":{"text":"形影相追高翥鸟，心肠并断北飞船。","book":"唐·张说《同张侍御望归舟》"},"similar":["形影相随"],"usage":"作谓语、定语；指彼此关系密切"},{"id":17943,"word":"形影相附","pinyin":"xíng yǐng xiāng fù","abbr":"xyxf","explanation":"在孤寂的处境中相依相伴。同“形影相依”。","source":{"text":"今已决策于此，又念贱父子二人形影相附，别无子弟可将事者。","book":"明·李东阳《奉谦斋徐先生书》"},"similar":["相依为命"],"usage":"作谓语、定语；用于书面语"},{"id":17944,"word":"形影相随","pinyin":"xíng yǐng xiāng suí","abbr":"xyxs","explanation":"象形体和它的影子那样分不开。形容彼此关系亲密，经常在一起。","source":{"text":"登高回首罢，行影自相随。","book":"唐·崔峒《江山书怀》"},"example":{"text":"她们总是～，过了有好几个月，以后却渐渐的冷淡了下去。","book":"冰心《我们太太的客厅》"},"similar":["形影不离","难舍难分","如胶似漆"],"opposite":["水火不容","风流云散"],"usage":"作谓语、定语、状语；用于人"},{"id":17945,"word":"形影相顾","pinyin":"xíng yǐng xiāng gù","abbr":"xyxg","explanation":"象形体和它的影子那样分不开。形容彼此关系亲密，经常在一起。","source":{"text":"省之惋愕，不解所由，形影相顾，陨越无地。","book":"《晋书·桓温传》"},"example":{"text":"宋·陆游《与赵都大启》：“岁月不知其再周，～而自悼。”"},"similar":["形影相吊"],"usage":"作谓语、宾语、定语；指孤单"},{"id":17946,"word":"形影自吊","pinyin":"xíng yǐng zì diào","abbr":"xyzd","explanation":"形容无依无靠，非常孤单。同“形影相吊”。","source":{"text":"窃感《相鼠》之篇，无礼遄死之义，形影相吊，五情愧郝。","book":"三国·魏·曹植《上责躬应诏诗表》"},"example":{"text":"父自讷去，妻亦寻卒；块然一老鳏，～。","book":"清·蒲松龄《聊斋志异·张诚》"},"similar":["形影自守","形影相吊"],"usage":"作谓语、定语；指人孤单"},{"id":17947,"word":"形影自守","pinyin":"xíng yǐng zì shǒu","abbr":"xyzs","explanation":"指孤身独处。","source":{"text":"今白小姐人琴俱亡，小弟形影自守，决不负心而自求佳丽。","book":"清·荑荻散人《玉娇梨》第17回"},"similar":["形影自吊"],"usage":"作谓语、定语；指人孤单"},{"id":17948,"word":"形息名彰","pinyin":"xíng xī míng zhāng","abbr":"xxmz","explanation":"息：通“熄”，灭；彰：显扬。人死了，名声却显扬于世","source":{"text":"故古之人，身隐而功著，形息而名彰。","book":"战国·卫·吕不韦《吕氏春秋·上德》"},"usage":"作谓语、定语；用于书面语"},{"id":17949,"word":"形枉影曲","pinyin":"xíng wǎng yǐng qū","abbr":"xwyq","explanation":"东西的形状歪斜了，它的影子也就弯曲了。比喻有什么原因就会有什么结果。","source":{"text":"形枉则影曲，形直则影正。","book":"《列子·说符》"},"opposite":["形直影正"],"usage":"作谓语、定语；指因果关系"},{"id":17950,"word":"形格势制","pinyin":"xíng gé shì zhì","abbr":"xgsz","explanation":"格：阻碍；制：制约。指受形势的阻碍或限制，事情难于进行。","source":{"text":"夫解杂乱纷纠者不控捲，救斗者不搏戟，批亢捣虚，形格势禁，则自为解耳。","book":"《史记·孙子吴起列传》"},"example":{"text":"正额之输，上供之需，边疆之费，虽欲损毫厘不可得。～，莫可如何。","book":"《明史·贾三近传》"}},{"id":17951,"word":"形格势禁","pinyin":"xíng gé shì jìn","abbr":"xgsj","explanation":"格：阻碍；禁：制止。指受形势的阻碍或限制，事情难于进行。","source":{"text":"夫解杂乱纷纠者不控捲，救斗者不搏戟，批亢捣虚，形格势禁，则自为解耳。","book":"《史记·孙子吴起列传》"},"example":{"text":"他日经营戎素，有～之能，虽徙首都于关、洛可也。当今之时，岂暇仓猝离北京乎？","book":"章炳麟《驳黄兴主张南都电》"},"similar":["形禁势格"],"usage":"作谓语、定语；指事情难于进行"},{"id":17952,"word":"形槁心灰","pinyin":"xíng gǎo xīn huī","abbr":"xgxh","explanation":"槁：枯干。形容身体消瘦不堪，心境极为冷漠，毫无生气。","source":{"text":"今生已被虏，人被杀，儿孤妇寡，饥寒交迫，形槁心灰，虽生亦犹死也。","book":"清·钱泳《履园丛话·旧闻·席氏多贤》"},"usage":"作谓语、定语；用于书面语"},{"id":17953,"word":"形神不全","pinyin":"xíng shén bù quán","abbr":"xsbq","explanation":"形神：形象和精神。形象和精神不能保全。后泛指精神、形象不完美。","source":{"text":"士生乎鄙野，推选则禄焉，非不得尊遂也，然而形神不全。","book":"《呀国策·齐策四》"},"usage":"作谓语、定语；用于书面语"},{"id":17954,"word":"形神兼备","pinyin":"xíng shén jiān bèi","abbr":"xsjb","explanation":"形：外形，样子。神：精神，气质。兼备：全部具备。外部形象和内在精神都具备。","usage":"多用于褒义。"},{"id":17955,"word":"形禁势格","pinyin":"xíng jìn shì gé","abbr":"xjsg","explanation":"指受形势的阻碍或限制，事情难于进行。同“形格势禁”。","source":{"text":"形禁势格，利从近取，害以远隔。上火下泽。","book":"《三十六计·第二十三计·远交近攻》"},"example":{"text":"逆亮自知～，巢穴迥遥，恐狂谋无成窜身无所，故疾趣淮上，侥幸一胜，以谋溃中原之心而求归也。","book":"宋·辛弃疾《美芹十论·观衅》"},"similar":["形劫势禁","形格势禁"],"usage":"作谓语、定语；指事情难于进行"},{"id":17956,"word":"形而上学","pinyin":"xíng ér shàng xué","abbr":"xesx","explanation":"用孤立静止片面的观点看世界。","source":{"text":"一种是形而上学的见解，一种是辩证法的见解，形成了互相对立的两种宇宙观。","book":"毛泽东《矛盾论》"},"example":{"text":"～的做法是行不通的。"},"opposite":["实事求是"],"usage":"作主语、宾语、定语；用于哲学方面"},{"id":17957,"word":"形胜之国","pinyin":"xíng shèng zhī guó","abbr":"xszg","explanation":"形胜：地理形势优越。指地势优越的国家","source":{"text":"秦形胜之国，带河山之险，县险千里，持戟百万。","book":"西汉·司马迁《史记·高祖本纪》"},"similar":["形胜之地"],"usage":"作宾语；用于书面语"},{"id":17958,"word":"形胜之地","pinyin":"xíng shèng zhī dì","abbr":"xszd","explanation":"形胜：地势优越便利。指地理形势有利的地方。","source":{"text":"一夫荷戟，万夫趑趄，形胜之地，非亲勿居。","book":"《荀子·强国》：“其国险塞，形势便，山林川谷美，天材之利多，是形胜也。”晋·张载《剑阁铭》"},"example":{"text":"且关中～，希宪得民心，有商挺、赵良弼为之辅，此事宜关圣虑。","book":"《清·毕沅《续资治通鉴》卷一百七十七"},"usage":"作宾语；用于书面语"},{"id":17959,"word":"形色仓皇","pinyin":"xíng sè cāng huáng","abbr":"xsch","explanation":"动作匆忙，神色慌张。","example":{"text":"他～地离开办公室。"},"usage":"作谓语、定语、状语；指人的形态"},{"id":17960,"word":"形表影附","pinyin":"xíng biǎo yǐng fù","abbr":"xbyf","explanation":"形表：仪容表率；影附：影子附于形而不可分离。比喻人的品德堪为表率，人们对他形影不离，依附得很紧。","source":{"text":"于时缨緌之徒，绅珮之士，望形表而影附。","book":"汉·蔡邕《郭有道碑文》"},"usage":"作宾语、定语；用于书面语"},{"id":17961,"word":"形诸笔墨","pinyin":"xíng zhū bǐ mò","abbr":"xzbm","explanation":"形：描写；诸：“之于”的合音。用笔墨把它写出来。","source":{"text":"但若形诸笔墨，昭示读者，自以为得了这作品的魂灵，却未免象后街阿狗的妈妈。","book":"鲁迅《的“关”》"},"example":{"text":"但若～，昭示读者，自以为得了这作品的魂灵，，却未免象后街阿狗的妈妈。","book":"鲁迅《〈出关〉的“关”》"},"usage":"作谓语、定语；用于写作"},{"id":17962,"word":"形貌昳丽","pinyin":"xíng mào yì lì","abbr":"xmdl","explanation":"昳丽：神采焕发。容貌美丽","source":{"text":"邹忌修八尺有余，而形貌昳丽。","book":"西汉·刘向《战国策·齐策》"},"usage":"作谓语、定语；用于人的外表"},{"id":17963,"word":"形输色授","pinyin":"xíng shū sè shòu","abbr":"xsss","explanation":"指以举止、神态传递倾慕之情。多以形容男女相悦。","source":{"text":"一日见某部某郎，不觉倾倒，形输色授，颇难自持。","book":"清·梁绍壬《两般秋雨庵随笔·无题诗》"},"usage":"作谓语、定语；用于书面语"},{"id":17964,"word":"形迹可疑","pinyin":"xíng jì kě yí","abbr":"xjky","explanation":"举动和神色值得怀疑。","source":{"text":"邓以形迹可疑，故亦不敢告人，托之归宁而已。","book":"清·蒲松龄《聊斋志异·房文淑》"},"example":{"text":"贴在教务处骂他的纸条，确有点过火，但也是他～所致。","book":"鲁迅《两地书》一一"},"similar":["行迹可疑"],"usage":"作谓语、定语；指人的举动和神色"},{"id":17965,"word":"形销骨立","pinyin":"xíng xiāo gǔ lì","abbr":"xxgl","explanation":"销：消瘦。形容身体非常消瘦。","source":{"text":"帝形容本壮，及至都，销毁骨立。","book":"《南史·梁本纪》"},"example":{"text":"及放榜时，依然铩羽。生嗒丧而归，愧负知己，～，痴若木偶。","book":"清·蒲松龄《聊斋志异·叶生》"},"similar":["瘦骨嶙峋","瘦骨伶仃"],"opposite":["脑满肠肥","大腹便便"],"usage":"作谓语、定语、补语；指人很消瘦"},{"id":17966,"word":"形骸之外","pinyin":"xíng hái zhī wài","abbr":"xhzw","explanation":"形骸：身体；之外：意思是表现在外面，一看就看出来。人外在的肉体形貌。指身体表现出来的种种行为。","source":{"text":"吾与夫子游游十九年矣，而未尝知吾兀者也。今子与我游于形骸之内，则子索我于形骸之外，不亦过乎？","book":"《庄子·德充符》"},"example":{"text":"这事要相遇子心腹之间，相感于～，方是天下第一等人。","book":"清·吴敬梓《儒林外史》第三十回"}},{"id":17967,"word":"彤云密布","pinyin":"tóng yún mì bù","abbr":"tymb","explanation":"彤云：彤是红色的意思，有时指红霞;有时指下雪前均匀密布的阴云。很厚的云层布满天空，预示着大雪即将来临。","source":{"text":"上天同云，雨雪雰雰。","book":"《诗经·小雅·信南山》"},"example":{"text":"～，冷雾缤纷。","book":"明·许仲琳《封神演义》第八十九回"},"similar":["乌云密布"],"usage":"作谓语、定语；指乌云密布"},{"id":17968,"word":"彩云易散","pinyin":"cǎi yún yì sàn","abbr":"cyys","explanation":"美丽的彩云容易消散。比喻美满的姻缘被轻易拆散。","source":{"text":"唐·白居易《简简吟》：“苏家小女名简简，芙蓉花腮柳叶眼，……大都好物不坚牢，彩云易散琉璃脆。"},"example":{"text":"霁月难逢，～。心比天高，身为下贱。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["好景不长"],"opposite":["天长地久"],"usage":"作宾语、定语；指好景不长"},{"id":17969,"word":"彩凤随鸦","pinyin":"cǎi fèng suí yā","abbr":"cfsy","explanation":"凤：凤凰；鸦：乌鸦。美丽的凤鸟跟了丑陋的乌鸦。比喻女子嫁给才貌配不上好的人。","source":{"text":"杜大中起于行伍，妾能词，有‘彩凤随鸦’之句，杜怒曰：‘鸦且打凤’。","book":"宋·祝穆《事文类聚》"},"example":{"text":"自从加克娶了姑娘，人人都道～，不免纷纷议论。","book":"清·曾朴《孽海花》第十六回"},"similar":["嫁鸡随鸡"],"usage":"作谓语、定语、宾语；比喻淑女嫁鄙男"},{"id":17970,"word":"彩笔生花","pinyin":"cǎi bǐ shēng huā","abbr":"cbsh","explanation":"比喻才思有很大的进步。","source":{"text":"翠袖分香行处有，彩笔生花梦境熟。","book":"元·汤式《赏花时·戏贺友人新娶》"},"example":{"text":"他也想有“～”的时候。"},"similar":["梦笔生花"],"usage":"作主语、定语；指人的文笔","story":["唐代大诗人李白一生做过不少诗篇，相传他年轻时文笔并不十分流畅，做一首诗有时要花一个月时间。他曾经做过一个梦，梦到自己曾经使用过的毛笔笔头上生长出花朵来，从那以后才思敏捷，作品源源不断，而且经常是一挥而就"]},{"id":17971,"word":"彩衣娱亲","pinyin":"cǎi yī yú qīn","abbr":"cyyq","explanation":"传说春秋时有个老莱子，很孝顺，七十岁了有时还穿着彩色衣服，扮成幼儿，引父母发笑。后作为孝顺父母的典故。","source":{"text":"老莱子孝养二亲，行年七十，婴儿自娱，着五色彩衣，尝取浆上堂，跌仆，因卧地为小儿蹄，或美鸟鸟于亲侧。","book":"汉·刘向《列女传》"},"example":{"text":"戏彩娱亲，老莱子之孝。","book":"明·程登吉《幼学琼林·祖孙父子》"},"similar":["老莱娱亲"],"usage":"作宾语、定语；指孝顺父母","story":["春秋时期，楚国隐士老莱子非常孝顺父母，想尽一切办法讨父母的欢心，使他们健康长寿。他70岁时父母还健在，为了不让父母见他有白发而伤感，他做一套五彩斑斓的衣服穿在身上，走路时装成小儿跳舞的样子使父母高兴"]},{"id":17972,"word":"彪形大汉","pinyin":"biāo xíng dà hàn","abbr":"bxdh","explanation":"彪：小老虎，比喻躯干壮大；汉：男子。身材高大、结实的男子。","source":{"text":"只见外面走入个彪形大汉来，喝道：‘你这黑厮好大胆！谁开的酒店，你来白吃不肯还钱！’","book":"明·施耐庵《水浒全传》第六十七回"},"example":{"text":"金奎也选了二十名～，教他们十八般武艺。","book":"清·吴趼人《痛史》第十一回"},"similar":["五大三粗","身高马大","孔武有力"],"opposite":["弱不禁风","质似薄柳","瘦骨伶仃"],"usage":"作主语、宾语；形容人凶恶的样子"},{"id":17973,"word":"彪炳千古","pinyin":"biāo bǐng qiān gǔ","abbr":"bbqg","explanation":"形容伟大的业绩流传千秋万代。","source":{"text":"晋弘农太守郭璞诗，宪章潘岳，文体相辉，彪炳可玩。","book":"南朝·梁·钟嵘《诗品》卷中"},"similar":["彪炳日月"],"usage":"作谓语、定语；指人的功绩"},{"id":17974,"word":"彪炳日月","pinyin":"biāo bǐng rì yuè","abbr":"bbry","explanation":"彪炳：照耀。形容伟大的业绩照耀千秋万代。","source":{"text":"那史册彪炳日月的事业，全是这两眶子不叫人知的暗泪做出来。","book":"清·李绿园《歧路灯》第87回"},"similar":["彪炳千古"],"usage":"作谓语、定语；指人的功绩"},{"id":17975,"word":"彫章镂句","pinyin":"diāo zhāng lòu jù","abbr":"dzlj","explanation":"指刻意雕琢词章。"},{"id":17976,"word":"彫肝琢肾","pinyin":"diāo gān zhuó shèn","abbr":"dgzs","explanation":"形容苦心琢磨。","source":{"text":"劝君韬养待征招，不用雕琢愁肝肾。","book":"语出唐·韩愈《赠崔立之评事》诗"}},{"id":17977,"word":"彫虫小技","pinyin":"diāo chóng xiǎo jì","abbr":"dcxj","explanation":"指刻意雕琢词章的微小技能。"},{"id":17978,"word":"彫虫篆刻","pinyin":"diāo chóng zhuàn kè","abbr":"dczk","explanation":"虫书、刻符分别为秦书八体之一，西汉时蒙童所习。以之喻词章小技。"},{"id":17979,"word":"彬彬文质","pinyin":"bīn bīn wén zhì","abbr":"bbwz","explanation":"彬彬：配合谐调。原形容人既文雅又朴实，后形容人文雅有礼貌。","source":{"text":"知本末，重纲常，彬彬文质好行藏。","book":"明·胡文焕《群音类选·》"},"similar":["文质彬彬","文质斌斌"],"opposite":["出言不逊"],"usage":"作谓语、定语、补语；用于男性"},{"id":17980,"word":"彬彬有礼","pinyin":"bīn bīn yǒu lǐ","abbr":"bbyl","explanation":"彬彬：原意为文质兼备的样子，后形容文雅。形容文雅有礼貌的样子。","source":{"text":"叔孙通定礼仪，则文学彬彬稍进。","book":"《史记·太史公自序》"},"example":{"text":"唤出他两个儿子，兄先弟后，～。","book":"清·李汝珍《镜花缘》第八十三回"},"similar":["温文尔雅","落落大方","文质彬彬"],"opposite":["丑态百出","出言不逊","蛮横无理"],"usage":"作谓语、状语、补语；形容人有礼貌"},{"id":17981,"word":"彬彬济济","pinyin":"bīn bīn jǐ jǐ","abbr":"bbjj","explanation":"形容人才盛多的样子。","source":{"text":"而目前由学塾以升入学院教育者彬彬济济，于工艺之道无不各造精微，此皆广设书院教育得宜之有效也。","book":"郑观应《盛世危言·技艺》"},"example":{"text":"其时天潢之英，从龙之彦，～，颇不乏才。","book":"梁启超《中国积弱溯源论》第四节"},"usage":"作谓语；指人才众多"},{"id":17982,"word":"彭泽横琴","pinyin":"péng zé héng qín","abbr":"pzhq","explanation":"陶渊明摆了一张无弦琴。比喻志趣高雅不俗。","example":{"text":"你还是不要学～。"},"usage":"作宾语、定语；指人的志趣","story":["东晋时期著名的文学家陶渊明由于看不惯官场的腐败，毅然不为五斗米而折腰，辞去彭泽县令，回到家乡自耕自食。他喜欢种植菊花，爱好喝酒，同时也喜欢弹琴。他家摆了一张没有标注符号的素琴，他边弹边说：但识琴中趣，何老弦上声"]},{"id":17983,"word":"彰善瘅恶","pinyin":"zhāng shàn dàn è","abbr":"zsde","explanation":"彰：表明、显扬；瘅：憎恨。表扬好的，斥责恶的。","source":{"text":"彰善瘅恶，树之风声。","book":"《尚书·毕命》"},"example":{"text":"江东既平，天下既一，偃武修文，～，崇教化，移风俗。","book":"宋·陈亮《酌古论·诸葛孔明》"},"similar":["惩恶扬善"],"usage":"作谓语、定语；指人的情绪"},{"id":17984,"word":"彰彰在目","pinyin":"zhāng zhāng zài mù","abbr":"zzzm","explanation":"彰彰：非常明显。十分明显地摆在眼前，不容隐瞒。","example":{"text":"他的文物历史的研究成～，成就斐然。"}},{"id":17985,"word":"彰往察来","pinyin":"zhāng wǎng chá lái","abbr":"zwcl","explanation":"指记载往事不使湮灭，据以考察未来。","source":{"text":"夫《易》彰往而察来，而微显阐幽。","book":"《周易·系辞下》"},"similar":["彰往考来"],"usage":"作谓语、定语；用于书面语"},{"id":17986,"word":"彰往考来","pinyin":"zhāng wǎng kǎo lái","abbr":"zwkl","explanation":"指彰明往事，考察未来。","source":{"text":"彰往，表明往事也。察来，观察来事也。","book":"语本《易·系辞下》：“夫《易》彰往而察来，而微显阐幽。”孔颖达疏：“往事必载，是彰往也；来事豫占，是察来也。”高亨注"},"example":{"text":"若夫制作之文，所以～，情见乎辞。","book":"晋·杜预《〈春秋经传集解〉序》"},"similar":["彰往察来"],"usage":"作谓语、定语；用于书面语"},{"id":17987,"word":"彰徨不定","pinyin":"zhāng huáng bǔ dìng","abbr":"zhbd","explanation":"惊慌恐惧，心神不定的样子。","source":{"text":"彰徨不定，载肥载臞。","book":"《抱朴子·正郭》"}},{"id":17988,"word":"彰明昭着","pinyin":"zhāng míng zhāo zhe","abbr":"zmzz","explanation":"犹彰明较着。指事情或道理极其明显。"},{"id":17989,"word":"彰明昭著","pinyin":"zhāng míng zhāo zhù","abbr":"zmzz","explanation":"犹彰明较著。","source":{"text":"这个名目，叫做‘卖疯’，却是背着人在外面暗做的，没有彰明昭著在自己家里做的。","book":"清·吴研人《二十年目睹之怪现状》第六十回"},"example":{"text":"他们开始时，暗地里偷窃，随后就～地任意抢夺。","book":"冯至《伍子胥·昭关》"},"similar":["彰明较著"],"usage":"作谓语、定语、状语；用于书面语"},{"id":17990,"word":"彰明较着","pinyin":"zhāng míng jiào zhù","abbr":"zmjz","explanation":"指事情或道理极其明显。","source":{"text":"是遵何德哉？此其尤大彰明较著者也。","book":"西汉·司马迁《史记·伯夷列传》"},"example":{"text":"所言革命为假革命，已～矣。","book":"孙中山《敬告同乡书》"}},{"id":17991,"word":"彰明较著","pinyin":"zhāng míng jiào zhù","abbr":"zmjz","explanation":"彰、明、较、著：都是明显的意思。指事情或道理极其明显，很容易看清。","source":{"text":"此其尤大彰明较著者也。","book":"《史记·伯夷列传》"},"example":{"text":"盛昱甚至在严劾崇厚的奏折上，～地指出，沈桂芬应该联带负责。","book":"高阳《清宫外史》上册"},"similar":["显而易见","昭然若揭"],"opposite":["模棱两可","语焉不详"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":17992,"word":"影不离灯","pinyin":"yǐng bù lí dēng","abbr":"ybld","explanation":"影子离不开灯光。没有灯光就看不到影子。比喻两者联系紧密","source":{"text":"这老张婆子影不离灯的一般，又不是外头宽快去外，支了他那里去？","book":"《醒世姻缘》第43回"},"usage":"作宾语、定语；用于比喻句"},{"id":17993,"word":"影从云集","pinyin":"yǐng cóng yún jí","abbr":"ycyj","explanation":"如影形随，如云聚集。形容追随者众多，天下纷纷响应。","source":{"text":"且天下诸侯景从云集，随大王以伐无道，其爱戴之心，盖有自也。","book":"明·许仲琳《封神演义》第九十八回"}},{"id":17994,"word":"影单形只","pinyin":"yǐng dān xíng zhī","abbr":"ydxz","explanation":"只：单独；形：身体。只有自己的身体和自己的影子。形容孤独，没有同伴。","source":{"text":"承先人后者，在孙惟汝，在子惟吾，两世一身，形单影只。","book":"唐·韩愈《祭十二郎文》"},"example":{"text":"因得常哭于芸娘之墓，～，备极凄凉，且偶经故居，伤心惨目。","book":"清·沈复《浮生六记·坎坷记愁》"},"similar":["形只影单","形单影单","形单影只"],"opposite":["前呼后拥","门庭若市"],"usage":"作谓语、定语；指孤独"},{"id":17995,"word":"影只形单","pinyin":"yǐng zhī xíng dān","abbr":"yzxd","explanation":"犹形单影只。只有自己的身体和自己的影子。形容孤独，没有同伴。","source":{"text":"［生］非是我要埋冤，只愁他影只形单，我出去有谁看管。","book":"元·高明《琵琶记》第五出"},"example":{"text":"儿死之后,这五房媳妇自然～，倘有不到之处，望两大人善言教导他们，孩儿虽死亦瞑目矣。","book":"《青楼梦》第三十二回"},"similar":["形单影只","影只形孤"],"usage":"作谓语、定语、状语；指孤独"},{"id":17996,"word":"影只形孤","pinyin":"yǐng zhī xíng gū","abbr":"yzxg","explanation":"犹形单影只。只有自己的身体和自己的影子。形容孤独，没有同伴。","source":{"text":"膝下红颜，须代冬温夏清；眼前白发，况兼影只形孤。","book":"明·陈汝元《金莲记捷报》"},"similar":["影只形单","形单影只"],"opposite":["出双入对"],"usage":"作谓语、定语、状语；指孤独"},{"id":17997,"word":"影响之见","pinyin":"yǐng xiǎng zhī jiàn","abbr":"yxzj","explanation":"形容道听途说，没有确实根据的言谈说法。","source":{"text":"又，周江右人，率多土音，去中原甚远，未必字字订过。是欲凭影响之见，以著为不刊之典，安保其无离而不叶于正者哉。","book":"明·王骥德《方诸馆曲律·论韵第七》"}},{"id":17998,"word":"影响之谈","pinyin":"yǐng xiǎng zhī tán","abbr":"yxzt","explanation":"形容道听途说，没有确实根据的言谈说法。","source":{"text":"如今韩生吉帖婚书，并无一毫虚谬；那程元却都是些影响之谈。","book":"明·凌濛初《初刻拍案惊奇》卷十"}},{"id":17999,"word":"影形不离","pinyin":"yǐng xíng bù lí","abbr":"yxbl","explanation":"形影不离，比喻关系密切。","source":{"text":"他的面貌、服装比赵子曰的好看的不止十倍，可是他们两个是影形不离的好朋友。","book":"老舍《赵子曰》"},"similar":["形影不离"],"usage":"作谓语、定语、状语；指关系密切"},{"id":18000,"word":"影影绰绰","pinyin":"yǐng yǐng chuò chuò","abbr":"yycc","explanation":"模模糊糊，不真切。","source":{"text":"我不知怎的，但没人在房里，心里只害怕，恰似影影绰绰，有人在眼前一般。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"},"example":{"text":"宝玉一见，喜得赶出来，但见鸳鸯在前，～的走，只是赶不上。（清·曹雪芹《红楼梦》第一百十六回）"},"similar":["模模糊糊"],"opposite":["清清楚楚"],"usage":"作谓语、定语；形容不真切"},{"id":18001,"word":"影灭迹绝","pinyin":"yǐng miè jì jué","abbr":"ymjj","explanation":"影子、痕迹都消失了。","source":{"text":"人性有畏其影而恶其迹者，却背而走无益也，不知就阴而止，影灭迹绝。","book":"汉·刘向《说苑·正谏》"},"example":{"text":"一日过其门探察之，已另有吴客僦居其中，颠当子母迁去已久，～，莫可问讯。","book":"清·蒲松龄《聊斋志异·嫦娥》"}},{"id":18002,"word":"影迹无端","pinyin":"yǐng jì wú duān","abbr":"yjwd","explanation":"指没有任何踪迹和缘由来寻衅闹事。","source":{"text":"今影迹无端，假谤空设，终古之酷，未之或有。","book":"《宋书·谢灵运传》"}},{"id":18003,"word":"影骇响震","pinyin":"yǐng hài xiǎng zhèn","abbr":"yhxz","explanation":"看到影子或听到声音都感到害怕震惊。","source":{"text":"卒不能摅首尾，奋翼鳞，振拔洿涂，跨腾风云，使见之者影骇，闻之者响震。","book":"汉·班固《答宾戏》"}},{"id":18004,"word":"彷徨四顾","pinyin":"páng huáng sì gù","abbr":"phsg","explanation":"彷徨：徘徊，游移不定。游移不定，四处观望。形容犹豫不决的神情。","source":{"text":"数日之间，众未及聚，谋未及生，彷徨四顾，而莫知所以为御。","book":"宋·陈亮《酌古论四·崔浩》"},"similar":["彷徨歧途","犹豫不决"],"usage":"作谓语、定语；指犹豫不决"},{"id":18005,"word":"彷徨歧途","pinyin":"páng huáng qí tú","abbr":"phqt","explanation":"犹犹豫豫怕走上岔道。","source":{"text":"他～，最终还是误入歧途。"},"example":{"text":"他～，最终还是误入歧途"},"usage":"作谓语、定语；指担心走错路"},{"id":18006,"word":"彻上彻下","pinyin":"chè shàng chè xià","abbr":"cscx","explanation":"彻：贯通。贯通上下。","source":{"text":"居处恭，执事敬，与人忠，此是彻上彻下语。","book":"《二程遗书·遗书一》：“夫彻上彻下，不过如此。”宋·朱熹《答近思录集注》卷四"},"example":{"text":"神韵者，～，无所不该。","book":"清·翁方纲《神韵论上》"},"similar":["承上启下"],"usage":"作谓语、定语；指通达上下"},{"id":18007,"word":"彻内彻外","pinyin":"chè nèi chè wài","abbr":"cncw","explanation":"指完完全全。","source":{"text":"到了你们这一代就不同了，你们根本就没有受过烙印，所以你们的诗，彻内彻外，都是自己作主人。","book":"郭沫若《屈原》第二幕"},"similar":["彻里至外","彻里彻外"],"usage":"作状语；指完完全全"},{"id":18008,"word":"彻头彻尾","pinyin":"chè tóu chè wěi","abbr":"ctcw","explanation":"彻：通，透。从头到尾，全部，十足的意思。","source":{"text":"近日学者说得太高了，意思都不确实，不曾见理会得一书一事，彻头彻尾。","book":"宋·朱熹《答胡季随书》"},"example":{"text":"他是个～的机会主义者。"},"similar":["彻里彻外","彻上彻下","彻心彻骨"],"opposite":["七扣八扣"],"usage":"作定语、状语；用于人的思想等"},{"id":18009,"word":"彻底澄清","pinyin":"chè dǐ chéng qīng","abbr":"cdcq","explanation":"彻底：水清见底，引申为透彻。形容为官十分廉洁，清白。也指彻底清查，无所隐匿。","source":{"text":"今后，方信你彻底澄清，我好没来由。","book":"元·高明《琵琶记·牛氏规奴》"},"example":{"text":"着即巡按浙江等处地方，克期赴任，务期～，以昭平允。","book":"清·夏纶《杏花村·代狩》"},"similar":["澈底澄清"],"opposite":["遮遮掩掩"],"usage":"作谓语；用于调查等"},{"id":18010,"word":"彻心彻骨","pinyin":"chè xīn chè gǔ","abbr":"cxcg","explanation":"彻：通、透。通心透骨。形容疼痛达到了极点。","source":{"text":"那兵士手脚被吊得彻心彻骨的痛，厉声哀叫。","book":"方志敏《可爱的中国》"},"similar":["彻骨痛心"],"usage":"作定语、状语；指疼痛等"},{"id":18011,"word":"彻里彻外","pinyin":"chè lǐ chè wài","abbr":"clcw","explanation":"①从里到外。②犹言完完全全。","source":{"text":"[张都监]又叫裁缝与武松彻里彻外做秋衣。","book":"《水浒传》第三十回"},"example":{"text":"现在许多人在提倡民族化、科学化、大众化了，这很好，但是‘化’者，彻头彻尾～之谓也。","book":"毛泽东《反对党八股》"},"similar":["彻头彻尾","彻内彻外"],"usage":"作状语；指完完全全"},{"id":18012,"word":"彻里至外","pinyin":"chè lǐ zhì wài","abbr":"clzw","explanation":"指从里到外。","source":{"text":"[柴进]叫庄客取一笼衣裳出来，叫林冲彻里至外都换了。","book":"《水浒传》第十一回"},"similar":["彻里彻外","彻内彻外"],"usage":"作状语；指完完全全"},{"id":18013,"word":"彻首彻尾","pinyin":"chè shǒu chè wěi","abbr":"cscw","explanation":"彻：通，透。从头到尾，全部，十足的意思。","source":{"text":"今此于既学适道之后却言笃信何也？恐信字彻首彻尾不可分先后。","book":"宋·朱熹《答陈安卿书》"},"example":{"text":"他是一个～的坏蛋。"},"similar":["彻头彻尾"],"usage":"作定语、状语；用于人的思想等"},{"id":18014,"word":"彼一时，此一时","pinyin":"bǐ yī shí，cǐ yī shí","abbr":"byscys","explanation":"那是一个时候，现在又是一个时候。表示时间不同，情况有了变化。","source":{"text":"彼一时，此一时也。五百年必有王者兴，其间必有名世者。","book":"《孟子·公孙丑下》"},"example":{"text":"～。他如今在天上，我得收拾门下，免死沟壑，便为万幸了，还敢妄言甚么。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["时过境迁","事过境迁"],"usage":"作谓语、分句；形容时势不同，情况不同","story":["战国时期，燕王哙把政权交给宰相子之，从而发生内乱，齐国趁机出兵燕国抢占土地。孟子极力主张出兵，要燕王给齐王称臣，从而推行仁政。但齐王却只看见燕国的土地与财富。孟子的学生充虞十分不满。孟子感慨地说：“彼一时，此一时也。”"]},{"id":18015,"word":"彼亦一是非，此亦一是非","pinyin":"bǐ yì yī shì fēi，cǐ yì yī shì fēi","abbr":"byysfcyysf","explanation":"那也是一种是非，这也是一种是非。比喻说话圆滑，不得罪人。","source":{"text":"是亦彼也，彼亦是也。彼亦一是非，此亦一是非。","book":"战国·宋·庄周《庄子·齐物论》"},"example":{"text":"不加考察，不加批评，但用‘～’的论调，将一切作者诋为‘一丘之貉’。","book":"鲁迅《中国文坛的悲观》"},"usage":"作定语、分句；指标准不一"},{"id":18016,"word":"彼众我寡","pinyin":"bǐ zhòng wǒ guǎ","abbr":"bzwg","explanation":"彼：对方。指对方军队势众，而我方力量单薄。","source":{"text":"晋文公将与楚人战，召舅犯问之曰：‘吾将与楚人战，彼众我寡，为之奈何？’","book":"《韩非子·难一》"},"example":{"text":"～，不宜久持，何不用火攻之？”（明·罗贯中《三国演义》第四十五回","book":"盖曰"},"similar":["敌众我寡"],"usage":"作宾语、定语；用于战争、局势等","story":["楚国纠合曹、卫进攻宋国，宋国向晋文公求救，先轸认为是成霸业的大好时机，晋文公向舅父狐偃讨教如何对付彼众我寡的战争，狐偃教他使用诈伪取胜，雍季不同意如此。晋文公派狐偃为上军统帅，进攻曹、卫，楚王中计而大败"]},{"id":18017,"word":"彼何人斯","pinyin":"bǐ hé rén sī","abbr":"bhrs","explanation":"斯：助词，相当于现代汉语中的“啊”。他是个什么人啊。","source":{"text":"彼何人斯，其心孔艰。","book":"《诗经·小雅·何人斯》"},"example":{"text":"昆季让肥，义能感贼，贼尚能感，～，～，无所感之。","book":"清·张岱《让肥操》"},"usage":"作分句；用于轻蔑口气"},{"id":18018,"word":"彼倡此和","pinyin":"bǐ chàng cǐ hè","abbr":"bcch","explanation":"和：附和；应和。比喻一方倡导，别一方效法；或互相配合，彼此呼应。","source":{"text":"二人先通了郤克，然后谒见晋景公，内外同心，彼倡此和，不由晋景公不从。","book":"明·冯梦龙《东周列国志》第五十六回"},"similar":["彼唱此和"],"usage":"作谓语、定语、状语；指彼此呼应"},{"id":18019,"word":"彼哉彼哉","pinyin":"bǐ zāi bǐ zāi","abbr":"bzbz","explanation":"他呀，他呀！鄙视之辞，表示此人不足挂齿。","source":{"text":"车丞相即周、鲁之列，当轴处中，括囊不言，容身而去，彼哉彼哉！","book":"汉·桓宽《盐铁论·杂论》"},"usage":"作谓语、定语；用于鄙视人"},{"id":18020,"word":"彼唱此和","pinyin":"bǐ chàng cǐ hè","abbr":"bcch","explanation":"比喻一方倡导，另一方效仿。","source":{"text":"仕者日坏于上，学者日坏于下，彼唱此和，靡然成风。","book":"《明史·刘世龙传》"},"similar":["此唱彼和"],"usage":"作谓语、定语、宾语；同“此唱彼和”"},{"id":18021,"word":"彼弃我取","pinyin":"bǐ qì wǒ qǔ","abbr":"bqwq","explanation":"别人不要的我拿来。形容不与世人共逐名利而甘于淡泊。","source":{"text":"彼弃我取，与时而无争。","book":"晋·皇甫谧《高士传·任安》"},"example":{"text":"彼一时，此一时"},"similar":["人弃我取"],"opposite":["人取我与"],"usage":"作宾语、定语、分句；指与众不同"},{"id":18022,"word":"彼此一样","pinyin":"bǐ cǐ yī yàng","abbr":"bcyy","explanation":"指两者完全一样。","example":{"text":"我们～，没有什么可笑的。"},"similar":["彼此彼此"],"opposite":["天差地别"],"usage":"作谓语、定语；指两者差不多"},{"id":18023,"word":"彼此彼此","pinyin":"bǐ cǐ bǐ cǐ","abbr":"bcbc","explanation":"常用做客套话，表示大家一样。亦指两者比较差不多。","source":{"text":"正说着话，济公进来。周员外连忙举手抱拳说：‘圣僧久违。’和尚说：‘彼此彼此。’","book":"清·郭小亭《济公全传》第一二二回"},"example":{"text":"大家彼此彼此，没有什么区别。"},"similar":["彼此一样"],"opposite":["天差地别"],"usage":"作谓语；指两者差不多，常用于客套话","story":["战国时期，梁惠王很喜欢与别国打仗，闹得民怨沸腾。梁惠王不解，问孟子为什么士兵在有吃有穿的情况下还要逃跑导致人口下降。孟子告诉他战争的危害性，要治理好国家，战争与不给人民衣食一样影响社会的繁荣安定"]},{"id":18024,"word":"彼竭我盈","pinyin":"bǐ jié wǒ yíng","abbr":"bjwy","explanation":"彼：他，对方；竭：尽；盈：充满。他们的勇气已丧失，我们的士气正旺盛。","source":{"text":"夫战，勇气也。一鼓作气，再而衰，三而竭。彼竭我盈，故克之。","book":"《左传·庄公十年》"},"example":{"text":"文中……叙述了利于开始反功的时机——～之时。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["敌疲我扰"],"opposite":["迎风而行"],"usage":"作谓语、定语；用于战争等"},{"id":18025,"word":"往古来今","pinyin":"wǎng gǔ lái jīn","abbr":"wglj","explanation":"指自古至今。","source":{"text":"往古来今谓之宙，四方上下谓之宇。","book":"西汉·刘安《淮南子·齐俗训》"},"example":{"text":"恰如冢中的白骨，～，总要以它的永久来傲视少女颊上的轻红似的。","book":"鲁迅《三闲集·怎么写》"},"similar":["自古至今","古往今来"],"usage":"作状语；指自古至今"},{"id":18026,"word":"往哲是与","pinyin":"wǎng zhé shì yǔ","abbr":"wzsy","explanation":"往哲：先哲，前贤；与：赞许。古代圣贤所赞许的。","source":{"text":"夫迷涂知反，往哲是与；不远而复，先典攸高。","book":"南朝·梁·丘迟《与陈伯之书》"}},{"id":18027,"word":"往日无仇，近日无冤","pinyin":"wǎng rì wú chóu，jìn rì wú yuān","abbr":"wrwcjrwy","explanation":"往日：过去；近日：现在；仇：仇恨；冤：怨恨。过去没有仇恨现在也没有怨恨。指彼此一向没有冤仇。","source":{"text":"你和公孙杵臼往日无仇，近日无冤，你因何告他藏着赵氏孤儿？","book":"元·纪君祥《赵氏孤儿》第三折"},"example":{"text":"我与你二位，～。你二位如何救得小人，生死不忘！","book":"明·施耐庵《水浒全传》第七回"}},{"id":18028,"word":"往日无冤，近日无仇","pinyin":"wǎng rì wú yuān，jìn rì wú chóu","abbr":"wrwyjrwc","explanation":"俗语。指从未有过冤仇。","example":{"text":"我与你～，你为什么要这样对我。"},"usage":"作谓语、定语；多用于口语"},{"id":18029,"word":"往来如梭","pinyin":"wǎng lái rú suō","abbr":"wlrs","explanation":"梭：织布时迁引纬线在经线中来回穿织的工具。来来去去象穿梭一样。形容来去频繁。","source":{"text":"雷震子观看，只见稀奇景致，雅韵幽栖，藤缠桧柏，竹插颠崖，狐兔往来如梭，鹿鹤唳鸣前后，见了些灵芝隐绿草，梅子在青枝，看不尽山中异景。","book":"明·许仲琳《封神演义》第二十一回"},"example":{"text":"宕中以大船为经，小船为纬，游冶子弟，轻舟鼓吹，～。","book":"明·张岱《陶庵梦忆·硚园》"}},{"id":18030,"word":"往渚还汀","pinyin":"wǎng zhǔ huán tīng","abbr":"wzht","explanation":"指往返都须渡水。"},{"id":18031,"word":"往者不可谏，来者犹可追","pinyin":"wǎng zhě bù kě jiàn，lái zhě yóu kě zhuī","abbr":"wzbkjlzykz","explanation":"往者：过去的事；谏：规劝；来者：未来的事；犹：还；追：赶上。过去的不能挽回弥补，未来的还是能赶得上的。后多用作鼓励之辞。","source":{"text":"楚狂接舆歌而过孔子曰：‘凤兮凤兮，何德之哀！往者不可谏，来者犹可追。已而，已而！今之从政者殆而！’","book":"《论语·微子》"},"example":{"text":"平生惯领虚思，大率类此，～，愿夫子有以站过焉。","book":"清·袁枚《病中谢尹相国赐食物》"}},{"id":18032,"word":"往者不谏，来者可追","pinyin":"wǎng zhě bù jiàn，lái zhě kě zhuī","abbr":"wzbjlzkz","explanation":"往者：过去的事；谏：规劝；来者：未来的事；犹：还；追：赶上。过去的不能挽回弥补，未来的还是能赶得上的。后多用作鼓励之辞。","source":{"text":"楚狂接舆歌而过孔子曰：‘凤兮凤兮，何德之哀！往者不可谏，来者犹可追。已而，已而！今之从政者殆而！’","book":"《论语·微子》"}},{"id":18033,"word":"往蹇来连","pinyin":"wǎng jiǎn lái lián","abbr":"wjll","explanation":"指往来皆难；进退皆难。","source":{"text":"六四：往蹇来连。","book":"《周易·蹇》"},"example":{"text":"南朝·梁·刘勰《文心雕龙·声律》：“迂其际会，则～，其为疾病，亦文家之吃也。”"},"similar":["进退两难"],"usage":"作谓语、定语；用于处事"},{"id":18034,"word":"往返徒劳","pinyin":"wǎng fǎn tú láo","abbr":"wftl","explanation":"徒劳：白花力气。来回白跑。","source":{"text":"大夫今日见谕，公则公言之，私则私言之，不必效舌剑唇枪，徒劳往返耳。","book":"明·许仲琳《封神演义》第五十六回"}},{"id":18035,"word":"征名责实","pinyin":"zhēng míng zé shí","abbr":"zmzs","explanation":"指考察其名以求其实，就其言而观其行，以求名实相符。亦作“循名责实”。","source":{"text":"方欲仗兹舟楫，委成股肱，征名责实，取宁多士。","book":"《陈书宣帝纪》"},"similar":["循名责实"],"usage":"作谓语、宾语；用于书面语"},{"id":18036,"word":"征敛无度","pinyin":"zhēng liǎn wú dù","abbr":"zlwd","explanation":"征：征收。敛：聚。指统治者无限度地强征捐税，搜刮百姓财富。亦作“征敛无期”。","source":{"text":"南阳户口数百万，而术奢淫肆欲，征敛无度，百姓苦之。","book":"《三国志·魏志·袁术传》"},"similar":["征敛无期"],"usage":"作谓语、定语；用于书面语"},{"id":18037,"word":"征敛无期","pinyin":"zhēng liǎn wú qī","abbr":"zlwq","explanation":"征：征收。敛：聚。指统治者无限度地强征捐税，搜刮百姓财富。","source":{"text":"上不顺天，下不惠民，征敛无期，求索无厌，罪杀不辜，庆赏不当。","book":"《吕氏春秋·怀宠》"},"similar":["征敛无度"],"usage":"作谓语、定语；用于书面语"},{"id":18038,"word":"征贵征贱","pinyin":"zhēng guì zhēng jiàn","abbr":"zgzj","explanation":"征：征兆。征贵：涨价的征兆；征贱：跌价的征兆。指价格波动的征兆。","source":{"text":"人各任其能，竭其力，以得所欲；故物贱之征贵，贵之征贱。","book":"西汉·司马迁《史记·货殖列传序》"},"usage":"作宾语、定语；指价格波动的征兆"},{"id":18039,"word":"征风召雨","pinyin":"zhēng fēng zhào yù","abbr":"zfzy","explanation":"征：征召，召唤。呼唤风雨。形容神通广大，具有支配自然神灵的法力。","source":{"text":"而蚩尤幻变多方，征风召雨，吹烟喷雾，师众大迷。","book":"晋·桓驎《西王母传》"}},{"id":18040,"word":"径一周三","pinyin":"jìng yī zhōu sān","abbr":"jyzs","explanation":"径：圆的半径；周：圆的周长。即圆的半径与圆的周长比为1：3，比喻两者相差很远。","source":{"text":"圆径一而周三。","book":"《周髀算经》上卷：“勾股圆方图。”汉·赵爽注"},"example":{"text":"即使寻到一点光明，‘～’，却更分明的看见了周围的无涯际的黑暗。","book":"鲁迅《且介亭杂文二集·小说二集序》"},"similar":["大相径庭"],"usage":"作谓语、宾语；指差距大"},{"id":18041,"word":"径廷之辞","pinyin":"jìng tíng zhī cí","abbr":"jtzc","explanation":"径廷：即“径庭”，门外路和堂外地，指相距极远；辞：话语。相相去甚远的偏激的廉洁。","source":{"text":"如使仁而无择，奚为修善立名乎？斯径廷之辞也。","book":"南朝·齐·刘峻《辨命论》"}},{"id":18042,"word":"径情直行","pinyin":"jìng qíng zhí xíng","abbr":"jqzx","explanation":"随着意愿，顺利地得到成功。","source":{"text":"夫义，节欲而治，礼，反情而辨者也。故君子径情而行也。","book":"《歇冠子·著希》"},"example":{"text":"为今之计，保全权利之心，万不可无，而轻躁寡谋，～之事，尤当痛戒。","book":"勇立《论排外不宜有形迹》"},"similar":["径情直遂"],"usage":"作宾语；同“径情直行”"},{"id":18043,"word":"径情直遂","pinyin":"jìng qíng zhí suì","abbr":"jqzs","explanation":"径情：任意，随心；遂：成功。随着意愿，顺利地得到成功。","source":{"text":"故君子弗径情而行也。","book":"《鹖冠子·著希》"},"example":{"text":"事物是往返曲折的，不是～的。","book":"毛泽东《论持久战》"},"similar":["一帆风顺","天从人愿","直情径行"],"opposite":["好事多磨","艰难曲折","荆棘载途"],"usage":"作宾语、定语；指满足自己的心愿"},{"id":18044,"word":"径行直遂","pinyin":"jìng xíng zhí suí","abbr":"jxzs","explanation":"随心愿行事而顺利达到目的。","source":{"text":"有直情而径行者，戎狄之道也。","book":"语出《礼记·檀弓下》"},"example":{"text":"观此可见守节之难，所以朝廷不设再谯之禁，与其慕虚名而贻中冓羞，不若～之为愈也。","book":"清·程麟《此中人语·守节》"},"usage":"作宾语、定语；指人办事"},{"id":18045,"word":"待人接物","pinyin":"dài rén jiē wù","abbr":"drjw","explanation":"物：人物，人们。指跟别人往来接触。","source":{"text":"右二事可见前辈诸老谦恭退抑，汲引后进，待人接物者如此。","book":"汉·司马迁《报任少卿书》：“教以慎于接物，推贤士为务。”明·陶宗仪《辍耕录》卷五"},"example":{"text":"他对事能从各方面看，能有充分的谅解精神，因此他的～都有很合理的态度。","book":"邹韬奋《患难余生记·流亡》"},"similar":["为人处世"],"usage":"作主语、宾语、定语；指对人的态度"},{"id":18046,"word":"待价而沽","pinyin":"dài jià ér gū","abbr":"djeg","explanation":"沽：卖。等有好价钱才卖。比喻谁给好的待遇就替谁工作。","source":{"text":"沽之哉！沽之哉！，我待贾者也。","book":"《论语·子罕》"},"example":{"text":"象中世纪骑士那样站在虹的桥上，高揭着什么怪好听的旗号，而实在只是出风头，或竟是～。","book":"茅盾《虹》一"},"similar":["善价而沽","席珍待聘"],"opposite":["坐失良机"],"usage":"作谓语、宾语、定语；指等待时机","story":["春秋时期，孔子带领弟子到各国去游说推行他的政治主张，没有人接受并重用他，他并不灰心。弟子子贡以得到美玉如何处理问孔子，孔子毫不迟疑地回答：“卖掉它，卖掉它，我正在等待识货的人出现呢。”"]},{"id":18047,"word":"待价藏珠","pinyin":"dài jià cáng zhū","abbr":"djcz","explanation":"珍藏明珠，以待高价。比喻有真才实学，等待受人赏识而用。","source":{"text":"子贡曰：‘有美玉于斯，韫椟而藏诸，求善贾而沽诸？’子曰：‘沽之哉！沽之哉，我待贾者也。’","book":"春秋·鲁·孔丘《论语·子罕》"},"example":{"text":"～未可轻，一朝持献明庭。","book":"明·胡文焕《群音类选·》"},"similar":["待价而沽"],"usage":"作谓语、宾语、定语；用于处世","story":["春秋时期，孔子认为当权者会推行他的仁政，在鲁国任职期间，鲁君受到季氏的控制，他只有感叹：“苟有用我者，期月而已可也，三年有成。”鲁君没有重用他。子贡安慰他：“有美玉于斯，韫椟而藏诸，求善贾而沽诸？”孔子说“沽之哉，我待贾者也。"]},{"id":18048,"word":"待兔守株","pinyin":"dài tù shǒu zhū","abbr":"dtsz","explanation":"比喻墨守成规不知变通或妄想不劳而获，坐享其成。同“守株待兔”","source":{"text":"刻舟求剑，体貌何殊；待兔守株，旨意宁远。","book":"宋·张君房《序》"},"similar":["守株待兔"],"usage":"作宾语、定语；指不知变通"},{"id":18049,"word":"待势乘时","pinyin":"dài shì chéng shí","abbr":"dscs","explanation":"待：等待；势：趋势，形势；乘：利用；时：时机。等待形势发展，利用有利时机。","source":{"text":"据先生甘贫守困，待势乘时，所谓蛟龙得云雨，终非池中之物。","book":"元·无名氏《冻苏秦》第一折"},"usage":"作谓语、定语；用于处事"},{"id":18050,"word":"待字闺中","pinyin":"dài zì guī zhōng","abbr":"dzgz","explanation":"字：许配；闺：女子卧室。留在闺房之中，等待许嫁。旧指女子成年待聘。","source":{"text":"女子待嫁，笄而字。","book":"《礼记·曲礼上》"},"example":{"text":"养成一个如珠似玉的女儿，不特好才貌，还缠得一双小足儿，现年十七岁，待字深闺。","book":"清·黄小配《廿载繁华梦》第二回"},"usage":"作谓语、定语；指待嫁女性"},{"id":18051,"word":"待时守分","pinyin":"dài shí shǒu fèn","abbr":"dssf","explanation":"待：等待；时：时机；分：本分。为了等待好的时机而暂时安分守己。","source":{"text":"想咱人不得志呵，当以待时守分，何日是我那发迹的时节也呵！","book":"元·关汉卿《裴度还带》第一折"},"example":{"text":"我如今装醉如痴，推聋作哑，～。","book":"明·无名氏《闹铜台》第二折"},"usage":"作谓语、定语；指等待时机"},{"id":18052,"word":"待时而举","pinyin":"dài shí ér jǔ","abbr":"dsej","explanation":"待：等待；举：行动。等待有利时机再采取行动。","source":{"text":"寡君知天运之盛衰，达时务之机变，所以养兵练将，待时而举。","book":"明·冯梦龙《东周列国志》第69回"},"similar":["待时而动"],"usage":"作谓语；指等待时机然后行动"},{"id":18053,"word":"待时而动","pinyin":"dài shí ér dòng","abbr":"dsed","explanation":"时：时机。等待时机然后行动。","source":{"text":"君子藏器于身，待时而动。","book":"《周易·系辞下》"},"example":{"text":"昭王深自韬晦，养兵恤民，～。","book":"明·冯梦龙《东周列国志》第九十五回"},"similar":["相机而行","待时而举"],"opposite":["轻举妄动"],"usage":"作谓语；指等待时机然后行动","story":["东汉末年，董卓把持朝政，危害天下，伊阙都尉张承很想率领他的部属诛杀董卓，他的弟弟张昭劝他不要以卵击石，去选择一个英明主子，待时而动。张承觉得有理，就解下官印回到家乡，与大哥张范一起避居扬州过着淡泊的生活"]},{"id":18054,"word":"待月西厢","pinyin":"dài yuè xī xiāng","abbr":"dyxx","explanation":"指情人私相约会。","source":{"text":"唐·元稹《月明三五夜》诗“待月西厢下，迎风户半开。拂墙花影动，疑是玉人来。”"},"example":{"text":"分明访贤东阁，已成～。","book":"《玉娇梨》第九回"},"usage":"作宾语、定语；指情人私会","story":["传说唐朝时莺莺看上寄宿的张生，她背着母亲想约张生夜间在花园幽会，但自己不好亲自去跟他讲，就在扇上题诗一首《月明三五夜》：“待月西厢下，迎风户半开。拂墙花影动，疑是玉人来。”托丫环红娘送去，是夜遂成好事"]},{"id":18055,"word":"待机再举","pinyin":"dài jī zài jǔ","abbr":"djzj","explanation":"举：行动。等待时机然后再行动。","source":{"text":"他曾妄想……保住残部待机再举。","book":"穆欣《南线巡回·粤桂大围歼战》"},"similar":["待时而举"],"usage":"作谓语、宾语；用于处事"},{"id":18056,"word":"待理不理","pinyin":"dài lǐ bù lǐ","abbr":"dlbl","explanation":"要理不理。形容对人态度冷淡。","source":{"text":"你们这会子瞧我穷，回来我得了银子，就是财主了，别这么待理不理的。","book":"清·曹雪芹《红楼梦》第九十五回"},"example":{"text":"曾朴《孽海花》第11回：“尚秋却～的，点了一点头。”"},"similar":["待答不理"],"opposite":["和蔼可亲"],"usage":"作谓语、定语；指态度冷淡"},{"id":18057,"word":"待答不理","pinyin":"dài dā bù lǐ","abbr":"ddbl","explanation":"指以冷淡的态度对人。","source":{"text":"她变得很怪，不大说话，象影子似地悄悄来悄悄走，总是若有所思地坐在那里出神，对谁都是待答不理的。","book":"王朔《痴人》"},"example":{"text":"指以冷淡的态度对人。"},"similar":["爱理不理","待搭不理"],"usage":"作谓语、定语；指态度冷淡"},{"id":18058,"word":"待诏公车","pinyin":"dài zhào gōng chē","abbr":"dzgc","explanation":"待：等待；诏：诏命，皇帝发出的命令；公车：汉代以公家车马递送应举的人，后举人被称为公车。在公车官署随时准备皇帝召唤。","source":{"text":"朔文辞不逊，高自称誉，上传之，令待诏公车，奉禄薄，未得省见。","book":"《汉书·东方朔传》"},"example":{"text":"《汉书·东方朔传》：“朔文辞不逊，高自称誉，上传之，令待诏公车，奉禄薄，未得省见。”"},"usage":"作宾语、定语；用于书面语"},{"id":18059,"word":"待贾而沽","pinyin":"dài jiǎ ér gū","abbr":"dgeg","explanation":"等待善价出售，也比喻怀才待用或待时而行。亦作“待价而沽”。","source":{"text":"子贡曰：‘有美玉於斯，韫椟而藏诸？求善贾而沽诸？’子曰：‘沽之哉，沽之哉！我待贾者也。’","book":"语本《论语·子罕》"},"similar":["待价而沽","善贾而沽"],"usage":"作谓语、宾语、定语；指等待时机","story":["春秋时期，孔子自认为当权者会推行他的仁政，在鲁国任职期间，鲁君受到季氏的控制，他只有感叹：“苟有用我者，期月而已可也，三年有成。”鲁君没有重用他，他说：“邦有道，则仕；邦无道，则行。”于是抱着“待贾而沽”的念头去周游列国"]},{"id":18060,"word":"徇公忘己","pinyin":"xùn gōng wàng jǐ","abbr":"xgwj","explanation":"徇：同“殉”。指尽忠于国家民众之事而弃置个人私利。","source":{"text":"卿勤王之节，徇公灭私；事主之诚，移忠资孝。","book":"唐·白居易《与薛苹诏》"},"similar":["徇公灭私"],"usage":"作谓语、定语、宾语；用于处事"},{"id":18061,"word":"徇公灭私","pinyin":"xùn gōng miè sī","abbr":"xgms","explanation":"指尽忠于国家民众之事而弃置个人私利。","source":{"text":"卿勤王之节，徇公灭私；事主之诚，移忠资孝。","book":"唐·白居易《与薛苹诏》"},"similar":["徇公忘己"],"usage":"作谓语、定语、宾语；用于处事"},{"id":18062,"word":"徇国忘家","pinyin":"xùn guó wàng jiā","abbr":"xgwj","explanation":"指为国尽忠而不顾家庭的得失。","source":{"text":"至若义感于内，诚动于中，徇国忘家，恤人犹己。","book":"唐·李翰《苏州嘉兴屯田纪绩颂序》"},"example":{"text":"宋·陆游《贺莆阳陈右相户》：“方孤论折群邪之锐，盖一身为众正之宗，～，惟天知我。”"},"similar":["徇国忘己","徇国忘身"],"usage":"作谓语、定语；用于书面语"},{"id":18063,"word":"徇国忘己","pinyin":"xùn guó wàng jǐ","abbr":"xgwj","explanation":"徇：同“殉”。指尽忠于国家之事而放弃个人得失。","source":{"text":"逮营阳失德，自绝宗庙，朝野岌岌，忧及祸难，忠谋协契，徇国忘己，援登圣朝，惟新皇祚。","book":"《宋书·谢晦传》"},"similar":["徇国忘家","徇国忘身"],"usage":"作谓语、定语；用于书面语"},{"id":18064,"word":"徇国忘身","pinyin":"xùn guó wàng shēn","abbr":"xgws","explanation":"徇：为国献身。为国尽忠而将个人得失、安危置之度外。","source":{"text":"故太子宾客裴垍，忠正恭慎，佐予为理，事君尽礼，徇国忘身。","book":"唐·白居易《赠裴垍官制》"},"similar":["舍生忘死","舍己为人"],"opposite":["自私自利"],"usage":"作谓语；用于书面语"},{"id":18065,"word":"徇情枉法","pinyin":"xùn qíng wǎng fǎ","abbr":"xqwf","explanation":"徇：曲从；枉：使歪曲。曲从私情，歪曲和破坏法律，胡乱断案。","source":{"text":"使官吏一心奉公，而不敢为徇情枉法之私。","book":"元·王謦《中书右丞相史公神道碑》"},"example":{"text":"雨村便～，胡乱判断了此案。","book":"清·曹雪芹《红楼梦》第四回"},"similar":["徇私舞弊"],"opposite":["执法如山","铁面无私"],"usage":"作谓语、宾语；指徇私舞弊"},{"id":18066,"word":"徇私作弊","pinyin":"xùn sī zuò bì","abbr":"xszb","explanation":"为了私情而弄虚作假。","source":{"text":"谁想这伙官员，贪滥无厌，徇私作弊，克减酒肉。","book":"明·施耐庵《水浒传》第83回"},"example":{"text":"考试不能～，要考真才实学。"},"similar":["徇私舞弊"],"opposite":["公事公办"],"usage":"作谓语、宾语、定语；指做违法乱纪的事"},{"id":18067,"word":"徇私偏向","pinyin":"xùn sī piān xiàng","abbr":"xspx","explanation":"曲从私情，偏袒一方。指处事不公。","example":{"text":"她一向不会公平处世，总是～带有偏见看待问题。"},"similar":["徇私作弊"],"usage":"作谓语、宾语、定语；用于处事"},{"id":18068,"word":"徇私废公","pinyin":"xùn sī fèi gōng","abbr":"xsfg","explanation":"曲从私情，不顾公理。","source":{"text":"若官司措置失当，及徇私废公，致有赴诉，并委台察纠案。","book":"宋·苏颂《论省曹寺监法令繁密》"},"example":{"text":"官人之意，不过因他助俺妆奁，便要～，这几件钗钏、衣裙，却放不到我香君眼里！","book":"清·孔尚任《桃花扇·骂筵》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":18069,"word":"徇私枉法","pinyin":"xùn sī wǎng fǎ","abbr":"xswf","explanation":"迁就私情而违反法纪。","source":{"text":"再说我们也是法律面前人人平等，难道我会徇私枉法？","book":"王朔《人莫予毒》"},"example":{"text":"他因～而致身败名裂。"},"similar":["徇情枉法"],"opposite":["奉公守法"],"usage":"作谓语、宾语；指徇私舞弊"},{"id":18070,"word":"徇私舞弊","pinyin":"xùn sī wǔ bì","abbr":"xswb","explanation":"徇：曲从；舞：舞弄，耍花样。为了私人关系而用欺骗的方法做违法乱纪的事。","source":{"text":"谁想这伙官员，贪滥无厌，徇私作弊，克减酒肉。","book":"明·施耐庵《水浒全传》第八十三回"},"example":{"text":"这种～的事情，他绝不会干。"},"similar":["徇情枉法","营私舞弊"],"opposite":["大公无私","公事公办"],"usage":"作谓语、宾语、定语；指做违法乱纪的事"},{"id":18071,"word":"徉长而去","pinyin":"yáng cháng ér qù","abbr":"yzeq","explanation":"徉长：大模大样。大模大样地径自走了。","source":{"text":"来兴儿道：‘你烧不烧随你，交与你，我有勾当去了。’说着，扬长而去了。","book":"明·兰陵笑笑生《金瓶梅词话》第二十三回"},"example":{"text":"说毕，～，众人苦留不住。清·曹雪芹《红楼梦》第十二回）"}},{"id":18072,"word":"徊肠伤气","pinyin":"huí cháng shāng qì","abbr":"hcsq","explanation":"肠回转，气伤断。形容内心伤感。","source":{"text":"徊肠伤气，颠倒失据。","book":"战国·楚·宋玉《神女赋》"},"usage":"作分句；指悲伤"},{"id":18073,"word":"徐妃半面","pinyin":"xú fēi bàn miàn","abbr":"xfbm","explanation":"徐妃：指梁元帝妃徐氏；半面：半个面容。徐妃事梁元帝，仅妆饰半个面容。后表示只看到一半或一部分，而没有看到全貌。","source":{"text":"妃以帝眇一目，每知帝将至，必以半面妆以俟，帝见则大怒而出。","book":"《南史·后妃传·徐妃》"},"example":{"text":"怕听项羽重瞳入，惭对～妆。","book":"清·赵翼《又和荆州咏古》"}},{"id":18074,"word":"徐妃半面妆","pinyin":"xú fēi bàn miàn zhuāng","abbr":"xfbmz","explanation":"徐妃：指梁元帝妃徐氏；半面：半个面容；妆：妆饰。徐妃事梁元帝，仅妆饰半个面容。后表示只看到一半或一部分，而没有看到全貌。","source":{"text":"妃以帝眇一目，每知帝将至，必以半面妆以俟，帝见则大怒而出。","book":"《南史·后妃传·徐妃》"},"example":{"text":"休夸此地分天下，只得～。","book":"唐·李商隐《南朝》"}},{"id":18075,"word":"徐娘半老","pinyin":"xú niáng bàn lǎo","abbr":"xnbl","explanation":"徐娘：指梁元帝妃徐氏。指尚有风韵的中年妇女。","source":{"text":"徐娘虽老，犹尚多情。","book":"《南史·后妃传下》"},"example":{"text":"一遇到女人，可就要发挥才藻了，不是“～，风韵犹存”，就是“豆蔻年华，玲珑可爱”。","book":"鲁迅《且介亭杂文二集·论人言可畏》"},"similar":["半老徐娘"],"opposite":["风烛残年","人老珠黄"],"usage":"作宾语、定语；用于中年女性","story":["南朝时期，梁朝湘东王萧绎的妃子徐昭佩由于得不到宠爱，先后与荆州瑶光寺的智远道人，贺徽以及暨季江勾搭成奸。暨季江感慨地说：“没想到徐娘半老，竟风韵犹存，是如此风流多情。”萧绎忍无可忍责令她自杀"]},{"id":18076,"word":"徐娘半老，风韵犹存","pinyin":"xú niáng bàn lǎo，fēng yùn yóu cún","abbr":"xnblfyyc","explanation":"徐娘：梁元帝妃徐氏，泛指妇女。指尚有风韵的中年妇女","source":{"text":"一遇到女人，可就要发挥才藻了，不是‘徐娘半老，风韵犹存’，就是‘豆蔻年华，玲珑可爱。’","book":"鲁迅《且介亭杂文二集·论人言可畏》"},"usage":"作宾语、定语；用于中年女性"},{"id":18077,"word":"徒乱人意","pinyin":"tú luàn rén yì","abbr":"tlry","explanation":"意：心情。只会扰乱人的心情，起不到别的作用。","source":{"text":"始受命闻一女卒，再受命闻一男生，皆不顾而行，得家书，不发而焚之，曰：‘徒乱人意。’","book":"宋·苏轼《富郑公神道碑》"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“这是所谓～，裘丰言和刘不才不敢再开口。”"},"usage":"作谓语、宾语；指扰乱人的心情"},{"id":18078,"word":"徒劳往返","pinyin":"tú láo wǎng fǎn","abbr":"tlwf","explanation":"徒劳：白花力气。来回白跑。","source":{"text":"大夫今日见谕，公则公言之，私则私言之，不必效舌剑唇枪，徒劳往返耳。","book":"明·许仲琳《封神演义》第五十六回"},"example":{"text":"清·荑荻散人《玉娇梨》第15回：“遂力言老先生已钦召进京，～，因劝晚生便道进京，又赠晚生行李之费。”"},"similar":["徒劳无功","竹篮打水"],"opposite":["马到成功"],"usage":"作谓语、定语；指来回白跑"},{"id":18079,"word":"徒劳无功","pinyin":"tú láo wú gōng","abbr":"tlwg","explanation":"白白付出劳动而没有成效。","source":{"text":"与不可，强不能，告不知，谓之劳而无功。","book":"《庄子·天运》：“推舟于陆也，劳而无功。”《管子·形势》"},"example":{"text":"博洛兴师动众，旷费时日，～。","book":"华而实《汉衣冠》七"},"similar":["劳而无功","徒劳往返"],"opposite":["大功告成","不劳而获"],"usage":"作谓语、宾语；指劳而无功"},{"id":18080,"word":"徒劳无益","pinyin":"tú láo wú yì","abbr":"tlwy","explanation":"白费劲，没有一点用处。","source":{"text":"倘实系硐产全枯，徒劳无益，则名是实非之厂。","book":"清·林则徐《查勘矿厂情形试行开采折》"},"example":{"text":"做事要讲效益，～的事不要去做。"},"similar":["徒劳无功"],"opposite":["不劳而获"],"usage":"作谓语、宾语；指劳而无功"},{"id":18081,"word":"徒呼奈何","pinyin":"tú hū nài hé","abbr":"thnh","explanation":"徒：徒然，白白地；奈何：怎么办。徒然呼喊着急怎么办。形容只是着急，毫无办法。","source":{"text":"陷入了我人马战争的汪洋大海之中，徒呼奈何！","book":"《星火燎原·黄洋界保卫战》"},"example":{"text":"由于内城关闭，他原已是～，不想有此意外机缘，得能越过禁制，王五自然绝不肯轻放。","book":"高阳《慈禧全传》七十三"},"similar":["徒唤奈何"],"usage":"作谓语、宾语、定语；指无可奈何"},{"id":18082,"word":"徒唤奈何","pinyin":"tú huàn nài hé","abbr":"thnh","explanation":"徒：徒然，白白地；奈何：怎么办。白白叫喊，无可奈何。","source":{"text":"可是他们只好望着波涛汹涌的金沙江水，徒唤奈何了。","book":"《回顾长征·遵义会议的光芒》"},"example":{"text":"她也只有～的份了。"},"similar":["徒呼奈何"],"usage":"作谓语、宾语、定语；指无可奈何"},{"id":18083,"word":"徒增颜汗","pinyin":"tú zēng yán hàn","abbr":"tzyh","explanation":"徒：只；颜汗：脸上的汗水。只是使人羞愧。指对过分的称赞表示不安。"},{"id":18084,"word":"徒子徒孙","pinyin":"tú zǐ tú sūn","abbr":"tzts","explanation":"徒弟和再传的徒弟。比喻一脉相传的人（含贬意）。","source":{"text":"只怕这野种子，做不成你徒子徒孙哩。","book":"明·罗贯中《平妖传》第八回"},"example":{"text":"心印领着～，就在秋华堂念起度人经。（清·魏秀仁《花月痕》第四十三回）"},"usage":"作主语、宾语；泛指党羽"},{"id":18085,"word":"徒废唇舌","pinyin":"tú fèi chún shé","abbr":"tfcs","explanation":"徒：徒然，白白地。白白耗费口舌，解决不了问题。","source":{"text":"妙用岂是人人能够了解的，向他们辩白，也不过徒废唇舌，不如省些精神罢。","book":"叶圣陶《潘先生在难中》"},"similar":["徒费唇舌"],"usage":"作谓语、宾语、定语；指白费口舌"},{"id":18086,"word":"徒手空拳","pinyin":"tú shǒu kōng quán","abbr":"tskq","explanation":"徒手：空手。两手空空。比喻没有任何依靠。","source":{"text":"争奈他赤手空拳。","book":"宋·魏了翁《缴奏奉使复命十事》：“防秋在即，赤手空弮何以应敌？”元·马致远《任风子》第一折"}},{"id":18087,"word":"徒托空言","pinyin":"tú tuō kōng yán","abbr":"ttky","explanation":"白把希望寄托于空话。指只讲空话，而不实行。","source":{"text":"子曰： ‘我欲载之空言，不如见之于行事之深切著明也。’","book":"《史记·太史公自序》"},"example":{"text":"我在西报上，看见这种议论，也不止一次了，……光景是～罢？","book":"清·李宝嘉《文明小史》第四十六回"},"similar":["徒陈空文"],"usage":"作谓语、宾语；指光说不干"},{"id":18088,"word":"徒拥其名","pinyin":"tú yōng qí míng","abbr":"tyqm","explanation":"徒：只。空有名望。指有名无实。","source":{"text":"军机大臣有时多至六七人，而权实操于领袖，新进者画诺奉行，徒拥其名也。","book":"《清朝野史大观·清朝史料·军机领袖》"},"similar":["徒拥虚名","徒有虚名","徒有其名"],"usage":"作谓语、宾语、定语；指只有名声"},{"id":18089,"word":"徒拥虚名","pinyin":"tú yōng xū míng","abbr":"tyxm","explanation":"空有名望。指有名无实。同“徒有虚名”。","source":{"text":"计一家不过升斗而已，徒有虚名，不救其弊。","book":"《北齐书·李元忠传》"},"example":{"text":"兵部～，拟正名为陆军部，以练兵处、太仆寺并入，而海军部暂隶焉。","book":"高阳《慈禧全传》九十七"},"similar":["徒有虚名","徒拥其名","徒负虚名"],"usage":"作谓语、宾语、定语；指有名无实"},{"id":18090,"word":"徒有其名","pinyin":"tú yǒu qí míng","abbr":"tyqm","explanation":"指有名无实。","source":{"text":"铨选之门，徒有其名，莫责其实。","book":"宋·李焘《续资治通鉴长编》"},"example":{"text":"所谓名家，大抵～，实则空洞，其作品且不及无名小卒。","book":"鲁迅《书信集·致杨霁云》"},"similar":["徒有虚名","有名无实"],"opposite":["名副其实","名实相符"],"usage":"作谓语、宾语、定语；指有名无实"},{"id":18091,"word":"徒有其表","pinyin":"tú yǒu qí biǎo","abbr":"tyqb","explanation":"表：表面，外貌。空有好看的外表，实际上不行。指有名无实。","source":{"text":"嵩既成，上掷其草于地，曰：‘虚有其表耳。’","book":"唐·郑处诲《明皇杂录》"},"example":{"text":"“金漆饭桶”，大约说～，面子上好看，其实内骨子一无所有。","book":"清·李宝嘉《官场现形记》第二十七回"},"similar":["金玉其外，败絮其中"],"usage":"作谓语、定语；用于书面语"},{"id":18092,"word":"徒有虚名","pinyin":"tú yǒu xū míng","abbr":"tyxm","explanation":"空有名望。指有名无实。","source":{"text":"计一家不过升斗而已，徒有虚名，不救其弊。","book":"《北齐书·李元忠传》"},"example":{"text":"乃马良之弟马谡也。”懿笑曰：“～，乃庸才耳！”（明·罗贯中《三国演义》第九十五回","book":"回报曰"},"similar":["徒有其名","名不副实"],"opposite":["名副其实","名不虚传"],"usage":"作谓语、宾语、定语；指只有名声"},{"id":18093,"word":"徒法不行","pinyin":"tú fǎ bù xíng","abbr":"tfbx","explanation":"徒：只。光有好的法令，并不能自行于世。意思是法令必须要有人推行。","source":{"text":"徒善不足以为政，徒法不能以自行。","book":"《孟子·离娄上》"},"example":{"text":"太常寺少卿许乃济疏言，烟禁虽严，闭关不可，徒法不行，请仍用旧制纳税，以货易货。","book":"《清史稿·黄爵滋》"}},{"id":18094,"word":"徒讬空言","pinyin":"tú tún kōng yán","abbr":"ttky","explanation":"指只讲空话，而不实行。同“徒托空言”。"},{"id":18095,"word":"徒读父书","pinyin":"tú dú fù shū","abbr":"tdfs","explanation":"徒：只。父书：父亲之言论。白读父亲的兵书。比喻人只知死读书，不懂得运用知识，加以变通。","source":{"text":"括徒能读其父书，不知合变也。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"括～，不知变通，非将才，愿王勿遣。","book":"明·冯梦龙《东周列国志》第九十八回"},"usage":"作谓语、宾语；指读死书"},{"id":18096,"word":"徒负虚名","pinyin":"tú fù xū míng","abbr":"tfxm","explanation":"空有名望。指有名无实。同“徒有虚名”。"},{"id":18097,"word":"徒费唇舌","pinyin":"tú fèi chún shé","abbr":"tfcs","explanation":"徒：白白地。指白讲了一大套话，结果仍然无济于事。","source":{"text":"九公何苦徒费唇舌，你这乡谈暂且留著，等小弟日后学会再说罢。","book":"清·李汝珍《镜花缘》第二十八回"},"example":{"text":"妙用岂是人人都能够了解的，向他们辩白，也不过～，不如省些精神罢。","book":"叶圣陶《潘先生在难中》"},"similar":["白费口舌","徒废唇舌"],"usage":"作谓语、宾语、定语；指白费口舌"},{"id":18098,"word":"徒费无益","pinyin":"tú fèi wú yì","abbr":"tfwy","explanation":"徒：徒然。白费劲，没有一点用处。","source":{"text":"神武常赉其粟帛，议者以为徒费无益，神武不从，抚慰如初。","book":"《北齐书·神武帝纪》"},"example":{"text":"南蛮远遁，边徼无虞，多留戍兵，～，不如各遣归本道。","book":"蔡东藩《唐史演义》第八十八回"},"similar":["徒劳无益"],"usage":"作谓语、宾语；指劳而无功"},{"id":18099,"word":"徒陈空文","pinyin":"tú chén kōng wén","abbr":"tckw","explanation":"陈：陈述。形容只讲空话，而不实行。","source":{"text":"言之非难，行之为难，故贤者处实而效功，亦非徒陈空文而已。","book":"汉·桓宽《盐铁论·非鞅》"},"similar":["徒托空言"],"usage":"作宾语、定语；用于处事"},{"id":18100,"word":"得一望十","pinyin":"dé yī wàng shí","abbr":"dyws","explanation":"得到一分，又巴望得到十分。形容十分贪婪。","source":{"text":"身子恰像生铁铸就，熟铜打成，长生不死一般，日夜思算，得一望十，得十望百，规程上去，分文不舍得妄费。","book":"明·冯梦龙《醒世恒言》卷十七"},"similar":["贪得无厌","得寸进尺"],"usage":"作谓语、定语；指贪婪"},{"id":18101,"word":"得一知己，死可无恨","pinyin":"dé yī zhī jǐ，sǐ kě wú hèn","abbr":"dyzjskwh","explanation":"知己：彼此相知的朋友；恨：遗憾。能得到一位知心朋友，就是死了也没有遗憾。形容知音难觅。","source":{"text":"所谓‘人之相知，贵相知心’，‘得一知己，死可无恨’。","book":"谢觉哉《知己难》"},"similar":["知音难觅"],"usage":"作宾语、定语、分句；用于慨叹"},{"id":18102,"word":"得不偿丧","pinyin":"dé bù cháng sàng","abbr":"dbcs","explanation":"所得的利益抵偿不了所受的损失。同“得不偿失”。","source":{"text":"晚登一第，则到官未满而亡，仅予随夺，得不偿丧。","book":"金·王若虚《进士彭子升墓志》"},"similar":["得不偿失"],"usage":"作谓语、宾语、定语；指得失失衡"},{"id":18103,"word":"得不偿失","pinyin":"dé bù cháng shī","abbr":"dbcs","explanation":"偿：抵得上。所得的利益抵偿不了所受的损失。","source":{"text":"感时嗟事变，所得不偿失。","book":"宋·苏轼《和子由除日见寄》诗"},"example":{"text":"饶鸿生在精养轩虽化了几十块冤枉钱，在后乐园倒明白了一桩古典，不能说～了。","book":"清·李宝嘉《文明小史》第五十三回"},"similar":["因小失大","贪小失大","得不偿丧"],"opposite":["乞浆得酒","利市之倍","得失相当"],"usage":"作谓语、宾语、定语；指得失失衡","story":["三国时期，东吴孙权占据江东六郡，他想扩大自己的势力范围，就召集群臣商议攻打夷州和琼崖有关事宜，大臣们均赞同出兵，只有右都护陆逊不赞同，他认为当前应该休养生息增强实力。孙权没采纳他的意见就出兵取胜，但整体上得不偿失"]},{"id":18104,"word":"得不补失","pinyin":"dé bù bǔ shī","abbr":"dbbs","explanation":"所得的利益抵偿不了所受的损失。同“得不偿失”。","source":{"text":"权遂征夷州，得不补失。","book":"晋·陈寿《三国志·吴志·陆逊传》"},"example":{"text":"我不想做这～的买卖。"},"similar":["得不偿失","得不酬失"],"usage":"作谓语、宾语、定语；指得失失衡"},{"id":18105,"word":"得不酬失","pinyin":"dé bù chóu shī","abbr":"dbcs","explanation":"所得的利益抵偿不了所受的损失。同“得不偿失”。","source":{"text":"军书未奏其利害，而离叛之关已言矣。故得不酬失，功不半劳。","book":"《后汉书·西羌传论》"},"similar":["得不偿失","因小失大"],"opposite":["乞浆得酒"],"usage":"作谓语、宾语、定语；指收支不平衡","story":["三国时期，东吴孙权占据江东六郡，他想扩大自己的势力范围，就召集群臣商议攻打夷州和琼崖有关事宜，大臣们均赞同出兵，只有右都护陆逊不赞同，他认为当前应该休养生息增强实力。孙权没采纳他的意见就出兵取胜，但整体上得不酬失"]},{"id":18106,"word":"得之若惊","pinyin":"dé zhī ruò jīng","abbr":"dzrj","explanation":"形容过多地考虑自己的利益，患得患失。","source":{"text":"宠为上，辱为下，得之若惊。","book":"《老子》第十三章"}},{"id":18107,"word":"得于心应于手","pinyin":"dé yú xīn yìng yú shǒu","abbr":"dyxyys","explanation":"得：获得，领悟；应：适应。领悟到要领，做起来顺手。形容功夫到家，心手相应。","source":{"text":"不徐不疾，得之于手而应于心，口不能言，有数存焉于其间。","book":"战国·宋·庄周《庄子·天道》"},"example":{"text":"乐之道深矣，故工之善者，必～而不可述之言也。","book":"宋·欧阳修《书梅圣俞稿后》"},"similar":["得心应手"],"usage":"作谓语、状语；用于处事"},{"id":18108,"word":"得人为枭","pinyin":"dé rén wéi xiāo","abbr":"drwx","explanation":"枭：一种猛禽，引申为胜利者。以得到人才为胜利。","source":{"text":"咸以得人为枭，失士为尤，故樊哙披帷，入见高祖，高祖踞洗以圣郦生。","book":"《后汉书·张衡传》"}},{"id":18109,"word":"得人死力","pinyin":"dé rén sǐ lì","abbr":"drsl","explanation":"死力：拚死之力。指能得到他人不顾性命地为之尽忠竭力。形容非常得人心。","source":{"text":"诞再在扬州，威名夙著，能得人死力。","book":"《晋书·贾充传》"},"example":{"text":"元春躯干雄硕，不治生产，然轻财好士，能～。","book":"《清史稿·苏元春传》"},"usage":"作谓语、定语；用于得到拥护"},{"id":18110,"word":"得人者昌，失人者亡","pinyin":"dé rén zhě chāng，shī rén zhě wáng","abbr":"drzcsrzw","explanation":"人：指人心。得人心的就能兴隆，失去人心的就要灭亡。","source":{"text":"至如谋于汉者，昔其臣也，公实弃之；兵于汉者，亦其将也，公不庸之。故曰：‘得人者昌，失人者亡。’","book":"唐·李观《项籍故里碑铭序》"},"example":{"text":"自古～。”（明·罗贯中《三国演义》第二十九回","book":"瑜曰"},"usage":"作宾语、定语、分句；用于劝诫统治者"},{"id":18111,"word":"得人钱财，与人消灾","pinyin":"dé rén qián cái，yǔ rén xiāo zāi","abbr":"drqcyrxz","explanation":"得到别人金钱等好处就得为别人办事。","source":{"text":"惟小子弄惯了这管笔头，才知里边缘故，叫做得人钱财，与人消灾，只顾骗准，值些甚么？","book":"明·伏雌教主《醋葫芦》第14回"},"example":{"text":"～，收了他这二千两，信和有什么要求，就非得替他办到不可。","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["得人钱财，替人消灾"],"usage":"作宾语、定语；用于处事"},{"id":18112,"word":"得休便休","pinyin":"dé xiū biàn xiū","abbr":"dxbx","explanation":"休：停止。能停止就停止，适可而止，留有余地。","source":{"text":"若他肯就我范围，何妨得休便休，过了一年是一年，且到将来，再作计较。","book":"蔡东藩、许廑父《民国通俗演义》第二回"},"similar":["适可而止","见好就收"],"usage":"作谓语、定语；用于处事"},{"id":18113,"word":"得便宜卖乖","pinyin":"dé pián yí mài guāi","abbr":"dpymg","explanation":"得到好处或实惠卖弄乖巧。","source":{"text":"盛杏荪这个人很刻薄，专门做得便宜卖乖的事。","book":"高阳《胡雪岩全传·灯火楼台》"},"usage":"作谓语、定语、宾语；用于口语"},{"id":18114,"word":"得兔忘蹄","pinyin":"dé tù wàng tí","abbr":"dtwt","explanation":"犹言得鱼忘荃。蹄，兔罝。","source":{"text":"蹄者所以在兔，得兔而忘蹄。","book":"语出《庄子·外物》"},"example":{"text":"后之贤者，有如以水投水者乎？有如～者乎？","book":"宋·姜夔《白石道人诗说》"},"similar":["得鱼忘筌","过河拆桥"],"usage":"作谓语、宾语、定语；指过河拆桥"},{"id":18115,"word":"得全要领","pinyin":"dé quán yào lǐng","abbr":"dqyl","explanation":"得全：获得保全；要：古“腰”字；领：颈部；要领：指主旨、纲领。腰和头颈获得保全。指全面领会事情的主旨和纲领。"},{"id":18116,"word":"得其三昧","pinyin":"dé qí sān mèi","abbr":"dqsm","explanation":"三昧：梵语，意为正定。排除一切杂念，使心神平静，专心致志，达到悟境。引申为诀窍或精义。指在某方面造诣深湛，熟知精义。","source":{"text":"泻汤旧得茶三昧。","book":"宋·苏轼《又赠老谦》"},"example":{"text":"大贤天资颖悟，自能～，不能十分精通。应如何习学可以精通之处，尚求指教。","book":"清·李汝珍《镜花缘》第十七回"},"usage":"作谓语；借指在某方面造诣深湛"},{"id":18117,"word":"得其所哉","pinyin":"dé qí suǒ zāi","abbr":"dqsz","explanation":"所：处所，环境。找到了适合于他的地方或得到理想的安置。也形容因某事而称心快意的情绪。","source":{"text":"昔者有馈生鱼于郑子产，子产使校人畜之池。校人烹之，反命曰：‘始舍之，圉圉焉；小则洋洋焉，攸然而逝。’子产曰：‘得其所哉！得其所哉！’","book":"《孟子·万章上》"},"example":{"text":"他的庶务！掌柜的当庶务叫作“～”。","book":"老舍《老张的哲学》十四"},"similar":["各得其所","求仁得仁"],"opposite":["乱点鸳鸯"],"usage":"作谓语、宾语；指得到所需要的","story":["春秋时期，有人给郑国大夫子产送一条活蹦乱跳的大鱼，子产舍不得杀了吃，就叫人把鱼放到池里去养。管池人偷偷把鱼煮吃了，然后告诉子产鱼开始不灵活，慢慢地游动，最后一溜烟游走了。子产高兴地说得其所哉，管池人心里偷着乐"]},{"id":18118,"word":"得兽失人","pinyin":"dé shòu shī rén","abbr":"dssr","explanation":"得到了野兽却丧失了人的性命。比喻得不偿失，因小失大。","source":{"text":"劳师于戎，而失诸华，虽有功，犹得兽而失人也，安用之？","book":"《国语·晋语七》"}},{"id":18119,"word":"得君行道","pinyin":"dé jūn xíng dào","abbr":"djhd","explanation":"旧指有才识的人得到开明君主的信任，得以推行自己的政治主张和计划。","source":{"text":"真能得君行道，当然要多多少少改变那自己不满别人也不满的现状。","book":"朱自清《论不满现状》"},"usage":"作谓语、定语；用于处事"},{"id":18120,"word":"得售其奸","pinyin":"dé shòu qí jiān","abbr":"dsqj","explanation":"售：推销，推行。得以推行他的奸计。","source":{"text":"主权所在，名器不可假人，勿令矫伪者得售其奸也。","book":"章炳麟《为辛亥同志俱乐部纠正段祺瑞废止法统令通电》"},"similar":["以售其奸"],"usage":"作谓语；指准备作恶"},{"id":18121,"word":"得天独厚","pinyin":"dé tiān dú hòu","abbr":"dtdh","explanation":"天：天然，自然；厚：优厚。具备的条件特别优越，所处环境特别好。","source":{"text":"得天独厚开盈尺，与月同园到十分。","book":"清·洪亮吉《江北诗话》卷二"},"example":{"text":"曹沾进园，草草看了，便觉这“南园”～，就在它有一片好水。","book":"端木蕻良《曹雪芹》十八"},"similar":["天时地利","地利人和"],"opposite":["先天不足"],"usage":"作谓语、定语、状语；多用于环境条件"},{"id":18122,"word":"得失参半","pinyin":"dé shī cān bàn","abbr":"dscb","explanation":"得失：得到与失去。得到的和失去的各一半。即得失相当。","example":{"text":"我们的结果是～。"},"similar":["得失相当","得失相半"],"usage":"作谓语、定语；指得失相当"},{"id":18123,"word":"得失在人","pinyin":"dé shī zài rén","abbr":"dszr","explanation":"指人生的胜利失败就取决于本人的努力与否。强调人的主观能动性。","source":{"text":"命之不来也，圣人犹无可奈何，况于贤者哉！仆尝窃不自量，谓以为得失在人，欲揭闻见，抗衡当代之士。不知事有大谬，异于此望者，乃令人惭愧悔赧。","book":"唐·陈子昂《与韦王虚己书》"},"usage":"作宾语、分句；用于劝诫人"},{"id":18124,"word":"得失成败","pinyin":"dé shī chéng bài","abbr":"dscb","explanation":"指得与失，成功与失败。","source":{"text":"得失成败，备在典谟，是以其详，可得而言。","book":"晋·陆机《五等诸侯论》"},"example":{"text":"你不要过多考虑自己的～。"},"similar":["成败得失"],"usage":"作主语、宾语；指人的成功失败"},{"id":18125,"word":"得失相半","pinyin":"dé shī xiāng bàn","abbr":"dsxb","explanation":"得失：得到与失去。得到的和失去的各一半。即得失相当，不相上下。","source":{"text":"今分兵捕民，得失相半，岂得谓全哉？","book":"晋·陈寿《三国志·吴书·全琮传》"},"example":{"text":"竟不晓何谓，犹不若石城之～也。","book":"宋·岳珂《桯史·石城堡寨》"},"similar":["得失各半"],"usage":"作谓语；指不相上下"},{"id":18126,"word":"得失荣枯","pinyin":"dé shī róng kū","abbr":"dsrk","explanation":"指人生的获得与丧失、兴盛与衰败。","source":{"text":"休说功名，皆是浪语，得失荣枯总是虚。","book":"元·沈和《赏花时·潇湘八景》套曲"},"example":{"text":"一梦之中，见了人我是非，～，遂有出尘之志。","book":"明·无名氏《度黄龙》楔子"},"usage":"作宾语、定语；用于人生"},{"id":18127,"word":"得婿如龙","pinyin":"dé xù rú lóng","abbr":"dxrl","explanation":"形容得到称心如意的佳婿。","source":{"text":"后汉李赝、孙秀俱娶太尉恒焉女，时人谓恒叔元两女俱乘龙，言得婿如龙。","book":"宋·叶廷珪《海录碎事·人事》"},"usage":"作宾语、定语；用于恭喜别人"},{"id":18128,"word":"得寸入尺","pinyin":"dé cùn rù chǐ","abbr":"dcrc","explanation":"得：取得，获得。得了一寸，还想再进一尺。比喻贪得无厌。","source":{"text":"其奈得寸入尺、获陇望蜀者，既眈眈相逼乎前；而政府之慑狐威者，今日许以寸，明日予以尺。","book":"梁启超《论民族竞争之大势》"},"similar":["得寸进尺","得寸思尺"],"usage":"作谓语、定语、状语；指贪心"},{"id":18129,"word":"得寸则寸","pinyin":"dé cùn zé cùn","abbr":"dczc","explanation":"得到一寸就是一寸。指得到实实在在的好处，得多少就是多少。","source":{"text":"王不如远交而近攻，得寸则王之寸，得尺亦王之尺也。","book":"《战国策·秦策三》"},"similar":["得尺得寸"],"usage":"作谓语、宾语；指能得多少就得多少"},{"id":18130,"word":"得寸得尺","pinyin":"dé cùn dé chǐ","abbr":"dcdc","explanation":"指或多或少皆有所得。后也指能得多少就得多少。","source":{"text":"王不如远交而近攻，得寸则王之寸，得尺亦王之尺也。","book":"《战国策·秦策三》"},"example":{"text":"惟须认定主见，中外一意，合力坚持，～，相机筹办，必可循序就范。","book":"清·薛福成《通筹南洋各岛添设领事官保护华民疏》"},"similar":["得尺得寸"],"usage":"作谓语、宾语；指能得多少就得多少"},{"id":18131,"word":"得寸思尺","pinyin":"dé cùn sī chǐ","abbr":"dcsc","explanation":"得：取得，获得。得了一寸，还想再进一尺。比喻贪得无厌。","source":{"text":"小民惟利是图，往往得寸思尺。","book":"《清史稿·食货志》"},"similar":["得寸进尺","得寸入尺"],"usage":"作谓语、定语、状语；指贪心"},{"id":18132,"word":"得寸进尺","pinyin":"dé cùn jìn chǐ","abbr":"dcjc","explanation":"得了一寸，还想再进一尺。比喻贪心不足，有了小的，又要大的。","source":{"text":"王不如远交而近攻，得寸则王之寸， 得尺亦王之尺也。","book":"《老子·道德经》：“不敢进寸而退尺。”《战国策·秦策三》"},"example":{"text":"法国～，五年以后吞并了整个南圻，而心犹未足，还打算攘夺北圻，仅留下中圻给越南。","book":"高阳《清宫外史》下册"},"similar":["得陇望蜀","贪得无厌","贪心不足"],"opposite":["心满意足","如愿以偿","称心如意"],"usage":"作谓语、定语、状语；指贪心"},{"id":18133,"word":"得尺得寸","pinyin":"dé chǐ dé cùn","abbr":"dcdc","explanation":"得：取得，获得。指得到实实在在的好处，得多少就是多少。","source":{"text":"王不如远交而近攻，得寸则王之寸， 得尺亦王之尺也。","book":"西汉·刘向《战国策·秦策三》"},"example":{"text":"然后更易而少进焉，则～，虽少而皆为吾有矣。","book":"宋·朱熹《答朱朋孙书》"},"similar":["得寸得尺"],"usage":"作谓语、宾语；指能得多少就得多少"},{"id":18134,"word":"得心应手","pinyin":"dé xīn yìng shǒu","abbr":"dxys","explanation":"得：得到，想到；应：反应，配合。心里怎么想，手就能怎么做。比喻技艺纯熟或做事情非常顺利。","source":{"text":"不徐不疾，得之于手而应于心。","book":"《庄子·天道》"},"example":{"text":"挟了七八万现款的冯云卿就此走进了公债市场，半年来总算～，扯起息来，二分半是有的。","book":"茅盾《子夜》"},"similar":["心手相应","游刃有余","驾轻就熟"],"opposite":["不文不武"],"usage":"作宾语、定语、状语；用于各种技艺","story":["春秋时期，齐桓公在堂上读书，工匠轮扁冒失上前打扰，齐桓公对轮扁的读书无用论深为不满。轮扁解释道：我做木公的技艺得心应手，是不可能用语言传授给别人的，古代圣人学问的精妙之处也是如此"]},{"id":18135,"word":"得意不宜再往","pinyin":"dé yì bù yí zài wǎng","abbr":"dybyzw","explanation":"得意：称心如意。过于满意、顺利的事不应该再做第二次，以免遇到麻烦和意外。","source":{"text":"凡事当留余地，得意不宜再往。","book":"清·朱柏庐《治家格言》"},"example":{"text":"～，待我细细思索便了。","book":"清·石玉昆《三侠五义》第七回"},"similar":["得意不可再往"],"usage":"作宾语、定语；用于处事"},{"id":18136,"word":"得意之作","pinyin":"dé yì zhī zuò","abbr":"dyzz","explanation":"指自己认为非常满意的作品。","source":{"text":"作者仿佛要为我开小型展览会似的，把自己的得意之作，都陈列在我面前了。","book":"曹靖华《哪有闲情话年月》"},"example":{"text":"这就是我的～。"},"usage":"作宾语；指满意的作品"},{"id":18137,"word":"得意之色","pinyin":"dé yì zhī sè","abbr":"dyzs","explanation":"得意：称心如意。因非常称心如意而露出傲慢的神色。","source":{"text":"血的游戏已经开头，而角色又是青年，并且有得意之色。","book":"鲁迅《书信集·答有恒先生》"},"usage":"作宾语；用于人的表情"},{"id":18138,"word":"得意忘形","pinyin":"dé yì wàng xíng","abbr":"dywx","explanation":"形：形态。形容高兴得失去了常态。","source":{"text":"嗜酒能啸，善弹琴。当其得意，忽忘形骸。","book":"《晋书·阮籍传》"},"example":{"text":"他把科长看成有天那么大，把他和科长连在一块，他没法不～。","book":"老舍《四世同堂》三十二"},"similar":["忘乎所以","自鸣得意","得意洋洋"],"opposite":["怅然若失","心灰意冷"],"usage":"作谓语、定语、状语；指忘乎所以","story":["魏晋时期的文学家阮籍，因为魏国灭亡而隐居山林，与文人嵇康、山涛、向秀、阮咸、刘伶、王戎被称为“竹林七贤”，他狂荡无羁，别人形容他喝酒时爱吹口哨，高兴时好像忘记自己的存在，真是得意忘形"]},{"id":18139,"word":"得意忘言","pinyin":"dé yì wàng yán","abbr":"dywy","explanation":"原意是言词是表达意思的，既然已经知道了意思，就不再需要言词。后比喻彼此心里知道，不用明说。","source":{"text":"蹄者所以在兔，得兔而忘蹄。言者所以在意，得意而忘言。","book":"《庄子·外物》"},"example":{"text":"迷方者执文泥象，知音者～。","book":"明·杨慎《洞天玄记》开场"},"similar":["心照不宣"],"opposite":["格格不入"],"usage":"作谓语、定语；指心照不宣"},{"id":18140,"word":"得意忘象","pinyin":"dé yì wàng xiàng","abbr":"dywx","explanation":"指只取其精神而无视其形式。","source":{"text":"非夫聪明深达，得意忘象，其孰能知乎？","book":"唐·梁肃《止观统例议》"},"example":{"text":"昔人深于画者～，其形模位置有不可以常法观者……。","book":"宋·黄伯思《东观馀论·跋滕子济所藏唐人出游图》"},"similar":["得意忘形"],"usage":"作谓语、定语；用于书面语"},{"id":18141,"word":"得意扬扬","pinyin":"dé yì yáng yáng","abbr":"dyyy","explanation":"形容非常得意的样子。","source":{"text":"意气扬扬，甚自得也。","book":"西汉·司马迁《史记·管晏列传》"},"example":{"text":"刚才我看见他和胡宗预从教务室出来，～，公然的扬言道，某某人是去定的了。","book":"郑振铎《漩涡》"},"similar":["得意洋洋","自鸣得意"],"opposite":["垂头丧气","灰心丧气"],"usage":"作定语、状语；指因成功而沾沾自喜","story":["春秋时期，齐国三朝相国晏婴身居高位，但行事沉稳，十分谦恭，而他的车夫却认为自己能替相国驾车十分得意扬扬。车夫的妻子见了就告诫车夫，应该向晏婴学习，车夫从此变得很谦逊起来，晏婴认为他知错必改表现很好"]},{"id":18142,"word":"得意洋洋","pinyin":"dé yì yáng yáng","abbr":"dyyy","explanation":"洋洋：得意的样子。形容称心如意、沾沾自喜的样子。","source":{"text":"意气扬扬，甚自得也。","book":"《史记·管晏列传》"},"example":{"text":"单道台～的答道：“忙虽忙，然而并不觉得其苦。”","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["沾沾自喜","得意扬扬"],"opposite":["垂头丧气","灰心丧气"],"usage":"作定语、状语；指自鸣得意","story":["春秋时期，齐国三朝相国晏婴身居高位，但行事沉稳，十分谦恭，而他的车夫却认为自己能替相国驾车十分得意扬扬。车夫的妻子见了就告诫车夫，应该向晏婴学习，车夫从此变得很谦逊起来，晏婴认为他知错必改表现很好"]},{"id":18143,"word":"得意自鸣","pinyin":"dé yì zì míng","abbr":"dyzm","explanation":"鸣：表达。自以为了不起，表示很得意","source":{"text":"笑他井底响繁蛙，得意自鸣，甘居人下。","book":"清·陈琅《玉狮堂传奇·回流记·罢宴》"},"similar":["自鸣得意"],"usage":"作谓语、定语、状语；指自以为是"},{"id":18144,"word":"得意门生","pinyin":"dé yì mén shēng","abbr":"dyms","explanation":"得意：称心如意；门生：亲授业的弟子或科举中试者对座师的自称。后泛指学生。最满意的弟子或学生。","source":{"text":"他虽然和咱们满州汉军隔旗，却是我第一个得意门生，他待我也实在亲热，那个人将来不可限量。","book":"清·文康《儿女英雄传》第二回"},"example":{"text":"两位都是石农的～哟。","book":"清·曾朴《孽海花》第十一回"},"usage":"作宾语、定语；指受欢迎的学生"},{"id":18145,"word":"得手应心","pinyin":"dé shǒu yīng xīn","abbr":"dsyx","explanation":"比喻技艺纯熟或做事情非常顺利。同“得心应手”。","source":{"text":"比喻技艺纯熟或做事情非常顺利。同“得心应手”。"},"example":{"text":"～，奚事揣摩之计；入经出传，耻为孟浪之谈。","book":"明·吴承恩《寿王可斋七帙障词》"},"similar":["得心应手"],"usage":"作宾语、定语、状语；用于各种技艺等"},{"id":18146,"word":"得新忘旧","pinyin":"dé xīn wàng jiù","abbr":"dxwj","explanation":"得到新的，遗忘旧的。多指爱情不专一。","source":{"text":"得新忘旧，到前丢后，妄想处一味骄矜，满意时十分驰骤。","book":"明·胡文焕《群音类选·桂枝香》"},"similar":["喜新厌旧"],"usage":"作谓语、定语、宾语；用于处世"},{"id":18147,"word":"得月较先","pinyin":"dé yuè jiào xiān","abbr":"dyjx","explanation":"水边的楼台先得到月光。比喻能优先得到利益或便利的某种地位或关系。","source":{"text":"范文正公镇钱塘，兵官皆被荐，独巡检苏麟不见录，乃献诗云：‘近水楼台先得月，向阳花木易逢春。’","book":"宋·俞文豹《清夜录》"}},{"id":18148,"word":"得未尝有","pinyin":"dé wèi cháng yǒu","abbr":"dwcy","explanation":"指前所未有，今始得之。同“得未曾有”。","source":{"text":"昨辱宠临，久不闻语，殊出意表，盖所谓得未尝有也。","book":"宋·苏轼《与郭功甫书》之一"},"similar":["得未曾有","前所未有"],"usage":"作谓语；指前所未有"},{"id":18149,"word":"得未曾有","pinyin":"dé wèi céng yǒu","abbr":"dwcy","explanation":"指前所未有，今始得之。","source":{"text":"法筵清众，得未曾有。","book":"《楞严经》卷一"},"example":{"text":"承先生封都给我回信，于“小鬼”实在好像在盂兰节，食饱袋足，～了。","book":"鲁迅《两地书·七》"},"similar":["亘古未有","前所未有","得未尝有"],"usage":"作谓语；指前所未有"},{"id":18150,"word":"得步进步","pinyin":"dé bù jìn bù","abbr":"dbjb","explanation":"已进了一步，还要向前进一步。比喻野心大，贪心永不满足。","source":{"text":"自北宁失败后，法人得步进步，海疆处处戒严。","book":"曾朴《孽海花》第六回"},"example":{"text":"那老三，他叫什么呀，～，喝鹿奶还不够了。","book":"鲁迅《故事新编·采薇》"},"similar":["贪得无厌","得寸进尺"],"usage":"作谓语、定语；指人贪心不足"},{"id":18151,"word":"得江山助","pinyin":"dé jiāng shān zhù","abbr":"djsz","explanation":"得到江河山川的帮助才能写出好的诗文。比喻好的诗文是不能脱离现实的。","source":{"text":"《新唐书·张说传》载：张善于写文章，尤长于碑志，既谪官岳州，诗多凄婉，较前为进，人谓“得江山助”。"}},{"id":18152,"word":"得病乱投医","pinyin":"dé bìng luàn tóu yī","abbr":"dblty","explanation":"患了病到处乱找医生。比喻人遇到事故胡乱地到处找人帮忙或出主意。"},{"id":18153,"word":"得窥门径","pinyin":"dé kuī mén jìng","abbr":"dkmj","explanation":"窥：从小孔、缝隙或隐蔽处偷着看；径：路。得以找到门路。比喻找到了解决问题的途径。"},{"id":18154,"word":"得缩头时且缩头","pinyin":"dé suō tóu shí qiě suō tóu","abbr":"dstsqst","explanation":"原指乌龟能把头缩回去就缩回去。比喻遇到问题或困难能躲让过去就躲让过去。","source":{"text":"僧问：‘如何是祖师西来意？’师曰：‘入市乌龟。’曰：‘意旨如何？’师曰：‘得缩头时且缩头。’","book":"宋·释惟白《续传灯录》卷八"},"example":{"text":"～，我们还是忍让一下吧。"},"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":18155,"word":"得而复失","pinyin":"dé ér fù shī","abbr":"defs","explanation":"复：又，再。刚得到又失去了。","source":{"text":"孔明变色曰：‘是何言也！得而复失，与不得同。公以此贺我，实足使我愧赧耳！’","book":"明·罗贯中《三国演义》第九十六回"},"opposite":["失而复得"],"usage":"作谓语、定语；用于事物等"},{"id":18156,"word":"得胜回头","pinyin":"dé shèng huí tóu","abbr":"dsht","explanation":"宋、元说书人的术语，在开讲前，先说一段小故事做引子，取其吉利之意。","source":{"text":"且先引下一个故事来，权做个得胜回头。","book":"元·无名氏《错斩崔宁》"},"usage":"作宾语、定语；用于说书等"},{"id":18157,"word":"得胜回朝","pinyin":"dé shèng huí cháo","abbr":"dshc","explanation":"朝：朝廷。旧指打了胜仗回到朝廷去报功。现泛指胜利归来。","source":{"text":"老将军，你这一去，小心在意者，若得胜还朝，圣人自有加官赐赏哩。","book":"元·无名氏《小尉迟》第二折"},"example":{"text":"以为这一吓，人家就会闭口，自己就可以“～”了。","book":"毛泽东《反对党史八股》"},"similar":["班师回朝","打道回府","荣归故里"],"usage":"作谓语、宾语、定语；用于讽刺"},{"id":18158,"word":"得胜头回","pinyin":"dé shèng tóu huí","abbr":"dsth","explanation":"头回：前回。宋、元说书人的术语。在开讲前，先说一段小故事做引子，谓之“得胜头回”，取其吉利之意。","source":{"text":"且先引下一个故事来，权做个得胜头回。","book":"宋·无名氏《错斩崔宁》"},"example":{"text":"凡其上半，谓之“～”，头回犹云前回，听说话者多军民，故冠以吉语曰得胜。","book":"鲁迅《中国小说史略》第十二篇"}},{"id":18159,"word":"得胜的猫儿欢似虎","pinyin":"dé shèng de máo ér huān sì hǔ","abbr":"dsdmehsh","explanation":"形容由于取得了胜利而得意忘形，自以为了不起。","source":{"text":"古人云：‘得胜的猫儿欢似虎’也，只倚着强能，更不察来人的意思。","book":"明·吴承恩《西游记》第六十一回"}},{"id":18160,"word":"得胜葫芦","pinyin":"dé shèng hú lu","abbr":"dshl","explanation":"指能说会道的嘴巴。","source":{"text":"卖弄他能爱女，有权术，怎禁那得胜葫芦，说到有九千句。","book":"元·关汉卿《救风尘》第四折"}},{"id":18161,"word":"得荫忘身","pinyin":"dé yīn wàng shēn","abbr":"dyws","explanation":"荫：遮蔽。原指蝉得到荫凉的地方遮蔽就忘了自身的安全。比喻只图眼前的享受而不顾后患。","source":{"text":"睹一蝉方得美荫而忘其身，螳螂执翳而搏之。","book":"《庄子·山木》"}},{"id":18162,"word":"得薄能鲜","pinyin":"dé bó néng xiān","abbr":"dbnx","explanation":"德行浅薄，才能不足（表示自谦的话）。"},{"id":18163,"word":"得财买放","pinyin":"dé cái mǎi fàng","abbr":"dcmf","explanation":"旧指官府的衙役捕人时，收到被捕人的钱财，便私自将人放掉。","source":{"text":"你做公差所干何事？若非用计谋死，必然得财买放，有何理说？","book":"明·冯梦龙《古今小说·沈小霞相会出师表》"},"usage":"作谓语、宾语、定语；用于官场等"},{"id":18164,"word":"得輶如毛","pinyin":"dé yóu rú máo","abbr":"dyrm","explanation":"輶：轻。德行轻得如同羽毛一般。指实行仁政并不困难，而在于其是否有志向。","source":{"text":"人亦有言：德輶如毛，民鲜克举之。我仪图之，维仲山甫举之，爱莫助之。","book":"《诗比·大雅·烝民》"}},{"id":18165,"word":"得过且过","pinyin":"dé guò qiě guò","abbr":"dgqg","explanation":"且：暂且。只要能够过得去，就这样过下去。形容胸无大志。","source":{"text":"孩儿，我听得道你要出外打旋，怕家中得过且过，出去做甚的？","book":"元·无名氏《小孙屠》第四出"},"example":{"text":"但是吃烟人的脾气，总是～，那一个是真心肯戒。","book":"清·彭养鸥《黑籍冤魂》第一回"},"similar":["马马虎虎","苟且偷生","听天由命"],"opposite":["力争上游","精益求精","一丝不苟"],"usage":"作谓语、定语、状语；指安于现状","story":["传说五台山上有一种十分漂亮的寒号鸟，夏天时羽毛特别好看，到处找鸟比美，唱道：“凤凰不如我。”秋天来临，别的鸟要么飞到南方过冬，要么自己筑窝，寒号鸟无动于衷。冬天来临，寒号鸟羽毛掉光，最后被活活地冻死在石缝中"]},{"id":18166,"word":"得道多助","pinyin":"dé dào duō zhù","abbr":"dddz","explanation":"指符合道义者则能得到多数人的帮助。","source":{"text":"得道者多助，失道者寡助。寡助之至，亲戚畔之。","book":"先秦·孟轲《孟子·公孙丑下》"},"example":{"text":"我则～，彼则众叛亲离。","book":"孙中山《军人精神教育》第二章"},"similar":["得道多助，失道寡助"],"opposite":["失道寡助"],"usage":"作宾语、定语；用于劝诫人"},{"id":18167,"word":"得道多助，失道寡助","pinyin":"dé dào duō zhù，shī dào guǎ zhù","abbr":"dddzsdgz","explanation":"道：道义；寡：少。站在正义方面，会得到多数人的支持帮助；违背正义，必陷于孤立。","source":{"text":"得道者多助，失道者寡助。寡助之至，亲戚畔之；多助之至，天下顺之。","book":"《孟子·公孙丑下》"},"example":{"text":"彼以武力为后盾，我以公理为前驱，～。","book":"蔡东藩、许廑父《民国通俗演义》第一百三十一回"},"usage":"作谓语、宾语、状语；用于劝诫人"},{"id":18168,"word":"得陇望蜀","pinyin":"dé lǒng wàng shǔ","abbr":"dlws","explanation":"陇：指甘肃一带；蜀：指四川一带。已经取得陇右，还想攻取西蜀。比喻贪得无厌。","source":{"text":"人苦不知足，既平陇，复望蜀，每一发兵，头鬓为白。","book":"《后汉书·岑彭传》"},"example":{"text":"我很希望兄有空，再画几幅，虽然太有些～。","book":"《鲁迅书信集·致陶元庆》"},"similar":["得寸进尺","贪得无厌","贪心不足"],"opposite":["心满意足","称心如意","如愿以偿"],"usage":"作谓语、宾语；指人贪心不足","story":["刘秀当了皇帝后，西部巴蜀蜀王公孙述及陇西的隗嚣对东汉的威胁很大，光武帝建武八年，刘秀亲率大军讨伐隗嚣，隗嚣大败逃西域。刘秀命令大将实施他的“得陇望蜀”的计划，继而进攻巴蜀，势如破竹，消灭了蜀王，使巴蜀归汉"]},{"id":18169,"word":"得隽之句","pinyin":"dé juàn zhī jù","abbr":"djzj","explanation":"隽：隽永，意味深长。意义深远，耐人寻味的好文句。","source":{"text":"得隽之句，警策之篇，多因彼此唱和中得之。","book":"唐·白居易《与刘苏州书》"}},{"id":18170,"word":"得风便转","pinyin":"dé fēng biàn zhuǎn","abbr":"dfbz","explanation":"看到风头便转变态度。比喻态度随势而变。","source":{"text":"周三他倒也得风便转，道：‘既承台爱，我们就在这位姑娘的面前从这句话敬你老人家起。’","book":"清·文康《儿女英雄传》第十六回"}},{"id":18171,"word":"得风就是雨","pinyin":"dé fēng jiù shì yǔ","abbr":"dfjsy","explanation":"比喻听到一点点不确切的消息就信以为真。","source":{"text":"得不的风儿，就是雨儿。","book":"明·兰陵笑笑生《金瓶梅词话》第四十二回"}},{"id":18172,"word":"得饶人处且饶人","pinyin":"dé ráo rén chù qiě ráo rén","abbr":"drrcqrr","explanation":"指做事不要做绝，须留有余地。","source":{"text":"蔡州褒信县有道人式棋，常饶人先，其诗曰：‘自出洞来无敌手，得饶人处且饶人。’","book":"《唾玉集·常谈出处》"},"example":{"text":"～，得将就的就省些事吧。","book":"清·曹雪芹《红楼梦》第五十九回"},"similar":["适可而止"],"usage":"作谓语、宾语、分句；指适可而止"},{"id":18173,"word":"得马失马","pinyin":"dé mǎ shī mǎ","abbr":"dmsm","explanation":"指世事多变，得失无常。","source":{"text":"居数月，其马将胡骏马而归，人皆贺之。其父曰：‘此何遽不能为祸乎？’家富良马，其子好骑，堕而折其髀。","book":"西汉·刘安《淮南子·人间训》"},"example":{"text":"作云作雨手反覆，～心清凉。","book":"宋·黄庭坚《梦中和觞字韵》诗"},"usage":"作宾语、定语；指因福得祸","story":["古代塞北一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为不一定是好事，他的儿子因骑胡马摔断了腿，马也跑了，老翁认为不是坏事，后来老汉儿子因腿伤而躲过战祸"]},{"id":18174,"word":"得马折足","pinyin":"dé mǎ shé zú","abbr":"dmsz","explanation":"指因福而得祸。","source":{"text":"典出《淮南子·人间训》。见“得马生灾”。"},"example":{"text":"～祸，亡羊多歧悲。","book":"宋·黄庭坚《次韵奉送公定》"},"similar":["得马生灾"],"usage":"作宾语、定语；指因福得祸","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":18175,"word":"得马生灾","pinyin":"dé mǎ shēng zāi","abbr":"dmsz","explanation":"指因福而得祸。","source":{"text":"近塞上之人，有善术者，马无故亡而入胡……居数月，其马将胡骏马而归，人皆贺之。其父曰：‘此何遽不能为祸乎？’家富良马，其子好骑，堕而折其髀。","book":"《淮南子·人间训》"},"example":{"text":"维鹈受刺因吾过，～念尔冤。","book":"唐·元稹《哭子》诗之一"},"similar":["塞翁失马"],"opposite":["因祸得福"],"usage":"作宾语、定语；指因福得祸","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":18176,"word":"得鱼忘筌","pinyin":"dé yú wàng quán","abbr":"dywq","explanation":"比喻已达目的，即忘其凭借。“荃”亦作“筌”。","source":{"text":"荃者所以在鱼，得鱼而忘荃。","book":"《庄子·外物》"},"example":{"text":"我们读书求学的，要在得意而忘言，得鱼而忘荃。","book":"郭沫若《新旧与文白之争》"},"similar":["卸磨杀驴","过河拆桥"],"opposite":["饮水思源"],"usage":"作谓语、宾语、定语；指过河拆桥","story":["古代一渔夫到河边捕鱼，他把竹器筌投进水里，全神贯注观看浮标，终于一条红鲢鱼上筌了。他十分高兴取下鱼把筌抛在一边，快步回家吹嘘自己的功劳。妻子说这是筌的功劳，问他筌到哪里去了，渔夫这才想起忘记带筌回家了"]},{"id":18177,"word":"得鱼忘荃","pinyin":"dé yú wàng quán","abbr":"dywq","explanation":"荃：通：“筌”，捕鱼用的竹器。捕到了鱼，忘掉了筌。比喻达到目的后忘记了原来的凭借","source":{"text":"荃者所以在鱼，得鱼而忘荃；蹄者所以在兔，得兔而忘蹄。","book":"战国·宋·庄周《庄子·外物》"},"example":{"text":"郭沫若《新归与文白之争》：“我们读书求学的，要在得意而忘言，～。”"},"similar":["得鱼忘筌","过河拆桥"],"usage":"作谓语、宾语、定语；指过河拆桥"},{"id":18178,"word":"徘徊不前","pinyin":"pái huái bù qián","abbr":"phbq","explanation":"徘徊：来回地行走。犹豫不决，停步不前。比喻总在一个地点不能前进。","source":{"text":"林彪又消极抗令，徘徊不前，受到军委的严厉批评。","book":"成仿吾《长征回忆录》"},"example":{"text":"她的成绩一直～。"},"similar":["停滞不前"],"usage":"作谓语、定语；指停滞不前"},{"id":18179,"word":"徘徊不定","pinyin":"pái huái bù dìng","abbr":"phbd","explanation":"在难于接受的或同样紧迫的两者之间作出抉择时为难犹豫。","example":{"text":"在难于接受的或同样紧迫的两者之间作出抉择时为难犹豫。"},"similar":["犹豫不决"],"opposite":["斩钉截铁"],"usage":"作谓语、定语、状语；指不能决断"},{"id":18180,"word":"徘徊歧路","pinyin":"pái huái qí lù","abbr":"phql","explanation":"徘徊：在一个地方来回地走，比喻犹豫；歧路：岔路。在岔道上走来走去。比喻犹豫观望，主意不定。","source":{"text":"动息无兼遂，歧路多徘徊。","book":"南朝·齐·谢眺《观朝雨》"},"example":{"text":"若其眷恋穷城，～，坐昧先几之兆，必贻后至之诛。","book":"唐·骆宾王《为徐敬业讨武曌檄》"},"similar":["徘徊不定"],"usage":"作谓语、定语；指犹豫不决","story":["唐朝时期，武则天控制政权后，改国号周，自己当女皇。大将徐敬业在扬州起兵反对武则天，他为扩大影响，号召天下人们起来推翻武则天，请当时文学家骆宾王写《为徐敬业讨武瞾檄》：“若其眷恋穷城，徘徊歧路，坐昧先几之兆，必贻后至之诛。”"]},{"id":18181,"word":"徘徊观望","pinyin":"pái huái guān wàng","abbr":"phgw","explanation":"徘徊：来回地行走。形容应该决断时犹豫的样子。","source":{"text":"至袁氏今日，势已穷蹙，而犹徘徊观望，不肯自归于失败。","book":"孙中山《第二次讨袁宣言》"},"example":{"text":"并不是黄銮鸣阻挠出兵，而是因为谭延闿～。","book":"李六如《六十年的变迁》第六章"},"similar":["徘徊不前"],"usage":"作谓语、定语；指不能决断"},{"id":18182,"word":"徙倚仿佯","pinyin":"xǐ yǐ fǎng yáng","abbr":"xyfy","explanation":"徙倚：徘徊；仿佯：游荡不定。徘徊，游荡不定。","source":{"text":"然隐悯而不达兮，独徙倚而仿徉。","book":"《楚辞·哀时命》"}},{"id":18183,"word":"徙倚仿徉","pinyin":"xǐ yǐ páng yáng","abbr":"xyfy","explanation":"徙倚：徘徊；仿徉：通“彷徉”，游荡无定。徘徊、游荡不定。","source":{"text":"然隐敏而不达兮，独徒倚以仿徉。","book":"战国·楚·屈原《楚辞·哀时命》"},"usage":"作谓语、状语；用于书面语"},{"id":18184,"word":"徙善远罪","pinyin":"xǐ shàn yuǎn zuì","abbr":"xsyz","explanation":"趋向善良，远离罪恶。","source":{"text":"故礼之教化也微，其止邪也於未形，使人日徙善远罪而不自知也。","book":"《大戴礼记·礼察》：“贵绝恶于未萌，而起敬于微眇，使民日徙善远罪而不自知也。”   《礼记·经解》"},"usage":"作谓语；指劝人为善"},{"id":18185,"word":"徙宅之贤","pinyin":"xǐ zhái zhī xián","abbr":"xzzx","explanation":"相传孟轲的母亲为了教育好他，三次迁居，改变环境。形容母教贤明。","source":{"text":"秩贵冬官，以表过庭之训；封荣石窌，用旌徙宅之贤。","book":"唐·白居易《制诏·与严砺诏》"}},{"id":18186,"word":"徙宅忘妻","pinyin":"xǐ zhái wàng qī","abbr":"xzwq","explanation":"徙：迁移；宅：住所。搬家忘记把妻子带走。比喻粗心到了荒唐的地步。","source":{"text":"寡人闻忘之甚者，徙宅而忘其妻。","book":"《孔子家语·贤君》"},"example":{"text":"明·程登吉《幼学琼林》第三卷：“笑人善忘曰～；讥人不谨曰开门揖盗。”"},"usage":"作谓语；指粗心"},{"id":18187,"word":"徙木为信","pinyin":"xǐ mù wéi xìn","abbr":"xmwx","explanation":"徙：迁移；信：信用。指说到做到，言而有信。","source":{"text":"有人徙之，辄予五十金，以明不欺。卒下令。","book":"西汉·司马迁《史记·商君列传》"},"similar":["言而有信"],"opposite":["食言而肥","言而无信"],"usage":"作谓语、定语；指言而有信","story":["战国时期，商鞅在秦孝公的支持下进行变法，新法公布以后，为使人们相信新法一定要执行，商鞅命人在国都南门处立了一根三丈多高的木柱，声明谁搬动到北门就赏五十金。有一个胆大而力大的人果然得到五十金，人们认为商鞅言出必行就按新法行事"]},{"id":18188,"word":"徙薪曲突","pinyin":"xǐ xīn qū tū","abbr":"xxqt","explanation":"搬开灶旁柴禾，将直的烟囱改成弯的。本指预防火灾。后亦比喻先采取措施，防患于未然。","source":{"text":"人为徐生上书曰：‘臣闻客有过主人者，见其灶直突，傍有积薪，客谓主人，更为曲突，远徙其薪，不者且有火患。主人嘿然不应。俄而家果失火，邻里共救之，幸而得息……","book":"《汉书·霍光传》"},"example":{"text":"～于方炽之火，纚舟弭楫于冲锋之前。","book":"晋·葛洪《抱朴子·知止》"},"similar":["曲突徙薪","防患未然"],"opposite":["临渴掘井"],"usage":"作谓语、定语；用于事先预防","story":["从前有个人去拜访他的朋友，看见朋友家的烟囱竖在灶前，灶前还堆着不少干柴，就建议主人把烟囱改成弯曲的，把干柴移开。主人没有采纳。不久真的发生火灾，幸亏邻居及时救火。主人杀牛来谢这些邻居，邻居说该请的是那位提意见的人"]},{"id":18189,"word":"徜徉恣肆","pinyin":"cháng yáng zì sì","abbr":"cyzs","explanation":"形容文章挥洒自如，气势豪放。","source":{"text":"至若操纸为文，落笔千字，徜徉恣肆，如不楞穷。","book":"宋·曾巩《祭王平甫文》"},"usage":"作谓语、定语；用于文章等"},{"id":18190,"word":"御下蔽上","pinyin":"yù shàng bì xià","abbr":"yxbs","explanation":"压制下级，蒙骗上级。指欺上瞒下。","source":{"text":"其所授者，妒贤嫉能，御下蔽上，以成其私，不为主计，而主不觉悟，故失其国。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"妒贤嫉能，～，而不忧其有害于圣政也。","book":"宋·朱熹《己酉拟上封事》"},"similar":["欺下瞒上"],"usage":"作谓语、定语、宾语；用于处事"},{"id":18191,"word":"御侮折冲","pinyin":"yù wǔ zhé chōng","abbr":"ywzc","explanation":"折冲：指抵御敌人。指抗拒敌人的进攻。","source":{"text":"武臣折冲曰御侮。","book":"《诗经·大雅·绵》：“予曰有御侮。”毛传"},"example":{"text":"乃内之则殿阁枢府以至六部九卿，外之则洎甘四行省之疆吏，旁皇咨求，卒无一人焉足以胜～之任者。（清·严复《原强》）"}},{"id":18192,"word":"御敌于国门之外","pinyin":"yù dí yú guó mén zhī wài","abbr":"ydygmzw","explanation":"国门：原指国都的城门，后泛指出入国境的要道。原指强盗在国都门外抢劫。后泛指当敌人未进入统辖区就进行抵御，不让敌人进来。","source":{"text":"今有御人于国门之外者。","book":"《孟子·万章下》"},"example":{"text":"军事冒险主义者则坚决反对此种步骤，他们的主张是所谓“～”。","book":"毛泽东《中国革命战争的战略问题》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":18193,"word":"御沟流叶","pinyin":"yù gōu liú yè","abbr":"ygly","explanation":"御沟：皇城外的护城河。皇城外的护城河水中漂流的红叶。指皇宫中盼望外嫁的宫女。","source":{"text":"黄花初绽，碧梧渐凋，御沟流叶空来到，最难熬。","book":"元·无名氏《四喜记·琼英闺闷》"},"similar":["御沟红叶"],"usage":"作宾语、定语；用于书面语","story":["唐僖宗巡视四川带去宫中侍书宫娥芳子，芳子很有学问，一天她在红叶上题诗：“流水何太急？深宫尽日闲。殷勤谢红叶，好去到人间。”题完后就顺手抛进水沟，被襄州进士李茵拾到。恰好在一山民家相遇，芳子见到题诗的红叶，两人遂成良缘"]},{"id":18194,"word":"御沟红叶","pinyin":"yù gōu hóng yè","abbr":"yghy","explanation":"御沟：流经宫苑的河道。指红叶题诗的故事，后用以比喻男女奇缘。亦作“御沟流叶”、“红叶之题”。","source":{"text":"唐·孟棨《本事诗》记载，顾况在洛阳游苑中，流水上得大梧叶，上有宫女题诗，顾况次日也于上游题诗叶上，泛于波中，以此传情。又一说，题诗宫女名韩翠苹，诗为于祐所得，于又题诗为韩所得，韩、于最终成为夫妻。"},"example":{"text":"～谁与寄，青楼薄幸空遗迹。","book":"宋·张孝祥《满江红》"},"similar":["御沟流叶"],"usage":"作宾语、定语；用于书面语","story":["唐僖宗巡视四川带去宫中侍书宫娥芳子，芳子很有学问，一天她在红叶上题诗：“流水何太急？深宫尽日闲。殷勤谢红叶，好去到人间。”题完后就顺手抛进水沟，被襄州进士李茵拾到。恰好在一山民家相遇，芳子见到题诗的红叶，两人遂成良缘"]},{"id":18195,"word":"御用文人","pinyin":"yù yòng wén rén","abbr":"yywr","explanation":"御用：帝王所用。为帝王所豢养只知道歌功颂德的无聊文人。比喻投靠有势力的集团或有势力的人物而为之吹嘘的文人。","source":{"text":"我倒不是不想让你当御用文人。","book":"王朔《一点正经没有》"},"example":{"text":"像康生这样的～最终没有好下场。"},"usage":"作宾语、定语；用于讽刺"},{"id":18196,"word":"御驾亲征","pinyin":"yù jià qīn zhēng","abbr":"yjqz","explanation":"御驾：皇帝的车驾，指皇帝。皇帝亲自率军出征。","source":{"text":"今刘玄德即了帝位，统精兵七十余万，御驾亲征，其势甚大。","book":"明·罗贯中《三国演义》第81回"},"example":{"text":"只有～才能重整士气。"},"similar":["亲历亲为"],"opposite":["假手于人"],"usage":"作谓语、宾语；指皇帝亲征","story":["三国时期，蜀国荆州守将在攻击魏国的汉中途中遭到吴国孙权的军队的伏击，被孙权活捉并杀害。蜀主刘备听到噩耗后，立即准备讨伐孙权，在筹备的过程中，张飞被手下杀死，头颅被送到孙权那里。刘备为了报仇于是率领70万大军御驾亲征东吴"]},{"id":18197,"word":"循分守理","pinyin":"xún fèn shǒu lǐ","abbr":"xfsl","explanation":"指言谈行为遵循事理，安分守己。","source":{"text":"而朝廷至今终未省寐，犹以二人所为为是，而以循理守分者为非。","book":"宋·司马光《论北边事宜》"},"example":{"text":"那纪望唐自幼恪遵庭训，～，奋志读书。","book":"清·文康《儿女英雄传》第十八回"}},{"id":18198,"word":"循名校实","pinyin":"xún míng jiào shí","abbr":"xmxs","explanation":"犹循名责实。按其名而求其实，要求名实相符。","source":{"text":"皆功行相参，循名校实，条列行状，公文具上。","book":"《晋书·刘弘传》"},"similar":["循名核实","循名考实","循名课实"],"usage":"作谓语、宾语、定语；指要名实相符"},{"id":18199,"word":"循名核实","pinyin":"xún míng hé shí","abbr":"xmhs","explanation":"明·张居正《答浙江吴巡抚》：“明主在上，方翕受敷施，循名核实，以兴太平之治，愿勉旃，毋自损，以孤舆望。”","source":{"text":"明主在上，方翕受敷施，循名核实，以兴太平之治，愿勉旃，毋自损，以孤舆望。","book":"明·张居正《答浙江吴巡抚》"},"example":{"text":"明·张居正《答浙江吴巡抚》：“明主在上，方翕受敷施，循名核实，以兴太平之治，愿勉旃，毋自损，以孤舆望。”"},"similar":["循名督实","循名责实"],"usage":"作谓语、宾语、定语；指要名实相符"},{"id":18200,"word":"循名督实","pinyin":"xún míng dū shí","abbr":"xmds","explanation":"犹循名责实。按其名而求其实，要求名实相符。","source":{"text":"譬诸木犬，犹彼泥龙，循名督实，事归乌有。","book":"《北齐书·文宣帝纪》"},"similar":["循名核实","循名责实"],"usage":"作谓语、宾语、定语；指要名实相符"},{"id":18201,"word":"循名考实","pinyin":"xún míng kǎo shí","abbr":"xmks","explanation":"循：依照；责：要求。按其名而求其实，要求名实相符。亦作循名责实。","source":{"text":"夫建官均职，清理民物，所以务本也，循名考实，纠励成规，所以治末也。","book":"三国·魏·傅嘏《难刘劭考课法论》"},"similar":["循名课实","循名校实","循名核实"],"usage":"作谓语、宾语、定语；指要名实相符"},{"id":18202,"word":"循名覈实","pinyin":"xún míng hé shí","abbr":"xmhs","explanation":"犹言循名责实。按着名称或名义去寻找实际内容，使得名实相符。"},{"id":18203,"word":"循名课实","pinyin":"xún míng kè shí","abbr":"xmks","explanation":"犹言循名责实。按着名称或名义去寻找实际内容，使得名实相符。","source":{"text":"章以造阙，风矩应明，表以致策，骨采宜耀，循名课实，以文为本者也。","book":"南朝·梁·刘勰《文心雕龙·章表》"},"example":{"text":"今民国之名已定矣……顾名思义，～，以完成革命志士之志。","book":"孙中山《〈民权初步〉序》"},"similar":["循名考实","循名核实","循名校实"],"usage":"作谓语、宾语、定语；指要名实相符"},{"id":18204,"word":"循名课时","pinyin":"xún míng kè shí","abbr":"xmks","explanation":"循：依照；课：要求。按着名称或名义去寻找实际内容，使得名实相符。","source":{"text":"术者，因任而授官，循名而责实，操生杀之柄，课群臣之能者也，此人主之所执也。","book":"《韩非子·定法》"},"example":{"text":"以章造阙，风矩应明；表以致禁，骨采宜耀。～，以章为本者也。","book":"南朝·梁·刘勰《文心雕龙·章表》"}},{"id":18205,"word":"循名责实","pinyin":"xún míng zé shí","abbr":"xmzs","explanation":"循：依照；责：要求。按着名称或名义去寻找实际内容，使得名实相符。","source":{"text":"术者，因任而授官，循名而责实。","book":"战国·韩·韩非《韩非子·定法》"},"example":{"text":"尚无中华民国之实，～，这就是今天的工作。","book":"毛泽东《新民主主义论》"},"similar":["顾名思义","实事求是"],"opposite":["徒慕虚名","名实不符"],"usage":"作谓语、宾语、定语；指要名实相符"},{"id":18206,"word":"循墙而走","pinyin":"xún qiáng ér zǒu","abbr":"xqez","explanation":"沿着墙走。形容恭顺谨慎。","source":{"text":"一命而偻，再命而伛，三命而俯，循墙而走。","book":"《左传·昭公七年》"},"example":{"text":"溥质直廉静，无城府。性恭谨，每入朝，～。","book":"《明史·杨溥传》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":18207,"word":"循声附会","pinyin":"xún shēng fù huì","abbr":"xsfh","explanation":"自己没有主见，只是随声应和，牵强附会。","source":{"text":"奇哉，可见此等妇人之沽名钓誉，而礼官之循声附会也。","book":"清·褚人获《隋唐演义》第七十一回"}},{"id":18208,"word":"循常习故","pinyin":"xún cháng xí gù","abbr":"xcxg","explanation":"循常：遵循常规。习故：学习陈旧的作风。遵守旧规，沿袭先例。形容因袭保守，不愿变通。亦作“循故袭常”、“履常蹈故”、“遵常守故”。","source":{"text":"又中世之选，三公也，务于清悫谨慎，循常习故者。","book":"汉·仲长统《昌言·法诫》"},"example":{"text":"今士～，规行矩步，积阶级，累阀阅，碌碌然以取世资。","book":"《晋书·张载传》"},"similar":["因循守旧","规行矩步"],"usage":"作谓语、定语；用于处事"},{"id":18209,"word":"循序渐进","pinyin":"xún xù jiàn jìn","abbr":"xxjj","explanation":"指学习工作等按照一定的步骤逐渐深入或提高。","source":{"text":"此但自言其反己自修，循序渐进耳。","book":"《论语·宪问》：“不怨天，不尤人，下学而上达，知我者其天乎？”朱熹注"},"example":{"text":"她通常是从一个角度写，而不是从几个角度写；还只是～地写，而不是错综交叉地写。","book":"茅盾《怎样评价〈青春之歌〉？》"},"similar":["按部就班","由浅入深"],"opposite":["一步登天"],"usage":"作宾语、定语；用于学习或工作","story":["从前纪昌去拜箭法高手飞卫为师学习射箭，飞卫让他练好眼睛的基本功，他回家看妻子织布，练就圆睁眼睛，一点也不眨。飞卫让他练把小东西看成大东西，纪昌把头发上的小虱子看成车轮，飞卫这才教他射箭，从此成为百发百中的神射手"]},{"id":18210,"word":"循循善导","pinyin":"xún xún shàn dǎo","abbr":"xxsd","explanation":"循循：有次序的样子；善：善于；导：引导。指善于引导别人进行学习。","source":{"text":"仰之弥高，钻之弥坚，瞻之在前，忽焉在后，夫子循循然善诱人。","book":"《论语·子罕》"},"example":{"text":"业余的节目主持人，说到这里，也学专业人员正视观众，两眼也发放出来机智的光彩，脸上也呈现～的笑容。","book":"林斤澜《二分》"}},{"id":18211,"word":"循循善诱","pinyin":"xún xún shàn yòu","abbr":"xxsy","explanation":"循循：有次序的样子；善：善于；诱：引导。指善于引导别人进行学习。","source":{"text":"夫子循循然善诱人。","book":"《论语·子罕》"},"example":{"text":"先生～，余今日之尚能握管，先生力也。","book":"清·沈复《浮生六记·闺房记乐》"},"similar":["谆谆教导","诲人不倦"],"usage":"作谓语、定语、状语；用于教育","story":["春秋时期，孔子的学生对孔子非常崇拜，颜渊是孔子的得意门生之一，他称赞孔子的教学方法说：“夫子循循然善诱人，博我以文，约我以礼，欲罢不能。既渴天才，如有所立卓尔。”别的弟子也附和说他们也有同感"]},{"id":18212,"word":"循循诱人","pinyin":"xún xún yòu rén","abbr":"xxyr","explanation":"犹循循善诱。指善于有步骤地引导、教育人。","source":{"text":"［陈拊］壮年励志苦学，屡科不第，遂隐居教授，循循诱人。","book":"《杨家将演义》第一回"},"similar":["循循善诱","恂恂善诱"],"usage":"作谓语、定语、状语；多用于教育"},{"id":18213,"word":"循故袭常","pinyin":"xún gù xí cháng","abbr":"xgxc","explanation":"循故：遵循旧的；袭常：沿袭常规。指因袭保守，不求建树。","source":{"text":"又中世之选三公也，务于清箻谨慎，循常习故者。","book":"《后汉书·仲长统传》"},"example":{"text":"贵乎～，无烦于更洽也。","book":"宋·蔡襄《明谏》"}},{"id":18214,"word":"循次渐进","pinyin":"xún cì jiàn jìn","abbr":"xcjj","explanation":"循：依照。按照一定的步骤或程序逐渐推进或提高。","source":{"text":"大抵读书唯虚心专意，循次而进，为可得之。","book":"唐·韩愈《答窦秀才书》：“操数寸之管，书盈尺之纸，高可以钓爵位；循次而进，亦不失万一于甲科。”宋·朱熹《答刘仲则》"},"example":{"text":"只是荣禄与自己的年纪差不多，～，前面三位大学士一死，荣禄顺理成章地正了揆席。","book":"高阳《慈禧全传》七十六"}},{"id":18215,"word":"循次而进","pinyin":"xún cì ér jìn","abbr":"xcej","explanation":"循：依照，顺着。依照一定的步聚或次序逐步推进或提高。亦作“循次渐进”、“循序渐进”。","source":{"text":"操数寸之管，书盈尺之纸，高可以钓爵位，循次而进，亦失万一于甲科。","book":"唐·韩愈《答窦秀才书》"},"similar":["循序渐进"],"usage":"作谓语、定语；用于书面语"},{"id":18216,"word":"循涂守辙","pinyin":"xún tú shǒu zhé","abbr":"xtsz","explanation":"遵守规矩。亦作“循途守辙”。","source":{"text":"循涂守辙，犹言循规蹈矩云尔。","book":"宋·朱熹《答方宾王书》"},"similar":["循途守辙","循规蹈矩"],"usage":"作宾语、定语；用于书面语"},{"id":18217,"word":"循环反复","pinyin":"xún huán fǎn fù","abbr":"xhff","explanation":"周而复始，去而复来。指反复进行，没有止息。","source":{"text":"自魏兴以来，未有循环反复若此之荐也。","book":"《史记·高祖本纪》：“三王之道若循环，终而复始。”《魏书·天文志》"},"example":{"text":"春夏作头，秋冬为尾。～无穷已。","book":"唐·罗隐《乐府杂曲·鼓吹曲辞·芳树》"},"similar":["周而复始"],"usage":"作定语、状语；用于事物等"},{"id":18218,"word":"循环往复","pinyin":"xún huán wǎng fù","abbr":"xhwf","explanation":"周而复始，去而复来。指反复进行，没有止息。","source":{"text":"太史公曰：‘……三王之道若循环，终而不止。’","book":"汉·司马迁《史记·高祖本纪》"},"example":{"text":"实践、认识、再实践、再认识，这种形式，～以至无穷，而实践和认识之每一循环的内容，都比较地进到了高一级的程度。"},"similar":["周而复始","循环交替"],"opposite":["始终如一"],"usage":"作谓语、定语、状语；用于人或事物"},{"id":18219,"word":"循环无端","pinyin":"xún huán wú duān","abbr":"xhwd","explanation":"①往复回旋，没有终始。②形容反复进行，没完没了。","source":{"text":"如天道循环无端，而言四时者，不得不以春为始，非春前之一日不为方春之日先也。","book":"《孙子·势》：“奇正相生，如循环之无端，孰能穷之？”清·王夫之《读四书大全说·论语·卫灵公篇十九》"},"example":{"text":"家人媳妇、丫头，养娘终日猴在那秋千架上，你上我下，我上你下，～打那秋千玩耍。","book":"清·西周生《醒世姻缘传》第九十七回"},"similar":["周而复始"],"usage":"作定语、状语；用于书面语"},{"id":18220,"word":"循理守分","pinyin":"xún lǐ shǒu fèn","abbr":"xlsf","explanation":"指言谈行为遵循事理，安分守己。","source":{"text":"而朝廷至今终未省寐，犹以二人所为为是，而以循理守分者为非。","book":"宋·司马光《论北边事宜》"},"example":{"text":"朕在藩邸时，仰托皇考福庇，安富尊荣，～，不交结一人，不与闻一事。","book":"清·雍正皇帝《大义觉迷录》"}},{"id":18221,"word":"循私废公","pinyin":"xùn sī fèi gōng","abbr":"xsfg","explanation":"曲从私情，不顾公理。","source":{"text":"若官司措置失当，及徇私废公，致有赴诉，并委台察纠案。","book":"宋·苏颂《论省曹寺监法令繁密》"}},{"id":18222,"word":"循行数墨","pinyin":"xún háng shǔ mò","abbr":"xxsm","explanation":"循行：一行行地读；数墨：一字字地读。指只会诵读文句，而不能理解义理。也指专在文字上下功夫。","source":{"text":"口内诵经千卷，体上问经不识。不解佛法圆通，徒劳寻行数墨。","book":"宋·释道原《景德传灯录》卷二十九"},"example":{"text":"下问三事，志大而见卓，非寻文书生～，拘守章句之所及。","book":"明·朱之瑜《与源光国书三十四首》"}},{"id":18223,"word":"循规矩蹈","pinyin":"xún guī jǔ dǎo","abbr":"xgjd","explanation":"循、蹈：遵循，依照。规、矩：是定方圆的标准工具，借指行为的准则。原指遵守规矩，不敢违反。现也指拘守旧准则，不敢稍做变动。","source":{"text":"敬无知人之明，则循规蹈矩，绳墨以求寡过。","book":"宋·苏轼《拟进士御试策》"},"similar":["循规蹈矩"],"opposite":["推陈出新"],"usage":"作谓语、定语、状语；指没有创新"},{"id":18224,"word":"循规蹈矩","pinyin":"xún guī dǎo jǔ","abbr":"xgdj","explanation":"循、蹈：遵循，依照。规、矩是定方圆的标准工具，借指行为的准则。原指遵守规矩，不敢违反。现也指拘守旧准则，不敢稍做变动。","source":{"text":"循涂守辙，犹言循规蹈矩云尔。","book":"宋·朱熹《答方宾王书》"},"example":{"text":"这唐僧～，同悟空、悟能、悟净，牵马挑担，径入山门。","book":"明·吴承恩《西游记》第九十八回"},"similar":["安分守己","规行矩步","墨守成规"],"opposite":["胡作非为","随心所欲","轻举妄动"],"usage":"作谓语、定语、状语；指没有创新","story":["大观园内财政出现困难，探春主张姑娘们住的园子不用另请人管理，在园中挑选几个老实本分的人来管理。李纨、宝钗纷纷表示支持。众老婆子纷纷提出承包方案，并表示每年还有额外收入。宝钗对她们说只要循规蹈矩地干，一定会有收获的"]},{"id":18225,"word":"循规遵矩","pinyin":"xún guī zūn jǔ","abbr":"xgzj","explanation":"循：遵守；规、矩：定方圆的标准工具，借指行为的准则。指拘守旧准则，不敢稍做变动。","source":{"text":"这么一所大花园，都是你们照看，皆因看得你们是三四代的老妈妈，最是循规遵矩的，原该大家齐心，顾些体统。","book":"清·曹雪芹《红楼梦》第56回"},"similar":["循规蹈矩"],"opposite":["推陈出新"],"usage":"作谓语、定语、状语；指没有创新"},{"id":18226,"word":"循诵习传","pinyin":"xún sòng xí chuán","abbr":"xsxc","explanation":"①指习惯于读死书、传旧闻。②指诵习。","source":{"text":"固将制礼作乐，以复周唐之旧，岂终循诵习传，而守秦汉之余。","book":"《汉书·司马相如传下》：“且夫贤君之践位也，岂特委琐握龊，拘文牵俗，循诵习传，当世取说云尔哉！”宋·王安石《进修南郊敕式表》"},"example":{"text":"综录平素神化谋猷，恭辑成书，刊刻颁行，使军中将士～，知所取法，在在恪遵。","book":"太平天国《行军总要》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":18227,"word":"循蹈规矩","pinyin":"xún dǎo guī jǔ","abbr":"xdgj","explanation":"循、蹈：遵循，依照。规、矩：是定方圆的标准工具，借指行为的准则。原指遵守规矩，不敢违反。现也指拘守旧准则，不敢稍做变动。","source":{"text":"近岁有一二少年，虽开言有可喜者，而不肯循蹈规矩，好奇尚怪，遇事辄发。","book":"宋·朱弁《曲洧旧闻》卷九"}},{"id":18228,"word":"循途守辙","pinyin":"xún tú shǒu zhé","abbr":"xtsz","explanation":"遵守规矩。同“循涂守辙”。","source":{"text":"今当路一似循途守辙，殊不可解。","book":"明·归有光《与周子和大参》之二"},"example":{"text":"质虽驽下，无创得之智，无远略之怀，但能～，日诵数十行，时日既多，意者亦必有可观者焉。","book":"严复《道学外传》"},"similar":["循涂守辙","循规蹈矩"],"usage":"作宾语、定语；用于书面语"},{"id":18229,"word":"循道不违","pinyin":"xún dào bù wéi","abbr":"xdbw","explanation":"遵循道德规范而不违背它。","source":{"text":"循道不违，厥声弥劭；三女有从，二男知教。","book":"唐·韩愈《河南府法曹参军卢府君夫人苗氏墓志铭》"},"usage":"作谓语、定语；用于书面语"},{"id":18230,"word":"徬徨失措","pinyin":"páng huáng shī cuò","abbr":"phsc","explanation":"指心神不宁，举动失常。","source":{"text":"我母亲只气得面白唇青，一句话也没有，婶娘也是徬徨失措。","book":"清·吴趼人《二十年目睹之怪现状》第十八回"},"example":{"text":"燕主弘既忧外侮，复舍不得膝下宠儿，害得～，昼夜不安。","book":"蔡东藩《南北史演义》第十二回"}},{"id":18231,"word":"微不足录","pinyin":"wēi bù zú lù","abbr":"wbzl","explanation":"渺小得不值得记一笔。","source":{"text":"而夷狄无文字传记，朱邪又微不足录，故其后世自失其传。","book":"《新五代史·唐庄宗纪上》"},"similar":["微不足道"],"usage":"作谓语、定语、宾语；用于人或事物等"},{"id":18232,"word":"微不足道","pinyin":"wēi bù zú dào","abbr":"wbzd","explanation":"微：细，小；足：值得；道：谈起。微小得很，不值得一提。指意义、价值等小得不值得一提。","source":{"text":"其不言逆，何也？逆之道微，无足道焉尔。","book":"《谷梁传·隐公七年》"},"example":{"text":"在草花中我们虽然是～。但我们的花色却算是紫色代表。","book":"郭沫若《百花齐放·单色蓳》诗"},"similar":["微乎其微","不足挂齿"],"opposite":["举足轻重","硕大无朋"],"usage":"作谓语、定语、宾语；用于人"},{"id":18233,"word":"微为繁富","pinyin":"wei wei fan fu","abbr":"wwff","explanation":"稍微有些辞藻繁多。"},{"id":18234,"word":"微乎其微","pinyin":"wēi hū qí wēi","abbr":"whqw","explanation":"形容非常小或非常少。","source":{"text":"式微式微者，微微微者也。","book":"《尔雅·释训》"},"example":{"text":"富庶的河套，是黄河所给的一点点它口里所吐出的，和被它所吞没的比较起来，真是～了。","book":"臧克家《毛主席向着黄河笑》"},"similar":["微不足道","不足挂齿"],"opposite":["举足轻重","硕大无朋"],"usage":"作谓语、定语；用于人"},{"id":18235,"word":"微名薄利","pinyin":"wēi míng bó lì","abbr":"wmbl","explanation":"指十分细微的名与利。","source":{"text":"怎知客人为些微名薄利，又无枷锁拘缚，三伏内，只得在那途路中行。","book":"明·施耐庵《水浒传》第16回"},"usage":"作主语、宾语、定语；用于生活等"},{"id":18236,"word":"微妙玄通","pinyin":"wēi miào xuán tōng","abbr":"wmxt","explanation":"微妙：精微奥妙。精微深奥而灵通的道理。","source":{"text":"古之善为道者，微妙玄通，深不可识。","book":"《老子》第十五章"},"example":{"text":"具足元亨贞利，圆明～。眨眉目击莫形容，拈出般般妙用。","book":"元·姬翼《西江月》词"}},{"id":18237,"word":"微察秋毫","pinyin":"wēi chá qiū háo","abbr":"wcqh","explanation":"形容极细小的东西都看得很清楚。","source":{"text":"夫照镜子见眸子，微察秋毫，明照晦冥。","book":"西汉·刘安《淮南子·说山训》"},"similar":["明察秋毫"],"usage":"作谓语、定语；用于处事"},{"id":18238,"word":"微微之界","pinyin":"wēi wēi zhī jiè","abbr":"wwzj","explanation":"微：微小；界：边界，界限。极其细微的界限。","source":{"text":"赫赫显爵，自我队之；微微附庸，自我招之。","book":"《汉书·韦贤传》"}},{"id":18239,"word":"微故细过","pinyin":"wēi gù xì guò","abbr":"wgxg","explanation":"细过：小的过失。指微小的过失和事故。","source":{"text":"此亦大罪恶耳，其微故细过，当掩覆之。","book":"晋·陈寿《三国志·魏志·中山恭王衮传》"},"usage":"作宾语、定语；指微小的过失"},{"id":18240,"word":"微文深诋","pinyin":"wēi wén shēn dǐ","abbr":"wwsd","explanation":"想尽办法把无罪的人定成有罪。","source":{"text":"使治主父偃及治淮南反狱，所以微文深诋，杀者甚众。","book":"西汉·司马迁《史记·酷吏列传》"},"example":{"text":"～，众所严惮，愈于京师。","book":"唐·赵晔《东都留台石柱记》"},"usage":"作谓语；想尽办法把无罪的人定成有","story":["汉朝时期，卫青将军提拔河东咸宣做官。咸宣一路平步青云，一直做到中丞，他受命前去处理主父偃以及淮南叛乱的案子。他大显神通，以深奥难懂的文字罗列了许多人的罪名，大开杀戒，闹得人心惶惶。他的这种做法最终导致自杀"]},{"id":18241,"word":"微时故剑","pinyin":"wēi shí gù jiàn","abbr":"wsgj","explanation":"微时：贫贱的时候，没有发迹的时候；故剑：旧剑。比喻原来的妻子。","source":{"text":"是时公卿议更立皇后，亦未有言，上乃诏求微时故剑，大臣知指，白立许婕妤为皇后。","book":"《汉书·外戚传上·孝宣许皇后传》"}},{"id":18242,"word":"微显阐幽","pinyin":"wēi xiǎn chǎn yōu","abbr":"wxcy","explanation":"指显现微妙之处，阐明幽深之理。","source":{"text":"夫《易》彰往而察来，而微显阐幽，开而当名，辨物正言，断辞则备矣。","book":"《周易·系辞下》"},"example":{"text":"晋·杜预《序》：“其～，裁成义类者，皆据旧例而发义，指行事以正褒贬。”"},"usage":"作谓语、宾语；用于书面语"},{"id":18243,"word":"微服出巡","pinyin":"wēi fú chū xún","abbr":"wfcx","explanation":"微服：平民服饰；出巡：到地方巡查。旧指皇帝或官吏穿上平民服装进行暗访或查巡以了解真实情况。","source":{"text":"孔子不悦于鲁卫。遭宋桓司马，将要而杀之，微服而过宋。","book":"《孟子·万章下》"}},{"id":18244,"word":"微服私行","pinyin":"wēi fú sī xíng","abbr":"wfsx","explanation":"微服：平民服装。私行：秘密出行。旧指皇帝或官吏穿上平民服装秘密到民间探访民情或疑难重案。","source":{"text":"只是此行敛些光彩，不可喝道而去，只得微服私行罢。","book":"明·王世贞《鸣凤记·鄢赵争宠》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“谁也不知道他～。”"},"similar":["微服私访"],"usage":"作谓语、宾语；用于上级等"},{"id":18245,"word":"微机四伏","pinyin":"wēi jī sì fú","abbr":"wjsf","explanation":"到处隐藏着危险的祸根。"},{"id":18246,"word":"微波粼粼","pinyin":"wēi bō lín lín","abbr":"wbll","explanation":"微：细小；粼粼：细小的水波闪闪发光。 形容水石等很明净。","example":{"text":"春风从～的湖面上吹过，送走阵阵渔歌。"}},{"id":18247,"word":"微言大义","pinyin":"wēi yán dà yì","abbr":"wydy","explanation":"微言：精当而含义深远的话；大义：本指经书的要义，后指大道理。包含在精微语言里的深刻的道理。","source":{"text":"昔仲尼没而微言绝，七十子丧而大义乖。","book":"汉·刘歆《移书让太常博士书》：“及夫子殁而微言绝，七十子卒而大义乖。”《汉书·艺文志》"},"example":{"text":"他们解经，只重～；而所谓～，其实只是他们自己的历史哲学和政治哲学。","book":"朱自清《经典常谈·尚书第三》"},"similar":["言近旨远","言简意赅","微言精义"],"opposite":["空洞无物"],"usage":"作主语、宾语；指语言功夫好"},{"id":18248,"word":"微言大指","pinyin":"wēi yán dà zhǐ","abbr":"wydz","explanation":"微言：精微的言辞；大指：深刻的意旨。精微的言辞，深刻的道理。多就儒家经书而言。","source":{"text":"传山右阎氏之绪学，示二帝三王之微言大指，闵秦火之郁俨，悼孔泽之不完具。","book":"清·龚自珍《资政大夫礼郭侍郎武进公神道铭碑》"},"similar":["微言大义","微言精义"],"usage":"作主语、宾语；指语言功夫好"},{"id":18249,"word":"微言大谊","pinyin":"wēi yán dà yì","abbr":"wydy","explanation":"包含在精微语言里的深刻的道理。同“微言大义”。","source":{"text":"所以发明西汉《尚书》今、古文之微言大谊，而辟东汉马郑古文之凿空无师传也。","book":"清·魏源《序》"},"similar":["微言大义","微言大指","微言精义"],"usage":"作主语、宾语；指语言功夫好"},{"id":18250,"word":"微言精义","pinyin":"wēi yán jīng yì","abbr":"wyjy","explanation":"微言：精微的言辞；精义：深刻的道理。精微的言辞，深刻的道理。多就儒家经书而言。","source":{"text":"昔仲尼没而微言绝，七十子丧而大义乖。","book":"汉·刘歆《移书让太常博士书》：“及夫子殁而微言绝，七十子卒而大义乖。”《汉书·艺文志》"},"example":{"text":"读易至韦编三绝，不知繙阅过几千遍来，～，愈探愈出，愈研愈入，愈往而不知其所穷。","book":"清·郑燮《潍县置中寄舍弟墨第一书》"},"similar":["微言大义","微言大指"],"usage":"作主语、宾语；指语言功夫好"},{"id":18251,"word":"微谏不倦","pinyin":"wēi jiàn bù juàn","abbr":"wjbj","explanation":"谏：规劝；微谏：用委婉的言辞规劝。不知疲倦地反复耐心地用委婉的言辞规劝。","source":{"text":"从命不忿，微谏不倦，劳而不怨，可谓孝矣。","book":"《礼记·坊记》"}},{"id":18252,"word":"微过细故","pinyin":"wēi guò xì gù","abbr":"wgxg","explanation":"微小的过失和事故。","source":{"text":"其微过细故，当掩覆之。","book":"《三国志·魏书·中山恭王传》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":18253,"word":"徵名责实","pinyin":"zhēng míng zé shí","abbr":"zmzs","explanation":"徵：考察；责：求。指考察其名以求其实，就其言而观其行，以求名实相符。","source":{"text":"方欲杖兹舟楫，委成股肱，徵名责实，取宁多士。","book":"《陈书·宣帝纪》"}},{"id":18254,"word":"徵羽之操","pinyin":"zhǐ yǔ zhī cāo","abbr":"zyzc","explanation":"徵、羽：古代五音中的两个音调；操：琴曲的一种。指音调优雅的琴曲。","source":{"text":"徵羽之操，不入鄙人之耳。","book":"《淮南子·说林训》"},"usage":"作主语、宾语；指音乐"},{"id":18255,"word":"德以抱怨","pinyin":"dé yǐ bào yuàn","abbr":"dyby","explanation":"德：恩德；怨：仇怨，怨恨。以恩德回报仇怨。","source":{"text":"知敦以厉薄，德以抱怨，收骨育孤，哀亡愍存，捐既忘之猜，保六尺之托，诚深恩重分，美名厚实也。","book":"晋·陈寿《三国志·吴志·刘繇传》"},"similar":["以德报怨"],"usage":"作谓语、宾语、定语；用于品德高的人"},{"id":18256,"word":"德全如醉","pinyin":"dé quán rú zuì","abbr":"dqrz","explanation":"指跌落而没有受伤。","source":{"text":"夫醉者之坠车，虽疾不死。骨节与人同而犯害与人异，其神全也，乘亦不知也，坠亦不知也。死生惊惧不入乎其胸中，……彼得全于酒而犹若是，而况得全于天乎？","book":"《庄子·达生》"}},{"id":18257,"word":"德厚流光","pinyin":"dé hòu liú guāng","abbr":"dhlg","explanation":"德：道德，德行；厚：重；流：影响；光：通“广”。指道德高，影响便深远。","source":{"text":"天子七庙，诸侯五，大夫三，士二，故德厚者流光，德薄者流卑。","book":"《谷梁传·僖公十五年》"},"example":{"text":"今国家～，创立九庙。","book":"唐·韩愈《褅袷议》"},"usage":"作谓语；指德泽深厚使子孙受益"},{"id":18258,"word":"德容兼备","pinyin":"dé róng jiān bèi","abbr":"drjb","explanation":"德容：指女子的品德和容貌。兼备：都具备。品德和容貌都非常好。","source":{"text":"直待事成之后，方可与老爷得知。必用心访个德容兼备的，或者老爷才肯相爱。","book":"明·凌蒙初《初刻拍案惊奇》卷二十"},"example":{"text":"妃子世胄名家，～。取供内职，深惬朕心。","book":"清·洪昇《长生殿·定情》"},"usage":"作谓语、定语；多用于女性"},{"id":18259,"word":"德容言功","pinyin":"dé róng yán gōng","abbr":"dryg","explanation":"封建礼教要求妇女应具备的品德。","source":{"text":"语出《礼记·昏义》。见“德言容功”。"},"example":{"text":"那朱氏女生长宦门，模样双是著名出色的，真是～无不具足。","book":"《二刻拍案惊奇》卷十一"},"similar":["德言容功","德言工容","德言工貌"],"usage":"作宾语、定语；用于女性"},{"id":18260,"word":"德尊望重","pinyin":"dé zūn wàng zhòng","abbr":"dzwz","explanation":"犹言德高望重。","source":{"text":"吾主以令尹德尊望重，故令某等献上良马，以备驱驰之用。","book":"《东周列国志》第七五回"},"similar":["德高望重"],"usage":"作谓语、定语；用于称颂老人"},{"id":18261,"word":"德才兼备","pinyin":"dé cái jiān bèi","abbr":"dcjb","explanation":"德：品德；才：才能；备：具备。既有好的思想品质，又有工作的才干和能力。","source":{"text":"乃举梦解才德兼备，宜擢清要，以展所蕴。","book":"《元史·丰臧梦解传》"},"example":{"text":"陈云同志提出，我们选干部，要注意～。","book":"邓小平《党和国家领导制度的改革》"},"similar":["德高望重","又红又专"],"opposite":["德薄能鲜","德薄才疏"],"usage":"作定语、宾语；指有德有才"},{"id":18262,"word":"德本财末","pinyin":"dé běn cái mò","abbr":"dbcm","explanation":"指治国平天下，德为根本，财由德致，故理财为末。","source":{"text":"德能致财，财由德有，故德为本财为末也。","book":"语出《礼记·大学》：“德者，本也；财者，末也。”孔颖达疏"}},{"id":18263,"word":"德洋恩普","pinyin":"dé yáng ēn pǔ","abbr":"dyep","explanation":"指德泽优渥普及。","source":{"text":"盖闻中国有至仁焉，德洋恩普，物靡不得其所。","book":"汉·司马相如《难蜀父老》"},"example":{"text":"朝廷命将出师，不惜捐万万帑金，为民除害，～。","book":"《花月痕》第四六回"},"usage":"作谓语、定语；指恩德"},{"id":18264,"word":"德浅行薄","pinyin":"dé qiǎn xíng bó","abbr":"dqxb","explanation":"行：德行、品行。指品德、操行浅薄。","source":{"text":"道窃然难言哉，恐子德浅行薄，何以克当？","book":"明·朱权《冲模子》第二折"},"usage":"作谓语、定语；用于为人"},{"id":18265,"word":"德深望重","pinyin":"dé shēn wàng zhòng","abbr":"dswz","explanation":"德：品德；深：高；望：声望，名望。道德高尚，名望很大。多用于称颂年长与名位高的人。","source":{"text":"公若德深望重，宜膺大统；朕初平暴乱，岂敢当壁！","book":"南朝·宋·宋明帝《下庐江王玮诏》"},"similar":["德高望重"],"usage":"作谓语、定语；用于称颂老人"},{"id":18266,"word":"德胜头回","pinyin":"dé shèng tóu huí","abbr":"dsth","explanation":"德，通“得”。回，同“回”。宋明话本、通俗小说的引首。"},{"id":18267,"word":"德胜头迴","pinyin":"dé shèng tóu huí","abbr":"dsth","explanation":"德，通“得”。迴，同“回”。宋明话本、通俗小说的引首。"},{"id":18268,"word":"德艺双馨","pinyin":"dé yì shuāng xīn","abbr":"dysx","explanation":"形容一个人的德行和艺术（技艺）都具有良好的声誉。一般指从事艺术的人。","example":{"text":"梅兰芳先生不愧是一个德艺双馨的艺术家。"},"usage":"作谓语、定语；一般指从事艺术的人"},{"id":18269,"word":"德荣兼备","pinyin":"dé róng jiān bèi","abbr":"drjb","explanation":"品德贞淑而且仪容美好。旧时对女子的褒美之辞。","source":{"text":"直待事成之后，方可与老爷得知。必用心访个德容兼备的，我老爷总肯是一般相看。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"example":{"text":"妃子世胄名家，～，取供内职，深惬朕心。","book":"清·洪昇《长生殿·定情》"}},{"id":18270,"word":"德薄任重","pinyin":"dé bó rèn zhòng","abbr":"dbrz","explanation":"德行浅薄而责任重大。多用作谦词。","source":{"text":"德薄任重，惨惨忧虑。","book":"三国·蜀·诸葛亮《坐上与杜微书》"},"usage":"作谓语、定语；用于自谦"},{"id":18271,"word":"德薄才疏","pinyin":"dé bó cái shū","abbr":"dbcs","explanation":"薄：浅；疏：空虚。品行和才能都很差。常作谦辞。","source":{"text":"小弟德疏才薄，怎敢承当此位！若得居末，尚自过分。","book":"明·施耐庵《水浒全传》第六十八回"},"similar":["德薄能鲜","才疏学浅"],"opposite":["德才兼备"],"usage":"作谓语、定语；用于自谦"},{"id":18272,"word":"德薄才鲜","pinyin":"dé báo cái xiān","abbr":"dbcx","explanation":"自谦道德修养不足，才能薄弱。","example":{"text":"我自问～，不敢担当这个职位，恐负众望。"},"similar":["德薄能鲜"],"usage":"作谓语、定语；用于自谦"},{"id":18273,"word":"德薄望浅","pinyin":"dé bó wàng qiǎn","abbr":"dbwq","explanation":"薄：轻微；望：名望，声望。品德低下，名望轻微。","example":{"text":"我这个～的人不能担此重任。"},"similar":["德薄望轻"],"opposite":["德高望重"],"usage":"作谓语、定语；用于自谦"},{"id":18274,"word":"德薄望轻","pinyin":"dé bó wàng qīng","abbr":"dbwq","explanation":"薄：浅；望：声望。德行浅薄，名望轻微。","source":{"text":"而不幸发自德清望轻之口，又或以纤曲邪妄之说附会之，遂以不伸于天下，君子之所重叹也。","book":"清·王夫之《读通鉴论·唐玄宗》"},"similar":["德薄望浅"],"opposite":["德高望重"],"usage":"作谓语、定语；用于自谦"},{"id":18275,"word":"德薄能鲜","pinyin":"dé bó néng xiǎn","abbr":"dbnx","explanation":"鲜：少。德行浅薄，才能不足（表示自谦的话）。","source":{"text":"俾知夫小子修之德薄能鲜，遭时窃位，而幸全大节不辱其先者，其来有自。","book":"宋·欧阳修《泷冈阡表》"},"example":{"text":"我到手的帝位，不料竟成泡影，我是～，不容多说了。","book":"蔡东藩、许厪父《民国通俗演义》第六十七回"},"similar":["才疏学浅"],"opposite":["德高望重","德才兼备"],"usage":"作谓语、定语；指德行浅薄，才能不足"},{"id":18276,"word":"德被八方","pinyin":"dé pī bā fāng","abbr":"dbbf","explanation":"品德高尚，满布天下","source":{"text":"不可，不可！主公德被八方，名高天下，岂可称臣逆贼！","book":"明·郭勋《英烈传》第29回"},"example":{"text":"周文王与周武王～，才会取代殷纣的天下"},"similar":["德被四方"],"usage":"作谓语、定语；用于人"},{"id":18277,"word":"德被四方","pinyin":"dé bèi sì fāng","abbr":"dbsf","explanation":"品德高尚，满布天下。","example":{"text":"周文王与周武王～，才会取代殷纣的天下。"}},{"id":18278,"word":"德言容功","pinyin":"dé yán róng gōng","abbr":"dyrg","explanation":"德：妇德，品德。言：言辞。容：容貌。功：女红（旧指女子所做的针线活）。封建礼教要求妇女应具备的品德。","source":{"text":"是以古者妇人先嫁三日……教以妇德、妇言、妇容、妇功。","book":"《礼记·昏义》"},"example":{"text":"后十四，雅善歌辞，兼通音律，～，四者咸备。","book":"明·李昌祺《剪灯余话·琼奴传》"},"similar":["德容言功"],"usage":"作宾语；指封建礼教要求妇女应具备的品德"},{"id":18279,"word":"德言工容","pinyin":"dé yán gōng róng","abbr":"dygr","explanation":"封建礼教要求妇女应具备的品德。","source":{"text":"语出《礼记·昏义》。见“德言容功”。"},"example":{"text":"那时候，姑姑教给你那‘～’，就大有用处了。","book":"曹禺《五昭君》第一幕"},"similar":["德言工貌","德言容功"],"usage":"作宾语、定语；用于女性"},{"id":18280,"word":"德言工貌","pinyin":"dé yán gōng mào","abbr":"dygm","explanation":"指妇德、妇言、妇容、妇功。封建礼教要求妇女具备的四种德。","source":{"text":"非是咱自夸奖：他有德言工貌，小生有恭俭温良。","book":"元·王实甫《西厢记》第一本第二折"},"similar":["德言工容"],"usage":"作宾语、定语；用于女性"},{"id":18281,"word":"德輶如毛","pinyin":"dé yóu rú máo","abbr":"dyrm","explanation":"德轻得象羽毛一样。指施行仁德并不困难，而在于其志向有否。","source":{"text":"人亦有言：德輶如毛，民鲜克举之。我仪图之，维仲山甫举之，爱莫助之。","book":"《诗·大雅·丞民》"},"example":{"text":"‘～。’毛犹有伦，‘上天之载，无声无臭’，至矣 ！","book":"《诗》曰"},"similar":["德輶如羽"],"usage":"作宾语、定语；用于书面语"},{"id":18282,"word":"德輶如羽","pinyin":"dé yóu rú yǔ","abbr":"dyry","explanation":"指施行仁德并不困难，而在于其志向有否。同“德輶如毛”。","source":{"text":"仁道不遐，德輶如羽。求焉斯至，众鲜克举。","book":"晋·张华《励志诗》之三"},"similar":["德輶如毛"],"usage":"作宾语、定语；用于书面语"},{"id":18283,"word":"德配天地","pinyin":"dé pèi tiān dì","abbr":"dptd","explanation":"指道德可与天地匹配。极言道德之高尚盛大。","source":{"text":"夫子德配天地，而犹假至言以修心。","book":"《庄子田子方》"},"example":{"text":"香港人立维多利亚纪念碑曰：‘～’。","book":"清·邹容《革命军》"},"usage":"作谓语、定语、宾语；用于人的品行"},{"id":18284,"word":"德重恩弘","pinyin":"dé zhòng ēn hóng","abbr":"dzeh","explanation":"重：崇高、深厚；弘：通“宏”，大。道德高尚，恩惠广大。形容普施恩德。","source":{"text":"显荣频烦，称效寂蔑，又蒙赦其罪累，授以方州，德重恩弘。","book":"唐·韩愈《袁州刺史谢上表》"},"similar":["德洋恩普"],"usage":"作谓语、定语；用于人"},{"id":18285,"word":"德隆望尊","pinyin":"dé lóng wàng zūn","abbr":"dlwz","explanation":"犹言德高望重。同“德隆望重”。","source":{"text":"明·宋濂《送东阳马生序》；“先达德隆望尊，门人弟子填其室，未尝稍降辞色。”"},"similar":["德隆望重"],"usage":"作谓语、定语；用于称颂老人"},{"id":18286,"word":"德隆望重","pinyin":"dé lóng wàng zhòng","abbr":"dlwz","explanation":"犹言德高望重。","source":{"text":"元显因讽礼官下议，称己德隆望重，既录百揆，内外群僚皆应尽敬。","book":"《晋书·会稽文孝王道子传》"},"similar":["德隆望尊","德高望重"],"usage":"作谓语、定语；用于称颂老人"},{"id":18287,"word":"德音莫违","pinyin":"dé yīn mò wéi","abbr":"dymw","explanation":"德音：善言；莫违：不要违背。别人的好话不要不听。","source":{"text":"德音莫为，及尔同死。","book":"《诗经·邶风·谷风》"},"usage":"作谓语；用于劝诫人"},{"id":18288,"word":"德高望尊","pinyin":"dé gāo wàng zūn","abbr":"dgwz","explanation":"道德高，声望高。","source":{"text":"先达德高望尊，门人弟子填其室。","book":"明·宋濂《送东阳马生序》"},"example":{"text":"他是我们学院～的老教授。"},"similar":["德高望重"],"opposite":["无名鼠辈"],"usage":"作谓语、定语；指人声望高"},{"id":18289,"word":"德高望重","pinyin":"dé gāo wàng zhòng","abbr":"dgwz","explanation":"德：品德；望：声望。道德高尚，名望很大。","source":{"text":"元显因讽礼官下仪，称已德隆望重，既录百揆，内外群僚皆应尽敬。","book":"《晋书·简文三子传》"},"example":{"text":"我们家～，呼韩邪单于保护我们、信任我们。","book":"曹禺《王昭君》第三幕"},"similar":["众望所归","年高德劭"],"opposite":["无名鼠辈"],"usage":"作谓语、定语；用于称颂老人","story":["北宋时期出身贫寒的读书人富弼26岁踏上仕途，竭尽全力为朝廷尽忠。他始终以朝廷及百姓的利益为重，先后担任仁宗、英宗、神宗三朝宰相，在处理外交、边防及赈济灾民方面取得显著成就，司马光称颂他为“三世辅臣，德高望重。”"]},{"id":18290,"word":"德高毁来","pinyin":"dé gāo huǐ lái","abbr":"dghl","explanation":"品德高尚却招来毁谤。形容坏人总是嫉妒和毁谤品行高尚的人。","source":{"text":"是故事修而谤兴，德高而毁来。","book":"唐·韩愈《原毁》"}},{"id":18291,"word":"心上心下","pinyin":"xīn shàng xīn xià","abbr":"xsxx","explanation":"形容心神不安。","source":{"text":"觉新连忙到房里去把信写好，叫袁成送去。但是这也还不能使众人安心。众人还是心上心下的，害怕送信的袁成还没有回来，一连兵就开进来了。","book":"巴金《家》二三"}},{"id":18292,"word":"心不两用","pinyin":"xīn bù liǎng yòng","abbr":"xbly","explanation":"指一个人的心思一时只能专注于一事。","source":{"text":"使左手画方，右手画圆，令一时具成，虽执规矩之心，回剟劂之手，而不能者，由心不两用，则手不并运也。","book":"北齐·刘昼《新论·专学》"},"similar":["心无二用","心无二想","专心致志"],"opposite":["三心二意","心不在焉","一心二用"],"usage":"作定语、状语；用于处事等"},{"id":18293,"word":"心不二用","pinyin":"xīn bù èr yòng","abbr":"xbey","explanation":"心思不能同时用在两件事上。指做事要专心，注意力必须集中。","source":{"text":"使左手画方，右手画圆，令一时俱成，虽执规矩之心，回剟劂之手，而不能成者，由心不两用，则手不并运也。","book":"汉·桓谭《新论·专学》"}},{"id":18294,"word":"心不在焉","pinyin":"xīn bù zài yān","abbr":"xbzy","explanation":"心思不在这里。指思想不集中。","source":{"text":"心不在焉，视而不见，听而不闻，食而不知其味。","book":"《礼记·大学》"},"example":{"text":"讲话时做腔做势，而又带着～的样子，这似乎都是纨绔子弟的特征，普遍而一律的。","book":"柔石《二月》六"},"similar":["漫不经心","魂不守舍","心猿意马"],"opposite":["全神贯注","专心致志"],"usage":"作谓语、定语、状语；指思想不集中"},{"id":18295,"word":"心不应口","pinyin":"xīn bù yīng kǒu","abbr":"xbyk","explanation":"心里想的和嘴里说的不一致。指为人虚伪。","source":{"text":"恨他心不应口，把欢娱翻成僝僽。情儿泛泛，浑如江水流。","book":"明·杨德芳《步步娇·闺怨》曲"},"usage":"作谓语、定语；用于处事"},{"id":18296,"word":"心不由主","pinyin":"xīn bù yóu zhǔ","abbr":"xbyz","explanation":"为情感所激动，指神智不能由自己控制。","source":{"text":"张协本意无心娶你，在穷途身自不由己。况天寒举目又无亲，乱与伊家相娶。","book":"宋·无名氏《张协状元·张协贫女团圆》"},"example":{"text":"那兰儿几疑身入广寒，弄得神思恍惚，～。","book":"蔡东藩《慈禧太后演义》第二回"},"similar":["心不由己"],"usage":"作谓语、定语、状语；指不由自主"},{"id":18297,"word":"心不由己","pinyin":"xīn bù yóu jǐ","abbr":"xbyj","explanation":"不出于自己的本意。","source":{"text":"那彩霞之母，满心纵不愿意，见凤姐自和她说，何等体面，便心不由己的满口应了出去。","book":"清·曹雪芹《红楼梦》第72回"},"example":{"text":"我一时～，便答应了下来。"},"similar":["心不由主"],"usage":"作谓语、定语、状语；指不由自主"},{"id":18298,"word":"心不由意","pinyin":"xīn bù yóu yì","abbr":"xbyy","explanation":"指不出于本意。","source":{"text":"那彩霞之母满心纵不愿意，见风姐亲自和他说，何等体面，便心不由意的满口应了出去。","book":"《红楼梦》第七二回"},"usage":"作状语、定语；用于处事等"},{"id":18299,"word":"心不负人，面无惭色","pinyin":"xīn bù fù rén，miàn wú cán sè","abbr":"xbfrmwcs","explanation":"负：亏欠；惭：羞愧。内心没有对不起人的对方，表情也就会很坦然。","example":{"text":"我～，有什么好怕的。"},"usage":"作谓语、定语；用于处事等"},{"id":18300,"word":"心中无数","pinyin":"xīn zhōng wú shù","abbr":"xzws","explanation":"指对情况了解不清楚，心里没有底。","source":{"text":"他虽然素称‘博学’，熟读经史，可是对此却心中无数。","book":"蒋和森《风萧萧·冲天记一》"},"example":{"text":"做事前不能～。"},"similar":["一无所知","不知所以"],"opposite":["心中有数","了如指掌","如数家珍"],"usage":"作谓语；指心里没底"},{"id":18301,"word":"心中有数","pinyin":"xīn zhōng yǒu shù","abbr":"xzys","explanation":"对情况和问题有基本的了解，处理事情有一定把握。","source":{"text":"不徐不疾，得之于手而应于心，口不能言，有数存焉于其间。","book":"《庄子·天道》"},"example":{"text":"春玲要先同儒春谈一次，摸摸他的底，～，为她去和老东山交锋做准备。","book":"冯德英《迎春花》第八章"},"similar":["知己知彼","胸有成竹"],"opposite":["心中无数","一无所知"],"usage":"作谓语、宾语；指心里有底"},{"id":18302,"word":"心中没底","pinyin":"xīn zhōng méi dǐ","abbr":"xzmd","explanation":"心里不知道内情或不能预测而没有把握。","example":{"text":"我～，心老是怦怦直跳。"},"opposite":["心里有底","心中有数"],"usage":"作谓语、定语；指没有把握"},{"id":18303,"word":"心中芥蒂","pinyin":"xīn zhōng jiè dì","abbr":"xzjd","explanation":"芥蒂：本指细小的梗塞物，后比喻心里的不满或不快。指心里对人对事有怨恨或不愉快的情绪。","source":{"text":"吞若云梦者八九于其胸中，曾不芥蒂。","book":"汉·司马相如《子虚赋》"},"example":{"text":"那何桂柱原来有点瞧不起明珠拿大，今见他对伍次友十分体贴，倒去了～。","book":"二月河《康熙大帝》十三"}},{"id":18304,"word":"心为形役","pinyin":"xīn wéi xíng yì","abbr":"xwxy","explanation":"形：形体。心神被生活、功名利禄所驱使。形容人的思想不自由，做一些违心的事。","source":{"text":"既自以心为形役，奚惆怅而独悲？","book":"晋·陶潜《归去来辞》"},"usage":"作宾语、定语；用于书面语"},{"id":18305,"word":"心为行役","pinyin":"xīn wéi xíng yì","abbr":"xwxy","explanation":"为：被。心被形体所役使。指为生活所迫，不得不做一些违背自己心愿的事。","source":{"text":"既自以心为形役，奚惆怅而独悲。","book":"晋·陶渊明《归去来兮辞》"}},{"id":18306,"word":"心之官则思","pinyin":"xīn zhī guān zé sī","abbr":"xzgzs","explanation":"心：古人以为心是思维器官，所以把思想的器官、感情等都说做心，现指脑筋；官：官能，作用。脑筋的官能就是思维。","source":{"text":"心之官则思，思则得之，不思则不得也。","book":"《孟子·告子上》"},"example":{"text":"孟子说：“～。”他对脑筋的作用下了正确的定义。","book":"毛泽东《学习和时局》"},"usage":"作宾语、定语；用于劝诫人"},{"id":18307,"word":"心乔意怯","pinyin":"xīn qiáo yì qiè","abbr":"xqyq","explanation":"指心神不定，感到害怕。","source":{"text":"把不定心乔意怯，立不定肉颤身摇。","book":"元·张国宾《罗李郎》第二折"},"similar":["心惊肉跳"],"usage":"作谓语、状语；用于书面语"},{"id":18308,"word":"心乡往之","pinyin":"xīn xiāng wǎng zhī","abbr":"xxwz","explanation":"对某人或某些事物心里很仰慕。","source":{"text":"《诗》有之：‘高山仰止，景行行止。’虽不能至，然心乡往之。余读孔丘书，相见其为人。","book":"《史记·孔子世家》"},"similar":["心向往之"],"usage":"作谓语、定语；表示对人或事的向往"},{"id":18309,"word":"心乱如丝","pinyin":"xīn luàn rú sī","abbr":"xlrs","explanation":"心里乱得象一团乱丝线。形容心里非常烦乱。","source":{"text":"临晚景，忆当时，愁心一动乱如丝。","book":"《隋书·孙万寿传》：“心绪乱如麻，空怀畴昔时。”宋·晁补之《鹧鸪天》词"}},{"id":18310,"word":"心乱如麻","pinyin":"xīn luàn rú má","abbr":"xlrm","explanation":"心里乱得象一团乱麻。形容心里非常烦乱。","source":{"text":"此其心乱如麻可知也。","book":"元·五实甫《西厢记》第一本第二折金圣叹批"},"example":{"text":"想到这一点，他～，一夜都没有合过眼儿。","book":"欧阳山《苦斗》五四"},"similar":["心烦意乱","心神不定"],"opposite":["心旷神怡","从容不迫","悠然自得"],"usage":"作谓语、定语、状语；形容心里非常烦"},{"id":18311,"word":"心事重重","pinyin":"xīn shì chóng chóng","abbr":"xscc","explanation":"心里挂着很多沉重的顾虑。","source":{"text":"毛人凤正心事重重地在地毯上来回走着。","book":"罗广斌、杨益言《红岩》第二七章"},"example":{"text":"她近日来愁眉不展，像是～的样子。"},"similar":["忧心忡忡"],"usage":"作谓语、定语；指顾虑太多"},{"id":18312,"word":"心亿则乐","pinyin":"xīn yì zé lè","abbr":"xyzl","explanation":"亿：安。心中安适就会快乐。","source":{"text":"心亿则乐，窕则不咸。","book":"春秋·鲁·左丘明《左传·昭公二十一年》"},"usage":"作谓语、定语；用于处事等"},{"id":18313,"word":"心仪已久","pinyin":"xīn yí yǐ jiǔ","abbr":"xyyj","explanation":"仪：向往，仰慕。内心向往已经很久了。","source":{"text":"公卿议更立皇后，皆仪霍将军女。","book":"《汉书·外戚传上》"},"example":{"text":"少林庄严宝刹，小僧～，六十年前便来投拜求戒，却被拒之于山门之外。","book":"金庸《天龙八部》第三十九回"},"usage":"作谓语、定语；用于处事等"},{"id":18314,"word":"心低意沮","pinyin":"xīn dī yì jǔ","abbr":"xdyj","explanation":"指情绪消极低沉。","source":{"text":"今闻玉幽执牢槛，罪名已定，皆心低意沮，怅恨长叹。","book":"汉·申屠蟠《为缑氏女玉奏记外黄令》"},"usage":"作谓语、定语、状语；用于人的情绪等"},{"id":18315,"word":"心余力绌","pinyin":"xīn yú lì chù","abbr":"xylc","explanation":"心里想做但力量不够。","source":{"text":"邻家有李永者，尚气节，雅敬慕公，察公养亲之意有余而力不足，请助公以经纪，公亦信之不疑，竭赀付之一不问。","book":"宋·朱熹《金紫光禄大夫黄公墓志铭》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“海运局的事又不能不拖在那里，实在有点～。”"},"similar":["力不从心","力不胜任","无能为力"],"opposite":["游刃有余","得心应手","胜任愉快"],"usage":"作谓语、宾语；指力不从心"},{"id":18316,"word":"心倾神驰","pinyin":"xīn qīng shén chí","abbr":"xqsc","explanation":"倾：倾倒。形容对自己倾心爱慕的东西，心早已向往了。"},{"id":18317,"word":"心凝形释","pinyin":"xīn níng xíng shì","abbr":"xnxs","explanation":"精神凝聚，形体散释。指思想极为专注，简直忘记了自己身体的存在。","source":{"text":"心凝形释，骨肉都融。","book":"《列子·黄帝》"},"example":{"text":"苍然暮色，自远而至。至无所见，而犹不欲归。～，与万化冥合。","book":"唐·柳宗元《始得西山宴游记》"},"usage":"作谓语、定语；用于书面语"},{"id":18318,"word":"心到神知","pinyin":"xīn dào shén zhī","abbr":"xdsz","explanation":"旧时指只诚心敬神，就用不到烦琐的礼仪。比喻对人表示钦佩，不必有什么虚文浮礼。","source":{"text":"太太们这么一说，这就叫作心到神知了。","book":"清·曹雪芹《红楼梦》第11回"},"example":{"text":"～，不必过多注重礼节。"},"usage":"作谓语、宾语；比喻重在有心","story":["贾敬不问世事，一心想修炼成仙，他生日的那天，儿子贾珍不敢去打扰他，就派孙子贾蓉去寺庙送食品。王夫人与邢夫人以及王熙凤等过宁国府贺生，凤姐说不能亲自给大老爷拜寿，只有尽到心意了，这叫心到神知，满屋的人都笑了起来"]},{"id":18319,"word":"心力交瘁","pinyin":"xīn lì jiāo cuì","abbr":"xljc","explanation":"交：一齐，同时；瘁：疲劳。精神和体力都极度劳累。","source":{"text":"由此心力交瘁，患疾遂卒。","book":"清·淮阴百一居士《壶天录》卷上"},"example":{"text":"我们～，能报母亲的恩慈于万一么？（冰心《南归—贡献给母亲在天之灵》）"},"similar":["精疲力竭","疲惫不堪"],"opposite":["神采奕奕","生气勃勃"],"usage":"作谓语、定语、状语；用于人"},{"id":18320,"word":"心力衰竭","pinyin":"xīn lì shuāi jié","abbr":"xlsj","explanation":"也称充血性心力衰竭或心功能不全。心脏因疾病、过劳、排血功能减弱，以至排血量不能满足器官及组织代谢的需要。主要症状是呼吸困难、喘息、水肿等。","source":{"text":"‘啊？心力衰竭？’天星把妹妹抱上病床，他的胳膊在抖，嘴唇也在抖，妹妹的病把他吓傻了，“她还不满十八岁，怎么会……衰竭？","book":"霍达《穆斯林的葬礼》第八章"},"example":{"text":"他劳累过度，死于～"},"usage":"作谓语、定语、宾语；多用于身体"},{"id":18321,"word":"心动神驰","pinyin":"xīn dòng shén chí","abbr":"xdsc","explanation":"心神向往。形容思慕之情不能自持。","source":{"text":"系官在朝，心往神驰，送不临穴，哭不忘帷。","book":"宋·欧阳修《祭社公文》"},"example":{"text":"牌价窥见韩生之后，～，眠思梦想。深沈朱户，寂寂无聊，转辗绣衾，凄凄不寐。","book":"明·陆彩《怀香记·兰闺复命》"},"similar":["心往神驰","心驰神往"],"usage":"作定语、状语；用于处事等"},{"id":18322,"word":"心劳意冗","pinyin":"xīn láo yì rǒng","abbr":"xlyr","explanation":"心里着慌，乱了主意。同“心劳意攘”。","source":{"text":"昨夜个愁没乱更长漏永，今日个神恍惚心劳意冗。几时得山屐相逢满径踪，空留下千古恨。","book":"明·无名氏《女真观》第二折"},"similar":["心劳意攘","心劳意穰"],"usage":"作谓语、状语；用于书面语"},{"id":18323,"word":"心劳意攘","pinyin":"xīn láo yì rǎng","abbr":"xlyr","explanation":"犹心慌意乱。心里着慌，乱了主意。","source":{"text":"眼睁睁的要杀坏，空教我心劳意攘怎支划！","book":"元·刘庭信《端正好·金钱问卜》套曲：“一见了神魂飘荡，不由我心劳意攘。”元·张国宾《薛仁贵》第二折"},"example":{"text":"忧的是百姓苦，向御榻～。","book":"明·罗贯中《风云会》第三折"},"similar":["心劳意冗","心劳意穰","心烦意乱"],"opposite":["心旷神怡"],"usage":"作谓语、状语；用于书面语"},{"id":18324,"word":"心劳意穰","pinyin":"xīn láo yì rǎng","abbr":"xlyr","explanation":"劳：烦；穰：通“攘”，乱。心绪烦乱不宁。","source":{"text":"每日家作念的如心痒，没日不心劳意穰，常则是心绪悲伤。","book":"元·关汉卿《西蜀梦》第二折"},"similar":["心劳意攘","心劳意冗"],"usage":"作谓语、状语；用于书面语"},{"id":18325,"word":"心劳政拙","pinyin":"xīn láo zhèng zhuō","abbr":"xlzz","explanation":"心劳：费尽心机；拙：笨拙。虽然费尽必力，但却没有取得政绩。","source":{"text":"吏畏民怀，既仰安于明哲；心劳政拙，庶粗免于谴诃。","book":"宋·苏轼《谢监司启二首》其二"},"example":{"text":"～无遗爱，惭向甘棠驿里来。","book":"宋·范成大《甘棠驿》"}},{"id":18326,"word":"心劳日拙","pinyin":"xīn láo rì zhuō","abbr":"xlrz","explanation":"心劳：费尽心机；日：逐日；拙：笨拙。现多指做坏事的人，虽然使尽坏心眼，到头来不但捞不到好处，处境反而一天比一天糟。","source":{"text":"作德，心逸日休，作伪，心劳日拙。","book":"《尚书·周官》"},"example":{"text":"但是终于因为我有铁据足以证明这是毁谤诬蔑，他们徒然“～”，并不能达到他们的目的。","book":"邹韬奋《经历·社会的信用》"},"similar":["江河日下","徒劳无功"],"opposite":["欣欣向荣","蒸蒸日上"],"usage":"作谓语、补语、定语；指人做事方法不对"},{"id":18327,"word":"心劳计绌","pinyin":"xīn láo jì chù","abbr":"xljc","explanation":"绞尽脑汁，都想不出好的办法。","example":{"text":"他已经到了～的地步。"},"similar":["绞尽脑汁"],"usage":"作谓语、定语；指绞尽脑汁"},{"id":18328,"word":"心去难留","pinyin":"xīn qù nán liú","abbr":"xqnl","explanation":"去：离开。心已在别处，难以挽留。","source":{"text":"断弦犹可续，心去最难留。","book":"南朝梁·王僧孺《为姬人自伤》诗"},"similar":["去意已决"],"usage":"作谓语；用于劝诫人"},{"id":18329,"word":"心口不一","pinyin":"xīn kǒu bù yī","abbr":"xkby","explanation":"心里想的和嘴上说的不一样。形容人的虚伪、诡诈。","source":{"text":"我是这们个直性子，希罕就说希罕，不是这们心口不一的。","book":"《醒世姻缘传》第八十二回"},"example":{"text":"我竟失态到这地步，但我仍然～的。","book":"俞天白《危栏》"},"similar":["口是心非","言行不一"],"opposite":["心口如一"],"usage":"作主语、谓语、定语；指言行不一"},{"id":18330,"word":"心口如一","pinyin":"xīn kǒu rú yī","abbr":"xkry","explanation":"心里想的和嘴里说的一样。形容诚实直爽。","source":{"text":"紫芝妹妹嘴虽厉害，好在心口如一，直截了当，倒是一个极爽快的。","book":"清·李汝珍《镜花缘》第六十五回"},"example":{"text":"～，不说假话，这是做人起码应具有的品质。"},"similar":["表里如一","言行一致","心直口快"],"opposite":["心口不一","花言巧语","口是心非"],"usage":"作主语、谓语、定语；指人诚实"},{"id":18331,"word":"心口相应","pinyin":"xīn kǒu xiāng yīng","abbr":"xkxy","explanation":"想的与说的相一致。","source":{"text":"此须心行，不在口念。口念心不行，如幻如化，如露如电。口念心行，则心口相应。","book":"《坛经·般若品》"},"example":{"text":"武松笑道：‘若得嫂嫂这般做主，最好。只要～，却不应心头不似口头。’","book":"《金瓶梅词话》第二回"},"similar":["心口如一"],"opposite":["心口不一"],"usage":"作谓语、宾语、定语；用于处事"},{"id":18332,"word":"心同止水","pinyin":"xīn rú zhǐ shuǐ","abbr":"xtzs","explanation":"形容心境平静，毫无杂念。同“心如止水”。","source":{"text":"身觉浮云无所著，心同止水有何情。但知潇洒疏朝市, 不要崎岖隐姓名。","book":"唐·白居易《答元八郎中、杨十二博士》诗"},"example":{"text":"骨将槁木齐，～净。笔头指金波，座上横玉柄。","book":"唐·李山甫《山中答刘书记寓怀》诗"}},{"id":18333,"word":"心向往之","pinyin":"xīn xiàng wǎng zhī","abbr":"xxwz","explanation":"向往：崇敬仰慕。对某个人或事物心里很向往。","source":{"text":"虽不能至，然心向往之。","book":"《史记·孔子世家》"},"example":{"text":"闻曹州牡丹甲齐、鲁，～。","book":"清·蒲松龄《聊斋志异·葛中》"},"similar":["心驰神往","梦寐以求","求之不得"],"opposite":["心如死灰"],"usage":"作谓语、定语、分句；表示对人或事的向往"},{"id":18334,"word":"心和气平","pinyin":"xīn hé qì píng","abbr":"xhqp","explanation":"形容心气平静，态度温和。同“心平气和”。","source":{"text":"醉而愈恭，和而有礼，心和气平，无悖逆暴戾之气干于其间。","book":"宋·苏辙《既醉备五福论》"},"similar":["心平气和"],"usage":"作谓语、定语、状语；指不急躁"},{"id":18335,"word":"心回意转","pinyin":"xīn huí yì zhuǎn","abbr":"xhyz","explanation":"心、意：心思；回、转：掉转。改变想法，不再坚持过去的意见。","source":{"text":"且人一日间，此心是起多少私意，起多少计较，都不会略略回心转意去看。","book":"宋·朱熹《朱子语类·训门人·五》"},"example":{"text":"虽望着姑娘～，却绝不肯逼得姑娘理屈词穷。","book":"清·文康《儿女英雄传》第二十五回"},"similar":["回心转意","意转心回"],"opposite":["固执己见"],"usage":"作谓语、定语；指不再坚持过去的意见"},{"id":18336,"word":"心在魏阙","pinyin":"xīn zài wèi què","abbr":"xzwq","explanation":"指臣民心在朝廷，关心国事。魏阙，古代天子和诸侯宫外的楼观，其下悬布法令，因以代称朝廷。","source":{"text":"身在江海之上，心居乎魏阙之下。","book":"《庄子·让王》"},"example":{"text":"中山子牟～，而詹子不距。","book":"三国·魏·阮籍《达庄论》"},"similar":["心驰魏阙","心瞻魏阙"],"usage":"作谓语、定语；用于书面语"},{"id":18337,"word":"心地善良","pinyin":"xīn dì shàn liáng","abbr":"xdsl","explanation":"有道德、德行好，慈善。","source":{"text":"她是个心地善良、十分容易原谅别人的姑娘。","book":"王朔《空中小姐》"},"example":{"text":"她～，十分乐于助人。"},"similar":["菩萨心肠"],"opposite":["蛇蝎心肠"],"usage":"作谓语、定语；指人的心肠"},{"id":18338,"word":"心地正直","pinyin":"xīn dì zhèng zhí","abbr":"xdzz","explanation":"指为人正直，不存邪念。","example":{"text":"做人要～。"},"similar":["刚正不阿"],"opposite":["心怀叵测","居心不良"],"usage":"作谓语、定语；指为人正直"},{"id":18339,"word":"心地狭窄","pinyin":"xīn dì xiá zhǎi","abbr":"xdxz","explanation":"形容人气量小。","source":{"text":"听说那白衣秀士王伦的手下人都说他心地狭窄，安不得人。","book":"明·施耐庵《水浒全传》第十五回"},"example":{"text":"如今散了学，大家称了愿，也有丢开手的，也有～犹怀旧怨的。","book":"清·曹雪芹《红楼梦》第五十八回"},"similar":["心胸狭窄","小肚鸡肠"],"opposite":["宽宏大量"],"usage":"作谓语、定语；用于处事"},{"id":18340,"word":"心坚石穿","pinyin":"xīn jiān shí chuān","abbr":"xjsc","explanation":"意志坚决，能将石头穿透。比喻只要意志坚定，事情就能成功。","source":{"text":"而太极老君诣之，与之木钻，使穿一石盘，厚五尺许，云：‘穿此盘，便当得道。’其人乃昼夜穿之，积四十七年，钻尽石穿，遂得神丹，乃升太清，为南岳真人。","book":"南朝·梁·陶宏景《真诰》卷五"},"example":{"text":"怎知～，虔诚拜祷之极，果然感动了一位神仙。","book":"明·周楫《西湖二集·救金鲤海龙王报德》"},"similar":["水滴石穿"],"usage":"作谓语、定语；指人的意志坚定","story":["传说从前有一个从小就爱好道术的傅先生，到焦山石室中的第7年，太上老君去拜访他并送他一个木钻，让他钻穿厚5尺的石盘就可得道。他日夜钻磨，终于用了47年才钻穿石盘，得到神丹得道升天，被玉帝封为南岳真人"]},{"id":18341,"word":"心头刺，眼中疔","pinyin":"xīn tóu cì，yǎn zhōng dīng","abbr":"xtcyzd","explanation":"疔：疔疮。比喻心目中最痛恨、最讨厌的人。","source":{"text":"你所事无成，见兄弟，心头刺，眼中疔。","book":"元·萧德祥《杀狗劝夫》第三折"},"similar":["眼中钉，肉中刺"],"usage":"作宾语、定语；多用于比喻句"},{"id":18342,"word":"心头撞鹿","pinyin":"xīn tóu zhuàng lù","abbr":"xtzl","explanation":"心里像有小鹿在撞击。形容惊慌或激动时心跳剧烈。","source":{"text":"王庆看到好处，不觉心头撞鹿，骨软筋麻，好便似雪狮子向火，霎时间酥了半边。","book":"明·施耐庵《水浒传》第一○一回"},"similar":["心头鹿撞"],"usage":"作宾语、定语；用于比喻句"},{"id":18343,"word":"心头鹿撞","pinyin":"xīn tóu lù zhuàng","abbr":"xtlz","explanation":"形容惊慌或激动时心跳剧烈。同“心头撞鹿”。","source":{"text":"不要说是看见了和尚头才担心事，就是看见了天生的禿子，也觉得心头小鹿撞个不住。","book":"《负曝闲谈》第九回"},"example":{"text":"这托名李双双的文弱少年果然是吕四娘！唐晓澜又喜又惊，～，跳个不停！","book":"梁羽生《江湖三女侠》第八回"},"similar":["心头撞鹿"],"usage":"作宾语、定语；用于比喻句"},{"id":18344,"word":"心奓体忲","pinyin":"xīn chǐ tǐ tài","abbr":"xztt","explanation":"奓：通“侈”，奢侈；忲：通“泰”，过度。心志放逸，身体骄纵。","source":{"text":"有凭虚公子者，心奓体忲，雅好博古，学乎旧史氏。","book":"汉·张衡《西京赋》"},"usage":"作谓语、定语；用于书面语"},{"id":18345,"word":"心奓体泰","pinyin":"xīn chǐ tǐ tài","abbr":"xztt","explanation":"奓：通“侈”，放逸；泰：安泰。指养尊处优者心情放逸而身体舒泰。","source":{"text":"有凭虚公子者，心奓体泰，雅好博古。","book":"汉·张衡《西京赋》"}},{"id":18346,"word":"心如刀刺","pinyin":"xīn rú dāo cì","abbr":"xrdc","explanation":"内心痛苦得象被刀刺一样。","source":{"text":"里头翠翠闻知此信，心如刀刺，只得对将军说了，要到书房中来看看哥哥的病症。","book":"明·凌濛初《二刻拍案惊奇》卷六"},"example":{"text":"迂奶奶听了，更是～，又是羞，又是恼，又是痛，又是怕。","book":"清·跨趼人《二十年目睹之怪现状》第九十六回"}},{"id":18347,"word":"心如刀剉","pinyin":"xīn rú dāo yíng","abbr":"xrdc","explanation":"犹心如刀割。内心痛苦得象刀割一样。"},{"id":18348,"word":"心如刀割","pinyin":"xīn rú dāo gē","abbr":"xrdg","explanation":"内心痛苦得象刀割一样。","source":{"text":"待着些粗粝，眼睁睁俺子母各天涯，想起来我心如刀割。","book":"元·秦简夫《赵礼让肥》第一折"},"example":{"text":"又李听说，～，顾不得任公在坐，竟是放声大哭。","book":"清·夏敬渠《野叟曝言》第二十一回"},"similar":["痛不欲生","肝肠寸断"],"opposite":["欢天喜地","欣喜若狂"],"usage":"作谓语、定语、状语；形容极其痛苦"},{"id":18349,"word":"心如刀搅","pinyin":"xīn rú dāo jiǎo","abbr":"xrdj","explanation":"犹心如刀割。内心痛苦得象刀割一样。","source":{"text":"废了经史，弃了霜毫，每日家闷恹恹如痴似醉魂暗消，额似锥剜，心如刀搅，无语寂寥。","book":"元·汤氏《赛鸿秋·北》套曲"},"example":{"text":"休叫如此，一发叫我～一般。","book":"清·李绿园《歧路灯》第四十七回"},"similar":["心如刀锉","心如刀锯","心如刀割"],"usage":"作谓语、定语、状语；形容极其痛苦"},{"id":18350,"word":"心如刀绞","pinyin":"xīn rú dāo jiǎo","abbr":"xrdj","explanation":"内心痛苦得象刀割一样。","source":{"text":"待着些粗粝，眼睁睁俺子母各天涯，想起来我心如刀割。","book":"元·秦简夫《赵礼让肥》第一折"},"example":{"text":"殷郊又见殷洪，～，意似油煎。","book":"明·许仲琳《封神演义》第九回"},"similar":["心如刀割"],"opposite":["心满意足"],"usage":"作谓语、定语；形容内心痛苦到极点"},{"id":18351,"word":"心如刀锉","pinyin":"xīn rú dāo cuò","abbr":"xrdc","explanation":"犹心如刀割。内心痛苦得象刀割一样。","source":{"text":"病魔，心如刀锉，对青铜知鬓皤。","book":"元·周文质《蝶恋花·悟迷》曲"},"similar":["心如刀搅","心如刀绞","心如刀割"],"usage":"作谓语、定语、状语；形容极其痛苦"},{"id":18352,"word":"心如刀锯","pinyin":"xīn rú dāo jù","abbr":"xrdj","explanation":"犹心如刀割。内心痛苦得象刀割一样。","source":{"text":"不刺则俺这歹名儿怎地了，惊急列心如刀锯，颤笃速身如火燎。","book":"明·罗贯中《风云会》第二折"},"similar":["心如刀搅","心如刀割","心如刀绞"],"usage":"作谓语、定语、状语；形容极其痛苦"},{"id":18353,"word":"心如古井","pinyin":"xīn rú gǔ jǐng","abbr":"xrgj","explanation":"古井：年代久远的枯井。内心象不起波澜的枯井。形容心里十分平静或一点也不动情。","source":{"text":"波澜誓不起，妾心古井水。","book":"唐·孟郊《烈女操》诗"},"example":{"text":"全国受过教育的女子，无论已嫁未嫁，有夫无夫，个个～，脸若严霜。","book":"鲁迅《坟·寡妇主义》"},"similar":["心如止水"],"opposite":["心潮澎湃"],"usage":"作谓语、定语；形容心里十分平静"},{"id":18354,"word":"心如坚石","pinyin":"xīn rú jiān shí","abbr":"xrjs","explanation":"心象铁石一样坚硬。比喻心肠硬或意志十分坚决。同“心如铁石”。","source":{"text":"又有一种男不慕色，女不怀春，志比精金，心如坚石，没来由被旁人播弄，设圈设套，一时失了把柄，堕其术中，事后悔之无及。","book":"明·冯梦龙《警世通言》第三十五卷"},"similar":["心如金石","心如铁石"],"usage":"作谓语、定语；指人的心肠硬"},{"id":18355,"word":"心如寒灰","pinyin":"xīn rú hán huī","abbr":"xrhh","explanation":"形容不为外物所动的一种精神状态。现多用以形容灰心失意。同“心若死灰”。","source":{"text":"失意多病，衰不待年，心如寒灰，头有白发。","book":"唐·刘禹锡《上杜司徒启》"},"similar":["心若死灰","心如死灰"],"usage":"作谓语、定语；用于处事"},{"id":18356,"word":"心如悬旌","pinyin":"xīn rú xuán jīng","abbr":"xrxj","explanation":"形容心神不定。","source":{"text":"寡人卧不安席，食不甘味，心摇摇如悬旌，而无所终薄。","book":"《战国策·楚策一》"},"similar":["心神不定"],"usage":"作谓语；指心神不定"},{"id":18357,"word":"心如木石","pinyin":"xīn rú mù shí","abbr":"xrms","explanation":"心灵像树木石头一样，毫无情感、欲念。","source":{"text":"君不以异类见薄，故为悦己者容，北室生心如木石，吾安敢近？","book":"《五灯会元·百丈怀海禅师》：“一切诸法，莫记忆，莫缘念，放舍身心，令其自在，心如木石，无所辨别。”清·纪昀《阅微草堂笔记·滦阳消夏录四》"},"example":{"text":"……十余年人事沧桑，往事亦多不堪回首。而余尚在人间，并于灯下读书作字，忆及生者逝者，～，不知其所感矣。","book":"孙犁《书衣文录·翁藏宋拓九成宫》"},"similar":["麻木不仁"],"usage":"作谓语、定语；用于处事等"},{"id":18358,"word":"心如槁木","pinyin":"xīn rú gǎo mù","abbr":"xrgm","explanation":"犹心若死灰。形容不为外物所动的一种精神状态。现多用以形容灰心失意。","source":{"text":"那做媒的便络绎不绝，这个夸说张家小姐才能，那个夸说李家小姐标致，说的心如槁木的一位太史公，心中活泼泼起来。","book":"清·吴研人《二十年目睹之怪现状》第七十回"},"similar":["心若死灰"],"usage":"作谓语、定语；用于处事"},{"id":18359,"word":"心如止水","pinyin":"xīn rú zhǐ shuǐ","abbr":"xrzs","explanation":"形容心境平静，毫无杂念。","source":{"text":"浩浩世途，是非同轨；齿牙相轧，波澜四起。公独何人，心如止水；风雨如晦，鸡鸣不已。","book":"唐·白居易《祭李侍郎文》"},"example":{"text":"屡遭情变之后，她已然～，古井无波。"},"usage":"作谓语、定语；用于处事"},{"id":18360,"word":"心如死灰","pinyin":"xīn rú sǐ huī","abbr":"xrsh","explanation":"死灰：已冷却的灰烬。原指心境淡漠，毫无情感。现也形容意志消沉，态度冷漠到极点。","source":{"text":"形固可使如槁木，而心固可使如死灰乎？","book":"《庄子·齐物论》"},"example":{"text":"我纵然～，也难把往事轻易忘记。","book":"巴金《家》二十"},"similar":["心灰意冷","心若死灰","心如寒灰"],"usage":"作谓语、定语；指人意志消沉"},{"id":18361,"word":"心如火焚","pinyin":"xīn rú huǒ fén","abbr":"xrhf","explanation":"心中好像火烧一样。形容焦急万分。","source":{"text":"我托他打听几时有船，他查了一查，说道：‘要等三四天呢。’我越发觉得心急如焚，然而也是没法的事，成日里犹如坐在针毡上一般。","book":"清·吴趼人《二十年目睹之怪现状》"},"similar":["心急如焚","迫不及待"],"opposite":["不慌不忙","从容不迫"],"usage":"作谓语、定语；指十分焦急"},{"id":18362,"word":"心如芒刺","pinyin":"xīn rú máng cì","abbr":"xrmc","explanation":"芒：植物的刺。心里像芒刺扎一样难受。形容心里极其痛苦。","source":{"text":"荀息心如芒刺，草草毕葬，即使‘二五’勤兵助攻，自己奉卓子于朝堂，以俟好音。","book":"明·冯梦龙《东周列国志》第28回"},"usage":"作谓语、定语；用于处事"},{"id":18363,"word":"心如金石","pinyin":"xīn rú jīn shí","abbr":"xrjs","explanation":"犹心如铁石。比喻心肠硬或意志十分坚决。","source":{"text":"此家率下江诸将辅翼汉室，心如金石，真忠臣也。","book":"《后汉书·王常传》"},"example":{"text":"危如累卵，设非知远～，怎成大业？","book":"《五代史平话·晋史·卷下》"},"similar":["心如坚石","心如铁石"],"usage":"作谓语、定语；指人的心肠硬"},{"id":18364,"word":"心如铁石","pinyin":"xīn rú tiě shí","abbr":"xrts","explanation":"心象铁石一样坚硬。比喻心肠硬或意志十分坚决。","source":{"text":"忠能勤事，心如铁石，国之良吏也。","book":"汉·曹操《敕王必领长史令》"},"example":{"text":"子龙从我于患难，～，非富贵所能动摇也。","book":"明·罗贯中《三国演义》第四十一回"},"similar":["冷若冰霜","铁石心肠"],"opposite":["喜形于色"],"usage":"作谓语；指人的心肠硬"},{"id":18365,"word":"心存目想","pinyin":"xīn cún mù xiǎng","abbr":"xcmx","explanation":"指凝目注视，用心思索。","source":{"text":"杨君缄书赍图请予为记。予按图握笔，心存目想，覼缕梗概，十不得其二三。","book":"唐·白居易《白蘋洲五亭记》"},"example":{"text":"汝先当求一墙，张绢素讫，倚之败墙之上，朝夕观之。观之既久，隔素见败墙之上，高平曲折；皆成山水之象。～，高者为山，下者为水。","book":"宋·沈括《梦溪笔谈·书画》"},"usage":"作谓语、定语；用于处事"},{"id":18366,"word":"心存目替","pinyin":"xīn cún mù tì","abbr":"xcmt","explanation":"存：想念；替：废弃。心里虽然想念，但已废弃看望的行动。","source":{"text":"历试无效，且有家艰，心存目替，赋诗申怀。","book":"晋·傅咸《赠何劭王济诗序》"},"usage":"作宾语、定语；用于书面语"},{"id":18367,"word":"心存目识","pinyin":"xīn cún mù zhì","abbr":"xcms","explanation":"识：记。指对某种事物心中已有深刻的印象。","source":{"text":"退披其编以读之，尽其书，无有不能，吾固心存而目识矣。","book":"唐·韩愈《送孟秀才序》"}},{"id":18368,"word":"心存芥蒂","pinyin":"xīn cún jiè dì","abbr":"xcjd","explanation":"芥蒂：本指细小的梗塞物，后比喻心里的不满或不快。指心里对人对事有怨恨或不愉快的情绪。","source":{"text":"吞若云梦者八九于其胸中，曾不芥蒂。","book":"汉·司马相如《子虚赋》"},"example":{"text":"若在平时，吴佩孚定要反对，此际却～，貌为客气。","book":"蔡东藩、许厪父《民国通俗演义》第一百二十六回"},"usage":"作谓语、定语、状语；用于处事"},{"id":18369,"word":"心存高官，志在巨富","pinyin":"xīn cún gāo guān，zhì zài jù fù","abbr":"xcggzzjf","explanation":"存：想念。一心想做高官，大富大贵。","source":{"text":"彼以为周、程、张、朱者，皆口谈道德而心存高官，志在巨富。","book":"明·李贽《焚书·又与焦弱侯》"},"usage":"作谓语、定语；用于处世等"},{"id":18370,"word":"心存魏阙","pinyin":"xīn cún wèi què","abbr":"xcwq","explanation":"魏阙：古代天子及诸侯宫门外筑有高楼，其下两旁悬布法令，故代称朝廷。形容臣民忠君，关心国事。","source":{"text":"身在江海之上，心居乎魏阙之下。","book":"《庄子·让王》"},"example":{"text":"谁知道，～，身暂寄江湖。","book":"宋·俞国宝《满庭芳》词"}},{"id":18371,"word":"心孤意怯","pinyin":"xīn gū yì qiè","abbr":"xgyq","explanation":"指心虚而胆气不壮。","source":{"text":"士卒本将，一朝相失，心孤意怯，难以有功。","book":"唐·韩愈《论淮西事宜状》"},"example":{"text":"彼接济既断，又惧我师之袭其后，～，必且速退。","book":"清·薛福成《酌议北洋海防水师章程》"},"usage":"作谓语、定语、状语；用于处事等"},{"id":18372,"word":"心安理得","pinyin":"xīn ān lǐ dé","abbr":"xald","explanation":"得：适合。自以为做的事情合乎道理，心里很坦然。","source":{"text":"原来我们只求自己心安理得，那外界的苦乐原是不足计较。","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"example":{"text":"到后来忘却了真,相信了谎,也就～,天趣盎然了起来。","book":"鲁迅《病后杂谈》"},"similar":["问心无愧"],"opposite":["忐忑不安","问心有愧"],"usage":"作谓语、宾语、定语；指心里很坦然"},{"id":18373,"word":"心安神定","pinyin":"xīn ān shén dìng","abbr":"xasd","explanation":"心神都很安定。","source":{"text":"紫鹃自那日也着实后悔，如今日夜辛苦，并没有怨意。袭人等皆心安神定。","book":"清·曹雪芹《红楼梦》第57回"},"opposite":["局促不安"],"usage":"作谓语、定语、状语；用于人的情绪"},{"id":18374,"word":"心安神泰","pinyin":"xīn ān shén tài","abbr":"xast","explanation":"心神安宁，泰然自如。","source":{"text":"诵得久了，狄希陈口内常有异香喷出，恶梦不生，心安神泰。","book":"清·西周生《醒世姻缘传》第一百回"},"usage":"作谓语、宾语；用于人的心态等"},{"id":18375,"word":"心宽体肥","pinyin":"xīn kuān tǐ féi","abbr":"xktf","explanation":"心情舒畅，身体肥胖。","source":{"text":"待雄飞海内应无几，纵饥寒心宽体肥。","book":"明·孙仁孺《东郭记·人之所以求富贵利达者》"},"similar":["心宽体胖"],"usage":"作谓语、定语；指人心胸开阔"},{"id":18376,"word":"心宽体胖","pinyin":"xīn kuān tǐ pán","abbr":"xktp","explanation":"原指人心胸开阔，外貌就安详。后用来指心情愉快，无所牵挂，因而人也发胖。","source":{"text":"富润屋，德润身，心广体胖。","book":"《礼记·大学》"},"example":{"text":"～的老板，满面春风地迎上来，拉大家进店休息。"},"similar":["心广体胖","心宽体肥"],"usage":"作谓语、定语；指人心胸开阔"},{"id":18377,"word":"心宽意爽","pinyin":"xīn kuān yì shuǎng","abbr":"xkys","explanation":"指心情开朗，意兴闲适自得。","source":{"text":"熟视徐行路觉平，心宽意适步更轻。","book":"元·许谦《白云集·马公岭》"},"example":{"text":"当时刘伯骥到得此处，观看了一回景致，倒也～。","book":"清·李宝嘉《文明小史》第八回"}},{"id":18378,"word":"心宽意适","pinyin":"xīn kuān yì shì","abbr":"xkys","explanation":"指心情开朗，意兴闲适自得。","source":{"text":"熟视徐行路觉平，心宽意适步更轻。","book":"元·许谦《白云集·马公岭》"},"example":{"text":"喝了几口茶，便命内侍服侍睡下，觉得～，头一着枕，早已沉沉睡去。","book":"许慕羲《宋代宫闱史》第十九回"}},{"id":18379,"word":"心寒胆战","pinyin":"xīn hán dǎn zhàn","abbr":"xhdz","explanation":"形容十分惊恐。","source":{"text":"讲鬼怪，令羽士心寒胆战；论闺怨，遣佳人绿惨红愁。","book":"宋·罗烨《醉翁谈录·小说开辟》"},"example":{"text":"今掌兵权居边镇者，皆膏粱子弟，闻吾兵骤进攻打，～，望风逃窜不暇，尚敢来争斗耶！","book":"《杨家将》第五十回"},"similar":["胆战心寒","心寒胆落","心寒胆碎"],"usage":"作谓语、定语、状语；用于处事"},{"id":18380,"word":"心寒胆碎","pinyin":"xīn hán dǎn suì","abbr":"xhds","explanation":"形容十分惊恐。同“心寒胆战”。","source":{"text":"心寒胆碎，悔之作不是。不合共它设计，都是一时情意。","book":"元·无名氏《小孙屠》第二十一出"},"similar":["心寒胆落","心寒胆战"],"usage":"作谓语、定语、状语；用于处事"},{"id":18381,"word":"心寒胆落","pinyin":"xīn hán dǎn luò","abbr":"xhdl","explanation":"形容十分惊恐。同“心寒胆战”。","source":{"text":"皇兄赐俺金链一条，专打不忠之辈。每每怀藏袖中，携之出入，以此在朝官员，见俺无不心寒胆落。","book":"元·无名氏《抱妆盒》楔子"},"example":{"text":"我意当趁此大胜之势，盛兵而前，使敌人～。","book":"《英烈传》第六十七回"},"similar":["心寒胆战","心寒胆碎"],"usage":"作谓语、定语、状语；用于处事"},{"id":18382,"word":"心寒齿冷","pinyin":"xīn hán chǐ lěng","abbr":"xhcl","explanation":"张口叹气的时间长了，牙齿会感到寒冷。形容对于挫伤感情或伤心的事的感叹。"},{"id":18383,"word":"心小志大","pinyin":"xīn xiǎo zhì dà","abbr":"xxzd","explanation":"办事小心，抱负远大。","source":{"text":"凡人之论，心欲小而志欲大，智欲圆而行欲方，能欲多而事欲鲜。","book":"《淮南子·主术训》"},"usage":"作谓语、定语；指人的志向"},{"id":18384,"word":"心巧嘴乖","pinyin":"xīn qiǎo zuǐ guāi","abbr":"xqzg","explanation":"心思灵巧，能说会道。","source":{"text":"惟有那第十个媳妇聪明伶俐，心巧嘴乖，公婆最疼。","book":"清·曹雪芹《红楼梦》第五十四回"}},{"id":18385,"word":"心平德和","pinyin":"xīn píng dé hé","abbr":"xpdh","explanation":"心情平静，态度温和。指不急躁，不生气。","source":{"text":"君子听之，以平其心，心平德和。","book":"《左传·昭公二十年》"}},{"id":18386,"word":"心平气和","pinyin":"xīn píng qì hé","abbr":"xpqh","explanation":"心情平静，态度温和。指不急躁，不生气。","source":{"text":"先生心平而气和，故虽老而体胖。","book":"宋·苏轼《菜羹赋》"},"example":{"text":"一想到事情的前因后果，他也就～了。"},"similar":["平心静气","从容不迫"],"opposite":["气急雷霆","气冲斗牛"],"usage":"作谓语、定语、状语；指不急躁"},{"id":18387,"word":"心平气定","pinyin":"xīn píng qì dìng","abbr":"xpqd","explanation":"心气平定，没有杂念。","source":{"text":"孔子在齐闻韶，三月不知肉味。言至乐使人无欲，心平气定，不以肉为滋味也。","book":"三国·魏·阮籍《乐论》"},"example":{"text":"士大夫～，高不为名所眩，下不为利所怵者，类能知之。","book":"宋·苏辙《汉武帝论》"},"similar":["平心静气"],"usage":"作谓语、定语、状语；用于处事等"},{"id":18388,"word":"心平气温","pinyin":"xīn píng qì wēn","abbr":"xpqw","explanation":"心情平静，态度温和。指不急躁，不生气。","source":{"text":"学博才兼裕，心平气自温。","book":"宋·张镃《读乐天诗》"}},{"id":18389,"word":"心平气舒","pinyin":"xīn píng qì shū","abbr":"xpqs","explanation":"心情平静，态度平和。指不急躁，不生气。","source":{"text":"公醇厚端靖，内外完好，心平而气舒，虽久处者，未尝际其喜怒。","book":"宋·曾协《左朝请大夫前知建昌军陆公行状》"}},{"id":18390,"word":"心广体胖","pinyin":"xīn guǎng tǐ pán","abbr":"xgtp","explanation":"广：宽广，坦率；胖：安泰舒适。原指人心胸开阔，外貌就安详。后用来指心情愉快，无所牵挂，因而人也发胖。","source":{"text":"富润屋，德润身，心广体胖。","book":"《礼记·大学》"},"example":{"text":"这时我无端有些感慨，心里想，大家现在都说“灾官”“灾官”，殊不知“～”的还不在少呢。","book":"鲁迅《华盖集续编·记“发薪”》"},"similar":["心宽体胖","大腹便便","脑满肠肥"],"opposite":["骨瘦如柴","面黄肌瘦"],"usage":"作谓语、定语、状语；指心情愉快，事事顺心"},{"id":18391,"word":"心开意适","pinyin":"xīn kāi yì shì","abbr":"xkys","explanation":"适：悟。思想得以开通，意味得以领悟。","source":{"text":"幼年方小时，受《论语》、《尚书》，虽未能究解精微，而依说与今不异。由是心开意适，日诵千有余言。","book":"唐·萧颖士《赠韦司业书》"}},{"id":18392,"word":"心开目明","pinyin":"xīn kāi mù míng","abbr":"xkmm","explanation":"犹心明眼亮。形容看问题敏锐，能辨别是非。","source":{"text":"闻陛下即位河北，心开目明，今得见阙庭，死无遗恨。","book":"《后汉书·王常传》"},"example":{"text":"奏议多矣，而唐独称陆宣公者……使人读其言，便自～，惟恐其言之易尽也。","book":"明·李贽《李中丞奏议序》"},"similar":["心明眼亮"],"usage":"作谓语、定语；用于书面语"},{"id":18393,"word":"心弛神往","pinyin":"xīn chí shén wǎng","abbr":"xcsw","explanation":"弛：心神向往。心神奔向所向往的事物。形容一心向往。","source":{"text":"身在边隅，情弛魏阙。","book":"《隋书·史祥传》"},"example":{"text":"那美丽如画的山水真让我～。"},"similar":["心向往之","梦寐以求"],"opposite":["犹豫不决"],"usage":"作谓语；指一心向往"},{"id":18394,"word":"心往神驰","pinyin":"xīn wǎng shén chí","abbr":"xwsc","explanation":"指一心向往。","source":{"text":"自公之丧，道路嗟咨。况于愚鄙，久辱公知；系官在朝，心往神驰，送不临冗，哭不望帷。","book":"宋·欧阳修《祭杜祁公文》"},"similar":["心动神驰","心驰神往"],"usage":"作定语、状语；用于处事等"},{"id":18395,"word":"心得意会","pinyin":"xīn dé yì huì","abbr":"xdyh","explanation":"会：领悟，理解。指对方没有明说，心里已经领会。","source":{"text":"余尝问诗于圣俞，其声律之高下，文语之疵病，可以指而告余也。至其心之得者，不可以言而告也。余亦将以心得意会而未能至之者也。","book":"宋·欧阳修《书梅圣俞稿后》"},"example":{"text":"余于先生之诗，亦惟～，而莫能言其妙者焉。","book":"元·戴良《淮南纪行诗后序》"}},{"id":18396,"word":"心心念念","pinyin":"xīn xīn niàn niàn","abbr":"xxnn","explanation":"心心：指所有的心思；念念：指所有的念头。心里老是想着。指想做某件事或得到某种东西。","source":{"text":"心心不停，念念不住。","book":"宋·释普济《五灯会元》卷十五"},"example":{"text":"有人遇一事，则～不肯舍，毕竟何益？","book":"宋《二程全书·遗书二上》"},"similar":["念念不忘"],"usage":"作谓语、定语；指想做某件事或得到某种东西"},{"id":18397,"word":"心心相印","pinyin":"xīn xīn xiāng yìn","abbr":"xxxy","explanation":"心：心意，思想感情；印：符合。彼此的心意不用说出，就可以互相了解。形容彼此思想感情完全一致。","source":{"text":"迦叶以来，以心印心，心心不异。","book":"《六祖大师法宝坛经》：“吾传佛心印，安敢违于佛经。”《黄蘖传心法要》"},"example":{"text":"抚台看了，彼此～，断无驳回之理。","book":"清·李宝嘉《官场现形记》第五十九回"},"similar":["志同道合","情投意合","心领神会"],"opposite":["格格不入","话不投机","貌合神离"],"usage":"作谓语、宾语、状语；多用于男女之间"},{"id":18398,"word":"心志难夺","pinyin":"xīn zhì nán duó","abbr":"xznd","explanation":"心志：抱负，志向；夺：转移。形容意志坚定难移。","source":{"text":"三军可夺帅，匹夫不可夺志。","book":"《论语·子罕》"},"usage":"作宾语、定语；用于书面语"},{"id":18399,"word":"心忙意乱","pinyin":"xīn máng yì luàn","abbr":"xmyl","explanation":"犹心慌意乱。心里着慌，乱了主意。","source":{"text":"到得天明，起来梳洗罢，吃了饭，到铺中心忙意乱，做些买卖也没心想。","book":"明·徐渭《英烈传》第二十一回：“徐达传令众军，即刻拔寨退三十里屯扎，要有心忙意乱光景，倘或迟误，枭首示众。”明·冯梦龙《警世通言》第二十八卷"},"example":{"text":"豹英呢，也是～，听了十句倒忘了四五句，所以闹得不清不楚，便分手去了。","book":"清·吴研人《二十年目睹之怪现状》第一百二回"},"similar":["心慌意乱"],"usage":"作谓语、定语、状语；用于处事"},{"id":18400,"word":"心忙意急","pinyin":"xīn máng yì jí","abbr":"xmyj","explanation":"犹心慌意乱。心里着慌，乱了主意。","source":{"text":"我一会家腹热肠荒，心忙意急。","book":"元·郑光祖《老君堂》第一折：“见一人急高呼骤征■（马宛），慌的我兜战马疾回还，心忙意急将人盼。”元·刘庭信《新水令·春恨》套曲"},"example":{"text":"那人～，恐误了公事，只得称五钱银子去了。","book":"明·许仲琳《封神演义》第十六回"},"usage":"作定语、状语；用于书面语"},{"id":18401,"word":"心怀叵测","pinyin":"xīn huái pǒ cè","abbr":"xhpc","explanation":"心怀：民心，存心；叵：不可。指存心险恶，不可推测。","source":{"text":"曹操心怀叵测，叔父若往，恐遭其害。","book":"明·罗贯中《三国演义》第五十七回"},"example":{"text":"他的为人处世，表明他是一个～的人。"},"similar":["笑里藏刀","心怀鬼胎","居心不良"],"opposite":["胸怀坦荡","光明正大","堂堂正正"],"usage":"作谓语、定语、状语；指用心险恶","story":["三国时期，曹操准备率军南下攻打孙权与刘备，担心凉州太守马腾趁机作乱，就采用谋士荀攸的建议，封马腾为征南大将军，骗至许都杀害。马腾不相信侄儿马岱说曹操是一个心怀叵测的人，就带儿子马休一起去许都，结果被曹操杀害"]},{"id":18402,"word":"心怀忐忑","pinyin":"xīn huái tǎn tè","abbr":"xhtt","explanation":"心神不宁的样子。指因心虛或忧虑而不能安心。","source":{"text":"听松声谡谡，宵虫哀奏，中心忐忑，悔至如烧。","book":"清·蒲松龄《聊斋志异·巧娘》"},"example":{"text":"十月怀胎，一朝分娩，新生命就要诞生了，他～，默默地祝愿母子平安。","book":"霍达《穆斯林的葬礼》第八章"}},{"id":18403,"word":"心怀鬼胎","pinyin":"xīn huái guǐ tāi","abbr":"xhgt","explanation":"鬼胎：指不可告人的念头或事情。比喻藏着不可告人的心事。","source":{"text":"谁知素梅心怀鬼胎，只是长吁短叹，好生愁闷，默默归房去了。","book":"明·凌濛初《二刻拍案惊奇》"},"example":{"text":"张敬尧接到电报后，～不敢前往。","book":"陶菊隐《北洋军阀统治时期史话》第六十三回"},"similar":["心中有鬼","存心不良","居心不良"],"opposite":["心怀坦白","正大光明"],"usage":"作谓语、定语、状语；指人有坏主意"},{"id":18404,"word":"心怡神悦","pinyin":"xīn yí shén yuè","abbr":"xysy","explanation":"心境开旷，精神愉悦。同“心旷神怡”。","source":{"text":"不知君子那三件至乐的事另有心怡神悦形容不到的田地。","book":"《醒世姻缘传》引起"},"similar":["心怡神旷"],"usage":"作谓语、状语；指人的心境"},{"id":18405,"word":"心怡神旷","pinyin":"xīn yí shén kuàng","abbr":"xysk","explanation":"心境开阔，精神愉快。同“心旷神怡”。","source":{"text":"及登衡岳，览洞壑之幽邃，与林泉之隈隩，虑澹物轻，心怡神旷。","book":"明·胡文焕《群音类选·〈泰和记·刘苏州席上写风情〉》：“幸青皇肯怜，故红妆相向，心怡神旷。”明·张居正《游衡岳后记》"},"example":{"text":"《法国女英雄弹词》第八回：“静念一身来去事，觉得～不离奇。”"},"similar":["心旷神怡","心旷神恬","神怡心旷"],"usage":"作谓语、状语；指人的心境"},{"id":18406,"word":"心急如火","pinyin":"xīn jí rú huǒ","abbr":"xjrh","explanation":"心里急得象着了火一样。形容非常着急。","source":{"text":"心急如火，更不能待。","book":"元·王实甫《西厢记》第一本第四折：“要看个十分饱。”金圣叹批"},"similar":["心急如焚"],"opposite":["从容不迫"],"usage":"作谓语、状语；形容心中异常着急"},{"id":18407,"word":"心急如焚","pinyin":"xīn jí rú fén","abbr":"xjrf","explanation":"心里急得象着了火一样。形容非常着急。","source":{"text":"心急如火，更不能待。","book":"元·王实甫《西厢记》第一本第四折：“要看个十分饱。”金圣叹批"},"example":{"text":"李自成～，只觉得树木伐得太慢。","book":"姚雪垠《李自成》第二卷第二十六章"},"similar":["迫不及待","心如火焚","心急火燎"],"opposite":["不慌不忙","从容不迫","慢条斯理"],"usage":"作谓语、状语；形容心中异常着急","story":["春秋时期，鲁国政权被季孙氏、孟孙氏和叔孙氏三家控制，鲁定公成为一个傀儡，他忧国忧民，心急如焚，听说孔子开坛讲学，主张“君臣纲常”，召见孔子。孔子分析鲁国的内忧外患，建议他外联齐国，内部重振君威，制定了一系列措施"]},{"id":18408,"word":"心急火燎","pinyin":"xīn jí huǒ liǎo","abbr":"xjhl","explanation":"心里急得像火烧一样。形容非常焦急。","source":{"text":"那管院的太监，心燎意急，一筹莫展。","book":"清·吴璇《飞龙全传》"},"example":{"text":"铁头～，忽噜忽噜喝碗菜粥，摞下筷子。","book":"管桦《上学》"},"similar":["心急如焚","迫不及待"],"opposite":["不慌不忙","从容不迫"],"usage":"作谓语、定语、状语；用于人"},{"id":18409,"word":"心悟神解","pinyin":"xīn wù shén jiě","abbr":"xwsj","explanation":"悟、解：领悟，理解。指对方没有明说，心里已经领会。","source":{"text":"其于学问，心悟神解，而苦志自勉，精力亦绝人。","book":"宋·楼钥《攻媿集·宝谟阁待制赠通议大夫陈公神道碑》"}},{"id":18410,"word":"心悦神怡","pinyin":"xīn yuè shén yí","abbr":"xysy","explanation":"犹心旷神怡。心境开阔，精神愉快。","source":{"text":"只觉那茶一口口俱有美人的色香在内，吃下去甚是心悦神怡。","book":"《西湖佳话·西泠韵迹》"},"similar":["心旷神怡"],"usage":"作谓语、定语、状语；用于人的心情"},{"id":18411,"word":"心悦诚服","pinyin":"xīn yuè chéng fú","abbr":"xycf","explanation":"悦：愉快，高兴；诚：硬实。由衷地高兴，真心地服气。指真心地服气或服从。","source":{"text":"以力服人者，非心服也，力不赡也；以德服人者，中心悦而诚服也，如七十子之服孔子也。","book":"《孟子·公孙丑上》"},"example":{"text":"小弟若在两位才女跟前称了晚生，不但毫不委曲，并且～。","book":"清·李汝珍《镜花缘》第二十三回"},"similar":["心甘情愿","心服口服"],"opposite":["口服心不服"],"usage":"作谓语、定语、状语；指真心顺从","story":["战国时期，孟子到各地去游说他的仁道，有人说靠武力照样可以称霸，根本用不上讲仁道。孟子说：“靠武力称霸必须要以国富民强为基础，是武力压服而非心悦诚服，而以仁道称霸，则可以让人心悦诚服，使国力强大。”"]},{"id":18412,"word":"心悬两地","pinyin":"xīn xuán liǎng dì","abbr":"xxld","explanation":"悬：牵挂。一心牵挂着两地地方的事情。","example":{"text":"孩子考上外地的大学，这让我两地分居的人～。"},"similar":["心挂两头"],"usage":"作谓语、定语；指牵挂"},{"id":18413,"word":"心惊肉战","pinyin":"xīn jīng ròu zhàn","abbr":"xjrz","explanation":"形容担心灾祸临头，恐慌不安。同“心惊肉跳”。","source":{"text":"不知怎么，这一会儿心惊肉战，这一双好小脚儿，再走也走不动了。","book":"元·无名氏《争报恩》第三折"},"example":{"text":"步难移～，眼昏花天翻地转。","book":"明·胡文焕《群音类选〈鲛绡记·典刑遇赦〉》"},"similar":["心惊肉跳","肉跳心惊"],"usage":"作谓语、状语；形容人极度惊惧恐慌"},{"id":18414,"word":"心惊肉跳","pinyin":"xīn jīng ròu tiào","abbr":"xjrt","explanation":"形容担心灾祸临头，恐慌不安。","source":{"text":"不知怎么，这一会儿心惊肉战，这一双好小脚儿再走也走不动了。","book":"元·无名氏《争报恩》第三折"},"example":{"text":"在那个闷热的夜晚，发生了那种淑娴现在想起还～的事情，使她的精神受到极大的创伤。","book":"冯德英《迎春花》第十五章"},"similar":["心胆俱裂","魂飞魄散"],"opposite":["神色不惊","镇定自若"],"usage":"作谓语、宾语、状语；形容人极度惊惧恐慌"},{"id":18415,"word":"心惊胆丧","pinyin":"xīn jīng dǎn sàng","abbr":"xjds","explanation":"内心惊吓害怕。同“心惊胆慑”。","source":{"text":"忽听喊声来，心惊胆丧，急急奔离天罗地网。","book":"明·张四维《双烈记·寇逸》"},"similar":["心惊胆怕","心惊胆慑"],"usage":"作谓语、定语；形容人极度惊惧恐慌"},{"id":18416,"word":"心惊胆寒","pinyin":"xīn jīng dǎn hán","abbr":"xjdh","explanation":"形容十分害怕。同“心惊胆战”。","source":{"text":"心惊胆寒，浑身上淋漓雨汗。","book":"明·李日华《南西厢记·飞虎授首》"},"similar":["心惊胆战","心惊胆裂","心惊胆丧"],"usage":"作谓语、定语；形容人极度惊惧恐慌"},{"id":18417,"word":"心惊胆怕","pinyin":"xīn jīng dǎn pà","abbr":"xjdp","explanation":"内心惊吓害怕。同“心惊胆慑”。","source":{"text":"受了他五七日心惊胆怕，不似这两三程行得人力尽身乏。","book":"元·狄君厚《介子推》第三折"},"example":{"text":"吴强《红日》：“胜利的冲锋号，抖荡着使敌人～的嘹亮声音。”"},"similar":["心惊胆慑","心惊胆丧"],"usage":"作谓语、定语；形容人极度惊惧恐慌"},{"id":18418,"word":"心惊胆慑","pinyin":"xīn jīng dǎn shè","abbr":"xjds","explanation":"内心惊吓害怕。","source":{"text":"怀中履孝，道广德新，合力义亏，仁者心惊胆慑。","book":"《敦煌变文集·长兴四年中兴殿应圣节讲经文》"},"example":{"text":"扳著花枝将身拽，呀，一声树拉，一声树拉，不觉～。","book":"明·孙柚《琴心记·夜亡成都》"},"similar":["心惊胆怕","心惊胆丧"],"usage":"作谓语、定语；形容人惊惧"},{"id":18419,"word":"心惊胆战","pinyin":"xīn jīng dǎn zhàn","abbr":"xjdz","explanation":"战：通“颤”，发抖。形容十分害怕。","source":{"text":"一个个气昂昂性儿不善，他每都叫吼捋袖揎拳，走的我腿又酸又软，不由我不心惊胆战。","book":"元·无名氏《萨真人夜断碧桃花》第三折"},"example":{"text":"霎时间，森林里传来让人～的吼声。","book":"杜鹏程《保卫延安》第三章"},"similar":["提心吊胆"],"opposite":["泰然自若","坦然自若"],"usage":"作谓语、定语；形容人极度惊惧恐慌"},{"id":18420,"word":"心惊胆碎","pinyin":"xīn jīng dǎn suì","abbr":"xjds","explanation":"碎：破裂。形容人极度惊惧恐慌","source":{"text":"下令急回兵北走。众军心惊胆碎，兵溃争先。","book":"明·郭勋《英烈传》第30回"},"similar":["心惊胆颤","心惊胆寒","心惊胆战"],"usage":"作谓语、定语；用于处事"},{"id":18421,"word":"心惊胆落","pinyin":"xīn jīng dǎn luò","abbr":"xjdl","explanation":"形容十分害怕。同“心惊胆战”。","source":{"text":"人有遭之，心惊胆落，震汗如麻。","book":"宋·欧阳修《祭苏子美文》"},"similar":["心惊胆裂","心惊胆寒","心惊胆战"],"usage":"作谓语、定语；形容人极度惊惧恐慌"},{"id":18422,"word":"心惊胆裂","pinyin":"xīn jīng dǎn liè","abbr":"xjdl","explanation":"形容极度惊恐。","source":{"text":"先锋将魄散魂飞，合后兵心惊胆裂。","book":"明·施耐庵《水浒传》第七十九回"},"example":{"text":"清·陈瑞生《再生缘》第九回：“已晓得皇甫敬投降外国，到江陵县拿解合家等事，只吓得魂飞魄散，～。”"},"similar":["心惊胆寒","心惊胆落","心惊胆战"],"usage":"作谓语、定语；形容人极度惊惧恐慌"},{"id":18423,"word":"心惊胆颤","pinyin":"xīn jīng dǎn chàn","abbr":"xjdc","explanation":"形容十分害怕。同“心惊胆战”。","source":{"text":"王翦见李牧归城不出，持兵克日攻城。城前发喊，惊得赵王心惊胆颤，文武诸将仓皇无计。","book":"《秦并六国平话》卷上"},"example":{"text":"霎时间，森林里传来让人～的吼声。","book":"杜鹏程《保卫延安》第三章"},"similar":["胆颤心惊","心惊胆战","心惊胆寒"],"usage":"作谓语、定语；形容胆怯"},{"id":18424,"word":"心慈好善","pinyin":"xīn cí hào shàn","abbr":"xchs","explanation":"心地仁慈，乐于行善。","source":{"text":"我是个心慈好善的人，现如今吃长斋哩。","book":"元·郑廷玉《冤家债主》第一折"},"example":{"text":"为人一生有仁义，性格宽洪，～，看经布施，广行方便。","book":"明·兰陵笑笑生《金瓶梅词话》第四十五回"},"usage":"作谓语、定语；用于为人处世等"},{"id":18425,"word":"心慈手软","pinyin":"xīn cí shǒu ruǎn","abbr":"xcsr","explanation":"心怀恻隐而不忍下手。","source":{"text":"他下定决心，往后不再心慈手软了。","book":"金近《他叫“东郭先生”》"},"example":{"text":"在这场斗争中，我们决不能～。","book":"《人民日报》1976.11.4"},"opposite":["心狠手辣"],"usage":"作谓语、定语；指对待人的态度"},{"id":18426,"word":"心慈面善","pinyin":"xīn cí miàn shàn","abbr":"xcms","explanation":"形容为人和善。","source":{"text":"大哥生来心慈面善，易被人欺，故此叫你同行，凡事之间，便可商议，你当听从方是正道","book":"清·吴璿《飞龙全传》第十二回"}},{"id":18427,"word":"心慈面软","pinyin":"xīn cí miàn ruǎn","abbr":"xcmr","explanation":"软：柔和、温和。形容为人和善。","source":{"text":"待要不出个主意，我又不是个心慈面软的人，凭人撮弄我，我还是一片傻心肠。","book":"清·曹雪芹《红楼梦》第六十八回"},"example":{"text":"究竟赵老头儿是个～的人，听了这话，连忙替他求情。","book":"清·李宝嘉《官场现形记》第一回"},"similar":["心慈手软"],"opposite":["心狠手辣"],"usage":"作谓语、定语；形容为人和善"},{"id":18428,"word":"心慌意乱","pinyin":"xīn huāng yì luàn","abbr":"xhyl","explanation":"心里着慌，乱了主意。","source":{"text":"孩儿自从接了电报之后，心慌意乱。","book":"清·吴趼人《二十年目睹之怪现状》第十八回"},"example":{"text":"这件不该发生的事出现了，让他～。"},"similar":["心烦意乱","心神不定","心如乱麻"],"opposite":["心旷神怡","从容不迫","心平气和"],"usage":"作谓语、状语；指人没有主意"},{"id":18429,"word":"心慌意急","pinyin":"xīn huāng yì jí","abbr":"xhyj","explanation":"心里着慌，乱了主意。同“心慌意乱”。","source":{"text":"原来那贼当时心慌意急，错走入后园。","book":"《石点头·贪婪汉六院卖风流》"},"example":{"text":"明·冯梦龙《醒世恒言》第20卷：“灯又半明半灭，又看见玉姐吊在梁间，～。”"},"similar":["心慌意乱"],"usage":"作谓语、定语、状语；用于处事"},{"id":18430,"word":"心慌撩乱","pinyin":"xīn huāng liáo luàn","abbr":"xhll","explanation":"心里慌张忙乱，心绪混乱。","source":{"text":"却才上胡梯，踏了个空，争些儿跌了一交，因此心慌撩乱。","book":"明·施耐庵《水浒传》第六十九回"},"example":{"text":"他正～地寻思着过去和目下的事。","book":"杜鹏程《保卫延安》第一章"},"similar":["心慌意乱"],"usage":"作谓语、定语、状语；用于处事"},{"id":18431,"word":"心慕力追","pinyin":"xīn mù lì zhuī","abbr":"xmlz","explanation":"慕：羡慕；追：追求。心头羡慕，努力追赶。形容竭力模仿。","source":{"text":"玩之不觉为倦，览之莫识其端，心慕手追，此人而已。其余区区之类，何足论哉！","book":"唐·李世民《王羲之传论》"},"example":{"text":"彼之覆辙，今则～之，惟恐不肖。","book":"清·梁启超《政闻时言·矛盾之政治下旬》"}},{"id":18432,"word":"心慕手追","pinyin":"xīn mù shǒu zhuī","abbr":"xmsz","explanation":"慕：羡慕；追：追求。心头羡慕，手上模仿。形容竭力模仿。","source":{"text":"玩之不觉为倦，览之莫识其端，心慕手追，此人而已。其余区区之类，何足论哉！","book":"《晋书·王羲之传赞》"},"example":{"text":"京口程君梦湘同游焦山，一路论诗，渠最心折于吾乡樊榭先生，～，几可抗手。","book":"清·袁枚《随园诗话》卷十三"},"similar":["心慕笔追"],"usage":"作谓语；形容竭力模仿"},{"id":18433,"word":"心慕笔追","pinyin":"xīn mù bǐ zhuī","abbr":"xmbz","explanation":"心中仰慕而追随仿效。同“心慕手追”。","source":{"text":"后有集王羲之书一十八家者，行敦乃其一也，是则心慕笔追，亦自可佳耳。","book":"《宣和书谱·释行敦》"},"similar":["心慕手追"],"usage":"作谓语、定语；形容竭力模仿"},{"id":18434,"word":"心慵意懒","pinyin":"xīn yōng yì lǎn","abbr":"xyyl","explanation":"情思倦怠，精神萎靡。","source":{"text":"出乎无奈，每日做生活，做得心慵意懒。”：明·冯梦龙《醒世恒言》第九卷“［多福］多时听得母亲三言两语，絮絮聒聒，已自心慵意懒。","book":"明·沈采《千金记》第四十出"},"example":{"text":"一个欲动情浓，仓忙唐突；一个～，勉强应承。","book":"明·凌濛初《初刻拍案惊奇》卷二十六"},"usage":"作谓语、定语、状语；用于处事"},{"id":18435,"word":"心战胆栗","pinyin":"xīn zhàn dǎn lì","abbr":"xzdl","explanation":"形容内心十分惊慌恐惧。","source":{"text":"诸侯观之，心战胆栗，始知将军为真英雄，膝行而前，莫敢仰视。","book":"宋·陈亮《酌古论一·孙权》"}},{"id":18436,"word":"心所谓危","pinyin":"xīn suǒ wèi wēi","abbr":"xsww","explanation":"心里感觉有危险。指个人对情况、问题的主观认识。","source":{"text":"人心之不同，如其面焉。吾岂敢谓子面如吾面乎？抑心所谓危，亦以告也。","book":"《左传·襄公三十一年》"},"example":{"text":"～，不敢不言。如果言之不行，就只有以去就争了！","book":"高阳《慈禧全传》六十三"},"usage":"作宾语、定语；用于书面语"},{"id":18437,"word":"心手相应","pinyin":"xīn shǒu xiāng yìng","abbr":"xsxy","explanation":"心和手相配合。形容手法熟练，心里怎么想，手就怎么做。","source":{"text":"笔力劲骏，心手相应，巧逾杜度，美过崔寔，当与元常并驱争先。","book":"《南史·萧子云传》"},"example":{"text":"指使他按谱徵歌，都学得～。","book":"清·文康《儿女英雄传》第十八回"},"similar":["得心应手","随心所欲"],"opposite":["手不应心"],"usage":"作谓语、定语；指技艺熟练"},{"id":18438,"word":"心手相忘","pinyin":"xīn shǒu xiāng wàng","abbr":"xsxw","explanation":"极言得心应手。比喻技艺纯熟或做事情非常顺利。","source":{"text":"子瞻机神敏妙，比及暮年，心手相忘，独立千载。","book":"清·包世臣《再与杨季子书》"},"usage":"作谓语、定语；用于书面语"},{"id":18439,"word":"心折首肯","pinyin":"xīn zhé shǒu kěn","abbr":"xzsk","explanation":"心里佩服，点头同意。形容钦佩赞许之至。","source":{"text":"便一五一十，把谭孝移品行端方，素来的好处，说个不啻口出。东宿闻之，心折首肯。","book":"清·李绿园《歧路灯》第四回"},"similar":["心服首肯"],"usage":"作谓语、宾语；用于处事"},{"id":18440,"word":"心拙口夯","pinyin":"xīn zhuō kǒu bèn","abbr":"xzkb","explanation":"夯：同笨。心思笨拙，又不善于说话。","source":{"text":"谁都像我心拙口夯的，由着人说呢！","book":"清·曹雪芹《红楼梦》第30回"},"similar":["心笨口笨"],"usage":"作谓语、定语；指人笨拙"},{"id":18441,"word":"心挂两头","pinyin":"xīn guà liǎng tóu","abbr":"xglt","explanation":"指人操心两头的事情。","source":{"text":"媒婆，我去也不妨，只是一心挂两头，如何是好。","book":"元·高明《琵琶记·再报佳期》"},"example":{"text":"你～，是干不好事的。"},"similar":["两头担心"],"usage":"作谓语、定语；指人很操心"},{"id":18442,"word":"心摇胆战","pinyin":"xīn yáo dǎn zhàn","abbr":"xydz","explanation":"战：发抖。形容内心十分恐惧、害怕。","source":{"text":"一旦闻金革之事，则心摇胆战。","book":"宋·袁燮《絜斋集·书赠吴定夫》"},"example":{"text":"元礼见众人被杀，惊得～，也不知墙外是水是泥，奋身一跳，却是乱棘丛中。","book":"明·冯梦龙《醒世恒言》卷二十一"}},{"id":18443,"word":"心摩意揣","pinyin":"xīn mó yì chuǎi","abbr":"xmyc","explanation":"摩：揣测；揣：量度。用心揣摩测度。","source":{"text":"心摩意揣，虑计神筹。","book":"唐·薛逢《上中书李舍人启》"},"usage":"作宾语、定语；用于处事"},{"id":18444,"word":"心摹手追","pinyin":"xīn mó shǒu zhuī","abbr":"xmsz","explanation":"用心揣摩，追随仿效。","source":{"text":"癸未四月，京口程君梦湘同游焦山，一路论诗；渠最心折于吾乡樊榭先生，心摹手追，几可抗手。","book":"清·袁枚《随园诗话》卷十三"},"usage":"作谓语、宾语；用于书面语"},{"id":18445,"word":"心旌摇摇","pinyin":"xīn jīng yáo yáo","abbr":"xjyy","explanation":"心神不定，情思起伏，就像旌旗随风飘摇一样。","source":{"text":"寡人自料，从楚当秦，未见胜也；内与群臣谋，不足恃也，寡人卧不安席，食不甘味，心摇摇如悬旌，而无所终薄。","book":"西汉·刘向《战国策·楚策一》"},"similar":["心潮起伏","坐卧不安"],"opposite":["不动声色","无动于衷"],"usage":"作谓语、补语；用于人的情绪"},{"id":18446,"word":"心旌摇曳","pinyin":"xīn jīng yáo yè","abbr":"xjyy","explanation":"旌：旗子；摇曳：摆动。指心神不安，就象旌旗随风飘荡不定。形容情思起伏，不能自持。","source":{"text":"心摇摇如县旌，而无所终薄。","book":"《史记·苏秦列传》"},"example":{"text":"眉翠含颦，靥红展笑，一张小嘴，恰似新破的榴实，不觉看得～起来。","book":"清·曾朴《孽海花》第五回"},"usage":"作定语、状语；用于书面语"},{"id":18447,"word":"心无二想","pinyin":"xīn wú èr xiǎng","abbr":"xwex","explanation":"心思不能同时用在两件事上。指做事要专心，注意力必须集中。","source":{"text":"使左手画方，右手画圆，令一时俱成，虽执规矩之心，回剟劂之手，而不能成者，由心不两用，则手不并运也。","book":"汉·桓谭《新论·专学》"},"example":{"text":"既～，故曰一志焉，盖上士所行也。","book":"宋·张君房《云笈七签》卷三十七"},"similar":["心不两用","专心致志","心无二用"],"opposite":["三心二意","心不在焉"],"usage":"作定语、状语；用于处事等"},{"id":18448,"word":"心无二用","pinyin":"xīn wú èr yòng","abbr":"xwey","explanation":"指做事要专心，注意力必须集中。","source":{"text":"使左手画方，右手画圆，令一时俱成，虽执规矩之心，回剟劂之手，而不能成者，由心不两用，则手不并运也。","book":"汉·桓谭《新论·专学》"},"example":{"text":"自古道～。","book":"明·凌濛初《二刻拍案惊奇》卷五"},"similar":["专心致志","聚精会神","心无二想"],"opposite":["魂不守舍","三心二意"],"usage":"作谓语、宾语、定语；用于人"},{"id":18449,"word":"心无城府","pinyin":"xīn wú chéng fǔ","abbr":"xwcf","explanation":"城府：城市和官署，指难以揣度的心机。比喻胸怀坦荡，无所隐藏。","source":{"text":"尧俞厚重言寡，遇人不设城府，人自不忍欺。","book":"《宋史·傅尧俞传》"},"example":{"text":"周伯通～，那知隐瞒心中之事。","book":"金庸《神雕侠侣》第十六回"}},{"id":18450,"word":"心无挂碍","pinyin":"xīn wú guài ài","abbr":"xwga","explanation":"挂碍：牵挂。原为佛教用语，指内心没有任何牵挂。","source":{"text":"心无挂碍：无挂碍，故无有恐怖，这离颠倒梦想。","book":"唐·玄奘《般若波罗多心经》"},"opposite":["顾虑重重"],"usage":"作谓语、定语；用于处事"},{"id":18451,"word":"心无旁骛","pinyin":"xīn wú páng wù","abbr":"xwpw","explanation":"旁；另外的；骛：追求。心思没有另外的追求，形容心思集中，专心致志。","source":{"text":"有不少人像我一样，在写信的时候，喜欢在一张白纸，或者只带着道道的纸上，不受拘束地，心无旁骛地抒写下去的。","book":"冰心《谈信纸信封》"},"similar":["心无二用","专心致志"],"opposite":["三心二意","魂不守舍"],"usage":"作谓语、定语、状语；指思想集中"},{"id":18452,"word":"心旷神怡","pinyin":"xīn kuàng shén yí","abbr":"xksy","explanation":"旷：开阔；怡：愉快。心境开阔，精神愉快。","source":{"text":"登斯楼也，则有心旷神怡，宠辱皆忘，把酒临风，其喜洋洋者也。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"又登海天阁，见万顷银涛，千山削翠，～。","book":"清·陈忱《水浒后传》第四十回"},"similar":["赏心悦目","悠然自得"],"opposite":["心烦意乱","心如火焚"],"usage":"作谓语、状语；指人的心境","story":["宋朝时期，同年进士滕子京与范仲淹是很好的朋友，1045年滕子京任岳州知州，重修岳阳楼，请范仲淹写《岳阳楼记》。范仲淹知道他被贬心情不好，就写：“登斯楼也，则有心旷神怡，宠辱皆忘，把酒临风，其喜洋洋者矣。”"]},{"id":18453,"word":"心旷神恬","pinyin":"xīn kuàng shén tián","abbr":"xkst","explanation":"心境开阔，精神愉快。同“心旷神怡”。","source":{"text":"这枕抱着呵，骨清毛爽；靠着呵，心旷神恬。","book":"明·无名氏《三化邯郸》第二折"},"similar":["心旷神愉","心旷神怡","心怡神旷"],"usage":"作谓语、状语；指人的心境"},{"id":18454,"word":"心旷神愉","pinyin":"xīn kuàng shén yú","abbr":"xksy","explanation":"心境开阔，精神愉快。同“心旷神怡”。","source":{"text":"于斯之际，蠲烦涤嚣，心旷神愉，窃意世间所谓神仙者之乐不是过也。","book":"清·薛福成《白雷登海口避暑记》"},"similar":["心旷神恬","心旷神怡","心怡神旷"],"usage":"作谓语、状语；指人的心境"},{"id":18455,"word":"心旷神飞","pinyin":"xīn kuàng shén fēi","abbr":"xksf","explanation":"犹言心境愉悦，飘飘欲仙。","source":{"text":"遂有僮仆展氍毹于筵下，两女对舞，长衣乱拂，香尘四散。舞罢，斜倚画屏。韩、徐二人心旷神飞，不觉醺醉。","book":"清·蒲松龄《聊斋志异·道士》"},"similar":["心旷神恬","心旷神怡"],"usage":"作谓语、状语；指人的心境"},{"id":18456,"word":"心明眼亮","pinyin":"xīn míng yǎn liàng","abbr":"xmyl","explanation":"心里明白，眼睛雪亮。形容看问题敏锐，能辨别是非。","source":{"text":"风仪与秋月齐明，音徽与春云等润，韵宇弘深，喜愠莫见其际，心明通亮，用人言必由于己。","book":"南北朝·王俭《褚渊碑文》"},"example":{"text":"那人走南闯北，～，办事干练，能话也能行！","book":"梁斌《红旗谱》"},"similar":["眼明手快","耳聪目明"],"opposite":["笨头笨脑","昏头昏脑"],"usage":"作谓语、宾语、定语；指心理明白"},{"id":18457,"word":"心有余悸","pinyin":"xīn yǒu yú jì","abbr":"xyyj","explanation":"悸：因害怕而心跳得厉害。危险的事情虽然过去了，回想起来心里还害怕。","source":{"text":"谈到三年前倒圩的情景，赵老大心有余悸地说：‘那次桃花洲的人淹死了一半，庄稼全毁了。’","book":"柳洲《风雨桃花洲》"},"example":{"text":"事情过去好几天了，至今他仍然还～。"},"similar":["惊弓之鸟","谈虎色变","心惊肉跳"],"opposite":["泰然自若","神色不惊"],"usage":"作谓语、定语、状语；指担心害怕"},{"id":18458,"word":"心有余而力不足","pinyin":"xīn yǒu yú ér lì bù zú","abbr":"xyyelbz","explanation":"心里非常想做，但是力量不够。","source":{"text":"有能一日用其力于仁矣乎？我未见力不足者；盖有之矣，我未之见也。","book":"《论语·里仁》"},"example":{"text":"我手里但凡从容些，也时常来上供，只是‘～’。","book":"清·曹雪芹《红楼梦》第二十五回"},"similar":["爱莫能助"],"opposite":["余勇可贾","行有余力"],"usage":"作主语、分句；表婉约拒绝的意思"},{"id":18459,"word":"心有灵犀","pinyin":"xīn yǒu líng xī","abbr":"xylx","explanation":"灵犀：传说犀牛角有白纹，感应灵异。比喻恋爱着的男女双方心心相印。现多比喻比方对彼此的心思都能心领神会。","source":{"text":"身无彩凤双飞翼，心有灵犀一点通。","book":"唐·李商隐《无题》诗"},"example":{"text":"赵朴初《故宫惊梦》：“～，老谱新翻一局棋。”"},"similar":["心有灵犀一点通"],"usage":"作谓语、定语、宾语；用于交往等"},{"id":18460,"word":"心有灵犀一点通","pinyin":"xīn yǒu líng xī yī diǎn tōng","abbr":"xylxydt","explanation":"比喻恋爱着的男女双方心心相印。现多比喻比方对彼此的心思都能心领神会。","source":{"text":"身无彩凤双飞翼，心有灵犀一点通。","book":"唐·李商隐《无题》诗"},"example":{"text":"大师们的艺术手法，常常是“～”的。","book":"秦牧《叠句的魅力》"},"similar":["心心相印","情投意合","心有灵犀"],"opposite":["格格不入","貌合神离"],"usage":"作定语、宾语、分句；含讽刺意"},{"id":18461,"word":"心有鸿鹄","pinyin":"xīn yǒu hóng hú","abbr":"xyhg","explanation":"鸿鹄：天鹅。多形容学习、工作不专心。","source":{"text":"《孟子·告子上》：“使奕秋诲二人奕，惟奕秋之所为听。一人虽听之，一心以为有鸿鹄将至，思援弓缴而射之，虽与之俱学，弗若之矣。 为是其智弗若与？ 曰：非然也。"}},{"id":18462,"word":"心服口不服","pinyin":"xīn fú kǒu bù fú","abbr":"xfkbf","explanation":"服：信服。心里信服嘴上却不承认。","example":{"text":"听了这番解释，她还是～"},"opposite":["心服口服"],"usage":"作谓语、宾语、状语；指表面不信服"},{"id":18463,"word":"心服口服","pinyin":"xīn fú kǒu fú","abbr":"xfkf","explanation":"服：信服。心里嘴上都信服。指真心信服。","source":{"text":"利义陈乎前，而好恶是非直服人之口而已矣。使人乃以心服，而不敢蘁立，定天下之定。","book":"《庄子·寓言》"},"example":{"text":"如今请出一个管得着的人来管一管，嫂子就～，也知道规矩了。","book":"清·曹雪芹《红楼梦》第五十九回"},"similar":["心悦诚服","心悦口服"],"opposite":["愤愤不平"],"usage":"作谓语、宾语、状语；指真心信服"},{"id":18464,"word":"心服情愿","pinyin":"xīn fú qíng yuàn","abbr":"xfqy","explanation":"心里服气，完全愿意，没有一点勉强。多指自愿做出某种牺牲。","source":{"text":"此事儿甘心情愿也。","book":"宋·王明清《摭青杂说·项四郎》"},"example":{"text":"早要你出，你一定不肯多出；必须逼你到这条路上来，然后你方～的多出！","book":"清·李宝嘉《官场现形记》第二十八回"},"similar":["甘心情愿","心甘情愿"],"opposite":["迫不得已","被逼无奈"],"usage":"作谓语、状语；形容发自内心"},{"id":18465,"word":"心服首肯","pinyin":"xīn fú shǒu kěn","abbr":"xfsk","explanation":"指心里信服，并点头同意。","source":{"text":"然则他何不一开口就照在青云山口似悬河的那派谈锋？也不愁那姑娘不低首下心的心服首肯。","book":"清·文康《儿女英雄传》第二十五回"},"similar":["心折首肯"],"usage":"作谓语、宾语；用于处事"},{"id":18466,"word":"心术不定","pinyin":"xīn shù bù dìng","abbr":"xsbd","explanation":"指心计令人难以捉摸。","source":{"text":"且王伦心术不定，语言不准，失信于人，难以相聚。","book":"明·施耐庵《水浒全传》第十九回"},"usage":"作谓语、定语；用于书面语"},{"id":18467,"word":"心术不正","pinyin":"xīn shù bù zhèng","abbr":"xsbz","explanation":"心术：居心。指人用心不忠厚，不正派。","source":{"text":"宫日：‘汝心术不正，我故弃汝！’","book":"明·罗贯中《三国演义》第十九回"},"example":{"text":"什么时候又躲躲藏藏的，可知也是个～的货。","book":"清·曹雪芹《红楼梦》第八十四回"},"similar":["居心叵测","心术不端"],"opposite":["心地善良"],"usage":"作谓语、定语；指人心地不正"},{"id":18468,"word":"心术不端","pinyin":"xīn shù bù duān","abbr":"xsbd","explanation":"心地不正派；居心不良。","source":{"text":"好笑那莫稽只想着今日富贵，却忘了贫贱的时节，把老婆资助成名一段功劳化为春水，这是他心术不端处。","book":"明·冯梦龙《喻世明言》第二十七卷"},"example":{"text":"不多时，只见带上了个欺心背反、蓄意谋奸、三角眼含痛泪、一片～的总管马朝贤来。","book":"清·石玉昆《三侠五义》第八十三回"},"similar":["心术不正"],"usage":"作谓语、定语；指人心地不正"},{"id":18469,"word":"心正气和","pinyin":"xīn zhèng qì hé","abbr":"xzqh","explanation":"内心正直，态度温和。指不急躁，不生气。","source":{"text":"夫欲书之时，当收视反听，绝虑凝神，心正气和，则契于玄妙。","book":"唐·李世民《笔法诀》"},"example":{"text":"故秘书包公谓公内外循理，～，君子以为知言。","book":"唐·权德舆《叔父故朝散郞华州司士参军府墓志铭序》"}},{"id":18470,"word":"心正笔正","pinyin":"xīn zhèng bǐ zhèng","abbr":"xzbz","explanation":"旧时认为书法的优劣与字人的品性有关，心正写出来的字就端正。","source":{"text":"用笔在心，心正则笔正。","book":"《旧唐书·柳公权传》"},"usage":"作宾语、定语；用于书面语"},{"id":18471,"word":"心殒胆破","pinyin":"xīn yǔn dǎn pò","abbr":"xydp","explanation":"形容十分惊恐。同“心殒胆落”。","source":{"text":"乃无事则筹略纷纭，临变已张皇失措，一闻贼至，心殒胆破。","book":"清·薛福成《书昆明何帅失陷苏常事》"},"similar":["心殒胆落"],"usage":"作谓语、定语、状语；用于处事"},{"id":18472,"word":"心殒胆落","pinyin":"xīn yǔn dǎn luò","abbr":"xydl","explanation":"形容十分惊恐。","source":{"text":"而又喧传陛下决为亲征之谋，中外闻之，心殒胆落。","book":"宋·邵伯温《闻见前录》卷四"},"similar":["心殒胆破","胆破心惊"],"usage":"作谓语、定语、状语；用于书面语"},{"id":18473,"word":"心比天高","pinyin":"xīn bǐ tiān gāo","abbr":"xbtg","explanation":"形容心地高傲或所想超过现实。","source":{"text":"霁月难逢，彩云易散。心比天高，身为下贱。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"章诒和《往事并不如烟》自序：“他（她）们有才、有德、有能，个个～、命如纸薄。”"},"usage":"作谓语、定语；用于处世等"},{"id":18474,"word":"心活面软","pinyin":"xīn huó miàn ruǎn","abbr":"xhmr","explanation":"比喻自己没有一点主见，就是相信别人的话。","source":{"text":"再者，放头儿，还恐怕他巧言花语的和你借贷些簪环衣履作本钱，你这心活面软的，未必不周济他些。","book":"清·曹雪芹《红楼梦》第七十三回"},"similar":["心软意活"],"opposite":["立场坚定"],"usage":"作谓语、定语；指没有主见"},{"id":18475,"word":"心浮气盛","pinyin":"xīn fú qì shèng","abbr":"xfqs","explanation":"形容人性情浮躁，态度傲慢。","source":{"text":"好在还没惹出什么大祸，我后来就不敢再这样心浮气盛了。","book":"孙犁《秀露集·文学和生活的路》"},"example":{"text":"～的人是干不好事的。"},"similar":["粗心大意","心粗气浮"],"opposite":["不骄不躁"],"usage":"作谓语、定语；指人的性情"},{"id":18476,"word":"心浮气粗","pinyin":"xīn fú qì cū","abbr":"xfqc","explanation":"形容人不细心，不沉着。同“心粗气浮”。","source":{"text":"我们年青人，心浮气粗是有的，可是没有成见。","book":"茅盾《第一阶段的故事》八"},"similar":["心粗气浮"],"usage":"作谓语、定语；指人性情浮躁"},{"id":18477,"word":"心浮气躁","pinyin":"xīn fú qì zào","abbr":"xfqz","explanation":"形容人性情浮躁，做事不踏实。","source":{"text":"木兰很敬仰她父亲，他一直拒绝逃离北京，一直拖延到七月十八。后来既然决定了到故乡杭州去避难，便冷静异常，从容准备，处变不惊，方寸泰然。因为她父亲沉潜于黄老之修养有年，可谓真正的道家高士，从不心浮气躁。","book":"林语堂《京华烟云》第一章"},"example":{"text":"做事就不能～。"},"similar":["心浮气盛"],"opposite":["不骄不躁"],"usage":"作谓语、定语；指人静不下心"},{"id":18478,"word":"心满原足","pinyin":"xīn mǎn yuán zú","abbr":"xmyz","explanation":"形容心中非常满意。同“心满意足”。"},{"id":18479,"word":"心满意得","pinyin":"xīn mǎn yì dé","abbr":"xmyd","explanation":"心中满足，洋洋得意。","source":{"text":"在这些心满意得的人们面前，他真感得无地自容。","book":"茅盾《子夜》六"},"similar":["志得意满","心满意足"],"usage":"作定语、状语；一样处事"},{"id":18480,"word":"心满意足","pinyin":"xīn mǎn yì zú","abbr":"xmyz","explanation":"形容心中非常满意。","source":{"text":"君臣上下，自以为江东之业为万世之安，心满意足。","book":"宋·吕祖谦《晋论》中"},"example":{"text":"两个小的，亦被武松搠死……武松道：“我方才～，走了罢休！”","book":"明·施耐庵《水浒传》第三十一回"},"similar":["称心如意","正中下怀","心满愿足"],"opposite":["得寸进尺","贪心不足"],"usage":"作谓语、定语、状语；形容人的心情"},{"id":18481,"word":"心满愿足","pinyin":"xīn mǎn yuàn zú","abbr":"xmyz","explanation":"形容心中非常满意。同“心满意足”。","source":{"text":"渔得鱼心满愿足，樵得樵眼笑眉舒。","book":"宋·无名氏《张协状元》戏文第四二出：“我们得那女儿在此，真个心满愿足。”元·胡祗遹《沉醉东风》"},"example":{"text":"见他眉来眼去，俺早～。","book":"元·贯云石《斗鹌鹑·佳偶》套曲"},"similar":["心满意足"],"usage":"作谓语、定语、状语；形容人的心情"},{"id":18482,"word":"心潮澎湃","pinyin":"xīn cháo péng pài","abbr":"xcpp","explanation":"澎湃：波涛冲击的声音。心里象浪潮翻腾。形容心情十分激动，不能平静。","source":{"text":"字里行间，有一种高亢的声音在呼喊，有一种强大的力量在撼人，有一种呼风唤雨的革命精神和雄壮气魄使得你心潮澎湃，激动不已。","book":"臧克家《得识郭老五十年》"},"example":{"text":"这特大喜讯怎能不让我们～，热血沸腾。"},"similar":["百感交集","热血沸腾"],"opposite":["无动于衷","等闲视之","不动声色"],"usage":"作谓语；指情绪激动"},{"id":18483,"word":"心灰意冷","pinyin":"xīn huī yì lěng","abbr":"xhyl","explanation":"灰心失望，意志消沉。","source":{"text":"因此上怪他每每不听我说，故我意懒心灰，说各人散了。","book":"明·吴承恩《西游记》第四十回"},"example":{"text":"L先生大为～，法西斯的气概顿然消失，披发入山去做和尚去了。","book":"邹韬奋《患难余生记·流亡》"},"similar":["心灰意懒"],"opposite":["信心百倍"],"usage":"作谓语、定语、状语；指人意志消沉"},{"id":18484,"word":"心灰意懒","pinyin":"xīn huī yì lǎn","abbr":"xhyl","explanation":"心、意：心思，意志；灰、懒：消沉，消极。灰心失望，意志消沉。","source":{"text":"因此上怪他每每不听我说，故我意懒心灰，说各人散了。","book":"明·吴承恩《西游记》第四十回"},"example":{"text":"我们没有理由因为某一科没考好而悲观失望，～。"},"similar":["灰心丧气","心如死灰","萎靡不振"],"opposite":["信心百倍","顾盼自雄","趾高气扬"],"usage":"作谓语、定语、状语；指不思进取"},{"id":18485,"word":"心灰意败","pinyin":"xīn huī yì bài","abbr":"xhyb","explanation":"犹心灰意懒。灰心失望，意志消沉。","source":{"text":"初失志，心灰意败，大骂司衡无目，笔墨无灵，势必举案头物而尽炬之。","book":"清·蒲松龄《聊斋志异·王子安》"},"similar":["心灰意冷"],"usage":"作谓语、定语、状语；用于处事"},{"id":18486,"word":"心灵性巧","pinyin":"xīn líng xìng qiǎo","abbr":"xlxq","explanation":"指心思灵巧。","source":{"text":"更喜他心灵性巧，书到跟前，一读便会。","book":"清·李汝珍《镜花缘》第三十六回：“众工人虽系男装，究竟是些妇女，心灵性巧。”又第五十九回"},"example":{"text":"清·名教中人《好逑传》第四回：“不料舍侄女～，恐勾出祸来，就转过口来，要我认做亲父，方肯相从。”"},"usage":"作谓语、定语；用于为人处世等"},{"id":18487,"word":"心灵性慧","pinyin":"xīn líng xìng huì","abbr":"xlxh","explanation":"形容心思灵巧聪慧。","source":{"text":"我虽心灵性慧，争奈是土木之躯，何日是了也呵？","book":"元·贾仲明《升仙梦》第一折"},"example":{"text":"因他～，又有了管雷的前言，忽悟到管小姐原来未死。","book":"清·天花藏主人《玉支矶》第十九回"}},{"id":18488,"word":"心灵手巧","pinyin":"xīn líng shǒu qiǎo","abbr":"xlsq","explanation":"心思灵敏，手艺巧妙（多用在女子）。","source":{"text":"香姐心灵手巧，一捻针线，就是不同的。","book":"清·孔尚任《桃花扇·栖真》"},"example":{"text":"王申也是个～的人，和万宝全差不多。","book":"赵树理《三里湾》"},"similar":["手脚灵便","精明强干"],"opposite":["呆头呆脑","笨手笨脚"],"usage":"作谓语、定语；多用在女子"},{"id":18489,"word":"心灵手敏","pinyin":"xīn líng shǒu mǐn","abbr":"xlsm","explanation":"心思灵敏，手艺巧妙。形容能工巧匠在艺术构思和技艺手法方面的独特表现。也泛指天资聪敏，精明能干。","source":{"text":"若访求草泽知历人等，必须心精手巧，确当一臂之用者，不得过十人。","book":"明·徐光启《礼部为奉旨修改历法开列事宜乞裁疏》"},"example":{"text":"谁知他～，不到半年，已是操演纯熟，上了台比那老唱手还要做的出色。","book":"清·王濬卿《冷眼观》第十回"}},{"id":18490,"word":"心烦意乱","pinyin":"xīn fán yì luàn","abbr":"xfyl","explanation":"意：心思。心思烦乱，不知怎样才好。","source":{"text":"心烦意乱，不知所从。","book":"《楚辞·卜居》"},"example":{"text":"袁绍回冀州，～，不理政事。","book":"明·罗贯中《三国演义》第三十一回"},"similar":["心神不安","坐立不安"],"opposite":["心安理得","从容不迫","心旷神怡"],"usage":"作谓语、状语、定语；指人心神不定"},{"id":18491,"word":"心烦意冗","pinyin":"xīn fán yì rǒng","abbr":"xfyr","explanation":"心思烦乱，不知怎样才好。同“心烦意乱”。","source":{"text":"儿呵，暂时间月直年空，反将息你这心烦意冗。","book":"明·汤显祖《牡丹亭·闹殇》"},"similar":["心烦虑乱","心烦意乱"],"usage":"作宾语、状语、定语；指人心神不定"},{"id":18492,"word":"心烦意燥","pinyin":"xīn fán yì zào","abbr":"xfyz","explanation":"心烦：心情烦躁；意燥：思想杂乱。心思烦乱，不知怎样才好。","source":{"text":"屈原既放，三年不得复见，竭知尽忠，而蔽障于谗。心烦虑乱，不知所从。","book":"战国·楚·屈原《卜居》"},"example":{"text":"子牙在相府，～，进退不宁，十分不爽利；整日不理军情，懒常眠，众将门徒，俱不解是何缘故。","book":"明·许仲琳《封神演义》四十四回"}},{"id":18493,"word":"心烦意闷","pinyin":"xīn fán yì mèn","abbr":"xfym","explanation":"心烦：心情烦躁；意闷：思想杂乱。心思烦乱，不知怎样才好。","source":{"text":"屈原既放，三年不得复见，竭知尽忠，而蔽障于谗。心烦虑乱，不知所从。","book":"战国·楚·屈原《卜居》"},"example":{"text":"紫旒只管招呼朋友，却不见有声，有声却看得他十分清楚，不过～，懒得招呼罢了。","book":"清·吴趼人《近十年之怪现状》第一回"}},{"id":18494,"word":"心烦技痒","pinyin":"xīn fán jì yǎnɡ","abbr":"xfjy","explanation":"烦：烦燥；技痒：指某人想表现其技艺以显示于人。形容擅长及爱好某种技艺，一遇机会就急于表现的情态。","source":{"text":"屏发布而累息，徒心烦而技痒。","book":"晋·潘岳《射雉赋》"},"example":{"text":"遇到这个好机会，你也不免会～的。"},"opposite":["平心静气"],"usage":"作谓语、状语；用于人"},{"id":18495,"word":"心烦虑乱","pinyin":"xīn fán lǜ luàn","abbr":"xfll","explanation":"心思烦乱，不知怎样才好。同“心烦意乱”。","source":{"text":"臣是以宵寝晨兴，叩膺增叹，心烦虑乱，喘呼息吸。","book":"汉·蔡邕《让高阳侯印绶符策》"},"similar":["心烦意乱","心烦意冗"],"usage":"作谓语、状语、定语；指人心神不定"},{"id":18496,"word":"心焉如割","pinyin":"xīn yān rú gē","abbr":"xyrg","explanation":"心像被刀割一样。形容痛楚之甚。","source":{"text":"但未亡人不幸，罹此百忧，感念存没，心焉如割。","book":"《晋书·海西公纪》"},"example":{"text":"瞻望灵爽，实不知所以为怀。俯仰覆载，～。涕泪呜咽，哀何可穷！","book":"明·李东阳《禫祭告先考文》"},"similar":["心如刀割"],"usage":"作谓语、定语、状语；形容极其痛苦"},{"id":18497,"word":"心焦如火","pinyin":"xīn jiāo rú huǒ","abbr":"xjrh","explanation":"内心焦躁得如着火一般。形容焦灼难忍的心情，亦作“心焦如焚”。","source":{"text":"为何马犹不止，心焦如火，怎辞劳瘁。","book":"《群英类选·〈绣襦记·暂宿邮亭〉》"},"similar":["心焦如焚"],"usage":"作谓语、状语；形容心中异常着急"},{"id":18498,"word":"心焦如焚","pinyin":"xīn jiāo rú fén","abbr":"xjrf","explanation":"心里焦躁，像着了火一样。形容心情焦灼难忍。","source":{"text":"中丞此时心焦如焚，听了薇园的话，便叫人到历城县去，交待打听几名好医生来。","book":"清·吴趼人《近十年之怪现状》第二十回"},"example":{"text":"田先生已～，听见了这些话，也不问是谁，严正地呵斥道：‘人家危险的时候，你们还说这样的冷话！’","book":"叶圣陶《线下·游泳》"},"similar":["心焦如火","心急如焚"],"usage":"作谓语、状语；形容心中异常着急"},{"id":18499,"word":"心焦火燎","pinyin":"xīn jiāo huǒ liáo","abbr":"xjhl","explanation":"心里急得像火烧着一样。形容十分焦急。","source":{"text":"她摸黑坐着，心焦火燎地等着邻家的闺女从夜校回来帮她收拾。","book":"柯岩《追赶太阳的人》三"},"similar":["心焦如焚"],"usage":"作定语、状语；用于人的心情"},{"id":18500,"word":"心照不宣","pinyin":"xīn zhào bù xuān","abbr":"xzbx","explanation":"照：知道；宣：公开说出。彼此心里明白，而不公开说出来。","source":{"text":"晋·潘岳《夏侯常侍诔》：“心照神交，唯我与子。”后作“心照不宣”。"},"example":{"text":"哦，哦，那算是我多说了，你是老门槛，我们～，是不是！","book":"茅盾《子夜》十一"},"similar":["心中有数","心领神会","心心相印"],"opposite":["一窍不通","百思不解"],"usage":"作谓语、定语、状语；指彼此有默契"},{"id":18501,"word":"心照情交","pinyin":"xīn zhào qíng jiāo","abbr":"xzqj","explanation":"心意投合，相知有素的友谊。同“心照神交”。","source":{"text":"心照情交，流言靡惑。","book":"南朝·梁·任昉《答陆倕感知己赋》"},"similar":["心照神交"],"usage":"作谓语、定语；指彼此投合"},{"id":18502,"word":"心照神交","pinyin":"xīn zhào shén jiāo","abbr":"xzsj","explanation":"心照：心里了解；神交：忘形之交。心意投合，相知有素的友谊。","source":{"text":"心照神交，惟我与子。","book":"晋·潘岳《夏侯常侍诔》"},"similar":["心照情交"],"usage":"作谓语；指彼此投合"},{"id":18503,"word":"心爽神怡","pinyin":"xīn shuǎng shén yí","abbr":"xssy","explanation":"怡：愉快。心境开阔，精神愉快。","source":{"text":"登斯楼也，则有心旷神怡，宠辱皆忘，把酒临风，其喜洋洋者也。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"鲁诗善于状景咏物，读之如咽冰雪，～。","book":"元·辛文房《唐才子传·崔鲁》"}},{"id":18504,"word":"心狠手毒","pinyin":"xīn hěn shǒu dú","abbr":"xhsd","explanation":"犹言心狠手辣。心肠凶狠，手段毒辣。","source":{"text":"我怕会给周总理带来麻烦，因为张国焘是个心狠手毒的家伙。","book":"廖承志《教诲铭心头，恩情重如山》"},"example":{"text":"他～，得提防一点。"},"similar":["心狠手辣","心辣手狠"],"usage":"作谓语、定语；指人的心肠狠毒","story":["贾琏决定偷偷把尤二姐娶回家，安置在大观园外面。王熙凤知道后，表面让尤二姐风风光光进了贾府，暗中使诡计不给她任何日常物品，又安排尤二姐的原婆家张华到衙门告状要人，让尤二姐处处受贾府人的气，逼使她吞金自杀"]},{"id":18505,"word":"心狠手辣","pinyin":"xīn hěn shǒu là","abbr":"xhsl","explanation":"心肠凶狠，手段毒辣。","source":{"text":"那小娘子听了，欲待不信，又见十五贯钱堆在面前；欲待信来，他平白与我没半句言语，大娘子又过得好，怎么便下得这等狠心辣手。","book":"明·冯梦龙《醒世恒言》第三十三卷"},"example":{"text":"他颐指气使人，～。","book":"林平《从夏三虫说开去》"},"similar":["惨无人道","残酷无情"],"opposite":["心慈面软","菩萨心肠","心慈手软"],"usage":"作谓语、宾语、定语；指人的心肠狠毒"},{"id":18506,"word":"心猿意马","pinyin":"xīn yuán yì mǎ","abbr":"xyym","explanation":"心意好像猴子跳、马奔跑一样控制不住。形容心里东想西想，安静不下来。","source":{"text":"机尽心猿伏，神闲意马行。","book":"汉·魏伯阳《参同契》注：“心猿不定，意马四驰。”唐·许浑《题杜居士》诗"},"example":{"text":"俺从今把～紧牢拴，将繁华不挂眼。","book":"元·关汉卿《望江亭》第一折"},"similar":["三心二意","心烦意乱","心神不定"],"opposite":["心安神定","全神贯注","专心致志"],"usage":"作谓语、定语；指思绪很乱"},{"id":18507,"word":"心甘情原","pinyin":"xīn gān qíng yuán","abbr":"xgqy","explanation":"非常愿意，没有丝毫勉强。"},{"id":18508,"word":"心甘情愿","pinyin":"xīn gān qíng yuàn","abbr":"xgqy","explanation":"心里完全愿意，没有一点勉强。多指自愿做出某种牺牲。","source":{"text":"此事儿甘心情愿也。","book":"宋·王明清《摭青杂说·项四郎》"},"example":{"text":"温州不算十分穷苦的地方，也没碰着大荒年，干什么得了七个小毛钱，就～的将自己的小妹子捧给人家呢？","book":"朱自清《温州的踪迹》"},"similar":["何乐不为","死心塌地"],"opposite":["强人所难","死不甘心"],"usage":"作谓语、宾语、状语；指自愿"},{"id":18509,"word":"心甜意洽","pinyin":"xīn tián yì qià","abbr":"xtyq","explanation":"心里甜蜜，意气融洽。形容美满愉悦的心情。","source":{"text":"宝玉正在心甜意洽之时，和宝黛姊妹说说笑笑的，那肯不吃。","book":"清·曹雪芹《红楼梦》第八回"},"usage":"作定语、状语；用于人的心情"},{"id":18510,"word":"心病还从心上医","pinyin":"xīn bìng hái cóng xīn shàng yī","abbr":"xbhcxsy","explanation":"心里的忧虑或精神负担必须消除造成这种精神负担的因素。","source":{"text":"这的是心病还从心上医。","book":"元·吴昌龄《张天师》"},"similar":["心病还将心药医","心病还须心上医"],"usage":"作宾语、分句；用于劝诫人"},{"id":18511,"word":"心病还将心药医","pinyin":"xīn bìng hái jiāng xīn yào yī","abbr":"xbhjxyy","explanation":"心里的忧虑或精神负担必须消除造成这种精神负担的因素。","source":{"text":"真心病还将心药医也。","book":"明·周楫《西湖二集·吹凤箫女诱东墙》"},"similar":["解铃还须系铃人","心病还从心上医"],"usage":"作宾语、分句；用于劝诫人"},{"id":18512,"word":"心病还用心药医","pinyin":"xīn bìng hái yòng xīn yào yī","abbr":"xbhyxyy","explanation":"心里的忧虑或恋念成了精神负担，必须消除造成这种精神负担的因素才能解决","source":{"text":"自古道，心病还用心药医。怎生设计害了方表，弄他妻子到手。","book":"清·如莲居士《薛刚反唐》第86回"},"example":{"text":"～，我们还是从思想入手吧"},"similar":["心病还将心药医","心病还从心上医"],"usage":"作宾语、分句；用于劝诫人"},{"id":18513,"word":"心病还须心上医","pinyin":"xīn bìng hái xū xīn shàng yī","abbr":"xbhxxsy","explanation":"心里的忧虑或恋念成了精神负担，必须消除造成这种精神负担的因素。","source":{"text":"如此三年，司户不遂其愿，成了相思之病。自古说得好：心病还须心上医。","book":"明·凌濛初《初刻拍案惊奇》卷二十五"},"similar":["心病还须心药医","心病还从心上医"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":18514,"word":"心病还须心药医","pinyin":"xīn bìng hái xū xīn yào yī","abbr":"xbhxxyy","explanation":"心里的忧虑或恋念成了精神负担，必须消除造成这种精神负担的因素。","source":{"text":"聘才摇摇头道：‘此事甚难，从来说心病还须心药医。小侄是知道府上规矩的，难道伯父大人肯许他出去闹吗？’","book":"清·陈森《品花宝鉴》第二十八回"},"example":{"text":"人以为病重，而梨娘且曰：病重不如情重也。谚云：～。曩者梦霞不尝病乎？","book":"徐枕亚《玉梨魂》第十一章"}},{"id":18515,"word":"心病难医","pinyin":"xīn bìng nán yī","abbr":"xbny","explanation":"医：医治。思想上的病不好医治。","source":{"text":"若与空王为弟子，莫教心病最难医。","book":"宋·释道原《景德传灯录》第29卷"},"usage":"作宾语、定语；用于处事等"},{"id":18516,"word":"心痒难抓","pinyin":"xīn yǎng nán zhuā","abbr":"xynz","explanation":"指心中有某种意念或情绪起伏不定，无法克制。同“心痒难挠”。","source":{"text":"一席话说得唐二乱子心痒难抓，跃跃欲试。","book":"明·许仲琳《封神演义》第八十三回：“且说潼关众将听得破万仙阵，俱在关内，一个个心痒难抓，恨不得也来看看。”清·李宝嘉《官场现形记》第三十五回"},"example":{"text":"博如此时真是～，眼看着立时三刻，就是七千两银子到手了。","book":"清·吴研人《二十年目睹之怪现状》第一百五回"},"similar":["心痒难挝","心痒难揉","心痒难挠"],"usage":"作宾语、定语；用于处事等"},{"id":18517,"word":"心痒难挝","pinyin":"xīn yǎng nán zhuā","abbr":"xynz","explanation":"挝：古同“抓”，用指或爪挠。指心中有某种意念或情绪起伏不定，无法克制。同“心痒难挠”。","source":{"text":"忽抬头，见他的那金箍棒靠在东壁，喜得他心痒难挝。","book":"明·吴承恩《西游记》第五十一回"},"similar":["心痒难揉","心痒难挠"],"usage":"作宾语、定语；形容高兴得不知如何才好"},{"id":18518,"word":"心痒难挠","pinyin":"xīn yǎng nán náo","abbr":"xynn","explanation":"指心中有某种意念或情绪起伏不定，无法克制。形容高兴得不知如何才好。","source":{"text":"着小生迷留没乱，心痒难挠。","book":"元·王实甫《西厢记》第一本第四折"},"example":{"text":"那八戒闻得这般富贵，这般美色，他却～；坐在那椅子上，一似针戳屁股左扭右扭的，忍耐不住。","book":"明·吴承恩《西游记》第二十三回"},"similar":["心痒难揉"],"usage":"作宾语；形容高兴得不知如何才好"},{"id":18519,"word":"心痒难揉","pinyin":"xīn yǎng nán róu","abbr":"xynr","explanation":"指心中有某种意念或情绪起伏不定，无法克制。同“心痒难挠”。","source":{"text":"那的是急煎煎心痒难揉。","book":"元·商衟《新水令》套曲：“好教我急煎煎心痒难揉，则教我几声长吁到的晓？”元·尚仲贤《三夺槊》第二折"},"similar":["心痒难挝","心痒难挠"],"usage":"作宾语、定语；形容高兴得不知如何才好"},{"id":18520,"word":"心痒难搔","pinyin":"xīn yǎng nán sāo","abbr":"xyns","explanation":"心里特别痒，难以抚平。指愿望十分强烈。","source":{"text":"谁知庄稚燕在路上说得这也是门，那也是户，好像可以马到成功，弄得阳伯心痒难搔。","book":"曾朴《孽海花》第21回"},"example":{"text":"我被她撩得～。"},"similar":["心痒难挠"],"usage":"作谓语、定语、状语；用于人的情绪"},{"id":18521,"word":"心直口快","pinyin":"xīn zhí kǒu kuài","abbr":"xzkk","explanation":"性情直爽，有话就说。","source":{"text":"哥哥是心直口快射粮军，哥哥是好人。","book":"元·张国宾《罗李郎》第四折"},"example":{"text":"这是一个～，喜欢吵吵闹闹的人。","book":"沙汀《磁力》"},"similar":["单刀直入","直言不讳","开门见山"],"opposite":["转弯抹角","旁敲侧击","别有用心"],"usage":"作谓语、定语、状语；指人的性格"},{"id":18522,"word":"心直嘴快","pinyin":"xīn zhí zuǐ kuài","abbr":"xzzk","explanation":"性情直爽，有话就说。同“心直口快”。","source":{"text":"云姑娘，你如今大了，越发心直口快了。","book":"清·曹雪芹《红楼梦》第三十二回"},"similar":["心直口快","口快心直"],"usage":"作谓语、定语、状语；指人的性格"},{"id":18523,"word":"心瞻魏阙","pinyin":"xīn zhān wèi què","abbr":"xzwq","explanation":"指臣民心在朝廷，关心国事。同“心在魏阙”。","source":{"text":"心瞻魏阙常意悬，游鱼恋饵吞线。卸朝鞯被发何年？名山五岳游遍。","book":"明·张景《飞丸记·盟寻泉石》"},"similar":["心在魏阙","心驰魏阙"],"usage":"作谓语、定语；用于书面语"},{"id":18524,"word":"心知其意","pinyin":"xīn zhī qí yì","abbr":"xzqy","explanation":"意：意义。心中领会了文章的主旨或技艺的要领。","source":{"text":"书缺有间矣，心知其意，固难为浅见寡闻道也。","book":"《史记·五帝本纪》"},"usage":"作谓语、定语；用于处事"},{"id":18525,"word":"心碎肠断","pinyin":"xīn suì cháng duàn","abbr":"xscd","explanation":"形容极度悲伤。","source":{"text":"试想林黛玉的花颜月貌，将来亦到无可寻觅之时，宁不心碎肠断！","book":"清·曹雪芹《红楼梦》第二十八回"},"usage":"作谓语、定语；用于悲伤时"},{"id":18526,"word":"心碎胆裂","pinyin":"xīn suì dǎn liè","abbr":"xsdl","explanation":"吓破了心和胆。形容受到极大的惊吓。","source":{"text":"下官当见此诗，心胆俱碎。","book":"唐·张文成《游仙窟》"},"example":{"text":"贼兵见是云天彪，～，纷纷的跌下马来。","book":"清·俞万春《荡寇志》第九十一回"}},{"id":18527,"word":"心神不宁","pinyin":"xīn shén bù níng","abbr":"xsbn","explanation":"定：安定。形容心情不平静。","source":{"text":"（三藏）心神不宁道：‘徒弟啊，我怎么打寒噤呢？’","book":"明·吴承恩《西游记》第33回"},"example":{"text":"她自己也惊讶为什么如此～，最后她自慰地想到：‘是因为等待慧来。’","book":"茅盾《幻灭》"},"similar":["心神不定"],"opposite":["心如止水"],"usage":"作谓语、定语；形容人的心情"},{"id":18528,"word":"心神不安","pinyin":"xīn shén bù ān","abbr":"xsba","explanation":"安：安定。心里烦躁，精神不安。","source":{"text":"若做了皇帝，就要留头长发，黄昏不睡，五鼓不眠，听有边报，心神不安；见有灾荒，忧愁无奈。","book":"明·吴承恩《西游记》第四十回"},"example":{"text":"这还是他自己的～，乘着虚火作祟，所以那真经当得甚事！","book":"清·西周生《醒世姻缘传》第十七回"}},{"id":18529,"word":"心神不定","pinyin":"xīn shén bù dìng","abbr":"xsbd","explanation":"定：安定。心里烦躁，精神不安。","source":{"text":"心神不定，谓之狐疑。","book":"明·罗贯中《平妖传》第二回"},"example":{"text":"莲峰～，吃了夜饭，却去灯下赶要紧笔墨。","book":"清·俞万春《荡寇志》第九十七回"},"similar":["心神不宁"],"opposite":["镇定自若"],"usage":"作谓语、定语；形容人的心情"},{"id":18530,"word":"心神专注","pinyin":"xīn shén zhuān zhù","abbr":"xszz","explanation":"专注：专心致志。把全部精神集中起来。形容精神高度集中。","example":{"text":"他上课时间～听讲，课后就不需要化很多时间去复习。"},"similar":["专心致志"],"opposite":["心神不定"],"usage":"作谓语、定语、状语；用于处事等"},{"id":18531,"word":"心神恍惚","pinyin":"xīn shén huǎng hū","abbr":"xshh","explanation":"恍惚：神志不清，精神不集中。形容精神不集中或神志不清楚。","source":{"text":"自虚心神恍惚，未敢遽前扪撄。","book":"唐·无名氏《东阳夜怪录》"},"example":{"text":"彩云胡思乱想了一回，觉得～，四肢软胎胎提不起来。","book":"清·曾朴《孽海花》第十二回"},"similar":["心神不定","心绪恍惚"],"usage":"作谓语、定语；形容人的心情"},{"id":18532,"word":"心粗气浮","pinyin":"xīn cū qì fú","abbr":"xcqf","explanation":"粗：粗疏，轻率；浮：浮躁。形容人不细心，不沉着。","source":{"text":"毕竟当武官的心粗气浮，也不管跟前有人没有，开口便说：‘大人，怎么连标下都不认得了？’","book":"清·李宝嘉《官场现形记》第三十回"},"example":{"text":"《儿时》一类文之，因近～，颇不易为；一涉笔总不免含有芒刺，真是如何是好。（鲁迅《书信集·致黎烈文》）"},"similar":["粗心大意","心浮气躁"],"opposite":["心平气和"],"usage":"作谓语、定语；指人性情浮躁"},{"id":18533,"word":"心粗胆壮","pinyin":"xīn cū dǎn zhuàng","abbr":"xcdz","explanation":"形容野心勃勃，肆无忌惮。同“心粗胆大”。","source":{"text":"这会有银子在手里，更是心粗胆壮。","book":"清·李宝嘉《文明小史》第五十五回"},"similar":["心粗胆大"],"usage":"作谓语、定语、状语；用于处事"},{"id":18534,"word":"心粗胆大","pinyin":"xīn cū dǎn dà","abbr":"xcdd","explanation":"心地粗疏，胆子很大。形容野心勃勃，肆无忌惮。亦作“心粗胆壮”。","source":{"text":"这厮便倚强凌弱，心粗胆大，怎敢来俺庄上。不由的忿气夯胸膛。","book":"元·石德玉《秋胡戏妻》第四折"},"example":{"text":"这里则是五亩来，多大一埚。你常好是～，你把俺这坟前地倚强耕过。","book":"元·郑廷玉《忍字记》第四折"},"similar":["心粗胆壮"],"usage":"作谓语、定语、状语；用于处事"},{"id":18535,"word":"心精手巧","pinyin":"xīn jīng shǒu qiǎo","abbr":"xjsq","explanation":"心思灵敏，手艺巧妙。形容能工巧匠在艺术构思和技艺手法方面的独特表现。也泛指天资聪敏，精明能干。","source":{"text":"若访求草泽知历人等，必须心精手巧，确当一臂之用者，不得过十人。","book":"明·徐光启《礼部为奉旨修改历法开列事宜乞裁疏》"},"example":{"text":"另一些～的战士们，他们还为孩子们制作了小手枪、万花筒和滑冰用的小冰车。","book":"魏巍《依依惜别的深情》"}},{"id":18536,"word":"心细于发","pinyin":"xīn xì yú fā","abbr":"xxyf","explanation":"极言小心谨慎，考虑周密。同“心细如发”。","source":{"text":"谁想这位十三妹姑娘，力大于身，还心细于发。","book":"清·文康《儿女英雄传》第十九回"},"similar":["心细如发"],"usage":"作谓语、定语；用于处事"},{"id":18537,"word":"心细如发","pinyin":"xīn xì rú fā","abbr":"xxrf","explanation":"极言小心谨慎，考虑周密。亦作“心细于发”。","source":{"text":"颇闻棋诀在善守，心细如发才如斗。","book":"吴梅《题天香石砚室棋谱》诗"},"example":{"text":"八、九年的部队生活和她的特殊地位，养成她举止老练、大方，明辨是非，遇事果断，而又～。","book":"姚雪垠《李自成》第一卷第四章"},"similar":["心细于发"],"usage":"作谓语、定语；用于处事"},{"id":18538,"word":"心织笔耕","pinyin":"xīn zhī bǐ gēng","abbr":"xzbg","explanation":"比喻靠卖文生活。","source":{"text":"《翰林盛事》云：‘王勃所至，请讬为文，金帛丰积，人谓心织笔耕。’","book":"唐·冯贽《云仙杂记》卷九"},"usage":"作谓语、定语；比喻靠卖文生活"},{"id":18539,"word":"心绪不宁","pinyin":"xīn xù bù níng","abbr":"xxbn","explanation":"宁：安宁，安定。焦急不安。","source":{"text":"朕心绪不宁，教汝等且退，何故又来！","book":"明·罗贯中《三国演义》第85回"},"example":{"text":"这几天我总是～。"},"similar":["心神不定"],"usage":"作谓语、定语；指人心事多"},{"id":18540,"word":"心绪如麻","pinyin":"xīn xù rú má","abbr":"xxrm","explanation":"犹心乱如麻。形容心里非常烦乱。","source":{"text":"某因心绪如麻，忘却一语：此间有一奇士，只在襄阳城外二十里隆中。使君何不求之？","book":"明·罗贯中《三国演义》第三十六回"},"example":{"text":"此刻记了这个，忘了那个；及至想起那个，又忘了这个；真是～，何能再说笑话？","book":"清·李汝珍《镜花缘》第八十三回"},"similar":["心乱如麻"],"usage":"作谓语、定语、状语；形容心里非常烦"},{"id":18541,"word":"心绪恍惚","pinyin":"xīn xù huǎng hū","abbr":"xxhh","explanation":"恍惚：神志不清，精神不集中。形容精神不集中或神志不清楚。","source":{"text":"自虚心神恍惚，未敢遽前扪撄。","book":"战国·楚·宋玉《神女赋》：“精神恍惚，若有所喜。”唐·王洙《东阳夜怪录》"},"example":{"text":"我今日～，想此水亦可治疗，你可批示我去看看。","book":"明·无名氏《杨家将演义》第五十三回"},"similar":["心神恍惚"],"usage":"作谓语、定语；形容人的心情"},{"id":18542,"word":"心肝宝贝","pinyin":"xīn gān bǎo bèi","abbr":"xgbb","explanation":"指十分亲密的人或事物。","source":{"text":"心肝宝贝，你别跑，你的话我知道一半啦，这有什么害臊呢？","book":"清·刘鹗《老残游记续集遗稿》第三回"},"example":{"text":"王太太又何至于当她～样，留到这个岁数还不放？","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["掌上明珠"],"usage":"作宾语、定语；用于对人的昵称"},{"id":18543,"word":"心胆俱碎","pinyin":"xīn dǎn jù suì","abbr":"xdjs","explanation":"形容受到极大的惊吓。同“心胆俱裂”。","source":{"text":"［夫差］于途中连得告急之报，军士已知家国被袭，心胆俱碎，又且远行疲敝，皆无斗志。","book":"《东周列国志》第八十二回"},"example":{"text":"清·褚人获《隋唐演义》第47回：“炀帝见了，～。”"},"similar":["心胆俱裂","心胆皆碎"],"usage":"作谓语、定语、状语；指收到惊吓"},{"id":18544,"word":"心胆俱裂","pinyin":"xīn dǎn jù liè","abbr":"xdjl","explanation":"俱：都。吓破了心和胆。形容受到极大的惊吓。","source":{"text":"窃念备汉朝苗裔，滥叨名爵，伏睹朝廷陵替，纲纪崩摧，群雄乱国，恶党欺君，备心胆俱裂。","book":"明·罗贯中《三国演义》第三十七回"},"example":{"text":"此时蒙古攻城甚急，鄂州将破，似道～，那敢上前？","book":"明·冯梦龙《古今小说》二十二"},"similar":["神不守舍","惊恐万状","心惊肉跳"],"opposite":["镇定自若","若无其事","悠然自得"],"usage":"作谓语、定语、状语；指收到惊吓"},{"id":18545,"word":"心胆皆碎","pinyin":"xīn dǎn jiē suì","abbr":"xdjs","explanation":"吓破了心和胆。形容受到极大的惊吓。","source":{"text":"帝知事泄，心胆皆碎。虑至后宫，伏后方起。","book":"明·罗贯中《三国演义》第六十六回"},"example":{"text":"朕闻兵戈之声，～，方寸乱矣，不能主持。","book":"明·清溪道人《禅真逸史》第十八回"},"similar":["心胆俱裂","心胆俱碎"],"usage":"作谓语、定语、状语；指收到惊吓"},{"id":18546,"word":"心胸开阔","pinyin":"xīn xiōng kāi kuò","abbr":"xxkk","explanation":"心胸：思想，气量。思想坦率接受力强，并非小心眼，心智并不狭窄。","source":{"text":"便自胸次开阔，黑白分明。","book":"宋·朱熹《答吕子约》"},"example":{"text":"只有～的人才能知足常乐。"},"similar":["宽宏大量"],"opposite":["心胸狭隘"],"usage":"作谓语、定语；指人的气量大"},{"id":18547,"word":"心胸狭隘","pinyin":"xīn xiōng xiá ài","abbr":"xxxa","explanation":"心胸：思想，气量。气量非常小。","source":{"text":"今日为众豪杰至此相聚，争奈王伦心胸狭隘，嫉贤妒能，推故不纳，因此火并了这厮，非林冲要图此位。","book":"明·施耐庵《水浒传》第20回"},"example":{"text":"为人不能～。"},"similar":["心地狭窄"],"opposite":["心胸开阔"],"usage":"作谓语、定语；指气量非常小"},{"id":18548,"word":"心腹之交","pinyin":"xīn fù zhī jiāo","abbr":"xfzj","explanation":"指知己可靠的朋友。","source":{"text":"通判乃是心腹之交，径入来同坐何妨！","book":"明·施耐庵《水浒全传》第三十九回"},"usage":"作宾语；指知音"},{"id":18549,"word":"心腹之害","pinyin":"xīn fù zhī hài","abbr":"xfzh","explanation":"心腹：比喻要害。指体内致命的疾病。比喻隐藏在内部的严重祸患。","source":{"text":"今羌胡所以不敢入，据三辅心腹之害者，以凉州在后故也。","book":"南朝·宋·范晔《后汉书·虞诩传》"},"similar":["心腹之患","心腹大患"],"usage":"作宾语；多用于比喻句"},{"id":18550,"word":"心腹之忧","pinyin":"xīn fù zhī yōu","abbr":"xfzy","explanation":"犹心腹之疾。指体内致命的疾病。比喻严重的隐患。","source":{"text":"深恐北平难保，我兵宜先救心腹之忧，后除手足之患。","book":"明·徐渭《英烈传》第六十九回"},"similar":["心腹之疾","心腹重患","心腹之患"],"usage":"作宾语；多用于比喻句"},{"id":18551,"word":"心腹之患","pinyin":"xīn fù zhī huàn","abbr":"xfzh","explanation":"心腹：比喻要害。比喻隐藏在内部的严重祸害。也泛指最大的隐患。","source":{"text":"寇贼在处，四肢之疾；内政不理，心腹之患。","book":"《左传·哀公十一年》：“越在我，心腹之疾也。”《后汉书·陈蕃传》"},"example":{"text":"大家都这么想，这个～一天不除，就一天不得安宁。"},"similar":["心腹大患","心腹之疾"],"opposite":["癣疥之疾"],"usage":"作宾语；指最大的隐患","story":["春秋末年，吴王夫差准备出兵伐齐，越王勾践带臣子及厚礼来朝见，夫差特别高兴。伍子胥认为出兵伐齐，作用不大，当前越国是吴国的心腹之患。夫差根本不听。没过几年，越国趁吴国北上伐晋国时出兵伐吴，将吴国彻底打败"]},{"id":18552,"word":"心腹之疾","pinyin":"xīn fù zhī jí","abbr":"xfzj","explanation":"指体内致命的疾病。比喻严重的隐患。","source":{"text":"越之于吴也譬若心腹之疾也，虽无作，其伤深而在内也。","book":"《左传·哀公十二年》：“越在我，心腹之疾也。”《吕氏春秋·知化》"},"example":{"text":"兼内有萧墙之难，不宜养～。","book":"《晋书·慕容盛载记》"},"similar":["心腹之病","心腹之患","心腹大患"],"usage":"作宾语；多用于比喻句"},{"id":18553,"word":"心腹之病","pinyin":"xīn fù zhī bìng","abbr":"xfzb","explanation":"指体内致命的疾病。比喻严重的隐患。同“心腹之疾”。","source":{"text":"秦之有韩也，譬如木之有蠹也，人之有心腹之病也。","book":"《史记·范睢蔡泽列传》"},"similar":["心腹之患","心腹大患","心腹之疾"],"usage":"作宾语；多用于比喻句"},{"id":18554,"word":"心腹之言","pinyin":"xīn fù zhī yán","abbr":"xfzy","explanation":"藏在心里轻易不说的真心话。","source":{"text":"玄德看了，急来车前泣告孙夫人曰：‘备有心腹之言，至此尽当实诉。’","book":"明·罗贯中《三国演义》第55回"},"example":{"text":"以上就是我的～。"},"similar":["肺腑之言"],"usage":"作主语、宾语；指真心话"},{"id":18555,"word":"心腹大患","pinyin":"xīn fù dà huàn","abbr":"xfdh","explanation":"指严重隐患或要害部门的大患。同“心腹重患”。","source":{"text":"徐州吕布，实为心腹大患。","book":"明·施耐庵《水浒传》第五十四回：“此是心腹大患，若不早行诛戮剿除，他日养成贼势，难以制伏。”明·罗贯中《三国演义》第十八回"},"example":{"text":"我国若不先自下手，自办银行，自筑铁路，必被外人先我着鞭，倒是～哩！","book":"清·曾朴《孽海花》第十八回"},"similar":["心腹之患","心腹重患"],"usage":"作宾语；指最大的隐患"},{"id":18556,"word":"心腹爪牙","pinyin":"xīn fù zhǎo yá","abbr":"xfzy","explanation":"心腹：比喻亲信；爪牙：比喻辅佐的人。指亲信羽翼。","source":{"text":"尚自少侍从，尽诚竭节，虽云异姓，其犹骨肉，是以入为腹心，出当爪牙。","book":"《魏书》"},"example":{"text":"曹氏～，死据宫门。","book":"明·罗贯中《三国演义》第69回"},"similar":["心膂股肱"],"usage":"作宾语、定语；用于书面语"},{"id":18557,"word":"心腹重患","pinyin":"xīn fù zhòng huàn","abbr":"xfzh","explanation":"指严重隐患或要害部门的大患。","source":{"text":"一令蔓草难鉏，涓流泛酌，岂直疥痒轻痾，容为心腹重患。","book":"《南齐书·王融传》"},"similar":["心腹大患","心腹之患"],"usage":"作宾语；指最大的隐患"},{"id":18558,"word":"心膂爪牙","pinyin":"xīn lǚ zhǎo yá","abbr":"xlzy","explanation":"膂：脊骨；爪牙：比喻护卫武臣。指近恃武臣。","source":{"text":"入作心膂，出为爪牙。","book":"《三国志·吴志·周瑜传》"},"example":{"text":"元初用左右宿卫为～。","book":"《元史·选举志二》"},"usage":"作宾语、定语；多用于比喻句"},{"id":18559,"word":"心膂股肱","pinyin":"xīn lǚ gǔ gōng","abbr":"xlgg","explanation":"膂：脊骨。股：大腿。肱：胳膊上从肩到肘的部分。心、膂、股、肱都是人体的重要部分，比喻亲近得力之人。","source":{"text":"今命尔予翼，作股肱心膂。","book":"语出《书·君牙》"},"example":{"text":"皇上以～寄之内阁诸臣，徒以票拟四五字了宰相事业，皇上纵不谴责，清夜扪心，恐有难以自慰者。","book":"《清史稿·季开生传》"},"similar":["心腹爪牙"],"usage":"作宾语、定语；用于书面语"},{"id":18560,"word":"心花开爽","pinyin":"xīn huā kāi shuǎng","abbr":"xhks","explanation":"心里高兴得象花儿盛开一样。形容极其高兴。","source":{"text":"种种巧用，令人心花开爽。","book":"明·王征《远西奇器图说序》"}},{"id":18561,"word":"心花怒发","pinyin":"xīn huā nù fā","abbr":"xhnf","explanation":"犹心花怒放。形容极其高兴。","source":{"text":"［安公子］听了，只乐得眼花儿缭乱，心花儿怒发，不差甚么连他自己出过花儿没出过花儿都乐忘了。","book":"清·文康《儿女英雄传》第三十回"},"example":{"text":"黄子文以为是有情于他，喜得～，意蕊横飞。","book":"《负曝闲谈》第十四回"},"similar":["心花怒放","心花怒开"],"usage":"作谓语、状语；用于人的心情"},{"id":18562,"word":"心花怒开","pinyin":"xīn huā nù kāi","abbr":"xhnk","explanation":"犹心花怒放。形容极其高兴。","source":{"text":"偶读奇丽川方伯题卢湘艖《美人宝剑图》一绝，不觉心花怒开。","book":"清·袁枚《随园诗话·补遗》"},"example":{"text":"杨愕听了他这话，～，眉飞色舞了一回道：“这个倒容易。”","book":"清·吴趼人《糊涂世界》第十回"},"similar":["心花怒发","心花怒放"],"usage":"作谓语、状语；用于人的心情"},{"id":18563,"word":"心花怒放","pinyin":"xīn huā nù fàng","abbr":"xhnf","explanation":"怒放：盛开。心里高兴得象花儿盛开一样。形容极其高兴。","source":{"text":"平中丞此时喜得心花怒放，连说：‘难为他了，难为他了。’","book":"清·李宝嘉《文明小史》第六十回"},"example":{"text":"想起这件高兴事，不觉～。"},"similar":["兴高采烈","欣喜若狂"],"opposite":["黯然销魂","五内俱焚"],"usage":"作谓语、定语、补语；指极其高兴"},{"id":18564,"word":"心若寒灰","pinyin":"xīn ruò hán huī","abbr":"xrhh","explanation":"原指心境淡漠，毫无情感。现也形容意志消沉，态度冷漠到极点。","source":{"text":"失意多病，衰不待年，心如寒灰，头有白发。","book":"《庄子·齐物论》：“形固可使如槁木，而心固可使如死灰乎？”唐·刘禹锡《上杜司徒启》"}},{"id":18565,"word":"心若死灰","pinyin":"xīn ruò sǐ huī","abbr":"xrsh","explanation":"死灰：已冷却的灰烬。形容不为外物所动的一种精神状态。现多用以形容灰心失意。","source":{"text":"形固可使如槁木，而心固可使如死灰乎？","book":"《庄子·齐物论》"},"example":{"text":"～，不营势利，家无儋石，不费囊钱。","book":"《隋书·卢思道传》"},"similar":["心如死灰","心如寒灰"],"usage":"作谓语、定语；用于处事"},{"id":18566,"word":"心荡神怡","pinyin":"xīn dàng shén yí","abbr":"xdsy","explanation":"指神魂颠倒，不能自持。亦指情思被外物吸引而飘飘然。同“心荡神摇”。","source":{"text":"炀帝看了这些佳人的态度，不觉心荡神怡，忍不住立起身来，好像元宵走马灯，团团的在中间转。","book":"清·褚人获《隋唐演义》第三十回"},"similar":["心荡神摇","心荡神迷"],"opposite":["无动于衷"],"usage":"作谓语、定语；指人心神不定"},{"id":18567,"word":"心荡神摇","pinyin":"xīn dàng shén yáo","abbr":"xdsy","explanation":"指神魂颠倒，不能自持。亦指情思被外物吸引而飘飘然。","source":{"text":"猛然一见，不觉心荡神摇，精魄已失。","book":"明·兰陵笑笑生《金瓶梅词话》第十八回"},"similar":["心荡神迷","心荡神怡"],"usage":"作谓语、定语；指人心神不定"},{"id":18568,"word":"心荡神移","pinyin":"xīn dàng shén yí","abbr":"xdsy","explanation":"像受到一种超自然的力量作用激起强烈情绪，神魂颠倒，不能自持。","example":{"text":"他被她整得～。"},"similar":["心荡神摇"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；指人心神不定"},{"id":18569,"word":"心荡神迷","pinyin":"xīn dàng shén mí","abbr":"xdsm","explanation":"荡：摇动。形容心神不定，难以自持。","source":{"text":"猛然一见，不觉心荡神摇，精魂已失。","book":"明·兰陵笑笑生《金瓶梅词话》第十八回"},"example":{"text":"阳衍正在～，一闻此语，慌忙接过芍药道：“承女郎见爱，何福能消！但未识芳闺何处？”","book":"清·李汝珍《镜花缘》第九十八回"},"similar":["心荡神驰","心荡神摇"],"opposite":["镇定自若"],"usage":"作谓语、定语；指人心神不定"},{"id":18570,"word":"心荡神驰","pinyin":"xīn dàng shén chí","abbr":"xdsc","explanation":"心神飘荡，不能控制自己。","example":{"text":"桂林山水让我～。"},"similar":["心弛神往"],"opposite":["镇定自若"],"usage":"作谓语、定语；指人心神不定"},{"id":18571,"word":"心虔志诚","pinyin":"xīn qián zhì chéng","abbr":"xqzc","explanation":"虔：恭敬。心意恭敬、诚恳。","source":{"text":"委实心虔志诚，料不能逃菩萨洞察。","book":"明·吴承恩《西游记》第九十九回"},"usage":"作谓语、定语；指人诚恳"},{"id":18572,"word":"心虚胆怯","pinyin":"xīn xū dǎn qiè","abbr":"xxdq","explanation":"形容理亏气馁，胆小害怕。","source":{"text":"而且聘才在车上，一路上说了些利害话，心虚胆怯，只得战战兢兢上前，见夫人磕了一个头起来，低头傍立。","book":"清·陈森《品花宝鉴》第二十八回"},"example":{"text":"本来就～，听独眼龙这样一喊，又见他这样慌张地往外跑，有的也跟着喊起来。","book":"刘流《烈火金刚》第三回"}},{"id":18573,"word":"心融神会","pinyin":"xīn róng shén huì","abbr":"xrsh","explanation":"指心神融会贯通，领悟明白。","source":{"text":"工夫久之，自当心融神会，默与契合。","book":"《续传灯录·杨岐禅师》：“阅经闻法，心融神会。能痛自折节，依参老宿。”宋·朱熹《答廖子晦》"},"usage":"作谓语、定语；用于处事"},{"id":18574,"word":"心血来潮","pinyin":"xīn xuè lái cháo","abbr":"xxlc","explanation":"来潮：潮水上涨。指心里突然或偶然起了一个念头。","source":{"text":"但凡神仙，烦恼、嗔痴、爱欲三事永忘……心血来潮者，心中忽动耳。","book":"明·许仲琳《封神演义》第三十四回"},"example":{"text":"想着，一时～，跟在冯老兰背后走进家去。","book":"梁斌《红旗谱》十二"},"similar":["灵机一动"],"opposite":["处心积虑","千方百计"],"usage":"作谓语、宾语、定语；常与“忽然”连用","story":["传说乾元山金光洞有太乙真人闲坐碧游床，正运元神，忽心血来潮。因为神仙把烦恼、嗔痴、爱欲这三件事永远抛弃在脑后，要做到心如磐石永不动摇，如果心血来潮将预示有事情发生。果然不久弟子来报，弟子呐吒出事了"]},{"id":18575,"word":"心计手授","pinyin":"xīn jì shǒu shòu","abbr":"xjss","explanation":"计：计算，筹划；授：传授。精心筹划，亲手传授。","source":{"text":"度材于山，赋庸于兵，心计手授，百堵皆作。","book":"金·元好问《邓州新仓记》"},"usage":"作谓语、定语；用于书面语"},{"id":18576,"word":"心谤腹非","pinyin":"xīn bàng fù fēi","abbr":"xbff","explanation":"口里不说，心里谴责。指暗地里反对。","source":{"text":"魏其、灌夫日夜招聚天下豪桀壮士与论议，腹诽而心谤。","book":"西汉·司马迁《史记·魏其武安侯列传》"},"example":{"text":"已而虑群下疑惑，～。","book":"《魏书·太祖纪》"},"similar":["口是心非"],"usage":"作谓语、定语；指暗地里反对"},{"id":18577,"word":"心贯白日","pinyin":"xīn guàn bái rì","abbr":"xgbr","explanation":"指心地与太阳一般光明。极喻坦诚，磊落。","source":{"text":"国家委将军以疆埸之任，任将军以图蜀之事，可谓心贯白日。","book":"《晋书·宣帝纪》"},"usage":"作宾语、定语；用于比喻句"},{"id":18578,"word":"心软意活","pinyin":"xīn ruǎn yì huó","abbr":"xryh","explanation":"软：柔和、温和。形容人心肠软，富有同情心。","source":{"text":"金桂听见他婆婆如此说，怕薛蟠心软意活了，便泼声浪气大哭起来","book":"清·曹雪芹《红楼梦》第八十回"},"similar":["心活面软"],"usage":"作谓语、定语；指没有主见"},{"id":18579,"word":"心辣手狠","pinyin":"xīn là shǒu hěn","abbr":"xlsh","explanation":"心肠凶狠，手段毒辣。同“心狠手辣”。","source":{"text":"可旺今年才二十二岁，但心辣手狠，超过他的义父。","book":"姚雪垠《李自成》第一卷第十九章"},"similar":["心狠手辣","心狠手毒"],"opposite":["菩萨心肠"],"usage":"作谓语、宾语、定语；指人的心肠狠毒"},{"id":18580,"word":"心迹双清","pinyin":"xīn jì shuāng qīng","abbr":"xjsq","explanation":"指心地、行为高洁，没有尘俗之气。","source":{"text":"杖藜从白首，心迹喜双清。","book":"南朝·宋·谢灵运《斋中读书》：“矧迺归山川，心迹双寂寞。”唐·杜甫《屏迹三首》其二"},"example":{"text":"占此地荷亭竹榭，还期～。","book":"清·梁章钜《温处道署楹联》"}},{"id":18581,"word":"心逸日休","pinyin":"xīn yì rì xiū","abbr":"xyrx","explanation":"指不费心机，反而越来越好。","source":{"text":"前王之法制罔殊，百代之科条悉在，无烦改作，各有定规，守程序者心逸日休，率胸臆者心劳日拙。","book":"《书·周官》：“作德，心逸日休；作伪，心劳日拙。”《旧五代史·职官志》"},"example":{"text":"是非真能不见一丝作为之迹，而自享～之效者欤！","book":"明·李贽《答耿中丞书》"},"opposite":["心劳日拙"],"usage":"作宾语、定语；用于书面语"},{"id":18582,"word":"心醇气和","pinyin":"xīn chún qì hé","abbr":"xcqh","explanation":"醇：纯厚朴实；气：气质。心地纯朴，气质温和。形容人憨厚老实。","source":{"text":"形大而声宏，行峻而言厉，心醇而气和。","book":"唐·韩愈《答尉迟生书》"},"usage":"作谓语、定语、状语；用于为人等"},{"id":18583,"word":"心醉神迷","pinyin":"xīn zuì shén mí","abbr":"xzsm","explanation":"形容佩服爱幕到极点。同“心醉魂迷”。","source":{"text":"施密特博士又一次将九龙杯从保险柜中取出，坐在小圆桌前心醉神迷地鉴赏起来。","book":"李亚平《九龙杯传奇》"},"example":{"text":"一想到马上要上大学，我就～。"},"similar":["心醉魂迷"],"usage":"作谓语、状语；指十分迷恋"},{"id":18584,"word":"心醉魂迷","pinyin":"xīn zuì hún mí","abbr":"xzhm","explanation":"形容佩服爱幕到极点。","source":{"text":"所值名贤，未尝不心醉魂迷，向慕之也。","book":"北齐·颜之推《颜氏家训·慕贤》"},"example":{"text":"他～地鉴赏这个古玩。"},"similar":["心醉神迷"],"usage":"作谓语、定语；指十分迷恋"},{"id":18585,"word":"心里有底","pinyin":"xīn lǐ yǒu dǐ","abbr":"xlyd","explanation":"心中知道底细或内情而有把握。","example":{"text":"我～，不必害怕考试。"},"similar":["心中有数"],"opposite":["心中没底"],"usage":"作谓语、定语；指有把握"},{"id":18586,"word":"心里有鬼","pinyin":"xīn lǐ yǒu guǐ","abbr":"xlyg","explanation":"指心里暗藏不可告人的目的或计划。","example":{"text":"她一时～，被我们识破。"},"similar":["心中有鬼"],"usage":"作谓语、定语；指暗藏目的"},{"id":18587,"word":"心长力弱","pinyin":"xīn cháng lì ruò","abbr":"xzlr","explanation":"心里很想做，但力量够不上。","source":{"text":"学校的一波未平，上海的一波又起，小鬼心长力弱，深感应付无方。","book":"鲁迅《两地书》二八"},"similar":["心长力短"],"usage":"作谓语、定语；指力不从心"},{"id":18588,"word":"心长力短","pinyin":"xīn cháng lì duǎn","abbr":"xcld","explanation":"心里很想做，但力量够不上。","source":{"text":"今天仲翁来招呼我们，实在我们心长力短，对不起极了！","book":"茅盾《子夜》十六"},"similar":["心长力弱","心有余而力不足"],"usage":"作谓语；指力不从心"},{"id":18589,"word":"心长发短","pinyin":"xīn cháng fà duǎn","abbr":"xcfd","explanation":"心长：智谋深；发短：指年老。头发稀少，心计很多。形容年老而智谋高。","source":{"text":"彼其发短而心甚长，其或寝处我矣。","book":"《左传·昭公三年》"},"example":{"text":"虽然我六旬过，血气衰，我犹敢把三五石家硬弓开，便小觑的我～渐斑白，我可也怎肯伏年高迈。","book":"元·无名氏《小尉迟》第二折"},"similar":["发短心长"],"usage":"作谓语、定语；指力不从心"},{"id":18590,"word":"心长绠短","pinyin":"xīn cháng gěng duǎn","abbr":"xcgd","explanation":"比喻力不从心。","source":{"text":"百丈寒泉尚堪饮，心长绠短空愁立。","book":"明·何景明《古井篇》"},"similar":["心长力短"],"usage":"作谓语、定语；用于书面语"},{"id":18591,"word":"心问口，口问心","pinyin":"xīn wèn kǒu，kǒu wèn xīn","abbr":"xwkkwx","explanation":"形容内心反复思考，自问自答。","source":{"text":"这才是进退两难心问口，三思忍耐口问心。","book":"明·吴承恩《西游记》第三十七回"},"example":{"text":"这张姑娘只管如此～的一番盘算，脸上那种为难的样子，比方才憋着那泡尿还露着为难。","book":"清·文康《儿女英雄传》第九回"},"similar":["心喻口，口喻心"],"usage":"作宾语、定语；用于处事"},{"id":18592,"word":"心闲体正","pinyin":"xīn xián tǐ zhèng","abbr":"xxtz","explanation":"心里宁静，行为端正。","source":{"text":"则不以目视，不以策驱；心闲体正，六辔不乱。","book":"《列子·汤问》"}},{"id":18593,"word":"心闲手敏","pinyin":"xīn xián shǒu mǐn","abbr":"xxsm","explanation":"闲：熟悉；敏：灵敏。形容技艺熟练了，心里闲静，手法灵敏。","source":{"text":"于是器冷弦调，心闲手敏。","book":"三国魏·嵇康《琴赋》"},"similar":["心灵手巧"],"usage":"作谓语、定语；指人的技艺高"},{"id":18594,"word":"心雄万夫","pinyin":"xīn xióng wàn fū","abbr":"xxwf","explanation":"雄：雄于，在雄心方面超过。雄心胜过一万个人的心志。形容志向极大。","source":{"text":"虽长不满七尺，而心雄万夫。","book":"唐·李白《与韩荆州书》"},"example":{"text":"明·唐道虔《答友人问疾书》：“一念感慨，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":18595,"word":"心非巷议","pinyin":"xīn fēi xiàng yì","abbr":"xfxy","explanation":"心里不满，而在私下议论。","source":{"text":"入则心非，出则巷议。","book":"语出《史记·秦始皇本纪》"},"example":{"text":"清·戴名世《再上韩宗伯书》：“考校之文一出，而～，嗤点流传，共指为笑。”"},"usage":"作主语、宾语；用于书面语"},{"id":18596,"word":"心非木石","pinyin":"xīn fēi mù shí","abbr":"xfms","explanation":"人心不是木头、石块做的。意思是人是有感情的。","source":{"text":"臣虽愚固，心非木石，谨当竭诚效命，以答鸿恩。","book":"南朝·宋·鲍照《拟行路难十八首》之四：“心非木石岂无感？吞声踯躅不敢言。”《隋书·李雄传》"},"example":{"text":"使佳人才子，临风对月，～，岂无所思！","book":"元·郑光祖《梅香》第三折"},"similar":["人非木石"],"opposite":["石心铁肠","铁石心肠"],"usage":"作宾语、分句；多用于感慨等"},{"id":18597,"word":"心领意会","pinyin":"xīn lǐng yì huì","abbr":"xlyh","explanation":"指对方没有明说，心里已经领会。同“心领神会”。","source":{"text":"他们不许用‘帝国主义’，所以各报遇着这个名字，总写着‘ｘｘ主义’，读者看得惯了，也就心领意会。","book":"邹韬奋《经历》五六"},"similar":["心领神会","心领神悟"],"usage":"作谓语、定语、状语；用于处事"},{"id":18598,"word":"心领神会","pinyin":"xīn lǐng shén huì","abbr":"xlsh","explanation":"领、会：领悟，理解。指对方没有明说，心里已经领会。","source":{"text":"读书有得，冥然感于中，心领神会，端坐若失。","book":"明·吴海《送傅德谦还临川序》"},"example":{"text":"闻语法要，辄～。","book":"明·赵弼《觉寿居士传》"},"similar":["心照不宣","心心相印"],"opposite":["一无所知","茫然不解"],"usage":"作谓语、定语、状语；用于诗文、语言等"},{"id":18599,"word":"心领神悟","pinyin":"xīn lǐng shén wù","abbr":"xlsw","explanation":"指对方没有明说，心里已经领会。同“心领神会”。","source":{"text":"会读书的，细加玩赏，自然能心领神悟，终身受用不尽。","book":"朱自清《经典常谈·四书》"},"similar":["心领意会","心领神会"],"usage":"作谓语、定语、状语；用于诗文、语言等"},{"id":18600,"word":"心颤魂飞","pinyin":"xīn chàn hún fēi","abbr":"xchf","explanation":"形容惊恐不安。","source":{"text":"是心颤魂飞时的言语，是肠回荡气时的哀音。","book":"苏雪林《玉溪诗迷·附录》"},"example":{"text":"是～的言语，是肠回气荡时的哀音。","book":"苏雪林《玉溪诗迷·附录》"},"similar":["胆颤心惊"],"usage":"作定语、状语；用于书面语"},{"id":18601,"word":"心香一瓣","pinyin":"xīn xiāng yī bàn","abbr":"xxyb","explanation":"心香：旧时称中心虔诚，就能感通佛道，同焚香一样。比喻十分真诚的心意。","source":{"text":"祷雨文昌，只全靠、心香一瓣。","book":"唐·韩偓《仙山》诗：“一炷心香洞府开，偃松皱涩半莓苔。”宋·瞿翁《满江红·孟史君祷而得雨》"},"example":{"text":"留几般残笺兼断楮，尽教人短诵又长谣，～虔烧，恨不识先生貌，只认得押角的红泥把姓名标。","book":"清·梁绍壬《两般秋雨庵随笔》卷二"},"similar":["一瓣心香"],"usage":"作宾语、定语；用于书面语"},{"id":18602,"word":"心驰神往","pinyin":"xīn chí shén wǎng","abbr":"xcsw","explanation":"驰：奔驰。心神奔向所向往的事物。形容一心向往。","source":{"text":"身在边隅，情驰魏阙。","book":"《隋书·史祥传》"},"example":{"text":"那美丽如画的山水真让我～。"},"similar":["心往神驰","心动神驰"],"usage":"作定语、状语；用于处事等"},{"id":18603,"word":"心驰魏阙","pinyin":"xīn chí wèi què","abbr":"xcwq","explanation":"指臣民心在朝廷，关心国事。同“心在魏阙”。","source":{"text":"敛时百福，享国万年。臣迹遐陬，心驰魏阙。","book":"宋·陆游《会庆节贺表》之一"},"similar":["心在魏阙","心瞻魏阙"],"usage":"作谓语、定语；用于书面语"},{"id":18604,"word":"心高于天","pinyin":"xīn gāo yú tiān","abbr":"xgyt","explanation":"形容心地高傲或所想超过现实。","example":{"text":"仿佛是命运存心捉弄这个～、命薄于纸的老人。","book":"霍达《穆斯林的葬礼》第十章"}},{"id":18605,"word":"心高气傲","pinyin":"xīn gāo qì ào","abbr":"xgqa","explanation":"心比天高，气性骄傲。态度傲慢，自以为高人一等。","source":{"text":"我可也心高气傲惹人憎。","book":"元·无名氏《冻苏秦》第一折"},"example":{"text":"他到任之后，靠着自己内有奥援，总有点～。（清·李宝嘉《官场现形记》第四十二回）"},"similar":["心浮气盛","好高骛远"],"usage":"作谓语、定语；指态度傲慢，自以为高人一等"},{"id":18606,"word":"心高气硬","pinyin":"xīn gāo qì yìng","abbr":"xgqy","explanation":"气：指气势或气质。心比天高，气性骄傲。形容态度傲慢，自以为高人一等。","source":{"text":"我可也心高气傲惹人憎。","book":"元·无名氏《冻苏秦》第一折"},"example":{"text":"你平日里～，笑伊家今日无计谋生。","book":"明·王錂《春芜记·反目》"},"similar":["心高气傲","自命不凡"],"usage":"作谓语、定语；指人态度傲慢"},{"id":18607,"word":"必不可少","pinyin":"bì bù kě shǎo","abbr":"bbks","explanation":"绝对需要，指不达到某种目的就不能做成某种事情。","source":{"text":"判死刑也是一种必不可少的教育手段。","book":"邓小平《在中央政治局常委会上的讲话》"},"example":{"text":"食品是人人～的。"},"similar":["缺一不可"],"opposite":["可有可无"],"usage":"作谓语、定语、状语；指绝对需要"},{"id":18608,"word":"必不得已","pinyin":"bì bù dé yǐ","abbr":"bbdy","explanation":"必然不能得止。指形势使得非如此不可。表示无可奈何的意思。","source":{"text":"子贡问政。子曰：‘足食，足兵，民信之矣。’子贡曰：‘必不得已而去，于斯三者何先？’曰：‘去兵。’","book":"《论语·颜渊》"},"example":{"text":"布之威怀，革其非心，～，则仗大顺以讨之，出师以征之。","book":"唐·权德舆《世祖封不义侯议》"},"similar":["迫不得已"],"usage":"作谓语、定语、分句；指实在不得不如此"},{"id":18609,"word":"必不挠北","pinyin":"bì bù náo běi","abbr":"bbnb","explanation":"挠北：败北，作战失败。必定不会失败。","source":{"text":"若此人也，有势则必不自私矣；处官则必不为污矣；将众则必不挠北矣。","book":"《吕氏春秋·忠廉》"},"similar":["稳操胜券"],"usage":"作谓语；指一定胜利"},{"id":18610,"word":"必也正名","pinyin":"bì yě zhèng míng","abbr":"byzm","explanation":"指必须按照正统伦理观念和礼仪关系来端正纲纪名分。","source":{"text":"子路曰：‘卫君待子而为政，子将奚先？’子曰：‘必也正名乎！’","book":"《论语·子路》"},"example":{"text":"～，各司其局，古人所守，某敢忘之？","book":"宋·王谠《唐语林·方正》"},"usage":"作谓语；指名声"},{"id":18611,"word":"必争之地","pinyin":"bì zhēng zhī dì","abbr":"bzzd","explanation":"敌对双方非争夺不可的战略要地。","source":{"text":"白马要冲，是必争之地。今城守寡弱，易可图也。","book":"《周书·王悦传》"},"example":{"text":"若灵武于贼有大利，即是～。","book":"宋·杨亿《论灵州事宜》"},"usage":"作宾语；指非常重要的地方","story":["东魏被北齐取代，与西魏的战争连绵不断。西魏宇文泰巩固东边疆土后就派大将王悦率军攻占汉中。汉中城主杨贤投诚。王悦派人飞报达奚武说取汉中后要攻占白马城，那是必争之地，白马能取下就能断蜀兵的后路"]},{"id":18612,"word":"必以情","pinyin":"bi yi qing","abbr":"byq","explanation":"一定尽可能按实情去判决。"},{"id":18613,"word":"必恭必敬","pinyin":"bì gōng bì jìng","abbr":"bgbj","explanation":"恭、敬：端庄而有礼貌。形容态度十分恭敬。","source":{"text":"维桑与梓，必恭敬止，靡瞻匪父，靡依匪母。","book":"《诗经·小雅·小弁》"},"example":{"text":"如父亲冥寿之用度，妹甚不赞成，但须一桌菜祭之，～，即尽人子之孺慕。","book":"清·秋谨《致秋誉章书》其五"},"similar":["肃然起敬","彬彬有礼","毕恭毕敬"],"opposite":["出言不逊"],"usage":"作谓语、定语、状语；形容伪善的态度","story":["西周周幽王十分昏庸暴虐，十分宠爱褒国进献的美女褒姒，想尽千方百计并不惜一切代价地让褒姒一笑，对外得罪各路诸侯，废除原太子宜臼立褒姒的儿子伯服为太子。尽管如此，宜臼写《小弁》诗抒发对父母必恭必敬的心情"]},{"id":18614,"word":"必操胜券","pinyin":"bì cāo shèng quàn","abbr":"bcsq","explanation":"操：持，拿；券：凭证；胜券：胜利的把握。一定有胜利的把握。","source":{"text":"常执左券，以责于秦韩。","book":"西汉·司马迁《史记·田敬仲世家》"},"example":{"text":"这次比赛，中国队～。"},"similar":["稳操胜算","稳操左券"],"usage":"作谓语、宾语、补语；形容对胜利有把握"},{"id":18615,"word":"必由之地","pinyin":"bì yóu zhī dì","abbr":"byzd","explanation":"必：一定；由：经过。必定要经过的道路、地方。","source":{"text":"此人闻得青州有三千银子上京，兖州乃必由之地，意欲探取。","book":"清·褚人获《隋唐演义》第21回"},"similar":["必经之地","必由之路"],"usage":"作主语、宾语；用于地理等"},{"id":18616,"word":"必由之路","pinyin":"bì yóu zhī lù","abbr":"byzl","explanation":"由：经由。必定要经过的道路。泛指事物必须遵循的规律或做事必须遵守的法则。","source":{"text":"义者行事之宜，谓人之路，则可以见其为出入往来必由之路，而不可须臾舍矣。","book":"《孟子·告子上》：“仁，人心也；义，人路也。”宋·朱熹注"},"example":{"text":"那山离此有六十里远，正是西方～，却有八百里火焰，四周围寸草不生。","book":"明·吴承恩《西游记》第五十九回"},"similar":["必经之路","终南捷径"],"opposite":["此路不通","歪门邪道","左道旁门"],"usage":"作主语、宾语；指为达到目的必须遵循的"},{"id":18617,"word":"必经之路","pinyin":"bì jīng zhī lù","abbr":"bjzl","explanation":"经：经过。必定要经过的道路。泛指事物必须遵循的规律或做事必须遵守的法则。","source":{"text":"义者行事之宜，谓人之路，则可以见其为出入往来必由之路，而不可须臾舍矣。","book":"《孟子·告子上》：“仁，人心也；义，人路也。”宋·朱熹注"},"example":{"text":"桥北有八角碑亭，乃去来～。","book":"清·珠泉居士《续板桥杂记·下·轶事》"},"similar":["必由之路"],"opposite":["歪门邪道"],"usage":"作主语、宾语；指为达到目的必须遵循的东西"},{"id":18618,"word":"必躬必亲","pinyin":"bì gōng bì qīn","abbr":"bgbq","explanation":"指凡事都要自己经手。","source":{"text":"《诗·小雅·节南山》：“弗躬弗亲，庶民弗信。”后转为“必躬必亲”。"},"example":{"text":"那位伍大令初到任时，便发誓每事～，绝不假手书吏、家丁，大门以内的事，无论公私，都有要自己经手。","book":"《二十年目睹之怪现状》第四六回"},"similar":["事必躬亲"],"opposite":["游手好闲","置之不理"],"usage":"作谓语、定语；指亲自"},{"id":18619,"word":"必里迟离","pinyin":"bì lǐ chí lí","abbr":"blcl","explanation":"阴历九月九日。","source":{"text":"九月重九日，天子率群臣部族射虎，少者为负，罚重九宴。……国语谓是日为‘必里迟离’，九月九日也。","book":"《辽史·嘉仪志》"},"similar":["重阳佳节"],"usage":"作宾语；指重阳节"},{"id":18620,"word":"忆昔抚今","pinyin":"yì xī fǔ jīn","abbr":"yxfj","explanation":"回忆昔日，看看今天。","example":{"text":"～，我思绪万千。"},"usage":"作谓语、状语、分句；指今昔对比"},{"id":18621,"word":"忆苦思甜","pinyin":"yì kǔ sī tián","abbr":"ykst","explanation":"回忆过去的苦难，回想今天的幸福生活。","source":{"text":"忆苦思甜当然要搞，但只搞忆苦思甜就不够了，要研究如何在新的历史条件下提高战士的政治觉悟。","book":"邓小平《在全军政治工作会议上的讲话》"},"example":{"text":"现身说法，生动具体，～，诱人深思。","book":"李欣《老生常谈·编村史》"},"usage":"作谓语、定语、宾语；指两种生活比较"},{"id":18622,"word":"忌克少威","pinyin":"jì kè shǎo wēi","abbr":"jksw","explanation":"忌克：忌恨贤能，欲出人头地；威：威信。形容猜忌、刻薄，没有威望。","source":{"text":"吾知绍之为人，志大而智小，色厉而胆薄，忌克而少威。","book":"《左传·僖公九年》：“今其言多忌克，难哉。”《三国志·魏志·武帝纪》"}},{"id":18623,"word":"忌前之癖","pinyin":"jì qián zhī pǐ","abbr":"jqzp","explanation":"忌：妒忌；前：在自己之前的人；癖：癖好，毛病。有忌恨比自己有才能的人的毛病。","source":{"text":"契苾何力沉毅持重，有统御之才，然颇有忌前之癖。","book":"《旧唐书·贾曾传》"}},{"id":18624,"word":"忌讳之禁","pinyin":"jì huì zhī jìn","abbr":"jhzj","explanation":"指禁忌的言论或举动。","source":{"text":"当此时也，世非无深谋远虑知化之士也，然所以不敢尽忠拂过者，秦俗多忌讳之禁也，忠言未卒于口，而身糜没矣。","book":"《老子》第五十七章：“天下多忌讳而民弥贫。”汉·贾谊《新书·过秦论》"}},{"id":18625,"word":"忍俊不住","pinyin":"rěn jùn bù zhù","abbr":"rjbz","explanation":"忍不住笑。","source":{"text":"张君幽默健谈，追述去年和他的夫人往甘肃时途中遇盗情形，令人忍俊不住。","book":"邹韬奋《萍踪寄语》二"},"similar":["忍俊不禁"],"usage":"作谓语、状语；指忍不住要发笑"},{"id":18626,"word":"忍俊不禁","pinyin":"rěn jùn bù jìn","abbr":"rjbj","explanation":"忍俊：含笑；不禁：无法控制自己。指忍不住要发笑。","source":{"text":"柜初成，周戎时为吏部郎中，大书其上，戏作考词状：‘当有千有万，忍俊不禁，考上下。’","book":"唐·赵璘《因话录》卷五"},"example":{"text":"大熊猫憨态可掬，小猴子顽皮可爱，使得周围的大人们～，孩子们更是笑得前仰后合。"},"similar":["喜不自胜","哑然失笑","忍俊不住"],"opposite":["强颜欢笑"],"usage":"作谓语、状语；指忍不住要发笑"},{"id":18627,"word":"忍垢偷生","pinyin":"rěn gòu tōu shēng","abbr":"rgts","explanation":"忍受耻辱，苟且求生。","source":{"text":"妾恨不即死，止因未与将军一诀，故且忍垢偷生。","book":"明·罗贯中《三国演义》"},"example":{"text":"我不想这样～。"},"similar":["忍辱偷生","忍耻偷生"],"usage":"作谓语、宾语；指苟且偷生"},{"id":18628,"word":"忍尤含垢","pinyin":"rěn yóu hán gòu","abbr":"ryhg","explanation":"遭受怨谤耻辱而忍耐着。","source":{"text":"有善莫名，有恶莫辞，忍辱含垢，常若畏惧，是谓卑弱下人也。","book":"《后汉书·曹世叔妻传》"}},{"id":18629,"word":"忍尤攘诟","pinyin":"rěn yóu rǎng gòu","abbr":"ryrg","explanation":"尤：罪过；攘：排除；诟：耻辱。暂时忍受罪过，等待将来除去耻辱。","source":{"text":"屈心而抑志兮，忍尤而攘诟。","book":"战国·楚·屈原《离骚》"}},{"id":18630,"word":"忍心害理","pinyin":"rěn xīn hài lǐ","abbr":"rxhl","explanation":"忍：残忍。心地残忍，丧尽天良。","source":{"text":"维彼忍心，是顾是复。","book":"《诗·大雅·桑柔》"},"example":{"text":"此时若教抛撇祖父，一人独去，即使女儿心如铁石，亦不能～至此。","book":"清·李汝珍《镜花缘》第十回"},"similar":["伤天害理"],"usage":"作谓语、定语；指人心肠狠"},{"id":18631,"word":"忍无可忍","pinyin":"rěn wú kě rěn","abbr":"rwkr","explanation":"再也忍受不下去了。","source":{"text":"果然那些学生忍无可忍，闹出全班散学的事来了。","book":"清·无名氏《官场维新记》第十四回"},"example":{"text":"他在～的情况下，终于出手还击。"},"similar":["拍案而起","深恶痛绝"],"opposite":["忍辱负重","忍气吞声"],"usage":"作谓语、宾语、定语、状语；指再也忍受不下"},{"id":18632,"word":"忍气吞声","pinyin":"rěn qì tūn shēng","abbr":"rqts","explanation":"忍气：受了气不发作；吞声：不敢出声。指受了气勉强忍耐，有话不敢说出来。","source":{"text":"从今后忍气吞声，再不敢嚎咷痛哭。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"李瓶儿这边分明听见指骂的是他，把两只手气的冰冷，～，敢怒而不敢言。","book":"明·兰陵笑笑生《金瓶梅词话》第四十二回"},"similar":["委曲求全","忍辱负重","声吞气忍"],"opposite":["忍无可忍"],"usage":"作谓语、定语、状语；指不敢出声抗争"},{"id":18633,"word":"忍泪含悲","pinyin":"rěn lèi hán bēi","abbr":"rlhb","explanation":"忍着眼泪，含着悲痛。形容勉强克制着悲伤。","source":{"text":"柏爷坐上公案，左右排班已毕，只得忍泪含悲，吩咐升炮开刀。","book":"明·罗贯中《粉妆楼》第六十三回"},"example":{"text":"贾母自然又是哀痛的，只因要到宝玉那边，只得～的说道：“既这么着，我也不过去了。”","book":"清·曹雪芹《红楼梦》第九十八回"}},{"id":18634,"word":"忍痛割爱","pinyin":"rěn tòng gē ài","abbr":"rtga","explanation":"割爱：放弃心爱的东西。指不是出自本意忍痛地放弃心爱的东西。","source":{"text":"爱情嘛，不管早晚，不分先后，我忍痛割爱。","book":"王朔《我是你爸爸》"},"example":{"text":"我只好～了。"},"usage":"作谓语、定语、宾语；指违心地放弃"},{"id":18635,"word":"忍耻偷生","pinyin":"rěn chǐ tōu shēng","abbr":"rcts","explanation":"忍受耻辱，苟且求生。同“忍垢偷生”。","source":{"text":"忍耻偷生为父仇，谁知奸计觅风流。劝君莫设虚言誓，湛湛青天在上头。","book":"明·冯梦龙《醒世恒言》第三十六卷"},"example":{"text":"大抵女子殉夫，其故有二：……一则～，苟延一息，冀乐昌破镜，再得重圆，至望绝势穷，然后一死以明志，此生于情感者也。","book":"清·纪昀《阅微草堂笔记·槐西杂志》"},"similar":["忍垢偷生","忍辱偷生"],"usage":"作谓语、宾语；指苟且偷生"},{"id":18636,"word":"忍耻含垢","pinyin":"rěn chǐ hán gòu","abbr":"rchg","explanation":"含忍耻辱。同“忍辱含垢”。","source":{"text":"好兵始祸者既足以为后嗣之累，则凡忍耻含垢以全人命，其为子孙之福，审矣。","book":"宋·苏轼《上韩枢密书》"},"similar":["忍辱含垢","忍耻含羞"],"usage":"作谓语、定语、宾语；指忍受耻辱"},{"id":18637,"word":"忍耻含羞","pinyin":"rěn chǐ hán xiū","abbr":"rchx","explanation":"含忍耻辱。同“忍辱含垢”。","source":{"text":"撞府共冲州，遍走江湖之游，身为女婿，只能忍耻含羞。","book":"宋·无名氏《错立身》第十三出"},"example":{"text":"他～为的就是这一天。"},"similar":["忍耻含垢"],"usage":"作谓语、定语；用于为人"},{"id":18638,"word":"忍耻苟活","pinyin":"rěn chǐ gǒu huó","abbr":"rcgh","explanation":"忍受屈辱，苟且活命。","source":{"text":"莫说生前被人唾骂，就是死后亦有何颜见彼！与其忍耻苟活，何若从容就死。","book":"明·冯梦龙《醒世恒言》卷二十"}},{"id":18639,"word":"忍苦耐劳","pinyin":"rěn kǔ nai láo","abbr":"rknl","explanation":"经得起艰苦的工作和生活。","source":{"text":"这不能说他们没有冒险的精神，更不能说他们没有忍苦耐劳的精神。","book":"邹韬奋《萍踪寄语》二五"},"usage":"作谓语、定语；用于处事"},{"id":18640,"word":"忍辱偷生","pinyin":"rěn rǔ tōu shēng","abbr":"rrts","explanation":"偷：苟且。忍受屈辱，苟且活命。","source":{"text":"所以忍垢偷生，克躬自励，期效万一，补过酬恩，灰躯糜骨，以甘心愿。","book":"唐·陈子昂《为张著作谢父官表》"},"example":{"text":"止因未与将军一诀，故且～。","book":"明·罗贯中《三国演义》第八回"},"similar":["忍垢偷生","忍耻偷生"],"usage":"作谓语、宾语；指苟且偷生"},{"id":18641,"word":"忍辱含垢","pinyin":"rěn rǔ hán gòu","abbr":"rrhg","explanation":"忍、含：忍受。忍受耻辱。","source":{"text":"谦让恭敬，先人后己；有善莫名，有恶莫辞；忍辱含垢，常若畏惧，是谓卑弱下人也。","book":"汉·班昭《女诫》"},"example":{"text":"十年的～，十年的卧薪尝胆，算结晶成为了自卢沟桥事变以来的神圣的雪耻战争。","book":"郭沫若《羽书集·把精神武装起来》"},"similar":["忍辱负重","忍辱含羞"],"usage":"作谓语、定语、宾语；指忍受耻辱"},{"id":18642,"word":"忍辱含羞","pinyin":"rěn rǔ hán xiū","abbr":"rrhx","explanation":"忍、含：忍受。忍受耻辱。","source":{"text":"有善莫名，有恶莫辞，忍辱含垢，常若畏惧，是谓卑弱下人也。","book":"《后汉书·曹世叔妻传》"},"example":{"text":"他都～，不敢出头，蹲在水中哩。","book":"明·吴承恩《西游记》第七十二回"},"similar":["忍辱含垢"],"usage":"作谓语、定语、宾语；指忍受耻辱"},{"id":18643,"word":"忍辱求全","pinyin":"rěn rǔ qiú quán","abbr":"rrqq","explanation":"忍受屈辱以求保全整个大局。","example":{"text":"为了大家庭的和睦相处，她只好～。"},"similar":["委曲求全"],"usage":"作谓语、宾语、定语；指委曲求全"},{"id":18644,"word":"忍辱负重","pinyin":"rěn rǔ fù zhòng","abbr":"rrfz","explanation":"为了完成艰巨的任务，忍受暂时的屈辱。","source":{"text":"国家所以屈诸君使相承望者，以仆有尺寸可称，能忍辱负重故也。","book":"《三国志·吴书·陆逊传》"},"example":{"text":"胡仇叹道：“‘～’。郑兄，真不可及！”"},"similar":["忍气吞声","含垢忍辱"],"opposite":["忍无可忍"],"usage":"作谓语、宾语、定语；指人能够承担重任","story":["东汉末年，孙权夺取荆州杀害了关羽，刘备十分气愤，调集大批人马亲自东征东吴，连拔东吴数城。孙权只好启用陆逊为大都督全力抵抗，由于陆逊资历不深，很多将领不服他统率，他说君主看中他能忍辱负重担此大任，你们得听从指挥"]},{"id":18645,"word":"忍饥受冻","pinyin":"rěn jī shòu dòng","abbr":"rjsd","explanation":"忍受饥饿与寒冷，形容生活贫困窘迫","source":{"text":"家奴逃散一空，惟有一家人董喜，忍饥受冻，常在刑部照料。","book":"清·李百川《绿野仙踪》第26回"},"similar":["饥寒交迫"],"usage":"作谓语、定语、宾语；用于处境"},{"id":18646,"word":"忍饥受渴","pinyin":"rěn jī shòu kě","abbr":"rjsk","explanation":"忍受饥渴。形容极其艰难、贫困，苦苦度日。","source":{"text":"忍心饥受渴终难过，须投分义旧情亲。","book":"《敦煌变文集·捉季布变文》"},"example":{"text":"我～终于找到回家的路。"},"similar":["忍饥挨饿"],"usage":"作谓语、宾语、定语；指贫困"},{"id":18647,"word":"忍饥受饿","pinyin":"rěn jī shòu è","abbr":"rjse","explanation":"忍受饥饿。形容生活极其贫困，艰难度日。","source":{"text":"做娘的忍饥受饿，为子的富贵荣昌。可怜见看看至死，可来报答你这养育亲娘！","book":"元·关汉卿《五侯宴》第四折"},"example":{"text":"今日是荒年饥年，亏杀你独自支吾。终不然我自温饱，教你～。","book":"明·高明《琵琶记·义仓赈济》"},"similar":["忍饥挨饿"],"opposite":["酒足饭饱"],"usage":"作谓语、宾语、定语；多指贫困"},{"id":18648,"word":"忍饥挨饿","pinyin":"rěn jī āi è","abbr":"rjae","explanation":"忍受饥饿。形容极其贫困。","source":{"text":"她每天提着篮子去挖野菜，身体本来就有病，又天天忍饥挨饿，那病真让医生说中了，越来越重。","book":"余华《活着》"},"example":{"text":"钱花完了，只好～。"},"similar":["忍饥受饿"],"opposite":["酒足饭饱"],"usage":"作谓语、宾语、定语；指贫困"},{"id":18649,"word":"忐上忑下","pinyin":"tǎn shàng tè xià","abbr":"tstx","explanation":"指心神不定，恐惧不安。","source":{"text":"吃了万千控持，谙了无限磨难，受了多少忐上忑下。","book":"《宋元戏文辑佚·张资鸳鸯灯》"},"similar":["忐忑不安","忐忑不定"],"usage":"作谓语、定语、状语；指心神不安定"},{"id":18650,"word":"忐忐忑忑","pinyin":"tǎn tǎn tè tè","abbr":"tttt","explanation":"心神不安，胆怯。同“忑忑忐忐”。","source":{"text":"急的俺忐忐忑忑把花言语谩支吾，当初当也波初，俺也拚的厮挺触。","book":"元·无名氏《抱妆盒》第四折"}},{"id":18651,"word":"忐忑不宁","pinyin":"tǎn tè bù níng","abbr":"ttbn","explanation":"忐忑：心神不定。心神极为不安。","source":{"text":"两道听了这话，心里忐忑不定。","book":"清·吴趼人《糊涂世界》卷九"},"example":{"text":"景色确是美丽非凡，但人们却无心观赏，而且有些～，因为已经进入彝族区了。","book":"魏巍《地球的红飘带》四十三"}},{"id":18652,"word":"忐忑不安","pinyin":"tǎn tè bù ān","abbr":"ttba","explanation":"忐忑：心神不定。心神极为不安。","source":{"text":"两道听了这话，心里忐忑不定。","book":"清·吴趼人《糊涂世界》卷九"},"example":{"text":"母亲谨慎地窥视着一切动静，心里～，她怕有人出卖星海。","book":"冯德英《苦菜花》第十章"},"similar":["惶惶不安","坐立不安","忐忑不定"],"opposite":["心安理得","悠然自得"],"usage":"作谓语、定语、状语；指心神不安定"},{"id":18653,"word":"忐忑不定","pinyin":"tǎn tè bù dìng","abbr":"ttbd","explanation":"心神极为不安。同“忐忑不安”。","source":{"text":"济川被他们说得心中忐忑不定。","book":"清·李宝嘉《文明小史》第二十六回"},"example":{"text":"两道听了这话，心里～。","book":"清·吴趼人《糊涂世界》卷九"},"similar":["忐忑不安","忐上忑下"],"opposite":["心安理得"],"usage":"作谓语、定语、状语；指心神不安定"},{"id":18654,"word":"忑忑忐忐","pinyin":"tè tè tǎn tǎn","abbr":"tttt","explanation":"心神不安，胆怯。","source":{"text":"我从来驳驳劣劣，世不曾忑忑忐忐，打熬成不厌天生敢。","book":"元·王实甫《西厢记》第二本第二折"}},{"id":18655,"word":"志冲斗牛","pinyin":"zhì chōng dǒu niú","abbr":"zcdn","explanation":"志：气势；牛、斗：即牵牛星和北斗星，指天空。形容怒气冲天或气势很盛。","source":{"text":"雄气堂堂贯斗牛，誓将真节报君仇。","book":"唐·崔融《咏宝剑》：“匣气冲牛斗，山形转辘轳。”宋·岳飞《题青泥赤壁》诗"},"example":{"text":"三位将军，乃人中豪杰，～，气吐凌云，如此雄威。（元·无名氏《打董达》第五折）"},"similar":["气冲牛斗"],"usage":"作谓语、定语；形容怒气很盛"},{"id":18656,"word":"志冲牛斗","pinyin":"zhì chōng niú dǒu","abbr":"zcnd","explanation":"牛斗：牵牛星与北斗星。形容人的气势很盛。","source":{"text":"三位将军，乃人中豪杰，志冲牛斗，气吐凌云。","book":"明·无名氏《赵匡胤打董达》第五折"},"similar":["气冲牛斗"],"usage":"作谓语、定语；用于人的气势"},{"id":18657,"word":"志同心合","pinyin":"zhì tóng xīn hé","abbr":"ztxh","explanation":"志趣相同，意见一致","source":{"text":"官居台省，曾叨宠幸，只为爱山水窠巢，早离脱仕途坑阱。喜你志同心合，志同心合，果然堪敬！和你结师生，共老林泉下，同期大道成。","book":"明·陆采《明珠记·访侠》"},"similar":["志同道合","志同气合"],"usage":"作谓语、定语；指志趣相投的人"},{"id":18658,"word":"志同心和","pinyin":"zhì tóng xīn hé","abbr":"ztxh","explanation":"志趣相同，心意一致。","source":{"text":"昔伊尹之为媵臣，至贱也，吕尚之处屠钓，至陋也，乃其见举于汤武、周文，诚道合志同，玄漠神通，岂复假近习之荐，因左右之介哉。","book":"《三国志·魏志·陈思王植传》"}},{"id":18659,"word":"志同气合","pinyin":"zhì tóng qì hé","abbr":"ztqh","explanation":"志趣相同，意见一致","source":{"text":"逢原每不乐补之所为，而墨花实不逮，唯长于平远，遇志同气合者始为作之。","book":"宋·曾敏行《独醒杂志》第四卷"},"similar":["志同道合","志同心合"],"usage":"作谓语、定语；指志趣相投的人"},{"id":18660,"word":"志同气和","pinyin":"zhì tóng qì hé","abbr":"ztqh","explanation":"志趣相同，意见一致。","source":{"text":"昔伊尹之为媵臣，至贱也，吕尚之处屠钓，至陋也，乃其见举于汤武、周文，诚道合志同，玄漠神通，岂复假近习之荐，因左右之介哉。","book":"《三国志·魏志·陈思王植传》"}},{"id":18661,"word":"志同道合","pinyin":"zhì tóng dào hé","abbr":"ztdh","explanation":"道：途径。志趣相同，意见一致。","source":{"text":"昔伊尹之为媵臣，至贱也，吕尚之处屠钓，至陋也，乃其见举于汤武、周文，诚道合志同，玄漠神通，岂复假近习之荐，因左右之介哉。","book":"《三国志·魏志·陈思王植传》"},"example":{"text":"两人起先虽觉得～，后来子美的热狂冷了。","book":"闻一多《杜甫》"},"similar":["情投意合","心心相印","莫逆之交"],"opposite":["分道扬镳","貌合神离","同床异梦"],"usage":"作谓语、定语；指志趣相投的人","story":["三国时期，魏文帝曹丕即位后，对曹植一直心存疑忌，寻找各种机会加以陷害，由于母后的干预，曹丕才没有把弟弟置于死地。曹植苦于无用武之地，他上书说伊尹是陪嫁的小臣、吕尚当屠夫钓叟，他们遇到了志同道合的商汤和周文王，辅佐他们成大业"]},{"id":18662,"word":"志在千里","pinyin":"zhì zài qiān lǐ","abbr":"zzql","explanation":"形容志向远大。","source":{"text":"老骥伏枥，志在千里。烈士暮年，壮心不已。","book":"三国魏·曹操《步出夏门行·神龟虽寿》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“‘老骥伏枥，～’，四哥，你果有此心，眼前倒有个机会，可以做一番事业。”"},"usage":"作谓语、定语；用于为人"},{"id":18663,"word":"志在四方","pinyin":"zhì zài sì fāng","abbr":"zzsf","explanation":"四方：天下。立志于天下。指有远大的抱负和理想。","source":{"text":"立忠信男儿志四方，居王佐丹扆定八方，抚万姓，定边疆。","book":"元·关汉卿《裴度还带》第三折"},"example":{"text":"妾闻“男子～”。君壮年不出图仕，乃区区守妻子坐困乎？（明·冯梦龙《东周列国志》第二十五回）"},"similar":["雄心壮志"],"opposite":["胸无大志","鼠目寸光"],"usage":"作谓语、定语、状语；指有理想","story":["春秋时期，晋国公子重耳逃到齐国，齐桓公把齐姜嫁给重耳。重耳在齐国生活7年，日子过得很逍遥，他的属下十分着急，商量要他回国争王位。齐姜也认为男子汉要志在四方成就大业，就与重耳的部下用计送出齐国"]},{"id":18664,"word":"志在四海","pinyin":"zhì zài sì hǎi","abbr":"zzsh","explanation":"犹志在四方。","source":{"text":"志在四海而尚恭俭，心包宇宙而无骄盈。","book":"北周·庾信《燕射歌辞·角调曲一》"},"similar":["志在四方"],"usage":"作谓语、定语、状语；指有理想"},{"id":18665,"word":"志在必得","pinyin":"zhì zài bì dé","abbr":"zzbd","explanation":"立志一定要获得。形容想要得到的决心很大。","example":{"text":"当下发兵数万，令大将李广利统率，到大宛国贰师城取马，为了～，把李广利封为贰师将军。（金庸《射雕英雄传》第七回）"}},{"id":18666,"word":"志坚行苦","pinyin":"zhì jiān xíng kǔ","abbr":"zjxk","explanation":"行：行为。指意志坚定，行为刻苦。","source":{"text":"娥志坚行苦，霜舂雨薪，不倦筋力，十三年四月，始受具戒于泗州开元寺，竟以小娥为法号，不忘本也。","book":"唐·李公佐《谢小娥传》"},"usage":"作谓语、定语；指人的意志"},{"id":18667,"word":"志士仁人","pinyin":"zhì shì rén rén","abbr":"zsrr","explanation":"原指仁爱而有节操，能为正义牺牲生命的人。现在泛指爱国而为革命事业出力的人。","source":{"text":"志士仁人，无求生以害仁，有杀身以成仁。","book":"《论语·卫灵公》"},"example":{"text":"～，兴亡之数，鸿纤亿刹，常如视诸掌。","book":"清·黄宗羲《吴山益然大师塔铭》"},"similar":["耿介之士"],"opposite":["无耻之徒"],"usage":"作主语、宾语、定语；指贤人","story":["春秋时期，孔子的弟子问仁德忠义与生命发生冲突怎么办？孔子说：“真正的志士仁人都不会因为贪生怕死而损害仁义，为了成全仁德，可以不顾自己的生命。”子贡问怎样培养仁德，孔子回答必须从上面作起，带动百姓效仿"]},{"id":18668,"word":"志大才疏","pinyin":"zhì dà cái shū","abbr":"zdcs","explanation":"疏：粗疏，薄弱。指人志向大而才具不够。","source":{"text":"融负其高气，志在靖难，而才疏意广，迄无成功。","book":"《后汉书·孔融传》"},"example":{"text":"此人言过其实，～。"},"similar":["眼高手低","一无所能"],"opposite":["精明强干","游刃有余","一柱擎天"],"usage":"作谓语、定语；指空想家","story":["东汉时期，孔融竭力维护汉献帝的利益，对曹操的政策进行讽刺与反对。为节约粮食，曹操下禁酒令，孔融则写文章大吹喝酒的好处，当着东吴使者的面说曹操的不是，结果被曹操杀头。后人评说他是志大才疏的人，办不成大事"]},{"id":18669,"word":"志大才短","pinyin":"zhì dà cái duǎn","abbr":"zdcd","explanation":"指人志向大而才具不够。","source":{"text":"伯仁为人志大而才短，名重而识暗。","book":"南朝·宋·刘义庆《世说新语·识鉴》"},"example":{"text":"伯仁～，名高识闇，好乘人敝，未足自全。（蔡东藩《两晋演义》第三十六回）"},"similar":["志大才疏","志广才疏","才疏志大"],"usage":"作谓语、定语；指空想家"},{"id":18670,"word":"志大量小","pinyin":"zhì dà liàng xiǎo","abbr":"zdlx","explanation":"志：志向；量：度量。志向虽大，但心胸狭窄。","source":{"text":"贾生志大而量小，才有余而识不足也。","book":"宋·苏轼《贾谊论》"},"usage":"作谓语、定语；用于为人"},{"id":18671,"word":"志存高远","pinyin":"zhì cún gāo yuǎn","abbr":"zcgy","explanation":"指立志很高远，有雄心壮志。","example":{"text":"他～，将来能成大器。"},"opposite":["好高骛远"],"usage":"作谓语、宾语；指人的志向","story":["明朝时期，李时珍背弃父亲要他读八股文科举入仕的愿望，一心阅读医书《神农本草》，发现其中很多中药没有详细记载，决心认真编写一部详尽的医书。他对书中的每一种中药都十分认真地考证，经过30多年终于完成《本草纲目》巨著"]},{"id":18672,"word":"志广才疏","pinyin":"zhì guǎng cái shū","abbr":"zgcs","explanation":"犹志大才疏。","source":{"text":"今浚之罪乃在于志广才疏，力小任重，不能谘诹良策，而专于自用。","book":"宋·李纲《奏陈利害札子》"},"example":{"text":"明·冯梦龙《喻世明言》第21卷：“刘汉宏为人～，这一席话，正投其机。”"},"similar":["志大才疏","志大才短","才疏志大"],"usage":"作谓语、定语；指空想家"},{"id":18673,"word":"志得意满","pinyin":"zhì dé yì mǎn","abbr":"zdym","explanation":"志向实现，心满意足。","source":{"text":"未免志得意满，自繇自主，要另立个铺排，把张家来出景，渐渐把丈人丈母放在脑后，倒象人家不是刘家的一般。","book":"明·凌濛初《初刻拍案惊奇》卷三十八"},"example":{"text":"不料那吴佩孚正在～之时，越发做作得厉害，只回了四个大字：“交叶开鑫。”","book":"陈立德《前驱》七"},"similar":["称心如意","如愿以偿","心满意足"],"opposite":["若有所失","悲观失望","嗒然若失"],"usage":"作谓语、定语；指满足"},{"id":18674,"word":"志得气盈","pinyin":"zhì dé qì yíng","abbr":"zdqy","explanation":"犹志得意满。","source":{"text":"王志得气盈，不以巡抚置意中。每诣院谒巡抚，仰面视天，言如泉涌。","book":"清·李伯元《南亭笔记》卷四"},"usage":"作谓语、定语；用于处事"},{"id":18675,"word":"志志诚诚","pinyin":"zhì zhì chéng chéng","abbr":"zzcc","explanation":"真心实意。","source":{"text":"于是两个志志诚诚，吃了十来日斋，同到寺里，献此宝镜。","book":"明·凌濛初《二刻拍案惊奇》第36卷"},"example":{"text":"我是～地待你，请不要误解。"},"similar":["真心实意"],"usage":"作定语、状语；指真诚"},{"id":18676,"word":"志枭逆虏","pinyin":"zhì xiāo nì lǔ","abbr":"zxnl","explanation":"枭：枭首，引申为消灭；逆：叛逆；虏：外族。立下志向，消灭敌人。","source":{"text":"吾枕戈待旦，志枭逆虏，常恐祖生先吾著鞭。","book":"晋·刘琨《与亲故书》"},"usage":"作谓语、定语；用于书面语"},{"id":18677,"word":"志气凌云","pinyin":"zhì qì líng yún","abbr":"zqly","explanation":"云：直上云霄。志气直上云霄。形容志向宏大，意气豪迈。","source":{"text":"我如今状貌堂堂，威风赳赳，志气凌云。","book":"元·无名氏《飞刀对箭》第四折"},"example":{"text":"明·无名氏《陈仓路》第一折：“～贯斗牛，老当益壮鬓霜秋。”"},"usage":"作谓语、定语；用于为人"},{"id":18678,"word":"志洁行芳","pinyin":"zhì jié xíng fāng","abbr":"zjxf","explanation":"志向高洁，品行端正。","source":{"text":"年十六，受业长安，志美行厉，诸儒号曰圣童。","book":"《后汉书·张堪传》"},"example":{"text":"虽感时抚事，亦～。","book":"刘师培《文说》"},"similar":["志高行洁","志美行厉"],"usage":"作谓语、定语；用于为人"},{"id":18679,"word":"志满意得","pinyin":"zhì mǎn yì dé","abbr":"zmyd","explanation":"志向实现，心满意足。","source":{"text":"当无道时，小人在位，君子在野，小人志得意满，君子阨穷祸患，甚者在囹圄，伏刀锯、投荒裔。","book":"宋·陆九渊《与刘伯协书》"},"example":{"text":"夫迈里古思受任之初，殊有古贤县令之风，一握兵权，～，酣贪废事。","book":"明·陶宗仪《辍耕录·越民考》"}},{"id":18680,"word":"志满气得","pinyin":"zhì mǎn qì dé","abbr":"zmqd","explanation":"犹志得意满。","source":{"text":"贤者恒无以自存，不贤者志满气得。","book":"唐·韩愈《与崔群书》"},"example":{"text":"是以比年以来，此辈类皆高官厚禄，～，而生民日益困苦，无复聊赖。","book":"宋·朱熹《庚子应诏封事》"},"usage":"作谓语、定语；用于书面语"},{"id":18681,"word":"志满气骄","pinyin":"zhì mǎn qì jiāo","abbr":"zmqj","explanation":"形容得意骄傲。同“志骄意满”。","source":{"text":"也先不道，志满气骄，将有长驱深入之势，不可不预之防。","book":"《西湖佳话·三台梦迹》"},"similar":["志骄气盈","志骄意满"],"usage":"作谓语、定语、状语；用于处事"},{"id":18682,"word":"志盈心满","pinyin":"zhì yíng xīn mǎn","abbr":"zyxm","explanation":"犹志得意满。","source":{"text":"寿阳以西皆是中国，新平强吴，美宝皆入，志盈心满，用长欢娱。","book":"《晋书·袁甫传》"},"similar":["志得气盈"],"usage":"作谓语、定语；用于处事"},{"id":18683,"word":"志美行厉","pinyin":"zhì měi xíng lì","abbr":"zmxl","explanation":"志向高远，又能砥砺操行。","source":{"text":"年十六，受业长安，志美行厉，诸儒号曰圣童。","book":"《后汉书·张堪传》"},"similar":["志洁行芳"],"usage":"作谓语、定语；指志向高远，又能砥砺操行"},{"id":18684,"word":"志虑忠纯","pinyin":"zhì lǜ zhōng chún","abbr":"zlzc","explanation":"志虑：志向和心思。志向和心思都忠诚纯洁。形容忠心耿耿，坚贞不二。","source":{"text":"侍中、侍郎郭攸之、费祎、董允等，此皆良实，志虑忠纯，是以先帝简拔以遗陛下。","book":"三国·蜀·诸葛亮《前出师表》"},"example":{"text":"景衡得程颐之学，～，议论不与时俯仰。（《宋史·许景衡传》）"},"usage":"作谓语、定语；用于书面语"},{"id":18685,"word":"志诚君子","pinyin":"zhì chéng jūn zǐ","abbr":"zcjz","explanation":"志行诚笃高尚的人。","source":{"text":"他是个志诚君子，与别人不同，怎么开口起发他的？","book":"明·徐霖《绣襦记·姨鸨夸机》"},"usage":"作宾语、定语；用于书面语"},{"id":18686,"word":"志趣不凡","pinyin":"zhì qù bù fán","abbr":"zqbf","explanation":"志趣：志向和兴趣；凡：平凡。志向和兴趣很不平凡。","source":{"text":"明昌间，章宗游春水过焉，闻弦诵声，幸其斋舍，见壁间所题诗，讽咏久之，赏其志趣不凡。","book":"《金史·赵质传》"},"example":{"text":"使我得宰天下，也当如分肉一般，秉公办事呢！～，平佐汉王定天下，后为丞相，故补叙独详。（蔡东藩《前汉演义》第二十三回）"},"usage":"作谓语、定语；用于为人"},{"id":18687,"word":"志趣不常","pinyin":"zhì qù bù cháng","abbr":"zqbc","explanation":"志趣：志向和兴趣；常：平常。志向和兴趣很不平凡。","source":{"text":"梁国张伟志趣不常，自隐于屠钓，修爱其才美，而知其不真。","book":"《晋书·阮修传》"},"example":{"text":"桓玄～，每怀怨望，节下崇待太过，恐非久计。（蔡东藩《两晋演义》第七十七回）"}},{"id":18688,"word":"志足意满","pinyin":"zhì zú yì mǎn","abbr":"zzym","explanation":"犹志得意满。","source":{"text":"恒公虽然是个英主，却不道剑老无芒，人老无刚，他做了多年的侯伯，志足意满。","book":"明·冯梦龙《东周列国志》第三二回"},"similar":["志得意满"],"usage":"作谓语、定语、状语；指满足"},{"id":18689,"word":"志骄意满","pinyin":"zhì jiāo yì mǎn","abbr":"zjym","explanation":"形容得意骄傲。","source":{"text":"贲志骄意满，不复顾虑。","book":"《古今小说·梁武帝累修归极乐》"},"similar":["志骄气盈","志满气骄"],"usage":"作谓语、定语、状语；用于处事"},{"id":18690,"word":"志骄气盈","pinyin":"zhì jiāo qì yíng","abbr":"zjqy","explanation":"犹志骄意满。","source":{"text":"后来诸公应诏之作，多用此体，然多志骄气盈，处富贵而不失其正者，几希矣。","book":"元·杨载《诗法家数·荣遇》"},"similar":["志骄意满","志满气骄"],"usage":"作谓语、定语、状语；用于处事"},{"id":18691,"word":"志高气扬","pinyin":"zhì gāo qì yáng","abbr":"zgqy","explanation":"志气高昂而自得。","source":{"text":"家殷人足，志高气扬。","book":"《史记·苏秦列传》"},"example":{"text":"况且那小器量的人，一旦得了横财，那样～的态度，自己不觉，旁的人看得甚是分明。","book":"清·西周生《醒世姻缘传》第六十五回"},"similar":["足高气扬","趾高气扬"],"usage":"作谓语、定语、状语；用于处事"},{"id":18692,"word":"志高行洁","pinyin":"zhì gāo xíng jié","abbr":"zgxj","explanation":"志向高远，品行端正严肃。","source":{"text":"徐公志高行洁，才博气猛。其施之也，高而不狷，洁而不介，博而守约，猛而能宽。圣人以清为难，而徐公之所易也。","book":"《三国志·魏志·徐邈传》"},"similar":["志美行厉","志洁行芳"],"usage":"作谓语、定语；用于为人"},{"id":18693,"word":"忘乎其形","pinyin":"wàng hū qí xíng","abbr":"whqx","explanation":"犹忘形。形容得意或兴奋得失去常态。","source":{"text":"秦始皇已忘乎其形，愈摇动其身体，愈向高渐离身旁走去。","book":"郭沫若《高渐离》第五幕"},"similar":["忘乎所以","得意忘形"],"usage":"作谓语、定语、状语；用于处事"},{"id":18694,"word":"忘乎所以","pinyin":"wàng hū suǒ yǐ","abbr":"whsy","explanation":"指因过分兴奋或得意而忘了应有的举止。","source":{"text":"夫人倾身配奉，忘其所以。","book":"明·冯梦龙《醒世恒言·勘皮靴单证二郎神》"},"example":{"text":"他刚取得一点成绩就～，目中无人了。"},"similar":["得意忘形","得意洋洋"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语、补语；指得意过度"},{"id":18695,"word":"忘其所以","pinyin":"wàng qí suǒ yǐ","abbr":"wqsy","explanation":"指因过分兴奋或得意而忘了应有的举止。","source":{"text":"朝罢夕倦，夺气褫魄之为者，忘其所以为谈，失自所以为夸。","book":"汉·张衡《东京赋》"},"example":{"text":"夫人倾身配奉，～。","book":"明·冯梦龙《醒世恒言·勘皮靴单证二郎神》"},"similar":["忘乎所以","得意忘形"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语、状语；指得意忘形"},{"id":18696,"word":"忘啜废枕","pinyin":"wàng chuò fèi zhěn","abbr":"wcfz","explanation":"指不食不眠。","source":{"text":"生邑邑若有所失，忘啜废枕，日渐委悴。","book":"清·蒲松龄《聊斋志异·黄九郎》"},"usage":"作谓语、定语；用于书面语"},{"id":18697,"word":"忘寝废食","pinyin":"wàng qǐn fèi shí","abbr":"wqfs","explanation":"寝：睡觉。废：废止，停止。形容专心致志地干谋一件事情，连睡觉、吃饭都顾不上了。","source":{"text":"臣窃见国家每边境有急，羽书相衔，或一方饥馑，饿莩盈野，则庙堂之上焦心劳思，忘寝废食以忧之。","book":"宋·司马光《进五规状·远谋》"},"similar":["废寝忘食","忘餐废寝"],"usage":"作谓语、定语、状语；形容人刻苦努力"},{"id":18698,"word":"忘年之交","pinyin":"wàng nián zhī jiāo","abbr":"wnzj","explanation":"年辈不相当而结交为友。","source":{"text":"弱冠州举秀才，南乡范云见其对策，大相称赏，因结忘年交。","book":"《后汉书·祢衡传》：“衡始弱冠，而融年四十，遂与为交友。”《南史·何逊传》"},"example":{"text":"陈泰叹服曰：“公料敌如神，蜀兵何足虑哉！”于是陈泰与邓艾结为～。","book":"明·罗贯中《三国演义》第一百十一回"},"similar":["忘年交","忘年之好","忘年之契"],"opposite":["不共戴天"],"usage":"作宾语；指年辈不相当而结交的朋友"},{"id":18699,"word":"忘年之友","pinyin":"wàng nián zhī yǒu","abbr":"wnzy","explanation":"年辈不相当而结交为好朋友。即不拘年岁行辈的差异而结交的朋友。","source":{"text":"言面以来，便申忘年之好。比虽艰隔成阻，而情问无睽。","book":"南朝·宋·颜延之《吊张茂度书》"},"example":{"text":"言及刺武三思事，琚义而许之，与周璟、张仲之为～。","book":"《旧唐书·王倨传》"}},{"id":18700,"word":"忘年之契","pinyin":"wàng nián zhī qì","abbr":"wnzq","explanation":"即不拘年岁行辈产差异而结交的朋友。同“忘年之好”。","source":{"text":"十五时，相国齐公崔日用试《土火炉赋》，公雅思遒丽，援翰立成，齐公骇之，约忘年之契。","book":"唐·颜真卿《孙逖文集序》"},"example":{"text":"予在京师，辱～，论诗文一字不轻放过。","book":"清·王士禛《池北偶谈·谈艺三·李侍郎》"},"similar":["忘年之好","忘年之交","忘年交"],"usage":"作宾语、定语；用于交往等"},{"id":18701,"word":"忘年之好","pinyin":"wàng nián zhī hǎo","abbr":"wnzh","explanation":"忘记年龄的交友。即不拘年岁行辈产差异而结交的朋友。","source":{"text":"言面以来，便申忘年之好。比虽艰隔成阻，而情问无睽。","book":"南朝·宋·颜延之《吊张茂度书》"},"similar":["忘年交","忘年之契","忘年之交"],"usage":"作宾语、定语；用于交往等"},{"id":18702,"word":"忘年交","pinyin":"wàng nián jiāo","abbr":"wnj","explanation":"即不拘年岁行辈产差异而结交的朋友。同“忘年之好”。","source":{"text":"逊字仲言，八岁能赋诗，弱冠，州举秀才。南乡范云见其对策，大相称赏，因结忘年交。","book":"《南史·何逊传》"},"example":{"text":"这一天早上，他正在看天空的浮云，正正经经并没想到要撒谎的时候，忽然迎面来了一位～。","book":"茅盾《老乡绅》"},"similar":["忘年之契","忘年之交","忘年之好"],"usage":"作宾语、定语；用于交往等"},{"id":18703,"word":"忘年交好","pinyin":"wàng nián jiāo hǎo","abbr":"wnjh","explanation":"忘年：忘记年龄；交好：互相往来。年龄辈份不相当的人所结成的深厚友谊。","source":{"text":"时颍川庾仲容、吴郡张率，前辈知名，与粲同府，并忘年交好。","book":"《梁书·韦粲传》"}},{"id":18704,"word":"忘形之交","pinyin":"wàng xíng zhī jiāo","abbr":"wxzj","explanation":"不拘身分、形迹的知心朋友。同“忘形交”。","source":{"text":"然蒲圻爱彼殷勤，竟遂弃寐告，为。忘形之交","book":"明·杨循吉《吴中语·魏守改郡治》"},"similar":["忘形交","忘形之契"],"usage":"作宾语；用于交往"},{"id":18705,"word":"忘形之契","pinyin":"wàng xíng zhī qì","abbr":"wxzq","explanation":"不拘身分、形迹的知心朋友。同“忘形交”。","source":{"text":"丹与东林灵澈上人为忘形之契，丹尝为《思归》绝句以寄澈。","book":"旧题宋·尤袤《全唐诗话·韦丹》"},"similar":["忘形交","忘形之交"],"usage":"作宾语；用于交往"},{"id":18706,"word":"忘形交","pinyin":"wàng xíng jiāo","abbr":"wxj","explanation":"不拘身分、形迹的知心朋友。","source":{"text":"孟郊者，字东野，湖州武康人。少隐嵩山，性介，少谐合。愈一见，为忘形交。","book":"《新唐书·孟郊传》"},"similar":["忘形之交","忘形之契"],"usage":"作宾语；用于交往"},{"id":18707,"word":"忘忧物","pinyin":"wàng yōu wù","abbr":"wyw","explanation":"可借以忘掉忧愁的东西。多用以指酒、云。","source":{"text":"泛此忘忧物，远我遗世情。","book":"晋·陶潜《饮酒诗》"},"example":{"text":"云是～，生在北堂陲。","book":"南朝·梁·萧衍《古意诗二首》其二"}},{"id":18708,"word":"忘怀得失","pinyin":"wàng huái dé shī","abbr":"whds","explanation":"忘怀：不放在心上。不把利害得失放在心上。","source":{"text":"常著文章自娱，颇示己志。忘怀得失，以此自终。","book":"晋·陶潜《五柳先生传》"},"example":{"text":"做了一个人，想一点儿不痴，真真难，少痴一点不也就尽够了。～之谓也。","book":"俞平伯《人生不过如此·无题二》"}},{"id":18709,"word":"忘怀日久","pinyin":"wàng huái rì jiǔ","abbr":"whrj","explanation":"时间长久就不太介意而忘掉了。"},{"id":18710,"word":"忘恩失义","pinyin":"wàng ēn shī yì","abbr":"wesy","explanation":"忘掉他人对己的恩德，做出背信弃义的事情。","source":{"text":"李固道：‘我不是忘恩失义的人，慢慢地报答你两个。’","book":"明·施耐庵《水浒传》第六十二回"},"similar":["忘恩负义","忘恩背义"],"opposite":["以德报怨"],"usage":"作谓语、定语；用于谴责"},{"id":18711,"word":"忘恩背义","pinyin":"wàng ēn bèi yì","abbr":"weby","explanation":"忘掉他人对己的恩德，做出背信弃义的事情。","source":{"text":"小人～，至以怨报德。 ★宋·崔鶠《杨嗣复论》"},"example":{"text":"明·施耐庵《水浒传》第11回：“哥哥若不收留，柴大官人知道时见怪，显的我们～。”"},"similar":["忘恩负义"],"opposite":["以德报怨"],"usage":"作谓语、定语、宾语；用于谴责"},{"id":18712,"word":"忘恩负义","pinyin":"wàng ēn fù yì","abbr":"wefy","explanation":"恩：恩惠；负：违背；义：情谊，恩谊。忘记别人对自己的好处，反而做出对不起别人的事。","source":{"text":"背恩忘义，枭獍其心。","book":"《魏书·萧宝夤传》"},"example":{"text":"此人好夸大，且～，你要仔细识他才好。","book":"清·黄小配《大马扁》第十六回"},"similar":["背信弃义","恩将仇报","过河拆桥"],"opposite":["感恩戴德","以德报怨","饮水思源"],"usage":"作谓语、定语；用于谴责"},{"id":18713,"word":"忘情荣辱","pinyin":"wàng qíng róng rǔ","abbr":"wqrr","explanation":"忘情：忘掉感情，即不动感情；荣辱：光荣和耻辱。对荣辱得失无动于衷。","source":{"text":"全命甘留滞，忘情任荣辱。","book":"唐·杜甫《写怀》诗"}},{"id":18714,"word":"忘情负义","pinyin":"wàng qíng fù yì","abbr":"wqfy","explanation":"忘记别人对自己的情义，做出对不起他的事。","source":{"text":"后来宝玉明白了，旧病复发，常时哭想，并非忘情负义之徒。","book":"清·曹雪芹《红楼梦》第113回"},"similar":["忘恩负义"],"usage":"作谓语、定语；用于处事"},{"id":18715,"word":"忘战必危","pinyin":"wàng zhàn bì wēi","abbr":"wzbw","explanation":"战：战备。危：危险，危机。国虽大，好战必亡，天下虽平，忘记了战备就一定会产生危机。","source":{"text":"战：战备。危：危险，危机。国虽大，好战必亡，天下虽平，忘记了战备就一定会产生危机。"},"example":{"text":"战：战备。危：危险，危机。国虽大，好战必亡，天下虽平，忘记了战备就一定会产生危机。"},"similar":["忘战者危"],"usage":"作宾语、定语；用于处事等"},{"id":18716,"word":"忘战者危","pinyin":"wàng zhàn zhě wēi","abbr":"wzzw","explanation":"指忘记了战备就一定会产生危机。同“忘战必危”。","source":{"text":"故曰好战者亡，忘战者危，不好不忘，天下之王也。","book":"三国·魏·桓范《兵要》"},"similar":["忘战必危"],"usage":"作宾语、定语；用于处事等"},{"id":18717,"word":"忘本负义","pinyin":"wàng běn fù yì","abbr":"wbfy","explanation":"本：原来；负：辜负，违背；义：情义。忘记原来的情况，违背了情义。指忘掉了别人对自己的好处，去做对不起人家的事。","source":{"text":"背恩忘义，伤化薄俗。","book":"《汉书·张敞传》"},"example":{"text":"你这般贪图富贵，～，跟完颜康这小子又有甚么分别？","book":"金庸《射雕英雄传》第十一回"}},{"id":18718,"word":"忘生舍死","pinyin":"wàng shēng shě sǐ","abbr":"wsss","explanation":"忘却性命，不怕牺牲。","source":{"text":"厮琅琅弓上箭，扑剌剌马攒蹄。忘生舍死安邦将，大胆雄心敢战儿。","book":"元·无名氏《谢金吾》第二折"},"example":{"text":"或报父仇兼敌忾，他必会，～定边尘。","book":"《再生缘》第二十一回"},"similar":["舍生忘死","舍死忘生"],"usage":"作谓语、定语；指不把个人的生死放在心上"},{"id":18719,"word":"忘言之契","pinyin":"wàng yán zhī qì","abbr":"wyzq","explanation":"忘言：无需语言说明；契：意气相投。指彼此以心相知，不拘形迹。","source":{"text":"与嵇康、吕安善，后遇阮籍，便为竹林之交，著忘言之契。","book":"《晋书·山涛传》"}},{"id":18720,"word":"忘象得意","pinyin":"wàng xiàng dé yì","abbr":"wxdy","explanation":"忘记物象，得到真谛。","source":{"text":"微文接粗，渐说或允，忘象得意，顿义为长。聊举大较，谈者择焉。","book":"南朝·齐·刘虯《答竟陵王子良书》"},"usage":"作谓语、定语；用于书面语"},{"id":18721,"word":"忘身忘家","pinyin":"wàng shēn wàng jiā","abbr":"wswj","explanation":"身：自身。忘掉了自己，忘掉了家。形容为了国家而不顾自身和家庭。","source":{"text":"故化成俗定，则为人臣者主耳忘身，国耳忘家，公耳忘私，利不苟就，害不苟去，唯义所在。","book":"《汉书·贾谊传》"}},{"id":18722,"word":"忘餐失寝","pinyin":"wàng cān shī qǐn","abbr":"wcsq","explanation":"忘记了吃饭，顾不得睡觉。形容专心努力。","source":{"text":"杞国有人忧天地崩坠，身亡所寄，废寢食者。","book":"《列子·开瑞篇》"},"example":{"text":"小生只为小姐，～，梦断魂劳，常忽忽如有失。","book":"明·崔时佩、李景云 《西厢记》第十八出"},"similar":["忘餐废寝","废寝忘食","忘寝废食"],"usage":"作谓语、定语、状语；形容人刻苦努力"},{"id":18723,"word":"忘餐废寝","pinyin":"wàng cān fèi qǐn","abbr":"wcfq","explanation":"忘记了睡觉，顾不得吃饭。形容对某事专心致志或忘我地工作、学习。","source":{"text":"忘记了睡觉，顾不得吃饭。形容对某事专心致志或忘我地工作、学习。"},"example":{"text":"忘记了睡觉，顾不得吃饭。形容对某事专心致志或忘我地工作、学习。"},"similar":["废寝忘食","废寝忘餐","忘寝废食"],"opposite":["饱食终日"],"usage":"作谓语、定语、状语；形容人刻苦努力"},{"id":18724,"word":"忙上加忙","pinyin":"máng shàng jiā máng","abbr":"msjm","explanation":"指人十分繁忙。","source":{"text":"凤姐儿自不必说，忙上加忙。李纨宝钗自然和婶母姊妹叙离别之情。","book":"清·曹雪芹《红楼梦》第49回"},"example":{"text":"临时给我增加任务，让我～了。"},"opposite":["闲极无聊"],"usage":"作谓语、状语；指人十分繁忙","story":["大观园一下子来了四家亲戚，有邢夫人的侄女邢岫烟一家，王熙凤的哥哥王仁，李纨的侄女李纹、李绮，薛宝钗的妹妹薛宝琴、堂弟薛蝌。贾母十分高兴待客，命王熙凤安排她们食宿，凤姐自然就忙上加忙，只有黛玉触景生情，暗中流泪"]},{"id":18725,"word":"忙不择价","pinyin":"máng bù zé jià","abbr":"mbzj","explanation":"匆忙中售货要不了好价钱。","source":{"text":"如今忙不择价，岂不可惜。","book":"明·冯梦龙《警世通言》第15卷"},"usage":"作定语、状语；用于慌乱时"},{"id":18726,"word":"忙中有失","pinyin":"máng zhōng yǒu shī","abbr":"mzys","explanation":"匆忙当中难免有失误。","source":{"text":"这是他忙中有失，也是命中造定，归咎何人？","book":"清·李汝珍《镜花缘》第26回"},"similar":["忙中有错"],"usage":"作宾语、定语、状语；用于慌乱时"},{"id":18727,"word":"忙中有序","pinyin":"máng zhōng yǒu xù","abbr":"mzyx","explanation":"充：秩序，引申为条理。工作很多或事情很急，但仍能做得很有条理。"},{"id":18728,"word":"忙中有错","pinyin":"máng zhōng yǒu cuò","abbr":"mzyc","explanation":"在慌张忙乱中照顾不周而产生差错。亦作“忙中有失”。","source":{"text":"万事尽从忙里错，一心须向静中安。","book":"宋·戴复古《处世》"},"example":{"text":"他这一乐，乐得～，爬起来慌慌张张的也向舅太太磕了个头。","book":"清·文康《儿女英雄传》第四十回"},"similar":["忙中有失"],"usage":"作定语、状语；用于慌乱时"},{"id":18729,"word":"忙忙乱乱","pinyin":"máng máng luàn luàn","abbr":"mmll","explanation":"事情繁忙而没有秩序。","source":{"text":"各处去寻，寻了半晌，一个个忙忙乱乱的走将进来。","book":"清·褚人获《隋唐演义》第31回"},"example":{"text":"路遥《平凡的世界》第一卷第八章：“玉厚参加了村里给解放军送粮的运输队，同时还得种地，东跑西奔，～。”"},"opposite":["井井有条"],"usage":"作定语、状语；用于处事"},{"id":18730,"word":"忙忙碌碌","pinyin":"máng máng lù lù","abbr":"mmll","explanation":"形容事务繁杂、辛辛苦苦的样子。","source":{"text":"且说贾珍那边，开了宗祠，着人打扫，收拾供器，请神主，又打扫上房，以备悬供遗真影像。此时荣宁二府内外上下，皆是忙忙碌碌。","book":"清·曹雪芹《红楼梦》第五十三回"},"example":{"text":"～，所以无人阻挡，由他二人进出。","book":"清·钱彩《说岳全传》第四十三回"},"opposite":["悠闲自在"],"usage":"作定语、状语；形容十分繁忙"},{"id":18731,"word":"忙投急趁","pinyin":"máng tóu jí chèn","abbr":"mtjc","explanation":"趁：赶。急急忙忙地赶路。","source":{"text":"这两个忙投急趁，止思量早完公事。","book":"明·兰陵笑笑生《金瓶梅词话》第55回"},"usage":"作谓语、状语；用于赶路"},{"id":18732,"word":"忙而不乱","pinyin":"máng ér bù luàn","abbr":"mebl","explanation":"在繁忙的工作中或紧急情况下，有条有理，毫不慌乱。"},{"id":18733,"word":"忙里偷闲","pinyin":"máng lǐ tōu xián","abbr":"mltx","explanation":"在忙碌中抽出一点时间来做别的不关重要的事，或者消遣。","source":{"text":"宰云：‘吾辈可谓忙里偷闲，苦中作乐。以八字为韵。’","book":"宋·陈造《同陈宰黄簿游灵山八首》自注"},"example":{"text":"原来阿妹去看瀑布，可谓“～”了。","book":"清·李汝珍《镜花缘》第四十九回"},"usage":"作谓语、定语；用于善于调剂时间"},{"id":18734,"word":"忝列衣冠","pinyin":"tiǎn liè yī guān","abbr":"tlyg","explanation":"忝：有愧于，常用作廉词；衣冠：指士以上的服饰，引申为士绅。勉强名列士绅的行列之中而感到惭愧。","source":{"text":"清·吴敬梓《儒林外史》第五回：“一个做贡生的人，忝列衣冠；不在乡里间做些好事，只管如此骗人"}},{"id":18735,"word":"忝窃虚名","pinyin":"tiǎn qiè xū míng","abbr":"tqxm","explanation":"忝：谦词，愧；窃：窃据。空有虚名。","source":{"text":"忝窃虚名，毫无实际，愧悔之至！","book":"清·曾国藩《曾国藩日记》"},"similar":["徒有虚名"],"usage":"作谓语、定语；多用于自谦"},{"id":18736,"word":"忝陪末座","pinyin":"tiǎn péi mò zuò","abbr":"tpmz","explanation":"忝：辱，愧。惭愧地坐在末座作陪。","source":{"text":"胡愈之诸先生，我也忝陪末座。","book":"邹韬奋《患难余生记》第一章"},"usage":"作谓语；用于自谦"},{"id":18737,"word":"忝颜偷生","pinyin":"tiǎn péi tōu shēng","abbr":"tyts","explanation":"忝颜：厚脸皮；偷生：苟且地活着。比喻厚着脸皮活在世上。","source":{"text":"弟愚不才，忝颜偷生。","book":"清·孔尚任《桃花扇·拜坛》"},"similar":["苟且偷生"],"usage":"作谓语、定语、状语；用于处世等"},{"id":18738,"word":"忠不可兼","pinyin":"zhōng bù kě jiān","abbr":"zbkj","explanation":"兼：兼任。不可同时忠于两国君主。比喻一臣不可辅佐二主。","source":{"text":"利不可两，忠不可兼。","book":"《吕氏春秋·权勋》"},"usage":"作宾语、定语；用于书面语"},{"id":18739,"word":"忠不违君","pinyin":"zhōng bù wéi jūn","abbr":"zbwj","explanation":"违：违背。忠心耿耿，绝不违背君主。","source":{"text":"吾闻之也，义不背亲，忠不违君，故东宗本州以为亲援，中扶郡将以安社稷，一举二得以徼忠孝，何以为非？","book":"《三国志·魏志·臧洪传》"},"usage":"作宾语、定语；用于书面语"},{"id":18740,"word":"忠不避危","pinyin":"zhōng bù bì wēi","abbr":"zbbw","explanation":"忠：忠于。避：回避。忠于职守，不回避危险，","source":{"text":"忠不避危，爱无恶言。","book":"《晏子》"},"usage":"作宾语、定语；用于书面语"},{"id":18741,"word":"忠于职守","pinyin":"zhōng yú zhí shǒu","abbr":"zyzs","explanation":"忠诚地对待本职工作，一丝不苟。","example":{"text":"像他这样的连长，以及那些土头土脑的战士，无疑都是～的。（李存葆《高山下的花环》三）"}},{"id":18742,"word":"忠信乐易","pinyin":"zhōng xìn lè yì","abbr":"zxly","explanation":"忠信：忠厚老实；乐易：欢乐，平易。指为人忠厚老实，平易近人。","source":{"text":"忠信乐易，表里一致者，使其人资禀虽甚鲁钝，侪辈之中，有弗称慕之者乎？","book":"明·王守仁《教条示龙场诸生》"},"example":{"text":"明·王守仁《教条示龙场诸生》：“～，表里一致。”"},"usage":"作定语、状语；用于书面语"},{"id":18743,"word":"忠厚长者","pinyin":"zhōng hòu zhǎng zhě","abbr":"zhzz","explanation":"忠实厚道、年高望重的人","source":{"text":"当时的‘舆论’都称赞黎是‘忠厚长者’和‘稳健派’。","book":"陶菊隐《北洋军阀统治时期史话》第七章"},"usage":"作宾语、定语；用于书面语"},{"id":18744,"word":"忠君报国","pinyin":"zhōng jūn bào guó","abbr":"zjbg","explanation":"忠于国君，报效国家。","source":{"text":"大丈夫生于天地之间，济世安民，忠君报国，乃是男儿所为。","book":"元·郑德辉《伊尹耕莘》第二折"},"example":{"text":"明·无名氏《杨家将演义》第八卷：“～之丈夫，马革裹尸，肝胆涂地所不辞也。”"},"usage":"作谓语、定语；用于书面语"},{"id":18745,"word":"忠君爱国","pinyin":"zhōng jūn ài guó","abbr":"zjag","explanation":"对君主忠贞，对国家挚爱。","source":{"text":"此人虽则商贾之流，倒也有些忠君爱国之心、排患解纷之略。","book":"明·冯梦龙《东周列国志》第44回"},"example":{"text":"诸将赴都堂听讲经史，庶几～之心。","book":"清·朱彝尊《袁凯传》"},"similar":["忠君报国"],"usage":"作谓语、宾语、定语；指封建思想"},{"id":18746,"word":"忠告善道","pinyin":"zhōng gào shàn dào","abbr":"zgsd","explanation":"道：同“导”，引导。真诚劝告，善意引导。","source":{"text":"忠告而善道之，不可则止，毋自辱焉。","book":"《论语·颜渊》"},"example":{"text":"每引见谈论，依经守义，曲尽～之意。（《清史稿·朱之瑜传》）"},"usage":"作宾语、定语；用于书面语"},{"id":18747,"word":"忠孝不并","pinyin":"zhōng xiào bù bìng","abbr":"zxbb","explanation":"并：并行。指忠孝难以两全。","source":{"text":"忠孝不并，我儿须人辅弼，卿宜抑割，岂可徇以私情？","book":"唐·令狐德《大唐故柱国燕国公于君碑铭》"},"example":{"text":"～，我儿须人辅弼，卿宜抑割，不可徇以私情。（《北史·于志宁传》）"},"opposite":["忠孝两全"],"usage":"作谓语、定语；用于处事"},{"id":18748,"word":"忠孝两全","pinyin":"zhōng xiào liǎng quán","abbr":"zxlq","explanation":"对国家尽忠，对父母尽孝，两样都做得很好。亦作“忠孝双全”。","source":{"text":"人生须要忠孝两全，方是个丈夫。","book":"唐·白居易《除程执恭检校右仆射制》：“业传将略，名在勋籍；蕴天爵以修己，忠孝两全。”元·高明《琵琶记·高堂称寿》"},"example":{"text":"小弟闻得岳元帅～，大重义气，我此去投他，公私两尽。","book":"清·钱彩《说岳全传》第三十三回"},"similar":["忠孝双全"],"opposite":["不忠不孝"],"usage":"作宾语、定语；用于处事"},{"id":18749,"word":"忠孝双全","pinyin":"zhōng xiào shuāng quán","abbr":"zxsq","explanation":"对国家尽忠，对父母尽孝，两样都做得很好。同“忠孝两全”。","source":{"text":"那个不说儿文章亏杀了娘针线，学成了诗云子曰，久以后忠孝双全。","book":"宋·无名氏《沁园春》词：“正归班玉笋，花袍方卸，彩衣亟著，忠孝双全。”元·秦简夫《剪发待宾》第一折"},"example":{"text":"老人撅着胡子告诉他：‘～，才是好汉。’","book":"老舍《赵子曰》第二十一"},"similar":["忠孝两全"],"opposite":["忠孝不并"],"usage":"作宾语、定语；用于处事"},{"id":18750,"word":"忠孝节义","pinyin":"zhōng xiào jié yì","abbr":"zxjy","explanation":"泛指封建统治者所提倡的道德准则。","source":{"text":"吾今为忠孝节义判官，所主人间忠臣、孝子、义夫、节妇事也。","book":"宋·洪迈《夷坚丙志·忠孝节义判官》"},"example":{"text":"那些充满了～、悲欢离合的故事曾迷惑了他。","book":"丁玲《太阳照在桑乾河上》"},"similar":["忠孝节烈"],"usage":"作主语、宾语、定语；指封建道德准则"},{"id":18751,"word":"忠孝节烈","pinyin":"zhōng xiào jié liè","abbr":"zxjl","explanation":"泛指封建统治者所提倡的道德准则。","source":{"text":"吾今为忠孝节义判官，所生人间忠臣、孝子、义夫、节妇事也。","book":"宋·洪迈《夷坚丙志·忠孝节义判官》"},"example":{"text":"遇～事，则益慷概激昂。（清·邵长蘅《侯方域魏禧传》）"},"similar":["忠孝节义"],"usage":"作主语、宾语、定语；指封建道德准则"},{"id":18752,"word":"忠实心诚","pinyin":"zhōng shí xīn chéng","abbr":"zsxc","explanation":"忠厚老实而又诚心实意。","source":{"text":"及死之日，天下知与不知，皆为尽哀。彼其忠实心诚信于士大夫也。","book":"《史记·李将军列传》"},"usage":"作谓语、定语；用于书面语"},{"id":18753,"word":"忠心耿耿","pinyin":"zhōng xīn gěng gěng","abbr":"zxgg","explanation":"耿耿：忠诚的样子。形容非常忠诚。","source":{"text":"当日令尊伯伯为国损躯，虽大事未成，然忠心耿耿，自能名垂不朽。","book":"清·李汝珍《镜花缘》第五十七回"},"example":{"text":"卢永祥见一个～的陈乐山忽然变了样子，还不晓是何缘故，十分诧异。","book":"蔡东藩、许廑父《民国通俗演义》第一五八回"},"similar":["赤胆忠心","忠贞不渝","披肝沥胆"],"opposite":["虚与委蛇","假仁假义","忘恩负义"],"usage":"作谓语、定语、状语；指人忠诚"},{"id":18754,"word":"忠心贯日","pinyin":"zhōng xīn guàn rì","abbr":"zxgr","explanation":"贯：贯通。忠诚之心可以贯通日月。形容忠诚至极。同“忠贯白日”。","source":{"text":"卿忠心贯日，孤不罪也。","book":"《东周列国志》第十七回"},"similar":["忠贯白日","忠贯日月"],"usage":"作谓语、定语；用于书面语"},{"id":18755,"word":"忠心赤胆","pinyin":"zhōng xīn chì dǎn","abbr":"zxcd","explanation":"形容十分忠诚。","source":{"text":"我闻得慕容兵道是个忠心赤胆的人，未必就肯投降。","book":"清·李渔《比目鱼》"},"example":{"text":"我们的人哪，却有吓不破的～。","book":"郭小川《秋歌》"},"similar":["赤胆忠心","忠心耿耿"],"usage":"作宾语、定语；指人忠诚"},{"id":18756,"word":"忠果正直","pinyin":"zhōng guǒ zhèng zhí","abbr":"zgzz","explanation":"果：果断。忠诚果断，公正刚直。","source":{"text":"忠果正直，志怀霜雪，见善若惊，疾恶若仇。","book":"汉·孔融《荐祢衡表》"},"usage":"作谓语、定语；用于书面语"},{"id":18757,"word":"忠款诚信","pinyin":"zhōng kuǎn chéng xìn","abbr":"zkcx","explanation":"款：诚恳。忠实诚恳守信用。","source":{"text":"齐桓卫姬，忠款诚信，公好淫乐，姬为修身，望色请罪，桓公加焉，厥使治内，立为夫人。","book":"汉·刘向《列女传·齐桓卫姬颂》"},"usage":"作谓语、定语；用于书面语"},{"id":18758,"word":"忠肝义胆","pinyin":"zhōng gān yì dǎn","abbr":"zgyd","explanation":"忠心耿耿，仗义行事。形容十分忠诚。","source":{"text":"忠肝义胆不可状，要与人间留好样。","book":"宋·汪元量《浮丘道人招魂歌》"},"example":{"text":"丞相金銮直谏君，～孰能群。","book":"明·许仲琳《封神演义》第二回"},"similar":["赤胆忠心","忠心赤胆"],"usage":"作主语、宾语、定语；指忠心耿耿"},{"id":18759,"word":"忠臣不事二君，烈女不更二夫","pinyin":"zhōng chén bù shì èr jūn，liè nǚ bù gēng èr fū","abbr":"zcbsejlnbgef","explanation":"忠臣绝不辅佐两个朝代的君主；贞烈的妇女决不再嫁第二个丈夫，这是封建时代的伦理道德。比喻忠诚坚贞，绝无二心。","source":{"text":"忠臣不事二君，忠女不更二夫，齐王不听吾谏，故退而耕于野。","book":"《史记·田单列传》"},"example":{"text":"～。我为隋臣，不能匡救君恶，致被逆贼所弒，不能报仇，而事别主，何面目立于世乎？（清·褚人获《隋唐演义》第四十九回）"},"similar":["忠臣不事二君，贞女不更二夫"],"usage":"作宾语、定语；用于书面语"},{"id":18760,"word":"忠臣不事二君，贞女不更二夫","pinyin":"zhōng chén bù shì èr jūn，zhēn nǚ bù gēng èr fū","abbr":"zcbsejznbgef","explanation":"事：侍奉，服侍。忠义之臣，不奉事两个朝代的君主；贞节的妇女，不再嫁第二个丈夫。指忠诚不二","source":{"text":"忠臣不事二君，贞女不更二夫。齐王不听吾谏，故退而耕子野。","book":"西汉·司马迁《史记·田单列传》"},"similar":["忠臣不事二君，烈女不更二夫"],"usage":"作宾语、定语；用于书面语"},{"id":18761,"word":"忠臣义士","pinyin":"zhōng chén yì shì","abbr":"zcys","explanation":"忠诚而有节操的臣民。","source":{"text":"每览史籍，观古忠臣义士，出一朝之命，以徇国家之难。","book":"《三国志·魏志·陈思王植传》"},"example":{"text":"清·钱彩《说岳全传》第73回：“～，尽陷罗网之中；乱臣贼子，咸置庙廊之上。”"},"opposite":["乱臣贼子"],"usage":"作主语、宾语、定语；用于书面语"},{"id":18762,"word":"忠臣孝子","pinyin":"zhōng chén xiào zǐ","abbr":"zcxz","explanation":"对君主尽忠对父母尽孝的人。","source":{"text":"使生死终始若一，一足以为人愿，是先王之道，忠臣孝子之极也。","book":"《荀子·礼论》"},"example":{"text":"清·无垢道人《八仙全传》第25回：“大凡～，存心最正，去仙最近。”"},"opposite":["乱臣逆子"],"usage":"作主语、宾语、定语；用于书面语"},{"id":18763,"word":"忠臣烈士","pinyin":"zhōng chén liè shì","abbr":"zcls","explanation":"忠义刚烈的臣子。","source":{"text":"每读书至治乱得失、忠臣烈士，未尝不反复吟玩。","book":"《隋书·李文博传》"},"example":{"text":"清·李汝珍《镜花缘》第81回：“今日之下，其所以家喻户晓，知他为～，名垂千古者，皆由无心而传。”"},"usage":"作主语、宾语、定语；用于书面语"},{"id":18764,"word":"忠臣良将","pinyin":"zhōng chén liáng jiàng","abbr":"zclj","explanation":"忠实的大臣和优秀的将帅。","source":{"text":"袭人道：‘忠臣良将，出于不得已他才死。’","book":"清·曹雪芹《红楼梦》第36回"},"usage":"作主语、宾语、定语；用于爱国人士","story":["贾宝玉因为金钏儿跳井自杀与王府来讨要戏子，被父亲贾政痛打一顿，他躺在床上与袭人谈论忠臣良将的事情，他认为忠臣为了名义而死谏，置君王于不顾；良将为了博己之名，猛拚一死，置国家于不顾，他们都不是好人"]},{"id":18765,"word":"忠言嘉谟","pinyin":"zhōng yán jiā mò","abbr":"zyjm","explanation":"忠恳的言论，卓越的计谋。","source":{"text":"忠言嘉谟效于当时，而文采表于后世。","book":"宋·苏轼《醉白堂记》"},"example":{"text":"举一世之端人正士，莫之或先；合二百年之～，于斯并建。（宋·陈亮《谢何正言启》）"},"similar":["忠言奇谋"],"usage":"作宾语、定语；用于书面语"},{"id":18766,"word":"忠言奇谋","pinyin":"zhōng yán qí móu","abbr":"zyqm","explanation":"忠诚的进言，出众的谋略。","source":{"text":"不有忠言奇谋而取大位，何其往来屑屑不惮烦也。","book":"《后汉书·王良传》"},"similar":["忠言嘉谟"],"usage":"作宾语、定语；用于书面语"},{"id":18767,"word":"忠言谠论","pinyin":"zhōng yán dǎng lùn","abbr":"zydl","explanation":"谠：正直。出言忠诚，立论正直。","source":{"text":"故赠太师谥文忠苏轼，忠言谠论，立朝大节，一时廷臣无出其右。","book":"宋·赵昚宗《经进东坡文集序》"},"example":{"text":"《元史·赵与票传》：“朝廷立法多所咨访，与票～，无所顾惜。进直学士，特侍讲。”"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":18768,"word":"忠言逆耳","pinyin":"zhōng yán nì ěr","abbr":"zyne","explanation":"逆耳：不顺耳。正直的劝告听起来不顺耳，但有利于改正缺点错误。","source":{"text":"忠言逆耳利于行。","book":"《韩非子·外储说左上》：“夫良药苦于口，而智者劝而饮之，知其入而已己疾也；忠言拂于耳，而明主听之，知其可以致功也。”《史记·留侯世家》"},"example":{"text":"烟馆里的人，都看这人来历不明，劝他不要与那人要好，却是～，哪里听得。","book":"清·彭养鸥《黑籍冤魂》第十三回"},"similar":["良药苦口","持平之论"],"opposite":["甜言蜜语","花言巧语"],"usage":"作谓语、宾语、分句；常与“良药苦口”连用","story":["公元前207年，刘邦率大军攻占咸阳，进入秦宫，见美女如云，珍宝无数。他打算住在宫内享受，樊哙劝他以天下为重。刘邦不以为然。谋士张良说这正是秦朝灭亡的原因，且忠言逆耳利于行。刘邦听从劝告退兵驻守霸上等待项羽的到来"]},{"id":18769,"word":"忠诚不渝","pinyin":"zhōng chéng bù yú","abbr":"zcby","explanation":"渝：改变，违背。忠诚坚定，永不改变。","source":{"text":"她是你的同事，你的同志，你在今后革命征途上和科学事业上忠诚不渝的伴侣和战友！","book":"《第二次握手》"},"example":{"text":"职务高了，地位变了，对仍在家务农的妻子～。（谌容《懒得离婚》三）"},"similar":["忠贞不渝","忠贞不贰","忠贞不屈"],"usage":"作谓语、定语；用于处事"},{"id":18770,"word":"忠贞不二","pinyin":"zhōng zhēn bù èr","abbr":"zzbe","explanation":"贞：意志或操守坚定不移。忠诚坚定，永不改变。","example":{"text":"红娘子平日深明大义，～，务须体念朕诛杀叛臣，消灭乱萌之苦心。（姚雪垠《李自成》第五卷第十三章）"}},{"id":18771,"word":"忠贞不屈","pinyin":"zhōng zhēn bù qū","abbr":"zzbq","explanation":"忠诚而坚定不屈。形容不向邪恶屈服。","source":{"text":"为了争取中国人民的民族自由和社会改革，忠贞不屈，视死如归，悲壮激昂，可歌可泣。","book":"范文澜《中国近代史》上册附录"},"example":{"text":"从姜青山的述说中，得知这条青年好汉的高尚气质和～的气节。（曲波《林海雪原》第二十七章）"},"similar":["忠贞不渝","忠贞不贰","忠诚不渝"],"usage":"作谓语、定语；用于人或事物"},{"id":18772,"word":"忠贞不渝","pinyin":"zhōng zhēn bù yú","abbr":"zzby","explanation":"忠：忠诚；贞：有操守；渝：改变。忠诚坚定，永不改变。","source":{"text":"我始终期望着，有朝一日，把自己的学识、才能献给祖国；同时把自己忠贞不渝的感情，完美无缺地献给你。","book":"张扬《第二次握手》"},"example":{"text":"他对党对人民的～。"},"similar":["忠贞不二","忠心耿耿","赤胆忠心"],"opposite":["六亲不认","大逆不道","离经叛道"],"usage":"作谓语、定语；用于人或事物"},{"id":18773,"word":"忠贞不贰","pinyin":"zhōng zhēn bù èr","abbr":"zzbe","explanation":"忠：忠诚；贞：有操守。忠诚坚定，永不改变","source":{"text":"你为党为人民真是忠贞不贰，你在革命过程中，经历了艰苦曲折，千辛万苦……","book":"周恩来《为庆贺朱总司令六十大寿的祝辞》"},"similar":["忠贞不屈","忠贞不渝","忠诚不渝"],"usage":"作谓语、定语；用于人或事物"},{"id":18774,"word":"忠贯日月","pinyin":"zhōng guàn rì yuè","abbr":"zgry","explanation":"忠诚之心可以贯通日月。形容忠诚至极。","source":{"text":"子仪自朔方提孤军，转战逐北，谊不还顾……虽唐命方永，亦有忠贯日月，神明扶持者哉！","book":"《新唐书·郭子仪传赞》"},"example":{"text":"功盖天地，～，进则毅然身任天下之重，退则怡然了无愠戚之容，求之于古，其伊周之亚与？","book":"宋·刘炎《迩言》"},"similar":["忠贯白日","忠心贯日"],"usage":"作谓语、定语；用于书面语"},{"id":18775,"word":"忠贯白日","pinyin":"zhōng guàn bái rì","abbr":"zgbr","explanation":"贯：贯通。忠诚之心可以贯通白日。形容忠诚无比。亦作“忠心贯日”。","source":{"text":"惟其忠贯白日，识高天下，故精神见于翰墨之表者，特立而兼括。","book":"《宣和书谱·颜真卿》"},"similar":["忠贯日月","忠心贯日"],"usage":"作谓语、定语；用于书面语"},{"id":18776,"word":"忠驱义感","pinyin":"zhōng qū yì gǎn","abbr":"zqyg","explanation":"指为忠心所驱使，为正义所感召。","source":{"text":"忠驱义感即风雷，谁道南方乏武才？天下起兵诛董卓，长沙子弟最先来。","book":"唐·吕温《题阳人城》诗"},"example":{"text":"～国恩赊，板荡无将赤手遮。星散诸侯屯渤海。飙回子弟走长沙。","book":"清·钱谦益《病榻消寒杂咏》之十八"},"usage":"作宾语、定语；用于书面语"},{"id":18777,"word":"忠鲠不挠","pinyin":"zhōng gěng bù náo","abbr":"zgbn","explanation":"鲠：鱼刺，借喻正直。忠诚正直，不向恶势力屈服。","source":{"text":"逮元康之间，贼臣专命，举朝战栗，苟避菹醢；颂以此时，忠鲠不挠，哭张公之非罪，拒赵王之妄锡，虽古遗直，何以尚兹。","book":"《晋书·刘颂传论》"},"usage":"作谓语、定语；用于书面语"},{"id":18778,"word":"忤逆不孝","pinyin":"wǔ nì bù xiào","abbr":"wnbx","explanation":"忤逆：不顺从。不服从和孝敬父母。","source":{"text":"谁叫上鬼子国来呢！在鬼子国没地方去告忤逆不孝！忍着吧！","book":"老舍《二马》第四段"},"example":{"text":"他生了一个～的儿子。"},"usage":"作谓语、定语；指不孝敬父母"},{"id":18779,"word":"忧公如家","pinyin":"yōu gōng rú jiā","abbr":"ygrj","explanation":"担忧公事，就像担忧家事一样上心。","source":{"text":"洪少不好学问，而忠清款亮，忧公如家，事继母至孝。","book":"《三国志·蜀志·杨洪传》"},"example":{"text":"柔而不犯，文而有礼，忠贞之性，～。","book":"《后汉书·胡广传》"},"similar":["忧国如家"],"usage":"作谓语、定语；用于处事"},{"id":18780,"word":"忧公忘私","pinyin":"yōu gōng wàng sī","abbr":"ygws","explanation":"关心公益，不顾私利。","source":{"text":"忧公忘私者必不然，但先公后私即自办也。","book":"《三国志·魏志·杜恕传》"},"example":{"text":"宋·司马光《上体要疏》：“陛下苟能精选晓知钱谷、～之人，以为三司使、副判官、诸路转运使，各使久于其任……何患财利之不丰哉！”"},"similar":["大公无私"],"opposite":["假公济私"],"usage":"作谓语、定语；用于处事"},{"id":18781,"word":"忧公无私","pinyin":"yōu gōng wú sī","abbr":"ygws","explanation":"一心忧劳国事，不顾及私利。","source":{"text":"陈之于主，行之于身，志于忠上济事，忧公无私。","book":"三国·魏·桓范《世要论·臣不易》"},"usage":"作谓语、定语；用于处事"},{"id":18782,"word":"忧劳成疾","pinyin":"yōu láo chéng jí","abbr":"ylcj","explanation":"由于过度忧伤劳累而引起疾病。","source":{"text":"遗身利物，栉风休雨，由姓为心，忧劳成疾，同尧肌之如腊，甚禹足之胼胝，针石屡加，腠理犹滞。","book":"唐·魏征《九成宫醴泉铭》"},"example":{"text":"存贤性忠谨周慎，昼夜戒严，不遑寝食，以至～，卒于幽州，时年六十五。","book":"《旧五代史·李存贤传》"}},{"id":18783,"word":"忧喜交集","pinyin":"yōu xǐ jiāo jí","abbr":"yxjj","explanation":"忧伤和喜悦一齐涌上心头。","source":{"text":"随后曹仁、李典、乐进各引兵寻到，见了曹操，忧喜交集；聚集残兵五百余人，同回河内。","book":"明·罗贯中《三国演义》第六回"},"example":{"text":"他站在海边石上，远眺茫茫大海，眼见波涛汹涌，心中～。","book":"金庸《神雕侠侣》第三十二回"},"similar":["悲喜交集"],"usage":"作谓语、定语；形容又高兴又难过"},{"id":18784,"word":"忧国哀民","pinyin":"yōu guó āi mín","abbr":"ygam","explanation":"担心国事，为百姓的安危担心。","source":{"text":"羌独往来，深入多杀，己乃陆陆，相将诣阙，谐辞礼谢，退云状，会坐朝堂，则无忧国哀民恳恻之诚，苟转相顾望，莫肯违止，日晏时移，议无所定，己且须后。","book":"汉·王符《潜夫论·救边》"},"similar":["忧国恤民"],"usage":"作谓语、定语；用于处事"},{"id":18785,"word":"忧国奉公","pinyin":"yōu guó fèng gōng","abbr":"ygfg","explanation":"心怀国家，努力做好工作。","source":{"text":"安得忧国奉公之臣如祭征虏者乎。","book":"《后汉书·祭遵传》"},"usage":"作谓语、定语；指人"},{"id":18786,"word":"忧国如家","pinyin":"yōu guó rú jiā","abbr":"ygrj","explanation":"忧虑国事，就像家事一样悬挂在心里。","source":{"text":"君其孰念详计，塞绝奸原，忧国如家，务便百姓，以辅册。","book":"汉·刘骜《赐翟方进册》"},"example":{"text":"唐·韩愈《论今年权停举选状》：“以臣之愚，以为宜求纯信之士，骨鲠之臣，～，忘身奉上者。”"},"similar":["忧公如家"],"usage":"作谓语、定语；用于处事"},{"id":18787,"word":"忧国忘家","pinyin":"yōu guó wàng jiā","abbr":"ygwj","explanation":"因忧虑国事而不考虑自己的家事。","source":{"text":"中郎将来歙，攻战连年，平定羌、陇，忧国忘家，忠孝彰著。","book":"《后汉书·来歙传》"},"example":{"text":"～，用意深远，所谓朝之耆德老成人者。","book":"唐·韩愈《论孔戣致仕状》"},"similar":["忧国忘私"],"usage":"作谓语、定语；指一心为国"},{"id":18788,"word":"忧国忘思","pinyin":"yōu guó wàng sī","abbr":"ygws","explanation":"忧劳国事，不老虎个人私事。","source":{"text":"其忧国忘私，乘马三年，不别牝牡。","book":"《古文苑·楚相孙叔敖碑》"}},{"id":18789,"word":"忧国忘私","pinyin":"yōu guó wàng sī","abbr":"ygws","explanation":"忧劳国事，不考虑个人私事。","source":{"text":"征东将军胡质、卫尉田豫皆服职前朝，历事四世，出统戎马，入赞庶政，忠清在公，忧国忘私，不营产业，身没之后，家无馀财，朕甚嘉之。","book":"《三国志·魏志·徐邈传》"},"example":{"text":"其～，乘马三年，不别牝牡。","book":"《古文苑·楚相孙叔敖碑》"},"similar":["忧公忘私"],"usage":"作谓语、定语；用于处事"},{"id":18790,"word":"忧国忘身","pinyin":"yōu guó wàng shēn","abbr":"ygws","explanation":"忧劳国事，不顾个人安危得失。","source":{"text":"故淮南王允忠孝笃诚，忧国忘身，讨乱奋发，几于克捷。","book":"《晋书·淮南忠壮王允传》"},"example":{"text":"《明史·于谦传》：“至性过人，～。”"},"usage":"作谓语、定语；用于处事"},{"id":18791,"word":"忧国忧民","pinyin":"yōu guó yōu mín","abbr":"ygym","explanation":"为国家的前途和人民的命运而担忧。","source":{"text":"寡人忧国爱民，固愿得士以治之。","book":"《战国策·齐策》"},"example":{"text":"那时节，朕却～。","book":"明·吴承恩《西游记》"},"similar":["忧国爱民"],"usage":"作谓语、宾语、定语；指爱国人士"},{"id":18792,"word":"忧国恤民","pinyin":"yōu guó xù mín","abbr":"ygxm","explanation":"忧虑国事。怜恤百姓。","source":{"text":"文书委于官曹，系囚积于囹圄，而不遑省也。详察其为也，非欲忧国恤民，谋道讲德也。","book":"冯·徐干《中论·谴交》"},"similar":["忧国哀民"],"usage":"作谓语、定语；用于处事"},{"id":18793,"word":"忧国爱民","pinyin":"yōu guó ài mín","abbr":"ygam","explanation":"忧心国家，爱护百姓。","source":{"text":"寡人忧国爱民，固愿得士以治之。","book":"《战国策·齐策》"},"example":{"text":"先皇帝即位之初，风飞雷厉，将大有为。～之心虽切于己，尊贤使能之道未得其人。","book":"明·宋濂《元史·本纪第四·世祖一》"},"similar":["忧国忧民"],"usage":"作谓语、定语；指忧虑国事"},{"id":18794,"word":"忧形于色","pinyin":"yōu xíng yú sè","abbr":"yxys","explanation":"形：表现。忧虑的心情在脸上表现出来。形容抑制不住内心的忧虑。","source":{"text":"四年六月，天下旱，蝗食田，祷祈无效，上忧形于色。","book":"《旧唐书·五行志》"},"example":{"text":"每谈及世变，辄～，卒抑郁以终。","book":"《清史稿·宋维峻传》"},"opposite":["喜形于色"],"usage":"作谓语、定语、状语；用于处事"},{"id":18795,"word":"忧心如惔","pinyin":"yōu xīn rú tán","abbr":"yxrt","explanation":"火烧。愁得心里像火在煎熬一样。形容非常忧虑焦急。","source":{"text":"节彼南山，维石岩岩，赫赫师尹，民具尔瞻。忧心如惔，不敢戏谈，国既卒斩，何用不监。","book":"《诗经·小雅·节南山》"}},{"id":18796,"word":"忧心如捣","pinyin":"yōu xīn rú dǎo","abbr":"yxrd","explanation":"忧愁得像有东西在捣心一样。形容十分焦急。","source":{"text":"我心忧伤，惄焉如捣。","book":"《诗经·小雅·小弁》"},"example":{"text":"各家父老亲戚皆为之～。","book":"熊秉坤《武昌起义谈》"},"similar":["忧心如焚"],"usage":"作谓语、定语；指人很忧郁"},{"id":18797,"word":"忧心如焚","pinyin":"yōu xīn rú fén","abbr":"yxrf","explanation":"如焚：象火烧一样。心里愁得象火烧一样。形容非常忧虑焦急。","source":{"text":"忧心如焚，不敢戏谈。","book":"《诗经·小雅·节南山》"},"example":{"text":"～，命不久矣。","book":"明·罗贯中《三国演义》第八十回"},"similar":["忧心忡忡","愁眉苦脸","愁肠百结"],"opposite":["欢天喜地","欣喜若狂","喜出望外"],"usage":"作谓语、定语、状语；表示人的焦急心情","story":["公元前781年，周幽王继位骄奢淫逸，昏庸无道，增加赋税，加重百姓的负担，人们只好流离失所，民不聊生。大臣家父看到这种政治局面，忧心如焚。他特地写诗上谏周幽王，希望能够减轻百姓负担，让他们休养生息。周幽王对此置之不理"]},{"id":18798,"word":"忧心如薰","pinyin":"yōu xīn rú xūn","abbr":"yxrx","explanation":"心里愁得像被火熏烤一样。形容十分忧虑痛苦。","source":{"text":"旱魃为虐，如惔如焚，我心惮暑，忧心如薰。","book":"《诗经·大雅·云汉》"},"example":{"text":"唐·杨炯《为梓州官属祭陆疵县文》：“夫万里之别，犹使饮泪成血，思德音之断绝；况百年之分，能不～，想公子兮氛氲。”"},"similar":["忧心如焚"],"usage":"作谓语、定语、状语；用于书面语"},{"id":18799,"word":"忧心如酲","pinyin":"yōu xīn rú chéng","abbr":"yxrc","explanation":"酲：酒醉后神志不清的状态。心中忧闷，就像醉酒后的病态一样。形容心情十分愁闷压抑。","source":{"text":"不吊昊天，乱靡有定，式月斯生，俾民不宁，忧心如酲，谁秉国成？","book":"《诗经·小雅·节南山》"},"example":{"text":"三国·魏·曹植《应诏诗》：“仰瞻城阈，俯惟阙庭，长怀永慕，～。”"},"usage":"作谓语、状语；用于书面语"},{"id":18800,"word":"忧心如醉","pinyin":"yōu xīn rú zuì","abbr":"yxrz","explanation":"忧愁痛苦的情态就像喝醉了酒一样。","source":{"text":"山有苞棣，隰有树檖。未见君子，忧心如醉。如何如何，忘我实多！","book":"《诗经·秦风·晨风》"},"example":{"text":"臣等处重城，食厚禄，仰思圣体劳顿，根本空虚，遥望清尘，～。","book":"《明史·毛澄传》"},"similar":["忧心若醉"],"usage":"作谓语、状语；用于处事"},{"id":18801,"word":"忧心忡忡","pinyin":"yōu xīn chōng chōng","abbr":"yxcc","explanation":"忡忡：忧虑不安的样子。形容心事重重，非常忧愁。","source":{"text":"未见君子，忧心忡忡。","book":"《诗经·召南·草虫》"},"example":{"text":"江南情形亦如此可怕吗？难道一班士大夫都不为国事～么？","book":"姚雪垠《李自成》第二卷第十七章"},"similar":["忧心如焚","提心吊胆","惶惶不安"],"opposite":["悠然自得","洋洋自得","泰然自若"],"usage":"作定语、状语、谓语；指心事重重","story":["我国最早的诗歌总集《诗经》中有一首民歌《草虫》，描写一个女子对丈夫的思念和见到丈夫的喜悦心情，这个女子去南山采摘野菜，见不到丈夫心里十分苦恼，她经常唱道：“未见君子，忧心忡忡。”"]},{"id":18802,"word":"忧心悄悄","pinyin":"yōu xīn qiāo qiāo","abbr":"yxqq","explanation":"忧虑不安的样子。","source":{"text":"忧心悄悄，愠于群小；觏闵既多，受侮不少。","book":"《诗经·邶风·柏舟》"},"example":{"text":"元·宫天挺《范张鸡黍》第四折：“岂不闻晏平仲为齐相，乘车人～，倒是御车吏壮志扬扬。”"},"similar":["忧心忡忡"],"usage":"作谓语、定语、状语；用于处事"},{"id":18803,"word":"忧心若醉","pinyin":"yōu xīn ruò zuì","abbr":"yxrz","explanation":"忧愁痛苦的情态就像喝醉了酒一样。","source":{"text":"山有苞棣，隰有树檖。未见君子，忧心如醉。如何如何，忘我实多！","book":"《诗经·秦风·晨风》"},"example":{"text":"沉～，积恨泪如雨。","book":"唐·李白《陈情赠友人》"},"similar":["忧心如醉"],"usage":"作谓语、状语；用于处事"},{"id":18804,"word":"忧患余生","pinyin":"yōu huàn yú shēng","abbr":"yhys","explanation":"忧患：困苦患难；余生：大灾难后侥幸存活的生命。指饱经患难之后侥幸保全下来的生命。","source":{"text":"东坡居士以桑榆之末景，忧患之余生，而后学道，虽为达者所笑，犹贤乎已也。","book":"宋·苏轼《东坡题跋·跋嵇叔夜〈养生论〉后》"},"example":{"text":"既已～，出而图事，则宜屏迩言而闳远略。","book":"清·章炳麟《致段祺瑞电》"},"usage":"作谓语；指人"},{"id":18805,"word":"忧愤成疾","pinyin":"yōu fèn chéng jí","abbr":"yfcj","explanation":"忧愁气愤得病了。形容极其忧愤。","source":{"text":"契丹因晋主招纳吐谷浑，遣使来让（责备），晋主忧愤成疾。","book":"《五代史平话·晋史》"},"example":{"text":"荀攸知之，～，卧病十数日而卒，亡年五十八岁。","book":"明·罗贯中《三国演义》第六十六回"},"usage":"作谓语、定语；用于处事"},{"id":18806,"word":"忧民忧国","pinyin":"yōu mín yōu guó","abbr":"ymyg","explanation":"为国家的前途和人民的命运而担忧。","source":{"text":"似圣悲增道不穷，忧民忧国契尧聪。","book":"唐·贯休《蜀王登福感寺塔三首》其二"},"example":{"text":"昨观书意，足见将军～之心；但恨亮年幼才疏，有误下问。","book":"明·罗贯中《三国演义》第三十八回"}},{"id":18807,"word":"忧深思远","pinyin":"yōu shēn sī yuǎn","abbr":"yssy","explanation":"深刻忧虑，长远打算。","source":{"text":"忧深思远，俭而用礼，乃有尧之遗风焉。","book":"《诗经·唐风·蟋蟀》小序"},"example":{"text":"水晶帘卷，听声声激越，～。","book":"清·陈天华《狮子吼》楔子"},"similar":["深谋远虑"],"usage":"作谓语、定语；指深谋远虑"},{"id":18808,"word":"忧盛危明","pinyin":"yōu shèng wēi míng","abbr":"yswm","explanation":"犹言居安思危。指随时有应付意外事件的思想准备。","source":{"text":"夫忧盛危明，辟邪镇恶，此皆臣子一念忠义所发，诚不可已。","book":"明·陈继儒《读书镜》第二卷"},"example":{"text":"《清史稿·仁宗纪》：“辛亥，诏曰：‘凡我君臣，当以～之心，不为苟且便安之计。’”"},"similar":["居安思危"],"usage":"作谓语、定语、宾语；用于处事"},{"id":18809,"word":"忧能伤人","pinyin":"yōu néng shāng rén","abbr":"ynsr","explanation":"指忧愁会损害人的健康。","source":{"text":"单孑独立，孤危愁苦，若使忧能伤人，此子不得永年矣。","book":"汉·孔融《论盛孝章书》"},"example":{"text":"唐·骆宾王《上吏部裴侍郎书》：“就令欢以卒岁，仰南薰之不赀；而使～，迫西山而何几？”"},"usage":"作宾语、定语；用于书面语"},{"id":18810,"word":"忧谗畏讥","pinyin":"yōu chán wèi jī","abbr":"ycwj","explanation":"担忧被谗言中伤。","source":{"text":"登斯楼也，则有去国怀乡，忧谗畏讥，满目萧然，感极而悲者矣。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"清·昭梿《啸亭杂录·嵇文恭公》：“公每早起，必自揉其身躯久之，曰：‘今日舒畅。’登朝如故，人皆笑之，然亦～之至矣。”"},"usage":"作谓语、定语；用于处事"},{"id":18811,"word":"快人快事","pinyin":"kuài rén kuài shì","abbr":"krks","explanation":"爽快人办爽快事。","source":{"text":"维时雪亭段君，踊跃付梓，快人快事，其有古人不见我之思乎？","book":"清·蒲松龄《聊斋志异·附各本序跋题辞〈陈序〉》"},"example":{"text":"这也就是哄传在集中营里的‘～’的一回。","book":"《上饶集中营·哀施奇同志》"},"usage":"作主语、宾语；指爽快人办爽快事"},{"id":18812,"word":"快人快性","pinyin":"kuài rén kuài xìng","abbr":"krkx","explanation":"指为人爽直痛快，不忸怩作态。","source":{"text":"何小姐自来快人快性，伸手就先接过去。","book":"清·文康《儿女英雄传》第三十八回"},"example":{"text":"魏大人可谓～！倒不怕吃了女儿茶，五更见罗刹。","book":"二月河《康熙大帝》第五部分"},"similar":["快人快语"],"usage":"作谓语、定语；指人的性格"},{"id":18813,"word":"快人快语","pinyin":"kuài rén kuài yǔ","abbr":"krky","explanation":"快：爽快，痛快。直爽的人说直爽的话。","source":{"text":"快马一鞭，快人一言。","book":"宋·释道原《景德传灯录》卷六"},"example":{"text":"宋大帅真是～！来，干一大杯！","book":"陈白尘、贾霁《宋景诗》二十四"},"similar":["心直口快","快嘴快舌"],"opposite":["支吾其辞","拖泥带水","拐弯抹角"],"usage":"作宾语、定语；指人直爽"},{"id":18814,"word":"快刀斩乱丝","pinyin":"kuài dāo zhǎn luàn sī","abbr":"kdzls","explanation":"比喻做事果断，能采取坚决有效的措施，很快解决复杂的问题。同“快刀斩乱麻”。","source":{"text":"他只等机会向她声明并不爱她，恨自己心肠太软，没有快刀斩乱丝的勇气。","book":"钱钟书《围城》三"},"similar":["快刀斩乱麻","快刀断乱麻"],"opposite":["拖泥带水"],"usage":"作定语、宾语；比喻抓住要害解决问题"},{"id":18815,"word":"快刀斩乱麻","pinyin":"kuài dāo jiǎn luàn má","abbr":"kdzlm","explanation":"比喻做事果断，能采取坚决有效的措施，很快解决复杂的问题。","source":{"text":"高祖尝试观诸子意识，各使治乱丝，帝独抽刀斩之，曰：‘乱者须斩！’","book":"《北齐书·文宣帝纪》"},"example":{"text":"自己一直在两者之间不停地碰来撞去，而终于不能用～的办法一下子彻底解决。","book":"巴金《谈〈灭亡〉》"},"similar":["干净利落","快刀断乱麻"],"opposite":["拖泥带水"],"usage":"作谓语、定语、宾语；比喻抓住要害解决问题","story":["北朝人高欢任东魏丞相时，他想测试几个儿子的智力，给每个儿子发上一堆乱麻，让他们尽快理清，大儿子一根根慢慢抽，越抽越乱，小儿子将乱麻分成两半然后再分开。只有高洋拿出快刀，几刀砍下去再理出一缕缕短麻来受到高欢的夸奖"]},{"id":18816,"word":"快刀斩麻","pinyin":"kuài dāo zhǎn má","abbr":"kdzm","explanation":"比喻做事果断，能采取坚决有效的措施，很快解决复杂的问题。同“快刀斩乱麻”。","source":{"text":"此时局势，须要快刀斩麻，不能拖泥带水。","book":"茅盾《腐蚀·十一月六日》"},"similar":["快刀斩乱丝","快刀斩乱麻"],"opposite":["拖泥带水"],"usage":"作定语、宾语；比喻抓住要害解决问题"},{"id":18817,"word":"快刀断乱麻","pinyin":"kuài dāo duàn luàn má","abbr":"kddlm","explanation":"快：锋利。比喻采取坚决有效的措施，果断解决复杂的问题。","source":{"text":"苟其所发论所措施，与此正鹄相缪戾者，则昌言排击之，无所顾恋，无所徇避，快刀断乱麻，一拳碎黄鹤。","book":"梁启超《乐利主义泰斗边泌之学说》"},"similar":["快刀斩乱麻"],"usage":"作谓语、定语、宾语；比喻抓住要害解决问题"},{"id":18818,"word":"快口直肠","pinyin":"kuài kǒu zhí cháng","abbr":"kkzc","explanation":"性情直爽，有话就说。","source":{"text":"文丞相心直口快，男子民。","book":"宋·文天祥《指南录·一·纪事诗四首序》"},"example":{"text":"宏甫～，目空一世，愤激过甚，不顾人有忤者。","book":"明·焦竑《李氏焚书序》"}},{"id":18819,"word":"快心满志","pinyin":"kuài xīn mǎn zhì","abbr":"kxmz","explanation":"形容心满意足，事情的发展完全符合心意。同“快心遂意”。","source":{"text":"不怕自己沥胆披肝，不肯受他人一分好处；只图一时快心满志，不管犯世途万种危机。","book":"清·文康《儿女英雄传》第十六回"},"similar":["快心满意","快心遂意","称心如意"],"usage":"作谓语、定语、状语；用于人的心情"},{"id":18820,"word":"快心满意","pinyin":"kuài xīn mǎn yì","abbr":"kxmy","explanation":"形容心满意足，事情的发展完全符合心意。同“快心遂意”。","source":{"text":"临后一人说到伤心之处，恨不在地下挖他做官的起来，像伍子胥把那楚平王鞭尸三百，才快心满意哩。","book":"《豆棚闲话·藩伯子散宅兴家》"},"similar":["快心满志","快心遂意","称心如意"],"usage":"作谓语、定语、状语；用于人的心情"},{"id":18821,"word":"快心遂意","pinyin":"kuài xīn suí yì","abbr":"kxsy","explanation":"犹言称心如意。形容心满意足，事情的发展完全符合心意。","source":{"text":"叫天抢地，忿恨一回，痛哭一回，咒咀一回，痴想一回，恨不得从半空中将之推一把头发揪在跟前，生生的咬嚼下肚，方得快心遂意。","book":"《豆棚闲话·介之推火封妒妇》"},"similar":["快心满志","快心满意","称心如意"],"usage":"作谓语、定语、状语；用于人的心情"},{"id":18822,"word":"快快活活","pinyin":"kuài kuài huó huó","abbr":"kkhh","explanation":"指人感觉高兴快乐。","source":{"text":"怎如得吾兄大才，考了个案首，如今快快活活，只候抢元夺魁，吃鹿鸣宴了，怎得知小弟的苦。","book":"清·荑荻散人《玉娇梨》第十回"},"example":{"text":"我是老百姓，干吗不当个～的老百姓呐？","book":"王朔《空中小姐》"},"similar":["高高兴兴"],"usage":"作谓语、定语、状语；用于生活等"},{"id":18823,"word":"快意当前","pinyin":"kuài yì dāng qián","abbr":"kydq","explanation":"快意：爽快舒适。指痛快一时。","source":{"text":"快意当前，适观而已矣。","book":"《史记·李斯列传》"},"usage":"作谓语；指使眼前听的看的称心快意"},{"id":18824,"word":"快步流星","pinyin":"kuài bù liú xīng","abbr":"kblx","explanation":"形容步子跨得大，走得快。","source":{"text":"又等了一会儿，李七骑马回来了。只见他在府门外翻身下马，手提马鞭，快步流星进了里屋。","book":"单田芳《燕王扫北》第三十二回"},"example":{"text":"他～走向大会堂。"},"similar":["大步流星"],"usage":"作谓语、状语；形容走得快"},{"id":18825,"word":"快犊破车","pinyin":"kuài dú pò chē","abbr":"kdpc","explanation":"跑得快的牛犊会把车拉翻。比喻年轻气盛的人应当懂得克制。","source":{"text":"快牛为犊子时，多能破车，汝当小忍之。","book":"《晋书·石季龙载记》"},"usage":"作宾语；指应自我克制"},{"id":18826,"word":"快言快语","pinyin":"kuài yán kuài yǔ","abbr":"kyky","explanation":"说话和表达得清楚明确坦白。","example":{"text":"小心他的～把你噎死。"},"similar":["心直口快"],"usage":"作谓语、定语、宾语；指心直口快"},{"id":18827,"word":"快马一鞭","pinyin":"kuài mǎ yī biān","abbr":"kmyb","explanation":"跑得快的马只着一鞭就行。","source":{"text":"快马一鞭，快人一言。","book":"宋·释道原《景德传灯录》第六卷"},"example":{"text":"江涛就说：‘好汉子说话一言为定！’冯大狗说：‘～！’","book":"梁斌《红旗谱》第三卷"},"usage":"作宾语、分句；用于劝诫人"},{"id":18828,"word":"快马一鞭，快人一言","pinyin":"kuài mǎ yī biān，kuài rén yī yán","abbr":"kmybkryy","explanation":"跑得快的马只要抽一鞭就能跑到底，爽快的人一句话就能说清楚。","source":{"text":"快马一鞭，快人一言。有事何不出头来，无事各自珍重。","book":"宋·释道原《景德传灯录》卷六"}},{"id":18829,"word":"快马加鞭","pinyin":"kuài mǎ jiā biān","abbr":"kmjb","explanation":"跑得很快的马再加上一鞭子，使马跑得更快。比喻快上加快，加速前进。","source":{"text":"生僧快马随鞭影，宁作痴人记剑痕。","book":"宋·陆游《村居》诗"},"example":{"text":"何不快马加鞭，径赶至苍山，求取伯伯。","book":"明·徐姬《杀狗记》"},"similar":["马不停蹄","再接再厉"],"opposite":["老牛破车"],"usage":"作谓语、状语；指快上加快"},{"id":18830,"word":"念兹在兹","pinyin":"niàn zī zài zī","abbr":"nzzz","explanation":"念：思念；兹：此，这个。泛指念念不忘某一件事情。","source":{"text":"帝念哉！念兹在兹，释兹在兹。名言兹在兹，允出兹在兹，惟帝念功。","book":"《尚书·大禹漠》"},"example":{"text":"他们和Ｆ总长，都“～”，在尘埃中间和破纸旁边离不开。","book":"鲁迅《而已集·谈所谓“大内档案”》"},"similar":["念念不忘","没齿难忘"],"usage":"作谓语、定语、状语；用于书面语"},{"id":18831,"word":"念念不忘","pinyin":"niàn niàn bù wàng","abbr":"nnbw","explanation":"念念：时刻思念着。形容牢记于心，时刻不忘。","source":{"text":"言其于忠信笃敬，念念不忘。","book":"《朱子全书·论语》"},"example":{"text":"此吾所以感刻于心，而～者也。","book":"清·无名氏《杜诗言志》卷三"},"similar":["念兹在兹","朝思暮想","刻骨铭心"],"opposite":["置之不理","置之度外","置若罔闻"],"usage":"作谓语、宾语、状语；指时刻挂在心上"},{"id":18832,"word":"念念不舍","pinyin":"niàn niàn bù shě","abbr":"nnbs","explanation":"念念：一遍遍地思念。时刻思念，永不忘记。","source":{"text":"立坐食息，念念不舍。","book":"梁启超《节本明儒学案·忠宪高景逸先生攀龙》"},"similar":["念念不忘"],"usage":"作谓语、宾语、状语；指时刻挂在心上"},{"id":18833,"word":"念念不释","pinyin":"niàn niàn bù shì","abbr":"nnbs","explanation":"念念：时刻思念着。形容牢记于心，时刻不忘。","source":{"text":"丞相安图素闻先生名，心慕之，乃就访于行馆。及还，心悦诚服，念念不释者累日。","book":"元·苏天爵《元朝名臣事略·左丞许文正公》"},"example":{"text":"告诉你罢，我第一次碰到你以后，倒常常想你，～地恨你，可惜我没有看表，计算时间。","book":"钱钟书《围城》第五章"}},{"id":18834,"word":"念念有词","pinyin":"niàn niàn yǒu cí","abbr":"nnyc","explanation":"念念：不停地念诵。旧指迷信的人祈祷时不停地念着口语，以通神灵。现多用来形容人嘟嘟囔囔说个不停。","source":{"text":"贺统军见折了两个兄弟，便口中念念有词，作起妖法。","book":"明·施耐庵《水浒全传》第八十六回"},"example":{"text":"至三更时，仗剑步罡，焚符一道，口中～，把令牌一拍，只见李邕忽从壁间步出。","book":"清·禇人获《隋唐演义》第八十四回"},"similar":["振振有词","涛涛不绝"],"opposite":["默不做声","沉默寡言"],"usage":"作谓语；含有讽刺诙谐意味"},{"id":18835,"word":"念旧怜才","pinyin":"niàn jiù lián cái","abbr":"njlc","explanation":"旧：老交谊；怜：怜爱。思念旧谊，爱惜贤才。","source":{"text":"方知大君子之念旧怜才，迥出寻常万万。","book":"清·袁枚《小仓山房尺牍》第156首"},"usage":"作谓语、宾语；指为人"},{"id":18836,"word":"忸忸怩怩","pinyin":"niǔ niǔ ní ní","abbr":"nnnn","explanation":"形容羞愧或不大方的样子。","example":{"text":"她～地走了出来。"},"opposite":["大大方方"],"usage":"作谓语、状语、定语；指不自然"},{"id":18837,"word":"忸怩不安","pinyin":"niǔ ní bù ān","abbr":"nnba","explanation":"忸怩：羞惭的样子。不好意思。心里慌乱。","source":{"text":"在屠维岳的锋芒逼人的眼光下，这张长方脸儿上渐渐显现了忸怩不安的气色。","book":"茅盾《子夜》七"},"example":{"text":"他说话忸怩不安地象一个大姑娘似的。"},"similar":["扭扭捏捏","忸怩作态"],"opposite":["大大方方"],"usage":"作谓语、状语；形容人羞涩的样子"},{"id":18838,"word":"忸怩作态","pinyin":"niǔ ní zuò tài","abbr":"nnzt","explanation":"忸怩：羞惭的样子。形容不自然，不大方，含羞做作的样子。","source":{"text":"倘使小说不能作为我作战的武器，我何必化那么多的功夫转弯抹角、忸怩作态，供人欣赏来换取作家的头衔呢？","book":"巴金《谈〈春〉》"},"example":{"text":"你不要忸怩作态好不好。"},"similar":["惺惺作态","矫柔造作"],"opposite":["大大方方"],"usage":"作谓语、定语；指故意做作"},{"id":18839,"word":"忻忻得意","pinyin":"xīn xīn dé yì","abbr":"xxdy","explanation":"心情愉快，自觉得意。","source":{"text":"那老畜主不晓的这话是笑他，反忻忻得意。","book":"清·吴敬梓《儒林外史》第二十四回"},"example":{"text":"那些小旦，取在十名前的，他相与的大老官来看了榜，都～。","book":"清·吴敬梓《儒林外史》第三十回"},"similar":["欣欣自得"],"usage":"作谓语、定语、状语；用于人的心情等"},{"id":18840,"word":"忽冷忽热","pinyin":"hū lěng hū rè","abbr":"hlhr","explanation":"指时而冷静，时而感情冲动，情绪不稳定。","source":{"text":"研究是要用理智，要冷静的，而创作须情感，至少总得发点热，于是忽冷忽热，弄得头昏。","book":"鲁迅《而已集·读书杂谈》"},"example":{"text":"他有～的毛病。"},"usage":"作谓语、定语；指情绪不稳定"},{"id":18841,"word":"忽忽不乐","pinyin":"hū hū bù lè","abbr":"hhbl","explanation":"忽忽：心中空虚恍惚的情态。形容若有所失而不高兴的样子。","source":{"text":"三十五年冬，复朝。上疏欲留，上弗许。归国，意勿勿不乐。","book":"《史记·梁孝王世家》"},"example":{"text":"秦少游谪古藤，意～。","book":"宋·曾敏行《独醒杂志》卷五"},"similar":["闷闷不乐"],"usage":"作谓语、定语；指失意的样子"},{"id":18842,"word":"忽忽如狂","pinyin":"hū hū rú kuáng","abbr":"hhrk","explanation":"忽忽：形容印象模糊或见不真切。恍恍忽忽，如同神经错乱似的。","source":{"text":"陵始降时，忽忽如狂，自痛负汉。","book":"东汉·班固《汉书·李广苏建传》"},"usage":"作谓语、定语；用于书面语"},{"id":18843,"word":"忽隐忽现","pinyin":"hū yǐn hū xiàn","abbr":"hyhx","explanation":"灯光等的闪烁时而消失时而出现。","source":{"text":"只见里面轻云冉冉，薄雾漫漫，远峰忽隐忽现，疏林旋露旋藏。","book":"清·李汝珍《镜花缘》第98回"},"example":{"text":"我看到了～的海市蜃楼。"},"similar":["若隐若现"],"usage":"作谓语、定语；指灯光或远处的物体"},{"id":18844,"word":"忾然叹息","pinyin":"kài rán tàn xī","abbr":"krtx","explanation":"忾：叹息，感慨。感慨叹息。","source":{"text":"见魏武帝遗令，忾然叹息，伤怀者久之。","book":"晋·陆机《吊魏武帝文》"},"similar":["慨然长叹"],"usage":"作谓语、状语；用于处事"},{"id":18845,"word":"忿不顾身","pinyin":"fèn bù gù shēn","abbr":"fbgs","explanation":"奋勇向前，不考虑个人安危。同“奋不顾身”。","source":{"text":"林兄因感世子之情，唐兄只知惟义是趋，都是忿不顾身，竟将王宫内院视为儿戏。","book":"《镜花缘》第三七回"},"similar":["奋不顾身"],"opposite":["贪生怕死"],"usage":"作谓语、定语、状语；指勇往直前"},{"id":18846,"word":"忿世嫉俗","pinyin":"fèn shì jí sú","abbr":"fsjs","explanation":"有正义感的人对黑暗的现实社会和不合理的习俗表示愤恨、憎恶。同“愤世嫉俗”。","source":{"text":"自尊至者，不平恒继之，忿世嫉俗，发为巨震，与对跖之徒争衡。","book":"鲁迅《坟·摩罗诗力说》"},"similar":["愤世嫉俗"],"usage":"作谓语、定语；指憎恨世俗"},{"id":18847,"word":"忿忿不平","pinyin":"fèn fèn bù píng","abbr":"ffbp","explanation":"心中不服，感到气愤。同“愤愤不平”。","source":{"text":"此时过往人众，见齐德受亏，俱忿忿不平。","book":"《禅真逸史》第一回"},"example":{"text":"高战也是～，点点头。","book":"古龙《长干行》三"},"similar":["愤愤不平"],"usage":"作谓语、状语、定语；指心中不服"},{"id":18848,"word":"忿火中烧","pinyin":"fèn huǒ zhōng shāo","abbr":"fhzs","explanation":"犹言怒火中烧。","source":{"text":"甲词益狎逼。张忿火中烧，反刀直出，剁甲中颅。","book":"清·蒲松龄《聊斋志异·张鸿渐》"},"usage":"作谓语、定语；用于人愤怒时"},{"id":18849,"word":"忿然作色","pinyin":"fèn rán zuò sè","abbr":"frzs","explanation":"由于愤怒而变了脸色。","source":{"text":"田忌忿然作色：‘此六者，皆善者所用，而子大夫曰非其急者也。然则其急者何也？’","book":"《孙膑兵法·威王问》"},"example":{"text":"王者贵乎？士贵乎？”（晋·皇甫谧《高士传·颜斶》","book":"王～，曰"},"similar":["大发雷霆","横眉立目","怒气冲天"],"opposite":["心平气和","平心静气","和颜悦色"],"usage":"作谓语、状语；指人发怒"},{"id":18850,"word":"怀乡之情","pinyin":"huái xiāng zhī qíng","abbr":"hxzq","explanation":"怀：怀念；乡：故土，家乡。怀念故乡的情感。","source":{"text":"悟戍卒之言，断怀土之情，高四皓之名，割肌肤之爱。","book":"汉·班彪《王命论》"},"example":{"text":"次日谭绍闻上碧草轩用功，智周万说了～，回家一望，改日仍来。","book":"清·李绿园《歧路灯》第五十六回"}},{"id":18851,"word":"怀冤抱屈","pinyin":"huái yuān bào qū","abbr":"hybq","explanation":"心中有冤屈。","source":{"text":"所欲既多，理无悉当，怀冤抱屈，非止百千。","book":"南朝·梁·沈约《上言宜校勘谱籍》"},"similar":["含冤负屈"],"usage":"作谓语；指心中有冤屈"},{"id":18852,"word":"怀刑自爱","pinyin":"huái xíng zì ài","abbr":"hxza","explanation":"刑：法度。指心中有法度，办事有分寸，不做违法的事，能够自重自爱。","source":{"text":"君子怀刑，小人怀惠。","book":"《论语·里仁》"}},{"id":18853,"word":"怀刺不适","pinyin":"huái cì bù shì","abbr":"hcbs","explanation":"刺：名贴，名片；怀刺：怀藏名片。怀中准备好名片想去求见贤人，但却无处可投。指很想结识名人，但却找不到拜谒的理想对象。","source":{"text":"建安初，来游许下，始达颖川，乃阴怀一刺，既而无所之适，至于刺字漫灭。","book":"《后汉书·祢衡传》"}},{"id":18854,"word":"怀刺漫灭","pinyin":"huái cì màn miè","abbr":"hcmm","explanation":"刺：名贴，名片；怀刺：怀藏名片。怀中准备好名片想去求见贤人，但却无处可投。指很想结识名人，但却找不到拜谒的理想对象。","source":{"text":"建安初，来游许下，始达颖川，乃阴怀一刺，既而无所之适，至于刺字漫灭。","book":"《后汉书·祢衡传》"},"example":{"text":"若白白说些瞻依暱就话头，就是司空见惯矣，不如学祢正平～。","book":"清·李绿园《歧路灯》第七回"},"usage":"作宾语、定语；用于为人","story":["东汉时期，平原郡人祢衡，字正平，年轻时十分有才华与文采，性情高傲与刚强，喜欢矫时慢物，少与人交往。兴平年间在荆州避难，建安年初，到都城许昌游历。刚到颍川时，朋友给他一个大人物的名帖，祢衡揣在身上，直到名帖字迹模糊也没去找他"]},{"id":18855,"word":"怀古伤今","pinyin":"huái gǔ shāng jīn","abbr":"hgsj","explanation":"怀念过去，哀叹现在。指一种没落、倒退、悲观的思想情绪。","source":{"text":"现在是既不夸自己，也不信国联，改为一味求神拜佛，怀古伤今了。","book":"鲁迅《中国人失掉自信力了吗》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":18856,"word":"怀土之情","pinyin":"huái tǔ zhī qíng","abbr":"htzq","explanation":"怀：怀念；土：故土，家乡。怀念故乡的情感。","source":{"text":"悟戍卒之言，断怀土之情，高四皓之名，割肌肤之爱。","book":"汉·班彪《王命论》"},"usage":"作宾语；指怀念故乡的情感"},{"id":18857,"word":"怀安丧志","pinyin":"huái ān sàng zhì","abbr":"hasz","explanation":"怀安：贪图安逸。贪图安逸会丧失志气。","source":{"text":"君王其谓午怀怀乎。","book":"《左传·襄公十八年》"}},{"id":18858,"word":"怀安败名","pinyin":"huái ān bài míng","abbr":"habm","explanation":"怀安：心里想着安逸；名：名声。一心贪图安逸则会败坏自己的声誉。","source":{"text":"怀与安，实败名。","book":"春秋·鲁·左丘明《左传·僖公三十三年》"},"example":{"text":"积微伤行，～。","book":"汉·王符《潜夫论·徐录》"},"usage":"作宾语、定语；用于劝诫人"},{"id":18859,"word":"怀宝迷邦","pinyin":"huái bǎo mí bāng","abbr":"hbmb","explanation":"怀宝：具有才德；迷邦：让国家迷乱。旧指有才德而不出来为国家效力。","source":{"text":"怀其宝而迷其邦，可谓仁乎？","book":"《论语·阳货》"},"example":{"text":"老汉常听得秀才每说道：“幼而学，壮而行，～，谓之不仁。”","book":"《琵琶记》第四出"},"similar":["怀才不遇","怀道迷邦"],"usage":"作谓语；指有才德而不为国家所用"},{"id":18860,"word":"怀山襄陵","pinyin":"huái shān xiāng líng","abbr":"hsxl","explanation":"怀：包围；襄：上升至高处；陵：大土山。大水包围山岳，漫过丘陵。形容水势很大或洪水泛滥。","source":{"text":"荡荡怀山襄陵，浩浩浮天。","book":"《尚书·尧典》"},"example":{"text":"譬如洪水横行，～。","book":"明·张岱《皇华考序》"},"usage":"作谓语、定语；用于洪水"},{"id":18861,"word":"怀德畏威","pinyin":"huái dé wèi wēi","abbr":"hdww","explanation":"怀德：心中怀有感恩戴德之情。指对君王或上司既感激而又惧怕其威严。","source":{"text":"怀德畏威，向风请顺。","book":"《北齐书·文宣帝纪》"},"example":{"text":"上践阼，豁达大度，推赤心以待之，繇是诸路节将～，不敢跋扈。","book":"宋·邵伯温《闻见前录》卷七"},"similar":["恩威并用"],"usage":"作谓语、定语；用于书面语"},{"id":18862,"word":"怀恨在心","pinyin":"huái hèn zài xīn","abbr":"hhzx","explanation":"把怨恨藏在心里。形容对人记下仇恨，以伺机报复。","source":{"text":"知县听玉姐说了一会，叫：‘皮氏，想你见那男子弃旧迎新，你怀恨在心，药死亲夫，此情理或有之。’","book":"明·冯梦龙《警世通言》第24回"},"example":{"text":"由于中断了她与拉尔夫的友谊交往而对他～。"},"similar":["咬牙切齿"],"opposite":["不计前嫌"],"usage":"作谓语；指记仇"},{"id":18863,"word":"怀恶不悛","pinyin":"huái è bù quān","abbr":"hebq","explanation":"悛：改过，悔过。有邪恶之心，但不思悔改。","source":{"text":"而彼怀恶不悛，寻事侵轶，背言负信，窃邑藏奸。","book":"《周书·武帝纪下》"},"similar":["怙恶不悛"],"usage":"作谓语、宾语、定语；用于坏人"},{"id":18864,"word":"怀才不遇","pinyin":"huái cái bū yù","abbr":"hcby","explanation":"怀：怀藏；才：才能。胸怀才学但生不逢时，难以施展；多指屈居微贱而不得志。","source":{"text":"眼见别人才学万倍不如他的，一个个出身显通，享用爵禄偏则自家怀才不遇。","book":"明·冯梦龙《喻世明言》卷五"},"example":{"text":"高曾祖考，俱是～的秀才。","book":"清·夏敬渠《野叟曝言》第一回"},"similar":["黄钟毁弃","大材小用"],"opposite":["脱颖而出","怀宝迷邦"],"usage":"作谓语、宾语、定语；指人郁郁不得志"},{"id":18865,"word":"怀才抱器","pinyin":"huái cái bào qì","abbr":"hcbq","explanation":"唐·赵璘《因话录》四：“夫文章之称，岂为缁徒设耶？讹亦甚矣！有似昔岁，德宗搜访怀才抱器、不求闻达者。”","source":{"text":"夫文章之称，岂为缁徒设耶？讹亦甚矣！有似昔岁，德宗搜访怀才抱器、不求闻达者。","book":"唐·赵璘《因话录》四"},"example":{"text":"其～沦于下位及高年不仕、德行可称者，所在以闻。","book":"宋·李焘《续资治通鉴长编·真宗大中祥符元年》"},"similar":["怀材抱器"],"usage":"作谓语、定语；用于书面语"},{"id":18866,"word":"怀才抱德","pinyin":"huái cái bào dé","abbr":"hcbd","explanation":"既有才学，又有德行。","source":{"text":"怕有那山间林下，隐迹埋名，怀才抱德。","book":"元·关汉卿《陈母教子》楔子"},"example":{"text":"其～之贤，耻与并进，甘隐山林而不起。","book":"明·余继登《典故继闻》卷二"},"similar":["怀材抱德","怀才抱器"],"usage":"作谓语、定语；用于书面语"},{"id":18867,"word":"怀敌附远","pinyin":"huái dí fù yuǎn","abbr":"hdfy","explanation":"怀：来，使亲近。对敌人采取怀柔政策，使远方之人来归附。","source":{"text":"怀敌附远，何招而不至。","book":"汉·贾谊《论积贮疏》"},"usage":"作定语；指安抚政策"},{"id":18868,"word":"怀材抱器","pinyin":"huái cái bào qì","abbr":"hcbq","explanation":"犹言德才兼备。既有好的思想品质，又有工作的才干和能力。材，才能；器，器度。","source":{"text":"则天垂拱元年，初置匦使之制……东曰延恩匦，怀材抱器，希于闻达者投之。","book":"唐·封演《封氏闻见记·匦使》"},"example":{"text":"右臣伏睹赦书节文，应天下～，或淹下位，或滞草莱，委逐处具事由闻奏。","book":"宋·范仲淹《举张问孙复状》"},"similar":["怀才抱器"],"usage":"作谓语、定语；用于书面语"},{"id":18869,"word":"怀材抱德","pinyin":"huái cái bào dé","abbr":"hcbd","explanation":"抱：胸怀。既有才学，又有德行。","source":{"text":"因为山间林下，多有怀材抱德之人，不肯进取功名，今着小官五路采访。","book":"元·秦简夫《剪发待宾》第一折"},"similar":["怀才抱德"],"usage":"作谓语、定语；用于书面语"},{"id":18870,"word":"怀柔天下","pinyin":"huái róu tiān xià","abbr":"hrtx","explanation":"怀柔：旧指统治者用政治手腕笼络人心，使之归顺。使天下归服。","source":{"text":"其怀柔天下也，犹惧有外侮。","book":"《左传·僖公二十四年》"}},{"id":18871,"word":"怀珠抱玉","pinyin":"huái zhū bào yù","abbr":"hzby","explanation":"珠、玉：比喻美德和才华。比喻人具有高尚的品德和杰出的才能。","source":{"text":"怀珠抱玉，有殁世而名不称者，可为长太息，孰过于斯。","book":"《梁书·刘显传》"},"similar":["怀珠韫玉"],"usage":"作宾语、定语；用于比喻句"},{"id":18872,"word":"怀珠韫玉","pinyin":"huái zhū yùn yù","abbr":"hzyy","explanation":"用以比喻怀藏才德。","source":{"text":"石韫玉而山辉，水怀珠而川媚。","book":"晋·陆机《文赋》"},"example":{"text":"幸自江湖可避人，～冷无尘。","book":"宋·杨万里《食老菱有感》诗"},"similar":["怀珠抱玉"],"usage":"作宾语、定语；用于比喻句"},{"id":18873,"word":"怀瑾握瑜","pinyin":"huái jǐn wò yú","abbr":"hjwy","explanation":"怀：怀藏；握：手握；瑾、瑜：美玉，比喻美德。比喻人具有纯洁高尚的品德。","source":{"text":"怀瑾握瑜兮，穷不知所示。","book":"战国·楚·屈原《九章·怀沙》"},"example":{"text":"焦心以问治，降意以下贤，而士之～者，纷纷籍籍，云翔蜂起，奔走自效。","book":"宋·晁补之《鸡肋集·上杭州教官品穆仲书》"},"usage":"作主语、谓语；比喻人的品德高尚"},{"id":18874,"word":"怀璧为罪","pinyin":"huái bì wéi zuì","abbr":"hbwz","explanation":"璧：宝玉。身藏宝玉，因此获罪。比喻有才能而遭忌妒、迫害。","source":{"text":"本无拒诸君之心，而所受遂多。念单车远行，将以怀璧为罪，愿宾客为之计。","book":"晋·陈寿《三国志·魏志·华歆传》"},"similar":["怀璧其罪"],"usage":"作谓语、定语；比喻有才能而遭忌妒"},{"id":18875,"word":"怀璧其罪","pinyin":"huái bì qí zuì","abbr":"hbqz","explanation":"怀：怀藏。身藏璧玉，因此获罪。原指财能致祸。后也比喻有才能而遭受忌妒和迫害。","source":{"text":"匹夫无罪，怀璧其罪。","book":"《左传·桓公十年》"},"example":{"text":"修贡之余远争寄，～渠敢当。","book":"宋·张扩《谢人惠团茶》诗"},"similar":["怀璧之罪"],"opposite":["任贤使能"],"usage":"作谓语、定语；比喻有才能而遭忌妒、迫害","story":["战国时期，齐国臣子张丑在燕国当人质，燕王要杀他，他乘机逃走，在燕国边境被守卫抓住。张丑心生一计，说燕王要杀他是因为他藏有宝珠，燕王想占为己有，如果你不放行，就说你吞下了宝珠，燕王会把你剖腹的，守卫只好放行"]},{"id":18876,"word":"怀真抱素","pinyin":"huái zhē bào sù","abbr":"hzbs","explanation":"真：纯真；素：质朴的本色。指品德高洁，质朴无华。","source":{"text":"其有怀真抱素，志行清白，恬退自守，不交当世，或识通古今，才经军国，奉公廉直，高誉在民，具以名奏。","book":"《宋书·孝武帝纪》"},"similar":["怀质抱真"],"usage":"作谓语、宾语、定语；用于人的人品等"},{"id":18877,"word":"怀着鬼胎","pinyin":"huái zhe guǐ tāi","abbr":"hzgt","explanation":"比喻藏着不可告人的心事。","source":{"text":"盒子藏的是储君，有肚皮里怀的是鬼胎。","book":"元·无名氏《抱妆盒》第二折"},"example":{"text":"袭人等怀着鬼胎，又不敢去招惹他，恐他生气。","book":"清·曹雪芹《红楼梦》第九十五回"},"similar":["心怀鬼胎"],"opposite":["光明磊落"],"usage":"作谓语；指居心不良"},{"id":18878,"word":"怀禄贪势","pinyin":"huái lù tān shì","abbr":"hlts","explanation":"指留恋官位，贪图权势。","source":{"text":"怀禄贪势，不能自退。","book":"《汉书·杨敞传》附《杨恽报孙会宗书》"}},{"id":18879,"word":"怀觚握椠","pinyin":"huái gū wò qiàn","abbr":"hgwq","explanation":"常带书写工具，以备写作的需要。同“怀铅提椠”。","source":{"text":"海内之士，怀觚握椠之伦，介景者锵羊，祝延者■（氵從）萃。","book":"清·龚自珍《〈阮尚书年谱〉第一序》"},"similar":["怀铅握椠","怀铅提椠"],"usage":"作谓语、定语；用于书面语"},{"id":18880,"word":"怀诈暴憎","pinyin":"huái zhà bào zēng","abbr":"hzbz","explanation":"暴：显露。心怀欺诈，外露憎恨。形容人阴险凶恶。","source":{"text":"讼者平，赋者均，老弱无怀诈暴憎。","book":"唐·柳宗元《送薛存义序》"}},{"id":18881,"word":"怀质抱真","pinyin":"huái zhì bào zhēn","abbr":"hzbz","explanation":"指人格和品德纯洁高尚，质朴无华。同“怀真抱素”。","source":{"text":"其有勇退忘进，怀质抱真者，选部或以未经朝谒，难于进用。","book":"《梁书·武帝纪上》"},"similar":["怀真抱素"],"usage":"作谓语、宾语、定语；用于人的人品等"},{"id":18882,"word":"怀远以德","pinyin":"huái yuǎn yǐ dé","abbr":"hyyd","explanation":"怀远：笼络安抚远方的人。旧指用恩惠、德政去安抚边远地区的民众。","source":{"text":"招携以礼，怀远以德。","book":"《左传·僖公七年》"}},{"id":18883,"word":"怀道迷邦","pinyin":"huái dào mí bāng","abbr":"hdmb","explanation":"犹言怀宝迷邦。旧指有才德而不出来为国家效力。","source":{"text":"楚乃贻之书，劝以今尧舜之世，胡为怀道迷邦。","book":"《晋书·董京传》"},"similar":["怀宝迷邦"],"usage":"作谓语；指有才德而不为国家所用"},{"id":18884,"word":"怀金垂紫","pinyin":"huái jīn chuí zǐ","abbr":"hjcz","explanation":"形容显贵。金，金印；紫，系印的紫色丝带。","source":{"text":"衍少事名贤，经历显位，怀金垂紫，揭节奉使。","book":"南朝·宋·范晔《后汉书·冯衍传下》"},"example":{"text":"他盼望会有～的一天。"},"similar":["怀黄佩紫","怀金拖紫"],"usage":"作谓语、定语；指身居高位"},{"id":18885,"word":"怀金拖紫","pinyin":"huái jīn tuō zǐ","abbr":"hjtz","explanation":"形容显贵。同“怀金垂紫”。","source":{"text":"复得扶老携幼，生出狱户，怀金拖紫，退就散辈。","book":"晋·陆机《谢平原内史表》"},"similar":["怀金垂紫","怀黄佩紫"],"usage":"作谓语、定语；指身居高位"},{"id":18886,"word":"怀铅吮墨","pinyin":"huái qiān shǔn mò","abbr":"hqsm","explanation":"怀铅：带着铅粉笔，以备涂改；吮墨：用口含毛笔尖。形容写作时构思的举动和神态。","source":{"text":"俾尔怀铅吮墨者，抱篇章而景慕，映余晖以自烛。","book":"南朝·梁·钟嵘《诗品·上·魏陈思王植》"}},{"id":18887,"word":"怀铅提椠","pinyin":"huái qiān tí qiàn","abbr":"hqtq","explanation":"怀：怀藏；铅：铅粉；提：手里拿着；椠：古代书写用的木片。常带书写工具，以备写作的需要。","source":{"text":"杨子云好事，常怀铅提椠，从诸计吏访殊方绝域四方之语。","book":"《西京杂记》卷三"},"example":{"text":"如曰高标扬己，则失不佞～，辛苦迻译之本心矣。","book":"清·严复《译天演论例言》"},"similar":["怀铅握椠","怀觚提椠"],"usage":"作谓语；指常带书写工具，以备写作的需要"},{"id":18888,"word":"怀铅握椠","pinyin":"huái qiān wò qiàn","abbr":"hqwq","explanation":"常带书写工具，以备写作的需要。同“怀铅提椠”。","source":{"text":"自古探穴藏山之士，怀铅握椠之客，何尝不征求异说，采摭群言。","book":"唐·刘知幾《史通·采撰》"},"similar":["怀觚握椠","怀铅提椠","怀铅握素"],"usage":"作谓语、定语；用于书面语"},{"id":18889,"word":"怀铅握素","pinyin":"huái qiān wò sù","abbr":"hqws","explanation":"铅：石墨笔。常带书写工具，以备写作的需要。","source":{"text":"便宜选陈农之才，采河间之阙，怀铅握素，汗简杀青。","book":"南朝·梁·任昉《为梁武帝集坟籍令》"},"similar":["怀铅握椠","怀觚握椠","怀铅提椠"],"usage":"作谓语、定语；用于书面语"},{"id":18890,"word":"怀银纡紫","pinyin":"huái yín yū zǐ","abbr":"hyyz","explanation":"指显贵。银，银印；紫，紫绶。汉制，相国、丞相、太尉、公侯皆紫绶；秩二千石皆银印。","source":{"text":"怀银纡紫，未必稷契之才。积金累玉，未必陶朱之智。","book":"汉·王充《论衡·命禄》"},"similar":["怀金垂紫","怀黄佩紫"],"usage":"作谓语、定语；指身居高位"},{"id":18891,"word":"怀黄佩紫","pinyin":"huái huáng pèi zǐ","abbr":"hhpz","explanation":"指怀里揣着金印，腰间佩着紫绶。指身居高官显位。同“佩紫怀黄”。","source":{"text":"，赞帷幄之谋；乘轺建节，奉疆埸之任。","book":"《梁书·陈伯之传》"},"example":{"text":"《梁书·陈伯之传》：“～，赞帷幄之谋。”"},"similar":["怀金垂紫","怀金拖紫"],"usage":"作谓语、定语；指身居高位"},{"id":18892,"word":"怀黄握白","pinyin":"huái huáng wò bái","abbr":"hhwb","explanation":"指携带着钱财。黄，指黄金；白，指白银。","source":{"text":"于是莫不蒙尘触雨，戴霜履冰，怀黄握白，提清絜肥，以赴邪径之近易，规朝种而暮获矣。","book":"晋·葛洪《抱朴子·勖学》"},"usage":"作谓语、宾语；指带钱"},{"id":18893,"word":"怅怅不乐","pinyin":"chàng chàng bù lè","abbr":"ccbl","explanation":"怅怅：失意的样子。形容懊恼不快乐的样子。","source":{"text":"秦钟本自怯弱，又带病未痊，受了笞杖，今见老父气死，悔痛无改，又添了许多病症。因此宝玉心中怅怅不乐。","book":"清·曹雪芹《红楼梦》第十六回"}},{"id":18894,"word":"怅然自失","pinyin":"chàng rán zì shī","abbr":"crzs","explanation":"怅然：因不如意而感到不痛快。形容神志迷乱，像失去什么似的样子。","source":{"text":"殷怅然自失。","book":"南朝·宋·刘义庆《世说新语·雅量》"},"example":{"text":"忠泣诉父名，主人～。","book":"清·蒲松龄《聊斋志异·牛成章》"},"similar":["怅然若失"],"opposite":["若无其事"],"usage":"作谓语、定语；形容心情愁苦"},{"id":18895,"word":"怅然若失","pinyin":"chàng rán ruò shī","abbr":"crrs","explanation":"怅然：形容不如意、不痛快。象失去什么似的烦恼不快。","source":{"text":"殷怅然自失。","book":"南朝·宋·刘义庆《世说新语·雅量》"},"example":{"text":"忠泣诉父名，主人～。","book":"清·蒲松龄《聊斋志异·牛成章》"},"similar":["闷闷不乐","若有所失","惊惶失措"],"opposite":["怡然自得","若无其事","泰然自若"],"usage":"作谓语、定语；形容心情愁苦","story":["晋代文人殷仲湛自认为很有文才，他把自己的得意之作拿给王恭看，满以为王恭会赞不绝口，夸奖自己一番。王恭看完后没有发表任何评论，只是用玉器压着。殷仲湛看到这种状况，像被泼了一盆凉水，心里很不是滋味"]},{"id":18896,"word":"怆地呼天","pinyin":"chuàng dì hū tiān","abbr":"cdht","explanation":"怆：悲伤，凄楚。悲痛地呼天喊地。形容极其悲痛绝望的神态。","source":{"text":"又延两日，夫妻相继而亡，二子呛地呼天，号啕痛哭。","book":"明·冯梦龙《醒世恒言》第十卷"},"similar":["呼天抢地"],"usage":"作谓语、状语；形容悲痛之极"},{"id":18897,"word":"怆天呼地","pinyin":"chuàng tiān hū dì","abbr":"cthd","explanation":"悲痛地呼天喊地。形容极其悲痛绝望的神态。同“怆地呼天”。","source":{"text":"生逼他出兵进城，以致堕敌人之计中，丧师败绩，害他不得为忠臣义士，真可叹真痛恨，怆天呼地而不已也！","book":"清·禇人获《隋唐演义》第九十回"},"similar":["怆地呼天"],"usage":"作谓语、状语；形容悲痛之极"},{"id":18898,"word":"怆然泪下","pinyin":"chuàng rán lèi xià","abbr":"crlx","explanation":"怆然：伤感的样子。伤感地流泪不止。形容非常悲痛。","source":{"text":"你我今生之时，处今之世，前不见古人，后不见来者，独立苍茫，怆然泪下。","book":"《中国现在记》楔子"},"similar":["怆然涕下"],"usage":"作谓语；指伤感"},{"id":18899,"word":"怆然涕下","pinyin":"chuàng rán tì xià","abbr":"crtx","explanation":"怆然：伤感的样子。伤感地涕泪流洒。","source":{"text":"前不见古人，后不见来者，念天地之悠悠，独怆然而涕下。","book":"唐·陈子昂《登幽州台歌》诗"},"example":{"text":"说到此，他～。"},"similar":["怆然泪下"],"usage":"作谓语；指伤感"},{"id":18900,"word":"怊怅若失","pinyin":"chāo chàng ruò shī","abbr":"ccrs","explanation":"怊怅：惆怅。形容人失意时感伤惆怅的情绪。","source":{"text":"悠悠忽忽，怊怅若失。","book":"战国·楚·宋玉《高唐赋》"}},{"id":18901,"word":"怊怊惕惕","pinyin":"chāo chāo tì tì","abbr":"cctt","explanation":"怊怊：怅惘；惕惕：忧惧。形容人忧愁感伤，失意惆怅。","source":{"text":"心怊怊而惕惕兮，志悯悯而绵绵。","book":"《魏书·阳尼传》附阳固《演赜赋》"}},{"id":18902,"word":"怏怏不乐","pinyin":"yàng yàng bù lè","abbr":"yybl","explanation":"怏怏：形容不满意的神情。心中郁闷，很不快活。","source":{"text":"此怏怏者非少主臣也。","book":"《史记·绛侯周勃世家》"},"example":{"text":"种～，然犹未深信其言，叹曰：“少伯何虑之过乎？”","book":"明·冯梦龙《东周列国志》第八十三回"},"similar":["怏怏不悦"],"opposite":["洋洋得意"],"usage":"作谓语、状语；指不快乐"},{"id":18903,"word":"怏怏不平","pinyin":"yàng yàng bù píng","abbr":"yybp","explanation":"因不满而心不平。","source":{"text":"贫无产业，每佣书养亲，怏怏不平。","book":"《隋书·虞世基传》"},"example":{"text":"［司马迁］甥杨恽以口语坐废。其友人孙会宗与书，戒以大臣废退、阖门皇惧之意。恽报书，委曲敷叙，其～之气宛然有外祖风致。","book":"宋·李楙《野客丛书·杨恽有外祖风》"},"usage":"作定语、状语；用于书面语"},{"id":18904,"word":"怏怏不悦","pinyin":"yàng yàng bù yuè","abbr":"yyby","explanation":"悦：愉悦，快乐。因不满意而很不快乐。","source":{"text":"其当职之人，已怏怏不悦，不肯同心以助其谋，协力以成事。","book":"宋·司马光《应诏论体要》"},"example":{"text":"他整天～的。"},"similar":["怏怏不乐"],"opposite":["得意洋洋"],"usage":"作谓语、状语；指不满"},{"id":18905,"word":"怏怏不服","pinyin":"yàng yàng bù fú","abbr":"yybf","explanation":"怏怏：形容不满意的神情。不满意，不服气。","source":{"text":"白起之迁，其意尚怏怏不服，有余言。","book":"《史记·白起王翦列传》"},"example":{"text":"邠府宿将史抗、温儒雅、庞仙鹤、张献明、李光逸功名素出怀光右，皆～。","book":"《资治通鉴·唐纪·代宗大历十四年》"}},{"id":18906,"word":"怒不可遏","pinyin":"nù bù kě è","abbr":"nbke","explanation":"遏：止。愤怒地难以抑制。形容十分愤怒。","source":{"text":"严惶怖求哀，知祥曰：‘众怒不可遏也！’遂辑下，斩之。","book":"《国语·周语下》：“民有怨乱，犹不可遏，而况神乎？”《资治通鉴·后唐明宗天成二年》"},"example":{"text":"贾大少爷正在自己动手掀王师爷的铺盖，被王师爷回来从门缝里瞧见了，顿时气愤填膺，～。","book":"清·李宝嘉《官场现形记》第二十七回"},"similar":["怒形于色"],"opposite":["喜不自胜","心平气和"],"usage":"作谓语、定语、状语；形容十分愤怒"},{"id":18907,"word":"怒从心上起","pinyin":"nù cóng xīn shàng qǐ","abbr":"ncxsq","explanation":"愤怒从心底而起。比喻愤怒到极点就会胆大得什么事都干得出来。","source":{"text":"这璜大奶奶不听则已，听了，怒从心上起。","book":"清·曹雪芹《红楼梦》第十回"},"example":{"text":"清·曹雪芹《红楼梦》第十回：“这璜大奶奶不听则已，听了，～。”"},"similar":["怒从心起","怒从心生"],"usage":"作谓语；指心中发怒"},{"id":18908,"word":"怒从心上起，恶向胆边生","pinyin":"nù cóng xīn shàng qǐ，è xiàng dǎn biān shēng","abbr":"ncxsqexdbs","explanation":"比喻愤怒到极点就会胆大得什么事都干得出来。也泛指恼怒到极点。","source":{"text":"朱温未听得万事俱休，才听得后，怒从心上起，恶向胆边生。","book":"《五代史平话·梁》"},"example":{"text":"正是仇人相见，分外眼红，登时～。","book":"清·文康《儿女英雄传》第18回"},"similar":["怒从心起，恶向胆生"],"usage":"作谓语、分句；指恼怒到极点"},{"id":18909,"word":"怒从心头起，恶向胆边生","pinyin":"nù cóng xīn tóu qǐ，è xiàng dǎn biān shēng","abbr":"ncxtqexdbs","explanation":"比喻愤怒到极点就会胆大得什么事都干得出来。也泛指恼怒到极点。","source":{"text":"朱温未听得万事俱休，才听得后，怒从心上起，恶向胆边生。","book":"《五代史平话》"}},{"id":18910,"word":"怒从心生","pinyin":"nù cóng xīn shēng","abbr":"ncxs","explanation":"愤怒从心底而起。比喻愤怒到极点就会胆大得什么事都干得出来。","source":{"text":"钟馗听说一个鬼字，怒从心生，拔剑就砍。","book":"《斩鬼传》第七回"},"similar":["怒从心起"],"usage":"作谓语；指心中发怒"},{"id":18911,"word":"怒从心起","pinyin":"nù cóng xīn qǐ","abbr":"ncxq","explanation":"愤怒从心底而起。比喻愤怒到极点就会胆大得什么事都干得出来。","source":{"text":"惠公在车上望见庆郑，怒从心起。","book":"明·冯梦龙《东周列国志》第31回"},"example":{"text":"曾朴《孽海花》第14回：“不觉～，恶向胆生，顾不得什么，一口气赶到客厅。”"},"similar":["怒从心上起"],"usage":"作谓语；指心中发怒"},{"id":18912,"word":"怒从心起，恶向胆生","pinyin":"nù cóng xīn qǐ，è xiàng dǎn shēng","abbr":"ncxqexds","explanation":"恶：凶暴。比喻愤怒到极点就会胆大得什么事都干得出来。也泛指恼怒到极点。","source":{"text":"不觉怒从心起，恶向胆生，顾不得什么，一口气赶到客厅。","book":"曾朴《孽海花》第14回"},"similar":["怒从心上起，恶向胆边生"],"usage":"作谓语、分句；指恼怒到极点"},{"id":18913,"word":"怒发冲冠","pinyin":"nù fà chōng guān","abbr":"nfcg","explanation":"指愤怒得头发直竖，顶着帽子。形容极端愤怒。","source":{"text":"相如因持璧却立倚柱，怒发上冲冠。","book":"《庄子·盗跖》：“盗跖闻之大怒，目如明星，发上指冠。”《史记·廉颇蔺相如列传》"},"example":{"text":"～，凭栏处，潇潇雨歇。","book":"宋·岳飞《满江红》词"},"similar":["大发雷霆","怒形于色","怒火中烧"],"opposite":["喜不自胜","欣喜若狂","喜形于色"],"usage":"作谓语、宾语、定语、补语；形容极端愤怒","story":["战国时期，秦昭襄王为得到赵国的和氏璧，便允诺赵惠王以15座城池交换。迫于秦国势力，赵王派蔺相如带和氏璧去交换，秦王闭口不谈城池的事，蔺相如用计夺回和氏璧，并怒发冲冠地说：“如果不以城池交换，我就与和氏璧同归于尽。”"]},{"id":18914,"word":"怒容可掬","pinyin":"nù róng kě jū","abbr":"nrkj","explanation":"掬：两手捧取。形容一脸怒气，让人觉得可怕。","source":{"text":"方欲启问，只见那义士怒容可掬，飕地掣出匕首。","book":"明·冯梦龙《醒世恒言》第30卷"},"example":{"text":"素姐～，只说：‘你不叫进来便罢，只是由他。’","book":"清·西周生《醒世姻缘传》第95回"},"opposite":["笑容可掬"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":18915,"word":"怒容满面","pinyin":"nù róng mǎn miàn","abbr":"nrmm","explanation":"满脸怒气。","source":{"text":"老残看刚弼怒容满面，连声吆喝，却有意呕着他顽，便轻轻的说道：‘你先莫问我是什么人，且让我说两句话。’","book":"清·刘鹗《老残游记》第17回"},"example":{"text":"他仍然～，因为没有得到批准。"},"similar":["怒形于色"],"usage":"作谓语、状语；指人发怒"},{"id":18916,"word":"怒形于色","pinyin":"nù xíng yú sè","abbr":"nxys","explanation":"形：显露；色：脸色。内心的愤怒在脸上显露出来。","source":{"text":"绍兴二十一年，唐嘉猷为教授，既试，将揭榜，游进士福州人陈炎梦登大成殿，夫子赐之酒五樽。子夏怒形于色，举足蹴其二。","book":"宋·洪迈《夷坚志·丙志卷七·子夏蹴酒》"},"example":{"text":"曹沫右手按剑，左手揽桓公之袖，～。","book":"明·冯梦龙《东周列国志》第十八回"},"similar":["怒不可遏","怒目切齿","怒气冲天"],"opposite":["喜形于色","喜不自胜"],"usage":"作谓语、状语；指内心的愤怒在脸上显露出来"},{"id":18917,"word":"怒气冲冲","pinyin":"nù qì chōng chōng","abbr":"nqcc","explanation":"盛怒的样子。","source":{"text":"［钱同秀］一手将烟灯砸在地下，说道：‘好好，你们做了一路！’就怒气冲冲的出来上车。","book":"清·魏秀仁《花月痕》第十二回"},"example":{"text":"张学海不等汤阿英说完，就～地质问：‘陶阿毛有啥不同？他不也是工人吗？’","book":"周而复《上海的早晨》第一部九"},"similar":["怒气冲天"],"opposite":["喜气洋洋"],"usage":"作状语；指人盛怒的样子"},{"id":18918,"word":"怒气冲天","pinyin":"nù qì chōng tiān","abbr":"nqct","explanation":"怒气冲上天空。形容愤怒到极点。","source":{"text":"我和他有甚恩情相顾恋，待不沙又怕背了这恩人面，只落的嗔嗔忿忿，伤心切齿，怒气冲天。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"任大老爷见了，更加～。","book":"清·张春帆《宦海》第十三回"},"similar":["怒发冲冠"],"opposite":["欣喜若狂"],"usage":"作谓语、定语、状语；用于书面语"},{"id":18919,"word":"怒气冲霄","pinyin":"nù qì chōng xiāo","abbr":"nqcx","explanation":"形容愤怒到了极点。","source":{"text":"我怒气冲霄，恨秦桧专权宠。","book":"明·无名氏《精忠记·赴难》"},"example":{"text":"这冤仇逼得俺～。","book":"《逼上梁山》第三幕"},"similar":["怒气冲天"],"usage":"作谓语、定语、状语；用于书面语"},{"id":18920,"word":"怒气填胸","pinyin":"nù qì tián xiōng","abbr":"nqtx","explanation":"胸中充满了愤怒。形容愤怒到了极点。","source":{"text":"却说周瑜怒气填胸，坠于马下，左右急救归船。","book":"明·罗贯中《三国演义》第五十七回"},"example":{"text":"满屋里寻了一会，不见个踪迹，急的～。","book":"清·文康《儿女英雄传》第七回"},"similar":["义愤填膺"],"usage":"作谓语、状语；指十分愤怒"},{"id":18921,"word":"怒火中烧","pinyin":"nù huǒ zhōng shāo","abbr":"nhzs","explanation":"中；心中。怒火在心中燃烧。形容心中怀着极大的愤怒。","source":{"text":"虚舟相触何心在，怒火虽炎一响空。","book":"宋·王迈《臞轩集》"},"example":{"text":"这时见四个师弟非欲置自己和师父于死地，不由～。","book":"古龙《长干行》"},"similar":["怒不可遏","怒气冲天","怒形于色"],"opposite":["欣喜若狂","心花怒放","喜气洋洋"],"usage":"作谓语、宾语；用于激愤"},{"id":18922,"word":"怒火冲天","pinyin":"nù huǒ chōng tiān","abbr":"nhct","explanation":"形容愤怒之极，无法抑制。","source":{"text":"［程娘子］怒火冲天，不顾一切地冲向狗子拚命，却被狗子一把抓住。","book":"老舍《龙须沟》第一幕"},"example":{"text":"他登时～，霍地立起身来……一阵猛扫，把四五个敌人都打倒了。","book":"魏巍《东方》第五部第六章"},"similar":["怒气冲天","怒气冲霄"],"opposite":["欣喜若狂"],"usage":"作谓语、定语、状语；用于书面语"},{"id":18923,"word":"怒猊抉石，渴骥奔泉","pinyin":"nù ní mèi shí，kě jì bēn quán","abbr":"nnjskjbq","explanation":"猊：狻猊，即狮子；抉：踢开；骥：骏马。如愤怒的狮子踢开石头，口渴的骏马奔向泉水。形容书法遒劲奔放。","source":{"text":"尝书四十三幅屏，八体皆备，如怒猊抉石，渴骥奔泉。","book":"《唐书·徐浩传》"},"similar":["渴骥怒猊"],"usage":"作定语、分句；形容书法"},{"id":18924,"word":"怒猊渴骥","pinyin":"nù ní kě jì","abbr":"nnkj","explanation":"猊：狻猊，即狮子；骥：骏马。如愤怒的狮子撬扒石头，口渴的骏马奔向泉水。形容书法遒劲奔放。","source":{"text":"始，浩父峤之善书，以法授浩，益工。尝书四十二幅屏，八体皆备，草隶尤工，世状其法曰‘怒猊抉石，渴骥奔泉。’云","book":"《新唐书·徐浩传》"},"usage":"作宾语、定语；用于书法等"},{"id":18925,"word":"怒目切齿","pinyin":"nù mù qiè chǐ","abbr":"nmqc","explanation":"怒目：怒视的样子；切齿：咬紧牙齿。形容极其愤恨。","source":{"text":"闻吾风声，议其所以，乃奋袂攘衿，怒目切齿。","book":"晋·刘伶《酒德颂》"},"example":{"text":"谈到这些，壮族老人和两三个壮族年轻人都～。","book":"秦牧《壮族与我》"},"similar":["金刚怒目","咬牙切齿","怒不可遏"],"opposite":["喜笑颜开","眉开眼笑","喜不自胜"],"usage":"作谓语、定语、状语；形容愤恨之极"},{"id":18926,"word":"怒目戟指","pinyin":"nǔ mù jǐ zhǐ","abbr":"nmjz","explanation":"戟指：用食指和中指指着别人，象戟的形状。指着人，瞪着眼。形容大怒时斥责人的神态。"},{"id":18927,"word":"怒目横眉","pinyin":"nù mù héng méi","abbr":"nmhm","explanation":"耸起眉毛，瞪大眼睛。形容怒视的样子。","source":{"text":"横眉怒目强干嗔，便作阎浮有力神。祸福岂由泥捏汉，烧香代养弄蛇人。","book":"五代·后蜀·何光远《监戒录》引陈裕诗"},"example":{"text":"不一时，只听得院子里许多脚步响，早进来了～、挺胸凸肚的一群人。","book":"清·文康《儿女英雄传》第二十一回"},"similar":["横眉怒目"],"usage":"作谓语、定语；指人发怒的样子"},{"id":18928,"word":"怒目相视","pinyin":"nù mù xiāng shì","abbr":"nmxs","explanation":"彼此愤怒地看着对方。","example":{"text":"他们在门口～，我顿时明白了。"},"usage":"作谓语、定语；用于处事"},{"id":18929,"word":"怒目睁眉","pinyin":"nù mù zhēng méi","abbr":"nmzm","explanation":"瞪大眼睛，咬紧牙关。形容愤恨之极。","source":{"text":"但见赵云怒目睁眉，只待厮杀。","book":"明·罗贯中《三国演义》第55回"},"example":{"text":"咬牙切齿，～，抱拳裸袖，绰步撩衣，发狠上前。","book":"清·褚人获《隋唐演义》第12回"},"similar":["怒目切齿","怒眉睁目","咬牙切齿"],"opposite":["喜笑颜开","眉开眼笑","喜不自胜"],"usage":"作谓语、定语、状语；形容愤恨之极"},{"id":18930,"word":"怒目而视","pinyin":"nù mù ér shì","abbr":"nmes","explanation":"睁圆了眼睛瞪视着。形容正要大发脾气的神情。","source":{"text":"李儒见丁原背后一人，生得器宇轩昂，威风凛凛，手执方天画戟，怒目而视。","book":"明·罗贯中《三国演义》第三回"},"example":{"text":"太后～，别了三思回宫，便传旨宣归义王陈硕贞入朝，将前事与她说了。","book":"清·禇人获《隋唐演义》第七十三回"},"similar":["侧目而视","发指眦裂"],"opposite":["和颜悦色","眉开眼笑"],"usage":"作谓语；表示强烈不满"},{"id":18931,"word":"怒眉睁目","pinyin":"nù méi zhēng mù","abbr":"nmzm","explanation":"瞪大眼睛，咬紧牙关。形容愤恨之极。","source":{"text":"是站着的满脸通红怒眉睁目的两个人。但只是‘两个’人！","book":"茅盾《大泽乡》"},"similar":["怒目切齿","怒目睁眉","咬牙切齿"],"opposite":["喜笑颜开","眉开眼笑","喜不自胜"],"usage":"作谓语、定语、状语；形容愤恨之极"},{"id":18932,"word":"怒臂当车","pinyin":"nù bì dāng chē","abbr":"nbdc","explanation":"怒臂：螳螂发怒用臂膊阻挡车轮。比喻与强者为敌，不自量力。","source":{"text":"小生怒臂当车，自取戮辱，惭愧惭愧！","book":"明·许三阶《节侠记·侠晤》"},"similar":["怒臂当辙","螳臂当车"],"usage":"作谓语、宾语、定语；指自不量力"},{"id":18933,"word":"怒臂当辙","pinyin":"nù bì dāng zhé","abbr":"nbdz","explanation":"怒臂：螳螂发怒用臂膊阻挡车轮；辙：车辙。比喻与强者为敌，不自量力。","source":{"text":"随非惟不自忧，乃不自量其力，怒臂当辙，以蹈祸败。","book":"宋·吕祖谦《东莱博议·随叛楚》"},"similar":["怒臂当车"],"usage":"作谓语、宾语、定语；指自不量力"},{"id":18934,"word":"怒蛙可式","pinyin":"nù wā ké shì","abbr":"nwks","explanation":"怒蛙：鼓足气的青蛙；式：太在车前横木上表示致敬。向鼓足了气的青蛙致敬，表示对勇士的尊敬。","source":{"text":"越王勾践见怒蛙而式之。御者曰：‘何为式？’王曰：‘蛙有气如此，可无为式乎？’士人闻之曰：‘蛙有气，王犹为式，况士人有勇者乎！’","book":"《韩非子·外储说上》"},"usage":"作宾语、定语；用于书面语","story":["春秋时期，吴王夫差打败了越王勾践，囚禁了他三年时间，后来放他回国。越王勾践为了复仇，卧薪尝胆，经常鼓舞士气，一次他看到一个鼓足气的青蛙，立即停车让道表示敬意，侍者问为什么？勾践说青蛙有勇气，值得敬佩。士人闻之纷纷想成为勇士"]},{"id":18935,"word":"怕三怕四","pinyin":"pà sān pà sì","abbr":"psps","explanation":"这也怕，那也怕。比喻顾虑太多，不能做出决定。","source":{"text":"李昌叫你写，就是说你行，叫你拿主张。你怕三怕四干什么。","book":"丁玲《太阳照在桑乾河上》"},"example":{"text":"你这样～的还能干好事？"},"similar":["胆小怕事"],"opposite":["胆大妄为"],"usage":"作谓语、定语；指胆小怕事"},{"id":18936,"word":"怕处有鬼","pinyin":"pà chù yǒu guǐ","abbr":"pcyg","explanation":"越是害怕的地方越是有鬼出现。比喻越担心的事情越会出现。","source":{"text":"正如俗话所说：怕处有鬼。","book":"路遥《平凡的世界》第五卷第二章"},"usage":"作宾语、定语；用于口语"},{"id":18937,"word":"怕死贪生","pinyin":"pà sǐ tān shēng","abbr":"psts","explanation":"贪：舍不得。贪恋生存，畏惧死亡。指对敌作战畏缩不前。","source":{"text":"今立自知贼杀中郎曹将，冬月迫促，贪生畏死，即诈僵仆阳（佯）病，徼幸得逾于须臾。","book":"《汉书·文三王传》"},"example":{"text":"我不象你这等～，甘心卑污苟贱，给那恶僧支使，亏你还有脸说来劝我。","book":"清·文康《儿女英雄传》第七回"},"similar":["贪生怕死"],"opposite":["视死如归"],"usage":"作谓语、定语、宾语；指人没有骨气"},{"id":18938,"word":"怕死鬼","pinyin":"pà sǐ guǐ","abbr":"psg","explanation":"怕死的人。","example":{"text":"你这个～真没出息。"},"similar":["胆小鬼"],"usage":"作宾语、定语；多用于骂人"},{"id":18939,"word":"怕痛怕痒","pinyin":"pà tòng pà yǎng","abbr":"ptpy","explanation":"比喻畏首畏尾，顾虑重重。","source":{"text":"他名叫温成书，因为做事怕痛怕痒，干啥也吞吞吐吐，没有火气，所以大伙把他的名字喊成为‘温吞水’了。","book":"张英《老年突击队》"},"similar":["怕三怕四"],"usage":"作谓语、定语；指人胆小"},{"id":18940,"word":"怕硬欺软","pinyin":"pà yìng qī ruǎn","abbr":"pyqr","explanation":"害怕强硬的，欺负软弱的。","source":{"text":"天地也，做得个怕硬欺软，却原来也这番顺水推船。","book":"元·关汉卿《窦娥冤》第三折"},"example":{"text":"～的人让人瞧不起。"},"similar":["欺软怕硬"],"opposite":["不卑不亢"],"usage":"作谓语、定语；指人畏强欺弱"},{"id":18941,"word":"怕风怯雨","pinyin":"pà fēng qiè yǔ","abbr":"pfqy","explanation":"怯：害怕。形容人害怕艰难困苦，娇气十足。","source":{"text":"那做买卖的，有一等人肯向前，敢当赌，汤风冒雪，忍寒受冷；有一等人怕风怯雨，门也不出。","book":"元·秦简夫《东堂老》第二折"},"usage":"作谓语、定语；指害怕困难"},{"id":18942,"word":"怕鬼有鬼","pinyin":"pà guǐ yǒu guǐ","abbr":"pgyg","explanation":"比喻害怕什么，偏偏要碰到什么。","source":{"text":"我最恶的是虫名，他偏要钻出来，真是‘怕鬼有鬼’。","book":"清·李汝珍《镜花缘》第91回"},"example":{"text":"他～的样子证明心中有鬼。"},"usage":"作宾语、定语；指害怕什么，偏会碰到什么"},{"id":18943,"word":"怖鸽获安","pinyin":"bù gē huò ān","abbr":"bgha","explanation":"怖；惶惧。比喻走投无路的人又获得了安身之地。","source":{"text":"方使怖鸽获安，穷鱼永乐。","book":"南朝·梁·萧纲《谢赐钱启》"},"usage":"作宾语、定语；指陷入绝境的人","story":["佛教《涅槃经》第28载中讲述：从前有一只被老鹰追逐的鸽子，吓得到处乱飞，老鹰还在继续追逐。佛看到这种情况，就用自己的身影遮蔽鸽子，使老鹰找不到鸽子就逃走了。鸽子消除了恐怖，重新获得了安全"]},{"id":18944,"word":"怙势凌弱","pinyin":"hù shì líng ruò","abbr":"hslr","explanation":"凌：欺压。仗着自己强大就欺侮弱者。","source":{"text":"自是之后，以强陵弱，以众暴寡。","book":"《庄子·盗跖》"}},{"id":18945,"word":"怙恩恃宠","pinyin":"hù ēn shì chǒng","abbr":"hesc","explanation":"怙：依靠。恃：凭借，依靠。凭借别人所给予的恩泽和宠幸而横行霸道、骄横妄为。","source":{"text":"凶狡无行之徙，媚以求官，恃势怙宠之辈，渔食百姓，穷破天下。空竭小人。","book":"《后汉书·朱穆传》"},"example":{"text":"秉权衡威臑京畿，～把君王媚，全不想存仁义。","book":"明·李开先《宝剑记》第五十出"},"usage":"作谓语、定语；用于处事"},{"id":18946,"word":"怙恶不悛","pinyin":"hù è bù quān","abbr":"hebq","explanation":"怙：依靠，依仗；悛：改过，悔改。坚持作恶，不肯悔改。","source":{"text":"长恶不悛，从自及也。","book":"《左传·隐公六年》"},"example":{"text":"若授以远方牧民之官，其或～，恃远肆毒，小民罹殃，卒莫上诉。","book":"《宋史·王化基传》"},"similar":["死不改悔","罪大恶极"],"opposite":["翻然悔悟","痛改前非"],"usage":"作宾语、定语；指做坏事","story":["春秋时期，卫国联合宋、陈等国进攻郑国。郑庄公为了离间卫国的盟国陈国，就派使者去与陈桓公要求和好结盟。陈桓公瞧不起郑庄公，拒绝结盟。郑庄公率大军攻打陈国，打败陈军。史学家评论陈桓公长期做罪恶的事是自食其果的"]},{"id":18947,"word":"怙恶不改","pinyin":"hù è bù gǎi","abbr":"hebg","explanation":"怙：坚持。坚持作恶，不肯悔改。","source":{"text":"岂得怙恶不改，又率领众仙布此恶阵？","book":"明·许仲琳《封神演义》第82回"},"similar":["怙恶不悛"],"usage":"作宾语、定语；指做坏事"},{"id":18948,"word":"怙才骄物","pinyin":"hù cái jiāo wù","abbr":"hcjw","explanation":"犹言恃才傲物。仗着自己有才能，看不起人。","source":{"text":"若夫怙才骄物，公旦其犹病诸，而以刘祥居之，斯亡亦为幸焉。","book":"《南史·刘祥传论》"},"similar":["恃才傲物"],"usage":"作谓语、定语；指人骄傲"},{"id":18949,"word":"怙终不悔","pinyin":"hù zhōng bù huǐ","abbr":"hzbh","explanation":"有所恃而终不悔改。同“怙终不悛”。","source":{"text":"御史中丞李定言：知湖州苏轼……怙终不悔，狂悖之语日闻。","book":"《续资治通鉴·宋神宗元丰二年》"},"similar":["怙终不悛"],"usage":"作谓语、定语；用于处事"},{"id":18950,"word":"怙终不悛","pinyin":"hù zhōng bù quān","abbr":"hzbq","explanation":"有所恃而终不悔改。悛，悔改。","source":{"text":"君子之心未尝不欲其去非而就是，舍邪而适正。其怙终不悛，则当为《夬》之上六矣。","book":"语出《书·舜典》：“眚灾肆赦，怙终贼刑。”孔传：“怙奸自终，当刑杀之。”宋·罗大经《鹤林玉露》卷七"},"example":{"text":"如将士～，尔等军民……速当兴举大义。","book":"《水浒传》第九七回"},"similar":["怙终不悔"],"usage":"作谓语、定语；用于处事"},{"id":18951,"word":"怙过不悛","pinyin":"hù guò bù quān","abbr":"hgbq","explanation":"指坚持错误不改。","source":{"text":"倘再执迷不悟，不肯尽数缴呈，妄思存留售卖，是其有心违抗，怙过不悛。","book":"清·林则徐《传谕唩嚟哆将澳门洋楼鸦片呈缴》"},"example":{"text":"今如诸君约，苟能痛改前非，以国家为前提，则宽其既往……如仍～，则玉麟辈一介武夫，为国家起见，惟知以武力判断。","book":"黄远庸《陆总理演说后之政界》"},"usage":"作谓语、定语；用于书面语"},{"id":18952,"word":"怙顽不悛","pinyin":"hù wán bù quān","abbr":"hwbq","explanation":"犹言顽固不化。坚持错误，不肯改悔。","source":{"text":"帝曰：‘蛮人怙顽不悛，终必取祸，姑待之。’","book":"《明史·广西土司传二·思明》"},"similar":["顽固不化"],"usage":"作谓语、定语；用于书面语"},{"id":18953,"word":"怛然失色","pinyin":"dá rán shī sè","abbr":"drss","explanation":"怛：畏惧，恐惧。指因害怕而变脸色。","source":{"text":"闻介马万骑驰过，剑槊相摩，终夜有声，从者怛然失色。","book":"宋·苏洵《送石昌言舍人北使行》"},"example":{"text":"太守～，左右皆大惊。","book":"清·邵长蘅《黄烈妇传》"},"similar":["大惊失色"],"opposite":["神色自若"],"usage":"作状语；指害怕而失色"},{"id":18954,"word":"怜孤惜寡","pinyin":"lián gū xī guǎ","abbr":"lgxg","explanation":"怜悯同情孤儿寡妇。也泛指怜惜孤苦无依的人。","source":{"text":"怜孤惜寡念贫穷，今日收留我运通。","book":"明·徐元《八义记·赵宣训子》"},"usage":"作主语、宾语；指帮助弱势人士"},{"id":18955,"word":"怜我怜卿","pinyin":"lián wǒ lián qīng","abbr":"lwlq","explanation":"指彼此相爱怜。多指情人或夫妻之间。","source":{"text":"有美一人，独抱孤愤。怜我怜卿，飘飘意远。","book":"南朝·宋·刘义庆《世说新语·惑溺》：“亲卿爱卿，是以卿卿，我不卿卿，谁当卿卿。”清·魏子安《花月痕》第九回"},"example":{"text":"敬真、全琇，一住数日，几与各妓结不解缘，朝朝暮暮，～，还记得甚么军事。","book":"蔡东藩《五代史演义》第五十回"},"usage":"作谓语、定语；用于男女之间"},{"id":18956,"word":"怜新厌旧","pinyin":"lián xīn yàn jiù","abbr":"lxyj","explanation":"多指喜爱新欢，冷落旧宠。同“怜新弃旧”。","source":{"text":"怜新厌旧妾恨深，为君试奏《白头吟》。","book":"明·高启《新弦曲》"},"similar":["怜新弃旧"],"usage":"作谓语、定语；多指男性在情爱上不专一"},{"id":18957,"word":"怜新弃旧","pinyin":"lián xīn qì jiù","abbr":"lxqj","explanation":"怜：爱怜；弃：舍，抛。爱怜新的，抛掉旧的。多指喜爱新欢，冷落旧宠。","source":{"text":"妇人道：‘你还哄我？你若不是怜新弃旧，再不外边另有别人。","book":"明·兰陵笑笑生《金瓶梅词话》第八回"},"example":{"text":"薛蟠本是个～的人，且是有酒胆无饭力的。","book":"清·曹雪芹《红楼梦》第79回"},"similar":["怜新厌旧","喜新厌旧"],"usage":"作谓语、定语；多指男性在情爱上不专一"},{"id":18958,"word":"怜贫恤老","pinyin":"lián pín xù lǎo","abbr":"lpxl","explanation":"同情和体恤贫穷年老的人。","source":{"text":"如今上了年纪，越发怜贫恤老的了。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"～是我们中华民族的美德之一。"},"similar":["怜贫惜老"],"usage":"作谓语、宾语；指帮助弱势人士","story":["王熙凤连了宗的远方亲戚王狗儿靠种农活为生，王家祖上也是京官，后家道衰落。王狗儿不如意在家生闷气，岳母刘姥姥数落他不会生计，突然她想到王家远方亲戚王熙凤是荣国府贾二爷的夫人，听说她很会怜贫恤老，不妨去找她帮助"]},{"id":18959,"word":"怜贫恤苦","pinyin":"lián pín xù kǔ","abbr":"lpxk","explanation":"同情周济穷苦的人。","source":{"text":"此间有一李相公仗义，专一怜贫恤苦。","book":"明·屠隆《彩毫记·散财结客》"},"similar":["恤苦怜贫"],"usage":"作谓语、宾语；指人富有同情心"},{"id":18960,"word":"怜贫惜老","pinyin":"lián pín xī lǎo","abbr":"lpxl","explanation":"爱护老人，同情穷人。","source":{"text":"难得老太太和姑奶奶并那些小姐们，连这样怜贫惜老照看我。","book":"清·曹雪芹《红楼梦》第42回"},"example":{"text":"全社会都应该～。"},"similar":["怜贫恤老"],"usage":"作谓语、宾语；指帮助弱势人士"},{"id":18961,"word":"怜贫惜贱","pinyin":"lián pín xī jiàn","abbr":"lpxj","explanation":"怜：怜悯；惜：爱惜；贱：地位低下。怜悯贫穷的人，爱护地位低下的人。","source":{"text":"以及家中仆从老小，想起他素日怜贫惜贱爱老慈幼之恩，莫不悲号痛哭。","book":"清·曹雪芹《红楼梦》第十三回"}},{"id":18962,"word":"怜贫敬老","pinyin":"lián pín jìng lǎo","abbr":"lpjl","explanation":"老：年老的人；怜：怜恤。尊敬老人，怜恤家境困苦的人。形容人有恭谨慈爱的美好品德。","source":{"text":"吾神又将小女桂花配与奇童为妻，则为你恤孤念寡，敬老怜贫，因此感动天地也。","book":"元·无名氏《刘弘嫁婢》第四折"},"example":{"text":"你个老人家心肠最好，施恻隐～。","book":"明·无名氏《打董达》第四折"},"similar":["怜贫惜老"],"usage":"作谓语、定语、宾语；指帮助弱势人士"},{"id":18963,"word":"怜香惜玉","pinyin":"lián xiāng xī yù","abbr":"lxxy","explanation":"惜、怜：爱怜；玉、香：比喻女子。比喻男子对所爱女子的照顾体贴。","source":{"text":"相逢没话说，不见却思量，全不肯惜玉怜香，则他那古敝性尚然强。","book":"元·尚仲贤《柳毅传书》第四折"},"example":{"text":"想着他酒席儿上～。","book":"明·刘兑《金童玉女娇红记》"},"similar":["男欢女爱","海誓山盟","沾花惹草"],"opposite":["喜新厌旧"],"usage":"作谓语、定语；形容男子对女子的照顾体贴","story":["元代歌妓顺时秀天资聪敏，色艺超群，翰林学士王元鼎十分喜欢她。中书参政阿鲁温也想插一手，借机调戏她，问她他与王元鼎的差异。顺时秀说：你是宰相，治理国家，辅佐君王，他不如你。可惜玉怜香方面，你不如王学士"]},{"id":18964,"word":"思不出位","pinyin":"sī bù chū wèi","abbr":"sbcw","explanation":"思：考虑；位：职位。考虑事情不超过自己的职权范围。比喻规矩老实，守本分。也形容缺乏闯劲。","source":{"text":"曾子曰：‘君子思不出其位。’","book":"《易·艮》：“《象》曰：兼山艮，君子以思不出其位。”《论语·宪问》"},"example":{"text":"～，则虑周也。","book":"章炳麟《分镇》"},"similar":["老实本分"],"usage":"作谓语；比喻规矩老实，守本分"},{"id":18965,"word":"思不出其位","pinyin":"sī bù chū qí wèi","abbr":"sbcqw","explanation":"思：考虑；位：职位。考虑事情不超过自己的职权范围。比喻规矩老实，守本分。也形容缺乏闯劲。","source":{"text":"曾子曰：‘君子思不出其位。’","book":"《周易·艮》：“《象》曰：兼山艮，君子以思不出其位。”《论语·宪问》"},"example":{"text":"评论固然不可，妄自颂扬也不可，这就是“～”。","book":"鲁迅《且介亭杂文·隔膜》"}},{"id":18966,"word":"思前想后","pinyin":"sī qián xiǎng hòu","abbr":"sqxh","explanation":"思：考虑；前：前因；后：后果。对事情发生的缘由，发展后果，作再三考虑。","source":{"text":"且闻太师见后无袭兵，领人马徐徐而行；又见折了余庆，辛环带伤，太师十分不乐，一路上思前想后。","book":"明·许仲琳《封神演义》第52回"},"example":{"text":"一路上～，苦无良策。","book":"金庸《笑傲江湖》"},"similar":["左思右想","思前虑后"],"opposite":["一往直前"],"usage":"作谓语；形容反复思考"},{"id":18967,"word":"思前算后","pinyin":"sī qián suàn hòu","abbr":"sqsh","explanation":"思想前面，盘算后面。","source":{"text":"也不会思前算后，你只说转限呵，过了一日又添一日利。","book":"明·范受益《寻亲记·催逋》"},"example":{"text":"清·张南庄《何典》第六回：“那时活死人弄得来得去不得，心里好不着急，～，没个道路。”"},"similar":["思前想后"],"usage":"作谓语、定语；用于处事"},{"id":18968,"word":"思前虑后","pinyin":"sī qián lǜ hòu","abbr":"sqlh","explanation":"思：思考，考虑；前：原因。反复考虑事情的原因和结果。","source":{"text":"只是老朱有些任性，敢作敢为，再不思前虑后，小弟每每与他说好话，他再不肯听。","book":"清·荑荻散人《玉娇梨》第一回"},"example":{"text":"～，又兴奋又焦虑，拿不准自己会给这个漂亮的日本姑娘最终留下什么印象。","book":"王朔《许爷》"},"similar":["思前想后","瞻前顾后"],"usage":"作谓语；形容反复思考"},{"id":18969,"word":"思古之情","pinyin":"sī gǔ zhī qíng","abbr":"sgzq","explanation":"思：想念；古往昔；情：情感。怀念往昔的一种情感。","source":{"text":"于时戎车外动，王命相属，裳冕委蛇，轺轩继路，旧老怀思古之情，行人或为之殒涕。","book":"汉·班固《西都赋》：“愿宾摅怀旧之蓄念，发思古之幽情。”《宋书·索虏传》"},"example":{"text":"一白一黑这两种简单明快的食物引起我的幽幽～。","book":"苏童《南方的堕落》"}},{"id":18970,"word":"思如涌泉","pinyin":"sī rú yǒng quán","abbr":"sryq","explanation":"才思犹如喷出的泉水。形容人的才思敏捷，才力充沛。","source":{"text":"强记洽闻，幽赞微言；文若春华，思若涌泉。","book":"三国·魏·曹植《王仲宣诔》"},"example":{"text":"舍人～，峤所不及也。","book":"《旧唐书·苏颋传》"},"similar":["文思敏捷","思若涌泉","思若泉涌"],"usage":"作谓语、定语；指人的文思"},{"id":18971,"word":"思妇病母","pinyin":"sī fù bìng mǔ","abbr":"sfbm","explanation":"指因想念妻子欲归家乡而托言母病。比喻作伪。","source":{"text":"世有思妇病母者，岂此谓乎！","book":"《三国志·魏志·梁习传》"}},{"id":18972,"word":"思归其雌","pinyin":"sī guī qí cí","abbr":"sgqc","explanation":"指退藏潜服。","source":{"text":"知其雄，守其雌，为天下溪。","book":"语出《老子》"}},{"id":18973,"word":"思念存想","pinyin":"sī niàn cún xiǎng","abbr":"sncx","explanation":"存想：想念。形容非常想念。","source":{"text":"凡天地之间有鬼，非人死精神为之也，皆人思念存想之所致也。","book":"汉·王充《论衡·订鬼》"}},{"id":18974,"word":"思患预防","pinyin":"sī huàn yù fáng","abbr":"shyf","explanation":"想到会发生祸患，事先采取预防措施。","source":{"text":"君子以思患而豫防之。","book":"《周易·既济》"},"example":{"text":"见险虑难，～，别物居方。","book":"三国·魏·阮籍《通易论》"},"similar":["防患未然"],"usage":"作谓语、定语；指事先预防"},{"id":18975,"word":"思所逐之","pinyin":"sī suǒ zhú zhī","abbr":"sszz","explanation":"盘算着如何驱赶他们。"},{"id":18976,"word":"思断义绝","pinyin":"ēn duàn yì jué","abbr":"sdyj","explanation":"感情破裂。多指夫妻离异。"},{"id":18977,"word":"思深忧远","pinyin":"sī shēn yōu yuǎn","abbr":"ssyy","explanation":"思虑得深，为久远的事操心。形容考虑周到。","source":{"text":"思深哉，其有陶唐氏之遗民乎。不然，何忧之远也。","book":"《左传·襄公二十九年》"},"usage":"作宾语、定语；用于书面语"},{"id":18978,"word":"思潮起伏","pinyin":"sī cháo qǐ fú","abbr":"scqf","explanation":"思想活动极频繁。","source":{"text":"我睡不着，走出帐篷，站在一个土坡上，望着漫山遍野的夜明星，思潮起伏。","book":"王宗仁《夜明星》"},"similar":["心潮澎湃"],"usage":"作谓语；指思想活动极频繁"},{"id":18979,"word":"思绪万千","pinyin":"sī xù wàn qiān","abbr":"sxwq","explanation":"思绪：思想的头绪。万千：极多。指思想的头绪相当多，思虑复杂多端。","source":{"text":"怅望伤游目，辛酸思绪乡。","book":"南朝·陈·释洪偃《游故园》"},"example":{"text":"可是，此时此刻，母亲的情感是多么错综复杂，～呀！","book":"刘白羽《第二个太阳》第十四章"}},{"id":18980,"word":"思绪云骞","pinyin":"sī xù yún qiān","abbr":"sxyq","explanation":"思绪：思路；骞：高举。形容思路高远奇特。","source":{"text":"安仁思绪云骞，词锋景焕，前史俦于贾谊，先达方之士衡。","book":"《晋书·潘岳传论》"}},{"id":18981,"word":"思而不学则殆","pinyin":"sī ér bù xué zé dà","abbr":"sebxzd","explanation":"殆：精神疲倦而无所得；思：思考。只是思考而不去学习，就会使精神疲倦而无所得。","source":{"text":"学而不轴则罔，思而不学则殆。","book":"《论语·为政》"}},{"id":18982,"word":"思若泉涌","pinyin":"sī ruò quán yǒng","abbr":"srqy","explanation":"思：思绪，文思。指人的文思如泉水涌出。形容文思丰富敏捷。","source":{"text":"伏惟尊号皇帝陛下精心六义，思若泉涌，锐意万机，居多暇曰。","book":"宋·王禹偁《谢赐御制月诗表》"},"similar":["思若涌泉","思如涌泉"],"usage":"作谓语、定语；指人的文思"},{"id":18983,"word":"思若涌泉","pinyin":"sī ruò yǒng quán","abbr":"sryq","explanation":"才思犹如喷出的泉水。形容人的才思敏捷，才力充沛。","source":{"text":"强记洽闻，幽赞微言；文若春华，思若涌泉。","book":"三国·魏·曹植《王仲宣诔》"},"example":{"text":"宋·庄季裕《鸡肋编》上卷：“～名海内，从来苏李擅当时。”"},"similar":["思若泉涌","思如泉涌"],"usage":"作谓语、定语；指人的文思"},{"id":18984,"word":"思虑恂达","pinyin":"sī lǜ xún dá","abbr":"slxd","explanation":"恂达：通达；思：思索；虑：考虑。指头脑有识辨能力，思索考虑很通达。","source":{"text":"邀于此者，四肢强，思虑恂达，耳目聪明。","book":"《庄子·知北游》"}},{"id":18985,"word":"思虑营营","pinyin":"sī lǜ yíng yíng","abbr":"slyy","explanation":"营营：往来盘旋的样子，这里指为名利而劳碌费神。形容为了功名利禄而用心奔走。","source":{"text":"全汝形，抱汝生，无使汝思虑营营。","book":"《庄子·庚桑楚》"}},{"id":18986,"word":"思贤如渴","pinyin":"sī xián rú kě","abbr":"sxrk","explanation":"如渴：如口渴思饮那般，形容迫切。比喻迫切的想延致有才德的人。","source":{"text":"将军既帝室之胄，信义著于四海，总揽英雄，思贤如渴。","book":"《三国志·蜀书·诸葛亮传》"},"example":{"text":"启翁，你看他是如何～！","book":"姚雪垠《李自成》第一卷第二十六章"},"similar":["思贤若渴"],"usage":"作谓语；指爱惜人才"},{"id":18987,"word":"思过半矣","pinyin":"sī guò bàn yǐ","abbr":"sgby","explanation":"①指已领悟大半。②指事情已获大部分解决。","source":{"text":"思虑有益，以过半矣。","book":"《周易·系辞下》：“知者观其彖辞，则思过半矣。”孔颖达疏"},"example":{"text":"兵垣得人，而疆事～。","book":"清·钱谦益《兵科给事中李遇知授徵仕郎制》"},"usage":"作谓语；用于书面语"},{"id":18988,"word":"怠惰因循","pinyin":"dài duò yīn xún","abbr":"ddyx","explanation":"怠惰：懈怠、懒惰。因循：拖延。形容懒散拖沓。","source":{"text":"愿尽其学，职事羁缠，未得继清，怠惰因循，不能自疆（强）。","book":"唐·韩愈《答殷侍御书》"},"usage":"作谓语、定语；用于处世"},{"id":18989,"word":"怡堂燕雀","pinyin":"yí táng yàn què","abbr":"ytyq","explanation":"怡：安适。小鸟住在安适的堂屋里。比喻身处险境也不自知的人。","source":{"text":"怡堂燕雀，不知后炎；瓮里醯鸡，安有广见。","book":"明·程登吉《幼学琼林》第四卷"},"usage":"作宾语、定语；用于比喻句"},{"id":18990,"word":"怡声下气","pinyin":"yí shēng xià qì","abbr":"ysxq","explanation":"怡声：声音和悦；下气：态度恭顺。形容声音柔和，态度恭顺。","source":{"text":"下气怡声，问衣燠寒。","book":"《礼记·内则》"},"example":{"text":"～，不惮劬劳。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["下气怡声"],"usage":"作谓语、定语；指人的仪态"},{"id":18991,"word":"怡志养神","pinyin":"yí zhì yǎng shén","abbr":"yzys","explanation":"怡养神志，使之安适愉快。","source":{"text":"长寄灵岳，怡志养神。","book":"三国·魏·嵇康《兄秀才公穆入军赠诗》之十八"},"usage":"作谓语、定语；用于书面语"},{"id":18992,"word":"怡性养神","pinyin":"yí xìng yǎng shén","abbr":"yxys","explanation":"怡悦精神，使之安适愉快。","source":{"text":"束书不观，吾何以欢？怡性养神，正在此间。","book":"明·李贽《读书乐》"},"similar":["怡神养性","怡神养寿"],"usage":"作谓语、定语、状语；用于处事"},{"id":18993,"word":"怡情养性","pinyin":"yí qíng yǎng xìng","abbr":"yqyx","explanation":"指怡养性情。","source":{"text":"他们那时侯，把一部用文言写的诗、词、赋、曲、传奇、小说，乃至野史、笔记，视为‘杂览’，士大夫博习经史以后，不妨也阅读一番，为的可以‘怡情养性’，‘殚见洽闻’。","book":"茅盾《如何欣赏文艺作品》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":18994,"word":"怡情悦性","pinyin":"yí qíng yuè xìng","abbr":"yqyx","explanation":"怡：和悦愉快；悦：高兴，愉快。使心情舒畅愉快。","source":{"text":"如今上了年纪，且案牍劳烦，于这怡情悦性的文章更生疏了。","book":"清·曹雪芹《红楼梦》第17回"},"example":{"text":"并不是生活的辛劳，而是一种～的娱乐。","book":"王西彦《病人》"},"similar":["怡情养性"],"usage":"作谓语、宾语；形容人的心情"},{"id":18995,"word":"怡情理性","pinyin":"yí qíng lǐ xìng","abbr":"yqlx","explanation":"指陶冶性情。","source":{"text":"学也者，所以疏神达思，怡情理性，圣人之上务也。","book":"汉·徐幹《中论·治学》"},"usage":"作谓语、宾语；用于书面语"},{"id":18996,"word":"怡然养寿","pinyin":"yí rán yǎng shòu","abbr":"yrys","explanation":"指保养元气。","source":{"text":"其践升帝位，克广洪业，以光祖宗之烈，使朕优游履道，颐神养性，可不善欤？","book":"《魏书·显祖纪》"}},{"id":18997,"word":"怡然养性","pinyin":"yí rán yǎng xìng","abbr":"yryx","explanation":"保养精神，使性情得到陶冶。","source":{"text":"其践升帝位，克广洪业，以光祖宗之烈，使朕优游履道，颐神养性，可不善欤？","book":"《魏书·显祖纪》"}},{"id":18998,"word":"怡然理顺","pinyin":"yí rán lǐ shùn","abbr":"yrls","explanation":"怡然：快乐的样子。使人心悦又能把道理阐述得很清楚。","source":{"text":"若江海之浸，膏泽之润，涣然冰释，怡然理顺，然后为得也。","book":"晋·杜预《春秋左氏传序》"}},{"id":18999,"word":"怡然自乐","pinyin":"yí rán zì lè","abbr":"yrzl","explanation":"怡然：喜悦的样子。形容高兴而满足。","source":{"text":"黄发垂髫，并怡然自乐。","book":"晋·陶潜《桃花源记》"},"example":{"text":"这简直是不伦不类的态度，但他却～，认为是义薄云天，忠贯日月，大有关云长“降汉不降曹”的气慨。","book":"丁中江《北洋军阀史话·复辟谬说》"},"similar":["怡然自得","怡然自足","怡然自娱"],"usage":"作谓语、定语、状语；用于处事"},{"id":19000,"word":"怡然自娱","pinyin":"yí rán zì yù","abbr":"yrzy","explanation":"怡然：安适愉快的样子。形容高兴而满足的样子。","source":{"text":"黄帝既寤，怡然自得。","book":"《列子·黄帝》"},"example":{"text":"～，恬然自足，再不从龙化甘雨。","book":"元·汤舜民《梁州》曲"},"similar":["怡然自得","怡然自乐","怡然自足"],"usage":"作谓语、定语、状语；用于处事"},{"id":19001,"word":"怡然自得","pinyin":"yí rán zì dé","abbr":"yrzd","explanation":"怡然：安适愉快的样子。形容高兴而满足的样子。","source":{"text":"黄帝既寤，怡然自得。","book":"《列子·黄帝》"},"example":{"text":"刘厚守听了，～，坐在椅子上，尽兴地把身子乱摆，一声也不响。","book":"清·李宝嘉《官场现形记》"},"similar":["自得其乐","得意洋洋","踌躇满志"],"opposite":["胆战心惊","心烦意乱","怅然若失"],"usage":"作谓语、定语、状语；用于处事"},{"id":19002,"word":"怡然自若","pinyin":"yí rán zì ruò","abbr":"yrzr","explanation":"喜悦而无拘无束。","source":{"text":"小欢颜悦，至乐而笑，乐之理也。何以言之？夫至亲安豫，则怡然自若，所猖狂也。","book":"三国·魏·嵇康《声无哀乐论》"},"example":{"text":"这时他的心意的活动比较简单，又比较松弱，故事后还～；我却不能了。","book":"朱自清《浆声灯影里的秦淮河》"},"usage":"作谓语、状语；用于处事"},{"id":19003,"word":"怡然自足","pinyin":"yí rán zì zú","abbr":"yrzz","explanation":"怡然：安适愉快的样子。形容高兴而满足的样子。","source":{"text":"黄帝既寤，怡然自得。","book":"《列子·黄帝》"},"example":{"text":"钻坚研微有弗及之勤，处静味道无风尘之志，高枕柴门，～。","book":"《晋书·虞喜传》"},"similar":["怡然自娱","怡然自得","怡然自乐"],"usage":"作谓语、定语、状语；用于处事"},{"id":19004,"word":"怡神养寿","pinyin":"yí shén yǎng shòu","abbr":"ysys","explanation":"怡：使愉悦。让自己精神愉悦以保养本性","source":{"text":"水解冻而绕轩，风扇和而入牖，固可蠲忧释疾，怡神养寿。","book":"《纪闻·牛应贞》"},"similar":["怡神养性","怡性养神"],"usage":"作谓语、定语、状语；用于处事"},{"id":19005,"word":"怡神养性","pinyin":"yí shén yǎng xìng","abbr":"ysyx","explanation":"怡：使愉悦。让自己精神愉悦以保养本性","source":{"text":"所以终日闭门，怡神养性。","book":"明·归有光《上王中丞书》"},"similar":["怡性养神","怡神养寿"],"usage":"作谓语、定语、状语；用于处事"},{"id":19006,"word":"怡颜悦色","pinyin":"yí yán yuè sè","abbr":"yyys","explanation":"犹和颜悦色。","source":{"text":"行者又道：‘汝等莫顺口儿答应，等我去了，你就不来奉承。看师父的，要怡颜悦色；养白马的，要水草调匀；假有一毫儿差了，照依这个样棍，与你们看看！’","book":"明·吴承恩《西游记》第十六回"},"similar":["和颜悦色"],"usage":"作谓语、状语；用于书面语"},{"id":19007,"word":"急三火四","pinyin":"jí sān huǒ sì","abbr":"jshs","explanation":"形容非常匆忙。","example":{"text":"他就～地跑出去了。"},"usage":"作定语、状语；用于方言"},{"id":19008,"word":"急不及待","pinyin":"jí bù jí dài","abbr":"jbjd","explanation":"急得不能等待。形容心怀急切或形势紧迫。同“急不可待”。","source":{"text":"其人不料此船仍回，急不及待持行李先付水手，身跃入舱。","book":"清·袁枚《新齐谐·骗术巧报》"},"similar":["急不可待","急不可耐"],"usage":"作定语、状语；形容心情急切"},{"id":19009,"word":"急不可待","pinyin":"jí bù kě dài","abbr":"jbkd","explanation":"急得不能等待。形容心怀急切或形势紧迫。","source":{"text":"逆害饮食，但思鱼羹，而近地则无，百里外始可购致。时厮骑皆被差遣，生性纯孝，急不可待，怀赀独往。","book":"清·蒲松龄《聊斋志异·青蛾》"},"example":{"text":"八大金刚有点～。","book":"曲波《林海雪原》十七"},"similar":["迫不及待","急不可耐"],"opposite":["来日方长","慢条斯理"],"usage":"作定语、状语；形容心情急切"},{"id":19010,"word":"急不可耐","pinyin":"jí bù kě nài","abbr":"jbkn","explanation":"急得不能等待。形容心怀急切或形势紧迫。","source":{"text":"六个人刚刚坐定，胡统领已急不可耐，头一个开口就说：‘我们今日非往常可比，须大家尽兴一乐。’","book":"清·李宝嘉《官场现形记》第十四回"},"similar":["急不可待"],"opposite":["慢条斯理"],"usage":"作定语、状语；形容心情急切"},{"id":19011,"word":"急不择言","pinyin":"jí bù zé yán","abbr":"jbzy","explanation":"择：选择；言：言词。急得来不及选择词语。","source":{"text":"去岁宋育仁倡议复辟，经大部递解回籍，交地方官察看。以此例彼，情罪更重，若故为宽纵，何以服人？何以为国？为此急不择言，冒昧上呈。","book":"蔡东藩、许廑父《民国通俗演义》第四十五回"},"example":{"text":"～的病源，并不在没有想的功夫，而在有功夫的时候没有想。","book":"鲁迅《华盖集·忽然想到》"},"similar":["张口结舌","急如星火","慌不择路"],"opposite":["不慌不忙","谈笑自若"],"usage":"作谓语、宾语、状语；形容非常紧迫"},{"id":19012,"word":"急不择路","pinyin":"jí bù zé lù","abbr":"jbzl","explanation":"急得来不及选择道路地乱跑，形容非常紧迫。","source":{"text":"张是夜越莽穿榛，急不择途；及明，困殆已极。","book":"清·蒲松龄《聊斋志异·张鸿渐》"},"example":{"text":"他有些～地乱跑。"},"similar":["慌不择路","急不择言","急不暇泽"],"opposite":["从容不迫","不慌不忙"],"usage":"作谓语、宾语、状语；形容非常紧迫"},{"id":19013,"word":"急不择途","pinyin":"jí bù zé tú","abbr":"jbzt","explanation":"犹慌不择路。势急心慌，顾不上选择道路。","source":{"text":"张是夜越莽穿榛，急不择途；及明，困殆已极。","book":"清·蒲松龄《聊斋志异·张鸿渐》"},"similar":["慌不择路"],"usage":"作谓语、定语；指十分慌乱"},{"id":19014,"word":"急不暇择","pinyin":"jí bù xiá zé","abbr":"jbxz","explanation":"在紧急的情况下来不及选择。","source":{"text":"愚民何知，急不暇择，长边八百余里，谁要之者？彼诱而众，我逃而虚。此可深念者五也。","book":"《明史·王宗沐传》"},"example":{"text":"三人～，从窦中鱼贯而出，外面正是一条逼狭的胡同，还静悄悄的没人阻住。","book":"蔡东藩、许廑父《民国通俗演义》第八回"},"usage":"作谓语、宾语；用于处事"},{"id":19015,"word":"急中生智","pinyin":"jí zhōng shēng zhì","abbr":"jzsz","explanation":"智：智谋。紧急的时候，猛然想出办法。","source":{"text":"今足下果用所长，过蒙见窘，然敌则气作，急则生智。","book":"唐·白居易《和微之诗二十三首序》"},"example":{"text":"当我把《语丝》读完的时候，想念《莽原》的心思却忽然增高万倍，～，马上写了一封信给我的可爱的表弟。","book":"鲁迅《田原思想》"},"similar":["情急生智"],"opposite":["无计可施","束手无策"],"usage":"作谓语、定语、状语；指人在危难时"},{"id":19016,"word":"急于事功","pinyin":"jí yú shì gōng","abbr":"jysg","explanation":"事：事业；工：功绩。指做事急于求成。","source":{"text":"宣宗南渡，吏习日盛，苛刻成风，殆亦多故之秋，急于事功，不免尔欤。","book":"《金史·选举一》"},"example":{"text":"我对于她终于很隔膜，我疑心她有点罗曼缔克，～。","book":"鲁迅《南腔北调集·为了忘却的记念》"},"similar":["急于求成"],"usage":"作谓语、宾语；指急于求成"},{"id":19017,"word":"急于星火","pinyin":"jí yú xīng huǒ","abbr":"jyxh","explanation":"星火：流星。象流星的光从空中急闪而过。形容非常急促紧迫。","source":{"text":"州司临门，急于星火。","book":"晋·李密《陈情表》"},"example":{"text":"宋·王明清《挥薼后录》第四卷：“官户根括，～。”"},"similar":["急如星火"],"usage":"作谓语、宾语、定语；形容非常急促紧迫"},{"id":19018,"word":"急于求成","pinyin":"jí yú qiú chéng","abbr":"jyqc","explanation":"急：急切。急着要取得成功。","source":{"text":"二都督道：‘急切不得下手！’","book":"明·罗贯中《三国演义》第45回"},"example":{"text":"她怎样呢？还是那样～，不甘寂寞吗？","book":"陆地《牙科大夫》"},"similar":["迫不及待","急于事成","急功近利"],"opposite":["从容不迫","稳扎稳打"],"usage":"作谓语、宾语、定语；指急着要取得成功"},{"id":19019,"word":"急人之危","pinyin":"jí rén zhī wēi","abbr":"jrzw","explanation":"急：着急；危：危急。热心主动帮助别人解决困难。","source":{"text":"公三晋贤士，独不急人之危乎？","book":"《新五代史·刘守光传》"},"similar":["急人之困","急人之忧","急人之难"],"usage":"作谓语、定语；指帮人解决困难"},{"id":19020,"word":"急人之困","pinyin":"jí rén zhī kùn","abbr":"jrzk","explanation":"热心主动帮助别人解决困难。","source":{"text":"胜所以自附为婚姻者，以公子之高义，为能急人之困。","book":"西汉·司马迁《史记·魏公子列传》"},"example":{"text":"他是个～的人。"},"similar":["急人之急","急人之难"],"opposite":["见死不救"],"usage":"作谓语、定语；指帮人解决困难","story":["战国时期，秦昭王率兵包围赵国都城邯郸，威胁其他诸侯不能援赵。魏王派晋鄙率军10万驻守边境，赵国平原君赵胜向妻弟信陵君公子无忌求救，信陵君急人之困，从魏王那里偷取兵符，假托魏王的命令夺取兵权，出兵解了赵国之围"]},{"id":19021,"word":"急人之忧","pinyin":"jí rén zhī yōu","abbr":"jrzy","explanation":"急：着急。热心主动帮助别人解决困难。","source":{"text":"侧闻吾子急人之忧，不遗乡曲之情，忽重特达之春，使保安得执鞭弭，以奉周旋。","book":"《纪闻·吴保安》"},"similar":["急人之困","急人之危","急人之难"],"usage":"作谓语、定语；指帮人解决困难"},{"id":19022,"word":"急人之难","pinyin":"jí rén zhī nán","abbr":"jrzn","explanation":"热心主动帮助别人解决困难。","source":{"text":"胜所以自附为婚姻者，以公子之高义，为能急人之困。","book":"《诗经·小雅·常棣》：“脊令在原，兄弟急难。”《史记·魏公子列传》"},"example":{"text":"笃于孝友，～，大义落落，人莫敢以利动。","book":"明·归有光《吴纯甫行状》"},"similar":["急人之困","急人之危","急人之忧"],"usage":"作谓语、定语；指帮人解决困难"},{"id":19023,"word":"急人所急","pinyin":"jí rén suǒ jí","abbr":"jrsj","explanation":"别人有困难时，设法给予帮助。","example":{"text":"他～，想人所想。"},"similar":["急人之困"],"usage":"作谓语、定语；指帮助别人"},{"id":19024,"word":"急先锋","pinyin":"jí xiān fēng","abbr":"jxf","explanation":"比喻冲锋在前或积极领头的人。","source":{"text":"为是他性急，撮盐入火，为国家面上，只要争气，当先厮杀，以此人都叫他做急先锋。","book":"明·施耐庵《水浒传》第十三回"},"example":{"text":"他是一个民族解放的～，给革命以很大的助力。","book":"《论鲁迅》"},"usage":"作宾语、定语；用于比喻句"},{"id":19025,"word":"急兔反噬","pinyin":"jí tù fǎn shì","abbr":"jtfs","explanation":"噬：咬。比喻被逼走投无路的人会掉头采取反击行动。","source":{"text":"急兔反噬辄酿祸，汹汹纠众寻干戈。","book":"清·薛时雨《漕仓行》诗"}},{"id":19026,"word":"急公好义","pinyin":"jí gōng hào yì","abbr":"jghy","explanation":"急：急于。热心公益，见义勇为。","source":{"text":"楚昭王有士曰石奢，其为人也，公正而好义。","book":"汉·刘向《新序·节士》"},"example":{"text":"～之心萌，独立自存之志固，言议波涌，为作日多。","book":"鲁迅《集外集拾遗·破恶声论》"},"similar":["助人为乐","慷慨解囊"],"opposite":["唯利是图","自私自利"],"usage":"作主语、谓语、宾语；指热心公益，见义勇为"},{"id":19027,"word":"急公好施","pinyin":"jí gōng hào shī","abbr":"jghs","explanation":"指热心公益，乐于施舍。","source":{"text":"君虽业盐，而孝友，急公好施，有远见，能自树。","book":"清·顾炎武《歙王君墓志铭》"},"usage":"作谓语、定语；用于为人"},{"id":19028,"word":"急公近利","pinyin":"jí gōng jìn lì","abbr":"jgjl","explanation":"近：眼前的。急于求成，贪图眼前的成效和利益。","source":{"text":"仁人者正其道不谋其利，修其理不急其功。","book":"汉·董仲舒《春秋繁露·对胶西王》"}},{"id":19029,"word":"急则抱佛脚","pinyin":"jí zé bào fó jiǎo","abbr":"jzbfj","explanation":"急：紧急，危急。比喻事到临头才慌忙准备。","source":{"text":"王丞相嗜谐谑。一日，论沙门道，因曰：‘投老欲依僧。’客遽对曰：‘急则抱佛脚。’","book":"宋·刘攽《中山诗话》"},"similar":["急来抱佛脚"],"usage":"作谓语、宾语、分句；指事先不作准备","story":["宋朝时期，王安石与客人闲谈，偶然谈到佛经，他感慨地说：“投老欲依僧”，表示想与和尚去做伴。旁人加上一句“急则抱佛脚”。王安石不悦，那人说古诗对谚语，如改成对联则成为“老欲依僧，急来抱佛”，头脚相对"]},{"id":19030,"word":"急则计生","pinyin":"jí zé zhì shēng","abbr":"jzjs","explanation":"计：计策，办法。在紧急情况下，被逼无奈想出了应付的办法。","source":{"text":"今足下果用所长，过蒙见窘，然敌则气作，急则计生，四十二章麾扫并毕，不知大敌以为如何？","book":"唐·白居易《和微之诗二十三首序》"}},{"id":19031,"word":"急功好利","pinyin":"jí gōng hào lì","abbr":"jghl","explanation":"急于求成，贪图眼前的成效和利益。同“急功近利”。","source":{"text":"而又日见贡之简略易从，争趋之以为便我。便我，于是急功好利之君之大夫，徇其民而大变之。","book":"清·恽敬《三代因革论》四"},"similar":["急功近利"],"usage":"作谓语、定语、分句；形容急于求成"},{"id":19032,"word":"急功近利","pinyin":"jí gōng jìn lì","abbr":"jgjl","explanation":"功：成功；近：眼前的。急于求成，贪图眼前的成效和利益。","source":{"text":"仁人者正其道不谋其利，修其理不急其功。","book":"汉·董仲舒《春秋繁露·对胶西王》"},"example":{"text":"而～，不避声色，则阳明学为厉阶。","book":"章炳麟《答梦庵》"},"similar":["贪功求名","急于求成","鼠目寸光"],"opposite":["深谋远虑","高瞻远瞩"],"usage":"作谓语、定语、分句；形容急于求成"},{"id":19033,"word":"急功近名","pinyin":"jí gōng jìn míng","abbr":"jgjm","explanation":"急于求成，贪图虚名。","source":{"text":"世宗治尚明肃，诸臣皆以开敏精勤称上指，为政持大体，与夫急功近名，流于溪刻，重为世诟病者，固大异矣。","book":"《清史稿·高其倬等传论》"},"example":{"text":"四方布衣之士亦有上书于乾清门以希进用者，然率皆～之士。","book":"清·昭涟《啸亭杂录·雒昂》"},"similar":["急功近利"],"opposite":["高瞻远瞩"],"usage":"作谓语、定语、分句；形容急于求成"},{"id":19034,"word":"急吏缓民","pinyin":"jí lì huǎn mín","abbr":"jlhm","explanation":"对官员严格，对百姓宽和。","source":{"text":"急吏缓民，则吏不可纵，政之大功也。","book":"宋·王禹偁《谏议大夫臧公墓志铭》：“太平兴国八年拜右拾遗，直史馆赐银章朱绂，寻知许州。在许三年，急吏缓民而已。”宋·苏舜钦《论五事》"},"usage":"作宾语、定语；用于治国等"},{"id":19035,"word":"急嘴急舌","pinyin":"jí zuǐ jí shé","abbr":"jzjs","explanation":"急忙插话抢着说话。","source":{"text":"二婶好像怕她生疑，急嘴急舌地解释。","book":"陈残云《深圳河畔》"},"similar":["快嘴快舌","快人快语"],"usage":"作状语、定语；形容抢着说话"},{"id":19036,"word":"急处从宽","pinyin":"jí chù cóng kuān","abbr":"jcck","explanation":"在紧急情况下并不紧张。","source":{"text":"沙僧听说，大喜道：‘好！好！好！正是粗中有细，果然急处从宽。’","book":"明·吴承恩《西游记》第55回"},"example":{"text":"为人要做到～是不容易的。"},"usage":"作宾语、定语；用于劝诫人"},{"id":19037,"word":"急如星火","pinyin":"jí rú xīng huǒ","abbr":"jrxh","explanation":"星火：流星。象流星的光从空中急闪而过。形容非常急促紧迫。","source":{"text":"州司临门，急于星火。","book":"晋·李密《陈情表》"},"example":{"text":"闺臣心内虽～，偏偏婉如同田凤翾的哥哥田廷结了婚姻。","book":"清·李汝珍《镜花缘》第九十四回"},"similar":["急于星火","火烧眉毛","十万火急"],"opposite":["从容不迫","慢条斯理","缓兵之计"],"usage":"作谓语、宾语、定语；形容非常急促紧迫","story":["晋朝时期，蜀国尚书郎李密在蜀亡后回乡与96岁的祖母相依为命。晋武帝司马炎征召他为太子洗马。李密要侍奉祖母不愿做官，他写《陈情表》说：“郡县逼迫，催臣上道，州司临门，急于星火。”待侍奉好祖母百年后再出门为官"]},{"id":19038,"word":"急如风火","pinyin":"jí rú fēng huǒ","abbr":"jrfh","explanation":"急得像疾风烈火一样。形容十分急迫。","source":{"text":"你要图成和议，急如风火，却如何等得这三日过呢？","book":"《西游补》第九回"},"similar":["急如星火"],"opposite":["从容不迫"],"usage":"作谓语、宾语、定语；形容非常急促紧迫"},{"id":19039,"word":"急就章","pinyin":"jí jiù zhāng","abbr":"jjz","explanation":"急就：匆促地完成。指匆促写成的文章或奏章。泛指为了应付需要急急忙忙完成的作品或工作。","source":{"text":"‘急就’者，谓字之难知者，缓急可就而存焉。","book":"宋·晁公武《郡斋读书志·小学类》"},"example":{"text":"羽出颠倒司农印，幕府纵横～。","book":"清·龚自珍《咏史》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":19040,"word":"急张拘诸","pinyin":"jí zhāng jū zhū","abbr":"jzjz","explanation":"形容局促不安、紧张慌乱的样子。","source":{"text":"他这般急张拘诸的立。","book":"《元曲选·李逵负荆》"}},{"id":19041,"word":"急征重敛","pinyin":"jí zhēng zhòng liǎn","abbr":"jzzl","explanation":"敛：聚敛。催征捐税，加倍搜刮。","source":{"text":"陛下怀悔过之深诚，降非常之大号，知黩武穷兵之长乱，知急征重敛之剿财。","book":"唐·陆贽《收河中后请罢兵状》"}},{"id":19042,"word":"急急如律令","pinyin":"jí jí rú lǜ lìng","abbr":"jjrll","explanation":"本是汉代公文用语，后来道士或巫师亦用于符咒的末尾。如同法律命令，必须立即遵照执行。","source":{"text":"若三日之内，一雨滂沱，是龙之灵，亦人之幸。礼无不报，神其听之！急急如律令。","book":"唐·白居易《祭龙文》"},"example":{"text":"有鬼有鬼，撮盐入水，太上老君，～，欶。","book":"元·关汉卿《窦娥冤》第四折"},"usage":"作宾语、定语、分句；用于宗教等"},{"id":19043,"word":"急急巴巴","pinyin":"jí jí bā bā","abbr":"jjbb","explanation":"形容急忙，紧急。","example":{"text":"他～地往回赶。"},"similar":["匆匆忙忙"],"opposite":["慢慢悠悠"],"usage":"作状语、定语；形容急忙，用于口语"},{"id":19044,"word":"急急忙忙","pinyin":"jí jí máng máng","abbr":"jjmm","explanation":"因为着急而行动加快，匆匆忙忙。","source":{"text":"一面说，一面带了两个丫头急急忙忙回到家中。","book":"清·曹雪芹《红楼梦》第101回"},"example":{"text":"何必～地要来‘统一’这块巴掌大的边区呢？","book":"毛泽东《质问国民党》"},"similar":["匆匆忙忙"],"opposite":["从容不迫","从从容容"],"usage":"作定语、状语；用于处事"},{"id":19045,"word":"急惊风撞着慢郎中","pinyin":"jí jīng fēng zhuàng zhe màn láng zhōng","abbr":"jjfzzmlz","explanation":"患急病遇到了慢性子的医生。比喻缓慢的行动赶不上紧急的需要。","source":{"text":"此时富家子正是：急惊风撞着了慢郎中。","book":"明·凌濛初《二刻拍案惊奇》卷三十三"},"example":{"text":"这真是～了，我家里死在床上，我如何等得急你呢？（《晚清文学丛钞·瞎编奇闻》第五回）"},"similar":["急惊风遇着慢郎中"],"usage":"作宾语、定语；用于方言"},{"id":19046,"word":"急扯白脸","pinyin":"jí chě bái liǎn","abbr":"jcbl","explanation":"心里着急，脸色难看。形容非常焦急的神情。","source":{"text":"她把气咽下去，丈夫是好意，可是，何必那么急扯白脸的呀！","book":"老舍《离婚》六"},"example":{"text":"王朔《千万别把我当人》：“‘没听说吃饭还要交押金的。’孙国仁～地嚷，‘种族歧视是不是？告诉你，我这是在自个国家。’”"},"usage":"作谓语、状语；指非常焦急"},{"id":19047,"word":"急拍繁弦","pinyin":"jí pāi fán xián","abbr":"jpfx","explanation":"犹言急管繁弦。形容各种乐器同时演奏的热闹情景。","source":{"text":"江梅冷艳酒清光，急拍繁弦醉画堂。","book":"唐·李郢《醉送》诗"},"similar":["急管繁弦","急竹繁丝"],"usage":"作宾语、定语；形容各种乐器同时演奏的情景"},{"id":19048,"word":"急效近功","pinyin":"jí xiào jìn gōng","abbr":"jxjg","explanation":"近：眼前的；功：成功。急于求成，贪图眼前的成效和利益。","source":{"text":"汉·董仲舒《春秋繁露·对胶西王》： “仁人者正其道不谋其利，修其理不急其功。”"}},{"id":19049,"word":"急敛暴征","pinyin":"jí liǎn bào zhēng","abbr":"jlbz","explanation":"严急而苛猛的赋税。","source":{"text":"长吏明知不申破，急敛暴征求考课。","book":"唐·白居易《杜陵叟》诗"},"similar":["横征暴敛"],"usage":"作谓语、宾语、定语；用于官吏等"},{"id":19050,"word":"急景凋年","pinyin":"jí yǐng diāo nián","abbr":"jydn","explanation":"景：通“影”，光阴；凋：凋零。形容光阴迅速，一年将尽。也指年终的时候。","source":{"text":"去帝乡之岑寂，归人寰之喧卑。岁峥嵘而愁暮，心惆怅而哀离。于是穷阴杀节，急景凋年，凉沙振野，箕风动天。","book":"南朝·宋·鲍照《舞鹤赋》"},"example":{"text":"想起长叙，同为户部侍郎而荣枯不同，～，谪居寂寞，应该去探头一望。","book":"高阳《清宫外史》上册"},"similar":["急景雕年"],"usage":"作宾语；形容光阴迅速，年岁将尽"},{"id":19051,"word":"急景流年","pinyin":"jí jǐng liú nián","abbr":"jjln","explanation":"形容光阴易逝。","source":{"text":"急景流年都一瞬，往事前欢，未免萦方寸。","book":"宋·晏殊《蝶恋花》词"},"similar":["急景雕年"],"usage":"作宾语、定语；形容时光飞逝"},{"id":19052,"word":"急景雕年","pinyin":"jí jǐng diāo nián","abbr":"jjdn","explanation":"急景：急促的时光；雕年：残年岁暮。光阴急促，岁残年尽。指岁暮景象。形容时间过得飞快。也指岁末。","source":{"text":"于是穷阴杀节，急景雕年，凉沙振野，箕风动天。","book":"南朝·宋·鲍照《鲍参军集》"},"example":{"text":"计时日正是农历的～。","book":"夏衍《粤北的春天》"},"similar":["急景流年"],"usage":"作主语、宾语；用于书面语"},{"id":19053,"word":"急来报佛脚","pinyin":"jí lái bào fó jiǎo","abbr":"jlbfj","explanation":"比喻事到临头才慌忙准备。","source":{"text":"王丞相嗜谐谑。一日，论沙门道，因曰：‘投老欲依僧。’客遽对曰：‘急则抱佛脚。’","book":"宋·刘攽《中山诗话》"},"example":{"text":"只有三年大阅是他们的一重关煞，那一种～情形，比起那些秀才们三年岁考还要急。","book":"清·李宝嘉《官场现形记》第六回"}},{"id":19054,"word":"急来抱佛脚","pinyin":"jí lái bào fó jiǎo","abbr":"jlbfj","explanation":"比喻事到临头才慌忙准备。","source":{"text":"王丞相嗜谐谑。一日，论沙门道，因曰：‘投老欲依僧。’客遽对曰：‘急则抱佛脚。’","book":"宋·刘攽《中山诗话》"},"example":{"text":"只有三年大阅是他们的一重关煞，那一种～情形，比起那些秀才们三年岁考还要急。","book":"清·李宝嘉《官场现形记》第六回"},"similar":["急则报佛脚"],"usage":"作谓语、分句；指事先不作准备","story":["古时有一个国家特别尊崇佛教，全国各地广造寺院，精塑大佛。有个犯了死罪的人在走投无路的情况下，急忙来到一座寺院，抱住一尊大佛的脚表示忏悔，官府见他心诚就赦免了他。后来只要有犯罪就去抱佛脚"]},{"id":19055,"word":"急杵捣心","pinyin":"jí chǔ dǎo xīn","abbr":"jcdx","explanation":"形容惊异不安的心情。","source":{"text":"见徐巨源与陈伯玑书，论仆晚年之文字，颛好骂人，传语相劝戒，为之咋指吐舌，急杵捣心者累日。","book":"清·钱谦益《答王于一秀才论文》"},"usage":"作宾语、定语；用于比喻句"},{"id":19056,"word":"急流勇进","pinyin":"jí liú yǒng jìn","abbr":"jlyj","explanation":"在急流中勇敢前进，形容果断、勇猛，一往无前。","source":{"text":"以火箸画灰，作‘做不得’三字，徐曰：‘急流勇退人也’。","book":"宋·邵伯温《邵氏见闻录》"},"example":{"text":"人们站在这幅照片前，感到一种～的撼人力量。","book":"何为《美的留影》"},"similar":["奋勇前进","一往无前","乘风破浪"],"opposite":["急流勇退","知难而退"],"usage":"作谓语、宾语、定语；指人一往无前"},{"id":19057,"word":"急流勇退","pinyin":"jí liú yǒng tuì","abbr":"jlyt","explanation":"在急流中勇敢地立即退却。比喻做官的人在得意时为了避祸而及时引退。","source":{"text":"火色上腾虽有数，急流勇退岂无人。","book":"宋·苏轼《赠善相程杰》诗"},"example":{"text":"官人宜～，为山林娱老之计。","book":"明·冯梦龙《警世通言》卷三十一"},"similar":["激流勇退","明哲保身"],"opposite":["激流勇进","知难而进"],"usage":"作主语、谓语、宾语；指及时隐退"},{"id":19058,"word":"急病让夷","pinyin":"jí bìng ràng yí","abbr":"jbry","explanation":"犹今言将困难留给自己，将方便让给别人。","source":{"text":"贤者急病而让夷。","book":"语出《国语·鲁语上》"},"example":{"text":"公曰：‘古人辞易不辞难，～，吾之志也。","book":"宋·王禹偁《殿中丞赠太常少卿桑公神道碑铭序》"},"usage":"作谓语、定语；用于书面语"},{"id":19059,"word":"急痛攻心","pinyin":"jí tòng gōng xīn","abbr":"jtgx","explanation":"心里感到极度的焦急与悲痛。","source":{"text":"泪长如线，灯暗无花。梦霞得此意外之惊耗，急痛攻心，为之晕绝。良久始稍清醒，危坐如痴，神色沮丧。","book":"徐枕亚《玉梨魂》第二十四章"}},{"id":19060,"word":"急竹繁丝","pinyin":"jí zhú fán sī","abbr":"jzfs","explanation":"形容各种乐器同时演奏的热闹情景。同“急管繁弦”。","source":{"text":"急竹繁丝互催逼，吴娘娇浓玉无力。","book":"宋·翁卷《白紵词》"},"similar":["急管繁弦","急拍繁弦"],"usage":"作宾语、定语；形容各种乐器同时演奏的情景"},{"id":19061,"word":"急管繁弦","pinyin":"jí guǎn fán xián","abbr":"jgfx","explanation":"急：快；繁：杂。形容各种乐器同时演奏的热闹情景。","source":{"text":"绣幕卷波香引穗，急管繁弦，共爱人间瑞。","book":"唐·白居易《忆旧游》：“修蛾慢脸灯下醉，急管繁弦头上催。”宋·晏殊《蝶恋花》词"},"example":{"text":"一面默念，一面想象着红裙翠袖，～的光景，恨不得即时能作查楼上的座上客。","book":"高阳《玉座珠帘》下册"},"similar":["急竹繁丝","急拍繁弦"],"usage":"作宾语、定语；形容各种乐器同时演奏的情景"},{"id":19062,"word":"急脉缓受","pinyin":"jí mài huǎn shòu","abbr":"jmhs","explanation":"比喻用和缓的办法应付急事。也比喻诗文在进行中，故意放松一笔，以造成抑扬顿挫之势。同“急脉缓灸”。","source":{"text":"治病寻源，他这病源全在痛亲而不知慰亲，守志而不知继志，所以才把个见识弄左了。要不急脉缓受，且把邓翁的话撇开，先治他这个病源，只怕越说越左。","book":"清·文康《儿女英雄传》第二十五回"},"similar":["急脉缓灸"],"usage":"作谓语、定语；比喻以缓和的办法应付急事"},{"id":19063,"word":"急脉缓灸","pinyin":"jí mài huǎn jiǔ","abbr":"jmhj","explanation":"比喻用和缓的办法应付急事。也比喻诗文在进行中，故意放松一笔，以造成抑扬顿挫之势。","source":{"text":"对句不好，合掌。下句推开一步，倒还是急脉缓灸法。","book":"清·曹雪芹《红楼梦》第七十六回"},"example":{"text":"要不～，且把邓老的庆撇开，先治她这个病源，只怕越说越左。","book":"清·文康《儿女英雄传》第二十五回"},"similar":["急脉缓受"],"usage":"作谓语、定语；比喻以缓和的办法应付急事"},{"id":19064,"word":"急赤白脸","pinyin":"jí chì bái liǎn","abbr":"jcbl","explanation":"心里着急，脸色难看。形容非常焦急的神情。","source":{"text":"她把气咽下去，丈夫是好意，可是，何必那么急扯白脸的呀！","book":"老舍《离婚》六"}},{"id":19065,"word":"急起直追","pinyin":"jí qǐ zhí zhuī","abbr":"jqzz","explanation":"立即行动起来，努力追赶上去。","source":{"text":"故今日之乱，且置无丰，元祐勿论，宜度时之所宜为者，急起而趋之，如拯焚救罔，不然，袭常祖故，以乱救乱，天下纷纷，何时而定也。","book":"宋·孙觌《鸿庆居士文集》"},"example":{"text":"值此建设时代，内乱外患，险象环生，各行政官力负责任，～。","book":"蔡东藩、许厪父《民国通俗演义》第三十五回"},"similar":["不甘落后","奋起直追"],"opposite":["停滞不前","得过且过"],"usage":"作谓语、宾语、定语；指立即行动追赶上去"},{"id":19066,"word":"急趋无善迹","pinyin":"jí qū wú shàn jì","abbr":"jqwsj","explanation":"比喻办事求快就不可能尽善尽美。","source":{"text":"然而急趋无善迹，促柱少和声，拯溺不规行，疗饥不足食。即向时之妙策，乃当今之刍向也。","book":"晋·葛洪《西京杂记》：“长卿首尾温丽，枚皋时有累句。故知疾行无善迹也。”《旧唐书·朱敬则传》"}},{"id":19067,"word":"急躁冒进","pinyin":"jí zào mào jìn","abbr":"jzmj","explanation":"想赶快达到目的，不经仔细考虑或准备就急于行动。","source":{"text":"有时表现为右倾保守，思想落后实际，有时又表现为急躁冒进，贪多求快，超过实际的可能。","book":"邓小平《关于修改党的章程的报告》"},"similar":["急躁轻进"],"usage":"作谓语、宾语、定语；用于处事"},{"id":19068,"word":"急转直下","pinyin":"jí zhuǎn zhí xià","abbr":"jzzx","explanation":"形容形势或文笔等突然转变，并且很快地顺势发展下去。","source":{"text":"事变之来，急转直下，其相煎迫者未知所纪极。","book":"清·梁启超《论各国干涉中国财政之动机》"},"example":{"text":"由于迅速而顺利地取得了辽沈战役的胜利，就使全国战局～，使原来预计的战争进程大为缩短。","book":"叶剑英《伟大的战略决战》"},"similar":["大势所趋"],"opposite":["扶摇直下","相持不下"],"usage":"作谓语、定语、状语；形容突然转变"},{"id":19069,"word":"急风暴雨","pinyin":"jí fēng bào yǔ","abbr":"jfby","explanation":"急：又快又猛；暴：突然而猛烈。形容风雨来势猛。比喻迅猛激烈的斗争。","source":{"text":"何谓隐之天？大寒甚暑，疾风暴雨，大雾冥晦，因此而为变者也。","book":"《淮南子·兵略训》"},"example":{"text":"这个攻击的形势，简直是～，顺之者存，违之者灭。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["疾风暴雨","暴风骤雨"],"opposite":["和风细雨"],"usage":"作主语、宾语；形容声势浩大"},{"id":19070,"word":"急风骤雨","pinyin":"jí fēng zhòu yǔ","abbr":"jfzy","explanation":"急剧的风雨。常用以形容声势浩大而迅猛。","source":{"text":"至于神话，希腊、印度皆立男女二神，而急风骤雨则群指为天神战斗之事。","book":"章炳麟《五无论》"},"example":{"text":"忽然，那只最大的、像战鼓一样雄壮的大三弦停止了，却在这～一样的无数三弦的奏鸣中，出现了一只跳动着热情的笛子。","book":"方纪《歌声和笛声》"},"similar":["暴风骤雨","急风暴雨"],"usage":"作主语、宾语；形容声势浩大"},{"id":19071,"word":"怦然心动","pinyin":"pēng rán xīn dòng","abbr":"prxd","explanation":"心怦怦地跳动。","source":{"text":"私自怜兮何极，心怦怦兮谅直。","book":"战国·楚·宋玉《九辩》"},"example":{"text":"我一见到她就～。"},"similar":["心惊胆颤","心神不定"],"opposite":["心安理得"],"usage":"作谓语；指由于受某种事物的吸引而跳动"},{"id":19072,"word":"性命交关","pinyin":"xìng mìng jiāo guān","abbr":"xmjg","explanation":"清·张春帆《宦海》第十一回：“这个性命交关的事情，不是可以试得的。”","source":{"text":"不过动兵打仗的事不是耍的，～！（叶圣陶《外国旗》）"},"example":{"text":"洪深《五奎桥》第一幕：“这是乡下人～的事！你还在糊里糊涂，看成这样平常呢。”"},"similar":["性命关天","性命攸关"],"usage":"作谓语、定语；形容事关重大"},{"id":19073,"word":"性命关天","pinyin":"xìng mìng guān tiān","abbr":"xmgt","explanation":"犹言性命交关。形容关系重大，非常紧要。","source":{"text":"他本是一个寒儒，怎犯下十恶大罪，方信道日月虽明，不照那覆盆之内。我为甚重推重审，却不道人性命关天关地。","book":"元·王仲文《救孝子》第四折"},"example":{"text":"出了差错，～。王姑娘，叩头接旨吧。","book":"曹禺《王昭君》第一幕"},"similar":["人命关天"],"usage":"作谓语、定语；用于处事"},{"id":19074,"word":"性命攸关","pinyin":"xìng mìng yōu guān","abbr":"xmyg","explanation":"攸关：相关。形容关系重大，非常紧要。","source":{"text":"此时人家正在性命交关，不过一时救急，自然是我们三个人去，那里有几营人来给你带去。","book":"清·刘鹗《老残游记》第一回"},"example":{"text":"不过那一次是为了治伤，～，不得不从权处置。","book":"金庸《鹿鼎记》第二十三回"},"similar":["性命交关"],"usage":"作谓语、定语；形容事关重大"},{"id":19075,"word":"性急口快","pinyin":"xìng jí kǒu kuài","abbr":"xjkk","explanation":"性子急，有话就说。","source":{"text":"那何小姐性急口快，便道：‘娘这话也说得是，那么着，我就在家里服侍婆婆，叫我妹子跟了他去。’","book":"清·文康《儿女英雄传》第40回"},"usage":"作谓语、定语、状语；用于处事"},{"id":19076,"word":"性情中人","pinyin":"xìng qíng zhōng rén","abbr":"xqzr","explanation":"性情：性格。有性格和真情实感的人。","source":{"text":"认定了姑娘是个性情中人，所以也把性情来感动他。","book":"清·文康《儿女英雄传》第25回"},"example":{"text":"我们都是～，有血有肉。"},"usage":"作宾语、定语；指有个性的人"},{"id":19077,"word":"性烈如火","pinyin":"xìng liè rú huǒ","abbr":"xlrh","explanation":"性：性情，脾气。形容性情暴躁。","example":{"text":"那高个儿的僧人～，提起醋钵大的拳头，呼的一拳，又向乔峰击到。","book":"金庸《天龙八部》第十八回"},"usage":"作谓语、定语；用于人的性格"},{"id":19078,"word":"性直口快","pinyin":"xìng zhí kǒu kuài","abbr":"xzkk","explanation":"性情直爽，有话就说。","source":{"text":"文丞相心直口快，男子民。","book":"宋·文天祥《指南录·一·纪事诗四首序》"},"example":{"text":"余～，不能曲折。","book":"清·方东树《大意尊闻·接物》"}},{"id":19079,"word":"怨入骨髓","pinyin":"yuàn rù gǔ suǐ","abbr":"yrgs","explanation":"恨到骨头里。形容怨恨到极点。","source":{"text":"文公夫人，秦女也，为秦三囚将请曰：‘缪公之怨此三人入于骨髓，愿令此三人妇，令我君得自愉烹之。’晋君许之，归秦三将。","book":"《史记·秦本纪》"},"example":{"text":"锜僭侈诛求，六州之人～。","book":"《新唐书·李绛传》"},"similar":["恨之入骨"],"usage":"作谓语、定语；指十分怨恨"},{"id":19080,"word":"怨声满道","pinyin":"yuàn shēng mǎn dào","abbr":"ysmd","explanation":"怨恨的声音充满道路。形容人民群众普遍强烈不满。","source":{"text":"开门受赂，署用非次，天下纷然，怨声满道。","book":"《后汉书·李固传》"},"similar":["怨声载道","怨声盈路","怨声载路"],"usage":"作谓语、定语、状语；指极为不满","story":["东汉时期，外戚和宦官之间的斗争十分激烈，汉顺帝下诏，让各地有才能的人到都城洛阳参加考试，选拔出李固担任议郎，李固被宦官排挤出京城，就给大将军梁商写信，希望朝廷吸取历史经验教训，杜绝奢侈浪费，避免百姓怨声载道"]},{"id":19081,"word":"怨声盈路","pinyin":"yuàn shēng yíng lù","abbr":"ysyl","explanation":"盈：满。怨恨的声音充满道路。形容人民群众普遍强烈不满。","source":{"text":"肇既当衡轴，每事任己，本无学识，动违礼度，好改先朝旧制，出情妄作，减削封秩，抑黜勋人。由是怨声盈路矣。","book":"《魏书·高肇传》"},"example":{"text":"百姓不堪需索，～。","book":"蔡东藩《两晋演义》第四十八回"},"similar":["怨声载路","怨声载道","怨声满道"],"usage":"作谓语、定语、状语；指极为不满"},{"id":19082,"word":"怨声载路","pinyin":"yuàn shēng zài lù","abbr":"yszl","explanation":"载：充满。怨恨的声音充满道路。形容人民群众普遍强烈不满。","source":{"text":"开门受赂，署用非次，天下纷然，怨声满道。","book":"《诗经·大雅·生民》：“实覃实訏，厥声载路。”《后汉书·李固传》"},"example":{"text":"州县征输，星火逼迫，或谋计靡所，或鬻卖以充，～，和气未洽。","book":"《旧唐书·张廷珪传》"},"similar":["怨声载道","怨声盈路","载道怨声"],"usage":"作谓语、定语、状语；指极为不满"},{"id":19083,"word":"怨声载道","pinyin":"yuàn shēng zài dào","abbr":"yszd","explanation":"载：充满。怨恨的声音充满道路。形容人民群众普遍强烈不满。","source":{"text":"开门受赂，署用非次，天下纷然，怨声满道。","book":"《诗比·大雅·生民》：“实覃实訏，厥声载路。”《后汉书·李固传》"},"example":{"text":"凡有些余利的，一概入了官中，那时里外～，岂不失了你们这样人家的大体？","book":"清·曹雪芹《红楼梦》第五十六回"},"similar":["民怨沸腾","天怒人怨","怨天忧人"],"opposite":["口碑载道","有口皆碑"],"usage":"作谓语、定语、状语；指极为不满","story":["东汉时期，外戚和宦官之间的斗争十分激烈，汉顺帝下诏，让各地有才能的人到都城洛阳参加考试，选拔出李固担任议郎，李固被宦官排挤出京城，就给大将军梁商写信，希望朝廷吸取历史经验教训，杜绝奢侈浪费，避免百姓怨声载道"]},{"id":19084,"word":"怨天尤人","pinyin":"yuàn tiān yóu rén","abbr":"ytyr","explanation":"天：天命，命运；尤：怨恨，归咎。指遇到挫折或出了问题，一味报怨天，责怪别人。","source":{"text":"不怨天，不尤人，下学而上达，知我者其天乎！","book":"《论语·宪问》"},"example":{"text":"便是那愤懑不平之气，放诞无忌惮之言，心中口中，～个不了。","book":"明·东鲁古狂生《醉醒石》第六回"},"similar":["怨天忧人"],"opposite":["任劳任怨","自怨自艾"],"usage":"作主语、谓语、定语；指抱怨","story":["春秋时期，孔子终生为实现自己的主张而忙碌奔波，很少人采纳他的政治主张，孔子对学生发感慨，子贡问为什么？孔子说自己不怨天、不尤人，下学而上达。努力学习一些平常的知识，却透彻了解很多的道理，只有老天才了解自己"]},{"id":19085,"word":"怨天忧人","pinyin":"yuàn tiān yóu rén","abbr":"ytyr","explanation":"怨：怨恨；天：命运；忧：怨：怨恨；天：命运；忧：责怪。怨恨天命，责怪别人。形容遇到不称心的事情一味归咎客观，埋怨别人。","source":{"text":"不怨天，不尤人，下学而上达。","book":"先秦·孔子《论语·宪问》"},"example":{"text":"要从失败中总结教训，不要～。"},"similar":["民怨沸腾","怨声载道","天怒人怨"],"opposite":["任劳任怨","自怨自艾"],"usage":"作主语、谓语、定语；指抱怨","story":["春秋时期，孔子终生为实现自己的主张而忙碌奔波，很少人采纳他的政治主张，孔子对学生发感慨，子贡问为什么？孔子说自己不怨天、不尤人，下学而上达。努力学习一些平常的知识，却透彻了解很多的道理，只有老天才了解自己"]},{"id":19086,"word":"怨天怨地","pinyin":"yuàn tiān yuàn dì","abbr":"ytyd","explanation":"抱怨天又抱怨地。形容埋怨不休。","source":{"text":"到今日，悔，悔，悔。也是我前世前缘，自作自受，怨天怨地。","book":"元·高文秀《遇上皇》第三折"},"example":{"text":"逢我们使他们一使儿，就～的。你说说可有良心？","book":"清·曹雪芹《红楼梦》第59回"},"similar":["怨天尤人"],"opposite":["引咎自责"],"usage":"作谓语；指埋怨"},{"id":19087,"word":"怨女旷夫","pinyin":"yuàn nǚ kuàng fū","abbr":"ynkf","explanation":"指没有配偶的成年男女。","source":{"text":"内无怨女，外无旷无。","book":"《孟子·梁惠王上》"},"example":{"text":"假若是～，买成了成双作对。","book":"元·无名氏《百花亭》第三折"},"similar":["旷夫怨女"],"usage":"作主语、宾语、定语；指未婚男女"},{"id":19088,"word":"怨家债主","pinyin":"yuàn jiā zhài zhǔ","abbr":"yjzz","explanation":"怨家：仇人。佛教指与我有冤仇的人。","source":{"text":"怨家债主，焚漂劫夺。","book":"《无量寿经》卷下"},"example":{"text":"业道受苦及～悉愿布施欢喜。","book":"唐·孔思义《造像记》"},"similar":["冤家债主"],"usage":"作宾语、定语；指仇人"},{"id":19089,"word":"怨府祸梯","pinyin":"yuàn fǔ huò tī","abbr":"yfht","explanation":"怨府：众怨归聚的地方；祸梯：祸害的由来。指怨恨的集中点，祸害的根由。","source":{"text":"毋为怨府，毋为祸梯。","book":"《史记·赵世家》"},"usage":"作宾语、定语；用于书面语"},{"id":19090,"word":"怨怨哀哀","pinyin":"yuàn yuàn āi āi","abbr":"yyaa","explanation":"形容哀怨的样子。","source":{"text":"空教我闷转加、愁无奈，只落得哭哭啼啼、怨怨哀哀。","book":"元·关汉卿《蝴蝶梦》第四折"},"example":{"text":"没来由～，我这里七林林转过庭槐，慢腾腾行过厅阶，孤椿椿靠定明亮隔。","book":"元·马致远《黄梁梦》第二折"}},{"id":19091,"word":"怨怨焦焦","pinyin":"yuàn yuàn jiāo jiāo","abbr":"yyjj","explanation":"哀怨焦急的样子。","source":{"text":"呀！见孩儿卧血泊，那一个哭哭号号，这一个怨怨焦焦，连我也战战摇摇，直恁般歹做作，只除是没大道。","book":"元·纪君祥《赵氏孤儿》第三折"}},{"id":19092,"word":"怨旷思归","pinyin":"yuàn kuàng sī guī","abbr":"yksg","explanation":"旷：久；怨旷：长期别离。长期别离，盼望早日还乡。","source":{"text":"又操军吏士，其可战者皆自出幽冀，或故营部曲，咸怨旷思归，流涕北顾。","book":"汉·陈琳《为袁绍檄豫州》"},"example":{"text":"留义募将士既久，咸～，或有辄去者，乃题鄴城门。","book":"《晋书·成都王颖传》"},"usage":"作谓语、定语；用于书面语"},{"id":19093,"word":"怨气冲天","pinyin":"yuàn qì chōng tiān","abbr":"yqct","explanation":"怨愤之气冲到天空。形容怨恨情绪极大。","source":{"text":"员一见其尸，怨气冲天，手持九节铜鞭，鞭之三百，肉烂骨折。","book":"明·冯梦龙《东周列国志》第七十六回"},"example":{"text":"其时百姓为贪官所逼，～，早已大众齐心，一呼百应。（清·李宝嘉《文明小史》第九回）"},"similar":["怒发冲冠"],"opposite":["心平气和","泰然自若"],"usage":"作谓语、宾语；形容人的情绪"},{"id":19094,"word":"怨气满腹","pinyin":"yuàn qì mǎn fù","abbr":"yqmf","explanation":"胸中充满了怨恨的情绪。形容怨愤之气极大。","source":{"text":"即位三十年，百姓怨气满腹。","book":"《后汉书·祭祀志上》"},"usage":"作谓语、状语；用于处事"},{"id":19095,"word":"怨离惜别","pinyin":"yuàn lí xī bié","abbr":"ylxb","explanation":"怨：怨恨；惜：舍不得。依依恋恋不忍分手。常用于男女之间。","source":{"text":"两下里怨离惜别，分外恩情，一言难尽。","book":"明·冯梦龙《喻世明言》卷一"},"usage":"作谓语、定语；用于交往等"},{"id":19096,"word":"怨词詈语","pinyin":"yuàn cí lì yǔ","abbr":"ycly","explanation":"抱怨与骂人的话语","source":{"text":"这老妪独居，谁人到此，亦有诗句？足见怨词詈语遍于人间矣！","book":"明·冯梦龙《警世通言》第四卷"},"usage":"作主语、宾语；用于书面语"},{"id":19097,"word":"怪事咄咄","pinyin":"guài shì duō duō","abbr":"gsdd","explanation":"表示吃惊的声音。形容不合常理，难以理解的怪事。同“咄咄怪事”。"},{"id":19098,"word":"怪力乱神","pinyin":"guài lì luàn shén","abbr":"glls","explanation":"指关于怪异、勇力、叛乱、鬼神之事。","source":{"text":"子不语怪、力、乱、神。","book":"《论语·述而》"},"example":{"text":"孔子不语～，非不语也，盖有未易语者耳。","book":"宋·周密《齐东野语》卷十二"},"usage":"作宾语、定语；指关于怪异、勇力、叛乱、鬼"},{"id":19099,"word":"怪声怪气","pinyin":"guài shēng guài qì","abbr":"gsgq","explanation":"形容声音、语调、唱腔等滑稽或古怪难听。","source":{"text":"以关老爷、林妹妹自命，怪声怪气，唱来唱去，那就实在只好算是发热昏了。","book":"鲁迅《二心集·宣传与做戏》"},"example":{"text":"我愤怒地～地学着唱。"},"similar":["阴阳怪气"],"opposite":["字正腔圆"],"usage":"作谓语、定语、宾语；指人的声音等"},{"id":19100,"word":"怪形怪状","pinyin":"guài xíng guài zhuàng","abbr":"gxgz","explanation":"奇异古怪的形态、样子。"},{"id":19101,"word":"怪怪奇奇","pinyin":"guài guài qí qí","abbr":"ggqq","explanation":"各种各样，形形色色。","source":{"text":"不专一能，怪怪奇奇。","book":"唐·韩愈《送穷文》"}},{"id":19102,"word":"怪模怪样","pinyin":"guài mó guài yàng","abbr":"gmgy","explanation":"形容装扮异，形态古怪。","source":{"text":"龙老三，你还不把那些衣服脱了？人看着怪模怪样。","book":"清·吴敬梓《儒林外史》第二十九回"},"example":{"text":"女娲圆睁了眼睛，好不容易才醒悟到这便是自己先前做的小东西，只是～的已经都用什么包了身子。","book":"鲁迅《补天》"},"similar":["稀奇古怪"],"opposite":["规规矩矩"],"usage":"作谓语、定语；指形态奇怪"},{"id":19103,"word":"怪腔怪调","pinyin":"guài qiāng guài diào","abbr":"gqgd","explanation":"指说话或唱歌的声音稀奇古怪。","source":{"text":"小姐，出来进去，无聊地谈神说鬼，还怪腔怪调地哼着唱着，叫人发麻。","book":"《星火燎原》"},"example":{"text":"我不愿听你的～。"},"similar":["阴阳怪气"],"usage":"作宾语、状语；指人阴阳怪气"},{"id":19104,"word":"怪诞不经","pinyin":"guài dàn bù jīng","abbr":"gdbj","explanation":"怪诞：离奇古怪；不经：不合常理。指言语奇怪荒唐，不合常理。","source":{"text":"乌公以为诗虽奇妙，而怪诞不经，不许。","book":"明·瞿佑《剪灯新话·听经猿记》"},"example":{"text":"不然，何所论之怪诞不经，独不虑旁观者之闵笑也？","book":"清·严复《原强》"},"similar":["荒谬绝伦"],"usage":"作定语、补语；指言语奇怪荒唐"},{"id":19105,"word":"怪诞诡奇","pinyin":"guài dàn guǐ qí","abbr":"gdgq","explanation":"怪诞：荒唐，离奇；诡奇：诡诈，奇异。形容荒唐离奇的事物。","example":{"text":"这样～的事让人难以置信。"},"similar":["怪诞不经"],"usage":"作定语、补语；指言语奇怪荒唐"},{"id":19106,"word":"怪里怪气","pinyin":"guài lǐ guài qì","abbr":"glgq","explanation":"形状、装束、声音等奇怪，跟一般的不同。","source":{"text":"在马锐看来，父亲自从戴上那副怪里怪气的眼镜，就整天失魂落魄的。","book":"王朔《我是你爸爸》"},"example":{"text":"他这个人就是这样～。"},"similar":["阴阳怪气"],"usage":"作谓语、定语；用于形状、装束、声音等"},{"id":19107,"word":"怪雨盲风","pinyin":"guài yǔ máng fēng","abbr":"gymf","explanation":"犹疾风暴雨。形容风雨来势猛。比喻迅猛激烈的斗争。","source":{"text":"怪雨盲风，留不住江边行色。","book":"宋·刘克庄《满江红·和王实之韵送伯昌》词"},"example":{"text":"黄昏蜃气忽成楼，～引客舟。","book":"《花月痕》第三回"},"similar":["暴风骤雨"],"usage":"作主语、宾语、定语；用于口语"},{"id":19108,"word":"怫然不悦","pinyin":"fú rán bù yuè","abbr":"frby","explanation":"怫然：忧愁或愤怒的样子；悦：愉快，高兴。愤怒，很不愉快。","source":{"text":"曾西艴然不悦。","book":"《孟子·公孙丑上》"},"example":{"text":"他～地走出了教室"},"similar":["怫然而怒","怫然作色"],"usage":"作谓语、定语、状语；用于生气时"},{"id":19109,"word":"怫然作色","pinyin":"fú rán zuò sè","abbr":"frzs","explanation":"怫然：愤怒的样子。脸上现出愤怒之色。","source":{"text":"谓己謏人，则怫然作色。","book":"战国·宋·庄周《庄子·天地》"},"example":{"text":"听到这个消息，他～。"},"similar":["忿然作色"],"usage":"作谓语；指发怒"},{"id":19110,"word":"怫然而怒","pinyin":"fèi rán ér nù","abbr":"fren","explanation":"怫然：愤怒的样子。指突然发怒。","source":{"text":"我怫然而怒。","book":"战国·宋·庄周《庄子·德充符》"},"similar":["勃然大怒"],"usage":"作谓语、定语、状语；用于生气时"},{"id":19111,"word":"怯声怯气","pinyin":"qiè shēng qiè qì","abbr":"qsqq","explanation":"形容说话的语气胆小而不自然。","example":{"text":"他说话～的，没见过什么世面。"},"usage":"作谓语、定语、状语；指胆小"},{"id":19112,"word":"怯大压小","pinyin":"qiè dà yā xiǎo","abbr":"qdyx","explanation":"怯：害怕，畏惧；压：压制。害怕强大的打压弱小的。","example":{"text":"她就是～的人。"},"similar":["欺软怕硬"],"usage":"作谓语、定语、宾语；用于人处世"},{"id":19113,"word":"怯防勇战","pinyin":"qiè fáng yǒng zhàn","abbr":"qfyz","explanation":"小心设防，勇敢出战。","source":{"text":"怯防勇战，此之谓也。","book":"《梁书·冯道根传》"},"example":{"text":"诸君不闻～？若俟寇逼城下，何暇及此！","book":"蔡东藩《南北史演义》第四十回"},"usage":"作谓语；指小心防守而勇于战斗"},{"id":19114,"word":"怵心刿目","pinyin":"chù xīn guì mù","abbr":"cxgm","explanation":"怵：恐惧；刿：刺伤。看到某种事物或景象使人痛心。","source":{"text":"陶潜谢脁诗皆平淡有思致，非后来诗人怵心刿目雕琢者所为也。","book":"宋·葛立方《韵语阳秋》"},"similar":["触目惊心"],"usage":"作谓语、定语；用于事物等"},{"id":19115,"word":"怵惕恻隐","pinyin":"chù tì cè yǐn","abbr":"ctcy","explanation":"怵惕：惊恐害怕。形容人既担惊受怕，又同情怜悯。","source":{"text":"今人乍见孺子将入于井，皆有怵惕恻隐之心。","book":"《孟子·公孙丑上》"}},{"id":19116,"word":"怵目惊心","pinyin":"chù mù jīng xīn","abbr":"cmjx","explanation":"看见某种严重情况，心里感到震惊。","source":{"text":"及其为诗，刿目怵心。","book":"唐·韩愈《昌黎集·贞曜先生墓志铭》"},"example":{"text":"你记得复辟与龙旗的不可分离性，你便会原谅我看见“龙凤”二字而不禁～的苦衷了。","book":"闻一多《龙凤》"},"similar":["触目惊心"],"usage":"作谓语、定语；形容让人震惊的场面"},{"id":19117,"word":"总总林林","pinyin":"zǒng zǒng lín lín","abbr":"zzll","explanation":"形容众多。","source":{"text":"惟人之初，总总而生，林林而群。","book":"唐·柳宗元《贞符》"},"example":{"text":"天地初开，万象化生，自色自形，～，莫得而名也。","book":"明·宋濂《画原》"},"similar":["林林总总"],"usage":"作谓语、定语；用于书面语"},{"id":19118,"word":"总而言之","pinyin":"zǒng ér yán zhī","abbr":"zeyz","explanation":"总的说起来。","source":{"text":"若总而言之，殆不可胜算。","book":"《容斋随笔·卷六·洗儿金钱》"},"example":{"text":"～，长征是以我们胜利、敌人失败的结果而千结束。","book":"《毛泽东选集·论反对帝国主义的策略》"},"similar":["综上所述","一言以蔽之"],"usage":"作分句；用于文章中起承上启下作用"},{"id":19119,"word":"总角之交","pinyin":"zǒng jiǎo zhī jiāo","abbr":"zjzj","explanation":"总角：儿童发髻向上分开的结果童年。指童年时期就结交的朋友。","source":{"text":"邵字敬祖，少与武帝同年，有总角之好。","book":"《礼记·内则》：“拂髻，总角。”郑玄注：“总角，收髻结之。”《晋书·何劭传》"},"example":{"text":"莫逆交不足恃矣，然～，应非泛泛也。","book":"清·霁园主人《夜谭随录·崔秀才》"},"similar":["青梅竹马","两小无猜"],"usage":"作宾语；指儿时的朋友"},{"id":19120,"word":"总角之好","pinyin":"zǒng jiǎo zhī hǎo","abbr":"zjzh","explanation":"指小时候很要好的朋友。","source":{"text":"邵字敬祖，少与武帝同年，有总角之好。","book":"《三国志·吴志·周瑜传》裴松之注引《江表传》：“周公瑾英俊异才，与孤有总角之好。”《晋书·何劭传》"},"example":{"text":"《三国志·吴志·周瑜传》裴松之注引《江表传》：“周公瑾英俊异才，与孤有总角之好。”《晋书·何劭传》：“邵字敬祖，少与武帝同年，有总角之好。”"},"similar":["总角之交","总角相交"],"usage":"作宾语；用于交往等"},{"id":19121,"word":"总角相交","pinyin":"zǒng jiǎo xiāng jiāo","abbr":"zjxj","explanation":"总角：古代儿童把头发向上束成小髻，指童年。小时候就很要好的朋友","source":{"text":"在临终的病床上，叶楚波颤巍巍地向孩提时代总角相交的故人托孤，要求苏凤麒把玉菡抚养成人。","book":"张扬《第二次握手》"},"similar":["总角之好","总角之交"],"usage":"作宾语、定语；用于交往等"},{"id":19122,"word":"恂恂善诱","pinyin":"xún xún shàn yòu","abbr":"xxsy","explanation":"恂恂：有次序的样子；善：善于；诱：引导。指善于引导别人进行学习。","source":{"text":"岂悟君子，自生怠倦，失恂恂善诱之德，同亡国骄惰之志！盖见机而作，不俟终日，是以夙退自引，畏使君劳。","book":"汉·赵壹《报皇甫规书》"},"example":{"text":"纯恩下钓，客旅上摛，～，肃肃风驰。","book":"蔡东藩《两晋演义》第九十二回"},"similar":["循循善诱","循循诱人"],"usage":"作谓语、定语、状语；用于教育"},{"id":19123,"word":"恃功傲宠","pinyin":"shì gōng ào chǒng","abbr":"sgac","explanation":"恃：倚仗。倚仗自己有功受宠而作威作福。","source":{"text":"虽其尽忠劳心，时有补益，而恃功矜宠，威福自出。","book":"《新五代史·安得诲传》"}},{"id":19124,"word":"恃功务高","pinyin":"shì gōng wù gāo","abbr":"sgwg","explanation":"恃：倚仗；务：追求；高：高傲。倚仗自己有功劳而追求过高的目标。","source":{"text":"魏延平日恃功务高，人皆下之。","book":"明·罗贯中《三国演义》第一百五回"}},{"id":19125,"word":"恃功岸忽","pinyin":"shì gōng àn hū","abbr":"sgah","explanation":"恃：倚仗；岸忽：怠慢。自恃有功，傲慢无理。","source":{"text":"朝恩资小人，恃功岸忽无所惮。","book":"《新唐书·鱼朝恩传》"}},{"id":19126,"word":"恃功矜宠","pinyin":"shì gōng jīn chǒng","abbr":"sgjc","explanation":"恃：倚仗；矜：自尊自大。倚仗自己有功受宠而作威作福。","source":{"text":"虽其尽忠劳心，时有补益，而恃功矜宠，威福自出。","book":"《新五代史·安得诲传》"}},{"id":19127,"word":"恃勇轻敌","pinyin":"shì yǒng qīng dí","abbr":"syqd","explanation":"恃：倚仗，仗恃。仗着自己勇敢而不把对手放在心上。","source":{"text":"又矫称别奉圣旨，以知节恃勇轻敌，使文度为其节制，遂收军不许深入。","book":"《旧唐书·苏定方传》"},"example":{"text":"汝本～而来，探吾虚实，于中取事，却以甜言哄我。","book":"清·褚人获《隋唐演义》第五十一回"},"usage":"作谓语、定语；用于处事"},{"id":19128,"word":"恃强争霸","pinyin":"shì qiáng zhēng bà","abbr":"sqzb","explanation":"凭借自己的强大争夺霸权。","source":{"text":"只为他生在恃强争霸、政出权门的春秋时代，和他所抱的王道主意，有些扞格不通，以致栖栖皇皇了一世。","book":"丁寅生《孔子演义》第一回"},"example":{"text":"美国～，悍然发动入侵伊拉克的战争。"},"usage":"作谓语、定语；用于斗争等"},{"id":19129,"word":"恃强倚宠","pinyin":"shì qiáng yǐ chǒng","abbr":"sqyc","explanation":"恃、倚：倚仗，凭借。倚仗自己手段高强，又倚仗主人的宠爱。","source":{"text":"今日是庆寿良辰，争奈这嫦娥恃强倚宠，卖弄新鲜题目，平白惹这场闲气，我至今还觉不平！幸亏百花姐姐有情有理，说得他满面羞惭，无言可答。","book":"清·李汝珍《镜花缘》第二回"},"usage":"作谓语、定语；用于处事"},{"id":19130,"word":"恃强凌弱","pinyin":"shì qiáng líng ruò","abbr":"sqlr","explanation":"凌：欺凌。依仗强大，欺侮弱小。","source":{"text":"那桀纣有何罪过？也无非倚贵欺贱，恃强凌弱，总来不过是使势而已。","book":"明·冯梦龙《警世通言》卷三"},"example":{"text":"河西地久升平，文公霸后称强盛。岂料吴人来犯境，～要先盟。","book":"明·梁辰鱼《浣纱记·同盟》"},"similar":["恃强欺弱","仗势欺人"],"opposite":["望而生畏"],"usage":"作谓语、定语；指欺负弱小"},{"id":19131,"word":"恃强怙宠","pinyin":"shì qiáng hù chǒng","abbr":"sqhc","explanation":"恃、怙：倚仗，凭借。倚仗权势凭借宠幸，骄横作恶。","source":{"text":"恃势怙宠之辈，渔食百姓。","book":"《后汉书·朱晖传》"}},{"id":19132,"word":"恃强欺弱","pinyin":"shì qiáng qī ruò","abbr":"sqqr","explanation":"依仗强大，欺侮弱小。同“恃强凌弱”。","source":{"text":"齐恃强欺弱，夺我汶阳之田，今日请还。","book":"明·冯梦龙《东周列国志》第18回"},"example":{"text":"他就是～的那种人。"},"similar":["恃强凌弱"],"usage":"作谓语、宾语、定语；指欺负弱小"},{"id":19133,"word":"恃德者昌，恃力者亡","pinyin":"shì dé zhě chāng，shì lì zhě wáng","abbr":"sdzcslzw","explanation":"恃：倚仗；昌：兴旺。依靠美德的一定兴旺发达，凭借暴力的必将灭亡。","source":{"text":"恃德者昌，恃力者亡。","book":"《史记·商君列传》"}},{"id":19134,"word":"恃才不学","pinyin":"shì cái bù xué","abbr":"scbx","explanation":"恃：倚仗。倚仗自己有天才，不用心学习。","source":{"text":"宋·王安石《伤仲永》载：神童方仲永，五岁即善诗，但由于恃才不学，长大便泯然而成为一般的人。"}},{"id":19135,"word":"恃才傲物","pinyin":"shì cái ào wù","abbr":"scaw","explanation":"恃：依靠、凭借；物：人，公众。仗着自己有才能，看不起人。","source":{"text":"恃才傲物，宜谥曰骄。","book":"《南史·萧子显传》"},"example":{"text":"唐薛澄州昭纬，即保逊之子也。～，亦有父风。","book":"宋·孙光宪《北梦琐言》卷四"},"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指自高自大","story":["南朝时期，齐武帝的侄子萧子显从小聪慧过人，文思敏捷。在任梁国国子博士时，把梁武帝写的《经义》作太学的教材授课。他写成《后汉书》100卷，《齐史》60卷。他深得梁武帝的信任。梁武帝认为他恃才傲物，在他死后赐他谥号“骄”"]},{"id":19136,"word":"恃才扬己","pinyin":"shì cái yáng jǐ","abbr":"scyj","explanation":"自恃有才，骄矜自负。同“恃才矜己”。","source":{"text":"有的人说：屈原那样的人根本值不得纪念的，恃才扬己，诽谤当道，而终于独善其身，消极自杀，这样狂诞偏激的人，在我们目前的中国根本不需要。","book":"郭沫若《从诗人节说到屈原是否是弄臣》"},"similar":["恃才矜己"],"usage":"作谓语、定语；指自傲"},{"id":19137,"word":"恃才放旷","pinyin":"shì cái fàng kuàng","abbr":"scfk","explanation":"倚仗着自己的才能而无拘无束。","source":{"text":"杨修为人恃才放旷，数犯曹操之忌。","book":"明·罗贯中《三国演义》第72回"},"similar":["恃才傲物"],"usage":"作谓语、定语；指自傲"},{"id":19138,"word":"恃才矜己","pinyin":"shì cái jīn jǐ","abbr":"scjj","explanation":"自恃有才，骄矜自负。","source":{"text":"恃才矜己，傲狠明德，内怀险躁，外示凝简，盛冠服以饰其奸，除谏官以掩其过。","book":"《隋书·炀帝纪下》"},"similar":["恃才扬己"],"usage":"作谓语、定语；指自傲"},{"id":19139,"word":"恃才矜贵","pinyin":"shì cái jīn guì","abbr":"scjg","explanation":"恃：倚仗；矜：自尊自大。倚仗自己才高位重而傲慢。","source":{"text":"时杨素恃才矜贵，轻侮朝臣，唯见弘，未尝不改容自肃","book":"《隋书·牛弘传》"}},{"id":19140,"word":"恃直不戒","pinyin":"shì zhí bù jiè","abbr":"szbj","explanation":"恃：倚仗；戒：戒备。自恃正直，不加戒备。","source":{"text":"夫佞人不能远，则有时而信之矣，今我恃直而不戒，祸其至哉。","book":"唐·韩愈《释言》"}},{"id":19141,"word":"恇怯不前","pinyin":"kuāng qiè bù qián","abbr":"kqbq","explanation":"恇怯：恐惧畏缩。恐惧畏缩，不敢向前。","source":{"text":"及闻清远之败，益恇怯不前。","book":"《宋史·杨琼传》"},"similar":["畏缩不前"],"usage":"作谓语、定语；指胆小"},{"id":19142,"word":"恋土难移","pinyin":"liàn tǔ nán yí","abbr":"ltny","explanation":"留恋故土，不愿移居他处。","source":{"text":"他那里常常有书来，取我入伙，我只为恋土难移，不曾去得。","book":"明·施耐庵《水浒全传》第三十一回"},"example":{"text":"这猴子～，小自小，倒也结实。","book":"明·吴承恩《西游记》第二十五回"}},{"id":19143,"word":"恋恋不舍","pinyin":"liàn liàn bù shě","abbr":"llbs","explanation":"恋恋：爱慕，留恋。原形容极其爱慕，不能丢开。现多形容非常留恋，舍不得离开。","source":{"text":"（蔡）元度送之郊外，促膝剧谈，恋恋不能舍。","book":"《史记·范睢传》：“然公之所以得无死者，以绨袍恋恋，有故人之间，故释公。”宋·王明清《挥尘后录》卷六"},"example":{"text":"他们，农会主任和青妇队长在炮声隆隆中，～地把我们送出了很远很远。","book":"峻青《夜宿灵山》"},"similar":["依依不舍","流连忘返"],"opposite":["一刀两断","扬长而去"],"usage":"作谓语、定语、状语；用于对人或事物等"},{"id":19144,"word":"恋恋难舍","pinyin":"liàn liàn nán shě","abbr":"llns","explanation":"原形容极其爱慕，不能丢开。现多形容非常留恋，舍不得离开。同“恋恋不舍”。","source":{"text":"子牙恋恋难舍，有两极仙翁上前言曰：‘子牙！机会难逢，时不可失；况天数已定，自难逃躲。你虽是下山，待你功成之时，自有上山之日。’","book":"明·许仲琳《封神演义》第十五回"},"example":{"text":"明·无名氏《杨家将演义》第五卷：“直送宗保至山下，俱有～之意。”"},"similar":["恋恋不舍"],"opposite":["扬长而去"],"usage":"作谓语、定语、状语；用于对人或事物等"},{"id":19145,"word":"恋新忘旧","pinyin":"liàn xīn wàng jiù","abbr":"lxwj","explanation":"恋慕新的，忘却旧的；对爱情不专一。","source":{"text":"从他别后，杳无半纸音书，多应他恋新往旧，撇得我一日三餐如醉痴。","book":"《群音类选·八声甘州·闺情》"},"example":{"text":"这种～的人不值得你难过。"},"similar":["喜新厌旧"],"usage":"作谓语、宾语、定语；用于男性"},{"id":19146,"word":"恋栈不去","pinyin":"liàn zhàn bù qù","abbr":"lzbq","explanation":"栈：养牲畜的棚子或栅栏。恋栈：牲畜留恋自己的圈、棚。形容人贪恋官位，不想离去。","source":{"text":"驽马恋栈豆。","book":"《晋书·宣帝纪》"},"example":{"text":"不能出言匡正，且又恋栈不去，以视唐少川辈，有愧色矣。","book":"蔡东藩、许廑父《民国通俗演义》第三十八回"},"usage":"作谓语、定语；指人贪权"},{"id":19147,"word":"恋生恶死","pinyin":"liàn shēng wù sǐ","abbr":"lses","explanation":"恋：爱慕不舍；恶：厌恶。贪恋生存，害怕死亡。","source":{"text":"若恋生恶死，拒违变化，则神识错乱，自失正业。","book":"宋·张君房《云笈七签》第94卷"},"example":{"text":"谁都有点～。"},"similar":["贪生怕死"],"opposite":["舍身求仁","舍生取义"],"usage":"作谓语、定语、宾语；指贪生怕死"},{"id":19148,"word":"恋酒贪杯","pinyin":"liàn jiǔ tān bēi","abbr":"ljtb","explanation":"恋：爱慕不舍；杯：酒杯。形容好酒贪杯。","source":{"text":"嘱咐你休恋酒贪杯，到那里识些廉耻。","book":"元·无名氏《水仙子·遣怀》"},"example":{"text":"元·无名氏《水仙子·遣怀》：“嘱咐你休恋酒贪杯，到那里识些廉耻。”"},"similar":["好酒贪杯"],"opposite":["滴酒不沾"],"usage":"作谓语、宾语；用于好酒的人"},{"id":19149,"word":"恋酒贪色","pinyin":"liàn jiǔ tān sè","abbr":"ljts","explanation":"恋：沉迷；贪：迷恋。指沉迷于酒色和女色之中。","source":{"text":"三尸调引，六贼迷惑，自然斗乱魂魄，镇日争财竞气，恋酒贪色。","book":"金·马钰《满庭芳·化胡了仙兄弟》"},"similar":["恋酒贪花"],"usage":"作谓语、定语；指贪婪酒色"},{"id":19150,"word":"恋酒贪花","pinyin":"liàn jiǔ tān huā","abbr":"ljth","explanation":"指沉迷于酒色和女色之中。同“恋酒迷花”。","source":{"text":"自古修文演武，取功名于乱世。终不然恋酒贪花，堕却壮志。","book":"元·无名氏《僧犯奸得马表背救》：“对人前敲禅板谈经说法，背地里跳墙头恋酒贪花。”明·李唐宾《梧桐叶》楔子"},"example":{"text":"尊嫂，季常此后决不敢～。","book":"明·汪廷讷《狮吼记·谏柳》"},"similar":["恋酒迷花","恋酒贪色"],"usage":"作谓语、定语；指贪婪酒色"},{"id":19151,"word":"恋酒迷花","pinyin":"liàn jiǔ mí huā","abbr":"ljmh","explanation":"恋：沉迷；迷：痴迷；花：娼妓，歌女。指沉迷于酒色和女色之中。","source":{"text":"知它是争名夺利？知它是恋酒迷花？使奴无情无绪，困倚绣床，如何消遣。","book":"元·无名氏《小孙屠·小孙屠捉奸》"},"example":{"text":"这的是～风风魔魔下汤头。","book":"元·无名氏《玩江亭》第三折"},"similar":["花天酒地","恋酒贪花"],"usage":"作谓语、定语；指贪婪酒色"},{"id":19152,"word":"恍如梦境","pinyin":"huǎng rú mèng jìng","abbr":"hrmj","explanation":"好像是在梦里一样。","source":{"text":"两相惊喜，握手入帷。见儿卧床上，慨然曰：‘我去时儿才及膝，今身长如许矣！’夫妇依倚，恍如梦寐。","book":"清·蒲松龄《聊斋志异·张鸿渐》"},"example":{"text":"我感觉到～一般。"},"similar":["恍如梦寐"],"usage":"作谓语；指好像做梦一样"},{"id":19153,"word":"恍如梦寐","pinyin":"huǎng rú mèng mèi","abbr":"hrmm","explanation":"指好像做梦一样。","source":{"text":"两相惊喜，握手入帷。见儿卧床上，慨然曰：‘我去时儿才及膝，今身长如许矣！’夫妇依倚，恍如梦寐。","book":"清·蒲松龄《聊斋志异·张鸿渐》"},"similar":["恍如梦境"],"usage":"作谓语；指好像做梦一样"},{"id":19154,"word":"恍如隔世","pinyin":"huǎng rú gé shì","abbr":"hrgs","explanation":"恍：仿佛；世：三十年为一世。仿佛隔了一个时代。指一种因人事或景物变化很大而引起的感触。","source":{"text":"发常州，平江亲戚故旧来相迓者，陆续于道，恍然如隔世焉。","book":"宋·范成大《吴船录下》"},"example":{"text":"盖聪明灵性，经一病而汩没销枕，遂举昔日所为，～耳。","book":"清·淮阴百一居士《壶天录》卷下"},"similar":["隔世之感","恍若隔世"],"usage":"作谓语、定语；形容人或事物的巨大变化"},{"id":19155,"word":"恍恍忽忽","pinyin":"huǎng huǎng hū hū","abbr":"hhhh","explanation":"神志不清、迷惘的状态。","source":{"text":"恍恍忽忽的似乎背后有人说道：‘婶娘连我也不认得了！’","book":"清·曹雪芹《红楼梦》第101回"},"similar":["恍恍惚惚"],"usage":"作谓语、定语、状语；指人的神志"},{"id":19156,"word":"恍恍惚惚","pinyin":"huǎng huǎng hū hū","abbr":"hhhh","explanation":"神志不清、迷惘的状态。","source":{"text":"宝玉恍恍惚惚，不觉弃了卷册，又随了警幻来至后面。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"他整天精神～的。"},"similar":["恍恍忽忽"],"usage":"作谓语、定语、状语；指人的神志"},{"id":19157,"word":"恍恍荡荡","pinyin":"huǎng huǎng dàng dàng","abbr":"hhdd","explanation":"摇晃不定。"},{"id":19158,"word":"恍然大悟","pinyin":"huǎng rán dà wù","abbr":"hrdw","explanation":"恍然：猛然清醒的样子；悟：心里明白。形容一下子明白过来。","source":{"text":"简蒙指教，豁然大悟。","book":"宋·释道原《景德传灯录》卷五"},"example":{"text":"袁太守和庄太守听了，方才～，彼此相视而笑。","book":"清·张春帆《宦海》第十七回"},"similar":["豁然开朗","如梦初醒","茅塞顿开"],"opposite":["如坐云雾","大惑不解"],"usage":"作谓语、定语、状语；形容人对某事突然明白"},{"id":19159,"word":"恍然自失","pinyin":"huǎng rán zì shī","abbr":"hrzs","explanation":"自失：好像自己失去了什么。形容猛然醒悟后的迷惘惜恋的的心情。","source":{"text":"程客恍然自失道：‘莫非是作梦吗？’","book":"明·凌濛初《二刻拍案惊奇·叠居奇程客得助》"},"example":{"text":"看朱子六十后长进不多之语，～，呜呼，日月逝矣，不可得而追矣。","book":"清·梁启超《节本明儒学案·崇仁学案·吴康斋先生语》"},"usage":"作谓语、状语；形容心神不宁，不知如何是好"},{"id":19160,"word":"恍然若失","pinyin":"huǎng rán ruò shī","abbr":"hrrs","explanation":"恍恍惚惚的好像失去了什么似的。形容心神不宁，不知如何是好。","source":{"text":"金钟儿听了这一番言语，恍然若失，心上愧悔的无地自容。","book":"清·李百川《绿野仙踪》第49回"},"example":{"text":"他～地走向教室。"},"similar":["若有所失"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":19161,"word":"恍若隔世","pinyin":"huǎng ruò gé shì","abbr":"hrgs","explanation":"恍：仿佛；世：三十年为一世。仿佛隔了一世。指因人事、景物变化很大而生的感触。","source":{"text":"屏山献青，画恋滴翠，两年尘土面目，为之洗尽。马首红尘，恍若隔世矣。","book":"明·袁宏道《锦帆集·天池》"},"example":{"text":"王朔《浮出海面》：“我接到请柬，想起当年获奖时少年得志的情景，～。”"},"similar":["恍如隔世"],"usage":"作谓语、定语；形容人或事物的巨大变化"},{"id":19162,"word":"恐伤雅道","pinyin":"kǒng shāng yǎ dào","abbr":"ksyd","explanation":"雅道：正道。惟恐破坏和影响正统的道德规范。","source":{"text":"二人虽有词华，然其体轻微，终不成令器。若置之高第，恐后进效之，伤陛下雅道。","book":"《资治通鉴·唐纪十四》"}},{"id":19163,"word":"恐后争先","pinyin":"kǒng hòu zhēng xiān","abbr":"khzx","explanation":"指害怕落后，追求上进。","source":{"text":"他却横冲直撞，恐后争先。","book":"清·吴趼人《二十年目睹之怪现状》第68回"},"example":{"text":"纸鸢们也欢喜太阳：一个个～，争先恐后，不断努力，飞扬，向上。","book":"郭沫若《女神·心灯》"},"similar":["争先恐后"],"usage":"作谓语；指上进心很强"},{"id":19164,"word":"恐后无凭","pinyin":"kǒng hòu wú píng","abbr":"khwp","explanation":"怕以后没有个凭证。旧时契约文书的套语，常与“立次存照”连用。","source":{"text":"孩儿春郎，年方七岁，胸前一点朱砂记，情愿卖与拈各千户为儿，恐后无凭，立此文书为照。","book":"元·无名氏《货郎旦》第二折"},"example":{"text":"我们～，还是签订正式的合同吧。"},"similar":["空口无凭"],"usage":"作谓语；用于文书，与“立此存照”连用"},{"id":19165,"word":"恐慌万状","pinyin":"kǒng huāng wàn zhuàng","abbr":"khwz","explanation":"恐：害怕；慌：惊慌；状：情状。形容害怕惊慌到极点。","source":{"text":"忧患百罹而未艾，惊惶万状而莫支。","book":"宋·陈亮《谢杨解元启》"},"example":{"text":"东西两线敌军，～，急于逃命。","book":"毛泽东《解放平壤的两则电讯》"},"similar":["惊恐万状"],"usage":"作谓语、状语；指惊慌"},{"id":19166,"word":"恐遭物议","pinyin":"kǒng zāo wù yì","abbr":"kzwy","explanation":"物：这里指人；议：议论。担心遭到众人的非议。","source":{"text":"时左丞庚仲容亦免归，二人意志相得，并肆诞纵，或乘露车历游郊野，既醉则执铎挽歌，不屑物议。","book":"《梁书·谢几卿传》"},"example":{"text":"刘氏早请立尚为嗣，绍因舍长立幼，～，特使谭出继兄后，出为青州刺史。","book":"蔡东藩《后汉演义》第八十回"},"usage":"作谓语；害怕受到非议"},{"id":19167,"word":"恒河一沙","pinyin":"héng hé yī shā","abbr":"hhys","explanation":"比喻极其渺小。","source":{"text":"宋阴念一身蜩寄世间，真如恒河一沙，沧海一粟。","book":"清·各邦额《夜谭随录·宋秀才》"},"similar":["沧海一粟"],"usage":"作宾语；用于比喻句"},{"id":19168,"word":"恒河之沙","pinyin":"héng hé zhī shā","abbr":"hhzs","explanation":"恒河：南亚大河，流经印度和孟加拉国。佛教语，像恒河里的沙粒一样，无法计算。形容数量很多而无法计算。","source":{"text":"夫死生转毂，因果循环，如恒河之沙，积数不可以测算。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"similar":["恒河沙数"],"usage":"作宾语、定语；形容数量很多而无法计算"},{"id":19169,"word":"恒河沙数","pinyin":"héng hé shā shù","abbr":"hhss","explanation":"恒河：南亚的大河。象恒河里的沙粒一样，无法计算。形容数量很多。","source":{"text":"以七宝满尔所恒河沙数三千大世界，以用布施。","book":"《金刚经·无为福胜分第十一》"},"example":{"text":"吾愿～仙人，并遣娇女，婚嫁人间，则贫穷海中，少苦众生矣。","book":"清·蒲松龄《聊斋志异·凤仙》"},"similar":["不计其数"],"opposite":["寥若晨星"],"usage":"作谓语、宾语、定语；形容数量很多而无法计"},{"id":19170,"word":"恒舞酣歌","pinyin":"héng wǔ hān gē","abbr":"hwhg","explanation":"恒舞：长时间地舞蹈；酣歌：沉湎于歌乐。长时间地舞蹈，尽情地欢歌。形容生活奢靡，不务正业。","source":{"text":"敢有恒舞于官，酣歌于室，时谓巫风。","book":"《尚书·伊训》"},"example":{"text":"元时人～，不事生产。","book":"清·李光地《榕村语录》"}},{"id":19171,"word":"恕不奉陪","pinyin":"shù bù fèng péi","abbr":"sbfp","explanation":"对不起，我不能陪伴你了。","example":{"text":"～，我得走了。"},"opposite":["奉陪到底"],"usage":"作谓语；用于交际口语"},{"id":19172,"word":"恕己及人","pinyin":"shù jǐ jí rén","abbr":"sjjr","explanation":"对别人就像对自己一样宽恕。","source":{"text":"慈心于物，恕己及人。","book":"晋·葛洪《抱朴子·至理》"},"example":{"text":"束发修身，有～之志。","book":"宋·曾巩《节相制》"},"similar":["恕己及物"],"usage":"作谓语、定语；指宽恕别人"},{"id":19173,"word":"恕己及物","pinyin":"shù jǐ jí wù","abbr":"sjjw","explanation":"对别人就像对自己一样宽恕。","source":{"text":"慈心于物，恕己及人。","book":"《抱朴子·至理》"},"similar":["恕己及人"],"usage":"作谓语、定语；指宽恕别人"},{"id":19174,"word":"恕我冒昧","pinyin":"shù wǒ mào mèi","abbr":"swmm","explanation":"请原谅我的冒昧。","example":{"text":"～，说了这么多不中听的话。"},"similar":["恕我直言"],"usage":"作谓语；用于口语"},{"id":19175,"word":"恛惶无措","pinyin":"huí huáng wú cuò","abbr":"hhwc","explanation":"恛：昏乱的样子；惶：惊慌。指惶恐不安，不知所措。","source":{"text":"此臣等所以兢惕失图，恛惶无措。","book":"唐·柳宗元《礼部为百官上尊号第二表》"}},{"id":19176,"word":"恢奇多闻","pinyin":"huī qí duō wén","abbr":"hqdw","explanation":"恢奇：特别奇特。形容人壮伟杰出，见多识广，不同寻常。","source":{"text":"弘为人恢奇多闻，常称以为人主病不广大，人臣病不俭节。","book":"《史记·平津侯列传》"}},{"id":19177,"word":"恢宏大度","pinyin":"huī hóng dà dù","abbr":"hhdd","explanation":"恢宏：宽大，开阔。心胸开阔，气量宏大，不计较个人的利害得失。","source":{"text":"今见陛下，恢廓大度，同符高祖，乃知帝王自有真也。","book":"《后汉书·马援传》"},"example":{"text":"放着这等一位～的何萧史，一位细腻风光的张桐卿，还怕帮助不了一个安龙媒。","book":"清·文康《儿女英雄传》第三十回"},"similar":["气度恢宏","宽宏大量","宽大为怀"],"opposite":["斤斤计较","锱铢必较"],"usage":"作主语、宾语、定语；指心胸开阔，气量宏大"},{"id":19178,"word":"恢廓大度","pinyin":"huī kuò dà dù","abbr":"hkdd","explanation":"恢廓：宽大，开阔。心胸开阔，气量宏大，不计较个人的利害得失。","source":{"text":"今见陛下，恢廓大度，同符高祖，乃知帝王自有真也。","book":"《后汉书·马援传》"},"example":{"text":"秦王～，屈己下贤，于人无所不容。","book":"明·冯梦龙《东周列国志》第一百零五回"},"similar":["恢宏大度"],"usage":"作谓语、宾语、定语；指心胸开阔，气量宏大"},{"id":19179,"word":"恢恑憰怪","pinyin":"huī guǐ lián guài","abbr":"hgjg","explanation":"指离奇怪异。","source":{"text":"恢恑憰怪，道通为一。","book":"《庄子·齐物论》"},"example":{"text":"凡天地之内～，身世之间交互纬繣，千容万状，皆用以资为状，夫然后谓之有诗。","book":"清·钱谦益《书瞿有仲诗卷》"}},{"id":19180,"word":"恢恢有余","pinyin":"huī huī yǒu yú","abbr":"hhyy","explanation":"恢恢：形容宽广。薄薄的刀刃插入骨节间，仍觉宽广，还有回旋余地。常形容本领大，技巧高，处理问题毫不费力。","source":{"text":"彼节者有间，而刀刃者无厚。以无厚入有间，恢恢乎其于游刃必有余地矣。","book":"战国·宋·庄周《庄子·养生主》"},"example":{"text":"苟其得志也，持是而往，～也。","book":"清·戴名世《序》"},"similar":["绰绰有余"],"usage":"作补语、定语；指宽广而有余裕"},{"id":19181,"word":"恢胎旷荡","pinyin":"huī tāi kuàng dàng","abbr":"htkd","explanation":"恢胎：广大的样子。形容宽阔广大，空旷无物。","source":{"text":"徒观其坰场区宇，恢胎旷荡。","book":"《后汉书·马融传》"}},{"id":19182,"word":"恢诡谲怪","pinyin":"huī guǐ jué guài","abbr":"hgjg","explanation":"指离奇怪异。同“恢恑憰怪”。","source":{"text":"诏天下监司、郡守搜访岩谷之士，虽恢诡谲怪自晦者，悉以名闻。","book":"《宋史·徽宗纪三》"},"example":{"text":"凡天地之内～，身世之间交互纬繣，千容万状，皆用以资为状，夫然后谓之有诗。","book":"清·钱谦益《书瞿有仲诗卷》"},"similar":["稀奇古怪"],"usage":"作谓语、定语；指奇特的东西"},{"id":19183,"word":"恣凶稔恶","pinyin":"zì xiōng rěn è","abbr":"zxre","explanation":"犹穷凶极恶。","source":{"text":"倭夷恣凶稔恶以毒螫志我吴民，是乱贼之尤未有甚焉者也。","book":"明·唐顺之《常州新建侯祠记》"},"usage":"作谓语、定语；用于书面语"},{"id":19184,"word":"恣心所欲","pinyin":"zì xīn suǒ yù","abbr":"zxsy","explanation":"恣：放纵。恣纵己意，心想事成。","source":{"text":"其宫殿皆雕文镂刻，街曲市里，屋舍楼观，钟鼓音乐，服饰香华，水陆通流，百贾交会，奇玩珍玮，恣心所欲。","book":"《梁书·中天竺国传》"},"similar":["随心所欲"],"usage":"作谓语、定语、状语；同“随心所欲”"},{"id":19185,"word":"恣心纵欲","pinyin":"zì xīn zòng yù","abbr":"zxzy","explanation":"指无所顾忌地放纵情欲。","source":{"text":"难道我就不知我的哥哥素日恣心纵欲，毫无防范的那种心性。","book":"清·曹雪芹《红楼梦》第三十四回"},"similar":["恣情纵欲"],"usage":"作谓语、宾语、定语；指放纵情欲"},{"id":19186,"word":"恣情纵欲","pinyin":"zì qíng zòng yù","abbr":"zqzy","explanation":"无所节制的任情纵欲。","source":{"text":"惟其生于后世，学绝道丧，异端邪说充塞弥满，遂使有志之士罹此患害，乃与世间凡庸恣情纵欲之人均其陷溺，此岂非以学术杀天下哉？","book":"宋·陆九渊《与曾宅之书》"},"example":{"text":"江南米价腾贵，京城盗贼横行，可～，不一顾念乎？","book":"《明史·陆昆传》"},"similar":["恣心纵欲"],"usage":"作谓语、宾语、定语；指放纵情欲"},{"id":19187,"word":"恣意妄为","pinyin":"zī yì wàng wéi","abbr":"zyww","explanation":"任意胡作非为，常指极端地固执己见和偏爱自己的习惯，常含有一种几乎难以抑制的反复无常的意味。","source":{"text":"察其原因，不外有少数顽固分子，不顾民族国家利益，恣意妄为。","book":"毛泽东《陕甘宁边区政府、第八路军后方留守处布告》"},"example":{"text":"毛泽东《陕甘宁边区政府第八路军后方留守处布告》：“察其原因，不外有少数顽固分子，不顾民族国家利益，～。”"},"similar":["为所欲为","无法无天","肆无忌惮"],"opposite":["谨小慎微","谨言慎行","循规蹈矩"],"usage":"作谓语、定语；指胡作非为"},{"id":19188,"word":"恣意妄行","pinyin":"zì yì wàng xíng","abbr":"zywx","explanation":"恣意：任意，随意；妄行：胡作非为。随心所欲，胡作非为。","source":{"text":"曲阳侯要前为三公辅政，知赵昭仪杀皇子，不辄白奏，反与赵氏比周，恣意妄行。","book":"《汉书·杜周传》"},"example":{"text":"允祀在皇考时，～，匪伊朝夕，朕可不念祖宗肇造鸿图，以永逸子孙之安乎？","book":"《清史稿·允祀传》"},"similar":["恣意妄为"],"usage":"作谓语、定语、状语；用于处事"},{"id":19189,"word":"恣无忌惮","pinyin":"zì wú jì dàn","abbr":"zwjd","explanation":"犹肆无忌惮。","source":{"text":"承辉做了帐房，一切上下人等，都是自己牙爪，是恣无忌惮的了。","book":"清·吴趼人《二十年目睹之怪现状》第一百五回"},"example":{"text":"你不能总是～吧"},"similar":["肆无忌惮"],"usage":"作谓语、定语、状语；指一点没有顾忌"},{"id":19190,"word":"恣睢无忌","pinyin":"zì suī wú jì","abbr":"zswj","explanation":"恣睢：任意胡为；忌：顾忌，害怕。形容任意胡作非为，毫无顾忌。","source":{"text":"初，议礼诸臣无力诋执政者，至萼遂斥为不道，且欲不使议。其言恣肆无忌，朝士尤疾之。","book":"《明史·桂萼传》"},"example":{"text":"世祖时赏罚出至公，督抚不敢～。","book":"《清史稿·节之芳传》"},"similar":["恣意妄为","肆无忌惮"],"usage":"作谓语、定语；指毫无顾忌"},{"id":19191,"word":"恣睢自用","pinyin":"zì suī zì yòng","abbr":"zszy","explanation":"恣睢：狂暴；自用：自以为是。指狂妄、凶暴、自以为是","source":{"text":"子之在上，无道据傲，荒怠、贪戾、虐众，恣睢自用也。","book":"战国·卫·吕不韦《吕氏春秋·怀宠》"},"usage":"作谓语、定语；用于书面语"},{"id":19192,"word":"恣肆无忌","pinyin":"zì sì wú jì","abbr":"zswj","explanation":"恣：任意，放纵；忌：顾忌，害怕。形容任意胡作非为，毫无顾忌。","source":{"text":"初，议礼诸臣无力诋执政者，至萼遂斥为不道，且欲不使议。其言恣肆无忌，朝士尤疾之。","book":"《明史·桂萼传》"},"example":{"text":"明·无名氏《杨家将演义》第三卷：“故彼有恃而轻藐国法，～。”"},"similar":["恣行无忌","恣睢无忌"],"usage":"作谓语、定语；指肆意妄为"},{"id":19193,"word":"恣行无忌","pinyin":"zì xíng wú jì","abbr":"zxwj","explanation":"恣：放纵，无拘束；忌：顾忌，畏惧。形容随意作恶，毫无顾忌。","example":{"text":"她～，最终进了监狱。"},"similar":["恣意妄为"],"usage":"作谓语、定语；指随意作恶"},{"id":19194,"word":"恤孤念寡","pinyin":"xù gū niàn guǎ","abbr":"xgng","explanation":"救济孤儿，关心寡妇。","source":{"text":"数中有好善积德者，多是恤孤念苦，敬老怜贫。","book":"宋·吴自牧《梦梁录·恤贫济老》"},"example":{"text":"明·吴承恩《西游记》第44回：“乃齐天大圣，神通广大，专秉忠良之心，与人间报不平之事，济困扶危，～。”"},"similar":["恤孤念苦"],"usage":"作谓语、宾语、定语；用于处事"},{"id":19195,"word":"恤孤念苦","pinyin":"xù gū niàn kǔ","abbr":"xgnk","explanation":"救济孤儿，关心穷苦人。","source":{"text":"数中有好善积德者，多是恤孤念苦，敬老怜贫。","book":"宋·吴自牧《梦梁录·恤贫济老》"},"similar":["恤孤念寡"],"usage":"作谓语、宾语、定语；用于处事"},{"id":19196,"word":"恤老怜贫","pinyin":"xù lǎo lián pín","abbr":"xllp","explanation":"周济老人，怜惜穷人。","source":{"text":"恤老怜贫，视民如子，起死回生。","book":"元·刘时中《端正好·上高监司》"},"example":{"text":"～是人的基本美德。"},"similar":["怜贫恤老"],"usage":"作主语、谓语、宾语、定语；指怜惜弱小阶层"},{"id":19197,"word":"恤近忽远","pinyin":"xù jìn hū yuǎn","abbr":"xjhy","explanation":"恤：怜惜；忽：疏忽。对自己亲近的加以照顾，对不亲近的就予以忽视。","source":{"text":"绍恤近忽远，公虑无不周，此仁胜也。","book":"明·罗贯中《三国演义》第十八回"},"usage":"作谓语、定语；用于处事"},{"id":19198,"word":"恨不相逢未嫁时","pinyin":"hèn bù xiāng féng wèi jià shí","abbr":"hbxfwjs","explanation":"男女有情，而女方已经嫁人，因相识太晚而感到遗憾。","source":{"text":"知君用心如日月，事夫誓拟同生死。还君明珠双泪垂，何不相逢未嫁时？","book":"唐·张籍《节妇吟》诗"}},{"id":19199,"word":"恨之入骨","pinyin":"hèn zhī rù gǔ","abbr":"hzrg","explanation":"恨到骨头里去。形容痛恨到极点。","source":{"text":"缪公之怨此三人，入于骨髓。","book":"《史记·秦本纪》"},"example":{"text":"那知府亦～，一处处弄得天怒人怨，在他自己始终亦莫明其所以然。","book":"清·李宝嘉《官场现形记》第四十二回"},"similar":["咬牙切齿","切齿痛恨","深恶痛绝"],"opposite":["一往情深","爱不忍释","一见钟情"],"usage":"作谓语；形容痛恨到极点"},{"id":19200,"word":"恨之切骨","pinyin":"hèn zhī qiē gǔ","abbr":"hzqg","explanation":"之：代词，指所恨对象。形容痛恨到极点。","source":{"text":"屡遭虏骑蹂躏，莫不义愤填膺，恨之切骨，只要朝廷稍加激动，十万之众不难指日集合。","book":"姚雪垠《李自成》第一卷第二章"},"similar":["恨之入骨","恨入心髓","恨入骨髓"],"usage":"作谓语；形容痛恨到极点"},{"id":19201,"word":"恨五骂六","pinyin":"hèn wǔ mà liù","abbr":"hwml","explanation":"投骰子时的叫骂声。","example":{"text":"房间内充满～的声音。"},"similar":["吆五喝六"],"usage":"作谓语、定语；指大声呵斥"},{"id":19202,"word":"恨入心髓","pinyin":"hèn rù xīn suǐ","abbr":"hrxs","explanation":"恨：怨恨。形容对人痛恨到极点。","source":{"text":"是后中原士夫，深为子孙忧，恨入心髓，牢不可破。","book":"明·沈德符《野获编·西北水田》"},"similar":["恨入骨髓","恨之入骨","恨之切骨"],"usage":"作谓语、宾语；形容对人痛恨到极点"},{"id":19203,"word":"恨入骨髓","pinyin":"hèn rù gǔ suǐ","abbr":"hrgs","explanation":"形容痛恨到极点。","source":{"text":"缪公之怨此三人，入于骨髓。","book":"《史记·秦本纪》"},"example":{"text":"不想心中气恼，不曾照管得，足下绊上一交，把锅子打做千百来块，将王屠来～。","book":"明·冯梦龙《醒世恒言》卷二十九"},"similar":["鸳入骨髓","恨之入骨"],"opposite":["情深似海"],"usage":"作谓语、宾语；形容对人痛恨到极点"},{"id":19204,"word":"恨如头醋","pinyin":"hèn rú tóu cù","abbr":"hrtc","explanation":"比喻非常可恶，令人痛恨。","source":{"text":"那陈虾子被毛二胡子一味朝死里算，弄的他酒也没得吃，肉也没得吃，恨如头醋。","book":"清·吴敬梓《儒林外史》第五十二回"},"usage":"作谓语；指忿恨极大"},{"id":19205,"word":"恨如芳草","pinyin":"hèn rú fāng cǎo","abbr":"hrfc","explanation":"恨：怨恨；芳草：香草。心中的离愁别恨就像那割不尽的香草。形容情思绵绵，无休无尽。","source":{"text":"离恨恰如春草，更行更远还生。","book":"南唐·李煜《清平乐》词"}},{"id":19206,"word":"恨小非君子，无毒不丈夫","pinyin":"hèn xiǎo fēi jūn zǐ，wú dú bù zhàng fū","abbr":"hxfjzwdbzf","explanation":"君子：有才德的人；丈夫：有志气、有作为的男子。对仇敌要痛恨，打击要坚决彻底。指坏人心狠手辣。","source":{"text":"恨小非君子，无毒不丈夫。叵奈杨景无礼。","book":"元·无名氏《谢金吾》第三折"},"example":{"text":"提了双锏，怒冲冲的杀那王佐。正合着常言道：‘～。’","book":"清·钱彩《说岳全传》第51回"},"usage":"作宾语、定语、分句；可分开使用"},{"id":19207,"word":"恨海愁天","pinyin":"hèn hǎi chóu tiān","abbr":"hhct","explanation":"形容愁闷象山一样大，象海一样深，无法排遣。","source":{"text":"俺又不曾弄月嘲风，怎揽这场愁山闷海。","book":"元·无名氏《争报恩》第二折"}},{"id":19208,"word":"恨海难填","pinyin":"hèn hǎi nán tián","abbr":"hhnt","explanation":"恨海：怨恨如海；难填：难于填塞。比喻怨气难平。","source":{"text":"炎帝之少女名曰女娃。女娃游于东海，溺而不返，故为精卫，常衔西山之木石，以堙于东海。","book":"《山海经·北山经》"},"usage":"作宾语、定语；用于处事","story":["神话传说，上古时期炎帝最疼爱的小女儿女娃在东海游泳被水淹死，她的灵魂于是化成一只作精卫鸟，经常飞到西山去叼小石头和小树枝扔进东海，发誓要填平东海为自己报仇，她就这样一直飞来飞去，但最终也没有将东海填平，人们说恨海难填"]},{"id":19209,"word":"恨相知晚","pinyin":"hèn xiāng zhī wǎn","abbr":"hxzw","explanation":"恨：懊悔；相知：互相了解，感情很深。后悔彼此建立友谊太迟了。形容新结交而感情深厚。","source":{"text":"两人相引为重，其游如父子然。相得甚欢，无厌，恨相知晚也。","book":"《史记·魏其武安侯列传》"},"example":{"text":"后褒坐事左转高唐令，临云，握伦臂诀曰：“～。”","book":"《后汉书·第五伦列传》"},"similar":["相见恨晚","恨相见晚"],"usage":"作谓语；形容新结交而感情深厚"},{"id":19210,"word":"恨相见晚","pinyin":"hèn xiāng jiàn wǎn","abbr":"hxjw","explanation":"后悔彼此建立友谊太迟了。形容新结交而感情深厚。同“恨相知晚”。","source":{"text":"与痴儿说梦，终日闷闷，使人欲索枕僵卧。明者了了，不逾顷刻能解人数百年中事，恨相见晚矣。","book":"宋·文天祥《与山人黎端吉序》"},"similar":["恨相知晚","相得恨晚"],"usage":"作谓语；形容新结交而感情深厚"},{"id":19211,"word":"恨穷发极","pinyin":"hèn qióng fā jí","abbr":"hqfj","explanation":"愤恨到极点而发怒。","example":{"text":"他忍无可忍，终于～。"},"usage":"作谓语、定语；用于处事"},{"id":19212,"word":"恨紫怨红","pinyin":"hèn zǐ yuàn hóng","abbr":"hzyh","explanation":"紫、红：紫色和红色的花，这里泛指各种颜色的鲜花。各种各样的花竞相开放，让人心烦意恨。形容花姿引起人的伤感。","source":{"text":"恨紫怨红满南园。","book":"清·陆珍《虞美人·花歌》"}},{"id":19213,"word":"恨铁不成钢","pinyin":"hèn tiě bù chéng gāng","abbr":"htbcg","explanation":"形容对所期望的人不争气不上进感到不满，急切希望他变好。","source":{"text":"只为宝玉不上进，所以时常恨他，也不过是‘恨铁不成钢’的意思。","book":"清·曹雪芹《红楼梦》第96回"},"example":{"text":"这是‘～’的恨，不是仇恨。","book":"周立波《山乡巨变》"},"usage":"作宾语、定语、补语；用于对所期望的人","story":["贾宝玉因丢失通灵宝玉而生病，贾母与王熙凤商量要把薛宝钗嫁给宝玉来冲喜，这样来挽救宝玉的生命。刚好此时贾政放了外任，贾母命他定夺。贾政也想这个恨铁不成钢的儿子早日康复，成家立业好继承祖业，也同意立即就办喜事"]},{"id":19214,"word":"恩不放债","pinyin":"ēn bù fàng zhai","abbr":"ebfz","explanation":"对亲人不宜放债。意指免因钱财交往而致发生怨怼。恩，指亲人。","source":{"text":"他可是肯心肯意的还咱……正是恩不放债。","book":"元·郑廷玉《忍字记》第二折"},"usage":"作宾语、定语；用于劝诫人"},{"id":19215,"word":"恩人相见，分外眼青","pinyin":"ēn rén xiāng jiàn，fèn wài yǎn qīng","abbr":"erxjfwyq","explanation":"分外：格外；眼青：亲热。形容恩人见面，格外亲热。","source":{"text":"尝言恩人相见，分外眼青。姚氏一见知心人，回瞋作喜。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"similar":["恩人相见，分外眼明"],"opposite":["仇人相见，分外眼红"],"usage":"作宾语、分句；用于亲人朋友等"},{"id":19216,"word":"恩同再生","pinyin":"ēn tóng zài shēng","abbr":"etzs","explanation":"恩：恩德。比喻恩情极大，像使自己再生一样。","source":{"text":"他不愿意离开他这个恩同再生的母亲。","book":"刘流《烈火金刚》第17回"},"similar":["恩同再造","恩若再生"],"usage":"作补语、宾语；指再造之恩"},{"id":19217,"word":"恩同再造","pinyin":"ēn tóng zài zào","abbr":"etzz","explanation":"再造：再生。使人再生的恩惠。比喻恩情极大，象救了自己的性命一样。","source":{"text":"再造之恩，不可妄属。","book":"《宋书·王僧达传》"},"example":{"text":"求大贤细细诊视。可有几希之望？倘能救其一命，真是～。","book":"清·李汝珍《镜花缘》第三十回"},"similar":["再造之恩","恩若再生"],"opposite":["恩将仇报"],"usage":"作补语、宾语；指再造之恩"},{"id":19218,"word":"恩同山岳","pinyin":"ēn tóng shān yuè","abbr":"etsy","explanation":"犹恩重如山。","source":{"text":"萍水之人，何敢遽以重务浼君子。但泉下搞骸，舌不得缩，索不得除，求断屋梁而焚之，恩同山岳矣。","book":"清·蒲松龄《聊斋志异·梅女》"},"similar":["恩重如山"],"usage":"作谓语、定语；用于感激词"},{"id":19219,"word":"恩同父母","pinyin":"ēn tóng fù mǔ","abbr":"etfm","explanation":"恩：恩惠；同：如同。待人的好处、恩惠之大如同父母一样。","source":{"text":"伏惟神皇陛下，恩同父母，矜照恳诚，信其赤心，实有馨竭。","book":"唐·陈子昂《为张著作谢父官表》"},"example":{"text":"某等众人，正欲如此，与国家出力，建功立业，以为忠臣。今得太尉恩相，力赐保奏，～。","book":"明·施耐庵《水浒全传》第八十三回"},"similar":["恩同再造","恩若再生"],"usage":"作谓语、宾语；指恩重"},{"id":19220,"word":"恩威并济","pinyin":"ēn wēi bìng jì","abbr":"ewbj","explanation":"威：以法自治或以武力威协。奖赏和刑罚一起使用。指统治者同时采用高压和怀柔手段。","source":{"text":"御卤当恩威并济，不可专恃羁縻。","book":"《三国志·吴书·周鲂传》：“鲂在郡十三年卒，赏善罚恶，恩威并行。”  明·张岱《石匮书后集·烈帝纪·崇祯元年》"},"example":{"text":"你降他象钟馗降小鬼的一般，你又自己处的正大，～。","book":"清·西周生《醒世姻缘传》第二回"},"similar":["恩威并行","恩威并用","恩威并著"],"usage":"作谓语、定语、宾语；用于处事"},{"id":19221,"word":"恩威并用","pinyin":"ēn wēi bìng yòng","abbr":"ewby","explanation":"安抚和强制同时施行。现也指掌权者对手下人，同时用给以小恩小惠和给以惩罚的两种手段。","source":{"text":"鲂在郡十三年卒，赏善罚恶，恩威并行。","book":"《三国志·吴书·周鲂传》"},"example":{"text":"为朝廷计，宜先赦其矫诏之罪，然后赏其斩曦之功，则～，折冲万里之外矣。","book":"宋·周密《齐东野语·文庄论安丙矫诏》"},"similar":["恩威并行","恩威并重"],"usage":"作谓语、定语；指安抚和强制同时施行"},{"id":19222,"word":"恩威并著","pinyin":"ēn wēi bìng zhù","abbr":"ewbz","explanation":"恩德与威势同时并行。","source":{"text":"诒语恩威并著，慑伏其心，务使可毒拱手降顺。","book":"清·褚人获《隋唐演义》第82回"},"example":{"text":"清·褚人获《隋唐演义》第82回：“诒语～，慑伏其心，务使可毒拱手降顺。”"},"similar":["恩威并行","恩威并用","恩威并济"],"usage":"作谓语、定语、宾语；用于处事"},{"id":19223,"word":"恩威并行","pinyin":"ēn wēi bìng xíng","abbr":"ewbx","explanation":"安抚和强制同时施行。现也指掌权者对手下人，同时用给以小恩小惠和给以惩罚的两种手段。","source":{"text":"鲂在郡十三年卒，赏善罚恶，恩威并行。","book":"晋·陈寿《三国志·吴志·周鲂传》"},"example":{"text":"上怒斩之，同保九辈永不得赴举。～，至于如此。","book":"宋·洪迈《容斋续笔·下第再试》"},"similar":["软硬兼施","恩威并用","恩威并济"],"usage":"作谓语、定语；指安抚和强制同时施行"},{"id":19224,"word":"恩威并重","pinyin":"ēn wēi bìng zhòng","abbr":"ewbz","explanation":"安抚和强制同时施行。","source":{"text":"鲂在郡十三年卒，赏善罚恶，恩威并行。","book":"《三国志·吴书·周鲂传》"},"example":{"text":"我一向倒是～，以德服人的。","book":"陈白尘、贾霁《宋景诗》十九"},"similar":["恩威并行"],"usage":"作谓语、定语；指安抚和强制同时施行"},{"id":19225,"word":"恩将仇报","pinyin":"ēn jiāng chóu bào","abbr":"ejcb","explanation":"拿仇恨回报所受的恩惠。指忘恩负义。","source":{"text":"我若一口说出，他就把公主杀了，此却不是恩将仇报？","book":"明·吴承恩《西游记》第三十回"},"example":{"text":"亏这官人救了性命，今反～，天理何在！","book":"明·冯梦龙《醒世恒言》卷三十"},"similar":["以怨报德","忘恩负义"],"opposite":["以德报恩"],"usage":"作谓语、定语、宾语；同“以怨报德”","story":["李靖的三子哪吒在陈塘关的城楼上见到乾坤弓、震天箭，就拿来演练，他朝西南方向一箭射去，正中骷髅山白骨洞石矶娘娘的弟子碧云。彩云童子报告石矶娘娘。石矶娘娘知道是哪吒所为，就大骂李靖不计当年的恩情反而恩将仇报起来"]},{"id":19226,"word":"恩山义海","pinyin":"ēn shān yì hǎi","abbr":"esyh","explanation":"恩爱像高山一样重，情义像大海一样深。形容恩惠深，情义重。","source":{"text":"恩义重如山，情意深如海。假使黄金北斗高，这一分，何由买？","book":"宋·晁端海《卜算子》"},"example":{"text":"两人～，要做到头夫妻。","book":"明·凌濛初《初刻拍案惊奇》卷三十二"},"similar":["恩重如山","情深义切"],"usage":"作宾语、定语；形容恩惠深，情义重"},{"id":19227,"word":"恩德如山","pinyin":"ēn dé rú shān","abbr":"edrs","explanation":"比喻恩德极为深生。","source":{"text":"老夫垂死之命恩人救援，恩德如山，无可图报。","book":"明·周楫《西湖二集·寿禅师两生符宿愿》"},"example":{"text":"你对我～，我不知如何报答。"},"similar":["恩重如山"],"usage":"作谓语、宾语；指恩德极大"},{"id":19228,"word":"恩怨了了","pinyin":"ēn yuàn liǎo liǎo","abbr":"eyll","explanation":"了了：清清楚楚。对恩怨的界限分得十分清楚。指对有恩者报了恩，对有怨者报了怨。","source":{"text":"恩怨了了，颇快心意。","book":"清·蒲松龄《聊斋志异·续黄梁》"},"usage":"作谓语、定语；用于处世"},{"id":19229,"word":"恩怨分明","pinyin":"ēn yuàn fēn míng","abbr":"eyfm","explanation":"恩：恩惠；怨：仇恨。对于恩惠和仇恨的界限分得十分清楚，毫不含糊。","source":{"text":"某素知云长傲上而不忍下，欺强而不凌弱；恩怨分明，信义素著。","book":"明·罗贯中《三国演义》第五十回"},"example":{"text":"一刹那间便一生，何须恩怨苦分明。老来自笑犹闲气，动为前人抱不平。","book":"清·赵翼《瓯北诗话·绝句二·读史》"},"similar":["爱憎分明"],"usage":"作谓语、定语；指人爱憎分明"},{"id":19230,"word":"恩恩怨怨","pinyin":"ēn ēn yuàn yuàn","abbr":"eeyy","explanation":"指人的感恩之情与仇怨之情。","source":{"text":"当你认定十年韬晦已足以使人们忘却你和你下决心干掉的那个人之间的恩恩怨怨，你便开始行动了。","book":"王朔《我是“狼”》"},"usage":"作宾语、定语；用于口语"},{"id":19231,"word":"恩恩爱爱","pinyin":"ēn ēn ài ài","abbr":"eeaa","explanation":"夫妻恩爱，情义极为深厚。有时也指骨肉之间的真挚感情。","source":{"text":"结发为夫妻，恩爱两不疑。","book":"汉·苏武《诗四首》"},"example":{"text":"两个～，说了一回。","book":"清·钱彩《说岳全传》第四十六回"},"similar":["卿卿我我"],"opposite":["凄凄凉凉"],"usage":"作谓语、定语；用于夫妻间"},{"id":19232,"word":"恩恩相报","pinyin":"ēn ēn xiāng bào","abbr":"eexb","explanation":"用恩惠报答恩惠；把有利于人的行为回报给有恩于己的人。","source":{"text":"曾有病，他割下腿上的一片精肉煎汤我吃，我就好了……我会去救他，正是恩恩相报。","book":"明·罗贯中《平妖传》第11回"},"example":{"text":"～何时了，就此打止吧。"},"similar":["以德报恩"],"opposite":["恩将仇报"],"usage":"作主语、宾语；指以恩报恩"},{"id":19233,"word":"恩断义绝","pinyin":"ēn duàn yì jué","abbr":"edyj","explanation":"恩：恩情；义：情义。感情破裂。多指夫妻离异。","source":{"text":"咱两个恩断义绝，花残月缺，再谁恋锦帐罗帏。","book":"元·马致远《任风子》第三折"},"example":{"text":"今与郎君～矣，天荒地老，永无见期。","book":"清·徐瑶《太狠生传》"},"similar":["镜破钗分","花残月缺"],"opposite":["情深义笃","相依为命"],"usage":"作定语、谓语、补语；形容情谊断裂"},{"id":19234,"word":"恩断意绝","pinyin":"ēn duàn yì jué","abbr":"edyj","explanation":"恩：恩惠，恩情；意：情份。恩爱和情义完全断绝，形容感情破裂。","source":{"text":"你若得见了你的亲娘，莫漏泄，休将我恩断意绝，可怜我无家无业。","book":"明·无名氏《认金梳》第一折"},"similar":["恩断义绝","恩绝义断"],"usage":"作定语、谓语、补语；形容情谊断裂"},{"id":19235,"word":"恩有重报","pinyin":"ēn yǒu zhòng bào","abbr":"eyzb","explanation":"好好地报答别人的重大恩惠。","source":{"text":"素姐道：‘若得如此，恩有重报。’","book":"清·西周生《醒世姻缘传》第86回"},"example":{"text":"我知道～的。"},"usage":"作宾语；指报恩"},{"id":19236,"word":"恩深义重","pinyin":"ēn shēn yì zhòng","abbr":"esyz","explanation":"恩惠、情义极为深重。","source":{"text":"事出非常，荣加望外，恩深义厚，何以克堪；糜躯粉骨，不知所报。","book":"唐·吕颂《代郭令公谢男尚公主表》"},"example":{"text":"因爹妈执意不从，故把儿子玉郎假妆嫁来。不想母亲叫孩儿陪伴，遂成了夫妇。～，誓必图百年偕老。","book":"明·冯梦龙《醒世恒言》卷八"},"similar":["恩山义海","恩深似海"],"usage":"作谓语、定语；指恩情很深"},{"id":19237,"word":"恩深似海","pinyin":"ēn shēn sì hǎi","abbr":"essh","explanation":"恩德情义极为深重。","source":{"text":"海誓山盟，各无他志。真个恩深似海无底，义重如山义更高。","book":"明·冯梦龙《警世通言》第32卷"},"similar":["恩高义厚","恩深义重","恩深爱重"],"usage":"作谓语、定语；指恩情很深"},{"id":19238,"word":"恩深法弛","pinyin":"ēn shēn fǎ chí","abbr":"esfc","explanation":"弛：废弛。因恩情深厚而不执行法纪，使犯罪的人逃脱应受到的惩罚。","source":{"text":"相从患难，共守孤城，推食解衣，情同骨肉。乃恩深法弛，背道寒盟，瘏口罔闻，剖心难谅。","book":"蔡东藩、许廑父《民国通俗演义》第十四回"}},{"id":19239,"word":"恩深法驰","pinyin":"ēn shēn fǎ chí","abbr":"esfc","explanation":"驰：废弛。因恩情深厚关系密切而不执行法纪。","source":{"text":"乃恩深法驰，背道寒盟，瘏口罔闻，剖心难谅。","book":"蔡东藩《民国通俗演义》第14回"},"usage":"作宾语、定语；用于情与法"},{"id":19240,"word":"恩深爱重","pinyin":"ēn shēn ài zhòng","abbr":"esaz","explanation":"恩德情义极为深重。","source":{"text":"素贞与许郎恩深爱重……望求老禅师放他出来，夫妻重聚。","book":"京剧《白蛇传》第16场"},"similar":["恩深义重","恩高义厚"],"usage":"作谓语、定语；指恩情很深"},{"id":19241,"word":"恩爱夫妻","pinyin":"ēn ài fū qī","abbr":"eafq","explanation":"恩爱：相亲相爱。夫妻感情融洽，情投意合。","source":{"text":"结发为夫妻，恩爱两不疑。","book":"汉·苏武《诗四首》"},"example":{"text":"～抛弃，孝慈父子分离。","book":"清·西周生《醒世姻缘传》第三十一回"},"usage":"作主语、宾语、定语；用于夫妻"},{"id":19242,"word":"恩甚怨生","pinyin":"ēn shèn yuàn shēng","abbr":"esys","explanation":"给予太多的恩惠，反而会引起怨恨。","source":{"text":"恩甚则怨生，爱多则憎至。","book":"《亢仓子·用道》"},"example":{"text":"不必过多施恩给他，小心会～。"},"usage":"作宾语、定语；指给予太多的恩惠会产生怨恨"},{"id":19243,"word":"恩礼有加","pinyin":"ēn lǐ yǒu jiā","abbr":"elyj","explanation":"恩礼：指帝王厚待臣下。帝王以恩德与礼遇厚待臣下。引申指很有礼地对待下属。","source":{"text":"迁侍中，数召宴见，问以得失，赏赐恩礼宠异焉。","book":"《后汉书·鲁恭传》"}},{"id":19244,"word":"恩绝义断","pinyin":"ēn jué yì duàn","abbr":"ejyd","explanation":"恩：恩情；义：情义。感情破裂。多指夫妻离异。","source":{"text":"咱两个恩断义绝，花残月缺，再谁恋锦帐罗帏。","book":"元·马致远《任风子》第三折"},"similar":["恩断意绝"],"usage":"作定语、谓语、补语；用于朋友或亲人间"},{"id":19245,"word":"恩若再生","pinyin":"ēn ruò zài shēng","abbr":"erzs","explanation":"恩惠极大如同给了第二次生命。","source":{"text":"勾践囚于吾国……今吾复其社稷，恩若再生。","book":"明·冯梦龙《东周列国志》第八十一回"},"similar":["恩同再造","恩同父母"],"opposite":["仇深似海"],"usage":"作谓语、宾语；同“恩同再造”"},{"id":19246,"word":"恩荣并济","pinyin":"ēn róng bìng jì","abbr":"erbj","explanation":"恩荣：恩惠荣宠。济：调济。恩惠与荣耀两种手段一起施行。","source":{"text":"限之以爵，爵加则知荣，恩荣并济，上下有节，为治之道，于斯著矣。","book":"明·罗贯中《三国演义》第六十五回"},"usage":"作宾语、定语；指管理手段"},{"id":19247,"word":"恩逾慈母","pinyin":"ēn yú cí mǔ","abbr":"eycm","explanation":"逾：超过。比慈爱的母亲给予的恩情还要重。形容恩情深厚。","source":{"text":"陛下恩逾慈母。","book":"唐·韩愈《御史台上论天旱人饥状》"},"similar":["恩同父母"],"opposite":["不共戴天"],"usage":"作谓语、宾语；指恩情很深"},{"id":19248,"word":"恩重丘山","pinyin":"ēn zhòng qiū shān","abbr":"ezqs","explanation":"恩：恩惠。恩情像高山一样厚重，形容恩义极为深重。","source":{"text":"上下交攻，命危丝发；是非随定，恩重丘山。","book":"宋·陈亮《谢曾察院启》"},"similar":["恩重如山","恩德如山"],"usage":"作谓语、定语；用于感激词"},{"id":19249,"word":"恩重如山","pinyin":"ēn zhòng rú shān","abbr":"ezrs","explanation":"恩情深厚，像山一样深重。","source":{"text":"拔茅以征，冒处清流之末；及瓜雨往，曾无累月之淹。恩重如山，感深至骨。","book":"宋·陆游《删定官供职谢启》"},"example":{"text":"神僧～，寡人酬谢不尽。","book":"明·吴承恩《西游记》第六十九回"},"similar":["恩深义重"],"opposite":["绝情寡义"],"usage":"作谓语、定语；用于感激词"},{"id":19250,"word":"恩重泰山","pinyin":"ēn zhòng tài shān","abbr":"ezts","explanation":"恩情深厚，比泰山还重。","source":{"text":"君思重泰山，未有毫发酬。","book":"宋·刘攽《彭城集·次韵孙少述二首》"},"similar":["恩重如山","恩同山岳"],"usage":"作谓语、定语；用于感激词"},{"id":19251,"word":"恩高义厚","pinyin":"ēn gāo yì hòu","abbr":"egyh","explanation":"恩惠、情义极为深厚。","source":{"text":"事出非常，荣加望外，恩深义厚，何以克堪；糜躯粉骨，不知所报。","book":"唐·吕颂《代郭令公谢男尚公主表》"},"similar":["恩深义重","恩深似海"],"usage":"作谓语、定语；指恩情很深"},{"id":19252,"word":"恪勤匪懈","pinyin":"kè qín fěi xiè","abbr":"kqfx","explanation":"恪：谨慎；匪：通“非”；懈：懈怠。忠于职守，谨慎而不松懈。","source":{"text":"窃见钱唐令刘真道、余杭令刘道锡，皆奉公恤民，恪勤匪懈，百姓称咏，讼诉希简。","book":"《宋书·刘怀素传》"},"example":{"text":"德义有闻、清谨明著、公平可称、～为四善。","book":"《宋史·职官志》"}},{"id":19253,"word":"恪守不渝","pinyin":"kè shǒu bù yú","abbr":"ksby","explanation":"严格遵守，决不改变。","example":{"text":"我们对和平统一台湾的方针～。"},"usage":"作谓语、宾语；指严格遵守"},{"id":19254,"word":"恪守成宪","pinyin":"kè shǒu chéng xiàn","abbr":"kscx","explanation":"恪守：谨守。谨守既定的法令，毫不通融。","source":{"text":"元贞以来，朝廷恪守成宪，诏书屡下，散财发粟，不惜巨万，以颁赐百姓，当时以贤相称之。","book":"《元史·完泽传》"},"example":{"text":"要发展，就不能～，墨守成规。"},"similar":["恪守成式","墨守成规"],"usage":"作谓语、定语；指不知变通"},{"id":19255,"word":"恪守成式","pinyin":"kè shǒu chéng shì","abbr":"kscs","explanation":"恪守：谨守。谨守既定的法令，毫不通融。","source":{"text":"朕御极后，恪守成式，亲书密旨。","book":"《清史稿·端慧太子永琏传》"},"similar":["恪守成宪"],"usage":"作谓语、定语；指不知变通"},{"id":19256,"word":"恫心疾首","pinyin":"dòng xīn jí shǒu","abbr":"dxjs","explanation":"形容极端痛恨。","source":{"text":"我先君昔事隋，职贡无废，乃贪我土宇，灭我宗祊，我是以恫心疾首，思刷厥耻。","book":"《新唐书·萧铣传》"},"similar":["痛心疾首"],"usage":"作谓语、宾语；指十分仇恨"},{"id":19257,"word":"恫疑虚喝","pinyin":"dòng yí xū hè","abbr":"dyxh","explanation":"虚张声势，恐吓威胁。","source":{"text":"是故洞疑虚喝，骄矜而不敢进。","book":"《史记·苏秦列传》"},"example":{"text":"又惧天下之不吾信也，于是～而傲睨顾盼，以济其方术之穷。","book":"清·戴名世《序》"},"similar":["虚张声势"],"usage":"作谓语、定语；指虚张声势"},{"id":19258,"word":"恫疑虚猲","pinyin":"dòng yí xū gé","abbr":"dyxg","explanation":"虚张声势，恐吓威胁。同“恫疑虚喝”。","source":{"text":"《史记·苏秦列传》：“是故洞疑虚喝，骄矜而不敢进。”《战国策齐策一》作“恫疑虚猲”。"},"example":{"text":"凡夫～，荒渺浮夸，举无所施其伎焉者，得此道也。","book":"严复《救亡决论》"},"similar":["恫疑虚喝"],"usage":"作谓语、定语；指虚张声势"},{"id":19259,"word":"恫瘝一体","pinyin":"dòng guān yī tǐ","abbr":"dgyt","explanation":"指对民间疾苦感同身受，看作是自己的痛苦。","source":{"text":"恫瘝一体，休戚相关，恩膏覃敷，海宇均蒙雨露沾濡。","book":"太平天国·黄期陞《建天京于金陵论》"},"usage":"作定语；用于处事"},{"id":19260,"word":"恫瘝在抱","pinyin":"dòng guān zài bào","abbr":"dgzb","explanation":"比喻把人民的疾苦放在心上。","source":{"text":"执事恫瘝在抱，诚欲继睢州、桂林之业，自非风行雷厉，恐无以溥实惠而挽颓风。","book":"清·冯桂芬《与许抚部书》"},"example":{"text":"前回一个大善士，专诚到扬州去劝捐，做得那种～，愁眉苦目的样子，真正有己饥己溺的神情。","book":"《二十年目睹之怪现状》第六十回"},"similar":["恫瘝在身"],"usage":"作谓语、定语；用于统治者或官员等"},{"id":19261,"word":"恫瘝在身","pinyin":"tōng guān zào shēn","abbr":"dgzs","explanation":"恫瘝：病痛，比喻疾苦。病痛在自己身上。古时形容爱民的殷切，人民的痛苦就像在自己身上一样。","source":{"text":"呜呼小子封，恫瘝乃身，敬哉。","book":"《尚书·康诰》"},"example":{"text":"与天地万物为一体，处处～，非特一诗人云尔也。","book":"清·无名氏《杜诗言志》卷二"},"similar":["恫瘝在抱"],"usage":"作谓语、定语；用于统治者或官员等"},{"id":19262,"word":"恬不为怪","pinyin":"tián bù wéi guài","abbr":"tbwg","explanation":"恬：安然；为：认为。指看到不合理的事物，毫不觉得奇怪。","source":{"text":"至于俗流失，世坏败，因恬而不知怪。","book":"《汉书·贾谊传》"},"example":{"text":"因喻及高纲身为汉军，且为高其佩之子，世受国恩，乃有此等悖逆之事，～。","book":"清·叶廷琯《鸥陂渔话·附记编行堂集事》"},"similar":["恬不知怪"],"usage":"作谓语、定语；指不以为怪"},{"id":19263,"word":"恬不为意","pinyin":"tián bù wéi yì","abbr":"tbwy","explanation":"处之泰然，满不在乎。","source":{"text":"岂有仁圣在上，群贤并用，而肯恬不为意乎。","book":"宋·苏轼《上执政乞度牒赈济及因修廨宇书》"},"example":{"text":"惟孟明自恃才勇，以为成功可必，～。","book":"明·余邵鱼《东周列国志》第四十四回"},"usage":"作谓语、定语；用于处事"},{"id":19264,"word":"恬不知怪","pinyin":"tián bù zhī guài","abbr":"tbzg","explanation":"指安然处之，不以为怪。","source":{"text":"既任止于训词，故权移于胥史，恬不知怪，习为故常。","book":"语出汉·贾谊《治安策》：“至于俗流失，世坏败，因恬而不知怪。”宋·苏轼《谢中书舍人表》"},"example":{"text":"日久相沿，～，惜无有正之者。","book":"清·刘献廷《广阳杂记》卷五"},"similar":["恬不为怪","不以为怪"],"usage":"作谓语、定语；指不以为怪"},{"id":19265,"word":"恬不知愧","pinyin":"tián bù zhī kuì","abbr":"tbzk","explanation":"安然处之，不以为耻。同“恬不知耻”。","source":{"text":"军法，大将失律者，斩。琯失律，宜斩；不斩而罢，已属非法，尚恬不知愧，宾客盈门。","book":"清·阎尔梅《房琯论》"},"similar":["恬不知羞","恬不知耻"],"usage":"作谓语、定语、状语；指不要脸"},{"id":19266,"word":"恬不知羞","pinyin":"tián bù zhī xiū","abbr":"tbzx","explanation":"安然处之，不以为耻。同“恬不知耻”。","source":{"text":"特不解当时妇女，何以恬不知羞，岂真叔宝全无心肝者哉？","book":"清·王韬《凇隐漫录·冯佩伯》"},"similar":["恬不知耻","恬不知愧"],"usage":"作谓语、定语、状语；指不要脸"},{"id":19267,"word":"恬不知耻","pinyin":"tián bù zhī chǐ","abbr":"tbzc","source":{"text":"卫礼至行险，侥幸而取其国，恬不知耻，反勒其功于铭，以章示后。","book":"唐·冯贽《云仙杂记》卷八：“倪芳饮后，必有狂怪，恬然不耻。”宋·吕祖谦《左氏博议·卫礼至为铭》"},"example":{"text":"“打这个～的走狗！”台下一片激怒的喊声，还是震动了台上的胡博士。 ◎杨沫《青春之歌》第四十三章"},"similar":["厚颜无耻","满不在乎"],"opposite":["天地自容"],"usage":"偏正式；作谓语、定语、状语；含贬义"},{"id":19268,"word":"恬淡寡欲","pinyin":"tián dàn guǎ yù","abbr":"tdgy","explanation":"恬淡：安静闲适，不求名利；寡：少；欲：欲望。心境清静淡泊，没有世俗的欲望。","source":{"text":"而伟长独怀文抱质，恬然寡欲，有箕山之志，可谓彬彬君子者矣。","book":"三国·魏·曹丕《与吴质书》"},"example":{"text":"贫道原是～的，可惜这个顽徒，道行未深，经过京城繁华地面，信手挥霍。","book":"清·李绿园《歧路灯》第七十五回"},"similar":["恬淡无欲"],"opposite":["追名遂利"],"usage":"作谓语、定语；指不追名遂利"},{"id":19269,"word":"恬淡无为","pinyin":"tián dàn wú wéi","abbr":"tdww","explanation":"心境清静自适而无所营求。","source":{"text":"夫恬淡寂漠，虚无无为，此天地之平，而道德之质也。","book":"战国·宋·庄周《庄子·刻意》"},"example":{"text":"～，以道自怡，妙中之妙，微中之微。","book":"唐·王邕《修养杂诀气铭》"},"similar":["清静无为"],"usage":"作谓语、定语；指人的心境"},{"id":19270,"word":"恬淡无欲","pinyin":"tián dàn wú yù","abbr":"tdwy","explanation":"心境清静淡泊，没有世俗的欲望。","source":{"text":"世或以老子之道为可以度世，恬淡无欲，养精爱气。","book":"汉·王充《论衡·道虚》"},"example":{"text":"～是一药，仁顺谦让是一药。","book":"《云笈七签》卷四十"},"similar":["恬淡寡欲"],"opposite":["追名遂利"],"usage":"作谓语、定语；指不追名遂利"},{"id":19271,"word":"恬然自得","pinyin":"tián rán zì dé","abbr":"trzd","explanation":"恬然：安适愉快的样子。形容高兴而满足的样子。","source":{"text":"黄帝既寤，怡然自得。","book":"《列子·黄帝》"},"example":{"text":"杨过暗自佩服，心想他被困多日，仍然安之若素，临难则～，遇救则淡然以嘻，这等胸襟，自己远远不及。","book":"金庸《神雕侠侣》三一"},"similar":["恬然自足"],"usage":"作谓语、定语、状语；用于处事"},{"id":19272,"word":"恬然自足","pinyin":"tián rán zì zú","abbr":"trzz","explanation":"指胸中恬淡，无处不感到满足。","source":{"text":"故和靖能高卧孤山，而足迹不入城市者二十余年，而从无一日不恬然自足，诚甘心于隐，而非假借也。","book":"《西湖佳话·孤山隐迹》"},"similar":["恬然自得"],"usage":"作谓语、定语、状语；用于处事"},{"id":19273,"word":"恬而不怪","pinyin":"tián ér bù guài","abbr":"tebg","explanation":"恬：安然。指看到不合理的事物，毫不觉得奇怪。","source":{"text":"至于俗流失，世坏败，因恬而不知怪，虑不动于耳目，以为是适然耳。","book":"汉·贾谊《上书陈政事·治安策》"},"example":{"text":"若细微之灾，～，及祸变成象，骇而图之，犹水决而缮防，疾困而求药，虽复黾勉，亦何救哉！","book":"《旧唐书·五行志》"}},{"id":19274,"word":"恬言柔舌","pinyin":"tián yán róu shé","abbr":"tyrs","explanation":"犹言甜言蜜语。","source":{"text":"故有知之者，有怒之者，怒不附己者，怒不恬言柔舌道其盛美者，怒守直道而违己者。","book":"唐·杜牧《上池州李使君书》"},"similar":["甜言蜜语","甜言媚语"],"usage":"作主语、宾语；指骗人开心的话"},{"id":19275,"word":"恭候台光","pinyin":"gōng hòu tái guāng","abbr":"ghtg","explanation":"恭：恭敬；修：等候；台：旧时对人的敬称；光：光临。恭恭敬敬地等候着您的光临。","source":{"text":"敬治薄酒，恭候台光。","book":"清·李宝嘉《官场现形记》第一回"},"example":{"text":"敬于月之十日正午，在舍～，小酌爽叙，勿却是幸。","book":"张恨水《啼笑姻缘》第六回"},"similar":["恭候光临"],"usage":"作谓语；用于请人的客套话"},{"id":19276,"word":"恭喜发财","pinyin":"gōng xǐ fā cá","abbr":"gxfc","explanation":"恭喜：恭贺他人的喜事。旧时指祝贺人发财富裕的客套话。","source":{"text":"放鞭炮，打麻将，拜年，‘恭喜发财’！","book":"鲁迅《过年》"},"example":{"text":"～，红包拿来。"},"usage":"作谓语、定语；用于祝贺"},{"id":19277,"word":"恭恭敬敬","pinyin":"gōng gōng jìng jìng","abbr":"ggjj","explanation":"对尊长贵宾谦恭而有礼貌。","source":{"text":"因是儿子的终身大事所关，说不得东拼西凑，恭恭敬敬封了二十四两贽见礼。","book":"清·曹雪芹《红楼梦》第八回"},"example":{"text":"他们是准备投降的，所以～地执行了日本人和汪精卫的命令，先把最坚决的抗日分子杀死。","book":"毛泽东《必须制裁反对派》"},"similar":["毕恭毕敬"],"opposite":["不可一世"],"usage":"作定语、状语；用于处世","story":["宝玉请求贾母同意让秦可卿的弟弟秦钟与他一起上学，秦钟十分高兴，就回去与父亲秦业说。秦业见儿子的老师已经去世，这是个好机会，但自己宦囊羞涩，贾府都是富贵眼睛，也只好东拼西凑24两银子，恭恭敬敬送秦钟到贾府家学房去上学"]},{"id":19278,"word":"恭敬不如从命","pinyin":"gōng jìng bù rú cóng mìng","abbr":"gjbrcm","explanation":"客套话。多用在对方对自己客气，虽不敢当，但不好违命。","source":{"text":"恭敬不如从命，受训莫如从顺。","book":"宋·释赞宁《笋谱》卷下"},"example":{"text":"姑奶奶，既老爷这等吩咐，～，毕竟侍候坐下好说话。","book":"清·文康《儿女英雄传》第十四回"},"usage":"作谓语、分句；作客套话"},{"id":19279,"word":"恭敬桑梓","pinyin":"gōng jìng sāng zǐ","abbr":"gjsz","explanation":"恭敬：尊敬，热爱；桑梓：桑树和梓树，古时家宅旁边常栽的树木，比喻故乡。热爱故乡和尊敬故乡的人。","source":{"text":"维桑与梓，必恭敬之。","book":"《诗经·小雅·小弁》"},"example":{"text":"岂孩儿未曾～？","book":"明·王世贞《鸣凤记》第二十九出"},"usage":"作谓语、宾语；指热爱故乡"},{"id":19280,"word":"恭而敬之","pinyin":"gōng ré jìng zhī","abbr":"gejz","explanation":"恭：恭敬；敬：敬重。恭敬的加重说法或诙谐说法。","source":{"text":"李顺恭而敬之的慢慢地卷起那张戏报子。","book":"老舍《赵子曰》第十五章"},"similar":["恭而有礼"],"usage":"作谓语、定语；指人的态度"},{"id":19281,"word":"恭而有礼","pinyin":"gōng ér yǒu lǐ","abbr":"geyl","explanation":"恭：恭敬；礼：礼节。恭敬又有礼节。","source":{"text":"君子敬而无失，与人恭而有礼。","book":"《论语·颜渊》"},"example":{"text":"而且庶士人等……举止言谈，莫不～。","book":"清·李汝珍《镜花缘》第十一回"},"similar":["恭而敬之"],"usage":"作谓语；指恭敬又有礼节"},{"id":19282,"word":"恭行天罚","pinyin":"gōng xíng tiān fá","abbr":"gxtf","explanation":"奉天之命进行惩罚。古用来称天子用兵。","source":{"text":"今予惟恭行天之罚。","book":"《尚书·甘誓》"},"example":{"text":"诸帅戮力，～。","book":"唐·陆贽《平朱泚后车驾还京大赦制》"},"similar":["龚行天罚"],"usage":"作谓语；指奉天之命进行惩罚"},{"id":19283,"word":"恭贺新禧","pinyin":"gōng hè xīn xǐ","abbr":"ghxx","explanation":"禧：吉祥幸福。恭敬地祝贺新年幸福吉祥如意。贺年的常用语。","source":{"text":"全都张灯结彩，高悬着‘庆祝元旦’、‘恭贺新禧’之类的大字装饰。","book":"罗广斌、杨益言《红岩》第一章"},"example":{"text":"春节到来，大家张灯结彩，恭贺新禧，互致祝福。"},"similar":["新年快乐"],"usage":"作宾语、定语；贺年的常用语"},{"id":19284,"word":"恭逢其盛","pinyin":"gōng féng qí shèng","abbr":"gfqs","explanation":"恭：恭敬；逢：遇到；盛：盛况，盛会。敬逢这一盛况或盛会。","source":{"text":"这是卿等调燮之功，使朕恭逢其盛。","book":"唐·王勃《滕王阁饯别序》：“童子何知，躬逢胜饯。”明·许三阶《节侠记·二十五·诬激》"},"example":{"text":"可惜今年殿试都不能～，愚姐妹向来并未用功，今年不去，倒是借此藏拙。","book":"清·李汝珍《镜花缘》第六十五回"},"similar":["躬逢其盛"],"usage":"作谓语；指敬逢这一盛况或盛会"},{"id":19285,"word":"恭默守静","pinyin":"gōng mò shǒu jìng","abbr":"gmsj","explanation":"默：沉默；守：遵守，保持。恭恭敬敬地沉默，不讲话，保持肃静。","source":{"text":"又自以归付非素，惧见猜嫌，恭默守静，退无私交，非公事不言。","book":"《三国志·蜀书·刘巴传》"},"usage":"作谓语、定语；用于人的神态"},{"id":19286,"word":"息事宁人","pinyin":"xī shì níng rén","abbr":"xsnr","explanation":"息：平息；宁：使安定。原指不生事，不骚扰百姓，后指调解纠纷，使事情平息下来，使人们平安相处。","source":{"text":"其令有司，罪非殊死，且勿案验；及吏人条书相告，不得听受，冀以息事宁人。","book":"《后汉书·章帝纪》"},"example":{"text":"我承认我是抱着“～”的苦衷来接受它的。","book":"闻一多《四杰》"},"similar":["相安无事"],"opposite":["推波助澜","无事生非"],"usage":"作谓语、宾语、定语；指调解纠纷"},{"id":19287,"word":"息交绝游","pinyin":"xī jiāo jué yóu","abbr":"xjjy","explanation":"屏绝交游活动。隐居。","source":{"text":"归去来兮，请息交以绝游，世与我而相遗，复驾言兮焉求？","book":"语出晋·陶潜《归去来辞》"},"example":{"text":"刘斯立……屏居东平，杜门却扫，息交绝游，人罕识其面。","book":"宋·王明清《挥麈后录》卷八"},"similar":["杜门却扫"],"usage":"作谓语；指隐居"},{"id":19288,"word":"息兵罢战","pinyin":"xī bīng bà zhàn","abbr":"xbbz","explanation":"停止或结束战争。","source":{"text":"宋朝南渡以后，绍兴、淳熙年间息兵罢战，君相自谓太平，纵情佚乐，士大夫赏玩湖山，无复恢复中原之志。","book":"明·冯梦龙《喻世明言》卷二十二"},"example":{"text":"情愿招为驸马，两家～，永作藩臣，重来进贡。","book":"清·陈忱《水浒后传》第十二回"},"similar":["休兵罢战"],"usage":"作谓语、宾语、定语；指停战"},{"id":19289,"word":"息军养士","pinyin":"xī jūn yǎng shì","abbr":"xjys","explanation":"息、养：休息教养，休整；军、士：军队中的官兵。指休整部队，积蓄力量，以利再战。","source":{"text":"愚以为可且按甲寝兵，息军养士，分土定封，论功行赏，若此则内外之心固，有功者劝，而天下知制矣。","book":"《三国志·魏志·武帝纪》"},"example":{"text":"愚以为且宜增修文德，按甲寝兵，～，待时而动。","book":"明·罗贯中《三国演义》第六十六回"},"usage":"作谓语、宾语、定语；用于作战等"},{"id":19290,"word":"息壤在彼","pinyin":"xī rǎng zài bǐ","abbr":"xrzb","explanation":"息壤：地名，秦邑名。在息壤订立的誓约还算数。多用作信誓的代称。","source":{"text":"武王召甘茂，欲罢兵。甘茂曰：‘息壤在彼。’王曰：‘有之。’因大悉起兵，使甘茂击之。","book":"《史记·樗里子甘茂列传》"},"example":{"text":"～，“七月七日长生殿”的话，岂忘之乎？","book":"清·文康《儿女英雄传》缘起首回"}},{"id":19291,"word":"息影家园","pinyin":"xī yǐng jiā yuán","abbr":"xyjy","explanation":"息影：退隐闲居。形容回到家里过安闲自在的生活。","source":{"text":"喜入山林初息影，厌趋朝市主劳生。","book":"唐·白居易《重题》"},"example":{"text":"他们说上次良哥铩羽而归，现在～，上奉老母，下抚幼女，已经英雄气短，不想再管闲事了！","book":"茅盾《霜叶红于二月花》第十五章"},"usage":"作谓语、定语；用于生活"},{"id":19292,"word":"息怒停瞋","pinyin":"xī nù tíng chēn","abbr":"xntc","explanation":"瞋：发怒时睁大眼睛。停止发怒和生气。多用作劝说，停息恼怒之辞。","source":{"text":"夫人休闪了手，且息怒停瞋，听红娘说。","book":"元·王实甫《西厢记》第四本第二折"},"similar":["停瞋息怒"],"usage":"作谓语、定语；用于处事"},{"id":19293,"word":"息息相关","pinyin":"xī xī xiāng guān","abbr":"xxxg","explanation":"息：呼吸时进出的气。呼吸也相互关联。形容彼此的关系非常密切。","source":{"text":"造古人五七古诗若干首，读万遍或数万遍，熟其音节气味，心解神悟，久久觉得……我之形神与古人之气脉息息相关。","book":"清·延君寿《老生常谈》"},"example":{"text":"无线电网繁密而敏捷，世界的每一角落～，真是个“天下一家”。","book":"朱自清《三记报章文学》"},"similar":["息息相通","患难与共"],"opposite":["漠不关心","水火不容"],"usage":"作谓语、宾语、定语；指人或事物关系"},{"id":19294,"word":"息息相通","pinyin":"xī xī xiāng tōng","abbr":"xxxt","explanation":"呼吸也相互关联。形容彼此的关系非常密切。","source":{"text":"造古人五七古诗若干首，读万遍或数万遍，熟其音节气味，心解神悟，久久觉得……我之形神与古人之气脉息息相关。","book":"清·延君寿《老生常谈》"},"example":{"text":"文学也可以说是用文字来表现的绘画，艺术各部门的道理在根本上是～的。","book":"秦牧《一幅古画的风味》"},"similar":["息息相关","心心相印"],"opposite":["漠不关心","不相往来"],"usage":"作谓语、宾语、定语、分句；形容关系"},{"id":19295,"word":"息肩之地","pinyin":"xī jiān zhī dì","abbr":"xjzd","explanation":"息肩：枉身，立足。指立足的地方。","source":{"text":"吾与山中之友，市药于广陵，亦有息肩之地。","book":"宋·李昉《太平广记》卷十七"},"example":{"text":"贾雨村在旅店偶感风寒，愈后又因盘费不继，正欲得一个居停之所以为～。","book":"清·曹雪芹《红楼梦》第二回"}},{"id":19296,"word":"息肩弛担","pinyin":"xī jiān chí dàn","abbr":"xjcd","explanation":"放下肩上挑的担子。形容摆脱职务，卸去责任。","source":{"text":"去年秋，群试监中，有司以为不肖，始决意为卢肩弛担之计。","book":"宋·陈亮《与应仲实书》"},"example":{"text":"百姓戍守锋镝之余，未及～，又复救死扶伤。","book":"明·王阳明《乞宽免税粮急救民困以弭灾变疏》"}},{"id":19297,"word":"息迹静处","pinyin":"xī jì jìng chù","abbr":"xjjc","explanation":"息：止息；迹：行迹，脚印；处：处所。要想不见行迹，只有自己静止不动。引申为要想人不知，除非己莫为。","source":{"text":"人有畏影恶迹而去之走者，举足愈数而迹愈多，走愈疾而影不离身……不知处阴以休影，处静以息迹，愚亦甚矣。","book":"《庄子·渔父》"},"similar":["处静息迹"],"usage":"作宾语、定语；用于处事"},{"id":19298,"word":"息黥补劓","pinyin":"xī qíng bǔ yì","abbr":"xqby","explanation":"指修整面容残缺，恢复本来面目。后用以喻改过自新。","source":{"text":"……庸讵知夫造物者之不息我黥而补我劓，使我乘成以随先生邪。","book":"《庄子·大宗师》"},"example":{"text":"策蹇磨铅，少答非常之遇；～，渐收无用之身。","book":"宋·苏轼《登州谢两府启》"},"usage":"作宾语、定语；用于书面语","story":["相传远古时期，意而子去拜见许由，许由问尧为什么会帮助他。意而子回答说：“尧要我躬服仁义而明言是非。”许由又问他尧是怎样教他明白仁义与是非的。意而子回答道：“庸讵知夫造物者之不息我黥而补我劓，使我乘成以随先生邪？”"]},{"id":19299,"word":"息鼓偃旗","pinyin":"xī gǔ yǎn qí","abbr":"xgyq","explanation":"偃：仰卧，引申为倒下。放倒旗子，停止敲鼓。原指行军时隐蔽行踪，不让敌人觉察。现比喻事情终止或声势减弱。","source":{"text":"云入营，更大开门，偃旗息鼓，公军疑云有伏兵，引去。","book":"《三国志·蜀书·赵云传》裴松之注引《赵云别传》"},"example":{"text":"国民党的几次反共高潮，很快～，与华侨的反对态度有直接关系。","book":"孙挺信《中日大决战》第四章"}},{"id":19300,"word":"恰中要害","pinyin":"qià zhòng yào hài","abbr":"qzyh","explanation":"要害：易于致命的部位，引伸为重要部门或问题的关键。正打中致命的部位。","example":{"text":"他一脚踢去，～。"},"similar":["击中要害"],"usage":"作谓语、宾语；指打中致命的部位"},{"id":19301,"word":"恰到好处","pinyin":"qià dào hǎo chù","abbr":"qdhc","explanation":"恰：恰好。指说话做事恰好到了最合适的地步。","source":{"text":"恰到好处，恰够消息。毋不及，毋太过。","book":"清·况周颐《惠风词话》卷一"},"example":{"text":"只是平心静气的说，紧要关头却不放松一步；真所谓～。","book":"朱自清《经典常谈·春秋三传第六》"},"similar":["恰如其分","适可而止"],"opposite":["过犹不及","矫枉过正","大相径庭"],"usage":"作谓语、状语、宾语；指到了最合适的地步"},{"id":19302,"word":"恰如其分","pinyin":"qià rú qí fèn","abbr":"qrqf","explanation":"恰：正好。指办事或说话正合分寸。","source":{"text":"赏分轻重，俱是阎仲端酌度，多寡恰如其分，无不欢喜。","book":"清·李绿园《歧路灯》第一○八回"},"example":{"text":"老师举的这个例子～，同学们很快就掌握了这种方法。"},"similar":["恰到好处","毫发不爽"],"opposite":["离题万里","毫厘千里"],"usage":"作谓语、宾语、状语、定语；指说话或做事"},{"id":19303,"word":"恶不去善","pinyin":"wù bù qù shàn","abbr":"wbqs","explanation":"不因为厌恶某人而否定他的优点。","source":{"text":"私仇不及公，好不废过，恶不众善，义之经也。","book":"《左传·哀公五年》"},"usage":"作谓语、定语；指不因为厌恶某人而否定他的"},{"id":19304,"word":"恶事传千里","pinyin":"è shì chuán qiān lǐ","abbr":"escql","explanation":"恶事：坏事，丑事。形容败坏名誉的事很容易传开来。","source":{"text":"自古道：好事不出门，恶事传千里。不到半月之间，街坊邻居，都知得了，只瞒着武大一个不知。","book":"明·施耐庵《水浒传》第24回"},"example":{"text":"好事不出门，～。"},"similar":["恶事行千里"],"usage":"作宾语、定语；指败坏名誉的事很容易传扬"},{"id":19305,"word":"恶事行千里","pinyin":"è shì xíng qiān lǐ","abbr":"esxql","explanation":"指好事不容易被人知道，坏事却传播得极快（含有劝告的意思）。","source":{"text":"所谓好事不出门，恶事行千里，士君子得不戒之乎？","book":"宋·孙光宪《北梦琐言》卷六"},"example":{"text":"赶紧给她找个婆家罢，“～”，她的厉害名儿太出远了，将来没人敢要。","book":"冰心《冬儿姑娘》"},"similar":["恶事传千里"],"opposite":["好事不出门"],"usage":"作宾语、定语；含有劝告的意思"},{"id":19306,"word":"恶人先告状","pinyin":"è rén xiān gào zhuàng","abbr":"erxgz","explanation":"自己干了坏事，却抢先去诬告别人。","source":{"text":"经我强硬的答复，没法对付，便用最终的毒计，就是以退为进，先发制人，亦即所谓‘恶人先告状’也。","book":"鲁迅《两地书》"},"example":{"text":"请不要相信他的～。"},"usage":"作宾语、定语；指先出手"},{"id":19307,"word":"恶人自有恶人磨","pinyin":"è rén zì yǒu è rén mó","abbr":"erzyerm","explanation":"凶恶成性的人自然会有更凶恶的人使他吃尽苦头。即恶有恶报。","source":{"text":"近奸近杀古无讹，恶人自有恶人磨。","book":"明·周楫《西湖二集·周城隍辨冤断案》"},"example":{"text":"～，窃盗劫来强盗打。","book":"清·西周生《醒世姻缘传》第十一回"},"similar":["强中更有强中手"],"usage":"作宾语、定语；用于口语"},{"id":19308,"word":"恶作剧","pinyin":"è zuò jù","abbr":"ezj","explanation":"捉弄人的使人难堪的行动。","source":{"text":"僧初若不觉，凡五发中之，僧始扪中处，徐曰：‘郎君莫恶作剧。’","book":"唐·段成式《酉阳杂俎·盗侠》"},"example":{"text":"观其孜孜憨笑，似全无心肝者，而墙下～，其黠孰甚焉！（清·蒲松龄《聊斋志异·婴宁》）"},"usage":"作主语、宾语；指戏弄别人"},{"id":19309,"word":"恶叉白赖","pinyin":"é chā bái lài","abbr":"ecbl","explanation":"胡搅蛮缠，耍无赖，无理取闹。","source":{"text":"直恁的恶叉白赖，婆娘家情性恁般乖。","book":"元·马致远《邯郸道省悟黄梁梦》第二折"},"example":{"text":"一会儿甜言热趱，一会儿～，姑姑也，只被你直着俺两下做人难。","book":"元·关汉卿《望江亭中秋切鲙》第一折"},"similar":["胡搅蛮缠"],"usage":"作宾语、定语；指无理取闹"},{"id":19310,"word":"恶声恶气","pinyin":"è shēng è qì","abbr":"eseq","explanation":"形容说话语气很凶狠，态度粗暴。","source":{"text":"曾思懿：（半天在抑压着自己的愠怒，现在不免颜色难看，恶声恶气地）去，要你去干什么？","book":"曹禺《北京人》第三幕"},"example":{"text":"你不能～地对待顾客。"},"similar":["恶言恶语"],"opposite":["好声好气","和蔼可亲"],"usage":"作状语；指人态度恶劣"},{"id":19311,"word":"恶尘无染","pinyin":"è chén wú rǎn","abbr":"ecwr","explanation":"指没有受到坏习气的影响。","source":{"text":"儿童诚可爱，一味天真，恶尘无染。","book":"叶圣陶《穷愁》"},"similar":["一尘不染"],"usage":"作宾语、定语；用于人或社会风气等"},{"id":19312,"word":"恶居下流","pinyin":"wù jū xià liú","abbr":"wjxl","explanation":"恶：讨厌，憎恨；下流：即下游，引伸为卑下的地位。憎恨处于下游。原指君子不愿居于卑下的地位。现也指不甘居下游。","source":{"text":"是以君子恶居下流，天下之恶皆归焉。","book":"《论语·子张》"},"usage":"作谓语、定语；用于处世"},{"id":19313,"word":"恶性循环","pinyin":"è xìng xún huán","abbr":"exxh","explanation":"许多坏事互为因果，循环不已，越来越坏。","source":{"text":"戚祖胜无力还债，只好再去骗，拆东墙补西墙，骗的更大，债主更多，形成了恶性循环。","book":"《新华文摘》1981年11期"},"example":{"text":"人们破坏生态环境，自然就造成生态的～。"},"opposite":["良性循环"],"usage":"作宾语、定语；指越来越坏"},{"id":19314,"word":"恶恶从短","pinyin":"wù wù cóng duǎn","abbr":"wwcd","explanation":"比喻对人所做的坏事，不十分苛责。","source":{"text":"君子之善善也长，恶恶也短，恶恶止其身，善善及子孙。","book":"《公羊传·昭公二十年》"}},{"id":19315,"word":"恶意中伤","pinyin":"è yì zhòng shāng","abbr":"eyzs","explanation":"出自恶毒用心去诽谤诬陷伤害别人，中伤说坏话攻击陷害别人。","source":{"text":"利刀割肉疮犹合，恶语伤人恨不销。","book":"宋·释普济《五灯会元》"},"example":{"text":"他只会一味地～别人。"},"similar":["血口喷人","恶语中伤"],"opposite":["歌功颂德"],"usage":"作谓语、定语；指伤害别人"},{"id":19316,"word":"恶有恶报","pinyin":"è yǒu è bào","abbr":"eyeb","explanation":"做坏事的人会得到不好的报应。指因办坏事而自食其果。","source":{"text":"行十恶者，受于恶报；行十善者，受于善报。","book":"南朝·梁·萧衍《新酒肉文》"},"example":{"text":"常言道：善有善报，～，不是不报，时辰未到。"},"opposite":["善有善报"],"usage":"作宾语、定语；用于劝诫"},{"id":19317,"word":"恶梦初醒","pinyin":"è mèng chū xǐng","abbr":"emcx","explanation":"像从可怕的梦境中解脱出来一样。形容灾难过后，心存余悸。","source":{"text":"好像恶梦初醒时那样觉得生命是何等的可贵。","book":"老舍《骆驼祥子》三"}},{"id":19318,"word":"恶欲其死而受欲其生","pinyin":"wù yù qí sǐ ér ài yù qí shēng","abbr":"eyqsesyqs","explanation":"讨厌他时，总想叫他死掉；喜爱他时，总想叫他活着。指极度地凭个人爱憎对待人。","source":{"text":"爱之欲其生，恶之欲其死，既欲其生，又欲其死，是惑也。","book":"《论语·颜渊》"}},{"id":19319,"word":"恶湿居下","pinyin":"wù shī jū xià","abbr":"wsjx","explanation":"厌恶潮湿却住在低洼的的地方。比喻行动跟愿望相违背。","source":{"text":"今恶辱而居不仁，是犹恶湿而居下住。","book":"《孟子·公孙丑上》"},"example":{"text":"我有～的感觉。"},"similar":["事与愿违"],"usage":"作定语；指无可奈何"},{"id":19320,"word":"恶盈衅满","pinyin":"è yíng xìn mǎn","abbr":"eyxm","explanation":"衅：罪过。形容罪恶累累。","source":{"text":"况今罪逆无亲，恶盈衅满。","book":"《宋书·刘义恭传》"}},{"id":19321,"word":"恶直丑正","pinyin":"è zhí chǒu zhèng","abbr":"ezcz","explanation":"使奸邪者改恶从善。亦指嫉害正直的人。","source":{"text":"恶直丑正，实蕃有徒。","book":"春秋·鲁·左丘明《左传·昭公二十八年》"},"example":{"text":"迁徐州刺史，百司震肃，饕餮风靡，～。","book":"汉·蔡邕《太尉汝南李公碑》"},"usage":"作谓语、定语；用于书面语"},{"id":19322,"word":"恶积祸盈","pinyin":"è jī huò yíng","abbr":"ejhy","explanation":"罪恶成堆，祸害满贯。形容罪大恶极。","source":{"text":"北虏僭盗中原，多历年所，恶积祸盈，理至燋烂。","book":"南朝·梁·丘迟《与陈伯之书》"},"example":{"text":"逆氏僭据关陇，号同王者，～，自相疑戮，衅起萧墙，势分四国。","book":"《晋书·慕容暐载记》"},"similar":["罪大恶极"],"usage":"作谓语、定语；指罪大恶极"},{"id":19323,"word":"恶稔祸盈","pinyin":"è rěn huò yíng","abbr":"erhy","explanation":"稔：成熟；盈：满，指到了极点。罪恶积蓄成熟，像钱串已满。形容作恶多端，末日来临。","source":{"text":"伪齐违信背约，恶稔祸盈。","book":"《周书·武帝纪》"},"similar":["恶稔贯盈","恶稔罪盈"],"usage":"作谓语、定语；形容人很坏"},{"id":19324,"word":"恶稔罪盈","pinyin":"è rěn zuì yíng","abbr":"erzy","explanation":"稔：成熟；盈：满，指到了极点。罪恶积蓄成熟，像钱串已满。形容作恶多端，末日来临。","source":{"text":"主辱臣死，当臣致命之时；恶稔罪盈，是贼灭亡之日。","book":"宋·王谠《唐语林·补遗》"},"similar":["恶稔贯盈","恶稔祸盈"],"usage":"作谓语、定语；形容人很坏"},{"id":19325,"word":"恶稔贯盈","pinyin":"è rěn guàn yíng","abbr":"ergy","explanation":"稔：成熟；贯：钱串；盈：满。罪行积聚成熟。就像钱串已满。形容罪恶累累。无以复加。","source":{"text":"而恶稔贯盈，元凶殒毙，弟洋继逆，续长乱阶。","book":"《梁书·侯景传》"},"similar":["恶稔祸盈","恶稔罪盈"],"usage":"作谓语、定语；形容人很坏"},{"id":19326,"word":"恶籍盈指","pinyin":"è jí yíng zhǐ","abbr":"ejyz","explanation":"犹恶贯满盈。","source":{"text":"恶籍盈指，犹言恶事纪载已满，不胜指也。","book":"清·蒲松龄《聊斋志异·龙飞相公》：“此非所能效力，惟善可以已之。然君恶籍盈指，非大善不可复挽。”何垠注"},"similar":["恶贯满盈"],"usage":"作谓语、定语；形容人很坏"},{"id":19327,"word":"恶紫夺朱","pinyin":"wù zǐ duó zhū","abbr":"wzdz","explanation":"紫：古人认为紫是杂色；夺：乱；朱：大红色，古人认为红是正色。原指厌恶以邪代正。后以喻以邪胜正，以异端充正理。","source":{"text":"恶紫之夺朱也；恶郑声之乱雅乐也；恶利口之覆邦家者。","book":"《论语·阳货》"},"example":{"text":"据此贼情理难容，伤时务，坏人伦，罪不容诛，一心待偎红倚翠，论黄数黑，～。","book":"元·贾仲名《对玉梳》第三折"},"usage":"作谓语、定语；比喻以邪胜正，以异端充正理"},{"id":19328,"word":"恶虎不食子","pinyin":"è hǔ bù shí zǐ","abbr":"ehbsz","explanation":"即使凶恶的老虎也不吃自己生下的小老虎。比喻不伤害亲近者。","source":{"text":"山僧失口曰：‘恶习虎不食子。’","book":"宋·释普济《五灯会元·杭州龙华寺灵照真觉禅师》"},"example":{"text":"～，她连动物都不如。"},"similar":["虎毒不食子"],"usage":"作宾语、定语、分句；比喻不伤害亲近的人"},{"id":19329,"word":"恶衣恶食","pinyin":"è yī è shí","abbr":"eyes","explanation":"恶：粗劣的。指粗劣的衣服和食物。","source":{"text":"士之于道而耻恶衣恶食者，未足与议也。","book":"《论语·里仁》"},"example":{"text":"君子忧道不忧贫，士志于道，而耻～者，未足与议。","book":"章炳麟《论读经有利而无弊》"},"similar":["恶衣菲食","恶衣粗食"],"opposite":["锦衣玉食"],"usage":"作宾语、补语；指粗劣的衣服和食物"},{"id":19330,"word":"恶衣粗食","pinyin":"è yī cū shí","abbr":"eycs","explanation":"恶：坏；衣：衣服；食：事物。粗劣的衣食。形容生活清苦。","source":{"text":"崇为尚书令，仪同三司，亦富倾天下，僮仆千人，而性多俭吝，恶衣粗食，食常无肉。","book":"北魏·杨衒之《洛阳伽蓝记·高阳王寺》"},"similar":["恶衣薄食","恶衣粝食"],"opposite":["锦衣玉食"],"usage":"作谓语、定语、宾语；形容生活清苦"},{"id":19331,"word":"恶衣粝食","pinyin":"è yī lì shí","abbr":"eyls","explanation":"粝：糙米。穿粗劣的衣服，吃糙米做的饭。形容生活俭朴。","source":{"text":"以为有国者皆当恶衣粝食，与农夫并耕而治一人之身，而自为百工。","book":"宋·苏轼《礼义信足以成德论》"},"example":{"text":"懋～，率之以俭。","book":"《元史·张懋传》"},"similar":["恶衣粗食","恶衣恶食","恶衣菲食"],"opposite":["锦衣玉食"],"usage":"作宾语、补语；指粗劣的衣服和食物"},{"id":19332,"word":"恶衣菲食","pinyin":"è yī fēi shí","abbr":"eyfs","explanation":"粗劣的衣食。形容生活俭朴。","source":{"text":"高祖拨乱反正，深鉴奢逸，恶衣菲食，务先节俭。","book":"《梁书·太祖张皇后等传序》"},"example":{"text":"～，以终其身。","book":"宋·苏轼《司马温公行状》"},"similar":["恶衣薄食"],"usage":"作谓语、定语、宾语；形容生活清苦"},{"id":19333,"word":"恶衣蔬食","pinyin":"è yī shū shí","abbr":"eyss","explanation":"粗劣的衣食。形容生活俭朴。同“恶衣菲食”。","source":{"text":"元方仁慈，恶衣蔬食。","book":"晋·葛洪《神仙传·孔元方》"},"example":{"text":"夫人自誓不许，～，躬执勤苦，使里之四方就学。","book":"宋·司马光《赠都官郎中司马君行状》"},"similar":["恶衣菲食","恶衣薄食","恶衣恶食"],"usage":"作谓语、定语、宾语；形容生活清苦"},{"id":19334,"word":"恶衣薄食","pinyin":"è yī bó shí","abbr":"eybs","explanation":"衣：衣服；薄：淡薄；食：事物。形容生活清苦。","source":{"text":"恶衣薄食，少思寡欲。","book":"《文中子·事君》"},"similar":["粗衣粝食","恶衣粗食"],"opposite":["锦衣玉食"],"usage":"作谓语、定语、宾语；形容生活清苦"},{"id":19335,"word":"恶言不入于耳","pinyin":"è yán bù rù yú ěr","abbr":"eybrye","explanation":"不听坏话。形容对于坏话、诽谤的话根本不予理睬。","source":{"text":"孔子曰：‘自吾得由而恶言不入于耳。’","book":"《孔家子语》"}},{"id":19336,"word":"恶言厉色","pinyin":"è yán lì sè","abbr":"eyls","explanation":"说话和脸色都很严厉。","source":{"text":"洪珊老师虽然照样是恶言厉色的把书茵斥骂一顿，但态度已经和缓下来了。","book":"高云览《小城春秋》第三八章"},"opposite":["和颜悦色"],"usage":"作谓语、定语、状语；用于说话表情"},{"id":19337,"word":"恶言恶语","pinyin":"è yán è yǔ","abbr":"eyey","explanation":"指用狠毒的话骂人或说话。","source":{"text":"半个月不能起床，不惟没有了那些凶性，且是连恶言恶语都尽数变得没了。","book":"清·西周生《醒世姻缘传》第100回"},"example":{"text":"你对同学说话不能用～。"},"similar":["恶言泼语"],"opposite":["好言好语"],"usage":"作谓语、宾语、状语、定语；用于说话"},{"id":19338,"word":"恶言泼语","pinyin":"è yán pō yǔ","abbr":"eypy","explanation":"泼：蛮横。用恶毒和蛮横的语言说话。","source":{"text":"那九个凶神，恶言泼语，在门前骂战哩。","book":"明·吴承恩《西游记》第五回"},"example":{"text":"这伊秀才又是个极柔懦的好人，在那佃房居住的人家，不肯恶言泼语，伤犯那些众人。","book":"清·西周生《醒世姻缘传》第七十三回"},"similar":["恶言恶语"],"opposite":["好言好语"],"usage":"作谓语、宾语、状语、定语；用于说话"},{"id":19339,"word":"恶言詈辞","pinyin":"è yán lì cí","abbr":"eylc","explanation":"指中伤辱骂的言辞。","source":{"text":"愈独判二年，晶与宦者为敌，相伺候罪过，恶言詈辞，狼藉公牒。","book":"宋·王观国《学林·冰》"},"similar":["恶言恶语"],"usage":"作谓语、定语、状语、宾语；用于说话"},{"id":19340,"word":"恶语中伤","pinyin":"è yǔ zhòng shāng","abbr":"eyzs","explanation":"中伤：攻击和谄害别人。用恶毒的话污蔑、陷害人。","source":{"text":"利刀割肉疮犹合；恶语伤人恨不销。","book":"宋·释普济《五灯会元·洪州法昌倚遇禅师》"},"example":{"text":"他经常～别人。"},"similar":["恶意中伤","恶语伤人"],"usage":"作主语、谓语、宾语；指语言污蔑"},{"id":19341,"word":"恶语伤人","pinyin":"è yǔ shāng rén","abbr":"eysr","explanation":"用恶毒的语言污蔑、伤害人。","source":{"text":"利刀割肉疮犹合；恶语伤人恨不销。","book":"宋·释普济《五灯会元·洪州法昌倚遇禅师》"},"example":{"text":"别人行甜言美语三冬暖，我跟前，～六月寒。","book":"元·王实甫《西厢记》第三本第二折"},"similar":["造谣中伤","恶口伤人"],"opposite":["善言规劝"],"usage":"作主语、定语；指语言伤人"},{"id":19342,"word":"恶语相加","pinyin":"è yǔ xiāng jiā","abbr":"eyxj","explanation":"把恶毒的语言加到别人身上。","source":{"text":"日常士兵偶有不是，动辄恶语相加，痛施体罚。","book":"冯玉祥《我的生活》第十六章"},"similar":["恶语中伤"],"usage":"作谓语、定语；用于人际关系"},{"id":19343,"word":"恶贯久盈","pinyin":"è guàn jiǔ yíng","abbr":"egjy","explanation":"贯：钱串；盈：充满。罪恶像钱串一样堆满。形容罪大恶极，已到了该受惩罚的末日。","source":{"text":"伏以刘士宁昏荒暴慢，恶贯久盈，事迹彰著。","book":"唐·陆贽《议汴州逐刘士宁事状》"},"similar":["恶贯满盈"],"usage":"作谓语、定语；形容人很坏"},{"id":19344,"word":"恶贯已盈","pinyin":"è guàn yǐ yíng","abbr":"egyy","explanation":"形容罪大恶极，到受惩罚的时候了。同“恶贯满盈”。","source":{"text":"小蕃背诞，恶贯已盈。","book":"《金石萃编·唐玄宗〈批答裴耀卿等奏〉》"},"example":{"text":"某家惯作歹事，～。","book":"《二刻拍案惊奇》卷二十"},"similar":["恶贯满盈"],"usage":"作谓语、定语；形容人很坏"},{"id":19345,"word":"恶贯满盈","pinyin":"è guàn mǎn yíng","abbr":"egmy","explanation":"贯：穿钱的绳子；盈：满。罪恶之多，犹如穿线一般已穿满一根绳子。形容罪大恶极，到受惩罚的时候了。","source":{"text":"商罪贯盈，天命诛之。","book":"《尚书·泰誓》"},"example":{"text":"你今日～，有何理说。","book":"元·无名氏《硃砂担》第四折"},"similar":["罪大恶极","罪恶滔天"],"opposite":["功德无量"],"usage":"作谓语、定语；形容人很坏","story":["商朝末年，纣王昏庸无道，一日抓了主张仁政的诸侯姬昌，姬昌的儿子姬发率大军讨伐商纣王，他引举了商纣王恶贯满盈的滔天罪行，深得老百姓的支持，在牧野之战，消灭了商朝的大部分兵力，商纣王自焚而死"]},{"id":19346,"word":"恶贯祸盈","pinyin":"è guàn huò yíng","abbr":"eghy","explanation":"贯：钱串；祸：为害。指罪恶累累像钱串已满，末日来临。","source":{"text":"独有默啜，假息孤恩，恶贯祸盈，覆亡不暇。","book":"唐·崔融《谏税关市疏》"},"similar":["恶贯满盈","恶贯久盈"],"usage":"作谓语、定语；形容人很坏"},{"id":19347,"word":"恶迹昭着","pinyin":"è jì zhāo zhe","abbr":"ejzz","explanation":"昭著：显着，明显。恶劣的事迹十分明显，人所共见。形容罪行严重。"},{"id":19348,"word":"恶迹昭著","pinyin":"è jì zhāo zhù","abbr":"ejzz","explanation":"昭著：显著，明显。恶劣的事迹十分明显，人所共见。形容罪行严重。","source":{"text":"但先列罪人之词，而继之以今来勘状，则恶迹昭著。","book":"宋·郑刚中《北山文集·答潼川路于提刑》"},"usage":"作谓语、定语；用于坏人"},{"id":19349,"word":"恶醉强酒","pinyin":"wù zuì qiǎng jiǔ","abbr":"wzqj","explanation":"强：硬要。怕醉却又猛喝酒。比喻明知故犯。","source":{"text":"今恶死亡而乐不仁，是犹恶醉而强酒。","book":"《孟子·离娄上》"},"similar":["明知故犯"],"usage":"作谓语、定语；用于处世"},{"id":19350,"word":"恶龙不斗地头蛇","pinyin":"è lóng bù dòu dì tóu shé","abbr":"elbddts","explanation":"地头蛇：比喻称霸一方的人。比喻外来者尽管很厉害，也斗不过本地的恶势力。","source":{"text":"大官人休说满话！常言道：恶龙不斗地头蛇。","book":"明·冯梦龙《醒世恒言》第七卷"},"similar":["强龙不压地头蛇","恶龙不斗当方蛇"],"usage":"作宾语、定语；用于口语"},{"id":19351,"word":"恸哭流涕","pinyin":"tòng kū liú tì","abbr":"tklt","explanation":"恸：哀痛；涕：眼泪。形容极其悲痛伤心。","source":{"text":"今子之死，乃独有感于余心而兴不幸之叹，至于恸哭流涕不能自已。","book":"宋·陈亮《祭朱寿之文》"},"example":{"text":"读之自然～，又不待以痛哭流涕自言也。","book":"明·李贽《焚书·李中丞奏议序》"},"similar":["痛哭流涕"],"opposite":["兴高采烈"],"usage":"作谓语；指十分悲痛"},{"id":19352,"word":"恺悌君子","pinyin":"kǎi tì jūn zǐ","abbr":"ktjz","explanation":"恺悌：平易近人；君子：先秦时代对诸侯卿士的美称。泛指品德优良，平易近人的人。","source":{"text":"恺悌君子，神所劳矣。","book":"春秋·鲁·左丘明《左传·僖公十二年》"},"example":{"text":"紫英黄萼，照灼丹犀，～，佩服攸宜。","book":"唐·萧颖士《菊荣五章》"},"similar":["岂弟君子"],"usage":"作宾语；指厚道的人"},{"id":19353,"word":"恻怛之心","pinyin":"cè dá zhī xīn","abbr":"cdzx","explanation":"形容对人寄予同情。同“恻隐之心”。","source":{"text":"观刑曰乐，何无恻怛之心焉？！","book":"晋·苻郎《苻子》"},"similar":["恻隐之心"],"usage":"作宾语；指有同情心"},{"id":19354,"word":"恻隐之心","pinyin":"cè yǐn zhī xīn","abbr":"cyzx","explanation":"恻隐：对别人的不幸表示同情。形容对人寄予同情。","source":{"text":"恻隐之心，人皆有之。","book":"《孟子·告子上》"},"example":{"text":"此人为官清正，作事廉明，每怀～，常有仁慈之念。","book":"明·施耐庵《水浒全传》第十三回"},"similar":["悲天悯人"],"opposite":["铁石心肠","落井下石"],"usage":"作宾语；指有同情心"},{"id":19355,"word":"恼羞变怒","pinyin":"nǎo xiū biàn nù","abbr":"nxbn","explanation":"由于羞愧到了极点，下不了台而发怒。同“恼羞成怒”。","source":{"text":"陶柳看完，忍不住哈哈大笑。羞得个宋信通身汗下，彻耳通红，不觉恼羞变怒。","book":"《平山冷燕》第六回"},"example":{"text":"冒得官见他如此的说法，不禁～，喝令左右：‘替我赶他出去！’","book":"清·李宝嘉《官场现形记》第三十回"},"similar":["恼羞成怒"],"usage":"作谓语、定语、状语；指发怒"},{"id":19356,"word":"恼羞成怒","pinyin":"nǎo xiū chéng nù","abbr":"nxcn","explanation":"由于羞愧到了极点，下不了台而发怒。","source":{"text":"那抚台见是如此，知道王协台有心瞧他不起，一时恼羞成怒。","book":"清·李宝嘉《官场现形记》第六回"},"example":{"text":"那排长～，拿着枪头的刺刀，向哥哥的手臂上扎了一下。","book":"冰心《去国·斯人独憔悴》"},"similar":["义愤填膺","恼羞变怒"],"opposite":["心平气和"],"usage":"作谓语、定语、状语；指发怒"},{"id":19357,"word":"悃愊无华","pinyin":"kǔn bì wú huá","abbr":"kbwh","explanation":"悃愊：至诚；华：浮夸。至诚而不虚浮。形容真心实意，毫不虚假。","source":{"text":"安静之吏，悃愊无华。","book":"南朝·宋·范晔《后汉书·章帝纪》"},"example":{"text":"～，肝胆相照。","book":"宋·胡大初《昼帘绪论·僚寀》"},"similar":["悃质无华"],"usage":"作谓语、定语；指人的态度"},{"id":19358,"word":"悃质无华","pinyin":"kǔn zhì wú huá","abbr":"kzwh","explanation":"华：浮夸。至诚而不虚浮。形容真心诚意，毫不虚假。","source":{"text":"独取太史公所自为赞论序略者读之，其句字可谓悃质无华矣。","book":"明·艾南英《答夏彝仲文书》"},"similar":["悃愊无华"],"usage":"作谓语、定语、宾语；指人的态度"},{"id":19359,"word":"悄悄冥冥","pinyin":"qiāo qiāo míng míng","abbr":"qqmm","explanation":"比喻静悄悄，一声不响。","source":{"text":"侧着耳朵儿听，蹑着 脚步儿行：悄悄冥冥，潜潜等等。","book":"元·王实甫《西厢记》第一本第三折"},"example":{"text":"～，墙阴窃听。","book":"清·洪昇《长生殿·偷曲》"}},{"id":19360,"word":"悄悄话","pinyin":"qiāo qiāo huà","abbr":"qqh","explanation":"有关人员私下里低语或指耳语，私房话。","example":{"text":"上课时不能讲～。"},"usage":"作主语、宾语、定语；用于口语"},{"id":19361,"word":"悄无人声","pinyin":"qiǎo wú rén shēng","abbr":"qwrs","explanation":"悄：静。静悄悄的，听不到人的声音。指非常寂静。","source":{"text":"宝玉信步走入，只见湘帘垂地，悄无人声。","book":"清·曹雪芹《红楼梦》第26回"},"example":{"text":"在这～的地方，的确感到几分恐怖。"},"similar":["悄无声息"],"usage":"作谓语、定语；指非常寂静"},{"id":19362,"word":"悄无声息","pinyin":"qiǎo wú shēng xī","abbr":"qwsx","explanation":"悄：静。静悄悄的，听不到任何声音。指非常寂静。","source":{"text":"雪，悄无声息地飘落着。","book":"茹志鹃《三走严庄》"},"example":{"text":"～的夜晚是多么宁静。"},"similar":["悄无人声"],"usage":"作谓语、定语、状语；指非常寂静"},{"id":19363,"word":"悄然无声","pinyin":"qiǎo rán wú shēng","abbr":"qrws","explanation":"悄然：寂静无声的样子。静悄悄的，听不到一点声音。","source":{"text":"东舟西舫悄无言，惟见江心秋月白。","book":"唐·白居易《琵琶行》诗"},"example":{"text":"二三十只皮鞋的交响曲，登时冲破巷里～的黑暗。","book":"艾芜《咆哮的许家屯》"}},{"id":19364,"word":"悉听尊便","pinyin":"xī tīng zūn biàn","abbr":"xtzb","explanation":"一切由您的意思。","example":{"text":"你去不去桂林～。"},"usage":"作谓语；指完全同意"},{"id":19365,"word":"悉帅敝赋","pinyin":"xī shuài bì fù","abbr":"xsbf","explanation":"指倾全国的军事力量。古代按田赋出兵车、甲士，故称兵为“赋”。敝，谦词，指不精良。","source":{"text":"我先君襄公不敢宁处，使叔孙豹悉帅敝赋，踦跂毕行。","book":"《国语·鲁语下》"},"similar":["悉索薄赋","悉索敝赋"],"usage":"作谓语；指尽其所有来供给"},{"id":19366,"word":"悉心戮力","pinyin":"xī xīn lù lì","abbr":"xxll","explanation":"悉心：尽心；戮力：用尽全力。竭尽智慧和力量。","source":{"text":"其内外众官，各悉心戮力，以康庶事。","book":"《晋书·孝武帝纪》"},"example":{"text":"然向之～，难易亡所避，报天子异知尔。","book":"《新唐书·王叔文传》"},"similar":["悉心竭力","悉心毕力"],"usage":"作定语、状语；用于处事"},{"id":19367,"word":"悉心整饬","pinyin":"xī xīn zhěng chì","abbr":"xxzc","explanation":"饬：整理。用全部精力对某事或某一机构进行整顿。","example":{"text":"着陈代军长等～该军，团结内部，协和军民，实行三民主义。","book":"毛泽东《为皖南事变发表的命令和谈话》"}},{"id":19368,"word":"悉心毕力","pinyin":"xī xīn bì lì","abbr":"xxbl","explanation":"悉心：尽心；毕力：尽力。竭尽智慧和力量。","source":{"text":"乃及伊公，克光前矩，悉心毕力，胤其祖武。","book":"汉·蔡邕《杨太尉碑铭》"},"similar":["悉心戮力","悉心竭力"],"usage":"作定语、状语；用于处事"},{"id":19369,"word":"悉心竭力","pinyin":"xī xīn jié lì","abbr":"xxjl","explanation":"悉心：尽心；竭力：用尽全力。竭尽智慧和力量。","source":{"text":"乃及伊公，克光前矩，悉心毕力，胤其祖武。","book":"汉·蔡邕《杨太尉碑铭》"},"example":{"text":"及镇并门，尤深待遇，出入帷幄，受腹心之寄，帝亦～，知无不为。","book":"《旧五代史·太祖纪一》"},"similar":["悉心戮力","悉心毕力"],"usage":"作定语、状语；用于处事"},{"id":19370,"word":"悉心竭虑","pinyin":"xī xīn jié lǜ","abbr":"xxjl","explanation":"悉心：尽心；竭：尽。用尽全力。竭尽智慧和力量。","source":{"text":"原来那时正值天旱，太宗皇帝谣五品以上官员，都要悉心竭虑，直言得失，以凭采用。","book":"明·冯梦龙《喻世明言》卷五"},"usage":"作定语、状语；用于处事"},{"id":19371,"word":"悉索敝赋","pinyin":"xī suǒ bì fù","abbr":"xsbf","explanation":"悉：全部；索：尽；敝：谦辞，谓不精良。指尽全国所有的兵力。也指拿出所有的一切来供应。","source":{"text":"蔡人不从，敝邑之人不敢宁处，悉索敝赋，以讨于蔡，获司马燮，献于邢丘。","book":"《左传·襄公八年》"},"example":{"text":"今幸少闲，～，愿从诸君之后，左右卫君，以诛卫之不当立者！","book":"明·冯梦龙《东周列国志》第十四回"},"similar":["悉索薄赋","悉帅敝赋"],"usage":"作谓语；指尽其所有来供给"},{"id":19372,"word":"悉索薄赋","pinyin":"xī suǒ bó fù","abbr":"xsbf","explanation":"指倾全国的军事力量。古代按田赋出兵车、甲士，故称兵为“赋”。薄，谦词，指不精良。","source":{"text":"武王继文王之业，用太公之谋，悉索薄赋，躬擐甲胄，以伐无道而讨不义。","book":"《淮南子·要略》"},"similar":["悉帅敝赋","悉索敝赋"],"usage":"作谓语；指尽其所有来供给"},{"id":19373,"word":"悍然不顾","pinyin":"hàn rán bù gù","abbr":"hrbg","explanation":"捍然：凶残蛮横的样子。凶暴蛮横，不顾一切。","source":{"text":"但一人之冤不伸，反又杀人身、破人家，悍然不顾。","book":"明·东鲁古狂生《醉醒石》第十一回"},"example":{"text":"张佩纶～，照自己的决定行事。","book":"高阳《清宫外史》下册"},"similar":["专横跋扈"],"opposite":["顾虑重重"],"usage":"作谓语、状语；指不顾一切"},{"id":19374,"word":"悒悒不乐","pinyin":"yì yì bù lè","abbr":"yybl","explanation":"悒悒：忧愁不安的样子。心里郁闷，感到不快。","source":{"text":"庸主对坐，悒悒不乐。","book":"汉·班固《汉武帝内传》"},"example":{"text":"郎君年渐长，合求官职。～，何以遣时。","book":"唐·薛调《无双传》"},"similar":["悒悒不欢"],"opposite":["欢天喜地"],"usage":"作谓语、定语；指不愉快"},{"id":19375,"word":"悒悒不欢","pinyin":"yì yì bù huān","abbr":"yybh","explanation":"悒悒：忧愁不安的样子。心里郁闷，感到不快。","source":{"text":"庸主对坐，悒悒不乐。","book":"汉·班固《汉武帝内传》"},"example":{"text":"生恚怒，～。","book":"清·蒲松龄《聊斋志异·婴宁》"},"similar":["悒悒不乐"],"opposite":["欢天喜地","喜气洋洋"],"usage":"作谓语、定语；指不愉快"},{"id":19376,"word":"悔不当初","pinyin":"huǐ bù dāng chū","abbr":"hbdc","explanation":"悔：后悔；当初：开头，起初。后悔不在当初采取另一种行动。","source":{"text":"早知文字多辛苦，悔不当初学冶银。","book":"唐·薛昭纬《谢银工》诗"},"example":{"text":"这一声叹息，大有～的意味。","book":"高阳《清宫外史》下册"},"similar":["悔之不及"],"usage":"作谓语、定语；与“早知今日”连用"},{"id":19377,"word":"悔之不及","pinyin":"huǐ zhī bù jí","abbr":"hzbj","explanation":"后悔也来不及了。","source":{"text":"反水不收，后悔无及。","book":"《后汉书·光武帝纪》"},"example":{"text":"设或耽搁下来，被人家弄了去，岂不是～。","book":"清·李宝嘉《官场现形记》第三十五回"},"similar":["悔不当初","悔之晚矣","悔之无及"],"usage":"作谓语、定语、宾语；指后悔也来不及了"},{"id":19378,"word":"悔之何及","pinyin":"huǐ zhī hé jí","abbr":"hzhj","explanation":"悔：后悔。后悔也来不及了。","source":{"text":"吾有三失，晚而自觉，悔之何及！","book":"《孔子家语·致思》"},"example":{"text":"明·施耐庵《水浒传》第76回：“无端草寇，背逆狂徒，天兵到此，尚不投降，直待骨肉为泥，～！”"},"similar":["悔之不及"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":19379,"word":"悔之无及","pinyin":"huǐ zhī wú jí","abbr":"hzwj","explanation":"后悔也来不及了。","source":{"text":"既成谋矣，何及其未作也，先诸？作而后悔，亦无及也。","book":"《左传·哀公六年》"},"example":{"text":"倘一有拒捕之名，弄假成真，百口难诉，～矣。","book":"《古今小说》第三十九卷"},"similar":["悔恨交加","悔之晚矣","悔不当初"],"opposite":["顽固不化","死不悔改"],"usage":"作谓语、定语、宾语；指后悔也来不及了","story":["春秋时期，吴王夫差准备攻打齐国，越王勾践带人为夫差助威，伍子胥对夫差说越国才是心腹之患，应该除掉，等越国强大了，想消灭就后悔莫及了。夫差不听劝告，反而疏远伍子胥并命他自杀。11年后，强大了的越国一举消灭吴国"]},{"id":19380,"word":"悔之晚矣","pinyin":"huǐ zhī wǎn yǐ","abbr":"hzwy","explanation":"后悔已经晚了。","source":{"text":"万一有奸邪叵测之情，陛下悔之晚矣！","book":"《大宋宣和遗事》"},"example":{"text":"小沛原非久居之地。今徐州既有可乘之隙，失此不取，～。","book":"明·罗贯中《三国演义》第十四回"},"similar":["追悔莫及","悔恨交加","悔之无及"],"opposite":["死不悔改","执迷不悟"],"usage":"作谓语、定语、状语；指后悔已经晚了"},{"id":19381,"word":"悔之莫及","pinyin":"huǐ zhī mò jí","abbr":"hzmj","explanation":"悔：后悔。后悔也来不及了。","source":{"text":"及溺呼船，悔之莫及。","book":"东汉·董卓《到渑池上书请收张让等》"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“我听说有些地方弃械就抚的，结果上了大当，～。”"},"similar":["悔之不及"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":19382,"word":"悔其少作","pinyin":"huǐ qí shǎo zuò","abbr":"hqsz","explanation":"指不满其年轻时未成熟的作品。","source":{"text":"修家子云，老不晓事，强著一书，悔其少作。","book":"汉·杨修《答临淄侯笺》"},"example":{"text":"听说：中国的好作家是大抵‘～’的，他在自定集子的时候，就将少年时代的作品尽力删除，或者简直全部烧掉。","book":"鲁迅《〈集外集〉序言》"},"usage":"作谓语；用于书面语"},{"id":19383,"word":"悔恨交加","pinyin":"huǐ hèn jiāo jiā","abbr":"hhjj","explanation":"恨：遗憾；交加：一起出现。形容非常懊悔。","example":{"text":"他对此事～，无地自容。"},"similar":["悔不当初","悔之晚矣"],"opposite":["问心无愧"],"usage":"作谓语、定语、状语；形容非常懊悔"},{"id":19384,"word":"悔罪自新","pinyin":"huǐ zuì zì xīn","abbr":"hzzx","explanation":"悔改罪行，重新做人。","source":{"text":"陈穆公亦有使命至晋，代卫郑致悔罪自新之意。","book":"《东周列国志》第四十二回"},"example":{"text":"帝曰：‘威之以刑，不若怀之以德，宜还之。’乃令刑部员外郎吕渊等赍敕责让，令～。","book":"《明史·外国传三·日本》"},"similar":["悔过自新"],"opposite":["死不悔改"],"usage":"作谓语、定语；指重新做人"},{"id":19385,"word":"悔读南华","pinyin":"huǐ dú nán huá","abbr":"hdnh","explanation":"《南华经》即《庄子》。比喻学识渊博而不为人所容。","source":{"text":"因知此恨人多积，悔读南华第二篇。","book":"宋·计有功《唐诗纪事·温庭筠》"},"example":{"text":"从宦只思乘下泽，忤人常～。","book":"宋·陆游《怀镜中故庐》诗"},"similar":["怀才不遇"],"usage":"作谓语；比喻学识渊博而不为人所容"},{"id":19386,"word":"悔过自忏","pinyin":"huǐ guò zì chàn","abbr":"hgzc","explanation":"悔：追悔；忏：忏悔。追悔过错，谴责自己。","source":{"text":"僧教宽悔过自忏，后岁余，方如旧。","book":"宋·张邦基《墨庄漫录·襄阳天仙寺》"},"similar":["悔过自责"],"usage":"作谓语、定语；指反省"},{"id":19387,"word":"悔过自新","pinyin":"huǐ guò zì xīn","abbr":"hgzx","explanation":"悔：悔改；过：错误；自新：使自己重新做人。悔恨以前的过失，决心重新作人。","source":{"text":"元常喻以恩信，约悔过自新，贼相率脱甲而缚。","book":"《史记·吴王濞列传》：“于古法当诛，文帝弗忍，因赐几杖。德至厚，当改过自新。《新唐书·冯元常传》"},"example":{"text":"只要你真能～，本部堂可以饶你的活命。","book":"郭沫若《南冠草》第一幕"},"similar":["改过自新","迷途知返","痛改前非"],"opposite":["怙恶不悛","至死不悟","死不改悔"],"usage":"作谓语、定语；指重新做人","story":["西汉名医淳于意一次犯法，官府把他押往长安，等待行剕刑和劓刑。他的女儿缇萦不忍父亲受极刑，给汉文帝上书，说：“一个犯罪的人也想改过自新……”汉文帝深受感动，就赦免了他的父亲，同时废除了宫剕、劓、耶、大辟等酷刑"]},{"id":19388,"word":"悔过自责","pinyin":"huǐ guò zì zè","abbr":"hgzz","explanation":"追悔过错，谴责自己。","source":{"text":"后得反国，不悔过自责，复会诸侯伐郑。","book":"东汉·班固《汉书·五行志》"},"example":{"text":"既然他～，我们就不要追究了。"},"similar":["后悔莫及","悔过自新","迷途知返"],"opposite":["死不改悔","至死不悟"],"usage":"作谓语；指反省"},{"id":19389,"word":"悖入悖出","pinyin":"bèi rù bèi chū","abbr":"brbc","explanation":"悖：违背、胡乱。用不正当的手段得来的财物，也会被别人用不正当的手段拿去。胡乱弄来的钱又胡乱花掉。","source":{"text":"是故言悖而出者亦悖而入；货悖而入者亦悖而出。","book":"《礼记·大学》"},"example":{"text":"诉者多矣。神以为～，自作之愆；杀人人杀，相酬之道，置不为理也。","book":"清·纪昀《阅微草堂笔记·槐西杂志四》"},"similar":["因果报应"],"usage":"作谓语、宾语、定语；指人不能拥有不义之财"},{"id":19390,"word":"悖言乱辞","pinyin":"bèi yán luàn cí","abbr":"bylc","explanation":"指胡言乱语。","source":{"text":"以黄马为非马，而以白马为有马，此飞者入池，而棺椁异处，此天下之悖言乱辞也。","book":"《公孙龙子·白马论》"},"similar":["胡言乱语"],"usage":"作主语、宾语、定语；指胡言乱语"},{"id":19391,"word":"悖逆不轨","pinyin":"bèi nì bù guǐ","abbr":"bnbg","explanation":"悖逆：违反正道，犯法作乱；不轨：不合法规。指违背正道，不守法规。","source":{"text":"甚悖逆不轨，宜诛讨之日久矣。","book":"汉·桓宽《盐铁论·本史》"}},{"id":19392,"word":"悠哉游哉","pinyin":"yōu zāi yóu zāi","abbr":"yzyz","explanation":"指悠闲自在。","source":{"text":"两只空洞洞的棉袄袖子在肩上晃来晃去，给人一种悠哉游哉的感觉。","book":"谌容《赞歌》"},"example":{"text":"我们过着～的日子。"},"similar":["悠闲自在"],"usage":"作谓语、定语；指人很轻闲"},{"id":19393,"word":"悠悠伏枕","pinyin":"yōu yōu fú zhěn","abbr":"yyfz","explanation":"悠悠：长久，遥远；伏枕：伏卧在枕头上。长时间在枕头上辗转，不能入睡。","source":{"text":"寂寂系舟双下泪，悠悠伏枕左书空。","book":"唐·杜甫《清明二首》其二"}},{"id":19394,"word":"悠悠忽忽","pinyin":"yōu yōu hū hū","abbr":"yyhh","explanation":"形容悠闲懒散或神志恍惚的样子。","source":{"text":"悠悠忽忽，怊怅自失。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"刘伶身长六尺，貌其丑悴，而～，土木形骸。（南朝·宋·刘义庆《世说新语·容止》）"},"similar":["迷迷糊糊"],"usage":"作谓语、定语；指人的状态"},{"id":19395,"word":"悠悠扬扬","pinyin":"yōu yōu yáng yáng","abbr":"yyyy","explanation":"形容声音高低起伏、持续和谐或事物慢节奏运动。","source":{"text":"正看间，可煞作怪，忽地轩前起一阵香风，把须儿吹向空中，悠悠扬扬的飘散了。","book":"清·褚人获《隋唐演义》第75回"},"example":{"text":"曾朴《孽海花》第六回：“忽听一阵～的笛声，从风中吹过来。”"},"usage":"作定语、状语；多用于声音等"},{"id":19396,"word":"悠悠自得","pinyin":"yōu yōu zì dé","abbr":"yyzd","explanation":"形容从容不迫，心满意足的样子。","source":{"text":"那老者因得了花中之趣，自少至老，五十余年，略无倦意，筋骨愈觉强健，粗衣淡饭，悠悠自得。","book":"明·冯梦龙《醒世恒言》卷四"}},{"id":19397,"word":"悠悠荡荡","pinyin":"yōu yōu dàng dàng","abbr":"yydd","explanation":"形容摇摇晃晃，飘浮不定。现多形容不勤奋。","source":{"text":"若是悠悠荡荡，未有不入于邪僻。","book":"宋·朱熹《朱子语类》第47卷"},"example":{"text":"我心中有种～的感觉。"},"usage":"作谓语、定语；指动荡"},{"id":19398,"word":"悠游自在","pinyin":"yōu yóu zì zài","abbr":"yyzz","explanation":"形容悠闲而舒适。同“悠游自得”。","source":{"text":"不仅唱歌十分在行，大年初一和同伴各个村子里去打秋千，用马皮作成三丈来长的秋千条，悬挂在路旁高树上，蹬个十来下就可平梁，还悠游自在若无其事！","book":"沈从文《过节和观灯》"},"similar":["悠游自得","悠然自得"],"usage":"作定语、状语；用于处事"},{"id":19399,"word":"悠游自得","pinyin":"yōu yóu zì dé","abbr":"yyzd","explanation":"悠游：闲适的样子；自得：内心得意舒适。形容悠闲而舒适。","source":{"text":"自不参其神契，略不与交通，是以浮华之士咸轻而笑之。猛悠然自得，不以屑怀。","book":"唐·房玄龄等《晋书·苻坚载记·附王猛》"},"example":{"text":"至于那些文士诗翁，自称什么钓徒樵子的，倒大抵是～的封翁或公子，何尝捏过钓竿或斧头柄。","book":"鲁迅《且介亭杂文二集·隐士》"},"similar":["悠游自在"],"usage":"作谓语、定语；形容人的状态"},{"id":19400,"word":"悠然神往","pinyin":"yōu rán shén wǎng","abbr":"yrsw","explanation":"神往：心里向往。形容心神要飞到某个去处。","source":{"text":"读这一段，使我们悠然神往。","book":"钱杏邨《死去了的阿Q时代》"},"example":{"text":"杨过～，不答她的问话。","book":"金庸《神雕侠侣》第三十五回"},"usage":"作谓语；用于书面语"},{"id":19401,"word":"悠然自得","pinyin":"yōu rán zì dé","abbr":"yrzd","explanation":"悠然：闲适的样子；自得：内心得意舒适。形容悠闲而舒适。","source":{"text":"自不参其神契，略不与交通，是以浮华之士咸轻而笑之。猛悠然自得，不以屑怀。","book":"唐·房玄龄等《晋书·苻坚载记·附王猛》"},"example":{"text":"荒凉的甲板上，只有～的水手们。","book":"华而实《汉衣冠》八"},"similar":["泰然自若","悠然自适"],"opposite":["若有所失"],"usage":"作定语、状语、补语；指人的心情"},{"id":19402,"word":"悠然自适","pinyin":"yōu rán zì shì","abbr":"yrzs","explanation":"形容悠闲自在，神情从容的样子。","source":{"text":"悠然自适君知否，身与浮名若个亲？","book":"宋·陆游《醉题》"},"example":{"text":"常乘小艇，吹短箫，吹已，叩舷而歌，～。","book":"《明史·杨恒传》"},"similar":["悠然自得"],"usage":"作定语、状语；指人的心情"},{"id":19403,"word":"悠闲自在","pinyin":"yōu xián zì zài","abbr":"yxzz","explanation":"闲暇舒适，无忧无虑。","source":{"text":"此之谓从容就义也，死是何等事，乃能夫妇同心，又做得如此悠闲自在。","book":"清·张贵胜《遗愁集·忠义》卷四"},"example":{"text":"有许多写“田园生活”的诗和文章把农民生活写得十分～，但那其实出于不是农民的士大夫诗人的想象。","book":"蒲韧《二千年间》五"},"similar":["悠游自在"],"usage":"作谓语、定语、状语；用于处事"},{"id":19404,"word":"患得患失","pinyin":"huàn dé huàn shī","abbr":"hdhs","explanation":"患：忧患，担心。担心得不到，得到了又担心失掉。形容对个人得失看得很重。","source":{"text":"其未得之也，患得之；既得之，患失之。苟患失之，无所不至矣！","book":"《论语·阳货》"},"example":{"text":"既无“～”的念头，心情也自然安泰，决非欲“骗人安心，所以这样说”的：切祈明鉴为幸。","book":"鲁迅《两地书》六○"},"similar":["斤斤计较","自私自利"],"opposite":["公而忘私","大公无私"],"usage":"作谓语、定语、状语；指看重个人得失","story":["春秋时期，孔子经常与学生讨论为人的问题，他说：可鄙的庸俗低级的家伙不能与之同事，当他没得到权势或好处时，他生怕得不到就想方设法得到。而当他得到时，却又怕丢失掉。像这样的人都是利欲熏心，处处为个人打算，什么坏事都能干得出来"]},{"id":19405,"word":"患生所忽","pinyin":"huàn shēng suǒ hū","abbr":"hssh","explanation":"患：祸患，灾祸。灾祸往往是由于疏忽大意造成的。","source":{"text":"患生于所忽，祸起于细微。","book":"汉·刘向《说苑·敬慎篇》"}},{"id":19406,"word":"患至呼天","pinyin":"huàn zhì hū tiān","abbr":"hzht","explanation":"患：祸患；呼：喊。形容事前不作准备，灾祸临头，求天救助。","source":{"text":"患至而后呼天，不亦晚乎！","book":"汉·韩婴《韩诗外传》卷二"},"example":{"text":"如果不早作准备，来年汛期～，就来不及了。"},"similar":["临渴掘井"],"opposite":["有备无患"],"usage":"作谓语、宾语；指事前不作准备"},{"id":19407,"word":"患难与共","pinyin":"huàn nàn yǔ gòng","abbr":"hnyg","explanation":"共同承担危险和困难。指彼此关系密切，利害一致。","source":{"text":"儒有闻善以相告也，见善以礼相示也，爵位相先也，患难相死也。","book":"《礼记·儒行》"},"example":{"text":"高桂英毕竟是他的～的结发妻子和好帮手。","book":"姚雪垠《李自成》第一卷第十三章"},"similar":["休戚与共","同甘共苦","同舟共济"],"opposite":["貌合神离","同床异梦"],"usage":"作谓语、定语；指彼此关系密切"},{"id":19408,"word":"患难之交","pinyin":"huàn nàn zhī jiāo","abbr":"hnzj","explanation":"交：交情，朋友。在一起经历过艰难困苦的朋友。","source":{"text":"浦肫夫患难之交，今日年兄为我们看他，异日我们也代年兄看他。","book":"明·东鲁古狂生《醉醒石》第十回"},"example":{"text":"然而正感谢有这一些的打，你把铁打成了钢，把泛泛的朋友都打成了～了。","book":"郭沫若《南京印象》十六"},"similar":["生死之交","患难与共","刎颈之交"],"opposite":["酒肉朋友","狐朋狗友","狼狈为奸"],"usage":"作谓语、宾语；指经过困难而成好朋友","story":["唐朝柳宗元考取进士后经王叔文推荐，升为礼部员外郎。王叔文改革失败，柳宗元被贬到永州司马。后来转任柳州刺史。他的好友刘禹锡迁擂州刺史，擂州是蛮夷作乱的地方，为了让刘禹锡照顾家庭，就上书申请与刘禹锡换位"]},{"id":19409,"word":"患难夫妻","pinyin":"huàn nàn fū qī","abbr":"hnfq","explanation":"患难：忧虑和灾难。指经受过困苦考验，能够同甘共苦的夫妻。","source":{"text":"情知此恨人人有，贫贱夫妻百事哀。","book":"唐·元稹《遣悲怀·二》"},"example":{"text":"只怕有了恩爱夫妻，就不要～了。","book":"清·文康《儿女英雄传》第二十三回"},"similar":["糟糠之妻"],"usage":"作主语、宾语、定语；用于夫妻间"},{"id":19410,"word":"患难相共","pinyin":"huàn nàn xiāng gòng","abbr":"hnxg","explanation":"患难：危险艰苦的环境。共同承担灾难和困苦。形容关系密切，利害一致。","source":{"text":"只因何玉凤、张金凤彼此性情相照、患难相共……不同寻常姐妹。","book":"清·文康《儿女英雄传》第31回"},"similar":["患难与共"],"opposite":["落井下石"],"usage":"作谓语、定语；指彼此关系密切"},{"id":19411,"word":"患难相恤","pinyin":"huàn nàn xiāng xù","abbr":"hnxx","explanation":"恤：体恤，周济。遇到患难彼此互相救助，甚至不惜生命。","source":{"text":"度乡村远近为伍保，使之力役相助，患难相恤，而奸伪无所容。","book":"《河南程氏文集》第11卷"},"similar":["患难相死"],"usage":"作谓语、定语；用于处世"},{"id":19412,"word":"患难相扶","pinyin":"huàn nàn xiāng fú","abbr":"hnxf","explanation":"扶：支持，帮助。在忧患灾难中互相扶助。","source":{"text":"但承吾兄患难相扶，始终周旋，此恩此德，何时能报。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"example":{"text":"吉凶相共，～，如有异心，天神共鉴。","book":"《说唐》第24回"},"similar":["患难与共"],"usage":"作谓语、宾语、定语；用于处世"},{"id":19413,"word":"患难相死","pinyin":"huàn nàn xiāng sǐ","abbr":"hnxs","explanation":"遇到患难彼此互相救助，甚至不惜生命。","source":{"text":"儒有闻善以相告也，见善以相示也，爵位相先也，患难相死也。","book":"西汉·戴圣《礼记·儒行》"},"similar":["患难相恤"],"usage":"作谓语、定语；用于处世"},{"id":19414,"word":"患难见真情","pinyin":"huàn nàn jiàn zhēn qíng","abbr":"hnjzq","explanation":"只有经过共同的患难才能看出自己的知心朋友。","source":{"text":"中国有句古话，叫做患难见真情。","book":"邓小平《国家的主权和安全要始终放在第一位》"},"similar":["患难见知己"],"usage":"作宾语、定语；指朋友"},{"id":19415,"word":"患难见知己","pinyin":"huàn nàn jiàn zhī jǐ","abbr":"hnjzj","explanation":"只有经过共同的患难才能看出自己的知心朋友。","example":{"text":"俗话说：～，此话不假。"},"similar":["路遥知马力"],"usage":"作宾语、定语；指朋友"},{"id":19416,"word":"悦人耳目","pinyin":"yuè rén ěr mù","abbr":"yrem","explanation":"悦：高兴。使人看了、听了感到快乐。","source":{"text":"始为盐铁小吏，性敏辩，于事之利病，皆心记能调，悦人耳目。","book":"宋·李昉《太平广记》卷二百五十二"},"example":{"text":"不但八音六律，吹拍成腔，并演习各种鱼龙山车等杂戏，务为淫巧，悦人耳目。（蔡东藩《南北史演义》第九十二回）"}},{"id":19417,"word":"悦尼来远","pinyin":"yuè ní lái yuǎn","abbr":"ynly","explanation":"使近处的人受到好处而高兴，远方的人闻风就会前来投奔。旧指当权者给人恩惠，以便笼络人心。","source":{"text":"叶公问政。子曰：‘近者说，远者来。’","book":"《论语·子路》"}},{"id":19418,"word":"悦心娱目","pinyin":"yuè xīn yú mù","abbr":"yxym","explanation":"使心里高兴，使眼睛快乐。形容使人感到美好快意。","source":{"text":"大凡人见悦目娱心之物固所喜。","book":"宋·张舜民《与石司理书》"},"example":{"text":"吾弟为文，须想春江之妙境，挹先辈之美词，令人～，自尔利科名，厚福泽。（清·郑燮《仪真县江村茶社寄舍弟书》）"},"similar":["悦目赏心","悦目娱心"],"usage":"作谓语、定语、状语；用于处事"},{"id":19419,"word":"悦目娱心","pinyin":"yuè mù yú xīn","abbr":"ymyx","explanation":"使眼睛高兴，使心里快乐。形容使人感到美好快乐。","source":{"text":"大凡人见悦目娱心之物固所喜。","book":"宋·张舜民《与石司理书》"},"similar":["悦目赏心","悦心娱目"],"usage":"作谓语、定语、状语；用于处事"},{"id":19420,"word":"悦目赏心","pinyin":"yuè mù shǎng xīn","abbr":"ymsx","explanation":"看了美好景物而心情舒畅。","source":{"text":"农场里的木芙蓉开了，共引为悦目赏心的乐事。","book":"叶圣陶《倪焕之》十七"},"example":{"text":"鲜花的多种多样的姿态，纷繁的颜色，除了让我们～外，我想还可以对我们的艺术思想有所启发。","book":"秦牧《艺海拾贝·鲜花百态和艺术风格》"},"similar":["悦目娱心","悦心娱目"],"usage":"作谓语、定语、状语；用于处事"},{"id":19421,"word":"悦近来远","pinyin":"yuè jìn lái yuǎn","abbr":"yjly","explanation":"使近者悦服，远者来归。","source":{"text":"近者悦，远者来。","book":"春秋·鲁·孔丘《论语·子路》"},"example":{"text":"正欲～，招附殊俗，亦以别华戎。","book":"《魏书·杨播传》"},"similar":["近悦远来"],"usage":"作谓语、定语；指统治者","story":["春秋时期，楚国大夫沈诸梁因封地于叶被称为叶公，孔子周游列国，来到楚国的叶邑，叶公向他请教怎样治理一个地方。孔子回答：“近者悦，远者来。”告诉他要先让境内的人民欢悦无怨，于是远处的人就会慕名而来投奔"]},{"id":19422,"word":"悬为厉禁","pinyin":"xuán wéi lì jìn","abbr":"xwlj","explanation":"悬：公开揭示。公开严厉禁止。","source":{"text":"本朝自康熙以来，因为明朝的东林及几社、复社都是士大夫的不安分，所以悬为厉禁。","book":"清·燕谷老人《续孽海花》第四十二回"},"example":{"text":"麻烟比鸦片更毒，故在新省亦～。","book":"茅盾《新疆风土杂忆》"},"usage":"作谓语、宾语；用于书面语"},{"id":19423,"word":"悬兵束马","pinyin":"xuán bīng shù mǎ","abbr":"xbsm","explanation":"形容险阻。同“悬车束马”。","source":{"text":"邓艾自阴平、景谷步道，悬兵束马，入蜀径江油、广汉者也。","book":"北魏·郦道元《水经注·涪水》"},"example":{"text":"蜀道再也不用～了"},"similar":["悬车束马"],"usage":"作宾语、定语；用于书面语"},{"id":19424,"word":"悬军深入","pinyin":"xuán jūn shēn rù","abbr":"xjsr","explanation":"悬：空无所倚。孤立无援的军队深入到敌人战区。","source":{"text":"谢玄遗使谓阳平公融曰：‘君悬军深入，而置阵逼水，此乃持久之计，非欲速战者也。’","book":"宋·司马光《资治通鉴·晋纪·孝武帝太元八年》"},"similar":["孤军深入"],"usage":"作谓语、宾语；指孤军作战"},{"id":19425,"word":"悬剑空垄","pinyin":"xuán jiàn kōng lǒng","abbr":"xjkl","explanation":"比喻心许朋友的事，不因人死而改变。","source":{"text":"还至徐，徐君已死，于是乃解其宝剑，系之徐君冢树而去。","book":"西汉·司马迁《史记·吴太伯世家》"},"example":{"text":"自然想借以增加读者的兴趣，但也有些所谓‘～’的意思的。","book":"鲁迅《且介亭杂文末编·下卷序言》"},"similar":["言出必行","松枝挂剑"],"usage":"作宾语、定语；指言出必行","story":["古代季札第一次出使北方，见到徐君结为好友。徐君喜欢季札的宝剑，口头虽没言明。季札心里明白这事，为了便于执行公务，就没有送给徐君。季札公务完毕路过徐地，见徐君已经去世，就到他的坟墓旁把宝剑挂在树上而离开"]},{"id":19426,"word":"悬圃蓬莱","pinyin":"xuán pǔ péng lái","abbr":"xppl","explanation":"传说中的神仙境地。","source":{"text":"览观县圃，浮游蓬莱。","book":"《汉书·郊祀志下》"},"usage":"作宾语、定语；用于书面语"},{"id":19427,"word":"悬壶于市","pinyin":"xuán hú yú shì","abbr":"xhys","explanation":"悬壶：行医。在集市上挂牌行医。","source":{"text":"市中有老翁卖药，悬一壶于肆头。及市罢，辄跳入壶中，市人莫之见。","book":"南朝·宋·范晔《后汉书·费长房传》"},"usage":"作谓语；指行医"},{"id":19428,"word":"悬壶行医","pinyin":"xuán hú xíng yī","abbr":"xhxy","explanation":"旧指挂牌行医看病。","source":{"text":"市中有老翁卖药，悬一壶于肆头。及市罢，辄跳入壶中，市人莫之见。","book":"《后汉书·费长房传》"}},{"id":19429,"word":"悬壶问世","pinyin":"xián hú wèn shì","abbr":"xhws","explanation":"在社会上挂牌行医。原只作“悬壶”，意即行医。","source":{"text":"市中有老翁卖药，悬一壶于肆头。及市罢，辄跳入壶中，市人莫之见。","book":"南朝·宋·范晔《后汉书·费长房传》"}},{"id":19430,"word":"悬头刺股","pinyin":"xuán tóu cì gǔ","abbr":"xtcg","explanation":"形容刻苦学习。同“悬梁刺股”。","source":{"text":"孙敬字文宝，好学，晨夕不休，及至眠睡疲寝，以绳系头，悬屋梁。后为当世大儒。","book":"《战国策·秦策一》：“（苏秦）读书欲睡，引锥自刺其股。”《太平御览》卷三百六十三引《汉书》"},"example":{"text":"未尝聚萤映雪，～。读《论》唯取一篇，披《庄》不过盈尺。","book":"《北史·崔赜传》"},"similar":["悬头刺骨","悬梁刺股"],"usage":"作谓语、定语、宾语；形容刻苦学习","story":["汉朝时儒学大师孙敬小时候读书十分刻苦，经常读到深夜，怕自己睡着就把头发用绳子系在屋梁上。战国时纵横家苏秦到秦国游说失败，为博取功名就发愤读书，每天读书到深夜，每当要打瞌睡时，他就用铁锥子刺一下大腿来提神"]},{"id":19431,"word":"悬头刺骨","pinyin":"xuán tóu cì gǔ","abbr":"xtcg","explanation":"悬：吊挂。把头挂在屋梁上面，用锥刺自己的大腿骨。形容刻苦学习","source":{"text":"词翰积如丘，要精通，须苦求，悬头刺骨非虚谬。","book":"明·胡文焕《群音类选·》"},"similar":["悬头刺股","悬梁刺股"],"usage":"作谓语、定语、宾语；形容刻苦学习"},{"id":19432,"word":"悬崕峭壁","pinyin":"xuán yá qiào bì","abbr":"xyqb","explanation":"形容山势险峻。同“悬崖峭壁”。"},{"id":19433,"word":"悬崖勒马","pinyin":"xuán yá lè mǎ","abbr":"xylm","explanation":"悬崖：高而陡的山崖；勒马：收住缰绳，使马停步。在高高的山崖边上勒住马。比喻到了危险的边缘及时清醒回头。","source":{"text":"此书生悬崖勒马，可谓大智矣。","book":"清·纪昀《阅微草堂笔记》"},"example":{"text":"您铸成大错在前，已经对不起天地祖宗，赶快～吧！","book":"华而实《汉衣冠》三"},"similar":["临崖勒马"],"opposite":["执迷不悟"],"usage":"作谓语、定语、分句；用于劝诫人"},{"id":19434,"word":"悬崖峭壁","pinyin":"xuán yá qiào bì","abbr":"xyqb","explanation":"峭壁：陡直的石壁。形容山势险峻。","source":{"text":"悬崖绝壁几千丈，绿萝袅袅不可攀。","book":"唐·刘长卿《望龙山怀道士许法稜》"},"example":{"text":"众人打一看时，四面尽是高山，左右是～。","book":"明·施耐庵《水浒传》"},"similar":["悬崖绝壁"],"opposite":["坦荡如砥"],"usage":"作宾语、定语；形容山势险峻"},{"id":19435,"word":"悬崖撒手","pinyin":"xuán yá sā shǒu","abbr":"xyss","explanation":"①比喻人至绝境，只能另作选择，义无反顾。②指在紧急关头，放下一切不管。","source":{"text":"直须悬崖撒手，自肯承当。","book":"宋·释道原《景德传灯录·苏州永光院真禅师》"},"example":{"text":"余小华《返青》：“多好的姑娘，本来她完全来得及退步抽身，～，可是她没有。”"},"usage":"作宾语、定语；用于比喻句"},{"id":19436,"word":"悬崖绝壁","pinyin":"xuán yá jué bì","abbr":"xyjb","explanation":"形容山势险峻。同“悬崖峭壁”。","source":{"text":"爬上悬崖绝壁，听见虎豹的叫声。","book":"方纪《三峡之秋》"},"example":{"text":"但是把人的心灵带到一种崇高的境界的，却是那些“吸翠霞而夭矫”的松树，它们不怕山高，把根扎在～的隙缝，身子扭的像盘龙柱子。","book":"李健吾《雨中登泰山》"},"similar":["悬崖峭壁"],"usage":"作宾语、定语；形容山势险峻"},{"id":19437,"word":"悬崖转石","pinyin":"xuán yá zhuǎn shí","abbr":"xyzs","explanation":"比喻形势发展迅猛。","source":{"text":"及其机之既动，则以悬崖转石之势，波波之相续，峰峰之不断，驯至数千百年而未有已。","book":"梁启超《中国历史上革命之研究》"},"usage":"作宾语、定语；用于比喻句"},{"id":19438,"word":"悬弧之庆","pinyin":"xuán hú zhī qìng","abbr":"xhzq","explanation":"弧：弓。指男子的生日。","source":{"text":"子生，男子设弧于门左，女子设帨于门右。","book":"《礼记·内则》"},"example":{"text":"～，在于何日。","book":"清·吴敬梓《儒林外史》第十回"},"similar":["悬弧之辰"],"usage":"作宾语；用于书面语"},{"id":19439,"word":"悬弧之辰","pinyin":"xuán hú zhī chén","abbr":"xhzc","explanation":"弧：弓；悬弧：古代习俗，生男孩，就在门的左首悬挂一张弓。指男子生日。","source":{"text":"子生，男子设弧于门左，女子设帨于门右。","book":"《礼记·内则》"},"example":{"text":"清·朱彝尊《黄征君序》：“岁在已巳之辰，先生～，年八十矣。”"},"similar":["悬弧之庆"],"usage":"作宾语；用于书面语"},{"id":19440,"word":"悬心吊胆","pinyin":"xuán xīn diào dǎn","abbr":"xxdd","explanation":"形容十分担心或害怕。","source":{"text":"众僧闻得此言，一个个提心吊胆，告天许愿。","book":"明·吴承恩《西游记》第十七回"},"example":{"text":"但他们往往遭农会严厉拒绝，所以他们总是～地过日子。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["提心吊胆"],"usage":"作谓语、定语；指担心或害怕"},{"id":19441,"word":"悬悬在念","pinyin":"xuán xuán zài niàn","abbr":"xxzn","explanation":"老是挂在心上，放心不下。","source":{"text":"相离数载，不知他得志也不曾？使老夫悬悬在念。","book":"元·关汉卿《谢天香》第一折"},"example":{"text":"因不见贤徒，～，今幸得胜而回。","book":"明·吴承恩《西游记》第九十三回"},"usage":"作谓语、定语、状语；用于书面语"},{"id":19442,"word":"悬悬而望","pinyin":"xuán xuán ér wàng","abbr":"xxew","explanation":"形容一心一意地期待、盼望。","source":{"text":"吾怜君而相赠，岂望报乎？君可速归，恐尊嫂悬悬而望也。","book":"明·冯梦龙《警世通言》卷二五"},"example":{"text":"每次出门，妈妈都在家～，等我归来。"},"usage":"作谓语、定语；指期待"},{"id":19443,"word":"悬断是非","pinyin":"xuán duàn shì fēi","abbr":"xdsf","explanation":"悬：凭空，没有依据。凭空推断是非对错。","source":{"text":"吾性騃滞，多所未甚谕，安敢悬断是且非耶？","book":"唐·柳宗元《复杜温夫书》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":19444,"word":"悬旌万里","pinyin":"xuán jīng wàn lǐ","abbr":"xjwl","explanation":"比喻军队远征。","source":{"text":"悬旌万里之外，扬威昆山之西。","book":"《汉书·陈汤传》"},"usage":"作谓语、定语；比喻军队远征"},{"id":19445,"word":"悬梁刺股","pinyin":"xuán liáng cì gǔ","abbr":"xlcg","explanation":"形容刻苦学习。","source":{"text":"孙敬字文宝，好学，晨夕不休，及至眠睡疲寝，以绳系头，悬屋梁。后为当世大儒。","book":"《战国策·秦策一》：“（苏秦）读书欲睡，引锥自刺其股。”《太平御览》卷三百六十三引《汉书》"},"example":{"text":"岂不闻古之人～，以志于学。","book":"明·徐霖《绣襦记·剔目劝学》"},"similar":["悬头刺股"],"usage":"作谓语、定语；形容刻苦学习","story":["汉朝时儒学大师孙敬小时候读书十分刻苦，经常读到深夜，怕自己睡着就把头发用绳子系在屋梁上。战国时纵横家苏秦到秦国游说失败，为博取功名就发愤读书，每天读书到深夜，每当要打瞌睡时，他就用铁锥子刺一下大腿来提神"]},{"id":19446,"word":"悬梁刺骨","pinyin":"xuán liáng cì gǔ","abbr":"xlcg","explanation":"形容刻苦学习。","source":{"text":"孙敬字文宝，好学，晨夕不休，及至眠睡疲寝，以绳系头，悬屋梁。后为当世大儒。","book":"《战国策·秦策一》：“（苏秦）读书欲睡，引锥自刺其股。”《太平御览》卷三百六十三引《汉书》"}},{"id":19447,"word":"悬榻留宾","pinyin":"xuán tà liú bīn","abbr":"xtlb","explanation":"榻：狭长而矮的床，特指待客留宿的床。把平日悬起的床放下来，留客人住下。比喻对客人以礼相待，格外尊敬。","source":{"text":"在郡不接宾客，惟稚来，特设一榻，去则悬之。","book":"《后汉书·徐稚传》"},"example":{"text":"曾朴《孽海花》第20回：“春秋佳日，～，偶然兴到，随地设宴。”"},"similar":["下榻留宾"],"usage":"作宾语、定语；用于交往等","story":["东汉时期，陈蕃担任豫章太守，他不喜欢留造访的客人过夜，唯独对名士徐稚除外。他的公馆内特为徐稚设了一张床，徐稚来时放下就可以用，走后就将床吊起来，可见他们的友谊有多深"]},{"id":19448,"word":"悬河注水","pinyin":"xuán hé zhù shuǐ","abbr":"xhzs","explanation":"比喻以强大力量去消灭敌方。同“悬河泻水”。","source":{"text":"张说谓人曰：‘杨盈川之文，如悬河注水，酌之不竭，既优于卢，亦不减王。耻居王后则信然，愧在卢前则为误矣。’","book":"唐·刘肃《大唐新语》卷八"},"similar":["悬河泻水"],"usage":"作宾语、定语；指写文章或说话"},{"id":19449,"word":"悬河注火","pinyin":"xuán hé zhù huǒ","abbr":"xhzh","explanation":"指以河水倾泻于火。比喻以强大力量去消灭敌方。","source":{"text":"况拥数州之兵以诛群竖，悬河注火，奚有不灭？","book":"《梁书·武帝纪上》"},"similar":["悬河泻火"],"usage":"作宾语、定语；用于比喻句"},{"id":19450,"word":"悬河泻水","pinyin":"xuán hé xiè shuǐ","abbr":"xhxs","explanation":"悬河：瀑布；泻水：水很快地往下流。河水直往下泻。比喻说话滔滔不绝或文辞流畅奔放。","source":{"text":"听象语，如悬河泻水，注而不竭。","book":"《晋书·郭象传》"},"example":{"text":"他的口才很好，讲演就像～一样。"},"similar":["口若悬河","悬河注水"],"usage":"作宾语、定语；指写文章或说话","story":["西晋时期，太尉王衍喜欢谈论老庄，他所论的义理随时更改，被人称为口中雌黄。他找到当时对老庄深有研究的郭象来探讨。郭象对老庄思想作了系统全面的分析，让王衍无法插嘴。王衍对他十分佩服说他谈老庄思想如同悬河泻水一样永不枯竭"]},{"id":19451,"word":"悬河泻火","pinyin":"xuán hé xiè huǒ","abbr":"xhxh","explanation":"比喻以强大力量去消灭敌方。同“悬河注火”。","source":{"text":"扫荡无余，犹悬河以泻火。","book":"清·陈天华《中国革命史论》第二章第二节"},"similar":["悬河注火"],"usage":"作宾语、定语；用于比喻句"},{"id":19452,"word":"悬灯结彩","pinyin":"xuán dēng jié cǎi","abbr":"xdjc","explanation":"悬：挂；彩：彩球，彩带。挂着灯笼，系着彩球。形容节日、喜庆的景象。","source":{"text":"两府中倶悬灯结彩，屏开鸾凤，褥设芙蓉；笙箫鼓乐之音，通衢越巷。","book":"清·曹雪芹《红楼梦》第七十一回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第68回：“只见水师营门口，～，一个营兵，正在那里点灯。”"},"similar":["张灯结彩"],"usage":"作谓语、宾语、定语；用于节日、喜庆等"},{"id":19453,"word":"悬牛头，卖马脯","pinyin":"xuán niú tóu，mài mǎ fǔ","abbr":"xntmmp","explanation":"挂着招揽生意的是牛头，而实际上卖的是马肉。比喻用假货欺骗人。","source":{"text":"悬牛头，卖马脯，盗跖行，孔子语。","book":"《晏子春秋·内篇杂下》：“君使服之于内，而禁之于外，犹悬牛首于门，而卖马肉于内也。”《后汉书·百官志》"},"example":{"text":"南朝·宋·范晔《后汉书·百官志》：“～，盗跖行，孔子语。”"},"similar":["挂羊头，卖狗肉"],"usage":"作宾语、定语；用于比喻句"},{"id":19454,"word":"悬狟素飡","pinyin":"xuán huán sù kòu","abbr":"xhsc","explanation":"比喻无功受禄。","source":{"text":"不狩不猎，胡瞻尔庭有县貆兮。彼君子兮，不素餐兮。","book":"语出《诗·魏风·伐檀》"}},{"id":19455,"word":"悬猙素飡","pinyin":"xuán huán sù kòu","abbr":"xhsk","explanation":"比喻无功受禄。","source":{"text":"不狩不猎，胡瞻尔庭有县貆兮。彼君子兮，不素餐兮。","book":"语出《诗·魏风·伐檀》"}},{"id":19456,"word":"悬珠编贝","pinyin":"xuán zhū biān bèi","abbr":"xzbb","explanation":"悬：吊挂。悬挂的明珠，编排整齐的贝壳。形容人眼睛明亮美丽和牙齿洁白整齐","source":{"text":"臣朔年二十二，长九尺三寸，目若悬珠，齿若编贝。","book":"东汉·班固《汉书·东方朔传》"},"usage":"作宾语、定语；用于比喻句"},{"id":19457,"word":"悬疣附赘","pinyin":"xuán yóu fù zhuì","abbr":"xyfz","explanation":"比喻累赘无用之物。","source":{"text":"彼以生为附赘县疣，以死为决疚溃痈，夫若然者，又恶知死生先后之所在！","book":"战国·宋·庄周《庄子·大宗师》"},"example":{"text":"参伍于仁义礼乐之中，～，特已甚焉。","book":"明·胡应麟《少室山房笔丛·九流绪论上》"},"usage":"作宾语、定语；指无用之物"},{"id":19458,"word":"悬石程书","pinyin":"xuán dàn chéng shū","abbr":"xdcs","explanation":"形容勤于政事。","source":{"text":"天下之事无小大皆决于上，上至以衡石量书，日夜有呈，不中呈，不得休息。","book":"《史记·秦始皇本纪》"},"example":{"text":"清·钱谦益《向言上》：“是故～，损撤膳服，忧劳日昃，而天下滋乱。”"},"similar":["衡石量书"],"usage":"作谓语、定语；指勤于政事","story":["公元前221年，秦始皇灭掉六国之后，日益骄横，对儒生横加指责，认为任何人都不如他，丞相和大臣都唯唯诺诺，一切听命于他。卢生、侯生对此不满，经常批评他贪权：“上至以衡石量书，日夜有呈，不中呈不得休息。”"]},{"id":19459,"word":"悬磬之居","pinyin":"xuán qìng zhī jū","abbr":"xqzj","explanation":"磬：石制乐器。屋里就像挂着石磬一样。形容家贫如洗，一无所有。","source":{"text":"夫以原宪悬磬之居，而值皇天无已之雨，薪刍既尽，谷亦倾匮。","book":"三国·魏·应璩《与韦仲将书》"},"similar":["室如悬罄","室如悬磬"],"usage":"作宾语；用于书面语"},{"id":19460,"word":"悬羊击鼓，饿马提铃","pinyin":"xuán yáng jī gǔ，è mǎ tí líng","abbr":"xyjgemtl","explanation":"悬：吊挂。把羊吊起来，使羊脚乱动击鼓；把铃吊在饿马的蹄子上发出声音。古代作战时使用空营诱惑敌人","source":{"text":"俺今夜倒下个空营，着悬羊击鼓，饿马提铃。","book":"元·无名氏《千里独行》楔子"},"similar":["悬羊打鼓"],"usage":"作宾语、定语；用于军事等"},{"id":19461,"word":"悬羊击鼓，饿马蹄铃","pinyin":"xuán yáng jī gǔ，è mǎ tí líng","abbr":"xyjgemtl","explanation":"把羊吊起来，使羊蹄乱动击鼓；将铃绑在饿马蹄子上，蹄动发出声响。古时作战，在军营中作这样的布置以诱惑敌人。","source":{"text":"俺今夜倒下了空营，着悬羊击鼓，饿马提铃。","book":"元·无名氏《千里独行》楔子"}},{"id":19462,"word":"悬羊卖狗","pinyin":"xuán yáng mài gǒu","abbr":"xymg","explanation":"挂着羊头，卖的却是狗肉。比喻以好的名义做招牌，实际上兜售低劣的货色。","source":{"text":"悬羊头，卖狗肉，坏后进，初几灭。","book":"《晏子春秋·内篇杂下》：“君使服之于内，而禁之于外，犹悬牛首于门而卖马脯于内也。”宋·释普济《五灯会元》卷十六"}},{"id":19463,"word":"悬羊头，卖狗肉","pinyin":"xuán yáng tóu，mài gǒu ròu","abbr":"xytmgr","explanation":"挂着羊头，卖的却是狗肉。比喻以好的名义做招牌，实际上兜售低劣的货色。","source":{"text":"悬羊头，卖狗肉，坏后进，初几灭。","book":"《晏子春秋·内篇杂下》：“君使服之于内，而禁之于外，犹悬牛首于门而卖马脯于内也。”宋·释普济《五灯会元》卷十六"},"example":{"text":"清·汪琬《菎山选佛场性空臻禅师塔铭》：“问：～意旨如何？师云：看破不值分文。”"},"similar":["卖狗悬羊","挂羊头，卖狗肉"],"usage":"作宾语、定语；用于处事"},{"id":19464,"word":"悬羊打鼓","pinyin":"xuán yáng dǎ gǔ","abbr":"xydg","explanation":"把羊吊起来，使羊蹄乱动击鼓。古时作战，在军营中作这样的布置以诱惑敌人。","source":{"text":"俺今夜倒下了空营，着悬羊击鼓，饿马提铃。","book":"元·无名氏《千里独行》楔子"},"example":{"text":"又暗令兵士通知各位元帅，将各营虚设旗帐，～。","book":"清·钱彩《说岳全传》第五十七回"},"similar":["悬羊击鼓，饿马提铃"],"usage":"作宾语、定语；用于军事等"},{"id":19465,"word":"悬而未决","pinyin":"xuán ér wèi jué","abbr":"xewj","explanation":"一直拖在那里，没有得到解决。","source":{"text":"已将一切问题决定，惟有如何处置国会一层，悬而未决。","book":"孙中山《救国之急务》"},"example":{"text":"这多年～的问题终于有了结果。"},"similar":["束之高阁"],"usage":"作谓语、定语；指搁置"},{"id":19466,"word":"悬肠挂肚","pinyin":"xuán cháng guà dù","abbr":"xcgd","explanation":"形容挂念之深切。","source":{"text":"小可兄弟，只为父亲这一事，悬肠挂肚，坐卧不安，不由宋江不来取。","book":"明·施耐庵《水浒传》第24回"},"example":{"text":"她的外出让我～。"},"similar":["牵肠挂肚"],"usage":"作谓语；同“牵肠挂肚”"},{"id":19467,"word":"悬若日月","pinyin":"xuán ruò rì yuè","abbr":"xrry","explanation":"宛如太阳和月亮一样高高地挂在天空上。形容作品具有永恒的生命力。","source":{"text":"李氏绝笔之本，悬若日月焉。","book":"宋·王谠《唐语林·文学》"},"usage":"作谓语、定语；用于书面语"},{"id":19468,"word":"悬车之岁","pinyin":"xuán chē zhī suì","abbr":"xczs","explanation":"悬车：古人一般至七十岁辞官家居，废车不用。指七十岁。同“悬车之年”。","source":{"text":"若今日未及四十，早入仕途，则致仕之期，即不必以七十为限……故余两次引归，皆未及悬车之岁。","book":"清·梁章钜《归田琐记·七十致仕》"},"similar":["悬车之年"],"usage":"作主语、宾语；指70岁"},{"id":19469,"word":"悬车之年","pinyin":"xuán chē zhī nián","abbr":"xczn","explanation":"悬车：古人一般至七十岁辞官家居，废车不用。指七十岁。","source":{"text":"少师相公未及悬车之年，二表乞罢将相。","book":"《晋书·刘毅传》：“昔郑武公年过八十，入为周司徒，虽过悬车之年，必有可用。”唐·许浑《贺少师相公致政》诗序"},"example":{"text":"唐·许浑《贺少师相公致政》诗序：“少师相公未及～，二表乞罢将相。”"},"similar":["悬车之岁"],"usage":"作主语、宾语；指70岁"},{"id":19470,"word":"悬车告老","pinyin":"xuán chē gào lǎo","abbr":"xcgl","explanation":"指告老引退，辞官家居。同“悬车致仕”。","source":{"text":"时年已七十，遂隐丘山，悬车告老，四门备礼，闲心静居。","book":"汉·蔡邕《陈寔碑》"},"example":{"text":"忠襄不可及已，至若文节，年六十余已～，将二十载矣，闻一权臣擅国，遂至饿死。","book":"元·揭傒斯《杨氏忠节祠记》"},"similar":["悬车致仕"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":19471,"word":"悬车束马","pinyin":"xuán chē shù mǎ","abbr":"xcsm","explanation":"形容险阻。","source":{"text":"太行、辟耳，山名也。拘夏，辟耳之溪也。三者皆山险溪谷，故悬钩其车，偪束其马以渡。","book":"《国语·齐语》：“悬车束马，逾太行与辟耳之溪拘夏。”韦昭注"},"example":{"text":"公卷甲北塞，～，遂得策预葭萌，勋参绵竹。","book":"北周·庾信《周大将军司马裔神道碑》"},"similar":["悬兵束马"],"usage":"作宾语、定语；用于书面语"},{"id":19472,"word":"悬车致仕","pinyin":"xuán chē zhì shì","abbr":"xczs","explanation":"指告老引退，辞官家居。","source":{"text":"臣七十悬车致仕者，臣以执事趋走为职，七十阳道极，耳目不聪明，跛踦之属，是以退去避贤者，所以长廉耻也。悬车，示不用也。","book":"汉·班固《白虎通·致仕》"},"example":{"text":"中年聊于东田，欲穿池种树，少寄情赏；又以郊际闲旷，终可为宅。傥获～，实欲歌笑于斯。","book":"《艺文类聚》卷二三引南朝·梁·徐勉《与大息山松书》"},"similar":["悬车告老","致仕悬车"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":19473,"word":"悬门抉目","pinyin":"xuán mén jué mù","abbr":"xmjm","explanation":"以之为烈士殉国的典故。","source":{"text":"抉吾眼县吴东门之上，以观越寇之灭吴也。","book":"西汉·司马迁《史记·伍子胥列传》"},"example":{"text":"从此中原涂炭矣，～我何心。","book":"柳亚子《痛哭》"},"similar":["抉目悬门"],"usage":"作宾语、定语；用于书面语","story":["春秋时期，吴国大夫伍子胥劝吴王夫差拒绝越王勾践的求和，夫差不但不听，反而听信谗言赐剑令伍子胥自尽。伍子胥临终前万分悲愤地说：“抉吾眼县吴东门之上，以观越寇之灭吴也。”后来越王勾践卧薪尝胆终于灭了吴国"]},{"id":19474,"word":"悬鞀建铎","pinyin":"xuán táo jiàn duó","abbr":"xtjd","explanation":"指听取臣民意见。","source":{"text":"禹之时，以五音听治，悬钟鼓磬铎，置鞀，以待四方之士。为号曰：教寡人以道者击鼓，谕寡人以义者击钟，告寡人以事者振铎，语寡人以忧者击磬，有狱讼者摇鞀。","book":"语出《淮南子·氾论训》"},"example":{"text":"清·冯桂芬《校岎庐抗议》自序：“民隐不上达，而始知圣人～，庶人传语之法善也。”"},"similar":["悬鞀设铎"],"usage":"作谓语、定语、宾语；用于书面语","story":["大禹统治时期，他在住地附近设置钟、鼓、磬、铎、鞀五种乐器，并规定四方的贤人如何使用：传道的人击鼓，谕义的就敲钟，告事的就振铎，讲忧虑的就敲磬，有冤狱的就摇鞀。于是大禹就凭听这五种声音而处理"]},{"id":19475,"word":"悬鞀设铎","pinyin":"xuán táo shè duó","abbr":"xtsd","explanation":"悬：吊挂；鞀：鼗鼓，拨浪鼓；铎：大铃。吊起鼗鼓，设置铃铎。指听取臣民的意见","source":{"text":"泰西议院之法，本古人悬鞀设铎，闾师党正之遗意。","book":"清·陈炽《议院》"},"similar":["悬鞀建铎"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":19476,"word":"悬首吴阙","pinyin":"xuán shǒu wú què","abbr":"xswq","explanation":"犹言悬门抉目。以之为烈士殉国的典故。","source":{"text":"抉吾眼县吴东门之上，以观越寇之灭吴也。","book":"西汉·司马迁《史记·伍子胥列传》"},"example":{"text":"明·梁辰鱼《浣纱记·允降》：“誓当～，以谢先灵。”"},"similar":["抉目东门","抉目胥门","抉目悬门"],"usage":"作宾语、定语；用于书面语","story":["春秋时期，吴国大夫伍员（字子胥）劝吴王夫差拒绝越国求和。夫差听信谗言，赐伍子胥宝剑一把自尽。伍子胥临死时说：“把我的眼睛挖出放到吴国东城门上，让我看到越国将来消灭吴国。”没过多久，吴国被越国所灭"]},{"id":19477,"word":"悬驼就石","pinyin":"xuán tuó jiù shí","abbr":"xtjs","explanation":"比喻用力多，得益少。","source":{"text":"《法苑珠林》卷六六记载：有人得到一匹死骆驼，剥皮嫌刀钝。楼上有块磨刀石，于是上楼磨刀，下楼剥皮，上下往返，十分费事。"},"similar":["削足适履"],"usage":"作谓语、定语；指处事愚笨","story":["古代有人得到一匹死骆驼，他想剥掉骆驼皮但嫌刀钝。楼上有块磨刀石，于是他一会儿上楼磨刀，一会儿下楼剥皮，上下往返，十分费事。为了就近磨刀，他并没有把磨刀石搬下来，却费尽力气将死骆驼挂到楼上去剥"]},{"id":19478,"word":"悬鹑百结","pinyin":"xuán chún bǎi jié","abbr":"xcbj","explanation":"鹌鹑的羽毛又短又花，因以悬鹑比喻破烂的衣服。形容破烂，补钉很多。","source":{"text":"盖闻悬鹑百结，知命不忧。","book":"北周·庾信《拟连珠》"},"example":{"text":"～，伛偻道上。","book":"清·蒲松龄《聊斋志异·张诚》"},"similar":["鹑衣百结"],"usage":"作谓语、定语；指生活贫困"},{"id":19479,"word":"悬鼓待椎","pinyin":"xuán gǔ dài zhuī","abbr":"xgdz","explanation":"比喻急不可待。","source":{"text":"宋范仲淹一日携子纯仁访民家。民舍有鼓为妖。坐未几，鼓自风滚至庭不已，民舍皆股栗。仲淹徐谓纯仁曰：‘此鼓久不击，见好客至，故自来庭以寻槌耳。’令纯仁削槌以副之，其鼓立碎。","book":"《渊鉴类函·乐·鼓二》引明陈耀文《天中记》"},"example":{"text":"明·唐顺之《与李克斋侍郎书》：“止靠今岁新催丁田银，如～之不可缓。”"},"usage":"作宾语、定语；用于书面语","story":["宋朝时期，范仲淹一天带儿子去民家访问，民房中有鼓妖在他们坐不久时自动滚到前庭，满屋子人都感到害怕。范仲淹慢慢地对纯仁说：“此鼓久不击，见好客至，故自来庭以寻槌耳。”就让纯仁击鼓，那妖鼓立即自破"]},{"id":19480,"word":"悬鼗建铎","pinyin":"xuán táo jiàn duó","abbr":"xtjd","explanation":"鼗，俗称“拨浪鼓”。指听取臣民意见。","source":{"text":"禹之时，以五音听治，悬钟鼓磬铎，置鼗，以待四方之士。为号曰：教寡人以道者击鼓，谕寡人以义者击钟，告寡人以事者振铎，语寡人以忧者击磬，有狱讼者摇鼗。","book":"语出《淮南子·泛论训》"}},{"id":19481,"word":"悬龟系鱼","pinyin":"xuán guī jì yú","abbr":"xgjy","explanation":"指任高官显宦。","source":{"text":"高宗给五品以上随身鱼袋……天授二年，改佩鱼为。其后三品以上龟袋饰以金，四品以银，五品以铜。中宗初，罢龟袋，复给以鱼。","book":"《新唐书·车服志》"},"example":{"text":"数世之后，将振振绳绳，～，秉钧当轴。","book":"明·宋濂《题张如心初修谱叙后》"},"usage":"作宾语、定语；用于书面语"},{"id":19482,"word":"悮人子弟","pinyin":"wù rén zǐ dì","abbr":"wrzd","explanation":"悮：耽误。指因无才或不负责任而耽误人家后辈学生。","source":{"text":"你知道悮人子弟，男盗女娼，强迫人做汉奸，这是何等的罪恶！","book":"续范亭《寄山西土皇帝阎锡山一封五千言书》"},"similar":["误人子弟"],"usage":"作谓语、定语、宾语；指不负责任"},{"id":19483,"word":"悮国欺君","pinyin":"wù guó qī jūn","abbr":"wgqj","explanation":"悮：耽误；欺：欺骗。欺骗君王，祸害国家。","source":{"text":"假如有一等做官的，悮国欺君，侵剥百姓，虽然官高禄厚，难道不是大盗？","book":"明·凌濛初《初刻拍案惊奇》第八卷"},"similar":["欺君误国"],"usage":"作谓语、定语；指祸害国家"},{"id":19484,"word":"悯时病俗","pinyin":"mǐn shí bìng sú","abbr":"msbs","explanation":"指忧虑时俗。","source":{"text":"足下自称有悯时病俗之心，信如是，是足下之有志乎道。","book":"宋·曾巩《答李讼书》"},"example":{"text":"如仆辈虽念此痛痒相关，不能无～之意。","book":"明·唐顺之《答冯午山提学书》"},"opposite":["愤世嫉俗"],"usage":"作定语；指忧虑时俗"},{"id":19485,"word":"悱恻缠绵","pinyin":"fěi cè chán mián","abbr":"fccm","explanation":"心绪悲苦而不能排遣。","source":{"text":"宁不愿风肆好，月常圆。乐融融，悱恻缠绵，堪媲美孟和桓。","book":"清·嬴宗季女《六月霜》第二折"},"example":{"text":"我记得，我心灵里清纯洁白一点爱性，已经经过～的一番锻炼。","book":"瞿秋白《饿乡纪程》"},"usage":"作谓语、定语；指人的内心"},{"id":19486,"word":"悲不自胜","pinyin":"bēi bù zì shèng","abbr":"bbzs","explanation":"胜：能承受。悲伤得自己不能承受。形容极度悲伤。","source":{"text":"《燕歌》远别，悲不自胜。","book":"汉·荀悦《汉纪·平帝纪》：“太后因号泣而言，左右莫不垂涕，舜百万不自胜。”北周·庾信《哀江南赋序》"},"example":{"text":"是年冬初，丽人无故，忽潸然泪下，～，怪而问之，初则隐忍弗言，继则举声大恸。","book":"明·李昌祺《剪灯余话·秋夕访琵琶亭记》"},"similar":["悲痛欲绝","哀哀欲绝"],"opposite":["喜不自胜","乐不可支","喜出望外"],"usage":"作谓语、补语；形容伤感至极，情难自禁"},{"id":19487,"word":"悲从中来","pinyin":"bēi cóng zhōng lái","abbr":"bczl","explanation":"中：内心。悲痛的感情从内心涌出来。","source":{"text":"悲从中来，不可断绝。","book":"三国·魏·曹操《短歌行》"},"example":{"text":"大家联了此语，益觉～，泣不可抑。","book":"蔡东藩、许廑父《民国通俗演义》第二十回"},"usage":"作谓语、宾语；指人真伤心"},{"id":19488,"word":"悲伤憔悴","pinyin":"bēi shāng qiáo cuì","abbr":"bsqc","explanation":"因悲伤而身体消瘦，脸色难看。","source":{"text":"此皆骚人思士之所以悲伤憔悴而不能胜者。","book":"宋·苏澈《黄州快哉亭记》"}},{"id":19489,"word":"悲喜交切","pinyin":"bēi xǐ jiāo qiè","abbr":"bxjq","explanation":"悲伤和喜悦的心情交织在一起。","source":{"text":"遂披帷相见，悲喜交切。","book":"晋·贾善翔《天上玉女记》"},"similar":["悲喜交并"],"opposite":["无动于衷"],"usage":"作谓语、定语；形容又高兴又难过"},{"id":19490,"word":"悲喜交加","pinyin":"bēi xǐ jiāo jiā","abbr":"bxjj","explanation":"交加：聚集。悲伤和喜悦的心情交织在一起。","source":{"text":"且说胡小记与艾虎认着表亲，悲喜交加。","book":"清·石玉昆《小五义》第54回"},"example":{"text":"听到这个消息，我～。"},"similar":["悲喜交集"],"usage":"作谓语、定语；形容又高兴又难过"},{"id":19491,"word":"悲喜交并","pinyin":"bēi xǐ jiāo bìng","abbr":"bxjb","explanation":"悲伤和喜悦的心情交织在一起。","source":{"text":"奉诏之日，悲喜交并，天恩光被，褒崇辉渥。","book":"《晋书·张轨传》"},"similar":["悲喜交加","悲喜交集"],"opposite":["麻木不仁"],"usage":"作谓语、定语；形容又高兴又难过"},{"id":19492,"word":"悲喜交至","pinyin":"bēi xǐ jiāo zhì","abbr":"bxjz","explanation":"悲伤和喜悦的心情交织在一起来到。","source":{"text":"共话前生，悲喜交至。","book":"清·蒲松龄《聊斋志异·莲香》"},"similar":["悲喜交集"],"opposite":["麻木不仁"],"usage":"作谓语、定语；形容又高兴又难过"},{"id":19493,"word":"悲喜交集","pinyin":"bēi xǐ jiāo jí","abbr":"bxjj","explanation":"交：共。悲伤和喜悦的心情交织在一起。","source":{"text":"当大明之盛，而守局遐外，不得奉瞻大礼，闻问之日，悲喜交集。","book":"《晋书·王廙传》"},"example":{"text":"～的父亲紧紧抱住了久别的儿子。"},"similar":["惊喜交集","悲喜交至"],"opposite":["无动于衷","麻木不仁","心如枯井"],"usage":"作谓语、定语；形容又高兴又难过，心情激动"},{"id":19494,"word":"悲喜兼集","pinyin":"bēi xǐ jiān jí","abbr":"bxjj","explanation":"悲伤和喜悦的心情交织在一起。","source":{"text":"千里一遇，悲喜兼集。","book":"唐·唐晅《手记》"},"similar":["悲喜交集","悲喜交并"],"opposite":["无动于衷"],"usage":"作谓语、定语；形容又高兴又难过"},{"id":19495,"word":"悲声载道","pinyin":"bēi shēng zài dào","abbr":"bszd","explanation":"指哀伤呼叫之声充满道路。形容苦难深重。","source":{"text":"妇叹童呼，悲声载道；酷刑厚敛，怨气冲天。","book":"太平天国·洪秀全《誓师檄文》"},"similar":["怨声载道"],"usage":"作谓语、定语、状语；指苦难深重"},{"id":19496,"word":"悲天悯人","pinyin":"bēi tiān mǐn rén","abbr":"btmr","explanation":"悲天：哀叹时世；悯人：怜惜众人。指哀叹时世的艰难，怜惜人们的痛苦。","source":{"text":"彼二圣一贤者，岂不知自安佚之为乐哉？诚畏天命而悲人穷也。","book":"唐·韩愈《争臣论》"},"example":{"text":"君生平绝口弗谈政治，独其～之怀，流露于不自觉，有如此者。","book":"柳亚子《燕子龛遗诗序》"},"similar":["愁肠百结","忧心忡忡"],"opposite":["随遇而安","自得其乐"],"usage":"作谓语、定语、状语；指对社会腐败感到伤心"},{"id":19497,"word":"悲悲切切","pinyin":"bēi bēi qiè qiè","abbr":"bbqq","explanation":"形容极其悲哀。","source":{"text":"杉上秋雨声，悲切蒹葭夕。","book":"唐·王昌龄《岳阳别李十七越宾》"},"example":{"text":"独立墙角边花阴下，～，呜咽起来。","book":"清·曹雪芹《红楼梦》第二十六回"}},{"id":19498,"word":"悲愁垂涕","pinyin":"bēi chóu chuí tì","abbr":"bcct","explanation":"垂：垂下；涕：泪。因为悲哀、愁苦而落泪。","source":{"text":"一里老幼，悲愁垂涕相对，三日不食。","book":"《列子·汤问》"},"usage":"作谓语、状语；指愁苦伤心"},{"id":19499,"word":"悲愤填膺","pinyin":"bēi fèn tián yīng","abbr":"bfty","explanation":"膺：胸。悲痛和愤怒充满胸中。","source":{"text":"草头朝露，贵贱都虚度。悲愤填膺莫诉，壮怀孤负。","book":"清·伤时子《苍鹰击》第六折"},"example":{"text":"曹植听了这个题目，不禁～。","book":"羽人《文化五千年·文坛三杰——曹氏父子》"},"similar":["义愤填膺"],"usage":"作谓语、定语；用于仁人志士的正义之举"},{"id":19500,"word":"悲欢合散","pinyin":"bēi huān hé sàn","abbr":"bhhs","explanation":"悲哀和欢乐，团聚和离别。泛指生活中的种种境遇和心情。","source":{"text":"当花对酒，乐罢哀余，通滞屈伸，悲欢合散，至于疾恙躬身，悼怀惜逝，凡所对遇异于常者，则欲赋诗。","book":"唐·元稹《叙诗寄乐天书》"},"similar":["悲欢离合"],"opposite":["平淡无奇"],"usage":"作主语、宾语；形容生活中的悲哀喜悦等情感"},{"id":19501,"word":"悲欢离合","pinyin":"bēi huān lí hé","abbr":"bhlh","explanation":"悲伤、欢乐、离散、聚会。泛指生活中经历的各种境遇和由此产生的各种心情。","source":{"text":"人有悲欢离合，月有阴睛阳缺，此事古难全。","book":"宋·苏轼《水调歌头》词"},"example":{"text":"童年的记忆最单纯最真切，影响最深最久，种种～，回想起来最有意思。","book":"朱自清《我是扬州人》"},"similar":["酸甜苦辣","喜怒哀乐"],"opposite":["平淡无奇"],"usage":"作主语、宾语；形容生活中的悲哀喜悦等情感","story":["宋朝时期，苏轼、苏辙兄弟情深，同时考中进士，步入仕途，宦海茫茫，身不由己，兄弟聚少离多，有一年中秋节，苏轼感慨六年没见到苏辙了，便作诗《水调歌头》：“人有悲欢离合，月有阴睛阳缺，此事古难全。但愿人长久，千里王丽娟。”"]},{"id":19502,"word":"悲欢聚散","pinyin":"bēi huān jù sàn","abbr":"bhjs","explanation":"悲：悲哀；欢：欢乐；聚：团聚；散：离散。泛指人世间悲与欢、聚与散的遭遇和心情。","source":{"text":"且痛饮琼浆百盏，何苦惜分离，这悲欢聚散，元无定期。","book":"明·胡文焕《群音类选·》"},"similar":["悲欢合散","悲欢离合"],"opposite":["平淡无奇"],"usage":"作主语、宾语；形容生活中的悲哀喜悦等情感"},{"id":19503,"word":"悲歌击筑","pinyin":"bēi gē jī zhù","abbr":"bgjz","explanation":"以之为典，抒写悲壮苍凉的气氛。","source":{"text":"《史记·刺客列传》载：战国时，荆轲受燕太子丹托付，入秦刺秦王，太子及朋友们送别于易水，高渐离击筑，荆轲歌“风萧萧兮易水寒，壮士一去兮不复还”，登车不顾而去。"},"example":{"text":"百战西归变姓名，～醉湖城。","book":"宋·陆游《老将》诗"},"similar":["悲歌易水"],"usage":"作谓语、定语；描写悲壮的气氛","story":["战国末期，燕太子丹从秦国逃回，访到义士荆轲与高渐离，请他们出面去刺杀秦王嬴政。一切准备就绪，太子丹率手下着白装送他们到易水边，高渐离击筑，荆轲高唱：“风萧萧兮易水寒，壮士一去兮不复还！”一行人洒泪告别"]},{"id":19504,"word":"悲歌慷慨","pinyin":"bēi gē kāng kǎi","abbr":"bgkk","explanation":"情绪激昂地唱歌，以抒发悲壮的胸怀。","source":{"text":"慷慨独悲歌，钟期信为贤。","book":"《史记·项羽本纪》：“于是项王乃悲歌慷慨。”晋·陶潜《怨诗楚调示庞主簿邓治中》"},"example":{"text":"乃至变乱之间，尽丧其平生，岂其～之性欤。","book":"清·黄宗羲《桐城方烈士妇墓志铭》"},"similar":["慷慨悲歌"],"usage":"作宾语、定语；形容壮烈的场面"},{"id":19505,"word":"悲歌易水","pinyin":"bēi gē yì shuǐ","abbr":"bgys","explanation":"抒写悲壮苍凉的气氛。","source":{"text":"见“悲歌击筑”。"},"example":{"text":"～无豪侠，买骨金台有钝驽。","book":"清·丘逢甲《十一月诗韵》"},"similar":["悲歌击筑"],"usage":"作谓语、定语；描写悲壮的气氛","story":["战国末期，燕太子丹从秦国逃回，访到义士荆轲与高渐离，请他们出面去刺杀秦王嬴政。一切准备就绪，太子丹率手下着白装送他们到易水边，高渐离击筑，荆轲高唱：“风萧萧兮易水寒，壮士一去兮不复还！”一行人洒泪告别"]},{"id":19506,"word":"悲泗淋漓","pinyin":"bēi sì lín lí","abbr":"bsll","explanation":"泗：鼻涕；淋漓：往下滴。形容十分悲痛的样子。","source":{"text":"悲泗淋漓，诚怚人心。","book":"唐·李朝威《柳毅传》"}},{"id":19507,"word":"悲痛欲绝","pinyin":"bēi tòng yù jué","abbr":"btyj","explanation":"绝：穷尽。悲哀伤心到了极点。","source":{"text":"她那人间的爱人悲痛欲绝，日日在她变成的土山下面，跪着呜咽哭啼，直到死在这山脚下。","book":"路遥《平凡的世界》第一卷第七章"},"example":{"text":"她听到儿子遭到车祸的消息，悲痛欲绝。"},"similar":["痛不欲生","悲恸欲绝"],"opposite":["欣喜若狂"],"usage":"作谓语、定语、补语；指极度悲哀，万分伤心"},{"id":19508,"word":"悲观主义","pinyin":"bēi guān zhǔ yì","abbr":"bgzy","explanation":"对世事所怀消极看法的处世观。","source":{"text":"投降主义根源于民族失败主义，即民族悲观主义。","book":"毛泽东《和英国记者贝特兰的谈话》"},"opposite":["乐观主义"],"usage":"作主语、宾语、定语；用于处事"},{"id":19509,"word":"悲观厌世","pinyin":"bēi guān yàn shì","abbr":"bgys","explanation":"厌世：厌弃人世。对生活失去信心，精神颓丧，厌弃人世。","source":{"text":"他们的作品就只是暴露黑暗，被称为‘暴露文学’，还有简直是专门宣传悲观厌世的。","book":"毛泽东《在延安文艺座谈会上的讲话》"},"example":{"text":"生活的艰辛，爱憎的苦恼，使她产生了～的情绪。"},"similar":["郁郁寡欢","忧心忡忡"],"opposite":["乐知天命","随遇而安"],"usage":"作谓语、定语；形容人对生活没信心"},{"id":19510,"word":"悲观失望","pinyin":"bēi guān shī wàng","abbr":"bgsw","explanation":"悲观：原为佛家语，五观之一。指消极失望。","source":{"text":"我们决不悲观失望，我们是乐观的。","book":"毛泽东《团结一切抗日力量，反对反共顽固派》"},"example":{"text":"遇到困难就不会看到光明和胜利，就没有不～的。","book":"邓小平《跃进中原的胜利形势与今后的政策策略》"},"usage":"作谓语、定语、宾语；用于消极处世"},{"id":19511,"word":"悼心失图","pinyin":"dào xīn shī tú","abbr":"dxst","explanation":"悼：悲伤；图：谋划。因悲痛而失去了主张。","source":{"text":"嘉惠未至，唯襄公之辱临我丧，孤与其二三臣悼心失图。","book":"《左传·昭公七年》"},"example":{"text":"～，泣血待旦。","book":"南朝·梁·任昉《为齐明帝让宣城郡公第一表》"},"usage":"作谓语、定语；指因悲痛而失去了主张"},{"id":19512,"word":"悼心疾首","pinyin":"dào xīn jí shǒu","abbr":"dxjs","explanation":"心里伤感，头部疼痛。形容悲痛到了极点。","source":{"text":"况其临命须臾，处之不挠，载形章表，益深衷悃，问使发缄，悼心疾首。","book":"《旧唐书·田布传》"},"similar":["痛心疾首"],"usage":"作谓语；指十分悲痛"},{"id":19513,"word":"惄焉如捣","pinyin":"nì yān rú dǎo","abbr":"nyrd","explanation":"惄焉：忧思伤痛的样子。忧思伤痛，心中像有东西撞击。形容忧伤思念，痛苦难忍。","source":{"text":"我心忧伤，惄焉如捣。","book":"《诗经·小雅·小弁》"},"example":{"text":"该处地方陡遭劫害，眷念商民，～。","book":"蔡东藩《民国通俗演义》第32回"},"usage":"作谓语；指十分伤悲"},{"id":19514,"word":"情不可却","pinyin":"qíng bù kě què","abbr":"qbkq","explanation":"却：推却。情面上不能推却。","source":{"text":"闺臣、红蕖众姊妹也再再相留，紫菱情不可却，只得应允。","book":"清·李汝珍《镜花缘》第六十回"},"example":{"text":"郁文～，只好收拾了简单行李，乘了往九江的招商轮船。","book":"燕谷老人《续孽海花》第四十四回"},"similar":["碍于情面"],"usage":"作宾语、定语；指情面上不能推却"},{"id":19515,"word":"情不自堪","pinyin":"qíng bù zì kān","abbr":"qbzk","explanation":"无法忍受自己的感情。","source":{"text":"步月如有意，情来不自禁。","book":"南朝·梁·刘遵《七夕穿针》诗"},"example":{"text":"生捧书悲咽，～。","book":"唐·李公佐《南柯记》"},"similar":["情不自胜"],"usage":"作谓语、状语；用于描写人的感情"},{"id":19516,"word":"情不自已","pinyin":"qíng bù zì yǐ","abbr":"qbzy","explanation":"犹情不自禁。感情激动得不能控制。强调完全被某种感情所支配。","source":{"text":"过一二日，情不自已，修贽复往。","book":"清·蒲松龄《聊斋志异·瑞云》"},"similar":["情不自禁"],"usage":"作谓语、状语；用于描写人的感情"},{"id":19517,"word":"情不自禁","pinyin":"qíng bù zì jìn","abbr":"qbzj","explanation":"禁：抑制。感情激动得不能控制。强调完全被某种感情所支配。","source":{"text":"步月如有意，情来不自禁。","book":"南朝梁·刘遵《七夕穿针》诗"},"example":{"text":"她又～地放声哭了。","book":"沙汀《一个秋天晚上》"},"similar":["不由自主","身不由己"],"opposite":["不露声色","无动于衷"],"usage":"作谓语、状语；用于描写人的感情"},{"id":19518,"word":"情不自胜","pinyin":"qíng bù zì shèng","abbr":"qbzs","explanation":"胜：承当得起，指忍受。感情悲痛得无法忍受。","source":{"text":"追寻悲痛，情不自胜。思屈法科，以伸矜悼。","book":"南朝·宋·刘彧《罪始安王休仁诏》"},"example":{"text":"不由的悲喜交集，～，勉强对着三尊大佛，行过了香，遂令侍卫等在外候驾，自携武氏趋入云房。","book":"蔡东藩《唐史演义》第二十四回"},"similar":["情不自堪"],"usage":"作谓语、状语；用于描写人的感情"},{"id":19519,"word":"情之所钟","pinyin":"qíng zhī suǒ zhōng","abbr":"qzsz","explanation":"钟：汇聚，专注。指痴情所向，十分专注。","source":{"text":"圣人忘情，最下不及于情，然则情之所钟，正在我辈。","book":"《晋书·王衍传》"},"example":{"text":"爹妈见说是皇亲，又曾来望，便不疑他。谁想～，解释不得。","book":"明·冯梦龙《警世通言》卷三十"},"opposite":["三心二意"],"usage":"作谓语、定语、宾语；用于书面语","story":["晋朝时期，王衍死了年轻的幼子，十分悲伤。山简前往吊唁，并劝王衍说孩子只不过是“抱中物”，不必如此悲伤。王衍动情地说：“圣人忘情，最下不及于情，然则情之所钟，正在我辈。”"]},{"id":19520,"word":"情人眼里出西施","pinyin":"qíng rén yǎn lǐ chū xī shī","abbr":"qrylcxs","explanation":"西施：春秋时越国美女。比喻由于有感情，觉得对方无一处不美。","source":{"text":"谚云：情人眼里有西施。","book":"宋·胡仔《苕溪渔隐丛话后集·山谷上》"},"example":{"text":"一则是天缘，二来是～。","book":"清·曹雪芹《红楼梦》第七十九回"},"usage":"作宾语、分句；用于恋爱中的男女"},{"id":19521,"word":"情凄意切","pinyin":"qíng qī yì qiē","abbr":"qqyq","explanation":"指心境十分悲伤。","source":{"text":"他那里肉跳心惊，你这里情凄意切。","book":"明·康海《王兰卿》第二折"},"usage":"作谓语、定语；用于人的感情"},{"id":19522,"word":"情同一家","pinyin":"qíng tóng yī jiā","abbr":"qtyj","explanation":"情谊深厚，如同一家。","source":{"text":"我与卿兄弟，便是情同一家。","book":"《梁书·萧子恪传》"},"example":{"text":"满、蒙、汉民，久已互通婚嫁，～。","book":"高阳《慈禧全传》一百"},"similar":["情同手足","情同骨肉"],"usage":"作谓语、定语；用于人际关系"},{"id":19523,"word":"情同手足","pinyin":"qíng tóng shǒu zú","abbr":"qtsz","explanation":"手足：比喻兄弟。交情很深，如同兄弟一样。","source":{"text":"谁无兄弟，如足如手。","book":"唐·李华《吊古战场文》"},"example":{"text":"名虽各姓，～。","book":"明·许仲琳《封神演义》第四十一回"},"similar":["情逾骨肉","亲如手足","情同骨肉"],"opposite":["势如冰炭","势不两立"],"usage":"作谓语、定语；指感情深厚"},{"id":19524,"word":"情同羊左","pinyin":"qíng tóng yáng zuǒ","abbr":"qtyz","explanation":"交情深厚，愿为对方去死。多指生死之交。","source":{"text":"想惠庄之清尘，庶羊左之徽烈。","book":"南朝·梁·刘峻《广绝交论》"},"similar":["情同手足"],"usage":"作谓语、定语；指感情深厚","story":["传说春秋时期，羊角哀与左伯桃两人同往投奔楚王，路上遭遇大雨雪，左伯桃把衣服和粮食都给了羊角哀，自己爬进空树洞冻饿而死；羊角哀到楚国被拜为上卿，一次梦见左伯桃为厉鬼所欺陵，立即自刎而死，赶往九泉之下助左伯桃战胜厉鬼"]},{"id":19525,"word":"情同骨肉","pinyin":"qíng tóng gǔ ròu","abbr":"qtgr","explanation":"骨肉：指父母兄弟子女等亲人。形容关系密切如一家人。","source":{"text":"我与公覆（黄盖），情同骨肉，径来为献密书。","book":"明·罗贯中《三国演义》第四十七回"},"example":{"text":"只是安某要算他老人家第一个得意学生，分虽师生，～。","book":"清·文康《儿女英雄传》第十九回"},"similar":["情逾骨肉","亲如手足","情同手足"],"opposite":["势如冰炭","势不两立"],"usage":"作谓语、定语；形容关系密切如一家人"},{"id":19526,"word":"情同鱼水","pinyin":"qíng tóng yú shuǐ","abbr":"qtys","explanation":"情谊如鱼得水。形容彼此深情相依，不可分离。","source":{"text":"郎君幽婚，情同鱼水。岂不念父母追悼乎？","book":"宋·无名氏《异闻总录·房州司理男》"},"example":{"text":"业本孤客，为我家所拥立，彼得我兄弟，～，人既亲我，我不应背人，背人不祥。","book":"蔡东藩《两晋演义》第八十七回"},"usage":"作谓语、定语；用于两者的关系"},{"id":19527,"word":"情善迹非","pinyin":"qíng shàn jì fēi","abbr":"qsjf","explanation":"感情融洽，但是所走的道路并非一致。","source":{"text":"而人之行，有情善而迹非。","book":"宋·苏辙《寄欧阳舍人书》"}},{"id":19528,"word":"情在骏奔","pinyin":"qing zhai jun ben","abbr":"qzjb","explanation":"一心急着去奔丧。"},{"id":19529,"word":"情坚金石","pinyin":"qíng jiān jīn shí","abbr":"qjjs","explanation":"彼此感情像金石一样牢固。","source":{"text":"情坚金石，始终不改。","book":"元·宫大用《范张鸡黍》第一折"},"usage":"作谓语、定语；用于朋友间等"},{"id":19530,"word":"情天孽海","pinyin":"qíng tiān niè hǎi","abbr":"qtnh","explanation":"孽：罪恶。天大的情欲，罪孽的深渊。旧指男女深深地陷入情海。","source":{"text":"贵族之女，俱属从情天孽海而来。","book":"清·曹雪芹《红楼梦》第一百二十回"},"usage":"作宾语；指感情债"},{"id":19531,"word":"情天泪海","pinyin":"qíng tiān lèi hǎi","abbr":"qtlh","explanation":"形容一味沉溺于感伤的爱情世界。","source":{"text":"取无数高领窄袖花冠长裙之新人物，相与歌泣，于情天泪海之世界。","book":"金松岑《论写情小说于新社会之关系》"},"usage":"作宾语、定语；用于文章等"},{"id":19532,"word":"情孚意合","pinyin":"qíng fú yì hé","abbr":"qfyh","explanation":"形容双方思想感情融洽，合得来。同“情投意合”。","source":{"text":"我如今却和你眷恋日久，情孚意合，却不恁地理会。","book":"明·施耐庵《水浒传》第25回"},"example":{"text":"他们是三载同窗，～。"},"similar":["情投意合"],"usage":"作谓语、定语；指投合"},{"id":19533,"word":"情巧万端","pinyin":"qíng qiǎo wàn duān","abbr":"qqwd","explanation":"情巧：真伪。形容军事上真真假假的计谋奇策，变化多端。","source":{"text":"夫水战千里，情巧万端。越为三军，吴曾不御；汉潜夏阳，魏豹不意。江河虽广，其长难卫也。","book":"汉·阮瑀《为曹公作书与孙权》"}},{"id":19534,"word":"情急智生","pinyin":"qíng jí shēng zhì","abbr":"qjzs","explanation":"情况紧急时，突然想出应变的好办法。","source":{"text":"汤升情急智生，忽然想出一条注意。","book":"清·李宝嘉《官场现形记》第22回"},"example":{"text":"立在右侧，初颇惶惑，继则～，信口开河。","book":"郭沫若《棠棣之花》第五幕"},"similar":["急中生智","随机应变"],"opposite":["束手无策","一筹莫展"],"usage":"作谓语、定语、分句；指急中生智"},{"id":19535,"word":"情恕理遣","pinyin":"qíng shù lǐ qiǎn","abbr":"qslq","explanation":"恕：原谅；遣：排遣。以情相恕，以理排遣。指待人接物宽厚和平，遇事不加计较。","source":{"text":"玠尝以人有不及，可以情恕；非意相干，可以理遣，故终身不见喜愠之容。","book":"《晋书·卫玠传》"},"example":{"text":"～古所难，何以报之用恶客。","book":"清·孙枝蔚《次韵答莫大岸见嘲》"},"usage":"作宾语、定语；指待人接物宽厚和平"},{"id":19536,"word":"情意绵绵","pinyin":"qíng yì mián mián","abbr":"qymm","explanation":"情意：对人的感情。绵绵：延续不断的样子。形容情意深长，不能解脱。","source":{"text":"何况情意绵绵，藕断丝不断。","book":"周恩来《别李愚如并示述弟》"},"example":{"text":"我喜欢她那～的样子。"},"usage":"作谓语、定语；指情意很深"},{"id":19537,"word":"情投契合","pinyin":"qíng tóu qì hé","abbr":"qtqh","explanation":"形容双方思想感情融洽，合得来。同“情投意合”。","source":{"text":"两下挑灯对坐，彼此倾心吐胆，各道生平志愿，情投契合，遂为至交。","book":"明·冯梦龙《醒世恒言》第30卷"},"similar":["情投意合"],"opposite":["貌合神离"],"usage":"作谓语、定语；指投合"},{"id":19538,"word":"情投意合","pinyin":"qíng tóu yì hé","abbr":"qtyh","explanation":"投：相合。形容双方思想感情融洽，合得来。","source":{"text":"那镇元子与行者结为兄弟，两人情投意合。","book":"明·吴承恩《西游记》第二十七回"},"example":{"text":"我们相聚既久，～，岂不知远别为悲？","book":"清·李汝珍《镜花缘》第六十八回"},"similar":["心心相印","情同手足","志同道合"],"opposite":["同床异梦","貌合神离"],"usage":"作谓语、定语；指投合","story":["南宋女词人李清照在丈夫赵明诚死后为逃避战火来到江南桃花坞，很多崇拜她的文人前来拜访她。有一年她用红梅花粘出上联“独梅隆冬遗孀户”，杏花村秀才明白其意，第二年用杏花粘上下联“杏林春暖第一家”。从此两人情投意合地生活"]},{"id":19539,"word":"情投意和","pinyin":"qíng tóu yì hé","abbr":"qtyh","explanation":"投：契合。形容双方感情融洽，心意完全一致。亦作“情孚意合”、“意同情合”、“情投意洽”、“情亲意合”、“意合情投”、“情投气合”。"},{"id":19540,"word":"情投意忺","pinyin":"qíng tóu yì xiān","abbr":"qtyx","explanation":"双方感情和心意都很投合。","source":{"text":"忆王孙，乍交欢，情投意忺，永远效鹣鹣。","book":"明·陈铎《锦庭乐·春怨》套曲"},"similar":["情投意和","情投谊合"],"usage":"作谓语、定语；指投合"},{"id":19541,"word":"情投意洽","pinyin":"qíng tóu yì qià","abbr":"qtyq","explanation":"情感融洽，心意相通。亦作情投意合。指双方思想感情很融洽。","source":{"text":"三人谈笑饮酒，正说得情投意洽，忽见抱琴进来道：‘外面刘相公来访。’三人听见，各不欢喜。","book":"明·刘璋《飞花艳想》第一回"},"example":{"text":"二公～，也都有了三分酒意。","book":"清·李绿园《歧路灯》第九回"},"similar":["情投意和","情投意忺"],"usage":"作谓语、定语；指投合"},{"id":19542,"word":"情投谊合","pinyin":"qíng tóu yì hé","abbr":"qtyh","explanation":"双方感情和心意都很投合。","source":{"text":"我天生顽鲁，狂放粗豪。性别形殊，一冰一炭，情投谊合，如漆如胶。","book":"清·徐大椿《洄溪道情·祭顾碧筠》"},"similar":["情投意合"],"usage":"作谓语、定语；指投合"},{"id":19543,"word":"情文并茂","pinyin":"qíng wén bìng mào","abbr":"qwbm","explanation":"指文章的思想感情丰富，文辞也很美盛。","source":{"text":"桐邑杨米人曾为二姬作《双珠记传奇》，情文并茂。","book":"清·珠泉居士《续板桥杂记·二汤》"},"example":{"text":"这是一篇～的文章。"},"usage":"作谓语、定语；用于文章等"},{"id":19544,"word":"情文相生","pinyin":"qíng wén xiāng shēng","abbr":"qwxs","explanation":"情：思想感情；文：词藻。比喻文章感情深沉，文采和思想互相补充。","source":{"text":"孙子荆除妇服，作诗以示王武子。王曰：‘未知文生于情，情生于文，览之凄然，增伉俪之重。’","book":"南朝·宋·刘义庆《世说新语·文学》"}},{"id":19545,"word":"情景交融","pinyin":"qíng jǐng jiāo róng","abbr":"qjjr","explanation":"指文艺作品中环境的描写、气氛的渲染跟人物思想感情的抒发结合得很紧密。","source":{"text":"离情当如此作，全在情景交炼，得言外意。","book":"宋·张炎《词源·离情》"},"example":{"text":"好的诗篇必然是～，理在其中。"},"similar":["触景生情","情文并茂"],"opposite":["格格不入"],"usage":"作谓语、宾语、定语；用于文学作品"},{"id":19546,"word":"情有可原","pinyin":"qíng yǒu kě yuán","abbr":"qyky","explanation":"按情理，有可原谅的地方。","source":{"text":"光之所至，情既可原，而守阙连年，终不见理。","book":"《后汉书·霍胥传》"},"example":{"text":"他既不是存心去参加，似乎～。","book":"叶圣陶《一个练习生》"},"similar":["合情合理","无可非议"],"opposite":["情理难容","不可思议"],"usage":"作谓语、分句；指值得原谅"},{"id":19547,"word":"情有独钟","pinyin":"qíng yǒu dú zhōng","abbr":"qydz","explanation":"钟：汇聚，专注。对某一事物特别喜欢。","example":{"text":"他对电脑编程～。"},"usage":"作谓语、定语；指专爱"},{"id":19548,"word":"情根欲种","pinyin":"qíng gēn yù zhǒng","abbr":"qgyz","explanation":"比喻男女之间的恋情。","source":{"text":"当此地覆天翻，还恋情根欲种，岂不可笑。","book":"清·孔尚任《桃花扇·入道》"}},{"id":19549,"word":"情根爱胎","pinyin":"qíng gēn ài tāi","abbr":"qgat","explanation":"情生根爱结胎。形容爱情根深蒂固。","source":{"text":"舍烟花旧寨，舍烟花旧寨，情根爱胎，何时清败！","book":"清·孔尚任《桃花扇·逃难》"},"usage":"作宾语、定语；用于爱情"},{"id":19550,"word":"情深一往","pinyin":"qíng shēn yī wǎng","abbr":"qsyw","explanation":"指对人或事物具有深厚的感情。","source":{"text":"茅名兆儒，一字雪鸿，浙江钱塘人，孤介自持，情深一往。","book":"清·王晫《今世说·豪爽》"},"similar":["一往情深"],"usage":"作谓语、定语、状语；指人对人或物"},{"id":19551,"word":"情深一网","pinyin":"qíng shēn yī wǎng","abbr":"qsyw","explanation":"一往：一直，始终。指对人或对事物顷注了很深的感情，向往而不能克制。","source":{"text":"桓子野每闻清歌。辄唤奈何！谢公闻之曰：‘子野可谓一往有深情。’","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":19552,"word":"情深义厚","pinyin":"qíng shēn yì hòu","abbr":"qsyh","explanation":"情感恩义极为深厚。","source":{"text":"且自顷之顾，绸缪往来，情深义重，著于人士之口。","book":"晋·温峤《重与陶侃书》"},"example":{"text":"往虽与和，犹是二国，今作君臣，便成一体。～，朕甚嘉之。","book":"《隋书·突厥传》"}},{"id":19553,"word":"情深义重","pinyin":"qíng shēn yì zhòng","abbr":"qsyz","explanation":"指情感深远、恩义厚重。","source":{"text":"且自顷之顾，绸缪往来，情深义重，著于人士之口。","book":"晋·温峤《重与陶侃书》"},"example":{"text":"那～的也不过临风对月，洒泪悲啼。","book":"清·曹雪芹《红楼梦》第一百十三回"},"similar":["情深意重"],"usage":"作宾语、定语；指人重感情"},{"id":19554,"word":"情深伉俪","pinyin":"qíng shēn kàng lì","abbr":"qskl","explanation":"伉俪：夫妻，配偶。夫妻之间的感情深厚。","source":{"text":"盖圣德仁厚，加以中宫前后同忧患者积年，伉俪情更加笃挚。","book":"明·沈得符《万历野获编》"},"example":{"text":"时宫廷内外，还道公主～，所以有此奏请，或将来为同穴起见，特借武崇训事，同表显荣，亦未可知。","book":"蔡东藩《唐史演义》三十八回"},"similar":["伉俪情深"],"usage":"作定语、宾语；用于夫妻间"},{"id":19555,"word":"情深似海","pinyin":"qíng shēn sì hǎi","abbr":"qssh","explanation":"形容情爱深厚，像大海一样不可量。","source":{"text":"春闷好难捱，毕竟情深似海。","book":"明·崔时佩《西厢记》"},"example":{"text":"他们父女相依为命，～。"},"similar":["情深如海"],"usage":"作谓语、定语；指感情深"},{"id":19556,"word":"情深友于","pinyin":"qíng shēn yǒu yú","abbr":"qsyy","explanation":"友于：本指兄弟相爱，后亦为“兄弟的”代称。比喻情谊比兄弟之间还要深厚。","source":{"text":"谷于者，昔于说联务蓬山，出入三载，事志相得，情深于友。","book":"唐·张说《会诸友诗序》"},"similar":["情同手足"],"usage":"作谓语、定语；用于书面语"},{"id":19557,"word":"情深如海","pinyin":"qíng shēn rú hǎi","abbr":"qsrh","explanation":"感情像海一样深厚。","source":{"text":"堪爱堪爱真堪爱，鸾凤情深如海，携手上阳台，了却相思债。","book":"明·高濂《玉簪记·词媾》"},"similar":["情深似海"],"usage":"作谓语、定语；指感情深"},{"id":19558,"word":"情深意重","pinyin":"qíng shēn yì zhòng","abbr":"qsyz","explanation":"情意深重。","source":{"text":"比如男子丧了妻，或有必当续弦者，也必要续弦为是。便只是不把死的丢过不提，便是情深意重了。","book":"清·曹雪芹《红楼梦》第五十八回"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“总是委屈，难得他～，想出一条‘两头大’的路子来。”"},"similar":["情深义重"],"opposite":["薄情寡意"],"usage":"作宾语、定语；指人重感情"},{"id":19559,"word":"情深潭水","pinyin":"qíng shēn tán shuǐ","abbr":"qsts","explanation":"比喻友情深厚。","source":{"text":"桃花潭水深千尺，不及汪伦送我情。","book":"唐·李白《赠汪伦》诗"}},{"id":19560,"word":"情深骨肉","pinyin":"qíng shēn gǔ ròu","abbr":"qsgr","explanation":"骨肉：比喻至亲。情谊比亲人还要深厚。","source":{"text":"夙蒙丞相殊眷，情深骨肉。今日之事，必以死争之。","book":"《周书·于谨传》"},"example":{"text":"感曹丘延善，～。从今去泣别离亭，须有日恩酬推毂。","book":"明·吾邱瑞《运甓记·手板击凤》"},"similar":["情逾骨肉"],"usage":"作谓语、定语；用于朋友或同事间等"},{"id":19561,"word":"情理难容","pinyin":"qíng lǐ nán róng","abbr":"qlnr","explanation":"容：容忍，宽恕。指无论在人情与事理两方面都难以容忍。","source":{"text":"孩儿每万千死罪犯公徒，那厮每情理难容。","book":"元·关汉卿《蝴蝶梦》第二折"},"example":{"text":"明知这事有些尴尬，也将来草草问成。竟不想杀人可恕，～。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["法理难容"],"opposite":["天经地义"],"usage":"作谓语、定语；指不能原谅"},{"id":19562,"word":"情真意切","pinyin":"qíng zhēn yì qiè","abbr":"qzyq","explanation":"指情意十分真切。","source":{"text":"六朝体宽无粘，韵得叶用，粘缀但情真意切，得句即佳。故‘城上草’一篇，止十三字，而意味无穷。","book":"清·吴乔《答万季埜诗问》"},"example":{"text":"那一对影子已做了半截夫妻，如今～，实是分拆不开。","book":"清·李渔《合影楼》第二回"},"similar":["真心实意"],"opposite":["虚情假意"],"usage":"作谓语、定语、状语；用于人与人之间"},{"id":19563,"word":"情礼兼到","pinyin":"qíng lǐ jiān dào","abbr":"qljd","explanation":"情感和礼节同时表露出来。形容真诚有理。","source":{"text":"敬爱既同，情理兼到。","book":"晋·袁宏《三国名臣赞》"}},{"id":19564,"word":"情窦初开","pinyin":"qíng dòu chū kāi","abbr":"qdck","explanation":"窦：孔穴；情窦：情意的发生或男女爱情萌动。指刚刚懂得爱情（多指少女）。","source":{"text":"情窦欲开先自窒，心里已净弗须锄。","book":"宋·郭印《次韵正纪见贻之计》"},"example":{"text":"我和你自～之际，就等到如今了。（清·李渔《蜃中楼·耳卜》）"},"similar":["少女怀春"],"usage":"作谓语、定语；指少男少女刚懂得爱情"},{"id":19565,"word":"情窦渐开","pinyin":"qíng dòu jiàn kāi","abbr":"qdjk","explanation":"窦：男女相爱的心窍。指少男少女逐渐懂得爱情。","source":{"text":"情窦欲开先自窒，心里已净弗须锄。","book":"宋·郭卬《次韵正纪见贻之计》"},"example":{"text":"盖人生八岁，则知识渐长，～，养之以正，则日就规矩；养之不正，则日就放逸。","book":"明·张居正《请皇太子出阁讲学疏》"},"similar":["情窦初开"],"opposite":["情窦未开"],"usage":"作谓语、定语；用于少男少女"},{"id":19566,"word":"情窦顿开","pinyin":"qíng dòu dùn kāi","abbr":"qddk","explanation":"窦：孔穴；情窦：情意的发生或男女爱情萌动。指少男少女刚开始懂得爱情。","source":{"text":"殊不知此非良策，禁防一弛，情窦顿开，如火燎原，不可扑灭。","book":"宋·袁采《袁氏示范·子弟当谨交游》"}},{"id":19567,"word":"情至意尽","pinyin":"qíng zhì yì jìn","abbr":"qzyj","explanation":"指对人的情谊已经到极点。","source":{"text":"我老夫教谏汝，其意乃款款然，情至意尽，何为汝等而未知？","book":"唐·孔颖达疏《诗·大雅·板》"},"similar":["仁至义尽"],"usage":"作谓语；指对人的情谊已经到极点"},{"id":19568,"word":"情若手足","pinyin":"qíng ruò shǒu zú","abbr":"qrsz","explanation":"手足：比喻兄弟。交情很深，如同兄弟一样。","source":{"text":"谁无兄弟，如足如手。","book":"唐·李华《吊古战场文》"},"similar":["情同手足"],"usage":"作谓语、定语；指感情深厚"},{"id":19569,"word":"情见乎言","pinyin":"qíng jiàn hū yán","abbr":"qjhy","explanation":"情感表现在言辞当中。同“情见乎辞”。","source":{"text":"夫其高吟俟时，情见乎言，志气所存，既已定于其始矣。","book":"晋·陈寿《三国志·蜀志·诸葛亮传》：“谓为信然”裴松之注"},"similar":["情见乎辞"],"usage":"作谓语、定语；指心意在言辞中显露"},{"id":19570,"word":"情见乎词","pinyin":"qíng jiàn hū cí","abbr":"qjhc","explanation":"情感表现在言辞当中。同“情见乎辞”。","source":{"text":"陈先生素来爱护《生活》的诚意，情见乎词。","book":"邹韬奋《变了什么花样？》"},"example":{"text":"邹韬奋《变了什么花样？》：“陈先生素来爱护《生活》的诚意，～。”"},"similar":["情见乎辞","情见乎言"],"usage":"作谓语、定语；指心意在言辞中显露出"},{"id":19571,"word":"情见乎辞","pinyin":"qíng xiàn hū cí","abbr":"qxhc","explanation":"见：通“现”；乎：于。情感表现在言辞当中。","source":{"text":"爻象动乎内，吉凶见乎外，功业见乎变，圣人之情见乎辞。","book":"《易·系辞下》"},"example":{"text":"若夫制作之文，所以彰往考来，～。","book":"晋·杜预《序》"},"similar":["情见乎词"],"usage":"作谓语、定语；指心意在言辞中显露出"},{"id":19572,"word":"情见于色","pinyin":"qíng jiàn yú sè","abbr":"qjys","explanation":"真情从脸色中表现出来。","source":{"text":"生甚怒之，情见于色。","book":"清·蒲松龄《聊斋志异·侠女》"},"similar":["喜形于色"],"usage":"作谓语、定语；用于人的表情"},{"id":19573,"word":"情见力屈","pinyin":"qíng xiàn lì qū","abbr":"qxlq","explanation":"情：真实情况；见：通“现”，暴露。指在军事上情况暴露而又处在劣势的地位。","source":{"text":"今足下举倦敝之兵，顿之燕坚城之下，情见力屈，欲战不拔，旷日持久，粮食单竭。","book":"《汉书·韩信传》"},"similar":["情见势屈","情见势竭"],"usage":"作谓语、定语；指真情败露"},{"id":19574,"word":"情见势屈","pinyin":"qíng xiàn shì qū","abbr":"qxsq","explanation":"情：真情；见：通“现”，暴露；势：形势；屈：屈曲。指军情已被敌方了解，又处在劣势的地位。","source":{"text":"今将军欲举倦罢之兵，顿之燕坚城之下，欲战恐久，力不能拔，情见势屈，旷日粮竭，而弱燕不服，齐必距境以自强也。","book":"《史记·淮阴侯列传》"},"example":{"text":"彼或往来迁徙，罢我驰驱。我则～，为敌所困。","book":"《明史·倪岳传》"},"similar":["情见力屈","情见势竭"],"usage":"作谓语、定语；指真情败露"},{"id":19575,"word":"情见势竭","pinyin":"qíng xiàn shì jié","abbr":"qjsj","explanation":"情：真情；见：通“现”，暴露；势：形势。指真情败露，声势衰竭。","source":{"text":"情见势竭，必将有变，此用奇之时，不可失也。","book":"南朝·宋·范晔《后汉书·荀彧传》"},"similar":["情见势屈","情见力屈"],"usage":"作谓语、定语；指真情败露"},{"id":19576,"word":"情见埶竭","pinyin":"qíng jiàn zhōu jié","abbr":"qjsj","explanation":"指军情已被敌方了解，又处在劣势的地位。同“情见势屈”。"},{"id":19577,"word":"情词悱恻","pinyin":"qíng cí fěi cè","abbr":"qcfc","explanation":"悱：心里想说却说不出。形容情感言辞凄切悲苦。","source":{"text":"若悱恻芳芳，《楚骚》为之祖。","book":"南朝·梁·裴子野《雕虫论》"},"example":{"text":"听这两首诗意，～，议论和平，这小姑娘倒是仑樵的知己。","book":"清·曾朴《孽海花》第十四回"}},{"id":19578,"word":"情趣横生","pinyin":"qíng qù héng shēng","abbr":"qqhs","explanation":"指在举止、礼貌和外表上表现得得体、风雅、有风趣。","example":{"text":"这一部～的电影耐人寻味。"},"similar":["妙趣横生"],"usage":"作谓语、定语、状语；用于人或作品"},{"id":19579,"word":"情趣相得","pinyin":"qíng qù xiāng dé","abbr":"qqxd","explanation":"情趣：性情志趣。彼此间的性情志趣投合。","source":{"text":"稚珪风韵清疏，好文咏，饮酒七八斗，与外兄张融，情趣相得。","book":"《南齐书·孔稚珪传》"},"similar":["意气相投"],"usage":"作谓语、定语；用于人际关系"},{"id":19580,"word":"情逐事迁","pinyin":"qíng zhú shì qiān","abbr":"qzsq","explanation":"情况变了，思想感情也随着起了变化。同“情随事迁”。","source":{"text":"奈情逐事迁，心随春老，梦和香冷，欢与花残。","book":"宋·孙惟信《风流子》词"},"similar":["情随事迁"],"usage":"作谓语、分句；形容人的思想感情"},{"id":19581,"word":"情逾骨肉","pinyin":"qíng yú gǔ ròu","abbr":"qygr","explanation":"逾：超过；骨肉：比喻至亲。形容感情极其深厚。","source":{"text":"弟于兄交虽道义，情逾骨肉、废弃十余年，始得一通问，可谓有人心乎？","book":"明·汤显祖《寄李季宣》"},"example":{"text":"拜识清扬，～。","book":"清·蒲松龄《聊斋志异·王六郎》"},"similar":["情投意合","情深意重"],"opposite":["无情无义","势不两立"],"usage":"作谓语、定语；指感情深"},{"id":19582,"word":"情重姜肱","pinyin":"qíng zhòng jiāng gōng","abbr":"qzjg","explanation":"比喻兄弟友爱。","source":{"text":"肱与二弟仲海、季江，俱以孝行着闻。其友爱天至，常共卧起。及各娶妻，兄弟相恋，不能别寝，以系嗣当立，乃递往就室。","book":"《后汉书·姜肱传》"}},{"id":19583,"word":"情钟我辈","pinyin":"qíng zhōng wǒ bèi","abbr":"qzwb","explanation":"钟：集中；我辈：我们，我等。我们这些人最富于情感，容易动感情。","source":{"text":"辩才遂化去，虽来去本无。而情钟我辈，不免凄怆也。","book":"宋·苏轼《答参寥二首》"},"example":{"text":"命薄佳人，～。海棠开后心如碎。斜风细雨不曾晴，倚阑滴尽胭脂泪。","book":"宋·刘辰翁《踏莎行·雨中观海棠》词"}},{"id":19584,"word":"情长纸短","pinyin":"qíng cháng zhǐ duǎn","abbr":"qczd","explanation":"简短的信纸无法写完深长的情意。形容情意深长。同“纸短情长”。","source":{"text":"情长纸短，不尽欲言，祝你们三好！","book":"冰心《寄小读者·通讯七》"}},{"id":19585,"word":"情随事迁","pinyin":"qíng suí shì qiān","abbr":"qssq","explanation":"情况变了，思想感情也随着起了变化。","source":{"text":"情随事迁，感慨系之矣。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"后来大抵带在身边，只是～，已没有翻译的意思了。","book":"鲁迅《为了忘却的记念》"},"similar":["事过境迁","情逐事迁"],"opposite":["始终不渝","一如既往"],"usage":"作谓语、分句；形容人的思想感情","story":["东晋时期，王羲之与当时的名士孙统、谢安等40人聚集在会稽山的兰亭饮酒作诗。王羲之特地把这次聚会写成《兰亭集序》：“及其所之既倦，情随事迁，感慨系之矣！向之所欣，俯仰之间，已为陈迹，犹不能不以之兴怀。”"]},{"id":19586,"word":"情随境变","pinyin":"qíng suí jìng biàn","abbr":"qsjb","explanation":"情况变了，思想感情也随着变化。","source":{"text":"情随事迁，感慨系之矣。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"而或者犹以大露病之，曾不知～，字逐情生，但恐不达，何露之有？","book":"明·袁宏道《锦帆集·叙小修诗》"},"similar":["情随事迁","情逐事迁"],"usage":"作谓语、分句；形容人的思想感情"},{"id":19587,"word":"情非得已","pinyin":"qíng fēi dé yǐ","abbr":"qfdy","explanation":"指情况出于不得已。","source":{"text":"适才躲避桌下，自知失仪露丑，实系情非得已，诸位姐姐莫要发笑。","book":"清·李汝珍《镜花缘》第62回"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“知道藩司的失仪，～。”"},"opposite":["自觉自愿"],"usage":"作宾语、定语；指不是真心"},{"id":19588,"word":"情面难却","pinyin":"qíng miàn nán què","abbr":"qmnq","explanation":"由于面子、情分的关系，很难推却。","source":{"text":"湍制台情面难却，第二天就把话传给了藩台，不到三天，牌已挂出去了。","book":"清·李宝嘉《官场现形记》第三十六回"},"example":{"text":"二则我和伯华兄知己朋友，～，并不是想什么钱。","book":"清·张春帆《九尾龟》第一百十六回"},"similar":["抹不下脸"],"usage":"作谓语、宾语、定语；用于交往"},{"id":19589,"word":"惇信明义","pinyin":"dūn xìn míng yì","abbr":"dxmy","explanation":"惇：重视；信：诚实。重视信实，明白理义。","source":{"text":"惇信明义，崇德报功。","book":"《尚书·武成》"},"example":{"text":"像这样～的人不多见了。"},"usage":"作谓语、定语；指人明白信义"},{"id":19590,"word":"惊世绝俗","pinyin":"jīng shì jué sú","abbr":"jsjs","explanation":"指卓绝特异，使世人震动。","source":{"text":"公之所为，必将惊世绝俗，使斗筲穿窬之流心破胆裂。","book":"宋·苏轼《王元之画像赞》"},"example":{"text":"他在这次研讨会上发表了～的观点"},"usage":"作谓语、定语；用于书面语"},{"id":19591,"word":"惊世震俗","pinyin":"jīng shì zhèn sú","abbr":"jszs","explanation":"世、俗：指一般人。使一般人感到惊骇。同“惊世骇俗”。","source":{"text":"今世吏者，其愚也固不知所为，而其所谓能者，务出奇为声威，以惊世震俗。","book":"宋·王安石《余姚县海塘记》"},"similar":["惊世骇俗"],"usage":"作谓语、定语；用于言行或事件等"},{"id":19592,"word":"惊世骇俗","pinyin":"jīng shì hài sú","abbr":"jshs","explanation":"世、俗：指一般人。使一般人感到惊骇。","source":{"text":"勤劳半世，汩没于章句训诂之间，黾勉于规矩绳约之内，卒无高奇深眇之见可以惊世而骇俗。","book":"宋·朱熹《答陈抑之》"},"example":{"text":"这超越自我对自然现象的理解度，这是大自然有意作出的～之举吗？","book":"薛尔康《北国秋叶》"},"similar":["惊世震俗"],"usage":"作谓语、定语、宾语；用于言行或事件等"},{"id":19593,"word":"惊世骇目","pinyin":"jīng shì hài mù","abbr":"jshm","explanation":"指使世人见而惊奇。","source":{"text":"律诗之作，用字平侧，世固有定体，众共守之。然不若时用变体，如兵之出奇，变化无穷，以惊世骇目。","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵二》"},"usage":"作谓语、定语；用于书面语"},{"id":19594,"word":"惊人之举","pinyin":"jīng rén zhī jǔ","abbr":"jrzj","explanation":"值得赞叹的、令人惊奇的、好像超出人的能力或努力所达到的事情。","source":{"text":"他过去在学校里的一些小小的‘惊人之举’，完全出于性格本身所致。","book":"路遥《平凡的世界》第四卷第35章"},"example":{"text":"我们期待你有～。"},"similar":["惊人壮举"],"usage":"作宾语；指壮举"},{"id":19595,"word":"惊叹不已","pinyin":"jīng tàn bù yǐ","abbr":"jtby","explanation":"叹：感叹；已：终结。因为惊异而发出的感叹久久不止。形容感受至深。"},{"id":19596,"word":"惊叹不止","pinyin":"jīng tàn bù zhǐ","abbr":"jtbz","explanation":"叹：感叹；止：终结。因为惊异而发出的感叹久久不止。形容感受至深。","example":{"text":"至于烟火，也是花样繁多，令人～。","book":"姚雪垠《李自成》第一卷第二十六章"}},{"id":19597,"word":"惊喜交加","pinyin":"jīng xǐ jiāo jiā","abbr":"jxjj","explanation":"两种事物同时出现或同时加在一个人身上，又惊又喜。","source":{"text":"生闻之，惊喜交集。","book":"金·董解元《西厢记》卷四"},"example":{"text":"此时忽然的骨肉团圆，～。","book":"清·文康《儿女英雄传》第八回"},"similar":["惊喜交集"],"usage":"作定语、状语；同“惊喜交集”"},{"id":19598,"word":"惊喜交集","pinyin":"jīng xǐ jiāo jí","abbr":"jxjj","explanation":"交集：一起袭来。两种事物同时出现或同时加在一个人身上，又惊又喜。","source":{"text":"生闻之，惊喜交集。","book":"金·董解元《西厢记》卷四"},"example":{"text":"正在这里，夫妻不期而遇，～。","book":"程思远《李宗仁先生晚年》第五章"},"similar":["惊喜若狂"],"opposite":["悲痛欲绝"],"usage":"作定语、状语；指又惊又喜"},{"id":19599,"word":"惊喜欲狂","pinyin":"jīng xǐ ruò kuáng","abbr":"jxyk","explanation":"既惊又喜，高兴得都要发疯了。形容喜出望外，过于兴奋的情壮。","source":{"text":"胡惊喜欲狂，即与偕入室，夜分乃去。","book":"宋·洪迈《夷坚志·乙志卷九·胡氏子》"},"example":{"text":"彩云倒出于意外，自然～，不觉绸缪备至。","book":"清·曾朴《孽海花》第三十回"},"similar":["惊喜若狂"],"usage":"作谓语、宾语；形容喜出望外"},{"id":19600,"word":"惊喜若狂","pinyin":"jīng xǐ ruò kuáng","abbr":"jxrk","explanation":"形容又惊又喜，难以自持。","source":{"text":"少年得其应答，惊喜若狂。","book":"清·和邦额《夜谭随录·护军女》"},"example":{"text":"他意外见到阔别多年的好友真是～。"},"similar":["惊喜交集","惊喜欲狂"],"opposite":["悲痛欲绝"],"usage":"作谓语、宾语；形容喜出望外"},{"id":19601,"word":"惊天动地","pinyin":"jīng tiān dòng dì","abbr":"jtdd","explanation":"惊：惊动；动：震撼。使天地惊动。形容某个事件的声势或意义极大。","source":{"text":"可怜荒冢穷泉骨，曾有惊天动地文。","book":"唐·白居易《李白墓》诗"},"example":{"text":"比前番在梁山泊上更觉轰轰烈烈，做出～的事业来，功垂竹帛，世享荣华。","book":"清·陈忱《水浒后传》第一回"},"similar":["震天动地","震天撼地"],"opposite":["万籁俱寂"],"usage":"作谓语、宾语、定语；指声音或声势","story":["人格最高、能力最强的人做事时应该声势浩大、远近闻名。一个有高尚道德、崇高理想和本领高强的人应该要做一番惊天动地的大事业。明朝郎瑛在《七修类稿》中阐述：“御史初至则曰惊天动地，过几月则曰错天黑地；去时则曰寞天寂地。”"]},{"id":19602,"word":"惊天地泣鬼神","pinyin":"jīng tiān dì qì guǐ shén","abbr":"jtdqgs","explanation":"惊：震惊。使天地为之震惊，使鬼神为之哭泣。","source":{"text":"然则匹妇虽微，及其精诚所激，往往动天地，泣鬼神，何可忽也？","book":"清·汪琬《烈妇周氏墓表》"},"example":{"text":"我国历史上有许多～的故事。"},"similar":["惊天动地"],"usage":"作谓语、定语；指使人震惊"},{"id":19603,"word":"惊天地，泣鬼神","pinyin":"jīng tiān dì，qì guǐ shén","abbr":"jtdqgs","explanation":"使天地为之震惊，使鬼神为之哭泣。","source":{"text":"然则匹妇虽微，及其精诚所激，往往动天地，泣鬼神，何可忽也？","book":"清·汪琬《烈妇周氏墓表》"}},{"id":19604,"word":"惊师动众","pinyin":"jīng shī dòng zhòng","abbr":"jsdz","explanation":"师：众人。比喻惊动很多人来做一件事。","source":{"text":"只怕燕窝我们家里还有，与你送几两。每日叫丫头们就熬了，又便宜，又不惊师动众的。","book":"清·曹雪芹《红楼梦》第四十五回"},"example":{"text":"对付三个手无寸铁的老人，何必这样惊师动众！","book":"季羡林《牛棚杂忆》第七节"},"similar":["兴师动众"],"usage":"作谓语、宾语；指惊动很多人"},{"id":19605,"word":"惊弓之鸟","pinyin":"jīng gōng zhī niǎo","abbr":"jgzn","explanation":"被弓箭吓怕了的鸟不容易安定。比喻经过惊吓的人碰到一点动静就非常害怕。","source":{"text":"黩武之众易动，惊弓之鸟难安。","book":"《战国策·楚策四》；《晋书·王鉴传》"},"example":{"text":"绍闻是～，吓了一跳。","book":"清·李绿园《歧路灯》第八十一回"},"similar":["伤弓之鸟","漏网之鱼"],"opposite":["初生牛犊"],"usage":"作主语、宾语；指受过惊吓的人","story":["从前精通射箭的更赢和魏王谈论箭术，刚好一只大雁由东向西飞过，更赢拉弓便射，可惜虚发一箭，谁知大雁应声落地。魏王不解，更赢说：“这只受伤的大雁离了群，飞得低，听到弓弦响，吓得不知道怎么办，一用力伤口破裂而掉地。”"]},{"id":19606,"word":"惊弦之鸟","pinyin":"jīng xián zhī niǎo","abbr":"jxzn","explanation":"比喻经过惊吓的人碰到一点动静就非常害怕。同“惊弓之鸟”。","source":{"text":"败军之将，不可以语勇，惊弦之鸟，不可以应弓。","book":"《榖梁传·成公二年》：“齐侯使国佐如师”唐·杨士勋疏"},"example":{"text":"但唐公是～，犹自不敢放胆。","book":"清·褚人获《隋唐演义》第五回"},"similar":["惊弓之鸟"],"usage":"作主语、宾语；指受过惊吓的人","story":["从前精通射箭的更赢和魏王谈论箭术，刚好一只大雁由东向西飞过，更赢拉弓便射，可惜虚发一箭，谁知大雁应声落地。魏王不解，更赢说：“这只受伤的大雁离了群，飞得低，听到弓弦响，吓得不知道怎么办，一用力伤口破裂而掉地。”"]},{"id":19607,"word":"惊心丧魄","pinyin":"jīng xīn sàng pò","abbr":"jxsp","explanation":"形容十分恐惧。亦作“惊心褫魄”。","source":{"text":"诵吾之言，有不惊心丧魄、手战股栗者，非君也。","book":"清·唐甄《潜书·远谏》"},"similar":["失魂丧魄"],"usage":"作谓语、定语；用于恐惧时"},{"id":19608,"word":"惊心动魄","pinyin":"jīng xīng dòng pò","abbr":"jxdp","explanation":"使人神魂震惊。原指文辞优美，意境深远，使人感受极深，震动极大。后常形容使人十分惊骇紧张到极点。","source":{"text":"文温以丽，意悲而远，惊心动魄，可谓几乎一字千金。","book":"南朝·梁·钟嵘《诗品》卷上"},"example":{"text":"只听跑上几个人去，把椤子往地下一摔，霍绰的一声，～。","book":"清·刘鹗《老残游记》第十六回"},"similar":["动魄惊心","心惊肉跳","触目惊心"],"opposite":["泰然自若","见怪不怪","习以为常"],"usage":"作谓语、定语、状语；用于说明事物","story":["春秋时期，越国想灭吴国，便搜集天下的奇珍异宝、珍味佳肴献给吴王，同时还把西施、郑旦两位美人献给吴王。吴王把两位美人安置在椒房内，美人并肩而坐，偷窥者莫不惊心动魄。吴王被她们迷住了，越军进攻吴国，吴王带两位美人狼狈逃跑"]},{"id":19609,"word":"惊心吊胆","pinyin":"jīng xīn diào dǎn","abbr":"jxdd","explanation":"形容十分害怕或担心。","source":{"text":"可不是，我们在这里也是惊心吊胆。","book":"清·曹雪芹《红楼梦》第一一二回"},"example":{"text":"天亮的时候，他就～的走下楼来。","book":"郁达夫《沉沦》"},"similar":["惊心掉胆","提心吊胆"],"usage":"作宾语、定语、状语；用于恐惧时"},{"id":19610,"word":"惊心吊魄","pinyin":"jīng xīn diào pò","abbr":"jxdp","explanation":"形容使人十分惊骇紧张到极点。同“惊心动魄”。","source":{"text":"将登山临水，总是惊心吊魄之场。","book":"清·无名氏·《惧内供状》"},"similar":["惊心动魄"],"usage":"作谓语、定语；用于说明事物"},{"id":19611,"word":"惊心夺目","pinyin":"jīng xīn duó mù","abbr":"jxdm","explanation":"指内心震动很大，引起非常注意。","source":{"text":"使我中国女界中放一光明灿烂之异彩，使全球人种惊心夺目，拍手而欢呼。","book":"清·秋瑾《〈中国女报〉发刊词》"},"usage":"作谓语、定语；用于声势或感触等"},{"id":19612,"word":"惊心怵目","pinyin":"jīng xīn chù mù","abbr":"jxcm","explanation":"指看到后内心感到震惊。同“惊心骇瞩”。","source":{"text":"此书识字男女，人人爱阅。如今批了出来，准科学的学理，以指中国家庭的种种症结，使人阅之，惊心怵目。","book":"季新《红楼梦新评》"},"similar":["触目惊心"],"usage":"作谓语、定语；用于事情等"},{"id":19613,"word":"惊心悲魄","pinyin":"jīng xīn bēi pò","abbr":"jxbp","explanation":"指使人心中震动和悲哀。","source":{"text":"是杀人之日有数途，生人之岁无一理，不知复百年间，将尽以草木为世邪，此最是惊心悲魄恸哭太息者。","book":"《宋书·周朗传》"},"usage":"作谓语、定语；用于人或事情等"},{"id":19614,"word":"惊心悼胆","pinyin":"jīng xīn dào dǎn","abbr":"jxdd","explanation":"悼：战栗。形容恐惧到极点。","source":{"text":"今人言惧，犹曰惊心悼胆。","book":"章炳麟《新方言·释言》卷上"},"similar":["惊心吊胆"],"usage":"作谓语、宾语；形容恐惧到极点"},{"id":19615,"word":"惊心惨目","pinyin":"jīng xīn cǎn mù","abbr":"jxcm","explanation":"眼见之后内心震动，感到悲惨。","source":{"text":"髑髅累累，杂骨如竹头木屑，堆置墙角如阜……不禁惊心惨目。","book":"清·俞蛟《梦厂杂著·春明丛说·人骨箸记》"},"example":{"text":"数种祸～，述阴谋暮鼓晨钟。","book":"清·陈天华《狮子吼》第一回回目"},"usage":"作谓语、定语；用于书面语"},{"id":19616,"word":"惊心掉胆","pinyin":"jīng xīn diào dǎn","abbr":"jxdd","explanation":"惊：惊吓；掉：恐惧，战栗。形容十分害怕或担心。","source":{"text":"今人言惧犹曰惊心掉胆。","book":"章炳麟《新方言·释言》"},"similar":["惊心吊胆"],"usage":"作宾语、定语、状语；用于恐惧时"},{"id":19617,"word":"惊心眩目","pinyin":"jīng xīn xuàn mù","abbr":"jxxm","explanation":"震动人心，耀人眼目。","source":{"text":"谓之天书。字方一丈，八角垂芒，光辉照耀，惊心眩目，虽诸天仙，不能省视。","book":"《隋书·经籍志四》"},"usage":"作谓语、定语；用于人或事情等"},{"id":19618,"word":"惊心破胆","pinyin":"jīng xīn pò dǎn","abbr":"jxpd","explanation":"指内心十分震惊、恐惧。","source":{"text":"故凡欲变风改俗者，其行赏罚者也，必使足惊心破胆，民乃易视。","book":"汉·王符《潜力夫·论三式》"},"similar":["惊心裂胆"],"usage":"作谓语、定语、宾语；用于恐惧时"},{"id":19619,"word":"惊心裂胆","pinyin":"jīng xīn liè dǎn","abbr":"jxld","explanation":"指内心十分震惊、恐惧。同“惊心破胆”。","source":{"text":"他来上海也已经有两三天了，然而在前线炮火中的惊心裂胆，以及误陷入敌阵被俘那时候的忧疑委屈，还不曾完全从他脑膜上褪去。","book":"茅盾《子夜》十四"},"similar":["惊心破胆"],"usage":"作谓语、定语、宾语；用于恐惧时"},{"id":19620,"word":"惊心褫魄","pinyin":"jīng xīn chǐ pò","abbr":"jxcp","explanation":"形容十分恐惧。同“惊心丧魄”。","source":{"text":"世方惊心褫魄，我独燕处超然。","book":"明·焦竑《焦氏笔乘·支谈下》"},"usage":"作谓语、定语；用于书面语"},{"id":19621,"word":"惊心骇目","pinyin":"jīng xīn hài mù","abbr":"jxhm","explanation":"指看到后内心感到震惊。同“惊心骇瞩”。","source":{"text":"连日宝山兵勇陆续回苏，昨穿城走者数十人……孙邑尊讯供后，转送抚宪，传询押解回沪，众各惊心骇目。","book":"《上海小刀会起义史料汇编·忆昭楼洪杨奏稿》"},"example":{"text":"爰就所言，略加评语。不学如余，固不能直揭其隐，亦聊为读者～，不为所惑之一助云尔。","book":"达时《夫巳氏之支那观》"},"similar":["惊心骇神"],"usage":"作谓语、定语；用于处事"},{"id":19622,"word":"惊心骇瞩","pinyin":"jīng xīn hài zhǔ","abbr":"jxhz","explanation":"指看到后内心感到震惊。","source":{"text":"降死之生，诚为轻法，然人情慎显而轻昧，忽远而惊近，是以盘盂有铭，韦弦作佩，况在小人，尤其所或目所不睹，则忽而不戎，日陈于前，则惊心骇瞩。","book":"《宋书·孔琳之传》"},"similar":["惊心骇神","惊心骇目"],"usage":"作谓语、定语；用于处事"},{"id":19623,"word":"惊心骇神","pinyin":"jīng xīn hài shén","abbr":"jxhs","explanation":"指内心感到十分震惊。","source":{"text":"护弥曰：‘佛者不是凡人……奕弈尊荣，盖鸾凤之苗嫡。’须达闻说，惊心骇神，渴仰之情，不离心腑。","book":"《敦煌变文集·降魔变文》"},"similar":["惊心骇目","惊心骇瞩"],"usage":"作谓语、定语；用于处事"},{"id":19624,"word":"惊恐万状","pinyin":"jīng kǒng wàn zhuàng","abbr":"jkwz","explanation":"惊恐：害怕；万状：各种样子，表示程度极深。形容害怕到了极点。","source":{"text":"忧患百罹而未艾，惊惶万状而莫支。","book":"宋·陈亮《谢杨解元启》"},"example":{"text":"大家定睛看时，原来是一群野雉，象是大敌袭来，～地向南飞去。","book":"曲波《林海雪原》三十四"},"similar":["胆战心惊","心惊胆战"],"opposite":["不动声色","处之泰然"],"usage":"作谓语、定语、状语；指害怕"},{"id":19625,"word":"惊恐失措","pinyin":"jīng kǒng shī cuò","abbr":"jksc","explanation":"措：安排。害怕得脸都变了色。","source":{"text":"我和他惊恐失措地互相看着。","book":"都德《柏林之围》"},"similar":["惊惶失措"],"opposite":["镇定自若"],"usage":"作定语、状语；指害怕"},{"id":19626,"word":"惊恐失色","pinyin":"jīng kǒng shī sè","abbr":"jkss","explanation":"害怕得脸都变了色。","source":{"text":"契丹以马军万人拒之于前，将士皆惊愕失色。","book":"《新编五代史平话·唐史》卷上"},"example":{"text":"满朝文武见皇帝如此震怒，个个～，替黄道周捏了一把冷汗。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["惊恐失措"],"opposite":["镇定自若"],"usage":"作定语、状语；指害怕"},{"id":19627,"word":"惊悸不安","pinyin":"jīng jì bù ān","abbr":"jjba","explanation":"悸：心跳。惊慌心跳，不能安宁。","source":{"text":"虽则无人，心实惊悸不安。","book":"清·褚人获《隋唐演义》第四十六回"},"example":{"text":"多情的女孩子，被她朋友的痛苦吓住了，她显得比道静更加～。","book":"杨沫《青春之歌》第二章"}},{"id":19628,"word":"惊惶万状","pinyin":"jīng huáng wàn zhuàng","abbr":"jhwz","explanation":"惊惶：害怕；万状：各种样子，表示程度极深。形容害怕到了极点。","source":{"text":"忧患百罹而未艾，惊惶万状而莫支。","book":"宋·陈亮《谢杨解元启》"},"similar":["惊恐万状"],"usage":"作谓语、状语；用于恐惧时"},{"id":19629,"word":"惊惶不安","pinyin":"jīng huáng bù ān","abbr":"jhba","explanation":"由于惊慌，一下子不知怎么办才好。","source":{"text":"孝友临刑，惊慌失措，晖业神色自若。","book":"《北齐书·元晖业传》"},"example":{"text":"但为了怕刚有些懂人事的小皇帝～，所以不愿召见弘德殿的师傅。","book":"高阳《玉座珠帘》十五"}},{"id":19630,"word":"惊惶失措","pinyin":"jīng huáng shī cuò","abbr":"jhsc","explanation":"失措：失去常态。由于惊慌，一下子不知怎么办才好。","source":{"text":"（元）孝友临刑，惊慌失措，晖业神色自若。","book":"《北齐书·元晖业传》"},"example":{"text":"少卿虚心病，元有些怕见他的，亦且出于不意，不觉～。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"similar":["惊慌失措","手足无措","心慌意乱"],"opposite":["镇定自若","从容不迫","不动声色"],"usage":"作谓语、定语、状语、补语；指惊慌惶恐","story":["南北朝时期，北魏景穆帝的玄孙元晖业为人正直，十分有骨气。北魏被北齐所灭后，齐神武帝将魏孝武帝的皇后嫁给魏孝庄帝的侄子元韶。元晖业当着齐文宣帝痛骂元韶，被齐文宣帝下令处死，同时还有元孝友，孝友吓得惊惶失措。元晖业神色自若从容就义"]},{"id":19631,"word":"惊惶失色","pinyin":"jīng huáng shī sè","abbr":"jhss","explanation":"惊慌之极而面目变色。","source":{"text":"司徒称名大呼，以手触扃。从官偕至者，动以百骑，惊惶失色","book":"元·孔齐《至正直记·罗太无高节》"},"similar":["惊慌失色"],"usage":"作谓语、状语；指人很惊恐"},{"id":19632,"word":"惊惶无措","pinyin":"jīng huáng wú cuò","abbr":"jhwc","explanation":"由于惊慌，一下子不知怎么办才好。","source":{"text":"（元）孝友临刑，惊慌失措，晖业神色自若。","book":"《北齐书·元晖业传》"},"example":{"text":"告以连称作乱之事。遂造寝室，告于襄公。襄公～。","book":"明·冯梦龙《东周列国志》第十四回"},"similar":["惊惶失措"],"usage":"作定语、状语、补语；指惊慌"},{"id":19633,"word":"惊愕失色","pinyin":"jīng è shī sè","abbr":"jess","explanation":"失色：由于受惊或害怕而面色苍白。惊恐得改变了神色。形容十分吃惊。","source":{"text":"契丹以马军万人拒之于前，将士皆惊愕失色。","book":"《新编五代史平话·唐史·上卷》"},"example":{"text":"这话登时传到宋良箴耳内，吓得～，泪落不止。","book":"清·李汝珍《镜花缘》第五十九回"},"similar":["惊慌失色"],"usage":"作谓语、状语；指十分吃惊"},{"id":19634,"word":"惊愚骇俗","pinyin":"jīng yú hài sú","abbr":"jyhs","explanation":"使愚昧鄙俗之人感到震惊。","source":{"text":"神或附人称马子，惊愚骇俗走相使。","book":"清·李绂《裕州观祷雨》诗"},"usage":"作宾语、定语；用于书面语"},{"id":19635,"word":"惊慌失措","pinyin":"jīng huāng shī cuò","abbr":"jhsc","explanation":"失措：失去常态。由于惊慌，一下子不知怎么办才好。","source":{"text":"（元）孝友临刑，惊慌失措，晖业神色自若。","book":"《北齐书·元晖业传》"},"example":{"text":"遇到危险情况，应该沉着冷静，不要～。"},"similar":["惊惶失措","张皇失措"],"opposite":["泰然自若","谈笑自若","处处泰然"],"usage":"作谓语、状语；指不知所措","story":["南北朝时期，北魏景穆帝的玄孙元晖业为人正直，十分有骨气。北魏被北齐所灭后，齐神武帝将魏孝武帝的皇后嫁给魏孝庄帝的侄子元韶。元晖业当着齐文宣帝痛骂元韶，被齐文宣帝下令处死，同时还有元孝友，孝友吓得惊惶失措。元晖业神色自若从容就义"]},{"id":19636,"word":"惊慌失色","pinyin":"jīng huāng shī sè","abbr":"jhss","explanation":"惊慌之极而面目变色。","source":{"text":"倪太守正与倪忠毫无主意，看见开门，以为恶奴前来陷害，不由的惊慌失色。","book":"清·石玉昆《三侠五义》第七十三回"},"example":{"text":"次日，燕紫琼、宰玉蟾闻得丈夫又困在阵内，吓的～，坐立不宁。","book":"清·李汝珍《镜花缘》第九十九回"},"similar":["惊慌失措"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；指十分吃惊"},{"id":19637,"word":"惊慌无措","pinyin":"jīng huāng wú cuò","abbr":"jhwc","explanation":"由于惊慌，一下子不知怎么办才好。同“惊惶失措”。","source":{"text":"这谣言传的凶……一家人惊慌无措。","book":"清·蒲松龄《翻魇殃》第十二回"},"example":{"text":"清·钱彩《说岳全传》第40回：“吓得太太～，李夫人面面相觑，无计可施。”"},"similar":["惊慌失措"],"opposite":["泰然自若"],"usage":"作谓语、状语；指不知所措"},{"id":19638,"word":"惊才绝绝","pinyin":"jīng cái jué jué","abbr":"jcjj","explanation":"形容才华惊人，文辞瑰丽。","source":{"text":"《卜居》标放言之致，《渔父》寄独往之才，故能气往轹古，辞来切今，惊采绝绝，难与并能矣。","book":"南朝·梁·刘勰《文心雕龙·辨骚》"},"example":{"text":"李长吉～，锵宫戛羽，下视东野，真乃蚯蚓窍中苍蝇鸣耳。","book":"清·翁方纲《石洲诗话》卷二"}},{"id":19639,"word":"惊才绝艳","pinyin":"jīng cái jué yàn","abbr":"jcjy","explanation":"形容才华惊人，文辞瑰丽。","source":{"text":"英初本惊才绝艳，而近作大不如前，同人比之江郎才尽。","book":"清·王晫《今世说·企羡》：“彭羡门惊才绝艳，词家推为独步。”清·梁章钜《浪迹丛谈·刘英初编修》"},"example":{"text":"不知堕向泥犁者，可有～词。","book":"清·舒位《鬼》诗"},"similar":["惊采绝艳"],"usage":"作谓语、定语、宾语；用于赞叹"},{"id":19640,"word":"惊才风逸","pinyin":"jīng cái fēng yì","abbr":"jcfy","explanation":"指惊人的才华像风飘逸。","source":{"text":"不有屈原，岂见《离骚》！惊才风逸，壮志烟高。","book":"南朝·梁·刘勰《文心雕龙·辨骚》"},"usage":"作谓语；指人的才华"},{"id":19641,"word":"惊涛巨浪","pinyin":"jīng tāo jù làng","abbr":"jtjl","explanation":"汹涌吓人的浪涛。比喻险恶的环境或尖锐激烈的斗争。同“惊涛骇浪”。","source":{"text":"我闻黄河天上来，惊涛巨浪相喧豗。","book":"清·李调元《大风渡黄河歌》"},"similar":["惊涛怒浪","惊涛骇浪"],"usage":"作宾语、定语；形容波涛汹涌"},{"id":19642,"word":"惊涛怒浪","pinyin":"jīng tāo nù làng","abbr":"jtnl","explanation":"汹涌吓人的浪涛。比喻险恶的环境或尖锐激烈的斗争。同“惊涛骇浪”。","source":{"text":"颠崖峻壁之间，一水飞出，如练千尺悬洒于万仞之下，有惊涛怒浪，涌瀼腾沸，喷溅漂流。","book":"宋·韩拙《论观画别识》"},"example":{"text":"君不见新滩奇险天下闻，～如山立。","book":"《新滩观捕鱼歌》"},"similar":["惊涛巨浪","惊涛骇浪","骇浪惊涛"],"usage":"作宾语、定语；形容波涛汹涌"},{"id":19643,"word":"惊涛骇浪","pinyin":"jīng tāo hài làng","abbr":"jthl","explanation":"涛：大波浪；骇：使惊怕。汹涌吓人的浪涛。比喻险恶的环境或尖锐激烈的斗争。","source":{"text":"人当既静之时，每思及前经所履之惊涛骇浪，未尝不惕然。","book":"唐·田颖《玉山堂文集·海云楼记》"},"example":{"text":"又觉得身体动荡，仿佛在～的小船里。","book":"叶圣陶《地动》"},"similar":["大风大浪","惊涛巨浪","惊涛怒浪"],"opposite":["风平浪静"],"usage":"作宾语、定语；形容波涛汹涌"},{"id":19644,"word":"惊猿脱兔","pinyin":"jīng yuán tuō tù","abbr":"jytt","explanation":"如受惊的猿猴、脱逃的兔子。形容迅速奔逃。","source":{"text":"还亏得苗子的脚底板厚，不怕巉岩荆棘，就如惊猿脱兔，漫山越岭的逃散了。","book":"清·吴敬梓《儒林外史》第四十三回"},"usage":"作宾语、定语；形容行动迅速"},{"id":19645,"word":"惊皇失措","pinyin":"jīng huáng shī cuò","abbr":"jhsc","explanation":"由于惊慌，一下子不知怎么办才好。同“惊惶失措”。"},{"id":19646,"word":"惊神泣鬼","pinyin":"jīng shén qì guǐ","abbr":"jsqg","explanation":"形容震动很大，十分感人。","source":{"text":"惊神泣鬼，皆言词赋之雄豪；遏云绕梁，原是歌耷之嘹亮。","book":"明·程登吉《幼学琼林·文事》"},"example":{"text":"磨剑问天真本色，～大文章。","book":"马骏声《赠亚子》诗"},"usage":"作谓语、定语；指文章或气势等"},{"id":19647,"word":"惊神破胆","pinyin":"jīng shén pò dǎn","abbr":"jspd","explanation":"形容极其恐惧。","source":{"text":"凡所书判，或是卒然，故趋事皆惊神破胆矣。","book":"唐·范摅《云溪友议》卷上"},"usage":"作谓语、定语；用于十分恐惧"},{"id":19648,"word":"惊群动众","pinyin":"jīng qún dòng zhòng","abbr":"jqdz","explanation":"比喻惊动很多人来做一件事。同“惊师动众”。","source":{"text":"凡事只平常去，不必惊群动众。","book":"明·袁宏道《与黄平倩书》"},"similar":["惊师动众"],"usage":"作谓语、宾语；指惊动很多人"},{"id":19649,"word":"惊耳骇目","pinyin":"jīng ěr hài mù","abbr":"jehm","explanation":"耳闻目见后内心震惊。","source":{"text":"须臾，云晦雷发，惊耳骇目。","book":"南朝·宋·刘义庆《幽明录》"},"example":{"text":"又‘长亭酒未醒，千里风动地’，‘天仗森森练雪拟，身骑骏马白鹰臂’，斯并～。","book":"唐·殷璠《河岳英灵集·王昌龄》"},"similar":["惊见骇闻"],"usage":"作谓语、定语、状语；用于书面语"},{"id":19650,"word":"惊肉生髀","pinyin":"jīng ròu shēng bì","abbr":"jrsb","explanation":"惊叹久处安逸，不能有所作为。","source":{"text":"备住荆州数年，尝于表刘表坐起至厕，见髀里肉生，慨然流涕。还坐，表怪问备，备曰：‘吾常身不离鞍，髀肉皆消。今不复骑，髀里肉生。日月若驰，老将至矣，而功业不建，是以悲耳。’","book":"《三国志·蜀志·先主传》裴松之注引晋司马彪《九州春秋》"},"example":{"text":"人人～，却日欲挥戈。","book":"宋·刘厵《水调歌头》词"},"similar":["髀里肉生"],"usage":"作谓语、定语；形容虚度时光","story":["东汉末年，刘备在与曹操作战中丢失了地盘，就去投奔刘表。刘表设酒宴安慰他。席间两人谈得甚欢，刘备入厕摸自己的髀，发现上面的肉又长了起来，回座后不禁感慨，这样下去，光复汉室何时才能成功？刘表送他地盘与军队以抵御曹操"]},{"id":19651,"word":"惊蛇入草","pinyin":"jīng shé rù cǎo","abbr":"jsrc","explanation":"形容草书写得矫健而活泼。","source":{"text":"若飞鸟出林，惊蛇入草。","book":"《宣和书谱·草书七》"},"example":{"text":"作一戈如百钧弩，作一点如高峰堕石，作一牵如百岁枯藤，作一放纵，如～。","book":"明·李贽《初潭集·师友四》"},"usage":"作宾语、定语；形容书法活泼有力"},{"id":19652,"word":"惊见骇闻","pinyin":"jīng jiàn hài wén","abbr":"jjhw","explanation":"耳闻目见后内心震惊。同“惊耳骇目”。","source":{"text":"以故凡厥所有，皆与世龃龉，只可自娱，不堪共质。间尝出以示人，惊见骇闻，非怒则笑。","book":"清·刘大櫆《与王君书》"},"similar":["惊耳骇目"],"usage":"作谓语、定语、状语；用于书面语"},{"id":19653,"word":"惊起梁尘","pinyin":"jīng qǐ liáng chén","abbr":"jqlc","explanation":"形容歌声高妙动人。","source":{"text":"汉兴以来，善歌者鲁人虞公，发声清哀，盖动梁尘。","book":"《太平御览》卷五七二引汉·刘向《别录》"},"example":{"text":"忔憎声里金珠迸，～落舞帘。","book":"宋·赵元福《鹧鸪天·赠歌妓》词"},"usage":"作谓语、定语；用于声音等"},{"id":19654,"word":"惊采绝绝","pinyin":"jīng cǎi jué jué","abbr":"jcjj","explanation":"形容才华惊人，文辞瑰丽。","source":{"text":"《卜居》标放言之致，《渔父》寄独往之才，故能气往轹古，辞来切今，惊采绝绝，难与并能矣。","book":"南朝·梁·刘勰《文心雕龙·辨骚》"}},{"id":19655,"word":"惊采绝艳","pinyin":"jīng cǎi jué yàn","abbr":"jcjy","explanation":"指文采惊人，辞藻华美。","source":{"text":"故能气往轹古，辞来切今，惊采绝艳，难与并能矣。","book":"南朝·梁·刘勰《文心雕龙·辨骚》"},"example":{"text":"因暇［余］熟读长吉诗，刺其文字之～，一一汇录。","book":"清·郑文焯《鹤道人论词书》"},"similar":["惊才绝艳"],"usage":"作谓语、定语、宾语；用于赞叹"},{"id":19656,"word":"惊风怒涛","pinyin":"jīng fēng nù tāo","abbr":"jfnt","explanation":"比喻生活中的艰辛险恶。","source":{"text":"唯谢氏妹衣食粗足，而遭家多难，未尝得一日安居。其婿师其既殂，吾妹维持门户，抚其孤，才六岁，恐惧忧伤，备尝艰苦……回思三十年前，惊风怒涛，恍如梦寐。","book":"清·刘大櫆《谢氏妹六十寿序》"},"similar":["惊风骇浪"],"usage":"作宾语、定语；用于比喻句"},{"id":19657,"word":"惊风扯火","pinyin":"jīng fēng chě huǒ","abbr":"jfch","explanation":"形容大惊小怪，自我惊扰。","source":{"text":"‘你们这些人的话也难讲，’他说：‘总是惊风扯火的！请问，搜查也搜查了，他还会把那个抓起来枪毙么？不会的。’","book":"沙汀《在祠堂里》"},"usage":"作定语、状语；用于口语"},{"id":19658,"word":"惊风雨，泣鬼神","pinyin":"jīng fēng yǔ，qì guǐ shén","abbr":"jfyqgs","explanation":"惊：震惊；泣：小声哭。使风和雨震惊，使鬼和神哭泣。原形容诗文极为优美，感人至深。后也用以形容感人的英雄气概或业绩。","source":{"text":"落笔惊风雨，诗成泣鬼神。","book":"唐·杜甫《寄李太白二十韵》诗"}},{"id":19659,"word":"惊风骇浪","pinyin":"jīng fēng hài làng","abbr":"jfhl","explanation":"比喻使世俗震动、极不寻常。","source":{"text":"人当既静之时，每思及前经所履之惊涛骇浪，未尝不惕然。","book":"唐·田颖《玉山堂文集·海云楼记》"},"example":{"text":"把一桩～的大案，办得来云过天空。","book":"清·文康《儿女英雄传》第十一回"},"similar":["狂风大浪","惊风怒涛"],"usage":"作宾语、定语；用于比喻句"},{"id":19660,"word":"惊魂不定","pinyin":"jīng hún bù dìng","abbr":"jhbd","explanation":"指受惊后心情还没有平静下来。","source":{"text":"只影自怜，命寄江湖之上；惊魂未定，梦游缧绁之中。","book":"宋·苏轼《谢量移汝州表》"},"example":{"text":"因此在等候的时候，一个个面色如土，～，互相偷看，交换眼色。","book":"姚雪垠《李自成》第五卷第九章"}},{"id":19661,"word":"惊魂丧魄","pinyin":"jīng hún sàng pò","abbr":"jhsp","explanation":"形容十分恐惧。","source":{"text":"夫子于是略及子路，而遂言‘季孙之忧，不在颛臾而在萧墙之内’。呜呼！使季孙闻之，不惊魂丧魄也哉！","book":"明·李贽《四书评·论语·季氏》"},"example":{"text":"虏则～，而我同胞当此喜慰之喜际，转生感喟。","book":"邹鲁《戊申云南河口之役》"},"similar":["惊魂落魄","惊魂失魄"],"usage":"作谓语、状语；用于恐惧时"},{"id":19662,"word":"惊魂动魄","pinyin":"jīng hún dòng pò","abbr":"jhdp","explanation":"形容十分恐惧。","source":{"text":"《易》曰：‘小人以小善为无益而弗为也……罪大而不可解。’每读《易》至此，未尝不惊魂动魄，心胆堕地也。","book":"清·陈确《示儿帖》"},"example":{"text":"清·李百川《绿野仙踪》第72回：“众妖妇久知冷于冰名姓，听了这三个字，无不～。”"},"similar":["惊心动魄"],"usage":"作谓语、定语；指恐惧"},{"id":19663,"word":"惊魂失魄","pinyin":"jīng hún shī pò","abbr":"jhsp","explanation":"形容使人感受很深，震动很大。同“惊魂丧魄”。","source":{"text":"八路八路……赛如猛虎；敌人一见，惊魂失魄掉屁股。","book":"《抗日歌谣·歌颂八路军》"},"similar":["惊魂丧魄","惊魂落魄"],"usage":"作谓语、状语；用于恐惧时"},{"id":19664,"word":"惊魂夺魄","pinyin":"jīng hún duó pò","abbr":"jhdp","explanation":"形容使人感受很深，震动很大。","source":{"text":"当一个文化熟到了稀烂的时候，人们会麻木不仁的把惊魂夺魄的事情与刺激放在一旁，而专意到吃喝拉撒中的小节目上去。","book":"老舍《四世同堂》二六"},"similar":["惊魂摄魄"],"usage":"作定语、状语；用于声势等"},{"id":19665,"word":"惊魂摄魄","pinyin":"jīng hún shè pò","abbr":"jhsp","explanation":"形容使人感受很深，震动很大。同“惊魂夺魄”。","source":{"text":"为了探索生命的奥秘，科学家们正付出艰辛的劳动和经历着惊魂摄魄的斗争。","book":"《花城》1981年第1期"},"similar":["惊魂夺魄"],"usage":"作定语、状语；用于声势等"},{"id":19666,"word":"惊魂未定","pinyin":"jīng hún wèi dìng","abbr":"jhwd","explanation":"指受惊后心情还没有平静下来。","source":{"text":"只影自怜，命寄江湖之上；惊魂未定，梦游缧绁之中。","book":"宋·苏轼《谢量移汝州表》"},"example":{"text":"他至今还～。"},"similar":["惊魂不定"],"opposite":["从容不迫","若无其事","平心静气"],"usage":"作谓语、定语、状语、补语；指受惊之后"},{"id":19667,"word":"惊魂甫定","pinyin":"jīng hún fǔ dìng","abbr":"jhfd","explanation":"甫：刚开始。惊惶失措的心情刚刚平定下来。","source":{"text":"今惊魂甫定，若再为万里之役。必不能将亲就养，人子之义，实非所安。","book":"宋·魏了翁《辞免召赴行在状》"},"example":{"text":"驻沪已一星期，～。","book":"蔡东藩、许廑父《民国通俗演义》第二十九回"}},{"id":19668,"word":"惊魂落魄","pinyin":"jīng hún luò pò","abbr":"jhlp","explanation":"形容使人感受很深，震动很大。同“惊魂丧魄”。","source":{"text":"左昆山久历戎行，也知道胜败乃兵家常事，断不会因吃了一次败仗就惊魂落魄，不敢再战。","book":"姚雪垠《李自成》第二卷第二十三章"},"similar":["惊魂丧魄","惊魂失魄"],"usage":"作谓语、状语；用于恐惧时"},{"id":19669,"word":"惊鸿艳影","pinyin":"jīng hóng yàn yǐng","abbr":"jhyy","explanation":"惊鸿：轻捷飞起的鸿雁。形容女子轻盈艳丽的身影。多就远望而言。","source":{"text":"姗姗微步上瑶台，笑看惊鸿艳影来。","book":"清·丘逢甲《席上有赠》"},"example":{"text":"遥见楼头有一女子凭栏临波凝睇，素妆淡服，丰神绝世，～，湖水皆香。","book":"清·王韬《鹃红女史》"},"usage":"作宾语、定语；用于比喻句"},{"id":19670,"word":"惑世盗名","pinyin":"huò shì dào míng","abbr":"hsdm","explanation":"犹欺世盗名。欺骗世人，窃取名誉。","source":{"text":"于是惑世盗名之徒，因夫民之离圣教日久也，生邪端，造异术。","book":"汉·徐幹《中论·考伪》"},"example":{"text":"我们要认清这些～之徒。"},"similar":["欺世盗名"],"usage":"作谓语、定语；同“欺世盗名”"},{"id":19671,"word":"惑世诬民","pinyin":"huò shì wū mín","abbr":"hswm","explanation":"指蛊惑世人。","source":{"text":"极厌憎释教，以为惑世诬民，最宜摈绝者。","book":"明刘若愚《酌中志·内臣职掌纪略》"},"example":{"text":"但我自有生以来，凡所闻见，皆其～，蠹财乱伦之事，深可厌恶。","book":"《豆棚闲话·陈斋长论地谈天》"},"usage":"作谓语、定语；用于处事"},{"id":19672,"word":"惓惓之忱","pinyin":"quán quán zhī chén","abbr":"qqzc","explanation":"惓惓：恳切，形容恳切、真实的心意。","source":{"text":"区区惓惓，冀见答享。","book":"汉·王充《论衡·明雩》"}},{"id":19673,"word":"惓惓之意","pinyin":"quán quán zhī yì","abbr":"qqzy","explanation":"惓惓：恳切的样子。深挚关切的心意。","source":{"text":"知章奉意，到家宣谕李白，且备述天子惓惓之意。","book":"清·褚人获《隋唐演义》第82回"},"example":{"text":"请接受我这～。"},"usage":"作宾语；指人诚恳"},{"id":19674,"word":"惘然如失","pinyin":"wǎng rán rú shī","abbr":"wrrs","explanation":"惘然：失意的样子。心情不舒畅，好像丢掉了什么东西似的。","source":{"text":"次日，彷徨珩案间，惘然如失。","book":"三国·魏·吴质《答东阿王书》：“精散思越，惘若有失，非敢羡宠光之休，慕猗顿之富。”宋·洪迈《夷坚丙志·蔡十九郎》"},"example":{"text":"想起去年在大阪丸上同这母女住一个官舱，因船还未开驶即失了火，当时勇敢救出这母女的事，不禁～。","book":"沈从文《元宵》四"},"similar":["惘然若失"],"usage":"作谓语、状语；形容怅惘失意"},{"id":19675,"word":"惘然若失","pinyin":"wǎng rán ruò shī","abbr":"wrrs","explanation":"惘然：失意的样子。心情不舒畅，好像丢掉了什么东西似的。","source":{"text":"是时同郡戴良，才高倨傲，而见宪未尝不正容，及归，惘然若有失也。","book":"《后汉书·黄宪传》"},"example":{"text":"黄通理～，无法可施，急忙赶至衙前。","book":"清·颐琐《黄绣球》第五回"},"similar":["怅然若失","若有所失","惘然如失"],"opposite":["胸有成竹"],"usage":"作谓语、状语；形容怅惘失意","story":["东汉学者黄宪出身贫寒，从小学识超人，名士荀淑见了他发现14岁的他居然可以当他的老师。别人把黄宪与功曹袁阆比较，认为他超出袁阆。同乡戴良目空一切，认为他比黄宪有学问，可是每次见面后总是怅惘失意，好像丢失什么东西似的"]},{"id":19676,"word":"惘若有失","pinyin":"wǎng ruò yǒu shī","abbr":"wrys","explanation":"惘：失意。神情颓丧，好像失去所爱所恋的样子。","source":{"text":"精散思越，惘若有失，非敢羡宠光之休。","book":"三国·魏·吴质《答东阿王书》"},"example":{"text":"他那～的样子显示已经碰了软钉子了。"},"similar":["惘然如失","惘然若失"],"usage":"作定语、状语；指怅惘失意"},{"id":19677,"word":"惙怛伤悴","pinyin":"chuò dá shāng cuì","abbr":"cdsc","explanation":"惙怛：忧伤的样子；伤悴：悲愁。形容非常忧伤、悲愁。","source":{"text":"心惙怛兮伤悴，志菲菲兮升降。","book":"《后汉书·梁鸿传》"},"usage":"作谓语、定语；指悲伤"},{"id":19678,"word":"惜分阴","pinyin":"xī fēn yīn","abbr":"xfy","explanation":"分阴：日影移动一分，指极短暂的时间。形容非常珍惜时间。","source":{"text":"大禹圣者，乃惜寸阴，至于众人，当惜分阴，岂可逸游荒醉，生无益于时，死无闻于后，是自弃也。","book":"《晋书·陶侃传》"},"example":{"text":"夫商农之人，俱有本业；诗书之士，尤～。","book":"清·蒲松龄《聊斋志异·赌符》"},"usage":"作谓语、定语；用于处事"},{"id":19679,"word":"惜墨如金","pinyin":"xī mò rú jīn","abbr":"xmrj","explanation":"惜：爱惜。爱惜墨就象金子一样。指不轻易动笔。","source":{"text":"李成惜墨如金，是也。","book":"明·陶宗仪《辍耕录》卷八"},"example":{"text":"写文章要力求做到～，删繁就简。"},"similar":["言简意赅","一字千金","惜墨若金"],"opposite":["连篇累牍","拖泥带水"],"usage":"作谓语、宾语、定语；指不轻易动笔","story":["五代时期著名的画家李成天资聪慧，琴棋书画无所不通，他作画时特别注重画面的整体结构和笔墨的运用，笔势强劲有力，墨法精细微妙，让人叫绝。但他生活拮据，有人建议他多画画卖出贴补家用，他说他作画不是随便凑合要深思熟虑才成"]},{"id":19680,"word":"惜墨若金","pinyin":"xī mò ruò jīn","abbr":"xmrj","explanation":"惜：爱惜。爱惜墨就像金子一样。指不轻易动笔。","source":{"text":"运笔如铁，惜墨若金。","book":"清·张岱《又枯木竹石臂阁铭》"},"similar":["惜墨如金"],"usage":"作谓语、宾语、定语；指不轻易动笔"},{"id":19681,"word":"惜字如金","pinyin":"xī zì rú jīn","abbr":"xzrj","explanation":"指极其节省文字，不多费笔墨。","source":{"text":"文章所忌者，开口骂题。便说几句闲文，才归正传，亦未尝不可，胡遽惜字如金，而作此卤莽灭裂之状也！","book":"清·李渔《闲情偶寄·词曲·格局》"},"similar":["惜墨如金","惜墨若金"],"usage":"作谓语、宾语、定语；指不轻易动笔"},{"id":19682,"word":"惜孤念寡","pinyin":"xī gū niàn guǎ","abbr":"xgng","explanation":"爱护孤儿，怜惜寡妇。泛指给孤苦无依者的同情和帮助。","source":{"text":"我贾仁也会斋僧布施，盖寺建塔，修桥补路，惜孤念寡，敬老怜贫，我可也舍的。","book":"元·无名氏《看钱奴》第一折"},"usage":"作谓语、宾语、定语；用于处事"},{"id":19683,"word":"惜客好义","pinyin":"xī kè hǎo yì","abbr":"xkhy","explanation":"指好客仗义。","source":{"text":"我只道你们弟兄心志不坚，原来真个惜客好义。","book":"明·施耐庵《水浒传》第十五回"},"usage":"作谓语、定语、宾语；用于处事"},{"id":19684,"word":"惜指失掌","pinyin":"xī zhǐ shī zhǎng","abbr":"xzsz","explanation":"惜：吝惜。因舍不得一个指头而失掉一个手掌。比喻因小失大。","source":{"text":"佃夫拂衣出户，曰：‘惜指失掌邪？’","book":"《南史·阮佃夫传》"},"example":{"text":"我们不能干～的时期。"},"similar":["得不偿失","因小失大"],"usage":"作谓语、定语；指顾小失大","story":["南朝时期，庐江人何恢特别喜欢年轻貌美的妓女张耀，经常与张饮酒作乐。何恢被任命为广州刺史，在即将赴任前设宴请阮佃夫，席间他频繁向阮夸耀张耀的美貌，说张耀不可多得。阮佃夫看不惯他们就拂袖而去，上书弹劾何恢荒废公务"]},{"id":19685,"word":"惜玉怜香","pinyin":"xī yù lián xiāng","abbr":"xylx","explanation":"惜、怜：爱怜；玉、香：比喻女子。比喻男子对所爱女子的照顾体贴。","source":{"text":"相逢没话说，不见却思量，全不肯惜玉怜香，则他那古敝性尚然强。","book":"元·尚仲贤《柳毅传书》第四折"},"example":{"text":"燮理阴阳，致君泽民，则学士不如参政；嘲风咏月，～，则参政不如学士。","book":"明·陶宗仪《辍耕录》卷十九"},"similar":["惜香怜玉","怜香惜玉"],"opposite":["喜新厌旧","怜新弃旧"],"usage":"作谓语、定语；用于男性对女性","story":["元代歌妓顺时秀天资聪敏，色艺超群，翰林学士王元鼎十分喜欢她。中书参政阿鲁温也想插一手，借机调戏她，问她他与王元鼎的差异。顺时秀说：你是宰相，治理国家，辅佐君王，他不如你。可惜玉怜香方面，你不如王学士"]},{"id":19686,"word":"惜老怜贫","pinyin":"xī lǎo lián pín","abbr":"xllp","explanation":"爱护老人，同情穷人。","source":{"text":"我们太太最是惜老怜贫的，比不得那个狂三诈四的那些人。","book":"清·曹雪芹《红楼梦》第39回"},"example":{"text":"你这样～，我只好，只好受下。","book":"姚雪垠《李自成》第一卷第六章"},"similar":["怜贫惜老"],"opposite":["欺贫爱富","嫌贫爱富"],"usage":"作谓语、定语；指爱护老人，同情穷人"},{"id":19687,"word":"惜衣有衣，惜食有食","pinyin":"xī yī yǒu yī，xī shí yǒu shí","abbr":"xyyyxsys","explanation":"爱惜衣服，才有衣服穿；爱惜粮食，才有粮食吃。比喻珍惜财物。","source":{"text":"怎么说福不可享尽？常言道：‘惜衣有衣，惜食有食。’","book":"明·冯梦龙《警世通言》卷三"},"usage":"作宾语、定语、分句；用于处事"},{"id":19688,"word":"惜财如命","pinyin":"xī cái rú mìng","abbr":"xcrm","explanation":"指把钱财看得极重，生活过分地节俭。","example":{"text":"我不喜欢～的人。"},"similar":["爱财如命"],"usage":"作谓语、定语；指过分节俭"},{"id":19689,"word":"惜香怜玉","pinyin":"xī xiāng lián yù","abbr":"xxly","explanation":"怜、惜：爱怜；香、玉：比喻女子。比喻男子对所爱女子的照顾体贴。","source":{"text":"相逢没话说，不见却思量，全不肯惜玉怜香，则他那古敝性尚然强。","book":"元·尚仲贤《柳毅传书》第四折"},"example":{"text":"必是八分恐惧，二分恼怒，扯动韦小宝～之情。","book":"金庸《鹿鼎记》第二十一回"},"similar":["怜香惜玉","惜玉怜香"],"usage":"作谓语、定语；用于男女之间"},{"id":19690,"word":"惝恍迷离","pinyin":"chǎng huǎng mí lí","abbr":"chml","explanation":"惝恍：也作：“惝况”，失意的样子。迷离：模糊不清。指茫然若失而模糊不清的样子。","source":{"text":"词不在大小浅深，贵于移情。‘晓风残月’、‘大江东去’，体制虽殊，读之皆若身历其境，惝恍迷离，不能自主，文之至也。","book":"清·沈谦《填词杂说》"},"example":{"text":"这所房子从运河中看，好像在水里。下两层是玲珑的架子，上一层才是屋子；这是很巧的结构，加上那艳而雅的颜色，令人有～之感。","book":"朱自清《威尼斯》"}},{"id":19691,"word":"惟一惟精","pinyin":"wéi yī wéi jīng","abbr":"wywj","explanation":"精诚专事，毫无杂念。","example":{"text":"做事～不是很困难的。"},"similar":["惟精惟一"],"usage":"作宾语、定语；用于处事"},{"id":19692,"word":"惟义是从","pinyin":"wéi yì shì cóng","abbr":"wysc","explanation":"只要有道理或道义就坚决服从。","example":{"text":"～的人经常会走极端。"},"usage":"作谓语、定语；用于处事"},{"id":19693,"word":"惟利是命","pinyin":"wéi lì shì mìng","abbr":"wlsm","explanation":"指惟利是图。","source":{"text":"那婆子本是愚顽之辈，兼之年近昏眊，惟利是命，一概情面不管。","book":"清·曹雪芹《红楼梦》第59回"},"similar":["惟利是图"],"usage":"作谓语、定语；指惟利是图"},{"id":19694,"word":"惟利是图","pinyin":"wéi lì shì tú","abbr":"wlst","explanation":"一心为利，别的什么都不顾。","source":{"text":"由于夸诳，内抱贪浊，惟利是图。","book":"晋·葛洪《抱朴子·勤求》"},"example":{"text":"富自何来？每见贪酷小人，～，不过使这几家治下百姓卖儿贴妇，充其囊橐，此真狼心狗行之徒！","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"similar":["唯利是图"],"usage":"作谓语、定语；同“唯利是图”","story":["公元前580年，秦桓公与晋厉公签订友好盟约，约定两国和平相处。就在盟约墨汁未干，秦桓公派人到狄国和楚国，怂恿他们去攻打晋国。晋厉公派吕相到秦国去抗议，指责秦桓公惟利是图、傲慢无礼。不久两国就发生战争"]},{"id":19695,"word":"惟利是求","pinyin":"wéi lì shì qiú","abbr":"wlsq","explanation":"一心为利，别的什么都不顾。","source":{"text":"工部尚书苏孝慈等以为所在官司因循往昔，皆以公廨钱物出举兴生，惟利是求，烦扰百姓。","book":"《通典·食货五》"},"similar":["惟利是图","惟利是趋"],"usage":"作谓语、定语、宾语；用于处事"},{"id":19696,"word":"惟利是营","pinyin":"wéi lì shì yíng","abbr":"wlsy","explanation":"指惟利是视。","source":{"text":"卿宗室旧人，乃纵肆败法，惟利是营，朕甚恶之。","book":"《金史·阿离方传》"},"similar":["惟利是趋","惟利是逐","惟利是图"],"usage":"作谓语、定语、宾语；用于处事"},{"id":19697,"word":"惟利是视","pinyin":"wéi lì shì shì","abbr":"wlss","explanation":"一心为利，别的什么都不顾。","source":{"text":"苏峻小子，惟利是视，残酷骄猜，权相假合。","book":"《晋书·温峤传》"},"example":{"text":"盖彼之商人～，不顾大体。","book":"清·薛福成《察看英法两国交涉事宜疏》"},"similar":["唯利是视","惟利是趋"],"usage":"作谓语、定语、宾语；用于处事"},{"id":19698,"word":"惟利是趋","pinyin":"wéi lì shì qú","abbr":"wlsq","explanation":"一心为利，别的什么都不顾。","source":{"text":"若以罪之大小而论，那宰牛的原算罪魁，但此辈无非市井庸愚，只知惟利是趋，岂知善恶果报之道。","book":"清·李汝珍《镜花缘》第十二回"},"example":{"text":"清·李百川《绿野仙踪》第77回：“～，不顾后患。”"},"similar":["惟利是求","惟利是图"],"usage":"作谓语、定语、宾语；用于处事"},{"id":19699,"word":"惟利是逐","pinyin":"wéi lì shì zhú","abbr":"wlsz","explanation":"指惟利是视。","source":{"text":"这利己主义到了‘惟利是逐’的地步，却是非空虚到极点不可。","book":"朱自清《历史在战斗中》"},"similar":["惟利是趋","惟利是图"],"usage":"作谓语、定语、宾语；用于处事"},{"id":19700,"word":"惟力是视","pinyin":"wéi lì shì shì","abbr":"wlss","explanation":"指竭尽己力而为。","source":{"text":"除君之恶，惟力是视。","book":"《左传·僖公二十四年》"},"example":{"text":"如有清兵前来，余等固～。","book":"陶成章《浙案纪略·王金宝传》"},"usage":"作谓语；用于人的行为"},{"id":19701,"word":"惟口兴戎","pinyin":"wéi kǒu xīng róng","abbr":"wkxr","explanation":"指口舌惹出是非。多用来劝戒别人说话要谨慎。","source":{"text":"惟口出好兴戎，朕言不再。","book":"《尚书·大禹漠》"},"example":{"text":"从来～，以后还是收敛些儿为是。","book":"清·张春帆《九尾龟》第三十五回"}},{"id":19702,"word":"惟口起羞","pinyin":"wéi kǒu qǐ xiū","abbr":"wkqx","explanation":"指言语不慎，招致羞辱。","source":{"text":"惟口起羞，惟甲胄起戎。","book":"《书·说命中》"},"example":{"text":"～，谅非细故。","book":"唐·陆贽《论裴延龄奸蠹书》"},"usage":"作宾语、定语；用于处事"},{"id":19703,"word":"惟命是从","pinyin":"wéi mìng shì cóng","abbr":"wmsc","explanation":"犹言惟命是听。指绝对服从。","source":{"text":"秋香道：‘解元为贱妾之故，不借辱千金之躯，妾岂敢不惟命是从。’","book":"《东观汉记·鲍宣妻传》：“既奉君子，惟命是从。”明·冯梦龙《警世通言》第二十六卷"},"example":{"text":"若斯之伦……莫不～。","book":"严复等《国闻报馆附印说部缘起》"},"similar":["唯命是从"],"usage":"作谓语、宾语、定语；指绝对服从命令","story":["公元前597年，楚庄王率大军讨伐郑国，攻破郑国都城。郑襄公裸露上身跪迎楚庄王，说可以占领郑国，让郑国人作奴仆，或者给他一个朝贡的机会，他都可以唯命是从。楚庄王看他十分可怜就答应退兵，允许郑国求和，并订立盟约"]},{"id":19704,"word":"惟命是听","pinyin":"wéi mìng shì tīng","abbr":"wmst","explanation":"叫做什么，就做什么。指绝对服从。","source":{"text":"今君王举玉趾而诛孤臣，孤臣惟命是听","book":"《左传·宣公十二年》：“孤不天，不能事君，使君怀怒以及敝邑，孤之罪也，敢不惟命是听。”《史记·越王勾践世家》"},"example":{"text":"女同志的意见，我～！","book":"老舍《女店员》第三幕"},"similar":["惟命是从"],"usage":"作谓语、定语；指绝对服从命令"},{"id":19705,"word":"惟天可表","pinyin":"wéi tiān kě biǎo","abbr":"wtkb","explanation":"只有对上天才可以表白自己的心情。表示在别人不信任的情况下无可奈何的慨叹。","source":{"text":"小生一言难尽，寸心相报，惟天可表！","book":"元·王实甫《西厢记》第四本第一折"},"example":{"text":"我本待留此身报国，以报知己，不料变出事来。但我此心，～。","book":"清·褚人获《隋唐演义》第四十五回"}},{"id":19706,"word":"惟妙惟肖","pinyin":"wéi miào wéi xiào","abbr":"wmwx","explanation":"肖：相似。描写或模仿的非常逼真。","source":{"text":"形容维妙惟肖，仿佛《水经注》造语。","book":"清·蒲松龄《聊斋志异·各本序跋题辞〈读聊斋杂说〉》"},"example":{"text":"这里写赵姑母的唠叨和龙钟，～。","book":"朱自清《“老张的哲学”与“赵子曰”》"},"similar":["栩栩如生"],"opposite":["画虎类犬"],"usage":"作谓语、定语、补语；指非常逼真"},{"id":19707,"word":"惟恍惟惚","pinyin":"wéi huǎng wéi hū","abbr":"whwh","explanation":"恍、惚：模糊，不清。指事物模糊无定体。","source":{"text":"道之为物，惟恍为惚。","book":"《老子》第二十一章"}},{"id":19708,"word":"惟我独尊","pinyin":"wéi wǒ dú zūn","abbr":"wwdz","explanation":"本为推崇佛陀之辞，后用以形容人妄自尊大，目空一切。","source":{"text":"天上地下，惟我独尊。","book":"宋·释惟白《续传灯录·宗元庵主》"},"example":{"text":"你不要有～的念头。"},"similar":["唯我独尊"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指妄自尊大","story":["古印度北部迦毗罗卫国净饭王的儿子释迦牟尼29岁痛感人世生老病死的各种苦恼，放弃王族生活，出家修道，经过6年的修行终于得道，创立了佛教。佛经里说他从右肋出生，能立即走路，左手指天，右手指地，大声说：“天上天下，惟我独尊。”"]},{"id":19709,"word":"惟所欲为","pinyin":"wéi suǒ yù wéi","abbr":"wsyw","explanation":"想干什么就干什么，任意而为。","source":{"text":"犹是一事，有贿者从，无贿者驳，混淆黑白，颠倒是非，惟所欲为，莫之能制。","book":"郑观应《盛世微言·书吏》"},"example":{"text":"兼并之民，伏处乡里，生杀予夺，～，法律有所不知，官吏有所不禁，岂非有财之故也。","book":"刘师培《废兵废财论》"},"similar":["为所欲为","唯所欲为"],"usage":"作谓语、定语；用于处事"},{"id":19710,"word":"惟施是畏","pinyin":"wéi yǐ shì wèi","abbr":"wssw","explanation":"施：通“迤”、“迆”，斜行，这里指斜路。最怕的是走斜路。","source":{"text":"使我介然有知，行于大道，惟施是畏。","book":"《老子》第五十三章"}},{"id":19711,"word":"惟日不足","pinyin":"wéi rì bù zú","abbr":"wrbz","explanation":"惟：只；足：够。只觉时日不够。","source":{"text":"我闻吉人为善惟日不足，凶人为不善亦惟日不足。","book":"《尚书·泰誓中》"},"example":{"text":"《梁书·安成王秀传》：“庾郭之形骸枯槁，或橡板菁羹，～。”"},"similar":["日落西山"],"usage":"作谓语；指只觉时日不够"},{"id":19712,"word":"惟日为岁","pinyin":"wéi rì wéi suì","abbr":"wrws","explanation":"犹言度日如年。形容日子很不好过。","source":{"text":"久废过庭，不闻善诱，陟岵瞻望，惟日为岁。","book":"《后汉书·党锢传·李膺》"},"similar":["度日如年"],"usage":"作谓语、定语；用于书面语"},{"id":19713,"word":"惟明克允","pinyin":"wéi míng kè yǔn","abbr":"wmky","explanation":"惟：只有；明：明察；克：能；允：公允。只有明察事物，才能公正地对待事物，令人信服。","source":{"text":"五流有宅，五宅三居，惟明克允。","book":"《尚书·舜典》"},"example":{"text":"封疆大吏整饬多方，～，水旱则倡施赈济，丰稳则建置义仓，犹复宣讲圣谕，化蠢导顽。","book":"清·徐佩珂《荡寇志·序》"}},{"id":19714,"word":"惟有读书高","pinyin":"wéi yǒu dú shū gāo","abbr":"wydsg","explanation":"只有读书以求进取，才是高尚的途径。","source":{"text":"世上般皆下品，思量惟有读书高。","book":"元·柯丹丘《荆钗记·会讲》"},"example":{"text":"明·范受益《寻亲记·劝勉》：“有人来就学，不肯好相交，只把家私来比并，不思量～。”"},"usage":"作宾语、定语；用于劝诫人"},{"id":19715,"word":"惟精惟一","pinyin":"wéi jīng wéi yī","abbr":"wjwy","explanation":"指精纯专一。","source":{"text":"日气日神，惟精惟一，玉莹无瑕天地归。","book":"《尚书·大禹谟》：“人心惟危，道心惟微，惟精惟一，允执厥中。”元·李道纯《沁园春·赠圆庵蒋大师》词"},"example":{"text":"《尚书·大禹谟》：“人心惟危，道心惟微，惟精惟一，允执厥中。”元·李道纯《沁园春·赠圆庵蒋大师》词：“日气日神，惟精惟一，玉莹无瑕天地归。”"},"similar":["惟一惟精"],"usage":"作谓语、定语、状语；用于处事"},{"id":19716,"word":"惟肖惟妙","pinyin":"wéi xiāo wéi miào","abbr":"wxwm","explanation":"形容描摹得十分生动逼真。","example":{"text":"这幅画把儿童天真活泼的神态描绘得～。"}},{"id":19717,"word":"惟适之安","pinyin":"wéi shì zhī ān","abbr":"wsza","explanation":"自己觉得怎么做舒服就怎么做。","source":{"text":"起居无时，惟适之安。","book":"唐·韩愈《送李愿归盘谷序》"},"example":{"text":"高亚白知其起居无时，～，亦惟有听凭自便而已。","book":"清·韩邦庆《海上花列传》第五十一回"}},{"id":19718,"word":"惠子善譬","pinyin":"huì zǐ shàn pì","abbr":"hzsp","explanation":"把别人的长处看作短处，强迫别人改变。","source":{"text":"惠子之言事也善譬。王使无譬，则不能言矣。","book":"《新序·善说》"},"usage":"作宾语、定语；指强人所难","story":["有一个门客嫉妒惠子能言善辩，就对梁王说让他以后说话不要用比喻。梁王也希望惠子说话直截了当。惠子说如果让一个不知道“弹”是什么东西的人明白，那么就只有用比喻去描述它的形状就能很快解决，梁王觉得言之有理"]},{"id":19719,"word":"惠子知我","pinyin":"huì zǐ zhī wǒ","abbr":"hzzw","explanation":"比喻朋友相知之深。","source":{"text":"惠子指惠施，战国宋人，在先秦诸子中属名家，为庄周契友。惠死后，庄周过其墓，曾借匠石斫垩的寓言，感慨“自夫子之死也，吾无以为质矣，吾无与言之矣”。见《庄子·徐无鬼》。"},"example":{"text":"～，夫何间然。","book":"李白《与贾少公书》"},"usage":"作宾语、定语；用于朋友间","story":["战国时期，宋国人惠施是先秦诸子百家中的名家之一，他与庄周是好朋友，两人相交很深，经常在一起探讨问题。惠施死后，庄周路过他的墓地，经常拜祭他，一次庄子感慨地说：“自夫子之死也，吾无以为质也，吾无与言之矣。”"]},{"id":19720,"word":"惠心妍状","pinyin":"huì xīn yán zhuàng","abbr":"hxyz","explanation":"妍：美丽；状：外表、容貌。心地善良，姿容美丽。","source":{"text":"及至移意爱，析嬿私，虽惠心妍状，愈献丑焉。","book":"《后汉书·郭后纪论》"}},{"id":19721,"word":"惠施之谋","pinyin":"huì shī zhī móu","abbr":"hszm","explanation":"比喻兼听则聪，善于听取不同的意见才能明察善断。","source":{"text":"张仪欲以秦、韩与魏之势伐齐、荆，而惠施欲以齐、荆偃兵，二人争之。","book":"战国·韩·韩非《韩非子·内储说上》"},"usage":"作主语、宾语；指要善于听取意见","story":["战国时期，张仪向魏王建议联合秦、韩两国去进攻齐、楚两国，而惠施则主张与齐、楚联合通好。二人各执己见，争执不下。魏王听群臣意见，群臣附和张仪。魏王不采纳惠施之谋而采用张仪的主张，结果招致失败"]},{"id":19722,"word":"惠然之顾","pinyin":"huì rán zhī gù","abbr":"hrzg","explanation":"用作欢迎客人来临的客气话。同“惠然肯来”。","source":{"text":"弥秋历冬，经迈二载，深拒以疾，无惠然之顾。","book":"晋·袁宏《后汉纪·灵帝纪下》"},"similar":["惠然肯来"],"usage":"作宾语；用作欢迎客人来临的客气话"},{"id":19723,"word":"惠然肯来","pinyin":"huì rán kěn lái","abbr":"hrkl","explanation":"惠：赐，敬辞。用作欢迎客人来临的客气话。","source":{"text":"终风且霾，惠然肯来。","book":"《诗经·邶风·终风》"},"example":{"text":"你我是患难故交，今复～，足见感情，还要说什么套话。","book":"蔡东藩、许廑父《民国通俗演义》第六十七回"},"similar":["惠然之顾"],"usage":"作谓语；用作欢迎客人来临的客气话"},{"id":19724,"word":"惠而不费","pinyin":"huì ér bù fèi","abbr":"hebf","explanation":"惠：给人好处；费：耗费。给人好处，自己却无所损失。","source":{"text":"因民之所利而利之，斯不亦惠而不费乎？","book":"《论语·尧曰》"},"example":{"text":"谁知庄大老爷这笔款项情愿报效，只代子弟们求几个保举，更是～的事。","book":"清·李宝嘉《官场现形记》第十五回"},"similar":["顺手人情"],"usage":"作谓语；指给人好处，自己却无所损失"},{"id":19725,"word":"惠风和畅","pinyin":"huì fēng hé chàng","abbr":"hfhc","explanation":"惠：柔和；和：温和；畅：舒畅。柔和的风，使人感到温暖、舒适。","source":{"text":"是日也，天朗气清，惠风和畅。","book":"晋·王羲之《兰亭集序》"},"usage":"作宾语、定语；多用于比喻句"},{"id":19726,"word":"惠鲜鳏寡","pinyin":"huì xiàn guān guǎ","abbr":"hxgg","explanation":"鲜：通“献”，施于；鳏寡：年老而无所依靠的人。施恩惠于年老而穷困无靠的人。","source":{"text":"怀保小民，惠鲜鳏寡。","book":"《尚书·无逸》"}},{"id":19727,"word":"惨不忍睹","pinyin":"cǎn bù rěn dǔ","abbr":"cbrd","explanation":"睹：看。凄惨得叫人不忍心看。","source":{"text":"伤心惨目，有如是耶！","book":"唐·李华《吊古战场文》"},"example":{"text":"他在一场车祸中不幸遇难，那场景真是～。"},"similar":["惨不忍闻","惨绝人寰"],"opposite":["喜闻乐见"],"usage":"作谓语、定语；形容各种惨状"},{"id":19728,"word":"惨不忍言","pinyin":"cǎn bù rěn yán","abbr":"cbry","explanation":"不忍心把悲惨情形说出口。","source":{"text":"最近数年，百姓死亡流离，如水愈深，如火愈热，往往赤地千里，炊烟断绝，易子而食，惨不忍言。","book":"姚雪垠《李自成》第一卷第五章"},"example":{"text":"地震后的灾区真是～。"},"similar":["惨不忍睹"],"opposite":["津津乐道"],"usage":"作谓语、定语；指不能说出口"},{"id":19729,"word":"惨不忍闻","pinyin":"cǎn bù rěn wén","abbr":"cbrw","explanation":"闻：听。凄惨得叫人不忍心听。","source":{"text":"一时哀号之声，惨不忍闻。","book":"清·李宝嘉《官场现形记》第二十一回"},"example":{"text":"遥见何家坟中，树木阴森，哭声成籁，或父呼子，或夫觅妻，呱呱之声，草畔溪间，比比皆是，～！","book":"清·陈天华《狮子吼》第二回"},"similar":["惨不忍睹","惨绝人寰"],"opposite":["喜闻乐见"],"usage":"作谓语、定语；形容声音凄惨"},{"id":19730,"word":"惨无人理","pinyin":"cǎn wú rén lǐ","abbr":"cwrl","explanation":"犹言惨无人道。指残酷狠毒到极点，如野兽一样。","source":{"text":"严弄峻制，惨无人理。任法吏之妄为，丝毫不加限制，人命呼吸，悬于法官之意旨。","book":"孙中山《临时大总统宣告各友邦书》"},"example":{"text":"其虐待工人及附近居民（鸡犬不安，～），我父兄弟所亲见尝者，胡不自救耶！","book":"宋嘉珍《敬告全滇父老缴款赎路意见书》"},"similar":["惨无人道"],"usage":"作定语、状语；指没有人道的惨酷事情"},{"id":19731,"word":"惨无人道","pinyin":"cǎn wú rén dào","abbr":"cwrd","explanation":"惨：狠毒，残暴。残酷狠毒到极点，如野兽一样。","source":{"text":"将妃、主等人，一一剖心致祭，惨无人道。","book":"蔡东藩《唐史演义》第五十二回"},"example":{"text":"杀我人民，系累我妇孺，～。","book":"杨玉如《辛亥革命先著记》"},"similar":["灭绝人性","惨绝人寰"],"opposite":["仁至义尽"],"usage":"作定语、状语；指没有人道的惨酷事情"},{"id":19732,"word":"惨无天日","pinyin":"cǎn wú tiān rì","abbr":"cwtr","explanation":"犹言暗无天日。","source":{"text":"以希腊、罗马之文明，而其下级社会之民，被虐待者惨无天日，其所沐文明之膏泽者，不过国中一小部分耳。","book":"梁启超《中国专制政治进化史论》第三章"},"example":{"text":"他们过着～的日子。"},"similar":["暗无天日"],"usage":"作谓语、定语；形容反动势力的黑暗统治"},{"id":19733,"word":"惨淡经营","pinyin":"cǎn dàn jīng yíng","abbr":"cdjy","explanation":"惨淡：苦费心思；经营：筹划。费尽心思辛辛苦苦地经营筹划。后指在困难的的境况中艰苦地从事某种事业。","source":{"text":"诏谓将军指绢素，意匠惨淡经营中。","book":"唐·杜甫《丹青引赠曹将军霸》"},"example":{"text":"这样～之后，这一所房屋，在那条贫民窟的街道上简直是一所很整洁的屋子了。","book":"邹韬奋《经历·惨淡经营之后》"},"similar":["苦心经营","苦心造诣"],"opposite":["无所用心"],"usage":"作谓语、定语；形容艰苦地筹划与工作","story":["唐玄宗时期，著名绘画大师曹霸善于画人和马，被封为“左武卫将军”。唐玄宗命曹霸为他的御马玉花骢画像，曹霸经过一阵惨淡经营后，一匹生动活泼的马便出现在白绢上，这马好像即将腾跃的飞龙，所有的马都要相形失色了"]},{"id":19734,"word":"惨澹经营","pinyin":"cǎn dàn jīng yíng","abbr":"cdjy","explanation":"①原指作画前先用浅淡颜色勾勒轮廓，苦心构思，经营位置。南朝齐谢赫《古画品录》以经营位置为绘画六法之一。②引申指苦心谋划并从事某项事情。亦作“惨淡经营”","source":{"text":"诏谓将军拂绢素，意匠惨澹经营中。","book":"唐·杜甫《丹青引赠曹将军霸》"},"example":{"text":"我一方面自然极佩服这位朋友的～，但一方面却记起了批评家批评狄更斯的话来……","book":"茅盾《现成的希望》"}},{"id":19735,"word":"惨然不乐","pinyin":"cǎn rán bù lè","abbr":"crbl","explanation":"表情凄楚的样子。","source":{"text":"自老人居在道旁，往往有郡太守休马于此，皆惨然不乐。","book":"唐·陈鸿《东城老父传》"},"example":{"text":"你今日容颜～，却是为何？","book":"明·叶宪祖《鸾鎞记·论心》"},"usage":"作谓语、定语；用于人的心情等"},{"id":19736,"word":"惨礉少恩","pinyin":"cǎn hé shǎo ēn","abbr":"chse","explanation":"惨：严酷；礉：核实，引申为苛刻；恩：恩情。形容用法严酷苛刻。","source":{"text":"韩子引绳墨，切事情，明是非，其极惨礉少恩。","book":"《史记·老子韩非列传》"},"usage":"作谓语、定语；用于执法等"},{"id":19737,"word":"惨绝人寰","pinyin":"cǎn jué rén huán","abbr":"cjrh","explanation":"人寰：人世。世界上再没有比这更惨痛的事。形容惨痛到了极点。","source":{"text":"此一惨绝人寰之浩劫，实为我国内战史上空前所未有。","book":"毛泽东《评国民党对战争责任问题的几种答案》"},"example":{"text":"这不仅是一点感触，而～的事实，是民族最大的耻辱，是每个人的仇恨。","book":"老舍《蜕》"},"similar":["惨无人道","惨不忍睹"],"opposite":["仁至义尽"],"usage":"作谓语、定语；形容酷刑、屠杀等惨状"},{"id":19738,"word":"惨绿少年","pinyin":"cǎn lǜ shào nián","abbr":"clsn","explanation":"惨绿：浅绿，指服色。原指穿浅绿衣服的少年。后指讲究装饰的青年男子。","source":{"text":"喜曰：‘皆尔之俦也，不足忧矣！末座惨绿少年何人也。’答曰：‘补阙杜黄裳。’","book":"唐·张固《幽闲鼓吹》"},"example":{"text":"他是一个～。"},"similar":["翩翩公子"],"usage":"作宾语；指风度翩翩的青年男子"},{"id":19739,"word":"惨绿年华","pinyin":"cǎn lǜ nián huá","abbr":"clnh","explanation":"指风华正茂的青年时期。","source":{"text":"十年提倡受思身，惨绿年华记忆真。","book":"清·龚自珍《己卯自春徂夏在京师作》诗之七"},"example":{"text":"喜狎俊少，见有翩翩白袷～者，纡望连而不置。","book":"清·二石生《十洲春语》卷上"},"similar":["花信年华"],"usage":"作宾语、定语；用于青年"},{"id":19740,"word":"惨绿愁红","pinyin":"cǎn lü chóu hóng","abbr":"clch","explanation":"红、绿：指花、叶。指经过风雨摧残的残花败叶。多寄以对身世凄凉的感情。","source":{"text":"自春来，惨绿愁红，芳心是事可可。","book":"宋·柳永《定风波》词"},"similar":["愁红怨绿","残花败叶"],"usage":"作宾语、定语；用于书面语"},{"id":19741,"word":"惨遭不幸","pinyin":"cǎn zāo bù xìng","abbr":"czbx","explanation":"遭到严重灾祸，多指死亡。","example":{"text":"他在这次事故中～。"},"similar":["飞来横祸"],"usage":"作谓语、宾语；多指死亡"},{"id":19742,"word":"惨雨酸风","pinyin":"cǎn yǔ suān fēng","abbr":"cysf","explanation":"犹言凄风苦雨。指令人伤感的天气。亦以喻不安定的局势。","source":{"text":"军门传箭夜缒城，郦生寸舌能销兵。抽红换白须臾事，惨雨酸风顷刻平。","book":"《三元里人民抗英斗争史料·英夷就抚》"},"similar":["凄风苦雨"],"usage":"作宾语、定语；用于局势或处境等"},{"id":19743,"word":"惩一儆众","pinyin":"chéng yī jǐng zhòng","abbr":"cyjz","explanation":"惩：惩罚；儆：警告。惩罚一个人，以警戒众人。","source":{"text":"若得惩一儆众，自可群知洗濯。","book":"《清史稿·谷际歧传》"},"similar":["惩一儆百"],"usage":"作谓语、定语；意为杀一儆百"},{"id":19744,"word":"惩一儆百","pinyin":"chéng yī jǐng bǎi","abbr":"cyjb","explanation":"惩：惩罚；警：警戒。处死一个人，借以警戒许多人。","source":{"text":"其有所取也，以一警百，吏民皆服，恐惧改行自新。","book":"《汉书·尹翁归传》"},"example":{"text":"兄弟今天定要～，让众人当面看看，好叫他们有个怕惧。","book":"清·李宝嘉《官场现形记》第五十六回"},"similar":["杀一儆百"],"usage":"作谓语、定语；意为杀一儆百","story":["西汉时期，河东太守田延年巡视霍光的家乡平阳发现市场吏尹翁归是个难得的人才，于是奏请皇上任命他为东海太守。东海是一个强盗横行的地方，尹翁归决定采取杀一儆百的办法，逮捕处决当地豪强许仲孙，于是东海变得安定起来"]},{"id":19745,"word":"惩一戒百","pinyin":"chéng yī jiè bǎi","abbr":"cyjb","explanation":"惩罚一人以警戒众人。同“惩一警百”。","source":{"text":"故依法律明惟问，惩一戒百难容忍。","book":"明·沈釆《千金记》第四十七出"},"similar":["惩一警百","惩一儆百"],"usage":"作谓语、定语；意为杀一儆百"},{"id":19746,"word":"惩一警百","pinyin":"chéng yī jǐng bǎi","abbr":"cyjb","explanation":"警：警戒，也做“儆”。指惩罚一人以警戒众人。","source":{"text":"翁归治东海明察……其有所取也，以一警百，吏民皆服，恐惧改行自新。","book":"语出《汉书·尹翁归传》"},"example":{"text":"陛下欲剔弊防奸，～，诸臣用之以借题修隙，敛怨市权。","book":"《明史·黄道周传》"},"similar":["惩一戒百","惩一儆众"],"usage":"作谓语、定语；意为杀一儆百","story":["西汉时期，河东太守田延年巡视霍光的家乡平阳发现市场吏尹翁归是个难得的人才，于是奏请皇上任命他为东海太守。东海是一个强盗横行的地方，尹翁归决定采取杀一儆百的办法，逮捕处决当地豪强许仲孙，于是东海变得安定起来"]},{"id":19747,"word":"惩前毖后","pinyin":"chéng qián bì hòu","abbr":"cqbh","explanation":"惩：警戒；毖：谨慎。指批判以前所犯的错误，吸取教训，使以后谨慎些，不致再犯。","source":{"text":"予其惩而毖后患。","book":"《诗经·周颂·小毖》"},"example":{"text":"唐总理～，实不欲再当此任，只是需款甚急，又不好不硬着头皮，出去商办。","book":"蔡东藩、许廑父《民国通俗演义》第十回"},"similar":["小惩大诫"],"opposite":["重蹈覆辙"],"usage":"作谓语、宾语、定语；指吸取教训以后小心","story":["西周年幼的周成王在周公姬旦的辅佐下治理国家，周武王的弟弟管叔鲜、蔡叔度造谣说周公准备篡位，周公为表忠心隐居外地。管叔鲜等立即叛乱，周成王请周公率军讨伐。周成王说他要从所受的惩戒中汲取教训以便将来不再发生类似情形"]},{"id":19748,"word":"惩忿窒欲","pinyin":"chéng fèn zhì yù","abbr":"cfzy","explanation":"惩：惩戒；忿：愤怒；窒：抑止；欲：嗜欲。克制愤怒，抑制嗜欲。","source":{"text":"损，君子以惩忿窒欲。","book":"《周易·损》"},"example":{"text":"各宜警醒，～，且休望超凡入道，也是保身安家的正理。","book":"明·冯梦龙《醒世恒言》卷三十四"},"usage":"作谓语；形容克制情感"},{"id":19749,"word":"惩恶劝善","pinyin":"chéng è quàn shàn","abbr":"ceqs","explanation":"惩：责罚；劝：勉励。惩罚坏人，奖励好人。","source":{"text":"《春秋》之称微而显，志而晦……惩恶而劝善。非圣人谁能修之？","book":"春秋·鲁·左丘明《左传·成公十四年》"},"example":{"text":"所谓文学上的人道主义，当然不是庸俗的普渡众生，也不是～。","book":"孙犁《秀露集·文学和生活的路》"},"similar":["隐恶扬善"],"usage":"作谓语；指惩罚恶人劝他向善"},{"id":19750,"word":"惩羹吹虀","pinyin":"chéng gēng chuī jī","abbr":"cgcj","explanation":"羹：浓汤；虀：通“齑”，咸菜。被热羹烫过的人，吃凉菜也要吹一吹。比喻鉴于以往的教训，遇事过分小心，该做的不敢做或举措失当。","source":{"text":"而瑰玮特绝之徒，益惩羹吹虀，羞与哙伍。","book":"梁启超《变法通议·论科举》"},"similar":["惩羹吹齑"],"usage":"作谓语、定语、宾语；比喻做事过分小心"},{"id":19751,"word":"惩羹吹齑","pinyin":"chéng gēng chuī jī","abbr":"cgcj","explanation":"羹：用肉、菜等煮成的汤；齑：细切的冷食肉菜。被热汤烫过嘴，吃冷食时也要吹一吹。比喻受到过教训，遇事过分小心。","source":{"text":"惩于羹者而吹齑兮，何不变此志也。","book":"战国·楚·屈原《九章·惜诵》"},"example":{"text":"～岂其非，亡羊补牢理所宜。","book":"宋·陆游《秋兴》诗"},"similar":["惩羹吹虀"],"usage":"作谓语、定语、宾语；比喻做事过分小心"},{"id":19752,"word":"惬心贵当","pinyin":"qiè xīn guì dāng","abbr":"qxgd","explanation":"合情合理。","source":{"text":"故夫夸目者尚奢，惬心者贵当。","book":"晋·陆机《文赋》"},"example":{"text":"当然，这种解释可能不是～的。","book":"范文澜《关于中国历史上的一些问题》"},"similar":["合情合理"],"usage":"作谓语、定语；指合情合理"},{"id":19753,"word":"惭凫企鹤","pinyin":"cán fú qǐ hè","abbr":"cfqh","explanation":"比喻惭愧自己的短处，羡慕别人的长处。","source":{"text":"若夫器分有限，智用无涯，或惭凫企鹤，沥辞镌思。","book":"南朝·梁·刘勰《文心雕龙·养气》"},"example":{"text":"请不要有～的想法。"},"similar":["自惭形秽"],"usage":"作谓语、宾语；形容自惭形秽，羡慕别人"},{"id":19754,"word":"惭愧无地","pinyin":"cǎn kuì wú dì","abbr":"ckwd","explanation":"羞惭愧悔，无地自容。形容惭愧到了极点。","source":{"text":"似道得词，惭愧无地。","book":"明·冯梦龙《喻世明言》第22卷"},"example":{"text":"每月薪俸终不过二百元左右，就此一点，已足使我们～。","book":"李大钊《列宁不死》"},"opposite":["问心无愧"],"usage":"作谓语、状语；用于人的感觉等"},{"id":19755,"word":"惮赫千里","pinyin":"dàn hè qiān lǐ","abbr":"dhql","explanation":"惮赫：威震。威震千里。形容声威极盛。","source":{"text":"白波若山，海水震荡，声侔鬼神，惮赫千里。","book":"《庄子·外物》"},"usage":"作谓语、定语；指人的声威"},{"id":19756,"word":"惯战能征","pinyin":"guàn zhàn néng zhēng","abbr":"gznz","explanation":"征：征讨。形容作战经验丰富，善于作战。","source":{"text":"手里横着一柄金蘸斧，坐下李都监那匹惯战能征雪白马。","book":"明·施耐庵《水浒传》第13回"},"example":{"text":"清·吴璿《飞龙全传》第31回：“他自恃斧精力勇，～，眼底无人，藐视天下没有好汉。”"},"similar":["能征惯战"],"usage":"作谓语、定语；指善于作战"},{"id":19757,"word":"想入非非","pinyin":"xiǎng rù fēi fēi","abbr":"xrff","explanation":"非非：原为佛家语，表示虚幻的境界。想到非常玄妙虚幻的地方去了。形容完全脱离现实地胡思乱想。","source":{"text":"如存不存，若尽不尽，如是一类，名非想非非想处。","book":"《楞严经》"},"example":{"text":"当下～，一头说一头要弄计赚骗缪寄萍的书。","book":"清·黄小配《大马扁》第二回"},"similar":["胡思乱想","痴心妄想"],"opposite":["脚踏实地","四平八稳"],"usage":"作谓语、宾语、状语；指胡思乱想"},{"id":19758,"word":"想前顾后","pinyin":"xiǎng qián gù hòu","abbr":"xqgh","explanation":"顾：看，视。想着前面，又顾虑后面。形容犹豫不决、矛盾重重的状态。","source":{"text":"觉民气得没有办法，他不再想前顾后地思索了。","book":"巴金《春》"},"example":{"text":"他的～态度让人受不了。"},"similar":["思前想后"],"usage":"作谓语、定语；指顾虑太多"},{"id":19759,"word":"想当然","pinyin":"xiǎng dāng rán","abbr":"xdr","explanation":"凭主观推断，认为事情大概是或应该是这样。","source":{"text":"以今度之，想当然耳。","book":"南朝·宋·范晔《后汉书·孔融传》"},"example":{"text":"学术研究不能靠～的。"},"similar":["想当然耳"],"usage":"作谓语、定语；指凭主观推断","story":["公元203年，曹操同儿子曹丕率军攻占袁绍的老巢邺城，18岁的曹丕见23岁的袁尚妻子甄氏十分漂亮，就强占为夫人。孔融知道后就写信给曹操，运用当年周武王把商纣王的宠妃妲己赏给周公的典故。曹操不解，孔融说他根据现在推想过去的"]},{"id":19760,"word":"想当然耳","pinyin":"xiǎng dāng rán ěr","abbr":"xdre","explanation":"耳：而已，罢了。想来应是这样罢了。指凭主观推断，认为事情大概是或应该是这样。","source":{"text":"以今度之，想当然耳。","book":"《后汉书·孔融传》"},"example":{"text":"汪先生也摸着胡子，反复援引苏东坡的名言道：“‘～’，‘～’哦！”","book":"钱钟书《围城》第七章"},"similar":["想当然"],"usage":"作谓语、定语；指凭主观推断","story":["公元203年，曹操同儿子曹丕率军攻占袁绍的老巢邺城，18岁的曹丕见23岁的袁尚妻子甄氏十分漂亮，就强占为夫人。孔融知道后就写信给曹操，运用当年周武王把商纣王的宠妃妲己赏给周公的典故。曹操不解，孔融说他根据现在推想过去的"]},{"id":19761,"word":"想方设法","pinyin":"xiǎng fāng shè fǎ","abbr":"xfsf","explanation":"想种种办法。","source":{"text":"教的一篇若是白话，看来看去差不多没有几句需要讲明的；然而也得想方设法，把五十分钟敷衍过去。","book":"叶圣陶《得失》"},"example":{"text":"我～也要办到。"},"similar":["千方百计","挖空心思","费尽心机"],"opposite":["无计可施"],"usage":"作谓语、状语；指想尽一切办法"},{"id":19762,"word":"想方设计","pinyin":"xiǎng fāng shè jì","abbr":"xfsj","explanation":"思索和筹划种种解决问题的办法。","source":{"text":"这时里面有个老头围着一口黑的缸打转，他想方设计要拿走它，却又想不出个办法。","book":"丁玲《太阳照在桑乾河上》"},"example":{"text":"他们便早早的从地里回来，～去打听消息。","book":"丁玲《太阳照在桑干河上》八"},"similar":["想方设法"],"usage":"作谓语、状语；指想尽一切办法"},{"id":19763,"word":"想望丰采","pinyin":"xiǎng wàng fēng cǎi","abbr":"xwfc","explanation":"非常仰慕其人，渴望一同。见“想望风采”。","source":{"text":"数陈谠论，中外想望丰采，帝亦深眷倚。","book":"《明史·冯琦传》"},"similar":["想望风采","想望风概"],"usage":"作谓语；指非常仰慕"},{"id":19764,"word":"想望风概","pinyin":"xiǎng wàng fēng gài","abbr":"xwfg","explanation":"想望：仰慕；风概：节操。非常仰慕其人，渴望一见。","source":{"text":"天下之士，莫不想望风概，咨嗟叹息曰：‘萧公真贤矣哉。’","book":"元·揭傒斯《与萧维斗书》"},"similar":["想望风采"],"usage":"作谓语；指非常仰慕"},{"id":19765,"word":"想望风褱","pinyin":"xiǎng wàng fēng shèng","abbr":"xwfh","explanation":"犹言想望风采。非常仰慕其人，渴望一见。"},{"id":19766,"word":"想望风采","pinyin":"xiǎng wàng fēng cǎi","abbr":"xwfc","explanation":"想望：仰慕。风采：风度神采。非常仰慕其人，渴望一见。","source":{"text":"初辅幼主，政由己出，天下想闻其风采。","book":"《汉书·霍光传》"},"example":{"text":"李泌为相，举为谏议大夫，拜官不辞，未至京师，人皆～。","book":"唐·韩愈《顺宗实录》卷四"},"similar":["想望丰采"],"usage":"作谓语；指非常仰慕"},{"id":19767,"word":"惴惴不安","pinyin":"zhuì zhuì bù ān","abbr":"zzba","explanation":"惴：忧愁、恐惧。形容因害怕或担心而不安。","source":{"text":"乾道八年，济南辛侯（辛弃疾）自司农寺簿来守滁……民之居茅竹相比，每大风作，惴惴然不自安。","book":"《诗经·秦风·黄鸟》：“临其穴，惴惴其栗。”宋·周孚《铅刀编·滁州奠枕楼记》"},"example":{"text":"大家都认为这是震南村第一个大灾难，愁眉苦脸，～。","book":"欧阳山《苦斗》六七"},"similar":["忐忑不安","惶恐不安","心慌意乱"],"opposite":["心安理得","悠然自得"],"usage":"作谓语、定语、状语；指人的心情","story":["公元前621年，春秋五霸之一的秦穆公任好死了，100多活人被送去殉葬，包括大臣子车氏家的三弟兄，他们三人都是对国家作出突出贡献的良臣。秦国人们对他们的遭遇深表同情和痛惜，一时心里惴惴不安，纷纷愿意代替他们去死"]},{"id":19768,"word":"惶恐不安","pinyin":"huáng kǒng bù ān","abbr":"hkba","explanation":"惶：恐惧。内心害怕，十分不安。","source":{"text":"正营，惶恐不安之意也。","book":"东汉·班固《汉书·王莽传下》：“人民正营。”唐·颜师古注"},"example":{"text":"他终日感到～。"},"similar":["惊慌失措"],"opposite":["谈笑自若","处之泰然"],"usage":"作谓语、定语、状语；指人不安"},{"id":19769,"word":"惶悚不安","pinyin":"huáng sǒng bù ān","abbr":"hsba","explanation":"惊慌害怕得不得安宁。","source":{"text":"相父今又如此受苦，使孤日夜惶悚不安！","book":"明·许仲琳《封神演义》第54回"},"similar":["惶惶不安","惶恐不安"],"usage":"作谓语、定语、状语；指人不安"},{"id":19770,"word":"惶惶不可终日","pinyin":"huáng huáng bù kě zhōng rì","abbr":"hhbkzr","explanation":"惊慌地连一天都过不下去。形容惊恐不安到了极点。","source":{"text":"敌人还有西进的模样，一般人都有惶惶不可终日的情形。","book":"郭沫若《我怎样写和》"},"example":{"text":"义军进逼京城，吓得朝廷官僚们～，崇祯上吊，皇城禁军作鸟兽散。"},"similar":["惊惶失措","惊恐万状","闻风丧胆"],"opposite":["处之泰然","临危不惧","无所畏惧"],"usage":"作谓语、状语、定语；形容担心害怕"},{"id":19771,"word":"惶惶不安","pinyin":"huáng huáng bù ān","abbr":"hhba","explanation":"惶：恐惧。内心害怕，十分不安。","source":{"text":"正营，惶恐不安之意也。","book":"《汉书·王莽传下》：“人民正营，无所措手足。”唐·颜师古注"},"example":{"text":"董卓屯兵城外，每日带铁甲马军入城，横行街市，百姓～。","book":"明·罗贯中《三国演义》第三回"},"similar":["如坐针毡","人心惶惶"],"opposite":["悠闲自得","等闲视之"],"usage":"作谓语、定语、状语；指心神不宁"},{"id":19772,"word":"惹事招非","pinyin":"rě shì zhāo fēi","abbr":"rszf","explanation":"引起麻烦之事。同“惹是招非”。","source":{"text":"哎，徐宁紧紧相随，生怕俺不遵依，向城中惹事招非。","book":"元·无名氏《东平府》第一折"},"example":{"text":"明·施耐庵《水浒传》第103回：“大奶奶却是利害得紧，谁敢与你传话，～？”"},"similar":["惹是招非","招惹是非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":19773,"word":"惹事生非","pinyin":"rě shì shēng fēi","abbr":"rssf","explanation":"招惹是非，引起争端。","source":{"text":"如今再说一个富家，安分守己，并不惹事生非。","book":"明·冯梦龙《古今小说》卷三十六"},"example":{"text":"学生在教课上得不到满足，在校内便时常爱闹风潮，在校外也时常～。","book":"郭沫若《少年时代·我的童年》"},"similar":["为非作歹","无事生非","惹是生非"],"opposite":["安分守己","奉公守法"],"usage":"作谓语、定语、宾语；指引起争端"},{"id":19774,"word":"惹人注目","pinyin":"rě rén zhù mù","abbr":"rrzm","explanation":"惹：招惹，引起。引起别人的注意。","source":{"text":"又怕衣服不合时令，未免惹人注目，也且炎热难当，却不敢再走闹市。","book":"清·无垢道人《八仙全传》第19回"},"example":{"text":"她那漂亮的红蝴蝶发卡特别～。"},"similar":["引人注目"],"opposite":["毫不起眼"],"usage":"作谓语、定语；指吸引人的注意"},{"id":19775,"word":"惹是招非","pinyin":"rě shì zhāo fēi","abbr":"rszf","explanation":"引起麻烦之事。","source":{"text":"孩儿，你许多时不行这条路，如今去端门看灯，从张员外门前过，又去惹是招非。","book":"《京本通俗小说·志诚张主管》"},"example":{"text":"教你们贼狗胎在这里看看，就恁～的。","book":"《金瓶梅词话》第六四回"},"similar":["惹事招非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":19776,"word":"惹是生非","pinyin":"rě shì shēng fēi","abbr":"rssf","explanation":"惹：引起；非：事端。招惹是非，引起争端。","source":{"text":"安分守己，并不惹是生非。","book":"明·冯梦龙《喻世明言》"},"example":{"text":"学生在教课上得不到满足，在校内便时常爱闹风潮，在校外也时常～。","book":"郭沫若《我的童年》第三篇一"},"similar":["为非作歹","无事生非","惹事生非"],"opposite":["安分守己","奉公守法"],"usage":"作谓语、定语、宾语；指引起争端"},{"id":19777,"word":"惹火上身","pinyin":"rě huǒ shàng shēn","abbr":"rhss","explanation":"惹：招引。比喻自己招灾惹祸害自己。","example":{"text":"请不要自己～。"},"similar":["惹祸上身","自找麻烦"],"usage":"作谓语、定语；比喻自找麻烦"},{"id":19778,"word":"惹火烧身","pinyin":"rě huǒ shāo shēn","abbr":"rhss","explanation":"惹：引；身：本身。引火烧自己。比喻自找麻烦或自找苦吃。","source":{"text":"庄上人见典史亲来捉获，不知一件什么天大的事，生怕惹火烧身，连忙把余琳并冯氏，都送将出来。","book":"明·东鲁古狂生《醉醒石》第三回"},"example":{"text":"今日与你盘缠，迟延，少待乞大拳，披麻～怨，莫待等江心补漏船。","book":"明·无名氏《白兔记·逼书》"},"similar":["招灾惹祸"],"opposite":["明哲保身"],"usage":"作谓语、定语；比喻自找麻烦"},{"id":19779,"word":"惹灾招祸","pinyin":"rě zāi zhāo huò","abbr":"rzzh","explanation":"给自己引来麻烦。同“惹祸招灾”。","source":{"text":"非是咱起风波，都自己惹灾招祸。","book":"元·尚仲贤《气英布》第一折"},"similar":["惹祸招灾","惹祸招愆","惹祸招殃"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":19780,"word":"惹祸招愆","pinyin":"rě huò zhāo qiān","abbr":"rhzq","explanation":"给自己引来麻烦。同“惹祸招灾”。","source":{"text":"郑恒枉自胡来缠，空落得惹祸招愆。","book":"元·关汉卿《普天乐·崔张十六事》曲"},"similar":["惹祸招殃","惹祸招灾","惹灾招祸"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":19781,"word":"惹祸招殃","pinyin":"rě huò zhāo yāng","abbr":"rhzy","explanation":"给自己引来麻烦。同“惹祸招灾”。","source":{"text":"数遍到此，曾谏李王，李王不听，只恐怕惹祸招殃。","book":"元·无名氏《蓝采和》第三折"},"similar":["惹祸招愆","惹祸招灾","惹灾招祸"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":19782,"word":"惹祸招灾","pinyin":"rě huò zhāo zāi","abbr":"rhzz","explanation":"给自己引来麻烦。","source":{"text":"莫刚直，休豪迈，于身无益，惹祸招灾。","book":"元·张养浩《普天乐》"},"example":{"text":"本是那驴骡里出弩骀，少教训，欠丁揌，～。","book":"明·胡文焕《群音类选·清腔类·斗鹌鹑》"},"similar":["惹祸招殃","惹灾招祸","惹祸招愆"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":19783,"word":"惹罪招愆","pinyin":"rě zuì zhāo qiān","abbr":"rzzq","explanation":"愆：过失。给自己招致罪过。","source":{"text":"倘或取受了百姓钱，违负了帝王室，敢大胆欺压良民，冒突天颜，惹罪招愆，久以后，市曹中，遭着刑宪。","book":"元·杨梓《霍光鬼谏》第二折"},"example":{"text":"则为你昧己瞒心，因此上～。","book":"明·无名氏《锁白猿》第四折"}},{"id":19784,"word":"惹草拈花","pinyin":"rě cǎo niān huā","abbr":"rcnh","explanation":"惹：招引，挑逗；草、花：比喻好；拈：捏。比喻男女调情。多指调戏妇女。","source":{"text":"三国志无过说些战伐，也不希咤，终少些团香弄玉，惹草粘花。","book":"元·杨立斋《哨遍》"},"example":{"text":"镜台儿边～。","book":"明·刘兑《金童玉女娇红记》"},"similar":["沾花惹草","偷鸡摸狗","惹草沾花"],"opposite":["忠心耿耿"],"usage":"作谓语、定语；指男女间的挑逗引诱"},{"id":19785,"word":"惹草沾花","pinyin":"rě cǎo zhān huā","abbr":"rczh","explanation":"比喻男女调情。多指调戏妇女。同“惹草拈花”。","source":{"text":"我非无斩钉截铁刚方气，都只为惹草沾花放荡情。","book":"明·汪廷讷《狮吼记·奇妒》"},"similar":["惹草拈花","惹草沾风"],"usage":"作谓语、定语；指男女间的挑逗引诱"},{"id":19786,"word":"惹草沾风","pinyin":"rě cǎo zhān fēng","abbr":"rczf","explanation":"比喻迷恋女色，与配偶以外的女性发生暖昧关系。","source":{"text":"勾引的惹草沾风泼赖徒，辱没杀受戒传灯好宗祖。","book":"明·冯惟敏《僧尼共犯》第二折"},"similar":["惹草沾花"],"usage":"作谓语、定语；指男女间的挑逗引诱"},{"id":19787,"word":"惹草粘花","pinyin":"rě cǎo niān huā","abbr":"rczh","explanation":"惹：招引。比喻随处迷恋于不正当的男女情爱。","source":{"text":"却说湍制台九姨太身边的那个大丫头，自见湍制台属意于他，他便有心惹草粘花，时向湍制台跟前勾搭。","book":"清·李宝嘉《官场现形记》第38回"},"similar":["惹草拈花","惹草沾花"],"opposite":["洁身自好","守身如玉"],"usage":"作谓语、定语；指男女间的挑逗引诱"},{"id":19788,"word":"惺惺作态","pinyin":"xīng xīng zuò tài","abbr":"xxzt","explanation":"惺惺：虚伪的样子。故意做出一种姿态。形容虚伪不老实。","source":{"text":"在周少棠有此意外的姻缘，自然喜之不胜，但就做朋友的道理来说，少不得要惺惺作态一番。","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"他偏偏爱～。"},"similar":["装腔作势","装模作样","弄虚作假"],"opposite":["本来面目","真心实意","开诚布公"],"usage":"作谓语；指人装腔作势"},{"id":19789,"word":"惺惺惜惺惺","pinyin":"xīng xīng xī xīng xīng","abbr":"xxxxx","explanation":"惺惺：指聪慧的人；惜：爱惜。比喻同类的人互相爱惜。","source":{"text":"方信道，惺惺的自古惜惺惺。","book":"元·王实甫《西厢记》第一本第三折"},"example":{"text":"古人有言：“～，好汉惜好汉。”量这一个泼男女……终何作用！众豪杰且请宽心。","book":"明·施耐庵《水浒传》第十九回"},"similar":["惺惺相惜"],"usage":"作宾语、分句；比喻同类的人互相爱惜"},{"id":19790,"word":"惺惺惜惺惺，好汉惜好汉","pinyin":"xīng xīng xī xīng xīng,hǎo hàn xī hǎo hàn","abbr":"xxxxxhhxhh","explanation":"惺惺：指聪慧的人。聪明人爱惜聪明人，好汉珍惜好汉。比喻同类的人互相爱惜、同情","source":{"text":"古人有言：‘惺惺惜惺惺，好汉惜好汉。’量这一个泼男女，腌臜畜生，终作何用！","book":"明·施耐庵《水浒传》第19回"},"similar":["惺惺相惜"],"usage":"作宾语、分句；用于处事"},{"id":19791,"word":"惺惺相惜","pinyin":"xīng xīng xiāng xī","abbr":"xxxx","explanation":"性格、志趣、境遇相同的人互相爱护、同情、支持。","source":{"text":"他若是共小生，厮觑定，隔墙儿酬和到天明，方信道惺惺的自古惜惺惺。","book":"元·王实甫《西厢记》"},"example":{"text":"这是双方的互相倾慕，～，但是，又何尝不是一种缘分呢！","book":"柳残阳《断肠花》第34章"},"similar":["志同道合"],"opposite":["离心离德"],"usage":"作谓语、定语；指相互爱惜","story":["张飞率领一万精兵入川，兵临巴郡城下，打探到守将严颜是个不可多得的将领。张飞几次攻城，严颜就是不出城迎战，张飞只好用计把严颜骗出，几个回合就活捉严颜。严颜拒不投降，张飞待之以礼，终于使严颜归顺"]},{"id":19792,"word":"愀然不乐","pinyin":"qiǎo rán bù lè","abbr":"qrbl","explanation":"愀然：忧愁的样子。脸上忧愁严肃，心中不愉快。","source":{"text":"见不善，愀然必以自省也。","book":"《荀子·修身》"},"example":{"text":"大家开怀畅饮，独有卢爷有些～之状。","book":"清·石玉昆《三侠五义》第五十八回"},"usage":"作谓语、定语、状语；用于书面语"},{"id":19793,"word":"愀然无乐","pinyin":"qiǎo rán wú lè","abbr":"qrwl","explanation":"愀然：忧愁的样子。脸上忧愁严肃，心中不愉快。","source":{"text":"见不善，愀然必以自省也。","book":"《荀子·修身》"}},{"id":19794,"word":"愁云惨淡","pinyin":"chóu yún cǎn dàn","abbr":"cycd","explanation":"惨淡：暗淡。原指阴沉沉的云层遮得天色暗淡无光。也用以形容使人感到忧愁、压抑的景象或气氛。","source":{"text":"翰海阑干百丈冰，愁云惨淡万里凝。","book":"唐·岑参《白雪歌送武判官归京》"},"usage":"作宾语、定语；指人心烦"},{"id":19795,"word":"愁云惨雾","pinyin":"chóu yún cǎn wù","abbr":"cycw","explanation":"形容暗淡无光的景象。多比喻令人忧愁苦闷的局面。","source":{"text":"时有圆应长者，出众作礼问曰：‘云愁雾惨，大众呜呼，请师一言，未在告别。’","book":"宋·释道源《景德传灯录》卷二十二"},"example":{"text":"今天，那美丽的三千里江山还有半壁笼罩着～。","book":"杨朔《历史的指针》"},"similar":["愁云惨淡"],"usage":"作定语、宾语；形容令人愁闷凄惨的景象"},{"id":19796,"word":"愁城难解","pinyin":"chóu chéng nán jiě","abbr":"ccnj","explanation":"愁城：愁苦的境地。形容难以摆脱愁苦的境地。","source":{"text":"狂吟烂醉君无笑，十丈愁城要解围。","book":"宋·陆游《剑南诗稿·山园》"}},{"id":19797,"word":"愁多夜长","pinyin":"chóu duō yè cháng","abbr":"cdyc","explanation":"因心情愁闷而夜不成寐，感到时光悠长难遣。","source":{"text":"孟冬寒气至，北风何惨慓！愁多知夜长，仰观众星列。","book":"《古诗十九首》"},"example":{"text":"诗尽时尤阔，愁多夜更长。","book":"宋·华岳《翠微南征录·秋意次项子礼韵》"},"usage":"作宾语、定语；用于人烦恼时"},{"id":19798,"word":"愁山闷海","pinyin":"chóu shān mèn hǎi","abbr":"csmh","explanation":"忧愁如山，苦闷似海。形容愁闷象山一样大，象海一样深，无法排遣。","source":{"text":"俺又不曾弄月嘲风，怎揽这场愁山闷海。","book":"元·无名氏《争报恩》第二折"},"similar":["愁山苦海"],"usage":"作宾语；指人忧愁"},{"id":19799,"word":"愁思茫茫","pinyin":"chóu sī máng máng","abbr":"csmm","explanation":"愁思：忧愁的思绪茫茫：辽阔，深远。形容忧虑的思绪无边无际，既深且长。","source":{"text":"城上高楼接大荒，海天愁思正茫茫。","book":"唐·柳宗元《登柳州城楼寄漳汀封连四州》诗"}},{"id":19800,"word":"愁海无涯","pinyin":"chóu hǎi wú yá","abbr":"chwy","explanation":"愁海：愁深似海。忧愁的尽情就像大海一样无边无际。形容精神上忧郁、惆怅。","source":{"text":"醒时不可过，愁海浩无边。","book":"唐·孟郊《招文士饮》"},"opposite":["兴高采烈"],"usage":"作宾语、定语；用于人烦恼时"},{"id":19801,"word":"愁潘病沈","pinyin":"chóu pān bìng shěn","abbr":"cpbs","explanation":"泛指烦恼和疾病。","source":{"text":"晋·潘岳因忧愁而早生白发，南朝·梁·沈约因病而瘦减腰围。"}},{"id":19802,"word":"愁眉不展","pinyin":"chóu méi bù zhān","abbr":"cmbz","explanation":"展：舒展。由于忧愁而双眉紧锁。形容心事重重的样子。","source":{"text":"旧隐每杯空竟夕，愁眉不展几经春。","book":"唐·姚鹄《随州献李侍御》之二"},"example":{"text":"后见统领端茶，只得退回家中，～的终日在家里对老婆孩子咳声叹气。","book":"清·李宝嘉《官场现形记》第三十回"},"similar":["愁眉苦脸","闷闷不乐","愁颜不展"],"opposite":["笑逐颜开","眉开眼笑","喜笑颜开"],"usage":"作谓语、定语、状语；形容心事重重的样子"},{"id":19803,"word":"愁眉啼妆","pinyin":"chóu méi tí zhuāng","abbr":"cmtz","explanation":"愁眉：使眉细而曲折；啼妆：轻轻地擦去目下的粉饰以作啼痕。形容妇女的妖态。","source":{"text":"桓帝元嘉中，京都妇女作愁眉、啼妆、堕马髻、折腰步、龋齿笑。所谓愁眉者，细而曲折。啼妆者，薄饰目下，若啼处。","book":"《后汉书·五行志一》"},"usage":"作定语；形容妇女的妖媚妆饰"},{"id":19804,"word":"愁眉泪眼","pinyin":"chóu méi lèi yǎn","abbr":"cmly","explanation":"皱着眉头，含着眼泪。形容悲苦的样子。","source":{"text":"坐久，至更初，李始归，愁眉泪睫，憔悴可掬。","book":"宋·张端义《贵耳集》卷下"},"example":{"text":"那媳妇～，也不敢进厅来，到阶下便朝上跪下磕头。","book":"清·曹雪芹《红楼梦》第六十二回"},"similar":["愁眉苦脸"],"opposite":["喜笑颜开"],"usage":"作谓语、定语；形容悲苦的样子"},{"id":19805,"word":"愁眉苦目","pinyin":"chóu méi kǔ mù","abbr":"cmkm","explanation":"愁眉：紧皱眉头。愁苦的样子。形容人忧愁苦恼。","source":{"text":"只见一个人在那里和亮臣说话，不住的嗳声叹气，满脸的愁眉苦目。","book":"清·吴趼人《二十年目睹之怪现状》第102回"},"similar":["愁眉苦脸","愁眉锁眼"],"opposite":["笑逐颜开"],"usage":"作宾语、定语、状语；用于发愁、苦恼或焦急"},{"id":19806,"word":"愁眉苦眼","pinyin":"chóu méi kǔ yǎn","abbr":"cmky","explanation":"形容愁苦的神色。","source":{"text":"只见那张太太愁眉苦眼的向他道：‘姑奶奶，你别闹了。’","book":"《儿女英雄传》第二五回"},"example":{"text":"玉林夫妇外面虽也在装作～，不能终日的样子，但心里却在私私地打算。","book":"郁达夫《出奔》一"},"similar":["愁眉苦目","愁眉苦脸"],"usage":"作谓语、定语、状语；用于发愁、苦恼或焦急"},{"id":19807,"word":"愁眉苦脸","pinyin":"chóu méi kǔ liǎn","abbr":"cmkl","explanation":"皱着眉头，哭丧着脸。形容愁苦的神色。","source":{"text":"对人前巧语花言，背地里愁眉泪脸。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"成老爹气得～，只得自己走出去回那几个乡里人去了。","book":"清·吴敬梓《儒林外史》第四十八回"},"similar":["愁眉锁眼","愁眉不展"],"opposite":["笑逐颜开","喜笑颜开","眉开眼笑"],"usage":"作谓语、定语、状语；用于发愁、苦恼或焦急"},{"id":19808,"word":"愁眉蹙额","pinyin":"chóu méi cù é","abbr":"cmce","explanation":"因发愁而紧皱眉头。","source":{"text":"内地的小商人为了上海‘钱庄不通’而愁眉蹙额。","book":"茅盾《血战后一周年》"},"example":{"text":"武昌这方面的很多高级负责人员，就像患了神经衰弱症似的，～，胆战心惊。","book":"李六如《六十年的变迁》第一卷第六章"},"similar":["愁眉苦脸"],"usage":"作谓语、定语；用于人愁闷时"},{"id":19809,"word":"愁眉锁眼","pinyin":"chóu méi suǒ yǎn","abbr":"cmsy","explanation":"锁：紧皱。愁得紧皱眉头，眯起双眼。形容非常苦恼的样子。","source":{"text":"对人前巧语花言，背地里愁眉泪脸。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"抗战以来，全国人民有一种欣欣向荣的气象，大家以为有了出路，～的姿态为之一扫。","book":"毛泽东《新民主主义论》"},"similar":["愁眉苦眼"],"opposite":["喜笑颜开","眉开眼笑"],"usage":"作谓语、定语；指发愁"},{"id":19810,"word":"愁红怨绿","pinyin":"chóu hóng yuàn lǜ","abbr":"chyl","explanation":"红、绿：指花、叶。指经过风雨摧残的残花败叶。多寄以对身世凄凉的感情。","source":{"text":"更凭青女留连得，未作愁红怨绿看。","book":"宋·范成大《窗前木芙蓉》诗"},"similar":["愁红惨绿"],"usage":"作宾语、定语；指人的心情"},{"id":19811,"word":"愁红惨绿","pinyin":"chóu hóng cǎn lü","abbr":"chcl","explanation":"红、绿：指花、叶。指经过风雨摧残的残花败叶。多寄以对身世凄凉的感情。","source":{"text":"愁红惨绿今宵看，恰似吴宫教阵图。","book":"宋·柳永《定风波》词：“自春来，惨绿愁红，芳心是事可可。”宋·辛弃疾《鹧鸪天·赋牡丹》词"},"example":{"text":"春初透，花正结，正～时节。","book":"元·兰楚芳《愿成双·春思》"},"similar":["残花败叶","愁红怨绿"],"usage":"作宾语；指人的心情"},{"id":19812,"word":"愁绪冥冥","pinyin":"chóu xù míng míng","abbr":"cxmm","explanation":"愁绪：忧愁的心绪；冥冥：高远。形容愁闷既深且重。","source":{"text":"无由出江汉，愁绪日冥冥。","book":"唐·杜甫《客旧馆》诗"}},{"id":19813,"word":"愁绪如麻","pinyin":"chóu xù rú má","abbr":"cxrm","explanation":"忧愁的思虑像麻一样烦乱。形容烦愁之极。","source":{"text":"心儿里愁绪如麻，把个活动动的人儿，都困做了笼中之鸟。","book":"明·罗贯中《平妖传》第三回"},"usage":"作谓语、定语；指十分烦乱"},{"id":19814,"word":"愁肠九回","pinyin":"chóu cháng jiǔ huí","abbr":"ccjh","explanation":"指悲愁频频在腹中萦绕，难于排遣。","source":{"text":"是以肠一日而九回，居则忽忽若有所亡，出则不知其所往。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"玉楼春暖笙歌夜，肯信愁肠日九回。","book":"唐·崔橹《春日长安即事》"},"similar":["愁肠百结"],"usage":"作宾语、定语；用于人烦恼时"},{"id":19815,"word":"愁肠九转","pinyin":"chóu cháng jiǔ zhuǎn","abbr":"ccjz","explanation":"指重重忧愁萦绕心怀。","source":{"text":"玉楼春暖笙歌夜，肯信愁肠日九回。","book":"唐·崔鲁《春日长安即事》诗"},"example":{"text":"我终日里～，到如今尺素空传。","book":"明·邵璨《香囊记·得书》"},"similar":["愁肠百结"],"opposite":["喜笑颜开"],"usage":"作谓语、状语；指十分忧愁"},{"id":19816,"word":"愁肠寸断","pinyin":"chóu cháng cùn duàn","abbr":"cccd","explanation":"愁肠：忧思萦绕的心肠。愁得肠子都断成一段段的。形容忧愁到了极点。","source":{"text":"泪脸千行，愁肠寸断，端坐横琴，涕血流襟。","book":"唐·张鷟《游仙窟》"},"example":{"text":"她现在愁得～。"},"similar":["愁肠九转","心事重重","忧心忡忡"],"opposite":["称心如意","欢欣鼓舞","喜笑颜开"],"usage":"作谓语、定语、状语；形容极端忧愁苦"},{"id":19817,"word":"愁肠殢酒","pinyin":"chóu cháng tì jiǔ","abbr":"cctj","explanation":"愁长：愁闷的心肠；殢：困扰。心肠愁闷的人容易病酒。","source":{"text":"愁肠殢酒人千里。","book":"唐·韩偓《有亿》"},"example":{"text":"长安故人问我，道～只依然。","book":"宋·辛弃疾《木兰花慢·滁州送范倅》词"},"usage":"作宾语；指烦恼多"},{"id":19818,"word":"愁肠百结","pinyin":"chóu cháng bǎi jié","abbr":"ccbj","explanation":"愁肠：忧愁的心肠。百结：极多的结头。忧愁苦闷的心肠好像凝结成了许多的疙瘩。形容愁绪郁结，难于排遣。","source":{"text":"愁肠百结虚成着，口口口行没处论。","book":"《敦煌变文集·王昭君变文》"},"example":{"text":"夜深独坐对残灯，默默怀人百感增。～如丝乱，珠泪千行似雨倾。","book":"明·洪楩《清平山堂话本·风月相思》"},"similar":["愁肠寸断","忧心忡忡"],"opposite":["沾沾自喜","洋洋得意"],"usage":"作谓语、定语；形容非常烦恼、忧愁"},{"id":19819,"word":"愁长殢酒","pinyin":"chóu cháng tì jiǔ","abbr":"cctj","explanation":"愁长：愁闷的心肠；殢：困扰。心肠愁闷容易病酒。","source":{"text":"愁肠殢酒人千里。","book":"唐·韩偓《有亿》"},"example":{"text":"长安故人问我，道～只依然。","book":"宋·辛弃疾《木兰花慢·滁州送范倅》词"}},{"id":19820,"word":"愁颜不展","pinyin":"chóu yán bù zhǎn","abbr":"cybz","explanation":"展：舒展。心里忧愁，双眉紧锁。形容心事重重的样子。","source":{"text":"奈我丈夫每日只是攻文习武，衣食艰苦，颇觉失望，以此愁颜不展。","book":"明·沈采《千金记·省女》"},"similar":["愁眉不展"],"usage":"作谓语、定语、状语；形容心事重重的样子"},{"id":19821,"word":"愁颜赧色","pinyin":"chóu yán nǎn sè","abbr":"cyns","explanation":"赧：羞惭脸红。面带愁容和愧色。","source":{"text":"宋江、卢俊义出内，卸了公服檏头，上马回营，面有愁颜赧色。","book":"明·施耐庵《水浒传》第110回"},"usage":"作宾语、定语；用于人的形貌"},{"id":19822,"word":"愆德隳好","pinyin":"qiān dé huī hǎo","abbr":"qdhh","explanation":"愆：过失；隳：毁坏。损害道义，破坏友好。指破坏了道义原则和友好关系。","source":{"text":"主上矜愍豫州之身，无有处所，不爱土地士人之力，使有所庇廕以济其患，而豫州私独饰情，愆德隳好。","book":"《三国志·吴志·周瑜传》裴松之注引《吴书》"},"example":{"text":"而皇叔～，已得西川，又占荆州，贪而忘义，恐为天下所耻笑。","book":"明·罗贯中《三国演义》第六十六回"},"usage":"作谓语、宾语；用于处事"},{"id":19823,"word":"愆戾山积","pinyin":"qiān lì shān jī","abbr":"qlsj","explanation":"愆：过失；戾：罪过。罪过很多，累积如山。","source":{"text":"臣委质以来，愆戾山积。","book":"晋·陈寿《三国志·蜀志·刘封传》裴松之注引《魏略》"},"example":{"text":"臣委质以来，～，臣犹自知。","book":"明·罗贯中《三国演义》第79回"},"usage":"作谓语、宾语；指罪孽深重"},{"id":19824,"word":"愍不畏死","pinyin":"mǐn bù wèi sǐ","abbr":"mbws","explanation":"愍：祸乱。形容强盗恶霸是不怕死的亡命之徒。","source":{"text":"自非李元平、源休、张光晟辈之愍不畏死，谁则从之？","book":"清·王夫之《读通鉴论》卷二十四"},"example":{"text":"是谓～。会晔家母妻，并来探视，且泣且詈，晔无愧色，亦无戚容。","book":"蔡东藩《南北史演义》第十四回"}},{"id":19825,"word":"意中人","pinyin":"yì zhōng rén","abbr":"yzr","explanation":"心意相知的友人，后多指心中所眷恋的人。","source":{"text":"药石有时闲，念我意中人。","book":"晋·陶潜《示周祖谢三郎》"},"example":{"text":"～此时无恙，方能遂我意中也。","book":"清·李玉《意中人·圆叙》"},"usage":"作主语、宾语、定语；指心里恋慕的人"},{"id":19826,"word":"意义深长","pinyin":"yì yì shēn cháng","abbr":"yysc","explanation":"意思含畜深远，耐人寻味。同“意味深长”。","source":{"text":"这些简单而意义深长的话我还能够了解。","book":"巴金《旅途随笔·别》"},"similar":["意味深长"],"usage":"作定语、状语；指耐人寻味"},{"id":19827,"word":"意乌猝嗟","pinyin":"yì wū cù jiē","abbr":"ywcj","explanation":"意乌：怒吼声；猝嗟：通“叱嗟”，怒斥声。指厉声怒喝。","source":{"text":"项王意乌猝嗟，千人皆废，然不能任属贤将，此特匹夫之勇也。","book":"《汉书·韩信传》"}},{"id":19828,"word":"意乱如麻","pinyin":"yì luàn rú má","abbr":"ylrm","explanation":"心里乱得象一团乱麻。形容心里非常烦乱。","source":{"text":"心绪乱如麻，空怀畴昔时。","book":"《隋书·孙万寿传》"},"example":{"text":"公子此时～，只有答应的分儿，也不及合那些人置辩。","book":"清·文康《儿女英雄传》第三回"}},{"id":19829,"word":"意乱心忙","pinyin":"yì luàn xīn máng","abbr":"ylxm","explanation":"犹心忙意乱。心里着慌，乱了主意。","source":{"text":"可耐此时是意乱心忙，眼光不定，看了半日，再也看不明白。","book":"清·文康《儿女英雄传》第三十八回"}},{"id":19830,"word":"意乱心慌","pinyin":"yì luàn xīn huāng","abbr":"ylxh","explanation":"心中慌乱无主。","source":{"text":"太平无事，尚可优游自在，一旦有警，早已吓得意乱心慌，等到上头派了下来，更把他急的走头无路。","book":"清·李宝嘉《官场现形记》第十二回"},"similar":["意急心忙","心慌意乱"],"usage":"作谓语、状语；用于处事"},{"id":19831,"word":"意兴盎然","pinyin":"yì xìng àng rán","abbr":"yxar","explanation":"意兴：兴致。盎然：指气氛、趣味等洋溢的样子。形容兴致很浓的样子。","source":{"text":"一路行来，有雨趣而无淋漓之苦，自然也就格外感到意兴盎然。","book":"李健吾《雨中登泰山》"},"example":{"text":"他们饮酒看花，征逐花草，及时行乐，～。","book":"丁中江《北洋军阀史话·副总统难产》"}},{"id":19832,"word":"意兴索然","pinyin":"yì xīng suǒ rán","abbr":"yxsr","explanation":"索然：全无，空尽。兴致全无。形容一点兴致也没有。亦作“兴致索然”。","source":{"text":"圣人无字门人者，‘孝哉……’一句，即是人言。”王闻之，意兴索然。","book":"《东周列国志》第七十一回：“景公意兴索然。左右问曰：‘将回宫乎？’景公曰：‘可移於梁邱大夫之家。’”清·蒲松龄《聊斋志异·仙人岛》：“绿云顾父曰"},"example":{"text":"不到两个时辰，我的意兴早已索然，颇悔此来为多事了。","book":"鲁迅《彷徨·在酒楼上》"},"similar":["兴致索然"],"usage":"作谓语、定语、状语；用于处事"},{"id":19833,"word":"意兴阑珊","pinyin":"yì xìng lán shān","abbr":"yxls","explanation":"阑珊：衰落。将残、将尽的意思。","source":{"text":"白发满头归得也，诗情酒兴渐阑珊。","book":"唐·白居易《咏怀》诗"},"example":{"text":"李太太～，眼光回到学生点名册上，觉得自己写的淡铅笔字一片模糊。","book":"叶圣陶《逃难》"},"usage":"作谓语、定语；用于书面语"},{"id":19834,"word":"意况大旨","pinyin":"yì kuàng dà zhǐ","abbr":"ykdz","explanation":"意况：概要；旨：宗旨，大意。指概括大意。","source":{"text":"法穆时共影为臣开述《九章》数家杂要，披释章次意况大旨。","book":"《魏书·殷绍传》"}},{"id":19835,"word":"意出望外","pinyin":"yì chū wàng wài","abbr":"ycww","explanation":"出乎意料之外。","source":{"text":"宝玉勾着贾母，原为要赞黛玉，不想反赞起宝钗来，倒也意出望外，便看着宝钗一笑。","book":"清·曹雪芹《红楼梦》第35回"},"example":{"text":"这事让我～。"},"similar":["出乎意料"],"opposite":["意料之中"],"usage":"作谓语；指出乎意料之外"},{"id":19836,"word":"意出言外","pinyin":"yì chū yán wài","abbr":"ycyw","explanation":"意思或含义表现于语言、文辞上。","source":{"text":"二人坐，与勣谈久，往往有异义出于言外。","book":"唐·王度《古镜记》"}},{"id":19837,"word":"意出象外","pinyin":"yì chū xiàng wài","abbr":"ycxw","explanation":"语言的真正用意没有明白说出来，细细体会就知道。形容文辞含蓄，意味深长。","source":{"text":"王宰，大历中家于蜀川，能画山水，意出象外。","book":"宋·胡仔《苕溪渔隐丛话前集》卷八"}},{"id":19838,"word":"意切言尽","pinyin":"yì qiè yán jìn","abbr":"yqyj","explanation":"意思恳切，言辞毫无保留。","source":{"text":"齐终之前一日自修遗表，初述感恩陈力之大义，中及朝廷刑政之或阙，意切言尽，神识不昏。","book":"唐·刘禹锡《唐故相国赠司空令狐公集纪》"},"similar":["意切辞尽"],"usage":"作谓语、定语；用于处事"},{"id":19839,"word":"意切辞尽","pinyin":"yì qiè cí jìn","abbr":"yqcj","explanation":"意思恳切，言辞毫无保留。","source":{"text":"伏望试以狂言访于所知之厚者。意切辞尽，不暇文饰，伏惟少赐省察。","book":"唐·李翱《劝裴相不自出征书》"},"similar":["意切言尽"],"usage":"作谓语、定语；用于处事"},{"id":19840,"word":"意到笔随","pinyin":"yì dào bǐ suí","abbr":"ydbs","explanation":"指写诗绘画时一旦思绪或构思清晰成熟，即刻可将意境现诸笔端。形容运笔时文思敏捷。","source":{"text":"香山《琵琶行》，婉折周详，有意到笔随之妙。","book":"清·黄子云《野鸿诗的》"}},{"id":19841,"word":"意前笔后","pinyin":"yì qián bǐ hòu","abbr":"yqbh","explanation":"指先构思成熟，然后下笔，使意境得到充分表现。","source":{"text":"若执笔近而不能紧者，心手不齐，意后笔前者败；若执笔远而急，意前笔后者胜。","book":"晋·卫铄《笔阵图》"},"example":{"text":"～者，熟玩古帖，于字形大小，偃仰、平直、疏密纤秾，蕴藉于心，临纸瞑然，豫想其法，随物赋形，各得其理。","book":"明·丰坊《笔诀》"},"similar":["意在笔先","意在笔前"],"opposite":["意后笔前"],"usage":"作宾语、定语；用于写作等"},{"id":19842,"word":"意前笔启","pinyin":"yì qián bǐ qǐ","abbr":"yqbq","explanation":"意：构思。指写字画画，先构思成熟，然后下笔。","source":{"text":"夫欲书者，先干研墨，凝神静思，预想字形大小，偃仰平直振动，令筋脉相连，意在笔前，然后作字。","book":"晋·王羲之《题卫夫人笔阵图后》"}},{"id":19843,"word":"意合情投","pinyin":"yì hé qíng tóu","abbr":"yhqt","explanation":"犹情投意合。形容双方思想感情融洽，合得来。","source":{"text":"自老孙当年与他相会，真个意合情投，交游甚厚。","book":"明·吴承恩《西游记》第四十二回"},"example":{"text":"～，惜相见之晚，相离之速。","book":"清·秋瑾《致琴文书》"},"similar":["情投意合"],"usage":"作谓语、宾语、状语；用于交往等"},{"id":19844,"word":"意味深长","pinyin":"yì wèi shēn cháng","abbr":"ywsc","explanation":"意味：情调，趣味。意思含畜深远，耐人寻味。","source":{"text":"读之愈久，但觉意味深长。","book":"宋·程颢、程颐《河南程氏遗书》"},"example":{"text":"书中所述的人生哲理，～。","book":"朱自清《经典常谈·四书第七》"},"similar":["情意深长","语重情长","语重心长"],"opposite":["兴味索然","索然无味"],"usage":"作定语、状语、补语；指耐人寻味"},{"id":19845,"word":"意味索然","pinyin":"yì wèi suǒ rán","abbr":"ywsr","explanation":"索然：毫无兴致的样子。一点儿兴趣都没有。形容喜好某种事物的情绪一下子冷落下来。","source":{"text":"今世庸吏不足道，能吏往往以有余自夸，不知余而必尽，意味索然。","book":"宋·袁甫《华亭县修复经界记》"},"example":{"text":"可是起初原是逢场作戏，或尚不伤廉惠；以后居然有了价格，便觉～了。","book":"朱自清《扬州的夏日》"}},{"id":19846,"word":"意在笔先","pinyin":"yì zài bǐ xiān","abbr":"yzbx","explanation":"指写字画画，先构思成熟，然后下笔。","source":{"text":"夫欲书者，先干研墨，凝神静思，预想字形大小，偃仰平直振动，令筋脉相连，意在笔前，然后作字。","book":"晋·王羲之《题卫夫人笔阵图后》"},"example":{"text":"所谓沈郁者，～，神余言外。","book":"清·陈廷焯《白雨斋词话》卷一"},"similar":["意在笔前"],"usage":"作主语、谓语；用于文章"},{"id":19847,"word":"意在笔前","pinyin":"yì zài bǐ qián","abbr":"yzbq","explanation":"①指写字构思在落笔以前。②作诗文先作思想上的酝酿，然后着笔。亦作“意在笔先”。","source":{"text":"夫欲书者，先干研墨，凝神静思，预想字形大小，偃仰平直振动，令筋脉相连，意在笔前，然后作字。","book":"晋·王羲之《题卫夫人笔阵图后》"},"similar":["意前笔后","意在笔先"],"usage":"作宾语、定语；用于作文等"},{"id":19848,"word":"意在笔外","pinyin":"yì zài bǐ wài","abbr":"yzbw","explanation":"意思或含义表现于笔墨之外。","source":{"text":"往往意在笔外，气足以胜之也。","book":"宋·邓牧《伯牙琴·洞霄诗集序》"}},{"id":19849,"word":"意在言外","pinyin":"yì zài yán wài","abbr":"yzyw","explanation":"语言的真正用意没有明白说出来，细细体会就知道。","source":{"text":"此绝句极佳，意在言外，而幽怨之情自见，不待明言之也。","book":"宋·胡仔《苕溪渔隐丛话后集》卷十五"},"example":{"text":"无奈红蕖～，总要侍奉祖父百年后方肯远离。任凭若劝，执意不从。","book":"清·李汝珍《镜花缘》第十回"},"similar":["意在言表"],"opposite":["弦外之音","话里有话","隐约其辞"],"usage":"作谓语、状语；指语意含蓄"},{"id":19850,"word":"意境融彻","pinyin":"yì jìng róng chè","abbr":"yjrc","explanation":"指在文艺创作中所描画的生活图景与表现的思想内涵完全融合在一起。","source":{"text":"作诗之妙，全在意境融彻，出音声之外，乃得真味。","book":"明·朱承爵《存余堂诗话》"}},{"id":19851,"word":"意外之财","pinyin":"yì wài zhī cái","abbr":"ywzc","explanation":"意料之外的钱财。","source":{"text":"且说周老爷凭空得了一千五百块洋钱，也算意外之财，拿了他便一直前往浙江。","book":"清·李宝嘉《官场现形记》第11回"},"example":{"text":"～不可取。"},"usage":"作主语、宾语；指没想到的钱财"},{"id":19852,"word":"意夺神骇","pinyin":"yì duó shén hài","abbr":"ydsh","explanation":"意夺：意志消沉；神：精神。人的意志消沉，精神受到严重创伤。","source":{"text":"是以别方不定，别理千名，有别必怨，有怨必盈。使个意夺神骇，心折骨惊。","book":"南朝·梁·江淹《别赋》"}},{"id":19853,"word":"意存笔先","pinyin":"yì cún bǐ xiān","abbr":"ycbx","explanation":"意：构思。指写字作画，先构思成熟，然后下笔。","source":{"text":"顾恺之之迹，紧劲联绵，循环超忽，调格逸易，风趋电疾，意存笔先，画尽意在，所以全神气也。","book":"唐·张彦远《历代名画记》卷二"}},{"id":19854,"word":"意广才疏","pinyin":"yì guǎng cái shū","abbr":"ygcs","explanation":"意：意愿，志向。志向远大，但才能浅薄。指志大才疏。","source":{"text":"臣素不识浚，亦闻其人意广才疏，虽有勤王之节，安蜀之功，然其败事亦不少。","book":"宋·杨万里《陈公墓志铭》"},"example":{"text":"～，事与古先殊别。","book":"元·魏初《石州慢·次高郎中道凝韵》词"},"similar":["志大才疏"],"usage":"作谓语、定语；用于人"},{"id":19855,"word":"意度过人","pinyin":"yì dù guò rén","abbr":"ydgr","explanation":"意度：见识与度量。指人的见识与度量不同寻常，超过一般人。","source":{"text":"郭琼东郡人也，形貌丑劣而意度过人。","book":"汉·郭宪《洞冥记》卷二"}},{"id":19856,"word":"意往神驰","pinyin":"yì wǎng shén chí","abbr":"ywsc","explanation":"形容心神向往，不能自持。","source":{"text":"不住的面红耳赤，意往神驰，身上不知怎样才好。","book":"《二十年目睹之怪现状》第一回"},"similar":["心往神驰"],"usage":"作谓语、状语；用于书面语"},{"id":19857,"word":"意得志满","pinyin":"yì dé zhì mǎn","abbr":"ydzm","explanation":"因愿望实现而心满意足。亦作“志得意满”。","source":{"text":"今汉王大败亏输，项王意得志满。","book":"元·尚仲贤《气英布》第一折"},"similar":["意满志得"],"usage":"作谓语、定语；指满足"},{"id":19858,"word":"意忌信谗","pinyin":"yì jì xìn chán","abbr":"yjxc","explanation":"意忌：猜忌；谗：谗言。怀疑忌妒，听信谗言。","source":{"text":"大王诚能出捐数万斤金，行反间，间其君臣，以疑其心，项王为人意忌信谗，必内相诛。","book":"《史记·陈丞相世家》"}},{"id":19859,"word":"意思意思","pinyin":"yì sī yì sī","abbr":"ysys","explanation":"略表心意。","source":{"text":"第一趟上门来看老伯母，总要意思意思，新茶陈火腿，是我自己的孝敬。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"我派她给你～。"},"usage":"作谓语、宾语；用于交际"},{"id":19860,"word":"意急心忙","pinyin":"yì jí xīn máng","abbr":"yjxm","explanation":"犹心慌意乱。心里着慌，乱了主意。","source":{"text":"不由我意急心忙出洞天，你道是地惨天昏沧海乾。","book":"明·无名氏《双林坐化》楔子"},"example":{"text":"崇应彪见父亲败走，～，慌了手脚。","book":"明·许仲琳《封神演义》第二回"},"similar":["意乱心慌"],"usage":"作谓语、状语；用于处事"},{"id":19861,"word":"意想不到","pinyin":"yì xiǎng bù dào","abbr":"yxbd","explanation":"料想不到，没有料到。","source":{"text":"今日这般寒冷，满天雪片飘扬，仙姑忽然下顾，真是意想不到。","book":"清·李汝珍《镜花缘》第二回"},"example":{"text":"我走进房间，看见～的景象。","book":"叶圣陶《小妹妹》"},"similar":["出乎意料"],"opposite":["意料之中"],"usage":"作宾语、定语；指出乎意料"},{"id":19862,"word":"意惹情牵","pinyin":"yì rě qíng qiān","abbr":"yrqq","explanation":"惹：引起。牵：牵挂。引起情感上的缠绵牵挂。","source":{"text":"把泪偷弹，把泪偷弹，千种离情，两下难言，意惹情牵，肠断心剜。","book":"明·高濂《玉簪记·促试》"},"example":{"text":"欹枕无眠，～，旧愁流水逝，新恨海潮添。","book":"《群音类选·清腔类·醉扶归》"},"usage":"作谓语、定语；用于书面语"},{"id":19863,"word":"意意似似","pinyin":"yì yì sì sì","abbr":"yyss","explanation":"指说话犹豫、支吾，虽然说了一点但又不知所云。","source":{"text":"嗔道贼臭肉在那里坐着，见了俺每意意似似，待起不起的，谁知原来背地有这本帐！","book":"明·兰陵笑笑生《金瓶梅词话》第二十五回"}},{"id":19864,"word":"意意思思","pinyin":"yì yì sī sī","abbr":"yyss","explanation":"指说话犹豫、支吾，虽然说了一点但又不知所云。","source":{"text":"他只意意思思就撂过手了。你叫我有什么法儿。","book":"清·曹雪芹《红楼梦》第六十五回"}},{"id":19865,"word":"意慵心懒","pinyin":"yì yōng xīn lǎn","abbr":"yyxl","explanation":"慵、懒：怠倦，消沉。心情怠倦消沉。同“意懒心慵”。","source":{"text":"相公，非弹不惯，只是你意慵心懒。","book":"元·高明《琵琶记·琴诉荷池》"},"similar":["意懒心慵"],"usage":"作谓语、定语、状语；用于人的心境"},{"id":19866,"word":"意懒心慵","pinyin":"yì lǎn xīn yōng","abbr":"ylxy","explanation":"懒、慵：怠倦，消沉。心情怠倦消沉。亦作“意慵心懒”。","source":{"text":"这些时意懒心慵，闷恹恹似痴如梦。","book":"元·季子安《粉蝶儿·题情》套曲"},"example":{"text":"明·无名氏《广成子》第二折：“抵多少杜鹃声唤醒游仙梦，你听波说的他意痴痴～。”"},"similar":["意慵心懒"],"usage":"作谓语、定语、状语；用于人的心境"},{"id":19867,"word":"意懒心灰","pinyin":"yì lǎn xīn huī","abbr":"ylxh","explanation":"心、意：心思，意志；灰、懒：消沉，消极。灰心失望，意志消沉。","source":{"text":"不是我心灰意懒，怎陪伴愚眉肉眼。","book":"元·乔吉《乔梦符小令·玉交枝·头适二曲》"},"example":{"text":"因此上怪他每每不听我说，故我～，说各人散了。","book":"明·吴承恩《西游记》第四十回"},"similar":["心灰意懒"],"usage":"作谓语、定语、状语；指不思进取"},{"id":19868,"word":"意懒情疏","pinyin":"yì lǎn qíng shū","abbr":"ylqs","explanation":"懒：怠倦，消沉。意志消沉，感情淡漠。","source":{"text":"那呆子意懒情疏，徉徉推托。","book":"明·吴承恩《西游记》第六十三回"}},{"id":19869,"word":"意扰心烦","pinyin":"yì rǎo xīn fán","abbr":"yrxf","explanation":"心思烦乱，不知怎样才好。","source":{"text":"遇着个不贤之妇，今日要衣裳，明日要首饰，少柴没米，称酱打油，激聒得你眼花撩乱，意扰心烦。","book":"明·冯梦龙《醒世恒言》引起"},"usage":"作谓语、状语；用于处事"},{"id":19870,"word":"意指为狱","pinyin":"yì zhǐ wéi yù","abbr":"yzwy","explanation":"意指：意之所在；狱：监狱。不依据法律，只以上司的意图量刑判罪。","source":{"text":"君为天子决平，不循三尺法，专以人主意指为狱。","book":"《史记·酷吏列传》"}},{"id":19871,"word":"意攘心劳","pinyin":"yì rǎng xīn láo","abbr":"yrxl","explanation":"犹心慌意乱。心里着慌，乱了主意。","source":{"text":"卢生也，也是你三生累积功千劫，教我一夜思量计万条，意攘心劳。","book":"明·无名氏《三化邯郸》第二折"},"usage":"作谓语、状语；用于书面语"},{"id":19872,"word":"意料之外","pinyin":"yì liào zhī wài","abbr":"ylzw","explanation":"没有想到的。","source":{"text":"天下事常常出于人意料之外。","book":"宋·陈亮《与吕伯恭正字书》"},"example":{"text":"这事太突然，出乎我的～。"},"opposite":["意料之中","不出所料"],"usage":"作宾语、定语；指没考虑到"},{"id":19873,"word":"意断恩绝","pinyin":"yì duàn ēn jué","abbr":"ydej","explanation":"指情义断绝。","source":{"text":"情浓时热烘烘买笑追欢，兴阑也冷冰冰意断恩绝。","book":"元·无名氏《一枝花·盼望》"},"similar":["义断恩绝","恩断义绝"],"usage":"作谓语、定语；用于交往等"},{"id":19874,"word":"意望已过","pinyin":"yi wang yi guo","abbr":"ywyg","explanation":"已经超出了原先的愿望。"},{"id":19875,"word":"意气扬扬","pinyin":"yì qì yáng yáng","abbr":"yqyy","explanation":"扬扬：得意的样子。形容很得意的样子。","source":{"text":"拥大盖，策驷马，意气扬扬，甚自得也。","book":"《史记·管晏列传》"},"example":{"text":"他见别人惧怕，没奈何他，～，自以为得计。","book":"明·冯梦龙《警世通言》卷三"},"similar":["洋洋自得","意气洋洋"],"opposite":["灰心丧气"],"usage":"作谓语、定语、状语；形容得意时","story":["春秋时期，齐国宰相晏婴乘车外出，他在车上温良谦恭，而他的车夫挥动鞭子策马而行，意气扬扬，甚为自得。车夫的妻子瞧见后回家劝车夫不要那样扬扬自得、仗势自侍。车夫第二天就立即更正自己的态度，晏婴认为他是可塑之才"]},{"id":19876,"word":"意气洋洋","pinyin":"yì qì yáng yáng","abbr":"yqyy","explanation":"形容很得意的样子。同“意气扬扬”。","source":{"text":"今时晚生晚辈，头角撑狞，稍能自振，则意气洋洋。","book":"汉·刘向《列女传·齐相御妻》：“齐相晏子仆御之妻也。号曰命妇。晏子将出，命妇窥其夫为相御，拥大盖，策驷马，意气洋洋，甚自得也。”宋·俞文豹《吹剑四录》"},"example":{"text":"陛下岂不闻晏平仲为齐相，人都道乘车相忧心悄悄，御车吏～。","book":"元·宫大用《范张鸡黍》第四折"},"similar":["意气扬扬"],"usage":"作谓语、定语、状语；用于得意时","story":["春秋时期，齐国三朝相国晏婴身居高位，但十分谦恭，而他的车夫却认为自己能替相国驾车十分得意扬扬。车夫的妻子见了就告诫车夫，应该向晏婴学习，车夫从此变得很谦逊起来，晏婴认为他知错能改就把他推荐给齐景公，被封为大夫"]},{"id":19877,"word":"意气激昂","pinyin":"yì qì jī áng","abbr":"yqja","explanation":"意气：意志和气概。形容精神振奋，气概豪迈。","source":{"text":"形骸岁岁就枯朽，意气时时犹激昂。","book":"宋·陆游《剑南诗稿·秋怀》"}},{"id":19878,"word":"意气用事","pinyin":"yì qì yòng shì","abbr":"yqys","explanation":"意气：主观偏激的情绪；用事：行事。缺乏理智，只凭一时的想法和情绪办事。","source":{"text":"世忠固一代名将，然少年时意气用事，亦多有可议者。","book":"清·赵翼《廿二史札记·卷二十三·宋史各传回护处·韩世忠》"},"example":{"text":"至今想来，究竟还是～，并不曾报效得朝廷，倒惹得同官心中不快活，却也悔之无及。","book":"清·吴敬梓《儒林外史》第四十六回"},"similar":["感情用事"],"opposite":["三思而行"],"usage":"作谓语、状语、宾语；指容易冲动"},{"id":19879,"word":"意气相亲","pinyin":"yì qì xiāng qīn","abbr":"yqxq","explanation":"意气：志趣性格。指志趣和性格相同的人，彼此投合。","source":{"text":"由来意气合，直取性情真。","book":"唐·杜甫《赠王二十四侍御》"}},{"id":19880,"word":"意气相倾","pinyin":"yì qì xiāng qīng","abbr":"yqxq","explanation":"志趣性情十分投合。","source":{"text":"虽声迹差池，藐不相闻，然意气相倾，殆若朝夕与游处者。","book":"宋·张孝祥《与虞并父书》"},"similar":["意气相许","意气相投","意气相合"],"usage":"作谓语、定语、状语；指情趣相同"},{"id":19881,"word":"意气相合","pinyin":"yì qì xiāng hé","abbr":"yqxh","explanation":"意气：志趣性格；合：合得来。指志趣和性格相同的人，彼此投合。","source":{"text":"由来意气合，直取性情真。","book":"唐·杜甫《赠王二十四侍御》"},"example":{"text":"两人～，抵掌而谈者三日。","book":"清·褚人获《隋唐演义》第三十七回"},"similar":["意气相投","意气相倾","意气相许"],"usage":"作谓语、定语、状语；指情趣相同"},{"id":19882,"word":"意气相得","pinyin":"yì qì xiāng dé","abbr":"yqxd","explanation":"形容志趣极其相合。","source":{"text":"魏领军元叉，权重当世，以意气相得，接乾甚厚。","book":"唐·李百药《北齐书·高乾传》"},"example":{"text":"清·戴名世《赠叶苍岩序》：“苍岩与吾生同岁，自儿时初学文，即～甚欢。”"},"similar":["意气相投"],"usage":"作谓语、定语、状语；指情趣相同"},{"id":19883,"word":"意气相投","pinyin":"yì qì xiāng tóu","abbr":"yqxt","explanation":"意气：志趣性格；投：合得来。指志趣和性格相同的人，彼此投合。","source":{"text":"由来意气合，直取性情真。","book":"唐·杜甫《赠王二十四侍御》"},"example":{"text":"咱～，你知我心忧。","book":"元·宫大用《范张鸡黍》"},"similar":["气味相投","志同道合","情投意合"],"opposite":["臭味相投","一丘之貉"],"usage":"作谓语、定语、状语；指情趣相同"},{"id":19884,"word":"意气相许","pinyin":"yì qì xiāng xǔ","abbr":"yqxx","explanation":"意气：志趣性格。指志趣和性格相同的人，彼此投合。","source":{"text":"王荆公少以意气相许，故诗惟其所向，不复更为涵蓄。","book":"宋·叶梦得《石林诗话》卷中"},"example":{"text":"大丈夫～，头颅可断，何况一妾！我主张已定，休得推阻。","book":"明·冯梦龙《喻世明言》卷六"},"similar":["意气相投","意气相倾","意气相合"],"usage":"作谓语、定语、状语；指情趣相同"},{"id":19885,"word":"意气自如","pinyin":"yì qì zì rú","abbr":"yqzr","explanation":"比喻遇事神态自然，十分镇静。同“意气自若”。","source":{"text":"会日暮，吏士皆无人色，而广意气自如，益治军。","book":"《史记·李将军列传》"},"example":{"text":"逮江上之变，生所携及留军用者，亡散累千金，再贫困而～。","book":"清·吴伟业《柳敬亭传》"},"similar":["意气自若","镇定自若"],"usage":"作谓语、定语；指人意态自如","story":["西汉时期，能征善战的将军李广领兵抗击北方的匈奴入侵，他率领4千骑兵被匈奴左贤王以4万骑兵团团围住，士卒们十分恐惧，个个吓得面无人色，李广则神色自若，意气自如，指挥有方，终于杀出重围，获得胜利"]},{"id":19886,"word":"意气自得","pinyin":"yì qì zì dé","abbr":"yqzd","explanation":"意气：神态，气势；自得：自觉得意。形容十分骄傲得意的样子。","source":{"text":"兄颢入洛，成败未分，便以意气自得为时人所笑。","book":"《魏书·北海王子颢传》"},"example":{"text":"宋·曾敏行《独醒杂志》第一卷：“刘伟明葊少以才学自负，擢高第，中词科，～，下视同辈。”"},"usage":"作谓语、定语、状语；用于处事"},{"id":19887,"word":"意气自若","pinyin":"yì qì zì ruò","abbr":"yqzr","explanation":"自若：不改常态，还像原来的样子。神情自然如常。比喻遇事神态自然，十分镇静。亦作“意气自如”。","source":{"text":"广为匈奴所败，吏士皆无人色，广意气自若。","book":"《汉书·李广传》"},"example":{"text":"城中死伤日积，巷哭声相闻，应元慷慨登陴，～。","book":"清·邵长蘅《阎典史传》"},"similar":["意气自如"],"usage":"作谓语、定语；指人意态自如"},{"id":19888,"word":"意气轩昂","pinyin":"yì qì xuān áng","abbr":"yqxa","explanation":"神采焕发，气度不凡的样子。","source":{"text":"我见这人身虽寒俭，意气轩昂，模样又好。","book":"明·凌濛初《二刻拍案惊奇》卷二十六"},"example":{"text":"清·褚人获《隋唐演义》第37回：“只见一个少年，生得容貌魁伟，～，牵着一匹马。”"},"similar":["意气飞扬"],"usage":"作谓语、定语、状语；用于处事"},{"id":19889,"word":"意气风发","pinyin":"yì qì fēng fā","abbr":"yqff","explanation":"意气：意志和气概；风发：象风吹一样迅猛。意志和气慨像风一样强烈。形容精神振奋，气概豪迈。","source":{"text":"形骸岁岁就枯朽，意气时时犹激昂。","book":"三国·魏·曹植《魏德论》：“武皇之兴也，以道凌残，义气风发。”宋·陆游《剑南诗稿·秋怀》"},"example":{"text":"伟大的中国人民正在～地建设自己的祖国。"},"similar":["神采飞扬","意气焕发","英姿飒爽"],"opposite":["精神不振","心灰意冷","垂头丧气"],"usage":"作谓语、定语；形容年轻人"},{"id":19890,"word":"意气飞扬","pinyin":"yì qì fēi yáng","abbr":"yqfy","explanation":"犹意气风发。形容精神振奋，气概豪迈。","source":{"text":"我看华郎精神发越，意气飞扬，不久自然荣贵。","book":"清·李渔《慎鸾交·席卷》"},"example":{"text":"～好身手，勉之行矣莫踟躇。","book":"李光《友人刘竞生续学保定诗以送之》"},"similar":["意气轩昂","意气风发"],"usage":"作谓语、定语、状语；用于处事"},{"id":19891,"word":"意气高昂","pinyin":"yì qì gāo áng","abbr":"yqga","explanation":"意态和气慨雄健的样子。","example":{"text":"经过三个月的集训，国家女篮～严阵以待，准备迎战欧洲强队。"}},{"id":19892,"word":"意满志得","pinyin":"yì mǎn zhì dé","abbr":"ymzd","explanation":"因愿望实现而心满意足。形容踌躇满志的得意情态。同“意得志满”。","source":{"text":"一第进士，便意满志得，以为读书之事毕矣。","book":"清·黄宗羲《进士心友张君墓志铭》"},"example":{"text":"～好身手，勉之行矣莫踟躇。","book":"李光《友人刘竞生续学保定诗以送之》"},"similar":["意得志满"],"usage":"作谓语、定语；指满足"},{"id":19893,"word":"意犹未尽","pinyin":"yì yóu wèi jìn","abbr":"yywj","explanation":"犹：还。指还没有尽兴","source":{"text":"大家意犹未尽地散开，各回原位，互相交换着兴奋的眼神儿。","book":"王朔《懵然无知》"},"usage":"作宾语、定语、状语；用于处事等"},{"id":19894,"word":"意略纵横","pinyin":"yì lüè zòng héng","abbr":"ylzh","explanation":"意略：谋略；纵横：合纵连横，引申为经营天下之意。形容具有治国的才干。","source":{"text":"颇读诸子兵书，论军国大事，骑乘非所长，关弓亦甚弱，而意略纵横，果决能断。","book":"《宋书·王镇恶传》"}},{"id":19895,"word":"意简言赅","pinyin":"yì jiǎn yán gāi","abbr":"yjyg","explanation":"赅：完备。话不多，但意思都有了。形容说话写文章简明扼要。","source":{"text":"人之迷经者，盖己所守未明，故常为语言可以移动。己守既定，虽孔孟之言有纷错，亦不须思而改之，复锄去其繁，使词简而意备。","book":"宋·张载《张子全书·义理》"}},{"id":19896,"word":"意致纵横","pinyin":"yì zhì zòng héng","abbr":"yzzh","explanation":"意致：神情姿态；纵横：奔放。形容人的性格奔放。","source":{"text":"至于披文相质，意致纵横，才壮风云，义深渊海。","book":"南朝·陈·徐陵《与李那书》"}},{"id":19897,"word":"意虑乖僻","pinyin":"yì lǜ guāi pì","abbr":"ylgp","explanation":"意虑：思考；乖僻：古怪。所想的事情非常古怪离奇。","source":{"text":"竣时权倾朝野，偃不自安，遂发悸病，意虑乖僻。","book":"《南史·何尚之传》"}},{"id":19898,"word":"意见言外","pinyin":"yì jiàn yán wài","abbr":"yjyw","explanation":"语言的真正用意没有明白说出来，细细体会就知道。形容文辞含蓄，意味深长。","source":{"text":"此绝句极佳，意在言外，而幽怨之情自见，不待明言之也。","book":"宋·胡仔《苕溪渔隐丛话后集》卷十五"}},{"id":19899,"word":"意转心回","pinyin":"yì zhuǎn xīn huí","abbr":"yzxh","explanation":"心、意：心思；回、转：掉转。改变想法，不再坚持过去的意见。","source":{"text":"且人一日间，此心是起多少私意，起多少计较，都不会略略回心转意去看。","book":"宋·朱熹《朱子语类·训门人·五》"},"example":{"text":"若要我～，除是快把降旗展。","book":"明·徐复《投梭记·出关》"},"similar":["回心转意"],"usage":"作谓语；指改变主意"},{"id":19900,"word":"意领神会","pinyin":"yì lǐng shén huì","abbr":"ylsh","explanation":"领、会：领悟，理解。指对方没有明说，心里已经领会。","source":{"text":"予尝中夜以兴，整襟危坐，仰而顾，俯而思，意领神会，默与契合。","book":"宋·袁甫《蒙斋集·明月亭记》"},"example":{"text":"她的双手有力地拖拽他的腰，他立即～她的意图，忙翻起身又躺下去。","book":"陈忠实《白鹿原》第十章"}},{"id":19901,"word":"意马心猿","pinyin":"yì mǎ xīn yuán","abbr":"ymxy","explanation":"形容心思不定，好像猴子跳、马奔跑一样控制不住。","source":{"text":"机尽心猿伏，神闲意马行。","book":"汉·魏伯阳《参同契》注：“心猿不定，意马四驰。”唐·许浑《题杜居士》诗"},"example":{"text":"～萦梦寐，河鱼天雁托音书。","book":"清·吴趼人《二十年目睹之怪现状》第五回"},"similar":["心猿意马"],"usage":"作谓语、定语；指心情"},{"id":19902,"word":"愚不可及","pinyin":"yú bù kě jí","abbr":"ybkj","explanation":"愚：傻，笨，及：比得上。愚蠢得别人比不上。形容极其愚笨。","source":{"text":"宁武子，邦有道则知，邦无道则愚。其知可及也，其愚不可及也。","book":"《论语·公冶长》"},"example":{"text":"我看见这种认真的忙迫的情形时，心里总想开口向它们发一句～的提问——“往哪里去？！”","book":"鲁迅《华盖集续编·一点比喻》"},"similar":["愚昧无知","笨头笨脑"],"opposite":["足智多谋","大智若愚","耳聪目明"],"usage":"作宾语、定语；指人弱智"},{"id":19903,"word":"愚公移山","pinyin":"yú gōng yí shān","abbr":"ygys","explanation":"比喻坚持不懈地改造自然和坚定不移地进行斗争。","source":{"text":"《列子·汤问》记载：愚公家门前有两大座山挡着路，他决心把山平掉，另一个老人智叟笑他太傻，认为不能能。愚公说：我死了有儿子，儿子死了还有孙子，子子孙孙是没有穷尽的，两座山终究会凿平。"},"example":{"text":"在现代化建设中，我们要发扬～的精神。"},"similar":["锲而不舍","持之以恒","始终不渝"],"opposite":["虎头蛇尾","有头无尾"],"usage":"作主语、定语、宾语；指人的毅力","story":["传说古代有两座大山间住着一个90岁的愚公，他每次出门因大山阻隔，要绕很大的弯子，他把全家人召集起来，要他们用毕生的精力也要搬走太行、王屋两座山，好方便他们进出。他们积极行动，一家人每天不停地挖，他们的精神感动了玉帝"]},{"id":19904,"word":"愚夫俗子","pinyin":"yú fū sú zǐ","abbr":"yfsz","explanation":"指愚鲁凡俗的人。","source":{"text":"此物比不得那愚夫俗子，拿了可以当饭。","book":"明·吴承恩《西游记》第七十七回"},"example":{"text":"不惟～惑于其术，乃至学土大夫亦皆尊其教而趋习之。","book":"郭沫若《甲申三百年祭》"},"similar":["凡夫俗子"],"usage":"作主语、宾语；用于书面语"},{"id":19905,"word":"愚夫愚妇","pinyin":"yú fū yú fù","abbr":"yfyf","explanation":"旧时称平民百姓。","source":{"text":"予视天下，愚夫愚妇，一能胜予。","book":"《尚书·五子之歌》"},"example":{"text":"因为净土一宗，最是～所尊信的。","book":"章炳麟《东京留学生欢迎会演说辞》"},"similar":["愚夫蠢妇"],"usage":"作主语、宾语、定语；指无知的人"},{"id":19906,"word":"愚夫蠢妇","pinyin":"yú fū chǔn fù","abbr":"yfcf","explanation":"蒙昧无知之人。旧指小民百姓。","source":{"text":"愚夫蠢妇皆有流连之心，凄怆之志。","book":"《淮南子·本经训》"},"similar":["愚夫愚妇"],"usage":"作主语、宾语、定语；用于书面语"},{"id":19907,"word":"愚妄无知","pinyin":"yú wàng wú zhī","abbr":"ywwz","explanation":"形容又愚笨又没有知识。","source":{"text":"自顾寡德，国人推尊，令袭大位，光父之业。愚昧无知，敢希圣旨。","book":"唐·玄奘《大唐西域记·羯若鞠阇国》"},"example":{"text":"所看见的只是目前的利禄，个人的势位，而又～，轻举盲动。","book":"冯玉祥《我的生活》第二十三章"},"similar":["愚昧无知"],"usage":"作谓语、定语；指人弱智"},{"id":19908,"word":"愚弄人民","pinyin":"yú nòng rén mín","abbr":"ynrm","explanation":"指蒙骗愚弄百姓。","source":{"text":"浞行媚于内而施赂于外，愚弄其民而虞羿于田，树之诈慝以取其国家，外内咸服。","book":"《左传·襄公四年》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":19909,"word":"愚弄其民","pinyin":"yú nòng qí mín","abbr":"ynqm","explanation":"指蒙骗愚弄百姓。","source":{"text":"浞行媚于内而施赂于外，愚弄其民而虞羿于田，树之诈慝以取其国家，外内咸服。","book":"《左传·襄公四年》"}},{"id":19910,"word":"愚忠愚孝","pinyin":"yú zhōng yú xiào","abbr":"yzyx","explanation":"指不明事理，盲目愚蠢地尽忠尽孝。","source":{"text":"这姑娘的见解虽说愚忠愚孝，其实可敬可怜。","book":"清·文康《儿女英雄传》第二十五回"},"example":{"text":"徒死无补，亦～之流。","book":"蔡东藩《唐史演义》第七十八"}},{"id":19911,"word":"愚戆窳惰","pinyin":"yú zhuàn yǔ duò","abbr":"ygyd","explanation":"愚戆：愚昧不明事理；窳：懒惰。指既愚蠢又懒惰。","source":{"text":"是以愚戆窳惰之民，苦小费而忘大利也。","book":"《韩非子·南面》"},"example":{"text":"战国·韩·韩非《韩非子·南面》：“是以～之民，苦小费而忘大利也。”"},"usage":"作谓语、定语；用于书面语"},{"id":19912,"word":"愚昧无知","pinyin":"yú mèi wú zhī","abbr":"ymwz","explanation":"昧：糊涂，不明白。形容又愚笨又没有知识。","source":{"text":"自顾寡德，国人推尊，令袭大位，光父之业。愚昧无知，敢希圣旨。","book":"唐·玄奘《大唐西域记·羯若鞠阇国》"},"example":{"text":"想到这些，不禁令人憬然于天下本无神秘的事物，神秘只是欺骗或者～的代名词而已。","book":"秦牧《天坛幻想录》"},"similar":["蒙昧无知","无知无识"],"opposite":["大智若愚","明察秋毫","料事如神"],"usage":"作谓语、定语；指人弱智"},{"id":19913,"word":"愚昧落后","pinyin":"yú mèi luò hòu","abbr":"ymlh","explanation":"愚蠢而不明事理，跟不上形势等。","source":{"text":"而且要把一个被旧文化统治因而愚昧落后的中国，变成一个被新文化统治因而文明先进的中国。","book":"毛泽东《新民主主义论》"},"opposite":["文明先进"],"usage":"作谓语、定语；用于文化等"},{"id":19914,"word":"愚民安知","pinyin":"yu min an zhi","abbr":"ymaz","explanation":"无知的老百姓哪里会知道。"},{"id":19915,"word":"愚民政策","pinyin":"yú mín zhèng cè","abbr":"ymzc","explanation":"愚民：使人民愚昧。使人民变愚蠢的政策。","source":{"text":"他们在党内实行命令主义，遇事武断，实行家长式的统治，实行‘愚民政策’。","book":"刘少奇《论党》"},"usage":"作主语、宾语、定语；指愚弄人民"},{"id":19916,"word":"愚眉肉眼","pinyin":"yú méi ròu yǎn","abbr":"ymry","explanation":"指凡俗的眼光。","source":{"text":"今日我来度脱蓝采和，那厮愚眉肉眼，不识贫道。","book":"元·无名氏《蓝采和》第一折"},"example":{"text":"我和这等～难相瞅，凡胎浊骨难相守。","book":"元·无名氏《村乐堂》第一折"},"similar":["肉眼凡胎"],"usage":"作宾语、定语；用于书面语"},{"id":19917,"word":"愚者一得","pinyin":"yú zhě yī dé","abbr":"yzyd","explanation":"平凡的人在许多次考虑中，也会有一次是正确的。","source":{"text":"圣人千虑，必有一失；愚者千虑，必有一得。","book":"《晏子春秋·内篇杂下》"},"example":{"text":"安序顺天，～。","book":"清·张祥龄《词论》"}},{"id":19918,"word":"愚者千虑","pinyin":"yú zhě qiān lǜ","abbr":"yzql","explanation":"平凡的人在许多次考虑中，也会有一次是正确的。","source":{"text":"圣人千虑，必有一失；愚者千虑，必有一得。","book":"《晏子春秋·内篇杂下》"}},{"id":19919,"word":"愚者千虑，亦有一得","pinyin":"yú zhě qiān lǜ，yì yǒu yī dé","abbr":"yzqlyyyd","explanation":"指愚钝人的许多思虑中总会有一些可取之处。常以谦指己见。","source":{"text":"广武君曰：‘臣闻智者千虑，必有一失；愚者千虑，亦有一得。’","book":"《汉书·韩信传》"},"similar":["愚者千虑，必有一得"],"usage":"作定语、宾语、分句；用于劝诫人"},{"id":19920,"word":"愚者千虑，必有一得","pinyin":"yú zhě qiān lǜ，bì yǒu yī dé","abbr":"yzqlbyyd","explanation":"平凡的人在许多次考虑中，也会有一次是正确的。","source":{"text":"智者千虑，必有一失；愚者千虑，必有一得。","book":"《晏子春秋·内篇杂下》：“圣人千虑，必有一失；愚者千虑，必有一得。”《史记·淮阴侯列传》"},"example":{"text":"至于我的所说，可是我想，～，盖亦“悬诸日月而不利”之论也。","book":"鲁迅《且介亭杂文二集·名人和名言》"},"similar":["愚者千虑，终有一得"],"opposite":["智者千虑，必有一失"],"usage":"作状语、宾语、分句；用于劝诫人","story":["楚汉相争时期，韩信活捉赵王歇后，同时活捉他的参谋李左车。韩信十分谦虚地向李左车求取燕齐之道。李左车建议他暂时休整，同时加强伐燕的舆论攻势，可以不战而胜。他说：“智者千虑，必有一失；愚者千虑，必有一得。这些仅供参考。”"]},{"id":19921,"word":"愚者千虑，或有一得","pinyin":"yú zhě qiān lǜ，huò yǒu yī dé","abbr":"yzqlhyyd","explanation":"指愚钝人的许多思虑中总会有一些可取之处。常以谦指己见。","source":{"text":"苟有妖孽，某安敢不隳裂肝胆，为相公之腹心乎。愚者千虑，或有一得。伏愿相公少赐采择焉。","book":"唐·林蕴《上宰相元衡宏靖论兵书》"},"similar":["愚者千虑，亦有一得"],"usage":"作定语、宾语、分句；用于劝诫人"},{"id":19922,"word":"愚迷不悟","pinyin":"yú mí bù wù","abbr":"ymbw","explanation":"悟：醒悟。愚昧而不知醒悟。指极其愚蠢糊涂。","source":{"text":"凡心有虑尚依然，复归指、维舟沙浦。回首已茫茫，叹愚迷不悟。","book":"宋·史浩《太清舞》"},"example":{"text":"因你那东土众生，～，只可以此传之耳。","book":"明·吴承恩《西游记》第九十八回"}},{"id":19923,"word":"感人心脾","pinyin":"gǎn rén xīn pí","abbr":"grxp","explanation":"形容使人的内心深受感动。","source":{"text":"[琴子]为诗文，下笔累千言，皆感人心脾。","book":"清·顾彩《焚琴子传》"},"similar":["感人肺肝"],"usage":"作谓语、定语；指使人内心深深感动"},{"id":19924,"word":"感人肺肝","pinyin":"gǎn rén fèi gān","abbr":"grfg","explanation":"形容使人的内心深受感动。","source":{"text":"今考其文至论事疏，感人肺肝，毛发皆耸。","book":"唐·刘禹锡《唐故相国李公集纪》"},"similar":["感人心脾","感人肺腑"],"usage":"作谓语、定语；指使人内心深深感动"},{"id":19925,"word":"感人肺腑","pinyin":"gǎn rén fèi fǔ","abbr":"grff","explanation":"使人内心深深感动。","source":{"text":"轻重缓急，悠扬悦耳，动人心弦，感人肺腑。","book":"常贵田《喇吧声声》"},"example":{"text":"他在会上的发言～。"},"similar":["动人心弦","荡人心腑"],"opposite":["无动于衷"],"usage":"作谓语、定语；指使人内心深深感动"},{"id":19926,"word":"感人至深","pinyin":"gǎn rén zhì shēn","abbr":"grzs","explanation":"使人内心深深感动。","source":{"text":"今考其文至论事疏，感人肺肝，毛发皆耸。","book":"唐·刘禹锡《唐故相国李公集记》"}},{"id":19927,"word":"感今怀昔","pinyin":"gǎn jīn huái xī","abbr":"gjhx","explanation":"对当前的事物有所感触而怀念过去的人、事物或景物。","source":{"text":"仿佛未行，故瞻弗获；伏膺饮泪，感今怀昔。","book":"晋·潘岳《为诸妇祭庚新妇文》"},"example":{"text":"然而触于事物，～，考其见于赋咏者。","book":"金·蔡松年《雨中花》"},"similar":["感今思昔"],"usage":"作谓语、宾语、定语；指容易伤感"},{"id":19928,"word":"感今思昔","pinyin":"gǎn jīn sī xī","abbr":"gjsx","explanation":"对当前的事物有所感触而怀念过去的人、事物或景物。","source":{"text":"叹离多聚少，感今思昔。","book":"宋·刘珙《满江红·遥寿仲固叔谊》词"},"similar":["感今怀昔","感今惟昔"],"usage":"作谓语、宾语、定语；指容易伤感"},{"id":19929,"word":"感今惟昔","pinyin":"gǎn jīn wéi xī","abbr":"gjwx","explanation":"对当前的事物有所感触而怀念过去的人、事物或景物。","source":{"text":"瞻彼日月，迅过俯仰；感今惟昔，口存心想。","book":"晋·卢谌《赠刘琨》诗"},"similar":["感今怀昔","感今思昔"],"usage":"作谓语、宾语、定语；指容易伤感"},{"id":19930,"word":"感佩交并","pinyin":"gǎn pèi jiāo bìng","abbr":"gpjb","explanation":"感：感激；佩：佩服；交并：交织在一起。感激和佩服的心情交织在一起。","source":{"text":"感佩恩私，不知所喻。","book":"唐·李商隐《上尚书范阳公启》"}},{"id":19931,"word":"感同身受","pinyin":"gǎn tóng shēn shòu","abbr":"gtss","explanation":"感：感激；身：亲身。心里很感激，就象自己亲身领受到一样。","source":{"text":"再者北山在京，万事求二兄代为照顾，感同身受。","book":"清·籐谷古香《轰天雷》第二回"},"example":{"text":"你如果能给我解决三分之一，我真是～呢！（叶圣陶《感同身受》）"},"usage":"作谓语、宾语；指像自己亲身感受一样"},{"id":19932,"word":"感喟不置","pinyin":"gǎn kuì bù zhì","abbr":"gkbz","explanation":"感喟：有所感触而叹息；置：放到一边。指因深有感触而叹息不止。"},{"id":19933,"word":"感天动地","pinyin":"gǎn tiān dòng dì","abbr":"gtdd","explanation":"使苍天和大地为之感动。形容诚意感人至深。亦比喻使无情天地受感动。形容冤屈极大。","source":{"text":"夫至信之人，可以感物也。动天地，感鬼神，横六合，而无逆者，岂但履危险，入水火而已哉？","book":"《列子·黄帝篇》"},"example":{"text":"夫如是大雄之力，出死入生，至诚之神，～。","book":"唐·黄滔《大唐福州报恩定光多宝塔碑记》"},"similar":["惊天动地"],"opposite":["平淡无奇"],"usage":"作谓语、定语；指十分感人"},{"id":19934,"word":"感天地，动鬼神","pinyin":"gǎn tiān dì，dòng guǐ shén","abbr":"gtddgs","explanation":"感：感动。感动天地，使鬼神为之哭泣。形容事迹或文艺作品感人至深。","source":{"text":"向令风雅而不变，则诗为之道，狭隘而不及情，何以感天地而动鬼神乎？","book":"清·黄宗羲《陈苇庵年伯诗序》"},"similar":["感天地，泣鬼神"],"usage":"作谓语、宾语、定语；用于事迹等"},{"id":19935,"word":"感天地，泣鬼神","pinyin":"gǎn tiān dì，qì guǐ shén","abbr":"gtdqgs","explanation":"感：感动；泣：哭泣。感动天地，使鬼神为之哭泣。形容事迹或文艺作品感人至深。","source":{"text":"那史册彪炳日月的事业，全是这两眶子不叫人知的暗泪做出来，感天地，泣鬼神，才扶到凌烟阁里，与了俎豆，叫他飨哩。","book":"清·李绿园《歧路灯》第87回"},"similar":["感天地，动鬼神"],"usage":"作谓语、宾语、定语；用于事迹等"},{"id":19936,"word":"感心动耳","pinyin":"gǎn xīn dòng ěr","abbr":"gxde","explanation":"感心：心受感动；动耳：悦耳。形容音乐极其感动人。","source":{"text":"感心动耳，回肠伤气。","book":"战国·楚·宋玉《高唐赋》"}},{"id":19937,"word":"感恩图报","pinyin":"gǎn ēn tú bào","abbr":"getb","explanation":"图：设法。感激别人的恩情而想办法回报。","source":{"text":"其感与报，宜若何而图之。","book":"宋·曾巩《寄欧阳舍人书》"},"example":{"text":"如果能培植他出镇方面，则～，声气相应，岂不是平添了一条臂膀。","book":"高阳《清宫外史》上册"},"similar":["感恩戴德","感激涕零","知恩图报"],"opposite":["忘恩负义","恩将仇报"],"usage":"作谓语；用于人","story":["春秋时期，吴国大将伍子胥率军攻打郑国。郑定公决定谁能退兵就重赏。一个渔夫向郑定公表示可以退兵。他拿着船桨就去见伍子胥，讲明来意。伍子胥想到当年渔夫的父亲冒着生命危险帮助他渡江逃难，怎能不感恩图报呢？于是立即退兵"]},{"id":19938,"word":"感恩怀德","pinyin":"gǎn ēn huái dé","abbr":"gehd","explanation":"感激别人的恩德。","source":{"text":"古之舍生取义者，必有理存焉，或感恩怀德，投命无悔，或利害有机，奋发以应会，诏所称聂政、介子是也。","book":"《三国志·魏志·齐王芳传》“勇过聂政，功逾介子，可谓杀身成仁，释生取义者矣”南朝·宋·裴松之注"},"example":{"text":"我想请大王饶恕他的活命，将来建昌一带的人或许会～。","book":"郭沫若《孔雀胆》第一幕"},"similar":["感恩荷德","感恩戴德"],"usage":"作谓语、定语；指感激别人"},{"id":19939,"word":"感恩戴义","pinyin":"gǎn ēn dài yì","abbr":"gedy","explanation":"感：感激；戴：尊敬，推崇。感激别人的恩惠和好处。","source":{"text":"今皆感恩戴义，怀欲报之心。","book":"晋·陈寿《三国志·吴志·骆统传》"},"similar":["感恩戴德"],"usage":"作谓语、定语；指感激别人"},{"id":19940,"word":"感恩戴德","pinyin":"gǎn ēn dài dé","abbr":"gedd","explanation":"戴：尊奉，推崇。感激别人的恩惠和好处。","source":{"text":"今皆感恩戴义，怀欲报之心。","book":"《三国志·吴志·骆统传》"},"example":{"text":"偶有一个狡滑的民贼出来，略用些小恩小惠来抚弄他，他便欢天喜地～。","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"similar":["感激涕零","感恩图报","感恩怀德"],"opposite":["恩将仇报","忘恩负义"],"usage":"作谓语、定语；指感激别人"},{"id":19941,"word":"感恩荷德","pinyin":"gǎn ēn hè dé","abbr":"gehd","explanation":"感：感激；荷：承受。感激别人的恩惠和好处。","source":{"text":"且禄优足以仁族，事简足以养疴，使某自谋，不过如此。感恩荷德，负戴靡胜！","book":"宋·张孝祥《代楤得居士上相府书》"},"similar":["感恩怀德","感恩戴德"],"usage":"作谓语、定语；指感激别人"},{"id":19942,"word":"感情用事","pinyin":"gǎn qíng yòng shì","abbr":"gqys","explanation":"凭个人的爱憎或一时的感情冲动处理事情。","source":{"text":"汪精卫是个毫无骨气的人，感情用事，意志不坚，时冷时热。","book":"吴玉章《从甲午战争前后到辛亥革命前后的回忆》"},"example":{"text":"我诚恳地希望，在选人的问题上，要注意社会公论，不能～。","book":"邓小平《组成一个实行改革的有希望的领导集体》"},"similar":["负气斗狠","意气用事"],"opposite":["理智从事"],"usage":"作谓语、定语；指冲动办事"},{"id":19943,"word":"感愧无地","pinyin":"gǎn kuì wú dì","abbr":"gkwd","explanation":"无地：没有一丝一毫的空余之地。形容对人的感激、惭愧到了极点。","source":{"text":"今弟在困危之中，蒙先生慨然以尊斋相借，令弟感愧无地，所以先来谢过，再细细请教。","book":"清·吴敬梓《儒林外史》第三十一回"}},{"id":19944,"word":"感慕缠怀","pinyin":"gǎn mù chán huái","abbr":"gmch","explanation":"感慕：感动而爱慕；缠怀：缠绕心中。感动和爱慕之情缠绕在心中。","source":{"text":"丰恩慈训，义深情切，永惟仁范，感慕缠怀。","book":"《宋书·临川王道规传》"}},{"id":19945,"word":"感慨万千","pinyin":"gǎn kǎi wàn qiān","abbr":"gkwq","explanation":"因外界事物变化很大而引起许多感想、感触。","source":{"text":"孙玉厚坐在这里，心里忍不住感慨万千。","book":"路遥《平凡的世界》第二卷第30章"},"example":{"text":"面对波涛汹涌的大海，我～。"},"similar":["无限感慨"],"usage":"作谓语、宾语、定语、状语；用于处事"},{"id":19946,"word":"感慨万端","pinyin":"gǎn kǎi wàn duān","abbr":"gkwd","explanation":"感慨：因有所感触而慨叹；万端：极多而纷繁。因深有感触而有许多慨叹。","source":{"text":"思前想后，我怎能不感慨万端。","book":"陶承《我的一家·新版后记》"},"example":{"text":"我面对如此之情形～。"},"similar":["感慨万千"],"usage":"作谓语；指感慨很多"},{"id":19947,"word":"感慨杀身","pinyin":"gǎn kǎi shā shēn","abbr":"gkss","explanation":"感慨：因有所感触而慨叹；杀身：舍弃生命。因愤慨而舍弃性命。","source":{"text":"感慨杀身者易，从容就义者难。","book":"宋·朱熹、吕祖谦《近思录·政事》"},"usage":"作谓语、定语；用于处世"},{"id":19948,"word":"感慨激昂","pinyin":"gǎn kǎi jī áng","abbr":"gkja","explanation":"情绪激动，精神昂扬。","source":{"text":"[魏禧]其为文主识议，凌厉雄健，不屑屑抚拟如世之貎似大家者，遇忠孝节烈事，则益感慨激昂，摹画淋漓。","book":"清·邵长蘅《侯方域魏禧传》"},"example":{"text":"其始也，犹稍稍～，思自表见；一限以资格，此士大夫所以尽奄然而无有气者也。","book":"清·龚自珍《明良论三》"},"usage":"作谓语、状语；用于人的情绪"},{"id":19949,"word":"感慨系之","pinyin":"gǎn kǎi xì zhī","abbr":"gkxz","explanation":"感：感触；慨：慨叹；系：联结。有所感触，慨叹不已。","source":{"text":"及其所之既倦，情随事迁，感慨系之矣。","book":"汉·刘桢《赠五官中郎将》诗：“秋日多悲怀，感慨以长叹。”晋·王羲之《兰亭集序》"},"example":{"text":"就弄得他神经过敏，以为北方女子太死板而南方女子太活泼，不禁～矣了。","book":"鲁迅《在酒楼上》"},"similar":["感慨万端","感慨万千"],"opposite":["无动于衷"],"usage":"作谓语、宾语；用于人的情绪"},{"id":19950,"word":"感戴二天","pinyin":"gǎ dài èr tiān","abbr":"gdet","explanation":"形容那些把人从危险、艰难、疾病当中挽救出来的人。"},{"id":19951,"word":"感戴莫名","pinyin":"gǎn dài mò míng","abbr":"gdmm","explanation":"感戴：感恩戴德；莫名：说不出来。感激之情无法用语言表达出来。"},{"id":19952,"word":"感旧之哀","pinyin":"gǎn jiù zhī āi","abbr":"gjza","explanation":"感念旧人旧事的哀叹。表示怀旧。","source":{"text":"今銮驾旋轸，东京榛芜，义士有存本之思，兆人怀感旧之哀。","book":"《后汉书·荀彧传》"},"usage":"作宾语；表示怀旧"},{"id":19953,"word":"感时抚事","pinyin":"gǎn shí fǔ shì","abbr":"gsfs","explanation":"感：感慨，感触；时：时局，时世；抚：历数，寻思之意。指因为思考时局之事而伤感。","source":{"text":"与余问答既有以，感时抚事增惋伤。","book":"唐·杜甫《观公孙大娘弟子舞剑器行》"},"example":{"text":"虽～，亦志洁行芳。","book":"刘师培《文说》"},"usage":"作谓语、宾语；用于人的心境"},{"id":19954,"word":"感极涕零","pinyin":"gǎn jí tì líng","abbr":"gjtl","explanation":"感激之极而流下眼泪。形容极为感激。","source":{"text":"罪深责薄，感极涕零。","book":"宋·黄庭坚《谢黔州安置表》"},"example":{"text":"你如有议论，敢乞源源寄来，不胜荣幸～之至。","book":"鲁迅《两地书·致许广平十九》"},"similar":["感激涕零"],"usage":"作谓语、定语；形容极度感激"},{"id":19955,"word":"感深肺腑","pinyin":"gǎn shēn fèi fǔ","abbr":"gsff","explanation":"肺腑：指内心深处。使人内心深深感动。","source":{"text":"今考其文至论事疏，感人肺肝，毛发皆耸。","book":"唐·刘禹锡《唐故相国李公集记》"},"example":{"text":"过道台听了，心上甚是钦佩；又想起刚才相待的情形，竟是～，一心一意想要竭力报效。","book":"清·李宝嘉《官场现形记》第十八回"},"similar":["感人肺腑"],"usage":"作谓语、定语；指使人内心深深感动"},{"id":19956,"word":"感激不尽","pinyin":"gǎn jī bù jìn","abbr":"gjbj","explanation":"感激的心情没有穷尽。形容非常感激。","source":{"text":"驿官传扬都督之命，将十千钱赠为路费，又备下一辆车儿，差人夫送至姚州普淜驿中居住，张氏心中感激不尽。","book":"明·冯梦龙《喻世明言》卷八"},"example":{"text":"我们愚弟兄就～了。","book":"清·吴敬梓《儒林外史》第四十五回"},"similar":["万分感激"],"opposite":["深恶痛绝"],"usage":"作谓语、宾语；指非常感激"},{"id":19957,"word":"感激流涕","pinyin":"gǎn jī liú tì","abbr":"gjlt","explanation":"涕：眼泪。感激得掉下眼泪。形容极度感激。","source":{"text":"尝阅《诗》至《蓼莪》篇，感激流涕，故其志如刃始淬。","book":"唐·刘禹锡《王公神道碑铭》"},"example":{"text":"堂下兵士数万，皆～。","book":"宋·孔平仲《续世说·李光颜》"},"similar":["感激涕零","感激涕泗"],"usage":"作谓语、定语、状语；形容极度感激"},{"id":19958,"word":"感激涕泗","pinyin":"gǎn jī tì sì","abbr":"gjts","explanation":"涕：眼泪；泗：鼻涕。感激得掉下眼泪。形容极度感激。","source":{"text":"命舆疾至府，亲举袂抚之，论叙生平，感激涕泗。","book":"《新唐书·薛收传》"},"example":{"text":"程佳利立即～地说：‘我愿意为司令效劳！’","book":"黎汝清《叶秋红》"},"similar":["感激涕零","感激流涕"],"usage":"作谓语、定语、状语；形容极度感激"},{"id":19959,"word":"感激涕零","pinyin":"gǎn jī tì líng","abbr":"gjtl","explanation":"涕：眼泪；零：落。因感激而流泪。形容极度感激。","source":{"text":"路旁老人忆旧事，相与感激皆涕零。","book":"唐·刘禹锡《平蔡行》诗"},"example":{"text":"贾政听了，～，叩首不已。","book":"清·曹雪芹《红楼梦》第一○七回"},"similar":["感恩图报","感激不尽"],"opposite":["忘恩负义","恩将仇报"],"usage":"作谓语、定语；形容极度感激","story":["公元814年，淮西节度使吴少阴死后，他的儿子吴元济未能继承父职，就率军反叛，纵兵烧杀抢掠。宰相裴度率军讨伐，李朔自告奋勇担当平淮西叛乱的重任，率骑兵攻入吴元济的巢穴并活捉了他。百姓对官军感激得掉下眼泪来"]},{"id":19960,"word":"感物伤怀","pinyin":"gǎn wù shāng huái","abbr":"gwsh","explanation":"感：感动；伤怀：伤心。因见到某种事物而感动伤心。","example":{"text":"女人们经常爱～，那叫感情丰富。"},"similar":["触景生情"],"usage":"作谓语、宾语、定语；用于人的情感等"},{"id":19961,"word":"感篆五中","pinyin":"gǎn zhuàn wǔ zhōng","abbr":"gzwz","explanation":"篆：铭刻；五中：内心。形容使人内心深受感动。","source":{"text":"在府厚扰月余，承以家人待我，感篆五中！","book":"李脃人《暴风雨前》第四部分"},"usage":"作谓语、定语；用于事迹等"},{"id":19962,"word":"感遇忘身","pinyin":"gǎn yù wàng shēn","abbr":"gyws","explanation":"感遇：感激恩遇；忘身：愿舍身相报。旧时士大夫向皇帝谢恩，表示忠心的套话。","source":{"text":"且先帝谬顾，情同布衣，感今恩重命轻，遂感遇忘身。","book":"《晋书·庚亮传》"},"usage":"作谓语、定语；用于表示忠心的套话"},{"id":19963,"word":"感铭心切","pinyin":"gǎn míng xīn qiè","abbr":"gmxq","explanation":"感：感激；铭：铭刻；心切：心情急迫。指对于师长或施惠者感激不忘，铭刻在心。","source":{"text":"书问见遗，感铭心切。","book":"宋·陈师道《答陈先辈》"}},{"id":19964,"word":"愣头呆脑","pinyin":"lèng tóu dāi nǎo","abbr":"ltdn","explanation":"楞：呆，失神。形容言行鲁莽冒失或发愣的样子。","source":{"text":"现在几乎全班都举手了，只有我们这张桌子上愣头呆脑地坐着两个人。","book":"余辰《蚕》"}},{"id":19965,"word":"愣头愣脑","pinyin":"lèng tóu lèng nǎo","abbr":"ltln","explanation":"形容言行鲁莽冒失。","source":{"text":"干妈，虎子傻，说话愣头愣脑，没分寸。","book":"曹禺《原野》第二幕"},"example":{"text":"调度员忽闪忽闪眨着眼，～地望着梁建。","book":"杜鹏程《在和平的日子里》第三章"},"similar":["呆头呆脑","愣头磕脑"],"usage":"作谓语、定语、状语；形容言行鲁莽冒失"},{"id":19966,"word":"愣头磕脑","pinyin":"lèng tóu kē nǎo","abbr":"ltkn","explanation":"楞：呆，失神。形容言行鲁莽冒失或发愣的样子。","source":{"text":"一搁下了事，他心中不痛快，便有点愣头磕脑的。","book":"老舍《骆驼祥子》"}},{"id":19967,"word":"愣愣瞌瞌","pinyin":"lèng lèng kē kē","abbr":"llkk","explanation":"愣：呆，失神。呆头呆脑，发呆的样子。","example":{"text":"我不喜欢～的张小丫。"},"similar":["呆头呆脑","愣头楞脑"],"usage":"作定语、状语；用于口语"},{"id":19968,"word":"愣眼巴睁","pinyin":"lèng yǎn bā zhēng","abbr":"lybz","explanation":"愣：呆，失神。由于吃惊而眼发直。","example":{"text":"听到这个消息，他～的坐着，呆若木鸡。"},"usage":"作定语、状语；用于口语"},{"id":19969,"word":"愤不欲生","pinyin":"fèn bù yù shēng","abbr":"fbys","explanation":"悲愤或气愤行不愿再活下去了。形容极度气愤。","source":{"text":"余闻报淮上，悲愤不欲生。","book":"明·史可法《史忠正公集·祭庐州殉难官绅士民文》"},"example":{"text":"觉得过去的革命落空了，因而～。","book":"吴玉章《从甲午战争前后到辛亥革命前后的回忆》"},"usage":"作谓语、定语；形容极度气愤"},{"id":19970,"word":"愤不顾身","pinyin":"fèn bù gù shēn","abbr":"fbgs","explanation":"奋勇直前，不顾自身安危。","source":{"text":"盖一婢子，不知书，而能感主恩，愤不顾身，其志烈懔懔，诚足使后人仰慕歌咏也。","book":"宋·乐史《绿珠传》"},"example":{"text":"清军自得汉阳，湖南人士均～，颇有灭此朝食之慨。","book":"郭孝成《湖南光复纪事》"},"similar":["忿不顾身"],"usage":"作谓语、状语；指人不惜生命","story":["西晋时期，渤海大富翁石崇非常富有，他建一座金谷园别墅，专门供他喜欢的歌女绿珠使用。他被罢官在家，终日守着绿珠。中书令孙秀偶然见到十分有名的绿珠就动了心，向石崇索取未果，就派兵强取。绿珠愤不顾身，就跳楼而死"]},{"id":19971,"word":"愤世嫉俗","pinyin":"fèn shì jí sú","abbr":"fsjs","explanation":"愤：憎恶，痛恨；嫉：仇恨，痛恨；世、俗：当时的社会状况。有正义感的人对黑暗的现实社会和不合理的习俗表示愤恨、憎恶。","source":{"text":"然吾观于人，其能尽其性而不类于禽兽异物者，希矣。将愤世嫉邪长往而不来者之所为乎？","book":"唐·韩愈《杂说》"},"example":{"text":"不见面就罢，一见面就是～地破口大骂，要不就是针针见血地讽刺不休。","book":"欧阳山《苦斗》四八"},"similar":["愤时嫉俗","避世绝俗"],"opposite":["安贫乐道"],"usage":"作谓语、定语、宾语；指憎恨世俗"},{"id":19972,"word":"愤世嫉恶","pinyin":"fèn shì jí è","abbr":"fsje","explanation":"愤：愤恨，不满；世：世道，现状；嫉：憎恶，仇恨。痛恨、憎恶腐朽、黑暗的社会现状。","source":{"text":"其辩说骎骎到义理，愤世嫉恶，有大丈夫之芒角。","book":"宋·李觐《与王章秘校书》"},"similar":["愤世嫉俗","愤时嫉俗","愤世嫉邪"],"usage":"作谓语、定语、宾语；指憎恨世俗"},{"id":19973,"word":"愤世嫉邪","pinyin":"fèn shì jí xié","abbr":"fsjx","explanation":"愤：愤恨，不满；世：世道，现状；嫉：憎恶，仇恨。痛恨、憎恶腐朽、黑暗的社会现状。","source":{"text":"然吾观于人，其能尽其性而不类于禽兽异物者，希矣。将愤世嫉邪长往而不来者之所为乎？","book":"唐·韩愈《杂说》"},"example":{"text":"不怨不怒，而～之气，凛然不少回挠。","book":"宋·陆游《澹斋居士诗序》"},"similar":["愤世嫉俗","愤世嫉恶","愤时嫉俗"],"usage":"作谓语、定语、宾语；指憎恨世俗"},{"id":19974,"word":"愤世疾俗","pinyin":"fèn shì jí sú","abbr":"fsjs","explanation":"愤：愤恨，不满；世：世道，现状；疾：通“嫉”，憎恶；俗：世俗。痛恨、憎恶腐朽、黑暗的社会现状","source":{"text":"他们必定自己觉得思想见识高出庸众之上，又为庸众所不懂，所以愤世疾俗，渐渐变成厌世家，或‘国民之敌’。","book":"鲁迅《热风·随感录38》"},"similar":["愤时疾俗","愤世嫉俗"],"usage":"作谓语、定语、宾语；指憎恨世俗"},{"id":19975,"word":"愤世疾邪","pinyin":"fèn shì jí xié","abbr":"fsjx","explanation":"犹愤世嫉俗。","source":{"text":"怪神之事，孔子之徒不言，余将特取其愤世疾邪而作之，故题之云尔。","book":"唐·韩愈《杂说》之三"},"example":{"text":"退而思其言，类东方生滑稽之流，岂其～者耶？","book":"明·刘基《卖柑者言》"},"similar":["愤世嫉邪","愤世疾俗"],"usage":"作谓语、定语、宾语；指憎恨世俗"},{"id":19976,"word":"愤发有为","pinyin":"fèn fā yǒu wéi","abbr":"ffyw","explanation":"愤发：振作，兴起。精神振作，有所作为。","source":{"text":"它教人关心国家和世界的大事；鼓舞年青人愤发有为，产生远大的志向。","book":"艾芜《云南在我的心地上播下了美好的种子》"},"similar":["奋发有为"],"usage":"作谓语、定语；指人的精神"},{"id":19977,"word":"愤恨不平","pinyin":"fèn hèn bù píng","abbr":"fhbp","explanation":"因不公平的事而心中不服，感到气愤。","source":{"text":"因不公平的事而心中不服，感到气愤。"},"similar":["愤愤不平","愤懑不平"],"usage":"作谓语、状语、定语；指心中不服"},{"id":19978,"word":"愤愤不平","pinyin":"fèn fèn bù píng","abbr":"ffbp","explanation":"愤愤：很生气的样子。心中不服，感到气愤。","source":{"text":"自尔愤愤不平，每酒后辄咏魏武帝乐府。","book":"《汉书·刘据传》：“太子进则不得见，退则困于乱臣，独冤结而亡告，不忍忿忿之心，起而杀充，恐惧逋逃。”唐·许嵩《建康实录》"},"example":{"text":"王子成父诸人，俱～，请于桓公，欲劫鲁侯，以报曹沫之辱。","book":"明·冯梦龙《东周列国志》第十八回"},"similar":["怒火中烧","怒气满腹"],"opposite":["心平气和","平心静气"],"usage":"作谓语、状语、定语；指心中不服"},{"id":19979,"word":"愤懑不平","pinyin":"fèn mèn bù píng","abbr":"fmbp","explanation":"愤懑：抑郁不平。因不公平的事而心中不服，感到气愤。","source":{"text":"其未解散者亦多愤懑不平，皆谓欲解散则全体解散，欲留则全体留用。","book":"孙中山《伦敦被难记》"},"example":{"text":"孙中山《伦敦被难记》：“其未解散者亦多～，皆谓欲解散则全体解散，欲留则全体留用。”"},"similar":["愤愤不平","愤恨不平"],"usage":"作谓语、状语、定语；指心中不服"},{"id":19980,"word":"愤时嫉俗","pinyin":"fèn shí jí sú","abbr":"fsjs","explanation":"愤：愤恨，不满；嫉：憎恶，仇恨；俗：世俗。痛恨、憎恶腐朽、黑暗的社会现状。","source":{"text":"十余年来，所交之士皆幽忧失志之士，诵其歌诗，往往愤时嫉俗，多离骚变雅之体。","book":"清·朱彝尊《王礼部诗序》"},"similar":["愤世嫉俗","愤世嫉恶","愤世嫉邪"],"usage":"作谓语、定语、宾语；指憎恨世俗"},{"id":19981,"word":"愤时疾俗","pinyin":"fèn shí jí sú","abbr":"fsjs","explanation":"有正义感的人对黑暗的现实社会和不合理的习俗表示愤恨、憎恶。同“愤世嫉俗”。","source":{"text":"居恒愤时疾俗，欲以身挽之。","book":"《明史·姜士昌传》"},"example":{"text":"望溪同时友戴潜虚先生……～之作尤多。","book":"清·方宗诚《〈桐城文录〉序》"},"similar":["愤时嫉俗","愤世嫉俗","愤世疾俗"],"usage":"作谓语、定语、宾语；指憎恨世俗"},{"id":19982,"word":"愤气填胸","pinyin":"fèn qì tián xiōng","abbr":"fqtx","explanation":"形容愤怒之情充满胸中。","source":{"text":"筑垒清野，秣马训兵，愤气填胸，誓雪国耻。","book":"唐·赵元一《奉天录》卷三"},"example":{"text":"王陵～，只恨口众我寡，不便再言。","book":"蔡东蕃《前汉演义》第四十四回"}},{"id":19983,"word":"愤气填膺","pinyin":"fèn qì tián yīng","abbr":"fqty","explanation":"填：填塞；膺：胸。愤怒之气充满胸膛。形容十分气愤。","source":{"text":"使行人到此，忠愤气填膺，有泪如倾。","book":"宋·张孝祥《六州歌头》词"},"example":{"text":"启户迳出，大骂曰：‘何物婢子，如此倔强，令人～！","book":"清·俞樾《右台仙馆笔记·秦娘》"},"similar":["义愤填膺"],"usage":"作谓语、定语、状语；指气愤"},{"id":19984,"word":"愤然作色","pinyin":"fèn rán zuò sè","abbr":"frzs","explanation":"愤然：忿怒的样子。因忿怒而变了脸色，发怒。","source":{"text":"帝愤然作色而问其故，济具以答。","book":"晋·陈寿《三国志·魏志·蒋济传》"},"similar":["忿然作色"],"opposite":["和颜悦色"],"usage":"作谓语、状语；指人发怒"},{"id":19985,"word":"愤风惊浪","pinyin":"fèn fēng jīng làng","abbr":"ffjl","explanation":"指狂风骇浪。","source":{"text":"[武帝]便投劾星弛，不复寝食，倍道就路，愤风惊浪，不暂停止。","book":"《南史·梁纪中·武帝下》"},"similar":["狂风骇浪"],"usage":"作宾语、定语；同“狂风骇浪”"},{"id":19986,"word":"愧不敢当","pinyin":"kuì bù gǎn dāng","abbr":"kbgd","explanation":"感到惭愧，承当不起。","source":{"text":"紫琼崖道人，慎郡王也，赠诗：‘按拍遥传月殿曲，走盘乱泻蛟宫珠。’愧不敢当，然亦佳句。","book":"清·郑燮《刘柳村册子》"},"example":{"text":"却做梦也想不到受了两位国家领导人的夸奖，实在～！","book":"周疲鹃《寄侨居海外的女儿》"},"similar":["担当不起","受之有愧"],"opposite":["名副其实","受之无愧"],"usage":"作谓语；指惭愧"},{"id":19987,"word":"愧天怍人","pinyin":"kuì tiān zuò rén","abbr":"ktzr","explanation":"怍：惭愧。对天对人，都感到惭愧。指做了亏心事无脸见人。","source":{"text":"仰不愧于天，俯不怍于人，二乐也。","book":"《孟子·尽心上》"},"usage":"作谓语；指做了亏心事无脸见人"},{"id":19988,"word":"愧悔无地","pinyin":"kuì huǐ wú dì","abbr":"khwd","explanation":"羞愧懊悔得无地自容。","source":{"text":"姑娘，你问到这里，我安骥诚惶诚恐，愧悔无地。","book":"清·文康《儿女英雄传》第八回"},"example":{"text":"这事让他感到～。"},"similar":["懊悔无极"],"usage":"作谓语；指羞愧"},{"id":19989,"word":"愧汗无地","pinyin":"kuì hàn wú dì","abbr":"khwd","explanation":"愧汗：因惭愧而流汗。惭愧得无地自容。","source":{"text":"属车效驾岂在力，愧汗绝足追奔尘。","book":"元·袁桷《络马图》"}},{"id":19990,"word":"愿受长缨","pinyin":"yuàn shòu cháng yīng","abbr":"yscy","explanation":"长缨：长绳子，比喻革命力量。比喻愿为国家效力。","source":{"text":"愿受长缨，必羁南越王而致之阙下。","book":"东汉·班固《汉书·终军传》"},"usage":"作谓语；指愿为国家效力"},{"id":19991,"word":"愿闻显据，以核理实","pinyin":"yuàn wén xiǎn jù，yǐ hé lǐ shí","abbr":"ywxjyhls","explanation":"愿意听到明显的证据，以核实事理与客观实际","source":{"text":"夫为合必有不合，愿闻显据，以核理实。","book":"南朝·宋·祖冲之《辩戴法兴难新历》"},"example":{"text":"《祖冲之》：“在这里，他写下了两句非常有名的话：‘～’；‘浮词虚贬，窃非所俱。’”"},"usage":"作宾语、定语；用于书面语"},{"id":19992,"word":"慈乌反哺","pinyin":"cí wū fǎn bǔ","abbr":"cwfb","explanation":"慈：奉养；慈乌：乌鸦的一种，相传能反哺其母；返哺：乌雏长大，衔食哺其母。比喻子女报答父母的养育之恩。","source":{"text":"常言道马有垂缰，犬有那展草，踹踏街心，慈乌反哺。","book":"元·无名氏《薛苞认母》第二折"},"example":{"text":"～，有母子爱。","book":"阿英《花鸟争奇》"},"similar":["慈乌返哺"],"usage":"作宾语、定语；指报答父母"},{"id":19993,"word":"慈乌返哺","pinyin":"cí wū fǎn bǔ","abbr":"cwfb","explanation":"慈：奉养。返哺：乌雏长大，衔食哺其母。比喻子女报答父母的养育之恩。","source":{"text":"慈乌返哺犹感怀，鸿雁才飞便著行。","book":"《故圆鉴大师二十四孝押座文》"},"example":{"text":"常言道马有垂缰。犬有那展草，踹踏街心～。","book":"元·无名氏《薛苞认母》第二折"},"similar":["慈乌反哺"],"usage":"作宾语、定语；指报答父母"},{"id":19994,"word":"慈孙孝子","pinyin":"cí sūn xiào zǐ","abbr":"csxz","explanation":"慈、孝：孝敬奉养。对祖先孝顺的子孙。","source":{"text":"虽孝子慈孙，百世不能改也。","book":"《孟子·离娄上》"},"example":{"text":"朕疏郡县以君诸臣之母，欲以称～之心。","book":"宋·王安石《祖母诰》"}},{"id":19995,"word":"慈悲为怀","pinyin":"cí bēi wéi huái","abbr":"cbwh","explanation":"慈悲：慈善和怜悯。原佛教语，以恻隐怜悯之心为根本。","source":{"text":"今则慈悲为本，常乐为宗，施舍惟机，低举成敬。","book":"《南齐书·高逸传论》"},"example":{"text":"出家人要以～。"},"similar":["慈悲为本"],"usage":"作谓语、宾语；用于劝诫人"},{"id":19996,"word":"慈悲为本","pinyin":"cí bēi wéi běn","abbr":"cbwb","explanation":"慈悲：慈善和怜悯。原佛教语，以恻隐怜悯之心为根本。","source":{"text":"今则慈悲为本，常乐为宗，施舍惟机，低举成敬。","book":"《南齐书·高逸传论》"},"example":{"text":"须要～，宽猛兼行，敬正诛邪。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["慈悲为怀"],"usage":"作宾语、定语；指劝人为善"},{"id":19997,"word":"慈故能勇","pinyin":"cí gù néng yǒng","abbr":"cgny","explanation":"富有慈善心肠的人，就有勇气。","source":{"text":"慈故能勇，俭故能广。","book":"《老子》第六十七章"}},{"id":19998,"word":"慈明无双","pinyin":"cí míng wú shuāng","abbr":"cmws","explanation":"赞扬兄弟或平辈中之最负声望者。","source":{"text":"爽字慈明，一名谞。幼而好学，年十二，能通《春秋》、《论语》。……颍川为之语曰：‘荀氏八龙，慈明无双。’","book":"南朝·宋·范晔《后汉书·荀爽传》"},"example":{"text":"青云之快士也，幼而好学，～。","book":"清·孙枝蔚《赠汪舟次诗》序"},"usage":"作谓语、补语、定语；用于表扬人","story":["汉朝时期，荀爽，字慈明，自幼特别好学。12岁时就能精通《春秋》及《论语》，太尉杜乔见了他十分佩服，称赞他可以当别人的老师了。他还能理解经书中的精妙之处，而他的七个兄弟都不能如此。因此别人说他“荀氏八龙，慈明无双。”"]},{"id":19999,"word":"慈眉善目","pinyin":"cí méi shàn mù","abbr":"cmsm","explanation":"形容人的容貌一副善良的样子。","source":{"text":"圆圆的脸，长满银灰的胡子，慈眉善目的。","book":"老舍《老张的哲学》"},"example":{"text":"他～的样子让人十分亲近。"},"similar":["和蔼可亲"],"opposite":["凶神恶煞"],"usage":"作宾语、定语、补语；形容人很面善"},{"id":20000,"word":"慈眉善眼","pinyin":"cí méi shàn yǎn","abbr":"cmsy","explanation":"形容人的容貌一副善良的样子。同“慈眉善目”。","source":{"text":"还有戴小圆帽的中国尼姑，脸冻得红红的，慈眉善眼的，居多提了小篮子和小罐子，出卖庵堂中的产品，蜂蜜和鸡蛋，酸辣子与豆腐乳。","book":"沈从文《陌生的地方和陌生的人》"}}]
