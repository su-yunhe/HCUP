+[{"id":2501,"word":"不步人脚","pinyin":"bù bù rén jiǎo","abbr":"bbrj","explanation":"不跟着别人的脚步走。比喻不因循守旧。","source":{"text":"苏长公片言只字与金玉同声，虽千古未见其比，则以其胸中绝无俗气，下笔不作寻常语，不步人脚故耳。","book":"明·李贽《又与从吾》"},"opposite":["步人后尘"],"usage":"作谓语、定语；指人敢于创新"},{"id":2502,"word":"不死不活","pinyin":"bù sǐ bù huó","abbr":"bsbh","explanation":"说死没死，说活未活。形容没有生气或处境尴尬。","source":{"text":"箕子虽不死，然便死却又到了，唯是被囚不死不活，这地位如何处，直是难。","book":"宋·朱熹《朱子语类》卷四八"},"example":{"text":"你买东西忙什么呢？先来给我送个信儿多好，叫人家盼望的～的干么呢？","book":"清·刘鹗《老残游记续集》第三回"},"similar":["半死不活"],"opposite":["生机勃勃"],"usage":"作谓语、定语；形容没有生气"},{"id":2503,"word":"不死不生","pinyin":"bù sǐ bù shēng","abbr":"bsbs","explanation":"指超脱生死的境界。","source":{"text":"夫系生故有死，恶死故有生。是以无系无恶，然后能无死无生。","book":"《庄子·大宗师》：“无古今，而后能入于不死不生。”郭象注"},"example":{"text":"不生不死，～；即生即死，即死即生，那里会错过一丝毫呢？","book":"清·刘鹗《老残游记》第十一回"},"similar":["不生不死"],"usage":"作宾语、定语、状语；指半死不活"},{"id":2504,"word":"不死之药","pinyin":"bù sǐ zhī yào","abbr":"bszy","explanation":"长生不死的药。","source":{"text":"有献不死之药于荆王者，谒者操以入。","book":"战国·韩·韩非《韩非子·说林上》"},"example":{"text":"世界上没有～。"},"similar":["不死药"],"usage":"作主语、宾语；指长生不死的药","story":["传说古代有人把长生不死的药献给荆王门官拿进去时，守门卫士得知是长生不死的药就自己吃了下去。荆王十分气愤，要杀掉这个卫士，卫士托人向荆王说情，说自己是为大王试验这药的效果。荆王也就放弃杀他的念头"]},{"id":2505,"word":"不毁之制","pinyin":"bù huǐ zhī zhì","abbr":"bhzz","explanation":"毁：毁坏；制：制度。不楞破坏的制度。指经久不变的制度。","source":{"text":"而未著不毁之制，惧论报德之义，万世或阙焉，非所以昭考示后世也。","book":"《三国志·魏志·武宣卞皇后纪》"},"opposite":["朝令夕改"],"usage":"作主语、宾语；指制度"},{"id":2506,"word":"不毒不发","pinyin":"bù dú bù fā","abbr":"bdbf","explanation":"指不受凌辱就不能发愤图强而有所成就。","source":{"text":"你丈人调你浑家，故意的索休索离，大雪里赶你出去，男子汉不毒不发。","book":"元·无名氏《渔憔记》第四折"},"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":2507,"word":"不毛之地","pinyin":"bù máo zhī dì","abbr":"bmzd","explanation":"不生长草木庄稼的荒地。形容荒凉、贫瘠。","source":{"text":"锡（赐）之不毛之地．","book":"《公羊传·宣公十二年》"},"example":{"text":"南方～，瘴疫之乡；丞相秉钧衡之重任，而自远征，非所宜也。","book":"明·罗贯中《三国演义》第八十七回"},"similar":["穷山恶水","穷乡僻壤"],"opposite":["鱼米之乡","天府之国"],"usage":"作主语、宾语；形容荒凉或未开垦的土地","story":["公元前597年，楚庄王率军攻打郑国，占领郑国的首都，郑襄公见彻底完蛋，只好光着膀子向楚庄王跪地求和，答应郑国土地可以划给楚国，郑人做楚人的奴隶，只恳求给一块不毛之地度过余生。楚庄王见郑襄公真诚悔过，就答应了他的求和要求"]},{"id":2508,"word":"不求有功，但求无过","pinyin":"bù qiú yǒu gōng，dàn qiú wú guò","abbr":"bqygdqwg","explanation":"不要求立功，只希望没有错误。","source":{"text":"总而言之，一句话，现在的情形，我不求有功，但求无过。","book":"《中国现在记》第二回"},"example":{"text":"～是无所作为的体现。"},"similar":["得过且过"],"usage":"作谓语、分句；形容甘心无所作为"},{"id":2509,"word":"不求甚解","pinyin":"bù qiú shèn jiě","abbr":"bqsj","explanation":"甚：很，极。只求知道个大概，不求彻底了解。常指学习或研究不认真、不深入。","source":{"text":"不慕利，好读书，不求甚解，每有会意，欣然忘食。","book":"晋·陶潜《五柳先生传》"},"example":{"text":"这人小的时候，诸事颟颟顸顸，～。","book":"清·李宝嘉《官场现形记》第五十四回"},"similar":["囫囵吞枣","浅尝辄止","食古不化"],"opposite":["穷原竟委","咬文嚼字","寻根究底"],"usage":"作谓语、定语、状语；指人学习不深入","story":["东晋时期文学家陶渊明，因不满当时吏治的腐败就辞官归隐山林，过着自食其力的隐居生活，他热衷于读书，写了一篇《五柳先生传》，其中这样写道：“好读书，不求甚解，每有会意，便欣然忘食。”"]},{"id":2510,"word":"不求闻达","pinyin":"bù qiú wén dá","abbr":"bqwd","explanation":"闻：有名望；达：显达。不追求名誉和地位。","source":{"text":"不求闻达于诸候。","book":"三国·蜀·诸葛亮《出师表》"},"example":{"text":"因此不事王侯，～，隐姓埋名，做庄家，学耕稼。","book":"元·王子一《误入桃源》第一折"},"similar":["追名逐利","沽名钓誉"],"usage":"作谓语、宾语；形容人不想出名","story":["三国时期，诸葛亮被刘备封为武乡侯，辅助后主刘禅，为了复兴蜀室，诸葛亮多次出兵伐魏。在出征前他给后主写《出师表》说自己是南阳一平民，不求闻达，是先帝三顾茅庐请出山的，自己深受感动，所以为了蜀室愿意鞠躬尽瘁，死而后已"]},{"id":2511,"word":"不汲汲于富贵","pinyin":"bù jí jí yú fù guì","abbr":"bjjyfg","explanation":"汲汲：心情急切。不迫切追求富贵。指人清高，安于清贫生活。","source":{"text":"不汲汲于富贵，不戚戚于贫贱。","book":"东汉·班固《汉书·扬雄传》"},"usage":"作谓语、定语；指人清高"},{"id":2512,"word":"不治之症","pinyin":"bù zhì zhī zhèng","abbr":"bzzz","explanation":"医治不好的病。也比喻无法挽救的祸患。","source":{"text":"太医诊了诊脉，说道：‘……此乃不治之症。’","book":"明·冯梦龙《醒世恒言》卷十"},"example":{"text":"假使她们真“知道立国数千年的大中华民国”的国民，往往有自欺欺人的～，那可真是没有面子了。","book":"鲁迅《二心集·以脚报国》"},"similar":["不可救药"],"opposite":["药到病除"],"usage":"作宾语；表示治不好的绝症"},{"id":2513,"word":"不治生产","pinyin":"bù zhì shēng chǎn","abbr":"bzsc","explanation":"治：管理。指不注意或无暇料理自己的生计。","source":{"text":"高祖为人，常有大度，不事家人生产作业。","book":"西汉·司马迁《史记·高祖本纪》"},"example":{"text":"韬奋先生尽瘁国事，～。","book":"周恩来《致邹韬奋夫人沈粹缜的慰问信》"},"usage":"作谓语、宾语、定语；用于处世"},{"id":2514,"word":"不法之徒","pinyin":"bù fǎ zhī tú","abbr":"bfzt","explanation":"对抗或违反法律的人，歹徒或逃犯，流窜或犯有暴力行为罪行的亡命之徒。","source":{"text":"倘有不法之徒，胆敢阴谋捣乱，本府本处言出法随，勿谓之言之不预。","book":"毛泽东《陕甘宁边区政府、第八路军后方留守处布告》"},"example":{"text":"我们要严厉打击这些～。"},"similar":["亡命之徒","不逞之徒"],"usage":"作主语、宾语、定语；指罪犯"},{"id":2515,"word":"不法古不修今","pinyin":"bù fǎ gǔ bù xiū jīn","abbr":"bfgbxj","explanation":"指不应效法古代，也不应拘泥于现状。","source":{"text":"圣人不法古，不修今，法古则后于时，修今则塞于世。","book":"《商君书·开塞》"},"opposite":["法古修今"],"usage":"作谓语；用于处世"},{"id":2516,"word":"不法常可","pinyin":"bù fǎ cháng kě","abbr":"bfck","explanation":"法：当做模式、法则；常可：长久被人们认可的成规惯例。不把常规惯例当做永远不变的模式。","source":{"text":"是以圣人不期修古，不法常可。","book":"《韩非子·五蠹》"},"opposite":["墨守成规"],"usage":"作谓语、定语；指敢于创新"},{"id":2517,"word":"不测之忧","pinyin":"bù cè zhī yōu","abbr":"bczy","explanation":"指意外的祸患。","source":{"text":"自太平兴国以来，至于咸平，可谓天下大治，千载一时矣。而田公之言常若有不测之忧近在朝夕者，何哉？","book":"宋·苏轼《田表圣奏议叙》"},"example":{"text":"郎君若自恃其勇，好杀不已，将来必犯天道之忌，难免～矣。","book":"《醒世恒言·大树坡义虎送亲》"},"similar":["不测之祸"],"usage":"作宾语；指意外的祸患"},{"id":2518,"word":"不测之智","pinyin":"bù cè zhī zhì","abbr":"bczz","explanation":"测：估计；智：才智，智慧。不可估计的才智。形容智高才广。","source":{"text":"以不测之智而通心术。","book":"《鬼谷子·本经阴符》"}},{"id":2519,"word":"不测之渊","pinyin":"bù cè zhī yuān","abbr":"bczy","explanation":"深渊。亦以比喻危险之地。","source":{"text":"临不测之渊，以为固。","book":"汉·贾谊《过秦论》"},"example":{"text":"今人有谓臣曰，入～而必出，不出，请以一鼠首为女殉者，臣必不为也。","book":"西汉·刘向《战国策·魏策三》"},"similar":["万丈深渊"],"usage":"作宾语；指危险的境地"},{"id":2520,"word":"不测之祸","pinyin":"bù cè zhī huò","abbr":"bczh","explanation":"测：揣度，预测。无法揣测的祸患。多指牢狱或杀身之祸。","source":{"text":"何以专为佞邪，秽尘天听？宜自改厉。不然，方见卿有不测之祸矣。","book":"《三国志·魏志·陆凯传》"},"example":{"text":"先生几蹈～。","book":"清·汪琬《送魏光禄归蔚州序》"},"similar":["飞来横祸"],"usage":"作宾语；多指死亡"},{"id":2521,"word":"不测之罪","pinyin":"bù cè zhī zuì","abbr":"bczz","explanation":"指大罪，死罪。","source":{"text":"临不测之罪，以幸为利，义之所不敢出也。","book":"战国·乐毅《报燕惠王书》"},"example":{"text":"莫非朝议以我前罪尚轻，又加以～么？","book":"《好逑传》第十三回"},"similar":["迷天大罪"],"usage":"作宾语；指大罪"},{"id":2522,"word":"不测之诛","pinyin":"bù cè zhī zhū","abbr":"bczz","explanation":"测：估计；诛：惩罚。不可估计的惩处。","source":{"text":"初获不赀之常，终陷不测之诛。","book":"北齐·颜之推《颜氏家训·省事》"}},{"id":2523,"word":"不测风云","pinyin":"bù cè cē yún","abbr":"bcfy","explanation":"风云：比喻变幻动荡的局势。不可预测的变幻动荡的局势。","source":{"text":"孔明笑曰：‘天有不测风云’，人又岂能料乎？”明·吴承恩《西游记》第九回“李定道：‘天有不测风云，人有暂时祸福。你怎么就保得无事？’","book":"明·罗贯中《三国演义》第四十九回"},"example":{"text":"真是‘天有～，人有旦夕祸福’。这个年纪，倘或就因这个病上怎么样了，人还活著有什么趣儿！","book":"清·曹雪芹《红楼梦》第十一回"}},{"id":2524,"word":"不清不白","pinyin":"bù qīng bù bái","abbr":"bqbb","explanation":"不明白，不清楚。形容关系暧昧。","source":{"text":"所以设下这个毒法儿，要把我拉在浑水里，弄一个不清不白的名儿，也未可知。","book":"清·曹雪芹《红楼梦》第90回"},"similar":["不明不白"],"opposite":["清清白白"],"usage":"作定语、状语；用于名声等"},{"id":2525,"word":"不爽毫发","pinyin":"bù shuǎng háo fā","abbr":"bshf","explanation":"没有一点差错。","source":{"text":"继者按稽之，不爽毫发。","book":"《明史·王琼传》"},"example":{"text":"千子论文～，生平极喜正希，而于大士，犹若有憾焉。","book":"清·戴名世《陈大士稿序》"},"similar":["毫发不爽"],"opposite":["天差地别"],"usage":"作谓语、宾语；形容一点不差"},{"id":2526,"word":"不爽累黍","pinyin":"bù shuǎng lèi shǔ","abbr":"bsls","explanation":"犹言丝毫不差。絫、黍，微小的重量。","source":{"text":"女凿壁偷听，得其指授，无人时转喉学唱，音韵抑扬，不爽累黍。","book":"清·王韬《淞隐漫录·姚云纤》"},"similar":["不失黍絫"],"opposite":["天差地别","十万八千里"],"usage":"作谓语、宾语；形容一点不差"},{"id":2527,"word":"不牧之地","pinyin":"bù mù zhī dì","abbr":"bmzd","explanation":"不能牧养牛马的地。指荒地。","source":{"text":"不牧之地，不羁之民。","book":"汉·桓宽《盐铁论·论功》"},"similar":["不毛之地"],"usage":"作宾语；指荒地"},{"id":2528,"word":"不猧不魀","pinyin":"bù wō bù gà","abbr":"bwbg","explanation":"“猧”念wō；“魀”念gà。比喻左右为难，不好处理。也形容样子别扭。同“不尴不尬”。"},{"id":2529,"word":"不理不睬","pinyin":"bù lǐ bù cǎi","abbr":"blbc","explanation":"指对人或事物不闻不问，漠不关心。","source":{"text":"官僚主义的表现，一种是不理不睬或敷衍塞责的怠工现象。我们要同这种现象作严厉的斗争。","book":"毛泽东《必须注意经济工作》"},"example":{"text":"毛泽东《必须注意经济工作》：“官僚主义的表现，一种是～或敷衍塞责的怠工现象。我们要同这种现象作严厉的斗争。”"},"similar":["不闻不问","漠不关心"],"usage":"作谓语、宾语、定语；用于处事"},{"id":2530,"word":"不甘后人","pinyin":"bù gān hòu rén","abbr":"bghr","explanation":"不甘心落在别人后面。","source":{"text":"而广不甘后人，然无尺寸之功以得封邑者，何也？","book":"西汉·司马迁《史记·李将军列传》"},"example":{"text":"他～，刻苦训练，终于获得了体操冠军。"},"similar":["争先恐后","力争上游","不甘示弱"],"opposite":["自暴自弃","随波逐流","甘居中游"],"usage":"作谓语、定语；指不甘落后的行为与思"},{"id":2531,"word":"不甘寂寞","pinyin":"bù gān jì mò","abbr":"bgjm","explanation":"甘：甘心；寂寞：孤寂、冷落。形容不甘心被冷落或急于想参与某件事情。","source":{"text":"念头淡薄，自然删落，若不甘寂寞，虽外事清高，正是以退为进。","book":"清·吕留良《晚村文集·与高旦中书》卷二"},"example":{"text":"从内务府垮下来的文锡，一向～。","book":"高阳《清宫外史》下册"},"similar":["不甘示弱","出头露面"],"opposite":["不闻不问","默默无闻"],"usage":"作谓语、定语；形容不甘受冷落与孤独"},{"id":2532,"word":"不甘示弱","pinyin":"bù gān shì ruò","abbr":"bgsr","explanation":"示：显示，表现。不甘心表示自己比别人差。表示要较量一下，比个高低。","source":{"text":"乡下人大抵有些顽固，以为和尚是只应该念经拜忏的，台下有人骂了起来。师父不甘示弱，也给他们一个回骂。","book":"鲁迅《且介亭杂文末编·我的第一个师父》"},"example":{"text":"他从来都是～的，总要超出别人一筹。"},"similar":["不甘后人","力争上游"],"opposite":["甘拜下风","自暴自弃"],"usage":"作谓语、定语、状语；表示要较量出高低来"},{"id":2533,"word":"不甘雌伏","pinyin":"bù gān cí fú","abbr":"bgcf","explanation":"甘：甘心，情愿；雌伏：雌鸟伏在那儿不动，比喻隐藏，不进取。比喻不甘心处于无所作为的境地。","source":{"text":"大丈夫当雄飞，安能雌伏！","book":"南朝·宋·范晔《后汉书·赵典传》"},"example":{"text":"我们要有～的决心，争取取得好成绩。"},"similar":["力争上游","不甘落后"],"opposite":["甘居人后"],"usage":"作谓语、定语；形容人不甘落后积极向上","story":["东汉末年，成都著名学者赵典的侄儿赵温，年轻时有大志，他在做京兆时很不得志，常叹息不能为国家立功，他感慨地对朋友说：“大丈夫当雄飞，安能雌伏！”不久，赵温弃官回家，在灾荒之年，他把家中存粮拿出救济穷人"]},{"id":2534,"word":"不甚了了","pinyin":"bù shèn liǎo liǎo","abbr":"bsll","explanation":"甚：很；了了：明白。不很明白，不很懂。","source":{"text":"初不甚了了，养之数日，始能言，乃实人也。","book":"宋·洪迈《夷坚丁志·黄州野人》"},"example":{"text":"我回家去了三年，外面的事情，～。","book":"清·吴趼人《二十年目睹之怪现状》第六十七回"},"similar":["不知所以","雾里看花","茫然不解"],"opposite":["明察秋毫","了如指掌","一目了然"],"usage":"作谓语；形容对事情不太清楚"},{"id":2535,"word":"不生不死","pinyin":"bù shēng bù sǐ","abbr":"bsbs","explanation":"指超脱生死的界限。现指半死不活。","source":{"text":"如来藏世间，不生不死，不来不去，常恒清凉不变。","book":"《入楞伽经》第八卷"},"example":{"text":"动不动一顿皮鞭，打得你～。","book":"明·冯梦龙《醒世恒言》第三卷"},"similar":["不生不灭","半死不活"],"opposite":["生气勃勃"],"usage":"作谓语、定语、状语；指半死不活"},{"id":2536,"word":"不生不灭","pinyin":"bù shēng bù miè","abbr":"bsbm","explanation":"佛家语，认为佛法无生灭变迁，即“常住”之异名。","source":{"text":"仰苍苍之色者，不足知其远近；况视听之外，若存若亡，心行之表，不生不灭者哉。","book":"晋·王巾《头陁寺碑文》"},"example":{"text":"舍利子，是诸佛空相，～，不垢不净，不增不减。","book":"明·吴承恩《西游记》第十九回"},"similar":["不生不死","半死不活"],"opposite":["生机勃勃"],"usage":"作谓语、定语；指半死不活"},{"id":2537,"word":"不由分说","pinyin":"bù yóu fēn shuō","abbr":"byfs","explanation":"由：听从，顺便；分说：辩白，解说。不容人分辩解释。","source":{"text":"怎么不由分说，便将我飞拳走踢只是打。","book":"元·武汉臣《生金阁》三折"},"example":{"text":"可是人们～，还是狠狠地打了他一顿，还用马刀把所有的布袋都砍破了，把车子也劈掉了。","book":"邓洪《潘虎》"},"similar":["不容置喙","不容置疑"],"opposite":["强词夺理","无理取闹"],"usage":"作谓语、状语、分句；形容不容许分辩解说","story":["唐僧师徒四人西行到一座寺院借宿，那些僧人听说从东土大唐来的，便问他们有什么宝物可以参观，唐僧说没有，而孙悟空则满不在乎，不由分说打开包袱，取出袈裟让他们观看，顿时红光满室，彩色盈庭，众僧跪地而拜，纷纷夸奖这稀世之宝"]},{"id":2538,"word":"不由自主","pinyin":"bù yóu zì zhǔ","abbr":"byzz","explanation":"由不得自己，控制不住自己。","source":{"text":"我也不很记得了。但觉自己身子不由自主，倒象有什么人，拉拉扯扯，要我杀人才好。","book":"清·曹雪芹《红楼梦》第81回"},"example":{"text":"韦珍说不上什么爱不爱，只是接触的多了，便～地常和常飞亲近起来。","book":"杜鹏程《在和平的日子里》第二章"},"similar":["身不由己","鬼使神差","情不自禁"],"opposite":["独立自主","自力更生"],"usage":"作谓语、状语；用于人","story":["贾宝玉放下书本跑到贾母那里，刚好贾母与王熙凤等在谈论邪魔外道。贾宝玉立即接话说当年赵姨娘请人做法让他和王熙凤一起中邪生病的事情。王熙凤说：“我也不很记得了。但觉自己身子不由自主，倒象有什么人，拉拉扯扯，要我杀人才好。”"]},{"id":2539,"word":"不畏强御","pinyin":"bù wèi qiáng yù","abbr":"bwqy","explanation":"不怕豪强有势力的人。","source":{"text":"不侮矜寡，不畏强御。","book":"《诗·大雅·烝民》"},"example":{"text":"宣帝初知盖宽饶忠直～，自侯司马擢为太中大夫司隶校尉，不可谓不知深矣。","book":"宋·苏轼《乞郡札子》"},"similar":["不避强御","不惮强御"],"usage":"作谓语、定语；指人刚正"},{"id":2540,"word":"不留余地","pinyin":"bù liú yú dì","abbr":"blyd","explanation":"不留一点空余的地方。多形容言语、行动没有留下可回旋的余地。","source":{"text":"此狐眼光如镜，然词锋太利，未免不留余地矣。","book":"清·纪昀《阅微草堂笔记》第11卷"},"example":{"text":"使人发生一种压迫和窘促之感，不特很少‘读书之乐’，且觉得仿佛人生已经没有‘余裕’，‘～’了。","book":"鲁迅《华盖集·忽然想到二》"},"similar":["斩草除根"],"opposite":["留有余地"],"usage":"作谓语、补语；用于做事不考虑回旋的余地"},{"id":2541,"word":"不留痕迹","pinyin":"bù liú hén jì","abbr":"blhj","explanation":"指做事彻底，没有留下蛛丝马迹。","source":{"text":"你甚至能和办公室里那些和你一样闲得难受的同事讨论怎么才能不留痕迹地杀人丝毫不会引起怀疑。","book":"王朔《我是“狼”》"},"example":{"text":"他办事彻底～。"},"usage":"作谓语、定语；用于处事等"},{"id":2542,"word":"不疼不痒","pinyin":"bù téng bù yǎng","abbr":"btby","explanation":"比喻说话做事只是做样子，不解决实际问题。","source":{"text":"搞得不疼不痒，不得人心。","book":"邓小平《严厉打击刑事犯罪活动》"},"example":{"text":"她提出一大堆～的问题。"},"similar":["不痛不痒"],"opposite":["击中要害"],"usage":"作谓语、定语、状语；指不解决实际问题"},{"id":2543,"word":"不疾不徐","pinyin":"bù jí bù xú","abbr":"bjbx","explanation":"疾：急速；徐：缓慢。不急不慢。指处事能掌握适度的节律，不太快或不太慢。","source":{"text":"君调用财力，不疾不徐，劳民劝功，公私以济。","book":"宋·黄庭坚《王纯中墓志铭》"},"example":{"text":"自然地，～地，这歌声好似一串明珠从她底口里不断地滚了出来。","book":"《巴金传·震动文坛的初作》"},"similar":["不快不慢"],"opposite":["过犹不及"],"usage":"作谓语、定语、状语；指处事掌握适度"},{"id":2544,"word":"不痒不痛","pinyin":"bù yǎng bù tòng","abbr":"bybt","explanation":"既不痛也不痒。比喻不中肯，没触及要害，不能彻底解决问题。","source":{"text":"不痒不痛，浑身上或寒或热；没撩没乱，满腹中又饱又饥。","book":"明·施耐庵《水浒传》第七回"},"similar":["不痛不痒"],"usage":"作定语、状语、宾语；形容没触及要害"},{"id":2545,"word":"不痛不痒","pinyin":"bù tòng bù yǎng","abbr":"btby","explanation":"既不是痛，也不是痒。原形容说不出的一种难受。现多比喻不触及实质，不切中要害，不解决问题。","source":{"text":"这事不痛不痒，却是一个大题目。","book":"明·吴炳《情邮记·反噬》"},"example":{"text":"即如小弟幼时，忽从面上生一肉核，非疮非疣，～。","book":"清·李汝珍《镜花缘》第二十六回"},"similar":["不得要领","转弯抹角","不疼不痒"],"opposite":["一语中的","一针见血"],"usage":"作定语、状语、宾语；形容没触及要害"},{"id":2546,"word":"不痴不聋","pinyin":"bù chī bù lóng","abbr":"bcbl","explanation":"人不傻，耳朵也不聋。常与“不成姑公”连用，意为不故作痴呆，不装聋作哑，就不能当阿婆阿公。形容长辈要宽宏大量。","source":{"text":"不瘖不聋，不成姑公。","book":"汉·刘熙《释名》卷二"},"example":{"text":"鄙谚有之：“～，不作家翁。”","book":"《资治通鉴·唐纪代宗大历二年》"},"similar":["装聋作哑"],"usage":"作谓语、定语；常与“不成姑公”连用","story":["唐朝时期，郭子仪多次打败叛军，使唐王朝转危为安。唐代宗将女儿升平公主嫁给郭子仪的儿子郭暖，小两口吵架，郭暖说了几句气话，升平公主就回家告状。郭子仪带郭暖向唐代宗请罪，唐代宗笑着答道：“不痴不聋，不做家翁，下一辈吵架何必计较？”"]},{"id":2547,"word":"不痴不聋，不作阿家翁","pinyin":"bù chī bù lóng，bù zuò ē jiā wēng","abbr":"bcblbzajw","explanation":"指作为一家之主，对下辈的过失要能装糊涂。","source":{"text":"人全贪小利；‘不痴不聋，不作阿家翁’，就算了罢。","book":"钱钟书《围城》"},"example":{"text":"钱钟书《围城》：“人全贪小利；‘～’，就算了罢。”"},"similar":["不痴不聋，不成姑公"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":2548,"word":"不痴不聋，不做家翁","pinyin":"bù chī bù lóng，bù zuò jiā wēng","abbr":"bcblbzjw","explanation":"指作为一家之主，对下辈的过失要能装糊涂。","source":{"text":"鄙谚有之‘不痴不聋，不为家翁’，儿女子闺房之言，何足听也？","book":"宋·司马光《资治通鉴》第224卷"},"example":{"text":"～，我们还是装糊涂吧。"},"similar":["不痴不聋，不成姑公"],"usage":"作宾语、定语、分句；用于劝诫人","story":["唐朝时期，郭子仪多次打败叛军，使唐王朝转危为安。唐代宗将女儿升平公主嫁给郭子仪的儿子郭暖，小两口吵架，郭暖说了几句气话，升平公主就回家告状。郭子仪带郭暖向唐代宗请罪，唐代宗笑着答道：“不痴不聋，不做家翁，下一辈吵架何必计较？”"]},{"id":2549,"word":"不痴不聋，不成姑公","pinyin":"bù chī bù lóng，bù chéng gū gōng","abbr":"bcblbcgg","explanation":"姑公：婆婆和公公。不装傻装聋，就难当婆婆公公。形容长辈要宽宏大量。","source":{"text":"不瘖不聋，不成姑公。","book":"汉·刘熙《释名》卷二"},"similar":["不痴不聋，不做家翁"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":2550,"word":"不瘟不火","pinyin":"bù wēn bù huǒ","abbr":"bwbh","explanation":"瘟：戏曲沉闷乏味；火：比喻紧急急促。指戏曲不沉闷乏味，也不急促。","example":{"text":"这部～的戏剧让人提不起兴趣。"},"similar":["不冷不热"],"usage":"作谓语、定语；指态度一般"},{"id":2551,"word":"不登大雅","pinyin":"bù dēng dà yǎ","abbr":"bddy","explanation":"大雅：高贵典雅。不能登上高雅的厅堂。形容某些不被人看重的、“粗俗”的事物（多指文艺作品）。","source":{"text":"见“不登大雅之堂”。"},"example":{"text":"按照老看法，这类书至多只能指示童蒙，～。","book":"朱自清《序》"},"similar":["不登大雅之堂"],"usage":"作谓语、定语；用于粗俗低级的东西等"},{"id":2552,"word":"不登大雅之堂","pinyin":"bù dēng dà yǎ zhī táng","abbr":"bddyzt","explanation":"大雅：高贵典雅。不能登上高雅的厅堂。形容某些不被人看重的、“粗俗”的事物（多指文艺作品）。","source":{"text":"这部评话原是不登大雅之堂的一部小说，初名‘金玉缘。’","book":"清·文康《儿女英雄传·缘起首回》"},"example":{"text":"而～的乱弹——皮簧，居然登了大雅之堂。","book":"瞿秋白《代序》"},"similar":["不登大雅"],"usage":"作谓语、定语；用于粗俗低级的东西等"},{"id":2553,"word":"不白之冤","pinyin":"bù bái zhī yuān","abbr":"bbzy","explanation":"白：搞清楚。没有得到辩白或洗刷的冤屈。","source":{"text":"咺之逃，非贪生怕死，实欲为太叔伸不白之冤耳！","book":"明·冯梦龙《东周列国志》第四十二回"},"example":{"text":"若非屡次验明，则其姊受～，未老先生亦蒙羞于地下，不孝子弟，罪不容诛。","book":"清·夏敬渠《野叟曝言》第十八回"},"similar":["沉冤莫白","含冤负屈","覆盆之冤"],"opposite":["真相大白"],"usage":"作主语、宾语；形容好人被冤枉"},{"id":2554,"word":"不皦不昧","pinyin":"bù jiǎo bù mèi","abbr":"bjbm","explanation":"不明不暗。形容恍惚不可捉摸。","source":{"text":"一者，其上不皦，其下不昧，绳绳不可名，复归于无物。","book":"春秋·楚·李耳《老子》"},"example":{"text":"惟恍惟惚，～，莫系于去来，复归于无物。","book":"南朝·齐·王山《头陀寺碑文》"},"usage":"作谓语、定语；用于书面语"},{"id":2555,"word":"不直一文","pinyin":"bù zhí yī wén","abbr":"bzyw","explanation":"鄙视之词，犹言毫无价值。比喻无能或品格卑下。","source":{"text":"士大夫若爱一文，不直一文。","book":"宋·罗大经《鹤林玉露》卷十四"},"similar":["不直一钱"],"usage":"作谓语、定语；用于人与事物等"},{"id":2556,"word":"不直一钱","pinyin":"bù zhí yī qián","abbr":"bzyq","explanation":"鄙视之词，犹言毫无价值。比喻无能或品格卑下。","source":{"text":"夫无所发怒，乃骂临汝侯曰：‘生平毁程不识不直一钱，今日长者为寿，乃效女儿咕嗫耳语。","book":"语出《史记·魏其武安侯列传》"},"similar":["身无分文","不值一钱"],"opposite":["价值连城"],"usage":"作谓语、定语；形容身无分文"},{"id":2557,"word":"不相上下","pinyin":"bù xiāng shàng xià","abbr":"bxsx","explanation":"分不出高低好坏。形容水平相当。","source":{"text":"翳叶仰啮，如饥蚕之速，不相上下。","book":"唐·陆龟蒙《蠹化》"},"example":{"text":"以愚观之，晋楚互为雌雄，～。","book":"明·冯梦龙《东周列国志》第五十五回"},"similar":["并驾齐驱","不分伯仲"],"opposite":["天差地远","迥然不同"],"usage":"作谓语、定语、宾语；用于人与事物"},{"id":2558,"word":"不相为谋","pinyin":"bù xiāng wéi móu","abbr":"bxwm","explanation":"谋：商量。相互之间没法商量。指彼此观点不同，不宜共同谋划事情。","source":{"text":"道不同，不相为谋。","book":"《论语·卫灵公》"},"example":{"text":"多是有些闻望，含有民党性质，与政府不～。","book":"蔡东藩、许廑父《民国通俗演义》第二十三回"},"similar":["各行其是","各自为政"],"opposite":["切磋琢磨"],"usage":"作谓语、定语；指不能在一起干大事","story":["春秋时期，孔子带领弟子周游列国碰壁后，在冉求的帮助下，终于回到了父母之邦鲁国，主事的季康子嫌他太老，没有重用他。他认为与季康子是“道不同，不相为谋。”于是闲居起来，专心著述，编辑整理《诗》《书》《礼》《乐》《春秋》等"]},{"id":2559,"word":"不相违背","pinyin":"bù xiāng wéi bèi","abbr":"bxwb","explanation":"指不会互相不符。","source":{"text":"结束其传统的对外妥协，对内用兵、对民压迫的错误政策，将国民党引导到和人民愿望不相违背的地位。","book":"毛泽东《关于蒋介石声明的声明》"},"usage":"作谓语、定语；用于两者之间"},{"id":2560,"word":"不相问闻","pinyin":"bù xiāng wèn wén","abbr":"bxww","explanation":"指没有联系或断绝往来。"},{"id":2561,"word":"不相闻问","pinyin":"bù xiāng wén wèn","abbr":"bxww","explanation":"闻问：通消息，通音讯。指没有联系或断绝往来。","source":{"text":"《汉书·严助传》：“于是拜为会稽太守。数年，不闻问。"},"example":{"text":"又三年，一贫如洗，更屡试不第，亲故白眼相向，渐至～。","book":"清·霁园主人《夜谭随录·崔秀才》"},"similar":["不相往来"],"usage":"作谓语；指不来往"},{"id":2562,"word":"不省人事","pinyin":"bù xǐng rén shì","abbr":"bxrs","explanation":"省：知觉。指昏迷过去，失去知觉。也指不懂人情世故。","source":{"text":"问其无所苦否，则曰‘无事，无事’。寻即不省人事。","book":"宋·汪应辰《与朱元晦》"},"example":{"text":"大作又说我“大声疾呼”之后，不过几年，青年就只能说外国话。我以为是～之谈。","book":"鲁迅《集外集拾遗·报“奇哉所谓……”》"},"similar":["麻木不仁","不近人情"],"opposite":["耳聪目明","通情达理"],"usage":"作谓语、定语、补语；形容丧失知觉"},{"id":2563,"word":"不看佛面看金面","pinyin":"bù kàn fó miàn kàn jīn miàn","abbr":"bkfmkjm","explanation":"比喻请看第三者的情面帮助或宽恕某一个人。同“不看僧面看佛面”。","source":{"text":"哈！我如果是个连长，或是个把书记官，不看佛面看金面，还有这场事？","book":"王统照《银龙集·站长》"},"similar":["不看僧面看佛面"],"usage":"作谓语，分句；形容宽容某人或某事"},{"id":2564,"word":"不看僧面看佛面","pinyin":"bù kàn sēng miàn kàn fó miàn","abbr":"bksmkfm","explanation":"比喻请看第三者的情面帮助或宽恕某一个人。","source":{"text":"古人云：‘不看僧面看佛面。’兄长既是到此，万望救他一救。","book":"明·吴承恩《西游记》第31回"},"example":{"text":"当然，朋友有困难不好袖手旁观，最近公会方面又约我谈了，～，总得给公会一个面子。","book":"周而复《上海的早晨》第一部十三"},"similar":["不看金面看佛面"],"usage":"作谓语，分句；形容宽容某人或某事"},{"id":2565,"word":"不看金面看佛面","pinyin":"bù kàn jīn miàn kàn fó miàn","abbr":"bkjmkfm","explanation":"比喻请看第三者的情面帮助或宽恕某一个人。同“不看僧面看佛面”。","source":{"text":"大天王哀求说：‘自成，老表，闯王，不看金面看佛面，看来如岳叔的情面上，你抬抬手让我过去吧！’","book":"姚雪垠《李自成》第一卷第十二章"},"similar":["不看僧面看佛面","不看佛面看金面"],"usage":"作谓语，分句；形容宽容某人或某事"},{"id":2566,"word":"不眠之夜","pinyin":"bù mián zhī yè","abbr":"bmzy","explanation":"眠：睡眠。不曾睡眠的夜晚。常指极度兴奋或过分忧虑而睡不着觉。"},{"id":2567,"word":"不着疼热","pinyin":"bù zhuó téng rè","abbr":"bztr","explanation":"犹言无关痛痒。指不体贴爱护。","source":{"text":"这一个小厮，必是你乞养来的螟蛉之子，不着疼热，所以着他偿命。","book":"元·关汉卿《蝴蝶梦》第二折"},"example":{"text":"元·关汉卿《蝴蝶梦》第二折：“这一个小厮，必是你乞养来的螟蛉之子，不着疼热，所以着他偿命。”"},"similar":["漠不关心"],"opposite":["知冷知热"],"usage":"作谓语、定语；用于处世"},{"id":2568,"word":"不着边际","pinyin":"bù zhuó biān jì","abbr":"bzbj","explanation":"着：接触；边际：边界，边缘。挨不着边儿。多指说话空泛，不接触实际。","source":{"text":"何涛思想：在此不着边际，怎生奈何！我须用自去一遭。","book":"明·施耐庵《水浒全传》第十九回"},"example":{"text":"周氏和张氏又谈了一些～的闲话。","book":"巴金《春》十五"},"similar":["无的放矢","空洞无物","离题万里"],"opposite":["一语道破","一针见血","一语中的"],"usage":"作谓语、定语、状语；形容言论空泛","story":["从前有个天生就是瞎子的人从来没有见过太阳，向别人打听太阳是什么模样，别人告诉他太阳形状像圆盘，太阳光像蜡烛光，他却把钟、笛等当作太阳，闹出很多笑话和误会，最终还是不知道太阳是什么样子"]},{"id":2569,"word":"不瞅不睬","pinyin":"bù chǒu bù cǎi","abbr":"bcbc","explanation":"不看也不答理。形容待人态度冷淡。","source":{"text":"女婿功名不遂回来，一家不偢不倸。","book":"明·苏复之《金印记·周氏回家》"},"example":{"text":"姑奶奶平日只敬重的王家哥儿两个，把我们～；我们没来由今日为他得罪严老大。","book":"清·吴敬梓《儒林外史》第六回"},"similar":["不偢不倸","不理不睬"],"opposite":["热情洋溢"],"usage":"作谓语、定语；形容人态度高傲"},{"id":2570,"word":"不瞽不聋","pinyin":"bù gǔ bù lóng","abbr":"bgbl","explanation":"意为不故作痴呆，不装聋作哑，就不能当好阿公阿婆。形容长辈要宽宏大量。","source":{"text":"谚云：不聪不明，不能为王；不瞽不聋，不能为公。","book":"语出《太平御览》卷四九六引《慎子》逸文"},"similar":["不痴不聋"],"usage":"作谓语、定语；用于书面语"},{"id":2571,"word":"不矜不伐","pinyin":"bù jīn bù fá","abbr":"bjbf","explanation":"矜、伐：自夸自大。不自经为了不起，不为自己吹嘘。形容谦逊。","source":{"text":"汝惟不矜，天下莫与汝争能；汝惟不伐，天下莫与汝争功。","book":"《尚书·大禹谟》"},"example":{"text":"自觉笔势如群山起伏，连绵不断而一气呵成，说理极其酣畅，而文气～，颇为动听。","book":"高阳《清宫外史》上册"},"similar":["虚怀若谷","不卑不亢"],"opposite":["妄自尊大","自高自大"],"usage":"作谓语、定语、状语；形容谦虚谨慎"},{"id":2572,"word":"不矜不盈","pinyin":"bù jīn bù yíng","abbr":"bjby","explanation":"矜：矜持，拘谨；盈：多余，过分。不矜持，不过分。形容态度把握有分寸。","source":{"text":"既寿而康，既备而成，不歉于约，不矜不盈。","book":"唐·韩愈《河南府法曹参军卢府君夫人苗氏墓志铭》"}},{"id":2573,"word":"不矜细行","pinyin":"bù jīn xì xíng","abbr":"bjxx","explanation":"指不注重小事小节。","source":{"text":"不矜细行，终累大德。","book":"语出《书·旅獒》"},"example":{"text":"顾又噭然哀鸣，忘夙债而念夙隙，是先生犹有蓬之心也。所谓～者，乃至此乎？","book":"清·和邦额《夜谭随录·阮龙光》"},"similar":["不护细行"],"opposite":["谨小慎微"],"usage":"作谓语、定语；指不拘小节"},{"id":2574,"word":"不矜而庄","pinyin":"bù jīn ér zhuāng","abbr":"bjez","explanation":"矜：自尊自大；庄：庄重。不自养自大而显得庄重。","source":{"text":"子言之：‘归乎！君子隐而显，不矜而庄，不厉而威，不言而信。’","book":"《礼记·表记》"}},{"id":2575,"word":"不知丁董","pinyin":"bù zhī dīng dǒng","abbr":"bzdd","explanation":"比喻不懂事，缺乏知识。","source":{"text":"曹操既擒吕布，欲缓其缚。刘备曰：‘公不见丁建阳、董太师乎？’","book":"清·赵翼《陔余丛考·成语》"}},{"id":2576,"word":"不知不觉","pinyin":"bù zhī bù jué","abbr":"bzbj","explanation":"知：知道；觉：觉察。没有意识到，没有觉察到。现多指未加注意。","source":{"text":"遂使昏愚之徒，听其妖诞，舍正从邪，醉生梦死，不知不觉。尧舜三代以前，未闻有此教。","book":"明·赵弼《两教辨》"},"example":{"text":"他的残忍和狠毒，时而～地在老人面前显露出来。","book":"曹禺《王昭君》第二幕"},"similar":["神不知，鬼不觉"],"opposite":["惊天动地"],"usage":"作谓语、定语；形容无意识的"},{"id":2577,"word":"不知世务","pinyin":"bù zhī shì wù","abbr":"bzsw","explanation":"不知道当代的情势。","source":{"text":"孟子守旧术，不知世务。","book":"汉·桓宽《盐铁论·论儒》"},"example":{"text":"清·褚人获《隋唐演义》第18回：“这老妇人～，一个女儿，受了人的聘礼，还不曾出嫁，带了街上看灯，却撞上宇文公子抢了去。”"},"similar":["不识时务"],"usage":"作谓语、定语；用于处事"},{"id":2578,"word":"不知人间有羞耻事","pinyin":"bù zhī rén jiān yǒu xiū chǐ shì","abbr":"bzrjyxcs","explanation":"形容无耻到极点。","source":{"text":"是足下不复知人间有羞耻事尔。","book":"宋·欧阳修《与高司谏书》"},"example":{"text":"他是那种～的人。"},"similar":["恬不知耻"],"opposite":["自尊自爱"],"usage":"作谓语、定语；指人不知廉耻","story":["北宋时期散文家欧阳修勤奋好学，在22岁那年进入官场，他因支持范仲淹的政治改革，遭到反对派谏官高若纳的诽谤，他写信给高若纳，大骂他是不知道人间有羞耻这回事，被宋仁宗贬到外地去当县令，直到范仲淹重新被起用才调回京城"]},{"id":2579,"word":"不知何许人","pinyin":"bù zhī hé xǔ rén","abbr":"bzhxr","explanation":"许：处所。不知道是哪里人。","source":{"text":"汉阴老父者，不知何许人也。","book":"南朝·宋·范晔《后汉书·逸民传》"},"example":{"text":"那先生～，待我去打听一下。"},"usage":"作谓语；用于疑问句"},{"id":2580,"word":"不知其子视其父","pinyin":"bù zhī qí zǐ shì qí fù","abbr":"bzqzsqf","explanation":"不了解这个人但从他父亲的为人就可以知道。表示教育、环境对于一个人的影响很大。","source":{"text":"不知其子视其父，不知其人视其友，不知其君观其所使，不知其地视其草木。","book":"《孔子家语·六本》"}},{"id":2581,"word":"不知其所以然","pinyin":"bù zhī qí suǒ yǐ rán","abbr":"bzqsyr","explanation":"不知它究竟如何会这样的。指不了解事物的本质或事情的根底。","source":{"text":"今予动吾天机，而不知其所以然。","book":"《庄子·秋水》"}},{"id":2582,"word":"不知其详","pinyin":"bù zhī qí xiáng","abbr":"bzqx","explanation":"不知道他的详细情况。","source":{"text":"施御史家的事，我也略闻，不知其详。","book":"清·吴敬梓《儒林外史》第四十四回"},"example":{"text":"清·名教中人《好逑传》第11回：“此时铁公子因冯按院出告示的缘故，～，放心不下。”"},"opposite":["了如指掌"],"usage":"作谓语；指不知道他的详细情况"},{"id":2583,"word":"不知凡几","pinyin":"bù zhī fán jǐ","abbr":"bzfj","explanation":"凡：总共。不知道一共有多少。指同类的事物很多。","source":{"text":"春兴不知凡几首，衡阳纸价顿能高。","book":"唐·郭受《寄杜员外》诗"},"example":{"text":"所作酬应文字，类此者～，殆亦文人通病，乌得以咎趼人？","book":"鲁迅《小说旧闻钞·二十年目睹之怪现状》"},"similar":["比比皆是"],"opposite":["寥寥无几"],"usage":"作谓语；表示不知道有多少"},{"id":2584,"word":"不知利害","pinyin":"bù zhī lì hài","abbr":"bzlh","explanation":"不知什么为利，什么为害。","source":{"text":"子不知利害，则至人固不知利害乎？","book":"战国·宋·庄周《庄子·齐物论》"},"example":{"text":"你不要～，事情很严重。"},"similar":["不知进退"],"usage":"作谓语；形容鲁莽从事"},{"id":2585,"word":"不知去向","pinyin":"bù zhī qù xiàng","abbr":"bzqx","explanation":"向：方向。不知道哪里去了。","source":{"text":"宣王问曰：‘如今红衣小儿何在？’答曰：‘自教歌之后，不知去向。’","book":"明·冯梦龙《东周列国志》第一回"},"example":{"text":"他一下子就～。"},"similar":["无影无踪"],"usage":"作谓语；形容找不到某人或事物"},{"id":2586,"word":"不知大体","pinyin":"bù zhī dà tǐ","abbr":"bzdt","explanation":"大体：关系全局的道理。不懂得从大局考虑。同“不识大体”。","source":{"text":"臣之俗，特以牍书不报，小期会不答耳，以为大故，不可矣。天下之大指举之，而激俗流失，世坏败矣，因恬弗知怪，大故也。如刀笔之吏，务在筐箱，而不知大体，陛下又弗自忧，故如此哉。","book":"汉·贾谊《新书·俗激》"},"example":{"text":"刘子振，蒲人也，颇富学业，而～。","book":"五代·王定保《唐摭言·四凶》"},"similar":["不识大体"],"usage":"作谓语、宾语、定语；指眼光短浅"},{"id":2587,"word":"不知天高地厚","pinyin":"bù zhī tiān gāo dì hòu","abbr":"bztgdh","explanation":"不知道天有多高，地有多深。形容骄狂无知。","source":{"text":"吾不知天之高也，地之下也。","book":"《庄子·让王》"},"example":{"text":"如今年过知非，想起幼年这些～的话来，真觉后悔。","book":"清·文康《儿女英雄传》第三十四回"},"similar":["不知深浅","不知利害"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；形容狂妄无知"},{"id":2588,"word":"不知头脑","pinyin":"bù zhī tóu nǎo","abbr":"bztn","explanation":"弄不清楚是怎么回事。犹不知所措。","source":{"text":"又恐怕因此惹恼了他，连自己身子立不勾，却又不见得李参军触恼他一些处，正是不知一个头脑。","book":"明·凌濛初《初刻拍案惊奇》卷三十"}},{"id":2589,"word":"不知好歹","pinyin":"bù zhī hǎo dǎi","abbr":"bzhd","explanation":"不知道好坏。多指不能领会别人的好意。","source":{"text":"做儿的不知好歹，做娘的不辨清浊。","book":"元·郑廷玉《金凤钗》第二折"},"example":{"text":"袭人也帮着抢白我，说了我许多～的话，回不得主了的。","book":"清·曹雪芹《红楼梦》第四十六回"},"similar":["不识好歹","不识抬举"],"opposite":["心知肚明","知好知歹"],"usage":"作谓语、定语；指不辨好坏"},{"id":2590,"word":"不知寝食","pinyin":"bù zhī qǐn shí","abbr":"bzqs","explanation":"bù  zhī  qǐn  shí"},{"id":2591,"word":"不知就里","pinyin":"bù zhī jiù lǐ","abbr":"bzjl","explanation":"就里：其中，内情。不知道内幕。","source":{"text":"你寻思，甚做处，不知就里。","book":"金·董解元《西厢记》卷四"},"example":{"text":"生～，趋近软语，代为卸妆。","book":"清·宣鼎《夜雨秋灯录·麻疯女邱丽玉》"},"similar":["不知内情"],"usage":"作谓语、定语；指不了解内情"},{"id":2592,"word":"不知底细","pinyin":"bù zhī dǐ xì","abbr":"bzdx","explanation":"不知道人或事情的内情。","source":{"text":"我也不知底细。","book":"清·吴趼人《二十年目睹之怪现状》第67回"},"example":{"text":"请严查那些～的人。"},"similar":["来历不明","来路不明"],"usage":"作谓语、定语；用于人或事物"},{"id":2593,"word":"不知所为","pinyin":"bù zhī suǒ wéi","abbr":"bzsw","explanation":"不知道该怎么办。犹言无计可施。","source":{"text":"上欲废太子，立戚夫人子赵王如意。大臣多谏争，未能得坚决者也。吕后恐，不知所为。","book":"《左传·宣公十二年》：“桓子不知所为。”《史记·留侯世家》"},"example":{"text":"《左传·宣公十二年》：“桓子不知所为。”《史记·留侯世家》：“上欲废太子，立戚夫人子赵王如意。大臣多谏争，未能得坚决者也。吕后恐，不知所为。”"},"similar":["不知所从"],"usage":"作谓语；用于处事"},{"id":2594,"word":"不知所云","pinyin":"bù zhī suǒ yún","abbr":"bzsy","explanation":"云：说。不知道说得是些么。形容说话内容混乱，无法理解。","source":{"text":"临表涕泣，不知所云。","book":"三国·蜀·诸葛亮《出师表》"},"example":{"text":"这篇文章逻辑性太差，使人看了～。"},"similar":["不得要领","语无伦次","吞吞吐吐"],"opposite":["简明扼要","通俗易懂","提纲挈领"],"usage":"作谓语、定语、状语；表示不知道说什么","story":["三国时期，刘备临终时叫儿子刘禅拜诸葛亮为相父，诸葛亮恢复与东吴联盟，休养生息，发展生产，率军南征，七擒孟获。随后率军伐魏，临行前写下《出师表》：“臣不胜受恩感激。今当远离，临表涕泣，不知所云。”"]},{"id":2595,"word":"不知所从","pinyin":"bù zhī suǒ cóng","abbr":"bzsc","explanation":"不知怎么办。形容拿不定主意。","source":{"text":"心烦虑乱，不知所从。","book":"战国·楚·屈原《楚辞·卜居》"},"similar":["不知所措"],"usage":"作谓语、定语；用于处事"},{"id":2596,"word":"不知所以","pinyin":"bù zhī suǒ yǐ","abbr":"bzsy","explanation":"以：原因。不明白为什么是这样。指不知道原因。","source":{"text":"遽见追乎，不知所以。","book":"唐·张彦远《法书要录·购兰亭序》"},"example":{"text":"咪咪忽然拿起一只锅盖，用一只骨筷乒乒乓乓敲起来，敲得他～，惊惶失措，晕头转向。","book":"王安忆《流逝》"},"similar":["不知就里","一无所知","茫然不解"],"opposite":["了如指掌","一目了然","明察秋毫"],"usage":"作谓语、补语；指人不明原故，感到意外"},{"id":2597,"word":"不知所出","pinyin":"bù zhī suǒ chū","abbr":"bzsc","explanation":"①不知道从哪里来的。②不知道该怎么办。","source":{"text":"不知所从来。","book":"《文选·宋玉》：“卒愕异物，不知所出。”李善注"},"example":{"text":"大臣忧惧，～。","book":"汉·司马迁《报任少卿书》"},"usage":"作谓语；用于处事"},{"id":2598,"word":"不知所厝","pinyin":"bù zhī suǒ cuò","abbr":"bzsc","explanation":"厝：放置；安排。不知道怎么办才好。形容处境为难或心神慌乱。","source":{"text":"忧惶屏营，不知所厝。","book":"晋·庚亮《让中书令表》"},"similar":["不知所措"],"opposite":["得心应手"],"usage":"作谓语、状语；指处境很为难"},{"id":2599,"word":"不知所可","pinyin":"bù zhī suǒ kě","abbr":"bzsk","explanation":"不知道该怎么办才好。","source":{"text":"不想这番好意把个可左可右的安公子此时倒弄到左右不知所可。","book":"《儿女英雄传》第三一回"},"example":{"text":"只剩李秀成一人，他捧着赐袍，又是惶惑，又是悲苦，有说不出的滋味，茫然～。","book":"欧阳予倩《忠王李秀成》第三幕"},"similar":["不知所措"],"usage":"作谓语、状语；指不知道该怎样办才好"},{"id":2600,"word":"不知所措","pinyin":"bù zhī suǒ cuò","abbr":"bzsc","explanation":"错：错开；处置。不知道怎么办才好。形容处境为难或心神慌乱。","source":{"text":"振主喜怒无度，严诛列赦，臣下振怒，不知所错，则人反其故。","book":"《管子·七臣七主》"},"example":{"text":"巴金《秋》十四：“他站在那里～，身子微微发颤。”"},"similar":["手足无措","惊惶失措","心慌意乱"],"opposite":["从容不迫","不动声色","应付自如"],"usage":"作谓语、状语、定语；指处境很为难","story":["三国时期，诸葛亮的哥哥诸葛谨的儿子诸葛恪自幼聪明过人，成年后被孙权封为太子太傅。他不满意太子孙和。在孙权死后立即废掉太子，另立10岁的孙亮为皇帝，自己全权执政。他得意洋洋，在写给他弟弟诸葛融的信中表示：“哀喜交并，不知所措。”"]},{"id":2601,"word":"不知所终","pinyin":"bù zhī suǒ zhōng","abbr":"bzsz","explanation":"终：最后，结局。不知道结局或下落。","source":{"text":"遂乘扁舟，以浮于五湖，莫知其所终极。","book":"《庄子·田子方》：“日夜无隙，而不知其所终。”《国语·越语下》"},"example":{"text":"余幼在湖口，有一僧持显者书，周行各郡县……后～。","book":"清·采蘅子《虫鸣漫录》"},"similar":["下落不明"],"usage":"作谓语；表示不知道结局或下落","story":["东汉时期，河南穷困读书人向长对《老子》和《易经》很有研究，乡下人认为他很有学问。朝廷派人请他去京城做官，他婉言谢绝。乡亲们都认为他是学问太深变得越来越糊涂。后来他约几个老朋友去泰山、衡山等地，几年之后他不知所终"]},{"id":2602,"word":"不知所言","pinyin":"bù zhī suǒ yán","abbr":"bzsy","explanation":"形容说话内容混乱，无法理解。同“不知所云”。","source":{"text":"臣不胜受恩感激，今当远离，临表涕零，不知所言。","book":"《三国志·蜀书·诸葛亮传》"},"example":{"text":"公长民短，临时～，既后觉其不可耳。","book":"南朝·宋·刘义庆《世说新语·政事》"},"similar":["不知所云"],"usage":"作谓语、定语、宾语；常用于书信等"},{"id":2603,"word":"不知所错","pinyin":"bù zhī suǒ cuò","abbr":"bzsc","explanation":"错：同“措”，处置。不知道怎么办才好。形容处境为难或心神慌乱","source":{"text":"振主喜怒无度，严诛无赦，臣下振恐，不知所错，则人反其故。","book":"春秋·齐·管仲《管子·七臣七主》"},"similar":["不知所措"],"usage":"作谓语、状语、补语；指处境很为难"},{"id":2604,"word":"不知春秋","pinyin":"bù zhī chūn qiū","abbr":"bzcq","explanation":"不知道当前是什么季节或局面。","example":{"text":"你这是～的做法。"},"similar":["不合时宜"],"usage":"作谓语、定语、宾语；用于为人"},{"id":2605,"word":"不知有汉，何论魏晋","pinyin":"bù zhī yǒu hàn，hé lùn wèi jìn","abbr":"bzyhhlwj","explanation":"不知道有汉朝，三国魏及晋朝就更不知道了。形容因长期脱离现实，对社会状况特别是新鲜事物一无所知。也形容知识贫乏，学问浅薄。","source":{"text":"先世避秦时乱，率妻子邑人，来此绝境，不复出焉，遂与外人间隔。问今是何世，乃不知不汉，何论魏晋。","book":"晋·陶渊明《桃花源记》"},"usage":"作宾语、分句；用于人的见识","story":["东晋时一渔夫只身划船进入一山洞，发现一座桃源，这里的居民男耕女织，大人小孩均参加劳动。他询问一个老人是何地，老人回答他说他们的祖先为躲避秦时的战乱而迁居到此，就没有出去过。渔夫问是什么朝代，老人回答：“不知有汉，何论魏晋。”"]},{"id":2606,"word":"不知权变","pinyin":"bù zhī quán biàn","abbr":"bzqb","explanation":"权变：随机应变。不能根据实际情况而改变。","source":{"text":"故虽有诚信之心，不知权变，危亡之道也。","book":"汉·桓宽《盐铁论·世务》"},"similar":["不知变通"],"opposite":["见机行事"],"usage":"作谓语、定语；用于处事"},{"id":2607,"word":"不知死所","pinyin":"bù zhī sǐ suǒ","abbr":"bzss","explanation":"所：处所。不知道死在那里。","source":{"text":"庄宗迫之出站，德威谓其子曰：‘吾不知死所矣！’父子俱战没。","book":"宋·孔平仲《续世说·尤悔》"},"example":{"text":"明·冯梦龙《醒世恒言》第19卷：“妾～矣！”"},"opposite":["死得其所"],"usage":"作谓语、定语；用于人等"},{"id":2608,"word":"不知死活","pinyin":"bù zhī sǐ huó","abbr":"bzsh","explanation":"形容不知利害，冒昧从事。","source":{"text":"无才小辈，背反狂夫。上负朝廷之恩，下辱祖宗名目，不知死活，引军到来，有何理说？","book":"明·施耐庵《水浒全传》第六十七回"},"example":{"text":"彼时日色将晚，前无行人，就把他尽力一推，推落崖下，～。","book":"明·凌濛初《初刻拍案惊奇》卷三十"},"similar":["不知利害","不知进退","不知轻重"],"opposite":["贪生怕死"],"usage":"作谓语；形容冒昧从事"},{"id":2609,"word":"不知深浅","pinyin":"bù zhī shēn qiǎn","abbr":"bzsq","explanation":"原意是不知道水的深浅。后多用以形容不懂得事情的利害。","source":{"text":"抑且水荡坡塘，不知深浅。","book":"明·施耐庵《水浒全传》第十九回"},"example":{"text":"这和尚～，那三个魔头，神通广大得紧哩！","book":"明·吴承恩《西游记》第七十四回"},"similar":["不知利害","不知高低"],"opposite":["自知之明"],"usage":"作谓语、定语；比喻说话或做事没有分寸","story":["唐僧师徒四人西天取经，经过平顶山时，遇到一小神仙假扮的樵夫，说前边的莲花洞里有两个魔法十分高强的妖魔等着吃唐僧肉。搞得孙悟空都只好不知深浅地去与妖魔会一会，结果孙悟空用计收服了这两个妖魔"]},{"id":2610,"word":"不知甘苦","pinyin":"bù zhī gān kǔ","abbr":"bzgk","explanation":"甘苦：甜和苦，多偏指苦。分不清是甜还是苦。形容做某事不容易或对前人的艰辛没有体会。","source":{"text":"少尝苦曰苦，多尝苦曰甘，则必以此人为不知甘苦之辨矣。","book":"《墨子·非攻上》"},"example":{"text":"清·李宝嘉《官场现形记》第43回：“少年正待开口，却被老头子抢着说了一遍，无非是怪少年～，不会弄钱的一派话。”"},"similar":["麻木不仁"],"opposite":["饱经风霜"],"usage":"作谓语、定语；指不知苦与甜"},{"id":2611,"word":"不知疼痒","pinyin":"bù zhī téng yǎng","abbr":"bzty","explanation":"是疼是痒都不知道。比喻不体贴，不关心。","source":{"text":"便是留守相公自来监押時，也容我们说一句。你好不知疼痒，只顾逞办！","book":"明·施耐庵《水浒传》第十六回"},"similar":["不知痛痒"],"usage":"作谓语、定语；指人麻木"},{"id":2612,"word":"不知痛痒","pinyin":"bù zhī tòng yǎng","abbr":"bzty","explanation":"是痛是痒都不知道。比喻不体贴，不关心。","source":{"text":"而今的世界只管讲那道学，说正心诚意的，多是一班害了风痹病，不知痛痒之人。","book":"《二刻拍案惊奇》卷十二"},"example":{"text":"钱钟书《围城》：“因为这事要亲人干，旁人～，下手太重，变成把棒打了。”"},"similar":["不知疼痒","麻木不仁"],"usage":"作谓语、定语；指人麻木"},{"id":2613,"word":"不知端倪","pinyin":"bù zhī duān ní","abbr":"bzdn","explanation":"端倪：头绪。不知头绪。","source":{"text":"反复终始，不知端倪。","book":"《庄子·大宗师》"},"usage":"作谓语；指不知头绪"},{"id":2614,"word":"不知纪极","pinyin":"bù zhī jì jí","abbr":"bzjj","explanation":"纪极：终极，限度。原形容贪得无厌。亦表示极多。","source":{"text":"无厌之心，不知纪极。","book":"《后汉书·杨震传》"},"example":{"text":"前后非时赏赐，当亦～。","book":"唐·柳珵《上清传》"},"similar":["贪得无厌"],"usage":"作谓语、定语；用于人或事物"},{"id":2615,"word":"不知老之将至","pinyin":"bù zhī lǎo zhī jiāng zhì","abbr":"bzlzjz","explanation":"不知道老年即将来临。形容人专心工作，心怀愉快，忘掉自己的衰老。","source":{"text":"其为人也，发愤忘食，乐以忘忧，不知老之将至云尔。","book":"《论语·述而》"},"example":{"text":"直与同志者为群，～。","book":"唐·王绩《答刺史杜之松书》"}},{"id":2616,"word":"不知者不罪","pinyin":"bù zhī zhě bù zuì","abbr":"bzzbz","explanation":"罪：责备，怪罪。因事先不知道而有所冒犯，就不加怪罪。","source":{"text":"起凤道：‘牛兄何不早通姓名，使小弟多多得罪。勿怪，勿怪。’牛通道：‘不知者不罪。’","book":"清·钱彩《说岳全传》第六十三回"},"similar":["不知者不怪"],"usage":"作宾语、定语；用于口语"},{"id":2617,"word":"不知肉味","pinyin":"bù zhī ròu wèi","abbr":"bzrw","explanation":"原指被美妙的音乐所陶醉，因而辨不出肉味。后形容专心学习，吃东西辨不出味道。也形容生活困难，无肉可吃。","source":{"text":"子在齐闻《韶》，三月不知肉味。曰：‘不图为乐之至于斯也。’","book":"春秋·鲁·孔丘《论语·述而》"},"example":{"text":"小人已三月～矣。","book":"清·王端履《重论文斋笔录》"},"opposite":["食前方丈","日食万钱"],"usage":"作谓语、定语；指生活贫困","story":["春秋时期，孔子到齐国游学，他到郊外散步，他听到一阵悦耳的音乐，就循声走去，看见一个老人在树林里演奏《韶》乐，悠扬的乐声把孔子心中烦闷驱逐得一干二净。以后的几个月孔子一直陶醉在这音乐中，不知道吃肉的味道"]},{"id":2618,"word":"不知自爱","pinyin":"bù zhī zì ài","abbr":"bzza","explanation":"不知道爱惜自己。","example":{"text":"父母师长如此爱护他。他却～，自甘堕落，怎不令人痛惜！"},"opposite":["洁身自爱"],"usage":"作谓语、定语；用于处世"},{"id":2619,"word":"不知自量","pinyin":"bù zhī zì liàng","abbr":"bzzl","explanation":"形容没有正确估计自己的能力有多大。","example":{"text":"形容没有正确估计自己的能力有多大。"},"similar":["自不量力"],"usage":"作谓语、定语；用于处世"},{"id":2620,"word":"不知薡蕫","pinyin":"bù zhī dīng dǒng","abbr":"bzdd","explanation":"薡蕫：草名，质地柔软可制绳子。比喻不懂事，缺乏知识。","source":{"text":"似蒲而细。不知薡蕫者，岂不辨菽麦意乎？","book":"《尔雅·释草》：“莢，薡蕫。”郭璞注"},"example":{"text":"吾里谓愚者曰‘～’。","book":"明·董斯张《吹景集·俗语有所祖》"},"similar":["不辨菽麦"],"usage":"作谓语、定语；指人不懂事"},{"id":2621,"word":"不知藋蕫","pinyin":"bù zhī dīng dǒng","abbr":"bzdd","explanation":"藋蕫草名，质地柔软可制绳子。比喻不懂事，缺乏知识。","source":{"text":"莢，藋蕫。郭璞注似蒲而细。不知藋蕫者，岂不辨菽麦意乎？","book":"《尔雅·释草》"},"quote":{"text":"吾里谓愚者曰‘～’。","book":"明·董斯张《吹景集·俗语有所祖》"}},{"id":2622,"word":"不知虚实","pinyin":"bù zhī xū shí","abbr":"bzxs","explanation":"虚实：或虚或实，情况。泛指不掌握或虚或实的内部情况。","source":{"text":"向者不知虚实，故败。","book":"《汉晋春秋》"},"similar":["不知底细"],"usage":"作谓语、定语；用于处事等"},{"id":2623,"word":"不知贵贱","pinyin":"bù zhī guì jiàn","abbr":"bzgj","explanation":"指不知事物的轻重与价值。","source":{"text":"你若说你和我一样，你就是不知贵贱的人了。","book":"清·李百川《绿野仙踪》第84回"},"example":{"text":"他是一个～的家伙。"},"similar":["不知轻重"],"usage":"作谓语、定语；用于人处事"},{"id":2624,"word":"不知起倒","pinyin":"bù zhī qǐ dǎo","abbr":"bzqd","explanation":"不知利害，不知高低。","source":{"text":"你可知他一面在这里服药，一面在那边戕伐，碰了个不知起倒的医生还给他服点燥烈之品，正是‘泼油救火’，恐怕他死得不快罢了。","book":"《二十年目睹之怪现状》第八五回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第85回：“你可知他一面在这里服药，一面在那边戕伐，碰了个～的医生还给他服点燥烈之品。”"},"similar":["不识起倒"],"usage":"作谓语、定语；指不知好歹"},{"id":2625,"word":"不知轻重","pinyin":"bù zhī qīng zhòng","abbr":"bzqz","explanation":"不懂得事情要紧不要紧。","source":{"text":"今世之人，惑者多以性养物，则不知轻重也。","book":"《吕氏春秋·本生》"},"example":{"text":"婆子们～，说是这两日有些病，恐不能就好，到这里问大夫。","book":"清·曹雪芹《红楼梦》第一０九回"},"similar":["不明事理"],"opposite":["知书达理"],"usage":"作谓语、定语；形容冒昧行事"},{"id":2626,"word":"不知轻重缓急","pinyin":"bù zhī qīng zhòng huǎn jí","abbr":"bzqzhj","explanation":"指人办事不知事情有主要的、次要的，急办的和可缓办的区别。","source":{"text":"上级机关也不要不分轻重缓急地没有中心地同时指定下级机关做很多项工作。","book":"毛泽东《关于领导方法的若干问题》"},"similar":["不分轻重缓急"],"usage":"作谓语、定语、宾语；用于办事没条理"},{"id":2627,"word":"不知进退","pinyin":"bù zhī jìn tuì","abbr":"bzjt","explanation":"不知道应当前进还是应当后退。比喻无决断。也形容言语行动没有分寸。","source":{"text":"慕容绍宗挫败侯景，一时将帅皆莫及，而围攻颖川，不知进退，赴水而死。","book":"宋·洪迈《容斋续笔》卷十一"},"example":{"text":"他们已经多嫌着我呢！如今我还～，何苦叫他们咒我？","book":"清·曹雪芹《红楼梦》第四十五回"},"similar":["不知高低"],"opposite":["八面圆通"],"usage":"作谓语、定语；形容鲁莽"},{"id":2628,"word":"不知颠倒","pinyin":"bù zhī diān dǎo","abbr":"bzdd","explanation":"犹言不明事理。","source":{"text":"明·施耐庵《水浒传》第十九回：不想这些带来的官兵，人人亦不知顛倒。天色又看看晚了。”"},"similar":["不明事理"],"usage":"作谓语、定语；用于为人处世"},{"id":2629,"word":"不知高下","pinyin":"bù zhī gāo xià","abbr":"bzgx","explanation":"指说话做事不知轻重。","source":{"text":"先生，谢得您救俺也，只俺有句不知高下的话儿敢说么？","book":"明·康海《中山狼》第三折"},"example":{"text":"清·荻岸山人《平山冷燕》第16回：“实出孤陋，每有所作，往往～。”"},"similar":["不知高低"],"opposite":["恰如其分"],"usage":"作谓语、定语；用于说话做事"},{"id":2630,"word":"不知高低","pinyin":"bù zhī gāo dī","abbr":"bzgd","explanation":"指说话或做事不知深浅轻重。","source":{"text":"你那老头子，说话不知高低。","book":"明·吴承恩《西游记》第十五回"},"example":{"text":"那安妈妈是妇道家，～，便向乐公撺掇其事。","book":"明·冯梦龙《警世通言》卷二十三"},"similar":["不知深浅","初生牛犊"],"opposite":["知根达底"],"usage":"作谓语、定语；形容说话做事不知轻重"},{"id":2631,"word":"不破不立","pinyin":"bù può bù lì","abbr":"bpbl","explanation":"不破除旧的，就不能建立新的。","source":{"text":"不破不立，不塞不流，不止不行，它们之间的斗争是生死斗争。","book":"毛泽东《新民主主义论》"},"example":{"text":"～，要树立新规，必先废除旧习。"},"similar":["大破大立","除旧布新"],"opposite":["老调重弹","倒行逆施"],"usage":"作定语、分句；指不批评旧事物就不能发展"},{"id":2632,"word":"不磷不缁","pinyin":"bù lín bù zī","abbr":"blbz","explanation":"磨不薄，染不黑。比喻坚贞高洁的品质，不因外界影响而有所改变。","source":{"text":"言至坚者磨而不薄，至白者染之於涅而不黑。君子虽在浊乱，浊乱不能污。","book":"语出《论语·阳货》：“不曰坚乎，磨而不磷。不曰白乎，涅而不缁。”何晏集解引孔安国曰"},"example":{"text":"赵公得罪，门下士往往畏匿改事，独公～，如赵公在时。","book":"宋·叶適《提刑检详王公墓志铭》"},"similar":["磨而不磷，涅而不缁"],"opposite":["随波逐流"],"usage":"作谓语、定语；用于为人","story":["春秋时期，孔子在鲁国政坛遭到排挤后，带领弟子们周游列国，先后在卫国、宋国等没受到重视，在赴晋的途中，子路劝他不要去投奔赵鞅这种小人，孔子相信自己是君子，会“磨而不磷，涅而不缁”，不会玷污自己的名声的"]},{"id":2633,"word":"不祥之兆","pinyin":"bù xiáng zhī zhào","abbr":"bxzz","explanation":"兆：预兆。不吉利的预兆。","source":{"text":"汝之生，不祥之证。","book":"《战国策·秦策一》：“襄主错龟数策占兆，以视利害。”北魏·郦道元《水经注》卷一"},"example":{"text":"吴学究谏道：“此乃～，兄长改日出军。”","book":"明·施耐庵《水浒全传》第六十回"},"similar":["凶多吉少","大祸临头","不祥之征"],"opposite":["福星高照","洪福齐天","不虞之誉"],"usage":"作宾语；指不好的预兆"},{"id":2634,"word":"不祥之征","pinyin":"bù xiáng zhī zhēng","abbr":"bxzz","explanation":"征：征兆。指不好的预兆。","source":{"text":"恒水上流有一国，国王小夫人生肉胎，大夫人妒之，言：‘汝之生，不祥之征。’即盛以木函，掷恒水中。","book":"北魏·郦道元《水经注·河水》"},"similar":["不祥之兆"],"usage":"作宾语；指不好的预兆"},{"id":2635,"word":"不祥之木","pinyin":"bù xiáng zhī mù","abbr":"bxzm","explanation":"祥：吉祥；木：树。不吉祥的树。即被雷电所毁的树。指不会带来吉利的庇护者。","source":{"text":"佐祭者得尝，救斗者得伤，荫不祥之木，为雷电所扑。","book":"《淮南子·说林训》"}},{"id":2636,"word":"不祧之宗","pinyin":"bù tiāo zhī zōng","abbr":"btzz","explanation":"不迁入祧庙的祖先。比喻创立某种事业而受到尊崇的人。祧：古代帝王的远祖的祠堂。","source":{"text":"曾文正公略师班氏，其文规恢闳阔，遂崒然直哜两汉，况进于此者邪？故今断以马、班、韩、欧为百世不祧之宗云。","book":"清·黎庶昌《序》"},"similar":["不祧之祖"],"usage":"作主语、宾语；指创业之祖"},{"id":2637,"word":"不祧之祖","pinyin":"bù tiāo zhī zǔ","abbr":"btzz","explanation":"祧：古代帝王的远祖的祠堂。不迁入祧庙的祖先。比喻创立某种事业而受到尊崇的人。","source":{"text":"今太祖受命开基，太宗缵承太宝，则百世不祧之庙矣。","book":"《宋史·礼志九》"},"example":{"text":"高适达夫七古，与岑一骨，骈语之中，独能顿宕，启后人无限法门，当为七言～。","book":"清·宋育人《三堂诗品》"},"similar":["不祧之宗"],"usage":"作主语、宾语；指创业之祖"},{"id":2638,"word":"不禁不由","pinyin":"bù jīn bù yóu","abbr":"bjby","explanation":"指不由自主。","source":{"text":"指不由自主。"},"similar":["情不自禁","不由自主"],"usage":"作状语；指不能自控"},{"id":2639,"word":"不私其利","pinyin":"bù sī qí lì","abbr":"bsql","explanation":"私；私有。不把利益据为己有。","source":{"text":"不伐其功，不私其利。","book":"春秋·齐·管仲《管子·形势解》"},"similar":["大公无私"],"opposite":["据为己有"],"usage":"作谓语；用于为人"},{"id":2640,"word":"不稂不莠","pinyin":"bù láng bù yǒu","abbr":"blby","explanation":"稂：狼尾草；莠：狗尾草。本指禾苗中中无野草。后比喻人不成才，没出息。","source":{"text":"既坚既好，不稂不莠。","book":"《诗经·小雅·大田》"},"example":{"text":"第一要他自己学好才好；不然，～的，反耽误了人家女孩儿，岂不可惜。","book":"清·曹雪芹《红楼梦》第八十四回"},"similar":["不郎不秀"],"usage":"作谓语、定语；形容人没有发展前途","story":["我国最早的诗歌总集《诗经》有一首反映西周农事生活的诗篇《大田》，诗人抒发风调雨顺带来丰收的喜悦心情：“谷粒长了皮壳，长得坚实完好，没有稂草莠草。除去青虫、丝虫等虫害，不让它祸害我的庄稼。稷神有灵，快把它们投进大火。”"]},{"id":2641,"word":"不稼不穑","pinyin":"bù jià bù sè","abbr":"bjbs","explanation":"稼：播种；穑：收获谷物。泛指不参加农业生产劳动。","source":{"text":"不稼不穑，胡取禾三百廛兮？","book":"《诗经·魏风·伐檀》"},"example":{"text":"～，民安天仰。","book":"唐·崔祐甫《唐卫尉卿洪州都督张公遗爱碑颂》"},"similar":["不事稼穑"],"usage":"作谓语；指不参加农业生产"},{"id":2642,"word":"不立文字","pinyin":"bù lì wén zì","abbr":"blwz","explanation":"佛家语，指禅家悟道，不涉文字不依经卷，唯以师徒心心相印，理解契合，传法授受。","source":{"text":"吾有正法眼藏，涅槃妙心，实相无相，微妙法门，不立文字，教外别传。","book":"宋·释普济《五灯会元·七佛·释迦牟尼佛》"},"example":{"text":"既非如霍光、寇准之不学无术，又非如释氏之～，瞎著去参。","book":"清·王夫之《读四书大全说·论语》"},"similar":["口传心授","口耳相传"],"usage":"作谓语；指口头传授"},{"id":2643,"word":"不竞南风","pinyin":"bù jìng nán fēng","abbr":"bjnf","explanation":"不竞：指乐音微弱；南风：南方的音乐。原指楚军战不能胜。后比喻竞赛的对手力量不强。","source":{"text":"不害，吾骤歌北风，又歌南风。南风不竞，多死声，楚必无功。","book":"《左传·襄公十八年》"},"example":{"text":"～，忽尔三生六劫通。","book":"宋·沈瀛《减字木兰花》词"}},{"id":2644,"word":"不竭之府","pinyin":"bù jié zhī fǔ","abbr":"bjzf","explanation":"取之不尽的府库。","source":{"text":"藏于不竭之府者，养桑麻，育六畜也。","book":"春秋·齐·管仲《管子·牧民》"},"example":{"text":"禀～，学不死之师，无往而不遂，无至而不通。","book":"西汉·刘安《淮南子·精神训》"},"usage":"作宾语；指人很富有"},{"id":2645,"word":"不管一二","pinyin":"bù guǎn yī èr","abbr":"bgye","explanation":"不论是非情由，不顾后果。","source":{"text":"你这猴子，不管一二，到处里闯禍。","book":"明·吴承恩《西游记》第二十六回"}},{"id":2646,"word":"不管三七二十一","pinyin":"bù guǎn sān qī èr shí yī","abbr":"bgsqesy","explanation":"不顾一切，不问是非情由。","source":{"text":"若三日没有银时，老身也不管三七二十一，公子不公子，一顿孤拐，打那光棍出去。","book":"明·冯梦龙《警世通言》卷三十二"},"example":{"text":"我因为自己好作短文，好用反语，每逢辩论，辄～，就迎头一击，所以每见和我的办法不同者便以为缺点。","book":"鲁迅《两地书》十二"},"similar":["不分皂白","不顾一切"],"usage":"作谓语、宾语、状语；形容不顾一切"},{"id":2647,"word":"不管不顾","pinyin":"bù guǎn bù gù","abbr":"bgbg","explanation":"指对人不照料。也指举动莽撞，不顾别人。","source":{"text":"她为什么将她那么痴情那么热烈那么不管不顾的爱给予这个孤傲而冷酷的翟子卿啊！……","book":"梁晓声《泯灭》三（2）"},"example":{"text":"尽管有外人在，他还是～的撞进来了。"}},{"id":2648,"word":"不系之舟","pinyin":"bù xì zhī zhōu","abbr":"bxzz","explanation":"没有用绳缆拴住的船。比喻漂泊不定的生涯。也比喻无拘无束的身躯。","source":{"text":"饱食而敖游，汎若不系之舟，虚而敖游者也。","book":"《庄子·列御寇》"}},{"id":2649,"word":"不紧不慢","pinyin":"bù jīn bù màn","abbr":"bjbm","explanation":"形容心情平静，行动从容。","source":{"text":"相形之下，走也不好，不走也不好；紧走也不好，慢走也不好，不紧不慢也不好；不知怎样才好！","book":"清·李汝珍《镜花缘》第十九回"},"example":{"text":"老人～地说……"},"similar":["不疾不徐"],"usage":"作定语、状语；用于处事"},{"id":2650,"word":"不约而同","pinyin":"bù yuē ér tóng","abbr":"byet","explanation":"约：相约。事先没有约定而相互一致。","source":{"text":"应对而皆动，不谋而俱起，不约而同会。","book":"《史记·平津侯主父列传》"},"example":{"text":"中军元帅栾书，～，亦至朝门，正遇胥童引兵到来。","book":"明·冯梦龙《东周列国志》第五十九回"},"similar":["不谋而合","殊途同归","异口同声"],"opposite":["众说纷纭","言人人殊","见仁见智"],"usage":"作状语；指行动、动作相同"},{"id":2651,"word":"不终之药","pinyin":"bù zhōng zhī yào","abbr":"bzzy","explanation":"旧指服后能使人不死的药。","source":{"text":"广崇祭祀之方，求报无服之祠，及言世有仙人，服食不终之药。","book":"《汉书·郊祀志下》"}},{"id":2652,"word":"不经一事，不长一智","pinyin":"bù jīng yī shì，bù zhǎng yī zhì","abbr":"bjysbzyz","explanation":"智：智慧，见识。不经历一件事情，就不能增长对那件事情的见识。","source":{"text":"智：智慧，见识。不经历一件事情，就不能增长对那件事情的见识。"},"example":{"text":"俗语说：“～。”我如今知道了，你又该来支问着我了！","book":"清·曹雪芹《红楼梦》第六十回"},"similar":["吃一堑，长一智"],"opposite":["痴学不悟","顽固不化"],"usage":"作宾语、定语、分句；用于从失败中吸取教训"},{"id":2653,"word":"不经世故","pinyin":"bù jīng shì gù","abbr":"bjsg","explanation":"经：经历；世故：人情世事的变故。形容缺乏为人处世的经验。","source":{"text":"然而他们不经世故，偶尔‘忘其所以’也就大碰其钉子。","book":"鲁迅《花边文学·序言》"},"opposite":["饱经世故"],"usage":"作谓语、定语；指没见过世面"},{"id":2654,"word":"不经之语","pinyin":"bù jīng zhī yǔ","abbr":"bjzy","explanation":"指荒诞无稽、没有根据的话。","source":{"text":"神宗顾问左右‘青唇’何事，皆不能对。乃以问赵元老。元老奏‘不经之语，不敢以闻’。","book":"宋·王辟之《渑水燕谈录·杂录》"},"example":{"text":"此必寺僧欲借古名人为引重，乃造此～以耸听。","book":"清·叶廷琯《吹网录·有应订正处》"},"similar":["不经之说","不经之谈"],"usage":"作主语、宾语；形容言论无根据"},{"id":2655,"word":"不经之说","pinyin":"bù jīng zhī shuō","abbr":"bjzs","explanation":"指荒诞无稽、没有根据的话。","source":{"text":"曷若削汉朝不经之说，征殷周可久之文，从亲尽则迁之常规，为万代不朽之定制。","book":"唐·无稹《迁庙议状》"},"example":{"text":"自秦始统一宇宙，悍然尊大……多援符瑞～，愚弄黔首。","book":"清·邹容《革命军》第一章"},"similar":["不经之谈","不经之语"],"usage":"作主语、宾语；形容言论无根据"},{"id":2656,"word":"不经之谈","pinyin":"bù jīng zhī tán","abbr":"bjzt","explanation":"不经：不合道理。荒诞无稽、没有根据的话。","source":{"text":"无传无经之谈，无听毁誉之语。","book":"《史记·孟子荀卿列传》：“其语闳大不经。”晋·羊祜《戒子书》"},"example":{"text":"这和尚疯疯癫癫说了些～，也没人理他。","book":"清·曹雪芹《红楼梦》第三回"},"similar":["奇谈怪论","无稽之谈"],"opposite":["不易之论","不刊之论"],"usage":"作主语、宾语；形容言论无根据"},{"id":2657,"word":"不绝于耳","pinyin":"bù jué yú ěr","abbr":"bjye","explanation":"绝：断。声音在耳边不断鸣响。","source":{"text":"这是台下叫好的声音不绝于耳。","book":"清·刘鹗《老残游记》第二回"},"example":{"text":"王朔《玩儿的就是心跳》：“开关车门声砰砰～。”"},"similar":["余音绕梁"],"usage":"作谓语；用于声音"},{"id":2658,"word":"不绝如发","pinyin":"bù jué rú fà","abbr":"bjrf","explanation":"形容局势危急，象差点兒就要断掉的发丝一样。","source":{"text":"先日诸吕阴谋大逆，刘氏不绝如发。","book":"《汉书·燕刺王刘旦传》"},"example":{"text":"匈奴乱十馀年，～，赖蒙汉力，故得复安。","book":"《匈奴传下》"},"similar":["不绝如线"],"usage":"作谓语、定语；指时局"},{"id":2659,"word":"不绝如带","pinyin":"bù jué rú dài","abbr":"bjrd","explanation":"形容局势危急，象差点兒就要断掉的带子一样。","source":{"text":"方吕后时，诸吕用事，擅相王。刘氏不绝如带。","book":"《史记·袁盎晁错列传》"},"example":{"text":"比来尘网荆榛，偏弦奏响，国学陵迟，～。","book":"卷盦《序》"},"similar":["不绝如线","不断如带"],"usage":"作谓语、定语；用于危急时"},{"id":2660,"word":"不绝如线","pinyin":"bù jué rú xiàn","abbr":"bjrx","explanation":"原作“不绝若线”。①形容局势危急，象差点兒就要断掉的线一样。②形容子孙衰落或后继者稀少。","source":{"text":"南夷与北狄交，中国不绝若线。","book":"《公羊传·僖公四年》"},"example":{"text":"降及孝成，复加恤问，稍益衰弱，～。","book":"《汉书·高惠高后文功臣表》："},"similar":["危如累卵","岌岌可危"],"opposite":["牢不可破","安如泰山"],"usage":"作谓语、定语；用于声音、书信、情绪等"},{"id":2661,"word":"不绝如缕","pinyin":"bù jué rú lǚ","abbr":"bjrl","explanation":"绝：断；缕：细线。多形容局面危急或声音、气息等低沉微弱、时断时续。","source":{"text":"夷狄也，因亟痛中国，南夷与此狄交，中国不绝若线。","book":"《公羊传·僖公四年》"},"example":{"text":"音乐会上，演员的歌声～。"},"similar":["危如累卵","岌岌可危"],"opposite":["牢不可破","安如泰山"],"usage":"作谓语、定语；用于声音、书信、情绪等"},{"id":2662,"word":"不绝若线","pinyin":"bù jué ruò xiàn","abbr":"bjrx","explanation":"形容局势危急，象差点兒就要断掉的线一样。","source":{"text":"线，缝帛缕，以喻微也。","book":"《公羊传·僖公四年》：“南夷与北狄交，中国不绝若线。”何休注"},"similar":["不绝如线"],"usage":"作谓语、定语；用于危急时"},{"id":2663,"word":"不置可否","pinyin":"bù zhì kě fǒu","abbr":"bzkf","explanation":"置：放，立；可：行；否：不行。不说行，也不说不行。指不表明态度。","source":{"text":"温钦差听了一笑，也不置可否。","book":"清·李宝嘉《官场现形记》第五十六回"},"example":{"text":"吴荪甫～地淡淡一笑，转身就坐在一张椅子里。","book":"茅盾《子夜》十"},"similar":["不置褒贬","不置一词","模棱两可"],"opposite":["泾渭分明","斩钉截铁","旗帜鲜明"],"usage":"作谓语、定语、状语；表示不敢发表意见"},{"id":2664,"word":"不置褒贬","pinyin":"bù zhì bāo biǎn","abbr":"bzbb","explanation":"置：安放，这里有“加以”之间。褒：褒奖，夸赞，表扬。贬：贬低，指责。不加以表扬或批评。","source":{"text":"操尝造花园一所；造成，操往观之，不置褒贬，只取笔于门上一‘活’字而去。","book":"明·罗贯中《三国演义》第七十二回"},"similar":["不置可否"],"usage":"作谓语；指不加以表扬或批评"},{"id":2665,"word":"不羁之士","pinyin":"bù jī zhī shì","abbr":"bjzs","explanation":"羁：拘束；士：读书人。不受拘束的读书人。","source":{"text":"使不羁之士，与牛骥同皁。","book":"汉·邹阳《于狱上书自明一首》"}},{"id":2666,"word":"不羁之才","pinyin":"bù jī zhī cái","abbr":"bjzc","explanation":"羁：马笼头，比喻约束。非凡的、不可拘束的才能。","source":{"text":"仆少负不羁之才，长无乡曲之誉。","book":"《汉书·司马迁传》"},"example":{"text":"余与稽康、吕安居止接近，其人并有～。","book":"晋·向秀《思旧赋序》"},"usage":"作宾语；指人的才能"},{"id":2667,"word":"不羁之民","pinyin":"bù jī zhī mín","abbr":"bjzm","explanation":"不受束缚的百姓。指不甘就范的人民群众。","source":{"text":"不牧之地，不羁之民。","book":"汉·桓宽《盐铁论·论功》"},"example":{"text":"吉普赛人酷爱自由，是所谓的～。"},"usage":"作宾语；指不甘就范的民众"},{"id":2668,"word":"不羞当面","pinyin":"bù xiū dāng miàn","abbr":"bxdm","explanation":"羞：羞耻。不把面对面的批评当作羞侮。表示原意倾听别人的批评。","source":{"text":"君子不羞当面，我有什么弊病处。","book":"元·无名氏《刘弘嫁婢》第一折"},"example":{"text":"明·伏雌教主《醋葫芦》：“院君，君子～。”"},"similar":["闻过则喜"],"usage":"作谓语、定语；用于处世"},{"id":2669,"word":"不習水土","pinyin":"bù xí shuǐ tǔ","abbr":"bxst","explanation":"不能适应某个地方的气侯、饮食等。","source":{"text":"上以魏所送马不称，使融问之，宋弁答曰：当是不習水土。","book":"《通俗编·地理引南史·王融传》"}},{"id":2670,"word":"不翼而飞","pinyin":"bù yì ér fēi","abbr":"byef","explanation":"翼：翅膀。没有翅膀却飞走了。比喻物品忽然丢失。也比喻事情传播得很迅速。","source":{"text":"众口所移，毋翼而飞。","book":"《管子·戒》：“无翼而飞者声也。”《战国策·秦策三》"},"example":{"text":"足足的一百六十块钱就那样便～了。","book":"郭沫若《革命春秋·创造十年》"},"similar":["不胫而走","不知去向"],"opposite":["原封不动","失而复得"],"usage":"作谓语、定语、状语；指东西不见了","story":["战国时期，秦昭王派大将军王稽率军攻打赵国都城邯郸，17个月没有攻下，士兵庄向王稽进言：“请嘉奖士兵，鼓舞士气，肯定会一举攻陷的。因为好消息会传播很快的。”王稽不听，结果攻城不下被秦王所杀"]},{"id":2671,"word":"不耕而食，不织而衣","pinyin":"bù gēng ér shí，bù zhī ér yī","abbr":"bgesbzey","explanation":"耕：翻松田土以备播种。不种田却有饭吃，不织布却能穿丝绸。形容不劳而获。","source":{"text":"又想起做和尚的不耕而食，不织而衣，住下高堂清舍，烧香吃茶。","book":"明·冯梦龙《醒世恒言》第39卷"},"similar":["不耕而食，不蚕而衣"],"usage":"作谓语、宾语、定语；指不劳而获"},{"id":2672,"word":"不耕而食，不蚕而衣","pinyin":"bù gēng ér shí，bù cán ér yī","abbr":"bgesbcey","explanation":"耕：翻松田土以备播种；蚕：养蚕。不种田却有饭吃，不养蚕却能穿丝绸。形容不劳而获。","source":{"text":"而无益于理，往来浮游，不耕而食，不蚕而衣。","book":"汉·桓宽《盐铁论·相刺》"},"similar":["不耕而食，不织而衣"],"usage":"作谓语、宾语、定语；指不劳而获"},{"id":2673,"word":"不耻下问","pinyin":"bù chǐ xià wèn","abbr":"bcxw","explanation":"乐于向学问或地位比自己低的人学习，而不觉得不好意思。","source":{"text":"敏而好学，不耻下问。","book":"《论语·公冶长》"},"example":{"text":"阁下既～，弟先须请教宗旨何如？","book":"清·刘鹗《老残游记》第七回"},"similar":["不矜不伐","谦虚谨慎","功成不居"],"opposite":["好为人师","骄傲自满","居功自傲"],"usage":"作主语、谓语、宾语；形容虚心求教","story":["古代大教育家孔子学识渊博，能虚心向别人学习。他去太庙祭祖，向别人问这问那，别人不解地问孔子，孔子说：“对于自己不懂的东西就要问清楚，这就是不耻下问，勤奋好学。”"]},{"id":2674,"word":"不耻最后","pinyin":"bù chǐ zuì hòu","abbr":"bczh","explanation":"因为跑到最后而感到可耻。比喻凡是只要坚持到底，就能达到目的。","source":{"text":"夫诱道争远，非先则后也。而先后心皆在于臣，上何以调于马，此君之所以后也。","book":"《韩非子·喻老》"},"example":{"text":"记得韩非子曾经教人以竞马的要妙，其一是‘～’。","book":"鲁迅《华盖集·补白》"},"opposite":["不甘落后"],"usage":"作谓语、定语；用于劝诫人","story":["古代赵襄主跟随王子期学习骑术，没过多久就想与师父较量骑术的高低，三次交换马匹比赛均失败。他说：“你没有把你的骑术完全教给我？”王子期说：“骑术是完全教完了，关键在于怎样用心去驾驭马，你想追我但担心落后我所以落后。"]},{"id":2675,"word":"不耻相师","pinyin":"bu chi xiang shi","abbr":"bcxs","explanation":"不以互相学习为耻。"},{"id":2676,"word":"不肖子孙","pinyin":"bù xiào zǐ sūn","abbr":"bxzs","explanation":"不肖：不象，不贤。指品德差，没出息，不能继承先辈事业的子孙或晚辈。","source":{"text":"丹朱之不肖，舜之子亦不肖。","book":"《庄子·天地》：“亲之所言而然，所行而善，则世俗谓之不肖子。”《孟子·万章上》"},"example":{"text":"造庙的时候，他的祖宗就捐过钱，现在他却要来吹熄长明灯，这不是～？","book":"鲁迅《彷徨·长明灯》"},"similar":["纨绔子弟","后继无人"],"opposite":["孝子贤孙","后继有人","继往开来"],"usage":"作宾语；指不好的子孙"},{"id":2677,"word":"不肯一世","pinyin":"bù kěn yī shì","abbr":"bkys","explanation":"一世：一时。认为当代的人都不行。形容目空一切、狂妄自大到了极点。同“不可一世”。","source":{"text":"范文正公书，落笔痛快沉着，极近晋宋人书。往时苏才翁笔法妙天下，不肯一世人，惟称文正公书与《乐毅论》同法。","book":"宋·黄庭坚《跋范文正公帖》"},"similar":["不可一世"],"usage":"作谓语、定语、状语；形容狂妄自大"},{"id":2678,"word":"不胜其任","pinyin":"bù shèng qí rèn","abbr":"bsqr","explanation":"胜：能担当。没有能力担当那项重任。","source":{"text":"王怒，以为不胜其任矣。","book":"战国·邹·孟轲《孟子·梁惠王下》"},"example":{"text":"他～，请求辞职。"},"similar":["力不胜任"],"opposite":["胜任愉快"],"usage":"作谓语；常作自谦词"},{"id":2679,"word":"不胜其烦","pinyin":"bù shèng qí fán","abbr":"bsqf","explanation":"胜：禁得起；烦：烦琐。烦琐得使人受不了。","source":{"text":"于是不胜其烦，人情厌恶。","book":"宋·陆游《老学庵笔记》卷三"},"example":{"text":"许多反动宣传影片，列举名目就～。","book":"鲁迅《二心集·现代电影与有产阶级》"},"similar":["博士买驴","鸡零狗碎"],"opposite":["不厌其详","不厌其烦","简明扼要"],"usage":"作谓语、状语；指事物烦杂叫人受不了"},{"id":2680,"word":"不胜其苦","pinyin":"bù shèng qí kǔ","abbr":"bsqk","explanation":"不能忍受那种苦楚。","source":{"text":"乃徒行出至曲江西杏园东，去其衣服，以马鞭鞭之数百，生不胜其苦而毙。","book":"唐·白行简《李娃传》"},"similar":["不堪其苦"],"usage":"作谓语；指十分痛苦"},{"id":2681,"word":"不胜杯杓","pinyin":"bù shèng bēi sháo","abbr":"bsbs","explanation":"不胜：经不起。杓：舀东西的器具。杯杓：泛指酒器。比喻喝酒太多，已经醉了。","source":{"text":"张良入谢曰：‘沛公不胜杯杓，不能辞。’","book":"《史记·项羽本纪》"},"similar":["不胜酒力"],"usage":"作谓语、宾语；指喝醉了"},{"id":2682,"word":"不胜杯酌","pinyin":"bù shèng bēi zhuó","abbr":"bsbz","explanation":"不胜：经不起。比喻喝酒太多，为酒所困。","source":{"text":"东坡倅杭，不胜杯酌。","book":"宋·朱或《萍洲可谈》第三卷"},"similar":["不胜杯杓"],"usage":"作谓语、宾语；指喝醉了"},{"id":2683,"word":"不胜枚举","pinyin":"bù shèng méi jǔ","abbr":"bsmj","explanation":"胜：尽；枚：个。不能一个个地列举出来。形容数量很多。","source":{"text":"似此等语，不可枚举。","book":"宋·王楙《野客丛书·俗语有所自》"},"example":{"text":"真是钉子之多，～。","book":"鲁迅《书信集·致章廷谦》"},"similar":["不计其数","不可胜数","举不胜举"],"opposite":["屈指可数","寥寥无几","寥若晨星"],"usage":"作谓语、状语；用于列举的场合"},{"id":2684,"word":"不胜桮杓","pinyin":"bù shèng bēi sháo","abbr":"bsbs","explanation":"桮杓bēisháo：桮，古同“杯”，酒具，借指饮酒。指酒量有限，不能再饮。","source":{"text":"张良入谢曰：‘沛公不胜桮杓，不能辞。’","book":"《史记·项羽本纪》"},"example":{"text":"我已经～，请不要再劝了。"},"similar":["不胜酒力"],"usage":"作谓语、定语；指喝醉酒"},{"id":2685,"word":"不胜梘杓","pinyin":"bù shèng bēi sháo","abbr":"bsbs","explanation":"?黾bēisháo梘，古同杯”，酒具，借指饮酒。指酒量有限，不能再饮。","source":{"text":"张良入谢曰‘沛公不胜梘杓，不能辞。’","book":"《史记·项羽本纪》"}},{"id":2686,"word":"不胫而走","pinyin":"bù jìng ér zǒu","abbr":"bjez","explanation":"胫：小腿；走：跑。没有腿却能跑。比喻事物无需推行，就已迅速地传播开去。","source":{"text":"珠玉无胫而自至者，以人好之也，况贤者之有足乎？","book":"汉·孔融《论盛孝章书》"},"example":{"text":"袁伯珍慌忙把家里所有的东西，检点一番；别的一样不缺，只有金银首饰和钞票洋钱，却一概～。","book":"清·无名氏《官场维新记》第四回"},"similar":["不翼而飞","无胫而走"],"opposite":["秘而不宣"],"usage":"作谓语、状语；比喻不经宣传就迅速流传开来","story":["东汉末年，孙策统治江东，江东才子盛孝章为人耿直孤傲，他的好友孔融担心孙策对他不利，想把他推荐给曹操，孔融给曹操写一封信：“珠玉无胫而自至者，以人好之也，况贤者之有足乎？”"]},{"id":2687,"word":"不能登大雅之堂","pinyin":"bù néng dēng dà yǎ zhī táng","abbr":"bnddyzt","explanation":"形容不够文雅。","example":{"text":"这种小魔术虽然有趣，但还是～。"}},{"id":2688,"word":"不能自已","pinyin":"bù néng zì yǐ","abbr":"bnzy","explanation":"已：停止。指无法控制自己，使激动的情绪平静下来。","source":{"text":"慨然而咏‘富贵他人合，贫贱亲戚离’，因泣下交颐，不能自已。","book":"《宋书·刘休仁传》：“痛念之至，不能自已。”唐·卢照邻《寄裴舍人书》"},"example":{"text":"那知老境却如此颓唐！他触目伤怀，自然情～。","book":"朱自清《背影》"},"similar":["情不自禁","不由自主"],"usage":"作谓语、状语；指不能自己控制自己"},{"id":2689,"word":"不能自拔","pinyin":"bù néng zì bá","abbr":"bnzb","explanation":"拔：摆脱。不能主动地从痛苦、错误或罪恶中解脱出来。","source":{"text":"世祖前锋至新亭，劭挟义恭出战，恒录在左右，故不能自拔。","book":"《宋书·刘义恭传》"},"example":{"text":"其既入世也，又复受此感染焉。虽有贤智，亦～。","book":"清·梁启超《小说与群治之关系》"},"similar":["自暴自弃","一落千丈"],"opposite":["不甘示弱","勇往直前","昂首阔步"],"usage":"作谓语、定语；形容人不能解脱","story":["南北朝时期，徐州刺史薛安和青州刺史沈文秀背叛了宋明帝，在东阳城起兵造反。刘氏全族人陷于城内不能自拔，他们想方设法逃出东阳城，找到当时的北海太守刘怀恭等联合出兵，一举攻下东阳城平息了叛乱，迫使沈文秀投降"]},{"id":2690,"word":"不能赞一词","pinyin":"bù néng zàn yī cí","abbr":"bnzyc","explanation":"指文章写得好，别人不能再添一句话。形容文章非常完美。","source":{"text":"至于为《春秋》，笔则笔，削则削，子夏之徒不能赞一词。","book":"西汉·司马迁《史记·孔子世家》"},"example":{"text":"然文字之学，早已一切还给章先生，略无私蓄，所以甚服此书之浩瀚而竟～。","book":"鲁迅《书信集·致台静文》"},"similar":["不能赞一辞"],"usage":"作谓语；形容文章非常完美"},{"id":2691,"word":"不能赞一辞","pinyin":"bù néng zàn yī cí","abbr":"bnzyc","explanation":"赞：赞助；赞一辞：添一句话。提不出一点意见。形容文章非常完美。","source":{"text":"至于为《春秋》，笔则笔，削则削，子夏之徒不能赞一辞。","book":"《史记·孔子世家》"},"example":{"text":"然文字之学，早已一切还给章先生，略无私蓄，所以甚服此书之浩瀚，而～。","book":"《鲁迅书信集·致台静农》"}},{"id":2692,"word":"不脩边幅","pinyin":"bù xiū biān fú","abbr":"bxbf","explanation":"形容不讲究衣饰仪容或不拘形式小节。亦作“不修边幅”。","source":{"text":"不脩边幅，谓人不饰仪容。","book":"南北朝·颜之推《颜氏家训·序致》：“肆欲轻言，不脩边幅。”《幼学琼林·卷三·人事类》"}},{"id":2693,"word":"不腆之仪","pinyin":"bù tiǎn zhī yí","abbr":"btzy","explanation":"腆：丰厚；仪：礼物。不丰厚的礼物。旧时送礼的谦辞。","source":{"text":"寡君闻吾子将步师出于敝邑，敢犒从者。不腆敝邑，为从者之淹，居则具一日之积，行则备一夕之卫。","book":"《左传·僖公三十三年》"},"example":{"text":"～，预以犒从者。","book":"明·冯梦龙《东周列国志》第六十九回"},"similar":["千里鹅毛"],"usage":"作宾语；送礼的谦辞"},{"id":2694,"word":"不腆之酒","pinyin":"bù tiǎn zhī jiǔ","abbr":"btzj","explanation":"不腆：不丰厚。自谦之词，意思是不丰盛的酒席。","source":{"text":"寡君有不腆之酒。","book":"《仪礼·燕礼》"}},{"id":2695,"word":"不臣之心","pinyin":"bù chén zhī xīn","abbr":"bczx","explanation":"不臣：不守臣子的本分，封建社会中不忠君。意指不忠君的思想。后也指犯上作乱的野心。","source":{"text":"闻敦有不臣之心，访恆切齿。敦虽怀逆谋，故终访之世未敢为非。","book":"《三国志·魏书·二公孙陶四张传》：“是时术阴有不臣之心，不利国家有长主，外托公义以答拒之。”《晋书·周处传》"},"example":{"text":"后又结托朝贵，遂任显官，统西州大军二十万，常有～。","book":"明·罗贯中《三国演义》第三回"},"opposite":["赤胆忠心"],"usage":"作宾语；指人的野心"},{"id":2696,"word":"不自满假","pinyin":"bù zì mǎn jiǎ","abbr":"bzmj","explanation":"不自满，不自大。","source":{"text":"克勤于邦，克俭于家，不自满假，惟汝贤。","book":"《书·大禹谟》"},"example":{"text":"且圣人之心，只是～。","book":"明·吕坤《答赵乾所嵇勋》"},"opposite":["骄傲自满"],"usage":"作谓语、定语；用于为人"},{"id":2697,"word":"不自由，毋宁死","pinyin":"bù zì yóu，wù nìng sǐ","abbr":"bzywns","explanation":"如果失去自由、主权，宁可去死。","source":{"text":"法国大革命时《马赛曲》的最后一句。"},"example":{"text":"哥哥岂不闻欧美人嘴唇皮挂着的话说道：“～”，……","book":"清·梁启超《新中国未来记》第三回"},"opposite":["苟且偷生"],"usage":"作谓语、分句；指人追求自由"},{"id":2698,"word":"不自量力","pinyin":"bù zì liàng lì","abbr":"bzll","explanation":"量：估量。自己不估量自己的能力。指过高地估计自己的实力。","source":{"text":"荆甚固，而薛亦不量其力。","book":"《左传·隐公十一年》：“不度德，不量力。”《战国策·齐策三》"},"example":{"text":"就说我们殿试都是侥幸名列上等，并非～，何敢自不量力，妄自谈文。","book":"清·李汝珍《镜花缘》第八十七回"},"similar":["螳臂挡车","蚍蜉憾树"],"opposite":["妄自菲薄","自知之明","量力而行"],"usage":"作谓语、定语、状语；形容对自己估计过高","story":["春秋时期，实力弱小的息国从郑国发动战争，结果被打败。分析人士认为自不量力的息国即将被消灭，原因是他不考虑自己的德行，不正确分析敌我双方的力量，分不清敌人与朋友，不团结邻国，结果没过多久息国被楚国消灭"]},{"id":2699,"word":"不舍昼夜","pinyin":"bù shě zhòu yè","abbr":"bszy","explanation":"舍：放弃。不放弃白天和黑夜。比喻夜以继日。","source":{"text":"子在川上曰：‘逝者如斯夫，不舍昼夜。","book":"《论语·子罕》"},"example":{"text":"道若途若川，车航混混，～。","book":"汉·扬雄《法言·问道》"},"similar":["夜以继日","没日没夜"],"usage":"作谓语、状语；指夜以继日","story":["春秋时期，孔子在晚年常与他的弟子一起周游列国。有一次他们在河边望着奔腾不息的河水若有所思，孔子叹息光阴像河水一样不舍昼夜地不停地流逝。学生们纷纷表示要珍惜光阴，刻苦求学，宣扬儒家文化。孔子感到十分欢欣"]},{"id":2700,"word":"不舞之鹤","pinyin":"bù wǔ zhī hè","abbr":"bwzh","explanation":"舞：舞蹈。不舞蹈的鹤。比喻名不副实的人。也用来讥讽人无能。","source":{"text":"昔羊叔子有窑主善舞，尝向客称之。客试使驱来，氃氋而不肯舞。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"方宰淄时，松裁弱冠，过蒙器许，而驽钝不才，竟以～为羊公辱。","book":"清蒲松龄《聊斋志异·折狱》"},"similar":["无能之辈"],"opposite":["栋梁之材"],"usage":"作主语、宾语；用来讥讽人无能","story":["西晋时期，尚书左仆射羊祜家里养了一只白色的丹顶鹤，他十分喜欢这只鹤。鹤在吃饱喝足后尽情狂舞，他向客人夸奖鹤是如何有灵性，客人前去观看，鹤因为有生人在场，怎么也不起舞，让客人大失所望，说这是一只不舞之鹤"]},{"id":2701,"word":"不苟言笑","pinyin":"bù gǒu yán xiào","abbr":"bgyx","explanation":"苟：苟且，随便。不随便说笑。形容态度庄重严肃。","source":{"text":"不登高，不临深，不苟訾，不苟笑。","book":"《礼记·曲礼上》"},"example":{"text":"且说这位郑伯才君，单名一个雄字，乃是湖南湘潭县人，向来是个讲宋学的，方领矩步，～。","book":"清·梁启超《新中国未来记》"},"similar":["正襟危坐","老成持重"],"opposite":["油腔滑调","谈笑风生"],"usage":"作谓语、定语；形容表情庄重、严肃"},{"id":2702,"word":"不茶不饭","pinyin":"bù chá bù fàn","abbr":"bcbf","explanation":"不思饮食。形容心事重重。","source":{"text":"害的我不茶不饭，只是思想着你。","book":"元·关汉卿《救风尘》第三折"},"example":{"text":"霎时间云雨暗巫山，闷无言，～，满口儿何处诉愁烦。","book":"明·胡文焕《群音类选·玉簪记·秋江送别》"},"similar":["不吃不喝","茶饭不思"],"opposite":["大吃大喝"],"usage":"作谓语、定语；指人的心情"},{"id":2703,"word":"不荤不素","pinyin":"bù hūn bù sù","abbr":"bhbs","explanation":"指不上不下。","source":{"text":"你放在家里不荤不素，当做甚么人儿看成。","book":"明·兰陵笑笑生《金瓶梅词话》第二十六回"},"usage":"作谓语、定语；指不上不下"},{"id":2704,"word":"不药而愈","pinyin":"bù yào ér yù","abbr":"byey","explanation":"生病不用吃药而自行痊愈。","source":{"text":"老伯不必多虑，世妹之病，大约可以不药而愈。","book":"清·夏敬渠《野叟曝言》第37回"},"example":{"text":"刚才着了凉的不爽快，也就～了。","book":"叶圣陶《马铃瓜》"},"similar":["不治自愈"],"opposite":["不可救药","回天乏术"],"usage":"作谓语；指自愈"},{"id":2705,"word":"不落人后","pinyin":"bù luò rén hòu","abbr":"blrh","explanation":"不落在别人的后面。形容人要强心盛，事事占先。"},{"id":2706,"word":"不落俗套","pinyin":"bù luò sú tào","abbr":"blst","explanation":"不因袭陈旧的格式。","source":{"text":"这个作品的结构也比较新颖，不落俗套。","book":"贺宜《序言》"},"example":{"text":"我学习写评论性质的文章，给自己立了两个标准。一个是独立思考，另一个是～。","book":"臧克家《京华练笔三十年》"},"similar":["标新立异","不落窠臼"],"opposite":["因循守旧"],"usage":"作谓语、定语；指说话或文章"},{"id":2707,"word":"不落窠臼","pinyin":"bù luò kē jiù","abbr":"blkj","explanation":"窠：鸟巢；臼：舂米的石器。比喻有独创风格，不落旧套。","source":{"text":"初学必从此入门，庶不落小家窠臼。","book":"宋·吴可《学诗》诗：“跳出少陵窠臼外，丈夫志气本冲天。”明·胡应麟《诗薮·内编》四"},"example":{"text":"这“凸”“凹”历来用的人最少，如今直用作轩馆之名，更觉新鲜，～。","book":"清·曹雪芹《红楼梦》第七十六回"},"similar":["别具一格","别开生面","别具匠心"],"opposite":["依样葫芦","千篇一律","如法炮制"],"usage":"作主语、谓语、定语；用于文章和艺术","story":["中秋夜，贾府在大观园中设团圆宴，众人散去后，林黛玉独自凭栏伤心流泪，史湘云来安慰她。两人转换话题，改对月吟诗联句，她们就大观园的建筑名称由来而发感慨，其中“凸碧山庄”与“凹晶溪馆”的取名不落窠臼"]},{"id":2708,"word":"不落言筌","pinyin":"bù luò yuán quán","abbr":"blyq","explanation":"言筌：在言辞上所留下的迹象。不局限于言辞的表面意思，而有言外之意。","source":{"text":"不涉理路，不落言筌者，上也。","book":"宋·严羽《沧浪诗话·诗辨》"}},{"id":2709,"word":"不落边际","pinyin":"bù luò biān jì","abbr":"blbj","explanation":"指挨不上边，无着落。","source":{"text":"星星给搅得不安似地霎着眼，闪着白里带青的亮光，逗得人会不落边际地想开去，想到天上，想到这人世。","book":"张天翼《夏夜梦》二"},"similar":["不着边际"],"usage":"作谓语、定语、状语；形容言论空泛"},{"id":2710,"word":"不蔓不支","pinyin":"bù màn bù zhī","abbr":"bmbz","explanation":"蔓：藤蔓，引伸为蔓延。既不蔓延，也不分支。比喻说话或写文章简明扼要，不拖泥带水。","source":{"text":"现在台上演的把熊友惠和侯三姑的一般情节删去，只留熊友兰与苏戍娟的一条线，干干净净八场戏，不蔓不支，我以为异常好。","book":"欧阳予倩《谈昆剧和的演出》"},"similar":["不蔓不枝"],"usage":"作谓语、定语；比喻说话作文简洁流畅"},{"id":2711,"word":"不蔓不枝","pinyin":"bù màn bù zhī","abbr":"bmbz","explanation":"蔓：藤蔓，引伸为蔓延。既不蔓延，也不分支。比喻说话或写文章简明扼要，不拖泥带水。","source":{"text":"中通外直，不蔓不枝。","book":"宋·周敦颐《爱莲说》"},"example":{"text":"做下去，年深日久之后，先生就不再删改你的文章了，只在篇末批些“有书有笔，～”之类。","book":"鲁迅《做古文和做好人的秘诀》"},"similar":["珠圆玉润","一气呵成","文从字顺"],"opposite":["拖泥带水","节外生枝","画蛇添足"],"usage":"作谓语、定语；比喻说话作文简洁流畅","story":["宋朝时期，地方官周敦颐辞去官职，隐居在庐山莲花峰在濂溪书堂讲学，他的著名短文《爱莲说》流传到今天：“晋陶渊明独爱菊，自季唐来，世人甚爱牡丹。予独爱莲之出淤泥而不染，濯清涟而不妖，中通外直，不蔓不枝，香远益清。”"]},{"id":2712,"word":"不蔽风雨","pinyin":"bù bì fēng yǔ","abbr":"bbfy","explanation":"蔽：遮盖。不能遮风挡雨。形容房屋破烂简陋。","source":{"text":"我有蔽庐，不蔽风雨。","book":"清·陈瑚《顽潭诗话·无闷谣》"},"opposite":["遮风挡雨"],"usage":"作谓语、定语；指房屋等破烂"},{"id":2713,"word":"不藏不掖","pinyin":"bù cáng bù yē","abbr":"bcby","explanation":"指毫无保留。","example":{"text":"我～，怕什么呢？"},"opposite":["遮遮掩掩"],"usage":"作谓语、宾语；指毫无保留"},{"id":2714,"word":"不虚此行","pinyin":"bù xū cǐ xíng","abbr":"bxcx","explanation":"虚：空、白。没有空跑这一趟。表示某种行动还是有所收获的。","source":{"text":"原来你这回到上海，干了这么一回事，也不虚此一行。","book":"清·吴趼人《二十年目睹之怪现状》第40回"},"example":{"text":"我们这趟来北京真是～。"},"similar":["满载而归"],"opposite":["白跑一趟"],"usage":"作谓语、宾语；用于口语"},{"id":2715,"word":"不虞之誉","pinyin":"bù yú zhī yù","abbr":"byzy","explanation":"虞：料想；誉：称赞。没有意料到的赞扬。","source":{"text":"有不虞之誉，有求全之毁。","book":"《孟子·离娄上》"},"example":{"text":"但是，“～”，也和“不虞之毁”一样地无聊。","book":"鲁迅《三闲集·我和（语丝）的始终》"},"usage":"作宾语；表示没想到的赞誉"},{"id":2716,"word":"不虞之隙","pinyin":"bù yú zhī xì","abbr":"byzx","explanation":"指意外的误会。","source":{"text":"［宝玉］与黛玉同随贾母一处坐卧，故略比别个姊妹熟惯些。既熟惯，则更觉亲密，既亲密，则不免一时有求全之毁，不虞之隙，这日不知为何，二人言语有些不和起来。","book":"清·曹雪芹《红楼梦》第五回"},"usage":"作主语、宾语；用于友人间等"},{"id":2717,"word":"不衫不履","pinyin":"bù shān bù lǚ","abbr":"bsbl","explanation":"衫：上衣；履：鞋子。不穿长衫，不穿鞋子。形容不修边幅的样子。","source":{"text":"既而太宗至，不衫不履，裼裘而来，神气扬扬，貌与常异。","book":"唐·杜光庭《虬髯客传》"},"example":{"text":"这个人是个～的人，与家父最为相契。","book":"清·刘鹗《老残游记》第九回"},"similar":["不修边幅","不拘小节","不拘细形"],"opposite":["规行矩步","衣冠楚楚"],"usage":"作主语、谓语、宾语、定语；用于书面"},{"id":2718,"word":"不见圭角","pinyin":"bù jiàn guī jiǎo","abbr":"bjgj","explanation":"指不露锋芒或才干不外露。","source":{"text":"遇人浑浑，不见圭角。","book":"宋·欧阳修《张子野墓志铭》"},"similar":["不露圭角"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；形容人深沉、不露锋芒"},{"id":2719,"word":"不见天日","pinyin":"bù jiàn tiān rì","abbr":"bjtr","explanation":"比喻社会黑暗，见不到一点光明。","source":{"text":"福州之人，以为终世不见天日也，岂料端公赐问，然某尤为绛所苦者也。","book":"宋·魏泰《东轩笔录》卷八"},"example":{"text":"俺平生只是性情不好，不肯做那～的勾当，才走到这山穷水尽的地步。","book":"清·遁庐《童子军·越墙》"},"similar":["暗无天日"],"opposite":["大放光明"],"usage":"作谓语、定语；形容社会黑暗"},{"id":2720,"word":"不见棺材不下泪","pinyin":"bù jiàn guān cái bù xià lèi","abbr":"bjgcbxl","explanation":"比喻不到走投无路的境地不肯死心。","source":{"text":"安鸿渐有滑稽清才……妻严戒曰：‘来日早临棺，须见泪。’","book":"宋·邢居实《拊掌录》"},"example":{"text":"常言说得好，恨小非君子，无毒不丈夫。咱如今将理和他说，～，他必然不妥。","book":"明·兰陵笑笑生《金瓶梅词话》第98回"},"similar":["不见棺材不落泪"],"usage":"作谓语、定语、分句；形容不到绝境不死心","story":["古代滑稽清才安鸿渐特别幽默与滑稽，他十分害怕老婆，他岳父病故，两人前去吊唁，在路上他们就开始大哭。他老婆为人特别严格，见老公光哭而没有眼泪，觉得奇怪问为什么？安鸿渐回答说用帕子擦了，其妻特别嘱咐见了棺材一定要掉泪"]},{"id":2721,"word":"不见棺材不掉泪","pinyin":"bù jiàn guān cái bù diào lèi","abbr":"bjgcbdl","explanation":"比喻不到走投无路的境地不肯死心。","source":{"text":"我这份人，向来是不见棺材不掉泪，相信眼睛，不大相信耳朵。","book":"刘澍德《甸海春秋》"},"example":{"text":"他是个～的主。"},"similar":["不见棺材不下泪"],"usage":"作谓语、定语、分句；形容不到绝境不死心"},{"id":2722,"word":"不见棺材不落泪","pinyin":"bù jiàn guān cái bù luò lèi","abbr":"bjgcbll","explanation":"比喻不到彻底失败的时候不肯罢休。","source":{"text":"常言说得好，恨小非君子，无毒不丈夫。咱如今将理和他说，不见棺材不下泪，他必然不妥。","book":"明·兰陵笑笑生《金瓶梅词话》第98回"},"example":{"text":"你不要～，社会是残酷的。"},"similar":["不见棺材不下泪"],"usage":"作谓语、分句；形容不到绝境不死心","story":["古代滑稽清才安鸿渐特别幽默与滑稽，他十分害怕老婆，他岳父病故，两人前去吊唁，在路上他们就开始大哭。他老婆为人特别严格，见老公光哭而没有眼泪，觉得奇怪问为什么？安鸿渐回答说用帕子擦了，其妻特别嘱咐见了棺材一定要掉泪"]},{"id":2723,"word":"不见经传","pinyin":"bù jiàn jīng zhuàn","abbr":"bjjz","explanation":"经传：指被古人尊崇为典范的著作。经传上没有记载。后常指人没有名声或论述没有根据。","source":{"text":"三字虽不见经传，却亦甚雅。","book":"宋·罗大经《鹤林玉露》卷六"},"example":{"text":"我们住的小胡同，连轿车也进不来，一向～。","book":"老舍《吐了一口气》"},"similar":["无声无息","默默无闻","无名鼠辈"],"opposite":["赫赫有功","大名鼎鼎","尽人皆知"],"usage":"作谓语；形容人或事物没有名气"},{"id":2724,"word":"不见舆薪","pinyin":"bù jiàn yú xīn","abbr":"bjyx","explanation":"看不见一车柴禾。比喻不下功夫去做。","source":{"text":"明足以察秋毫之末，而不见舆薪。","book":"战国·邹·孟轲《孟子·梁惠王上》"},"usage":"作谓语；指不努力"},{"id":2725,"word":"不觉技痒","pinyin":"bù jué jì yǎng","abbr":"bjjy","explanation":"技：技艺。指具有某种技能的人，一遇机会，便情不自禁地想表现一下。","source":{"text":"渐离变名易姓，为人庸保，匿作于宋子，久之，作苦，闻其家堂上客击筑，伎痒，不能毋出言，曰：‘彼有善不善。’","book":"汉·应劭《风俗通·声音·筑》"},"example":{"text":"今听此言，～，如何不喜。","book":"清·李汝珍《镜花缘》第五十三回"},"similar":["见猎心喜"],"usage":"作谓语；用于人急于表现自己的特长","story":["战国时期，燕国击筑高手高渐离与荆轲是好朋友。他亲自到易水边为荆轲送行。荆轲刺秦失败，秦王下令追捕太子丹和高渐离。高渐离逃到偏远的地方当佣人，主人家请客，席间有人击筑，高渐离不觉技痒就拿起自己的筑击了起来"]},{"id":2726,"word":"不解之仇","pinyin":"bù jiě zhī chóu","abbr":"bjzc","explanation":"解除不了的仇恨。","source":{"text":"又见张权买房开店，料道是丈人暗地与他的银子，越加忿怒，成了个不解之仇。","book":"明·冯梦龙《醒世恒言》第20卷"},"example":{"text":"霍赵两家本无～，只因彼此不服输的心理，而一定要争个高低，互不相让。"},"similar":["深仇大恨"],"usage":"作主语、宾语；用于口语"},{"id":2727,"word":"不解之缘","pinyin":"bù jiě zhī yuán","abbr":"bjzy","explanation":"缘：缘分。不可分解的缘分。比喻不能解脱的联系或关系。","source":{"text":"文采双鸳鸯，裁为合欢被；著以长相思，缘以结不解。","book":"南朝·梁·萧统《古诗十九首》"},"example":{"text":"好像她们这两个从小在城市里长大的姊妹，和农村孩子结了～似的。","book":"何为《两姊妹》"},"similar":["难解难分","唇齿相依","藕断丝连"],"opposite":["一刀两断"],"usage":"作宾语；形容关系密切"},{"id":2728,"word":"不解之谜","pinyin":"bù jiě zhī mí","abbr":"bjzm","explanation":"没有解开的问题。"},{"id":2729,"word":"不解衣带","pinyin":"bù jiě yī dài","abbr":"bjyd","explanation":"解：脱去，解下。不脱衣服就休息，形容非常忙碌和辛劳。","source":{"text":"阳朔中，世父大将军凤病，莽侍疾，亲尝药，乱首垢面，不解衣带连月。","book":"东汉·班固《汉书·王莽传》"},"example":{"text":"遭父疾，晨夕侍床褥，～。","book":"《清史稿·儒林传·江声》"},"similar":["衣不解带"],"usage":"作谓语；多指服侍病人"},{"id":2730,"word":"不言不语","pinyin":"bù yán bù yǔ","abbr":"byby","explanation":"不说话，闷声不响。","source":{"text":"秀娥一心忆着吴衙内，坐在旁边，不言不语，如醉如痴，酒也不沾一滴，箸也不动一动。","book":"明·冯梦龙《醒世恒言·吴衙内邻舟赴约》"},"example":{"text":"王中见母子说话没缝，只得起来。～，走到前厅，看见主人灵柩。","book":"清·李绿园《歧路灯》第32回"},"similar":["一言不发"],"opposite":["多嘴多舌"],"usage":"作谓语；指闷声不响"},{"id":2731,"word":"不言之化","pinyin":"bù yán zhī huà","abbr":"byzh","explanation":"化：教化。不通过语言进行教育而收到的感化作用。","source":{"text":"夫知者不言，言者不知，故圣人行不言之教。","book":"《庄子·知北游》"},"example":{"text":"人人无所用其心，任众人之议，而天下自化矣。～行，巍巍之美，于此著矣。","book":"《晋书·刘寔传》"}},{"id":2732,"word":"不言之听","pinyin":"bù yán zhī tīng","abbr":"byzt","explanation":"能听懂言外的意思。","source":{"text":"故胜书能以不言说，而周公旦能以不言听，此之谓不言之听，不言之谋，不闻之事。","book":"《吕氏春秋·精谕》"}},{"id":2733,"word":"不言之言","pinyin":"bù yán zhī yán","abbr":"byzy","explanation":"意在言外的话。","source":{"text":"丘也闻不言之言矣，未之尝言，于此乎言之。","book":"《庄子·徐无鬼》"}},{"id":2734,"word":"不言而信","pinyin":"bù yán ér xìn","abbr":"byex","explanation":"旧指君子不用说什么就能得到别人的信任。形容有崇高的威望。","source":{"text":"夫子不言而信，不比而周。","book":"《庄子·田子方》"},"example":{"text":"尧舜之世，正百官而诸侯服，去四凶而天下安，～，不怒而威。","book":"明·冯梦龙《东周列国志》第十八回"},"usage":"作谓语；指人的威望等"},{"id":2735,"word":"不言而喻","pinyin":"bù yán ér yù","abbr":"byey","explanation":"喻：了解，明白。不用说话就能明白。形容道理很明显。","source":{"text":"仁义礼智根于心，其生色也，然见于面。盎于背，施于四体，四体不言而喻。","book":"《孟子·尽心上》"},"example":{"text":"你想他们这朋友之乐，尽可～了。","book":"清·刘鹗《老残游记续集》第一回"},"similar":["显而易见","无庸赘述"],"opposite":["扑朔迷离","模棱两可"],"usage":"作谓语、宾语、定语；形容很明显","story":["战国时期，孟子认为仁义礼智是君子天生的秉性，君子在得志时不妄为，在困穷失意时不自卑，他敬天知命，将仁义礼智铭记在心，并将它发扬光大，不但能将它们表现在脸上，照到背上，然后传到四肢，四肢就不言而喻可以找到其法门了"]},{"id":2736,"word":"不言而谕","pinyin":"bù yán ér yù","abbr":"byey","explanation":"谕：旧时指上对下的文告、指示。不用说话就能明白。形容道理很明显。","source":{"text":"呜呼嗟夫，吾苟有之，不言而谕，是亦何劳。","book":"宋·苏轼《却鼠刀铭》"},"example":{"text":"“～”与“不言而喻”意义相同。"},"similar":["不言而喻"],"usage":"作谓语、定语；指事理非常明显"},{"id":2737,"word":"不计其数","pinyin":"bù jì qí shù","abbr":"bjqs","explanation":"没法计算数目。形容很多。","source":{"text":"或谓官民兵在城内者约二十万，而散在四郊者，不计其数。","book":"宋·魏了翁《奏措京湖诸郡》"},"example":{"text":"去州桥河内周围上下点灯，～。","book":"明·施耐庵《水浒全传》第六十六回"},"similar":["不胜枚举","不可胜数","不一而足"],"opposite":["屈指可数","寥寥无几","凤毛麟角"],"usage":"作谓语、定语、补语；形容人或事物很多"},{"id":2738,"word":"不让之责","pinyin":"bù ràng zhī zé","abbr":"brzz","explanation":"让：推让；责：责任。不可推让的责任。","source":{"text":"睹兹盛美，焉敢避不让之责而默默邪？","book":"唐·韩愈《贺徐州张仆射白兔书》"}},{"id":2739,"word":"不记前仇","pinyin":"bù jì qián chóu","abbr":"bjqc","explanation":"指不计较以前的仇恨，任人唯贤。","source":{"text":"今不记前仇，不避祸患，又来苦口相劝。","book":"清·李汝珍《镜花缘》第25回"},"example":{"text":"他不记前仇，推荐他的劲敌当厂长。"},"similar":["不记前嫌"],"opposite":["睚眦必报"],"usage":"作谓语；指人大度","story":["东周时期齐襄公暴虐被杀，其弟小白同其恩师鲍叔牙从莒国赶回齐国即位，遭到另一兄弟公子纠的恩师管仲的阻拦，管仲射小白一箭。齐桓公小白回国即位后，鲍叔牙极力说服齐桓公不记前仇，拜管仲为丞相"]},{"id":2740,"word":"不讳之变","pinyin":"bù huì zhī biàn","abbr":"bhzb","explanation":"不讳：死的婉词，指人死不可避免；变：变故。指人的死亡。","source":{"text":"不讳之变，诚难其虑。","book":"《后汉书·申屠刚传》"},"similar":["驾鹤西游"],"usage":"作主语、宾语；指死亡"},{"id":2741,"word":"不讳之朝","pinyin":"bù huì zhī cháo","abbr":"bhzc","explanation":"可直言不讳的朝代。指政治清明之世。","source":{"text":"今吾子幸得遭明盛之世，处不讳之朝，与群贤历金门上玉堂有日矣！","book":"汉·扬雄《解嘲》"},"example":{"text":"遭逢～，发抒未竟之志。","book":"清·钱谦益《江兆豫侍御六十序》"},"usage":"作主语、宾语；指清明的朝代"},{"id":2742,"word":"不讳之路","pinyin":"bù huì zhī lù","abbr":"bhzl","explanation":"指忠言直谏之路。","source":{"text":"间令公卿郡国举贤良方正，远求博选，开不讳之路，冀得至谋，以鉴不逮。","book":"《后汉书·安帝纪》"},"example":{"text":"君子难进易退……朝廷开～，犹恐不言。","book":"《旧唐书·颜真卿传》"},"similar":["不讳之门"],"usage":"作主语、宾语；指忠言直谏之路"},{"id":2743,"word":"不讳之门","pinyin":"bù huì zhī mén","abbr":"bhzm","explanation":"讳：忌讳。指说话可以直言不讳的地方。","source":{"text":"规谏必看不讳之门。","book":"汉·刘向《说苑·君道》"},"similar":["不讳之路"],"usage":"作主语、宾语；指忠言直谏之路"},{"id":2744,"word":"不设城府","pinyin":"bù shè chéng fǔ","abbr":"bscf","explanation":"城府：比喻心机。对人处事不用心机，诚恳坦率。","source":{"text":"尧俞厚重寡言，遇人不设城府，人自不忍欺。","book":"《宋史·傅尧俞传》"}},{"id":2745,"word":"不识一丁","pinyin":"bù shí yī dīng","abbr":"bsyd","explanation":"形容一个字也不认识。","source":{"text":"天下无事，汝辈挽得两石弓，不如识一丁字。","book":"《旧唐书·张弘靖传》"},"example":{"text":"而云古无类书，此真一丁不识之无知妄作也矣。","book":"清·平步青《霞外捃屑》卷七"},"similar":["目不识丁"],"opposite":["学富五车"],"usage":"作谓语、定语；形容文化水平低","story":["唐朝幽州节度使张弘靖的部将韦雍和张宗厚经常在一起喝酒，那时天下太平，边关没有战事，这些将士没有事做。他们感慨：“如今天下太平，练武不如练文，你们能拉满两石的弓，还不如识一个字”。由于“个”与“丁”接近演变而成"]},{"id":2746,"word":"不识不知","pinyin":"bù shí bù zhī","abbr":"bsbz","explanation":"没有多少知识。旧喻民风淳朴。","source":{"text":"尧乃微服游于于康衢，闻儿童谣曰：‘立我蒸民，莫匪尔极。不识不知，顺帝之则。’","book":"《列子·仲尼》"},"example":{"text":"然尝闻尧舜之世，十日一风，五日一雨，百姓耕田而食，凿井而饮，所谓“～，顺帝之则”是也。","book":"明·冯梦龙《东周列国志》第十八回"},"similar":["不知不觉"],"usage":"作谓语、定语；指不识古今"},{"id":2747,"word":"不识东家","pinyin":"bù shí dōng jiā","abbr":"bsdj","explanation":"指不识近邻是圣贤。","source":{"text":"“不识东家丘”的略语。相传孔子西家有愚夫，不识孔子为圣人，称之为“东家丘”。"},"example":{"text":"荀济人非许、郭，～，虽复莠言自口，未宜荣辱也。","book":"北魏·杨衒之《洛阳伽蓝记·秦太上君寺》"},"usage":"作谓语、定语；指人不识货"},{"id":2748,"word":"不识之无","pinyin":"bù shí zhī wú","abbr":"bszw","explanation":"连“之”字、“无”字都不认识。形容人不识字，文化水平很低。","source":{"text":"仆始生六七月时，乳母抱弄于书屏下，有指‘无’字、‘之’字示仆者，仆虽口未能言，心已默识。","book":"唐·白居易《与元九书》"},"example":{"text":"《废墟中》，写一个～的木匠，爱打老婆，老婆也让他打；他有气无处泄，她也就让他泄。","book":"李健吾《序》"},"similar":["不识一丁"],"opposite":["学富五车"],"usage":"作谓语、定语；形容人不识字","story":["唐朝时期，大诗人白居易从小就聪明过人，据《新唐书》记载他生下的第7个月就能指认“之无”两字，他的乳母百试不差。他给元稹的信证实：“仆始生六七月时，乳母抱弄于书屏下，有指‘无’字、‘之’字示仆者，仆虽口未能言，心已默识。”"]},{"id":2749,"word":"不识人间有羞耻事","pinyin":"bù shí rén jiān yǒu xiū chǐ shì","abbr":"bsrjyxcs","explanation":"不知道人世间还有羞耻之事。形容恬不知耻。","source":{"text":"是足下不复知人间有羞耻事尔。","book":"宋·欧阳修《与高司谏书》"},"example":{"text":"卖他们的一党专制的狗肉，死皮赖脸，乱吹一顿，～。","book":"毛泽东《团结一切抗日力量，反对反共顽固派》"},"similar":["不知人间有羞耻事"],"usage":"作谓语、定语；指人不知廉耻"},{"id":2750,"word":"不识大体","pinyin":"bù shí dà tǐ","abbr":"bsdt","explanation":"大体：关系全局的道理。不懂得从大局考虑。","source":{"text":"臣愚浅，不识大体。","book":"《史记·平原虞卿列传》：“平原君，翩翩浊世之佳公子也，然未睹大体。”晋·袁宏《后汉记》卷一○"},"example":{"text":"上斥为～，仍谕内监在外生事者听人责惩。","book":"《清史稿·高宗本纪》"},"similar":["目光如豆","鼠目寸光"],"opposite":["目光如炬","高瞻远瞩","卓有远见"],"usage":"作谓语、宾语、定语；指眼光短浅"},{"id":2751,"word":"不识好歹","pinyin":"bù shí hǎo dǎi","abbr":"bshd","explanation":"不知好坏。指愚蠢，缺乏识别能力。","source":{"text":"[九阿姐]方才告诉我许多话，说你不识好歹，放着鹅毛不知轻，顶着磨子不知重，心下好生不悦。","book":"《醒世恒言·卖油郎独占花魁》"},"example":{"text":"给你们读一点古书总是好意；古书又不是毒药，竟会这样胡闹起来，这明明是～呀！","book":"夏丐尊、叶圣陶《文心》十五"},"similar":["不识抬举","混淆黑白","是非不分"],"opposite":["是非分明"],"usage":"作谓语、定语；指人不辨是非"},{"id":2752,"word":"不识局面","pinyin":"bù shí jú miàn","abbr":"bsjm","explanation":"犹不识时务。","source":{"text":"原来毛仲义五更时，先把大虫解上州里去了，却带了若干做工公的来捉解珍解宝。不想他这两个不识局面，正中了他的计策，分说不得。","book":"《水浒传》第四九回"},"similar":["不识时务","不晓世务"],"usage":"作谓语、定语；形容人不明事理"},{"id":2753,"word":"不识庐山真面目","pinyin":"bù shí lú shān zhēn miàn mù","abbr":"bslszmm","explanation":"比喻认不清事物的真相和本质。","source":{"text":"横看成岭侧成峰，远近高低各不同。不识庐山真面目，只缘身在此山中。","book":"宋·苏轼《题西林壁》诗"},"example":{"text":"革命家，终会在大风大浪中，辨明方向，分清歧路；怎能够－－只见长江滚滚来，～！","book":"郭小川《万里长江横渡》诗"},"usage":"作谓语、分句；形容不识事物的本质","story":["庐山因周武王时期高人匡俗结庐而居而得名，它三面临江，山势十分雄伟，山清水秀，风景奇丽。它临江靠水，山上烟雾缥缈，人们很难看清它的真实面貌。苏轼写《题西林壁》：“横看成岭侧成峰，远近高低各不同。不识庐山真面目，只缘身在此山中。”"]},{"id":2754,"word":"不识抬举","pinyin":"bù shí tái jǔ","abbr":"bstj","explanation":"识：认识，理解；抬举：赞扬，器重。不懂得人家对自己的好意。","source":{"text":"这和尚好不识抬举，我这姐姐，那些儿不好、","book":"明·吴承恩《西游记》第六十四回"},"example":{"text":"这贱人～。","book":"明·许仲琳《封神演义》第七回"},"similar":["不识好歹","不受抬举","不中抬举"],"opposite":["感恩戴德"],"usage":"作谓语、定语；形容对人强烈不满"},{"id":2755,"word":"不识时务","pinyin":"bù shí shí wù","abbr":"bssw","explanation":"时务：当前的形势和潮流。指不认识当前重要的事态和时代的潮流。现也指待人接物不知趣。","source":{"text":"邓骘当朝贵盛，闻霸名行，欲与结交，霸逡巡不答。众人笑其不识时务。","book":"《后汉书·张霸传》"},"example":{"text":"什么年月了，还吃这碗饭，太～了。","book":"张洁《沉重的翅膀》"},"similar":["因循守旧","不识时变","率由卓章"],"opposite":["不主故常","因势利导","见风使舵"],"usage":"作谓语、定语；形容人不明事理","story":["东汉时期会稽太守张霸，学识渊博，治理会稽三年，将一个乱世治理成一个太平盛世，在百姓眼中威望很高，他激流勇退，后被朝廷选为侍中，皇亲邓骘都想拉拢他，而张霸却小心避开，众人议论张霸不识时务"]},{"id":2756,"word":"不识泰山","pinyin":"bù shí tài shān","abbr":"bsts","explanation":"不认识泰山。比喻见闻太窄，认不出地位高或本领大的人。","source":{"text":"师父如此高强，必是个教头，小儿‘有眼不识泰山’。","book":"明·施耐庵《水浒传》第二回"},"example":{"text":"请原谅我有眼～。"},"similar":["有眼无珠"],"usage":"作谓语、宾语、定语；用于处世"},{"id":2757,"word":"不识起倒","pinyin":"bù shí qǐ dǎo","abbr":"bsqd","explanation":"指不知好歹；不识时务。","source":{"text":"你那三个和尚已被我洗净了，不久便要宰杀，您还不识起倒？去了罢！","book":"《西游记》第五二回"},"example":{"text":"费小胡子忍不住笑了，他想来这位～的曾老二一定把吴荪甫缠的头痛。","book":"茅盾《子夜》十"},"similar":["不识时务","不识好歹"],"usage":"作谓语、定语；指不知好歹"},{"id":2758,"word":"不识马肝","pinyin":"bù shí mǎ gān","abbr":"bsmg","explanation":"相传马肝有毒，食之能致人于死。比喻不应研讨的事不去研讨。"},{"id":2759,"word":"不识高低","pinyin":"bù shí gāo dī","abbr":"bsgd","explanation":"指说话或做事不知深浅、轻重。","source":{"text":"你这小畜生，不识高低！看棍。","book":"明·吴承恩《西游记》第四十一回"},"example":{"text":"岂不晓得我孙氏是八代世臣，敢来触犯，全然～，禽兽不如。","book":"明·冯梦龙《东周列国志》第六十六回"},"similar":["不知轻重","不知高低"],"usage":"作谓语、定语；指人自傲"},{"id":2760,"word":"不误农时","pinyin":"bù wù nóng shí","abbr":"bwns","explanation":"不耽误农作物的播种时节。","source":{"text":"必须注意领导人民加紧生产，不误农时，不荒地，防止地富怠工和破坏。","book":"邓小平《贯彻执行中共中央关于土改与整党工作的指示》"},"example":{"text":"路遥《平凡的世界》第三卷第16章：“他苦恼归苦恼，但～，及时开始耕种。”"},"similar":["不违农时"],"usage":"作谓语、宾语；指不要错过播种季节"},{"id":2761,"word":"不请自来","pinyin":"bù qǐng zì lái","abbr":"bqzl","explanation":"不用邀请自己前来。多指不速之客。","source":{"text":"老聃迎着说道：‘刚正想来访你，你已不请自来，省却我们许多脚步。’","book":"丁寅生《孔子演义》第五回"},"example":{"text":"消息公布后，来了许多～的人。"},"similar":["不速之客"],"usage":"作谓语、定语；用于往来等"},{"id":2762,"word":"不谋同辞","pinyin":"bù móu tóng cí","abbr":"bmtc","explanation":"指事前没有商量而意见完全一致。","source":{"text":"群下百僚，不谋同辞。","book":"《后汉书·祭祀志上》"},"example":{"text":"[武王]与八百诸侯威同此盟，《尚书》所谓～也，故曰孟津，亦曰盟津。","book":"北魏·郦道元《水经注·河水五》"},"similar":["异口同声"],"opposite":["各抒己见"],"usage":"作谓语、定语；用于观点相同"},{"id":2763,"word":"不谋而合","pinyin":"bù móu ér hé","abbr":"bmeh","explanation":"谋：商量；合：相符。事先没有商量过，意见或行动却完全一致。","source":{"text":"二人之言，不谋而合。","book":"晋·干宝《搜神记》卷二"},"example":{"text":"如磁石铁，～。","book":"宋·苏轼《朱寿昌梁武忏赞偈》"},"similar":["异口同声","殊途同归","不约而同"],"opposite":["众说纷纭","言人人殊","见仁见智"],"usage":"作谓语、定语、宾语；形容动作、想法一致","story":["东汉末年，关中地区大乱，军阀混战，韩遂与马腾各自争霸，曹操派钟繇去监督他们，命他们各派一子到京城做人质。后来马超韩遂等惶惶不安，决定共同对付曹操，推举韩遂为都督。韩遂的部将阎行反对起兵“现在关中各将不谋而同，好像老天命定如此”"]},{"id":2764,"word":"不谋而同","pinyin":"bù móu ér tóng","abbr":"bmet","explanation":"谋：商量；同：相同。事先没有商量过，意见或行动却完全一致。","source":{"text":"考其所陈，中于义理，天人合愿，不谋而同。","book":"唐·韩愈《请上尊号表》"},"example":{"text":"或训鬓发，或训头饰，干宝更以为马髴，与我所想象的，正～。","book":"郭沫若《中国古代社会研究》第一篇第一章第一节"},"similar":["不谋而合"],"opposite":["众说纷纭"],"usage":"作谓语、定语；形容想法、行动一致","story":["东汉末年，关中地区大乱，军阀混战，韩遂与马腾各自争霸，曹操派钟繇去监督他们，命他们各派一子到京城做人质。后来马超韩遂等惶惶不安，决定共同对付曹操，推举韩遂为都督。韩遂的部将阎行反对起兵：“现在关中各将不谋而同，好像老天命定如此"]},{"id":2765,"word":"不负众望","pinyin":"bù fù zhòng wàng","abbr":"bfzw","explanation":"负：辜负；众：众人；望：期望。不辜负大家的期望。","example":{"text":"他终于～，成为村里的第一个大学生。"},"similar":["众望所归"],"opposite":["大失所望"],"usage":"作谓语、定语；指很争气，没有辜负希望"},{"id":2766,"word":"不败之地","pinyin":"bù bài zhī dì","abbr":"bbzd","explanation":"原意是指善于打仗的就有取胜的把握，不会落到挫败的境地。后泛指办事有成功的充分把握。","source":{"text":"故善者，立于不败之地。","book":"春秋·齐·孙武《孙子·形篇》"},"example":{"text":"以求自立于～，则谥之曰‘保守主义’。","book":"毛泽东《井冈山的斗争》"},"similar":["所向无敌","百战百胜"],"opposite":["一败涂地","一败如水"],"usage":"作宾语；用于处于优势"},{"id":2767,"word":"不贪为宝","pinyin":"bù tān wé bǎo","abbr":"btwb","explanation":"表示以不贪为可贵、崇高，也表示廉洁奉公。","source":{"text":"我以不贪为宝，尔以玉为宝，若以与我，皆丧宝也。","book":"春秋·鲁·左丘明《左传·襄公十五年》"},"example":{"text":"共产党人应以～，才能服众。"},"similar":["廉洁奉公"],"opposite":["贪污腐化"],"usage":"作宾语、定语；指人廉洁","story":["春秋时期，宋国有人在开凿石料时发现一块宝玉，请人鉴定是宝石，就抬到都城献给大臣子罕，子罕说如果给我，我们都失去了宝，我以不贪为宝。于是命人打磨宝玉到市场上卖掉，把钱交给宋人，派人护送他回家"]},{"id":2768,"word":"不费之惠","pinyin":"bù fèi zhī huì","abbr":"bfzh","explanation":"指白白得到的好处。","source":{"text":"那时是白得来的东西，左右是不费之惠，料然决不怠慢了我们。","book":"《二刻折案惊奇》卷十"},"example":{"text":"一条毛巾或两刀稿纸，咱们还能没地方去‘拿’？拿来送给他，这就叫～！","book":"老舍《四世同堂》二三"},"usage":"作主语、宾语；用于书面语"},{"id":2769,"word":"不费吹灰之力","pinyin":"bù fèi chuī huī zhī lì","abbr":"bfchzl","explanation":"形容事情做起来非常容易，不花一点力气。","source":{"text":"依小道愚意，等他到了辽东，有了收管，去摆布他，真不费吹灰之力。","book":"清·夏敬渠《野叟曝言》第四十五回"},"example":{"text":"他一听见老残一封书去，抚台便这样的信从，若替他办那事，自～，一定妥当的，所以就迷迷价笑。","book":"清·刘鹗《老残游记》第十七回"},"similar":["轻而易举","举手之劳","易如反掌"],"opposite":["难于登天"],"usage":"作谓语、分句；形容做事容易"},{"id":2770,"word":"不赀之器","pinyin":"bù zī zhī qì","abbr":"bzzq","explanation":"赀：估量；器：才能。不可估量的才能。形容人很有才能。","source":{"text":"卒成不赀之器。","book":"《孔丛子·居卫》"}},{"id":2771,"word":"不赀之损","pinyin":"bù zī zhī sǔn","abbr":"bzzs","explanation":"赀：计算，估量；损：损失。不可估量的损失。指损失极大。","source":{"text":"然于统一之计，已有不赀之损。","book":"《三国志·魏志·司马芝传》"}},{"id":2772,"word":"不赀之禄","pinyin":"bù zī zhī lù","abbr":"bzzl","explanation":"赀：计算，估量；禄：古代官吏的薪俸。不可计量的薪俸。比喻待遇极高。","source":{"text":"故乃建邱山之功，享不赀之禄。","book":"汉·陈琳《檄吴将校曲文》"}},{"id":2773,"word":"不赀之赏","pinyin":"bù zī zhī shǎng","abbr":"bzzs","explanation":"赀：计算，估量；赏：赏赐。不可估量的赏赐。指极大的赏赐。","source":{"text":"上书陈事，起自战国，幸而感悟主人，为时所纳，初获不赀之赏，终陷不测之罪。","book":"北齐·颜之推《颜氏家训·省事》"}},{"id":2774,"word":"不赀之躯","pinyin":"bù zī zhī qū","abbr":"bzzq","explanation":"赀：估量。指不能以资财估价的身体。极言人之高贵。","source":{"text":"用不赀之躯，临不测之险。","book":"《汉书·盖宽饶传》"}},{"id":2775,"word":"不赏之功","pinyin":"bù shǎng zhī gōng","abbr":"bszg","explanation":"形容功劳极大。","source":{"text":"臣闻勇略震主者身危，而功盖天下者不赏。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"自开辟以来，戴震主之威，挟～，以见容于暗世者而谁？","book":"《晋书·刘牢之传》"},"similar":["盖世之功","丰功伟绩"],"usage":"作主语、宾语、补语；形容功劳巨大"},{"id":2776,"word":"不赞一词","pinyin":"bù zàn yī cí","abbr":"bzyc","explanation":"一句话也不说。","source":{"text":"至于为《春秋》，笔则笔，削则削，子夏之徒，不能赞一辞。","book":"《史记·孔子世家》"},"example":{"text":"我大抵任他自言自语，～，他独自发完议论，也就算了。","book":"鲁迅《呐喊·头发的故事》"},"similar":["缄口不言","不赞一辞"],"usage":"作谓语；指一言不发"},{"id":2777,"word":"不赞一辞","pinyin":"bù zàn yī cí","abbr":"bzyc","explanation":"原指文章写得好，别人不能再添一句话。一句话也不说。","source":{"text":"至于为《春秋》，笔则笔，削则削，子夏之徒，不能赞一辞。","book":"西汉·司马迁《史记·孔子世家》"},"example":{"text":"李大人看了～，赵大人看了仍旧交还司员。","book":"清·李宝嘉《官场现形记》第83回"},"similar":["不赞一词"],"usage":"作谓语；指一言不发"},{"id":2778,"word":"不越雷池","pinyin":"bù yuè léi shi","abbr":"bylc","explanation":"比喻不敢超越一定的范围和界限。同“不敢越雷池一步”。","source":{"text":"有一种惯例，从来送客，只到自己房门为止，不越雷池一步。","book":"曹靖华《忆当年，穿着细事且莫等闲看！》"},"example":{"text":"他始终～。"},"similar":["不敢越雷池一步"],"usage":"作谓语、定语；指严格遵守制度"},{"id":2779,"word":"不越雷池一步","pinyin":"bù yuè léi chí yī bù","abbr":"bylcyb","explanation":"雷池：湖名，在安徽省望江县南。不敢越过界限，形容拘谨。","source":{"text":"有一种惯例，从来送客，只到自己房门为止，不越雷池一步。","book":"曹靖华《忆当年，穿着细事且莫等闲看！》"},"example":{"text":"王朔《枉然不供》：“虽无惊天地、泣鬼神、利国利民的大功德，也是乐天敬业，～。”"},"similar":["不敢越雷池一步"],"usage":"作谓语、状语；形容人保守拘谨"},{"id":2780,"word":"不足与谋","pinyin":"bù zú yǔ móu","abbr":"bzym","explanation":"与：和。不值得和他商量。","source":{"text":"竖子不足与谋。夺项王天下者，必沛公也，吾属今为之虏矣。","book":"《史记·项羽本纪》"},"example":{"text":"众诸侯皆言不可轻动。操大怒曰：“竖子不足与谋。”","book":"明·罗贯中《三国演义》第六回"},"usage":"作谓语、补语；指不能信任","story":["楚汉相争时期，刘邦想在关中称王的计划败露，为摆脱困境听从张良的计策亲自去鸿门赴宴，席间范增召来项庄舞剑，想趁机杀掉刘邦。刘邦借机溜走，张良献上白璧与玉斗，范增气得把玉斗摔在地上，对着项羽说不足与谋"]},{"id":2781,"word":"不足为凭","pinyin":"bù zú wéi píng","abbr":"bzwp","explanation":"不能当作凭证或根据。","source":{"text":"诗板是明白已验之迹，便可为据；开具乃委曲苟免之词，不足为凭。","book":"宋·刘安世《论蔡确作诗讥讪事第六》"},"example":{"text":"纵说这话～，前番我在德州作那个梦，梦见那匹马，及至梦中遇着了他，那匹马就不见了。","book":"清·文康《儿女英雄传》第二十六回"},"similar":["道听途说","无案可稽","捕风捉影"],"opposite":["有案可稽","言之凿凿","铁证如山"],"usage":"作谓语；指事情或言论不能成为凭据"},{"id":2782,"word":"不足为外人道","pinyin":"bù zú wéi wài rén dào","abbr":"bzwwrd","explanation":"不必跟外面的人说。现多用于要求别人不要把有关的事告诉其他的人。","source":{"text":"此中人语云，不足为外人道也。","book":"晋·陶潜《桃花源记》"},"example":{"text":"晋·陶潜《桃花源记》：“此中人语云，不足为外人道也。”"},"similar":["不足挂齿"],"usage":"作谓语、分句；形容不值得对外说"},{"id":2783,"word":"不足为奇","pinyin":"bù zú wéi qí","abbr":"bzwq","explanation":"足：值得。不值得奇怪。指某种事物或现象很平常，没有什么奇怪的。","source":{"text":"人乐其大而忘其私，不然则公不足为奇。","book":"宋·毕仲游《祭范德孺文》"},"example":{"text":"这些都是小事情，～，不过偶然想到，举例而已。","book":"《鲁迅书信集·致李霁野》"},"similar":["家常便饭","司空见惯","比比皆是"],"opposite":["大惊小怪","千奇百怪","异乎寻常"],"usage":"作谓语、定语；形容事情等很普遍"},{"id":2784,"word":"不足为怪","pinyin":"bù zú wéi guài","abbr":"bzwg","explanation":"不足：不值得。不值得认为奇怪。","source":{"text":"众哄然一笑曰：‘是固有之，不足为怪。’","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"example":{"text":"至于屋子材料的窳陋，那是贫民窟房屋的本色，～。","book":"邹韬奋《经历》"},"similar":["不足为奇"],"opposite":["稀奇古怪"],"usage":"作谓语、定语；形容事情等很普遍"},{"id":2785,"word":"不足为意","pinyin":"bù zú wéi yì","abbr":"bzwy","explanation":"不值得介意。","source":{"text":"公但自信此心，秉公任直，纷纷之言，不足为意。","book":"明·张居正《答郑范溪》"},"example":{"text":"肺病的进行，似已被阻止；但偶仍发热，则由于肋膜，～也。","book":"鲁迅《书信集·致沈雁冰》"},"similar":["不足介意"],"opposite":["耿耿于怀"],"usage":"作谓语、定语；指不值得介意","story":["隋朝时期，越国公杨素的儿子杨玄感与书角书生李密关系很好，杨玄感准备趁隋炀帝亲征高丽之机起兵谋反，李密给他出了上中下三条计策，上策是断其后路，中策是取长安消灭不足为意的卫文升，杨玄感取下策停在洛阳，最终失败"]},{"id":2786,"word":"不足为据","pinyin":"bù zú wéi jù","abbr":"bzwj","explanation":"足：够得上；据：证据。不能作为依据。","source":{"text":"诗板是明白已验之迹，便可为据；开具乃委曲苟免之词，不足为凭。","book":"宋·刘安世《论蔡确作诗讥讪事第六》"},"example":{"text":"自信力的有无，状元宰相的文章是～的，要自己去看地底下。","book":"鲁迅《且介亭杂文·中国人失掉自信力了吗？》"},"similar":["不足为凭"],"usage":"作谓语；指事情或言论不能成为凭据"},{"id":2787,"word":"不足为法","pinyin":"bù zú wéi fǎ","abbr":"bzwf","explanation":"不值得学习、效法。","source":{"text":"开口便说：《大雅》不作，骚人斯起，然词多哀怨，已非正声；至杨、马益流宕。建安以后更绮丽，不足为法。","book":"清·赵翼《瓯北诗话·李青莲诗》"},"example":{"text":"那些工作作风实～。","book":"丁玲《太阳照在桑干河上·写在前边》"},"similar":["不足为训"],"opposite":["不刊之论","天经地义"],"usage":"作谓语；指不值得学习"},{"id":2788,"word":"不足为虑","pinyin":"bù zú wéi lǜ","abbr":"bzwl","explanation":"不值得忧虑担心。","source":{"text":"且合肥城固，不足为虑。","book":"晋·陈寿《三国志·魏志·卫臻传》"},"example":{"text":"承教方知西事，然倭奴水寇，～，盖此辈舍舟无能为也。","book":"明·李贽《焚书·答陆思山》"},"opposite":["提心吊胆"],"usage":"作谓语；指不必担心"},{"id":2789,"word":"不足为训","pinyin":"bù zú wéi xùn","abbr":"bzwx","explanation":"足：够得上；训：法则，典范。不值得作为效法的准则或榜样。","source":{"text":"君诗如风螭巨鲸，步骤虽奇，不足为训。","book":"明·胡应麟《诗薮续编》卷一"},"example":{"text":"孝琪的行为虽然～，然而他的议论思想也有独到处，这还是定庵的遗传性。","book":"清·曾朴《孽海花》第四回"},"similar":["不足为法","似是而非"],"opposite":["不易之论","不刊之论","天经地义"],"usage":"作谓语；指对事情不以为然，不值得仿效"},{"id":2790,"word":"不足为道","pinyin":"bù zú wéi dào","abbr":"bzwd","explanation":"足：值得；道：说。不值得一说。","source":{"text":"此女棋本下劣，枉得其名，不足为道。","book":"明·凌濛初《二刻拍案惊奇》第二卷"},"example":{"text":"区区小事，～。"},"similar":["不值一提","何足挂齿"],"usage":"作谓语、定语；用于口语"},{"id":2791,"word":"不足之处","pinyin":"bù zú zhī chù","abbr":"bzzc","explanation":"不完善的地方。","source":{"text":"总的来说是好的，但是也有不足之处。","book":"邓小平《目前的形势和任务》"},"usage":"作主语、宾语；用于口语"},{"id":2792,"word":"不足介意","pinyin":"bù zú jiè yì","abbr":"bzjy","explanation":"不值得放在心上。","source":{"text":"袁公路岂忧国忘家者邪？冢中柘骨，何足介意。","book":"《三国志·蜀书·先主传》"},"example":{"text":"如此敌人，～，所以我仍要从事译作，再做一年。","book":"《鲁迅书信集·致章廷谦》"},"similar":["不必介意"],"opposite":["耿耿于怀"],"usage":"作谓语；指不必放在心上"},{"id":2793,"word":"不足回旋","pinyin":"bù zú huí xuán","abbr":"bzhx","explanation":"回旋：转动。形容处境局促，不便转身。","example":{"text":"这儿地方太窄，～。"},"opposite":["留有余地"],"usage":"作谓语、定语；指行动不便","story":["汉景帝时期，景帝设宴招待各地来朝见的诸侯，并让大家跳舞庆贺，来自长沙的定王舞得很别扭，别人取笑他。景帝问他是不是不会舞蹈，他说国小地窄，不足回旋。景帝明白他的意思，就把武陵、零陵、桂阳三地加封给他"]},{"id":2794,"word":"不足挂齿","pinyin":"bù zú guà chǐ","abbr":"bzgc","explanation":"不足：不值得；挂齿：放在嘴上讲。表示不值得一提。","source":{"text":"此特群盗鼠窃狗盗耳，何足置之齿牙间？","book":"《史记·刘敬叔孙叔通传》"},"example":{"text":"宋江答道：“无能小将，～。”","book":"明·施耐庵《水浒全传》第八十七回"},"similar":["不在话下","微不足道","不屑一顾"],"opposite":["举足轻重","有口皆碑"],"usage":"作谓语、定语；指事情很小，微不足道"},{"id":2795,"word":"不足轻重","pinyin":"bù zú qīng zhòng","abbr":"bzqz","explanation":"犹言无关紧要。","source":{"text":"笔帖式为满洲进身之一途，今各衙门皆有，额设候补者又盈千累万，视为不足轻重矣。","book":"清·陈康祺《郎潜纪闻》卷五"},"example":{"text":"上自独当一面之官府，上至～之官吏，而亦共闻是言。","book":"清·邹容《革命军》第五章"},"similar":["无足轻重","无关紧要"],"opposite":["举足轻重"],"usage":"作谓语、定语；用于人、事、物"},{"id":2796,"word":"不足齿数","pinyin":"bù zú chǐ shǔ","abbr":"bzcs","explanation":"足：值得。表示数不上，不值得一提。","source":{"text":"此特群盗鼠窃狗盗，何足置齿牙间哉？","book":"《汉书·孙叔通传》"},"example":{"text":"从先前的阿Ｑ看来，小Ｄ本来是～。","book":"鲁迅《呐喊·阿Ｑ正传》"},"similar":["不足挂齿"],"opposite":["相提并论"],"usage":"作谓语；表示不能相提并论"},{"id":2797,"word":"不轨不物","pinyin":"bù guǐ bù wù","abbr":"bgbw","explanation":"轨：轨道，引申为法规；物：典章文物。超出常规和不合乎法则。","source":{"text":"君将纳民于轨物者也，故讲事以度轨量谓之轨，取材以章物采谓之物。不轨不物，谓之乱政。","book":"春秋·鲁·左丘明《左传·隐公五年》"},"usage":"作主语、宾语、定语；指混乱状况"},{"id":2798,"word":"不轨之徒","pinyin":"bù guǐ zhī tú","abbr":"bgzt","explanation":"不守法纪或图谋作乱的人。","source":{"text":"何则？虽有所犯，轻重甚殊，于士君子之心受责不同而名不异者，故不轨之徒得引名自方，以惑众听，因名可乱，假力取直，故清议益伤也。","book":"《晋书·刘颂传》"},"example":{"text":"那些～一闻凶信，逃走了一半，只有跑不去［的］，共捉了男妇三百七十余人，一并捆绑，将叛产封固。","book":"清·佚名《听月楼》第二十回"},"similar":["不法之徒"],"usage":"作宾语；用于坏人"},{"id":2799,"word":"不轻然诺","pinyin":"bù qīng rán nuò","abbr":"bqrn","explanation":"轻：轻易；然诺：许诺。不随便许诺什么。形容处事谨慎。也形容人守信用。","source":{"text":"如严某者，其亦浊世之铮铮，而不轻然诺者与！","book":"清·淮阴百一居士《壶天录》卷中"},"similar":["一诺千金"],"usage":"作谓语、定语；形容处事谨慎"},{"id":2800,"word":"不辞劳苦","pinyin":"bù cí láo kǔ","abbr":"bclk","explanation":"辞：推托；劳苦：劳累辛苦。不逃避劳累辛苦。形容人不怕吃苦，毅力强。","source":{"text":"今日之事，请不辞劳苦。","book":"唐·牛肃《纪闻·吴保安》"},"example":{"text":"真正难得的，是她那不会厌倦的同情和～的服务。","book":"朱自清《刘云波女医师》"},"similar":["不辞辛苦"],"opposite":["拈轻怕重","好逸恶劳"],"usage":"作谓语、定语；形容不怕劳累和辛苦"},{"id":2801,"word":"不辞而别","pinyin":"bù cí ér bié","abbr":"bceb","explanation":"辞：告辞；别：离别。没有告辞就离开了。或悄悄溜走了。","source":{"text":"报老爷得知，王粲不辞而别去了。","book":"元·郑德辉《王粲登楼》第一折"},"example":{"text":"于是，大家想不辞而别。","book":"老舍《不成问题的问题》"},"similar":["逃之夭夭","溜之大吉"],"opposite":["不速之客"],"usage":"作谓语、宾语、状语；形容不打招呼就离开"},{"id":2802,"word":"不辞辛劳","pinyin":"bù cí xīn láo","abbr":"bcxl","explanation":"辞：推辞。虽然劳累和辛苦也不推辞，形容工作勤奋努力","example":{"text":"要想尽快到达目的地，就要～"},"similar":["不辞辛苦"],"opposite":["拈轻怕重"],"usage":"作谓语、定语；形容不怕劳累和辛苦"},{"id":2803,"word":"不辞辛苦","pinyin":"bù cí xīn kǔ","abbr":"bcxk","explanation":"辞：推辞。虽然劳累和辛苦也不推辞，形容工作勤奋努力","example":{"text":"他～，一定要送他去北京"},"similar":["不辞劳苦","不辞辛劳"],"opposite":["好逸恶劳","拈轻怕重"],"usage":"作谓语、定语；形容不怕劳累和辛苦"},{"id":2804,"word":"不辟斧钺","pinyin":"bù bì fǔ yuè","abbr":"bbfy","explanation":"斧钺：古代的兵器。不躲避斧钺之类的兵器。形容将士英勇无畏，或烈士忠义不屈。","source":{"text":"不敢避斧钺之诛。","book":"《汉书·赵充国传》"}},{"id":2805,"word":"不辨真伪","pinyin":"bù biàn zhēn wěi","abbr":"bbzw","explanation":"辨：分辨。伪：虚假。无法辨别真的和假的。","source":{"text":"馋言三至，慈母不亲；愤愤俗差别，不辨真伪。","book":"三国·魏·曹植《当墙欲高行》"},"example":{"text":"晋文公先年过曹，曹人多有识得的，其夜仓卒～。","book":"明·冯梦龙《东周列国志》第三十九回"},"similar":["真假难辨","鱼目混珠"],"usage":"作谓语；用于处事"},{"id":2806,"word":"不辨菽粟","pinyin":"bù biàn shū sù","abbr":"bbss","explanation":"分不清哪是豆子，哪是小米。形容愚笨无知。后形容缺乏实际生产知识。","source":{"text":"婢妾之养不备，则不世；祠祭弗如式，不世；不辨菽粟，亦不世。","book":"清·龚自珍《农宗》"},"similar":["不辨菽麦","五谷不分"],"opposite":["学富五车","见多识广"],"usage":"作谓语、定语、宾语；比喻脱离实际"},{"id":2807,"word":"不辨菽麦","pinyin":"bù biàn shū mài","abbr":"bbsm","explanation":"菽：豆子。分不清哪是豆子，哪是麦子。形容愚笨无知。后形容缺乏实际生产知识。","source":{"text":"周子有兄而无慧，不能辨菽麦，故不可立。","book":"《左传·成公十八年》"},"example":{"text":"世间也尽有～的人。","book":"郭沫若《银杏》"},"similar":["愚昧无知","目不识丁","五谷不分"],"opposite":["博学多才","学富五车"],"usage":"作谓语、定语、宾语；比喻脱离实际","story":["春秋时期晋国国君晋厉公荒淫无道，经常滥杀无辜，群臣经常互相倾轧。大臣栾书、中行偃在宠臣匠丽氏家里活捉晋厉公，并在两年后处死晋厉公。由于晋襄公的大儿子是白痴，连豆子、麦子都分不清，只好立其小儿子周子为晋悼公"]},{"id":2808,"word":"不辨龙蛇","pinyin":"bù biàn lóng shé","abbr":"bbls","explanation":"辨：辨别，明察。是龙是蛇不加分辨。形容不分优劣，不识好坏。","source":{"text":"如今那宪台疏乱滚滚当路豺狼，选法弊絮叨叨请俸日月，禹门深眼睁睁不辨龙蛇。","book":"元·宫大用《范张鸡黍》第二折"},"similar":["不识好坏"],"usage":"作谓语、定语；指人分辨能力差"},{"id":2809,"word":"不辩菽麦","pinyin":"bù biàn shū mài","abbr":"bbsm","explanation":"分不清哪是豆子，哪是麦子。形容愚笨无知。后形容缺乏实际生产知识。","source":{"text":"分不清哪是豆子，哪是麦子。形容愚笨无知。后形容缺乏实际生产知识。"},"similar":["不辨菽麦"],"usage":"作谓语、定语、宾语；比喻脱离实际"},{"id":2810,"word":"不辱使命","pinyin":"bù rǔ shǐ mìng","abbr":"brsm","explanation":"指不辜负别人的差使。","source":{"text":"寿昌大笑起来，掉头对着立群说：‘不辱使命！’","book":"郭沫若《洪波曲》第三章"},"example":{"text":"我们此行～，完成全部计划。"},"similar":["不负众望"],"usage":"作谓语；指完成使命"},{"id":2811,"word":"不达大体","pinyin":"bù dá dà tǐ","abbr":"bddt","explanation":"大体：大局，整体利益。不懂得从大局考虑。","source":{"text":"袁绍不达大体。","book":"南朝·宋·范晔《后汉书·袁绍传》"},"similar":["不识大体"],"opposite":["高瞻远瞩"],"usage":"作谓语、宾语、定语；指眼光短浅"},{"id":2812,"word":"不达时务","pinyin":"bù dá shí wù","abbr":"bdsw","explanation":"务：事物；时务：当前的重大事情或形势。指不认识当前重要的事态和时代的潮流。现也指待人接物不知趣。","source":{"text":"虽是我能忍辱，冤家太不达时务。","book":"明·胡文焕《群音类选·》"},"example":{"text":"设或～，则报与田牛儿，回去告官，教他性命也自难保。","book":"明·冯梦龙《醒世恒言》第34卷"},"similar":["不识时务"],"opposite":["见风使舵"],"usage":"作谓语、定语；形容人不明事理"},{"id":2813,"word":"不迁之庙","pinyin":"bù qiān zhī miào","abbr":"bqzm","explanation":"古代不迁入祧庙合祭而单独进行祭祀的帝王家庙。","source":{"text":"宪宗皇帝有恢复中兴之功，请为百代不迁之庙。","book":"后晋·沈昫《旧唐书·武宗纪》"},"example":{"text":"中宗复辟中兴，当为百代～。","book":"唐·元稹《迁庙议》"}},{"id":2814,"word":"不过尔尔","pinyin":"bù guò ěr ěr","abbr":"bgee","explanation":"尔（前）：如此，这样；尔（后）：通“耳”，罢了。不过这样罢了。有轻视人的意思。","source":{"text":"金人一代制作不过尔尔。","book":"《宋史·沈辽传》：“使我自择，不过尔耳。”明·胡应麟《诗薮·杂编六·中州》"},"example":{"text":"白狼竟露布讨袁，斥为神奸国贼，文辞工炼，相传为陈琳讨曹，～。","book":"蔡东藩、许廑父《民国通俗演义》第四十回"},"similar":["不过如此","不值一提","不足挂齿"],"opposite":["非同小可","举足轻重","不同凡响"],"usage":"作谓语、宾语；形容没什么了不起"},{"id":2815,"word":"不近人情","pinyin":"bù jìn rén qíng","abbr":"bjrq","explanation":"不合乎人的常情。也指性情或言行怪僻。","source":{"text":"大有径庭，不近人情焉。","book":"《庄子·逍遥游》"},"example":{"text":"大人先问自己真情怎样？还说我恐吓，实太过～。","book":"清·黄小配《廿载繁华梦》第三十二回"},"similar":["冷若冰霜","拒人千里"],"opposite":["通情达理","合情合理"],"usage":"作谓语、宾语、定语；形容人言行不合情理","story":["春秋时期，楚国狂士接舆对肩吾说北海有一座姑射仙山，山上的神仙可以让世界五谷丰登。肩吾认为接舆的话大而无当、不近人情，就对连叔说接舆在吹牛。连叔沉思了一会，对肩吾说接舆的话不一定是没有道理的"]},{"id":2816,"word":"不近道理","pinyin":"bù jìn dào lǐ","abbr":"bjdl","explanation":"不近人情，不讲道理。","source":{"text":"王保正，您好不近道理！偌大一只狗子，怎地只把三百钱出来？须亏我。","book":"《古今小说·史弘肇龙虎君臣会》"},"similar":["不近人情"],"opposite":["合情合理"],"usage":"作谓语、定语；指为人等"},{"id":2817,"word":"不进则退","pinyin":"bù jìn zé tuì","abbr":"bjzt","explanation":"不前进就要后退。","source":{"text":"不进则退，不喜则忧，不得则亡，此世人之常。","book":"《邓析子·无后篇》"},"example":{"text":"逆水行舟，～，学外语也是一样，一刻也放松不得。"},"similar":["逆水行舟"],"opposite":["勇往直前"],"usage":"作谓语、定语；用于人的思想、学习等"},{"id":2818,"word":"不进油盐","pinyin":"bù jìn yóu yán","abbr":"bjyy","explanation":"形容人十分固执。","example":{"text":"这种人～，让人失望透顶。"},"similar":["顽固不化"],"usage":"作谓语、定语；指人固执"},{"id":2819,"word":"不远万里","pinyin":"bù yuǎn wàn lǐ","abbr":"bywl","explanation":"不以万里为远。形容不怕路途遥远。","source":{"text":"王曰：‘叟，不远千里而来，亦将有以利吾国乎？’","book":"《孟子·梁惠王上》"},"example":{"text":"受加拿大共产党和美国共产党的派遣，～，来到中国。","book":"毛泽东《纪念白求恩》"},"similar":["不远千里"],"opposite":["近在咫尺"],"usage":"作谓语；形容不计较路途遥远"},{"id":2820,"word":"不远千里","pinyin":"bù yuǎn qiān lǐ","abbr":"byql","explanation":"不以千里为远。形容不怕路途遥远。","source":{"text":"王曰：‘支，不远千里而来，亦将有以利吾国乎？’","book":"《孟子·梁惠王上》"},"example":{"text":"两个壮士～而来，同心协助，如何却要斩他？（明·施耐庵《水浒全传》第四十七回）"},"similar":["不辞劳苦","千里迢迢","跋山涉水"],"opposite":["近在咫尺"],"usage":"作谓语、状语；形容不计较路途遥远","story":["战国时期梁惠王见了孟子说：“你不远千里而来，一定能给我国带来利益。”孟子说：“大王一开口就讲利，有仁义就行，大家都去逐利，那么就永远也得不到满足。”梁惠王问该怎么办，孟子说：“只要大王讲仁义就行。”"]},{"id":2821,"word":"不违农时","pinyin":"bù wéi nóng shí","abbr":"bwns","explanation":"违：不遵守。不耽误农作物的耕种时节。","source":{"text":"不违农时，谷不可胜食也。","book":"《孟子·梁惠王上》"},"example":{"text":"～，减少误工，也十分重要。","book":"毛泽东《减租和生产是保卫解放区的两件大事》"},"similar":["不夺农时"],"opposite":["坐失良机"],"usage":"作谓语；指不要错过播种季节","story":["战国时期，孟子去见梁惠王，梁惠王问孟子自己如何尽力治国，百姓遭灾时是如何尽力救济，为什么人口没有增加。孟子认为只是考虑如何去救灾，没有考虑到如何不违农时去发展农业生产，应该尽快抓紧时间促进生产，让人们过上温饱生活"]},{"id":2822,"word":"不追既往","pinyin":"bù zhuī jì wǎng","abbr":"bzjw","explanation":"追：追究。对以往的错误或罪责不再追究。","source":{"text":"闻该夷平日重一信字，果如本大臣所谕，已来者尽数呈缴，未来者断绝不来，是能悔罪畏刑，尚可不追既往。","book":"清·林则徐《谕各国商人呈缴烟土稿》"},"similar":["既往不咎"],"opposite":["耿耿于怀"],"usage":"作谓语；形容不计较过去的事情"},{"id":2823,"word":"不适时宜","pinyin":"bù shì shí yí","abbr":"bssy","explanation":"适：适应；时宜：当时的需要。不符合时势和趋势。","source":{"text":"‘拚消耗’的主张，对于中国红军来说是不适时宜的。","book":"毛泽东《中国革命战争的战略问题》第九节"},"similar":["不合时宜"],"usage":"作谓语、定语、状语；指过时的或超前的"},{"id":2824,"word":"不通一窍","pinyin":"bù tōng yī qiào","abbr":"btyq","explanation":"窍：洞，指心窍。没有一窍是贯通的。比喻一点儿也不懂。","source":{"text":"纣性不仁，心不通，安于为恶，杀比干，故孔子言其一窍通则比干不见杀也。","book":"《吕氏春秋·过理》：“杀比干而视其心，不适也。孔子闻之曰：‘其窍通，则比干不死矣。’”高诱注"}},{"id":2825,"word":"不通世务","pinyin":"bù tōng shì wù","abbr":"btsw","explanation":"指不了解社会上的情况。","example":{"text":"他是个书呆子，一点也～。"},"similar":["不通时宜"],"opposite":["八面圆通"],"usage":"作谓语、定语；指不懂为人处世","story":["从前有个财主有万贯家财，他的儿子不学无术，过着饭来张口，衣来伸手的生活，财主不教育他。艾子提醒他让他受教育，财主不满艾子说他的儿子不通世务。艾子把他的儿子叫来问大米从何处而来，财主儿子答米是从米袋中来的"]},{"id":2826,"word":"不通文墨","pinyin":"bù tōng wén mò","abbr":"btwm","explanation":"通：精通；文墨：指写文章、著述等。指人文化水平不高或识字不多。","source":{"text":"小生旧日在那里住了数年，与他相交时，他虽是个不通文墨的人，为见他与人结交真有义气，是个好男子。","book":"明·施耐庵《水浒传》第15回"},"example":{"text":"明·冯梦龙《喻世明言》第二卷：“二来是个村郎，～。”"},"similar":["胸无点墨","不识之无"],"opposite":["学富五车","才高八斗"],"usage":"作谓语、定语；用于人的素质等"},{"id":2827,"word":"不通时宜","pinyin":"bù tōng shí yí","abbr":"btsy","explanation":"不明白当时的形势、潮流。","source":{"text":"今人言不通时宜而无顾忌者曰方头。","book":"明·郎瑛《七修类稿·辩证九·方头》"},"similar":["不通世务"],"usage":"作谓语、定语；指不懂为人处世"},{"id":2828,"word":"不通水火","pinyin":"bù tōng shuǐ huǒ","abbr":"btsh","explanation":"形容跟人不相往来。","source":{"text":"杜门不通水火。","book":"《汉书·孙宝传》"},"similar":["不相往来"],"usage":"作谓语；形容不相往来"},{"id":2829,"word":"不逞之徒","pinyin":"bù chěng zhī tú","abbr":"bczt","explanation":"不逞：不得志，不如意；徒：人（含贬义）。因心怀不满而闹事捣乱的人。","source":{"text":"故五族聚群不逞之人，因公子之徒以作乱。","book":"《左传·襄公十年》"},"example":{"text":"如有～假托民军，借端扰害治安，即为人民公敌。","book":"蔡东藩、许廑父《民国通俗演义》第六十八回"},"similar":["不法之徒"],"usage":"作主语、宾语；指犯罪分子或存心捣乱的人","story":["春秋时期，郑国丞相子驷派人害死郑僖公，拥立五岁的郑简公，把持朝政，因整顿田地疆界及水渠问题上得罪司氏、堵氏、侯氏、子师氏等。后来司臣、尉止等率领聚集起来的不逞之徒发动叛乱，杀死子驷、子国及子耳等"]},{"id":2830,"word":"不速之客","pinyin":"bù sù zhī kè","abbr":"bszk","explanation":"速：邀请。指没有邀请突然而来的客人。","source":{"text":"有不速之客三人来，敬之终吉。","book":"《周易·需》"},"example":{"text":"这样出乎意外的～，却受着了真正是由衷而出的恳切的欢迎。","book":"郭沫若《海涛集·跨着东海》"},"similar":["不招自来"],"opposite":["特约嘉宾"],"usage":"作主语、宾语；指没有邀请的人"},{"id":2831,"word":"不逢不若","pinyin":"bù féng bù ruò","abbr":"bfbr","explanation":"逢：迎合；若：顺从。不迎合，不顺从。","source":{"text":"百物为之备，使民知神奸，故民入川泽山林，不逢不若。","book":"《左传·宣公二年》"}},{"id":2832,"word":"不遑启处","pinyin":"bù huáng qǐ chǔ","abbr":"bhqc","explanation":"没有闲暇的时间过安宁的日子。指忙于应付繁重或紧急的事务。","source":{"text":"匹夫百亩一室，不遑启处，无所移之也。","book":"《诗经·小雅·采薇》：“王事靡盬，不遑启处。”汉·韩婴《韩诗外传》卷四"}},{"id":2833,"word":"不遑宁处","pinyin":"bù huáng níng chǔ","abbr":"bhnc","explanation":"遑：闲暇。没有闲暇的时候。指忙于应付繁重或紧急的事情。","source":{"text":"故荷戈驱驰，不遑宁处，前后表陈，于今历年矣。","book":"《晋书·桓温传》"},"example":{"text":"频繁上命，徒想报恩，驰骤下寮，～。","book":"唐·张鷟《游仙窟》"},"similar":["不遑宁息"],"usage":"作谓语、定语；指无时消受"},{"id":2834,"word":"不遑宁息","pinyin":"bù huáng níng xī","abbr":"bhnx","explanation":"没有闲暇的时间过安宁的日子。指忙于应付繁重或紧急的事务。同“不遑宁处”。","source":{"text":"故勉精历操，晨兴夜寐不遑宁息，经之以岁月，累之以日力。","book":"《三国志·吴书·韦曜传》"},"example":{"text":"微臣所以叩心绝气，忘寝与食，雕肝焦虑，～者也。","book":"唐·房玄龄《晋书·凉武昭王传》"},"similar":["不遑宁处"],"usage":"作谓语、定语；指无时消受"},{"id":2835,"word":"不遑暇食","pinyin":"bù huáng xiá shí","abbr":"bhxs","explanation":"没有时间吃饭。形容工作紧张、辛勤。","source":{"text":"《书·无逸》：“自朝至於日中昃，不遑暇食，用咸和万民。”孔颖达疏：“遑亦暇也。重言之者，古人自有复语。犹云‘艰难’也。”一说，没有闲暇时间从容地吃饭。"},"similar":["废寝忘食"],"opposite":["饱食终日"],"usage":"作谓语、定语；指人工作忙"},{"id":2836,"word":"不遑枚举","pinyin":"bù huáng méi jǔ","abbr":"bhmj","explanation":"bù  huáng  méi  jǔ","source":{"text":"凡一切开民智增公益之事，无不尽力，设民会以通声气，立高等学校以养人材……凡兹文明之事业，不遑枚举。","book":"梁启超《噶苏士传》第四节"},"similar":["不胜枚举","举不胜举"],"opposite":["寥寥无几","屈指可数"],"usage":"作谓语、补语；用于列举的场合"},{"id":2837,"word":"不遗余力","pinyin":"bù yí yú lì","abbr":"byyl","explanation":"遗：留；余力：剩下的力量。把全部力量都使出来，一点不保留。","source":{"text":"秦不遗余力矣，必且欲破赵军。","book":"《战国策·赵策三》：“秦之攻我也，不遗余力矣，必以倦而归也。”《史记·平原君虞卿列传》"},"example":{"text":"委员和事，调停惟赖孔方；绅士责言，控诉～。","book":"清·李宝嘉《文明小史》第四回"},"similar":["全力以赴","倾巢而出"],"opposite":["三心二意","留有余地"],"usage":"作谓语、定语、状语；用于人全力以赴","story":["公元前260年秦王派大将白起，在赵国长平一举击败了赵括率领的40万赵军，秦王要求赵王割六座城池，赵王召集大将商量对策，虞卿认为秦国不遗余力攻打赵国，我们必须联合楚魏对抗，赵王不听，一味求和结果被秦所灭"]},{"id":2838,"word":"不遗寸长","pinyin":"bù yí cùn cháng","abbr":"bycc","explanation":"寸长：微小的长处。不遗漏一点点长处。形容善于发现别人的优点并给予称赞。","source":{"text":"称奖人才，不遗寸长。","book":"《宋史·娄机传》"},"usage":"作谓语；指爱惜人才"},{"id":2839,"word":"不遗尺寸","pinyin":"bù yí chǐ cùn","abbr":"bycc","explanation":"遗：遗漏；尺寸：形容数量小。比喻一点也不漏掉。","source":{"text":"但职司国课，其所以不遗尺寸者，亦将以尽瘁济其成法。","book":"明·天然痴叟《石点头·贪婪汉六院卖风流》"},"similar":["不遗巨细"],"usage":"作谓语、定语；指毫无遗漏"},{"id":2840,"word":"不遗巨细","pinyin":"bù yí jù xì","abbr":"byjx","explanation":"连极细小处也不放过。","source":{"text":"可见先生对一个问题不肯苟且的态度，不遗巨细的精神。真是佩服。","book":"廖仲恺《答胡適井田书》"},"similar":["不遗尺寸"],"usage":"作谓语、定语；指毫无遗漏"},{"id":2841,"word":"不遗毫发","pinyin":"bù yí háo fà","abbr":"byhf","explanation":"遗：疏漏；毫发：细毛和头发，指极微小的数量。一点遗漏都没有。形容非常细致周密。","source":{"text":"臣当修撰之时，史官沈传师等采事得于传闻，诠次不精，致有差误，圣明所鉴，毫发无遗。","book":"唐·韩愈《进顺宗皇帝实录表状》"},"example":{"text":"人物甚小，青衫白袴，乌巾黄履，～。","book":"宋·邓椿《画继·六·战德淳》"}},{"id":2842,"word":"不遗葑菲","pinyin":"bù yí fēng fēi","abbr":"byff","explanation":"原意是采集蔓青和萝卜时，不要困根部不好而连茎叶都抛弃。对有可取之处的人要尽量收罗利用。","source":{"text":"采葑采菲，无以下体。","book":"《诗经·邶风·谷风》"},"example":{"text":"前辈留意人材，～如此。","book":"清·赵翼《簷曝杂记》卷二"}},{"id":2843,"word":"不避子卯","pinyin":"bù bì zǐ mǎo","abbr":"bbzm","explanation":"子、卯：古人认为子日和卯日为恶日。不回避子、卯等不吉利的日子。指不迷信，没有忌讳。","source":{"text":"朝夕哭，不辟子卯。","book":"《仪礼·士丧礼》"}},{"id":2844,"word":"不避强御","pinyin":"bù bì qiáng yù","abbr":"bbqy","explanation":"不怕豪强有势力的人。同“不畏强御”。","source":{"text":"夫谨敕之人，身不蹈非，又有为史正直，不避强御，而奸猾之党横加诬言者，皆知敕之不久故也。","book":"《汉书·王符传》"},"example":{"text":"操持贵幸，～，缮理宫室，得其时制。","book":"唐·权德舆《唐西川节度副大使韦公先庙碑铭序》"},"similar":["不畏强御"],"usage":"作谓语、定语；指人刚正"},{"id":2845,"word":"不避斧钺","pinyin":"bù bì fǔ yuè","abbr":"bbfy","explanation":"斧钺：古代的兵器。不躲避斧钺之类的兵器。形容将士英勇无畏，或烈士忠义不屈。","source":{"text":"愚臣伏计孰甚，不敢避斧钺之诛，昧死陈愚，唯陛下省察。","book":"《汉书·赵充国传》"},"example":{"text":"臣向来不以面从为忠，故今日～，直言苦谏。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["视死如归"],"opposite":["贪生怕死"],"usage":"作谓语、定语；指人勇敢"},{"id":2846,"word":"不避水火","pinyin":"bù bì shuǐ huǒ","abbr":"bbsh","explanation":"指不畏凶险。","source":{"text":"贤弟心中有何危厄不决之难，但请尽说不妨，便当不避水火，力为解救，与汝相助。","book":"《水浒传》第五八回"},"similar":["不避汤火","水火不避"],"opposite":["贪生怕死"],"usage":"作谓语、定语；指人勇敢"},{"id":2847,"word":"不避汤火","pinyin":"bù bì tāng huǒ","abbr":"bbth","explanation":"指不畏凶险。","source":{"text":"壮士在军，攻城先登，陷阵却敌，斩将搴旗，前蒙矢石，不避汤火之难者，为重赏使也。","book":"《史记·货殖列传》"},"example":{"text":"明·伏雌教主《醋葫芦》第16回：“臣既食天之禄，理宜～。”"},"similar":["赴汤蹈火","不避水火"],"usage":"作谓语、定语；指人勇敢"},{"id":2848,"word":"不避艰险","pinyin":"bù bì jiān xiǎn","abbr":"bbjx","explanation":"不畏惧艰难险阻。","source":{"text":"随先主周旋，不避艰险。","book":"《三国志·蜀志·关羽传》"},"example":{"text":"清·李汝珍《镜花缘》第十回：“如此幼女，既能～，替母报仇，又肯尽孝。”"},"opposite":["知难而退"],"usage":"作谓语、定语；用于处事"},{"id":2849,"word":"不郎不秀","pinyin":"bù láng bù xiù","abbr":"blbx","explanation":"原指不高不下。后比喻不成材。","source":{"text":"元时称人以郎、官、秀为等第，至今人之鄙人曰不郎不秀，是言不高不下也。","book":"明·田艺蘅《留青日札·沈尤之秀》"},"example":{"text":"一身无室无家，半世～。","book":"明·毕魏《竹叶舟·收秀》"},"similar":["不上不下","不稂不莠"],"usage":"作谓语、定语；形容人没有发展前途","story":["明朝时期，田艺蘅《留青札记》中记载：元朝时称人以郎、官、秀为等第，“秀”是最高级别，“郎”是最下的，至明朝时称鄙人为“不郎不秀”，是指不高不下。良莠不齐就是不郎不秀，称那些高不成、低不就的人"]},{"id":2850,"word":"不问三七二十一","pinyin":"bù wèn sān qī èr shí yī","abbr":"bwsqesy","explanation":"不顾一切，不问是非情由。","source":{"text":"一个警察走来，不问三七二十一，抓住三轮车夫一顿拳打脚踢。","book":"朱自清《回来杂记》"},"example":{"text":"朱自清《回来杂记》：“一个警察走来，～，抓住三轮车夫一顿拳打脚踢。”"},"similar":["不管三七二十一"],"usage":"作谓语、宾语、状语；形容不顾一切"},{"id":2851,"word":"不问不闻","pinyin":"bù wèn bù wén","abbr":"bwbw","explanation":"闻：听。人家说的不听，也不主动去问。形容对事情不关心。","source":{"text":"所以这李纨虽青春丧偶，且居处于膏粱锦绣之中，竟如‘槁木死灰’一般，一概不问不闻，惟知侍亲养子。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"于是只好袭用仙传的古法，装聋作哑，置之～之列。","book":"鲁迅《三闲集·在钟楼上》"},"similar":["不闻不问","漠不关心"],"opposite":["满腔热忱"],"usage":"作谓语、定语；指态度冷淡","story":["大观园内只有李纨一个寡妇，她原是贾珠的老婆，贾珠死后，她与五岁的儿子贾兰相依为命。她出身金陵名宦家庭，知书达理，她青春丧偶后，虽处于膏粱锦绣之中，竟如槁木死灰一般，对外界一概不问不闻，就知道侍亲养子，是一个贤妻良母"]},{"id":2852,"word":"不问皂白","pinyin":"bù wèn zào bái","abbr":"bwzb","explanation":"比喻不分是非，不问情由。","source":{"text":"太阳已经起来了。他不问皂白，一直的往东走去。","book":"郁达夫《沉沦》五"},"similar":["不分皂白"],"usage":"作谓语、定语；指是非不分"},{"id":2853,"word":"不问青红皂白","pinyin":"bù wèn qīng hóng zào bái","abbr":"bwqhzb","explanation":"比喻不分是非，不问情由。","source":{"text":"何况这回巡捕做了原告，自然不问青红皂白，要惩办被告了。","book":"清·吴趼人《二十年目睹之怪现状》第十回"},"example":{"text":"谁家不交，便将人捆回村公所，～，按倒就是一顿军棍马棒。","book":"马烽《吕梁英雄传》第七回"},"similar":["不分皂白","是非不分"],"opposite":["是非分明","泾渭分明"],"usage":"作谓语、定语；指是非不分"},{"id":2854,"word":"不间不界","pinyin":"bù gān bù gà","abbr":"bjbj","explanation":"比喻左右为难，不好处理。也形容样子别扭。同“不尴不尬”。","source":{"text":"圣人全体极至，没那不间不界底事。","book":"《朱子语类》卷三四"},"example":{"text":"道如大路皆可遵，～难为人。","book":"宋·吴泳《赋半斋送张清分教嘉定》诗"},"similar":["不尴不尬","左右为难"],"opposite":["左右逢源"],"usage":"作谓语、宾语、定语；形容处境窘迫"},{"id":2855,"word":"不闻不问","pinyin":"bù wén bù wèn","abbr":"bwbw","explanation":"闻：听。人家说的不听，也不主动去问。形容对事情不关心。","source":{"text":"也不想想朝廷家平空的丢了一个太守，也就不闻不问，焉有是理。","book":"清·石玉昆《三侠五义》第七十六回"},"example":{"text":"大约这里的环境，本非有利于病，而不能完全～，也是使病缠绵之道。","book":"《鲁迅书信集·致沈雁冰》"},"similar":["漠不关心","置若罔闻"],"opposite":["有求必应","满腔热忱","急人之急"],"usage":"作谓语、定语；多与“漠不关心”连用"},{"id":2856,"word":"不阴不阳","pinyin":"bù yīn bù yáng","abbr":"byby","explanation":"比喻态度不明朗，模棱两可。","source":{"text":"这样的不阴不阳，教我怎么好呢？","book":"清·燕谷老人《续孽海花》第四十四回"},"example":{"text":"他神情不阴又不阳。","book":"京剧《沙家浜》第四场"},"similar":["模棱两可","不阳不阴"],"usage":"作谓语、定语；形容态度不明朗"},{"id":2857,"word":"不随以止","pinyin":"bù suí yǐ zhǐ","abbr":"bsyz","explanation":"不跟随别人而半途停止。","source":{"text":"有志矣，不随以止也，然力不足者亦不能至也。","book":"宋·王安石《游褒禅山记》"}},{"id":2858,"word":"不雌不雄","pinyin":"bù cí bù xióng","abbr":"bcbx","explanation":"犹不阴不阳。指态度暧昧。","source":{"text":"自古明人不做暗事，何不带顶髻儿还好看相，恁般乔打扮回来，不雌不雄，好不羞耻人！","book":"明·冯梦龙《喻世明言》第二十八卷"},"example":{"text":"狄希陈看不上眼，合童奶奶说道：‘天也极冷了，小珍珠还没有棉衣裳哩。’童奶奶道：‘我也看拉不上，冻的赤赤哈哈的。合寄姐说了几次，他又～。","book":"《醒世姻缘传》第七九回"},"similar":["不阴不阳","暧昧不明"],"opposite":["爱憎分明"],"usage":"作谓语、定语、状语；用于人的态度等"},{"id":2859,"word":"不露圭角","pinyin":"bù lù guī jiǎo","abbr":"blgj","explanation":"圭角：圭玉的棱角。比喻才干不外露。","source":{"text":"遇人浑浑，不见圭角。","book":"宋·欧阳修《张子野墓志铭》"},"example":{"text":"如彦高《人月圆》，半是古人句，其思致含蓄甚远，～，不犹胜于宇文自作者哉？","book":"元·刘祁《归潜志》"},"similar":["不露锋芒"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；形容人深沉、不露锋芒"},{"id":2860,"word":"不露声色","pinyin":"bù lù shēng sè","abbr":"blss","explanation":"声：说话的声音；色：脸上的表情。心里的打算不在说话和脸色上显露出来。","source":{"text":"好以甘言啗人，而阴中伤之，不露辞色。","book":"《资治通鉴·唐玄宗开元二十四年》"},"example":{"text":"你看它，埋没地下，～，生命的每一秒种都在为完成自己的使命而苦斗。","book":"曹石《根的情操》"},"similar":["不动声色","面不改色"],"opposite":["面如土色","失魂落魄"],"usage":"作谓语、定语、状语；用于不让感情流露"},{"id":2861,"word":"不露形色","pinyin":"bù lù xíng sè","abbr":"blxs","explanation":"不让思想活动从行动和表情上流露出来。","source":{"text":"阿玛一向城府深藏，不露形色，怎么犯了这么大的错误。","book":"刘德桂《宣统皇帝》第一章二"},"example":{"text":"他顿感不安，口中却漫应着‘是啊，是啊’，一点～。","book":"朱苏进 子川《江山风雨情》第一章五"}},{"id":2862,"word":"不露斤斧","pinyin":"bù lù jīn fǔ","abbr":"bljf","explanation":"斤：斧头。看不见刀斧加工的痕迹。形容精巧自然。","source":{"text":"巧匠施工，不露斤斧。","book":"宋·释道原《景德传灯录·余杭大钱山从袭禅师》"},"similar":["巧夺天工"],"usage":"作谓语、定语；用于工艺品等"},{"id":2863,"word":"不露神色","pinyin":"bù lù shén sè","abbr":"blss","explanation":"内心活动不在脸上流露，以防别人察觉。","source":{"text":"南飞生不露神色，只是两手微颤，龙树古坦然的和别的会员说闲话，像没有看见选举结果似的。","book":"老舍《老张的哲学》"},"example":{"text":"他经常是～地干事。"},"similar":["不露声色"],"opposite":["喜形于色"],"usage":"作谓语、状语；指不动声色"},{"id":2864,"word":"不露辞色","pinyin":"bù lù cí sè","abbr":"blcs","explanation":"辞色：言辞神色。不让心里的打算从话音和脸色上流露出来。形容说话沉着老练。","source":{"text":"林甫城府深密，人莫窥其际，好以甘言啖人，而阴中伤之，不露辞色。","book":"宋·司马光《资治通鉴·唐玄宗开元二十四年》"},"similar":["不露声色"],"usage":"作谓语、定语、状语；用于不让感情流露"},{"id":2865,"word":"不露锋芒","pinyin":"bù lù fēng máng","abbr":"blfm","explanation":"锋芒：比喻锐气或才干。不显露出锐气或才干。多指有意地将自己的才能、抱负等加以掩饰。","source":{"text":"语有力而不露锋芒者，善言也。","book":"宋·吕祖谦《吕东莱文集·杂说》第20卷"},"example":{"text":"寇忠愍拜相白麻，杨大年之词，其间四句曰：‘能断大事，不拘小节；有干将之器～，怀照物之明而能包纳。","book":"宋·沈括《梦溪续笔谈》"},"similar":["深藏不露"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；比喻不显示出才智来"},{"id":2866,"word":"不露锋铓","pinyin":"bù lù fēng huì","abbr":"blfm","explanation":"比喻才干不外露。","source":{"text":"（寇准）能断大事，不拘小节；有干将器，不露锋芒。","book":"宋·沈括《梦溪笔谈·补笔谈》"}},{"id":2867,"word":"不顾一切","pinyin":"bù gù yī qiè","abbr":"bgyq","explanation":"什么都不顾。","source":{"text":"既然见到一点儿光，便不得不不顾一切地逃开。","book":"叶圣陶《孤独》"},"example":{"text":"我闭上眼睛，～的向着他手里的刀迎上去。","book":"巴金《长生塔·塔的秘密》"},"similar":["置之度外"],"opposite":["瞻前顾后"],"usage":"作谓语、状语；比喻什么都不顾"},{"id":2868,"word":"不顾前后","pinyin":"bù gù qián hòu","abbr":"bgqh","explanation":"比喻毫无顾忌。","source":{"text":"不是说句不顾前后的话：当初东府里太爷，倒是修炼了十几年，也没有成仙。这佛是更难成。","book":"《红楼梦》一二○回"},"similar":["百无禁忌","肆无忌惮"],"opposite":["瞻前顾后"],"usage":"作谓语、定语；指没有顾忌"},{"id":2869,"word":"不顾大局","pinyin":"bù gù dà jú","abbr":"bgdj","explanation":"不考虑整个局面或形势。","source":{"text":"似此不顾大局，自便私图，若非钦派亲信大员，前往各省详细稽查，认真清理，将来财政竭蹶，根本动摇，其弊当不可胜言……","book":"清·李宝嘉《官场现形记》第46回"},"example":{"text":"有些人为了个人私利，便～而做出损害公众利益的事情。"},"opposite":["顾全大局"],"usage":"作谓语、定语；用于处事"},{"id":2870,"word":"不顾死活","pinyin":"bù gù sǐ huó","abbr":"bgsh","explanation":"顾：顾念，考虑。连生死也不考虑了。形容拼命蛮干，不顾一切。","source":{"text":"这呆子不顾死活，闯上宫殿，一路钯，筑破门扇，打破桌椅，把些吃酒的家伙之类，尽皆打碎。","book":"明·吴承恩《西游记》第六十三回"},"example":{"text":"他们更希望有经验的人来领导他们，他们原意～地保卫家乡。","book":"巴金《火》第二部十"},"similar":["不顾安危","不顾一切"],"usage":"作谓语、定语；形容不要命"},{"id":2871,"word":"不食之地","pinyin":"bù shí zhī dì","abbr":"bszd","explanation":"不食：不生产粮食。指不能耕种的土地。","source":{"text":"我死则择不食之地而莽我焉。","book":"《礼记·檀弓上》"},"example":{"text":"山林、溪谷，～。","book":"《资治通鉴·周纪赧王四十二年》"},"similar":["不毛之地","不牧之地"],"opposite":["鱼米之乡"],"usage":"作宾语；同“不毛之地”"},{"id":2872,"word":"不食人间烟火","pinyin":"bù shí rén jiān yān huǒ","abbr":"bsrjyh","explanation":"道教称神仙或修道者不吃熟食。比喻人有出世之意。也比喻诗画之意高超，不凡凡俗。","source":{"text":"坡读其诗，叹息云：此不是吃烟火食人道底言语。","book":"宋·阮阅《诗话总龟前集》卷九引《直方诗话》"},"example":{"text":"“红藕香残玉簟秋”七字，便有吞梅嚼雪，～气。","book":"清·梁绍壬《两般秋雨庵随笔》卷三"},"similar":["不食烟火"],"usage":"作谓语、定语；用于为人或作品等"},{"id":2873,"word":"不食周粟","pinyin":"bù shí zhōu sù","abbr":"bszs","explanation":"粟：小米，泛指粮食。本指伯夷、叔齐于商亡后不吃周粟而死。比喻忠诚坚定，不因生计艰难而为敌方工作。","source":{"text":"武王已平殷乱，天下宗周，而伯夷、叔齐耻之，义不食周粟，隐于首阳山，采薇而食之。","book":"《史记·伯夷列传》"},"example":{"text":"这是沿路讨来的残饭，因为两人曾经议定“～”，只好进了首阳山之后开始实行。","book":"鲁迅《故事新编·采薇》"},"opposite":["卑躬屈膝"],"usage":"作谓语、定语；指人有骨气","story":["商朝末年，孤竹君的长子伯夷在父亲死后坚决不肯继承王位。后来商朝灭亡，周武王建立周朝，他也不愿出来为官，感到十分耻辱，就与弟弟叔齐决定不再吃周朝的粮食，两人隐居在首阳山，专门靠吃采山上的野果及野菜而生存"]},{"id":2874,"word":"不食烟火","pinyin":"bù shí yān huǒ","abbr":"bsyh","explanation":"①指不吃熟食。道家修炼主张绝粒却谷，不吃世间烟火物。②指诗文立意高超，言词清丽，不同凡俗。","source":{"text":"人都道他不食烟火，体气欲仙。","book":"《终有报》第一回"},"example":{"text":"此诗不独敏捷异常，且字字清新俊逸，饶有别致，似～者，大与平日不同。","book":"《玉娇梨》第一回"},"similar":["不食人间烟火"],"usage":"作谓语、定语；指道家修道"},{"id":2875,"word":"不食马肝","pinyin":"bù shí mǎ gān","abbr":"bsmg","explanation":"相传马肝有毒，食之能致人于死。比喻不应研讨的事不去研讨。","source":{"text":"上曰：‘食肉毋食马肝，未为不知味也；言学者毋言汤武受命，不为愚。’","book":"《汉书·辕固传》"},"example":{"text":"凡读书当阙所疑，所谓～，未为不知味。","book":"清·陈澧《东塾读书记·论语》"},"usage":"作谓语、定语；比喻不应研讨的事不去探讨"},{"id":2876,"word":"不餍人望","pinyin":"bù yàn rén wàng","abbr":"byrw","explanation":"餍：满足。不能满足众人的期望。","source":{"text":"三年约法，所以不餍人望者，谓其起法之本，根于命令耳。","book":"蔡东藩、廑父《民国通俗演义》第七十五回"}},{"id":2877,"word":"不饥不寒","pinyin":"bù jī bù hán","abbr":"bjbh","explanation":"不挨饿受冻。生活不愁温饱。","source":{"text":"老者衣帛食肉，黎民不饥不寒。","book":"《齐桓晋文之事》"}},{"id":2878,"word":"不饮盗泉","pinyin":"bù yǐn dào quán","abbr":"bydq","explanation":"比喻为人廉洁。","source":{"text":"（孔子）过于盗泉，渴矣而不饮，恶其名也。","book":"战国·鲁·尸佼《尸子》"},"example":{"text":"正人君子是～的。"},"similar":["不食周粟"],"usage":"作谓语、定语；指人有骨气"},{"id":2879,"word":"不骄不躁","pinyin":"bù jiāo bù zào","abbr":"bjbz","explanation":"躁：急躁。不骄傲，不急躁。形容人态度谦逊，工作谨慎踏实。","source":{"text":"只要同志们对于军事政策（行动和作战）和团结人民的政策，不犯大错误，谦虚谨慎，不骄不躁，是完全有办法的。","book":"毛泽东《中共中央关于同国民党进行和平谈判的通知》"},"example":{"text":"在成绩面前，要始终保持谦虚谨慎，不骄不躁的作风。"},"similar":["不卑不亢","戒骄戒躁","谦虚谨慎"],"opposite":["自高自大","骄傲自满","操之过急"],"usage":"作谓语、定语；形容态度谦虚，头脑冷静"},{"id":2880,"word":"不鸣则已，一鸣惊人","pinyin":"bù míng zé yǐ，yī míng jīng rén","abbr":"bmzyymjr","explanation":"鸣；鸟叫。比喻平时没有突出的表现，一下子做出惊人的成绩。","source":{"text":"此鸟不飞则已，一飞冲天；不鸣则已，一鸣惊人。","book":"西汉·司马迁《史记·滑稽列传》"},"usage":"作谓语、定语；用于人的表现"},{"id":2881,"word":"不齿于人","pinyin":"bù chǐ yú rén","abbr":"bcyr","explanation":"齿：象牙齿一样排列。不能列于人类。指被人看不起。","source":{"text":"以为士人不齿，放弃终身。","book":"宋·沈括《梦溪笔谈·杂志》"},"example":{"text":"燕人马植，本辽大族，仕至光禄卿，行污而内乱，～。","book":"清·毕沅《续资治通鉴·宋纪·徽宗政和元年》"},"similar":["狗彘不如"],"usage":"作谓语、定语；指被人看不起"},{"id":2882,"word":"不龟手药","pinyin":"bù guī shǒu yào","abbr":"bgsy","explanation":"①使手不冻裂的药。②比喻微才薄技。","source":{"text":"人生各自有穷通，世事宁论拙与工。裹马革心空许国，不龟手药却成功。早朝玉勒千门雪，夜坐蓬窗万壑风。借得奇书且勤读，小儿能续地炉红。","book":"《陆游诗集卷二十二·寓叹》"}},{"id":2883,"word":"与世俯仰","pinyin":"yǔ shì fǔ yǎng","abbr":"ysfy","explanation":"随波逐流，附和世俗。","source":{"text":"［米芾］又不能与世俯仰，故从仕数困。","book":"《宋史·文苑传六·米芾》"},"example":{"text":"这种爱憎分明，丝毫不苟的敏感性，难道不比那种是非不清，～的恶习好很多吗？","book":"愚明《青年与枣树》"},"similar":["与世沉浮","与世偃仰"],"usage":"作谓语、定语；用于处事"},{"id":2884,"word":"与世偃仰","pinyin":"yǔ shì yǎn yǎng","abbr":"ysyy","explanation":"偃仰：俯仰。指没有一定的主张，随大流。","source":{"text":"与时迁徙，与世偃仰。","book":"战国·赵·荀况《荀子·非相》"},"example":{"text":"与时迁徙，，～，千举万变，其道一也。","book":"西汉·韩婴《韩诗外传》第五卷"},"similar":["随声附和","与世俯仰"],"opposite":["固执己见"],"usage":"作谓语、定语；指随大流"},{"id":2885,"word":"与世推移","pinyin":"yǔ shì tuī yí","abbr":"ysty","explanation":"随着世道的变化而变化以合时宜。","source":{"text":"圣人不凝滞于物，而能与世推移。","book":"《楚辞·渔父》"},"example":{"text":"求一挟千百万之赀，～而足以畸轻畸重者也，管子以外，不数觏焉。","book":"郑观应《盛世危言·商战》"},"similar":["与时偕行","与时推移"],"usage":"作谓语、定语、状语；用于书面语"},{"id":2886,"word":"与世无争","pinyin":"yú shì wú zhēng","abbr":"yswz","explanation":"世：世人，周围的人。不跟社会上的人发生争执。这是一种消极的回避矛盾的处世态度。","source":{"text":"自以为无患，与人无争也。","book":"《战国策·楚策四》"},"example":{"text":"既然人家同我不对，我也乐得～，回家享用。","book":"清·李宝嘉《官场现形记》第五十三回"},"similar":["安分守己","循规蹈矩","随遇而安"],"opposite":["沽名钓誉","好大喜功","肆无忌惮"],"usage":"作谓语、定语、补语；指消极避世"},{"id":2887,"word":"与世无竞","pinyin":"yú shì wú jìng","abbr":"yswj","explanation":"世：世人，周围的人。不跟社会上的人竞争。这是一种消极的回避矛盾的处世态度。","source":{"text":"自以为无患，与人无争也。","book":"《战国策·楚策四》"},"example":{"text":"惟其大彻大悟，故能泰然～，超出于生活之欲之外，而逞其势力于纯粹之学问。","book":"浦江清《论王静安先生之自沉》"}},{"id":2888,"word":"与世沉浮","pinyin":"yú shì chén fú","abbr":"yscf","explanation":"与：和，同；世：指世人；沉浮：随波逐流。随大流，大家怎样，自己也怎样。","source":{"text":"岂若卑论侪俗，与世沉浮而取荣名哉。","book":"《史记·游侠列传》"},"example":{"text":"若皆～，不自树立，虽不为当时所怪，亦必无后世之传也。","book":"唐·韩愈《答刘正夫书》"},"similar":["随波逐流"],"usage":"作谓语、定语；指随大流"},{"id":2889,"word":"与世浮沉","pinyin":"yǔ shì fú chén","abbr":"ysfc","explanation":"随波逐流，附和世俗。","source":{"text":"然不能与世浮沉。平视贵要，若无人，故所至龃龉。","book":"宋·司马光《右班殿直傅君墓志铭》"},"example":{"text":"然三官之为人，即萧萧易水，亦将羞而不流，况碌碌～者耶！","book":"清·蒲松龄《聊斋志异·商三官》"},"similar":["与世沉浮"],"usage":"作谓语、定语；指随大流"},{"id":2890,"word":"与世长存","pinyin":"yǔ shì cháng cún","abbr":"yscc","explanation":"和世界一起永远存在。多用于赞颂人的功绩和不朽的精神品德。"},{"id":2891,"word":"与世长辞","pinyin":"yǔ shì cháng cí","abbr":"yscc","explanation":"辞：告别。和人世永别了。指去世。","source":{"text":"仆适自念，以金盆玉碗贮狗矢，真无颜出见同人，行将遁迹山林，与世长辞矣。","book":"清·蒲松龄《聊斋志异·贾奉雉》"},"example":{"text":"曹冷元那斑白的头发楂和胡须都烧焦了，脸上起着一片红泡，眼睛含着浑泪，～了。","book":"冯德英《迎春花》第十九章"},"similar":["寿终正寝","呜乎哀哉","玉陨香消"],"opposite":["万寿无疆","长生不老","青春永驻"],"usage":"作谓语、定语；指死"},{"id":2892,"word":"与世隔绝","pinyin":"yǔ shì gé jué","abbr":"ysgj","explanation":"与社会上的人们隔离，断绝来往。形容隐居或人迹不到的极偏僻地方。","source":{"text":"他们还过着这种单个的生活，未免太与世隔绝了吧？","book":"杨朔《泰山极顶》"},"example":{"text":"这个山区基本上是～的。"},"similar":["人迹罕至","渺无人烟","世外桃源"],"opposite":["熙熙攘攘","门庭若市","车水马龙"],"usage":"作谓语、定语、补语；指偏僻或封闭"},{"id":2893,"word":"与世靡争","pinyin":"yǔ shì mǐ zhēng","abbr":"ysmz","explanation":"和世上的人没有争执。形容脱俗拔尘的达观态度。","source":{"text":"邈哉许公，执真履贞，辞尧天下，抱朴隐形，川停岳峙，澹泊无营，栖迟高山，与世靡争。","book":"晋·潘岳《许由颂》"},"similar":["与世无争"],"usage":"作谓语、定语、状语；指消极避世"},{"id":2894,"word":"与人为善","pinyin":"yǔ rén wéi shàn","abbr":"yrws","explanation":"与：赞许，赞助；为：做；善：好事。指赞成人学好。现指善意帮助人。","source":{"text":"取诸人以为善，是与人为善者也。故君子莫大乎与人为善。","book":"《孟子·公孙丑上》"},"example":{"text":"想你们教士也是～，断不肯叫我为难的。","book":"清·李宝嘉《文明小史》第九回"},"similar":["行善积德"],"opposite":["居心叵测","心怀叵测"],"usage":"作谓语、宾语、定语；指帮助人","story":["战国时期，孟子给学生上课经常拿子路的例子来教育他们：“子路十分虚心听取别人指出他的毛病与不足，然后加以改正。从历史上看，凡是君子都是吸取别人的优点、长处，自己来实行善事。如舜、禹等都是如此。君子的最高德行就是与人为善。”"]},{"id":2895,"word":"与人方便","pinyin":"yǔ rén fāng biàn","abbr":"yrfb","explanation":"与：给。给予他人各种便利","source":{"text":"施主莫恼。‘与人方便，自己方便。’你就与我说说地名如何？我也可解得你的烦恼。","book":"明·吴承恩《西游记》第18回"},"usage":"作谓语、定语；常与“自己方便”连用"},{"id":2896,"word":"与人方便，自己方便","pinyin":"yǔ rén fāng biàn，zì jǐ fāng biàn","abbr":"yrfbzjfb","explanation":"给他人便利，他人也会给自己便利。","source":{"text":"罢罢罢，自古道与人方便，自己方便。看你这二个妇人，也不是已下人家的。","book":"元·施惠《幽闺记·皇华悲遇》"},"example":{"text":"施主莫恼。～，你就与我说说地名如何？我也可解得你的烦恼。","book":"明·吴承恩《西游记》第十八回"},"similar":["与人方便"],"usage":"作宾语、定语、分句；指劝人通融"},{"id":2897,"word":"与人无争","pinyin":"yú rén wú zhēng","abbr":"yrwz","explanation":"不跟社会上的人发生争执。这是一种消极的回避矛盾的处世态度。","source":{"text":"自以为无患，与人无争也。","book":"《战国策·楚策四》"},"example":{"text":"大师出家遁世，～，决不会来抢这个虚名儿。","book":"金庸《射雕英雄传》第三十九回"}},{"id":2898,"word":"与人无忤","pinyin":"yǔ rén wú wǔ","abbr":"yrww","explanation":"忤：抵触。没有和人相抵触的时候。指与人相处和善。","source":{"text":"无忤逆之言，无不合之义。","book":"汉·陆贾《新语·辨惑》"},"example":{"text":"闿运晚睹世变，～，以唯阿自容。","book":"《清史稿·儒林传·王闿运》"}},{"id":2899,"word":"与众不同","pinyin":"yǔ zhòng bù tóng","abbr":"yzbt","explanation":"跟大家不一样。","source":{"text":"这是今日令中第一个古人，必须出类拔萃，与众不同，才觉有趣。","book":"清·李汝珍《镜花缘》"},"example":{"text":"从他～的解题思路中，看出他很聪明。"},"similar":["异乎寻常","独出心裁","独具匠心"],"opposite":["司空见惯","平淡无奇","习以为常"],"usage":"作谓语、定语、状语；形容出色","story":["商朝末年，因为造鹿台，姜子牙被逼跳水潜逃。杨任上殿劝谏纣王。纣王十分气愤，就下令挖掉他的眼睛。杨任的怨气感动紫阳洞道德君。道德君为他补上一双带手的眼睛。从此与众不同的杨任就跟随姜子牙辅佐周文王灭商"]},{"id":2900,"word":"与众殊","pinyin":"yǔ zhòng shū","abbr":"yzs","explanation":"殊：不同。跟大家不一样。指人的性格、行为等不一般或事物很有特色。","source":{"text":"念蒙圣主恩，荣爵与众殊。","book":"《三国志·魏志·吴质传》裴松之注引《魏略》"},"example":{"text":"虽立贞碑～，字字皆是吾皇意。","book":"唐·贯休《上荆南府主三让德政碑》"}},{"id":2901,"word":"与受同科","pinyin":"yǔ shòu tóng kē","abbr":"ystk","explanation":"行贿和受贿的人受到同等的处罚。","source":{"text":"家兄一想，这件事倘要认真办起来，与受同科，不但姓文的担不起，就是老哥亦落不是的。","book":"清·李宝嘉《官场现形记》第三十六回"},"example":{"text":"凡赃私的银，是～的，他怎敢闹出来？","book":"清·吴趼人《二十年目睹之怪现状》第四十六回"},"usage":"作宾语、定语；用于书面语"},{"id":2902,"word":"与古为徒","pinyin":"yǔ gǔ wéi tú","abbr":"ygwt","explanation":"徒：同类的人。和古人作朋友。","source":{"text":"为人之所为者，人亦无疵焉，是之谓与人为徒。成而上比者，与古为徒。","book":"《庄子·人间世》"},"similar":["借古讽今"],"usage":"作谓语、定语；用于处事"},{"id":2903,"word":"与君一夕话，胜读十年书","pinyin":"yǔ jūn yī xī huà，shèng dú shí nián shū","abbr":"yjyxhsdsns","explanation":"与你谈一晚上话，让我受益匪浅。形容跟别人交谈的时间虽短，受益却很多","source":{"text":"子平听说，肃然起敬道：‘与君一夕话，胜读十年书！真是闻所未闻！’","book":"清·刘鹗《老残游记》第九回"},"example":{"text":"冯玉祥《我的生活》第33章：“军区司令的这番谈话，给我莫大的欣喜，真是‘～’了。”"},"usage":"作宾语、定语；用于交往等"},{"id":2904,"word":"与君一席话，胜读十年书","pinyin":"yǔ jūn yī xí huà，shèng dú shí nián shū","abbr":"yjyxhsdsns","explanation":"君：尊称对方；胜：胜于。和您谈了一会儿，受益比读了十年书还多。形容与别人交谈的时间虽短，收获却很大。","source":{"text":"子平听说，肃然起敬道：‘与君一席话，胜读十年书。真是闻所未闻。’","book":"清·刘鹗《老残游记》第九回"},"example":{"text":"如何是与人乐乐？曰：～。如何是众乐乐？曰：此中空洞原无物，何止容卿数百人。","book":"南怀瑾《学而第一·谁来了解你》"}},{"id":2905,"word":"与君周旋","pinyin":"yǔ jūn zhōu xuán","abbr":"yjzx","explanation":"周旋：追逐驰逐。奉陪你较量较量。指表面礼貌实际不客气","source":{"text":"其左执鞭弭，右属橐腱，以与君周旋。","book":"春秋·鲁·左丘明《国语·晋语》"},"usage":"作谓语、定语；用于处事"},{"id":2906,"word":"与天地同休","pinyin":"yǔ tiān dì tóng xiū","abbr":"ytdtx","explanation":"休：停止。生命力与天地相同。比喻无穷无尽","source":{"text":"西北荒中，有玉馈之酒，酒泉注焉，上有玉樽，取一樽，一樽复生，与天地同休，无干时。","book":"《神异经》"},"usage":"作谓语、定语；用于书面语"},{"id":2907,"word":"与天地同寿","pinyin":"yǔ tiān dì tóng shòu","abbr":"ytdts","explanation":"寿：寿命。与天地一样长久。比喻寿命很长","source":{"text":"登昆仑兮食玉英，与天地兮同寿，与日月兮同光。","book":"战国·楚·屈原《九原·涉江》"},"usage":"作谓语、定语；用于书面语"},{"id":2908,"word":"与年俱进","pinyin":"yǔ nián jù jìn","abbr":"ynjj","explanation":"与：跟，和。随着时间一天天地增长。形容不断增长。","source":{"text":"汝年渐长，足知善恶，当每思刻厉，奉朝廷为心，爵秩自然与年俱进。","book":"《宋书·孝武十四王传》"},"example":{"text":"这章书是圣人自言学问工夫～的话，所以十五， 三十，四十，五十，六十，七十俱要明点出来。","book":"清·曹雪芹《红楼梦》第八十四回"}},{"id":2909,"word":"与日俱增","pinyin":"yǔ rì jù zēng","abbr":"yrjz","explanation":"与：跟，和。随着时间一天天地增长。形容不断增长。","source":{"text":"涉冬浸剧，与日俱增。","book":"宋·吕祖谦《吕东莱集·为梁参政作乞解罢政事表二首》"},"example":{"text":"半个月过去了，风平浪静，然而老赵心里愁闷却～了。（茅盾《过年》）"},"similar":["日积月累","有增无已"],"opposite":["每况愈下"],"usage":"作谓语、定语；用于人的思想感情"},{"id":2910,"word":"与日俱新","pinyin":"yǔ rì jù xīn","abbr":"yrjx","explanation":"新：新面貌。随着时间一同更新。","source":{"text":"耳目唯有聪察，神彩弥加精明。颜与日而俱新，智将年而共远。","book":"宋·张君房《云笈七签》卷七十八"},"usage":"作谓语、定语；用于书面语"},{"id":2911,"word":"与日俱积","pinyin":"yǔ rì jù jī","abbr":"yrjj","explanation":"与：跟，和。随着时间一天天地增长。形容不断增长。","source":{"text":"瘀积之血，牢不可拔，新生之血，不得周灌，与日俱积，其人尚有生理乎。","book":"清·尤怡《金匮翼》卷三"},"example":{"text":"护法军兴，志在荡乱，北庭怙恶，视若寇仇，诪张为幻，～。","book":"丁中江《北洋军阀史话》一百四十二"}},{"id":2912,"word":"与日俱进","pinyin":"yǔ rì jù jìn","abbr":"yrjj","explanation":"与：跟，和。随着时间一天天地进步。形容不断进步或提高。","source":{"text":"二子位既成立，夫人因得冥心斋静，累感真灵，修真之益，与日俱进。","book":"宋·李昉《太平广记》卷五十八"}},{"id":2913,"word":"与日月争光","pinyin":"yǔ rì yuè zhēng guāng","abbr":"yryzg","explanation":"争：竞争。与太阳、月亮比光辉。常用以称赞人的精神、功业伟大。","source":{"text":"推此志也，虽与日月争光可也。","book":"《史记·屈原贾生列传》"},"example":{"text":"而景文等树义烈于千秋，荷褒扬于兴代，名～。","book":"《明史·范景文等传赞》"},"similar":["争光日月"],"usage":"作谓语、定语；用于称赞等"},{"id":2914,"word":"与日月齐光","pinyin":"yǔ rì yuè qí guāng","abbr":"yryqg","explanation":"与太阳、月亮的光芒相当。常用以称赞人的精神、功业伟大。","source":{"text":"与天地兮比寿，与日月兮齐光。","book":"《楚辞·涉江》"},"example":{"text":"不过谓为善之人，死则上通高明，其极品则～。","book":"《元史·刘因传》"},"usage":"作谓语、定语；用于比喻句"},{"id":2915,"word":"与时俯仰","pinyin":"yǔ shí fǔ yǎng","abbr":"ysfy","explanation":"俯仰：抬起落下。随着社会潮流或进或退。","source":{"text":"身直为闺閤之臣，宁得自引深藏于岩穴邪！故且从俗浮湛，与时俯仰，以通其狂惑。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"从父居上都，教授里巷，不～。","book":"《元史·忠义传·王佐》"},"similar":["与世俯仰"],"usage":"作谓语、定语；用于处事"},{"id":2916,"word":"与时俱进","pinyin":"yǔ shí jù jìn","abbr":"ysjj","explanation":"是指准确把握时代特征，始终站在时代前列和实践前沿，始终坚持解放思想、实事求是和开拓进取，在大胆探索中继承和发展。","source":{"text":"（谢启昆）才丰气盛，锐挺飙兴，不可阻遏。……然先生殊不以所能自足。十余年来先生之所造，与时俱进。……往时鸿篇巨制，人所惊叹以谓不可逮者，先生固已多所摈去矣。","book":"清·姚鼐《谢蕴山诗集序》"},"example":{"text":"贯彻“三个代表”要求，关键在坚持～。"}},{"id":2917,"word":"与时偕行","pinyin":"yǔ shí xié xíng","abbr":"ysxx","explanation":"变通趋时。","source":{"text":"损益盈虚，与时偕行。","book":"《易·损》"},"usage":"作谓语、定语；用于书面语"},{"id":2918,"word":"与时推移","pinyin":"yǔ shí tuī yí","abbr":"ysty","explanation":"随着世道的变化而变化以合时宜。","source":{"text":"吾不凝滞于物，与时推移。","book":"唐·李白《冬夜送烟子元演隐仙城山序》"},"similar":["与世推移"],"usage":"作谓语、定语；用于书面语"},{"id":2919,"word":"与时浮沉","pinyin":"yǔ shí fú chén","abbr":"ysfc","explanation":"浮沉：在水中忽上忽下的漂游。指随当时的世俗或进或退。","source":{"text":"陶冶世俗，与时浮沉，吾不如子；论王霸之余策，览倚仗之要害，吾似有一日之长。","book":"南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"又蚤解兵柄，～，不为秦桧所忌，故能窃宠荣以终其身，方之韩、岳远矣。","book":"《宋史·刘光世传》"},"similar":["与世浮沉"],"usage":"作谓语、定语、状语；用于处事"},{"id":2920,"word":"与时消息","pinyin":"yǔ shí xiāo xi","abbr":"ysxx","explanation":"指事物无常，随时间的推移而兴盛衰亡。消，消亡。息，孳生。","source":{"text":"故曰‘上失其道，民散久矣’。而欲绳之以古行刑，投之以残弃，非所谓与时消息者也。","book":"《周易·丰》：“日中则昃，月盈则食，天地盈虚，与时消息。”《后汉书·孔融传》"},"example":{"text":"《隋书·杨约传》：“自古贤人君子，莫不～以避祸患。”"},"usage":"作谓语、定语；用于书面语"},{"id":2921,"word":"与死扶伤","pinyin":"yǔ sǐ fú shāng","abbr":"ysfs","explanation":"与：援助；扶：扶助。援助要死的人，辅助受伤的人","source":{"text":"白刃合，流矢接，步血属肠，与死扶伤。","book":"西汉·刘安《淮南子·兵略训》"},"usage":"作谓语、定语；用于处事"},{"id":2922,"word":"与民休息","pinyin":"yǔ mín xiū xī","abbr":"ymxx","explanation":"与：给与，帮助；休息：休养生息。指在长期动乱后，亟需保养民力，复兴经济。","source":{"text":"海内虚耗，户口减半，光知时务之要，轻徭薄役，与民休息。","book":"《汉书·昭帝纪》"},"example":{"text":"《旧五代史·周书·杨行密传》：“行密既并孙儒，乃招合遣散，～，政事宽简，百姓便之。”"},"usage":"作谓语、定语；用于统治者"},{"id":2923,"word":"与民偕乐","pinyin":"yǔ mín xié lè","abbr":"ymxl","explanation":"原指君王施行仁政，与百姓休戚与共，同享欢乐。后泛指领导与群众一起游乐，共享幸福。","source":{"text":"古之人与民偕乐，故能乐也。","book":"《孟子·梁惠王上》"},"example":{"text":"故尧舜～，以仁德化天下，不事干戈，不行杀伐，景星耀天，甘露下降，凤凰止于庭，芝草生于野。","book":"明·许仲琳《封神演义》第二回"},"similar":["与民同乐"],"usage":"作谓语、定语；指地位高的人"},{"id":2924,"word":"与民同乐","pinyin":"yǔ mín tóng lè","abbr":"ymtl","explanation":"原指君王施行仁政，与百姓休戚与共，同享欢乐。后泛指领导与群众一起游乐，共享幸福。","source":{"text":"今王四猎于此，百姓闻王车马之音，见羽旄之美，举欣欣然有喜色而相告曰：‘吾王庶几无疾病与，何以能田猎也？’此无他，与民同乐也。","book":"《孟子·梁惠王下·庄暴见孟子》"},"example":{"text":"人人都到五凤楼前，端门之下，插金花，赏御酒，国家～。","book":"明·洪楩《清平山堂话本·戒指儿记》"},"similar":["与民偕乐"],"usage":"作谓语、定语；指地位高的人","story":["战国时期，齐宣王在宫中宴请孟子，问孟子道德高尚的人是否要与民同乐。孟子说：“国君以百姓的快乐为自己的快乐，百姓就会以国君的快乐为自己的快乐。国君与天下百姓同忧同乐，天下一心无人可敌。”齐宣王认为孟子言之有理"]},{"id":2925,"word":"与民同忧","pinyin":"yǔ mín tóng yōu","abbr":"ymty","explanation":"与人民共患难。","source":{"text":"又念有天下者未见不监古而治，弃古而乱也。岂上位者务在镇静，不须与民同忧也？","book":"宋·苏舜钦《诣匦疏》"},"usage":"作谓语、定语；用于书面语"},{"id":2926,"word":"与民更始","pinyin":"yǔ rén gēng shǐ","abbr":"ymgs","explanation":"更始：重新开始。原指封建帝王即位改元或采取某些重大措施。后比喻改革旧状，建立新秩序。","source":{"text":"朕嘉唐虞而乐殷周，据旧以鉴新，其赦天下与民更始。","book":"《庄子·盗跖》：“与天下更始，罢兵休卒。”《汉书·武帝纪》"},"example":{"text":"希望君主幡然改图，～。","book":"清·梁启超《政闻社宣言书》"},"similar":["除旧布新","与民同乐","休戚与共"],"opposite":["鱼肉乡里","高高在上","横征暴敛"],"usage":"作谓语；指帝王等"},{"id":2927,"word":"与民除害","pinyin":"yǔ hǔ chú hài","abbr":"ymch","explanation":"替百姓除祸害。","source":{"text":"丞相衔奉国威，为民除害，元恶大憝，心当枭夷。","book":"汉·陈琳《檄吴将校部曲文》"},"example":{"text":"清·贪梦道人《彭公案》第一回：“我一到任，必要为国尽忠，～，上报君恩，下安民业，剪恶安良。”"},"similar":["为民除害"],"usage":"作谓语；指清官或勇士"},{"id":2928,"word":"与物无忤","pinyin":"yǔ wù wú wǔ","abbr":"ywww","explanation":"指处世态度随和，与人无所抵触。","source":{"text":"宝夤作乱，以亮为黄门侍郎。亮善处人间，与物无忤。及宝夤败，从之者遇祸，唯亮获全。","book":"《周书·苏亮传》"},"usage":"作谓语、定语；用于处事"},{"id":2929,"word":"与物无竞","pinyin":"yǔ wù wú jìng","abbr":"ywwj","explanation":"指与世人无所争竞。","source":{"text":"湖少有节操，笃志于学，专精讲习，不干时务，与物无竞，好以德义服人。","book":"《北史·薛辩传》"},"example":{"text":"宰相重任，卿辈更审议之。吾在河东时见冯书记多才博学，～，此可相矣。","book":"宋·司马光《资治通鉴·后唐明宗天成二年》"},"similar":["与世无争"],"usage":"作谓语、定语；用于处事"},{"id":2930,"word":"与狐议裘","pinyin":"yǔ hú yì qiú","abbr":"yhyq","explanation":"裘：毛皮。跟狐狸商量要剥它的做大衣。比喻谋求有损对方切身利益的事，对方是绝对不会答应的。","source":{"text":"与狐议裘，无时焉可。","book":"汉·王符《潜夫论·述赦》"}},{"id":2931,"word":"与狐谋皮","pinyin":"yǔ hú móu pí","abbr":"yhmp","explanation":"谋：商量。跟狐狸商量要剥它的皮。比喻跟恶人商量要他放弃自己的利益，绝对办不到。","source":{"text":"周人有爱裘而好珍羞，欲为千金之裘而与狐谋其皮，欲具少牢之珍而与羊谋其羞，言未卒，狐相率逃于重丘之下，羊相呼藏于深林之中。","book":"晋·苻郎《苻子》"},"example":{"text":"如此时即奏筹遣漕船水手之议，是为千金之裘而～，不惟无益反有碍也。","book":"清·魏源《上江苏巡抚陆公论海漕书》"},"similar":["与虎谋皮"],"usage":"作谓语、宾语、定语；指幻想","story":["传说周朝有人特别喜欢穿皮衣吃精美的食品，他“欲为千金之裘而与狐谋其皮”，狐狸就传警报逃到深山中；“欲具少牢之珍而与羊谋其羞”，羊呼叫同伴一起藏到茂密的森林里去了。结果他没有制成一件皮袍，没有办成羊肉祭祀宴会"]},{"id":2932,"word":"与狐谋裘","pinyin":"yǔ hú móu qiú","abbr":"yhmq","explanation":"裘：毛皮。跟狐狸商量要剥它的做大衣。比喻谋求有损对方切身利益的事，对方是绝对不会答应的。","source":{"text":"与狐议裘，无时焉可。","book":"汉·王符《潜夫论·述赦》"}},{"id":2933,"word":"与羊谋羞","pinyin":"yǔ yáng móu xiū","abbr":"yymx","explanation":"谋：商量；羞：珍羞，精美的食物。跟羊商量要它的肉。比喻跟恶人商量要他放弃自己的利益，绝对办不到。","source":{"text":"周人有爱裘而好珍羞，欲为千金之裘而与狐谋其皮，欲具少牢之珍而与羊谋其羞，言未卒，狐相率逃于重丘之下，羊相呼藏于深林之中。","book":"晋·苻郎《苻子》"},"similar":["与狐谋皮"],"usage":"作宾语、定语；用于处事","story":["传说周朝有人特别喜欢穿皮衣吃精美的食品，他“欲为千金之裘而与狐谋其皮”，狐狸就传警报逃到深山中；“欲具少牢之珍而与羊谋其羞”，羊呼叫同伴一起藏到茂密的森林里去了。结果他没有制成一件皮袍，没有办成羊肉祭祀宴会"]},{"id":2934,"word":"与草木俱朽","pinyin":"yǔ cǎo mù jù xiǔ","abbr":"ycmjx","explanation":"身体和草木一同腐朽。指默默无闻地死去","source":{"text":"身与草木俱朽，声与日月并彰。","book":"汉·王充《论衡·自纪篇》"},"similar":["与草木俱腐","与草木同朽"],"usage":"作谓语、定语；用于书面语"},{"id":2935,"word":"与草木俱灰","pinyin":"yǔ cǎo mù jù huī","abbr":"ycmjh","explanation":"俱：全，都。和草木一起变成灰。形容人生前无所作为，死后也默默无闻。","source":{"text":"古来贤豪，不遭与运，埋光铲采，与草木俱腐者，可胜咤哉！","book":"《新唐书·高俭窦威传赞》"},"example":{"text":"既为男子，忍～。","book":"明·陈继儒《晚香堂·附赞·有序》"},"similar":["与草木俱腐","与草木俱朽"],"usage":"作谓语、定语；用于书面语"},{"id":2936,"word":"与草木俱腐","pinyin":"yǔ cǎo mù jù fǔ","abbr":"ycmjf","explanation":"俱：全，都。和草木一起腐烂。形容人生前无所作为，死后也默默无闻。","source":{"text":"古来贤豪，不遭与运，埋光铲采，与草木俱腐者，可胜咤哉！","book":"《新唐书·高俭窦威传赞》"},"example":{"text":"观此五者，则其他姓名不传，～者，盖不可胜计矣。","book":"宋·洪迈《容斋续笔》卷十七"},"similar":["与草木同腐","与草木俱灰"],"usage":"作谓语、定语；用于书面语"},{"id":2937,"word":"与草木同朽","pinyin":"yǔ cǎo mù tóng xiǔ","abbr":"ycmtx","explanation":"和草木一起腐烂。形容人生前无所作为，死后也默默无闻。","source":{"text":"古来贤豪，不遭与运，埋光铲采，与草木俱腐者，可胜咤哉！","book":"《新唐书·高俭窦威传赞》"},"example":{"text":"愚兄固当～，只可惜贤弟不能效古人所谓“良禽择木而栖，贤臣择主而仕”，以展贤弟之才。","book":"明·许仲琳《封神演义》第八十五回"},"similar":["与草木俱朽","与草木俱腐"],"usage":"作谓语、定语；用于书面语"},{"id":2938,"word":"与草木同腐","pinyin":"yǔ cǎo mù tóng fǔ","abbr":"ycmtf","explanation":"和草木一起腐烂。形容人生前无所作为，死后也默默无闻。","source":{"text":"虽然，自今观之，孔北海、盛孝章犹在世，而向之讥评者与草木同腐久矣。","book":"宋·苏轼《太息送秦少章》"},"example":{"text":"大丈夫处世，不能立功建业，不几～乎！","book":"明·罗贯中《三国演义》第四十七回"},"similar":["与草木俱腐","与草木俱灰"],"usage":"作谓语、定语；用于书面语"},{"id":2939,"word":"与虎添翼","pinyin":"yǔ hǔ tiān yì","abbr":"yhty","explanation":"翼：翅膀。替老虎加上翅膀。比喻帮助坏人，增加恶人的势力。","source":{"text":"今乘万民之力而反为残贼，是为虎傅翼，曷为弗除。","book":"《逸周书·寤敬篇》：“毋为虎傅翼，将飞入邑，择人而食之。”《淮南子·兵略训》"},"example":{"text":"若纵之使之归袁绍，是～也。","book":"明·罗贯中《三国演义》第二十七回"},"similar":["为虎添翼"],"usage":"作谓语、定语；指为虎作伥"},{"id":2940,"word":"与虎谋皮","pinyin":"yǔ hǔ móu pí","abbr":"yhmp","explanation":"谋：商量。跟老虎商量要剥它的皮。比喻跟恶人商量要他放弃自己的利益，绝对办不到。","source":{"text":"周人有爱裘而好珍羞，欲为千金之裘而与狐谋其皮，欲具少牢之珍而与羊谋其羞，言未卒，狐相率逃于重丘之下，羊相呼藏于深林之中。","book":"晋·苻郎《苻子》"},"example":{"text":"过去与蒋介石谈判，正如陈嘉庚先生在一九四六年打给我的电报中所说，是“无异～”。","book":"周恩来《关于和平谈判问题的报告》"},"similar":["海中捞月","枉费心机","水中捞月"],"opposite":["行之有效","立竿见影"],"usage":"作谓语、宾语、定语；指幻想","story":["传说周朝有人特别喜欢穿皮衣吃精美的食品，他“欲为千金之裘而与狐谋其皮”，狐狸就传警报逃到深山中；“欲具少牢之珍而与羊谋其羞”，羊呼叫同伴一起藏到茂密的森林里去了。结果他没有制成一件皮袍，没有办成羊肉祭祀宴会"]},{"id":2941,"word":"与鬼为邻","pinyin":"yǔ guǐ wéi lín","abbr":"ygwl","explanation":"邻：邻居。与鬼做邻居。形容离死不远了。","source":{"text":"人生七十鬼为邻，已觉风光属别人。","book":"宋·释文莹《湘山野录》卷上"},"example":{"text":"于彼气息奄奄，～者何与焉？","book":"清·梁启超《中国民族主义的奠基人》"},"usage":"作谓语、定语；用于书面语"},{"id":2942,"word":"丑事外扬","pinyin":"chǒu shì wài yáng","abbr":"cswy","explanation":"不光彩、见不得人的事在外面到处传扬。","example":{"text":"我们不希望～。"},"similar":["臭名远扬"],"opposite":["家丑不外扬"],"usage":"作宾语、定语；指出丑"},{"id":2943,"word":"丑人多作怪","pinyin":"chǒu rén duō zuò guài","abbr":"crdzg","explanation":"长相丑陋的人经常做出一些离奇古怪的事来为难别人。","example":{"text":"俗话说：～，一点也没假。"},"usage":"作宾语、定语；用于口语"},{"id":2944,"word":"丑八怪","pinyin":"chǒu bā guài","abbr":"cbg","explanation":"相貌丑陋的人。","example":{"text":"他们都痛恨这些～。"},"usage":"作主语、宾语、定语；用于人或事物等"},{"id":2945,"word":"丑声四溢","pinyin":"chǒu shēng sì yì","abbr":"cssy","explanation":"声：名声；溢：外流。丑恶的名声到处传播。形容臭名远扬。","source":{"text":"案车骑将军义真，凶忍之性，爰自稚弱，咸阳之酷，丑声远播。","book":"《宋书·卢陵孝献王义真传》"}},{"id":2946,"word":"丑声远播","pinyin":"chǒu shēng yuǎn bō","abbr":"csyb","explanation":"坏名声传播得很远。","source":{"text":"咸阳之酷，丑声远播。","book":"《宋书·卢陵孝献王义真传》"},"example":{"text":"他现在已经是～了。"},"similar":["臭名远扬"],"usage":"作谓语、定语；指臭名远扬"},{"id":2947,"word":"丑媳妇免不得见公姑","pinyin":"chǒu xí fù miǎn bù dé jiàn gōng gū","abbr":"cxfmbdjgg","explanation":"公姑：公婆。比喻害怕见人而不得不见人。","source":{"text":"丑媳妇免不得见公姑，缅焉呈面，公姑具眼，是妍是丑，其必有以区别之也。","book":"清·张岱《与祁世培》"},"similar":["丑媳妇少不得见公婆"],"usage":"作宾语、分句、定语；用于口语"},{"id":2948,"word":"丑媳妇少不得见公婆","pinyin":"chǒu xí fù shǎo bù dé jiàn gōng pó","abbr":"cxfsbdjgp","explanation":"比喻害怕见人而不得不见人。","source":{"text":"常言道：‘丑媳妇少不得见公婆。’只得脱袍解带，免冠徒跣，跪于门外。","book":"明·冯梦龙《东周列国志》第97回"},"similar":["丑媳妇免不得见公姑"],"usage":"作宾语、分句、定语；用于口语"},{"id":2949,"word":"丑媳妇总得见公婆","pinyin":"chǒu xí fù zǒng de jiàn gōng pó","abbr":"cxfzdjgp","explanation":"比喻隐藏不住，总要露相。","source":{"text":"丑媳妇总得要见公婆的，索性我自己招罢。","book":"清·李宝嘉《官场现形记》十六回"},"example":{"text":"～，我已经有了心理准备。"},"similar":["丑媳妇少不得见公婆"],"usage":"作宾语、分句、定语；用于口语"},{"id":2950,"word":"丑态尽露","pinyin":"chǒu tài jìn lù","abbr":"ctjl","explanation":"丑恶的形态彻底暴露出来。","source":{"text":"而影响剿说，盖头窃尾，如贫人借富人之衣，庄农作大贾之饰，极力装作做，丑态尽露。","book":"明·唐顺之《荆州文集·答茅鹿门知县》"}},{"id":2951,"word":"丑态毕露","pinyin":"chǒu tài bì lù","abbr":"ctbl","explanation":"毕：完全。丑恶的形态彻底暴露。","source":{"text":"贾琏亦丑态毕露。","book":"清·曹雪芹《红楼梦》第二十一回"},"example":{"text":"若行步蹒跚，～，虽小亦奚以为。","book":"清·钱泳《履园从话·裹足》"},"similar":["原形毕露"],"usage":"作谓语、定语；指人的丑态","story":["贾琏的女儿生病，他离开王熙凤独居寂寞难奈，突然想起酒头厨子多官的媳妇美貌无比、生性轻浮、拈花惹草，就打发小厮去与那娘子一说，她也倾心于贾琏，于是贾琏就去相会，两人像干柴烈火一般热烈地做爱，那媳妇越浪，贾琏越丑态毕露"]},{"id":2952,"word":"丑态百出","pinyin":"chǒu tài bǎi chū","abbr":"ctbc","explanation":"各种丑恶的样子都表现出来了。","source":{"text":"他们那有甚么心事！不过因明日就要放榜，得失心未免过重，以致弄的忽哭忽笑，丑态百出。","book":"清·李汝珍《镜花缘》第66回"},"example":{"text":"却有着一群荒淫无耻的，～的，伤天害理的，穷凶极恶的衣冠禽兽。","book":"徐迟《狂欢之夜》"},"similar":["摇头摆尾","挤眉弄眼","嬉皮笑脸"],"opposite":["威风凛凛"],"usage":"作谓语、定语；用于个人或集体的形象"},{"id":2953,"word":"丑类恶物","pinyin":"chǒu lèi è wù","abbr":"clew","explanation":"指坏人。","source":{"text":"丑类恶物，顽嚣不友。","book":"春秋·鲁·左丘明《左传·文公十八年》"},"example":{"text":"我不喜欢与这帮～交往。"},"usage":"作宾语；指坏人"},{"id":2954,"word":"丑腔恶态","pinyin":"chǒu qiāng è tài","abbr":"cqet","explanation":"卑贱的声调，丑恶的样子。","source":{"text":"赵文华陪着严嵩，抹粉脸席前趋奉，丑腔恶态，演出真鸣凤。","book":"清·孔尚任《桃花扇·骂筵》"}},{"id":2955,"word":"丑话说在前头","pinyin":"chǒu huà shuō zài qián tóu","abbr":"chszqt","explanation":"不中听的话先说出来以免发生矛盾。","example":{"text":"咱们～，只有双方没有意见才能签合同。"},"similar":["丑话说在先"],"usage":"作谓语、分句；用于口语"},{"id":2956,"word":"专一不移","pinyin":"zhuān yī bù yí","abbr":"zyby","explanation":"移：动摇。一心一意，毫不动摇。形容非常专一。","source":{"text":"信者，诚也，专一不移也。","book":"汉·扬雄《法言义疏·修身》"},"example":{"text":"储，诚也，～也。","book":"汉·班固《白虎通·情性》"},"usage":"作谓语、定语、状语；用于处事"},{"id":2957,"word":"专己守残","pinyin":"zhuān jǐ shǒu cán","abbr":"zjsc","explanation":"固执己见，抱残守缺。指囿于派系、门户之成见而不能通权达变。","source":{"text":"今此数家之言，所以兼包大小之义，岂可偏绝哉。若必专己守残，党同门，忌道真，违明昭，失圣意，以陷于文吏之议，甚为二三君子不取也。","book":"《汉书·刘歆传》"}},{"id":2958,"word":"专心一志","pinyin":"zhuān xīn yī zhì","abbr":"zxyz","explanation":"形容一心一意，集中精力。","source":{"text":"今使途之人服术为学，专心一志，思索熟察，加日悬久，积善而不息，则通于神明，参于天地矣。","book":"《荀子·性恶》"},"example":{"text":"教室里，同学们正在～地学习。"},"similar":["专心致志","全神贯注","一心一意"],"opposite":["心猿意马"],"usage":"作谓语、定语；指用心专一"},{"id":2959,"word":"专心一意","pinyin":"zhuān xīn yī yì","abbr":"zxyy","explanation":"形容一心一意，集中精力。","source":{"text":"故管仲相桓公，诎节事君，专心一意。","book":"《荀子·性恶》：“今使途之人服术为学，专心一志，思索熟察，加日悬久，积善而不息，则通于神明，参于天地矣。”汉·陆贾《新语·怀虑》"},"example":{"text":"教室里，同学们正在～地学习。"},"similar":["专心致志"],"opposite":["三心二意"],"usage":"作定语、状语；用于处事"},{"id":2960,"word":"专心一致","pinyin":"zhuān xīn yī zhì","abbr":"zxyz","explanation":"致：尽。把心思全放在上面。形容一心一意，聚精会神。","source":{"text":"夫今弈之为数，小数也，不专心致志，则不得也。","book":"《孟子·告子上》"},"example":{"text":"谁也不说话，～地嗑，比赛似的，一会工夫那条窄窄的走道瓜子皮儿就大雪纷飞。","book":"张抗抗《隐形伴侣》第十六章"},"similar":["专心致志","专心一志","抟心揖志"],"opposite":["三心二意"],"usage":"作谓语、定语、状语；指聚精会神"},{"id":2961,"word":"专心向公","pinyin":"zhuān xīn xiàng gōng","abbr":"zxxg","explanation":"一心为公，不谋私利。","source":{"text":"及在朝，不结交援，专心向公。","book":"《三国志·魏志·杜畿传》"},"similar":["大公无私"],"opposite":["自私自利"],"usage":"作谓语、定语；用于处事"},{"id":2962,"word":"专心致志","pinyin":"zhuān xīn zhì zhì","abbr":"zxzz","explanation":"致：尽，极；志：意志。把心思全放在上面。形容一心一意，聚精会神。","source":{"text":"夫今弈之为数，小数也，不专心致志，则不得也。","book":"《孟子·告子上》"},"example":{"text":"不由我不～搞这一套。","book":"叶圣陶《招魂》"},"similar":["聚精会神","专心一志","一心一意"],"opposite":["心不在焉","心猿意马","魂不守舍"],"usage":"作谓语、定语、状语；指聚精会神","story":["从前，棋坛高手弈秋收了两个学生，他给他们细心讲解和分析，一个学生专心致志地学习，另一个则心不在焉，观察窗外的天鹅。弈秋让两个学生对弈。那个专心致志的学生攻守有序，那个三心二意的学生有招架之功没有还手之力了"]},{"id":2963,"word":"专恣跋扈","pinyin":"zhuān zì bá hù","abbr":"zzbh","explanation":"跋扈：霸道，不讲理。专断蛮横，任意妄为，蛮不讲理。","source":{"text":"頵以行密专恣跋扈，尝移书讽之。","book":"《旧五代史·田頵传》"},"similar":["专权跋扈","专擅跋扈","专横跋扈"],"usage":"作谓语、定语；指蛮不讲理"},{"id":2964,"word":"专擅跋扈","pinyin":"zhuān shàn bá hù","abbr":"zsbh","explanation":"跋扈：霸道，不讲理。形容把持大权，独断专行。","source":{"text":"知中书谒者令显等专权擅势，大作威福，纵恣不制，无所畏忌，为海内患害。","book":"《汉书·王尊传》"},"example":{"text":"惟载垣等前后一切～情形，实属谋危社禝，是皆列祖列宗之罪人，非独欺凌朕躬，为有罪也。","book":"蔡东藩《清史演义》第七十一回"},"similar":["专权跋扈","专恣跋扈","专横跋扈"],"usage":"作谓语、定语；指蛮不讲理"},{"id":2965,"word":"专权恣肆","pinyin":"zhuān quán zì sì","abbr":"zqzs","explanation":"恣肆：放纵。独揽大权，胡作非为。","source":{"text":"会依言，即遣人赍表进赴洛阳，言邓艾专权恣肆，结好蜀人，早晚必反矣。","book":"明·罗贯中《三国演义》第一百十八回"},"example":{"text":"闻得马赛真柔懦，共涛～，君臣不睦。","book":"清·陈忱《水浒后传》第十二回"},"usage":"作谓语、定语；用于处事"},{"id":2966,"word":"专权擅势","pinyin":"zhuān quán shà shì","abbr":"zqss","explanation":"形容把持大权，独断专行。","source":{"text":"知中书谒者令显等专权擅势，大作威福，纵恣不制，无所畏忌，为海内患害。","book":"《汉书·王尊传》"},"example":{"text":"东汉·班固《白虎通义·封公侯》：“为其～，倾覆国家。”"},"similar":["独断专行"],"usage":"作谓语、定语；用于处事"},{"id":2967,"word":"专权误国","pinyin":"zhuān quán wù guó","abbr":"zqwg","explanation":"坏人专权会坑害国家。","source":{"text":"朕久闻其专权误国，今仙机示朕，朕当即为处分，卿不可泄于外人。","book":"明·冯梦龙《喻世明言》卷四十"},"example":{"text":"偏逡见了元帝，极言石显～，触动元帝怒意，斥令退去，反将他降为郎官。","book":"蔡东藩《前汉演义》第八十九回"},"usage":"作谓语、定语；用于书面语"},{"id":2968,"word":"专权跋扈","pinyin":"zhuān quán bá hù","abbr":"zqbh","explanation":"专权：专断蛮横，任意妄为；跋扈：霸道，不讲理。专断蛮横，任意妄为，蛮不讲理。","source":{"text":"帝少而聪慧，知冀骄横，尝朝群臣，目冀曰：‘此跋扈将军也。’","book":"《后汉书·梁冀传》"},"similar":["专横跋扈","专擅跋扈","专恣跋扈"],"usage":"作谓语、定语；指蛮不讲理"},{"id":2969,"word":"专横跋扈","pinyin":"zhuān hèng bá hù","abbr":"zhbh","explanation":"跋扈：霸道，不讲理。专断蛮横，任意妄为，蛮不讲理。","source":{"text":"帝少而聪慧，知冀骄横，尝朝群臣，目冀曰：‘此跋扈将军也。’","book":"《后汉书·梁冀传》"},"example":{"text":"领导者～，就得不到群众的信任和支持。"},"similar":["横行霸道","恣行无忌","肆无忌惮"],"opposite":["彬彬有礼","谦谦君子"],"usage":"作谓语、定语；指蛮不讲理","story":["东汉时期，狂妄自大、凶悍蛮横的大将军梁冀，凭着妹妹是汉顺帝的皇后，不可一世，仅一句话就杀了吕放全家。汉顺帝死后，梁冀不把汉冲帝、汉质帝、汉桓帝他们放在眼里，操纵朝中大权。汉桓帝忍无可忍决心杀死这个专横跋扈的将军"]},{"id":2970,"word":"专欲难成","pinyin":"zhuān yù nán chéng","abbr":"zync","explanation":"专欲：个人欲望。单凭个人意愿，事情难以办成。","source":{"text":"众怒难犯，专欲难成，合二难以安国，危之道也。","book":"《左传·襄公十年》"},"example":{"text":"古人有言：“众怒难犯，～。”沪上罢市，即其见端也。","book":"蔡东藩、许廑父《民国通俗演义》第一０八回"},"usage":"作谓语、宾语、定语；指一厢情愿难以成事"},{"id":2971,"word":"专款专用","pinyin":"zhuān kuǎn zhuān yòng","abbr":"zkzy","explanation":"专门用于指定项目的钱款专项使用。","example":{"text":"我们～，有严格的财务制度。"},"usage":"作谓语、宾语、定语；用于财务制度等"},{"id":2972,"word":"专精覃思","pinyin":"zhuān jīng tán sī","abbr":"zjts","explanation":"覃：深入地。精心专研，深入思考。","source":{"text":"不问生产，不交宾客，专精覃思，无所不通。","book":"《北齐书·冯伟传》"},"example":{"text":"做学问应该～。"},"usage":"作谓语、宾语、定语；指人善于思考"},{"id":2973,"word":"专美于前","pinyin":"zhuān měi yú qián","abbr":"zmyq","explanation":"专美：独享美名。指先于别人独享美名","source":{"text":"左右笔力如川之方至，无使楚汉专美于前，乃副下交之望。","book":"宋·陈亮《复杜伯高》"},"example":{"text":"周恩来《致郑洞国信》：“望与我前线肖劲光、肖华两将军进行接洽，不使吴化文、曾泽生将军专美于前也。”"},"usage":"作谓语、定语；用于书面语"},{"id":2974,"word":"且住为佳","pinyin":"qiě zhù wéi jiā","abbr":"qzwj","explanation":"且：暂且；佳：好。还是暂且住在这里好。多用以劝留客人住下。","source":{"text":"寒食只数日间，得且住为佳耳。","book":"唐·颜真卿《寒食帖》"},"example":{"text":"明日落花寒食，得～耳！","book":"宋·辛弃疾《霜天晓角·旅兴》词"},"usage":"作谓语；用于留客"},{"id":2975,"word":"且听下回分解","pinyin":"qiě tīng xià huí fēn jiě","abbr":"qtxhfj","explanation":"分解：叙述。宋元以来章回小说结束语。","source":{"text":"毕竟史进与三个头领怎地脱身，且听下回分解。","book":"明·施耐庵《水浒传》第二回"},"example":{"text":"昨天又同兼士合写了一封信给孟余他们，可做的事已做，～。","book":"鲁迅《两地书》"},"usage":"作分句；用于说话或小说"},{"id":2976,"word":"且战且走","pinyin":"qiě zhàn qiě zǒu","abbr":"qzqz","explanation":"且：指两件事同时并进；走：逃跑。一边作战，一边逃跑。","source":{"text":"如来日魏兵到，锐气正盛，不可便迎，且战且走。","book":"明·罗贯中《三国演义》第99回"},"example":{"text":"我教国文只为吃饭；教国文不过是～，骑马找马。","book":"老舍《我怎样写》"},"similar":["且战且退"],"usage":"作谓语、定语；指边打边退"},{"id":2977,"word":"且战且退","pinyin":"qiě zhàn qiě tuì","abbr":"qzqt","explanation":"一边作战，一边退却。","source":{"text":"北军奋勇，四门杀出，我军且战且退，诱北军四散离城。","book":"明·施耐庵《水浒传》第98回"},"example":{"text":"我们采取～的战术。"},"similar":["且战且走"],"usage":"作谓语、定语；指边打边退"},{"id":2978,"word":"且食蛤蜊","pinyin":"qiě shí há lí","abbr":"qshl","explanation":"指姑且置之不问。","source":{"text":"融殊不平，谓曰：‘仆出於扶桑，入於汤谷，照耀天下，谁云不知，而卿此问？’昭略云：‘不知许事，且食蛤蜊。’","book":"《南史·王弘传》"},"example":{"text":"一时觥筹交错，谐笑自如，请君～，今夕只谈风月。","book":"清·曾朴《孽海花》第六回"},"usage":"作谓语；用于书面语"},{"id":2979,"word":"世上无难事","pinyin":"shì shàng wú nán shì","abbr":"sswns","explanation":"天下没有难事。","source":{"text":"世上无难事，人心自不坚。","book":"宋·陈元靓《事林广记》第九卷"},"example":{"text":"～，只要肯登攀。","book":"毛泽东《水调歌头·重上井冈山》词"},"usage":"作宾语、分句；常与“只怕有心人”连用"},{"id":2980,"word":"世上无难事，只怕有心人","pinyin":"shì shàng wú nán shì，zhǐ pà yǒu xīn rén","abbr":"sswnszpyxr","explanation":"指只要肯下决心去做，任何困难都能克服。","source":{"text":"祖师道：‘世上无难事，只怕有心人。’","book":"明·吴承恩《西游记》第二回"},"example":{"text":"教师常用“～”这句俗语来鼓励我们克服学习中的困难。"},"similar":["天下无难事，只怕有心人"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":2981,"word":"世世代代","pinyin":"shì shì dài dài","abbr":"ssdd","explanation":"泛指延续的各代。","source":{"text":"提出‘我们必须世世代代地用准确的完整的毛泽东思想来指导我们全党、全军和全国人民，……’","book":"邓小平《“两个凡事”不符合马克思主义》"},"example":{"text":"我们～都会记住你的恩情。"},"similar":["千秋万代","祖祖辈辈"],"usage":"作主语、宾语、定语、状语；泛指延续的各代"},{"id":2982,"word":"世世生生","pinyin":"shì shì shēng shēng","abbr":"ssss","explanation":"指今生、来世以至永世。","source":{"text":"唯愿后身生生世世不复天王作因缘。","book":"《南史·王敬则传》"},"example":{"text":"三则上荐晁天王，早生天界，～，再得相见。","book":"明·施耐庵《水浒全传》第七十回"},"similar":["生生世世","永生永世","世世代代"],"usage":"作宾语、状语；指永生永世"},{"id":2983,"word":"世事洞明","pinyin":"shì shì dòng míng","abbr":"ssdm","explanation":"洞：洞悉，了解；明：明白。对于人世间的各种事情，都看得透彻明白。","source":{"text":"又有一幅对联，写的是‘世事洞明皆学问，人情练达即文章。’","book":"清·曹雪芹《红楼梦》第五回"}},{"id":2984,"word":"世事炎凉","pinyin":"shì shì yán liáng","abbr":"ssyl","explanation":"世事：人情世故；炎：热，亲热；凉：冷淡。指一些人在别人得势时百般奉承，别人失势时就十分冷淡。","source":{"text":"昔趋魏公子，今世霍将军，世态炎凉甚，交情贵贱分。","book":"宋·文天祥《指南录·杜架阁》"}},{"id":2985,"word":"世事纷扰","pinyin":"shì shì fēn rǎo","abbr":"ssfr","explanation":"纷扰：纷乱。形容社会情况混乱。","source":{"text":"今世事纷扰，复有瓦解之势矣。","book":"《三国志·魏志·袁术传》"},"example":{"text":"人间～多诈，人心险恶，你好好地保重吧，我去了。","book":"二月河《雍正皇帝》一○二"},"usage":"作谓语、定语；用于局面等"},{"id":2986,"word":"世人皆知","pinyin":"shì rén jiē zhī","abbr":"srjz","explanation":"世人：所有人。指很多人都知道。","source":{"text":"在中国及其执政党内，干部中大山头不明显，但小山头小圈子则处处存在，世人皆知。","book":"路遥《平凡的世界》第六卷第28章"},"similar":["众所周知","众人周知"],"usage":"作谓语、定语；用于口语"},{"id":2987,"word":"世代书香","pinyin":"shì dài shū xiāng","abbr":"sdsx","explanation":"世世代代都是读书人家。","source":{"text":"林家虽贫到没饭吃，也是世代书香人家，断不肯将他家的人丢给亲戚，落的耻笑。","book":"清·曹雪芹《红楼梦》第57回"},"example":{"text":"跟你谈起郑家的事，你就满口～，家学渊源。","book":"巴金《秋》"},"similar":["书香门第"],"usage":"作定语、宾语；指书香门第"},{"id":2988,"word":"世代相传","pinyin":"shì dài xiāng chuán","abbr":"sdxc","explanation":"祖祖辈辈传下来。","source":{"text":"将来抱个娃娃，子再生孙，孙又生子，绵绵瓜瓞，世代相传，奉祀这座祠堂，才是我公婆的心思，才算姐姐你的孝顺，成全你作个儿女英雄。","book":"清·文康《儿女英雄传》第二十六回"},"example":{"text":"这钢杖重逾三十斤，竹棒却只十余两，但丐帮帮主～的棒法果然精微奥妙。","book":"金庸《射雕英雄传》第二十八回"}},{"id":2989,"word":"世代簪缨","pinyin":"shì dài zān yīng","abbr":"sdzy","explanation":"簪缨：头簪和束发的缨络，古代达官贵人的冠饰。接连几代都是做高官的的仕宦之家。","source":{"text":"久闻公世代簪缨，何不立于庙堂，辅佐天子，乃区区作相府门下一吏乎？","book":"明·罗贯中《三国演义》第六十回"},"example":{"text":"我娘家是大明开国功臣信国公之后，也算得是～之族。","book":"姚雪垠《李自成》第二卷第四十章"},"similar":["官宦世家"],"usage":"作宾语、定语；用于书面语"},{"id":2990,"word":"世俗之见","pinyin":"shì sú zhī jiàn","abbr":"sszj","explanation":"世人的庸俗见解。","source":{"text":"你不要以～衡量穷人，以为他们一点骨气也没有。"},"example":{"text":"这些～不值一谈"},"opposite":["真知灼见"],"usage":"作主语、宾语；用于观点等"},{"id":2991,"word":"世俗之言","pinyin":"shì sú zhī yán","abbr":"sszy","explanation":"指当时社会上流行的一般人的言论、说法。含贬义。","source":{"text":"子之所言，世俗之言也。","book":"《商君书·更法》"},"example":{"text":"今更就～评之：如人死皆有知，则慈母有深爱其子者，一旦化去，独不日日凭人言语托人梦寐存恤之耶？","book":"宋·张载《拾遗》"}},{"id":2992,"word":"世外桃源","pinyin":"shì wài táo yuán","abbr":"swty","explanation":"原指与现实社会隔绝、生活安乐的理想境界。后也指环境幽静生活安逸的地方。借指一种空想的脱离现实斗争的美好世界。","source":{"text":"晋·陶潜《桃花园记》描述的一个与世隔绝，没有遭到祸乱的美好地方。"},"example":{"text":"在这儿，在这～的仙境中，有了人世喧嚣的声音。","book":"杨沫《青春之歌》第一部第三章"},"similar":["洞天福地"],"opposite":["人间地狱"],"usage":"作主语、宾语、定语；指理想世界","story":["东晋文学家陶渊明在《桃花源记》中记载：一个渔夫只身划船进入一山洞，发现一座桃源，这里的居民男耕女织，大人小孩均参加劳动，没有赋税和徭役，人们的关系十分淳朴亲切，到处是一遍安乐祥和的气氛，与外面的世界隔绝"]},{"id":2993,"word":"世家子弟","pinyin":"shì jiā zǐ dì","abbr":"sjzd","explanation":"世家：古代称世代显贵的家族。指门第高，世代做官人家的子弟。","source":{"text":"世家子弟富人或斗鸡走马狗，弋猎博戏，乱齐民。","book":"《汉书·食货志下》"},"example":{"text":"那柳湘莲原系～，读书不成，父母早丧，素性爽侠，不拘细事，酷好耍枪舞剑，赌博吃酒。","book":"清·曹雪芹《红楼梦》第四十七回"}},{"id":2994,"word":"世异时移","pinyin":"shì yì shí yí","abbr":"sysy","explanation":"世、时：社会、时代。异、移：不同、变化。社会变化了，时代不同了。亦作“时移世改”、“时移世异”、“时移俗易”、“时异事殊”。","source":{"text":"殷仲文风流儒雅，海内知名，世异时移，出为东阳太守。","book":"北周·庾信《枯树赋》"},"usage":"作谓语、定语；用于社会变化等"},{"id":2995,"word":"世态人情","pinyin":"shì tài rén qíng","abbr":"strq","explanation":"指社会风尚和为人处世之道。","source":{"text":"南亩耕，东山卧，世态人情经历多。","book":"元·关汉卿《四块玉·闲适》曲"},"example":{"text":"我已经习惯了这儿的～。"},"similar":["人情世故","世道人情"],"usage":"作主语、宾语、定语；指社会状况"},{"id":2996,"word":"世态炎凉","pinyin":"shì tài yán liáng","abbr":"styl","explanation":"世态：人情世故；炎：热，亲热；凉：冷淡。指一些人在别人得势时百般奉承，别人失势时就十分冷淡。","source":{"text":"昔趋魏公子，今世霍将军，世态炎凉甚，交情贵贱分。","book":"宋·文天祥《指南录·杜架阁》"},"example":{"text":"也索把～，心中暗忖。","book":"元·无名氏《冻苏秦》第四折"},"similar":["人情世故"],"opposite":["一如既往","炙手可热"],"usage":"作主语、宾语、定语；指社会现象"},{"id":2997,"word":"世情如纸","pinyin":"shì qíng rú zhǐ","abbr":"sqrz","explanation":"世：社会。比喻社会上人情淡薄。","source":{"text":"世情如纸，只有锦上添花，谁肯雪中送炭？那一半又向那里弄去？","book":"清·文康《儿女英雄传》第九回"},"usage":"作宾语、定语；用于感慨等"},{"id":2998,"word":"世情看冷暖，人面逐高低","pinyin":"shì qíng kàn lěng nuǎn，rén miàn zhú gāo di","abbr":"sqklnrmzgd","explanation":"世情：社会人情；人面：人的脸色。社会人情从人的态度的冷淡或热情可以看出来，人的脸色好坏因对方的地位高低而不同。","source":{"text":"他宿世是夫妻，何须苦折离？世情看冷暖，人面逐高低。","book":"元·刘唐卿《白兔记》第十出"},"example":{"text":"～。吾今日乃知富贵之不可少也。","book":"明·冯梦龙《东周列国志》第九十回"}},{"id":2999,"word":"世扰俗乱","pinyin":"shì rǎo sú luàn","abbr":"srsl","explanation":"社会骚乱，风气败坏。","source":{"text":"世扰俗乱，灾害不绝，遂以破国亡身灭嗣。","book":"汉·王充《论衡·治期》"},"usage":"作谓语、定语；用于局面等"},{"id":3000,"word":"世掌丝纶","pinyin":"shì zhǎng sī lún","abbr":"szsl","explanation":"后中书省代皇帝草拟诏旨，称为掌丝纶。指父子或祖孙相继在中书省任职。","source":{"text":"王言如丝，其出如纶。","book":"《礼记·缁衣》"}},{"id":3001,"word":"世故人情","pinyin":"shì gù rén qíng","abbr":"sgrq","explanation":"为人处世的道理。","source":{"text":"可惜你满腹文章，看不出人情世故。","book":"明·冯梦龙《醒世恒言》卷二十二"}},{"id":3002,"word":"世殊时异","pinyin":"shì shū shí yì","abbr":"sssy","explanation":"世、时：时代；殊、异：不同，差异。指时代不同了。","source":{"text":"又前都尉浩周劝君遣子，乃实朝臣交谋，以此卜君，君果有辞，外引隗嚣遣子不终，内喻窦融守忠而已，世殊时异，人各有心。","book":"三国·魏·曹丕《又报孙权书》"},"example":{"text":"太上贵德，其次立功，～，不得而同。","book":"唐·欧阳询《艺文类聚》卷三十六"}},{"id":3003,"word":"世济其美","pinyin":"shì jì qí měi","abbr":"sjqm","explanation":"指后代继承前代的美德。","source":{"text":"世济其美，后世承前世之美。","book":"《左传·文公十八年》：“世济其美，不陨其名。”孔颖达疏"},"example":{"text":"[宝祐四年十一月诏]：开国以来勋臣之裔，有能～而不世其实禄者，所在州郡以闻。","book":"《宋史·理宗纪四》"},"usage":"作谓语、宾语；用于书面语"},{"id":3004,"word":"世界大同","pinyin":"shì jiè dà tóng","abbr":"sjdt","explanation":"大同：我国古代一些思想家心目中的理想社会。指没有压迫、剥削的平等、自由的社会景象。","source":{"text":"大道之行也，天下为公。选贤与能，讲信修睦。故人不独亲其亲，不独子其子……是故谋团而不兴，盗窃乱贼而不作，故外户而不闭，是谓大同。","book":"《礼记·礼运》"}},{"id":3005,"word":"世禄之家","pinyin":"shì lù zhī jiā","abbr":"slzj","explanation":"世禄：世代享有禄位。世世代代享有禄位的人家。","source":{"text":"世禄之家，鲜克由礼。","book":"《尚书·毕命》"},"example":{"text":"造士之选，匪树私恩；～，宜敦素业。","book":"清·毕沅《续资治通鉴》卷五"}},{"id":3006,"word":"世路荣枯","pinyin":"shì lù róng kū","abbr":"slrk","explanation":"世路：生活道路。世间人事经历的兴盛和衰败。","source":{"text":"从昔勇断抛名后，世路荣枯见几回。","book":"唐·刘禹锡《酬乐天偶题酒瓮见寄》"},"usage":"作宾语、定语；用于书面语"},{"id":3007,"word":"世路风波","pinyin":"shì lù fēng bō","abbr":"slfb","explanation":"世路：生活道路；风波：各种矛盾。指生活中充满各种矛盾。","source":{"text":"家山泉石寻常忆，世路风波子细谙。","book":"唐·白居易《除夜寄微之》"},"example":{"text":"～险，十年一别须臾。人生聚散长如此，相见且欢娱。","book":"宋·欧阳修《圣无忧》词"}},{"id":3008,"word":"世轻世重","pinyin":"shì qīng shì zhòng","abbr":"sqsz","explanation":"世：当世。意思是刑罚要根据当时社会情况确定轻重严宽。","source":{"text":"刑罚世轻世重，惟齐非齐，有伦有要。","book":"《尚书·吕刑》"},"example":{"text":"刑罚～。我朝律例，颁布于顺治三年，酌议于康熙十八年，重刊于雍正三年。","book":"《清史稿·傅鼐传》"}},{"id":3009,"word":"世远年陈","pinyin":"shì yuǎn nián chén","abbr":"sync","explanation":"远：久远；陈：陈旧。年代已经相隔很久远了。"},{"id":3010,"word":"世道人心","pinyin":"shì dào rén xīn","abbr":"sdrx","explanation":"泛指社会的道德风尚和人们的思想情感等。","source":{"text":"所关于世道人心者甚钜，是以载籍虽繁，莫可废也。","book":"《明史·儒林传序》"},"example":{"text":"有一个高僧在沙漠中修行，忽然想到亚历山大府的名妓泰绮思，是一个贻害～的人物。","book":"鲁迅《且介亭杂文二集·“京派”和“海派”》"},"similar":["世道人情"],"usage":"作主语、宾语、定语；指社会风气，人们思想"},{"id":3011,"word":"世道人情","pinyin":"shì dào rén qíng","abbr":"sdrq","explanation":"指社会风尚和为人处世之道。","source":{"text":"南亩耕，东山卧，世态人情经历多。","book":"元·关汉卿《四块玉·闲适》曲"},"similar":["世态人情"],"usage":"作主语、宾语、定语；指社会状况"},{"id":3012,"word":"世道日衰","pinyin":"shì dào rì shuāi","abbr":"sdrs","explanation":"世道：社会风气；日：日益；衰：衰败。社会风气一天天地败落。","source":{"text":"世道日交丧，浇风散淳源。","book":"唐·李白《古风之二十五》"}},{"id":3013,"word":"世道浇漓","pinyin":"shì dào jiāo lí","abbr":"sdjl","explanation":"世道：社会风气；浇漓：指人情淡薄。指社会上人情刻薄冷淡。","source":{"text":"慷慨激昂的人说：‘世道浇漓，人心不古。’","book":"鲁迅《随感录·人心很古》"},"example":{"text":"慷慨激昂的人说，“～，人心不古，国粹将亡，此吾所为仰天扼腕切齿三叹息者也！”","book":"鲁迅《热风·随感录五十八》"},"usage":"作谓语、定语；用于书面语"},{"id":3014,"word":"世间无难事","pinyin":"shì jiān wú nán shì","abbr":"sjwns","explanation":"只要有决心，世间没有难住人的事。","source":{"text":"正是世间无难事，只怕有心人。","book":"明·马佶人《荷花荡》"},"example":{"text":"俗语道得好：“～，只怕有心人。”男子人性，妇人水性，须用些精细工夫，慢慢抟弄他心随意肯。","book":"明·清溪道人《禅真逸史》六回"}},{"id":3015,"word":"世间甲子须臾事","pinyin":"shì jiān jiǎ zǐ xū yú shì","abbr":"sjjzxys","explanation":"世间：人世间；甲子：六十年；须臾：片刻。指六十年是非常短暂的。形容时间流逝得非常快。","source":{"text":"卖药修琴归去迟，山风吹尽桂花枝。世间甲子须臾事，逢著仙人莫看棋。","book":"唐·许浑《送宋处士归山》"}},{"id":3016,"word":"世风不古","pinyin":"shì fēng bù gǔ","abbr":"sfbg","explanation":"世风：社会风气；古：指古朴。社会风气不像古时那样朴实。","example":{"text":"可是～，这个年头儿，还兴得一妻一妾吗？","book":"杨绛《洗澡》第一部第一章"}},{"id":3017,"word":"世风日下","pinyin":"shì fēng rì xià","abbr":"sfrx","explanation":"指社会风气一天不如一天。","source":{"text":"我国世风日下，亲戚尚如此，况友乎？","book":"清·秋瑾《致秋誉章书》"},"example":{"text":"真是人心不同，各如其面！说～，就是～！","book":"欧阳山《苦斗》"},"similar":["每况愈下","人心不古"],"opposite":["欣欣向荣","蒸蒸日上"],"usage":"作谓语、宾语；指社会风气"},{"id":3018,"word":"丘壑泾渭","pinyin":"qiū hè jīng wèi","abbr":"qhjw","explanation":"丘壑：山丘与坑谷；泾渭：泾水和渭水，比喻是非。比喻对事物的高低是非分得清。","source":{"text":"若论心里的丘壑泾渭，颇步熙凤的后尘。","book":"清·曹雪芹《红楼梦》第79回"},"usage":"作宾语、定语；用于比喻句"},{"id":3019,"word":"丘山之功","pinyin":"qiū shān zhī gōng","abbr":"qszg","explanation":"比喻功绩伟大。","source":{"text":"故乃建秋山之功，享不訾之禄。","book":"汉·陈琳《檄吴将校部曲文》"},"example":{"text":"然定公不觉悟，信季孙之计，背贞臣之策，以获拘弱之名，而丧～，不亦惑乎！","book":"《陆贾新语·辨惑第五》"},"opposite":["毛发之功"],"usage":"作宾语；指功劳大"},{"id":3020,"word":"丙吉问牛","pinyin":"bǐng jí wèn niú","abbr":"bjwn","explanation":"看到牛的异常想起天气变化，赞扬官员关心百姓疾苦。","source":{"text":"楚王轼怒蛙，以昆虫之敢死；丙吉问牛，恐阴阳之失时。","book":"明·程登吉《幼学琼林》第四卷"},"example":{"text":"作为官员要像～那样关心百姓疾苦。"},"usage":"作宾语、定语；用于官员","story":["西汉宣帝时期，丞相丙吉十分关心百姓的疾苦，他经常外出考察民情，一次外出，他见一群人在斗殴，他没有去制止，而看到一头牛在吃力地拉车。他却停下叫人去询问，下属说他只重畜不重人，他解释说牛影响农事，直接影响国计民生"]},{"id":3021,"word":"业业兢兢","pinyin":"yè yè jīng jīng","abbr":"yyjj","explanation":"犹兢兢业业。小心谨慎、认真负责貌。","source":{"text":"左辅右弼，前疑后承。一日万机，业业兢兢。","book":"《后汉书·明帝纪赞》：“显宗不承，业业兢兢。危心恭德，政察奸胜。”《晋书·潘尼传》"},"example":{"text":"一日万几，崇高益危，早朝晏罢，～。","book":"康有为《大同书》甲部第三章"},"similar":["业业矜矜","兢兢业业"],"usage":"作谓语、定语；用于书面语"},{"id":3022,"word":"业业矜矜","pinyin":"yè yè jīn jīn","abbr":"yyjj","explanation":"小心谨慎的样子。","source":{"text":"业业矜矜，若履冰谷，思与亿兆，同此维新。","book":"《宋书·明帝纪》"},"similar":["业业兢兢"],"usage":"作谓语、定语；用于书面语"},{"id":3023,"word":"业峻鸿绩","pinyin":"yè jùn hóng jì","abbr":"yjhj","explanation":"功业高，成绩大。","source":{"text":"业峻鸿绩：即业峻绩鸿，功业高，成绩大。","book":"南朝·梁·刘勰《文心雕龙·原道》：“夏后氏兴，业峻鸿绩，九序惟歌，勋德弥缛。”周振甫注"},"similar":["业峻绩鸿"],"usage":"作谓语、定语；用于书面语"},{"id":3024,"word":"业精于勤","pinyin":"yè jīng yú qín","abbr":"yjyq","explanation":"业：学业；精：精通；于：在于；勤：勤奋。学业精深是由勤奋得来的。","source":{"text":"业精于勤，荒于嬉；行成于思，毁于随。","book":"唐·韩愈《进学解》"},"example":{"text":"我们都知道～的道理。"},"similar":["勤奋好学","孜孜不倦"],"opposite":["一曝十寒","好吃懒做"],"usage":"作谓语、定语；形容学业精深在勤奋","story":["唐朝时期，文学家韩愈因为敢于直谏而得罪了皇帝，被贬到潮州去当刺史，后来被调回京担任国子监博士，他上任后教育学生要记住“业精于勤，荒于嬉；行成于思，毁于随。”学生以他的经历来反驳他。他则以司马迁、屈原的例子来教育他们"]},{"id":3025,"word":"业绍箕裘","pinyin":"yè shào jī qiú","abbr":"ysjq","explanation":"绍：继承；箕：畚箕；裘：兽皮袄。比喻能继承父祖的事业。","source":{"text":"窃伏自念，业绍箕裘，家藏坟索，插架之收储，趋庭之问答，其于文献盖遮几焉。","book":"元·马端临《文献通考·序》"},"similar":["克绍箕裘"],"usage":"作谓语、定语；用于书面语"},{"id":3026,"word":"业荒于嬉","pinyin":"yè huāng yú xī","abbr":"yhyx","explanation":"荒：荒废。贪恋玩耍就会荒废学业","source":{"text":"业精于勤，荒于嬉；行成于思，毁于随。","book":"唐·韩愈《进学解》"},"example":{"text":"清·百一居士《壶天录》中卷：“又或有师教不立，～者，则皆足误后生也。”"},"opposite":["业精于勤"],"usage":"作谓语、定语；用于劝诫人"},{"id":3027,"word":"丛兰欲秀，秋风败之","pinyin":"cóng lán yù xiù，qiū fēng bài zhī","abbr":"clyxqfbz","explanation":"兰：兰草；秀：开花；败：衰败。兰草要开花，但秋风使之凋谢。比喻好人做好事而遭坏人陷害。","source":{"text":"日月欲明，浮云蔽之；河水欲清，沙土秽之；丛生欲脩，秋风败之。","book":"《文子·上德》"}},{"id":3028,"word":"丛山峻岭","pinyin":"cóng shān jùn lǐng","abbr":"csjl","explanation":"丛：聚集；竣：高大。无数高大险峻的山岭","source":{"text":"煤矿的空中索道，越过了丛山峻岭。","book":"吴运铎《把一切献给党·在矿井里》"},"example":{"text":"铁路穿过～，来到这个小山村"},"similar":["崇山峻岭","层峦叠嶂"],"usage":"作主语、宾语、定语；指成群的高山"},{"id":3029,"word":"丛轻折轴","pinyin":"cóng qīng zhé zhóu","abbr":"cqzz","explanation":"指即使轻而小的物件，装载多了也可以使车轴折断。","source":{"text":"指即使轻而小的物件，装载多了也可以使车轴折断。"},"example":{"text":"我们应该明白～的道理。"},"similar":["积羽沉舟","群轻折轴"],"usage":"作宾语、定语；用于告诫人"},{"id":3030,"word":"丛雀渊鱼","pinyin":"cóng què yuān yú","abbr":"cqyy","explanation":"比喻不行善政，等于把老百姓赶到敌人方面去。","source":{"text":"为渊驱鱼者，獭也；为丛驱爵（雀）者，鹯也；为汤武驱民者，桀与纣也。","book":"语出《孟子·离娄上》"},"example":{"text":"能办交涉之人日益少，忍辱含垢，民气日靡，～，民心渐去。","book":"郑观应《盛世危言·交涉》"},"similar":["为丛驱雀，为渊驱鱼"],"usage":"作宾语、定语；用于为政等"},{"id":3031,"word":"东一下西一下","pinyin":"dōng yī xià xī yī xià","abbr":"dyxxyx","explanation":"指做事无计划。比喻行动漂忽无定。","source":{"text":"使木板子东一下，西一下，撺这一二百下子。","book":"清·西周生《醒世姻缘传》"},"example":{"text":"做什么事不能～没有定性。"},"usage":"作补语、谓语、状语；指人漂忽无定"},{"id":3032,"word":"东作西成","pinyin":"dōng zuò xī chéng","abbr":"dzxc","explanation":"东作：指春耕；西成：指秋收。指春种秋熟。","source":{"text":"慨自唐虞成周之际，爰宅四时，东作西成，岁月时日，水火土谷，历世不易。","book":"明·沈榜《宛署杂记·宣谕》"}},{"id":3033,"word":"东倒西歪","pinyin":"dōng dǎo xī wāi","abbr":"ddxw","explanation":"指行走不稳，身不由主。也形容物体倾斜不正。","source":{"text":"哎，却原来醉醺醺东倒西歪。","book":"元·曾瑞卿《留鞋记》第二折"},"example":{"text":"子期使侍卫阻之。熊宜僚用手一拉，侍卫～，二人径入殿中。","book":"明·冯梦龙《东周列国志》第八十三回"},"similar":["杂乱无章","一团乱麻"],"opposite":["井井有条","有条不紊"],"usage":"作谓语、定语、状语；指不整齐"},{"id":3034,"word":"东偷西摸","pinyin":"dōng tōu xī mō","abbr":"dtxm","explanation":"指暗中干不正当的事。","source":{"text":"她还是馋猫儿似的东偷西摸。","book":"曾朴《孽海花》第30回"},"example":{"text":"我们不能干～的事情。"},"similar":["小偷小摸"],"usage":"作谓语、宾语、定语；指惯盗"},{"id":3035,"word":"东兔西乌","pinyin":"dōng tù xī wū","abbr":"dtxw","explanation":"兔、乌：古代神话传说中说，月亮里有玉兔，太阳里有三足金乌，所以用乌、兔代表日月。月亮东升，太阳西落。表示时光不断流逝。","source":{"text":"愁高怅远。身世事，但难准。况禁他，东兔西乌相逐，古古今今不问。","book":"宋·吴潜《瑞鹤仙》"},"usage":"作主语、宾语；表示时光不断流逝"},{"id":3036,"word":"东冲西决","pinyin":"dōng chōng xī jué","abbr":"dcxj","explanation":"形容洪水四处冲决泛滥。","source":{"text":"近日治河，乃遏之使不得北，而南入于淮，以便运耳。南行非河之本性，东冲西决，率无宁岁。","book":"清·江藩《汉学师承记·胡渭》"},"usage":"作谓语、定语；用于洪水等"},{"id":3037,"word":"东冲西撞","pinyin":"dōng chōng xī zhuàng","abbr":"dcxz","explanation":"指无把握地四处奔走寻找。","source":{"text":"他带着一班人巧妙地摔开了追击的敌人，东冲西撞，想再追上大队。","book":"杨朔《铁骑兵》"},"similar":["东穿西撞","东奔西撞"],"usage":"作谓语、宾语、状语；指乱撞"},{"id":3038,"word":"东冲西突","pinyin":"dōng chōng xī tū","abbr":"dcxt","explanation":"指四处冲锋突击。","source":{"text":"曹操见云东冲西突，所向无前……奋然大怒，自领左右将士来赶赵云。","book":"《三国演义》第七一回"},"example":{"text":"他（赫胥黎）以渊博的学识，警辟的文章，～，攻陷了以为亚当和夏娃的子孙们的最后的堡垒。","book":"鲁迅《南腔北调集·“论语一年”》"},"similar":["左冲右突","东征西讨"],"usage":"作谓语；形容作战勇猛"},{"id":3039,"word":"东劳西燕","pinyin":"dōng láo xī yàn","abbr":"dlxy","explanation":"劳：伯劳。比喻情侣、朋友离别。","source":{"text":"东飞伯劳西飞燕，黄姑织女时相见。","book":"宋·郭茂倩《乐府诗集·古辞·东飞伯劳歌》"},"example":{"text":"奇了！这人莫不是也要搭西伯利亚铁路去游学，和我们恰做个～么？(梁启超《新中国未来记》第四回"},"usage":"作宾语；比喻离别"},{"id":3040,"word":"东南之宝","pinyin":"dōng nán zhī bǎo","abbr":"dnzb","explanation":"指东南地区的杰出人才。","source":{"text":"张华见褚陶，语陆平原曰：‘君兄弟龙跃云津，顾彦先凤鸣朝阳，谓东南之宝已尽，不意复见褚生！’","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"similar":["东南之美","东南之秀","东南竹箭"],"usage":"作主语、宾语；用于比喻句"},{"id":3041,"word":"东南之秀","pinyin":"dōng nán zhī xiù","abbr":"dnzx","explanation":"指东南地方的杰出人才。","source":{"text":"筠曰：‘陆平原东南之秀，王文度独步江东，吾得比踪昔人，何所多恨。’乃欣然就职。","book":"《南史·王筠传》"},"similar":["东南之美","东南竹箭"],"usage":"作主语、宾语；用于比喻句"},{"id":3042,"word":"东南之美","pinyin":"dōng nán zhī měi","abbr":"dnzm","explanation":"指东南人物中之佼佼者。","source":{"text":"东南之美，曩惟延州；显允陆生，于今鲜俦。","book":"晋·潘尼《赠陆机出为吴王郎中令》"},"example":{"text":"台隍枕夷夏之交，宾主尽～。","book":"唐·王勃《滕王阁序》"},"similar":["东南之宝","东南之秀"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":3043,"word":"东南半壁","pinyin":"dōng nán bàn bì","abbr":"dnbb","explanation":"半壁：半边。指长江中下游及其以东、以南的半边江山。","source":{"text":"金朝那解番狼将，血溅东南半壁天。","book":"元·施君美《幽闺记·虎狼扰乱》"},"example":{"text":"身经百战兵不饥，士气激发倍骁悍。以此克奏保障功，～推屏翰。","book":"清·杭世骏《榕城诗话》下卷引吴廷华诗"},"similar":["半壁河山"],"usage":"作主语、宾语；指长江流域"},{"id":3044,"word":"东南竹箭","pinyin":"dōng nán zhú jiàn","abbr":"dnzj","explanation":"比喻优秀人才。","source":{"text":"东南之美者，有会稽之竹箭焉。","book":"《尔雅·释地》"},"example":{"text":"尔其荆衡杞梓，～，备器用于庙堂者众矣。唯王褒、庚信奇才秀出，牢笼于一代。","book":"《周书·王褒庚信传赞》"},"similar":["东南之秀","东南之宝","东南之美"],"usage":"作主语、宾语；用于比喻句"},{"id":3045,"word":"东南雀飞","pinyin":"dōng nán què fēi","abbr":"dnqf","explanation":"比喻夫妻分离。","source":{"text":"乐府诗《孔雀东南飞》"},"example":{"text":"～，伤心中谷歌有蓷。","book":"清·赢宗季女《六月霜·恤纬》"}},{"id":3046,"word":"东向而望，不见西墙","pinyin":"dōng xiàng ér wàng，bù jiàn xī qiáng","abbr":"dxewbjxq","explanation":"向东面看，看不到西面的墙。比喻主观片面，顾此失彼。","source":{"text":"东面望者，不见西墙；南乡视者，不睹北方，意有所在也。","book":"《吕氏春秋·去尤其》"},"example":{"text":"会己则嗟讽，民我且沮弃，各执一隅之角，欲拟万端之变，所谓～也。","book":"南朝·梁·刘勰《文心雕龙·知音》"}},{"id":3047,"word":"东园秘器","pinyin":"dōng yuán mì qì","abbr":"dymq","explanation":"指皇室、显宦死后用的棺材。","source":{"text":"及至东园秘器，珠襦玉柙，豫以赐贤，无不备具。","book":"《汉书·佞幸传·董贤》"},"example":{"text":"赐物四百叚，米粟四百石，～凶事，给仪杖至墓所往还。","book":"唐·杨炯《中书令汾阳阴公薛振行状》"}},{"id":3048,"word":"东墙处子","pinyin":"dōng qiáng chǔ zǐ","abbr":"dqcz","explanation":"指邻居的处女。","source":{"text":"踰东家墙而搂其处子，则得妻；不搂则不得妻；则将搂之乎？","book":"《孟子·告子下》"},"example":{"text":"第四笑，乡闾辈，更谁将古道誇，盼东墙处子搂来嫁。","book":"明·孙仁孺《东郭记·绵驹》"},"usage":"作宾语；用于少女"},{"id":3049,"word":"东墙窥宋","pinyin":"dōng qiáng quī sòng","abbr":"dqks","explanation":"指美貌女子倾心于男子。","source":{"text":"天下之佳人，莫若楚国；楚国之丽者，莫若臣里；臣里之美者，莫若臣东家之子……然此女登墙窥臣三年，至今未许也。","book":"战国·楚·宋玉《登徒子好色赋》序"},"example":{"text":"悔当日～，有心教夫婿乘龙。见如今天寒地冻，知他共何人陪奉。","book":"元·姚燧《新水令·冬怨》"}},{"id":3050,"word":"东壁余光","pinyin":"dōng bì yú guāng","abbr":"dbyg","explanation":"东邻墙壁上透过来的光。表示对他人有好处而对自己并无损害的照顾或好处。","source":{"text":"臣闻贫人女与富人女会绩，贫人女曰：‘我无以买烛，而子之烛光幸有余，子可分我余光，无损子明，而得一斯便焉。’","book":"《史记·樗里子甘茂列传》"},"example":{"text":"此鄙人所仰借～也。","book":"清·钱谦益《与王内三》"}},{"id":3051,"word":"东声西击","pinyin":"dōng shēng xī jī","abbr":"dsxj","explanation":"犹言声东击西。扬言要攻此方，实际却攻彼方。","source":{"text":"子知战乎……神出鬼没，东声西击，变化而无常者，用也。","book":"明·李东阳《喻战送李永敷南归》"},"similar":["声东击西"],"usage":"作谓语、宾语、定语；用于军事等"},{"id":3052,"word":"东央西告","pinyin":"dōng yāng xī gào","abbr":"dyxg","explanation":"指到处恳求。","source":{"text":"[李甲]口里虽如此说，心中割舍不下，依旧又往外边东央西告，只是夜里不进院门了。","book":"《警世通言·杜十娘怒沉百宝箱》"},"similar":["东央西浼","求爷爷告奶奶"],"usage":"作谓语、宾语、定语；用于处事"},{"id":3053,"word":"东央西浼","pinyin":"dōng yāng xī měi","abbr":"dyxm","explanation":"指到处恳求请托。","source":{"text":"王象荩承主母之命，遵依程公条例，东央西浼，托产行寻售主。","book":"《歧路灯》第八四回"},"similar":["东央西告"],"usage":"作谓语、宾语、定语；用于处事"},{"id":3054,"word":"东奔西向","pinyin":"dōng bēn xī xiàng","abbr":"dbxx","explanation":"指各奔东西，互不相关。","source":{"text":"你也光，我也光，东奔西向，我就养遍濮州城，你也难来拦当。","book":"明·无名氏《苏九淫奔》第二折"},"similar":["各奔东西"],"usage":"作谓语、定语；同“各奔东西”"},{"id":3055,"word":"东奔西撞","pinyin":"dōng bēn xī zhuàng","abbr":"dbxz","explanation":"形容无固定目标，到处乱闯。","source":{"text":"骤然起兵戈，扰攘。卷尘飞，东奔西撞，娇儿拆散知何往？","book":"明·高濂《玉簪记·依亲》"},"example":{"text":"清·无名氏《说呼全传》第16回：“话未说完，禅杖已经飞舞，吓得这些兵将～。”"},"similar":["东穿西撞"],"usage":"作谓语、宾语、状语；指乱撞"},{"id":3056,"word":"东奔西窜","pinyin":"dōng bēn xī cuàn","abbr":"dbxc","explanation":"跑到东，又窜到西。到处逃窜。同“东逃西窜”。","source":{"text":"钱塘县派差去查过，果然那些狗东奔西窜，践踏田禾。","book":"《二十年目睹之怪现状》第六二回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第62回：“钱塘县派差去查过，果然那些狗～，践踏田禾。”"},"similar":["东奔西走","东奔西跑"],"usage":"作谓语、状语；指到处乱跑"},{"id":3057,"word":"东奔西走","pinyin":"dōng bēn xī zǒu","abbr":"dbxz","explanation":"到处奔波。多指为生活所迫或为某一目的四处奔走活动。","source":{"text":"甚年来行役，交情契阔，东奔西走，水送山迎。","book":"元·魏初《沁园春·留别张周卿韵》"},"example":{"text":"强如在中国～，受尽腌臜的气。","book":"清·陈忱《水浒后传》第三十回"},"similar":["东奔西跑","萍踪浪迹","浪迹天涯"],"opposite":["安土重迁","安营扎寨","安家落户"],"usage":"作谓语、定语；指到处奔波"},{"id":3058,"word":"东奔西跑","pinyin":"dōng bēn xī pǎo","abbr":"dbxp","explanation":"到处奔波。多指为生活所迫或为某一目的四处奔走活动。","source":{"text":"甚年来行役，交情契阔，东奔西走，水送山迎。","book":"元·魏初《沁园春·留别张周卿韵》"},"example":{"text":"憔其为退头货，所以在山东河南～。","book":"清·李绿园《歧路灯》第七十九回"},"similar":["东奔西走","东跑西奔"],"usage":"作谓语、状语；指到处奔波"},{"id":3059,"word":"东奔西逃","pinyin":"dōng bēn xī táo","abbr":"dbxt","explanation":"跑到东，又逃到西。到处逃窜。同“东逃西窜”。","source":{"text":"他打过多少次败仗，东奔西逃，最后决定了与汉家和好的大计。","book":"曹禺《王昭君》第二幕"},"example":{"text":"曹禺《王昭君》第二幕：“他打过多少次败仗，～，最后决定了和汉家和好的大计。”"},"similar":["东奔西窜"],"usage":"作谓语、状语；指到处乱跑"},{"id":3060,"word":"东完西缺","pinyin":"dōng wán xī quē","abbr":"dwxq","explanation":"缺东少西，不完备，短缺。","source":{"text":"此中的工作者，刚一动手，必先觉着孤独无助；工具破败，不堪适用，一切技术上的设备，东完西缺。","book":"瞿秋白《赤都心史》三十二"}},{"id":3061,"word":"东家丘","pinyin":"dōng jiā qiū","abbr":"djq","explanation":"丘：孔丘。孔子的西邻不知孔子的学问，称孔子为“东家丘”。指对人缺乏认识，缺乏了解。","source":{"text":"君乃舍之，蹑屣千里，所谓以郑为东家丘者也。","book":"晋·陈寿《三国志·魏志·邴原传》：“原从行，卒。”裴松之注引《邴原别传》"},"usage":"作宾语、定语；用于口语"},{"id":3062,"word":"东家夫子","pinyin":"dōng jiā fū zǐ","abbr":"djfz","explanation":"东家：指东邻。邻家有才德的人。","source":{"text":"北郭先生生已老，东家夫子子为恭。","book":"清·钱谦益《续次敬仲韵》"}},{"id":3063,"word":"东家孔子","pinyin":"dōng jiā kǒng zǐ","abbr":"djkz","explanation":"对孔子的一种称呼。","source":{"text":"东家孔子，至德生于上天。","book":"唐·杨炯《唐右将军魏哲神道碑》"}},{"id":3064,"word":"东家效颦","pinyin":"dōng jiā xiào pín","abbr":"djxp","explanation":"颦：皱眉头。比喻胡乱模仿，效果极坏。","source":{"text":"参见“东施效颦”。"},"example":{"text":"三位太太都十分赞赏。李夫人道：‘我们何不做个～。’","book":"《花月痕》第二二回"},"similar":["东施效颦"],"usage":"作谓语、宾语、定语；指刻意模仿","story":["春秋时期，越国美女西施身材苗条，唇红齿白，十分漂亮，由于有心痛的毛病，犯病时常用手捧心口皱眉头，看起来十分妩媚动人。邻居丑女东施见了也学她那样做，人们见了，觉得东施更加丑陋难看"]},{"id":3065,"word":"东家西舍","pinyin":"dōng jiā xī shě","abbr":"djxs","explanation":"犹言左邻右舍。住在左右前后的街坊邻居。","source":{"text":"东家西舍同时发，北去南来不逾月。未知行李游何方，作个音书能断绝。","book":"唐·李白《江夏行》"},"similar":["左邻右舍","东邻西舍"],"usage":"作主语、宾语、定语；指左右的邻居"},{"id":3066,"word":"东寻西觅","pinyin":"dōng xún xī mì","abbr":"dxxm","explanation":"指到处寻找。","source":{"text":"又来东寻西觅，只恐还在左近，放心不下。","book":"明·罗贯中《平妖传》第十回"},"example":{"text":"心下烦恼，连生意也不去做，终日～，并无尸首下落。","book":"明·冯梦龙《醒世恒言》卷三十四"},"similar":["东搜西罗"],"usage":"作谓语、宾语；指到处张罗"},{"id":3067,"word":"东封西款","pinyin":"dōng fēng xī kuǎn","abbr":"dfxk","explanation":"封：封爵；款：归顺。东边封爵，西边归顺。指边境罢战，修好言和。","source":{"text":"东封西款边功多，江淮陆地生洪波，内库马价支垂尽，民因无力官奈何。","book":"明·袁宏道《逋赋谣》"}},{"id":3068,"word":"东山之志","pinyin":"dōng shān zhī zhì","abbr":"dszz","explanation":"指隐居的念头。","source":{"text":"安虽受朝寄，然东山之志始末不渝，每形于言色。","book":"《晋书·谢安传》"},"example":{"text":"时与风流儒雅之士，置酒高会，吟咏先王遗风，翛然有～。","book":"唐·王维《与工部李侍郎书》"},"usage":"作宾语；指人的志向"},{"id":3069,"word":"东山再起","pinyin":"dōng shān zài qǐ","abbr":"dszq","explanation":"指再度出任要职。也比喻失势之后又重新得势。","source":{"text":"隐居会稽东山，年逾四十复出为桓温司马，累迁中书、司徒等要职，晋室赖以转危为安。","book":"《晋书·谢安传》"},"example":{"text":"回到家乡，先图个骨肉团聚，一面藏器待时，或者圣恩高厚，想起来还有～之日，也未可知。","book":"清·文康《儿女英雄传》第三十九回"},"similar":["重整旗鼓","卷土重来","死灰复燃"],"opposite":["风流云散","一去不返","过眼烟云"],"usage":"作谓语、定语、宾语；指重新得势","story":["东晋时期，贤人谢安坚决辞去官职到会稽附近的东山隐居，经常有文人前来拜访他，与他饮酒赋诗。前秦南侵，东晋危在旦夕，谢安临危授命，当了东晋的宰相，率军在淝水成功打败前秦军队，并趁机率军北伐收复失地"]},{"id":3070,"word":"东山复起","pinyin":"dōng shān fù qǐ","abbr":"dsfq","explanation":"指再度出任要职。也比喻失势之后又重新得势。同“东山再起”。","source":{"text":"悬拟壮猷，东山复起。","book":"明·张煌言《祭建国公郑羽长鸿逵文》"},"example":{"text":"夫子乞养西归，～，物换星移，三十年为一世矣。","book":"清·袁枚《寄房师邓逊斋先生书》"},"similar":["东山再起"],"usage":"作谓语、定语、宾语；指重新得势"},{"id":3071,"word":"东山高卧","pinyin":"dōng shān gāo wò","abbr":"dsgw","explanation":"比喻隐居不仕，生活安闲。","source":{"text":"卿累违朝旨，高卧东山。","book":"《晋书·谢安传》"},"example":{"text":"我，赶不上庞居士海内沉舟，晋孙登苏门长啸，我可甚么谢安石～。","book":"元·郑廷玉《忍字记》第四折"},"similar":["高卧东山"],"opposite":["东山再起"],"usage":"作宾语；指隐居不仕","story":["东晋时期，贤人谢安坚决辞去官职到会稽附近的东山隐居，经常有文人前来拜访他，与他饮酒赋诗，从不过问朝政。前秦南侵，东晋危在旦夕，谢安临危授命，当了东晋的宰相，率军在淝水成功打败前秦军队，并趁机率军北伐收复失地"]},{"id":3072,"word":"东差西误","pinyin":"dōng chà xī wù","abbr":"dcxw","explanation":"指出现这样或那样的差池、错误。形容办事不得力。","source":{"text":"原约一到任所差人进京图干此事，谁知所去的，多不得力。我这里好不盼望，不甫能勾回个信来，定是东差西误的。","book":"《初刻拍案惊奇》卷二五"},"usage":"作宾语、定语；用于办事"},{"id":3073,"word":"东市朝衣","pinyin":"dōng shì cháo yī","abbr":"dscy","explanation":"为朝臣被杀之典。","source":{"text":"《史记·吴王濞列传》、《汉书·晁错传》载：汉景帝时，御史大夫晁错被谗，“衣朝衣斩东市。”"},"example":{"text":"曲江羽扇何须叹，～更不堪。","book":"清·钱谦益《春夜读寄南海陈侍郎》诗"},"usage":"作宾语、定语；用于朝臣被杀"},{"id":3074,"word":"东平之树","pinyin":"dōng píng zhī shù","abbr":"dpzs","explanation":"指人死之后，对故乡的思恋之情亦不泯灭。","source":{"text":"东平思王冢在无盐，人传言王在国思归京师，后葬，其冢上松柏皆西靡也。","book":"三国·魏·刘劭王象《皇览》"},"example":{"text":"游魂冤结，非无广汉之城，久客思归，唯有～。","book":"北周·庾信《周使持节大将军丘乃敦崇传》"}},{"id":3075,"word":"东床之选","pinyin":"dōng chuáng zhī xuǎn","abbr":"dczx","explanation":"指佳婿的人选。","source":{"text":"潜应坦腹之姿，妙契东床之选。","book":"五代·危德兴《寻阳长公主墓志》"},"example":{"text":"众僚属都闻得莫司户青年丧偶，齐声荐他才品非凡，堪作～。","book":"《古今小说·金玉奴棒打薄情郎》"},"similar":["东床择对"],"usage":"作宾语；指选女婿"},{"id":3076,"word":"东床佳婿","pinyin":"dōng chuáng jiā xù","abbr":"dcjx","explanation":"对女婿的美称。同“东床娇婿”。","source":{"text":"他成了总工程师的东床佳婿以来，厂里的那些科长、主任们，对他似乎比过去客气多了。","book":"陈国凯《代价》"},"example":{"text":"陈国凯《代价》：“他成了总工程师的～以来，厂里的那些科长、主任们，对他似乎比过去客气多了。”"},"similar":["东床娇婿"],"usage":"作主语、宾语、定语；指女婿"},{"id":3077,"word":"东床坦腹","pinyin":"dōng chuáng tǎn fù","abbr":"dctf","explanation":"指女婿。","source":{"text":"闻来觅婿，咸自矜持；唯有一郎在东床上坦腹卧，如不闻。","book":"南朝·宋·刘义庆《世说新语·雅量》"},"example":{"text":"我是李府中小姐的保母，因老爷、夫人要聘公子～。","book":"清·褚人获《隋唐演义》第六回"},"similar":["乘龙快婿","东床娇客"],"usage":"作主语、谓语、定语；指女婿","story":["东晋时期，书法家王羲之年轻时很有才华，太尉郗鉴很器重他，想把女儿嫁给他，于是派人向王羲之伯父王导求亲。王导领来人到东厢房去看，只有王羲之独自敞着衣服，露着肚子躺在东床上吃东西。来人回去向郗鉴汇报说东床坦腹的就是"]},{"id":3078,"word":"东床姣婿","pinyin":"dōng chuáng jiāo xù","abbr":"dcjx","explanation":"对女婿的美称。同“东床娇婿”。","source":{"text":"此人名唤孙绍祖，生得相貌魁梧……贾赦见是世交子侄，且人品家当都相称合，遂择为东床姣婿。","book":"《红楼梦》第七九回"},"similar":["东床娇婿","东床娇客"],"usage":"作宾语、定语；指女婿"},{"id":3079,"word":"东床娇婿","pinyin":"dōng chuáng jiāo xù","abbr":"dcjx","explanation":"对女婿的美称。","source":{"text":"东床娇婿实堪怜，况过青春美少年。","book":"《金瓶梅词话》第二十回"},"similar":["东床娇客","东床姣婿"],"usage":"作主语、宾语、定语；指女婿"},{"id":3080,"word":"东床娇客","pinyin":"dōng chuáng jiāo kè","abbr":"dcjk","explanation":"对女婿的美称。同“东床娇婿”。","source":{"text":"东海龙神差老僧来做媒，招你为东床娇客。","book":"元·李好古《张生煮海》第三折"},"example":{"text":"清·钱彩《说岳全传》第35回：“老夫意欲将两个小女，招赘二位为～，未知二位意下若何？”"},"similar":["东床娇婿","东床坦腹","东床姣婿"],"usage":"作宾语、定语；指女婿"},{"id":3081,"word":"东床快婿","pinyin":"dōng chuáng kuài xù","abbr":"dckx","explanation":"指为人豁达，才能出众的女婿。是女婿的美称。","source":{"text":"遣门生与王丞相书，求女婿。……门生归白郗曰：‘王家诸郎，亦皆可嘉，闻来觅婿，咸自矜持，惟有一郎在床上坦腹卧，如不闻。’","book":"南朝·宋·刘义庆《世说新语·雅量》"},"example":{"text":"他就是我的～。"},"similar":["东床坦腹","乘龙快婿"],"usage":"作宾语；指女婿","story":["东晋时期，书法家王羲之年轻时很有才华，太尉郗鉴很器重他，想把女儿嫁给他，于是派人向王羲之伯父王导求亲。王导领来人到东厢房去看，只有王羲之独自敞着衣服，露着肚子躺在东床上吃东西。来人回去向郗鉴汇报说东床坦腹的就是"]},{"id":3082,"word":"东床择对","pinyin":"dōng chuáng zé duì","abbr":"dczd","explanation":"指择婿。","source":{"text":"东床择对，得凤举之名英；中遘冓宣劳，励鸡鸣之至诚。","book":"明·吴承恩《寿胡母牛老夫人秩障词》"},"similar":["东床坦腹","东床娇婿"],"usage":"作宾语、定语；指女婿"},{"id":3083,"word":"东张西张","pinyin":"dōng zhāng xī zhāng","abbr":"dzxz","explanation":"形容这里那里地到处看。同“东张西望”。","source":{"text":"三人挤在一个舱角里，看他们的眼睛，偷偷地东张西张的神气。","book":"方志敏《可爱的中国》"},"similar":["东张西望"],"usage":"作定语、状语；用于人的神态"},{"id":3084,"word":"东张西望","pinyin":"dōng zhāng xī wàng","abbr":"dzxw","explanation":"张：看。形容这里那里地到处看。","source":{"text":"三巧儿只为信了卖卦先生之语，一心只想丈夫回来，从此时常走向前楼，在帘内东张西望。","book":"明·冯梦龙《古今小说》卷一"},"example":{"text":"见范进抱着鸡，手里插个草标，一步一踱的，～，在那里寻人买。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["左顾右盼","三心二意"],"opposite":["一心一意","聚精会神","目不转睛"],"usage":"作谓语、宾语、状语；指乱看","story":["湖广襄阳府枣阳县蒋兴哥娶本县王公女三巧儿，两人十分恩爱，兴哥到广东去收帐，一年多没有回家，三巧儿请算命先生算卦说近日就会回家。她一心盼丈夫回来，每天外出东张西望，却引来青年陈商，最终把蒋兴哥的幸福家庭拆散"]},{"id":3085,"word":"东张西觑","pinyin":"dōng zhāng xī qù","abbr":"dzxq","explanation":"形容这里那里地到处看。同“东张西望”。","source":{"text":"只见前面一个人摇摆将来，见张贡生带了一伙家人东张西觑，料他是个要嫖的勤儿没个帮的人，所以迟疑。","book":"《二刻拍案惊奇》卷四"},"similar":["东张西望","东瞧西望"],"usage":"作谓语、宾语、状语；指乱看"},{"id":3086,"word":"东征西怨","pinyin":"dōng zhēng xī yuàn","abbr":"dzxy","explanation":"本指商汤向一方征伐，则另一方人民埋怨他不先来解救自己。后指帝王兴仁义之师为民除害，深受百姓拥戴。","source":{"text":"惟王不迩声色，不殖货利，德懋懋官，功懋懋赏……东征西夷怨，南征北狄怨。","book":"语出《书·仲虺之诰》"},"example":{"text":"古先哲王，～。顾予不德，重以劳人。","book":"唐·陆贽《重优复兴元府及洋凤州百姓等诏》"},"usage":"作宾语、定语；用于书面语"},{"id":3087,"word":"东征西讨","pinyin":"dōng zhēng xī tǎo","abbr":"dzxt","explanation":"指四面出兵征战讨伐。","source":{"text":"至如出车授钺，东征西讨，孤虚向背，则虽女子之众，可以当于丈夫。","book":"唐·杨炯《左武卫将军成安子崔献行状》"},"example":{"text":"我为国家助成大业，擐甲执锐，垂四十年，～，无复遗恨，第恨汴京下耳！当其勉之。","book":"《元史·木华黎传》"},"similar":["南征北战","转战南北"],"opposite":["安常处顺","安家立业","安营扎寨"],"usage":"作谓语、定语；指战争"},{"id":3088,"word":"东徙西迁","pinyin":"dōng xǐ xī qiān","abbr":"dxxq","explanation":"指四处迁移，漂泊不定。","source":{"text":"但当循分守职，保境睦邻，自无外患。何必东迁西徙，徒取劳瘁。","book":"《明史·西域传二》"},"example":{"text":"窜匿草莽，～，屡濒于危。","book":"清·江藩《汉学师承记》卷八"},"similar":["东迁西徙"],"usage":"作谓语、定语、宾语；指不稳定"},{"id":3089,"word":"东怒西怨","pinyin":"dōng nù xī yuàn","abbr":"dnxy","explanation":"比喻迁怒于人。","source":{"text":"厉色扬声，东怒西怨。","book":"北齐·颜之推《颜氏家训·省事》"},"usage":"作谓语、宾语；指怨恨别人"},{"id":3090,"word":"东怨西怒","pinyin":"dōng yuàn xī nù","abbr":"dyxn","explanation":"指任意指责别人。","source":{"text":"须求趋竞，不顾羞惭，比较材能，斟量功伐，厉色扬声，东怨西怒；或有协持宰相瑕疵，而获酬谢，或有喧聒时人视听，求见发遣；以此得官，谓为才力，何异盗食致饱，窃衣取温哉！","book":"北齐·颜之推《颜氏家训·省事》"},"usage":"作谓语、宾语、定语；用于对人的态度"},{"id":3091,"word":"东扬西荡","pinyin":"dōng yáng xī dàng","abbr":"dyxd","explanation":"指飘泊无定。","source":{"text":"姐姐若不见怜，怎样着落妹子死后魂灵，不至东扬西荡。","book":"《野叟曝言》第四一回"},"similar":["东飘西荡","东飘西泊"],"usage":"作谓语、定语；指不稳定"},{"id":3092,"word":"东扭西捏","pinyin":"dōng niǔ xī niē","abbr":"dnxn","explanation":"扭捏作态，不爽快。","source":{"text":"及至准算与他，又要减你的价钱，准算过，便有几两赢余，要他找绝，他又东扭西捏，朝三暮四，没有得爽利与你。","book":"明·冯梦龙《警世通言》卷三十一"},"similar":["扭扭捏捏","装腔作势"],"usage":"作谓语、定语、状语；用于为人"},{"id":3093,"word":"东扭西歪","pinyin":"dōng niǔ xī wāi","abbr":"dnxw","explanation":"嘴唇不停地做怪样而实际并未说话。","example":{"text":"他急促不清地讲着，嘴唇～而且全身发抖。"},"similar":["东倒西歪"],"usage":"作谓语、状语；指不整齐"},{"id":3094,"word":"东扯葫芦西扯瓢","pinyin":"dōng chě hú lú xī chě piáo","abbr":"dchlxcp","explanation":"说话东扯西拉。","source":{"text":"你少东扯葫芦西扯瓢，抗旱就抗旱，怎么又发癫，想起去查账了。","book":"柯蓝《浏河十八弯》"},"similar":["东扯西拉"],"usage":"作谓语、宾语；指说话没有中心"},{"id":3095,"word":"东扯西拉","pinyin":"dōng chě xī lā","abbr":"dcxl","explanation":"形容说话离题，没有中心。","source":{"text":"制台问了几句话，亏他东扯西拉，居然没有露出马脚。","book":"《官场现形记》第五三回"},"example":{"text":"这批导工会的事是很麻烦的，你得给他详细说说以前的经过情形，不要～的什么英美，什么南洋。","book":"瞿秋白《“矛盾”的继续》"},"similar":["东拉西扯"],"opposite":["有条不紊"],"usage":"作谓语、定语、状语；指说话或文章"},{"id":3096,"word":"东扯西拽","pinyin":"dōng chě xī zhuāi","abbr":"dcxz","explanation":"谓事情互相纠缠。犹言拆东补西。","source":{"text":"别件事，或者有些东扯西拽，东掩西遮，东三西四，不容易说话。","book":"明·冯梦龙《醒世恒言》第七卷"},"example":{"text":"也就～，不能如意。","book":"明·凌濛初《二刻拍案惊奇》第22卷"},"similar":["东扯西拉"],"usage":"作谓语、定语、状语；用于事物或处事"},{"id":3097,"word":"东扶西倒","pinyin":"dōng fú xī dǎo","abbr":"dfxd","explanation":"从这边扶起，却又倒向那边。比喻顾此失彼。也形容坏习气太多，纠正了这一点，那一点又冒头了。","source":{"text":"笑杀槿篱能耐事，东扶西倒野酴醿。","book":"宋·杨万里《过南荡》诗"},"example":{"text":"如破屋相似，～，虽欲修养，亦何能有益邪？","book":"宋·朱熹《朱子语类》第125卷"},"similar":["力不能支"],"usage":"作谓语、定语、状语；形容力不能支"},{"id":3098,"word":"东抄西袭","pinyin":"dōng chāo xī xí","abbr":"dcxx","explanation":"胡乱抄袭别人的文章。","source":{"text":"毓生又会想法，把人家译就的西文书籍，东抄西袭，作为自己译的东文稿子。印出来的，人家看得佩服，就有几位维新朋友慕名来访他。","book":"清·李宝嘉《文明小史》第34回"},"example":{"text":"写文章不能～。"},"usage":"作谓语、定语、宾语；指抄袭别人的作品"},{"id":3099,"word":"东抄西转","pinyin":"dōng chāo xī xhuǎn","abbr":"dcxz","explanation":"转弯抹角，抄近路走。","source":{"text":"又向小巷里东抄西转，也不曾遇着一个。但是问人，都与大街上说话一般，一发把李清弄呆了。","book":"明·冯梦龙《醒世恒言·李道人独步云门》"}},{"id":3100,"word":"东投西窜","pinyin":"dōng tóu xī cuàn","abbr":"dtxc","explanation":"到处奔波。多指为生活所迫或为某一目的四处奔走活动。同“东奔西走”。"},{"id":3101,"word":"东抹西涂","pinyin":"dōng mò xī tú","abbr":"dmxt","explanation":"比喻用笔随便写写画画。后用作自己写作或绘画的谦词。同“东涂西抹”。","source":{"text":"只东抹西涂还肯。两载云萍交谊在，更十行斜墨匆匆印。","book":"清·龚自珍《金缕曲·沈虹桥广文小像题词》词"},"example":{"text":"曾朴《孽海花》第25回：“左手拿着一张白纸，右手握了一根烧残的细柳条，在那里～。”"},"similar":["东涂西抹"],"usage":"作谓语、定语；比喻胡写乱画"},{"id":3102,"word":"东拉西扯","pinyin":"dōng lā xī chě","abbr":"dlxc","explanation":"一会儿说东，一会儿说西。指说话条理斋乱，没有中心。","source":{"text":"更有一种可笑的，肚子里原没有什么，东拉西扯，弄的牛鬼蛇神，还自以为博奥。","book":"清·曹雪芹《红楼梦》第八十二回"},"example":{"text":"倘在学校，谁都可以直冲而入，并无可谈，而～，坐着不走，殊讨厌也。","book":"鲁迅《两地书·九三》"},"similar":["说东道西","谈天说地","海阔天空"],"opposite":["有条不紊","丝丝入扣"],"usage":"作谓语、定语、状语；指说话或文章","story":["贾宝玉住进大观园后，整天不读书，与黛玉、探春、宝钗等女孩一起玩，贾政只好请私塾先生代儒来教他。他还是忙里偷闲来看黛玉，与她东拉西扯，经常打翻了林黛玉的醋罐子。但只要有几天不见面，各自心中又憋不住"]},{"id":3103,"word":"东拦西阻","pinyin":"dōng lán xī zǔ","abbr":"dlxz","explanation":"指极力阻拦。","source":{"text":"众家人听说，忙东拦西阻的教他们止声。","book":"《雪岩外传》第十回"},"example":{"text":"他～地让我放弃这个计划。"},"similar":["百般阻挠"],"opposite":["鼎力相助"],"usage":"作谓语、状语；用于口语"},{"id":3104,"word":"东拼西凑","pinyin":"dōng pīn xī còu","abbr":"dpxc","explanation":"比喻零乱地加以拼凑。","source":{"text":"因是儿子的终身大事所关，说不得东拼西凑，恭恭敬敬封了二十四两贽见礼，带了秦钟到代儒家来拜见。","book":"清·曹雪芹《红楼梦》第八回"},"example":{"text":"当他在半路上，早已～，凑得三千银子，专为监中打点之用。","book":"清·李宝嘉《官场现形记》第二十八回"},"similar":["七拼八凑","东挪西借","东补西凑"],"opposite":["足足有余"],"usage":"作谓语、宾语、状语；指凑集","story":["宝玉请求贾母同意让秦可卿的弟弟秦钟与他一起上学，秦钟十分高兴，就回去与父亲秦业说。秦业见儿子的老师已经去世，这是个好机会，但自己宦囊羞涩，贾府都是富贵眼睛，也只好东拼西凑24两银子，送秦钟到贾府家学房去上学"]},{"id":3105,"word":"东指西画","pinyin":"dōng zhǐ xī huà","abbr":"dzxh","explanation":"指指点点，吩咐指派。","source":{"text":"桂迁东指西画，处分家事，童仆去了一辈又来一辈，也有领差的，也有回话的。说一个不了。","book":"明·冯梦龙《警世通言·桂员外途穷忏悔》"}},{"id":3106,"word":"东挦西扯","pinyin":"dōng xián xī chě","abbr":"dxxc","explanation":"指到处张罗。","source":{"text":"以大不逮之财而日行勉强支持之事，东挦西扯，忧苦莫当。","book":"康有为《大同书》甲部第三章"},"usage":"作谓语、宾语；用于搜罗"},{"id":3107,"word":"东挦西撦","pinyin":"dōng xián xī là","abbr":"dxxc","explanation":"指到处张罗。"},{"id":3108,"word":"东挨西撞","pinyin":"dōng āi xī zhuàng","abbr":"daxz","explanation":"形容无固定目标，到处乱闯。同“东奔西撞”。","source":{"text":"终日间靠着些东涂西抹，东挨西撞，也济不得甚事。","book":"明·凌濛初《初刻拍案惊奇》第一卷"},"example":{"text":"你这样～的是不起任何作用的。"},"similar":["东碰西撞"],"usage":"作谓语、状语；指碰运气"},{"id":3109,"word":"东挨西问","pinyin":"dōng āi xī wèn","abbr":"daxw","explanation":"挨：接近。形容四处打听、寻问。","source":{"text":"这些众人当一场生意，见神见鬼，东挨西问，那有消息。","book":"明·罗贯中《平妖传》第十五回"}},{"id":3110,"word":"东挪西借","pinyin":"dōng nuó xī jiè","abbr":"dnxj","explanation":"指到处挪借款项。","source":{"text":"来京引见的人，有几个腰里常常带着几十万银子？不过也是东挪西借，得了缺再去还人家。","book":"清·李宝嘉《官场现形记》第26回"},"example":{"text":"我～，好不容易才凑够这个数。"},"similar":["东挪西凑"],"usage":"作谓语、宾语、状语；指筹资"},{"id":3111,"word":"东挪西凑","pinyin":"dōng nuó xī còu","abbr":"dnxc","explanation":"指各处挪借，凑集款项。","source":{"text":"过了两月，又近吉日，却又欠迎亲之费，六老只得东挪西凑，寻了几件衣饰之类，往典铺中解了几十两银子，却也不够使用。","book":"明·凌濛初《初刻拍案惊奇》第13卷"},"example":{"text":"不过这样头痛医头，～，总不是办法。","book":"茅盾《子夜》"},"similar":["东挪西借"],"usage":"作谓语、宾语、状语；指筹资"},{"id":3112,"word":"东挪西撮","pinyin":"dōng nuó xī cuō","abbr":"dnxc","explanation":"指各处挪借，凑集款项。同“东挪西凑”。","source":{"text":"我这里正项钱粮，兀自起解不足，东挪西撮。你这项信赏钱，依着我，权且存置库内。","book":"《水浒传》第九四回"},"similar":["东挪西凑","东挪西借"],"usage":"作谓语、宾语、状语；指筹资"},{"id":3113,"word":"东挪西辏","pinyin":"dōng nuó xī còu","abbr":"dnxc","explanation":"挪：挪借；辏：通“凑”，聚合。指各处挪借，凑集款项。","source":{"text":"我命运乖，粮运折，家私都准折，东挪西辏犹还缺，一女多娇，将他来抛撇。","book":"明·沈受先《三元记·归妹》"},"similar":["东挪西借","东挪西凑"],"usage":"作谓语、宾语、状语；用于筹资"},{"id":3114,"word":"东捞西摸","pinyin":"dōng lāo xī mō","abbr":"dlxm","explanation":"指盲目地四处求索。","source":{"text":"盖性命之理虽微，然就博文约礼实事上看，亦甚明白，正不须向无形象处东捞西摸，如捕风系影。","book":"宋·朱德《答廖子晦》"},"usage":"作谓语、宾语；用于处事"},{"id":3115,"word":"东捱西问","pinyin":"dōng ái xī wèn","abbr":"daxw","explanation":"指四处探问、打听。","source":{"text":"这些众人当一场生意，见神见鬼，东捱西问，那有消息。","book":"《平妖传》第十五回"},"usage":"作谓语、宾语；用于打听消息"},{"id":3116,"word":"东推西阻","pinyin":"dōng tuī xī zǔ","abbr":"dtxz","explanation":"推：推诿；阻：阻挠。找各种借口推托、阻挠。","source":{"text":"都氏只是拣精剔肥，东推西阻，媒婆说得丑些，又落得好推。","book":"明·伏雌教主《醋葫芦》第五回"},"similar":["推三阻四"],"usage":"作谓语、宾语；找各种借口推托"},{"id":3117,"word":"东掩西遮","pinyin":"dōng yǎn xī zhē","abbr":"dyxz","explanation":"谓左右遮掩，隐瞒真相。","source":{"text":"别件事，或者有些东扯西拽，东掩西遮，东三西四，不容易说话。这做媒乃是冰人撮合，一天好事。","book":"明·冯梦龙《醒世恒言》卷七"},"similar":["东遮西掩"],"usage":"作谓语、状语；指左右遮掩"},{"id":3118,"word":"东搜西罗","pinyin":"dōng sōu xī luó","abbr":"dsxl","explanation":"指到处寻找与搜集。","source":{"text":"我们所为，原就和你一样，东搜西罗，无非是些绸头布尾，只配用来补补破衲袄罢了。","book":"许地山《空山灵雨·补破衣的老妇人》"},"example":{"text":"他整天都在～，终于拼凑完这篇论文。"},"similar":["东寻西觅"],"usage":"作谓语、定语；指到处搜集"},{"id":3119,"word":"东摇西摆","pinyin":"dōng yáo xī bǎi","abbr":"dyxb","explanation":"形容走路不稳。比喻容易动摇、不坚定。","source":{"text":"我们的某些同志却像一个小脚女人，东摇西摆地在那里走路，老是埋怨旁人说：走快了，走快了。","book":"毛泽东《关于农业合作化问题》"},"example":{"text":"我们在原则性问题上要立场坚定，不能～。"},"similar":["摇摆不定"],"opposite":["纹丝不动"],"usage":"作谓语、定语、状语；指不坚定"},{"id":3120,"word":"东撙西节","pinyin":"dōng zǔn xī jié","abbr":"dzxj","explanation":"指从各方面节省。","source":{"text":"郭沫若《塔·万引》：“他在这样踌蹰时，他的家计却一天一天地逼迫拢来了，亏他的夫人挖肉补疮，东撙西节地还能勉强维持着。“"},"usage":"作宾语、状语；用于生活"},{"id":3121,"word":"东播西流","pinyin":"dōng bō xī liú","abbr":"dbxl","explanation":"指流落四方。","source":{"text":"又闻本朝王公，都人士女，风行雨散，东播西流。","book":"南朝·陈·徐陵《在北齐与扬仆射书》"},"similar":["东流西落"],"usage":"作谓语、宾语、状语；用于生活"},{"id":3122,"word":"东支西吾","pinyin":"dōng zhī xī wú","abbr":"dzxw","explanation":"指说话办事含糊敷衍。","source":{"text":"[妙观]下第三局时，频频以目送情。小道人会意，仍旧东支西吾，让他过去。","book":"《二刻拍案惊奇》卷二"},"similar":["含糊其词"],"usage":"作谓语、定语、状语；用于说话"},{"id":3123,"word":"东敲西逼","pinyin":"dōng qiāo xī bī","abbr":"dqxb","explanation":"各处敲诈逼迫。","source":{"text":"百姓又最怕输粮，地方官刑驱势迫，东敲西逼。","book":"蔡东藩《后汉通俗演义》第二回"},"usage":"作谓语、定语；用于统治"},{"id":3124,"word":"东方不亮西方亮","pinyin":"dōng fāng bù liàng xī fāng liàng","abbr":"dfblxfl","explanation":"比喻这里行不通，别的地方尚有回旋余地。","source":{"text":"中国是一个大国——‘东方不亮西方亮，黑了南方有北方’，不愁没有回旋的余地。","book":"毛泽东《中国革命战争的战略问题》"},"example":{"text":"～，我们不愁找不到出路。"},"usage":"作宾语、定语；用于选择"},{"id":3125,"word":"东方千骑","pinyin":"dōng fāng qiān jì","abbr":"dfqq","explanation":"旧指女子的如意郎君。","source":{"text":"东方千余骑，夫婿居上头。","book":"汉·乐府《陌上桑》诗"},"example":{"text":"～从骊驹，岂不下山逢故夫。","book":"梁·简文帝《采菊篇》诗"},"similar":["如意郎君","东方骑"],"usage":"作宾语；指女子的夫婿","story":["从前漂亮的采桑姑娘罗敷在路上遇到一个行为不轨的太守，太守想调戏她并想拉她回府。罗敷直截了当地告诉他她已经有了丈夫，而且丈夫是一城之长，拥有东方千骑，才貌双全，风度翩翩，深得众人仰慕，请不要再痴心妄想了"]},{"id":3126,"word":"东方圣人","pinyin":"dōng fāng shèng rén","abbr":"dfsr","explanation":"古代对中国德才最高的人的称呼。在不同时代不同情况下所指对象不一样。","source":{"text":"流支读昙谟最《大乘义章》，每弹指赞叹，唱言微妙，即为胡书写之，传之于西域。西域沙门常东向遥礼之，号昙谟最为东方圣人。","book":"北魏·杨衒之《洛阳伽蓝记·融觉寺》"}},{"id":3127,"word":"东方将白","pinyin":"dōng fāng jiāng bái","abbr":"dfjb","explanation":"指天将破晓。"},{"id":3128,"word":"东方骑","pinyin":"dōng fāng jì","abbr":"dfq","explanation":"指女子的如意郎君。也泛指身份煊赫者。","source":{"text":"言是东方骑，来寻南陌车。","book":"唐·褚亮《烛花》诗"},"similar":["东方千骑"],"usage":"作宾语；指女子的夫婿"},{"id":3129,"word":"东施效颦","pinyin":"dōng shī xiào pín","abbr":"dsxp","explanation":"效：仿效；颦：皱眉头。比喻胡乱模仿，效果极坏。","source":{"text":"故西施病心而矉其里，其里之丑人见而美之，归亦捧心而矉其里。其里之富人见之，坚闭门而不出；贫人见之，絜妻子而去之走。","book":"《庄子·天运》"},"example":{"text":"若真也葬花，可谓“～”了，不但不为新奇，而且更是可厌。","book":"清·曹雪芹《红楼梦》第三十回"},"similar":["邯郸学步","照猫画虎","生搬硬套"],"opposite":["独辟蹊径","标新立异","自我作古"],"usage":"作谓语、宾语、定语；指刻意模仿","story":["春秋时期，越国美女西施身材苗条，唇红齿白，十分漂亮，由于有心痛的毛病，犯病时常用手捧心口皱眉头，看起来十分妩媚动人。邻居丑女东施见了也学她那样做，人们见了，觉得东施更加丑陋难看"]},{"id":3130,"word":"东曦既驾","pinyin":"dōng xī jì jià","abbr":"dxjj","explanation":"曦：曦和，神话传说中驾日车的神。指太阳已从东方升起。比喻驱散黑暗，光明已见。","source":{"text":"及期不至，五鼓绝声，东曦既驾，杳无踪迹。","book":"唐·冯翊《桂苑丛谈·崔张自称侠》"}},{"id":3131,"word":"东望西观","pinyin":"dōng wàng xī guān","abbr":"dwxg","explanation":"形容这里那里地到处看。同“东张西望”。","source":{"text":"这边受专心等，东望西观只候临。","book":"《再生缘》第十一回"},"similar":["东张西望","东瞧西望"],"usage":"作谓语、宾语、状语；指乱看"},{"id":3132,"word":"东来紫气","pinyin":"dōng lái zǐ qì","abbr":"dlzq","explanation":"传说老子过函谷关之前，关尹喜见有紫气从东而来，知道将有圣人过关。果然老子骑着青牛而来。旧时比喻吉祥的征兆。同“紫气东来”。","source":{"text":"老子西游，关令尹喜望见有紫气浮关，而老子果乘青牛而过也。","book":"《史记·老子韩非列传》：“［老子］居周久之，见周之衰，乃遂去……莫知其所终”司马贞索隐引汉·刘向《列仙传》"},"example":{"text":"西望瑶池降王母，～满函关。","book":"唐·杜甫《秋兴》诗之五"},"similar":["紫气东来"],"usage":"作宾语、定语；指好兆头"},{"id":3133,"word":"东来西去","pinyin":"dōng lái xī qù","abbr":"dlxq","explanation":"从东边来的，往西边去的。形容人来人往，互不相识。","source":{"text":"东来西去人情薄，不为清阳减路尘。","book":"唐·李商隐《关门柳》"},"example":{"text":"桥上做卖做买，～的，挨挤不过。","book":"明·冯梦龙《喻世明言》卷二十三"},"usage":"作状语；用于人多的场合"},{"id":3134,"word":"东横西倒","pinyin":"dōng héng xī dǎo","abbr":"dhxd","explanation":"形容杂乱。","source":{"text":"回看车中，大家东横西倒，鼾声呼呼。","book":"刘复《晓》诗"},"similar":["东倒西歪","横七竖八"],"opposite":["整整齐齐"],"usage":"作谓语、定语、状语；指不整齐"},{"id":3135,"word":"东歪西倒","pinyin":"dōng wāi xī dǎo","abbr":"dwxd","explanation":"形容身不由己，倾斜不稳。","source":{"text":"日暮挑灯闲徙倚，郎不归来留恋谁家里？及至归来沉醉矣，东歪西倒扶难起。","book":"清·吴趼人《二十年目睹之怪现状》第39回"},"example":{"text":"那个向西的稻草棚屋，好像一个～的老人，蹲在那里。","book":"柳青《创业史》第一部"},"similar":["东倒西歪","横七竖八"],"opposite":["整然有序","整整齐齐"],"usage":"作谓语、定语、状语；指歪斜"},{"id":3136,"word":"东洋大海","pinyin":"dōng yáng dà hǎi","abbr":"dydh","explanation":"东洋：东边的大海。泛指无边无际的大海。","source":{"text":"故尔各人都弄个谋生之道，混饭吃去，把这雄心便抛入东洋大海去了。","book":"《平妖传》第二十九回：“他投东洋大海中去，那里去寻。”清·刘鹗《老残游记》第七回"},"example":{"text":"及至兵入内地，觑便抽身，把那个共枕同衾、追欢买笑的知己抛在～，你道此心如何过得？","book":"《豆棚闲话·范少伯水葬西施》"},"similar":["汪洋大海"],"usage":"作主语、宾语；指大海"},{"id":3137,"word":"东流西上","pinyin":"dōng liú xī shàng","abbr":"dlxs","explanation":"水向东流，人往西走。比喻人们对故乡的思恋。","source":{"text":"宇文泰遣大都督赵贵梁御甲骑二千来赴，乃奉迎。帝谓御曰：‘此水东流，而朕西上，若得重谒洛阳庙，是卿等功也。’帝及左右皆泫涕。","book":"《后魏书·孝武帝纪》"}},{"id":3138,"word":"东流西落","pinyin":"dōng liú xī luò","abbr":"dlxl","explanation":"形容四处流浪，流落四方。","source":{"text":"又闻本朝王公，都人士女，风行雨散，东播西流。","book":"南朝·陈·徐陵《在北齐与杨仆射书》"},"example":{"text":"再从东京一失业下来，只好成为流浪奴隶，～地随着有工做的地方向四处的乡下移动。","book":"郭沫若《鸡之归去来》"},"similar":["东播西流"],"usage":"作谓语、宾语、状语；用于生活"},{"id":3139,"word":"东海扬尘","pinyin":"dōng hǎi yáng chén","abbr":"dhyc","explanation":"大海变陆地，扬起灰尘。比喻世事变化很大。","source":{"text":"麻姑自说云：‘接侍以来，已见东海三为桑田。向到蓬莱，水又浅于往者会时略半也，岂将复还为陵陆乎？’方平笑曰：‘圣人皆言海中复扬尘也。’","book":"晋·葛洪《神仙传·麻姑》"},"example":{"text":"～，唐代之冠裳莫问。","book":"柳亚子《二十世纪大舞台发刊词》"},"similar":["沧海桑田"],"usage":"作谓语、定语；比喻世事巨变","story":["从前仙人王远和麻姑，他们相约到蔡经家去饮酒，王远一行很快就到蔡经家，但没见到麻姑的到来，就派使者去请。麻姑到来说她奉命去巡视蓬莱，已经三次见到东海变成桑田，现在海水又退了一半。王远说东海又要扬起尘土来了"]},{"id":3140,"word":"东海捞针","pinyin":"dōng hǎi lāo zhēn","abbr":"dhlz","explanation":"从大海底下捞取一根针，形容非常难达到目的。","source":{"text":"儿，此生休想同衾枕，要相逢除非东海捞针。","book":"元·柯丹丘《荆钗记·误讣》"},"example":{"text":"你真有幸，遇大德。若是侥幸贪夫，一似～，怎得。","book":"明·胡文焕《群音类选·四德记·待主尝金》"},"similar":["大海捞针"],"usage":"作宾语、定语；指事情难办"},{"id":3141,"word":"东海逝波","pinyin":"dōng hǎi shì bō","abbr":"dhsb","explanation":"东逝大海的波涛。比喻大势已去，无法挽回。","source":{"text":"明·刘若愚《酌中志·内府衙门职掌》；“纵有真心为国、束身自好者，恐亦孤掌难鸣也。东海逝波，其奈之何哉！”"},"usage":"作宾语、定语；多用于比喻句"},{"id":3142,"word":"东海鲸波","pinyin":"dōng hǎi jīng bō","abbr":"dhjb","explanation":"东海上的汹涌波涛。比喻来自东方的侵略。","source":{"text":"东海鲸波谁可靖，只今惜少岳家军。","book":"高珪《岳坟感赋》诗"},"usage":"作宾语、定语；用于书面语"},{"id":3143,"word":"东涂西抹","pinyin":"dōng tú xī mǒ","abbr":"dtxm","explanation":"涂、抹：原喻从事文辞。比喻用笔随便写写画画。","source":{"text":"报道莫贫相！阿婆三五少年时，也曾东涂西抹来。","book":"五代·王定保《唐摭言·慈恩寺题名游赏赋咏杂记》"},"example":{"text":"我从前曾经要学画两笔山水，～的，闹了多少时候，还学不会呢。","book":"清·吴趼人《二十年目睹之怪现状》第三十七回"},"similar":["东抹西涂","擦脂抹粉","胡写乱画"],"opposite":["一丝不苟"],"usage":"作谓语、定语；比喻胡写乱画","story":["唐朝时期，才华出众的薛逢参加科举取中为官，但始终没有被提拔，还是穷困潦倒。一次他骑马上朝，碰巧遇到新科进士放榜，那些新贵在马上不可一世就是不让道。薛逢笑着说：“报道莫贫相！阿婆三五少年时，也曾东涂西抹来。”"]},{"id":3144,"word":"东渐西被","pinyin":"dōng jiàn xī bèi","abbr":"djxb","explanation":"渐：浸渍；被：覆盖。向东浸渍，向西覆盖。指范围逐渐扩大。","source":{"text":"东渐于海，西被于流沙，朔南暨声教，讫于四海。","book":"《尚书·禹贡》"}},{"id":3145,"word":"东游西荡","pinyin":"dōng yóu xī dàng","abbr":"dyxd","explanation":"无所事事，到处闲诳。","source":{"text":"他因没事干管理，东游西荡。","book":"明·吴承恩《西游记》第六回"},"example":{"text":"他～，突然，看见一个新鲜玩艺。","book":"王福仲《小虎子》"},"similar":["东游西逛"],"usage":"作谓语、定语、宾语；指不务正业"},{"id":3146,"word":"东游西逛","pinyin":"dōng yóu xī kuàng","abbr":"dyxg","explanation":"东游游，西逛逛，到处游玩，不务正业。","source":{"text":"他因没事干管理，东游西荡。","book":"明·吴承恩《西游记》第六回"},"example":{"text":"你也应把心事放在工作上啊，不要～的。","book":"草明《姑娘的心事》"},"similar":["东游西荡"],"usage":"作谓语、定语、宾语；指不务正业"},{"id":3147,"word":"东滚西爬","pinyin":"dōng gǔn xī pá","abbr":"dgxp","explanation":"形容溃逃时的狼狈相。","source":{"text":"打得官兵东滚西爬，急忙逃命。","book":"《中国民间故事选·铁金刚》"},"usage":"作谓语、状语；用于溃败"},{"id":3148,"word":"东漂西徒","pinyin":"dōng piāo xī xǐ","abbr":"dpxt","explanation":"徒：迁徒。到处漂泊，迁徒不定。比喻生活不安定，到处迁徒。","source":{"text":"几年间东漂西徒，今日里天教重会，大海船头，果有相撞时。","book":"明·陆采《明珠记·江会》"}},{"id":3149,"word":"东漂西荡","pinyin":"dōng piāo xī dàng","abbr":"dpxd","explanation":"东西漂泊不定。也比喻生活不安定。","source":{"text":"云汴梁买马，不想东漂西荡，将本钱尽行折了。","book":"明·无名氏《苏九淫奔》第一折"},"example":{"text":"今日弄得～，子不认母，节不成节，乐不成乐，自贻伊戚如此。","book":"清·褚人获《隋唐演义》第五十一回"}},{"id":3150,"word":"东猎西渔","pinyin":"dōng liè xī yú","abbr":"dlxy","explanation":"指处处涉猎而不专精。","source":{"text":"凡为读书，东猎西渔，粗知首尾，则为有余。","book":"唐·孙樵《骂僮志》"},"usage":"作谓语、宾语；用于处事"},{"id":3151,"word":"东猜西揣","pinyin":"dōng cāi xī chuāi","abbr":"dcxc","explanation":"指多方猜测。","source":{"text":"然李义山《锦瑟》一篇，宁使后人东猜西揣，聚讼纷纷，而当时绝不多下一注，亦可想见古人之落落大方矣。","book":"清·袁枚《与杨兰坡明府书》"},"usage":"作谓语、宾语；指猜测"},{"id":3152,"word":"东猜西疑","pinyin":"dōng cāi xī yí","abbr":"dcxy","explanation":"指胡乱猜疑。","source":{"text":"当我正在东猜西疑的时候，拖拉机忽然停在我的身旁，柳永慧把我叫上去了。","book":"沙汀《柳永慧》"},"example":{"text":"请不要对我～的。"},"similar":["疑神疑鬼"],"opposite":["毫无疑问"],"usage":"作谓语、定语、状语；指猜疑"},{"id":3153,"word":"东眺西望","pinyin":"dōng tiào xī wàng","abbr":"dtxw","explanation":"眺：向无处看。向东西两面眺望。","source":{"text":"西望陇中，想卧龙之吟；东眺白沙，思凤雏之声。","book":"《晋书·习凿齿传》"}},{"id":3154,"word":"东睃西望","pinyin":"dōng suō xī wàng","abbr":"dsxw","explanation":"形容这里那里地到处看。同“东张西望”。","source":{"text":"程相公此时两只眼睛不够使的，正在东睃西望，又听得那为吆喝：‘吃酪罢！好干酪哇！’","book":"《儿女英雄传》第三八回"},"similar":["东张西望","东瞧西望"],"usage":"作谓语、宾语、状语；指乱看"},{"id":3155,"word":"东瞧西望","pinyin":"dōng qiáo xī wàng","abbr":"dqxw","explanation":"指到处乱看。","source":{"text":"刘老老只听见咯当咯当的响声，很似打锣筛面的一般，不免东瞧西望的。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"他～，像一个特务。"},"similar":["东张西望"],"usage":"作谓语、状语；指乱看"},{"id":3156,"word":"东瞻西望","pinyin":"dōng zhān xī wàng","abbr":"dzxw","explanation":"瞻：观望。向东、向西观望。形容对景色的欣赏。","source":{"text":"东瞻洪井，识曳帛之在兹；西望石宝，见指宝之可拾。","book":"南朝·梁·元帝《庐山碑序》"}},{"id":3157,"word":"东砍西斫","pinyin":"dōng kǎn xī zhuó","abbr":"dkxz","explanation":"斫：用刀斧砍。指东砍西杀，四面激战。","source":{"text":"韩广杀将来，东砍西斫，星流去散，芋续八断。","book":"《秦并六国平话》卷上"}},{"id":3158,"word":"东碰西撞","pinyin":"dōng pèng xī zhuàng","abbr":"dpxz","explanation":"形容无固定目标，到处乱闯。","source":{"text":"刘波好像被困在一条死巷里，他东碰西撞都找不出一个出路。","book":"巴金《火》"},"example":{"text":"他整天～，就是没有成绩。"},"similar":["东奔西撞","东走西撞"],"usage":"作谓语、状语；指乱撞"},{"id":3159,"word":"东磕西撞","pinyin":"dōng kē xī zhuàng","abbr":"dkxz","explanation":"犹言东奔西撞。","source":{"text":"你道这几件事岂是容易做的？这都是要脚奔波，足不沾地的勾当，岂是教书人所为？[汪为露]失了魂的一般东磕西撞。","book":"《醒世姻缘传》第三五回"},"usage":"作谓语、状语；用于处事"},{"id":3160,"word":"东穿西撞","pinyin":"dōng chuān xī zhuàng","abbr":"dcxz","explanation":"形容无固定目标，到处乱闯。同“东奔西撞”。","source":{"text":"次日进城中访察……亦不晓得那张善士住在何处，东穿西撞，但闻街谈巷语，东一堆西一簇，说某家送了几千两，某家送了几百两。","book":"《隋唐演义》第二六回"},"similar":["东奔西撞"],"usage":"作谓语、宾语、状语；指乱撞"},{"id":3161,"word":"东窗事发","pinyin":"dōng chuāng shì fā","abbr":"dcsf","explanation":"比喻阴谋已败露。","source":{"text":"可烦传语夫人，东窗事发矣。","book":"元·孔文卿《东窗事犯》第二折：“吾乃地藏神，化为呆行者，在灵隐寺中，泄漏秦太师东窗事犯。”明·田汝成《西湖游览志馀·佞倖盘荒》"},"example":{"text":"我早间见那做娘的打庆奴，晚间押番归却，打发我出门，莫是“～”？","book":"明·冯梦龙《警世通言》卷二十"},"similar":["露出马脚","破绽百出","原形毕露"],"opposite":["秘而不宣"],"usage":"作谓语、宾语、定语；指阴谋败露","story":["北宋末年，金兵南犯，岳飞、李纲等坚持抗金，奸臣秦桧主张投降，就与夫人在东窗下密谋除掉岳飞。后来以“莫须有”的罪名杀害岳飞。不久秦桧与儿子病死，妻王氏请僧人做法事超度他们，法师说：“太师叫我转告，东窗事发了。”"]},{"id":3162,"word":"东窗事犯","pinyin":"dōng chuāng shì fàn","abbr":"dcsf","explanation":"比喻阴谋已败露。同“东窗事发”。","source":{"text":"吾乃地藏神，化为呆行者，在灵隐寺中，泄漏秦太师东窗事犯。","book":"元·孔文卿《东窗事犯》第二折"},"similar":["东窗事发"],"usage":"作谓语、宾语、定语；指阴谋败露","story":["北宋末年，金兵南犯，岳飞、李纲等坚持抗金，奸臣秦桧主张投降，就与夫人在东窗下密谋除掉岳飞。后来以“莫须有”的罪名杀害岳飞。不久秦桧与儿子病死，妻王氏请僧人做法事超度他们，法师说：“太师叫我转告，东窗事发了。”"]},{"id":3163,"word":"东窗消息","pinyin":"dōng chuāng xiāo xi","abbr":"dcxx","explanation":"指谋害忠良的阴谋诡计。同“东窗计”。","source":{"text":"心事难凭枉致疑，夫人其实好心机，凭此黄柑无后患，东窗消息少人知。","book":"明·无名氏《精忠计·东窗》"},"similar":["东窗计"],"usage":"作宾语、定语；用于诡计"},{"id":3164,"word":"东窗计","pinyin":"dōng chuāng jì","abbr":"dcj","explanation":"指谋害忠良的阴谋诡计。","source":{"text":"建炎南渡多翻覆，泥马逃来御黄屋……东窗计就通和好，鄂王赐死蕲王老。","book":"《剪灯新话·天台访隐录》"},"similar":["东窗消息"],"usage":"作宾语、定语；用于诡计"},{"id":3165,"word":"东窜西跳","pinyin":"dōng cuàn xī tiào","abbr":"dcxt","explanation":"跳来跳去。","example":{"text":"杜鹃鸟在灌木林中～的。"},"similar":["上窜下跳"],"usage":"作谓语；指跳来跳去"},{"id":3166,"word":"东箭南金","pinyin":"dōng jiàn nán jīn","abbr":"djnj","explanation":"东方的竹箭，南方的铜，古时都认为是上品。比喻可宝贵的人才。","source":{"text":"顾实南金，虞惟东箭。","book":"《尔雅·释地》：“东南之美者，有会稽之竹箭焉，西南之美者，有华山之金石焉。”《晋书·虞潭顾众传·赞》"},"example":{"text":"豳笙韶管，请陈众乐以遍观；～，肯入宝山而空返？（清·林则徐《杭嘉湖三群观风告示》）"},"usage":"作主语、宾语；比喻优秀的人才"},{"id":3167,"word":"东翻西倒","pinyin":"dōng fān xī dǎo","abbr":"dfxd","explanation":"四处翻捡搜寻。","source":{"text":"因先入厨房，搜寻食物，那知这庙中，竟无隔宿之粮，东翻西倒，只有一个腌菜坛。","book":"清·夏敬渠《野叟曝言》第四回"},"similar":["翻箱倒柜"],"usage":"作谓语、状语；用于口语"},{"id":3168,"word":"东荡西游","pinyin":"dōng dàng xī yóu","abbr":"ddxy","explanation":"荡：放浪，游荡；游：行走。指到处游荡，不务正业。","source":{"text":"焦赞不肯歇息，邀军校乘着月色，东荡西游。","book":"明·无名氏《杨家将演义》第三卷"},"example":{"text":"他整天～，不干正事。"},"similar":["东游西荡","东游西逛"],"usage":"作谓语、定语；指不务正业"},{"id":3169,"word":"东荡西除","pinyin":"dōng dàng xī chú","abbr":"ddxc","explanation":"指出兵平定各处叛乱。","source":{"text":"佐高皇南征北讨，随诸将东荡西除。","book":"元·无名氏《赚蒯通》第一折"},"example":{"text":"昔日魏武祖皇帝，～，南征北讨，非容易得此天下。","book":"明·罗贯中《三国演义》第一百十九回"},"similar":["东荡西驰","南征北讨"],"usage":"作谓语、宾语、定语；用于征战"},{"id":3170,"word":"东荡西驰","pinyin":"dōng dàng xī chí","abbr":"ddxc","explanation":"指出兵平定各处叛乱。","source":{"text":"佐高皇南征北讨，随诸将东荡西除。","book":"元·无名氏《赚蒯通》第一折"},"example":{"text":"汉王乘那项王火咸阳，弑义帝，降子婴，～的时候，早暗地里间道入关。","book":"清·文康《儿女英雄传》缘起首回"},"similar":["南征北战"],"usage":"作谓语、宾语、定语；用于征战"},{"id":3171,"word":"东藏西躲","pinyin":"dōng cáng xī duǒ","abbr":"dcxd","explanation":"形容为了逃避灾祸而到处躲藏。","source":{"text":"杀的他军兵胆碎魂先丧，一个个哭啼啼东躲西藏，枪刀剑戟都潎样。","book":"明·无名氏《伐晋兴齐》第四折"},"example":{"text":"真亏你领着母亲和一群孩子～的，末一回还要走多少里路，翻一道大岭。","book":"朱自清《给亡妇》"},"similar":["东躲西藏"],"usage":"作谓语、状语；指逃避"},{"id":3172,"word":"东行不见西行利","pinyin":"dōng háng bù jiàn xī háng lì","abbr":"dxbjxxl","explanation":"东行、西行：即东市、西市。指到处赚便宜，牟利。","source":{"text":"老虔婆坐儿不觉立儿饥，甚黑子东行不见西行利，没道理，全不怕咆哮两行公人立。","book":"元·武汉臣《玉壶春》第四折"}},{"id":3173,"word":"东行西步","pinyin":"dōng xíng xī bù","abbr":"dxxb","explanation":"想向东走，却向西迈步。比喻举动失措，不知所向。","source":{"text":"东行西步，失其次舍。","book":"汉·焦延寿《易林·鼎之噬嗑》"}},{"id":3174,"word":"东补西凑","pinyin":"dōng bǔ xī còu","abbr":"dbxc","explanation":"指各处挪借，凑集款项。同“东挪西凑”。","source":{"text":"他东补西凑地为立达筹款子，还得跑北京，跑南京。","book":"朱自清《哀互生》"},"similar":["东拼西凑"],"usage":"作谓语、宾语、状语；指凑集"},{"id":3175,"word":"东西南北","pinyin":"dōng xī nán běi","abbr":"dxnb","explanation":"指四方、到处、各地、普天下或方向；亦指到处飘泊，行踪不定。","source":{"text":"今丘（孔子）也，东西南北之人也。","book":"《左传·襄公二十九年》：“东西南北，谁敢安处。”  《礼记·檀弓上》"},"example":{"text":"后以奔走四方，～，驰驱少暇。","book":"清·黄遵宪《人境庐诗草自序》"},"similar":["东南西北"],"usage":"作主语、宾语、定语；指方向"},{"id":3176,"word":"东西南北人","pinyin":"dōng xi nán běi rén","abbr":"dxnbr","explanation":"指居处无定之人。","source":{"text":"东西南北，言居无常处也。","book":"《礼记·檀弓上》：“孔子既得合葬於防，曰：‘吾闻之，古也墓而不坟。今丘也，东西南北之人也，不可以弗识也。’於是封之，崇四尺。”郑玄注"},"example":{"text":"龙钟还忝二千石，愧尔～。","book":"唐·高適《人日寄杜二拾遗》诗"},"similar":["东西南北客"],"usage":"作主语、宾语；用于游民"},{"id":3177,"word":"东西南北客","pinyin":"dōng xi nán běi kè","abbr":"dxnbk","explanation":"指居处无定之人。","source":{"text":"参见“东西南北人”。"},"example":{"text":"纶巾老子无遗策，长作～。","book":"宋·陈与义《欲离均阳而雨不止书八句寄何子应》诗"},"similar":["东西南北人"],"usage":"作主语、宾语；用于游民"},{"id":3178,"word":"东西南朔","pinyin":"dōng xī nán shuò","abbr":"dxns","explanation":"指居处无定之人。同“东西南北”。"},{"id":3179,"word":"东西易面","pinyin":"dōng xi yì miàn","abbr":"dxym","explanation":"指东西方向颠倒。后比喻是非颠倒，视听淆乱。","source":{"text":"事之適乱，如地形之惑人也，机渐而往，俄而东西易面，人不自知也。故墨子见衢路而哭之，悲一跬而缪千里也。","book":"汉·贾谊《新书·审微》"},"example":{"text":"媢疾之臣相继而居腹之心，其术百变，能使～，人主自为转移而不觉耳。","book":"清·方苞《跋札》"},"similar":["是非颠倒"],"usage":"作宾语、定语；用于处事"},{"id":3180,"word":"东观之殃","pinyin":"dōng guān zhī yāng","abbr":"dgzy","explanation":"孔子任鲁司寇时，杀少正于东观之下。后用以指杀身之祸。","source":{"text":"未睹功业所至，而见东观之殃，身得重罪，不得以寿终。","book":"《孔子家语·始诛》：“孔子为鲁司寇，摄行相事……七日而诛政大夫正卯，戮之于两观之下。”汉·桓宽《盐铁论·颂贤》"},"similar":["杀身之祸"],"usage":"作宾语；指杀身之祸"},{"id":3181,"word":"东观续史","pinyin":"dōng guān xù shǐ","abbr":"dgxs","explanation":"东观：汉代官家藏书的地方。原指汉代女史学家班昭奉诏就东观续成其兄班固没有完成的《汉书》。后用以指女子才学高深。","source":{"text":"扶风曹世叔妻者，同郡班彪之女也，名昭，字惠班，……兄固著《汉书》，其八表及天文志未及竟而卒，和帝诏昭，就东观藏书阁踵而成之。","book":"《后汉书·曹世叔妻传》"}},{"id":3182,"word":"东观西望","pinyin":"dōng guāng xī wàng","abbr":"dgxw","explanation":"观：看；望：向远处看。形容四处观望，察看动静。","source":{"text":"张公也慌张了，东观西望，恐怕有人撞见。","book":"明·冯梦龙《喻世明言》第26卷"},"example":{"text":"他急得～。"},"similar":["东张西望"],"opposite":["聚精会神"],"usage":"作谓语、状语；指观望"},{"id":3183,"word":"东讨西伐","pinyin":"dōng tǎo xī fá","abbr":"dtxf","explanation":"指四面出兵征战讨伐。同“东征西讨”。","source":{"text":"由是南驰北走，东讨西伐，运之无旁，按之无下。","book":"唐·杨炯《唐右将军魏哲神道碑》"},"similar":["东讨西征","东征西讨"],"usage":"作谓语、定语；指战争"},{"id":3184,"word":"东讨西征","pinyin":"dōng tǎo xī zhēng","abbr":"dtxz","explanation":"指四面出兵征战讨伐。同“东征西讨”。","source":{"text":"髫年学剑，卯岁论兵，以身许国，东讨西征。","book":"唐·杨炯《唐昭武校尉曹君神道碑》"},"example":{"text":"便休说站驿难为，则怕你～那时节悔。","book":"元·刘致《新水令·代马诉冤》套曲"},"similar":["东讨西伐","东征西讨"],"usage":"作谓语、定语；指战争"},{"id":3185,"word":"东诓西骗","pinyin":"dōng kuāng xī piàn","abbr":"dkxp","explanation":"指到处说谎话诈骗。","source":{"text":"若论我，半个字也不识。若说道抵换官物、盗使印信，东诓西骗，天下跑魁。","book":"明·无名氏《东篱赏菊》第二折"},"example":{"text":"应二哥，银子便与他，只不叫他打着我的旗儿，在外边～。","book":"明·兰陵笑笑生《金瓶梅词话》第三十八回"},"similar":["东诳西骗"],"usage":"作谓语、宾语、定语；用于欺骗"},{"id":3186,"word":"东诳西骗","pinyin":"dōng kuāng xī piàn","abbr":"dkxp","explanation":"诳：欺骗，迷惑。形容到处说谎欺骗。","source":{"text":"应二哥，银子便与他，只不叫他打着我的旗儿，在外边东诳西骗。","book":"明·兰陵笑笑生《金瓶梅词话》第38回"},"example":{"text":"他靠～谋生。"},"similar":["东诓西骗"],"usage":"作谓语、宾语、定语；用于欺骗"},{"id":3187,"word":"东谈西说","pinyin":"dōng tán xī shuō","abbr":"dtxs","explanation":"指议论的面很宽。","source":{"text":"近来东谈西说，而其实都无深研究，发议论是不对的。","book":"鲁迅《书信集·致金肇野》"},"example":{"text":"请不要在这儿～。"},"similar":["谈东说西"],"usage":"作谓语、宾语；指谈东说西"},{"id":3188,"word":"东走西撞","pinyin":"dōng zǒu xī zhuàng","abbr":"dzxz","explanation":"四处乱闯乱碰。","source":{"text":"闻你不是好人，东走西撞，无事不为，今来我东岳庙则甚？","book":"明·余象斗《南游记》"},"similar":["东碰西撞"],"usage":"作谓语、状语；指乱撞"},{"id":3189,"word":"东走西顾","pinyin":"dōng zǒu xī gù","abbr":"dzxg","explanation":"比喻顾虑多。","source":{"text":"茕茕白兔，东走西顾。","book":"《古诗源》卷三"},"usage":"作谓语、状语；用于处事"},{"id":3190,"word":"东趋西步","pinyin":"dōng qū xī bù","abbr":"dqxb","explanation":"指相背而行。","source":{"text":"二人异路，东趋西步，千里之外，不相知处。","book":"汉·焦赣《易林·比之损》"},"similar":["背道而驰"],"usage":"作宾语、定语；用于处事"},{"id":3191,"word":"东跑西奔","pinyin":"dōng pǎo xī bēn","abbr":"dpxb","explanation":"奔：急走，跑。指到处奔波。","source":{"text":"玉厚参加了村里给解放军送粮的运输队，同时还得种地，东跑西奔，忙忙乱乱。","book":"路遥《平凡的世界》第一卷第八章"},"similar":["东奔西跑"],"usage":"作谓语、状语；指到处奔波"},{"id":3192,"word":"东跑西颠","pinyin":"dōng pǎo xī diān","abbr":"dpxd","explanation":"比喻到处奔走。","source":{"text":"他和他的那个组，打地，评等级，品好赖，劈青苗，东跑西颠，整整地忙了五天。","book":"周立波《暴风骤雨》第一部十四"},"example":{"text":"我每天～，替他四处揽活，或者去送做好的活计。","book":"杨朔《红花草》"},"similar":["东奔西走"],"usage":"作谓语、状语；比喻到处奔跑"},{"id":3193,"word":"东踅西倒","pinyin":"dōng xué xī dǎo","abbr":"dxxd","explanation":"形容行走艰难。","source":{"text":"看俺这曲脊是腰，手颤头摇，言语刁骚，衣履鏖糟，行动处东踅西倒，一步低一步高。","book":"明·冯惟敏《新水令·庚午春试笔》套曲"},"usage":"作谓语、状语；用于走路"},{"id":3194,"word":"东躲西藏","pinyin":"dōng duǒ xī cáng","abbr":"ddxc","explanation":"形容为了逃避灾祸而到处躲藏。","source":{"text":"杀的他军兵胆碎魂先丧，一个个哭啼啼东躲西藏，枪刀剑戟都潎样。","book":"明·无名氏《伐晋兴齐》第四折"},"example":{"text":"凤仙拽开弹弓，连珠打出，打得喽啰～。","book":"清·石昆玉《三侠五义》第九十八回"},"similar":["东藏西躲"],"usage":"作谓语、状语；指藏匿"},{"id":3195,"word":"东躲西跑","pinyin":"dōng duǒ xī pǎo","abbr":"ddxp","explanation":"躲：躲藏，避开。形容四处逃散，分头躲藏。形容极为惊慌。","source":{"text":"这番遇了秦叔宝，里外夹攻，杀得东躲西跑，南奔北窜。","book":"清·褚人获《隋唐演义》第五回"},"example":{"text":"他被打得～的。"},"similar":["东躲西藏","东躲西逃"],"usage":"作谓语、状语；指惊慌"},{"id":3196,"word":"东躲西逃","pinyin":"dōng duǒ xī táo","abbr":"ddxt","explanation":"躲：躲藏，避开。形容四处逃散，分头躲藏。形容极为惊慌。","source":{"text":"这公子左冲右突，那番兵东躲西逃，直杀透番营。","book":"清·钱彩《说岳全传》第42回"},"example":{"text":"清·无名氏《说呼全传》第37回：“后来晓得庞妃还要加害，只得～。”"},"similar":["东躲西跑"],"usage":"作谓语、状语；指惊慌"},{"id":3197,"word":"东迁西徙","pinyin":"dōng qiān xī xǐ","abbr":"dqxx","explanation":"指四处迁移，居止不定。","source":{"text":"尔居沙州三十年……但当循分守职，保境睦邻，自无外患。何必东迁西徙，徒取劳瘁。","book":"《明史西域传二·沙州卫》"},"similar":["东飘西徙","东徙西迁"],"usage":"作谓语、定语、宾语；指不稳定"},{"id":3198,"word":"东逃西窜","pinyin":"dōng táo xī càn","abbr":"dtxc","explanation":"四处奔逃躲避。","source":{"text":"夫妻两口，凄凄惶惶，东逃西窜，胡乱的过了几年。","book":"明·冯梦龙《醒世恒言》卷三"},"example":{"text":"失魂者～，象龙游浅水，虎入深林。","book":"明·徐渭《英烈传》第六十六回"},"similar":["落荒而逃"],"opposite":["乘胜追击"],"usage":"作谓语、状语；指逃窜"},{"id":3199,"word":"东道主","pinyin":"dōng dào zhǔ","abbr":"ddz","explanation":"泛指接待或宴客的主人。","source":{"text":"若舍郑以为东道主，行李之往来，共其乏困，君亦无所害。","book":"春秋·鲁·左丘明《左传·僖公三十年》"},"example":{"text":"做为～，一面忙着欢送即将出征的子弟兵，还一面忙着接应、招待这些来自各个村庄的乡亲们。","book":"郭澄清《大刀记》第20章"},"similar":["东道主人"],"usage":"作主语、宾语；指主人","story":["春秋时期，晋国公子重耳重回国执政，为报复郑国与秦国联合出兵伐郑。郑文公派烛之武去劝秦穆公退兵，说郑国与秦国不相连，让郑国作为秦国的东道主去对付晋国，牵制晋国对秦国有好处。秦穆公认为有道理就立即撤军"]},{"id":3200,"word":"东道主人","pinyin":"dōng dào zhǔ rén","abbr":"ddzr","explanation":"泛指接待或宴客的主人。同“东道主”。","source":{"text":"令亲人蔡儁作牧河济，厚相恩赡，以为东道主人。","book":"《周书·文帝纪上》"},"example":{"text":"我虽不能做诗，这些诗人竟不厌俗，容我做个～。","book":"《红楼梦》第三七回"},"similar":["东道主"],"usage":"作主语、宾语、定语；指主人"},{"id":3201,"word":"东道之谊","pinyin":"dōng dào zhī yì","abbr":"ddzy","explanation":"东道：主人。谊：情谊。指主人的情谊。","source":{"text":"到了西湖，随便到岸上小酌一顿，化上头两块钱，便算请过了他，尽了东道之谊。","book":"清·李宝嘉《官场现形记》第18回"},"example":{"text":"欢迎你来海南，让我来尽～。"},"similar":["地主之谊"],"usage":"作宾语；用于接待外地朋友"},{"id":3202,"word":"东遮西掩","pinyin":"dōng zhē xī yǎn","abbr":"dzxy","explanation":"指左右遮掩，隐瞒真相。","source":{"text":"我想陈妙常与我侄儿，两下青春佳丽，意气相投，每每月下星前，事事东遮西掩。","book":"明·高濂《玉簪记·促试》"},"example":{"text":"这件事情是～不住的。"},"similar":["遮遮掩掩","东掩西遮"],"usage":"作谓语、状语；指左右遮掩"},{"id":3203,"word":"东邻西舍","pinyin":"dōng lín xī shè","abbr":"dlxs","explanation":"住在左右前后的街坊邻居。","source":{"text":"东邻西舍花发尽，共惜余芳泪满衣。","book":"唐·戴叔伦《女耕田行》"},"example":{"text":"那些～听得哭声，都来观看。","book":"明·冯梦龙《醒世恒言》第二十九卷"},"similar":["左邻右舍"],"usage":"作主语、宾语、定语；指左右的邻居"},{"id":3204,"word":"东郭之迹","pinyin":"dōng guō zhī jì","abbr":"dgzj","explanation":"指鞋破底漏，足迹印地。形容非常穷困、窘迫。","source":{"text":"东郭先生久待诏公车，贫困饥寒，衣敝，履不完。行雪中，履有上无下，足尽践地，道中人笑之。","book":"《史记·滑稽列传》"},"example":{"text":"萧功曹颖士、赵员外骅，开元中同居兴敬里肄业，共有一靴。久而见～。赵曰：“可谓疲于道路矣。”","book":"宋·王谠《唐语林·补遗一》"}},{"id":3205,"word":"东郭先生","pinyin":"dōng guō xiān shēng","abbr":"dgxs","explanation":"泛指对坏人讲仁慈的糊涂人。","source":{"text":"明·马中锡《中山狼传》讲东郭先生救助中山狼，反而几乎被狼所害的故事"},"example":{"text":"你知道～的故事吗？"},"similar":["好好先生"],"usage":"作主语、宾语；比喻不分善恶的人","story":["春秋时期，晋国大夫赵简子在中山举行狩猎，遇到一只狼就拼命追赶。狼遇到东郭先生说：“先生能借你的口袋让我苟延残喘躲一会，躲过这场灾难，我会报答你的大恩的。”东郭先生帮助了狼。后来狼安全跳出布袋扑向东郭先生咬去"]},{"id":3206,"word":"东野巴人","pinyin":"dōng yě bā rén","abbr":"dybr","explanation":"古代楚国民间通俗歌曲，又称《下里巴人》。","source":{"text":"客有歌于郢中都中，其始曰《下里巴人》也。","book":"汉·陈琳《答东阿王笺》：“夫听《白雪》之音，观《绿水》之节，然后《东野巴人》，蚩鄙益著。”吕延济注：“东野，下里之音。”宋玉以问曰"}},{"id":3207,"word":"东野败驾","pinyin":"dōng yě bài jià","abbr":"dybj","explanation":"比喻自恃才高，弄巧成拙。","source":{"text":"春秋时善御者东野稷见重于鲁庄公。其御左右旋转，合规之圆；进退抑扬，中绳之直。自矜其能，驱马转百圈而不止，结果马力竭尽，以失败而告终。"}},{"id":3208,"word":"东量西折","pinyin":"dōng liáng xī zhé","abbr":"dlxs","explanation":"量：称量；折：亏损。在量入量出时，难免有所亏损。","source":{"text":"相公，小人招不得，自古道：东量西折，难教小人赔偿。","book":"明·高明《琵琶记·义仓赈济》"},"usage":"作宾语、定语；用于书面语"},{"id":3209,"word":"东门之役","pinyin":"dōng mén zhī yì","abbr":"dmzy","explanation":"指旧仇。","source":{"text":"郑人侵卫牧，以报东门之役。","book":"《左传·隐公五年》"}},{"id":3210,"word":"东门之达","pinyin":"dōng mén zhī dá","abbr":"dmzd","explanation":"东门：指东门吴。指东门吴丧失爱子而胸怀旷达。后泛指丧失亲人而能心胸宽广，想得开。","source":{"text":"梁人有东门吴者，其子死而不忧。其相室曰：‘公之爱子也天下无有，今子死不忧，何也？’东门吴曰：‘吾尝无子，无子之时不忧，今子死，乃即与无子时同也，臣奚忧焉。’","book":"《战国策·秦策三》"},"example":{"text":"王夷甫悼子，悲不自胜，异～也。","book":"北齐·颜之推《颜氏家训·勉学》"}},{"id":3211,"word":"东门种瓜","pinyin":"dōng mén zhòng guā","abbr":"dmzg","explanation":"原指秦东陵侯召平在秦灭亡后不仕新主，在长安东青门外种瓜。借指离官隐居务农。也比喻富贵的人后来贫困潦倒。","source":{"text":"召平者，故秦东陵侯。秦破，为布衣，贫，种瓜于长安城东。","book":"《史记·萧相国世家》"}},{"id":3212,"word":"东门逐兔","pinyin":"dōng mén zhú tù","abbr":"dmzt","explanation":"用以作为为官遭祸，抽身悔迟之典。同“东门黄犬”。","source":{"text":"吾欲与若复牵黄犬俱出上蔡东门逐狡兔，岂可得乎！","book":"《史记·李斯列传》载：秦二世二年七月，丞相李斯因遭奸人诬陷，论腰斩咸阳市。临刑谓其中子曰"},"example":{"text":"南海骑麟真漫浪，～枉悲酸。","book":"清·钱谦益《次韵何慈公岁暮感事》之二"},"similar":["东门黄犬"],"usage":"作宾语、定语；指人后悔","story":["秦朝末年，丞相李斯被诬以谋反的罪名入狱，秦二世派宦官赵高去审理他的案子。赵高本来与李斯有仇，便乘机把他的家族和宾客全部抓了起来，屈打成招被判死刑，李斯十分后悔从政，在被行刑前对次子说多想与他牵着黄狗到上蔡东门外去猎兔子"]},{"id":3213,"word":"东门黄犬","pinyin":"dōng mén huáng quǎn","abbr":"dmhq","explanation":"用以作为为官遭祸，抽身悔迟之典。","source":{"text":"吾欲与若复牵黄犬俱出上蔡东门逐狡兔，岂可得乎！","book":"《史记·李斯列传》载：秦二世二年七月，丞相李斯因遭奸人诬陷，论腰斩咸阳市。临刑谓其中子曰"},"example":{"text":"～，固以长悲；南阳白衣，何可复得！","book":"南朝·陈·徐陵《梁贞阳侯重与王太尉书》"},"similar":["东门逐兔"],"usage":"作宾语、定语；指人后悔","story":["秦朝末年，丞相李斯被诬以谋反的罪名入狱，秦二世派宦官赵高去审理他的案子。赵高本来与李斯有仇，便乘机把他的家族和宾客全部抓了起来，屈打成招被判死刑，李斯在行刑前对次子说多想与他牵着黄狗到上蔡东门外去打猎"]},{"id":3214,"word":"东闪西挪","pinyin":"dōng shǎn xī nuó","abbr":"dsxn","explanation":"形容有所畏惧，躲躲闪闪。","source":{"text":"褚一官平日在泰山跟前还有个东闪西挪，到了他的娘子跟前，却是从来说一不二。","book":"《儿女英雄传》第四十回"},"similar":["东闪西躲","躲躲闪闪"],"usage":"作谓语、宾语；用于处事"},{"id":3215,"word":"东闪西躲","pinyin":"dōng shǎn xī duǒ","abbr":"dsxd","explanation":"闪：侧身急避；躲：躲避。形容四处躲避。","source":{"text":"李逵在林木丛中东闪西躲。","book":"明·施耐庵《水浒传》第61回"},"similar":["东闪西挪","东躲西藏"],"usage":"作谓语、宾语；用于处事","story":["宋江担任梁山泊主帅后，军师吴用给他推荐北京的卢俊义，他们用计诱使卢俊义上山。卢俊义到梁山泊追赶李逵，李逵东闪西躲，最后骗卢俊义到山上，卢坚决不落草。宋江等又用计谋放卢俊义下山，卢俊义回到北京就被官府捉拿"]},{"id":3216,"word":"东闯西走","pinyin":"dōng chuǎng xī zǒu","abbr":"dcxz","explanation":"指没有目的和方向地四处闯荡。","source":{"text":"都是你这老不贤，养这祸根，终日纵他性子，任他东闯西走，惹祸招非，如今弄出事来了。","book":"清·吴璿《飞龙全传》第二回"}},{"id":3217,"word":"东闯西踱","pinyin":"dōng chuǎng xī duó","abbr":"dcxd","explanation":"指盲目地四处闯荡。","source":{"text":"他很想跑开，但想到不吴芝生作伴，到底比起独自东闯西踱较为‘有聊’，便又舍不得走。","book":"茅盾《子夜》六"},"similar":["东游西荡"],"usage":"作谓语；指游荡"},{"id":3218,"word":"东阁待贤","pinyin":"dōng gé dài xián","abbr":"dgdx","explanation":"特地开东门接待贤人。","source":{"text":"于是起客馆，开东阁以延贤人，与参谋议。","book":"东汉·班固《汉书·公孙弘传》"},"usage":"作宾语、定语；指爱惜人才","story":["汉武帝时期，朝廷大臣为了建功立业，推举贤良担任官职，平民出身的公孙弘被任命为丞相。他为官清廉，功劳卓著，特地在自家庭院的东边开一个小门，造了房舍供宾客居住，广招贤人，让他们为国献计献策，共商国事"]},{"id":3219,"word":"东隅已逝，桑榆非晚","pinyin":"dōng yú yǐ shì，sāng yú fēi wǎn","abbr":"dyyssyfw","explanation":"东隅：指日出处，表示早年。桑榆：指日落处，表示晚年。早年的时光消逝，如果珍惜时光，发愤图强，晚年并不晚。","source":{"text":"北海虽赊，扶摇可接；东隅已逝，桑榆非晚。","book":"唐·王勃《滕王阁序》"}},{"id":3220,"word":"东零西散","pinyin":"dōng líng xī sàn","abbr":"dlxs","explanation":"这边一个，那边一个。形容星散零落。","source":{"text":"曾未几何，而东零西散，念方既已下世，先兄继之，射堂秋月，有若隔世，人生会合，何可常也。","book":"明·袁宏道《致萧允升庶子》"},"example":{"text":"一霎时，十万余兵，杀得～，止剩得一个空寨。","book":"清·古吴墨浪子《西湖佳话·钱塘霸迹》"},"similar":["东零西落"],"usage":"作定语、状语；用于状态"},{"id":3221,"word":"东零西碎","pinyin":"dōng líng xī suì","abbr":"dlxs","explanation":"指零碎，分散，不集中。","source":{"text":"他们把他们父亲的财产东零西碎地铺满了一堂，没有丝毫处理的手腕。","book":"郭沫若《文艺论集·自然与艺术》"},"example":{"text":"我不喜欢这些～的东西。"},"similar":["东零西散"],"usage":"作定语、状语；指零碎"},{"id":3222,"word":"东零西落","pinyin":"dōng líng xī luò","abbr":"dlxl","explanation":"这边一个，那边一个。形容星散零落。","source":{"text":"还说道不降曹，到如今越气恼，受女纳金多快乐，将恩义顿然抛调，撇得俺弟兄每，东零西落。","book":"明·胡文焕《群音类选·桃园记·古城聚会》"},"example":{"text":"出车站空场上，远远就看见～的房屋，战争时烧毁的建筑，残石剩础，凄然的哀诉资本主义的破产呢。","book":"瞿秋白《俄乡纪程》十"},"similar":["东零西散"],"usage":"作定语、状语；用于状态"},{"id":3223,"word":"东风人面","pinyin":"dōng fēng rén miàn","abbr":"dfrm","explanation":"指一年一度的春风依旧，而当年邂逅含情之人却不得重见。","source":{"text":"去年今日此门中，人面桃花相映红。人面不知何处去，桃花依旧笑春风。","book":"唐·崔护《题都城南庄》诗"},"example":{"text":"迨素秋过访，询知其迁徒梧江，～，未尝不有崔护当年之感云。","book":"清·缪艮《珠江名花小传》卷三"}},{"id":3224,"word":"东风入律","pinyin":"dōng fēng rù lù","abbr":"dfrl","explanation":"春风和煦，律韵协调。常用以称赞太平盛世。","source":{"text":"臣国去此三十万里，国有常占，东风入律，百旬不休，青云干品，连月不散者，当知中国时有好道之君。","book":"《海内十洲记·聚窟洲》"},"example":{"text":"而玉環楛矢，夷裘风驾，南翚表贶，～，光乎上德，奚远弗臻。","book":"《晋书·地理志上》"}},{"id":3225,"word":"东风化雨","pinyin":"dōng fēng huà yǔ","abbr":"dfhy","explanation":"指适宜于草木生长的风雨。比喻良好的薰陶和教育。","source":{"text":"有如时春风雨化之者。","book":"《孟子·尽心上》"}},{"id":3226,"word":"东风压倒西风","pinyin":"dōng fēng yā dǎo xī fēng","abbr":"dfydxf","explanation":"原指封建大家庭里对立的两方，一方压倒另一方。现比喻革命力量对于反动势力占压倒的优势。","source":{"text":"但凡家庭之事，不是东风压了西风，就是西风压了东风。","book":"清·曹雪芹《红楼梦》第82回"},"example":{"text":"我认为目前形势的特点是～。","book":"毛泽东《在各国共产党和工人党莫斯科会议上的讲话》"},"similar":["邪不压正"],"usage":"作宾语、定语；比喻正义战胜邪恶","story":["贾宝玉上学后，袭人在家无所事事，想起晴雯之死，不免兔死狐悲起来，如果宝玉娶了厉害的正妻，自己就成了尤二姐了。她跑到林黛玉那里探听风声，林黛玉感慨地说：“但凡家庭之事，不是东风压了西风，就是西风压了东风。”"]},{"id":3227,"word":"东风吹马耳","pinyin":"dōng fēng chuī mǎ ěr","abbr":"dfcme","explanation":"风吹过马耳边。比喻把别人的话当作耳边风。","source":{"text":"世人闻此皆掉头，有如东风射马耳。","book":"唐·李白《答王十二寒夜独钓有怀》诗"},"example":{"text":"我当初劝谏你多少来，你就当～，反被旁人说我是苛待侍妾的，今日你可省得了。","book":"清·黄小配《廿载繁华梦》第四十回"},"similar":["当耳边风","漫不经心","无动于衷"],"usage":"作宾语、定语；指漠不关心"},{"id":3228,"word":"东风射马耳","pinyin":"dōng fēng shè mǎ ěr","abbr":"dfsme","explanation":"射：射出。比喻把别人的话当作耳边风，充耳不闻，无动于衷。","source":{"text":"世人闻此皆掉头，有如东风射马耳。","book":"唐·李白《答王十二寒夜独酌有怀》诗"},"example":{"text":"我的话对你来说还不是～了。"},"similar":["东风吹马耳","无动于衷"],"opposite":["关怀备至"],"usage":"作宾语、定语；指漠不关心"},{"id":3229,"word":"东风浩荡","pinyin":"dōng fēng hào dàng","abbr":"dfhd","explanation":"东风：春风。指吹着强劲的春风。形容春风吹拂大地，大地即将万象更新，面貌焕然。","source":{"text":"浩荡东风里，裴回无所亲。危城三面水，古树一边春。","book":"唐·李咸用《春日》"},"example":{"text":"宋·陆游《剑南诗稿·感兴》：“一尊且作寻春汁，又见东风～时。”"}},{"id":3230,"word":"东风过耳","pinyin":"dōng fēng guò ěr","abbr":"dfge","explanation":"比喻把别人的话当作耳边风，充耳不闻，无动于衷。同“东风射马耳”。","source":{"text":"学生在美国……绝无敬师之礼，对于新监督之训，若东风之过耳。","book":"清·容闳《西学东渐记》"},"similar":["东风吹马耳","东风射马耳"],"usage":"作宾语、定语；指漠不关心"},{"id":3231,"word":"东风马耳","pinyin":"dōng fēng mǎ ěr","abbr":"dfme","explanation":"比喻把别人的话当作耳边风。","source":{"text":"世人闻此皆掉头，有如东风射马耳。","book":"唐·李白《答王十二寒夜独钓有怀》诗"},"example":{"text":"我当初劝谏你多少来，你就当东风吹马耳，反被旁人说我是苛待妾的，今日你可省得了！","book":"清·黄小配《廿载繁华梦》第四十回"}},{"id":3232,"word":"东飘西徙","pinyin":"dōng piāo xī xǐ","abbr":"dpxx","explanation":"指到处漂流，迁徙无定。","source":{"text":"几年间东飘西徙，今日里天教重会。大海船头，果有相撞时。","book":"明·陆采《明珠记·江会》"},"similar":["东飘西泊","东飘西荡","东扬西荡"],"usage":"作谓语、定语；指不稳定"},{"id":3233,"word":"东飘西泊","pinyin":"dōng piāo xī bó","abbr":"dpxb","explanation":"指四处漂泊，行踪无定。","source":{"text":"车夫道：‘只有一人想该斗得他过。’徐槐听了，忙问是何人？车夫道：‘这人姓颜，名叫树德……向来东飘西泊，不知住处。","book":"《荡寇志》第一一二回"},"similar":["东飘西荡","东飘西徙"],"usage":"作谓语、定语；指不稳定"},{"id":3234,"word":"东飘西荡","pinyin":"dōng piāo xī dàng","abbr":"dpxd","explanation":"指不固定，没有着落。也指无定向地漂浮。","source":{"text":"去汴梁买马，不想东飘西荡，将本钱尽行折了。","book":"明·无名氏《苏九淫奔》第一折"},"example":{"text":"两个人连忙用力把船稳住，但是船依旧～。","book":"巴金《家》"},"similar":["东飘西泊","东飘西徙"],"usage":"作谓语、定语；指不稳定"},{"id":3235,"word":"东食西宿","pinyin":"dōng shí xī sù","abbr":"dsxs","explanation":"比喻贪婪的人各方面的好处都要。","source":{"text":"俗说齐人有女，二人求之。东家子丑而富，西家子好而贫。父母疑不能决，问其女，定所欲适。……女便两袒，怪问其故。云：‘欲东家食，西家宿。’","book":"汉·应邵《风俗通》"},"example":{"text":"“～”，廉者当不如是，马亦自笑无以对。","book":"清·蒲松龄《聊斋志异·黄英》"},"similar":["唯利是图","贪得无厌"],"usage":"作谓语、定语；比喻唯利是图，贪得无厌","story":["齐国有一个年轻貌美的女子，东西两家公子同时来求婚，东家公子很富有但相貌丑陋，西家公子是一个英俊的穷书生，姑娘的父母很为难，叫姑娘自己定夺，她说两个都愿意嫁，白天在东家吃饭，晚上去西家睡觉"]},{"id":3236,"word":"东驰西击","pinyin":"dōng chí xī jī","abbr":"dcxj","explanation":"指指挥不统一，几路军队各自行动。","source":{"text":"各专责成，互相援应，毋东驰西击，各不相顾。","book":"清·魏源《圣武记》卷九"},"usage":"作谓语、宾语；指不一致"},{"id":3237,"word":"东驰西撞","pinyin":"dōng chí xī zhuàng","abbr":"dcxz","explanation":"形容无固定目标，到处乱闯。同“东奔西撞”。","source":{"text":"那马东驰西撞，不可押勒。","book":"《花月痕》第四七回"},"similar":["东奔西撞"],"usage":"作谓语、宾语、状语；指乱撞"},{"id":3238,"word":"东驰西骋","pinyin":"dōng chí xī chěng","abbr":"dcxc","explanation":"到处奔波。多指为生活所迫或为某一目的四处奔走活动。同“东奔西走”。","source":{"text":"电传消息，或两国议和，交涉问题，而调查员东驰西骋，察其人心舆论，以知其彼此方针。","book":"清·贯公《拒约须急设“机关日报”议》"},"similar":["东奔西走"],"usage":"作谓语、状语；指四处奔波"},{"id":3239,"word":"东鳞西爪","pinyin":"dōng lín xī zhǎo","abbr":"dlxz","explanation":"原指画龙时龙体被云遮住，只是东边画一片龙鳞，西边露一只龙爪，不见龙的全身。比喻零星片段的事物。","source":{"text":"东云一鳞焉，西云一爪焉，使后世求之而皆在，或皆不在。","book":"清·龚自珍《识某大令集尾》"},"example":{"text":"苏东坡有一首诗好像就是在这凌云山上做的，我只～地记得几节。","book":"郭沫若《少年时代·我的童年》"},"similar":["一鳞半爪","缺头少尾","支离破碎"],"opposite":["浑然一体","包罗万象"],"usage":"作定语、状语；比喻零散不全"},{"id":3240,"word":"东鸣西应","pinyin":"dōng míng xī yīng","abbr":"dmxy","explanation":"指各方面互有联系，互相影响。","source":{"text":"海通以来……自一缕一针之细故，以至政治风俗之大端，无不东鸣西应，速于邮命。","book":"蔡元培《欧美国学会丛刊发刊词》"},"usage":"作宾语、定语；用于事物间"},{"id":3241,"word":"丝丝入扣","pinyin":"sī sī rù kòu","abbr":"ssrk","explanation":"丝丝：每一根丝；扣：织机上的主要机件之一。织布时每条丝线都要从筘齿间穿过。比喻做得十分细致，有条不紊，一一合拍。","source":{"text":"此为丝丝入扣，暗中抛索，如道家所云三神山舟不得近，近者辄被风引回也。","book":"清·夏敬渠《野叟曝言》第二十七回"},"example":{"text":"而那些曲折微妙的声口，也～，千载如出。（朱自清《经典常谈·战国策第八》）"},"similar":["环环相扣","有条不紊"],"opposite":["一团乱麻","乱成一团"],"usage":"作谓语、补语、状语；指有条不紊"},{"id":3242,"word":"丝分缕析","pinyin":"sī fēn lǚ xī","abbr":"sflx","explanation":"细致而有条理的分析。同“丝分缕解”。","source":{"text":"振鹏妙于界画，运笔和墨，丝分缕析，左右高下，俯仰曲折，方员平直，曲尽其体，而神气飞动，不为法拘。","book":"清·王士禛《池北偶谈·谈艺三·王振鹏》"},"similar":["丝分缕解"],"usage":"作宾语、定语；用于比喻句"},{"id":3243,"word":"丝分缕解","pinyin":"sī fēn lǚ jiě","abbr":"sflj","explanation":"细致而有条理的分析。","source":{"text":"尝谓读千载之书而探千载之迹，必须尽见当时事理，如身履其间，丝分缕解，始终备尽，乃可以置议论。","book":"宋·赵令畤《侯鲭录》卷五"},"similar":["丝分缕析"],"usage":"作宾语、定语；用于比喻句"},{"id":3244,"word":"丝发之功","pinyin":"sī fà zhī gōng","abbr":"sfzg","explanation":"微小的功劳。","source":{"text":"父子一门，兼爱恩宠，不能输写心力，以效丝发之功。","book":"汉·蔡邕《上汉书十志疏》"},"usage":"作宾语；用于书面语"},{"id":3245,"word":"丝恩发怨","pinyin":"sī ēn fà yuàn","abbr":"sefy","explanation":"丝、发：形容细小。形容极细小的恩怨。","source":{"text":"是时李训、郑注连逐三相，威震天下。于是平生丝恩发怨无不报者。","book":"《资治通鉴·唐纪·文宗太和九年》"},"usage":"作宾语；指极细小的恩怨"},{"id":3246,"word":"丝来线去","pinyin":"sī lái xiàn qù","abbr":"slxq","explanation":"比喻纠缠连挂。","source":{"text":"但颜子得圣人说一句，直是倾肠倒肚是了，更无许多廉纤缠绕，丝来线去。","book":"《朱子全书·论语》"},"usage":"作谓语、定语；指往来密切"},{"id":3247,"word":"丝析发解","pinyin":"sī xī fà jiě","abbr":"sxfj","explanation":"比喻细密而有条理地分析剖解。","source":{"text":"参以伊洛大儒传注之说，丝析发解，日攻月较，不故求为异，而亦不苟为同。","book":"明·宋濂《汪先生墓志铭》"},"usage":"作宾语、定语；用于书面语"},{"id":3248,"word":"丝毫不差","pinyin":"sī háo bù chà","abbr":"shbc","explanation":"丝毫：都是微小的计量单位，用来形容极小或很小。形容一点也不欠缺。","source":{"text":"于是以阳惠朗为太市令，暨慧景为尚书金、仓都令史，二人家本小吏，考校簿领，纤毫不差；然皆不达大体，督责苛碎，聚敛无厌，士民嗟怨。","book":"《资治通鉴·陈纪·长城公下至德二年》"},"example":{"text":"手指一起，作势往兄长腰中点去，姿式劲道，与师伯所传～。","book":"金庸《神雕侠侣》第十二回"}},{"id":3249,"word":"丝毫不爽","pinyin":"sī háo bù shuǎng","abbr":"shbs","explanation":"丝毫：都是微小的计量单位，用来形容极小或很小。形容一点也不欠缺。","source":{"text":"木人密运化机，丝毫不爽。石女全提空印，文彩未彰。","book":"宋·释普济《五灯会元》卷十四"},"example":{"text":"可见天道好还，～。","book":"明·冯梦龙《醒世恒言》卷三十六"},"similar":["丝毫不差","毫厘不差","纤毫不爽"],"opposite":["天差地别"],"usage":"作谓语、定语；用于书面语"},{"id":3250,"word":"丝竹之音","pinyin":"sī zhú zhī yīn","abbr":"szzy","explanation":"丝竹：弦乐和管乐，泛指音乐。指音乐的声音。","source":{"text":"材女乐三千人，钟石丝竹之音不绝。","book":"春秋·齐·管仲《管子·七臣七主》"},"example":{"text":"月明时，有～。","book":"宋·陆游《入蜀论》"},"usage":"作宾语；指音乐"},{"id":3251,"word":"丝竹八音","pinyin":"sī zhú bā yīn","abbr":"szby","explanation":"丝竹：弦乐和管乐，泛指音乐；八音：金、石、丝、木、竹、匏、土、革等八种乐器。指音乐。","source":{"text":"夔善钟律，聪思过人，丝竹八音，靡所不能。","book":"晋·陈寿《三国志·魏志·杜夔传》"},"usage":"作主语、宾语；用于音乐等"},{"id":3252,"word":"丝竹管弦","pinyin":"sī zhú guǎn xián","abbr":"szgx","explanation":"丝：指弦乐器；竹：指管乐器。琴瑟箫笛等乐器的总称。也指音乐。","source":{"text":"虽无丝竹管弦之盛，一觞一咏，亦足以畅叙幽情。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"～韵悠扬，歌喉宛转何清越。","book":"李木庵《秧歌舞吟》诗"},"usage":"作主语、宾语、定语；指乐器"},{"id":3253,"word":"丝竹陶写","pinyin":"sī zhú táo xiě","abbr":"sztx","explanation":"丝：指弦乐器；竹：指管乐器；陶写：陶冶性情。用音乐来陶冶性情。","source":{"text":"年在桑榆，自然至此，正赖丝竹陶写，恒恐儿辈觉，损欣乐之趣。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"正须～，尽胜渠、槌拍事枯禅。","book":"元·张雨《木兰花慢》词"}},{"id":3254,"word":"丝纷栉比","pinyin":"sī fēn zhì bǐ","abbr":"sfzb","explanation":"像丝一样纷繁，像梳齿一样排列。形容纷繁罗列。","source":{"text":"纂组异闻，网罗轶事，猥琐赘余，丝纷栉比，一经奇见而色飞，偶尔艳聆而绝倒。","book":"清·李斗《扬州画舫录·桥东录》"},"usage":"作宾语、定语；用于书面语"},{"id":3255,"word":"丝绣平原","pinyin":"sī xiù píng yuán","abbr":"sxpy","explanation":"平原：指战国时赵国的平原君赵胜，门下有食客数千人。用丝线来绣平原君。原表示对平原君极其钦慕。后也表示感激别人的恩惠。","source":{"text":"买丝绣作平原君，有酒惟浇赵州土。","book":"唐·李贺《浩歌》"},"example":{"text":"不须买～，不用黄金铸子期。","book":"元·吴师道《吴礼部诗话》"}},{"id":3256,"word":"丢三忘四","pinyin":"diu sān wàng sì","abbr":"dsws","explanation":"形容做事马虎粗心，不是丢了这个，就是忘了那个。同“丢三落四”。","source":{"text":"我如今竟糊涂了！丢三忘四，惹人抱怨，竟不大像先了。","book":"《红楼梦》第七二回"},"example":{"text":"她经常～，打坏东西，青稞在锅里炒糊了，牛乳挤不干净，甚至割着草会把刀丢了。","book":"刘克《央金》"},"similar":["丢三落四"],"opposite":["一丝不苟"],"usage":"作宾语、定语；指粗心"},{"id":3257,"word":"丢三拉四","pinyin":"diu sān lā sì","abbr":"dsls","explanation":"形容做事马虎粗心，不是丢了这个，就是忘了那个。同“丢三落四”。","source":{"text":"老是这样死活不顾，老是这样丢三拉四，这毛病什么时候能改改！","book":"刘白羽《一个温暖的雪夜》"},"example":{"text":"请尽快改变～的毛病。"},"similar":["丢三落四"],"opposite":["一丝不苟"],"usage":"作宾语、定语；指粗心"},{"id":3258,"word":"丢三落四","pinyin":"diū sān là sì","abbr":"dsls","explanation":"形容做事马虎粗心，不是丢了这个，就是忘了那个。","source":{"text":"俗语说的：‘夯雀儿先飞’，省的临时丢三落四的不齐全，令人笑话。","book":"清·曹雪芹《红楼梦》第67回"},"example":{"text":"我劳力弱，没牲口没车，又不会操持，干活又爱～。","book":"秦兆阳《在田野上前进》第32章"},"similar":["马马虎虎","粗枝大叶","丢三拉四"],"opposite":["谨小慎微","一丝不苟"],"usage":"作宾语、定语；指粗心","story":["柳湘莲救了薛蟠一命，两人结为兄弟，贾琏把尤三姐许配给柳湘莲。柳湘莲听说尤三姐与姐夫贾珍有染，要求退婚，尤三姐以死殉节，柳湘莲从此出家。薛蟠派人去找没找到，薛姨妈说只要有行动就行，以免做事丢三落四令人笑话"]},{"id":3259,"word":"丢下耙儿弄扫帚","pinyin":"diū xià pá er nòng sào zhǒu","abbr":"dxpensz","explanation":"放下这样，又做那样。比喻事情总做不完。","source":{"text":"上上下下，那不是他操心？你一个媳妇，虽然帮着，也是天天‘丢下耙儿弄扫帚’。","book":"清·曹雪芹《红楼梦》第47回"},"example":{"text":"他就是‘～’的性格。"},"usage":"作谓语、定语；比喻事情总做不完"},{"id":3260,"word":"丢丢秀秀","pinyin":"diū diū xiù xiù","abbr":"ddxx","explanation":"形容身躯细小苗条，脚步轻盈。","source":{"text":"就是二雁，女孩儿不大，细眉窄骨儿，长得乖巧，丢丢秀秀地走到奶奶跟前。","book":"梁斌《播火记》第三卷四十七"}},{"id":3261,"word":"丢人现眼","pinyin":"diū rén xiàn yǎn","abbr":"drxy","explanation":"丢脸，出丑。","source":{"text":"你看我弄的婆家婆家不要，娘家娘家讨厌，丢人现眼的，哪有脸见她！","book":"杨朔《春子姑娘》"},"example":{"text":"你不要在这里～。"},"similar":["当场出丑"],"opposite":["光宗耀祖"],"usage":"作宾语、定语；指出丑"},{"id":3262,"word":"丢卒保车","pinyin":"diū zú bǎo jū","abbr":"dzbj","explanation":"原是象棋术语。后比喻丢掉次要的，保住主要的。","source":{"text":"为了堵江救旱，我们是会损失一些，这照我们下棋的说法，就叫做‘丢卒保车’。","book":"京剧《龙江颂》第一场"},"example":{"text":"他之所以这样做就是～。"},"similar":["丢车保帅"],"usage":"作谓语、宾语；用于抉择"},{"id":3263,"word":"丢帽落鞋","pinyin":"diū mào là xié","abbr":"dmlx","explanation":"形容紧急匆忙的样子。","source":{"text":"……纷纷～地向梁三老汉的草棚院奔来劝架。","book":"柳青《创业史》第一部第一章"}},{"id":3264,"word":"丢心落意","pinyin":"diū xīn là yì","abbr":"dxly","explanation":"形容合意、痛快。","source":{"text":"接着这声丢心落意的叫骂，几个铜板，或者几张毛票，被抛在街上了。","book":"沙汀《淘金记》十九"},"similar":["丢心落肠"],"usage":"作谓语、定语；用于口语"},{"id":3265,"word":"丢心落肠","pinyin":"diū xīn luò cháng","abbr":"dxlc","explanation":"放心。","example":{"text":"得到这个好消息，我就～。"},"similar":["丢心落意"],"usage":"作谓语；用于口语、方言"},{"id":3266,"word":"丢盔卸甲","pinyin":"diū kuī xiè jiǎ","abbr":"dkxj","explanation":"形容吃了败仗狼狈逃跑的景象。","source":{"text":"填然鼓之，兵刃既接，弃甲曳兵而走，或百步而后止，或五十步而后止。","book":"《孟子·梁惠王上》"},"example":{"text":"唬得禁军八百万～。","book":"元·孔文卿《东窗事发》第一折"},"similar":["落荒而逃","狼奔豕突","一败涂地"],"opposite":["克敌制胜","旗开得胜"],"usage":"作谓语、定语、补语；指战败"},{"id":3267,"word":"丢盔弃甲","pinyin":"diū kuī qì jiǎ","abbr":"dkqj","explanation":"盔、甲：头盔和铠甲。跑得连盔甲都丢了。形容打败仗后逃跑的狼狈相。","source":{"text":"他在办公室里被各种意外情况搞得丢盔弃甲，狼狈不堪的样子。","book":"杜鹏程《在和平的日子里》第三章"},"example":{"text":"敌人～，落荒而逃。"},"similar":["落荒而逃","狼奔豕突","一败涂地"],"opposite":["克敌制胜","旗开得胜"],"usage":"作谓语、定语、状语；指战败"},{"id":3268,"word":"丢盔抛甲","pinyin":"diu kuī pāo jiǎ","abbr":"dkpj","explanation":"形容吃了败仗狼狈逃跑的景象。同“丢盔卸甲”。","source":{"text":"填然鼓之，兵刃既接，弃甲曳兵而走，或百步而后止，或五十步而后止。","book":"《孟子·梁惠王上》"},"example":{"text":"他们认为今日上午在大战中已经把左光先的精锐杀得～，七零八落。","book":"姚雪垠《李自成》第一卷第十二章"},"similar":["丢盔卸甲","丢盔弃甲"],"usage":"作谓语、定语、补语；指战败"},{"id":3269,"word":"丢盔撂甲","pinyin":"diū kuī liào jiǎ","abbr":"dklj","explanation":"丢：抛；盔：作战用的金属帽；甲：作战用的金属防护衣。形容吃了败仗狼狈逃跑的情形。","source":{"text":"许多人丢盔撂甲，矿帽不时碰落在煤堆中，慌乱得半天摸不着……","book":"路遥《平凡的世界》第五卷第四章"},"similar":["丢盔弃甲","丢盔卸甲"],"usage":"作谓语、定语、状语；指战败"},{"id":3270,"word":"丢眉丢眼","pinyin":"diū méi diū yǎn","abbr":"dmdy","explanation":"做媚眼挑逗传情。","source":{"text":"那太素是个十八九岁的人，晓得吴氏这些行径，也自丢眉丢眼来挑吴氏。","book":"明·凌濛初《初刻拍案惊奇》卷十七"},"example":{"text":"她一直在～，向他暗示。"},"similar":["挤眉弄眼"],"usage":"作谓语、定语；用于男女之间"},{"id":3271,"word":"丢眉弄色","pinyin":"diū méi nòng sè","abbr":"dmns","explanation":"指做媚眼进行挑逗。","source":{"text":"我才说道恕生面少拜识，他做多少丢眉弄色。","book":"元·高文秀《黑旋风》第二折"},"example":{"text":"她～，显示十分不情愿。"},"similar":["挤眉弄眼"],"usage":"作谓语、宾语；指调情"},{"id":3272,"word":"丢车保帅","pinyin":"diū jū bǎo shuài","abbr":"dcbs","explanation":"象棋比赛的战术。比喻牺牲比较重要的东西保护最重要的。","example":{"text":"这是～的做法。"},"similar":["丢卒保帅"],"usage":"作宾语、定语；用于战术方面"},{"id":3273,"word":"丢风撒脚","pinyin":"diū fēng sā jiǎo","abbr":"dfsj","explanation":"撒：放开。指轻狂放肆。","source":{"text":"要是丢风撒脚，妄作妄为，忘八淫妇，我可也都不饶。","book":"清·西周生《醒世姻缘传》第二回"}},{"id":3274,"word":"丢魂丢魄","pinyin":"diu hún diu pò","abbr":"dhdp","explanation":"形容非常惊慌。同“丢魂失魄”。","source":{"text":"有一个狼扑上来，爪子搭在了他的身上，正吓得他丢魂丢魄的时候，山上过来一群锄地的，才把狼赶走。","book":"马烽《吕梁英雄传》第19回"},"example":{"text":"她已经被你吓得～了。"},"similar":["丢魂失魄"],"usage":"作状语、定语；指人慌乱"},{"id":3275,"word":"丢魂丧胆","pinyin":"diū hún sàng dǎn","abbr":"dhsd","explanation":"形容非常惊慌。","source":{"text":"伪军见我们登上船，吓得丢魂丧胆。一个大个子首先举着手钻出船舱说：‘我们交枪，我们交枪！’","book":"张希平《雁翎队》"},"similar":["丢魂失魄"],"usage":"作状语、定语；指人惊慌"},{"id":3276,"word":"丢魂失魄","pinyin":"diū hún shī pò","abbr":"dhsp","explanation":"形容非常惊慌，没头脑，无主见。","source":{"text":"小范首先从树丛后面猛跳出来，那家伙吓得丢魂失魄，尖叫一声，返身就跑。","book":"俞林《在太行山上》"},"example":{"text":"银环茶不思，饭不想，～，像着了魔一样。","book":"李英儒《野火春风斗古城》"},"similar":["丧魂落魄"],"usage":"作状语、定语；指人慌乱"},{"id":3277,"word":"两世为人","pinyin":"liǎng shì wéi rén","abbr":"lswr","explanation":"好像重新来到人间。形容在非常危险的情况中幸存下来。","example":{"text":"事隔几年重来故地，我还真有～之感。"},"usage":"作宾语、定语；用于比喻句"},{"id":3278,"word":"两两三三","pinyin":"liǎng liǎng sān sān","abbr":"llss","explanation":"①指三两为群。②形容稀疏。","source":{"text":"两两三三白鸟飞，背人斜去落渔矶。","book":"南朝·梁·任昉《述异记》卷上：“今冀粥有乐名蚩尤戏，其民两两三三头戴牛角相抵。”元·杨载《宿浚仪公湖亭》诗"},"example":{"text":"凄凉江夏秋风里，～鬼火青。","book":"胡韫玉《哭唐守楩集放翁句》"},"similar":["三三两两"],"usage":"作定语、状语；形容数目不多"},{"id":3279,"word":"两全其美","pinyin":"liǎng quán qí měi","abbr":"lqqm","explanation":"美：美好。指做一件事顾全到双方，使两方面都得到好处。","source":{"text":"司徒，你若肯与了我呵，堪可两全其美也。","book":"元·无名氏《连环计》第三折"},"example":{"text":"土霸打倒，穷苦人见青天。不是～！","book":"梁斌《红旗谱》十八"},"similar":["一箭双雕","一举两得"],"opposite":["玉石俱焚","两败俱伤"],"usage":"作谓语、定语；指两方面都照顾到","story":["东汉末年，董卓操纵朝政大权，司徒王允与养女貂禅商议设计除掉董卓，王允先把貂禅许配给吕布，吕布很高兴，英雄配美女，两全其美。王允又将貂禅进贡给董卓，造成董卓与吕布的矛盾，吕布设计在宫中除掉董卓"]},{"id":3280,"word":"两刃相割，利钝乃知","pinyin":"liǎng rèn xiāng gē，lì dùn nǎi zhī","abbr":"lrxgldnz","explanation":"利：锋利；乃：才。两把刀子交锋之后，才能知道哪把快哪把钝。比喻只有把两种学说、观点放在一起比较，才能判定是非曲直。","source":{"text":"两刃相割，利钝乃知；二论相定，是非乃见。","book":"汉·王充《论衡·案书》"}},{"id":3281,"word":"两利俱存","pinyin":"liǎng lì jù cún","abbr":"lljc","explanation":"对双方有利，就可以都存在。","source":{"text":"诚能听臣之计，莫若两利而俱存之。","book":"《史记·淮阴侯列传》"},"example":{"text":"泇开于梗漕之日，固不可因泇而废黄；漕于於泇成之后，亦不可因黄而废泇。～，庶几缓急可赖。","book":"《明史·河渠志五》"}},{"id":3282,"word":"两厢情愿","pinyin":"liǎng xiāng qíng yuàn","abbr":"lxqy","explanation":"情愿：心里愿意。两方面都愿意，互不勉强。","source":{"text":"感情上的事，要两厢情愿。","book":"高阳《胡雪岩全传·灯火楼台》"},"example":{"text":"你爱钱和你有钱是两回事，还得钱爱你，～。","book":"王朔《给我顶住》"},"similar":["两相情愿"],"opposite":["一厢情愿"],"usage":"作谓语、定语、宾语；指两方面都愿意"},{"id":3283,"word":"两可之言","pinyin":"liǎng kě zhī yán","abbr":"lkzy","explanation":"两可：可彼可此，态度暧昧。不肯明确表示自己态度的言论和意见。","source":{"text":"苟求便身，率为依阿两可之言。","book":"《资治通鉴·唐纪·宪宗元和四年》"}},{"id":3284,"word":"两叶掩目","pinyin":"liǎng yè yǎn mù","abbr":"lyym","explanation":"如同两片树叶遮住了眼睛。比喻受到蒙蔽而对事物分辨不清楚。","source":{"text":"夫两叶掩目，则冥然无睹；双珠填耳，必寂然无闻。","book":"北齐·刘昼《刘子新论·专学》"},"similar":["一叶障目"],"usage":"作宾语、定语；指受蒙蔽"},{"id":3285,"word":"两国交兵，不斩来使","pinyin":"liǎng guó jiāo bīng，bù zhǎn lái shǐ","abbr":"lgjbbzls","explanation":"指作战双方不能杀来往的使者。","source":{"text":"两国交兵，不斩来使，我们派个人去是决计不要紧的。","book":"清·李宝嘉《官场现形记》第55回"},"similar":["两国交兵，不斩来使"],"usage":"作宾语、定语；用于交往等"},{"id":3286,"word":"两国相战，不斩来使","pinyin":"liǎng guó xiāng zhàn，bù zhǎn lái shǐ","abbr":"lgxzbzls","explanation":"指作战双方不能杀来往的使者。","source":{"text":"自古‘两国相战，不斩来使’。于礼不当。","book":"明·施耐庵《水浒传》第69回"},"similar":["两国交兵，不斩来使"],"usage":"作宾语、定语；用于交往等"},{"id":3287,"word":"两头三绪","pinyin":"liǎng tóu sān xù","abbr":"ltsx","explanation":"形容心意烦乱。","source":{"text":"都则道百媚千娇，送的人四分五落，两头三绪。","book":"元·白朴《墙头马上》第四折"},"similar":["三头两绪"],"usage":"作谓语、定语；形容人的心情"},{"id":3288,"word":"两头三面","pinyin":"liǎng tóu sān miàn","abbr":"ltsm","explanation":"形容作事情表里不一，两面糊弄，两头讨好。同“两头白面”。","source":{"text":"若是我，两三番，将他留恋，教人道后尧婆两头三面。","book":"元·关汉卿《蝴蝶梦》第三折"},"similar":["三头两面"],"usage":"作谓语、状语；用于表里不一"},{"id":3289,"word":"两头和番","pinyin":"liǎng tóu huò fān","abbr":"lthf","explanation":"指两面拨弄、搅和。","source":{"text":"单管两头和番，曲心矫肚，人面兽心。","book":"明·兰陵笑笑生《金瓶梅词话》第七十五回"},"similar":["两面二舌"],"usage":"作谓语、定语；用于处事"},{"id":3290,"word":"两头担心","pinyin":"liǎng tóu dān xīn","abbr":"ltdx","explanation":"指人心挂两头，不能平静。","example":{"text":"我们一家分居三地，让我～。"},"similar":["心挂两头"],"usage":"作谓语、定语；指人心挂两头"},{"id":3291,"word":"两头白面","pinyin":"liǎng tóu bái miàn","abbr":"ltbm","explanation":"白面：面粉，比喻糊涂或被人蒙骗。对两头都掩饰、隐瞒。形容作事情表里不一，两面糊弄，两头讨好。","source":{"text":"则为你两头白面搬兴废，转背言词说是非。","book":"元·康进之《李逵负荆》第二折"},"example":{"text":"金莲，你休呆里撒奸，～。说长并道短，我手里使不的你巧语花言。","book":"明·兰陵笑笑生《金瓶梅词话》第86回"},"similar":["两面讨好"],"usage":"作谓语、定语；对两头都掩饰、隐瞒"},{"id":3292,"word":"两害从轻","pinyin":"liǎng hài cóng qīng","abbr":"lhcq","explanation":"把两项祸事进行比较，选取其中较轻的一项。","source":{"text":"盖闻两害相较，则取其轻，与其使察、绥两省，同为日有，不如以一省付之共党之为害轻也。","book":"章炳麟《答某书》"},"example":{"text":"故为～之计，仍以签字为宜。","book":"蔡东藩、许廑父《民国通俗演义》第一○八回"}},{"id":3293,"word":"两害相较取其轻","pinyin":"liǎng hài xiāng jiào qǔ qí qīng","abbr":"lhxjqqq","explanation":"把两项祸事进行比较，选取其中较轻的一项。","source":{"text":"盖闻两害相较，则取其轻，与其使察、绥两省，同为日有，不如以一省付之共党之为害轻也。","book":"章炳麟《答某书》"}},{"id":3294,"word":"两小无猜","pinyin":"liǎng xiǎo wú cāi","abbr":"lxwc","explanation":"猜：猜疑。男女小时候在一起玩耍，没有猜疑。","source":{"text":"同居长干里，两小无嫌猜。","book":"唐·李白《长干行》诗"},"example":{"text":"翁有女，小字江城，与生同甲，时皆八、九岁，～，日共嬉戏。","book":"清·蒲松龄《聊斋志异·江城》"},"similar":["儿女情长","卿卿我我"],"opposite":["敬而远之，视同陌路","疏于音问"],"usage":"作宾语、定语；指青梅竹马的男女","story":["古代金陵城长干里街道住着两户人家，两家均有孩子，他们从小在一起玩耍，毫无猜疑，小男孩骑着竹竿当马，欢快地跑出来，女孩见梅树上长着许多青梅就叫男孩去摘。男孩给他摘下许多。后来两个小孩长大结为夫妻，双双恩爱白头到老"]},{"id":3295,"word":"两得其中","pinyin":"liǎng dé qí zhōng","abbr":"ldqz","explanation":"中：适中。按不同的要求认为两种相反的表现都各有道理，也都是合适的。","source":{"text":"凡吊，主人哭客乃为礼，阮既不哭，君何为哭？裴曰：‘阮方外之人，故不崇礼制，我辈俗中人，故以仪轨自居。时人叹为两得其中。","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":3296,"word":"两得其便","pinyin":"liǎng dé qí biàn","abbr":"ldqb","explanation":"指对双方都有好处。","source":{"text":"此事与立孙无相妨，华屋良田与吾之孙，独以一命与吾兄之孙，两得其所矣。","book":"宋·刘克庄《与郑邵武书》"},"example":{"text":"当初韩信怀才未遇，汉皇缺少大将，～。","book":"明·冯梦龙《喻世明言》卷三十一"}},{"id":3297,"word":"两得其所","pinyin":"liǎng dé qí suǒ","abbr":"ldqs","explanation":"指对双方都有好处。","source":{"text":"此事与立孙无相妨，华屋良田与吾之孙，独以一命与吾兄之孙，两得其所矣。","book":"宋·刘克庄《与郑邵武书》"},"example":{"text":"赵师爷算无遗策，进退～。","book":"高阳《慈禧全传》五十七"}},{"id":3298,"word":"两心一体","pinyin":"liǎng xīn yī tǐ","abbr":"lxyt","explanation":"两心：彼此的心意。指彼此的心意一致。","source":{"text":"双心一意俱徊翔，吐情寄君君莫忘。","book":"南朝·梁·沈约《四时白纻歌·秋白纻》"},"example":{"text":"至老不相疏，斯言不是虚。两心宜一体，同舍又邻居。","book":"唐·薛能《赠苗端公二首》其二"}},{"id":3299,"word":"两心相悦","pinyin":"liǎng xīn xiāng yuè","abbr":"lxxy","explanation":"两心：双方的心意。形容两相爱悦。","source":{"text":"两心相悦，共其柔筋。","book":"汉·焦延寿《易林·小过》"}},{"id":3300,"word":"两情两愿","pinyin":"liǎng qíng liǎng yuàn","abbr":"lqly","explanation":"指双方都愿意。","example":{"text":"他们～，谁也不好说什么。"},"similar":["两相情愿","你情我愿"],"opposite":["一厢情愿"],"usage":"作谓语、宾语；用于口语"},{"id":3301,"word":"两情缱绻","pinyin":"liǎng qíng qiǎn quǎn","abbr":"lqqq","explanation":"缱绻：形容情意深厚。比喻男女相爱，情意缠绵，不忍离散。","source":{"text":"无纵鬼随，以谨缱绻。","book":"《诗经·大雅·民劳》"}},{"id":3302,"word":"两意三心","pinyin":"liǎng yì sān xīn","abbr":"lysx","explanation":"三心二意。心里想这样又想那样，形容犹豫不决或意志不坚定。","source":{"text":"休得慕富嫌贫，两意三心，自贻后悔。","book":"明·冯梦龙《喻世明言》第二十七卷"},"example":{"text":"似怕人知道我们曾相识，～，把旧时的好话都撇在一边。","book":"许地山《无法投递之邮件》"},"similar":["三心二意"],"usage":"作谓语、宾语；指意见不坚定"},{"id":3303,"word":"两手空空","pinyin":"liǎng shǒu kōng kōng","abbr":"lskk","explanation":"形容人手头很紧，一个钱也没有。","source":{"text":"我客死于此，两手空空，……。","book":"清·袁枚《子不语》卷二十三"},"example":{"text":"你知道我做公债亏得一塌糊涂，差不多～了。","book":"茅盾《子夜》八"},"similar":["赤手空拳","两袖清风","一无所有"],"opposite":["丰衣足食","家给人足","腰缠万贯"],"usage":"作谓语、状语、定语；指一无所有"},{"id":3304,"word":"两极分化","pinyin":"liǎng jí fēn huà","abbr":"ljfh","explanation":"分成两个集中于相反极端的部分。","source":{"text":"一条是公有制经济始终占主体地位，一条是发展经济要走共同富裕的道路，始终避免两极分化。","book":"邓小平《社会主义和市场经济不存在根本矛盾》"},"usage":"作谓语、定语、宾语；用于事物或状态等"},{"id":3305,"word":"两次三番","pinyin":"liǎng cì sān fān","abbr":"lcsf","explanation":"多次，好几次。","source":{"text":"你看这个苍蝇两次三番落在这笔尖儿上。","book":"元·关汉卿《绯衣梦》第三折"},"example":{"text":"到而今，～添忧虑，终日昏迷。","book":"《白雪遗音·马头调·长远计》"},"similar":["几次三番","屡次三番"],"usage":"作状语；形容反复多次"},{"id":3306,"word":"两歧遂分","pinyin":"liǎng qí suì fēn","abbr":"lqsf","explanation":"两歧：分杈成为两枝，引申为事物向不同的方向发展；遂：于是。产生了两种不同的意见。也指事物从此向不同的方向发展。","source":{"text":"若悉考同异，深究嫌疑，则两歧遂分，党论滋炽。","book":"《宋史·王觌传》"}},{"id":3307,"word":"两歧麦秀","pinyin":"liǎng qí mài suì","abbr":"lqmx","explanation":"一根麦长两个穗。比喻年成好，粮食丰收。","source":{"text":"百姓歌曰：‘桑无附枝，麦穗两岐，张君为政，乐不可支。’","book":"《后汉书·张堪传》"}},{"id":3308,"word":"两泪汪汪","pinyin":"liǎng lèi wāng wāng","abbr":"llww","explanation":"汪汪：眼睛里充满泪水的样子。两只眼睛里都是泪水。形容心里极为哀苦。","source":{"text":"回到店中，只叫得苦，两泪汪汪的坐着纳闷。","book":"明·冯梦龙《喻世明言》卷九"},"example":{"text":"紫鹃自己也发了一回呆，忽然想起黛玉来，这时候还不知是死是活。因～，咬着牙发狠。","book":"清·曹雪芹《红楼梦》第九十七回"}},{"id":3309,"word":"两相情原","pinyin":"liǎng xiāng qíng yuán","abbr":"lxqy","explanation":"指双方互相愿意。"},{"id":3310,"word":"两相情愿","pinyin":"liǎng xiāng qíng yuàn","abbr":"lxqy","explanation":"两方面都愿意。多指婚姻或交易。","source":{"text":"太公，你也是个痴汉，既然不两相情愿，如何招赘做个女婿。","book":"明·施耐庵《水浒全传》第五回"},"example":{"text":"事毕，其字号存酬劳银一百两，即归我支用。～，决无虚假。","book":"清·刘鹗《老残游记》第十九回"},"similar":["同心同德","两全其美","皆大欢喜"],"opposite":["大相径庭","一厢情愿"],"usage":"作谓语、定语；指两方面都愿意","story":["武则天当皇帝后十分骄傲，在寒冷的冬天便命长安城内百花开放，只有牡丹除外。她下令全城不许种牡丹并拔掉牡丹，吕洞宾救了牡丹仙子一命，牡丹仙子便想以身相许，王母娘娘指责吕洞宾，何仙姑说这是他们两相情愿的事情"]},{"id":3311,"word":"两眼一抹黑","pinyin":"liǎng yǎn yī mā hēi","abbr":"lyymh","explanation":"对周围情况一无所知。","source":{"text":"两眼一抹黑两耳不闻窗外事就在文学本体上倒腾先谓语后主语光动词没名词一百多句不点标点看晕一个算一个！","book":"王朔《一点正经没有》"},"example":{"text":"我刚来到这里，人生地不熟，～。"},"similar":["两眼漆黑"],"usage":"作谓语、定语；用于口语"},{"id":3312,"word":"两眼墨黑","pinyin":"liǎng yǎn mò hēi","abbr":"lymh","explanation":"比喻十分陌生。","source":{"text":"但他是初到省的人员，两眼墨黑，他不认得上司，上司也不认得他。","book":"清·李宝嘉《官场现形记》第36回"},"example":{"text":"这个小狗子，～，啥也不懂！","book":"高阳《胡雪岩全传·平步青云》下册"},"similar":["两眼漆黑"],"opposite":["轻车熟路"],"usage":"作谓语、定语；指十分陌生"},{"id":3313,"word":"两眼漆黑","pinyin":"liǎng yǎn qī hēi","abbr":"lyqh","explanation":"比喻十分陌生。","source":{"text":"此番到吏部打点，正愁着两眼漆黑，不知门径，现在找到个人可以指点，岂不甚妙？","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"初到这个地方，我有～的感觉。"},"similar":["两眼墨黑"],"opposite":["熟门熟路"],"usage":"作谓语、定语；指十分陌生"},{"id":3314,"word":"两瞽相扶","pinyin":"liǎng gǔ xiāng fú","abbr":"lgxf","explanation":"瞽L盲人。两个瞎子互相搀扶。比喻彼此都得不到帮助。","source":{"text":"两瞽相扶，不伤墙木，不陷井穽，则其幸也。","book":"汉·韩婴《韩诗外传》卷五"},"usage":"作宾语、定语；指得不到帮助"},{"id":3315,"word":"两耳塞豆","pinyin":"liǎng ěr sāi dòu","abbr":"lesd","explanation":"比喻为局部的或暂时的现象所迷惑，不能认清全局或看到根本。","source":{"text":"一叶蔽目，不见太山；两耳塞豆，不闻雷霪。","book":"宋·陆佃解《鹖冠子·天则》"},"example":{"text":"你不能～，被眼前的现象所迷惑"},"similar":["两豆塞耳","双豆塞耳"],"usage":"作宾语、定语；用于处事"},{"id":3316,"word":"两肋插刀","pinyin":"liǎng lèi chā dāo","abbr":"llcd","explanation":"两边肋骨插上刀，表示不怕死。比喻承担极大的牺牲。","source":{"text":"让老乔先撤，你为他两肋插刀顶上一阵。","book":"蒋子龙《乔厂长上任记》"},"example":{"text":"为朋友～，不算什么。","book":"高云览《小城春秋》第29章"},"similar":["赴汤蹈火","义无反顾"],"opposite":["胆小如鼠","为虎作伥"],"usage":"作谓语、宾语、定语；指承担极大风险"},{"id":3317,"word":"两肩担一口","pinyin":"liǎng jiān dān yī kǒu","abbr":"ljdyk","explanation":"身上只有一张需要吃东西的嘴。形容极端贫穷，一无所有。","source":{"text":"两个肩膀抬着个口，每日则是吃他家的。","book":"元·无名氏《刘弘嫁婢》第一折"},"example":{"text":"匿子图诈，诈其富有也，我夫妇～耳。","book":"清·沈复《浮生六记·坎坷记愁》"}},{"id":3318,"word":"两肩荷口","pinyin":"liǎng jiān hé kǒu","abbr":"ljhk","explanation":"犹言两个肩膀扛张嘴，比喻只会吃饭不会干事。"},{"id":3319,"word":"两脚书橱","pinyin":"liǎng jiǎo shū chú","abbr":"ljsc","explanation":"指读书很多但不善于应用的人。","source":{"text":"澄当世称为硕学，读《易》三年不解文义，欲撰《宋书》竟不成。王俭戏之曰：‘陆公，书厨也。’","book":"《南史·陆澄传》"},"example":{"text":"俗谚谓为～，记诵日多，多益为累，及伸纸落笔时，胸如乱丝。","book":"清·叶燮《原诗·内篇下》"},"usage":"作宾语、定语；用于比喻句"},{"id":3320,"word":"两脚居间","pinyin":"liǎng jiǎo jū jiān","abbr":"ljjj","explanation":"方言。犹言中间人。多指婚姻介绍人。"},{"id":3321,"word":"两脚野狐","pinyin":"liǎng jiǎo yě hú","abbr":"ljyh","explanation":"比喻奸诈的人。","source":{"text":"左补阙戴令言作《两脚野狐赋》以讥讽之，再思闻之怒。","book":"《旧唐书·杨再思传》"},"usage":"作宾语；指奸诈小人"},{"id":3322,"word":"两般三样","pinyin":"liǎng bān sān yàng","abbr":"lbsy","explanation":"不一样，不一致。","source":{"text":"赵琮夫妻两个，不要说看了别人许多眉高眼低，只是父母身边，也受多少两般三样的怠慢，没奈何争气不来，只得怨命忍耐。","book":"明·凌濛初《初刻拍案惊奇》卷二十九"}},{"id":3323,"word":"两虎共斗","pinyin":"liǎng hǔ gòng dòu","abbr":"lhgd","explanation":"斗：争斗。比喻两个强者互相搏斗。","source":{"text":"今两虎共斗，其势不俱生，吾所以为此者，以先国家之急而后私仇也。","book":"西汉·司马迁《廉颇蔺相如列传》"},"similar":["两虎相斗"],"usage":"作谓语、宾语；指两败俱伤","story":["战国时期，赵国蔺相如多次立功，赵王封他为相国，老将廉颇不服气，认为自己的武功盖过他，蔺相如对廉颇多次避让，并说：“今两虎共斗，其势不俱生，吾所以为此者，以先国家之急而后私仇也。”廉颇得知后惭愧不已，便背负荆请罪"]},{"id":3324,"word":"两虎相争","pinyin":"liǎng hǔ xiāng zhēng","abbr":"lhxz","explanation":"两只老虎相互争斗。比喻力量强大的双方相搏斗。","source":{"text":"天下莫强于秦楚，今闻大王欲伐楚，此犹两虎相与斗。","book":"《战国策·秦策二》：“今两虎诤人而斗，小者必死，大者必伤。”《史记·春申君列传》"},"example":{"text":"我相公官至下大夫，不知为何，近日只要与上大夫赵正卿争朝，我想～，必有一伤。","book":"明·徐元《八义记·张维评话》"},"similar":["两虎相斗"],"usage":"作谓语、宾语；指两败俱伤","story":["战国时期，韩国和魏国打了一年多还不分胜负，秦惠王想出兵干涉，楚国使者陈轸给秦惠王讲卞庄子利用两虎相争必有一伤的道理，得到它们两败俱伤时一举打死两只老虎，劝秦惠王采取坐山观虎斗的计策，等待时机再消灭这两国"]},{"id":3325,"word":"两虎相争，必有一伤","pinyin":"liǎng hǔ xiāng zhēng，bì yǒu yī shāng","abbr":"lhxzbyys","explanation":"比喻两个强者互相搏斗，必然有一方要遭严重损害。","source":{"text":"我相公官至下大夫，不知为何，近日只要与上大夫赵正卿争朝，我想两虎相争，必有一伤。","book":"明·徐元《八义记·张维评话》"},"similar":["两虎相斗，必有一伤"],"usage":"作宾语、定语、分句；用于处事"},{"id":3326,"word":"两虎相斗","pinyin":"liǎng hǔ xiāng dòu","abbr":"lhxd","explanation":"两只老虎相互争斗。比喻力量强大的双方相搏斗。","source":{"text":"天下莫强于秦楚，今闻大王欲伐楚，此犹两虎相与斗。","book":"《战国策·秦策二》：“今两虎诤人而斗，小者必死，大者必伤。”《史记·春申君列传》"},"example":{"text":"今～，必有一伤。须误了我大事。吾与你二人劝解，休得争论。","book":"明·罗贯中《三国演义》第六十二回"},"similar":["两虎相争","两败俱伤"],"usage":"作谓语、宾语；指两败俱伤","story":["战国时期，韩国和魏国打了一年多还不分胜负，秦惠王想出兵干涉，楚国使者陈轸给秦惠王讲卞庄子利用两虎相争必有一伤的道理，得到它们两败俱伤时一举打死两只老虎，劝秦惠王采取坐山观虎斗的计策，等待时机再消灭这两国"]},{"id":3327,"word":"两虎相斗，必有一伤","pinyin":"liǎng hǔ xiāng dòu，bì yǒu yī shāng","abbr":"lhxdbyys","explanation":"斗：争斗。比喻两个强者互相搏斗，必然有一方要遭严重损害。","source":{"text":"虎者，戾虫；人者，甘饵。今两虎争人而斗，小者必死，大者必伤。","book":"西汉·刘向《战国策·秦策二》"},"example":{"text":"～，陛下但默观动静。","book":"明·郭勋《英烈传》第29回"},"similar":["两虎相争，必有一伤"],"usage":"作宾语、定语、分句；用于处事","story":["战国时期，韩国和魏国打了一年多还不分胜负，秦惠王想出兵干涉，楚国使者陈轸给秦惠王讲卞庄子利用两虎相争必有一伤的道理，得到它们两败俱伤时一举打死两只老虎，劝秦惠王采取坐山观虎斗的计策，等待时机再消灭这两国"]},{"id":3328,"word":"两袖清风","pinyin":"liǎng xiù qīng fēng","abbr":"lxqf","explanation":"衣袖中除清风外，别无所有。比喻做官廉洁。也比喻穷得一无所有。","source":{"text":"两袖清风身欲飘，杖藜随月步长桥。","book":"元·陈基《次韵吴江道中》诗"},"example":{"text":"他自己做了几十年的官，依然是～。","book":"清·李宝嘉《文明小史》第十二回"},"similar":["洁身自好","一贫如洗","廉洁奉公"],"opposite":["贪得无厌","贪赃枉法"],"usage":"作谓语、定语；指为官清廉","story":["明朝监察御史于谦为官十分清廉，从不收受老百姓的财物，而当时的官场十分腐败。于谦在任巡抚期间回京什么也没有带，特带《入京》诗一首：“绢帕蘑菇与线香，本资民用反为殃，清风两袖朝天去，免得闾阎话短长。”"]},{"id":3329,"word":"两言可决","pinyin":"liǎng yán kě jué","abbr":"lykj","explanation":"两三句话即可决定。形容寥寥数语就把事情办妥了。","source":{"text":"毛遂按剑历阶而上，谓平原君曰：‘从之利害，两言可决耳。’","book":"《史记·平原君虞卿列传》"}},{"id":3330,"word":"两豆塞耳","pinyin":"liǎng dòu sāi ěr","abbr":"ldse","explanation":"比喻为局部的或暂时的现象所迷惑，不能认清全局或看到根本。","source":{"text":"夫耳之主听，目之主明。一叶蔽目，不见太山；两豆塞耳，不闻雷霆。","book":"《鹖冠子·天则》"},"example":{"text":"他做事的时候非常专心，好像～，什么都听不见。"},"similar":["一叶蔽目","两耳塞豆","双豆塞耳"],"opposite":["耳聪目明"],"usage":"作宾语；指不能认清全局"},{"id":3331,"word":"两贤相厄","pinyin":"liǎng xián xiāng è","abbr":"lxxe","explanation":"指两个有才能、德行的人互相为害。","source":{"text":"季布母弟丁公，为楚将。丁公为项羽逐窘高祖彭城西，短兵接，高祖急，顾丁公曰：‘两贤岂相厄哉！’于是丁公引兵而还，汉王遂解去。","book":"《史记·季布栾布列传》"},"example":{"text":"撒我虎皮，让君牛耳，谁道～哉。","book":"宋·刘克庄《沁园春·吴叔永尚书和余旧作再答》词"},"usage":"作宾语、定语；用于处事","story":["楚汉相争时期，汉王刘邦手下大将季布的母弟丁公是项羽手下的大将。丁公为项羽攻打处于困窘中的刘邦，把刘邦围困在彭城西，短兵相接。刘邦急了，就与季布找到丁公，希望不要两贤相厄。于是丁公带兵退去，刘邦才得以解围"]},{"id":3332,"word":"两败俱伤","pinyin":"liǎng bài jù shāng","abbr":"lbjs","explanation":"俱：都。斗争双方都受到损伤，谁也没得到好处。","source":{"text":"有顷，两虎果斗，大者伤，小者死，庄子从伤者而刺之，一举果有双虎之功。","book":"《史记·张仪列传》"},"example":{"text":"这两种运动合起来便能够互收效益，分开来定要～。","book":"闻一多《文艺与爱国——纪念三月十八》"},"similar":["同归于尽"],"opposite":["两全其美"],"usage":"作谓语、宾语、定语；用于人等","story":["战国时期，韩国和魏国打了一年多还不分胜负，秦惠王想出兵干涉，楚国使者陈轸给秦惠王讲卞庄子利用两虎相争必有一伤的道理，得到它们两败俱伤时一举打死两只老虎，劝秦惠王采取坐山观虎斗的计策，等待时机再消灭这两国"]},{"id":3333,"word":"两边倒","pinyin":"liǎng biān dǎo","abbr":"lbd","explanation":"形容摇摆不定，没有坚定的立场和主张。","example":{"text":"他是一个～的没立场的人物。"},"usage":"作谓语、定语；用于处事"},{"id":3334,"word":"两道三科","pinyin":"liǎng dào sān kē","abbr":"ldsk","explanation":"说三道四，花言巧语。","source":{"text":"谁听你两道三科，嚷似蜂窝，甜似蜜钵。","book":"元·关汉卿《鲁斋郎》第四折"},"similar":["说三道四"],"usage":"作谓语、宾语；用于口语"},{"id":3335,"word":"两部蛙鸣","pinyin":"liǎng bù wā míng","abbr":"lbwm","explanation":"鼓吹：古时仪仗乐队的器乐合奏。两部器乐合奏。特指蛙鸣。也用来形容悠闲舒适的天然形成的生活环境。","source":{"text":"门庭之内，草莱不剪，中有蛙鸣，或问之曰：‘欲为陈蕃乎？’稚珪笑曰：‘我以此当两部鼓吹，何必期效仲举。’","book":"《南齐书·孔稚珪传》"},"example":{"text":"那厮分不的～，所事村沙。","book":"元·马致远《青衫泪》第四折"}},{"id":3336,"word":"两部鼓吹","pinyin":"liǎng bù gǔ chuī","abbr":"lbgc","explanation":"鼓吹：古时仪仗乐队的器乐合奏。两部器乐合奏。特指蛙鸣。","source":{"text":"门庭之内，草莱不剪，中有蛙鸣，或问之曰：‘欲为陈蕃乎？’稚珪笑曰：‘我以此当两部鼓吹，何必期效仲举。’","book":"《南齐书·孔稚珪传》"},"example":{"text":"而楼下的是坐着骂山门，这就叫我想起了唐朝的坐部伎和立部伎，而戏称之为“～”。","book":"茅盾《霜叶红于二月花·新版后记》"},"usage":"作宾语；指蛙鸣","story":["南齐时期，孔稚珪对世俗很讨厌，喜欢山水自然，他居住的房子周围不加修饰，长满野草，坑坑洼洼，高低不平，经常可以听到蛙的鸣声，有人说他效仿后汉陈蕃。他认为这两部鼓吹别有一番风味，是器乐合奏"]},{"id":3337,"word":"两雄不俱立","pinyin":"liǎng xióng bù jù lì","abbr":"lxbjl","explanation":"两股强大的势力不可能同时存在。","source":{"text":"且两雄不俱立，楚汉久相持駣决，百姓骚动，海内摇荡，农夫释耒，工女下机，天下之心未有所定也。","book":"《史记·郦生陆贾列传》"}},{"id":3338,"word":"两雄不并立","pinyin":"liǎng xióng bù bìng lì","abbr":"lxbbl","explanation":"指两雄不能并容，必定相争斗兼并。","source":{"text":"且两雄不俱立，楚汉久相持駣决，百姓骚动，海内摇荡，农夫释耒，工女下机，天下之心未有所定也。","book":"《史记·郦生陆贾列传》"},"example":{"text":"傕性不测，况今～，倘彼酒后置毒，妾将奈何。","book":"明·罗贯中《三国演义》第十三回"}},{"id":3339,"word":"两面三刀","pinyin":"liǎng miàn sān dāo","abbr":"lmsd","explanation":"比喻居心不良，当面一套，背后一套。","source":{"text":"岂知他有两面三刀，向夫主厮搬调。","book":"元·李行道《灰阑记》第二折"},"example":{"text":"你这“～”的东西，我不稀罕。","book":"清·曹雪芹《红楼梦》第六十二回"},"similar":["表里不一","阳奉阴违","口是心非"],"opposite":["忠诚老实","实事求是","表里如一"],"usage":"作谓语、宾语、定语；形容阴险的人","story":["马均卿妻子和赵令史同谋，诬告马均卿的小妾张海棠害死丈夫，并强夺张海棠的儿子。后经包拯查明真相，将儿子判归海棠，在调查过程中，马妻竭力为自己辩护，说自己不会玩弄两面三刀的手法，是一个贤惠的女人"]},{"id":3340,"word":"两面二舌","pinyin":"liǎng miàn èr shé","abbr":"lmes","explanation":"比喻在两方面挑拔。","source":{"text":"其两面二舌，构虚造谗，离间骨肉者，逐之。","book":"《司马氏书仪·婚仪下》"},"similar":["搬嘴弄舌"],"usage":"作谓语、宾语；比喻在两方面挑拔"},{"id":3341,"word":"两面光","pinyin":"liǎng miàn guāng","abbr":"lmg","explanation":"两个面都光滑。比喻两方面都不得罪，两边做好人。","source":{"text":"凡事不能光做一面，总要两面光。","book":"清·李宝嘉《官场现形记》第49回"},"example":{"text":"他是一个～式的人物。"},"similar":["八面玲珑"],"usage":"作宾语、定语；指人圆滑"},{"id":3342,"word":"两面讨好","pinyin":"liǎng miàn tǎo hǎo","abbr":"lmth","explanation":"在两派之间摇摆或保持中间立场以讨好双方的人。","example":{"text":"你最好不要～了。"},"similar":["两头白面"],"usage":"作谓语、宾语、定语；指和事佬"},{"id":3343,"word":"两鬓如霜","pinyin":"liǎng bìn rú shuāng","abbr":"lbrs","explanation":"鬓：鬓角的头发。两边的鬓发白如霜雪。","source":{"text":"不觉新凉似火，相思两鬓如霜。","book":"宋·刘辰翁《西江月·新秋写兴》词"},"usage":"作谓语、定语；多用于老人"},{"id":3344,"word":"两鬓斑白","pinyin":"liǎng bìn bān bái","abbr":"lbbb","explanation":"两边鬓角头发花白。形容年老或操劳过度。","source":{"text":"他关住门，立在脚地上，低倾下两鬓斑白的头颅，开始沉重地思考这新的使命。","book":"路遥《平凡的世界》第三卷第三章"},"similar":["两鬓如霜"],"usage":"作谓语、定语、状语；多用于中老年人"},{"id":3345,"word":"两鼠斗穴","pinyin":"liǎng shǔ dòu xué","abbr":"lsdx","explanation":"比喻敌对双方在地势险狭的地方相遇，只有勇往直前的才能获胜。","source":{"text":"其道远险狭，譬之犹两鼠斗于穴中，将勇者胜。","book":"《史记·廉颇蔺相如列传》"},"usage":"作宾语、定语；用于劝诫人","story":["战国时期，秦国出兵攻伐韩国，屯兵于阈与。赵王召廉颇问可否救韩，廉颇认为道远险狭难救。赵王又召问乐乘，乐乘与廉颇的观点一致。赵王又召问赵奢，赵奢说：“其道远险狭，譬之犹两鼠斗于穴中，将勇者胜。”"]},{"id":3346,"word":"严丝合缝","pinyin":"yán sī hé fèng","abbr":"yshf","explanation":"指缝隙严密闭合。","source":{"text":"外省的地平，又多是用木板铺的，上面严丝合缝盖上，轻易看不出来。","book":"清·文康《儿女英雄传》第七回"},"example":{"text":"真像铸就的一样，螺丝搬子竟～地把钢轨接起来了。","book":"史阜民《十八列火车》"},"usage":"作定语、状语；指缝隙严密闭合"},{"id":3347,"word":"严严实实","pinyin":"yán yán shí shí","abbr":"yyss","explanation":"不留空隙或出口。形容非常严密。","source":{"text":"东拉河已经被坚冰封盖得严严实实，冰面蒙了一层灰漠漠的尘土。","book":"路遥《平凡的世界》第二卷第34章"},"example":{"text":"她把口袋捂得～，深怕人抢走她的血汗钱。"},"usage":"作定语、状语；用于口语"},{"id":3348,"word":"严严翼翼","pinyin":"yán yán yì yì","abbr":"yyyy","explanation":"严严：庄重的样子；翼翼：整饬的样子。形容庄重整齐。","source":{"text":"严严翼翼，壮伟雄耀。","book":"宋·欧阳修《吉州学论》"}},{"id":3349,"word":"严于律己","pinyin":"yán yú lǜ jǐ","abbr":"yylj","explanation":"律：约束。严格地约束自己。","source":{"text":"严于律己，出而见之事功；心乎爱民，动必关天治道。","book":"宋·陈亮《谢曾察院君》"},"example":{"text":"我们的毛泽东同志、周恩来同志以身作则，～，艰苦奋斗，几十年如一日。","book":"邓小平《在全军政治工作会议上的讲话》"},"similar":["严以律己"],"opposite":["宽以待人"],"usage":"作谓语、补语；指严格地约束自己"},{"id":3350,"word":"严于律已","pinyin":"yán yú lǜ jǐ","abbr":"yyly","explanation":"律：约束。严格要求自己。","source":{"text":"严于律己，出而见之事功；心乎爱民，动必关夫治道。","book":"宋·陈亮《谢曾察院启》"}},{"id":3351,"word":"严于责己，宽以待人","pinyin":"yán yú zé jǐ，kuān yǐ dài rén","abbr":"yyzjkydr","explanation":"对自己要求严格，待别人则很宽厚","source":{"text":"老邓总是严于律己，宽以待人，主动承担责任，不使别的同志感到压力。","book":"《忆邓拓·邓拓和人民日报》"},"similar":["严以律己，宽以待人"],"usage":"作谓语、定语、分句；指为人处世"},{"id":3352,"word":"严于鈇钺","pinyin":"yán yú fū yuè","abbr":"yyfy","explanation":"鈇：铡刀；钺：古兵器；鈇钺：指刑戮之具。指揭发、指斥、抨击坏人坏事极其严厉。","source":{"text":"至有若五代之冯道者，历事数君，靦颜就列，使青史诛之，严如鈇钺。","book":"明·吴廷翰《贞烈门坊记》"},"example":{"text":"下一“帝”字，而其母“狗彘不食其余”之语自见，～矣。","book":"清·吴乔《围炉诗话》卷一"}},{"id":3353,"word":"严以律己，宽以字人","pinyin":"yán yǐ lǜ jǐ，kuān yǐ zì rén","abbr":"yyljkyzr","explanation":"对自己要求严格，待别人则很宽厚","source":{"text":"严以律己，宽以字人。","book":"清·汪琬《送张牖如之任南宁序》"},"similar":["严以律己，宽以待人"],"usage":"作谓语、定语、分句；指为人处世"},{"id":3354,"word":"严以律己，宽以待人","pinyin":"yán yǐ lǜ jǐ，kuān yǐ dài rén","abbr":"yyljkydr","explanation":"律：约束。对自己要求严格，待别人则很宽厚。","source":{"text":"‘严以律己，宽以待人’。当然这个宽不是没有原则的。","book":"周恩来《团结广大人民群众一道前进》"},"example":{"text":"我们要有～的思想。"},"similar":["严以律己，宽以字人"],"usage":"作谓语、定语、分句；指为人处世"},{"id":3355,"word":"严刑峻制","pinyin":"yán xíng jùn zhì","abbr":"yxjz","explanation":"犹言严刑峻法。严厉的刑罚和严峻的法令。","source":{"text":"惧万民之有服，则严刑峻制，以贾伤心之怨。","book":"晋·陆机《豪士赋》"},"example":{"text":"孙中山《临时大总统宣告各友邦书》：“～，惨无人理。”"},"similar":["严刑峻法"],"usage":"作宾语、定语；指残暴统治"},{"id":3356,"word":"严刑峻法","pinyin":"yán xíng jùn fǎ","abbr":"yxjf","explanation":"峻：严酷。严厉的刑罚和严峻的法令。","source":{"text":"故严刑峻法，破奸轨之胆。","book":"《后汉书·崔骃传》"},"example":{"text":"若仍～，使直言者常获重谴；日日讲聚敛，使百姓生机愈困，则天下事不堪问矣。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["严刑峻制","深文峻法"],"usage":"作宾语、定语；指残暴统治"},{"id":3357,"word":"严如鈇钺","pinyin":"yán rú fū yuè","abbr":"yrfy","explanation":"鈇：铡刀；钺：古兵器；鈇钺：指刑戮之具。指揭发、指斥、抨击坏人坏事极其严厉。","source":{"text":"至有若五代之冯道者，历事数君，靦颜就列，使青史诛之，严如鈇钺。","book":"明·吴廷翰《贞烈门坊记》"}},{"id":3358,"word":"严家饿隶","pinyin":"yán jiā è lì","abbr":"yjel","explanation":"形容拘谨的书法风格。","source":{"text":"献之虽有父风，殊非新巧。观其字势，疏瘦如隆冬之枯树；览其笔踪，拘束若严家之饿隶。","book":"语出《晋书·王羲之传论》"},"example":{"text":"清·姚鼎《论书绝句》：“姜芽敛处成何状，正得～伦。”"},"usage":"作宾语、定语；用于比喻句"},{"id":3359,"word":"严师出高徒","pinyin":"yán shī chū gāo tú","abbr":"yscgt","explanation":"严：严厉，严格。严格的师傅才能培养出手艺高强的徒弟。","example":{"text":"真是～，一点也没错。"},"usage":"作宾语、定语；指教师严格的重要性"},{"id":3360,"word":"严师畏友","pinyin":"yán shī wèi yǒu","abbr":"yswy","explanation":"严：严格。要求严格的老师和朋友。","source":{"text":"起居饮食每自省，常若严师畏友在我傍。","book":"《论语·季氏》：“益者三友，损者三友。友直、友谅、友多闻，益矣；友便辟、友善柔、友便佞，损矣。”宋·陆游《病起杂言》"},"example":{"text":"而～，又非可亟得之于末世，则夫滔滔者之日趋于下，更奚足怪！","book":"清·梁启超《〈曾文正公嘉言钞〉序》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":3361,"word":"严师益友","pinyin":"yán shī yì yǒu","abbr":"ysyy","explanation":"严：严格；益：有帮助。使人得到教益和帮助的老师和朋友。","source":{"text":"益者三友，损者三友。友直、友谅、友多闻，益矣；友便辟、友善柔、友便佞，损矣。","book":"《论语·季氏》"},"example":{"text":"成性而～不能劝勉，醲赏重罚不能匡正矣。","book":"清·王夫之《读通鉴论·三国》"}},{"id":3362,"word":"严惩不贷","pinyin":"yán chéng bù dài","abbr":"ycbd","explanation":"惩：处罚；贷：宽容。严厉惩罚，绝不宽恕。","source":{"text":"有或违者，必罚不贷。","book":"明·余继登《典故纪闻》"},"example":{"text":"一概不得擅自释放或纵令逃逸，违者～。","book":"毛泽东《中共发言人关于命令国民党反动政府……的谈话》"},"similar":["惩前毖后","绳之以法","杀一儆百"],"opposite":["放任自流","姑息养奸","包庇纵容"],"usage":"作谓语；用于罪犯"},{"id":3363,"word":"严气正性","pinyin":"yán qì zhèng xìng","abbr":"yqzx","explanation":"气：脾气；性：性格。性格刚直，毫不苟且。","source":{"text":"夫严气正性，覆折而已。","book":"南朝·宋·范晔《后汉书·孔融传论》"},"example":{"text":"必须～，晓以利害。","book":"清·林则徐《谕洋商责令夷人呈缴烟土稿》"},"usage":"作谓语、定语；用于书面语"},{"id":3364,"word":"严父慈母","pinyin":"yán fù cí mǔ","abbr":"yfcm","explanation":"严：严格；慈：慈爱。严厉的父亲，慈祥的母亲。","source":{"text":"纳诲于严父慈母。","book":"晋·夏侯湛《昆弟诰》"},"example":{"text":"～的教育方式对孩子成长有利。"},"usage":"作主语、宾语、定语；指父母"},{"id":3365,"word":"严词厉色","pinyin":"yán cí lì sè","abbr":"ycls","explanation":"色：脸色。说话很严厉，脸色很严肃。","source":{"text":"要送木兰到营中去，反是木兰严词厉色催逼转来。","book":"清·褚人获《隋唐演义》第56回"},"example":{"text":"我～地拒绝了他。"},"usage":"作宾语、状语；指人很严肃"},{"id":3366,"word":"严词拒绝","pinyin":"yán cí jù jué","abbr":"ycjj","explanation":"用严厉的话加以拒绝。","source":{"text":"同时老段又借题发挥，要求黎元洪总统解散国会，黎严词拒绝之。","book":"冯玉祥《我的生活》第23章"},"usage":"作谓语；指正式拒绝"},{"id":3367,"word":"严阵以待","pinyin":"yán zhèn yǐ dài","abbr":"yzyd","explanation":"指做好充分战斗准备，等待着敌人。","source":{"text":"甲辰，帝亲勒六军，严阵以待之。","book":"《资治通鉴·汉纪·光武帝建武三年》"},"example":{"text":"鲍叔牙闻鲁侯引兵而来，乃～。","book":"明·冯梦龙《东周列国志》第十六回"},"similar":["枕戈待旦","厉兵秣马"],"opposite":["麻木不仁","麻痹大意"],"usage":"作谓语、定语；指做好准备"},{"id":3368,"word":"严陈以待","pinyin":"yán chén yǐ dài","abbr":"ycyd","explanation":"指做好充分战斗准备，等待着敌人。同“严阵以待”。"},{"id":3369,"word":"严限追比","pinyin":"yán xiàn zhuī bǐ","abbr":"yxzb","explanation":"追比：旧时地方官吏严逼百姓限期交税完粮，逾期受杖责叫“追比”。要求任务定期完成，否则将受重罚。","source":{"text":"宰严限追比，旬余，杖至百，两股间脓血流离，并虫不能行捉矣。","book":"清·蒲松龄《聊斋志异·促织》"}},{"id":3370,"word":"严霜夏零","pinyin":"yán shuāng xià líng","abbr":"ysxl","explanation":"零：凋零。由于受寒霜摧残，夏季的草木都凋零了。比喻无道的君王恣意暴虐。","source":{"text":"忤意者严霜夏零，阿旨者膏雨冬澍，荣枯由其脣吻，废兴候其指麾。","book":"《隋书·梁毗传》"}},{"id":3371,"word":"严霜烈日","pinyin":"yán shuāng liè rì","abbr":"yslr","explanation":"比喻艰苦环境下的严峻考验或经受此考验的刚毅节操。亦作“烈日秋霜”、“秋霜烈日”。"},{"id":3372,"word":"丧伦败行","pinyin":"sàng lún bài xíng","abbr":"slbx","explanation":"丧：丧失；伦：人伦；败：败坏；行：品行。丧失了人伦，败坏了品行。","source":{"text":"此亦系理数应然，只因你前生淫奔不才，使人家丧伦败行，故有此报。","book":"清·曹雪芹《红楼梦》第六十九回"},"usage":"作谓语、定语；用于为人"},{"id":3373,"word":"丧天害理","pinyin":"sàng tiān hài lǐ","abbr":"sthl","explanation":"做事凶狠残忍，全无道德。","source":{"text":"话说老残与申东造议论玉贤正为有才，急于做官，所以丧天害理，至于如此。","book":"《老残游记》第七回"},"example":{"text":"欺负狐儿寡妇，～。","book":"巴金《春》六"},"similar":["伤天害理"],"usage":"作谓语、定语；指做事违背天道"},{"id":3374,"word":"丧失殆尽","pinyin":"sàng shī dài jìn","abbr":"ssdj","explanation":"全部失去。","example":{"text":"祖传的美德在他身上～。"},"usage":"作谓语；指全部失去"},{"id":3375,"word":"丧家之犬","pinyin":"sàng jiā zhī quǎn","abbr":"sjzq","explanation":"无家可归的狗。比喻无处投奔，到处乱窜的人。","source":{"text":"东门有人，其颡似尧，其项类皋陶，其肩类子产，然自要以下不及禹三寸，累累若丧家之狗。","book":"《史记·孔子世家》"},"example":{"text":"敌人溃不成军，惶惶如～。"},"similar":["过街老鼠"],"opposite":["耀武扬威"],"usage":"作宾语；指到处乱窜的人","story":["春秋时期，孔子带领他的学生到各诸侯国讲学，因孔子是保守派，与当时诸侯争霸不合拍，常常受到冷遇。一次孔子与弟子走散，孔子呆在东门旁发呆，子贡问郑国人孔子在何处。郑国人说东门边有个老头子像一只丧家之狗在发呆"]},{"id":3376,"word":"丧家之狗","pinyin":"sàng jiā zhī gǒu","abbr":"sjzg","explanation":"比喻失去依靠、无处投奔或惊慌失措的人。","source":{"text":"他两个忙忙如丧家之狗，急急似漏网之鱼。","book":"《史记·孔子世家》：“东门有人，其颡似尧，其项类皋陶，其肩类子产，然自要以下不及禹三寸，累累若丧家之狗。”元·郑廷玉《后庭花》第二折"},"example":{"text":"操亲掣宝剑押阵，率众连夜追杀，剿戮极多，降者不计其数。傕、汜望西逃命，忙忙似～。","book":"明·罗贯中《三国演义》第十四回"},"similar":["丧家之犬"],"opposite":["耀武扬威"],"usage":"作宾语；指到处乱窜的人","story":["春秋时期，孔子带领他的学生到各诸侯国讲学，因孔子是保守派，与当时诸侯争霸不合拍，常常受到冷遇。一次孔子与弟子走散，孔子呆在东门旁发呆，子贡问郑国人孔子在何处。郑国人说东门边有个老头子像一只丧家之狗在发呆"]},{"id":3377,"word":"丧尽天良","pinyin":"sàng jìn tiān liáng","abbr":"sjtl","explanation":"丧：丧失；天良：良心。没有一点良心。形容恶毒到了极点。","source":{"text":"今人既富贵骄奢矣，而又丧尽天良。","book":"清·钱泳《履园丛话·臆论·利己》"},"example":{"text":"如今～的官府要害他们，因此上我家里躲几天。","book":"欧阳山《三家巷》二六"},"similar":["丧心病狂","惨无人道"],"opposite":["乐善好施","大慈大悲","德高望重"],"usage":"作谓语、定语；指坏人"},{"id":3378,"word":"丧师失地","pinyin":"sàng shī shī dì","abbr":"sssd","explanation":"军队受到损失，国土被失陷。","source":{"text":"宋江正色道：‘众兄弟何如此颓唐！古人一成一旅，尚可中兴。今我虽丧师失地，而现存人马尚有八万，岂不可以有为？为今之计，但求军师设法打个胜仗，便好固住众心了。’","book":"清·俞万春《荡寇志》第一百三十二回"},"example":{"text":"明朝接连打败仗，～。","book":"吴晗《爱国学者顾炎武》"}},{"id":3379,"word":"丧师辱国","pinyin":"sàng shī rǔ guó","abbr":"ssrg","explanation":"军队损失，国家蒙受耻辱。","source":{"text":"前日正被蔡京、童贯、高俅在天子面前，劾奏你的哥哥宋先锋复军杀将，丧师辱国，大肆诽谤，欲皇上加罪。","book":"明·施耐庵《水浒传》第九十七回"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“为了激励士气，凡是～的文武官员，都要严办。”"},"usage":"作谓语、定语；用于书面语"},{"id":3380,"word":"丧心病狂","pinyin":"sàng xīn bìng kuáng","abbr":"sxbk","explanation":"丧失理智，象发了疯一样。形容言行昏乱而荒谬，或残忍可恶到了极点。","source":{"text":"公不丧心病狂，奈何为此？必遗臭万世矣。","book":"《宋史·范如圭传》"},"example":{"text":"但是顽固派反对派对于进步文化机关的违法摧残其合法的事业，其～，可谓已达极点。","book":"邹韬奋《患难余生记·进步文化的遭难》"},"similar":["丧尽天良","穷凶极恶"],"opposite":["平心静气","心平气和"],"usage":"作谓语、定语；指人发昏","story":["南宋时期，秦桧被金太宗的弟弟挞懒遣送回南宋，他谎称自己杀死看守逃回南宋，取得宋高宗的信任，担任宰相，主张对金称臣，谋害抗金的岳飞父子，校书郎范如圭气愤地责问秦桧为什么会是如此丧心病狂、倒行逆施呢？"]},{"id":3381,"word":"丧明之痛","pinyin":"sàng míng zhī tòng","abbr":"smzt","explanation":"丧明：眼睛失明。古代子夏死了儿子，哭瞎眼睛。后指丧子的悲伤。","source":{"text":"子夏丧其子而丧其明。","book":"《礼记·檀弓上》"},"example":{"text":"同寅当中，一人传十，十人传百，已经有许多人知道他遭了“～”。","book":"清·吴趼人《二十年目睹之怪现状》第八十七回"},"similar":["痛抱西河"],"usage":"作宾语；指丧子的悲伤"},{"id":3382,"word":"丧权辱国","pinyin":"sàng quán rǔ guó","abbr":"sqrg","explanation":"丧：丧失；辱：使受到耻辱。丧失主权，使国家蒙受耻辱。","source":{"text":"一字不易地接受了璞鼎查提出的条款，签订了中国近代史上第一个丧权辱国的不平等条约——《江宁条约》。","book":"郭沫若《中国史稿》第五编第一章第一节"},"example":{"text":"惩办～的官僚！","book":"欧阳山《柳暗花明》"},"similar":["卖国求荣","奴颜婢膝"],"opposite":["光宗耀祖","光耀门庭"],"usage":"作谓语、定语；指丧失主权"},{"id":3383,"word":"丧气垂头","pinyin":"sàng qì chuí tóu","abbr":"sqct","explanation":"丧气：神情沮丧；垂头：耷拉着脑袋。形容因失败或不顺利而情绪低落、萎蘼不振的样子。","source":{"text":"主人于是垂头丧气，上手称谢。","book":"唐·韩愈《送穷文》"},"example":{"text":"宋子英立起身来，逼近萧静园的身旁再三追问，方见他无精打彩，～，一付不高兴的样子。","book":"清·张春帆《九尾龟》第五十八回"}},{"id":3384,"word":"丧气鬼","pinyin":"sàng qì guǐ","abbr":"sqg","explanation":"指不愉快的人或脾气坏的人。","example":{"text":"不要理会这个～，否则会招惹麻烦的。"},"usage":"作宾语、定语；用于口语"},{"id":3385,"word":"丧胆亡魂","pinyin":"sàng dǎn wáng hún","abbr":"sdwh","explanation":"形容害怕到了极点。","source":{"text":"但凡拿住的人呵，见了俺丧胆亡魂，今朝拿住这斯，面不改色。","book":"元·秦简夫《赵礼让肥》第二折"},"example":{"text":"清·钱彩《说岳全传》第76回：“当年跟你老子横冲直撞，杀得那些金兵、湖寇，～。”"},"similar":["丧胆游魂","丧胆消魂","丧胆销魂"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；指惊恐"},{"id":3386,"word":"丧胆消魂","pinyin":"sàng hún xiāo hún","abbr":"sdxh","explanation":"丧：丧失；消：失去。形容惊恐到极点。","source":{"text":"今日路当险处，遇此劲敌，那残兵又都是个伤弓之鸟，谁人不丧胆消魂！","book":"明·冯梦龙《东周列国志》第41回"},"similar":["丧胆销魂","丧胆亡魂"],"usage":"作谓语、定语、状语；指惊恐"},{"id":3387,"word":"丧胆游魂","pinyin":"sàng dǎn yóu hún","abbr":"sdyh","explanation":"形容惶恐无主的样子。","source":{"text":"在街上丧胆游魂地走了几天，没有一点用。","book":"老舍《骆驼祥子》二三：“祥子在街上丧胆游魂的走，遇见了小马儿的祖父。”又《月牙儿》"},"example":{"text":"他～地走了几天，没有一点用"},"similar":["丧胆亡魂"],"usage":"作谓语、定语、状语；指惊恐"},{"id":3388,"word":"丧胆销魂","pinyin":"sàng hún xiāo hún","abbr":"sdxh","explanation":"丧、销：失去。形容惊恐到极点。","source":{"text":"暗自凝睛，不由我不丧胆销魂忽地惊。","book":"元·无名氏《冯玉兰》第四折"},"similar":["丧胆亡魂","丧胆消魂"],"usage":"作谓语、定语、状语；指惊恐"},{"id":3389,"word":"丧言不文","pinyin":"sāng yán bù wén","abbr":"sybw","explanation":"指居丧期间言辞要朴质。","source":{"text":"孝子之丧亲也，哭不依，礼无容，言不文，服美不安，闻乐不乐，食旨不甘，此哀戚之情也。","book":"《孝经·丧亲篇》"},"example":{"text":"～，故知君子常言未尝质也。","book":"南朝·梁·刘勰《文心雕龙·情采》"},"usage":"作宾语、定语；用于书面语"},{"id":3390,"word":"丧身失节","pinyin":"sàng shēn shī jié","abbr":"sssj","explanation":"身受污辱，失去节操。","source":{"text":"以妙玉之孤洁而横罹盗窟，并被以丧身失节之名，……并加以嗜利受赇之谤，作者盖深痛之也。","book":"鲁迅《小说旧闻钞·红楼梦》"},"usage":"作宾语、定语；用于书面语"},{"id":3391,"word":"丧门星","pinyin":"sàng mén xīng","abbr":"smx","explanation":"爱争吵的人。比喻带来灾祸或者晦气的人。","source":{"text":"犯着这位丧门星，事情可就大大的不妥了，我先去碰碰看罢！","book":"清·刘鹗《老残游记》第四回"},"example":{"text":"不能跟这个～接触。"},"similar":["丧门神","扫帚星"],"usage":"作宾语、定语；用于骂人等"},{"id":3392,"word":"丧门神","pinyin":"sāng mén shén","abbr":"sms","explanation":"指专管死丧哭泣的凶神，比喻给人带来晦气的人。","source":{"text":"山上有个强人，平生只好杀人，世人把他比做丧门神，姓鲍名旭。","book":"明·施耐庵《水浒传》第67回"},"example":{"text":"你这个～还不快走开。"},"similar":["丧门星"],"usage":"作宾语、定语；用于骂人等"},{"id":3393,"word":"丧魂失魄","pinyin":"sàng hún shī pò","abbr":"shsp","explanation":"失去了魂魄。形容非常惊慌或心神不宁的样子。","source":{"text":"自从新思潮来到中国以后，其实何尝有力，而一群老头子，还有少年，却已丧魂失魄的来讲国故了。","book":"鲁迅《坟·未有天才之前》"},"example":{"text":"自你一气出门以后，我是和～一般，就活着也没有意思！","book":"欧阳予倩《潘金莲》第五幕"},"similar":["魂不附体","惊慌失措","丧魂落魄"],"opposite":["泰然自若","若无其事"],"usage":"作谓语、定语、状语；指惊恐"},{"id":3394,"word":"丧魂落魄","pinyin":"sàng hún luò pò","abbr":"shlp","explanation":"失去了魂魄。形容非常惊慌、恐惧的样子。","source":{"text":"鬼子山本踉跄了一下，岔开两腿，丧魂落魄地瞥了一眼从死尸堆里露出半个脸的川岛。","book":"管桦《惩罚》"},"example":{"text":"他早已吓得～了。"},"similar":["魂不附体","惊慌失措","丧魂失魄"],"opposite":["泰然自若","若无其事"],"usage":"作谓语、定语、状语；指惊恐"},{"id":3395,"word":"个中之人","pinyin":"gè zhōng zhī rén","abbr":"gzzr","explanation":"指曾亲历其间或深明其中情理的人。","source":{"text":"据下官看起来，不是个中之人。","book":"明·凌濛初《二刻拍案惊奇》第七卷"},"similar":["个中人"],"usage":"作主语、宾语；指局内人"},{"id":3396,"word":"个中人","pinyin":"gè zhōng rén","abbr":"gzr","explanation":"个中：其中。此中人。指亲历其境或深明其中情理的人。也指风尘中人，妓女。","source":{"text":"平生自是个中人，欲向渔舟便写真。诗句对君难出手，云泉劝我早抽身。","book":"宋·苏轼《李颀秀才善画山，以两轴见寄，仍有诗，次韵答之》"},"example":{"text":"即是憨师弟子，同是～，无妨一戏。","book":"清·蒲松龄《聊斋志异·武技》"},"similar":["个中之人"],"usage":"作主语、宾语；指局内人"},{"id":3397,"word":"个中妙趣","pinyin":"gè zhōng miào qù","abbr":"gzmq","explanation":"个中：其中；妙：美妙，奇妙；趣：情趣。其中的奥妙之处和情趣。","source":{"text":"个中妙趣谁堪语，最是初醮未醉时。","book":"宋·陆游《剑南诗稿·十一·对酒二首》"},"usage":"作主语、宾语；用于口语"},{"id":3398,"word":"个中滋味","pinyin":"gè zhōng zī wèi","abbr":"gzzw","explanation":"个中：其中；滋味：味道，情味。其中的味道。指切身体会的甘苦。","source":{"text":"居士何如学士，翰林休笑芗林。个中真味少知音，不是清狂太甚。","book":"宋·向子谚《西江月·绍兴丁巳，遍走浙东诸郡……》"},"example":{"text":"编程是很辛苦的，～只有程序员才能体会"},"usage":"作主语、宾语；指切身体会的甘苦"},{"id":3399,"word":"个人主义","pinyin":"gè rén zhǔ yì","abbr":"grzy","explanation":"自私自利。","source":{"text":"这是小资产阶级个人主义的表现。","book":"毛泽东《关于纠正党内的错误思想》"},"example":{"text":"在某些党员中还存在着比较浓厚的～和自私自利的思想意识。","book":"《个人和集体》"},"usage":"作主语、宾语、定语；指人自顾自我"},{"id":3400,"word":"个人崇拜","pinyin":"gè rén chóng bài","abbr":"grcb","explanation":"以个人作为别人崇拜的对象。","source":{"text":"党和国家的民主生活逐渐不正常，一言堂、个人决定重大问题、个人崇拜、个人凌驾于组织之上一类家长制现象，不断滋长。","book":"邓小平《党和国家领导制度的改革》"},"example":{"text":"章诒和《往事并不如烟·最后的贵族》：“一个是极端～；一个是极端专制主义。”"},"usage":"作宾语、定语；用于为人处世"},{"id":3401,"word":"中书君","pinyin":"zhōng shū jūn","abbr":"zsj","explanation":"指毛笔。","source":{"text":"醉笔得天全，宛宛天投霓。多谢中书君，伴我此幽栖。","book":"宋·苏轼《自笑》"},"example":{"text":"管城子、～，悉为笔号；石虚中、即墨侯，皆为砚称。（明·程登吉《幼学琼林·器用》）"},"usage":"作主语、宾语；用于书面语"},{"id":3402,"word":"中人之姿","pinyin":"zhōng rén zhī zī","abbr":"zrzz","explanation":"中：中等。人的相貌中等。形容无特别之处。","example":{"text":"人家公主之尊，就算没有沉鱼落雁之容，～总是有的。（金庸《天龙八部》第四十六回）"}},{"id":3403,"word":"中冓之言","pinyin":"zhōng gòu zhī yán","abbr":"zgzy","explanation":"中冓：内室。内室的私房话。也指有伤风化的丑话。","source":{"text":"中冓之言，不可道也。","book":"《诗经·鄘风·墙有茨》"},"example":{"text":"不窥人闺门之私，听闻～。","book":"东汉·班固《汉书·文三王传》"},"usage":"作主语、宾语；指私房话"},{"id":3404,"word":"中原板荡","pinyin":"zhōng yuán bǎn dàng","abbr":"zybd","explanation":"中原：指我国中部，泛指天下；板荡：本《诗经》篇名，内容指周厉王昏淫无道。常用以比喻时局动荡危急。","source":{"text":"中原板荡，夷狄交浸。","book":"宋·岳飞《五岳祠盟题记》"},"usage":"作宾语、定语；用于书面语"},{"id":3405,"word":"中原逐鹿","pinyin":"zhōng yuán zhú lù","abbr":"zyzl","explanation":"逐：追赶；鹿：指所要围捕的对象，常比喻帝位、政权。指群雄并起，争夺天下。","source":{"text":"秦失其鹿，天下共逐之。","book":"《史记·淮阴侯列传》"},"example":{"text":"中原初逐鹿，投笔事戎轩。","book":"唐·魏征《述怀》诗"},"similar":["逐鹿中原"],"usage":"作主语、宾语；指争夺政权","story":["晋朝时北方的五胡十六国中赵国国王石勒十分有才干，但自以为是，有一次他问大臣徐光他能与历史上哪位皇帝相提并论。徐光答复为汉高祖刘邦。他笑道他只能做刘邦的部下，但与刘秀并驱于中原，相互较量，那就不知鹿死谁手了"]},{"id":3406,"word":"中外古今","pinyin":"zhōng wài gǔ jīn","abbr":"zwgj","explanation":"指从国内到国外，从古代到现代。泛指时间久远，空间广阔。","source":{"text":"历观古今中外正史小说所记载英雄患难之事，惊心动魄者，不一而足。","book":"清·梁启超《意大利建国三杰传》第五节"},"example":{"text":"不过这个社不仅仅专修国学了，社里人员研究～的文学，许多是专象家和有名的学者。（杨绛《洗澡》第一部第三章）"},"similar":["古今中外"],"usage":"作宾语、定语、状语；指古代现代国内外"},{"id":3407,"word":"中外合壁","pinyin":"zhōng wài hé bì","abbr":"zwhb","explanation":"合璧：圆形有孔的玉叫璧，半圆形的叫半璧，两个半璧合成一个圆叫“合璧”。比喻中国和外国的好东西合到一块。","source":{"text":"这长苗子是我们中国原有的，如今搀在这德国操内，中又不中，外又不外，倒成了一个中外合璧。","book":"清·李宝嘉《官场现形记》第三十一回"}},{"id":3408,"word":"中外合璧","pinyin":"zhōng wài hé bì","abbr":"zwhb","explanation":"中西合璧。","source":{"text":"这长苗子是我们中国原有的，如今搀在这德国操内，中又不中，外又不外，倒成了一个中外合璧。","book":"清·李宝嘉《官场现形记》第三十一回"},"similar":["中西合璧"],"usage":"作宾语、定语；用于书面语"},{"id":3409,"word":"中外驰名","pinyin":"zhōng wài chí míng","abbr":"zwcm","explanation":"驰名：名声远扬。名声传遍了国内外。","source":{"text":"女主人又是中外驰名的美人，我要把《清平调》的‘名花倾国两相欢’，改做‘倾城名士两相欢’了。","book":"曾朴《孽海花》第32回"},"example":{"text":"海南的苦丁茶～。"},"similar":["驰名中外"],"usage":"作谓语、定语；指有名的人或事物"},{"id":3410,"word":"中天之世","pinyin":"zhōng tiān zhī shì","abbr":"ztzs","explanation":"即盛世。用以称赞帝王功德，古时多称尧舜禹三世为中天之世。","source":{"text":"伏惟陛下年隆德茂，中天称号。","book":"《后汉书·刘陶传》"}},{"id":3411,"word":"中天婺焕","pinyin":"zhōng tiān wù huàn","abbr":"ztwh","explanation":"中天：天空中间；婺：婺女星；焕：发光。天空中婺女星光彩耀人。多用于祝贺妇女寿诞。","source":{"text":"贺男寿曰南极星辉，贺女寿曰中天婺焕。","book":"明·程登吉《幼学琼林·老幼寿诞》"},"usage":"作宾语、定语；用于妇女寿诞的贺辞"},{"id":3412,"word":"中山狼","pinyin":"zhōng shān láng","abbr":"zsl","explanation":"比喻恩将仇报，忘恩负义的人。","source":{"text":"子系中山狼，得志便猖狂。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"小心不要被～所害。"},"usage":"作宾语、定语；指忘恩负义的人","story":["春秋时期，晋国大夫赵简子在中山举行狩猎，遇到一只狼就拼命追赶。狼遇到东郭先生说：“先生能借你的口袋让我苟延残喘躲一会，躲过这场灾难，我会报答你的大恩的。”东郭先生帮助了狼。后来狼安全跳出布袋扑向东郭先生咬去"]},{"id":3413,"word":"中庸之道","pinyin":"zhōng yōng zhī dào","abbr":"zyzd","explanation":"指不偏不倚，折中调和的处世态度。","source":{"text":"中庸之为德也，其至矣乎。","book":"《论语·庸也》"},"example":{"text":"他一面想，这既无闭关自守之操切，也没有开放门户之不安：是很合于“～”的。","book":"鲁迅《彷徨·幸福的家庭》"},"similar":["不偏不倚"],"opposite":["厚此薄彼","偏听偏信"],"usage":"作主语、宾语；指中间派"},{"id":3414,"word":"中心如噎","pinyin":"zhōng xīn rú yē","abbr":"zxry","explanation":"中心：内心；噎：食物堵住了食管。心中郁闷，象有食物堵住了喉咙一样。形容人的内心愁苦。","source":{"text":"彼黍离离，彼稷之实。行迈靡靡，中心如噎。","book":"《诗经·王风·黍离》"},"usage":"作宾语、定语；用于书面语"},{"id":3415,"word":"中心如醉","pinyin":"zhōng xīn rú zuì","abbr":"zxrz","explanation":"中心：心中；醉：醉酒。心中恍惚不清，像醉酒的感觉一样。","source":{"text":"彼黍离离，彼稷之穗。行迈靡靡，中心如醉。知我者谓为心忧，不知我者谓我何求。","book":"《诗经·王风·黍离》"},"example":{"text":"不见君子，～；一日三岁，我劳如何？（《魏书·王肃传》）"},"usage":"作宾语、定语；用于书面语"},{"id":3416,"word":"中心摇摇","pinyin":"zhōng xīn yáo yáo","abbr":"zxyy","explanation":"中心：心中；摇摇：心神不安。形容心神恍惚，难以自持。","source":{"text":"彼黍离离，彼稷之苗。行迈靡靡，中心摇摇。知我者谓为心忧，不知我者谓我何求。","book":"《诗经·王风·黍离》"},"similar":["心神恍惚"],"usage":"作谓语、定语；指心神恍惚"},{"id":3417,"word":"中心是悼","pinyin":"zhōng xīn shì dào","abbr":"zxsd","explanation":"悼：哀痛。内心十分悲哀痛苦。","source":{"text":"羔裘如膏，日出有曜。岂不尔思？中心是悼。","book":"《诗经·桧风·羔裘》"},"usage":"作宾语、定语；用于书面语"},{"id":3418,"word":"中心藏之","pinyin":"zhōng xīn cáng zhī","abbr":"zxcz","explanation":"中心：心中。埋藏在心里。","source":{"text":"中心藏之，何日忘之。","book":"《诗经·小雅·隰桑》"},"example":{"text":"南朝·宋·刘义庆《世说新语·仇隙》：“后秀为中书令，岳省内见之，因唤曰：‘孙令忆畴昔周旋不？’秀曰：‘～，何日忘之。’”"},"usage":"作谓语、定语；用于书面语"},{"id":3419,"word":"中情烈烈","pinyin":"zhōng qíng liè liè","abbr":"zqll","explanation":"中：内心；烈烈：炽热，强烈。指感情热烈。","source":{"text":"外貌桓桓，中情烈烈，知人勤劳，悉人饥寒，此万夫之将","book":"三国·蜀·诸葛亮《将苑》卷一"}},{"id":3420,"word":"中正九品","pinyin":"zhōng zhèng jiǔ pǐn","abbr":"zzjp","explanation":"品：等级。从魏晋南北朝开始实行选拔官吏的等级制度。","source":{"text":"至于中正九品，上圣古贤，皆所不为，岂蔽于此事而有所不周哉，将以政化之宜无取于此也。","book":"《晋书·刘毅传》"},"similar":["九品中正"],"usage":"作宾语、定语；用于书面语"},{"id":3421,"word":"中正无私","pinyin":"zhōng zhèng wú sī","abbr":"zzws","explanation":"中正：正直。正直而无私心。","source":{"text":"为人君者中正而无私，为人臣者忠信而不党。","book":"《管子·五辅》"},"similar":["公正无私"],"usage":"作宾语、定语、状语；用于为人处世"},{"id":3422,"word":"中正无邪","pinyin":"zhōng zhèng wú xié","abbr":"zzwx","explanation":"中正：正直。正直而没有邪念。","source":{"text":"中正无邪，礼之质也。","book":"《礼记·乐记》"},"usage":"作谓语、定语；用于书面语"},{"id":3423,"word":"中江举帆","pinyin":"zhōng jiāng jǔ fān","abbr":"zjjf","explanation":"中：到中心；举：升起，扬起。到江中心升起船帆。","source":{"text":"十舰最著前，中江举帆，余船以次俱进。","book":"宋·司马光《资治通鉴》"},"usage":"作谓语；指到江中心升起船帆"},{"id":3424,"word":"中河失舟，一壶千金","pinyin":"zhōng hé shī zhō，yī hú qiān jīn","abbr":"zhszyhqj","explanation":"比喻东西虽然轻微，用得到的时候便十分珍贵。","source":{"text":"中河失船，一壶千金，贵贱无常，时使物然。","book":"《遏冠子·学问》"}},{"id":3425,"word":"中流一壶","pinyin":"zhōng liú yī hú","abbr":"zlyh","explanation":"壶：指瓠类，系之可以不沉。比喻珍贵难得。","source":{"text":"中河失船，一壶千金。","book":"《鹖冠子·学问》"},"example":{"text":"持论有本，不堕矫激，亦足为～。","book":"清·李慈铭《越缦堂读书记·俞楼杂纂》"},"usage":"作宾语、定语；指救命稻草"},{"id":3426,"word":"中流一壸","pinyin":"zhōng liú yī kǔn","abbr":"zlyk","explanation":"比喻可贵难得。","source":{"text":"语出《鹖冠子·学问》：“中河失船，一壸千金。”壶，指瓠类，系之可以不沉。"}},{"id":3427,"word":"中流击枻","pinyin":"zhōng liú jī yì","abbr":"zljy","explanation":"击：敲打；枻：浆。指到中流时敲着船桨起誓。比喻立志奋发图强。","source":{"text":"中流击楫而誓曰：‘祖逖不能清中原而复济者，有如大江。’","book":"《晋书·祖逖传》"},"similar":["中流击楫","击楫中流"],"usage":"作谓语、定语；指人立志"},{"id":3428,"word":"中流击楫","pinyin":"zhōng liú jī jí","abbr":"zljj","explanation":"击：敲打；楫：浆。比喻立志奋发图强。","source":{"text":"中流击楫而誓曰：‘祖逖不能清中原而复济者，有如大江。’","book":"《晋书·祖逖传》"},"example":{"text":"～，着祖生之鞭；下濑横戈，成汉武之志。","book":"《晚清文学丛钞·童子军·草檄》"},"similar":["奋发图强","击楫中流"],"opposite":["委靡不振"],"usage":"作谓语、定语；指人立志","story":["晋元帝在江南建立东晋，北方及中原的大部分土地被外族所占。祖逖准备率军收复中原，朝廷只给他奋威将军的虚名，祖逖率领他的100多家人渡江北伐，在江中中流击楫，发誓收复中原。后来他果真收复大片失地，但东晋根本无心抗战"]},{"id":3429,"word":"中流失舟，一壶千金","pinyin":"zhōng liú shī zhōu，yī hú qiān jīn","abbr":"zlszyhqj","explanation":"壶：匏：一种瓜，形似葫芦，佩带在腰间可以渡河，南方称为腰舟。比喻东西虽然轻微，用得到的时候便十分宝贵。","source":{"text":"中河失船，一壶千金，贵贱无常，时物使然。","book":"《鹖冠子·学问》"},"example":{"text":"顾柳子既遭斥，不得一有力者推挽，韩子惜之，则～，固韩柳之所同悲矣。","book":"清·黄式三《读柳子厚集》"}},{"id":3430,"word":"中流底柱","pinyin":"zhōng liú dǐ zhù","abbr":"zldz","explanation":"中流：河流中央。就像屹立在黄河急流中的砥柱山一样。比喻坚强而能起支柱作用的人或集体","source":{"text":"而二公在朝，天下望之，屹立若中流之底柱，有所恃而不恐。","book":"宋·朱熹《与陈侍郎书》"},"similar":["中流砥柱"],"usage":"作定语、宾语；指中心人物"},{"id":3431,"word":"中流砥柱","pinyin":"zhōng liú dǐ zhù","abbr":"zldz","explanation":"就象屹立在黄河急流中的砥柱山一样。比喻坚强独立的人能在动荡艰难的环境中起支柱作用。","source":{"text":"吾尝从君济于河，鼋衔左骖，以入砥柱之中流。","book":"《晏子春秋·内篇谏下》"},"example":{"text":"长淮横溃祸非轻，坐见～倾。","book":"明·丁鹤年《自咏》"},"similar":["砥柱中流","擎天柱石"],"opposite":["随波逐流"],"usage":"作定语、宾语；指中心人物","story":["上古时代，黄河三门峡河道狭窄处有一座山矗立在黄河的急流中，影响河水的通行，大禹治水时把两边的河道凿宽，这样这座砥柱山就像一根柱子一样立在急流之中。三门峡分人门、神门及鬼门，其中鬼门最险，而砥柱却巍然屹立在急流中"]},{"id":3432,"word":"中留不报","pinyin":"zhòng liú bù bào","abbr":"zlbb","explanation":"指皇帝把臣下的奏章留于禁宫中，不交议也不批答。","source":{"text":"四月癸未，奏未央宫，留中不下。","book":"《史记·三王世家》"},"example":{"text":"你不要搞～那一套"},"similar":["留中不下"],"usage":"作谓语、宾语；用于封建文书等"},{"id":3433,"word":"中看不中吃","pinyin":"zhōng kàn bù zhōng chī","abbr":"zkbzc","explanation":"比喻外表好看，其实不中用。","source":{"text":"什么‘如何是好？’都撵出去，不要这些‘中看不中吃’的就完了！","book":"清·曹雪芹《红楼梦》第58回"},"example":{"text":"这个番贼，原来～的。","book":"清·钱彩《说岳全传》第75回"},"similar":["好看不好吃"],"usage":"作谓语、定语；指外表好看的事物"},{"id":3434,"word":"中看不中用","pinyin":"zhōng kàn bù zhōng yòng","abbr":"zkbzy","explanation":"比喻外表好看，其实不中用。","example":{"text":"请把这些～的东西收起来。"},"similar":["中看不中吃"],"usage":"作谓语、定语；指外表好看的事物"},{"id":3435,"word":"中石没矢","pinyin":"zhòng shí mò shǐ","abbr":"zsms","explanation":"中：射中；没：埋没。箭射中顽石，被埋没在顽石之中。形容力大无比。","source":{"text":"广出猎，见草中石，以为虎而射之，中石没矢。视之，石也。","book":"《汉书·李广传》"}},{"id":3436,"word":"中立不倚","pinyin":"zhōng lì bù yǐ","abbr":"zlby","explanation":"倚：偏。保持中立，不偏不倚。","source":{"text":"故君子和而不流，强哉矫；中立而不倚，强哉矫。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"况～，道直气平，介然风规。","book":"唐·白居易《除裴度中书舍人制》"},"similar":["不偏不倚"],"opposite":["偏听偏信"],"usage":"作谓语、定语；指不偏不倚"},{"id":3437,"word":"中西合璧","pinyin":"zhōng xī hé bì","abbr":"zxhb","explanation":"合璧：圆形有孔的玉叫璧，半圆形的叫半璧，两个半璧合成一个圆叫“合璧”。比喻中国和外国的好东西合到一块。","source":{"text":"这长苗子是我们中国原有的，如今搀在这德国操内，中又不中，外又不外，倒成了一个中外合璧。","book":"清·李宝嘉《官场现形记》第三十一回"},"example":{"text":"她转过脸去看墙壁上的字画：那也是“～”的，张大千的老虎立轴旁边陪衬着两列五彩铜版印的西洋画。","book":"茅盾《子夜》八"},"similar":["土洋结合","亦中亦西"],"usage":"作宾语、定语；指土洋结合"},{"id":3438,"word":"中途而废","pinyin":"zhōng tú ér fèi","abbr":"ztef","explanation":"废：停止。指做事不能坚持到底，中途停顿，有始无终。","source":{"text":"实愿朝廷特开远略，少复赐宽，假以日月，无使为山之功，中途而废。","book":"《魏书·景穆十二王传》"},"example":{"text":"鹿子霖对两个儿子兆鹏兆海十分看重，瞅定有实现祖宗遗愿的寄托了了，不料～。（陈忠实《白鹿原》第三十三章）"},"similar":["中道而废","中道而止"],"usage":"作谓语、定语、宾语；用于处事"},{"id":3439,"word":"中通外直","pinyin":"zhōng tōng wài zhí","abbr":"ztwz","explanation":"通：通气。内有小孔通气，外表形状挺直。比喻人心胸开阔，行为端正。","source":{"text":"中通外直，不蔓不枝。","book":"宋·周敦颐《爱莲说》"},"usage":"作定语；用于比喻句"},{"id":3440,"word":"中道而废","pinyin":"zhōng dào ér fèi","abbr":"zdef","explanation":"中道：中途。半路就停止了。","source":{"text":"乡道而行，中道而废，忘身之老也，不知年数之不足也，俯焉日有孳孳，毙而后已。","book":"西汉·戴圣《礼记·表记》"},"example":{"text":"他绝对自信他不是～的软背脊的人儿。","book":"茅盾《创造》三"},"similar":["半途而废","中途而废","中道而止"],"usage":"作谓语、定语、宾语；用于处事"},{"id":3441,"word":"中道而止","pinyin":"zhōng dào ér zhǐ","abbr":"zdez","explanation":"走到半路就放弃了前进。比喻事情还没做完就停止了","source":{"text":"我求大法，岂可中道而止。","book":"宋·释道原《景德传灯录·第三十三祖慧能大师》"},"similar":["中道而废","中途而废","半途而废"],"usage":"作谓语、定语、宾语；用于处事"},{"id":3442,"word":"中郎有女","pinyin":"zhōng láng yǒu nǚ","abbr":"zlyn","explanation":"中郎：汉蔡邕，曾官左中郎将，人称蔡中郎，因同情董卓获罪，死于狱中，遗有一女，名琰，字文姬。指没有儿子只有女儿的人","source":{"text":"天津吕某，妇某氏……相夫子，事事尽礼。中郎有女，年十四，已字人。","book":"清·百一居士《壶天录》上卷"},"usage":"作宾语、定语；用于书面语"},{"id":3443,"word":"中郞有女","pinyin":"zhōng láng yǒu nǚ","abbr":"zlyn","explanation":"中郞：后汉蔡邕，曾任左中郞将，被称为蔡中郞，后因罪死于狱中，遗下一女蔡文姬。指只有女儿，没有儿子的人。","source":{"text":"相夫子，事事尽礼。中郞有女，年十四，已字人。","book":"清·淮阴百一居士《壶天录》卷上"}},{"id":3444,"word":"中风狂走","pinyin":"zhòng fēng kuáng zǒu","abbr":"zfkz","explanation":"中风：如同中了邪一样。像中了邪一样到处奔跑。形容举止放纵，行为失常。","source":{"text":"而伯通独中风狂走，自捐盛时，内听娇妇之失计，外信谗邪之谀言，长为群后恶法，永为功臣鉴戒，岂不误哉！","book":"汉·朱浮《为幽州牧与彭宠书》"},"example":{"text":"而道子独～，自弃良时，恃有乌合蚁附之众，甘为祝庄、曾市之续，窃为智者不取焉。（清·俞万春《荡寇志》第九十二回）"},"usage":"作谓语、宾语、状语；用于书面语"},{"id":3445,"word":"中饱私囊","pinyin":"zhōng bǎo sī náng","abbr":"zbsn","explanation":"中饱：从中得利。指侵吞经手的钱财使自己得利。","source":{"text":"薄疑谓赵简主曰：‘君之国中饱。’简主欣然而喜曰：‘何如焉？’对曰：‘府库空虚于上，百姓贫饿于下，然而奸吏富矣。’","book":"《韩非子·外储说右下》"},"example":{"text":"小人贪利，事本非常，所可恨者，银两～，不曾济国家之实用耳。","book":"清·李绿园《歧路灯》第七回"},"similar":["饱其私囊"],"opposite":["大公无私"],"usage":"作谓语、定语、宾语；指贪污"},{"id":3446,"word":"中馈之思","pinyin":"zhōng kuì zhī sī","abbr":"zkzs","explanation":"中馈：借指妻子。指思念能有个主持家务的妻子。","source":{"text":"柴躬自经理，劬劳甚苦，而家中米盐，不食自尽。由是慨然兴中馈之思，聘医药之。","book":"清·蒲松龄《聊斋志异·邵九娘》"},"example":{"text":"宋·蒲松龄《聊斋志异·邵九娘》：“柴躬自经理，劬劳甚苦，而家中米盐，不食自尽。由是概然兴～，聘医药之。”"},"usage":"作宾语；用于书面语"},{"id":3447,"word":"中馈乏人","pinyin":"zhōng kuì fá rén","abbr":"zkfr","explanation":"中馈：古时指妇女在家中主持饮食等事，引申指妻室；乏：缺少。指没有妻子。","source":{"text":"无攸遂，在中馈。","book":"《周易·家人》"},"example":{"text":"不瞒娘子说，小人内帏失助，～，鳏居已久，子息全无。","book":"明·兰陵笑笑生《金瓶梅词话》第十七回"},"similar":["中馈犹虚"],"usage":"作谓语、定语；用于书面语"},{"id":3448,"word":"中馈犹虚","pinyin":"zhōng kuì yóu xū","abbr":"zkyx","explanation":"指没有妻子。","source":{"text":"无攸遂，在中馈。","book":"《周易·家人》"},"example":{"text":"久而久之，～，你便知道鳏居的难处了。","book":"清·吴趼人《二十年目睹之怪两现状》第七十回"},"similar":["中馈乏人"],"usage":"作谓语；指没有妻子"},{"id":3449,"word":"丰上杀下","pinyin":"fēng shàng shài xià","abbr":"fssx","explanation":"丰：丰满；上：上部；杀：尖瘦；下：下部。额头宽而脸颊瘦。形容脸形上宽下尖。","source":{"text":"有丰上杀下，有若水之波，有若山之楫。","book":"《吕氏春秋·明理》"}},{"id":3450,"word":"丰丰满满","pinyin":"fēng fēng mǎn mǎn","abbr":"ffmm","explanation":"指人体胖得适度好看。","source":{"text":"黑眉花眼，一口白牙，身体发育得丰丰满满，正是庄稼人所梦想的那种女人。","book":"路遥《平凡的世界》第二卷第29章"},"usage":"作定语、状语；用于口语"},{"id":3451,"word":"丰亨豫大","pinyin":"fēng hēng yù dà","abbr":"fhyd","explanation":"形容富足兴盛的太平安乐景象。","source":{"text":"宣政间有以夸侈为言者，小人却云当丰亨豫大之时，须是恁地侈泰方得，所以一面放肆，如何得不乱。","book":"《周易·丰》：“丰亨，王假之。”《周易·豫》：“豫大有得，志大行也。”《朱子语类》"},"example":{"text":"八旗兵饷折减，衣食不充，此正焦心劳思之时，非丰亨豫大之日也。","book":"高阳《玉座珠帘》上册"},"usage":"作定语；指好大喜功"},{"id":3452,"word":"丰功伟业","pinyin":"fēng gōng wěi yè","abbr":"fgwy","explanation":"丰：大。伟大的功绩。","source":{"text":"睿谋神断，丰功伟绩，历选明辟，未之前闻。","book":"宋·包拯《天章阁对策》"},"similar":["丰功伟绩","丰功伟烈","丰烈伟绩"],"usage":"作主语、宾语；指人的功劳大"},{"id":3453,"word":"丰功伟烈","pinyin":"fēng gōng wěi liè","abbr":"fgwl","explanation":"丰：多；伟：大，显赫；烈：功业。伟大的功绩和成就。","source":{"text":"吾之徒闻孝王之遗风旧迹，不睹大宋之丰功伟烈。","book":"宋·王仲旉《南都赋》"},"example":{"text":"当其盛时，～，固莫不震赫于当世。","book":"李大钊《厌世心与自觉心》"},"similar":["丰功伟绩","丰功伟业","丰烈伟绩"],"usage":"作主语、宾语；指人的功劳大"},{"id":3454,"word":"丰功伟绩","pinyin":"fēng gōng wěi jì","abbr":"fgwj","explanation":"丰：大。伟大的功绩。","source":{"text":"这位章制军在两广做了几年，也没有什么丰功伟绩。","book":"清·张春帆《宦海》第六回"},"example":{"text":"纪念他在辛亥革命时期，领导人民推翻帝制、建立共和国的～。","book":"毛泽东《纪念孙中山先生》"},"similar":["汗马功劳","功名盖世","功标青史"],"opposite":["罪大恶极","滔天大罪","恶贯满盈"],"usage":"作主语、宾语；指人的功劳大"},{"id":3455,"word":"丰功厚利","pinyin":"fēng gōng hòu lì","abbr":"fghl","explanation":"指巨大的功利。","source":{"text":"帝王之祚，必有明圣，显懿之德，丰功厚利积累之业。","book":"汉·班彪《王命论》"},"example":{"text":"是则岂有国家所以存录能立～之人，而此州之民素蒙其休，顾显然无一忌惮，咸得以名而称之哉。","book":"宋·文同《奏为乞改陵州州名状》"},"usage":"作宾语、定语；用于书面语"},{"id":3456,"word":"丰功懋烈","pinyin":"fēng gōng mào liè","abbr":"fgml","explanation":"丰：丰厚；懋：盛大。巨大隆盛的功业。","source":{"text":"其于善行名言，丰功懋烈，谁得而废之。","book":"金·胡祗橘《木兰花慢》"},"similar":["丰功盛烈","丰功伟绩"],"usage":"作宾语、定语；用于功绩等"},{"id":3457,"word":"丰功懿德","pinyin":"fēng gōng yì dé","abbr":"fgyd","explanation":"巨大的功勋，隆盛的德泽。同“丰功茂德”。","source":{"text":"自先帝初兴，爱暨陛下，荣渊累叶，丰功懿德，策名褒扬，辩著廊庙，胜衣举履，诵咏明文，以为口实。","book":"《三国志·魏志·公孙度传》“诱呼鲜卑，侵扰北方”裴松之注引晋·王沈《魏书》"},"similar":["丰功硕德","丰功茂德"],"usage":"作宾语、定语；用于书面语"},{"id":3458,"word":"丰功盛烈","pinyin":"fēng gōng shèng liè","abbr":"fgsl","explanation":"犹言丰功伟绩。巨大隆盛的功业。","source":{"text":"其丰功盛烈，所以铭彝鼎而被弦歌者，乃邦家之光，非闾里之荣也。","book":"宋·欧阳修《相州昼锦堂记》"},"example":{"text":"……迹其～纪载于是编者，未易以穷日睹记，然掇其大者，不出乎此二言而已。","book":"明·洪富《重刻〈金蛇粹编〉后序》"},"similar":["丰功懋烈"],"usage":"作宾语、定语；用于功绩等"},{"id":3459,"word":"丰功硕德","pinyin":"fēng gōng shuò dé","abbr":"fgsd","explanation":"巨大的功勋，隆盛的德泽。同“丰功茂德”。","source":{"text":"其丰功硕德，具载墓碑，兹不复云。","book":"元·王恽《淇州创建故周府君祠碑铭》"},"example":{"text":"我燕赵～及岩穴独行之士，接踵相望。","book":"清·申涵《畿辅先贤诗序》"},"similar":["丰功茂德","丰功懿德"],"usage":"作宾语、定语；用于书面语"},{"id":3460,"word":"丰功茂德","pinyin":"fēng gōng mào dé","abbr":"fgmd","explanation":"巨大的功勋，隆盛的德泽。","source":{"text":"江东以来，有国有家，丰功茂德，未有如斯之盛者。","book":"南朝·梁·裴子野《宋略总论》"},"example":{"text":"～，后先辉贲。","book":"明·宋讷《敕建历代帝王庙碑》"},"similar":["丰功硕德","丰功懿德"],"usage":"作宾语、定语；用于书面语"},{"id":3461,"word":"丰取刻与","pinyin":"fēng qǔ kè yǔ","abbr":"fqky","explanation":"丰：多；刻：刻薄；与：给予。取之于民的多，用之于民的少。多形容残酷地剥削。","source":{"text":"上好贪利，则臣下百吏乘是而后丰取刻与，以无度取千民。","book":"《荀子·君道》"},"similar":["多许少与"],"usage":"作谓语、定语；指残酷掠夺"},{"id":3462,"word":"丰城剑气","pinyin":"fēng chéng jiàn qì","abbr":"fcjq","explanation":"指宝物是无法埋没的。","source":{"text":"《晋书·张华传》：传说在吴灭晋兴之时，斗牛之间常有紫气，豫章雷焕知是“宝剑之精，上彻于天”，其地在丰城。尚书张华到任后，于狱中挖出宝剑两把，一名太阿，一名龙泉，紫气也就消失了。"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第三卷：“那‘～’是怎么说？”"},"usage":"作宾语、定语；用于书面语","story":["吴灭晋兴之际，天空斗、牛二宿之间常有紫气。豫章人雷焕对尚书张华说丰城剑气，地点在豫章郡丰城。张华于是任命雷焕为丰城令。雷焕到任后，在丰城监狱中掘得龙泉、太阿宝剑两口，当晚斗、牛二宿之间的紫气消失"]},{"id":3463,"word":"丰墙峭址","pinyin":"fēng qiáng qiào zhǐ","abbr":"fqqz","explanation":"墙高大而地基陡直。比喻根基不牢。址，同“址”。"},{"id":3464,"word":"丰墙峭阯","pinyin":"fēng qiáng qiào zhǐ","abbr":"fqqz","explanation":"墙高大而地基陡直。比喻根基不牢。阯，同“址”。"},{"id":3465,"word":"丰墙硗下","pinyin":"fēng qiáng qiāo xià","abbr":"fqqx","explanation":"垣墙高大，而基址峻峭。比喻根基不固。"},{"id":3466,"word":"丰姿冶丽","pinyin":"fēng zī yě lì","abbr":"fzyl","explanation":"容貌姿态艳丽到极点了。","source":{"text":"众人抬头一看，果然风姿冶丽，绝世无双。","book":"明·凌濛初《初刻拍案惊奇》卷五"},"usage":"作谓语、定语；多用于女性"},{"id":3467,"word":"丰姿绰约","pinyin":"fēng zī chuò yuē","abbr":"fzcy","explanation":"丰姿：风姿，风度姿态。绰约：柔美的样子。形容女子体态柔美，神采飘逸。同“丰神绰约”。","source":{"text":"一回头时，却见那轿子里坐着个十四五岁的不长不短、不肥不瘦的女郎，面如瓜子，脸若桃花，两条欲蹙不蹙的蛾眉，一双似开非开的凤眼，似曾相识，莫道无情，正是说不尽的体态风流，丰姿绰约。","book":"清·曾朴《孽海花》第七回"},"example":{"text":"李文益～，冰雪聪明。","book":"清·李斗《扬州画舫录·新城北录下》"},"similar":["绰约多姿","丰神绰约"],"usage":"作谓语、定语；用于女性"},{"id":3468,"word":"丰容盛鬋","pinyin":"fēng róng shèng jiàn","abbr":"frsj","explanation":"容：容貌；鬋：下垂的鬓发，也泛指头发。丰润的容貌，浓密且长的头发。形容女子的健美。","source":{"text":"后一个是丰容盛鬋，浓眉大眼。","book":"清·曾朴《孽海花》第三十一回"},"example":{"text":"可巧冯国璋在京，有时至总统府中，晤商要公，偶见一～的周女士，不觉啧啧叹羡。","book":"蔡东藩、许廑父《民国通俗演义》第三十七回"},"usage":"作谓语、定语；多用于女性"},{"id":3469,"word":"丰容靓饰","pinyin":"fēng róng jìng shì","abbr":"frjs","explanation":"靓饰：以脂粉装饰。面容丰润，妆饰美丽。","source":{"text":"昭君丰容靓饰，光明汉宫，顾景裴回，竦动左右。","book":"《后汉书·南匈奴传》"},"example":{"text":"呼韩邪临朝辞，帝召五女以示之，而昭君～，竦动左右。","book":"宋·王观国《学林·王昭君》"},"usage":"作谓语、定语；多用于女性"},{"id":3470,"word":"丰富多彩","pinyin":"fēng fù duō cǎi","abbr":"ffdc","explanation":"采：通“彩”，颜色，花色。内容丰富，花色繁多，形式多样。","source":{"text":"而在具体主题、内容、体裁、手法上，却完全可以是丰富多采的。","book":"秦牧《艺海拾贝·“果王”的美号》"},"example":{"text":"春节期间的文艺节目～。"},"similar":["丰富多采","多姿多彩"],"opposite":["单调乏味"],"usage":"作谓语、定语；指花样多"},{"id":3471,"word":"丰富多采","pinyin":"fēng fù duō cǎi","abbr":"ffdc","explanation":"采：通“彩”，颜色，花色。内容丰富，花色繁多，形式多样","source":{"text":"而在具体主题、内容、体裁、手法上，却完全可以是丰富多采的。","book":"秦牧《艺海拾贝·“果王”的美号》"},"example":{"text":"春节期间的文艺节目～"},"similar":["五花八门","琳琅满目"],"opposite":["一星半点","寥寥无几","微乎其微"],"usage":"作谓语、定语；指花样多"},{"id":3472,"word":"丰屋之戒","pinyin":"fēng wū zhī jiè","abbr":"fwzj","explanation":"指高大其屋，将有覆家之祸，应引以为戒。","source":{"text":"‘丰其屋’，言贵族在位之时，如鸟得以飞翔于天空，故能大其屋也。","book":"《易·丰》：“《象》曰：‘丰其屋’，天际翔也。”高亨注"}},{"id":3473,"word":"丰屋之祸","pinyin":"fēng wū zhī huò","abbr":"fwzh","explanation":"指高大其屋，将有覆家之祸，应引以为戒。同“丰屋之戒”。","source":{"text":"《易》曰：‘丰其屋，蔀其家，窥其户，閴其无人’。王者以天下为家，言丰屋之祸，至于家无人也。","book":"陈寿《三国志·辛毗杨阜高堂隆传》"}},{"id":3474,"word":"丰屋之过","pinyin":"fēng wū zhī guò","abbr":"fwzg","explanation":"指高大其屋，将有覆家之祸，应引以为戒。同“丰屋之戒”。"},{"id":3475,"word":"丰屋延灾","pinyin":"fēng wū yán zāi","abbr":"fwyz","explanation":"指高大其屋，将引起灾祸。同“丰屋生灾”。"},{"id":3476,"word":"丰屋生灾","pinyin":"fēng wū shēng zāi","abbr":"fwsz","explanation":"指高大其屋，将引起灾祸。"},{"id":3477,"word":"丰屋蔀家","pinyin":"fēng wū zhī jiā","abbr":"fwbj","explanation":"比喻深自隐藏，不肯出仕。也比喻高官显宦豪富丰足。","source":{"text":"既丰其屋，又蔀其家，屋厚家覆，暗之甚也。虽窥其户，阒其无人，弃其所处，而自深藏也。","book":"《易·丰》：“上六，丰其屋，蔀其家，窥其户，阒其无人，三岁不觌，凶。”王弼注"}},{"id":3478,"word":"丰干饶舌","pinyin":"fēng gān ráo shé","abbr":"fgrs","explanation":"丰干：唐代高僧，饶舌：多嘴，唠叨。丰干多嘴多舌。指不该说而说或不该管却管别人的事。比喻说的都是废话。","source":{"text":"寒山复执闾丘公手，笑而答曰：‘丰干饶舌。’久而放之。","book":"宋·释道原《景德传灯录》卷二十七"},"example":{"text":"道士踉跄遁走，见者无不鼓掌大笑，谓处置苦辈，宜以此法，孰令其～哉。","book":"清·王韬《淞隐漫录·莲贞仙子》"},"usage":"作宾语、定语；用于口语","story":["唐代僧人丰干原来在天台山国清寺常干舂米等杂活，有人问话，只答“随时”二字，不说别的。后来行化到京城。闾丘胤要到台州作太守，就问台州有何贤达？丰干要他到任记住去拜谒文殊。闾丘胤到任后去国清寺，见到寒山、拾得，二僧笑道：丰干饶舌"]},{"id":3479,"word":"丰年玉荒年谷","pinyin":"fēng nián yù huāng nián gǔ","abbr":"fnyhng","explanation":"比喻有用的人才。","source":{"text":"世称庾文康为丰年玉，雅恭为荒年谷。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"他不明白～的道理。"},"usage":"作主语、宾语、定语；指有用的东西"},{"id":3480,"word":"丰年稔岁","pinyin":"fēng nián rěn suì","abbr":"fnrs","explanation":"稔：指庄稼成熟。五谷丰登的好年景。","source":{"text":"八方肃靖，东夷西戎仰化，南蛮北狄归降，贡麟凤献瑞呈祥，产禾苗丰年稔岁。","book":"元·刘唐卿《降桑椹蔡顺奉母》第一折"},"usage":"作宾语；指丰收年"},{"id":3481,"word":"丰年补败","pinyin":"fēng nián bǔ bài","abbr":"fnbb","explanation":"丰：丰富，丰厚；败：雕残，衰落。以丰年补歉年。","source":{"text":"古者税什一，丰年补败，不外求而上下足也。","book":"《谷梁传·庄公二十八年》"},"example":{"text":"古者凶年不备，～，仍旧贯而不改作。","book":"汉·桓宽《盐铁论·散不足》"},"usage":"作宾语、定语；用于口语"},{"id":3482,"word":"丰度翩翩","pinyin":"fēng dù piān piān","abbr":"fdpp","explanation":"丰度：风采气度。翩翩：洒脱的样子。形容神态举止文雅优美，超逸洒脱。同“风度翩翩”。","source":{"text":"旁观的人，见十余部马车络绎而来，末后一部车上坐着秋谷，精神轩翥，丰度翩翩，香留荀令之裾，粉傅何郎之面，真似灵和疏柳，张绪当年。","book":"清·张春帆《九尾龟》第四回"},"example":{"text":"秦凤梧连忙换上，走到着衣镜前一照，觉得自己～，竟是个羊车中人物了。","book":"清·李宝嘉《文明小史》第五十五回"}},{"id":3483,"word":"丰杀随时","pinyin":"fēng shā suí shí","abbr":"fsss","explanation":"丰：增加；杀：减少。随时代不同而作增减变动。","source":{"text":"礼典轨度，丰杀随时，虞、夏、商、周咸不相袭，盖有由也。","book":"《晋书·礼志》"},"usage":"作谓语、定语；用于书面语"},{"id":3484,"word":"丰标不凡","pinyin":"fēng biāo bù fán","abbr":"fbbf","explanation":"风度仪表不同于一般。形容风采出众。","source":{"text":"有个闻舍人，下在本店，丰标不凡，愿执箕帚。","book":"明·凌濛初《二刻拍案惊奇》卷十七"},"similar":["风度翩翩"],"usage":"作谓语、定语；指人的气质"},{"id":3485,"word":"丰烈伟绩","pinyin":"fēng liè wěi jì","abbr":"flwj","explanation":"丰：多；烈：功业；伟：大，显赫。伟大的功绩和成就。","source":{"text":"其品望在乡国，其威名在遐荒，其丰烈伟绩在太史。","book":"清·汪琬《代寿洪太傅七十序》"},"similar":["丰功伟绩","丰功伟业","丰功伟烈"],"usage":"作主语、宾语；指人的功劳大"},{"id":3486,"word":"丰神异彩","pinyin":"fēng shén yì cǎi","abbr":"fsyc","explanation":"精神丰满，焕发容光。","source":{"text":"尤妙，晚景逍遥，丰神异彩，德类傅伊周召。","book":"明·胡文焕《群音类选·〈金貂记·鄂公庆奉〉》"},"similar":["神采飞扬"],"usage":"作谓语；指人的精神面貌"},{"id":3487,"word":"丰神绰约","pinyin":"fēng shén chuò yuē","abbr":"fscy","explanation":"绰约：形容女子体态柔美的样子。指女子体态柔美丰满。","source":{"text":"那回观看的，何止挨山塞海，内中有两个女子，双鬟高髻，并肩而立。丰神绰约，宛然若并蒂芙蓉。","book":"明·凌濛初《初刻拍案惊奇》卷十七"},"similar":["丰姿绰约"],"usage":"作谓语、定语；用于女性"},{"id":3488,"word":"丰筋多力","pinyin":"fēng jīn duō lì","abbr":"fjdl","explanation":"丰：丰满，丰实；筋：肌腱或骨头上的韧带；多：多余。书法有筋骨，笔力雄健。比喻字体结构坚实而丰满，笔力强劲有余。","source":{"text":"三国之初，字学缺然不讲，繇于是为一家法，而议者谓其丰筋多力，有云游雨骤之势。","book":"宋·无名氏《宣和书谱》"},"usage":"作谓语、宾语；用于书法等"},{"id":3489,"word":"丰肌弱骨","pinyin":"fēng jī ruò gǔ","abbr":"fjrg","explanation":"丰润的肌肤，柔嫩的骨骼。形容女子或花朵娇嫩艳丽而有丰韵。","source":{"text":"丰肌弱骨自喜，醉晕妆光总宜。独立风前雨里，嫣然不要人持。","book":"宋·范成大《园丁折花七品各赋一绝》"},"similar":["丰肌秀骨"],"usage":"作谓语、宾语、定语；多用于女性"},{"id":3490,"word":"丰肌秀骨","pinyin":"fēng jī xiù gǔ","abbr":"fjxg","explanation":"丰润的肌肤，柔嫩的骨骼。形容女子或花朵娇嫩艳丽而有丰韵。同“丰肌弱骨”。","source":{"text":"雾阁云窗别有天，丰肌秀骨净娟娟。独立含情羞不语，总妖研。","book":"宋·袁去华《山花子》词"},"similar":["丰肌弱骨"],"usage":"作谓语、宾语、定语；多用于女性"},{"id":3491,"word":"丰草长林","pinyin":"fēng cǎo cháng lín","abbr":"fccl","explanation":"①茂草高林。②指隐逸之地。","source":{"text":"臣生长陛下纯朴之俗，行四十载矣。与麋鹿同群而处，浪迹于陛下丰草长林，实自弱冠之年矣。","book":"唐·杜甫《进三大礼赋表》"},"example":{"text":"方图旦夕解组，永投～；不意缪改枢曹，值兹大坏之际。","book":"明·鹿善继《答陈显吾书》"},"similar":["长林丰草"],"usage":"作主语、宾语；比喻隐居之地"},{"id":3492,"word":"丰衣美食","pinyin":"fēng yī měi shí","abbr":"fyms","explanation":"丰厚的衣服，美味的食品。","source":{"text":"吾父子以丰衣美食养士四十年，及遇敌，不能为我东向发一矢。","book":"《宋史·世家二·西蜀孟氏》"}},{"id":3493,"word":"丰衣足食","pinyin":"fēng yī zú shí","abbr":"fyzs","explanation":"足：够。穿的吃的都很丰富充足。形容生活富裕。","source":{"text":"堂头官人，丰衣足食，所住无不克。","book":"五代·王定保《唐摭言》卷十五"},"example":{"text":"我们用自己动手的方法，达到了～的目的。","book":"《毛泽东选集·组织起来》"},"similar":["锦衣玉食","安家立业","人寿年丰"],"opposite":["饥寒交迫","家贫如洗","衣单食薄"],"usage":"作谓语、定语；指生活富足"},{"id":3494,"word":"串亲访友","pinyin":"chuàn qīn fǎng yǒu","abbr":"cqfy","explanation":"走亲戚，看朋友。","source":{"text":"农民都愿意在春耕开始前赶集进城，串亲访友。","book":"张天民《路考》"},"example":{"text":"春节期间大家都有～的习惯。"},"similar":["走亲访友"],"usage":"作谓语、宾语、定语；指走亲访友"},{"id":3495,"word":"串街走巷","pinyin":"chuàn jiē zǒu xiàng","abbr":"cjzx","explanation":"串：往来走动。在大街小巷走来走去。","source":{"text":"况且日逐串街走巷，哪一家不认得？","book":"明·冯梦龙《喻世明言》第一卷"},"example":{"text":"她最爱～。"},"similar":["走街串巷"],"usage":"作谓语、宾语；指走动"},{"id":3496,"word":"串通一气","pinyin":"chuàn tōng yī qì","abbr":"ctyq","explanation":"相互勾结，一个鼻孔出气。","source":{"text":"怪道！你们串通一气来算计我。","book":"清·曹雪芹《红楼梦》第四十六回"},"example":{"text":"他们和赌馆的人虽然～，惟恐怕他们冒冒失失的放枪拒敌……","book":"清·张春帆《宦海》第二回"},"similar":["沆瀣一气","臭味相投"],"opposite":["互助有爱"],"usage":"作谓语、定语；用于坏人相互勾结"},{"id":3497,"word":"临事制变","pinyin":"lín shì zhì biàn","abbr":"lszb","explanation":"犹临机应变。同“临机制变”。","source":{"text":"临事制变，困而能通，智者之虑也。","book":"汉·陈琳《檄吴将校部曲文》"},"similar":["临机制变","临机设变","随机应变"],"opposite":["一成不变","刻舟求剑"],"usage":"作谓语、宾语、定语；指随机应变"},{"id":3498,"word":"临事屡断","pinyin":"lín shì lǚ duàn","abbr":"lsld","explanation":"屡：经常。遇事勇于决断。","source":{"text":"明乎商之音者，临事而屡断。明乎齐之音者，见利而让。临事而屡断，勇也；见利而让，义也。","book":"《礼记·乐记》"}},{"id":3499,"word":"临事而惧","pinyin":"lín shì ér jù","abbr":"lsej","explanation":"临：遭遇，碰到；惧：戒惧。遇事谨慎戒惧。","source":{"text":"必也临事而惧，好谋而成者也。","book":"《论语·述而》"},"example":{"text":"夫庙算而后出军，犹～，况今庙算有阙而欲用之，臣诚未见其利也。","book":"《三国志·魏志·辛毗传》"},"opposite":["临难不惧"],"usage":"作谓语；指遇事谨慎戒惧"},{"id":3500,"word":"临军对垒","pinyin":"lín jūn duì lěi","abbr":"ljdl","explanation":"指战场上对峙交锋。同“临军对阵”。","source":{"text":"领将驱兵敢战敌，临军对垒惯相持。","book":"明·无名氏《万国来朝》第三折"},"similar":["临军对阵"],"usage":"作谓语、定语、宾语；指作战的场合"},{"id":3501,"word":"临军对阵","pinyin":"lín jū duì zhèn","abbr":"ljdz","explanation":"面对敌方军队。指作战的场合。","source":{"text":"骤马横枪武艺精，临军对阵见输赢。","book":"明·无名氏《庆赏端阳》第一折"},"similar":["临军对垒"],"usage":"作谓语、定语、宾语；指作战的场合"},{"id":3502,"word":"临别赠言","pinyin":"lín bié zèng yán","abbr":"lbzy","explanation":"分别时赠送的一些勉励的话。","source":{"text":"临别赠言，幸承恩于伟饯。","book":"唐·王勃《滕王阁序》"},"example":{"text":"兄弟有一句～的话，不知阁下可肯听受。","book":"清·吴趼人《二十年目睹之怪现状》第93回"},"similar":["临别赠语"],"usage":"作宾语、定语；指分别时的忠告"},{"id":3503,"word":"临别赠语","pinyin":"lín bié zèng yǔ","abbr":"lbzy","explanation":"分别时赠送勉励的话或忠告。","source":{"text":"团组织的教导，教师的嘱咐，妈妈的叮咛，同学们的临别赠语，又记取了多少？","book":"杜鹏程《在和平的日子里》第三章"},"example":{"text":"几十年过去了，我还始终记得他的～。"},"similar":["临别赠言"],"usage":"作宾语；指分别时的忠告"},{"id":3504,"word":"临危下石","pinyin":"lín wēi xià shí","abbr":"lwxs","explanation":"比喻乘人之危，加以打击。","source":{"text":"夸谈经济者，少甚么看风使舵、临危下石之人。","book":"清·夏敬渠《野叟曝言》第59回"},"example":{"text":"～的人是不道德的。"},"similar":["落井下石"],"opposite":["雪中送炭"],"usage":"作谓语、定语；指陷害人"},{"id":3505,"word":"临危不乱","pinyin":"lín wēi bù luàn","abbr":"lwbl","explanation":"临：面临；危：危险；乱：慌乱，紊乱。指面临危险心情不慌乱。","example":{"text":"真正做到～是不容易的。"},"similar":["临危不惧"],"usage":"作谓语、宾语、定语；指人遇事沉着"},{"id":3506,"word":"临危不惧","pinyin":"lín wēi bù jù","abbr":"lwbj","explanation":"临：遇到；危：危险；惧：怕。遇到危难的时候，一点也不怕。","source":{"text":"死生有命，贫富有时。怨夭折者，不知命也；怨贫贱者，不知时也。故临难不惧。","book":"《邓析子·无厚》"},"example":{"text":"在重庆红岩的日日夜夜，你英勇斗争，～。","book":"郭小川《痛悼敬爱的周总理》"},"similar":["无私无畏","视死如归"],"opposite":["惊慌失措","临阵脱逃","贪生怕死"],"usage":"作谓语、定语、状语；指人沉着","story":["春秋时期，孔子乘学生颜回驾驶的马车周游各国，他们来到匡地，当地人恨颜回与阳虎，恰好孔子很像阳虎，匡人纠集军队围攻他们。子路赶忙去保护孔子，只见孔子临危不惧，谈笑自若，十分平静地弹着琴，匡人与孔子和睦相处"]},{"id":3507,"word":"临危不惮","pinyin":"lín wēi bù dàn","abbr":"lwbd","explanation":"遇到危难的时候，一点也不怕。同“临危不惧”。","source":{"text":"临危不惮，赴救远征。","book":"唐·司空图《华帅许国公德政碑》"},"similar":["临危不惧"],"opposite":["临阵脱逃"],"usage":"作谓语、定语、状语；指人沉着"},{"id":3508,"word":"临危不挠","pinyin":"lín wēi bù náo","abbr":"lwbn","explanation":"挠：屈，折。遇到危险时并不屈服。形容英勇坚贞。","source":{"text":"《魏书·列传节义第七十五》于什门等或临危不挠，视死如归；或赴险如夷，惟义所在。"},"example":{"text":"柳桧并～，视死如归，其壮志贞情，可与青松白玉比质也。","book":"《周书·柳桧传》"},"similar":["临危不屈"],"usage":"作谓语、定语；用于处事"},{"id":3509,"word":"临危不苟","pinyin":"lín wēi bù gǒu","abbr":"lwbg","explanation":"指遇到为难不苟且偷生。同“临难不苟”。","source":{"text":"我手无缚鸡之力，不能去杀敌雪耻，我只能临危不苟。","book":"老舍《四世同堂》"},"example":{"text":"方志敏被敌人抓住后仍旧～，誓死不投降。"},"similar":["临难不苟"],"usage":"作谓语、定语；指人的气节"},{"id":3510,"word":"临危不顾","pinyin":"lín wēi bù gù","abbr":"lwbg","explanation":"临：遇到；危：危险。遇到危难的时候，一点也不怕。","source":{"text":"和、琇、抚皆抗不挠，拒会凶言，临危不顾。","book":"晋·陈寿《三国志·魏志·陈留王传》"},"example":{"text":"思赴蹈于仁义，～，前哲所难。","book":"《周书·赵善传论》"},"similar":["临危不惧","临难不顾"],"usage":"作谓语、定语、状语；指十分英勇","story":["三国时期，魏国派大将邓艾、钟会、诸葛绪联合灭蜀，蜀后主刘禅投降，大将姜维被迫投降，但他一心想恢复蜀国，鼓动钟会杀掉邓艾，然后准备出兵长安杀司马昭叛乱。部将夏侯和、羊琇、朱抚三人临危不顾，坚决反对钟会进行叛乱"]},{"id":3511,"word":"临危制变","pinyin":"lín wēi zhì biàn","abbr":"lwzb","explanation":"面临危险时紧急应变。","source":{"text":"司马懿临危制变，擒渊可计日待也。","book":"《三国志·魏志·明帝纪》"},"example":{"text":"上至邺，自为文祭魏太祖，曰：‘～，料敌设奇，一将之智有余，万乘之才不足。’","book":"《资治通鉴·唐太宗贞观十七年》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":3512,"word":"临危受命","pinyin":"lín wēi shòu mìng","abbr":"lwsm","explanation":"在危难之际接受任命。","source":{"text":"受任于败军之际，奉命于危难之间。","book":"三国·蜀·诸葛亮《前出师表》"},"example":{"text":"～于先，哪儿能临阵脱逃于后？","book":"夏衍《心防》第三幕"},"usage":"作谓语、宾语；指在危难之际接受任命","story":["三国时期，蜀主刘备死后，昏庸无能的阿斗继位，他只知享乐，不理朝政。诸葛亮一面联吴伐魏，南征孟获，积极准备两次北伐，在出征前夕给阿斗写《前出师表》说自己临危受命，为了匡复汉室大业，自己鞠躬尽瘁、死而后已"]},{"id":3513,"word":"临危履冰","pinyin":"lín shēn lǚ bīng","abbr":"lwlb","explanation":"履：踩踏。遇到险境，走在冰上。比喻处境艰险，时刻警戒自己要小心谨慎，惟恐有失。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"故圣人要当言而惧，发言而忧，常如～，以大居小，以富居贫。","book":"宋·张君房《云笈七签》卷九十"},"similar":["临深履薄"],"usage":"作宾语、定语；用于处事"},{"id":3514,"word":"临危授命","pinyin":"lín wēi shòu mìng","abbr":"lwsm","explanation":"在危急关头勇于献出生命。","source":{"text":"见利思义，见危授命。","book":"春秋·鲁·孔丘《论语·宪问》"},"example":{"text":"在他们～的时候，一定是心胸开朗，了无牵挂的。","book":"欧阳山《三家巷》"},"similar":["临危致命"],"usage":"作谓语；指面对危急时勇于献出生命","story":["春秋时期，鲁国政权被季孙氏、孟孙氏和叔孙氏三家控制，鲁定公成为一个傀儡，他听说孔子开坛讲学，主张“君臣纲常”，连夜召见孔子。孔子见是临危授命，就分析了鲁国的内忧外患，建议他外联齐国，内部重振君威，制定了一系列措施"]},{"id":3515,"word":"临危效命","pinyin":"lín wēi xiào mìng","abbr":"lwxm","explanation":"效：奉献。面对危急，献出自己的生命。","source":{"text":"徒因学古之勤，粗识事君之节，苟临危效命，尚当不顾以奋身，况为善无伤，何惮竭忠而报国。","book":"宋·欧阳修《谢复龙图阁直学士表》"},"usage":"作谓语、定语；用于处事"},{"id":3516,"word":"临危自悔","pinyin":"lín wēi zì huǐ","abbr":"lwzh","explanation":"悔：懊悔。遇到危难时自己懊悔。形容意志不坚定。","source":{"text":"您今日遭陷擒缚，方才是临危自悔。","book":"元·郑光祖《钟离春智勇定齐》第三折"},"usage":"作谓语、宾语；用于人的意志"},{"id":3517,"word":"临危自省","pinyin":"lín wēi zì xǐng","abbr":"lwzx","explanation":"省：醒悟。临到危难时能够自己觉醒。","source":{"text":"荣枯枕上三更，傀儡场头四并。人生幻化如泡影，那个临危自省。","book":"元·姚遂《醉高歌·感怀四首》其二"},"example":{"text":"我与你指迷途，～。我教你得平安，福禄加增。","book":"明·无名氏《云台门》第二折"},"usage":"作谓语；用于遇到危难时"},{"id":3518,"word":"临危自计","pinyin":"lín wēi zì jì","abbr":"lwzj","explanation":"计：计算。指临到危险时刻只为自己着想。","source":{"text":"人臣食君之禄，死君之难，临危自计，非忠也。","book":"后晋·刘昫《旧唐书·吴溆传》"},"example":{"text":"大丈夫是不会～的。"},"opposite":["置之度外"],"usage":"作宾语、定语；指人自私","story":["唐朝时期，淮宁节度使李希烈叛乱，自称建兴王，卢龙节度使朱滔也叛乱，自称冀王，而他的哥哥朱泚进攻长安自立为皇帝，改国号秦。唐德宗逃到奉天，只有大将军吴溆不临危自计，前去长安游说朱泚归降朝廷而被杀"]},{"id":3519,"word":"临危致命","pinyin":"lín wēi zhì mìng","abbr":"lwzm","explanation":"在遇到危难时肯豁出性命。","source":{"text":"士见危致命，见得思义。","book":"春秋·鲁·孔丘《论语·子张》"},"example":{"text":"春秋·鲁·孔丘《论语·子张》：“士见危致命，见得思义。”"},"similar":["临危授命"],"usage":"作谓语；指遇到危难肯豁出生命"},{"id":3520,"word":"临危蹈难","pinyin":"lín wēi dǎo nàn","abbr":"lwdn","explanation":"临：面对、靠近；蹈：用脚踩。面对危险的局势，勇于赴汤蹈火，慷慨就义。","source":{"text":"敌攻无坚，城守必完，临危蹈难，歔欷感发。","book":"唐·韩愈《清边郡王杨燕奇碑文》"}},{"id":3521,"word":"临去秋波","pinyin":"lín qù qiū bō","abbr":"lqqb","explanation":"秋波：秋天的水波，比喻眼睛明澈。临走时的回眸一盼。形容别情依依。","source":{"text":"怎当他临去秋波那一转！便是铁石人也意惹情牵。","book":"元·王实甫《西厢记》第一本第一折"},"example":{"text":"盖主司之取舍，全定于终篇之一刻，～那一转，未有不令人消魂欲绝者也。","book":"清·李渔《窥词管见》"},"usage":"作宾语、定语；用于男女之间"},{"id":3522,"word":"临噎掘井","pinyin":"lín yē jué jǐng","abbr":"lyjj","explanation":"噎：食物蚁封堵塞住喉咙。临到食物堵塞住喉咙需要用水时才去掘井取水。比喻为时已晚。","source":{"text":"溺者不问坠，迷者不问路，溺而后问坠，迷而后问路，譬之犹临难而遽铸兵，噎而遽掘井。","book":"《晏子春秋·内篇杂上》"},"similar":["临渴掘井"],"usage":"作谓语、定语、宾语；用于处事"},{"id":3523,"word":"临崖勒马","pinyin":"lín yá lè mǎ","abbr":"lylm","explanation":"来皮悬崖而能勒住奔马。指面临危境险地的情况而能自制止步，及时回头。","source":{"text":"这厮不识咱运机，将人来紧追袭，呀，你如今船到江心补漏迟，抵多少临崖勒马才收骑。","book":"元·郑德辉《钟离春智勇定齐》第三折"},"example":{"text":"亏得老襟丈～，不然，以祖父世传之产业，而换几根筹马，好不伤心。","book":"清·夏敬渠《野叟曝言》第五十六回"},"similar":["勒马悬崖"],"usage":"作谓语、定语、分句；用于劝诫人"},{"id":3524,"word":"临崖失马","pinyin":"lín yá shī mǎ","abbr":"lysm","explanation":"比喻临到危险不能及时回头。","source":{"text":"我且回程，又不是临崖失马，有何劳顿？","book":"明·沈受先《三元记·错认》"},"similar":["死不回头"],"usage":"作谓语、定语、宾语；用于处事"},{"id":3525,"word":"临川羡鱼","pinyin":"lín chuān xiàn yú","abbr":"lcxy","explanation":"比喻空有愿望，而无实际行动。","source":{"text":"雄以为临川羡鱼，不如归而结网。","book":"汉·扬雄《河东赋》"},"example":{"text":"～是不现实的。"},"similar":["临渊羡鱼"],"usage":"作主语、宾语、定语；指空想"},{"id":3526,"word":"临患忘利","pinyin":"lín huàn wàng lì","abbr":"lhwl","explanation":"布景祸患不计较仆人得失。","source":{"text":"士之为人，当理不避其难，临患忘利。","book":"《吕氏春秋·士节》"}},{"id":3527,"word":"临敌卖阵","pinyin":"lín dí mài zhèn","abbr":"ldmz","explanation":"即将上阵杀敌时，却逃离阵地。形容十分胆怯。","source":{"text":"因为你两军对垒，临敌卖阵，敕旨教斩了你哩！","book":"明·无名氏《三化邯郸》第四折"},"similar":["临阵脱逃"],"opposite":["临锋决敌"],"usage":"作谓语、定语；用于战争或处事等"},{"id":3528,"word":"临敌易将","pinyin":"lín dí yì jiàng","abbr":"ldyj","explanation":"易：改变，变换。临到作战之前调换将领。","source":{"text":"且临敌代将，自古所难，乐毅所以辞燕，赵括以之败赵。","book":"《隋书·李德林传》"},"example":{"text":"目今出师在即，～，军之大忌。","book":"姚雪垠《李自成》第二卷第二十二章"},"similar":["临阵易将"],"usage":"作谓语、定语；用于处事"},{"id":3529,"word":"临文不讳","pinyin":"lín wén bù huì","abbr":"lwbh","explanation":"临：及；讳：避讳。作文时不须避讳。","source":{"text":"诗书不讳，临文不讳。","book":"《礼记·曲礼上》"},"example":{"text":"古人～，或谓史迁讳谈为同，然滑稽传有谈言解纷语，恐此说未确。","book":"清·平步清《霞外捃屑》卷五"},"usage":"作谓语；指作文时不须避讳"},{"id":3530,"word":"临时抱佛脚","pinyin":"lín shí bào fó jiǎo","abbr":"lsbfj","explanation":"原意为年老信佛，以求保佑，有临渴掘井之意。后因称平时无准备而事急时仓猝张罗为“临时抱佛脚”。","source":{"text":"垂老抱佛脚，教妻读黄经。","book":"唐·孟郊《读经》诗"},"example":{"text":"我们不能抱～的念头。"},"similar":["临渴掘井"],"usage":"作宾语、定语；指仓猝应付","story":["宋朝时期，王安石与客人闲谈，偶然谈到佛经，他感慨地说：“投老欲依僧”，表示想与和尚去做伴。旁人加上一句“急来抱佛脚”。王安石不悦，那人说古诗对谚语，如改成对联则成为“老欲依僧，急来抱佛”，头脚相对"]},{"id":3531,"word":"临时施宜","pinyin":"lín shí shī yí","abbr":"lssy","explanation":"临时：到事情发生的时候。发生什么情况，就采取什么相应的措施。","source":{"text":"酒罢，蒙问肃曰：‘君受重任，与关羽为邻，将何计略，以备不虞？’肃造次应曰：‘临时施宜。’","book":"《三国志·吴志·吕蒙传》"}},{"id":3532,"word":"临时磨枪","pinyin":"lín shí mó qiāng","abbr":"lsmq","explanation":"临：到，快要；枪：梭镖，长矛一类的兵器。到了快要上阵打仗的时候才磨刀擦枪。比喻事到临头才匆忙准备。","source":{"text":"‘临阵磨枪’，也不中用！有这会子着急，天天写写念念，有多少完不了的？","book":"清·曹雪芹《红楼梦》第七十回"}},{"id":3533,"word":"临期失误","pinyin":"lín qī shī wù","abbr":"lqsw","explanation":"临：及，到。到了预先约定的时间却失约了。指不守诺言。","source":{"text":"却乃连日酗酣，临期失误，使百辟仓皇骇愕以失色。","book":"《剪灯余话·泰山御史传》"},"opposite":["一诺千金"],"usage":"作谓语；指不守诺言"},{"id":3534,"word":"临机制变","pinyin":"lín jī zhì biàn","abbr":"ljzb","explanation":"临到时机，制定应变计划。","source":{"text":"必望临机制变，未敢顶陈。","book":"《周书·陆腾传》"},"example":{"text":"夫～，又何可数？","book":"唐·吴武陵《上韩舍人行军书》"},"similar":["随机应变","临机设变","临事制变"],"opposite":["一成不变","刻舟求剑"],"usage":"作谓语、宾语、定语；指随机应变","story":["南北朝时期，北魏东莱王的女婿陆腾在任阳城太守时，被西魏攻破阳城而投降，宇文泰任命他为车骑大将军，西魏农民李广嗣、李武起义，陆腾奉命镇压，他告诉宇文泰作战只能临机制变，结果大获全胜，被封为上庸郡公"]},{"id":3535,"word":"临机制胜","pinyin":"lín jī zhì shèng","abbr":"ljzs","explanation":"临到机会来时能以谋略取胜。形容机灵聪慧。","source":{"text":"兵事临机制胜，非可预言。","book":"明·冯梦龙《东周列国志》第十六回"},"usage":"作谓语、定语；用于处事"},{"id":3536,"word":"临机处置","pinyin":"lín jī chǔ zhì","abbr":"ljcz","explanation":"临：面临；机：时机；处置：处理决定。指在紧要关头，要根据面临的具体情况的变化，及时作出决断。","example":{"text":"打枣庄是突然遭遇，～；打王伦、马定钧都是大兵合围，他率先锋突袭成功。","book":"二月河《乾隆皇帝》六"}},{"id":3537,"word":"临机应变","pinyin":"lín jī yìng biàn","abbr":"ljyb","explanation":"机：时机，形势。随着情况的变化灵活机动地应付。","source":{"text":"世充日踧月迫，力尽计穷，悬首面缚，翘足可待。建德远来助虐，粮运阻绝，此是天丧之时。请固武牢，屯军氾水，随机应变，则易为克殄。","book":"《旧唐书·郭孝恪传》"},"example":{"text":"四境之内，百姓之事，蠡不如臣，与群周旋，～，臣不如蠡。","book":"明·冯梦龙《东周列国志》第八十回"},"similar":["随机应变","乘机应变"],"usage":"作谓语、定语；同“随机应变”"},{"id":3538,"word":"临机立断","pinyin":"lín jī lì duàn","abbr":"ljld","explanation":"犹当机立断。抓住时机，立刻决断。","source":{"text":"访得淮扬，海防兵备副使刘景韶英敏多谋，临机立断，运筹足以破鬼夷之算，贾勇足以汗懦将之颜。","book":"明·唐顺之《条陈海防经略事疏》"},"example":{"text":"曰：‘决力’，～，自残不恤，如剑锋直陷，剑身亦折然。","book":"清·谭嗣同《仁学》四五"},"similar":["当机立断","临机能断","临机辄断"],"opposite":["犹豫不决","瞻前顾后"],"usage":"作谓语、定语；用于处事"},{"id":3539,"word":"临机能断","pinyin":"lín jī néng duàn","abbr":"ljnd","explanation":"犹当机立断。抓住时机，立刻决断。同“临机立断”。","source":{"text":"子盖雅有干局，质性方严，见义而勇，临机能断，保全邦邑，勤亦懋哉！","book":"《北史·樊子盖传论》"},"similar":["当机立断","临机立断","临机辄断"],"opposite":["犹豫不决"],"usage":"作谓语、定语；用于处事"},{"id":3540,"word":"临机设变","pinyin":"lín jī shè biàn","abbr":"ljsb","explanation":"临到时机，制定应变计划。同“临机制变”。","source":{"text":"深临机设变，是其所长，若总大众，未必能用。","book":"《北史·侯深传》"},"example":{"text":"～，奋力死斗。","book":"宋·陈亮《酌古论·刘备》"},"similar":["随机应变","临机制变","临事制变"],"opposite":["一成不变","刻舟求剑"],"usage":"作谓语、宾语、定语；指随机应变"},{"id":3541,"word":"临机辄断","pinyin":"lín jī zhé duàn","abbr":"ljzd","explanation":"犹当机立断。抓住时机，立刻决断。同“临机立断”。","source":{"text":"如晦少英爽，喜书，以风流自命，内负大节，临机辄断。","book":"《新唐书·杜如晦传》"},"similar":["当机立断","临机立断","临机能断"],"opposite":["犹犹豫豫","拖泥带水"],"usage":"作谓语、定语；用于处事"},{"id":3542,"word":"临死不怯","pinyin":"lín sǐ bù qiè","abbr":"lsbq","explanation":"怯：胆小，害怕。面临危险而毫不胆怯。","source":{"text":"为言此人临死不怯，似亦可用。","book":"宋·洪迈《夷坚乙志》"},"example":{"text":"大丈夫～，什么困难不能克服。"},"similar":["临死不恐"],"usage":"作谓语、定语；指胆大志坚"},{"id":3543,"word":"临死不恐","pinyin":"lín sǐ bù kǒng","abbr":"lsbk","explanation":"恐：恐惧。遇到危难，毫不畏惧。","source":{"text":"吾闻知命之士，见利不动，临死不恐。","book":"西汉·刘秀《新序·义勇》"},"example":{"text":"她～，视死如归。"},"similar":["临死不怯"],"usage":"作谓语、定语；指胆大志坚"},{"id":3544,"word":"临水楼台","pinyin":"lín shuǐ lóu tái","abbr":"lslt","explanation":"犹言近水楼台。","source":{"text":"洞庭窄，谁道临水楼台，清光最先得。","book":"宋·汤恢《祝英台近·中秋》词"},"similar":["近水楼台"],"usage":"作主语、宾语、定语；指优先"},{"id":3545,"word":"临水登山","pinyin":"lín shuǐ dēng shān","abbr":"lsds","explanation":"临：到，靠近。原意是到达水边又登上高山，写送别的情景。现也泛指游览山水名胜。","source":{"text":"憭慓兮若在远行，登山临水兮送将归。","book":"战国·楚·宋玉《九辩》"},"example":{"text":"更堪～处，正是浮家泛村宅。","book":"宋·陆游《秋夜怀吴中》诗"},"similar":["登山临水"],"usage":"作谓语、宾语；指游山玩水"},{"id":3546,"word":"临池学书","pinyin":"lín chí xué shū","abbr":"lcxs","explanation":"临：靠近，挨着；池：砚池；书：书法。指刻苦练习书法。","source":{"text":"尤好草书，学崔、杜之法，家之衣帛，必书而后练。临池学书，水为之黑。","book":"《后汉书·张芝传》"},"example":{"text":"少不肯～，字丑拙，试有司辄不利。","book":"明·张岱《家传》"},"usage":"作谓语；指刻苦学习书法","story":["晋代大书法家王羲之让儿子王献之从小学习练字。经过一段时间的练习，王献之写“大”字让父亲检查，父亲在字上加上一点成为“太”，他跑去问母亲，母亲告诉他只有一点才是真功夫。于是王献之守在家里18个大水缸边练习写字"]},{"id":3547,"word":"临河欲鱼","pinyin":"lín hé yù yú","abbr":"lhyy","explanation":"比喻空有愿望，而无实际行动。同“临河羡鱼”。","source":{"text":"临河欲鱼，不若归而织网。","book":"《文子·上德》"},"similar":["临河羡鱼","临渊羡鱼"],"usage":"作谓语、定语；用于空想"},{"id":3548,"word":"临河羡鱼","pinyin":"lín hé xiàn yú","abbr":"lhxy","explanation":"比喻空有愿望，而无实际行动。","source":{"text":"临河而羡鱼，不若归家织网。","book":"西汉·刘安《淮南子·说林训》"},"example":{"text":"～，为时已晚。"},"similar":["临渊羡鱼"],"usage":"作宾语；指空想"},{"id":3549,"word":"临深履冰","pinyin":"lín shēn lǚ bīng","abbr":"lslb","explanation":"深：深渊；履：踩踏。面临深渊，脚踩薄冰。比喻小心谨慎，惟恐有失。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"手执玉捧盈，足～，固君子知天命。","book":"元·汪元亨《朝天子·归隐》"},"similar":["临深履薄"],"opposite":["胆大妄为","昂首阔步","无所忌惮"],"usage":"作谓语、定语；指处境艰难"},{"id":3550,"word":"临深履尾","pinyin":"lín shēn lǚ wěi","abbr":"lslw","explanation":"比喻危险恐惧。","source":{"text":"履虎尾，咥人，凶。","book":"《诗·小雅·小旻》：“如临深渊，如履薄冰。”又《易·履》"},"example":{"text":"v王者～，不足喻危，假寐待旦，日昃旰食，将何为惧祸及也？","book":"晋·葛洪《抱朴子·诘鲍》引晋·鲍敬言《无君论》"},"similar":["临深履薄"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":3551,"word":"临深履薄","pinyin":"lín shēn lǚ bó","abbr":"lslb","explanation":"深：深渊；履：踩踏；薄：薄冰。面临深渊，脚踩薄冰。比喻小心谨慎，惟恐有失。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"岂可不～，以为至戒？","book":"《后汉书·杨终传》"},"similar":["小心谨慎","提心吊胆","兢兢业业"],"opposite":["胆大妄为","昂首阔步","无所忌惮"],"usage":"作谓语、定语；指处境艰难","story":["东汉明帝皇后马氏生性善良，深明大义，她十分喜欢贾妃所生的刘炟。刘炟继位成汉章帝，尊马氏为皇太后，多次提出加封马氏的兄弟，马后拒绝。而她的侄子马豫抱怨没得到更多的恩惠，杨终劝马廖面临深渊，脚踏薄冰，不能放纵儿子"]},{"id":3552,"word":"临渊之羡","pinyin":"lín yuān zhī xiàn","abbr":"lyzx","explanation":"渊：深潭；羡：希望得到。站在水边想得到鱼。比喻只有愿望而没有措施，对事情毫无好处。","source":{"text":"临渊羡鱼，不如退而结网。","book":"《淮南子·说林训》：“临河而羡鱼，不如归家结网。”《汉书·董仲书传》"},"example":{"text":"弟方噬脐无及，而台翁尚作～邪？","book":"清·李渔《与赵声伯文学》"}},{"id":3553,"word":"临渊结网","pinyin":"lín yuān jié wǎng","abbr":"lyjw","explanation":"临到河边才编织鱼网。指事先不做准备，办不成事。","source":{"text":"早办个凤想仙缘，休等待临渊结网，只落得月缺花残。","book":"明·杨珽《龙膏记·游仙》"},"example":{"text":"～如同亡羊补牢。"},"similar":["临渊羡鱼，不如退而结网"],"usage":"作宾语、定语；用于劝诫人"},{"id":3554,"word":"临渊羡鱼","pinyin":"lín yuān xiàn yú","abbr":"lyxy","explanation":"渊：深潭；羡：希望得到。意思是站在水边想得到鱼，不如回家去结网。比喻只有愿望而没有措施，对事情毫无好处。","source":{"text":"临渊羡鱼，不如退而结网。","book":"《淮南子·说林训》：“临河而羡鱼，不如归家结网。”《汉书·董仲书传》"},"example":{"text":"此为之数年，便可见效，十年便可有成，何不试之，而徒作～之叹。","book":"明·朱之渝《答小宅生顺问六十一条》"},"similar":["临河羡鱼"],"usage":"作宾语、定语；指空想"},{"id":3555,"word":"临渴之掘","pinyin":"lín kě zhī jué","abbr":"lkzj","explanation":"到口渴才掘井。比喻事先没有准备，临时才想办法。","source":{"text":"夫病已成而后药之，乱已成而后治之，譬犹渴而穿井，斗而铸锥，不亦晚乎！","book":"《黄帝内经·素问·四气调神大论》"},"example":{"text":"独是无米之炊，巧妇不能；～，万分难济。","book":"明·孙传庭《督师谢恩疏》"}},{"id":3556,"word":"临渴掘井","pinyin":"lín kě jué jǐng","abbr":"lkjj","explanation":"到口渴才掘井。比喻事先没有准备，临时才想办法。","source":{"text":"夫病已成而后药之，乱已成而后治之，譬犹渴而穿井，斗而铸锥，不亦晚乎！","book":"《黄帝内经·素问·四气调神大论》"},"example":{"text":"一着空虚百着空。～，悔之何及。","book":"明·许仲琳《封神演义》第三十五回"},"similar":["措手不及","临阵磨枪"],"opposite":["有备无患","常备不懈"],"usage":"作谓语、定语；指事到临头才想办法","story":["春秋时期，鲁昭公被鲁国人赶出鲁国，他逃难到齐国。齐景公问他为什么把国王的位子给丢了，他说他没有任用忠良之材，只信任那些吹嘘拍马之辈。齐景公问晏婴鲁昭王能否重新做一个好国王，晏婴认为一个临噎而掘井的人是不会成功的"]},{"id":3557,"word":"临渴穿井","pinyin":"lín kě chuān jǐng","abbr":"lkcj","explanation":"穿：打。临到口渴时才想到凿井。比喻事到临头才想办法。","source":{"text":"夫病已成而后药之，乱已成而后治之，譬犹渴而穿井，斗而铸锥，不亦晚乎！","book":"《黄帝内经·素问·四气调神大论》"},"example":{"text":"～，事同噬脐，胡可得也。","book":"宋·张君房《云笈七签》卷一百十八"},"similar":["临渴掘井"],"opposite":["有备无患"],"usage":"作谓语、定语；指事到临头才想办法"},{"id":3558,"word":"临潼斗宝","pinyin":"lín tóng dòu bǎo","abbr":"ltdb","explanation":"比喻夸耀豪富、争强赌胜的行动。","source":{"text":"出自元杂剧《临潼斗宝》：春秋时秦穆公设谋邀请十七国诸侯至临潼赴会，各出传国之宝比斗，楚伍子胥在会上举鼎示威，制服秦穆公。"},"example":{"text":"天天宰猪割羊，屠鹅杀鸭，好似～的一般，都要卖弄自己家里的好厨役，好烹调。","book":"清·曹雪芹《红楼梦》第七十五回"},"similar":["夸富斗奢"],"usage":"作宾语、定语；用于处事","story":["春秋时期，各诸侯国纷纷争夺霸主地位，秦穆公为了威震其他诸侯国，采纳谋士的建议，邀请十七国诸侯王到临潼开展览会，各国把自己的国宝拿来展览，评出最佳传国之宝。楚国大夫伍子胥明白他的用意，在会上举鼎示威，制服秦穆公"]},{"id":3559,"word":"临财不苟","pinyin":"lín cái bù gǒu","abbr":"lcbg","explanation":"面对钱财不随便求取，廉洁自好。","source":{"text":"临财毋苟得，临难毋苟免。","book":"《礼记·曲礼上》"},"example":{"text":"孰发显廉？～。","book":"五代·王定保《唐摭言·气义》"},"similar":["见利思义"],"opposite":["见钱眼开"],"usage":"作谓语、定语；指不贪财"},{"id":3560,"word":"临财毋苟得，临难毋苟免","pinyin":"lín cái wù gǒu dé，lín nàn wù gǒu miǎn","abbr":"lcwgdlnwgm","explanation":"毋：不；苟：随便；难：危难。面对钱财，不随便求取；面临危难，不苟且偷生。","source":{"text":"临财毋苟得，临难毋苟免，很毋求胜，分毋求多。","book":"《礼记·曲礼上》"}},{"id":3561,"word":"临财苟得","pinyin":"lín cái gǒu dé","abbr":"lcgd","explanation":"临：面对；苟：苟且，随便。面对钱财随便求取，见利忘义。","source":{"text":"临财毋苟得，临难毋苟免。","book":"《礼记·曲礼上》"},"example":{"text":"反比那面是背非，～，见利忘义一班峨冠博带的不同。","book":"明·凌濛初《二刻拍案惊奇》卷三十九"},"similar":["见利忘义"],"opposite":["临财不苟"],"usage":"作谓语、定语；用于贪财的人"},{"id":3562,"word":"临锋决敌","pinyin":"lín fēng jué dí","abbr":"lfjd","explanation":"指面对兵锋与敌决胜。","source":{"text":"孔公绪清谈高论，嘘枯吹生。并无军旅之才，执锐之干。临锋决敌，非公之俦。","book":"《后汉书·郑太传》"},"opposite":["临阵脱逃"],"usage":"作谓语、宾语；用于战争与处世等"},{"id":3563,"word":"临阵带兵书","pinyin":"lín zhèn dài bīng shū","abbr":"lzdbs","explanation":"比喻平时不学习，临到出阵作战才去学习兵法。","source":{"text":"此非俗语所云临阵带兵书乎。","book":"清·翟灏《通俗编·武功》"}},{"id":3564,"word":"临阵磨刀","pinyin":"lín zhèn mó dāo","abbr":"lzmd","explanation":"临：到、快要；阵：上阵打仗。到快要上阵打仗时才磨刀磨枪。","source":{"text":"‘临阵磨枪’也不中用；有这会子着急，天天写写念念，有多少完不了的？","book":"清·曹雪芹《红楼梦》第70回"},"example":{"text":"～也不顶用，只有靠平时的努力。"},"similar":["临阵磨枪","措手不及","临渴掘井"],"opposite":["常备不懈","防患未然"],"usage":"作谓语、定语；指突击"},{"id":3565,"word":"临阵磨枪","pinyin":"lín zhèn mó qiāng","abbr":"lzmq","explanation":"临：到，快要；阵：阵地、战场；枪：指梭镖、长矛一类的武器。到了快要上阵打仗的时候才磨刀擦枪。比喻事到临头才匆忙准备。","source":{"text":"‘临阵磨枪’，也不中用！有这会子着急，天天写写念念，有多少完不了的？","book":"清·曹雪芹《红楼梦》第七十回"},"example":{"text":"学习要靠平时努力，不要～，到考试前才用功。"},"similar":["临阵磨刀","措手不及","临渴掘井"],"opposite":["常备不懈","防患未然"],"usage":"作谓语、定语；比喻事到临头才匆忙"},{"id":3566,"word":"临阵脱逃","pinyin":"lín zhèn tuō táo","abbr":"lztt","explanation":"临到打仗时逃跑了。也比喻到了紧要关头退缩逃避。","source":{"text":"在法，初逃者从重捆打，再逃则斩矣；临阵脱逃，初次即斩矣，亦求危其怨乎。","book":"明·徐光启《疏辩》"},"example":{"text":"你们中国的兵勇，一到有起事来 ，不是半途溃散，便是～，那是不关我教习的事。","book":"清·无名氏《官场维新记》第四回"},"similar":["惊惶万状","贪生怕死","惊慌失措"],"opposite":["视死如归","临危不惧","大义凛然"],"usage":"作谓语、宾语、定语、状语；指退缩"},{"id":3567,"word":"临难不屈","pinyin":"lín nàn bù qū","abbr":"lnbq","explanation":"犹言临危不惧。","source":{"text":"高祖嘉其临难不屈，赐其家粟帛甚厚。","book":"《旧唐书·刘弘基传》"},"usage":"作谓语、定语；用于处事"},{"id":3568,"word":"临难不恐","pinyin":"lín nàn bù kǒng","abbr":"lnbk","explanation":"临：到；难：灾难；恐：恐惧。遇到危难，一点也不惧怕。","source":{"text":"夫见利不喜，上虽厚赏无以劝之，临难不恐，上虽严刑无以威之，此之谓不令之民也。","book":"《韩非子·说疑》"},"example":{"text":"见危致命，～。","book":"《旧唐书·郗士美李鄘等传》"},"similar":["临难不惧"],"opposite":["临事而惧"],"usage":"作谓语、定语；指人沉着、冷静"},{"id":3569,"word":"临难不惧","pinyin":"lín nàn bù jǔ","abbr":"lnbj","explanation":"临：到；难：灾难；惧：恐惧。遇到危难，一点也不惧怕。","source":{"text":"夫见利不喜，上虽厚赏无以劝之，临难不恐，上虽严刑无以威之，此之谓不令之民也。","book":"《韩非子·说疑》"},"example":{"text":"世之议公者才气各有高卑，然皆以～，谈笑就死为雄。","book":"宋·苏轼《孔北海赞》"},"similar":["临危不惧"],"opposite":["临事而惧"],"usage":"作谓语、定语；指临危不惧"},{"id":3570,"word":"临难不慑","pinyin":"lín nàn bù shè","abbr":"lnbs","explanation":"面对危难，毫不恐惧。同“临难不惧”。","source":{"text":"夫见利不喜，上虽厚赏无以劝之，临难不恐，上虽严刑无以威之，此之谓不令之民也。","book":"《韩非子·说疑》"},"example":{"text":"看这绑缚汉子，伟干长躯，丰神轩举，～，必是人豪。","book":"明·屠隆《彩毫记·预识汾阳》"},"similar":["临难不恐","临难无慑"],"usage":"作谓语、定语；指人沉着、冷静"},{"id":3571,"word":"临难不苟","pinyin":"lín nàn bù gǒu","abbr":"lnbg","explanation":"指遇到危难不苟且偷生。","source":{"text":"有若仲由之结缨，鉏麑之触树，纪信之蹈火，豫让之斩衣，此所谓杀身成仁，临难不苟者也。","book":"语出《礼记·曲礼上》：“临难毋不苟。”《旧唐书·忠义传序》"},"example":{"text":"至于贼纵所及，直省驻防各营～，忠节如林。","book":"清·陈康祺《郎潜纪闻》卷一"},"similar":["临危不苟"],"usage":"作谓语、定语；指人的气节"},{"id":3572,"word":"临难不避","pinyin":"lín nàn bù bì","abbr":"lnbb","explanation":"避：回避。到了危难之时并不躲避。形容勇敢胆大。","source":{"text":"夫料事能中，智也；尽心谋国，忠也；临难不避，勇也；杀身救国，仁也。","book":"明·冯梦龙《东周列国志》第四十四回"},"usage":"作谓语、宾语；指人很勇敢"},{"id":3573,"word":"临难不顾","pinyin":"lín nàn bù gù","abbr":"lnbg","explanation":"临：遇到；难：危难；顾：顾惜。遇到危难的时候，并不顾惜自己。形容没有私心，十分英勇。","source":{"text":"扬六军之大势，安城守之惧心，临难而不顾，毕志传命。","book":"晋·陈寿《三国志·魏志·齐王房传》"},"example":{"text":"披坚执锐，～，身先士卒；赏必行，罚必信。","book":"明·罗贯中《三国演义》第72回"},"similar":["临危不顾"],"usage":"作谓语、定语、状语；指十分英勇"},{"id":3574,"word":"临难如归","pinyin":"lín nàn rú guī","abbr":"lnrg","explanation":"犹言视死如归。","source":{"text":"至于轻生蹈节，临难如归，杀身成仁，死而无悔，自非耿介苦心之人，郁怏激气之士，亦何能若斯。","book":"《魏书·节义传序》"},"example":{"text":"模雄壮之烈，楷忠贞之操，杀身成义，～，非大丈夫亦何能若此矣。","book":"《北史·崔挺等传论》"},"usage":"作谓语、定语；用于处事"},{"id":3575,"word":"临难无慑","pinyin":"lín nán wú shè","abbr":"lnws","explanation":"慑：恐惧。面对危难，却无所恐惧。","source":{"text":"临难无慑，在黜无愠，危不去主，仕不违亲。","book":"唐·张说《齐黄门侍郎卢思道碑》"},"similar":["临难不慑"],"usage":"作谓语、定语；指人沉着、冷静"},{"id":3576,"word":"临难苟免","pinyin":"lín nàn gǒu miǎn","abbr":"lngm","explanation":"遇到危难时苟且偷生。","source":{"text":"临难毋苟免。","book":"《礼记·曲礼上》"},"example":{"text":"～，吾不忍也。","book":"《后汉书·王允传》"},"similar":["苟且偷生"],"opposite":["临难不苟"],"usage":"作谓语；指遇到危难时苟且偷生"},{"id":3577,"word":"临难铸兵","pinyin":"lín nàn zhù bīng","abbr":"lnzb","explanation":"临到危难时，方才铸造兵器。比喻平时不作准备，临时才想办法。","source":{"text":"溺者不问队，迷者不问路。溺而后问坠，迷而后问路，譬之犹临难而遽铸兵，临噎而遽掘井，虽速，亦无及已。","book":"《晏子春秋·内篇杂上》"},"example":{"text":"贼已至城下，方复求军，～，岂及马腹。","book":"《梁书·韦叡传》"},"similar":["临渴掘井"],"opposite":["有备而来"],"usage":"作谓语、定语；指临时抱佛脚"},{"id":3578,"word":"临风对月","pinyin":"lín fēng duì yuè","abbr":"lfdy","explanation":"面对清风明月。形容所处景色极易引动思绪。","source":{"text":"高碧岩古洞，完全性命，临风对月，笑傲希夷。","book":"金·丘处机《沁园春·示众》词"},"example":{"text":"前日小姐同婢妾，在此花园游玩，使佳人才子，～，心非木石，岂无所思。","book":"明·无名氏《误失金环》第三折"},"usage":"作谓语、定语；用于书面语"},{"id":3579,"word":"临风玉树","pinyin":"lín fēng yù shù","abbr":"lfys","explanation":"形容人风度潇洒，秀美多姿。同“玉树临风”。","source":{"text":"凌烟像，空倚临风玉树。","book":"宋·刘辰翁《摸鱼儿》词"}},{"id":3580,"word":"临食废箸","pinyin":"lín shí fèi zhù","abbr":"lsfz","explanation":"箸：筷子。临到吃时却丢掉了筷子。形容心神不安的样子。","source":{"text":"此冉之所以卧不安席，临食而废箸者也。","book":"明·冯梦龙《东周列国志》第一百六回"},"usage":"作谓语、定语；用于书面语"},{"id":3581,"word":"丸泥封关","pinyin":"wán ní fēng guān","abbr":"wnfg","explanation":"丸泥：一点泥，比喻少；封：封锁。形容地势险要，只要少量兵力就可以把守。","source":{"text":"元请一丸泥为大王东封函谷关。","book":"《后汉书·隗嚣传》"},"example":{"text":"仍愿～再闭一千载，天雨新好花，长是看花时。","book":"清·黄遵宪《樱花歌》诗"},"similar":["一夫当关"],"usage":"作定语；形容地势险要"},{"id":3582,"word":"丹之所藏者赤","pinyin":"dān zhī suǒ cáng zhě chì","abbr":"dzsczc","explanation":"比喻交朋友必须谨慎选择。","source":{"text":"丹之所藏者赤，漆之所藏者黑。是以君子必慎与处者焉。","book":"《孔子家语·六本》"}},{"id":3583,"word":"丹书白马","pinyin":"dān shū bái mǎ","abbr":"dsbm","explanation":"古代帝王赐给功臣享有世袭爵位和免罪等特权的证件时，宰白马歃其血，以示坚守誓约，后人称为“丹书白马”。","source":{"text":"白马之盟，谓刑白马歃其血以为盟也。","book":"《汉书·高惠高后文功臣表》：“申以丹书之信，重以白马之盟。”颜师古注"},"example":{"text":"开国承家，～。","book":"唐·杨炯《后周青州刺史齐贞公宇文公神道碑》"},"similar":["丹书铁契"],"usage":"作宾语、定语；用于盟约"},{"id":3584,"word":"丹书铁券","pinyin":"dān shū tiě quàn","abbr":"dstq","explanation":"丹书：用朱砂写字；铁契：用铁制的凭证。古代帝王赐给功臣世代享受优遇或免罪的凭证。文凭用丹书写铁板上，故名。","source":{"text":"丹书铁券，传于无穷。","book":"《后汉书·祭遵传》"},"example":{"text":"先朝赐有～，安居乐业。","book":"清·陈忱《水浒后传》第二十七回"},"similar":["丹书铁契","金书铁券","誓书铁券"],"usage":"作主语、宾语；指古代特权凭证"},{"id":3585,"word":"丹书铁契","pinyin":"dān shū tiě qì","abbr":"dstq","explanation":"丹书：用朱砂写字；铁契：用铁制的凭证。古代帝王赐给功臣世代享受优遇或免罪的凭证。文凭用丹书写铁板上，故名。","source":{"text":"又与功臣剖符作誓，丹书铁契，金匮石室，藏之宗庙。","book":"东汉·班固《汉书·高帝纪下》"},"example":{"text":"你就是有～，我也不怕你。"},"similar":["丹书铁券"],"usage":"作宾语；指古代特权凭证"},{"id":3586,"word":"丹凤朝阳","pinyin":"dān fèng cháo yáng","abbr":"dfcy","explanation":"比喻贤才逢明时。","source":{"text":"凤凰鸣矣，于彼高冈。梧桐生矣，于彼朝阳。","book":"《诗经·大雅·卷阿》"},"example":{"text":"前后同心八谏臣，朝阳丹凤一齐鸣。除奸反正扶明主，留得功勋耀古今。","book":"明·王世贞《鸣凤记》第一出"},"opposite":["怀才不遇","生不逢时"],"usage":"作谓语、定语；比喻贤才赶上好时机"},{"id":3587,"word":"丹垩一新","pinyin":"dān è yī xīn","abbr":"deyx","explanation":"丹：朱漆；垩：白土。油漆白土，粉刷一新、比喻面貌改变。","source":{"text":"台观飞涌，丹垩炳焕。","book":"宋·苏轼《杭州龙井院讷斋记》"}},{"id":3588,"word":"丹墀","pinyin":"dan chi","abbr":"dc","explanation":"皇帝殿前石阶，涂上红色，叫做丹墀。"},{"id":3589,"word":"丹心一寸","pinyin":"dān xīn yī cùn","abbr":"dxyc","explanation":"丹心：赤心，忠贞的心。一片赤诚的心。","source":{"text":"白发千茎雪，丹心一寸灰。","book":"唐·杜甫《郑附马池台喜遇郑广文同饮》诗"},"example":{"text":"从饶白发千茎雪，难把丹心一寸灰。","book":"清·洪昇《长生殿·献饭》"}},{"id":3590,"word":"丹心如故","pinyin":"dān xīn rú gù","abbr":"dxrg","explanation":"丹心：忠心。仍如已往一样忠心耿耿。"},{"id":3591,"word":"丹心碧血","pinyin":"dān xīn bì xuè","abbr":"dxbx","explanation":"丹心：红心、忠心。碧血：血化为碧玉。碧：青绿色的宝石，表示血的珍贵。赤诚的忠心，宝贵的鲜血。用以赞扬为国捐躯的重大牺牲。","source":{"text":"孤忠既足明丹心，三年犹须化碧血。","book":"《庄子·外物》：“苌弘死于蜀，藏其血，三年而化为碧。”元·郑元祐《张御史死节歌》"},"example":{"text":"这一个～扶周主，那一个赤胆忠肝助纣王。","book":"明·许仲琳《封神演义》第九十五回"},"similar":["碧血丹心"],"opposite":["背信弃义"],"usage":"作宾语、定语；指忠臣","story":["周朝时期，刘文公的大夫苌弘一生忠于朝廷，不卑不亢，有浩然正气。他因为正直而得罪了朝中权贵，蒙冤被周人杀害，传说他被杀的当时，有人慕名收集他的血液藏在家里，三年后这些干血块全都化为碧玉"]},{"id":3592,"word":"丹心赤忱","pinyin":"dān xīn chì chén","abbr":"dxcc","explanation":"丹心：红心，忠心；赤忱：真心实意。形容一片忠心赤诚。","source":{"text":"劳瘁心力，忍饥耐寒，对于国内外读者竭诚服务的一片丹心赤忱缔结而成。","book":"邹韬奋《抗战以来·广大读者爱护支持的文化堡垒》"},"similar":["忠心耿耿"],"usage":"作宾语、定语；指人很忠诚"},{"id":3593,"word":"丹楹刻桷","pinyin":"dān yíng kè jué","abbr":"dykj","explanation":"楹：房屋的柱子；桷：方形的椽子。柱子漆成红色，椽子雕着花纹。形容建筑精巧华丽。","source":{"text":"刻其桷，皆非礼也。","book":"《左传·庄公二十三年》：“丹桓宫楹。”又《左传·庄公二十四年》"},"example":{"text":"园中筑起三层高台，中间建起一座绛霄楼，画栋雕梁，～，四围朱栏曲槛。","book":"明·冯梦龙《东周列国志》第五十回"},"usage":"作定语；形容建筑精巧华丽"},{"id":3594,"word":"丹漆随梦","pinyin":"dān qī suí mèng","abbr":"dqsm","explanation":"指追随前哲。","source":{"text":"齿在逾立，则尝梦执丹漆之礼器，随仲尼而南行。","book":"南朝·梁·刘勰《文心雕龙·序志》"},"example":{"text":"丹漆应随梦，珠囊岂浪传。","book":"清·钱谦益《和遵王感怀述德四十韵》"},"usage":"作宾语、定语；指追随前哲"},{"id":3595,"word":"丹赤漆黑","pinyin":"dān chì qī hēi","abbr":"dcqh","explanation":"丹：红的；漆：黑的。红的就是红的，黑的就是黑的。比喻人或事物的本来面目。","source":{"text":"丹之所藏者朱，漆之所藏者黑，是以君子必慎其所处者焉。","book":"《孔子家语·六本》"}},{"id":3596,"word":"丹铅甲乙","pinyin":"dān qiān jiǎ yǐ","abbr":"dqjy","explanation":"指点校书籍，评定次第。","source":{"text":"千子慨然悯之，取一代之文，丹铅甲乙，辨其黑白。","book":"清·戴名世《序》"},"similar":["丹黄甲乙"],"usage":"作谓语、定语；用于读书"},{"id":3597,"word":"丹青不渝","pinyin":"dān qīng bù yú","abbr":"dqby","explanation":"丹、青：丹砂、青雘，是古代绘画中常用的两种颜料，不易褪色。始终不渝，光明显著。","source":{"text":"丹青不渝，故以方誓。","book":"三国·魏·阮籍《咏怀》诗：“丹青著明誓，永世不相忘。”李善注"},"usage":"作宾语、定语；用于书面语"},{"id":3598,"word":"丹青之信","pinyin":"dān qīng zhī xìn","abbr":"dqzx","explanation":"丹：红色；信：确实。红黑二色是不变的颜色。比喻事情已经明了，不可改变。","source":{"text":"明告以生活丹青之信。","book":"《汉书·王莽传》"},"example":{"text":"臣愿得奉威命，开以～。","book":"《资治通鉴·汉纪·光武帝建光三年》"}},{"id":3599,"word":"丹青妙手","pinyin":"dān qīng miào shǒu","abbr":"dqms","explanation":"丹青：原指丹砂和青欔两种作颜料的矿物，后泛指颜料。多指国画大师。","source":{"text":"世间无限丹青手，一片伤心画不成。","book":"唐·高蟾《金陵晚眺》"},"example":{"text":"徐悲鸿是一代～。"},"similar":["妙手回春"],"opposite":["笨手笨脚"],"usage":"作主语、宾语、定语；指画家"},{"id":3600,"word":"丹青过实","pinyin":"dān qīng guò shí","abbr":"dqgs","explanation":"丹青：红色和青色的颜料，借指绘画。绘画景物的美超过了实际景物。形容绘画技艺高超。","source":{"text":"每疑丹青过实，今观此景，乃知良工苦心。","book":"明·王稚登《客越志》"}},{"id":3601,"word":"丹黄甲乙","pinyin":"dān huáng jiǎ yǐ","abbr":"dhjy","explanation":"指点校书籍，评定次第。","source":{"text":"句读之有析，文理之不通，而俨然丹黄甲乙，衡加于经传，不已傎乎！","book":"清·钱谦益《葛端调编次诸家文集序》"},"similar":["丹铅甲乙"],"usage":"作谓语、定语；用于读书"},{"id":3602,"word":"为万安计","pinyin":"wei wan an ji","abbr":"wwaj","explanation":"为绝对安全着想。"},{"id":3603,"word":"为丛驱雀","pinyin":"wèi cóng qū què","abbr":"wcqq","explanation":"丛：丛林；驱：赶。把雀赶到丛林。比喻不会团结人，把一些本来可以团结的人赶到敌对方面去。","source":{"text":"为渊驱鱼者，獭也。为丛驱爵者，鹯也；为汤武驱民者，桀与纣也。","book":"《孟子·离娄上》"},"example":{"text":"朝夕而絮聒之，是～，其离滋甚耳。","book":"清·蒲松龄《聊斋志异·恒娘》"},"similar":["为渊驱鱼"],"usage":"作谓语；指为政不善"},{"id":3604,"word":"为之一振","pinyin":"wéi zhī yī zhèn","abbr":"wzyz","explanation":"为：因；振：振奋。因此而振奋起来。","source":{"text":"登以八百人破敌数千骑，军气为之一振，捷闻，封定襄伯，予世券。","book":"《明史·郭登传》"},"example":{"text":"李莫愁斗逢大敌，精神～，想不到这高瘦和尚膂力固然沉厚，出招尤是迅捷。","book":"金庸《神雕侠侣》第二十二回"}},{"id":3605,"word":"为之以歙，应之以张","pinyin":"wéi zhī yǐ xī，yìng zhī yǐ zhāng","abbr":"wzysyzyz","explanation":"歙：收敛；张：伸展，扩张。要收敛某件事情，用暂进扩张开去的办法，造成其错觉，然后再收敛起来。","source":{"text":"故用兵之道，示之以柔，而迎之以刚；示之以弱，而乘之以强；为之以歙，而应之以张；将欲西，而示之以东；先忤而后合，前冥而后明。","book":"《老子》：“将欲歙之，必固张之。”《淮南子·兵略训》"}},{"id":3606,"word":"为之执鞭","pinyin":"wèi zhī zhí biān","abbr":"wzzb","explanation":"执：拿着；鞭：马鞭。拿起鞭子为人驾驭车马。比喻为人服役。有景仰，追随的意思。","source":{"text":"假令晏子而在，余虽为之执鞭，所忻慕焉。","book":"《史记·管晏列传》"},"example":{"text":"明季至今，为岁不远，陵阳陆公犹存乎？尚有灵焉否也？～，所忻慕焉。","book":"清·蒲松龄《聊斋志异·陆判》"}},{"id":3607,"word":"为五斗米折腰","pinyin":"wèi wǔ dǒu mǐ zhé yāo","abbr":"wwdmzy","explanation":"五斗米：晋代县令的俸禄，后指微薄的俸禄；折腰：弯腰行礼，指屈身于人。为了微薄的俸禄而弯腰行礼。比喻没有骨气。","source":{"text":"吾不能为五斗米折腰，拳拳事乡里小人邪。","book":"《晋书·陶潜传》"},"similar":["苟且偷生"],"usage":"作谓语、定语；用于处事"},{"id":3608,"word":"为人为彻","pinyin":"wèi rén wèi chè","abbr":"wrwc","explanation":"指帮助人要帮助到底。","source":{"text":"八戒道：‘哥哥，吃的忙了些，不象你们细嚼细咽，尝出些滋味。我也不知有核无核，就吞下去了。哥啊，为人为彻，已经调动我这馋虫，再去弄个儿来，老猪细细的吃吃。’","book":"明·吴承恩《西游记》第二十四回"},"usage":"作谓语、宾语；用于处事"},{"id":3609,"word":"为人作嫁","pinyin":"wèi rén zuò jià","abbr":"wrzj","explanation":"原意是说穷苦人家的女儿没有钱置备嫁衣，却每年辛辛苦苦地用金线刺绣，给别人做嫁衣。比喻空为别人辛苦。","source":{"text":"苦为年年压金线，为他人作嫁衣裳。","book":"唐·秦韬玉《贫女》诗"},"example":{"text":"何必～？但是我进京以来，素无人知，今日你来破例，恐将来缠绕不休。","book":"清·曹雪芹《红楼梦》第九十五回"},"similar":["徒劳无益","舍己为人"],"opposite":["损人利己"],"usage":"作谓语、宾语、定语；形容白为别人劳动"},{"id":3610,"word":"为人师表","pinyin":"wéi rén shī biǎo","abbr":"wrsb","explanation":"师表：榜样，表率。在人品学问方面作别人学习的榜样。","source":{"text":"杨愔重其德业，以为人之师表。","book":"《北齐书·王昕书》"},"example":{"text":"《北齐书·王昕书》：“杨愔重其德业，以为人之师表。”"},"similar":["率马以骥"],"opposite":["误人子弟"],"usage":"作谓语；多指教师"},{"id":3611,"word":"为人择官","pinyin":"wèi rén zé guān","abbr":"wrzg","explanation":"因人而设立机构或职务。","source":{"text":"为人择官者乱，失其所强者弱。","book":"秦·黄石公《素书·遵义章》"},"example":{"text":"古者为官择人，未尝～。今乃因冠而改窠阙，近于～也。","book":"清·毕沅《续资治通鉴》卷一百四十四"}},{"id":3612,"word":"为人捉刀","pinyin":"wèi rén zhuō dāo","abbr":"wrzd","explanation":"捉：持，拿。表示代人作文章或做事情。","source":{"text":"既毕，令间谍问曰：‘魏王如何？’匈奴使答曰：‘魏王雅望非常，然床头捉刀人，此乃英雄也。’魏王闻之，追杀此使。","book":"南朝·宋·刘义庆《世说新语·容止》"}},{"id":3613,"word":"为人说项","pinyin":"wèi rén shuō xiàng","abbr":"wrsx","explanation":"为：替；项：唐朝项斯，字子迁，为杨敬之所器重。指替人说好话。","source":{"text":"平生不解藏人善，到处逢人说项斯。","book":"唐·杨敬之《赠项斯》"},"example":{"text":"行辕中又送来几封京里书札，雯青一一检视，也有亲友寻常通贺的，也有大人先生～的。","book":"清·曾朴《孽海花》第九回"},"similar":["代为说项"],"usage":"作谓语、宾语、定语；指替人说好话","story":["唐朝时期，江东年轻人项斯，字子迁，参加会考开始没有什么名气，别人拿他的卷子去给杨敬之看。杨特别喜欢就作诗“几度见诗诗尽好，及观标格过于诗，平生不解藏人善，到处逢人说项斯。”没多久，他就被长安方面录取"]},{"id":3614,"word":"为仁不富","pinyin":"wéi rén bù fù","abbr":"wrbf","explanation":"要仁爱就不能发财致富。参见“为富不仁”。","source":{"text":"阳虎曰：‘为富不仁矣，为仁不富矣。’","book":"《孟子·滕文公上》"},"example":{"text":"施生虽是好人，却是～，家事也渐渐消乏不如前了。","book":"明·冯梦龙《警世通言》第二十五卷"},"opposite":["为富不仁"],"usage":"作宾语、定语；用于劝诫人","story":["战国时期，诸侯滕国国君想实行仁政，手下人把孟子推荐给他，他虚心请教怎样实行仁政。孟子说想一心发财的人是不能实行仁政的就是说“为富不仁，为仁不富”，实行仁政的君主征收赋税是有限度的，只有老百姓富了国家才能富强"]},{"id":3615,"word":"为仁由己","pinyin":"wéi rén yóu jǐ","abbr":"wryj","explanation":"实行仁德，完全在于自己。表示做好事全凭自己作出决定。","source":{"text":"克己复礼为仁。一日克己复礼，天下归仁焉。为仁由己，而由仁乎哉？","book":"《论语·颜渊》"},"example":{"text":"夫忠为令德，～，万里一契，义不在言也。","book":"《晋书·温峤传》"}},{"id":3616,"word":"为今之计","pinyin":"wéi jīn zhī jì","abbr":"wjzj","explanation":"从当前的处境打算，从当前的情况出发，先解决眼前的急难。","source":{"text":"为今之计，当节其大者，而莫大于土木之功。","book":"《宋史·张根传》"},"example":{"text":"～，何法处之方妥？","book":"明·许仲琳《封神演义》第七回"}},{"id":3617,"word":"为善最乐","pinyin":"wéi shàn zuì lè","abbr":"wszl","explanation":"做善事是最快乐的事。常用为劝人多行善事的格言。","source":{"text":"日者问东平王，处家何等最乐？王言为善最乐。","book":"《后汉书·东平宪王苍传》"},"example":{"text":"～，读书便佳。","book":"清·阮葵生《茶余客话》卷十二"},"usage":"作谓语、宾语；用于劝诫人"},{"id":3618,"word":"为国为民","pinyin":"wéi guó wéi mín","abbr":"wgwm","explanation":"指不谋私利，为国家和人民效力。","source":{"text":"为国为民声华重。","book":"明·胡文焕《群音类选·草庐记·玄德合巹》"},"usage":"作谓语、定语；用于处事"},{"id":3619,"word":"为国捐躯","pinyin":"wèi guó juān qū","abbr":"wgjq","explanation":"捐：献；躯：身体，指生命。为国家牺牲生命。","source":{"text":"可怜成汤首相，为国捐躯。","book":"明·许仲琳《封神演义》第五十二回"},"example":{"text":"～赴战场，丹心可并日争光。","book":"清·钱彩《说岳全传》第三十九回"},"similar":["为国献身"],"usage":"作谓语、定语；指为国家牺牲生命"},{"id":3620,"word":"为天下笑","pinyin":"wéi tiān xià xiào","abbr":"wtxx","explanation":"指被天下人所耻笑。","source":{"text":"楚灵王方会诸侯于申，诛齐庆封，作章华台，求周九鼎之时，志小天下；及饿死于申亥之家，为天下笑。","book":"《史记·楚世家》"},"example":{"text":"使百官方贺而蝗若此，岂不～邪！","book":"清·毕沅《续资治通鉴》卷三十三"}},{"id":3621,"word":"为天下谷","pinyin":"wéi tiān xià gǔ","abbr":"wtxg","explanation":"谷：山川。指甘愿作天下的川谷，不为世人所知道，与世无争。","source":{"text":"知其荣，守其辱，为天下谷；为天下谷，常德乃足，复归于朴。","book":"《老子》第二十八章"}},{"id":3622,"word":"为好成歉","pinyin":"wéi hǎo chéng qiàn","abbr":"whcq","explanation":"比喻好心得不到好报，将恩作仇。","source":{"text":"不能报恩人之德，反累恩人的清名，为好成歉，皆奴之罪。","book":"明·冯梦龙《警世通言》卷二十一"},"similar":["要好成歉"],"usage":"作谓语；比喻好心得不到好报"},{"id":3623,"word":"为子死孝，为臣死忠","pinyin":"wéi zǐ sǐ xiào，wé chén sī zhōng","abbr":"wzsxwcsz","explanation":"为：作为；臣：臣子。封建社会认为做儿女的应当不惜生命孝敬父母，当臣子的应当不惜生命忠于帝王。","source":{"text":"为子死孝，为臣死忠，死又何妨。","book":"宋·文天祥《沁园春》词"},"example":{"text":"～，分也！忽将从子纠于地下，安能受桎梏之辱？","book":"明·冯梦龙《东周列国志》第十六回"}},{"id":3624,"word":"为官择人","pinyin":"wèi guān zé rén","abbr":"wgzr","explanation":"从工作的需要出发设立机构，挑选人才。","source":{"text":"足下任此，岂可不远览载籍废兴之由，荣辱之机，弃忘旧恶，宽和群司，审量五材，为官择人？","book":"《三国志·蜀志·许靖传》"},"example":{"text":"要在人君必审择相，相必当～，懋赏立乎前，诛戮设乎后，人才不出，吾不信也。","book":"《宋史·史浩传》"}},{"id":3625,"word":"为害无穷","pinyin":"wéi hài wú qióng","abbr":"whwq","explanation":"为：成为，作为；害：祸害；无穷：没有穷尽。成为无穷无尽的祸害。形容祸害极大。","source":{"text":"辛亥，台臣言江西推排田结局已久，旧设都官、团长等虚名尚在，占吝常役，为害无穷。","book":"《宋史·度宗纪》"},"example":{"text":"我想这青苗一出，万民不胜其苦，～，小官屡次移书谏阻，因此王安石与俺为仇。","book":"元·吴昌龄《东坡梦》第一折"}},{"id":3626,"word":"为富不仁","pinyin":"wéi fù bù rén","abbr":"wfbr","explanation":"为：做，引伸为谋求。剥削者为了发财致富，心狠手毒，没有一点儿仁慈的心肠。","source":{"text":"为富不仁矣，为仁不富矣。。","book":"《孟子·滕文公上》"},"example":{"text":"自古道“～”。","book":"清·陈忱《水浒后传》第二回"},"similar":["心狠手辣","唯利是图"],"opposite":["为仁不富"],"usage":"作谓语、宾语、定语；指唯利是图","story":["战国时期，诸侯滕国国君想实行仁政，手下人把孟子推荐给他，他虚心请教怎样实行仁政。孟子说想一心发财的人是不能实行仁政的就是说“为富不仁，为仁不富”，实行仁政的君主征收赋税是有限度的，只有老百姓富了国家才能富强"]},{"id":3627,"word":"为小失大","pinyin":"wèi xiǎo shī dà","abbr":"wxsd","explanation":"为了小利，造成巨大损失。","source":{"text":"你若不肯，他就告诉了大老爷，找你点错处，革掉了你，你能为小失大吗？","book":"清·李宝嘉《文明小史》第二十九回"},"similar":["因小失大"],"usage":"作谓语、宾语；指因小失大"},{"id":3628,"word":"为小妨大","pinyin":"wèi xiǎo fáng dà","abbr":"wxfd","explanation":"为了小利，造成巨大损失。","source":{"text":"那时连贤弟也有干系，却不是为小妨大，把一天好事自家弄坏了？","book":"明·冯梦龙《醒世恒言》卷七"}},{"id":3629,"word":"为山九仞，功亏一篑","pinyin":"wéi shān jiǔ rèn，gōng kuī yī kuì","abbr":"wsjrgkyk","explanation":"九仞：极言其高；亏：欠缺；篑：盛土的筐子。堆九仞高的山，只缺一筐土而不能完成。比喻作事情只差最后一点没能完成。","source":{"text":"为山九仞，功亏一篑。","book":"《尚书·旅獒》"},"example":{"text":"事先败而后成，回失之东隅，收之桑榆；事将成而终止，曰～。","book":"清·程允升《幼学琼林·地舆》"}},{"id":3630,"word":"为山止篑","pinyin":"wéi shān zhǐ kuì","abbr":"wszk","explanation":"比喻功败垂成。","source":{"text":"譬如为山，未成一篑。止，吾止也。","book":"语出《论语·子罕》"},"example":{"text":"《北齐书·神武帝纪》：“～，相为惜之。”"},"similar":["功败垂成","功亏一篑"],"usage":"作定语；用于处事"},{"id":3631,"word":"为德不卒","pinyin":"wéi dé bù zú","abbr":"wdbz","explanation":"卒：完毕，终了。指没有把好事做到底。","source":{"text":"公，小人也，为德不卒。","book":"《史记·淮阴侯列传》"},"example":{"text":"快呀，请指示我！莫要“～”！","book":"鲁迅《三闲集·通信》"},"similar":["为德不终"],"opposite":["送佛送到西"],"usage":"作谓语；指好事没有做到底"},{"id":3632,"word":"为德不终","pinyin":"wéi dé bù zhōng","abbr":"wdbz","explanation":"指没有把好事做到底。同“为德不卒”。","source":{"text":"钱康侯叹一口气，蹙着眉头说：‘……唉，为德不终，我想起来非常之难过！’","book":"叶圣陶《乡里善人》"},"similar":["为德不卒"],"usage":"作谓语；指好事没有做到底"},{"id":3633,"word":"为恶不悛","pinyin":"wéi è bù quān","abbr":"webq","explanation":"坚持作恶，不肯悔改。","source":{"text":"贾后为恶不悛。","book":"晋·干宝《搜神记》第七卷"},"example":{"text":"这个人～，终究要受到法律的制裁。"},"opposite":["改过自新"],"usage":"作谓语、定语；指死不悔改"},{"id":3634,"word":"为所欲为","pinyin":"wéi suǒ yù wéi","abbr":"wsyw","explanation":"为：做。本指做自己想做的事。后指想干什么就干什么。","source":{"text":"所以准验辰历，分考次度，其于揆测，唯所欲为之者也。","book":"《资治通鉴·周纪威烈王二十三年》：“子乃为所欲为，顾不易耶？何乃自苦如此？求以报仇，不亦难乎？”《隋书·天文志上》"},"example":{"text":"他们满以为有了如此强大精良的武器，就可以在别人的国土上横行霸道、～。","book":"峻青《不尽巨涛滚滚来》"},"similar":["随心所欲","胡作非为"],"opposite":["安分守己"],"usage":"作谓语、宾语、状语；指随心所欲"},{"id":3635,"word":"为时尚早","pinyin":"wéi shí shàng zǎo","abbr":"wssz","explanation":"不适时，还早了点。","source":{"text":"原来为时尚早，吴家未曾开得大门。","book":"清·李宝嘉《官场现形记》第二回"},"example":{"text":"今天我们给马寅初和章罗联盟下政治结论，～。","book":"章诒和《往事并不如烟·最后的贵族》"},"similar":["为时过早"],"opposite":["为时晚矣"],"usage":"作谓语；指还没到时候"},{"id":3636,"word":"为时过早","pinyin":"wéi shí guò zǎo","abbr":"wsgz","explanation":"不适时，还早了点。","source":{"text":"这些问题现在下结论，恐怕为时过早。","book":"章诒和《往事并不如烟·君子之交》"},"example":{"text":"现在下结论～。"},"similar":["为时尚早"],"opposite":["为时已晚"],"usage":"作谓语；指还没到时候"},{"id":3637,"word":"为期不远","pinyin":"wéi qī bù yuǎn","abbr":"wqby","explanation":"为：作为；期：日期，期限。指快到规定或算定的日子。","source":{"text":"他们之从抗日民族统一战线中分裂出去是为期不远的。","book":"毛泽东《上海太原失陷以后抗日战争的形势和任务》"},"example":{"text":"中国男子足球队进入世界杯“八强”的日子～了。"},"similar":["指日可待"],"opposite":["遥遥无期"],"usage":"作谓语；形容时间很快到来"},{"id":3638,"word":"为民父母","pinyin":"wéi mín fù mǔ","abbr":"wmfm","explanation":"这：作为，充当；父母：即父母官。担任地方行政长官。","source":{"text":"为民父母行政，不免于率兽而食人，恶在其为民父母也？","book":"《孟子·梁惠王上》"},"example":{"text":"～，得不省优？","book":"唐·陆挚《赐京畿及同、华等州百姓种子赈给贫人诏》"},"usage":"作谓语、定语；用于官员"},{"id":3639,"word":"为民请命","pinyin":"wèi mín qǐng mìng","abbr":"wmqm","explanation":"请命：请示保全生命。泛指有相当地位的人代表百姓向当权者陈述困难，提出要求。","source":{"text":"西乡为百姓请命。","book":"《史记·淮阴侯列传》：“因民之欲，西乡为百姓请命，则天下风走而响应矣，孰敢不听！”《汉书·蒯通传》"},"example":{"text":"《史记·淮阴侯列传》：“因民之欲，西乡为百姓请命，则天下风走而响应矣，孰敢不听！”《汉书·蒯通传》：“西乡为百姓请命。”"},"usage":"作谓语、定语；指替老百姓申诉痛苦","story":["明朝大清官海瑞一生十分清廉，心中始终装着老百姓，担任淳安县知县时，采取丈实田亩，大大减轻农民负担，因而得罪了总督胡宗宪，海瑞被嘉靖皇帝关入大牢，直到72岁才被重新启用，但他始终以为民请命为己任"]},{"id":3640,"word":"为民除害","pinyin":"wèi mín chú hài","abbr":"wmch","explanation":"替百姓除祸害。","source":{"text":"丞相衔奉国威，为民除害，元恶大憝，心当枭夷。","book":"汉·陈琳《檄吴将校部曲文》"},"example":{"text":"自然以～为主。","book":"清·刘鹗《老残游记》第七回"},"similar":["除暴安良"],"opposite":["为虎作伥","助纣为虐"],"usage":"作谓语、定语；指杀坏人"},{"id":3641,"word":"为民除患","pinyin":"wèi mín chú huàn","abbr":"wmch","explanation":"替百姓除祸害。同“为民除害”。","source":{"text":"为民除患，兄弟无复多人，弥应思吊不咸，益相亲信。","book":"汉·董仲舒《春秋繁露·俞序》：“故次以言：怨人不可迩，敌国不可狎，攘窃之国不可使久亲，皆防患、为民除患之意也。”《宋书·文九王列传》"},"similar":["为民除害"],"opposite":["为虎作伥"],"usage":"作谓语、定语；指杀坏人"},{"id":3642,"word":"为法自弊","pinyin":"wéi fǎ zì bì","abbr":"wfzb","explanation":"作定自弊。","source":{"text":"商君亡至关下，欲舍客舍。客人不知其是商君也，曰：‘商君之法，舍人无验者坐之。’商君喟然叹曰：‘嗟乎！为法之敝，一至此哉！’","book":"西汉·司马迁《史记·商君列传》"},"example":{"text":"他这是～。"},"similar":["作法自毙"],"opposite":["嫁祸于人"],"usage":"作谓语、宾语；指作法自毙","story":["战国时期，秦孝公任用商鞅在秦国进行一系列政治和经济制度改革，太子驷触犯新法被商鞅定罪。秦国逐渐富强起来。后来太子驷成为秦惠文王，他公报私仇要治商鞅罪过。商鞅出逃，没人敢收留，没想到商鞅作法自毙，被秦王所杀"]},{"id":3643,"word":"为渊驱鱼","pinyin":"wèi yuān qū yú","abbr":"wyqy","explanation":"原比喻残暴的统治迫使自己一方的百姓投向敌方。现多比喻不会团结人，把一些本来可以团结过来的人赶到敌对方面去。","source":{"text":"为渊驱鱼者，獭也。为丛驱爵者，鹯也；为汤武驱民者，桀与纣也。","book":"《孟子·离娄上》"},"example":{"text":"又被这些不肖官吏任意凌虐，以致～。","book":"清·李宝嘉《文明小史》第十三回"},"similar":["为丛驱雀","为人作嫁"],"opposite":["损人利己"],"usage":"作谓语、宾语；指工作方法不对"},{"id":3644,"word":"为渊驱鱼，为丛驱爵","pinyin":"wèi yuān qū yú，wèi cóng qū jué","abbr":"wyqywcqj","explanation":"比喻为政不善，人心涣散，使百姓投向敌方。爵，通“雀”。","source":{"text":"语出《孟子·离娄上》：“为渊驱鱼者，獭也；为丛驱爵者，鹯也；为汤武驱民者，桀与纣也。”《晋书·段灼传》引作“为川驱鱼，为薮驱雀”。"},"example":{"text":"奸胥劣绅，且得窥见罅以滋扰累，～，甚非计也。","book":"清·薛福成《请豁除旧禁招徕华民疏》"},"similar":["为渊驱鱼，为丛驱雀"],"usage":"作谓语、宾语、定语；用于处事"},{"id":3645,"word":"为渊驱鱼，为丛驱雀","pinyin":"wèi yuān qū yú，wèi cóng qū què","abbr":"wyqywcqq","explanation":"把鱼赶进深潭，把雀赶到丛林。原比喻统治者施行暴政，百姓逃到别国。现多比喻把一些本来可以团结过来的人赶到敌对方面去。","source":{"text":"为渊驱鱼者，獭也。为丛驱爵者，鹯也；为汤武驱民者，桀与纣也。","book":"《孟子·离娄上》"},"example":{"text":"国家平时患无人才，等到有了人才，又被这些不肖官吏任意凌虐，以致～。","book":"清·李宝嘉《文明小史》第十三回"},"similar":["为渊驱鱼，为丛驱爵"],"usage":"作谓语、宾语、定语；用于处事"},{"id":3646,"word":"为王称霸","pinyin":"wéi wáng chēng bà","abbr":"wwcb","explanation":"比喻专横跋扈，蛮不讲理。","source":{"text":"你手里又有了钱，离着我们又远，你就为王称霸起来，夜夜招聚匪类赌钱，养老婆小子。","book":"清·曹雪芹《红楼梦》第五十三回"}},{"id":3647,"word":"为而不恃","pinyin":"wéi ér bù shì","abbr":"webs","explanation":"为：做；恃：倚仗。做了好事而不自认为有功。","source":{"text":"万物作焉而不辞，生而不有，为而不恃，功成而弗居。夫唯弗居，是以不去。","book":"《老子》第二章"},"example":{"text":"天子～，成而不居，冲旨凝邈，固辞弗许。","book":"《隋书·薛道衡传》"}},{"id":3648,"word":"为臣死忠，为子死孝","pinyin":"wé chén sī zhōng，wéi zǐ sǐ xiào","abbr":"wcszwzsx","explanation":"为：作为；臣：臣子。封建社会认为当臣子的应当不惜生命忠于帝王，为儿女的应当不惜生命孝敬父母。","source":{"text":"为子死孝，为臣死忠，死又何妨。","book":"宋·文天祥《沁园春》词"},"example":{"text":"～，刬的说这等言语也。","book":"明·无名氏《岳飞精忠》头折"},"usage":"作宾语、定语；用于劝诫人"},{"id":3649,"word":"为虎作伥","pinyin":"wèi hǔ zuò chāng","abbr":"whzc","explanation":"伥：伥鬼，古时传说被老虎吃掉的人，死后变成伥鬼，专门引诱人来给老虎吃。替老虎做伥鬼。比喻充当恶人的帮凶。","source":{"text":"凡死于虎，溺于水之鬼号为伥，须得一人代之。","book":"《太平广记》卷四百三十：“伥鬼，被虎所食之人也，为虎前呵道耳。”宋·孙光宪《北梦琐言逸文》卷四"},"example":{"text":"为着要得虎子而身入虎穴，决不是身入虎穴去～。","book":"郭沫若《〈闻一多全集〉序》"},"similar":["为虎添翼","助纣为虐"],"opposite":["为民除害"],"usage":"作谓语、定语；指充当恶人的帮凶","story":["传说被老虎咬死的人变成鬼后死心塌地地听从老虎的指使，去引诱别人让老虎来吃。老虎出行，伥鬼在前面引路，帮助老虎逃避陷阱，如发现人，伥鬼就上去抓住那人，脱掉他的衣服让老虎来吃，老虎吃后，新的伥鬼产生，旧的伥鬼可以自由"]},{"id":3650,"word":"为虎傅翼","pinyin":"wèi hǔ fù yì","abbr":"whfy","explanation":"傅：通“附”；翼：翅膀。替老虎加上翅膀。比喻帮助坏人，增加恶人的势力。","source":{"text":"无为虎傅翼，将飞入邑，择人而食。","book":"《逸周书·寤敬》"},"example":{"text":"今复资之以兵，此～也。","book":"宋·司马光《资治通鉴·晋孝武帝太元八年》"},"similar":["为虎作伥","与虎添翼"],"opposite":["为民除害"],"usage":"作谓语、宾语、定语；指助长恶人的势力"},{"id":3651,"word":"为虎添翼","pinyin":"wèi hǔ tiān yì","abbr":"whty","explanation":"替老虎加上翅膀。比喻帮助坏人，增加恶人的势力。","source":{"text":"《逸周书·寤敬篇》：“毋为虎傅翼，将飞入邑，择人而食之。”《淮南子·兵略训》：“今乘万民之力而反为残贼，是为虎傅翼，曷为弗除。”《韩非子·难势》：“毋为虎傅翼，将飞入邑，择人而食之"},"example":{"text":"即令牺牲波兰，亦徒然～，增加希特勒西进争夺的力量。","book":"邹韬奋《欧战爆发与远东的关系》"},"similar":["为虎作伥","为虎傅翼"],"opposite":["为民除害"],"usage":"作谓语、宾语、定语；指助长恶人的势力"},{"id":3652,"word":"为虺弗摧","pinyin":"wéi huǐ fú cuī","abbr":"whfc","explanation":"虺：小蛇。小蛇不打死，大了就难办。比喻弱敌不除，必有后患。","source":{"text":"为虺弗摧，为蛇将若何？","book":"《国语·吴语》"},"example":{"text":"～终贻戚，我谋不用复奚论？","book":"姚光《伤心》诗"},"opposite":["斩草除根"],"usage":"作谓语；指弱敌不除，必有后患","story":["公元前494年，吴王夫差率军在夫椒大败越王勾践，并破了越国的首都。越王勾践派大夫文种向吴国求和，吴王准备答应。伍子胥认为不能许和说“为虺弗摧，为蛇将若何？”吴王不听他的建议，除恶未尽结果在20年后被勾践所消灭"]},{"id":3653,"word":"为虺弗摧，为蛇若何","pinyin":"wéi huǐ fú cuī，wéi shé ruò hé","abbr":"whfcwsrh","explanation":"虺：小蛇；弗：不；摧：消灭。小蛇不打死，大了就难办。比喻不乘胜将敌人歼灭，必有后患。","source":{"text":"夫越王好信以爱民，四方归之；年谷时熟，日长炎炎，及吾犹可以战也。为虺弗摧，为蛇将若何？","book":"《国语·吴语》"},"similar":["为虺弗摧"],"usage":"作宾语、定语；用于处事","story":["公元前494年，吴王夫差率军在夫椒大败越王勾践，并破了越国的首都。越王勾践派大夫文种向吴国求和，吴王准备答应。伍子胥认为不能许和说“为虺弗摧，为蛇将若何？”吴王不听他的建议，除恶未尽结果在20年后被勾践所消灭"]},{"id":3654,"word":"为蛇添足","pinyin":"wéi shé tiān zú","abbr":"wstz","explanation":"比喻做事节外生枝，不但无益，反而害事。同“为蛇画足”。","source":{"text":"分外为蛇添足，不省狙公赋芋，忧喜两相忘。","book":"元·姬翼《水调歌头》词"},"example":{"text":"此论～，又岂自然而然之道哉？","book":"明·王廷相《答何柏斋〈造化论〉》"},"similar":["为蛇画足"],"usage":"作谓语、定语、宾语；用于处事"},{"id":3655,"word":"为蛇画足","pinyin":"wéi shé huà zú","abbr":"wshz","explanation":"比喻做事节外生枝，不但无益，反而害事。","source":{"text":"《战国策·齐策二》：“楚有祠者，赐其舍人卮酒。舍人相谓曰：‘数人饮之不足，一人饮之有余；请画地为蛇，先成者饮酒。’一人蛇先成，引酒且饮之，乃左手持卮，右手画蛇，曰：‘吾能为之足。’未成，一人之蛇成，夺其卮曰：‘蛇固无足，子安能为之"},"example":{"text":"《隋书·杨素传论》：“～，终倾国本。”"},"similar":["为蛇添足","画蛇添足"],"usage":"作谓语、定语、宾语；用于处事","story":["楚国有个专管祭祀的官员，春祭以后倒一杯酒给手下人，因人多酒少不够分，就想出谁先画好蛇就喝酒的办法，有一个人第一个把蛇画好了，见其他人还没有画完，就在已画好的蛇上加了两只脚，让人啼笑皆非"]},{"id":3656,"word":"为裘为箕","pinyin":"wéi qiú wéi jī","abbr":"wqwj","explanation":"用以比喻子弟能继承父兄的事业。","source":{"text":"良治之子，必学为裘，良弓之子，必学为箕。","book":"西汉·戴圣《礼记·学记》"},"example":{"text":"亦有良嗣，～，公无憾哉！","book":"明·李东阳《董公墓志铭》"},"usage":"作谓语；指子弟克承家业"},{"id":3657,"word":"为非作恶","pinyin":"wéi fēi zuò è","abbr":"wfze","explanation":"做种种坏事。同“为非作歹”。","source":{"text":"骇得他们胆小葸葸地不敢为非作恶。","book":"洪深《青龙潭》第三幕"},"example":{"text":"洪深《青龙潭》第三幕：“骇得他们胆小葸葸地不敢～。”"},"similar":["为非作歹","生非作歹"],"usage":"作谓语、定语；指做种种坏事"},{"id":3658,"word":"为非作歹","pinyin":"wéi fēi zuò dǎi","abbr":"wfzd","explanation":"做种种坏事。","source":{"text":"我且拿起来，只一口将他吞于腹中，看道可还有本事为非作歹。","book":"元·尚仲贤《柳毅传书》"},"example":{"text":"我说的是好话，不过叫你心里留神，并没叫你去～。","book":"清·曹雪芹《红楼梦》第五十七回"},"similar":["为所欲为","为鬼为蜮","为非作恶"],"opposite":["安分守己","循规蹈矩"],"usage":"作谓语、定语；指做种种坏事"},{"id":3659,"word":"为鬼为蜮","pinyin":"wéi guǐ wéi yù","abbr":"wgwy","explanation":"蜮：传说中能含沙喷射人影，而使人致病的动物，比喻阴险毒辣的人。指象鬼蜮一样阴险狠毒，在暗地里害人的人。","source":{"text":"为鬼为蜮，则不可得。","book":"《诗经·小雅·何人斯》"},"example":{"text":"他那里肯依，说甚么皇上家抡才（选拔人才）大典，怎容得你们～！","book":"清·吴趼人《二十年目睹之怪现状》第四十二回"},"similar":["为鬼为魅"],"usage":"作谓语、定语；指暗中害人"},{"id":3660,"word":"为鬼为魅","pinyin":"wéi guǐ wéi mèi","abbr":"wgwm","explanation":"为：作为；魅：传说中的鬼怪。指象鬼魅一样阴险狠毒，在暗地里害人的人。","source":{"text":"为鬼为蜮，则不可得。","book":"《诗经·小雅·何人斯》"},"example":{"text":"若人渐浇诡，不复返朴，今当～，尚安得而化哉！","book":"《新唐书·魏征传》"},"similar":["为鬼为蜮"],"usage":"作谓语、定语；指暗中害人"},{"id":3661,"word":"主一无适","pinyin":"zhǔ yī wú shì","abbr":"zyws","explanation":"专一，无杂念。","source":{"text":"敬者主一无适之谓。","book":"《二程·粹言》卷上：“或问敬子曰：‘主一之谓敬。何谓一？’子曰：‘无适之谓一。’”《论语·学而》“敬事而信”宋·朱熹集注"},"example":{"text":"梁启超《说常识》：“一国之中，但能有少数仁人君子，挟～之诚，行百折不回之气，以日夜与恶社会为不断之争斗。”"},"usage":"作定语；用于书面语"},{"id":3662,"word":"主人翁","pinyin":"zhǔ rén wēng","abbr":"zrw","explanation":"当家作主的人。","source":{"text":"我们热诚地希望各民主党派和工商联都以主人翁的态度，关心国家大事。","book":"邓小平《各民主党派和工商联是为社会主义服务的政治力量》"},"example":{"text":"路遥《平凡的世界》第五卷第37章：“因此，很多人对煤矿没什么～感。”"},"usage":"作宾语、定语；用于个人与集体"},{"id":3663,"word":"主圣臣直","pinyin":"zhǔ shèng chén zhí","abbr":"zscz","explanation":"君主圣明，臣子忠诚。比喻上行下效。","source":{"text":"臣闻主圣臣直。乘船危，就桥安，圣主不乘危。御史大夫言可听。","book":"《汉书·薛广德传》"},"example":{"text":"臣闻～。今既遇圣主，辄为直臣，上答殊私，下塞群谤，誓除国蠹，无以家为。（《旧唐书·裴度传》）"},"similar":["主贤臣良","主明臣直"],"usage":"作宾语、定语；用于书面语"},{"id":3664,"word":"主圣臣良","pinyin":"zhǔ shèng chén liáng","abbr":"zscl","explanation":"君主圣明，臣下忠良。比喻上行下效。亦作“主明臣直”、“主圣臣直”、“主贤臣良”。","source":{"text":"况主圣臣良，兵强国富，陈既主昏于上，人讟于下，险无百二之固，众非九国之师，独此岛夷，而稽天讨！","book":"《北史·仲方传》"},"similar":["主贤臣良","主明臣直"],"usage":"作宾语、定语；用于书面语"},{"id":3665,"word":"主守自盗","pinyin":"zhǔ shǒu zì dào","abbr":"zszd","explanation":"窃取公务上自己看管的财物。","source":{"text":"即今律所谓主守自盗者也。","book":"《汉书·刑法志》：“守县官财物而即盗之。已论命复有笞罪者，皆弃市。”颜师古注"},"similar":["监守自盗"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":3666,"word":"主客颠倒","pinyin":"zhǔ kè diān dǎo","abbr":"zkdd","explanation":"比喻事物轻重大小颠倒了位置。","source":{"text":"由此，从文有了一个固定的职业，有月薪可以应付生活。但这样一来，写作却成为他的业余事务，在他的精神生活上，有些主客颠倒。","book":"施蛰存《滇云浦雨话从文》"},"example":{"text":"你这样做是～。"},"similar":["主次不分"],"usage":"作宾语、定语；指颠倒了位置"},{"id":3667,"word":"主少国疑","pinyin":"zhǔ shǎo guó yí","abbr":"zsgy","explanation":"君主年幼初立，人心疑惧不安。","source":{"text":"主少国疑，大臣未附，百姓不信，方是之时，属之于子乎？属之于我乎？","book":"《史记·孙子吴起列传》"},"example":{"text":"疆场骚动，～，不乘此时出师却贼，如何安定社稷？","book":"蔡东藩《后汉演义》第九十六回"},"usage":"作宾语、定语；用于书面语"},{"id":3668,"word":"主心骨","pinyin":"zhǔ xīn gǔ","abbr":"zxg","explanation":"可以倚仗、做为凭借或起核心作用的人或事物。也指主见，主意。","source":{"text":"在民盟中央，别看沈老（钧儒）的地位最高，是旗帜性人物，可他才是民盟的主心骨。","book":"章诒和《往事并不如烟·正在有情无思间》"},"example":{"text":"他是我们单位里的～。"},"similar":["顶梁柱"],"usage":"作宾语、定语；用于口语"},{"id":3669,"word":"主忧臣劳","pinyin":"zhǔ yōu chén láo","abbr":"zycl","explanation":"君主有忧虑，作臣子的要立即效劳。","source":{"text":"臣闻主忧臣劳，主辱臣死。昔者君王辱于会稽，所以不死，为此事也。今既以雪耻，臣请从会稽之诛。","book":"《国语·越语下》：“为人臣者，君忧臣劳，君辱臣死。”《史记·越王勾践世家》"},"example":{"text":"～，孰不祗懔。（晋·潘岳《关中诗十六首》其八）"},"usage":"作宾语、定语；用于书面语"},{"id":3670,"word":"主忧臣辱","pinyin":"zhǔ yōu chén rǔ","abbr":"zycr","explanation":"君主有忧患是作臣子的耻辱。","source":{"text":"臣窃念主忧臣辱，义不得辞，跼蹐受命，退而差辟官吏、条列事目、调遣将士，凡所以为速发之计者，靡微不周。","book":"宋·魏了翁《辞免督视军马乞以参赞军事从丞相行奏札》"},"example":{"text":"清·侯方域《为司徒公与宁南侯书》：“固以～，金革之义，不敢控辞；亦缘与将军知契素深，相须如左右手，倘得凭先声。”"},"usage":"作宾语、定语；用于书面语"},{"id":3671,"word":"主情造意","pinyin":"zhǔ qíng zào yì","abbr":"zqzy","explanation":"主、造：谋划。提出主张，出谋划策。也指为首的、主谋的人。","source":{"text":"正末云：‘谁主情造意来？’李文道云：‘是俺父亲来。’","book":"元·孟汉卿《魔合罗》第四折"},"example":{"text":"把白胜押到厅前，便将索子捆了，问他～。","book":"明·施耐庵《水浒全传》第十八回"},"similar":["出谋划策"],"usage":"作谓语、宾语；指主谋的人"},{"id":3672,"word":"主敬存诚","pinyin":"zhǔ jìng cún chéng","abbr":"zjcc","explanation":"指恪守诚敬。宋儒以此为律身之本。","source":{"text":"宾客主敬，祭祀主敬。","book":"语本《易·乾》：“闲邪存其诚。”《礼记·少仪》"},"example":{"text":"古之圣贤，戒慎恐惧，～，默察乎天命民彝之本。","book":"清·王鼎《朱子原订近思录序》"},"usage":"作宾语、定语；用于书面语"},{"id":3673,"word":"主文谲谏","pinyin":"zhǔ wén jué jiàn","abbr":"zwjj","explanation":"主文：用譬喻来规劝；谲谏：委婉讽刺。通过诗歌的形式，用譬喻的手法进行讽谏。","source":{"text":"主文而谲谏，言之者无罪，闻之者足以戒。","book":"《诗序》"},"example":{"text":"突兀长篇赋荔支，～起人思。","book":"清·钱谦益《宋比玉过访虞山》"},"opposite":["犯言直谏"],"usage":"作主语、宾语、定语；指婉言规劝"},{"id":3674,"word":"主明臣直","pinyin":"zhǔ míng chén zhí","abbr":"zmcz","explanation":"君主圣明，臣子忠诚。比喻上行下效。","source":{"text":"天下有道，主明臣直；虽休勿休，永贻世则。","book":"《北史·张晏之传》"},"example":{"text":"妾闻～，今朝有直臣魏征，就是陛下的圣明呢。（蔡东藩《唐史演义》第十八回）"},"similar":["主圣臣直","主贤臣良"],"usage":"作宾语、定语；用于书面语"},{"id":3675,"word":"主次不分","pinyin":"zhǔ cì bù fēn","abbr":"zcbf","explanation":"作谓语、定语；用于人处事。","example":{"text":"这篇文章观点～。"},"similar":["不分主次"],"usage":"作谓语、定语；用于人处事"},{"id":3676,"word":"主观主义","pinyin":"zhǔ guān zhǔ yì","abbr":"zgzy","explanation":"由脑子或感官感觉内部的条件而引起而不去根据客观情况加以分析的处事方法。","source":{"text":"第一种：主观主义的态度。","book":"毛泽东《改造我们的学习》"},"example":{"text":"章诒和《往事并不如烟·正在有情无思间》：“其实应教育的不是无辜被告而正是～的审判人员自己。”"},"opposite":["客观主义"],"usage":"作主语、宾语、定语；用于处世"},{"id":3677,"word":"主观臆断","pinyin":"zhǔ guān yì duàn","abbr":"zgyd","explanation":"臆断：凭臆想进行判断。不依旧客观实际情况，只凭主观对事物做出判断。","example":{"text":"凭个人的～是行不通的。"},"similar":["主观主义"],"usage":"作主语、宾语、定语；指凭空想象"},{"id":3678,"word":"主贤臣良","pinyin":"zhǔ xián chén liáng","abbr":"zxcl","explanation":"君主圣明，臣子忠诚。比喻上行下效。","source":{"text":"臣闻主圣臣直。乘船危，就桥安，圣主不乘危。御史大夫言可听。","book":"《汉书·薛广德传》"},"similar":["主明臣直","主圣臣直"],"usage":"作宾语、定语；用于书面语"},{"id":3679,"word":"主辱臣死","pinyin":"zhǔ rǔ chén sǐ","abbr":"zrcs","explanation":"主：君主。君主蒙受耻辱时，作臣子的就应当效忠而死。指以死报效君王。","source":{"text":"臣闻主忧臣劳，主辱臣死。昔者君王辱于会稽，所以不死，为此事也。今既以雪耻，臣请从会稽之诛。","book":"《国语·越语下》：“为人臣者，君忧臣劳，君辱臣死。”《史记·越王勾践世家》"},"example":{"text":"主忧臣辱，～，敢怀二心乎？（明·罗贯中《三国演义》第一百十四回）"},"usage":"作宾语、定语；用于书面语"},{"id":3680,"word":"丽句清词","pinyin":"lì jù qīng cí","abbr":"ljqc","explanation":"华丽清新的辞句。","source":{"text":"不薄今人爱古人，清词丽句必为邻。","book":"《宋书·谢灵运传论》：“虽清辞丽曲，时发乎篇，而芜音累气，固亦多矣。”唐·杜甫《戏为六绝句》之五"},"example":{"text":"～三分宿慧，花香灯影一片艳情。","book":"清·魏子安《花月痕》第三十三回"}},{"id":3681,"word":"丽句清辞","pinyin":"lì jù qīng cí","abbr":"ljqc","explanation":"华丽清新的辞句。同“丽句清词”。"},{"id":3682,"word":"丽藻春葩","pinyin":"lì zǎo chūn pā","abbr":"lzcp","explanation":"比喻美妙的言谈。","source":{"text":"李白与人谈论，皆成句读，如春葩丽藻，粲于齿牙，时号李白粲花之论。","book":"唐·冯贽《云仙杂记·粲花》"},"example":{"text":"也便烧得他那幻象底轮子急转，转出了满牙齿上攒着的‘～’。","book":"闻一多《红烛·李白之死》"},"usage":"作宾语；比喻美妙的言谈"},{"id":3683,"word":"举一反三","pinyin":"jǔ yī fǎn sān","abbr":"jyfs","explanation":"反：类推。比喻从一件事情类推而知道其他许多事情。","source":{"text":"举一隅不以三隅反，则不复也。","book":"《论语·述而》"},"example":{"text":"我是凭着一卷《诗韵》学说话，倒可以有“～”的效验。","book":"清·吴趼人《二十年目睹之怪现状》第三十四回"},"similar":["融会贯通","触类旁通"],"opposite":["囫囵吞枣","不求甚解","浅尝辄止"],"usage":"作谓语、定语、状语；指学习等","story":["春秋时期，孔子到齐国去向齐景公推销他的“仁政”，齐景公有些心动，准备划出一块地来让他治理。他去拜访齐国三朝元老相国晏婴，他对晏婴事三君不解，晏婴一心事三君，孔子只知举一反三，不知举三反一，结果得罪了晏婴，仁政没推销出去"]},{"id":3684,"word":"举一废百","pinyin":"jǔ yī fèi bǎi","abbr":"jyfb","explanation":"举：提出；废：弃。提出一点，废弃许多。指认识片面。","source":{"text":"所恶执一者，为其贼道也，举一百废百也。","book":"战国·邹·孟轲《孟子·尽心上》"},"example":{"text":"其如～，当从者寡，当违者众。","book":"清·李渔《闲情偶寄·词曲·音律》"},"similar":["挂一漏万","举措失当"],"usage":"作谓语；指举措失当"},{"id":3685,"word":"举不胜举","pinyin":"jǔ bù shèng jǔ","abbr":"jbsj","explanation":"胜：尽。列举也列举不完。形容数量很多。","source":{"text":"公开告密，卖友求荣，卖身投靠的勾当，举不胜举。","book":"鲁迅《伪自由书·后记》引谷春帆《谈“文人先行”》"},"example":{"text":"他的先进事迹～。"},"similar":["不胜枚举","数不胜数","不计其数"],"opposite":["寥寥无几","屈指可数"],"usage":"作谓语、定语；形容很多"},{"id":3686,"word":"举世无伦","pinyin":"jǔ shì wú lún","abbr":"jswl","explanation":"伦：伦比，类比。人世间没有可以没有可以类比的。形容稀有少见。","source":{"text":"协律郎萧悦善画竹，举世无伦。","book":"唐·白居易《画竹歌序》"},"similar":["举世莫比","举世无比"],"usage":"作谓语、定语；用于人或事物等"},{"id":3687,"word":"举世无双","pinyin":"jǔ shì wú shuāng","abbr":"jsws","explanation":"全世界找不到第二个。","source":{"text":"好学乐道之效明白甚矣，自以为智能海内无双，则可谓博闻。","book":"汉·东方朔《答客难一首》"},"example":{"text":"他说善于玩把戏，空前绝后，～，人们从来就没有看见过；一见之后，便即解烦释闷，天下太平。","book":"鲁迅《故事新编·铸剑》"},"similar":["盖世无敌","独一无二"],"opposite":["无独有偶"],"usage":"作谓语、定语；指罕见","story":["秦朝末年，韩信因得不到项羽的重用，而改投刘邦，开始也没有得到重用，因滕公的推荐给萧何，萧何认为他是一个不可多得的人才推荐给刘邦。刘邦敷衍应付，韩信不辞而别，萧何月下追回韩信，对刘邦说他是举世无双，刘邦拜他为大将"]},{"id":3688,"word":"举世无敌","pinyin":"jǔ shì wú dí","abbr":"jswd","explanation":"世界上没有能胜得过的。","source":{"text":"他们认为是‘异常强大’的，‘举世无敌’的。","book":"毛泽东《目前形势和我们的任务》"},"example":{"text":"我们团结一致就能做到～。"},"similar":["举世无比","举世无双","无往不胜"],"opposite":["一触即溃","不堪一击"],"usage":"作谓语、宾语、定语；指世界上没有能胜得过"},{"id":3689,"word":"举世无比","pinyin":"jǔ shì wú bǐ","abbr":"jswb","explanation":"人世间没有可以没有可以相比的。形容稀有少见。","source":{"text":"萧颖士，开元中，年十九，擢进士第，儒释道三教无不该通，然性偏躁，忽忿戾，举世无比。","book":"宋·钱易《南部新书》卷庚"},"similar":["举世莫比","举世无伦"],"usage":"作谓语、定语；用于人或事物等"},{"id":3690,"word":"举世混浊","pinyin":"jǔ shì hún zhuó","abbr":"jshz","explanation":"举：全；混浊：不清明。世上所有的人都不清不白。比喻世道昏暗。","source":{"text":"世混浊而不分兮。","book":"战国·楚·屈原《离骚》"},"example":{"text":"～，清士乃见。","book":"《史记·伯夷列传》"},"usage":"作定语；指世道昏暗"},{"id":3691,"word":"举世皆知","pinyin":"jǔ shì jiē zhī","abbr":"jsjz","explanation":"举：全；皆：都。全世界的人都知道。","source":{"text":"王逸少风流才士，萧散名人。举世但知其书，翻以能自蔽也。","book":"北齐·颜之推《颜氏家训·杂艺》"},"similar":["举世闻名"],"usage":"作谓语、宾语、定语；指非常著名"},{"id":3692,"word":"举世瞩目","pinyin":"jǔ shì zhǔ mù","abbr":"jszm","explanation":"全世界的人都注视着。","source":{"text":"则恐国人这瞩目于我也。","book":"战国·楚·屈原《渔夫》：“举世皆浊我独清。”春秋·鲁·左丘明《国语·晋语》"},"example":{"text":"中国的改革是～的大事。"},"similar":["引人注目","举世闻名","名震中外"],"opposite":["默默无闻"],"usage":"作谓语、宾语、定语；指全世界的人都注视着"},{"id":3693,"word":"举世莫比","pinyin":"jǔ shì mò bǐ","abbr":"jsmb","explanation":"人世间没有可以没有可以相比的。形容稀有少见。","source":{"text":"朱敬则，亳州永城人也，孝行忠鲠，举世莫比，门表阙台是六所，今古无之。","book":"宋·钱易《南部新书》卷乙"},"similar":["举世无比","举世无伦"],"usage":"作谓语、定语；用于人或事物等"},{"id":3694,"word":"举世闻名","pinyin":"jǔ shì wén míng","abbr":"jswm","explanation":"举世：全世界。全世界都知道。形容非常著名。","source":{"text":"王逸少风流才士，萧散名人。举世但知其书，翻以能自蔽也。","book":"北齐·颜之推《颜氏家训·杂艺》"},"example":{"text":"中国的象牙雕刻是杰出的，北京的山水人物和广州的花卉动物牙雕，尤其～。","book":"秦牧《高高翘起的象鼻子》"},"similar":["遐迩闻名","誉满天下"],"opposite":["默默无闻"],"usage":"作谓语、宾语、定语；指非常著名"},{"id":3695,"word":"举仇举子","pinyin":"jǔ chóu jǔ zǐ","abbr":"jcjz","explanation":"举：推荐；仇：仇敌；子：儿子。既推荐仇敌，也推荐儿子。形容办事公正。","source":{"text":"祁奚请老，晋侯问嗣焉，称解狐，其仇也。将立而卒。又问焉，对曰：‘午可也。’于是使祁午为中军尉。","book":"春秋·鲁·左丘明《左传·襄公三年》"},"example":{"text":"及道之衰，上下交疑，于是乎～之事，载之传中而称美之，而谓之忠。","book":"唐·韩愈《送齐滜下第序》"},"opposite":["任人唯亲"],"usage":"作宾语、定语；用于处事","story":["春秋时期，晋国贵族之间权力斗争十分激烈，范宣子赶跑了他的外孙栾盈，并杀了他的同党羊舌虎。大夫祁奚向晋侯请求告老还乡，晋侯问他谁可以接任，他推荐了他的仇敌解狐。晋侯问谁可以担任中军尉，祁奚推荐了自己的儿子祁午"]},{"id":3696,"word":"举例发凡","pinyin":"jǔ lì fā fán","abbr":"jlff","explanation":"发凡：揭示全书的通例。指分类举例，说明全书的体例。","source":{"text":"其发凡以言例，皆经国之常制。","book":"晋·杜预《春秋左氏传序》"},"example":{"text":"按《春秋》经传，～。","book":"南朝·梁·刘勰《文心雕龙·史传》"},"similar":["发凡举例"],"usage":"作宾语；指举例以阐明要点"},{"id":3697,"word":"举偏补弊","pinyin":"jǔ piān bǔ bì","abbr":"jpbb","explanation":"弊：弊端，毛病。指出偏差疏漏，补救缺点错误。","source":{"text":"举偏而补弊，盖自舜之命夔已如此。","book":"宋·朱熹《朱子语类·论语》"},"example":{"text":"凡事只举偏补弊，防微杜渐，销患于冥冥，若待显著而后治之，则难矣。","book":"清·毕沅《续资治通鉴》卷一百四十七"}},{"id":3698,"word":"举前曳踵","pinyin":"jǔ qián yè zhǒng","abbr":"jqyz","explanation":"曳：拖；踵：脚后跟。拖着脚后跟向前迈步。形容谨慎小心，缩手缩脚的样子。","source":{"text":"执龟玉，举前曳踵，蹜蹜如也。","book":"《礼记·玉藻》"},"example":{"text":"如有循，记所谓～。","book":"宋·朱熹《论语集注》卷五"}},{"id":3699,"word":"举动荆棘","pinyin":"ju dong jin ji","abbr":"jdjj","explanation":"一举一动，就象在刺树林里一样，比喻不能随意，事事都遭威胁。"},{"id":3700,"word":"举十知九","pinyin":"jǔ shí zhī jiǔ","abbr":"jszj","explanation":"列举出的十件事情中，通晓的就有九件。比喻学识渊博。","source":{"text":"圣人之所志，闻一而反三；君子之所能，举十而知九。","book":"唐·张说《唐故豫州刺史魏君神道碑》"},"example":{"text":"德才兼备，～的教师，在学生中间自然有一种崇高的威望。"},"usage":"作谓语、定语；指人的学识"},{"id":3701,"word":"举善荐贤","pinyin":"jǔ shàn jiàn xián","abbr":"jsjx","explanation":"贤：有才能，有道德的。保举推荐品德好、有才能的人。","source":{"text":"他被窝儿里献利便，枕头上纳陈言。义子贼臣掌重权。那里肯举善荐贤，他当家儿自迁转。","book":"元·王伯成《李太白贬夜郎》第四折"},"example":{"text":"～，乃美事也；卿何荐人于朝，即自焚其奏稿，不令人知耶？","book":"明·罗贯中《三国演义》第一百二十回"},"similar":["举贤荐能"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":3702,"word":"举国一致","pinyin":"jǔ guó yī zhì","abbr":"jgyz","explanation":"全国上下，团结一致。","source":{"text":"所有问题的中心点还是中国全体人民团结起来，树立举国一致的抗日阵线。","book":"毛泽东《论持久战》"},"example":{"text":"我们要力争～抗击“非典”"},"similar":["上下一致"],"usage":"作宾语、定语；指全国一致"},{"id":3703,"word":"举国上下","pinyin":"jǔ guó shàng xià","abbr":"jgsx","explanation":"举：全。指全国上上下下的人。","source":{"text":"苟且偷惰，习焉成风，举国上下，颓然以暮气充塞之。","book":"梁启超《管子传》第六章第一节"},"example":{"text":"奥运会上中国运动健儿喜获金牌，～欢腾一遍。"},"similar":["举国一致","朝野上下"],"usage":"作主语、宾语、定语；指全国上上下下的人"},{"id":3704,"word":"举国若狂","pinyin":"jǔ guó ruò kuáng","abbr":"jgrk","explanation":"举：全；狂：狂欢。全国的人都激动得像发狂一样。","source":{"text":"子贡观于蜡。孔子曰：‘赐也乐乎？’对曰：‘一国之人皆若狂，赐未知其乐也。’","book":"《礼记·杂记下》"},"example":{"text":"为甚一纸招贴，便～如此？","book":"清·刘鹗《老残游记》第二回"},"similar":["纵情欢乐"],"usage":"作谓语；表示极高兴"},{"id":3705,"word":"举大略细","pinyin":"jǔ dà lüè xì","abbr":"jdlx","explanation":"提出重大的，舍弃细小的。指不拘泥于细微末节，善于抓重大问题。形容人有气魄，有胆识。","source":{"text":"明者举大略细，不忮不求。","book":"《抱朴子·接疏》"}},{"id":3706,"word":"举如鸿毛，取如拾遗","pinyin":"jǔ rú hóng máo，qǔ rú shí yí","abbr":"jrhmqrsy","explanation":"举一根羽毛，拾一件东西。比喻事情容易做，不费气力。","source":{"text":"举秦如鸿毛，拾楚若拾遗。","book":"《汉书·梅福传》"},"usage":"作宾语、定语；用于比喻句"},{"id":3707,"word":"举手之劳","pinyin":"jǔ shǒu zhī láo","abbr":"jszl","explanation":"一举手那样的辛劳。形容轻而易举，毫不费力。","source":{"text":"唐·韩愈《应科目时与人书》： “如有力者，哀其穷而运转之，盖一举手一投足之劳也。”"},"example":{"text":"做好这件事对我们来说是～的事。"},"similar":["易如反掌","轻而易举"],"opposite":["难于登天"],"usage":"作宾语；比喻事情轻而易举"},{"id":3708,"word":"举手加额","pinyin":"jǔ shǒu jiā é","abbr":"jsje","explanation":"拱手与额相齐，是古人表示欢庆的意思。","source":{"text":"斯言一出，十邑之民，以手加额，家传人诵。","book":"宋·杨万里《章贡道院记》"},"example":{"text":"张员外看罢，～道：“郑家果然发迹变泰，又不忘故旧，远送礼物，真乃有德有行之人也。”","book":"明·冯梦龙《醒世恒言》卷三十一"},"similar":["额首相庆","举首加额"],"usage":"作谓语；表示喜悦庆幸"},{"id":3709,"word":"举手可采","pinyin":"jǔ shǒu kě cǎi","abbr":"jskc","explanation":"一举手就可拿到。比喻极易取得。","source":{"text":"潜虽学不沾洽，然卓荦强识，祖宗制度之仪，丧纪五服之数，皆指掌画地，举手可采。","book":"《三国志·蜀志·许慈传》"},"similar":["唾手可得"],"opposite":["大海捞针"],"usage":"作谓语、定语；指容易得到"},{"id":3710,"word":"举手扣额","pinyin":"jǔ shǒu kòu é","abbr":"jske","explanation":"举手拍额，表示庆幸。","source":{"text":"秦氏建康永宁庄有牧童桀横，常骑巨牛纵食人禾麦。民泣请不悛，但时举手扣额，訢于天地。","book":"宋·洪迈《夷坚丁志·永宁庄牛》"},"usage":"作谓语、定语；用于书面语"},{"id":3711,"word":"举手投足","pinyin":"jǔ shǒu tóu zú","abbr":"jstz","explanation":"一抬手，一动脚。形容轻而易举，毫不费力。","source":{"text":"唐·韩愈《应科目时与人书》： “如有力者，哀其穷而运转之，盖一举手一投足之劳也。”"},"example":{"text":"给老幼妇孺让座是～的事情。"},"similar":["轻而易举","易如反掌","一举一动"],"opposite":["难于登天","九牛二虎之力"],"usage":"作主语、谓语、定语；形容轻而易举"},{"id":3712,"word":"举手摇足","pinyin":"jǔ shǒu yáo zú","abbr":"jsyz","explanation":"摇足：晃脚。举举手，晃晃脚。比喻时间短促。","source":{"text":"若军兴之际，赏罚注措，一举手摇足之间，而死生存亡于是焉系。","book":"明·归有光《送太仓守熊侯之任光州序》"}},{"id":3713,"word":"举手相庆","pinyin":"jǔ shǒu xiāng qìng","abbr":"jsxq","explanation":"指举手加额，以相庆贺。","source":{"text":"群臣莫不欣择，百姓莫不蹈舞，举手相庆。","book":"明·刘基《甘露颂》序"},"similar":["举手加额"],"usage":"作谓语；指互相庆贺"},{"id":3714,"word":"举措不定","pinyin":"jǔ cuò bù dìng","abbr":"jcbd","explanation":"举措：行动。拿着棋子，不知该如何下。比喻犹豫不决。","example":{"text":"我被他搞得～了。"},"similar":["举棋不定","犹豫不决"],"opposite":["当机立断"],"usage":"作谓语、宾语、定语、状语；指犹豫不决"},{"id":3715,"word":"举措不当","pinyin":"jǔ cuò bù dàng","abbr":"jcbd","explanation":"举措：举动，措置。指行动措施不得当。","source":{"text":"举措不当，众民不能成。","book":"《管子·禁藏》"},"example":{"text":"倘若说他～，劝谏几句，他便要大发脾气，罢官的罢官，放逐的放逐。","book":"金庸《天龙余部》第四十九章"}},{"id":3716,"word":"举措失当","pinyin":"jǔ cuò shī dàng","abbr":"jcsd","explanation":"举措：举动，措置。指行动措施不得当。","source":{"text":"举措不当，众民不能成。","book":"《管子·禁藏》"},"example":{"text":"敌军调动忙乱，～，两队优劣之势，也就不同于前了。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["事倍功半","南辕北辙"],"opposite":["恰如其分"],"usage":"作谓语、宾语、定语；指举动措施不得当","story":["公元前221年，秦始皇灭掉六国后建立一个大一统的中央集权的国家。他经常到全国各地巡游，祭祀大河山，命人将他的言语刻在石头上，增加他的威望，而百姓生活在水深火热中。秦始皇却还一味吹嘘他的“举措必当，莫不如画”的功绩"]},{"id":3717,"word":"举措必当","pinyin":"jǔ cuò bì dàng","abbr":"jcbd","explanation":"举措：举动，措置；当：适合，合宜。指行动措施完全得当。","source":{"text":"举措必当，莫不如画。","book":"西汉·司马迁《史记·秦始皇本纪》"},"opposite":["举措失当"],"usage":"作谓语、宾语；指行动措施完全得当"},{"id":3718,"word":"举措有适","pinyin":"jǔ cuò yǒu shì","abbr":"jcys","explanation":"指措施或举动得体、适当。","source":{"text":"吾与子伯素不相若，向见其子容服甚光，举措有适，而我儿曹蓬发历齿，未知礼则。","book":"《后汉书·列女传》"}},{"id":3719,"word":"举无遗策","pinyin":"jǔ wú yí cè","abbr":"jwyc","explanation":"举：提出；策：计谋、办法。提出的计谋没有失算的。形容足智多谋。","source":{"text":"万举而无遗策矣。","book":"《淮南子·主术训》"},"example":{"text":"盖～，而天下皆知其不可当也。","book":"宋·陈亮《邓禹》"},"similar":["足智多谋","举无遗算"],"usage":"作谓语、宾语；指足智多谋"},{"id":3720,"word":"举无遗算","pinyin":"jǔ wú yí suàn","abbr":"jwys","explanation":"举：提出；算：谋算、办法。提出的计谋没有失算的。形容足智多谋。","source":{"text":"万举而无遗策矣。","book":"《淮南子·主术训》"},"example":{"text":"智者了于胸心，然后～耳。","book":"《晋书·袁環传》"},"similar":["举无遗策"],"usage":"作谓语、宾语；指足智多谋"},{"id":3721,"word":"举枉措直","pinyin":"jǔ wǎng cuò zhí","abbr":"jwcz","explanation":"举：选拔，任用；枉：弯曲，比喻邪恶的人；错：废置，罢黜；直：笔直，比喻正直的人。起用奸邪者而罢黜正直者。","source":{"text":"举枉错诸枉，则民服；举枉错诸直，则民不服。","book":"《论语·为政》"},"example":{"text":"可不道～民不服。","book":"元·无名氏《赚蒯通》第一折"},"usage":"作谓语；指起用奸邪者而罢黜正直者"},{"id":3722,"word":"举案齐眉","pinyin":"jǔ àn qí méi","abbr":"jaqm","explanation":"案：古时有脚的托盘。送饭时把托盘举得跟眉毛一样高。后形容夫妻互相尊敬。","source":{"text":"为人赁舂，每归，妻为具食，不敢于鸿前仰视，举案齐眉。","book":"《后汉书·梁鸿传》"},"example":{"text":"次日，蘧公孙上厅谢亲，设席饮酒。席终，归到新房里，重新摆酒，夫妻～。","book":"清·吴敬梓《儒林外史》第十回"},"similar":["心心相印","相敬如宾","夫唱妇随"],"opposite":["琴瑟不调"],"usage":"作谓语、宾语、定语；用于书面语","story":["东汉书生梁鸿读完太学回家务农，与县上孟财主的30岁女儿孟光结婚，婚后他们抛弃孟家的富裕生活，到霸陵山区隐居，后来帮皋伯通打短工。每次孟光给梁鸿送饭时把托盘举得跟眉毛一样高，眉来眼去，夫妻十分恩爱"]},{"id":3723,"word":"举棋不定","pinyin":"jǔ qí bù dìng","abbr":"jqbd","explanation":"拿着棋子，不知下哪一着才好。比喻犹豫不决，拿不定主意。","source":{"text":"弈者举棋不定，不胜其藕。","book":"《左传·襄公二十五年》"},"example":{"text":"对于“逃匿”震南村中，拒不从命的小小的胡杏，他们却是～。","book":"欧阳山《苦斗》七十八"},"similar":["犹豫不决","优柔寡断"],"opposite":["斩钉截铁","当机立断"],"usage":"作谓语、宾语、定语；指犹豫不决","story":["春秋时期，卫国人宁殖将国君卫献公驱逐，另立公孙剽为国君。临终前嘱咐儿子宁喜去齐国接回卫献公。宁喜去看望了卫献公表示愿意帮他回国。大夫大叔仪事后对宁喜说：“你这样举棋不定会招致大祸的。”卫献公回国后就杀了宁喜"]},{"id":3724,"word":"举棋若定","pinyin":"jǔ qí ruò dìng","abbr":"jqrd","explanation":"下棋子好像有预断。比喻行事沉着果断。","source":{"text":"战事从来似弈棋，举棋若定自无悲。","book":"朱德《十月战景》诗"},"similar":["胸有成竹"],"opposite":["举棋不定"],"usage":"作谓语、定语；指人沉着"},{"id":3725,"word":"举止不凡","pinyin":"jǔ zhǐ bù fán","abbr":"jzbf","explanation":"举动不平凡。形容人的行为动作非同一般，与众不同。","source":{"text":"昨见二君举止不凡，询及栈主，始知兄即吴江卞某，此弟生平最敬佩的人，敢问此位名姓？","book":"清·壮者《扫迷帚》第五回"},"example":{"text":"太子见那女子～，吩咐内侍不许罗唣。","book":"清·禇人获《隋唐演义》第七十八回"},"similar":["风度翩翩"],"usage":"作谓语；指人的举止行为"},{"id":3726,"word":"举止大方","pinyin":"jǔ zhǐ dà fāng","abbr":"jzdf","explanation":"举动不俗气，不做作。形容人行为动作不拘束，堂堂正正。","source":{"text":"若是正经的女子，见了人一样，不见人也是一样，举止大方，不轻言笑的，那怕他在街上走路，又碍甚么呢？","book":"清·吴趼人《二十年目睹之怪现状》第21回"},"example":{"text":"他～，风度翩翩。"},"similar":["举止不凡"],"opposite":["举止失措"],"usage":"作谓语、定语；指人的行为"},{"id":3727,"word":"举止失措","pinyin":"jǔ zhǐ shī cuò","abbr":"jzsc","explanation":"措：安放，放置。举动失常，不知如何办才好。","source":{"text":"材上加契者，谓之足材，其规矩制度，皆以章契为祖。今人以举止失措者，谓之失章失契，盖谓此也。","book":"宋·庄季裕《鸡肋编》卷下"},"example":{"text":"周瑜～，急拨马便走，云长赶来，周瑜纵马逃命。","book":"明·罗贯中《三国演义》第五十五回"},"similar":["手足无措"],"opposite":["举止大方"],"usage":"作谓语、状语；指人慌乱"},{"id":3728,"word":"举止娴雅","pinyin":"jǔ zhǐ xián yǎ","abbr":"jzxy","explanation":"娴：文雅。形容女子的姿态和风度娴静文雅。","source":{"text":"还有一女，比薛蟠小两岁，乳名宝钗，生得肌骨莹润，举止娴雅。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"所以窦氏不仅容貌出众，而且～，温柔大方，美而不媚。","book":"姚雪垠《李自成》第四卷第十六章"},"usage":"作谓语、定语；用于女性"},{"id":3729,"word":"举止自若","pinyin":"jǔ zhǐ zì ruò","abbr":"jzzr","explanation":"自若：象原来的样子。举动不失常态。形容临事镇定，举动不失常态。","source":{"text":"孝恭将发，与诸将宴集，命取水，忽变为血，在坐皆失色，孝恭举止自若。","book":"宋·司马光《资治通鉴·唐高祖武德六年》"},"example":{"text":"遇到很大的变故他都能～。"},"similar":["举止自如","镇定自若"],"opposite":["惊慌失措"],"usage":"作谓语；指人处事镇静"},{"id":3730,"word":"举止言谈","pinyin":"jǔ zhǐ yán tán","abbr":"jzyt","explanation":"行为举动和说话言论。指人的外在风度。","source":{"text":"山东之人，叛且三五世矣，今之后生所见，言语举止，无非叛也，以为事理正当如此，沈酣入骨髓，无以为非者。","book":"唐·杜牧《罪言》"},"example":{"text":"那做人的一切～，存心处事，其中讲究，真无穷尽。","book":"清·李汝珍《镜花缘》第七十一回。"},"similar":["言谈举止"],"usage":"作主语、宾语；指人的外在风度"},{"id":3731,"word":"举步如飞","pinyin":"jǔ bù rú fēi","abbr":"jbrf","explanation":"形容走的很快。","source":{"text":"宗保举步如飞，向马后赶上，踊身一跃，跳上了马，绰枪左挥右刺于殿前，往来一巡。","book":"明·无名氏《杨家将演义》第四十二回"},"example":{"text":"铅条日通加重来，路也日逐加远来，熬炼得一年半载，解放铅条，便～，行及奔马，岂不妙哉。","book":"清·俞万春《荡寇志》第八十一回"},"similar":["健步如飞","大步流星"],"opposite":["蹑手蹑脚"],"usage":"作谓语；用于人走路"},{"id":3732,"word":"举步生风","pinyin":"jǔ bù shēng fēng","abbr":"jbsf","explanation":"形容走路特别快或办事干净利索。","source":{"text":"相见了，便觉得分外高兴，说话处，脾胃多燥，行事时，举步生风，是这二种人与他说得活着。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["健步如飞"],"usage":"作谓语；指人走路或办事"},{"id":3733,"word":"举目千里","pinyin":"jǔ mù qiān lǐ","abbr":"jmql","explanation":"放眼远眺，可以见到很远之处。形容视野广阔辽远。","source":{"text":"松江太湖，举目千里，风涛不作，水面砥平。","book":"宋·刘学箕《松江哨遍》"},"similar":["一望无际"],"usage":"作宾语、分句；形容视野广阔辽远"},{"id":3734,"word":"举目无亲","pinyin":"jǔ mù wú qīn","abbr":"jmwq","explanation":"抬起眼睛，看不见一个亲人。比喻单身在外，人地生疏。","source":{"text":"四海之广，举目无亲戚，未知托身之所。","book":"唐·薛调《刘无双传》"},"example":{"text":"他到得京里，是～的，自然留他住下。","book":"清·吴趼人《二十年目睹之怪现状》第七十六回"},"similar":["无依无靠","孤苦伶仃"],"opposite":["形影相随","亲密无间"],"usage":"作谓语、宾语、定语；形容无依无靠"},{"id":3735,"word":"举目皆是","pinyin":"jǔ mù jiē shì","abbr":"jmjs","explanation":"抬头看满眼都是。形容数量多。","example":{"text":"这种黄色的小花在草原上～。"},"similar":["比比皆是"],"usage":"作谓语、定语；形容数量多"},{"id":3736,"word":"举直厝枉","pinyin":"jǔ zhí cuò wǎng","abbr":"jzcw","explanation":"起用正直者而罢黜奸邪者。同“举直错枉”。","source":{"text":"今天下缨緌搢绅，所以瞻仰明公者，以公聪明仁智，辅相汉朝，举直厝枉，致之雍熙也。","book":"《后汉书·杨彪传》"},"similar":["举直措枉","举直错枉"],"usage":"作谓语；指选用贤者，罢黜奸邪"},{"id":3737,"word":"举直措枉","pinyin":"jǔ zhí cuò wǎng","abbr":"jzcw","explanation":"举：选拔，任用；枉：弯曲，比喻邪恶的人；错：废置，罢黜；直：笔直，比喻正直的人。选用贤者，罢黜奸邪。","source":{"text":"举枉错诸枉，则民服；举枉错诸直，则民不服。","book":"《论语·为政》"},"example":{"text":"读孔圣之微言，思举直而措枉；观王珪之确论，欲激浊以扬清。","book":"清·钱彩《说岳全传》第七十三回"},"similar":["举直错枉","举直厝枉"],"usage":"作谓语；指选用贤者，罢黜奸邪"},{"id":3738,"word":"举直错枉","pinyin":"jǔ zhí cuò wǎng","abbr":"jzcw","explanation":"举：选拔。直：正直，指正直之人。错：通“措”，废弃，放弃。枉：弯曲，比喻邪恶之人。起用正直贤良，罢黜奸邪佞人。亦作“举直厝枉”、“举直措枉”。","source":{"text":"错，置也。举正直之人用之，废置邪枉之人，则民服其上。","book":"《论语·为政》：“哀公问曰：‘何为则民服？’孔子对曰：‘举枉错诸枉，则民服。’”何晏集解引包咸曰"},"example":{"text":"～，谭思旧制。","book":"《隶释·汉巴郡太守樊敏碑》"},"similar":["举直措枉","举直厝枉"],"usage":"作谓语；指选用贤者，罢黜奸邪"},{"id":3739,"word":"举眼无亲","pinyin":"jǔ yǎn wú qīn","abbr":"jywq","explanation":"抬头看，看不见一个亲人。比喻孤单无依，人地生疏。","source":{"text":"你日后必定有个好人家，好女婿，决不像我这样守活寡，举眼无亲，叫人家骑上头来欺负的。","book":"清·曹雪芹《红楼梦》第83回"},"example":{"text":"清·曹雪芹《红楼梦》第83回：“你日后必定有个好人家，好女婿，决不像我这样守活寡，～，叫人家骑上头来欺负的。”"},"similar":["举目无亲"],"opposite":["形影相随"],"usage":"作谓语、宾语、定语；形容无依无靠"},{"id":3740,"word":"举笏击蛇","pinyin":"jǔ hù jī shé","abbr":"jhjs","explanation":"笏：古代大臣上朝时拿的手板。用手板将蛇打死。比喻有胆识。","source":{"text":"有蛇出天庆观真武殿中，一郡以为神，州将帅官属往奠拜之，欲上其事。道辅径前，以笏击蛇，碎其首。观者初惊，后莫不叹服。","book":"《宋史·孔道辅传》"}},{"id":3741,"word":"举纲持领","pinyin":"jǔ gāng chí lǐng","abbr":"jgcl","explanation":"举：提出；纲：网的总绳；领：衣领。提起网的总绳，网眼就张开了；提起衣领一抖，衣服就顺了。比喻办事要抓住关键。","source":{"text":"举纲持领，事无不定。","book":"汉·王充《论衡·程材》"},"similar":["提纲挈领"],"usage":"作谓语、状语、补语；用于处事"},{"id":3742,"word":"举要删芜","pinyin":"jǔ yào shān wú","abbr":"jysw","explanation":"要：主要部分。芜：杂乱。选取重要的，删除杂乱的、没有条理的。多指写文章时应抓住重点。","source":{"text":"岑文本谓人曰：‘吾见周论事多矣，援引事类，扬榷古今，举要删芜，会文切理。一字不可加，也不可减。听之靡靡，令人忘倦。","book":"宋·王谠《唐语林·政事上》"},"usage":"作宾语；多指写文章时应抓住重点"},{"id":3743,"word":"举要治繁","pinyin":"jǔ yào zhì fán","abbr":"jyzf","explanation":"要：主要部分；治：治理；繁：芜杂。指做文章时，应抓住重点，把芜杂的部分加以修改。","source":{"text":"乘一总万，举要治繁。思无定契，理有恒存。","book":"南朝·梁·刘勰《文心雕龙·总术》"},"usage":"作谓语、定语；用于书面语"},{"id":3744,"word":"举觞称庆","pinyin":"jǔ shāng chēng qìng","abbr":"jscq","explanation":"觞：古代盛酒器。举杯庆贺，表示喜悦。","source":{"text":"我所生五子，皆有国器，并膺宠爵，每语夫人崔氏，言及于此，未尝不举觞称庆。","book":"明·无名氏《三化邯郸》第三折"},"usage":"作谓语、定语；用于书面语"},{"id":3745,"word":"举贤任能","pinyin":"jǔ xián rèn néng","abbr":"jxrn","explanation":"举：推荐，选拔。举荐贤者，任用能人。","source":{"text":"三曰举贤，四曰使能。","book":"《礼记·大传》"},"example":{"text":"～，使各尽力以保江东，我不如卿。","book":"明·罗贯中《三国演义》第二十九回"},"similar":["举贤使能"],"opposite":["任人唯亲"],"usage":"作谓语、宾语；指选拔人才"},{"id":3746,"word":"举贤使能","pinyin":"jǔ xián shǐ néng","abbr":"jxsn","explanation":"举：推荐，选拔。举荐贤者，任用能人。","source":{"text":"三曰举贤，四曰使能。","book":"《礼记·大传》"},"similar":["举贤任能"],"opposite":["任人唯亲"],"usage":"作谓语、宾语；指选拔人才"},{"id":3747,"word":"举足为法","pinyin":"jǔ zú wéi fǎ","abbr":"jzwf","explanation":"形容人的行为高尚，为后人所效法。","source":{"text":"是二儒者，吐辞为经，举足为法。","book":"唐·韩愈《进学解》"},"example":{"text":"是二儒者，吐辞为经，～，绝类离伦，优入圣域，其遇于世何如也？","book":"《旧唐书·韩愈传》"}},{"id":3748,"word":"举足轻重","pinyin":"jǔ zú qīng zhòng","abbr":"jzqz","explanation":"只要脚移动一下，就会影响两边的轻重。指处于重要地位，一举一动都足以影响全局。","source":{"text":"方蜀汉相攻，权在将军，举足左右，便有轻重。","book":"《后汉书·窦融传》"},"example":{"text":"～，动关大局。","book":"蔡东藩、许廑父《民国通俗演义》第四回"},"similar":["至关重大"],"opposite":["无足轻重","无关大局"],"usage":"作谓语、定语；用于指人的地位等","story":["西汉末年，窦融在河西为官，王莽当政时，他为波水将军。刘玄当政时，他为巨鹿太守，刘玄兵败时，他为河西五郡大将军，握有重兵，在地方威信很高，他看到刘秀得政权后就归顺东汉。刘秀封他为凉州牧，称他在政坛有举足轻重的影响"]},{"id":3749,"word":"举踵思慕","pinyin":"jǔ zhǒng sī mù","abbr":"jzsm","explanation":"举：抬起；踵：脚后跟；举踵：踮起脚跟；思慕：思念。形容十分思念，抬起脚后跟张望。","source":{"text":"举踵思慕，若怙旱之望雨。","book":"汉·司马相如《难蜀父老》"},"similar":["举踵思望"],"usage":"作谓语、宾语；用于书面语"},{"id":3750,"word":"举踵思望","pinyin":"jǔ zhǒng sī wàng","abbr":"jzsw","explanation":"举：抬起；踵：脚后跟；举踵：踮起脚跟。形容十分思念，抬起脚后跟张望。","source":{"text":"盖闻中国至仁，德洋恩普……举踵思望，如怙旱之望雨。","book":"汉·荀悦《汉纪·武帝纪》"},"similar":["举踵思慕"],"usage":"作谓语、宾语；用于书面语"},{"id":3751,"word":"举酒作乐","pinyin":"jǔ jiǔ zuò yuè","abbr":"jjzy","explanation":"举：举办；乐：音乐。举行酒宴，奏起乐曲。","source":{"text":"然既献捷，群臣上贺，权乃举酒作乐。","book":"《三国志·吴志·朱然传》"},"example":{"text":"政和礼局定饮酒祭降之节，与～器用之属，并参用辟雍宴贡士仪，其有古乐处，令用古乐。","book":"《宋史·礼乐志》"},"usage":"作谓语；用于喜庆场合"},{"id":3752,"word":"举重若轻","pinyin":"jǔ zhòng ruò qīng","abbr":"jzrq","explanation":"举起沉重的东西像是在摆弄轻的东西。比喻能力强，能够轻松地胜任繁重的工作或处理困难的问题。","source":{"text":"坡诗不尚雄杰一派，其绝人处，在乎议论英爽，笔锋精锐，举重若轻，读之似不甚用力，而力已透十分。","book":"清·赵翼《瓯北诗话·苏东坡诗》二"},"example":{"text":"公听视机警，受大任～。上爱其才敏，倚若股肱。","book":"清·昭梿《啸亭杂录·七·裘文达公》"},"similar":["精明强干","轻而易举","游刃有余"],"opposite":["心余力绌","力不胜任","力不从心"],"usage":"作谓语、宾语、状语；指能够胜任"},{"id":3753,"word":"举错动作","pinyin":"jǔ cuò dòng zuò","abbr":"jcdz","explanation":"举错：措施。指举止行动。","source":{"text":"举错动作，物遵其仪。故形为仁义，动为法则。","book":"《汉书·匡衡传》"}},{"id":3754,"word":"举错必当","pinyin":"jǔ cuò bì dàng","abbr":"jcbd","explanation":"当：恰当。指措施或举动得体、适当。","source":{"text":"举错必当，莫不如画；皇帝之明，临察四方。","book":"《史记·秦始皇本纪》"}},{"id":3755,"word":"举首加额","pinyin":"jǔ shǒu jiā é","abbr":"jsje","explanation":"举：抬起；额：额头。拱手与额相齐，表示喜悦庆幸。","source":{"text":"上乃飞白‘安静’二字，以赐若讷，若讷然后举首加额，受而藏之。","book":"宋·司马光《谕若讷》"},"similar":["举手加额"],"usage":"作谓语；表示喜悦庆幸"},{"id":3756,"word":"举首奋臂","pinyin":"jǔ shǒu fèn bì","abbr":"jsfb","explanation":"举：抬起；奋臂：有力地高举手臂。形容精神奋发。","source":{"text":"民为积欠所压，如负千钧而行。免于僵仆则幸矣；何暇举首奋臂，以营求于一饱之外哉？","book":"宋·苏轼《论积欠六事状》"},"usage":"作谓语、定语；用于书面语"},{"id":3757,"word":"举首戴目","pinyin":"jǔ shǒu dài mù","abbr":"jsdm","explanation":"举：抬起；戴目：仰视的样子。形容望着远处而有所期待或殷切期待。","source":{"text":"天下举首戴目，属心执事者，难以一二计。","book":"宋·王安石《上田正言书》"},"usage":"作谓语、定语；用于书面语"},{"id":3758,"word":"举鼎拔山","pinyin":"jǔ dǐng bá shān","abbr":"jdbs","explanation":"能将大鼎举起，能将高山拔动。比喻力大气壮。","source":{"text":"王基霸业今朝定，举鼎拔山盖世强。","book":"明·张四维《双烈记·虏骄》"},"example":{"text":"执锐披坚领大兵，排兵布阵任非轻，身怀～力，独占东吴数百城。","book":"明·无名氏《衣锦还乡》第一折"},"similar":["拔山扛鼎"],"usage":"作定语、宾语；指力大气壮"},{"id":3759,"word":"举鼎绝脰","pinyin":"jǔ dǐng jué dòu","abbr":"jdjd","explanation":"举：抬起；绝：折断；脰：颈项。双手举起鼎而折断颈项。比喻力小不能胜任。","source":{"text":"今日我辈对于此国债问题当何如？将一惟政府所指派而唯唯负担，莫敢辞乎？举鼎绝脰之患，恐遂不免也。","book":"梁启超《中国国债史》"},"similar":["举鼎绝膑"],"usage":"作谓语、宾语；比喻能力小，不能负担重任"},{"id":3760,"word":"举鼎绝膑","pinyin":"jǔ dǐng jué bìn","abbr":"jdjb","explanation":"绝：折断；膑：胫骨。双手举鼎，折断胫骨。比喻能力小，不能负担重任。","source":{"text":"王与孟说举鼎，绝膑。","book":"《史记·秦本纪》"},"example":{"text":"～，亦不敢以怨他人。","book":"章炳麟《论学会有大益于黄人亟宜保护》"},"similar":["力所不能","举鼎绝脰"],"usage":"作谓语、宾语；比喻能力小，不能负担重任","story":["春秋时期，秦武王力气很大，喜欢角斗，争强好胜。国内大力士任鄙、乌获、孟说等人均被他任命为达官显宦，经常进行决斗比赛。有一次，秦武王与孟说打赌谁能举起殿前的大鼎，孟说不行。秦武王亲自举鼎，结果折断膝盖骨而死"]},{"id":3761,"word":"乃心王室","pinyin":"nǎi xīn wáng shì","abbr":"nxws","explanation":"乃：你的；王室：指朝廷。本意是忠于朝廷。后比喻爱国。","source":{"text":"虽尔身在外，乃心罔不在王室。","book":"《尚书·康王之诰》"},"example":{"text":"脱脱～，大义灭亲，今父殁而不克奔讣，为善者不几于怎乎。","book":"《元史·太平传》"},"usage":"作谓语、定语；指忠于朝廷"},{"id":3762,"word":"乃我困汝","pinyin":"nǎi wǒ kùn rǔ","abbr":"nwkr","explanation":"是我使你受害。","source":{"text":"初，秀实为营田官。泾大将焦令谌取人田自占，给与农，约熟归其半。是岁大旱，农告无入，令谌曰：‘我知入，不知旱也。’责之急，农无以偿，往诉秀实……秀实泣曰：‘乃我困汝。’","book":"《新唐书·段颜传》"}},{"id":3763,"word":"乃文乃武","pinyin":"nǎi wén nǎi wǔ","abbr":"nwnw","explanation":"乃：助词。既有文德，又有武功。","source":{"text":"帝德广运，乃圣乃神，乃武乃文。","book":"《尚书·大禹谟》"},"example":{"text":"一阴一阳，神通也；～，圣图也。","book":"唐·王勃《九成宫颂》"},"similar":["乃武乃文"],"usage":"作谓语、定语；指人文武双全"},{"id":3764,"word":"乃武乃文","pinyin":"nǎi wǔ nǎi wén","abbr":"nwnw","explanation":"乃：助词。既有武功，又有文德。","source":{"text":"帝德广运，乃圣乃神，乃武乃文。","book":"《尚书·大禹谟》"},"example":{"text":"匡嬴相刘，～。","book":"唐·王勃《倬彼我系》"},"similar":["乃文乃武"],"usage":"作谓语、定语；指人文武双全"},{"id":3765,"word":"乃玉乃金","pinyin":"nǎi yù nǎi jīn","abbr":"nynj","explanation":"乃：是。语言像金玉一样。形容文辞优美。","source":{"text":"昔人有观象于天，视度于地，察法于人者，天丽且弥，地普而深，昔人之辞，乃玉乃金。","book":"《汉书·扬雄传》"},"example":{"text":"维册维宝，～。伊谁从之？一人事亲。","book":"《宋史·乐志十三》"}},{"id":3766,"word":"乃祖乃父","pinyin":"nǎi zǔ nǎi fù","abbr":"nznf","explanation":"乃：你的。你的祖父，你的父亲。指祖父和父亲。","source":{"text":"惟乃祖乃父，世笃忠贞。","book":"《尚书·君牙》"},"example":{"text":"现今的青年不如他们的～节俭了。"},"usage":"作主语、宾语；指祖辈"},{"id":3767,"word":"久久不忘","pinyin":"jiǔ jiǔ bù wàng","abbr":"jjbw","explanation":"久久：好久，很久。形容印象深刻。","source":{"text":"虽是坐在车子上，一棵棵松树一晃而过，但它们那种不畏风霜的姿态，却使人油然而生敬意，久久不忘。","book":"陶铸《松树的风格》"}},{"id":3768,"word":"久仰山斗","pinyin":"jiǔ yǎng shān dǒu","abbr":"jysd","explanation":"山：指泰山；斗：指北斗。长期地敬仰某人，如同仰望泰山北斗一样。多用作表示钦佩、仰慕之辞。","source":{"text":"学进仰之，如泰山北斗。","book":"《新唐书·韩愈传赞》"}},{"id":3769,"word":"久假不归","pinyin":"jiǔ jiǎ bù guī","abbr":"jjbg","explanation":"假：借；归：归还。原指假借仁义的名义而不真正实行，后指长期借用而不归还。","source":{"text":"久假而不归，恶知其非有也？","book":"《孟子·尽心上》"},"example":{"text":"谢山《鲒埼亭集》本欲仿此，然谢山殁后，其遗稿为杭世骏借去，～，后之编刻者，多未能如原恉也。","book":"谢国桢《平景孙事辑·著述考》"},"similar":["逾期不归","有名无实"],"opposite":["完璧归赵"],"usage":"作谓语、宾语、定语；指长期借用而不还"},{"id":3770,"word":"久别重逢","pinyin":"jiǔ bié chóng féng","abbr":"jbcf","explanation":"指朋友或亲人在长久分别之后再次见面。","source":{"text":"多年不见了，说了几句久别重逢的话，招呼大家坐下，书僮送上茶来。","book":"清·曾朴《孽海花》第三回"},"example":{"text":"与队员诸兄姐相别，瞬已晚年，～，情逾骨肉，竟有因感激而流涕者。","book":"郭沫若《洪波曲》第十章"},"similar":["旧雨重逢"],"opposite":["天各一方"],"usage":"作谓语、定语；指分别很久后再次见面"},{"id":3771,"word":"久历风尘","pinyin":"jiǔ lì fēng chén","abbr":"jlfc","explanation":"经历过很多艰苦的日子。","example":{"text":"他是个～的人，对名利得失看得很淡薄。"}},{"id":3772,"word":"久坐地厚","pinyin":"jiǔ zuò dì hòu","abbr":"jzdh","explanation":"比喻在某一职位上长期磨炼努力，地位自然安定稳固。"},{"id":3773,"word":"久孤于世","pinyin":"jiǔ gū yú shì","abbr":"jgys","explanation":"降：孤独。有真才实学的人，由于不被世人了解或受到别人的排挤而长期处于孤独的境遇之中。","source":{"text":"今拘学或抱咫尺之义，久孤于世。","book":"《史记·游侠列传》"}},{"id":3774,"word":"久安长治","pinyin":"jiǔ ān cháng zhì","abbr":"jacz","explanation":"形容国家长期安定、巩固。","source":{"text":"建久安之势，成长治之业。","book":"《汉书·贾谊传》"},"example":{"text":"而其道遂出于万全，此汉宋之所以～与？","book":"清·汪琬《尧峰文钞·兵论》"},"similar":["长治久安"],"usage":"作宾语；形容国家永久安定"},{"id":3775,"word":"久客思归","pinyin":"jiǔ kè sī guī","abbr":"jksg","explanation":"久客：长期客居在外。指长期客居在外，想回归故乡。","source":{"text":"久客无依，思归我乡。","book":"汉·焦延寿《易林》卷一"},"example":{"text":"我～，既得上马，断无还理。","book":"蔡东藩《两晋演义》第四十七回"}},{"id":3776,"word":"久居人下","pinyin":"jiǔ jū rén xià","abbr":"jjrx","explanation":"现指处境或职务长期处于他人之下。","source":{"text":"隐士听了，大叫：‘妙极！弟每时谓兄必非久居人下者，今所吟之句，飞腾之兆已见，不日可接履于云霓之上矣。’","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"江东将相如此，当不至～呢。","book":"蔡东藩《后汉演义》第九十一回"},"usage":"作定语；多用于官场等"},{"id":3777,"word":"久归道山","pinyin":"jiǔ guī dào shān","abbr":"jgds","explanation":"早已去世。道山，传说中的仙山。旧时称人死为归道山。"},{"id":3778,"word":"久役之士","pinyin":"jiǔ yì zhī shì","abbr":"jyzs","explanation":"役：服兵役。指长期出征在外的兵士。","source":{"text":"重复厚赏，加于久役之士。","book":"《后汉书·杜诗传》"}},{"id":3779,"word":"久怀慕蔺","pinyin":"jiǔ huái mù lìn","abbr":"jhml","explanation":"比喻想望十分殷切。","source":{"text":"相如既学，慕蔺相如之为人，更名相如。","book":"《史记·司马相如列传》"},"example":{"text":"思暮久曰极切瞻韩，想望殷曰～。","book":"清·程允升《幼学琼林·人事》"},"usage":"作宾语、定语；用于书面语"},{"id":3780,"word":"久悬不决","pinyin":"jiǔ xuán bù jué","abbr":"jxbj","explanation":"拖了很久，没有决定。","example":{"text":"及乎最近曹锟、吴佩孚加兵于东南，则～之金佛郎案即决定成立。","book":"蔡东藩、许廑父《民国通俗演义》第一百五十九回"},"similar":["悬而未决"],"usage":"作谓语、定语；指搁置"},{"id":3781,"word":"久惯牢成","pinyin":"jiǔ guàn láo chéng","abbr":"jglc","explanation":"比喻深于世故。","source":{"text":"你还说你不久惯牢成。","book":"明·兰陵笑笑生《金瓶梅词话》第46回"},"example":{"text":"对方却是轻车熟路，～，什么小窟洞都可以钻了进去。","book":"吴组缃《山洪》"},"similar":["久惯老诚"],"usage":"作谓语、定语；比喻深于世故"},{"id":3782,"word":"久惯老诚","pinyin":"jiǔ guàn lǎo chéng","abbr":"jglc","explanation":"比喻深于世故。同“久惯牢成”。","source":{"text":"个个人古怪精灵，个个人久惯老诚。","book":"明·兰陵笑笑生《金瓶梅词话》第52回"},"similar":["久惯牢成"],"usage":"作谓语、定语；比喻深于世故"},{"id":3783,"word":"久战沙场","pinyin":"jiǔ zhàn shā chǎng","abbr":"jzsc","explanation":"沙场：战场。比喻久经锻炼有经验。","source":{"text":"久战沙场，为什么功名不就？","book":"宋·释道原《景德传灯录》卷十一"},"example":{"text":"一位～的将军，此时不是在前线的战火中，而是在病床上迎来了胜利。","book":"《徐向前传》第十七章"},"similar":["久经沙场"],"usage":"作谓语、定语；指人经验丰富"},{"id":3784,"word":"久旱逢甘雨","pinyin":"jiǔ hàn féng gān yǔ","abbr":"jhfgy","explanation":"逢：遇到。干旱了很久，忽然遇到一场好雨。形容盼望已久终于如愿的欣喜心情。","source":{"text":"久旱逢甘雨，他乡遇故知；洞房花烛夜，金榜题名时。","book":"宋·洪迈《容斋四笔·得意失意诗》"},"example":{"text":"分明～，赛过他乡遇故知。莫问洞房花烛夜，且看金榜题名时。","book":"明·冯梦龙《醒世恒言》卷二十"},"similar":["他乡遇故知","如愿以偿"],"usage":"作宾语；形容盼望已久终于如愿的欣喜心情"},{"id":3785,"word":"久束湿薪","pinyin":"jiǔ shù shī xīn","abbr":"jssx","explanation":"长期捆着的潮湿柴草。比喻思想保守，不易接受新事物。","source":{"text":"而彼久束湿薪之大多数人，犹或曰：‘吾秦人而子语我以越之肥瘠也。’","book":"梁启超《饮冰室合集》自叙"},"usage":"作宾语、定语；用于比喻句"},{"id":3786,"word":"久梦初醒","pinyin":"jiǔ mèng chū xǐng","abbr":"jmcx","explanation":"形容长期从不明事理中开始明白过来。","source":{"text":"王氏久梦初醒之人，极口赞成。","book":"清·李绿园《歧路灯》第86回"},"example":{"text":"他好像～，终于明白过来。"},"similar":["大梦初醒"],"usage":"作谓语、定语、宾语；指突然觉醒"},{"id":3787,"word":"久炼成钢","pinyin":"jiǔ liàn chéng gāng","abbr":"jlcg","explanation":"经过长期的或多次的冶炼才能成为好钢。比喻　人必须经过长期的艰苦磨炼才能成为出色的人才。","source":{"text":"妻曰：‘此非汝家，家在何处？’曰：‘我家在西方。’妻笑曰：‘汝去好了。’仍打铁念佛如故。旋说偈曰：‘钉钉铛铛，久炼成钢，太平将近，我往西方。’","book":"《念佛法要》卷二"}},{"id":3788,"word":"久病成医","pinyin":"jiǔ bìng chéng yī","abbr":"jbcy","explanation":"病久了对医理就熟悉了。比喻对某方面的事见识多了就能成为这方面的行家。","source":{"text":"言人九折臂，更历方药，则成良医。","book":"春秋·鲁·左丘明《左传·定公十三年》：“三折肱，知为良医。”战国·楚·屈原《九章·惜诵》：“九折臂而成医兮。”汉·王逸注"},"example":{"text":"他～，对该病的病理了如指掌。"},"similar":["久病成良医"],"usage":"作主语、宾语；指长时间生病就对医理十分熟"},{"id":3789,"word":"久经世故","pinyin":"jiǔ jīng shì gù","abbr":"jjsg","explanation":"世俗，俗气，老于世故。","example":{"text":"他～，处理问题十分老道。"},"similar":["老于世故"],"usage":"作谓语、定语；指世俗"},{"id":3790,"word":"久经考验","pinyin":"jiǔ jīng kǎo yàn","abbr":"jjky","explanation":"经过长久的考查验证。","source":{"text":"斗争的实践证明，我国工人阶级不愧是久经考验的立场坚定的革命领导阶级。","book":"邓小平《工人阶级要为实现四个现代化作出优异贡献》"},"usage":"作谓语、定语；用于人或事理等"},{"id":3791,"word":"久经风霜","pinyin":"jiǔ jīng fēng shuāng","abbr":"jjfs","explanation":"比喻经过长期艰难困苦的磨练。","example":{"text":"他是一个～的人。"},"similar":["饱经风霜"],"usage":"作谓语、定语；形容经验丰富"},{"id":3792,"word":"久而不匮","pinyin":"jiǔ ér bù kuì","abbr":"jebk","explanation":"匮：缺乏。指物资储蓄充足，在很长时间内不缺乏供应。","source":{"text":"有蓄积，则久而不匮；器械功，则伐而不费。","book":"《管子·七法》"}},{"id":3793,"word":"久而不闻其香","pinyin":"jiǔ ér bù wén qí xiāng","abbr":"jebwqx","explanation":"在有香草的房子里呆久了，就闻不着香草的香味了。比喻处在某个环境中的时间长了，对周围一切都觉得很平常。","source":{"text":"与善人居，如入芝兰之室，久而不闻其香，即与之化矣。","book":"《孔子家语·六本》"}},{"id":3794,"word":"久而久之","pinyin":"jiǔ ér jiǔ zhī","abbr":"jejz","explanation":"经过了相当长的时间。","source":{"text":"因置大缸一口，内中贮水，日日伏其中，习其水性，久而久之，竟能在水一日之久。","book":"清·李汝珍《镜花缘》第十三回"},"example":{"text":"～，凡在上海来来往往的人开口便讲应酬，闭口也讲应酬。","book":"清·吴趼人《二十年目睹之怪现状》第一回"},"similar":["日久天长"],"opposite":["一朝一夕"],"usage":"作状语；作时间用语"},{"id":3795,"word":"久蛰思启","pinyin":"jiǔ zhé sī qǐ","abbr":"jzsq","explanation":"蛰：原指虫冬眠，引申为长时间的休息。指经过长时间的休息又想出来活动。","source":{"text":"久卧思起，久蛰思启，久懑思嚏，畜极则泻，閟极则达，势极则风，壅极则恸。","book":"明·刘基《郁离子》"}},{"id":3796,"word":"久要不忘","pinyin":"jiǔ yāo bù wàng","abbr":"jybw","explanation":"久要：旧约、旧交。不忘旧约或旧交。","source":{"text":"见利思义，见危授命，久要不忘平生之言。","book":"《论语·宪问》"},"example":{"text":"着他回去本乡，认了伯父伯母，着他一家团圆，也见得我～之意。","book":"元·无名氏《合同文字》第一折"},"usage":"作谓语、定语；指不忘旧交"},{"id":3797,"word":"久负盛名","pinyin":"jiǔ fù shèng míng","abbr":"jfsm","explanation":"负：承受，承担，引申为享有。长时期地享有好的名声。","example":{"text":"桂林山水～。"},"usage":"作谓语、定语；指出名"},{"id":3798,"word":"久违謦欬","pinyin":"jiǔ wén qǐng kài","abbr":"jwqk","explanation":"謦欬：咳嗽声，引申为言笑。指长久没有听到对方的谈笑声。即很久不通消息。","source":{"text":"双况乎昆弟亲戚之謦欬其侧者乎？","book":"《庄子·徐无鬼》"}},{"id":3799,"word":"久闻大名","pinyin":"jiǔ wén dà míng","abbr":"jwdm","explanation":"闻：听到。早就听到对方的盛名。多用作初见面时的客套话。","source":{"text":"晚生久闻大名，如雷贯耳。","book":"清·文康《儿女英雄传》第15回"},"example":{"text":"～，今日见面，果然名不虚传。"},"similar":["久仰大名"],"usage":"作谓语；多用作初见面时的客套话"},{"id":3800,"word":"义不主财","pinyin":"yì bù zhǔ cái","abbr":"ybzc","explanation":"指为重义气者不苟取财物。","source":{"text":"慈不主兵，义不主财。状元台旨：除是朝士官员，你便通报。其次村里汉、外方人及妇女，莫容它来。","book":"元·无名氏《张协状元》第三十五出"},"example":{"text":"～，慈不主兵。必定要如此如此，这般这般，不怕他远在万里，可以报我之仇，泄我之恨。","book":"清·西周生《醒世姻缘传》第八十九回"}},{"id":3801,"word":"义不主财，慈不主兵","pinyin":"yì bù zhǔ cái，cí bù zhǔ bīng","abbr":"ybzccbzb","explanation":"主：掌管。遵从道义就不能掌管钱财，心怀仁慈就不能掌管军队","source":{"text":"义不主财，慈不主兵。","book":"宋·陈元靓《事林广记·警世格言》"},"example":{"text":"清·西周生《醒世姻缘传》第89回：“‘～’，必定要如此如此，这般这般。”"},"usage":"作宾语、定语；用于书面语"},{"id":3802,"word":"义不反顾","pinyin":"yì bù fǎn gù","abbr":"ybfg","explanation":"秉义直前，决不回顾退缩。","source":{"text":"夫边郡之士，闻烽举燧燔，皆摄弓而驰，荷兵而走，流汗相属，唯恐居后，触白刃，冒流矢，义不反顾，计不旋踵，人怀怒心，如报私讎。","book":"《史记·司马相如列传》"},"similar":["义无反顾","议不反顾"],"usage":"作谓语、定语、状语；用于人","story":["西汉时期，汉武帝派大臣唐蒙去修治“西南夷道”，唐蒙征用大量民工，杀了部落酋长，引发骚乱。汉武帝让司马相如去平息事端。司马相如写《谕巴蜀檄》文告，要求巴蜀民众要“义不反顾，计不旋踵”，经沟通应酬，化解了矛盾"]},{"id":3803,"word":"义不取容","pinyin":"yì bù qǔ róng","abbr":"ybqr","explanation":"取容：讨好。为追求正义而不取悦于人。指人刚直不阿。","source":{"text":"平原君为人辨有口，刻廉刚直，家于长安。行不苟合，义不取舍。","book":"《史记·郦生陆贾列传》"},"usage":"作谓语、定语；用于书面语"},{"id":3804,"word":"义不容却","pinyin":"yì bù róng què","abbr":"ybrq","explanation":"义：道义；容：允许；却：推托。道义上不允许推辞。","source":{"text":"夫显微阐幽，义不容辞。功高德盛，资篆籀之铺扬；声飞实腾，载金石以不朽，是以定献忠穆，汉室之良佐也。","book":"唐·岑文本《唐故特进尚书右仆射上柱国虞恭公温公碑》"},"example":{"text":"全老大人始终玉成，今日此来，～。","book":"清·随缘下士《林兰香》第十一回"}},{"id":3805,"word":"义不容辞","pinyin":"yì bù róng cí","abbr":"ybrc","explanation":"容：允许；辞：推托。道义上不允许推辞。","source":{"text":"承姑丈高谊，小婿义不容辞。","book":"明·冯梦龙《醒世恒言》卷十七"},"example":{"text":"我们应该～地担当起这个任务。"},"similar":["义无反顾","匹夫有责","理所当然"],"opposite":["推三阻四"],"usage":"作谓语、定语、状语；指应该如此","story":["东汉时期，曹操挟天子而令诸侯，大举进攻孙权与刘备。赤壁之战大败而归，经过休整又一次亲率大军南下伐吴。孙权召集群臣商议对策，谋士张昭认为必须联合刘备，请刘备出兵共同抗曹，刘备是东吴的女婿，抗曹是他义不容辞的责任"]},{"id":3806,"word":"义不容隐","pinyin":"yì bù róng yǐn","abbr":"ybry","explanation":"隐：隐瞒。就道理上讲不应隐瞒，理应直言。","source":{"text":"臣总司内外，忧责是任，朝政得失，义不容隐。","book":"南朝·梁·萧衍《立选簿表》"},"example":{"text":"臣素慨于中，～。举忠勋最著者二臣，为皇上陈之，伏惟圣主垂听焉。","book":"明·孙高亮《于少保萃忠传》第四十回"}},{"id":3807,"word":"义不容默","pinyin":"yì bù róng mò","abbr":"ybrm","explanation":"默：沉默。","source":{"text":"苟有所怀，义不容默。","book":"宋·陆九渊《与吕伯恭书》"},"example":{"text":"熹家居，自以蒙累朝知遇之恩，且尚带从臣职名，～。","book":"清·毕沅《续资治通鉴》卷一百五十四"}},{"id":3808,"word":"义不屈节","pinyin":"yì bù qū jié","abbr":"ybqj","explanation":"节：节操。为了追求正义，决不失去节操。","source":{"text":"未及天明，一连数次，报说关公夜走临沮，为吴将所获，义不屈节，父子归神。","book":"明·罗贯中《三国演义》第七十七回"},"example":{"text":"狂风骤起，大浪掀天，战舟将覆，被高丽王部下大将哈都罕儿所获。张一奇～，自刎而死。","book":"明·清溪道人《禅真逸史》第四十回"}},{"id":3809,"word":"义不得辞","pinyin":"yì bù dé cí","abbr":"ybdc","explanation":"义：道义；得：得到；辞：推托。道义上不允许推辞。","source":{"text":"震以王官司徒吏，皆先由州郡之贡，而后升在王廷，策名委质，列为帝臣，选任唯命，义不得辞。","book":"唐·杜佑《通典》卷一百一"},"example":{"text":"昔公尝告其子忠彦，将求文于轼以为记而未果。既葬，忠彦以告，轼以为～也，乃泣而书之。","book":"宋·苏轼《醉白堂记》"}},{"id":3810,"word":"义不旋踵","pinyin":"yì bù xuán zhǒng","abbr":"ybxz","explanation":"旋踵：旋转脚跟。在道义上只能奋勇向前，不能退缩。","source":{"text":"莫不含怒作色，如赴私仇；茹肝涉血，义不旋踵。","book":"《魏书·邓至传》"},"example":{"text":"疆场之臣，所以奋不顾身、～者，以朕为能恤其孤也。","book":"宋·苏轼《宋滋可右侍禁》"}},{"id":3811,"word":"义不生财","pinyin":"yì bù shēng cái","abbr":"ybsc","explanation":"主持正义者不苟取财物。亦作“义不生财，慈不主兵。”","source":{"text":"薛素姐心里想到：义不生财，慈不生兵。","book":"明·冯梦龙《醒世恒言》卷八十九"}},{"id":3812,"word":"义不背亲","pinyin":"yì bù bèi qīn","abbr":"ybbq","explanation":"背：违背。讲仁义之人是不违背父母意愿的。","source":{"text":"吾闻之也，义不背亲，忠不违君，故东宗本州以为亲援，中扶郡将以安社稷，一举二得以徼忠孝，何以为非？","book":"《三国志·魏志·臧洪传》"}},{"id":3813,"word":"义不辞难","pinyin":"yì bù cí nàn","abbr":"ybcn","explanation":"为正义之事不避危难。","source":{"text":"仁不异远，义不辞难。","book":"《汉书·武帝纪》"},"example":{"text":"《明史·西域传》：“国家有事，臣子～。”"},"usage":"作谓语、定语；用于书面语"},{"id":3814,"word":"义以断恩","pinyin":"yì yǐ duàn ēn","abbr":"yyde","explanation":"照大义办事，割断私欲间的恩情。指秉公处置，不徇私情。","source":{"text":"一化齐俗，义以断恩。","book":"三国·魏·嵇康《管蔡论》"},"example":{"text":"臣闻二叔不咸，难结隆周，淮南悖纵，祸兴盛汉，莫非～，情为法屈。","book":"蔡东藩《南北史演义》第八回"}},{"id":3815,"word":"义兵不攻服","pinyin":"yì bīng bù gōng fú","abbr":"ybbgf","explanation":"服：降服归顺者。主持正义的军队不去攻打已经降服归顺的士兵。","source":{"text":"不然。吾闻之，义兵不攻服，仁者食饥饿。今服而攻之，非义兵也；饥而不食，非仁体也。不仁不义，虽得十越，吾不为也。","book":"《吕氏春秋·长攻》"}},{"id":3816,"word":"义切中抱","pinyin":"yì qiè zhōng bào","abbr":"yqzb","explanation":"切：恳切，切实；中抱：心怀。胸中怀着主持正义之情。","source":{"text":"义切中抱，虽昭感激之诚；事不先闻，固乏训齐之令。","book":"唐·许尧佐《柳氏传》"}},{"id":3817,"word":"义切辞严","pinyin":"yì qiè cí yán","abbr":"yqcy","explanation":"切：恳切，切实。道理切实，措词严肃。","source":{"text":"其文之古，惟今上足以同之；其治之盛，亦惟今上足以继之。义切辞严，固已见于中兴之诏。","book":"明·李开先《十朝诏令序》"}},{"id":3818,"word":"义刑义杀","pinyin":"yì xíng yì shā","abbr":"yxys","explanation":"正当和不必要的刑罚与杀戮。","source":{"text":"用其义刑义杀。","book":"《尚书·康诰》"},"usage":"作宾语、定语；用于书面语"},{"id":3819,"word":"义外之财","pinyin":"yì wài zhī cái","abbr":"ywzc","explanation":"指不义之财。","example":{"text":"勿贪～，勿饮过量之酒。"}},{"id":3820,"word":"义夫节妇","pinyin":"yì fū jié fù","abbr":"yfjf","explanation":"指忠义气节双全的夫妇。","source":{"text":"孝子顺孙，义夫节妇，表其门闾，才堪任用者，即宜申荐。","book":"《周书·宣帝纪》"},"example":{"text":"明·冯梦龙《醒世恒言》第五卷：“如今再说一个义虎知恩报恩，成就了人间～，为千古佳话。”"},"usage":"作主语、宾语、定语；用于书面语"},{"id":3821,"word":"义山恩海","pinyin":"yì shān ēn hǎi","abbr":"yseh","explanation":"形容恩义深重，如山高海深。","source":{"text":"念行囊空虚，欣然便周全助路资。召共居，感此义山恩海深难弃。细踌躇，甚日酬取?","book":"元·柯丹邱《荆钗记》第二十七出"},"similar":["义海恩山"],"usage":"作宾语、定语；用于书面语"},{"id":3822,"word":"义形于色","pinyin":"yì xíng yú sè","abbr":"yxys","explanation":"形：表现；色：面容。仗义不平之气在脸上流露出来。","source":{"text":"孔父可谓义形于色矣。","book":"《公羊传·桓公二年》"},"example":{"text":"吴荪甫“～”地举起左手的食指在桌子边上猛击一下。","book":"茅盾《子夜》五"},"similar":["义无反顾","义正词严","义愤填膺"],"opposite":["理屈词穷","无理取闹","心怀叵测"],"usage":"作定语、状语；指沉不住气","story":["魏文帝称帝，陈群面带愁容，文帝问他：“朕顺应天命即位，你为什么不高兴？”陈群回答说：“臣和华歆铭记先朝，现在虽然欣逢盛世，但是怀念故主恩义的心情，还是不免要流露出来。”"]},{"id":3823,"word":"义愤填胸","pinyin":"yì fèn tián xiōng","abbr":"yftx","explanation":"指胸中充满义愤。","source":{"text":"[十三妹]把白脸儿狼、傻狗二人商量的伤天害理的这段阴谋听了个仔细，登时义愤填胸。","book":"《儿女英雄传》第五回"},"example":{"text":"畿辅士民，屡遭虏骑蹂躏，莫不～，恨之切骨。","book":"姚雪垠《李自成》第一卷第二章"},"similar":["义愤填膺"],"usage":"作谓语、定语、状语；指气愤"},{"id":3824,"word":"义愤填膺","pinyin":"yì fèn tián yīng","abbr":"yfty","explanation":"义愤：对违反正义的事情所产生的愤怒；膺：胸。发于正义的愤懑充满胸中。","source":{"text":"珏斋不禁义愤填膺，自己办了个长电奏，力请宣战。","book":"清·曾朴《孽海花》第二十五回"},"example":{"text":"畿辅士民，屡遭虏骑蹂躏，莫不～，恨之切骨。","book":"姚雪垠《李自成》第一卷第二章"},"similar":["天怒人怨","满腔义愤"],"opposite":["麻木不仁","卑躬屈膝"],"usage":"作谓语、定语、状语；指气愤"},{"id":3825,"word":"义断恩绝","pinyin":"yì duàn ēn jué","abbr":"ydej","explanation":"义：情义；恩：恩情。指情谊完全决裂。","source":{"text":"想人生最苦是离别，可怜是千里关山，独自跋涉。似这般割肚牵肠，倒不如义断恩绝。","book":"元·王实甫《西厢记》第四本第四折"},"example":{"text":"此刻又被景翼那厮卖出来，已是～的了，还有甚么守节的道理。","book":"清·吴趼人《二十年目睹之怪现状》第三十四回"},"similar":["恩断义绝"],"usage":"作谓语、定语；用于交往等"},{"id":3826,"word":"义方之训","pinyin":"yì fāng zhī xùn","abbr":"yfzx","explanation":"义方：为人遵守的道理。教人以为人之道的训言。","source":{"text":"义方之训，如川之流。","book":"《左传·隐公三年》：“臣闻爱子，教之以义方，弗纳于邪，骄奢淫泆，所自邪也。”汉·蔡邕《司徒袁公夫人马氏碑》"},"example":{"text":"汉·蔡邕《司徒袁公夫人马氏碑》：“～，如川之流。”"},"usage":"作宾语；用于书面语"},{"id":3827,"word":"义无他顾","pinyin":"yì wú tā gù","abbr":"ywtg","explanation":"义：道义。为了正义事业只能勇往直前，决不退缩。","source":{"text":"武将猛士，风烈雷震，志殄元凶，义无他顾。","book":"《晋书·苻丕载记》"}},{"id":3828,"word":"义无反顾","pinyin":"yì wú fǎn gù","abbr":"ywfg","explanation":"义：道义；反顾：向后看。从道义上只有勇往直前，不能犹豫回顾。","source":{"text":"触白刃，冒流矢，义不反顾，计不旋踵。","book":"汉·司马相如《喻巴蜀檄》"},"example":{"text":"朱成功身受大明的厚恩，只有一死图报，～。","book":"华而实《汉衣冠》二"},"similar":["勇往直前","破釜沉舟"],"opposite":["畏首畏尾","畏缩不前"],"usage":"作谓语、定语、状语；用于人","story":["西汉时期，汉武帝派大臣唐蒙去修治“西南夷道”，唐蒙征用大量民工，杀了部落酋长，引发骚乱。汉武帝让司马相如去平息事端。司马相如写《谕巴蜀檄》文告，要求巴蜀民众要“义不反顾，计不旋踵”，经沟通应酬，化解了矛盾"]},{"id":3829,"word":"义无所辞","pinyin":"yì wú suǒ cí","abbr":"ywsc","explanation":"就道理上讲不应该推辞。","source":{"text":"害有至于死而不敢避者，义无所避之也；劳有至于病而不敢辞者，义无所辞之也。","book":"宋·王安石《上曾参政书》"},"example":{"text":"既是他儿子远来投奔，老弟也是～的。","book":"清·陈森《品花宝鉴》第二回"}},{"id":3830,"word":"义无旋踵","pinyin":"yì wú xuán zhǒng","abbr":"ywxz","explanation":"旋踵：把脚后跟转过来，比喻退缩。在道义上只能奋勇向前，毫不退缩。亦作“义不旋踵”。","source":{"text":"今之事势，义无旋踵，骑猛兽安可中下哉。","book":"《晋书·温峤传》"}},{"id":3831,"word":"义正词严","pinyin":"yì zhèng cí yán","abbr":"yzcy","explanation":"义：道理。词：言辞。道理正当公允，严肃的措词。亦作“义正辞严”、“辞严义正”、“辞严意正”、“词严理正”、“正义严辞”。","source":{"text":"子玄之论，义正词严，圣人复起，弗能易矣。","book":"明·胡应麟《少室山房笔丛·丹铅新录四》"},"example":{"text":"本大臣、本部堂声罪致讨，～，断断不能再缓矣。","book":"清·林则徐《会谕同知再行谕饬义律缴土交凶稿》"},"similar":["义正辞严"],"usage":"作谓语、定语、状语；指坚持正义"},{"id":3832,"word":"义正辞严","pinyin":"yì zhèng cí yán","abbr":"yzcy","explanation":"义：道理；辞：言辞。理由正当充足，措词严正有力。","source":{"text":"欧公书岂惟翰墨之妙，而辞严义正，千载之下，见者兴起，某何足以辱公此赐也哉。","book":"宋·张孝祥《明守赵敷文》"},"example":{"text":"魏竹冈拆开看时，不料上面写的甚是～。","book":"清·李宝嘉《官场现形记》第十七回"},"similar":["顺理成章","理直气壮","振振有词"],"opposite":["莫名其妙","岂有此理","理屈词穷"],"usage":"作定语、状语、宾语；指坚持正义"},{"id":3833,"word":"义正辞约","pinyin":"yì zhèng cí yuē","abbr":"yzcy","explanation":"道理严正公允，措词简炼。亦作“辞顺理正”。"},{"id":3834,"word":"义气相投","pinyin":"yì qì xiāng tóu","abbr":"yqxt","explanation":"彼此志趣、性格相投合。","source":{"text":"同袍兄弟胜同袍，义气相投漆和胶。","book":"明·崔时佩《西厢记·金兰判袂》"},"similar":["情投意合"],"usage":"作谓语、定语；指情投意合"},{"id":3835,"word":"义浆仁粟","pinyin":"yì jiāng rén sù","abbr":"yjrs","explanation":"旧指施舍贫民的食物。","source":{"text":"易缠头之金，义浆仁粟不匮矣；辍秉烛之晷，读书治生有余矣。","book":"清·冯桂芬《上海果育堂记》"},"usage":"作主语、宾语；用于书面语"},{"id":3836,"word":"义海恩山","pinyin":"yì hǎi ēn shān","abbr":"yhes","explanation":"情深似海，恩重如山。喻恩情道义深厚。","source":{"text":"将人的义海恩山，都做了远水遥岑。","book":"元·王实甫《西厢记》第三本第四折"},"similar":["义山恩海"],"usage":"作宾语、定语；用于书面语"},{"id":3837,"word":"义结金兰","pinyin":"yì jié jīn lán","abbr":"yjjl","explanation":"结交很投合的朋友。","source":{"text":"张温英才瓖玮，拜中郎将，聘蜀与诸葛亮义结金兰之好焉。","book":"《太平御览》引《吴录》"},"example":{"text":"我们已经～成为兄弟了。"},"similar":["刎颈之交","生死之交","志同道合"],"opposite":["不共戴天","狭路相逢","冤家对头"],"usage":"作谓语、定语；指结拜兄弟"},{"id":3838,"word":"义胆忠肝","pinyin":"yì dǎn zhōng gān","abbr":"ydzg","explanation":"指为人正直忠贞。","source":{"text":"义胆包天，忠肝盖地，四海无人识。","book":"《水浒传》第七二回"},"example":{"text":"安得～兮，同享宇宙太平！","book":"太平天国·洪秀全《因冯云山有难感慨作歌》"},"usage":"作谓语、定语；用于为人等"},{"id":3839,"word":"义薄云天","pinyin":"yì bó yún tiān","abbr":"ybyt","explanation":"义：正义；薄：迫近；云天：指高空。正义之气直上高空。形容为正义而斗争的精神极其崇高。","source":{"text":"高义薄云天。","book":"南朝·宋·沈约《宋书·谢灵运传》"},"similar":["正气凛然","气冲霄汉"],"usage":"作谓语、定语；夸奖人讲义气"},{"id":3840,"word":"义重恩深","pinyin":"yì zhòng ēn shēn","abbr":"yzes","explanation":"恩惠、情义极为深重。","source":{"text":"事出非常，荣加望外，恩深义厚，何以克堪；糜躯粉骨，不知所报。","book":"唐·吕颂《代郭令公谢男尚公主表》"},"example":{"text":"崎岖古道，教伊浪游，繁华别院，与奴遣愁，～难消受。","book":"清·袁于今《西楼记·卫行》"},"similar":["恩深义重"],"usage":"作谓语、定语；指恩情很深","story":["春秋末年，吴国军队攻入楚国都城，楚国大夫钟建背着楚子收的妹妹季芈，跟着楚昭王出逃。后来战争平定后季芈为了报答钟建的恩德毅然下嫁给他，两人婚后的生活美满"]},{"id":3841,"word":"之乎也者","pinyin":"zhī hū yě zhě","abbr":"zhyz","explanation":"这四个字都是文言虚词，讽刺人说话喜欢咬文嚼字。也形容半文不白的话或文章。","source":{"text":"公何会，岂是助语，共之乎者也何别？","book":"唐·卢言《卢氏杂说》"},"example":{"text":"见了王德、王仁，～了一顿，便叫过几个管事家人来吩咐。（清·吴敬梓《儒林外史》第六回）"}},{"id":3842,"word":"之乎者也","pinyin":"zhī hū zhě yě","abbr":"zhzy","explanation":"这四个字都是文言虚词，讽刺人说话喜欢咬文嚼字。也形容半文不白的话或文章。","source":{"text":"之乎者也，助得甚事？","book":"宋·文莹《湘山野录》"},"example":{"text":"他对人说话，总是满口～，叫人半懂不懂的。"},"similar":["咬文嚼字","焉哉乎也"],"opposite":["的了吗呢"],"usage":"作主语、宾语；指老学究","story":["宋朝开国皇帝赵匡胤来到朱雀门前，抬头看见门上写着“朱雀之门”，问身边大臣赵普，为什么要加“之”字，赵普告诉他“之”字是作助词用的，凑成四字吉利。赵匡胤听了，哈哈大笑说：“之乎者也这些虚字，能助得了什么事情？”"]},{"id":3843,"word":"之子于归","pinyin":"zhī zǐ yú guī","abbr":"zzyg","explanation":"之子：这个女人；于归：到丈夫家。指女子出嫁。","source":{"text":"之子于归，宜其家室。","book":"《诗经·国风·周南·桃夭》"},"usage":"作宾语、定语；用于书面语"},{"id":3844,"word":"之死不渝","pinyin":"zhī sǐ bù yú","abbr":"zsby","explanation":"至死不变。形容忠贞不二。同“之死靡它”。","source":{"text":"女有烈志，留鞠诸孤。赋诗《柏舟》，之死不渝。","book":"宋·苏辙《祭亡婿文逸民文》"},"similar":["之死靡二","之死靡它"],"usage":"作谓语、定语；指人忠诚"},{"id":3845,"word":"之死靡二","pinyin":"zhī sǐ mí èr","abbr":"zsme","explanation":"至死不变。形容忠贞不二。同“之死靡它”。","source":{"text":"若敌王所忾，勇往无前，或衔命出疆，或授职守土，或寓官闲居，感激赴义，虽所处不同，论其捐躯徇节，之死靡二，则皆为忠义之上者也。","book":"《宋史·忠义传一》"},"example":{"text":"白崖君之谏君泽民，～，在在所当祀者也。","book":"清·曹寅《重修二郎神庙记》"},"similar":["之死不渝","之死靡他","之死靡它"],"opposite":["有始无终"],"usage":"作谓语、定语；指人忠诚"},{"id":3846,"word":"之死靡他","pinyin":"zhī sǐ mí tā","abbr":"zsmt","explanation":"宋·王谠《唐语林·补遗一》：“一言革面，愿比家奴，之死靡他。”明·李贽《昆仑奴》：“忠臣侠忠，则扶颠持危，九死不悔，志士侠义，则临危自奋，之死靡他。”","source":{"text":"又不见张公鏖战暮及晡，～期捐躯！ ★清·伍观澜《西炮台行为提督张公作》诗"},"example":{"text":"清·蒲松龄《聊斋志异·罗刹海市》：“妾此生不二，～。”"},"similar":["之死不渝","之死靡二","之死靡它"],"opposite":["有始无终"],"usage":"作谓语、定语；指人忠诚"},{"id":3847,"word":"之死靡它","pinyin":"zhī sǐ mǐ tā","abbr":"zsmt","explanation":"之：到；靡：没有；它：别的。到死也不变心。形容爱情专一，致死不变。现也形容立场坚定。","source":{"text":"之死矢靡它，母也天只，不谅人只。","book":"《诗经·鄘风·柏舟》"},"example":{"text":"妾此生不二，～。","book":"清·蒲松龄《聊斋志异·罗刹海市》"},"similar":["忠贞不渝"],"usage":"作谓语、定语；指人忠诚"},{"id":3848,"word":"乌七八糟","pinyin":"wū qī bā zāo","abbr":"wqbz","explanation":"形容十分杂乱。","source":{"text":"可是，整个的北平都在污七八糟中，她所知道的‘能人’们，都闭着眼瞎混。","book":"老舍《四世同堂·偷生·四十糟中》"},"example":{"text":"你把家里弄得～的。"},"similar":["乱七八糟","凌乱不堪"],"opposite":["井井有条","井然有序"],"usage":"作谓语、定语、补语；指脏乱"},{"id":3849,"word":"乌之雌雄","pinyin":"wū zhī cí xióng","abbr":"wzcx","explanation":"乌鸦雌雄不易辨认，因以比喻不分是非善恶。","source":{"text":"具曰‘予圣’，谁知乌之雌雄。","book":"《诗经·小雅·正月》"},"example":{"text":"《孔丛子·抗志》：“谁知～，抑亦似卫之君臣乎。”"},"usage":"作宾语；用于书面语"},{"id":3850,"word":"乌云压顶","pinyin":"wū yún yā dǐng","abbr":"wyyd","explanation":"比喻恶势力猖狂。","example":{"text":"在这～的时候，我们最好不要外出。"},"similar":["彤云密布"],"usage":"作定语；指恶势力猖狂"},{"id":3851,"word":"乌合之众","pinyin":"wū hé zhī zhòng","abbr":"whzz","explanation":"象暂时聚合的一群乌鸦。比喻临时杂凑的、毫无组织纪律的一群人。","source":{"text":"归发突骑以辚乌合之众，如摧枯折腐耳。","book":"《后汉书·耿弇传》"},"example":{"text":"外边虽有些人，也是～，不相统摄。","book":"清·东鲁古狂生《醉醒石》第十二回"},"similar":["一盘散沙","乌合之卒","乌集之众"],"opposite":["如鸟兽散"],"usage":"作主语、宾语；指杂乱的一群人"},{"id":3852,"word":"乌合之卒","pinyin":"wū hé zhī zú","abbr":"whzz","explanation":"《三国志·吴志·陈泰传》：“艾等以为王经精卒破衄于西，贼众大盛，乘胜之兵既不可当，而将军以乌合之卒，继败军之后，将士失气，陇右倾荡。”","source":{"text":"今驱～，至王城之下，虏马饮淮，矢集帝室，岂有人臣而至于此？ ★《梁书·羊侃传》"},"example":{"text":"今驱～，至王城之下，虏马饮淮，矢集帝室，岂有人臣而至于此？","book":"《梁书·羊侃传》"},"similar":["乌合之众","乌集之众"],"usage":"作主语、宾语；指杂乱的一群人"},{"id":3853,"word":"乌合之师","pinyin":"wū hé zhī shī","abbr":"whzs","explanation":"象暂时聚合的一群乌鸦。比喻临时杂凑的、毫无组织纪律的军队。","source":{"text":"归发突骑以辚乌合之众，如摧枯折腐耳。","book":"《后汉书·耿弇传》"},"example":{"text":"术兵虽众，皆～，素不亲信；我以正兵守之，出奇兵胜之，无不成功。","book":"明·罗贯中《三国演义》第十七回"}},{"id":3854,"word":"乌天黑地","pinyin":"wū tiān hēi dì","abbr":"wthd","explanation":"犹言昏天黑地。比喻社会黑暗。","source":{"text":"有的人把党的事业闹得乌天黑地，你还等他觉悟，你能等得及吗？","book":"邓小平《当前钢铁工业必须解决的几个问题》"},"example":{"text":"邓小平《当前钢铁工业必须解决的几个问题》：“有的人把党的事业闹得～，你还等他觉悟，你能等得及吗？”"},"similar":["天昏地暗","昏天黑地"],"usage":"作定语、状语；多用于比喻句"},{"id":3855,"word":"乌头白马生角","pinyin":"wū tóu bái mǎ shēng jiǎo","abbr":"wtbmsj","explanation":"比喻不可能出现的事。","source":{"text":"乌头白，马生角，乃许耳。","book":"《史记·刺客列传》"}},{"id":3856,"word":"乌头白，马生角","pinyin":"wū tóu bái，mǎ shēng jiǎo","abbr":"wtbmsj","explanation":"比喻不可能出现的事。","source":{"text":"乌头白，马生角，乃许耳。","book":"西汉·司马迁《史记·刺客列传》"},"example":{"text":"照你意思，便～，也不能成功！","book":"《轰天雷》第七回"},"similar":["乌头马角"],"usage":"作定语、分句；指虚无的事情","story":["战国末年，燕国太子丹在秦国当人质，与秦王嬴政发生冲突被囚禁起来，太子丹请求放他回国。秦王说：“乌头白，马生角，乃许耳。”太子丹只好仰天长叹，可能是上天有眼，牢房外飞来一只白头乌鸦，秦王只好遣送太子丹回国"]},{"id":3857,"word":"乌头马角","pinyin":"wū tóu mǎ jiǎo","abbr":"wtmj","explanation":"比喻不能实现之事。同“乌白马角”。","source":{"text":"乌头白，马生角，乃许耳。","book":"西汉·司马迁《史记·刺客列传》"},"example":{"text":"这样～的事是难以实现的。"},"similar":["乌头白，马生角"],"usage":"作宾语、定语；指不可能出现的事","story":["战国末年，燕国太子丹在秦国当人质，与秦王嬴政发生冲突被囚禁起来，太子丹请求放他回国。秦王说：“乌头白，马生角，乃许耳。”太子丹只好仰天长叹，可能是上天有眼，牢房外飞来一只白头乌鸦，秦王只好遣送太子丹回国"]},{"id":3858,"word":"乌帽红裙","pinyin":"wū mào hóng qún","abbr":"wmhq","explanation":"泛指男女。","source":{"text":"丝竹隐隐，载将来、一队乌帽红裙。天然风韵，映着柳陌斜曛。名姝也须名士衬，画舫偏宜画阁邻。","book":"清·孔尚任《桃花扇·闹榭》"},"usage":"作宾语、定语；用于书面语"},{"id":3859,"word":"乌有先生","pinyin":"wū yǒu xiān shēng","abbr":"wyxs","explanation":"虚拟的人名或事物。","source":{"text":"楚使子虚使于齐，王悉发车骑，与使者出畋。畋罢，子虚过姹乌有先生，亡是公存焉。","book":"汉·司马相如《子虚赋》"},"example":{"text":"岂意青州六从事，化为乌有一先生。","book":"宋·苏轼《章质夫送酒六壶书至而酒不达戏作小诗问之》诗"},"usage":"作宾语、定语；指虚拟的人名或事物"},{"id":3860,"word":"乌有子虚","pinyin":"wū yǒu zǐ xū","abbr":"wyzx","explanation":"乌有：哪有；子虚：并非真实。指假设的、不存在的、不真实的事情。","source":{"text":"楚使子虚使于齐，王悉发车骑，与使者出畋。畋罢，子虚过奼乌有先生，亡是公存焉。","book":"汉·司马相如《子虚赋》"},"example":{"text":"都察院蟒，余载于滦阳消夏录中，尝两见其蟠迹，非～也。","book":"清·纪昀《阅微草堂笔记·槐西杂志一》"}},{"id":3861,"word":"乌漆墨黑","pinyin":"wū qī mò hēi","abbr":"wqmh","explanation":"乌黑，深黑。","example":{"text":"～的夜晚，我们只好停止行军。"},"usage":"作定语；形容很黑暗"},{"id":3862,"word":"乌灯黑火","pinyin":"wū dēng hēi huǒ","abbr":"wdhh","explanation":"指晚上没灯没火，形容很暗。","example":{"text":"～的，怎么看书？"},"similar":["黑灯瞎火"],"usage":"作定语；形容很暗"},{"id":3863,"word":"乌烟瘴气","pinyin":"wū yān zhàng qì","abbr":"wyzq","explanation":"乌烟：黑烟；瘴气：热带山林中的一种湿热空气，旧时认为是瘴疠的病原。比喻环境嘈杂、秩序混乱或社会黑暗。","source":{"text":"如今闹了个乌烟瘴气。","book":"清·文康《儿女英雄传》第三十二回"},"example":{"text":"这样，汪精卫派和国民党的反共顽固派两家里应外合，把时局闹得～了。","book":"毛泽东《团结一切抗日力量，反对反共顽固派》"},"similar":["乱七八糟","污七八糟"],"opposite":["明月清风"],"usage":"作谓语、定语、状语；指糟乱"},{"id":3864,"word":"乌焉成马","pinyin":"wū yān chéng mǎ","abbr":"wycm","explanation":"乌、焉、马三字字形相近，几经传抄而写错。指文字因形体相似而传写错误。","source":{"text":"故书焉为马，杜子春云‘当为焉’。","book":"《周礼·天官·缝人》：“丧，缝棺饰焉”汉·郑玄注"},"example":{"text":"字经三写，～。","book":"清·刘献廷《广阳杂记》第四卷"},"usage":"作谓语、定语；指错字"},{"id":3865,"word":"乌焦巴弓","pinyin":"wū jiāo bā gōng","abbr":"wjbg","explanation":"乌：黑色；焦：火力过猛，使东西烧成炭样。原是《百家姓》中的四个姓氏。比喻烧得墨黑。","source":{"text":"良弼正要进门，猛听得一声怪响，不禁却顾，可巧弹落脚旁，把左足轰得乌焦巴弓，呼痛未终，已是晕倒。","book":"蔡东藩、许廑父《民国演义》五回"},"usage":"作状语；多用于口语"},{"id":3866,"word":"乌白头，马生角","pinyin":"wū bái tóu，mǎ shēng jiǎo","abbr":"wbtmsj","explanation":"乌鸦变白，马头生角。比喻不能实现之事。","source":{"text":"燕太子丹质于秦，秦王遇之无礼，不得意，欲求归。秦王不听，谬言曰：‘令乌白头，马生角，乃可许耳。’","book":"《燕丹子》卷上"}},{"id":3867,"word":"乌白马角","pinyin":"wū bái mǎ jiǎo","abbr":"wbmj","explanation":"乌鸦变白，马头生角。比喻不能实现之事。","source":{"text":"燕太子丹质于秦，秦王遇之无礼，不得意，欲求归。秦王不听，谬言曰：‘令乌白头，马生角，乃可许耳。’","book":"《燕丹子》卷上"},"example":{"text":"洁城洗志期暮年，～宁足言。","book":"南朝宋·鲍照《代白紵舞歌》诗"},"usage":"作谓语、定语；指虚无的事情","story":["战国末年，燕国太子丹在秦国当人质，与秦王嬴政发生冲突被囚禁起来，太子丹请求放他回国。秦王说：“乌头白，马生角，乃许耳。”","太子丹只好仰天长叹，可能是上天有眼，牢房外飞来一只白头乌鸦，秦王只好遣送太子丹回国"]},{"id":3868,"word":"乌纱帽","pinyin":"wū shā mào","abbr":"wsm","explanation":"古代官吏戴的一种帽子。比喻官位。","source":{"text":"只是各有所因，故苟恋于此，断非舍不得这一顶乌纱帽耳。","book":"清·荑荻散人《玉娇梨》第一回"},"usage":"作宾语、定语；多用于比喻句"},{"id":3869,"word":"乌舅金奴","pinyin":"wū jiù jīn nú","abbr":"wjjn","explanation":"乌桕子油和油灯。用以讥讽吝啬者。","source":{"text":"一旦黄昏急须烛，唤小黄门：‘掇过我金奴来。’左右窃相谓曰：‘乌舅金奴正好作对。’","book":"宋·陶穀《清异录·器具》"},"usage":"作宾语、定语；用于书面语","story":["江南烈祖一向十分节俭，寝宫里不点脂烛灯，只点灌舅子油的乌舅灯。桌上有一个五尺高的捧烛铁人，是杨氏时的马厩中用的。一天黄昏天暗需要点灯时，烈祖叫手下捧这个叫金奴的铁人来。手下人偷偷说：“乌舅金奴正好作对。”"]},{"id":3870,"word":"乌衣之游","pinyin":"wū yī zhī yóu","abbr":"wyzy","explanation":"指亲属间文酒赏会。","source":{"text":"混风格高峻，少所交纳，唯与族子灵运、瞻、矅、弘微并以文酒赏会。尝共宴处，居在乌衣巷，故谓之乌衣之游，混五言诗所云‘昔为乌衣游，戚戚皆亲侄’者也。","book":"《宋书·谢弘微传》"},"example":{"text":"王闿运《罗季子诔》：“～，帷余最密；青青子衿，劳思何及！”"},"usage":"作宾语；用于书面语"},{"id":3871,"word":"乌衣子弟","pinyin":"wū yī zǐ dì","abbr":"wyzd","explanation":"乌衣：乌衣巷，东晋时王导、谢安等世家大族居住在此。王谢那样的望族子弟。后泛指富贵人家的子弟。","source":{"text":"水阁含春，便有那乌衣子弟伴红裙。","book":"清·孔尚任《桃花扇·拒媒》"},"similar":["公子王孙"],"usage":"作主语、宾语、定语；用于书面语"},{"id":3872,"word":"乌衣门巷","pinyin":"wū yī mén xiàng","abbr":"wymx","explanation":"乌衣巷：六朝时王谢两大望族的居住地。形容豪门望族的居住地。常含对世事兴亡盛衰的感叹之意。","source":{"text":"尝共宴处，居在乌衣巷，故谓之乌衣之游。","book":"《宋书·谢弘微传》"},"example":{"text":"～，叹当年王谢，依旧斜阳。","book":"明·吴廷翰《白练序·咏燕·升平乐》"}},{"id":3873,"word":"乌衣门第","pinyin":"wū yī mén dì","abbr":"wymd","explanation":"指世家望族。","source":{"text":"尝共宴处，居在乌衣巷，故谓之乌衣之游。","book":"《宋书·谢弘微传》"},"example":{"text":"偶然间，缁尘京华，～。","book":"清·纳兰性德《金缕曲》词"},"similar":["名门望族"],"usage":"作宾语、定语；用于书面语"},{"id":3874,"word":"乌踆兔走","pinyin":"wū cún tù zǒu","abbr":"wctz","explanation":"指日月运行。兔，传说中的月中玉兔。借指月亮。","source":{"text":"茅龙飞去杳无迹，乌踆兔走双跳丸。","book":"元·柳贯《题》诗"},"similar":["乌飞兔走"],"usage":"作宾语、定语；用于书面语"},{"id":3875,"word":"乌踷兔走","pinyin":"wū cún tù zǒu","abbr":"wctz","explanation":"指日月运行。兔，传说中的月中玉兔。借指月亮。"},{"id":3876,"word":"乌集之交","pinyin":"wū jí zhī jiāo","abbr":"wjzj","explanation":"指以利聚合，不以诚相待的交情。","source":{"text":"与人交，多诈伪无情实，偷取一切，谓之乌集之澔。","book":"春秋·齐·管仲《管子·形势解》"},"usage":"作宾语；用于书面语"},{"id":3877,"word":"乌集之众","pinyin":"wū jí zhī zhòng","abbr":"wjzz","explanation":"犹言乌合之众。比喻临时杂凑的、毫无组织纪律的一群人。","source":{"text":"故汉祖奋三尺之剑，驱乌集之众，五年之中而成帝业。","book":"三国·魏·曹冏《六代论》"},"example":{"text":"晋·陈寿《三国志·吴志·虞翻传》：“明府用～，驱散附之士。”"},"similar":["乌合之众","乌合之卒"],"usage":"作主语、宾语；指杂乱的一群人"},{"id":3878,"word":"乌面鹄形","pinyin":"wū miàn hú xíng","abbr":"wmgx","explanation":"脸黑如乌，身瘦如鹄。形容人困饿潦倒之状。","source":{"text":"百姓流亡，死者涂地……其绝粒久者，乌面鹄形。","book":"《南史·侯景传》"},"usage":"作宾语、定语；用于书面语"},{"id":3879,"word":"乌飞兔走","pinyin":"wū fēi tù zǒu","abbr":"wftz","explanation":"乌：古代传说日中有三足乌，故称太阳为金乌；兔：古代传说中月中有玉兔，故称月亮为玉兔。形容光阴迅速流逝。","source":{"text":"行人自是心如火，兔走乌飞不觉长。","book":"唐·韩琮《春愁》诗：“金乌长飞玉兔走，青鬓长青古无有。”唐·韦庄《秋日早行》诗"},"example":{"text":"～，瞬息光阴，暑往寒来，不觉七载。","book":"明·许仲琳《封神演义》第十二回"},"similar":["日月如梭","玉走金飞"],"usage":"作谓语、补语；形容光阴过得很快"},{"id":3880,"word":"乌鸟之情","pinyin":"wū niǎo zhī qíng","abbr":"wnzq","explanation":"古时传说，乌鸦有反哺之情。因以比喻奉养长辈的孝心。","source":{"text":"钦累世受魏恩，乌鸟之情，窃怀愤踊。","book":"三国·魏·杜挚《降吴表》"},"similar":["乌鸟私情"],"usage":"作宾语、定语；指侍奉尊亲的孝心"},{"id":3881,"word":"乌鸟私情","pinyin":"wū niǎo sī qíng","abbr":"wnsq","explanation":"乌鸟：古时传说，小乌能反哺老乌。比喻侍奉尊亲的孝心。","source":{"text":"乌鸟私情，愿乞终养。","book":"晋·李密《陈情表》"},"example":{"text":"臣已离家日久，老母现在抱病垂危，望陛下赐臣还乡，少遂～。","book":"清·钱彩《说岳全传》第四十五回"},"similar":["乌鸟之情"],"usage":"作宾语、定语；指侍奉尊亲的孝心"},{"id":3882,"word":"乌鸦嘴","pinyin":"wū yā zuǐ","abbr":"wyz","explanation":"比喻说话讨厌的人。","source":{"text":"我变成乌鸦嘴了。","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"小心你的～，千万要免开尊口。"},"usage":"作宾语、定语；用于口语"},{"id":3883,"word":"乌鹊通巢","pinyin":"wū què tōng cháo","abbr":"wqtc","explanation":"乌鸦与喜鹊同巢。比喻异类和睦共处。","source":{"text":"家门雍睦，七叶共居，犬豕同乳，乌鹊通巢，时人以为义感之应。","book":"《隋书·郭隽传》"},"usage":"作宾语、定语；多用于比喻句"},{"id":3884,"word":"乍入芦圩，不知深浅","pinyin":"zhà rù lú wéi，bù zhī shēn qiǎn","abbr":"zrlwbzsq","explanation":"乍：刚刚开始；圩：圩子。刚到芦苇地，不知里边的深浅。比喻初到某地，，须小心行事。","source":{"text":"我若把功曹的言语实实告诵师父，师父他不济事，必就哭了；假若不与他实说，梦着头，带着他走，常言道乍入芦圩，不知深浅。","book":"明·吴承恩《西游记》第三十二回"},"usage":"作宾语、定语、分句；用于书面语"},{"id":3885,"word":"乍前乍却","pinyin":"zhà qián zhà què","abbr":"zqzq","explanation":"乍：忽然；却：后退。忽而向前，忽而后退。形容行动犹豫不定。","source":{"text":"又刘表自以为宗室，包藏奸心，乍前乍却，以观世事，据有当州，孤复定之，遂平天下。","book":"汉·曹操《让县自明本志令》"},"example":{"text":"老坡尤爱“轻燕受风斜”，以谓燕迎风低飞，～，非受字不能形容也。（宋·胡仔《苕溪渔隐丛话前集》卷八）"}},{"id":3886,"word":"乍同乍异","pinyin":"zhà tóng zhà yì","abbr":"ztzy","explanation":"乍：忽然；同：一样；异：不同。一会同意，一会不同意，形容言语或态度变化太快。","source":{"text":"其说辞也，乍同乍异。","book":"《鬼谷子·飞坩》"},"similar":["反复无常"],"usage":"作谓语；指态度无常"},{"id":3887,"word":"乍往乍来","pinyin":"zhà wǎng zhà lái","abbr":"zwzl","explanation":"乍：忽然；往：去。一会儿走，一会儿又来。形容来去行踪不定。","source":{"text":"最是那不大段计利害、乍往乍来底念虑，相续不断，难为驱除。","book":"宋·朱熹《朱子语类》卷一百三"},"example":{"text":"目随身转，未有动荡其身，而能胶住其目者，使之～，多行数武。（清·李渔《闲情偶寄·选姿·眉眼》）"},"usage":"作定语、状语；用于书面语"},{"id":3888,"word":"乍暖乍寒","pinyin":"zhà nuǎn zhà hán","abbr":"znzh","explanation":"乍：刚刚开始。忽冷忽热。形容春秋季节，天气寒暑变化无常。","source":{"text":"门外满地香风，残梅零乱，玉糁苍苔碎。乍暖乍寒浑莫拟，欲试罗衣犹未。","book":"宋·柴望《念奴娇》词"},"example":{"text":"对残春，消永昼。～时候。人独自，倚危楼。夕阳多少愁。（宋·吴潜《更漏子》词）"}},{"id":3889,"word":"乍暖还寒","pinyin":"zhà nuǎn hái hán","abbr":"znhh","explanation":"形容冬末春初气侯忽冷忽热，冷热不定。","source":{"text":"柳梢绿小眉如印。乍暖还寒犹未定。","book":"宋·李清照《声声慢》词：“寻寻觅觅，冷冷清清，凄凄惨惨戚戚。乍暖还寒时候，最难将息。”宋 ·刘清夫《玉楼春》词"}},{"id":3890,"word":"乍毛变色","pinyin":"zhà máo biàn sè","abbr":"zmbs","explanation":"形容因惊恐而毛发竖立，面色失常。"},{"id":3891,"word":"乍雨乍晴","pinyin":"zhà yǔ zhà qíng","abbr":"zyzq","explanation":"乍：忽然。一会儿下雨，一会儿又天晴。形容人的心情或时局变化多端。","source":{"text":"乍雨乍晴花自落，闲愁闲闷昼偏长。为谁消瘦损容光。","book":"宋·欧阳修《浣溪沙》词"},"example":{"text":"轻寒轻暖夹衣天，～寒食路。（宋·王诜《玉楼春·海棠》词）"},"usage":"作谓语、定语；用于书面语"},{"id":3892,"word":"乏善足陈","pinyin":"fá shàn zú chén","abbr":"fszc","explanation":"善：指进德修业上成绩良好；陈：陈述，告诉。没有什么德业上的增益足以告诉对方。自谦语。","source":{"text":"正所谓贱体粗安，乏善足陈。","book":"茅盾《追求》六"},"usage":"作宾语；用于写信自谦"},{"id":3893,"word":"乐不可支","pinyin":"lè bù kě zhī","abbr":"lbkz","explanation":"支：撑住。快乐到不能撑持的地步。形容欣喜到极点。","source":{"text":"桑无附枝，麦穗两歧，张君为政，乐不可支。","book":"汉·班固《东观汉记·张堪传》"},"example":{"text":"兰言夫子听了宝云夫子之话，正中心怀，～，如何肯去拦阻。","book":"清·李汝珍《镜花缘》第八十四回"},"similar":["喜出望外","兴高采烈"],"opposite":["痛不欲生","肝肠寸断"],"usage":"作谓语、定语、状语；形容快乐到极点","story":["东汉初年，张堪跟随刘秀攻打四川公孙述立下赫赫战功，被任命为蜀郡太守，后调任渔阳太守，抗击北方的匈奴入侵。他不但英勇善战，而且开垦农田，兴修水利。他从不贪图个人富贵，百姓歌曰：桑无附枝，麦穗两歧，张君为政，乐不可支"]},{"id":3894,"word":"乐不可极","pinyin":"lè bù kě jí","abbr":"lbkj","explanation":"享乐不可过分。","source":{"text":"志不可满，乐不可极。","book":"西汉·戴圣《礼记·曲礼上》"},"example":{"text":"曾不知～，盈难持久。","book":"《晋书·东海王越传论》"},"similar":["乐不极盘"],"usage":"作谓语、宾语；指享乐不可过分"},{"id":3895,"word":"乐不可言","pinyin":"lè bù kě yán","abbr":"lbky","explanation":"快乐到了极点，没法用语言来表达。","source":{"text":"魂乎归徕，乐不可言只。","book":"战国·楚·屈原《大招》"},"example":{"text":"小二闻听，～，连忙把那边的小二叫了来。","book":"清·石玉昆《三侠五义》三十四回"},"similar":["乐不可支"],"usage":"作谓语；指人的心情"},{"id":3896,"word":"乐不思蜀","pinyin":"lè bù sī shǔ","abbr":"lbss","explanation":"很快乐，不思念蜀国。比喻在新环境中得到乐趣，不再想回到原来环境中去。","source":{"text":"问禅曰：‘颇思蜀否？’禅曰：‘此间乐，不思蜀。’","book":"《三国志·蜀书·后主传》裴松之注引《汉晋春秋》"},"example":{"text":"那麦思敦更觉气色傲然，或饮或食，忽踊忽歌，大有“此间～”之意。","book":"鲁迅《月界旅行》第七回"},"similar":["乐不可支","乐而忘返"],"opposite":["落叶归根","恋恋不舍"],"usage":"作谓语、定语；形容忘本","story":["三国时蜀国昭烈帝刘备死后，刘禅即位。诸葛亮死后，蜀国灭亡。后主刘禅投降了司马文王司马昭。司马昭宴请刘禅，故意安排蜀国的节目，刘禅看得津津有味，司马昭问刘禅感受如何，刘禅说：“此间乐，不思蜀”。司马昭讥笑他麻木不仁"]},{"id":3897,"word":"乐不极盘","pinyin":"lè bù jí pán","abbr":"lbjp","explanation":"盘：乐。指享乐不能过分。","source":{"text":"乐不极盘，杀不尽物。","book":"东汉·班固《东都赋》"},"similar":["乐不可极"],"usage":"作宾语；指享乐不能过分"},{"id":3898,"word":"乐业安居","pinyin":"lè yè ān jū","abbr":"lyaj","explanation":"愉快地从事自己的职业，过着安定的生活。形容生活、生产、思想状况安定正常。","source":{"text":"见如今四海无虞，八方黎庶皆丰富，乐业安居。","book":"元·无名氏《延安府》第一折"},"example":{"text":"俾家喻户晓，益厉急公亲上之心，共享～之福。","book":"清·夏燮《中西纪事·粤民义师》"},"similar":["安居乐业"],"usage":"作谓语、宾语、定语；同“安居乐业”"},{"id":3899,"word":"乐为用命","pinyin":"lè wéi yòng mìng","abbr":"lwym","explanation":"用命：听从命令。乐于听从命令，为之效力。","source":{"text":"然开爽有计略，轻财敬士，能厚养健儿，健儿亦乐为用命。","book":"《三国志·吴书·甘宁传》"},"example":{"text":"此正可见刘先主之驾驭英雄，自有令人倾倒、～者。","book":"蔡东藩《后汉演义》第六十二回"}},{"id":3900,"word":"乐乐不殆","pinyin":"lè lè bù dài","abbr":"llbd","explanation":"乐乐：坚定；殆：通“怠”，懈怠。坚定不懈的样子。","source":{"text":"乐乐兮其执道不殆也。","book":"《荀子·儒效》"}},{"id":3901,"word":"乐乐醄醄","pinyin":"lè lè táo táo","abbr":"lltt","explanation":"心情十分高兴的样子。","source":{"text":"锡天厨美酒嘉肴，众位公卿乐乐醄醄。","book":"明·无名氏《浣花溪》第四折"},"similar":["乐乐陶陶"],"usage":"作谓语、定语；指高兴"},{"id":3902,"word":"乐乐陶陶","pinyin":"lè lè táo táo","abbr":"lltt","explanation":"心情十分高兴的样子。","source":{"text":"乐乐陶陶，春花秋月。秋月何时了 心中欢乐；且自清闲直到老，散诞逍遥。","book":"元·无名氏《十棒鼓》曲"},"example":{"text":"似这雪，农夫每喜年丰～，争如俺，神仙每玩瑶华散袒逍遥。","book":"明·朱有燉《十长生》第二折"},"similar":["乐乐醄醄"],"usage":"作谓语、定语；指高兴"},{"id":3903,"word":"乐事劝功","pinyin":"lè shì quàn gōng","abbr":"lsqg","explanation":"指乐于从事所业，努力获得成效。","source":{"text":"无旷土，无游民，食节事时，民咸安其居，乐事劝功。","book":"西汉·戴圣《礼记·王制》"},"example":{"text":"器用便利，则用力少而得作多，农夫～。","book":"汉·桓宽《盐铁论·水旱》"},"usage":"作谓语、定语；用于书面语"},{"id":3904,"word":"乐于助人","pinyin":"lè yú zhù rén","abbr":"lyzr","explanation":"很乐意帮助别人。","source":{"text":"康同璧的乐于助人，在一定程度上是受了家庭的影响。","book":"章诒和《往事并不如烟·最后的贵族》"},"example":{"text":"章诒和《往事并不如烟·最后的贵族》：“康同璧的～，在一定程度上是受了家庭的影响。”"},"similar":["助人为乐"],"usage":"作谓语、定语；用于处事"},{"id":3905,"word":"乐以忘忧","pinyin":"lè yǐ wàng yōu","abbr":"lywy","explanation":"由于快乐而忘记了忧愁。形容非常快乐。","source":{"text":"发愤忘食，乐以忘忧。","book":"《论语·述而》"},"example":{"text":"似这等～，胡必归欤！","book":"元·王实甫《丽春堂》第三折"},"usage":"作谓语、宾语；指由于快乐而忘记了忧愁","story":["春秋时期，孔子带领学生周游列国讲学，来到楚国叶邑，叶公沈诸梁接待了他，他对孔子不怎么了解，就悄悄地问子路，子路一时不知怎么回答他。孔子事后得知就对子路说以后就说：“其为人也，发愤忘食，乐以忘忧，不知老之将至。”"]},{"id":3906,"word":"乐以道和","pinyin":"yuè yǐ dào hé","abbr":"lydh","explanation":"乐：音乐。音乐能够表现中和之气。","source":{"text":"礼以道行，乐以道和。","book":"《庄子·天下》"}},{"id":3907,"word":"乐分龙赵","pinyin":"yuè fēn lóng zhào","abbr":"lflz","explanation":"琴乐的流传，分为龙赵两家。","source":{"text":"乐分龙赵，诗析齐韩。","book":"南朝·梁·任昉《齐竟陵文宣王行状》"}},{"id":3908,"word":"乐善不倦","pinyin":"lè shàn bù juàn","abbr":"lsbj","explanation":"乐于做好事，不觉疲倦。","source":{"text":"仁义忠言，乐善不倦，此天爵也。","book":"《孟子·告子上》"},"example":{"text":"虽不学古而暗于义，仁而爱人，～，其天性然也。","book":"清·顾炎武《山阳王君墓志铭》"},"usage":"作谓语、定语；用于处世"},{"id":3909,"word":"乐善好义","pinyin":"lè shàn hào yì","abbr":"lshy","explanation":"爱做好事，讲义气。","source":{"text":"伏以阁下朴厚清明，谠直之行，乐善好义。远大之心，施于朝廷，而博见于天下。","book":"宋·曾巩《与杜相公书》"},"example":{"text":"明·宋濂《龙渊义塾记》：“陈京兄弟，～，以助其成。”"},"usage":"作谓语、定语；用于处世"},{"id":3910,"word":"乐善好施","pinyin":"lè shàn hào shī","abbr":"lshs","explanation":"乐：好，喜欢。喜欢做善事，乐于拿财物接济有困难的人。","source":{"text":"闻徵音，使人乐善而好施；闻羽音，使人整齐而而好礼。","book":"《史记·乐书二》"},"example":{"text":"宋湜懿文多识，名动人主，至与李沅同命。虽去沅远甚，然～，士类归之，亦可尚也。","book":"《宋史·陈彭年传论》"},"similar":["助人为乐","舍生取义"],"opposite":["下井投石","打家劫舍"],"usage":"作谓语、定语；用于赞扬心地善良的人"},{"id":3911,"word":"乐嗟苦咄","pinyin":"lè jiē kǔ duō","abbr":"ljkd","explanation":"高兴时招唤，不高兴时责骂。形容对人态度恶劣。","source":{"text":"凭几据杖指麾而使则厮役者至，乐嗟苦咄则徒隶之人至矣。","book":"《鹖冠子·博选》"},"usage":"作谓语、定语；用于对人的态度"},{"id":3912,"word":"乐在其中","pinyin":"lè zài qí zhōng","abbr":"lzqz","explanation":"喜欢做某事，并在其中获得乐趣。","source":{"text":"饭疏食饮水，曲肱而枕之，乐亦在其中矣。","book":"春秋·鲁·孔丘《论语·述而》"},"example":{"text":"孔子曰：‘～矣。’遂自号为‘随园’云。","book":"清·韩泰华《无事为福斋随笔》下卷"},"similar":["乐而忘返","乐不可支","乐此不疲"],"opposite":["闷闷不乐","忧心忡忡","忧心如焚"],"usage":"作宾语、定语、分句；指做事获乐"},{"id":3913,"word":"乐天任命","pinyin":"lè tiān rèn mìng","abbr":"ltrm","explanation":"犹言听天由命。听任事态自然发展变化，不做主观努力。也比喻碰机会，该怎么样就怎么样。","source":{"text":"像这样乐天任命的民族，我们将如之何呢？","book":"郑振铎《止水的下层》"},"similar":["听天由命"],"usage":"作谓语、定语；用于书面语"},{"id":3914,"word":"乐天安命","pinyin":"lè tiān ān mìng","abbr":"ltam","explanation":"安于自己的处境，由命运安排。这是相信宿命论的人生观。同“乐天知命”","source":{"text":"连她这个乐天安命的年轻姑娘现在也说出这样的话来，这倒是觉新料想不到的。","book":"巴金《春》"},"similar":["乐天知命"],"usage":"作谓语、宾语、定语；指听从命运安排"},{"id":3915,"word":"乐天知命","pinyin":"lè tiān zhī mìng","abbr":"ltzm","explanation":"天：天意；命：命运。安于自己的处境，由命运安排。这是相信宿命论的人生观。","source":{"text":"乐天知命，故不忧。","book":"《周易·系辞上》"},"example":{"text":"近来我在林下，倒常教他做几首诗，吟咏性情，要他知道～的道理，在我膝下承欢便了。","book":"清·吴敬梓《儒林外史》第八回"},"similar":["听天由命"],"opposite":["自力更生","战天斗地"],"usage":"作宾语、定语；指听从命运安排"},{"id":3916,"word":"乐尽哀生","pinyin":"lè jìn āi shēng","abbr":"ljas","explanation":"犹言乐极生悲。欢乐到了极点，将转而发生悲伤的事。","source":{"text":"有同必异，自昔攸然；乐尽哀生，古来常事。","book":"唐·张鷟《游仙窟》"},"similar":["乐尽悲来","乐极生悲"],"usage":"作宾语、定语；用于劝诫人"},{"id":3917,"word":"乐尽悲来","pinyin":"lè jìn bēi lái","abbr":"ljbl","explanation":"犹言乐极生悲。欢乐到了极点，将转而发生悲伤的事。","source":{"text":"自南宫迁于西内，时移事去，乐尽悲来。","book":"唐·陈鸿《长恨歌传》"},"similar":["乐尽哀生","乐极生悲"],"usage":"作宾语、定语；用于劝诫人"},{"id":3918,"word":"乐山乐水","pinyin":"yào shān yào shuǐ","abbr":"lsls","explanation":"乐：喜爱，爱好。有人喜爱山，有人喜爱水。比喻各人的爱好不同。","source":{"text":"知者乐山，仁者乐水。","book":"《论语·雍也》"},"example":{"text":"～，气类相合。","book":"宋《二程全书·外书七》"},"similar":["乐水乐山"],"usage":"作宾语、定语；用于书面语"},{"id":3919,"word":"乐山爱水","pinyin":"lè shān ài shuǐ","abbr":"lsas","explanation":"爱好山水风光。"},{"id":3920,"word":"乐往哀来","pinyin":"lè wǎng āi lái","abbr":"lwal","explanation":"欢乐逝去，悲哀到来。","source":{"text":"惟盘逸之无瞋兮，惧乐往而哀来。","book":"汉·张衡《思玄赋》"},"example":{"text":"虽行幸道路，或时马上奏之，～，竟以亡国。","book":"《隋书·音乐志》"},"similar":["乐极生悲"],"usage":"作宾语、定语；用于劝诫人"},{"id":3921,"word":"乐成人美","pinyin":"lè chéng rén měi","abbr":"lcrm","explanation":"乐于成全人家的好事。","source":{"text":"与余无一日之雅，乃慨然乐成人美。","book":"清·叶廷琯《吹网录·建康集足本》"},"similar":["成人之美"],"usage":"作谓语；指愿意帮助人"},{"id":3922,"word":"乐新厌旧","pinyin":"lè xīn yàn jiù","abbr":"lxyj","explanation":"喜新厌旧。指感情不专一。","source":{"text":"时俗常情，乐新厌旧，有始卒者，其唯圣人。","book":"唐·陆贽《论朝官阙员及刺史等改转伦序状》"},"similar":["喜新厌旧"],"usage":"作谓语、宾语、定语；指感情不专一"},{"id":3923,"word":"乐昌之镜","pinyin":"lè chāng zhī jìng","abbr":"lczj","explanation":"比喻夫妻分离。同“乐昌分镜”。","source":{"text":"一旦事迹彰闻，思情间阻，则乐昌之镜，或恐从此而遂分。","book":"《剪灯新话·联芳楼记》"},"example":{"text":"颇疑其～离而复合，但无显证耳。","book":"清·纪昀《阅微草堂笔记·如是我闻之》"},"similar":["乐昌破镜","乐昌分镜"],"usage":"作宾语、定语；指夫妻分别","story":["南朝陈将要灭亡时，驸马徐德言与妻乐昌公主估计不能相保，就将铜镜一分为二，双方各执一半分开行动，相约于正月十五日当街卖破镜来取得联系。陈朝灭亡，妻没入杨素家。到期，徐德言辗转依约至京，找到卖破镜的妻子，夫妻团聚"]},{"id":3924,"word":"乐昌分镜","pinyin":"lè chāng fēn jìng","abbr":"lcfj","explanation":"比喻夫妻分离。","source":{"text":"受寂寞似越娘背灯，恨离别如乐昌分镜。","book":"元·孙季昌《端正好·四时怨别集杂剧名》"},"example":{"text":"咫尺天涯有如千丈，相思帐由他主张，须道～合徐郎。","book":"明·无名氏《霞笺记·得笺窥认》"},"similar":["乐昌破镜"],"opposite":["破镜重圆"],"usage":"作宾语、定语；指夫妻分别","story":["南朝陈将要灭亡时，驸马徐德言与妻乐昌公主估计不能相保，就将铜镜一分为二，双方各执一半分开行动，相约于正月十五日当街卖破镜来取得联系。陈朝灭亡，妻没入杨素家。到期，徐德言辗转依约至京，找到卖破镜的妻子，夫妻团聚"]},{"id":3925,"word":"乐昌破镜","pinyin":"lè chāng pò jìng","abbr":"lcpj","explanation":"比喻夫妻分离。同“乐昌分镜”","source":{"text":"妾有乐昌破镜之忧，汝兄被缧绁缠身之苦，为虏所掠。","book":"明·冯梦龙《喻世明言》第二十四卷"},"example":{"text":"大抵女子殉夫，其故有二：……一则忍耻偷生，苟延一息，冀～，再得重圆，至望绝势穷，然后一死以明志，此生于情感者也。","book":"清·纪昀《阅微草堂笔记·槐西杂志》"},"similar":["破镜分钗","乐昌之镜","乐昌分镜"],"usage":"作宾语、定语；指夫妻分别","story":["南朝陈将要灭亡时，驸马徐德言与妻乐昌公主估计不能相保，就将铜镜一分为二，双方各执一半分开行动，相约于正月十五日当街卖破镜来取得联系。陈朝灭亡，妻没入杨素家。到期，徐德言辗转依约至京，找到卖破镜的妻子，夫妻团聚"]},{"id":3926,"word":"乐极则忧","pinyin":"lè jí zé yōu","abbr":"ljzy","explanation":"好乐过度而不止，必生忧伤。","source":{"text":"乐极则忧，礼粗则偏矣。","book":"西汉·戴圣《礼记·乐记》"},"similar":["乐极生悲"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":3927,"word":"乐极则悲","pinyin":"lè jí zé bēi","abbr":"ljzb","explanation":"欢乐到了极点，将转而发生悲伤的事。","source":{"text":"酒极则乱，乐极则悲，万事尽然，言不可极，极之而衰。","book":"西汉·司马迁《史记·滑稽列传》"},"example":{"text":"我们应该明白～的道理。"},"similar":["乐极生悲"],"opposite":["乐不可支"],"usage":"作谓语、宾语、定语、分句；用于劝诫人"},{"id":3928,"word":"乐极哀来","pinyin":"lè jí āi lái","abbr":"ljal","explanation":"欢乐到了极点，将转而发生悲伤的事。同“乐极则悲”。","source":{"text":"悲乐极以哀来，终推我而辍音。","book":"晋·陶潜《闲情赋》"},"example":{"text":"玳筵急管曲复终，～月东出。老夫不知其所往，足茧荒山转愁疾。","book":"唐·杜甫《观公孙大娘弟子舞剑器行》诗"},"similar":["乐极哀生","乐极生悲","乐极则悲"],"opposite":["乐而忘返","乐不可支"],"usage":"作谓语、宾语、定语；指高兴到极点就生灾"},{"id":3929,"word":"乐极哀生","pinyin":"lè jí āi shēng","abbr":"ljas","explanation":"乐：快乐。欢乐过度就会招致悲哀的事情。","source":{"text":"有同必异，自昔攸然；乐极哀生，古来常事。","book":"唐·张鷟《游仙窟》"},"similar":["乐极哀来","乐极生悲","乐极悲来"],"opposite":["乐不可支"],"usage":"作谓语、宾语、定语；指高兴到极点就生灾"},{"id":3930,"word":"乐极悲来","pinyin":"lè jí bēi lái","abbr":"ljbl","explanation":"欢乐到了极点，将转而发生悲伤的事。同“乐极则悲”。","source":{"text":"夫有死必有生，有生必形亏。亏盈盛衰，物之常理日中则移，月满则亏。乐极悲来，物盛则衰。有生死是天地人之常数也。","book":"宋·张君房《云笈七签》卷八十三"},"example":{"text":"谁知～，狄公自入京以来，削奸除佞，整理朝纲，全无半刻闲暇，加以年岁高大，精力衰颓，以至积勤成疾。","book":"清·佚名《狄公案》第六十三回"},"similar":["乐极哀来","乐极哀生","乐极生悲"],"usage":"作谓语、宾语、定语；指高兴到极点就生灾"},{"id":3931,"word":"乐极悲生","pinyin":"lè jí bēi shēng","abbr":"ljbs","explanation":"高兴到极点时，发生使人悲伤的事。","source":{"text":"夫物盛而衰，乐极则悲。","book":"《史记·滑稽列传》：“酒极则乱，乐极则悲，万事尽然，言不可极，极之而衰。”《淮南子·道应训》"},"example":{"text":"可正是～，今日个泰来否往。","book":"元·宫大用《范张鸡黍》第四折"},"similar":["乐极生悲"],"opposite":["乐不可支"],"usage":"作谓语、宾语、定语；指高兴到极点就发生使"},{"id":3932,"word":"乐极生哀","pinyin":"lè jí shēng āi","abbr":"ljsa","explanation":"欢乐到了极点，将转而发生悲伤的事。同“乐极则悲”。","source":{"text":"中年后，向歌阑易感，乐极生哀。","book":"宋·刘克庄《沁园春·吴叔永尚书和余旧作再答》词"},"similar":["乐极悲来","乐极生悲"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":3933,"word":"乐极生悲","pinyin":"lè jí shēng bēi","abbr":"ljsb","explanation":"高兴到极点时，发生使人悲伤的事。","source":{"text":"夫物盛而衰，乐极则悲。","book":"《史记·滑稽列传》：“酒极则乱，乐极则悲，万事尽然，言不可极，极之而衰。”《淮南子·道应训》"},"example":{"text":"谁知～，一朝触犯了朝廷，阖门待勘，未知生死。","book":"明·冯梦龙《警世通言》卷十七"},"similar":["否极泰来","物极必反"],"opposite":["乐而忘返","乐不可支"],"usage":"作谓语、宾语、定语；指高兴到极点就生灾","story":["战国时期，齐威王很小就继承了王位，他一味贪图玩乐，在都城临淄建造“稷下”宫，让能言善辩的人陪他聊天。一次楚国侵略齐国，淳于髡凭口才请来赵国救兵解围。齐威王摆酒庆功，淳于髡趁机给他讲乐极生悲的道理，帮他成为明君"]},{"id":3934,"word":"乐此不倦","pinyin":"lè cǐ bù juàn","abbr":"lcbj","explanation":"此：这。因酷爱干某事而不感觉厌烦。形容对某事特别爱好而沉浸其中。","source":{"text":"我自乐此，不为疲也。","book":"《后汉书·光武帝纪》"},"example":{"text":"一种是教人对于职业要发生兴趣，一有兴趣，就无论什么事，都～了。","book":"鲁迅《花边文学·安贫乐道法》"},"similar":["乐此不疲"],"opposite":["心猿意马"],"usage":"作谓语、定语；指特别爱好","story":["东汉光武帝刘秀当上皇帝后，知道百姓不愿意看到战争，就命令全国不准谈论战争，他勤于治理朝政，经常与大臣谈论治国方略，每天均是深夜才睡觉，太子不忍他如此操劳，他则说他自己乐于这样做，并不感到疲劳"]},{"id":3935,"word":"乐此不疲","pinyin":"lè cǐ bù pí","abbr":"lcbp","explanation":"此：这。因酷爱干某事而不感觉厌烦。形容对某事特别爱好而沉浸其中。","source":{"text":"我自乐此，不为疲也。","book":"《后汉书·光武帝纪》"},"example":{"text":"更兼这位老先生，天生又是无论什么疑难，每问必知，据知而答，无答不即详且尽，并且～。","book":"清·文康《儿女英雄传》第三十八回"},"similar":["乐而忘返","专心致志","沉迷不醒"],"opposite":["心猿意马","心不在焉"],"usage":"作谓语、定语；指特别爱好","story":["东汉光武帝刘秀当上皇帝后，知道百姓不愿意看到战争，就命令全国不准谈论战争，他勤于治理朝政，经常与大臣谈论治国方略，每天均是深夜才睡觉，太子不忍他如此操劳，他则说他自己乐于这样做，并不感到疲劳"]},{"id":3936,"word":"乐水乐山","pinyin":"yào shuǐ yào shān","abbr":"lsls","explanation":"乐：喜爱，爱好。有人喜爱山，有人喜爱水。比喻各人的爱好不同。","source":{"text":"知者乐山，仁者乐水。","book":"《论语·雍也》"},"example":{"text":"君乐山，予乐水。～，算来何济。都不如、净意清心，炼冲和真气。","book":"元·马钰《清心镜》词"},"similar":["乐山乐水"],"usage":"作宾语、定语；用于书面语"},{"id":3937,"word":"乐祸不悛","pinyin":"lè huò bù quān","abbr":"lhbq","explanation":"乐：爱好；悛：悔改。好为祸患并坚持不改变。","source":{"text":"其间凶残之党，乐祸不悛，则须敕法以峻刑，诛一以警百。","book":"宋·苏轼《论河北京东盗贼状》"},"example":{"text":"其有暴君，终于不省，～，则有知前之所言者。","book":"清·唐甄《潜书·远谏》"},"usage":"作谓语、定语；用于处事"},{"id":3938,"word":"乐祸幸灾","pinyin":"lè huò xìng zāi","abbr":"lhxz","explanation":"犹言幸灾乐祸。谓以别人的灾祸为乐。","source":{"text":"而攸之始奉国讳，喜见于容，普天同哀，己以为庆。此其乐祸幸灾，大逆之罪一也。","book":"《宋书·沈攸之传》"},"similar":["幸灾乐祸"],"opposite":["兔死狐悲","同病相怜"],"usage":"作谓语、定语、状语；指人缺乏善意"},{"id":3939,"word":"乐而不厌","pinyin":"lè ér bù yàn","abbr":"leby","explanation":"喜爱而不厌倦。","source":{"text":"使其遂至于工，可以乐而不厌。","book":"宋·欧阳修《六一笔记·夏日学书说》"},"usage":"作谓语；用于人或物"},{"id":3940,"word":"乐而不淫","pinyin":"lè ér bù yín","abbr":"leby","explanation":"快乐而不过分。指表现的情感有节制。","source":{"text":"《关雎》乐而不淫，哀而不伤。","book":"春秋·鲁·孔丘《论语·八佾》"},"example":{"text":"忿而不戾，哀而不伤，～，虽诗歌，亦教训也。","book":"鲁迅《汉文学史纲要》第二篇"},"similar":["乐而不荒"],"usage":"作谓语；指表现的情感有节制"},{"id":3941,"word":"乐而不荒","pinyin":"lè ér bù huāng","abbr":"lebh","explanation":"指表现的情感有节制。同“乐而不淫”。","source":{"text":"节之以礼。","book":"《左传·襄公二十七年》：“其余皆数世之主也。子展其后亡者也，在上不忘降。印氏其次也，乐而不荒。”又《襄公二十九年》：“哀而不愁，乐而不荒，用而不匮，广而不宜。”杜预注"},"example":{"text":"南朝·宋·范晔《后汉书·马融传》：“夫～，忧而不困，先王所以平和府藏，颐养精神，致之无疆。”"},"similar":["乐而不淫"],"usage":"作谓语、定语；用于处事"},{"id":3942,"word":"乐而忘归","pinyin":"lè ér wàng guī","abbr":"lewg","explanation":"非常快乐，竟忘记回家。形容沉迷于某种场合，舍不得离开。","source":{"text":"造父以善御幸于周缪王……西巡狩，乐而忘归。","book":"《史记·秦本纪》"},"similar":["乐不思蜀"],"usage":"作谓语；指非常留恋"},{"id":3943,"word":"乐而忘忧","pinyin":"lè ér wàng yōu","abbr":"lewy","explanation":"高兴得忘记了忧愁。","example":{"text":"我们不能～。"},"usage":"作谓语；用于人的情绪"},{"id":3944,"word":"乐而忘死","pinyin":"lè ér wàng sǐ","abbr":"lews","explanation":"形容胸襟旷达，忘怀一切。","source":{"text":"遂居深山之间，积土为室，编蓬为户，弹琴其中，以咏先王之风，亦可以乐而忘死矣。","book":"汉·东方朔《非有先生论》"},"usage":"作谓语、定语；用于处事"},{"id":3945,"word":"乐而忘返","pinyin":"lè ér wàng fǎn","abbr":"lewf","explanation":"非常快乐，竟忘记回家。形容沉迷于某种场合，舍不得离开。","source":{"text":"造父以善御幸于周缪王……西巡狩，乐而忘归。","book":"《史记·秦本纪》第五卷"},"example":{"text":"但凡有可以消遣处，不是十天，就是半月，～。","book":"清·石玉昆《三侠五义》第八十九回"},"similar":["乐不可支","乐不思蜀","流连忘返"],"usage":"作谓语、定语；形容流连忘返"},{"id":3946,"word":"乐育人材","pinyin":"lè yù rén cái","abbr":"lyrc","explanation":"育：培育。喜欢培育人材。用以赞颂学校或教育工作者。","source":{"text":"菁菁者莪，乐育材也。君子能长育人材，则天喜乐之矣。","book":"《诗经·小雅·菁菁者莪·序》"}},{"id":3947,"word":"乐行忧违","pinyin":"lè xíng yōu wéi","abbr":"lxyw","explanation":"指所乐的事就去做，所忧的事则避开。","source":{"text":"乐则行之，忧则违之。","book":"语出《易·干》"},"example":{"text":"不但多用韵，抑且多用偶，即如‘～’，偶也；‘长人合礼’，偶也。","book":"清·阮元《文言说》"},"usage":"作宾语、定语；用于处事"},{"id":3948,"word":"乐贫甘贱","pinyin":"lè pín gān jiàn","abbr":"lpgj","explanation":"甘：甘愿；贱：地位卑贱。乐于贫困的生活，甘于卑贱的地位。","source":{"text":"其次萧洒荜门，乐贫甘贱，抱经济之器，泛若无。","book":"宋·张君房《云笈七签》卷九十三"},"usage":"作谓语、定语、宾语；用于处世"},{"id":3949,"word":"乐退安贫","pinyin":"lè tuì ān pín","abbr":"ltap","explanation":"指乐于逊退，安于贫穷。","source":{"text":"乐退安贫知是分，成家报国亦何惭。","book":"唐·司空图《漫书》诗"},"usage":"作谓语、宾语；指没有竞争意识"},{"id":3950,"word":"乐道好古","pinyin":"lè dào hǎo gǔ","abbr":"ldhg","explanation":"以守道为乐，喜爱古制。","source":{"text":"鲁人有公仪体者，砥节厉行，乐道好古，恬于荣利，不事诸侯。","book":"《孔丛子·公仪》"},"usage":"作谓语、定语；用于处事"},{"id":3951,"word":"乐道安命","pinyin":"lè dào ān mìng","abbr":"ldam","explanation":"乐守正道而安于天命。","source":{"text":"乐守正道而安于天命。"},"similar":["安命乐道","安贫乐道"],"usage":"作谓语、定语；用于处事"},{"id":3952,"word":"乐道安贫","pinyin":"lè dào ān pín","abbr":"ldap","explanation":"道：信念；乐道：以守道为乐；安贫：安于贫困。处在贫困的境地中，仍以守道作乐趣。","source":{"text":"……文博之漱流枕石，铲迹销声；宣子方乐道安贫，弘风阐教：斯并通儒之高尚也。","book":"《晋书·儒林传论》"},"example":{"text":"～巨儒，嗟怨是何如？","book":"明·施惠《幽闺记·士女随迁》"},"similar":["安贫乐道"],"usage":"作谓语、宾语、定语；同“安贫乐道”"},{"id":3953,"word":"乐道忘饥","pinyin":"lè dào wàng jī","abbr":"ldwj","explanation":"指醉心于圣道。","source":{"text":"与君周旋，乐道忘饥。我心虚静，我志沾濡。","book":"《晋书·乐志》"},"usage":"作谓语、定语；用于处事"},{"id":3954,"word":"乐道遗荣","pinyin":"lè dào yí róng","abbr":"ldyr","explanation":"乐守圣贤之道而抛弃荣华富贵。","source":{"text":"盖以二子虽乐道遗荣，安贫守志，而拘忌名教，未免流俗也。","book":"唐·刘知畿《史通·品藻》"},"usage":"作谓语、定语；用于处事"},{"id":3955,"word":"乒乒乓乓","pinyin":"pīng pīng pāng pāng","abbr":"pppp","explanation":"象声词，形容响声。","source":{"text":"乒乒乓乓，如同阵前炮响；轰轰烈烈，却似锣鼓齐鸣。","book":"明·许仲琳《封神演义》第64回"},"example":{"text":"清·荑荻散人《玉娇梨》第14回：“忽听得两面头锣～敲将来，随后就是一对清道蓝旗，许多执事摆列将来。”"},"similar":["叮叮当当"],"usage":"作定语、状语；用于声响"},{"id":3956,"word":"乔太守乱点鸳鸯谱","pinyin":"qiáo tài shǒu luàn diǎn yuān yāng pǔ","abbr":"qtsldyyp","explanation":"鸳鸯：鸟名，比喻夫妻。乔太守审理案件时将错就错，乱点鸳鸯，将三对夫妻相互错配。比喻胡乱指挥。","source":{"text":"今日听在下说一桩意外姻缘的故事，唤做‘乔太守乱点鸳鸯谱’。","book":"明·冯梦龙《醒世恒言》第八卷"},"similar":["乱点鸳鸯谱"],"usage":"作宾语、定语；用于处事等"},{"id":3957,"word":"乔妆打扮","pinyin":"qiáo zhuāng dǎ bàn","abbr":"qzdb","explanation":"指进行伪装，隐藏身份。同“乔装打扮”。","source":{"text":"串店的妓女，乔妆打扮的来给强盗作眼线儿看道儿，不可不防。","book":"清·文康《儿女英雄传》第三回"},"similar":["乔装打扮","乔装改扮"],"usage":"作谓语、定语、状语；指伪装"},{"id":3958,"word":"乔妆改扮","pinyin":"qiáo zhuāng gǎi bàn","abbr":"qzgb","explanation":"乔：做假。乔妆：改变服装、容颜。指化妆改变形象，掩饰本来的身份。亦作“乔装打扮”、“乔装改扮”。","source":{"text":"我今要到十里堡，乔妆改扮访民情。","book":"清·无名氏《刘公案》第12回"},"similar":["乔装改扮"],"usage":"作谓语、宾语、定语、状语；指伪装"},{"id":3959,"word":"乔文假醋","pinyin":"qiáo wén jiǎ cù","abbr":"qwjc","explanation":"指假斯文；假道学。","source":{"text":"兄弟，我见这会稽城市中的人，有穿着那宽衫大袖的乔文假醋，诗云子曰，可不知他读书也不曾。","book":"元·无名氏《渔樵记》第一折"}},{"id":3960,"word":"乔木世家","pinyin":"qiáo mù shì jiā","abbr":"qmsj","explanation":"乔木：代指贵族、高官。指贵族世家。","source":{"text":"伐木丁丁，鸟鸣嘤嘤，出自幽谷，迁于乔木。","book":"《诗经·小雅·伐木》"},"example":{"text":"他出身于～，深喑官场的尔虞我诈。"},"usage":"作宾语、定语；用于树木"},{"id":3961,"word":"乔松之寿","pinyin":"qiáo sōng zhī shòu","abbr":"qszs","explanation":"乔、松：古代传说中的仙人王乔和赤松子。指像仙人那样的长寿。","source":{"text":"大王诚留意如此，则心有尧舜之志，体有乔松之寿。","book":"《史记·范睢蔡泽列传》：“世世称孤，而有许由﹑延陵季子之让，乔松之寿，孰与以祸终哉？”《汉书·王吉传》"},"example":{"text":"必有许由伯夷之廉，享～，永为世辅，岂不美哉？","book":"蔡东藩《两晋演义》第五十三回"},"usage":"作宾语；用于祝福等"},{"id":3962,"word":"乔模乔样","pinyin":"qiáo mú qiáo yàng","abbr":"qmqy","explanation":"乔：假装。装模作样。","source":{"text":"梳个纵鬓头儿，着件叩身衫子；做张做势，乔模乔样。","book":"明·冯梦龙《警世通言》卷三十八"},"example":{"text":"穿一件周正衣服，换一副斯文脸，再～地装个阔公子——你们就认不得自己祖宗了！","book":"二月河《乾隆皇帝》三"},"similar":["装模作样"],"usage":"作宾语、状语；同装模作样"},{"id":3963,"word":"乔装打扮","pinyin":"qiáo zhuāng dǎ bàn","abbr":"qzdb","explanation":"乔装：改变服装、面貌；打扮：指化装。指进行伪装，隐藏身份。","source":{"text":"自己却乔装打扮的，雇了一只小船，带了两个家丁，沿路私访而来。","book":"清·文康《儿女英雄传》第二十三回"},"example":{"text":"我并不出家修道，不过是～，掩人耳目，借着卖药为名，到处访求英雄，以图恢复中国。","book":"清·吴趼人《痛史》第二十三回"},"similar":["改头换面","涂脂抹粉"],"opposite":["本来面目","原形毕露"],"usage":"作谓语、定语、状语；指伪装"},{"id":3964,"word":"乔装改扮","pinyin":"qiáo zhuāng gǎi bàn","abbr":"qzgb","explanation":"乔：改换。指改换服饰以伪装隐瞒身分。","source":{"text":"继而又道：‘来个乔装改扮，分散突围。’","book":"郭澄清《大刀记》第八章"},"example":{"text":"每个国家都应严防他国～的间谍与特务分子的渗透。"},"similar":["乔装打扮","乔妆改扮"],"usage":"作谓语、宾语、定语、状语；指伪装"},{"id":3965,"word":"乔迁之喜","pinyin":"qiáo qiān zhī xǐ","abbr":"qqzx","explanation":"乔迁：鸟儿飞离深谷，迁到高大的树木上去。贺人迁居或贺人官职升迁之辞。","source":{"text":"伐木丁丁。鸟鸣嘤嘤，出自幽谷，迁于乔木。","book":"《诗经·小雅·伐木》"},"example":{"text":"老张～，我们不得不贺。"},"similar":["喜迁新居"],"usage":"作宾语；祝贺别人迁居或升官的话"},{"id":3966,"word":"乔龙画虎","pinyin":"qiáo lóng huà hǔ","abbr":"qlhh","explanation":"形容假心假意地献殷勤。","source":{"text":"他自吃人在他跟前那等花丽胡哨，乔龙画虎，两面三刀哄他，就是千好万好了。","book":"明·兰陵笑笑生《金瓶梅词话》第20回"},"usage":"作谓语、状语；指假心假意地献殷勤"},{"id":3967,"word":"乖僻邪谬","pinyin":"guāi pì xié miù","abbr":"gpxm","explanation":"乖：乖张，不顺；僻：孤僻。指性格古怪孤僻，不近人情。","source":{"text":"其乖僻邪谬不过人情之态，又在千万人之下。","book":"清·曹雪芹《红楼梦》第二回"},"usage":"作谓语、定语；指人的性格"},{"id":3968,"word":"乖唇蜜舌","pinyin":"guāi chún mì shé","abbr":"gcms","explanation":"形容口齿伶俐，惯于说讨人喜欢的甜言蜜语。","source":{"text":"素姐那乖唇蜜舌，又拿着没疼热的东西交结童奶奶这伙子人，不惟不把他可恶。","book":"清·西周生《醒世姻缘传》第100回"},"example":{"text":"你不要相信她的～。"},"similar":["甜言蜜语"],"opposite":["笨嘴拙舌"],"usage":"作宾语、定语；指甜言蜜语"},{"id":3969,"word":"乖嘴蜜舌","pinyin":"guāi zuǐ mì shé","abbr":"gzms","explanation":"形容口齿伶俐，惯于说讨好人的甜言蜜语。","source":{"text":"素姐那乖嘴蜜舌，又拿着没疼热的东西交结童奶奶这伙子人，不惟不把他可恶。","book":"清·西周生《醒世姻缘传》第100回"},"example":{"text":"你不要被她的～所迷惑"},"similar":["乖唇蜜舌"],"usage":"作宾语、定语；指甜言蜜语"},{"id":3970,"word":"乖气致戾，和气致祥","pinyin":"guāi qì zhì lì，hé qì zhì xiáng","abbr":"gqzlhqzx","explanation":"乖：不和谐；戾：罪。指不和招致祸患，和睦带来吉祥。","source":{"text":"想到这里，就令人不能不信‘乖气致戾，和气致祥’这句话了。","book":"清·文康《儿女英雄传》第27回"},"usage":"作宾语、定语；用于口语"},{"id":3971,"word":"乘云行泥","pinyin":"chéng yún xíng ní","abbr":"cyxn","explanation":"比喻地位高下悬殊。","source":{"text":"虽乘云行泥，栖宿不同，每有西风，何尝不叹！","book":"《后汉书·逸民传·矫慎》"},"similar":["云泥之别"],"usage":"作宾语、定语；用于比较"},{"id":3972,"word":"乘人不备","pinyin":"chéng rén bù bèi","abbr":"crbb","explanation":"乘：趁着。趁着别人没有防备干某事。","source":{"text":"这畜生说什么乘人不备逃出来，那全是他一派胡言罢了。","book":"清·无垢道人《八仙全传》第12回"},"example":{"text":"他～拿走了证据。"},"similar":["趁人不备","乘其不备"],"usage":"作谓语、宾语、状语；指偷偷地"},{"id":3973,"word":"乘人之危","pinyin":"chéng rén zhī wēi","abbr":"crzw","explanation":"乘人家危难的时候去威胁损害。","source":{"text":"谋事杀良，非忠也；乘人之危，非仁也。","book":"《后汉书·盖勋传》"},"example":{"text":"那种～，大发横财的人，是缺德的人。"},"similar":["落井下石","乘虚而入"],"opposite":["雪中送炭","济困扶危"],"usage":"作谓语、定语；同“趁人之危”","story":["东汉凉州刺史梁鸿的属官苏正和不畏强权，依法查办武威太守。梁鸿担心会牵连朝廷高官，想杀了苏正和灭口，就找好友盖勋商量对策。虽然盖勋和苏正和是死对头，但他还是认为不能趁别人危难时候去害别人，这是不仁的表现"]},{"id":3974,"word":"乘人之厄","pinyin":"chéng rén zhī è","abbr":"crze","explanation":"乘：趁；厄：苦难。趁人家危难的时候加以要挟或陷害。","source":{"text":"子诚敝人也，不念畴昔之义，而欲乘人之厄，予过矣！","book":"清·蒲松龄《聊斋志异·神女》"},"similar":["乘人之危"],"usage":"作谓语、定语；用于处事"},{"id":3975,"word":"乘伪行诈","pinyin":"chéng wěi xíng zhà","abbr":"cwxz","explanation":"指弄虚作假。","source":{"text":"夫伐功施劳，鲜能布仁；乘伪行诈，莫能久长。","book":"汉·刘向《列女传·晋范氏母》"},"example":{"text":"～的行为不光彩。"},"similar":["弄虚作假"],"usage":"作谓语、宾语；指欺骗"},{"id":3976,"word":"乘兴而来","pinyin":"chéng xìng ér lái","abbr":"cxel","explanation":"乘：趁，因；兴：兴致，兴趣。趁着兴致来到，结果很扫兴的回去。","source":{"text":"人问其故，徽之曰：‘本乘兴而来，兴尽而反，何心见安道邪？’","book":"《晋书·王徽之传》"},"example":{"text":"正是：～，败兴而返。","book":"明·冯梦龙《东周列国志》第一回"},"opposite":["败兴而归"],"usage":"作谓语；常与“败兴而归”连用","story":["东晋大书法家王羲之的儿子王徽之生性高傲，行为豪放不拘，他辞官隐居在山阴，天天游山玩水，饮酒吟诗。在一个雪后月夜里，他喝酒赏景觉得少了琴声，就命仆人开船连夜赶往戴逵处，拂晓时却说自己只是兴起才来，不必见面了"]},{"id":3977,"word":"乘兴而来，兴尽而返","pinyin":"chéng xìng ér lái，xìng jìn ér fǎn","abbr":"cxelxjef","explanation":"兴：兴致，高兴。趁着当时的兴致而来，兴致满足了就返回。指兴致融景而产生，又随兴致被破坏而改变最初的想法。","source":{"text":"吾本乘兴而来，兴尽而反，何必见戴？’","book":"晋·裴启《裴子语林》卷二"}},{"id":3978,"word":"乘兴而来，败兴而归","pinyin":"chéng xìng ér lái，bài xìng ér guī","abbr":"cxelbxeg","explanation":"兴：兴致，兴趣。趁着兴致来到，结果很扫兴的回去。","source":{"text":"人问其故，徽之曰：‘本乘兴而来，兴尽而反，何必见安道邪？’","book":"《晋书·王徽之传》"},"example":{"text":"张怀芝偕冯同至济南，中途告别，冯总统～，自回北京去了。","book":"蔡东藩、许廑父《民国通俗演义》第九十一回"},"similar":["乘兴而来，败兴而返"],"usage":"作谓语、定语；用于做事","story":["东晋大书法家王羲之的儿子王徽之生性高傲，行为豪放不拘，他辞官隐居在山阴，天天游山玩水，饮酒吟诗。在一个雪后月夜里，他喝酒赏景觉得少了琴声，就命仆人开船连夜赶往戴逵处，拂晓时却说自己只是兴起才来，现在兴致没了就该回去"]},{"id":3979,"word":"乘兴而来，败兴而返","pinyin":"chéng xìng ér lái，bài xìng ér fǎn","abbr":"cxelbxef","explanation":"兴：兴致，兴趣。趁着兴致来到，结果很扫兴地回去。","source":{"text":"霁云乘兴而来，败兴而返，怏怏的带马出城。","book":"清·褚人获《隋唐演义》第89回"},"similar":["乘兴而来，败兴而归"],"usage":"作谓语、定语；用于做事"},{"id":3980,"word":"乘其不备","pinyin":"chéng qí bù bèi","abbr":"cqbb","explanation":"乘：趁。利用别人没有防备的时机，去侵害对方。","source":{"text":"我乘其不备而更追之，故能胜也。","book":"明·罗贯中《三国演义》第十八回"},"example":{"text":"～的战术往往能取胜。"},"similar":["乘其不意"],"usage":"作宾语、定语、状语；指趁人没有防备时动手"},{"id":3981,"word":"乘其不意","pinyin":"chéng qí bù yì","abbr":"cqby","explanation":"乘：趁，因；意：猜想，意料。利用别人没有防备的时机动手。","source":{"text":"敌谓我不能逆风以战，宜乘其不意，急击之，此兵之诡道也。","book":"《新编五代史平话·晋史》"},"example":{"text":"我们要～打击敌人。"},"similar":["乘人不备"],"usage":"作宾语、状语；指趁对方没有想到的时候动手"},{"id":3982,"word":"乘利席胜","pinyin":"chéng lì xí shèng","abbr":"clxs","explanation":"凭借着胜利的形势。","source":{"text":"席，因也，若人之在席上。","book":"《汉书·蒯通传》：“楚人起彭城转斗逐北，至荥阳乘利席胜，威震天下。”颜师古注"},"usage":"作谓语；用于书面语"},{"id":3983,"word":"乘势使气","pinyin":"chéng shì shǐ qì","abbr":"cssq","explanation":"仗势逞性子。","source":{"text":"其间窃官爵，盗财贿，乘势使气为朝野之患者，何可胜举。","book":"《魏书·阉官传序》"},"similar":["仗势欺人"],"usage":"作谓语、宾语；用于为人"},{"id":3984,"word":"乘坚伺隙","pinyin":"chéng jiān sì xì","abbr":"cjsx","explanation":"钻空子等待时机。","source":{"text":"分任授职，乘间伺隙，兵不妄动，故战少败而江南安。","book":"晋·傅玄《傅子》"}},{"id":3985,"word":"乘坚策肥","pinyin":"chéng jiān cè féi","abbr":"cjcf","explanation":"坚：坚固的车子；策：鞭打；肥：肥壮的马。坐牢固的车，驾肥壮的马。形容生活豪华。","source":{"text":"乘坚策肥，履丝曳缟。","book":"东汉·班固《汉书·食货志上》"},"example":{"text":"若夫膏粱之子，生而多金，～，自快其意。","book":"清·章炳麟《人无我论》"},"similar":["乘坚驱良","乘轻驱肥"],"usage":"作谓语、定语；形容生活奢华"},{"id":3986,"word":"乘坚驱良","pinyin":"chéng jiān qū liáng","abbr":"cjql","explanation":"坚：坚固的车子；良：好马。坐牢固的车，驾肥壮的马。形容生活豪华。","source":{"text":"至于少弟者，生而见我富，乘坚驱良逐狡兔，岂知财所从来，故轻弃之，非所惜吝。","book":"《史记·越王勾践世家》"},"example":{"text":"今末世贵戚食禄之家，温衣美饭，～。","book":"《后汉书·和熹邓皇后纪》"},"similar":["乘坚策肥"],"usage":"作谓语、定语；形容生活奢华"},{"id":3987,"word":"乘敌不虞","pinyin":"chéng dí bù yú","abbr":"cdby","explanation":"虞：料想。军事上指乘敌人懈怠，采取某种敌人预料不到的行动。","source":{"text":"兵者，机之行之者也。……速者乘彼不虞。","book":"《草庐经略》"}},{"id":3988,"word":"乘敌之隙","pinyin":"héng dí zhī xī","abbr":"cdzx","explanation":"乘：趁，利用；隙：空子，机会。","source":{"text":"自古无不犯错误的将军，敌人这有岔子可寻，正如我们自己也难免出岔子，乘敌之隙的可能性是存在的。","book":"毛泽东《论持久战》"},"usage":"作谓语、定语；用于战争或斗争等"},{"id":3989,"word":"乘时乘势","pinyin":"chéng shí chéng shì","abbr":"cscs","explanation":"旧指人应趁着机会、时势，做一番事业。","source":{"text":"虽有智慧，不如乘势，虽有鎡基，不如待时。","book":"战国·邹·孟轲《孟子·公孙丑上》"},"example":{"text":"年青人要～、不失时机地成就大业。"},"usage":"作宾语、状语；指利用好时机"},{"id":3990,"word":"乘机应变","pinyin":"chéng jī yìng biàn","abbr":"cjyb","explanation":"随着时机或情况而变化。形容灵活机敏。","source":{"text":"乘机应变，料难逃漫天圈套，管教似探囊取寄，使人绝倒。","book":"明·许自昌《水浒记·谋成》"},"similar":["随机而变","临机应变"],"usage":"作谓语、宾语；用于处事"},{"id":3991,"word":"乘机打劫","pinyin":"chéng jī dǎ jié","abbr":"cjdj","explanation":"指利用机会掠夺钱财。","source":{"text":"以致文选职方，乘机打劫。","book":"明·王思任《诛马士英疏》"},"example":{"text":"你不能～国有财产。"},"similar":["趁火打劫"],"usage":"作谓语、宾语；用于处事"},{"id":3992,"word":"乘桴浮海","pinyin":"chéng fú fú hǎi","abbr":"cffh","explanation":"桴：用竹、木编结成的小筏子。坐在小木排上在海上漂浮。指隐逸。","source":{"text":"子曰：‘道不行，乘桴浮于海，从我者其由欤？","book":"《论语·公冶长》"},"usage":"作谓语、定语；指远行"},{"id":3993,"word":"乘热打铁","pinyin":"chéng rè dǎ tiě","abbr":"crdt","explanation":"比喻做事抓紧时机，加速进行。","source":{"text":"他觉得老大实在有可爱的地方；于是，他决定乘热打铁，把话都说净。","book":"老舍《四世同堂》"},"example":{"text":"做事就要～。"},"similar":["趁热打铁"],"usage":"作宾语、定语；同“趁热打铁”"},{"id":3994,"word":"乘疑可间","pinyin":"chéng yí kě jiàn","abbr":"cykj","explanation":"乘：利用；间：离间。利用对方的猜疑，可以离间其内部关系。","source":{"text":"乘疑可间，乘劳可攻。","book":"《投笔肤谈·达权》"},"usage":"作谓语、定语；多用于军事或处事"},{"id":3995,"word":"乘肥衣轻","pinyin":"chéng féi yì qīng","abbr":"cfyq","explanation":"肥：肥壮的马。衣：穿。轻：轻暖的裘衣。驾驭肥壮的马，穿着贵重的衣服。形容生活奢侈豪华。","source":{"text":"钟会，名公子，以才能贵幸，乘肥衣轻，宾从如云。","book":"《论语·雍也》：“赤之适齐也，乘肥马，衣轻裘。”《三国志·魏书·王粲传》裴松之注引《魏氏春秋》"},"example":{"text":"未受梁王舍释之旨，～，非敢闻命。","book":"《旧五代史·梁书·刘鄩传》"},"similar":["乘肥衣裘"],"usage":"作谓语、定语；指生活豪华"},{"id":3996,"word":"乘胜追击","pinyin":"chéng shèng zhuī jī","abbr":"cszj","explanation":"乘：趁着。趁着胜利的形势继续追击敌人，扩大战果。","source":{"text":"魏军既败，韩军自溃，乘胜逐北，以是之故能立功。","book":"《战国策·中山策》"},"example":{"text":"李思安跃马交斗，经二十余合，思安拽枪徉败，退去。单可及～。","book":"《新编五代史评话·梁史卷上》"},"similar":["乘胜逐北"],"usage":"作谓语、宾语；指扩大战果"},{"id":3997,"word":"乘胜逐北","pinyin":"chéng shèng zhú běi","abbr":"cszb","explanation":"乘：趁，因；北：败。指乘着胜利继续追击。","source":{"text":"魏军既败，韩军自溃，乘胜逐北，以是之故能立功。","book":"西汉·刘向《战国策·中山策》"},"example":{"text":"我也想～，但力不从心。"},"similar":["乘胜追击"],"usage":"作谓语、宾语；指乘胜追击","story":["秦昭王56年，秦国国君秦昭王不听大将白起的劝阻，派五校大夫王陵率兵攻打赵国，惨败而归，昭王派应侯范雎去请白起去带兵，白起给范雎讲赵国的局势变了，不是他不想乘胜追击，而是此刻不宜进攻。昭王不听，结果无功而返"]},{"id":3998,"word":"乘舆播越","pinyin":"chéng yú bō yuè","abbr":"cyby","explanation":"乘舆：帝王乘坐的车；播越：离散，流亡。指帝王流亡在外。","source":{"text":"慕容垂为封豕于关东，泓冲继凶于京邑，致乘舆播越，宗社沦倾。","book":"《晋书·苻丕载记》"},"similar":["乘舆播迁"],"usage":"作谓语、宾语、定语；指帝王流亡"},{"id":3999,"word":"乘舆播迁","pinyin":"chéng yú bō qiān","abbr":"cybq","explanation":"乘舆：帝王坐的车。指帝王流亡在外。","source":{"text":"向使乘舆播迁，奸党犹在，国之安危未可知。","book":"《明史·王竑传》"},"similar":["乘舆播越"],"usage":"作谓语、宾语、定语；指帝王流亡"},{"id":4000,"word":"乘虚以入","pinyin":"chéng xū yǐ rù","abbr":"cxyr","explanation":"乘：趁着；虚：空隙，弱点。趁着空隙或无人防范而进入。","source":{"text":"宋卫间郑师之在外而乘虚以入其国。","book":"明·刘基《春秋明经》"},"example":{"text":"即伪孔《传》亦乘马郑支离臆说之极弊而～者。","book":"清·魏源《例言中》"},"similar":["乘虚而入"],"usage":"作谓语、定语；多用于军事或处事"},{"id":4001,"word":"乘虚可惊","pinyin":"chéng xū kě jīng","abbr":"cxkj","explanation":"乘：趁着；惊：惊吓。趁敌人空虚可以恫吓他。","source":{"text":"乘分可图，乘虚可惊，乘乱可取。","book":"《投笔肤谈·达权》"},"usage":"作谓语；用于战争或处事等"},{"id":4002,"word":"乘虚而入","pinyin":"chéng xū ér rù","abbr":"cxer","explanation":"乘：趁。趁着虚弱疏漏的地方进入。","source":{"text":"将至所居，自后垣乘虚而入，径及庭中。","book":"宋·张君房《去笈七签》卷一二０"},"example":{"text":"若各存意见，不能和睦，是自己先孤了，别人安得不～。","book":"清·李汝珍《镜花缘》第七十四回"},"similar":["有隙可乘","乘人之危"],"opposite":["坐失良机","无隙可乘"],"usage":"作谓语；多用于军事","story":["公元817年，唐宪宗任命智勇双全的大将李愬为唐河三州节度使进攻叛乱的淮西节度使的儿子吴元济，先后收服降将丁士良、李佑、李忠义等人，然后乘虚而入趁敌没有防备时进入蔡州，活捉了吴元济，平息了叛乱"]},{"id":4003,"word":"乘虚蹈隙","pinyin":"chéng xū dǎo xì","abbr":"cxdx","explanation":"犹言切中窾窍。比喻叩击中节。","source":{"text":"黄龙举起磬击子来，在磬上铿铿锵锵的乱击，协律谐声，乘虚蹈隙。","book":"《老残游记》第十回"},"similar":["击中要害"],"opposite":["不着边际"],"usage":"作谓语、定语；用于处事"},{"id":4004,"word":"乘虚迭出","pinyin":"chéng xū dié chū","abbr":"cxdc","explanation":"虚：空虚、弱点。迭：屡次。指军事上向对方没有设防或兵力薄弱的地方进攻。","source":{"text":"分为奇兵，乘虚迭出，以扰河南。","book":"《三国志·袁绍传》"},"usage":"作谓语、定语；多用于军事"},{"id":4005,"word":"乘车入鼠穴","pinyin":"chéng chē rù shǔ xué","abbr":"ccrsx","explanation":"坐车进入老鼠洞。比喻不合情理，无法办到的事。","source":{"text":"未尝梦乘车入鼠穴，捣齑噉铁杵，皆无想无因故也。","book":"南朝·宋刘义庆《世说新语·文学》"},"usage":"作宾语、定语；用于不能办到的事"},{"id":4006,"word":"乘车戴笠","pinyin":"chéng chē dài lì","abbr":"ccdl","explanation":"乘：坐，驾；笠：斗笠。比喻不因为富贵而改变贫贱之交。","source":{"text":"卿虽乘车我戴笠，后日相逢下车揖；我步行，君乘马，他日相逢君当下。","book":"晋·周处《风土记》"},"example":{"text":"昔楚人始交，必有～不忘相揖之誓，诚以为富贵不相忘之难也。","book":"唐·元稹《酬东川李相公十六韵启》"},"similar":["贫贱之交"],"usage":"作谓语、定语；形容友谊深厚","story":["传说古代苏越一带风俗淳朴，凡初次同人交往，就封土坛，拿出鸡犬等作为祭品，向天祷告说：“卿虽乘车我戴笠，后日相逢下车揖；我步行，君乘马，他日相逢君当下。”希望以后再次见面时不分地位变化，还是不望这贫贱之交"]},{"id":4007,"word":"乘轻驱肥","pinyin":"chéng qīng qū féi","abbr":"cqqf","explanation":"乘好车，驱良马。形容生活奢华。","source":{"text":"古者大夫乃不徒行，今之贱隶乘轻驱肥。","book":"《晋书·傅咸传》"},"similar":["乘坚策肥"],"usage":"作谓语、定语；形容生活奢华"},{"id":4008,"word":"乘酒假气","pinyin":"chéng jjǔ jiǎ qì","abbr":"cjjq","explanation":"乘：就着；假：利用。借着酒醉的气势。","source":{"text":"乘酒假气，将迫于人，岂近直哉。","book":"唐·李朝威《柳毅传》"}},{"id":4009,"word":"乘间伺隙","pinyin":"chéng jiàn sì xì","abbr":"cjsx","explanation":"利用空隙或漏洞以等待机会。","source":{"text":"分任授职，乘间伺隙，兵不妄动，故战少败而江南安。","book":"晋·傅玄《傅子》"},"example":{"text":"陛下初揽政事，乃小人～之时也。","book":"宋·范祖禹《论听政》"},"similar":["乘间抵隙"],"usage":"作谓语、定语；指钻空子"},{"id":4010,"word":"乘间作祸","pinyin":"chéng jiàn zuò huò","abbr":"cjzh","explanation":"趁机会干坏事。"},{"id":4011,"word":"乘间击瑕","pinyin":"chéng jiàn jī xiá","abbr":"cjjx","explanation":"乘：趁，利用；间：间隙；瑕：空隙。钻空子，打击对方薄弱的地方。","source":{"text":"坚壁清野以为体，乘间击瑕以为用，战虽不足，守则有余。","book":"《历代名将言行录》卷二十八"}},{"id":4012,"word":"乘间取利","pinyin":"chéng jiàn qǔ lì","abbr":"cjql","explanation":"乘：利用；间：空隙。利用对方力量薄弱的地方袭击取胜。","source":{"text":"伺敌之隙，乘间取利。","book":"《草庐经略·游兵》"}},{"id":4013,"word":"乘间投隙","pinyin":"chéng jiān tóu xì","abbr":"cjtx","explanation":"乘机挑拨离间。","source":{"text":"然而特怵于天下之士不乐于吾之说，故切切然议之，遂使小人乘间投隙，持一偏可喜之论以媒己私利。","book":"宋·辛弃疾《九议之一》"},"example":{"text":"万一防闲阔略，不幸有李园，吕不韦之徒～，岂细故哉。","book":"清·张廷玉《明史·徐文华传》"},"similar":["挑拨离间"],"usage":"作谓语、宾语；指挑拨离间"},{"id":4014,"word":"乘间抵隙","pinyin":"chéng jiān dǐ xì","abbr":"cjdx","explanation":"指趁机钻空子。","source":{"text":"于是浮浪之士，失职这徒，乘间抵隙。","book":"清·黄遵宪《驳革命书》"},"example":{"text":"他们暗藏于抗战阵营中，～，便利私图，呼朋引类，施其魔力。","book":"《中共中央为纪念抗战两周年对时局的宣言》"},"similar":["乘间伺隙"],"usage":"作谓语、定语；指钻空子"},{"id":4015,"word":"乘险抵巇","pinyin":"chéng xiǎn dǐ xī","abbr":"cxdx","explanation":"冒险钻空子。巇，多指（山岭）险恶、险峻。","source":{"text":"《新唐书·刘栖楚传》：“然其性诡激，敢为怪行，乘险抵巇，若无顾藉。‘"},"usage":"作谓语、宾语；用于处事"},{"id":4016,"word":"乘隙捣虚","pinyin":"chéng xì dǎo xū","abbr":"cxdx","explanation":"趁空子，攻虚弱。","source":{"text":"恐乘隙捣虚，瑕者毕坚，而胜负之势未可料也。","book":"金·王若虚《送王士衡赴举序》"},"usage":"作谓语、宾语；用于战争或处事"},{"id":4017,"word":"乘隙而入","pinyin":"chéng xì ér rù","abbr":"cxer","explanation":"趁着虚弱疏漏的地方进入。","source":{"text":"间不自入，乘隙而入。","book":"明·刘基《郁离子·麋虎》"},"example":{"text":"我们要严加防范，防止敌人～。"},"similar":["乘虚而入","趁虚而入"],"usage":"作谓语；同“乘虚而入”"},{"id":4018,"word":"乘顺水船","pinyin":"chéng shùn shuǐ chuán","abbr":"cssc","explanation":"比喻顺势行事。","source":{"text":"他那神气似真非真，因为是师长的老部属，平时又会逢场作趣，这时节乘顺水船就来那么一手。","book":"沈从文《八骏图·顾问官》"}},{"id":4019,"word":"乘风兴浪","pinyin":"chéng fēng xīng làng","abbr":"cfxl","explanation":"比喻趁机挑起事端。","source":{"text":"吴监督子登闻之，遂又乘风兴浪，思设法以破坏此留学事务所。","book":"清·容闳《西学东渐记》第十九章"},"similar":["兴风作浪"],"usage":"作谓语、宾语；用于好事者"},{"id":4020,"word":"乘风破浪","pinyin":"chéng fēng pò làng","abbr":"cfpl","explanation":"船只乘着风势破浪前进。比喻排除困难，奋勇前进。","source":{"text":"悫年少时，炳问其志，悫曰：‘愿乘长风破万里浪。’","book":"《宋书·宗悫传》"},"example":{"text":"轮船在～，汽车在驶过原野。","book":"茅盾《子夜》五"},"similar":["披荆斩棘","高歌猛进"],"opposite":["裹足不前","垂头丧气"],"usage":"作谓语、定语；形容事业迅速发展","story":["南朝宋国著名将领宗悫从小就有雄心壮志，喜欢舞枪弄剑，他的叔父宗炳问他的志向，他回答说：“愿乘长风破万里浪！”，后来他带兵攻打林邑国，运用计谋取胜，被封为左卫将军"]},{"id":4021,"word":"乘风转舵","pinyin":"chéng fēng zhuǎn duò","abbr":"cfzd","explanation":"比喻顺随情势改变态度。","source":{"text":"投机主义蜊是最善于乘风转舵的。","book":"邹韬奋《萍踪忆语》二一"},"similar":["见风转舵","看风转舵"],"usage":"作谓语、宾语；用于处事"},{"id":4022,"word":"乘高决水","pinyin":"chéng gāo jué shuǐ","abbr":"cgjs","explanation":"凭借地势居高临下，决口放水。比喻费力小，收效大。","source":{"text":"陛下诚能行此二者……后日之政，如顺风吹毛，乘高决水，可以不劳而成功者。","book":"宋·司马光《言为治所先上殿札子》"},"usage":"作宾语、定语；用于处事"},{"id":4023,"word":"乘高居险","pinyin":"chéng gāo jū xiǎn","abbr":"cgjx","explanation":"居：占据。占据高峻、险要的地势。","source":{"text":"倘若交锋，不宜浪战，须乘高居险，出奇匿伏。","book":"《草庐经略·守险》"}},{"id":4024,"word":"乘鸾跨凤","pinyin":"chéng luán kuà fèng","abbr":"clkf","explanation":"乘鸾：求得佳偶。比喻结成美好的佳偶。","source":{"text":"只留下伊行笔踪就不怕事成空，准备着乘鸾跨凤。","book":"清·李渔《慎鸾交·债饵》"},"example":{"text":"他们果然有～缘。"},"similar":["乘鸾配凤"],"usage":"作谓语、定语；指结合"},{"id":4025,"word":"乘龙佳婿","pinyin":"chéng lóng jiā xù","abbr":"cljx","explanation":"乘龙：女子乘坐于龙上得道成仙。佳婿：称意的女婿。旧时指才貌双全的女婿。也用作誉称别人的女婿。","source":{"text":"黄尚为司徒，与李元礼俱娶太尉桓温女，时人谓桓叔元两女俱乘龙，言得婿如龙也。","book":"唐·徐坚《初学记·鳞介部》"},"example":{"text":"我有你这样一位坦腹东床的～，我是光荣得很啦。","book":"郭沫若《南冠草》第三幕"},"similar":["乘龙快婿"],"usage":"作主语、宾语；称赞别人的女婿"},{"id":4026,"word":"乘龙快婿","pinyin":"chéng lóng kuài xù","abbr":"clkx","explanation":"乘龙：女子乘坐于龙上得道成仙。快婿：称意的女婿。旧时指才貌双全的女婿。也用作誉称别人的女婿。","source":{"text":"……昞遂奋衣来坐，神志肃然，曰：‘向闻先生欲求快女婿，昞其人也。’瑀遂以女妻之。","book":"《魏书·刘昞传》"},"example":{"text":"待做这～，骐骥才郎，少的驷马高车。","book":"·汤显祖《紫钗记·回求仆马》"},"similar":["骐骥才郎","乘龙贵婿"],"usage":"作主语、宾语；称赞别人的女婿","story":["春秋时期，秦穆公嬴任好的女儿爱上善于吹箫的箫史，就跟他学起吹箫来。秦穆公成全了他们，为他们建立一座凤台。弄玉很快学会了吹箫，他们在凤台吹箫，引来了凤凰前来倾听，并伴着乐声飞舞。后来箫史乘龙飞去，弄玉也乘凤飞去"]},{"id":4027,"word":"乘龙贵婿","pinyin":"chéng lóng guì xù","abbr":"clgx","explanation":"对别人的女婿的称赞。","source":{"text":"你是老爷跟马贱人，敢辱我乘龙贵婿，打不的你？","book":"明·汤显祖《还魂记·闹宴》"},"similar":["乘龙快婿","乘龙佳婿"],"usage":"作主语、宾语；称赞别人的女婿"},{"id":4028,"word":"乘龙配凤","pinyin":"chéng lóng pèi fèng","abbr":"clpf","explanation":"比喻得佳偶，结良缘。","source":{"text":"沈文素呀！沈文素！你蟾宫折桂，莫大还有乘龙配凤的好运么？","book":"柳琴戏《状元打更》"},"usage":"作宾语、定语；用于口语"},{"id":4029,"word":"乜斜缠帐","pinyin":"niè xié chán zhàng","abbr":"nxcz","explanation":"假作痴呆，纠缠不休。"},{"id":4030,"word":"九世之仇","pinyin":"jiǔ shì zhī chóu","abbr":"jszc","explanation":"九世：九代，形容历时久远。指久远的深仇。","source":{"text":"九世犹可以复仇乎？虽百世可也。","book":"《公羊传·庄公四年》"},"example":{"text":"～，百年之德，至于今而始报之子孙，即报者亦不知其所以。","book":"章炳麟《菌说》"},"similar":["不共戴天"],"opposite":["百年之德"],"usage":"作宾语；指久远的深仇","story":["春秋时期，诸侯齐国国王齐哀公因为诸侯国纪国国王纪侯向周朝天子进谗言，被周天子处死。齐国的后代国君一直牢记这个仇恨，直到哀公后代的第9位君主齐襄公出兵攻打纪国，并消灭纪国，报了这个九世之仇"]},{"id":4031,"word":"九世同居","pinyin":"jiǔ shì tóng jū","abbr":"jstj","explanation":"九世：九代。九代人居住在一起不分家。","source":{"text":"张公艺九世同居，北齐东安王永乐、隋大使梁子恭躬慰抚，表其门。","book":"《新唐书·孝友传序》"},"example":{"text":"乾隆中，巡抚何裕成言天笃九世同居，高宗赐以诗，赉镪帛，表宅里。","book":"《清史稿·任天笃传》"},"similar":["四世同堂"],"usage":"作谓语、宾语、定语；用于大家庭"},{"id":4032,"word":"九九归一","pinyin":"jiǔ jiǔ guī yī","abbr":"jjgy","explanation":"归根到底。","source":{"text":"我这个糟老头子捡点破烂，虽说有点霸道，九九归一，也是生活逼的。","book":"秦兆阳《回答》"},"example":{"text":"我也一直捉摸着这个事儿，～，是没有找到一条成功的路。","book":"《万山红遍》"},"similar":["九九归原","归根到底"],"usage":"作分句；指归根到底"},{"id":4033,"word":"九九归原","pinyin":"jiǔ jiǔ guī yuán","abbr":"jjgy","explanation":"犹言归根到底。归结到根本上。","source":{"text":"九九归原，他们的目的，总不外乎一个翰林学士的头衔。","book":"郁达夫《采石矶》"},"example":{"text":"郁达夫《采石矶》：“～，他们的目的，总不外乎一个翰林学士的头衔。”"},"similar":["九九归一"],"usage":"作分句；指归根到底"},{"id":4034,"word":"九五之位","pinyin":"jiǔ wǔ zhī wèi","abbr":"jwzw","explanation":"九五：指帝位。指帝王的尊位。","source":{"text":"夫或跃在渊者，终飨九五之位。","book":"《宋书·武帝纪》"},"similar":["九五之尊"],"usage":"作宾语；指帝王的尊位"},{"id":4035,"word":"九五之尊","pinyin":"jiǔ wǔ zhī zūn","abbr":"jwzz","explanation":"九五：指帝位。旧指帝王的尊位。","source":{"text":"九五，飞龙在天，利见大人。","book":"《周易·乾》"},"example":{"text":"接成汤之胤，位～，承帝王之统。","book":"明·许仲琳《封神演义》第六十三回"},"similar":["九五之位"],"usage":"作宾语；指帝王的尊位"},{"id":4036,"word":"九仞一篑","pinyin":"jiǔ rèn yī kuì","abbr":"jryk","explanation":"“为山九仞，功亏一篑”的略语。比喻功败垂成。","source":{"text":"为山九仞，功亏一篑。","book":"《尚书·旅獒》"},"example":{"text":"～，殿下宁不自爱乎？","book":"明·张煌言《上延平王书》"},"similar":["功败垂成","功亏一篑"],"usage":"作宾语、定语；用于比喻句"},{"id":4037,"word":"九儒十丐","pinyin":"jiǔ rú shí gài","abbr":"jrsg","explanation":"儒：旧指读书人。元代统治者把人分为十等，读书人列为九等，居于末等的乞丐之上。后指知识分子受到歧视和苛待。","source":{"text":"七匠八娼九儒十丐，后之者，贱之也。","book":"元·谢枋得《谢叠山集·送方伯载三山序》"},"example":{"text":"一官、二吏、三僧、四道、五医、六工、七猎、八民、九儒、十丐。","book":"清·赵翼《陔余丛考》"},"usage":"作宾语、定语；指下等人"},{"id":4038,"word":"九关虎豹","pinyin":"jiǔ guān hǔ bào","abbr":"jghb","explanation":"比喻凶残的权臣。","source":{"text":"功名事，不信朝鳞暮羽。九关虎豹如许。","book":"语出《楚辞·招魂》：“虎豹九关，啄害下人些。”宋·赵癯斋《买陂塘（闻掀髯）》词"},"example":{"text":"不见～虓且噬，浮云遮日孰为怯？","book":"清·陈梦雷《行路难》诗"},"similar":["九阍虎豹"],"usage":"作主语、宾语、定语；指凶恶的人","story":["战国时期，屈原被楚怀王流放。楚怀王死于秦人之手，他作《招魂》以示哀悼：楚王的魂魄快回来，不要上天庭去，上天庭要过九重门，每一重门都有虎豹把守，它们是凶狠吃人的东西，真是太危险了，你还是回来吧"]},{"id":4039,"word":"九十其仪","pinyin":"jiǔ shí qí yí","abbr":"jsqy","explanation":"九、十：虚数，形容多；仪：仪表。旧时指女子出嫁时，父母反复叮咛要注意仪容举止。指礼仪非常多。也指夸奖新妇的仪态很美。","source":{"text":"之子于归，皇驳其马，亲结其缡，九十其仪。","book":"《诗经·豳风·东山》"}},{"id":4040,"word":"九十春光","pinyin":"jiǔ shí chūn guāng","abbr":"jscg","explanation":"九十：指春季三个月，共九十天。指春天的美好光景。","source":{"text":"九十春光在何处？古人今人留不住。","book":"南唐·陈陶《春归去》"},"example":{"text":"～如闪电，触目垂慈，便觉阳和转。","book":"清·褚人获《隋唐演义》第六十八回"},"usage":"作主语、宾语、定语；用于书面语"},{"id":4041,"word":"九原之下","pinyin":"jiǔ yuán zhī xià","abbr":"jyzx","explanation":"九原：山名，春秋时晋国卿大夫的墓地。泛指墓地。","source":{"text":"有志之士，望古遥集。无由起其人于九原之下。","book":"《吕祖全书序》"},"example":{"text":"非妃子不遇朕，是朕生来的缘悭。妃子九原之下，慎勿怨朕。","book":"清·褚人获《隋唐演义》第二十八回"},"similar":["九泉之下"],"usage":"作宾语；形容人死后在地下的用语"},{"id":4042,"word":"九原可作","pinyin":"jiǔ yuán kě zuò","abbr":"jykz","explanation":"九原：春秋时晋国卿大夫的墓地在九原，因称墓地；作：起，兴起。设想死者再生。","source":{"text":"赵文子与叔向游于九原，曰：‘死者若可作也，吾谁与归？’","book":"《国语·晋语八》"},"example":{"text":"盖晋武帝称“安得诸葛亮者而与之共治”，正使～，盍亦思所以用之。","book":"宋·陈亮《英豪录序》"},"usage":"作宾语；指死而复生"},{"id":4043,"word":"九变十化","pinyin":"jiǔ biàn shí huà","abbr":"jbsh","explanation":"指变化多端。","source":{"text":"至如三奔三景之妙，九变十化之精，各探其门，互称要妙。","book":"宋·张君房《序》"},"similar":["变幻无穷"],"opposite":["一成不变"],"usage":"作宾语、定语；指变化多"},{"id":4044,"word":"九合一匡","pinyin":"jiǔ hé yī kuāng","abbr":"jhyk","explanation":"原指春秋时齐桓公多次会合诸侯，称霸主，使混乱的政局得以安定。后用以形容有卓越的治国才能。","source":{"text":"昔得管仲相齐桓，霸诸侯，有九合一匡之功。","book":"《论语·宪问》：“桓公九合诸侯。”又：“管仲相桓公，霸诸侯，一匡天下。”《史记·主父偃列传》"},"example":{"text":"仲之～，泽被当时而垂后世，亦如反唐之功，赎过而有余也。","book":"明·袾宏《直道录·冯道（二）》"},"usage":"作定语；用于书面语"},{"id":4045,"word":"九品中正","pinyin":"jiǔ pǐn zhōng zhèng","abbr":"jpzz","explanation":"指中国古代魏、晋、南北朝维护世族特权的官吏选拔制度。代指等级制度。","source":{"text":"至于中正九品，上圣古贤皆所不为，岂蔽于此事而有不周哉，将以政化之宜无取于此也。","book":"《晋书·刘毅传》"},"example":{"text":"今天下四万万人之材性，长素岂尝为其～而一切检察差第之乎？","book":"清·章炳麟《驳康有为论革命书》"},"similar":["中正九品"],"usage":"作宾语、定语；用于书面语"},{"id":4046,"word":"九回肠","pinyin":"jiǔ huí cháng","abbr":"jhc","explanation":"形容回环往复的忧思。回肠：形容内心焦虑不安。","source":{"text":"风微烟澹雨萧然，隔岸马嘶何处。九回肠，双脸泪，夕阳天。","book":"梁简文帝《应令》：“望邦畿兮千里旷，悲遥夜兮九回肠。”唐·冯延巳《酒泉子（芳草长川）》"},"example":{"text":"落霞与孤骛齐飞，风急江天过雁哀，却是一只折脚雁，叫的人～，这是鸿雁来宾。","book":"清·曹雪芹《红楼梦》第六十二回"},"similar":["九回肠断"],"usage":"作谓语、状语；指愁苦"},{"id":4047,"word":"九回肠断","pinyin":"jiǔ huí cháng duàn","abbr":"jhcd","explanation":"形容痛苦、忧虑、愁闷已经到了极点。同“九回肠”。","source":{"text":"是以肠一日而九回，居则忽忽若有所忘。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"盼望的我～，思量的我两眉孱愁。","book":"元·无名氏《玩江亭》第三折"},"similar":["九转回肠"],"usage":"作谓语、状语；指愁苦"},{"id":4048,"word":"九垓八埏","pinyin":"jiǔ gāi bā yán","abbr":"jgby","explanation":"垓：通“陔”，重，层；九垓：即九重天，天之极高处；埏：边际；八埏：指边际远之地。指天地的终极之处，即天涯海角。","source":{"text":"上畅九垓，下坼八埏。","book":"《史记·司马相如列传》"},"similar":["天涯海角"],"usage":"作宾语、定语；用于书面语"},{"id":4049,"word":"九天九地","pinyin":"jiǔ tiān jiǔ dì","abbr":"jtjd","explanation":"原指天上的最高层和地的最深处。后比喻两者相差极远。","source":{"text":"善守者藏于九地之下，善攻者动于九天之上，故能自保而全胜也。","book":"春秋·齐·孙武《孙子·形》"},"example":{"text":"～，各有表里。九天之上，六甲子也。","book":"南朝·宋·范晔《后汉书·皇甫嵩传》李贤注引《玄女三宫战法》"},"usage":"作宾语、定语；比喻两者相差极远"},{"id":4050,"word":"九天仙女","pinyin":"jiǔ tiān xiān nǚ","abbr":"jtxn","explanation":"指天上的仙女，比喻绝色美女。","source":{"text":"你看此女非凡，真乃九天仙女也。","book":"元·乔吉《金钱记》第一折"},"example":{"text":"那怕是～我不爱。","book":"越剧《梁山伯与祝英台》第八场"},"similar":["国色天香"],"usage":"作宾语；指美女"},{"id":4051,"word":"九天揽月","pinyin":"jiǔ tiān lǎn yuè","abbr":"jtly","explanation":"揽：采摘。到天的最高处去摘月。常形容壮志豪情。","source":{"text":"俱怀逸兴壮思飞，欲上青天揽明月。","book":"唐·李白《宣州谢眺楼饯别校书叔云》诗"},"example":{"text":"可上～，可下五洋捉鳖。","book":"毛泽东《水调歌头·重上井冈山》词"},"usage":"作宾语、定语；指人的志向"},{"id":4052,"word":"九如天宝","pinyin":"jiǔ rú tiān bǎo","abbr":"jrtb","explanation":"九如：该诗中连用了九个“如”字，有祝贺福寿延绵不绝之意；天保：《诗经·小雅》中的篇名。旧时祝寿的话，祝贺福寿绵长。","source":{"text":"天保定尔，以莫不兴。如山如皋，如冈如陵，如川之方至，以莫不增……如月之恒，如日之升，如南山之寿，不骞不崩，如松柏之茂，无不尔或承。","book":"《诗经·小雅·天保》"},"example":{"text":"十雨五风时序令，～颂升恒。","book":"《升平署岔曲·九如天宝》"}},{"id":4053,"word":"九宗七祖","pinyin":"jiǔ zōng qī zǔ","abbr":"jzqz","explanation":"泛指祖宗。","source":{"text":"杀头固然是没有命吃饭，打屁股也是九宗七祖都不得超生的事。","book":"《冷眼观》第23回"},"usage":"作比喻、定语；指祖先"},{"id":4054,"word":"九层之台，起于累土","pinyin":"jiǔ céng zhī tái，qǐ yú lěi tǔ","abbr":"jcztqylt","explanation":"累：堆迭，积聚。九层高台，是从一筐土开始堆积起来的。比喻欲成大事，须从基础做起。","source":{"text":"合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。","book":"春秋·楚·李耳《老子》第64章"},"usage":"作宾语、定语；用于书面语"},{"id":4055,"word":"九州八极","pinyin":"jiǔ zhōu bā jí","abbr":"jzbj","explanation":"九州：中国古代地域共划分为九州；八极：九州之外最边远的地方。指天下所有远近的地区。","source":{"text":"天地之间，九州八极。","book":"《淮南子·地形训》"}},{"id":4056,"word":"九州四海","pinyin":"jiǔ zhōu sì hǎi","abbr":"jzsh","explanation":"犹言天下。泛指全中国。","source":{"text":"九州四海常无事，万岁千秋乐未央。","book":"唐·卢照邻《登封大酺歌》"},"example":{"text":"然纯德至行，～所共矜式，朝廷大议。","book":"宋·王安石《上宋相公书》"},"similar":["五湖四海","神州赤县"],"usage":"作宾语；泛指全中国"},{"id":4057,"word":"九年之储","pinyin":"jiǔ nián zhī chǔ","abbr":"jnzc","explanation":"九年的储备。指国家平时有所积蓄，以备非常。","source":{"text":"十八年而有六年之积，二十七年而有九年之储。","book":"西汉·刘安《淮南子·主术训》"},"example":{"text":"每个家庭也要有～。"},"similar":["九年之蓄"],"usage":"作宾语；指储备"},{"id":4058,"word":"九年之蓄","pinyin":"jiǔ nián zhī xù","abbr":"jnzx","explanation":"蓄：积聚，储藏。九年的储备。指国家平时有所积蓄，以备非常。","source":{"text":"国无九年之蓄，曰不足；无六年之蓄，曰急；无三年之蓄，曰国非其国也。","book":"《礼记·王制》"},"example":{"text":"朕闻国无～则国非其国，朕是以括天下之田以均其赋。","book":"《金史·食货志二》"},"similar":["九年之储"],"usage":"作宾语；指储备"},{"id":4059,"word":"九战九胜","pinyin":"jiǔ zhàn jiǔ shèng","abbr":"jzjs","explanation":"形容每战必胜。","source":{"text":"九战九胜，追北千里。","book":"《吕氏春秋·首时》"},"example":{"text":"从郑亲王济尔哈朗略锦州、松山、杏山，～。","book":"《清史稿·列传二》"}},{"id":4060,"word":"九折成医","pinyin":"jiǔ shé chéng yī","abbr":"jzcy","explanation":"几次断臂，就能知道医治断臂的方法。后比喻对某事阅历多，富有经验，成为内行。也指高明的医道。","source":{"text":"三折肱，知为良医。","book":"《左传·定公十三年》"}},{"id":4061,"word":"九折臂","pinyin":"jiǔ zhé bì","abbr":"jzb","explanation":"九：泛指多次；折：断。多次折断胳膊，经过反复治疗而熟知医理。比喻阅历多，经验丰富。","source":{"text":"方人九折臂，更历方药，则成良医。","book":"战国·楚·屈原·《九章·惜诵（惜诵以致愍兮）》：“九折臂而成医兮，吾至今而知其信然。”王逸注"}},{"id":4062,"word":"九攻九距","pinyin":"jiǔ gōng jiǔ jù","abbr":"jgjj","explanation":"九：泛指多次；距：通“拒”，抵抗。形容攻守征战非常激烈。","source":{"text":"公输盘九设攻城之机变，子墨子九距之。","book":"《墨子·公输》"}},{"id":4063,"word":"九故十亲","pinyin":"jiǔ gù shí qīn","abbr":"jgsq","explanation":"泛指亲戚朋友。","source":{"text":"爹爹也，全不怕九故十亲笑耻。","book":"元·关汉卿《哭存孝》第二折：“又不曾相趁着狂朋怪友，又不曾关节做九故十亲。” 元·石德玉《秋胡戏妻》第二折"},"similar":["亲朋好友"],"usage":"作宾语、定语；用于亲朋好友"},{"id":4064,"word":"九旋之渊","pinyin":"jiǔ xuán zhī yuān","abbr":"jxzy","explanation":"九：多数；旋：旋窝；渊：深渊。旋窝多的深渊。比喻智谋深广。","source":{"text":"建心乎窈冥之野，藏志乎九旋之渊，虽有明目，孰能窥其情。","book":"西汉·刘安《淮南子·兵略训》"},"usage":"作宾语；多用于人"},{"id":4065,"word":"九春三秋","pinyin":"jiǔ chūn sān qiū","abbr":"jcsq","explanation":"九春：春季共九十天，故称“九春”；三秋：秀季三个月，故称“三秋”。指春天和秋天的美好时光。","source":{"text":"九春三秋，天景清丽。","book":"清·周亮《书影》卷四"}},{"id":4066,"word":"九曲十八弯","pinyin":"jiǔ qū shí bā wān","abbr":"jqsbw","explanation":"曲：曲折；弯：不直。指十分弯曲。","source":{"text":"待我引他到九曲十八弯中，唤我那结义兄弟出来，就好与他算账。","book":"清·吴璿《飞龙全传》第七回"},"example":{"text":"他故意把字写得～。"},"similar":["弯弯曲曲"],"usage":"作定语、状语；用于口语"},{"id":4067,"word":"九曲回肠","pinyin":"jiǔ qū huí cháng","abbr":"jqhc","explanation":"形容痛苦、忧虑、愁闷已经到了极点。","source":{"text":"是以肠一日而九回，居则忽忽若有所忘。","book":"汉·司马迁《报任少卿书》"},"similar":["九回断肠"],"opposite":["兴高采烈"],"usage":"作宾语、定语；指愁苦"},{"id":4068,"word":"九朽一罢","pinyin":"jiǔ xiǔ yī bà","abbr":"jxyb","explanation":"原指画人物的一种技法。后也指在文学、艺术创作中严肃认真的态度。","source":{"text":"画家于人物，必九朽一罢。谓先以土笔扑取形似，数次修改，故曰九朽；继以淡墨一描而成，故曰一罢，罢者，毕事也。","book":"宋·邓椿《画继·三·岩穴上士》"}},{"id":4069,"word":"九棘三槐","pinyin":"jiǔ jí sān huái","abbr":"jjsh","explanation":"棘、槐：树名。古代皇宫外朝种植棘树和槐树，作为臣子朝见皇帝时所居位置的标志。后泛指三公、九卿等高级官职。","source":{"text":"凡士子不由及第出身，便做到九棘三槐，终久被人欺侮。","book":"明·冯梦龙《醒世恒言》卷二十五"},"example":{"text":"亦有盐梅和舟楫，～。","book":"《清史稿·乐志五》"}},{"id":4070,"word":"九死一生","pinyin":"jiǔ sǐ yī shēng","abbr":"jsys","explanation":"九：表示极多。形容经历很大危险而幸存。也形容处在生死关头，情况十分危急。","source":{"text":"虽九死无一生，未足悔恨。","book":"战国·楚·屈原《离骚》：“亦余心之所善兮，虽九死其犹未悔。”刘良注"},"example":{"text":"您哥哥剑洞枪林快厮杀，～不当个耍。","book":"元·王仲文《救孝子》第一折"},"similar":["死里逃生","百死一生"],"opposite":["安如磐石","安如泰山"],"usage":"作谓语、定语；表示人的经历","story":["战国时期，楚国诗人屈原得到楚怀王的重用，主张联齐抗秦，在同贵族子兰、靳尚的斗争中被免职。楚顷襄王时，他被流放到边杜，但他的心还惦记着祖国和人民，他写诗“亦余心之所善兮，虽九死其犹未悔。”充分体现他的决心"]},{"id":4071,"word":"九死不悔","pinyin":"jiǔ sǐ bù huǐ","abbr":"jsbh","explanation":"九：表示极多。纵然死很多回也不后悔。形容意志坚定，不认经历多少危险，也决不动摇退缩。","source":{"text":"亦余心之所善兮，虽九死其犹未悔。","book":"战国·楚·屈原《离骚》"},"example":{"text":"忠臣挟忠，则扶颠持危，～，志士侠义，则临难自奋，之死靡他。","book":"明·李贽《焚书·杂述·昆仑奴》"},"similar":["九死未悔"],"usage":"作谓语、宾语；形容意志坚定"},{"id":4072,"word":"九死未悔","pinyin":"jiǔ sǐ wèi huǐ","abbr":"jswh","explanation":"九：表示极多。纵然死很多回也不后悔。形容意志坚定，不认经历多少危险，也决不动摇退缩。","source":{"text":"亦余心之所善兮，虽九死其犹未悔。","book":"战国·楚·屈原《离骚》"},"example":{"text":"呜呼！此真～，而万劫不复者矣。","book":"清·梁启超《灭国新法论》"},"similar":["九死不悔"],"usage":"作谓语、宾语；形容意志坚定"},{"id":4073,"word":"九江八河","pinyin":"jiǔ jiāng bā hé","abbr":"jjbh","explanation":"泛指所有的江河。","source":{"text":"却说次日众真君聚朝奏玉帝曰：‘当年五月二十五日，起分龙会，会集九江八河、五湖四海各宫龙王赴会迎雨。’","book":"《四游记·灵耀分龙会为明辅》"},"usage":"作主语、宾语、定语；指江河"},{"id":4074,"word":"九泉之下","pinyin":"jiǔ quán zhī xià","abbr":"jqzx","explanation":"九泉：地下。死人埋葬的地方，即在阴间。","source":{"text":"若为死鬼，永旷天颜，九泉之下，实深重恨。","book":"汉·阮瑀《七哀》诗：“冥冥九泉室，漫漫长夜台。”《魏书·阳平王传》"},"example":{"text":"替你孩儿，尽养生送死之礼，我便～，可也瞑目。","book":"元·关汉卿《窦娥冤》第四折"},"similar":["重泉之下","九原之下"],"usage":"作宾语；形容人死后在地下的用语"},{"id":4075,"word":"九泉无恨","pinyin":"jiǔ quán wú hèn","abbr":"jqwh","explanation":"九：虚数，指极深；九泉：也称“黄泉”，人死后埋葬的地方。指死而无恨。","source":{"text":"冀幽诚丹款，傥或昭然，虽复身膏草土，九泉无恨。","book":"《宋书·徐湛之传》"}},{"id":4076,"word":"九洲四海","pinyin":"jiǔ zhōu sì hǎi","abbr":"jzsh","explanation":"九洲：指中国；四海：古人认为，中国九州之久是一望无际的大海，此指中国以外的地方。指中国及四周以外的地方。","source":{"text":"九洲四海常无事，万岁千秋乐未央。","book":"唐·卢照邻《登封大酺歌》"},"similar":["五湖四海"],"usage":"作宾语、定语；用于书面语"},{"id":4077,"word":"九流三教","pinyin":"jiǔ liú sān jiào","abbr":"jlsj","explanation":"泛指宗教、学术中各种流派。也指社会上各行各业的人。","source":{"text":"做子弟的须要九流三教皆通，八万四千傍门尽晓。","book":"元·武汉臣《玉壶春》第二折"},"example":{"text":"天桥这地方，～，什么样子的人都有。","book":"张恨水《啼笑姻缘》第一回"},"similar":["三教九流"],"usage":"作主语、宾语、定语；指社会上各行各业的人"},{"id":4078,"word":"九流人物","pinyin":"jiǔ liú rén wù","abbr":"jlrw","explanation":"指社会上的各种人物。","source":{"text":"莫遣洪炉旷真宰，九流人物待陶甄。","book":"唐·薛逢《送西川杜司空赴镇》诗"},"similar":["九流三教","九流宾客"],"usage":"作主语、宾语、定语；指各派人物"},{"id":4079,"word":"九流十家","pinyin":"jiǔ liú shí jiā","abbr":"jlsj","explanation":"先秦到汉初各种学说派别的总称。","source":{"text":"汉·刘安《七略·诸子略》中把诸子思想分为十家，即：儒、道、阴阳、法、名、墨、纵横、杂、农、小说十家，除掉小说家，就称为九流。"},"example":{"text":"我们对于古代的～应该有所了解"},"similar":["三教九流"],"usage":"作宾语、定语；用于书面语"},{"id":4080,"word":"九流宾客","pinyin":"jiǔ liú bīn kè","abbr":"jlbk","explanation":"先秦到汉初有法、名、墨、儒、道、阴阳、纵横、杂、农九种学术流派。指上中下各品的人才和各种人物。","source":{"text":"见九流宾客，不与交言。","book":"《梁书·萧子显传》"},"similar":["九流人物"],"usage":"作主语、宾语、定语；指各派人物"},{"id":4081,"word":"九流百家","pinyin":"jiǔ liú bǎi jiā","abbr":"jlbj","explanation":"泛指各种学术流派。同“九流一家”。","source":{"text":"阴阳、卜筮、占相、医方、族氏、山经、地志、字书、图画九流百家天人之书，乃至浮图、老子、外国之说，皆所详悉。","book":"唐·韩愈《毛颖传》"},"example":{"text":"凡～，以其所明者，沛然随地涌出。","book":"清·黄宗羲《论文管见》"},"usage":"作宾语、定语；指各种学术流派"},{"id":4082,"word":"九烈三贞","pinyin":"jiǔ liè sān zhēn","abbr":"jlsz","explanation":"贞：贞操；烈：节烈。封建社会用来赞誉妇女的贞烈。","source":{"text":"说甚么九烈三贞孟姜女，他可也不比其余。","book":"元·郑廷玉《后庭花》第二折"},"example":{"text":"这妮子好大胆也，全不学～、三从四德。","book":"明·无名氏《女姑姑》第二折"},"usage":"作宾语、定语；用于称赞妇女"},{"id":4083,"word":"九牛一毛","pinyin":"jiǔ niú yī máo","abbr":"jnym","explanation":"九条牛身上的一根毛。比喻极大数量中极微小的数量，微不足道。","source":{"text":"假令仆伏法受诛，若九牛亡一毛，与蝼蚁何以异？","book":"汉·司马迁《报任少卿书》"},"example":{"text":"此在县官，特～耳，而可使一邑数万家免于穷困游离。","book":"宋·陆九渊《与宋漕书》"},"similar":["沧海一粟","一丝一毫"],"opposite":["不计其数","举不胜举"],"usage":"作主语、宾语、定语；比喻微不足道","story":["西汉时期，司马迁继承父亲司马谈的官职担任太史令，因李陵事件被汉武帝刘彻关进大牢，受最残酷的“腐刑”。他经受严重身心创伤，只好向好友任少卿倾诉，他即使死了也只是九头牛身上一根毫毛一样微不足道，但活着就要干大事"]},{"id":4084,"word":"九牛一毫","pinyin":"jiǔ niú yī háo","abbr":"jnyh","explanation":"九条牛身上的一根毛。比喻极大数量中极微小的数量，微不足道。","source":{"text":"假令仆伏法受诛，若九牛亡一毛，与蝼蚁何以异？","book":"汉·司马迁《报任少卿书》"},"example":{"text":"～莫自夸，骄傲自满必翻车。","book":"陈毅《感事书怀·七古·手莫伸》诗"},"similar":["九牛一毛","沧海一粟","微不足道"],"opposite":["不计其数","多如牛毛"],"usage":"作主语、宾语、定语；指极其微小，微不足道"},{"id":4085,"word":"九牛二虎之力","pinyin":"jiǔ niú èr hǔ zhī lì","abbr":"jnehzl","explanation":"比喻很大的力气。常用于很费力才做成一件事的场合。","source":{"text":"兄弟，你不知他靴尖点地，有九牛二虎之力，休要放他小歇。","book":"元·郑德辉《三战吕布》楔子"},"example":{"text":"费了～，把这件事弄妥了，未曾涉讼。","book":"清·吴趼人《二十年目睹之怪现状》第七十七回"},"opposite":["举手投足"],"usage":"作宾语；比喻极大的力量","story":["周朝时期，周宣王听说公仪伯的勇力在诸侯中十分有名，就派人去请来询问他的勇力有多大，公仪伯回答能将蠢虫的腿折断，能抵挡秋天知了翅膀的扇动。周宣王大失所望地说自己能拖住九头牛的尾巴而不让其动弹"]},{"id":4086,"word":"九牛拉不转","pinyin":"jiǔ niú lā bù zhuàn","abbr":"jnlbz","explanation":"形容态度十分坚决。","source":{"text":"旁人只说是慢慢的劝着就劝转来了，那知他早打了个九牛拉不转的主意，一言抄百总，任是谁说，算是去定了。","book":"清·文康《儿女英雄传》第三回"},"example":{"text":"我知道奶奶一旦决定了的事，就是～的！","book":"琼瑶《烟锁重楼》七"},"usage":"作宾语、定语；用于比喻句"},{"id":4087,"word":"九经三史","pinyin":"jiǔ jīng sān shǐ","abbr":"jjss","explanation":"泛指古代典籍。","source":{"text":"夫六经三史，诸子百家，非无可观，皆足为治。","book":"宋·苏轼《乞校正陆贽奏议进御札子》"},"example":{"text":"黄卷青灯一腐儒，～腹中居。","book":"元·无名氏《醉写赤壁赋》第一折"}},{"id":4088,"word":"九经百家","pinyin":"jiǔ jīng bǎi jiā","abbr":"jjbj","explanation":"泛指古代典籍和各种学术流派。","source":{"text":"汉崔篆母师氏，通九经百家之言。","book":"明·李贽《初潭集·夫妇》"}},{"id":4089,"word":"九蒸三熯","pinyin":"jiǔ zhēng sān shēng","abbr":"jzsh","explanation":"热气上升为蒸，火干为熯。比喻久经熬炼。"},{"id":4090,"word":"九行八业","pinyin":"jiǔ háng bā yè","abbr":"jhby","explanation":"指各种行业。","source":{"text":"矿山是除了神话中的仙境之外，最令人神往的去处，而三教九流，九行八业之中，矿工是最崇高的职业。","book":"顾笑言《你在想什么》"},"similar":["各行各业"],"usage":"作宾语；指各种行业"},{"id":4091,"word":"九衢三市","pinyin":"jiǔ qú sān shì","abbr":"jqss","explanation":"指繁华的街市。","source":{"text":"九衢三市风光丽，正万家、急管繁弦。","book":"宋·柳永《看花回》词"},"example":{"text":"繁会～，缥缈层楼杰观，雪片一冬深。","book":"宋·张孝祥《水调歌头·桂林集句》"},"usage":"作宾语、定语；指城市"},{"id":4092,"word":"九转丸成","pinyin":"jiǔ zhuàn wán chéng","abbr":"jzwc","explanation":"转：循环变化；丸：指金丹。道家语，指炼得九转金丹。后常比喻经过长期不懈的艰苦努力而终于获得成功。","source":{"text":"其一转至九转，迟速各有日数多少，以此知之耳。其转数少，其药力不足，故服之用日多得仙迟也；其转数多药力成，故服之用日少而提仙速也。","book":"晋·葛洪《抱朴子·金丹》"},"example":{"text":"三条烛尽钟初动，～鼎未开，残月渐低人扰扰，不知谁是谪仙才？","book":"五代·王定保《唐摭言》第15卷"},"usage":"作谓语、宾语；指努力而成功"},{"id":4093,"word":"九转丹成","pinyin":"jiǔ zhuàn dān chéng","abbr":"jzdc","explanation":"转：循环变华。原为道家语，指炼得九转金丹。后常比喻经过长期不懈的艰苦努力而终于获得成功。","source":{"text":"其一转至九转，迟速各有日数多少，以此知之耳。其转数少，其药力不足，故服之用日多得仙迟也；其转数多药力成，故服之用日少而提仙速也。","book":"《抱朴子·金丹》"},"example":{"text":"～最上仙，青天暖日踏云开。","book":"唐·赵嘏《喜张濆及第》"}},{"id":4094,"word":"九转功成","pinyin":"jiǔ zhuàn gōng chéng","abbr":"jzgc","explanation":"转：循环变华。原为道家语，指炼得九转金丹。后常比喻经过长期不懈的艰苦努力而终于获得成功。","source":{"text":"其一转至九转，迟速各有日数多少，以此知之耳。其转数少，其药力不足，故服之用日多得仙迟也；其转数多药力成，故服之用日少而提仙速也。","book":"《抱朴子·金丹》"},"example":{"text":"～数尽乾。开炉拨鼎见金丹。餐饵了、别尘寰。足蹑青云突上天。","book":"唐·吕岩《渔父·朝帝》词"},"usage":"作宾语、定语；用于书面语"},{"id":4095,"word":"九锡宠臣","pinyin":"jiǔ xī chǒng chén","abbr":"jxcc","explanation":"九锡：古代帝王赐给重臣的车马、虎贲等九种器物。形容位高权重，深受皇帝宠信的大臣。"},{"id":4096,"word":"九间大殿","pinyin":"jiǔ jiān dà diàn","abbr":"jjdd","explanation":"帝王受百官朝拜的大殿。同“九间朝殿”。"},{"id":4097,"word":"九间朝殿","pinyin":"jiǔ jiān cháo diàn","abbr":"jjcd","explanation":"帝王受百官朝拜的大殿。间，指两柱的距离。九间，极言堂殿之宽广。亦作“九间大殿”。"},{"id":4098,"word":"九阍虎豹","pinyin":"jiǔ hūn hǔ bào","abbr":"jhhb","explanation":"比喻凶残的权臣。同“九关虎豹”。","source":{"text":"九阍虎豹嗟难近，一炬龙蛇事可怜。","book":"张素《威介推事》诗"},"similar":["九关虎豹"],"usage":"作主语、宾语、定语；指凶恶的人"},{"id":4099,"word":"九霄云外","pinyin":"jiǔ xiāo yún wài","abbr":"jxyw","explanation":"九霄：高空。在九重天的外面。比喻无限远的地方或远得无影无踪。","source":{"text":"太子也你在这七宝盒中，我陈琳早魂飞九霄云外。","book":"北齐·颜之推《颜氏家训·文章》：“一事惬当，一句清巧，神厉九霄，志凌千载。”元·无名氏《抱妆盒》第二折"},"example":{"text":"婶娘那时怎样疼我来，如今就忘在～？","book":"清·曹雪芹《红楼梦》第一百一回"},"similar":["烟消云散","无影无踪"],"usage":"作主语、宾语、补语；用于表消失意义动词后"},{"id":4100,"word":"九鼎一丝","pinyin":"jiǔ dǐng yī sī","abbr":"jdys","explanation":"同千钧一发，比喻非常危急。","source":{"text":"呜呼，贤首之宗不振久矣，凛乎若九鼎一丝之悬。","book":"明·宋濂《同公塔铭》"},"similar":["千钧一发"],"usage":"作定语；指十分危急的时刻"},{"id":4101,"word":"九鼎一言","pinyin":"jiǔ dǐng yī yán","abbr":"jdyy","explanation":"《史记·平原君列传》：“毛先生一至楚而使赵重于九鼎大吕。毛先生以三寸之舌，强于百万之师。胜不敢复相士。”","source":{"text":"老师～，即纳吉问名，不逾于此，门生传示司马，使他静守甥舍，以待乘龙可也。 ★清·无名氏《人中画·风流配》"}},{"id":4102,"word":"九鼎不足为重","pinyin":"jiǔ dǐng bù zú wéi zhòng","abbr":"jdbzwz","explanation":"形容说话有分量，比较起来九鼎也不算重。","source":{"text":"昔之所以议进退天下士大夫者，今又重之以权位，故其一言之出，则九鼎不足为重。","book":"宋·傅博《邵氏闻见后录》卷十五"},"similar":["一言九鼎"],"usage":"作宾语、定语；用于书面语"},{"id":4103,"word":"九鼎大吕","pinyin":"jiǔ dǐng dà lǚ","abbr":"jddl","explanation":"九鼎：古传说，夏禹铸九鼎，象征九州，是夏商周三代的传国之宝；大吕：周庙大钟。比喻说得话力量大，分量重。","source":{"text":"毛先生一至楚，而使赵重于九鼎大吕。","book":"《史记·平原君列传》"},"similar":["黄钟大吕"],"usage":"作主语、宾语、定语；指重要的东西"},{"id":4104,"word":"乞丐之徒","pinyin":"qǐ gài zhī tú","abbr":"qgzt","explanation":"徒：辈。形容乞求恩宠的人。","source":{"text":"逮平贻厥，乃乞丐之徒，嗣恶稔之余基，纵奸邪之凶德。","book":"《晋书·贾充传》"},"example":{"text":"该死瞎目～！要撞大人马头，拿下！","book":"清·无名氏《后宋慈云走国全传》第二十三回"}},{"id":4105,"word":"乞儿乘车","pinyin":"qǐ ér chéng chē","abbr":"qecc","explanation":"讽刺官职提升得快的话。","source":{"text":"君释褐登宰府，三十六日，拥麾盖，守兵马郡，乞儿乘小车，一何驶乎？","book":"《三国志·魏书·邓艾传》注引《世语》"},"usage":"作宾语、定语；用于书面语"},{"id":4106,"word":"乞儿暴富","pinyin":"qǐ ér bào fù","abbr":"qebf","explanation":"乞儿：乞丐。乞丐骤然发了大财。比喻学问大增。","source":{"text":"暴富乞儿休说梦，谁家窖里火无烟。","book":"宋·释惟白《续传灯录》卷三十五"},"example":{"text":"然寒微之士，无以致此，但得宣、成等窑瓷瓶各一二枚，亦可谓～矣。","book":"明·袁宏道《瓶史·器具》"},"similar":["穷儿暴富"],"usage":"作宾语、定语；用于暴发户"},{"id":4107,"word":"乞儿马医","pinyin":"qǐ ér mǎ yī","abbr":"qemy","explanation":"乞儿：乞丐；马医：兽医中专治马病的人。旧指卑贱的人。","source":{"text":"自此之后，范氏门徒，路遇乞儿马医，弗敢辱也。","book":"《列子·黄帝》"},"example":{"text":"既与～同贱，为民请命，是其故常。","book":"章炳麟《驳神我宪政说》"},"similar":["贩夫贩妇","平民百姓"],"opposite":["王公贵族"],"usage":"作宾语、定语；指卑贱的人"},{"id":4108,"word":"乞哀告怜","pinyin":"qǐ āi gào lián","abbr":"qagl","explanation":"哀：怜悯；告：请求。乞求别人的怜悯和帮助。","source":{"text":"荒时暴月，向亲友乞哀告怜，借得几斗几升，敷衍三日五日，债务丛集，如牛负重。","book":"毛泽东《中国社会各阶级的分析》"},"example":{"text":"人得有骨气，不要～。"},"similar":["摇尾乞怜"],"usage":"作谓语、宾语；指乞求别人的同情怜悯"},{"id":4109,"word":"乞宠求荣","pinyin":"qǐ chǒng qiú róng","abbr":"qcqr","explanation":"乞：乞讨；宠：宠爱；荣：富贵。乞求宠幸以获得荣华富贵。"},{"id":4110,"word":"乞怜摇尾","pinyin":"qǐ lián yáo wěi","abbr":"qlyw","explanation":"怜：怜悯；乞：乞求。狗摇着尾巴向主人乞求爱怜。比喻装出一副可怜相向人讨好。","source":{"text":"你无知小辈，胡言乱语，休在人前乞怜摇尾！","book":"明·王錂《春芜记·构衅》"},"similar":["摇尾乞怜"],"usage":"作谓语、定语；指假装可怜"},{"id":4111,"word":"乞浆得酒","pinyin":"qǐ jiāng dé jiǔ","abbr":"qjdj","explanation":"浆：淡酒，一种比酒质量差的饮料。讨杯浆水喝，却得到了酒。比喻得到的超过所要求的。","source":{"text":"太岁在酉，乞浆得酒。","book":"晋·李石《续博物志》卷一"},"example":{"text":"～，旧来神口，打兔得獐，非意所望。","book":"唐·张文成《游仙窟》"},"similar":["求浆得酒"],"usage":"作谓语、定语；指得到的超过所要求的"},{"id":4112,"word":"乞灵药石","pinyin":"qǐ líng yào shí","abbr":"qlys","explanation":"乞灵：求助于所谓的的某种中权威；药石：治病的药物和砭石，泛指药物。求助于神灵和药物。","source":{"text":"寡君欲徼福于周公，愿乞灵于臧氏。","book":"《左传·哀公二十四年》"},"example":{"text":"俾获乞灵药石，退处清闲，冀得痼疾之稍疗，长享共和之幸福。","book":"丁中江《北洋军阀史话》三十六"}},{"id":4113,"word":"乞穷俭相","pinyin":"qǐ qióng jiǎn xiāng","abbr":"qqjx","explanation":"乞丐似的寒酸相。"},{"id":4114,"word":"乞骸骨","pinyin":"qǐ hái gǔ","abbr":"qhg","explanation":"乞：求，讨。古代官吏因年老请求退职。","source":{"text":"充国乞骸骨，赐安车驷马。","book":"东汉·班固《汉书·赵充国传》"},"example":{"text":"上书～。","book":"南朝·宋·范晔《后汉书·张衡传》"},"similar":["请骸骨"],"usage":"作谓语；指告老还乡","story":["西汉时期，太子太傅疏广年事已高就上书皇帝请求与侄儿一起退休，好让一把老骨头能葬在故乡。他们的请求得到批准，离京时，公卿大夫在城外为他们饯行，因他们知足不辱，功成身退，被人们尊为“贤大夫”"]},{"id":4115,"word":"习与体成","pinyin":"xí yǔ tǐ chéng","abbr":"xytc","explanation":"习：习惯。长期的习惯将会形成一定的性格。","source":{"text":"作之不变，习与体成，则自然矣。","book":"《孔丛子·执节》"},"similar":["习与性成"],"usage":"作谓语；用于书面语"},{"id":4116,"word":"习与性成","pinyin":"xí yǔ xìng chéng","abbr":"xyxc","explanation":"性：性格。长期习惯于怎样，就会形成怎样的性格。有习惯成自然的意思。","source":{"text":"兹乃不义，习与性成。","book":"《尚书·太甲上》"},"example":{"text":"～，不骄淫狂荡。","book":"明·王廷相《慎言·保傅》"},"similar":["习惯自然","习以性成"],"usage":"作谓语；同“习惯成自然”"},{"id":4117,"word":"习为故常","pinyin":"xí wéi gù cháng","abbr":"xwgc","explanation":"故常：常例。经常如此，养成习惯，就被当作常规了。","source":{"text":"盖承成化以来，滥授冗员，俱以中旨批出，遂习为故常，不以为怪也。","book":"明·沈德符《野获编·勋戚·沈禄》"},"similar":["习惯成自然","习以为常"],"usage":"作谓语、定语；用于处事"},{"id":4118,"word":"习久成性","pinyin":"xí jiǔ chéng xìng","abbr":"xjcx","explanation":"性：性格。长期习惯于怎样，就会形成怎样的性格。有习惯成自然的意思。","source":{"text":"兹乃不义，习与性成。","book":"《尚书·太甲上》"},"example":{"text":"原系声随箫笛，非以箫笛随声，～，一到场上，不知不觉而以曲随箫笛矣。","book":"清·李渔《闲情偶寄·演习部·授曲》"},"similar":["习以成性","习与性成"],"usage":"作谓语、宾语、定语；用于处事"},{"id":4119,"word":"习以为常","pinyin":"xí yǐ wéi cháng","abbr":"xywc","explanation":"习：习惯。指某种事情经常去做，或某种现象经常看到，也就觉得很平常了。","source":{"text":"民生而有习有常，以习为常。","book":"《魏书·太武五王传》：“将相多尚公主，王侯亦娶后族，故无妾媵，习以为常。”《逸周书·常训》"},"example":{"text":"余大先生在虞府坐馆，早去晚归，～。","book":"清·吴敬梓《儒林外史》第四十八回"},"similar":["司空见惯","屡见不鲜"],"opposite":["千载难逢","少见多怪"],"usage":"作谓语、定语；用于人或事"},{"id":4120,"word":"习以成俗","pinyin":"xí yǐ chéng sú","abbr":"xycs","explanation":"俗：习惯。长期以来就是这样做，成了习俗。","source":{"text":"将由居上者未能悛改，为下者习以成俗，教化陵迟。","book":"《魏书·高允传》"},"example":{"text":"这已经成为～的事情了。"},"similar":["习以成风"],"usage":"作宾语、定语；指成为习俗"},{"id":4121,"word":"习以成性","pinyin":"xí yǐ chéng xìng","abbr":"xycx","explanation":"习：习惯。习惯了就养成了性格。","source":{"text":"习以成性，迁善远罪而不自知，行成德立。","book":"《晋书·王导传》"},"example":{"text":"他有很多陋习，而且已经～了。"},"similar":["习与性成"],"usage":"作谓语、定语；指习惯成自然"},{"id":4122,"word":"习以成风","pinyin":"xí yǐ chéng fēng","abbr":"xycf","explanation":"风：风气。习惯了，就形成了风气。","source":{"text":"今聚天下之不敢言是非者在朝廷，又择其不敢言之甚者为台谏，习以成风，如何做得事。","book":"宋·朱熹《谏诤》"},"example":{"text":"南渡之后，～，虽士大夫亦为所移。","book":"《金史·蒲察合住传》"},"similar":["习以成俗"],"usage":"作宾语、定语；指成为习俗"},{"id":4123,"word":"习俗移人","pinyin":"xí sú yí rén","abbr":"xsyr","explanation":"移：改变；人：指人的本性。风俗习惯可以改变人的习性。","source":{"text":"安定山谷之间，昆戎旧壤，子弟贪鄙，岂习俗之移人哉。","book":"汉·杨恽《报孙会宗书》"},"example":{"text":"宫中不足，随时选入，隋主坚也心为物役，渐渐的爱恋声色了。～，中主不免。","book":"蔡东藩《南北史演义》第八十六回"},"similar":["习俗移性"],"usage":"作宾语、分句；指风俗习惯可以改变人"},{"id":4124,"word":"习俗移性","pinyin":"xí sú yí xìng","abbr":"xsyx","explanation":"风俗习惯可以改变人的习性。","source":{"text":"汨常移质，习俗移性。","book":"《晏子春秋·内篇杂上》"},"similar":["习俗移人"],"usage":"作宾语、分句；指风俗习惯可以改变人"},{"id":4125,"word":"习惯成自然","pinyin":"xí guàn chéng zì rán","abbr":"xgczr","explanation":"习惯了就成为很自然的事了。","source":{"text":"少成若天性，习惯如自然。","book":"《汉书·贾谊传》"},"example":{"text":"调节和作是为了求中和，求平衡，求自然——这儿是所谓“～”","book":"朱自清《人话》"},"similar":["习惯自然","习惯若自然"],"usage":"作宾语、分句；指习久成性"},{"id":4126,"word":"习惯自然","pinyin":"xí guàn zì rán","abbr":"xgzr","explanation":"习惯了就成为很自然的事了。","source":{"text":"孔子曰：少成若天性，习惯如自然。","book":"汉·贾谊《新书·保傅》"},"example":{"text":"不过一般人也已～，知道这只是为了增加诚意的分量，强调自己的态度，跟买卖人的吆喝到底不是一回事儿。","book":"朱自清《论诚意》"},"similar":["习惯成自然"],"usage":"作宾语、分句；指习久成性"},{"id":4127,"word":"习惯若自然","pinyin":"xí guàn ruò zì rán","abbr":"xgrzr","explanation":"惯：同“贯”；若：像。习惯了就像很自然的事。","source":{"text":"少成则若性也，习惯若自然也。","book":"《孔子家语·七十二弟子解》"},"similar":["习惯成自然","习若自然"],"usage":"作宾语、分句；指习久成性"},{"id":4128,"word":"习故安常","pinyin":"xí gù ān cháng","abbr":"xgac","explanation":"指习惯于规。","source":{"text":"中国乃闭关绝市而不能，习故安常而不可。","book":"陈炽《〈盛世危言〉序》"}},{"id":4129,"word":"习无不精","pinyin":"xí wú bù jīng","abbr":"xwbj","explanation":"习：学习；精：精通。学习没有不精通的。","example":{"text":"～可见学习的作用。"},"usage":"作宾语、定语；用于处事"},{"id":4130,"word":"习焉不察","pinyin":"xī yān bù chá","abbr":"xybc","explanation":"习：习惯；焉：语气词，有“于此”的意思；察：觉察。指经常接触某种事物，反而觉察不到其中存在的问题。","source":{"text":"行之而不著焉，习矣而不察焉，终身由之而不知其道者，众也。","book":"战国·邹·孟轲《孟子·尽心上》"},"example":{"text":"而不晓文义者，～，概谓有旨为进止。","book":"宋·张淏《云谷杂记·取进止》"},"similar":["习而不察","习焉不觉"],"usage":"作谓语、定语；指习惯了就忽略"},{"id":4131,"word":"习焉不觉","pinyin":"xī yān bù jué","abbr":"xybj","explanation":"习：习惯；焉：语气助词，相当于“于是”的意思。指习惯于某种事物而觉察不到其中的问题。","source":{"text":"改漫为熳，不知起于何时？焉乌成马，习焉不觉，殊可怪也。","book":"清·沈德潜《学诗晬语》下卷"},"similar":["习焉不察","习焉弗察"],"usage":"作谓语、定语；指习惯了就忽略"},{"id":4132,"word":"习焉弗察","pinyin":"xí yān fú chá","abbr":"xyfc","explanation":"习：习惯；焉：语气助词，相当于“于是”的意思。指习惯于某种事物而觉察不到其中的问题。","source":{"text":"此实传庭，又或误以为‘傅庭’，耳食之徒，遂习焉弗察耳。","book":"清·梁章钜《浪迹续谈·孙白谷》"},"similar":["习焉不觉","习焉不察"],"usage":"作谓语、定语；指习惯了就忽略"},{"id":4133,"word":"习而不察","pinyin":"xí ér bù chá","abbr":"xebc","explanation":"习：习惯。指常见之事，就觉察不到存在的问题。","source":{"text":"行之而不著焉，习矣而不察焉。","book":"战国·宋·孟轲《孟子》"},"example":{"text":"盖其事既为世所通行，又为人之～者。","book":"孙中山《心理建设（孙文学说）》第二章"},"similar":["习焉不察"],"usage":"作定语；指常见的事"},{"id":4134,"word":"习若自然","pinyin":"xí ruò zì rán","abbr":"xrzr","explanation":"若：像。习惯了就像很自然的事。","source":{"text":"年十八九，少知砥砺，习若自然，卒难洗荡。","book":"北朝·齐·颜之推《颜氏家训·序致》"},"similar":["习惯若自然","习惯成自然"],"usage":"作宾语、分句；指习久成性"},{"id":4135,"word":"习非成俗","pinyin":"xí fēi chéng sú","abbr":"xfcs","explanation":"指习惯于不好的东西而成风尚。","source":{"text":"杯觞路酌，弦歌行奏，转相高尚，习非成俗。","book":"晋·葛洪《抱朴子·疾谬》"},"usage":"作谓语、宾语；用于书面语"},{"id":4136,"word":"习非成是","pinyin":"xí fēi chéng shì","abbr":"xfcs","explanation":"对某些错误事情习惯了，反以为本来就是对的。","source":{"text":"一哄之市政，必立之平；一卷之书，必立之师，习乎习，以习非之胜是，况习是之胜非乎？","book":"汉·扬雄《法言·学行》"},"example":{"text":"于是～，一若文不用典，即为俭学之征。","book":"钱玄同《寄陈独秀》"},"similar":["习非胜是"],"usage":"作谓语、宾语；指不明是非"},{"id":4137,"word":"习非胜是","pinyin":"xí fēi shèng shì","abbr":"xfss","explanation":"习：习惯；非：错误的；是：正确的。对某些错误事情习惯了，反以为本来就是正确的。","source":{"text":"一哄之市政，必立之平；一卷之书，必立之师，习乎习，以习非之胜是，况习是之胜非乎？","book":"汉·扬雄《法言·学行》"},"example":{"text":"宋·赵与时《宾退录》第五卷：“名实相乱，莫矫其实，～，终古不悟，可悲矣！”"},"similar":["习非成是"],"usage":"作谓语、宾语；指不明是非"},{"id":4138,"word":"乡乡而饱","pinyin":"xiǎng xiǎng ér bǎo","abbr":"xxeb","explanation":"乡：通“飨”；乡乡：吃得很满足。形容吃得很满足的样子。","source":{"text":"亦呥呥而噍，乡乡而饱已矣。","book":"战国·赵·荀况《荀子·荣辱》"},"usage":"作谓语、定语；用于书面语"},{"id":4139,"word":"乡书难寄","pinyin":"xiāng shū nán jì","abbr":"xsnj","explanation":"乡书：家书。家书很难寄回家中。比喻与家乡消息隔绝。","source":{"text":"乡书不可寄，秋雁又南回。","book":"唐·韦庄《章台夜思》"}},{"id":4140,"word":"乡利倍义","pinyin":"xiāng lì bèi yì","abbr":"xlby","explanation":"趋向私利，违背正义。乡，通“向”。倍，通“背”。","source":{"text":"乘人之车者载人之患，衣人之衣者怀人之忧，食人之食者死人之事，吾岂可乡利倍义乎！","book":"西汉·司马迁《史记·淮阴侯列传》"},"usage":"作谓语、定语；用于处事等"},{"id":4141,"word":"乡土难离","pinyin":"xiāng tǔ nán lí","abbr":"xtnl","explanation":"乡土：家乡，故土。难于离开故乡的土地。形容对家乡或祖国有无限的眷恋之情。","source":{"text":"有人去乡土，离六亲。","book":"战国·郑·列御寇《列子·天瑞》"},"similar":["故土难离"],"usage":"作宾语、定语；用于人的心境等"},{"id":4142,"word":"乡壁虚造","pinyin":"xiāng bì xū zào","abbr":"xbxz","explanation":"即对着墙壁，凭空造出来的。比喻无事实根据，凭空捏造。","source":{"text":"故诡更正文，乡壁虚造不可知之书，变乱常行，以耀于世。","book":"汉·许慎《序》"},"example":{"text":"～，随臆师心，不知传受于何人。","book":"清·魏源《序》"},"similar":["凭空捏造","无中生有"],"usage":"作谓语、宾语、定语；指凭空捏造"},{"id":4143,"word":"乡巴佬","pinyin":"xiāng bā lǎo","abbr":"xbl","explanation":"笨拙、迟钝又粗俗质朴的乡下人。","source":{"text":"我还没有能变成一个纯粹的城里人，但也不完全是一个乡巴佬了。","book":"路遥《平凡的世界》第二卷第42章"},"usage":"作主语、宾语、定语；用于口语"},{"id":4144,"word":"乡曲之情","pinyin":"xiāng qū zhī qíng","abbr":"xqzq","explanation":"乡曲：乡里。同乡的情谊。","source":{"text":"侧闻吾子急人之忧，不遗乡曲之情，忽垂特达之眷，使保安得执鞭弭，以奉周施。","book":"唐·牛肃《吴保安》"},"usage":"作宾语；用于书面语"},{"id":4145,"word":"乡曲之意","pinyin":"xiāng qū zhī yì","abbr":"xqzy","explanation":"指乡里的称誉。","source":{"text":"仆少负不羁之行，长无乡曲之意。","book":"汉·司马迁《报任少卿书》"}},{"id":4146,"word":"乡曲之见","pinyin":"xiāng qū zhī jiàn","abbr":"xqzj","explanation":"乡曲：乡里，也指偏僻的地方。形容见识寡陋。","example":{"text":"圣先王中我只佩服一个大禹，其次是越大夫范蠡。这一说好像是有～，说天下英雄都出我们村里。","book":"周作人《禹迹寺》"}},{"id":4147,"word":"乡曲之誉","pinyin":"xiāng qū zhī yù","abbr":"xqzy","explanation":"指乡里的称誉。","source":{"text":"仆少负不羁之行，长无乡曲之誉。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"古者取士，先～，然后辟于州；州已试，然后辟五府；五府著闻，乃升诸朝。","book":"《新唐书·韦嗣立传》"},"usage":"作宾语；用于书面语"},{"id":4148,"word":"乡规民约","pinyin":"xiāng guī mín yuē","abbr":"xgmy","explanation":"指由当地村民共同制定并要求共同遵守的规约。","example":{"text":"我们到乡下要遵守当地的～。"},"usage":"作主语、宾语、定语；指乡村规矩"},{"id":4149,"word":"乡里不通","pinyin":"xiāng lǐ bù tōng","abbr":"xlbt","explanation":"乡里：籍贯。旧指不能进出宫门。也指没有作官，朝中没有名籍。","source":{"text":"昔者管夷吾射桓公中其钩，篡也；遗公子纠不能死，怯也；束缚桎梏，辱也。若此三行者，世主不臣而乡里不通。","book":"《史记·鲁仲连邹阳列传》"}},{"id":4150,"word":"乡里夫妻","pinyin":"xiāng lǐ fū qī","abbr":"xlfq","explanation":"乡里：家乡。指相守在一起不分离的夫妻。","source":{"text":"俗语云：‘乡里夫妻，步步相随。’言乡不离理，如夫不离妻也。","book":"明·杨慎《升庵诗话·乡里夫妻》"},"usage":"作主语、宾语、定语；用于口语"},{"id":4151,"word":"乡风慕义","pinyin":"xiàng fēng mù yì","abbr":"xfmy","explanation":"乡：通“向”。指向往其教化，仰慕其礼义。或指向往其风度，仰慕其义行。","source":{"text":"陛下诚能复立六国后世，毕已受印，此其君臣百姓必皆戴陛下之德，莫不乡风慕义，愿为臣妾。","book":"《史记·留侯世家》"},"similar":["向风慕义"],"usage":"作谓语；用于书面语"},{"id":4152,"word":"书不尽意","pinyin":"shū bù jìn yì","abbr":"sbjy","explanation":"指文辞难充分达意。后多作书信结尾习用语。","source":{"text":"与阳休之书曰：‘……已矣哉，书不尽意。’","book":"《北齐书·文苑传·祖鸿勋》"},"similar":["书不尽言"],"usage":"作谓语、分句；多作书信或说话等"},{"id":4153,"word":"书不尽言","pinyin":"shū bù jìn yán","abbr":"sbjy","explanation":"书：书信。信中难以充分表达其意。后多作书信结尾习用语。","source":{"text":"子曰：‘书不尽言，言不尽意。’","book":"《易·系辞上》"},"example":{"text":"～，死待来命。","book":"明·罗贯中《三国演义》第二十六回"},"similar":["书不尽意"],"usage":"作谓语、分句；多作书信结尾用语"},{"id":4154,"word":"书不尽言，言不尽意","pinyin":"shū bù jìn yán，yán bù jìn yì","abbr":"sbjyybjy","explanation":"书：书信。信中难以充分表达其意。指语言、文字不容易完全确切地表达思想内容。","source":{"text":"子曰：‘书不尽言，言不尽意，然则圣人之意，其不可见乎？’","book":"《周易·系辞上》"}},{"id":4155,"word":"书不释手","pinyin":"shū bù shì shǒu","abbr":"sbss","explanation":"手里的书舍不得放下。形容勤学或看书入迷。","source":{"text":"［牛弘］性宽厚，笃志于学，虽职务繁杂，书不释手。","book":"《北史·牛弘传》"},"similar":["手不释卷","手不释书"],"usage":"作宾语、定语；用于学习等"},{"id":4156,"word":"书剑飘零","pinyin":"shū jiàn piāo líng","abbr":"sjpl","explanation":"书剑：书籍和宝剑，指读书做官，仗剑从军。本指做官或从军，离乡背井，飘流在外。后指因求取功名而出门在外、久游未归。","source":{"text":"小生书剑飘零，功名未遂，游于四方。","book":"元·王实甫《西厢记》第一本第一折"},"example":{"text":"明·胡文焕《群音类选·》：“痴呆，柯于无言难打孩，哀哉，～甚日回。”"},"usage":"作谓语、定语；用于生活"},{"id":4157,"word":"书功竹帛","pinyin":"shū gōng zhú bó","abbr":"sgzb","explanation":"把功绩写在竹简绢帛上。比喻载入史册。","source":{"text":"今欲为使君合步骑十万，上可以匡主济民，成五霸之业，下可以割地守境，书功于竹帛。","book":"《三国志·蜀志·先主传》"}},{"id":4158,"word":"书同文，车同轨","pinyin":"shū tóng wén，chē tóng guǐ","abbr":"stwctg","explanation":"车轨相同，文字相同。比喻国家统一。","source":{"text":"今天下车同轨，书同文。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"太康之中，天下～，牛马被野。","book":"晋·干宝《晋纪总论》"},"similar":["同文共轨"],"usage":"作分句；比喻天下统一"},{"id":4159,"word":"书呆子","pinyin":"shū dāi zǐ","abbr":"sdz","explanation":"指只知读书而缺乏实际知识的人。","source":{"text":"老夫素日常听人说，读书人每每读到后来入了魔境，要变成‘书呆子’。","book":"清·李汝珍《镜花缘》第40回"},"example":{"text":"科甲出身的，总不免～的味道。","book":"高阳《胡雪岩全传·平步青云》上册"},"usage":"作主语、宾语、定语；用于讽刺等"},{"id":4160,"word":"书囊无底","pinyin":"shū náng wú dǐ","abbr":"snwd","explanation":"指古今书籍不可胜数。","source":{"text":"连床夜语鸡戒晓，书囊无底谈未了。","book":"宋·黄庭坚《送王郎》诗"},"example":{"text":"叔爹，～，如何读得尽？","book":"明·苏复之《金印记·刺股读书》"},"usage":"作宾语、定语；用于劝诫人"},{"id":4161,"word":"书声朗朗","pinyin":"shū shēng lǎng lǎng","abbr":"ssll","explanation":"形容读书声音清朗而响亮。","source":{"text":"走过闹市，只听那些居民人家，接二连三，莫不书声朗朗。","book":"清·李汝珍《镜花缘》第二十三回"},"similar":["书声琅琅"],"usage":"作谓语、宾语；指读书声"},{"id":4162,"word":"书声琅琅","pinyin":"shū shēng láng láng","abbr":"ssll","explanation":"形容读书声音响亮。","source":{"text":"每相过者，论先生德义，诵先生文章，堂上琅琅，终日不绝。","book":"宋·李昭玘《上眉扬先生》"},"example":{"text":"明季有书生独行丛莽间，闻～，怪旷野那得有是。","book":"清·纪昀《阅微草堂笔记》卷三"},"similar":["书声朗朗"],"usage":"作谓语、宾语；指读书声"},{"id":4163,"word":"书富五车","pinyin":"shū fù wǔ chē","abbr":"sfwc","explanation":"五车：指五车书。形容读书多，学识丰富。","source":{"text":"惠施多方，其书五车。","book":"《庄子·天下》"},"example":{"text":"真个胸中书富五车，笔下句高千古。","book":"明·冯梦龙《醒世恒言》卷三十五"},"similar":["学富五车","书读五车"],"usage":"作谓语、定语；指学识渊博"},{"id":4164,"word":"书生之见","pinyin":"shū shēng zhī jiàn","abbr":"sszj","explanation":"指读书人不切实际或不合时宜的见解。","source":{"text":"予谓议者以本朝养兵为大费，欲复寓兵于农之法，书生之见，可言而不可用者哉。","book":"宋·邵博《闻见后录》卷一"},"example":{"text":"其中有些话都是窒碍难行，毕竟～，全是纸上谈兵。","book":"清·李宝嘉《官场现形记》第三十一回"},"usage":"作宾语；指不切合实际的见解"},{"id":4165,"word":"书生气","pinyin":"shū shēng qì","abbr":"ssq","explanation":"书生：读书人。常用来形容看问题简单、幼稚，对实际问题缺乏了解。","source":{"text":"洗净书生气味酸。","book":"宋·范成大《次韵宋佛阅番乐》"},"example":{"text":"钱兄，这四个字请你来写，我们的字有～，不像带兵的武人。","book":"金庸《鹿鼎记》第四十回"}},{"id":4166,"word":"书生气十足","pinyin":"shū shēng qì shí zú","abbr":"ssqsz","explanation":"比喻政治上糊涂，看问题单纯、幼稚，书呆子气很足。","source":{"text":"洗净书生气味酸。","book":"宋·范成大《次韵宋佛阅番乐》"},"example":{"text":"他哪里知道，～也会误事，过于善良也会上当！","book":"马辂《国共和谈演义》第三十八回"}},{"id":4167,"word":"书画卯酉","pinyin":"shū huà mǎo yǒu","abbr":"shmy","explanation":"犹言上下班。卯时签到，酉时签退。","source":{"text":"依旧每日县中书画卯酉，听候差使。","book":"《水浒传》第五一回"},"similar":["朝九晚五"],"usage":"作谓语、定语；用于书面语"},{"id":4168,"word":"书空咄咄","pinyin":"shū kōng duō duō","abbr":"skdd","explanation":"为叹息、愤慨、惊诧的的典实。","source":{"text":"殷中军被废，在信安，终日恒书空作字。扬州吏民寻义逐之，窃视，唯作‘咄咄怪事’四字而已。","book":"语出南朝·宋·刘义庆《世说新语、黜免》"},"example":{"text":"～知谁解，击缶呜呜却自惊。","book":"金·元好问《镇平县斋感怀》诗"},"usage":"作宾语、定语；用于书面语","story":["东晋时期，扬州刺史殷浩与大将桓温不合，王羲之劝他大敌当前应以国事为重，殷浩不但不听，领兵北伐，屡战屡败，被废为平民，流放到信安，他整天无忧无虑地读书吟诗，老是在纸上写“咄咄怪事”四个字来表示心中的不平"]},{"id":4169,"word":"书符咒水","pinyin":"shū fú zhòu shuǐ","abbr":"sfzs","explanation":"书：画；符：符箓；水：神水。泛指道士作法的迷信活动。","source":{"text":"高斋以谓‘少游尝为道士，书符咒水’，又诬也。","book":"宋·胡仔《苕溪渔隐丛话前集·秦少游》"},"example":{"text":"算命发课，～，没工夫得吃点心，因此出名。","book":"明·冯梦龙《警世通言》卷三十九"},"usage":"作谓语、宾语、定语；用于宗教等"},{"id":4170,"word":"书缺有间","pinyin":"shū quē yǒu jiàn","abbr":"sqyj","explanation":"泛指古书残缺已有多年。","source":{"text":"《书》缺有间矣，其轶乃时时见于他说。","book":"《史记·五帝本纪》"},"usage":"作谓语、分句；泛指古书残缺已有多年"},{"id":4171,"word":"书缺简脱","pinyin":"shū quē jiǎn tuō","abbr":"sqjt","explanation":"简：古代供书写用的竹、木简；脱：丢失。指书简散佚残缺。","source":{"text":"礼坏乐崩，书缺简脱，朕甚闵焉。","book":"《汉书·楚元王传》"},"similar":["残篇断简"],"usage":"作宾语、定语；用于书面语"},{"id":4172,"word":"书记翩翩","pinyin":"shū jì piān piān","abbr":"sjpp","explanation":"书记：记事的书面文字；翩翩：举止、风貌的洒脱优美。形容风格隽雅，文辞优美。","source":{"text":"山受学祛，所言涉猎书记，不能为醇儒。","book":"《史记·平原君传赞》：“平原君，翩翩浊世之佳公子也，然未睹大体。”《汉书·贾山传》"},"example":{"text":"公干有逸气，但未遒耳，其王言之善者，妙绝时人，元瑜～致足乐也。","book":"三国·魏·曹丕《与吴质书》"},"usage":"作谓语、定语；用于书面语"},{"id":4173,"word":"书读五车","pinyin":"shū dú wǔ chē","abbr":"sdwc","explanation":"形容读书多，知识丰富。","source":{"text":"惠施多方，其书五车。","book":"《庄子·天下》"},"example":{"text":"我好痴，教孩儿学甚文章。比似我～，那曾上金马玉堂。","book":"明·范受益《寻亲记·局骗》"},"similar":["学富五车","书富五车"],"usage":"作谓语、定语；用于书面语"},{"id":4174,"word":"书读百遍，其意自见","pinyin":"shū dú bǎi biàn，qí yì zì xiàn","abbr":"sdbbqyzj","explanation":"见：显露。指书读的次数多了，其意思就自然显露出来了。","source":{"text":"人有从学者，遇不肯教，而云必当先读百遍，言读书百遍，而意自见。","book":"《三国志·魏志·王肃传》裴松之注引《魏略》"}},{"id":4175,"word":"书通二酉","pinyin":"shū tōng èr yǒu","abbr":"stey","explanation":"比喻读书甚多，学识丰富精湛。二酉：指大酉山、小酉山。","source":{"text":"小酉山上石穴中有书千卷，相传秦人于此而学，因留之。","book":"语出《太平御览》卷四九引南朝·宋·盛弘之《荆州记》"},"example":{"text":"［陈宗阮］到一十六岁，果然学富五车，～。","book":"明·冯梦龙《古今小说·闲云庵阮三偿冤债》"},"similar":["学富五车"],"opposite":["胸无点墨"],"usage":"作谓语、定语；用于书面语"},{"id":4176,"word":"书香世家","pinyin":"shū xiāng shì jiā","abbr":"sxsj","explanation":"指世代都是读书人的家庭。","source":{"text":"刘眉尽管把鼻子都气歪了，也还是保持着书香世家的风度。","book":"高云览《小城春秋》第十三章"},"similar":["书香门户","诗礼人家"],"usage":"作宾语、定语；指读书人的家庭"},{"id":4177,"word":"书香人家","pinyin":"shū xiāng rén jiā","abbr":"sxrj","explanation":"指世代都是读书人的家庭。","source":{"text":"原来是个仕宦书香人家，怪不的他得夫人那样明理。","book":"清·吴趼人《二十年目睹之怪现状》第三十六回"},"example":{"text":"你看，全是这样的子弟，诗礼人家，～，还有什么希望？","book":"巴金《秋》三"},"similar":["书香世家","书香门户","诗礼人家"],"usage":"作宾语、定语；指读书人的家庭"},{"id":4178,"word":"书香铜臭","pinyin":"shū xiāng tóng chòu","abbr":"sxtx","explanation":"书香：读书的家风；铜臭：铜钱上的臭味。指集书香和铜臭于一体的书商。","source":{"text":"何物充栋汗车牛，混了书香铜臭。贾儒商秀，怕遇着秦皇大搜。","book":"清·孔尚任《桃花扇·逮社》"},"usage":"作宾语、定语；多用于书商"},{"id":4179,"word":"书香门户","pinyin":"shū xiāng mén hù","abbr":"sxmh","explanation":"指世代都是读书人的家庭。","source":{"text":"［丈夫］是个所谓书香门户子弟。","book":"沙汀《祖父的故事·老太婆》"},"similar":["书香门第","书香人家","书香世家"],"usage":"作宾语、定语；指读书人的家庭"},{"id":4180,"word":"书香门第","pinyin":"shū xiāng mén dì","abbr":"sxmd","explanation":"旧时指上辈有读书人的家庭。","source":{"text":"如今眼看着书香门第是接下去了，衣饭生涯是靠得住了。","book":"清·文康《儿女英雄传》四十回"},"example":{"text":"她每天一想到自己出身于～，哥哥是个举人，却落入贼人之手，已够丢尽了祖宗的人。","book":"姚雪垠《李自成》第一卷第十七章"},"similar":["世代书香","书香门户","书香人家"],"opposite":["蓬门荜户"],"usage":"作宾语、定语；指读书人的家庭"},{"id":4181,"word":"买上告下","pinyin":"mǎi shàng gào xià","abbr":"msgx","explanation":"贿赂上司，央告下人。","source":{"text":"宋太公自来买上告下，使用钱帛。","book":"明·施耐庵《水浒传》第36回"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第20卷：“兰孙只得将了些钱钞，～，去狱中传言寄语，担茶送饭。”"},"similar":["买上嘱下"],"usage":"作谓语、定语；用于处事"},{"id":4182,"word":"买上嘱下","pinyin":"mǎi shàng zhǔ xià","abbr":"mszx","explanation":"贿赂上司，央告下人。同“买上告下”。","source":{"text":"当下龚正寻个相识，将些银两，替王庆到营差拨处买上嘱下的使用了。","book":"《水浒传》第一○三回"},"similar":["买上告下"],"usage":"作谓语、定语；用于处事"},{"id":4183,"word":"买东买西","pinyin":"mǎi dōng mǎi xī","abbr":"mdmx","explanation":"指买各种物品。","source":{"text":"买东买西使官钱，点驴点马是买卖。","book":"明·李开先《林冲宝剑记》第29出"},"example":{"text":"俗语～，言卖买者非东即西，沿习日久，遂以东西为货物替身。","book":"清·龚炜《巢林笔谈续编·买东西考》"},"similar":["买这买那"],"usage":"作谓语；指买各种物品"},{"id":4184,"word":"买卖不成仁义在","pinyin":"mǎi mài bù chéng rén yì zài","abbr":"mmbcryz","explanation":"虽然买卖没有做成，彼此间的感情还存在。","source":{"text":"嫌人家来做买卖，买卖不成仁义在，打倒人家干吗？","book":"梁斌《红旗谱》第一卷"},"example":{"text":"～，我们下次再合作吧。"},"usage":"作宾语、定语、分句；用于生意场合"},{"id":4185,"word":"买卖公平","pinyin":"mǎi mài gōng píng","abbr":"mmgp","explanation":"买或卖公平合理，互不相欺。","source":{"text":"小人买卖公平，不知为何告在大老爷台下？","book":"清·寄生氏《五美缘》第五十七回"},"example":{"text":"红军不仅～，而且纸币完全兑换，商人十分满意。","book":"成仿吾《长征回忆录》五"}},{"id":4186,"word":"买官鬻爵","pinyin":"mǎi guān yù jué","abbr":"mgyj","explanation":"指买卖官爵。","source":{"text":"至于民间说事，买官鬻爵，只要他一口担当，事无不成。","book":"明·凌濛初《初刻拍案惊奇》第22卷"},"example":{"text":"贿赂公行，～，奸恶诈伪，上下相蒙。","book":"郑观应《盛世危言·教养》"},"similar":["卖官鬻爵"],"usage":"作谓语、宾语、定语；用于官场等"},{"id":4187,"word":"买椟还珠","pinyin":"mǎi dú huán zhū","abbr":"mdhz","explanation":"椟：木匣；珠：珍珠。买下木匣，退还了珍珠。比喻没有眼力，取舍不当。","source":{"text":"楚人有卖其珠于郑者，为木兰之柜，熏以桂椒，缀以珠玉，饰以玫瑰，辑以羽翠。郑人买其椟而还其珠。","book":"《韩非子·外储说左上》"},"example":{"text":"不善读书者，昧菁英而矜糟粕。～，虽多奚益？改用白话，决无此病。","book":"清·裘廷梁《论白话为维新之本》"},"similar":["舍本逐末","本末倒置","反裘负薪"],"opposite":["去粗取精"],"usage":"作谓语、宾语、定语；用于书面语","story":["传说楚国有个珠宝商到郑国去卖珍珠，为了吸引顾客，他做一个很漂亮的用名贵木料做成的盒子，匣子还镶嵌着宝石和翡翠，看起来十分华贵。一个郑国的买主抱着珍珠匣子便以高价买下，打开匣子取出珍珠还给楚国商人"]},{"id":4188,"word":"买欢追笑","pinyin":"mǎi huān zhuī xiào","abbr":"mhzx","explanation":"指嫖娼的行为。","source":{"text":"坝头西市坊凤楼施厨开沽，下瓦子前日新楼郑厨开沽，俱有妓女，以待风流才子买笑追欢耳。","book":"宋·吴自牧《东京梦梁录·酒肆》"}},{"id":4189,"word":"买爵贩官","pinyin":"mǎi jué fàn guān","abbr":"mjfg","explanation":"犹言买官鬻爵。指买卖官爵。","source":{"text":"买爵贩官，免刑除罪，公用弥多，而为者徇私，上下无求，百姓不堪。","book":"汉·桓宽《盐铁论·刺复》"},"usage":"作宾语、定语；用于官场"},{"id":4190,"word":"买牛卖剑","pinyin":"mǎi niú mài jiàn","abbr":"mnmj","explanation":"原指放下武器，从事耕种。后比喻改业务农或坏人改恶从善。同“买犁卖剑”。","source":{"text":"买牛卖剑，便作儿孙计。","book":"宋·吴礼之《蓦山溪》词"},"example":{"text":"紫塞冒风沙，谩区区两鬓生华。归来好向林泉下。～，求田问舍，学圃耘瓜。","book":"元·朱庭玉《青杏子·归隐》套曲"},"similar":["卖剑买牛","买牛息戈"],"opposite":["南征北战","穷兵黩武","卖犊买刀"],"usage":"作谓语、定语；指停止战争"},{"id":4191,"word":"买牛息戈","pinyin":"mǎi niú xī gē","abbr":"mnxg","explanation":"犹言卖剑买牛。原指放下武器，从事耕种。后比喻改业务农或坏人改恶从善。","source":{"text":"太守下牛，买牛息戈。","book":"明·何景明《雁门太守行》"},"similar":["卖剑买牛","买牛卖剑"],"opposite":["南征北战","穷兵黩武","卖犊买刀"],"usage":"作谓语、定语；指停止战争"},{"id":4192,"word":"买犁卖剑","pinyin":"mǎi lí mài jiàn","abbr":"mlmj","explanation":"原指放下武器，从事耕种。后比喻改业务农或坏人改恶从善。同“买犁卖剑”。","source":{"text":"天下适安耕且老，看买犁卖剑平家铁。","book":"宋·陈亮《贺新郎·怀辛幼安用前韵》词"},"similar":["卖剑买牛"],"opposite":["穷兵黩武"],"usage":"作谓语、定语、宾语；用于休战"},{"id":4193,"word":"买犊卖刀","pinyin":"mǎi dú mài dāo","abbr":"mdmd","explanation":"犹言卖剑买牛。原指放下武器，从事耕种。后比喻改业务农或坏人改恶从善。","source":{"text":"不用斗粟片甲，而使积年逋寇，皆束手归降，买犊卖刀之化，不足以媲美矣。","book":"明·张居正《答广中督抚》"},"similar":["卖剑买牛","买牛卖剑"],"opposite":["南征北战","穷兵黩武","卖犊买刀"],"usage":"作谓语、定语；指停止战争"},{"id":4194,"word":"买王得羊","pinyin":"mǎi wáng dé yáng","abbr":"mwdy","explanation":"①指想买王献之字，却得到了羊欣的字。意为差强人意。②指摹仿名人的字画虽然逼真而终差一等。","source":{"text":"时人云：‘买王得羊，不失所望。’","book":"唐·张怀瑾《书断》"},"example":{"text":"或云赵书有疵笔，出俞紫芝手。果尔，所谓～耳。","book":"明·王世贞《十绝句诗画跋》"},"usage":"作宾语、定语；用于比喻句"},{"id":4195,"word":"买田阳羡","pinyin":"mǎi tián yáng xiàn","abbr":"mtyx","explanation":"指辞官归隐。","source":{"text":"买田阳羡吾将老，从来只为溪山好。","book":"宋·苏轼《菩萨蛮》词"},"example":{"text":"鼓柁湘江应未得，～定何如？","book":"明·何景明《得献吉江西书》诗"},"similar":["辞官归隐"],"opposite":["东山再起"],"usage":"作谓语；指辞官归隐"},{"id":4196,"word":"买空卖空","pinyin":"mǎi kōng mài kōng","abbr":"mkmk","explanation":"买卖双方都没有货款进出，只就进出之间的差价结算盈亏。也用来比喻政治上招摇撞骗的投机活动。","source":{"text":"奸商开设太和字号，邀群结伙，买空卖空。","book":"清《宣宗圣训·清道光帝上谕》"},"example":{"text":"因为多年～的结果，文界就荒凉了，文章的形式虽然比较的整齐起来，但战斗的精神却较前有退无进。","book":"鲁迅《准风月谈·由聋而哑》"},"similar":["投机取巧","勾心斗角"],"opposite":["童叟无欺"],"usage":"作谓语、定语；指投机行为"},{"id":4197,"word":"买笑寻欢","pinyin":"mǎi xiào xún huān","abbr":"mxxh","explanation":"嫖娼狎妓，寻欢作乐。同“买笑追欢”。","source":{"text":"他仗着有钱有势，到这儿来买笑寻欢，他哪儿有甚么真情真义？","book":"欧阳予倩《潘金莲》第二幕"},"similar":["买笑迎欢","买笑追欢","寻欢作乐"],"usage":"作谓语、定语、宾语；多用于男性"},{"id":4198,"word":"买笑迎欢","pinyin":"mǎi xiào yíng huān","abbr":"mxyh","explanation":"嫖娼狎妓，寻欢作乐。同“买笑追欢”。","source":{"text":"俺哥哥要见尊颜，非图买笑迎欢，只是久闻娘子遭际今上，以此亲自特来告诉衷曲。","book":"《水浒传》第八一回"},"similar":["买笑寻欢","买笑追欢","寻欢作乐"],"usage":"作谓语、定语、宾语；多用于男性"},{"id":4199,"word":"买笑追欢","pinyin":"mǎi xiào zhuī huān","abbr":"mxzh","explanation":"嫖娼狎妓，寻欢作乐。","source":{"text":"至如三妻四妾，买笑追欢的，又当别论。","book":"明·施耐庵《水浒传》第九十四回：“库藏粮饷，都是民脂民膏，你只顾侵来肥己，买笑追欢，败坏了国家许多大事。”明·兰陵笑笑生《金瓶梅词话》第一回"},"example":{"text":"以酒为缘，以色为缘，十二时～，永朝永夕酣大梦；诚心看戏，诚意听戏，四九旦登场夺锦，双麟双凤共消魂！","book":"清·曾朴《孽海花》第六回"},"similar":["买笑寻欢","买笑迎欢","寻欢作乐"],"usage":"作谓语、定语、宾语；多用于男性"},{"id":4200,"word":"买米下锅","pinyin":"mǎi mǐ xià guō","abbr":"mmxg","explanation":"家中没有米，要去买米才能做饭。指生活贫困。","source":{"text":"退还给他，我不等他这二两银子买米下锅。","book":"清·李宝嘉《官场现形记》第二回"},"example":{"text":"我现在家中无余粮，等～了。"},"similar":["等米下锅"],"usage":"作谓语、宾语；指家中无余粮"},{"id":4201,"word":"买臣覆水","pinyin":"mǎi chén fù shuǐ","abbr":"mcfs","explanation":"覆：泼。比喻事成定局，无法挽回。","source":{"text":"相传汉代朱买臣贫贱时，其妻出走，显达后，其妻又回来，朱买臣泼水于地，令妻收回。"},"example":{"text":"今日无意忽逢，虽不能有相如解渴之情，却怅然有～之悲。","book":"清·李绿园《歧路灯》第七十回"}},{"id":4202,"word":"买菜求益","pinyin":"mǎi cài qiú yì","abbr":"mcqy","explanation":"益：增加。象买菜一样希望增加一点。比喻争多赚少。","source":{"text":"买菜乎？求益也。","book":"晋·皇甫谧《高士传·严光》"},"example":{"text":"要是人贪常熟书，非关买菜复求益。","book":"宋·程珌《代上杨诚斋》"},"similar":["斤斤计较"],"usage":"作谓语、定语；指斤斤计较"},{"id":4203,"word":"买贱卖贵","pinyin":"mǎi jiàn mài guì","abbr":"mjmg","explanation":"指低价买进而高价卖出。","source":{"text":"裨贩，买贱卖贵，以自裨益。","book":"汉·张衡《西京赋》：“尔乃商贾百族，裨贩夫妇。”三国·吴·薛综注"},"example":{"text":"做生意就是要～，否则就是为社会贡献财富。"},"similar":["贱买贵卖","低进高出"],"opposite":["贵买贱卖"],"usage":"作谓语、宾语；指商业赢利行为"},{"id":4204,"word":"买铁思金","pinyin":"mǎi tiě sī jīn","abbr":"mtsj","explanation":"比喻不切实际的贪心妄想。","source":{"text":"有一等浊爱缠心，盲修瞎炼，期望身后升天。这便是买铁思金，定见沉沦永劫。","book":"明·徐复祚《一文钱》第三出"},"usage":"作宾语、定语；用于人贪心"},{"id":4205,"word":"买静求安","pinyin":"mǎi jìng qiú ān","abbr":"mjqa","explanation":"指息事宁人，以图安逸。","source":{"text":"今日满天飞大王在此经过，这乡村敛钱备饭，买静求安。","book":"明·冯梦龙《警世通言》卷二十一"},"example":{"text":"只消说他造言生事，顶名告他一状，不怕不拿大锭大帛出来～。","book":"清·张南庄《何典》第二回"},"usage":"作谓语、宾语；用于处世"},{"id":4206,"word":"买马招兵","pinyin":"mǎi mǎ zhāo bīng","abbr":"mmzb","explanation":"犹言招兵买马。","source":{"text":"今中既到山中住，少不得，买马招兵尽壮怀。","book":"《再生缘》第三回"},"similar":["买马招军","招兵买马"],"usage":"作谓语、宾语、定语；指扩军"},{"id":4207,"word":"买马招军","pinyin":"mǎi mǎ zhāo jūn","abbr":"mmzj","explanation":"犹言招兵买马。","source":{"text":"有这等事？恭喜了！借此号令，买马招军。","book":"明·汤显祖《牡丹亭·牝贼》"},"example":{"text":"明·施耐庵《水浒传》第105回：“分头于房山寨及各处，立竖招军旗号，～，积草屯粮，远近村镇，都被劫掠。”"},"similar":["买马招兵","招兵买马"],"usage":"作谓语、宾语、定语；指扩军"},{"id":4208,"word":"乱七八糟","pinyin":"luàn qī bā zāo","abbr":"lqbz","explanation":"形容无秩序，无条理，乱得不成样子。","source":{"text":"你看屋里的图书字画，家伙器皿，布置得清雅整洁，不象公坊以前乱七八糟的样子了，这是霞郎的成绩。","book":"清·曾朴《孽海花》第五回"},"example":{"text":"琴弹得～，可是她的嗓子怪清亮的。","book":"老舍《二马》四"},"similar":["杂乱无章","污七八糟"],"opposite":["井然有序","井井有条","有条有理"],"usage":"作定语、状语；指混乱"},{"id":4209,"word":"乱七八遭","pinyin":"luàn qī bā zāo","abbr":"lqbz","explanation":"形容无秩序，无条理，乱得不成样子。同“乱七八糟”。","source":{"text":"非常驳杂，脑子给古今各种马队践踏了一通之后，弄得乱七八遭。","book":"鲁迅《且介亭杂文二集·人生识字胡涂始》"},"similar":["乱七八糟"],"opposite":["井然有序"],"usage":"作定语、补语、状语；指混乱"},{"id":4210,"word":"乱世之音","pinyin":"luàn shì xhī yīn","abbr":"lszy","explanation":"指扰乱世道和人心的音乐。","source":{"text":"乱世之音怨以怒，其政乖。","book":"《诗经·周南·关雎序》"},"example":{"text":"但也都因国事日非，人心危急所致，又因新旧交汇，青黄不接所致。总而言之，～而已。","book":"《林语堂自传·海外萍踪》"}},{"id":4211,"word":"乱世凶年","pinyin":"luàn shì xiōng nián","abbr":"lsxn","explanation":"时世动乱，年成极坏。","source":{"text":"三径荒芜不似前，甘把针指频拈，聊度看乱世凶年。","book":"明·胡文焕《群音类选·〈犀佩记·庵中小会〉》"}},{"id":4212,"word":"乱世英雄","pinyin":"luàn shì yīng xióng","abbr":"lsyx","explanation":"乱世：动乱的不安定的时代；英雄：才能勇武超过常人的人。混乱动荡时代中的杰出人物。","source":{"text":"曹公少时见乔玄。玄谓曰：‘天下方乱，群雄虎争，拨而理之非君乎？然君实是乱世之英雄，治世之奸贼。","book":"南朝·宋·刘义庆《世说新语·识鉴》"},"example":{"text":"文殊智，普贤行，多年历日。德山棒，临济喝，～。","book":"宋·释普济《五灯会元》卷十八"},"similar":["乱世出英雄"],"usage":"作宾语、定语；指动荡时代的杰出人物","story":["东汉末年，年轻的曹操见到乔玄，乔玄说：“如今天下大乱，各路豪杰如猛虎争斗，你是乱世英雄，安定时期的奸贼，遗憾的是我老了，见不到你富贵的时候了，只好把子孙托付给你，请多多关照了。”"]},{"id":4213,"word":"乱人耳目","pinyin":"luàn rén ěr mù","abbr":"lrem","explanation":"乱：扰乱。指故意去迷惑人。","source":{"text":"我倒疑惑那是吴荪甫他们故意造的谣言，乱人耳目！","book":"茅盾《子夜》"},"example":{"text":"他故意干～的事情。"},"similar":["混淆视听"],"usage":"作谓语、定语；指故意去迷惑人"},{"id":4214,"word":"乱作一团","pinyin":"luàn zuò yī tuán","abbr":"lzyt","explanation":"混杂在一起，形容极为混乱。","source":{"text":"他拿了儒、道士、和尚、耶教的糟粕，乱作一团，又密密的插入鬼话。","book":"鲁迅《热风·随感录三十三》"},"example":{"text":"他的队伍已经～，滚的滚下，栽倒的栽倒。","book":"刘流《烈火金刚》第27回"},"similar":["乱成一团"],"opposite":["整齐有序"],"usage":"作谓语、定语；指混乱"},{"id":4215,"word":"乱作胡为","pinyin":"luàn zuò hú wéi","abbr":"lzhw","explanation":"犹胡作非为。不顾法纪或舆论，毫无顾忌地做坏事。","source":{"text":"直这般无廉鲜耻，乱作胡为。","book":"元·吴昌龄《张天师》第二折"},"example":{"text":"秀才，与你这一间幽静的房儿，随你自去的打斛斗，学踢弄，舞地鬼，乔扮神，撒科打诨，～。","book":"元·李好古《张生煮海》第一折"},"similar":["胡作非为"],"usage":"作谓语、定语、状语；指任意做坏事"},{"id":4216,"word":"乱俗伤风","pinyin":"luàn sú shāng fēng","abbr":"lssf","explanation":"指败坏社会风气。","source":{"text":"炳之身上之衅，既自籍籍，交结朋党，搆扇是非，实足乱俗伤风。","book":"《宋书·瘐炳之传》"}},{"id":4217,"word":"乱坠天花","pinyin":"luàn zhuì tiān huā","abbr":"lzth","explanation":"比喻说话动人或文字精彩。多指话说得夸大或不切实际。","source":{"text":"六欲诸天来供养，天华（花）乱坠遍虚空。","book":"《心地观经·序品》"},"example":{"text":"横说竖说，～。","book":"明·张岱《祭祁文载文》"},"similar":["天花乱坠","不切实际"],"usage":"作状语、宾语；指不着边际"},{"id":4218,"word":"乱头粗服","pinyin":"luàn tóu cū fú","abbr":"ltcf","explanation":"头发蓬乱，衣着随便。形容不爱修饰。","source":{"text":"双脸断红初却坐，乱头粗服总倾城。","book":"明·王彦泓《个人》诗"},"example":{"text":"自己是～，孩子们也啼哭喧闹。","book":"冰心《我的学生》"},"similar":["粗服乱头","不修边幅"],"usage":"作宾语、补语、定语；形容不修仪容服饰"},{"id":4219,"word":"乱弹琴","pinyin":"luàn tán qín","abbr":"ltq","explanation":"比喻胡扯或胡闹。","source":{"text":"该简者你却详而不简，该详者你又简而不详。本末倒置，批评你还不愿意？乱弹琴！","book":"曲波《林海雪原》一二"},"example":{"text":"曲波《林海雪原》一二：“该简者你却详而不简，该详者你又简而不详。本末倒置，批评你还不愿意？乱弹琴！”"},"similar":["瞎胡闹"],"usage":"作谓语、宾语；指胡闹"},{"id":4220,"word":"乱扣帽子","pinyin":"luàn kòu mào zǐ","abbr":"lkmz","explanation":"指随意给别人定性。","example":{"text":"～的行为是行不通的。"},"similar":["扣大帽子"],"usage":"作主语、谓语、宾语；指随意给别人定性"},{"id":4221,"word":"乱极则平","pinyin":"luàn jí zé píng","abbr":"ljzp","explanation":"社会动乱到了极点，必然趋向于安定。","source":{"text":"今闻曹公法令严，民厌乱矣，乱极则平。","book":"《三国志·魏志·刑颙传》"}},{"id":4222,"word":"乱极思治","pinyin":"luàn jí sī zhì","abbr":"ljsz","explanation":"社会动乱到了极点，人民一心向往太平。","source":{"text":"周，谓文武之间。数，谓五百年之期。时，谓乱极思治可以有为之日。于是而不得一有所为，此孟子所以不能无不豫也。","book":"宋·朱熹《孟子集注》卷四"},"example":{"text":"当时人心归附，～，总道是天下大定，从此好安享太平，哪知他外强中乾，受制帷帟，阿么炀帝小名。","book":"蔡东藩《南北史演义》第一回"}},{"id":4223,"word":"乱点鸳鸯","pinyin":"luàn diǎn yuān yāng","abbr":"ldyy","explanation":"鸳鸯：鸟名，常比喻夫妻。使夫妇互易错配。也比喻胡乱配合姻缘。","source":{"text":"唐帝乱点鸳鸯的，把几个女子赐与众臣配偶，不但男女称意，感戴皇恩。","book":"清·褚人获《隋唐演义》第63回"},"example":{"text":"硬作月老，～，使慧梅终身有恨。","book":"姚雪垠《李自成》第三卷第32章"},"similar":["东拼西凑"],"opposite":["天作之合","成人之美"],"usage":"作宾语；比喻胡乱配合姻缘"},{"id":4224,"word":"乱琼碎玉","pinyin":"luàn qióng suì yù","abbr":"lqsy","explanation":"指雪花。","source":{"text":"（武松）正在雪里，踏着乱琼碎玉归来。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"example":{"text":"那妇人独自一个冷冷清清立在帘儿下等着，只见武松踏着那～归来。","book":"明·施耐庵《水浒全传》第二十三回"},"usage":"作宾语；指雪花"},{"id":4225,"word":"乱真不辨","pinyin":"luàn zhēn bù biàn","abbr":"lzbb","explanation":"乱真：善于摹仿，和真的一样。摹仿能力很强，和真的放在一起，分不出真假。","source":{"text":"画山水人物，自名一家，尤工临移，至乱真不可辨。","book":"《宋史·米芾传》"}},{"id":4226,"word":"乱碰乱撞","pinyin":"luàn pèng luàn zhuàng","abbr":"lplz","explanation":"指到处碰壁，没有目标。","source":{"text":"你～是没有希望的。"},"example":{"text":"你～是没有希望的"},"similar":["东碰西撞"],"usage":"作谓语、宾语；指没有目标"},{"id":4227,"word":"乱离多阻","pinyin":"luàn lí duō zǔ","abbr":"lldz","explanation":"乱离：因遭难而流离失所。形容因遭遇祸乱而变得流离失所，四处难行。","source":{"text":"悠悠世路，乱离多阻。","book":"《诗经·小雅·四月》：“乱离瘼矣，爰其适归。”三国·魏·王粲《赠蔡子笃》"},"example":{"text":"虽复汉魏诛戳，巢窟暂倾，～，种落还集。","book":"《隋书·炀帝纪下》"}},{"id":4228,"word":"乱箭攒心","pinyin":"luàn jiàn cuán xīn","abbr":"ljcx","explanation":"攒：积聚。乱箭身在心上。比喻内心极度痛苦。","source":{"text":"见父亲倒在一个壁角边乱草之上……淹淹止存一息。二子一见，犹如乱箭攒心，放声号哭。","book":"明·冯梦龙《醒世恒言》第20卷"},"example":{"text":"这事让他有～的感觉。"},"similar":["乱箭穿心"],"usage":"作宾语、定语；指内心痛苦"},{"id":4229,"word":"乱臣贼子","pinyin":"luàn chén zéi zǐ","abbr":"lczz","explanation":"乱臣：叛乱之臣；贼子：忤逆之子。旧指不守君臣、父子之道的人。后泛指心怀异志的人。","source":{"text":"孔子成《春秋》，而乱臣贼子俱。","book":"《孟子·藤文公下》"},"example":{"text":"有贼不讨，则故君不得书葬，新君不得书即位，所以防～，法至严也。","book":"清·爱新觉罗·多尔衮《致史可法书》"},"similar":["逆臣贼子"],"opposite":["忠君爱国"],"usage":"作主语、宾语、定语；指心怀异志的人","story":["春秋时期，鲁国政权被季孙氏、孟孙氏和叔孙氏三家控制，鲁定公成为一个傀儡，他听说孔子主张“君臣纲常”，召见孔子说他最恨季氏等乱臣贼子。孔子分析鲁国的内忧外患，建议他外联齐国，内部重振君威，制定了一系列措施"]},{"id":4230,"word":"乱臣逆子","pinyin":"luàn chén nì zǐ","abbr":"lcnz","explanation":"乱臣：叛乱之臣；逆子：忤逆之子。旧指不守君臣、父子之道的人。后泛指心怀异志的人。","source":{"text":"近汉氏淮南、阜陵，皆为乱臣逆子，而犹或及身而复国，或至子而锡土。","book":"《孟子·滕文公下》：“孔子成《春秋》，而乱臣贼子惧。”《三国志·魏志·武文世王公传》"},"example":{"text":"载垣、端华、肃顺等～，伤乎理，违乎易，所拟年号‘祺祥’二字，不吉不利，群议之，则废。","book":"赵辉《同治皇帝》第五章"}},{"id":4231,"word":"乱蝶狂蜂","pinyin":"kuáng fēng luàn dié","abbr":"ldkf","explanation":"飞舞的蝴蝶和蜜蜂。比喻浪荡子弟。","source":{"text":"乱蝶狂蜂俱有意，兔葵燕麦自无知。","book":"宋·吕本中《春日即事》"}},{"id":4232,"word":"乱语胡言","pinyin":"luàn yǔ hú yán","abbr":"lyhy","explanation":"指胡说；瞎扯。","source":{"text":"省可里乱语胡言！","book":"元·关汉卿《鲁斋郎》第一折"},"example":{"text":"娘亲，你切莫听那三姑六婆～。","book":"闽剧《钗头凤》"},"similar":["胡言乱语"],"usage":"作主语、谓语、宾语；形容说话没根据"},{"id":4233,"word":"乱首垢面","pinyin":"luàn shǒu gòu miàn","abbr":"lsgm","explanation":"犹蓬头垢面。旧时形容贫苦人生活生活条件很坏的样子。也泛指没有修饰。","source":{"text":"阳朔中，世文大将军凤病，莽侍疾，亲尝药，乱首垢面，不解衣带连月。","book":"《后汉书·王莽传上》"},"example":{"text":"自孝文不豫，勰常居中，亲侍医药，夙夜不离左右，至于衣不解带，～。","book":"《北史·彭城王传》"},"similar":["蓬头垢面"],"usage":"作谓语、定语、补语；指外表不整"},{"id":4234,"word":"乳声乳气","pinyin":"rǔ shēng rǔ qì","abbr":"rsrq","explanation":"形容说话声音象小孩子那样尖细。"},{"id":4235,"word":"乳水交融","pinyin":"rǔ shuǐ jiāo róng","abbr":"rsjr","explanation":"融：融合。像水和乳汁融合在一起。比喻感情很融洽或结合十分紧密。","source":{"text":"他对平郡王十分倍托，两人可说是乳水交融，合作无间。","book":"端木蕻良《曹雪芹》"},"similar":["水乳交融","水乳之契"],"usage":"作谓语、定语、状语；指感情融洽"},{"id":4236,"word":"乳犊不怕虎","pinyin":"rǔ dú bù pà hǔ","abbr":"rdbph","explanation":"比喻年轻人没有畏惧，敢做敢为。","source":{"text":"德将为汝美，道将为汝居，汝瞳焉如新出之犊，而无求其故。","book":"《庄子·知北游》"},"similar":["无所畏惧"],"usage":"作定语、宾语、分句；用于年轻人"},{"id":4237,"word":"乳臭未干","pinyin":"rǔ xiù wèi gān","abbr":"rxwg","explanation":"臭：气味。身上的奶腥气还没有退尽。对年轻人表示轻蔑的说法。","source":{"text":"是口尚乳臭，不能当韩信。","book":"《汉书·高帝纪上》"},"example":{"text":"这些故事，作为闲谈来听听是不算很坏的，但万一有谁相信了，照办了，那就会成为～的吉呵德。","book":"鲁迅《且介亭杂文·难行和不信》"},"similar":["口尚乳臭","年幼无知"],"opposite":["后生可畏"],"usage":"作谓语、定语、宾语；指轻蔑人","story":["宋仁忠命杨家保的年幼儿子杨文广去焦山取被杜月英抢走的朝廷宝物，他率军前往，可是接连被窦锦姑、杜月英、飞云三个姑娘打败，成为她们的新郎官。后人作诗为证：文广十三乳未干，带兵取宝赴焦山，三战三败皆女辈，逼做三回新郎官"]},{"id":4238,"word":"乳臭未除","pinyin":"rǔ chòu wèi chú","abbr":"rcwc","explanation":"比喻年幼。","source":{"text":"[商功父]虽有两个外甥，不是姐姐亲生，亦且是乳臭未除，谁人来稽查得他？","book":"《二刻拍案惊奇》卷二十"},"example":{"text":"你这个～的小子懂得什么？"},"similar":["乳臭未干"],"usage":"作谓语、定语；用于书面语"},{"id":4239,"word":"乳间股脚","pinyin":"rǔ jiān gǔ jiǎo","abbr":"rjgj","explanation":"比喻自以为安全的处所。","source":{"text":"奎蹄曲隈，乳间股脚，自以为安室利处。","book":"《庄子·徐无鬼》"},"usage":"作宾语、定语；指以为安全的地方"},{"id":4240,"word":"乾乾翼翼","pinyin":"qián qián yì yì","abbr":"qqyy","explanation":"指勤勉敬慎。"},{"id":4241,"word":"乾坤一掷","pinyin":"qián kūn yī zhì","abbr":"qkyz","explanation":"乾坤：天下；掷：扔，投。把天下作为一次赌注。形容下的赌注极大。","source":{"text":"谁助君王回马首，真成一掷赌乾坤。","book":"唐·韩愈《过鸿沟》"},"example":{"text":"蒋在某一方面是个强者，遇到～的大事，他那畏首畏尾的懦弱性格，即表现无遗！","book":"范克明《张学良传·再见，西安》"}},{"id":4242,"word":"乾坤再造","pinyin":"qián kūn zài zào","abbr":"qkzz","explanation":"乾坤：天地。再造天地，即重建江山。","source":{"text":"然后联合楚魏，共立韩赵之后，并力破秦，此乾坤再造之时也。","book":"明·冯梦龙《东周列国志》第106回"},"example":{"text":"卿荡平逆寇，收复神京，宗庙重新，～，真不世之功也。","book":"清·洪昇《长生殿·改葬》"},"similar":["再造乾坤"],"usage":"作宾语、定语；指再造天地"},{"id":4243,"word":"乾端坤倪","pinyin":"qián duān kūn ní","abbr":"qdkn","explanation":"指天地显示的征兆。"},{"id":4244,"word":"了不可见","pinyin":"liǎo bù kě jiàn","abbr":"lbkj","explanation":"了：完全。完全不能看见。","source":{"text":"母语之，灵铣驰求之，了无所见。","book":"晋·干宝《搜神记》卷十四：“果复重来，发声如前。闻，便闭户，周旋室中，了无所见。”宋·李昉《太平广记》卷一百十八"},"example":{"text":"求所谓安亭江者，～。","book":"明·归有光《水利后论》"},"usage":"作谓语、定语；用于口语"},{"id":4245,"word":"了不相关","pinyin":"liǎo bù xiāng guān","abbr":"lbxg","explanation":"了：完全。完全不相干涉。指毫无关系。","source":{"text":"苟其有少或似，所当明辩于十目之严，至于了不相干，宁肯依违于众口之铄。","book":"宋·陈亮《谢留丞相启》"},"example":{"text":"但其识量不出针线蔬笋，数米量盐，抽丰告贷之中，古今上下哀乐，～。","book":"清·王夫之《姜斋诗话》"}},{"id":4246,"word":"了不相属","pinyin":"liǎo bù xiāng zhǔ","abbr":"lbxs","explanation":"了：完全。完全不相干涉。指毫无关系。","source":{"text":"苟其有少或似，所当明辩于十目之严，至于了不相干，宁肯依违于众口之铄。","book":"宋·陈亮《谢留丞相启》"},"example":{"text":"以尺限肘，以寸限指，截长续短，以为木偶，而生气生理，～。","book":"清·王夫之《尚书引义·毕命》"}},{"id":4247,"word":"了不相干","pinyin":"liǎo bù xiāng gān","abbr":"lbxg","explanation":"了：完全。完全不相干涉。指毫无关系。","source":{"text":"苟其有少或似，所当明辩于十目之严，至于了不相干，宁肯依违于众口之铄。","book":"宋·陈亮《谢留丞相启》"},"example":{"text":"鹏振本来还想说两句，然而夫人的谈锋甚健，不要为～两句话惹着她又谈个不歇。","book":"张恨水《金粉世家》第一百九回"}},{"id":4248,"word":"了不起","pinyin":"liǎo bù qǐ","abbr":"lbq","explanation":"极好或令人钦佩的，不平凡，优点突出。","source":{"text":"本县看她处心行事，竟是一个了不起的大豪杰，断不肯等闲失身。","book":"清·名教中人《好逑传》第七回"},"example":{"text":"毛泽东是中国历史上～的大人物。"},"similar":["了不得"],"usage":"作谓语、定语、宾语；用于口语"},{"id":4249,"word":"了不长进","pinyin":"liǎo bù zhǎng jǐn","abbr":"lbzj","explanation":"一点进步也没有。形容没有出息。","source":{"text":"身与君别多年，君义言了不长进。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"甥～，今且奈何。","book":"清·蒲松龄《聊斋志异·酒狂》"},"usage":"作谓语、定语；用于口语"},{"id":4250,"word":"了了可见","pinyin":"liǎo liǎo kě jiàn","abbr":"llkj","explanation":"了了：了然，清楚。清清楚楚，完全可以看得见。","source":{"text":"雪屋灯青客枕孤，眼中了了见归途。","book":"金·元好问《客意》"},"example":{"text":"原来他旅馆里的浴室，就在便所的间壁，从便所的玻璃窗里看去，浴室里的动静～。","book":"郁达夫《沉沦》"}},{"id":4251,"word":"了了解人意","pinyin":"liǎo bù jiě rén yì","abbr":"lljry","explanation":"了了：聪明，懂事。形容特别聪明懂事，善于体察领会别人的心思。","source":{"text":"阿戎了了解人意。","book":"南朝·宋·刘义庆《世说新语·赏誉上》"}},{"id":4252,"word":"了如指掌","pinyin":"liǎo rú zhǐ zhǎng","abbr":"lrzz","explanation":"了：明白；指掌：指着手掌。形容对事物了解得非常清楚，象把东西放在手掌里给人家看一样。","source":{"text":"孔子谓或人言知禘礼之说者，于天下之事，如指示掌中之物，言其易了。","book":"《论语·八佾》：“或问禘之说。子曰：‘不知也；知其说者之于天下也，其如示诸斯乎！’指其掌。”何晏集解引包咸曰"},"example":{"text":"只这一相形之下，美丑高低，便～了。","book":"闻一多《冬夜评论》"},"similar":["一目了然","一清二楚","洞若观火"],"opposite":["疑团莫释","一团漆黑"],"usage":"作谓语；指对事物十分了解","story":["古代帝王都要建始祖庙，在庙里按始祖的等级依次排列设置灵位，每逢有大的行动、节日，帝王们就进庙祭祖，称为“啰”礼。很多人对啰礼不理解，向孔子请教。孔子认为鲁国的宗庙违背了周礼，他避而不谈，指着手掌说：“知道啰礼的人治国就了如指掌"]},{"id":4253,"word":"了如观火","pinyin":"liǎo rú guān huǒ","abbr":"lrgh","explanation":"了：明白。形容看得非常清楚。","source":{"text":"今有河内来函，读之必了如观火，从此兄等之出而说人，必更有把握矣。","book":"邹鲁《戊甲云南河口之役》"},"similar":["洞若观火"],"usage":"作谓语、状语；指非常清楚"},{"id":4254,"word":"了无城府","pinyin":"liǎo wú chéng fǔ","abbr":"lwcf","explanation":"城府：城市和官署，指难以揣度的心机。比喻胸怀坦荡，无所隐藏。","source":{"text":"公性开爽宏达，了无城府。","book":"宋·楼钥《攻媿集·长江州汪公墓志铭》"}},{"id":4255,"word":"了无惧意","pinyin":"liǎo wū jǔ yì","abbr":"lwjy","explanation":"惧：害怕。没有一点害怕的神色。","source":{"text":"又使人将其弟子尽行，遣魁壮羯士衣甲持刀，临之以兵，并窃其所赐衣服而去，轲视而不信，了无惧色。","book":"《晋书·杨轲传》"},"example":{"text":"左右缚宁戚去,将行刑。戚颜色不变，～。","book":"明·冯梦龙《东周列国志》第十八回"}},{"id":4256,"word":"了无惧色","pinyin":"liǎo wū jǔ sè","abbr":"lwjs","explanation":"惧：害怕；色：神色。没有一点害怕的神色。","source":{"text":"又使人将其弟子尽行，遣魁壮羯士衣甲持刀，临之以兵，并窃其所赐衣服而去，轲视而不信，了无惧色。","book":"《晋书·杨轲传》"},"example":{"text":"贼令牵出杀之。张先行，～。贼方犹豫，张骂不绝口，遂遇害。","book":"《明史·列女传》"},"usage":"作谓语、定语；用于处事"},{"id":4257,"word":"了无所见","pinyin":"liǎo wú suǒ jiàn","abbr":"lwsj","explanation":"了：完全。完全不能看见。","source":{"text":"母语之，灵铣驰求之，了无所见。","book":"晋·干宝《搜神记》卷十四：“果复重来，发声如前。闻，便闭户，周旋室中，了无所见。”宋·李昉《太平广记》卷一百十八"},"example":{"text":"把火出看，～。","book":"鲁迅《古小说钩沉·述异记》"}},{"id":4258,"word":"了无遽容","pinyin":"liǎo wū jǔ róng","abbr":"lwjr","explanation":"遽：恐慌。完全没有恐慌的表情。形容从容镇定。","source":{"text":"孔融被收，中外惶怖，时融儿大者九岁，小者八岁，二儿故琢钉戏，了无遽容。","book":"南朝·宋·刘义庆《世说新语·言语》"}},{"id":4259,"word":"了然于中","pinyin":"liǎo rán yú zhōng","abbr":"lryz","explanation":"了然：了解、明白。心里非常明白。","source":{"text":"夫经略大事，故非常情所具，智者了于胸心，然后举无遗算耳。","book":"《晋书·袁齐传》"},"example":{"text":"那知姐姐不假思索，竟把前朝年号以及事迹，一挥而就。若非一部全史～，何能如此。","book":"清·李汝珍《镜花缘》第五十三回"}},{"id":4260,"word":"了然于心","pinyin":"liǎo rán yú xīn","abbr":"lryx","explanation":"了然：了解、明白。心里非常明白。","source":{"text":"夫经略大事，故非常情所具，智者了于胸心，然后举无遗算耳。","book":"《晋书·袁齐传》"},"example":{"text":"以故口不读信史，而是非～。","book":"陈去病《论戏剧之有益》"}},{"id":4261,"word":"了然于怀","pinyin":"liǎo rán yú huái","abbr":"lryh","explanation":"了然：了解，明白；怀：心怀。心里非常明白。","source":{"text":"了然此时心，无物可譬喻。","book":"唐·白居易《睡起晏坐》"}},{"id":4262,"word":"了然于胸","pinyin":"liǎo rán yú xiōng","abbr":"lryx","explanation":"了然：了解、明白。心里非常明白。","source":{"text":"夫经略大事……智者了然于胸。","book":"《晋书·袁齐传》"},"example":{"text":"怎样钦差就赏识，怎样钦差就批驳，他能～，预备停当。","book":"清·李宝嘉《官场现形记》第四十八回"},"usage":"作谓语、定语；用于处事"},{"id":4263,"word":"了然可见","pinyin":"liǎo rán kě jiàn","abbr":"lrkj","explanation":"了然：清楚。清清楚楚，完全可以看得见。","source":{"text":"伯陇自言 隋仁寿年生，说大业末事，了然可见。","book":"唐·无名氏《大唐传载》"},"example":{"text":"若知神气之所生者，即心之主者，即修于一，～矣。","book":"宋·张君房《云笈七签》卷五十九"}},{"id":4264,"word":"了然无闻","pinyin":"liǎo rán wú wén","abbr":"lrww","explanation":"了然；完全。完全没有听见。","source":{"text":"我便时常提这‘金玉’，你只管了然自若无闻的，方见得是待我重，而毫无此心了。","book":"清·曹雪芹《红楼梦》第二十九"}},{"id":4265,"word":"了若指掌","pinyin":"liǎo ruò zhǐ zhǎng","abbr":"lrzz","explanation":"了：明白；指掌：指着手掌。形容对事物了解得非常清楚，象把东西放在手掌里给人家看一样。","source":{"text":"孔子谓或人言知禘礼之说者，于天下之事，如指示掌中之物，言其易了。","book":"《论语·八佾》：“或问禘之说。子曰：‘不知也；知其说者之于天下也，其如示诸斯乎！’指其掌。”何晏集解引包咸曰"},"example":{"text":"仅二百数十言，而词家源流派别，～。","book":"清·况周颐《惠风词话续篇》卷一"},"similar":["了如指掌"],"opposite":["一团漆黑"],"usage":"作谓语；指十分清楚"},{"id":4266,"word":"了身脱命","pinyin":"liǒo shēn tuō mìng","abbr":"lstm","explanation":"犹言摆脱尘世羁绊，自由自在。","source":{"text":"感吾师度脱，将俺这弟子来提拔，我如今不遭王法，不受刑罚，至如我指空说谎瞒咱，这一场了身脱命亏他。","book":"元·郑廷玉《忍字记》第二折"},"usage":"作宾语、定语；用于书面语"},{"id":4267,"word":"了身达命","pinyin":"liǎo shēn dá mìng","abbr":"lsdm","explanation":"佛家用语，意思是对一生命运归宿看得开，无牵挂，超凡出世。亦指安身的地方。","source":{"text":"人问道亚仙的今生今世，则俺那郑元和可甚麽了身达命。","book":"元·石君宝《李亚仙花酒曲江池》第三折"},"example":{"text":"数载之前，已知鲁智深是个～之人。","book":"明·施耐庵《水浒全传》第九十回"},"similar":["安身立命"],"usage":"作谓语、定语；指了悟人生，通达事理"},{"id":4268,"word":"予人口实","pinyin":"yǔ rén kǒu shí","abbr":"yrks","explanation":"予：给予；口实：话柄。给人留下指责的话柄。","example":{"text":"我们不能～。"},"similar":["遗人口实"],"usage":"作谓语、定语；指办事不牢靠"},{"id":4269,"word":"予取予夺","pinyin":"yú qǔ yú duó","abbr":"yqyd","explanation":"从我处掠取。","source":{"text":"许多被目为可以予取予夺地得到财富的海岸，一处处都伸出了拳头来，变成了‘拳头海岸’。","book":"秦牧《拳头海岸》"},"similar":["予取予携"],"usage":"作谓语、状语；用于书面语"},{"id":4270,"word":"予取予携","pinyin":"yú qǔ yú xié","abbr":"yqyx","explanation":"从我处掠取。","source":{"text":"今且冻饿委沟壑，所馀更何长物之与有？予取予携，公等自为之！","book":"梁启超《克林威尔传》第五章"},"example":{"text":"为谋永远撤去我海关之屏障，以任其～。","book":"廖仲恺《农民运动所当注意之要点》"},"similar":["予取予夺"],"usage":"作谓语、状语；用于书面语"},{"id":4271,"word":"予取予求","pinyin":"yú qǔ yú qiú","abbr":"yqyq","explanation":"予：我。原指从我这里取，从我这里求。后指随心所欲，任意索取。","source":{"text":"唯我知女（汝），女专利而不厌，予取予求，不女疵瑕也。","book":"《左传·僖公七年》"},"example":{"text":"久之而增华加厉，铺张藻饰，～，无复体要。","book":"清·钱谦益《外制集序》"},"similar":["随心所欲"],"usage":"作谓语、宾语；指任意索取"},{"id":4272,"word":"予夺生杀","pinyin":"yǔ duó shēng shā","abbr":"ydss","explanation":"《周礼·天官、大宰》的“八柄”中有予、夺、生、诛（责备）等权力。后泛指帝王掌握的赏罚生死大权。","source":{"text":"五曰杀，六曰生，七曰予，八曰夺。","book":"《周礼·春官·内史》"},"example":{"text":"为人主者，～，各当其义。","book":"汉·董仲舒《春秋繁露·天地阴阳》"},"similar":["生杀予夺"],"usage":"作定语、宾语；指统治者的大权"},{"id":4273,"word":"予智予雄","pinyin":"yú zhì yú xióng","abbr":"yzyx","explanation":"自以为聪明和英雄。形容妄自尊大。","source":{"text":"他是一个极骄贪的人，以为自己所做的事都是对的，自己所得的物都是不够的，因之，予智予雄，任性妄为。","book":"范文澜 蔡美彪等《中国通史》第三编第一章第三节"},"usage":"作谓语、定语；用于书面语"},{"id":4274,"word":"予末小子","pinyin":"yú mò xiǎo zǐ","abbr":"ymxz","explanation":"帝王对“先王”时指对自己的称谓。常人用以表示自谦。","source":{"text":"王再拜，兴，答曰：‘眇眇予末小子，其能而乱四方以敬忌天威。’","book":"《尚书·顾命》"},"example":{"text":"～，遭家不造，人心已去，国命有归。","book":"《旧五代史·恭帝纪》"},"usage":"作主语、宾语；多用于自谦"},{"id":4275,"word":"予违汝弼","pinyin":"yú wéi rǔ bì","abbr":"ywrb","explanation":"违：过失；弼：纠正。我有过失，你就来纠正。古代帝王鼓励臣下随时纠正自己错误的话。","source":{"text":"予违汝弼，汝无面从，退有后言。","book":"《尚书·益稷》"},"example":{"text":"奋厉威严以震群工，喜谄谀而恶鲠直，厌封驳而乐顺从。古帝王～，似不如此。","book":"《明史·张养蒙传》"},"usage":"作宾语、定语；用于书面语"},{"id":4276,"word":"予齿去角","pinyin":"yǔ chǐ qù jiǎo","abbr":"ycqj","explanation":"指天生动物赋予齿就不赋予角。比喻事物无十全十美。","source":{"text":"谓牛无上齿则有角，其余无角者则有上齿。","book":"《汉书·董仲舒传》：“天亦有所分予，予之齿者去其角，傅其翼者两其足，是所受大者不得取小也……夫已受大，又取小，天不能足，而况人乎！”颜师古注"},"example":{"text":"荷生笑道：‘大抵花到极红，香气便觉减些，所以海棠说是无香。这也是～的意思。’","book":"清·魏秀仁《花月痕》第十一回"},"usage":"作宾语、定语；用于书面语"},{"id":4277,"word":"争先士卒","pinyin":"zhēng xiān shì zú","abbr":"zxsz","explanation":"士卒；士兵。士兵作战勇敢，争着向前。","source":{"text":"旌蔽日兮敌若云，矢交坠兮士争先。","book":"战国·楚·屈原《九歌·国殇》"},"similar":["身先士卒"],"usage":"作谓语、定语；指带头"},{"id":4278,"word":"争先恐后","pinyin":"zhēng xiān kǒng hòu","abbr":"zxkh","explanation":"抢着向前，唯恐落后。","source":{"text":"一个个争先恐后的直抢上来。","book":"清·张春帆《宦海》第十四回"},"example":{"text":"在学校举行的运动会上，各班同学～，奋力争先。"},"similar":["力争上游","争前恐后"],"opposite":["退避三舍"],"usage":"作谓语、状语；形容人的动作等","story":["春秋时期，赵襄子请王于期教他驾车技术，一段时间后他们进行比赛。王于期镇定自若，而赵襄子神色慌张，眼睛直看着王于期，争先恐后，结果输了，他不服就与王于期换马比赛，结果还是输。王于期告诉他驾车应该人马协调"]},{"id":4279,"word":"争光日月","pinyin":"zhēng guāng rì yuè","abbr":"zgry","explanation":"争：竞争。与太阳、月亮比光辉。常用以称赞人的精神、功业伟大。","source":{"text":"推此志也，虽与日月争光可也。","book":"《史记·屈原贾生列传》"},"example":{"text":"而文琼以闾阎匹夫，乃能抗志捐生，～。（《明史·汤文琼传》）"},"similar":["与日月争光"],"usage":"作谓语、定语；用于称赞等"},{"id":4280,"word":"争分夺秒","pinyin":"zhēng fēn duó miǎo","abbr":"zfdm","explanation":"一分一秒也不放过。形容充分利用时间。","source":{"text":"常语人曰：‘大禹圣者，乃惜寸阴，至于众人，当惜分阴。’","book":"《晋书·陶侃传》"},"example":{"text":"我们在学习上要～。"},"similar":["分秒必争"],"usage":"作宾语、定语；指爱惜时间"},{"id":4281,"word":"争前恐后","pinyin":"zhēng qián kǒng hòu","abbr":"zqkh","explanation":"蔡东藩《南北史演义》第五十五回：“欢乃麾兵直进，大众争前恐后，一涌而上，无复行列。”","source":{"text":"大家一听金娘要回来，好像吃了什么兴奋药，都～地搭竹架子，把各家存着的茅草搬出来。 ★许地山《桃金娘》"},"similar":["争先恐后"],"usage":"作谓语、状语；用于处事"},{"id":4282,"word":"争名于朝，争利于市","pinyin":"zhēng míng yú cháo，zhēng lì yú shì","abbr":"zmyczlys","explanation":"朝：朝廷。市：市场。在朝廷上争夺名位，在集市上计较赢利得失。即争名夺利。","source":{"text":"臣闻争名者于朝，争利者于市。","book":"《战国策·秦策一》"},"example":{"text":"宋·陈亮《孙天诚墓志铭》：“夫～，而善致富者则曰：‘人弃我取，人取我与。’”"},"usage":"作宾语、定语；用于处事"},{"id":4283,"word":"争名夺利","pinyin":"zhēng míng duó lì","abbr":"zmdl","explanation":"争夺名位和利益。","source":{"text":"争名夺利几时休？早起迟眠不自由！","book":"明·吴承恩《西游记》第一回"},"example":{"text":"我如今也谱得《道情》十首，无非唤醒痴聋，销除烦恼……若遇～之场，正好觉人觉世。","book":"清·关燮《序》"},"similar":["争权夺利"],"usage":"作谓语、宾语、定语；指名利心重"},{"id":4284,"word":"争名竞利","pinyin":"zhēng míng jìng lì","abbr":"zmjl","explanation":"争夺名位和利益。同“争名夺利”。","source":{"text":"争名竞利走如狂，复被利名生怨隙。","book":"宋·秦观《自警》诗"},"example":{"text":"明·施耐庵《水浒传》第14回：“金鸡三唱，唤做佳人傅粉施朱；宝马频嘶，催行客～。”"},"similar":["争名夺利"],"usage":"作谓语、定语、宾语；用于处事"},{"id":4285,"word":"争名逐利","pinyin":"zhēng míng zhú lì","abbr":"zmzl","explanation":"争夺名位和财利。","source":{"text":"臣闻争名者于朝，争利者于市。","book":"《战国策·秦策》"},"similar":["争名夺利","逐利争名"],"usage":"作谓语、宾语、定语；指名利心重"},{"id":4286,"word":"争多竞少","pinyin":"zhēng duō jìng shǎo","abbr":"zdjs","explanation":"为得到的多少而争吵。形容过分计较。","source":{"text":"不想家人路信，起初闻得贝氏焦躁，便覆在间壁墙上听他们争多竞少，直至放火烧屋，一句句听得十分仔细。","book":"明·冯梦龙《醒世恒言》卷三十"},"similar":["争多论少"],"usage":"作谓语、定语；指放不开"},{"id":4287,"word":"争多论少","pinyin":"zhēng duō lùn shǎo","abbr":"zdls","explanation":"为得到的多少而争吵。形容斤斤计较。","source":{"text":"昔日公公原分付莫要分开，还是二位伯伯总管在那里，扶持小儿女大了，但凭胡乱分些便罢，决不敢争多竞少。","book":"明·冯梦龙《醒世恒言》卷三十五"},"similar":["争多竞少"],"usage":"作谓语、定语；指放不开"},{"id":4288,"word":"争天抗俗","pinyin":"zhēng tiān kàng sú","abbr":"ztks","explanation":"争：斗争；抗：对抗。同大自然作斗争，与世俗偏见相对抗。形容敢于拼搏。","example":{"text":"人们群众在他的带领下～，终于取得了胜利"},"usage":"作谓语、定语；用于书面语"},{"id":4289,"word":"争奇斗异","pinyin":"zhēng qí dòu yì","abbr":"zqdy","explanation":"竞相争斗，标奇立异。","source":{"text":"吟坛才子争奇斗异，各献所长。","book":"明·凌濛初《初刻拍案惊奇》卷二十五"},"example":{"text":"清·李斗《扬州画舫录》第六卷：“一时～，不可胜记。”"},"usage":"作谓语、定语；用于书面语"},{"id":4290,"word":"争奇斗艳","pinyin":"zhēng qí dòu yàn","abbr":"zqdy","explanation":"奇：奇异；艳：色彩鲜艳。形容百花竞放，十分艳丽。","source":{"text":"名品相压，争妍斗奇，故者未厌，而新者已盛。","book":"宋·吴曾《能改斋漫录·方物·芍药谱》"},"example":{"text":"尤其令邓幺姑神往的，就是讲到成都一般大户人家的生活，以及妇女们～的打扮。","book":"李喆人《死水微澜》一"},"similar":["争妍斗艳"],"usage":"作谓语、定语；用于花卉"},{"id":4291,"word":"争妍斗奇","pinyin":"zhēng yán dòu qí","abbr":"zydq","explanation":"妍：美丽；奇：奇异。形容百花竞放，十分艳丽。","source":{"text":"名品相压，争妍斗奇，故者未厌，而新者已盛。","book":"宋·吴曾《能改斋漫录·方物·芍药谱》"},"similar":["争妍斗艳"],"usage":"作谓语、定语；指花或美女"},{"id":4292,"word":"争妍斗艳","pinyin":"zhēng yán dòu yàn","abbr":"zydy","explanation":"指竞相比美。","source":{"text":"五月过了，太阳增加了它的威力，树木都把各自的伞盖伸张了起来，不想再争妍斗艳的时候；有少数的树木却在这时开起了花来。","book":"郭沫若《丁东草·石榴》"},"example":{"text":"海滨公园内，热带的奇花异草，～。","book":"雨海《马来西亚的新兴城市——歌打基纳巴卢》"},"similar":["争奇斗艳","争妍斗奇"],"usage":"作谓语、定语；指花或美女"},{"id":4293,"word":"争妍竞艳","pinyin":"zhēng yán jìng yàn","abbr":"zyjy","explanation":"妍：美丽。形容百花竞放，十分艳丽。","source":{"text":"名品相压，争妍斗奇，故者未厌，而新者已盛。","book":"宋·吴曾《能改斋漫录·方物·芍药谱》"},"example":{"text":"转落英之曲径，经卧波之长桥。～，目炫心招。（明·朱之瑜《游后乐园赋》）"}},{"id":4294,"word":"争强好胜","pinyin":"zhēng qiáng hào shèng","abbr":"zqhs","explanation":"争：争夺；强：优胜；好：喜爱。争为强者，事事处处都喜欢超过和压倒别人。","source":{"text":"任是争强好胜的，偏逢用违所长。","book":"清·文康《儿女英雄传》第35回"},"example":{"text":"个人的～，狗屁不值。","book":"杨朔《北线》"},"similar":["争先恐后","争权夺利","争名夺利"],"opposite":["甘居下游","甘拜下风"],"usage":"作谓语、宾语、定语；指人的个性"},{"id":4295,"word":"争强斗狠","pinyin":"zhēng qiáng dòu hěn","abbr":"zqdh","explanation":"犹争强好胜。","source":{"text":"譬如我们每一个人都爱争强斗狠，但是又爱贪懒好闲，在这儿便种下了堕落的种子。","book":"郭沫若《屈原》第一幕"},"similar":["争强斗胜","争强好胜"],"usage":"作谓语、宾语、定语；指人的个性"},{"id":4296,"word":"争强斗胜","pinyin":"zhēng qiáng dòu shèng","abbr":"zqds","explanation":"犹争强好胜。","source":{"text":"定要丧了那羞恶的良心，戴了鬼脸，千方百计，争强斗胜的去奉承那王振做甚？","book":"清·西周生《醒世姻缘传》第十五回"},"similar":["争强斗狠","争强好胜"],"usage":"作谓语、宾语、定语；用于处事"},{"id":4297,"word":"争强显胜","pinyin":"zhēng qiáng xiǎn shèng","abbr":"zqxs","explanation":"犹争强好胜。争为强者，事事处处都喜欢超过和压倒别人。","source":{"text":"恐怕他褒贬村，争强显胜各挝俊，惟求鸨儿心内喜。","book":"《群音类选·北腔类·海神记·王魁诉神》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":4298,"word":"争斤论两","pinyin":"zhēng jīn lùn liǎng","abbr":"zjll","explanation":"指在细枝末节上与人相争理论。","source":{"text":"你不要过分～。"},"example":{"text":"你不要过分～"},"similar":["斤斤计较"],"opposite":["宽宏大量"],"usage":"作谓语、宾语；指人放不开"},{"id":4299,"word":"争权夺利","pinyin":"zhēng quán duó lì","abbr":"zqdl","explanation":"争夺权力和利益。","source":{"text":"臣闻争名者于朝，争利者于市。","book":"《战国策·秦策》"},"example":{"text":"他们就只晓得～，草菅人命。","book":"郭沫若《蔡文姬》第三幕"},"similar":["明争暗斗","争名夺利"],"opposite":["和平共处","退避三舍","明哲保身"],"usage":"作主语、谓语、宾语、定语；指人的权欲很强"},{"id":4300,"word":"争权攘利","pinyin":"zhēng quán rǎng lì","abbr":"zqrl","explanation":"争夺权力和利益。同“争权夺利”。","source":{"text":"钻营运动、争权攘利之不暇，奚暇计及民生哉？","book":"李大钊《大哀篇》"},"similar":["争权夺利"],"usage":"作谓语、宾语、定语；用于处事"},{"id":4301,"word":"争猫丢牛","pinyin":"zhēng māo diū niú","abbr":"zmdn","explanation":"为了争夺猫而丢了牛。比喻贪小失大。","source":{"text":"真正是争得猫儿丢了牛。","book":"清·李绿园《歧路灯》第七十回"},"similar":["争鸡失羊","因小失大"],"usage":"作谓语、宾语、定语；指因小失大"},{"id":4302,"word":"争短论长","pinyin":"zhēng duǎn lùn cháng","abbr":"zdlc","explanation":"犹争长竞短。","source":{"text":"当下一边是落难之际，一边是富厚之家，并不消争短论长，已自一说一中。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"example":{"text":"姚雪垠《李自成》第一卷第五章：“尽管孙传庭这个人锋芒太露，有时他也～，但是他总是从大处着眼，对一些不愉快的事一笑置之。”"},"similar":["争长竞短","争长论短","争长争短"],"usage":"作谓语、定语；用于处事"},{"id":4303,"word":"争红斗紫","pinyin":"zhēng hóng dòu zǐ","abbr":"zhdz","explanation":"形容百花争艳的景象。","source":{"text":"元·无名氏《张协状元·开场》：”陌上争红斗紫，窗外莺啼燕语，花落满庭空。“"},"usage":"作谓语、定语；用于书面语"},{"id":4304,"word":"争荣夸耀","pinyin":"zhēng róng kuā yào","abbr":"zrky","explanation":"争夺荣誉，夸耀自己。","source":{"text":"想起此言，不觉将素日想着后来争荣夸耀之心尽皆灰了，眼中不觉滴下泪来。","book":"清·曹雪芹《红楼梦》第三十一回"},"usage":"作谓语、定语；用于处事"},{"id":4305,"word":"争锋吃醋","pinyin":"zhēng fēng chī cù","abbr":"zfcc","explanation":"为争夺男女私情而互相嫉妒。同“争风吃醋”。","source":{"text":"凤丫头倒好意待他，他倒这样争锋吃醋，可知是个贱骨头。","book":"清·曹雪芹《红楼梦》第六十九回"},"example":{"text":"他待和他睡觉，凭他一夜两夜，就是十来宿，我也知不道甚么是～。","book":"清·西周生《醒世姻缘传》第二回"},"similar":["争风吃醋"],"usage":"作谓语、定语；用于处事"},{"id":4306,"word":"争长争短","pinyin":"zhēng cháng zhēng duǎn","abbr":"zzzd","explanation":"长、短：指是与非。争论谁是谁非。多指在不大重要的事情上过于计较。","source":{"text":"因娶妇入门，异姓相聚，争长竞短，渐渍日闻。","book":"宋·柳开《穆夫人墓志铭》"},"example":{"text":"为利图名呵！如燕雀营巢，～；如狼虎竞食，以掩四人。（明·无名氏《渔樵闲话》第二折）"},"similar":["争长竞短","争长论短","争短论长"],"usage":"作谓语、定语、宾语；用于处事"},{"id":4307,"word":"争长相雄","pinyin":"zhēng cháng xiāng xióng","abbr":"zzxx","explanation":"争相为长为雄。","source":{"text":"势如争长相雄。","book":"清·严复《天演论》"},"usage":"作谓语、宾语；指竞争"},{"id":4308,"word":"争长竞短","pinyin":"zhēng cháng jìng duǎn","abbr":"zcjd","explanation":"计较细小出入；争竞谁上谁下。","source":{"text":"人家兄弟无不义者，盖因娶妇入门，异姓相聚，争长竞短，渐渍日闻，以至背戾，分门割户。","book":"宋·黄庭坚《书寄祝有道》"},"example":{"text":"只因刘璞病势愈重，恐防不妥，单要哄媳妇到了家里，便是买卖了。故此将错就错，更不～。","book":"明·冯梦龙《醒世恒言》第八卷"},"similar":["争长争短","争长论短","争短论长"],"usage":"作谓语、定语、宾语；用于处事"},{"id":4309,"word":"争长论短","pinyin":"zhēng cháng lùn duǎn","abbr":"zcld","explanation":"长、短：指是与非。争论谁是谁非。多指在不大重要的事情上过于计较。","source":{"text":"竞短争长，无复此梦。","book":"宋·陈亮《谢张侍御启》"},"example":{"text":"那矿师本来还想同柳知府～，听见金委员如此一说，也就罢手。","book":"清·李宝嘉《文明小史》第五回"},"similar":["争多论少","斤斤计较"],"opposite":["甘拜下风","自认晦气"],"usage":"作谓语、定语；指争论"},{"id":4310,"word":"争长黄池","pinyin":"zhēng zhǎng huáng chí","abbr":"zzhc","explanation":"长：首领；黄池：春秋时地名。春秋时吴王、晋王在黄池会面，争做盟长。现比喻争夺权力，占据上风。","source":{"text":"晋定公三十年，定公与吴王夫差争长于黄池，赵简子从晋定公，卒长吴。","book":"《史记·赵世家》"},"example":{"text":"于时匈奴骄倨，勾吴不朝，既争长于黄池，亦饮马于清渭。（《隋书·裴仁基传》）"},"usage":"作宾语、定语；用于书面语"},{"id":4311,"word":"争风吃醋","pinyin":"zhēng fēng chī cù","abbr":"zfcc","explanation":"争：嬜，争夺；风：风韵，多指女子。指因男女关系而妒忌、争吵。","source":{"text":"那时我争风吃醋便迟了。","book":"明·冯梦龙《醒世恒言》卷一"},"example":{"text":"凌家这两个婆娘，彼此疑惑，你疑惑我多得了主子的钱，我疑惑你多得了主子的钱，～争吵起来。","book":"清·吴敬梓《儒林外史》第四十五回"},"similar":["妒贤嫉能","争锋吃醋"],"opposite":["见贤思齐"],"usage":"作谓语、定语；用于女性"},{"id":4312,"word":"争鸡失羊","pinyin":"zhēng jī shī yáng","abbr":"zjsy","explanation":"比喻贪小失大。","source":{"text":"争鸡失羊，亡其金囊。","book":"汉·焦延寿《易林》卷八"},"similar":["因小失大"],"usage":"作谓语、宾语、定语；指因小失大"},{"id":4313,"word":"事不关己","pinyin":"shì bù guān jǐ","abbr":"sbgj","explanation":"事情同自己没有关系。","source":{"text":"当时的风气是谨言慎行，少发议论，事不关己，不必打听，因此对这一次大征战的命将出师，一直不甚了了。","book":"《曹雪芹别传》"},"example":{"text":"～，高高挂起；明知不对，少说为佳；明哲保身，但求无过。","book":"毛泽东《反对自由主义》"},"similar":["漠不关心","无关痛痒"],"opposite":["息息相关","相依为命"],"usage":"作宾语、分句；指事情同自己没有关系"},{"id":4314,"word":"事不关己，高高挂起","pinyin":"shì bù guān jǐ，gāo gāo guà qǐ","abbr":"sbgjgggq","explanation":"认为事情与己无关，把它搁在一边不管。","source":{"text":"事不关己，高高挂起；明知不对，少说为佳；明哲保身，但求无过。这是第三种。","book":"毛泽东《反对自由主义》"},"example":{"text":"～的做法是行不通的。"},"similar":["漠不关心"],"usage":"作宾语、定语、分句；指事情同自己没有关系"},{"id":4315,"word":"事不宜迟","pinyin":"shì bù yí chí","abbr":"sbyc","explanation":"宜：可以，应该。事情要抓紧时机快做，不宜拖延。","source":{"text":"事不宜迟，收拾了便令媒人速去。","book":"元·贾仲名《萧淑兰》第四折"},"example":{"text":"好计！我和你便去，～。","book":"明·施耐庵《水浒全传》第二回"},"similar":["刻不容缓","时不我待","当务之急"],"opposite":["来日方长","旷日持久"],"usage":"作谓语、分句；指不宜拖延"},{"id":4316,"word":"事不师古","pinyin":"shì bù shī gǔ","abbr":"sbsg","explanation":"形容做事不吸取前人经验。","source":{"text":"事不师古，以克永世，匪说攸闻。","book":"《尚书·说命下》"},"example":{"text":"～，始罢封侯之制，立郡县之官。","book":"《隋书·百官志上》"},"usage":"作谓语、定语；指做事不遵守古训"},{"id":4317,"word":"事不有余","pinyin":"shì bù yǒu yú","abbr":"sbyy","explanation":"谓达到极点。","source":{"text":"娘儿俩先哭了个事不有余，大家劝住，他便忙着到祠堂行礼。","book":"清·文康《儿女英雄传》第四十回"},"example":{"text":"那婆子乐了个～，然后大家方才动身。","book":"清·石昆玉《三侠五义》第五十三回"},"usage":"作宾语、定语；用于书面语"},{"id":4318,"word":"事不过三","pinyin":"shì bù guò sān","abbr":"sbgs","explanation":"指同样的事不宜连作三次。","source":{"text":"常言道：‘事不过三。’我若不去，真是个下流无耻之徒。","book":"明·吴承恩《西游记》第二十七回"},"example":{"text":"太公叫媳妇：“～，又有人来得不好。”","book":"《明成化说唱词话丛刊·包待制出身传》"},"usage":"作宾语、定语；用于口语"},{"id":4319,"word":"事与原违","pinyin":"shì yǔ yuán wéi","abbr":"syyw","explanation":"事实与愿望相违背。"},{"id":4320,"word":"事与心违","pinyin":"shì yù xīn wéi","abbr":"syxw","explanation":"事实与愿望相违背。同“事与原违”。","source":{"text":"貌先年老因忧国，事与心违始乞身。","book":"北齐·魏收《魏书·王叡传》：“诚思竭尽力命，以报所受，不谓事与心违，忽婴重疾。”宋·欧阳修《纪德陈情上致政太傅杜相公》诗"},"example":{"text":"相逢暗惹平生恨，西州路，～。","book":"清·陈维崧《金菊对芙蓉·姜学在扫墓归过访》词"},"similar":["事与愿违"],"opposite":["得心应手"],"usage":"作宾语、定语；用于处事"},{"id":4321,"word":"事与愿违","pinyin":"shì yǔ yuàn wéi","abbr":"syyw","explanation":"事实与愿望相反。指原来打算做的事没能做到。","source":{"text":"事与愿违，遘兹淹留。","book":"三国魏·嵇康《幽愤》诗"},"example":{"text":"不料后来～，现在这点局面小得很，应酬不开！","book":"茅盾《子夜》十六"},"similar":["大失所望","适得其反"],"opposite":["得心应手","万事亨通","如愿以偿"],"usage":"作谓语、定语、宾语；指事实与愿望相反"},{"id":4322,"word":"事事无成","pinyin":"shì shì wú chéng","abbr":"sswc","explanation":"连一样事情也没有做成。指什么事情都做不成。形容毫无成就。","source":{"text":"事事无成身也老，醉乡不去欲何归。","book":"唐·白居易《醉吟》诗"}},{"id":4323,"word":"事事躬亲","pinyin":"shì shì gōng qīn","abbr":"ssgq","explanation":"躬亲：亲自。不论什么事一定要亲自去做，亲自过问。形容办事认真，毫不懈怠。","source":{"text":"以教导之，必躬亲之。","book":"《诗经·小雅·节南山》：“弗躬弗亲，庶民弗信。”《礼记·月令》"},"example":{"text":"所以反不及他做典史的，倒可以～，实事求是。","book":"清·李宝嘉《官场现形记》第二回"}},{"id":4324,"word":"事以密成","pinyin":"shì yǐ mì chéng","abbr":"symc","explanation":"事情因为严密谨慎而成功。","source":{"text":"事以密成，语以泄败。","book":"《韩非子·说难》"},"usage":"作宾语、定语；用于书面语"},{"id":4325,"word":"事修傍兴","pinyin":"shì xiū bàng xīng","abbr":"sxbx","explanation":"修：整治；谤：诽谤；兴：兴起。事情一进行整治，诽谤也就会兴起。指革新者总会受保守者的诽谤。","source":{"text":"事修而谤兴，德高而毁来。","book":"唐·韩愈《原毁》"}},{"id":4326,"word":"事倍功半","pinyin":"shì bèi gōng bàn","abbr":"sbgb","explanation":"指工作费力大，收效小。","source":{"text":"故事半古之人，功必倍之。","book":"《孟子·公孙丑上》"},"example":{"text":"把这民间事业整顿得件件整齐，桩桩发达，这岂不是～吗？","book":"清·梁启超《新中国未来记》第三回"},"similar":["得不偿失","舍本求末"],"opposite":["事半功倍"],"usage":"作谓语、宾语、定语；指收效小"},{"id":4327,"word":"事关重大","pinyin":"shì guān zhòng dà","abbr":"sgzd","explanation":"事情关系着大局，非常重要。","source":{"text":"事关重大，只怕你三人难保无罪。","book":"明·罗贯中《粉妆楼》第二十九回"},"example":{"text":"不是三言两语可以说完，可是～。","book":"姚雪垠《李自成》第三卷第五十一章"},"usage":"作谓语、宾语；多用于口语"},{"id":4328,"word":"事出不意","pinyin":"shì chū bù yì","abbr":"scby","explanation":"事情的发生出乎意料。","source":{"text":"京以攸被诏同至，乃置酒留贯，攸亦预焉，京以事出不意，一时失措。","book":"宋·周辉《清波杂志》卷二"},"example":{"text":"明·姚茂良《双忠记》第29出：“谁想命运乖违，～。”"},"similar":["出乎意料"],"usage":"作谓语、定语；用于书面语"},{"id":4329,"word":"事出意外","pinyin":"shì chū yì wài","abbr":"scyw","explanation":"指出乎人的意料之外的事情。","source":{"text":"那老姑子见宝玉来了，事出意外，竟象天上掉下个活龙来的一般，忙上来问好，命老道来接马。","book":"清·曹雪芹《红楼梦》第43回"},"example":{"text":"～，我们得尽快采取对策。"},"similar":["出人意料"],"usage":"作宾语、定语；指出人意料"},{"id":4330,"word":"事出无奈","pinyin":"shì chū wú nài","abbr":"scwn","explanation":"事情出于无可奈何。指迫不得已只能如此。","source":{"text":"而今我们匆匆进京去了，心下如割，却是事出无奈。","book":"明·凌濛初《二刻拍案惊奇·同窗友认假作真》"},"example":{"text":"～，只得措置银子，……虽不致卖家掘产，也未免挪衣剥当。","book":"清·张南庄《何典》第二回"},"similar":["出于无奈"],"usage":"作谓语、状语；用于处事"},{"id":4331,"word":"事出有因","pinyin":"shì chū yǒu yīn","abbr":"scyy","explanation":"事情的发生是有原因的。","source":{"text":"郭道台就替他洗刷清楚，说了些‘事出有因，查无实据’的话头，禀复了制台。","book":"清·李宝嘉《官场现形记》第四回"},"example":{"text":"但是一想到～，他就只好假装没有听见。","book":"叶圣陶《四三集·得失》"},"similar":["理所当然","顺理成章"],"opposite":["平白无故","莫名其妙"],"usage":"作谓语、宾语、分句；用于事物"},{"id":4332,"word":"事到万难须放胆","pinyin":"shì dào wàn nán xū fà dǎn","abbr":"sdwnxfd","explanation":"事情遇到重重困难时，必须拿出全部胆识去干。","example":{"text":"“～”，我们决定利用今昨两天被消灭和被打垮的三个营敌人的番号伪装自己，欺骗敌人。","book":"《回忆长征·飞夺泸定桥》"}},{"id":4333,"word":"事到临头","pinyin":"shì dào lín tóu","abbr":"sdlt","explanation":"事情已经落到头上。形容事情紧迫。","source":{"text":"今吕郤等尚且背叛，事到临头，召我等何用。","book":"明·冯梦龙《东周列国志》第三十六回"},"example":{"text":"～，也不得不如此了。只好明日前往南清宫便了。","book":"清·石玉昆《三侠五义》第十七回"}},{"id":4334,"word":"事半功倍","pinyin":"shì bàn gōng bèi","abbr":"sbgb","explanation":"指做事得法，因而费力小，收效大。","source":{"text":"故事半古之人，功必倍之，惟此时为然。","book":"《孟子·公孙丑上》"},"example":{"text":"如能善用他的特长和经验，比较地容易获得～的效果。","book":"邹韬奋《经历·前途》"},"similar":["一举两得","一箭双雕","事半功百"],"opposite":["得不偿失","舍近求远","事倍功半"],"usage":"作谓语、宾语、定语；指做事得法","story":["战国时期，孟子问公孙丑如何看待统一中国，他说周文王施行仁政，使国家富强而最终消灭昏庸残暴的商纣王。现在拥有万辆兵车泱泱大国的齐国，如果能施行仁政，老百姓就会安居乐业，外面的人会来归顺，只做一半的事收到成倍的效果"]},{"id":4335,"word":"事半功百","pinyin":"shì bàn gōng bǎi","abbr":"sbgb","explanation":"指做事得法，因而费力小，收效大。同“事半功倍”。","source":{"text":"因利乘便，事半功百，而元所未有也。","book":"清·魏源《道光丙戌海运记》"},"similar":["事半功倍"],"opposite":["事倍功半"],"usage":"作谓语、宾语、定语；指做事得法"},{"id":4336,"word":"事危累卵","pinyin":"shì wēi lěi luǎn","abbr":"swll","explanation":"事情危险得像堆起来的蛋一样。形容极端危险。","source":{"text":"故曹小国也，而迫于晋楚之间，其君之危，犹累卵也。","book":"战国·韩·韩非《韩非子·十过》"},"example":{"text":"现在是～的时候，我们千万要慎重。"},"similar":["危如累卵"],"opposite":["安如泰山"],"usage":"作宾语、定语；指局势极端危险","story":["春秋时期，晋灵公为了享乐，要建一座九层高的楼台，造了三年还没有造好，弄得民不聊生，晋灵公还不准大臣劝谏。荀息想了一计，在晋灵公面前先用12个棋子垒在一起，然后在上面垒九个鸡蛋，最后鸡蛋倒下砸碎。晋灵公明白后下令停工"]},{"id":4337,"word":"事变知人心","pinyin":"shì biàn zhī rén xīn","abbr":"sbzrx","explanation":"在事情发生的变化中，才能考察出一个人的真实思想和品德。","example":{"text":"好，连李宝堂这老家伙也反对咱了，这多年的饭都喂了狗啦！真是～啦！","book":"丁玲《太阳照在桑干河上》三十七"}},{"id":4338,"word":"事同虚设","pinyin":"shì tóng xū shè","abbr":"stxs","explanation":"形式上具备了某种设置，实际上并不起作用。","source":{"text":"把头烽内并未添兵镇守，事同虚设。","book":"唐·李德裕《条疏太原以北边备事宜状》"}},{"id":4339,"word":"事后聪明","pinyin":"shì hòu cōng míng","abbr":"shcm","explanation":"事情过去以后，才悟出其中的原由和应付的办法。"},{"id":4340,"word":"事后诸葛亮","pinyin":"shì hòu zhū gé liàng","abbr":"shzgl","explanation":"比喻事后自称有先见之明的人。","source":{"text":"不是我事后诸葛亮，决定拉武装时我就说过，我们不拉出去，郭忠还可以存在，因为引不起小岛的注意。","book":"向春《煤城怒火》第二二章"},"example":{"text":"有些人把～当做了一种讽刺，如果对于那种……临事毫无主张、事后就哇啦哇啦的人，讽刺是应该的。","book":"马南邨《燕山夜话·三种诸葛亮》"},"similar":["放马后炮"],"usage":"作主语、宾语、定语；指放马后炮的人"},{"id":4341,"word":"事在人为","pinyin":"shì zài rén wéi","abbr":"szrw","explanation":"指事情要靠人去做的。在一定的条件下，事情能否做成要看人的主观努力如何。","source":{"text":"事在人为耳，彼朽骨者何知。","book":"明·冯梦龙《东周列国志》第六十九回"},"example":{"text":"俗语说～，只要你勤奋努力，一定能有所作为。"},"similar":["人定胜天"],"opposite":["听天由命","无能为力"],"usage":"作宾语、分句；用于劝诫人"},{"id":4342,"word":"事在必行","pinyin":"shì zài bì xíng","abbr":"szbx","explanation":"事情已经非做不可了。","source":{"text":"如孙武令，事在必行，有犯无恕。","book":"宋·苏轼《东坡志林·养生说》"},"example":{"text":"明·冯梦龙《东周列国志》第66回：“～，何卜之有？”"},"similar":["势在必行"],"usage":"作谓语、定语；指非做不可"},{"id":4343,"word":"事在萧墙","pinyin":"shì zài xiāo qiáng","abbr":"szxq","explanation":"谓祸乱出自内部。事，变故；萧墙，宫室内当门的小墙。","source":{"text":"吾恐季孙之忧，不在颛臾，而在萧墙之内也。","book":"语出《论语·季氏》"},"example":{"text":"衅起他族，～。","book":"唐·李公佐《南柯太守传》"},"similar":["祸起萧墙"],"usage":"作谓语、宾语、定语；指内乱"},{"id":4344,"word":"事实胜于雄辩","pinyin":"shì shí shèng yú xióng biàn","abbr":"sssyxb","explanation":"事情的真实情况比喻雄辩更有说服力。","source":{"text":"现在拟态的制服早已破碎，显出自身的本相来了，真所谓‘事实胜于雄辩’。","book":"鲁迅《题记》"},"example":{"text":"～。一贯火暴性子的乡长，这回不得不认错了。","book":"柳青《创业史》第二部第八章"},"usage":"作宾语、分句；指用事实说话"},{"id":4345,"word":"事宽则圆","pinyin":"shì kuān zé yuán","abbr":"skzy","explanation":"遇到事情只要从容对待，就能圆满解决。款：宽缓。同“事款则圆”。","source":{"text":"此人本是一勇之夫，不难取他，只是攻击得紧，他必死命相拒。看来此事，事宽则圆，急难成效。","book":"清·俞万春《荡寇志》第一百三十一回：“闻达暗想道"},"example":{"text":"姐姐不要性急，～。","book":"清·石玉昆《三侠五义》第八十九回"}},{"id":4346,"word":"事宽即圆","pinyin":"shì kuān jí yuán","abbr":"skjy","explanation":"谓遇事只要从容对待，就能圆满解决。款，宽缓。同“事款则圆”。","source":{"text":"只怕事大难回，所以踌躇延捱……事宽即圆，支得他去，再可商量。","book":"清·褚人获《隋唐演义》第四十四回"},"example":{"text":"秋鸿道：“哭也没用，～。”","book":"清·佚名《明珠缘》第十五回"},"similar":["事款则圆"],"usage":"作宾语、定语；用于书面语"},{"id":4347,"word":"事往日迁","pinyin":"shì wǎng rì qiān","abbr":"swrq","explanation":"指事情和时光都已过去。","source":{"text":"感悟遂晚，事往日迁。","book":"唐·李白《雪谗诗赠友人》"},"similar":["事过境迁"],"usage":"作谓语、定语；指事情等"},{"id":4348,"word":"事必躬亲","pinyin":"shì bì gōng qīn","abbr":"sbgq","explanation":"躬亲：亲自。不论什么事一定要亲自去做，亲自过问。形容办事认真，毫不懈怠。","source":{"text":"弗躬弗亲，庶民弗信。","book":"《诗·小雅·节南山》"},"example":{"text":"于舅太爷却勤勤恳恳，～，于这位外甥的事格外当心。","book":"清·李宝嘉《官场现形记》第五十九回"},"similar":["身体力行","一本正经"],"opposite":["游手好闲","好吃懒做"],"usage":"作谓语、定语；指亲历亲为"},{"id":4349,"word":"事怕行家","pinyin":"shì pà háng jiā","abbr":"sphj","explanation":"行家：内行人。事情即使很难，行家也能轻松处理。"},{"id":4350,"word":"事急无君子","pinyin":"shì jí wú jūn zǐ","abbr":"sjwjz","explanation":"谓人到紧急关头，就顾不得讲规矩、礼貌了。","source":{"text":"邦杰道：‘好一匹马，不知何人的？如今事急无君子，只得借他来骑骑。’","book":"清·钱彩《说岳全传》"},"example":{"text":"叔宝跟进城门，～，当街跪下禀道：‘小的是山东济南府解户，伺候老爷领回批。","book":"清·褚人获《隋唐演义》第七回"},"usage":"作宾语、定语；用于口语"},{"id":4351,"word":"事急计生","pinyin":"shì jí jì shēng","abbr":"sjjs","explanation":"急事临头，能想出办法来。","source":{"text":"左右劝友珪，事急计生，何不早自为图。","book":"《新五代史·梁家人传》"},"example":{"text":"元礼顾不得别人，～，耸身跳出后窗。","book":"明·冯梦龙《醒世恒言》卷二十一"}},{"id":4352,"word":"事捷功倍","pinyin":"shì jié gōng bèi","abbr":"sjgb","explanation":"事情易办而功效很大。","source":{"text":"既示必死之期，又开可生之路，利害悬殊，事捷功倍。","book":"清·侯方域《上三省督府剿抚议》"},"usage":"作宾语、定语；用于书面语"},{"id":4353,"word":"事无三不成","pinyin":"shì wú sān bù chéng","abbr":"swsbc","explanation":"谓办事非经多次努力不会轻易成功。","source":{"text":"常言道，事无三不成，你进洞两遭了，再进去一遭，管情救出师父来也。","book":"明·吴承恩《西游记》第八十三回"},"example":{"text":"老嬷嬷道：“只怕说他不过。虽然如此，常言道，～。这遭却是两遭了，老身只得替你再回他去。”","book":"明·凌濛初《二刻拍案惊奇》卷二"},"usage":"作宾语、定语；多用于劝诫人"},{"id":4354,"word":"事无不可对人言","pinyin":"shì wú bù kě duì rén yán","abbr":"swbkdry","explanation":"没有什么样事情不可公开。","source":{"text":"平生所为，未尝有不可对人言者。","book":"语出《宋史·司马光传》"},"example":{"text":"他无私心，在党内没有要隐藏的事情，‘～’。","book":"刘少奇《论共产党员的修养》六"},"usage":"作宾语、定语；用于书面语"},{"id":4355,"word":"事无二成","pinyin":"shì wú èr chéng","abbr":"swec","explanation":"谓公事和私事不能两全。","source":{"text":"公私不两成。","book":"《左传·成公八年》：“礼无加货，事无二成。”杜预注"},"usage":"作宾语、定语；用于书面语"},{"id":4356,"word":"事无大小","pinyin":"shì wú dà xiǎo","abbr":"swdx","explanation":"事情不分大小。形容什么事都管。","source":{"text":"委萧瑀以庶政，事无大小，莫不关掌。","book":"《文选·诸葛亮〈出师表〉》：“愚以为宫中之事，事无大小，悉以咨之。”宋·司马光《资治通鉴》卷第一百八十五"},"example":{"text":"却说诸葛丞相在于成都，～，皆亲自从公决断。","book":"明·罗贯中《三国演义》第八十七回"},"similar":["事无巨细"],"usage":"作宾语、定语、分句；用于口语"},{"id":4357,"word":"事无巨细","pinyin":"shì wú jù xì","abbr":"swjx","explanation":"事情不分大小。形容什么事都管。同“事无大小”。","source":{"text":"政事无巨细咸于亮。","book":"《三国志·诸葛亮传》"},"example":{"text":"曾未期月，援溺振渴，～，悉究本末。","book":"宋·邵博《闻见后录》卷十五"},"similar":["事无大小"],"usage":"作宾语、定语、分句；用于口语"},{"id":4358,"word":"事无常师","pinyin":"shì wú cháng shī","abbr":"swcs","explanation":"谓处事没有固定不变的准则，要择善而从。","source":{"text":"主善为师，故无常师。","book":"春秋·王诩《鬼谷子·忤合》：“世无常贵，事无常师。”陶弘景注"},"usage":"作宾语、定语；用于书面语"},{"id":4359,"word":"事有必至，理有固然","pinyin":"shì yǒu bì zhì，lǐ yǒu gù rán","abbr":"sybzlygr","explanation":"事情是必然要发生的，道理本来就该这样。指某些事情无论怎样防止，还是要出现，这是按照事物固有的规律发生发展的，是无法改变的。","source":{"text":"看官们有所未知，从来事有必至，理有固然。","book":"清·吴璿《飞龙全传》第二十九回"}},{"id":4360,"word":"事核言直","pinyin":"shì hé yán zhí","abbr":"shyz","explanation":"事情确实，文辞直捷。","source":{"text":"其文直，其事核。","book":"语出《汉书·司马迁传赞》"},"example":{"text":"然且一人绘一图，一图叙一事，附一赞，～，理明词约，直闺壸之箴鉴也。","book":"明·沈德符《野获编补遗·刑部·重刊闺范序》"},"usage":"作宾语、定语；用于书面语"},{"id":4361,"word":"事款则圆","pinyin":"shì kuǎn zé yuán","abbr":"skzy","explanation":"谓遇事只要从容对待，就能圆满解决。款，宽缓。","source":{"text":"你老人家不要著急，这可是急不来的事，事款则圆。","book":"清·文康《儿女英雄传》第七回：“事款则圆，你且住啼哭，休得叫骂。”又第二十五回"},"similar":["事宽即圆"],"usage":"作宾语、定语；用于书面语"},{"id":4362,"word":"事火咒龙","pinyin":"shì huǒ zhòu lóng","abbr":"shzl","explanation":"比喻荒诞不经之事。事火，指祀火为神；咒龙，指咒龙请雨。"},{"id":4363,"word":"事烦食少","pinyin":"shì fán shí shǎo","abbr":"sfss","explanation":"每日处理的事务非常繁重，可吃饭很少。形容工作辛劳，身体不佳。","source":{"text":"先是，亮使至，帝问曰：‘诸葛公起居何如？食可几（许）米？’对曰：‘三四升。’次问政事，曰：‘二十罚已上皆自省览。’帝既而告人曰：‘诸葛孔明其能久乎！’","book":"《晋书·宣帝纪》"}},{"id":4364,"word":"事生肘腋","pinyin":"shì shēng zhǒu yè","abbr":"sszy","explanation":"肘腋：胳肢窝。比喻事变就发生在身边。","source":{"text":"主公之在公安也，北畏曹公之强，东惮孙权之逼，近则惧孙夫人生变于肘腋之下，当斯之时，进退狼跋。","book":"《三国志·蜀志·法正传》"},"example":{"text":"景崧守台的失败，原因全在李文魁的内变，这种内变，～，无从预防。","book":"清·曾朴《孽海花》第三十二"},"similar":["变生肘腋"],"usage":"作谓语、定语；指身边的事变"},{"id":4365,"word":"事穷势迫","pinyin":"shì qióng shì pò","abbr":"sqsp","explanation":"事情陷入了困境，形势紧迫逼人。","source":{"text":"见疑强大，怀不自安，事穷势迫，卒谋叛逆，终于灭亡。","book":"《汉书·韩信等传赞》"},"example":{"text":"不然，民怨于内，敌逼于外，～，何所不至，陛下虽谋臣如云，猛将如雨，亦不知所以为策矣。","book":"清·毕沅《续资治通鉴》卷一六八"}},{"id":4366,"word":"事缓则圆","pinyin":"shì huǎn zé yuán","abbr":"shzy","explanation":"碰到事情不要操之过急，而要慢慢地设法应付，可以得到圆满的解决。","source":{"text":"看来此事，事宽则圆，急难成效。","book":"清·俞万春《荡寇志》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“同时他也劝她要耐心，～，心太急反倒生出意外的障碍。”"},"similar":["从长计议","步步为营"],"opposite":["操之过急"],"usage":"作谓语、宾语、分句；指人办事的态度"},{"id":4367,"word":"事败垂成","pinyin":"shì bài chuí chéng","abbr":"sbcc","explanation":"事情在快要成功时失败了。","source":{"text":"九仞为山，功亏一篑，料想不劳而集，事败垂成。","book":"明·梁辰鱼《浣纱记·乞降》"},"example":{"text":"我们再也不能出现～的事情。"},"similar":["功败垂成"],"usage":"作宾语、定语；指功败垂成"},{"id":4368,"word":"事过境迁","pinyin":"shì guò jìng qiān","abbr":"sgjq","explanation":"境：境况；迁：改变。事情已经过去，情况也变了。","source":{"text":"黄绣球与黄通理事过境迁，已不在心上。","book":"清·颐琐《黄绣球》第三回"},"example":{"text":"而且～，记忆力又衰退，更不免有记错讲错的事。","book":"巴金《谈〈憩园〉》"},"similar":["时过境迁","时移俗易","沧海桑田"],"opposite":["一成不变","记忆犹新"],"usage":"作谓语、宾语、分句；同“时过境迁”"},{"id":4369,"word":"事过情迁","pinyin":"shì guò qíng qiān","abbr":"sgqq","explanation":"随着事情过去，对该事的感情、态度也起了变化。","source":{"text":"然我国人之热度几何，只恐事过情迁，不数月而渐归消灭。","book":"《五四爱国运动资料·青岛潮·处州同乡会公电》"},"usage":"作宾语、定语；用于处事等"},{"id":4370,"word":"事过景迁","pinyin":"shì guò jǐng qiān","abbr":"sgjq","explanation":"事情已经过去，情况也变了。同“事过境迁”。","source":{"text":"到了事实完全弄清楚的时侯，有些问题又事过景迁了，心里感到十分懊恼。","book":"马南邨《燕山夜话·“放下即实地”》"},"similar":["事过境迁","时过境迁"],"usage":"作谓语、宾语、分句；多用于感叹"},{"id":4371,"word":"事重身衰","pinyin":"shì zhòng shēn shuāi","abbr":"szss","explanation":"担负重任而身体衰弱。形容力不胜任。","source":{"text":"因年景渐老，事重身衰，又近因在外几年，骨肉离异，今得晏然复聚于庭室，自觉喜幸不尽。","book":"清·曹雪芹《红楼梦》第七十一回"}},{"id":4372,"word":"事非前定","pinyin":"shì fēi qián dìng","abbr":"sfqd","explanation":"事情并不是事先注定的。指事在人为。","source":{"text":"予以谓不然，事非前定。","book":"宋·沈括《梦溪笔谈》卷二十"},"example":{"text":"世间底～，妙理还须问浊醪。","book":"宋·郭应祥《鹧鸪天》词"}},{"id":4373,"word":"事非经过不知难","pinyin":"shì fēi jīng guò bù zhī nán","abbr":"sfjgbzn","explanation":"没有亲身经历过的事情，就不知道它的艰难。","source":{"text":"事非经过不知难。当下无意演说，竟自下台，勉强把名单取出，交给议长，自己垂头丧气，踱出院门，乘舆竟去。","book":"蔡东藩、许廑父《民国通俗演义》第十二回"},"example":{"text":"～，没有韩子奇在家里当家做主，韩太太才知道了掌管一个大买卖是多么的不容易。","book":"霍达《穆斯林的葬礼》第十三章"}},{"id":4374,"word":"事预则立","pinyin":"shì yù zé lì","abbr":"syzl","explanation":"指无论做什么事，事前有准备就会成功，没有准备就要失败。","source":{"text":"凡事预则立，不预则废。","book":"《礼记·中庸》"},"usage":"作宾语、定语；用于书面语"},{"id":4375,"word":"事齐事楚","pinyin":"shì qí shì chǔ","abbr":"sqsc","explanation":"事：侍奉；齐、楚：春秋时两大强国。依附齐国呢？还是依附楚国？比喻处在两强之间，不能得罪任何一方。","source":{"text":"滕，小国也，间于齐楚，事齐乎？事楚乎？","book":"战国·邹·孟轲《孟子·梁惠王下》"},"example":{"text":"吾悲夫吾同胞之成～任人掬抛之天性也。","book":"清·邹容《革命军》第一章"},"usage":"作谓语、定语；指处理两者关系"},{"id":4376,"word":"二一添作五","pinyin":"èr yī tiān zuò wǔ","abbr":"eytzw","explanation":"本是珠算除法的一句口诀，是二分之一等于零点五的意思。比喻双方平分。","source":{"text":"好好儿的‘二一添作五’的家当，如今弄成‘三一三十一’了。","book":"清·石玉昆《三侠五义》第二回"},"example":{"text":"当下三人定了主见，就招人盘受，不多几天，交易都算清了，自然都是～的分了。","book":"清·吴研人《九命奇冤》第二回"},"similar":["一分为二"],"usage":"作谓语、分句；比喻双方平分"},{"id":4377,"word":"二三其德","pinyin":"èr sān qí dé","abbr":"esqd","explanation":"二三：不专一。形容三心二意。","source":{"text":"士也罔极，二三其德。","book":"《诗经·卫风·氓》"},"example":{"text":"我旧许甘家二郎，因家贫远途，遂绝耗问。近方归，复闻郎家～，背弃前盟。","book":"清·蒲松龄《聊斋志异·阿英》"},"similar":["三心二意","二三其节"],"opposite":["一心一意"],"usage":"作定语、补语；形容三心二意"},{"id":4378,"word":"二三其意","pinyin":"èr sān qí yì","abbr":"esqy","explanation":"即三心二意。指心意不专一，反复无常。","source":{"text":"是时外为御难，内实乞罪，既不见赦，而屠各二三其心，临阵叛戾。","book":"《三国志·袁绍传》裴松之注引《汉晋春秋》"},"example":{"text":"任之专而惑于人言，～，又不行。","book":"明·冯梦龙《东周列国志》第八十七回"},"similar":["二三其德","三心二意"],"opposite":["专心致志"],"usage":"作定语、补语；形容三心二意"},{"id":4379,"word":"二三其操","pinyin":"èr sān qí cāo","abbr":"esqc","explanation":"二三：指不专一。三心二意，没有一定的操守。形容心意不专，反复无常。","source":{"text":"贫不陨获其心，穷不二三其操。","book":"南朝·梁·任昉《求为刘献立馆启》"},"similar":["二三其德","二三其节"],"usage":"作定语、补语；形容三心二意"},{"id":4380,"word":"二三其节","pinyin":"èr sān qí jié","abbr":"esqj","explanation":"二三：不专一；节：节操。不能坚持操守。","source":{"text":"语曰奕者举棋不定犹不胜其偶，况量君之才否而二三其节，可以摧服强邻，囊括四海者乎？","book":"《三国志·蜀志·诸葛亮传》裴松之注引孙盛曰"},"similar":["二三其德","二三其操"],"usage":"作定语、补语；形容三心二意"},{"id":4381,"word":"二三君子","pinyin":"èr sān jūn zǐ","abbr":"esjz","explanation":"犹二三子。","source":{"text":"故下明诏，试《左氏》可立不，遣近臣奉指衔命，将以辅弱扶微，与二三君子比意同力，冀得废遗。","book":"《左传·僖公二十四年》：“主晋祀者，非君而谁，天实置之，而二三子以为己力，不亦诬乎。”《汉书·楚元王传》"},"example":{"text":"六十老翁无所取，～不相遗。","book":"唐·包佶《戏题诸判官厅壁》诗"}},{"id":4382,"word":"二五耦","pinyin":"èr wǔ ǒu","abbr":"ewo","explanation":"耦：两人耕地，比喻朋比为奸。比喻狼狈为奸。","source":{"text":"二五耦。","book":"春秋·鲁·左丘明《左传·庄公二十八年》"},"usage":"作宾语、定语；用于口语","story":["晋献公时期，晋国内部矛盾很尖锐，斗争很激烈。晋献公的妾骊姬勾结献公所宠幸的梁五和东关憵五，替自己的儿子夺取君位。当时人称之为“二五耦”"]},{"id":4383,"word":"二人同心","pinyin":"èr rén tóng xīn","abbr":"ertx","explanation":"比喻只要两个人齐心协力，就会无往不胜。","source":{"text":"二人同心，其利断金；同心之言，其臭如兰。","book":"《周易·系辞上》"},"example":{"text":"若彼～，非我之利也。","book":"明·周楫《西湖二集·胡少保平倭战功》"},"similar":["二人同心，其利断金"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":4384,"word":"二人同心，其利断金","pinyin":"èr rén tóng xīn，qí lì duàn jīn","abbr":"ertxqldj","explanation":"比喻只要两个人一条心，就能发挥很大的力量。","source":{"text":"二人同心，其利断金；同心之言，其臭如兰。","book":"《周易·系辞上》"},"example":{"text":"～。山主可细参之。","book":"清·李绿园《歧路灯》第七十三回"},"similar":["二人同心"],"usage":"作宾语、分句；用于劝诫人"},{"id":4385,"word":"二仙传道","pinyin":"èr xīn chuán dào","abbr":"excd","explanation":"两位神仙一起传授道法。比喻两从秘密地配合做成某件事。","source":{"text":"貂鼠皮道：‘二仙传道去罢！’珍珠串瞅了一眼，笑的去讫。","book":"清·李绿园《歧路灯》第56回"},"example":{"text":"我们还是用尽办法，有时甚至用‘～’办法邮寄。","book":"曹靖华《素笺寄深情》"},"usage":"作宾语、定语；用于书面语"},{"id":4386,"word":"二八佳人","pinyin":"èr bā jiā rén","abbr":"ebjr","explanation":"二八：指十六岁；佳人：美女。十五六岁的美女。","source":{"text":"二八佳人细马驮，十千美酒渭城歌。","book":"宋·苏轼《李铃辖座上分题戴花》诗"},"example":{"text":"若有～陪伴前往，再累也值得。"},"similar":["二八女郎"],"opposite":["半老徐娘"],"usage":"作主语、宾语、定语；指年轻女子"},{"id":4387,"word":"二八女郎","pinyin":"èr bā nǚ láng","abbr":"ebnl","explanation":"二八：指十六岁。十五六岁的美女。指年轻貌美的女子。","source":{"text":"见车幔洞开，内坐二八女郎，红妆艳丽。","book":"清·蒲松龄《聊斋志异·瞳人语》"},"similar":["二八佳人"],"opposite":["半老徐娘"],"usage":"作主语、宾语、定语；指年轻女子"},{"id":4388,"word":"二八年华","pinyin":"èr bā nián huá","abbr":"ebnh","explanation":"二八：指十六岁。十五六岁的好年华。指人最美好的青春时代。"},{"id":4389,"word":"二分明月","pinyin":"èr fēn míng yuè","abbr":"efmy","explanation":"古人认为天下明月共三分，扬州独占二分。原用于形容扬州繁华昌盛的景象。今用以比喻当地的月色格外明朗。","source":{"text":"萧娘脸上难生泪，桃叶眉头易得愁。天下三分明月夜，二分无赖是扬州。","book":"唐·徐凝《忆扬州》诗"},"example":{"text":"十里画图新阆苑，～旧扬州。","book":"清·李斗《扬州画舫录》卷十"},"usage":"作宾语；表示美好的风光","story":["扬州自古就是有名的地方，在《禹贡》中就提到扬州是天下九州之一，后来各个朝代都有扬州这一设置。隋炀帝为了游览扬州，特地开凿运河。唐朝诗人徐凝在《忆扬州》诗中写道：“天下三分明月夜，二分无赖是扬州。”赞扬扬州的繁华"]},{"id":4390,"word":"二卵弃干城","pinyin":"èr luǎn qì gān chéng","abbr":"elqgc","explanation":"卵：鸡蛋；干城：捍卫者。比喻因人有小的过失而忽略他的大节。","source":{"text":"今君处战国之世，选爪牙之士而以二卵焉弃干城之将，此不可使闻于邻国者也。","book":"《孔丛子·居卫》"},"example":{"text":"似娘儿，～，救张苍幸藉王陵。","book":"明·张凤翼《红拂记·奉征高丽》"},"usage":"作宾语、定语；用于用人","story":["战国时期，子思向卫君举荐苟变为将。卫君也晓得苟变是个将才，但因为他在一次征赋时曾经吃过百姓的两个鸡蛋，所以没有任用他。子思说用人应该“用其所长，弃其所短”，不能因为吃过别人的两个鸡蛋而放弃大将之才"]},{"id":4391,"word":"二姓之好","pinyin":"èr xìng zhī hǎo","abbr":"exzh","explanation":"指两家困婚姻关系而成为亲戚。","source":{"text":"昏礼者，将合二姓之好，上以事宗庙，而下以济后世也。故君子重之。","book":"《礼记·昏义》"},"example":{"text":"明日，令媒氏通～，备六礼以迎之。","book":"唐·白行简《李娃传》"},"similar":["秦晋之好"],"usage":"作宾语；指联姻"},{"id":4392,"word":"二帝三王","pinyin":"èr dì sān wáng","abbr":"edsw","explanation":"二帝：唐尧、虞舜；三王：夏禹、商汤、周文王。指古代帝王。","source":{"text":"昔在二帝三王……财足以奉郊庙、御宾客，充庖厨而已。","book":"东汉·班固《汉书·扬雄传》"},"example":{"text":"如吾徒者，宜当告之以～之道。","book":"唐·韩愈《送浮屠文畅师序》"},"similar":["三皇五帝"],"usage":"作主语、定语；指古代的帝王"},{"id":4393,"word":"二心三意","pinyin":"èr xīn sān yì","abbr":"exsy","explanation":"想这样又想那样。形容意念不专，主意不定。同“三心二意”。","source":{"text":"念佛是一桩正事，岂有二心三意？","book":"明·方汝浩《禅真逸史》第六回"}},{"id":4394,"word":"二心两意","pinyin":"èr xīn liǎng yì","abbr":"exly","explanation":"形容意志不专一、不坚定。","source":{"text":"夫天地之神，用心等也。人民无状，加罪行罚，非有二心两意，前后相反也。","book":"汉·王充《论衡·閑时》"},"example":{"text":"做事不能～的。"},"similar":["三心二意"],"opposite":["专心致志"],"usage":"作宾语、定语；指不专一"},{"id":4395,"word":"二惠竞爽","pinyin":"èr huì jìng shuǎng","abbr":"ehjs","explanation":"二惠：齐惠王的孙子公孙灶和公孙虿；竞爽：刚强而精明。比喻两兄弟都是好样的。","source":{"text":"二惠竞爽犹可，又弱一个焉，姜其危哉。","book":"《左传·昭公三年》"},"example":{"text":"言兄弟齐芳，曰～。","book":"宋·胡继宗《书言故事·兄弟类》"},"similar":["兰惠齐芳"],"usage":"作宾语、补语；指对人兄弟的称颂之辞"},{"id":4396,"word":"二意三心","pinyin":"èr yì sān xīn","abbr":"eysx","explanation":"形容犹豫不决，拿不定主意或意志不坚定。","source":{"text":"我怎肯二意三心，背意忘恩，有始无终。","book":"元·杨梓《豫让吞炭》第二折"},"similar":["三心二意","三心两意"],"opposite":["全心全意"],"usage":"作谓语、宾语、状语；指不专心"},{"id":4397,"word":"二把刀","pinyin":"èr bǎ dāo","abbr":"ebd","explanation":"称对某项工作知识不足、技术不高的人。","source":{"text":"我只会搭棚这点手艺，我的拳脚不过是二把刀。","book":"老舍《四世同堂》二十九"},"example":{"text":"他是一个十足的～。"},"similar":["半桶水"],"usage":"作宾语、定语；指水平不高"},{"id":4398,"word":"二旬九食","pinyin":"èr xún jiǔ shí","abbr":"exjs","explanation":"二十天中仅吃过九顿饭。形容生活极其贫困。","source":{"text":"子思居于卫，缊袍无表，二旬而九食。","book":"汉·刘向《说苑·立节》"},"usage":"作宾语、定语；用于生活"},{"id":4399,"word":"二杆子","pinyin":"èr gān zǐ","abbr":"egz","explanation":"指人的脾气莽撞、火爆。","source":{"text":"这些各村集中起来的‘二杆子’后生，在公社武装专干的带领下，在集市上没收农民的猪肉、粮食和一切当时禁卖的东西。","book":"路遥《平凡的世界》第一卷第五章"},"example":{"text":"你那～劲儿也该改改了。"},"usage":"作宾语、定语；用于口语"},{"id":4400,"word":"二桃三士","pinyin":"èr táo sān shì","abbr":"etss","explanation":"士：武士。春秋时齐景公将两个桃子赐给公孙接、田开疆、古冶子论功而食，三人弃桃自杀。比喻借刀杀人。","source":{"text":"一朝被谗言，二桃杀三士。","book":"三国·蜀·诸葛亮《梁甫吟》"},"example":{"text":"迟暮仍为《梁甫吟》，～费沉吟。","book":"潘飞声《秋感》诗"},"similar":["二桃杀三士"],"usage":"作宾语、定语、分句；比喻借刀杀人","story":["春秋时期，齐国有三个勇士公孙接、田开疆、古冶子，他们居功自傲，蛮不讲理，相国晏婴担心他们会闹事而影响国家安危，建议齐景公赐两个桃子让他们三人论功而食，结果他们有勇无谋，因争吃桃子纷纷自杀身亡"]},{"id":4401,"word":"二桃杀三士","pinyin":"èr táo shā sān shì","abbr":"etsss","explanation":"将两个桃子赐给三个壮士，三壮士因相争而死。比喻借刀杀人。","source":{"text":"《宴子春秋·谏下二十四》"},"example":{"text":"～，讵假剑如霜。","book":"唐·李白《惧谗》诗"},"similar":["借刀杀人","二桃三士"],"usage":"作宾语、定语、分句；比喻借刀杀人","story":["春秋时期，齐国有三个勇士公孙接、田开疆、古冶子，他们居功自傲，蛮不讲理，相国晏婴担心他们会闹事而影响国家安危，建议齐景公赐两个桃子让他们三人论功而食，结果他们有勇无谋，因争吃桃子纷纷自杀身亡"]},{"id":4402,"word":"二次三番","pinyin":"èr cì sān fān","abbr":"ecsf","explanation":"番：次、遍。不止一次的，反复的。","source":{"text":"他二次三番的邀我去逛逛。","book":"清·文康《儿女英雄传》第四十回"},"similar":["三番两次","几次三番"],"usage":"作状语；表示重复"},{"id":4403,"word":"二流子","pinyin":"èr liú zǐ","abbr":"elz","explanation":"不务正业游手好闲的人。","source":{"text":"他父亲后来成了前后村庄有名的二流子。","book":"路遥《平凡的世界》第一卷第五章"},"example":{"text":"他是一个～。"},"usage":"作主语、宾语、定语；用于口语"},{"id":4404,"word":"二满三平","pinyin":"èr mǎn sān píng","abbr":"emsp","explanation":"比喻生活过得去，很满足。同“三平二满”。","source":{"text":"小屈穹庐，胆二满三平，共劳均佚。","book":"宋·陈亮《三部乐·七月送丘宗卿使虏》词"},"example":{"text":"～，粗衣淡饭，钟鼎山林。","book":"宋·洪咨夔《柳梢青·老人生日》词"},"similar":["三平二满"],"usage":"作宾语、定语；用于生活"},{"id":4405,"word":"二百五","pinyin":"èr bǎi wǔ","abbr":"ebw","explanation":"指傻头傻脑，不很懂事而又倔强莽撞的人。","source":{"text":"原来他是一个江南不第秀才，捐了个二百五的同知，在外面瞎混。","book":"清·吴趼人《二十年目睹之怪现状》第83回"},"example":{"text":"他是个十足的～。"},"similar":["傻头傻脑"],"usage":"作主语、宾语、定语；用于口语骂人"},{"id":4406,"word":"二竖为灾","pinyin":"èr shù wéi zāi","abbr":"eswz","explanation":"竖：小子；二竖：指病魔。比喻疾病缠身。","source":{"text":"公疾病，求医于秦。秦伯使医缓为之。未至，公梦疾为二竖子，曰：‘彼良医也，惧伤我，焉逃之？’其一曰：‘居肓之上，膏之下，若我何？’","book":"春秋·鲁·左丘明《左传·成公十年》"},"example":{"text":"本想与诸公同心协力，保持国家，怎奈～，竟致不起。","book":"蔡东藩《民国通俗演义》第22回"},"similar":["二竖为虐"],"usage":"作谓语、定语；比喻疾病缠身","story":["春秋时期，晋国国君晋景公得了重病，梦见体内有两个小孩，一个说名医来了快逃吧，一个则说躲到膏肓之间。秦桓公派名医缓前去为其治病，把好脉后摇头叹息说：“大王的病已经到了肓上面，膏下面，药力是无法到达的。”没过多久，晋景公就病死了"]},{"id":4407,"word":"二竖为烈","pinyin":"èr shù wéi liè","abbr":"eswl","explanation":"竖：小子；二竖：指病魔；烈：暴。比喻疾病缠身。","source":{"text":"公疾病，求医于秦。秦伯使医缓为之。未至，公梦疾为二竖子，曰：‘彼良医也，惧伤我，焉逃之？’其一曰：‘居肓之上，膏之下，若我何？’","book":"《左传·成公十年》"},"example":{"text":"明知二竖之为烈，然不敢攻也。","book":"明·朱之瑜《答安东守约书三十首》"}},{"id":4408,"word":"二竖为虐","pinyin":"èr shù wéi nüè","abbr":"eswn","explanation":"竖：小子；二竖：指病魔；虐：侵害。比喻疾病缠身。","source":{"text":"公疾病，求医于秦。秦伯使医缓为之。未至，公梦疾为二竖子，曰：‘彼良医也，惧伤我，焉逃之？’其一曰：‘居肓之上，膏之下，若我何？’","book":"春秋·鲁·左丘明《左传·成公十年》"},"example":{"text":"他这段时间～，闭门不出。"},"similar":["疾病缠身","病入膏肓"],"usage":"作谓语、定语；比喻疾病缠身","story":["春秋时期，晋国国君晋景公得了重病，梦见体内有两个小孩，一个说名医来了快逃吧，一个则说躲到膏肓之间。秦桓公派名医缓前去为其治病，把好脉后摇头叹息说：“大王的病已经到了肓上面，膏下面，药力是无法到达的。”没过多久，晋景公就病死了"]},{"id":4409,"word":"二竖作恶","pinyin":"èr shù zuò è","abbr":"esze","explanation":"竖：小子；二竖：指病魔。比喻疾病缠身。","source":{"text":"公疾病，求医于秦。秦伯使医缓为之。未至，公梦疾为二竖子，曰：‘彼良医也，惧伤我，焉逃之？’其一曰：‘居肓之上，膏之下，若我何？’","book":"《左传·成公十年》"},"example":{"text":"自谓摄生莫我若，反招二竖来作恶。","book":"清·彭蕴章《知病吟》"}},{"id":4410,"word":"二童一马","pinyin":"èr tóng yī mǎ","abbr":"etym","explanation":"用以指少年时代的好友。","source":{"text":"殷侯既废，桓公语诸人曰：‘少时与渊源共骑竹马，我弃去，己辄取之，故当出我下。’","book":"南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"烦借问，～，几时入尉瞻仪？","book":"宋·刘克庄《汉宫春·陈尚书生日》词"},"similar":["青梅竹马"],"usage":"作宾语、定语；同“青梅竹马”"},{"id":4411,"word":"二缶钟惑","pinyin":"èr fǒu zhōng huò","abbr":"efzh","explanation":"二：疑，不明确；缶、钟：指古代量器。弄不清缶与钟的容量。比喻弄不清普通的是非道理。","source":{"text":"以二缶钟惑，而所适不得矣。","book":"战国·宋·庄周《庄子·天地》"},"example":{"text":"己既自迷，又使他人沦陷，陷入迷惘，岂直～而已乎？","book":"章炳麟《驳康有为论革命书》"},"usage":"作宾语、补语；指人分不清是非","story":["战国时期，哲学家庄周在《庄子》中讲述“二缶钟惑”的道理：有三人同做一事，一人迷惑则事可成；有两人迷惑，事则不成。现在天下人都迷惑了，高雅的思想进入不了人们的意识，而对低级庸俗的东西感兴趣，就像对缶钟的容量搞不清一样"]},{"id":4412,"word":"二缶锺惑","pinyin":"èr fǒu zhōng huò","abbr":"efzh","explanation":"指对缶和钟两种盛器的容量大小分不清楚。比喻是非不明。","source":{"text":"以二缶锺惑，而所适不得矣。","book":"《庄子·天地》"},"example":{"text":"己既自迷，又使他人沦陷，岂直～而已乎？","book":"章炳麟《驳康有为论革命书》"}},{"id":4413,"word":"二罪俱罚","pinyin":"èr zuì jù fá","abbr":"ezjf","explanation":"前后两桩罪过，一并处罚。","source":{"text":"赢了将功折过，输了二罪俱罚。","book":"元·无名氏《飞刀对箭》第二折"},"example":{"text":"你既上界违法，今又不改凶心，伤生造孽，却不是～？","book":"明·吴承恩《西游记》第八回"},"similar":["二罪并罚"],"usage":"作谓语、宾语；用于处事"},{"id":4414,"word":"二者不可得兼","pinyin":"èr zhě bù kě dé jiān","abbr":"ezbkdj","explanation":"两项之中只能得其一，不能兼而有之。","source":{"text":"鱼，我所欲也；熊掌，亦我所欲也，二者不可得兼，舍鱼而取熊掌者也。","book":"《孟子·告子上》"},"example":{"text":"你一方面要顾着你们的孝道，一方面又看着眼前的危险；可是～。","book":"老舍《二马》三"},"similar":["不可兼得"],"usage":"作谓语、定语；用于选择"},{"id":4415,"word":"二者必取其一","pinyin":"èr zhě bì qǔ qí yī","abbr":"ezbqqy","explanation":"只能在两者中选择其中的一种。","source":{"text":"两种方针：放还是收呢？二者必取其一。","book":"毛泽东《在中国共产党全国宣传工作会议上的讲话》"},"similar":["二者必居其一"],"usage":"作宾语、定语、分句；指两种选其一"},{"id":4416,"word":"二者必居其一","pinyin":"èr zhě bì jū qí yī","abbr":"ezbjqy","explanation":"居：占。只能在两者中选择其中的一种。","source":{"text":"前日之不受是，今日之受非也；今日之受是，则前日之不受非也。夫子居一于此矣。","book":"战国·邹·孟轲《孟子·公孙丑下》"},"example":{"text":"而如果要谈判，则只有取消这个毫无理由的‘决议’，～。","book":"《毛泽东选集·中共发言人评南京行政院的决议》"},"similar":["二者必取其一"],"usage":"作宾语、定语、分句；指两种选其一","story":["战国时期，孟子带学生去齐国，提了建议不被采纳就离开齐国，齐王送他100金，他推辞不受。而到了宋国却接受70金，到了薛国接受50金。学生陈臻对此不解，这两种行为对错二者必居其一。孟子耐心地分析当时的具体情况，陈臻认为有道理"]},{"id":4417,"word":"二而一","pinyin":"èr ér yī","abbr":"eey","explanation":"一演化为二，二合成为一。指同一事物可以演化为对立的两种现象，对立的两种现象可以找到同一根源。","source":{"text":"我回答说：‘这是二而一的事情，并不矛盾。’","book":"冯玉祥《我的生活》第30章"},"similar":["一而二，二而一"],"usage":"作宾语、定语；用于事物"},{"id":4418,"word":"二虎相斗，必有一伤","pinyin":"èr hǔ xiāng dòu，bì yǒu yī shāng","abbr":"ehxdbyys","explanation":"两只凶恶的老虎争斗起来，其中必有一只受伤。比喻敌对双方实力都很强，激烈斗争的结果，必有一方吃亏。","source":{"text":"这叫做二虎相斗，必有一伤，待他伤了一个，便容易了。","book":"明·烟霞散人《斩鬼传》第四回"},"example":{"text":"～，我们收拾残局吧！"},"usage":"作宾语、定语、分句；用于两派对立斗争"},{"id":4419,"word":"二话不说","pinyin":"èr huà bù shuō","abbr":"ehbs","explanation":"不说任何别的话。指立即行动。","source":{"text":"‘日本鬼子完蛋了，投降了，’方六低声回答。丁约翰象在教堂里说‘阿门’那样，把眼睛闭了一闭。二话不说，回头就跑。","book":"老舍《四世同堂》九八"},"example":{"text":"来到岸边，～，驾起船，直奔河心。","book":"《为了六十一个阶级弟兄》"},"similar":["二话没说"],"opposite":["喋喋不休"],"usage":"作谓语、状语；指干脆"},{"id":4420,"word":"二话没说","pinyin":"èr huà méi shuō","abbr":"ehms","explanation":"指很干脆地采取行动。","source":{"text":"正说中间，门外雷石柱慌慌张张进来，一把拉住老武，二话没说，往外就走。","book":"马烽、西戎《吕梁英雄传》"},"example":{"text":"她～接着就干。"},"similar":["二话不说"],"usage":"作状语；指干脆"},{"id":4421,"word":"二道贩子","pinyin":"èr dào fàn zǐ","abbr":"edfz","explanation":"指非法地买进卖出商品以获利的商贩。","source":{"text":"人民币魔力无边，只要肯出高价，二道贩子手里有的是软卧票。","book":"路遥《平凡的世界》第五卷第13章"},"example":{"text":"她靠做～发家致富。"},"similar":["贩夫贩妇"],"usage":"作宾语、定语；指小贩"},{"id":4422,"word":"二龙戏珠","pinyin":"èr lóng xì zhū","abbr":"elxz","explanation":"两条龙相对，戏玩着一颗宝珠。","source":{"text":"头上戴着束发嵌宝紫金冠，齐眉勒着二龙戏珠金抹额。","book":"清·曹雪芹《红楼梦》第三回"},"usage":"作宾语、定语；用于建筑及工艺品等"},{"id":4423,"word":"于事无补","pinyin":"yú shì wú bǔ","abbr":"yswb","explanation":"对事情毫无补益。","source":{"text":"七姑奶奶深怕言语碰僵，不但于事无补，反倒伤了和气，所以特为先打招呼。","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"大错已经铸成，你再责备他也～。"},"similar":["无济于事","无补于事"],"usage":"作谓语；用于口语"},{"id":4424,"word":"于今为烈","pinyin":"yú jīn wéi liè","abbr":"yjwl","explanation":"烈：厉害。某件事过去就已经有过，不过现在的更加厉害罢了。","source":{"text":"殷受夏，周受殷，所不辞也，于今为烈，如之何其受之？","book":"《孟子·万章下》"},"example":{"text":"“古已有之”，“～”，我近来很有些怕敢看他了。","book":"鲁迅《华盖集续编的续编·厦门通信二》"},"usage":"作谓语、定语；指事情的发展"},{"id":4425,"word":"于呼哀哉","pinyin":"yú hū āi zāi","abbr":"yhaz","explanation":"于呼：感叹词。哉：语气词。原意感叹或悲哀。又用于祭文，表示对死者的哀悼。","source":{"text":"乱世恶善，不此听也。淤乎哀哉，不得成也。","book":"《诗·大雅·召旻》：“于乎哀哉！维今之人，不尚有旧。”《荀子·乐论》"}},{"id":4426,"word":"于安思危","pinyin":"yú ān sī wēi","abbr":"yasw","explanation":"于：处于；思：想。虽然处在平安的环境里，也想到有出现危险的可能。指随时有应付意外事件的思想准备。","source":{"text":"臣闻之《春秋》，于安思危，危则虑安。","book":"《战国策·楚策四》"},"similar":["居安思危"],"usage":"作谓语、宾语；用于自勉"},{"id":4427,"word":"于家为国","pinyin":"yú jiā wéi guó","abbr":"yjwg","explanation":"为国家为人民。","source":{"text":"正直无私有至灵，于家为国保庶民，祈晴祷雨皆显应，掌管经书文卷中。","book":"明·无名氏《贺元宵》第一折"},"example":{"text":"明·无名氏《四马投唐》第二折：“据元帅济世才施宽厚，～，端的是分破圣人忧。”"},"usage":"作谓语、定语；用于书面语"},{"id":4428,"word":"于归之期","pinyin":"yū guī zhī qī","abbr":"ygzq","explanation":"于归：出嫁。姑娘出嫁的日子。","source":{"text":"之子于归，宜其家室。","book":"《诗经·周南·桃夭》"}},{"id":4429,"word":"于心不忍","pinyin":"yú xīn bù rěn","abbr":"yxbr","explanation":"从心里常觉得忍不下去。多表示对受害者的同情。","source":{"text":"这个凶手如今无故打死了我们中国人，倘若就此轻轻放他过去，不但百姓不服，就是抚宪同职道，亦觉于心不忍。","book":"清·李宝嘉《官场现形记》第五十七回"},"example":{"text":"说实在的，这么大的个头儿，让别人背着走，不光是～，可也真有点儿不舒服。","book":"刘流《烈火金刚》第四回"},"similar":["于心何忍"],"opposite":["铁石心肠"],"usage":"作谓语、定语；用于处事"},{"id":4430,"word":"于心不愧","pinyin":"yú xīn bù kuì","abbr":"yxbk","explanation":"在心里没有什么可惭愧的。","source":{"text":"尘埃隔眼逢何晚，气类相期久愈坚，以义求人今遂得，于心无愧果为贤。","book":"宋·王令《谢刘成父》"}},{"id":4431,"word":"于心何忍","pinyin":"yú xīn hé rěn","abbr":"yxhr","explanation":"怎能忍心。即内心不忍。","source":{"text":"若如此，杨公命尽此刻矣！我和你不惟不能救，且监斩他，于心何忍。","book":"明·王世桢《鸣凤记·夫妇死节》"},"example":{"text":"这事对我来说一直是～。"},"similar":["于心不忍"],"usage":"作谓语；指不忍心"},{"id":4432,"word":"于心无愧","pinyin":"yú jīn wú kuì","abbr":"yxwk","explanation":"在心里没有什么可惭愧的。","source":{"text":"尘埃隔眼逢何晚，气类相期久愈坚，以义求人今遂得，于心无愧果为贤。","book":"宋·王令《谢刘成父》"},"example":{"text":"这叫做知恩报恩，虽告知天地鬼神，亦～。","book":"明·明教中人《好逑传》第六回"},"similar":["问心无愧"],"opposite":["问心有愧"],"usage":"作谓语、宾语、定语；用于处事"},{"id":4433,"word":"于心有愧","pinyin":"yú xīn yǒu kuì","abbr":"yxyk","explanation":"从内心感到惭愧。","source":{"text":"王三老虽然不闻，朱世远却于心有愧，只恐三老见怪，所以殷勤唤茶。","book":"明·冯梦龙《醒世恒言》卷九"},"example":{"text":"你用心虽善，可是这么一来，却成了不忠、不孝、不仁、不义之徒，不免～，为举世所不齿。","book":"金庸《天龙八部》第四十八回"}},{"id":4434,"word":"于思于思","pinyin":"yú sī yú sī","abbr":"ysys","explanation":"思：同腮；于思：鬓须茂盛的样子。指胡须长而多的人。","source":{"text":"于思于思，弃甲复来。","book":"春秋·鲁·左丘明《左传·宣公二年》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第70回：“只怕人家有好好的女儿，未必肯嫁给～的老翁了。”"},"usage":"作定语；指大胡子的人","story":["春秋时期，郑国和宋国发生了战争，宋军统帅华元在犒劳将士时忘记了自己的车夫羊斟。羊斟怀恨在心，驾着战车把华元送到敌营，华元被俘，后来他逃回宋国，去巡视修城墙工事，遭到民工的讥笑：“胡子满腮，于思于思，丢盔弃甲还挺神气！”"]},{"id":4435,"word":"于是无补","pinyin":"yú shì wú bǔ","abbr":"yswb","explanation":"补：好处，益处。对事情没有什么好处。","example":{"text":"此时屈原理应反对最烈，然而～。","book":"郭沫若《我怎样写五幕史剧〈屈原〉》"}},{"id":4436,"word":"于民润国","pinyin":"yú mín rùn guó","abbr":"ymrg","explanation":"润：益。对人民对国家都有好处。","source":{"text":"蜘蛛有丝，损人利己；蚕腹有丝，于民润国。","book":"元·关汉卿《陈母教子》第二折"},"example":{"text":"明·无名氏《伐晋兴齐》第二折：“小生我贫居白屋，学浅才疏，艰辛陋巷，未遇皇宣，又不曾～施功效，善机谋虎略龙韬。”"},"usage":"作谓语、定语；用于书面语"},{"id":4437,"word":"于飞之乐","pinyin":"yú fēi zhī lè","abbr":"yfzl","explanation":"于飞：比翼齐飞。比喻夫妻间亲密和谐。","source":{"text":"不知彼可能将女进贡深宫，以遂朕于飞之乐？","book":"《诗·大雅·卷阿》：“凤皇于飞，翙翙其羽，亦集爰止。”明·许仲琳《封神演义》第二回"},"example":{"text":"是夜裴越客遂同德容小姐就在舟中，共入鸳帏欢聚。少年夫妇，极尽～。","book":"明·凌濛初《初刻拍案惊奇》卷五"},"usage":"作宾语；用于书面语"},{"id":4438,"word":"亏于一篑","pinyin":"kuī yú yī kuì","abbr":"kyyk","explanation":"亏：缺，欠；篑：装土的竹筐。积土成山的功夫只差最后一筐土。比喻做成一件大事只差最后一点而未能成功。","source":{"text":"为山九仞，功亏一篑。","book":"《尚书·旅獒》"},"example":{"text":"至九仞之功，往往～，前功尽弃，岂不可惜！","book":"蔡东藩《民国通俗演义》第143回"},"similar":["功亏一篑"],"usage":"作谓语、定语；用于处事"},{"id":4439,"word":"亏名损实","pinyin":"kuī míng sǔn shí","abbr":"kmss","explanation":"亏：损耗。名和实都受到损失。","source":{"text":"至于亏名损实，为国为身，知其不可。","book":"南朝·梁·任昉《为范尚书让吏部封侯第一表》"},"opposite":["名利双收"],"usage":"作宾语、定语；用于名实受损"},{"id":4440,"word":"亏心短行","pinyin":"kuī xīn duǎn xíng","abbr":"kxdx","explanation":"亏损天良，行为恶劣。","source":{"text":"须听，我没奈何分情破爱，谁下得亏心短行？从今后，相思两处，一样泪盈盈。","book":"元·高明《琵琶记》第五出"},"opposite":["问心无愧"],"usage":"作谓语、定语；指行为恶劣"},{"id":4441,"word":"云中仙鹤","pinyin":"yún zhōng xiān hè","abbr":"yzxh","explanation":"象云彩中的白鹤一般。比喻志行高洁的人。","source":{"text":"自古畸人多性癖，奇逸，云中仙鹤怎笼来？","book":"清·龚自珍《定风波》词"},"similar":["云中白鹤"],"usage":"作宾语、定语；用于比喻句"},{"id":4442,"word":"云中白鹤","pinyin":"yún zhōng bái hè","abbr":"yzbh","explanation":"象云彩中的白鹤一般。比喻志行高洁的人。","source":{"text":"邴君所谓云中白鹤，非鹑鷃之网所能罗矣。","book":"《三国志·魏志·邴原传》裴松之注引《原别传》"},"example":{"text":"訏超超越俗，如半天朱霞；歊矫矫出尘，如～。","book":"明·李贽《初潭集·兄弟上》"},"similar":["云中仙鹤"],"usage":"作宾语、定语；指人的品性"},{"id":4443,"word":"云交雨合","pinyin":"yún jiāo yǔ hé","abbr":"yjyh","explanation":"指相会，重逢。","source":{"text":"江回汉转两不见，云交雨合知何年。","book":"唐·李益《古别离》诗"},"usage":"作宾语、定语；用于书面语"},{"id":4444,"word":"云从龙，风从虎","pinyin":"yún cóng lóng，fēng cóng hǔ","abbr":"yclfch","explanation":"比喻事物之间的相互感应","source":{"text":"同声相应，同气相求。水流湿，火就燥。云从龙，风从虎。圣人作而万物睹。","book":"《周易·乾》"},"similar":["风从虎，云从龙"],"usage":"作定语、分句；用于书面语"},{"id":4445,"word":"云兴霞蔚","pinyin":"yún xīng xiá wèi","abbr":"yxxw","explanation":"兴：兴起；蔚：聚集。象云霞升腾聚集起来。形容景物灿烂绚丽。","source":{"text":"千岩竞秀，万壑争流。草木蒙笼其上，若云兴霞蔚。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"变化开阖天机全，浓淡覆露清而妍，～几千里，著我如在峨嵋巅。","book":"金·元好问《范宽秦川图》"},"similar":["云蒸霞蔚","五彩缤纷"],"opposite":["漆黑一团"],"usage":"作谓语、定语、状语；指景色"},{"id":4446,"word":"云净天空","pinyin":"yún jìng tiān kōng","abbr":"yjtk","explanation":"比喻事情办得干净利落，不留痕迹。","source":{"text":"一切了当，觉得这事作得来海枯石烂，云净天空，何等干净解脱，胸中十分的痛快。","book":"清·文康《儿女英雄传》第十七回"},"similar":["云过天空"],"usage":"作宾语、状语；指不留痕迹"},{"id":4447,"word":"云合响应","pinyin":"yún hé xiǎng yìng","abbr":"yhxy","explanation":"犹言云集响应。","source":{"text":"是云合响应之势，而非可安坐而致也。","book":"宋·陈亮《上孝宗皇帝第一书》"},"similar":["云集响应"],"usage":"作谓语、定语、状语；用于书面语"},{"id":4448,"word":"云合影从","pinyin":"yún hé yǐng cóng","abbr":"yhyc","explanation":"如云聚合，如影随形。比喻众多的人从各处涌来并会合在一起。","source":{"text":"汉·贾谊《过秦论》： “天下云集响应，赢粮而景从。”"}},{"id":4449,"word":"云合景从","pinyin":"yún hé jǐng cóng","abbr":"yhjc","explanation":"如云聚合，如影随形。比喻随从者之多。","source":{"text":"汉·贾谊《过秦论》： “天下云集响应，赢粮而景从。”"},"example":{"text":"将见忠臣义士，必且～矣。","book":"明·张煌言《上行在陈南北机宜疏》"},"similar":["云集景从"],"usage":"作谓语、定语；比喻随从者之多"},{"id":4450,"word":"云合雾集","pinyin":"yún hé wù jí","abbr":"yhwj","explanation":"比喻聚集迅速。","source":{"text":"故总辔齐镳，竞雕虫于山水；云合雾集，争歌颂于林泉。","book":"《史记·淮阴侯传》：“蒯通曰：‘……天下之士云合雾集。”《艺文类聚》卷八引南朝·宋·顾野王《虎丘山序》"},"example":{"text":"《旧唐书·魏征传》：“魏公起自叛徒，奋臂大呼，四方响应，万里风驰，～，众数十万。”"},"similar":["云屯雾集","云屯雨集","云涌雾集"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":4451,"word":"云垂海立","pinyin":"yún chuí hǎi lì","abbr":"ychl","explanation":"使云端下垂，使海水立起。比喻文辞雄伟，有压倒一切的气势。","source":{"text":"九天之云下垂，四海之水皆立。","book":"唐·杜甫《朝献太清宫赋》"},"example":{"text":"这一来，就是那石破天惊，～，也没有这样的惊奇。（清·张春帆《九尾龟》第四十六回）"},"usage":"作宾语、定语；用于书面语"},{"id":4452,"word":"云堦月地","pinyin":"yún jiē yuè dì","abbr":"yjyd","explanation":"指天上。亦指仙境。同“云阶月地”。"},{"id":4453,"word":"云天雾地","pinyin":"yún tiān wù dì","abbr":"ytwd","explanation":"比喻不明事理，糊里糊涂。","source":{"text":"田里功夫，他比你爸爸还强一色。就是有点面胡，吃了酒，尤其是有点云天雾地。","book":"周立波《山乡巨变》上三"},"usage":"作宾语、定语；用于比喻句"},{"id":4454,"word":"云天高谊","pinyin":"yún tiān gāo yì","abbr":"ytgy","explanation":"情谊深厚，高达云天。","source":{"text":"向日晚生正遭歧路之泣，得遇总戎，云天高谊，解衣推食，有踰骨肉。","book":"明·名教中人《好逑传》第七回：“贱妾水冰心，多蒙公子云天高谊，从虎口救出，其洪恩大德，不啻天地父母。”清·烟霞散人《凤凰池》第五回"},"example":{"text":"刘电不胜感激。道：“老叔～ ,存殁均沾。”","book":"清·陈朗《雪月梅》第十四回"},"usage":"作宾语、定语；用于书面语"},{"id":4455,"word":"云奔之涌","pinyin":"yún bēn zhī yǒng","abbr":"ybzy","explanation":"象云一样奔涌聚集在一起。形容人群迅速聚集在一起。","source":{"text":"乐作，诸军队伍，亦次第鼓吹振作，千乘万骑，如云奔之涌，四方万姓，如鳞次蚁聚，迤逦入丽正门。","book":"宋·周密《武林旧事》卷一"}},{"id":4456,"word":"云奔潮涌","pinyin":"yún bēn cháo yǒng","abbr":"ybcy","explanation":"云气上升，潮水奔涌。形容大量涌出来","source":{"text":"千乘万骑，如云奔潮涌，四方万姓，如鳞次蚁聚。","book":"宋·周密《武林旧事》第一卷"},"similar":["云蒸泉涌"],"usage":"作宾语、状语；用于比喻句"},{"id":4457,"word":"云奔雨骤","pinyin":"yún bēn yǔ zhòu","abbr":"ybyz","explanation":"奔：飞驰；骤：急行。象云一样聚散，象雨一样急骤。形容人的聚散迅速。","source":{"text":"须臾之间，见听众云奔雨骤，皆至寺内。","book":"《敦煌变文集·庐山远公话》"},"usage":"作谓语、状语；用于比喻句"},{"id":4458,"word":"云娇雨怯","pinyin":"yún jiāo yǔ qiè","abbr":"yjyq","explanation":"形容女子娇羞之态。","source":{"text":"未免云娇雨怯。今日晌午时分，才得起来。","book":"清·洪昇《长生殿·春睡》"},"usage":"作宾语、定语；用于比喻句"},{"id":4459,"word":"云容月貌","pinyin":"yún róng yuè mào","abbr":"yrym","explanation":"比喻淡雅、飘逸的容貌。","source":{"text":"云容月貌，寻常淡妆难画描。出落风神年尚小，一团都是俏。","book":"明·梁辰鱼《香遍满·寄王桂父》套曲"},"usage":"作宾语、定语；用于比喻句"},{"id":4460,"word":"云尤雨殢","pinyin":"yún yóu yǔ tì","abbr":"yyyt","explanation":"形容男女间情意缠绵。","source":{"text":"我鸟啼花落自支吾，他云尤雨殢相怜护。我凄凉无绪，他绸缪有余。","book":"明·单本《蕉帕记·覸婚》"},"usage":"作谓语、定语；用于书面语"},{"id":4461,"word":"云屯席卷","pinyin":"yún tún xí juǎn","abbr":"ytxj","explanation":"如云气骤然聚集，如席子迅速卷起。形容来去迅捷，气势雄伟。","source":{"text":"云屯席卷，兼拟靖鲸鲵于鲛穴；可怜仳离琐尾，大都内地残黎。","book":"清·陈梦雷《丁巳秋道山募建普度疏》"},"example":{"text":"～，所向无前。","book":"清·昭梿《啸亭杂录·八大王》"},"usage":"作宾语、定语、状语；用于比喻句"},{"id":4462,"word":"云屯星聚","pinyin":"yún tún xīng jù","abbr":"ytxj","explanation":"形容众多的人聚集在一起。","source":{"text":"丘爷爷手下猛将如虎，战士如蜂，云屯星聚，布满四方津要去处。","book":"明·邵璨《香囊记·败兀》"},"similar":["云屯雨集"],"usage":"作定语、状语；用于比喻句"},{"id":4463,"word":"云屯森立","pinyin":"yún tún sēn lì","abbr":"ytsl","explanation":"众多而整肃的样子。","source":{"text":"以张公节制三方，其部下熊罴之士，云屯森立，而特属望将军，其必有以取之矣。","book":"清·侯方域《为司徒公赠万将军序》"},"usage":"作谓语、定语；用于比喻句"},{"id":4464,"word":"云屯蚁聚","pinyin":"yún tún yǐ jù","abbr":"ytyj","explanation":"形容众多的人物聚集在一起。","source":{"text":"天下英才，云屯蚁聚。","book":"元·柯丹邱《荆钗记·春科》"},"usage":"作谓语、定语；用于比喻句"},{"id":4465,"word":"云屯雨集","pinyin":"yún tún yǔ jí","abbr":"ytyj","explanation":"形容众多的人聚集在一起。","source":{"text":"贼兵云屯雨集，围定城池，布军与战不利。","book":"明·罗贯中《三国演义》第九回"},"similar":["云合雾集","云屯雾集","云涌雾集"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":4466,"word":"云屯雾散","pinyin":"yún tún wù sàn","abbr":"ytws","explanation":"如云聚集，如鸟飞散。形容众多的人忽聚忽散。","source":{"text":"所以周无上算，汉收下策，以其倏来忽往，云屯雾散，强则骋其犯塞，弱又不可尽除故也。","book":"《隋书·梁叡传》"},"usage":"作定语、状语；用于书面语"},{"id":4467,"word":"云屯雾集","pinyin":"yún tún wù jí","abbr":"ytwj","explanation":"象云和雾那样聚集。形容数量多而集中。","source":{"text":"却有诸路买卖，云屯雾集；只听放灯，都来赶趁。","book":"明·施耐庵《水浒传》第六十六回"},"example":{"text":"清·李百川《绿野仙踪》第三回：“又早到八月初头，各处的举子～。”"},"similar":["云合雾集","云屯雨集","云涌雾集"],"usage":"作宾语、定语；形容数量多而集中"},{"id":4468,"word":"云屯飙散","pinyin":"yún tún biāo sàn","abbr":"ytbs","explanation":"聚集如云，分散如风。形容来往迅疾。","source":{"text":"骑射驰骋，云屯飙散。","book":"严复《原强》"},"usage":"作定语、状语；用于比喻句"},{"id":4469,"word":"云屯鸟散","pinyin":"yún tún niǎo sàn","abbr":"ytns","explanation":"如云聚集，如鸟飞散。形容众多的人忽聚忽散。","source":{"text":"雠衅既深，互伺便隙，控弦抗戈，觇望风尘，云屯鸟散，更相驰突。","book":"《后汉书·南匈奴传论》"},"usage":"作宾语、定语；用于书面语"},{"id":4470,"word":"云山雾罩","pinyin":"yún shān wù zhào","abbr":"yswz","explanation":"罩：覆盖。山被云雾笼罩，看不清它的真实面目。比喻故弄玄虚，暧昧不明。","example":{"text":"放爆竹的硝烟，象～，正在热闹。（梁斌《红旗谱》三十六）"}},{"id":4471,"word":"云布雨施","pinyin":"yún bù yǔ shī","abbr":"ybys","explanation":"比喻遍布。","source":{"text":"上则云布雨施，下则山藏海纳。","book":"汉·司马相如《上林赋》：“缘陵流泽，云布雨施。”北周·庾信《三月三日华林园马射赋》"},"example":{"text":"北周·庾信《三月三日华林园马射赋》：“上则～，下则山藏海纳。”"},"similar":["云行雨施","云行雨洽"],"usage":"作宾语、定语；指广施恩泽"},{"id":4472,"word":"云布雨润","pinyin":"yún bù yǔ rùn","abbr":"ybyr","explanation":"比喻教化远播。","source":{"text":"敷演正法，云布雨润。","book":"《宋书·夷蛮传·诃罗驼国》"},"usage":"作宾语、定语；用于书面语"},{"id":4473,"word":"云开日出","pinyin":"yún kāi rì chū","abbr":"ykrc","explanation":"乌云消散，重见天日。比喻黑暗已经过去，光明已经到来。也比喻误会消除。","source":{"text":"云开日出，水绿山青。","book":"宋·释普济《五灯会元·文准禅师》"},"example":{"text":"闺阁还是上海弄堂的幻觉，～便灰飞烟散，却也是一幕接一幕，永无止境。（王安忆《长恨歌》第一部第一章）"},"similar":["云开见日"],"usage":"作谓语、状语；用于比喻句"},{"id":4474,"word":"云开见天","pinyin":"yún kāi jiàn tiān","abbr":"ykjt","explanation":"乌云消散，重见天日。比喻社会由乱转治，由黑暗转向光明。","source":{"text":"纷纷五代乱离间，一旦云开复见天。","book":"宋·邵雍《观盛化诗》"},"similar":["云开见日"],"usage":"作宾语、定语；用于比喻句"},{"id":4475,"word":"云开见日","pinyin":"yún kāi jiàn rì","abbr":"ykjr","explanation":"拔开云雾，见到太阳。比喻黑暗已经过去，光明已经到来。也比喻误会消除。","source":{"text":"旷若开云见日，何喜如之。","book":"《后汉书·袁绍传》"},"example":{"text":"有日～，知我等替天行道，不扰良民，赦罪招安，同心报国，青史留名，有何不美。","book":"明·施耐庵《水浒全传》第七十一回"},"similar":["开云见天"],"usage":"作谓语、状语；指误会消除"},{"id":4476,"word":"云开雾散","pinyin":"yún kāi kāi sàn","abbr":"ykws","explanation":"象烟云消散一样。比喻事物消失得干干净净。","source":{"text":"干戈所指,云消雾散。","book":"唐·李世民《授长孙无忌尚书右仆射诏》"},"example":{"text":"～却晴霁，清风渐渐无纤尘。","book":"宋·陆佃《陶山集·王君仪》"},"similar":["云消雾散"],"usage":"作宾语、定语；指重见光明"},{"id":4477,"word":"云开雾释","pinyin":"yún kāi wù shì","abbr":"ykws","explanation":"指天气由阴暗转为明朗。常用以比喻怨愤、疑虑得以消除。","source":{"text":"千古名臣，每遭谗谤，而转瞬云开雾释，日光月华。","book":"清·张集馨《道咸宦海见闻录》"},"usage":"作谓语、定语；用于比喻句"},{"id":4478,"word":"云彻雾卷","pinyin":"yún chè wù juǎn","abbr":"ycwj","explanation":"象烟云消散一样。比喻事物消失得干干净净。","source":{"text":"世祖太武皇帝，握金镜以照耀，击玉鼓以铿锵，神武之所牢笼，威风之所兰轹，莫不云彻雾卷，瓦解冰消。","book":"《魏书·废出三帝纪》"}},{"id":4479,"word":"云心月性","pinyin":"yún xīn yuè xìng","abbr":"yxyx","explanation":"像浮云和明月一样的心性。形容人不慕名利，性情恬淡。","source":{"text":"野客云作心，高僧月为性。","book":"唐·孟浩然《忆周秀才·素上人》"},"usage":"作宾语、定语；用于书面语"},{"id":4480,"word":"云心水性","pinyin":"yún xīn shuǐ xìng","abbr":"yxsx","explanation":"指女子作风轻浮，爱情不专一。","source":{"text":"若是云心水性情分寡，怎供出梦蝶寻花。","book":"明·叶宪祖《鸾鎞记·喜谐》"},"similar":["水性杨花"],"usage":"作宾语、定语；用于比喻句"},{"id":4481,"word":"云心鹤眼","pinyin":"yún xīn hè yǎn","abbr":"yxhy","explanation":"比喻高远的处世态度。","source":{"text":"君以旷怀宜静境，我因蹇步称闲官。闭门足病非高士，劳作云心鹤眼看。","book":"唐·白居易《酬杨八》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":4482,"word":"云悲海思","pinyin":"yún bēi hǎi sī","abbr":"ybhs","explanation":"如云似海的愁思。","source":{"text":"窥明镜，罢容色，云悲海思徒揜抑。","book":"《梁书·豫章王综传》"},"example":{"text":"骑龙飞上太清家，～令人嗟。","book":"唐·李白《飞龙引》"},"similar":["云愁海思"],"usage":"作主语、宾语；指愁思"},{"id":4483,"word":"云情雨意","pinyin":"yún qíng yǔ yì","abbr":"yqyy","explanation":"①云和雨的状态。②指男女欢会之情。","source":{"text":"一夕高唐梦里狂，云情雨意两茫茫。袖间依约去年香。","book":"宋·袁去华《浣溪沙》词"},"example":{"text":"季玉，年十一，～，小而了了。","book":"清·李斗《扬州画舫录·小秦淮录》"},"usage":"作宾语、定语；用于比喻句"},{"id":4484,"word":"云愁海思","pinyin":"yún chóu hǎi sī","abbr":"ychs","explanation":"如云似海的愁思。","source":{"text":"骑龙飞上太清家，云愁海思令人嗟。","book":"唐·李白《飞龙引》之一"},"similar":["云悲海思"],"usage":"作主语、宾语；指愁思"},{"id":4485,"word":"云愁雨怨","pinyin":"yún chóu yǔ yuàn","abbr":"ycyy","explanation":"喻指离情别愁。","source":{"text":"歌袖半遮眉黛惨，泪珠旋滴衣襟。惆怅云愁雨怨，断魂何处相寻。","book":"宋·孙光宪《何满子》词"},"usage":"作宾语、定语；用于书面语"},{"id":4486,"word":"云愁雨恨","pinyin":"yún chóu yǔ hèn","abbr":"ycyh","explanation":"指男女间离别之情","source":{"text":"惟有床前残泪烛，啼红相伴。暗惹起、云愁雨恨情何限。","book":"宋·柳永《安公子》词"},"usage":"作宾语、定语；用于书面语"},{"id":4487,"word":"云愁雾惨","pinyin":"yún chóu wù cǎn","abbr":"ycwc","explanation":"形容暗淡无光的景象。多比喻令人忧愁苦闷的局面。","source":{"text":"时有圆应长者，出众作礼问曰：‘云愁雾惨，大众呜呼，请师一言，未在告别。’","book":"宋·释道源《景德传灯录》卷二十二"},"example":{"text":"霎时间～，一会家地暗难穷。（明·许仲琳《封神演义》第八十四回）"},"usage":"作谓语、定语；用于书面语"},{"id":4488,"word":"云扰幅裂","pinyin":"yún rǎo fú liè","abbr":"yrfl","explanation":"比喻社会动乱，四分五裂。","source":{"text":"少陵意谓天宝离乱，四方云扰幅裂，人物岁岁俱灾。","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵四》"},"similar":["天下大乱"],"opposite":["天下一统"],"usage":"作谓语、定语；用于比喻句"},{"id":4489,"word":"云收雨散","pinyin":"yún shōu yǔ sàn","abbr":"ysys","explanation":"喻欢会结束，彼此分离。","source":{"text":"当时谁会唱《阳关》。离恨天涯远。争奈云收雨散。凭阑干、东风泪满。","book":"宋·周邦彦《烛影摇红》词"},"example":{"text":"誓世世生生休抛撇。不提防，惨凄凄，月坠花折；悄冥冥，～；恨茫茫，只落得死断生绝。","book":"清·魏秀仁《花月痕》第六回"},"usage":"作谓语、定语；用于比喻句"},{"id":4490,"word":"云散风流","pinyin":"yún sàn fēng liú","abbr":"ysfl","explanation":"象风和云那样流动散开。比喻事物四散消失。","source":{"text":"风流云散，一别如雨。","book":"三国·魏·王粲《赠蔡子笃》诗"},"example":{"text":"乃～，各为饥寒所迫，敛眉就食，俯首觅衣，竟至经此终老，岂不重可叹乎。（清·龚萼《答姜云标》）"},"similar":["风流云散"],"usage":"作谓语、定语；指消失"},{"id":4491,"word":"云散高唐","pinyin":"yún sàn gāo táng","abbr":"ysgt","explanation":"高唐：战国时楚国一台观，在云梦泽中。比喻夫妻恩情断绝，欢乐成空。","source":{"text":"悲凉。人事改，三春秾艳，一夜繁霜。似人归洛浦，云散高唐。","book":"战国·楚·屈原《高唐赋》载；宋·晁元礼《满庭芳》词"},"example":{"text":"终久是～，水涸湘江。这是尘寰中消长数应当，何必枉悲伤！（清·曹雪芹《红楼梦》第五回）"},"usage":"作宾语、定语；用于书面语"},{"id":4492,"word":"云朝雨暮","pinyin":"yún zhāo yǔ mù","abbr":"yzym","explanation":"指男女欢会之时。","source":{"text":"红裙溅水鸳鸯湿，几度云朝雨暮。","book":"宋·贺铸《断湘弦·淑质柔情》词：“不间云朝雨暮，向西楼、南馆留连。”宋·叶阊《摸鱼儿·倚薰风》词"}},{"id":4493,"word":"云期雨信","pinyin":"yún qī yǔ xìn","abbr":"yqyx","explanation":"指男女约定幽会的日期。","source":{"text":"懊恼人人薄幸。负云期雨信。","book":"宋·欧阳修《品令》词"},"similar":["云期雨约"],"usage":"作宾语、定语；用于书面语"},{"id":4494,"word":"云期雨约","pinyin":"yún qī yǔ yuē","abbr":"yqyy","explanation":"指男女约定幽会的日期。","source":{"text":"元·石子章《竹坞听琴》第四折“但则要捉对儿云期雨约，便是俺师徒每全真了道。”"},"similar":["云期雨信"],"usage":"作宾语、定语；用于书面语"},{"id":4495,"word":"云树之思","pinyin":"yún shù zhī sī","abbr":"yszs","explanation":"比喻朋友阔别后的相思之情。","source":{"text":"渭北春天树，江东日暮云。","book":"唐·杜甫《春日忆李白》诗"},"example":{"text":"数载阔别，常怀～。","book":"姚雪垠《李自成》第一卷第26章"},"usage":"作宾语；指思念"},{"id":4496,"word":"云树遥隔","pinyin":"yún shù yáo gé","abbr":"ysyg","explanation":"指两地相隔遥远。","source":{"text":"侄自与叔大人欢会，迄今二十余年矣。只以云树遥隔，山川相阻，未得再亲慈诲。","book":"清·李绿园《歧路灯》第八十六回"},"example":{"text":"清·李绿园《歧路灯》第86回：“只以～，山川相阻，未得再亲慈诲，企慕之怀，日久愈深。”"},"similar":["云树之思"],"usage":"作宾语、定语；用于书面语"},{"id":4497,"word":"云梦闲情","pinyin":"yún mèng xián qíng","abbr":"ymxq","explanation":"指男女欢会之事。","source":{"text":"妾巫山之女也，为高唐之客，闻君游高唐，原荐枕席。","book":"战国·楚·宋玉《高唐赋》序：“昔者楚襄王与宋玉游于云梦之台，望高唐之观，其上独有云气……王曰：‘何谓朝云？’玉曰：‘昔者先王尝游高唐，怠而昼寝，梦见一妇人，曰"},"example":{"text":"不比那～，姑苏醉宴，章华骄态。","book":"明·叶宪祖《易水寒》第二折"},"similar":["巫山云雨"],"usage":"作宾语、定语；用于书面语","story":["传说古代襄王游览高唐地区，十分疲倦就在白天小睡了一会，在梦中看见一个仙女说：“我是高唐人，听说你来了，愿意给你当枕席。”襄王临幸了她。临别她说：“妾在巫山之阳，高丘之阻。旦为朝云，暮为行雨，朝朝暮暮，阳台之下。”"]},{"id":4498,"word":"云次鳞集","pinyin":"yún cì lín jí","abbr":"yclj","explanation":"会聚；会合。","source":{"text":"薄海英才，云次鳞集。","book":"宋·周密《齐东野语·姜尧章自叙》"},"usage":"作定语、状语；用于书面语"},{"id":4499,"word":"云泥之别","pinyin":"yún ní zhī bié","abbr":"ynzb","explanation":"象天上的云和地上的泥那样高下不同。比喻地位的高下相差极大。","source":{"text":"仲彦足下，勤处隐约，虽乘云行泥，栖宿不同。","book":"南朝·宋·范晔《后汉书·逸民传·矫慎》"},"example":{"text":"她高高在上，跟自己的地位简直是～。","book":"钱钟书《围城》"},"similar":["天差地别","云龙井蛙"],"usage":"作宾语；指高下差别悬殊"},{"id":4500,"word":"云泥之差","pinyin":"yún ní zhī chā","abbr":"ynzc","explanation":"云在天，泥在地。指相差像天上的云和地上的泥。比喻高低差别远殊。","source":{"text":"举与民国八年上海艺苑真赏社所印行安氏别本相比较，固大有云泥之差，而视‘天一阁本’亦远有上下床之别。","book":"郭沫若《石鼓文研究·古拓二种之比较》"},"similar":["云泥之别"],"usage":"作宾语；用于比较"},{"id":4501,"word":"云泥分隔","pinyin":"yún ní fēn gé","abbr":"ynfg","explanation":"云在天，泥在地，两者相差甚远。比喻地位高下悬殊，或双方相隔甚远，不能相见。","source":{"text":"今日长安道，对面隔云泥。","book":"唐·白居易《伤友》"},"example":{"text":"真个是贵贱悬殊，～。（清·张春帆《九尾龟》第一百七十二回）"},"usage":"作宾语、定语；用于比喻句"},{"id":4502,"word":"云泥异路","pinyin":"yún ní yì lù","abbr":"ynyl","explanation":"像天上的云和地上的泥。比喻地位相差悬殊。","source":{"text":"宋·陈亮《与辛幼安殿撰书》：“亮空闲没可做时，每念临安相聚之适，而一别遽如许，云泥异路又如许。"},"example":{"text":"妾命薄春冰，身轻秋叶，～，浊水清尘。然既委身于君子，岂再托体于他人？","book":"明·李昌祺《剪灯馀话·贾云华还魂记》"},"similar":["云泥殊路"],"usage":"作宾语、定语；用于比喻句"},{"id":4503,"word":"云泥殊路","pinyin":"yún ní shū lù","abbr":"ynsl","explanation":"象天上的云和地上的泥那样高下不同。比喻地位悬殊。","source":{"text":"云泥已殊路。","book":"北魏·荀济《赠阴梁州》"},"similar":["云泥之别"],"usage":"作宾语、定语；指人的地位差"},{"id":4504,"word":"云消雨散","pinyin":"yún xiāo yǔ sàn","abbr":"yxys","explanation":"比喻一切都成了过去。","source":{"text":"干戈所指，云消雾散。","book":"唐·李世民《授长孙无忌尚书右仆射诏》"},"example":{"text":"百岁既终，～，此事自古皆然，不足感叹。（明·冯梦龙《警世通言》卷十）"},"similar":["云消雾散"],"usage":"作谓语、定语；指消失"},{"id":4505,"word":"云消雾散","pinyin":"yún xiāo wù sàn","abbr":"yxws","explanation":"象烟云消散一样。比喻事物消失得干干净净。","source":{"text":"干戈所指，云消雾散。","book":"唐·李世民《授长孙无忌尚书右仆射诏》"},"example":{"text":"则太上皇帝虽有忿怒之情，亦且霍然～。","book":"宋·朱熹《经筵留身陈四事札子》"},"similar":["云开雾散","烟消云散","烟消火灭"],"opposite":["云笼雾锁"],"usage":"作谓语；用于人的心情"},{"id":4506,"word":"云涌雾集","pinyin":"yún yǒng wù jí","abbr":"yywj","explanation":"像云和雾一样向一处聚拢。比喻众多的人从各处涌来并会合在一起。","source":{"text":"天下初发难也，俊雄豪杰建号一呼，天下之士云合雾集。","book":"《史记·淮阴侯列传》"},"example":{"text":"举国志士，～以应之，卒乃光复旧物，使意大利为欧洲之一雄邦。（清·梁启超《少年中国说》）"},"similar":["云合雾集","云屯雾集","云屯雨集"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":4507,"word":"云涌风飞","pinyin":"yún yǒng fēng fēi","abbr":"yyff","explanation":"云阵奔涌，狂风发作。形容文章气势磅礴。","source":{"text":"其年《瑞龙吟·春夜见壁间三弦子是云郎旧物感而填词》后半云：‘记得蛇皮弦子，当时妆就……’游丝落絮之情，云涌风飞之笔，亦一时之雄也。","book":"清·陈廷焯《白雨斋词话》卷七"},"similar":["云涌飙发"],"usage":"作谓语、定语；用于书面语"},{"id":4508,"word":"云涌飙发","pinyin":"yún yǒng biāo fā","abbr":"yybf","explanation":"飙：狂风。云阵奔涌，狂风发作。形容文章气势磅礴。","source":{"text":"伯鲁之文，云涌飙发而骤进于古，若春木之落其华而将实矣。","book":"清·吴敏树《〈欧阳功甫遗集〉序》"},"similar":["云涌风飞"],"usage":"作谓语、定语；用于书面语"},{"id":4509,"word":"云淡风轻","pinyin":"yún dàn fēng qīng","abbr":"ydfq","explanation":"微风轻拂，浮云淡薄。形容天气晴好。亦作“风轻云淡”。","source":{"text":"云淡风轻近午天，傍花随柳过前川。","book":"宋·程灏《春日偶成》"},"example":{"text":"清·荻岸山人《平山冷燕》第五回：“写了半晌，才写得‘～’四个字，便要放下笔。”"},"similar":["风轻云净","风轻云淡"],"usage":"作谓语、定语、宾语；用于天气"},{"id":4510,"word":"云游四海","pinyin":"yún yóu sì hǎi","abbr":"yysh","explanation":"像行云一样在四海漫游，行踪不定。","source":{"text":"拂云游四海，弄影到三山。","book":"唐·沈佺期《黄鹤》"},"example":{"text":"人遁能～，藏形变身，飞剑掷刀，取人首级。（明·罗贯中《三国演义》第六十八回）"}},{"id":4511,"word":"云游天下","pinyin":"yún yóu tiān xià","abbr":"yytx","explanation":"有如行云，到处游荡，行踪不定。","source":{"text":"山上有一老僧，法名普净，原是汜水关镇国寺中长老；后因云游天下，来到此处，见山明水秀，就此结草为庵，每日坐禅参道，身边只有一小行者，化饭度日。","book":"明·罗贯中《三国演义》第七十七回"},"example":{"text":"洪老帮主～，行踪无定。你说要见，就轻易见得着么？（金庸《神雕侠侣》第十二回）"},"usage":"作谓语、宾语、定语；用于僧道等"},{"id":4512,"word":"云烟过眼","pinyin":"yún yān guò yǎn","abbr":"yygy","explanation":"象烟云在眼前一晃而过。比喻事物很快就成为过去。也比喻身外之物，不必重视。也指荣华富贵转眼已成过去。","source":{"text":"云烟过眼时时变，草树惊秋夜夜疏。","book":"宋·戴复古《再赋惜别呈李实夫运使》"},"example":{"text":"收藏书画是雅事，原似～，可以过而不留。","book":"清·钱泳《履园丛话·收藏·总论》"},"similar":["过眼烟云"],"usage":"作宾语；比喻事物很快就消失"},{"id":4513,"word":"云程万里","pinyin":"yún chéng wàn lǐ","abbr":"ycwl","explanation":"形容前程非常远大。","source":{"text":"蒋士奇道：‘可喜！可喜！将来～，正未可量。’","book":"清·陈朗《雪月梅》第四回"},"similar":["前程万里"],"usage":"作谓语、定语；用于书面语"},{"id":4514,"word":"云程发轫","pinyin":"yún chéng fā rèn","abbr":"ycfr","explanation":"云程：青云万里的路程；发轫：启车行进，比喻事业的开端。旧时祝人前程远大的颂辞。","source":{"text":"朝发轫于苍梧兮，夕余至乎县圃。","book":"战国·楚·屈原《离骚》"},"example":{"text":"贺入学，曰：‘～’。","book":"清·程允升《幼学琼林·人事》"},"usage":"作谓语；祝人前程远大的颂辞"},{"id":4515,"word":"云窗月帐","pinyin":"yún chuāng yuè zhàng","abbr":"ycyz","explanation":"指华美幽静的居处。","source":{"text":"云窗月帐散花多，闲读金经夜若何！","book":"明·高启《夜闻吴女诵经》诗"},"similar":["云窗霞户","云窗月户"],"usage":"作宾语、定语；用于书面语"},{"id":4516,"word":"云窗月户","pinyin":"yún chuāng yuè hù","abbr":"ycyh","explanation":"指华美幽静的居处。","source":{"text":"薄情风雨，断送花何许。一夜清香无觅处。却返云窗月户。","book":"宋·向子諲《清平乐·奉酬韩叔夏》词"},"similar":["云窗霞户","云窗月帐"],"usage":"作宾语、定语；用于书面语"},{"id":4517,"word":"云窗雾槛","pinyin":"yún chuāng wù jiàn","abbr":"ycwj","explanation":"为云雾缭绕的窗户和居室。借指高耸入云的楼阁。亦指建于极高处的楼阁。","source":{"text":"若其上室，则腾天架空，吞云吸气，五色晶璃，云窗雾槛，贝阙珠宫，玉楼瑶殿。","book":"康有为《大同书》癸部第二章"},"similar":["云窗雾阁"],"usage":"作宾语、定语；用于书面语"},{"id":4518,"word":"云窗雾阁","pinyin":"yún chuāng wù gé","abbr":"ycwg","explanation":"为云雾缭绕的窗户和居室。借指高耸入云的楼阁。亦指建于极高处的楼阁。","source":{"text":"庭院深深深几许，云窗雾阁常扃。","book":"唐·韩愈《华山女》诗：“云窗雾阁事慌惚，重重翠幔深金屏。”宋·李清照《临江仙》词"},"example":{"text":"书满琅函秘不开，～锁青苔。","book":"元·宋无《游三茅华阳诸洞》诗之三"},"similar":["云窗雾槛"],"usage":"作宾语、定语；用于书面语"},{"id":4519,"word":"云窗霞户","pinyin":"yún chuāng xiá hù","abbr":"ycxh","explanation":"指华美的居处。","source":{"text":"数树青榆延阁东，云窗霞户绮玲珑。","book":"元·周伯琦《学宫纪事绝句》之四"},"similar":["云窗月帐","云窗月户"],"usage":"作宾语、定语；用于书面语"},{"id":4520,"word":"云端看厮杀","pinyin":"yún duān kàn sī shā","abbr":"ydkss","explanation":"厮：互相。站在云里看下面互相厮杀。比喻置身事外，袖手旁观。","source":{"text":"云端看厮杀，毕竟孰输赢？","book":"明·冯梦龙《醒世恒言》卷三十五"}},{"id":4521,"word":"云端里看厮杀","pinyin":"yún duān lǐ kàn sī shā","abbr":"ydlkss","explanation":"厮：互相。站在云里看下面互相厮杀。比喻置身事外，袖手旁观。","source":{"text":"云端看厮杀，毕竟孰输赢？","book":"明·冯梦龙《醒世恒言》卷三十五"},"example":{"text":"天下事最妙的是～，你我且置身局外，袖手旁观，看后来这位安水心先生怎的下手。（清·文康《儿女英雄传》第二十二回）"},"usage":"作宾语、定语；用于比喻句"},{"id":4522,"word":"云罗天网","pinyin":"yún luó tiān wǎng","abbr":"yltw","explanation":"犹言天罗地网。","source":{"text":"所恨姚义不存，薛生已殁，使云罗天网有所不该，以为叹恨耳。","book":"唐·王绩《答冯子华处士书》"},"similar":["天罗地网"],"usage":"作宾语、定语；用于书面语"},{"id":4523,"word":"云翻雨覆","pinyin":"yún fān yǔ fù","abbr":"yfyf","explanation":"比喻人情世态反复无常。","source":{"text":"翻手作云覆手雨，纷纷轻薄何须数。","book":"唐·杜甫《贫交行》"},"example":{"text":"今我国民，轻弃信义，权谋诡诈，～，苛刻凉薄驯至尽人皆机心，举国皆荆棘者，曰惟小说之故。","book":"梁启超《小说与群治关系》"},"usage":"作宾语、定语；用于比喻句"},{"id":4524,"word":"云耶山耶","pinyin":"yún yē shān yē","abbr":"yysy","explanation":"是云，还是山？原指画中的人辨认不请。后指对内容模糊作品的疑问。","source":{"text":"江上愁心千叠山，浮空积翠如云烟。山耶云耶远莫知，烟空云散山依然。","book":"宋·苏轼《书王定国所藏烟江叠嶂图》"}},{"id":4525,"word":"云脚粥面","pinyin":"yún jiǎo zhōu miàn","abbr":"yjzm","explanation":"形容茶色的浓淡。","source":{"text":"茶少汤多，则云脚散，汤少茶多，则粥面聚。","book":"宋·蔡襄《茶录·点茶》"}},{"id":4526,"word":"云舒霞卷","pinyin":"yún shū xiá juǎn","abbr":"ysxj","explanation":"形容姿态万千，色彩斑斓。","source":{"text":"珠帘玉案翡翠屏，云舒霞卷千俜停。","book":"宋·苏轼《芙蓉城》诗"},"example":{"text":"文杏堂前千树红，～涨春风。","book":"金·元好问《冠氏赵庄赋杏花》之二"},"usage":"作宾语、定语；用于比喻句"},{"id":4527,"word":"云蒸泉涌","pinyin":"yún zhēng quán yǒng","abbr":"yzqy","explanation":"云气升腾，泉水奔涌。形容大师涌出来。","source":{"text":"自兹以降，史道陵夷，作者芜音累句，云蒸泉涌。","book":"唐·刘知己《史通·叙事》"},"similar":["云奔潮涌"],"usage":"作宾语、状语；用于比喻句"},{"id":4528,"word":"云蒸础润","pinyin":"yún zhēng chǔ rùn","abbr":"yzcr","explanation":"云气升腾，柱石湿润。形容湿气很重。","source":{"text":"山云蒸，柱础润，伏岑掘，兔丝死。","book":"《淮南子·说林训》"},"usage":"作宾语、定语；用于书面语"},{"id":4529,"word":"云蒸雨降","pinyin":"yún zhēng yǔ jiàng","abbr":"yzyj","explanation":"云气向上升腾，雨水降落。形容下雨。也比喻广施恩泽。","source":{"text":"水激则旱兮，矢激则远；万物回薄兮，振荡相转。云蒸雨降兮，错缪相纷；大钧播物兮，坱圠无垠。","book":"汉·贾谊《鹏鸟赋》"},"example":{"text":"子之文章，杰力人上。地辟天开，～。（宋曾巩《代人祭李白文》）"}},{"id":4530,"word":"云蒸雾集","pinyin":"yún zhēng wù jí","abbr":"yzwj","explanation":"如云雾之蒸腾会集。形容众多。","source":{"text":"故天下雄伟英豪之士，声从响应，云蒸雾集。","book":"宋·李纲《用人才以激士风札子》：“天下之士，云蒸雾集，人材可谓众多矣。”宋·陈亮《论开诚之道》"},"usage":"作谓语、定语；用于书面语"},{"id":4531,"word":"云蒸霞蔚","pinyin":"yún zhēng xiá wèi","abbr":"yzxw","explanation":"蒸：上升；蔚：聚集。象云霞升腾聚集起来。形容景物灿烂绚丽。","source":{"text":"千岩竞秀，万壑争流。草木蒙笼其上，若云兴霞蔚。","book":"南朝宋·刘义庆《世说新语·言语》"},"example":{"text":"抬头望处，已到巫山。上面阳光垂照下来，下面浓雾滚涌上去，～，颇为壮观。","book":"刘白羽《长江三日》"},"similar":["五彩缤纷","云兴霞蔚","花团锦簇"],"opposite":["漆黑一团","暗淡无光"],"usage":"作谓语、定语、状语；指景色"},{"id":4532,"word":"云蒸龙变","pinyin":"yún zhēng lóng biàn","abbr":"yzlb","explanation":"云气兴起，神龙飞动。比喻英雄豪杰遇时奋起。","source":{"text":"［魏豹、彭越］得摄尺寸之柄，其云蒸龙变，欲有所会其度，以故幽囚而不辞云。","book":"《史记·魏豹彭越列传论》"},"example":{"text":"豪杰之文章，～之气，遇感即发，宁容教深浅，商工拙于其间耶？","book":"清·钱谦益《〈顾太史文集〉序》"},"usage":"作宾语、定语；多用于比喻句"},{"id":4533,"word":"云蔚霞起","pinyin":"yún wèi xiá qǐ","abbr":"ywxq","explanation":"蔚：聚集。象云霞升腾聚集起来。形容景物灿烂绚丽。","source":{"text":"千岩竞秀，万壑争流。草木蒙笼其上，若云兴霞蔚。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"昔陶氏五男，不好纸笔，而遂溪之后，～，岂黄头历齿所敢望哉！（明·袁宏道《叙冎氏家绳集》）"},"similar":["云兴霞蔚","云蒸霞蔚"],"usage":"作谓语、定语、状语；指景色"},{"id":4534,"word":"云行雨施","pinyin":"yún xíng yǔ shī","abbr":"yxys","explanation":"施：施布。比喻广泛施行恩泽。","source":{"text":"云行雨施，天下平也。","book":"《周易·乾》"},"example":{"text":"曰：“如何是君臣之道？”师曰：“～，月皎星辉。”","book":"宋·释普济《五灯会元》卷十四"},"similar":["云行雨洽","云布雨施"],"usage":"作宾语、定语；指广施恩泽"},{"id":4535,"word":"云行雨洽","pinyin":"yún xíng yǔ qià","abbr":"yxyq","explanation":"比喻广施恩泽。","source":{"text":"云行雨洽，天临地持。","book":"《乐府诗集·舞曲歌辞一·北齐文武舞歌》"},"similar":["云行雨施","云布雨施"],"usage":"作宾语、定语；指广施恩泽"},{"id":4536,"word":"云谲波诡","pinyin":"yún jué bō guǐ","abbr":"yjbg","explanation":"谲：怪异；诡：变化多。好像云彩和水波那样，形态不可捉摸。原形容房屋构造就象云彩、波浪一样千姿百态。后多形容事物变幻莫测。","source":{"text":"于是大厦云谲波诡，摧摧而成观。","book":"汉·扬雄《甘泉赋》"},"example":{"text":"崇楼杰阁，曲廓洞房，锦簇花团，～。","book":"清·曾朴《孽海花》第十二回"},"usage":"作谓语；形容事物变幻莫测"},{"id":4537,"word":"云起水涌","pinyin":"yún qǐ shuǐ yǒng","abbr":"yqsy","explanation":"形容众人像云聚、像水涌一样从各处涌来并聚集在一起。","source":{"text":"太白五言律，如听钧天广乐，心开目明；如望海上仙山，云起水涌。又或通篇不着对偶，而兴趣天然，不可凑泊。常尉、孟山人时有之，太白尤臻其妙。","book":"清·吴乔《围炉诗话》"},"example":{"text":"洒热血于笔端，伸大义于天壤，举国志士，应之者～。（清·梁启超《意大利建国三杰传》第四节）"}},{"id":4538,"word":"云起雪飞","pinyin":"yún qǐ xuě fēi","abbr":"yqxf","explanation":"如云兴起，如雪飘飞。比喻乐曲悠扬，变化有致。","source":{"text":"度曲未终，云起雪飞，初若飘飘，后遂霏霏。","book":"汉·张衡《西京赋》"},"example":{"text":"撞钟伐鼓，～。","book":"唐玄宗《春中兴庆宫酺宴》诗序"},"usage":"作宾语、定语；用于比喻句"},{"id":4539,"word":"云起龙襄","pinyin":"yún qǐ lóng xiāng","abbr":"yqlx","explanation":"比喻英雄豪杰乘时而起。","source":{"text":"《汉书·叙传下》：“云起龙襄，化为侯王。”颜师古注：“襄，举也。”一本作“云起龙骧”。"},"similar":["云起龙骧"],"usage":"作谓语、定语；用于书面语"},{"id":4540,"word":"云起龙骧","pinyin":"yún qǐ lóng xiāng","abbr":"yqlx","explanation":"骧：腾起。如云涌升，如龙腾起。旧时比喻英雄豪杰乘时而起。","source":{"text":"云起龙骧，化为侯王。","book":"《汉书·叙传下》"},"usage":"作谓语；比喻英雄豪杰乘时而起"},{"id":4541,"word":"云趋鹜赴","pinyin":"yún qū wù fù","abbr":"yqwf","explanation":"比喻从四方奔赴而至。","source":{"text":"夫票盐售价不及纲盐之半，而纲商岸悬课绌，票商云趋鹜赴者，何哉？","book":"清·魏源《淮北票盐志叙》"},"usage":"作定语、状语；用于比喻句"},{"id":4542,"word":"云车风马","pinyin":"yún chē fēng mǎ","abbr":"ycfm","explanation":"指神灵的车马。","source":{"text":"云为车兮风为马。","book":"晋·傅玄《吴楚歌》"},"similar":["风马云车"],"usage":"作宾语、定语；多用于比喻句"},{"id":4543,"word":"云过天空","pinyin":"yún guò tiān kōng","abbr":"ygtk","explanation":"云彩飘过之后，天上格外空阔。比喻事情已经过去，一切恢复平静。","source":{"text":"把一桩惊风骇浪的案，办得来云过天空。","book":"清·文康《儿女英雄传》第十一回"},"similar":["云净天空"],"usage":"作宾语、状语；指不留痕迹"},{"id":4544,"word":"云迷雾罩","pinyin":"yún mí wù zhào","abbr":"ymwz","explanation":"形容天气昏暗，气氛阴森。","source":{"text":"忽然间昏惨惨云迷雾罩，疏剌剌风吹叶落，振山林声声虎啸，绕溪涧哀哀猿叫。","book":"明·李开先《宝剑记》第三七出"},"similar":["云迷雾锁"],"usage":"作谓语、定语；用于书面语"},{"id":4545,"word":"云迷雾锁","pinyin":"yún mí wù suǒ","abbr":"ymws","explanation":"形容天气昏暗，气氛阴森。","source":{"text":"巴的到绿杨渡口，早则是云迷雾锁黄昏后。","book":"元·无名氏《朱砂担》第二折"},"similar":["云迷雾罩"],"usage":"作谓语、定语；用于书面语"},{"id":4546,"word":"云遮雾罩","pinyin":"yún zhē wù zhào","abbr":"yzwz","explanation":"罩：覆盖。山被云雾笼罩，看不清它的真实面目。比喻故弄玄虚，暧昧不明。","example":{"text":"眼前有些～的，心里也是～。（王安忆《长恨歌》第三部第二章）"}},{"id":4547,"word":"云遮雾障","pinyin":"yún zhē wù zhàng","abbr":"yzwz","explanation":"云雾遮挡视线，看得很模糊。","example":{"text":"我不喜欢阴雨天的～。"},"usage":"作宾语、定语；指看不清"},{"id":4548,"word":"云锦天章","pinyin":"yún jǐn tiān zhāng","abbr":"yjtz","explanation":"云锦：神话传说中织女用彩云织出的锦缎。天章：彩云组合成的花纹。比喻文章极为高雅、华美。","source":{"text":"手抉云汉分天章，天孙为织云锦裳。","book":"宋·苏轼《潮州韩文公庙碑》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":4549,"word":"云阶月地","pinyin":"yún jiē yuè dì","abbr":"yjyd","explanation":"以云为阶，以月为地。指天上。亦指仙境。","source":{"text":"云阶月地一相过，未抵经年别恨多。","book":"唐·杜牧《七夕》诗"},"example":{"text":"诸女举娉婷闲雅，或歌或笑，香盈一室，真使人有～之想。","book":"清·吴骞《扶风传信录》"},"similar":["月地云阶"],"usage":"作宾语、定语；指风景优美的地方"},{"id":4550,"word":"云集响应","pinyin":"yún jí xiǎng yìng","abbr":"yjxy","explanation":"大家迅速集合在一起，表示赞同和支持。","source":{"text":"斩木为兵，揭竿为旗，天下云集响应，嬴粮而景从，山东豪杰遂并起而亡秦族矣。","book":"汉·贾谊《过秦论》"},"similar":["云和响应"],"usage":"作谓语、状语；用于书面语"},{"id":4551,"word":"云集景从","pinyin":"yún jí jǐng cóng","abbr":"yjjc","explanation":"如云聚合，如影随形。比喻声势浩大，响应迅速。","source":{"text":"天下云集响应，赢粮而景从。","book":"语出汉·贾谊《过秦论》"},"example":{"text":"主权在下之说，一倡百和，～。","book":"《辛亥革命前十年间时论选集·二十世纪之中国》"},"similar":["云集景附"],"usage":"作宾语、定语、状语；用于书面语"},{"id":4552,"word":"云集景附","pinyin":"yún jí jǐng fù","abbr":"yjjf","explanation":"如云聚合，如影随形。比喻声势浩大，响应迅速。","source":{"text":"中国若革命必行蜂起之策，一省倡仪，各方响应，云集景附，势必大强于法。","book":"汪东《正明夷〈法国革命史论〉》"},"similar":["云集景从"],"usage":"作宾语、定语、状语；用于书面语"},{"id":4553,"word":"云集雾散","pinyin":"yún jí wù sàn","abbr":"yjws","explanation":"像云一样聚集，像雾一样离散。比喻人事盛衰，聚散无常。","source":{"text":"朝发河海，夕宿江汉，沉浮往来，云集雾散。","book":"汉·班固《两都赋》"},"usage":"作定语、状语；用于书面语"},{"id":4554,"word":"云雨巫山","pinyin":"yún yǔ wū shān","abbr":"yyws","explanation":"原指古代神话传说巫山神女兴云降雨的事。后称男女欢合。","source":{"text":"妾在巫山之阳，高丘之阻。旦为朝云，暮为行雨，朝朝暮暮，阳台之下。","book":"战国楚·宋玉《高唐赋序》"},"example":{"text":"一枝红艳露凝香，～枉断肠。","book":"唐·李白《清平调》"},"similar":["巫山云雨","云雨高唐"],"usage":"作宾语、定语；用于男女之间"},{"id":4555,"word":"云雨高唐","pinyin":"yún yǔ gāo táng","abbr":"yygt","explanation":"原指古代神话传说巫山神女兴云降雨的事。后称男女欢合。","source":{"text":"妾在巫山之阳，高丘之阻。旦为朝云，暮为行雨，朝朝暮暮，阳台之下。","book":"战国·楚·宋玉《高唐赋序》"},"example":{"text":"～此地非，好持半偈悟禅机。（清·烟霞散人《合浦珠》第十五回）"},"similar":["云雨巫山"],"usage":"作宾语、定语；指男女之间"},{"id":4556,"word":"云雾之盛，顷刻而讫","pinyin":"yún wù zhī shèng，qīng kè ér qì","abbr":"ywzsqkeq","explanation":"盛：大；顷刻：一会儿；讫：完结。云雾再大，一会儿就消失干净。比喻某种势力不会长久。","source":{"text":"云雾之盛，顷刻而讫；暴雨之盛，不过终日。","book":"汉·魏朗《魏子》"},"usage":"作宾语、定语；用于比喻句"},{"id":4557,"word":"云雾迷蒙","pinyin":"yún wù mí méng","abbr":"ywmm","explanation":"迷蒙：形容模糊不清的样子。云雾笼罩，使景物隐隐约约，看不清楚。","source":{"text":"两条大江，骤然相见，欢腾拥抱，激起云雾迷蒙，波涛沸荡，至此似乎稍为平定，水天极目之处，灰蒙蒙的远山展开一卷清淡的水墨画。","book":"刘白羽《长江三日》"},"example":{"text":"战士们行进在云雾迷蒙的山间小路上。"}},{"id":4558,"word":"云霓之望","pinyin":"yún ní zhī wàng","abbr":"ynzw","explanation":"比喻迫切地盼望。","source":{"text":"霓，虹也。雨则虹见，故大旱而思见之。","book":"语出《孟子·梁惠王下》：“民望之，若大旱之望云霓也。”赵岐注"},"example":{"text":"望切者，若～；思深者，如雨露之恩。","book":"明·程登吉《幼学琼林·天文》"}},{"id":4559,"word":"云霞满纸","pinyin":"yún xiá mǎn zhǐ","abbr":"yxmz","explanation":"云霞：比喻文采。形容满眼都是精采的文笔、","source":{"text":"云霞雕色，有逾画工之妙。","book":"南朝·梁·刘勰《文心雕龙·原道》"},"example":{"text":"《金瓶梅》从何得来？伏枕略观，～，胜于枚生《七发》多矣。（明·袁宏道《锦帆集·董思白》）"}},{"id":4560,"word":"云飞泥沉","pinyin":"yún fēi ní chén","abbr":"yfnc","explanation":"①比喻消失。②比喻悬殊极大。","source":{"text":"云飞泥沉，卑高异等。","book":"《周书·王褒传》：“云飞泥沉，金铄兰灭。”《隋书·卢思道传》"},"example":{"text":"《隋书·卢思道传》：“～，卑高异等。”"},"similar":["云飞烟灭"],"usage":"作宾语、定语；用于书面语"},{"id":4561,"word":"云飞烟灭","pinyin":"yún fēi yān miè","abbr":"yfym","explanation":"比喻消逝。","source":{"text":"千古事、云飞烟灭。贺老定场无消息，想沉香亭北繁华歇。","book":"宋·辛弃疾《贺新郎·听琵琶》词"},"similar":["云飞泥沉","云飞雨散"],"usage":"作宾语、定语；用于书面语"},{"id":4562,"word":"云飞雨散","pinyin":"yún fēi yǔ sàn","abbr":"yfys","explanation":"比喻原先的事物不复存在。","source":{"text":"云飞雨散今如此，绣闼雕甍作荒谷。","book":"隋·张公礼《龙藏寺碑》：“金编宝字，玉牒纶言，满封盈函，云飞雨散。”前蜀·贯休《行路难》诗之二"},"example":{"text":"前蜀·贯休《行路难》诗：“～今如此，绣闼雕甍作荒谷。”"},"usage":"作宾语、定语；用于书面语"},{"id":4563,"word":"云鬟雾鬓","pinyin":"yún huán wù bìn","abbr":"yhwb","explanation":"头发象飘浮萦绕的云雾。形容女子发美。","source":{"text":"看他那云鬟雾鬓，杏脸桃腮，柳眉星眼，不由咱不动心也。","book":"元·无名氏《碧桃花》第一折"},"example":{"text":"莲凤玉肤花貌，～，真曲中尤物。","book":"清·俞蛟《潮嘉风月记·丽品》"},"usage":"作宾语、定语；用于女性"},{"id":4564,"word":"云龙井蛙","pinyin":"yún lóng jǐng wā","abbr":"yljw","explanation":"云端的龙，井底的蛙。比喻地位的高下相差极大。","source":{"text":"云龙喻贵，井蛙喻贱。","book":"清·周鲁辑《类书纂要》"},"example":{"text":"他们的地位有～一样的悬殊。"},"usage":"作宾语、定语；指地位悬殊"},{"id":4565,"word":"云龙风虎","pinyin":"yún lóng fēng hǔ","abbr":"ylfh","explanation":"虎啸生风，龙起生云。指同类的事物相感应。","source":{"text":"云从龙，风从虎，圣人作而万物睹。","book":"《周易·乾》"},"example":{"text":"英雄自合调羹鼎，～自相投。","book":"清·钱彩《说岳全传》第三回"},"similar":["英雄豪杰"],"opposite":["凡夫俗子"],"usage":"作宾语、定语；指英雄豪杰"},{"id":4566,"word":"云龙鱼水","pinyin":"yún lóng yú shuǐ","abbr":"ylys","explanation":"如同云与龙，鱼与水一样。比喻君臣相得","source":{"text":"宣宗幸万寿山、玉澜堂，锡宴十五老臣……云龙鱼水，夫岂偶然。","book":"清·陈康祺《郎潜纪闻》第14卷"},"usage":"作宾语、定语；用于比喻句"},{"id":4567,"word":"互不相容","pinyin":"hù bù xiāng róng","abbr":"hbxr","explanation":"互相不能容纳对方。指高职位官员之间的一种关系，在行使职权时彼此不一致。","example":{"text":"他们～，争个你死我活。"},"opposite":["宽宏大量"],"usage":"作谓语、定语；指对立"},{"id":4568,"word":"互为因果","pinyin":"hù wéi yīn guò","abbr":"hwyg","explanation":"原因和结果相互联系，相互转化。","source":{"text":"老师教得十分尽力，希望他继承自己的事业，再攀艺术高峰；学生非常刻苦，进步之快超出教师的逆料。于是，二者互为因果。","book":"韩振波《多余的人》"},"example":{"text":"这两者～，相互转化。"},"similar":["相辅相成"],"usage":"作谓语、定语；指相辅相成"},{"id":4569,"word":"互为标榜","pinyin":"hù wéi biāo bǎng","abbr":"hwbb","explanation":"标榜：夸耀。彼此之间互相吹嘘、颂扬。","source":{"text":"间或肆志风雅，率求名位相埒者，互为标榜，不复商榷于布衣之贱。","book":"清·朱彝尊《王礼部诗序》"},"similar":["互相标榜"],"usage":"作谓语、宾语；指互相吹嘘"},{"id":4570,"word":"互为表里","pinyin":"hù wéi biǎo lǐ","abbr":"hwbl","explanation":"甲为乙的外表，乙为甲的内里。比喻互相依存，互相接受。","source":{"text":"陈祗代允为侍中，与黄皓互为表里。","book":"晋·陈寿《三国志·董允传》"},"similar":["唇亡齿寒","唇齿相依","难解难分"],"opposite":["互不干涉","行同陌路"],"usage":"作谓语；主语必须是两个以上"},{"id":4571,"word":"互争雄长","pinyin":"hù zhēng xióng zhǎng","abbr":"hzxz","explanation":"相互之间展开竞争或斗争，以取得优胜或领导地位。"},{"id":4572,"word":"互剥痛疮","pinyin":"hù bō tòng chuāng","abbr":"hbtc","explanation":"比喻互揭阴私。","source":{"text":"潘大娘说林老太婆的媳妇结识戏子，林老太婆说潘大娘偷和尚，彼此互剥痛疮。","book":"《醒世缘弹词》第十回"},"opposite":["互为标榜"],"usage":"作谓语、定语；指相互揭短"},{"id":4573,"word":"互相推托","pinyin":"hù xiāng tuī tuō","abbr":"hxtt","explanation":"彼此之间互相推托，谁也不愿承担责任。","source":{"text":"彼此互相推托，皆齐之不收，反遗之以与金人用。","book":"《新刊大宋宣和遗事》"},"similar":["互相推诿"],"usage":"作谓语、宾语；指不负责任"},{"id":4574,"word":"互相推诿","pinyin":"hù xiāng tuī wěi","abbr":"hxtw","explanation":"诿：也作“委”，推辞；推诿：把责任推给别人。彼此之间互相推托，谁也不愿承担责任。","source":{"text":"甚至互相推托，以为能明哲。","book":"明·李贽《焚书·因记往事》"},"example":{"text":"彼此～，皆弃之不收，反遗之以与金人用。","book":"《新刊大宋宣和遗事》利集"},"similar":["互相推托"],"usage":"作谓语、宾语；指不负责任"},{"id":4575,"word":"互相标榜","pinyin":"hù xiāng biāo bǎng","abbr":"hxbb","explanation":"标榜：吹嘘，夸耀。互相称颂，互相吹嘘。多用贬义。","source":{"text":"自是正直废放，邪枉炽结，海内希风之流，遂贡相标榜，指天下名士，为之称号。","book":"《后汉书·党锢传序》"},"example":{"text":"君臣宣淫，～，朝堂之上，秽语难闻，廉耻丧尽，体统俱失。","book":"明·冯梦龙《东周列国志》第五十三回"},"similar":["相互捧场","相互吹嘘","狼狈为奸"],"usage":"作谓语、宾语；指互相吹嘘"},{"id":4576,"word":"互相残杀","pinyin":"hù xiāng cán shā","abbr":"hxcs","explanation":"残：毁坏，伤害。彼此之间相互残害，各不相容。","source":{"text":"天下之人，互相残杀。","book":"晋·陈寿《三国志·魏志·文帝纪》"},"example":{"text":"我们不能内部～。"},"usage":"作谓语、宾语；指内部战争"},{"id":4577,"word":"互通有无","pinyin":"hù tōng yǒu wú","abbr":"htyw","explanation":"通：往来。拿出自己多余的东西给对方主，与之进行交换，以得到自己所缺少的东西。","source":{"text":"为之贾，以通其有无。","book":"唐·韩愈《原道》"},"example":{"text":"现在汉匈～，关市大开。","book":"曹禺《王昭君》第三幕"},"similar":["投桃报李","有无相通","取长补短"],"usage":"作谓语、宾语；指交流"},{"id":4578,"word":"五丈灌韮","pinyin":"wǔ zhàng guàn jiǔ","abbr":"wzgj","explanation":"用来讽刺那些思想保守，守着老一套，拒绝接受先进经验的人。","source":{"text":"汉·刘向《说苑·反质》"}},{"id":4579,"word":"五世其昌","pinyin":"wǔ shì qí chāng","abbr":"wsqc","explanation":"世：代；其：时间副词，交要。五世之后，子孙昌盛。旧时用于祝人新婚。","source":{"text":"有妫之后，将育于姜。五世其昌，并于正卿。八世之后，莫之与京。","book":"春秋·鲁·左丘明《左传·庄公二十二年》"},"example":{"text":"乃培养天下元气，天之报施善人，岂止～。","book":"清·李绿园《歧路灯》第90回"},"usage":"作谓语；用于祝颂人新婚","story":["春秋时期，陈国内乱，太子御寇被杀，公子敬仲逃到齐国。齐大夫懿仲想把女儿嫁给敬仲，妻子占卜后说陈的后人在齐国第五代就要昌盛，地位和正卿一样高，于是他们就成婚。敬仲的第五代世孙陈桓子在齐国做大官，第八世孙陈成子取得齐国政权"]},{"id":4580,"word":"五亲六眷","pinyin":"wǔ qīn liù juàn","abbr":"wqlj","explanation":"指各种关系的亲眷。","source":{"text":"他的五亲六眷，家理师徒，磕头摆把的，布满全屯。","book":"周立波《暴风骤雨》第一部"},"similar":["三姑六婆"],"opposite":["非亲非故"],"usage":"作宾语、定语；用于口语"},{"id":4581,"word":"五体投地","pinyin":"wǔ tǐ tóu dì","abbr":"wttd","explanation":"两手、两膝和头一起着地。是佛教一种最恭敬的行礼仪式。比喻佩服到了极点。","source":{"text":"致敬之式，其仪九等：一、发言慰问，二、俯首示敬，三、举手高揖，四、合掌平拱，五、屈膝，六、长跪，七、手膝踞地，八、五轮俱屈，九、五体投地。","book":"唐·玄奘《大唐西域记·三国》"},"example":{"text":"屡闻至论，本极佩服，今日之说，则更～。","book":"清·刘鹗《老残游记》第六回"},"similar":["心悦诚服","甘拜下风"],"opposite":["嗤之以鼻"],"usage":"作谓语、定语、补语；比喻佩服到了极点"},{"id":4582,"word":"五体投诚","pinyin":"wǔ tǐ tóu chéng","abbr":"wttc","explanation":"比喻佩服到了极点。同“五体投地”。"},{"id":4583,"word":"五侯七贵","pinyin":"wǔ hòu qī guì","abbr":"whqg","explanation":"泛指达官显贵。","source":{"text":"昔在长安醉花柳，五侯七贵同杯酒。","book":"唐·李白《流夜郎赠卒判官》诗"},"example":{"text":"阿英《灯市》：“天子以至于～，又为什么要提倡灯会呢？”"},"similar":["五侯九伯","达官显宦","达官显贵"],"usage":"作宾语、定语；用于书面语"},{"id":4584,"word":"五侯九伯","pinyin":"wǔ hóu jiǔ bó","abbr":"whjb","explanation":"五侯：公、侯、伯、子、男五等诸侯；九伯：九州之长。泛指天下诸侯。","source":{"text":"五侯九伯，女实征之，以夹辅周室。","book":"春秋·鲁·左丘明《左传·僖公四年》"},"example":{"text":"～，无非问鼎之徒；四岳十连，皆畜无君之迹。","book":"《旧唐书·哀帝纪论》"},"similar":["五侯七贵"],"usage":"作主语、宾语；指贵族"},{"id":4585,"word":"五侯蜡烛","pinyin":"wǔ hòu là zhú","abbr":"whlz","explanation":"用以形容豪门权势的显赫景象。","source":{"text":"语出唐·韩翃《寒食》诗：“日暮汉宫传蜡烛，轻烟散入五侯家。”旧俗寒食节禁火，而宫中传烛分火于五侯之家，贵宠可见。"},"example":{"text":"清·陈维菘《喜迁莺》词：“千载鱼灯，～，赢得三春梦短。”"},"usage":"作宾语、定语；用于书面语"},{"id":4586,"word":"五光十色","pinyin":"wǔ guāng shí sè","abbr":"wgss","explanation":"形容色彩鲜艳，花样繁多。","source":{"text":"五光徘徊，十色陆离。","book":"南朝梁·江淹《丽色赋》"},"example":{"text":"故宫珍宝馆的玻璃柜里，摆着～的稀世奇珍。"},"similar":["五颜六色","万紫千红"],"opposite":["色彩单一"],"usage":"作谓语、定语、状语；指色彩丰富"},{"id":4587,"word":"五典三坟","pinyin":"wǔ diǎn sān fén","abbr":"wdsf","explanation":"犹言三坟五典。泛指古代典籍。","source":{"text":"贯串百家诸子，沉酣五典三坟。","book":"明·张景《飞丸记·赏春话别》"},"usage":"作主语、宾语、定语；指古书"},{"id":4588,"word":"五内俱崩","pinyin":"wǔ nèi jù bēng","abbr":"wnjb","explanation":"伤心得连内脏都破碎了。形容极度哀痛。","source":{"text":"见此崩五内，恍惚生狂痴。","book":"汉·蔡琰《悲愤》"},"similar":["五内俱焚"],"usage":"作谓语、定语、状语；用于伤心时"},{"id":4589,"word":"五内俱焚","pinyin":"wǔ nèi jù fén","abbr":"wnjf","explanation":"五内：五脏；俱：都；焚：烧。五脏都象着了火一样。形容象火烧得一样。比喻非常焦急。","source":{"text":"见此崩五内，恍惚生狂痴。","book":"汉·蔡琰《悲愤》"},"example":{"text":"偏偏事不从心，谋多未遂，怎得不～？","book":"蔡东藩、许厪父《民国通俗演义》第九十七回"}},{"id":4590,"word":"五内如焚","pinyin":"wǔ nèi rú fén","abbr":"wnrf","explanation":"五内：五脏；如：如同；焚：烧。五脏都象着了火一样。形容象火烧得一样。比喻非常焦急。","source":{"text":"见此崩五内，恍惚生狂痴。","book":"汉·蔡琰《悲愤》"},"example":{"text":"据弟打听，非备款百万，不能了事。似此从何筹画？前数天不见兄长覆示，～。","book":"清·黄小配《廿载繁华梦》第三十三回"},"similar":["五内如裂","心如刀割"],"opposite":["欣喜若狂","心花怒放"],"usage":"作谓语；形容非常焦急"},{"id":4591,"word":"五冬六夏","pinyin":"wǔ dōng liù xià","abbr":"wdlx","explanation":"犹言不论寒暑。不管什么时候。","source":{"text":"不论白天黑夜，五冬六夏，她穿着件小破花褂子，在那儿放哨。","book":"魏巍《山雨》"},"usage":"作宾语、定语；用于口语"},{"id":4592,"word":"五劳七伤","pinyin":"wǔ láo qī shāng","abbr":"wlqs","explanation":"泛指各种疾病和致病因素。","source":{"text":"糊突虫云：'我会医五劳七伤。'","book":"元·刘唐卿《降桑椹》第二折"},"example":{"text":"大同之世，生人最乐，内无～之感，外极饮食、宫室、什器、服用、道路之精。","book":"清·康有为《大同书》甲部第三章"},"similar":["三病两痛","五痨七伤"],"usage":"作谓语、宾语；泛指虚弱多病"},{"id":4593,"word":"五十步笑百步","pinyin":"wǔ shí bù xiào bǎi bù","abbr":"wsbxbb","explanation":"作战时后退了五十步的人讥笑后退了百步的人。比喻自己跟别人有同样的缺点错误，只是程度上轻一些，却毫无自知之明地去讥笑别人。","source":{"text":"填然鼓之，兵刃既接，弃甲曳兵而走，或百步而后止，或五十步而后止。以五十步笑百步，则何如？","book":"《孟子·梁惠王上》"},"example":{"text":"比如老将军算是忠心，犹能建立宋朝旗号，然仅逍遥河上，逗留不进，坐视君父之难，只算得以～。","book":"清·陈忱《水浒后传》第二十五回"},"similar":["以五十步笑百步"],"usage":"作宾语、分句；指自作聪明","story":["战国时期，梁惠王向孟子请教为什么人口不增长的原因，孟子说：“你是关心百姓的疾苦，但你喜欢打仗，不少百姓死于战争。打比方说战争中潜逃50步的士兵讥笑逃100步的士兵，逃跑的本质是一样的。”梁惠王表示将要停止打仗"]},{"id":4594,"word":"五合六聚","pinyin":"wǔ hé liù jù","abbr":"whlj","explanation":"比喻屡次聚合到一起。","source":{"text":"天下五合六聚而不敢救，王之威亦单矣。","book":"《史记·春申君列传》"},"usage":"作谓语；指多次聚合到一起"},{"id":4595,"word":"五味俱全","pinyin":"wǔ wèi jù quán","abbr":"wwjq","explanation":"五味：酸甜苦辣咸的合称。形容调味齐全适宜。","source":{"text":"五味六和，十二食，还相为质也。","book":"《礼记·礼运》"},"example":{"text":"大人你明如镜，清似水，照妾身肝胆虚实，那羹本～。","book":"元·关汉卿《窦娥冤》第二折"},"usage":"作谓语、定语；用于人的心境等"},{"id":4596,"word":"五大三粗","pinyin":"wǔ dà sān cū","abbr":"wdsc","explanation":"形容人高大粗壮，身材魁梧。","source":{"text":"猛回头，身后站着一个五大三粗的人，仔细一看是大贵。","book":"梁斌《播火记》"},"example":{"text":"他长得～，十分难看。"},"similar":["牛高马大"],"usage":"作谓语、定语；指人高大粗壮"},{"id":4597,"word":"五子登科","pinyin":"wǔ zǐ dēng kē","abbr":"wzdk","explanation":"用作结婚的祝福词或吉祥语。","source":{"text":"《宋史·窦仪传》记载：宋代窦禹钧的五个儿子仪、俨、侃、偁、僖相继及第，故称“五子登科”。"},"example":{"text":"一来就‘～’，这种风气不好。","book":"周恩来《在文艺工作座谈会和故事片创作会议上的讲话》"},"usage":"作宾语、定语；用作结婚的祝福词"},{"id":4598,"word":"五季之酷","pinyin":"wǔ jì zhī kù","abbr":"wjzk","explanation":"五季：指后梁、后晋、后汉、后周、后唐五代；酷：严酷的祸患。指五代时的严酷祸患。","source":{"text":"及其乱离，继以五季之酷，其池塘竹树，兵车蹂践，废而为丘墟。","book":"宋·李格非《洛阳名园记·论》"}},{"id":4599,"word":"五尺之僮","pinyin":"wǔ chǐ zhī tóng","abbr":"wczt","explanation":"指尚未成年的儿童。古尺短，故称。同“五尺之童”。","source":{"text":"外无期功强近之亲，内无应门五尺之僮。","book":"晋·李密《陈情表》"},"similar":["五尺之童","五尺童子","五尺竖子"],"usage":"作宾语、定语；用于书面语"},{"id":4600,"word":"五尺之童","pinyin":"wǔ chǐ zhī tóng","abbr":"wczt","explanation":"指尚未成年的儿童。古尺短，故称。","source":{"text":"从许子之道，则市价不贰，国中无伪；虽使五尺之童适市，莫之或欺。","book":"《孟子·滕文公子》"},"example":{"text":"俺夫人治家严肃，有冰霜之操。内无应门～，年至十二三者，非呼召不敢辄入中堂。","book":"元·王实甫《西厢记》第一本第二折"},"similar":["五尺童子","五尺之僮"],"usage":"作宾语、定语；指儿童"},{"id":4601,"word":"五尺微童","pinyin":"wǔ chǐ wēi tóng","abbr":"wcwt","explanation":"五尺：古代尺短，所以以五尺指儿童的身高。泛指儿童。","source":{"text":"虽使五尺之童适市，莫之或欺。","book":"《孟子·滕文公上》"}},{"id":4602,"word":"五尺竖子","pinyin":"wǔ chǐ shù zǐ","abbr":"wcsz","explanation":"指尚未成年的儿童。古尺短，故称。同“五尺之童”。","source":{"text":"仲尼之门，五尺之竖子言羞称乎五伯。","book":"战国·赵·荀况《荀子·仲尼》"},"similar":["五尺童子"],"usage":"作宾语、定语；用于书面语"},{"id":4603,"word":"五尺童子","pinyin":"wǔ chǐ tóng zǐ","abbr":"wctz","explanation":"五尺：古代尺短，所以以五尺指儿童的身高。泛指儿童。","source":{"text":"不知夫五尺童子，方将调饴胶丝，加之乎四仞之上，而下为蝼蚁食也。","book":"《战国策·楚策四》"},"example":{"text":"梁启超《近世文明初祖培根笛卡儿之学说》：“欧美～所莫不钦诵，而吾国人所当探求其故者也。”"},"similar":["五尺之童","五尺竖子"],"usage":"作宾语、定语；用于书面语"},{"id":4604,"word":"五州四海","pinyin":"wǔ zhōu sì hǎi","abbr":"wzsh","explanation":"泛指世界各地。"},{"id":4605,"word":"五帝三皇","pinyin":"wǔ dì sān huáng","abbr":"wdsh","explanation":"五帝：少昊、颛顼、帝喾、尧、舜；三皇：伏羲、神农、黄帝。原为传说中我国远古的部落酋长。后借指远古时代的帝王。","source":{"text":"掌三皇五帝之书。","book":"《周礼·春官·外史》"},"example":{"text":"稼穑艰难总不知，～是何物。","book":"唐·贯休《少年行》"}},{"id":4606,"word":"五彩斑斓","pinyin":"wǔ cǎi bān lán","abbr":"wcbl","explanation":"五彩：指青、黄、赤、白、黑五色。指多种颜色错杂而繁多耀眼。","source":{"text":"黑色的枝杈，红色的枣子，黄绿相间的树叶，五彩斑斓，迷人极了。","book":"路遥《平凡的世界》第一卷第七章"},"example":{"text":"在～的水石间，鱼群闪闪的鳞光映着雪水清流。","book":"碧野《天山景物记》"},"similar":["五彩缤纷"],"usage":"作谓语、宾语、定语；指颜色繁多"},{"id":4607,"word":"五彩缤纷","pinyin":"wǔ cǎi bīn fēn","abbr":"wcbf","explanation":"五彩：各种颜色；缤纷：繁多交错的样子。指颜色繁多，非常好看。","source":{"text":"铺设得五彩缤纷，当中摆了姊姊画的那一堂寿屏，两旁点着五六对青烛。","book":"清·吴趼人《二十年目睹之怪现状》"},"example":{"text":"天大亮了，多云的天空，布满了～的朝霞。","book":"袁静《伏虎记》第13回"},"similar":["五颜六色","万紫千红"],"opposite":["一成不变"],"usage":"作谓语、宾语、定语；指颜色繁多"},{"id":4608,"word":"五心六意","pinyin":"wǔ xīn liù yì","abbr":"wxly","explanation":"形容心思不定。","source":{"text":"五心六意，岐道多怪。","book":"汉朝焦彦寿《易林》卷十"},"similar":["三心二意"],"usage":"作谓语、定语；指三心二意"},{"id":4609,"word":"五抢六夺","pinyin":"wǔ qiǎng liù duó","abbr":"wqld","explanation":"指竞相抢夺。","source":{"text":"船一靠岸，他们便蜂拥上来，遇着街上有卖食的便五抢六夺地捞到口里。","book":"郭沫若《水平线下·到宜兴去》"},"usage":"作谓语、状语；用于口语"},{"id":4610,"word":"五斗先生","pinyin":"wǔ dǒu xiān shēng","abbr":"wdxs","explanation":"指酒量大的人。","source":{"text":"其饮至五斗不乱，人有以酒邀者，无贵贱辄往，著《五斗先生传》。","book":"《新唐书·王绩传》"},"example":{"text":"十年护得檐前桧，莫咏蛰龙奇句。谁酌醑。试共看东皋，～谱。","book":"元·马熙《摸鱼子》词"}},{"id":4611,"word":"五斗折腰","pinyin":"wǔ dǒu zhé yāo","abbr":"wdzy","explanation":"五斗：五斗米，指微薄的官俸；折腰：弯腰行礼。为微薄的俸禄而对上级卑躬屈膝。","source":{"text":"吾不能为五斗米折腰。","book":"《晋书·陶潜传》"},"example":{"text":"性秉钢坚，心贞冰洁，岂因～。","book":"明·王世贞《鸣凤记》第五出"},"similar":["不为五斗米折腰"],"usage":"作谓语、宾语；指卑躬屈膝","story":["晋朝时陶潜（字渊明）先后做过几次官，因当时吏治非常腐败，他不愿同流合污，更不愿为五斗米官俸而自取屈辱，就辞官归隐。他隐居山涧，穿粗麻布衣，自己劳作，晚年贫病交加，江州刺史檀道济请他去做官，他婉言拒绝"]},{"id":4612,"word":"五斗解酲","pinyin":"wǔ dǒu jiě chéng","abbr":"wdjc","explanation":"酲：喝醉了神志不清。以五斗酒来解酒病。比喻非常荒谬。","source":{"text":"末生刘伶，以酒为名，一饮一斛，五斗解酲。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"～犹恨少，十分飞盏未嫌多。","book":"唐·元稹《放言五首》其一"}},{"id":4613,"word":"五方杂厝","pinyin":"wǔ fāng zá cuò","abbr":"wfzc","explanation":"指各地方的人杂居一处。形容居民复杂。","source":{"text":"是故五方杂厝，风俗不纯。","book":"《汉书·地理志下》"},"similar":["五方杂处"],"usage":"作宾语、定语；指从什么地方来的人都有"},{"id":4614,"word":"五方杂处","pinyin":"wǔ fāng zá chǔ","abbr":"wfzc","explanation":"五方：东南西北中，泛指各处；处：住。形容大城市的居民，从什么地方来的人都有。","source":{"text":"是故五方杂厝，风俗不纯。","book":"《汉书·地理志下》"},"example":{"text":"此国人为何生一张猪嘴？而且语音不同，倒象～一般，是何缘故？","book":"清·李汝珍《镜花缘》第二十七回"},"similar":["五方杂厝","龙蛇混杂"],"usage":"作宾语、定语；指从什么地方来的人都有"},{"id":4615,"word":"五日一风，十日一雨","pinyin":"wǔ rì yī fēng，shì rì yī yǔ","abbr":"wryfsryy","explanation":"指每天刮一次风，十天下一场雨。形容风调雨顺。旧时作为太平盛世的吉祥征兆。","source":{"text":"风不鸣条，雨不破块，五日一风，十日一雨。","book":"汉·王充《论衡·是应篇》"},"example":{"text":"列位从此后，～，还来拯救拯救。","book":"明·吴承恩《西游记》第八十七回"},"similar":["五风十雨"],"usage":"作宾语、定语；用于书面语"},{"id":4616,"word":"五日京兆","pinyin":"wǔ rì jīng zhào","abbr":"wrjz","explanation":"京兆：即京兆尹，古时国都所在地的行政长官。比喻任职时间短或即将去职。","source":{"text":"吾为是公尽力多矣，今五日京兆耳，安能复案事？","book":"《汉书·张敞传》"},"example":{"text":"暗想自己已是～了，乐得卖个人情与袁伯珍。","book":"清·无名氏《官场维新记》第十三回"},"usage":"作宾语、定语；指凡事不作长久打算","story":["西汉时期，平通侯杨恽居功自傲被判死刑，与杨恽有关的官员几乎都被停职。他的朋友京兆尹张敞因为受汉宣帝的信任暂时没有停职，张敞的手下絮舜听说张敞即将停职，说他是“五日京兆”而拒绝办公，张敞在下任之前严惩絮舜"]},{"id":4617,"word":"五星联珠","pinyin":"wǔ xīng lián zhū","abbr":"wxlz","explanation":"五星：金、木、水、火、土星。五颗行星出现在同一方向，被认为是祥瑞兆头。","source":{"text":"八月朔旦，日月合璧，五星联珠，登极之日，久阴忽霁，八表镜清。","book":"清·薛福成《庸庵笔记·咸丰季年三奸伏诛》"},"similar":["五星连珠"],"usage":"作宾语、定语；用于书面语"},{"id":4618,"word":"五星连珠","pinyin":"wǔ xīng lián zhū","abbr":"wxlz","explanation":"五星：金、木、水、火、土星。五颗行星出现在同一方向，被认为是祥瑞兆头。","source":{"text":"凤凰在庭，朱草生，嘉禾秀，甘露润，醴泉出，日月如合璧，五星如连珠。","book":"《竹书纪年》上卷"},"example":{"text":"和气上通于天，虽～，两曜合璧，未足多也。","book":"《旧唐书·张廷珪传》"},"similar":["五星联珠"],"usage":"作宾语、定语；用于书面语"},{"id":4619,"word":"五更三点","pinyin":"wǔ gēng sān diǎn","abbr":"wgsd","explanation":"五更：古代一夜区分为五更，五更为早四点至六点。五更的第三点，约是早五点十分左右。","source":{"text":"五更三点索金车，尽放宫人出看花。","book":"唐·王建《宫词》"},"example":{"text":"打到～，敲肿了四个人的八只手不算，还敲碎了砖头瓦片一堆。","book":"清·西周生《醒世姻缘传》第八十三回"}},{"id":4620,"word":"五月披裘","pinyin":"wǔ yuè pī qiú","abbr":"wypq","explanation":"比喻清高廉洁。","source":{"text":"五月披裘而负薪，岂取金者哉？","book":"晋·皇甫谧《高士传》卷上"},"usage":"作谓语、定语；指人清高廉洁"},{"id":4621,"word":"五月粜新谷","pinyin":"wǔ yuè tiào xīn gǔ","abbr":"wytxg","explanation":"五月里稻谷尚未熟，就预卖新谷。比喻十分贫穷。","source":{"text":"二月卖新丝，五月粜新谷；医得眼前疮，剜却心头肉。","book":"唐·聂夷中《咏田家》诗"},"example":{"text":"他们家～，十分贫穷。"},"usage":"作谓语、宾语、定语；指十分贫穷"},{"id":4622,"word":"五月飞霜","pinyin":"wǔ yuè fēi shuāng","abbr":"wyfs","explanation":"借指冤狱。","source":{"text":"邹衍无罪，见拘于燕，当夏五月，仰天而叹，天为陨霜。","book":"汉·王充《论衡·感虚》"},"example":{"text":"燕臣昔恸哭，五月飞秋霜。","book":"唐·李白《古风》"}},{"id":4623,"word":"五李三张","pinyin":"wǔ lǐ sān zhāng","abbr":"wlsz","explanation":"南唐时著名墨工李廷珪和宋代著名墨工张遇和合称。后来作为墨的别称。","source":{"text":"这墨光照文房，取烟在太华顶上仙人掌。更压着五李三张，入砚松风响。","book":"元·马致远《岳阳楼》第一折"}},{"id":4624,"word":"五步一楼，十步一阁","pinyin":"wǔ bù yī lóu，shí bù yī gé","abbr":"wbylsbyg","explanation":"形容亭台楼阁之多。","source":{"text":"五步一楼，十步一阁；廓腰缦回，檐牙高啄。","book":"唐·杜牧《阿房宫赋》"},"example":{"text":"上了苏堤，中间是金沙港，转过去就望见雷峰塔，到了净慈寺，有十多里路，真乃～。","book":"清·吴敬梓《儒林外史》第十四回"}},{"id":4625,"word":"五步成诗","pinyin":"wǔ bù chéng shī","abbr":"wbcs","explanation":"唐史青能五步成诗。后用以比喻才思敏捷。","source":{"text":"清·沈炳震《唐诗金粉·敏悟》：“青上书自荐能诗，云：‘子建七步，臣五步之内可塞明诏。’明皇试以除夕、上元、竹火笼等诗，应口而出。上称赏，授以官。”今存《应诏赋得除夜》一首，见《全唐诗》卷一一五。"},"similar":["七步成诗"],"usage":"作谓语、定语；用于作文等"},{"id":4626,"word":"五毒俱全","pinyin":"wǔ dú jù quán","abbr":"wdjq","explanation":"五毒：多指蛇、蝎、蜈蚣、壁虎、蟾蜍五种动物。指违法乱纪，各种坏事都做。","source":{"text":"本来是掏个钱包进了监狱，出来就五毒俱全了。","book":"王朔《过把瘾就死》"},"example":{"text":"他～，无恶不作。"},"similar":["无恶不作"],"usage":"作谓语、定语；指各种坏事都做"},{"id":4627,"word":"五洲四海","pinyin":"wǔ zhōu sì hǎi","abbr":"wzsh","explanation":"泛指世界各地。","source":{"text":"五洲四海的人们，都在以不同的眼光和兴趣，注视着中国未来的发展。","book":"司马达《魔鬼的笛音》"},"usage":"作宾语、定语；用于书面语"},{"id":4628,"word":"五湖四海","pinyin":"wǔ hú sì hǎi","abbr":"whsh","explanation":"指全国各地，有时也指世界各地。现有时也比喻广泛的团结。","source":{"text":"斗笠为帆扇作舟，五湖四海任遨游。","book":"《周礼·夏官·职方氏》：“其浸五湖。”《论语·颜渊》：“四海之内，皆兄弟也。”唐·吕岩《绝句》"},"example":{"text":"我们都是来自～，为了一个共同的革命目标，走到一起来了。","book":"毛泽东《为人民服务》"},"similar":["四面八方","五洲四海"],"opposite":["方寸之地"],"usage":"作主语、宾语；指全国各地"},{"id":4629,"word":"五申三令","pinyin":"wǔ shēn sān lìng","abbr":"wssl","explanation":"三令五申。指再三告诫。","source":{"text":"玉律金科，虑爽重轻之信；五申三令，渐乖训抚之宜。","book":"前蜀·杜光庭《川主太师南斗大醮词》"},"similar":["三令五申"],"usage":"作谓语、宾语、定语；用于处事"},{"id":4630,"word":"五男二女","pinyin":"wǔ nán èr nǚ","abbr":"wnen","explanation":"有子五人，有女二人。后用以表示子孙繁衍，有福气。宋时常绘印五男二女图于纸笺或礼品上以示祝福。","source":{"text":"武王五男二女。","book":"《诗·召南·何彼襛矣序》孔颖达疏引晋皇甫谧云"}},{"id":4631,"word":"五痨七伤","pinyin":"wǔ láo qī shāng","abbr":"wlqs","explanation":"泛指虚弱多病。","source":{"text":"两位马先生都没有脏病，也没有五痨七伤，于是又平安的过了一关。","book":"老舍《二马》"},"example":{"text":"两位马先生都没有脏病，也没有～，于是又平安的过了一关。","book":"老舍《二马》"},"similar":["五劳七伤"],"usage":"作谓语、宾语；泛指虚弱多病"},{"id":4632,"word":"五百年前是一家","pinyin":"wǔ bǎi nián qián shì yī jiā","abbr":"wbnqsyj","explanation":"上祖本是同一宗族。指同姓相称，拉攀关系。","source":{"text":"可不道一般树上有两般花，五百年前是一家。","book":"元·郑廷玉《布袋和尚忍字记》楔子"},"example":{"text":"你既读姓牛，～，我和你祖孙相称罢。","book":"清·吴敬梓《儒林外史》第二十二回"}},{"id":4633,"word":"五短三粗","pinyin":"wǔ duǎn sān cū","abbr":"wdsc","explanation":"形容人身材矮小但很粗壮。","source":{"text":"姓陈名叫大勇，年有三十五六岁，生的五短三粗，相貌魁伟。","book":"清·无名氏《刘公案》第三回"},"example":{"text":"他长得～，十分难看。"},"similar":["五大三粗"],"usage":"作定语、状语；用于口语"},{"id":4634,"word":"五短身材","pinyin":"wǔ duǎn shēn cái","abbr":"wdsc","explanation":"指人的身材矮小。","source":{"text":"这个好汉，祖贯两淮人氏，姓王，名英，为他五短身材，江湖上叫他做矮脚虎。","book":"明·施耐庵《水浒传》第三十二回"},"example":{"text":"～偏有趣，二八年纪正当时。","book":"明·冯梦龙《喻世明言》第十卷"},"similar":["五短三粗"],"usage":"作谓语、定语；指人的身材矮小"},{"id":4635,"word":"五石六鹢","pinyin":"wǔ shí liù yī","abbr":"wsly","explanation":"后用以比喻记述准确或为学缜密有序。","source":{"text":"霣石于宋五。是月，六鹢退飞过宋都。曷为先言霣而后言石？霣石记闻，闻其磌然，视之则石，察之则五……曷为先言六而后言鹢？六鹢退飞，记见也，视之则六，察之则鹢，徐而察之则退飞。","book":"语出《公羊传·僖公十六年》"},"example":{"text":"宋·彭乘《墨客挥犀》第七卷：“古人于小诗用意精深如此，况其大者乎，盖其学问渊源，有～之旨。”"},"usage":"作宾语、定语；用于书面语"},{"id":4636,"word":"五积六受","pinyin":"wǔ jī liù shòu","abbr":"wjls","explanation":"形容不便活动，只能呆板地坐着。","source":{"text":"这五积六受的甚么模样？可是叫亲家笑话。","book":"清·西周生《醒世姻缘传》第59回"},"usage":"作定语、状语；用于书面语"},{"id":4637,"word":"五窦联珠","pinyin":"wǔ dòu lián zhū","abbr":"wdlz","explanation":"五窦：唐代窦氏五兄弟。指人兄弟都善作文。","source":{"text":"兄常、牟、弟痒、巩皆为郎，工词章，为《联珠集》行于时，义取昆弟若五星然。","book":"《新唐书·窦群传》"},"example":{"text":"揆之诸父前编，则～，奚是为誉。","book":"明·顾起纶《国雅品·士品四》"},"usage":"作宾语、定语；用于书面语"},{"id":4638,"word":"五类杂种","pinyin":"wǔ lèi zá zhǒng","abbr":"wlzz","explanation":"指各种各类。","source":{"text":"五类杂种，兴乎外，肖形而蕃。","book":"西汉·刘安《淮南子·隧形训》"},"usage":"作宾语、定语；用于书面语"},{"id":4639,"word":"五经库","pinyin":"wǔ jīng kù","abbr":"wjk","explanation":"五经：儒家的五部经典，即《周易》、《尚书》、《诗经》、《礼记》、《春秋》。比喻熟读五经的人。","source":{"text":"及高祖受禅，迁太常博士。太常卿牛弘每称为五经库。","book":"《隋书·儒林传·房晖远》"}},{"id":4640,"word":"五经扫地","pinyin":"wǔ jīng sǎo dì","abbr":"wjsd","explanation":"五经：借指文人。把文人的脸都丢尽了。旧时也指圣人之道泯灭。","source":{"text":"帝与群臣宴，钦明自言能《八风舞》，帝许之。钦明体肥丑，据地摇头睆目，左右顾眄，帝大笑。吏部侍郎卢藏用叹曰：‘是举《五经》扫地矣。’","book":"《新唐书·祝钦明传》"},"example":{"text":"明·程登吉《幼学琼林》第三卷：“～，祝钦明自亵斯文；一木撑天，晋王敦未可擅动。”"},"similar":["斯文扫地"],"usage":"作宾语、定语；用于书面语","story":["唐朝时期，皇帝召集群臣宴饮，国子监察酒祝钦明说自己会跳八风舞，皇帝即刻让他表演助兴。祝钦明身体肥胖，跳舞丑态百出，时而头点地，时而做鬼脸，皇帝大笑。侍郎卢藏用评论说：祝公五经扫地，亵渎文明"]},{"id":4641,"word":"五经笥","pinyin":"wǔ jīng sì","abbr":"wjs","explanation":"笥：盛饭食或衣物的方形竹器。比喻熟读五经的人。","source":{"text":"腹便便，五经笥。","book":"《后汉书·边韶传》"},"example":{"text":"向用～，今为千里行。","book":"李颀《春送从叔游襄阳》"}},{"id":4642,"word":"五羖大夫","pinyin":"wǔ gǔ dà fū","abbr":"wgdf","explanation":"羖：公羊。特指春秋虞有贤才的大夫百里奚。","source":{"text":"乃使人谓楚曰：‘吾媵臣百里奚在焉，请以五羖羊皮赎之。’……缪公大说，授之国政，号早曰‘五羖大夫’。","book":"《史记·秦本纪》"},"example":{"text":"秦人都称奚为～。","book":"明·冯梦龙《东周列国志》第二十五回"},"usage":"作宾语、定语；用于书面语","story":["战国时期，晋献公用碧玉骏马向虞国行贿借道灭掉虢国与虞国，俘虏虞国大夫百里奚，并将他作为奴隶陪嫁到楚国。秦穆公用五张羊皮换取并释放他，与他共商国事，百里奚向他推荐蹇叔，秦穆公重金迎接蹇叔，百里奚与蹇叔、由余等辅佐穆公建立了霸业"]},{"id":4643,"word":"五脊六兽","pinyin":"wǔ jí liù shòu","abbr":"wjls","explanation":"用于宏伟的宫殿屋顶建筑。也形容心烦意乱，忐忑不安。","source":{"text":"这些矛盾在他心中乱碰，使他一天到晚的五脊六兽的不大好过。","book":"老舍《四世同堂》"},"usage":"作定语；指心烦意乱"},{"id":4644,"word":"五脏六腑","pinyin":"wǔ zàng liù fǔ","abbr":"wzlf","explanation":"五脏：脾、肺、肾、肝、心；六腑：胃、大肠、小肠、三焦、膀胱、胆。人体内脏器官的统称。也比喻事物的内部情况。","source":{"text":"凡人三百六十节、九窍、五脏六腑。","book":"《吕氏春秋·达郁》"},"example":{"text":"牛先生乍到这里，实际情况还不清楚。住久了，～里的毛病你就看清啦。","book":"姚雪垠《李自成》第个卷第二十八章"},"similar":["骨子里面","五藏六府"],"usage":"作宾语、定语；指人的内心"},{"id":4645,"word":"五色无主","pinyin":"wǔ sè wú zhǔ","abbr":"wswz","explanation":"五色：指人脸上的神采；无主：无法主宰。形容恐惧而神色不定。","source":{"text":"禹南省，方济乎江，黄龙负舟，舟中之人，五色无主。","book":"战国·卫·吕不韦《吕氏春秋·知分》"},"example":{"text":"叶公见之，弃而还走，失其魂魄，～。","book":"西汉·刘向《新序·杂事》"},"similar":["六神无主"],"opposite":["镇定自若"],"usage":"作谓语、定语；指恐惧","story":["传说舜统治时期，禹奉命治理黄河水患。一次禹带人渡长江巡视，在江心见一条巨大的黄龙从江水里冒出头来，船上的人大惊失色，五色无主。只有禹镇定自若，对黄龙说他可以视死如归。黄龙听了禹的话，只好沉入江底溜走了"]},{"id":4646,"word":"五色相宣","pinyin":"wǔ sè xiāng xuān","abbr":"wsxx","explanation":"各种相互映衬。形容诗歌辞藻华丽。","source":{"text":"夫五色相宣，八音协畅，由乎玄黄律吕，各适物宜。","book":"《宋书·谢灵运传论》"},"example":{"text":"子建诗，～，八音朗畅，使才而不矜才，用博而不逞博。","book":"清·沈德潜《古诗源》卷五"}},{"id":4647,"word":"五色缤纷","pinyin":"wǔ sè bīn fēn","abbr":"wsbf","explanation":"形容色彩纷繁艳丽。","source":{"text":"连日把书房改做了帐房……铺设得五色缤纷。","book":"清·吴趼人《二十年目睹之怪现状》第43回"},"example":{"text":"像魔术似地从地下涌出一丛鲜花，～，散发出喷鼻的香味。","book":"《中国民间故事选·海螺姑娘》"},"similar":["五彩缤纷","五颜六色"],"usage":"作谓语、定语；指颜色繁多"},{"id":4648,"word":"五花八门","pinyin":"wǔ huā bā mén","abbr":"whbm","explanation":"原指五行阵和八门阵。这是古代两种战术变化很多的阵势。比喻变化多端或花样繁多。","source":{"text":"伏龙以西，群峰乱峙，四布罗列，如平沙万幕，八门五花。","book":"《虞初新志·孙嘉淦》"},"example":{"text":"湖北的省政府在当时真正是一种鱼龙漫衍的“模范政府”，那个委员会～地是什么人品都有。","book":"郭沫若《革命春秋·北伐途次》"},"similar":["形形色色","五光十色"],"opposite":["一成不变"],"usage":"作谓语、定语；指种类多"},{"id":4649,"word":"五花大绑","pinyin":"wǔ huā dà bǎng","abbr":"whdb","explanation":"先用绳索套住脖子，又绕到背后反剪两臂的绑入方式。","source":{"text":"顺着捆来横着绑，五花大绑吊在二梁上。","book":"李季《王贵与李香香》第二部二"},"example":{"text":"一瞬之间，他已被～起来。粗大的杠子立即压折了他的双腿。","book":"柯岩《奇异的书简·美的追求者》"},"usage":"作宾语、定语；指绑人的方法"},{"id":4650,"word":"五花杀马","pinyin":"wǔ huā shā mǎ","abbr":"whsm","explanation":"毛色凋落的马。比喻年老体衰。"},{"id":4651,"word":"五荤三厌","pinyin":"wǔ hūn sān yàn","abbr":"whsy","explanation":"五荤：佛教忌食的五种蔬菜，即大蒜、小蒜、兴渠、慈葱、茗葱；三厌：道教忌食的三种肉：即雁、狗、乌龟。泛指饮食的禁忌。","source":{"text":"师父，我受了菩萨戒行，断了五荤三厌，在我丈人家持斋把素，更不曾动荤，今日见了师父，我开了斋罢。","book":"明·吴承恩《西游记》第十九回"}},{"id":4652,"word":"五蕴皆空","pinyin":"wǔ yùn jiē kōng","abbr":"wyjk","explanation":"五蕴：佛家语，指色、受、想、行、识。众生由此五者积集而成身，故称五蕴。五蕴都没有了。指佛家修行的最高境界。","source":{"text":"观自在菩萨，行深船若波罗密多，时照见五蕴皆空，度一切苦厄。","book":"《心经》"},"example":{"text":"抑闻之，～，六尘不染，是谓和尚。","book":"清·蒲松龄《聊斋志异·金生尚》"}},{"id":4653,"word":"五藏六府","pinyin":"wǔ cáng liù fǔ","abbr":"wclf","explanation":"指体内全部器官。五藏：心、肺、脾、肝、肾。六府：大肠、小肠、胃、胆、膀胱、三焦。亦作“五脏六腑”。","source":{"text":"凡人三百六十节，九窃，五藏六府。","book":"战国·卫·吕不韦《吕氏春秋·达郁》"},"example":{"text":"清·俞樾《茶香室丛钞·长沮桀溺语》：“～，尚有未洁。”"},"similar":["五脏六腑"],"usage":"作宾语、定语；用于书面语"},{"id":4654,"word":"五虚六耗","pinyin":"wǔ xū liù hào","abbr":"wxlh","explanation":"比喻弄虚作假。","source":{"text":"你也晓得，皇上家的钱都是要功归实用的，那里能由你五虚六耗，赚了许多。","book":"《中国现在记》第九回"},"usage":"作谓语、宾语；比喻弄虚作假"},{"id":4655,"word":"五行代德","pinyin":"wǔ xíng dài dé","abbr":"wxdd","explanation":"五行：指金、木、水、火、土；代德：以新德代旧德。泛指改朝换代。"},{"id":4656,"word":"五行俱下","pinyin":"wǔ háng jù xià","abbr":"wxjx","explanation":"五行文字一并看。形容读书速度快。","source":{"text":"瑒祖奉，字世叔。才敏善讽诵，故世称‘应世叔读书，五行俱下。’","book":"《三国志·魏志·应瑒传》裴松之注引华峤《汉书》"},"example":{"text":"元·李治《敬斋古今注》第四卷：“应奉读书，～，宋孝武读书奏，能七行俱下，善言其敏也。”"},"similar":["五行并下","十行俱下"],"usage":"作谓语、定语；形容阅读的速度极快"},{"id":4657,"word":"五行八作","pinyin":"wǔ háng bā zuò","abbr":"whbz","explanation":"泛指各行各业。","source":{"text":"五行八作，就没你这一行。","book":"老舍《龙须沟》第一幕"},"example":{"text":"王朔《一点正经没有》：“我们这是国家的买卖，要涨得一起涨，～蔬菜副食小百货——单个涨不允许。”"},"similar":["各行各业"],"usage":"作宾语；泛指各行各业"},{"id":4658,"word":"五行四柱","pinyin":"wǔ xíng sì zhù","abbr":"wxsz","explanation":"五行：指金、木、水、火、土；四柱：指年、月、日、时。旧指命相家替人算命的根据。","source":{"text":"你把那先天《周易》细回圈，将我那五行四柱从头算。","book":"元·郑光祖《老君堂》第一折"},"example":{"text":"不用～，能知祸福兴衰。","book":"明·冯梦龙《警世通言》卷十三"}},{"id":4659,"word":"五行并下","pinyin":"wǔ háng bìng xià","abbr":"whbx","explanation":"五行文字一并看。形容读书速度快。","source":{"text":"奉少聪明，自为童儿及长，凡所经履，莫不暗记。读书五行并下。","book":"《后汉书·应奉传》"},"similar":["一目十行","五行俱下"],"usage":"作谓语、定语；形容阅读的速度极快"},{"id":4660,"word":"五角六张","pinyin":"wǔ jiǎo liù zhāng","abbr":"wjlz","explanation":"角、张：星宿名。形容七颠八倒。也比喻事情不顺利。","source":{"text":"梦里几回富贵，觉来依旧凄惶。今日是千年一遇，叩头莫五角六张。","book":"唐·郑棨《开天传信记》"},"example":{"text":"～，盖乖角、乖张之意，犹今言七颠八倒。","book":"清·沈涛《铜熨斗斋随笔·五角六张》"},"similar":["七颠八倒"],"usage":"作谓语、宾语；指遇事不顺利"},{"id":4661,"word":"五言长城","pinyin":"wǔ yán cháng chéng","abbr":"wycc","explanation":"称誉善于作五言诗的好手。","source":{"text":"长卿自以为五言长城，系用偏师攻之，虽老益壮。","book":"《新唐书·秦系传》"},"usage":"作宾语、定语；指善于作五言诗的好手"},{"id":4662,"word":"五讲四美","pinyin":"wǔ jiǎng sì měi","abbr":"wjsm","explanation":"五讲：讲文明、讲礼貌、讲卫生、讲秩序、讲道德；四美：指心灵美、语言美、行为美、环境美。指新时期人们行为准则。","source":{"text":"我满面通红地后躲，左右张望：‘别别，五讲四美。’","book":"王朔《一半是火焰，一半是海水》"},"example":{"text":"～要从小抓起，才能提高人们的修养。"},"usage":"作主语、宾语、定语；用于书面语"},{"id":4663,"word":"五谷不分","pinyin":"wǔ gǔ bù fēn","abbr":"wgbf","explanation":"五谷：通常指稻、黍、稷、麦、菽。指不参加劳动，不能辨别五谷。形容脱离生产劳动，缺乏生产知识。","source":{"text":"四体不勤，五谷不分，孰为夫子？","book":"《论语·微子》"},"example":{"text":"我们新时代的青年绝不能做～的书呆子。"},"similar":["不辨菽麦"],"usage":"作谓语、定语；指没有见识","story":["春秋时期，孔子带领弟子周游列国，经历卫、陈、蔡等国的碰壁后，从叶邑出来迷了路，子路前去问路，回来后发现不见了孔子，就问地里耕种的农夫，农夫说：“四体不勤，五谷不分，孰为夫子？”子路发现遇到德高的隐者，只好自己寻找"]},{"id":4664,"word":"五谷不升","pinyin":"wǔ gǔ bù shēng","abbr":"wgbs","explanation":"庄稼不生长。指灾荒之年。","source":{"text":"五谷不升，谓之大侵。","book":"《谷梁传·襄公二十四年》"},"similar":["五谷不生"],"usage":"作谓语、定语；用于书面语"},{"id":4665,"word":"五谷不熟，不如稊稗","pinyin":"wǔ gǔ bù shú，bǔ rú tí bài","abbr":"wgbsbrtb","explanation":"稊：象稗的草，结实如小米；稗：稗子。比喻条件素质再好，如果最后不能有所成就，那就还不如素质条件差的。","source":{"text":"当时文人墨士名公巨卿炫赫一时者，不知湮没多少，而诸匠之名，顾得不朽，所谓五谷不熟,不如稊稗者也。","book":"明·袁宏道《时尚》"}},{"id":4666,"word":"五谷丰熟","pinyin":"wǔ gǔ fēng shú","abbr":"wgfs","explanation":"指年成好，粮食丰收。同“五谷丰登”。","source":{"text":"是故风雨时节，五谷丰熟，社稷安宁。","book":"《六韬·龙韬·立将》"},"example":{"text":"盗贼灭息，～，家给人足。","book":"《东观汉记·吴良传》"},"similar":["五谷丰登"],"usage":"作定语；指丰收在望"},{"id":4667,"word":"五谷丰登","pinyin":"wǔ gǔ fēng dēng","abbr":"wgfd","explanation":"登：成熟。指年成好，粮食丰收。","source":{"text":"是故风雨时节，五谷丰登，社稷安宁。","book":"《六韬·龙韬·立将》"},"example":{"text":"自后国泰民安，风调雨顺，～，人物康阜，真是升平世界。","book":"清·陈忱《水浒后传》第四十回"},"similar":["年谷顺成"],"opposite":["颗粒无收"],"usage":"作谓语、分句；指年成好"},{"id":4668,"word":"五谷丰稔","pinyin":"wǔ gǔ fēng rěn","abbr":"wgfr","explanation":"五谷：指稻、黍、稷、麦、菽，泛指农作物；稔：指庄稼成熟。形容年成好。","source":{"text":"风雨以时，则五谷丰稔。","book":"唐·韦嗣立《论刑法多滥疏》"},"example":{"text":"田地膏腴，～，山上野兽甚多，花果诸般多有，约莫有五百里广阔。","book":"清·陈忱《水浒后传》第十一回"},"similar":["五谷丰登","五谷丰熟"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":4669,"word":"五车书","pinyin":"wǔ chē shū","abbr":"wcs","explanation":"形容书读的非常多。","source":{"text":"惠施多方，其书五车。","book":"《庄子·天下》"},"example":{"text":"富贵必从勤苦得，男儿须读五车书。","book":"唐·杜甫《题柏学士茅屋》"}},{"id":4670,"word":"五车腹笥","pinyin":"wǔ chē fù sì","abbr":"wcfs","explanation":"比喻读书多，学识渊博。","source":{"text":"惠施多方，其书五车。","book":"战国·宋·庄周《庄子·天下》"},"example":{"text":"明·冯梦龙《警世通言》第17卷：“说起他聪明，就如颜子渊闻一知十；论起他饱学，就如虞世南～。”"},"similar":["学富五车"],"opposite":["不识之无"],"usage":"作谓语、定语；用于书面语"},{"id":4671,"word":"五里云雾","pinyin":"wǔ lǐ yún wù","abbr":"wlyw","explanation":"令人迷惑的纠纷或混乱，迷离恍惚、不明真相的境界。","source":{"text":"那窗外的孙杰却被三姊弄得如在五里云雾中。","book":"清·无垢道人《八仙全传》第13回"},"example":{"text":"这让我如堕～之中。"},"similar":["五里雾中"],"usage":"作宾语；指不明真相的境界"},{"id":4672,"word":"五里雾","pinyin":"wǔ lǐ wù","abbr":"wlw","explanation":"比喻模糊恍惚、不明真相的境界。","source":{"text":"性好道术，能作五里雾。","book":"《后汉书·张楷传》"},"usage":"作宾语、定语；用于比喻句"},{"id":4673,"word":"五里雾中","pinyin":"wǔ lǐ wù zhōng","abbr":"wlwz","explanation":"比喻模糊恍惚、不明真相的境界。","source":{"text":"性好道术，能作五里雾。","book":"南朝·宋·范晔《后汉书·张楷传》"},"example":{"text":"对于政协各项协议不大明了的朋友，或许到现在都还在～吧。","book":"郭沫若《关于非正式五人小组》"},"similar":["五里云雾"],"usage":"作宾语；指不明真相的境界","story":["汉朝时期，成都人张楷会道术，能在晴天造出方圆五里的云雾。云雾迷漫，特别壮观。关西的裴优能造三里云雾。他变卖家产到成都去拜张楷学艺不成，就造雾行窃，被官府捉住。他立即诬陷是张楷教他的。官府则为了抢功把张楷投入监狱"]},{"id":4674,"word":"五陵年少","pinyin":"wǔ líng nián shào","abbr":"wlns","explanation":"指京都富豪子弟。","source":{"text":"曲罢曾教善才服，妆成每被秋娘妒。五陵年少争缠头，一曲红绡不知数。","book":"唐·白居易《瑟琶行》"},"example":{"text":"尹雪艳总也不老。十几年前那一班在上海百乐门舞厅前替她捧场的～，有些天平开了顶，有些两鬓添了霜……","book":"白先勇《永远的尹雪艳》"},"similar":["五陵英少"],"usage":"作宾语、定语；比喻少年豪侠"},{"id":4675,"word":"五陵英少","pinyin":"wǔ líng yīng shǎo","abbr":"wlys","explanation":"指京都富豪子弟。同“五陵年少”。","source":{"text":"结客五陵英少，脱手黄金一笑，霹雳应弓弦。","book":"清·龚自珍《水调歌头·寄徐二义尊大梁》词"},"similar":["五陵年少"],"usage":"作宾语、定语；比喻少年豪侠"},{"id":4676,"word":"五陵豪气","pinyin":"wǔ líng háo qì","abbr":"wlhq","explanation":"指高门贵族的豪迈气概。","source":{"text":"你直叩丹墀，夺得朝章，换却白衣 。觑面仪，比向日，相别之际，更有三千丈五陵豪气。","book":"元·关汉卿《蝴蝶梦》第三折：“俺秀才每比那题桥人无那五陵豪气，打的个遍身家鲜血淋漓。”元·郑光祖《倩女离魂》第三折"},"example":{"text":"论英雄古今无对 ,笑谈间，扫清吴越国，端的有三千丈～。","book":"明·罗贯中《风云会》第四折"},"usage":"作宾语、定语；用于书面语"},{"id":4677,"word":"五雀六燕","pinyin":"wǔ què liù yàn","abbr":"wqly","explanation":"比喻双方轻重相差不多。","source":{"text":"今有五雀六燕，集称之衡，雀俱重，燕俱轻，一雀一燕交而处，衡适平。","book":"《九章算术·方程》"},"example":{"text":"当持～之匀衡。","book":"梁启超《中国外交方针和议》"},"usage":"作宾语、定语；指双方轻重相差不多"},{"id":4678,"word":"五零二落","pinyin":"wǔ líng èr luò","abbr":"wlel","explanation":"犹言七零八落。形容零散稀疏的样子。特指原来又多又整齐的东西现在零散了。","source":{"text":"他和婆姨用复员费做本钱逢集摆小摊的货箱子，被捣得五零二落，东一块西一块扔在院里。","book":"柳青《铜墙铁壁》第13章"},"similar":["七零八落","五零四散"],"usage":"作定语、状语；用于口语"},{"id":4679,"word":"五零四散","pinyin":"wǔ líng sì sàn","abbr":"wlss","explanation":"形容零星涣散。","source":{"text":"众公子带领人马一拥齐上，把各兵杀的五零四散，各自逃生。","book":"清·李汝珍《镜花缘》第九十九回"},"example":{"text":"郭沫若《恢复·怀亡友》诗：“你的生命不消说会长留在天地之间，但我们的革命势力呀已经是～。”"},"similar":["零零散散","四分五裂"],"opposite":["完完整整"],"usage":"作谓语、定语；形容零星分散"},{"id":4680,"word":"五雷轰顶","pinyin":"wǔ léi hōng dǐng","abbr":"wlhd","explanation":"比喻不得好死。","source":{"text":"要是我从中赚一个钱，天上现在有云影，教我五雷轰顶。","book":"老舍《龙须沟》"},"similar":["天打雷劈"],"usage":"作谓语、定语；多用于发誓"},{"id":4681,"word":"五音六律","pinyin":"wǔ yīn liù lǜ","abbr":"wyll","explanation":"五音：指宫、商、角、徵、羽五个音阶；六律：定乐器的标准。指古代音律。后也泛指音乐。","source":{"text":"不以六律，不能正五音。","book":"《尚书·益稷》：“予欲闻六律，五声，八音，在治忽；以出纳五言，汝听。”《孟子·离娄上》"},"example":{"text":"清·无名氏《说呼全传》第二回：“那些～、南北九宫，箫管丝弦，无一不精。”"},"usage":"作主语、宾语、定语；指音乐"},{"id":4682,"word":"五颜六色","pinyin":"wǔ yán liù sè","abbr":"wyls","explanation":"形容色彩复杂或花样繁多。引伸为各色各样。","source":{"text":"惟各人所登之云，五颜六色，其形不一。","book":"清·李汝珍《镜花缘》第十四回"},"example":{"text":"这在四川的拉夫史上是一桩奇迹，于是那些乡下人，哦了一声，立刻发出～的推测来了。","book":"沙汀《凶手》"},"similar":["五彩缤纷","万紫千红"],"opposite":["色彩单一"],"usage":"作谓语、定语；形容品种繁多"},{"id":4683,"word":"五风十雨","pinyin":"wǔ fēng shí yǔ","abbr":"wfsy","explanation":"五天刮一次风，十天下一场雨。形容风调雨顺。","source":{"text":"风不鸣条，雨不破块，五日一风，十日一雨。","book":"汉·王充《论衡·是应》"},"example":{"text":"～天时好，又见西郊稻秫肥。","book":"宋·王炎《双溪诗钞·丰年谣（一）》"},"similar":["风调雨顺"],"usage":"作补语、定语；指风调雨顺"},{"id":4684,"word":"五马六猴","pinyin":"wǔ mǎ liù hóu","abbr":"wmlh","explanation":"形容不守规矩、不受管束的人。","source":{"text":"我们要对这些～严加管理。"},"example":{"text":"我们要对这些～严加管理"},"usage":"作宾语、定语；指不受管束的人"},{"id":4685,"word":"五马分尸","pinyin":"wǔ mǎ fēn shī","abbr":"wmfs","explanation":"古代的一种酷刑，用五匹马分裂人的头和四肢，又称“四裂”。比喻硬把完整的东西分割得非常零碎。","source":{"text":"无不盖你亏心汉，今日把你分尸五马，远配千年。","book":"明·胡文焕《群音类选·北腔类·王昭君和番》"},"example":{"text":"我张飞虎又不能～！也没有三头六臂！那些事我指派给组长了，你们不会问人家。（康濯《工人张飞虎》）"},"similar":["千刀万剐"],"usage":"作宾语；指处以极刑"},{"id":4686,"word":"五鬼闹判","pinyin":"wǔ guǐ nào pàn","abbr":"wgnp","explanation":"许多小鬼戏弄判官。剧目名。旧时也比喻居上位者被对自己不满或轻蔑的人所戏弄。","source":{"text":"惟其中有五鬼闹判一语，不知所出；以问余，亦无以应也。","book":"鲁迅《小说旧闻钞·三保太监西洋记》"},"usage":"作宾语、定语；用于书面语"},{"id":4687,"word":"五黄六月","pinyin":"wǔ huáng liù yuè","abbr":"whly","explanation":"指阴历五、六月间天气最炎热的时候。","source":{"text":"只为五黄六月，无人使唤，父母又年老，所以亲身来送。","book":"明·吴承恩《西游记》第十二七回"},"example":{"text":"我若南京再娶家小，～害病死了我。（明·冯梦龙《警世通言》卷十二四）"},"opposite":["寒冬腊月"],"usage":"作主语、定语；指天气最炎热的时候"},{"id":4688,"word":"五鼎万钟","pinyin":"wǔ dǐng wàn zhōng","abbr":"wdwz","explanation":"指高官厚禄。","source":{"text":"如羊之跪乳，鸟之反哺，其乐将矢谁，视五鼎万钟若不能过之。","book":"明·宋濂《永思堂记》"},"similar":["高官厚禄"],"usage":"作宾语、定语；用于书面语"},{"id":4689,"word":"井中求火","pinyin":"jǐng zhōng qiú huǒ","abbr":"jzqh","explanation":"在水井里去寻求火。比喻方法或方向不对，根本达不到目的。","source":{"text":"夫攻形不如越，而攻心不如吴，而君臣上下少长贵贱毕呼霸王，臣窃以为犹之井中，而谓曰：‘我将为尔求火也。’","book":"《战国策·韩策三》"},"example":{"text":"你这样做就像～一样"},"similar":["缘木求鱼"],"usage":"作宾语、定语；用于处事"},{"id":4690,"word":"井中视星","pinyin":"jǐng zhōng shì xīng","abbr":"jzsx","explanation":"从井里看天上的星星。比喻眼光短浅，见识狭隘。","source":{"text":"因井中视星，所见不过数星。","book":"《尸子·广释》"},"example":{"text":"因～，所视不过数星，自丘上以视，则见其始出，又见其入，非明益也，势使然也。","book":"清·陈澧《东塾读书记·诸子书》"},"similar":["坐井观天"],"usage":"作主语、宾语、定语；指人眼光短浅"},{"id":4691,"word":"井井有序","pinyin":"jǐng jǐng yǒu xù","abbr":"jjyx","explanation":"有条理，有秩序。","source":{"text":"一切都是井井有序，和往常一样。","book":"骆宾基《乡亲——康天刚》"},"example":{"text":"人民相处～，没有互相妒忌之事。"},"similar":["井井有绪","井然有序"],"opposite":["杂乱无章"],"usage":"作状语、补语；指有条理"},{"id":4692,"word":"井井有方","pinyin":"jǐng jǐng yǒu fāng","abbr":"jjyf","explanation":"形容有条理有办法。","source":{"text":"孝基条分理析，井井有方。","book":"明·冯梦龙《醒世恒言》第十七卷"},"similar":["井井有法","井井有理"],"usage":"作谓语、定语、状语；指条理分明"},{"id":4693,"word":"井井有条","pinyin":"jǐng jǐng yǒu tiáo","abbr":"jjyt","explanation":"井井：形容有条理。形容说话办事有条有理。","source":{"text":"井井兮其有理也。","book":"《荀子·儒效》"},"example":{"text":"鲁小姐上侍孀姑，下理家政，～，亲戚无不称羡。","book":"清·吴敬梓《儒林外史》第十三回"},"similar":["井井有序","秩序井然"],"opposite":["一团乱麻","杂乱无章"],"usage":"作谓语、补语、定语、状语；指条理分明"},{"id":4694,"word":"井井有法","pinyin":"jǐng jǐng yǒu fǎ","abbr":"jjyf","explanation":"有条理、有法度。","source":{"text":"女外理生计，内训孤儿，井井有法。","book":"清·蒲松龄《聊斋志异·白于玉》"},"example":{"text":"料理家事，～。","book":"清·宋永岳《志异续编·某邑令》"},"similar":["井井有条","井井有方"],"usage":"作谓语、定语、状语；指条理分明"},{"id":4695,"word":"井井有理","pinyin":"jǐng jǐng yǒu lǐ","abbr":"jjyl","explanation":"形容整齐，有条有理。","source":{"text":"井井兮其有理也。","book":"语出《荀子·儒效》"},"example":{"text":"语出《荀子·儒效》：“井井兮其有理也。”"},"similar":["井井有条"],"usage":"作谓语、定语、状语；指条理分明"},{"id":4696,"word":"井井有绪","pinyin":"jǐng jǐng yǒu xù","abbr":"jjyx","explanation":"有条理，有秩序。同“井井有序”。","source":{"text":"［王以信］起早贪黑地奔波，饲养上、副业上、保管上，样样项项料理得井井有绪。","book":"柳青《狠透铁》三"},"similar":["井井有序","井井有条"],"usage":"作状语、补语；指有条理"},{"id":4697,"word":"井以甘竭","pinyin":"jǐng yǐ gān jié","abbr":"jygj","explanation":"以：因为；甘：甜；竭：枯竭。甜水井由于取用的人多，会先枯干。比喻好的事物不能长久存在。","source":{"text":"直木先伐，甘井先竭。","book":"《庄子·山木》"},"example":{"text":"吾闻～，李以苦存。","book":"明·刘基《苦斋记》"}},{"id":4698,"word":"井养不穷","pinyin":"jǐng yǎng bù qióng","abbr":"jybq","explanation":"穷：尽。把水井治理保护好，则水源不尽。比喻不断得到别人的恩惠。","source":{"text":"井养而不穷也。","book":"《周易·井》"},"example":{"text":"～功用在，谁将易象细推评。","book":"宋·洪舜俞《魏城晚凉倚窗观稼》"}},{"id":4699,"word":"井冽寒泉食","pinyin":"jǐng liè hán quán shí","abbr":"jlhqs","explanation":"冽：清澈；寒：清冷。只有在井很洁净、泉水清冷明澈的情况下才喝水。即只喝干净凉爽的水。比喻刚正的君主任用德才兼备的人。","source":{"text":"以言刚正之主不纳非贤，必须行洁才高而乃后用。故曰井冽寒泉食也。","book":"《周易·井》：“九五：井冽寒泉食。”孔颖达疏"}},{"id":4700,"word":"井底之蛙","pinyin":"jǐng dǐ zhī wā","abbr":"jdzw","explanation":"井底的蛙只能看到井口那么大的一块天。比喻见识狭窄的人。","source":{"text":"井蛙不可以语于海者，拘于虚也。","book":"《庄子·秋水》"},"example":{"text":"～，所见不大；萤火之光，其亮不远。","book":"明·许仲琳《封神演义》第二十五回"},"similar":["一孔之见","坐井观天"],"opposite":["见多识广"],"usage":"作主语、宾语、定语；指见识少","story":["很久以前，一只生活在废井里从没有跳出井来的青蛙，有吃有喝，觉得很满足。一天他好奇问路过的海龟天有多大。海龟告诉他天是如何如何广阔，青蛙不能理解海龟所描述的，总认为天只不过井口那么大"]},{"id":4701,"word":"井底捞月","pinyin":"jǐng dǐ lāo yuè","abbr":"jdly","explanation":"捞：从液体中取物。从井底捞月亮。比喻做事白费力气，根本达不到目的。","source":{"text":"镜里看形见不难，水中捉月争拈得？","book":"唐·释元觉《永嘉证道歌》"},"example":{"text":"我若今日见你呵，将你活跺做两截，你要活时恰似井底捞明月。","book":"元·无名氏《马陵道》第三折"}},{"id":4702,"word":"井底虾蟆","pinyin":"jǐng dǐ xiā má","abbr":"jdxm","explanation":"即井蛙。"},{"id":4703,"word":"井底蛤蟆","pinyin":"jǐng dǐ há má","abbr":"jdhm","explanation":"指井底的癞蛤蟆，比喻没有见识的人。","source":{"text":"妾阅人多矣，皆是井底蛤蟆，未有中原麟凤。","book":"明·陈汝元《金莲记·弹丝》"},"example":{"text":"你这种人，真正的～，啥时候见过碟大的天的！","book":"陈登科《风雷》第一部下册第46章"},"similar":["井底之蛙"],"usage":"作宾语、定语；指人的见识少","story":["很久以前，一只生活在废井里从没有跳出井来的青蛙，有吃有喝，觉得很满足。一天他好奇问路过的海龟天有多大。海龟告诉他天是如何如何广阔，青蛙不能理解海龟所描述的，总认为天只不过井口那么大"]},{"id":4704,"word":"井底银瓶","pinyin":"jǐng dǐ yín píng","abbr":"jdyp","explanation":"比喻前功尽弃。","source":{"text":"井底引银瓶，银瓶欲上丝绳断；石上磨玉簪，玉簪欲成中央折。","book":"唐·白居易《井底引银瓶乐府》"},"example":{"text":"弄得千年来国威坠落，变做～。","book":"清·梁启超《新罗马》第三出"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":4705,"word":"井底鸣蛙","pinyin":"jǐng dǐ míng wā","abbr":"jdmw","explanation":"指井中之蛙。","source":{"text":"则你那自尊自贵无高下，真乃是井底鸣蛙。","book":"元·无名氏《看钱奴》第一折"},"example":{"text":"一任教纵横奋发，都是些～。","book":"明·罗贯中《风云会》第一折"},"similar":["井底之蛙"],"usage":"作主语、宾语、定语；指见识少"},{"id":4706,"word":"井水不犯河水","pinyin":"jǐng shuǐ bù fàn hé shuǐ","abbr":"jsbfhs","explanation":"比喻各管各的，互不相犯。","source":{"text":"我和他‘井水不犯河水’，怎么就冲了他？","book":"清·曹雪芹《红楼梦》第六十九回"},"example":{"text":"～，怎的开发他的先生？况且素无仇冤，你该怎的？","book":"清·李绿园《歧路灯》第五十六回"},"similar":["是非分明"],"opposite":["相得益彰"],"usage":"作谓语、宾语、定语；指界限分明"},{"id":4707,"word":"井渫不食","pinyin":"jǐng xiè bù shí","abbr":"jxbs","explanation":"指井虽浚治，洁净清澈，但不被饮用。比喻洁身自持，而不为人所知。","source":{"text":"井渫而不见食，犹人修已全洁而不见用。","book":"语出《易·井》：“井渫不食，为我心恻。”王弼注：“渫，不停污之谓也。”孔颖达疏"},"example":{"text":"何不警其越俎代庖之罪，而乃疑其心测～乎？","book":"宋·陈亮《与吕伯恭正字书》之三"},"similar":["井渫莫食"],"usage":"作定语；用于比喻句"},{"id":4708,"word":"井渫莫食","pinyin":"jǐng xiè mò shí","abbr":"jxms","explanation":"比喻洁身自持，而不为人所知。同“井渫不食”。","source":{"text":"惧匏瓜之徒悬兮，畏井渫之莫食。","book":"汉·王粲《登楼赋》"},"usage":"作定语；用于比喻句"},{"id":4709,"word":"井然有序","pinyin":"jǐng rán yǒu xù","abbr":"jryx","explanation":"井然：整齐不乱的样子。序：次序。整整齐齐，次序分明，条理清楚。","source":{"text":"以制产、重农、救荒分三事……井然有序。","book":"清·王夫之《夕堂永日绪论外编》"},"example":{"text":"我们的校容要～，秩然有序。","book":"陶行知《育才两周岁之前夜》"},"similar":["有条有理","条理清楚"],"opposite":["杂乱无章","颠三倒四"],"usage":"作定语、状语；指整齐"},{"id":4710,"word":"井然有条","pinyin":"jǐng rán yǒu tiáo","abbr":"jryt","explanation":"犹言井井有条。形容说话办事有条有理。","source":{"text":"凡本年之事有所闻必归此匣，分月日先后次第之，井然有条，真可为法也。","book":"宋·周密《癸辛杂识后集·修史法》"},"example":{"text":"我们的校容要～，秩然有序。","book":"陶行知《育才两周岁之前夜》"},"similar":["井然有序"],"usage":"作定语、状语；指整齐"},{"id":4711,"word":"井管拘墟","pinyin":"jǐng guǎn jū xū","abbr":"jgjx","explanation":"比喻浅陋、片面的见识。","source":{"text":"钜儒著述，皆有本原，不得以井管拘墟，轻相訾议也。","book":"清·李慈铭《越缦堂读书记·尚书集注音疏》"},"usage":"作宾语、定语；用于比喻句"},{"id":4712,"word":"井臼亲操","pinyin":"jǐng jiù qīn cāo","abbr":"jjqc","explanation":"井：汲水；臼：舂米。指亲自操作家务。","source":{"text":"（傅育）食禄数十年，秩奉尽赡给知友，妻子不免操井臼。","book":"《后汉书·冯衍传下》：“儿女常自操井臼。”《后汉书·滇良传》"},"similar":["井臼躬操"],"usage":"作谓语、宾语；指亲自操持家务"},{"id":4713,"word":"井臼躬操","pinyin":"jǐng jiù gōng cāo","abbr":"jjgc","explanation":"井：汲水；臼：舂米；躬：亲自；操：从事。指亲自操持家务。","source":{"text":"家贫亲老，不择官而仕，亲操井臼。","book":"西汉·刘向《列女传·周南妻传》"},"example":{"text":"妇～，绝无骄傲习。","book":"清·百一居士《壶天录》上卷"},"similar":["躬操井臼"],"usage":"作谓语、宾语；指亲自操持家务"},{"id":4714,"word":"井蛙之见","pinyin":"jǐng wā zhī jiàn","abbr":"jwzj","explanation":"见：见解。井底之蛙那样狭隘的见解。比喻狭隘短浅的见解。","source":{"text":"井蛙不可以语于海者，拘于虚也。","book":"《庄子·秋水》"},"example":{"text":"婢子见闻既寡，何敢以～，妄发议论。","book":"清·李汝珍《镜花缘》第十八回"},"similar":["蓬间之雀","井底之蛙"],"opposite":["卓有远见","高瞻远瞩"],"usage":"作宾语；指没有见识"},{"id":4715,"word":"井蛙醯鸡","pinyin":"jǐng wā xī jī","abbr":"jwxj","explanation":"醯鸡：昆虫名，即蠛蠓，常用以形容细小的东西。比喻眼界不广，见识浅薄。","source":{"text":"今既闻命，实饱于玄风，醉其真义也。吾向来井蛙醯鸡哉。","book":"《云笈七签》卷七十"},"example":{"text":"信神与之而不能测神之所以付，信述通之而不能知术之所以泄哉！余闻乎曾～之不若也。","book":"宋·刘禹锡《送惟良上人诗序》"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":4716,"word":"亘古不灭","pinyin":"gèn gǔ bù miè","abbr":"ggbm","explanation":"亘：横贯；亘古：从古至今；灭：绝灭。从古到今，永不绝灭。形容永久的生命力。","example":{"text":"这条～的真理你难道没听说吗？"},"usage":"作谓语、定语；用于事物等"},{"id":4717,"word":"亘古亘今","pinyin":"gèn gǔ gèn jīn","abbr":"gggj","explanation":"亘：横贯。指贯串古今，从古到今。","source":{"text":"条贯脉络，井井不乱，只今便在目前，而亘古亘今，颠扑不破。","book":"宋·朱熹《答陆子美书》"},"example":{"text":"若解向里寻求，见得自己心体，即无时不是此道，～，无终无始。","book":"明·王守仁《传习录》上卷"},"similar":["古往今来"],"usage":"作分句、状语；指从古到今"},{"id":4718,"word":"亘古奇闻","pinyin":"gèn gǔ qī wén","abbr":"ggqw","explanation":"亘古：从古代到现代；奇：稀有不常见的。从古到今很少听到或见到的事情。","source":{"text":"从来稀有，亘古奇闻。","book":"明·凌濛初《初刻拍案惊奇》卷一"},"example":{"text":"清·吴璿《飞龙全传》第一回：“把泥马都骑了出来，真个从来未见，～。”"},"similar":["千古奇闻"],"usage":"作主语、宾语、定语；指惊人的事物"},{"id":4719,"word":"亘古新闻","pinyin":"gèn gǔ xīn wén","abbr":"ggxw","explanation":"亘古：从古代到现代。从古到今很少的事情。","source":{"text":"从来稀有，亘古新闻。","book":"明·凌濛初《初刻拍案惊奇》第一卷"},"example":{"text":"这真是～。"},"similar":["亘古奇闻"],"usage":"作宾语；指从古到今很少的事情"},{"id":4720,"word":"亘古未有","pinyin":"gèn gǔ wèi yǒu","abbr":"ggwy","explanation":"亘古：人人有责从古代到现在。从古到今都不曾有过。","source":{"text":"太青晚作《嘉莲》诗，七言今体至四百余首，亘古未有。","book":"《北齐书·王纮传》：“冒死效命之士反见屠戮，旷古未有此事。”清·平步青《霞外捃屑》卷四"},"example":{"text":"雄伟的南京长江大桥，在我国建桥史上是～的。"},"similar":["前所未有"],"usage":"作定语、补语；指从古到今都不曾有过"},{"id":4721,"word":"亘古未闻","pinyin":"gèn gǔ wèi wén","abbr":"ggww","explanation":"指从古到今都没有听说的","source":{"text":"真个是亘古未闻，于今罕有！","book":"明·冯梦龙《警世通言》第19卷"},"similar":["亘古未有","闻所未闻"],"usage":"作谓语、定语；用于事情等"},{"id":4722,"word":"亘古通今","pinyin":"gèn gǔ tōng jīn","abbr":"ggtj","explanation":"亘：横贯；通：贯通。指从古到今。","source":{"text":"亘古通今，明鲜晦多。","book":"南朝·宋·鲍照《河清颂》"},"similar":["自古至今"],"usage":"作定语、分句；指从古到今"},{"id":4723,"word":"亚肩叠背","pinyin":"yà jiān dié bèi","abbr":"yjdb","explanation":"前后的人肩背紧挨着。形容人多拥挤。","source":{"text":"只见一簇人亚肩叠背的围着一个汉子。","book":"《水浒传》第二三回：“武松在轿上看时，只见亚肩叠背，闹闹穰穰，屯街塞巷，都来看迎大虫。”又第一○二回"},"similar":["压肩叠背"],"usage":"作谓语、定语；用于人群拥挤的场面"},{"id":4724,"word":"亚肩迭背","pinyin":"yà jiān dié bèi","abbr":"yjdb","explanation":"肩压肩，背挨背。形容人多拥挤。","source":{"text":"武松在轿上看时，只见亚肩迭背，闹闹穰穰，屯街塞巷，都来看大虫。","book":"明·施耐庵《水浒传》第23回"},"example":{"text":"街上的人～地挤在一起。"},"similar":["挨肩叠背"],"usage":"作谓语、定语、状语；形容人多拥挤"},{"id":4725,"word":"亟疾苛察","pinyin":"jí jí kē chá","abbr":"jjkc","explanation":"指急剧猛烈，以苛刻烦琐为明察。","source":{"text":"且秦以任刀笔之吏，吏争以亟疾苛察相高。","book":"西汉·司马迁《史记·张释之冯唐列传》"},"example":{"text":"议过则～，莫之能免。","book":"清·戴震《孟子字义疏证·原善下》"},"usage":"作谓语；用于人"},{"id":4726,"word":"亡不待夕","pinyin":"wáng bù dài xī","abbr":"wbdx","explanation":"亡：灭亡，死亡。待：等待。夕：傍晚。灭亡等不到傍晚。比喻很快就会灭亡。","source":{"text":"若乃居安而不思危，寇至而不知惧，此谓燕巢于幕，鱼游于鼎，亡不待夕矣。","book":"明·章婴《诸葛孔明异传》"}},{"id":4727,"word":"亡不旋跬","pinyin":"wáng bù xuán kuǐ","abbr":"wbxk","explanation":"犹亡不旋踵。形容时间极短。","source":{"text":"汉分王子弟，享国四百年。魏晋废之，亡不旋跬。","book":"《新唐书·萧瑀传》"},"similar":["亡不旋踵"],"usage":"作谓语、定语；用于书面语"},{"id":4728,"word":"亡不旋踵","pinyin":"wáng bù xuán zhǒng","abbr":"wbxz","explanation":"指迅速灭亡。不旋踵，来不及转脚跟。形容时间极短。","source":{"text":"晋武帝削平吴蜀，任贤使能，容受直言，有明主之风，然而亡不旋踵。","book":"宋·苏辙《序》"},"similar":["亡不旋跬"],"usage":"作谓语、定语；用于书面语"},{"id":4729,"word":"亡人自存","pinyin":"wáng mén zì cún","abbr":"wrzc","explanation":"亡：死亡；存：留存。牺牲别人保全自己。泛指毁掉别人成全自己的卑鄙自私的行为。","source":{"text":"杀人自生，亡人自存，经之所疾。","book":"《三国志·蜀志·秦密传》"}},{"id":4730,"word":"亡可奈何","pinyin":"wáng kě nài hé","abbr":"wknh","explanation":"无可奈何。指只能如此，没有别的办法。"},{"id":4731,"word":"亡命之徒","pinyin":"wáng mìng zhī tú","abbr":"wmzt","explanation":"指逃亡的人。也指冒险犯法，不顾性命的人。","source":{"text":"亡命之徒，咸从赋役。","book":"《周书·郭彦传》"},"example":{"text":"原来这个凶手是匪军一旅马希山的部下—杨三楞。身强力大，一手好枪法，能喝酒，是个不怕死的～。","book":"曲波《林海雪原》二八"},"similar":["不逞之徒"],"opposite":["谦谦君子"],"usage":"作主语、宾语；指不顾性命的人","story":["唐朝末年，乐彦桢的儿子乐从训经常与狐朋狗友聚众滋事，他买通都统王铎的歌女，率领一帮亡命之徒杀了王铎的全家，夺取他的金银财宝。乐彦桢任相州刺史时，他更加肆无忌惮地滥杀无辜。不久乐彦桢被儿子气死。罗弘信率军消灭了乐从训这批亡命之徒"]},{"id":4732,"word":"亡国三户","pinyin":"wáng guó sān hù","abbr":"wgsh","explanation":"指不畏强暴，奋起推翻黑暗统治。","source":{"text":"夫秦灭六国，楚最无罪。自怀王入秦 不反，楚人怜之至今，故楚南公曰‘楚虽三户，亡秦必楚’也。","book":"《史记·项羽本纪》"}},{"id":4733,"word":"亡国之主","pinyin":"wáng guó zhī zhǔ","abbr":"wgzz","explanation":"主：君主。亡国时的君主，即最后一代君王。","source":{"text":"亡国之主反此，乃自贤而少人。","book":"《吕氏春秋·谨听》"},"example":{"text":"至于“毅宗”，则是崇祯帝的庙号，～，更不可用。","book":"高阳《慈禧全传》四十"}},{"id":4734,"word":"亡国之事","pinyin":"wáng guó zhī shì","abbr":"wgzs","explanation":"事：事情，事件。使国家灭亡的事件。","source":{"text":"将子有亡国之事、斧铖之诛而为此乎？","book":"《庄子·至乐》"},"example":{"text":"朕非亡国之君，而遇～，死不瞑目！","book":"姚雪垠《李自成》第四卷第七章"}},{"id":4735,"word":"亡国之余","pinyin":"wáng guó zhī yú","abbr":"wgzy","explanation":"余：余留。已灭亡国家留下来的后代。","source":{"text":"寡人虽亡国之余，不鼓不成列。","book":"《左传·僖公二十二年》"},"example":{"text":"明公以～，处群雄角力之秋，继两世拭逆之后，即效法周公，卑躬下士，犹恐士之不至。","book":"明·冯梦龙《东周列国志》第十八回"}},{"id":4736,"word":"亡国之器","pinyin":"wáng guó zhī qì","abbr":"wgzq","explanation":"指象箸、玉杯之类的器皿，古代作为骄奢亡国的象征。","source":{"text":"亡国之音不得至于庙，亡国之社不得见于天，亡国之器陈于廷，所以为戒。","book":"《吕氏春秋·贵直》"},"example":{"text":"魏法～，而于义竟无取焉。","book":"《晋书·五行志上》"},"usage":"作宾语；用于书面语"},{"id":4737,"word":"亡国之声","pinyin":"wáng guó zhī shēng","abbr":"wgzs","explanation":"指淫靡的音乐。","source":{"text":"此亡国之声，不可遂也。","book":"《韩非子·十过》"},"example":{"text":"今也匹夫之徒，曾无意于先王之制，而习～，岂能保其六七尺之体哉。","book":"《孔子家语·辨乐解》"},"similar":["亡国之音","靡靡之音"],"usage":"作主语、宾语；用于书面语","story":["春秋末年，晋平公在城外建造一座豪华的宫殿。卫灵公带涓乐师前去祝贺，席间涓乐师把在濮水边听来的乐曲弹了一遍。晋国的旷乐师马上制止说是商末延乐师为纣王所作的亡国之声，听了会沉湎声色中。3年后，晋平公因贪色而亡"]},{"id":4738,"word":"亡国之社","pinyin":"wáng guó zhī shè","abbr":"wgzs","explanation":"已亡国家的祠社。古代天子将其作为亡国的象征，以自儆戒。","source":{"text":"亡国之社，以为庙屏，戒也。","book":"《谷梁传·哀公四年》"},"example":{"text":"汉·蔡邕《独断》：“～：古者天子亦取～以分诸侯，使为社以自儆戒。”"},"usage":"作宾语；用于书面语"},{"id":4739,"word":"亡国之臣","pinyin":"wáng guó zhī chén","abbr":"wgzc","explanation":"使国家灭亡的臣子。现比喻对国家有损害的官员。","source":{"text":"夫骄君必好利，而亡国之臣必贪于财。","book":"《史记·苏秦列传》"},"example":{"text":"照你说来，我吴某只能做～？","book":"姚雪垠《李自成》第五卷第三章"}},{"id":4740,"word":"亡国之语","pinyin":"wáng guó zhī yǔ","abbr":"wgzy","explanation":"语：话语、言论。使国家灭亡的言论。","source":{"text":"故圣人为政，必先诛之，伪巧言以辅非而倾覆国家也。今子安取亡国之语而来乎？","book":"汉·桓宽《盐铁论·论诽》"},"example":{"text":"上宽赦大王，王复安得此～乎！","book":"《史记·淮南衡山列传》"}},{"id":4741,"word":"亡国之道","pinyin":"wáng guó zhī dào","abbr":"wgzd","explanation":"道：道路，途径。国家灭亡的途径。比喻执政者违背民意，不得人心。","source":{"text":"国内之民将叛，四方之士不至，此乃亡国之道也。","book":"秦·孔鲋《孔丛子·对魏》"},"example":{"text":"势屈而兵胜，～也。","book":"《金史·夹谷清臣等传赞》"}},{"id":4742,"word":"亡国之音","pinyin":"wáng guó zhī yīn","abbr":"wgzy","explanation":"原指国家将亡，人民困苦，因此音乐也多表现为哀思的曲调，后多指颓靡淫荡的歌曲。","source":{"text":"亡国之音哀以思，其民困。","book":"《礼记·乐记》：“亡国之音哀以思，其民困。”又：“桑间濮上之音，亡国之音也，其政散，其民流。”《史记·乐书》"},"example":{"text":"卿勿为～，使人悒悒。","book":"清·蒲松龄《聊斋志异·林四娘》"},"similar":["靡靡之音"],"usage":"作宾语；指颓靡淫荡的歌曲"},{"id":4743,"word":"亡国大夫","pinyin":"wáng guó dà fū","abbr":"wgdf","explanation":"指不忠不智的前朝遗臣。","source":{"text":"亡国之大夫者，谓亡君之国，言不忠且无智也。","book":"《礼记·射义》：“贲军之将、亡国之大夫与为人后者不入，其余皆入。”孔颖达疏"},"example":{"text":"邹韬奋《从心坎里》：“这种精神和‘～’的奴性正是立于相反的两极端。”"},"usage":"作主语、宾语、定语；用于书面语"},{"id":4744,"word":"亡国奴","pinyin":"wáng guó nú","abbr":"wgn","explanation":"指已经亡国或所在国土被侵占、受外国侵略者奴役的人。","source":{"text":"现在他们眼看就要当亡国奴了，除了反抗，再没有出路。","book":"毛泽东《论反对日本帝国主义的策略》"},"example":{"text":"我不想当～。"},"usage":"作主语、宾语、定语；用于丧国的人"},{"id":4745,"word":"亡国富库","pinyin":"wáng guó fù kù","abbr":"wgfk","explanation":"亡：灭亡；国：国家；富：富足；库：国库。国家灭亡，国库富足。指为求国库富足，对百姓残酷压榨，横征暴敛，从而使国家灭亡。","source":{"text":"臣闻王主富民，霸主富武，亡国富库。","book":"《淮南子·人间训》"}},{"id":4746,"word":"亡国必楚","pinyin":"wáng guó bì chǔ","abbr":"wgbc","explanation":"灭亡秦国的一定是楚国。指不畏强暴，奋起推翻黑暗统治。","source":{"text":"夫秦灭六国，楚最无罪。自怀王入秦 不反，楚人怜之至今，故楚南公曰‘楚虽三户，亡秦必楚’也。","book":"《史记·项羽本纪》"},"example":{"text":"仆闻楚隐士南公，深通术数，尝谓楚虽三户，～。","book":"蔡东藩《前汉演义》第十五回"}},{"id":4747,"word":"亡国怨祝","pinyin":"wáng guó yuàn zhù","abbr":"wgyz","explanation":"怨：埋怨；祝：太祝，旧时为执掌祭礼祝祷的官。旧指国家衰亡时，不从自身找原因，而去埋怨为国家祭祀祝祷的人。","source":{"text":"一人祝之，一国诅之，一祝不胜万诅，国亡不亦宜乎？祝其何罪？","book":"汉·王充《论衡·解除》"}},{"id":4748,"word":"亡国灭种","pinyin":"wáng guó miè zhǒng","abbr":"wgmz","explanation":"国家灭亡，种族灭绝。指一个国家被彻底毁灭。","source":{"text":"在如此的亡国灭种的紧急关头，国民党如果还因循上述的政策不愿迅速改变，将使抗日战争蒙受绝大的不利。","book":"毛泽东《为动员一切力量争取抗战胜利而斗争》"},"example":{"text":"毛泽东《为动员一切力量争取抗战胜利而斗争》：“在如此的～的紧急关头，国民党如果还因循上述的政策不愿迅速改变……。”"},"usage":"作谓语、定语、宾语；用于政治"},{"id":4749,"word":"亡国破家","pinyin":"wáng guó pò jiā","abbr":"wgpj","explanation":"国家覆灭、家庭毁灭。","source":{"text":"屈原行吟泽畔，曰：‘安得皋陶而察之！’夫人君莫不欲求贤以自辅，任能以治国，然牵于流说，惑于道谀，是以贤圣蔽掩，而谗佞用事，以此亡国破家，而贤士饥于岩穴也。","book":"汉·桓宽《盐铁论·相刺》"},"example":{"text":"～皆有恨，捧心无语泪苏台。","book":"唐·湘妃庙《与崔渥冥会杂诗》"},"similar":["亡国败家","国破家亡"],"usage":"作谓语、定语；用于书面语"},{"id":4750,"word":"亡国败家","pinyin":"wáng guó bài jiā","abbr":"wgbj","explanation":"国家灭亡了，家庭破坏了。比喻给国家及个人造成极严重的后果。","source":{"text":"安其危而利其葘，乐其所以亡者。不仁而可与言，则何亡国败家之有？","book":"《孟子·离娄上》"},"example":{"text":"若后庭内宠过多，三后并立，必致～，愿陛下思患预防，毋自取咎！","book":"蔡东藩《两晋演义》第二十八回"},"similar":["国破家亡","亡国破家"],"usage":"作谓语、定语；用于书面语"},{"id":4751,"word":"亡在旦夕","pinyin":"wáng zài dàn xī","abbr":"wzdx","explanation":"旦：早晨；夕：晚上。灭亡只是早晚的事情。","source":{"text":"大军已驻乎心腹，鼎鱼幕燕，亡在旦夕。","book":"《元史·外夷传一·高丽》"},"example":{"text":"再这样下去就会～。"},"similar":["危在旦夕"],"usage":"作谓语、定语；指灭亡只是早晚的事情","story":["明朝末年，李自成起义军包围了北京城，崇祯皇帝坚守京城。李自成派军师宋献策混入北京城摆摊测字，崇祯十分迷信，就到宋献策的测字摊算命，宋献策故意说他亡在旦夕。崇祯见大势已去，第二天就到景山上吊自杀"]},{"id":4752,"word":"亡戟得矛","pinyin":"wáng jǐ dé máo","abbr":"wjdm","explanation":"比喻得到的和失去的相当，或有失有得。","source":{"text":"亡戟得矛，可以归乎？","book":"《吕氏春秋·离俗》"},"similar":["有得有失"],"usage":"作谓语、定语；比喻有失有得","story":["春秋时期，齐国和晋国打仗，一个小卒在混战中把戟丢了，但捡到一只矛。后退时问路人怎么办？路人说同样是兵器，回去没问题。他又问高唐大夫怎么办，高唐大夫说应该回去捡回来，他们两人重返战场，为寻找戟而英勇战死"]},{"id":4753,"word":"亡是公","pinyin":"wú shì gōng","abbr":"wsg","explanation":"亡：即无。指不存在的人或物。","source":{"text":"亡是公者，无是人也。","book":"汉·司马相如《子虚赋》中假托的人名。《史记·司马相如列传》"},"example":{"text":"应同～，一对子虚听。","book":"宋·苏轼《李公择过高邮见施大夫与孙莘老赏花诗……依韵奉答亦以一戏公择云尔》"}},{"id":4754,"word":"亡猿灾木","pinyin":"wáng yuán zāi mù","abbr":"wyzm","explanation":"比喻欲损人反而害己的行为。同“亡猿祸木”。","source":{"text":"覆鹿遗蕉，亡猿灾木，非敌非寇，自倾自覆。","book":"清·王闿运《序》"},"similar":["亡猿祸木"],"usage":"作宾语、定语；用于书面语"},{"id":4755,"word":"亡猿祸木","pinyin":"wáng yuán huò mù","abbr":"wyhm","explanation":"比喻欲损人反而害己的行为。","source":{"text":"唐大历中，有猴数百集古田杉林中，里人欲伐木杀之。中一老猴忽跃去近邻一家纵火焚屋。里人惧，亟走救火，于是群猴脱去。","book":"《渊鉴类函》卷四三二引《汀州志》"},"similar":["亡猿灾木"],"usage":"作宾语、定语；用于书面语","story":["唐朝大历年间，有数百只猴子栖息在古田的杉木林中，附近的农民嫌它们危害庄稼，想把林子砍光然后杀猴。群猴中的一只老猴见人伐木，就跳到附近的一家房屋开始纵火烧屋。农民见房屋烧起来了赶紧去救火，于是群猴纷纷逃走"]},{"id":4756,"word":"亡矢遗镞","pinyin":"wáng shǐ yí zú","abbr":"wsyz","explanation":"损失箭和箭头。比喻军事上的细微损失。","source":{"text":"秦无亡矢遗镞之费，而天下诸侯已困矣。","book":"汉·贾谊《过秦论》"},"example":{"text":"清·夏燮《中西纪事·海疆殉难记》：“若其军士不战，城门不闭，敌无～之费取之者，则宁波之与上海也。”"},"usage":"作宾语、定语；用于书面语"},{"id":4757,"word":"亡秦三户","pinyin":"wáng qín sān hù","abbr":"wqsh","explanation":"指不畏强暴，奋起推翻黑暗统治之事。","source":{"text":"故楚南公曰：‘楚虽三户，亡秦必楚’也。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"曾把心香爇到君，～识雄文。","book":"古直《吊杨笃生先生》诗"},"similar":["三户亡秦"],"usage":"作宾语、定语；指奋起推翻残暴统治","story":["秦朝末期，陈胜吴广起义，各路义军纷纷配合，项梁率军攻秦。范增去拜见项梁说：“秦灭六国，楚国最冤，楚南公说过楚国即使只剩下三户人家都会报仇雪恨消灭秦国的。”于是项梁立楚怀王的孙子米心为楚怀王，得到楚人的拥护而迅速壮大实力"]},{"id":4758,"word":"亡立锥之地","pinyin":"wáng lì zhuī zhī dì","abbr":"wlzzd","explanation":"亡：无；立锥：插锥子。没有插锥尖的一点地方。形容极其贫困。","source":{"text":"富者田连阡陌，贫者亡立锥之地。","book":"东汉·班固《汉书·食货志》"},"similar":["无立锥之地","无置锥之地"],"usage":"作谓语、定语、状语；指没有立足的地方"},{"id":4759,"word":"亡羊之叹","pinyin":"wáng yáng zhī tàn","abbr":"wyzt","explanation":"亡：丢失。叹：叹息。为丢失了羊而叹息。比喻探索学问，徘徊歧路，结果一无所得，空留遗憾。亦作“亡羊歧路”。","source":{"text":"大道以多歧亡羊，学者以多方丧生。学非本不同，非本不一，而末异若是。唯归同反一，为亡得丧。子长先生之门，习先生之道，而不达先生之况也，哀哉！","book":"《列子·说符》"}},{"id":4760,"word":"亡羊得牛","pinyin":"wáng yáng dé niú","abbr":"wydn","explanation":"丢掉羊，得到牛。比喻损失小而收获大。","source":{"text":"亡羊而得牛，则莫不利失也。","book":"《淮南子·说山训》"},"usage":"作宾语、定语；指损失小而收获大"},{"id":4761,"word":"亡羊歧路","pinyin":"wáng yáng qí lù","abbr":"wyql","explanation":"亡：丢失；歧路：岔路。因岔路太多无法追寻而丢失了羊。比喻事物复杂多变，没有正确的方向就会误入歧途。","source":{"text":"大道以多歧亡羊，学者以多方丧生。","book":"《列子·说符》"},"example":{"text":"失鹿中原悲得失，～叹兴亡。","book":"南怀瑾《应嘱为孙中山先生九十八诞辰作》"}},{"id":4762,"word":"亡羊补牢","pinyin":"wáng yáng bǔ láo","abbr":"wybl","explanation":"亡：逃亡，丢失；牢：关牲口的圈。羊逃跑了再去修补羊圈，还不算晚。比喻出了问题以后想办法补救，可以防止继续受损失。","source":{"text":"见兔而顾犬，未为晚也；亡羊而补牢，未为迟也。","book":"《战国策·楚策》"},"example":{"text":"张学良始则失地，今幸固守锦州，～，可称晚悟。","book":"章炳麟《与孙思昉论时事书》二"},"similar":["知错就改"],"opposite":["时不我待","知错不改"],"usage":"作主语、谓语、宾语；指知错就改","story":["战国时楚襄王荒淫无度，执迷不悟，将劝谏的大臣庄辛赶出楚国。五个月趁机征伐，很快占领楚都郢。楚襄王后悔不已，派人到赵国请回庄辛，庄辛说：“见兔而顾犬，未为晚也；亡羊则补牢，未为迟也。”鼓励楚襄王励精图治、重整旗鼓"]},{"id":4763,"word":"亡魂丧胆","pinyin":"wáng hún sàng dǎn","abbr":"whsd","explanation":"形容惊慌恐惧到极点。","source":{"text":"杀匈奴亡魂丧胆，保家邦万载咸宁。","book":"明·无名氏《破天阵》"},"example":{"text":"我亏了定阳王封我为先锋，日抢三关，夜劫八寨，杀得唐家～。","book":"《说唐》第47回"},"similar":["丢魂丧胆"],"usage":"作谓语、定语、状语；指惊慌恐惧"},{"id":4764,"word":"亡魂丧魄","pinyin":"wáng hún sàng pò","abbr":"whsp","explanation":"形容非常惊慌恐惧或心神不宁。","source":{"text":"哥哥你宽肺腑，休间阻，我教他亡魂丧魄，认个贤。","book":"《孤本元明杂居·打董达》第二折"},"similar":["亡魂失魄"],"usage":"作定语、状语；指惊慌失措"},{"id":4765,"word":"亡魂失魄","pinyin":"wáng hún shī hún","abbr":"whsp","explanation":"魂、魄：旧指人身中离开形体能存在的精神为魂，依附形体而显现的精神为魄。形容惊慌忧虑、心神不定、行动失常的样子。","source":{"text":"饿的我肚里饥失魂丧魄，冻的我身上冷无颜落色。","book":"元·无名氏《看钱奴》第二折"},"example":{"text":"孔子好像受了当头一棒，～的坐着，恰如一段呆木头。","book":"鲁迅《故事新编·出关》"},"similar":["丧魂失魄","亡魂丧魄"],"usage":"作定语、状语；指惊慌失措"},{"id":4766,"word":"亢厉为能","pinyin":"kàng lì wéi néng","abbr":"klwn","explanation":"亢厉：极为严厉；能：才能。以严酷作为自己的才能。","source":{"text":"擅利淫刑之守，亢厉以为能。","book":"清·王夫之《读通鉴论·简文帝》"}},{"id":4767,"word":"亢宗之子","pinyin":"kàng zōng xhī zǐ","abbr":"kzzz","explanation":"亢：庇护；宗：宗族。能维护、扩大家族权势的人。也形容光宗耀祖之人。","source":{"text":"吉不能亢身，焉能亢宗？","book":"《左传·昭公元年》"},"example":{"text":"我不德，不应有～；弟又善教，俾姑为汝子。有寸进时，可赐还也。","book":"清·蒲松龄《聊斋志异·曾友于》"}},{"id":4768,"word":"亢心憍气","pinyin":"kàng xīn xià qì","abbr":"kxjq","explanation":"指性情高傲。"},{"id":4769,"word":"亢极之悔","pinyin":"kàng jí zhī huǐ","abbr":"kjzh","explanation":"亢：至高的；悔：灾祸。意为居高位的人要戒骄，否则会失败而后悔。后也形容倨傲者不免招祸。","source":{"text":"俯无倨鵄之呼，仰无亢极之悔，人莫之识，邈矣辽哉","book":"《周易·乾》：“上九，亢龙有悔。”《抱朴子·内篇》"},"example":{"text":"今明公忘～，忽穷高之凶。弃五岳之安，居累卵之危，外以权势受疑，内以百揆损神。","book":"《晋书·齐王冏传》"},"similar":["亢龙有悔"],"usage":"作宾语；比喻盛久必衰"},{"id":4770,"word":"亢音高唱","pinyin":"gāng yīn gāo chàng","abbr":"kygc","explanation":"亢：喉咙。放开喉咙，高声歌唱。","source":{"text":"动朱唇，纡清扬，亢音高唱，为乐之方。","book":"汉·傅毅《舞赋》"}},{"id":4771,"word":"亢龙有悔","pinyin":"kàng lóng yǒu huǐ","abbr":"klyh","explanation":"亢：至高的；悔：灾祸。意为居高位的人要戒骄，否则会失败而后悔。后也形容倨傲者不免招祸。","source":{"text":"上九，亢龙有悔。","book":"《周易·乾》"},"example":{"text":"进则～，退则蒺藜生庭，冀此求安，未知其福。","book":"《晋书·王豹传》"},"similar":["亢极之悔"],"usage":"作宾语、定语；指不知激流勇退"},{"id":4772,"word":"交口同声","pinyin":"jiāo kǒu tóng shēng","abbr":"jkts","explanation":"犹言众口一词。所有的人都说同样的话。","source":{"text":"以故人人到母后跟前，交口同声，誉称晋王仁孝聪明，不似太子寡恩傲礼。","book":"明·冯梦龙《醒世恒言》第24卷"},"example":{"text":"凡在满洲朝廷者，已～，称康梁为忠臣义士，特不敢言之于西太后耳。","book":"《天讨·谕保皇会檄》"},"similar":["异口同声"],"usage":"作谓语、定语、状语；同“异口同声”"},{"id":4773,"word":"交口称誉","pinyin":"jiāo kǒu chēng yù","abbr":"jkcy","explanation":"交：一齐，同时。异口同声地称赞。","source":{"text":"诸公要人，争欲令出我们下，交口荐誉之。","book":"唐·韩愈《柳志厚墓志铭》"},"example":{"text":"凡所实施，光明正大。艰苦奋斗，不敢告劳。全国人民，～。","book":"毛泽东《陕甘宁边区政府、第八路军后方留守处布告》"},"similar":["赞不绝口","有口皆碑"],"opposite":["群起而攻之","众矢之的"],"usage":"作谓语、定语；指异口同声地称赞"},{"id":4774,"word":"交口称赞","pinyin":"jiāo kǒu chēng zàn","abbr":"jkcz","explanation":"交：一齐，同时。异口同声地称赞。","source":{"text":"诸公要人，争欲令出我们下，交口荐誉之。","book":"唐·韩愈《柳志厚墓志铭》"},"example":{"text":"一年之后，附近几个村庄的牧童们没有一个有她吹的好，连大人们也～。","book":"姚雪垠《李自成》第一卷第二十章"},"similar":["有口皆碑","口碑载道","交口称誉"],"opposite":["众口铄金"],"usage":"作谓语、定语；指异口同声地称赞"},{"id":4775,"word":"交口荐誉","pinyin":"jiāo kǒu jiàn yù","abbr":"jkjy","explanation":"交：一齐，同时；交口：众口一辞；荐：推举。异口同声地推荐和赞扬。","source":{"text":"诸公要人，争欲令出我门下，交口荐誉之。","book":"唐·韩愈《柳志厚墓志铭》"},"similar":["交口称赞"],"usage":"作谓语、定语；指交口称赞"},{"id":4776,"word":"交口赞誉","pinyin":"jiāo kǒu zàn yù","abbr":"jkzy","explanation":"交：一齐，同时。异口同声地称赞。","source":{"text":"诸公要人，争欲令出我们下，交口荐誉之。","book":"唐·韩愈《柳志厚墓志铭》"},"example":{"text":"每布一政，群下～，令乃欢。","book":"明·刘元卿《应谐录·悦谀》"},"similar":["交口赞誉"],"usage":"作谓语、定语；指异口同声地称赞"},{"id":4777,"word":"交头互耳","pinyin":"jiāo tóu hù ěr","abbr":"jthe","explanation":"犹交头接耳。形容两个人凑近低声交谈。"},{"id":4778,"word":"交头接耳","pinyin":"jiāo tóu jiē ěr","abbr":"jtje","explanation":"交头：头靠着头；接耳：嘴凑近耳朵。形容两个人凑近低声交谈。","source":{"text":"不许交头接耳，不许笑语喧哗。","book":"元·关汉卿《单刀会》第三折"},"example":{"text":"看见门上那些人在那里～，好像要使贾政知道的似的，又不好明回，只管咕咕唧唧的说话。","book":"清·曹雪芹《红楼梦》第九十三回"},"similar":["窃窃私语","窃窃私议"],"opposite":["大声喧哗"],"usage":"作谓语、定语、状语；用于两人凑近低语","story":["林冲因为得罪了高太尉，被发配到沧州草料场。在沧州他见到了朋友李小二，经常去李小二的酒店喝酒。有一天酒店来了两个东京人，他们吃饭时交头接耳低声嘀咕，李小二估计与林冲有关，告诉林冲。林冲毅然杀死陆谦，走向梁山泊"]},{"id":4779,"word":"交易不成仁义在","pinyin":"jiāo yì bù chéng rén yì zài","abbr":"jybcryz","explanation":"交易：做生意；仁义：仁爱和正义。生意虽没有做成，但感情和义气还是存在的。","source":{"text":"买卖中的规矩，交易不成仁义在，虽然木料没批，酒肴是要预备的。","book":"清·石玉昆《三侠五义》第二十四回"}},{"id":4780,"word":"交梨火枣","pinyin":"jiāo lí huǒ zǎo","abbr":"jlhz","explanation":"道教经书中所说的“仙果”。","source":{"text":"玉醴金浆，交梨火枣，此则腾飞之药，不比于金丹也。","book":"《真诰·运象二》"},"usage":"作宾语、定语；用于道教等"},{"id":4781,"word":"交横绸缪","pinyin":"jiāo héng chóu móu","abbr":"jhcm","explanation":"绸缪：缠绕。交错缠绕在一起。","source":{"text":"汩乎顺流，至乎沧海之滨，滂薄汹涌，号怒相轨，交横绸缪。","book":"宋·苏洵《仲兄字文甫说》"}},{"id":4782,"word":"交洽无嫌","pinyin":"jiāo qià wú xián","abbr":"jqwx","explanation":"洽：协商；嫌：猜疑。指双方密切协作，相互信任。","source":{"text":"于父子之间慈孝，交洽无嫌。","book":"唐·韩愈《顺宗实录》第一卷"},"usage":"作谓语；用于双方关系等"},{"id":4783,"word":"交浅不可言深","pinyin":"jiāo qiǎn bù kě yán shēn","abbr":"jqbkys","explanation":"交：交情。对交情浅的人不能说知心话。","source":{"text":"骃闻交浅而言深，愚也。","book":"《后汉书·崔骃传》"}},{"id":4784,"word":"交浅言深","pinyin":"jiāo qiǎn yán shēn","abbr":"jqys","explanation":"交：交情，友谊。跟交情浅的人谈心里话。","source":{"text":"夫望人而笑，是和也；言而不称师，是庸说也；交浅而言深，是忠也。","book":"《战国策·赵策四》"},"example":{"text":"小弟乍会之间，～，诚恐见怪。","book":"明·冯梦龙《警世通言》卷三十二"},"usage":"作定语；指言谈有失分寸"},{"id":4785,"word":"交淡若水","pinyin":"jiāo dàn ruò shuǐ","abbr":"jdrs","explanation":"指道义上的往来。","source":{"text":"且君子之交淡若水，小人之交甘若醴。","book":"《庄子·山水》"},"similar":["君子之交"],"opposite":["小人之交"],"usage":"作宾语、定语；指道义上的往来"},{"id":4786,"word":"交疏吐诚","pinyin":"jiāo shū tǔ chéng","abbr":"jstc","explanation":"交：交情；疏：疏淡；吐：谈吐；诚：真诚。交情虽然疏淡，但说话非常坦诚。","source":{"text":"知几其神乎，古人以为难；交疏吐诚，今人以为难。","book":"南朝·宋·刘义庆《世说新语·规箴》"},"similar":["交浅言深"],"usage":"作宾语、定语；用于交往"},{"id":4787,"word":"交相辉映","pinyin":"jiāo xiāng huī yìng","abbr":"jxhy","explanation":"各种光亮、色彩等互相映照。","source":{"text":"数座宝塔遥遥矗立日光雪光湖光交相辉映塔身清澈剔透。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"满城的彩灯与腾空的焰火～。"},"usage":"作谓语、定语；指各种光亮、色彩等互相映照"},{"id":4788,"word":"交能易作","pinyin":"jiāo néng yì zuò","abbr":"jnyz","explanation":"指交换各业的劳动成果而互相获益。","source":{"text":"故先王使农、土、商、工四民交能易作，终岁之利无道相过也，是以民作一而得均。","book":"春秋·齐·管仲《管子·治国》"},"example":{"text":"五材百物，民皆用之，必各有职业，～，然后其享之也安。","book":"清·方苞《甲辰示道希兄弟》"},"usage":"作谓语、宾语；用于书面语"},{"id":4789,"word":"交臂历指","pinyin":"jiāo bì lì zhǐ","abbr":"jblz","explanation":"交臂：两手反缚；历指：古代拶指的刑罚。象罪犯两手反缚、受拶指的刑罚一般。形容痛苦万状，毫无自由。","source":{"text":"则是罪人交臂历指，而虎豹在于囊槛，亦可以为得矣。","book":"战国·宋·庄周《庄子·天地》"},"example":{"text":"‘则是罪人～，而虎豹在于囊槛，亦可以为得矣。’由是观之，令人得脱肉而居。","book":"章炳麟《国家论》"},"usage":"作定语；指受束缚"},{"id":4790,"word":"交臂失之","pinyin":"jiāo bì shī zhī","abbr":"jbsz","explanation":"比喻遇到了机会而又当面错过。","source":{"text":"吾终身与汝交一臂而失之，可不哀与？","book":"《庄子·田子方》"},"example":{"text":"遇可事之主，而～，非丈夫也。","book":"明·罗贯中《三国演义》第十四回"},"similar":["失之交臂"],"opposite":["机不可失"],"usage":"作谓语、宾语；形容没有抓住机会"},{"id":4791,"word":"交臂相失","pinyin":"jiāo bì xiāng shī","abbr":"jbxs","explanation":"犹言交臂失之。比喻遇到了机会而又当面错过。","source":{"text":"齐体合欢，交臂相失。","book":"唐·冉元一《薛刚墓志》"},"example":{"text":"知人之明，圣哲所难。英雄以此自任，每至～。","book":"明·李贽《史纲评要·周纪·赧王》"},"similar":["交臂失之"],"usage":"作谓语、宾语；形容没有抓住机会"},{"id":4792,"word":"交詈聚唾","pinyin":"jiāo lì jù tuò","abbr":"jljt","explanation":"指一齐唾骂。","source":{"text":"时蔡虚台为仪郎，当主议，稍以极事折之，为豺绣交詈聚唾，因调停为常朝大朝之说，总之无成规也。","book":"明·沈德符《野获编·礼部·朝班》"},"usage":"作谓语、定语；用于书面语"},{"id":4793,"word":"交际花","pinyin":"jiāo jì huā","abbr":"jjh","explanation":"在社交场中活跃而有名的女子。","source":{"text":"还有几个很少上班的女同事，都是凭裙带关系进厂的交际花一般的女人。","book":"罗广斌《红岩》第三章"},"example":{"text":"她是我们班里的有名的～。"},"usage":"作宾语、定语；用于口语"},{"id":4794,"word":"交颈并头","pinyin":"jiāo jǐng bìng tóu","abbr":"jjbt","explanation":"形容许多人聚集在一起。","source":{"text":"但见：扶肩搭背，交颈并头；纷纷不辨贤愚，扰扰难分贵贱。","book":"明·施耐庵《水浒传》第三回"},"usage":"作定语、状语；用于人多的场合"},{"id":4795,"word":"亥豕相望","pinyin":"hài shǐ xiāng wàng","abbr":"hsxw","explanation":"指文字讹错很多。","source":{"text":"吴兴凌氏诸刻，急于成书射利，又悭于倩人编摩，其间亥豕相望，何怪其然？","book":"明·谢肇淛《五杂俎·事部一》"},"similar":["鲁鱼亥豕"],"usage":"作定语；指文字讹错很多"},{"id":4796,"word":"亥豕鲁鱼","pinyin":"hài shǐ lǔ yú","abbr":"hsly","explanation":"把“亥”字错成“豕”字，把“鲁”字错成“鱼”字。指传写或刻印中的文字错误。","source":{"text":"其如亥豕鲁鱼之谬，深有惭于负乘，敢自己于循墙。","book":"宋·文天祥《谢何枢密梦然启》"},"similar":["鲁鱼亥豕"],"usage":"作宾语、定语；指文字错误"},{"id":4797,"word":"亦复如是","pinyin":"yì fù rú shì","abbr":"yfrs","explanation":"复：又，再。也是这样。","source":{"text":"刘琨善能招延，而拙于抚御，一日虽有数千人归投，其逃散而去，亦复如此。所以卒无所建。","book":"南朝宋·刘义庆《世说新语·尤悔》"},"example":{"text":"这先生方伸手按在右手脉上，调息了至数，凝神细诊了半刻功夫。换过左手，～。","book":"清·曹雪芹《红楼梦》第十回"},"similar":["亦复如此"],"usage":"作谓语、状语；指同样"},{"id":4798,"word":"亦复如此","pinyin":"yì fù rú cǐ","abbr":"yfrc","explanation":"复：又，再。也是这样。","source":{"text":"刘琨善能招延，而拙于抚御，一日虽有数千人归投，其逃散而去，亦复如此。所以卒无所建。","book":"南朝·宋·刘义庆《世说新语·尤悔》"},"example":{"text":"我辈之挤加纳于清风，责三矢于牛入，～。","book":"鲁迅《致许寿裳》"},"similar":["亦复如是"],"usage":"作谓语、状语；指同样"},{"id":4799,"word":"亦庄亦谐","pinyin":"yì zhuāng yì xié","abbr":"yzyx","explanation":"形容既严肃又风趣。","source":{"text":"亦庄亦谐潇洒，百花齐放争荣。","book":"茅盾《为〈大众电影〉恢复刊名作》"},"example":{"text":"你是否感到毛泽东的讲话是他身上最有魅力的地方？据说由于毛能运用古语、俗语、笑话，弄出满堂笑声……不过毛说话大而化之，～的风格是独特的。","book":"吴福辉《沙汀传》第八章"},"usage":"作谓语、定语；形容人说话等"},{"id":4800,"word":"亦步亦趋","pinyin":"yì bù yì qū","abbr":"ybyq","explanation":"原意是说，你慢走我也慢走，你快走我也快走，你跑我也跑。比喻由于缺乏主张，或为了讨好，事事模仿或追随别人。","source":{"text":"夫子步亦步，夫子趋亦趋，夫子驰亦驰，夫子奔逸绝尘，而回瞠若乎后矣。","book":"《庄子·田子方》"},"example":{"text":"尾巴主义是成功的仇敌。刊物内容如果只是“人云亦云”，格式如果只是“～”，那是刊物的尾巴主义。","book":"邹韬奋《经历·几个原则》"},"similar":["邯郸学步","东施效颦","如法炮制"],"opposite":["独具匠心","独树一帜","别具一格"],"usage":"作谓语、定语、状语；指没主见","story":["春秋时期鲁国大思想家孔子广收弟子，传道讲学，在他的三千多学生中他最喜欢的就是颜回。颜回安贫乐道，勤奋好学，他一举一动都学孔子，他对孔子说：“夫子步亦步，夫子趋亦趋，夫子驰亦驰，夫子奔逸绝尘，而回瞠若乎后矣。”"]},{"id":4801,"word":"亦趋亦步","pinyin":"yì qū yì bù","abbr":"yqyb","explanation":"形容事事追随和模仿别人。","source":{"text":"夫子步亦步，夫子趋亦趋，夫子驰亦驰，夫子奔逸绝尘，而回瞠若乎后矣。","book":"《庄子·田子方》"},"example":{"text":"兹及为矩为规，～。","book":"清·张学诚《文史同义·言公下》"},"similar":["亦步亦趋","一步一趋"],"usage":"作谓语、定语、状语；指没主见"},{"id":4802,"word":"亨嘉之会","pinyin":"hēng jiā zhī huì","abbr":"hjzh","explanation":"亨嘉：美好的事物聚会在一起。比喻优秀人物济济一堂。","source":{"text":"亨者，嘉之会。","book":"《周易·乾》"},"example":{"text":"徒以早遘～，骤蒙奖拔之私。","book":"宋·欧阳修《谢参知政事表》"},"usage":"作宾语；用于书面语"},{"id":4803,"word":"享帚自珍","pinyin":"xiǎng zhǒu zì zhēn","abbr":"xzzz","explanation":"比喻物虽微劣，而自视为宝。","source":{"text":"享帚自珍，缄石知谬。","book":"唐·李善《上文选注表》"},"example":{"text":"文心结习，～，一集成书。","book":"清·陈康祺《郎潜纪闻》第14卷"},"similar":["敝帚自珍"],"usage":"作谓语、定语；指爱惜自己的东西"},{"id":4804,"word":"京兆画眉","pinyin":"jīng zhào huà méi","abbr":"jzhm","explanation":"指夫妇或男女相爱。用为夫妇或男女相爱的典实。","source":{"text":"[敞]又为妇画眉，长安中传张京兆眉怃。有司以奏敞。上问之一，对曰：‘臣闻闺房之内，夫妇之私，有过于画眉者。’上爱其能，弗备责也。","book":"《汉书·张敞传》"},"example":{"text":"复促生起为掠鬓，生谢不敏。仲仙笑曰：“卿不见～乎？”","book":"清吴骞《扶风传信录》"},"similar":["张敞画眉"],"usage":"作宾语、定语；指夫妻恩爱","story":["汉朝时期，京兆尹张敞夫妻十分恩爱，每天都为他的妻子画眉毛，而且技艺十分娴熟，画出的眉毛十分漂亮，当时的皇帝得知后为此召见他们，将他们树立夫妻恩爱的典范"]},{"id":4805,"word":"京兆眉妩","pinyin":"jīng zhào méi wǔ","abbr":"jzmw","explanation":"用以称女子眉样美好。","source":{"text":"汉京兆尹张敞为妇画眉甚美，长安中传“张京兆眉妩”。"},"example":{"text":"外来共传～，不知他怎生一样画法。","book":"明南山逸史《京兆眉》第二折"},"usage":"作宾语、定语；用于女性"},{"id":4806,"word":"京解之才","pinyin":"jīng jiě zhī cái","abbr":"jjzc","explanation":"京解：科举时代的进士和举人。旧指有考中举人、进士的才能。","source":{"text":"有几个老学，看了舍亲的文字，都许他京解之才。","book":"明·冯梦龙《醒世恒言》卷七"}},{"id":4807,"word":"京辇之下","pinyin":"jīng niǎn zhī xià","abbr":"jnzx","explanation":"比喻帝王管辖下的京城。","source":{"text":"辇毂之下尚尔，远民冤滥，孰肯更为辨之！","book":"宋·苏舜钦《与欧阳公书》"},"similar":["辇毂之下"],"usage":"作主语、宾语；指京城"},{"id":4808,"word":"亭亭玉立","pinyin":"tíng tíng yù lì","abbr":"ttyl","explanation":"亭亭：高耸直立的样子。形容女子身材细长。也形容花木等形体挺拔。","source":{"text":"一女英迈出群，亭亭玉立。","book":"明·张岱《公祭祁夫人文》"},"example":{"text":"花型小，比起～的荷花远逊。","book":"郭沫若《百花齐放·睡莲》"},"similar":["袅袅婷婷","风仪玉立"],"opposite":["其貌不扬"],"usage":"作谓语、宾语、定语；用于女性或树木等","story":["北齐时期，武成帝高湛惨无人道，杀害自己的侄儿高百年，与哥哥高洋的妻子李氏淫乱，经常沉溺于酒色，身体日渐消瘦，极度虚弱，经常看到一个亭亭玉立的美人站在眼前。太医徐之才给他开药治病，不久果然病愈。后他又更加淫乱而死"]},{"id":4809,"word":"亭台楼阁","pinyin":"tíng tái lóu gé","abbr":"ttlg","explanation":"泛指多种供游赏、休息的建筑物。","source":{"text":"虽然算不得大园庭，但亭台楼阁，树木山石，却也点缀结构得幽雅不俗。","book":"清·文康《儿女英雄传》第一回"},"example":{"text":"我喜欢中国的～。"},"similar":["楼台亭阁"],"usage":"作主语、宾语、定语；指建筑物"},{"id":4810,"word":"亮亮堂堂","pinyin":"liàng liàng táng táng","abbr":"lltt","explanation":"指光线很明亮。","source":{"text":"但少安妈收拾的汤清水利，亮亮堂堂的，这现在完全成了个黑山水洞！","book":"路遥《平凡的世界》第一卷第24章"},"opposite":["天昏地暗","暗淡无光"],"usage":"作定语、状语；用于口语"},{"id":4811,"word":"亲上作亲","pinyin":"qīn shàng zuò qīn","abbr":"qszq","explanation":"亲戚间再结姻亲。","source":{"text":"又听见二奶奶说，宝玉的事，老太太总是要亲上作亲的，凭谁来说亲，横竖不中用。","book":"清·曹雪芹《红楼梦》第90回"},"similar":["亲上做亲"],"usage":"作谓语、宾语、定语；指更加亲密"},{"id":4812,"word":"亲上做亲","pinyin":"qīn shàng zuò qīn","abbr":"qszq","explanation":"指原是亲戚，又再结姻亲。","source":{"text":"偏我不如他，我仁者能仁，身里出身的根脚，又是亲上做亲，况兼他父命。","book":"元·王实甫《西厢记》第五本第三折"},"example":{"text":"咱们～，我想也不必这些。若说动用的，他屋里已经满了。","book":"清·曹雪芹《红楼梦》第九十八回"},"similar":["亲上加亲","亲上作亲"],"usage":"作谓语、宾语、定语；指更加亲密"},{"id":4813,"word":"亲上加亲","pinyin":"qīn shàng jiā qīn","abbr":"qsjq","explanation":"原是亲戚，又再结姻亲。","source":{"text":"姑母却以‘自己已经受够了亲上加亲的苦，不愿意让女儿再来受一次’这理由拒绝了。","book":"巴金《做大哥的人》"},"example":{"text":"他盼望能够～。"},"similar":["亲上成亲"],"usage":"作谓语、宾语、定语；指更加亲密"},{"id":4814,"word":"亲上成亲","pinyin":"qīn shàng chéng qīn","abbr":"qscq","explanation":"指原是亲戚，又再结姻亲。","source":{"text":"怕不依随蒙君一夜恩，争奈忒达地忒知根，兼上亲上成亲好对门。","book":"元·关汉卿《调风月》第一折"},"similar":["亲上加亲","亲上做亲"],"usage":"作谓语、宾语、定语；指更加亲密"},{"id":4815,"word":"亲不亲故乡人","pinyin":"qīn bù qīn gù xiāng rén","abbr":"qbqgxr","explanation":"比喻同乡人感情亲密。","source":{"text":"常言亲不亲故乡人，美不美乡中水。虽然不是我兄弟，也是我女婿人家。","book":"明·兰陵笑笑生《金瓶梅词话》第九十二回"},"example":{"text":"既然是家乡人，我理所当然要多担待一些，～吗。","book":"赵辉《同治皇帝》第二章"}},{"id":4816,"word":"亲不敌贵","pinyin":"qīn bù dí guì","abbr":"qbdg","explanation":"亲：亲戚；敌：相当；贵：地位。亲情不能胜过职位的尊卑。形容人情淡薄。","source":{"text":"天子至尊，亲不敌贵，古之制也。今燕王擅驰御道，又当陛下不拜，请敕法司拿下究罪。","book":"明·徐渭《续英烈传》第六回"},"example":{"text":"我道是谁？杨妹丈是咱内亲，为何也不竟进？如今～了。","book":"清·孔尚任《桃花扇》第二十一出"},"usage":"作宾语、定语；用于为人等"},{"id":4817,"word":"亲不隔疏","pinyin":"qīn bù gé shū","abbr":"qbgs","explanation":"亲：亲近的人；疏：疏远的人。亲近的人不会被疏远的人隔开。","source":{"text":"你这么个明白人，难道连‘亲不隔疏，后不谮先’也不知道？","book":"清·曹雪芹《红楼梦》第20回"},"similar":["亲不间疏"],"usage":"作宾语、定语；用于为人等"},{"id":4818,"word":"亲临其境","pinyin":"qīn lín qí jìng","abbr":"qlqj","explanation":"临：到；境：境界，地方。亲自到了那个地方。","source":{"text":"在执笔以前，我阅读了一些参考资料，并且亲临其境去观察。","book":"老舍《写作经过》"},"example":{"text":"阅读这篇文章有～之感。"},"similar":["身临其境"],"usage":"作谓语、定语；指亲自参加"},{"id":4819,"word":"亲亲切切","pinyin":"qīn qīn qiè qiè","abbr":"qqqq","explanation":"形容人态度亲爱和善。","source":{"text":"炀帝拉李夫人同坐了玉辇，亲亲切切，又说了许多体己话。","book":"清·褚人获《隋唐演义》第30回"},"usage":"作定语、状语；用于人的态度等"},{"id":4820,"word":"亲亲热热","pinyin":"qīn qīn rè rè","abbr":"qqrr","explanation":"亲近热情。","source":{"text":"一味将笑撮在脸上，调引这几个小男女，亲亲热热，胜如亲生。","book":"明·冯梦龙《醒世恒言》第27卷"},"example":{"text":"我们不可能装得～。"},"similar":["卿卿我我"],"opposite":["疏疏远远"],"usage":"作定语、状语；指人际关系"},{"id":4821,"word":"亲仁善邻","pinyin":"qīn rén shàn lín","abbr":"qrsl","explanation":"与邻者亲近，与邻邦友好。","source":{"text":"亲仁善邻，国之宝也，君其许郑。","book":"《左传·隐公六年》"},"example":{"text":"远裔种族匪殊，～，宜捐小忿。","book":"清·章炳麟《与汪康年书》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":4822,"word":"亲冒矢石","pinyin":"qīn mào shǐ shí","abbr":"qmss","explanation":"指将帅亲临作战前线。同“亲当矢石”。","source":{"text":"尚亲冒矢石，冲突掩杀。","book":"明·罗贯中《三国演义》第32回"},"example":{"text":"清·如莲居士《薛刚反唐》第一回：“招纳我们一班朋友，～，南征北讨，东荡西除，血战九年，平一六合，方成一统江山。”"},"similar":["亲当矢石","躬冒矢石"],"usage":"作谓语、定语；指人很勇敢"},{"id":4823,"word":"亲力亲为","pinyin":"qīn lì qīn wéi","abbr":"qlqw","explanation":"自己动手，亲自操办。"},{"id":4824,"word":"亲如一家","pinyin":"qīn rú yī jiā","abbr":"qryj","explanation":"亲近得就像一家人一样。形容相互间的关系非常密切。","example":{"text":"今后两家务须～，不可受人挑拨离间。","book":"金庸《射雕英雄传》第六回"}},{"id":4825,"word":"亲如兄弟","pinyin":"qīn rú xiōng dì","abbr":"qrxd","explanation":"象兄弟一样的亲密。多形容朋友的情谊深厚。","source":{"text":"胡越之人亦可亲如兄弟。","book":"《魏书·高祖纪》"},"example":{"text":"袁承志和他相处十余年，早已～，知他不舍得与自己分离，心下也感怅惘。","book":"金庸《碧血剑》第三回"}},{"id":4826,"word":"亲如手足","pinyin":"qīn rú shǒu zú","abbr":"qrsz","explanation":"象兄弟一样的亲密。多形容朋友的情谊深厚。","source":{"text":"想兄弟情亲如手足。","book":"元·孟汉卿《魔合罗》第四折"},"example":{"text":"而革命同志又复～，因此便要求加入同盟会。","book":"吴玉章《甲午战争到辛亥革命前后的回忆》"},"similar":["情同手足","亲若手足"],"usage":"作谓语；多形容朋友的情谊深"},{"id":4827,"word":"亲如骨肉","pinyin":"qīn rú gǔ ròu","abbr":"qrgr","explanation":"形容关系密切如一家人。","source":{"text":"朕自涿郡与卿等之父结异姓之交，亲如骨肉；今汝二人亦是昆仲之分，正当同心协力，共报父仇；奈何自相争竞，失其大义！","book":"明·罗贯中《三国演义》第八十一回"},"example":{"text":"是如此亲如骨肉的关系，所以张彪“上院”向陈夔龙请假，要到京里去奔丧。","book":"高阳《慈禧全传》一○八"},"similar":["亲如手足"],"opposite":["不共戴天"],"usage":"作谓语、定语；指关系密切"},{"id":4828,"word":"亲密无间","pinyin":"qīn mì wú jiàn","abbr":"qmwj","explanation":"间：缝隙。关系亲密，没有隔阂。形容十分亲密，没有任何隔阂。","source":{"text":"萧望之历位将相，藉师傅之恩，可谓亲昵亡间。及至谋泄隙开，谗邪构之，卒为便嬖宦竖所图，哀哉！","book":"《汉书·萧望之传赞》"},"example":{"text":"老东山和未过门的儿媳妇，父女般的谈着，似乎他们之间，过去没有发生什么纠纷不不愉快，从来就是～。","book":"冯德英《迎春花》十九章"},"similar":["情同手足","形影不离"],"opposite":["敬而远之","视同陌路"],"usage":"作谓语、定语、状语、补语；指关系密切"},{"id":4829,"word":"亲当矢石","pinyin":"qīn dāng shǐ shí","abbr":"qdss","explanation":"当：遮拦，阻挡；矢：箭。亲自阻挡敌人的箭、石，不怕牺牲。","source":{"text":"每临行阵，亲当矢石。","book":"《北齐书·文宣帝纪》"},"example":{"text":"王师问罪，至于淄青，尔等同执干戈，～，忠而尽瘁，勇以亡身。","book":"唐·白居易《赠阵亡军将等刺史札》"},"similar":["亲冒矢石","身当矢石"],"usage":"作谓语、定语；指人很勇敢","story":["公元550年，高洋取代东魏建立北齐，称文宣皇帝，他是鲜卑化了的汉人，好勇斗狠，连年出兵攻打突厥、契丹等部落，大获全胜。每次临阵作战都身先士卒，不怕牺牲，亲自阻挡敌人的箭和石头，他以骁勇善战而出名"]},{"id":4830,"word":"亲戚朋友","pinyin":"qīn qī péng yǒu","abbr":"qqpy","explanation":"亲人、朋友及姻亲关系等人。","source":{"text":"想着再弄几个钱好打点二舅太爷不生气，也不管亲戚朋友冬天夏天的，人家知道不知道，这么丢脸！","book":"清·曹雪芹《红楼梦》第101回"},"example":{"text":"他们又是直接联系群众的，～、各方面的人听到这些事，人心不安。","book":"邓小平《克服当前困难的办法》"},"similar":["亲戚知己"],"usage":"作主语、宾语、定语；用于人际关系"},{"id":4831,"word":"亲操井臼","pinyin":"qīn cāo jǐng jiù","abbr":"qcjj","explanation":"指亲自料理家务。","source":{"text":"家贫亲老，不择官而仕；亲操井臼，不择妻而娶。","book":"汉·刘向《列女传·周南之妻》"},"example":{"text":"整理门庭，～，总说一句，便是‘勤俭’两个字。","book":"清·文康《儿女英雄传》第二十七回"},"similar":["井臼亲操"],"usage":"作谓语；指亲为"},{"id":4832,"word":"亲昵亡间","pinyin":"qīn nì wú jiàn","abbr":"qnwj","explanation":"亲昵：很亲近；亡：通“无”。形容关系十分密切，没有丝毫隔阂。","source":{"text":"萧望之历位将相，藉师傅之恩，可谓亲昵亡间。及至谋泄隙开，谗邪构之，卒为便嬖宦竖所图，哀哉！","book":"东汉·班固《汉书·萧望之传赞》"},"similar":["亲密无间"],"usage":"作谓语、定语、状语、补语；指关系密切"},{"id":4833,"word":"亲极反疏","pinyin":"qīn jí fǎn shū","abbr":"qjfs","explanation":"亲：亲近；极：顶端；疏：生疏。亲近到了极点反而显得很生疏。","source":{"text":"两个人见了面，只得用浮言劝慰，真真是亲极反疏了。","book":"清·曹雪芹《红楼梦》第八十九回"},"example":{"text":"他在别人面前对她有点矜持，并不是冷淡，而是内心爱她的一种表现。～，大概就是这个意思吧。","book":"周而复《上海的早晨》三十一"},"usage":"作宾语、定语；用于人际关系"},{"id":4834,"word":"亲疏贵贱","pinyin":"qīn shū guì jiàn","abbr":"qsgj","explanation":"亲密、疏远、富贵、贫贱的种种关系。形容地位和关系不同的众人。","source":{"text":"使亲疏贵贱长幼男女之理皆形见予乐。","book":"西汉·司马迁《史记·乐书》"},"example":{"text":"无论～，我们唯才是举。"},"usage":"作宾语、定语；指各种不同身分的人"},{"id":4835,"word":"亲痛仇快","pinyin":"qīn tòng chóu kuài","abbr":"qtck","explanation":"做事不要使自己人痛心，使敌人高兴。指某种举坳只利于敌人，不利于自己。","source":{"text":"凡举事无为亲厚者所痛，而为见仇者所快。","book":"汉·朱浮《与彭宠书》"},"example":{"text":"现在许多人的文章上常常有一句话，说是“无使～”。","book":"毛泽东《和中央社、扫荡报、新民报三记者的谈话》"},"similar":["众叛亲离"],"opposite":["同仇敌忾"],"usage":"作宾语、定语、补语；用于劝诫人","story":["东汉初期，渔阳太守彭宠因帮助刘秀平定王郎之乱而没有被封官，心中不平。幽州牧朱浮前去渔阳征钱粮，彭宠不给，并出兵攻打朱浮。朱浮写信给他不要干出让亲人痛苦仇人快乐的事情。彭宠自称燕王，最后以失败而告终"]},{"id":4836,"word":"亲知把臂","pinyin":"qīn zhī bǎ bì","abbr":"qzbb","explanation":"亲知：亲人和知心朋友；把臂：握人手臂，比喻亲密的朋友。指亲人或知心朋友。","source":{"text":"浩荡别亲知，连翩或征轴。","book":"南朝·齐·谢朓《和王著作八公山》"},"example":{"text":"～他乡少，贫贱论交此地难。","book":"清·洪昇《柬李东琪》"}},{"id":4837,"word":"亲离众叛","pinyin":"qīn lí zhòng pàn","abbr":"qlzp","explanation":"离：离开；叛：背叛。众人反对，亲人背离。形容完全孤立。","source":{"text":"阻兵无众，安忍无亲，众叛亲离，难以济矣。","book":"《左传·隐公四年》"},"example":{"text":"～，自取奔亡。","book":"明·陆贽《翰苑集》卷二十"},"similar":["众叛亲离"],"usage":"作谓语、定语、宾语；指不得人心"},{"id":4838,"word":"亲者痛，仇者快","pinyin":"qīn zhě tòng，chóu zhě kuài","abbr":"qztczk","explanation":"做事不要使自己人痛心，使敌人高兴。指某种举动只利于敌人，不利于自己。","source":{"text":"凡举事无为亲厚者所痛，而为见仇者所快。","book":"汉·朱浮《与彭宠书》"},"example":{"text":"他如今离开咱们，并非前去投敌，岂可因此互相残杀，使～，白白地便宜了朝廷！","book":"姚雪垠《李自成》第一卷第十五章"}},{"id":4839,"word":"亲若手足","pinyin":"qīn ruò shǒu zú","abbr":"qrsz","explanation":"手足：指兄弟。像兄弟一样的亲密。","source":{"text":"欢都、冶诃及劾者、拔达、盆纳五人者，不离左右，亲若手足，元勋之最著者也。","book":"《金史·谢库德》"},"similar":["亲如手足"],"usage":"作谓语、定语；多形容朋友的情谊深"},{"id":4840,"word":"亲贤远佞","pinyin":"qīn xián yuǎn nìng","abbr":"qxyn","explanation":"佞：巧言谄媚的人。亲近有才能的贤人，疏远阿谀奉承的小人。","source":{"text":"尔其尊师重傅，亲贤远佞，非道勿履，非礼勿行。","book":"三国·蜀·诸葛亮《前出师表》：“亲贤臣，远小人，此先汉所以兴隆也；亲小人，远贤臣，此后汉所以倾颓也。”唐·韩愈《顺宗实录》卷三"},"example":{"text":"但愿皇上记着君子、小人之辨，亲贤远佞，那就是天下之福了。”","book":"高阳《慈禧全传》二十四"},"usage":"作谓语、宾语；用于处世"},{"id":4841,"word":"亹亹不倦","pinyin":"wěi wěi bù juàn","abbr":"wwbj","explanation":"亹亹：同“娓娓”，形容说话连续不倦的样子。也指说话、文章十分感人。亦作“亹亹不卷”、“亹亹不厌”。","source":{"text":"调彩葱菁，音韵铿锵，使人味之，亹亹不卷。","book":"梁·钟嵘《诗品》"},"example":{"text":"宋·周煇《清波杂志》：“后徙建康，～。”"},"similar":["亹亹不厌","娓娓不倦"],"usage":"作定语、状语；用于说话等"},{"id":4842,"word":"亹亹不厌","pinyin":"wěi wěi bù yàn","abbr":"wwby","explanation":"亹亹：同“娓娓”。连续说话，不知疲倦。指讲话或文章十分精彩感人。","source":{"text":"若固之序事，不激诡，不抑抚，赡而不秽，详而有体，使读之者，亹亹不厌。","book":"南朝·宋·范晔《后汉书·班固传论》"},"similar":["亹亹不倦"],"usage":"作定语、状语；用于说话等"},{"id":4843,"word":"人一己百","pinyin":"rén yī jǐ bǎi","abbr":"ryjb","explanation":"别人一次就做好或学会的，自己做一百次，学一百次。比喻以百倍的努力赶上别人。","source":{"text":"人一能之，己百之；人十能之，己千之。果能此道矣，虽愚必明，虽柔必强。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"我们在学习上要有～的精神。"},"similar":["笨鸟先飞"],"usage":"作定语；指努力追赶"},{"id":4844,"word":"人丁兴旺","pinyin":"rén dīng xīng wàng","abbr":"rdxw","explanation":"形容子孙后代人很多。","example":{"text":"这一家子真是人丁兴旺。"},"similar":["儿孙满堂"],"opposite":["断子绝孙"],"usage":"作谓语、定语；指子孙后代多"},{"id":4845,"word":"人不为己，天诛地灭","pinyin":"rén bù wèi jǐ，tiān zhū dì miè","abbr":"rbwjtzdm","explanation":"旧时指人不替自己打算，就会为天地所不容。","source":{"text":"这种人的脑筋，浸透着剥削阶级的思想意识，他相信这样的话：‘人不为己，天诛地灭’……他甚至用这一大套剥削阶级的话，来为他的自私自利和个人主义辩护。","book":"刘少奇《论共产党员的修养》"},"example":{"text":"‘～’这份千百年私有制最沉重的遗产，风靡旧世界的腐朽人生哲学，在这里被打碎了。","book":"《花城》1981年第3期"},"usage":"作宾语、定语、分句；指人都是自私的"},{"id":4846,"word":"人不人，鬼不鬼","pinyin":"rén bù rén，guǐ bù guǐ","abbr":"rbrgbg","explanation":"不像人样，也不像鬼样。指人的面目怪异难看。","example":{"text":"她现在这幅～的模样让人害怕。"},"usage":"作定语、分句、状语；指人的模样"},{"id":4847,"word":"人不可貌相","pinyin":"rén bù kě mào xiàng","abbr":"rbkmx","explanation":"不能只根据相貌、外表判断一个人。","source":{"text":"陛下，人不可貌相，海水不可斗量。若爱丰姿者，如何捉得妖贼也？","book":"明·吴承恩《西游记》第六十二回"},"example":{"text":"银匠是小辈，眼孔极浅，见了许多银子，别是一番面目，想到：～，海水不可斗量。","book":"明·冯梦龙《醒世恒言》卷一"},"similar":["人不可貌相，海水不可斗量"],"opposite":["以貌取人"],"usage":"作宾语、分句；指不能以貌取人","story":["古代卖油郎秦重爱上有名的妓女花魁娘子，他很痴情。花魁也很喜欢他，为了筹集一夜十两银子的宿费，他拼命节俭积聚，连银铺的伙计也发感慨真是人不可貌相，海水不可斗量。后来花魁跳出妓院火坑，嫁给秦重做老婆，两人恩爱一辈子"]},{"id":4848,"word":"人不可貌相，海水不可斗量","pinyin":"rén bù kě mào xiàng，hǎi shuǐ bù kě dǒu liáng","abbr":"rbkmxhsbkdl","explanation":"相：估量，评价。指不能以貌取人就像海水不能用斗来量一样。","source":{"text":"别是一番面目，想到：‘人不可貌相，海水不可斗量！’","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"说道：‘真是～。’","book":"清·刘鹗《老残游记》第13回"},"similar":["人不可貌相"],"opposite":["以貌取人"],"usage":"作宾语、分句；用于劝诫人","story":["古代卖油郎秦重爱上有名的妓女花魁娘子，他很痴情。花魁也很喜欢他，为了筹集一夜十两银子的宿费，他拼命节俭积聚，连银铺的伙计也发感慨真是人不可貌相，海水不可斗量。后来花魁跳出妓院火坑，嫁给秦重做老婆，两人恩爱一辈子"]},{"id":4849,"word":"人不犯我，我不犯人","pinyin":"rén bù fàn wǒ，wǒ bù fàn rén","abbr":"rbfwwbfr","explanation":"犯：侵犯。人家不侵犯我，我也不侵犯人家。","source":{"text":"对于国民党军队，应继续采取人不犯我，我不犯人的政策，尽量地发展交朋友的工作。","book":"毛泽东《论政策》"},"example":{"text":"～，人若犯我，我必犯人。"},"usage":"作宾语、定语、分句；指处世准则"},{"id":4850,"word":"人不知鬼不觉","pinyin":"rén bù zhī guǐ bù jué","abbr":"rbzgbj","explanation":"行为诡秘，任何人都没有察觉。","source":{"text":"正经明儿你打发小子问问王太医去，弄点子药吃吃就好了。人不知鬼不觉的可不好？","book":"清·曹雪芹《红楼梦》第31回"}},{"id":4851,"word":"人不知，鬼不觉","pinyin":"rén bù zhī，guǐ bù jué","abbr":"rbzgbj","explanation":"形容事情做得很秘密，没有被人发觉。","source":{"text":"您做事可甚人不知鬼不觉。","book":"元·无名氏《争报恩》第一折"},"example":{"text":"依我们的好话，快快收了这样子，倒是～的去罢。","book":"清·曹雪芹《红楼梦》第七十七回"},"similar":["不知不觉","神不知，鬼不觉"],"opposite":["尽人皆知"],"usage":"作分句、状语；指十分隐蔽"},{"id":4852,"word":"人不聊生","pinyin":"rén bù liáo shēng","abbr":"rbls","explanation":"聊：依赖，凭借。指老百姓无法生活下去。","source":{"text":"民疲士苦，人不聊生。","book":"《吴越春秋·勾践阴谋外传》"},"example":{"text":"是岁大旱，河水尽涸，野草自焚，牛马十死八九，～。","book":"《元史·定宗纪》"},"similar":["民不聊生"],"usage":"作谓语、定语、状语；指社会腐败"},{"id":4853,"word":"人不自安","pinyin":"rén bù zì ān","abbr":"rbza","explanation":"人心惶惶，动摇不定。","source":{"text":"于是上下震局，人不自安，虽忠诚亲戚，亦佥怀离贰。","book":"《魏书·慕容盛传》"},"example":{"text":"于是内外恐惧，～，皆求苟免，莫有固志，重足累息，以逮子终。","book":"《周书·宣帝纪》"},"usage":"作谓语、定语、状语；用于社会局势"},{"id":4854,"word":"人世沧桑","pinyin":"rén shì cāng sāng","abbr":"rscs","explanation":"比喻人间世事变化很大。","example":{"text":"几十年来本地发生了巨变，每回首往昔都有～之感。"}},{"id":4855,"word":"人中之龙","pinyin":"rén zhōng zhī lóng","abbr":"rzzl","explanation":"人中豪杰。比喻出类拔萃的人。","source":{"text":"吾而今而后知先生人中之龙也。","book":"《晋书·宋纤传》"},"example":{"text":"叔宝乃～，龙到处自然有水，他怎么得一寒至此。","book":"清·禇人获《隋唐演义》第九回"},"similar":["人中龙虎"],"usage":"作宾语；指人中豪杰","story":["晋代人宋纤厌恶官场生活，立志不参与政事，过着隐居生活。当地太守马岌仰慕他的人品，特地去请他出来做官。宋纤猜到马岌的来意，立即关门拒见。马岌认为宋纤能不为高官厚禄所动，洁身自好，清贫自守，感慨地称他是人中之龙"]},{"id":4856,"word":"人中狮子","pinyin":"rén zhōng shī zǐ","abbr":"rzsz","explanation":"像狮子是兽中之王那样。比喻才能出众的人。","source":{"text":"天竺大乘沙门佛陀斯那天才特拔，诸国独步，内外综博，无籍不练，世人咸曰人中狮子。","book":"《释氏要览》"},"similar":["人中骐骥"],"usage":"作宾语、定语；用于书面语"},{"id":4857,"word":"人中豪杰","pinyin":"rén zhōng háo jié","abbr":"rzhj","explanation":"指才智勇力出众的人。","source":{"text":"三位将军，乃人中豪杰，志冲牛斗，气吐凌云。","book":"明·无名氏《赵匡胤打董达》第五折"},"example":{"text":"清·钱彩《说岳全传》第24回：“那岳统制真是个～，盖世英雄。”"},"similar":["英雄豪杰"],"usage":"作主语、宾语；用于夸奖人"},{"id":4858,"word":"人中骐骥","pinyin":"rén zhōng qí jì","abbr":"rzqj","explanation":"骐骥：良马。比喻才能出众的人。","source":{"text":"此所谓人中骐骥，必能致千里。","book":"《南史·徐勉传》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“天上石麟，夸小儿之迈众；～，比君子之超凡。”"},"similar":["人中狮子"],"usage":"作宾语、定语；用于书面语","story":["南朝时期，徐勉自幼成了孤儿，家里也很穷，但他好学，六岁时就能写文章，成年后更加好学不知疲倦，在文学上少有成就。族人赞叹他说：“这就是所谓的人中骐骥，必将日行千里。”"]},{"id":4859,"word":"人中龙虎","pinyin":"rén zhōng lóng hǔ","abbr":"rzlh","explanation":"比喻人中豪杰。","source":{"text":"吾而今而后知先生人中之龙也。","book":"《晋书·宋纤传》"},"example":{"text":"不枉了女中丈夫，～。","book":"明·张凤翼《红拂记·侠女私奔》"},"similar":["人中之龙"],"usage":"作宾语；指人中豪杰"},{"id":4860,"word":"人为刀俎，我为鱼肉","pinyin":"rén wéi dāo zǔ，wǒ wéi yú ròu","abbr":"rwdzwwyr","explanation":"刀俎：刀和刀砧板，宰割的工具。比喻生杀的权掌握在别人手里，自己处在被宰割的地位。","source":{"text":"如今人方为刀俎，我为鱼肉。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"还不是～，寄人篱下的日子究竟到了什么时候为止？","book":"朱道南《在大革命的洪流中》"},"similar":["任人宰割"],"usage":"作定语、分句；指处于被动局面","story":["楚汉相争时，项羽屯兵40万在新丰鸿门，谋士范增设计要除掉刘邦。刘邦依约赴鸿门宴，范增请项庄舞剑助兴，意图杀害刘邦。张良叫来樊哙，刘邦借上厕所的机会与樊哙商议如何逃走，樊哙说：“如今人方为刀俎，我为鱼肉，何辞为？”"]},{"id":4861,"word":"人为财死，鸟为食亡","pinyin":"rén wèi cái sǐ，niǎo wèi shí wáng","abbr":"rwcsnwsw","explanation":"旧时俗语。意思是为了追求金钱，连生命都可以不要。","source":{"text":"俗话说得好：‘人为财死，鸟为食亡。’当时袁伯珍听得这些说话，便要从此发一宗洋财。","book":"清·李宝嘉《官场现形记》第13回"},"example":{"text":"～”，我就知道他会这样做","book":"俗话说"},"similar":["人不为己，天诛地灭"],"opposite":["大公无私"],"usage":"作宾语、定语、分句；可分开使用"},{"id":4862,"word":"人之云亡","pinyin":"rén zhī yún wáng","abbr":"rzyw","explanation":"人：贤人；云：助词；亡：失去。贤人死亡了。旧时用来怀念那些身系国家安危的贤人。","source":{"text":"人之云亡，邦国殄瘁。","book":"《诗经·大雅·瞻仰》"},"example":{"text":"～，峤实当之。","book":"《晋书·温峤传》"}},{"id":4863,"word":"人之云亡，邦国殄瘁","pinyin":"rén zhī yún wáng，bāng guó tiǎn cuì","abbr":"rzywbgtc","explanation":"人：贤人；云：助词；亡：失去；殄瘁：病困。贤人死亡了，国事危殆。旧时用来怀念那些身系国家安危的贤人。","source":{"text":"人之云亡，邦国殄瘁。","book":"《诗经·大雅·瞻仰》"},"example":{"text":"～。吾既不复能言，安用此默默生乎！","book":"《晋书·刘聪载记》"}},{"id":4864,"word":"人之将死，其言也善","pinyin":"rén zhī jiāng sǐ，qí yán yě shàn","abbr":"rzjsqyys","explanation":"人到临死，他说的话是真心话，是善意的。","source":{"text":"鸟之将死，其鸣也哀；人之将死，其言也善。","book":"春秋·鲁·孔丘《论语·泰伯》"},"example":{"text":"～，她的话不无道理。"},"usage":"作宾语、分句；指人临死时的话"},{"id":4865,"word":"人之常情","pinyin":"rén zhī cháng qíng","abbr":"rzcq","explanation":"一般人通常有的感情。","source":{"text":"又贵远贱近，人心向背；重耳轻目，俗之恒弊。","book":"南朝·粱·江淹《杂体诗三十八首·序》"},"example":{"text":"慕富贵者，～也。","book":"明·赵弼《赵氏伯仲友义传》"},"similar":["入情入理","天经地义","人情世故"],"opposite":["不尽人情"],"usage":"作主语、宾语；用于人"},{"id":4866,"word":"人之水镜","pinyin":"rén zhī shuǐ jìng","abbr":"rzsj","explanation":"人间的水和镜子，可以照清人的形象。比喻十分精明又通晓整理的人。","source":{"text":"此人，人之水镜也，见之若披云雾睹青天也。","book":"南朝·宋·刘义庆《世说新语·德行》"}},{"id":4867,"word":"人之相知，贵相知心","pinyin":"rén zhī xiāng zhī，guì xiāng zhī xīn","abbr":"rzxzgxzx","explanation":"人们的互相了解，最可贵的是了解对方的内心世界。指朋友相交要知心。","source":{"text":"嗟夫子卿，人之相知，贵相知心。","book":"汉·李陵《答苏武书》"},"example":{"text":"～。对于李季同志，我不敢说是相知，更不敢说是知己。","book":"孙犁《夜思》"}},{"id":4868,"word":"人事不省","pinyin":"rén shì bù xǐng","abbr":"rsbx","explanation":"指昏迷不醒，失去知觉。","source":{"text":"谁想刘璞因冒风之后，出汗虚了，变为寒症，人事不省，十分危笃。","book":"《醒世恒言·乔太守乱点鸳鸯谱》"},"example":{"text":"周婶子和同院的女人把玉宝妈从地下抬到草垫子上，她已经～了。","book":"高玉宝《高玉宝》第十三章"},"similar":["人事不醒","不省人事","人事不知"],"usage":"作谓语、定语、宾语；形容丧失知觉"},{"id":4869,"word":"人事不知","pinyin":"rén shì bù zhī","abbr":"rsbz","explanation":"指昏迷不醒，失去知觉。同“人事不省”。","source":{"text":"宝钗哭得人事不知。","book":"《红楼梦》第一二○回"},"example":{"text":"刚才给他们两个人往空中一抛，重重地落在石板地上，他头昏眼花，～。","book":"周而复《上海的早晨》第一部四"},"similar":["人事不省","人事不醒"],"usage":"作谓语、定语、状语；形容丧失知觉"},{"id":4870,"word":"人事不醒","pinyin":"rén shì bù xǐng","abbr":"rsbx","explanation":"指昏迷不醒，失去知觉。同“人事不省”。","source":{"text":"有一位同志，是渔船救起来的，三天三夜人事不醒。","book":"杨朔《晚凉天》"},"example":{"text":"我还没糊涂到～的地步。"},"similar":["不省人事"],"usage":"作谓语、定语、宾语；形容丧失知觉"},{"id":4871,"word":"人事代谢","pinyin":"rén shì dài xiè","abbr":"rsdx","explanation":"代谢：更迭，交替。泛指人世间的事新旧交替。","source":{"text":"人事有代谢，往来成古今。","book":"唐·孟浩然《与诸子登岘山》诗"},"example":{"text":"～是很正常的事情。"},"similar":["新陈代谢"],"usage":"作宾语、定语；指人事变化","story":["唐代诗人孟浩然隐居在襄阳鹿门山，40岁到长安考进士未遂，只好再度过隐居生活。他渴求一官半职而不能如愿，心中有怀才不遇之感在《与诸子登岘山》诗中体现：“人事有代谢，往来成古今。江山留胜迹，我辈复登临。水落鱼梁浅，天寒梦泽深。”"]},{"id":4872,"word":"人事无常","pinyin":"rén shì wú cháng","abbr":"rswc","explanation":"人间事变化不定。","example":{"text":"于是在无事可为的寂寞的微闷而外，又添上了～的悲哀，以及热痒痒地渴想新奇刺激的焦灼。","book":"茅盾《子夜》第十七章"}},{"id":4873,"word":"人云亦云","pinyin":"rén yún yì yún","abbr":"ryyy","explanation":"云：说；亦：也。人家怎么说，自己也跟着怎么说。指没有主见，只会随声附和。","source":{"text":"槽床过竹春泉句，他日人云吾亦云。","book":"金·蔡松年《槽声同彦高赋》诗"},"example":{"text":"刊物内容如果只是“～”，格式如果只是“亦步亦趋”，那是刊物的尾巴主义。","book":"邹韬奋《经历·几个原则》"},"similar":["随声附和","拾人牙慧"],"opposite":["自成一家","直言不讳"],"usage":"作谓语、定语、状语；指没有主见"},{"id":4874,"word":"人五人六","pinyin":"rén wǔ rén liù","abbr":"rwrl","explanation":"装模作样，假正经。","source":{"text":"别看那小子装得五讲四美、人五人六的样儿，其实一肚子男盗女娼，背着人嘴脏着呢。","book":"王朔《枉然不供》"},"example":{"text":"瞧她那～的样子，就知道她心虚。"},"similar":["装模作样"],"opposite":["一本正经"],"usage":"作谓语、定语；指假正经"},{"id":4875,"word":"人亡家破","pinyin":"rén wáng jiā pò","abbr":"rwjp","explanation":"家庭破产，人口死亡。形容家遭不幸的惨相。","source":{"text":"会琨为段匹磾所害，峤表琨忠诚，虽勋业不遂，然家破人亡，宜在褒崇，以慰海内之望。","book":"《晋书·温峤传》"},"example":{"text":"枉了你修福利，送的教～，瓦解星飞。","book":"元·礼文卿《东窗事犯》第二折"},"similar":["家破人亡"],"opposite":["人丁兴旺"],"usage":"作定语、状语；指家遭不幸"},{"id":4876,"word":"人亡政息","pinyin":"rén wáng zhèng xī","abbr":"rwzx","explanation":"亡：失去，死亡；息：废，灭。旧指一个掌握政权的人死了，他的政治措施也跟着停顿下来。","source":{"text":"文武之政，布在方策。其人存，则其政举；其人亡，则其政息。","book":"《礼记·中庸》"},"example":{"text":"就令当局者果然高尚纯洁，不过变名的圣君贤相，结果还会落得个～。","book":"清·梁启超《外交欤内政欤》"},"opposite":["人存政举"],"usage":"作谓语、补语；用于行政"},{"id":4877,"word":"人亡物在","pinyin":"rén wáng wù zài","abbr":"rwwz","explanation":"人死了，东西还在。指因看见遗物而引起对死者的怀念，或因此而引起的感慨。","source":{"text":"物在人亡空有泪，时殊事变独伤心。","book":"宋·曾会《重登潇湘楼》诗"},"similar":["睹物思人"],"usage":"作谓语、宾语；指看见遗物而怀念死者"},{"id":4878,"word":"人亡邦瘁","pinyin":"rén wáng bāng cuì","abbr":"rwbc","explanation":"指贤者不在位，国家因而衰败。","source":{"text":"贤人皆言奔亡，则天下邦国，将尽困穷。","book":"《诗·大雅·瞻卬》：“人之云亡，邦国殄瘁。”毛传：“殄，尽；瘁，病也。”郑玄笺"},"example":{"text":"李光《赠稚兰》诗：“神憎鬼瞰知君忿，～知君恼。”"},"usage":"作宾语、定语；用于书面语"},{"id":4879,"word":"人亲骨肉香","pinyin":"rén qīn gǔ ròu xiāng","abbr":"rqgrx","explanation":"比喻关系十分密切，感情深厚。","source":{"text":"朕自涿郡与卿等之父结异姓之交，亲如骨肉；今汝二人亦是昆仲之分，正当同心协力，共报父仇；奈何自相争竞，失其大义！","book":"明·罗贯中《三国演义》第八十一回"}},{"id":4880,"word":"人人得而诛之","pinyin":"rén rén dé ér zhū zhī","abbr":"rrdezz","explanation":"得：可以，能够；诛：杀死。所有的人都可以杀死他。极言某人罪大恶极。","source":{"text":"为不善乎显明之中者，人得而诛之。","book":"《庄子·庚桑楚》"},"usage":"作宾语、定语；用于书面语"},{"id":4881,"word":"人人有分","pinyin":"rén rén yǒu fèn","abbr":"rryf","explanation":"每个人都有一份。","source":{"text":"人人尽有分，因什么道不得。","book":"宋·释道原《景德传灯录》卷八"},"example":{"text":"不要闹，不要闹！仍旧开门发米，～，不过一定要守秩序，队伍不排齐，我不开门。","book":"高阳《草莽英雄》第三章"}},{"id":4882,"word":"人人皆知","pinyin":"rén rén jiē zhī","abbr":"rrjz","explanation":"皆：都。所有的人都知道。","source":{"text":"老少男女，俗语口头，人人皆知皆说的。","book":"清·曹雪芹《红楼梦》第51回"},"example":{"text":"～以多胜少是最好的办法。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["家喻户晓"],"opposite":["默默无闻","鲜为人知"],"usage":"作谓语、定语、状语；指所有人都知道"},{"id":4883,"word":"人人自危","pinyin":"rén rén zì wēi","abbr":"rrzw","explanation":"每个人都感到自己不安全，有危险。","source":{"text":"法令诛罚，日益深刻，群臣人人自危，欲畔者众。","book":"《史记·李斯列传》"},"example":{"text":"满京城的戚畹、勋旧和缙绅们为着李国瑞的事～，家家惊慌。","book":"姚雪垠《李自成》第二卷第三十章"},"similar":["人心惶惶","提心吊胆"],"opposite":["高枕无忧","安居乐业"],"usage":"作谓语、宾语、定语、补语；指危机大","story":["秦始皇带自己小儿子胡亥去会稽游玩途中病故，赵高与李斯合谋篡改诏书，赐死公子扶苏，让胡亥继位为秦二世。赵高任郎中令，他鼓动秦二世实行严刑酷法，把功臣及皇兄皇妹们全部杀绝，弄得朝野上下一片恐怖，人人自危"]},{"id":4884,"word":"人以群分","pinyin":"rén yǐ qún fēn","abbr":"ryqf","explanation":"人按照其品行、爱好而形成团体，因而能互相区别。指好人总跟好人结成朋友，坏人总跟坏人聚在一起。","source":{"text":"方以类聚，物以群分，吉凶生矣。","book":"《周易·系辞上》"},"example":{"text":"俗话说：～，我们不是一条道上的。"},"similar":["物以类聚"],"usage":"作宾语、定语；常与“物以类聚”连用","story":["战国时期，齐宣王要辩士淳于髡推荐贤士，他一天就推荐七个，宣王感到惊讶，问是不是在滥竽充数。淳于髡说：“鸟有鸟类，兽有兽类。只能到山上才能采到柴胡，这就是物各有类，我经常与贤人打交道，因此可以为您推荐更多的贤人。”"]},{"id":4885,"word":"人仰马翻","pinyin":"rén yǎng mǎ fān","abbr":"rymf","explanation":"人马被打得仰翻在地。形容被打得惨败。也比喻乱得一塌糊涂，不可收拾。","source":{"text":"贾琏家下无人，请了王仁来在外帮着料理。那巧姐儿是日夜哭母，也是病了。所以荣府中又闹得马仰人翻。","book":"清·曹雪芹《红楼梦》第一百十五回"},"example":{"text":"这么晴朗的天气，天空是湛蓝湛蓝的，真不象双方就要杀得～！","book":"姚雪垠《李自成》第二卷第二十六章"},"similar":["落花流水","溃不成军"],"opposite":["人强马壮"],"usage":"作谓语、定语、补语；指失败"},{"id":4886,"word":"人众胜天","pinyin":"rén zhòng shèng tiān","abbr":"rzst","explanation":"聚集众人的力量，可以战胜大自然。","source":{"text":"吾闻之，人众者胜天，天定亦能破人。","book":"《史记·伍子胥列传》"},"usage":"作宾语、定语；用于书面语"},{"id":4887,"word":"人伦并处","pinyin":"rén lún bìng chǔ","abbr":"rlbc","explanation":"人伦：各类人。各种各样的人生活在一起。比喻什么样的人都有。","source":{"text":"人伦并处，同求也异道，同欲而异知，生也。","book":"《荀子·富国》"}},{"id":4888,"word":"人似秋鸿","pinyin":"rén sì qiū hóng","abbr":"rsqh","explanation":"鸿：大雁。人好像秋天的大雁一样。比喻朋友间守信用，就像鸿雁每年秋天按时从北方飞到南方那样。","source":{"text":"人似秋鸿来有信，事如春梦了无痕。","book":"宋·苏轼《正月二十日与潘郭二生出郊寻春，忽记去年是日同至女王城作诗，乃和前韵》"},"example":{"text":"～无定住，事如飞弹须园熟。笑君侯、陪酒又陪歌，阳春曲。","book":"宋·辛弃疾《满江红》词"}},{"id":4889,"word":"人何以堪","pinyin":"rén hé yǐ kān","abbr":"rhyk","explanation":"堪：忍受。人怎么能忍受得了。表示人在感情或力量等方面已经到了不能忍受的地步。","source":{"text":"木犹如此，人何以堪。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"急赋系役，～？","book":"唐·陆贽《冬至大礼大赦制》"}},{"id":4890,"word":"人凭志气虎凭威","pinyin":"rén píng zhì qì hǔ píng wēi","abbr":"rpzqhpw","explanation":"人靠的是志气，老虎凭的是威风。形容人必须有志气才能成就一番事业。"},{"id":4891,"word":"人前背后","pinyin":"rén qián bèi hòu","abbr":"rqbh","explanation":"当着人背着人。当面一套背后一套。","source":{"text":"君子周而不比，周是遍，人前背后都如此。","book":"宋·朱熹《朱子语类·论语六》"},"example":{"text":"那老货在的时候，～，一直骂我是骚货。","book":"叶兆言《走进夜晚》第三章"},"similar":["人前人后"],"usage":"作状语；用于为人处世"},{"id":4892,"word":"人千人万","pinyin":"rén qiān rén wàn","abbr":"rqrw","explanation":"形容人多。","source":{"text":"侍者看了一回，人千人万，乱滚滚的。","book":"明·冯梦龙《警世通言》卷二十八"},"example":{"text":"这些来考的众举子，并那看的人，真个～。","book":"清·钱彩《说岳全传》第十二回"}},{"id":4893,"word":"人单势孤","pinyin":"rén dān shì gū","abbr":"rdsg","explanation":"指人数少，力量单薄。","source":{"text":"劫牢之后，倘若登州兵马杀来，我等人单势孤，只怕寡不敌众。","book":"京剧《猎虎记》第十场"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“自己～，又在陌生地方，必然吃亏。”"},"similar":["势单力薄"],"usage":"作谓语、定语、宾语；用于人的处境等"},{"id":4894,"word":"人去楼空","pinyin":"rén qù lóu kōng","abbr":"rqlk","explanation":"人已离去，楼中空空。比喻故地重游时睹物思人的感慨。","source":{"text":"昔人已乘黄鹤去，此地空余黄鹤楼，黄鹤一去不复返，白云千载空悠悠。","book":"唐·崔颢《黄鹤楼》诗"},"example":{"text":"女主人公孤零零地消失在凄清的寒夜里，那种～的惆怅感觉一直折磨着我。","book":"巴金《随想录·在尼斯》"},"similar":["触景生情","人面桃花"],"opposite":["久居故里"],"usage":"作谓语、定语；指思念故人"},{"id":4895,"word":"人取我与","pinyin":"rén qǔ wǒ yǔ","abbr":"rqwy","explanation":"取：拿；与：给。指商人囤积物资，待时出售以获厚利。","source":{"text":"当魏文侯时，李克务尽地力，而白圭乐观时变，故人弃我取，人取我与。","book":"西汉·司马迁《史记·货殖列传》"},"example":{"text":"我们要采取～的方针，及时清理库存。"},"opposite":["人弃我取"],"usage":"作谓语、定语；指待时出售以获厚利","story":["战国时期，魏文侯任用李悝为相国，厉行改革，加强统治。李悝从商人白圭的经商原则“人弃我取，人取我与”中得到启发，在经济改革中实行保护农民利益和发展农业生产的“平籴”法，从而使国家干预与调节经济，使魏国富强"]},{"id":4896,"word":"人各有志","pinyin":"rén gè yǒu zhì","abbr":"rgyz","explanation":"指每个人各自有不同的志向愿望，不能勉为其难。","source":{"text":"人生各有志，终不为此移，同知埋身剧，心亦有所施。","book":"汉·王粲《咏史诗》"},"example":{"text":"此乃～，志各不同。大抵名公夙成蕴藉，非俺辈所能深知。","book":"明·无心子《金雀记·投笺》"},"similar":["人心如面","出处异趣"],"opposite":["人同此心","人心所趋"],"usage":"作宾语、分句；指人有不同的志向"},{"id":4897,"word":"人各有能有不能","pinyin":"rén gè yǒu néng yǒu bù néng","abbr":"rgynybn","explanation":"人人都有做得了做不了的事。比喻人的才能智慧总是各有长短。","source":{"text":"固辞不能，子使余也，人各有能有不能。","book":"《左传·定公五年》"},"example":{"text":"抑～也？读者观欧、秦之诗远不如词，足透此中消息。","book":"清·王国维《人间词话》"}},{"id":4898,"word":"人同此心","pinyin":"rén tóng cǐ xīn","abbr":"rtcx","explanation":"大家对某事有相同的看法。","source":{"text":"欲贵者，人之同心也。","book":"《孟子·告子上》"}},{"id":4899,"word":"人同此心，心同此理","pinyin":"rén tóng cǐ xīn，xīn tóng cǐ lǐ","abbr":"rtcxxtcl","explanation":"指合情合理的事，大家想法都会相同。","source":{"text":"欲贵者，人之同心也。","book":"《孟子·告子上》"},"example":{"text":"俗话说的：“～”。若说照安公子这等人物，她还看不入眼，这眼界也就太高了，不是情理。（清·文康《儿女英雄传》第九回）"},"usage":"作宾语、分句；指有相同观点"},{"id":4900,"word":"人君犹盂","pinyin":"rén jūn yóu yú","abbr":"rjyy","explanation":"盂：盛水的容器。君主好比是盛水的盂，人民好比是盂里的水，盂是什么形状，水就是什么形状。比喻人民的习俗随君主的好恶而变化。","source":{"text":"孔子曰：‘为人君者，犹盂也，民犹水也。盂方水方，盂圜水圜。’","book":"《韩非子·外储说左上》"}},{"id":4901,"word":"人命关天","pinyin":"rén mìng guān tiān","abbr":"rmgt","explanation":"关天：比喻关系重大。指有关人命的事情关系及重大。","source":{"text":"人命关天，分甚么首从。","book":"元·无名氏《杀狗劝夫》第四折"},"example":{"text":"这是～的大事，千万不能大意。"},"similar":["非同小可"],"opposite":["无关宏旨","无足轻重","草菅人命"],"usage":"作主语、宾语、定语、补语；用于强调"},{"id":4902,"word":"人命危浅","pinyin":"rén mìng wēi qiǎn","abbr":"rmwq","explanation":"浅：时间短。形容寿命不长，即将死亡。","source":{"text":"但以刘日薄西山，气息奄奄，人命危浅，朝不虑夕。","book":"晋·李密《陈情表》"},"example":{"text":"其余部分，也已日薄西山，气息奄奄，～，朝不虑夕，快进博物馆了。","book":"毛泽东《新民主主义论》"},"similar":["日薄西山","气息奄奄"],"opposite":["朝气蓬勃"],"usage":"作宾语、定语、补语；指即将死亡"},{"id":4903,"word":"人喊马叫","pinyin":"rén hǎn mǎ jiào","abbr":"rhmj","explanation":"人喊叫，马嘶鸣。形容喧闹的情景。","source":{"text":"人语马嘶听不得，更堪长路在云中。","book":"唐·卢纶《送韦判官得雨中山》"},"example":{"text":"一时间，山顶上旗帜林立，烟雾腾腾，～，好似有千军万马。","book":"王运朝《井冈风云录》第二部十"}},{"id":4904,"word":"人喊马嘶","pinyin":"rén hǎn mǎ sī","abbr":"rhms","explanation":"人喊叫，马嘶鸣。形容纷乱扰攘或热闹欢腾的情景。","source":{"text":"人语马嘶听不得，更堪长路在云中。","book":"唐·卢纶《送韦判官得雨中山》"},"example":{"text":"只听得外面喧嚷，似有～之声，渐渐近前堂来了。","book":"明·凌濛初《二刻拍案惊奇》卷十四"},"similar":["人欢马叫"],"opposite":["人困马乏"],"usage":"作谓语、定语；形容一片喧闹的景象"},{"id":4905,"word":"人困马乏","pinyin":"rén kùn mǎ fá","abbr":"rkmf","explanation":"人马都很疲乏。形容旅途劳累。","source":{"text":"俺这两口儿三日不曾吃饮食，人困马乏。","book":"元·黄元吉《流星马》第三折"},"example":{"text":"马步三军没了气力，～。","book":"明·施耐庵《水浒全传》第七十七回"},"similar":["精疲力竭","风尘仆仆"],"opposite":["精神十足","生龙活虎"],"usage":"作谓语、宾语、定语；形容人的疲劳"},{"id":4906,"word":"人在人情在","pinyin":"rén zài rén qíng zài","abbr":"rzrqz","explanation":"人活着时亲朋好友讲情谊，人死了亲友就不讲情谊了。指人情淡薄。","source":{"text":"后来秦凤自焚身死，秦母亦相继而亡，所有子孙不知娘娘是何等人。所谓‘人在人情在、人亡两无交’。","book":"清·石玉昆《三侠五义》第十五回"},"example":{"text":"～。我们老爷又不是上海道的甚么顶门上司，不过是隔省的一个同寅。","book":"清·李宝嘉《官场现形记》第十一回"}},{"id":4907,"word":"人地两生","pinyin":"rén dì liǎng shēng","abbr":"rdls","explanation":"初到一地对当地的人与环境、习俗等不熟悉。","example":{"text":"我来到一个～的城市过上新生活。"},"similar":["人地生疏","人生地不熟"],"opposite":["熟门熟路"],"usage":"作谓语、宾语、定语；指不熟悉环境"},{"id":4908,"word":"人地生疏","pinyin":"rén dì shēng shū","abbr":"rdss","explanation":"人事不熟，地方陌生。指初到一地，对当地的人事和地理都不熟悉。","source":{"text":"这里人地生疏，样样不贵。","book":"清·吴趼人《情变》第六回"},"example":{"text":"《自由谈》的编辑新换了黎烈文先生了，但他才从法国回来，～，怕一时搞不起稿子，要我去投几回稿。","book":"鲁迅《伪自由书·前记》"},"similar":["举目无亲","人地两生"],"opposite":["轻车熟路"],"usage":"作谓语、宾语、分句；指不熟悉环境"},{"id":4909,"word":"人声鼎沸","pinyin":"rén shēng dǐng fèi","abbr":"rsdf","explanation":"鼎：古代煮食器；沸：沸腾。形容人群的声音吵吵嚷嚷，就象煮开了锅一样。","source":{"text":"一日午后，刘方在店中收拾，只听得人声鼎沸。","book":"明·冯梦龙《醒世恒言》卷十"},"example":{"text":"广场这时已是一片锣鼓喧天，～。"},"similar":["人欢马叫","震耳欲聋"],"opposite":["万籁俱寂","鸦雀无声"],"usage":"作谓语、宾语、定语；比喻人声嘈杂"},{"id":4910,"word":"人多势众","pinyin":"rén duō shì zhòng","abbr":"rdsz","explanation":"声势力量大。","source":{"text":"话说金荣因人多势众，又兼贾瑞勒令赔了不是，给秦钟磕了头，宝玉方才不吵闹了。","book":"清·曹雪芹《红楼梦》第十回"},"example":{"text":"第三派可～，这伙人咬牙发狠地极力肯定，说他是在闹左道邪门。","book":"康濯《三面宝镜》"},"similar":["万众一心","众人拾柴火焰高"],"opposite":["势单力薄","单枪匹马"],"usage":"作谓语、宾语；形容人多势力强大","story":["大观园里贾宝玉一人上学觉得孤单寂寞，见到秦可卿的弟弟秦钟后，就请贾母批准他们一起上学，秦钟出身贫寒，刚到学校就被薛蟠一班狐朋狗友戏弄，金荣欺负秦钟，贾宝玉立即叫贾瑞勒令他给秦钟磕头，金荣见他们人多势众，就只有磕头了"]},{"id":4911,"word":"人多口杂","pinyin":"rén duō kǒu zá","abbr":"rdkz","explanation":"指谈论的人多，各种议论都有。","source":{"text":"宁府人多口杂，那些不得志的奴仆们耑能造言诽谤主人。","book":"《脂砚斋重评石头记》第九回"},"example":{"text":"在～的地方，我就尽可能的少作些引人注目的行为。","book":"夏衍《谈自己》"},"similar":["人多嘴杂"],"opposite":["众口一词"],"usage":"作谓语、定语；指各种说法都有"},{"id":4912,"word":"人多嘴杂","pinyin":"rén duō zuǐ zá","abbr":"rdzz","explanation":"杂：杂乱，多种多样。谈论的人多，说法多种多样。也指在场的人多，七嘴八舌。","source":{"text":"闺臣恐人多嘴杂，说话不便，即同良箴、红蕖、紫绡另在一房居住。","book":"清·李汝珍《镜花缘》第五十九回"},"example":{"text":"他们这里～，说好话的人少，说歹话的人多。","book":"清·曹雪芹《红楼梦》第五十七回"},"similar":["人多口杂","七嘴八舌"],"usage":"作谓语、定语；指议论很多"},{"id":4913,"word":"人多成王","pinyin":"rén duō chéng wáng","abbr":"rdcw","explanation":"人多势力大就可以当首领。","source":{"text":"人多成王，怕他什么？","book":"明·罗懋登《三保太监下西洋记》第七十七回"},"example":{"text":"你们不说他坏，八路就认得他？～，这道理明白不明白？","book":"丁玲《太阳照在桑干河上》四十三"}},{"id":4914,"word":"人多手乱","pinyin":"rén duō shǒu luàn","abbr":"rdsl","explanation":"指动手的人多。也指人头杂的场合，东西容易散失或丢失。","source":{"text":"这话也说的有理。现在人多手乱，鱼龙混杂，倒是这么一来，你们也洗洗清。","book":"清·曹雪芹《红楼梦》第九十四回"},"example":{"text":"只是自己没有收得，想是当时事情仓卒，～，不知弄到谁人手里。","book":"表·黄小配·廿载繁华梦》第四十回"}},{"id":4915,"word":"人多手杂","pinyin":"rén duō shǒu zá","abbr":"rdsz","explanation":"指动手的人多。也指人头杂的场合，东西容易散失或丢失。","source":{"text":"老太太屋里还罢了，太太屋里人多手杂，别人还可已，那个主儿的一伙子人见是这屋里的东西，又该使黑心弄坏了才罢。","book":"清·曹雪芹《红楼梦》第三十七回"},"example":{"text":"那些～的，已将黄人瑞箱笼行李都搬出来放在东墙脚下。","book":"清·刘鹗《老残游记》第十五回"},"usage":"作谓语、定语；用于口语"},{"id":4916,"word":"人多智广","pinyin":"rén duō zhì guǎng","abbr":"rdzg","explanation":"人多智慧也多。用来强调人多出智慧。","example":{"text":"怕什么？～，又有老公公当军师，今天哪，我们一定要对赢三姐！","book":"黄梅戏《刘三姐·二》"}},{"id":4917,"word":"人多语乱","pinyin":"rén duō yǔ luàn","abbr":"rdyl","explanation":"乱：杂乱，多种多样。谈论的人多，说法多种多样。也指在场的人多，七嘴八舌。","source":{"text":"人多语乱，说不分明。小姐只得自走到堂后来观看。","book":"明·明教中人《好逑传》第五回"}},{"id":4918,"word":"人多阙少","pinyin":"rén duō què shǎo","abbr":"rdqs","explanation":"指求官职的人多而空额少。阙，旧时指官职的空额。"},{"id":4919,"word":"人天永隔","pinyin":"rén tiān yǒng gé","abbr":"rtyg","explanation":"人天：人间、天上，指生死。生者还在人间，死者已归天，从此永久分离再不能相见。哀悼死者之辞。","example":{"text":"现在体仁和银屏都死了，与世人已经～，全家开始回想他俩的好处。","book":"林语堂《京华烟云》第二十五章"}},{"id":4920,"word":"人头畜鸣","pinyin":"rén tóu chù míng","abbr":"rtcm","explanation":"鸣：叫。这是骂人的话，指虽然是人，但象畜类一样愚蠢。也比喻人的行为非常恶劣。","source":{"text":"（胡亥）诛（李）斯、（冯）去疾，任用赵高。痛哉言乎！人头畜鸣。","book":"《史记·秦始皇本纪》"},"example":{"text":"是真吾弟之乱命也，其将谓我～者耶？","book":"清·蒲松龄《聊斋志异·素秋》"},"similar":["行同狗彘"],"usage":"作宾语、分句；指人无耻"},{"id":4921,"word":"人如潮涌","pinyin":"rén rú cháo yōng","abbr":"rrcy","explanation":"人像潮水般涌来。形容人很多而且拥挤。","source":{"text":"说言未了，只见人如潮涌，却早十数对哨棒过来，前面列着四把绣旗。","book":"明·施耐庵《水浒传》第74回"},"similar":["人山人海"],"usage":"作谓语、宾语、定语；用于公众场合"},{"id":4922,"word":"人妖颠倒","pinyin":"rén yāo diān dǎo","abbr":"rydd","explanation":"妖：妖魔鬼怪。人与鬼颠倒。比喻是非颠倒，好坏不分。","source":{"text":"鬼便遂归，作其父形，且语其家：‘二儿已杀妖矣。’儿暮归，共相庆贺，积年不觉。","book":"晋·干宝《搜神记》"},"example":{"text":"在这～的年代，好人经常受到不公正的待遇。"},"similar":["是非不分"],"opposite":["是非分明"],"usage":"作宾语、定语；指是非不分","story":["晋朝时期，吴兴一农民有两个儿子在田中耕作，忽然见鬼魅变成他们父亲对他们打骂。他们回家对父亲说，父亲要他们杀了鬼魅。第二天父亲担心鬼魅会害他的儿子就到田间去，儿子们把他当鬼魅杀了。真正的鬼魅变成他们的父亲，与他们共同生活"]},{"id":4923,"word":"人存政举","pinyin":"rén cún zhèng jǔ","abbr":"rczj","explanation":"旧指一个掌握政权的人活着的时候，他的政治主张便能贯彻。","source":{"text":"其人存，则其政举。其人亡，则其政息。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"只这议论，都是认真担当天下事的文字，～，便自易易。","book":"清·魏秀仁《花月痕》第46回"},"opposite":["人亡政息"],"usage":"作定语、宾语；指人才与政治的关系"},{"id":4924,"word":"人孰无过","pinyin":"rén shú wú guò","abbr":"rswg","explanation":"孰：谁。一般人谁能没有过失。旧时指一般人犯错误是难免的。","source":{"text":"人谁无过，过而能改，善莫大焉。","book":"《左传·宣公二年》"},"example":{"text":"～，但教改过便好了。","book":"蔡东藩《唐史演义》第八十二回"}},{"id":4925,"word":"人定胜天","pinyin":"rén dìng shèng tiān","abbr":"rdst","explanation":"人定：指人谋。指人力能够战胜自然。","source":{"text":"人定兮胜天，半壁久无胡日月。","book":"《逸周书·文传》：“人强胜天。”宋·刘过《襄阳歌》"},"example":{"text":"彼虽不来，宁禁我不往，登门就之，或～不可知？","book":"清·蒲松龄《聊斋志异·萧七》"},"similar":["人众胜天"],"opposite":["靠天吃饭"],"usage":"作谓语、宾语、定语；指人力能够战胜自然","story":["战国时期，楚平王占有太子建的媳妇，听信费无忌的谗言要杀太子建及伍奢全家。伍子胥逃到吴国，帮助吴王阖闾打败楚国，将楚平王的尸体挖出鞭打300下。伍子胥的朋友申包胥给伍子胥写信指责他：“吾闻之，人众者胜天，天定亦能破人。”"]},{"id":4926,"word":"人寿几何","pinyin":"rén shòu jǐ hé","abbr":"rsjh","explanation":"人的古往今来很短促。比喻期望的事情不能实现。","source":{"text":"《周诗》有之曰：‘俟河之清，人寿几何？’","book":"《左传·襄公八年》"},"example":{"text":"我虽老迈，也会尽心照顾她，不让她受委屈；～？谁也不能预料。","book":"霍达《穆斯林的葬礼》第十二章"}},{"id":4927,"word":"人寿年丰","pinyin":"rén shòu nián fēng","abbr":"rsnf","explanation":"人长寿，年成也好。形容太平兴旺的景象。","source":{"text":"宜其民和年登。”李善注引作“人和年丰。","book":"南朝·梁·萧统《文选·潘岳》"},"example":{"text":"大地回春，～。","book":"老舍《老张的哲学》"},"similar":["丰衣足食","国泰民安"],"opposite":["人生如寄","饥寒交迫"],"usage":"作谓语、宾语、定语、分句；用于祝福"},{"id":4928,"word":"人小鬼大","pinyin":"rén xiǎo guǐ dà","abbr":"rxgd","explanation":"指年纪小而头脑却很精明，为人调皮，鬼主意多。","example":{"text":"这小家伙～，把我都给蒙了。"},"similar":["聪明伶俐"],"usage":"作谓语、定语；指小孩"},{"id":4929,"word":"人尽其才","pinyin":"rén jìn qí cái","abbr":"rjqc","explanation":"每个人都能充分发挥自己的才能。","source":{"text":"若乃人尽其才，悉用其力。","book":"《淮南子·兵略训》"},"example":{"text":"如果能够～，物尽其用，我们的国家就会发展得更快。"},"similar":["任人唯贤","知人善用"],"opposite":["大材小用","任人唯亲"],"usage":"作谓语、宾语；指充分发挥各自的才能"},{"id":4930,"word":"人山人海","pinyin":"rén shān rén hǎi","abbr":"rsrh","explanation":"人群如山似海。形容人聚集得非常多。","source":{"text":"每日有那一般打散，或是戏舞，或是吹弹，或是歌唱，赚得那人山人海价看。","book":"明·施耐庵《水浒全传》第五十一回"},"example":{"text":"节日的公园～，热闹极了。"},"similar":["川流不息","人头攒动","摩肩接踵"],"opposite":["荒无人烟","人迹罕至"],"usage":"作谓语、补语、定语、宾语；用于公共场所"},{"id":4931,"word":"人己一视","pinyin":"rén jǐ yī shì","abbr":"rjys","explanation":"待别人象待自己一样。比喻待人没有私心。","source":{"text":"此正无意于我，人己一视之道，实贤人君子之盛德。","book":"宋·罗大经《鹤林玉露》卷二"},"similar":["一视同仁"],"usage":"作宾语、定语；用于处事"},{"id":4932,"word":"人师难遇","pinyin":"rén shī nán yù","abbr":"rsny","explanation":"人师：修养很高可以为人师表者。在德行上可以做师表的人是不容易遇到的。","source":{"text":"经师易遇，人师难遇。愿在左右供给洒扫。","book":"《资治通鉴·汉纪·桓帝延熹七年》"}},{"id":4933,"word":"人平不语","pinyin":"rén píng bù yǔ","abbr":"rpby","explanation":"一个人如得到了公平合理的待遇就不会表示不满了。","source":{"text":"曰：‘出与未出，相去几何？’师曰：‘人平不语，水平不流。’","book":"宋·释普济《五灯会元》卷十八"}},{"id":4934,"word":"人弃我取","pinyin":"rén qì wǒ qǔ","abbr":"rqwq","explanation":"别人抛弃的东西我拾起来。原指商人廉价收买滞销物品，待涨价卖出以获取厚利。后用来表示不跟别人争，仍然有好处。","source":{"text":"当魏文侯时，李克务尽地力，而白圭乐观时变，故人弃我取，人取我与。","book":"《史记·货殖列传》"},"example":{"text":"想到我们中国人最善于～，那么大概齿咬是更近于实际罢。","book":"茅盾《某镇》"},"similar":["彼弃我取"],"opposite":["人取我与"],"usage":"作宾语、定语、分句；指与众不同","story":["战国时期，魏文侯任用李悝为相国，厉行改革，加强统治。李悝从商人白圭的经商原则“人弃我取，人取我与”中得到启发，在经济改革中实行保护农民利益和发展农业生产的“平籴”法，从而使国家干预与调节经济，使魏国富强"]},{"id":4935,"word":"人弃我取，人取我予","pinyin":"rén qì wǒ qǔ，rén qǔ wǒ yǔ","abbr":"rqwqrqwy","explanation":"原指商人廉价收买滞销物品，待涨价卖出以获取厚利。后用来表示不跟别人争，仍然有好处。","source":{"text":"当魏文侯时，李克务尽地力，而白圭乐观时变，故人弃我取，人取我与。","book":"《史记·货殖列传》"}},{"id":4936,"word":"人强胜天","pinyin":"rén qiáng shèng tiān","abbr":"rqst","explanation":"人的力量强盛，可以战胜自然。","source":{"text":"故周之秩官云：人强胜天。","book":"《亢仓子·政道》"},"example":{"text":"故曰～，盖是谓矣。","book":"唐·白居易《辨水旱之灾策》"},"usage":"作宾语、定语；用于书面语"},{"id":4937,"word":"人强马壮","pinyin":"rén qiáng mǎ zhuàng","abbr":"rqmz","explanation":"形容军队的战斗力很强或军容很盛。","source":{"text":"使不着人强马壮，端的是鬼使神差。","book":"元·武汉臣《老生儿》第一折"},"example":{"text":"世言匈奴倚仗～，不时侵犯中原。","book":"明·洪楩《清平山堂话本·汉李广世号飞将军》"},"similar":["兵强马壮","马肥人壮"],"opposite":["残兵败将"],"usage":"作谓语、定语、宾语；用于军事等"},{"id":4938,"word":"人微望轻","pinyin":"rén wēi wàng qīng","abbr":"rwwq","explanation":"指身份低下，资望不足。多用作自谦之词。","source":{"text":"窃念臣人微望轻，难任斯职。","book":"宋·岳飞《奏乞罢制置使职事状》"},"similar":["人微言轻"],"usage":"作谓语、宾语、定语；指身份及地位低"},{"id":4939,"word":"人微权轻","pinyin":"rén wēi quán qīng","abbr":"rwqq","explanation":"微：低下。指人的资历浅，威望低，权力不能使大家信服。","source":{"text":"臣素卑贱，君擢之闾伍之中，加之大夫之上，士卒未附，百姓不信，人微权轻，愿得君之宠臣，国之所尊，以监军，乃可。","book":"《史记·司马穰苴列传》"},"example":{"text":"活死人便知他是个仗官托势的花花公子，自思～，鸡子不是搭石头子的。","book":"清·张南庄《何典》第六回"},"similar":["人微言轻"],"usage":"作谓语、宾语、定语；指身分及地位低","story":["春秋末期，齐国田完的后代穰苴因是婢妾所生而不被重用，在齐国受到晋国和燕国的侵略时，晏婴推荐穰苴给齐景公，被派去抵御晋军。他人微权轻，齐景公给他配了个权臣当监军。穰苴杀了这个傲慢的监军树立军威，收复了失地，被封为大司马"]},{"id":4940,"word":"人微言贱","pinyin":"rén wēi yán jiàn","abbr":"rwyj","explanation":"犹言人微言轻。地位低，说话不受人重视。","source":{"text":"吏思其繇，奔走群望，而人微言贱，不能上动。","book":"宋·曾巩《泰山祈雨文》"},"similar":["人微言轻"],"opposite":["一言千金"],"usage":"作谓语、宾语、定语；指身份及地位低"},{"id":4941,"word":"人微言轻","pinyin":"rén wēi yán qīng","abbr":"rwyq","explanation":"地位低，说话不受人重视。","source":{"text":"某已三奏其事，至今未报，盖人微言轻，理当自尔。","book":"宋·苏轼《上执政乞度牒赈济及因修廨宇书》"},"example":{"text":"你～，怎么会做过他们？","book":"清·李宝嘉《官场现形记》第三十五回"},"similar":["人微权轻","微不足道"],"opposite":["一言九鼎","一言千金"],"usage":"作谓语、宾语、定语；指身份及地位低","story":["春秋末期，齐国田完的后代穰苴因是婢妾所生而不被重用，在齐国受到晋国和燕国的侵略时，晏婴推荐穰苴给齐景公，被派去抵御晋军。他人微言轻，齐景公给他配了个权臣当监军。穰苴杀了这个傲慢的监军树立军威，收复了很多失地，战后被封为大司马"]},{"id":4942,"word":"人心不古","pinyin":"rén xīn bù gǔ","abbr":"rxbg","explanation":"古：指古代的社会风尚。旧时指人心奸诈、刻薄，没有古人淳厚。","source":{"text":"争奈何人心不古，出落着马牛襟裾。","book":"元·刘时中《端正好·上高监司》"},"example":{"text":"奈近来～，都尚奢华。","book":"清·李汝珍《镜花缘》第五十五回"},"similar":["世风日下"],"usage":"作谓语、宾语、定语；用于慨叹社会风气","story":["唐朝时期，诗人刘长卿写《听弹琴》诗：“泠泠七弦上，静听松风寒，古调虽自爱，今人多不弹。”感慨世事与人心的变化，人心不古。他以此来讽刺今人不如古人高尚，大有知音难觅的感觉"]},{"id":4943,"word":"人心不同，各如其面","pinyin":"rén xīn bù tóng，gè rú qí miàn","abbr":"rxbtgrqm","explanation":"人的内心世界各不相同，就好像他们的面貌各不相同一样。","source":{"text":"人心之不同，如其面焉。吾岂敢谓子面如吾面乎？","book":"《左传·襄公三十一年》"},"example":{"text":"～。大石道人松了口气。","book":"梁羽生《牧野流星》第四十五回"}},{"id":4944,"word":"人心不足蛇吞象","pinyin":"rén xīn bù zú shé tūn xiàng","abbr":"rxbzstx","explanation":"比喻人贪心不足，就象蛇想吞食大象一样。","source":{"text":"一蛇吞象，厥大何如？","book":"《山海经·海内南经》：“巴蛇食象，三岁而出其骨。”战国楚·屈原《天问》"},"example":{"text":"罗洪宪诗：“～，世事到头螳捕蝉。”","book":"清·翟灏《通俗编·禽鱼》"},"similar":["贪心不足"],"opposite":["知足常乐"],"usage":"作宾语、定语、分句；指人贪心","story":["传说古代有个穷苦的猎人阿象，他在森林里打猎时救了一条饿昏的小蛇，带回家精心饲养。小蛇慢慢长大成青蛇并通人性，经常从外面给他带回一些值钱的东西来报答。阿象一再向青蛇索取，盼望成为富翁，愤怒的青蛇便将这个贪得无厌的家伙一口吞下"]},{"id":4945,"word":"人心世道","pinyin":"rén xīn shì dào","abbr":"rxsd","explanation":"社会的风气，人们的思想。","source":{"text":"细心读之，其破的中窾之处，大有补于世道人心。","book":"明·袁宏道《李温陵传》"},"example":{"text":"～已沦亡，元恶公然作帝王。","book":"蔡东藩《五代史演义》第三回"}},{"id":4946,"word":"人心丧尽","pinyin":"rén xīn sàng jìn","abbr":"rxsj","explanation":"指不得人心到极点。","example":{"text":"这个专制君主暴虐无道，终致～而被推翻。"}},{"id":4947,"word":"人心似铁，官法如炉","pinyin":"rén xīn sì tiě，guān fǎ rú lú","abbr":"rxstgfrl","explanation":"即使人心像铁一样坚硬，也抗不过像熔炉一样的法律。","source":{"text":"你待结绸缪，我怕遭刑狱。我人心似铁，他官法如炉。","book":"元·白朴《墙头马上》第四折"},"example":{"text":"问到陈干娘门首时，十字儿竹竿封着门，一碗官灯在门前。上面写着八个字道：“～。”","book":"明·冯梦龙《警世通言》卷十四"}},{"id":4948,"word":"人心叵测","pinyin":"rén xīn pǒ cè","abbr":"rxpc","explanation":"叵：不可。人的心地不可探测。形容人心险恶。","source":{"text":"吾门人多矣，尹子叵测也。","book":"《新唐书·尹愔传》"},"example":{"text":"夫～，险于山川，机阱万端，由斯隐伏。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"similar":["居心叵测"],"usage":"作谓语、定语；指人的心思难于推测"},{"id":4949,"word":"人心向背","pinyin":"rén xīn xiàng bèi","abbr":"rxxb","explanation":"向：归向，指拥护；背：背离，指反对。指人民大众的拥护或反对。","source":{"text":"顾自古国家未有不以勤而兴以怠而衰者，天命去留，人心向背，皆决于是。","book":"明·余继登《典故纪闻》卷四"},"example":{"text":"国家的盛衰，在于～。"},"similar":["得道多助"],"opposite":["众望所归","失道寡助"],"usage":"作主语、谓语、宾语；指人民对事物的态度"},{"id":4950,"word":"人心大快","pinyin":"rén xīn dà kuài","abbr":"rxdk","explanation":"快：痛快。指坏人坏事受到惩罚或打击，使大家非常痛快。","source":{"text":"东山受恩反噬，其罪盖浮于诸龙光。当时人心大快，佐以此得缙绅闻声，然亦不云立枷。","book":"明·沈德符《野获编·立枷》"},"example":{"text":"砍下无赖首级，悬挂台柱上，～。","book":"孙伏园《长安道上》"},"similar":["大快人心"],"usage":"作谓语、定语；指非常痛快的事情"},{"id":4951,"word":"人心如秤","pinyin":"rén xīn rú chèng","abbr":"rxrc","explanation":"人心象秤一样。比喻人的心里都有辨别是非、衡量优劣的标准。","source":{"text":"我心如秤，不能为人作轻重。","book":"三国·蜀·诸葛亮《书》"}},{"id":4952,"word":"人心如镜","pinyin":"rén xīn rú jìng","abbr":"rxrj","explanation":"人的心就像镜子似的透亮明白。","source":{"text":"且谓人心如镜，须管常磨，勿令尘染污，自然聪明。","book":"宋·洪迈《夷坚丙志》第10卷"},"similar":["心如明镜"],"usage":"作宾语、定语；用于劝诫人"},{"id":4953,"word":"人心如面","pinyin":"rén xīn rú miàn","abbr":"rxrm","explanation":"心：指思想、感情等。指每个人的思想也象每个人的面貌一样，各不相同。","source":{"text":"人心之不同，如其面焉，吾岂敢谓子面如吾面乎？","book":"《左传·襄公三十一年》"},"usage":"作宾语、定语；指个人心思不同","story":["春秋时期郑国大夫子皮准备让年轻的尹何担任封地的主管，就问辅佐他执政的子产的意见。子产认为尹何还很年轻，没有治理国家的经验，下面的人不会服。子皮采纳他的意见，请子产帮他治家，子产说人心同人脸一样各不相同，不能替代"]},{"id":4954,"word":"人心归向","pinyin":"rén xīn guī xiàng","abbr":"rxgx","explanation":"向：归向，向往。指人民群众所拥护的，向往的。","source":{"text":"人心所归，惟道与义。","book":"《晋书·熊远传》"},"example":{"text":"我们虽无外国援助，但是～，士气高涨，经济亦有办法。","book":"毛泽东《以自卫战争粉碎蒋介石的进攻》"},"similar":["人心所向"],"usage":"作谓语、定语、定语；用于口语"},{"id":4955,"word":"人心思治","pinyin":"rén xīn sī zhì","abbr":"rxsz","explanation":"心：指愿望；治：社会局势安定，得到治理。民众都希望国家安定。","example":{"text":"好容易又是一年，已是秦始皇二十九年了，天下初平，～。","book":"蔡东藩《前汉演义》第三回"}},{"id":4956,"word":"人心惟危","pinyin":"rén xīn wéi wēi","abbr":"rxww","explanation":"惟：是；危：险恶。指人的嗜欲之心是危险的。","source":{"text":"人心惟危，道心惟危。","book":"《书·大禹漠》"},"example":{"text":"后来他对于我那“～”说的怀疑减少了。","book":"鲁迅《南腔北调集·为了忘却的记念》"},"similar":["人心叵测"],"usage":"作谓语、定语；指人心险恶"},{"id":4957,"word":"人心惶惶","pinyin":"rén xīn huáng huáng","abbr":"rxhh","explanation":"惶惶：也作“皇皇”，惊惶不安的样子。人们心中惊惶不安。","source":{"text":"今人心皇皇，见太叔势大力强，尽怀观望。","book":"明·冯梦龙《东周列国志》第四回"},"example":{"text":"无端起来胡闹，蒌喊一阵，西跑一阵，弄得～，不是扰乱治安是什么？","book":"哇圣陶《丁祭》"},"similar":["心神不定","惊恐万状"],"opposite":["镇定自若","泰然自若","高枕无忧"],"usage":"作谓语、定语、补语、分句；指惊恐不安"},{"id":4958,"word":"人心所向","pinyin":"rén xīn suǒ xiàng","abbr":"rxsx","explanation":"向：归向，向往。指人民群众所拥护的，向往的。","source":{"text":"人心所归，惟道与义。","book":"《晋书·熊远传》"},"example":{"text":"这是～，此人和之大利。","book":"曲波《林海雪原》三七"},"similar":["众望所归","深得人心"],"opposite":["众叛亲离","怨声载道","众矢之的"],"usage":"作补语、定语；指受群众所拥护","story":["晋朝时期，登基不久的晋愍帝司马邺要举行盛大庆典，丞相司马睿的主簿熊远认为与国家危难局面不相称，就上书劝谏愍帝：天子要与民同忧，人心所归，惟道与义。我劝天子应该提倡忠孝之仪，宣扬仁义之统。司马睿也加以赞同，愍帝接受劝谏"]},{"id":4959,"word":"人心所归","pinyin":"rén xīn suǒ huī","abbr":"rxsg","explanation":"大众所拥护的，向往的。","source":{"text":"人心所归，惟道与义。","book":"《晋书·熊远传》"}},{"id":4960,"word":"人心无尽","pinyin":"rén xīn wú jìn","abbr":"rxwj","explanation":"人的私心没有满足的时候。","source":{"text":"人心无尽，固非让之所能化也。","book":"清·崔述《崔东壁遗书·无闻集·争论》"}},{"id":4961,"word":"人心汹汹","pinyin":"rén xīn xiōng xiōng","abbr":"rxxx","explanation":"汹汹：纷扰不安的样子。人心惶乱，纷扰不定。","source":{"text":"人心如疑，如风涛然，汹汹靡定。","book":"《旧唐书·陆贽传》"},"example":{"text":"当是时，大同军士多战死，城门昼闭，～。","book":"《明史·郭登传》"}},{"id":4962,"word":"人心涣散","pinyin":"rén xīn huàn sàn","abbr":"rxhs","explanation":"涣散：散漫，松懈。思想不统一。形容人心不齐。","source":{"text":"由是法度不行，人心涣散，遂至天下骚动。","book":"清·毕沅《续资治通鉴·元纪·顺帝至正二十四》"},"example":{"text":"越国～，能否自立，尚未可知。","book":"《清史稿·越南传》"},"similar":["一盘散沙"],"opposite":["万众一心"],"usage":"作谓语、定语；指人心不齐"},{"id":4963,"word":"人心涣漓","pinyin":"rén xīn huàn lí","abbr":"rxhl","explanation":"形容人心不齐。","source":{"text":"似是而非，财力凋敝，人心涣漓，九年立宪，终恐为波斯之续。","book":"《清史稿·锡良传》"},"example":{"text":"我们要好好治理一下～的局面。"},"similar":["人心涣散"],"opposite":["万众一心"],"usage":"作谓语、定语；指人心不齐"},{"id":4964,"word":"人心皇皇","pinyin":"rén xīn huáng huáng","abbr":"rxhh","explanation":"见“人心惶惶”。人们内心惊恐不安。","source":{"text":"今人心皇皇，见太叔势大力强，尽怀观望。","book":"明·冯梦龙《东周列国志》第四回"},"example":{"text":"但一月无君，～，每日议立议迎，全无成说。","book":"清·孔尚任《桃花扇·阻奸》"},"similar":["人心惶惶"],"usage":"作谓语、定语、状语；指惊恐不安"},{"id":4965,"word":"人心莫测","pinyin":"rén xīn mò cè","abbr":"rxmc","explanation":"犹人心难测。指人的内心难以探测。","source":{"text":"止凭此一线未死之人心，以为鼓荡，然而形势昭然者也，人心莫测者也。","book":"清·黄宗羲《张苍水墓志铭》"},"similar":["人心叵测","人心难测"],"usage":"作谓语、定语；用于人的心思"},{"id":4966,"word":"人心隔肚皮","pinyin":"rén xīn gé dù pí","abbr":"rxgdp","explanation":"谓人的心思难以猜测。","source":{"text":"虎豹不堪骑，人心隔肚皮。休将心腹事，说与结交知！","book":"清·钱彩《说岳全传》第四回"},"example":{"text":"可是，～，有些事儿，哪能想到呢。","book":"端木蕻良《曹雪芹》"},"similar":["知人知面不知心"],"usage":"作宾语、定语、分句；形容世道险恶"},{"id":4967,"word":"人心难测","pinyin":"rén xīn nán cè","abbr":"rxnc","explanation":"谓人的内心难以探测。","source":{"text":"始常山王、成安君为布衣时，相与为刎颈之交……此二人相与，天下至欢也。然而卒相禽者，何也？患生于多欲，而人心难测也。","book":"《史记·淮阴侯列传》"},"example":{"text":"看官你道赚去商家物事的，和是那个？真个是～，海水难量。原来就是贾廉访。","book":"明·凌濛初《二刻拍案惊奇》卷二十"},"similar":["人心莫测"],"usage":"作谓语、定语、宾语；用于人的心思"},{"id":4968,"word":"人心难测，海水难量","pinyin":"rén xīn nán cè，hǎi shuǐ nán liáng","abbr":"rxnchsnl","explanation":"人心难以揣度，就象海水难以测量一样。","source":{"text":"太山不可丈尺也，江海不可斗斛也。","book":"《史记·淮阴侯列传》：“然而卒相禽者，何也？患于多欲，而人心人测也。”《淮南子·泰族训》"},"example":{"text":"看官你道赚去商家物事的，和是那个？真个是～，原来就是贾廉访。","book":"明·凌濛初《二刻拍案惊奇》卷二十"}},{"id":4969,"word":"人心齐，泰山移","pinyin":"rén xīn qí，tài shān yí","abbr":"rxqtsy","explanation":"只要大家一心，就能发挥出极大的力量。","source":{"text":"人心齐泰山移蚂蚱还有四两肉一个萝卜一个坑咱们怎么就不能从无到有从小到大由弱变强呢？","book":"王朔《一点正经没有》"},"example":{"text":"俗话说：～，我们一定能成功的。"},"usage":"作宾语、定语；用于处事"},{"id":4970,"word":"人怕出名猪怕壮","pinyin":"rén pà chū míng zhū pà zhuàng","abbr":"rpcmzpz","explanation":"人怕出了名招致麻烦，就象猪长肥了就要被宰杀一样。","source":{"text":"俗话儿说的，‘人怕出名猪怕壮’，况且又是个虚名儿。","book":"清·曹雪芹《红楼梦》第83回"},"example":{"text":"‘～’，他这时也要成为包起来作为医治新的‘趋时’病的药料了。","book":"鲁迅《花边文学·趋时和复古》"},"usage":"作宾语、分句；指不愿冒尖"},{"id":4971,"word":"人急偎亲","pinyin":"rén jí wēi qīn","abbr":"rjwq","explanation":"指人到危急时则想投靠亲友。","source":{"text":"常言道人急偎亲我稍知。","book":"元·高文秀《襄阳会》第一折"},"example":{"text":"好教我去住无因。进退无门，可着俺那埚儿里～？","book":"元·王实甫《古厢记》第二本第一折"},"usage":"作宾语、定语；用于处事"},{"id":4972,"word":"人急智生","pinyin":"rén jí zhì shēng","abbr":"rjzs","explanation":"在紧急情况下突然想出了好主意。","source":{"text":"粉墙这等高峻，如何跳得过？自古道人急计生，不免攀住这杏花梢，跳将过去。","book":"元·施惠《幽闺记·文武同盟》"},"example":{"text":"智深见了，～，便把禅杖倚了，就灶边拾把草，把春台揩抹了灰尘。（明·施耐庵《水浒全传》第六回）"},"similar":["急中生智","计上心来","人急计生"],"usage":"作谓语、补语、分句；指紧急时想办法"},{"id":4973,"word":"人急计生","pinyin":"rén jí jì shēng","abbr":"rjjs","explanation":"在紧急情况下突然想出了好主意。","source":{"text":"粉墙这等高峻，如何跳得过？自古道人急计生，不免攀住这杏花梢，跳将过去。","book":"元·施惠《幽闺记》第七出"},"example":{"text":"也是～，被他绰起，一斧正中刘官人面门，扑地倒了，又复一斧，砍倒一边。","book":"明·冯梦龙《醒世恒言》卷三十三"},"similar":["人急智生"],"usage":"作谓语、宾语、分句；指紧急想办法"},{"id":4974,"word":"人怨天怒","pinyin":"rén yuàn tiān nù","abbr":"rytn","explanation":"人民怨恨，天公震怒。形容为害作恶非常严重，引起普遍的愤怒。","source":{"text":"自是士林愤痛，人怨天怒，一夫奋臂，举州同声。","book":"《后汉书·袁绍传》"},"similar":["天怒人怨"],"usage":"作谓语、宾语、定语；指引起公愤"},{"id":4975,"word":"人怨神怒","pinyin":"rén yuàn shén nù","abbr":"rysn","explanation":"形容民愤极大。","source":{"text":"天罚既集，罪人斯殒，王旅未加，自相鱼肉。岂非人怨神怒，天降其灾！","book":"《晋书·孔愉传》"},"example":{"text":"夺百姓之食以养残凶，剥万人之衣以涂土木，于是～，众叛亲离。","book":"唐·辛替否《谏造金仙玉真二观疏》"},"similar":["人神共嫉"],"usage":"作定语、状语；用于民愤很大"},{"id":4976,"word":"人怯马弱，不习之过","pinyin":"rén qiè mǎ ruò，bù xí zhī guò","abbr":"rqmrbxzg","explanation":"人胆怯，马懦弱，是由于没有很好训练的缘故。原指将士临阵怯敌，是由于平时缺乏锻炼。后泛指做任何事情平时都要练好基本功。","source":{"text":"盖士有未战而震慑者﹐马有未驰而疲汗者﹐非人怯马弱﹐不习之过也。","book":"宋·曾公亮《武经总要·前集》卷二"}},{"id":4977,"word":"人恶礼不恶","pinyin":"rén è lǐ bù è","abbr":"relbe","explanation":"恶：凶恶。指对方为人虽然凶恶，但对他也不能不讲礼貌。","source":{"text":"贤士，常言道人恶礼不恶，还辞一辞老丞相。","book":"元·郑德辉《王粲登楼》第一折"}},{"id":4978,"word":"人情世态","pinyin":"rén qíng shì tai","abbr":"rqst","explanation":"人世间的情态。多指人与人之间的交往情分。","source":{"text":"人情世态，倏忽万端，不宜认得太真。","book":"明·陈所闻《新水令·填归去来词》套曲：“俺与那人情世态既相违，披襟散发最相宜。”明·洪应明《菜根谭·闲适》"},"example":{"text":"小说的许多章节便刻画出生动的～。","book":"杨朔《〈六十年的变迁〉书后》"},"usage":"作宾语、定语；用于交往"},{"id":4979,"word":"人情世故","pinyin":"rén qíng shì gù","abbr":"rqsg","explanation":"为人处世的道理。","source":{"text":"可惜你满腹文章，看不出人情世故。","book":"宋·文天祥《送僧了敬序》：“姑与之委曲于人情世故之内。”明·冯梦龙《醒世恒言》第二十一卷"},"example":{"text":"我说你到底没有经练，所以这些～一点也不懂。","book":"清·吴研人《二十年目睹之怪现状》第十四回"},"similar":["人情冷暖","人之常情"],"opposite":["世态炎凉"],"usage":"作主语、宾语、定语；形容与他人的关系"},{"id":4980,"word":"人情之常","pinyin":"rén qíng zhī cháng","abbr":"rqzc","explanation":"一般人通常有的感情。","source":{"text":"夫生死交谢，寒暑迭迁，有物流动，人之常情，余则谓之不然。","book":"晋·释僧肇《物不迁论》"},"example":{"text":"凡用一人，必或以为贤，或以为不肖，此固～，自古而然，不足怪也。","book":"宋·司马光《应诏论体要》"},"similar":["人之常情"],"usage":"作主语、宾语；用于人"},{"id":4981,"word":"人情冷暖","pinyin":"rén qíng lěng nuǎn","abbr":"rqln","explanation":"人情：指社会上的人情世故；冷：冷淡；暖：亲热。泛指人情的变化。指在别人得势时就奉承巴结，失势时就不理不睬。","source":{"text":"冷暖俗情谙世路，是非闲论任交亲。","book":"唐·白居易《迁叟》诗"},"example":{"text":"节物后先南北异，～古今同。","book":"宋·周密《齐东野语》卷十一"},"similar":["人情世故"],"usage":"作主语、宾语、定语；形容人的态度"},{"id":4982,"word":"人情恟恟","pinyin":"rén qíng xiōng xiōng","abbr":"rqxx","explanation":"形容人心动荡不安。","source":{"text":"是时，都下人情恟恟，或云欲诛王、谢，因移晋室。","book":"《资治通鉴·晋孝武帝宁康元年》"},"similar":["人情汹汹"],"usage":"作谓语、定语；用于书面语"},{"id":4983,"word":"人情汹汹","pinyin":"rén qíng xiōng xiōng","abbr":"rqxx","explanation":"形容人心动荡不安。同“人情恟恟”。","source":{"text":"绍熙甲寅，孝宗升遐，光宗疾，不能丧，中外人情汹汹。","book":"宋·罗大经《鹤林玉露》卷九"},"example":{"text":"甲午，寿张王伦作乱，距运河甚近，～。","book":"清·昭梿《啸亭杂录·陆中丞》"},"similar":["人情恟恟"],"usage":"作谓语、定语；用于书面语"},{"id":4984,"word":"人情物理","pinyin":"rén qíng wù lǐ","abbr":"rqwl","explanation":"泛指一切人情事理。","source":{"text":"即上书数千言，杂引《春秋》、《洪范》及古今传记，人情物理，以明其决不然者。","book":"宋·苏轼《富郑公神道碑》"},"example":{"text":"一饭尚铭恩，况保抱提携，只少怀胎十月；千金难报德，论～，也当泣血三年。","book":"清·曾国藩《挽乳母》"}},{"id":4985,"word":"人情练达","pinyin":"rén qíng liàn dá","abbr":"rqld","explanation":"人情：人情世故；练达：熟悉通达。指通晓待人处世的经验。","source":{"text":"世事洞明皆学问，人情练达即文章。","book":"清·曹雪芹《红楼梦》第五回"}},{"id":4986,"word":"人我是非","pinyin":"rén wǒ shì fēi","abbr":"rwsf","explanation":"是非：争执，纠纷。人与人之间的各种利害关系和纠纷。","source":{"text":"一梦中十八年，见了酒色财气，人我是非，贪嗔痴爱，风霜雨雪。","book":"元·马致远《黄粱梦》第四折"},"example":{"text":"一梦之中，见了～，得失荣枯，遂有出尘之志。","book":"明·无名氏《度黄龙》楔子"},"usage":"作宾语、定语；用于交往等"},{"id":4987,"word":"人所共知","pinyin":"rén suǒ gòng zhī","abbr":"rsgz","explanation":"人人都知道。","source":{"text":"百于古今之变，利害之实，人所共知而易见者，亦复乖戾如此。","book":"宋·朱熹《封建》"},"example":{"text":"～的事，你还敢狡辩吗？"},"similar":["尽人皆知","众所周知","无人不晓"],"opposite":["人所不知","高深莫测"],"usage":"作宾语、定语；用于事物"},{"id":4988,"word":"人手一册","pinyin":"rén shǒu yī cè","abbr":"rsyc","explanation":"人人拿着一本（书）。多形容书的读者多。","example":{"text":"这本书销量很好，几乎是～。"},"usage":"作宾语；形容书的读者多"},{"id":4989,"word":"人才出众","pinyin":"rén cái chū zhòng","abbr":"rccz","explanation":"人品才能超出众人。","source":{"text":"年二十五岁，丰姿洒落，人才出众，琴棋书画，无所不通。","book":"明·冯梦龙《喻世明言》卷十二"},"example":{"text":"俺李相公～，天凑良姻。","book":"明·汤显祖《紫钗记·借马》"},"similar":["人材出众"],"usage":"作谓语、定语；用于夸奖人"},{"id":4990,"word":"人才济济","pinyin":"rén cái jǐ jǐ","abbr":"rcjj","explanation":"济济：众多的样子。形容有才能的人很多。","source":{"text":"济济有众，咸听朕命。","book":"《书·大禹漠》"},"example":{"text":"闺臣见～，十分欢悦。","book":"清·李汝珍《镜花缘》第六十二回"},"similar":["人才辈出"],"opposite":["人才零落"],"usage":"作主语、宾语、定语；指人才很多"},{"id":4991,"word":"人才辈出","pinyin":"rén cái bèi chū","abbr":"rcbc","explanation":"辈出：一批一批地出现。形容有才能的人不断涌现。","source":{"text":"得如左丞许衡教国子，则人才辈出矣。","book":"清·毕沅《续资治通鉴·元纪·世祖至元二十年》"},"example":{"text":"我们的时代是～的时代。"},"similar":["人才济济"],"opposite":["人才零落","后继无人"],"usage":"作谓语、定语、宾语；指人才不断涌现"},{"id":4992,"word":"人才难得","pinyin":"rén cái cái dé","abbr":"rcnd","explanation":"有都能的人不容易得到。多指要爱惜人才。","source":{"text":"首择辅臣，次求法从，知人才之难得，采虚名而用。","book":"宋·苏轼《谢宣召入院状》"},"example":{"text":"一则也是他福至心灵，处处懂得巴结；二则也是～，近来居然升了二买办了。","book":"清·吴趼人《发屠秘诀》第九回"},"usage":"作宾语、定语；多用于感叹"},{"id":4993,"word":"人扶人兴","pinyin":"rén fú rén xīng","abbr":"rfrx","explanation":"扶：扶助；兴：兴致。人们互相助兴。","source":{"text":"其实只是人扶人兴，大家笑耍取乐而已。","book":"明·凌濛初《二刻拍案惊奇》卷二"}},{"id":4994,"word":"人文荟萃","pinyin":"rén wén huì cuì","abbr":"rwhc","explanation":"人才和文物众多，并聚集在一地。","example":{"text":"这个地方山明水秀，～，是个值得浏览的好去处。"}},{"id":4995,"word":"人无刚骨，安身不牢","pinyin":"rén wú gāng gǔ，ān shēn bù láo","abbr":"rwggasbl","explanation":"人没有坚硬的骨头，身体就站不起来。比喻人无坚强的意志品格，就难以立身行事。","source":{"text":"常言道：‘人无刚骨，安身不牢。’奴家平生快性，看不得这般‘三答不回头，四答和身转’的人。","book":"明·施耐庵《水浒全传》第十二四回"}},{"id":4996,"word":"人无千日好，花无百日红","pinyin":"rén wú qiān rì hǎo，huā wú bǎi rì hóng","abbr":"rwqrhhwbrh","explanation":"指人的青春短暂。比喻好景不长或友情难以持久。","source":{"text":"人无千日好，花无百日红。早时不计算，过后一场空。","book":"元·杨文奎《儿女团圆》楔子"},"example":{"text":"～，天下没有不散的筵席。"},"similar":["花无百日红，人无千日好"],"usage":"作宾语、分句；可分开使用","story":["宋江杀了阎婆惜后投靠有钱有势的柴进，柴进特别款待他，他喝酒到深夜起身去上厕所碰到武松。武松破口大骂，旁人告诉武松他是大官人最红的客官，武松大发感慨：人无千日好，花无百日红。他们同去见柴进，相识后成为要好的朋友"]},{"id":4997,"word":"人无完人","pinyin":"rén wú wán rén","abbr":"rwwr","explanation":"没有十全十美的人。比喻不能要求一个人没有一点缺点错误。","source":{"text":"黄金无足色，白璧有微瑕。求人不求备，妾愿老君家。","book":"宋·戴复古《寄兴》"}},{"id":4998,"word":"人无害虎心，虎有伤人意","pinyin":"rén wú hài hǔ xīn，hǔ yǒu shāng rén yì","abbr":"rwhhxhysry","explanation":"人本没有伤害老虎的心，而老虎却想伤害人。比喻自己虽没有伤害人的意思，别人却一定要伤害你。","source":{"text":"你有心，他无义。人无害虎心，虎有伤人意。","book":"元·无名氏《连环计》第四折"}},{"id":4999,"word":"人无有千日好，花无有百日红","pinyin":"rén wú yǒu qiān rì hǎo,huā wú yǒu bǎi rì hóng","abbr":"rwyqrhhwybrh","explanation":"指人的青春短暂。比喻好景不长或友情难以持久。","source":{"text":"想人生百岁翁，似花飞一阵风，人无有千日好，花无有百日红。","book":"元·史九敬先《庄周梦》第一折"},"similar":["人无千日好，花无百日红"],"usage":"作宾语、分句；可分开使用"},{"id":5000,"word":"人无貌相，水无斗量","pinyin":"rén wú mào xiàng，shuǐ wú dǒu liáng","abbr":"rwmxswdl","explanation":"相：估量，评价。指不能以貌取人就像海水不能用斗来量一样。","source":{"text":"人无貌相，水无斗量，西子向业浣纱，飞燕曾充婢役，我虽一贫家女，将来或得幸遇，也未可知。","book":"《慈禧太后演义》第三回"},"similar":["人不可貌相，海水不可斗量"],"usage":"作宾语、分句；用于劝诫人"}]
