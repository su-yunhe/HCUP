diff --git a/hypium_tests/search_helpers.py b/hypium_tests/search_helpers.py
new file mode 100644
index 0000000000000000000000000000000000000000..86ae98c1b80db9fcb63e60efb14a55affd30fcd8
--- /dev/null
+++ b/hypium_tests/search_helpers.py
@@ -0,0 +1,171 @@
+"""商品搜索题（cml-combo-search）自测公共辅助：启动、进入搜索页、搜索、读取历史等。
+
+只放本题流程相关的封装；设备连接与重试查找来自 common/test-harness 的 HarnessTestCase。
+"""
+from __future__ import annotations
+
+import time
+
+from hypium import BY
+from hypium.model import KeyCode, MatchPattern
+
+from harness.driver import HarnessTestCase
+
+BUNDLE = "com.joker.coolmall"
+ABILITY = "EntryAbility"
+
+# 稳定选择器（与 spec/acceptance.md §0 一致）
+HOME_SEARCH_BAR = "home_search_bar"
+SEARCH_INPUT = "goods_search_input"
+SEARCH_BUTTON = "goods_search_button"
+HISTORY_SECTION = "search_history_section"
+HISTORY_CLEAR = "search_history_clear"
+HISTORY_TAG = "search_history_tag_"
+RECOMMEND_SECTION = "search_recommend_section"
+RECOMMEND_TAG = "search_recommend_tag_"
+RESULT_LIST = "goods_category_list"
+RESULT_KEYWORD = "goods_category_keyword"
+RESULT_ITEM = "goods_category_item_"
+
+# Spec 指定文案
+TEXT_HISTORY = "搜索历史"
+TEXT_RECOMMEND = "推荐搜索"
+TEXT_SEARCH = "搜索"
+TEXT_CLEAR_MESSAGE = "确认清空所有搜索历史吗？"
+TEXT_CANCEL = "取消"
+TEXT_CONFIRM = "确认"
+
+NETWORK_TIMEOUT = 30
+
+
+class SearchTestCase(HarnessTestCase):
+    """本题测试基类：每个用例默认清数据冷启动，保证历史记录从空开始。"""
+
+    clear_data_on_setup = True
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        super().setUpClass()
+        # 缺席断言很多，隐式等待调小，由 find_or_none 显式轮询
+        cls.driver.set_implicit_wait_time(1)
+
+    def setUp(self) -> None:
+        self.launch(clear_data=self.clear_data_on_setup)
+
+    # ---------- 应用与页面 ----------
+
+    def launch(self, clear_data: bool = False) -> None:
+        self.driver.stop_app(BUNDLE)
+        if clear_data:
+            self.driver.clear_app_data(BUNDLE)
+        self.driver.start_app(BUNDLE, ABILITY, wait_time=2)
+        self.require_component(BY.key(HOME_SEARCH_BAR), "冷启动后首页搜索框未出现", timeout=20)
+
+    def open_search(self) -> None:
+        bar = self.require_component(BY.key(HOME_SEARCH_BAR), "首页搜索框未出现")
+        self.driver.click(bar)
+        self.require_component(BY.key(SEARCH_INPUT), "点击首页搜索框后未进入搜索页")
+        self.driver.wait(1)
+
+    def back_to_search(self) -> None:
+        """从结果页返回搜索页（键盘弹出时第一次返回只收起键盘，所以最多按 3 次）。"""
+        for _ in range(3):
+            self.driver.press_back()
+            self.driver.wait(1)
+            if self.on_search_page():
+                return
+        self.fail("返回后未回到搜索页")
+
+    def back_to_home(self) -> None:
+        for _ in range(4):
+            self.driver.press_back()
+            self.driver.wait(1)
+            if self.find_or_none(BY.key(HOME_SEARCH_BAR), timeout=1) is not None:
+                return
+        self.fail("返回后未回到首页")
+
+    def on_search_page(self) -> bool:
+        return (self.find_or_none(BY.key(SEARCH_INPUT), timeout=1) is not None
+                and self.find_or_none(BY.key(RESULT_LIST), timeout=1) is None)
+
+    def on_result_page(self, timeout: float = 8) -> bool:
+        return self.find_or_none(BY.key(RESULT_LIST), timeout=timeout) is not None
+
+    # ---------- 输入与搜索 ----------
+
+    def search_input(self):
+        return self.require_component(BY.key(SEARCH_INPUT), "搜索输入框不存在")
+
+    def input_value(self) -> str:
+        return self.search_input().getText() or ""
+
+    def type_keyword(self, text: str) -> None:
+        self.driver.input_text(self.search_input(), text)
+        self.driver.wait(0.5)
+
+    def click_search_button(self) -> None:
+        self.driver.click(self.require_component(BY.key(SEARCH_BUTTON), "搜索按钮不存在"))
+        self.driver.wait(0.5)
+
+    def press_enter(self) -> None:
+        self.driver.press_key(KeyCode.ENTER)
+        self.driver.wait(0.5)
+
+    def search_and_back(self, keyword: str) -> None:
+        """输入关键词 → 点“搜索” → 确认进入结果页 → 返回搜索页。"""
+        self.type_keyword(keyword)
+        self.click_search_button()
+        self.assertTrue(self.on_result_page(), f"搜索 {keyword!r} 后未进入结果页")
+        self.back_to_search()
+
+    def result_keyword(self) -> str | None:
+        comp = self.find_or_none(BY.key(RESULT_KEYWORD), timeout=5)
+        return comp.getText() if comp is not None else None
+
+    # ---------- 历史与推荐 ----------
+
+    def tags(self, prefix: str) -> list[str]:
+        """按 id 序号读取标签文本（id 形如 search_history_tag_3）。"""
+        comps = self.driver.find_all_components(BY.key(prefix, MatchPattern.STARTS_WITH)) or []
+        indexed = []
+        for c in comps:
+            suffix = (c.getId() or "")[len(prefix):]
+            if suffix.isdigit():
+                indexed.append((int(suffix), c.getText()))
+        return [text for _, text in sorted(indexed)]
+
+    def history(self) -> list[str]:
+        return self.tags(HISTORY_TAG)
+
+    def wait_history(self, expected_first: str, timeout: float = 5) -> list[str]:
+        deadline = time.monotonic() + timeout
+        items = self.history()
+        while time.monotonic() < deadline and (not items or items[0] != expected_first):
+            self.driver.wait(0.5)
+            items = self.history()
+        return items
+
+    def wait_recommend(self, timeout: float = NETWORK_TIMEOUT):
+        """等待第 0 个推荐标签出现；网络不可用时返回 None。"""
+        return self.find_or_none(BY.key(f"{RECOMMEND_TAG}0"), timeout=timeout)
+
+    def has_history_section(self) -> bool:
+        return self.find_or_none(BY.text(TEXT_HISTORY), timeout=1) is not None
+
+    # ---------- 其它 ----------
+
+    def keyboard_visible(self) -> bool:
+        """hidumper 窗口列表中可见窗口段（ScreenGroup 表头之后、第一条分隔线之前）是否含输入法窗口。"""
+        out = self.driver.shell("hidumper -s WindowManagerService -a '-a'") or ""
+        lines = out.split("ScreenGroup", 1)[-1].splitlines()[2:]
+        for line in lines:
+            if line.startswith("---"):
+                break
+            if line.lower().startswith("softkeyboard"):
+                return True
+        return False
+
+    @staticmethod
+    def same_row(a, b) -> bool:
+        ra, rb = a.getBounds(), b.getBounds()
+        return ra.top < rb.bottom and rb.top < ra.bottom
diff --git a/hypium_tests/test_scenario1_search.py b/hypium_tests/test_scenario1_search.py
new file mode 100644
index 0000000000000000000000000000000000000000..5375410e1bac4bfa963e20608a5f584ace3e7b3e
--- /dev/null
+++ b/hypium_tests/test_scenario1_search.py
@@ -0,0 +1,124 @@
+"""场景一：首页进入搜索页、两个区域、输入、两种搜索触发、去空格、跳转结果页。"""
+from hypium import BY
+
+from hypium_tests.search_helpers import (
+    HISTORY_CLEAR, HISTORY_SECTION, RECOMMEND_SECTION, RESULT_ITEM, RESULT_KEYWORD, SEARCH_BUTTON,
+    SEARCH_INPUT, TEXT_HISTORY, TEXT_RECOMMEND, TEXT_SEARCH, SearchTestCase,
+)
+
+
+class TestScenario1Search(SearchTestCase):
+
+    def test_a01_a03_enter_search_page_focus_and_keyboard(self):
+        """A1-A3：点首页搜索框进入搜索页，输入框自动聚焦并弹出软键盘。"""
+        self.open_search()
+        self.require_text("商品搜索", "搜索页标题不存在")
+        self.require_component(BY.key(SEARCH_BUTTON), "搜索按钮不存在")
+        self.assertTrue(self.search_input().isFocused(), "搜索框未自动获取焦点")
+        self.assertTrue(self.keyboard_visible(), "进入搜索页后软键盘未弹出")
+
+    def test_a05_no_history_section_when_empty(self):
+        """A5：无历史时不渲染“搜索历史”区域，但“推荐搜索”在。"""
+        self.open_search()
+        self.require_text(TEXT_RECOMMEND, "推荐搜索标题不存在")
+        self.assertIsNone(self.find_or_none(BY.text(TEXT_HISTORY), timeout=2), "无历史时不应出现“搜索历史”")
+        self.assertIsNone(self.find_or_none(BY.key(HISTORY_SECTION), timeout=1), "无历史时不应渲染历史区域")
+        self.assertIsNone(self.find_or_none(BY.key(HISTORY_CLEAR), timeout=1), "无历史时不应出现删除图标")
+
+    def test_a04_a06_a07_sections_layout(self):
+        """A4/A6/A7：有历史时历史区域在上、推荐区域在下，推荐词来自服务端。"""
+        self.open_search()
+        self.search_and_back("手机")
+        history_title = self.require_text(TEXT_HISTORY, "搜索后返回未出现“搜索历史”")
+        recommend_title = self.require_text(TEXT_RECOMMEND, "推荐搜索标题不存在")
+        self.assertEqual(self.history(), ["手机"])
+        self.assertLessEqual(self.search_input().getBounds().bottom, history_title.getBounds().top,
+                             "历史区域应在输入框下方")
+        self.assertLess(history_title.getBounds().top, recommend_title.getBounds().top,
+                        "历史区域应在推荐区域上方")
+        self.assertIsNotNone(self.find_or_none(BY.key(RECOMMEND_SECTION), timeout=1))
+        rec0 = self.wait_recommend()
+        self.require_precondition(rec0 is not None, "推荐词接口不可达（模拟器网络）")
+        self.assertTrue(rec0.getText(), "推荐标签文本为空")
+        self.assertGreater(rec0.getBounds().top, recommend_title.getBounds().top, "推荐标签应在推荐标题下方")
+
+    def test_a08_input_sync(self):
+        """A8：输入内容实时显示在搜索框，且不会触发跳转。"""
+        self.open_search()
+        self.type_keyword("Xiaomi 17 Pro")
+        self.assertEqual(self.input_value(), "Xiaomi 17 Pro")
+        self.assertTrue(self.on_search_page(), "仅输入不应跳转")
+
+    def test_a09_keyboard_enter_triggers_search(self):
+        """A9/A12：键盘搜索键触发搜索并跳转结果页。"""
+        self.open_search()
+        self.type_keyword("手机")
+        self.press_enter()
+        self.assertTrue(self.on_result_page(), "按键盘搜索键后未进入结果页")
+        self.assertEqual(self.result_keyword(), "手机")
+        self.require_text("商品分类", "结果页标题不存在")
+
+    def test_a10_search_button_position_and_click(self):
+        """A10：输入框右侧有唯一的“搜索”按钮，点击触发搜索。"""
+        self.open_search()
+        button = self.require_component(BY.key(SEARCH_BUTTON), "搜索按钮不存在")
+        self.assertEqual(button.getText(), TEXT_SEARCH)
+        self.assertTrue(button.isClickable(), "搜索按钮应可点击")
+        inp = self.search_input()
+        self.assertGreaterEqual(button.getBounds().left, inp.getBounds().right, "搜索按钮应在输入框右侧")
+        self.assertTrue(self.same_row(button, inp), "搜索按钮应与输入框同一行")
+        # 页面内精确文本“搜索”只有这一个按钮（输入法窗口里的“搜索”键不属于本应用，按 id 排除）
+        exact = self.driver.find_all_components(BY.text(TEXT_SEARCH)) or []
+        in_page = [c for c in exact if c.getBounds().bottom <= inp.getBounds().bottom + 200]
+        self.assertEqual([c.getId() for c in in_page], [SEARCH_BUTTON])
+        self.type_keyword("手机")
+        self.click_search_button()
+        self.assertTrue(self.on_result_page(), "点“搜索”后未进入结果页")
+
+    def test_a11_trim_before_save(self):
+        """A11/A43：首尾空格去除后保存，中间空格保留；跳转参数同为去空格后的词。"""
+        self.open_search()
+        self.type_keyword("  手机  ")
+        self.click_search_button()
+        self.assertTrue(self.on_result_page(), "未进入结果页")
+        self.assertEqual(self.result_keyword(), "手机")
+        self.back_to_search()
+        self.assertEqual(self.wait_history("手机"), ["手机"])
+        self.search_and_back(" Xiaomi 17 Pro ")
+        self.assertEqual(self.wait_history("Xiaomi 17 Pro"), ["Xiaomi 17 Pro", "手机"])
+
+    def test_a13_result_list_shows_goods(self):
+        """A12/A13/A15：结果页按关键词加载商品列表并显示当前关键词。"""
+        self.open_search()
+        self.type_keyword("Xiaomi 17")
+        self.click_search_button()
+        self.assertTrue(self.on_result_page(), "未进入结果页")
+        self.assertEqual(self.result_keyword(), "Xiaomi 17")
+        item = self.find_or_none(BY.key(f"{RESULT_ITEM}0"), timeout=30)
+        self.require_precondition(item is not None, "商品接口不可达或无数据（模拟器网络）")
+        self.back_to_search()
+        self.assertEqual(self.input_value(), "Xiaomi 17", "返回后输入框应保留上次搜索词")
+
+    def test_a14_empty_result(self):
+        """A14：无匹配商品时不展示商品卡片、页面不崩溃，可返回搜索页。"""
+        self.open_search()
+        self.type_keyword("zzzz不存在的商品")
+        self.click_search_button()
+        self.assertTrue(self.on_result_page(), "未进入结果页")
+        self.driver.wait(5)
+        self.assertIsNone(self.find_or_none(BY.key(f"{RESULT_ITEM}0"), timeout=1), "无结果时不应有商品卡片")
+        self.require_text("暂无数据", "空结果文案不存在")
+        self.assertIsNotNone(self.find_or_none(BY.key(RESULT_KEYWORD), timeout=1))
+        self.back_to_search()
+        self.assertEqual(self.wait_history("zzzz不存在的商品")[0], "zzzz不存在的商品")
+
+    def test_a42_reenter_from_home(self):
+        """A42：返回首页再进入，输入框为空且重新聚焦，历史为最新。"""
+        self.open_search()
+        self.search_and_back("手机")
+        self.back_to_home()
+        self.open_search()
+        self.assertEqual(self.input_value(), "", "重新进入时输入框应为空")
+        self.assertTrue(self.search_input().isFocused(), "重新进入时输入框应聚焦")
+        self.assertEqual(self.history(), ["手机"])
+        self.assertIsNotNone(self.find_or_none(BY.key(SEARCH_INPUT), timeout=1))
diff --git a/hypium_tests/test_scenario2_tags.py b/hypium_tests/test_scenario2_tags.py
new file mode 100644
index 0000000000000000000000000000000000000000..d31d4f7173a561106a4a818a58c8e20a43fc2215
--- /dev/null
+++ b/hypium_tests/test_scenario2_tags.py
@@ -0,0 +1,73 @@
+"""场景二：历史 / 推荐标签搜索，最近 10 条、倒序、去重置顶、返回后排第一。"""
+from hypium import BY
+
+from hypium_tests.search_helpers import HISTORY_TAG, RECOMMEND_TAG, SearchTestCase
+
+
+class TestScenario2Tags(SearchTestCase):
+
+    def test_a16_a26_history_limit_10(self):
+        """A16/A26：搜 11 个不同词后只显示最近 10 条，最早的被挤掉。"""
+        self.open_search()
+        words = [f"k{i}" for i in range(1, 12)]
+        for w in words:
+            self.search_and_back(w)
+        items = self.wait_history("k11")
+        self.assertEqual(items, list(reversed(words))[:10])
+        self.assertNotIn("k1", items)
+        self.assertIsNone(self.find_or_none(BY.key(f"{HISTORY_TAG}10"), timeout=1))
+
+    def test_a17_a19_a21_a23_history_tag_click_moves_to_front(self):
+        """A17/A19-A23：历史倒序；点非首个历史标签 → 填入搜索框并跳转 → 返回后该词排第一且不重复。"""
+        self.open_search()
+        for w in ("苹果", "香蕉", "橙子"):
+            self.search_and_back(w)
+        self.assertEqual(self.wait_history("橙子"), ["橙子", "香蕉", "苹果"])
+        tag = self.require_component(BY.key(f"{HISTORY_TAG}2"), "第 3 个历史标签不存在")
+        self.assertEqual(tag.getText(), "苹果")
+        self.driver.click(tag)
+        self.assertTrue(self.on_result_page(), "点历史标签后未进入结果页")
+        self.assertEqual(self.result_keyword(), "苹果")
+        self.back_to_search()
+        self.assertEqual(self.input_value(), "苹果", "点历史标签应把该词填入搜索框")
+        self.assertEqual(self.wait_history("苹果"), ["苹果", "橙子", "香蕉"])
+
+    def test_a21_manual_input_existing_word_dedup(self):
+        """A21/A43：手动输入已存在的词（带首尾空格）同样去重置顶；大小写不同算两个词。"""
+        self.open_search()
+        for w in ("Xiaomi", "手机"):
+            self.search_and_back(w)
+        self.search_and_back("  Xiaomi ")
+        self.assertEqual(self.wait_history("Xiaomi"), ["Xiaomi", "手机"])
+        self.search_and_back("xiaomi")
+        self.assertEqual(self.wait_history("xiaomi"), ["xiaomi", "Xiaomi", "手机"])
+
+    def test_a24_a25_recommend_tag_click(self):
+        """A24/A25：点推荐标签 → 填入搜索框并跳转 → 返回后写入历史第一位。"""
+        self.open_search()
+        self.search_and_back("手机")
+        rec = self.wait_recommend()
+        self.require_precondition(rec is not None, "推荐词接口不可达（模拟器网络）")
+        word = rec.getText()
+        self.driver.click(rec)
+        self.assertTrue(self.on_result_page(), "点推荐标签后未进入结果页")
+        self.assertEqual(self.result_keyword(), word)
+        self.back_to_search()
+        self.assertEqual(self.input_value(), word, "点推荐标签应把该词填入搜索框")
+        self.assertEqual(self.wait_history(word), [word, "手机"])
+        # 推荐区域保持不变（返回时不重新请求，也不清空）
+        self.assertEqual(self.find_or_none(BY.key(f"{RECOMMEND_TAG}0"), timeout=2).getText(), word)
+
+    def test_a25_recommend_word_already_in_history(self):
+        """A25 边界：推荐词已在历史中 → 移到最前，不重复。"""
+        self.open_search()
+        rec = self.wait_recommend()
+        self.require_precondition(rec is not None, "推荐词接口不可达（模拟器网络）")
+        word = rec.getText()
+        self.search_and_back(word)
+        self.search_and_back("手机")
+        self.assertEqual(self.wait_history("手机"), ["手机", word])
+        self.driver.click(self.require_component(BY.key(f"{RECOMMEND_TAG}0"), "推荐标签不存在"))
+        self.assertTrue(self.on_result_page(), "点推荐标签后未进入结果页")
+        self.back_to_search()
+        self.assertEqual(self.wait_history(word), [word, "手机"])
diff --git a/hypium_tests/test_scenario3_clear.py b/hypium_tests/test_scenario3_clear.py
new file mode 100644
index 0000000000000000000000000000000000000000..67b8b4b9b28fd5da82e0ad24774b92db40c39e79
--- /dev/null
+++ b/hypium_tests/test_scenario3_clear.py
@@ -0,0 +1,91 @@
+"""场景三：清空历史（删除图标 → 确认框 → 取消 / 确认 / 返回键）。"""
+from hypium import BY
+
+from hypium_tests.search_helpers import (
+    HISTORY_CLEAR, HISTORY_SECTION, RECOMMEND_SECTION, TEXT_CANCEL, TEXT_CLEAR_MESSAGE, TEXT_CONFIRM,
+    TEXT_HISTORY, TEXT_RECOMMEND, SearchTestCase,
+)
+
+
+class TestScenario3Clear(SearchTestCase):
+
+    def seed(self, *words: str) -> None:
+        self.open_search()
+        for w in words:
+            self.search_and_back(w)
+        self.assertEqual(self.wait_history(words[-1]), list(reversed(words)))
+
+    def open_dialog(self):
+        self.driver.click(self.require_component(BY.key(HISTORY_CLEAR), "删除图标不存在"))
+        return self.require_text(TEXT_CLEAR_MESSAGE, "点删除图标后未弹出确认框", timeout=5)
+
+    def test_a27_trash_icon_right_of_title(self):
+        """A27：历史标题右侧显示删除图标。"""
+        self.seed("手机")
+        title = self.require_text(TEXT_HISTORY, "搜索历史标题不存在")
+        icon = self.require_component(BY.key(HISTORY_CLEAR), "删除图标不存在")
+        self.assertTrue(icon.isClickable(), "删除图标应可点击")
+        self.assertGreater(icon.getBounds().left, title.getBounds().right, "删除图标应在标题右侧")
+        self.assertTrue(self.same_row(icon, title), "删除图标应与标题同一行")
+
+    def test_a28_a29_a30_dialog_and_cancel(self):
+        """A28-A30：弹出确认框（文案、取消/确认按钮在下方）；点取消关框且历史不变。"""
+        self.seed("苹果", "香蕉")
+        message = self.open_dialog()
+        cancel = self.require_text(TEXT_CANCEL, "确认框缺少“取消”")
+        confirm = self.require_text(TEXT_CONFIRM, "确认框缺少“确认”")
+        self.assertGreater(cancel.getBounds().top, message.getBounds().top, "取消按钮应在提示下方")
+        self.assertGreater(confirm.getBounds().top, message.getBounds().top, "确认按钮应在提示下方")
+        self.assertEqual(len(self.driver.find_all_components(BY.text(TEXT_CLEAR_MESSAGE)) or []), 1)
+        self.driver.click(cancel)
+        self.driver.wait(1)
+        self.assertIsNone(self.find_or_none(BY.text(TEXT_CLEAR_MESSAGE), timeout=2), "点取消后确认框未关闭")
+        self.assertEqual(self.history(), ["香蕉", "苹果"])
+        # 取消后能再次弹出
+        self.open_dialog()
+        self.driver.click(self.require_text(TEXT_CANCEL, "确认框缺少“取消”"))
+        self.driver.wait(1)
+        self.assertEqual(self.history(), ["香蕉", "苹果"])
+        # 重启后历史仍在
+        self.launch()
+        self.open_search()
+        self.assertEqual(self.history(), ["香蕉", "苹果"])
+
+    def test_a31_a32_a33_confirm_clears(self):
+        """A31-A33：点确认清空历史并关框；历史区域消失只剩推荐区域；搜索框为空；重启后仍为空。"""
+        self.seed("苹果", "香蕉")
+        self.assertEqual(self.input_value(), "香蕉")
+        self.open_dialog()
+        self.driver.click(self.require_text(TEXT_CONFIRM, "确认框缺少“确认”"))
+        self.driver.wait(1)
+        self.assertIsNone(self.find_or_none(BY.text(TEXT_CLEAR_MESSAGE), timeout=2), "点确认后确认框未关闭")
+        self.assertIsNone(self.find_or_none(BY.text(TEXT_HISTORY), timeout=2), "清空后“搜索历史”应消失")
+        self.assertIsNone(self.find_or_none(BY.key(HISTORY_SECTION), timeout=1))
+        self.assertIsNone(self.find_or_none(BY.key(HISTORY_CLEAR), timeout=1))
+        self.require_text(TEXT_RECOMMEND, "清空后“推荐搜索”应保留")
+        self.assertIsNotNone(self.find_or_none(BY.key(RECOMMEND_SECTION), timeout=1))
+        self.assertEqual(self.input_value(), "", "清空后搜索框应为空")
+        self.assertTrue(self.on_search_page(), "清空后应仍在搜索页")
+        # 清空后重新搜索，历史只剩新词
+        self.search_and_back("橙子")
+        self.assertEqual(self.wait_history("橙子"), ["橙子"])
+        # 再清空一次后重启，仍无历史
+        self.open_dialog()
+        self.driver.click(self.require_text(TEXT_CONFIRM, "确认框缺少“确认”"))
+        self.driver.wait(1)
+        self.launch()
+        self.open_search()
+        self.assertIsNone(self.find_or_none(BY.text(TEXT_HISTORY), timeout=3), "重启后不应有历史")
+
+    def test_a34_back_key_closes_dialog_only(self):
+        """A34：确认框打开时按返回键只关框，历史不变、仍在搜索页。"""
+        self.seed("手机")
+        self.open_dialog()
+        for _ in range(2):
+            self.driver.press_back()
+            self.driver.wait(1)
+            if self.find_or_none(BY.text(TEXT_CLEAR_MESSAGE), timeout=1) is None:
+                break
+        self.assertIsNone(self.find_or_none(BY.text(TEXT_CLEAR_MESSAGE), timeout=1), "返回键未关闭确认框")
+        self.assertTrue(self.on_search_page(), "返回键关闭确认框时不应退出搜索页")
+        self.assertEqual(self.history(), ["手机"])
diff --git a/hypium_tests/test_scenario4_edge.py b/hypium_tests/test_scenario4_edge.py
