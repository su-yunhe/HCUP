+[{"id":20001,"word":"慌不择路","pinyin":"huāng bù zé lù","abbr":"hbzl","explanation":"势急心慌，顾不上选择道路。","source":{"text":"陀满兴福来到此间，所谓慌不择路，饥不择食，只得结集亡命，哨聚山森。","book":"元·施惠《幽闺记·山寒巡逻》"},"example":{"text":"饥不择食，寒不择衣，～，贫不择妻。","book":"明·施耐庵《水浒全传》第三回"},"similar":["饥不择食","急不择途"],"usage":"作谓语、定语；指十分慌乱"},{"id":20002,"word":"慌作一团","pinyin":"huāng zuò yī tuán","abbr":"hzyt","explanation":"形容极为慌张。","source":{"text":"萧长贵正在自己兵船上睡觉，忽听得外面一派人声，接着又有洋枪、洋炮声音，拿他从睡梦中惊醒，直把他吓得索索的抖，在被窝里慌作一团。","book":"清·李宝嘉《官场现形记》第五十五回"}},{"id":20003,"word":"慌做一团","pinyin":"huāng zuò yī tuán","abbr":"hzyt","explanation":"形容极为慌张。同“慌作一团”。","source":{"text":"晁夫人知道儿子当真做了这事，又见他病将起来，只怕是报应得恁快，慌做一团，要与晁老说知，赔那两个的衣物。","book":"清·西周生《醒世姻缘传》第十六回"}},{"id":20004,"word":"慌做一堆","pinyin":"huāng zuò yī duī","abbr":"hzyd","explanation":"慌：惊慌。惊慌得乱成一团，理不清头绪。","source":{"text":"众兵都在烂泥里慌做一堆。","book":"明·施耐庵《水浒传》第19回"},"similar":["慌做一团"],"usage":"作谓语、状语；用于处事等"},{"id":20005,"word":"慌张失措","pinyin":"huāng zhāng shī cuò","abbr":"hzsc","explanation":"慌张：惊慌失措。惊恐慌张得不知所措。","source":{"text":"一天竟对着素园咯起来，他慌张失措，用了爱和忧急的声音命令道：‘你不许再吐了！’","book":"鲁迅《忆韦素园君》"},"similar":["惊惶失措"],"usage":"作谓语、状语；指十分恐慌"},{"id":20006,"word":"慌慌张张","pinyin":"huāng huāng zhāng zhāng","abbr":"hhzz","explanation":"形容举止慌张，不稳重。","source":{"text":"身上穿得整整齐齐，脚儿走得慌慌张张，望着园门欲进不进的。","book":"明·冯梦龙《喻世明言·陈御史巧勘金钗钿》"},"example":{"text":"你～的是为什么？"},"similar":["慌手慌脚"],"opposite":["稳如泰山","从容不迫"],"usage":"作定语、状语；指不稳重"},{"id":20007,"word":"慌慌忙忙","pinyin":"huāng huāng máng máng","abbr":"hhmm","explanation":"指手忙脚乱、焦急不安或精神慌乱。","source":{"text":"那看灯几个喽啰，听了这话，慌慌忙忙的奔出城来道：……","book":"清·褚人获《隋唐演义》第18回"},"example":{"text":"清·褚人获《隋唐演义》第18回：“那看灯几个喽啰，听了这话，～的奔出城来道：……”"},"similar":["慌慌速速","慌里慌张"],"usage":"作定语、状语；用于处事"},{"id":20008,"word":"慌慌急急","pinyin":"huāng huāng jí jí","abbr":"hhjj","explanation":"慌：忙乱，恐慌。形容举止慌乱。","source":{"text":"恰才饮得三杯，只见女使锦儿慌慌急急，红了脸，在墙缺边叫道：‘官人休要坐地！娘子在庙中和人合口。’","book":"明·施耐庵《水浒传》第七回"},"similar":["匆匆忙忙","慌慌张张"],"usage":"作定语、状语；用于处事"},{"id":20009,"word":"慌手忙脚","pinyin":"huāng shǒu máng jiǎo","abbr":"hsmj","explanation":"形容动作忙乱。同“慌手慌脚”。","source":{"text":"吓得常禄也不敢哭，劝了母亲，慌手忙脚的，去找普焕亭。","book":"《春阿氏谋夫案》第十八回"},"example":{"text":"嗗拉巴唧向小姑娘一点头，～的跑出去。","book":"老舍《小坡的生日》十二"},"similar":["慌手慌脚"],"opposite":["从容不迫"],"usage":"作定语、状语；指人的举止"},{"id":20010,"word":"慌手慌脚","pinyin":"huāng shǒu huāng jiǎo","abbr":"hshj","explanation":"形容动作忙乱的样子。","source":{"text":"这时候我看着也是吓的慌手慌脚的了。","book":"清·曹雪芹《红楼梦》第八十五回"},"example":{"text":"嗗拉巴唧向小姑娘一点头，～的跑出去。","book":"老舍《小坡的生日》二"},"similar":["慌慌张张","慌里慌张"],"opposite":["稳如泰山","从容不迫"],"usage":"作定语、状语；指人的举止"},{"id":20011,"word":"慌里慌张","pinyin":"huāng lǐ huāng zhāng","abbr":"hlhz","explanation":"指焦急不安或精神慌乱。","source":{"text":"我娘慌里慌张地想站起来，她站到一半腿一松，身体又掉到地上。","book":"余华《活着》"},"example":{"text":"他～不知如何是好。"},"similar":["慌手慌脚"],"opposite":["镇定自若"],"usage":"作谓语、状语；指不安"},{"id":20012,"word":"慎于接物","pinyin":"shèn yú jiē wù","abbr":"syjw","explanation":"慎：谨慎；物：别人，众人。在待人接物时小心谨慎。","source":{"text":"曩者辱赐节，教以慎于接物，推贤进士为务。","book":"汉·司马迁《报任少卿书》"}},{"id":20013,"word":"慎以行师","pinyin":"shèn yǐ xíng shī","abbr":"syxs","explanation":"慎：谨慎；师：军队。出兵作战一定要非常谨慎。","source":{"text":"慎以行师，至道也。","book":"明·揭暄《兵经百篇·谨字》"}},{"id":20014,"word":"慎始慎终","pinyin":"shèn shǐ shèn zhōng","abbr":"sssz","explanation":"事情从开始到结束都谨慎小心。","source":{"text":"故先王之所重者，唯始与终。","book":"《战国策·秦策五》"},"example":{"text":"臣刘墉两世追随皇上，～，若不为皇上父子着想，只合随波逐流，何必在皇上面前再三饶舌？","book":"二月河《乾隆皇帝》二十七"}},{"id":20015,"word":"慎始敬终","pinyin":"shèn shǐ jìng zhōng","abbr":"ssjz","explanation":"敬：慎。自始自终都谨慎。","source":{"text":"易曰：‘正其本而万物理，失之毫厘，差以千里，故君子慎始。’春秋之元，诗之关雎，礼之冠婚，易之乾坤，皆慎始敬终云尔。","book":"《礼记·表记》：“子曰：事君慎始而敬终。”汉·贾谊《新书·胎教》"},"example":{"text":"忧懈怠则思慎始而敬终。","book":"唐·魏征《谏太宗十思疏》"}},{"id":20016,"word":"慎小事微","pinyin":"shèn xiǎo shì wēi","abbr":"sxsw","explanation":"谨慎对待微小的事情。","source":{"text":"昔者圣王本厚民生，审知祸福之所生，是故慎小事微，违非索辨以根之。","book":"《管子·君臣下》"},"similar":["慎小谨微"],"usage":"作谓语、定语、状语；用于处事"},{"id":20017,"word":"慎小谨微","pinyin":"shèn xiǎo jǐn wēi","abbr":"sxjw","explanation":"对细小的事也小心对待。","source":{"text":"古帝王慎小谨微必矜细行者，正以欲不可纵，渐不可长也。","book":"《明史·章懋传》"},"similar":["慎小事微"],"usage":"作谓语、定语、状语；用于处事"},{"id":20018,"word":"慎终于始","pinyin":"shèn zhōng yú shǐ","abbr":"szys","explanation":"指结束时想要慎重，在开始时就要小心谨慎。","source":{"text":"无轻民事惟难，无安厥位惟危，慎终于始。","book":"《书·太甲下》"},"usage":"作谓语、定语；用于处事"},{"id":20019,"word":"慎终如初","pinyin":"shèn zhōng rú chū","abbr":"szrc","explanation":"慎：谨慎；如：象。谨慎收尾，如同开始时一样。指始终要谨慎从事。","source":{"text":"慎终如始，则无败事。","book":"《老子》第六十四章"},"example":{"text":"温温恭人，～。","book":"晋·卢谌《赠刘琨诗》"},"similar":["慎终如始","慎终若始","慎终承始"],"usage":"作谓语、定语；指始终要谨慎从事"},{"id":20020,"word":"慎终如始","pinyin":"shèn zhōng rú shǐ","abbr":"szrs","explanation":"慎：谨慎；如：象。谨慎收尾，如同开始时一样。指始终要谨慎从事。","source":{"text":"慎终如始，则无败事。","book":"《老子》第六十四章"},"example":{"text":"肃矣我祖，～；直方二台，惠和千里。","book":"晋·陶潜《命子》诗"},"similar":["慎终如初","慎终若始","慎终承始"],"opposite":["虎头蛇尾"],"usage":"作谓语、定语；指始终要谨慎从事"},{"id":20021,"word":"慎终思远","pinyin":"shèn zhōng sī yuǎn","abbr":"szsy","explanation":"终：人死；慎终：居丧能遵守礼法；远：指祖先。指慎重地办理父母丧事，虔诚地祭祀远代祖先。","source":{"text":"有子故光禄少卿玙，今秘书监询，皆笃行纯孝，慎终思远。","book":"唐·张说《太原王公神道碑》"},"similar":["慎终追远","谨终追远","追远慎终"],"usage":"作谓语、宾语；指旧的礼法"},{"id":20022,"word":"慎终承始","pinyin":"shèn zhōng chéng shǐ","abbr":"szcs","explanation":"谨慎收尾，如同开始时一样。指始终要谨慎从事。同“慎终如始”。","source":{"text":"明·刘基《春秋明经·公会齐侯云云盟于牡丘宋人伐曹楚人败徐于娄林》常谓齐内以治外者善谋也，慎终以承始者善道也。”"},"similar":["慎终如始","慎终如始","慎终如初"],"usage":"作谓语、定语；指始终要谨慎从事"},{"id":20023,"word":"慎终若始","pinyin":"shèn zhōng ruò shǐ","abbr":"szrs","explanation":"指始终要谨慎从事。同“慎终如始”。","source":{"text":"不轻寡，不动于敌，慎终若始。","book":"银雀山汉墓竹简《孙膑兵法·将德》"},"similar":["慎终如始","慎终如始","慎终承始"],"usage":"作谓语、定语；指始终要谨慎从事"},{"id":20024,"word":"慎终追远","pinyin":"shèn zhōng zhuī yuǎn","abbr":"szzy","explanation":"终：人死；远：指祖先。旧指慎重地办理父母丧事，虔诚地祭祀远代祖先。后也指谨慎从事，追念前贤。","source":{"text":"曾子曰：‘慎终追远，民德归厚矣。’","book":"《论语学而》"},"example":{"text":"五间正殿前，悬一块闹龙填青匾，写道是：“～”。","book":"清·曹雪芹《红楼梦》第五十三回"},"similar":["慎终思远","谨终追远"],"usage":"作谓语、宾语；指旧的礼法"},{"id":20025,"word":"慎言慎行","pinyin":"shèn yán shèn xíng","abbr":"sysx","explanation":"言行都十分小心注意。","example":{"text":"她是一个～的人，不会乱来的。"},"usage":"作谓语、宾语、定语；用于处世"},{"id":20026,"word":"慎身修永","pinyin":"shèn shēn xiū yǒng","abbr":"ssxy","explanation":"为长治久安而真诚修身。","source":{"text":"慎厥身修思永。","book":"《尚书·皋陶谟》"},"example":{"text":"公卿大夫其勉思天戒，～，以辅朕之不逮。","book":"东汉·班固《汉书·元帝纪》"},"usage":"作谓语、定语；指人修身养性"},{"id":20027,"word":"慎重其事","pinyin":"shèn zhòng qí shì","abbr":"szqs","explanation":"指对某一事的态度严肃认真。","source":{"text":"某观察却慎重其事的说道：‘这是兄弟始创的一个大公司。’","book":"《二十年目睹之怪现状》第八一回"},"example":{"text":"主任这才又～擦去鼻尖上的水。","book":"沙汀《代理县长》"},"similar":["谨慎从事","郑重其事"],"usage":"作谓语、定语；用于处事"},{"id":20028,"word":"慎重初战","pinyin":"shèn zhòng chū zhàn","abbr":"szcz","explanation":"慎重：谨慎重视；初战：第一仗。慎重地对待在战略、战役全局上有决定意义的第一仗。","example":{"text":"许多资产阶级军事家都主张～，不论在战略防御或战略进攻皆然，而以防御为尤甚。","book":"毛泽东《中国革命战争的战略问题》"}},{"id":20029,"word":"慎防杜渐","pinyin":"shèn fáng dù jiàn","abbr":"sfdj","explanation":"犹防微杜渐。比喻在坏事情坏思想萌芽的时候就加以制止，不让它发展。","source":{"text":"朝廷易置将帅，必采之公卿，断自宸衷，所以慎防杜渐，示臣下不敢专也。","book":"《明史·王邦瑞传》"},"similar":["防微杜渐"],"usage":"作谓语、定语、宾语；指事前预防"},{"id":20030,"word":"慕古薄今","pinyin":"mù gǔ bó jīn","abbr":"mgbj","explanation":"慕：羡慕，仰慕；薄：轻薄。指厚古薄今。","source":{"text":"贵远贱近，慕古薄今，天下之通情也。","book":"清·李渔《闲情偶寄·词曲·音律》"},"example":{"text":"～的做法是不明智的。"},"similar":["厚古薄今"],"opposite":["今非昔比"],"usage":"作主语、定语、宾语；指厚古薄今"},{"id":20031,"word":"慕名而来","pinyin":"mù míng ér lái","abbr":"mmel","explanation":"指仰慕名声而来。","source":{"text":"不少中外旅游者纷纷慕名而来，西安更成了世人瞩目的地方。","book":"《人民日报》1982.3.14"},"example":{"text":"我们不要～，败兴而归。"},"opposite":["败兴而归"],"usage":"作谓语；指仰慕名声而来"},{"id":20032,"word":"慞惶失次","pinyin":"zhāng huáng shī cì","abbr":"zhsc","explanation":"慞惶：彷徨疑惧的样子；次：次第，常态。形容惊恐失态。","source":{"text":"守真受教而往，方至其家，坐于客馆，而歧哥已觉，慞惶失次。","book":"宋·张君房《云笈七签》第103卷"},"similar":["惊惶失措","张皇失措","张皇失错"],"usage":"作谓语、定语、状语；指十分惊恐"},{"id":20033,"word":"慢声细语","pinyin":"màn shēng xì yǔ","abbr":"msxy","explanation":"形容说话时声音轻柔。","source":{"text":"老大哥看出牢房里只剩他两人时，就慢声细语地问他。","book":"罗广斌《红岩》第12章"},"similar":["轻言细语"],"usage":"作谓语、状语；用于说话等"},{"id":20034,"word":"慢工出细活","pinyin":"màn gōng chū xì huó","abbr":"mgcxh","explanation":"指不急于求成，精心制作，才能出完美的产品。","source":{"text":"只要不限辰光，‘慢工出细活’一定的道理。","book":"高阳《胡雪岩全传·灯火楼台》"},"example":{"text":"～，不要心急，你会成功的。"},"usage":"作宾语、定语；用于劝诫人"},{"id":20035,"word":"慢弛之阙","pinyin":"man chi zi que","abbr":"mczq","explanation":"傲慢懒散的缺点。"},{"id":20036,"word":"慢慢吞吞","pinyin":"màn màn tūn tūn","abbr":"mmtt","explanation":"缓慢的样子，动作非常慢，指做事没有效率。","source":{"text":"不能慢慢吞吞，拖拖拉拉，议而不决，决而不行。","book":"邓小平《在全军政治工作会议上的讲话》"},"example":{"text":"余华《活着》：“我不再说什么，看着她～往城里走。”"},"opposite":["雷厉风行"],"usage":"作谓语、定语、状语；用于做事等"},{"id":20037,"word":"慢慢腾腾","pinyin":"màn màn tēng tēng","abbr":"mmtt","explanation":"形容运动非常缓慢。","source":{"text":"一路上，他由着牛的性子走，并不催促它，因此慢慢腾腾，三十里走了将近双水村了。","book":"路遥《平凡的世界》第一卷第十章"},"example":{"text":"他赶着牛车在回家的路上～地走着。"},"similar":["慢条斯理"],"opposite":["健步如飞"],"usage":"作状语、定语；形容非常缓慢"},{"id":20038,"word":"慢易生忧","pinyin":"màn yì shēng yōu","abbr":"mysy","explanation":"慢：疏慢；易：轻易；忧：忧愁。疏慢轻易必然坏事，因而产生忧愁。","source":{"text":"思索生知，慢易生忧，暴傲生怨，忧郁生疾。","book":"《管子·内业》"},"usage":"作宾语、定语；用于劝诫人"},{"id":20039,"word":"慢条丝礼","pinyin":"màn tiáo sī lǐ","abbr":"mtsl","explanation":"原指说话做事有条有理，不慌不忙。现也形容说话做事慢腾腾，不不慌不忙。同“慢条斯理”。","source":{"text":"你问他，我去时还在厨房里雌着，等他慢条丝礼儿才和面儿。","book":"明·兰陵笑笑生《金瓶梅词话》第11回"},"similar":["慢条厮礼","慢腾斯礼","慢条斯理"],"usage":"作定语、状语；用于处事"},{"id":20040,"word":"慢条厮礼","pinyin":"màn tiáo sī lǐ","abbr":"mtsl","explanation":"原指说话做事有条有理，不慌不忙。现也形容说话做事慢腾腾，不不慌不忙。同“慢条斯理”。","source":{"text":"那春梅只顾不进房来，叫了半日，才慢条厮礼，推开房门进来。","book":"明·兰陵笑笑生《金瓶梅词话》第12回"},"similar":["慢条丝礼","慢腾斯礼","慢条斯理"],"usage":"作定语、状语；用于处事"},{"id":20041,"word":"慢条斯理","pinyin":"màn tiáo sī lǐ","abbr":"mtsl","explanation":"原指说话做事有条有理，不慌不忙。现也形容说话做事慢腾腾，不不慌不忙。","source":{"text":"写红娘从张生边来入闺中，慢条斯理，如在意如不在意。","book":"元·王实甫《西厢记》第三本第二折金圣叹批"},"example":{"text":"“办事要思量是对的”，老山东～的说，“不过有的是明摆着的事，也不要掂量。”","book":"冯德英《苦菜花》第八章"},"similar":["从容不迫","蜗行牛步"],"opposite":["快马加鞭","风风火火","大步流星"],"usage":"作谓语、定语、状语；形容做事缓慢","story":["从前放牛娃王冕天性聪明，善于画荷花，画出的荷花就像刚从水里摘下贴在纸上一样。他不求官也不结交朋友，终日在家读书作画。官府请他画几幅荷花送给上司，他推辞不掉画了几张。知县惊叹他的才华就亲自去拜访他，他慢条斯理地出门迎接"]},{"id":20042,"word":"慢条斯礼","pinyin":"màn tiáo sī lǐ","abbr":"mtsl","explanation":"原指说话做事有条有理，不慌不忙。现也形容说话做事慢腾腾，不不慌不忙。同“慢条斯理”。","source":{"text":"这时候诸大臣全慢条斯礼的来到，向张秃子深深的鞠躬。","book":"老舍《小坡的生日》"},"similar":["慢腾斯礼"],"opposite":["大步流星","大刀阔斧"],"usage":"作谓语、定语、状语；形容做事缓慢"},{"id":20043,"word":"慢腾斯礼","pinyin":"màn téng sī lǐ","abbr":"mtsl","explanation":"原指说话做事有条有理，不慌不忙。现也形容说话做事慢腾腾，不不慌不忙。同“慢条斯理”。","source":{"text":"既是明天一黑早要复命的，怎么还你们慢腾斯礼的呢？","book":"清·刘鹗《老残游记》第13回"},"similar":["慢条斯理","慢条斯礼"],"opposite":["风风火火"],"usage":"作谓语、定语、状语；形容做事缓慢"},{"id":20044,"word":"慢藏诲盗","pinyin":"màn cáng huì dào","abbr":"mchd","explanation":"慢藏：收藏不慎；诲：教导。收藏财物不慎，等于诱人偷窃。","source":{"text":"慢藏诲盗，冶容诲淫。","book":"《周易·系辞上》"},"example":{"text":"古圣人所教的“～，冶容诲淫”，就是说子女玉帛的处理方法，是应该坚壁清野的。","book":"鲁迅《坟·坚壁清野主义》"},"similar":["冶容诲淫"],"usage":"作谓语、宾语；因保管疏忽而招致盗窃"},{"id":20045,"word":"慧业才人","pinyin":"huì yè cái rén","abbr":"hycr","explanation":"指有文学天才并与文字结为业缘的人。同“慧业文人”。","source":{"text":"别有慧业才人，创造险语，鬼斧默运，奇句自矜。","book":"刘师培《文说》"},"similar":["慧业文人"],"usage":"作主语、宾语；用于书面语"},{"id":20046,"word":"慧业文人","pinyin":"huì yè wén rén","abbr":"hywr","explanation":"指有文学天才并与文字结为业缘的人。","source":{"text":"得道应须慧业文人，生天当在灵运前，成佛必在灵运后。","book":"《宋书·谢灵运传》"},"example":{"text":"扫眉才子，～，时节因缘，不得不为延津之合矣。","book":"清·余怀《板桥杂记·轶事》"},"similar":["慧业才人"],"usage":"作主语、宾语；用于书面语"},{"id":20047,"word":"慧中秀外","pinyin":"huì zhōng xiù wài","abbr":"hzxw","explanation":"慧：聪明；秀：秀丽。内心聪明，外表秀丽。","source":{"text":"曲眉丰颊，清声而便体，秀外而慧中。","book":"唐·韩愈《送李愿归盘谷序》"},"example":{"text":"秦中某公子者，～，素有璧人之誉。","book":"清·许叔平《里乘·某公子》"}},{"id":20048,"word":"慧心妙舌","pinyin":"huì xīn miào shé","abbr":"hxms","explanation":"资质聪颖，口才犀利。","source":{"text":"此公慧心妙舌，坡公后一人而已。","book":"清·周亮工《书影》卷三"},"example":{"text":"虽具～，然此体亦不必效颦也。","book":"清·徐轨《词苑丛谈·董文友以七字为韵》"}},{"id":20049,"word":"慧心巧思","pinyin":"huì xīn qiǎo sī","abbr":"hxqs","explanation":"心地聪慧，构思精巧。多用以形容女子技艺精巧，别出心裁。","source":{"text":"妃子慧心巧思，可谓出神入化矣。","book":"清·禇人获《隋唐演义》第四十七回"},"usage":"作谓语、定语；用于女性"},{"id":20050,"word":"慧心灵性","pinyin":"huì xīn líng xìng","abbr":"hxlx","explanation":"慧心：聪明。形容人聪明灵巧。","source":{"text":"虽是乡间女儿，露着慧心灵性，温柔不俗。","book":"清　·文康《儿女英雄传》第七回"},"usage":"作宾语、定语；指人很聪明"},{"id":20051,"word":"慧眼独具","pinyin":"huì yǎn dú jù","abbr":"hydj","explanation":"在眼力或洞察力方面有独到之处。","example":{"text":"我在这方面真是～，无人能比。"},"similar":["独具慧眼"],"usage":"作谓语、宾语；指人有眼力"},{"id":20052,"word":"慧眼识英雄","pinyin":"huì yǎn shí yīng xióng","abbr":"hysyx","explanation":"慧眼：佛教所说的“五眼”之一，今泛指敏锐的眼力。称赞人善于识别人才。"},{"id":20053,"word":"慨乎言之","pinyin":"kǎi hū yán zhī","abbr":"khyz","explanation":"慨：感慨。形容非常有感触地谈论某事。","source":{"text":"庐山僧光熊哭兄诗云：‘身经刀过头方贵，尸不泥封骨始香。’沈着痛快，慨乎言之。","book":"清·柴萼《梵天庐从录》"},"example":{"text":"管他死得值与不值，该与不该，谁还忍心批评他的是非得失呢？～！","book":"蔡东藩、许廑父《民国通俗演义》第一百二十一回"}},{"id":20054,"word":"慨当以慷","pinyin":"kǎi dāng yǐ kāng","abbr":"kdyk","explanation":"与“慷慨”意思相同，指充满正气，情绪激动。“当以”无实际意义。","source":{"text":"慨当以慷，忧思难忘。","book":"汉·曹操《短歌行》"},"example":{"text":"与知己别来十年，而此生遭际，～，乃有出于契阔之外者。","book":"清·侯方域《复倪玉纯书》"},"usage":"作谓语、定语；用于书面语"},{"id":20055,"word":"慨然允诺","pinyin":"kǎi rán yǔn nuò","abbr":"kryn","explanation":"慨然：慷慨、爽快。形容豪不犹豫地答应下来。","source":{"text":"孟良慨然允诺，自令人缚己于柱上。","book":"明·无名氏《杨家将演义》第35回"},"example":{"text":"他～一定会帮你渡过难关。"},"similar":["慨然应允"],"usage":"作谓语；指很慷慨地答应"},{"id":20056,"word":"慨然应允","pinyin":"kǎi rán yīng yǔn","abbr":"kryy","explanation":"慨然：慷慨、爽快。形容豪不犹豫地答应下来。","source":{"text":"令婆召孟良入与言其事，孟良慨然领诺。","book":"明·无名氏《杨家将演义》第二十七回"},"example":{"text":"张君是认定《浮士德》有可译价值的之一人，我也是认为有可译的价值的，所以我当时也就～了。","book":"郭沫若《论文学的研究与介绍》"},"similar":["慨然允诺"],"usage":"作谓语；指答应很爽快"},{"id":20057,"word":"慨然领诺","pinyin":"kǎi rán lǐng nuò","abbr":"krln","explanation":"慨然：慷慨、爽快。形容很慷慨地答应下来。","source":{"text":"令婆召孟良入与言其事，孟良慨然领诺。","book":"明·无名氏《杨家将演义》第35回"},"similar":["慨然允诺"],"usage":"作谓语；指很慷慨地答应"},{"id":20058,"word":"慰情聊胜于无","pinyin":"wèi qíng liáo shèng yú wú","abbr":"wqlsyw","explanation":"慰：安慰；聊：略微。得到的安慰，比没有要好一点。","source":{"text":"弱女虽非男，慰情聊胜无。","book":"晋·陶潜《和刘柴桑》诗"},"example":{"text":"众虽感不满，而木已成舟，无可如何，犹幸已允补偿，亦可～。","book":"丁中江《北洋军阀史话》一百二十七"}},{"id":20059,"word":"慰情胜无","pinyin":"wèi qíng shèng wú","abbr":"wqsw","explanation":"作为自我宽慰的话。","source":{"text":"弱女虽非男，慰情聊胜无。","book":"晋·陶潜《和刘柴桑》诗"}},{"id":20060,"word":"慰荐抚循","pinyin":"wèi jiàn fǔ xún","abbr":"wjfx","explanation":"慰荐：安慰；抚循：抚慰。指安慰、抚慰。","source":{"text":"故未服之时，劳师远攻，倾国殚货，伏尸流血，破坚拔敌，如彼之难也；既服之后，慰荐抚循，交接赂遗，威仪俯仰，如此之备也。","book":"《汉书·匈奴传下》"}},{"id":20061,"word":"慷他人之慨","pinyin":"kāng tā rén zhī kǎi","abbr":"ktrzk","explanation":"利用他人的财物作人情或装饰场面。","source":{"text":"满生总是慷他人之慨，落得快活。","book":"明·凌濛初《二刻拍案惊奇》第11卷"},"example":{"text":"你说他们～吗？不然。","book":"叶圣陶《老沈的儿子》"},"usage":"作谓语、宾语；指作顺手人情"},{"id":20062,"word":"慷慨仗义","pinyin":"kāng kǎi zhàng yì","abbr":"kkzy","explanation":"仗义：讲义气。为了讲情谊或主持公道而毫不吝啬地帮助别人。","source":{"text":"象你做这样慷慨仗义的事，我心里喜欢，只是也要看来说话的是个什么样的人。","book":"清·吴敬梓《儒林外史》第二十回"},"example":{"text":"黄兄～，弟虽力薄，亦可少助之。","book":"清·黄小配《洪秀全演义》第九回"},"usage":"作谓语、定语；指人很大方"},{"id":20063,"word":"慷慨就义","pinyin":"kāng kǎi jiù yì","abbr":"kkjy","explanation":"慷慨：情绪激昂；就义：为正义而死。正气凛然，意气高昂地为正义而死。","source":{"text":"大丈夫当慷慨赴义，何用悲为！","book":"明·朱鼎《玉镜台记·王敦反》"},"example":{"text":"并且接着不久被敌人逮捕，在敌人面前坚强不屈，～。","book":"《毛泽东选集》第三卷《附录：关于若干历史问题的决议》"},"similar":["为国捐躯"],"opposite":["苟且偷生"],"usage":"作谓语、宾语；指为正义而牺牲"},{"id":20064,"word":"慷慨悲歌","pinyin":"kāng kǎi bēi gē","abbr":"kkbg","explanation":"情绪激昂地唱歌，以抒发悲壮的胸怀。","source":{"text":"慷慨独悲歌，钟期信为贤。","book":"《史记·项羽本纪》：“于是项王乃悲歌慷慨。”晋·陶潜《怨诗楚调示庞主簿邓治中》"},"example":{"text":"～士，相传燕赵多。","book":"清·黄遵宪《慷慨》诗"},"similar":["悲歌慷慨"],"usage":"作谓语、定语；指情绪激昂地唱歌"},{"id":20065,"word":"慷慨捐生","pinyin":"kāng kǎi juān shēng","abbr":"kkjs","explanation":"慷慨：意气激昂。捐生：舍弃生命。正义凛然地献出生命。","source":{"text":"从容就狱申王法，慷慨捐生报主恩。","book":"明·冯梦龙《喻世明言》卷三十九"},"example":{"text":"娘娘既～，望万岁爷以社稷为重，勉强割恩罢。","book":"清·洪昇《长生殿·埋玉》"},"usage":"作谓语；用于为国捐躯"},{"id":20066,"word":"慷慨淋漓","pinyin":"kāng kǎi lín lí","abbr":"kkll","explanation":"淋漓：充盛，畅快。形容说话、写文章意气昂扬，言辞畅快。","example":{"text":"他慷慨淋漓地抒发他当时的感受。"},"similar":["慷慨陈词"],"opposite":["笨嘴笨舌"],"usage":"作状语；形容说话、写文章意气昂扬"},{"id":20067,"word":"慷慨激扬","pinyin":"kāng kǎi jī yáng","abbr":"kkjy","explanation":"激扬：振奋昂扬。精神振奋，意气昂扬。形容情绪、语调激动昂扬而充满正气。","source":{"text":"孝宽慷慨激扬，略无顾意，士卒莫不激励，人有死难之心。","book":"汉·李陵《录别诗》：“悲意何慷慨，清歌正激扬。”《周书·韦孝宽传》"},"similar":["慷慨激昂"],"usage":"作谓语、定语、状语；指人的语气"},{"id":20068,"word":"慷慨激昂","pinyin":"kāng kǎi jī áng","abbr":"kkja","explanation":"慷慨：情绪激动；激昂：振奋昂扬。精神振奋，情绪激昂，充满正气。","source":{"text":"今将慷慨激昂，奋攘布衣，纵谈作者之筵，曳裾名卿之门。","book":"汉·李陵《录别诗》：“悲意何慷慨，清歌正激扬。”唐·柳宗元《上权舆补阙温卷决进退启》"},"example":{"text":"在东京聚首时，一谈到国事上来，总要谈得～，而且有点口角流沫。","book":"郭沫若《革命春秋·创造十年续篇》"},"similar":["热血沸腾","意气风发"],"opposite":["委靡不振","无精打采"],"usage":"作谓语、定语、状语；指情绪激昂","story":["战国末期，燕太子丹从秦国逃回，访到义士荆轲与高渐离，请荆轲去刺杀秦王嬴政。一切准备就绪，太子丹率手下着白装送他们到易水边，高渐离击筑，荆轲高唱：“风萧萧兮易水寒，壮士一去兮不复还！”歌声慷慨而激昂，感人肺腑，一行人洒泪告别"]},{"id":20069,"word":"慷慨激烈","pinyin":"kāng kǎi jī liè","abbr":"kkjl","explanation":"精神振奋，情绪激昂，充满正气。同“慷慨激昂”。","source":{"text":"燧见其古文绡厉有法及歌行古乐府慷慨激烈，大奇之。","book":"《元史·小云石海涯传》"},"example":{"text":"萧后见其～，神采超群，心甚爱之。","book":"《杨家将演义》第五回"},"usage":"作谓语、状语；用于人的情绪"},{"id":20070,"word":"慷慨解囊","pinyin":"kāng kǎi jiě náng","abbr":"kkjn","explanation":"慷慨：豪爽，大方；解囊：解开钱袋拿出钱来。形容极其大方地在经济上帮助别人。","source":{"text":"鲁智深见李忠、周通不是慷慨之人，做事悭吝，只要下山。","book":"明·施耐庵《水浒传》"},"example":{"text":"因此只得不揣冒昧，向大公子求将伯之助，不知公子肯～否？","book":"姚雪垠《李自成》第二卷第18章"},"similar":["助人为乐","解囊相助"],"opposite":["一毛不拔"],"usage":"作谓语、宾语；指乐于助人"},{"id":20071,"word":"慷慨赴义","pinyin":"kāng kǎi fù yì","abbr":"kkfy","explanation":"慷慨：意气激昂，情绪激动；赴义：为正义而死。指大义凛然地为正义献身。","source":{"text":"大丈夫当慷慨赴义，何用悲为！","book":"明·朱鼎《玉镜台记·王敦反》"},"example":{"text":"材伏哭叩头，举火，烈妇死，三十余人从死，其～如此。","book":"清·王猷定《梁烈妇传》"},"similar":["慷慨就义"],"usage":"作谓语；指为正义献身"},{"id":20072,"word":"慷慨输将","pinyin":"kāng kǎi shū jiāng","abbr":"kksj","explanation":"毫不吝啬地捐献财物帮助人。多用在对社会对群众。","source":{"text":"陛下幸募民相徙以实塞下，使屯戍之事益省，输将之费益寡。","book":"东汉·班固《汉书·晁错传》"},"example":{"text":"中国人虽然捉襟见肘，也曾～，在那时学艺社是尽了很大的力量的。","book":"郭沫若《学生时代·创造十年续篇》"},"usage":"作谓语；多用在对社会对群众"},{"id":20073,"word":"慷慨陈词","pinyin":"kāng kǎi chén cí","abbr":"kkcc","explanation":"慷慨：情绪激动，充满正气；陈：陈述；词：言词。指意气激昂地陈述自己的见解。","source":{"text":"元丰之末，附丽匪人，自为定策，至造诈以诬首相，则畴昔从容问学，慷慨陈义，而诸君子之所深与者也。","book":"宋·陆九渊《荆国王文公祠堂记》"},"example":{"text":"元末群盗纵横，时事不堪言矣。诗家～，多衰飒无余地。","book":"潘德舆《养一斋诗话》"},"similar":["慷慨激昂","义正言辞"],"opposite":["张口结舌"],"usage":"作谓语、宾语；指情绪激动"},{"id":20074,"word":"憋气窝火","pinyin":"biē qì wō huǒ","abbr":"bqwh","explanation":"憋：闷在心里。压住性子，把屈辱或烦恼强压在心里。","example":{"text":"放宽心点，不要～伤害身体。"},"similar":["窝火憋气"],"usage":"作谓语、状语、定语；指憋在心里"},{"id":20075,"word":"憎爱分明","pinyin":"zēng ài fēn míng","abbr":"zafm","explanation":"憎：恨。恨什么，爱什么，界限清楚，态度鲜明。","source":{"text":"憎爱分明的阶级立场，言行一致的革命精神，公而忘私的共产主义风格，奋不顾身的无产阶级斗志。","book":"周恩来《向雷锋同志学习》题词"},"similar":["爱憎分明"],"usage":"作谓语、定语、状语；指对人和物喜爱"},{"id":20076,"word":"憔神悴力","pinyin":"qiáo shén cuì lì","abbr":"qscl","explanation":"指竭尽心力。","source":{"text":"又将有他说者出，为群意气之所会，则又憔神悴力而趋之。","book":"清·曾国藩《送刘椒云南归序》"},"similar":["尽心尽力"],"usage":"作谓语、定语、状语；指尽心尽力"},{"id":20077,"word":"憨头憨脑","pinyin":"hān tóu hān nǎo","abbr":"hthn","explanation":"指纯真朴实或笨拙的样子","source":{"text":"你连这们个调度都没有，怪不得憨头憨脑六七百家输银子。","book":"清·李百川《绿野仙踪》第23回"},"similar":["笨头笨脑"],"usage":"作定语、状语；多用于口语"},{"id":20078,"word":"憨态可掬","pinyin":"hān tài kě jū","abbr":"htkj","explanation":"可掬：可以用手捧取。形容顽皮娇痴、单纯幼稚的样子充溢在外。招人喜爱。","source":{"text":"乡人馈馈，憨状可掬，其见笑于市人，有以哉。","book":"清·蒲松龄《聊斋志异·种梨》"}},{"id":20079,"word":"憨状可掬","pinyin":"hān zhuàng kě jū","abbr":"hzkj","explanation":"可掬：可以用手捧取。形容顽皮娇痴、单纯幼稚的样子充溢在外。招人喜爱。","source":{"text":"乡人愦愦，憨状可掬，其见笑于市人，有以哉。","book":"清·蒲松龄《聊斋志异·种梨》"},"example":{"text":"他那～的样子让人发笑。"},"similar":["憨态可掬"],"usage":"作谓语、定语；指招人喜爱"},{"id":20080,"word":"憬然有悟","pinyin":"jǐng rán yǒu wù","abbr":"jryw","explanation":"憬然：觉悟的样子。有所觉悟。","source":{"text":"憬，觉悟也。","book":"《诗经·颂泮水》：“憬彼淮夷，来献其琛。”朱熹"},"example":{"text":"这在曹雪芹自不免奇怪，再从头想一想，他刚才守口如瓶的那种诡秘神态，～。","book":"高附《曹雪芹别传》"},"similar":["如梦初醒","恍然大悟"],"opposite":["执迷不悟","死不改悔"],"usage":"作谓语；指有所觉悟"},{"id":20081,"word":"懊悔无及","pinyin":"ào huǐ wú jí","abbr":"ahwj","explanation":"后悔已来不及了。","source":{"text":"明·罗贯中《三国演义》第98回；“于是即令人往探之，果是虚营，只插着数十面旌旗，兵已去了二日也。曹真懊悔无及。”"},"example":{"text":"他现在才～。"},"similar":["后悔莫及"],"usage":"作谓语；指事后的态度"},{"id":20082,"word":"懊悔莫及","pinyin":"ào huǐ mò jí","abbr":"ahmj","explanation":"懊悔：悔恨。指后悔已经来不及。","example":{"text":"这已经既成事实，他～。"},"similar":["后悔莫及"],"usage":"作谓语、定语；指后悔"},{"id":20083,"word":"懋迁有无","pinyin":"mào qiān yǒu wú","abbr":"mqyw","explanation":"懋：通“贸”，贸易。买卖货物，互通有无。","source":{"text":"懋迁有无，化居。","book":"《尚书·益稷》"},"similar":["贸迁有无"],"usage":"作谓语、宾语；指买卖"},{"id":20084,"word":"懒不自惜","pinyin":"lǎn bù zì xī","abbr":"lbzx","explanation":"懒惰而不知自加爱惜。","source":{"text":"独其诗可行于世，而懒不自惜。","book":"宋·欧阳修《释秘演诗集序》"}},{"id":20085,"word":"懒懒散散","pinyin":"lǎn lǎn sǎn sǎn","abbr":"llss","explanation":"指人懒惰散漫。","source":{"text":"公坊披着件夏布小衫，踢着鞋在卧室里懒懒散散地迎出来道：‘什么独乐不独乐的乱喊？’","book":"曾朴《孽海花》第四回"},"usage":"作定语、状语；用于处事"},{"id":20086,"word":"懦弱无能","pinyin":"nuò ruò wú néng","abbr":"nrwn","explanation":"懦弱：软弱无能。形容胆小怕事，缺乏才能。","source":{"text":"名叫多官儿，因他懦弱无能，人都叫他‘多浑虫’。","book":"清·曹雪芹《红楼梦》第21回"},"example":{"text":"我们不能欺负～的人。"},"similar":["软弱无能"],"usage":"作谓语、定语；指人胆小怕事","story":["贾琏的女儿生病，他离开王熙凤独居寂寞难奈。想起懦弱无能酒头厨子多官的媳妇美貌无比、生性轻浮、拈花惹草，就打发小厮去与那娘子一说，她恰好也倾心于贾琏，于是贾琏就去相会，两人像干柴烈火一般热烈，从此勾搭上了"]},{"id":20087,"word":"懦词怪说","pinyin":"nuò cí guài shuō","abbr":"ncgs","explanation":"指荒诞无稽之谈。","source":{"text":"《易经大全》、《书经大全》，言九圈十圈之河图洛书，懦词怪说布满篇章。","book":"清·俞正燮《癸巳存稿·〈洪范〉洛书义》"},"usage":"作主语、宾语；指荒诞的言论"},{"id":20088,"word":"懵头转向","pinyin":"měng tóu zhuàn xiàng","abbr":"mtzx","explanation":"形容头脑昏乱，糊里糊涂。","example":{"text":"我～地往外走。"},"similar":["晕头转向"],"usage":"作状语；指人不清醒"},{"id":20089,"word":"懵懵懂懂","pinyin":"měng měng dǒng dǒng","abbr":"mmdd","explanation":"糊里糊涂，什么也不知道。","source":{"text":"呆子懵懵懂懂的，托着钵盂。","book":"明·吴承恩《西游记》第28回"},"example":{"text":"那些李逵式的官长，看见弟兄们犯事，就～地乱处置一顿。","book":"毛泽东《反对本本主义》"},"similar":["糊里糊涂"],"usage":"作谓语、定语、状语；指人不清醒"},{"id":20090,"word":"懵然无知","pinyin":"měng rán wú zhī","abbr":"mrwz","explanation":"懵：无知的样子。一无所知的样子。","source":{"text":"除读书属文外，其它懵然无知。","book":"唐·白居易《与元九书》"},"example":{"text":"王朔《许爷》：“一个～，只当他是嫖客，无耻纠缠。”"},"similar":["懵懵懂懂"],"usage":"作谓语、定语；用于不知情"},{"id":20091,"word":"懵里懵懂","pinyin":"měng lǐ měng dǒng","abbr":"mlmd","explanation":"指人糊里糊涂，神志模糊不清。","source":{"text":"人瑞惊觉，懵里懵懂的，睁开眼说道：‘呵，呵，信写好了吗？’","book":"清·刘鹗《老残游记》第16回"},"similar":["糊里糊涂"],"usage":"作谓语、定语、状语；多用于口语"},{"id":20092,"word":"懿范长存","pinyin":"yì fàn cháng cún","abbr":"yfcc","explanation":"懿范：美好的风范。美好的风范永远留存下去。多用于称颂妇女的品德好。","source":{"text":"思我懿范，万民未服。","book":"晋·陆云《赠颜骠骑后二首·有皇》"},"example":{"text":"坟前一块高大的石碑上，镌刻着“懿范长存”四个大字。坟墓周围，栽上成排的松柏。","book":"李文澄《努尔哈赤》二"}},{"id":20093,"word":"懿言嘉行","pinyin":"yì yán jiā xíng","abbr":"yyjx","explanation":"懿：美好；嘉：善、美。有教育意义的好言语和好行为。","source":{"text":"见人嘉言善行，则敬慕而记录之。","book":"《尚书·大禹谟》：“若允兹，嘉言罔攸伏，野无遗贤，万邦贤宁。”宋·朱熹《朱子全书·学五》"}},{"id":20094,"word":"戆头戆脑","pinyin":"gàng tóu gàng nǎo","abbr":"gtgn","explanation":"楞头楞脑，傻头傻脑。","example":{"text":"他这个～的傻小子能办成啥事？"},"similar":["楞头楞脑","傻头傻脑"],"usage":"作谓语、定语、状语；用于口语"},{"id":20095,"word":"戎事倥偬","pinyin":"róng shì kǒng zǒng","abbr":"rskz","explanation":"军务紧迫。","example":{"text":"现在～，得全力以赴。"},"similar":["戎马倥偬"],"usage":"作谓语；指军务紧迫"},{"id":20096,"word":"戎首元凶","pinyin":"róng shǒu yuán xiōng","abbr":"rsyx","explanation":"戎首：挑起战争的首犯；元凶：制造祸端的大头目。指挑起战争的罪魁。","source":{"text":"虽是虔婆杀我，娟奴是祸首罪魁，追了他去。","book":"明·郑若庸《玉玦记·索命》"}},{"id":20097,"word":"戎马之地","pinyin":"róng mǎ zhī dì","abbr":"rmzd","explanation":"戎马：战马，指军事。指军事要地。","source":{"text":"且李陵提步卒不满五千，深践戎马之地，足历王庭，垂饵虎口，横挑强胡，昂亿万之师，与单于连战十余日，所杀过当。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"齐神武以晋阳～，霸图攸属，练兵训旅，遥制朝权，鄴都机务，情寄深远。","book":"《北史·列传四十二》"}},{"id":20098,"word":"戎马仓皇","pinyin":"róng mǎ cāng huáng","abbr":"rmch","explanation":"指战事紧急而忙于应付。","source":{"text":"衣冠狼藉悲王导，戎马仓皇用李纲。","book":"清·平步青《霞外攟屑·诗话下·王仲瞿〈谷城西楚霸王墓诗〉》"},"example":{"text":"青山难望海云堆，～事更哀。","book":"郁达夫《月夜怀刘大杰》诗"},"usage":"作宾语、定语；用于战争等"},{"id":20099,"word":"戎马倥偬","pinyin":"róng mǎ kǒng zǒng","abbr":"rmkz","explanation":"戎马：本指战马，借指军事；倥偬：繁忙。形容军务繁忙。","source":{"text":"此番不期而遇于戎马倥偬之中，真喜出望外矣。","book":"清·梁章钜《归田琐记·沪渎唱和诗序》"},"example":{"text":"然而于～，大势已烈，只手难撑，不得不以一死报国家。","book":"清·淮阴百一居士《壶天录》"},"similar":["戎马生涯","东征西讨"],"opposite":["安居乐业","安土重迁"],"usage":"作谓语、定语；指军务繁忙"},{"id":20100,"word":"戎马倥傯","pinyin":"róng mǎ kǒng zǒng","abbr":"rmkz","explanation":"指在战争中军务紧迫繁忙。","source":{"text":"迹先生生平，功名多显示于戎马倥傯时，而文章则盛之乎桁杨祸变之际。","book":"清·高阜《〈书影〉序》"},"example":{"text":"陈毅同志任新四军代军长，～之中，很关心文化战线的抗敌斗争。","book":"阿英《戎行兼言艺文事》"}},{"id":20101,"word":"戎马关山","pinyin":"róng mǎ guān shān","abbr":"rmgs","explanation":"戎马：战马，指从军打仗；关山：指宁夏南部的大小关山，泛指山川和关隘。在山川和关隘里从军打仗。","source":{"text":"戎马关山北，凭轩涕泗流。","book":"唐·杜甫《登岳阳楼》"},"example":{"text":"东接益阳故垒，英风宛在，想当年～。","book":"清·左宗棠《挽林则徐》"}},{"id":20102,"word":"戎马劻勷","pinyin":"róng mǎ dān xiào","abbr":"rmkr","explanation":"指战乱不宁。","source":{"text":"盖史官所据《崇文总目》当宋盛时；而《通考》所据晁陈二氏，丁宋末造，戎马劻勷之际，疑其散佚愈众也。","book":"明·胡应麟《诗薮·遗逸中》"},"usage":"作宾语、定语；用于书面语"},{"id":20103,"word":"戎马生涯","pinyin":"róng mǎ shēng yá","abbr":"rmsy","explanation":"指从事征战的生活、经历。","source":{"text":"对于几十年戎马生涯的老战士……还不什么比这更使人豪情奔放、热血沸腾的呢？","book":"袁鹰《悲欢》"},"example":{"text":"我的父亲，那位身经百战的将军，在他前半生的～中，几乎是战无不胜的。","book":"顾笑言《爱情交响诗》第一乐章"},"similar":["军旅生涯"],"usage":"作宾语、定语；指部队生活"},{"id":20104,"word":"戎马生郊","pinyin":"róng mǎ shēng jiāo","abbr":"rmsj","explanation":"戎马：战马。指战乱起于近旁，兵祸大作。","source":{"text":"天下有道，却走马以粪；天下无道，戎马生于郊。","book":"《老子》第四十六章"},"example":{"text":"自东西否隔，二国争强，～，干戈日用，兵连祸结，力敌势均，疆场之事，一彼一此。","book":"《周书·武帝纪》"},"usage":"作宾语、定语；用于战争"},{"id":20105,"word":"戏彩娱亲","pinyin":"xì cǎi yú qīn","abbr":"xcyq","explanation":"比喻孝养父母。","source":{"text":"戏彩娱亲，老莱子之孝。","book":"《艺文类聚·孝引列女传》：“相传春秋时楚国老莱子事亲至孝，年七十，常著五色斑斓衣，作婴兒戏。上堂，故意仆地，以博父母一笑。”《幼学琼林·卷二·祖孙父子类》"}},{"id":20106,"word":"戏法人人会变，各有巧妙不同","pinyin":"xì fǎ rén rén huì biàn,gè yǒu qiǎo miào bù tóng","abbr":"xfrrhbgyqmbt","explanation":"比喻为人做事像变戏法一样，各有各的巧妙之处。","source":{"text":"俗话说，‘戏法人人会变，各有巧妙不同。’其实是许多年间，总是这一套，也总有人看。","book":"鲁迅《现代史》"},"similar":["各有巧妙不同"],"usage":"作宾语、定语、分句；用于处事"},{"id":20107,"word":"戏蝶游蜂","pinyin":"xì dié yóu fēng","abbr":"xdyf","explanation":"飞舞游戏的蝴蝶和蜜蜂。后用以比喻浪荡子弟。","source":{"text":"风恬日暖荡春光，戏蝶游蜂乱人房。","book":"唐·岑参《山房春事二首》"},"similar":["游蜂戏蝶"],"usage":"作主语、宾语、定语；指浪荡子弟"},{"id":20108,"word":"成一家言","pinyin":"chéng yī jiā yán","abbr":"cyjy","explanation":"指学问自成体系可派别。","source":{"text":"欲以究天人之际，通古今之变，成一家之言。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"每言文章自汉司马相如、太史公、刘向、扬雄后，作者不世出，故愈深探本元，卓然树立，～。","book":"《新唐书·韩愈传》"},"similar":["自成一家"],"usage":"作谓语；指自成一派"},{"id":20109,"word":"成也萧何败萧何","pinyin":"chéng yě xiāo hé bài xiāo hé","abbr":"cyxhbxh","explanation":"萧何：汉高祖刘邦的丞相。成事由于萧何，败事也由于萧何。比喻事情的成功和失败都是由这一个人造成的。","source":{"text":"始终一幅香罗帕，成也萧何败萧何。","book":"《警世通言·王娇鸾百年长恨》"},"similar":["成也萧何，败也萧何"],"usage":"作宾语、定语、分句；指成败都在于一个人"},{"id":20110,"word":"成也萧何，败也萧何","pinyin":"chéng yě xiāo hé，bài yě xiāo hé","abbr":"cyxhbyxh","explanation":"萧何：汉高祖刘邦的丞相。成事由于萧何，败事也由于萧何。比喻事情的成功和失败都是由这一个人造成的。","source":{"text":"信之为大将军，实萧何所荐，今其死也，又出其谋。故俚语有‘成也萧何，败也萧何’之语。","book":"宋·洪迈《容斋续笔·萧何给韩信》"},"example":{"text":"～，某心上至今不平。","book":"明·冯梦龙《古今小说》第三十一卷"},"similar":["成也萧何败萧何"],"usage":"作宾语、分句；指成败都在于一个人","story":["秦朝末年，韩信投奔项羽，不得志改投刘邦未被重用就愤而出走，萧何得知后，月下追回韩信。刘邦封他为齐王，但担心他谋反，将韩信贬为淮阴侯，收回兵权。刘邦亲自征讨陈豨，吕后请萧何用计将韩信诓入未央宫杀害"]},{"id":20111,"word":"成事不说","pinyin":"chéng shì bù shuō","abbr":"csbs","explanation":"说：解说。原指事情已成，不要再解说；后指事情已过，不要再解说。","source":{"text":"《论语·八佾》：“子闻之曰：‘成事不说，遂事不谏，既往不咎。’”邢昺疏：‘事已成不可复说也。’"},"example":{"text":"～，既往不咎。我们原是各治水酒饯行的，还说我们饯行正文罢。","book":"清·李汝珍《镜花缘》第六回"},"opposite":["旧事重谈"],"usage":"作谓语；指旧事不要重谈"},{"id":20112,"word":"成事不说，遂事不谏","pinyin":"chéng shì bù shuō，suì shì bù jiàn","abbr":"csbsssbj","explanation":"说：言论；遂：完成；谏：劝说。已做过的事不必再解释，已经完成的事不要再劝说了。含既往不咎之意。","source":{"text":"《论语·八佾》：“子闻之曰：‘成事不说，遂事不谏，既往不咎。’”邢昺疏：‘事已成不可复说也。’"}},{"id":20113,"word":"成事不足，坏事有余","pinyin":"chéng shì bù zú，huài shì yǒu yú","abbr":"csbzhsyy","explanation":"成：成就；足：足够。指事情不但办不好，反而把事情弄坏。用于指责办事拙劣或故意不让事情办成的人。","source":{"text":"部里书办们，成事不足，坏事有余；胜之不武，不胜为笑。","book":"清·李绿园《歧路灯》第105回"},"example":{"text":"他是一个～的人。"},"similar":["成事不足，败事有余"],"usage":"作宾语、定语、分句；指事情越来越糟"},{"id":20114,"word":"成事不足，败事有余","pinyin":"chéng shì bù zú，bài shì yǒu yú","abbr":"csbzbsyy","explanation":"不能把事情办好，反而把事情弄坏。多用来指斥办事拙劣或故意不让事情办成的人。","source":{"text":"梅厂长这个人的能力成事不足，败事有余。","book":"周而复《上海的早晨》第三部三三"},"example":{"text":"茶上安顺虽说和自己平辈，但此人一肚子坏水儿，吃人不吐骨头，～，只能拉拢，不能得罪。","book":"端木蕻良《曹雪芹》第二七章"},"similar":["成事不足，坏事有余"],"usage":"作宾语、分句；指事情越来越糟"},{"id":20115,"word":"成人不自在，自在不成人","pinyin":"chéng rén bù zì zài，zì zài bù chéng rén","abbr":"crbzzzzbcr","explanation":"人要有成就，必须刻苦努力，不可安逸自在。","source":{"text":"谚云：‘成人不自在，自在不成人。’此言虽浅，然实切至之论，千万勉之。","book":"宋·罗大经《鹤林玉露》第九卷"},"example":{"text":"自古道：‘～’你好生记着我的话。","book":"清·曹雪芹《红楼梦》第82回"},"usage":"作宾语、分句；指人不能贪图安逸"},{"id":20116,"word":"成人之善","pinyin":"chéng rén zhī shàn","abbr":"crzs","explanation":"成全别人做善事。","source":{"text":"夫君子成人之善，不成人之恶，微吾子言焉，吾弗之闻也。","book":"《孔子家语·五仪解》"},"example":{"text":"况乃官历士流，当训章之远，而以庶叔之嫌，替其嫡重之位，未是～也。","book":"《魏书·阳固传》"},"opposite":["成人之恶"],"usage":"作谓语、宾语；用于为人"},{"id":20117,"word":"成人之美","pinyin":"chéng rén zhī měi","abbr":"crzm","explanation":"成：成就。成全别人的好事。","source":{"text":"君子成人之美，不成人之恶。小人反是。","book":"《论语·颜渊》"},"example":{"text":"敝人向来最赞成一切牺牲，也最乐于“～”，况且我们是同志，我当然应该给你想一个完全的办法。","book":"鲁迅《华盖集·牺牲谟》"},"similar":["急公好义","助人为乐"],"opposite":["成人之恶","掠人之美"],"usage":"作谓语、宾语；指赞助别人成事"},{"id":20118,"word":"成仁取义","pinyin":"chéng rén qǔ yì","abbr":"crqy","explanation":"成仁：杀身以成仁德；取义：舍弃生命以取得正义。为正义而牺牲生命。","source":{"text":"生，亦我所欲也；义，亦我所欲也，二者不可得兼，舍生而取义者也。","book":"《论语·卫灵公》：“志士仁人，无求生以害人，有杀身以成仁。”《孟子·告子上》"},"example":{"text":"大丈夫既然以身许国，七尺微躯不敢私有。～之理，略知一二。","book":"姚雪雪垠《李自成》第一卷第二十三章"},"similar":["舍生取义","舍身成仁"],"opposite":["苟且偷生"],"usage":"作谓语、定语；用于书面语"},{"id":20119,"word":"成何世界","pinyin":"chéng hé shì jiè","abbr":"chsj","explanation":"算作什么社会。用来指斥社会风气不良，腐败不堪。","source":{"text":"鬻爵卖官，成何世界。","book":"明·张岱《乙酉殉难传总论》"}},{"id":20120,"word":"成何体统","pinyin":"chéng hé tǐ tǒng","abbr":"chtt","explanation":"算作什么样子。","source":{"text":"常言说的好，无妇不成家。你我俱在店中支持了生意时，里面绝然无人照管。况且交游渐广，没有个客人到来，中馈无人支持，成何体面？","book":"明·冯梦龙《醒世恒言》卷十"},"example":{"text":"路遥《平凡的世界》第五卷第26章：“笑话！这～！”"},"similar":["不成体统"],"usage":"作谓语、定语；多用于问句"},{"id":20121,"word":"成何体面","pinyin":"chéng hé tǐ miàn","abbr":"chtm","explanation":"算作什么样子。","source":{"text":"常言说的好，无妇不成家。你我俱在店中支持了生意时，里面绝然无人照管。况且交游渐广，没有个客人到来，中馈无人支持，成何体面？","book":"明·冯梦龙《醒世恒言》卷十"}},{"id":20122,"word":"成佛作祖","pinyin":"chéng fó zuò zǔ","abbr":"cfzz","explanation":"佛教语。指修成佛道，成为祖师。比喻获得杰出成就。","source":{"text":"成佛作祖待作甚么？陈妙常也曾还俗过。","book":"《白雪遗音·马头调·小尼姑》"},"example":{"text":"强而后能者，毕竟是半路出家，止可冒斋饭吃，不能～也。","book":"清·李渔《闲情偶寄·词曲·词采》"},"usage":"作谓语、宾语；用于夸奖人"},{"id":20123,"word":"成则为王，败则为寇","pinyin":"chéng zé wéi wáng，bài zé wéi kòu","abbr":"czwwbzwk","explanation":"旧指在争夺政权斗争中，成功了的就是合法的，称帝称王；失败了的就是非法的，被称为寇贼。含有成功者权势在手，无人敢责难，失败者却有口难辩的意思。","source":{"text":"中国历史上有一习惯，所谓成则为王，败则为寇，但近代文明国家，不是如此。","book":"孙中山《国民党第一次代表大会之演讲》"},"example":{"text":"大家都明白“～”的道理。"},"similar":["成王败寇","成则为王，败则为虏"],"usage":"作定语、分句；指成功与失败的结局不同"},{"id":20124,"word":"成则为王，败则为虏","pinyin":"chéng zé wéi wáng，bài zé wéi lǔ","abbr":"czwwbzwl","explanation":"旧指在争夺政权斗争中，成功了的就是合法的，称帝称王；失败了的就是非法的，被称为俘虏。含有成功者权势在手，无人敢责难，失败者却有口难辩的意思。","source":{"text":"我成则为王，败则为虏，事已至此，惟求早死而已。","book":"元·纪君祥《赵氏孤儿》第五折"},"similar":["成王败贼","成者为王，败者为贼"],"usage":"作宾语、定语、分句；用于事情等"},{"id":20125,"word":"成则为王，败则为贼","pinyin":"chéng zé wéi wáng，bài zé wéi zéi","abbr":"czwwbzwz","explanation":"旧指在争夺政权斗争中，成功了的就是合法的，称帝称王；失败了的就是非法的，被称为寇贼。含有成功者权势在手，无人敢责难，失败者却有口难辩的意思。","source":{"text":"单枪独马领三军，成则为王，败则为贼。","book":"明·罗贯中《平妖传》第三十一回"},"example":{"text":"他们虽然至今不知道“欲壑难填”的古训，却很明白“～”的成语。","book":"鲁迅《南腔北调集·谈金圣叹》"},"similar":["成则为王，败则为寇"],"usage":"作宾语、定语、分句；指成败的结局不同"},{"id":20126,"word":"成千上万","pinyin":"chéng qiān shàng wàn","abbr":"cqsw","explanation":"形容数量很多。","source":{"text":"他看着那乌克斋、邓九公这班人，一帮动辄就是成千上万，未免就把这世路人情看得容易了。","book":"清·文康《儿女英雄传》第三十回"},"example":{"text":"做假事骗得了几个人，骗不了～的人。","book":"老舍《神拳》第二幕"},"similar":["千千万万","不计其数","成千累万"],"opposite":["寥寥无几","寥寥可数","屈指可数"],"usage":"作定语、状语；表示数量多"},{"id":20127,"word":"成千成万","pinyin":"chéng qiān chéng wàn","abbr":"cqcw","explanation":"形容数量极多。","source":{"text":"倘若在广大的都城里，聚集了成千成万的听众，教伊当众唱出这很好的歌，该会增进人们彼此之间的了解。","book":"叶圣陶《小病》"},"example":{"text":"～的人们都向假日海滩涌去。"},"similar":["成千上万"],"opposite":["屈指可数","寥寥无几"],"usage":"作谓语、定语；形容数量多"},{"id":20128,"word":"成千累万","pinyin":"chéng qiān lèi wàn","abbr":"cqlw","explanation":"形容数量极多。","source":{"text":"他看着那乌克斋、邓九公这班人，一帮动辄就是成千累万，未免把世路人情看得容易了。","book":"清·文康《儿女英雄传》第30回"},"example":{"text":"田园庐舍悉遭摧毁荒废，无辜人民之死伤～，妻离子散啼饥号寒者到处皆是。","book":"毛泽东《评国民党对战争责任问题的几种答案》"},"similar":["成千上万","成千成万","成千论万"],"opposite":["屈指可数","寥寥无几"],"usage":"作谓语、定语；形容数量多"},{"id":20129,"word":"成千论万","pinyin":"chéng qiān lùn wàn","abbr":"cqlw","explanation":"犹言成千成万。形容数量极多。","source":{"text":"你到女儿国酒楼戏馆去看，只怕异姓姐妹聚在一处的，还成千论万哩。","book":"《镜花缘》第七一回"},"similar":["成千上万","成千累万"],"opposite":["屈指可数","寥寥无几"],"usage":"作定语、状语；表示数量多"},{"id":20130,"word":"成双作对","pinyin":"chéng shuāng zuò duì","abbr":"cszd","explanation":"配成一对。","source":{"text":"假若是怨女旷夫，买吃了成双作对。","book":"元·无名氏《百花亭》第三折"},"example":{"text":"朋友聚会是有的，为什么要夫妇两个一同去？这算显示你们是～吗？","book":"叶圣陶《孤独》"},"similar":["成双成对"],"usage":"作谓语、定语；指配成一对"},{"id":20131,"word":"成双成对","pinyin":"chéng shuāng chéng duì","abbr":"cscd","explanation":"配成一对，多指夫妻或情侣。","source":{"text":"讲到姐姐今日这喜事，不但有媒有妁，并且不请得是成双成对的媒妁，余外更多着一位月下老人。","book":"《儿女英雄传》第二六回"},"example":{"text":"当然，这都是那些春风满面的少男少女，～，含情脉脉。","book":"俞天白《危栏》"},"similar":["成对成双"],"opposite":["形只影单"],"usage":"作谓语、定语；用于口语"},{"id":20132,"word":"成名成家","pinyin":"chéng míng chéng jiā","abbr":"cmcj","explanation":"树立名声，成为专家。","source":{"text":"善不积，不足以成名。","book":"《易系·辞下》"},"example":{"text":"她：个人主义、～思想严重。","book":"黄宗英《大雁情》"},"opposite":["默默无闻"],"usage":"作谓语、定语；指出名"},{"id":20133,"word":"成团打块","pinyin":"chéng tuán dǎ kuài","abbr":"ctdk","explanation":"比喻聚集成群。","source":{"text":"挨不过了，不免信步寻上山来，只见一群老鸦成团打块在古墓上。","book":"明·施耐庵《水浒传》第46回"},"example":{"text":"闹娥儿满路～，簇着冠儿斗转。","book":"《今古奇观》第36回"},"similar":["成群结队"],"usage":"作谓语、定语、状语；多用于动物等"},{"id":20134,"word":"成城断金","pinyin":"chéng chéng duàn jīn","abbr":"ccdj","explanation":"成城，团结得像城堡一样坚固；断金，力量大得能折断金属。指万众一心，力量无比强大。","source":{"text":"二人同心，其利断金。","book":"语出《国语·周语下》：“故谚曰：‘众心成城，众口铄金。’”又《易·系辞上》"},"example":{"text":"以四五万万人之众，～，谁能御之？","book":"康有为《公民自治篇》"},"similar":["众志成城","齐心协力"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":20135,"word":"成妖作怪","pinyin":"chéng yāo zuò guài","abbr":"cyzg","explanation":"变成精怪，兴风作浪。比喻人捣乱骚扰，从事不正当活动。","source":{"text":"似此成妖作怪，决留他不得了，只教他离了我家便了。","book":"明·罗贯中《平妖传》第二十二回"},"similar":["成精作怪"],"usage":"作谓语、定语；指坏人得势"},{"id":20136,"word":"成家立业","pinyin":"chéng jiā lì yiè","abbr":"cjly","explanation":"指男的结了婚，有职业，能独立生活。","source":{"text":"杭城富室多是外郡寓之人……四方百货，不趾而集，自此成家立业者众矣。","book":"宋·吴自牧《梦梁录·恤贫济老》"},"example":{"text":"原来廉锦枫曾祖向居岭南，因避南北朝之乱，逃至海外，就在君子国～。","book":"清·李汝珍《镜花缘》第十三回"},"similar":["安家立业","家成业就"],"opposite":["倾家荡产"],"usage":"作谓语、宾语；指结婚组建家庭并建立事业"},{"id":20137,"word":"成家立计","pinyin":"chéng jiā lì jì","abbr":"cjlj","explanation":"犹言成家立业。","source":{"text":"不指望成家立计，则寻思卖笑求食。","book":"元·刘致《红绣鞋·劝收心》套曲"},"example":{"text":"父母与子孙～，是父母尽己之心，久以后成人不成人，是在于他，父母怎管的他到底。","book":"元·秦简夫《东堂老》楔子"},"similar":["成家立业"],"usage":"作谓语、宾语；用于生活"},{"id":20138,"word":"成己成物","pinyin":"chéng jǐ chéng wù","abbr":"cjcw","explanation":"自身有所成就，也要使自身以外的一切有所成就。","source":{"text":"诚者，非自成己而已也，所以成物也。成己，仁也；成物，知也。性之德也，合内外之道也。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"一进见之顷，奏琴之间，而没者以慰，生者以荣，～，道在兹矣。","book":"明·李贽《初潭集·君臣四·能臣》"},"usage":"作谓语、宾语；指自身有成就，要他人也有"},{"id":20139,"word":"成帮结队","pinyin":"chéng bāng jié duì","abbr":"cbjd","explanation":"犹成群结队。众多的人或动物结成一群群、一队队。","source":{"text":"同志，你们成帮结队，拉这沙子干啥用的？","book":"徐慎《四书记》"},"similar":["成群结队"],"opposite":["形单影只"],"usage":"作谓语、定语、状语；形容很多聚积在一起"},{"id":20140,"word":"成年古代","pinyin":"chéng nián gǔ dài","abbr":"cngd","explanation":"犹言长期以来。","source":{"text":"这灶成年古代不烧火，埋上这银子，扒上些灰儿盖着，谁知道灶窝里有银子？","book":"元·刘君锡《来生债》第一折"},"usage":"作宾语、状语；用于口语"},{"id":20141,"word":"成年累月","pinyin":"chéng nián lěi yuè","abbr":"cnly","explanation":"成：整；累：积聚。一年又一年，一月又一月。形容时间长久。","source":{"text":"平白的没事还在这里成年累月的闲住着，何况来招呼姑娘呢？","book":"清·文康《儿女英雄传》第二十二回"},"example":{"text":"他的高超的技术，是～积累进来的。"},"similar":["长年累月"],"opposite":["转瞬之间"],"usage":"作定语、状语；形容时间很久"},{"id":20142,"word":"成效卓著","pinyin":"chéng xiào zhuó zhù","abbr":"cxzz","explanation":"获得的成绩非常显著。","example":{"text":"经过这一段的刻苦努力，他～。"},"similar":["卓有成效"],"usage":"作谓语、定语；指效果"},{"id":20143,"word":"成日成夜","pinyin":"chéng rì chéng yè","abbr":"crcy","explanation":"整天整夜，日日夜夜。","source":{"text":"成日成夜爆破声不断，好像这里在进行一场决定人类命运的大战。","book":"杜鹏程《在和平的日子里》第一章"},"example":{"text":"他～地研究这个课题。"},"similar":["整日整夜","日日夜夜"],"usage":"作定语、状语；指日夜不断"},{"id":20144,"word":"成王败寇","pinyin":"chéng wáng bài kòu","abbr":"cwbk","explanation":"旧指在争夺政权斗争中，成功了的就是合法的，称帝称王；失败了的就是非法的，被称为寇贼。含有成功者权势在手，无人敢责难，失败者却有口难辩的意思。","source":{"text":"成王败寇漫相呼，直笔何人纵董狐。","book":"柳亚子《题战史》诗"},"example":{"text":"谁都明白～的道理。"},"similar":["成则为王，败则为寇"],"usage":"作宾语、定语；用于人"},{"id":20145,"word":"成王败贼","pinyin":"chéng wáng bài zéi","abbr":"cwbz","explanation":"成功的人称王称帝，失败者沦为贼寇。","source":{"text":"成王败贼，史能饰词。","book":"清·张岱《皆令操》附燕客《和操》"},"similar":["成王败寇"],"usage":"作宾语、定语；用于人"},{"id":20146,"word":"成竹在胸","pinyin":"chéng zhú zài xiōng","abbr":"czzx","explanation":"成竹：现成完整的竹子。画竹前竹的全貌已在胸中。比喻在做事之前已经拿定主义。","source":{"text":"故画竹，必先得成竹于胸中。","book":"宋·苏轼《文与可画筼筜谷偃竹记》"},"example":{"text":"他回答老师的问题从容不迫，～。"},"similar":["胸有成竹","心中有数"],"opposite":["心中无数","不知所措","惊慌失措"],"usage":"作谓语、状语；比喻在做事之前已经拿定主义","story":["宋朝文人画家苏轼和文同都擅长画竹，苏轼习惯画墨竹，认为画竹必先成竹于胸中。文同在自家宅前种了很多竹子，每天观察竹子的成长变化，因此画出的竹子各具形态，栩栩如生。画家晁补之称赞文同画竹是“成竹已在胸”"]},{"id":20147,"word":"成算在心","pinyin":"chéng suàn zài xīn","abbr":"cszx","explanation":"心中早已经算计好了如何应付的办法。","source":{"text":"李存进欲造浮桥，军吏曰：‘河桥须竹索……今无竹石，窃虑难成。’存进曰：‘吾成算在心，必有所立。’","book":"宋·孔平仲《续世说·巧艺》"},"similar":["成竹在胸"],"usage":"作谓语；用于处事"},{"id":20148,"word":"成精作怪","pinyin":"chéng jīng zuò guài","abbr":"cjzg","explanation":"变成精怪，兴风作浪。比喻人捣乱骚扰，从事不正当的活动。","source":{"text":"他把五个鬼王手下，还有许多邪魔，山魈魍魉，都会成精作怪。","book":"明·无名氏《哪吒三变》第二折"},"example":{"text":"陈先生教的好女沉重，～哩。","book":"明·汤显祖《还魂记·硬拷》"},"similar":["成妖作怪"],"usage":"作谓语、定语；指坏人得势"},{"id":20149,"word":"成群作队","pinyin":"chéng qún zuò duì","abbr":"cqzd","explanation":"指众多的人或动物聚结成一群群、一队队。","source":{"text":"更有那村姑农妇，丢了锄麦，撇了灌菜，也是三三两两，成群作队……呆呆地立着，等那粉头出来。","book":"《水浒传》第一○四回"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第30卷：“常与这些轻薄少年，～，驰马试剑。”"},"similar":["成群结队","成群逐队"],"usage":"作谓语、定语、状语；形容很多聚积在一起"},{"id":20150,"word":"成群打伙","pinyin":"chéng qún dǎ huǒ","abbr":"cqdh","explanation":"指众多的人或动物聚结成一群群、一伙伙。","source":{"text":"桃树爷爷吹唢呐也真吹得好，不但会用嘴吹，还会用鼻孔眼，一吹起来引得孩子们成群打伙地围着他转。","book":"杨朔《雪花飘飘》"},"similar":["成群结伙"],"usage":"作状语；用于人或动物等"},{"id":20151,"word":"成群结伙","pinyin":"chéng qún jié huǒ","abbr":"cqjh","explanation":"众多人物聚集在一起。亦作“成群结队”。","source":{"text":"料着安老爷家办过喜事，一定人人歇乏，不加防范，便成群结伙而来，想要下手。","book":"清·文康《儿女英雄传》第三十二回"},"example":{"text":"在下的和光同尘，～，他就有什么不好，狐兔相为，怎能吹到主人耳朵？","book":"清·西周生《醒世姻缘传》第五十四回"},"similar":["成群打伙","成群结队"],"usage":"作状语；用于人或动物等"},{"id":20152,"word":"成群结党","pinyin":"chéng qún jié dǎng","abbr":"cqjd","explanation":"指一部分人结成小团体。","source":{"text":"但是这人却是鬼计多端，有不少的成群结党的党徒。","book":"郭沫若《中国古代社会研究》第二篇第二章第二节"},"example":{"text":"你们～的来这里干什么？","book":"茅盾《子夜》十八"},"similar":["成群集党"],"usage":"作谓语、宾语、定语；用于团体"},{"id":20153,"word":"成群结队","pinyin":"chéng qún jié duì","abbr":"cqjd","explanation":"成：成为，变成。一群群人集合在一起。","source":{"text":"无奈那雀儿成群结队来偷吃谷粟，才赶得东边的云，又向西边来吃。","book":"《新编五代史平话·周史上》"},"example":{"text":"常与这些轻薄少年，～，驰马试剑，黑夜里往来太行道上。","book":"明·凌濛初《二刻拍案惊奇》卷三十"},"similar":["三五成群"],"opposite":["孑然一身","形单影只"],"usage":"作谓语、定语、状语；形容很多聚积在一起"},{"id":20154,"word":"成群逐队","pinyin":"chéng qún zhú duì","abbr":"cqzd","explanation":"指众多的人或动物聚结成一群群、一队队。","source":{"text":"那些富贵人家的女客，成群逐队，里里外外，来往不绝。","book":"《儒林外史》第十四回"},"similar":["成群作队","成群结队"],"usage":"作谓语、定语、状语；形容很多聚积在一起"},{"id":20155,"word":"成群集党","pinyin":"chéng qún jí dǎng","abbr":"cqjd","explanation":"指一部分人结成小团体。","source":{"text":"就有那一班意气相投的人，成群集党，如兄若弟往来。","book":"《初刻拍案惊奇》卷九"},"similar":["成群结党"],"usage":"作谓语、宾语、定语；用于团体"},{"id":20156,"word":"成者为王，败者为贼","pinyin":"chéng zhě wéi wáng，bài zhě wéi zéi","abbr":"czwwbzwz","explanation":"成：完功，成就；贼：盗贼。指成功了就可以称王，失败了就被称为盗贼。","source":{"text":"君民本是同一民族，乱世时，‘成者为王，败者为贼’，平常是一个照例做皇帝，许多个照例做平民。","book":"鲁迅《华盖集续编·谈皇帝》"},"similar":["成则为王，败则为虏"],"usage":"作宾语、定语、分句；指成败的结局不同"},{"id":20157,"word":"成规陋习","pinyin":"chéng guī lòu xí","abbr":"cglx","explanation":"指由于普遍效法而成为社会准则的一种习惯性的行为或做法。","example":{"text":"在商界谋生不得不屈从于它的～。"},"similar":["陈规陋习"],"usage":"作主语、宾语；指不好的规矩"},{"id":20158,"word":"成败兴废","pinyin":"chéng bài xīng fèi","abbr":"cbxf","explanation":"成功或失败，兴起或衰退。","source":{"text":"道家者流盖出于史官，有明成败兴废，然后知秉要持权，故尚无为也。","book":"汉·荀悦《汉纪·成帝纪二》"},"example":{"text":"古今之～之故，考之有不得其详矣。","book":"宋·朱熹《牧斋记》"},"similar":["成败荣枯"],"usage":"作宾语、定语；指世事的变迁"},{"id":20159,"word":"成败利钝","pinyin":"chéng bài lì dùn","abbr":"cbld","explanation":"利：锋利，引伸为顺利、成功；印：不锋利，引伸为挫折。成功或失败，顺利或不顺利。指做事情可能有的各种情况或结果。","source":{"text":"至于成败利钝，非臣之明所能逆睹也。","book":"三国·蜀·诸葛亮《后出师表》"},"example":{"text":"～，在此一举。","book":"清·陈忱《水浒后传》第三十三回"},"similar":["成败得失"],"usage":"作主语、宾语；向做事的人说明利害关系"},{"id":20160,"word":"成败在此一举","pinyin":"chéng bài zài cǐ yī jǔ","abbr":"cbzcyj","explanation":"举：举动。成功、失败就决定于这次行动了。指采取事关重大的行动。","source":{"text":"成败之机，在斯一举。","book":"《晋书·苻坚载记上》"},"example":{"text":"这桩事，任大责重，方才一口气许了公婆，～。","book":"清·文康《儿女英雄传》第二十六回"},"usage":"作宾语、分句；指关键时刻"},{"id":20161,"word":"成败得失","pinyin":"chéng bài dé shī","abbr":"cbds","explanation":"得：得利。失：失利。成功与失败，得到的与丢掉的。","source":{"text":"成败得失，皆如所虑，可谓守道见机，好古之士也。","book":"晋·陈寿《三国志·吴志·步骘传》"},"example":{"text":"我们不能过分追究此事的～。"},"similar":["成败利钝"],"usage":"作主语、宾语；指成功、失败、得到与失去"},{"id":20162,"word":"成败荣枯","pinyin":"chéng bài róng kū","abbr":"cbrk","explanation":"成功与失败，得志与失意。指人在仕途或事业上的得失荣辱。","source":{"text":"我则道尽今生久困穷途，永世儿陋巷贫居，他他他天也有昼夜阴晴，是是是人也有吉凶祸福，来来来我也有成败荣枯。","book":"元·郑庭玉《后庭花》第二折"},"similar":["成败兴废"],"usage":"作宾语、定语；指世事的变迁"},{"id":20163,"word":"成败论人","pinyin":"chéng bài lùn rén","abbr":"cblr","explanation":"论：评论，衡量。以成功和失败作为评论人物的标准。","source":{"text":"世以成败论人物，故操得在英雄之列。","book":"宋·苏轼《孔北海赞序》"},"example":{"text":"～，固是庸人之见；但本朝大事，你我做臣子的，说话须要谨慎。","book":"清·吴敬梓《儒林外史》第八回"},"similar":["胜败论人"],"usage":"作主语、谓语、宾语；用于“以”后"},{"id":20164,"word":"成都卖卜","pinyin":"chéng dū mài bǔ","abbr":"cdmb","explanation":"汉代人严光在成都时靠卖卜谋生。比喻不做官靠自己的劳作来维持自己的生活。","source":{"text":"霸陵采樵路，成都卖卜钱。","book":"南朝·梁庾信《奉和赵王隐士》"}},{"id":20165,"word":"成风之斫","pinyin":"chéng fēng zhī zhuó","abbr":"cfzz","explanation":"形容技艺高超。同“成风尽垩”。"},{"id":20166,"word":"成风尽垩","pinyin":"chéng fēng jìn è","abbr":"cfje","explanation":"形容技艺高超。","source":{"text":"郢人垩漫其鼻端若蝇翼，使匠石斫之，匠石运斤成风，听而斫之，尽垩而鼻不伤，郢人立不失容。","book":"《庄子·徐无鬼》"},"example":{"text":"若行文自另是一事，譬如大匠操斤，无土木材料，纵有～手段，何处设施？","book":"清·刘大櫆《论文偶记》"},"similar":["鼻垩挥斤"],"usage":"作宾语、定语；指人的技艺等","story":["战国时期，楚国有一个人鼻尖上沾上了一点白粉，像苍蝇翅膀那样薄，他请一个石匠用斧头把白粉砍去，“匠石运斤成风，听而斫之，尽垩而鼻不伤。”他十分惊叹匠人的手艺精湛"]},{"id":20167,"word":"成龙配套","pinyin":"chéng lóng pèi tào","abbr":"clpt","explanation":"将零部件搭配起来，成为一套完整的整体。","example":{"text":"这个～的方案十分可行。"},"similar":["配套成龙"],"opposite":["零零碎碎"],"usage":"作谓语、定语；指组成一个整体"},{"id":20168,"word":"我心如秤","pinyin":"wǒ xīn rú chèng","abbr":"wxrc","explanation":"表示自己处理事情极端公平。","source":{"text":"我心如秤，不能为人作轻重。","book":"《冯堂书钞》卷三七引诸葛亮《杂言》"},"similar":["我心明镜"],"usage":"作谓语；指自己处理事情极端公平"},{"id":20169,"word":"我武惟扬","pinyin":"wǒ wǔ wéi yáng","abbr":"wwwy","explanation":"形容威武凌厉，奋发向上的样子。","source":{"text":"今朕必往，我武惟扬，侵于之疆，取彼凶残，我伐用张，于汤有光。","book":"《尚书·泰誓中》"},"example":{"text":"台上的电灯，约有数百盏，又用瓦斯装成一个横匾，一副对联。匾上写的是“～”。","book":"清·陈天华《狮子吼》楔子"},"usage":"作谓语；指奋发向上的样子"},{"id":20170,"word":"我生不辰","pinyin":"wǒ shēng bù chén","abbr":"wsbc","explanation":"生下来没有遇到好时候。旧时指命运不好。","source":{"text":"我生不辰，逢天僤怒。","book":"《诗经·大雅·桑柔》"},"example":{"text":"～，载离多难，桀逆构扇，巨猾滔天，始自牖里之拘，终类望夷之祸。","book":"《梁书·敬帝纪》"}},{"id":20171,"word":"我盈彼竭","pinyin":"wǒ yíng bǐ jié","abbr":"wybj","explanation":"盈：充满；彼：他，对方；竭：尽。我们的士气正旺盛，他们的勇气已丧失。","source":{"text":"夫战，勇气也。一鼓作气，再而衰，三而竭。彼竭我盈，故克之。","book":"《左传·庄公十年》"},"example":{"text":"然后大王再还荥阳，合军与战，我逸彼劳，～，还怕不能破楚吗！","book":"蔡东藩《前汉演义》第二十七回"},"similar":["彼竭我盈"],"usage":"作谓语、定语；用于战争等"},{"id":20172,"word":"我行我素","pinyin":"wǒ xíng wǒ sù","abbr":"wxws","explanation":"素：平素，向来。不管人家怎样说，仍旧按照自己平素的一套去做。","source":{"text":"君子素其位而行，不愿乎其外。素富贵行乎富贵，素贫贱行乎贫贱，素夷狄行乎夷狄，素患难行乎患难，君子无入而不自得焉。","book":"《礼记·中庸》"},"example":{"text":"笑骂由人笑骂，～而已。","book":"柔石《二月》十"},"similar":["依然故我","刚愎自用"],"opposite":["言听计从"],"usage":"作谓语、宾语、定语；表示自行其是"},{"id":20173,"word":"我见犹怜","pinyin":"wǒ jiàn yóu lián","abbr":"wjyl","explanation":"犹：尚且；怜：爱。我见了她尚且觉得可爱。形容女子容貌美丽动人。","source":{"text":"我见汝亦怜，何况老奴。","book":"南朝宋·虞通之《妒记》"},"example":{"text":"此即吾家小主妇耶？～，何怪子魂思而梦绕之。","book":"清·蒲松龄《聊斋志异·巧娘》"},"usage":"作定语；用于女性","story":["晋朝时期，大将军桓温平定蜀地，娶李势女儿为妾。桓温老婆十分忌妒，知道后立即前往蜀地李的住所，拔刀像要杀了她。看见李在窗口梳头，姿貌十分端庄秀丽，神色自若，慢慢地向桓妻走来，桓妻丢下刀说：“我见汝亦怜，何况老奴。”"]},{"id":20174,"word":"我负子戴","pinyin":"wǒ fù zǐ dài","abbr":"wfzd","explanation":"指夫妻同安于贫贱。详“我黼子佩”。","source":{"text":"祝牧与妻偕隐，作《琴歌》云：‘天下有道，我黼子佩，天下无道，我负子戴。’","book":"汉·扬雄《琴清英》"},"similar":["患难与共"],"usage":"作宾语、定语；用于书面语"},{"id":20175,"word":"我辈情钟","pinyin":"wǒ bèi qíng zhōng","abbr":"wbqz","explanation":"比喻自己对人对事感情强烈、专注，不能忘情。","source":{"text":"圣人忘情，最下不及情，情之所钟，正在我辈","book":"南朝·宋·刘义庆《世说新语·伤逝》"},"example":{"text":"～不自由，等闲白却九分头。","book":"宋·陆游《读唐人愁诗戏作五首》之四"}},{"id":20176,"word":"我醉欲眠","pinyin":"wǒ zuì yù mián","abbr":"wzym","explanation":"我醉了，想睡觉。指为人真诚直率。","source":{"text":"《宋书·陶潜传》：“贵贱造之者，有酒辄设。潜若先醉，便语客：‘我醉欲眠，卿可去。’其直率如此。”"},"example":{"text":"两人对酌山花开，一杯一杯复一杯。～卿且去，明朝有意抱琴来。","book":"唐·李白《山中与幽人对酌》诗"},"usage":"作谓语、分句；指送客语","story":["晋朝时期，不为五斗米而折腰的陶潜辞官回到故乡，自耕自食，经常召集一帮朋友在一起喝酒。他为人直率旷达，喜欢豪饮，用酒招待朋友时，如果自己先醉了就直率地对客人说：“我醉欲眠，卿可去。”朋友们都心知肚明"]},{"id":20177,"word":"我黼子佩","pinyin":"wǒ fǔ zǐ pèi","abbr":"wfzp","explanation":"指夫妻同享荣华。","source":{"text":"祝牧与妻偕隐，作《琴歌》云：‘天下有道，我黼子佩，天下无道，我负子戴。’","book":"汉·扬雄《琴清英》"},"similar":["有福同享"],"usage":"作宾语、定语；用于书面语"},{"id":20178,"word":"戒备森严","pinyin":"jiè bèi sēn yán","abbr":"jbsy","explanation":"戒：警戒；备：防备。警戒防备极严密。","source":{"text":"日考而习，戒备毕矣。","book":"《国语·晋三》"},"example":{"text":"记得那日是烈日当空，两万多人席地坐在大操场上，场外～。","book":"陈若曦《任秀兰》"},"similar":["森严壁垒","无懈可击"],"opposite":["不堪一击","一触即溃"],"usage":"作谓语、宾语、定语；形容严密防守"},{"id":20179,"word":"戒奢以俭","pinyin":"jiè shē yǐ jiān","abbr":"jsyj","explanation":"戒：戒除；奢：奢侈；俭：节俭。用节俭来消除奢侈。","source":{"text":"不念居安思危，戒奢以俭，斯亦伐根以求木茂，塞源而欲流长也。","book":"唐·魏征《谏太宗十思疏》"},"usage":"作谓语、宾语；指用节俭来消除奢侈"},{"id":20180,"word":"戒奢宁俭","pinyin":"jiè shē nìng jiān","abbr":"jsnj","explanation":"戒：戒除；奢：奢侈；宁：宁可，宁愿；俭：节俭。宁愿节俭，也要戒除奢侈。","source":{"text":"礼，与其奢也，宁俭。","book":"《论语·八佾》"},"usage":"作谓语、定语；用于生活"},{"id":20181,"word":"戒舟慈棹","pinyin":"jiè zhōu cí zhào","abbr":"jzcz","explanation":"戒：佛教中的戒律；慈：慈悲；棹：船桨。指佛教中的戒律和慈善就象航船一样摆渡众生。","source":{"text":"若乘戒舟，鼓以慈棹，而不能横截风涛，达登彼岸者，无此理也。","book":"宋·叶廷珪《海录碎事·道释经》"}},{"id":20182,"word":"戒骄戒躁","pinyin":"jiè jiāo jiè zào","abbr":"jjjz","explanation":"戒：警惕，预防。警惕并防止产生骄傲和急躁情绪。","source":{"text":"戒骄戒躁，永远保持谦虚进取的精神。","book":"毛泽东《在中国共产党全国代表会议上的讲话》"},"example":{"text":"我们要～，谦虚谨慎。"},"similar":["不骄不躁","虚怀若谷","功成不居"],"opposite":["骄傲自大","不可一世","惟我独尊"],"usage":"作谓语、宾语、定语、分句；用于劝诫人"},{"id":20183,"word":"戕害不辜","pinyin":"qiāng hài bù gū","abbr":"qhbg","explanation":"戕：杀害；辜：罪过。杀害或伤害没有罪过的人。","source":{"text":"故大上钦慎，不敢自专，岂容有司自为轻重，苟快己志，以隳旧典，污辱善士，戕害不辜。","book":"宋·苏舜钦《上集贤文相书》"},"usage":"作谓语、定语；指残害无辜"},{"id":20184,"word":"戕身伐命","pinyin":"qiāng shēn fá mìng","abbr":"qsfm","explanation":"指伤害身体。","source":{"text":"夫人君欲寿，非事斋瞧能致，果能敬天，凡戕身伐命事，一切致谨，必得长生。","book":"明·沈德符《野获编补遗·列朝》"},"usage":"作宾语、定语；用于自虐等"},{"id":20185,"word":"战不旋踵","pinyin":"zhàn bù xuán zhǒng","abbr":"zbxz","explanation":"旋：转。踵：脚后跟。打仗时不向后转。形容勇猛向前。","source":{"text":"起之为将，与士卒最下者同衣食。……卒有病疽者，起为吮之。卒母闻而哭之。人曰：‘子卒也，而将军自吮其疽，何哭为？’母曰：‘非然也，往年吴公吮其父，其父战不旋踵，遂死于敌。吴公今又吮其子，妾不知其死所矣。是以哭之。","book":"《史记·孙子吴起列传》"},"usage":"作谓语、定语；用于书面语"},{"id":20186,"word":"战争贩子","pinyin":"zhàn zhēng fàn zǐ","abbr":"zzfz","explanation":"挑起战争的人。指依靠煽动战争而从中牟利的人。","example":{"text":"东条英机是日本的～，对中国人民犯下不可饶恕的罪行。"},"usage":"作宾语、定语；用于口语"},{"id":20187,"word":"战兢兢","pinyin":"zhàn jīng jīng","abbr":"zjj","explanation":"战：恐惧的样子；兢兢：小心谨慎的样子。形容非常害怕而微微发抖的样子。也形容小心谨慎的样子。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"那驿丞看见嘴脸丑陋，暗自心惊，不知是人是鬼，～的，只得看茶，摆斋。（明·吴承恩《西游记》第九十三回）"}},{"id":20188,"word":"战天斗地","pinyin":"zhàn tiān dòu dì","abbr":"ztdd","explanation":"战、斗：泛指斗争。形容征服和改造大自然的英雄气慨。","example":{"text":"灾区人民以战天斗地的英雄气慨，克服洪水带来的困难，恢复生产，重建家园。"},"usage":"作谓语、定语、宾语；指人的决心"},{"id":20189,"word":"战必胜，攻必取","pinyin":"zhàn bì shèng，gōng bì qǔ","abbr":"zbsgbq","explanation":"形容强大无比，可以战胜一切。也比喻办任何事情都能成功。","source":{"text":"夫运筹策帷帐之中，决胜于千里之外，吾不如子房。镇国家，抚百姓，给餽饟，不绝粮道，吾不如萧何。连百万之军，战必胜，攻必取，吾不如韩信。","book":"《史记·高祖本纪》"},"example":{"text":"四方有事，吾将兵数万，鼓行其间，～，岂不快哉！（《宋史·萧注传》）"},"similar":["战无不胜，攻无不取"],"usage":"作谓语、定语；用于书面语"},{"id":20190,"word":"战战业业","pinyin":"zhàn zhàn yè yè","abbr":"zzyy","explanation":"戒慎畏惧的样子。","source":{"text":"故先王懔朽索之驭马，虑天命之无常，战战业业，若履渊冰。","book":"康有为《上清帝第二书》"},"usage":"作状语、定语；用于书面语"},{"id":20191,"word":"战战兢兢","pinyin":"zhàn zhàn jīng jīng","abbr":"zzjj","explanation":"战战：恐惧的样子；兢兢：小心谨慎的样子。形容非常害怕而微微发抖的样子。也形容小心谨慎的样子。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"那小孩～地走着，唯恐摔倒。"},"similar":["如履薄冰","兢兢业业"],"opposite":["胆大妄为"],"usage":"作谓语、定语、状语；指人的心情"},{"id":20192,"word":"战战惶惶","pinyin":"zhàn zhàn huáng huáng","abbr":"zzhh","explanation":"戒慎畏惧貌。","source":{"text":"战战惶惶，汗出如浆。","book":"南朝·宋·刘义庆《世说新语·言语》"},"similar":["战战兢兢"],"usage":"作谓语、定语、状语；指人的心情","story":["钟繇的两个儿子钟毓、钟会少年时就有名气，魏文帝听说后就下令接见。文帝见钟毓脸上有汗问为什么？钟毓回答：“战战惶惶，汗出如浆。”文帝问钟会为什么不出汗，钟会回答道：“战战栗栗，汗不敢出。”","文帝深为喜爱"]},{"id":20193,"word":"战战慄慄","pinyin":"zhàn zhàn lì lì","abbr":"zzll","explanation":"因激动或害怕引起的身体战抖","source":{"text":"恒战战慄慄，不忘戒惧，所以欲永终天禄，恐为将来坚圣之驱除也。","book":"《晋书·段灼传》"},"similar":["战战栗栗"],"usage":"作定语、状语；用于恐惧等场合"},{"id":20194,"word":"战战栗栗","pinyin":"zhàn zhàn lì lì","abbr":"zzll","explanation":"战战：戒惧的样子；栗栗：哆嗦，发抖。因戒惧而小心谨慎的样子。","source":{"text":"战战栗栗，日慎一日。","book":"《韩非子·初见秦》"},"example":{"text":"～，汗不敢出。","book":"南朝·宋·刘义庆《世说新语·言语》"},"similar":["战战兢兢"],"usage":"作定语、状语；用于恐惧等场合","story":["钟繇的两个儿子钟毓、钟会少年时就有名气，魏文帝听说后就下令接见。文帝见钟毓脸上有汗问为什么？钟毓回答：“战战惶惶，汗出如浆。”文帝问钟会为什么不出汗，钟会回答道：“战战栗栗，汗不敢出。”","文帝深为喜爱"]},{"id":20195,"word":"战无不克","pinyin":"zhàn wú bù kè","abbr":"zwbk","explanation":"攻战没有不取胜的。形容强大无比，可以战胜一切。","source":{"text":"将军之事吴王亦至矣，为之辟地攻城，战无不克，数月之间招徕数郡。","book":"清·昭梿《啸亭续录·转庵和尚》"},"example":{"text":"孟庭亲自督阵者二十余次，～。前后计斩清兵及团勇二千余人。","book":"陶成章《浙案纪略·余孟庭传》"},"similar":["战无不胜"],"usage":"作谓语、定语；指力量强大"},{"id":20196,"word":"战无不胜","pinyin":"zhàn wú bù shèng","abbr":"zwbs","explanation":"形容强大无比，可以战胜一切。也比喻办任何事情都能成功。","source":{"text":"战无不胜而不知止者，身且死，爵且后归，犹为蛇足也。","book":"《战国策·齐策二》"},"example":{"text":"自先王以来，楚兵～。","book":"明·冯梦龙《东周列国志》第十九回"},"similar":["攻无不克","百战百胜"],"opposite":["一触即溃","不堪一击","望风披靡"],"usage":"作谓语、定语；指力量强大"},{"id":20197,"word":"战无不胜，攻无不克","pinyin":"zhàn wú bù shèng，gōng wú bù kè","abbr":"zwbsgwbk","explanation":"形容军队力量强大，百战百胜。或比喻做任何事情都能成功。","source":{"text":"古来战无不胜，攻无不克，端赖吾能用兵之将，球至于今，邈不可得。","book":"清·百一居士《壶天录》卷上"},"example":{"text":"高皇帝起兵以来，～。","book":"陈白尘《大风歌》第四幕"},"similar":["战无不胜，攻无不取"],"usage":"作谓语、定语；用于书面语"},{"id":20198,"word":"战无不胜，攻无不取","pinyin":"zhàn wú bù shèng，gōng wú bù qǔ","abbr":"zwbsgwbq","explanation":"形容军队力量强大，百战百胜。或比喻做任何事情都能成功。","source":{"text":"是知秦战未尝不胜，攻未尝不取，所当未尝不破也。","book":"语本《战国策·秦策二》"},"example":{"text":"操谓松曰：“吾视天下鼠辈犹草芥耳。大军到处，～，顺吾者生，逆吾者死。汝知之乎？”","book":"明·罗贯中《三国演义》第六十回"},"similar":["战必胜，攻必取"],"usage":"作谓语、定语；用于书面语"},{"id":20199,"word":"战栗失箸","pinyin":"zhàn lì shī zhù","abbr":"zlsz","explanation":"战栗：恐惧的样子；箸：筷子。害怕得连手里的筷子都掉了。形容吓得失去了常态","source":{"text":"先主未发，是时曹公从容谓先主曰：‘今天下英雄，惟使君与操耳。本初之徒，不足数也。’先主方食，失匕箸。","book":"晋·陈寿《三国志·蜀志·先主传》"},"example":{"text":"明·罗贯中《三国演义》第八回：“哀号之声震天，百官～，董卓饮食谈笑自若。”"},"similar":["惊惶失措","闻雷失箸"],"opposite":["镇定自若"],"usage":"作谓语、定语；用于处事","story":["东汉末年，刘备因为失势落魄到去投奔曹操，曹操招待他，刘备为掩饰自己的野心，装做种菜，不闻政事。曹操设宴款待刘备，席间与刘备祝酒论英雄，认为他们俩才是真正的英雄。刘备吓得惊慌失措筷子都掉了，刚好雷声掩盖了这一切"]},{"id":20200,"word":"战火纷飞","pinyin":"zhàn huǒ fēn fēi","abbr":"zhff","explanation":"形容战斗频仍、激烈。","source":{"text":"经过了这场灾祸的考验，好像当年跟着担架队闯了一趟战火纷飞的疆场回来。","book":"浩然《艳阳天》第一二一章"},"example":{"text":"这种友谊来自～的年代。","book":"李国文《月食》"},"usage":"作谓语、定语；用于书面语"},{"id":20201,"word":"战略战术","pinyin":"zhàn lüè zhàn shù","abbr":"zlzs","explanation":"泛指指导或决定全局的策略和作战具体部署和克敌制胜的谋略。","source":{"text":"红军的战略战术，是在这种尖锐的对比上发生的。","book":"毛泽东《中国革命战争的战略问题》"},"usage":"作主语、宾语、定语；用于处事"},{"id":20202,"word":"战胜攻取","pinyin":"zhàn shèng gōng qǔ","abbr":"zsgq","explanation":"战就能胜，攻即能取。形容所向无敌。","source":{"text":"武安君所为秦战胜攻取者七十馀城，南定鄢、郢、汉中，北禽赵括之军，虽周、召、吕望之功不益于此矣。","book":"《史记·白起王翦列传》"},"example":{"text":"亦一时之杰，但战胜攻取，我不如兄，决机虑变，兄不如我。（清·褚人获《隋唐演义》第三十七回）"},"similar":["战必胜，攻必取"],"usage":"作定语；用于书面语"},{"id":20203,"word":"戚戚具尔","pinyin":"qī qī jù ěr","abbr":"qqje","explanation":"戚戚：互相亲爱的样子。具：俱，都。尔：迩，靠近。指兄弟友爱。","source":{"text":"戚戚兄弟，莫远具尔。","book":"《诗经·大雅·行苇》"},"example":{"text":"退省诸王，常有～之心。","book":"三国魏·曹植《求通亲亲表》"},"usage":"作定语；指兄弟友爱"},{"id":20204,"word":"戛戛乎其难矣","pinyin":"jiá jiá hū qí nán yǐ","abbr":"jjhqny","explanation":"戛戛：困难的样子。形容极其困难。","source":{"text":"惟陈言之务去，戛戛乎其难哉！","book":"唐·韩愈《答李翊书》"},"example":{"text":"如此行政，以应付二十世纪之现代战争，实～。","book":"邹韬奋《抗战以来·三谈抗日各党派对宪政的要求》"},"similar":["戛戛其难"],"usage":"作谓语、定语；用于书面语"},{"id":20205,"word":"戛戛其难","pinyin":"jiá jiá qí nán","abbr":"jjqn","explanation":"戛戛：困难的样子。形容极其困难。","source":{"text":"惟陈言之务去，戛戛呼其难哉。","book":"唐·韩愈《答李翊书》"},"example":{"text":"犹～，况乃进取以图中原哉。","book":"清·梁启超《意大利建国三杰传》"},"similar":["戛戛乎其难矣"],"usage":"作谓语、定语；用于书面语"},{"id":20206,"word":"戛戛独造","pinyin":"jiá jiá dú zào","abbr":"jjdz","explanation":"戛戛：形容独创。别出心裁，富有创造性。","source":{"text":"人但知其戛戛独造，而不知其功苦，其势危也。","book":"唐·韩愈《答李翊书》：“惟陈言之务去，戛戛呼其难哉。”清·袁枚《答友人论文第二书》"},"example":{"text":"门接山光来异县，墙分花气与芳邻，皆～。","book":"清·洪亮吉《北江诗话》卷一"},"similar":["别出心裁"],"opposite":["拾人牙慧"],"usage":"作谓语；指文章等"},{"id":20207,"word":"戛然而止","pinyin":"jiá rán ér zhǐ","abbr":"jrez","explanation":"戛：象声词。形容声音突然终止。","source":{"text":"夫文章变化，侔于鬼神，斗然而来，戛然而止，何尝无此景象？","book":"清·章学诚《文史统义·古文十弊》"},"example":{"text":"就这一句，～，听来格外令人注意。","book":"高阳《玉座珠帘》下册"},"usage":"作状语；形容突然中止"},{"id":20208,"word":"戛玉敲冰","pinyin":"jiá yù qiāo bīng","abbr":"jyqb","explanation":"戛：敲击。敲打玉器和冰块。形容声调有节奏而响亮好听。也形容人气节凛然。","source":{"text":"戛：敲击。敲打玉器和冰块。形容声调有节奏而响亮好听。也形容人气节凛然。"},"similar":["戛玉鸣金"],"usage":"作宾语、定语；指人的声音或气节"},{"id":20209,"word":"戛玉敲金","pinyin":"jiá yù qiāo jīn","abbr":"jyqj","explanation":"戛：敲击。敲打玉器和金器。形容声调有节奏而响亮好听。也形容人气节凛然。","source":{"text":"戛玉敲冰声未停，嫌云不遏入青冥。","book":"唐·白居易《听田顺儿歌》"},"example":{"text":"雅谑则飞花粲齿，高吟则～。","book":"清·蒲松龄《聊斋志异·八大王》"},"similar":["戛玉锵金","戛玉敲冰"],"usage":"作谓语；形容声调清脆或音节铿锵"},{"id":20210,"word":"戛玉锵金","pinyin":"jiá yù qiāng jīn","abbr":"jyqj","explanation":"敲打玉器和金器。形容声调有节奏而响亮好听。也形容人气节凛然。同“戛玉敲金”。","source":{"text":"先生之学，涵古茹今；先生之文，戛玉锵金。","book":"宋·王迈《祭海阳县尉林磻■（上虍下鱼右+攵）先生文》"},"usage":"作谓语、定语；用于书面语"},{"id":20211,"word":"戛玉鸣金","pinyin":"jiá yù míng jīn","abbr":"jymj","explanation":"戛：敲击。敲打玉器和金器。形容声调有节奏而响亮好听。也形容人气节凛然。","source":{"text":"戛玉敲冰声未停，嫌云不遏入青冥。","book":"唐·白居易《听田顺儿歌》"},"example":{"text":"我有清风劲节之标，～之韵，用分一半，少答殷勤。","book":"明·朱有燉《赛娇容》第二折"},"similar":["戛玉敲冰"],"usage":"作宾语、定语；指人的声音或气节"},{"id":20212,"word":"戛羹之嫂","pinyin":"jiá gēng zhī sǎo","abbr":"jgzs","explanation":"戛：象声词。不贤惠的嫂子。","source":{"text":"《史记·楚元王世家》载：汉刘邦和他的客人们到其嫂家吃饭。本来锅中还有羹，其嫂却故意用勺刮锅，发出响声，表示羹尽。刘邦为此十分怨恨其嫂。"}},{"id":20213,"word":"戛釜撞瓮","pinyin":"jiá fǔ zhuàng wèng","abbr":"jfzw","explanation":"刮磨锅子，碰撞陶器。比喻粗俗之音。","source":{"text":"读《骚》之久，方识真味；须歌之抑扬，涕泪满襟，然后为识《离骚》，否则为戛釜撞瓮耳。","book":"宋·严羽《沧浪诗话·诗评》"},"example":{"text":"反复吟咏数十过，有不知涕之何从者。粗心人读之，～，何由识其真哉！","book":"清·陈廷焯《白雨斋诗话》卷六"},"similar":["戛釜撞翁"],"usage":"作宾语、定语；用于书面语"},{"id":20214,"word":"戛釜撞翁","pinyin":"jiá fǔ zhuàng wèng","abbr":"jfzw","explanation":"戛：敲击；釜：陶器；翁：通“瓮”，陶器。敲打锅子，碰撞陶器。比喻粗俗的音乐。","source":{"text":"粗心人读之，戛釜撞翁，何由识其真哉！","book":"清·陈廷焯《白雨斋诗话》第六卷"},"similar":["戛釜撞瓮"],"usage":"作宾语、定语；用于书面语"},{"id":20215,"word":"戟指嚼舌","pinyin":"jǐ zhǐ jiáo shé","abbr":"jzjs","explanation":"戟指：伸出食指、中指指人；嚼舌：咬破舌头。形容愤怒之极。","source":{"text":"或则戟指嚼舌，喷血而亡。","book":"鲁迅《华盖集·“碰壁”之余》"},"similar":["戟指怒目"],"usage":"作谓语；指十分愤怒"},{"id":20216,"word":"戟指怒目","pinyin":"jǐ zhǐ nǔ mù","abbr":"jznm","explanation":"戟指：用食指和中指指着别人，象戟的形状。指着人，瞪着眼。形容大怒时斥责人的神态。","source":{"text":"张学良还要解释，蒋早气得七窍生烟，戟指怒目。抗日，抗日，等我死了以后，你再去抗日好了！","book":"马辂《国共和谈演义》第六回"},"example":{"text":"他～，义正辞严，出了胸中恶气。"},"similar":["横眉怒目"],"usage":"作谓语、定语；指发怒"},{"id":20217,"word":"戢暴锄强","pinyin":"jí bào chú qiáng","abbr":"jbcq","explanation":"戢：遏止，停止；暴：残暴；锄：铲除；强：蛮不讲理。遏止、铲除凶蛮残暴的人或事。"},{"id":20218,"word":"戢鳞委翅","pinyin":"jí lín wěi chì","abbr":"jlwc","explanation":"戢：收敛。鱼儿收敛鳞甲，鸟儿收起翅膀。比喻人退出官场，归隐山林或蓄志待时。","source":{"text":"我材与世不相当，戢鳞委翅无复望。","book":"唐·韩愈《赠郑兵曹》诗"},"similar":["戢鳞潜翼"],"usage":"作谓语、定语；指退官潜隐"},{"id":20219,"word":"戢鳞委翼","pinyin":"jí lín wěi yì","abbr":"jlwy","explanation":"比喻人退出官场，归隐山林或蓄志待时。同“戢鳞潜翼”。","source":{"text":"我材与世不相当，戢鳞委翼无复望。","book":"唐·韩愈《赠郑兵曹》诗"}},{"id":20220,"word":"戢鳞潜翼","pinyin":"jí lín qián yì","abbr":"jlqy","explanation":"戢：收敛；潜：隐居。鱼儿收敛鳞甲，鸟儿收起翅膀。比喻人退出官场，归隐山林或蓄志待时。","source":{"text":"和光同尘，与时舒卷；戢鳞潜翼，思属风云。","book":"《晋书·宣帝纪论》"},"similar":["戢鳞委翅"],"usage":"作谓语、定语；指退官潜隐"},{"id":20221,"word":"戤米囤饿杀","pinyin":"gài mǐ tún è shā","abbr":"gmdes","explanation":"戤：依靠；囤：盛粮食的器物。依着米囤挨饿。比喻守财自苦。","source":{"text":"徒然守着他，救不得饥饿。真是戤米囤饿杀了。","book":"明·凌濛初《二刻拍案惊奇》第一卷"},"usage":"作宾语、定语；用于口语"},{"id":20222,"word":"截发剉稾","pinyin":"jié fā cuò gǎo","abbr":"jfcg","explanation":"比喻贤母好客。同“截发留宾”。"},{"id":20223,"word":"截发剉穢","pinyin":"jié fā cuò gǎo","abbr":"jfcg","explanation":"比喻贤母好客。同截发留宾”。"},{"id":20224,"word":"截发留宾","pinyin":"jié fā liú bīn","abbr":"jflb","explanation":"以之为贤母好客的典故。","source":{"text":"晋陶侃少家贫。一日大雪，同郡孝廉范逵往访，陶母湛氏剪发卖以治馔款客，并剉碎草荐以供其马。事见南朝·宋·刘义庆《世说新语·贤媛》。"},"example":{"text":"只他母新宁夫人，他娘子张氏，也都有～、锉荐供马的气概。","book":"《隋唐演义》第四回"},"similar":["投辖留宾"],"usage":"作谓语、定语；指真心待客","story":["东晋时期，范阳孝子范逵去陶侃家投宿，陶侃有名气，但家里清贫，与母亲湛氏相依为命，艰难度日。陶侃发愁了，湛氏把自己的长发剪下，让儿子拿到市场上卖了换回几斛米，另外劈柱与烧草垫招待客人，范逵对他们十分敬佩"]},{"id":20225,"word":"截发锉藳","pinyin":"jié fà cuò gǎo","abbr":"jfcg","explanation":"锉藳：锉碎褥草。把头发剪了卖钱招待客人，锉碎褥草给客人喂马。指诚挚待客。","source":{"text":"陶侃之母贫约无他营也，截发锉藳，以易其供，以给其秣。","book":"明·徐渭《寿史母序》"},"similar":["截发留宾"],"usage":"作谓语、定语；指真心待客","story":["东晋时期，范阳孝子范逵去陶侃家投宿，陶侃家里清贫，与母亲湛氏相依为命，艰难度日。陶侃发愁了，湛氏把自己的长发剪下，让儿子拿到市场上卖了换回几斛米，另外劈柱与烧草垫招待客人，锉碎褥草给客人喂马。范逵对他们十分敬佩"]},{"id":20226,"word":"截断众流","pinyin":"jié duàn zhòng liú","abbr":"jdzl","explanation":"比喻识见玄远，超情越识。","source":{"text":"如复其天地之心神者，妙万物而为言，此截断众流句。","book":"《五灯会元·云门偃禅师法嗣·德山缘密禅师》：“我有三句语示汝诸人：一句函盖乾坤，一句截断众流，一句随波逐浪。”《朱子语类》卷七六"},"example":{"text":"厉太鸿为诗，精深华妙，～。","book":"清·杭大宗《词科掌录》"},"usage":"作谓语、定语；用于比喻句"},{"id":20227,"word":"截然不同","pinyin":"jié rán bù tóng","abbr":"jrbt","explanation":"截然：很分明地、断然分开的样子。形容两件事物毫无共同之处。","source":{"text":"从其教之所由起者观之，则儒释之辨，公私义利之别，判断截然，有不可民者矣。","book":"宋·陆九渊《与王顺伯》"},"example":{"text":"直到近来，经过许多学者的研究，才知道孩子的世界，与成人～。","book":"鲁迅《坟·我们现在怎样做父亲》"},"similar":["天壤之别","迥然不同"],"opposite":["半斤八两","一模一样"],"usage":"作谓语、宾语、定语；形容两件事物完全不同"},{"id":20228,"word":"截胫剖心","pinyin":"jié jìng pōu xīn","abbr":"jjpx","explanation":"砍断足胫，剖开心胸。后以“截胫剖心”为暴君酷虐残民之典。","source":{"text":"扞纣王呴冬月见朝涉水者，谓其胫耐寒，斩而视之；比干忠谏，谓其心异于人，剖而观之。酷虐之甚。","book":"《书·泰誓下》：“扞纣呴斮朝涉之胫， 剖贤人之心。”孔传"},"example":{"text":"《晋书·石季龙载记》：“～，脯肾刽孕，故其亡也忽焉。”"},"usage":"作谓语、定语；用于残暴行为"},{"id":20229,"word":"截趾适履","pinyin":"jié zhǐ shì lǚ","abbr":"jzsl","explanation":"脚大鞋小，切断脚趾去适应鞋子的大小。比喻勉强凑合或无原则的迁就。","source":{"text":"截趾适履，孰云其愚？何与斯人，追欲丧躯？","book":"南朝·宋·范晔《后汉书·荀爽传》"},"example":{"text":"若强为之解，徒见其～耳。","book":"刘师培《补》jywqynh911"},"similar":["削足适履"],"usage":"作谓语、定语；比喻勉强凑合或无原则的迁就"},{"id":20230,"word":"截趾适屦","pinyin":"jié zhǐ shì jù","abbr":"jzsj","explanation":"切断脚趾去适合鞋子的大小。比喻不合理的迁就。","source":{"text":"截趾适屦，敦云其愚。","book":"《后汉书·荀爽传》"}},{"id":20231,"word":"截趾適履","pinyin":"jié zhǐ shì lǚ","abbr":"jzsl","explanation":"犹削足适履。比喻本末倒置或勉强凑合。"},{"id":20232,"word":"截辕杜辔","pinyin":"jié yuán dù pèi","abbr":"jydp","explanation":"犹拦驾。指阻挡他人前来。","source":{"text":"截来辕于谷口，杜妄辔于郊端。","book":"语出南朝·齐·孔稚珪《北山移文》"},"example":{"text":"以凡干圣人之所议，望先生无～之虞。发函一披，则万国幸甚。","book":"宋·王禹偁《拟留侯与四皓书》"},"usage":"作谓语、定语；用于书面语"},{"id":20233,"word":"截铁斩钉","pinyin":"jié tiě zhǎn dìng","abbr":"jtzd","explanation":"比喻坚定不移，或果断干脆。佛教禅宗比喻截断妄想。同“斩钉截铁”。","source":{"text":"有时截铁斩钉，纪干不可。","book":"《古尊宿语录》第22卷"},"similar":["斩钉截铁"],"usage":"作定语、状语、补语；指干脆"},{"id":20234,"word":"截镫留鞭","pinyin":"jié dèng liú biān","abbr":"jdlb","explanation":"比喻识见玄远，超情越识。","source":{"text":"如复其天地之心神者，妙万物而为言，此截断众流句。","book":"《五灯会元·云门偃禅师法嗣·德山缘密禅师》：“我有三句语示汝诸人：一句函盖乾坤，一句截断众流，一句随波逐浪。”《朱子语类》卷七六"},"example":{"text":"厉太鸿为诗，精深华妙，～。","book":"清·杭大宗《词科掌录》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":20235,"word":"截长补短","pinyin":"jié cháng bǔ duǎn","abbr":"jcbd","explanation":"截取长的，补充短的。比喻用长处补短处。","source":{"text":"今滕绝长补短，将五十里也，犹可以为善国。","book":"《孟子·滕文公上》"},"example":{"text":"迨工员报销，～，蕲合成例，言官以浮冒入奏。","book":"《清史稿·姚祖同传》"},"similar":["扬长避短","集思广益"],"opposite":["将错就错"],"usage":"作谓语、定语、宾语；比喻用长处补短处"},{"id":20236,"word":"截鹤续凫","pinyin":"jié hè xù fú","abbr":"jhxf","explanation":"比喻事物勉强替代，失其本性。","source":{"text":"长者不为有余，短者不为不足。是故凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"战国·宋·庄周《庄子·骈拇》"},"example":{"text":"不复能变，专讲结构，几若算子。～，整齐过甚。","book":"清·康有为《广艺舟双楫·卑唐》"},"similar":["断鹤续凫"],"usage":"作谓语、定语；指做事方法不对头","story":["传说古代有个愚蠢而善良的人看到郊外一群群野鸭子和白鹤在水里啄食嬉戏。他发现鹤腿长，野鸭的脚杆很短。他想这样一起走路不路不方便，就把他们捉来，砍下鹤的一截腿杆接到野鸭的脚上，这样他们都不能走路了"]},{"id":20237,"word":"戮力一心","pinyin":"lù lì yī xīn","abbr":"llyx","explanation":"戮力：并力，合力。指齐心协力。","source":{"text":"吾先君武公与晋文侯戮力一心，股肱周室，夹辅平王。","book":"春秋·鲁·左丘明《国语·晋语四》"},"example":{"text":"中国筹边之要，在中外上下～，精求自强之术而勉行之。","book":"清·薛福成《筹洋刍议·边防》"},"similar":["戮力同心","戮力壹心"],"opposite":["同床异梦"],"usage":"作谓语、状语；形容团结一致"},{"id":20238,"word":"戮力同心","pinyin":"lù lì tóng xīn","abbr":"lltx","explanation":"戮力：并力；同心：齐心。齐心合力。","source":{"text":"《汤誓》曰：‘聿求元圣，与之戮力同心，以治天下。’","book":"《墨子·尚贤》"},"example":{"text":"以为足下当～，匡翼汉室，而阴谋不轨，以身试祸，岂不痛哉。","book":"《三国志·魏志·袁术传》"},"similar":["同心同德","同心协力","齐心协力"],"opposite":["四分五裂","分崩离析","同床异梦"],"usage":"作谓语；形容团结一致","story":["夏朝末年，末代君主夏桀非常残暴，对内实行残酷统治，百姓怨声载道，民不聊生。诸侯小国商的国君汤是一个贤明的君主，他找到大贤人伊尹辅佐，商国实力空前强大，汤见时机成熟，君臣戮力同心，齐心合力，终于灭掉夏朝"]},{"id":20239,"word":"戮力壹心","pinyin":"lù lì yī xīn","abbr":"llyx","explanation":"戮力：并力，合力。指齐心协力。同“戮力同心”。","source":{"text":"臧昭伯率从者将盟，载书曰：‘戮力壹心，好恶同之。’","book":"《左传·昭公二十五年》"},"similar":["戮力一心","戮力齐心"],"usage":"作谓语、状语；形容团结一致"},{"id":20240,"word":"戮力齐心","pinyin":"lù lì qí xīn","abbr":"llqx","explanation":"戮力：并力，合力。指齐心协力。同“戮力同心”。","source":{"text":"卿志格玄穹，精贯白日，戮力齐心，芟夷逆丑。","book":"《梁书·王僧辩传》"},"similar":["戮力同心"],"opposite":["同床异梦"],"usage":"作谓语、状语；形容团结一致"},{"id":20241,"word":"戳心灌髓","pinyin":"chuō xīn guàn suǐ","abbr":"cxgs","explanation":"刺心并深入骨髓。形容刻毒得使人难以忍受。","source":{"text":"秀英见祝怀成坐在一边戳心灌髓地说风凉话，怕又挑起事来。","book":"宋文茂《李班长学文化》"},"similar":["敲骨吸髓"],"usage":"作谓语、状语；指人刻毒"},{"id":20242,"word":"戳无路儿","pinyin":"chuō wú lù ér","abbr":"cwle","explanation":"捣鬼，无中生有的挑拨。","example":{"text":"请不要～了。"},"usage":"作谓语、宾语；用于口语"},{"id":20243,"word":"戳脊梁骨","pinyin":"chuō jí liáng gǔ","abbr":"cjlg","explanation":"在背后指责议论。","example":{"text":"小心别人在背后～。"},"similar":["戳脊梁"],"usage":"作谓语、定语；指背后议论"},{"id":20244,"word":"戴发含牙","pinyin":"dài fā hán yá","abbr":"dfhy","explanation":"长着头发和牙齿。指人。","source":{"text":"雷海清呵！若不把一肩担，可不枉了戴发含牙人是俺。但得纲常无缺，须眉无愧，便九死也心甘。","book":"清·洪昇《长生殿·骂贼》"},"similar":["戴发含齿"],"usage":"作谓语、定语；指人类"},{"id":20245,"word":"戴发含齿","pinyin":"dài fā hán chǐ","abbr":"dfhc","explanation":"长着头发和牙齿。指人。多用作退一步说，表示也还是人或如果是人。","source":{"text":"有七尺之骸，手足之异，戴发含齿，倚而趣者谓之人，而人未必无兽心，虽有兽心，以状而见亲矣。","book":"《列子·黄帝》"},"example":{"text":"丁宁丁宁，～。","book":"前蜀·贯休《续姚梁公坐右铭》"},"similar":["戴发含牙","戴眉含齿"],"usage":"作谓语、定语；指人类"},{"id":20246,"word":"戴圆履方","pinyin":"dài yuán lǚ fāng","abbr":"dylf","explanation":"履：踩着；圆、方：古人以为天圆地方。头顶着天，脚踩着地。指生活在人间。","source":{"text":"戴圆履方，抱表怀绳。","book":"《淮南子·本经训》"},"similar":["戴天履地"],"usage":"作谓语；同“戴天履地”"},{"id":20247,"word":"戴大帽子","pinyin":"dài dà mào zǐ","abbr":"ddmz","explanation":"比喻给人加上夸大了的罪名。","source":{"text":"中丞穿的是件接衫，也没有戴大帽子。","book":"清·李宝嘉《官场现形记》第18回"},"example":{"text":"她最喜欢给人～。"},"similar":["乱扣帽子"],"usage":"作谓语、宾语；指扣人罪名"},{"id":20248,"word":"戴天履地","pinyin":"dài tiān lǚ dì","abbr":"dtld","explanation":"戴：顶着天；履：踏，踩着。头顶着天，脚踩着地。形容人活在天地之间。比喻恩德深广，如天高地厚。","source":{"text":"《左传·僖公十五年》“晋大夫三拜稽首曰：‘君履后土而戴皇天，皇天后土，实为君之言。群臣敢在下风。’”"},"example":{"text":"你我皆向蒙王恩，～。不能报其万一。","book":"清·曹雪芹《红楼梦》第七十八回"},"similar":["戴天蹐地"],"usage":"作谓语、定语；指人生活在天地间"},{"id":20249,"word":"戴天蹐地","pinyin":"dài tiān jí dì","abbr":"dtjd","explanation":"犹戴天履地。头顶着天，脚踩着地。形容人活在天地之间。比喻恩德深广，如天高地厚。","source":{"text":"吾先祖考，继世为宋民，戴天蹐地，受德泽者三百余年。","book":"明·方孝孺《曹处士墓碣铭》"},"similar":["戴清履浊"],"usage":"作谓语、宾语；指人活在天地间"},{"id":20250,"word":"戴头而来","pinyin":"dài tóu ér lái","abbr":"dtel","explanation":"戴着脑袋来的。形容无所畏惧的样子。","source":{"text":"甲者出，太尉笑且入，曰：‘杀一老卒，何甲也？吾戴头而来矣。’","book":"唐·柳宗元《段太尉逸事状》"},"usage":"作谓语；用于处事"},{"id":20251,"word":"戴头识脸","pinyin":"dài tóu shí liǎn","abbr":"dtsl","explanation":"比喻有面子有身分。","source":{"text":"你这客人好不君子相，戴头识脸的，也这般罗唣！","book":"明·施耐庵《水浒全传》第十六回"},"example":{"text":"只怕上面没嫡妻，儿子们又都是～的人物。","book":"清·西周生《醒世姻缘传》第三十六回"},"similar":["有头有脸"],"opposite":["默默无闻"],"usage":"作谓语、定语；指有身份"},{"id":20252,"word":"戴日戴斗","pinyin":"dài rì dài dòu","abbr":"drdd","explanation":"犹言普天之下。","source":{"text":"戴日戴斗，靡不来王。","book":"南朝·梁简文帝《序》"},"example":{"text":"‘～’就是‘普天之下’的意思。","book":"方长《关于》"},"usage":"作宾语、主语；指普天之下"},{"id":20253,"word":"戴星而出","pinyin":"dài xīng ér chū","abbr":"dxec","explanation":"头顶着星星出去。指天不亮就出门。形容非常辛苦。","source":{"text":"夫今为京兆者，戴星而出，见烛而入，早出晚归。","book":"宋·苏轼《策别九》"},"similar":["披星戴月"],"usage":"作谓语、定语；用于生活"},{"id":20254,"word":"戴月披星","pinyin":"dài yuè pī xīng","abbr":"dypx","explanation":"身披星星，头顶月亮。形容早出晚归，辛勤劳动，或日夜赶路，旅途辛苦。","source":{"text":"这大的孩儿披星戴月，早起晚眠。","book":"元·无名氏《冤家债主》第一的"},"example":{"text":"真是个迎风冒雪，～。","book":"明·吴承恩《西游记》第四十四回"},"similar":["日夜兼程","披星戴月","起早贪黑"],"usage":"作谓语、状语；指起早贪黑"},{"id":20255,"word":"戴清履浊","pinyin":"dài qīng lǚ zhuó","abbr":"dqlz","explanation":"犹戴天履地。清指天，浊指地。","source":{"text":"伏念戴清履浊，寓世立身，事主奉亲，自家刑国，虽忠贞励节，勤瘁在公，而休祉难臻，愆违易集。","book":"前蜀·杜光庭《都监将军周天醮词》"},"similar":["戴天蹐地"],"usage":"作谓语、宾语；指人活在天地间"},{"id":20256,"word":"戴玄履黄","pinyin":"dài xuán lǚ huáng","abbr":"dxlh","explanation":"犹戴天履地。玄指天，黄指地。形容人活在天地之间。","source":{"text":"乃耆乃康，戴玄履黄，七十有八年。","book":"《易·坤》有“天玄而地黄”之语。明·刘基《海宁应氏墓庵记》"},"similar":["戴天蹐地"],"usage":"作谓语、宾语；指人活在天地间"},{"id":20257,"word":"戴盆望天","pinyin":"dài pén wàng tiān","abbr":"dpwt","explanation":"头上顶着盆子看天。比喻行为和目的相反，愿望不可能达到。","source":{"text":"仆以为戴盆何以望天，故绝宾客之知，亡家室之业，日夜思竭其不肖之才力，务一心营职，以求亲媚于主上。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"何异夫～，倚杖逐日；苍苍之气未辨，昭昭之光已失。","book":"唐·卢照邻《五悲·悲人生》"},"similar":["南辕北辙"],"usage":"作谓语、定语；比喻行为和目的相反"},{"id":20258,"word":"戴目倾耳","pinyin":"dài mú qīng ěr","abbr":"dmqe","explanation":"戴目：仰视的样子；倾耳：侧着耳朵细心倾听。认真听，抬头看。形容殷切期盼。","source":{"text":"使天下之人戴目而视，倾耳耳听。","book":"东汉·班固《汉书·贾山传》"},"similar":["倾耳戴目"],"usage":"作谓语、状语；用于书面语"},{"id":20259,"word":"戴眉含齿","pinyin":"dài méi hán chǐ","abbr":"dmhc","explanation":"长着眉毛和牙齿。指人。","source":{"text":"夫孰知我兄弟之戴眉含齿，抱余疚于泉台也。","book":"清·王夫之《石崖先生传略》"},"similar":["戴发含齿","含齿戴发"],"usage":"作谓语、定语；指人类"},{"id":20260,"word":"戴笠乘车","pinyin":"dài lì chéng chē","abbr":"dlcc","explanation":"比喻不因为富贵而改变贫贱之交。","source":{"text":"卿虽乘车我戴笠，后日相逢下车揖；我步行，君乘马，他日相逢君当下。","book":"晋·周处《风土记》"},"example":{"text":"投李报玖，自怜囊褚之贫；～，方羡绣衣之贵。","book":"宋·刘克庄《回秘阁徐提刑启》其二"},"similar":["贫贱之交"],"usage":"作谓语；形容贫贱之交","story":["传说古代苏越一带风俗淳朴，凡初次同人交往，就封土坛，拿出鸡犬等作为祭品，向天祷告说：“卿虽乘车我戴笠，后日相逢下车揖；我步行，君乘马，他日相逢君当下。”希望以后再次见面时不分地位变化，还是不望这贫贱之交"]},{"id":20261,"word":"戴笠故交","pinyin":"dài lì gù jiāo","abbr":"dlgj","explanation":"指贫贱之交。","source":{"text":"香岩、倦圃，领袖一时。唯时戴笠故交，担簦才子，并与宴游之席，各传酬和之篇。","book":"况周颐《蕙风词话》卷二"},"similar":["贫贱之交"],"usage":"作主语、宾语、定语；用于交往"},{"id":20262,"word":"戴绿帽子","pinyin":"dài lǜ mào zǐ","abbr":"dlmz","explanation":"比喻妻子有外遇的丈夫。","source":{"text":"钱是有了，精力却嫌不足，姬妾满眼，广田自荒，说不定还会戴上绿帽子，人生憾事，莫过于此。","book":"高阳《胡雪岩全传·灯火楼台》"},"example":{"text":"她给丈夫～。"},"similar":["红杏出墙"],"usage":"作宾语、定语；指妻子有外遇"},{"id":20263,"word":"戴罪图功","pinyin":"dài zuì tú gōng","abbr":"dztg","explanation":"戴罪：身负重责；图：谋取。指有罪之人立功，争取减免罪行。","source":{"text":"帝令察广堪办贼，许戴罪图功，否即以赐剑从事。","book":"《明史·马芳传》"},"example":{"text":"诏夺瑞塣职，仍命权总督事，～。","book":"《清史稿·宣统皇帝纪》"},"similar":["立功赎罪","将功折罪"],"opposite":["负隅顽抗"],"usage":"作谓语、定语；用于有罪之人","story":["明朝时期，农民起义不断，社会动荡不安，皇室风雨飘摇。马芳东征西剿，升到甘肃总兵，他率军镇压了甘肃大规模的回民起义。督师孙传庭要调动马芳的军队，马芳不予理睬。孙传庭上奏皇帝弹劾他。崇祯允许他戴罪图功，以观后效"]},{"id":20264,"word":"戴罪立功","pinyin":"dài zuì lì gōng","abbr":"dzlg","explanation":"带着罪过建立功劳，以争取减免处罚。","source":{"text":"正要议俺的罪刑，恰好西北地方又报亢旱，上帝就着俺去带罪立功。","book":"清·李渔《蜃中楼·献寿》"},"example":{"text":"让他去～，以观后效。"},"similar":["立功赎罪","改邪归正"],"opposite":["负隅顽抗","顽抗到底","死不改悔"],"usage":"作谓语、宾语、定语；借指赎罪"},{"id":20265,"word":"戴角披毛","pinyin":"dài jiǎo pī máo","abbr":"djpm","explanation":"戴：顶着；披：覆盖在肩上。指兽类或变为牲畜。","source":{"text":"曰：‘如何是夺境不夺人？’师曰：‘戴角披毛异，来往任纵横。’","book":"宋·释普济《五灯会元》卷十二"},"example":{"text":"孙谨日后倘有异心，天诛地灭，万劫～。","book":"明·天然智叟《石头点·瞿怪奴情衍死盖》"},"similar":["披毛戴角"],"usage":"作谓语、定语、宾语；指变为牲畜"},{"id":20266,"word":"戴霜履冰","pinyin":"dài shuāng lǚ bīng","abbr":"dslb","explanation":"形容不怕严寒，奔波于外。","source":{"text":"于是莫不蒙尘触雨，戴霜履冰，怀黄握白，提清絜肥，以赴邪径之近易，规朝种而暮获矣！","book":"晋·葛洪《抱朴子·勖学》"},"usage":"作谓语、宾语；用于生活"},{"id":20267,"word":"戴高履厚","pinyin":"dài gāo lǚ hòu","abbr":"dglh","explanation":"戴：顶着；履：踩着。头顶天脚踩地。指人活在天地之间。","source":{"text":"夫念臣一介庸愚，遭逢圣代，荷两朝之恩遇，浃体沦肌；际累世之昌隆，戴高履厚。","book":"清·姚元之《竹叶亭杂记》第六卷"},"similar":["顶天立地"],"usage":"作谓语、定语、宾语；用于处世"},{"id":20268,"word":"戴高帽儿","pinyin":"dài gāo mào ér","abbr":"dgme","explanation":"吹捧、恭维别人。同“戴高帽子”。","source":{"text":"那姑娘道：我这个人虽是个多事的人，但是凡那下坡走马、顺风使船，以至买好名儿、戴高帽儿的那些营生我都不会作。","book":"《儿女英雄传》第八回"},"similar":["戴高帽子"],"usage":"作谓语、宾语；指恭维人"},{"id":20269,"word":"戴高帽子","pinyin":"dài gāo mào zǐ","abbr":"dgmz","explanation":"吹捧、恭维别人。","source":{"text":"道晖好着高翅帽、大屐，州将初临，辄服以谒见。仰头举肘，拜于屐上，自言学士比三公。","book":"《北史·儒林传下·熊安生》"},"example":{"text":"老父闻说此处最喜奉承，北边俗语叫做爱～。","book":"清·李汝珍《镜花缘》第27回"},"similar":["戴高帽儿"],"usage":"作谓语、宾语；指恭维人"},{"id":20270,"word":"戴鸡佩豚","pinyin":"dài jī pèi tún","abbr":"djpt","explanation":"戴雄鸡形的帽子，佩野猪形的饰物。雄鸡野猪皆好斗，古时以冠带像其形，表示好勇。","source":{"text":"子路性鄙，好勇力，志伉直，冠雄鸡，佩豭豚。","book":"《史记·仲弟子列传》"},"example":{"text":"世称子路无恒之庸人，未入孔门时，～，勇猛无礼，闻育读之声，摇鸡奋豚，扬唇吻之音，聒贤圣之耳。","book":"汉·王充《论衡·率性》"},"usage":"作谓语、宾语；用于人好勇"},{"id":20271,"word":"户列簪缨","pinyin":"hù liè zān yīng","abbr":"hlzy","explanation":"户：门；簪缨：古代官吏的冠饰。门前排放着簪缨。形容做官以后可使门庭显耀，身价倍增。","source":{"text":"受宠辱，享富贵，户列簪缨，门排画戟。","book":"明·无名氏《衣锦还乡》第三折"},"usage":"作谓语、定语；指当官"},{"id":20272,"word":"户告人晓","pinyin":"hù gào rén xiǎo","abbr":"hgrx","explanation":"让每家每人都知道。","source":{"text":"梁国岂可户告人晓也？被不义之名，何面目以见兄弟国人哉？","book":"汉·刘向《列女传·节义》"},"similar":["家喻户晓"],"usage":"作谓语、定语；指让每家每人都知道"},{"id":20273,"word":"户曹参军","pinyin":"hù cáo cān jūn","abbr":"hccj","explanation":"专管户籍的州县属官。"},{"id":20274,"word":"户枢不朽","pinyin":"hù shū bù xiǔ","abbr":"hsbx","explanation":"户枢：门的转轴；朽：腐烂，败坏。经常转动的门轴就不会朽坏。比喻经常运动的东西不易受侵蚀。","source":{"text":"动摇则谷气得消，血脉流通，病不得生，譬有户枢不朽是也。","book":"《三国志·吴普传》"},"similar":["户枢不蝼","户枢不蠹"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":20275,"word":"户枢不蝼","pinyin":"hù shū bù lóu","abbr":"hsbl","explanation":"比喻经常运动的东西不容易受侵蚀。也比喻人经常运动可以强身。同“户枢不蠹”。","source":{"text":"《吕氏春秋·尽数》：“流水不腐，户枢不蝼，动也。”唐·马总《意林》卷二引作“户枢不蠹”。"},"similar":["户枢不朽","户枢不蠹","流水不腐"],"usage":"作主语、宾语；用于比喻句"},{"id":20276,"word":"户枢不蠹","pinyin":"hù shū bù dù","abbr":"hsbd","explanation":"流动的水不会发臭，经常转动的门轴不会被虫蛀。比喻经常运动的东西不容易受侵蚀。也比喻人经常运动可以强身。","source":{"text":"《吕氏春秋·尽数》：“流水不腐，户枢不蝼，动也。”唐·马总《意林》卷二引作“户枢不蠹”。"},"example":{"text":"“流水不腐，～”，是说它们在不停的运动中抵抗了微生物或其他生物的侵蚀。","book":"毛泽东《论联合政府》"},"similar":["流水不腐","户枢不朽"],"usage":"作主语、宾语；比喻人经常运动可以强身"},{"id":20277,"word":"户给人足","pinyin":"hù jǐ rén zú","abbr":"hgrz","explanation":"给：丰足，富裕。家家衣食充裕，人人生活富足。","source":{"text":"且当征之势门，使反田桑，数年之间，欲令户给人足，如其礼乐，俟之明宰。","book":"《晋书·颜含传》"},"similar":["家给人足","家给民足"],"usage":"作谓语、分句、定语；指生活富足"},{"id":20278,"word":"户限为穿","pinyin":"hù xiàn wéi chuān","abbr":"hxwc","explanation":"户限：门槛；为：被。门槛都踩破了。形容进出的人很多。","source":{"text":"智永禅师住吴兴永欣寺，人来觅书者如市，所居户限为穿穴。","book":"唐·张彦远《法书要录》"},"example":{"text":"远近闻名求字者，几于～，而选择綦苛，低昂无所就。","book":"清·王韬《淞隐漫录·姚云仙》"},"similar":["门庭若市"],"usage":"作谓语、宾语；形容进出的人很多","story":["南北朝陈朝著名的书法家智永禅师，坚持练字30多年，写坏的笔可以装十瓮，埋入地下称“退笔冢”，共练过80万字，他住在浙江吴兴县的永欣寺，找他题字的人很多，把他屋子的门槛都踩破了，不得不包上一层铁皮"]},{"id":20279,"word":"房谋杜断","pinyin":"fáng móu dù duàn","abbr":"fmdd","explanation":"指唐太宗时，名相房玄龄多谋，杜如晦善断。两人同心济谋，传为美谈。","source":{"text":"世传太宗尝与文昭图事，则曰：‘非如晦莫能筹之。’及如晦至焉，竟从龄之策也。盖房知杜之能断大事，杜知房之善建嘉谋。","book":"《旧唐书·房玄龄杜如晦传论》"},"example":{"text":"房谋兼杜断，萧律继曹遵。","book":"元雅琥《上执政四十韵》"},"similar":["天作之合"],"usage":"作宾语、定语；形容能人之间的合作","story":["唐朝初年，唐太宗善于任用能人为之服务，经常听从大臣的意见。一次他与文昭商量事情，房玄龄感慨地说：“非如晦莫能筹之。”等到杜如晦来到时，杜如晦立即分析房玄龄的计谋做出决断。他们两人合作得十分融洽，人称房谋杜断"]},{"id":20280,"word":"所余无几","pinyin":"suǒ yú wú jǐ","abbr":"sywj","explanation":"无几：没有几个。剩下来的没有几个。","source":{"text":"自顷逆泚诱泾、陇之众叛，怀光污朔方之军，割裂诛锄，所余无几。","book":"《旧唐书·陆贽传》"},"example":{"text":"将士大批死伤溃散，～，拼死保护他向西南夺路逃窜。","book":"姚雪垠《李自成》第三卷第三章"}},{"id":20281,"word":"所作所为","pinyin":"suǒ zuò suǒ wéi","abbr":"szsw","explanation":"指人所做的事。","source":{"text":"自此凤姐胆识愈壮，以后所作所为，诸如此类，不可胜数。","book":"清·曹雪芹《红楼梦》第十六回"},"example":{"text":"二弟从前～，我岂不知，只是我做哥哥的，焉能认真。","book":"清·石玉昆《三侠五义》"},"similar":["一举一动"],"usage":"作谓语、宾语；指人的表现"},{"id":20282,"word":"所到之处","pinyin":"suǒ dào zhī chù","abbr":"sdzc","explanation":"所去的任何地方。","source":{"text":"如今知道朝里那些老爷们都是能文能武，出力报效，所到之处，早已消灭了。","book":"清·曹雪芹《红楼梦》第117回"},"example":{"text":"他～都受到热烈的欢迎。"},"usage":"作主语、宾语；指所去的任何地方"},{"id":20283,"word":"所剩无几","pinyin":"suǒ shèng wú jǐ","abbr":"sswj","explanation":"剩：余留下来的。剩下的没有多少了。","source":{"text":"好在所剩无几，待我念完，诸位才女再去慢慢参详，或者得其梗概，也未可知。","book":"清·李汝珍《镜花缘》第九十回"},"example":{"text":"除垫还他经手若干外，～，一齐打三折归还人家的本钱，以作了事。","book":"清·李宝嘉《官场现形记》第五十三回"},"opposite":["绰绰有余"],"usage":"作谓语、定语；用于口语"},{"id":20284,"word":"所向克捷","pinyin":"suǒ xiàng kè jié","abbr":"sxkj","explanation":"军队所去之处，都能取得胜利。","source":{"text":"号令严明，所向克捷。","book":"清·魏源《圣武记》第七卷"},"example":{"text":"刘揆一《黄兴传记》：“两月之久，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":20285,"word":"所向披靡","pinyin":"suǒ xiàng pī mǐ","abbr":"sxpm","explanation":"所向：指力所到达的地方；披靡：溃败。比喻力量所达到的地方，一切障碍全被扫除。","source":{"text":"于是项王大呼驰下，汉军皆披靡。","book":"《史记·项羽本纪》"},"example":{"text":"遂与其友鲜伯等百余人，直犯秦阵，～，杀死秦兵无算。","book":"明·冯梦龙《东周列国志》第四十六回"},"similar":["所向无敌","一往无前"],"opposite":["强弩之末","畏缩不前"],"usage":"作谓语、定语；指彻底清除"},{"id":20286,"word":"所向无前","pinyin":"suǒ xiàng wú qián","abbr":"sxwq","explanation":"所向：指军队所指向的地方。军队所指向的地方，没有阻挡。","source":{"text":"年十四五，异部大人卜贲邑钞取其外家牛羊，檀石槐策骑追击，所向无前，悉还得所亡。","book":"《三国志·魏志·鲜卑传》裴松之注引《魏书》"},"example":{"text":"恃勇锐冲锋出战，指征途～。","book":"清·洪昇《长生殿·贿权》"},"similar":["所向无敌"],"opposite":["屡战屡败"],"usage":"作谓语、定语；指谁也抵挡不住","story":["公元前211年，曹操统一北方后，率军西征，大败韩遂与马超，占据了长安，命夏侯渊进攻陇右。宋建固守略阳等待夏侯渊的进攻，结果被夏侯渊赶至枹罕兵败。曹操嘉奖夏侯渊，说他进攻陇右，前方没有什么可以阻挡的"]},{"id":20287,"word":"所向无敌","pinyin":"suǒ xiàng wú dí","abbr":"sxwd","explanation":"敌：抵挡。力量所指向的地方，谁也抵挡不住。形容力量强大，无往不胜。","source":{"text":"士风劲勇，所向无敌。","book":"三国蜀·诸葛亮《心书》：“善将者因天之时，就地之势，依人之利，则所向无敌，所击者万全矣。”《三国志·吴书·周瑜传》注引《江表传》"},"example":{"text":"我自起兵以来，～。","book":"清·陈忱《水浒后传》第十五回"},"similar":["所向披靡","勇往直前"],"opposite":["屡战屡败"],"usage":"作谓语、宾语；指谁也抵挡不住","story":["公元196年，曹操挟持汉献帝建都许昌，下令让东吴的孙权把儿子送到许都当人质。孙权召集手下商量对策，大将周瑜坚决反对送人质，说只要我们东吴军民发奋图强、团结一致，那么就能所向无敌。孙权坚定信心同曹操对抗下去"]},{"id":20288,"word":"所向皆靡","pinyin":"suǒ xiàng jiē mí","abbr":"sxjm","explanation":"比喻力量所达到的地方，一切障碍全被扫除。同“所向披靡”。","source":{"text":"贾复于是被羽先登，所向皆靡。","book":"《东观汉记》"},"similar":["所向披靡"],"usage":"作谓语、定语；指彻底清除"},{"id":20289,"word":"所向风靡","pinyin":"suǒ xiàng fēng mǐ","abbr":"sxfm","explanation":"风靡：草木随风倒伏。比喻畏惧强敌，闻风溃败。","source":{"text":"臣自达巴丘，所向风靡。","book":"《晋书·王浚传》"},"example":{"text":"我们把敌人打得～。"},"similar":["所向披靡"],"usage":"作谓语、状语；指闻风溃败","story":["公元279年，晋武帝下令灭吴，让王浚乘船从长江顺江而下，并指示进攻建平时受镇南大将军杜预指挥，进攻建业时，受安东大将军王浑指挥。王浚顺风顺流而下，所向风靡，直达石头城，吴王孙皓投降。晋武帝没有责怪他反而封他为辅国大将军"]},{"id":20290,"word":"所图不轨","pinyin":"suǒ tú bù guǐ","abbr":"stbg","explanation":"指图谋做不合法或不正当的坏事。","source":{"text":"会董卓乘虚，所图不轨。","book":"南朝·宋·范晔《后汉书·袁绍传》"},"example":{"text":"她不想干～的事情。"},"similar":["图谋不轨"],"opposite":["忠君爱国"],"usage":"作谓语、宾语、定语；指准备干坏事","story":["东汉末年，汉灵帝死后何进借董卓的力量削弱了宦官的势力，骑都尉鲍信认为董卓野心勃勃，图谋不轨，希望袁绍出兵征讨，董卓杀了袁绍的家人，各地纷纷起事拥护袁绍讨伐董卓。曹操挟天子刘协迁都许县，袁绍上书因董卓所图不轨才起事"]},{"id":20291,"word":"所在多有","pinyin":"suǒ zài duō yǒu","abbr":"szdy","explanation":"所在：处处，到处。指某类事情或现象到处都有，而且很多。","source":{"text":"至于生子恒多不举，伤天理之和，灭人伦之大，末俗相沿，所在多有。","book":"宋·郑兴裔《请禁民不举子状》"},"example":{"text":"当是时，海神庙飨，～，惟北海尚阙。","book":"《清史稿·礼志二》"}},{"id":20292,"word":"所在皆是","pinyin":"suǒ zài jiē shì","abbr":"szjs","explanation":"到处都是。指某种人或事物普遍存在。","source":{"text":"石之铿然有声音，所在皆是也，而此独以钟名何哉？","book":"宋·苏轼《石钟山记》"}},{"id":20293,"word":"所当无敌","pinyin":"suǒ dāng wú dí","abbr":"sdwd","explanation":"犹言所向无敌。形容力量强大，无往不胜。","source":{"text":"吾知公长者，吾骑此马五岁，所当无敌，尝一日行千里，不忍杀之，以赐公。","book":"西汉·司马迁《史记·项羽本纪》"},"similar":["所向披靡"],"usage":"作谓语、定语；用于书面语"},{"id":20294,"word":"所答非所问","pinyin":"suǒ dá fēi suǒ wèn","abbr":"sdfsw","explanation":"回答的不是所问的内容。","source":{"text":"及至问他两句话，那老僧既聋且昏，齿落舌钝，所答非所问。","book":"清·曹雪芹《红楼梦》第二回"},"example":{"text":"她伸着枯瘦的手烤着火，～地说道：“小毛子这么久没有音讯，天又下了雪，万岁还是回宫办事为好。”","book":"二月河《康熙大帝》三十五"}},{"id":20295,"word":"所见所闻","pinyin":"suǒ jiàn suǒ wén","abbr":"sjsw","explanation":"看到的和听到的。","source":{"text":"则士朝夕所见所闻，无非所以治天下国家之道。","book":"宋·王安石《慈溪县学记》"},"example":{"text":"我为甚么不将这～的，写封信告诉庄宫保呢？","book":"清·刘鹗《老残游记》第六回"},"similar":["耳闻目睹"],"opposite":["道听途说"],"usage":"作主语、宾语、定语；指所看到和听到的"},{"id":20296,"word":"所见略同","pinyin":"suǒ jiàn lüè tóng","abbr":"sjlt","explanation":"所持的见解大致相同。","source":{"text":"愚意方欲经营，而来叙适反，此岂古谓所见略同者乎！","book":"明·唐顺之《与王芳湖中丞书》"},"example":{"text":"智谋之士～，孔明谏孤莫行。","book":"清·唐训方《里语微实》"},"similar":["英雄所见略同"],"usage":"作谓语、定语；指看法一致"},{"id":20297,"word":"所费不赀","pinyin":"suǒ fèi bù zī","abbr":"sfbz","explanation":"花费的钱财不计其数。","source":{"text":"惠卿张皇其数，牒转运司交割，妄言可罢馈运，其实所费不赀而无丝毫之利。","book":"宋·苏辙《乞诛窜吕惠卿状》"},"example":{"text":"通惠河造闸坝，～，全藉主守之人上下修治，请设提领三员，专一巡护。","book":"清·毕沅《续资治通鉴》卷一百九十二"},"similar":["所费不资"],"usage":"作谓语、定语；指花钱很多"},{"id":20298,"word":"所费不资","pinyin":"suǒ fèi bù zī","abbr":"sfbz","explanation":"不资：资财无法计算。耗费资财无数。","source":{"text":"廉访司莅军，非世祖旧制，贾胡鬻宝，西僧修佛事，所费不资，于国无益，并宜除罢。","book":"《元史·泰定帝纪一》"},"similar":["所费不赀"],"usage":"作谓语、定语；指花钱很多"},{"id":20299,"word":"扁担没扎，两头打塌","pinyin":"biǎn dàn méi zā，liǎng tóu dǎ tā","abbr":"bdmzltdt","explanation":"扎：扁担头的插栓或做卡。打塌：打滑，滑落下来。扁担两头没有插栓或没做卡口，两头滑落，担子挑不起来。比喻前后失算，两头落空，一无所获。","source":{"text":"他尚未计算到他的实力和他的企图之间的不相称，以致‘扁担没扎，两头打塌’，陷入目前的绝路。","book":"毛泽东《第二次世界大战的转折点》"},"example":{"text":"～，得提防出现不利局面。"},"similar":["扁担脱，两头虚"],"usage":"作宾语、定语、分句；指不稳固，用于口语"},{"id":20300,"word":"扁担脱，两头虚","pinyin":"biǎn dān tuō，liǎng tóu xū","abbr":"bdtltx","explanation":"脱：脱落。扁担没有挡头，挂在两头的东西都会滑落。比喻两头落空。","source":{"text":"我将这合同一纸慌忙付，倒着俺做了扁担脱，两头虚。","book":"元·无名氏《合同文字》"},"similar":["扁担没轧，两头打塌"],"usage":"作宾语、定语、分句；指不稳固"},{"id":20301,"word":"扇席温枕","pinyin":"shàn xí wēn zhěn","abbr":"sxwz","explanation":"形容对父母十分孝敬。同“扇枕温席”。","source":{"text":"奉君母朱夫人及所生陈氏并扇席温枕，叔父绘常叹伏之。","book":"《南史·刘苞传》"},"similar":["扇枕温衾","扇枕温席","扇枕温被"],"usage":"作谓语、定语；指孝敬父母"},{"id":20302,"word":"扇惑人心","pinyin":"shān huò rén xīn","abbr":"shrx","explanation":"扇惑：挑拨引诱。挑拨引诱人的心志。","source":{"text":"又有燃指焚香，刺肤割股，惊骇人目，扇惑人心，不惟饕餮于民，抑且有伤风化。","book":"明·余继登《典故纪闻》第13卷"},"similar":["蛊惑人心"],"usage":"作谓语、定语、宾语；指迷惑人心"},{"id":20303,"word":"扇枕温席","pinyin":"shān zhěn wēn xí","abbr":"szwx","explanation":"形容对父母十分孝敬。","source":{"text":"冬无被裤而亲极滋味，暑即扇床枕，寒即以身温席。","book":"汉·刘珍《东观汉记·黄香传》"},"example":{"text":"奉君母朱夫人及所生陈氏并～，叔父绘常叹伏之。","book":"《南史·刘苞传》"},"similar":["扇枕温被"],"usage":"作谓语、定语；指孝敬父母","story":["黄香是古代有名孝子，他母亲早逝，他知书达理，在炎热的夏天，他用扇子扇凉席子让父亲睡。冬天则先钻进被窝温热被子让父亲睡。他当魏郡太守时当地遭遇洪灾，他拿出自己的俸禄和家产救济灾民。人们称他：“天下无双，江夏黄香。”"]},{"id":20304,"word":"扇枕温衾","pinyin":"shàn zhěn wēn qīn","abbr":"szwq","explanation":"形容对父母十分孝敬。同“扇枕温席”。","source":{"text":"说到此处，就是卧冰哭竹，扇枕温衾，也难报答万一。","book":"《初刻拍案惊奇》卷十三"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第13卷：“说到此处，就是卧冰哭竹，～，也难报答万一。”"},"similar":["扇枕温被","扇枕温席"],"usage":"作谓语、定语；指孝敬父母","story":["汉朝时期，孝子黄香的母亲早逝，他知书达理，在炎热的夏天，他用扇子扇凉席子让父亲睡。冬天则先钻进被窝温热被子让父亲睡。他当魏郡太守时当地遭遇洪灾，他拿出自己的俸禄和家产救济灾民。人们称他：“天下无双，江夏黄香。”"]},{"id":20305,"word":"扇枕温被","pinyin":"shān zhěn wēn chuáng","abbr":"szwb","explanation":"形容对父母十分尽心。","source":{"text":"延事亲色养，夏则扇枕席，冬则以身温被。","book":"《晋书·王延传》"},"similar":["扇枕温席","扇枕温衾"],"usage":"作谓语、定语；指孝敬父母","story":["汉朝时期，孝子黄香的母亲早逝，他知书达理，在炎热的夏天，他用扇子扇凉席子让父亲睡。冬天则先钻进被窝温热被子让父亲睡。他当魏郡太守时当地遭遇洪灾，他拿出自己的俸禄和家产救济灾民。人们称他：“天下无双，江夏黄香。”"]},{"id":20306,"word":"扇火止沸","pinyin":"shàn huǒ zhǐ fèi","abbr":"shzf","explanation":"沸：沸腾，指水滚开。用扇风助长火势的办法来停止水沸腾。比喻采取的办法与希望达到的目的正好相反。","source":{"text":"今海内扰攘，州郡起兵，征夫劳瘁，寇难未弭，或将吏不良，因缘讨捕，侵侮黎民，离害者众；风声流闻，震荡城邑，丘墙惧于横暴，贞良化为群恶，此何异乎抱薪救焚，扇火止沸哉！","book":"《三国志·魏志·陶谦传》“太祖以粮少引军还”裴松之注引《吴书》"},"similar":["抱薪救焚"],"usage":"作宾语、定语；用于处事等"},{"id":20307,"word":"扇风点火","pinyin":"shàn fēng diǎn huǒ","abbr":"sfdh","explanation":"指进行鼓动或煽动。","source":{"text":"‘不过我觉着你们的积极性怕还不够高……气魄也不够大！’县长又半真半假地扇风点火。","book":"康濯《东方红》第十三章"},"example":{"text":"她故意在旁边～，让我们打起来。"},"similar":["煽风点火"],"usage":"作谓语、宾语；指煽动闹事"},{"id":20308,"word":"扊扅佳人","pinyin":"yǎn yí jiā rén","abbr":"yyjr","explanation":"扊扅：门闩，比喻贫困，古乐府中有百里奚贫困困时烧门闩做饭之典。比喻贫困人家的女子。","source":{"text":"悲咽，门楣相府，虽要选，奈扊扅佳人，实难存活。","book":"元·高明《琵琶记》第十三出"}},{"id":20309,"word":"手下留情","pinyin":"shǒu xià liú qíng","abbr":"sxlq","explanation":"下手的时候留点情面。比喻处理事情不要太苛刻。","source":{"text":"在这几个当口，赵三多明明可以乘虚而入，将王成德击倒，他却一再手下留情，都把王成德让过了。","book":"《庚子风云》"},"example":{"text":"请～，不要扼杀新生力量。"},"similar":["高抬贵手","笔下留情"],"opposite":["毫不留情","执法如山"],"usage":"作谓语、定语；用于请求或劝诫"},{"id":20310,"word":"手不停挥","pinyin":"shǒu bù tíng huī","abbr":"sbth","explanation":"手不停顿地挥写。形容不停地写作。","source":{"text":"李白左手将须一拂，右手举起中山兔颖，向五花笺上，手不停挥，须臾，草就吓蛮书。","book":"明·冯梦龙《警世通言》卷九"},"usage":"作谓语；指不停地写作"},{"id":20311,"word":"手不停毫","pinyin":"shǒu bù tíng háo","abbr":"sbth","explanation":"手不停顿地书写。形容不停地写作。","source":{"text":"李白左手将须一拂，右手举起中山兔颖，向五花笺上，手不停挥，须臾，草就吓蛮书。","book":"明·冯梦龙《警世通言》卷九"},"example":{"text":"亭亭铺下笺纸，～，草草写去。","book":"清·李汝珍《镜花缘》第五十三回"}},{"id":20312,"word":"手不应心","pinyin":"shǒu bù yīng xīn","abbr":"sbyx","explanation":"犹言力不从心。心里想做，可是力量够不上。","source":{"text":"日往月来，不觉一年有余，李公子囊箧渐渐空虚，手不应心，妈妈也就怠慢了。","book":"明·冯梦龙《警世通言》第三十二卷"},"example":{"text":"可惜才不逮意，～，于是急切中连“简明”、“清晰”、“条理”等一切散文底基本条件都置诸脑后了。","book":"沈从文《艺术教育·滥用名词的商榷》"},"similar":["力不从心"],"usage":"作谓语、宾语、定语；用于处事"},{"id":20313,"word":"手不辍卷","pinyin":"shǒu bù chuò juàn","abbr":"sbcj","explanation":"辍：中止；卷：书本。书本不离手。形容勤奋好学。","source":{"text":"性好学，虽居军旅，手不辍卷。","book":"《梁书·杨公则传》"},"similar":["手不释卷","不忍释卷"],"usage":"作谓语、宾语、状语；指勤奋好学"},{"id":20314,"word":"手不释书","pinyin":"shǒu bù shì shū","abbr":"sbss","explanation":"犹手不释卷。书本不离手。形容勤奋好学。","source":{"text":"义雄有识悟，勤学，手不释书。","book":"《北史·序传·李义雄》"},"example":{"text":"亭林先生自少至老，～。","book":"清·陈康祺《郎潜纪闻》卷三"},"similar":["手不释卷"],"usage":"作谓语、定语；用于读书"},{"id":20315,"word":"手不释卷","pinyin":"shǒu bù shì juàn","abbr":"sbsj","explanation":"释：放下；卷：指书籍。书本不离手。形容勤奋好学。","source":{"text":"光武当兵马之务，手不释卷。","book":"《三国志·吴书·吕蒙传》注引《江表传》"},"example":{"text":"闵象南老好观书，年七十余，每夜漏下二三十筹，～。","book":"清·王晫《今世说·德行》"},"similar":["学而不厌","爱不释手"],"opposite":["不学无术"],"usage":"作谓语、宾语、状语；指勤奋好学","story":["三国时期吴国大将吕蒙没有文化知识，孙权鼓励他学习史书与兵法。吕蒙总是推说军队事多没有时间学习，孙权列举自己及前人的例子，如“光武当兵马之务，手不释卷，孟德亦谓老而好学。”吕蒙深受感动，从此发愤学习，学问提高很快"]},{"id":20316,"word":"手中败将","pinyin":"shǒu zhōng bài jiàng","abbr":"szbj","explanation":"在战争中被自己打败或在竞赛中输给自己的人。","source":{"text":"此乃石厚手中败将，全不耐战，何足惧哉！","book":"明·冯梦龙《东周列国志》第七回"}},{"id":20317,"word":"手到拈来","pinyin":"shǒu dào niān lái","abbr":"sdnl","explanation":"比喻事情很容易办到。","source":{"text":"这是揉着我山儿的痒处，管教他瓮中捉鳖，手到拿来。","book":"元·康进之《李逵负荆》第四折"},"example":{"text":"那个人便是浪里白条张顺，水里拿人，浑如瓮中捉鳖，～。","book":"明·施耐庵《水浒传》第八十回"},"similar":["手到擒来","举手之劳"],"usage":"作谓语、分句；指十分容易"},{"id":20318,"word":"手到拿来","pinyin":"shǒu dào ná lái","abbr":"sdnl","explanation":"指不费力气就能将必须擒拿的人捉到。","source":{"text":"这是揉着我山儿的痒处，管教他瓮中捉鳖，手到拿来。","book":"元·杨显之《酷寒亭》第四折：“将这厮吃剑乔材，任逃走向天涯外，我也少不得手到拿来。”元·康进之《李逵负荆》第四折"},"example":{"text":"李逵听了，跳将起来，说道：“我去瓮中捉鳖，～。”","book":"明·施耐庵《水浒传》第七十三回"},"similar":["手到擒来"],"usage":"作谓语、宾语、分句；指十分容易"},{"id":20319,"word":"手到擒来","pinyin":"shǒu dào qín lái","abbr":"sdql","explanation":"擒：捉。原指作战一下子就能把敌人捉拿过来，后比喻做事有把握，不费力就做好了。","source":{"text":"这是揉着我山儿的痒处，管教他瓮中捉鳖，手到拿来。","book":"元·康进之《李逵负荆》第四折"},"example":{"text":"行者道：“这个容易，老孙去～。”","book":"明·吴承恩《西游记》第二十四回"},"similar":["轻而易举","易如反掌"],"opposite":["大海捞针","束手无策"],"usage":"作谓语、宾语、分句；指十分容易"},{"id":20320,"word":"手到病除","pinyin":"shǒu dào bìng chú","abbr":"sdbc","explanation":"刚动手治疗，病就除去了。形容医术高明。也比喻工作做得很好，解决问题迅速。","source":{"text":"嬷嬷，你放心，小人三代行医，医书脉诀，无不通晓，包的你手到病险除。","book":"元·无名氏《碧桃花》第二折"},"example":{"text":"我家相公惯能驱逐邪祟，降妖捉怪，～。","book":"清·石玉昆《三侠五义》第四回"},"similar":["药到病除","起死回生","妙手回春"],"opposite":["无济于事"],"usage":"作谓语、定语；指医术高明"},{"id":20321,"word":"手头不便","pinyin":"shǒu tóu bù biàn","abbr":"stbb","explanation":"手头：手边；不便：不方便。手边缺少钱用的委婉说法。","source":{"text":"兄弟不过一时手头不便，欠了他几个臭钱。","book":"曾朴《孽海花》第五回"},"example":{"text":"最近我～，什么也干不了。"},"similar":["手头拮据"],"opposite":["手头宽裕"],"usage":"作谓语、定语；指人的经济状况"},{"id":20322,"word":"手如柔荑","pinyin":"shǒu rú róu tí","abbr":"srrt","explanation":"荑：刚长出的茅草。比喻女子的手纤细柔嫩。","source":{"text":"手如柔荑，肤如凝脂，领如蝤蛴，齿如瓠犀。","book":"《诗经·卫风·硕人》"},"example":{"text":"灯下端详，越加娇艳，但看她眉如远山，面如芙蕖，肤如凝脂，～，低鬟弄带，真个销魂。","book":"蔡东藩《前汉演义》第六十一回"}},{"id":20323,"word":"手帕姊妹","pinyin":"shǒu pà zǐ mèi","abbr":"spzm","explanation":"旧指妓女互相结拜为姐妹。","source":{"text":"相公不知，这院中名妓，结为手帕姊妹，就象香火兄弟一般，每遇时节，便做盛会。","book":"清·孔尚任《桃花扇·访翠》"},"example":{"text":"细寻旧日门户，居然还有当年的～，而至今仍为乐户。","book":"高阳《状元娘子》五"},"usage":"作主语、宾语、定语；用于书面语"},{"id":20324,"word":"手忙脚乱","pinyin":"shǒu máng jiǎo luàn","abbr":"smjl","explanation":"形容遇事慌张，不知如何是好。","source":{"text":"问：‘如何是大悲境？’师曰：‘千眼都来一只收。’曰：‘如何是境中人？’师曰：‘手忙脚乱。’","book":"宋·释普济《五灯会元》"},"example":{"text":"諕的我～紧收拾。","book":"元·无名氏《百花亭》第三折"},"similar":["七手八脚","手足无措"],"opposite":["从容不迫","有条不紊"],"usage":"作谓语、状语；指慌乱"},{"id":20325,"word":"手快脚轻","pinyin":"shǒu kuài jiǎo qīng","abbr":"skjq","explanation":"手的动作快，走路脚步轻。指人的动作轻快。"},{"id":20326,"word":"手急眼快","pinyin":"shǒu jí yǎn kuài","abbr":"sjyk","explanation":"急：迅速。动作迅速，眼光敏捷。形容机灵敏捷。","source":{"text":"原来悟空手疾眼快，正在那混乱之时，……赶在哪吒脑后，着左膊上一棒打来。","book":"明·吴承恩《西游记》第四回"},"example":{"text":"张爷～，斜刺里就是一腿。","book":"清·石玉昆《三侠五义》第八回"},"similar":["手疾眼快"],"opposite":["笨手笨脚"],"usage":"作谓语、定语、状语；指人很机灵"},{"id":20327,"word":"手慌脚乱","pinyin":"shǒu huāng jiǎo luàn","abbr":"shjl","explanation":"形容惊慌不安的样子。","source":{"text":"问：‘如何是大悲境？’师曰：‘千眼都来一只收。’曰：‘如何是境中人？’师曰：‘手忙脚乱。’","book":"宋·释普济《五灯会元》卷十一"},"example":{"text":"匡超人惊得～，说道：“这是那里晦气。”","book":"清·吴敬梓《儒林外史》第十七回"},"similar":["手忙脚乱","惊慌失措"],"opposite":["镇定自若"],"usage":"作谓语、状语；指做事忙乱"},{"id":20328,"word":"手慌脚忙","pinyin":"shǒu huāng jiǎo máng","abbr":"shjm","explanation":"形容惊慌不安之状。","source":{"text":"匡超人惊得手慌脚忙，说道：‘这是那里晦气！’","book":"清·吴敬梓《儒林外史》第17回"},"example":{"text":"我最近忙得～。"},"similar":["手忙脚乱"],"opposite":["镇定自若"],"usage":"作状语、定语；用于口语，指忙乱"},{"id":20329,"word":"手指脚划","pinyin":"shǒu zhǐ jiǎo huá","abbr":"szjh","explanation":"用手脚比划。","example":{"text":"见我们听不懂她的话，她急得～。"},"similar":["比比划划"],"usage":"作定语、状语；指人的神态"},{"id":20330,"word":"手挥目送","pinyin":"shǒu huī mù sòng","abbr":"shms","explanation":"手挥：挥动手指弹琴；目送：眼睛追视归鸿。手眼并用，怎么想就怎么做。也比喻语言文字的意义双关，意在言外。","source":{"text":"目送归鸿，手挥五弦，俯仰自得，游心太玄。","book":"三国·魏·稽康《四言赠兄秀才公穆入军》诗"},"example":{"text":"纵遇极难驾御的情境，也可以～，行所无事。","book":"朱光潜《作文与运思》"},"similar":["得心应手"],"usage":"作谓语；用于行文"},{"id":20331,"word":"手援天下","pinyin":"shǒu yuán tiān xià","abbr":"sytx","explanation":"用手来援救天下。原比喻援救的工具和方法不对。后比喻以个人之力欲解救天下之危亡。","source":{"text":"天下溺，援之以道；嫂溺，援之以手。子欲手援天下乎？","book":"《孟子·离类上》"},"example":{"text":"夫社会之敝，极于今日，而欲以～，夫孰不知其难？","book":"清·梁启超《吾今后所以报国者》"}},{"id":20332,"word":"手无寸刃","pinyin":"shǒu wú cùn rèn","abbr":"swcr","explanation":"指手里一点武器都没有。","source":{"text":"香年十四，手无寸刃，直扼虎颈，丰遂得免。","book":"南朝·宋·刘敬叔《异苑》卷十"},"example":{"text":"清·纪昀《阅微草堂笔记·滦阳消夏录》：“舜庭～，乃弭耳就擒。”"},"similar":["手无寸铁"],"opposite":["荷枪实弹"],"usage":"作谓语、定语；指手里没有任何武器"},{"id":20333,"word":"手无寸铁","pinyin":"shǒu wú cùn tiě","abbr":"swct","explanation":"寸：形容细微短小；铁：指武器。手里没有任何武器。","source":{"text":"百战不许持寸铁。","book":"宋·苏轼《聚星堂雪》"},"example":{"text":"郭淮引兵赶来；见维～，乃骤马挺枪追之。","book":"明·罗贯中《三国演义》第一百九回"},"similar":["赤手空拳","手无寸刃"],"opposite":["荷枪实弹"],"usage":"作谓语、定语；指手里没有任何武器"},{"id":20334,"word":"手无缚鸡之力","pinyin":"shǒu wú fù jī zhī lì","abbr":"swfjzl","explanation":"缚：捆绑。连捆绑鸡的力气都没有。形容身体弱、力气小。","source":{"text":"那韩信手无缚鸡之力。","book":"元·无名氏《赚蒯通》第一折"},"example":{"text":"我两个～，只好吃饭。","book":"明·施耐庵《水浒全传》第三十八回"},"similar":["软弱无力","弱不禁风"],"usage":"作谓语、宾语、分句；指身体虚弱"},{"id":20335,"word":"手泽之遗","pinyin":"shǒu zé zhī yí","abbr":"szzy","explanation":"手泽：为手汗所沾润。指先人遗物。","source":{"text":"父没而不能读父之书，手泽存焉尔。","book":"西汉·戴圣《礼记·玉藻》"},"example":{"text":"潘岳《悼亡赋》乃抢～。","book":"北齐·颜之推《颜氏家训·文章》"},"usage":"作宾语；指亲人遗物"},{"id":20336,"word":"手泽尚存","pinyin":"shǒu zé shàng cún","abbr":"szsc","explanation":"手泽：为手汗所沾润。指先人遗物仍然保存着。多指著述、手迹。","source":{"text":"先正司空与丈人为显交，撤悬之前五日，所赋诗寄友非他人也。今手泽尚存。","book":"《礼记·玉藻》：“父没而不能读父之书，手泽存焉尔。”唐·刘禹锡《唐故相赠司空令狐公集纪》"}},{"id":20337,"word":"手滑心慈","pinyin":"shǒu huá xīn cí","abbr":"shxc","explanation":"手头慷慨，心地善良。指乐于助人。","source":{"text":"鱼门当日，并不在酒场歌席妄费一钱，而手滑心慈，遂至累人累己。","book":"清·袁枚《与林远峰书》"},"similar":["乐于助人"],"usage":"作谓语、定语；用于为人"},{"id":20338,"word":"手疾眼快","pinyin":"shǒu jí yǎn kuài","abbr":"sjyk","explanation":"疾：迅速。动作迅速，眼光敏捷。形容机灵敏捷。","source":{"text":"原来悟空手疾眼快，正在那混乱之时……哪吒脑后，着左膊上一棒打来。","book":"明·吴承恩《西游记》"},"example":{"text":"多一个人，说不定也许能～的救了钱太太。","book":"老舍《四世同堂》"},"similar":["眼明手快","心灵手巧","手急眼快"],"opposite":["笨手笨脚"],"usage":"作谓语、定语、状语；指人很机灵"},{"id":20339,"word":"手眼通天","pinyin":"shǒu yǎn tōng tiān","abbr":"sytt","explanation":"比喻善于钻营，手腕不寻常。","source":{"text":"这并不是她相信丈夫的能力，而是相信她自己的手眼通天。","book":"老舍《四世同堂》"},"example":{"text":"他～，很有能耐。"},"similar":["神通广大"],"usage":"作谓语、定语；比喻办法多"},{"id":20340,"word":"手胼足胝","pinyin":"shǒu pián zú zhī","abbr":"spzz","explanation":"胼、胝：手掌、足底的老茧。手掌足底生满老茧。形容经常地辛勤劳动。","source":{"text":"《韩非子·外储说左上》：“手足胼胝，面目黧黑，劳有功者也。”《荀子·子道》：“有人于此，夙兴夜寐，耕耘树艺，手足胼胝以养其亲，然而无孝之名，何也？"},"example":{"text":"我等虽肝脑涂地，～，亦所甘心。","book":"明·许仲琳《封神演义》第二十三回"},"usage":"作宾语、定语；用于书面语"},{"id":20341,"word":"手脚干净","pinyin":"shǒu jiǎo gàn jìng","abbr":"sjgj","explanation":"比喻廉洁奉公。","source":{"text":"办社务的干部，手脚干净，青天包公啊！","book":"傅晓航《九只小鸭子》"},"example":{"text":"我们要一些～的工人干活。"},"similar":["廉洁奉公"],"opposite":["小偷小摸"],"usage":"作谓语、定语；指人不贪财"},{"id":20342,"word":"手脚无措","pinyin":"shǒu jiǎo wú cuò","abbr":"sjwc","explanation":"形容举动慌张，或无法应付。同“手足无措”。","source":{"text":"府尹胡师文，见了上司批文，慌得手脚无措。","book":"《金瓶梅词话》第四八回"},"example":{"text":"明·伏雌教主《醋葫芦》第一回：“慌得个～，口中虽是不言，心内好生着急。”"},"similar":["手足无措","莫措手足"],"usage":"作谓语、状语、定语；指慌乱"},{"id":20343,"word":"手舞足蹈","pinyin":"shǒu wǔ zú dǎo","abbr":"swzd","explanation":"蹈：顿足踏地。两手舞动，两只脚也跳了起来。形容高兴到了极点。也指手乱舞、脚乱跳的狂态。","source":{"text":"永（咏）歌之不足，不知手之舞之，足之蹈之也。","book":"《诗经·周南·关雎·序》"},"example":{"text":"当下刘姥姥听见这般音乐，且又有了酒，越发喜得～起来。","book":"清·曹雪芹《红楼梦》第四十一回"},"similar":["欢天喜地","欢欣鼓舞","兴高采烈"],"opposite":["闷闷不乐","不苟言笑"],"usage":"作谓语、状语；指人得意"},{"id":20344,"word":"手起刀落","pinyin":"shǒu qǐ dāo luò","abbr":"sqdl","explanation":"手一提起，刀就落下。形容用刀动作的迅速。","source":{"text":"武松道：‘原来恁地，却饶你不得。’手起刀落，也把这人杀了。","book":"明·施耐庵《水浒传》第29回"},"example":{"text":"他～，把这个坏蛋给杀了。"},"similar":["砍瓜切菜"],"usage":"作谓语；指人的动作迅速"},{"id":20345,"word":"手足之情","pinyin":"shǒu zú zhī qíng","abbr":"szzq","explanation":"手足：比喻兄弟。比喻兄弟的感情。","source":{"text":"臣窃哀其志，不胜手足之情，故为冒死一言。","book":"宋·苏辙《为兄苏轼下狱上书》"},"example":{"text":"请你念及～，不要因我没有出息，就把我抛弃。","book":"巴金《秋》"},"similar":["情同手足","亲密无间"],"opposite":["反目成仇","视同陌路"],"usage":"作主语、宾语；指亲情"},{"id":20346,"word":"手足失措","pinyin":"shǒu zú shī cuò","abbr":"szsc","explanation":"手足失去安放的地方。形容极其惊慌。","source":{"text":"孔明听毕，汗流遍体，手足失措。","book":"唐·韩愈《为韦相公让官表》：“承命震骇，心神靡宁，顾己惭靦，手足失措。”明·罗贯中《三国演义》第八十五回"},"example":{"text":"雪香凝眸视之，真是天上少有、人间难寻。一时目迷魂飞，～。","book":"清·曹梧冈《梅兰佳话》第六段"},"similar":["手足无措"],"opposite":["从容不迫"],"usage":"作谓语、状语、补语；指慌乱"},{"id":20347,"word":"手足异处","pinyin":"shǒu zú yì chù","abbr":"szyc","explanation":"异处：不在一起。手和脚不在一处。指被杀。","source":{"text":"曰：‘匹夫而营惑诸侯者罪当诛！请命有司。’有司加法焉，手足异处。","book":"《史记·孔子世家》"},"example":{"text":"明·无名氏《杨家将演义》第二卷：“汝父子投降于宋，不得正命而死，～，若禽兽然，有甚好处！”"},"similar":["身首异处","首足异处","头足异处"],"usage":"作谓语、定语；指被杀"},{"id":20348,"word":"手足无措","pinyin":"shǒu zú wú cuò","abbr":"szwc","explanation":"措：安放。手脚不知放到哪儿好。形容举动慌张，或无法应付。","source":{"text":"刑罚不中，则民无所措手足。","book":"《论语·子路》"},"example":{"text":"正忧疑不定，忽报宋兵到了，惊得～。","book":"清·陈忱《水浒后传》第十二回"},"similar":["手忙脚乱","惊慌失措"],"opposite":["慢条斯理","从容不迫"],"usage":"作谓语、状语、定语；指慌乱"},{"id":20349,"word":"手足胼胝","pinyin":"shǒu zú pián zhī","abbr":"szpz","explanation":"胼、胝：手掌、足底的老茧。手掌足底生满老茧。形容经常地辛勤劳动。","source":{"text":"禽滑厘子事子墨子，三年，手足胼胝，面目黧黑。","book":"战国·宋·墨翟《墨子·备梯》"},"example":{"text":"～，面目黧黑。","book":"西汉·司马迁《史记·李斯列传》"},"similar":["手足重茧"],"usage":"作谓语；形容辛勤劳动","story":["晋朝时期，右军将军王羲之和太傅谢安一起登冶城，谢安凝神遐思，王羲之对他说：“夏禹勤王，手足胼胝；文王旰食，日不暇给。”又谈到当时盛行的空谈误国，谢安反感地说：“秦任商鞅，二世而亡，岂清言致患邪？”"]},{"id":20350,"word":"手足重茧","pinyin":"shǒu zú chóng jiǎn","abbr":"szcj","explanation":"手上脚上长满了层层老茧。形容长期劳累。","source":{"text":"昔者楚欲攻宋，墨子闻而悼之，自鲁趋而往，十日十夜，足重茧而不何处。","book":"《淮南子·修务训》"},"example":{"text":"～，不堪其苦。","book":"清·蒲松龄《聊斋志异·劳山道士》"},"similar":["手足胼胝"],"usage":"作谓语、宾语；形容长期劳累"},{"id":20351,"word":"手追心慕","pinyin":"shǒu zhuī xīn mù","abbr":"szxm","explanation":"追：追求；慕：羡慕。心头羡慕，手上模仿。形容竭力模仿。","source":{"text":"玩之不觉为倦，览之莫识其端，心慕手追，此人而已。其余区区之类，何足论哉！","book":"唐·李世民《王羲之传论》"},"example":{"text":"奔蛇走虺几千丈，诡状奇形惊户牖。～日有得，颜氏服膺承善诱。","book":"元·王恽《绛州法帖歌》"}},{"id":20352,"word":"手零脚碎","pinyin":"shǒu líng jiǎo suì","abbr":"sljs","explanation":"手脚不干净。比喻小偷小摸。","source":{"text":"我道你是聪明的卓氏，我道你是俊俏西施，怎肯便手零脚碎窃金赀 这都是崔通来妄指。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"一个绰号叫做油炸猢狲强舍，当日强梦桥之子。因他日常～，坐不安闲，身材短小，故有此名。","book":"《豆棚闲话·虎丘山贾清客联盟》"},"opposite":["手脚干净"],"usage":"作定语；用于口语"},{"id":20353,"word":"手高手低","pinyin":"shǒu gāo shǒu dī","abbr":"sgsd","explanation":"形容用手或用一般的器皿分东西，难免多少有出入。","example":{"text":"这些东西是凭手分的，难免有点～。"},"opposite":["丝毫不差"],"usage":"作宾语、定语；指有些出入"},{"id":20354,"word":"手高眼低","pinyin":"shǒu gāo yǎn dī","abbr":"sgyd","explanation":"指做事的能力强而辨识能力低。也指自己的企求高而眼界很低，比喻贪得而不识货。","source":{"text":"余尝谓北宋人手高眼低。","book":"清·况周颐《蕙风词话》第一卷"},"example":{"text":"不过劫收的人是～，有好些很可贵的东西，他们却没有要。","book":"郭沫若《洪波曲》第12章"},"opposite":["眼高手低"],"usage":"作谓语、定语；指贪得而不识货"},{"id":20355,"word":"才不半古，功已倍之","pinyin":"cái bù bàn gǔ，gōng yǐ bèi zhī","abbr":"cbbggybz","explanation":"才；有不此：古人；功：功业。才能不及古人的一半，而所立功业已多古人一倍。形容人得时遇势，易建功业。","source":{"text":"故事半古之人，功必倍之。","book":"《孟子·公孙丑上》"},"example":{"text":"故曰～，盖得之于时世也。","book":"《晋书·陆机传》"}},{"id":20356,"word":"才乏兼人","pinyin":"cái fá jiān rén","abbr":"cfjr","explanation":"才：才能；兼人：一个人抵得上两个人；乏：缺少。缺少一个能抵得上两个人才能的人。指没有特殊的才能。多用作自谦语。","source":{"text":"保安寓书于郭仲翔曰：保安幼而嗜学，长而专经，才乏兼人，官从一尉，僻在剑外。","book":"宋·李昉《太平广记·吴保字》引《纪闻》"}},{"id":20357,"word":"才人行短","pinyin":"cái rén xíng duǎn","abbr":"crxd","explanation":"才人：有才学的人；行：品行；短：缺陷。有才学的人在品行上不免有所缺陷。","source":{"text":"本知道是个风流夫婿，却不道是这样轻薄，应着一句常说的话：‘才人行短了。’","book":"清·陈森《品花宝鉴》"}},{"id":20358,"word":"才兼万人","pinyin":"cái jiān wàn rén","abbr":"cjwr","explanation":"一个人的才能抵得上许多人。用于吹嘘之词，指有特殊的才能。","source":{"text":"执事才兼万人，心照亿载，声音之道，蚤所详明。","book":"宋·李觏《上聂学士书》"}},{"id":20359,"word":"才兼文武","pinyin":"cái jiān wén wǔ","abbr":"cjww","explanation":"指人具有文武两方面的才能。","source":{"text":"熹平四年，九江蛮反，四府选植才兼文武，拜九江太守。","book":"《后汉书·卢植传》"},"example":{"text":"他非但富贵双全，并且～。","book":"清·吴趼人《九命奇冤》第二回"},"similar":["文武双全","能文能武"],"opposite":["不文不武"],"usage":"作谓语、定语；指文武全才"},{"id":20360,"word":"才华横溢","pinyin":"cái huá héng yì","abbr":"chhy","explanation":"才华：表现于外的才能。多指文学艺术方面而言，很有才华。","source":{"text":"她丈夫任北海是市电讯局才华横溢、很有前程的年轻工程师，相貌英俊，举止潇洒，待客得体。","book":"王朔《枉然不供》"},"example":{"text":"他从小就流露出才华横溢的天资来。"},"similar":["才华盖世","才华出众"],"opposite":["才疏学浅"],"usage":"作谓语、宾语、定语；指很有才华的人"},{"id":20361,"word":"才华盖世","pinyin":"cái huá gài shì","abbr":"chgs","explanation":"盖：覆盖，超过。才能很高，远远超过当代的人。","source":{"text":"他做宗人府主事时候，管宗人府的便是明善主人，是个才华盖世的名王。","book":"曾朴《孽海花》第三回"},"example":{"text":"他是一个才华盖世的科学家。"},"similar":["才华出众"],"opposite":["才疏学浅"],"usage":"作谓语、定语、补语；形容才华很高"},{"id":20362,"word":"才华超众","pinyin":"cái huá chāo zhòng","abbr":"chcz","explanation":"才华：表现于外的才能。才能远远超出一般人。"},{"id":20363,"word":"才占八斗","pinyin":"cái zhān bā dǒu","abbr":"czbd","explanation":"才：文才，才华。形容人学问高，文才好。","source":{"text":"南朝宋代的谢灵运给曹植下的评语：“天下文才共一石，而子建独得八斗！” 注：一石等于十斗。石，念 dàn 。"},"example":{"text":"奉家才子不一般，世盛业旺坐高堂。江山多娇你独秀。～超群芳。"},"similar":["才高八斗"],"usage":"作谓语、定语、宾语；形容人的文才高","story":["南朝时期，文学家谢灵运做永嘉太守时，经常游山玩水，写诗作赋，深得文帝的赏识。他因此骄傲地说：“天下的文才总共有一石，曹植占其中的八斗，我占一斗，其余的人合占一斗。”"]},{"id":20364,"word":"才墨之薮","pinyin":"cái mò zhī sǒu","abbr":"cmzs","explanation":"指文人聚集的地方。","source":{"text":"噫！江东才墨之薮，楼池船楫之观，灯洒之娱，春晨秋夕之游，美人公子，怜才好色，姚冶跌逿之乐，当我生之初，颇有存焉者矣。","book":"清·龚自珍《书金伶》"},"usage":"作主语、宾语；用于书面语"},{"id":20365,"word":"才多识寡","pinyin":"cái duō shí guǎ","abbr":"cdsg","explanation":"才：才识。识：见识。寡：少。天资高，但见识少。","source":{"text":"才：才识。识：见识。寡：少。天资高，但见识少。"},"example":{"text":"西晋嵇康～，好善暗人，是以遇踵会之祸。","book":"宋·苏轼《谢宣谕札子》"},"usage":"作谓语、定语；用于人","story":["三国时期，竹林七贤之一的嵇康跟着孙登旅游，孙登问他的意图，嵇康就是不回答。他们在一起游玩了三年终于要分开时，嵇康问孙登为什么不说话。孙登说他才多识寡，给他留下赠言：“故用光在乎得薪，所以保其耀；用才在乎识真，所以全其年。”"]},{"id":20366,"word":"才大如海","pinyin":"cái dà rú hǎi","abbr":"cdrh","explanation":"多用来称誉对方的才学渊博。"},{"id":20367,"word":"才大心细","pinyin":"cái dà xīn xì","abbr":"cdxx","explanation":"才：才能。才能很高，思考细密。","source":{"text":"加写‘才大心细，能负责任’两考语。","book":"蔡东藩《民国通俗演义》第110回"},"usage":"作谓语、宾语；用于为人"},{"id":20368,"word":"才大气高","pinyin":"cái dà qì gāo","abbr":"cdqg","explanation":"气：气质。才能出众，意气高傲。","source":{"text":"李白虽则才大气高，遇了这等时势，况且内翰高情，不好违阻。","book":"明·冯梦龙《警世通言》第九卷"},"usage":"作谓语、定语；用于为人"},{"id":20369,"word":"才大难用","pinyin":"cái dà nán yòng","abbr":"cdny","explanation":"原意是能力强难用于小事。后形容怀才不遇。同“材大难用”。","source":{"text":"有才不遇，曰才大难用。","book":"《书言故事·花木类》"},"similar":["材大难用"],"usage":"作宾语、定语；指怀才不遇"},{"id":20370,"word":"才夸八斗","pinyin":"cái kuā bā dǒu","abbr":"ckbd","explanation":"夸耀才华出众。","source":{"text":"吾谓技无大小，贵在能精……否则才夸八斗，胸号五车，为文仅称点鬼之谈，著书惟供覆瓿之用，虽多亦奚以为？","book":"清·李渔《闲情偶寄·词曲·结构》"},"similar":["才高八斗"],"opposite":["才疏学浅"],"usage":"作谓语、定语、宾语；形容人的文才"},{"id":20371,"word":"才子佳人","pinyin":"cái zǐ jiā rén","abbr":"czjr","explanation":"泛指有才貌的男女。","source":{"text":"夕阳芳草本无恨，才子佳人自多愁。","book":"唐·李隐《潇湘录·呼延冀》：“妾既与君匹偶，诸邻皆谓之才子佳人。”宋·晁补之《鹧鸪天》词"},"example":{"text":"此番招赘进蘧公孙来，门户又相称，才貌又相当，真个是“～，一双两好”。","book":"清·吴敬梓《儒林外史》第十一回"},"similar":["佳人才子","成双作对"],"opposite":["棒打鸳鸯"],"usage":"作主语、宾语；指有才貌的夫妻"},{"id":20372,"word":"才学兼优","pinyin":"cái xué jiān yōu","abbr":"cxjy","explanation":"才能和学问都优秀。","source":{"text":"恐翰林院草来不称朕意，思卿才学兼优，必有妙论，故召卿来，为朕草一诏。","book":"《隋唐演义》第三六回"},"similar":["品学兼优"],"usage":"作谓语、定语；用于评价人"},{"id":20373,"word":"才尽词穷","pinyin":"cái jìn cí qióng","abbr":"cjcq","explanation":"才；才学；尽、穷：完，没有了。才学用尽，没词了。形容学问肤浅。","source":{"text":"众人不知其意，只当他受了半日折磨，精神耗散，才尽词穷了。","book":"清·曹雪芹《红楼梦》第十七回"},"usage":"作谓语、定语；用于学识"},{"id":20374,"word":"才广妨身","pinyin":"cái guǎng fáng shēn","abbr":"cgfs","explanation":"妨：妨害。自恃才能广博，有时反而害了自己。","source":{"text":"妨：妨害。自恃才能广博，有时反而害了自己。"},"usage":"作宾语、定语；用于劝诫人"},{"id":20375,"word":"才德兼备","pinyin":"cái dé jiān bèi","abbr":"cdjb","explanation":"才：才能。德：品德。备：具备。才能和品德都具备。","source":{"text":"天涵地育王公旦，德备才全范仲淹。","book":"宋·许月卿《先天集·人邑道中三首》"},"example":{"text":"江东有一故友，乃鲁子敬，此人～。","book":"元·无名氏《娶小乔》第一折"},"similar":["德才兼备"],"opposite":["无德无才"],"usage":"作谓语、定语；指有德有才的人"},{"id":20376,"word":"才怀隋和","pinyin":"cái huái suí hé","abbr":"chsh","explanation":"才：才能；隋：隋侯珠，春秋时代非常名贵的宝珠；和：和氏璧，春秋时极有名的宝玉。形容具有罕见的才能。","source":{"text":"虽才怀隋和，行若由夷，终不可以为荣，适足以见笑而自点耳。","book":"汉·司马迁《报任少卿书》"}},{"id":20377,"word":"才望兼隆","pinyin":"cái wàng jiān lóng","abbr":"cwjl","explanation":"才：才能；望：声望；隆：高。才能和声望都很高。","source":{"text":"今卿亦须荐一才望高隆者，代卿为妙。","book":"明·罗贯中《三国演义》第七十五回"},"usage":"作谓语、定语；用于人"},{"id":20378,"word":"才望高雅","pinyin":"cái wàng gāo yǎ","abbr":"cwgy","explanation":"形容人富有才学，享有很高的声望，不同流俗。","source":{"text":"陆景初才望高雅，非常所及。","book":"《旧唐书·陆象先传》"},"example":{"text":"先生～，人人景慕。"},"similar":["才望兼隆"],"usage":"作谓语、定语；指人的修养等"},{"id":20379,"word":"才朽形秽","pinyin":"cái xiǔ xíng huì","abbr":"cxxh","explanation":"才朽：才能低下；行秽：行为不高洁。原用以表示自谦。后也用以形容不堪造就的人。","source":{"text":"恽才朽形秽，文质无所底。","book":"汉·杨恽《报孙会宗书》"}},{"id":20380,"word":"才气无双","pinyin":"cái qì wú shuāng","abbr":"cqws","explanation":"英勇的气慨，天下没有第二个人。","source":{"text":"典属国公孙昆邪为上泣曰：‘李广才气，天下无双，自负其能，数与虏敌战，恐亡之。","book":"《史记·李将军列传》"},"example":{"text":"世事几如人意，儒冠还负身谋。叹天生李广，～，不得封侯。","book":"宋·苏泂《雨中花》词"},"similar":["才气过人"],"usage":"作谓语、定语；指人的才能","story":["西汉时期，中郎将李广跟随太尉周亚夫平定吴楚等地诸侯叛乱，他立了大功，调任边境上谷太守，他英勇善战，匈奴称他为飞将军，闻风丧胆。公孙昆邱担心他的安危就上书汉景帝，请求保护这个才气无双的将领。汉景帝就把他调往内地任职"]},{"id":20381,"word":"才气超然","pinyin":"cái qì chāo rán","abbr":"cqcr","explanation":"超然：超出别人。才能气质超群出众。","source":{"text":"人误许，诗情将略，一时才气超然。","book":"宋·陆游《汉宫春》"},"usage":"作谓语、定语；用于夸奖等"},{"id":20382,"word":"才气过人","pinyin":"cái qì guò rén","abbr":"cqgr","explanation":"才：才能；气：气魄。才能气魄胜过一般的人。","source":{"text":"力能扛鼎，才气过人。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"他虽然是～的诗人，但英年早逝。"},"similar":["才识过人"],"opposite":["才疏学浅"],"usage":"作谓语、宾语、定语；形容人很有才气"},{"id":20383,"word":"才清志高","pinyin":"cái qīng zhì gāo","abbr":"cqzg","explanation":"清：清明，聪明伶俐。既聪明又有才能，也有高远的志向。","source":{"text":"才自清明志自高，生于末世运偏消。","book":"清·曹雪芹《红楼梦》第五回"}},{"id":20384,"word":"才疏学浅","pinyin":"cái shū xué qiǎn","abbr":"csxq","explanation":"疏：浅薄。才学不高，学识不深（多用作自谦的话）。","source":{"text":"若学浅而空迟，才疏而徒速，以斯成器，未之前闻。","book":"《汉书·谷永传》：“臣才朽学浅，不通政事。”南朝·梁·刘勰《文心雕龙·神思》"},"example":{"text":"在下虽有此志，只是～，年纪又轻，经练更少。","book":"清·吴趼人《痛史》第十一回"},"similar":["略识之无","吴下阿蒙"],"opposite":["博学多才","真才实学"],"usage":"作谓语、定语；用于自谦"},{"id":20385,"word":"才疏德薄","pinyin":"cái shū dé bó","abbr":"csdb","explanation":"才识疏浅，德行不高。常用作自谦之词。","source":{"text":"小生才疏学薄，敢劳大人下降，真乃蓬荜生辉也。","book":"元·无名氏《东篱赏菊》第三折"},"similar":["才轻德薄"],"opposite":["才德兼备"],"usage":"作谓语、定语；用于自谦"},{"id":20386,"word":"才疏志大","pinyin":"cái shū zhì dà","abbr":"cszd","explanation":"才干有限而抱负很大。","source":{"text":"融负其高气，志在靖难，而才疏意广，迄无成功。","book":"《后汉书·孔融传》"},"example":{"text":"～不自量，西家东家笑我狂。","book":"宋·陆游《大风登城》诗"},"similar":["才高意广","志大才疏","志大才短"],"usage":"作谓语、定语；形容抱负大才能不高"},{"id":20387,"word":"才疏意广","pinyin":"cái shū yì guǎng","abbr":"csyg","explanation":"疏：粗疏；广：广大。才干有限而抱负很大。","source":{"text":"融负其高气，志在靖难，而才疏意广，迄无成功。","book":"《后汉书·孔融传》"},"example":{"text":"世以成败论人物，故操得在英雄之列，而公且谓“～”，岂不悲哉！","book":"宋·苏轼《孔北海赞》"},"similar":["才高意广"],"usage":"作谓语、定语；形容抱负大才能不高","story":["东汉时期，孔子的第20世孙孔融才学很高，名声大，但缺乏政治、军事才能，因与董卓不合，被派去镇压黄巾起义军，经常被起义军包围，刘备帮他解围。袁绍的儿子袁潭率军攻打孔融，活捉了他的妻小，这个才疏意广的孔融吓得仓皇逃跑"]},{"id":20388,"word":"才疏技拙","pinyin":"cái shū jì zhuō","abbr":"csjz","explanation":"疏：粗疏。才识不高，不善谋算。","source":{"text":"今老去，才疏技拙，百居人后。","book":"元·魏初《满江红·寄何侍御》"}},{"id":20389,"word":"才疏智浅","pinyin":"cái shū zhì qiǎn","abbr":"cszq","explanation":"才：才能；疏：稀少；智：智慧。才识不高，智力短浅。用作自谦之词。","source":{"text":"愚才疏智浅，恐不堪当此任。","book":"明·罗贯中《三国演义》第八十五回"}},{"id":20390,"word":"才疏计拙","pinyin":"cái shū jì zhuō","abbr":"csjz","explanation":"指才识疏浅，不善谋算。","source":{"text":"今老去，才疏计拙，百居人后。","book":"元·魏初《满江红·寄何侍御》词"},"usage":"作谓语、定语；用于人的才能"},{"id":20391,"word":"才疏识浅","pinyin":"cái shū shí qiǎn","abbr":"cssq","explanation":"才：才能；疏：空虚；识：学识；浅：浅薄。才能不高，学问浅薄。","source":{"text":"才：才能；疏：空虚；识：学识；浅：浅薄。才能不高，学问浅薄。"},"similar":["才疏学浅"],"opposite":["博学多才"],"usage":"作谓语、定语；用于自谦"},{"id":20392,"word":"才短思涩","pinyin":"cái duǎn sī sè","abbr":"cdss","explanation":"才：才识；短：短浅；涩：迟钝。见识短浅，思路迟钝。指写作能力差。","source":{"text":"适当书诏填委之时，才短思涩，目不暇给。","book":"宋·楼钥《攻媿集·雷雨应诏封事》"},"example":{"text":"今人作平澹诗，乃～，格卑调哑。","book":"清·薛雪《一瓢诗话》"},"usage":"作谓语、定语；用于写作"},{"id":20393,"word":"才短气粗","pinyin":"cái duǎn qì cū","abbr":"cdqc","explanation":"才：才识；短：短浅；气：气质。缺少才干，气质粗鲁。","source":{"text":"禄山才短气粗，当此大镇，深不能胜任。","book":"清·褚人获《隋唐演义》第83回"},"example":{"text":"他是一个～的人。"},"similar":["无德无才"],"opposite":["德才兼备"],"usage":"作谓语、定语；指庸人"},{"id":20394,"word":"才秀人微","pinyin":"cái xiù rén wēi","abbr":"cxrw","explanation":"秀：优异。微：卑微，低微。指才能优异而地位卑微。","source":{"text":"嗟其才秀人微，故取湮当代。","book":"南朝·梁·钟嵘《诗品》卷中"},"usage":"作谓语；用于人怀才不遇"},{"id":20395,"word":"才竭智疲","pinyin":"cái jié zhì pí","abbr":"cjzp","explanation":"竭：枯竭；用尽；智：智慧；疲：疲竭。才能用尽，智力衰竭。","source":{"text":"弟子事夫子有年矣，才竭而智罢，振于学问不能复进，请一休焉。","book":"汉·韩婴《韩诗外传》卷八"},"usage":"作谓语、定语；用于人的处境"},{"id":20396,"word":"才艺卓绝","pinyin":"cái yì zhuó jué","abbr":"cyzj","explanation":"才：才能；艺：技艺；卓绝：高超无缘。才能技艺高超，无以伦比。","source":{"text":"人虽才艺卓绝，不能悖理成行，逆人道也。","book":"汉·桓谭《新论·思慎》"},"similar":["才艺双绝"],"usage":"作谓语、定语；指人的才艺"},{"id":20397,"word":"才蔽识浅","pinyin":"cái bì shí qiǎn","abbr":"cbsq","explanation":"蔽：塞而不通。才能蔽塞见识浅陋。","source":{"text":"臣才蔽识浅，非集誉于乡曲；荣降宠臻，乃假翼于皇极。","book":"南朝·梁·江淹《萧重让扬州表》"},"example":{"text":"请原谅我的～。"},"similar":["才疏学浅"],"usage":"作谓语、定语；用于自谦"},{"id":20398,"word":"才薄智浅","pinyin":"cāi bó zhì qiǎn","abbr":"cbzq","explanation":"形容人的才智浅薄。自谦的说法。","source":{"text":"某才薄智浅，不称其职。","book":"明·罗贯中《三国演义》第98回"},"example":{"text":"他～，根本不能胜任。"},"similar":["才疏学浅"],"opposite":["博学多才"],"usage":"作谓语、定语；用于自谦"},{"id":20399,"word":"才藻富赡","pinyin":"cái zǎo fù shàn","abbr":"czfs","explanation":"藻：文采；赡：充足。富有才华文采。","source":{"text":"才藻富赡，好为文章。诗赋铭颂，任兴而作。有大文笔，马上口授。及其成也，不改一字。","book":"《北史·魏孝文帝纪》"}},{"id":20400,"word":"才藻艳逸","pinyin":"cái zǎo yàn yì","abbr":"czyy","explanation":"才藻：才情和文采，才华；艳：华美；逸；超逸。才华华美超逸。","source":{"text":"瑀子籍才藻艳逸，而倜傥放荡。","book":"晋·陈寿《三国志·魏志·王粲传》"},"usage":"作谓语、定语；指人的才华"},{"id":20401,"word":"才识不逮","pinyin":"cái shí bù dǎi","abbr":"csbd","explanation":"才：才能；识：见识；逮：及，到。才能和见识都不高。","source":{"text":"才识不逮而忠实有余，次也。","book":"《宋史·刘挚传》"}},{"id":20402,"word":"才识有余","pinyin":"cái shí yǒu yú","abbr":"csyy","explanation":"才：才能；识：见识。才能和见识都有剩余。指才能很高，见识极广。","source":{"text":"人才难得，能否不一，性忠实而才识有余，上也。","book":"《宋史·刘挚传》"}},{"id":20403,"word":"才识过人","pinyin":"cái shí guò rén","abbr":"csgr","explanation":"才能和见识超过一般人。","source":{"text":"果然不干我事，是兄弟才识过人。","book":"元·马致远《荐福碑》第四折"},"example":{"text":"其～，胆气压乎群类。","book":"明·李贽《焚书·杂述·因记往事》"},"similar":["才气过人"],"usage":"作谓语、定语；指人的才识"},{"id":20404,"word":"才调秀出","pinyin":"cái diào xiù chū","abbr":"cdxc","explanation":"才调：才情。形容才情风格优异出众。","source":{"text":"才调秀出，见赏知音。","book":"《晋书·王接传论》"},"usage":"作谓语、定语；用于夸奖人"},{"id":20405,"word":"才貌两全","pinyin":"cái mào liǎng quán","abbr":"cmlq","explanation":"才学相貌都好。同“才貌双全”。","source":{"text":"七岁草字如云，十岁吟诗应口，才貌两全，京师人每呼少俊。","book":"元·白朴《墙头马上》第一折"},"example":{"text":"元·白朴《墙头马上》第一折：“七岁草字如云，十岁吟诗应口，才貌两全，京师人每呼少俊。”"}},{"id":20406,"word":"才貌俱全","pinyin":"cái mào jù quán","abbr":"cmjq","explanation":"俱：全，都。既有才学，容貌又美。亦作“才貌兼全”、“才貌双绝”、“才貌双全”、“才貌两全”。","source":{"text":"那宝玉素闻北静王的贤德，且才貌俱全，风流跌宕，不为官俗国体所缚，每思相会，只是父亲拘束，不克如愿。今见反来叫他，自是喜欢。","book":"清·曹雪芹《红楼梦》第十四回"},"example":{"text":"秀清本不甚通文，统归钱江取录，只看中这女状元，～，便叫她充东王府女簿书，日司文牍，夜共枕席。","book":"蔡东藩《清史演义》第六十回"},"similar":["才貌双全"],"usage":"作谓语、定语；形容人外貌、才学兼备"},{"id":20407,"word":"才貌兼全","pinyin":"cái mào jiān quán","abbr":"cmjq","explanation":"既有才学，容貌又美。同“才貌双全”。","source":{"text":"高赞见女儿人物整齐，且又聪明，不肯将他配个平等之，定要拣个读书君子、才貌兼全的配他，聘礼厚薄到也不论。","book":"明·冯梦龙《醒世恒言》第七卷"},"example":{"text":"这是太太过谦，家相公曾对妾身说，大相公是～的，不知曾对了亲么？","book":"清·陈朗《雪月梅》第二十八回"},"similar":["才貌双全","才貌超群"],"usage":"作谓语、定语；形容人外貌、才学兼备"},{"id":20408,"word":"才貌双全","pinyin":"cái mào shuāng quán","abbr":"cmsq","explanation":"才学相貌都好。","source":{"text":"七岁草字如云，十岁吟诗应口，才貌两全，京师人每呼少俊。","book":"元·白朴《墙头马上》第一折"},"example":{"text":"刚配和一个～的女婿，情性又好，偏偏的得了冤孽症候，不过捱日子罢了。","book":"清·曹雪芹《红楼梦》第一一０回"},"similar":["才貌超群","才貌出众"],"usage":"作谓语、定语；形容人外貌、才学兼备"},{"id":20409,"word":"才貌双绝","pinyin":"cái mào shuāng jué","abbr":"cmsj","explanation":"才学相貌都好。同“才貌双全”。","source":{"text":"久闻足下大名，果然才貌双绝。","book":"明·方汝浩《禅真逸史》第三十五回"},"example":{"text":"越公因有一继女，～，年纪及笄，越公爱之，不啻己出。","book":"清·褚人获《隋唐演义》第十六回"},"similar":["才貌双全","才貌超群"],"usage":"作谓语、定语；形容人外貌、才学兼备"},{"id":20410,"word":"才貌超群","pinyin":"cái mào chāo qún","abbr":"cmcq","explanation":"才能和容貌都超过一般人。","example":{"text":"他的女儿～，追求的人很多。"},"similar":["才貌双全"],"usage":"作谓语、定语；用于夸奖人"},{"id":20411,"word":"才贯二酉","pinyin":"cái guàn èr yǒu","abbr":"cgey","explanation":"二酉：指大酉山、小酉山。因以之形容读书甚多、学识渊博。","source":{"text":"据《太平御览》卷四引《荆州记》裁：传说大酉、小酉(在今湖南沅陵县)二山藏书很多。"},"example":{"text":"大贤世居大邦，见多识广，而且荣列胶庠，自然～，学富五车了。","book":"《镜花缘》一六回"},"similar":["学富五车"],"usage":"作谓语、定语；指人的学识"},{"id":20412,"word":"才轻任重","pinyin":"cái qīng rèn zhòng","abbr":"cqrz","explanation":"才能不高而肩负重任。","source":{"text":"或劝勔解职，勔曰：‘吾执心行己，无愧幽明，若才轻任重，灾眚必及，天道密微，避岂得免？","book":"《宋书·刘勔传》"}},{"id":20413,"word":"才轻德薄","pinyin":"cái qīng dé bó","abbr":"cqdb","explanation":"才识疏浅，德行不高。常用作自谦之词。同“才疏德薄”。","source":{"text":"想小官生居寒门，长在白屋，才轻德薄，智穷量浅，有劳先生不弃相探也。","book":"元·无名氏《衣锦还乡》第一折"},"similar":["才疏德薄"],"opposite":["才德兼备"],"usage":"作谓语、定语；用于自谦"},{"id":20414,"word":"才过屈宋","pinyin":"cái guò qū sòng","abbr":"cgqs","explanation":"屈、宋：战国楚文学家屈原和宋玉。比喻文才极高。","source":{"text":"唐·杜甫《醉时歌》“先生有道出羲黄，先生有才过屈宋。”"},"example":{"text":"道出羲黄，～，空有名垂古。","book":"宋·林正大《括酹江月》词"},"similar":["才高七步"],"usage":"作谓语、定语；用于夸奖人"},{"id":20415,"word":"才高七步","pinyin":"cái gāo qī bù","abbr":"cgqb","explanation":"形容才思敏捷。","source":{"text":"文帝（曹丕）尝令东阿王（丕弟曹植）七步中作诗，不成者行大法；应声便为诗曰：‘煮豆持作羹，漉豉以为汁；箕在釜下燃，豆在釜中泣。本自同根生，相煎何太急！’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"实有大通文理之人，学贯五经，～，自持有才不肯屈志于人，好高使气，不肯去营求钻刺，反受饥寒寂寞之苦。","book":"《西湖二集·七妓佐夫成名》"},"similar":["才高八斗"],"usage":"作谓语、定语；指人的文才"},{"id":20416,"word":"才高倚马","pinyin":"cái gāo yǐ mǎ","abbr":"cgym","explanation":"文才比倚马可待的袁虎还高。形容文思敏捷。","source":{"text":"那秘书员成竹在胸，才高倚马，立刻草成八九百字。","book":"蔡东藩《民国通俗演义》第55回"},"similar":["才高七步"],"usage":"作谓语、定语；指人的文才"},{"id":20417,"word":"才高八斗","pinyin":"cái gāo bā dǒu","abbr":"cgbd","explanation":"才：才华。比喻人极有才华。","source":{"text":"天下才共一石，曹子建独得八斗，我得一斗，自古及今共用一斗。","book":"《南史·谢灵运传》"},"example":{"text":"左宗棠这人虽然～，器量却不开阔。","book":"唐浩明《曾国潘》"},"similar":["八斗之才","才识过人","才华横溢"],"opposite":["才疏学浅","才疏志浅"],"usage":"作谓语、定语、宾语；形容人的文才高","story":["南朝时期，文学家谢灵运做永嘉太守时，经常游山玩水，写诗作赋，深得文帝的赏识。他因此骄傲地说：“天下的文才总共有一石，曹植占其中的八斗，我占一斗，其余的人合占一斗。”"]},{"id":20418,"word":"才高咏絮","pinyin":"cái gāo yǒng xù","abbr":"cgyx","explanation":"表示人有卓越的文学才能。多指女子。","source":{"text":"俄而雪骤，公欣然曰：‘白雪纷纷何所拟？’兄子胡儿曰：‘撒盐空中差可拟。’兄女曰：‘未若柳絮因风起。’公大笑乐。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"痛一般临风玉树，生埋黄土。自古红颜多薄命，何况～。","book":"清·沈惠昭《金缕曲》词"}},{"id":20419,"word":"才高意广","pinyin":"cái gāo yì guǎng","abbr":"cgyg","explanation":"才学高的人，抱着奢望，难以成事。","source":{"text":"大抵才高意广，如孔北海之徒。","book":"明·胡震亨《唐音癸签》"},"example":{"text":"妖由人兴，象由心造。～，翻以好异陨生。","book":"清·纪昀《阅微草堂笔记·如是我闻二》"},"similar":["德才兼备"],"opposite":["才疏意广","志大才疏"],"usage":"作谓语、定语；形容才能很高"},{"id":20420,"word":"才高气清","pinyin":"cái gāo qì qīng","abbr":"cgqq","explanation":"指才能高超而气质清峻。","source":{"text":"足下才高气清，行古道，处今世，无田而衣食。","book":"唐·韩愈《与孟东野书》"},"example":{"text":"唐·韩愈《与孟东野书》：“足下才高气清，行古道，处今世，无田而衣食。”"},"opposite":["才短气粗"],"usage":"作谓语、定语；指文人雅士"},{"id":20421,"word":"才高行厚","pinyin":"cái gāo xíng hòu","abbr":"cgxh","explanation":"厚：不可轻薄，端谨。指才能高，品德端谨。","source":{"text":"或时才高行厚，命恶，废而不进；知寡德薄，命善兴而超迈。","book":"汉·王充《论衡·命禄》"},"similar":["才高行洁"],"usage":"作谓语、定语；指人的品性与能力"},{"id":20422,"word":"才高行洁","pinyin":"cái gāo xíng jié","abbr":"cgxj","explanation":"才智高超，操行纯洁。","source":{"text":"贤不贤，才也；遇不遇，时也。才高行洁，不可保以必尊贵；能薄操浊，不可保以必卑贱。","book":"汉·王充《论衡·逢遇》"},"example":{"text":"我们需要～的好干部。"},"similar":["才高行厚","德才兼备"],"opposite":["缺德少才","才疏学浅"],"usage":"作谓语、宾语、定语；形容人德才兼备的良好"},{"id":20423,"word":"才高识远","pinyin":"cái gāo shí yuǎn","abbr":"cgsy","explanation":"才能超众，见识深远。","source":{"text":"志节慷慨忠义俱，才高识远器有余。","book":"宋·强至《祠部集·送王宾玉》"},"similar":["博学多才"],"usage":"作谓语、定语；用于夸奖人"},{"id":20424,"word":"才高运蹇","pinyin":"cái gāo yùn jiǎn","abbr":"cgyj","explanation":"蹇：不顺利。才学很高，但命运不好，无法施展才华。含怀才不遇之意。","source":{"text":"司马貌虽然出言无忌，但此人因才高运蹇，抑郁不平，致有此论。","book":"明·冯梦龙《喻世明言》第三十一卷"},"example":{"text":"另期殿试，子玉文星照命，也占鳌头，共取了三十二名。仲清、高品～，皆被落。","book":"清·陈森《品花宝鉴》第五十四回"},"similar":["怀才不遇"],"usage":"作谓语、定语；用于人"},{"id":20425,"word":"扎手舞脚","pinyin":"zhā shǒu wǔ jiǎo","abbr":"zswj","explanation":"形容手脚不停地张开活动，不沉稳的样子。","source":{"text":"袭人进了房门，转过集锦子，就听的鼾如雷，忙进来，只闻见酒屁臭气满屋。一瞧，只见刘老老扎手舞脚的仰卧在床上。","book":"清·曹雪芹《红楼梦》第四十一回"},"example":{"text":"蒋爷将手一松，放在船头，便进舱内将灯剔亮，见平山～于竹床之上。（清·石玉昆《三侠五义》第九十五回）"},"similar":["札手舞脚"],"usage":"作谓语、定语、状语；指动手动脚"},{"id":20426,"word":"扎扎实实","pinyin":"zhā zhā shí shí","abbr":"zzss","explanation":"牢固，结实。也指实在，踏实。","source":{"text":"青年报发表社论，提出号召，不要搞一般号召，而是扎扎实实地告诉青年怎么做法。","book":"邓小平《提倡深入细致的工作》"},"example":{"text":"我们要～地学好基础知识。"},"similar":["切切实实"],"usage":"作定语、状语；指实在"},{"id":20427,"word":"扎根串连","pinyin":"zhā gēn chuàn lián","abbr":"zgcl","explanation":"深入群众并将分散的群众串连起来。","source":{"text":"她和许多土改干部一样搞好了扎根串连的工作。","book":"周鸣钢《没有双手的女英雄》"},"usage":"作谓语、定语；用于口语"},{"id":20428,"word":"扑作教刑","pinyin":"pū zuò jiào xíng","abbr":"pzjx","explanation":"扑：戒尺；教刑：上古刑法的一种。原意为以戒尺责打不遵守教令的人。后多用以戏称责打。","source":{"text":"象以典刑，流宥五刑，鞭作官刑，扑作教刑，金作赎刑。","book":"《尚书·舜典》"},"example":{"text":"明帝在日，曾饬陈太妃随时训责，～。","book":"蔡东蕃《南北史演义》第二十四回"},"usage":"作谓语、宾语；用于书面语"},{"id":20429,"word":"扑击遏夺","pinyin":"pū jī è duó","abbr":"pjed","explanation":"扑击：打击。指拦路打劫。","source":{"text":"于是乎聚众多之徒，以深山广泽林薮，扑击遏夺。","book":"《吕氏春秋·安死》"}},{"id":20430,"word":"扑地掀天","pinyin":"pū dì xiān tiān","abbr":"pdxt","explanation":"形容闹得很凶。","source":{"text":"青苔扑地连春雨，白浪掀天尽日风。","book":"唐·白居易《风雨晚泊》诗"},"example":{"text":"只管～无了休，着甚么来由。","book":"元·关汉卿《金线池》第二折"},"usage":"作宾语、定语；用于势力大"},{"id":20431,"word":"扑天盖地","pinyin":"pū tiān gài dì","abbr":"ptgd","explanation":"铺天盖地。形容声势大，来势猛。","source":{"text":"扑天盖地的烟，把麦地罩得什么也看不见了。","book":"西戎《宋老大进城》"},"similar":["铺天盖地"],"usage":"作谓语、定语、状语；形容来势很猛"},{"id":20432,"word":"扑心扑肝","pinyin":"pū xīn pū gān","abbr":"pxpg","explanation":"尽心竭力。","example":{"text":"她～还不是为了我们好。"},"similar":["尽心竭力"],"usage":"作谓语、状语；指尽力"},{"id":20433,"word":"扑朔迷离","pinyin":"pū shuò mí lí","abbr":"psml","explanation":"指难辨兔的雌雄。形容事情错综复杂，难以辨别清楚。","source":{"text":"雄兔脚扑朔，雌兔眼迷离，双兔傍地走，安能辨我是雄雌。","book":"《乐府诗集·横吹曲辞五·木兰诗》"},"example":{"text":"敌军却始终～，不知我军主力所在。","book":"杨至城《巧使敌人就范》"},"similar":["虚无飘渺","眼花缭乱","错综复杂"],"opposite":["一清二楚"],"usage":"作谓语、定语；形容事情杂乱","story":["从前北方地区因为遭到外族入侵，朝廷只好到每家都征兵，木兰见家里父亲年迈，弟弟很少，只好女扮男装从军，立下很大战功回家，都没有知道她是女人，自豪地说：“雄兔脚扑朔，雌兔眼迷离。双兔傍地走，安能辨我是雄雌？”"]},{"id":20434,"word":"扑杀此獠","pinyin":"pū shā cǐ lǎo","abbr":"pscl","explanation":"扑杀：打死；獠：古时骂人的话。打死这个坏家伙。形容对某人憎恨之极。","source":{"text":"武氏从幄后呼曰：‘何不扑杀此獠？’","book":"《新唐书·褚遂良传》"},"example":{"text":"为此号召同侪，决意～。","book":"清·许叔平《里乘·老圃某翁》"},"usage":"作谓语、定语；指十分憎恨","story":["唐朝时期，唐高宗想废掉皇后立昭仪武氏为后。大臣褚遂良据理力争，说武则天曾经侍奉过唐太宗，如果立她为后将如何面对天下百姓。说完就请求告老还乡。高宗大怒，叫人把褚遂良拉出去听命。武则天则从幕后走出要求杀掉褚遂良"]},{"id":20435,"word":"扑满之败","pinyin":"pū mǎn zhī bài","abbr":"pmzb","explanation":"扑满：储蓄用的瓦器；败：失败。指因聚钱财而招致的败落。","source":{"text":"上有聚敛而不能散者，将有扑满之败，可不诫欤。","book":"晋·邹长倩《遗公孙弘书》"}},{"id":20436,"word":"扑满招尤","pinyin":"pū mǎn zhā yóu","abbr":"pmzy","explanation":"扑满：储蓄用的瓦器。指因聚钱财而招致的败落。","source":{"text":"上有聚敛而不能散者，将有扑满之败，可不诫欤。","book":"晋·邹长倩《遗公孙弘书》"},"example":{"text":"记中崔子以好施受福，任贼以～，作者欲以惕世也。","book":"明·祁彪佳《远山堂曲品·能品·紫绮裘》"}},{"id":20437,"word":"扒拉不开","pinyin":"bā lā bù kāi","abbr":"blbk","explanation":"扒拉：用手指头快速移动。不能如意安排或运动。","example":{"text":"他～家里的钱，只好拆东补西。"},"usage":"作谓语、定语；用于处事"},{"id":20438,"word":"扒耳搔腮","pinyin":"pá ěr sāo sāi","abbr":"pess","explanation":"形容焦急而又无可奈何。","source":{"text":"还有一个小目的，是在对于以我去年的免官为‘痛快’者，给他一个不舒服，使他恨得扒耳搔腮，忍不住露出本相。","book":"鲁迅《华盖集续编·不是信》"},"similar":["抓耳挠腮"],"usage":"作定语、状语；指人的神态"},{"id":20439,"word":"扒高踩低","pinyin":"bā gāo cǎi dī","abbr":"bgcd","explanation":"比喻对上奉承攀附，对下欺侮压制。","source":{"text":"[李四一]为人就是扒高踩低，浮上水在行。","book":"《中国民间故事选·叛徒李四一》"},"similar":["欺红踩黑","欺软怕硬"],"opposite":["和平共处"],"usage":"作谓语、定语；指上下级关系"},{"id":20440,"word":"打下马威","pinyin":"dǎ xià mǎ wēi","abbr":"dxmw","explanation":"官吏初到任时，严厉对待属员，并加以责打，以显示威风。后也指初见面时借故给人出难题，以显示自己的权威。","source":{"text":"执所携巴棍而毒殴之，名曰打下马威。","book":"清·黄六鸿《福惠全书》"},"similar":["下马威"],"usage":"作谓语、定语；指借故给人出难题"},{"id":20441,"word":"打个照面","pinyin":"dǎ gè zhào miàn","abbr":"dgzm","explanation":"指面对面地不期而遇。","source":{"text":"刚刚的打个照面，风魔了张解元。","book":"元·王实甫《西厢记》第一折"},"example":{"text":"新妆方罢……恰好与凤生～。","book":"明·凌濛初《二刻拍案惊奇》第九卷"},"usage":"作谓语、定语；指见面"},{"id":20442,"word":"打乱阵脚","pinyin":"dǎ luàn zhèn jiǎo","abbr":"dlzj","explanation":"阵脚：本指交战时的队列，引申为作战部署。比喻打乱了原来的安排和部署。"},{"id":20443,"word":"打人骂狗","pinyin":"dǎ rén mà gǒu","abbr":"drmg","explanation":"对人滥打乱骂，摆尽威风。","source":{"text":"秋桐见贾涟请医调治，打人骂狗，为二姐十分尽心，他心里早浸了一缸醋在内了。","book":"清·曹雪芹《红楼梦》第六十九回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":20444,"word":"打光棍","pinyin":"dǎ guāng gùn","abbr":"dgg","explanation":"指单身成年男子适婚年龄后仍未结婚或婚后又失去妻子的男子。","source":{"text":"虽然他和她结婚几年，但一直等于打光棍。","book":"路遥《平凡的世界》第四卷第50章"},"similar":["光棍一条"],"usage":"作谓语、宾语、定语；用于口语"},{"id":20445,"word":"打入冷宫","pinyin":"dǎ rù lěng gōng","abbr":"drlg","explanation":"打：与某些动词结合成为一个词，表示进行的意思；冷宫：古代皇帝把失宠的后妃软禁于冷僻宫内。比喻人不被重视或把事情搁置一边。","example":{"text":"她已经被打入冷宫。"},"similar":["坐冷板凳"],"usage":"作谓语；指不被重视"},{"id":20446,"word":"打凤捞龙","pinyin":"dǎ fèng lāo lóng","abbr":"dfll","explanation":"凤、龙：这里指人才。比喻搜索、物色难得的人才。","source":{"text":"也不须打凤捞龙，别选元戎。","book":"元·朱凯《昊天塔》第一折"},"similar":["打凤牢龙"],"usage":"作谓语、宾语；指挑选人才"},{"id":20447,"word":"打凤牢龙","pinyin":"dǎ fèng láo lóng","abbr":"dfll","explanation":"比喻安排圈套使强有力的对手中计。","source":{"text":"安排下打凤牢龙，准备着天罗地网，也不是待客筵席，则是个杀人、杀人的战场。","book":"元·关汉卿《单刀会》第三折"},"example":{"text":"遮莫你贞烈心肠硬似铁，我将那～的计设，都付与玉轸金徽，也不索雁简鱼帖。","book":"明·朱权《卓文君》第二折"},"similar":["打凤捞龙"],"usage":"作谓语、宾语；用于书面语"},{"id":20448,"word":"打出吊入","pinyin":"dǎ chū diào rù","abbr":"dcdr","explanation":"指恶狠狠地走进走出。","source":{"text":"周三那厮，打出吊入，公然干颡。计安忍不得，不住和那周三厮闹。","book":"明·冯梦龙《警世通言》卷二十"},"usage":"作谓语、状语；用于人的状态"},{"id":20449,"word":"打出王牌","pinyin":"dǎ chū wáng pái","abbr":"dcwp","explanation":"使出杀手锏去制约别人。","example":{"text":"我们在必要的时候才～。"},"similar":["孤注一掷"],"usage":"作谓语；用于处事"},{"id":20450,"word":"打击报复","pinyin":"dǎ jī bào fù","abbr":"djbf","explanation":"打击：攻击。用敌对的态度回击对方。","source":{"text":"公文旅行，互相推诿，以至官气十足，动辄训人，打击报复，压制民主，欺上瞒下，专横跋扈，徇私行贿，贪赃枉法，等等。","book":"邓小平《党和国家领导制度的改革》"},"example":{"text":"披露了我们向上级反映我店截留利润六十五万元的问题后，遭受～的一些真相。","book":"《人民日报》1988.12.31"},"usage":"作谓语、宾语；形容对人进行报复"},{"id":20451,"word":"打前站","pinyin":"dǎ qián zhàn","abbr":"dqz","explanation":"行军或集体出行时先派人到将要停留或到达的地点去办理食宿等事务。","source":{"text":"大王即刻到了，洒家是打前站的，你下马饭完也未？","book":"明·冯梦龙《警世通言·赵太祖千里送京娘》"},"example":{"text":"走几天就休息一天，由～的卖去一些土布，买肉改善伙食。","book":"孙犁《秀露集·〈善闇室纪年〉摘抄》"}},{"id":20452,"word":"打勤献趣","pinyin":"dǎ qín xiàn qù","abbr":"dqxq","explanation":"献殷勤，凑趣。形容阿谀奉承。","source":{"text":"那晁住媳妇……是吴国伯嚭托生的，惯会打勤献趣。","book":"清·西周生《醒世姻缘传》第八回"},"similar":["阿谀奉迎"],"usage":"作谓语、宾语；用于交往"},{"id":20453,"word":"打嘴现世","pinyin":"dǎ zuǐ xiàn shì","abbr":"dzxs","explanation":"形容出尽了丑。","source":{"text":"你我这样嘴脸，怎么好到他门上去？只怕他门上人也不肯进去告诉，没的白打嘴现世的。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"我哪辈子造了孽，你给我丢人现眼的，～的，叫我有什么脸见人。","book":"杨朔《三千里江山》"},"similar":["丢人现眼"],"usage":"作谓语、宾语、定语；同“丢人现眼”"},{"id":20454,"word":"打圆场","pinyin":"dǎ yuán chǎng","abbr":"dyc","explanation":"调解纠纷，从中说和，使几方面都能接受，从而使僵局缓和下来。","source":{"text":"亏得和尚打圆场，好容易才把那女人劝下的，所以同了他来。","book":"清·李宝嘉《官场现形记》第十一回"},"example":{"text":"我们希望他来～。"},"similar":["和稀泥"],"usage":"作谓语、定语；指处理尴尬局面"},{"id":20455,"word":"打埋伏","pinyin":"dǎ mái fú","abbr":"dmf","explanation":"比喻隐藏物资、人力或隐瞒问题。也指事先隐藏起来，待时行动。","source":{"text":"当时有些社员见他这么说，明知道他是打埋伏，不想要他，经过几天研究之后，还是要了。","book":"赵树理《三里湾》十七"}},{"id":20456,"word":"打头风","pinyin":"dǎ tóu fēng","abbr":"dtf","explanation":"指逆风。","source":{"text":"黄柳影笼随棹月，白蘋香起打头风。","book":"唐·白居易《小舫》诗"},"example":{"text":"一出门就遇～，倒了运。","book":"碧野《没有花的春天》第六章"}},{"id":20457,"word":"打定主意","pinyin":"dǎ dìng zhǔ yì","abbr":"ddzy","explanation":"下定决心，抉择做什么事。","source":{"text":"南宫敬叔和夫子最契合，请他先容，最为合宜，打定主意，便一径往访敬叔。","book":"丁寅生《孔子演义》第18回"},"example":{"text":"他～非把事情弄明白不可。"},"similar":["拿定主意"],"opposite":["犹豫不决"],"usage":"作谓语、定语；指决定"},{"id":20458,"word":"打家劫盗","pinyin":"dǎ jiā jié dào","abbr":"djjd","explanation":"劫：抢夺。指到人家里抢劫财物。","source":{"text":"但凡打家劫盗，杀人夺财，都是俺两个当先。","book":"元·无名氏《杏林庄》第二折"},"similar":["打家劫舍","打家截道"],"usage":"作主语、谓语、定语；指抢劫"},{"id":20459,"word":"打家劫舍","pinyin":"dǎ jiā jié shè","abbr":"djjs","explanation":"劫：强抢；舍：住房。指成帮结伙到人家里抢夺财物。","source":{"text":"见俫子撅天扑地，不弱如打家劫舍杀人贼。","book":"元·武汉臣《玉壶春》第四折"},"example":{"text":"近年泊内是宋江一伙强人在那里～，官兵捕盗，近他不得。","book":"明·施耐庵《水浒全传》第六十回"},"similar":["为非作歹","杀人越货","趁火打劫"],"opposite":["扶危济困","劫富济贫"],"usage":"作主语、谓语、定语；指抢劫"},{"id":20460,"word":"打家截舍","pinyin":"dǎ jiā jié shě","abbr":"djjs","explanation":"指到人家里抢夺财物。同“打家劫舍”。","source":{"text":"某裴炎的便是，一生好打家截舍。","book":"元·关汉卿《绯衣梦》第二折"},"similar":["打家劫舍"],"usage":"作主语、谓语、定语；指抢劫"},{"id":20461,"word":"打家截道","pinyin":"dǎ jiā jié dào","abbr":"djjd","explanation":"指到人家里和在路上抢夺财物。","source":{"text":"一生杀人放火，打家截道，偷东摸西。","book":"元·关汉卿《四春园》第二折"},"example":{"text":"这厮待强风情～拚着做，那里讨护身符。","book":"明·贾仲名《对玉梳》第三折"},"similar":["打家劫舍"],"usage":"作谓语、宾语、定语；指拦路抢劫"},{"id":20462,"word":"打富济贫","pinyin":"dǎ fù jì pín","abbr":"dfjp","explanation":"打击豪绅、地主，贪官污吏，夺取其财物救济穷人。","source":{"text":"打日本，反汉奸是天经地义啦，他们又打富济贫，这全对他的劲。","book":"丁玲《太阳照在桑干河上》"},"example":{"text":"李自成在商洛山～。"},"similar":["杀富济贫"],"usage":"作谓语、宾语；同“杀富济贫”"},{"id":20463,"word":"打小报告","pinyin":"dǎ rù lěng gōng","abbr":"dxbg","explanation":"打：与某些动词结合成为一个词，表示进行的意思；冷宫：古代皇帝把失宠的后妃软禁于冷僻宫内。比喻人不被重视或把事情搁置一边。","source":{"text":"‘谁打小报告我跟他急！’李东宝气势汹汹说了一句，和颜悦色地坐下。","book":"王朔《谁比谁傻多少》"},"example":{"text":"她已经被打入冷宫。"},"similar":["暗箭伤人"],"opposite":["直言不讳"],"usage":"作谓语、宾语；指暗中汇报"},{"id":20464,"word":"打小算盘","pinyin":"dǎ xiǎo suàn pán","abbr":"dxsp","explanation":"在小处精打细算，斤斤计较。","source":{"text":"有些会打小算盘的人，譬如一向是孝敬一百两的，如今只消一百块钱。","book":"清·李宝嘉《官场现形记》"},"example":{"text":"～，弄小智术，官僚主义，阿Q主义，实际上毫无用处。","book":"毛泽东《反对日本进攻的方针、办法和前途》"},"opposite":["全盘考虑"],"usage":"作宾语、定语；指只顾自己的利益"},{"id":20465,"word":"打开天窗说亮话","pinyin":"dǎ kāi tiān chuāng shuō liàng huà","abbr":"dktcslh","explanation":"比喻无须规避，公开说明。","source":{"text":"‘打开天窗说亮话’，还不是等姓贾的过来尽点心，只要晚生出把力，你们老爷还有什么不明白的。","book":"清·李宝嘉《官场现形记》第27回"},"example":{"text":"～，没有五千块钱是不行的。","book":"马彦祥《母亲的遗像》"},"similar":["实话实说","打开窗户说亮话"],"usage":"作宾语、分句；指实话实说不避讳"},{"id":20466,"word":"打开窗户说亮话","pinyin":"dǎ kāi chuāng hù shuō liàng huà","abbr":"dkchslh","explanation":"指直率而明白地讲出来。","source":{"text":"咱们打开窗户说亮话，只要他是个人才，咱们决不会亏待他。","book":"姚雪垠《李自成》第一卷第27章"},"similar":["打开天窗说亮话"],"usage":"作谓语、宾语、分句；指实话实说不避讳"},{"id":20467,"word":"打当面鼓","pinyin":"dǎ dāng miàn gǔ","abbr":"ddmg","explanation":"比喻有话当面说，不背后议论。","source":{"text":"你怎么想就怎么说，噼哩啪拉，把什么都摆出来，打当面鼓，不敲背后锣，我就是喜欢这样的同志。","book":"罗旋《南国峰烟》"},"example":{"text":"说话不能任何事情都～。"},"opposite":["敲背后锣"],"usage":"作谓语、定语；指有话当面说"},{"id":20468,"word":"打得火热","pinyin":"dǎ dé huǒ rè","abbr":"ddhr","explanation":"形容关系十分亲密。","source":{"text":"原来安道全新和建康府一个烟花娼妓唤做李巧奴时常往来 ,正是打得火热。","book":"明·施耐庵《水浒传》第六十四回"},"example":{"text":"吴二浪子现同按察司街南胡同里张家土娼，叫小银子的，～。","book":"清·刘鹗《老残游记》第十九回"},"similar":["打成一片"],"usage":"作谓语、状语；形容关系密切"},{"id":20469,"word":"打恭作揖","pinyin":"dǎ gōng zuò yī","abbr":"dgzy","explanation":"旧时礼节，弯身抱拳，上下摆动，表示恭敬。","source":{"text":"嗟乎！平居无事，只解打恭作揖，终日匡坐，同于泥塑。","book":"明·李贽《因记往事》"},"example":{"text":"宝玉见他这样，还认作是昨日中晌的事，那知晚间的这段公案，还～的。","book":"《红楼梦》第二七回"},"similar":["打躬作揖","打拱作揖"],"usage":"作谓语、定语、状语、宾语；用于交往"},{"id":20470,"word":"打情卖笑","pinyin":"dǎ qíng mài xiào","abbr":"dqmx","explanation":"打情骂俏，指男女调情。","source":{"text":"在地狱一般的宝和下处，充满着各种叫卖、喧嚣、女人诟骂、打情卖笑的声浪。","book":"曹禺《日出》第三幕"},"example":{"text":"他们整天都在～，不干正经事。"},"similar":["打情骂俏"],"usage":"作谓语、宾语；指男女调情"},{"id":20471,"word":"打情骂俏","pinyin":"dǎ qíng mà qiào","abbr":"dqmq","explanation":"情：风情；俏：俏皮、风趣。指男女调情。","source":{"text":"在那里采野花，结草卦，抱儿携女，打情骂俏。","book":"明·董说《西游补》第一回"},"example":{"text":"高兴起来，简直不分主仆，～的搅做一团。","book":"清·曾朴《孽海花》第三十五回"},"similar":["搔首弄姿","眉来眼去","嬉皮笑脸"],"opposite":["正颜厉色","一本正经"],"usage":"作谓语、宾语、定语；指男女调情"},{"id":20472,"word":"打情骂趣","pinyin":"dǎ qíng mà qù","abbr":"dqmq","explanation":"①打是情，骂是趣。犹言打是亲，骂是爱。②犹打情骂俏。","source":{"text":"驸马爷，打情骂趣，他肯骂你，是有口风了。","book":"明·杨珽《龙膏记·砥节》"},"example":{"text":"却有一群粉面倌人，杂沓前来，只道小去是移茶客人，周围打成栲栳圈儿，～，假笑佯嗔，要小云攀相好。","book":"《海上花列传》第十一回"},"similar":["打情骂俏"],"usage":"作谓语、宾语、定语；指男女调情"},{"id":20473,"word":"打成一片","pinyin":"dǎ chéng yī piàn","abbr":"dcyp","explanation":"原指形成一个整体。现多形容感情融洽，成为一体。","source":{"text":"老僧四十年方打成一片。","book":"宋·释普济《五灯会元》卷十五"},"example":{"text":"扬弃知识阶级的绅士身分，提高大众的鉴赏水准，这样～，平民化，大众化。","book":"朱自清《论通俗化》"},"similar":["浑然一体","水乳交融","抱成一团"],"opposite":["分道扬镳","各行其是","同床异梦"],"usage":"作谓语、宾语；多用于上级对下级"},{"id":20474,"word":"打成平手","pinyin":"dǎ chéng píng shǒu","abbr":"dcps","explanation":"比赛中打成平局，不分胜负。","example":{"text":"这场比赛我们～。"},"similar":["不分胜负","打成平局"],"usage":"作谓语、定语；指比赛中打成平局"},{"id":20475,"word":"打打闹闹","pinyin":"dǎ dǎ nào nào","abbr":"ddnn","explanation":"指喧嚷地争吵和打架或用语言和行动来开玩笑。","source":{"text":"另外人家的妇女就不受这种约束了，说说笑笑，打打闹闹，跟赶集上会一般。","book":"路遥《平凡的世界》第一卷第九章"},"example":{"text":"许逊、方方～，看到那边亭子里有几个小孩在打弹弓仗。","book":"王朔《动物凶猛》"},"opposite":["正经八板"],"usage":"作谓语、宾语、定语；用于口语"},{"id":20476,"word":"打抱不平","pinyin":"dǎ bào bù píng","abbr":"dbbp","explanation":"遇见不公平的事，挺身而出，帮助受欺负的一方。","source":{"text":"气的我只有替平儿打抱不平。","book":"清·曹雪芹《红楼梦》第四十五回"},"example":{"text":"扶正义，～，正是我们革命党我的本色。","book":"吴玉章《从甲午战争前后到辛亥革命前后的回忆》"},"similar":["仗义执言","见义勇为","扶弱抑强"],"opposite":["欺软怕硬","欺贫重富","见死不救"],"usage":"作谓语、定语；指为人出头","story":["大观园又聚会了，李纨负责组织贾宝玉、林黛玉、薛宝钗、王熙凤等姐妹在一起喝酒聊天。在酒席中，王熙凤诉说家难当难管，平儿帮不了什么忙。李纨则为平儿打抱不平，骂王熙凤酒后无德。众人纷纷大笑起来"]},{"id":20477,"word":"打拱作揖","pinyin":"dǎ gǒng zuò yī","abbr":"dgzy","explanation":"旧时礼节，弯身抱拳，上下摆动，表示恭敬。","source":{"text":"王乡绅下车，爷儿三个连忙打拱作揖，如同捧凤凰似的捧了进来，在上首第一位坐下。","book":"清·李宝嘉《官场现形记》第一回"},"example":{"text":"不能对人就～。"},"similar":["打躬作揖","打恭作揖"],"usage":"作谓语、宾语、定语；指谦恭的样子"},{"id":20478,"word":"打擂台","pinyin":"dǎ lèi tái","abbr":"dlt","explanation":"擂台：比武而专设的台子。参加摆擂台者的比武。比喻相互竞赛。","source":{"text":"那泰安山神州庙，有一等打擂台赌本事的，要与人厮打。","book":"元·高文秀《黑旋风》第一折"},"example":{"text":"这三个说要去～，我看他们相貌威风，必然有些本事。","book":"清·钱彩《说岳全传》第69回"},"usage":"作谓语、宾语；用于竞赛"},{"id":20479,"word":"打旋磨儿","pinyin":"dǎ xuán mò er","abbr":"dxme","explanation":"向人有所要求，没完没了地纠缠。","source":{"text":"雪蛾恐怕西门庆来家拔树寻根，归罪于己，在上房打旋磨儿，跪着月娘，教休题出和他嚷闹来。","book":"明·兰陵笑笑生《金瓶梅词话》第二十六回"},"example":{"text":"你那姑妈只会～，给我们琏二奶奶跪着借当头，我眼里就看不起他那样主子奶奶么。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["打旋磨子"],"usage":"作宾语、状语；指纠缠"},{"id":20480,"word":"打旋磨子","pinyin":"dǎ xuán mò zǐ","abbr":"dxmz","explanation":"转动磨子，反复不停。比喻向人有所要求献殷勤。","source":{"text":"你那姑妈只会打旋磨儿，给我们琏二奶奶跑着借当头。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["打旋磨儿"],"usage":"作宾语、状语；指纠缠"},{"id":20481,"word":"打桃射柳","pinyin":"dǎ táo shè liǔ","abbr":"dtsl","explanation":"打桃：打球，因球形似桃；射柳：用箭射柳枝。原是辽、金两朝常常举行的武艺比赛。后泛指玩耍游戏。","source":{"text":"也不爱耽花恋酒，也不爱打桃射柳。","book":"元·董解元《西厢记》第八折"}},{"id":20482,"word":"打死老虎","pinyin":"dǎ sǐ lǎo hǔ","abbr":"dslh","explanation":"比喻打击失势倒台的人。","source":{"text":"我以为‘打死老虎’者，装怯作勇，颇含滑稽，虽然不免有卑怯之嫌，却怯得令人可爱。","book":"鲁迅《坟·论“费厄泼赖”应该缓行》"},"example":{"text":"这样做还不是～。"},"similar":["打落水狗"],"opposite":["从井救人"],"usage":"作宾语、定语；指攻击失势的人"},{"id":20483,"word":"打死虎","pinyin":"dǎ sǐ hǔ","abbr":"dsh","explanation":"比喻抨击已失威势的人。"},{"id":20484,"word":"打滚撒泼","pinyin":"dǎ gǔn sā pō","abbr":"dgsp","explanation":"躺倒在地上打滚，嘴里骂着泼辣的话。同“撒泼打滚”。","source":{"text":"芳官捱了两下打，那里肯依？便打滚撒泼的哭闹起来。","book":"清·曹雪芹《红楼梦》第六十回"},"example":{"text":"当孩子由于要求没有得到满足而发脾气或～时，大人不要去理睬他。"},"usage":"作谓语、状语；用于撒泼"},{"id":20485,"word":"打牙打令","pinyin":"dǎ yá dǎ lìng","abbr":"dydl","explanation":"打牙：说闲话；打令：指唱小曲。指说唱调笑。","source":{"text":"怎禁当衙门外打牙打令诨，匹似闲掂哨。","book":"元·董解元《西厢记》第四折"}},{"id":20486,"word":"打牙撂嘴","pinyin":"dǎ yá liào zuǐ","abbr":"dylz","explanation":"打牙：说闲话。指说闲话，相互嘲弄戏骂。","source":{"text":"这里他女人陪着这些丫鬟小厮吃酒，又和那小厮们打牙撂嘴儿的玩笑。","book":"清·曹雪芹《红楼梦》第65回"},"similar":["打牙犯嘴"],"usage":"作谓语、定语、宾语；比喻乱开玩笑"},{"id":20487,"word":"打牙犯嘴","pinyin":"dǎ yá fàn zuǐ","abbr":"dyfz","explanation":"比喻乱开玩笑。","source":{"text":"越发在人前花哨起来，常和众人打牙配嘴，全无忌惮。","book":"明·兰陵笑笑生《金瓶梅词话》第二十五回"},"similar":["打牙撂嘴"],"usage":"作谓语、宾语；比喻乱开玩笑"},{"id":20488,"word":"打牙配嘴","pinyin":"dǎ yá pèi zuǐ","abbr":"dypz","explanation":"指相互戏虐，闲扯说笑。","source":{"text":"（这妇人）常和从人打牙配嘴，全无忌惮。","book":"明·兰陵笑笑生《金瓶梅词话》第二十三回"},"similar":["打牙撂嘴"],"usage":"作谓语、定语；用于口语"},{"id":20489,"word":"打狗欺主","pinyin":"dǎ gǒu qī zhǔ","abbr":"dgqz","explanation":"打狗也就是打击或欺侮其主人，打击或欺侮人。","example":{"text":"谁都知道～这个道理。"},"opposite":["打狗看主"],"usage":"作宾语、定语；指打击或欺侮人"},{"id":20490,"word":"打狗看主","pinyin":"dǎ gǒu kàn zhǔ","abbr":"dgkz","explanation":"狗有主人，打不打它，要看给其主人留不留情面。比喻处理坏人下事要顾全其后台的情面。","source":{"text":"不知原来家中大小姐这等暴躁性子，就是打狗也看主人面。","book":"明·兰陵笑笑生《金瓶梅词话》第七十九回"},"example":{"text":"你怎的这般缠不清！自古道：～。","book":"清·俞万春《荡寇志》第一○一回"},"similar":["投鼠忌器"],"opposite":["打狗欺主"],"usage":"作宾语、定语；用于处事"},{"id":20491,"word":"打瓮墩盆","pinyin":"dǎ wòng dūn pén","abbr":"dwdp","explanation":"指摔家具，发脾气。","source":{"text":"好说话将孩儿放了，只当不的他打瓮墩盆乔样势。","book":"元·无名氏《争报恩》第四折"}},{"id":20492,"word":"打着灯笼没处寻","pinyin":"dǎ zhe dēng lóng méi chù xún","abbr":"dzdlmcx","explanation":"比喻很难得，不容易得到。","source":{"text":"要错过了，打着灯笼没处寻！","book":"清·曹雪芹《红楼梦》第65回"},"similar":["打着灯笼没处找"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":20493,"word":"打着灯笼没处找","pinyin":"dǎ zhe dēng lóng méi chù zhǎo","abbr":"dzdlmcz","explanation":"形容人或事物非常稀少，不容易找得到。","source":{"text":"你再要找我妹妹这么一个人儿，只怕你走遍天下打着灯笼也没处找去。","book":"清·文康《儿女英雄传》第九回"},"similar":["打着灯笼没处寻"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":20494,"word":"打破常规","pinyin":"dǎ pò cháng guī","abbr":"dpcg","explanation":"常规：沿袭下来的规矩。打破了一般的规矩或一向实行的规章制度。","source":{"text":"甚至连船正停泊在港口、尊严而又自信的十几个老船长也打破常规，开了一条小艇，集体下海去了。","book":"柯岩《汉堡港的变奏》"},"example":{"text":"他此举就是想～去实现他的梦想。"},"similar":["打破陈规"],"opposite":["墨守成规"],"usage":"作谓语；指改变常规做法"},{"id":20495,"word":"打破沙锅璺到底","pinyin":"dǎ pò shā guō wèn dào dǐ","abbr":"dpsgwdd","explanation":"璺：指陶瓷或玉石等器皿上的裂纹。比喻追根究底。","source":{"text":"葛藤接断老婆禅，打破沙锅璺到底。","book":"元·吴昌龄《东坡梦》第四折"},"example":{"text":"就让姐姐装糊涂不言语，我可也‘～’。","book":"清·文康《儿女英雄传》第26回"},"similar":["打破砂锅璺到底"],"usage":"作谓语、定语、分句；指一定要把事情弄清"},{"id":20496,"word":"打破沙锅问到底","pinyin":"dǎ pò shā guō wèn dào dǐ","abbr":"dpsgwdd","explanation":"比喻追究事情的根底。","source":{"text":"觅巧了不可得，拙从何来？打破沙盆一问，狂子因此眼开，弄巧成拙，为蛇画足，何况头上安头，屋下安屋，毕竟巧者有余，拙者不足。","book":"宋·黄庭坚《拙轩颂》"},"example":{"text":"她为什么不回到文工团去？不过我也并非喜欢～。","book":"巴金《团圆》"},"similar":["打破沙锅璺到底"],"opposite":["一知半解","浅尝辄止"],"usage":"作谓语、定语、分句；指一定要把事情弄清"},{"id":20497,"word":"打破疑团","pinyin":"dǎ pò yí tuán","abbr":"dpyt","explanation":"消除心中的疑虑。多形容人与人之间重新获得谅解。"},{"id":20498,"word":"打破砂锅","pinyin":"dǎ pò shā guō","abbr":"dpsg","explanation":"比喻追根究底。","source":{"text":"你直待要打破砂锅，是你招灾揽祸。","book":"明·高明《琵琶记·几言谏父》"},"similar":["打破砂锅问到底"],"usage":"作谓语、宾语；用于探究"},{"id":20499,"word":"打破砂锅璺到底","pinyin":"dǎ pò shā guō wèn dào dǐ","abbr":"dpsgwdd","explanation":"璺：指陶瓷或玉石等器皿上的裂纹。比喻追根究底。","source":{"text":"端的是谁打了来？打破砂锅璺到底，俺娘将着一分充饥饭，俺爷抱着一套御寒衣，他两口儿都来到这里。","book":"元·王实甫《破窑记》第二折"},"similar":["打破沙锅璺到底"],"usage":"作谓语、定语、分句；指一定要把事情弄清"},{"id":20500,"word":"打破砂锅问到底","pinyin":"dǎ pò shā guō wèn dào dǐ","abbr":"dpsgwdd","explanation":"比喻追究事情的根底。","source":{"text":"见“打破沙锅问到底”。"},"example":{"text":"我们必须绞脑筋，～。","book":"陶行知《普及现代生活教育之路》"},"similar":["打破沙锅问到底"],"usage":"作谓语、定语、分句；指一定要把事情弄清"},{"id":20501,"word":"打破迷关","pinyin":"dǎ pò mí guān","abbr":"dpmg","explanation":"指打掉思想上的迷惘。","source":{"text":"既然打破迷关，若不及早回头，定然皇天不佑。","book":"清·文康《儿女英雄传》第二十一回"},"example":{"text":"你相公入情魔了，一时也化解不开，须到开封府告去，方能～。","book":"清·石玉昆《三侠五义》第三十八回"},"usage":"作谓语、宾语；用于思想等"},{"id":20502,"word":"打破陈规","pinyin":"dǎ pò chén guī","abbr":"dpcg","explanation":"打破：突破；陈规：陈旧的规章制度。打破了一般的规矩或一向实行的规章制度。","source":{"text":"我们一定要打破陈规，披荆斩棘，开拓我国科学发展的道路。","book":"郭沫若《科学的春天》"},"similar":["打破常规"],"usage":"作谓语、宾语；指改变常规做法"},{"id":20503,"word":"打破饭碗","pinyin":"dǎ pò fàn wǎn","abbr":"dpfw","explanation":"比喻失业，无以为生。","source":{"text":"不仅因入党问题而打破饭碗，断绝生路，往往因“异党分子”问题而被绑入狱，断送生命。","book":"邹韬奋《患难余生记》第二章"},"usage":"作谓语、宾语；指失业"},{"id":20504,"word":"打秋风","pinyin":"dǎ qiū fēng","abbr":"dqf","explanation":"指假借各种名义向人家索取财物，或依仗与权势有某种关系，招摇撞骗，收受贿赂。","source":{"text":"当今北面官人，入则内贵，出则使臣，到所在打风打雨，你何不从之？","book":"五代·王定保《唐摭言·贤仆夫》"},"example":{"text":"你说～不好，茂陵刘郎秋风客，到后来做了皇帝。","book":"明·汤显祖《牡丹亭·诀谒》"}},{"id":20505,"word":"打翻身仗","pinyin":"dǎ fān shēn zhàng","abbr":"dfsz","explanation":"通过行动摆脱困境或不利局面。","example":{"text":"我们去年的生产～了。"},"similar":["转败为胜"],"opposite":["一败涂地"],"usage":"作谓语、宾语；指摆脱困境"},{"id":20506,"word":"打肿脸充胖子","pinyin":"dǎ zhǒng liǎn chōng pàng zī","abbr":"dzlcpz","explanation":"比喻宁可付出代价而硬充作了不起。","source":{"text":"你也不要在我老张面前打肿脸装胖子，硬不要朋友帮助。","book":"姚雪垠《李自成》第一卷第18章"},"example":{"text":"他就是喜欢～。"},"similar":["打肿脸装胖子"],"usage":"作谓语、定语、宾语；指硬撑"},{"id":20507,"word":"打肿脸装胖子","pinyin":"dǎ zhǒng liǎn zhuāng pàng zǐ","abbr":"dzlzpz","explanation":"比喻没有能耐或内里空虚，却要硬撑门面装作了不起。","source":{"text":"你也不要在我老张面前打肿脸装胖子，硬不要朋友帮助。","book":"姚雪垠《李自成》第一卷第18章"},"similar":["打肿脸充胖子"],"usage":"作谓语、定语、宾语；指硬撑"},{"id":20508,"word":"打草惊蛇","pinyin":"dǎ cǎo jīng shé","abbr":"dcjs","explanation":"打草惊了草里的蛇。原比喻惩罚了甲而使乙有所警觉。后多比喻做法不谨慎，反使对方有所戒备。","source":{"text":"王鲁为当涂宰，颇以资产为务，会部民连状诉主簿贪贿于县尹。鲁乃判曰：‘汝虽打草，吾已惊蛇。’","book":"宋·郑文宝《南唐近事》"},"example":{"text":"空自去“～”，倒吃他做了手脚，却是不好。","book":"明·施耐庵《水浒全传》第二十九回"},"similar":["操之过急","因小失大"],"opposite":["欲擒故纵","引蛇出洞"],"usage":"作谓语、定语、宾语；多用于否定句","story":["南唐时当涂县令王鲁，爱财如命，贪赃枉法，手下纷纷效仿他敲诈民脂民膏。一天，百姓联名写一份状子控告县衙主簿营私舞弊，贪赃受贿，王鲁担心事情闹大，就压下案子，在状子上写道：“汝虽打草，吾已惊蛇。”"]},{"id":20509,"word":"打草蛇惊","pinyin":"dǎ cǎo shé jīng","abbr":"dcsj","explanation":"打草惊了草里的蛇。原比喻惩罚了甲而使乙有所警觉。后多比喻做法不谨慎，反使对方有所戒备。同“打草惊蛇”。","source":{"text":"问：‘四众围观，师说何法？’师曰：‘打草蛇惊’","book":"《景德传灯录·省念禅师》"},"example":{"text":"但恐见黄商伯狼狈后，～，亦不敢放手做事耳。","book":"宋·朱熹《答黄仁卿书》"},"similar":["打草惊蛇"],"usage":"作谓语、定语、宾语；多用于否定句"},{"id":20510,"word":"打落水狗","pinyin":"dǎ luò shuǐ gǒu","abbr":"dlsg","explanation":"比喻继续打击已经失败的坏人。","source":{"text":"鲁迅的著名的‘打落水狗’真正是反自由主义，反妥协主义的宣言。","book":"瞿秋白《序言》"},"example":{"text":"我们要痛～。"},"similar":["打死老虎"],"opposite":["纵虎归山"],"usage":"作谓语、宾语；指继续打击已经失败的坏人"},{"id":20511,"word":"打落牙齿和血吞","pinyin":"dǎ luò yá chǐ huò xiě tūn","abbr":"dlychxt","explanation":"和：混合，拌。牙齿被人打掉，和着血一块吞下肚去。比喻吃了亏不让别人知道。也比喻失败了还要坚持做好汉。","source":{"text":"为了团结，为了大敌当前，顾全抗战，只好打落牙齿和血吞。","book":"郭沫若《洪波曲》第九章"},"similar":["打肿脸充胖子"],"usage":"作宾语、定语；用于处事"},{"id":20512,"word":"打虎牢龙","pinyin":"dǎ hǔ láo lóng","abbr":"dhll","explanation":"犹言打凤牢龙。比喻安排圈套使强有力的对手中计。"},{"id":20513,"word":"打蛇打七寸","pinyin":"dǎ shé dǎ qī cùn","abbr":"dsdqc","explanation":"比喻说话做事必须抓住主要环节。","source":{"text":"蛇有七寸，在头之下，腹之上，觑得清，击得重，制其要害之处，得之矣。","book":"清·王有光《吴下谚联·打蛇打在七寸》"},"example":{"text":"但做事也要“～”才妙，你先生请上裁。","book":"清·吴敬梓《儒林外史》第十四回"},"similar":["擒贼先擒王"],"usage":"作宾语、定语、分句；比喻说话做事抓主要"},{"id":20514,"word":"打街骂巷","pinyin":"dǎ jiē mà xiàng","abbr":"djmx","explanation":"街、巷：指邻里街坊。形容寻衅闹事，耍无赖。","source":{"text":"这刘大平日吃酒赌钱，打街骂巷，原是不安本分的人。","book":"清·夏敬渠《野叟曝言》第六回"},"example":{"text":"他～为的是想让人怕他。"},"usage":"作谓语、宾语；指漫骂"},{"id":20515,"word":"打诨插科","pinyin":"dǎ hùn chā kē","abbr":"dhck","explanation":"科：古曲戏曲中的表情动作。穿插在戏曲表演中的能使观众发笑的表演与道白。亦泛指引人发笑的动作与言谈。","source":{"text":"小丑丁秀容打诨插科，令人绝倒。","book":"清·李斗《扬州画舫录·新城北录下》"},"example":{"text":"在聊天室里形形色色的人～地聊着网话。"},"similar":["插科打诨","撒科打诨"],"usage":"作谓语、宾语；泛指引人发笑的动作与言谈"},{"id":20516,"word":"打谩评跋","pinyin":"dǎ màn píng bá","abbr":"dmpb","explanation":"谩：谩骂；跋：专横。指打骂催迫。","source":{"text":"告哥哥休打谩评跋，权等待些儿个。","book":"元·无名氏《争报恩》第三折"}},{"id":20517,"word":"打躬作揖","pinyin":"dǎ gōng zuō yī","abbr":"dgzy","explanation":"拱、揖：两手合抱致敬。弯身报拳行礼。表示恭敬顺从或恳求的样子。","source":{"text":"嗟乎！平居无事，只解打恭作揖，终日匡坐，同于泥塑。","book":"明·李贽《因记往事》"},"example":{"text":"宝玉见他这样，还认作是昨日晌午的事，那知晚间的这件公案，还～的。","book":"清·曹雪芹《红楼梦》第二十七回"},"similar":["以礼待人","打拱作揖"],"opposite":["横行霸道"],"usage":"作谓语、定语、状语、宾语；用于交往"},{"id":20518,"word":"打边鼓","pinyin":"dǎ biān gǔ","abbr":"dbg","explanation":"指从旁鼓吹、协助。","source":{"text":"只因为那时诗坛寂寞，所以打打边鼓，凑些热闹。","book":"鲁迅《集外集·序言》"},"example":{"text":"他留下唐仲笙，本来想他会在旁边～，帮忙他劝说马慕韩，没料到马慕韩把唐仲笙抓过去，倒变成绊脚石了。","book":"周而复《上海的早晨》第四部一"},"similar":["旁敲侧击"],"opposite":["直言不讳"],"usage":"作谓语、宾语；指侧面行事"},{"id":20519,"word":"打退堂鼓","pinyin":"dǎ tuì táng gǔ","abbr":"dttg","explanation":"原指封建官吏退堂时打鼓。现在比喻跟人共同做事中途退缩。","source":{"text":"左右，打散堂鼓，将马来，回私宅去也。","book":"元·关汉卿《窦娥冤》第二折"},"example":{"text":"敲败兵锣，～。","book":"清·翟灏《通俗编》卷一"},"similar":["半途而废","畏缩不前","知难而退"],"opposite":["勇往直前"],"usage":"作宾语、定语；比喻遇到困难就中途退缩"},{"id":20520,"word":"打道回府","pinyin":"dǎ dào huí fǔ","abbr":"ddhf","explanation":"指回家。","example":{"text":"我们只好～了。"},"usage":"作谓语、宾语；指回家"},{"id":20521,"word":"打里打外","pinyin":"dǎ lǐ dǎ wài","abbr":"dldw","explanation":"比喻又要管家里的事，又要对付外面的事。","source":{"text":"娶了媳妇，就有了个打里打外的帮手。","book":"浩然《浮云》"},"usage":"作谓语、宾语、定语；指内外都应付"},{"id":20522,"word":"打野鸭子","pinyin":"dǎ yě yā zǐ","abbr":"dyyz","explanation":"捕捉野鸭子，借指业余时间干活挣钱。","source":{"text":"他上班时没精打采，下班就～。"},"example":{"text":"他上班时没精打采，下班就～"},"usage":"作宾语；用于口语"},{"id":20523,"word":"打铁趁热","pinyin":"dǎ tiě chèn rè","abbr":"dtcr","explanation":"比喻做事要抓紧时机，加速进行。","source":{"text":"打铁趁热，放火趁风，你们不等这万人一心的功夫，调动他们还等待什么！","book":"骆宾基《胶东的暴民》"},"example":{"text":"做什么事情都要～，不能坐失良机。"},"similar":["趁热打铁"],"opposite":["坐失良机"],"usage":"作谓语、分句；同“趁热打铁”"},{"id":20524,"word":"打闷葫芦","pinyin":"dǎ mèn hú lu","abbr":"dmhl","explanation":"闷葫芦：比喻难猜解而令人纳闷的话或事情。指猜测令人纳闷的话事事情。","source":{"text":"（仙姑》恐泄漏天要，便掩了卷册，笑向宝玉道：‘且随我去游玩奇景，何必在此打闷葫芦。’","book":"清·曹雪芹《红楼梦》第五回"},"usage":"作谓语；用于口语"},{"id":20525,"word":"打马虎眼","pinyin":"dǎ mǎ hu yǎn","abbr":"dmhy","explanation":"故意装糊涂蒙骗人。","source":{"text":"他这是打马虎眼，麻痹我们大伙儿，假充好人，想混过这一关去！","book":"老舍《华实春秋》"},"example":{"text":"你这是～，麻痹我们，想混过这一关去。"},"similar":["阳奉阴违"],"usage":"作谓语、宾语；指故意装糊涂蒙骗人"},{"id":20526,"word":"打鸡骂狗","pinyin":"dǎ jī mà gǒu","abbr":"djmg","explanation":"比喻旁敲侧击地漫骂，以发泄对某人的不满。","source":{"text":"你今天怎么尽闹脾气，连吃饭时候也是打鸡骂狗的。","book":"鲁迅《彷徨·肥皂》"},"example":{"text":"他成天～的。"},"similar":["指桑骂槐"],"usage":"作谓语、定语；同“指桑骂槐”"},{"id":20527,"word":"打鸭子上架","pinyin":"dǎ yā zi shàng jià","abbr":"dyzsj","explanation":"比喻强迫去做能力做不到的事。","example":{"text":"你这样做还不是～、强人所难吗？"},"similar":["强人所难","赶鸭子上架"],"usage":"作谓语、定语、宾语；指强迫"},{"id":20528,"word":"打鸭惊鸳","pinyin":"dǎ yā jīng yuān","abbr":"dyjy","explanation":"比喻打甲惊乙。也比喻株连无罪的人。","source":{"text":"我不是要害你性命也，则怕打鸭惊鸳，打草惊蛇。","book":"明·梅鼎祚《昆化奴》第二折"},"example":{"text":"明·梅鼎祚《昆化奴》第二折：“我不是要害你性命也，则怕打鸭惊鸳，打草惊蛇。”"},"similar":["打草惊蛇"],"usage":"作谓语、定语；比喻打甲惊乙"},{"id":20529,"word":"打鸭惊鸳鸯","pinyin":"dǎ yā jīng yuān yāng","abbr":"dyjyy","explanation":"比喻打甲惊乙。也比喻株连无罪的人。","source":{"text":"莫打鸭，打鸭惊鸳鸯。","book":"宋·梅尧臣《打鸭》诗"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第九卷：“～，分飞各异方。”"},"similar":["打草惊蛇"],"usage":"作定语、分句；比喻打甲惊乙"},{"id":20530,"word":"托之空言","pinyin":"tuō zhī kōng yán","abbr":"tzky","explanation":"指寄托所怀于文词议论。","source":{"text":"案：孔子之言见《春秋纬》，太史公引之以成说也。空言谓褒贬是非也。","book":"汉·赵岐《〈孟子〉题辞》：“仲尼有云：‘我欲托之空言，不如载之行事之深切著明也。’”按《史记·太史公自序》作“载之空言”。司马贞索隐"},"similar":["托于空言","托诸空言"],"usage":"作谓语、宾语；用于处事"},{"id":20531,"word":"托于空言","pinyin":"tuō yú kōng yán","abbr":"tyky","explanation":"指寄托所怀于文词议论。同“托之空言”。","source":{"text":"道之不行，托于空言，显显赵公，则既有闻。","book":"元·黄溍《格庵先生赵公阡表》"},"similar":["托之空言","托诸空言"],"usage":"作谓语、宾语；用于处事"},{"id":20532,"word":"托公报私","pinyin":"tuō gōng bào sī","abbr":"tgbs","explanation":"借公事报私怨。","source":{"text":"方进终不举白，专作威福，阿党所厚，排挤英俊，托公报私，横厉无所畏忌。","book":"东汉·班固《汉书·杜周传》"},"similar":["官报私仇","公报私仇"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":20533,"word":"托公行私","pinyin":"tuō gōng xíng sī","abbr":"tgxs","explanation":"犹言假公济私。假借公家的名义，谋取私人的利益。","source":{"text":"而乃冯附城社，蔽亏日月，托公行私，交游群小。","book":"唐·刘肃《大唐新语·极谏》"},"similar":["假公济私"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":20534,"word":"托凤攀龙","pinyin":"tuō fèng pān lóng","abbr":"tfpl","explanation":"犹言攀龙附凤。比喻依附帝王、权贵。","source":{"text":"宗计于朝，或异或同，敌以乘衅，家破人亡。乖道反德，托凤攀龙。","book":"晋·陈寿《三国志·蜀志·扬戏传》"},"similar":["攀龙附凤"],"usage":"作谓语、宾语、定语；指巴结别人"},{"id":20535,"word":"托妻寄子","pinyin":"tuō qī jì zǐ","abbr":"tqjz","explanation":"托：请托。将妻子儿女送到别人家寄养。","source":{"text":"必是闻得老夫虚名，欲待托妻寄子。","book":"明·凌濛初《初刻拍案惊奇》第20卷"},"usage":"作谓语、宾语、定语；指为生活所迫"},{"id":20536,"word":"托孤寄命","pinyin":"tuō gū jì mìng","abbr":"tgjm","explanation":"寄命：以重要事宜相委托。临终前，将孤儿及重要事情相托。","source":{"text":"故逆知其可以托孤寄命，韩魏公之凝立，亦此类也。","book":"宋·罗大经《鹤林玉露补遗》卷七"},"example":{"text":"清·魏源《默觚·学篇》：“日僤养马而严威，可以～矣。”"},"usage":"作谓语、宾语、定语；用于临终时"},{"id":20537,"word":"托物喻志","pinyin":"tuō wù yù zhì","abbr":"twyz","explanation":"借事物以寄托自己远大的志向。"},{"id":20538,"word":"托物寓兴","pinyin":"tuō wù yù xìng","abbr":"twyx","explanation":"借事物以寄托任教的情兴。","source":{"text":"善画墨竹，知名于时。凡于翰墨之间物寓兴，则见于水墨之戏。","book":"宋·赵佶《宣和画谱·墨竹》"},"similar":["托物寓感"],"usage":"作谓语、定语；用于写作等"},{"id":20539,"word":"托物寓感","pinyin":"tuō wù yù gǎn","abbr":"twyg","explanation":"假借外物寄托情感。","source":{"text":"夫奉亲致养者，孝子之折分；托物寓感者，仁人之至情。","book":"明·王炜《慈竹堂记》"},"similar":["托物寓兴"],"usage":"作谓语、定语；用于写作等"},{"id":20540,"word":"托物引类","pinyin":"tuō wù yǐn lèi","abbr":"twyl","explanation":"指援引类似的事物寄托己意。","source":{"text":"《古风》二首，托物引类，真得古诗人之风，而轼非其人也。","book":"宋·苏轼《答黄鲁直书》"},"similar":["托物连类"],"usage":"作谓语、定语；用于书面语"},{"id":20541,"word":"托物感怀","pinyin":"tuō wù gǎn huái","abbr":"twgh","explanation":"假借事物抒发胸怀。","source":{"text":"故能托物感怀，缠绵凄恻，若使饥寒切肤，亦未暇尔尔。","book":"清·汪琬《说铃》"},"usage":"作谓语、宾语；用于处事"},{"id":20542,"word":"托物连类","pinyin":"tuō wù lián lèi","abbr":"twll","explanation":"指援引类似的事物寄托己意。见“托物引类”。","source":{"text":"诗之为用，共托物连类，足以寓人不能宣之意。","book":"明·王炜《书胡立三先生诗稿后》"},"similar":["托物引类"],"usage":"作谓语、定语；用于书面语"},{"id":20543,"word":"托物陈喻","pinyin":"tuō wù chén yù","abbr":"twcy","explanation":"借事物设喻。","source":{"text":"古人凡欲讽谏，多借以喻彼，臣不得于君，多借妻以思其夫，或托物陈喻，以通其意。","book":"元·杨载《诗法家教·讽谏》"},"usage":"作谓语、宾语；用于写作与说话等"},{"id":20544,"word":"托诸空言","pinyin":"tuō zhū kōng yán","abbr":"tzky","explanation":"指寄托所怀于文词议论。同“托之空言”。","source":{"text":"若方将试吏事，则由是以求之民物之情，利病之实，不徒托诸空言也。","book":"清·朱珪《序》"},"similar":["托之空言","托于空言"],"usage":"作谓语、宾语；用于处事"},{"id":20545,"word":"托足无门","pinyin":"tuō zú wu mén","abbr":"tzwm","explanation":"托足：落脚。指没有落脚安身之处。","source":{"text":"其胸中又有勃然不可磨灭之气，英雄失路托足无门之悲。","book":"明·袁宏道《徐文长传》"},"usage":"作谓语、定语；用于人的处境等"},{"id":20546,"word":"托钵沿门","pinyin":"tuō bō yán mén","abbr":"tbym","explanation":"钵：和尚吃东西用的器具。原指僧徒化缘。比喻挨家乞讨。","source":{"text":"故读者于此等处最要分别，不然则视少陵为随地蓦缘，沿门托钵者流矣。","book":"清·无名氏《杜诗言志》卷一"},"example":{"text":"藏身闹市安天命，～拙己谋。","book":"南怀瑾《纪感二首》其二"},"similar":["沿门托钵","沿门持钵"],"usage":"作谓语、定语；指乞讨"},{"id":20547,"word":"托骥之蝇","pinyin":"tuō jì zhī yíng","abbr":"tjzy","explanation":"《后汉书·隗器传》：“帝报以手书曰：‘慕乐德义，思相结纳……数蒙伯乐一顾之价，而苍蝇之飞，不过数步，即托骥尾，得以绝群。’”李贤注：“张敞书曰：‘苍蝇之飞，不过十步，自托骐骥之尾，乃腾千里之路。然无损于骐骥，得使苍蝇绝群也，’见敞传。”","source":{"text":"譬为山，方覆一篑而进，俄哲人梦奠两楹之间，欲为～，遂作丧家之犬。 ★元·许衡《上宪使刘约斋启》"},"example":{"text":"元·许衡《上宪使刘约斋启》：“譬为山，方履一篑而进，俄哲人梦奠两楹之间，欲为～，遂作丧家之犬。”"},"usage":"作宾语；多用于比喻句"},{"id":20548,"word":"扛大梁","pinyin":"káng dà liáng","abbr":"kdl","explanation":"比喻承担重任。","source":{"text":"我们俩岁数大了，须得找个年富力强的人来扛大梁。","book":"航鹰《开市大吉》"},"similar":["挑大梁"],"usage":"作谓语、定语；用于口语"},{"id":20549,"word":"扛鼎抃牛","pinyin":"káng dǐng biàn niú","abbr":"gdbn","explanation":"扛鼎：把鼎举起来。抃牛：把两头相斗的牛位开。能把鼎举起来，能把相斗的两头牛拉开。形容勇武有力，超越常人。","source":{"text":"秦悼武、乌获、任鄙，扛鼎抃牛，非绝力也？","book":"《史记·项羽本纪》：“籍（项羽）长八尺余，力能扛鼎。” 汉·杨雄《法言·渊骞》"},"example":{"text":"汉·扬雄《法言·渊骞》：“秦悼武、乌获、任鄙，～，非绝力也？”"},"usage":"作宾语、定语；用于书面语"},{"id":20550,"word":"扛鼎拔山","pinyin":"gāng dǐng bá shān","abbr":"gdbs","explanation":"扛：双手举起。拔起大山，举起重鼎。形容力气很大。","source":{"text":"于是项王乃悲歌慷慨，自为诗曰：‘力拔山兮气盖世，时不利兮骓不逝。’","book":"《史记·项羽本纪》：“力能扛鼎，才气过人。”又"},"example":{"text":"有～之勇，经文纬武之才。 ◎明·冯梦龙《东周列国志》第七十二回"}},{"id":20551,"word":"扞格不入","pinyin":"hàn gé bù rù","abbr":"hgbr","explanation":"扞：绝；格：坚硬；扞格：相互抵触，格格不入。过于坚硬而难于深入。形容彼此意见完全不合。","source":{"text":"扞：坚不可入之貌。","book":"《礼记·学记》：“发然后禁，则扞格而不胜。”郑玄注"},"similar":["格格不入"],"usage":"作谓语、定语；指不投合"},{"id":20552,"word":"扞格不通","pinyin":"hàn gé bù tōng","abbr":"ggbt","explanation":"固执成见，不能变通。","source":{"text":"扞：坚不可入之貌。","book":"《礼记·学记》：“发然后禁，则扞格而不胜。”郑玄注"},"example":{"text":"其余十八行省，那一处不是执迷不化，～呢？","book":"清·李宝嘉《文明小史》第一回"},"similar":["扞格不入","执迷不悟"],"usage":"作谓语、定语、宾语；用于为人"},{"id":20553,"word":"扣人心弦","pinyin":"kòu rén xīn xián","abbr":"krxx","explanation":"扣：敲打。形容事物激动人心。","source":{"text":"据说这人最不爱讲话，但那天的几句话，却是那样扣人心弦，感动得自己当时流下了眼泪。","book":"魏巍《东方》第二部第七章"},"example":{"text":"那种景象多么～！","book":"秦牧《花城·古董》"},"similar":["沁人心脾","动人心弦"],"opposite":["无动于衷","微乎其微"],"usage":"作谓语、宾语、定语；指吸引人"},{"id":20554,"word":"扣壶长吟","pinyin":"kòu hú cháng yín","abbr":"khcy","explanation":"借指抒发壮怀或不平之气。","source":{"text":"扣壶长吟心未厌，惜哉狂竖徒骄盈。","book":"清·唐孙华《题薪禅弟》诗"},"similar":["怀才不遇"],"usage":"作主语、定语；指怀才不遇","story":["晋朝才子王敦怀才不遇，不得志时经常在酒后吟曹操“老骥伏枥，志在千里，烈士暮年，壮心不已”的诗句，边吟边用铁如意敲唾壶，以此来抒发自己的不平心情，时间一长唾壶全都缺了边"]},{"id":20555,"word":"扣小小鸣，扣大大鸣","pinyin":"kòu xiǎo xiǎo míng，kòu dà dà míng","abbr":"kxxmkddm","explanation":"敲小钟小的响，敲大钟大的响。形容回答及时准确。","source":{"text":"善待问者如撞钟，叩之以小者，则小鸣；叩之以大者，则大鸣。待其从容，然后尽其声。不善答问者反此。","book":"《礼记·学记》"}},{"id":20556,"word":"扣屎盔子","pinyin":"kòu shǐ kuī zǐ","abbr":"kskz","explanation":"比喻给人妄加罪名，进行诬蔑。","example":{"text":"老工人战青山听他当面往严志宏头上～，一股火腾地蹿到脸上。"},"similar":["乱扣帽子","扣屎盆子"],"usage":"作谓语、宾语；指诬蔑人"},{"id":20557,"word":"扣帽子","pinyin":"kòu mào zǐ","abbr":"kmz","explanation":"把不好的名目硬加在人头上。","source":{"text":"他瞪着眼给我扣帽子，说我闹温情。","book":"郭光《仅仅是开始》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":20558,"word":"扣心泣血","pinyin":"kòu xīn qì xuè","abbr":"kxqx","explanation":"扣：敲打。形容极其悲愤痛心。","source":{"text":"孤以不德，天降之灾，枕戈饮胆，扣心泣血。","book":"《梁书·元帝纪》"},"usage":"作谓语；用于十分痛心场合"},{"id":20559,"word":"扣楫中流","pinyin":"kòu jí zhōng liú","abbr":"kjzl","explanation":"犹中流击楫。比喻立志奋发图强。"},{"id":20560,"word":"扣槃扪烛","pinyin":"kòu pán mén zhú","abbr":"kpmz","explanation":"扣：敲；扪：摸。比喻认识片面，未得要领。","source":{"text":"生而眇者不识日，问之有目者。或告之曰：‘日之状如铜槃。’扣槃而得其声。他日闻钟，以为日也。或告之曰：‘日之光如烛。’扪烛而得其形。他日揣籥，以为日也。","book":"宋·苏轼《日喻》"},"similar":["扣槃扪籥"],"usage":"作谓语、定语；比喻认识片面，未得要领","story":["古时一个天生是瞎子的人问别人太阳是什么样的，人家告诉他太阳像铜盘，瞎子回家发现铜盘是可以敲响的，就把人家敲钟的声音误以为是太阳，周围的人笑着告诉他太阳是没有声音而像蜡烛一样有热量，他回家把蜡烛当成了太阳"]},{"id":20561,"word":"扣槃扪籥","pinyin":"kòu pán mén yuè","abbr":"kpmy","explanation":"比喻认识片面，未得要领。同“扣槃扪烛”。","source":{"text":"生而眇者不识日，问之有目者。或告之曰：‘日之状如铜槃。’扣槃而得其声。他日闻钟，以为日也。或告之曰：‘日之光如烛。’扪烛而得其形。","book":"宋·苏轼《日喻》"},"example":{"text":"都是～之谈，招摇撞骗之技。","book":"俞平伯《诗的神秘》"},"similar":["扣槃扪烛"],"usage":"作谓语、定语；比喻认识片面，未得要领","story":["古时一个天生瞎子问人太阳是什么样的，人家说太阳像铜盘，瞎子回家发现铜盘是可以敲响的，就把敲钟的声音误以为是太阳，人家告诉他太阳不发声而像蜡烛一样有热量，他回家把蜡烛当成了太阳。一天他发现乐器籥跟蜡烛很像，也以为是太阳"]},{"id":20562,"word":"扣盘扪烛","pinyin":"kòu pán mén zhú","abbr":"kpmz","explanation":"扣：敲；扪：摸。比喻不经实践，认识片面，难以得到真知。","source":{"text":"生而眇者不识日，问之有目者。或告之曰：‘日之状如铜盘。’扣盘而得其声。他日闻钟，以为日也。或告之曰：‘日之光如烛。’扪烛而得其形。他日揣钥，以为日也。","book":"宋·苏轼《日喻》"}},{"id":20563,"word":"扣盘扪钥","pinyin":"kòu pán mén yào","abbr":"kpmy","explanation":"比喻不经实践，认识片面，难以得到真知。同“扣盘扪烛”。"},{"id":20564,"word":"执一无失","pinyin":"zhí yī wú shī","abbr":"zyws","explanation":"执一：专一；失：过失。非常专心，没有出现过失。","source":{"text":"执一无失，行微无怠，忠信无倦，而天下自来。","book":"《荀子·尧问》"}},{"id":20565,"word":"执一而论","pinyin":"zhí yī ér lùn","abbr":"zyel","explanation":"执：抓住；论：评论。抓住一点或一个方面进行评论。形容看问题片面。","source":{"text":"大凡治事需通观全局，不可执一而论。","book":"清·钱泳《履园丛话·水学·三江》"},"example":{"text":"好是好，坏是坏，不可～。（清·李宝嘉《官场现形记》第四十九回）"},"usage":"作谓语、宾语；用于处事"},{"id":20566,"word":"执两用中","pinyin":"zhí liǎng yòng zhōng","abbr":"zlyz","explanation":"指做事要根据不同情况，采取适宜的办法。","source":{"text":"执其两端，用其中于民，其斯以为舜乎？","book":"《礼记·中庸》"},"usage":"作谓语；指采取适宜的办法"},{"id":20567,"word":"执意不从","pinyin":"zhí yì bù cóng","abbr":"zybc","explanation":"执：坚持；意：意见；从：依从。坚持自己的意见，不肯依从别人的意见。","source":{"text":"你若执意不从，惹他性起，一时翻过脸来，骂一顿，打一顿，你待走上天去。","book":"明·冯梦龙《醒世恒言·卖油郎独占花魁》"},"example":{"text":"你们想明天就是交易的日期，劝他等一天，他一定不肯，再四相留，他～。","book":"清·吴趼人《二十年目睹之怪现状》第五回"},"similar":["执意不回"],"usage":"作谓语、定语；用于处事"},{"id":20568,"word":"执意不回","pinyin":"zhí yì bù huí","abbr":"zybh","explanation":"坚持自己的意见不肯依从别人","source":{"text":"安石性强忮，遇事无可否，自信所见，执意不回。","book":"《宋史·王安石传》"},"similar":["执意不从"],"usage":"作谓语、定语；用于处事"},{"id":20569,"word":"执文害意","pinyin":"zhí wén hài yì","abbr":"zwhy","explanation":"指拘泥于字面而损害内容。","source":{"text":"推考其故，盖提举盐事司执文害意，谓非贫乏不在此数。","book":"宋·苏轼《应诏论四事状》"},"example":{"text":"此皆～，信经废传之过也。","book":"宋·陈善《扪虱新话》卷二"},"usage":"作谓语、定语；用于书面语"},{"id":20570,"word":"执柯作伐","pinyin":"zhí kē zuò fá","abbr":"zkzf","explanation":"执：拿着；柯：斧头柄；伐：采伐。手执斧头去采伐。指给人做媒。","source":{"text":"伐柯如何？匪斧不克。取妻如何？匪媒不得。","book":"《诗经·豳风·伐柯》"},"example":{"text":"《诗经·豳风·伐柯》：“伐柯如何？匪斧不克。取妻如何？匪媒不得。”"},"usage":"作谓语；指为人做媒"},{"id":20571,"word":"执正持平","pinyin":"zhí zhèng chí píng","abbr":"zzcp","explanation":"执：执行；持：坚持。坚持公平合理，不偏不向。","source":{"text":"使人主执正持平，如从绳准高下，则群臣以邪来者，犹以卵投石，以火投水。","book":"《淮南子·主术训》"}},{"id":20572,"word":"执法不公","pinyin":"zhí fǎ bù gōng","abbr":"zfbg","explanation":"拒绝公正，在实施法律中的不公正。","example":{"text":"我们要坚决杜绝～的现象。"},"opposite":["执法如山"],"usage":"作谓语、定语、宾语；指偏袒一方"},{"id":20573,"word":"执法不阿","pinyin":"zhí fǎ bù ē","abbr":"zfba","explanation":"阿：迎合。执行法律公正无私，不屈从权势。","example":{"text":"他是一个～的好法官"},"similar":["执法如山","执法无私"],"opposite":["徇私枉法"],"usage":"作谓语、定语、宾语；指人公正"},{"id":20574,"word":"执法如山","pinyin":"zhí fǎ rú shān","abbr":"zfrs","explanation":"执行法律象山一样不可动摇。","source":{"text":"本道言出如箭，执法如山，三尺法不能为不肖者宥也。","book":"清·李绿园《歧路灯》第八十八回"},"example":{"text":"这位法官一贯秉公办案，～，不徇私情。"},"similar":["铁面无私","刚正不阿","令行禁止"],"opposite":["营私舞弊","宽宏大量","手下留情"],"usage":"作谓语、定语、宾语；指人公正"},{"id":20575,"word":"执法无私","pinyin":"zhí fǎ wú sī","abbr":"zfws","explanation":"执行法令非常坚定，毫不动摇","example":{"text":"社会需要～，但事实远非如此"},"similar":["执法如山","执法不阿"],"opposite":["徇私枉法"],"usage":"作谓语、定语、宾语；指人公正"},{"id":20576,"word":"执法犯法","pinyin":"zhí fǎ fàn fǎ","abbr":"zfff","explanation":"指执行法律的人违背法律。","example":{"text":"这年头～的事情时有发生。"},"similar":["知法犯法"],"usage":"作谓语、宾语、定语；指明知故犯"},{"id":20577,"word":"执牛耳","pinyin":"zhí niú ěr","abbr":"zne","explanation":"古代诸侯订立盟约，要割牛耳歃血，由主盟国的代表拿着盛牛耳朵的盘子。故称主盟国为执牛耳。后泛指在某一方面居最有权威的地位。","source":{"text":"诸侯盟，谁执牛耳？","book":"春秋·鲁·左丘明《左传·哀公十七年》"},"example":{"text":"太仓之～，海内无不受其牢笼。","book":"清·黄宗羲《姜山启彭山诗稿序》"},"usage":"作谓语、宾语、定语；指占优势"},{"id":20578,"word":"执箕帚","pinyin":"zhí jī zhǒu","abbr":"zjz","explanation":"执：拿。拿着簸箕和笤帚。指要打扫卫生。古时借指充当臣仆或妻子。","source":{"text":"若此而不可得也，内量万国不足以伤吴，外事之诸侯不能害之，则孤将弃国家，释群山，服剑臂刃，变容貌，易名姓，执箕帚而臣事之，以与吴王争一旦之死。","book":"《吕氏春秋·季秋纪》"},"example":{"text":"非世子不能保全妾家，愿献甄氏为世子～。（明·罗贯中《三国演义》第三十三回）"},"usage":"作谓语、定语；用于书面语"},{"id":20579,"word":"执粗井灶","pinyin":"zhí cū jǐng zào","abbr":"zcjz","explanation":"指操持家务。比喻为人妇。","source":{"text":"女笑曰：‘身既无托，愿执粗井灶。’王申即日赁衣贳礼为新妇。","book":"唐·段成式《酉阳杂俎续集·支诺皋中》"},"usage":"作谓语、定语；用于书面语"},{"id":20580,"word":"执经叩问","pinyin":"zhí jīng kòu wèn","abbr":"zjkw","explanation":"执：拿着；经：经书；叩问：询问。手拿经书，向他人请教。形容虚心向他人学习。","source":{"text":"又患无硕师名人与游，尝趋百里外，从乡之先达执经叩问。","book":"明·宋濂《送东阳马生序》"},"usage":"作谓语、定语；用于书面语"},{"id":20581,"word":"执经问难","pinyin":"zhí jīng wèn nán","abbr":"zjwn","explanation":"手捧经书，质疑问难。后多指弟子从师受业。","source":{"text":"飨射礼毕，帝正坐自讲，诸儒执经问难于前，冠带缙绅之人，圜桥门而观听者盖亿万计。","book":"《后汉书·儒林传序》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“作文曰染翰操觚；从师曰～。”"},"usage":"作谓语、定语；指求学"},{"id":20582,"word":"执而不化","pinyin":"zhí ér bù huà","abbr":"zebh","explanation":"指固执己见，不知变通。","source":{"text":"将执而不化，外合而内不訾，其庸讵可乎？","book":"《庄子·人世间》"},"example":{"text":"若是处处忘不了古人，便是守旧之见，～，那是一辈子做不出事业，不能自立的。","book":"《晚清文学丛钞·中国现在记》第三回"},"similar":["顽固不化"],"usage":"作谓语、定语；指人固执"},{"id":20583,"word":"执迷不反","pinyin":"zhí mí bù fǎn","abbr":"zmbf","explanation":"犹执迷不悟。同“执迷不返”。","source":{"text":"若执迷不反，拒逆王师，大军一临，刑兹罔赦。","book":"唐·姚思廉《梁书·元帝纪》"},"example":{"text":"彼若请封乞贡，宜令顺义为之代请，如其～，则宜姑置之度外，不必苦要之。","book":"明·张居正《答宣大巡抚吴环洲书》"},"similar":["执迷不返","执迷不悟","执迷不醒"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20584,"word":"执迷不悟","pinyin":"zhí mí bù wù","abbr":"zmbw","explanation":"唐·姚思廉《梁书·武帝纪》：“若执迷不悟，距逆王师，大军一临，刑兹罔郝，所谓火烈高原，芝兰同泯。”","source":{"text":"若执迷不悟，距逆王师，大军一临，刑兹罔郝，所谓火烈高原，芝兰同泯。","book":"唐·姚思廉《梁书·武帝纪》"},"example":{"text":"快叫田见秀跟众贼将前来投降，不要～，自走绝路！","book":"姚雪垠《李自成》第一卷第九章"},"similar":["顽固不化","一意孤行","屡教不改"],"opposite":["迷途知返","浪子回头","悬崖勒马"],"usage":"作谓语、定语；指坚持错误"},{"id":20585,"word":"执迷不误","pinyin":"zhí mí bù wù","abbr":"zmbw","explanation":"形容坚持而不觉悟。","example":{"text":"走错了路，就应赶紧回头，如果～，那是非常危险的。"}},{"id":20586,"word":"执迷不返","pinyin":"zhí mí bù fǎn","abbr":"zmbf","explanation":"亦作“执迷不反”。犹执迷不悟。","source":{"text":"若负固不悛，执迷不返，则命将遣师，剿平诸国。","book":"《秦并六国平话》卷上"},"example":{"text":"每思公之所以～者，其病在多欲。","book":"明·李贽《答耿司寇书》"},"similar":["执迷不反","执迷不悟","执迷不醒"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20587,"word":"执迷不醒","pinyin":"zhí mí bù xǐng","abbr":"zmbx","explanation":"犹执迷不悟。","source":{"text":"宝钗虽不言语，遇事试探，见他执迷不醒，只得暗中落泪。","book":"清·曹雪芹《红楼梦》第一一八回"},"example":{"text":"若再～，这四人就是前车之鉴。","book":"清·李汝珍《镜花缘》第九十八回"},"similar":["执迷不悟","执迷不返","执迷不反"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20588,"word":"执锐披坚","pinyin":"zhí ruì pī jiān","abbr":"zrpj","explanation":"执：拿着；锐：锐利，锋利，指兵器；坚：指铠甲，古代军人护身的战衣。身穿铠甲，手持武器。形容投身战斗或作好战斗准备。","source":{"text":"执锐披坚领大兵，排兵布阵任非轻，身怀举鼎拔山力，独占东吴数百城。","book":"明·无名氏《衣锦还乡》第一折"},"example":{"text":"～的敌人并不可怕"},"similar":["披坚执锐"],"usage":"作谓语、宾语、状语；指装备精良"},{"id":20589,"word":"执鞭坠蹬","pinyin":"zhí biān zhuì dèng","abbr":"zbzd","explanation":"手里拿着马鞭，跟在马镫旁边。比喻因敬仰而愿意追随在左右。","source":{"text":"富而可求也，虽执鞭之士，吾亦为之。","book":"《论语·述而》"}},{"id":20590,"word":"执鞭坠镫","pinyin":"zhí biān zhuì dèng","abbr":"zbzd","explanation":"亦作“执鞭随镫”。谓服侍别人乘骑，多表示倾心追随。","source":{"text":"若得与兄长执鞭坠镫，愿为一卒，报答救命之恩，实为万幸。","book":"明·施耐庵《水浒传》第六十七回"},"example":{"text":"明·吴承恩《西游记》第39回：“师父，你是我重生父母一般，莫说挑担，情愿～，伏侍老爷，同行上西天去也。”"},"similar":["执鞭随镫"],"usage":"作谓语、定语；表示倾心追随"},{"id":20591,"word":"执鞭随蹬","pinyin":"zhí biān suí dèng","abbr":"zbsd","explanation":"手里拿着马鞭，跟在马镫旁边。比喻因敬仰而愿意追随在左右。","source":{"text":"富而可求也，虽执鞭之士，吾亦为之。","book":"《论语·述而》"},"example":{"text":"愿将军不弃，收为步卒，早晚～，死亦甘心。","book":"明·罗贯中《三国演义》第二十八回"},"similar":["执鞭随镫"],"usage":"作谓语、宾语、定语；用于处事"},{"id":20592,"word":"执鞭随镫","pinyin":"zhí biān suí dèng","abbr":"zbsd","explanation":"比喻因敬仰而愿意追随左右。","source":{"text":"愿将军不弃，收为步卒，早晚执鞭随镫，死亦甘心。","book":"明·罗贯中《三国演义》第28回"},"example":{"text":"清·钱彩《说岳全传》第25回：“望爷爷收录，小人情愿～。”"},"similar":["执鞭坠镫","鞍前马后"],"usage":"作谓语；表示倾心追随"},{"id":20593,"word":"扩而充之","pinyin":"kuò ér chōng zhī","abbr":"kecz","explanation":"扩：扩展。扩大范围，充实内容。","source":{"text":"凡有四端于我者，知皆扩而充之矣。","book":"战国·邹·孟轲《孟子·公孙丑上》"},"example":{"text":"这句话原来是论妇女的，后来却～普遍应用起来。","book":"朱自清《论气节》"},"usage":"作谓语、定语；指扩充"},{"id":20594,"word":"扪参历井","pinyin":"mén shēn lì jǐng","abbr":"mslj","explanation":"参、井，皆星宿名，分别为蜀秦分野。指自秦入蜀途中，山势高峻，可以摸到参、井两星宿。形容山势高峻，道路险阻。亦形容世路艰难。","source":{"text":"邓温伯知成都谢上表云：‘扪参历井，敢辞蜀道之难；就日望云，愈觉长安之远。’自后凡官两川者，谢表相承用此一联。","book":"唐·李白《蜀道难》诗：“扪参历井仰胁息，以手抚膺坐长叹。”宋·王铚《王公四六话》"},"example":{"text":"挹斗扬箕误有名，～信浮生。","book":"清·钱谦益《剡城》诗之二"},"usage":"作宾语、定语；用于书面语"},{"id":20595,"word":"扪心无愧","pinyin":"mén xīn wú kuì","abbr":"mxwk","explanation":"扪：摸；愧：惭愧。摸着胸口自问，毫无惭愧之处。","source":{"text":"不忍曲作钩，乍能折为玉。扪心无愧畏，腾口有谤讟。","book":"唐·白居易《和梦游春诗一百韵》"},"example":{"text":"我对他的资助已经是～了。"},"similar":["问心无愧","光明磊落"],"opposite":["问心有愧"],"usage":"作谓语、定语；表示光明磊落"},{"id":20596,"word":"扪心清夜","pinyin":"mén xīn qīng yè","abbr":"mxqy","explanation":"扪：摸；清：寂静。指深夜不眠，进行自我反省。","source":{"text":"试问他：‘扪心清夜，衾影里，羞也么咦？’","book":"清·吴趼人《痛史》第21回"},"similar":["清夜扪心"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":20597,"word":"扪心自问","pinyin":"mén xīn zì wèn","abbr":"mxzw","explanation":"摸着胸口，自己问自己怎么样。指自己反省。","source":{"text":"扪心自问何功德，五管支离治繲人。","book":"宋·宋祁《学舍昼上》"},"example":{"text":"此则请公等～：上流社会人而应作此语耶？（清·梁启超《与上海某某等报馆主笔书》）"},"similar":["反躬自省"],"usage":"作谓语；用于劝人作自我反省"},{"id":20598,"word":"扪虱而言","pinyin":"mén shī ér yán","abbr":"msey","explanation":"扪：按；言：交谈。一面捺着虱子，一面交谈着。形容谈吐从容，无所畏忌。","source":{"text":"桓温入关，猛被褐而诣之，一面谈当世之事，扪虱而言，旁若无人。","book":"《晋书·王猛传》"},"example":{"text":"直入中军，一见桓温，便谈当世之务，～，旁若无人。","book":"明·杨尔增《两晋秘史》第二百二十一回"},"similar":["扪虱而谈"],"usage":"作谓语、定语；指谈吐从容","story":["十六国时期，东晋大将桓温率军攻打前秦国，驻兵霸上并不渡霸水去攻打长安，隐居华阴山的王猛穿一件破旧的粗麻衣去拜见桓温，与桓温谈论天下形势。王猛扪虱而言，旁若无人。他发现桓温并不真心，就去投奔前秦王苻坚"]},{"id":20599,"word":"扪虱而谈","pinyin":"mén shī ér tán","abbr":"mset","explanation":"扪：按。一面捺着虱子，一面谈着。形容谈吐从容，无所畏忌。","source":{"text":"桓温入关，猛被褐而诣之，一面谈当世之事，扪虱而言，旁若无人。","book":"《晋书·王猛传》"},"example":{"text":"～，当时竟传为美事。","book":"鲁迅《而已集·魏晋风度及文章与药及酒之关系》"},"similar":["扪虱而言"],"usage":"作谓语、定语；指谈吐从容","story":["十六国时期，东晋大将桓温率军攻打前秦国，驻兵霸上并不渡霸水去攻打长安，隐居华阴山的王猛穿一件破旧的粗麻衣去拜见桓温，与桓温谈论天下形势。王猛扪虱而言，旁若无人。他发现桓温并不真心，就去投奔前秦王苻坚"]},{"id":20600,"word":"扪隙发罅","pinyin":"mén xì fā xià","abbr":"mxfx","explanation":"扪：摸；隙、罅：裂缝。指寻找可乘之机以钻营。","source":{"text":"今夫人爵，人之求者，犹研精苦思，，扪隙发罅，以窥求门户，虽所学固不中节，然张巧射中之心不为不勤矣。","book":"宋·王令《答刘公著微之书》"},"usage":"作谓语、宾语；用于处事"},{"id":20601,"word":"扫兴而回","pinyin":"sǎo xìng ér huí","abbr":"sxeh","explanation":"扫兴：指情绪低落。指遇到不如意的事情而情绪低落。","source":{"text":"早是暮冬，不提防岭北风严，感了寒疾，又无扫兴而回之理。","book":"明·汤显祖《牡丹亭·旅寄》"},"example":{"text":"清·无垢道人《八仙全传》第18回：“白白地鸟乱了一阵，一个个～，回去见那活老虎销差。”"},"similar":["扫兴而归"],"usage":"作谓语、定语；指失望"},{"id":20602,"word":"扫地以尽","pinyin":"sǎo dì yǐ jìn","abbr":"sdyj","explanation":"比喻破坏得彻底。也比喻面子、威风丢失干净。","source":{"text":"秦灭六国，而上古遗烈扫地尽矣。","book":"《汉书·魏豹田儋韩信传赞》"},"example":{"text":"把几千年封建地主的特权，打得个落花流水。地主的体面威风，～。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["扫地出门","扫地俱尽"],"usage":"作谓语；指毫无存留"},{"id":20603,"word":"扫地俱尽","pinyin":"sǎo dì jù jìn","abbr":"sdjj","explanation":"指彻底干净，毫无存留。","source":{"text":"惟怀逮愍，丧乱弘多，衣冠礼乐，扫地俱尽。","book":"《汉书·魏豹田儋等传赞》：“用于贬义。秦灭六国，而上古遗烈扫地俱尽矣。”《晋书·儒林传序》"},"example":{"text":"圣人遗训，～，制礼作乐，今也其时。","book":"《隋书·高祖纪下》"},"similar":["扫地无余"],"usage":"作谓语、宾语；指破坏净尽"},{"id":20604,"word":"扫地出门","pinyin":"sǎo dì chū mén","abbr":"sdcm","explanation":"比喻将坏东西彻底清除出去。也没收全部财产，赶出家门。","source":{"text":"从明日起，扫地出门，愚兄一人包了。","book":"清·文康《儿女英雄传》第十六回"},"example":{"text":"这次～的政策很明确，除了个别实在开明、对抗战有功的地主分子外，其他一律不放过。","book":"冯德英《迎春花》第二章"},"similar":["扫地以尽"],"opposite":["原封不动"],"usage":"作谓语、定语；比喻完全清楚"},{"id":20605,"word":"扫地尽矣","pinyin":"sǎo dì jìn yǐ","abbr":"sdjy","explanation":"像扫地一样都没有了。比喻破坏得彻底。也比喻面子、威风丢失干净。","source":{"text":"秦灭六国，而上古遗烈扫地尽矣。","book":"《汉书·魏豹田儋韩信传赞》"},"example":{"text":"祝公身为国子先生，而作此丑态，五经～。","book":"清·褚人获《隋唐演义》第七十六回"}},{"id":20606,"word":"扫地无余","pinyin":"sǎo dì wú yú","abbr":"sdwy","explanation":"指彻底干净，毫无存留。同“扫地俱尽”。","source":{"text":"百王之敝，齐季斯甚，衣冠礼乐，扫地无余。","book":"南朝·梁·任昉《天监三年策秀才文》"},"example":{"text":"后之学者，见秦有焚书之令，则曰《诗》《书》至秦一炬而～，此与耳食何异？","book":"清·刘大櫆《焚书辨》"},"similar":["扫地以尽","扫地俱尽"],"usage":"作谓语、定语；指清扫干净"},{"id":20607,"word":"扫地无遗","pinyin":"sǎo dì wú yí","abbr":"sdwy","explanation":"指彻底干净，毫无存留。同“扫地无余”。","source":{"text":"帝令方（张方）具车载宫人宝物……魏晋已来之积扫地无遗矣。","book":"《晋书·惠帝纪》"},"example":{"text":"庆历初，拓跋元昊攻陷州城，州民及三寨蕃族，尽为所虏，～。","book":"宋·司马光《论复置丰州札子》"},"similar":["扫地无余","扫地俱尽"],"usage":"作谓语、定语；指清扫干净"},{"id":20608,"word":"扫地焚香","pinyin":"sǎo dì fén xiāng","abbr":"sdfx","explanation":"形容清闲幽静的隐逸生活。","source":{"text":"扫地焚香闭阁眠，簟纹如水帐如烟。","book":"宋·苏轼《南堂五首》之五"}},{"id":20609,"word":"扫地而尽","pinyin":"sǎo dì ér jìn","abbr":"sdej","explanation":"表示破坏得一干二净。多指某种文物揣度、精神气慨等丧失殆尽。","source":{"text":"自唐末干戈之乱，儒学文章，扫地而尽。","book":"宋·欧阳修《范文度模本兰亭序三首》其二"},"example":{"text":"今又废之，则三纲、五常～，陛下将何以责天下臣子之尽忠孝于君亲哉！","book":"清·毕沅《续资治通鉴》卷一百四十一"}},{"id":20610,"word":"扫墓望丧","pinyin":"sǎo mù wàng sàng","abbr":"smws","explanation":"扫除墓地，以待人死入葬。指酷吏必当有恶报，指日可待。","source":{"text":"语出《汉书·酷吏传·严延年》：严延年迁河南太守，其母从东海来，欲从延年腊，到洛阳，适见奏报引决囚人。母大惊，谓延年曰：“我不自意当老见壮子被刑戮也！行矣！去女东归，扫除墓地耳！”后岁余，延年果败。"},"example":{"text":"《隋书·隐逸传·李士谦》：“积善余庆，积恶余殃，高门待封，～，岂非休咎应邪？”"},"usage":"作宾语、定语；用于书面语","story":["汉朝时期，严延年任河南太守，他的母亲从东海跟他来到洛阳。一次，正巧看见奏报引决犯人。他母亲大惊说：“我不自意当老见壮子被刑戮也！行矣！去女东归，扫除墓地耳！”过了一年多，严延年果然遭到惩治"]},{"id":20611,"word":"扫帚星","pinyin":"sào zhǒu xīng","abbr":"szx","explanation":"彗星。骂被认为带来灾祸的人。","source":{"text":"你这个小贱人，命带扫帚星！进门不到一年，先扫死了丈夫，再把公公的差使扫掉了。","book":"清·吴趼人《二十年目睹之怪现状》第87回"},"example":{"text":"你这个～，真是害人不浅。"},"similar":["扫把星"],"usage":"作宾语、定语；用于骂人等"},{"id":20612,"word":"扫径以待","pinyin":"sǎo jìng yǐ dài","abbr":"sjyd","explanation":"径：小路；待：等待。洒扫庭院的小路，准备欢迎客人的到来。","example":{"text":"章先生商务繁忙，我们就不打扰了，改日请一定光临舍下，梁某～！","book":"霍达《年轮》第四章"}},{"id":20613,"word":"扫榻以待","pinyin":"sǎo tà yǐ dài","abbr":"styd","explanation":"榻：床。把床打扫干净等待客人到来。对客人表示欢迎的意思。","source":{"text":"南台中丞扫榻见，北门学士倒屣迎。","book":"《后汉书·徐徲传》：“蕃在郡不接宾客，唯徲来特设一榻，去则县（悬）之。”宋·陆游《寄题徐载叔东庄》诗"},"example":{"text":"君以暇时能来相就，则～也。","book":"章炳麟《致伯中书一》"},"usage":"作谓语；表示热忱迎客"},{"id":20614,"word":"扫榻以迎","pinyin":"sǎo tà yǐ yíng","abbr":"styy","explanation":"榻：床。把床打扫干净以迎接客人。对客人表示欢迎的意思。","source":{"text":"南台中丞扫榻见，北门学士倒屣迎。","book":"《后汉书·徐徲传》：“蕃在郡不接宾客，唯徲来特设一榻，去则县（悬）之。”宋·陆游《寄题徐载叔东庄》诗"}},{"id":20615,"word":"扫榻相迎","pinyin":"sǎo tà xiāng yíng","abbr":"stxy","explanation":"榻：床。把床打扫干净以迎接客人。对客人表示欢迎的意思。","source":{"text":"南台中丞扫榻见，北门学士倒屣迎。","book":"《后汉书·徐徲传》：“蕃在郡不接宾客，唯徲来特设一榻，去则县（悬）之。”宋·陆游《寄题徐载叔东庄》诗"},"example":{"text":"三位到了那里，只要提出小弟，他二人再无不～之理。","book":"清·石玉昆《三侠五义》第一百七回"}},{"id":20616,"word":"扫田刮地","pinyin":"sǎo tián guā dì","abbr":"stgd","explanation":"泛指各种农活。","source":{"text":"我宁可与你家担水运浆，扫田刮地，做个佣工。","book":"元·秦简夫《东堂老》第三折"},"example":{"text":"他在家干～的农活。"},"usage":"作谓语、定语；指干零杂农活"},{"id":20617,"word":"扫眉才子","pinyin":"sǎo méi cái zǐ","abbr":"smcz","explanation":"扫眉：妇女画眉毛。旧指有才华的女子。","source":{"text":"万里桥边女校书，楷杷花里闭门居。扫眉才子知多少，管领春风总不如。","book":"唐·王建《寄蜀中薛涛校书》诗"},"example":{"text":"～何由见，一讯桥边女校书。","book":"明·程嘉燧《阊门访旧作》"},"usage":"作宾语；用于女性"},{"id":20618,"word":"扫穴擒渠","pinyin":"sǎo xué qín qú","abbr":"sxqq","explanation":"扫荡巢穴，擒拿贼首。","example":{"text":"在这次“严打”斗争中，武警同志们～，功不可没。"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":20619,"word":"扫穴犁庭","pinyin":"sǎo xué lí tíng","abbr":"sxlt","explanation":"扫荡其居处，犁平其庭院。比喻彻底摧毁敌方。","source":{"text":"且谓蕞尔土司，即扫穴犁庭，不足示武。","book":"清·魏源《圣武记》卷七"},"example":{"text":"会当立马扶桑顶，～再誓师。","book":"郁达夫《离乱杂诗》之十"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":20620,"word":"扫锅刮灶","pinyin":"sǎo guō guā zào","abbr":"sggz","explanation":"指倾其所有。","source":{"text":"我们已经是扫锅刮灶的都拿了出来，不瞒你说，家里连一块钱都不剩了。","book":"洪深《香稻米》第三幕"},"usage":"作宾语、定语、状语；用于比喻句"},{"id":20621,"word":"扫除天下","pinyin":"sǎo chú tiān xià","abbr":"sctx","explanation":"扫除：消除，肃清。肃清坏人，安定社会。","source":{"text":"大丈夫处世，当扫除天下，安事一室乎？","book":"南朝·宋·范晔《后汉书·陈蕃传》"},"example":{"text":"男子汉当以～为己任。"},"usage":"作谓语、定语；指肃清坏人","story":["东汉桓帝时朝廷议郎陈蕃小时候住在一个杂乱无章的院子里潜心读书，客人来访，父亲要他打扫干净一些，他说：“大丈夫应当以扫除天下为己任，怎能只顾一个小小的庭院呢？”后来，汉桓帝在宫中养了几千美女，陈蕃慷慨陈辞要求遣散"]},{"id":20622,"word":"扬厉铺张","pinyin":"yáng lì pù zhāng","abbr":"ylpz","explanation":"夸大渲染。","source":{"text":"而载笔者扬厉铺张，若临大敌，赏功之典，至再至三。","book":"清·王韬《英但自守》"},"usage":"作谓语、定语；用于书面语"},{"id":20623,"word":"扬名后世","pinyin":"yáng míng hòu shì","abbr":"ymhs","explanation":"名声传扬到后世。","source":{"text":"立身行道，扬名于后世。以显父母，孝之终也》","book":"《孝经·开宗明义》"},"example":{"text":"司马迁著书，成一家之言，～。","book":"东汉·班固《典引》"},"similar":["流芳百世"],"usage":"作谓语、定语；指好的名声"},{"id":20624,"word":"扬名四海","pinyin":"yáng míng sì hǎi","abbr":"ymsh","explanation":"扬名：传播名声。四海：古人认为中国四境有海环绕，故以“四海”代指全国各处；也指世界各地。指名声传遍各地。"},{"id":20625,"word":"扬名显亲","pinyin":"yáng míng xiǎn qīn","abbr":"ymxq","explanation":"扬：传扬；显：显赫；亲：父母。指使双亲显耀，名声传扬。","source":{"text":"立身行道，扬名于后世，以显父母，孝之终也。","book":"《孝经·开宗明义》"},"example":{"text":"读了这许多年的书，又到东洋留过学，当然要回省做个一官半职，以便将来～。","book":"巴金《雾》六"},"similar":["显祖扬名","扬名显姓"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20626,"word":"扬名显姓","pinyin":"yáng míng xiǎn xìng","abbr":"ymxx","explanation":"名声传扬，姓字显耀。","source":{"text":"你赍发呵与那个薄弱的书生，兀的不扬名显姓，光明动朝廷。","book":"元·秦简夫《东堂老》第二折"},"example":{"text":"孤寒的便有曾参之孝，伯夷之廉，休想～。","book":"明·冯梦龙《醒世恒言》第二卷"},"similar":["扬名显亲"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20627,"word":"扬威曜武","pinyin":"yáng wēi yào wǔ","abbr":"ywyw","explanation":"炫耀武力，显示威风。","source":{"text":"是故魏氏祖宗扬威曜武，驱其畜产，收其部落。","book":"《魏书·蠕蠕匈奴宇文莫槐等传论》"},"similar":["耀武扬威","扬武耀威"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":20628,"word":"扬威耀武","pinyin":"yáng wēi yào wǔ","abbr":"ywyw","explanation":"炫耀武力，显示威风。","source":{"text":"扬威耀武显神通，走石飞沙弄本事。","book":"明·吴承恩《西游记》第三十五回"},"example":{"text":"这个人穿着美式军服，～地吼叫着。","book":"萧殷《桃子又熟了……》四"},"similar":["耀武扬威","宣威耀武"],"usage":"作谓语、定语、状语；用于处事"},{"id":20629,"word":"扬州鹤","pinyin":"yáng zhōu hè","abbr":"yzh","explanation":"比喻难以实现的妄想。","source":{"text":"有客相从，各言所志，或原为扬州刺史，或原多赀财，或原骑鹤上升。其一人曰：‘腰缠十万贯，骑鹤上扬州。’欲兼三者。","book":"南朝·梁·殷芸《小说》卷六"},"example":{"text":"海底月沈天上兔，辽东人化～。","book":"宋·刘辰翁《满江红》词"}},{"id":20630,"word":"扬己露才","pinyin":"yáng jǐ lù cái","abbr":"yjlc","explanation":"露：显露；扬：表现。显露自己的才能。也比喻炫耀才能，表现自己。","source":{"text":"今若屈原，露才扬己，竞乎危国群小之间，以离谗贼。","book":"汉·班固《离骚序》"},"example":{"text":"徇饰非于明世，强媒蘖于礼经，虽欲～，不觉言之伤理。","book":"《隋书·刘子翊传》"},"similar":["衒才扬己","露才扬己"],"opposite":["不露锋芒"],"usage":"作谓语、定语；用于书面语"},{"id":20631,"word":"扬幡招魂","pinyin":"yáng fān zhāo hún","abbr":"yfzh","explanation":"迷信做法，挂幡招回死者的灵魂。比喻宣扬或企图恢复已经死亡的旧事物。","source":{"text":"设香案，铺祭物，列灯四十九盏，扬幡招魂。","book":"明·罗贯中《三国演义》第91回"},"example":{"text":"日本又在为军国主义～。"},"similar":["招魂扬幡"],"usage":"作谓语、定语；指复旧"},{"id":20632,"word":"扬幡擂鼓","pinyin":"yáng fán léi gǔ","abbr":"yflg","explanation":"幡：一种垂直悬挂的窄旗子。扬起幡，打着鼓。比喻大声张扬。","source":{"text":"假如我不说明这话，大家断不得知。如今是扬幡擂鼓，弄到人家都知道了，都看见了。","book":"清·文康《儿女英雄传》第二十八回"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":20633,"word":"扬扬得意","pinyin":"yáng yáng dé yì","abbr":"yydy","explanation":"形容十分得意的样子。","source":{"text":"其夫为相御，拥大盖，策驷马，意气扬扬，甚自得也。","book":"《荀子·儒效》：“呼先王以欺愚者而求衣食焉，得委积足以揜其口，则扬扬如也。”《史记·管晏列传》"},"example":{"text":"他到此更觉～，目中无人。","book":"清·李宝嘉《官场现形记》第三十四回"},"similar":["洋洋得意"],"opposite":["垂头丧气","灰心丧气"],"usage":"作谓语、定语；指十分得意","story":["春秋时期，齐国三朝相国晏婴身居高位，但行事沉稳，十分谦恭，而他的车夫却认为自己能替相国驾车十分得意扬扬。车夫的妻子见了就告诫车夫，应该向晏婴学习，车夫从此变得很谦逊起来，晏婴认为他知错必改表现很好"]},{"id":20634,"word":"扬扬自得","pinyin":"yáng yáng zì dé","abbr":"yyzd","explanation":"十分得意的样子。","source":{"text":"晏子为齐相，出，其御之妻从门间而窥其夫。其夫为相御，拥大盖，策驷马，意气扬扬，甚自得也。","book":"语出《史记·管晏列传》"},"example":{"text":"反使我辈鞭胸杖背，出财为赏，汝曹犹～，独不愧天地乎！","book":"《资治通鉴·后唐潞王清泰元年》"},"similar":["洋洋得意","扬扬得意"],"opposite":["垂头丧气"],"usage":"作谓语、定语、状语；指非常得意","story":["春秋时期，齐国宰相晏婴乘车外出，他在车上温良谦恭，而他的车夫挥动鞭子策马而行，意气扬扬，甚为自得。车夫的妻子瞧见后回家劝车夫不要那样扬扬自得、仗势自侍。车夫第二天就立即更正自己的态度，晏婴认为他是可塑之才"]},{"id":20635,"word":"扬榷古今","pinyin":"yáng què gǔ jīn","abbr":"yqgj","explanation":"扬榷：略举大要，扼要论述。扼要论述古代和现代的事情。","source":{"text":"扬榷古今，监世盈虚。","book":"《汉书·叙传》"},"example":{"text":"吾见马君论事多矣，援引事类，～，举要删芜，会文切理，一字不可加，一言不可减，听之靡靡，令人亡倦。","book":"《旧唐书·马周传》"}},{"id":20636,"word":"扬武耀威","pinyin":"yáng wǔ yào wēi","abbr":"ywyw","explanation":"炫耀武力，显示威风。","source":{"text":"臣已有退诸葛亮之计。不用魏军扬武耀威，蜀兵自然走矣。","book":"明·罗贯中《三国演义》第九十七回"},"similar":["扬威耀武","耀武扬威","宣威耀武"],"usage":"作谓语、定语、状语；用于处事"},{"id":20637,"word":"扬汤止沸","pinyin":"yáng tāng zhǐ fèi","abbr":"ytzf","explanation":"把锅里开着的水舀起来再倒回去，使它凉下来不沸腾。比喻办法不彻底，不能从根本上解决问题。","source":{"text":"扬汤止沸，使不焦烂。","book":"汉·枚乘《上书谏吴王》：“欲汤之沧，一人炊之，百人扬之，无益也；不如绝薪止火而已。”《三国志·魏书·刘廙传》"},"example":{"text":"臣闻～，不如去薪；溃痈之痛，胜于养毒。","book":"明·罗贯中《三国演义》第三回"},"similar":["纵风止燎"],"opposite":["釜底抽薪"],"usage":"作谓语、定语；指治标不治本","story":["东汉末年，刘廙因哥哥刘望之被荆州刺史刘表所杀就去投奔曹操，他的弟弟刘伟是行刺曹操的案犯魏讽的同党，按律刘廙也应处死，可曹操爱惜人才并没有杀他。刘廙给曹操写一封信，感谢曹操扬汤止沸救命之恩，让他枯木生花"]},{"id":20638,"word":"扬清厉俗","pinyin":"yáng qīng lì sú","abbr":"yqls","explanation":"发扬清操，激励世俗。","source":{"text":"璩安贫守道，悦《礼》敦《诗》，未尝投刺邦宰，曳裾府寺，如其简退，可以扬清厉俗。","book":"《梁书·处士传·诸葛璩》"},"usage":"作谓语、定语；用于书面语"},{"id":20639,"word":"扬清抑浊","pinyin":"yáng qīng yì zhuó","abbr":"yqyz","explanation":"犹扬清激浊。比喻抨击、清除坏人坏事，表彰、发扬好人好事。","source":{"text":"公扬清抑浊，官方有序，多士聿兴。","book":"《梁书·武帝纪》"},"similar":["扬清激浊"],"usage":"作谓语、定语；指扬善斥恶"},{"id":20640,"word":"扬清激浊","pinyin":"yáng qīng jī zhuó","abbr":"yqjz","explanation":"冲去污水，让清水上来。比喻抨击、清除坏人坏事，表彰、发扬好人好事。","source":{"text":"沐浴群生，流通万物，仁也；扬清激浊，荡去滓秽，义也。","book":"《尸子·君治》"},"example":{"text":"臣又闻致化之道，在于求贤审官；为政之基，在于～。","book":"《旧唐书·马周传》"},"similar":["扬善斥恶","扬清抑浊"],"usage":"作谓语；指扬善斥恶"},{"id":20641,"word":"扬眉伸气","pinyin":"yáng méi shēn qì","abbr":"ymsq","explanation":"扬起眉头，吐出怨气。形容摆脱了长期受压状态后高兴痛快的样子。","source":{"text":"何惜阶前盈尺之地，不使白扬眉吐气，激昂青云耶？","book":"唐·李白《与韩荆州书》"},"example":{"text":"不以暇时谋究立国之本末，而方～以论富强，不知何者谓之富强乎？","book":"宋·陈亮《上孝宗皇帝第一书》"}},{"id":20642,"word":"扬眉吐气","pinyin":"yáng méi tǔ qì","abbr":"ymtq","explanation":"扬起眉头，吐出怨气。形容摆脱了长期受压状态后高兴痛快的样子。","source":{"text":"何惜阶前盈尺之地，不使白扬眉吐气，激昂青云耶？","book":"唐·李白《与韩荆州书》"},"example":{"text":"只要将来做了八府巡按，妈也就可以～了。","book":"巴金《家》十二"},"similar":["眉飞色舞","慷慨激昂"],"opposite":["垂头丧气","忍声吞气","俯首帖耳"],"usage":"作谓语、定语、状语；指高兴"},{"id":20643,"word":"扬眉奋髯","pinyin":"yáng méi fèn rán","abbr":"ymfr","explanation":"扬眉：扬起眉毛；髯：颊旁所生胡须。眉飞色舞，胡须飘动。形容说话时神情激动兴奋的神态。","source":{"text":"徐禧无学术而口辨，扬眉奋髯，足以动人主意。","book":"宋·吴曾《能改斋漫录·辨误》"},"usage":"作谓语、状语；用于处事"},{"id":20644,"word":"扬眉抵掌","pinyin":"yáng méi dǐ zhǎng","abbr":"ymdz","explanation":"扬眉：笑时扬起眉毛；抵掌：击掌。形容极其高兴喜悦。","source":{"text":"见一善则盱衡扼腕，遇一才则扬眉抵掌。","book":"《梁书·任昉传》"},"usage":"作谓语、定语；用于书面语"},{"id":20645,"word":"扬眉眴目","pinyin":"yáng méi shùn mù","abbr":"ymsm","explanation":"指横眉怒目。","source":{"text":"忽然化出毒龙，口吐烟云，黑天翳日，扬眉眴目，震地雷鸣。","book":"《敦煌变文集·降魔变文》"},"similar":["扬眉瞬目","横眉怒目"],"usage":"作谓语、定语；指面部表情"},{"id":20646,"word":"扬眉瞬目","pinyin":"yáng méi shùn mù","abbr":"ymsm","explanation":"①犹横眉怒目。②一举眉，一转眼。形容时间极短。③倾心注目。④沾沾自喜貌。","source":{"text":"行如奔电，骤如飞旋，扬眉瞬目，恐动四边。","book":"《敦煌变文集·降魔变文》"},"example":{"text":"清·戴名世《跋赵孟頫画》：“余又以子昂实书画累之，彼方～，以此自名，而陷于极恶大罪而不自知。”"},"similar":["扬眉眴目","横眉怒目"],"usage":"作谓语、定语；指面部表情"},{"id":20647,"word":"扬砂走石","pinyin":"yáng shā zǒu shí","abbr":"yszs","explanation":"沙土飞扬，石块滚动。形容风势狂暴。","source":{"text":"正欲诛伐之，乃有神飞沙走石，雷电霹雳。","book":"晋·干宝《搜神记》卷三"},"example":{"text":"杀得那空中无鸟过，山内虎狼奔；～乾坤黑，播土飞尘宇宙昏。","book":"明·吴承恩《西游记》第五回"},"similar":["飞砂走石"],"usage":"作谓语、定语；形容风力迅猛"},{"id":20648,"word":"扬花扢藻","pinyin":"yáng huā jié zǎo","abbr":"yhgz","explanation":"形容文章写得华丽多采。同“扬葩振藻”。","source":{"text":"［曹子清］铸格炼字，扬花扢藻，此可以学得也；亭皋木叶，池塘春草，此不可以学得也。","book":"清·顾景星《〈楝亭诗钞〉序》"},"similar":["扬葩振藻"],"usage":"作谓语、定语；用于书面语"},{"id":20649,"word":"扬葩振藻","pinyin":"yáng pā zhèn zǎo","abbr":"ypzz","explanation":"葩：华美；藻：文采。形容文章写得华丽多采。","source":{"text":"汉自孝武之后，雅尚斯文，扬葩振藻者如林，而二马、王、扬为之杰。","book":"《北史·文苑传序》"},"example":{"text":"当其盛也，～，为敲金戛玉之音。","book":"胡蕴玉《中国文学史》序"},"similar":["扬花拮藻"],"usage":"作谓语、定语；用于书面语"},{"id":20650,"word":"扬铃打鼓","pinyin":"yáng líng dǎ gǔ","abbr":"yldg","explanation":"比喻大声张扬。","source":{"text":"‘大事化为小事，小事化为没事’，方是兴旺之家。若得不了一点子小事，便扬铃打鼓的乱折腾起来，不成道理。","book":"清·曹雪芹《红楼梦》第六十二回"},"similar":["大张旗鼓","敲锣打鼓"],"usage":"作谓语；指大肆张扬"},{"id":20651,"word":"扬锣捣鼓","pinyin":"yáng luó dǎo gǔ","abbr":"yldg","explanation":"犹扬铃打鼓。比喻喧哗吵闹。","source":{"text":"料想雯青这回必然要扬锣捣鼓的大闹，所以张夫人身虽在这边，心却在那边。","book":"清·曾朴《孽海花》第二十三回"},"similar":["扬铃打鼓"],"usage":"作谓语；指大肆张扬"},{"id":20652,"word":"扬镳分路","pinyin":"yáng biāo fēn lù","abbr":"ybfl","explanation":"扬镳：指驱马前进。分路而行。比喻目标不同，各走各的路或各干各的事。","source":{"text":"已诏使人，所在赈恤，扬镳分路，将遍四海，必令为朕耳目。","book":"《隋书·高祖纪》"},"example":{"text":"唐·颜师古《汉书叙例》：“六艺残缺，莫睹全文，各自名家，～。”"},"similar":["分道扬镳"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":20653,"word":"扬长而去","pinyin":"yáng cháng ér qù","abbr":"yceq","explanation":"大模大样地径自走了。","source":{"text":"（道士）道：‘……千万不可照正面，只照背面，要紧，要紧！三日后我来收取，管叫你病好。’说毕，徉长而去。","book":"清·曹雪芹《红楼梦》第十二回"},"example":{"text":"说罢，深深一揖，～。","book":"清·吴趼人《二十年目睹之怪现状》第一回"},"similar":["拂袖而去","不欢而散"],"opposite":["不期而遇"],"usage":"作谓语；指大模大样地离去"},{"id":20654,"word":"扬长避短","pinyin":"yáng cháng bì duǎn","abbr":"ycbd","explanation":"发挥或发扬优点或有利条件，克服或回避缺点或不利条件。","source":{"text":"选择这样一个题材来写作，既扬长避短，也施展了抱负。","book":"秦牧《漫记端木蕻良》"},"example":{"text":"因地制宜，～。","book":"《萧山农工商联合企业显示优越性》"},"similar":["避实就虚","取长补短"],"opposite":["因陋就简","以短击长"],"usage":"作谓语、定语、分句；指发扬长处，回避短处"},{"id":20655,"word":"扬风扢雅","pinyin":"yáng fēng bào yǎ","abbr":"yfjy","explanation":"品评诗文。","source":{"text":"诸人尝寓其家，流连觞咏，声光映蔽江表。此皆林下之人扬《风》扢《雅》，而声气所届，希风附响者，如恐不及。","book":"清·赵翼《廿二史札记》卷三十"},"usage":"作谓语、定语；用于书面语"},{"id":20656,"word":"扬风抦雅","pinyin":"yáng fēng bào yǎ","abbr":"yfby","explanation":"品评诗文。"},{"id":20657,"word":"扭亏为盈","pinyin":"niǔ kuī wéi yíng","abbr":"nkwy","explanation":"扭：扭转。扭转亏损为盈利局面。","example":{"text":"我们企业已经～了。"},"similar":["扭亏增盈"],"usage":"作谓语、宾语、定语；用于经济"},{"id":20658,"word":"扭亏增盈","pinyin":"niǔ kuī zēng yíng","abbr":"nkzy","explanation":"扭转亏损，增加盈利。","source":{"text":"强化企业管理，提高科学管理水平……也是国有企业扭亏增盈、提高竞争能力的重要途径。","book":"《中共中央关于国有企业改革和发展若干重大问题的决定》"},"example":{"text":"《人民日报》1983.12.30：“这说明工业企业扭亏增盈的任务依然相当艰巨。”"},"similar":["扭亏为盈"],"usage":"作谓语、宾语、定语；用于经济"},{"id":20659,"word":"扭头别项","pinyin":"niǔ tóu biè xiàng","abbr":"ntbx","explanation":"别：转动；项：颈项。扭转头颅表示不悦。","source":{"text":"幸是我那天不曾莽撞，不然今日之下，弄得一个扭头别项，一个泪眼愁眉，人生到此，还有何意味！","book":"清·文康《儿女英雄传》第32回"},"usage":"作谓语、宾语、状语；用于人不高兴"},{"id":20660,"word":"扭手扭脚","pinyin":"niǔ shǒu niǔ jiǎo","abbr":"nsnj","explanation":"身体左右扭动。形容故作娇媚或有意做作。","source":{"text":"你们休要扭手扭脚的。","book":"明·兰陵笑笑生《金瓶梅词话》第49回"},"similar":["捏捏扭扭"],"usage":"作定语、状语；指装模作样"},{"id":20661,"word":"扭扭捏捏","pinyin":"niǔ niǔ niē niē","abbr":"nnnn","explanation":"行走时身体故意左右扭动摇摆。形容举止言谈不爽快，不大方或故做姿态和。","source":{"text":"那般娇娇啻啻，扭扭捏捏，就象那老怪的行动。","book":"明·吴承恩《西游记》第三十四回"},"example":{"text":"难为你说的齐全，别象他们～的蚊子似的。","book":"清·曹雪芹《红楼梦》第二十七回"},"similar":["装模作样"],"opposite":["大大方方"],"usage":"作宾语、定语、状语；指装模作样"},{"id":20662,"word":"扭捏作态","pinyin":"niǔ niē zuò tài","abbr":"nnzt","explanation":"具有娇揉造作或夸张的性格，不是天然或自然的。","example":{"text":"我不喜欢你～。"},"similar":["娇揉造作"],"usage":"作谓语、定语；指故意做作"},{"id":20663,"word":"扭是为非","pinyin":"niǔ shì wéi fēi","abbr":"nswf","explanation":"硬把正确的说成错误的。形容颠倒是非，强词夺理。","source":{"text":"谁不知谄佞人是你一个王枢密，你如今扭是为非。","book":"元·无名氏《活拿萧天佑》第一折"},"usage":"作谓语、宾语、定语；指是非颠倒"},{"id":20664,"word":"扭曲作直","pinyin":"niǔ qū zuò zhí","abbr":"nqzz","explanation":"比喻是非颠倒。","source":{"text":"兄弟，您哥哥平日不曾扭曲作直，所以不走不逃。","book":"元·岳伯川《铁拐李》第一折"},"example":{"text":"你不要～了。"},"similar":["颠倒是非"],"opposite":["扭直作曲"],"usage":"作谓语、定语；比喻颠倒是非"},{"id":20665,"word":"扭直作曲","pinyin":"niǔ zhí zuò qū","abbr":"nzzq","explanation":"比喻是非颠倒。"},{"id":20666,"word":"扭转乾坤","pinyin":"niǔ zhuǎn qián kūn","abbr":"nzqk","explanation":"乾坤：天地。比喻从根本上改变整个局面。","example":{"text":"他定能～收拾残局的。"},"similar":["力挽狂澜"],"usage":"作谓语、定语；指从根本上改变整个局面"},{"id":20667,"word":"扭转干坤","pinyin":"niǔ zhuǎn gàn kūn","abbr":"nzgk","explanation":"比喻从根本上改变已成的局面。"},{"id":20668,"word":"扯扯拽拽","pinyin":"chě chě zhuài zhuài","abbr":"cczz","explanation":"拉扯，用力拉，也指推推拉拉。","source":{"text":"便有许多王孙公子要求娶他，又有些媒婆扯扯拽拽扶他上车，自己不肯去。一回儿又有盗贼劫他，持刀执棍的逼勒。","book":"清·曹雪芹《红楼梦》第87回"},"example":{"text":"清·无名氏《说呼全传》第四回：“那些将校不得不遵，只得上前～。”"},"similar":["拉拉扯扯"],"usage":"作谓语、状语；用于人的动作","story":["妙玉自从与宝玉听了黛玉那凄凉的琴声后，恍恍忽忽地回到庵内，念完“禅门日诵”就在禅床上打坐，神不守舍地想起宝玉的话，心跳耳热，迷迷糊糊地睡着了，梦中好像有许多王孙公子要娶她，媒婆扯扯拽拽的，甚至有强盗持刀执棍威逼她，大病一场"]},{"id":20669,"word":"扯旗放炮","pinyin":"chě qí fàng pào","abbr":"cqfp","explanation":"比喻公开张扬。","source":{"text":"她扯旗放炮来考工厂，考不上怎样回下堡村蛤蟆滩呢？","book":"柳青《创业史》第一部第九章"},"example":{"text":"不用～的，不要弄得谁也知道了。","book":"李准《李双双小传·不能走那条路》"},"similar":["大张旗鼓"],"usage":"作谓语、宾语；指制造声势"},{"id":20670,"word":"扯空砑光","pinyin":"chě kōng yà guāng","abbr":"ckyg","explanation":"扯空：说假话。砑光：纸及布匹用石头磨光，使发光泽，叫“砑光”；比喻沾别人光。指花言巧语，骗人钱财。","source":{"text":"那一带沿河临水住的，俱是靠着虎丘山上，养活不知多多少少扯空砑光的人。","book":"清·艾衲居士《豆棚闲话》第十则"},"usage":"作宾语、定语；用于欺骗等"},{"id":20671,"word":"扯篷拉纤","pinyin":"chě péng lā qiàn","abbr":"cplq","explanation":"指用不正当的手段为人撮合或说情而从中取利的行为。","source":{"text":"我比不得他们扯篷拉纤的图银子。这三十两银子，不过是给打发去说的小厮们作盘缠。","book":"清·曹雪芹《红楼梦》第十五回"},"example":{"text":"～攒门子，把式输他打得圆。","book":"清·杨米人《都门竹枝词》"},"usage":"作谓语、定语；比喻作中介绍牟利"},{"id":20672,"word":"扯纤拉烟","pinyin":"chě qiàn lā yān","abbr":"cqly","explanation":"犹扯篷拉纤。指用不正当的手段为人撮合或说情而从中取利的行为。","source":{"text":"晁书、晁凤也只道胡旦的外公，不过在京中扯纤拉烟，寻常门户罢了。","book":"清·西周生《醒世姻缘传》第五回"}},{"id":20673,"word":"扯顺风旗","pinyin":"chě shǔn fēng qí","abbr":"csfq","explanation":"形容随风摆动，顺势迎合，奉承别人。","source":{"text":"有些扯顺风旗的，亦就一口一声的观察。","book":"清·李宝嘉《官场现形记》第35回"},"example":{"text":"她一贯～，毫无主见。"},"similar":["顺水推舟"],"opposite":["逆天行事"],"usage":"作谓语、定语、宾语；指顺势"},{"id":20674,"word":"扯鼓夺旗","pinyin":"chě gǔ duó qí","abbr":"cgdq","explanation":"形容作战勇敢。","source":{"text":"统雄兵劈面相持，驱貔虎扯鼓夺旗。","book":"元·郑光祖《伊尹耕莘》第三折"},"example":{"text":"～千般勇，三停刀上血光飞。","book":"元·高文秀《襄阳会》第三折"},"similar":["斩将搴旗"],"usage":"作谓语、定语；指人勇敢"},{"id":20675,"word":"扳椽卧辙","pinyin":"bān yuán wò zhé","abbr":"bcwz","explanation":"拉住车辕，躺在车道上，不让车走。旧时用作挽留好官之词。","source":{"text":"攀车卧辙之恋，争涂不忘。","book":"南朝·梁·沈约《齐故安陆昭王碑》"},"example":{"text":"遂解官东归，百姓闻之，～而留，泣声震地。","book":"明·冯梦龙《警世通言》卷二十一"}},{"id":20676,"word":"扳辕卧辙","pinyin":"pān yuán wò zhé","abbr":"bywz","explanation":"扳：通“攀”；辙：车迹。拉住车辕，躺在车道上挡车。指挽留眷恋好官","source":{"text":"遂解官东归，百姓闻知，扳辕卧辙而留，泣声震地。","book":"明·冯梦龙《警世通言》第40卷"},"similar":["攀辕卧辙"],"usage":"作谓语、定语；指好官离任"},{"id":20677,"word":"扳龙附凤","pinyin":"bān lóng fù fèng","abbr":"blff","explanation":"指依附龙凤而升空。","source":{"text":"弹琴鼓瑟，聊以自娱。陵云登台，浮游太清。扳龙附凤，日望身轻。","book":"南朝·梁·沈约《宋书》志第十二乐四"},"similar":["攀龙附凤"],"usage":"作谓语、宾语、定语；指巴结别人"},{"id":20678,"word":"扶不起的阿斗","pinyin":"fú bù qǐ de ā dǒu","abbr":"fbqdad","explanation":"阿斗：三国蜀汉刘备之子刘禅的小名。阿斗庸碌无能，虽有诸葛亮等人全力扶助，也不能振兴蜀汉。比喻扶持不起来的人。","example":{"text":"他真是一个～。"},"usage":"作宾语、定语；指无能的人","story":["三国时期，蜀国昭烈帝刘备死后，刘禅即位。诸葛亮死后，蜀国灭亡。后主刘禅投降了司马文王司马昭。司马昭宴请刘禅，故意安排蜀国的节目，刘禅看得津津有味，司马昭看到刘禅乐不思蜀的样子，认为扶不起的阿斗无能治国"]},{"id":20679,"word":"扶东倒西","pinyin":"fú dōng dǎo xī","abbr":"fddx","explanation":"扶：扶持，搀扶。比喻随他人的意志转移，自己没主见。","source":{"text":"张魏公才极短，虽大义极分明而不全晓事，扶得东边，倒了西边；知得这里，忘了那里。","book":"宋·朱熹《朱子语类》第131卷"},"similar":["东扶西倒"],"usage":"作谓语、定语；指人没主见"},{"id":20680,"word":"扶余海外","pinyin":"fú yú hǎi wài","abbr":"fyhw","explanation":"扶余：传说中的古国名，有说是今天的日本，也有说是今天的南美洲。比喻遥远的与世隔绝的异国他乡。","source":{"text":"海外扶余，隐然复有世界。","book":"唐·杜光庭《虬髯客传》中有虬髯客在东南的扶余国称王的故事。明·张岱《与王白岳》"},"example":{"text":"从兹双宿复双飞，～三年久。","book":"柳亚子《诗翁行哭李少石》"},"similar":["海外扶余"],"usage":"作主语、宾语；指外国"},{"id":20681,"word":"扶倾济弱","pinyin":"fú qīng jì ruò","abbr":"fqjr","explanation":"倾：倒塌，这里指遇到困境的人。扶助困难的人，救济弱小的人。","source":{"text":"你若肯扶倾济弱，我可便回嗔作笑，一会价记着想念着。","book":"元·王子一《误入桃源》第四折"},"example":{"text":"我们今天在没有发达之先，立定～的志向。","book":"孙中山《民族主义六讲》"},"similar":["救死扶伤","扶贫济困"],"usage":"作谓语、宾语、定语；指救危"},{"id":20682,"word":"扶危定乱","pinyin":"fú wēi dìng luàn","abbr":"fwdl","explanation":"扶助危难，平定祸乱。","source":{"text":"宇文夏州英姿不世，算略无方，方欲扶危定倾，匡复京、洛。","book":"《周书·梁禦传》"},"example":{"text":"能识人，能爱人才，能为国留得那英雄豪杰，为朝廷～。","book":"清·褚人获《隋唐演义》第八十三回"},"similar":["扶危定倾"],"usage":"作谓语、定语；指人的本事大"},{"id":20683,"word":"扶危定倾","pinyin":"fú wēi dìng qīng","abbr":"fwdq","explanation":"指在国家危殆将倾覆之时扶持之使安定。","source":{"text":"太祖扶危定倾，威权震主。","book":"《周书·李基传》"},"example":{"text":"任用偶误，一切乖方，而欲倚之以～，经营八表，岂不难乎！","book":"康有为《上清帝第二书》"},"similar":["扶危翼倾"],"usage":"作谓语、宾语、定语；用于时局"},{"id":20684,"word":"扶危拯溺","pinyin":"fú wēi zhěng nì","abbr":"fwzn","explanation":"溺：落水。帮助危难者，救起落水者。比喻救助别人的急难。","source":{"text":"常州之义笃于友，用之有常，行之可久，扶危拯溺，尔身我手。","book":"唐·崔祐甫《唐故常州刺史独孤公神道碑铭序》"},"usage":"作谓语、宾语、定语；用于处世"},{"id":20685,"word":"扶危持倾","pinyin":"fú wēi chí qīng","abbr":"fwcq","explanation":"扶：帮助；持：握，把握。指能够挽回颠危的局面，使之转危为安。","source":{"text":"今日足下扶危持倾，为国柱石。","book":"晋·陈寿《三国志·许靖传》"},"similar":["扶急持倾","扶颠持危"],"usage":"作谓语、宾语、定语；用于时局"},{"id":20686,"word":"扶危持颠","pinyin":"fú wēi chí diān","abbr":"fwcd","explanation":"扶：帮助；持：握，把握；颠：倒，倾倒。指挽回处于危难中的国家或人。","source":{"text":"素骄贵，末年愈甚，无复知所负荷，扶危持颠。","book":"唐·杜光庭《虬髯客传》"},"example":{"text":"而况肩巨任大，～，肯相辜负哉！","book":"明·李贽《焚书·与友朋书》"},"similar":["扶危持倾"],"usage":"作谓语、宾语；指人本事大"},{"id":20687,"word":"扶危救困","pinyin":"fú wēi jiù kùn","abbr":"fwjk","explanation":"对处境危急、困难的人给以救济帮助。","source":{"text":"今日个扶危救困休辞惮，疾便的牵战马上雕鞍。","book":"元·无名氏《魏徵改诏》第三折楔子"},"example":{"text":"梁斌《红旗谱》第三卷：“陈旅长响亮地笑了，说：‘知兄！还不失尚老遗风，～，爱国恤民。”"},"similar":["扶危济困"],"usage":"作谓语、定语；指救济有危难和困苦的人"},{"id":20688,"word":"扶危济困","pinyin":"fú wēi jì kùn","abbr":"fwjk","explanation":"扶：帮助；济：搭救，拯救。扶助有危难的人，救济困苦的人。","source":{"text":"素知将军仗义行仁，扶危济困，不想果然如此义气。","book":"明·施耐庵《水浒全传》第五十五回"},"example":{"text":"在这篇作品中，突出体现了主人公为人民～的英雄主义气慨。"},"similar":["仗义疏财","扶弱抑强"],"opposite":["趁火打劫","落井下石"],"usage":"作谓语、定语；指救济有危难和困苦的人"},{"id":20689,"word":"扶危济急","pinyin":"fú wēi jì jí","abbr":"fwjj","explanation":"犹扶危济困。","source":{"text":"君以一九三○年三月至沪……中遭艰巨，笃行靡改，扶危济急，公私两全。","book":"鲁迅《且介亭杂文二集·鎌田诚一墓记》"},"similar":["扶危济困","扶困济危"],"usage":"作谓语、定语；指救济有危难和困苦的人"},{"id":20690,"word":"扶危翼倾","pinyin":"fú wēi yì qīng","abbr":"fwyq","explanation":"指在国家危殆将倾覆之时扶持之使安定。","source":{"text":"昔魏室将季，海内分崩，太祖扶危翼倾，肇开王业。","book":"《周书·武帝纪下》"},"similar":["扶危定倾"],"usage":"作谓语、宾语、定语；用于时局"},{"id":20691,"word":"扶善惩恶","pinyin":"fú shàn éng è","abbr":"fsce","explanation":"帮助善良的，打击邪恶的。","source":{"text":"把爱与憎的感情深刻化，从而加强团结的力量，而移入扶善惩恶的行动。","book":"郭沫若《文学与社会》"},"similar":["惩恶扬善"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20692,"word":"扶善遏过","pinyin":"fú shàn è guò","abbr":"fseg","explanation":"扶：帮助；遏：阻止，抑制。支持善良正确的，抑制邪恶过错的。","source":{"text":"严以有礼，扶善遏过。","book":"唐·韩愈《唐故国子司业窦公墓志铭》"}},{"id":20693,"word":"扶困济危","pinyin":"fú kùn jì wēi","abbr":"fkjw","explanation":"扶：帮助，支持；济：拯救。扶持、救济有危难和困苦的人。","source":{"text":"李大树在二虎子心目中，已成为自己所不及的、不畏强暴、扶困济危、本领高强的英雄。","book":"柳洲《风雨桃花洲》"},"similar":["扶危济困","扶危济急","拯危济困"],"opposite":["落井下石"],"usage":"作谓语、定语；指救济有危难和困苦的人"},{"id":20694,"word":"扶墙摸壁","pinyin":"fú qiáng mō bì","abbr":"fqmb","explanation":"抚摸着墙壁。比喻言论主张比较软弱平庸。","source":{"text":"这两个鸟男女，正在缸里扶墙摸壁扎挣。","book":"明·施耐庵《水浒全传》第三十回"},"example":{"text":"不过说到开国会，定宪法，都是些～的政论，没一个挥戈回日的奇才。","book":"清·曾朴《孽海花》第二十九回"},"similar":["人云亦云"],"usage":"作谓语、定语；指没有创见"},{"id":20695,"word":"扶弱抑强","pinyin":"fú ruò yì qiáng","abbr":"fryq","explanation":"扶助弱小，压制强暴。","example":{"text":"《水浒》这本书中，描述了众多杀富济贫，扶弱抑强的英雄豪杰。"},"similar":["锄强扶弱","杀富济贫"],"usage":"作谓语、定语；指扶助弱小，压制强暴"},{"id":20696,"word":"扶急持倾","pinyin":"fú jí chí qīng","abbr":"fjcq","explanation":"扶：帮助；持：握，把握。指能够挽回颠危的局面，使之转危为安。","source":{"text":"故其谋扶急持倾，为一切之权。","book":"西汉·刘向《战国策》序"},"similar":["扶颠持危","扶危持倾"],"usage":"作谓语、宾语、定语；用于时局"},{"id":20697,"word":"扶摇万里","pinyin":"fú yáo wàn lǐ","abbr":"fywl","explanation":"扶摇：急剧盘旋而上的暴风。暴风从下而上盘旋很高，风势急且大。","source":{"text":"抟扶摇而上九万里。","book":"《庄子·逍遥游》"},"similar":["扶摇而上"],"usage":"作谓语、宾语、定语；形容职位、地位等"},{"id":20698,"word":"扶摇直上","pinyin":"fú yáo zhí shàng","abbr":"fyzs","explanation":"扶摇：急剧盘旋而上的暴风。形容上升很快。比喻仕途得意。","source":{"text":"抟扶摇而上者九万里。","book":"《庄子·逍遥游》"},"example":{"text":"大鹏一日同风起，～九万里。","book":"唐·李白《上李邕》诗"},"similar":["青云直上","平步青云"],"opposite":["一落千丈","急转直下"],"usage":"作谓语、宾语、定语；形容职位、地位等"},{"id":20699,"word":"扶摇而上","pinyin":"fú yáo ér shàng","abbr":"fyes","explanation":"扶摇：迅猛盘旋而上的旋风。形容上升很快或指仕途得志。","source":{"text":"鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"明·施耐庵《水浒传》第96回：“须臾，渐高渐大，～，直到九霄空里，化成个大鹏。”"},"similar":["扶摇直上"],"usage":"作谓语、宾语、定语；形容职位、地位等"},{"id":20700,"word":"扶植纲常","pinyin":"fú zhí gāng cháng","abbr":"fzgc","explanation":"扶植：扶助培植；纲常：三纲五常。扶助培植三纲五常。指维护封建社会统治阶级的用来愚弄、奴役人民的礼教法权。","source":{"text":"这赏罚并无私曲，总之，为扶植纲常。","book":"元·马致远《青衫泪》第四折"}},{"id":20701,"word":"扶正祛邪","pinyin":"fú zhèng qū xié","abbr":"fzqx","explanation":"祛：去除。扶助正义，去除邪恶。现用来指扶持好的事物，纠正错误倾向。","source":{"text":"圣意勤勤，欲流清荡浊，扶正黜邪。","book":"汉·蔡邕《对诏问灾异八事》"},"example":{"text":"王朔《人莫予毒》：“我们的舆论工具正面临着一个～、净化社会气氛的艰巨任务。”"},"similar":["扶正黜邪"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20702,"word":"扶正黜邪","pinyin":"fú zhèng chù xié","abbr":"fzcx","explanation":"扶助正道，除去邪恶。","source":{"text":"圣意勤勤，欲清流荡浊，扶正黜邪。","book":"汉·蔡邕《对诏问灾异》"},"similar":["扶正祛邪"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20703,"word":"扶老将幼","pinyin":"fú lǎo jiāng yòu","abbr":"fljy","explanation":"扶：挽着。搀着老人，领着小孩。","source":{"text":"逾城散走坠空壕，扶老将幼山中号。","book":"宋·陆游《董逃行》诗"},"similar":["扶老携幼","扶老挈幼","扶老挟稚"],"usage":"作谓语、宾语、状语；用于出行"},{"id":20704,"word":"扶老挈幼","pinyin":"fú lǎo qiè yòu","abbr":"flqy","explanation":"扶：挽着；挈：提携，带领。搀着老人，领着小孩。","source":{"text":"所过州县，分毫不扰，乡村百姓，扶老挈幼，烧香罗拜迎接。","book":"明·施耐庵《水浒传》第58回"},"example":{"text":"市民脸上带着惶惶不安的神情，～，背着行李家具，在向市郊疏散。","book":"魏巍《东方》"},"similar":["扶老携幼","扶老挟稚","扶老携弱"],"usage":"作谓语、宾语、状语；用于出行"},{"id":20705,"word":"扶老挟稚","pinyin":"fú lǎo xié zhì","abbr":"flxz","explanation":"扶：挽着；挟：夹在胳膊下。搀着老人，领着小孩。","source":{"text":"夏人扶老挟稚，中夜入州城，明日俘获甚夥，而庆兵不至，乃引还。","book":"《宋史·可适传》"},"similar":["扶老携幼","扶老将幼","扶老携弱"],"usage":"作谓语、宾语、状语；用于出行"},{"id":20706,"word":"扶老携幼","pinyin":"fú lǎo xié yòu","abbr":"flxy","explanation":"携：拉着，带领。搀着老人，领着小孩。","source":{"text":"夫至百里，民扶老携幼，迎君道中。","book":"《战国策·齐策四》"},"example":{"text":"乡里人听见锣响，一个个～，挨挤了看。","book":"清·吴敬梓《儒林外史》第一回"},"similar":["尊老爱幼"],"opposite":["奸淫掳掠"],"usage":"作谓语、宾语、状语；用于出行"},{"id":20707,"word":"扶老携弱","pinyin":"fú lǎo xié ruò","abbr":"flxr","explanation":"扶：挽着；携：带领。搀着老人，领着小孩。","source":{"text":"豳人举国扶老携弱，尽复归古公于歧下。","book":"西汉·司马迁《史记·周本纪》"},"similar":["扶老携幼","扶老将幼","扶老挟稚"],"usage":"作谓语、宾语、状语；用于出行"},{"id":20708,"word":"扶辇下除","pinyin":"fu nian xia chu","abbr":"fnxc","explanation":"扶着皇帝的车驾下殿阶。"},{"id":20709,"word":"扶颠持危","pinyin":"fú diān chí wēi","abbr":"fdcw","explanation":"颠：倒，倾倒；持：握，把握。指能够挽回颠危的局面。","source":{"text":"颠：倒，倾倒；持：握，把握。指能够挽回颠危的局面。"},"similar":["扶危定倾"],"usage":"作谓语、宾语、定语；用于时局"},{"id":20710,"word":"批亢抵巇","pinyin":"pī gāng dǐ xī","abbr":"pkdx","explanation":"犹批亢捣虚。比喻抓住敌人的要害乘虚而入。亦指有缝便钻，从中取利。","source":{"text":"弱於才而腐於力，不能奔走乘机抵巇，以要权利。","book":"汉·杨雄《法言·重黎》：“巇可抵乎？” 唐·韩愈《释言》"}},{"id":20711,"word":"批亢捣虚","pinyin":"pī gàng dǎo xū","abbr":"pkdx","explanation":"批：用手击；亢：咽喉，比喻要害；捣：攻击；虚：空虚。比喻抓住敌人的要害乘虚而入。","source":{"text":"救斗者不博戟，批亢捣虚，形格势禁，则自为解耳。","book":"《史记·孙子吴起列传》"},"example":{"text":"故必有～，形格势禁之道。","book":"宋·陈亮《中兴论》"},"similar":["批吭捣虚"],"usage":"作谓语、定语；指抓住要害而打击其空虚","story":["战国时期，兵法大师鬼谷子的弟子魏国人庞涓没有学成就成为魏惠王的将军，他把师弟孙膑骗到魏都大梁，残忍地弄断他的双腿。孙膑回齐后成为齐威王的国师。他两次使用批亢捣虚的方法，迫使魏军大败及至庞涓自杀，解救了赵国与韩国"]},{"id":20712,"word":"批其逆鳞","pinyin":"pī qí nì lín","abbr":"pqnl","explanation":"批：触；逆鳞：倒生的鳞。触犯了龙喉下的逆鳞。比喻臣下直言劝谏，触犯君主。也比喻弱国侵犯强国。","source":{"text":"秦地遍天下，威胁韩、魏、赵氏，则易水以北，未有所定也。奈何以见陵之怨，欲批其逆鳞哉?","book":"《战国策·燕策三》"}},{"id":20713,"word":"批吭捣虚","pinyin":"pī háng dǎo xū","abbr":"phdx","explanation":"比喻抓住敌人的要害乘虚而入。亦指有缝便钻，从中取利。同“批亢捣虚”。","source":{"text":"凡为元帅须要机谋，批吭捣虚，为头说谎，调皮无赛。","book":"元·郑光祖《三战吕布》第一折"},"example":{"text":"自家姓炒名皮，字蓼花，乃油嘴出身，平昔帮闲钻懒，～。","book":"明·无名氏《石榴园》第一折"},"similar":["批亢捣虚"],"usage":"作谓语、定语；指抓住要害而打击其空虚"},{"id":20714,"word":"批毛求疵","pinyin":"pī máo qiú cī","abbr":"pmqc","explanation":"犹言吹毛求疵。比喻故意挑剔别人的缺点，寻找差错。","source":{"text":"虽外示谨厚，而情深刻薄，每受制鞠狱，必批毛求疵，陷于重辟。","book":"《旧唐书·崔元综传》"},"similar":["吹毛求疵"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":20715,"word":"批砉导窾","pinyin":"pī huā dǎo táo","abbr":"phdk","explanation":"犹言批郄导窾。比喻善于从关键处入手，顺利解决问题。"},{"id":20716,"word":"批砉导竨","pinyin":"pī huā dǎo táo","abbr":"phdt","explanation":"犹言批郄导竨。比喻善于从关键处入手，顺利解决问题。"},{"id":20717,"word":"批红判白","pinyin":"pī hóng pàn bái","abbr":"phpb","explanation":"批：削；判：分开；红、白：指花卉。嫁接花木。","source":{"text":"今洛阳良工巧匠，批红判白，接以他木，与造化争妙，故岁岁益奇。","book":"宋·李格非《洛阳名园记·李氏仁丰园》"},"usage":"作谓语；指嫁接花木"},{"id":20718,"word":"批逆鳞","pinyin":"pī nì lín","abbr":"pnl","explanation":"批：触；逆鳞：倒生的鳞。触犯了龙喉下的逆鳞。比喻臣下直言劝谏，触犯君主。也比喻弱国侵犯强国。","source":{"text":"夫龙之为虫也，柔可狎而骑也；然其喉下有逆鳞径尺，若人有婴之者，则必杀人。人主亦有逆鳞，说者能无婴人主之逆鳞，则几矣。","book":"《韩非子·说难》"},"example":{"text":"献纳亲会～，忽以谗言弃于野。","book":"明·唐寅《浔阳送别图》诗"},"similar":["批逆龙鳞"],"usage":"作谓语、宾语；用于书面语"},{"id":20719,"word":"批逆龙鳞","pinyin":"pī nì lóng lín","abbr":"pnll","explanation":"传说龙喉下有逆鳞径尺，有触之必怒而杀人。常以喻弱者触怒强者或臣下触犯君主等。","source":{"text":"优念亮脱身虎口，久矣讳穷；批逆龙鳞，期于合理，庶几一割之有用，安能百炼而愈刚！","book":"宋·陈亮《谢张侍御启》"},"similar":["批逆鳞"],"usage":"作谓语、宾语；用于书面语"},{"id":20720,"word":"批郤导窾","pinyin":"pī xì dǎo kuǎn","abbr":"pxdk","explanation":"批：击；郤：空隙；窾：骨节空处。从骨头接合处批开，无骨处则就势分解。比喻善于从关键处入手，顺利解决问题。","source":{"text":"依乎天理，批大郤，导大窾，因其固然。","book":"《庄子·养生主》"},"example":{"text":"何谓“大猷”？～，迎刃而解，棋局一着胜人千百者是也。","book":"清·魏源《治篇》七"},"usage":"作谓语；指人解决问题"},{"id":20721,"word":"批鄐导竨","pinyin":"pī xì dǎo kuǎn","abbr":"pxdk","explanation":"批击；鄐空隙；竨骨节空处。从骨头接合处批开，无骨处则就势分解。比喻善于从关键处入手，顺利解决问题。","source":{"text":"批大鄐，导大竨。","book":"《庄子·养生主》"}},{"id":20722,"word":"批隙导窾","pinyin":"pī xì dǎo yín","abbr":"pxdk","explanation":"比喻善于从关键处入手，顺利解决问题。同“批郤导窾”。","source":{"text":"批大隙，导大窾。","book":"战国·宋·庄周《庄子·养生主》"},"example":{"text":"何谓‘大猷’？～，迎刃而解，棋局一著胜人千百者是也。","book":"清·魏源《默觚下·治篇》"},"usage":"作谓语、定语；用于比喻句"},{"id":20723,"word":"批隙导竨","pinyin":"pī xì dǎo yín","abbr":"pxdy","explanation":"比喻善于从关键处入手，顺利解决问题。同批鄐导竨”。"},{"id":20724,"word":"批风抹月","pinyin":"pī fēng mò yuè","abbr":"pfmy","explanation":"犹言吟风弄月。指诗人以风花雪月为吟诵的题材以状其闲适。","source":{"text":"贫家何以娱客，但知抹月批风。","book":"宋·苏轼《和何长官六言次韵》其四"},"example":{"text":"烟霞状元，江湖醉仙，笑谈便是编修院。留连，～四十年。","book":"元·乔孟符《正官绿幺遍·自述》"},"similar":["吟风弄月"],"usage":"作谓语、宾语；用于文人"},{"id":20725,"word":"批鳞请剑","pinyin":"pī lín qǐng jiàn","abbr":"plqj","explanation":"指敢于直言犯上请斩巨奸。","source":{"text":"汉成帝时，槐里令朱云以“今朝廷大臣上不能匡主，下亡以益民，皆尸位素餐”，上书请赐尚方斩马剑斩佞臣安昌侯张禹（成帝师）以厉其馀。成帝大怒，曰：“小臣居下讪上，廷辱师傅，罪死不赦。”事见《汉书·朱云传》。"},"example":{"text":"吾平生志在～，以忠鲠南迁。","book":"宋·罗大经《鹤林玉露》卷五"},"usage":"作宾语、定语；用于书面语","story":["汉成帝时期，成帝的老师安昌侯张禹恃宠而骄，横行霸道，朝中大臣们敢怒不敢言。槐黔朱云上书汉成帝要求赐尚方宝剑斩佞臣张禹以正朝纲。成帝大怒说：“小臣居下讪上，廷辱师傅，罪死不赦。”"]},{"id":20726,"word":"扺掌而谈","pinyin":"zhǐ zhǎng ér tán","abbr":"zzet","explanation":"指谈得很融洽。注意‘扺’不作‘抵’，也不念di。","source":{"text":"见说赵王于华屋之下，扺掌而谈。","book":"《战国策·秦策一》"},"example":{"text":"善言论者～，问地球一切事。","book":"鲁迅《月界旅行》第十三回"}},{"id":20727,"word":"扼亢拊背","pinyin":"è kàng fǔ bèi","abbr":"ekfb","explanation":"扼：用力掐着。亢：通“吭”，喉咙。拊：击，拍击。掐住喉咙，捺住背脊。比喻控制要害，制敌于死命。同“扼吭拊背”、“扼肮拊背”。"},{"id":20728,"word":"扼吭夺食","pinyin":"è háng duó shí","abbr":"ehds","explanation":"扼：用力掐着；吭：咽喉。扼住喉咙，夺走吃的东西。比喻使人处于绝境。","source":{"text":"乃欲驱疲民以供大疫，废耕耨而荒田亩，何异扼其吭而夺其食，以速其毙乎？","book":"《元史·陈祖仁传》"},"example":{"text":"他通常采用～的处理办法。"},"usage":"作宾语、定语；比喻使人陷于绝境"},{"id":20729,"word":"扼吭拊背","pinyin":"è háng fǔ bèi","abbr":"ehfb","explanation":"扼：用力掐着；吭：咽喉；拊：拍击。掐着喉咙，捺住脊背。比喻控制要害，制敌死命。","source":{"text":"夫与人斗，不扼其吭拊其背，未能全其胜也。","book":"《史记·刘敬叔孙通列传》"},"example":{"text":"贼虏日夜谋据襄阳，为～之计。","book":"宋·魏了翁《奏缴别人杰书施行复襄事宜》"},"similar":["扼喉抚背"],"usage":"作谓语、定语；比喻控制要害"},{"id":20730,"word":"扼喉抚背","pinyin":"è hóu fǔ bèi","abbr":"ehfb","explanation":"抚：按，捺。掐住咽喉，按住脊背。比喻控制敌方的要害，使其丧失反抗的能力。","source":{"text":"西南当扼喉之势，东北承抚背之机，首尾交侵。","book":"南朝·陈·徐陵《为贞阳侯重与王太尉书》"},"example":{"text":"江都寿春之域，～之兵，飞龙赤马，绝水南越。","book":"隋·卢思道《为隋檄陈文》"},"similar":["扼吭抚背"],"usage":"作谓语、定语；指控制要害"},{"id":20731,"word":"扼腕兴嗟","pinyin":"è wàn xīng jiē","abbr":"ewxj","explanation":"扼腕：用手握腕；嗟：感叹。用手握腕，长声叹息。形容情绪激动发出叹息的神态。","source":{"text":"于是吏民俱困，都累得扼腕兴嗟，愁眉百结了。","book":"蔡东藩《民国通俗演义》第101回"},"similar":["扼腕长叹"],"usage":"作谓语、状语、定语；用于人的神态"},{"id":20732,"word":"扼腕叹息","pinyin":"è wǎn tàn xī","abbr":"ewtx","explanation":"扼：握住，抓住。握着手腕发出叹息的声音。形容十分激动地发出长叹的情态。","source":{"text":"臣所以泣血宵呤扼腕长叹者也。","book":"晋·王隐《晋书·刘锟传》"},"example":{"text":"他这么快就离开了，真令人～。"},"similar":["扼腕长叹"],"usage":"作谓语、定语；用于惋惜"},{"id":20733,"word":"扼腕抵掌","pinyin":"è wàn dǐ zhǎng","abbr":"ewdz","explanation":"用手握腕，击着手掌。表示很激动，振奋的神态。","source":{"text":"剧谈戏论，扼腕抵掌。","book":"晋·左思《蜀都赋》"}},{"id":20734,"word":"扼腕长叹","pinyin":"è wàn cháng tàn","abbr":"ewct","explanation":"用手握腕，长声叹息。形容情绪激动的神态。","source":{"text":"臣所以泣血宵吟，扼腕长叹者也。","book":"《晋书·刘琨传》"},"example":{"text":"他只好～了。"},"similar":["扼腕叹息"],"usage":"作定语、状语；用于惋惜"},{"id":20735,"word":"扼臂啮指","pinyin":"è bì niè zhǐ","abbr":"ebnz","explanation":"扼：用力掐；啮：咬。掐胳膊，咬手指。形容母子心灵相互感应。","source":{"text":"曾子左臂立痛，即驰至问母：‘臂何故痛？’母曰：‘今者客来欲去，吾扼臂以呼汝耳。’","book":"东汉·王充《论衡·感虚》"},"example":{"text":"人以是知～，古孝子非虚语也。","book":"清·钱谦益《故福建建宁府……嘉县柯君墓志铭》"},"usage":"作宾语、定语；指母子心灵感应","story":["战国时期，曾子一个人他外出打柴，家里来了客人找他，曾母左等右盼不见他回来，客人急着要回去。曾母就使劲扼住自己的手臂直到疼痛难忍为止，曾子立即感到手臂痛，立即丢掉柴禾跑回家问母亲有什么事，母亲告诉他有客人在找他"]},{"id":20736,"word":"扼襟控咽","pinyin":"è jīn kòng yān","abbr":"ejky","explanation":"比喻据守险要之地。","source":{"text":"扼襟控咽，屏藩表里。名城池为金汤，役诸侯为奴隶。","book":"宋·周邦彦《汴都赋》"},"example":{"text":"控制南京就有～的作用。"},"similar":["扼喉抚背"],"usage":"作宾语、定语；指控制要害"},{"id":20737,"word":"扼襟控烟","pinyin":"è jīn kòng yān","abbr":"ejky","explanation":"襟：衣服胸前的部分。抓住胸部，控制咽喉。比喻控制要害的地方。","source":{"text":"扼襟控咽，屏藩表里，名城池为金汤，役诸侯为奴隶。","book":"宋·周邦彦《汴都赋》"}},{"id":20738,"word":"承上启下","pinyin":"chéng shàng qǐ xià","abbr":"csqx","explanation":"承接上面的，引起下面的。多用在写文章方面。","source":{"text":"思量头如何起，尾如何结，方始选韵，而后述曲，最是过片不要断了曲意，须要承上启下。","book":"宋·张炎《词源·制曲》"},"example":{"text":"这两段文字中应有几句～的话。"},"similar":["承前启后","继往开来","生上启下"],"usage":"作谓语、定语；用于书面语"},{"id":20739,"word":"承上起下","pinyin":"chéng shàng qǐ xià","abbr":"csqx","explanation":"指承接前者，引出后者。","source":{"text":"故，承上起下之辞。","book":"《礼记·曲礼上》“故君子戒慎”唐孔颖达疏"},"example":{"text":"第五章为～之词。","book":"《诗·小雅·常棣》“丧乱既平”清·陈奂传疏"},"similar":["承上启下"],"usage":"作谓语、定语；用于书面语"},{"id":20740,"word":"承先启后","pinyin":"chéng xiān qǐ hòu","abbr":"cxqh","explanation":"继承前代的，启发后代的。","source":{"text":"公承前草创，启后规模，此之功德，垂之永久。","book":"明·朱国祯《涌幢小品·曾有菴赠文》"},"example":{"text":"文中这句话起到了～的作用。"},"similar":["承前启后","承上启下"],"usage":"作定语；用于书面语"},{"id":20741,"word":"承前启后","pinyin":"chéng qián qǐ hòu","abbr":"cqqh","explanation":"承：承接；启：开创。承接前面的，开创后来的。指继承前人事业，为后人开辟道路。","source":{"text":"公承前草创，启后规模，此之功德，垂之永久。","book":"明·朱国祯《涌幢小品·曾有菴赠文》"},"example":{"text":"至于青年之急待攻击，实较老年为尤甚，因为他们是～的桥梁，国家的绝续，全在他们肩上的。","book":"鲁迅《两地书》一一"},"similar":["承上启下","继往开来"],"opposite":["空前绝后"],"usage":"作谓语、定语；指连接前后的桥梁作用"},{"id":20742,"word":"承天之佑","pinyin":"chéng tiān zhī yòu","abbr":"ctzy","explanation":"承：受；佑：保佑。蒙受老天的保佑。","source":{"text":"《周易·大有》：“自天佑之，吉无不利。"},"example":{"text":"迫窜良将，夷其肢股。屡蹶复兴，～。","book":"章炳麟《民国五豪赞》"}},{"id":20743,"word":"承天之祐","pinyin":"chéng tiān zhī yòu","abbr":"ctzy","explanation":"承：受；祐：保佑。蒙受老天的保祐。","source":{"text":"自天祐之，吉无不利。","book":"《周易·大有》"},"example":{"text":"迫窜良将，夷其肢股。屡蹶复兴，～。","book":"章炳麟《民国五豪赞》"},"similar":["承天之佑"],"usage":"作谓语；用于书面语"},{"id":20744,"word":"承天之祜","pinyin":"chéng tiān zhī hù","abbr":"ctzh","explanation":"承：蒙受；祜：福。蒙受老天的赐福。","source":{"text":"受天之祜。","book":"《诗经·小雅·信南山》"},"example":{"text":"迫窜良将，夷其肢股，屡蹶复兴，～。","book":"章炳麟《民国五豪赞》"},"similar":["承天之祐"],"usage":"作谓语；指蒙受老天的保祐"},{"id":20745,"word":"承嬗离合","pinyin":"chéng shàn lí hé","abbr":"cslh","explanation":"继承演变。"},{"id":20746,"word":"承平盛世","pinyin":"chéng píng shèng shì","abbr":"cpss","explanation":"承平：太平。太平、兴盛的时代。","source":{"text":"今累世承平，豪富吏民资数钜万。","book":"东汉·班固《汉书·食货志》"},"example":{"text":"我们都希望有～的局面。"},"similar":["太平盛世"],"opposite":["兵荒马乱","战火纷飞"],"usage":"作宾语、定语；指太平盛世"},{"id":20747,"word":"承星履草","pinyin":"chéng xīng lǚ cǎo","abbr":"cxlc","explanation":"头戴星光，脚踏草地。形容早出晚归辛勤劳作。","source":{"text":"饥寒困瘁，躬执耕穑，承星履草，密勿畴袭。","book":"晋·葛洪《自叙》"},"usage":"作定语、状语；指人的辛劳"},{"id":20748,"word":"承欢献媚","pinyin":"chéng huān xiàn mèi","abbr":"chxm","explanation":"承欢：迎合他人博取欢心。以自己的媚态博得别人欢心。","source":{"text":"四围小花，好像承欢献媚，服从那大花的样子。","book":"曾朴《孽海花》第三回"},"usage":"作宾语、定语；用于为人"},{"id":20749,"word":"承欢膝下","pinyin":"chéng huān xī xià","abbr":"chxx","explanation":"承欢：旧指侍奉父母；膝下：子女幼时依于父母膝下，故表示幼年。旧指侍奉父母。","source":{"text":"故亲生之膝下，以养父母曰严。","book":"《孝经·圣治》"},"example":{"text":"冀尘迹丘中，绝汉机于俗纲，～，驭潘舆于家园。","book":"唐·骆宾王《上廉使启》"},"similar":["膝下承欢"],"usage":"作谓语、定语；指侍奉父母"},{"id":20750,"word":"承颜候色","pinyin":"chéng yán hòu sè","abbr":"cyhs","explanation":"看人脸色行事，不敢有不同意见。","source":{"text":"畏避势家，承颜侯色，不能有所执据。","book":"《魏书·寇治传》"},"example":{"text":"佞谄之论，～，因其所好，以悦导之。","book":"唐·魏征《陈书后主纪论》"},"similar":["阿谀奉承"],"usage":"作谓语、定语；指人看人脸色行事，不敢发表"},{"id":20751,"word":"承颜顺旨","pinyin":"chéng yán shùn zhǐ","abbr":"cysz","explanation":"迎合颜色，顺从意旨。","source":{"text":"蕃体气高亮，不能承颜顺旨。","book":"晋·陈寿《三国志·吴志·王蕃传》"},"example":{"text":"蜀孟熙贩果实养父母，～，温凊定省，出告反面。","book":"《儆诫录》"},"similar":["承风希旨"],"usage":"作谓语、宾语、定语；用于为人"},{"id":20752,"word":"承风希旨","pinyin":"chéng fēng xī zhǐ","abbr":"cfxz","explanation":"承：迎合；希：揣摩；风：风向；旨：意旨。指关于揣摩迎合上司的意向。","source":{"text":"九卿以下，咸承风指。","book":"东汉·班固《汉书·薛宣传》"},"example":{"text":"那时的长安县姓苏，名又简，是个榜下即用，为人却甚狡猾，专门～。","book":"清·李宝嘉《文明小史》第60回"},"similar":["希旨承颜"],"usage":"作谓语、定语；指讨好人"},{"id":20753,"word":"抃风儛润","pinyin":"biàn fēng wǔ rùn","abbr":"bfwr","explanation":"抃：鼓掌；儛：通“舞”，跳舞；润：雨水。指欢舞在和风时雨中。指庆幸沾受恩惠","source":{"text":"直山渊藏引，用不遐弃，故得抃风儛润，凭附弥年。","book":"《宋书·孔頤传》"},"similar":["抃风舞润"],"usage":"作谓语；指庆幸沾受恩惠"},{"id":20754,"word":"抃风舞润","pinyin":"biàn fēng wǔ rùn","abbr":"bfwr","explanation":"抃：鼓掌；润：雨水。如燕在风中飞翔，象商羊在雨中起舞。原指同类的事物相互感应。后比喻意气相合。","source":{"text":"觊逊业之举，无闻于乡部；惰游之贬，有编于疲农。直山渊藏引，用不遐弃，故得抃风舞润，凭附弥年。","book":"《宋书·孔觊传》"},"similar":["抃风儛润"],"usage":"作谓语；指庆幸沾受恩惠"},{"id":20755,"word":"抅奇抉异","pinyin":"jū qí jué yì","abbr":"jqjy","explanation":"抉：排出，挖出。指搜求奇异的文句。","source":{"text":"先生之作，遇景入咏，不抅奇抉异令龌龊束人口者，涵涵然有千霄之兴，若公输氏当巧而不巧者也。","book":"唐·皮日休《郢卅孟亭记》"},"similar":["拘奇抉异"],"usage":"作谓语、定语；用于写作等"},{"id":20756,"word":"抉奥阐幽","pinyin":"jué ào chǎn yōu","abbr":"jacy","explanation":"剖析奥秘，阐发隐微。","source":{"text":"大而经、史、子、集，以及医、卜、词曲之类，其评论抉奥阐幽，词明理正。","book":"清·江藩《汉学师承记·纪昀》"},"usage":"作谓语；用于书面语"},{"id":20757,"word":"抉瑕掩瑜","pinyin":"jué xiá yǎn yú","abbr":"jxyy","explanation":"瑕：玉上的斑点；瑜：玉石的光彩。故意挑剔玉上的斑点，埋没它的光彩。比喻刻意挑剔别人的缺点和短处，而抹煞其优点和长处。","source":{"text":"今太常议荆南之政详矣……乃抉瑕掩瑜之论，非中适之言也。","book":"唐·严郢《驳议吕諲》"},"similar":["吹毛求疵","全盘否定"],"usage":"作宾语、定语；指吹毛求疵"},{"id":20758,"word":"抉瑕摘衅","pinyin":"jué xiá zhāi xìn","abbr":"jxzx","explanation":"指刻意挑剔缺点毛病。","source":{"text":"抉瑕摘衅，掩其宏美。","book":"《东观汉记·陈元传》"},"similar":["抉瑕擿衅"],"usage":"作宾语、定语；用于书面语"},{"id":20759,"word":"抉瑕擿衅","pinyin":"jué xiá tī xìn","abbr":"jxtx","explanation":"抉：挑出；瑕：玉上的斑点，比喻缺点、毛病；擿：揭发；衅：嫌隙，破绽。形容寻求缺点和破绽，故意挑剔。","source":{"text":"遗脱纤微，指为大尤；抉瑕擿衅，掩其弘美；所谓‘小辩破言，小言破道’者也。","book":"南朝·宋·范晔《后汉书·陈元传》"},"similar":["抉瑕摘衅"],"usage":"作宾语、定语；用于书面语"},{"id":20760,"word":"抉目东门","pinyin":"jué mù dōng mén","abbr":"jmdm","explanation":"抉：剔出；目：眼睛。指忠臣被谗诛杀。同“抉目吴门”。","source":{"text":"抉吾眼置之吴东门，以观越之灭吴也。","book":"西汉·司马迁《史记·吴太伯世家》"},"example":{"text":"忠臣～上，可退越来兵伍。","book":"元·萨都刺《姑苏台怀古》"},"similar":["抉目吴门","抉目胥门","抉目悬门"],"usage":"作谓语、定语；指忠臣被谗诛杀","story":["春秋时期，吴国大夫伍员（字子胥）劝吴王夫差拒绝越国求和。夫差听信谗言，赐伍子胥宝剑一把自尽。伍子胥临死时说：“把我的眼睛挖出放到吴国东城门上，让我看到越国将来消灭吴国。”没过多久，吴国被越国所灭"]},{"id":20761,"word":"抉目吴门","pinyin":"jué mù wú mén","abbr":"jmwm","explanation":"抉：剔出；目：眼睛。指忠臣被谗诛杀。","source":{"text":"抉吾眼置之吴东门，以观越之灭吴也。","book":"西汉·司马迁《史记·吴太伯世家》"},"example":{"text":"鞭尸楚墓生前孝，～死后忠。","book":"明·高启《谒伍相祠》"},"similar":["抉目东门","抉目胥门","抉目悬门"],"usage":"作谓语、定语；指忠臣被谗诛杀","story":["春秋时期，吴国大夫伍员（字子胥）劝吴王夫差拒绝越国求和。夫差听信谗言，赐伍子胥宝剑一把自尽。伍子胥临死时说：“把我的眼睛挖出放到吴国东城门上，让我看到越国将来消灭吴国。”没过多久，吴国被越国所灭"]},{"id":20762,"word":"抉目悬门","pinyin":"jué mù xuán mén","abbr":"jmxm","explanation":"抉：剔出；目：眼睛。指忠臣被谗诛杀。同“抉目吴门”。","source":{"text":"抉吾眼县吴门之上，以观越寇之入灭吴也。","book":"《史记·伍子胥列传》"},"similar":["抉目东门","抉目吴门","抉目胥门"],"usage":"作谓语、定语、宾语；指忠臣被谗诛杀"},{"id":20763,"word":"抉目胥门","pinyin":"jué mù xū mén","abbr":"jmxm","explanation":"抉：剔出；目：眼睛。指忠臣被谗诛杀。同“抉目吴门”。","source":{"text":"挺身大泽呼张楚，抉目胥门看沼吴。","book":"高旭《收辑亡友宁太一遗墨装订成册因题四首以弁其首》"},"similar":["抉目东门","抉目吴门","抉目悬门"],"usage":"作谓语、定语、宾语；指忠臣被谗诛杀"},{"id":20764,"word":"把持不住","pinyin":"bǎ chí bù zhù","abbr":"bcbz","explanation":"把：掌握。指意志比较薄弱，把握或控制不住自己","source":{"text":"陡遇大风，把持不住，飘泊了许久，方才落地。","book":"清·李百川《绿野仙踪》第97回"},"similar":["把持不定"],"usage":"作谓语、定语；指意志薄弱"},{"id":20765,"word":"把持不定","pinyin":"bǎ chí bù dìng","abbr":"bcbd","explanation":"没有明确的主见，游移反复。","source":{"text":"但恐日后把持不定，为异端所惑，一时失足。","book":"《野叟曝言》第二回"},"example":{"text":"他意志薄弱，一遇风浪就～。"},"similar":["把持不住"],"opposite":["控制自如"],"usage":"作谓语、定语；指意志薄弱"},{"id":20766,"word":"把持包办","pinyin":"bǎ chí bāo bàn","abbr":"bcbb","explanation":"揽权专断代替别人办理，不让别人参与。","source":{"text":"揽权专断代替别人办理，不让别人参与。"},"usage":"作谓语、定语、宾语；用于处事"},{"id":20767,"word":"把玩无厌","pinyin":"bǎ wán wǔ yàn","abbr":"bwwy","explanation":"拿着赏玩，不觉厌倦。","source":{"text":"得九月二十日书读之，喜笑把玩无厌。","book":"汉·陈琳《为曹洪与世子书》"},"example":{"text":"这件艺术品刻工精细，花草山石，无不玲珑，真是令人～。"},"similar":["百玩不厌"],"usage":"作谓语；形容物品极具吸引力"},{"id":20768,"word":"把素持斋","pinyin":"bǎ sù chí zhāi","abbr":"bscz","explanation":"把：遵守。斋：斋戒。指信佛者遵守吃素，坚持戒律。","source":{"text":"念佛心把素持斋，不食荤啖柏。","book":"元·无名氏《女姑姑》三折"},"example":{"text":"人人善念看经，个个～。","book":"明·无名氏《万国来朝》第一折"},"similar":["持斋把素"],"usage":"作谓语；指遵守戒律吃斋"},{"id":20769,"word":"把臂入林","pinyin":"bǎ bì rù lín","abbr":"bbrl","explanation":"把：指挽着；林：山林。互挽手臂，表示亲热。旧指相偕归隐。","source":{"text":"谢公（安）道：豫章（谢鲲）若遇七贤必自把臂入林。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"研德、畴三，吴门之两玉树，门下见之，定～。","book":"清·王晫《今世说·品藻》"},"usage":"作谓语；指与朋友一起归隐"},{"id":20770,"word":"把臂徐去","pinyin":"bǎ bì xú qù","abbr":"bbxq","explanation":"互相挽着胳膊慢慢离开。","example":{"text":"欣赏好了满园的风景，老两口～。"}},{"id":20771,"word":"把薪助火","pinyin":"bǎ xīn zhù huǒ","abbr":"bxzh","explanation":"把：握住。拿着柴草助长火势。比喻某种行动作法会增加对方的力量或助长事态的加剧。","source":{"text":"今求军马钱粮，切不可与。如若相助，是把薪助火也。","book":"明·罗贯中《三国演义》第六十二回"},"similar":["抱薪救火"],"usage":"作宾语、定语；指方法错误"},{"id":20772,"word":"把酒持螯","pinyin":"bǎ jiǔ chí áo","abbr":"bjca","explanation":"手持蟹螯饮酒。古人视为人生一大乐事。","source":{"text":"卓尝谓人曰：‘得酒满数百斛船，四时甘味置两头，右手持酒杯，左手持蟹螯，拍浮酒船中，便足了一生矣。’","book":"语出《晋书·毕卓传》"},"example":{"text":"～，问今日、不知何夕。","book":"傅尃《满江红·八月五日联句》词"},"similar":["持螯把酒"],"usage":"作宾语、定语；指饮酒作乐"},{"id":20773,"word":"把饭叫饥","pinyin":"bǎ fàn jiào jī","abbr":"bfjj","explanation":"比喻多此一举。","source":{"text":"所示自是一篇高文，大似把饭叫饥，聊发千里一笑。","book":"宋·苏轼《答程彝仲推官书》"},"example":{"text":"他习惯玩“～”的游戏。"},"similar":["多此一举"],"usage":"作谓语、定语；比喻多此一举"},{"id":20774,"word":"抑塞磊落","pinyin":"yì sè lěi luò","abbr":"ysll","explanation":"形容心地抑郁，有志未伸，为人却胸怀坦白。","source":{"text":"王郎酒酣拔剑斫地歌莫哀，我能拔尔抑塞磊落之奇才。","book":"唐·杜甫《短歌行赠王郎司直》"},"example":{"text":"即空观主人者，其人奇，其文奇，其遇亦奇，因取其～之才，出绪余以为传奇。","book":"明·睡乡居士《〈二刻拍案惊奇〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":20775,"word":"抑强扶弱","pinyin":"yì qiáng fú ruò","abbr":"yqfr","explanation":"抑：压制；扶：帮助。压制强暴，扶助弱小。","source":{"text":"而政在抑强扶弱。","book":"汉·袁康《越绝书·外传本事》：“勾践之时，天子微弱，诸侯皆叛，于是勾践抑强扶弱。”《汉书·刑罚志》"},"example":{"text":"路见不平，拔刀相助，本来是～，互相维持之意。","book":"清·吴趼人《二十年目睹之怪现状》第四十二回"},"similar":["锄强扶弱"],"usage":"作谓语、定语；指帮助弱小"},{"id":20776,"word":"抑恶扬善","pinyin":"yì è yáng shàn","abbr":"yeys","explanation":"压制坏人坏事，表扬好人好事。","source":{"text":"独不闻子产之相郑乎！推贤举能，抑恶扬善，有大略者不问其短，有厚德者不非小疵。","book":"汉·刘向《新序》"},"usage":"作谓语、定语；用于劝诫人"},{"id":20777,"word":"抑扬顿挫","pinyin":"yì yáng dùn cuò","abbr":"yydc","explanation":"抑：降低；扬：升高；顿：停顿；挫：转折。指声音的高低起伏和停顿转折。","source":{"text":"崔蔡冲虚温敏，雅人之属也。衍抑扬顿挫，怨之徒也。岂亦穷达异事，而声为情变乎。","book":"晋·陆机《遂志赋·序》"},"example":{"text":"那～，入耳动心，恍若有几十根弦，几百个指头，在那时弹似的。","book":"清·刘鹗《老残游记》第二回"},"similar":["轻重缓急"],"opposite":["平铺直叙"],"usage":"作定语、状语、补语；形容声音"},{"id":20778,"word":"抑暴扶弱","pinyin":"yì bào fú ruò","abbr":"ybfr","explanation":"抑：压制；扶：帮助。压制强暴，扶助弱小。","source":{"text":"夫法令者，所以抑暴扶弱，欲其难犯而易避也。","book":"《汉书·刑法志》"},"similar":["抑强扶弱"],"usage":"作谓语、定语；指帮助弱小"},{"id":20779,"word":"抑郁不平","pinyin":"yì yù bù píng","abbr":"yybp","explanation":"抑郁：压抑郁闷。内心压抑郁闷，心中愤愤不平。","source":{"text":"～的心情会影响人的健康。"},"example":{"text":"～的心情会影响人的健康"},"similar":["愤愤不平"],"usage":"作谓语、定语；指内心抑郁"},{"id":20780,"word":"抑郁寡欢","pinyin":"yì yù guǎ huān","abbr":"yygh","explanation":"由于心情不舒畅而很少高兴的时候。","source":{"text":"我是个抑郁寡欢的孩子，因为我刚一懂得点事便知道了愁吃愁喝。","book":"老舍《吐了一口气》"},"example":{"text":"他显得有些～的样子。"},"similar":["闷闷不乐"],"opposite":["兴高采烈"],"usage":"作谓语、定语、状语；指不高兴"},{"id":20781,"word":"抓乖卖俏","pinyin":"zhuā guāi mài qiào","abbr":"zgmq","explanation":"耍聪明，卖弄乖巧。","source":{"text":"秋桐正是抓乖卖俏之时，他便悄悄的告诉贾母、王夫人等。","book":"清·曹雪芹《红楼梦》第六十九回"},"similar":["抓乖弄俏"],"usage":"作谓语、定语、状语；用于处事"},{"id":20782,"word":"抓乖弄俏","pinyin":"zhuā guāi nòng qiào","abbr":"zgnq","explanation":"耍聪明，卖弄乖巧。","source":{"text":"沙僧道：‘莫争讲，这里不是那抓乖弄俏之处，且进去！且进去！’","book":"明·吴承恩《西游记》第五十六回"},"similar":["抓乖卖俏"],"usage":"作谓语、定语、状语；用于处事"},{"id":20783,"word":"抓头挖耳","pinyin":"zhuā tóu wā ěr","abbr":"ztwe","explanation":"形容竭力思索。","source":{"text":"谡如见大家都不依，只得抓头挖耳的思索。","book":"清·魏子安《花月痕》第十七回"},"usage":"作定语、状语；用于书面语"},{"id":20784,"word":"抓小辫子","pinyin":"zhuā xiǎo biàn zǐ","abbr":"zxbz","explanation":"比喻抓住缺点作为把柄。","example":{"text":"有些人特别喜欢～。"},"similar":["抓辫子"],"usage":"作谓语、宾语、定语；用于口语"},{"id":20785,"word":"抓尖要强","pinyin":"zhuā jiān yào qiáng","abbr":"zjyq","explanation":"指争强好胜，爱出风头。","source":{"text":"天天打扮的像个西施样子，在人跟前能说惯道，抓尖要强。","book":"清·曹雪芹《红楼梦》第七十四回"},"similar":["争强好胜"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20786,"word":"抓心挠肝","pinyin":"zhuā xīn náo gān","abbr":"zxng","explanation":"比喻十分难受。","source":{"text":"妈妈急得抓心挠肝，想去看看吧，工作脱不开。","book":"关庚寅《“不称心”的姐夫》"},"usage":"作谓语、定语；指心情难受"},{"id":20787,"word":"抓拿骗吃","pinyin":"zhuā ná piàn chī","abbr":"znpc","explanation":"招摇撞骗。","example":{"text":"这家伙是～搞惯了的，得好好教训一下。"},"usage":"作谓语、宾语、定语；用于方言"},{"id":20788,"word":"抓牛鼻子","pinyin":"zhuā niú bí zǐ","abbr":"znbz","explanation":"比喻抓工作能够抓根本、抓重点。","example":{"text":"处理问题时应该～。"},"similar":["牵牛鼻子"],"usage":"作谓语、定语；指抓重点"},{"id":20789,"word":"抓破脸子","pinyin":"zhuā pò liǎn zǐ","abbr":"zplz","explanation":"比喻感情破裂，公开争吵。","source":{"text":"我一直忍住了没跟人抓破脸子，你莫逼得太狠。","book":"张天翼《清明时节》二"},"similar":["抓破面皮","抓破脸皮"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20790,"word":"抓破脸皮","pinyin":"zhuā pò liǎn pí","abbr":"zplp","explanation":"比喻感情破裂，公开争吵。","source":{"text":"虽说娘儿们打起仗不用机关枪，然而动不动就抓破脸皮也就不得了。","book":"鲁迅《集外集拾遗补编·娘儿们也不行》"},"example":{"text":"他们已经～干起来了。"},"similar":["抓破脸子"],"usage":"作谓语、状语；指公开吵架"},{"id":20791,"word":"抓破面皮","pinyin":"zhuā pò miàn pí","abbr":"zpmp","explanation":"比喻感情破裂，公开争吵。","source":{"text":"我忍了这么些日子了，他一点看不出来。我知道不抓破面皮的跟他说，他要命也不明白我们的事情，非说不可了！","book":"老舍《二马》第五段二"},"similar":["抓破脸子","抓破脸皮"],"usage":"作谓语、定语、状语；用于处事"},{"id":20792,"word":"抓纲带目","pinyin":"zhuā gāng dài mù","abbr":"zgdm","explanation":"纲：网的总绳，引申为事物的关健环节；目：网眼，引申为次要部分。比喻办事情、做工作的时候要抓住关健环节带动一般","example":{"text":"做事要～，不能眉毛胡子一把抓"},"usage":"作宾语、定语；用于书面语"},{"id":20793,"word":"抓耳挠腮","pinyin":"zhuā ěr náo sāi","abbr":"zens","explanation":"挠：搔。抓抓耳朵，搔搔肋帮子。形容心里焦急而无法可想的样子。","source":{"text":"大郎听罢，气得抓耳挠腮，没有是处。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"example":{"text":"孙悟空在旁闻讲，喜得他～，眉花眼笑。","book":"明·吴承恩《西游记》第二回"},"similar":["搓手顿脚","心急火燎","无可如何"],"opposite":["镇定自若"],"usage":"作谓语、定语；用于人焦急、生气、心乱等"},{"id":20794,"word":"抓耳搔腮","pinyin":"zhuā ěr sāo sāi","abbr":"zess","explanation":"形容焦急、苦闷，生气时想不出办法的样子。也形容高兴得不知怎么办才好的样子。","source":{"text":"多九公道：‘那送礼人说：国舅因今日王妃进宫，送这礼物，预备王妃赏赐宫人。岂非送给林兄么？’唐敖听了，只急的抓耳搔腮。","book":"清·李汝珍《镜花缘》第三十五回"},"example":{"text":"饶鸿生那里经见过这种境界？直喜得他～。","book":"清·李宝嘉《文明小史》第五十一回"},"similar":["抓耳挠腮","抓腮挖耳"],"usage":"作谓语、定语；用于人焦急、生气、心乱等"},{"id":20795,"word":"抓腮挖耳","pinyin":"zhuā sāi wā ěr","abbr":"zswe","explanation":"形容心里焦急而无法可想的样子，也形容高兴得不知怎么办为好","source":{"text":"大家喝了一会闷酒，抓腮挖耳地想不出好主意。","book":"茅盾《林家铺子》"},"similar":["抓耳挠腮","抓耳搔腮","爬耳搔腮"],"usage":"作谓语、定语、宾语、状语；用于处事"},{"id":20796,"word":"抔土巨壑","pinyin":"póu tǔ jù hè","abbr":"ptjh","explanation":"抔土：一掬土，形容很少。一抔土填不满巨大的深沟。形容得少失多，两者悬殊。","source":{"text":"得损不相偿，抔土填巨壑。","book":"金·元好问《学东坡移居》诗"},"usage":"作宾语、定语；指悬殊很大"},{"id":20797,"word":"抔土未干","pinyin":"póu tǔ wèi gān","abbr":"ptwg","explanation":"抔：手捧；抔土：一捧土，这里指陵墓。陵墓上的土还没有干。比喻死去不久。","source":{"text":"一抔之土未干，六尺之孤何托？","book":"唐·骆宾王《代李敬业传檄天下文》"}},{"id":20798,"word":"投之豺虎","pinyin":"tóu zhī chái hǔ","abbr":"tzch","explanation":"投：扔。指将坏人投饲豺虎。表示深恶痛绝。","source":{"text":"要不能无遗憾于死生，安得取而投之豺虎！","book":"宋·陈亮《寄何茂恭文》"},"similar":["投畀豺虎"],"usage":"作谓语；形容人民群众对坏人"},{"id":20799,"word":"投井下石","pinyin":"tóu jǐng xià shí","abbr":"tjxs","explanation":"看见人要掉进陷井里，不伸手救他，反而推他下去，又扔下石头。比喻乘人有危难时加以陷害。","source":{"text":"一旦临小利害，仅如毛发比，反眼若不相识；落陷阱，不一引手救，反挤之，又下石焉者，皆是也。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"草野朋友，没有什么政治的约束，平时追逐酒肉，事情一来，就～。","book":"梁斌《播火记》一六"},"similar":["落井下石","投石下井"],"usage":"作谓语、定语、宾语；指趁机害人"},{"id":20800,"word":"投亲靠友","pinyin":"tóu qīn kào yǒu","abbr":"tqky","explanation":"投、靠：前去依靠别人生活。指无法独立谋生而前去依靠亲友生活。","source":{"text":"或者做个小本买卖，或者置几亩地，以后再别求亲靠友的。","book":"清·曹雪芹《红楼梦》第四十二回"},"example":{"text":"海嫂，您别着急，～找个地儿先住下来，慢慢儿地等着，您家大哥和孩子兴许能有个信儿……”","book":"霍达《穆斯林的葬礼》第七章"}},{"id":20801,"word":"投传而去","pinyin":"tóu zhuàn ér qù","abbr":"tzeq","explanation":"传：符信。指弃官而去。","source":{"text":"以谏争不合，投传而去。","book":"《后汉书·陈蕃传》"},"example":{"text":"毅曰：“既能攫兽，又能杀鼠，何损于犬！”～。","book":"《晋书·刘毅传》"},"similar":["挂冠归隐"],"usage":"作谓语；用于书面语"},{"id":20802,"word":"投其所好","pinyin":"tóu qí suǒ hào","abbr":"tqsh","explanation":"投：迎合；其：代词，他，他的；好：爱好。迎合别人的喜好。","source":{"text":"是故非以其所好笼之而可得者，无有也。","book":"《庄子·庚桑楚》"},"example":{"text":"今王志在报吴，必先～，然后得制其命。","book":"明·冯梦龙《东周列国志》第八十回"},"similar":["曲意逢迎","善解人意","曲意奉迎"],"opposite":["不卑不亢"],"usage":"作谓语、宾语、定语；指迎合别人"},{"id":20803,"word":"投刃皆虚","pinyin":"tóu rèn jiē xū","abbr":"trjx","explanation":"比喻处理事务得心应手。","source":{"text":"《庄子·养生主》谓庖丁解牛，三年后所见皆非全牛，只见其骨节皆空虚，“彼节者有闲，而刀刃者无厚，以无厚入有闲，恢恢然其于游刃必有余地矣”。"},"similar":["目无全牛","游刃有余"],"usage":"作宾语、定语；用于比喻句"},{"id":20804,"word":"投卵击石","pinyin":"tóu luǎn jī shí","abbr":"tljs","explanation":"比喻不自量力，自取失败。","source":{"text":"所谓以羊将狼，投卵击石，幸而不用，何过望哉！","book":"宋·孙光宪《北梦琐言》第14卷"},"similar":["以卵击石"],"usage":"作宾语、定语；用于处事"},{"id":20805,"word":"投壶电笑","pinyin":"tóu hú diàn xiào","abbr":"thdx","explanation":"后为闪电不雨之典。","source":{"text":"言笑者，天口流火照灼，今天不下雨而有电光是天笑也。","book":"《神异经·东荒经》：“东荒山中有大石室，东王公居焉……恒与一玉女投壶，每投千二百矫，设有入不出者，……矫出而脱悮不接者，天为之笑。”张华注"},"example":{"text":"白炎《秋夜与匪石联句》：“花雨不散生心台，～颜为开。”"},"usage":"作宾语、定语；用于书面语"},{"id":20806,"word":"投山窜海","pinyin":"tóu shān cuàn hǎi","abbr":"tsch","explanation":"山、海，荒凉边远之地。指有罪而被放逐到荒凉边远的地区。","source":{"text":"若使事得其实，罪当其身，则将浴兰沐芳，自屏于烹鲜之地，惟君侯死生！不然，投山窜海，转死沟壑，岂能明目张胆，托书自陈耶？","book":"唐·李白《上安州裴长史书》"},"usage":"作宾语、定语；用于书面语"},{"id":20807,"word":"投怀送抱","pinyin":"tóu huái sòng bào","abbr":"thsb","explanation":"指投入别人的怀抱以博取欢心。借指投靠。","source":{"text":"凡是富春江上‘江山船’中投怀送抱的船娘，一上岸都以阿狗嫂为居停。","book":"高阳《胡雪岩全传·红顶商人》"},"usage":"作谓语、定语、宾语；多用于女性"},{"id":20808,"word":"投戈讲艺","pinyin":"tóu gē jiǎng yì","abbr":"tgjy","explanation":"指在军中仍不废学。后亦泛谓偃武修文。","source":{"text":"东西诛战，不遑启处，犹然投戈讲艺，息马论道。","book":"汉·樊准《上疏请兴儒学》"},"example":{"text":"文舞九成，终于垂衣拱手，无为而治；武舞九成，终于偃武修文，～。","book":"《宋史·乐志四》"},"usage":"作宾语、得意；用于书面语"},{"id":20809,"word":"投木报琼","pinyin":"tóu mù bào qióng","abbr":"tmbq","explanation":"木：木瓜；琼：美玉。原指男女恋爱中互赠礼物。后引申为对别人深厚情谊予以酬报。","source":{"text":"投我以木瓜，报之以琼瑶。匪报也，永以为好也。","book":"《诗经·卫风·木瓜》"},"example":{"text":"今苏屈居益部，公坐庙堂，～，义将安在？（宋·尤袤《全唐诗话·张说》）"},"similar":["投瓜报玉"],"usage":"作宾语、定语；用于交往等"},{"id":20810,"word":"投机之会，间不容穟","pinyin":"tóu jī zhī huì，jiàn bù róng suì","abbr":"tjzhjbrs","explanation":"投机：迎合时机；会：际会，遭遇；间：间隔；穟：同“穗”。机会极其难得，稍放松一点就错过。指行事要抓紧时机，不可延误。","source":{"text":"投机之会，间不容穟，公瑾所以抵龟而决也。","book":"《新唐书·张公谨传赞》"},"example":{"text":"古语有之，～。","book":"宋·杨万里《浯溪赋》"},"usage":"作宾语、定语；用于书面语"},{"id":20811,"word":"投机倒把","pinyin":"tóu jī dǎo bǎ","abbr":"tjdb","explanation":"投机：利用时机钻空子。利用时机，以囤积居奇、买空卖空、掺杂作假、操纵物价等手段牟取暴利。","source":{"text":"投机倒把是不符合政策条文的事情，弯弯绕那家伙能干这样傻事？","book":"浩然《艳阳天》第47章"},"similar":["投机取巧"],"opposite":["生财有道"],"usage":"联合式；作谓语、定语；含贬义"},{"id":20812,"word":"投机取巧","pinyin":"tóu jī qǔ qiǎo","abbr":"tjqq","explanation":"指用不正当的手段谋取私利。也指靠小聪明占便宜。","source":{"text":"［他］虽然谈不上什么进步思想，可也不是一个投机取巧的人。","book":"陈学昭《工作着是美丽的》上卷三六"},"example":{"text":"为了胜利，就可以损人利己，就可以～，难道我们的社会主义的祖国需要这样的人材吗？","book":"任德耀《小足球队》第五幕"},"similar":["投机倒把","看风使舵"],"opposite":["正人君子"],"usage":"作谓语、宾语、定语；指耍小聪明"},{"id":20813,"word":"投杼之惑","pinyin":"tóu zhù zhī huò","abbr":"tzzh","explanation":"投杼：抛下织布的梭子；惑：疑心。比喻没有事实依据的谣言所造成的疑虑。","source":{"text":"当是不逞之人，曲为口端之说，遂怀市虎之疑，乃致投杼之惑耳。","book":"《梁书·侯景传》"},"similar":["投杼之疑"],"usage":"作宾语；指谣言","story":["春秋时期，鲁国有一个与大思想家曾参同名的人在外杀了人，有好事者跑到曾参的母亲那里说：“曾参杀了人。”曾母回答说：“我儿不会杀人。”照常织布。没多久又有人跑来误传曾参杀了人，这时曾母害怕，就投杼逾墙而离开"]},{"id":20814,"word":"投杼之疑","pinyin":"tóu zhù zhī yí","abbr":"tzzy","explanation":"投杼：抛下织布的梭子。比喻没有事实依据的谣言所赞成的疑虑。","source":{"text":"人告曾子母曰：‘曾参杀人。’曾子之母曰：‘吾子不杀人。’织自若。……顷之，一人又告之曰：‘曾参杀人。’其母惧，投杼逾墙而走。","book":"《战国策·秦策二》"},"example":{"text":"向若不令检视，恐常人有～，所以益明之耳。","book":"《周书·唐瑾传》"},"similar":["投杼之惑"],"usage":"作宾语；指谣言","story":["春秋时期，鲁国有一个与大思想家曾参同名的人在外杀了人，有好事者跑到曾参的母亲那里说：“曾参杀了人。”曾母回答说：“我儿不会杀人。”照常织布。没多久又有人跑来误传曾参杀了人，这时曾母害怕，就投杼逾墙而走"]},{"id":20815,"word":"投杼市虎","pinyin":"tóu zhù shì hǔ","abbr":"tzsh","explanation":"投杼：抛下织布的梭子。比喻毫无根据的诽谤之言。","source":{"text":"陛下垂慈狎达，不稍惟疑，遂令负扆席图，蔽于流议，投杼市虎，成于十夫。","book":"南朝·宋·臧质《举兵上表》"},"similar":["三人市虎"],"usage":"作宾语、定语；用于书面语"},{"id":20816,"word":"投杼致惑","pinyin":"tóu zhù zhī huò","abbr":"tzzh","explanation":"比喻一再传播的流言动摇了原有的信念，从而产生疑惑。","source":{"text":"人告曾子母曰：‘曾参杀人。’曾子之母曰：‘吾子不杀人。’织自若。……顷之，一人又告之曰：‘曾参杀人。’其母惧，投杼逾墙而走。","book":"《战国策·秦策二》"},"example":{"text":"至于窃斧生疑，～，正人不得尽其言，大臣莫能与之诤。","book":"唐·魏徵《论时政疏四首》"}},{"id":20817,"word":"投杼逾墙","pinyin":"tóu zhù yú qiáng","abbr":"tzyq","explanation":"投杼：抛下织布的梭子。比喻谣言众多，就连最亲信的人也会动摇坚定的信念。","source":{"text":"人告曾子母曰：‘曾参杀人。’曾子之母曰：‘吾子不杀人。’织自若。……顷之，一人又告之曰：‘曾参杀人。’其母惧，投杼逾墙而走。","book":"《战国策·秦策二》"}},{"id":20818,"word":"投桃之报","pinyin":"tóu táo zhī bào","abbr":"ttzb","explanation":"比喻给对方的报答。","source":{"text":"投我以桃，报之以李。","book":"《诗经·大雅·抑》"},"example":{"text":"王兄如将韵学赐教，小弟定赠美号，以为～。","book":"清·李汝珍《镜花缘》第三十九回"},"usage":"作宾语；用于交往等"},{"id":20819,"word":"投桃报李","pinyin":"tóu táo bào lǐ","abbr":"ttbl","explanation":"意思是他送给我桃儿，我以李子回赠他。比喻友好往来或互相赠送东西。","source":{"text":"投我以桃，报之以李。","book":"《诗经·大雅·抑》"},"example":{"text":"既戒以修德之事，而又言为德而人法之，犹～之必然也。","book":"宋·朱熹《诗集传》卷十八"},"similar":["礼尚往来"],"usage":"作谓语、定语；指互相赠送东西"},{"id":20820,"word":"投梭之拒","pinyin":"tóu suō zhī jù","abbr":"tszj","explanation":"比喻女子抗拒男子的挑逗引诱。同“投梭折齿”。","source":{"text":"君子有援琴之挑，鄙人无投梭之拒。","book":"唐·元稹《莺莺传》"},"example":{"text":"鲁迅《集外集·斯巴达之魂》：“虽遭～，而未能忘情者也。”"},"similar":["投梭折齿"],"usage":"作宾语；用于男女之间"},{"id":20821,"word":"投梭折齿","pinyin":"tóu suō zhé chǐ","abbr":"tszc","explanation":"投梭：用梭子掷人。比喻女子抗拒男子的挑逗引诱。","source":{"text":"邻家高氏女有美色，鲲尝挑之，女投梭，折其两齿。","book":"《晋书·谢鲲传》"},"example":{"text":"若称誉贤女，岂容作此等语，必至～矣。","book":"清·陈澧《东塾读书记·诗》"},"similar":["投梭之拒"],"usage":"作谓语、定语；用于男女之间"},{"id":20822,"word":"投河奔井","pinyin":"tóu hé bèn jǐng","abbr":"thbj","explanation":"投河跳井。指自杀。","source":{"text":"动不动神头鬼脸，投河奔井，拽巷逻街，张舌骗口，花言巧语，指皂为白。","book":"元·武汉臣《玉壶春》第三折"},"example":{"text":"清·如莲居士《薛刚反唐》第45回：“倘若他母女有～之事，我定然将你二人送官究治，决不饶你！”"},"similar":["投河觅井","寻死觅活"],"usage":"作宾语、定语；多用于女性"},{"id":20823,"word":"投河觅井","pinyin":"tóu hé mì jǐng","abbr":"thmj","explanation":"即寻死觅活。闹着要死要活。多指用自杀来吓唬人。","source":{"text":"但是在另一方面，说非看不可，或者没有得看，就要跳脚拍手，以至于投河觅井。","book":"俞平伯《中年》"},"similar":["投河奔井","寻死觅活"],"usage":"作宾语、定语；多用于女性"},{"id":20824,"word":"投瓜报玉","pinyin":"tóu guā bào yù","abbr":"tgby","explanation":"比喻受人微薄之物而以极厚重的的礼物答谢。","source":{"text":"投我以木瓜，报之以琼瑶。匪报也，永以为好也。","book":"《诗经·卫风·木瓜》"},"example":{"text":"王公方才收了，作谢而回，遂为新丰富民。此乃～，施恩报恩，也不在话下。","book":"明·冯梦龙《喻世明言》卷五"},"similar":["投木报琼"],"usage":"作宾语、定语；用于交往等"},{"id":20825,"word":"投畀有北","pinyin":"tóu bì yǒu běi","abbr":"tbyb","explanation":"放逐到北方寒冷荒凉的地方去。","source":{"text":"豺虎不食，投畀有北。","book":"《诗经·小雅·巷伯》"},"example":{"text":"罪恶无状，～，灰灭雨绝，势路无由。","book":"《宋书·天文志一》"}},{"id":20826,"word":"投畀豺虎","pinyin":"tóu bì chái hǔ","abbr":"tbch","explanation":"畀：给与。原指那种好搬弄是非的人，要把他扔出去喂豺狼虎豹。形容人民群众对坏人的愤恨。","source":{"text":"取彼谮人，投畀豺虎。","book":"《诗经·小雅·巷伯》"},"example":{"text":"况且，未能将坏人“～”于生前，当然也只好口诛笔伐之于后身。","book":"鲁迅《华盖集续编·有趣的消息》"},"similar":["投之豺虎"],"usage":"作谓语；形容人民群众对坏人"},{"id":20827,"word":"投石下井","pinyin":"tóu shí xià jǐng","abbr":"tsxj","explanation":"比喻乘人之危加以陷害。同“投阱下石”。","source":{"text":"一旦临小利害，仅如毛发比，反眼若不相识；落陷阱，不一引手救，反挤之，又下石焉者，皆是也。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"璨正欲推倒裴枢等人，乐得～，向全忠处添些坏话，并将损远两相，一并牵入，谓系与枢同党。","book":"蔡东藩《唐史演义》第一百回"},"similar":["投井下石","投阱下石"],"usage":"作宾语、定语；用于处事"},{"id":20828,"word":"投石拔距","pinyin":"tóu shí bá jù","abbr":"tsbj","explanation":"古代军中的习武练功活动。同“投石超距”。","source":{"text":"投石拔距，位于等次。","book":"东汉·班固《汉书·甘延寿传》"},"similar":["投石超距"],"usage":"作宾语、定语；用于书面语"},{"id":20829,"word":"投石超距","pinyin":"tóu shí chāo jù","abbr":"tscj","explanation":"古代军中的习武练功活动。","source":{"text":"王翦使人问军中戏乎？对曰：‘方投石超距。’","book":"西汉·司马迁《史记·白起王翦列传》"},"similar":["投石拔距"],"usage":"作宾语、定语；用于书面语"},{"id":20830,"word":"投石问路","pinyin":"tóu shí wèn lù","abbr":"tswl","explanation":"原指夜间潜入某处前，先投以石子，看看有无反应，借以探测情况。后用以比喻进行试探。","source":{"text":"安徽科技出版社投石问路，去年秋冬该社出版了一本《人体摄影》画册，意外地一炮打响。","book":"《新民晚报》1989.1.5"},"usage":"作谓语、定语；指探路"},{"id":20831,"word":"投笔从戎","pinyin":"tóu bǐ cóng róng","abbr":"tbcr","explanation":"从戎：从军，参军。扔掉笔去参军。指文人从军。","source":{"text":"大丈夫无他志略，犹当效傅介子，张骞立功异域，以取封侯，安能久事笔砚间乎？","book":"《后汉书·班超传》"},"example":{"text":"他象同世交子弟闲话一样，问了问贺人龙的家庭情形，“～”的经过。","book":"姚雪垠《李自成》第二卷第二十二章"},"similar":["弃文就武"],"opposite":["解甲归田"],"usage":"作谓语、定语；指弃文就武","story":["东汉初期，班超因为家贫靠帮官府抄写文件为生，供养老母。但是他觉得这样抄抄写写没什么出息。刚好北方匈奴侵汉，他把笔一扔，毅然报名参军，当了一名军官，在战斗中立了大功。他向朝廷建议与西域各国建交，朝廷派他出使西域"]},{"id":20832,"word":"投笔请缨","pinyin":"tóu bǐ qǐng yīng","abbr":"tbqy","explanation":"指弃文就武，请战擒敌。","source":{"text":"久劳苦，尝缀业投笔叹曰：‘大丈夫无他志略，犹当效傅介子，张骞立功异域，以取封侯，安能久事笔砚间乎？’","book":"《后汉书·班超传》"},"example":{"text":"又当～时，别妇抛雏断藕丝。","book":"郭沫若《归国杂吟》"}},{"id":20833,"word":"投置闲散","pinyin":"tóu zhì xián sǎn","abbr":"tzxs","explanation":"投、置：安放；闲、散：没有事干。指安排在不重要的职位或没有安排工作。","source":{"text":"动而得谤，名亦随之。投闲置散，乃分之宜。","book":"唐·韩愈《进学解》"},"example":{"text":"朝廷灼见奸慝，～。","book":"清·毕沅《续资治通鉴》卷八十九"}},{"id":20834,"word":"投胎夺舍","pinyin":"tóu tāi duó shè","abbr":"ttds","explanation":"夺舍：道家指借新死者的躯体而再生。迷信说法，人死后躯体消亡，其灵魂能转世投胎，也能借尸还魂。","source":{"text":"猴儿今番入我宝瓶之中，再莫想那西方之路！若还能彀拜佛求经，除是转背摇车，再去投胎夺舍是。","book":"明·吴承恩《西游记》第七十五回"},"example":{"text":"四祖禅师见他不凡，收留做了徒弟，与了他三桩宝贝，教他往浊河边～。","book":"明·兰陵笑笑生《金瓶梅词话》第三十九回"}},{"id":20835,"word":"投膏止火","pinyin":"tóu gāo zhǐ huǒ","abbr":"tgzh","explanation":"膏：油。用油去浇灭火，结果火烧得更旺。比喻举措不当，适得其反。","source":{"text":"四方骚然，师旅并兴，如投膏止火，适足速之。","book":"《新五代史·唐书·安重诲》"},"usage":"作宾语、定语；用于比喻句"},{"id":20836,"word":"投袂援戈","pinyin":"tóu mèi yuán gē","abbr":"tmyg","explanation":"表示为国效命。同“投袂荷戈”。","source":{"text":"独夫丑纵，方煽京邑。投袂援戈，克弭多难。","book":"《梁书·武帝纪》"},"similar":["投袂荷戈"],"usage":"作谓语、宾语；用于书面语"},{"id":20837,"word":"投袂而起","pinyin":"tóu mèi ér qǐ","abbr":"tmeq","explanation":"投袂：挥动袖子。形容精神振作，立即行动起来的神态。","source":{"text":"楚子闻之，投袂而起。","book":"《左传·宣公十四年》"},"example":{"text":"犹谓人心思顺，必有～者。","book":"章炳麟《代拟大元帅就职宣言》"},"similar":["奋袂而起"],"usage":"作谓语；形容精神振作立即行动","story":["春秋时期，楚穆王联合陈、郑、蔡三国进攻宋国。宋昭公只好投降。楚穆王神气活现指使宋昭公干这干那。楚穆王死，楚庄王即位，派大夫申舟不必向宋国借道到齐国去办事，宋国杀了申舟，楚庄王气得浑身发抖，投袂而起集结军队攻打宋国"]},{"id":20838,"word":"投袂荷戈","pinyin":"tóu mèi hè gē","abbr":"tmhg","explanation":"振起衣袖，拿起武器。表示为国效命。","source":{"text":"幕府据有上流，实惟分陕，投袂荷戈，志在毕命。","book":"《梁书·元帝纪》"},"example":{"text":"昔帝室倾危，人图问鼎。丞相在匡救，～，故得国祚中兴，群生遂性。","book":"《周书·于谨传》"},"similar":["投袂援戈"],"usage":"作谓语、宾语；用于书面语"},{"id":20839,"word":"投诸四裔","pinyin":"tóu zhū sì yì","abbr":"tzsy","explanation":"比喻流放到边远的地区。","source":{"text":"流四凶族，浑敦、穷奇、寿杌、饕餮，投诸四裔，以御螭魅。","book":"《左传·文公十八年》"},"usage":"作谓语；指流放"},{"id":20840,"word":"投辖留宾","pinyin":"tóu xiá liú bīn","abbr":"txlb","explanation":"辖：车轴的键，去辖则车不能行；投辖：丢掉辖。比喻主人留客的殷勤。","source":{"text":"遵嗜酒，每大饮，宾客满堂，辄关门，取客车辖投井中。虽有急，终不得去。","book":"东汉·班固《汉书·陈遵传》"},"example":{"text":"～的方式现在不值得提倡。"},"similar":["闭门投辖"],"usage":"作谓语、定语；形容人殷勤好客","story":["西汉末年京兆尹陈遵性格豪爽，很有才气，而且非常好客，各地官员和四方豪杰都仰慕他的大名，经常去拜访他。陈遵大摆宴席，陪客人喝酒，为了留住客人，他命令仆人把客人马车上的辖拆下投到井里，客人只好留下来陪他喝酒"]},{"id":20841,"word":"投辖陈遵","pinyin":"tóu xiá chén zūn","abbr":"txcz","explanation":"陈遵：汉代人；投：丢；辖：大车轴头上穿着的小铁棍。陈遵为留住客人，把客人车上的辖取下投到井里去。比喻主人好客。","source":{"text":"陆贾分金将晏喜，陈遵投辖正留宾。","book":"唐·骆宾王《帝京篇》"},"example":{"text":"～无昼夜，吹笙子晋本神仙。","book":"清·赵冀《刘檀桥编修六十寿诗》"}},{"id":20842,"word":"投闲置散","pinyin":"tóu xián zhì sàn","abbr":"txzs","explanation":"投、置：安放；闲、散：没有事干。指安排在不重要的职位或没有安排工作。","source":{"text":"动而得谤，名亦随之。投闲置散，乃分之宜。","book":"唐·韩愈《进学解》"},"usage":"联合式；作谓语；含贬义"},{"id":20843,"word":"投间抵隙","pinyin":"tóu jiān dǐ xì","abbr":"tjdx","explanation":"指伺机钻营。同“投隙抵巇”。","source":{"text":"有乘机应变攻守之法，避实击虚，投间抵隙，兼弱取乱之道，无所不备。","book":"明·刘基《赠奕棋相子先序》"},"example":{"text":"长素乘之，～，其言获用。","book":"章炳麟《驳康有为论革命书》"},"similar":["投隙抵罅"],"usage":"作宾语、定语；用于书面语"},{"id":20844,"word":"投阱下石","pinyin":"tóu jǐng xià shí","abbr":"tjxs","explanation":"比喻乘人之危加以陷害。","source":{"text":"一旦临小利害，落陷穽不一引手救，反挤之又下石焉者，皆是也。","book":"语出唐·韩愈《柳子厚墓志铭》"},"similar":["投井下石","落井下石"],"usage":"作宾语、定语；用于处事"},{"id":20845,"word":"投隙抵巇","pinyin":"tóu xì dǐ xī","abbr":"txdx","explanation":"指伺机钻营。","source":{"text":"怀不能已，时时妄言，投隙抵巇者，因肆无根，虽一时宴谭嬉笑之语，无不闻者！自度祸对无日矣。","book":"宋·李光《与张德远书》"},"similar":["投隙抵罅"],"usage":"作宾语、定语；用于书面语"},{"id":20846,"word":"投隙抵罅","pinyin":"tóu xì dǐ xià","abbr":"txdx","explanation":"指伺机钻营。同“投隙抵巇”。","source":{"text":"盖小人怀倾险之情，挟奸乱之术，居人父子间，投隙抵罅，常幸有其事，以苟一切之富贵。","book":"明·高启《评史·李泌》"},"similar":["投隙抵巇"],"usage":"作宾语、定语；用于书面语"},{"id":20847,"word":"投鞭断流","pinyin":"tóu biān duàn liú","abbr":"tbdl","explanation":"把所有的马鞭投到江里，就能截断水流。比喻人马众多，兵力强大。","source":{"text":"以吾之众旅，投鞭于江，足断其流。","book":"《晋书·苻坚载记》"},"example":{"text":"人民解放军以～之势跨跃长江天险。"},"usage":"作谓语、分句；形容兵众势大","story":["东晋初年，前秦的势力日趋强大，苻坚即位后一心想消灭东晋统一全国，他在朝会上就亲征问题听取大臣们的意见。秘书监朱彤坚决支持，而左仆射权翼说晋有长江天险，不能进攻。苻坚说我们百万雄师把马鞭投到长江里就可以把长江断流"]},{"id":20848,"word":"投鼠之忌","pinyin":"tóu shǔ zhī jì","abbr":"tszj","explanation":"比喻做事有顾忌，不敢放手干。同“投鼠忌器”。","source":{"text":"里谚曰：‘欲投鼠而忌器’，此善谕也。","book":"《汉书·贾谊传》"},"example":{"text":"某即有罪，倘死于寓所，则咎在小生。请少存～。","book":"清·蒲松龄《聊斋志异·梅女》"},"similar":["投鼠忌器"],"usage":"作宾语；用于处事"},{"id":20849,"word":"投鼠忌器","pinyin":"tóu shǔ jì qì","abbr":"tsjq","explanation":"投：用东西去掷；忌：怕，有所顾虑。想用东西打老鼠，又怕打坏了近旁的器物。比喻做事有顾忌，不敢放手干。","source":{"text":"里谚曰：‘欲投鼠而忌器’，此善谕也。","book":"《汉书·贾谊传》"},"example":{"text":"～宝玉瞒赃，判冤决狱平儿行权。","book":"清·曹雪芹《红楼梦》第六十一回"},"similar":["畏首畏尾","瞻前顾后"],"opposite":["无所畏惧","肆无忌惮"],"usage":"作谓语、状语；表示想一件事又有所顾及","story":["西汉时期，汉文帝提倡节俭，发展农业，减免赋税，同时还在全国“举贤良方正，能直言谏者”，贾谊上书汉文帝《论政事疏》，主张对待百姓与王公大臣在犯法时采取不同的惩罚方式，因为王公大臣是皇帝身边人，投鼠忌器，以免伤害皇上"]},{"id":20850,"word":"抖抖瑟瑟","pinyin":"dǒu dǒu sè sè","abbr":"ddss","explanation":"抖抖簌簌，因害怕等而身体颤抖。","example":{"text":"她已经被突如其来的变故吓得～的。"},"similar":["抖抖簌簌","抖抖擞擞"],"usage":"作定语、状语；用于人的神态"},{"id":20851,"word":"抖搂精神","pinyin":"dǒu sǒu jīng shén","abbr":"dljs","explanation":"振作起精神。"},{"id":20852,"word":"抖擞精神","pinyin":"dǒu sǒu jīng shén","abbr":"dsjs","explanation":"振作起精神。","source":{"text":"（僧）问：‘光吞万象从师道，心月孤圆意若何？’师曰：‘抖擞精神着。’","book":"宋·释道原《景德传灯录·杭州光庆寺遇安禅师》"},"example":{"text":"飞～，酣战吕布。连斗五十余合，不分胜负。","book":"明·罗贯中《三国演义》第五回"},"similar":["精神抖擞"],"usage":"作谓语；指振作精神"},{"id":20853,"word":"抗尘走俗","pinyin":"kàng chén zǒu sú","abbr":"kczs","explanation":"抗：举，引伸为表现；尘：尘世；走：跑；俗：世俗。形容为了名利，到处奔走钻营。","source":{"text":"焚芰而制裂茶衣，抗尘容而走俗状。","book":"南朝·齐·孔稚圭《北山移文》"},"example":{"text":"不复有市朝～之状。","book":"宋·赵佶《宣和画谱》卷十"},"usage":"作谓语；形容热中名利而到处奔走钻营"},{"id":20854,"word":"抗心希古","pinyin":"kàng xīn xī gǔ","abbr":"kxxg","explanation":"抗：通“亢”，高尚；抗心：使志向高尚；希：期望。使自己志节高尚，以古代的贤人为榜样。","source":{"text":"抗心希古，任其所尚。","book":"三国·魏·嵇康《幽愤》"},"example":{"text":"少英异，为桐城姚莹所器重。～，落落寡合。","book":"《清史稿·陈克家传》"}},{"id":20855,"word":"抗怀物外","pinyin":"kàng huái wù wài","abbr":"khww","explanation":"抗：通“亢”，高尚；怀：胸怀；物：尘世。胸怀高尚，超越世俗之外。","source":{"text":"以抗怀物外，不为人役，故功名成就，无一可言。","book":"宋·洪迈《容斋随笔·四笔》"},"example":{"text":"那是“～，不为人役”的境界，是“我醉欲眠卿且去，明朝有意抱琴来”的境界。","book":"林清玄《冢中琵琶》"},"usage":"作谓语、定语；用于书面语"},{"id":20856,"word":"抗颜为师","pinyin":"kàng yán wéi shī","abbr":"kyws","explanation":"抗颜：不看别人脸色，态度严正不屈；为师：为人师表。不为他人所制约，不为潮流所左右，这种意志坚定的人可以作为学习的榜样。","source":{"text":"独韩愈奋不顾流俗，犯笑梅，收召后学，作《师说》，因抗颜而为师。","book":"唐·柳宗元《答韦中立论师道书》"},"usage":"作谓语、定语；用于书面语"},{"id":20857,"word":"抗颜高议","pinyin":"kàng yán gāo yì","abbr":"kygy","explanation":"抗颜：不看别人的颜色；高议：发表高明的议论。指态度严正地阐述自己的意见。","source":{"text":"抗颜高议，自以无前。","book":"宋·苏轼《上刘侍读书》"},"usage":"作谓语；用于发表自己的意见"},{"id":20858,"word":"折冲万里","pinyin":"zhé chōng wàn lǐ","abbr":"zcwl","explanation":"折冲：指抵御敌人。指在远离沙场的庙堂上以谋略和智慧克敌制胜。常用以形容高明的外交才干或在外交争端中取得胜利。","source":{"text":"虽不能视事，折冲万里，君先帝大臣，明于治乱，朕所不及，得数问焉，何感而上书归卫将军富平侯印？","book":"《汉书·张汤传》"},"example":{"text":"且陛下所以起复嵩之者，为其～之才与？（清·毕沅《续资治通鉴》卷一百七十一）"}},{"id":20859,"word":"折冲之臣","pinyin":"zhé chōng zhī chén","abbr":"zczc","explanation":"指忠勇之臣。","source":{"text":"刺讥不惮将相，诛恶不避豪强，诛不制之贼，解国家之忧，功著职修，威信不废，诚国家爪牙之吏，折冲之臣。","book":"《汉书·王尊传》"},"example":{"text":"斛律明月，齐朝～，无罪被诛，将士解体，周人始有吞齐之志。","book":"北齐·颜之推《颜氏家训·慕贤》"},"usage":"作宾语；用于书面语"},{"id":20860,"word":"折冲千里","pinyin":"zhé chōng qiān lǐ","abbr":"zcql","explanation":"折冲：指抵御敌人。指在远离沙场的庙堂上以谋略和智慧克敌制胜。常用以形容高明的外交才干或在外交争端中取得胜利。","source":{"text":"夫修之于庙堂之上，而折冲乎千里之外者，其司城子罕之谓乎。","book":"《吕氏春秋·召类》"},"example":{"text":"贾督有—之威，方任以职，勿得擅除。","book":"《后汉书·贾复传》"},"usage":"作谓语、定语；用于书面语"},{"id":20861,"word":"折冲厌难","pinyin":"zhé chōng yàn nán","abbr":"zcyn","explanation":"指能压服困难，御敌致胜。","source":{"text":"必得将兼有二长之才，无二短之累，参以吏事，任以兵法，有此数姿，然后能折冲厌难，致其功实，转灾为福。","book":"汉·马融《延光四年日蚀上书》"},"similar":["厌难折冲"],"usage":"作谓语、定语；用于书面语"},{"id":20862,"word":"折冲口舌之间","pinyin":"zhé chōng kǒu shé zhī jiān","abbr":"zckszj","explanation":"折冲：引申为进行外交谈判；口舌：争吵。在辩论、争吵中进行外交谈判","source":{"text":"折冲于口舌之间","book":"宋·苏洵《送石昌言为北使引》"},"usage":"作谓语；用于书面语"},{"id":20863,"word":"折冲将军","pinyin":"zhé chōng jiāng jūn","abbr":"zcjj","explanation":"折冲：挫退敌方的战车。三国时魏国大将乐进的封号。指英勇无比的人。","source":{"text":"折冲将军乐进。","book":"宋·司马光《资治通鉴》"},"usage":"作宾语、定语；用于人"},{"id":20864,"word":"折冲尊俎","pinyin":"zhé chōng zūn zǔ","abbr":"zczz","explanation":"折冲：打退敌人的战车，指抵御敌人；尊俎：古代盛酒肉的器皿。原指诸侯国会盟的宴席上制胜对方。后泛指进行外交谈判。","source":{"text":"此臣之所谓比之堂上，禽将户内，拔城于尊俎之间，折冲席上者也。","book":"《战国策·齐策五》"},"example":{"text":"总算没有另外赔款割地，已经是他～的大功。","book":"清·曾朴《孽海花》第六回"},"similar":["折冲樽俎","尊俎折冲","樽俎折冲"],"usage":"作谓语、定语；指外交谈判"},{"id":20865,"word":"折冲御侮","pinyin":"zhé chōng yù wǔ","abbr":"zcyw","explanation":"指抗击敌人。","source":{"text":"武臣折冲曰御侮。","book":"语本《诗·大雅·绵》：“予曰有御侮”毛传"},"example":{"text":"参赞大臣，徒取充位如此，有如敌骑长驱，尚能～耶？","book":"宋·胡诠《戊午上高宗封事》"},"usage":"作谓语、定语；用于书面语"},{"id":20866,"word":"折冲樽俎","pinyin":"zhé chōng zūn zǔ","abbr":"zczz","explanation":"指不用武力而在酒宴谈判中制敌取胜。","source":{"text":"何必操干戈，堂上有奇兵，折冲樽俎间，制胜在两楹。","book":"语本《战国策·齐策五》：“此臣之所谓比之堂上，禽将户内，拔城於尊俎之间，折冲席上者也。”晋·张协《杂诗》之七"},"example":{"text":"曾朴《孽海花》第六回：“总算没有另外赔款割地，已经是他～的大功，国人应该纪念不忘的了！”"},"similar":["折冲尊俎","尊俎折冲"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":20867,"word":"折券弃债","pinyin":"zhé quàn qì zhài","abbr":"zqqz","explanation":"券：票据、凭证。撕毁凭据，放弃索债。","source":{"text":"高祖每酤酒留饮，售数倍。及见怪，岁竟，此两家常折券弃债。","book":"《史记·高祖本纪》"},"usage":"作谓语、定语；用于书面语"},{"id":20868,"word":"折戟沉沙","pinyin":"zhé jǐ chén shā","abbr":"zjcs","explanation":"戟：古代的一种兵器。折断了的戟沉没在泥沙里。形容失败惨重。","source":{"text":"折戟沉沙铁未销，自将磨洗认朝。","book":"唐·杜牧《赤壁》"},"example":{"text":"赤壁曾将百万烧，～铁未消。区区不劝周郎战，铜雀春深锁二乔。","book":"元·无名氏《隔江斗智》第一折"},"usage":"作主语、分句；指战败"},{"id":20869,"word":"折本买卖","pinyin":"shé běn mǎi mài","abbr":"sbmm","explanation":"折：亏损。亏损的生意。泛指吃亏的事。","source":{"text":"稍似间有些钱，抵死里无多债，权做这场折本买卖。","book":"元·马致远《青衫泪》第一折"},"example":{"text":"我不想做～。"},"similar":["赔本买卖"],"opposite":["一本万利"],"usage":"作主语、宾语、定语；指亏本"},{"id":20870,"word":"折柳攀花","pinyin":"zhé liǔ pān huā","abbr":"zlph","explanation":"犹寻花问柳。旧指男子狎妓等放荡行为。","source":{"text":"茶也无多，醋也无多，七件事尚且艰难，怎生教我折柳攀花？","book":"元·周德清《蟾宫曲·别友》曲"},"similar":["眠花宿柳"],"usage":"作谓语、宾语；指狎妓"},{"id":20871,"word":"折桂攀蟾","pinyin":"zhé guì pān chán","abbr":"zgpc","explanation":"折月中桂花，攀月中蟾蜍。旧喻科举极第。","source":{"text":"二哥哥枉展污了你那折桂攀蟾的钓鳌手。","book":"元·关汉卿《陈母教子》第二折"},"example":{"text":"～姓字标，入省登台意气豪。","book":"元·无名氏《三化邯郸》第二折"},"usage":"作宾语、定语；用于书面语"},{"id":20872,"word":"折槁振落","pinyin":"zhé gǎo zhèn luò","abbr":"zgzl","explanation":"把枯树枝折断，把枯树叶摇下来。比喻轻易不费力。","source":{"text":"刘、项兴义兵随而定，若折槁振落。","book":"《淮南子·人间训》"},"usage":"作谓语、定语；指很轻易"},{"id":20873,"word":"折矩周规","pinyin":"zhé jǔ zhōu guī","abbr":"zjzg","explanation":"犹循规蹈矩。指举止合乎法度。","source":{"text":"左珩右佩，折矩周规，绝无名流儇薄之习。","book":"清·沈涛《交翠轩笔记》卷二"},"example":{"text":"论安老爷这个人蹈仁履义，～，不得不谓之醇儒。","book":"清·文康《儿女英雄传》第三六回"},"usage":"作谓语、定语；用于处事"},{"id":20874,"word":"折笄之杖","pinyin":"zhé jī zhī zhàng","abbr":"zjzz","explanation":"笄：簪子。折断簪子的棍棒。比喻对晚辈进行严厉的教训。","source":{"text":"武子怒曰：‘大夫非不能也，让父兄也。尔童子，而三掩人于朝。吾不在晋国，亡无日矣。’击之以杖，折委笄。","book":"《国语·晋语五》"},"example":{"text":"老臣过庭之训，多谢古贤，～，有愧前达。（南朝·陈·徐陵《谢儿报坐事付治中启》）"}},{"id":20875,"word":"折简相召","pinyin":"zhé jiǎn xiāng zhào","abbr":"zjxz","explanation":"简：书写用的竹片。折竹片写信，召见对方。","source":{"text":"卿直以折简召我，我当敢不至邪？而乃引军来乎！","book":"《三国志·魏志·王凌传》裴松之注引《魏略》"},"example":{"text":"尺书征建鄴，折简召长安。（《魏书·自序》）"}},{"id":20876,"word":"折箭为誓","pinyin":"zhé jiàn wéi shì","abbr":"sjws","explanation":"折断箭以表示自己的决心和誓约。","source":{"text":"智深道：‘大丈夫作事，却休要翻悔。’周通折箭为誓。","book":"《金史·杨仲武传》：“及仲武至，与其酋帅相见，责以负约，对曰：‘边将苦我，今之来，求诉于上官耳。今幸见公，愿终身不复犯塞。’乃举酒酹天，折箭为誓。”明·施耐庵《水浒传》第五回"},"example":{"text":"肃曰：‘我亦欲除此贼久矣，恨无同心者耳。今将军若此，是天赐也，肃岂敢有二心？’遂～。","book":"明·罗贯中《三国演义》第九回"},"usage":"作宾语、定语；用于书面语"},{"id":20877,"word":"折而族之","pinyin":"zhé ér zú zhī","abbr":"zezz","explanation":"推翻他，而且杀他的家族。"},{"id":20878,"word":"折胶堕指","pinyin":"zhé jiāo duò zhǐ","abbr":"zjdz","explanation":"极言天气寒冷。","source":{"text":"《冬日初出铭》曰：‘折胶堕指，梦想负背。’","book":"宋·苏轼《磨衲赞》：“折胶堕指，此衲不寒，烁石流金，此衲不热。”宋·周密《齐东野语·曝日》"},"opposite":["烁石流金"],"usage":"作定语；用于书面语"},{"id":20879,"word":"折腰五斗","pinyin":"zhé yāo wǔ dǒu","abbr":"sywd","explanation":"折腰：弯腰。五斗：五斗米。为五斗米而弯腰。比喻忍受屈辱。亦作“折腰升斗”。","source":{"text":"折腰五斗间，黾勉随尘埃。","book":"《晋书·陶潜传》：“吾不能为五斗米折腰，拳拳事乡里小人邪。”唐·刘长卿《硖石遇雨，宴前主簿从兄子英宅》诗"},"example":{"text":"白发西风，～，不应堪此。","book":"宋·辛弃疾《水龙吟》词"},"similar":["折腰升斗"],"usage":"作谓语、定语；用于书面语"},{"id":20880,"word":"折腰升斗","pinyin":"zhé yāo shēng dǒu","abbr":"zysd","explanation":"折腰：弯腰。升斗：少量的米。为五斗米而弯腰。比喻忍受屈辱。同“折腰五斗”。","source":{"text":"折腰升斗，辜负当年旧松菊。","book":"宋·杨泽民《六么令·道骨仙风》词"},"similar":["折腰五斗"],"usage":"作谓语、定语；用于书面语"},{"id":20881,"word":"折臂三公","pinyin":"zhé bì sān gōng","abbr":"zbsg","explanation":"晋代的羊枯，曾坠马折断手臂，官至三公。指贵官堕马","source":{"text":"上车著作应来问，折臂三公定送方。","book":"唐·刘禹锡《秘书崔少监坠马长句因而和之诗》"},"usage":"作宾语、定语；用于书面语"},{"id":20882,"word":"折节下士","pinyin":"zhé jié xià shì","abbr":"zjxs","explanation":"折节：屈己下人。屈己下人，尊重有见识有能力的人。","source":{"text":"绍有姿貌威容，能折节下士，士多附之。","book":"晋·陈寿《三国志·魏志·袁绍传》"},"example":{"text":"累官至大冢宰，～，天下多称之。","book":"清·李斗《扬州画舫录·虹桥录上》"},"similar":["折节下贤人"],"usage":"作谓语、定语；指尊重有知识的人"},{"id":20883,"word":"折节下谋士","pinyin":"zhé jié xià móu shì","abbr":"zjxms","explanation":"折节：屈己下人。降低和委曲自己，尊重有见识有能力的人。","source":{"text":"绍有姿貌威容，能折节下士，士多附之，太祖少与交焉。","book":"《三国志·魏志·袁绍传》"},"example":{"text":"～，深心论客卿。（唐·储光羲《贻鼓吹李丞，时信安王北伐，李公王之所器者也》）"},"similar":["折节下士","折节下贤人"],"usage":"作谓语、定语；指尊重有知识的人"},{"id":20884,"word":"折节下贤人","pinyin":"zhé jié xià xián rén","abbr":"zjxxr","explanation":"折节：屈己下人。降低和委曲自己，尊重有见识有能力的人。","source":{"text":"身自耕作，夫人自织，食不加肉，衣不重采，折节下贤人，厚遇宾客，振贫吊死，与百姓同其劳。","book":"《史记·越王勾践世家》"},"similar":["折节下士","折节下谋士"],"usage":"作谓语、定语；指尊重有知识的人"},{"id":20885,"word":"折节向学","pinyin":"zhé jié xiàng xué","abbr":"zjxx","explanation":"折节：改变过去的志趣和行为。改变旧习，发愤读书。","source":{"text":"颎少便习弓马，尚游侠，轻财贿，长乃折节好古学。","book":"《后汉书·段颎传》"},"example":{"text":"乃更姓名而逃，～，遍访名师，尝与司马徽谈论。（明·罗贯中《三国演义》第三十六回）"},"similar":["折节读书"],"usage":"作谓语、定语；用于书面语"},{"id":20886,"word":"折节待士","pinyin":"zhé jié dài shì","abbr":"zjds","explanation":"指屈己待人。","source":{"text":"时晋公护诸子及广弟杞国公亮等，服玩侈靡，逾越制度，广独率由礼则，又折节待士，朝野以是称焉。","book":"《周书·邵广传》"},"similar":["折节礼士"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20887,"word":"折节礼士","pinyin":"zhé jié lǐ shì","abbr":"zjls","explanation":"指屈己待人。同“折节待士”。","source":{"text":"时徐阶以宿老居首辅，与李春芳皆折节礼士。","book":"《明史·张居正传》"},"similar":["折节待士"],"usage":"作谓语、定语、宾语；用于处事"},{"id":20888,"word":"折节读书","pinyin":"zhé jié dú shū","abbr":"zjds","explanation":"折节：改变过去的志趣和行为。改变旧习，发愤读书。","source":{"text":"颎少便习弓马，尚游侠，轻财贿，长乃折节好古学。","book":"《后汉书·段颎传》"},"example":{"text":"四十年，方遇张憬藏，谓臣当以文学备位将相，无为自弃。尔来～。","book":"唐·吴竞《开元升平源》"},"similar":["折节向学"],"usage":"作谓语；指发愤读书"},{"id":20889,"word":"折角之口","pinyin":"zhé jiǎo zhī kǒu","abbr":"zjzk","explanation":"角：鹿角。折断鹿角的嘴。形容人口才很好，善于辩论。","source":{"text":"既论难，连拄五鹿君，故诸儒为之语曰：‘五鹿岳岳，朱云折其角。’由是为博士。","book":"《汉书·朱云传》"},"example":{"text":"虽有注河之辩，～，终日危坐抵掌而谭，犹不能既其万一。（宋·周邦彦《汴都赋》）"},"similar":["三寸不烂之舌"],"usage":"作宾语；用于书面语"},{"id":20890,"word":"折足覆餗","pinyin":"zhé zú fù sù","abbr":"zzfs","explanation":"餗，鼎内食物。比喻力不能胜任，必至败事。","source":{"text":"今之四公，唯司空刘宠断断守善，余皆素餐致寇之人，必有折足覆餗之凶。","book":"《易·系辞下》：“《易》曰：‘鼎折足，覆公餗，其形渥，凶。’言不胜其任也。”《后汉书·谢弼传》"},"example":{"text":"二子审己量，乃视其力小任重，～而犹不止者有异矣。","book":"明·杨慎《审己》"},"similar":["折鼎覆餗"],"usage":"作宾语、定语；用于书面语"},{"id":20891,"word":"折足覆餸","pinyin":"zhé zú fù sù","abbr":"zzfs","explanation":"餸，鼎内食物。比喻力不能胜任，必至败事。","quote":{"text":"二子审己量，乃视其力小任重，～而犹不止者有异矣。","book":"明·杨慎《审己》"}},{"id":20892,"word":"折锐摧矜","pinyin":"zhé ruì cuī jīn","abbr":"zrcj","explanation":"锐：锐利；矜：自尊自大。锐气和自尊遭到了打击。","source":{"text":"留思北顾涕渐渐兮，折锐摧矜，凝氾滥兮。","book":"《楚辞·九叹·忧苦)》"}},{"id":20893,"word":"折长补短","pinyin":"zhé cháng bǔ duǎn","abbr":"zcbd","explanation":"截取长的，补充短的。比喻用长处补短处。","source":{"text":"今秦地折长补短，方数千里，名师数十百万，轮船国之号令赏罚，地形利害，天下莫如也。","book":"《韩非子·初见秦》"},"example":{"text":"宋·苏轼《大雪论差役不便札子》：“今者差役，岁费钱几何，及几年一次差役，皆可以～，约见其数。”"},"similar":["绝长补短"],"usage":"作宾语、定语；指取长补短"},{"id":20894,"word":"折首不悔","pinyin":"zhé shǒu bù huǐ","abbr":"zsbh","explanation":"即使被杀头也不后悔。形容态度坚决。","source":{"text":"草茅危檐者，折首而不悔。","book":"宋·李觏《袁州学记》"}},{"id":20895,"word":"折鼎覆餗","pinyin":"zhé dǐng fù sù","abbr":"zdfs","explanation":"餗，鼎内食物。比喻力不能胜任，必至败事。","source":{"text":"祏怯而无断，喧弱而不才，折鼎覆餗，跂踵可待。","book":"《南史·张弘策传》"},"example":{"text":"今也抑意陈书，引年求退，惧～之患，避牝鸡司晨之讥。","book":"元·耶律楚材《答杨行者书》"},"similar":["折足覆餗"],"usage":"作宾语、定语；用于书面语"},{"id":20896,"word":"折鼎覆餸","pinyin":"zhé dǐng fù sù","abbr":"zdfs","explanation":"?铂鼎内食物。比喻力不能胜任，必至败事。","source":{"text":"祏怯而无断，喧弱而不才，折鼎覆餸，跂踵可待。","book":"《南史·张弘策传》"},"quote":{"text":"今也抑意陈书，引年求退，惧～之患，避牝鸡司晨之讥。","book":"元·耶律楚材《答杨行者书》"}},{"id":20897,"word":"抚世酬物","pinyin":"fǔ shì chóu wù","abbr":"fscw","explanation":"宋·罗大经《鹤林玉露》卷十五：“后之君子，穷而讲道明理，达而抚世酬物，谨无着一能读书之心横在胸中也哉！”","source":{"text":"自是～，一出于正，而异端无实之说，了若不经意。 ★明·宋濂《故天台朱府君霞坞阡表》"},"example":{"text":"明·宋濂《故天台朱府君霞坞阡表》：“自是～，一出于正，而异端无实之说，了若不经意。”"},"usage":"作谓语、定语；用于处事"},{"id":20898,"word":"抚今怀昔","pinyin":"fǔ jīn huái xī","abbr":"fjhx","explanation":"抚：拍，摸，引申为注意，注视；怀：怀念；昔：过去。看看现在，想想过去。形容对当前的事物有所感触而怀念过去的人事或景物。","source":{"text":"夫抚今怀昔，理寄斯文。","book":"唐·王勃《与契苾将军书》"}},{"id":20899,"word":"抚今思昔","pinyin":"fǔ jīn sī xī","abbr":"fjsx","explanation":"抚：拍，摸，引申为注意，注视；思：回想；昔：过去。看看现在，想想过去。","source":{"text":"夫抚今怀昔，理寄斯文。","book":"唐·王勃《与契苾将军书》"},"example":{"text":"～，泪与之俱。","book":"明·袁宏道《书念公碑文后》"},"similar":["抚今痛昔","抚今追昔","抚今悼昔"],"usage":"作谓语、宾语、分句；指谈古论今"},{"id":20900,"word":"抚今悼昔","pinyin":"fǔ jīn dào xī","abbr":"fjdx","explanation":"因眼前事物而引起对往事的追思。","source":{"text":"抚今悼昔，怆然悲鸣。","book":"明·陈子龙《张邵阳诔》"},"example":{"text":"忧圣危明，天应有意；～，臣敢无言。","book":"清·孙枝蔚《甲申述忧》序"},"similar":["抚今追昔","抚今思昔","抚今痛昔"],"usage":"作谓语、宾语、分句；指谈古论今"},{"id":20901,"word":"抚今痛昔","pinyin":"fǔ jīn tòng xī","abbr":"fjtx","explanation":"因眼前事物而引起对往事的追思。同“抚今悼昔”。","source":{"text":"感惠忘仇，抚今痛昔。","book":"明·陈汝元《金莲记·释愤》"},"similar":["抚今思昔","抚今追昔","抚今悼昔"],"usage":"作谓语、宾语、分句；指谈古论今"},{"id":20902,"word":"抚今追昔","pinyin":"fǔ jīn zhuī xī","abbr":"fjzx","explanation":"抚：拍，摸，引伸为注意，注视；追：回想；昔：过去。看看现在，想想过去。","source":{"text":"吾道洵堪千古，抚今追昔，能无黯然。","book":"清·平步青《霞外捃屑》卷五"},"example":{"text":"～，低徊不已，恭王不由得痛哭了一场。","book":"高阳《慈禧前传》"},"similar":["谈古论今","抚今悼昔"],"usage":"作谓语、宾语、分句；指谈古论今"},{"id":20903,"word":"抚孤恤寡","pinyin":"fǔ gū xù guǎ","abbr":"fgxg","explanation":"孤：孤儿；寡：寡妇。抚育孤儿，照顾寡妇。","source":{"text":"宁经行权，各有其时；抚孤恤寡，存乎一念。若非公孙杵臼，焉得赵氏孤儿。","book":"明·王世贞《鸣凤记·桑林奇遇》"},"usage":"作谓语、宾语、定语；用于处世"},{"id":20904,"word":"抚心自问","pinyin":"fǔ xīn zì wèn","abbr":"fxzw","explanation":"摸着自己的胸口问问自己。表示自我反省。","source":{"text":"倘使我看了《闲话》之后，便抚心自问：‘要是二百人中有一百九十九人入了女大便怎样？’","book":"鲁迅《华盖集·这回是“多数”的把戏》"},"example":{"text":"你能～吗？"},"similar":["抚躬自问"],"usage":"作谓语；表示自我反省"},{"id":20905,"word":"抚掌击节","pinyin":"fǔ zhǎng jī jié","abbr":"fzjj","explanation":"抚掌：拍手；击节：打拍子。拍手为乐曲打拍子。也用来表示非常赞赏。","source":{"text":"便着衣帻而舞，导令坐者抚掌击节。","book":"《晋书·谢尚传》"},"example":{"text":"《魏略》：“王朗答太祖曰：‘承旨之日，～。’”"},"usage":"作谓语；用于手语"},{"id":20906,"word":"抚掌大笑","pinyin":"fǔ zhǎng dà xiào","abbr":"fzdx","explanation":"抚：拍。拍手大笑。形容非常高兴。","source":{"text":"帝抚掌大笑。","book":"南朝·宋·刘义庆《世说新语·纰漏》"},"example":{"text":"如所梦矣。”（唐·白行简《三梦记》","book":"巫～，谓同辈曰"},"similar":["欢天喜地","欢呼雀跃"],"opposite":["悲痛欲绝"],"usage":"作谓语、分句；表示内心高兴"},{"id":20907,"word":"抚时感事","pinyin":"fǔ shí gǎn shì","abbr":"fsgs","explanation":"指感念时事，伤怀往事。","source":{"text":"故尝读孔北海与魏武帝及文帝与朝歌令吴质书，彼其抚时感事，慷慨自数其齿，其言激壮，有足悲者。","book":"清·朱仕琇《与林穆庵书》"},"similar":["触景生情"],"usage":"作谓语；用于感慨"},{"id":20908,"word":"抚景伤情","pinyin":"fǔ jǐng shāng qíng","abbr":"fjsq","explanation":"接触到面前的景物而引起感情上的伤痛。","source":{"text":"登高望远，人人怀故国之悲抚景伤情，处处洒穷途之泣。","book":"元·郑德辉《王粲登楼》第三折"},"similar":["触景生情"],"usage":"作谓语；指即景生情"},{"id":20909,"word":"抚梁易柱","pinyin":"fǔ liáng yì zhù","abbr":"flyz","explanation":"抚：用手托着；易：更换。指用手托房梁，更换房柱。形容人力大无穷。","source":{"text":"纣倒曳九牛，抚梁易柱。","book":"晋·皇甫谧《帝王世纪》"},"example":{"text":"夫桀、纣之君，握钩伸铁，～，手格熊罴，走及虎兕，力甚也。","book":"唐·皮日休《鹿门隐书六十篇序》"},"usage":"作谓语、定语；用于比喻句"},{"id":20910,"word":"抚绥万方","pinyin":"fǔ suí wàn fāng","abbr":"fswf","explanation":"抚绥：安定、安抚；万方：万邦，万族。指安定天下。","source":{"text":"天监厥德，用集大命，抚绥万方。","book":"《尚书·太甲上》"},"usage":"作谓语；指安定天下"},{"id":20911,"word":"抚背扼喉","pinyin":"fǔ bèi è hóu","abbr":"fbeh","explanation":"抚：按着；扼：掐着。比喻扼据要冲，制敌死命。","source":{"text":"拖鳍挫鬎，抚背扼喉。","book":"唐·卢照邻《穷鱼赋》"},"similar":["扼喉抚背","拊背扼喉"],"usage":"作谓语、定语；指控制要害"},{"id":20912,"word":"抚胸呼天","pinyin":"fǔ xiōng hū tiān","abbr":"fxht","explanation":"抚胸：拍打胸口。拍打胸口大声叫天。形容极度悲痛的样子。","source":{"text":"今昔见君，累然在疚，抚胸呼天，天不我覆。","book":"宋·陈亮《祭章孟容文》"},"similar":["捶胸顿足"],"usage":"作谓语、定语；用于悲痛时"},{"id":20913,"word":"抚膺之痛","pinyin":"fǔ yīng zhī tòng","abbr":"fyzt","explanation":"抚：抚摸；膺：胸。抚摸着胸部伤痛的地方。指内心受到创伤，感到痛楚。"},{"id":20914,"word":"抚膺顿足","pinyin":"fǔ yīng dùn zú","abbr":"fydz","explanation":"抚膺：拍着胸膛；顿足：以脚跺地。形容悲痛或悔恨的样子。","source":{"text":"荆公展转寻思，抚膺顿足，懊悔不迭。","book":"明·冯梦龙《警世通言·拗相公饮恨半山堂》"},"similar":["捶胸顿足","拊膺顿足"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":20915,"word":"抚躬自问","pinyin":"fǔ gōng zì wèn","abbr":"fgzw","explanation":"反躬自问，指自我反省。","source":{"text":"今以愚昧，于此获罪，所知为之流涕，路人为之叹息。抚躬自问，为幸多矣！","book":"清·昭槤《啸亭杂录·朱白泉狱中上百朱二公书》"},"example":{"text":"段总理试～，其胡为启南方之龌龊耶？","book":"蔡东藩《民国通俗演义》第89回"},"similar":["反躬自问"],"usage":"作谓语；指反过来问一问自己"},{"id":20916,"word":"抚髀兴嗟","pinyin":"fǔ bì xīng jiē","abbr":"fbxj","explanation":"髀：股部，大腿；嗟：嗟叹。抚摩大腿，发出长长的叹息。指久处安逸而无所作为发出的慨叹。","source":{"text":"急得宗祥抚髀兴嗟，非常侘傺。","book":"蔡东藩《民国通俗演义》第96回"},"similar":["抚髀长叹"],"usage":"作谓语、宾语；用于感慨"},{"id":20917,"word":"抚髀长叹","pinyin":"fǔ bì cháng tàn","abbr":"fbct","explanation":"髀：股部，大腿。抚摩大腿，发出长长的叹息。指久处安逸而无所作为发出的慨叹。","source":{"text":"不觉抚髀长叹道：‘……安能久于人世乎！’","book":"明·冯梦龙《警世通言·拗相公饮恨半山堂》"},"similar":["抚髀兴嗟"],"usage":"作谓语、宾语；用于感慨"},{"id":20918,"word":"抛乡离井","pinyin":"pāo xiāng lí jǐng","abbr":"pxlj","explanation":"离开家乡故土。","source":{"text":"我这么大年纪，我可不愿意抛乡离井地走那么远。","book":"靳以《去路》"},"example":{"text":"无数群众～奔向解放区。"},"similar":["离乡背井"],"usage":"作谓语、定语、状语；指在外瓢泊"},{"id":20919,"word":"抛声炫俏","pinyin":"pāo shēng xuàn qiào","abbr":"psxq","explanation":"炫：卖弄。指故意高声，卖弄风骚。","source":{"text":"其夜，秉中侵早的更衣着靴，只在街上往来。本妇也在门首抛声炫俏。","book":"明·冯梦龙《警世通言》卷三十八"}},{"id":20920,"word":"抛声衒俏","pinyin":"pāo shēng xuàn qiào","abbr":"psxq","explanation":"衒：炫耀，卖弄。指故意高声卖弄风骚。","source":{"text":"本妇也在门首抛声衒俏。","book":"《清平山堂话本·刎颈鸳鸯会》"},"similar":["抛声炫俏"],"usage":"作谓语、宾语；多用于女性"},{"id":20921,"word":"抛头露脸","pinyin":"pāo tóu lù liǎn","abbr":"ptll","explanation":"指妇女在公开场合出面。泛指人们在公开场合出现","source":{"text":"小妇人不顾抛头露脸，恩求过往仁人君子、大众爷台，以助资斧。","book":"清·石玉昆《小五义》第56回"},"similar":["抛头露面"],"usage":"作谓语、定语、宾语、分句；指公开露面"},{"id":20922,"word":"抛头露面","pinyin":"pāo tóu lù miàn","abbr":"ptlm","explanation":"抛：暴露。露出头和面孔。原指妇女出现在大庭广众之中。现指公开露面。","source":{"text":"倘久后此城一破，使我妻女擒往朝歌，露面抛头，尸骸残暴，惹天下诸侯笑我为无谋之辈；不若先杀其妻妇，然后自刎，庶几不失丈夫之所为。","book":"明·许仲琳《封神演义》第三回"},"example":{"text":"却到这里来～，好不识羞！","book":"叶圣陶《春光不是她的了》"},"similar":["出头露面"],"opposite":["隐姓埋名","深居简出"],"usage":"作谓语、定语、宾语、分句；指公开露面"},{"id":20923,"word":"抛妻弃子","pinyin":"pāo qī qì zǐ","abbr":"pqqz","explanation":"抛：丢弃。丢弃妻子儿女。形容逃难时的凄惨状况或分居两地的情景。","source":{"text":"人生最苦为行商，抛妻弃子离家乡。","book":"明·冯梦龙《喻世明言》第18卷"},"similar":["抛妻弃孩"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":20924,"word":"抛妻弃孩","pinyin":"pāo qī qì hái","abbr":"pqqh","explanation":"抛：丢弃。丢弃妻子儿女。形容逃难时的凄惨状况。","source":{"text":"望烟尘一派，抛妻弃孩，团圆难再。","book":"清·孔尚任《桃花扇·逃难》"},"similar":["抛妻弃子"],"usage":"作谓语、宾语、定语；用于逃难慌乱时"},{"id":20925,"word":"抛戈卸甲","pinyin":"pāo gē xiè jiǎ","abbr":"pgxj","explanation":"丢掉武器，扔掉铠甲。形容军队被打得狼狈逃窜的情形。","source":{"text":"则要你输，不要你赢，可抛戈卸甲，佯输诈败。","book":"元·无名氏《开诏救忠》第一折"},"example":{"text":"霎时已经死了一半，一半～，沿海逃生。","book":"清·魏秀仁《花月痕》第四回"},"similar":["抛戈弃甲"],"usage":"作谓语；形容在战场上打了败仗"},{"id":20926,"word":"抛戈弃甲","pinyin":"pāo gē qì jiǎ","abbr":"pgqj","explanation":"丢掉武器，扔掉铠甲。形容军队被打得狼狈逃窜的情形。","source":{"text":"部下听得，一齐抛戈弃甲跪倒。","book":"清·褚人获《隋唐演义》第53回"},"example":{"text":"敌人开始～，向我军投降。"},"similar":["丢盔弃甲"],"opposite":["冲锋陷阵"],"usage":"作谓语；形容在战场上打了败仗"},{"id":20927,"word":"抛珠滚玉","pinyin":"pāo zhū gǔn yù","abbr":"pzgy","explanation":"抛：抛掷。形容眼泪如同珠玉般滚落。","source":{"text":"抛珠滚玉只偷潸，镇日无心镇日闲；枕上袖边难拂拭，任他点点与斑斑。","book":"清·曹雪芹《红楼梦》第34回"},"usage":"作谓语、定语；指流泪"},{"id":20928,"word":"抛盔弃甲","pinyin":"pāo kuī qì jiǎ","abbr":"pkqj","explanation":"盔：作战用的金属帽；甲：作战用的金属防护衣。形容吃了败仗狼狈逃跑的情形。","source":{"text":"孝德念动真言，借一阵飞砂走石，把周兵打的抛盔弃甲而逃。","book":"清·如莲居士《薛刚反唐》第58回"},"similar":["丢盔弃甲"],"usage":"作谓语、定语、状语；指战败"},{"id":20929,"word":"抛砖引玉","pinyin":"pāo zhuān yǐn yù","abbr":"pzyy","explanation":"抛出砖去，引回玉来。比喻用自己不成熟的意见或作品引出别人更好的意见或好作品。","source":{"text":"比来抛砖引玉，却引得个坠子。","book":"宋·释道原《景德传灯录》卷十"},"example":{"text":"刚才婢子费了唇舌，说了许多书名，原是～，以为借此长长见识，不意竟是如此！","book":"清·李汝珍《镜花缘》第十八回"},"similar":["引玉之砖","一得之见"],"usage":"作谓语、定语、宾语、分句；用于谦词","story":["唐朝诗人常建非常佩服赵嘏的才华，总想得到赵嘏的诗作。一次常建打听到赵嘏要到灵岩寺游玩，就先赶到该寺，在墙上题了两句诗。赵嘏见到墙上的诗，提笔就在诗的后面加上两句，形成一首完整的七言绝句，人们评说这是常建抛砖引玉"]},{"id":20930,"word":"抛金弃鼓","pinyin":"pāo jīn qì gǔ","abbr":"pjqg","explanation":"金：指锣。抛下助战用的锣与鼓。形容被打败而逃走。","source":{"text":"俺如今不须用力死追复，他每都抛金弃鼓，领着残卒，离营撇寨那厢扑。","book":"元·无名氏《杏林庄》第二折"},"example":{"text":"军士～，撇戟丢枪，觅子寻爷，呼兄唤弟，折了万余人马，退三十里外扎住。","book":"明·施耐庵《水浒全传》第七十七回"},"usage":"作谓语、定语、状语；用于战争等"},{"id":20931,"word":"抛鸾拆凤","pinyin":"pāo luán chāi fèng","abbr":"plcf","explanation":"鸾、凤：福州中鸟名，比喻夫妻或情侣。比喻夫妻或情侣被分开拆散。","source":{"text":"谁知道，天不容，两三年间抛鸾拆凤。","book":"元·邦哲《寿阳曲·思旧》"},"usage":"作谓语、定语；用于夫妻与情侣等"},{"id":20932,"word":"抜格不入","pinyin":"hàn gé bù rù","abbr":"hgbr","explanation":"?壕；格坚硬；抜格相互抵触，格格不入。过于坚硬而难于深入。形容彼此意见完全不合。","source":{"text":"发然后禁，则抜格而不胜。郑玄注抜坚不可入之貌。","book":"《礼记·学记》"}},{"id":20933,"word":"抟心壹志","pinyin":"tuán xīn yī zhì","abbr":"txyz","explanation":"指专心一志。同“抟心揖志”。","source":{"text":"入无仰事俯畜之累，出无金尽裘敝可怜之色，抟心壹志，以道于君子之道。","book":"清·曾国藩《湘乡县宾兴堂记》"},"similar":["抟心揖志","专心致志","专心一志"],"usage":"作谓语、定语、状语；指聚精会神"},{"id":20934,"word":"抟心揖志","pinyin":"tuán xīn yī zhì","abbr":"txyz","explanation":"指专心一志。","source":{"text":"普天之下，抟心揖志。","book":"西汉·司马迁《史记·秦始皇本纪》"},"similar":["专心致志","抟心壹志","专心一意"],"usage":"作谓语、定语、状语；指聚精会神"},{"id":20935,"word":"抟沙作饭","pinyin":"tuán shā zuò fàn","abbr":"tszf","explanation":"抟：把散碎的东西捏聚成团。将沙粒捏聚成饭团。比喻白费心思，全无可能。","source":{"text":"然则与此辈论交，如抟沙作饭矣。","book":"清·纪昀《阅微草堂笔记·如是我闻一》"},"usage":"作宾语、定语；指白费心思"},{"id":20936,"word":"抟沙嚼蜡","pinyin":"tuán shā jiáo là","abbr":"tsjl","explanation":"抟：以手抟捏。抟沙不能成形，嚼蜡毫无滋味。比喻空虚无味。","source":{"text":"世事抟沙嚼蜡，等闲荣辱休惊讶。","book":"元·杨立斋《哨遍》套数"},"usage":"作谓语、宾语、定语；指空虚而无味"},{"id":20937,"word":"抟沙弄汞","pinyin":"tuán shā nòng gǒng","abbr":"tsng","explanation":"抟：用手团捏；汞：水银。砂土松散，水银流动，难以团捏把捉。比喻枉费力气，无法管束。","source":{"text":"这泼猴枉自也拿他不住，就拿住他，也似抟砂弄汞，捉影捕风。","book":"明·吴承恩《西游记》第二十五回"},"usage":"作宾语、定语；用于比喻句"},{"id":20938,"word":"抟砂弄汞","pinyin":"tuán shā nòng gǒng","abbr":"tsng","explanation":"比喻枉费力气，无法管束。","source":{"text":"这泼猴枉自也拿他不住，就拿住他，也似抟砂弄汞，捉影捕风。","book":"明·吴承恩《西游记》第二十五回"}},{"id":20939,"word":"抟空捕影","pinyin":"tuán kōng bǔ yǐng","abbr":"tkby","explanation":"犹言捕风捉影。比喻说话做事丝毫没有事实根据。","source":{"text":"正如痴儿抟空捕影，只堪一笑耳。","book":"《大慧普觉禅师年谱》"},"similar":["捕风捉影"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":20940,"word":"抟香弄粉","pinyin":"tuán xiāng nòng fěn","abbr":"txnf","explanation":"比喻和女人交往厮混。","source":{"text":"你待要抟香弄粉，妆孤学俊，便准备着那一年春尽一年春。","book":"明·贾仲明《对玉梳》第一折"},"usage":"作谓语、宾语；用于比喻句"},{"id":20941,"word":"抠心挖肚","pinyin":"kōu xīn wā dù","abbr":"kxwd","explanation":"把心肚挖出来。形容费心思索。","source":{"text":"这日吃过了晚膳，就靠在烟榻上，抠心挖肚的足足拟了一夜的条陈稿子，还没有拟好。","book":"清·李宝嘉《官场现形记》第二回"},"similar":["搜肠刮肚","抠心挖血"],"usage":"作谓语、状语、定语；指挖空心思"},{"id":20942,"word":"抠心挖胆","pinyin":"kōu xīn wā dǎn","abbr":"kxwd","explanation":"把心胆都挖出来。形容待人真心实意。","source":{"text":"照这样抠心挖胆的待你，不想出在堂中名人……便回回落第，也是情愿。","book":"清·曾朴《孽海花》第四回"},"usage":"作谓语、定语、状语；指待人诚心"},{"id":20943,"word":"抠心挖血","pinyin":"kōu xīn wā xuè","abbr":"kxwx","explanation":"犹言抠心挖肚。形容费心思索。","source":{"text":"你想吾朝自入关以来，抠心挖血，费了无数经营布置，方将汉人压服。","book":"陈天华《轰天雷》第八回"},"similar":["抠心挖肚"],"usage":"作谓语、状语、定语；指挖空心思"},{"id":20944,"word":"抠衣趋隅","pinyin":"kōu yī qū yú","abbr":"kyqy","explanation":"抠：提；隅：角落。提起衣襟，走到角落坐下。古时指见到尊长时应有的礼貌。","source":{"text":"毋践屦，勿踖席，抠衣趋隅，必慎唯喏。","book":"《礼记·曲礼上》"},"example":{"text":"望退食之余，许其抠衣趋隅，进而教之。","book":"清·袁枚《小仓山房尺牍》卷一百二十"}},{"id":20945,"word":"抡眉竖目","pinyin":"lún méi shù mù","abbr":"lmsm","explanation":"抡：用力挥动。形容强硬的神情。","example":{"text":"所以即使是同伴之间，往往因为一句有意的或无意的不相干的话，动了真气，～的恨恨半天而不已。","book":"朱自清《海行杂记》"}},{"id":20946,"word":"抢地呼天","pinyin":"qiāng dì hū tiān","abbr":"qdht","explanation":"抢地：触地。大声叫天，用头撞地。形容极度悲伤。","source":{"text":"惊闻解任，辄抢地呼天，号泣罢市。","book":"清·汤斌《汤子遗书》二"},"example":{"text":"老板奶奶见媳妇已死，～，哭个不了。","book":"清·李宝嘉《官场现形记》第十四回"},"similar":["呼天抢地"],"opposite":["兴高采烈"],"usage":"作谓语、状语；指极度悲伤"},{"id":20947,"word":"护国佑民","pinyin":"hù guó yòu mín","abbr":"hgym","explanation":"捍卫国家，保护人民。","source":{"text":"扫荡妖魔神鬼怕，护国佑民万万纪。","book":"《孤本元明杂剧·双林坐化》第二折"},"similar":["保家卫国"],"usage":"作宾语、定语；指保家卫国"},{"id":20948,"word":"护身符","pinyin":"hù shēn fú","abbr":"hsf","explanation":"一种小巧的装饰品(如珠宝、玉石或纪念品)，上面刻有符咒、咒文或符号，戴上这个护身宝贝可以防止灾祸(如疾病或魔力)，或者帮助佩戴者。","source":{"text":"小储君倒也安安稳稳守着妆盒做护身符，则是我陈琳战战兢兢抱着个天大闷葫芦。","book":"元·无名氏《抱妆盒》第四折"},"example":{"text":"你不能把它作为～的，谁也帮不了你。"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":20949,"word":"护过饰非","pinyin":"hù guò shì fēi","abbr":"hgsf","explanation":"掩护错误、文饰过失。","source":{"text":"和珅率对不以实，诏斥护过饰非，革职留任。","book":"《清史稿·和珅传》"},"similar":["文过饰非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":20950,"word":"报仇心切","pinyin":"bào chóu xīn qiè","abbr":"bcxq","explanation":"急于要报仇雪恨。","source":{"text":"踌躇千百万遍，终是报仇心切，只得宁耐，看个居止下落，再作区处。","book":"明·冯梦龙《醒世恒言》第36卷"},"example":{"text":"她的儿子被鬼子打死，她～，端起机枪向鬼子扫去。"},"usage":"作谓语；用于处世"},{"id":20951,"word":"报仇雪恨","pinyin":"bào chóu xuě hèn","abbr":"bcxh","explanation":"雪：洗刷掉。报冤仇，除仇恨。","source":{"text":"（文）种辅翼越王勾践。而为之报怨雪耻。","book":"《淮南子·氾论训》"},"example":{"text":"滥官害民贱徒，把我全家诛戮，今日正好报仇雪恨！","book":"明·施耐庵《水浒全传》第五十八回"},"similar":["报仇雪耻","深仇大恨","以牙还牙"],"opposite":["以德报怨","忍辱负重","忍气吞声"],"usage":"作谓语、宾语、定语；用于复仇方面"},{"id":20952,"word":"报仇雪耻","pinyin":"bào chóu xuě chǐ","abbr":"bcxc","explanation":"指报复冤仇，洗刷耻辱。","source":{"text":"主女琼英，素有报仇雪耻之志。","book":"《水浒传》第九八回"},"example":{"text":"虽然～，从来不曾放在考虑之列；但‘非我族类，其心必异’的道理，兔先生却是明白的。","book":"聂绀弩《兔先生的发言》"},"similar":["报仇雪恨","报怨雪耻","复仇雪耻"],"opposite":["忍辱负重","忍生吞声","逆来顺受"],"usage":"作谓语、宾语、定语；形容人报冤仇、解怨恨","story":["东汉末年，孙坚英名天下，袁术封他为破虏将军，任豫州刺史。袁术令孙坚征讨荆州刘表，孙坚大败黄祖，被黄祖的部下吕公的箭手射死。孙坚的儿子孙策立志要为父报仇雪耻，在张纮的指点下，以江南为根据地，拥有江东六郡"]},{"id":20953,"word":"报冰公事","pinyin":"bào bīng gōng shì","abbr":"bbgs","explanation":"旧时官场指清苦的差使。"},{"id":20954,"word":"报喜不报忧","pinyin":"bào lǐ bù bào yōu","abbr":"bxbby","explanation":"只报告高兴的事，不报告忧愁的事情。","source":{"text":"过去报喜不报忧，现在也报忧了，这就可以医治自满和麻痹。","book":"邓小平《在西南区新闻工作会议上的报告》"},"example":{"text":"我认为对下一代采取～的教育方针，已经证明是失败了。","book":"韦君宜《参考资料》"},"usage":"作谓语、宾语、定语；指说假话"},{"id":20955,"word":"报应不爽","pinyin":"bào yìng bù shuǎng","abbr":"bybs","explanation":"报应：佛家语，指因果报应；爽：差失。做恶者必得恶报，从来没有差错的。","source":{"text":"男男女女，人千人万，那一个不说是天理昭彰，报应不爽。","book":"清·钱彩《说岳全传》第七十四回"},"example":{"text":"清·钱彩《说岳全传》第74回：“男男女女，人千人万，那一个不说是天理昭彰，～。”"},"usage":"作谓语、宾语；用于劝诫人等"},{"id":20956,"word":"报怨雪耻","pinyin":"bào yuàn xuě chǐ","abbr":"byxc","explanation":"报：报复；雪：洗刷。报怨恨，洗刷耻辱。","source":{"text":"若先王之报怨雪耻，夷万乘之强国。","book":"《战国策·燕策》"},"similar":["报仇雪恨"],"usage":"作宾语、定语；用于处事"},{"id":20957,"word":"报效万一","pinyin":"bào xiào wàn yī","abbr":"bxwy","explanation":"报效：为报答恩情而为之效力。指恩德极大，只给以微不足道的报答。","source":{"text":"且今上体天地生生之大德，垂古今未有之旷恩，虽肝脑涂地，岂能报效万一！","book":"清·曹雪芹《红楼梦》第十八回"}},{"id":20958,"word":"报本反始","pinyin":"bào běn fǎn shǐ","abbr":"bbfs","explanation":"报：报答；本：根源；反：回到；始：开始。指受恩思报，不忘所自。","source":{"text":"唯社丘乘粢盛，所以报本反始也。","book":"《礼记·效特牲》"},"usage":"作谓语；指不忘本"},{"id":20959,"word":"报李投桃","pinyin":"bào lǐ tóu táo","abbr":"bltt","explanation":"意思是他送给我桃儿，我以李子回赠他。比喻友好往来或互相赠送东西。","source":{"text":"投我以桃，报之以李。","book":"《诗经·大雅·抑》"},"example":{"text":"只指望～，那顾他祀佛看经。","book":"明·高濂《玉簪记·诳告》"},"similar":["投桃报李","礼尚往来"],"usage":"作谓语、定语；指互相赠送东西"},{"id":20960,"word":"报雠雪恨","pinyin":"bào chóu xuě hèn","abbr":"bcxh","explanation":"报冤仇以洗雪心中之恨。参见“报仇雪恨”。","source":{"text":"存得堂堂七尺身，也不敢望遂风云，报雠雪恨。","book":"元·杨显之《酷寒亭》楔子"},"similar":["报仇雪恨"],"opposite":["忍气吞声"],"usage":"作谓语、宾语、定语；用于复仇方面"},{"id":20961,"word":"披云见日","pinyin":"pī yún jiàn rì","abbr":"pyjr","explanation":"披：分开，劈开。劈开云雾，见到太阳。比喻重见光明。","source":{"text":"文王之识也，灼然如披云而见日，霍然若开雾而观天。","book":"汉·徐干《中论审大臣》"},"example":{"text":"小将无知，屡次触犯威严，幸蒙收录，正如～。","book":"清·俞万春《荡寇志》第八十七回"},"similar":["披云雾睹青天"],"usage":"作谓语、宾语；用于比喻句"},{"id":20962,"word":"披云雾睹青天","pinyin":"pī yún wù dǔ qīng tiān","abbr":"pywdqt","explanation":"披：劈开。比喻冲破黑暗，见到光明。也比喻冤屈得到申雪。","source":{"text":"命子弟造之，曰：‘此人，人之水镜也。见之披云雾睹青天。’","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"similar":["披云见日"],"usage":"作谓语、宾语；用于比喻句"},{"id":20963,"word":"披云雾，睹青天","pinyin":"pī yún wù，dǔ qīng tiān","abbr":"pywdqt","explanation":"披：拨开；睹：看见。拨开云雾，年岁青天。比喻消除障碍，见到光明。","source":{"text":"此人，人之水镜也，见之披云雾，睹青天。","book":"南朝·宋·刘义庆《世说新语·赏誉》"}},{"id":20964,"word":"披发入山","pinyin":"pī fā rù shān","abbr":"pfrs","explanation":"指离开俗世而隐居。","source":{"text":"汝欲取蜀，吾当披发入山，不失信天下也。","book":"明·王世贞《纲鉴会纂·后汉纪》"},"example":{"text":"吾其～，不复问人间事乎！","book":"柳亚子《发刊词》"},"similar":["被发入山"],"usage":"作谓语、定语；用于书面语"},{"id":20965,"word":"披发左衽","pinyin":"pī fà zuǒ rèn","abbr":"pfzr","explanation":"左衽：衣襟向左掩。披头散发，衣襟左开，借指异族入侵为主。","source":{"text":"微管仲，吾其被发左衽矣。","book":"先秦·孔子《论语·宪问》"},"example":{"text":"或披发左衽，奋迅泥潭，或从容傅会，望表知里。","book":"晋·潘岳《西征赋》"},"similar":["披发文身","被发左衽"],"usage":"作谓语、宾语；借指沦陷为异族统治","story":["春秋时期，孔子带领弟子们周游列国，在陈国闲居等待封官，不久吴王夫差灭了越国后，势力强大，带领披发左衽的吴兵乘机攻打陈国，陈君连夜潜逃，孔子还是按计划去主持祭祀仪式，被弟子们强拉上车，逃出陈国前往蔡国"]},{"id":20966,"word":"披发文身","pinyin":"pī fà wén shēn","abbr":"pfws","explanation":"古代吴越一带和某些南方民族的风俗。头发披散，身刺花纹。","source":{"text":"东方曰夷，被发文身，有不火食者矣。","book":"《礼记·王制》"},"example":{"text":"禹入裸国，～；墨子入楚，锦衣吹笙。","book":"章炳麟《驳康有为论革命书》"},"similar":["被发文身"],"usage":"作谓语、定语；指人的外表"},{"id":20967,"word":"披发缨冠","pinyin":"pī fā yīng guàn","abbr":"pfyg","explanation":"指不及束发冠戴，只系缨于颈。比喻急于救援。","source":{"text":"今有同室之人斗者，救之，虽被发缨冠而救之可也。","book":"语出《孟子·离娄下》"},"example":{"text":"淮扬之民，方苦昏垫，～而救之，犹恐不及，岂能豫忧运道之难处耶！","book":"明·张居正《答河道吴公桂芳书》"},"similar":["被发缨冠","被发撄冠"],"usage":"作定语、状语；形容人的装束不整洁"},{"id":20968,"word":"披古通今","pinyin":"pī gǔ tōng jīn","abbr":"pgtj","explanation":"披：翻阅；通：通晓。阅读通晓古今书籍。","source":{"text":"敬客礼贤，恭思俨束，披古通今，察奸理俗。","book":"南朝·梁·萧纲《书案铭》"},"similar":["博古通今"],"usage":"作谓语、定语；用于称颂人"},{"id":20969,"word":"披坚执锐","pinyin":"pī jiān zhí ruì","abbr":"pjzr","explanation":"穿着铁甲，拿着武器。形容全副武装。","source":{"text":"夫被（披）坚执锐，义不如公。","book":"《战国策·楚策一》：“吾被坚执锐，赴强敌而死。”《史记·项羽本纪》"},"example":{"text":"～，虽未经于戎行；制胜伐谋，亦常习于事业。","book":"唐·刘禹锡《请赴行营表》"},"similar":["秣马厉兵","厉兵秣马","严阵以待"],"opposite":["手无寸铁","赤手空拳","赤膊上阵"],"usage":"作谓语、宾语、状语；指装备精良","story":["秦朝末年，项梁和项羽拥立楚怀王的孙子熊心为楚怀王起兵反秦，秦朝大将章邯派王离、涉间率军围困赵国，楚怀王派宋义为上将军、项羽为副将率军去救赵国。宋义到安阳后不进军，对项羽说：“披坚执锐不如你，运用计谋你不如我。”"]},{"id":20970,"word":"披头散发","pinyin":"pī tóu sàn fà","abbr":"ptsf","explanation":"头发长而散乱。形容仪容不整。","source":{"text":"那张三又挑唆阎婆去厅上披头散发来告道：‘宋江实是宋清隐藏在家，不令出官。相公如何不与老身做主去拿宋江。’","book":"明·施耐庵《水浒全传》第二十二回"},"example":{"text":"一众女人，早已～，哭哭啼啼，倒的倒，跌的跌。","book":"清·李宝嘉《文明小史》第九回"},"similar":["蓬头垢面"],"opposite":["眉清目秀"],"usage":"作谓语、定语；形容非常狼狈"},{"id":20971,"word":"披头盖脑","pinyin":"pī tóu gài nǎo","abbr":"ptgn","explanation":"盖：压。正对着头和脸盖下来。形容（打击、冲击、批评等）来势很猛。","source":{"text":"夺过士兵手里的棍棒，劈头盖脸便打。","book":"明·施耐庵《水浒全传》第十四回"},"example":{"text":"雨呀，～地浇下来，顺脖子灌进去。","book":"杜鹏程《保卫延安》第五章"},"similar":["劈头劈脑","劈头盖脸"],"usage":"作状语；指正对着头部"},{"id":20972,"word":"披头跣足","pinyin":"pī tóu xiǎn zú","abbr":"ptxz","explanation":"跣足：光脚。头发散乱，打着赤脚。形容十分狼狈或穷困潦倒的样子。","source":{"text":"军士曰：‘恰才见甘夫人披头跣足，相随一伙百姓妇女，投南而走。’","book":"明·罗贯中《三国演义》第41回"},"usage":"作谓语、定语、状语；用于书面语"},{"id":20973,"word":"披心沥血","pinyin":"pī xīn lì xuè","abbr":"pxlx","explanation":"剖开心滴出血来。比喻竭尽忠诚。","source":{"text":"推恩及罪，在臣实大，披心沥血，敢乞言之。","book":"《南史·袁昂传》"},"similar":["披肝沥血"],"usage":"作谓语、定语；指竭尽忠诚"},{"id":20974,"word":"披心相付","pinyin":"pī xīn xiāng fù","abbr":"pxxf","explanation":"披心：披露真心；相付：给人家。形容真心待人。","source":{"text":"歃血断金，披心相付。","book":"《晋书·慕容垂载记》"},"similar":["坦诚相见"],"usage":"作谓语；指真心待人"},{"id":20975,"word":"披怀虚己","pinyin":"pī huái xū jǐ","abbr":"phxj","explanation":"披怀：敞开胸怀；虚：虚心。比喻虚心礼让，诚恳相待。","source":{"text":"卑官菲食，以丰功臣之赏；披怀虚己，以纳谟士之算。","book":"晋·陆机《辨亡论》"}},{"id":20976,"word":"披文握武","pinyin":"pī wén wò wǔ","abbr":"pwww","explanation":"握：把握。指人兼有文武之才。","source":{"text":"披文握武，建中兴庙宇。","book":"元·周德清《满庭芳·看岳王传》"}},{"id":20977,"word":"披星带月","pinyin":"pī xīng dài yuè","abbr":"pxdy","explanation":"形容连夜奔波或早出晚归，十分辛苦。","source":{"text":"击剑夜深归甚处，披星带月折麒麟。","book":"唐·吕岩《七言绝句》"},"example":{"text":"夜饭在田垄，～归。","book":"陈毅《春兴》诗"},"similar":["披星戴月"],"usage":"作谓语、状语；形容辛劳奔波"},{"id":20978,"word":"披星戴月","pinyin":"pī xīng dài yuè","abbr":"pxdy","explanation":"身披星星，头戴月亮。形容连夜奔波或早出晚归，十分辛苦。","source":{"text":"这大的孩儿披星戴月，早起晚眠。","book":"元·无名氏《冤家债主》第一的"},"example":{"text":"经过二十多天～的风尘奔波，到襄阳后一定要休息几天。","book":"姚雪垠《李自成》第二卷第二十章"},"similar":["早出晚归"],"opposite":["悠闲自得"],"usage":"作谓语、定语；形容连夜奔波或早出晚归","story":["春秋时期，鲁国单父县令宓子贱坐在公堂弹琴却能把县治得很好，而继任的巫马期每天披星戴月、事必躬亲，十分劳累才把县治得井井有条，巫马期向宓子贱请教秘诀。宓子贱说得善于利用能干的人为你办事"]},{"id":20979,"word":"披林撷秀","pinyin":"pī lín xié xiù","abbr":"plxx","explanation":"犹言去粗存精。","source":{"text":"虽发词遣句，未协风骚，而披林撷秀，揭厉良多。","book":"唐·芮挺章《国秀集》序"},"similar":["去粗存精"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":20980,"word":"披枷带锁","pinyin":"jīn jiā yù suǒ","abbr":"pjds","explanation":"枷：套在脖子上的刑具；锁：用铁环连接而成的刑具。指罪犯套上枷锁等刑具。","source":{"text":"［正旦云］俺婆婆若见我披枷带锁赴法场餐刀去呵，［唱］枉将他气杀也么哥，枉将他气杀也么哥。告哥哥，临危好与人行放便。","book":"元·关汉卿《窦娥冤》第三折"},"example":{"text":"有～俨然罪人者。 ◎清·富察敦崇《燕京岁时记·城隍出巡》"}},{"id":20981,"word":"披枷戴锁","pinyin":"pī jiā dài suǒ","abbr":"pjds","explanation":"指罪犯套上枷锁等刑具。同“披枷带锁”。","source":{"text":"正行时，忽见有十数个和尚，一个个披枷戴锁，沿门乞化。","book":"明·吴承恩《西游记》第62回"},"example":{"text":"有些家伙正在往我们灵魂上泼脏水，给我们的灵魂～。","book":"刘心武《没有讲完的课》"},"similar":["披枷带锁"],"usage":"作谓语、定语、宾语；用于受刑等"},{"id":20982,"word":"披根搜株","pinyin":"pī gēn sōu zhū","abbr":"pgsz","explanation":"披：揭开；搜：搜索；株：露出地面的树根。指刨根究底。","source":{"text":"除将本犯毙之杖下，至于牵连旁及者，亦必披根搜株，尽法惩治。","book":"清·李绿园《歧路灯》第八十八回"}},{"id":20983,"word":"披榛采兰","pinyin":"pī zhēn cǎi lán","abbr":"pzcl","explanation":"披：拔开；榛：丛生的荆棘。拨开荆棘，采摘兰草。比喻选拔人才。","source":{"text":"陛下披榛采兰，并收蒿艾，是以皋陶振褐，不仁者远。","book":"《晋书·皇甫谧传》"},"example":{"text":"及唐代之作者，导泾分渭，～。","book":"清·谭献《唐诗录序》"},"usage":"作谓语、宾语；比喻选拔人才"},{"id":20984,"word":"披毛带角","pinyin":"pī máo dài jiǎo","abbr":"pmdj","explanation":"长着毛，顶着角。指畜生。","source":{"text":"死的死，活的活，血肉淋漓，束缚的总只是披毛带角。","book":"明·罗贯中《平妖传》第三回"},"similar":["披毛戴角"],"usage":"作谓语、定语、宾语；指变为牲畜"},{"id":20985,"word":"披毛戴角","pinyin":"pī máo dài jiǎo","abbr":"pmdj","explanation":"指牲畜。","source":{"text":"学人不负师机，还免披毛戴角也无？","book":"宋·释道原《景德传灯录》"},"example":{"text":"所谓～，酬还信施，岂诳语耶！","book":"明·李贽《戒众僧》"},"similar":["披毛带角"],"usage":"作谓语、定语、宾语；指变为牲畜"},{"id":20986,"word":"披毛求瑕","pinyin":"pī máo qiú xiá","abbr":"pmqx","explanation":"故意挑剔毛病，寻找差错。同“披毛求疵”。","source":{"text":"是以妄张贼势，披毛求疵，冀得肆心。","book":"《北史·崔浩传》"},"similar":["批毛求疵"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":20987,"word":"披毛求疵","pinyin":"pī máo qiú cī","abbr":"pmqc","explanation":"故意挑剔毛病，寻找差错。","source":{"text":"虽外示谨厚，而情深刻薄，每受制鞫狱，必披毛求疵，陷于重辟。","book":"《旧唐书·崔元综传》"},"similar":["吹毛求疵","披毛求瑕"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":20988,"word":"披毛索靥","pinyin":"pī máo suǒ yǎn","abbr":"pmsy","explanation":"比喻故意挑剔毛病。","source":{"text":"岂肯称薪而爨，数粒乃炊，并瑕弃璧，披毛索靥哉？","book":"《抱朴子·接疏》"}},{"id":20989,"word":"披毛索黡","pinyin":"pī máo suǒ yǎn","abbr":"pmsy","explanation":"披：拨开；毛：毛发；索：寻找；黡：黑痣。比喻故意挑剔毛病。","source":{"text":"成天平地，岂肯称薪而爨，数粒乃炊，并瑕弃璧，披毛索靥哉！","book":"晋·葛洪《抱朴子·接疏》"},"similar":["吹毛求疵"],"usage":"作谓语、定语；指故意挑剔"},{"id":20990,"word":"披沙剖璞","pinyin":"pī shā pōu pú","abbr":"pspp","explanation":"披：分；剖：剖开；璞：含有玉的石头。从沙粒中区分出金子，从石头中剖出美玉。比喻从大量的人中识别、挑选出有用的人才。","source":{"text":"一入中禁考策词，三在天官第章句，披沙剖璞，由我而显者落落然居多。","book":"唐·刘禹锡《唐尚书吏部侍郎奚公神道碑铭序》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":20991,"word":"披沙拣金","pinyin":"pī shā jiǎn jīn","abbr":"psjj","explanation":"拨开沙子来挑选金子。比喻从大量的东西中选取精华。","source":{"text":"然则历考前史，征诸直词，虽古人糟粕，真伪相乱，而披沙拣金，有时获宝。","book":"唐·刘知己《史通·直书》"},"example":{"text":"～，所获甚尠。","book":"清·陶曾佑《中国文学之概观》"},"similar":["沙里淘金","去芜存菁"],"opposite":["泥沙俱下","鱼龙混杂","一蹴而就"],"usage":"作谓语、宾语、定语；指从大量的东西中选精"},{"id":20992,"word":"披沙捡金","pinyin":"pī shā jiǎn jīn","abbr":"psjj","explanation":"披：分开；捡：挑选。拨开沙子，挑选金子。比喻从大量的东西中选取精华。","source":{"text":"‘池塘’‘园柳’之篇，‘白云’‘绿涤’之作，‘乱流’‘孤屿’之句，‘云合’‘露泫’之词，披沙捡金，寥寥可数。","book":"清·汪师韩《诗学纂闻》"},"similar":["披沙简金","披沙拣金"],"opposite":["泥沙俱下","鱼龙混杂"],"usage":"作谓语、宾语、定语；指从大量的东西中选精"},{"id":20993,"word":"披沙沥金","pinyin":"pī shā lì jīn","abbr":"pslj","explanation":"沙里淘金。比喻从大量的事物中选取精华。","example":{"text":"在大量的资料面前，我们要～，汲取我们需要的东西。"},"similar":["披沙拣金"],"opposite":["泥沙俱下","鱼龙混杂"],"usage":"作谓语、宾语、定语；指从大量的东西中选精"},{"id":20994,"word":"披沙简金","pinyin":"pī shā jiǎn jīn","abbr":"psjj","explanation":"犹言排沙简金。比喻从大量事物中挑选精华。","source":{"text":"潘诗烂若舒锦，无处不佳，陆文如披沙简金，往往见宝。","book":"梁·锺嵘《诗品》卷上"},"example":{"text":"其间商榷源流，扬扢风雅，如～，正须明眼者抉择之。","book":"清·吴骞《〈拜经楼诗话〉自序》"},"similar":["披沙拣金","披沙捡金"],"opposite":["泥沙俱下","鱼龙混杂"],"usage":"作谓语、宾语、定语；指从大量的东西中选精"},{"id":20995,"word":"披沥肝胆","pinyin":"pī lì gān dǎn","abbr":"plgd","explanation":"比喻真心相见，倾吐心里话。也形容非常忠诚。同“披肝沥胆”。","source":{"text":"前后陈闻，披沥肝胆，期切之至。","book":"唐·权德舆《权载之文集·卢相公陈乞第五表》"},"example":{"text":"今遇明公，不敢不～。","book":"明·罗贯中《三国演义》第60回"},"similar":["披肝沥胆","披沥肝膈"],"usage":"作谓语、状语；指非常忠诚"},{"id":20996,"word":"披沥肝膈","pinyin":"pī lì gān gé","abbr":"plgg","explanation":"比喻真心相见，倾吐心里话。也形容非常忠诚。同“披肝沥胆”。","source":{"text":"故臣等披沥肝膈，屡有奏述，且乞在任，以尽疲驽。","book":"宋·范仲淹《除枢密副使召赴阙陈让第三状》"},"similar":["披沥肝胆","披肝沥胆"],"usage":"作谓语、状语；指非常忠诚"},{"id":20997,"word":"披沥赤忱","pinyin":"pī lì chì chén","abbr":"plcc","explanation":"披沥：表露，倾吐；赤忱：赤诚，极真诚的心意。倾吐自己至诚的心意。"},{"id":20998,"word":"披红戴花","pinyin":"pī hóng dài huā","abbr":"phdh","explanation":"披着绸，戴着红花。表示喜庆或光荣。","source":{"text":"三百多名进士一听此言，连忙齐刷刷地叩下头去，高呼‘万岁’，恭送皇帝离座升舆。刹时间，鼓乐大作，乐声中，两个礼部来的笔帖式披红戴花，抬出了幡龙金榜。","book":"二月河《雍正皇帝》第二十五回"},"example":{"text":"老百姓给解放军战士～。"},"similar":["披红挂彩","披红插花"],"usage":"作谓语、定语；指喜庆"},{"id":20999,"word":"披红挂彩","pinyin":"pī hóng guà cǎi","abbr":"phgc","explanation":"用红绸和彩帛披在人身上，表示荣宠、慰劳或喜庆。","source":{"text":"随行五百军士，俱披红挂彩，入南郡买办物件。","book":"明·罗贯中《三国演义》"},"example":{"text":"老百姓给红军～慰劳他们。"},"similar":["披红戴花"],"usage":"作谓语、定语；指喜庆等"},{"id":21000,"word":"披红挂绿","pinyin":"pī hóng guà lǜ","abbr":"phgl","explanation":"穿艳丽的服装或带喜庆气氛的装饰。","source":{"text":"你这臭淫妇，平白里又不赴席，又不拜年，披红挂绿是为什么？","book":"清·李百川《绿野仙踪》第54回"},"example":{"text":"几十挂爆竹同时燃起，四部吹鼓手都～站在大门口使足了吃奶气力拼命吹打。","book":"二月河《乾隆皇帝》二"},"usage":"作谓语、定语、状语；用于书面语"},{"id":21001,"word":"披红插花","pinyin":"pī hóng chā huā","abbr":"phch","explanation":"披：覆盖在肩背上。身披红绸，帽插红花。旧时指喜庆事执行接待礼仪者的打扮。","source":{"text":"傧相披红插花，忙到轿前作揖，念了诗赋，请出轿来。","book":"明·冯梦龙《醒世恒言》卷七"},"example":{"text":"一直等到花轿抬上船去以后，本忠这才在傧相的陪伴之下，～，身穿华服，大摇大摆地走出了大门。","book":"吴越《括苍山记恩仇》第六十九"},"similar":["披红挂彩","披红戴花"],"usage":"作谓语、定语、宾语；用于喜庆场合"},{"id":21002,"word":"披缁削发","pinyin":"pī zī xuē fà","abbr":"pzxf","explanation":"缁：黑色，指黑色僧衣；削：剃除。指剃云头发，披上僧衣，出家为僧尼。","source":{"text":"何不舍离爱欲，披缁削发，就此出家。","book":"明·凌濛初《初刻拍案惊奇》卷二十七"},"example":{"text":"子子孙孙，瓜瓞云仍，万代继统，岂可～，效匹夫之所为乎？","book":"明·清溪道人《禅真逸史》第九回"},"similar":["剪发披缁"],"usage":"作谓语、定语、宾语；指出家"},{"id":21003,"word":"披罗戴翠","pinyin":"pī luó dài cuì","abbr":"pldc","explanation":"形容衣饰华丽。","source":{"text":"黑油油的头发，映着一副不施脂粉的黄瘦脸庞，若教他披罗戴翠，人家便要赞他清俊。","book":"许地山《危巢坠简·东野先生》"},"usage":"作谓语、定语；用于人的衣着等"},{"id":21004,"word":"披肝挂胆","pinyin":"pī gān guà dǎn","abbr":"pggd","explanation":"形容对人对事极尽忠诚，毫无保留。","source":{"text":"众将官，当职梦皇上之恩宠，领兵家之大权，在我者披肝挂胆，在尔者并力同心。","book":"明·沈采《千金记·登拜》"},"similar":["披露肝胆","披肝露胆"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":21005,"word":"披肝沥胆","pinyin":"pī gān lì dǎn","abbr":"pgld","explanation":"披：披露；沥：往下滴。比喻真心相见，倾吐心里话。也形容非常忠诚。","source":{"text":"虽访问所不及，犹将披肝沥胆，以效其区区之忠。","book":"唐·黄滔《启裴侍郎》：“沾巾堕睫，沥胆披肝，不在他门，誓于死节。”宋·司马光《体要疏》"},"example":{"text":"我每遇着我所敬爱而知心的人，就喜欢～地畅谈。","book":"邹韬奋《经历·初出茅庐》"},"similar":["肝胆相照","诚心诚意"],"opposite":["勾心斗角","尔虞我诈"],"usage":"作谓语、状语；指非常忠诚","story":["东汉时期，曹操率20万大军围攻徐州的刘备，刘备兵败投靠了袁绍，关羽带刘备的两位夫人陷于曹营，关羽帮曹操杀了袁绍的名将颜良与文丑。袁绍气得要杀刘备，刘备修书给关羽。关羽回信说一定要披肝沥胆为刘备效劳，于是过五关斩六将回到刘备身边"]},{"id":21006,"word":"披肝沥血","pinyin":"pī gān lì xuè","abbr":"pglx","explanation":"比喻竭尽忠诚。","source":{"text":"披肝沥血，昧死上陈。","book":"唐·柳宗元《为南承嗣请从军状》"},"example":{"text":"臣之忧危迫切，～之诚，亦已屡渎于天聪。","book":"宋·欧阳修《又乞外郡第三札子》"},"similar":["披肝沥胆"],"usage":"作谓语、定语；指竭尽忠诚"},{"id":21007,"word":"披肝糜胃","pinyin":"pī gān mí wèi","abbr":"pgmw","explanation":"糜：烂。忠诚不贰，甘作任何牺牲。","source":{"text":"臣等所以披肝糜胃，忘寝与食者也。","book":"《晋书·刘聪载记》"},"usage":"作谓语、定语；用于人忠诚"},{"id":21008,"word":"披肝露胆","pinyin":"pī gān lù dǎn","abbr":"pgld","explanation":"指竭诚相告或竭尽忠诚。同“披露肝胆”。","source":{"text":"吾得披肝露胆，没身何恨！","book":"《晋书·杜弢传》"},"example":{"text":"王粲的《登楼赋》，其情调远规灵均，近同平子，虽未尽宛曲之趣，实是～之作。","book":"郑振铎《插图本中国文学史》第20章"},"similar":["披露肝胆","披肝挂胆"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":21009,"word":"披荆斩棘","pinyin":"pī jīng zhǎn jí","abbr":"pjzj","explanation":"劈开丛生多刺的野生植物。比喻在创业过程中或前进道路上清除障碍，克服重重困难。","source":{"text":"为吾披荆棘，定关中。","book":"《后汉书·冯异传》"},"example":{"text":"这却正见出他是在开辟着一条新的道路；而那～，也正是一个斗士的工作。","book":"朱自清《闻一多先生怎样走着中国文学的道路》"},"similar":["乘风破浪","一往无前"],"opposite":["畏首畏尾","瞻前顾后"],"usage":"作谓语、宾语、状语；形容创业的艰苦","story":["东汉初年，大将冯异跟随刘秀打天下，深得刘秀的信任。刘秀定都洛阳后，冯异镇守长安，当地百姓称他为“咸阳王”，有人进谗言给光武帝，刘秀深知冯异的忠心，在他起义时为他披荆斩棘，忠心耿耿为他打江山，是忠实可靠"]},{"id":21010,"word":"披袍擐甲","pinyin":"pī páo huàn jiǎ","abbr":"pphj","explanation":"披：穿；擐：套。穿上战袍，套上铠甲。指做好战斗准备。","source":{"text":"俺元帅遇难逢危，迭不的披袍擐甲。","book":"元·无名氏《鞭打单雄信》第三折"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":21011,"word":"披裘带索","pinyin":"pī qiú dài suǒ","abbr":"pqds","explanation":"形容衣着粗陋。","source":{"text":"昔者楚丘先生，行年七十，披裘带索，往见孟尝君，欲趋不能进。","book":"西汉·刘向《新序·杂事五》"},"usage":"作谓语、定语；用于贫民"},{"id":21012,"word":"披裘负薪","pinyin":"pī qiú fù xīn","abbr":"pqfx","explanation":"裘：皮毛衣服。穿着裘褐，背着柴薪。形容志高行洁的隐士。","source":{"text":"吾当夏五月，披裘而薪，岂取金者哉！","book":"东汉·王充《论衡·书虚》"},"example":{"text":"勿据梧而策杖，亦～。","book":"唐·王绩《游北山赋》"},"usage":"作定语；指志高行洁的隐士","story":["春秋时期，吴王最小的儿子延陵季子姬札经常出使各国，见识广博，名气很大。他出使齐国时在路边发现一块金子，叫路边砍柴人去拣。没想砍柴人说我五月天还披着皮袄，背柴禾，像那种拣金子的人吗？延陵季子感到遇到高人而非常惭愧"]},{"id":21013,"word":"披褐怀金","pinyin":"pī hè huái jīn","abbr":"phhj","explanation":"披：穿着；褐：粗布衣服。穿粗布衣服，而怀藏金玉。比喻表面平常而内里丰富。","source":{"text":"势家多所宜，咳唾自成珠，披褐怀金玉，兰蕙化为刍。","book":"汉·赵壹《刺世疾邪赋》"}},{"id":21014,"word":"披襟散发","pinyin":"pī jīn sàn fà","abbr":"pjsf","explanation":"敞开衣襟，蓬松着头发。形容不修边幅的的悠闲神态。","source":{"text":"休倩傍人为正冠，披襟散发最宜闲。水云况得平生趣，富贵何曾着眼看。","book":"宋·杨无咎《鹧鸪天》词"},"example":{"text":"羊角飘尘，金乌烁石，雨凉念秋。有虚堂临水，～，纱幮雾卷，湘簟波浮。","book":"宋·赵师侠《沁园春》词"}},{"id":21015,"word":"披襟解带","pinyin":"pī jīn jiě dài","abbr":"pjjd","explanation":"比喻敞开胸怀，心地坦白。","source":{"text":"遂披襟解带，留连不能已。","book":"南朝·宋·刘义庆《世说新语》"},"example":{"text":"更闻理外事无心，～相追寻。","book":"明·陈子龙《伟南筑居远郊鲜入城市近闻其事释氏甚谨作诗问之》"},"usage":"作谓语、宾语、定语；用于书面语","story":["晋朝时期，王羲之为会稽内史时，孙兴公推荐支道林，说他看问题拔新领异。王羲之自傲不愿见他。后来王羲之外出办事见到高僧支道林，就和他谈起了《庄子·逍遥游》，没想到支道林的论述十分精辟与新奇，王羲之披襟解带，洗耳恭听"]},{"id":21016,"word":"披霄决汉","pinyin":"pī xiāo jué hàn","abbr":"pxjh","explanation":"指冲出霄汉。","source":{"text":"披霄决汉出沆漭，瞥裂左右遗星辰。","book":"唐·柳宗元《行路难》诗"},"usage":"作谓语、定语；用于比喻句"},{"id":21017,"word":"披霜冒露","pinyin":"pī shuāng mào lù","abbr":"psml","explanation":"冒：冲。身披寒霜，头顶寒露。形容星夜兼程赶路。","source":{"text":"说不尽那水宿风餐，披霜冒露。","book":"明·吴承恩《西游记》第36回"},"similar":["披星戴月","披霜带露"],"usage":"作谓语、定语、宾语；用于赶路等"},{"id":21018,"word":"披霜带露","pinyin":"pī shuāng dài lù","abbr":"psdl","explanation":"身披寒霜，头顶寒露。形容星夜兼程赶路","source":{"text":"披霜带露许多日子，方到了成安县。","book":"清·李百川《绿野仙踪》第25回"},"similar":["披霜冒露"],"usage":"作谓语、定语、宾语；用于赶路等"},{"id":21019,"word":"披露肝胆","pinyin":"pī lù gān dǎn","abbr":"plgd","explanation":"指竭诚相告或竭尽忠诚。","source":{"text":"披露肝胆，不知忌讳，实战实惶。","book":"唐·陈子昂《安宗子科》"},"example":{"text":"臣生长草野，不晓禁忌，～，书不择言。","book":"南朝·宋·范晔《后汉书·郎顗传》"},"similar":["披肝露胆","披肝挂胆"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":21020,"word":"披露腹心","pinyin":"pī lù fù xīn","abbr":"plfx","explanation":"披露：显露，展示；腹心：真诚的心意。形容以真心示人。","source":{"text":"惟前后披露腹心，自从始初以至于终，实不藏情。","book":"《三国志·蜀志·法正传》"}},{"id":21021,"word":"披麻带孝","pinyin":"pī má dài xiào","abbr":"pmdx","explanation":"指服重孝。","source":{"text":"乃披麻带孝而入，哭拜于灵前。","book":"明·罗贯中《三国演义》"},"example":{"text":"父亲驾鹤西去，他～，悲痛万分。"},"similar":["披麻带索"],"usage":"作谓语、状语；指哀悼"},{"id":21022,"word":"披麻带索","pinyin":"pī má dài suǒ","abbr":"pmds","explanation":"犹披麻带孝。指服重孝。","source":{"text":"老贼！你年七八十岁，也不识做孝。披麻带索便是孝。","book":"元·高明《琵琶记·蔡公逼试》"},"similar":["披麻带孝"],"usage":"作谓语、状语、宾语；指哀悼"},{"id":21023,"word":"披麻戴孝","pinyin":"pī má dài xiào","abbr":"pmdx","explanation":"指长辈去世，子孙身披麻布服，头上戴白，表示哀悼。","source":{"text":"你也想着一家儿披麻带孝为何由，故来这灵堂里寻斗殴。","book":"元·无名氏《冤家债主》第二折"},"example":{"text":"我如今教他～，与亲儿一般行礼，一应殡殓之费，都要他支持。","book":"明·冯梦龙《喻世明言·蒋兴歌重会珍珠衫》"},"similar":["披麻带孝","披麻带索"],"usage":"作谓语、状语、宾语；指哀悼"},{"id":21024,"word":"披麻救火","pinyin":"pī má jiù huǒ","abbr":"pmjh","explanation":"披着麻去救火。比喻惹火烧身，自招灾祸。","source":{"text":"则落你好似披麻救火，蒯彻也不似那般人随风倒舵。","book":"元·无名氏《赚蒯通》第三折"},"example":{"text":"若强动兵甲，正犹～，必致自焚也。","book":"明·罗贯中《三国演义》第一百二十回"},"similar":["抱薪救火"],"usage":"作谓语、定语；指自招灾祸"},{"id":21025,"word":"抬头不见低头见","pinyin":"tái tóu bù jiàn dī tóu jiàn","abbr":"ttbjdtj","explanation":"比喻经常见面。","example":{"text":"我们是邻居，～，何必把关系闹僵呢？"},"usage":"作谓语、宾语、定语；用于口语"},{"id":21026,"word":"抬手动脚","pinyin":"tái shǒu dòng jiǎo","abbr":"tsdj","explanation":"一抬手，一动脚。也指打人。","example":{"text":"但是一想到就要会见的是一位高品人物，不免心情紧张，走起路来，～都显得僵硬。","book":"刘绍棠《狼烟》十三"}},{"id":21027,"word":"抬脚动手","pinyin":"tái jiǎo dòng shǒu","abbr":"tjds","explanation":"指一举一动。","source":{"text":"二诸葛原来叫刘修德，当年做过生意，抬脚动手都要论一论阴阳八卦，看一看黄道黑道。","book":"赵树理《小二黑结婚》一"}},{"id":21028,"word":"抱一为式","pinyin":"bào yī wéi shì","abbr":"byws","explanation":"抱：持，守；式：榜样，规范。指不贪多，不外求，把守一作为天下人的榜样。","source":{"text":"是以圣人抱一为天下式。","book":"《老子》"}},{"id":21029,"word":"抱不平","pinyin":"bào bù píng","abbr":"bbp","explanation":"遇见不公平的事，挺身而出，帮助弱小的一方。","source":{"text":"气的我只有替平儿打抱不平。","book":"清·曹雪芹《红楼梦》第45回"},"example":{"text":"他心里替她～。"},"similar":["抱打不平"],"usage":"作谓语、宾语；通常用于“打”后"},{"id":21030,"word":"抱令守律","pinyin":"bào lìng shǒu lǜ","abbr":"blsl","explanation":"死守着律令，不知变通。","source":{"text":"但知抱令守律，早刑时舍，便云我能平狱。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"～的人也会犯错误的。"},"similar":["抱残守缺","因循守旧"],"opposite":["推陈出新"],"usage":"作谓语、宾语、定语；指不知变通"},{"id":21031,"word":"抱佛脚","pinyin":"bào fó jiǎo","abbr":"bfj","explanation":"比喻平时没联系，临时慌忙恳求，后比喻平时没准备，临时慌忙应付。","source":{"text":"垂老抱佛脚，教妻读《黄经》。","book":"唐·孟郊《读经》"},"example":{"text":"事到临头，你只好去～了。"},"similar":["平时不烧香，临时抱佛脚"],"opposite":["防患未然"],"usage":"作谓语、定语、宾语；指慌忙应付","story":["宋朝时期，王安石与客人闲谈，偶然谈到佛经，他感慨地说：“投老欲依僧”，表示想与和尚去做伴。旁人加上一句“急来抱佛脚”。王安石不悦，那人说古诗对谚语，如改成对联则成为“老欲依僧，急来抱佛”，头脚相对"]},{"id":21032,"word":"抱关之怨","pinyin":"bào guān zhī yuàn","abbr":"bgzy","explanation":"抱关：守门人。指职位低微俸禄少的官吏的牢骚。","source":{"text":"自兹以降，迄于孝武，宰辅五世，莫非公侯。遂使缙绅道塞，贤能蔽壅，朝有世及之私，下多抱关之怨。","book":"《后汉书·马武传附二十八将传论》"}},{"id":21033,"word":"抱关击柝","pinyin":"bào guān jī tuò","abbr":"bgjt","explanation":"柝：木梆；抱关：守关；击柝：打更巡夜。守关巡夜的人。比喻职位卑下。","source":{"text":"为贫者，辞尊居卑，辞富居贫。辞尊居卑，辞富居贫，恶乎宜乎？抱关击柝。","book":"《孟子·万章下》"},"example":{"text":"宜乎辞尊而居卑，辞富而居贫，若～者可也。","book":"唐·韩愈《争臣论》"},"usage":"作宾语；指打更的人"},{"id":21034,"word":"抱关执籥","pinyin":"bào guān zhí yuè","abbr":"bgzy","explanation":"持门闩，拿钥匙。指监门小吏的职务。","source":{"text":"知纳言任重，非臣所得久忝。今月丁丑，一章自闻，乞头冗抱关执籥，不意录符很青，授任千里。","book":"汉·蔡邕《巴郡太守谢版》"},"similar":["抱关执钥"],"usage":"作谓语、宾语；用于小官"},{"id":21035,"word":"抱关执钥","pinyin":"bào guān zhí yuè","abbr":"bgzy","explanation":"持门闩，拿钥匙。指监门小吏的职务。","source":{"text":"知纳言任重，非臣所得久忝。今月丁丑，一章自闻，乞头冗抱关执钥，不意录符很青，授任千里。","book":"汉·蔡邕《巴郡太守谢版》"}},{"id":21036,"word":"抱冰公事","pinyin":"bào bīng gōng shì","abbr":"bbgs","explanation":"公事：公务。指旧时官场中清苦的差使。","source":{"text":"当其役者曰：‘又管抱冰公事也。’","book":"宋·陶穀《清异录·官志》"},"usage":"作宾语；指清苦的差使"},{"id":21037,"word":"抱头大哭","pinyin":"bào tóu dà kū","abbr":"btdk","explanation":"形容非常伤心或很是感动的样子。","source":{"text":"两人抱头大哭，哭了一场坐下。","book":"清·吴敬梓《儒林外史》"},"example":{"text":"这一对被海峡分割了40年的夫妻，一经相见，～，慨叹不已。"},"similar":["抱头痛哭"],"opposite":["开怀大笑"],"usage":"作谓语、定语；形容伤心地哭"},{"id":21038,"word":"抱头痛哭","pinyin":"bào tóu tòng kū","abbr":"bttk","explanation":"指十分伤心或感动，抱头大哭。","source":{"text":"这里于家父子同他家里人抱头痛哭。","book":"清·刘鹗《老残游记》第四回"},"example":{"text":"他的妻子不幸去世，他～，悲痛欲绝。"},"similar":["抱头大哭"],"opposite":["开怀大笑"],"usage":"作谓语；形容十分伤心"},{"id":21039,"word":"抱头缩项","pinyin":"bào tóu suō xiàng","abbr":"btsx","explanation":"抱着头，缩着脖子。形容退败畏缩，不敢向前。","source":{"text":"若是我老把势，展旗旛，立马停骖，着那俊才郎倒戈甲，抱头缩项。","book":"元·武汉臣《玉壶春》第二折"},"similar":["缩头缩脑"],"usage":"作谓语、定语、状语；指胆小"},{"id":21040,"word":"抱头鼠窜","pinyin":"bào tóu shǔ cuàn","abbr":"btsc","explanation":"抱着头，象老鼠那样惊慌逃跑。形容受到打击后狼狈逃跑。","source":{"text":"始常山王、成安君故相与为刎颈之交，及争张黡、陈释之事，常山王奉头鼠窜，以归汉王。","book":"《汉书·蒯通传》"},"example":{"text":"吓得这些人一个个～而逃。","book":"清·李宝嘉《文明小史》第九回"},"similar":["逃之夭夭","捧头鼠窜"],"opposite":["大摇大摆","得胜班师"],"usage":"作谓语、状语；形容敌人的狼狈相","story":["楚汉相争时期，在萧何的极力推荐下，刘邦任用韩信为大将，抄了项羽的后路，破赵取齐，占据黄河下游地区，被封为齐王。蒯通积极鼓动韩信与刘邦、项羽三分天下，举出当年常山王张耳抱头鼠窜归降了汉王并出兵消灭了生死与共的好友陈余"]},{"id":21041,"word":"抱子弄孙","pinyin":"bào zǐ nòng sūn","abbr":"bzns","explanation":"弄：逗弄。意谓抱弄子孙，安享快乐。","source":{"text":"自非天崩地陷，当复何愁，但抱子弄孙，日为乐耳。","book":"《晋书·右季龙载记下》"},"example":{"text":"上司来时，干我甚事？我自回去，～嬉他娘。","book":"明·高明《琵琶记·义仓赈济》"},"similar":["含饴弄孙"],"usage":"作谓语、定语；指颐养天年","story":["十六国时期，后赵国君石勒病故，侄儿石虎篡位自立，迁都邺城，他命令尚书张群调拨16万人建筑华林苑和护邺高墙。竣工之日，他进入华林苑，登上最高的凌霄观，希望今后能每天抱子弄孙，快乐度日。不久后赵内乱，他全家被杀"]},{"id":21042,"word":"抱宝怀珍","pinyin":"bào bǎo huái zhēn","abbr":"bbhz","explanation":"怀：藏有。比喻人有美好的品德和才能。","source":{"text":"于皇先生，抱宝怀珍，如何昊穹，既丧斯文。","book":"汉·蔡邕《陈寔碑》"},"similar":["抱瑜握瑾"],"usage":"作谓语、定语；指人的品德"},{"id":21043,"word":"抱屈含冤","pinyin":"bào qū hán yuān","abbr":"bqhy","explanation":"抱屈：受委屈。形容人遭受冤屈。","source":{"text":"朝权国柄，委之群孽，剿戮忠贤，诛残台辅，含冤报痛，噍类靡余。","book":"《梁书·武帝纪上》"},"example":{"text":"～气怎舒，一声击鼓动銮舆。","book":"明·李开先《林冲宝剑记》第十六出"}},{"id":21044,"word":"抱屈衔冤","pinyin":"bào qū xián yuān","abbr":"bqxy","explanation":"抱屈：受委屈；衔冤：含冤。形容人遭受冤屈。","source":{"text":"这三个功臣，抱屈衔冤，诉于天帝。","book":"《新编五代史平话·梁史》上卷"},"example":{"text":"他～而死。"},"similar":["含冤负屈"],"opposite":["平反昭雪"],"usage":"作谓语、状语；形容人遭受冤屈"},{"id":21045,"word":"抱布贸丝","pinyin":"bào bù mào sī","abbr":"bbms","explanation":"布：古代一种货币；贸：买卖。带了钱，来买丝。借指和女子接近。亦指进行商品交易。","source":{"text":"氓之蚩蚩，抱布贸丝。匪来贸丝，来即我谋。","book":"《诗经·卫风·氓》"},"example":{"text":"今羞无语自沉吟，咫尺相思万里心。～君亦误，知音尽付七弦琴。","book":"明·洪楩《清平山堂话本·风月瑞仙亭》"},"similar":["以物易物"],"usage":"作谓语、定语、宾语；指进行商品交易","story":["春秋时期，卫国境内淇水边美丽姑娘淇姑爱上一个年轻商人，年轻商人误了约期，但终究与她成婚。婚后他去郑国做买卖，从此一去不返，伤心的淇姑坐着马车回老家，她边走边唱：“氓之蚩蚩，抱布贸丝。非来贸丝，来即我谋。”"]},{"id":21046,"word":"抱德炀和","pinyin":"bào dé yáng hé","abbr":"bdyh","explanation":"抱：怀抱，引申为坚持；炀：熔化，引申为蕴育。坚持道德实质，蕴育和平气息。 指行仁政，搞团结。","source":{"text":"抱德炀和，以顺天下。","book":"《庄子·徐无鬼》"}},{"id":21047,"word":"抱怨雪耻","pinyin":"bào yuàn xuě chǐ","abbr":"byxc","explanation":"报：报复。雪：洗刷掉。报怨恨，雪耻辱。","source":{"text":"若先王之报怨雪耻，夷万乘之强国。","book":"《战国策·燕策·乐毅报燕王书》"}},{"id":21048,"word":"抱恨终天","pinyin":"bào hèn zhōng tiān","abbr":"bhzt","explanation":"恨：悔恨；终天：终身。旧指因父母去世而一辈子感到悲痛。现指因做错某事而后悔一辈子。","source":{"text":"丹客住了哭，对富翁道：‘本待与主翁完成美事，少尽报效之心，论证知遭此大变，抱恨终天！’","book":"明·凌濛初《初刻拍案惊奇》卷十八"},"example":{"text":"今老母已丧，～，身虽在彼，誓不为设一谋。","book":"明·罗贯中《三国演义》第四十一回"},"similar":["抱恨终身","终天之恨","死不瞑目"],"opposite":["死而无憾","心甘情愿"],"usage":"作谓语、定语；形容无法弥补的遗憾"},{"id":21049,"word":"抱恨黄泉","pinyin":"bào hèn huáng quán","abbr":"bhhq","explanation":"黄泉：人死埋葬的地下，指阴间。心怀遗憾离开人世，死有遗恨。","source":{"text":"臣所在孤危，悬命锋镝，湮灭土灰，呼吸无期。诚恐所怀随躯腐朽，抱恨黄泉。","book":"唐·李贤等引注《邕别传》"},"similar":["死不瞑目"],"opposite":["死而无憾"],"usage":"作谓语、宾语；用于处事等"},{"id":21050,"word":"抱愚守迷","pinyin":"bào yú shǒu mí","abbr":"bysm","explanation":"抱、守：守住不放，引申为坚持；愚：愚昧；迷：沉迷。指固守己见。","source":{"text":"愈不肖，行能诚无可取，行己颇僻，与世俗异态，抱愚守迷。","book":"唐·韩愈《上考功崔虞部书》"}},{"id":21051,"word":"抱成一团","pinyin":"bào chéng yī tuán","abbr":"bcyt","explanation":"保持一致，行动起来像一个人。形容关系极为亲密。","source":{"text":"刘向明和另外两人，抱成一团，异想天开地搞什么科学研究，在同学中造成很坏的影响。","book":"程树榛《大学时代》"},"example":{"text":"他们相互～，结党营私。"},"similar":["打成一片"],"opposite":["一盘散沙"],"usage":"作谓语；指关系亲密"},{"id":21052,"word":"抱才而困","pinyin":"bào cái ér kùn","abbr":"bcek","explanation":"很有都能而得不到重用，处境困窘。","source":{"text":"至于长者长抱才而困，则又令我怅然有感。","book":"明·宗臣《报刘一丈书》"}},{"id":21053,"word":"抱打不平","pinyin":"bào dǎ bù píng","abbr":"bdbp","explanation":"遇见不公平的事，挺身而出，帮助受欺负的一方。","source":{"text":"气的我只有替平儿打抱不平。","book":"清·曹雪芹《红楼梦》第四十五回"},"example":{"text":"不瞒两位说，老汉平生，最喜欢劫副教授济贫抑强扶弱～。","book":"清·曾朴《孽海花》第三十五回"},"similar":["打抱不平"],"opposite":["见死不救"],"usage":"作谓语、定语；指为人出头"},{"id":21054,"word":"抱朴含真","pinyin":"bào pǔ hán zhēn","abbr":"bphz","explanation":"抱：保；朴：朴素；真：纯真、自然。道家主张人应保持并蕴含朴素、纯真的自然天性，不要沾染虚伪、狡诈而玷污、损伤人的天性。","source":{"text":"傲然自足，抱朴含真。","book":"《老子》第十九章：“见素抱朴，少私寡欲。”晋·陶潜《劝农》"},"similar":["抱素怀朴"],"usage":"作谓语、定语；用于为人"},{"id":21055,"word":"抱朴寡欲","pinyin":"bào pǔ guǎ yù","abbr":"bpgy","explanation":"抱：保；朴：朴素；寡：少。守其本真，不为物欲所诱惑。","source":{"text":"见素抱朴，少私寡欲。","book":"《老子》第十九章"}},{"id":21056,"word":"抱枝拾叶","pinyin":"bào zhī shí yè","abbr":"bzsy","explanation":"犹言舍本逐末。比喻不抓根本环节，而只在枝节问题上下功夫。","source":{"text":"人既发扬踔厉矣，则邦国亦以兴起。奚事抱枝拾叶，徒金铁国会立宪之云乎？","book":"鲁迅《坟·文化偏至论》"}},{"id":21057,"word":"抱柱之信","pinyin":"bào zhù zhī xìn","abbr":"bzzx","explanation":"用以表示坚守信约。","source":{"text":"常存抱柱信，岂上望夫台。","book":"《庄子·盗跖》：“尾生与女子期于梁下，女子不来，水至不去，抱梁柱而死。”《史记·苏秦列传》：“信如尾生，与女子期于梁下，女子不来，水至不去，抱柱而死。”唐·李白《长干行》诗"},"example":{"text":"俞陛云《唐五代两宋词选释》：长守尾生～，拼减沈郎腰带之围，真情至语。","book":"惠淇源《婉约词》六"},"usage":"作宾语；指人守信"},{"id":21058,"word":"抱柱含谤","pinyin":"bào zhù hán bàng","abbr":"bzhb","explanation":"抱柱：比喻坚守信约。坚守信约却遭到诽谤。","source":{"text":"是以虽董司直绳，不能不深其文，抱柱含谤，不得不输其理。","book":"《晋书·石崇传》"}},{"id":21059,"word":"抱椠怀铅","pinyin":"bào qiàn huái qiān","abbr":"bqhq","explanation":"铅，铅粉；椠，木简。皆书写用具。指勤于写作、校勘。同“握铅抱椠”。","source":{"text":"然且抱椠怀铅，出入乎承明之署；荷囊持橐，上下乎太微之廷。","book":"宋·沈遵《谢两府三启》"},"similar":["握椠怀铅"],"usage":"作谓语、定语；指写作"},{"id":21060,"word":"抱残守缺","pinyin":"bào cán shǒu quē","abbr":"bcsq","explanation":"抱着残缺陈旧的东西不放。形容思想保守，不求改进。","source":{"text":"参见“保残守缺”。"},"example":{"text":"这些似乎都是～，汇集众说而成。","book":"朱自清《经典常谈·周易第二》"},"similar":["因循守旧","墨守成规","故步自封"],"opposite":["推陈出新","自我作故","标新立异"],"usage":"作谓语、宾语、定语、状语；形容人守旧","story":["西汉著名文学家刘向的小儿子刘歆在汉哀帝时任骑都尉，奉车光禄大夫，他向汉哀帝建议派专人研究《左传》，同行十分不满意，他指责他们因循守旧，抱残守缺，最后被同行联合排挤出京城，只好去做河内郡太守"]},{"id":21061,"word":"抱残守阙","pinyin":"bào cán shǒu quē","abbr":"bcsq","explanation":"①守着残缺的东西不放。形容思想保守，不接受新事物。②谓笃守古学古道。③喻在条件很差的情况下坚持着做。","source":{"text":"清·江藩《汉学师承记·顾炎武》：“二君以瑰异之质，负经世之才……岂若抱残守阙之俗儒，寻章摘句之世士也哉？”阙，一本作“缺”。"},"example":{"text":"在新产品、新设备、新工艺、新材料竞相涌现的今天，任何一个企业，如果～，不注意品种质量，将会走投无路。","book":"《人民日报》1981.4.2"},"similar":["抱残守缺"],"opposite":["推陈出新"],"usage":"作谓语、宾语、状语；形容人守旧"},{"id":21062,"word":"抱法处势","pinyin":"bào fǎ chǔ shì","abbr":"bfcs","explanation":"比喻把法和势结合起来，用势来保证法的推行。","source":{"text":"抱法处势则治，背法去势则乱。","book":"《韩非子·难势》"},"usage":"作宾语；指把法和势结合起来"},{"id":21063,"word":"抱火卧薪","pinyin":"bào huǒ wò xīn","abbr":"bhwx","explanation":"比喻处境险恶，而不自知。或指险事即将出现。","source":{"text":"夫抱火厝之积薪之下，而寝其上，火未及燃，因谓之安，偷安者也。方今之势，何以异此？","book":"语出汉·贾谊《新书·数宁》"},"example":{"text":"谊之所欲痛哭，比今为缓；～之喻，于今而急。","book":"《三国志·吴志·华覈传》"},"similar":["抱火寝薪"],"usage":"作谓语、定语；指做事方法不对"},{"id":21064,"word":"抱火厝薪","pinyin":"bào huǒ cuò xīn","abbr":"bhcx","explanation":"厝：同“措”，置放。薪：柴火。把火放在柴草底下。比喻危机即将出现。","source":{"text":"夫抱火厝之积薪之下而寝其上，火未及燃，因谓之安，方今之势，何以异此？","book":"语出《汉书·贾谊传》"},"example":{"text":"汉文之世，九州晏然，贾谊独以为如抱火厝于积薪之下而寝其上。","book":"《资治通鉴·世祖武皇帝泰始三年》"}},{"id":21065,"word":"抱火寝薪","pinyin":"bào huǒ qǐn xīn","abbr":"bhqx","explanation":"抱火：捧着火种；寝薪：睡在柴草堆上。比喻危机潜伏，人安于险境而不自知。也比喻危机即将出现。","source":{"text":"夫抱火厝之积薪之下，而寝其上，火未及燃，因谓之安。","book":"汉·贾谊《上陈政事疏》"},"similar":["抱火卧薪"],"usage":"作谓语、定语；指做事方法不对"},{"id":21066,"word":"抱玉握珠","pinyin":"bào yù wò zhū","abbr":"bywz","explanation":"比喻满腹经纶，富有才学。","source":{"text":"当此之时，人人自谓握灵蛇之珠，家家自谓抱荆山之玉。","book":"语出三国·魏·曹植《与杨德祖书》"},"example":{"text":"～真博学，经天纬地实奇英。","book":"《再生缘》第十一回"},"usage":"作谓语、定语；指人的才学"},{"id":21067,"word":"抱瑜握瑾","pinyin":"bào yú wò jǐn","abbr":"bywj","explanation":"瑜、瑾：美玉。比喻具有纯洁高尚的品德。","source":{"text":"朔气纵横，壮心落落，抱瑜握瑾，沉浮闾巷之间。","book":"明·徐献忠《唐诗品》"},"similar":["抱宝怀珍"],"usage":"作谓语、定语；指人的品德"},{"id":21068,"word":"抱璞泣血","pinyin":"bào pǔ qì xuè","abbr":"bpqx","explanation":"比喻怀才不遇上，伤心悲痛。","source":{"text":"和抱璞而泣血兮，安得良工而剖之。","book":"汉·东方朔《七谏·谬谏》"}},{"id":21069,"word":"抱瓮出灌","pinyin":"bào wèng chū guàn","abbr":"bwcg","explanation":"抱着水瓮去灌溉。比喻费力多而收效少。","source":{"text":"凿隧而入井，抱瓮而出灌。","book":"《庄子·天地》"},"similar":["抱瓮灌圆"],"usage":"作谓语、定语；比喻安于现状"},{"id":21070,"word":"抱瓮灌园","pinyin":"bào wèng guàn yuán","abbr":"bwgy","explanation":"比喻安于拙陋的淳朴生活。","source":{"text":"传说孔子的学生子贡，在游楚返晋过汉阴时，见一位老人一次又一次地抱着甕去浇菜，“搰搰然用力甚多而见功寡”，就建议他用机械汲水。老人不愿意，并且说：这样做，为人就会有机心，“吾非不知，羞而不为也。”见《庄子·天地》"},"example":{"text":"投竿垂饵，晦幽迹于渭滨；～，绝机心于汉渚。","book":"明·梁辰鱼《浣纱记·谈义》"},"similar":["抱瓮出灌"],"usage":"作谓语、定语；比喻安于现状，不想改变","story":["传说孔子的学生子贡，在游楚返晋过汉阴时，看见一位老人一次又一次地抱着水瓮去浇菜，就建议他用机械汲水。老人不愿意，并且说：“这样做，为人就会有机心。我并不是不知道那样做，而是不愿那样做。”"]},{"id":21071,"word":"抱痛西河","pinyin":"bào tò xī hé","abbr":"btxh","explanation":"痛：哀痛；西河：古地名，战国魏地。原指指孔子弟子子夏在西河丧子而哭瞎眼睛的事。后泛指死了儿子而极其头痛。","source":{"text":"孔子既没，子夏居西河教授，为魏文侯师。其子死，哭之失明。","book":"典出《史记·仲尼弟子传·卜商传》"}},{"id":21072,"word":"抱素怀朴","pinyin":"bào sù huái pǔ","abbr":"bshp","explanation":"素、朴：指事物的自然状态。借指民风淳厚，人心安定。","source":{"text":"易乱除邪，革正异俗，兆民反本，抱素怀朴。","book":"《乐府诗集·郊庙歌辞一·汉郊祀歌》"},"usage":"作谓语、定语；指社会风气"},{"id":21073,"word":"抱罪怀瑕","pinyin":"bào zuì huái xiá","abbr":"bzhx","explanation":"瑕：美玉上的斑点，比喻缺点错误。指因犯过错误而感到内疚。","source":{"text":"或有抱罪怀瑕，与下同疾，纲网弛纵，莫相举察。","book":"《后汉书·蔡邕传》"}},{"id":21074,"word":"抱蔓摘瓜","pinyin":"bào wàn zhāi guā","abbr":"bwzg","explanation":"顺藤摸瓜。比喻扩大案情，牵连无罪的人。","source":{"text":"种瓜黄台下，瓜熟了离离。一摘使瓜好，再摘令瓜稀，三摘尚自可，摘绝抱蔓归。","book":"《乐府诗集·杂歌谣辞·黄台瓜辞》"},"example":{"text":"～余我在，破巢完卵似君稀。","book":"清·钱谦益《临城驿壁见方侍御孩未题诗》"},"similar":["顺藤摸瓜","斩尽杀绝"],"usage":"作谓语、定语；比喻斩尽杀绝","story":["唐高宗时期，朝政由皇后武则天代为处理，武后的野心很大，手段十分残忍。她废太子李忠立李弘做太子，后把太子弘毒死，立李贤为太子。他日夜忧思作《黄台瓜辞》：“种瓜黄台下，瓜熟子离离。一摘使瓜好，再摘令瓜稀，三摘犹自可，摘绝抱蔓归。”"]},{"id":21075,"word":"抱薪救火","pinyin":"bào xīn jiù huǒ","abbr":"bxjh","explanation":"薪：柴草。抱着柴草去救火。比喻用错误的方法去消除灾祸，结果使灾祸反而扩大。","source":{"text":"且夫以地事秦，譬犹抱薪救火，薪不尽，火不灭。","book":"《史记·魏世家》"},"example":{"text":"若听诸葛亮之言，妄动甲兵，此所谓～也。","book":"明·罗贯中《三国演义》"},"similar":["火上浇油","饮鸩止渴"],"opposite":["雪中送炭","根除祸患","釜底抽薪"],"usage":"作谓语、宾语、定语；比喻没能阻止反而加速","story":["战国时期，各诸侯国之间互相吞并，魏国曾经多次受到秦国的进攻，每次均是割地求和。魏安王四年秦国打败魏、赵、韩三国联军，魏安王又想用割地求和这种抱薪救火的办法来解决问题，不听苏代“联六国抗秦”的建议，终于被秦所灭"]},{"id":21076,"word":"抱薪救焚","pinyin":"bào xīn jiù fén","abbr":"bxjf","explanation":"比喻用错误的方法去消除灾祸，结果使灾祸反而扩大。同“抱薪救火”。","source":{"text":"此何异乎抱薪救焚、扇火止沸哉！","book":"《三国志·魏志·陶谦传》“太祖以粮少引军还”裴松之注引三国吴韦昭《吴书》"},"similar":["抱薪救火"],"opposite":["釜底抽薪"],"usage":"作谓语、宾语、定语；比喻没能阻止反而加速"},{"id":21077,"word":"抱虎枕蛟","pinyin":"bào hǔ zhěn jāo","abbr":"bhzj","explanation":"枕：以头枕物；蛟：古代传说中的独角龙。双手抱着老虎，送枕着蛟龙。比喻处境危险。","source":{"text":"况与大敌为邻，抱虎枕蛟，事变叵测，顾可侈因人之获，使边臣论功，朝廷送德。","book":"《宋史·洪咨夔传》"}},{"id":21078,"word":"抱表寝绳","pinyin":"bào biǎo qǐn shéng","abbr":"bbqs","explanation":"指坐卧不离准则。意谓坚持德操。","source":{"text":"指坐卧不离准则。意谓坚持德操。"},"example":{"text":"《文子·下德》：“法阴阳者，承天地之和，德与天地参光，明与日月并照，精神与鬼神齐灵，戴圆履方，抱表寝绳，内能理身，外得人心，发施号令，天下从风。”"},"usage":"作宾语、定语；指人守德"},{"id":21079,"word":"抱诚守真","pinyin":"bào chéng shǒu zhēn","abbr":"bcsz","explanation":"抱：存在心里。志在真诚，恪守不违。","source":{"text":"上述诸人，其为品性言行思惟，虽以种族有殊，外缘多别，因现种种状，而实统于一宗；无不刚健不挠，抱诚守真。","book":"鲁迅《坟·摩罗诗力说》"},"example":{"text":"～的做法往往要付出相当的代价。"},"usage":"作谓语、定语；指坚守真理"},{"id":21080,"word":"抱负不凡","pinyin":"bào fù bù fán","abbr":"bfbf","explanation":"抱负：远大的志向。指有远大的志向，不同一般。","source":{"text":"念吾兄抱负不凡，不见于用。","book":"宋·楼钥《绩溪县尉楼君墓志铭》"},"example":{"text":"雨村兄真～也。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["壮志凌云"],"opposite":["鼠目寸光"],"usage":"作谓语、定语；指人的理想"},{"id":21081,"word":"抱赃叫屈","pinyin":"bào zāng jiào qū","abbr":"bzjq","explanation":"手里拿着赃物却叫喊冤枉。比喻在确凿的证据面前无理狡辩。","source":{"text":"古人恁么说话，大似抱赃叫屈。","book":"宋·释普济《五灯会元》卷十二"}},{"id":21082,"word":"抱雪向火","pinyin":"bào xuě xiàng huǒ","abbr":"bxxh","explanation":"向火：烤火。抱着雪烤火。比喻做法和目的不一致，不能解决问题。"},{"id":21083,"word":"抱鸡养竹","pinyin":"bào jī yǎng zhú","abbr":"bjyz","explanation":"唐朝新昌县令夏侯彪之一到任就叫里正代他抱小鸡养竹子，自己坐收渔利。比喻官吏坐地盘剥，不择手段。","example":{"text":"像夏侯彪之这样～的官吏今天也不乏其人。"},"usage":"作宾语、定语；指官吏贪财","story":["唐朝时期，新昌县令夏侯彪之刚到任就向里正打听鸡蛋的行情，拿出一万钱让里正买三万颗鸡蛋孵成小鸡，长大后可卖30万钱，然后拿出一万钱买五万根竹笋，培育成竹子可卖50万钱，他用这种抱鸡养竹的手段巧取豪夺一年赚了80万钱"]},{"id":21084,"word":"抵掌而谈","pinyin":"dǐ zhǎng ér tán","abbr":"dzet","explanation":"抵掌：击掌。指谈得很融洽。","source":{"text":"见说赵王于华屋之下，抵掌而谈。","book":"《战国策·秦策一》"},"example":{"text":"善言论者～，问地球一切事。","book":"鲁迅《月界旅行》第十三回"},"similar":["抵足而谈","促膝谈心"],"usage":"作谓语、定语；形容气氛融洽","story":["战国时期，苏秦到秦国去游说秦惠王实行连横的主张遭到失败，就回家乡洛阳潜心研究兵法。一年后他到赵国去拜谒赵王，与赵王抵掌而谈，鼓吹他的合纵主张，赵王十分高兴，封苏秦为武安君，授以相印，商议六国合纵策略"]},{"id":21085,"word":"抵掌谈兵","pinyin":"dǐ zhǎng tán bīng","abbr":"dztb","explanation":"抵掌：击掌；兵：军事。拍着手谈军事。形容毫无拘束地畅谈军事。","source":{"text":"见说赵王于华屋之下，抵掌而谈。","book":"《战国策·秦策一》"},"example":{"text":"挥毫作赋，则颉颃相如；～，则伯仲诸葛。","book":"清·夏敬渠《野叟曝言》第一回"},"usage":"作谓语、定语；用于战争等"},{"id":21086,"word":"抵死漫生","pinyin":"dǐ sǐ màn shēng","abbr":"dsms","explanation":"犹言竭尽思虑；千方百计。","source":{"text":"抵死漫生要见，偷方觅便求欢。","book":"宋·向滈《西江月》词"},"similar":["抵死瞒生"],"usage":"作谓语、定语；形容竭尽思虑"},{"id":21087,"word":"抵死瞒生","pinyin":"dǐ sǐ mán shēng","abbr":"dsms","explanation":"犹言竭尽思虑；千方百计。同“抵死漫生”。","source":{"text":"我安排着脱身利己的机谋，正中这抵死瞒生的手策。","book":"明·无名氏《庞掠四郡》第三折"},"similar":["抵死谩生"],"usage":"作谓语、定语；形容竭尽思虑"},{"id":21088,"word":"抵死谩生","pinyin":"dǐ sǐ màn shēng","abbr":"dsms","explanation":"谩：谎骗。形容殚智竭虑，绞尽脑汁。","source":{"text":"抵死漫生要见，偷方觅便求欢。","book":"宋·向滈《西江月》词"},"example":{"text":"待阎王道俺无凭准，～断不定，也不共他争，我专指着伊家做照证。","book":"金·董解元《西厢记诸宫调》卷五"},"similar":["殚智竭虑","绞尽脑汁","抵死漫生"],"usage":"作谓语；形容竭尽思虑"},{"id":21089,"word":"抵瑕蹈隙","pinyin":"dǐ xiá dǎo xì","abbr":"dxdx","explanation":"隙：裂缝，间隙。指攻击别人的弱点或错误。","source":{"text":"而仆乃蹇浅窄僻，跳浮嚄唶，抵瑕陷厄。","book":"唐·柳宗元《答问》"},"example":{"text":"要请人帮忙，想～拣人的便宜，要先懂万国公法，不然处处授人权柄。","book":"高阳《清宫外史》下册"}},{"id":21090,"word":"抵瑕陷厄","pinyin":"dǐ xiá xiàn è","abbr":"dxxe","explanation":"抵：触；瑕：瑕疵，缺点；陷：攻破；厄：迫害。指攻击别人的弱点或错误。","source":{"text":"蹇浅窄僻，跳浮嚄唶，抵瑕陷厄。","book":"唐·柳宗元《答问》"},"example":{"text":"他最善于～。"},"usage":"作谓语、宾语、状语；指攻击别人"},{"id":21091,"word":"抵背扼喉","pinyin":"dǐ bèi è hóu","abbr":"dbeh","explanation":"抵：按住；扼：掐住。按住脊背，掐住咽喉。比喻控制要害之地。","source":{"text":"抵背扼喉，塞其归路。","book":"唐太宗李世民《赐诏》"},"similar":["拊背扼喉"],"usage":"作谓语；比喻控制要害"},{"id":21092,"word":"抵足而卧","pinyin":"dǐ zú ér wò","abbr":"dzew","explanation":"脚对着脚，同榻而睡。形容关系亲密，情意深厚。同“抵足而眠”。","source":{"text":"一日，众官皆散，权（孙权）留鲁肃共饮，至晚同榻抵足而卧。","book":"明·罗贯中《三国演义》第二十九回"},"similar":["抵足而眠"],"usage":"作谓语、定语；指双方情谊深厚"},{"id":21093,"word":"抵足而眠","pinyin":"dǐ zú ér mián","abbr":"dzem","explanation":"脚对着脚，同榻而睡。形容关系亲密，情意深厚。","source":{"text":"瑜曰：‘久不与子翼同榻，今宵抵足而眠。’","book":"明·罗贯中《三国演义》第45回"},"example":{"text":"他们～，畅谈人生。"},"similar":["志同道合"],"opposite":["同床异梦","貌合神离"],"usage":"作谓语、定语；指双方情谊深厚"},{"id":21094,"word":"抵足谈心","pinyin":"dǐ zú tán xīn","abbr":"dztx","explanation":"同床共卧，亲切谈心。形容彼此间情谊深厚。","source":{"text":"此荒港又不知离城多远……不如竟在弟船过夜，抵足谈心。","book":"清·夏敬渠《野叟曝言》第48回"},"example":{"text":"两人～，彻夜不眠。"},"similar":["促膝谈心"],"usage":"作谓语、定语；指深厚的情谊"},{"id":21095,"word":"抹一鼻子灰","pinyin":"mǒ yī bí zi huī","abbr":"mybzh","explanation":"比喻本想巴结讨好，结果反倒碰个钉子，落得很没趣。","source":{"text":"赵姨娘来时，兴兴头头，谁知抹了一鼻子灰，满心生气，又不敢露出来，只得讪讪的出来了。","book":"清·曹雪芹《红楼梦》第67回"},"example":{"text":"我被～，顿时就没兴趣了。"},"similar":["自讨没趣"],"usage":"作谓语；指自讨没趣"},{"id":21096,"word":"抹不下脸","pinyin":"mā bù xià liǎn","abbr":"mbxl","explanation":"碍于脸面或情面。","source":{"text":"当着郭振山的面，谁都抹不下脸。","book":"柳青《创业史》"},"example":{"text":"你不要觉得～。"},"similar":["难为情","拉不下脸"],"opposite":["六亲不认"],"usage":"作谓语、宾语；指碍于脸面或情面"},{"id":21097,"word":"抹月批风","pinyin":"mǒ yuè pī fēng","abbr":"mypf","explanation":"抹：细切；批：薄切。用风月当菜肴。指吟啸风月，清高自赏。","source":{"text":"贫家何以娱客，但知抹月批风。","book":"宋·苏轼《和何长官六言次韵》"},"example":{"text":"游衍，～随过遣，痴云腻雨无留恋。","book":"清·洪昇《长生殿·重圆》"},"similar":["风餐露宿"],"usage":"作谓语、定语；指清高自赏"},{"id":21098,"word":"抹月秕风","pinyin":"mǒ yuè pī fēng","abbr":"mybf","explanation":"意思是用风月当菜肴。这是文人表示家贫没有东西待客的风趣说法，","source":{"text":"贫家何以娱客，但知抹批风。","book":"宋·苏轼《和何长官六言次韵》"},"example":{"text":"敢把朝廷来讥讽？～聊自徜，手足义偏长。","book":"明·陈汝元《金莲记·控代》"}},{"id":21099,"word":"抹泪揉眵","pinyin":"mǒ lèi róu chī","abbr":"mlrc","explanation":"眵：眼屎，此指眼睛。擦着眼泪，揉着眼睛。形容落泪伤心的样子。","source":{"text":"打的你气咽声丝，倒着我抹泪移眵。","book":"元·无名氏《抱妆盒》第三折"},"example":{"text":"～，看别人花底停骖，可不道多病身愁怀易感。","book":"明·汤式《新水令·秋怀》"}},{"id":21100,"word":"抹稀泥","pinyin":"mǒ xī ní","abbr":"mxn","explanation":"比喻无原则地调解或折中。","source":{"text":"我坚决不同意这种抹稀泥的作法。","book":"王朔《我是“狼”》"},"example":{"text":"我不喜欢～的做法。"},"similar":["和稀泥"],"usage":"作谓语、定语、宾语；指折中"},{"id":21101,"word":"抹粉施脂","pinyin":"mò fěn shī zhī","abbr":"mfsz","explanation":"指化妆打扮。今亦用于形容掩饰、遮盖。同“搽脂抹粉”。"},{"id":21102,"word":"抽丁拔楔","pinyin":"chōu dīng bá xiē","abbr":"cdbx","explanation":"比喻解决疑难。丁，“钉”的古字。","source":{"text":"元·李寿卿《度柳翠》第四折：“大众恐有不能了达，心生疑惑者，请垂下问，我与他抽丁拔楔。”一本作“抽丁抽楔”。"},"similar":["抽钉拔楔","拔丁抽楔"],"usage":"作谓语、定语；用于解疑"},{"id":21103,"word":"抽丝剥茧","pinyin":"chōu sī bāo jiǎn","abbr":"csbj","explanation":"丝得一根一根地抽，茧得一层一层地剥。形容分析事物极为细致，而且一步一步很有层次。"},{"id":21104,"word":"抽刀断丝","pinyin":"chōu dāo duàn sī","abbr":"cdds","explanation":"抽刀：拔出刀来。拔出刀来把乱丝斩断。比喻做事果断。","source":{"text":"又尝令诸子，各使理乱丝，帝独抽刀断之，曰：‘乱者须斩。’","book":"《北齐·齐本纪》"}},{"id":21105,"word":"抽刀断水","pinyin":"chōu dāo duàn shuǐ","abbr":"cdds","explanation":"抽刀：拔出刀来。水：流水。抽出刀来要斩断流水。比喻无济于事，反会加速事态的发展。","source":{"text":"抽刀断水水更流，举杯消愁愁更愁。","book":"唐·李白《宣州谢朓楼饯别校书叔云》"},"similar":["抱薪救火"],"usage":"作宾语、主语、定语；指无济于事"},{"id":21106,"word":"抽多补少，抽肥补瘦","pinyin":"chōu duō bǔ shǎo，chōu féi bǔ shòu","abbr":"cdbscfbs","explanation":"抽：提取；补：补助。指提取多余的补益不足的。","source":{"text":"‘抽多补少，抽肥补瘦’，同时坚决地团结中农，保护富裕中农，给富农以经济出路。","book":"《毛泽东选集》第三卷《附录：关于若干历史问题的决议》"},"example":{"text":"打乱平分，虽然有他的好处，但阻力太大，为了减少阻力，还是～的办法好。","book":"刘少奇《在全国土地会议上的结论》"},"usage":"作谓语、定语、分句；用于口语"},{"id":21107,"word":"抽抽噎噎","pinyin":"chōu chōu yē yē","abbr":"ccyy","explanation":"形容低声哭泣。","source":{"text":"只是不能说得，半日方抽抽噎噎的说道：‘你从此可都改了罢！’","book":"清·曹雪芹《红楼梦》第34回"},"example":{"text":"他～一整晚，还是止不住忧伤。"},"similar":["抽抽咽咽","哽哽咽咽"],"opposite":["大哭大闹"],"usage":"作状语；形容低声哭泣"},{"id":21108,"word":"抽抽搭搭","pinyin":"chōu chōu dā dā","abbr":"ccdd","explanation":"形容抵声哭泣。","source":{"text":"平儿听了，越发抽抽搭搭的哭了起来。","book":"清·曹雪芹《红楼梦》第一０六回"},"similar":["抽抽噎噎"],"opposite":["兴高采烈"],"usage":"作定语、状语；用于哭泣"},{"id":21109,"word":"抽拔幽陋","pinyin":"chōu bá yōu lòu","abbr":"cbyl","explanation":"抽拔：提拔。指提拔出身微贱不为人知却很有才能的人。","source":{"text":"显荐异节，抽拔幽陋。","book":"《后汉书·范滂传》"}},{"id":21110,"word":"抽梁换柱","pinyin":"chōu liáng huàn zhù","abbr":"clhz","explanation":"比喻暗中捣鬼，以假代真。","source":{"text":"我不会说笑话，只好行个抽梁换柱小令。","book":"清·李汝珍《镜花缘》第91回"},"example":{"text":"我看就来个～，我回去，让老婆替我来开会。","book":"段荃法《“状元”搬妻》"},"similar":["偷天换日","偷梁换柱"],"opposite":["忠诚老实"],"usage":"作宾语、定语；同“偷梁换柱”"},{"id":21111,"word":"抽演微言","pinyin":"chōu yǎn wēi yán","abbr":"cywy","explanation":"抽取片言只语而加以引申。指从微言中引申出大义。","source":{"text":"抽演微言，启发道真。","book":"《晋书·潘岳传》附潘尼《释奠颂》"}},{"id":21112,"word":"抽祕骋妍","pinyin":"chōu bì chěng yán","abbr":"cbcy","explanation":"指抒发深意，施展美才。","source":{"text":"本朝既废词赋，此道亦置不讲，惟世宗奉玄，一时撰文诸大臣，竭精力为之，如严分宜、徐华亭、李馀姚，如募海内名士几遍，争新斗巧，几三十年，其中岂少抽祕骋妍可垂后世家。","book":"明·沈德符《野获编·词林·四六》"},"example":{"text":"唯少游自辟蹊径，卓然名家。盖其天分高，故能～于寻常擩染之外。","book":"况周颐《蕙风词话》卷二"}},{"id":21113,"word":"抽秘骋妍","pinyin":"chōu mì chěng yán","abbr":"cmcy","explanation":"抒发深意，施展美才。","source":{"text":"本朝既废词赋，此道亦置不讲，惟世宗奉玄，一时撰文诸大臣，竭精力为之，如严分宜、徐华亭、李馀姚，召募海内名士几遍，争新斗巧，几三十年，其中岂少抽秘骋妍可垂后世者。","book":"明·沈德符《野获编·词林·四六》"},"example":{"text":"唯少游自辟蹊径，卓然名家。盖其天分高，故能～于寻常擩染之外。","book":"况周颐《蕙风词话》卷二"},"usage":"作谓语、宾语；用于书面语"},{"id":21114,"word":"抽筋剥皮","pinyin":"chōu jīn bāo pí","abbr":"cjbp","explanation":"形容剥削压迫非常残酷。","source":{"text":"可知那州县老爷们比娼妓还要下贱！遇见驯良百姓，他治死了还要抽筋剥皮，锉骨扬灰。","book":"清·刘鹗《老残游记续集遗稿》第二回"},"example":{"text":"他干尽～的坏事。"},"similar":["剥皮抽筋"],"usage":"作谓语、定语；形容非常残暴"},{"id":21115,"word":"抽筋拔骨","pinyin":"chōu jīn bá gǔ","abbr":"cjbg","explanation":"比喻非常勉强。"},{"id":21116,"word":"抽简禄马","pinyin":"chōu jiǎn lù mǎ","abbr":"cjlm","explanation":"抽简：抽竹简占算；禄、马：“禄存”与“天马”，旧时算命用语。指为人算命。","source":{"text":"因为能与人抽简禄马，川中起他一个混名叫做‘杨抽马’。","book":"明·凌濛初《二刻拍案惊奇》卷三十三"},"usage":"作谓语、宾语、定语；用于算命等"},{"id":21117,"word":"抽簪散发","pinyin":"chōu zān sàn fà","abbr":"czsf","explanation":"抽掉发簪，散乱头发。比喻弃官隐居。","source":{"text":"抽簪解朝衣，散发归海隅。","book":"晋·张协《咏史》"}},{"id":21118,"word":"抽胎换骨","pinyin":"chōu tāi huàn gǔ","abbr":"cthg","explanation":"犹言脱胎换骨。","source":{"text":"今日呵可便称了我平生愿。端的是抽胎换骨，火内生莲。","book":"元·刘君锡《来生债》第四折"},"example":{"text":"老先儿，你也尝尝，吃了牙老重生，～，眼见稀奇物，胜活十年人。","book":"《金瓶梅词话》第六七回"},"similar":["脱胎换骨","换骨脱胎","脱骨换胎"],"usage":"作谓语、状语；指彻底改变"},{"id":21119,"word":"抽薪止沸","pinyin":"chōu xīn zhǐ fèi","abbr":"cxzf","explanation":"薪：柴草；沸：沸腾。抽掉锅底下的柴火，使锅里的水不再翻滚。比喻从根本上解决问题。","source":{"text":"臣闻扬汤止沸，不如灭火去薪。","book":"汉·董卓《上何进书》"},"example":{"text":"～，剪草除根。","book":"北齐·魏收《为侯景判移梁朝文》"},"similar":["斩草除根"],"opposite":["抱薪救火"],"usage":"作谓语、宾语；比喻从根本上解决问题"},{"id":21120,"word":"抽钉拔楔","pinyin":"chōu dīng bá xiē","abbr":"cdbx","explanation":"抽：拔出；楔：楔子。抽去钉子，拔出木楔。比喻彻底解决问题。","source":{"text":"济心语曰：‘欲观前人，先观所使。’便有抽钉拔楔之意。","book":"宋·释普济《五灯会元·天台平田普岸禅师》"},"similar":["抽丁拔楔"],"usage":"作谓语、定语；用于解疑"},{"id":21121,"word":"抽青配白","pinyin":"chōu qīng pèi bái","abbr":"cqpb","explanation":"以青配白，比喻以对偶为专长。","source":{"text":"昨朝见君临水句，乃知抽青配白非诗人。","book":"金·元好问《送诗人秦略简夫妇……》诗"},"usage":"作宾语、定语；用于作文等"},{"id":21122,"word":"抽黄对白","pinyin":"chōu huáng duì bái","abbr":"chdb","explanation":"用“黄”对仗“白”。指只求对仗工稳。","source":{"text":"眩耀为文，琐碎排偶，抽黄对白，啽哢飞走。","book":"唐·柳宗元《乞巧文》"},"example":{"text":"笔力沉雄，直接汉魏，非～家所能道也。","book":"清·钱泳《履园丛话·杂记下·唐竹庄》"},"usage":"作宾语、定语；用于作文等"},{"id":21123,"word":"拂衣而去","pinyin":"fú yī ér qù","abbr":"fyeq","explanation":"形容很生气，一甩袖子就走了。","source":{"text":"子敬瞋目曰：‘远惭荀奉倩，近愧刘真长。’遂拂衣而去。","book":"南朝·宋·刘义庆《世说新语·方正》"},"example":{"text":"太后深以为不可，帝～，曰：‘何必谋于闺门！’","book":"《新五代史·汉高祖皇后李氏传》"},"similar":["拂袖而起","拂袖而去"],"usage":"作谓语；用于发怒时","story":["王子敬少年时，曾经看见他父亲的门生们在一起赌博，见有胜负就说“南风不竞”。这些门生看他是小孩子就轻蔑地说：“小孩子管中窥豹，时见一斑。”子敬十分生气地说：“远惭荀奉倩，近愧刘真长。”就拂衣而去"]},{"id":21124,"word":"拂衣远去","pinyin":"fú yī yuǎn qù","abbr":"fyyq","explanation":"拂衣：振衣而去。振衣远远离去。指归隐。","source":{"text":"见天下已乱，有拂衣远去之意。","book":"《新五代史·一行·郑遨传》"},"similar":["挂冠而去"],"usage":"作谓语、定语；指辞官归隐"},{"id":21125,"word":"拂袖而去","pinyin":"fú xiù ér qù","abbr":"fxeq","explanation":"拂袖：甩袖子，表示生气。形容生了气，一甩袖子就走了。","source":{"text":"王子敬数岁时，尝看诸门生樗蒲，见有胜负，因曰：‘南风不竞。’……子敬瞋目曰：‘远惭荀奉倩，近愧刘真长。’遂拂袖而去。","book":"南朝·宋·刘义庆《世说新语·方正》"},"example":{"text":"我是愿意人对我反抗，不合则～。","book":"鲁迅《两地书·一三五》"},"similar":["扬长而去"],"usage":"作谓语；用于书面语"},{"id":21126,"word":"拂袖而归","pinyin":"fú xiù ér guī","abbr":"fxeg","explanation":"拂袖：甩袖子，表示意志已决。指毫无留恋，回到家乡归隐。","source":{"text":"您都待重裀而卧，列鼎而食，不如我拂袖而归。","book":"元·周文质《斗鹌鹑·自悟》套曲"},"example":{"text":"厌红尘，～，为丘壑情浓，名利心灰。","book":"元·汪元亨《折桂令·归隐》"},"similar":["辞官归隐"],"usage":"作谓语；用于书面语"},{"id":21127,"word":"拂袖而起","pinyin":"fú xiù ér qǐ","abbr":"fxeq","explanation":"拂袖：甩袖子，表示生气。形容很生气，一甩袖子就走了。","source":{"text":"操先见张松人物猥琐，五分不喜；又闻语言冲撞，遂拂袖而起，转入后堂。","book":"明·罗贯中《三国演义》第60回"},"similar":["拂衣而去","拂袖而去"],"usage":"作谓语；用于发怒时"},{"id":21128,"word":"拄笏看山","pinyin":"zhǔ hù kàn shān","abbr":"zhks","explanation":"拄：支撑；笏：古代大臣上朝时拿着的手版。旧时比喻在官有高致。","source":{"text":"王子猷作桓车骑参军，桓谓王曰：‘卿在府久，比当相料理。’初不答，直高视，以手版拄颊云：‘西山朝来，致有爽气。’","book":"南朝宋·刘义庆《世说新语·简傲》"},"example":{"text":"输与清闲阳朔令，朝朝拄笏饱看山。","book":"清·黄遵宪《岁暮怀人诗》"},"similar":["拄笏西山"],"usage":"作谓语、宾语；指悠然自得的样子"},{"id":21129,"word":"拄笏西山","pinyin":"zhǔ hù xī shān","abbr":"zhxs","explanation":"形容在官而有闲情雅兴。亦为悠然自得的样子。","source":{"text":"王子猷作桓车骑参军，桓谓王曰：‘卿在府久，比当相料理。’初不答，直高视，以手版拄颊云：‘西山朝来，致有爽气。’","book":"南朝宋·刘义庆《世说新语·简傲》"},"example":{"text":"～志骑曹，朝来爽气与秋高。","book":"金·元好问《西山楼为王仲理赋》诗之二"},"similar":["拄颊看山","拄笏看山"],"usage":"作谓语、宾语；指悠然自得的样子"},{"id":21130,"word":"拄颊看山","pinyin":"zhǔ jiá kàn shān","abbr":"zjks","explanation":"形容在官而有闲情雅兴。亦为悠然自得的样子。","source":{"text":"先生有道抗浮云，拄颊看山意最真。","book":"宋·范成大《次胡经仲知丞赠别韵》"},"similar":["拄笏西山","拄笏看山"],"usage":"作宾语、定语；用于书面语"},{"id":21131,"word":"担当不起","pinyin":"dān dāng bù qǐ","abbr":"ddbq","explanation":"指承担不了责任。","source":{"text":"徐治功想了一下，觉得自己不去，将来出了人命，恐怕他也的确担当不起。","book":"路遥《平凡的世界》第一卷第50章"},"example":{"text":"这项工作他是～的。"},"similar":["担戴不起"],"usage":"作谓语；指不能承担自己的职责"},{"id":21132,"word":"担惊受怕","pinyin":"dān jīng shòu pà","abbr":"djsp","explanation":"担心害怕。指常处在惊吓、恐惧之中。","source":{"text":"你们若要做夫妻，每日同一处，不担惊受怕，我却有一条妙计，只是难教你。","book":"《水浒传》第三五回"},"example":{"text":"～的一晚，就是我生平最甜蜜的一天。","book":"欧阳予情《屏风后》"},"similar":["胆战心惊","坐立不安","受怕担惊"],"opposite":["稳如泰山","坦然自若"],"usage":"作谓语、定语、状语；形容担心害怕"},{"id":21133,"word":"担惊受恐","pinyin":"dān jīng shòu kǒng","abbr":"djsk","explanation":"担心害怕。指常处在惊吓、恐惧之中。","source":{"text":"为兵戈担惊受恐。","book":"元·无名氏《梧桐叶》第四折"},"example":{"text":"早知道这般的～，我可也图甚么衣紫拖朱。","book":"元·武汉臣《生金阁》第一折"},"similar":["担惊受怕"],"usage":"作谓语、定语、状语；形容担心害怕"},{"id":21134,"word":"担惊忍怕","pinyin":"dān jīng rěn pà","abbr":"djrp","explanation":"担心害怕。指常处在惊吓、恐惧之中。","source":{"text":"做买卖的担惊忍怕，眼见得疏林老树噪昏鸦。","book":"元·无名氏《盆儿鬼》第一折"},"similar":["担惊受恐","担惊受怕"],"usage":"作谓语、定语、状语；形容担心害怕"},{"id":21135,"word":"担戴不起","pinyin":"dān dài bù qǐ","abbr":"ddbq","explanation":"指承担不了责任。","source":{"text":"若有些须怠慢，山人就担戴不起！","book":"清·吴敬梓《儒林外史》第七回"},"example":{"text":"这个责任我～。"},"similar":["担当不起"],"usage":"作谓语；指不能承担自己的职责"},{"id":21136,"word":"担水河头卖","pinyin":"dān shuǐ hé tóu mài","abbr":"dshtm","explanation":"河：黄河。到黄河边卖水。比喻在内行面前卖弄。","source":{"text":"担水河头卖，诸人尽笑怪，滞货没人猜，一似欠他债。","book":"《古尊宿语录·黄梅东山演和尚》"}},{"id":21137,"word":"担簦蹑屩","pinyin":"dān dēng niè juē","abbr":"ddnj","explanation":"担簦：背着伞；屩：草鞋。背着伞，穿着草鞋。形容艰苦地长途跋涉。","source":{"text":"蹑屩担簦，说赵孝成王。","book":"《史记·平原君虞卿列传》"},"example":{"text":"遂生世不早，不及～于生生之门。","book":"宋·王遂《文公续集序》"},"usage":"作谓语、定语；用于出行"},{"id":21138,"word":"担酒牵羊","pinyin":"dān jiǔ qiān yáng","abbr":"djqy","explanation":"牵着羊，挑着酒。表示向人慰劳或庆贺","source":{"text":"担酒牵羊无其数，慌忙齐跪地流平。","book":"清·无名氏《刘公案》第78回"},"similar":["牵羊担酒"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":21139,"word":"担雪塞井","pinyin":"dān xuě sāi jǐng","abbr":"dxsj","explanation":"挑雪去填塞水井。比喻徒劳无功。","source":{"text":"君不见担雪塞井空用力，炊沙作饭岂堪食。","book":"唐·顾况《行路难诗》"},"example":{"text":"只是心心念念记挂此事，一似～，再没个满的日子。","book":"明·凌濛初《二刻拍案惊奇》卷八"},"similar":["徒劳无功","担雪填河"],"usage":"作谓语、定语；比喻徒劳无功"},{"id":21140,"word":"担雪填井","pinyin":"dān xuě tián jǐng","abbr":"dxtj","explanation":"挑雪去填塞水井。比喻徒劳无功。","source":{"text":"大似担雪填井，傍若无人。","book":"《五灯会元·智海平禅师法嗣·净因继成禅师》"},"example":{"text":"催趱各处径调军马前去策应，正如～一般。","book":"《水浒传》第八三回"},"similar":["担雪填河"],"usage":"作谓语、定语；比喻徒劳无功"},{"id":21141,"word":"担雪填河","pinyin":"dān xuě tián hé","abbr":"dxth","explanation":"挑雪去填塞河。比喻徒劳无功。","source":{"text":"姐姐每钻冰取火，婆婆每指山卖磨，哥哥每担雪填河。","book":"《全元散曲·普天乐·嘲风情》"},"similar":["担雪塞井","担雪填井"],"usage":"作谓语、定语；比喻徒劳无功"},{"id":21142,"word":"担风袖月","pinyin":"dān fēng xiù yuè","abbr":"dfxy","explanation":"袖：纳入袖中。比喻没有负担，无忧无虑。","source":{"text":"将历年所积的宦囊，并家属人等，送至原籍安顿妥当了，却自己担风袖月，游览天下胜迹。","book":"清·曹雪芹《红楼梦》第二回"}},{"id":21143,"word":"担饥受冻","pinyin":"dān jī shòu dòng","abbr":"djsd","explanation":"担：经受。经受饥饿与寒冷","source":{"text":"况乃锦衣玉食，归之自己，担饥受冻，受之二亲，漫然视若路人，甚而等之仇敌，败坏彝伦，灭绝天理。","book":"明·凌濛初《初刻拍案惊奇》第13卷"},"similar":["饥寒交迫"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":21144,"word":"拆东墙补西墙","pinyin":"chāi dōng qiáng bǔ xī qiáng","abbr":"cdqbxq","explanation":"拆倒东边的墙，以修补西边的墙。比喻临时勉强应付。亦比喻临时救急，不是根本办法。","source":{"text":"拆东墙，补西墙，先要顾前方。","book":"《中国民歌资料·纳布鞋》"},"example":{"text":"戚祖胜无力还债，只好再去骗，～，骗的更大，债主更多，形成了恶性循环。","book":"《新华文摘》1981年11期"},"similar":["拆东补西"],"usage":"作谓语、宾语、定语；指穷于应付"},{"id":21145,"word":"拆东补西","pinyin":"chāi dōng bǔ xī","abbr":"cdbx","explanation":"拆掉东边去补西边。比喻临时勉强应付。","source":{"text":"小家厚敛四壁立，拆东补西裳作带。","book":"宋·陈师道《次韵苏公西湖徙鱼》"},"example":{"text":"但若～，费日增而无已，兵复弱而莫支，将来必有以为口实者。","book":"明·张居正《答刘总督》"},"similar":["拆东墙补西墙","东拼西凑"],"usage":"作谓语、定语；指勉强应付"},{"id":21146,"word":"拆家荡产","pinyin":"chāi jiā dàng chǎn","abbr":"cjdc","explanation":"拆：拆散；荡：弄光。家庭败落，丧失全部家产","source":{"text":"只因有个人家，也为内眷有些妒忌，做出一场没了落事，几乎中了人的机谋，哄弄出拆家荡产的事来。","book":"明·凌濛初《二刻拍案惊奇》第十卷"},"similar":["破家荡产","倾家荡产"],"usage":"作谓语、定语、状语；指破产"},{"id":21147,"word":"拆牌道字","pinyin":"chāi pái dào zì","abbr":"cpdz","explanation":"把一个字拆成一句话的一种文字游戏。同“拆白道字”。","source":{"text":"把一个字拆成一句话的一种文字游戏。同“拆白道字”。"},"similar":["拆白道字"],"usage":"作宾语、定语；指文字游戏"},{"id":21148,"word":"拆白道字","pinyin":"chāi bái dào zì","abbr":"cbdz","explanation":"把一个字拆成一句话的一种文字游戏。","source":{"text":"俺孩子拆白道字，顶真续麻，无般不晓，无般不会。","book":"宋·黄庭坚《两同心》：“你供人女边著子，争知我门里挑心，为拆好、闷二字为句。”元·关汉卿《救风尘》第一折"},"example":{"text":"这小妮子省得什么～，你拆与我听。","book":"元·王实甫《西厢记》第五本第三折"},"similar":["拆牌道字"],"usage":"作宾语、定语；指文字游戏"},{"id":21149,"word":"拆西补东","pinyin":"chāi xī bǔ dōng","abbr":"cxbd","explanation":"比喻临时勉强凑合应付。同“拆东补西”。","source":{"text":"虽乃得如斯，有为多患累，与道殊悬运，拆西补东尔。","book":"唐·寒山《诗》"},"similar":["拆东补西","拆东墙补西墙"],"usage":"作谓语、宾语、定语；指穷于应付"},{"id":21150,"word":"拈华摘艳","pinyin":"niān huá zhāi yàn","abbr":"nhzy","explanation":"指雕琢淫词艳句。同“拈花摘艳”。","source":{"text":"若拈华摘艳，鉥心刿肾于辞章间，陋之陋者也。","book":"明·宋濂《故天台朱府君霞屋阡表》"},"similar":["拈花摘艳"],"usage":"作谓语、宾语；用于作文等"},{"id":21151,"word":"拈弓搭箭","pinyin":"niān gōng dā jiàn","abbr":"ngdj","explanation":"拈：用手指夹、捏。一手握弓，一手把箭放在弦上，准备射出。","source":{"text":"张飞带住马，拈弓搭箭，回射马超。","book":"明·罗贯中《三国演义》第六十五回"},"example":{"text":"大约相距百余步，即～，把孟俊射落马下，麾兵擒住，收军还城。","book":"蔡东藩《五代史演义》第五十五回"},"usage":"作谓语、宾语；用于作战等"},{"id":21152,"word":"拈斤播两","pinyin":"diān jīn bō liǎng","abbr":"njbl","explanation":"犹言斤斤计较。指对无关紧要的事过分计较。","source":{"text":"也不索昼夜思量心内想，也不索拈斤播两显耀我这英雄猛将。","book":"明·无名氏《大劫牢》第一折"},"example":{"text":"朋友的益处，不能这样～的讲。","book":"钱钟书《钱钟书散文选》"},"similar":["掂斤播两"],"usage":"作谓语、定语、状语；形容过分计较"},{"id":21153,"word":"拈断髭须","pinyin":"niān duàn zī xū","abbr":"ndzx","explanation":"髭：嘴上边的胡子。频频搓转胡子，以致搓断了几根。形容写诗时反复推敲的情态。","source":{"text":"唐人皆苦思作诗，所谓吟安一个字，拈断数茎须。","book":"宋·魏庆之《诗人玉屑》卷十二"},"example":{"text":"这种～的音调，在这个书斋里，不容易听到的。","book":"清·曾朴《孽海花》第三十五回"},"usage":"作谓语；用于人思考或写作时"},{"id":21154,"word":"拈毫弄管","pinyin":"niān háo nòng guǎn","abbr":"nhng","explanation":"拿笔。借指写作或绘画。","source":{"text":"且喜这所在，涧谷幽深，林峦雅秀，森列于明窗净几之外，默助我拈毫弄管之神。","book":"明·徐渭《女状元》第一折"},"usage":"作谓语、宾语、定语；用于写字等"},{"id":21155,"word":"拈花一笑","pinyin":"niān huā yī xiào","abbr":"nhyx","explanation":"比喻心心相印、会心。","source":{"text":"世尊在灵山会上，拈花示众，是时众皆默然，唯迦叶尊者破颜微笑。","book":"宋·释普济《五灯会元·七佛·释迦牟尼佛》"},"example":{"text":"伊为新至我，我是旧来伊，～，心是口。","book":"清·李渔《奈何天·巧怖》"},"similar":["拈花微笑"],"usage":"作谓语、定语；比喻彼此心意一致"},{"id":21156,"word":"拈花弄月","pinyin":"niān huā nòng yuè","abbr":"nhny","explanation":"指玩赏花月。","source":{"text":"拈花弄月须乘少，问水寻山莫待迟。","book":"明·周履靖《锦笺记·游杭》"},"example":{"text":"俄见苍圣带领宋儒上殿，有褒衣博冠手执《太极图》者，有闭目指心自称常惺惺者，有～自称活泼泼地者。","book":"清·袁枚《续新齐谐·麒麟喊冤》"},"similar":["拈花摘叶"],"usage":"作谓语、宾语、定语；用于男性"},{"id":21157,"word":"拈花弄柳","pinyin":"niān huā nòng liǔ","abbr":"nhnl","explanation":"比喻玩弄女人。","source":{"text":"绿鬓仙郎，懒拈花弄柳，劝酒持觞。眉颦知有恨，何事苦相防？","book":"元·高明《琵琶记》第三十出"},"example":{"text":"小姐好好的～，不知因甚病了。","book":"明·汤显祖《牡丹亭·诘病》"},"similar":["拈花惹草"],"usage":"作谓语、宾语；用于比喻句"},{"id":21158,"word":"拈花微笑","pinyin":"niān huā wēi xiào","abbr":"nhwx","explanation":"原为佛家语，比喻彻悟禅理。后比喻彼此心意一致。","source":{"text":"尔时大梵天王即引若干眷属来奉献世尊于金婆罗华，各各顶礼佛足，退坐一面。尔时世尊即拈奉献金色婆罗华，瞬目扬眉，示诸大众，默然毋措。有迦叶破颜微笑。","book":"《大梵天王问佛决疑经》"},"example":{"text":"自家做来做去，原觉得口吻生花；他人看了又看，也必定～：是亦缘也。","book":"清·李汝珍《镜花缘》第一百回"},"similar":["拈花一笑"],"usage":"作谓语；指心意一致"},{"id":21159,"word":"拈花惹草","pinyin":"niān huā rě cǎo","abbr":"nhrc","explanation":"拈：捏；惹：招惹；草、花：比喻好。比喻到处留情，多指男女间的挑逗引诱。","source":{"text":"三国志无过说些战伐，也不希咤，终少些团香弄玉，惹草粘花。","book":"元·杨立斋《哨遍》"},"example":{"text":"彩云生性本～。（清·曾朴《孽海花》第三十一回）"},"similar":["招花引蝶"],"usage":"作谓语、定语；比喻到处留情","story":["贾琏的女儿生病，他离开王熙凤独居，但寂寞难奈。突然想起酒头厨子多官的媳妇美貌无比、生性轻浮、拈花惹草，就打发小厮去与那娘子一说，她恰好也倾心于贾琏，于是贾琏就去相会，两人像干柴烈火一般热烈，从此勾搭上了"]},{"id":21160,"word":"拈花摘叶","pinyin":"niān huā zhāi yè","abbr":"nhzy","explanation":"拈：用指取物；花：女子。比喻男性玩弄女性，嫖妓等。","source":{"text":"倚翠偎红，拈花摘叶。","book":"明·朱权《卓文君》第二折"},"similar":["拈花摘草","拈花弄月"],"usage":"作谓语、宾语、定语；用于男性"},{"id":21161,"word":"拈花摘艳","pinyin":"niān huā zhāi yàn","abbr":"nhzy","explanation":"指雕琢淫词艳句。亦作“拈华摘艳”。","source":{"text":"若夫拈花摘艳，劝淫蛊俗者之为，则当斥而弃之尔。","book":"明·宋濂《序》"},"similar":["拈华摘艳"],"usage":"作谓语、宾语；用于作文等"},{"id":21162,"word":"拈花摘草","pinyin":"niān huā zhāi cǎo","abbr":"nhzc","explanation":"拈：用指取物；花、草：女子。比喻男性玩弄女性，嫖妓等。","source":{"text":"拈花摘草，风流不让柳耆卿。","book":"元·古杭才人《宦门子弟错立身》第二出"},"similar":["拈花惹草","拈花摘叶"],"usage":"作谓语、宾语、定语；用于男性"},{"id":21163,"word":"拈轻怕重","pinyin":"niān qīng pà zhòng","abbr":"nqpz","explanation":"指接受任务时拣轻的担子挑，怕挑重担。","source":{"text":"不少的人对工作不负责任，拈轻怕重，把重担子推给人家，自己挑轻的。","book":"毛泽东《纪念白求恩》"},"example":{"text":"他做工作时～，把困难推给别人。"},"similar":["挑肥拣瘦"],"opposite":["任劳任怨","吃苦耐劳","不辞劳苦"],"usage":"作谓语、定语；指怕挑重担"},{"id":21164,"word":"拈轻掇重","pinyin":"niān qīng duō zhòng","abbr":"nqdz","explanation":"轻的重的都要拿。指要干的活很多。","source":{"text":"怎下的着他拈轻掇重，可便扫床也波叠被。","book":"元·无名氏《刘弘嫁婢》第二折"},"opposite":["拈轻怕重"],"usage":"作谓语、宾语；指干的活繁杂"},{"id":21165,"word":"拈酸吃醋","pinyin":"niān suān chī cù","abbr":"nscc","explanation":"比喻因嫉妒而引起的不快情绪。形容爱嫉妒别人。","source":{"text":"怎奈静真情性利害，比空照大不相同，极要拈酸吃醋。","book":"明·冯梦龙《醒世恒言》第15卷"},"example":{"text":"如要去告诉人，反要说你是妒妇，～，传为笑柄。","book":"清·秋瑾《精卫石》第一回"},"similar":["拈酸泼醋"],"usage":"作谓语、宾语；用于嫉妒人"},{"id":21166,"word":"拈酸泼醋","pinyin":"niān suān pō cù","abbr":"nspc","explanation":"产生嫉妒情绪。多指在男女关系上。同“拈酸吃醋”。","source":{"text":"则见那，娇惰的熏香闲坐，悍妒的拈酸泼醋。","book":"清·嬴宗季女《六月霜·蓉谪》"},"similar":["拈酸吃醋"],"usage":"作谓语、宾语；用于嫉妒人"},{"id":21167,"word":"拉三扯四","pinyin":"lā sān chě sì","abbr":"lscs","explanation":"指谈话或议论乱牵扯到无关的人或事。","source":{"text":"愿意不愿意，你也好说，犯不着拉三扯四的。","book":"清·曹雪芹《红楼梦》第46回"},"example":{"text":"不能拿了金凤来，你不必～的乱嚷。","book":"清·曹雪芹《红楼梦》第73回"},"similar":["说长道短"],"usage":"作谓语；指谈论牵扯到无关的人或事"},{"id":21168,"word":"拉不下脸","pinyin":"lā bù xià liǎn","abbr":"lbxl","explanation":"指碍于情面，不能拒绝或不便开口。","source":{"text":"我表示拉不下脸，只好随他们去抄，果然抓走一些嫌疑犯。","book":"王朔《浮出海面》"},"example":{"text":"他总～，没法开展工作。"},"similar":["抹不开脸"],"usage":"作谓语；用于人"},{"id":21169,"word":"拉东补西","pinyin":"lā dōng bǔ xī","abbr":"ldbx","explanation":"多指欠债，借东家还西家，左支右绌。","example":{"text":"他这几年就靠～过日子。"},"similar":["拆东墙补西墙"],"usage":"作宾语、定语；指欠债"},{"id":21170,"word":"拉人下水","pinyin":"lā rén xià shuǐ","abbr":"lrxs","explanation":"比喻拉别人干坏事。","source":{"text":"他认为，阳虎诱之于利禄，手法不够精细。拉人下水，先要寻其短处。","book":"钱宁《圣人》第26章"},"example":{"text":"他习惯于用小恩小惠～。"},"similar":["拖人下水"],"usage":"作谓语、定语；指拉别人干坏事"},{"id":21171,"word":"拉大旗作虎皮","pinyin":"lā dà qí zuò hǔ pí","abbr":"ldqzhp","explanation":"比喻打着革命的旗号来吓唬人、蒙骗人。","source":{"text":"比喻打着革命的旗号来吓唬人、蒙骗人。"},"example":{"text":"我们要坚决打击～的行为。"},"usage":"作谓语、宾语、定语；指找保护伞"},{"id":21172,"word":"拉家带口","pinyin":"lā jiā dài kǒu","abbr":"ljdk","explanation":"带着一家大小。","source":{"text":"老李，我真再也没法过下去了，拉家带口的，可比不了那些光棍们好混。","book":"苗培时《矿山烈火》"},"example":{"text":"他～的，多幺不容易。"},"similar":["拖儿带女"],"usage":"作谓语、定语；指受家属的拖累"},{"id":21173,"word":"拉帮结伙","pinyin":"lā bāng jié huǒ","abbr":"lbjh","explanation":"组织帮派，搞小集团活动。","source":{"text":"看着同学三三两两地闲聊天，拉帮结伙地搞活动，就好像一支行进中的浩荡队伍单把我抛撇在外头。","book":"章诒和《往事并不如烟·君子之交》"},"example":{"text":"我们要站在党的立场上办事，不能～。"},"similar":["拉帮结派"],"usage":"作谓语、宾语；指搞小集团活动"},{"id":21174,"word":"拉帮结派","pinyin":"lā bāng jié pài","abbr":"lbjp","explanation":"拉：拉拢；结：组织。组织帮派，搞小集团活动。","source":{"text":"他们也是有一帮的，特别是利用一些年轻人没有知识，拉帮结派，有相当的基础。","book":"《邓小平文选》第二卷"},"example":{"text":"对于少数人在改革中抵制、怠工、失职渎职；乘机制造思想混乱，～，进行非法组织活动……就要严肃处理。","book":"《人民日报》1983.2.20"},"similar":["结党营私","拉帮结伙"],"usage":"作谓语、定语；指搞小集团活动"},{"id":21175,"word":"拉拉扯扯","pinyin":"lā lā chě chě","abbr":"llcc","explanation":"以手牵牵拉拉。借指拉扯私欲关系。","source":{"text":"怪热的，拉拉扯扯的做什么！","book":"清·曹雪芹《红楼梦》第三十一回"},"example":{"text":"说着，才大家嘻嘻哈哈～奔了那座财神殿去了。","book":"清·文康《儿女英雄传》第三十八回"},"similar":["拉三扯四"],"opposite":["正经八百","要言不烦"],"usage":"作谓语、宾语；形容拉私人关系","story":["贾宝玉因与林黛玉两人发生了口角，不欢而散。黛玉独自在潇湘阁后悔，宝玉也在后悔不该得罪她，就亲自上潇湘阁道歉，上前拉黛玉出去玩。林黛玉将手一摔道：“谁同你拉拉扯扯的！一天大似一天，还这么涎皮赖脸的。”还是凤姐为他们解围"]},{"id":21176,"word":"拉拉杂杂","pinyin":"lā lā zá zá","abbr":"llzz","explanation":"指杂乱无条理。","source":{"text":"只见他两手扳着看墙门，把身子往后一挣，那垛看墙就拉拉杂杂卸下半堵。","book":"清·吴敬梓《儒林外史》第五十二回"},"example":{"text":"秋香，你说话也要想一想儿，怎这样～的。","book":"清·夏敬渠《野叟曝言》第六十一回"},"similar":["杂乱无章"],"opposite":["井然有序","整整齐齐"],"usage":"作谓语、定语；指杂乱"},{"id":21177,"word":"拉捋自坏","pinyin":"lā luō zì huài","abbr":"llzh","explanation":"捋：脱。自己断裂，崩塌。比喻自己毁坏了自己。","source":{"text":"元衰如北夏门，拉捋自欲坏，非一木所能支。","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":21178,"word":"拉捭摧藏","pinyin":"lā bǎi cuī cáng","abbr":"lbcc","explanation":"拉：摧折；捭：两手排击；摧藏：挫伤。指摧伤挫折。","source":{"text":"莫不衄锐挫芒，拉捭摧藏。","book":"晋·左思《吴都赋》"},"usage":"作谓语、定语；用于书面语"},{"id":21179,"word":"拉朽摧枯","pinyin":"lā xiǔ cuī kū","abbr":"lxck","explanation":"摧折枯朽的草木。形容轻而易举。也比喻摧毁腐朽势力的强大气势。同“摧枯拉朽”。","source":{"text":"若简练兵甲，倍道兼行，出其不意，以吾愤激之众，击彼骄惰之师，拉朽摧枯，未云其易，解围定霸，在此一役。","book":"《旧五代史·唐书·庄宗纪一》"},"example":{"text":"峨峨正阳，雄绝当途，悬布一跃，～。","book":"清·冯桂芬《按察使金公墓志铭》"},"similar":["摧枯拉朽"],"usage":"作谓语、定语；指毫不费力地摧毁"},{"id":21180,"word":"拉枯折朽","pinyin":"lā kū zhé xiǔ","abbr":"lksx","explanation":"摧折枯朽的草木。形容轻而易举。也比喻摧毁腐朽势力的强大气势。同“摧枯拉朽”。","source":{"text":"虏骑去我军将近，遂释鞅会食，食罢，将战，伦举兵一鏖，如拉枯折朽。","book":"宋·文莹《玉壶清话》卷七"},"similar":["摧枯拉朽"],"usage":"作谓语、宾语；用于摧毁无用的东西"},{"id":21181,"word":"拉皮条","pinyin":"lā pí tiáo","abbr":"lpt","explanation":"从中牵线，拉拢男女搞不正当关系。","source":{"text":"实夫方知是拉皮条的，笑置不理。","book":"清·韩邦庆《海上花列传》第15回"},"example":{"text":"你他妈少给我乱当红娘，～你岁数还小点。","book":"王朔《我是你爸爸》"},"usage":"作谓语、定语、宾语；用于口语"},{"id":21182,"word":"拉长线","pinyin":"lā cháng xiàn","abbr":"lcx","explanation":"比喻想得很远，为以后要达到的目的预告做好准备。","source":{"text":"你倒会拉长线儿，罢了，若不是你叔叔说，我不管你的事。","book":"清·曹雪芹《红楼梦》第二十四回"},"example":{"text":"星星点点，如旋转如梭行，如～，带着一种诱人的果园的芳香。","book":"王蒙《焰火》"}},{"id":21183,"word":"拉闲散闷","pinyin":"lā xián sàn mèn","abbr":"lxsm","explanation":"说闲话，闲聊解闷。","source":{"text":"拉闲散闷耍子而已。","book":"明·吴承恩《西游记》第九十五回"},"usage":"作谓语、宾语；用于口语"},{"id":21184,"word":"拊心泣血","pinyin":"fǔ xīn qì xuè","abbr":"fxqx","explanation":"形容内心悲痛之极。","source":{"text":"请勿攻河东，从龙门直渡，据永丰仓，传檄远近，则足食足兵。既总天府，据百二之所，斯亦拊心泣血之计。","book":"《旧唐书·良吏传上·薛大鼎》"},"example":{"text":"《新唐书·仆固怀恩传》：“陛下不垂明察，欲使忠直之臣陷谗邪之党，臣所为～者也。”"},"usage":"作谓语、定语；用于悲痛时"},{"id":21185,"word":"拊背扼吭","pinyin":"fǔ bèi è kēng","abbr":"fbek","explanation":"吭，喉咙。按住脊背，拤住咽喉。比喻控制要害。","source":{"text":"语出《史记·刘敬叔孙通列传》：“夫与人斗，不扼其亢，拊其背，未能全其胜也。今陛下入关而都，案秦之故地，此亦扼天下之亢而拊其背也。”按，亢，同“吭”。"},"example":{"text":"俄既东向并亚细亚诸国，而后～以薄英法，则其志可逞也。","book":"清·王韬《跋〈同送西吉甫文〉》"},"similar":["抚背扼喉"],"usage":"作谓语、定语；指控制要害"},{"id":21186,"word":"拊背扼喉","pinyin":"fǔ bèi è hóu","abbr":"fbeh","explanation":"掐着喉咙，捺住脊背。比喻控制要害，制敌死命。","source":{"text":"夫与人斗，不扼其吭，拊其背，未能全其胜也。","book":"西汉·司马迁《史记·刘敬叔孙通列传》"},"example":{"text":"既总天府，据百二之所，斯亦～之计。","book":"《旧唐书·良吏传上·薛大鼎》"},"similar":["击中要害","拊背扼吭"],"usage":"作谓语、定语；比喻控制要害，制敌死命"},{"id":21187,"word":"拊背搤吭","pinyin":"fǔ bèi hè kēng","abbr":"fbek","explanation":"按住脊背，拤住咽喉。比喻控制要害。亢，同“吭”。","source":{"text":"夫与人斗，不搤其亢，拊其背，未能全其胜也。今陛下入关而都，案秦之故地，此亦搤天下之亢而拊其背也。","book":"语出《史记·刘敬叔孙通列传》"},"example":{"text":"俄既东向并亚细亚诸国，而后～以薄英法，则其志可逞也。","book":"清·王韬《跋〈同送西吉甫文〉》"}},{"id":21188,"word":"拊膺顿足","pinyin":"fǔ yīng dùn zú","abbr":"fydz","explanation":"捶胸跺脚。形容哀痛之极。","source":{"text":"叹骨肉拊膺顿足，曷胜哀痛。","book":"明·沈鲸《双珠记·母子分珠》"},"similar":["抚膺顿足"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":21189,"word":"拊髀雀跃","pinyin":"fǔ bì què yuè","abbr":"fbqy","explanation":"拊：拍；髀：大腿。拍着大腿，象麻雀似地跳跃。形容非常高兴的样子。","source":{"text":"鸿蒙方将拊髀雀跃而游。","book":"《庄子·在宥》"},"example":{"text":"奇辞切至，则～。","book":"南朝·梁·刘勰《文心雕龙·乐府》"},"usage":"作谓语、状语；用于兴奋时"},{"id":21190,"word":"拍手叫好","pinyin":"pāi shǒu jiào hǎo","abbr":"psjh","explanation":"拍着手叫好。形容仇恨得到消除。","source":{"text":"‘……不如老哥一不做二不休，将此两款替人瑞再挥一斧吧！’子谨拍手叫好。","book":"清·刘鹗《老残游记》第二十回"},"example":{"text":"酒杯嵌入两人高举的小船船底，平平整整，毫没破损，众人又是～。","book":"金庸《书剑恩仇录》第七回"},"similar":["拍手称快"],"usage":"作谓语、状语、宾语；指特别高兴"},{"id":21191,"word":"拍手拍脚","pinyin":"pāi shǒu pāi jiǎo","abbr":"pspj","explanation":"形容人极其喜悦、兴奋时的动作。","source":{"text":"贾子猷更拍手拍脚的说道：‘……几时才能够到上海去逛一趟，见见什面，才不负此一生呢。’","book":"清·李宝嘉《文明小史》第十四回"},"usage":"作谓语、状语；用于兴奋时"},{"id":21192,"word":"拍手称快","pinyin":"pāi shǒu chēng kuài","abbr":"psck","explanation":"快：痛快。拍掌叫好。多指正义得到伸张或事情的结局使人感到满意。","source":{"text":"又见恶姑奸夫俱死，又无不拍手称快。","book":"明·凌濛初《二刻拍案惊奇》卷三十五"},"example":{"text":"象这样剥削来的钱，叫他这样失去，还不知多少人～呢！（清·吴趼人《二十年目睹之怪现状》第五十五回）"},"similar":["皆大欢喜","大快人心","拍手叫好"],"opposite":["肝肠寸断","天怒人怨","悲愤填膺"],"usage":"作谓语、补语、宾语；指特别高兴"},{"id":21193,"word":"拍掌称快","pinyin":"pāi zhǎng chēng kuài","abbr":"pzck","explanation":"称：称道。拍着手掌叫痛快。形容仇恨得到消除。","source":{"text":"众人一齐拍掌称快。","book":"清·刘鹗《老残游记》第一回"},"similar":["拍手称快"],"usage":"作谓语、补语、宾语；指特别高兴"},{"id":21194,"word":"拍板定案","pinyin":"pāi bǎn dìng àn","abbr":"pbda","explanation":"比喻作出决定。","example":{"text":"会议争论了一天，夏曦～：全军转移到湘鄂边去。","book":"刘凤舞《民国春秋》第十九章"}},{"id":21195,"word":"拍板成交","pinyin":"pāi bǎn chéng jiāo","abbr":"pbcj","explanation":"比喻交易成立或事情达成协议。","example":{"text":"我们～，不能反悔。"},"similar":["一拍即合"],"usage":"作谓语；指达成协议"},{"id":21196,"word":"拍案叫绝","pinyin":"pāi àn jiào jué","abbr":"pajj","explanation":"拍桌子叫好。形容非常赞赏。","source":{"text":"不禁拍案呼奇。","book":"唐·田颖《博浪沙行序》"},"example":{"text":"使人见之，一个个欢欣鼓舞，快意舒怀，不禁～。","book":"清·陈忱《水浒后传》第一回"},"similar":["赞不绝口","交口称誉","叹为观止"],"opposite":["众口交谪","破口大骂"],"usage":"作谓语、宾语、补语；指非常赞赏"},{"id":21197,"word":"拍案惊奇","pinyin":"pāi àn jīng qí","abbr":"pajq","explanation":"对奇异的事情拍着桌子惊叹。","source":{"text":"明末·凌蒙初有拟话本《初刻拍案惊奇》、《二刻拍案惊奇》。"},"example":{"text":"更令人～的是：杜诗：‘老妻画纸为棋局，稚子敲针作钓钩’。","book":"《人民日报》（海外版）1982.1.2"},"similar":["拍案称奇"],"usage":"作谓语、定语；用于“令人”后"},{"id":21198,"word":"拍案称奇","pinyin":"pāi àn chēng qí","abbr":"pacq","explanation":"奇：特殊的。对奇异的事情拍着桌子惊叹。","source":{"text":"不禁拍案呼奇。","book":"唐·田颖《博浪沙行序》"},"example":{"text":"纪保安父亲不看则已，一看之下，顿有“他乡遇故知”之感，不禁击节赞许，～。","book":"刘心武《栖凤楼》二十一"},"similar":["拍案惊奇"],"usage":"作谓语、定语；用于“令人”后"},{"id":21199,"word":"拍案而起","pinyin":"pāi àn ér qǐ","abbr":"paeq","explanation":"案：桌子。一拍桌子猛地站起来。形容非常愤慨。","source":{"text":"羋氏大怒，拍案而起，骂曰：‘役夫不肖如此，宜王之欲杀汝而立职也！’","book":"明·冯梦龙《东周列国志》第四十六回"},"example":{"text":"闻一多～，横眉怒对国民党的手枪，宁可倒下去，不愿屈服。","book":"毛泽东《别了，司徒雷登》"},"similar":["义愤填膺","忿然作色"],"opposite":["悠然自得","泰然处之","心平气和"],"usage":"作谓语、宾语；形容非常愤慨"},{"id":21200,"word":"拍胸脯","pinyin":"pāi xiōng pú","abbr":"pxp","explanation":"表示负责，敢打包票。","source":{"text":"他亲家听了，自然是拍胸脯，一力承当，把他欢喜的了不得。","book":"清·李宝嘉《官场现形记》第六回"},"usage":"作谓语、定语、状语；多用于口语"},{"id":21201,"word":"拍马屁","pinyin":"pāi mǎ pì","abbr":"pmp","explanation":"向人谄媚奉承。","source":{"text":"还有朋友哚拍马屁鬼讨好，连忙搭俚买好仔家生送得去铺房间。","book":"清·韩邦庆《海上花列传》第十回"},"example":{"text":"你少在我面前～。"},"similar":["溜须拍马"],"usage":"作谓语、定语、状语；用于口语"},{"id":21202,"word":"拍马溜须","pinyin":"pāi mǎ liū xū","abbr":"pmlx","explanation":"比喻谄媚奉承。","source":{"text":"新社会拍马溜须根本吃不开。","book":"草明《乘风破浪》"},"example":{"text":"不靠～是很难有出头之日的。"},"similar":["溜须拍马"],"opposite":["刚正不阿"],"usage":"作谓语、定语、宾语；比喻讨好奉承"},{"id":21203,"word":"拏云握雾","pinyin":"ná yún wò wù","abbr":"nyww","explanation":"比喻对人施展手段。","source":{"text":"他有投明弃暗的心，拏云握雾的手。","book":"元·尚仲贤《单鞭夺槊》第二折"},"example":{"text":"师父怀揣日月，袖褪乾坤，有饮食天地之才，～之手。","book":"明·无名氏《广成子》第一折"},"usage":"作谓语、定语；用于比喻句"},{"id":21204,"word":"拏云攫石","pinyin":"ná yún jué shí","abbr":"nyjs","explanation":"形容古树干高耸云霄、根盘曲石隙的雄姿。","source":{"text":"厅前多古树，有拏云攫石之势。","book":"清·李斗《扬州画舫录·草河录下》"},"usage":"作谓语、定语；用于比喻句"},{"id":21205,"word":"拏风跃云","pinyin":"ná fēng yuè yún","abbr":"nfyy","explanation":"比喻气概雄伟。","source":{"text":"当时元夫志士，无不拏风跃云，吐阳嘘阴，致身于九霄之上。","book":"明·宋濂《凤阳陈方氏赠二代碑铭》"},"usage":"作谓语、定语；用于比喻句"},{"id":21206,"word":"拐弯抹角","pinyin":"guǎi wān mò jiǎo","abbr":"gwmj","explanation":"抹角：挨墙角绕过。沿着弯弯曲曲的路走。比喻说话绕弯，不直截了当。","source":{"text":"转变抹角，可早来到李家门首。","book":"元·秦简夫《东堂老》第一折"},"example":{"text":"～，记的土地庙儿，照走过的小巷口，径上碧草轩来。","book":"清·李绿园《歧路灯》第八十八回"},"similar":["转弯抹角","曲里拐弯"],"opposite":["直截了当","平坦通途"],"usage":"作谓语、状语、定语；形容不直截了当"},{"id":21207,"word":"拑口禁语","pinyin":"qián kǒu jìn yǔ","abbr":"qkjy","explanation":"拑：同“钳”，用东西夹住。闭口不言。形容保守秘密不说。","source":{"text":"秦俗多忌讳之禁，忠言未卒于口而身为戮没矣。故使天下之士，倾耳而听，重足而立，拑口而不言。","book":"汉·贾谊《过秦论》"},"example":{"text":"今日贾政在席上也自～。","book":"清·曹雪芹《红楼梦》第二十二回"},"similar":["缄口不言"],"usage":"作谓语、定语；指闭口不言"},{"id":21208,"word":"拒之门外","pinyin":"jù zhī mén wài","abbr":"jzmw","explanation":"拒：拒绝。把人挡在门外，不让其进入，形容拒绝协商或共事。","source":{"text":"看来贾老师念过去的一面交情，还不准备把他拒之门外。","book":"路遥《平凡的世界》第三卷第13章"},"example":{"text":"他被～，只好悻悻而归。"},"similar":["吃闭门羹"],"usage":"作谓语；指不让进入"},{"id":21209,"word":"拒人于千里之外","pinyin":"jù rén yú qiān lǐ zhī wài","abbr":"jryqlzw","explanation":"拒：拒绝。把人挡在千里之外。形容态度傲慢，坚决拒绝别人，或毫无商量余地。","source":{"text":"《孟子·告子下》：“距人于千里之外。”。"},"example":{"text":"而往往卷俎而退者多，置虚命彻者少，池池之声音颜色，～。","book":"清·袁枚《小仓山房尺牍》八首"},"similar":["拒人千里"],"opposite":["平易近人"],"usage":"作谓语、定语；形容对人态度傲慢","story":["战国时期，鲁平公准备任用孟子的学生乐正子主持国政，孟子喜出望外，公孙丑问孟子乐正子真的很有本事吗？孟子说他论本事、见闻与知识等都不如你，他的长处是对人很好，他不会拒人于千里之外，很多人聚集在他身边，能治理好国家"]},{"id":21210,"word":"拒人千里","pinyin":"jù rén qiān lǐ","abbr":"jrql","explanation":"形容对人态度傲慢。","source":{"text":"诣诣之声音颜色，距人于千里之外。","book":"先秦·孟轲《孟子·告子下》"},"example":{"text":"他摆出一幅～的傲慢神态。"},"similar":["拒人于千里之外"],"opposite":["和蔼可亲"],"usage":"作谓语、定语；指人的态度","story":["战国时期，鲁平公准备任用孟子的学生乐正子主持国政，孟子喜出望外，公孙丑问孟子乐正子真的很有本事吗？孟子说他论本事、见闻与知识等都不如你，他的长处是对人很好，他不会拒人于千里之外，很多人聚集在他身边，能治理好国家"]},{"id":21211,"word":"拒狼进虎","pinyin":"jù láng jìn hǔ","abbr":"jljh","explanation":"比喻一害刚去，又来一害。同“拒虎进狼”。","source":{"text":"拒狼进虎岂良谋，亡国图存夫。","book":"吕志伊《读史感赋》"},"similar":["拒虎进狼"],"usage":"作宾语、定语；指措施不得力"},{"id":21212,"word":"拒虎进狼","pinyin":"jù hǔ jìn láng","abbr":"jhjl","explanation":"比喻一害刚去，又来一害。","source":{"text":"乃拒虎进狼，既收渔人之利于河北。","book":"明·张煌言《复郎廷佐书》"},"example":{"text":"若名为同心御侮，实乃利吾土地，我则～，彼则翻云覆雨。","book":"陈光远《请力争青岛电》"},"similar":["拒狼进虎"],"usage":"作宾语、定语；指措施不得力"},{"id":21213,"word":"拒谏饰非","pinyin":"jù jiàn shì fēi","abbr":"jjsf","explanation":"谏：直言规劝；饰：掩饰；非：错误。拒绝劝告，掩饰错误。","source":{"text":"拒谏饰非，愚而上同，国必祸。","book":"战国·赵·荀况《荀子·成相》"},"example":{"text":"但是他不从政治军事经济文化的任何一个政策……他找到了～的方法。","book":"毛泽东《评蒋介石在双十节的演说》"},"similar":["文过饰非"],"opposite":["严于律己","从善如流"],"usage":"作谓语、定语、分句；指听不进意见"},{"id":21214,"word":"拓土开疆","pinyin":"tuò tǔ kāi jiāng","abbr":"ttkj","explanation":"开拓领土和疆界。","source":{"text":"王信韩孽，拓土开疆。我图尔才，越迁晋阳。","book":"晋·陆机《汉高祖功臣颂》"},"example":{"text":"清·褚人获《隋唐演义》第一回：“君明臣良，渐有～，混一江表意思。”"},"usage":"作谓语、定语；用于书面语"},{"id":21215,"word":"拓落不羁","pinyin":"tuò pò bù jī","abbr":"tlbj","explanation":"《北史·薛安都房法寿等传论》：“法寿拓落不羁，克昌厥后。”","source":{"text":"法寿拓落不羁，克昌厥后。","book":"《北史·薛安都房法寿等传论》"},"example":{"text":"可是骥东官职虽是武夫，性情却完全文士，恃才傲物，～。","book":"清·曾朴《孽海花》第三十一回"},"similar":["放浪形骸"],"usage":"作谓语、定语；指人的性格豪放"},{"id":21216,"word":"拔丁抽楔","pinyin":"bá dīng chōu xiē","abbr":"bdcx","explanation":"拔出钉子，抽掉楔子。比喻解除困难。","source":{"text":"大众恐有不能了达，心生疑惑者，请垂下问，我与他拔丁抽楔。","book":"元·无名氏《度柳翠》第四折"},"similar":["抽丁拔楔"],"usage":"作谓语；比喻排除困难"},{"id":21217,"word":"拔不出脚","pinyin":"bá bù chū jiǎo","abbr":"bbcj","explanation":"比喻陷入困境或杂事缠身而一时无法解脱。","example":{"text":"她已经深陷其中～了。"},"similar":["拔不出腿"],"opposite":["置身事外"],"usage":"作谓语、定语、状语；指抽不出身来"},{"id":21218,"word":"拔不出腿","pinyin":"bá bù chū tuǐ","abbr":"bbct","explanation":"比喻陷入困境或杂事缠身而一时无法解脱。","example":{"text":"她已经在此事上～了。"},"similar":["拔不出脚"],"opposite":["置身事外"],"usage":"作谓语、定语、状语；指抽不出身来"},{"id":21219,"word":"拔丛出类","pinyin":"bá cóng chū lèi","abbr":"bccl","explanation":"犹言拔萃出类。指高出众人。","source":{"text":"二子微猷，弥久弥芳。拔丛出类，景行朝阳。","book":"《宋书·孝义传·潘综》"},"similar":["拔萃出类"],"opposite":["平平庸庸"],"usage":"作谓语、定语；指杰出"},{"id":21220,"word":"拔了萝卜地皮宽","pinyin":"bá le luó bo dì pí kuān","abbr":"bllbdpk","explanation":"比喻为了行事方便而把碍眼的事物去掉。也比喻为了扩展地盘而排挤别人。","source":{"text":"拔了萝卜地皮宽，交他去了，省的他在这里跑兔子一般。","book":"明·兰陵笑笑生《金瓶梅词话》第51回"},"example":{"text":"我们还是尽快解决，～，免得他碍事。"},"usage":"作宾语、分句；用于口语"},{"id":21221,"word":"拔刀相助","pinyin":"bá dāo xiāng zhù","abbr":"bdxz","explanation":"旧小说中多指打抱不平。","source":{"text":"师曰：‘路见不平，所以按剑。’","book":"宋·释道元《景德传灯录》卷二十二"},"example":{"text":"路见不平，～。","book":"元·马致远《陈抟高卧》第一折"},"similar":["拔刀相济","见义勇为"],"opposite":["袖手旁观"],"usage":"作谓语、定语；形容仗义打抱不平"},{"id":21222,"word":"拔刀相向","pinyin":"bá dāo xiāng xiàng","abbr":"bdxx","explanation":"指动武。","source":{"text":"自然就不能不闹到扬眉裂眦拔刀相向起来。","book":"《儿女英雄传》第十回"},"example":{"text":"但当他们一看到侵略者公然～的时候，他们丝毫也不动摇地采取了伟大的中国人民在这样场合所惟一可能而且必须采取的办法。","book":"《人民日报》1951.1.11"},"similar":["刀兵相见"],"usage":"作谓语、定语；指动武"},{"id":21223,"word":"拔刀相济","pinyin":"bá dāo xiāng jì","abbr":"bdxj","explanation":"拔：抽出。拔出刀来助战，多指见义勇为。","source":{"text":"想起黄衫豪客也，女伴仍袖手旁观，英雄拔刀相济。","book":"明·汤显祖《紫钗记·剑合钗圆》"},"similar":["拔刀相助"],"opposite":["袖手旁观"],"usage":"作谓语、定语；形容仗义打抱不平"},{"id":21224,"word":"拔刃张弩","pinyin":"bá rèn zhāng nǔ","abbr":"brzn","explanation":"刃：指有铎刃的兵器；弩：用机械发箭的弓。拔出刀，张开弓。形容战斗前的紧张气氛。","source":{"text":"勒兵至郎署，皆拔刃张弩。","book":"东汉·班固《汉书·王莽传下》"},"similar":["剑拔弩张"],"usage":"作谓语、定语；指准备动武"},{"id":21225,"word":"拔剑论功","pinyin":"bá jiàn lùn gōng","abbr":"bjlg","explanation":"指争论功劳激烈到几乎动武。","source":{"text":"高帝悉去秦苛仪法，为简易。群臣饮酒争功，醉或妄呼，拔剑击柱，高帝患之。","book":"语出《史记·刘敬叔孙通列传》"},"example":{"text":"当时～者，矢口何人说纪生。","book":"金·元好问《读纪信传》诗"},"usage":"作谓语、定语；指争论激烈"},{"id":21226,"word":"拔十失五","pinyin":"bá shí shī wǔ","abbr":"bssw","explanation":"指选拔人才而失其半数。","source":{"text":"今拔十失五，犹得其半，而可以崇迈世数，使有志者自励，不亦可乎？","book":"《三国志·蜀书·庞统传》"},"example":{"text":"唐·赵蕤《反经·是非》：“今～，犹得其半，而可以崇迈代教，使有志者自励，不亦可乎？”"},"opposite":["拔十得五"],"usage":"作谓语、宾语；用于人才选拔"},{"id":21227,"word":"拔十得五","pinyin":"bá shí dé wǔ","abbr":"bsdw","explanation":"拔：选拔，推荐。想选拔十个，结果只选得五个。指选拔人才不容易。","source":{"text":"夫吏部尚书、侍郎，以贤而授者也，岂不能知人？如知之难，拔十得五，斯可矣。","book":"《新唐书·张九龄传》"},"example":{"text":"谓～而可得其半，故匿瑕含垢而求其长致。","book":"宋陈师道《谢胡运使启》"},"opposite":["拔十失五"],"usage":"作谓语、宾语；用于人才选拔"},{"id":21228,"word":"拔地倚天","pinyin":"bá dì yǐ tiān","abbr":"bdyt","explanation":"拔：突出，耸出。倚：倚傍，贴近。从地面突兀而起，贴近天际。比喻高大突出，气势雄伟。","source":{"text":"譬玉川子《月蚀诗》、杨司城《华山赋》、韩吏部《进学解》……莫不拔地倚天，句句欲活。","book":"唐·孙樵《与王霖秀才书》"},"example":{"text":"那悬崖之上，一株株苍松翠柏～，傲然屹立。"},"similar":["拔地参天"],"usage":"作谓语、定语；形容气势宏伟"},{"id":21229,"word":"拔地参天","pinyin":"bá dì cān tiān","abbr":"bdct","explanation":"拔地：从地面上陡然耸立。参天：高耸到空中。形容高大和气势雄伟。同“拔地倚天”。","source":{"text":"我们可以预言，它一定会拔地参天。","book":"郭沫若《春天的信号》"},"example":{"text":"原始森林里有很多～的大树。"},"similar":["拔地倚天"],"usage":"作谓语、定语；形容气势宏伟"},{"id":21230,"word":"拔地摇山","pinyin":"bá dì yáo shān","abbr":"bdys","explanation":"翻动大地，摇撼山岳。形容声势极大。","source":{"text":"乌龙镇上驻不赤龙舟，搅得翻江震海；大全港中做不得周全事，空教拔地摇山。","book":"《英烈传》第四十九回"},"similar":["地动山摇"],"usage":"作谓语、定语；形容声势极大"},{"id":21231,"word":"拔宅上升","pinyin":"bá zhái shàng shēng","abbr":"bzss","explanation":"拔：拔起；宅：住宅。古代传说修道的人全家同升仙界。","source":{"text":"真君以东晋孝武帝太康二年八月一日，于洪州西山，举家四十二口，拔宅上升而去。","book":"《太平广记》卷十四引《十二真君传·许真君》"},"example":{"text":"秋先，汝功行圆满，吾已申奏上帝，有旨封汝为护花使者，专管人间百花。令汝～。","book":"明·冯梦龙《醒世恒言》卷四"},"similar":["拔宅飞升"],"usage":"作谓语；指修道成仙","story":["东晋时期，道教盛行，很多人找名师传道修炼，有人炼制丹药。晋孝武帝太康二年八月一日，许真君也是道教追逐者，他在洪州西山服用丹药，然后让全家人都服药，于是全家42口人全部拔宅成仙而去。他本人被道教列为十二真君之一"]},{"id":21232,"word":"拔宅飞升","pinyin":"bá zhái fēi shēng","abbr":"bzfs","explanation":"拔：拔起；宅：住宅。古代传说修道的人全家同升仙界。参见“拔宅上升”。","source":{"text":"真君以东晋孝武帝太康二年八月一日，于洪州西山，举家四十二口，拔宅上升而去。","book":"语出《太平广记》卷十四引《十二真君传·许真君》"},"example":{"text":"生曰：“得卿如此，吾何忧！顾念一人得道，～。余将远逝，一切付之于卿。”","book":"清薄松龄《聊斋志异·白于玉》"},"similar":["拔宅上升"],"usage":"作谓语、定语；指修道成仙","story":["东晋时期，道教盛行，很多人找名师传道修炼，有人炼制丹药。晋孝武帝太康二年八月一日，许真君也是道教追逐者，他在洪州西山服用丹药，然后让全家人都服药，于是全家42口人全部拔宅成仙而去。他本人被道教列为十二真君之一"]},{"id":21233,"word":"拔山举鼎","pinyin":"bá shān jǔ dǐng","abbr":"bsjd","explanation":"形容力量超人或气势雄伟。","source":{"text":"籍是时年方二十四，力敌万夫，有拔山举鼎之威。","book":"《秦并六国平话》卷下"},"example":{"text":"一个人被鸦片束缚住了，任你是～的英雄，铜浇铁铸的罗汉，只要烟瘾一发，顿时骨软精酥，连一些气力都没有。","book":"《黑籍冤魂》第一回"},"similar":["拔山扛鼎"],"opposite":["软弱无力"],"usage":"作谓语、定语；形容力气大","story":["秦朝末年，项羽少年时不喜欢读书写字，叔父项梁改教他击剑，他想学抵敌万人的本事，项梁教他兵法，他不肯认真钻研，但力气很大，能举起几百斤重的鼎。同刘邦争天下8年，最后被迫在垓下乌江边自刎，感慨自己“力拔山兮气盖世”"]},{"id":21234,"word":"拔山扛鼎","pinyin":"bá shān gāng dǐng","abbr":"bsgd","explanation":"扛：双手举起。拔起大山，举起重鼎。形容力气很大。","source":{"text":"于是项王乃悲歌慷慨，自为诗曰：‘力拔山兮气盖世，时不利兮骓不逝。’","book":"《史记·项羽本纪》：“力能扛鼎，才气过人。”又"},"example":{"text":"汉祖入关破秦而楚后之～，力大过人。","book":"宋·邵雍《皇极经世绪言》第二卷"},"similar":["拔山盖世","拔山举鼎"],"opposite":["软弱无力"],"usage":"作谓语、定语、补语；形容力气极大","story":["秦朝末年，项羽少年时不喜欢读书写字，叔父项梁改教他击剑，他想学抵敌万人的本事，项梁教他兵法，他不肯认真钻研，但力气很大，能举起几百斤重的鼎。同刘邦争天下8年，最后被迫在垓下乌江边自刎，感慨自己“力拔山兮气盖世”"]},{"id":21235,"word":"拔山盖世","pinyin":"bá shān gài shì","abbr":"bsgs","explanation":"盖世：超越天下人，世上第一。力能拔掉大山，形容力大勇猛，当代无比。","source":{"text":"于是项王乃悲歌慷慨，自为诗曰：‘力拔山兮气盖世，时不利兮骓不逝。’","book":"《史记·项羽本纪》"},"example":{"text":"则～之雄，几乎其为若敖之鬼矣。","book":"明·张岱《募造无主祠堂疏》"},"similar":["拔山扛鼎"],"opposite":["手无缚鸡之力"],"usage":"作谓语、定语、补语；形容勇猛无比"},{"id":21236,"word":"拔山超海","pinyin":"bá shān chāo hǎi","abbr":"bsch","explanation":"拔起高山，超越大海。比喻力量极大。","source":{"text":"经天纬地之才，拔山超海之力。","book":"北周·庾信《拟连珠》"},"example":{"text":"天经地纬之帝，求制礼乐之才；拨乱反正之君，资～之力。","book":"唐·杨炯《唐右将军魏哲神道碑》"},"similar":["拔山扛鼎"],"usage":"作谓语、定语；形容力量很大"},{"id":21237,"word":"拔帜易帜","pinyin":"bá zhì yì zhì","abbr":"bzyz","explanation":"帜：旗帜；易：换。比喻推翻别人，自己占有。","source":{"text":"赵见我走，必空壁逐我，若疾入赵壁，拔赵帜，立汉赤帜。","book":"《史记·淮阴候列传》"},"example":{"text":"如今这里已～，另换新主了。"},"similar":["拔赵帜立汉帜","取而代之"],"usage":"作谓语；指取代","story":["西汉初年，韩信率汉军攻打赵军，即将到达井陉口，先挑选轻骑2000人，人持一红色旗帜，抄小路埋伏在赵营附近，接着背水列阵引诱赵军。赵军倾巢而出，汉军佯败而退，先前埋伏的士兵冲进赵军营中挂上汉军红旗，赵军因此大败"]},{"id":21238,"word":"拔帜树帜","pinyin":"bá zhì shù zhì","abbr":"bzsz","explanation":"用以比喻偷换取胜或战胜、胜利之典。","source":{"text":"见“拔赵帜易汉帜”。"},"example":{"text":"～燃列炬，中丞盼断关山尘。","book":"清·林寿图《谭军门以饥军三营至凤翔与犒一餐是夜报夺上关寄呈刘中丞》诗"},"similar":["拔帜易帜"],"usage":"作谓语、定语；指战胜对方","story":["西汉初年，韩信率汉军攻打赵军，即将到达井陉口，先挑选轻骑2000人，人持一红色旗帜，抄小路埋伏在赵营附近，接着背水列阵引诱赵军。赵军倾巢而出，汉军佯败而退，先前埋伏的士兵冲进赵军营中挂上汉军红旗，赵军因此大败"]},{"id":21239,"word":"拔新领异","pinyin":"bá xīn lǐng yì","abbr":"bxly","explanation":"拔：抽出；新：新意；领：具有；异：指独特之处。指创立新意，提出独特的见解。","source":{"text":"支道林拔新领异，胸怀所及乃自佳，卿欲见不？","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"南朝·宋·刘义庆《世说新语·文学》：“支道林拔新领异，胸怀所及乃自佳，卿欲见不？”"},"similar":["标新立异"],"usage":"作谓语、定语；指提出新异的观点","story":["晋朝时期，王羲之为会稽内史时，孙兴公推荐支道林，说他看问题拔新领异。王羲之自傲不愿与支道林交谈。支道林默默地退出。后来王羲之外出办事见到高僧支道林，就和他谈起了《庄子·逍遥游》，没想到支道林的论述十分精辟与新奇，王羲之十分佩服"]},{"id":21240,"word":"拔旗易帜","pinyin":"bá qí yì zhì","abbr":"bqyz","explanation":"旗：旗帜；易：换。拔掉别人的旗子，换上自己的旗子。比喻取而代之。","source":{"text":"赵见我走，必空壁逐我，若疾入赵壁，拔赵帜，立汉赤帜。","book":"西汉·司马迁《史记·淮阴候列传》"},"example":{"text":"我已经无能为力了，趁早～，让别人干吧。"},"similar":["拔帜易帜"],"usage":"作谓语；指取代","story":["西汉初年，韩信率汉军攻打赵军，即将到达井陉口，先挑选轻骑2000人，人持一红色旗帜，抄小路埋伏在赵营附近，接着背水列阵引诱赵军。赵军倾巢而出，汉军佯败而退，先前埋伏的士兵冲进赵军营中挂上汉军红旗，赵军因此大败"]},{"id":21241,"word":"拔本塞原","pinyin":"bá běn sè yuán","abbr":"bbsy","explanation":"①比喻背弃根本。②铲除事物发生的根源。多用于坏事。亦作“拔本塞源”。","source":{"text":"我在伯父，犹衣服之有冠冕，木水之有本原，民人之有谋主也。伯父若裂冠毁冕，拔本塞原，专弃谋主，虽戎狄其何有余一人？","book":"春秋·鲁·左丘明《左传·昭公九年》"},"example":{"text":"遂以此为～之义，而万物之情状大著。","book":"章炳麟《儒求真论》"},"similar":["拔本塞源"],"usage":"作谓语、定语；比喻背弃根本"},{"id":21242,"word":"拔本塞源","pinyin":"bá běn sè yuán","abbr":"bbsy","explanation":"本：根本，根源。拔起树根，塞住水源。比喻防患除害要从根本上打主意。","source":{"text":"伯父若裂冠毁冕，拔本塞原，专弃谋主，虽戎狄其何有余一人。","book":"《左传·昭公九年》"},"example":{"text":"这也是个好办法，而且简单易行，不过还不是～之计。","book":"郭沫若《郑成功》第五章"},"similar":["拔本塞原","本末倒置"],"usage":"作谓语、定语；指人的行为"},{"id":21243,"word":"拔来报往","pinyin":"bá lái fù wǎng","abbr":"blbw","explanation":"报：通“赴”，迅速。很快地来，很快地去。形容频繁地奔来奔去。","source":{"text":"毋拔来，毋报往。","book":"《礼记少仪》"},"example":{"text":"少顷，以足床来，置地上，促客坐；又入，携短足几至，～，蹀躞甚劳。","book":"清·蒲松龄《聊斋志异·阿纤》"},"similar":["速来速往","跋来报往"],"usage":"作谓语；形容频繁往来"},{"id":21244,"word":"拔树寻根","pinyin":"bá shù xún gēn","abbr":"bsxg","explanation":"比喻追究到底。","source":{"text":"俺那里有的是秦人晋人，你可也休将咱盘问，则管里絮叨叨拔树寻根。","book":"元·无名氏《碧桃花》第一折"},"example":{"text":"雪娥恐怕西门庆来家～，归罪于己，在上房打磨。","book":"明·兰陵笑笑生《金瓶梅词话》第二十六回"},"similar":["追根究底"],"usage":"作谓语、宾语；同“寻根究底”"},{"id":21245,"word":"拔树搜根","pinyin":"bá shù sōu gēn","abbr":"bssg","explanation":"比喻追究到底，彻底查问。","source":{"text":"见“拔树寻根”。"},"example":{"text":"安爷恐有其中假，故此的，～要问明。","book":"《再生缘》第四五回"},"similar":["拔树寻根"],"usage":"作谓语、宾语；同“寻根究底”"},{"id":21246,"word":"拔树撼山","pinyin":"bá shù hàn shān","abbr":"bshs","explanation":"拔：拉出来；撼：摇动。拔起大树，摇动大山。形容力大无比。","source":{"text":"唤雨的注雨如倾，呼风的狂风乱吼，天摧地塌，拔树撼山。","book":"明·无名氏《哪吒三变》第四折"},"similar":["拔山扛鼎"],"usage":"作谓语、定语；指人大无比"},{"id":21247,"word":"拔毛济世","pinyin":"bá máo jì shì","abbr":"bmjs","explanation":"指受轻微损失而能有利于世人。","source":{"text":"禽子问杨朱曰：‘去子体之一毛以济一世，汝为之乎？’杨子曰：‘世固非一毛之所济。’禽子曰：‘假济，为之乎？’杨子弗应。","book":"语出《列子·杨朱》"},"example":{"text":"只“平生几两屐”细味之亦疏；而“～”事，尤牵强可笑。以予观之，此乃俗子谜也，何足为诗哉！","book":"金·王若虚《滹南诗话》卷三"},"opposite":["一毛不拔"],"usage":"作宾语、定语；指帮助世人","story":["战国时期，墨家学派代表墨翟主张“兼爱”、“非攻”，反对自私自利和无原则的仇杀，对立派杨朱则主张一切从自我的利益出发，即“为我”。墨翟的学生禽滑厘问杨朱：“你愿意拔你身上的一毛而利天下吗？”杨朱则反驳天下不是一毛能救的"]},{"id":21248,"word":"拔毛连茹","pinyin":"bá máo lián rú","abbr":"bmlr","explanation":"比喻互相推荐，用一个人就连带引进许多人。","example":{"text":"鬓角上发现几根白发，这一惊非同小可，平夙一毛不拔的人到这时候也不免要狠心的把它拔去，～，头发根上还许带着一颗鲜亮的肉珠。","book":"梁实秋《中年》"}},{"id":21249,"word":"拔犀擢象","pinyin":"bá xī zhuó xiàng","abbr":"bxzx","explanation":"擢：提升。比喻提拔才能出众的人。","source":{"text":"敕局数人，其间固有拔犀擢象见称一时者，然而析理精微，旁通注意，鲜如克（郑武子）。","book":"宋·王洋《与丞相论郑武子状》"},"example":{"text":"既然要人任人唯亲，又怎能做到～呢？"},"similar":["任人唯贤"],"opposite":["任人唯亲"],"usage":"作谓语；比喻选拔人才"},{"id":21250,"word":"拔类超群","pinyin":"bá lèi chāo qún","abbr":"blcq","explanation":"同“拔萃出类”。指高出众人。","source":{"text":"出于其类，拔乎其萃，自生民以来，未有盛于孔子也。","book":"语出《孟子·公孙丑上》"},"example":{"text":"任待要片时间～，则除是三般儿结果收因。","book":"元汤式《一枝花·劝妓女从良》套曲"},"similar":["拔萃出类","拔丛出类","超群拔类"],"opposite":["平平庸庸"],"usage":"作谓语、定语；指很杰出"},{"id":21251,"word":"拔群出类","pinyin":"bá qún chū lèi","abbr":"bqcl","explanation":"指高出众人。","source":{"text":"必有天才，拔群出类。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"任待要片时间～，则除是三般儿结果收因。","book":"元·汤式《一枝花·劝妓女从良》"},"similar":["出类拔萃"],"usage":"作谓语、定语；多指才能"},{"id":21252,"word":"拔群出萃","pinyin":"bá qún chū cuì","abbr":"bqcc","explanation":"高出众人。多指才能。","source":{"text":"《晋书·夏侯湛传》：“弱年而入公朝，蒙蔽而当显举，进不能拔群出萃，却不能抗排当世。"},"similar":["出类拔萃","拔类超群"],"usage":"作谓语、定语；多指才能"},{"id":21253,"word":"拔舌地狱","pinyin":"bá shé dì yù","abbr":"bsdy","explanation":"佛教称人生前毁谤佛法，死后堕入受拔舌刑罚的地狱。后用来泛指因口舌罪过而堕入的地狱。","source":{"text":"若不悟去，老僧与尔入拔舌地狱。","book":"宋·释惟白《续传灯录》卷二"},"example":{"text":"若释氏之言不妄，此辈应堕～。","book":"清·冯班《钝吟杂录·刘向》"}},{"id":21254,"word":"拔苗助长","pinyin":"bá miáo zhù zhǎng","abbr":"bmzz","explanation":"比喻违反事物发展的客观规律，急于求成，反而坏事。","source":{"text":"宋人有闵其苗之不长而揠之者，茫茫然归，谓其人曰：‘今日病矣，予助苗长矣。’其子趋而往视之，苗则槁矣。","book":"《孟子·公孙丑上》"},"example":{"text":"那种不顾学生能否接受的填鸭式的教学方法，无异于～。"},"similar":["揠苗助长","急功近利"],"usage":"作谓语、宾语、定语；比喻不切实际地办事","story":["从前宋国一个农夫担心自己田里的禾苗长不高，就天天到田边去看。三天过去了，禾苗没见动静。他想出一个办法，就急忙奔到田里，把禾苗一棵棵拔高一些。回去对儿子说禾苗长高了一大截，儿子跑到田里一看，禾苗全都枯死了"]},{"id":21255,"word":"拔茅连茹","pinyin":"bá máo lián rú","abbr":"bmlr","explanation":"茅：白茅，一种多年生的草；茹：植物根部互相牵连的样子。比喻互相推荐，用一个人就连带引进许多人。","source":{"text":"拔茅茹以其汇。","book":"《周易·泰》"},"example":{"text":"袁既病死，黎、段登台，～，弹冠相庆，徐遂入任为院秘书长。","book":"蔡东藩、许廑父《民国通俗演义》第七十九回"},"usage":"作谓语；比喻相互引荐"},{"id":21256,"word":"拔萃出类","pinyin":"bá cuì chū lèi","abbr":"bccl","explanation":"同“出类拔萃”。指高出众人。","source":{"text":"出于其类，拔乎其萃，自生民以来，未有盛于孔子也。","book":"语出《孟子·公孙丑上》"},"example":{"text":"夫宇宙绵邈，黎献纷杂，～，智术而已。","book":"南朝·梁刘勰《文心雕龙序志》"},"similar":["出类拔萃"],"opposite":["庸庸碌碌"],"usage":"作谓语、定语；指人的品行或才能等"},{"id":21257,"word":"拔萃出群","pinyin":"bá cuì chū qún","abbr":"bccq","explanation":"拔：超出。萃：原谓草丛生的样子，引伸为聚集，指聚集在一处的人或物。超出一般，在众人之上。","source":{"text":"出于其类，拔乎其萃，自生民以来，未有盛于孔子也。","book":"《孟子·公孙丑上》"},"example":{"text":"曾不能～，扬芳飞文，登天庭，序彝伦，扫六合之秽。","book":"汉·蔡邕《释诲》"},"similar":["拔萃出类","拔类超群"],"opposite":["平淡无奇"],"usage":"作谓语、定语；比喻才能等超出众人"},{"id":21258,"word":"拔葵去织","pinyin":"bá kuí qù zhī","abbr":"bkqz","explanation":"比喻做官的不与人民争利。","source":{"text":"故公仪子相鲁，之其见家织帛，怒而出其妻；食子舍而茹葵，愠而拔其葵。","book":"《汉书·董仲舒传》"},"example":{"text":"非谓～，且欲省息纷纭。","book":"《梁书、徐勉传》"},"usage":"作谓语、定语；指当官不与民争利"},{"id":21259,"word":"拔葵啖枣","pinyin":"bá kuí dàn zǎo","abbr":"bkdz","explanation":"拔人家的菜蔬，偷吃人家的枣子。比喻小偷小摸。","source":{"text":"阖境无拔葵啖枣之盗，而楚人到于今犹歌咏之。","book":"唐·独孤及《唐丞相故江陵尹御史大夫吕諲谥议》"},"similar":["小偷小摸","偷鸡摸狗"],"usage":"作谓语、定语；指贪小便宜"},{"id":21260,"word":"拔诸水火，登于衽席","pinyin":"bá yū shuǐ huǒ，dēng yú rèn xí","abbr":"bzshdyrx","explanation":"拔：拉出来；诸：之于；登：加、上；衽席：床席。把人从水火里拉出来，放在床席上。比喻解救陷于困境中的百姓。","source":{"text":"见两岸之间，四郊之上，耕人有炙肤皲足之烦，农女有捋桑行馌之勤，必曰：‘此朕拔诸水火而登于衽席者也。’","book":"明·宋濂《阅江楼记》"},"similar":["出于水火，登之衽席"],"opposite":["祸国殃民"],"usage":"作宾语、定语；指为别人解困"},{"id":21261,"word":"拔赵帜易汉帜","pinyin":"bá zhào zhì yì hàn zhì","abbr":"bzzyhz","explanation":"用以比喻偷换取胜或战胜、胜利之典。","source":{"text":"据《史记·淮阴侯列传》载，“信(韩信)所出奇兵二千骑，共候赵空壁逐利，则驰入赵壁，皆拔赵旗，立汉赤帜二千。”赵军进击不能胜，欲回营，见营中尽是汉军赤帜，大惊，“以为汉皆已得赵王将矣”，于是溃不成军，终于"},"example":{"text":"妻与生用～计，笑而行之。","book":"清·薄松龄《聊斋志异·人妖》"},"similar":["拔帜树帜"],"usage":"作谓语、定语、宾语；指战胜对方","story":["西汉初年，韩信率汉军攻打赵军，即将到达井陉口，先挑选轻骑2000人，人持一红色旗帜，抄小路埋伏在赵营附近，接着背水列阵引诱赵军。赵军倾巢而出，汉军佯败而退，先前埋伏的士兵冲进赵军营中挂上汉军红旗，赵军因此大败"]},{"id":21262,"word":"拔赵帜立赤帜","pinyin":"bá zhào zhì lì chì zhì","abbr":"bzzlcz","explanation":"用以比喻偷换取胜或战胜、胜利之典。","source":{"text":"见“拔赵帜易汉帜”。"},"example":{"text":"惜伪古文罅漏太多，弥缝匪易，虽盛气强词，仍不能～也。","book":"清·陈康祺《郎潜纪闻》"},"similar":["拔赵帜易汉帜"],"usage":"作谓语、定语；指战胜对方","story":["西汉初年，韩信率汉军攻打赵军，即将到达井陉口，先挑选轻骑2000人，人持一红色旗帜，抄小路埋伏在赵营附近，接着背水列阵引诱赵军。赵军倾巢而出，汉军佯败而退，先前埋伏的士兵冲进赵军营中挂上汉军红旗，赵军因此大败"]},{"id":21263,"word":"拔赵易汉","pinyin":"bá zhào yì hàn","abbr":"bzyh","explanation":"用以比喻偷换取胜或战胜、胜利之典。","source":{"text":"见“拔赵帜易汉帜”。"},"example":{"text":"所以他们的组织专争取同伍的人，埋头苦干，意欲将新军中除满人与官长外，全体运动成熟，一举而～。","book":"杨玉如《辛亥革命先著记》"},"similar":["拔赵帜易汉帜"],"usage":"作谓语、定语；指战胜对方","story":["西汉初年，韩信率汉军攻打赵军，即将到达井陉口，先挑选轻骑2000人，人持一红色旗帜，抄小路埋伏在赵营附近，接着背水列阵引诱赵军。赵军倾巢而出，汉军佯败而退，先前埋伏的士兵冲进赵军营中挂上汉军红旗，赵军因此大败"]},{"id":21264,"word":"拔辖投井","pinyin":"bá xiá tóu jǐng","abbr":"bxtj","explanation":"辖，车轴两端的键。指殷勤留客饮酒。","source":{"text":"遵耆酒，每天饮，宾客满堂，辄关门，取客车辖投井中，虽有急，终不得去。","book":"《汉书·陈遵传》"},"example":{"text":"～，于是口涌鼻溢，濡首及乱。","book":"晋·葛洪《抱朴子·洒诫》"},"similar":["取辖投井"],"usage":"作谓语、宾语；指热情待客","story":["西汉末年京兆尹陈遵性格豪爽，很有才气，而且非常好客，各地官员和四方豪杰都仰慕他的大名，经常去拜访他。陈遵大摆宴席，陪客人喝酒，为了留住客人，他命令仆人把客人马车上的辖拆下投到井里，客人只好留下来陪他喝酒"]},{"id":21265,"word":"拔锅卷席","pinyin":"bá guō juǎn xí","abbr":"bgjx","explanation":"①比喻带走全部家当。②犹言卷铺盖。比喻被解雇。","source":{"text":"大官们拔锅卷席的，都跑光了。","book":"孔厥《新儿女英雄传》第一回"},"example":{"text":"请～离开公司。"},"usage":"作谓语、宾语；指卷走"},{"id":21266,"word":"拖人下水","pinyin":"tuō rén xià shuǐ","abbr":"trxs","explanation":"拖：拉。拉别人下水。比喻勉强人一道做他不愿做的事（多指坏事）。","source":{"text":"这是娘子拖人下水，与我有什么相干。","book":"明·李素甫《元宵闹》第二十五出"},"example":{"text":"渠以私意于我，我却以正道劝之；渠是～，我却是救人上岸。","book":"清·黄宗羲《明儒学案·谏议贺医闾先生钦》"},"similar":["拖人落水"],"usage":"作谓语；多指坏事"},{"id":21267,"word":"拖人落水","pinyin":"tuō rén luò shuǐ","abbr":"trls","explanation":"犹言拖人下水。比喻勉强人一道做他不愿做的事（多指坏事）。","source":{"text":"杨谦因建之妻子有吃醋拈酸之病，恐明日惹柳氏嗔怪，说他拖人落水，因此不敢兜揽。","book":"《西湖二集·寄梅花鬼闹西阁》"},"example":{"text":"孙锦标《通俗常言疏证·水火》：“《梦笔生花·杭州俗语杂对》：‘～，调虎离山。’”"},"similar":["拖人下水"],"usage":"作谓语；多指坏事"},{"id":21268,"word":"拖儿带女","pinyin":"tuō ér dài nǚ","abbr":"tedn","explanation":"丁玲《太阳照在桑乾河上》：“拖儿带女的，起五更，熬半夜，这是造的什么孽呀！”","source":{"text":"你～，怎么会有时间来担此大任呢？"},"example":{"text":"路遥《平凡的世界》第六卷第30章：“学校的教室睡满了～的农民。”"},"similar":["拖家带口"],"usage":"作谓语、宾语、定语；形容生活负担重"},{"id":21269,"word":"拖后腿","pinyin":"tuō hòu tuǐ","abbr":"tht","explanation":"比喻牵制、阻挠别人或事物使不得前进。","example":{"text":"我希望你不要～。"},"usage":"作谓语、宾语；指障碍"},{"id":21270,"word":"拖天扫地","pinyin":"tuō tiān sǎo dì","abbr":"ttsd","explanation":"形容衣服太长。","source":{"text":"形容衣服太长。"},"example":{"text":"元·李文蔚《燕青搏鱼》第三折：“穿的那衣服，拖天扫地的，一脚踹着，不险些儿绊倒了。”"},"usage":"作谓语、定语；用于书面语"},{"id":21271,"word":"拖家带口","pinyin":"tuō jiā dài kǒu","abbr":"tjdk","explanation":"带着一家大小，指受家属拖累。","source":{"text":"金俊武说不定有一点钱，可他拖家带口的，不好为难金家湾的这个强人。","book":"路遥《平凡的世界》第二卷第30章"},"example":{"text":"带着一家大小，指受家属拖累。"},"similar":["拉家带口","拖儿带女"],"usage":"作谓语、宾语；指受家属拖累"},{"id":21272,"word":"拖拖拉拉","pinyin":"tuō tuō lā lā","abbr":"ttll","explanation":"以拖延为特征的行动、习惯或性格。","source":{"text":"不能慢慢吞吞，拖拖拉拉，议而不决，决而不行。","book":"邓小平《在全军政治工作会议上的讲话》"},"example":{"text":"我喜欢你这种～的性格。"},"similar":["拖拖沓沓"],"opposite":["雷厉风行"],"usage":"作谓语、宾语、定语；指人办事"},{"id":21273,"word":"拖拖沓沓","pinyin":"tuō tuō tà tà","abbr":"tttd","explanation":"形容做事拖拉。","source":{"text":"但这种错误比那种议而不决，决而不行、拖拖沓沓、长期解决不了问题的错误好得多，也容易纠正。","book":"邓小平《坚持党的路线，改进工作方法》"},"example":{"text":"这样～的人是难以完成任务的。"},"similar":["拖拖拉拉"],"opposite":["干脆利索"],"usage":"作谓语、定语；指做事拖拉"},{"id":21274,"word":"拖油瓶","pinyin":"tuō yóu píng","abbr":"typ","explanation":"妇女再嫁时携带的前夫的儿女。","source":{"text":"天祥没有儿女，杨氏是个二婚头，初嫁时带个女儿来，俗名叫做‘拖油瓶’。","book":"明·凌濛初《初刻拍案惊奇》卷三十三"},"example":{"text":"不是你父亲养的。难道是你娘～拖来的吗？","book":"清·李宝嘉《官场现形记》第四十回"},"usage":"作宾语、定语；用于口语"},{"id":21275,"word":"拖泥带水","pinyin":"tuō ní dài shuǐ","abbr":"tnds","explanation":"比喻说话做事不干脆利落。","source":{"text":"狮子翻身，拖泥带水。","book":"宋《碧岩录》卷一：“道个佛字，拖泥带水；道个禅字，满面惭惶。”宋·释道元《五灯会元》"},"example":{"text":"这篇文章～，读起来索然无味。"},"similar":["婆婆妈妈","牵丝攀藤"],"opposite":["简明扼要","直截了当"],"usage":"作谓语、宾语、定语；指不干脆"},{"id":21276,"word":"拖浆带水","pinyin":"tuō jiāng dài shuǐ","abbr":"tjds","explanation":"在泥水中行走被泥水玷污。比喻说话做事不干脆利落。","source":{"text":"若拖浆带水，就不是汉子了。","book":"清·李绿园《歧路灯》第58回"},"similar":["拖泥带水","带水拖泥"],"usage":"作谓语、宾语、定语；指不干脆"},{"id":21277,"word":"拖男带女","pinyin":"tuō nán dài nǚ","abbr":"tndn","explanation":"带领着子女。多用于形容旅途的辛苦或生计的艰难。","source":{"text":"就是我这师傅，不辞年高路远，拖男带女而来，他也是为好。","book":"清·文康《儿女英雄传》第二十五回"},"similar":["拖儿带女","拖男挟女"],"usage":"作谓语、宾语、状语；形容生活负担重"},{"id":21278,"word":"拖男挟女","pinyin":"tuō nán xié nǚ","abbr":"tnxn","explanation":"带领着子女。多用于形容旅途的辛苦或生计的艰难。","source":{"text":"只听得那风滚滚，雾腾腾，来得甚近，唬得那城外各关厢人等，拖男挟女，顾不得家私，都往州城中走，走入城门，将门闭了。","book":"明·吴承恩《西游记》第八十九回"},"similar":["拖男带女","拖儿带女"],"usage":"作谓语、宾语、状语；形容生活负担重"},{"id":21279,"word":"拖紫垂青","pinyin":"tuō zǐ chuí qīng","abbr":"tzcq","explanation":"紫、青：指古代贵官系印用的绶带颜色。指官居高位。","source":{"text":"纡青拖紫，朱丹其毂。","book":"汉·扬雄《解嘲》"},"similar":["拖青纡紫"],"usage":"作谓语、定语；用于贵人"},{"id":21280,"word":"拖金委紫","pinyin":"tuō jīn wěi zǐ","abbr":"tjwz","explanation":"佩带紫绶金印。比喻官高位显。","source":{"text":"十年说法伤心事，一例捐生抗战时。愧杀伪京奴妾辈，拖金委紫只行尸。","book":"沈钧儒《挽某君殉难》诗"},"usage":"作谓语、定语；用于书面语"},{"id":21281,"word":"拖青纡紫","pinyin":"tuō qīng yū zǐ","abbr":"tqyz","explanation":"汉制，诸侯佩带的印绶为紫色，公卿为青色。以之比喻官位显贵。","source":{"text":"纡青拖紫，朱丹其毂。","book":"汉·扬雄《解嘲》"},"example":{"text":"公门皆～，正应竭诚尽节，上答鸿恩，奈何坟土未干，即图反噬？","book":"蔡东藩《南北史演义》第九十五回"},"similar":["纡青拖紫"],"usage":"作谓语、定语；用于贵人"},{"id":21282,"word":"拖麻拽布","pinyin":"tuō má zhuài bù","abbr":"tmzb","explanation":"指戴孝。旧时，长辈丧亡，幼辈要披麻衣系白布。","source":{"text":"贫穷富贵轮回至，积攒下这万万贯资财一分也不使。只为折陪口含钱，干折了拖麻拽布子。","book":"元·郑庭玉《楚昭王疏者下船》第四折"},"example":{"text":"俺有朝一日身亡后，谁是我的～人？","book":"元·无名氏《合同文字》第二折"},"similar":["披麻戴孝"],"usage":"作谓语、定语、宾语；用于长辈亡故时"},{"id":21283,"word":"拗曲作直","pinyin":"niù qū zuò zhí","abbr":"aqzz","explanation":"故意将错的说成对的。比喻是非颠倒。","source":{"text":"方妈妈呆了半晌，开口不得，思想没收场，只得拗曲作直，说道：‘谁叫你私下通奸？我已告在官了。’","book":"明·凌濛初《二刻拍案惊奇》第35卷"},"similar":["扭曲作直"],"usage":"作谓语、定语；比喻颠倒是"},{"id":21284,"word":"拘介之士","pinyin":"jū jiè zhī shì","abbr":"jjzs","explanation":"拘：洁身自好；介：节操。指不贪不慕，廉洁正派的人。","source":{"text":"将恐拘介之士，或惮赏而不言，贪赇之人，将慕利而妄举。","book":"《晋书·王沉传》"},"example":{"text":"窃恐～或惮赏而不言，贪昧之人将慕利而妄举。","book":"《资治通鉴·魏纪九》"}},{"id":21285,"word":"拘俗守常","pinyin":"jū sú shǒu cháng","abbr":"jssc","explanation":"指受世俗平庸见解的束缚。","source":{"text":"而浅识之徒，拘俗守常，咸曰世间不见仙人，便云天下必有此事。","book":"晋·葛洪《抱朴子·论仙》"},"similar":["墨守成规"],"usage":"作谓语、定语；指人守旧"},{"id":21286,"word":"拘儒之论","pinyin":"jū rú zhī lùn","abbr":"jrzl","explanation":"拘儒：迂腐的书生。指平庸无聊的言论或见解。","source":{"text":"故未遑扣扃之义，而录拘儒之论。","book":"汉·桓谭《盐铁论·复古》"}},{"id":21287,"word":"拘墟之见","pinyin":"jū xū zhī jiàn","abbr":"jxzj","explanation":"拘：拘守；墟：指所居住的地方。原指井底之蛙受所处空间的限制，只能看到一点天空。现多用来形容狭镒短浅的见识。","source":{"text":"而以神明不测之德言之，则昊天者群灵之总汇，五帝者一神之化身，分之则为六天，合之仍为一体。必斤斤较量其高卑，斯拘墟之见也。","book":"汉·扬雄《汉言义疏·重黎卷第十》"},"example":{"text":"凡为余所习知者十之三四，最足以破小儒～而与夏虫语冰也。","book":"清·唐梦赉《聊斋志异序》"}},{"id":21288,"word":"拘奇抉异","pinyin":"jū qí jué yì","abbr":"jqjy","explanation":"指搜求奇异的文句。","source":{"text":"先生之作，遇景入咏，不拘奇抉异令龌龊束人口者，涵涵然有干霄之兴。","book":"唐·皮日休《郢州孟亭记》"},"similar":["搜奇猎异"],"usage":"作谓语、定语；指搜求奇异的文句"},{"id":21289,"word":"拘拘儒儒","pinyin":"jū jū rú rú","abbr":"jjrr","explanation":"拘拘：拘束，有所顾忌的样子；儒儒：指软弱、懦弱。形容局促不安，胆小怕事，无所作为。","source":{"text":"二三千里之远，今一举而至，与其终身拘拘儒儒于二百里内者，不亦异乎！","book":"元·杨奂《东游记》"}},{"id":21290,"word":"拘挛之见","pinyin":"jū luán zhī jiàn","abbr":"jlzj","explanation":"拘挛：拘束，拘泥。形容狭隘而固执的见识。","source":{"text":"此诗之出，必有相诟病者，谓不合题破次山碑，此亦习俗固陋，不能越拘挛之见也。","book":"宋·范成大《收浯溪中兴碑后序》"},"example":{"text":"且所号为贤者，谓其绝～，旷观于广大之区，而不以尺寸绳人者也。","book":"清·曾国藩《送郭筠仙南归序》"}},{"id":21291,"word":"拘挛补衲","pinyin":"jū luán bǔ nà","abbr":"jlbn","explanation":"拘挛：互相牵扯；补衲：缝补连缀。形容诗文勉强拼凑而不自然。","source":{"text":"遂乃句无虚语，语无虚字，拘挛补衲，蠹文已甚。","book":"南朝·梁·钟嵘《诗品·总论》"},"example":{"text":"使剑如同为文，你就看看文章若写得意深辞踬、嬉成流移、文同书钞、～之弊吧。","book":"温瑞安《一怒拔剑》三十七"},"usage":"作谓语、定语；指互相牵连"},{"id":21292,"word":"拘文牵义","pinyin":"jū wén qiān yì","abbr":"jwqy","explanation":"文：条文；义：字义。拘执于条文或字义。指谈话、做事不知灵活变通。","source":{"text":"我走了，你们便拘文牵义，做不成一宗事儿。","book":"清·李绿园《歧路灯》第五十五回"},"example":{"text":"非素臣侃侃而谈，若彼俗吏～，其能免乎？","book":"清·夏敬渠《野叟曝言》第五十三回"},"usage":"作谓语、定语；用于处事"},{"id":21293,"word":"拘文牵俗","pinyin":"jū wén qiān sú","abbr":"jwqs","explanation":"拘：拘守；牵：牵制。指束缚于繁文陋俗之中。","source":{"text":"且夫贤君之践位也，岂特委琐握齿，拘文牵俗，修诵习传，当世取悦云尔哉。","book":"汉·司马相如《难蜀父老》"},"example":{"text":"不～，则守职者辨治矣。","book":"宋·王安石《兴贤》"},"usage":"作谓语、定语；用于书面语"},{"id":21294,"word":"拘神遣将","pinyin":"jū shén qiǎn jiàng","abbr":"jsqj","explanation":"拘：拘使。指力量无穷。神通广大，能指挥天兵天将。","source":{"text":"芳官竟是个狐狸精变的，就是会拘神遣将的符咒也没有这么快。","book":"清·曹雪芹《红楼梦》第六十四回"},"example":{"text":"过五日后，于冰向不邪道：“我今日传你拘神遣将五行变化之法。”","book":"清·李百川《绿野仙踪》第三十八回"},"similar":["神通广大"],"usage":"作谓语、定语；指神通广大"},{"id":21295,"word":"拙于用大","pinyin":"zhuō yú yòng dà","abbr":"zyyd","explanation":"原指事物不同的使用，会产生不同的效果。后指量材使用。","source":{"text":"夫子固拙于用大矣。宋人有善为不龟手之药者，世世以洴澼絖为事。","book":"《庄子·逍遥游》"}},{"id":21296,"word":"拙口笨腮","pinyin":"zhuō kǒu bèn sāi","abbr":"zkbs","explanation":"嘴巴笨拙。指不善于言辞。","source":{"text":"咬文嚼字，秀才当行；拙口笨腮，农人本色。","book":"清·宣鼎《夜雨秋灯录续集》卷三"},"example":{"text":"俺这～说不过你。","book":"章振荣《借驴》"},"similar":["拙嘴笨舌","拙嘴笨腮","拙口钝腮"],"usage":"作谓语、定语；指人不善言词"},{"id":21297,"word":"拙口钝腮","pinyin":"zhuō kǒu dùn sāi","abbr":"zkds","explanation":"比喻嘴笨，没有口才。","source":{"text":"二哥，你和我一般，拙口钝腮，不要惹大哥热擦。","book":"明·吴承恩《西游记》第43回"},"example":{"text":"他就是～的一个人。"},"similar":["拙口钝辞","笨口拙舌","拙嘴笨舌"],"opposite":["伶牙俐齿"],"usage":"作宾语、谓语、定语；指人不善言语"},{"id":21298,"word":"拙口钝辞","pinyin":"zhuō kǒu dùn cí","abbr":"zkdc","explanation":"钝：笨拙，不灵活。比喻嘴笨，没有口才。","source":{"text":"我等愚卤，拙口钝腮，不会说话。","book":"明·吴承恩《西游记》第八十八回"},"similar":["拙口钝腮"],"usage":"作谓语、定语；指人不善言语"},{"id":21299,"word":"拙嘴笨腮","pinyin":"zhuō zuǐ bèn sāi","abbr":"zzbs","explanation":"犹拙嘴笨舌。嘴巴笨拙。指不善于言辞。","source":{"text":"不行，不行，我拙嘴笨腮的。","book":"刘厚明《常河叔叔》"},"similar":["拙口笨腮","拙嘴笨舌","拙口钝腮"],"usage":"作谓语、定语；指人不善言词"},{"id":21300,"word":"拙嘴笨舌","pinyin":"zhuō zuǐ bèn shé","abbr":"zzbs","explanation":"拙：笨。嘴舌笨拙，形容不善于讲话。","source":{"text":"我亦并非处处都去留心，只是嘴拙舌钝，不敢轻易开口。","book":"清·随缘下士《林兰香》"},"example":{"text":"我一个草木之人，～的。","book":"杨朔《中国人民的脚步声·望南山》"},"similar":["拙口钝辞","笨口拙舌","张口结舌"],"opposite":["巧舌如簧","油嘴滑舌","口若悬河"],"usage":"作谓语、定语；指人不善言词"},{"id":21301,"word":"拙手钝脚","pinyin":"zhuō shǒu dùn jiǎo","abbr":"zsdj","explanation":"钝：愚钝。形容动作不灵活","source":{"text":"那温大爷也不是知道什么人情世故的人，我拙手钝脚的也做不来。","book":"清·李百川《绿野仙踪》第54回"},"similar":["笨手笨脚"],"usage":"作定语、状语；用于书面语"},{"id":21302,"word":"拙眼讥评","pinyin":"zhuō yǎn jī píng","abbr":"zyjp","explanation":"拙眼：见识浅陋。自己见识浅陋却喜欢讥讽别人","source":{"text":"观人如观玉，拙眼喜讥评。","book":"宋·陆游《杂兴十首》诗"},"usage":"作谓语、定语；用于书面语"},{"id":21303,"word":"拙贝罗香","pinyin":"zhuō bèi luó xiāng","abbr":"zblx","explanation":"安息香的别名。"},{"id":21304,"word":"招之不来","pinyin":"zhāo zhī bù lái","abbr":"zzbl","explanation":"招：招呼。听到招呼不过来。形容人个性强，不轻易听命于他人。","source":{"text":"然至其辅少主，守城深坚，招之不来，麾之不去，虽自谓贲育亦不能夺之矣。","book":"《史记·汲郑列传》"},"example":{"text":"年羹尧来京，亟称珽，朕告以尝～，羹尧以语珽，珽复辞不至，以是朕益重之。（《清史稿·李绂传》）"}},{"id":21305,"word":"招之不来，麾之不去","pinyin":"zhāo zhī bù lái，huī zhī bù qù","abbr":"zzblhzbq","explanation":"招：招呼。听到招呼不过来，让他走也不走。形容人个性强，不轻易听命于他人。","source":{"text":"然至其辅少主，守城深坚，招之不来，麾之不去，虽自谓贲育亦不能夺之矣。","book":"《史记·汲郑列传》"},"opposite":["招之即来，挥之即去"],"usage":"作谓语、定语；用于书面语"},{"id":21306,"word":"招之即来","pinyin":"zhāo zhī jí lái","abbr":"zzjl","explanation":"一招手就过来。比喻随时听众召唤。也比喻指挥自如。","source":{"text":"至于缓急之际，决大策，安大众，呼之则来，挥之则散者，惟世臣，巨室为能。","book":"宋·苏轼《王仲仪真赞序》"},"example":{"text":"况且乎，这些教书先生本觉得可以～，挥之即去的，还有甚么顾惜呢。（清·云江女史《宦海钟》第二回）"}},{"id":21307,"word":"招之即来，挥之即去","pinyin":"zhāo zhī jí lái，huī zhī jí qù","abbr":"zzjlhzjq","explanation":"一招手就过来，一挥手就离去。比喻随时听众召唤。也比喻指挥自如。","source":{"text":"至于缓急之际，决大策，安大众，呼之则来，挥之则散者，惟世臣，巨室为能。","book":"宋·苏轼《王仲仪真赞序》"},"example":{"text":"况且乎，这些教书先生本觉得可以～的，还有甚么顾惜呢。（清·云江女史《宦海钟》第二回）"},"similar":["召之即来，挥之即去"],"opposite":["招之不来，麾之不去"],"usage":"作谓语、定语；用于书面语"},{"id":21308,"word":"招事惹非","pinyin":"zhāo shì rě fēi","abbr":"zsrf","explanation":"招惹是非。指无故生事。","source":{"text":"少年骄惰放肆……将来招事惹非，败坏家门。","book":"明·兰陵笑笑生《金瓶梅词话》第三十五回"},"similar":["招是生非","招是揽非","招是惹非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21309,"word":"招亡纳叛","pinyin":"zhāo wáng nà pàn","abbr":"zwnp","explanation":"招引接纳敌方叛逃的人。","source":{"text":"高祖起丰、沛以来，罔罗豪桀，招亡纳叛，亦已多矣。","book":"宋·司马光《资治通鉴·高帝五年》"},"example":{"text":"那时安禄山久蓄异志，专一～。","book":"明·冯梦龙《醒世恒言》第三十卷"},"similar":["招降纳叛"],"usage":"作谓语、定语；用于书面语"},{"id":21310,"word":"招兵买马","pinyin":"zhāo bīng mǎi mǎ","abbr":"zbmm","explanation":"旧时指组织或扩充武装力量。后比喻组织或扩充人力。","source":{"text":"于是遂起军往汝南驻扎，招兵买马，徐图征进。","book":"明·罗贯中《三国演义》第二十八回"},"example":{"text":"我们人手不足，需要～了。"},"similar":["招降纳叛"],"opposite":["孤军作战","顾盼自雄"],"usage":"作谓语、宾语；指扩军","story":["五代时期，刘知远因父母双亡，流落到徐州沛县，娶李员外的三小姐为妻。由于家贫遭到大舅子李洪的欺压，媒人李三叔告诉刘知远太原并州岳节度使在招兵买马，可以去应征混个前程。刘知远前去应征，从更夫做到九州安抚使"]},{"id":21311,"word":"招军买马","pinyin":"zhāo jūn mǎi mǎ","abbr":"zjmm","explanation":"犹招兵买马。","source":{"text":"今有汉三公子刘文叔，在白水村兴兵聚义，招军买马。","book":"元·无名氏《聚兽牌》第一折"},"example":{"text":"次早平明，唐僧登坐帐中，教军士把～旗儿扯起。","book":"《西游补》第十五回"},"similar":["买马招军","招兵买马"],"usage":"作谓语、宾语、定语；指扩军"},{"id":21312,"word":"招摇撞骗","pinyin":"zhāo yáo zhuàng piàn","abbr":"zyzp","explanation":"撞骗：寻机骗人。假借名义，进行蒙骗欺诈。","source":{"text":"学臣应用员役，傥有招摇撞骗及受贿传递等弊，提调官不行访拿究治者，亦交部议处。","book":"《清会典事例·七四八·刑部·吏律职制》"},"example":{"text":"只是奴才们在外头～，闹出事来，我就耽不起。","book":"清·曹雪芹《红楼梦》第一０六回"},"similar":["弄虚作假","欺上瞒下","掩人耳目"],"opposite":["实事求是","名不虚传"],"usage":"作谓语、定语；指坏人"},{"id":21313,"word":"招摇过市","pinyin":"zhāo yáo guò shì","abbr":"zygs","explanation":"招摇：张扬炫耀；市：闹市，指人多的地方。指在公开场合大摇大摆显示声势，引人注意。","source":{"text":"居卫月余，灵公与夫人同车，宦者雍渠参乘，出，使孔子为次乘，招摇市过之。","book":"《史记·孔子世家》"},"example":{"text":"这几个人，穿着奇装异服，～，得意洋洋。"},"similar":["引人注目","白日衣绣"],"usage":"作谓语、状语、定语；指故意引人注意","story":["公元前494年，孔子带着弟子子路、颜回周游到卫国，卫灵公想与他结为兄弟，而作风轻浮而执掌大权的卫灵公妻子南子故意挑逗孔子。卫灵公与南子带孔子出游，在大街上招摇过市，丝毫不提在卫国施行仁政之事，孔子只好带学生离开卫国"]},{"id":21314,"word":"招是惹非","pinyin":"zhāo shì rě fēi","abbr":"zsrf","explanation":"招惹是非。指无故生事。","source":{"text":"你许多时不行这条路，如今去端门看灯，从张员外门前经过，又是招是惹非。","book":"《京本通俗小说·志诚张主管》"},"example":{"text":"他虽然没有什么出色的本领，有时还爱贪点小利，可是人顶和气，也不～。","book":"欧阳山《高干大》第一章"},"similar":["招是生非","招是揽非","招事惹非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21315,"word":"招是揽非","pinyin":"zhāo shì lǎn fēi","abbr":"zslf","explanation":"犹招是惹非。","source":{"text":"忽听得有人叫道：‘岳相公在那里？’牛皋听得，便喊道：‘在这里！’岳大爷道：‘你又在此招是揽非了。’","book":"清·钱彩《说岳全传》"},"similar":["招是惹非","招是生非","招事惹非"],"opposite":["安分守己"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21316,"word":"招是搬非","pinyin":"zhāo shì bān fēi","abbr":"zsbf","explanation":"搬弄是非，引起争端。","source":{"text":"和尚本应该只管自己念经……他偏要放下经卷，横来招是搬非，大约是怀着嫉妒罢。","book":"鲁迅《坟·论雷峰塔的倒掉》"},"similar":["惹是生非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21317,"word":"招是生非","pinyin":"zhāo shì shēng fēi","abbr":"zssf","explanation":"招惹是非。指无故生事。","source":{"text":"他也有不平，有反抗，有战斗，而往往不过是将败落家族的妇姑勃谿，叔嫂斗法的手段，移到文坛上。嘁嘁嚓嚓，招是生非，搬弄口舌，决不在大处着眼。","book":"鲁迅《且介亭杂文末编·答徐懋庸并关于抗日统一战线问题》"},"similar":["招是惹非","招是揽非","招事生非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21318,"word":"招权纳贿","pinyin":"zhāo quán nà huì","abbr":"zqnh","explanation":"招权：弄权，揽权；纳贿：接受贿赂。抓权力，受贿赂。","source":{"text":"辩士曹丘生数招权顾金钱。","book":"《汉书·季布传》"},"example":{"text":"他父子济恶，～，卖官鬻爵。","book":"明·冯梦龙《古今小说》第四十卷"},"similar":["招权纳赇","招权纳赂"],"usage":"作谓语、定语；指人贪财"},{"id":21319,"word":"招权纳赂","pinyin":"zhāo quán nà lù","abbr":"zqnl","explanation":"把持权势，接受贿赂。","source":{"text":"不花骄恣无上，招权纳赂，奔竞之徒，皆出其门，骎骎有赵高、张让、田令孜之风。","book":"《元史·朴不花传》"},"example":{"text":"皆人间清要之官而～，欺世盜名，或于任所阳为廉洁，而阴受苞苴。","book":"明·李昌祺《剪灯余话·何思明游酆都录》"},"similar":["招权纳赇","招权纳贿"],"usage":"作谓语、定语；指人贪财"},{"id":21320,"word":"招权纳赇","pinyin":"zhāo quán nà qiú","abbr":"zqnq","explanation":"把持权柄，收受贿赂。同“招权纳贿”。","source":{"text":"因劾亨招权纳赇，肆行无忌。","book":"《明史·石亨传》"},"similar":["招权纳赂","招权纳贿"],"usage":"作谓语、定语；指人贪财"},{"id":21321,"word":"招架不住","pinyin":"zhāo jià bù zhù","abbr":"zjbz","explanation":"招架：抵挡。抵挡不了或没有力量再支持下去。","source":{"text":"姚天君招架不住，掩一锏，望内便走。","book":"明·许仲琳《封神演义》第48回"},"example":{"text":"因农民起来形势甚猛，地主阶级～，其武装势力大部分投降农会。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["担当不起"],"opposite":["一夫当关"],"usage":"作谓语、状语；指不能抵挡"},{"id":21322,"word":"招灾惹祸","pinyin":"zhāo zāi rě huò","abbr":"zzrh","explanation":"招引灾祸。","source":{"text":"难道我老夫妻两口自己照管不来，还带着个如花似玉的闺女去招灾惹祸不成！","book":"清·李渔《巧团圆·议赘》"},"example":{"text":"老张说怎么干，咱们就怎么干吧。别～，可没好处呀！","book":"甘铁生《“现代化”茶馆》第二章"},"similar":["招灾揽祸"],"usage":"作谓语、宾语、定语；指闯祸"},{"id":21323,"word":"招灾揽祸","pinyin":"zhāo zāi lǎn huò","abbr":"zzlh","explanation":"招揽灾祸。","source":{"text":"你直待要打破了砂锅，是你招灾揽祸。","book":"元本高明《琵琶记·牛小姐谏父》"},"example":{"text":"老官儿道：‘怎的没影响，怎的没人看见？只是他的对头利害，谁敢多嘴管这闲事，去～？’","book":"明·名教中人《好逑传》第一回"},"similar":["招灾惹祸"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21324,"word":"招花惹草","pinyin":"zhāo huā rě cǎo","abbr":"zhrc","explanation":"指挑逗、勾引女子。","source":{"text":"那一双积年招花惹草，惯细风情的贼眼，不离这妇人身上。","book":"明·兰陵笑笑生《金瓶梅词话》第二回"},"similar":["招蜂惹蝶","沾花惹草","招蜂引蝶"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":21325,"word":"招蜂引蝶","pinyin":"zhāo fēng yǐn dié","abbr":"zfyd","explanation":"招致蜜蜂，吸引蝴蝶。比喻吸引别人的注意。","source":{"text":"没准是很爱卖弄俊俏，四送秋波的人呢，嘿，招蜂引蝶之流，对不起，本人向来深恶痛绝。","book":"叶文玲《独特的歌》"},"example":{"text":"叶文玲《独特的歌》：“没准是很爱卖弄俊俏，四送秋波的人呢，嘿，～之流，对不起，本人向来深恶痛绝。”"},"similar":["卖弄风骚","招风惹草"],"usage":"作谓语、定语；指风流人士"},{"id":21326,"word":"招蜂惹蝶","pinyin":"zhāo fēng rě dié","abbr":"zfrd","explanation":"犹招蜂引蝶。","source":{"text":"她漂亮，美……在那穷乡僻壤之中，又焉能不招蜂惹蝶？","book":"《花城》1981年第3期"},"similar":["惹草拈花","招花惹草"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":21327,"word":"招财纳福","pinyin":"zhāo cái nà fú","abbr":"zcnf","explanation":"纳：享受。发财享福","source":{"text":"他看见自己的像，心想自己是个掌管招财纳福的天使，人们一定要出高价来买，就问值多少钱。","book":"伊索《伊索寓言·赫耳墨斯的雕像》"},"usage":"作宾语、定语；用于书面语"},{"id":21328,"word":"招财进宝","pinyin":"zhāo cái jìn bǎo","abbr":"zcjb","explanation":"招引进财气、财宝。","source":{"text":"招财进宝臻佳瑞，合家无虑保安存。","book":"元·刘唐卿《降桑椹》第二折"},"example":{"text":"你们家这棵大树，树大根深，受日月精华滋养，本是棵～的摇钱树。","book":"谌容《万年青》"},"similar":["发财致富","恭喜发财"],"opposite":["招灾惹祸","雪上加霜"],"usage":"作谓语、定语；用于祝贺语"},{"id":21329,"word":"招贤下士","pinyin":"zhāo xián xià shì","abbr":"zxxs","explanation":"对有才有德的人以礼相待，对一般有才能的人不计自己的身份去结交。","source":{"text":"礼贤下士，圣人垂训；骄多矜尚，先哲所去。","book":"《宋书·江夏文献王义恭传》"},"example":{"text":"于是宣王～，疏远嬖佞，散遣稷下游说之徒，以田婴为相国，以邹人孟轲为上宾，齐国大治。（明·冯梦龙《东周列国志》第八十九回）"},"similar":["招贤纳士","招贤礼士","礼贤下士"],"usage":"作谓语、宾语、定语；指网罗人才"},{"id":21330,"word":"招贤礼士","pinyin":"zhāo xián lǐ shì","abbr":"zxls","explanation":"招：招收；贤：有才德的人；士：指读书人。招收贤士，接纳书生。指广泛网罗人才","source":{"text":"……光辅汉帝，招贤礼士，修明庶政，以宰天下。","book":"宋·陈亮《酌古论·曹公》"},"similar":["招贤纳士","招贤下士"],"usage":"作谓语、宾语、定语；指网罗人才"},{"id":21331,"word":"招贤纳士","pinyin":"zhāo xián nà shì","abbr":"zxns","explanation":"招：招收；贤：有德有才的人；纳：接受；士：指读书人。招收贤士，接纳书生。指网罗人才。","source":{"text":"早则是泽及黎民，又待要招贤纳士礼殷勤，币帛降玄纁。","book":"《战国策·燕策一》：“燕昭王即位，卑身厚币以招贤者。”元·马致远《陈抟高卧》第二折"},"example":{"text":"这里有个～好汉柴大官人。","book":"明·施耐庵《水浒全传》第九回"},"similar":["纳士招贤","招贤礼士"],"usage":"作谓语、宾语、定语；指网罗人才"},{"id":21332,"word":"招门纳婿","pinyin":"zhāo mén nà xù","abbr":"zmnx","explanation":"招门：招进门。旧时男子家贫无财，女家无子，招以为婿。","source":{"text":"刘老头儿大概是看上了祥子，而想给虎妞弄个招门纳婿的‘小人’。","book":"老舍《骆驼祥子》"},"example":{"text":"刘老头儿大概是看上了祥子，而给虎妞弄个招门纳婿的“小人”。","book":"老舍《骆驼祥子》四"},"usage":"作谓语、定语、宾语；用于口语"},{"id":21333,"word":"招降纳叛","pinyin":"zhāo xiáng nà pàn","abbr":"zxnp","explanation":"原指收容接纳敌方投降叛变过来的人，以扩大自己的势力。现指收罗坏人，结党作恶。","source":{"text":"楚州破，命光世节制诸镇，力守通泰。完颜昌屯承楚，光世知其众思归，欲携贰之。……获敌不杀，令持钱文示其徒，有欲归者，扣江执钱为信。归者不绝。","book":"《宋史·刘光世传》"},"example":{"text":"无论谁搞～、结党营私的罪恶活动，都没有好下场。"},"similar":["招兵买马","结党营私","招亡纳叛"],"usage":"作谓语、定语；用于书面语"},{"id":21334,"word":"招降纳款","pinyin":"zhāo xiáng nà kuǎn","abbr":"zjnk","explanation":"招：招引；纳：接纳；款：投诚。指招引接纳敌方投降、叛变的人扩充势力","source":{"text":"岂非招降纳款，开之以自新乎！","book":"宋·何坦《西畴老人常言·明道》"},"similar":["招降纳顺","招降纳叛","招降纳附"],"usage":"作谓语、定语；用于书面语"},{"id":21335,"word":"招降纳附","pinyin":"zhāo xiáng nà fù","abbr":"zjnf","explanation":"招：招引；纳：接纳；附：归附。指招引接纳敌方投降、叛变的人扩充势力","source":{"text":"今出兵分定其地，招降纳附，勿纵士卒侵掠。","book":"《元史·来阿八赤传》"},"similar":["招降纳顺","招降纳叛","招降纳款"],"usage":"作谓语、定语；用于书面语"},{"id":21336,"word":"招降纳顺","pinyin":"zhāo xiáng nà shùn","abbr":"zjns","explanation":"招收投降的人，接纳敌方归顺的人。","source":{"text":"昔高祖之得天下，盖为能招降纳顺，公何拒韩忠耶？","book":"明·罗贯中《三国演义》第二回"},"similar":["招降纳叛","招降纳款","招降纳附"],"usage":"作谓语、定语；用于书面语"},{"id":21337,"word":"招风惹草","pinyin":"zhāo fēng rě cǎo","abbr":"zfrc","explanation":"比喻招惹是非。","source":{"text":"你只会怨我顾前不顾后，你怎么不怨宝玉外头招风惹草的呢？","book":"清·曹雪芹《红楼梦》第三十四回"},"similar":["招风揽火","招惹是非"],"usage":"作谓语、定语；指招惹是非"},{"id":21338,"word":"招风惹雨","pinyin":"zhāo fēng rě yǔ","abbr":"zfry","explanation":"比喻惹是生非，引出事端。","source":{"text":"这监生不惟遮不得风，避不得雨，且还要招风惹雨。","book":"清·西周生《醒世姻缘传》第四十二回"},"similar":["惹是生非","招风揽火","招风惹草"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":21339,"word":"招风揽火","pinyin":"zhāo fēng lǎn huǒ","abbr":"zflh","explanation":"比喻招惹是非。","source":{"text":"地方轻薄子弟不少，你又生得美貌，莫在门前窥瞰，招风揽火。","book":"明·冯梦龙《古今小说》第一卷"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第九卷：“是他自家～，怎倒打你？”"},"similar":["招惹是非"],"usage":"作谓语、定语；指招惹是非"},{"id":21340,"word":"招魂扬幡","pinyin":"zhāo hún yáng fān","abbr":"zhyf","explanation":"魂：古时迷信认为人死后的魂魄；幡：一种窄长的旗子，这里指招魂幡。大张旗鼓地为死者招魂。现比喻为旧事物复活摇旗呐喊。","example":{"text":"她又在为资本主义～了"},"similar":["扬幡招魂"],"usage":"作谓语、定语；指复旧"},{"id":21341,"word":"招魂续魄","pinyin":"zhāo hún xù pò","abbr":"zhxp","explanation":"魂、魄：古时迷信认为人死后的魂魄。招回其灵魂，使魂魄不失散。","source":{"text":"郑国之俗，三月上巳，之溱、洧两水之上，招魂续魄，秉兰草，祓除不祥。","book":"《后汉书·礼仪志》"},"example":{"text":"郑制，上巳溱洧祓除，秉兰～。（明·张岱《夜航船》卷一）"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":21342,"word":"拜倒辕门","pinyin":"bài dǎo yuán mén","abbr":"bdym","explanation":"辕门：将帅行辕或军营的大门。形容对别人佩服之至，自愿认输。","source":{"text":"若非一部全史了然于中，何能如此。妹子唯有拜倒辕门了。","book":"清·李汝珍《镜花缘》第53回"},"example":{"text":"我现在～也还不为迟。"},"similar":["五体投地"],"usage":"作谓语、宾语、定语；指自愿服输"},{"id":21343,"word":"拜将封侯","pinyin":"bài jiàng fēng hóu","abbr":"bjfh","explanation":"拜为将领，封为列侯。古代形容功成名就，官至极品。","source":{"text":"我也曾陋巷淹留，贫寒常受，红尘火，今日个拜将封侯，才得个名成就。","book":"元·无名氏《暗度陈仓》第一折"},"example":{"text":"我也弗图个为官作相，我也弗图个～。","book":"明·吉邱瑞《运甓记·牛眠指穴》"},"similar":["拜相封侯"],"usage":"作谓语、宾语；形容功成名就"},{"id":21344,"word":"拜恩私室","pinyin":"bài ēn sī shì","abbr":"bess","explanation":"指感谢有权势的人的推荐提拔。","source":{"text":"受恩天朝，拜恩私室，自古以为干纪。","book":"《北史·王晞传》"},"example":{"text":"你说得不错，于今“受职公堂，～”者，比比皆是。","book":"高阳《胭脂井》"},"usage":"作谓语；指用人"},{"id":21345,"word":"拜手稽首","pinyin":"bài shǒu qǐ shǒu","abbr":"bsqs","explanation":"拜手：作揖；稽首：古时的一种跪拜礼，叩头至地，是九拜中最恭敬的。用于书信向对方表示敬意。","source":{"text":"皋陶拜手稽首。","book":"《尚书·益稷》"},"example":{"text":"公～，受命白玉墟。","book":"宋·李清照《上枢密韩肖胄诗》"},"usage":"作谓语、宾语、定语；指古代的礼节"},{"id":21346,"word":"拜把兄弟","pinyin":"bài bǎ xiōng dì","abbr":"bbxd","explanation":"朋友结为异姓兄弟。","source":{"text":"我们四人都是很好的～。"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“一个是我～，请王大老爷栽培。”"},"similar":["拜把子"],"usage":"作主语、宾语、定语；用于异姓之间结交"},{"id":21347,"word":"拜把子","pinyin":"bài bǎ zǐ","abbr":"bbz","explanation":"朋友结为异姓兄弟","source":{"text":"你说起拜把子，我说个笑话给你听。","book":"清·吴趼人《二十年目睹之怪现状》第23回"},"example":{"text":"曾朴《孽海花》第19回：“我们老人家给总管连公公是～，是他通的信。”"},"similar":["拜把兄弟"],"usage":"作宾语、定语；用于交往等"},{"id":21348,"word":"拜相封侯","pinyin":"bài xiàng fēng hóu","abbr":"bxfh","explanation":"拜：用一定的礼仪授予某种名义或官职。任命为宰相，封为列侯。形容成就功名，官至极品。","source":{"text":"他道是御酒金瓯，浅酌低讴，锦带吴钩，拜相封侯。","book":"元·无名氏《东篱赏菊》第一折"},"example":{"text":"高阳《胡雪岩全传·萧瑟洋场》：“～，位极人臣，饮水思源，亦不能不感激曾国藩。”"},"similar":["拜将封侯"],"usage":"作谓语、宾语；形容功成名就"},{"id":21349,"word":"拜赐之师","pinyin":"bài cì zhī shī","abbr":"bczs","explanation":"用以讽刺为复仇而又失败的出兵。","source":{"text":"《左传·文公二年》：“春秋时，秦晋殽之战，秦将孟明视被俘。获释时，孟谓晋君曰：‘三年将拜君赐。’后三年，秦果然出兵伐晋复仇。又败，晋人讥之为“拜赐之师”。"}},{"id":21350,"word":"拜鬼求神","pinyin":"bài guǐ qiú shén","abbr":"bgqs","explanation":"向鬼神叩拜祈祷，求其保佑。","source":{"text":"扬州桥边小妇，长干市里商人，三年不得消息，各自拜鬼求神。","book":"唐·王建《三台》诗"},"example":{"text":"他老相信那些～的方法会奏效的。"},"similar":["求神拜鬼"],"usage":"作谓语、定语；指迷信活动"},{"id":21351,"word":"拟不于伦","pinyin":"nǐ bù yú lún","abbr":"nbyl","explanation":"拟：比拟；伦：同类。指不以同类或同等事物来比拟。比拟失当。","source":{"text":"拟人必于其伦。","book":"西汉·戴圣《礼记·曲礼下》"},"example":{"text":"《皇极经世书》谓日入地中者，男女构精之像。不惟～，乃并不知日不入地，此可谓知天乎？","book":"清·谭嗣同《思篇》"},"similar":["拟于不伦","拟非其伦"],"usage":"作宾语、定语；指比拟不当"},{"id":21352,"word":"拟于不伦","pinyin":"nǐ yú bù lún","abbr":"nybl","explanation":"用不能相比的人或事物来比方。","source":{"text":"天文以害意，自古而然，拟非其伦，由来尚矣。","book":"唐·刘知己《史通·浮词》"},"example":{"text":"董恂的话有些～，文祥听不入耳，便挥手止住了他。","book":"高阳《慈禧全传》三十三"},"similar":["拟不于伦","拟非其伦"],"usage":"作谓语、定语；指比拟不当"},{"id":21353,"word":"拟人必于其伦","pinyin":"nǐ rén bì yú qí lún","abbr":"nrbyql","explanation":"拟：比拟；伦：类。必须拿同类的人或事物相比。","source":{"text":"拟人必于其伦。","book":"《礼记·曲礼下》"},"example":{"text":"未可以少长异操，疑其所守之美，而远同终始之责，非所谓～之义也。","book":"《晋书·李重传》"},"similar":["拟人必以其伦"],"usage":"作宾语、定语；用于说话或写作等"},{"id":21354,"word":"拟人必以其伦","pinyin":"nǐ rén bì yǐ qí lún","abbr":"nrbyql","explanation":"拟：比拟；伦：同类。指比拟某人或某事，一定要用同类或同等的人和事物。","source":{"text":"洎乎中代，其体稍殊，或拟人必以其伦，或述事多比于古。","book":"唐·刘知畿《史通·叙事》"},"similar":["拟人必于其伦"],"usage":"作宾语、定语；用于说话或写作等"},{"id":21355,"word":"拟规画圆","pinyin":"nǐ guī huà yuán","abbr":"nghy","explanation":"按照圆规画圆形。比喻照老规矩办事，不知道变通。","example":{"text":"他经常～，没有变通。"},"similar":["墨守成规"],"usage":"作谓语、定语；指墨守成规"},{"id":21356,"word":"拟非其伦","pinyin":"nǐ fēi qí lún","abbr":"nfql","explanation":"指比拟不当。","source":{"text":"拟人必于其伦。","book":"西汉·戴圣《礼记·曲礼下》"},"example":{"text":"以岳忠武比良玉，毋乃～矣。","book":"清·赵翼《瓯北诗话·吴梅村诗》"},"similar":["拟不于伦"],"usage":"作谓语、宾语；指比拟不当"},{"id":21357,"word":"拣佛烧香","pinyin":"jiǎn fó shāo xiāng","abbr":"jfsx","explanation":"比喻看人行事或待人有厚薄。","source":{"text":"择佛烧好香，拣僧归供养。","book":"唐·寒山《诗》之一五九"},"example":{"text":"青娘可谓～矣。","book":"明·吴炳《疗妒羹·游湖》"},"usage":"作谓语、定语；比喻看人行事或待人有厚薄"},{"id":21358,"word":"拣精剔肥","pinyin":"jiǎn jīng tī féi","abbr":"jjtf","explanation":"拣：挑选；精：瘦肉；肥：肥肉。指刻意选择，多方挑剔。","source":{"text":"都氏只是拣精剔肥，东推西阻，媒婆说得丑些，又落得好推。","book":"明·伏雌教主《醋葫芦》第五回"},"similar":["拣精拣肥"],"usage":"作谓语、定语、宾语；指挑剔"},{"id":21359,"word":"拣精拣肥","pinyin":"jiǎn jīng jiǎn féi","abbr":"jjjf","explanation":"比喻挑剔，苛求。","source":{"text":"像娘这样费心，还不讨他说个是，只要拣精拣肥，我也犯不着要效他这个劳。","book":"清·吴敬梓《儒林外史》第27回"},"example":{"text":"平均分配工作，省得他～。"},"similar":["挑三拣四","拣精剔肥"],"usage":"作谓语、定语、宾语；指挑剔"},{"id":21360,"word":"拣精择肥","pinyin":"jiǎn jīng zé féi","abbr":"jjzf","explanation":"拣：挑选；精：瘦肉；肥：肥肉。比喻过分挑剔。","source":{"text":"又不要他花钱费钞，他偏会得拣精择肥。","book":"清·李渔《风筝误·糊鹞》"},"similar":["拣精拣肥"],"usage":"作谓语、定语、宾语；指挑剔"},{"id":21361,"word":"拥书南面","pinyin":"yōng shū nán miàn","abbr":"ysnm","explanation":"比喻藏书极其丰富或嗜书之深。同“拥书百城”。","source":{"text":"捉鼻东山关气运，拥书南面足经纶。","book":"《魏书·逸士传·李谧》：“丈夫拥书万卷，何假南面百城！”清·归庄《感怀》诗"},"example":{"text":"高枕北窗寻乐地，～作长城。","book":"清·赵翼《消闲》诗"},"similar":["拥书百城"],"usage":"作谓语、定语；指藏书多"},{"id":21362,"word":"拥书百城","pinyin":"yōng shū bǎi chéng","abbr":"ysbc","explanation":"比喻藏书极其丰富或嗜书之深。","source":{"text":"丈夫拥书万卷，何假南面百城！","book":"魏书·逸士传·李谧》"},"example":{"text":"沈砺《年来所志百不遂而书籍藏日富》诗：“黄泥亭子白茆堂，～南面王。”"},"similar":["拥书南面"],"usage":"作谓语、定语；指藏书多","story":["北魏时期，饱学多才的李谧博览群书，他无心去考取功名加入仕途，一生将家产变成书籍，他收集各种书籍并加以审订。经他审订的书有四千多卷，他给后人留下的名言是：“丈夫拥书万卷，何假南面百城！”"]},{"id":21363,"word":"拥兵玩寇","pinyin":"yōng bīng wán kòu","abbr":"ybwk","explanation":"玩：忽视，轻慢。指将帅掌握军队却不将消灭敌人当一回事。","source":{"text":"策愣辈拥兵玩寇，其病正坐此。","book":"《清史稿·策愣等传论》"},"usage":"作谓语、定语；用于处事等"},{"id":21364,"word":"拥兵自固","pinyin":"yōng bīng zì gù","abbr":"ybzg","explanation":"拥有掌握军队的权力，以巩固自己的地位。","source":{"text":"书至，无点，景不至。又闻神武疾，遂拥兵自固。","book":"唐·李延寿《北史·齐本纪上》"},"example":{"text":"景得书无点，辞不至；又闻欢疾笃，用其行台郎颍川王伟计，遂～。","book":"《资治通鉴·高祖武皇帝中大同元年》"},"usage":"作谓语、定语；用于处事等"},{"id":21365,"word":"拥兵自重","pinyin":"yōng bīng zì zhòng","abbr":"ybzz","explanation":"拥有军队，巩固自己。","source":{"text":"书至，无点，景不至，又闻神武疾，遂拥兵自固。","book":"《北齐书·神武纪下》"}},{"id":21366,"word":"拥军优属","pinyin":"yōng jūn yōu shǔ","abbr":"yjys","explanation":"拥戴人民军队，优待革命军人的家属。","example":{"text":"我们的～政策不变。"},"usage":"作谓语、宾语、定语；指重视军人"},{"id":21367,"word":"拥孺人，抱稚子","pinyin":"yōng rú rén，bào zhì zǐ","abbr":"yrrbzz","explanation":"孺人：妻子；稚子：幼儿。搂着妻子，抱着孩子。","source":{"text":"先生既绝交息游，左对孺子，右顾稚子，郁郁无可告语。","book":"清·黄宗羲《刘伯绳先生墓志铭》"},"example":{"text":"并不是所有的男人都喜欢～的生活"},"similar":["左对孺人，右顾稚子"],"usage":"作谓语、定语；用于书面语"},{"id":21368,"word":"拥彗先驱","pinyin":"yōng huì xiān qū","abbr":"yhxq","explanation":"彗：扫帚。手持扫帚，为贵宾在前面扫地引路。形容待客之礼极为诚敬。","source":{"text":"如燕，昭王拥彗先驱，请列弟子之座而受业。","book":"《史记·孟子荀卿列传》"},"example":{"text":"南朝·宋·范晔《后汉书·申屠蟠传》：“昔战国之世，处士横议，列国之主，至为～，卒有坑儒烧书之祸。”"},"similar":["拥彗清道","拥彗迎门"],"usage":"作谓语、定语；用于书面语"},{"id":21369,"word":"拥彗扫门","pinyin":"yōng huì sǎo mén","abbr":"yhsm","explanation":"彗：扫帚。手持扫帚，为贵宾在前面扫地引路。形容待客之礼极为诚敬。","source":{"text":"后上朝太公，太公拥篲迎门，却行欲拜。","book":"汉·荀悦《汉纪·高祖纪》"},"example":{"text":"分首判袂，叙别之辞；～，迎迓之敬。","book":"清·程允升《幼学琼林·朋友宾主》"}},{"id":21370,"word":"拥彗清道","pinyin":"yōng huì qīng dào","abbr":"yhqd","explanation":"拥：抱持；彗：扫帚。手拿扫帚，清扫道路。表示对来访者的敬意。","source":{"text":"辄复拥彗清道，企望尘躅者，以将来君子为亦有涉乎此也。","book":"晋·郭璞《尔雅序》"},"similar":["拥彗先驱","拥彗迎门"],"usage":"作谓语、定语；用于书面语"},{"id":21371,"word":"拥彗迎门","pinyin":"yōng huì yíng mén","abbr":"yhym","explanation":"手持扫帚扫地，在门前迎候贵客。表示对来客非常尊敬。","source":{"text":"后上朝太公，太公拥彗迎门，却行欲拜。","book":"汉·荀悦《汉纪·高祖纪》"},"similar":["拥彗先驱","拥彗清道"],"usage":"作谓语、定语；用于书面语"},{"id":21372,"word":"拥政爱民","pinyin":"yōng zhèng ài mín","abbr":"yzam","explanation":"军队拥护政府，爱护人民。","example":{"text":"人民军队～。"},"usage":"作谓语、宾语、定语；指人民军队"},{"id":21373,"word":"拥篲救火","pinyin":"yōng huǐ jiù huǒ","abbr":"yhjh","explanation":"指方法不当，事必不成。"},{"id":21374,"word":"拥篲清尘","pinyin":"yōng huì qīng chén","abbr":"yhqc","explanation":"拥：抱，持；篲：扫帚。手拿扫帚，清扫道路。表示对来访者的敬意。","source":{"text":"辄复拥篲清道，企望尘躅者，以将来君子为亦有涉乎此也。","book":"晋·郭璞《尔雅序》"},"example":{"text":"虽不必以之为重轻，而～，功不可没也。","book":"清·陈康祺《郞潜纪闻·二笔·积古斋钟鼎款识》"}},{"id":21375,"word":"拥雾翻波","pinyin":"yōng wù fān bō","abbr":"ywfb","explanation":"意即兴风作浪。","source":{"text":"他若是早早投降，便罢，若还现形发恶，拥雾翻波，就承此计擒捉未迟。","book":"明·杨慎《洞天玄记》第三折"},"similar":["兴风作浪"],"usage":"作谓语、定语；用于书面语"},{"id":21376,"word":"拥鼻吟","pinyin":"yōng bí yín","abbr":"yby","explanation":"用手捂着鼻子轻声吟咏。形容用雅正的声调拉长声音吟咏。","source":{"text":"天涯已有销魂别，楼上宁无拥鼻吟。","book":"唐·唐彦谦《春阴诗》"},"example":{"text":"梦笔亭边～，壮图蹭蹬老侵寻。","book":"宋·陆游《舟中感怀三绝句呈太傅相公兼简岳大用郎中》诗"}},{"id":21377,"word":"拥鼻微吟","pinyin":"yōng bí wēi yín","abbr":"ybwy","explanation":"用手捂着鼻子轻声吟咏。形容用雅正的声调拉长声音吟咏。","source":{"text":"天涯已有销魂别，楼上宁无拥鼻吟。","book":"唐·唐彦谦《春阴诗》"},"example":{"text":"江豚吹浪，晚来风转夜深雨。～，断肠新句。粉碧罗笺，封泪寄与。","book":"宋·贺铸《拥鼻吟·吴音子》词"}},{"id":21378,"word":"拦路虎","pinyin":"lán lù hǔ","abbr":"llh","explanation":"旧指拦路打劫的绿林人物。今也指前进道路上所遇到的困难。","source":{"text":"温是将门之子，绰号拦路虎，大王曾知否？","book":"明·洪楩《清平山堂话本·杨温拦路虎传》"}},{"id":21379,"word":"拨万论千","pinyin":"bō wàn lùn qiān","abbr":"bwlq","explanation":"形容财产众多，花钱以万千计。","source":{"text":"谢兄弟肯留纳，我将那拨万论千这回罢，深山中将一个养家心来按捺。","book":"元·郑廷玉《忍字记》条二折"},"example":{"text":"感承此间一个大官人爱，收录小弟在家中做个主管，每日～，尽托付杜兴身上。","book":"《水浒传》第四七回"},"similar":["拨万轮千"],"usage":"作谓语、状语；指人很富有"},{"id":21380,"word":"拨万轮千","pinyin":"bō wàn lún qiān","abbr":"bwlq","explanation":"形容财产众多，花钱以万千计。","source":{"text":"一盏盏接入手，可都干干的咽，卖弄他掂斤播两，拨万轮千。","book":"元·马致远《任风子》第一折"},"similar":["拨万论千"],"usage":"作谓语、状语；指人很富有"},{"id":21381,"word":"拨乱为治","pinyin":"bō luàn wéi zhì","abbr":"blwz","explanation":"犹拨乱反治。指消除混乱局面，恢复正常秩序。","source":{"text":"皇上拨乱为治，如月恒之无不临。","book":"清·王士禛《池北偶谈·谈故一·土鲁番表文》"},"similar":["拨乱反治"],"usage":"作谓语、宾语；用于治国政策方面"},{"id":21382,"word":"拨乱之才","pinyin":"bō luàn zhī cái","abbr":"blzc","explanation":"能平定乱世，使天下恢复安定的人才。","source":{"text":"事到骑虎之势，家国所关，非真拨乱之才，一代伟人，总难立脚。","book":"清·禇人获《隋唐演义》第五十三回"},"opposite":["无能之辈"],"usage":"作主语、宾语；指杰出治国人物"},{"id":21383,"word":"拨乱兴治","pinyin":"bō luàn xīng zhì","abbr":"blxz","explanation":"平定乱世，并着手治理。","source":{"text":"为会稽太守，拨乱兴治，立文学，学徒以千数。","book":"晋·常璩《华阳国志·先贤士女总赞》"},"usage":"作谓语、定语；指治理国家"},{"id":21384,"word":"拨乱反正","pinyin":"bō luàn fǎn zhèng","abbr":"blfz","explanation":"拨：治理；乱：指乱世；反：通“返”，回复。消除混乱局面，恢复正常秩序。","source":{"text":"拨乱世，反诸正，莫近诸《春秋》。","book":"《公羊传·哀公十四年》"},"example":{"text":"今天运将转，不过数十年，真人当出，～。","book":"明·冯梦龙《古今小说》卷三十二"},"similar":["拨云见天","旋转乾坤"],"opposite":["离经背道","每况愈下"],"usage":"作谓语、宾语、定语；指纠正重大错误","story":["封建社会为了巩固其等级制度和宗法制定一些礼教，儒家代表孔子提倡礼治，要求天子、诸侯、卿、大夫、士等遵守礼制，安于其位，秦末大规模的农民战争严重冲击了封建礼教，汉朝建立后，命人重修礼仪以正君臣之位，起到拨乱反正的作用"]},{"id":21385,"word":"拨乱反治","pinyin":"bō luàn fǎn zhì","abbr":"blfz","explanation":"犹拨乱反正。指消除混乱局面，恢复正常秩序。","source":{"text":"区区见五代之乱，天下涂炭极矣，常有拨乱反治之志。","book":"元·马致远《陈抟高卧》第一折"},"example":{"text":"夫～，苟无非常之才，其力固难以及远也。","book":"清·何焯《义门读书记·左传一》"},"similar":["拨乱反正","拨乱为治"],"usage":"作谓语、宾语；用于治国政策方面"},{"id":21386,"word":"拨乱济危","pinyin":"bō luàn jì wēi","abbr":"bljw","explanation":"平定乱世，救济危难。","source":{"text":"管、蔡既兴，谗谀滋蔓，大义灭亲，拨乱济危。","book":"晋·龚壮《上李寿封事》"},"similar":["拨乱济时"],"usage":"作谓语、定语；指人力挽狂澜"},{"id":21387,"word":"拨乱济时","pinyin":"bō luàn jì shí","abbr":"bljs","explanation":"平定乱世，救济时势。同“拨乱济危”。","source":{"text":"太祖皇帝拨乱济时，扶翼刘氏，又用受命于汉。","book":"《晋书·武帝纪》"},"similar":["拨乱济危"],"usage":"作谓语、定语；指人力挽狂澜"},{"id":21388,"word":"拨乱诛暴","pinyin":"bō luàn zhū bào","abbr":"blzb","explanation":"拨：治理；乱：乱世；诛：讨伐；暴：凶残。治平乱世，诛灭强暴。","source":{"text":"拨乱诛暴，平定海内，卒践帝祚，成于汉家。","book":"西汉·司马迁《史记·秦楚之际月表》"},"example":{"text":"高帝～，庶事草创，日不暇给。","book":"东汉·班固《汉书·外戚恩泽侯表》"},"usage":"作谓语、定语；指使天下安定"},{"id":21389,"word":"拨乱返正","pinyin":"bō luàn fǎn zhèng","abbr":"blfz","explanation":"拨：治理；乱：乱世；返：回复；正：正常。整顿混乱局面，恢复正常秩序。","source":{"text":"拨乱返正，以图中兴。","book":"宋·李纲《上皇帝封事》"},"similar":["拨乱反正"],"opposite":["离经叛道"],"usage":"作谓语、宾语、定语；指纠正重大错误"},{"id":21390,"word":"拨云撩雨","pinyin":"bō yún liáo yǔ","abbr":"byly","explanation":"比喻男女间的挑逗。","source":{"text":"他将那简帖儿传消寄信，词章儿拨雨撩云。","book":"元·无名氏《女贞观》第四折"},"example":{"text":"用一张助才情砑粉泥金纸，写就那诉离情～词。","book":"元·刘时中《一枝花·罗帕传情》套曲"},"similar":["拨雨撩云"],"usage":"作谓语；用于男女间的挑逗"},{"id":21391,"word":"拨云睹日","pinyin":"bō yún dǔ rì","abbr":"bydr","explanation":"拨开云彩看见太阳。形容受到启发，思想豁然开朗，或比喻见到光明，大有希望。同“拨云见日”。","source":{"text":"[卫瓘]见广而奇之……命诸子造焉，曰：‘此人之水镜，见之莹然，若披云雾而睹青云者也。’","book":"语出《晋书·乐广传》"},"example":{"text":"自别兄长台颜，一向有失听教，今得一见，如～。","book":"元·王实甫《西厢记》第二本楔子"},"similar":["拨云见日"],"usage":"作谓语、定语；用于冲破黑暗，见到光明"},{"id":21392,"word":"拨云见日","pinyin":"bō yún jiàn rì","abbr":"byjr","explanation":"拨开乌云见到太阳。比喻冲破黑暗见到光明。也比喻疑团消除，心里顿时明白。","source":{"text":"此人之水镜，见之莹然，若披云雾而睹青天也。","book":"《晋书·乐广传》"},"example":{"text":"晚生得蒙老先生指教，如～，感激不尽。","book":"清·吴敬梓《儒林外史》第三十九回"},"similar":["水落石出","拨云睹日"],"usage":"作谓语、定语；用于冲破黑暗，见到光明","story":["晋朝时期，乐广为太尉贾充所赏识，被荐为河南尹，乐广不愿意出任外官，就请潘岳写《呈太尉辞河南尹表》，名士王衍十分佩服乐广，认为他说话言简意赅，太子洗马卫玠的父亲对乐广的评价则是人中的水镜，见到他如同拨云见天"]},{"id":21393,"word":"拨云雾见青天","pinyin":"bō yún wū jiàn qīng tiān","abbr":"bywjqt","explanation":"只有推开密布的云雾才能看到湛湛蓝天。比喻冲破黑暗，见到光明。","source":{"text":"今遇明主，如拨云雾而见青天！","book":"明·罗贯中《三国演义》第六十五回"},"example":{"text":"久慕玉姐大名，未得面睹，今日得见，如～。","book":"明·冯梦龙《警世通言》第二十四卷"},"similar":["拨云见日"],"usage":"作宾语、定语；用于冲破黑暗，见到光明"},{"id":21394,"word":"拨嘴撩牙","pinyin":"bō zuǐ liáo yá","abbr":"bzly","explanation":"指挑拨是非。","source":{"text":"中间放着个蓼儿洼，明助着番家打汉家。通事中间，拨嘴撩牙。","book":"明·汤显祖《牡丹亭·围释》"},"similar":["挑拨是非"],"usage":"作谓语；形容搬弄是非"},{"id":21395,"word":"拨弃万事","pinyin":"bō qì wàn shì","abbr":"bqws","explanation":"拨弃：抛弃，丢开。把一切事情都抛开。形容不问世事，清静自处。","source":{"text":"拨弃万事不复谈，百觚之后那辞酒。","book":"宋·苏轼《答孔周翰求书与诗》"}},{"id":21396,"word":"拨弓曲矢","pinyin":"bō gōng qū shǐ","abbr":"bgqs","explanation":"拨弓：不正的弓；曲矢：弯曲的箭。弓箭不合格就射不中目标。泛指武器不精良。","source":{"text":"不能以拨弓曲矢中。","book":"《荀子·正论》"}},{"id":21397,"word":"拨烦之才","pinyin":"bō fán zhī cái","abbr":"bfzc","explanation":"拨烦：处理繁重的政务。办事利索，有处理繁重复杂事务的才能。","source":{"text":"钜鹿剧郡，旧难治，以君有拨烦之才，故特授任。","book":"《后汉书·谢夷吾传》"}},{"id":21398,"word":"拨草寻蛇","pinyin":"bō cǎo xún shé","abbr":"bcxs","explanation":"比喻招惹恶人，自找麻烦。","source":{"text":"亏杀你拨草寻蛇，亏杀你守株待兔。","book":"明·汤显祖《牡丹亭·回生》"},"example":{"text":"现今惧太后梗阻新改，你反～，撩起太后那边，好不误事！（清·黄小配《大马扁》第十二回）"},"similar":["自找麻烦"],"usage":"作谓语、宾语；用于自找麻烦"},{"id":21399,"word":"拨草瞻风","pinyin":"bō cǎo zhān fēng","abbr":"bczf","explanation":"比喻善于观察事物。","source":{"text":"沩曰：‘此去澧陵攸县，石室相连，有云岩道人，若能拨草瞻风，必为子之所重。’","book":"《五灯会元·云岩晟禅法嗣·洞山良价禅师》"},"usage":"作谓语、宾语；指人善于观察"},{"id":21400,"word":"拨雨撩云","pinyin":"bō yǔ liáo yún","abbr":"byly","explanation":"指挑逗、试探对方的情意。泛指调情。","source":{"text":"你用心拨雨撩云，我好意与你传书递缄。小姐呵，不肯搜自己狂为，待要寻人破绽。","book":"明·李日华《南西厢记·猜诗雪案》"},"example":{"text":"妆聋做哑，担惊受怕，无端～，成就了鸾孤凤寡。","book":"明·陈所闻《桂枝香·合欢》曲"},"similar":["拨云撩雨"],"usage":"作谓语、定语；用于男女间的挑逗"},{"id":21401,"word":"择主而事","pinyin":"zé zhǔ ér shì","abbr":"zzes","explanation":"事：侍奉。旧指选择明主，为他办事。","source":{"text":"岂不闻‘良禽择木而栖，贤臣择主而事？’","book":"明·罗贯中《三国演义》第十四回"},"example":{"text":"清·褚人获《隋唐演义》第三回：“凡事自有命数，不可奢望，亦不须性急；待时而动，～，不愁不富贵也。”"},"usage":"作谓语；指择业"},{"id":21402,"word":"择交而友","pinyin":"zé jiāo ér yǒu","abbr":"zjey","explanation":"选择结交而为朋友。指不随便交友。","source":{"text":"且卜邻而居，犹从改操；择交而友，尚能致益。","book":"宋·张君房《云笈七签》卷九十四"},"usage":"作谓语、定语；用于交往等"},{"id":21403,"word":"择人任势","pinyin":"zé rén rèn shì","abbr":"zrrs","explanation":"挑选合适的人才，利用有利的形势。","source":{"text":"故善者战，求之于势，不责于人，故能责人而势。","book":"《孙子·势篇》"},"usage":"作谓语、定语；用于处事"},{"id":21404,"word":"择人而事","pinyin":"zé rén ér shì","abbr":"zres","explanation":"事：侍奉。选择好人，侍奉终身。多指妓女选择所嫁对象。","source":{"text":"其实，采秋乘此机会，要择人而事，不理旧业。","book":"清·魏子安《花月痕》第七回"},"usage":"作谓语、定语；用于处事"},{"id":21405,"word":"择优录取","pinyin":"zé yōu lù qǔ","abbr":"zylq","explanation":"择：选择。选择优秀的录用。","source":{"text":"招生主要抓两条：第一是本人表现好，第二是择优录取。","book":"邓小平《教育战线的拨乱反正问题》"},"similar":["择优录用"],"usage":"作谓语、定语、宾语；用于考试或官场等"},{"id":21406,"word":"择优录用","pinyin":"zé yōu lù yòng","abbr":"zyly","explanation":"录用：录取，任用。选择优秀的加以录取和任用。"},{"id":21407,"word":"择其善者而从之","pinyin":"zé qí shàn zhě ér cóng zhī","abbr":"zqszecz","explanation":"择：选择；从：追随，引申为学习。指选择好的学，按照好的做。","source":{"text":"三人行，必有我师焉。择其善者而从之，其不善者而改之。","book":"《论语·述而》"},"example":{"text":"今两雄相持，将军若欲有为，乘此破敌可也。如其不然，将～。（明·罗贯中《三国演义》第二十三回）"},"similar":["择善而从"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21408,"word":"择利行权","pinyin":"zé lì xíng quán","abbr":"zlxq","explanation":"择：挑选；利：有利；权：权宜。挑选有利时机，采取变通措施。比喻适时应变。","source":{"text":"惟能因机而制变，择利而行权。","book":"明·西湖逸士《投笔肤谈·兵机》"},"similar":["随机应变"],"usage":"作谓语、定语；用于处事"},{"id":21409,"word":"择善固执","pinyin":"zé shàn gù zhí","abbr":"zsgz","explanation":"对认为正确的事就坚持执行。","source":{"text":"诚之者，择善而固执之者也。","book":"语出《礼记·中庸》"},"example":{"text":"～，未始不是一件好事！","book":"上官鼎《阳光三叠》第二九章"},"usage":"作宾语、定语、状语；用于处事"},{"id":21410,"word":"择善而从","pinyin":"zé shàn ér cóng","abbr":"zsec","explanation":"从：追随，引伸为学习。指选择好的学，按照好的做。","source":{"text":"三人行，必有我师焉。择其善者而从之，其不善者而改之。","book":"《论语·述而》"},"example":{"text":"遇事必详为考虑，而后与部下商议，～。","book":"老舍《张自忠·剧中重要人物说明》"},"similar":["见贤思齐","取长补短","从善如流"],"opposite":["同流合污","沆瀣一气","吹毛求疵"],"usage":"作谓语、宾语；指学好","story":["春秋时期，执政大臣魏献子把祈氏的领地分为7县，把羊舌氏的领地分为3县，委派与提拔一些地方长官。他想启用魏戊，担心人家说他偏私，问大夫成傳，成傳认为只要有才德，就不论亲疏，关键看能不能择善而从，能不能赏罚分明"]},{"id":21411,"word":"择善而行","pinyin":"zé shàn ér xíng","abbr":"zsex","explanation":"指选择有益的事去做。","source":{"text":"此直意在杜谏者之口，岂曰择善而行者乎？","book":"唐·魏徵《十渐不克终疏》"},"example":{"text":"《敦煌变文集·降魔变文》：“瞿昙何如磁六师？～应好事。”"},"similar":["择善而从"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21412,"word":"择地而蹈","pinyin":"zé dì ér dǎo","abbr":"zded","explanation":"选择地方行走。形容做事小心谨慎。","source":{"text":"或择地而蹈之，时然后出言，行不由径，非公正不发愤。","book":"《史记·伯夷列传》"},"example":{"text":"学生定要～，宁可失之严，不可失之纵也！","book":"清·李绿园《歧路灯》第五十八回"},"usage":"作谓语、定语；用于书面语"},{"id":21413,"word":"择木而处","pinyin":"zé mù ér chǔ","abbr":"zmec","explanation":"鸟儿选择合适的树木做巢。旧时比喻选择贤君明主，为其效命。","source":{"text":"是以明哲先识，择木而处，夏终殷挚，周聃晋黍，或笑或泣，抱籍遁走。","book":"汉·崔瑗《东观箴》"},"example":{"text":"汉·崔瑗《东观箴》：“是以明哲先识，～，夏终殷挚，周聃晋黍，或笑或泣，抱籍遁走。”"},"similar":["择木而栖"],"usage":"作谓语、定语；用于比喻句"},{"id":21414,"word":"择木而栖","pinyin":"zé mù ér qī","abbr":"zmeq","explanation":"栖：栖息。鸟儿选择合适的树木栖息。旧时比喻选择贤明君主，为其效命。","source":{"text":"是以明哲先识，择木而处，夏终殷挚，周聠晋黍，或笑或泣，抱籍遁走。","book":"《左传·哀公十一年》：“鸟则择木，木岂能择鸟？”汉·崔瑗《东观箴》"},"example":{"text":"良禽～，贤臣择主而事。见机不早，悔之晚矣。（明·罗贯中《三国演义》第三回）"},"similar":["择木而处"],"usage":"作谓语、定语；用于比喻句"},{"id":21415,"word":"择焉不精","pinyin":"zé yān bù jīng","abbr":"zybj","explanation":"精：精华。虽然经过选择，但却不是精华。","source":{"text":"荀与扬也，择焉而不精，语焉而不详。","book":"唐·韩愈《原道》"},"example":{"text":"吾谓即论缮刻亦～，犹门外也。（清·叶德辉《书林清话》卷一）"},"usage":"作谓语、定语；用于书面语"},{"id":21416,"word":"择祸从轻","pinyin":"zé huò cóng qīng","abbr":"zhcq","explanation":"遇到灾祸时选择轻的，可以减少损失。","source":{"text":"择福莫若重，择祸莫若轻。福无所用轻，祸无所用重。","book":"《国语·晋语》"},"usage":"作宾语、定语；用于处事"},{"id":21417,"word":"择福宜重","pinyin":"zé fú yí zhòng","abbr":"zfyz","explanation":"选择吉福之事应取重的。","source":{"text":"择福莫若重，择祸莫若轻。","book":"语出《国语·晋语六》"},"example":{"text":"晋王虽推心于我，然悬兵赴援，急难相应，宁我负人，～。","book":"《旧五代史·唐书·朱友谦传》"},"usage":"作宾语、定语；用于处事"},{"id":21418,"word":"择肥而噬","pinyin":"zé féi ér shì","abbr":"zfes","explanation":"择：挑选；噬：咬。比喻选择富裕的人进行敲诈勒索。","source":{"text":"上头限了首县三天限，首县限了差役一天半限。这些差役个个摩拳擦掌，择肥而噬。到得次日一早，果然捉了七八个人来。","book":"清·吴趼人《糊涂世界》卷九"},"usage":"作谓语；指有选择地吃"},{"id":21419,"word":"择邻而居","pinyin":"zé lín ér jū","abbr":"zlej","explanation":"挑选邻居好的地方居住。","source":{"text":"每因暂出犹思伴，岂得安居不择邻。","book":"唐·白居易《欲与元八卜邻先有是赠》诗"},"similar":["孟母三迁"],"usage":"作谓语、宾语、定语；用于处事","story":["战国时期，孟子小时非常聪明，经常模仿送葬人吹喇叭，孟母担心他荒废学业就把家搬到城里，刚好旁边是一个屠宰场，孟子很快就学会了杀猪宰羊，孟母只好搬家到一个学校附近，从此孟子就开始学习孔子的思想而成为一代思想家"]},{"id":21420,"word":"括囊不言","pinyin":"kuò náng bù yán","abbr":"knby","explanation":"括囊：扎束袋口。扎紧袋口不讲话。比喻闭口不言。","source":{"text":"车丞相即周鲁之列，当轴处中，括囊不言，容身而去，彼哉！彼哉！","book":"汉·桓宽《盐铁论·杂记》"}},{"id":21421,"word":"括囊守禄","pinyin":"kuò náng shǒu lù","abbr":"knsl","explanation":"括囊：扎束袋口；守禄：守住官禄。指说话谨慎，只想保住个人禄位。","source":{"text":"或见信之佐，括囊守禄。","book":"《后汉书·崔寔传》"},"example":{"text":"拜尘邀势，～，从来长息，以为深耻。","book":"《旧唐书·王志愔传》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":21422,"word":"括囊拱手","pinyin":"kuò náng gǒng shǒu","abbr":"kngs","explanation":"括囊：像扎好的口袋一样不说话；拱手：指无所作为。指大臣不谏言，就是无所作为。","source":{"text":"赵汴则括囊拱手，但务依违大臣，事君岂当如是。","book":"《宋史·刘述传》"},"usage":"作谓语、定语；指不说不干"},{"id":21423,"word":"括囊避咎","pinyin":"kuò náng bì jiù","abbr":"knbj","explanation":"括囊：束紧口袋；咎：罪责，灾祸。为人谨慎小心，不轻易说话，避免灾祸。","source":{"text":"不敢自同凡臣，括囊避咎。","book":"南朝·宋·范晔《后汉书·杨赐传》"},"usage":"作谓语、定语；指为人谨慎"},{"id":21424,"word":"括目相待","pinyin":"kuò mù xiāng dài","abbr":"kmxd","explanation":"用不同于以前的新的眼光来看待。"},{"id":21425,"word":"拭目以俟","pinyin":"shì mù yǐ sì","abbr":"smys","explanation":"形容期望很迫切。也表示确信某件事情一定会出现。同“拭目以待”。","source":{"text":"伏惟财幸笔橐之除，方且拭目以俟。","book":"宋·杨万里《答普州李知府》"},"similar":["拭目以待","拭目而待"],"usage":"作谓语、定语；形容殷切地盼望"},{"id":21426,"word":"拭目以待","pinyin":"shì mù yǐ dài","abbr":"smyd","explanation":"拭：擦；待：等待。擦亮眼睛等着瞧。形容期望很迫切。也表示确信某件事情一定会出现。","source":{"text":"观者骇视而拭目，听者倾首而竦耳。","book":"汉·杨修《答临淄侯笺》"},"example":{"text":"这样子，竟是一篇短评了。”（茅盾《尚未成功》","book":"定到最后一句“～”，他忽然又福至心灵，自家咕啜道"},"similar":["静观其变","拭目而待","拭目以俟"],"opposite":["置若罔闻"],"usage":"作谓语、定语；形容殷切地盼望"},{"id":21427,"word":"拭目以观","pinyin":"shì mù yǐ guān","abbr":"smyg","explanation":"擦亮眼睛看。","source":{"text":"公既在位，中外咸喜，信在言前，拭目以观。","book":"宋·邵博《闻见后录》卷十五"},"similar":["拭目而观"],"usage":"作谓语、定语；用于处事"},{"id":21428,"word":"拭目倾耳","pinyin":"shì mù qīng ěr","abbr":"smqe","explanation":"形容仔细看、听。","source":{"text":"今天子以盛年初即位，天下莫不拭目倾耳，观化听风。","book":"《汉书·张敞传》"},"example":{"text":"议者无复可言，唯～，以瞻望圣政而已矣。","book":"宋·司马光《论治身国所先》"},"opposite":["视而不见"],"usage":"作谓语；形容仔细看听"},{"id":21429,"word":"拭目而待","pinyin":"shì mù ér dài","abbr":"smed","explanation":"拭：擦；待：等待。擦亮眼睛等着瞧。形容期望很迫切。也表示确信某件事情一定会出现。","source":{"text":"观者骇视而拭目，听者倾首而竦耳。","book":"汉·杨修《答临淄侯笺》"},"example":{"text":"朝廷旧臣，册林隐士，无不～。","book":"明·罗贯中《三国演义》第四十三回"},"similar":["拭目以待","拭目以俟"],"usage":"作谓语；形容殷切地盼望"},{"id":21430,"word":"拭目而观","pinyin":"shì mù ér guān","abbr":"smeg","explanation":"擦亮眼睛看。同“拭目以观”。","source":{"text":"张栻有文武之才，有经济之学……陛下亦駸駸用之矣，天下方拭目而观，非观朝廷也，观栻也。","book":"宋·杨万里《上寿皇乞留张械黜韩玉书》"},"similar":["拭目以观"],"usage":"作谓语、定语；用于处事"},{"id":21431,"word":"拭面容言","pinyin":"shì miàn róng yán","abbr":"smry","explanation":"拭：擦；拭面：擦去别人吐在自己脸上的唾沫；容言：听取别人意见。泛指接受别人的批评，正确对待自己的错误。","source":{"text":"妇人轻丧武夫功，先轸当时怒气冲，拭面容言无愠意，方知嗣伯属襄公。","book":"明·冯梦龙《东周列国志》第四十五回"},"opposite":["拒谏饰非"],"usage":"作谓语、定语；指虚心接受别人的批评"},{"id":21432,"word":"拯危扶溺","pinyin":"zhěng wēi fú nì","abbr":"zwfn","explanation":"救助处于危难艰困中的人。","source":{"text":"岂有论道经邦之志，全无拯危扶溺之心。","book":"清·钱彩《说岳全传》第七十三回"},"similar":["拯溺扶危"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21433,"word":"拯危济困","pinyin":"zhěng wēi jì kùn","abbr":"zwjk","explanation":"危：危乱，指运筹中的国家。指拯救、帮助受难的百姓和动乱中的国家。","source":{"text":"然夷凶剪乱，拯溺扶危，四海乐推，三灵眷命，揖让而居南面者，陈氏也。","book":"《陈书·虞寄传》"},"example":{"text":"杀贪官，除豪强，～，救死扶伤，难道不都是以天地为心？（姚雪垠《李自成》第一卷第二十六章）"},"similar":["扶危济困"],"usage":"作谓语、定语；指救济有危难和困苦的人"},{"id":21434,"word":"拯溺扶危","pinyin":"zhěng nì fú wēi","abbr":"znfw","explanation":"拯：救。溺：落水者。危：危难。救助落水者，扶持危难中的人或国家。亦作“拯危扶溺”、“拯危济困”。","source":{"text":"然夷凶翦乱，拯溺扶危，四海乐推，三灵眷命，揖让而居南面者，陈氏也。","book":"《陈书·虞荔传》"},"example":{"text":"人人正好修功德，当起慈悲，～。","book":"金·马钰《战掉丑奴儿》词"},"similar":["拯危扶溺"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21435,"word":"拯溺救焚","pinyin":"zhěng nì jiù fén","abbr":"znjf","explanation":"拯：救；焚：被火烧；溺：落水者。救助被火烧火燎烧和被水淹的人。比喻救人于危难之中。","source":{"text":"臣恭守晋阳，驰心魏阙，被首濡足，拯溺救焚，大举义兵，式宁区宇。","book":"汉·王充《论衡·自纪》：“救火拯溺，义不得好；辩论是非，言不得巧。”唐·李渊《受禅告南郊文》"},"example":{"text":"足下试自思之，必有～之事。（明·冯梦龙《喻世明言》卷九）"},"similar":["救民水火"],"opposite":["落井下石"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":21436,"word":"拯焚救溺","pinyin":"zhěng fén jiù nì","abbr":"zfjn","explanation":"拯：救；焚：被火烧；溺：落水者。救助被火烧火燎烧和被水淹的人。比喻救人于危难之中。","source":{"text":"臣恭守晋阳，驰心魏阙，被首濡足，拯溺救焚，大举义兵，式宁区宇。","book":"汉·王充《论衡·自纪》：“救火拯溺，义不得好；辩论是非，言不得巧。”唐·李渊《受禅告南郊文》"},"example":{"text":"举朝～之精神，专用之摘抉细微，而以察吏诘戎予夺大柄仅付二三阉寺。（《明史·姜思睿传》）"}},{"id":21437,"word":"拱手低眉","pinyin":"gǒng shòu dī méi","abbr":"gsdm","explanation":"拱手：双手在胸前合抱，以示恭敬；低眉：向下垂着眉。双手合抱在胸前，低着头。形容恭敬顺从的样子。","source":{"text":"一律拱手低眉，不敢说或不屑说。","book":"鲁迅《“文人相轻”》"},"usage":"作宾语、定语；用于人的神态"},{"id":21438,"word":"拱手加额","pinyin":"gǒng shòu jiā é","abbr":"gsje","explanation":"拱手：两手在胸前合抱，表示致敬；加额：以手加额，表示祝贺。用以形容致敬祝贺。","source":{"text":"一日，海滨侯执帝手私语云云，帝拱手加额曰：‘皇天！皇天！’","book":"《新刊大宋宣和遗事》贞集"},"usage":"作定语、状语；用于表庆贺"},{"id":21439,"word":"拱手听命","pinyin":"gǒng shǒu tīng mìng","abbr":"gstm","explanation":"拱手：双手合抱在胸前，以示敬意。恭顺地听从对方的命令，毫无反抗。","source":{"text":"臣有一计，可使萧太后～。","book":"明·无名氏《杨家将演义》第二十四回"},"example":{"text":"边臣怵利害，～，致内属番人勾连接引，以至于今。","book":"《明史·陈九畴传》"},"similar":["俯首听命"],"usage":"作谓语、定语；指卑恭的样子"},{"id":21440,"word":"拱手垂裳","pinyin":"gǒng shòu chuí cháng","abbr":"gscs","explanation":"拱手：双手在胸前合抱；垂裳：衣裳下垂，指端坐。形容无为而治，安坐江山。","source":{"text":"惇信明义，崇德报功，垂拱而天下治。","book":"《尚书·武成》"},"example":{"text":"今陛下处积安之时，乘不拔之势，～而天下向风。","book":"宋·苏轼《御试制科策一道》"},"similar":["垂拱而治"],"usage":"作谓语、定语；指帝王无为而治"},{"id":21441,"word":"拱手而取","pinyin":"gǒng shòu ér qǔ","abbr":"gseq","explanation":"拱手：两手在胸前相抱。伸手毫不费力就可以拿来。","source":{"text":"于是秦人拱手而取西河之外。","book":"汉·贾谊《过秦论》"},"example":{"text":"齐右壤可～也。","book":"《史记·春申君列传》"},"similar":["唾手可得"],"usage":"作谓语、定语；指容易得到"},{"id":21442,"word":"拱手而降","pinyin":"gǒng shòu ér xiáng","abbr":"gsex","explanation":"拱手：两手在胸前合抱，表示恭敬。恭恭敬敬地俯首投降。","source":{"text":"斩汉将汤浇瑞雪，放心杀敌兵拱手而降。","book":"元·无名氏《聚兽牌》第一折"},"example":{"text":"正遇他两个，略施了些武艺，他俩～。","book":"元·无名氏《紫泥宣》第四折"},"similar":["拱手让人"],"usage":"作谓语；指不抵抗"},{"id":21443,"word":"拱手让人","pinyin":"gǒng shǒu ràng rén","abbr":"gsrr","explanation":"拱手：双手合抱在胸前，以示敬意。恭顺地让给别人。形容怯弱可欺或甘心为奴仆、附庸。","source":{"text":"明知众寡不敌，守不住这个青岛，但若拱手让人，殊不甘心。","book":"蔡东藩、许廑父《民国通俗演义》第41回"},"example":{"text":"我不会～的"},"similar":["拱手相让"],"opposite":["各不相让"],"usage":"作谓语、宾语；指不争夺"},{"id":21444,"word":"拱挹指麾","pinyin":"gǒng yì zhǐ huī","abbr":"gyzh","explanation":"指从容安舒，指挥若定。"},{"id":21445,"word":"拱揖指挥","pinyin":"gǒng yī zhǐ huī","abbr":"gyzh","explanation":"拱揖：拱手行礼。只须拱手行礼就可以指挥天下。形容从容不迫，镇定自若地指挥。","source":{"text":"上下一心，三军同力；名声足以暴炙之，威强足以捶笞之，拱揖指挥，而强暴之国莫不趋使。","book":"《荀子·富国》"},"usage":"作谓语；指人的神态"},{"id":21446,"word":"拱揖指麾","pinyin":"gǒng yī zhǐ huī","abbr":"gyzh","explanation":"指从容安舒，指挥若定。同“拱挹指麾”。"},{"id":21447,"word":"拱木不生危","pinyin":"gǒng mù bù shēng wēi","abbr":"gmbsw","explanation":"拱木：两臂合围那样粗的树木；危：危险的地方。大的树森林不生长在高而危险的地方。比喻忠臣没生在的危难的时期。","source":{"text":"直不辅曲，明不规暗，拱木不生危，桦柏不生埤。","book":"《国语·晋语八》"}},{"id":21448,"word":"拱肩缩背","pinyin":"gǒng jān suō bèi","abbr":"gjsb","explanation":"拱肩：肩往上耸。耸起肩膀，弯曲着腰。形容衰老或不健康的体态。","source":{"text":"只有他穿着那几件旧皮裳，越发显的拱户缩背，好不可怜见的！","book":"清·曹雪芹《红楼梦》第五十一回"},"example":{"text":"纪献唐看看，见那等～，摆摆摇摇的样子，不禁要笑。","book":"清·文康《儿女英雄传》第十八回"},"opposite":["昂首挺胸"],"usage":"作定语；形容衰老"},{"id":21449,"word":"拱默尸禄","pinyin":"gǒng mò shī lù","abbr":"gmsl","explanation":"拱默：拱手沉默，无话可说；尸禄：受禄却不尽职守。指坐享俸禄，无所事事的官僚。","source":{"text":"以苟容曲从为贤，以拱默尸禄为智。","book":"《汉书·鲍宣传》"}},{"id":21450,"word":"拳不离手","pinyin":"quán bù lí shǒu","abbr":"qbls","explanation":"拳：拳术。练武的人应该经常练。比喻勤学苦练，长期坚持。","source":{"text":"果真拳不离手，待我歇息片时再舞。","book":"清·无名氏《说呼全传》第七回"},"similar":["拳不离手，曲不离口"],"usage":"作宾语、定语；用于口语"},{"id":21451,"word":"拳不离手，曲不离口","pinyin":"quán bù lí shǒu，qǔ bù lí kǒu","abbr":"qblsqblk","explanation":"练武的人应该经常练，唱歌的人应该经常唱。比喻只有勤学苦练，才能使功夫纯熟。","source":{"text":"拳不离手，曲不离口，当战士的离不开刺刀手榴弹。","book":"林雨《刀尖》"},"example":{"text":"我们学习上要做到～。"},"usage":"作宾语、定语、分句；可分开使用"},{"id":21452,"word":"拳中掿沙","pinyin":"quán zhōng nuò shā","abbr":"qzns","explanation":"沙握在手里也捏不到一起。比喻关系不融洽。","source":{"text":"好家私便似水底捺瓜，亲子父便似拳中掿沙。","book":"元·张国宾《合汗衫》第二折"},"example":{"text":"他们两人是～走不到一起的。"},"usage":"作谓语、宾语；比喻关系不融洽"},{"id":21453,"word":"拳头上立得人，胳膊上走得路","pinyin":"quán tóu shàng lì dé rén，gē bó shàng zǒu dé lù","abbr":"qtsldrgbszdl","explanation":"比喻为人清白，作风正派，过得硬。","example":{"text":"人们夸他～，能包容别人的缺点。"},"similar":["拳头上立得人，胳膊上走得马"],"usage":"作宾语、定语；用于为人"},{"id":21454,"word":"拳头上立得人，胳膊上走得马","pinyin":"quán tóu shàng lì dé rén，gē bó shàng zǒu dé mǎ","abbr":"qtsldrgbszdm","explanation":"比喻为人清白，作风正派，过得硬。","source":{"text":"我是个拳头上站得人，胳膊上走得马，不带头巾男子汉，丁丁当当响的老婆。燕大，我与你要见一个明白！","book":"元·李文蔚《燕青搏鱼》第三折"},"example":{"text":"我是一个不戴头巾男子汉，叮叮当当响的婆娘！～，人面上行得人！不是那等搠不出的鳖老婆！","book":"明·施耐庵《水浒全传》第二十三回"},"similar":["拳头上立得人，胳膊上走得路"],"usage":"作宾语、定语；用于为人"},{"id":21455,"word":"拳头上站的人，胳膊上走的马","pinyin":"quán tóu shàng zhàn de rén，gē bó shàng zǒu de mǎ","abbr":"qtszdrgbszdm","explanation":"比喻为人清白，作风正派，过得硬。","source":{"text":"我是个拳头上站的人，胳膊上走的马，不带头巾男子汉，丁丁当当的老婆。","book":"元·李文蔚《燕青捕鱼》第三折"}},{"id":21456,"word":"拳头产品","pinyin":"quán tóu chǎn pǐn","abbr":"qtcp","explanation":"比喻企业特有的、别人难以胜过的看家产品。","example":{"text":"我们企业的～在国际上久负盛名。"},"usage":"作主语、宾语、定语；指看家产品"},{"id":21457,"word":"拳打脚踢","pinyin":"quán dǎ jiǎo tī","abbr":"qdjt","explanation":"用拳打，用脚踢。形容痛打。","source":{"text":"我便拳撞脚踢，也不怕他不死。","book":"元·李寿卿《伍员吹箫》第一折"},"example":{"text":"还说甚么！为你这两个人，带累我一顿～！","book":"清·吴敬梓《儒林外史》第九回"},"similar":["脚踢拳打"],"usage":"作谓语、宾语；指打架"},{"id":21458,"word":"拳拳之忠","pinyin":"quán quán zhī zhōng","abbr":"qqzz","explanation":"拳拳：形容诚恳。形容非常恳切。","source":{"text":"拳拳之忠，终不能自列。","book":"西汉·司马迁《报任少卿书》"},"example":{"text":"看在他～的份上，饶他一次吧。"},"usage":"作宾语；指非常恳切"},{"id":21459,"word":"拳拳之忱","pinyin":"quán quán zhī chén","abbr":"qqzc","explanation":"拳拳：恳切的样子；忱：情意。比喻恳切的情意。"},{"id":21460,"word":"拳拳之枕","pinyin":"quán quán zhī zhěn","abbr":"qqzz","explanation":"恳切的情意。"},{"id":21461,"word":"拳拳在念","pinyin":"quán quán zài niàn","abbr":"qqzn","explanation":"拳拳：恳切。在念：在思念之中。形容老是牵挂着。","source":{"text":"老夫自登仕途以来，与兄弟张镐数载不能相会，未知进取功名也流落四方? 老夫常切切于心，拳拳在念。","book":"元·马致远《荐福碑》第一折"},"example":{"text":"圣祖遇诸宗人厚，遗诏犹以礼亲王、饶馀亲王子孙安全，～。","book":"《清史稿·诸王传》"}},{"id":21462,"word":"拳拳服膺","pinyin":"quán quán fú yīng","abbr":"qqfy","explanation":"拳拳：紧握不舍，引伸为恳切；服膺：铭记心中。形容恳切地牢记不忘。","source":{"text":"得一善，则拳拳服膺而弗失之矣。","book":"《礼记·中庸》"},"example":{"text":"回之为人也，择乎中庸，得一善，则拳拳服膺而不失之矣。","book":"唐·韩愈《禘祫议》"},"usage":"作谓语；形容恳切地牢记"},{"id":21463,"word":"拳拳盛意","pinyin":"quán quán shèng yì","abbr":"qqsy","explanation":"拳拳：恳切、忠诚的样子。发自内心的真诚而深厚的情谊。","source":{"text":"拳拳盛意，感莫可言。","book":"鲁迅《书信集·致蒋抑厄》"},"example":{"text":"请不要辜负她的～。"},"similar":["深情厚意"],"opposite":["薄情寡意"],"usage":"作宾语、定语；指诚挚的情意"},{"id":21464,"word":"拼命三郎","pinyin":"pīn mìng sān láng","abbr":"pmsl","explanation":"梁山好汉石秀的绰号。比喻打仗勇敢不怕死或干事竭尽全力的人。","source":{"text":"自小学得些枪棒在身，一生执意，路见不平，但要去相助，人都呼小弟作‘拼命三郎’。","book":"明·施耐庵《水浒传》第44回"},"example":{"text":"他是我们单位典型的～。"},"usage":"作主语、宾语、定语；指勇敢的人"},{"id":21465,"word":"拼得一身剐，敢把皇帝拉下马","pinyin":"pīn dé yī shēn guǎ，gǎn bǎ huáng dì lā xià mǎ","abbr":"pdysggbhdlxm","explanation":"剐：古代酷刑，割肉。比喻再难的事，拼着一死也敢干下去。","source":{"text":"拼得一身剐，敢把皇帝拉下马。","book":"清·曹雪芹《红楼梦》第68回"},"similar":["舍得一身剐，敢把皇帝拉下马"],"usage":"作定语、分句；指大无畏精神"},{"id":21466,"word":"拼得工夫深，铁杵磨成针","pinyin":"pīn dé gōng fū shēn，tiě chǔ mó chéng zhēn","abbr":"pdgfstcmcz","explanation":"铁杵：铁棒槌。只要肯花大功夫，即使铁棒槌也能磨成绣花针。比喻只要肯花力气，事情一定能成功。","source":{"text":"道逢一老妪，磨铁杵。白问：‘将欲何用？’曰：‘欲作针。’白感其言，遂还卒业。","book":"元·虞韶《日记故事》"},"example":{"text":"～。再守他一年十二个月，好歹要掏摸些儿本事到手。","book":"明·罗贯中《平妖传》第十回"},"usage":"作宾语、定语、分句；用于劝诫人","story":["唐朝时期，著名诗人李白小时候从不认真读书，经常是把书本一抛就出去玩耍。一天李白碰到一个白发苍苍的老婆婆正拿着一根大铁棒在石头上磨，觉得好奇问她做什么，老婆婆告诉他要磨成绣花针，李白深受感动，从此就用功读书，终于成为文豪"]},{"id":21467,"word":"拼死拼活","pinyin":"pīn sǐ pīn huó","abbr":"psph","explanation":"①不顾一切地斗争。②用尽全部精力。","source":{"text":"这一对年轻的农民，在寒风中跪下对天立誓：将来如蒙天赐一个儿子，拼死拼活，也要让他读书识字，好替父亲记帐、要帐。","book":"冰心《我的故乡》"},"example":{"text":"士隐知投人不着，心中未免悔恨，再兼上年惊唬，急忿怨痛，已有积伤，暮年之人，～，竟渐渐的露出那下世的光景来。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["全力以赴"],"usage":"作状语、谓语；指全力以赴"},{"id":21468,"word":"拽巷啰街","pinyin":"zhuài xiàng luó jiē","abbr":"zxlj","explanation":"指大声呼叫，惊动街坊。","source":{"text":"我恰行出衙门，那妮子舞旋旋，摩拳擦掌，叫吖吖拽巷啰街。","book":"元·无名氏《争报恩》第二折"},"similar":["拽巷逻街","拽巷攞街"],"usage":"作谓语、定语；用于书面语"},{"id":21469,"word":"拽巷攞街","pinyin":"zhuài xiàng luǒ jiē","abbr":"zxlj","explanation":"指大声呼叫，惊动街坊。","source":{"text":"全不想离乡背井，动不动拽巷攞街。","book":"元·郑廷玉《金凤钗》第三折"},"similar":["拽巷逻街","拽巷啰街"],"usage":"作谓语、定语；用于书面语"},{"id":21470,"word":"拽巷逻街","pinyin":"zhuài xiàng luó jiē","abbr":"zxlj","explanation":"指大声呼叫，惊动街坊。","source":{"text":"动不动神头鬼脸，投河奔井，拽巷逻街，张舌骗口。","book":"元·武汉臣《玉壶春》第三折"},"similar":["拽巷啰街","拽巷攞街"],"usage":"作谓语、定语；用于书面语"},{"id":21471,"word":"拽布披麻","pinyin":"zhuài bù pī má","abbr":"zbpm","explanation":"穿孝服，服丧事。犹言披麻戴孝。","source":{"text":"但得一个生忿子拽布披麻扶灵柩，索强似那孝顺女罗裙包土筑坟台。","book":"元·武汉臣《老生儿》第一折"},"similar":["拽布拖麻","披麻戴孝"],"usage":"作谓语、宾语、定语；指尽孝"},{"id":21472,"word":"拽布拖麻","pinyin":"zhuāi bù tuō má","abbr":"zbtm","explanation":"穿孝服，服丧事。犹言披麻戴孝。","source":{"text":"拽布拖麻，奠酒浇茶，只索浅土儿权时葬下。","book":"元·白朴《梧桐雨》第三折"},"example":{"text":"倘或间掩命掩黄沙，则将这衫儿半壁匣盖上搭。哎！儿也，便当你香鶊啼，～。","book":"元·张国宾《合汗衫》第二折"},"similar":["披麻戴孝"],"usage":"作谓语、宾语、定语；指尽孝"},{"id":21473,"word":"拽拳丢跌","pinyin":"zhuài quán diū diē","abbr":"zqdd","explanation":"指打拳摔跤。","source":{"text":"俺是韩通的徒弟，今日拽拳丢跌已罢，师父吃酒去了，我两个无甚事。","book":"元·无名氏《打韩通》第二折"},"usage":"作谓语、宾语；用于书面语"},{"id":21474,"word":"拽欛扶犁","pinyin":"zhuāi bà fú lí","abbr":"zbfl","explanation":"拽：用力拉。指以种田为业","source":{"text":"偏不肯拽欛扶犁，常只是抛了农器演武艺。","book":"元·张国宾《薛仁贵》第三折"},"similar":["拽耙扶犁"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":21475,"word":"拽耙扶犁","pinyin":"zhuāi pá fú lí","abbr":"zpfl","explanation":"从事农业活动，以种田为业。","source":{"text":"哥哥！你倒好拽耙扶犁，怎生打的他来？","book":"《孤本元明杂剧·东平府》第二折"},"similar":["拽欛扶犁"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":21476,"word":"拽象拖犀","pinyin":"zhuài xiàng tuō xī","abbr":"zxtx","explanation":"能徒手拉住大象拖动犀牛。形容勇力过人。","source":{"text":"我可也杀人放火偏能惯，拽象拖犀气力高。","book":"元·无名氏《大战邳彤》第一折：“凭着我拽象拖犀胆气雄，更那堪武艺精，怕什么奸贼巨鹿狠邳彤。”元·无名氏《活拿萧天佑》第二折"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":21477,"word":"拾人唾余","pinyin":"shí rén tuò yú","abbr":"srty","explanation":"比喻自己没有创同，只是抄袭别人的言论、见解。见“拾人涕唾”。","source":{"text":"事事落人之后，拾人唾余。","book":"梁启超《论内地杂居与商务关系》"},"similar":["拾人唾涕","拾人涕唾"],"usage":"作谓语、宾语、定语；指抄袭别人言论"},{"id":21478,"word":"拾人唾涕","pinyin":"shí rén tuò tì","abbr":"srtt","explanation":"比喻自己没有创见，只是抄袭别人的言论、见解。同“拾人涕唾”。","source":{"text":"胡元瑞评诸家云：欧陈率是记事……刘贡父滑稽渠率；王直方拾人唾涕。","book":"明·胡震亨《唐音癸签·集录三》"},"similar":["拾人唾余","拾人涕唾"],"usage":"作谓语、宾语、定语；指抄袭别人言论"},{"id":21479,"word":"拾人涕唾","pinyin":"shí rén tì tuò","abbr":"srtt","explanation":"涕唾：鼻涕唾沫。比喻自己没有创见，只是抄袭别人的言论、见解。","source":{"text":"是自家闭门凿破此片田地，即非傍人篱壁拾人涕唾得来者。","book":"宋·严羽《沧浪诗话·答吴景先书》"},"similar":["拾人牙慧","拾人唾涕","拾人唾余"],"opposite":["独到见解"],"usage":"作谓语、宾语、定语；指抄袭别人言论"},{"id":21480,"word":"拾人牙后","pinyin":"shí rén yá hòu","abbr":"sryh","explanation":"拾：捡取；牙后：指别人说过的话。比喻拾取别人的一言半语当作自己的话。","source":{"text":"殷中军云：‘康伯未得我牙后慧。’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"若仅以新为嫌，是必～，人云亦云，否则抱柱守枝，不敢逾限一步，是尚得成家哉？","book":"清·赵翼《瓯北诗钞》卷四"}},{"id":21481,"word":"拾人牙慧","pinyin":"shí rén yá huì","abbr":"sryh","explanation":"拾：捡取；牙慧：指别人说过的话。比喻拾取别人的一言半语当作自己的话。","source":{"text":"殷中军云：‘康伯未得我牙后慧。’","book":"南朝宋·刘义庆《世说新语·文学》"},"example":{"text":"写文章要有自己的见解，表达自己的真情实感，切不可～。"},"similar":["拾人涕唾","人云亦云"],"opposite":["标新立异","独辟蹊径"],"usage":"作谓语、宾语；指抄袭别人言论","story":["晋康帝时建武将军殷浩以恢复中原为己任，他率军北伐攻打后秦姚襄失败而归，被流放到信安，他的外甥韩康伯一直跟随他，他每天教外甥用兵之道。韩康伯自以为学到了精华，经常对外夸夸其谈，殷浩说：“康伯连我的牙慧都没有捡到。”"]},{"id":21482,"word":"拾带重还","pinyin":"shí dài zhòng huán","abbr":"sdzh","explanation":"比喻拾到财物，物归原主，不占为己有。","source":{"text":"相传唐宰相裴度少时游香山寺，拾得某妇人所遗下的三条宝带，这是她借来为父亲脱罪的，裴度守候着还了她。见宋·丁用晦《芝田录·裴度》。"},"similar":["物归原主"],"usage":"作宾语、定语；用于处事","story":["传说唐朝时期，宰相裴度年少时游览香山寺，捡到一个妇人遗失的三条宝带，尽管他很喜欢，但是他不据为己有，而是在原地等待失主的到来，原来是这个妇人借来为她父亲脱罪用的。裴度毫不犹豫地还给他"]},{"id":21483,"word":"拾掇无遗","pinyin":"shí duō wú yí","abbr":"sdwy","explanation":"拾取得干干净净，没有一点遗留。拾掇：采检，拾取。"},{"id":21484,"word":"拾翠踏青","pinyin":"shí cuì tà qīng","abbr":"sctq","explanation":"指春游。","source":{"text":"所画多作仕女乘车跨马、拾翠踏青之状。","book":"宋·邓椿《画继》卷十"}},{"id":21485,"word":"拾遗求利","pinyin":"shí yí qiú lì","abbr":"syql","explanation":"遗：遗失。拾到别人遗失的东西，据为己有，以满足私利。","source":{"text":"志士不饮盗泉之水，廉者不受嗟来之食，况拾遗求利以污其行乎？","book":"《后汉书·烈女传》"}},{"id":21486,"word":"拾遗补阙","pinyin":"shí yí bǔ quē","abbr":"sybq","explanation":"遗：遗漏；阙：过失。补充旁人所遗漏的事物。","source":{"text":"次之又不能拾遗补阙，招贤进能。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"臣闻古之为臣者，进思尽忠，退思补过，献可替否，～。","book":"《晋书·江统传》"},"similar":["补阙拾遗"],"usage":"作谓语、宾语；指补充别人所遗漏的事物"},{"id":21487,"word":"拾金不昧","pinyin":"shí jīn bù mèi","abbr":"sjbm","explanation":"金：原指钱财，现泛指各种贵重物品；昧：隐藏。拾到东西并不隐瞒下来据为己有。指良好的仆人道德和社会风尚。","source":{"text":"把家人名分扯倒，又表其拾金不昧。","book":"清·吴炽昌《客窗闲话·义丐》：“乃呼里长，为之谋宅于市廛，置货立业且表之以额曰‘拾金不昧’。”清·《歧路灯》第一百八回"},"example":{"text":"我们每个人都应从小养成～的好品德。"},"similar":["路不拾遗"],"opposite":["贪得无厌","财迷心窍"],"usage":"作谓语、定语；指不贪财"},{"id":21488,"word":"拾陈蹈故","pinyin":"shí chén dǎo gù","abbr":"scdg","explanation":"因袭陈词滥调。","source":{"text":"观其妙趣天得，自成一家，不肯拾陈蹈故。","book":"元·刘壎《隐居通议·诗歌三》"},"similar":["因循守旧"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21489,"word":"拾零打短","pinyin":"shí líng dǎ duǎn","abbr":"sldd","explanation":"做零活，打短工。"},{"id":21490,"word":"拿一手","pinyin":"ná yī shǒu","abbr":"nys","explanation":"摆架子，找借口要挟别人。","example":{"text":"请不要在关键时刻～。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":21491,"word":"拿三搬四","pinyin":"ná sān bān sì","abbr":"nsbs","explanation":"比喻不服从调派。","source":{"text":"袭人笑道：‘倘或那件孔雀褂子襟再烧了窟窿，你去了，谁能以补呢？你倒别和我拿三搬四的。’","book":"清·曹雪芹《红楼梦》第六十二回"},"similar":["装模作样"],"usage":"作谓语；指故意刁难"},{"id":21492,"word":"拿三撇四","pinyin":"ná sān piē sì","abbr":"nsps","explanation":"装模作样。","example":{"text":"你不要跟我～的，我要看你的实际行动。"},"similar":["装模作样","拿班作势"],"usage":"作谓语、定语；指摆架子"},{"id":21493,"word":"拿下马来","pinyin":"ná xià mǎ lái","abbr":"nxml","explanation":"比喻将人制服。","source":{"text":"叫我问谁去？谁不帮着你呢？谁不是袭人拿下马来的？","book":"清·曹雪芹《红楼梦》第二十回"},"example":{"text":"说罢，先将庞昱～，差役掏出锁来锁上。","book":"清·石玉昆《三侠五义》第十四回"},"usage":"作谓语；用于口语"},{"id":21494,"word":"拿不出手","pinyin":"ná bù chū shǒu","abbr":"nbcs","explanation":"由于不像样、不中看或经不起挑剔而不好意思亮出来。","example":{"text":"这点小礼物真是～。"},"usage":"作谓语、定语；用于口语"},{"id":21495,"word":"拿云捉月","pinyin":"ná yún zhuō yuè","abbr":"nyzy","explanation":"形容才能本领非常高。","source":{"text":"到了今日，方知甥女有此拿云捉月之才能。","book":"《西湖佳话·西泠韵迹》"},"similar":["拿云握雾"],"usage":"作定语、宾语；指为人处世"},{"id":21496,"word":"拿云握雾","pinyin":"ná yún wò wù","abbr":"nyww","explanation":"比喻待人处世会耍手段。","source":{"text":"他有投明弃暗的心，拿云握雾的手。","book":"元·关汉卿《单鞭夺槊》第二折"},"example":{"text":"有包含天地之才，～之手。","book":"明·无名氏《广成子》第一折"},"similar":["拿云捉月"],"usage":"作定语、宾语；指为人处世"},{"id":21497,"word":"拿云攫石","pinyin":"ná yún jué shí","abbr":"nyjs","explanation":"攫：取。形容古树高耸入云，枝干悬空，姿态奇特，气势雄伟。","source":{"text":"厅前多古树，有拿云攫石之势。","book":"清·李斗《扬州画舫录·草河录》下"},"usage":"作定语；用于树木等"},{"id":21498,"word":"拿刀动杖","pinyin":"ná dāo nòng zhàng","abbr":"nddz","explanation":"挥舞刀枪棍棒。泛指动武。","source":{"text":"宝玉一发拿刀弄杖、寻死觅活的，闹的天翻地覆。","book":"清·曹雪芹《红楼梦》第二十五回"},"example":{"text":"今昔的情形不同，不怕她远走高飞，～。","book":"清·文康《儿女英雄传》第二十六回"},"similar":["拿刀弄杖","大动干戈"],"usage":"作谓语、定语；指动武"},{"id":21499,"word":"拿刀弄杖","pinyin":"ná dāo nòng zhàng","abbr":"ndnz","explanation":"挥舞刀枪棍棒。泛指动武。","source":{"text":"宝玉一发拿刀弄杖、寻死觅活的，闹的天翻地覆。","book":"清·曹雪芹《红楼梦》第二十五回"},"example":{"text":"今昔的情形不同，不怕她远走高飞，～。","book":"清·文康《儿女英雄传》第二十六回"},"similar":["拿刀动杖"],"usage":"作谓语、定语；指动武"},{"id":21500,"word":"拿印把儿","pinyin":"ná yìn bà ér","abbr":"nybe","explanation":"指做官掌有实权。","example":{"text":"他有一个～的老爹，工作不成问题。"}},{"id":21501,"word":"拿印把子","pinyin":"ná yìn bà zǐ","abbr":"nybz","explanation":"指做官掌有实权。","source":{"text":"你虽然候补了多年，如今却是第一回拿印把子。","book":"清·李宝嘉《官场现形记》第40回"},"example":{"text":"他有一个～的老爹，工作不成问题。"},"similar":["拿印把儿"],"usage":"作谓语、定语；用于口语"},{"id":21502,"word":"拿奸拿双","pinyin":"ná jiān ná shuāng","abbr":"njns","explanation":"奸：通奸。捉拿通奸要有成双的人证。","source":{"text":"拿奸拿双，拿不住双，反咬一口，就受不得了。","book":"清·刘鹗《老残游记》第19回"},"similar":["拿贼见赃"],"usage":"作宾语、定语；用于做事要有人证"},{"id":21503,"word":"拿定主意","pinyin":"ná dìng zhǔ yì","abbr":"ndzy","explanation":"下定决心，抉择做什么事。","source":{"text":"却又一片深心，打了个呼牛也可，呼马也可的主意，任是谁说什么，我只拿定主意，干我的大事去。","book":"清·文康《儿女英雄传》第17回"},"example":{"text":"清·刘鹗《老残游记续集遗稿》第一回：“我们今日竟～，不下山罢。”"},"similar":["打定主意"],"usage":"作谓语、定语；指决定"},{"id":21504,"word":"拿手好戏","pinyin":"ná shǒu hǎo xì","abbr":"nshx","explanation":"原指演员擅长的剧目。泛指最擅长的本领。","source":{"text":"制造空气是老赵的拿手好戏！他故意放出什么托拉斯的空气来，好叫人们起恐慌。","book":"茅盾《子夜》十七"},"example":{"text":"当过几十年老社首，捆人打人是他的～。","book":"赵树理《小二黑结婚》"},"similar":["精于此道","看家本领"],"opposite":["一无所长","一无所能"],"usage":"作主语、宾语；用于称赞人"},{"id":21505,"word":"拿班作势","pinyin":"ná bān zuò shì","abbr":"nbzs","explanation":"势：姿态。指摆架子，装模作样","source":{"text":"凤姐见他素日不大拿班作势的，便依允了。","book":"清·曹雪芹《红楼梦》第23回"},"example":{"text":"清·彭养鸥《黑籍冤魂》第八回：“晓得吴瑞庵烧了案卷，功名决计不保，所以～的，不肯一请就去。”"},"similar":["拿班做势","装模作样"],"opposite":["一本正经"],"usage":"作谓语、定语；指摆架子"},{"id":21506,"word":"拿班做势","pinyin":"ná bān zuò shì","abbr":"nbzs","explanation":"装模作样。","source":{"text":"凤姐见他素日不大拿班作势的，便依允了。","book":"清·曹雪芹《红楼梦》第23回"},"example":{"text":"晓得吴瑞庵烧了案卷，功名决计不保，所以～的，不肯一请就去。","book":"清·彭养鸥《黑籍冤魂》第八回"},"similar":["装模作样","拿腔作势"],"usage":"作谓语、宾语；指摆架子"},{"id":21507,"word":"拿着鸡毛当令箭","pinyin":"ná zhe jī máo dāng lìng jiàn","abbr":"nzjmdlj","explanation":"令箭：古代军队中发布命令时用作作证的箭状物。比喻把别人随便说的话当作重要依据。","source":{"text":"谁让你这样安排的？～，你好大的胆子！ ★李佩甫《羊的门》第十二章"}},{"id":21508,"word":"拿粗夹细","pinyin":"ná cū jiā xì","abbr":"ncjx","explanation":"比喻惹事生非。","source":{"text":"若有那拿粗夹细踏尾的但风闻，这东西一半儿停将一半儿分。","book":"元˙郑廷玉《后庭花》第一折"}},{"id":21509,"word":"拿粗挟细","pinyin":"ná cū xié xì","abbr":"ncxx","explanation":"拿：刁难；挟：挟制；粗细：指大小粗细之事。比喻寻事生非；挑剔冒犯。","source":{"text":"俺两个全仗俺父亲的虎威，拿粗挟细，揣歪捏怪，那一个不知我的名儿。","book":"元·无名氏《陈州粜米》楔子"},"similar":["惹事生非"],"usage":"作谓语、定语；指惹是生非"},{"id":21510,"word":"拿糖作醋","pinyin":"ná táng zuò cù","abbr":"ntzc","explanation":"摆架子，装腔作势。","source":{"text":"这会子替奶奶办了一点子事，况且关会着好几层儿呢，就这幺拿糖作醋的起来，也不怕人家寒心？","book":"清·曹雪芹《红楼梦》第101回"},"example":{"text":"我们也干了，也值得你那幺～的！","book":"清·文康《儿女英雄传》第37回"},"similar":["装腔作势","拿班做势"],"usage":"作谓语、定语；指摆架子"},{"id":21511,"word":"拿腔作势","pinyin":"ná qiāng zuò shì","abbr":"nqzs","explanation":"装模作样，装腔作势。","source":{"text":"那贾环便来到王夫人炕上坐着，令人点了蜡烛，拿腔做势的抄写。","book":"清·曹雪芹《红楼梦》第25回"},"example":{"text":"不免～，添了许多自抬身价的话。","book":"清·李宝嘉《官场现形记》第34回"},"similar":["装模作样","拿腔做势"],"usage":"作谓语、定语；指装模作样","story":["王夫人叫贾环抄《金刚咒》，贾环便来到王夫人炕上坐着，令人点了蜡烛，拿腔做势的抄写。丫鬟彩霞叫他安分抄写，贾环则咬定彩霞与宝玉好，对他不好。彩霞则骂他狗咬吕洞宾——不识好人心。这时宝玉、王熙凤进来，贾环只好偷偷地生闷气"]},{"id":21512,"word":"拿腔作样","pinyin":"ná qiāng zuò yàng","abbr":"nqzy","explanation":"拿腔拿调，故意做作想引人注意或吓唬人。","source":{"text":"教那厮越装模，越作势。","book":"元·无名氏《杀狗劝夫》第四折"},"example":{"text":"我不过说着玩儿，亏你就会～。（钱钟书《上帝的梦》五）"}},{"id":21513,"word":"拿腔作调","pinyin":"ná qiāng zuò diào","abbr":"nqzd","explanation":"故意装出特殊的腔调。","source":{"text":"冠先生拿腔作调的说：‘请太太不要发脾气！’说罢，戴起帽子，懒洋洋的走出去。","book":"老舍《四世同堂》"},"example":{"text":"别动不动就～。"},"similar":["装模作样"],"usage":"作宾语、状语；指装腔作势"},{"id":21514,"word":"拿腔做势","pinyin":"ná qiāng zuò shì","abbr":"nqzs","explanation":"腔：说话的腔调；势：姿态。装模作样，装腔作势","source":{"text":"但仙姑不过举口之劳，偏执意作难，一味花言巧语，这样拿腔做势，未免太过分了！","book":"清·李汝珍《镜花缘》第二回"},"example":{"text":"清·李宝嘉《官场现形记》第34回：“只当是抚台敷衍他的话，不免～，添了许多自抬身价的话。”"},"similar":["拿班作势","装模作样","装腔作势"],"usage":"作谓语、定语；指装模作样"},{"id":21515,"word":"拿腔做样","pinyin":"ná qiāng zuò yàng","abbr":"nqzy","explanation":"腔：说话的腔调。装模作样，装腔作势。","source":{"text":"这赵大娘，才三十四五年纪，拿腔做样，也都为了个妇人礼儿。","book":"清·李绿园《歧路灯》第11回"},"similar":["拿腔做势","装腔作势"],"usage":"作谓语、定语；指装模作样"},{"id":21516,"word":"拿贼拿赃","pinyin":"ná zéi ná zāng","abbr":"nznz","explanation":"捉贼要查到赃物做凭证。","source":{"text":"常言道：拿贼拿赃那怪物做了三年皇帝，又不曾走了马脚，漏了风声……我老孙就有本事拿住他，也不好定个罪名。","book":"明·吴承恩《西游记》第三十八回"},"similar":["拿贼见赃"],"usage":"作宾语、定语、分句；用于口语"},{"id":21517,"word":"拿贼拿赃，拿奸拿双","pinyin":"ná zéi ná zāng，ná jiān ná shuāng","abbr":"nznznjns","explanation":"赃：赃物；奸：通奸。捉贼要有赃证，捉奸要有成双人证。指问罪要有真凭实据。","source":{"text":"拿贼拿赃，拿奸拿双，你又不曾捉住他的孤老，你活活的打杀了媳妇，这是要偿命的。","book":"清·西周生《醒世姻缘传》第62回"},"similar":["拿贼要赃，拿奸要双"],"opposite":["故入人罪"],"usage":"作宾语、定语、分句；用于处事"},{"id":21518,"word":"拿贼要赃，拿奸要双","pinyin":"ná zéi yào zāng，ná jiān yào shuāng","abbr":"nzyznjys","explanation":"赃：赃物；奸：通奸。捉贼要有赃证，捉奸要有成双人证。指问罪要有真凭实据。","source":{"text":"那梁山泊果然有个李逵，原来孔目结交贼人？二嫂，你晓得拿贼要赃，拿奸要双，如今那匾金环子在谁人收着？","book":"元·马致远《还牢末》第一折"},"similar":["拿贼要赃，捉奸要双"],"opposite":["故入人罪"],"usage":"作宾语、定语、分句；用于处事"},{"id":21519,"word":"拿贼要赃，捉奸要双","pinyin":"ná zéi yào zāng，zhuō jiān yào shuāng","abbr":"nzyzzjys","explanation":"赃：赃物；奸：通奸。捉贼要有赃证，捉奸要有成双人证。指问罪要有真凭实据。","source":{"text":"俗语说得好，拿贼要赃，捉奸要双……今日他的老婆，为何不来？","book":"《斩鬼传》第11回"},"similar":["拿贼要赃，拿奸要双"],"opposite":["故入人罪"],"usage":"作宾语、定语、分句；用于处事"},{"id":21520,"word":"拿贼见赃","pinyin":"ná zéi jiàn zāng","abbr":"nzjz","explanation":"捉贼要查到赃物做凭证。","source":{"text":"谁是贼？老大人拿贼见赃，不曾捉奸见床来！","book":"明·无名氏《认金梳》第三折：“拿贼见赃，杀人验伤，我有何罪也？”明·汤显祖《牡丹亭》第五十三出"},"example":{"text":"柯爷喝一声：‘小贱人住口！你说～，为父的就还你一个实证。’","book":"清·佚名《听月楼》第六回"},"similar":["拿贼拿赃"],"usage":"作宾语、定语、分句；用于口语"},{"id":21521,"word":"拿风跃云","pinyin":"ná fēng yuè yún","abbr":"nfyy","explanation":"拿：握持。比喻气概雄杰俊伟。","source":{"text":"当时元夫志士，无不拿风跃云，吐阳嘘阴，致身于九霄之上。","book":"明·宋濂《凤阳陈方式赠二代碑铭》"},"usage":"作谓语、定语；用于人的气概"},{"id":21522,"word":"持久之计","pinyin":"chí jiǔ zhī jì","abbr":"cjzj","explanation":"持久：持之以久，即长久。长久的打算或谋略。","source":{"text":"上可以倾覆寇敌，尊奖王室，中可以蚕食雍、凉，广拓境土，下可以固守要害，为持久之计。","book":"《三国志·蜀志·法正传》"},"example":{"text":"君悬军深入，而置陈逼水，此乃～，非欲速战者也。","book":"《资治通鉴·晋孝武帝太元八年》"},"similar":["长久之计"],"usage":"作宾语；指长远的打算"},{"id":21523,"word":"持之以恒","pinyin":"chí zhī yǐ héng","abbr":"czyh","explanation":"持：坚持；恒：恒心。长久坚持下去。","source":{"text":"尔之短处，在言语欠钝讷，举止欠端重，看书不能深入，而作文不能峥嵘。若能从此三事上下一番苦功，进之以猛，持之以恒，不过一二年，自尔精进而不觉。","book":"清·曾国藩《家训喻纪泽》"},"example":{"text":"学习要锲而不舍，～，就能取得好成绩。"},"similar":["锲而不舍","孜孜不倦"],"opposite":["一暴十寒","半途而废"],"usage":"作谓语、状语；表示长久不变"},{"id":21524,"word":"持之有故","pinyin":"chí zhī yǒu gù","abbr":"czyg","explanation":"持：持论，主张；有故：有根据。指所持的见解和主张有一定的根据。","source":{"text":"然而其持之有故，其言之成理。","book":"《荀子·非十二子》"},"example":{"text":"他经过实地调查，提出这一看法，～，完全可信。"},"similar":["顺理成章","言之有理"],"opposite":["妄下雌黄","无稽之谈","不经之谈"],"usage":"作谓语；用于学问、文章等"},{"id":21525,"word":"持之有故，言之成理","pinyin":"chí zhī yǒu gù，yán zhī chéng lǐ","abbr":"czygyzcl","explanation":"持：持论，主张；有故：有根据。指所持的见解和主张有一定的根据和道理。","source":{"text":"然而其持之有故，其言之成理，足以欺惑愚众。","book":"《荀子·非十二子》"}},{"id":21526,"word":"持之有故，言之有理","pinyin":"chí zhī yǒu gù，yán zhī yǒu lǐ","abbr":"czygyzyl","explanation":"持：持论，立论；故：根据。立论有根据，讲话有道理。","source":{"text":"纵情性，安恣睢，禽兽之行，不足以合文通治，然而其持之有故，其言之成理，足以欺惑愚众。","book":"战国·赵·荀况《荀子·非十二子》"},"example":{"text":"今君复能实证古文，则真豁然确斯，～矣。","book":"章炳麟《与刘光汉书》"},"usage":"作谓语、宾语、定语；用于言论等"},{"id":21527,"word":"持人长短","pinyin":"chí rén cháng duǎn","abbr":"crcd","explanation":"指抓住他人的缺点过失作为把柄，加以攻击。","source":{"text":"第二十九戒，不得持人长短，更相嫌恨。","book":"《云笈七签》卷三九"},"example":{"text":"～是一病，假人自信是一病。","book":"《云笈七签》卷四十"},"similar":["抓小辫子"],"usage":"作谓语、宾语、定语；指抓小辫子"},{"id":21528,"word":"持刀动杖","pinyin":"chí dāo dòng zhàng","abbr":"cddz","explanation":"持：拿；杖：木棒。用以指动武。","source":{"text":"谁闹来着？你先持刀动杖的闹起来，倒说别人闹。","book":"清·曹雪芹《红楼梦》第34回"},"example":{"text":"大家都不要～的，有话好好说。"},"similar":["持刀执棍"],"usage":"作谓语、宾语、状语；指打架"},{"id":21529,"word":"持刀弄棒","pinyin":"chí dāo nòng bàng","abbr":"cdnb","explanation":"形容喜爱习武。","source":{"text":"小女自幼亦喜持刀弄棒。","book":"清·夏敬渠《野叟曝言》第八十八回"},"similar":["舞枪使棒"],"usage":"作谓语、宾语；指习武"},{"id":21530,"word":"持刀执棍","pinyin":"chí dāo zhí gùn","abbr":"cdzg","explanation":"拿着刀枪棍棒准备打架。","source":{"text":"便有许多王孙公子要求娶他，又有些媒婆扯扯拽拽扶他上车，自己不肯去。一回儿又有盗贼劫他，持刀执棍的逼勒。","book":"清·曹雪芹《红楼梦》第87回"},"similar":["持刀动杖"],"usage":"作谓语、状语；用于动武","story":["妙玉自从与宝玉听了黛玉那凄凉的琴声后，恍恍忽忽地回到庵内，念完“禅门日诵”就在禅床上打坐。就是神不守舍，老是想起宝玉的话，心跳耳热。迷迷糊糊地睡着了，在梦中好像有许多王孙公子要娶她，甚至有强盗持刀执棍威逼她，大病一场"]},{"id":21531,"word":"持危扶颠","pinyin":"chí wēi fú diān","abbr":"cwfd","explanation":"扶持危困的局面。","source":{"text":"危而不持，颠而不扶。","book":"春秋·鲁·孔丘《论语·季氏》"},"example":{"text":"～，允迪栋隆之吉；力小任重，免贻鼎折之凶。","book":"宋·李纲《辞免尚书右仆射第一表》"},"similar":["力挽狂澜"],"usage":"作谓语、定语；指扶持危殆局面"},{"id":21532,"word":"持平之论","pinyin":"chí píng zhī lùn","abbr":"cpzl","explanation":"持平：主持公道，没有偏向。指公正的意见。也指折中、调和的话。","source":{"text":"延年论议持平。","book":"《汉书·杜延年传》"},"example":{"text":"此乃做书人～；若是一概抹杀，便不成为恕道了。","book":"清·李宝嘉《官场现形记》第三十四回"},"similar":["不偏不倚","公正无私"],"opposite":["偏听偏信","一孔之见"],"usage":"作宾语；形容调和折中的言论"},{"id":21533,"word":"持戈试马","pinyin":"chí gē shì mǎ","abbr":"cgsm","explanation":"比喻作好准备，跃跃欲试。","source":{"text":"《红楼梦》第七九回：“那金桂见丈夫旗纛渐倒，婆婆良善，也就渐渐的持戈试马。“"},"usage":"作谓语、宾语；用于准备动武"},{"id":21534,"word":"持斋把素","pinyin":"chí zhāi bǎ sù","abbr":"czbs","explanation":"把：遵守。斋：斋戒。谓信佛者遵守吃素，坚持戒律。","source":{"text":"念佛心把素持斋，不食荤啖柏。","book":"元·无名氏《女姑姑》第三折"},"example":{"text":"俺也曾看经念佛，俺也曾～。","book":"明·无名氏《锁白猿》第三折"},"similar":["把素持斋"],"usage":"作谓语、定语；指遵守吃素的习惯和坚持戒律"},{"id":21535,"word":"持权合变","pinyin":"chí quán hé biàn","abbr":"cqhb","explanation":"以权宜之计适应已经变化的局面。","source":{"text":"阁下前任剧邑，治悍民，不尚黄老；今官督粮道，乃尚黄老，此持权合变才也。","book":"清·梅曾亮《答朱丹木书》"},"usage":"作宾语、定语；用于书面语"},{"id":21536,"word":"持枪实弹","pinyin":"chí qiāng shí dàn","abbr":"cqsd","explanation":"持：握。手握钢枪，子弹上膛。形容全副武装，准备战斗。","source":{"text":"我们的门口……以及后门，都有好几位持枪实弹的武装同志防守着。","book":"邹韬奋《抗战以后·笔杆暴动》"},"similar":["荷枪实弹"],"usage":"作谓语、定语；用于军人等"},{"id":21537,"word":"持枪鹄立","pinyin":"chí qiāng hú lì","abbr":"cqgl","explanation":"鹄立：像天鹅一样延颈而立。手持长枪，整齐地肃立着，形容军容严整。","source":{"text":"近别墅及别墅内武装保卫森严，持枪鹄立。","book":"邹韬奋《患难余生记》第一章"},"usage":"作谓语；用于军人"},{"id":21538,"word":"持梁齿肥","pinyin":"chí liáng chǐ féi","abbr":"clcf","explanation":"梁：指米饭；齿：咬，吃。食用精米、肥肉。形容享受美食佳肴。","source":{"text":"吾持梁剌齿肥，跃马疾驱，怀黄金之印……四十三年足矣。","book":"《史记·祭泽列传》"}},{"id":21539,"word":"持橐簪笔","pinyin":"chí tuó zān bǐ","abbr":"ctzb","explanation":"橐，口袋；簪，插。指侍从之臣携带书和笔，以备顾问。","source":{"text":"持橐簪笔，事孝武皇帝数十年。","book":"《汉书·赵充国传》"},"usage":"作谓语、宾语；多用于秘书等"},{"id":21540,"word":"持正不挠","pinyin":"chí zhèng bù náo","abbr":"czbn","explanation":"坚持正道，决不屈服。","source":{"text":"冕当正德之季，主昏政乱，持正不挠，有匡弼功。","book":"《明史·蒋冕传》"},"usage":"作谓语、定语；用于为人"},{"id":21541,"word":"持正不阿","pinyin":"chí zhèng bù ē","abbr":"czba","explanation":"持守公正正派，不迎合阿谀。","source":{"text":"平居议论臧贬，务持正不阿；与人交，不以盛衰为轩轾。","book":"明·范濂《云间据目抄》卷一"},"example":{"text":"即事君亦当～，勿蹈唯诺之习。","book":"清·冯桂芬《诰封·行述》"},"similar":["刚正不阿"],"opposite":["阿谀奉承"],"usage":"作谓语、定语；指刚强正直，不逢迎"},{"id":21542,"word":"持满戒盈","pinyin":"chí mǎn jiè yíng","abbr":"cmjy","explanation":"端盛满之水而留心不外溢。比喻居高位而能警戒自己不骄傲自满。","source":{"text":"持满如不盈，有德者能卒。","book":"三国·魏·曹操《善哉行》之三"},"example":{"text":"蕃辅贵盛，地实高危，～，鲜能全德。","book":"《南齐书·豫章文献王传论》"},"usage":"作谓语、定语；用于为人"},{"id":21543,"word":"持疑不决","pinyin":"chí yí bù jué","abbr":"cybj","explanation":"收存疑虑，不能决定。","source":{"text":"善密谓崇礼曰：‘高氏戎车犯顺，致令主上播越……不如早归诚款，虽未足以表奇节，庶获全首领。’而崇礼犹持疑不决。","book":"《周书·范善传》"},"example":{"text":"众人持疑不定，六郎亦闷闷不乐。","book":"明·无名氏《杨家将演义》第十四回"},"similar":["持疑不定"],"usage":"作谓语、状语；用于处事"},{"id":21544,"word":"持疑不定","pinyin":"chí yí bù dìng","abbr":"cybd","explanation":"疑：疑虑。心怀疑虑，迟迟不能决定。","source":{"text":"众人持疑不定，六郎亦闷闷不乐。","book":"《杨家将演义》第14回"},"similar":["持疑不决"],"opposite":["当机立断","斩钉截铁"],"usage":"作谓语、状语；用于处事"},{"id":21545,"word":"持盈保泰","pinyin":"chí yíng bǎo tài","abbr":"cybt","explanation":"盈：盛满；泰：平安。旧指在富贵极盛的时候要小心谨慎，避免灾祸，以保持住原来的地位。","source":{"text":"太平之君子，能持盈守成。","book":"《诗经·大雅·凫鷖》小序"},"example":{"text":"同时也怕是他自己的官阶已经达到了使他要～的时候。","book":"郭沫若《少年时代·我的童年》"},"similar":["持盈守成"],"usage":"作谓语、定语；指身居高位要谦虚谨慎"},{"id":21546,"word":"持盈守成","pinyin":"chí yíng shǒu chéng","abbr":"cysc","explanation":"保持已成的盛业。","source":{"text":"臣历观前世，持盈守成，艰于创业之君。","book":"宋·苏辙《序》"},"example":{"text":"愿陛下～，慎终如始。","book":"《宋史·苏易简传》"},"similar":["持盈保泰"],"usage":"作谓语；用于处事"},{"id":21547,"word":"持盈守虚","pinyin":"chí yíng shǒu xū","abbr":"cysx","explanation":"盈：满；虚：不自满。指在富贵极盛之时，不敢骄纵自满。","source":{"text":"勋业既崇，持盈守虚，功成即退，挹而损诸。","book":"汉·杜笃《大司马吴汉诔》"},"usage":"作谓语、定语；用于书面语"},{"id":21548,"word":"持禄保位","pinyin":"chí lù bǎo wèi","abbr":"clbw","explanation":"禄：旧时官吏的薪俸。为了保持俸禄官位，大臣阿谀奉承，不敢直言进谏。也指大臣有过失不肯引咎辞职。","source":{"text":"光、禹之罪深于莽、卓……持禄保位，被阿谀之机。","book":"宋·王楙《野客丛书·班范议论》"},"example":{"text":"夫朝廷有纪纲，大臣重进退，宏、璁、萼缘不可不去，宏不去，则有～之诮。","book":"《明史·解一贯传》"},"usage":"作谓语、宾语；用于官场"},{"id":21549,"word":"持禄养交","pinyin":"chí lù yǎng jiāo","abbr":"clyj","explanation":"持禄：保持禄位；养交：交结权贵。指结交权贵以保持自己的职位。","source":{"text":"小臣持禄养交，不以官为事，故官失其能。","book":"《管子·明法》"},"example":{"text":"～，倒行逆施，此明季未黜而今日不可不黜者也。","book":"《清史稿·魏琯传》"},"usage":"作谓语、定语；指巴结权贵以自保"},{"id":21550,"word":"持禄养身","pinyin":"chí lù yǎng shēn","abbr":"clys","explanation":"保住禄位以养自身。指大臣庸禄无为。","source":{"text":"部院臣工大率缄默瞻顾，外托老成慎重之名，内怀持禄养身之念。","book":"《清史稿·熊赐履传》"},"similar":["尸位素餐"],"usage":"作谓语、定语；用于官场"},{"id":21551,"word":"持禄取容","pinyin":"chí lù qǔ róng","abbr":"clqr","explanation":"持：拿；禄：薪俸；取容：取悦。指为保住职位而去取悦别人。","source":{"text":"其大臣如张禹、孔光辈皆持禄取容，偷为一切之计。","book":"宋·秦观《李固论》"},"usage":"作谓语、宾语；用于官场"},{"id":21552,"word":"持禄取荣","pinyin":"chí lù qǔ róng","abbr":"clqr","explanation":"取荣：取悦。保持禄位，取悦于人。指庸庸禄禄，无所作为。","source":{"text":"其大臣如张禹，孔光辈皆持禄取荣，偷为一切之计。","book":"宋·秦观《李固论》"}},{"id":21553,"word":"持禄固宠","pinyin":"chí lù gù chǒng","abbr":"clgc","explanation":"保持官职和俸禄，共同巩固宠信。指大臣不行正道。","source":{"text":"世称太学聚天下士，既知道理，又无持禄固宠之累，故其品藻人物，皆合公议。","book":"宋·胡仔《苕溪渔隐丛话后集·本朝杂记上》"},"usage":"作谓语、定语；用于官场"},{"id":21554,"word":"持筹握算","pinyin":"chí chóu wò suàn","abbr":"ccws","explanation":"原指筹划，后称管理财务。","source":{"text":"孔老览观，孟子持筹而算之，万不失一。","book":"汉·枚乘《七发》"},"example":{"text":"妇～，日致丰盈。","book":"清·蒲松龄《聊斋志异·云萝公主》"},"similar":["精打细算"],"usage":"作谓语、定语；指精打细算"},{"id":21555,"word":"持管窥天","pinyin":"chí guǎn kuī tiān","abbr":"cgkt","explanation":"管：竹管；窥：从小孔或缝隙里看。通过竹管子的孔看天。比喻见闻狭隘或看事片面。","source":{"text":"是直用管窥天，用锥指地也，不亦小乎？","book":"《庄子·秋水》"}},{"id":21556,"word":"持螯把酒","pinyin":"chí áo bǎ jiǔ","abbr":"cabj","explanation":"形容秋季吃蟹饮酒之乐。","source":{"text":"南朝·宋·刘义庆《世说新语·任诞》载：晋代嗜酒的毕卓曾说：一手拿着蟹螯，一手捧着酒杯，便足以了一生。"},"similar":["把酒持螯","持螯把盏"],"usage":"作宾语、定语；指饮酒作乐"},{"id":21557,"word":"持蠡测海","pinyin":"chí lí cè hǎi","abbr":"clch","explanation":"蠡：瓠瓢，古代舀水用具。指用瓢来测量海水的深浅多少。比喻用浅薄的眼光去看待高深的事物。","source":{"text":"以管窥天，以蠡测海。","book":"《汉书·东方朔传》"},"example":{"text":"谬～，沉挹酒如渑。","book":"唐·杜甫《赠特进汝阳王二十韵》"},"similar":["以蠡测海"],"usage":"作宾语、定语；指方法不对头"},{"id":21558,"word":"持衡拥璇","pinyin":"chí héng yōng xuán","abbr":"chyx","explanation":"比喻掌握国家政权。","source":{"text":"昔放勋驭世，流璧属子；重华握历，持衡拥璇。","book":"《北齐书·文宣帝纪》"},"usage":"作谓语、定语；比喻掌权"},{"id":21559,"word":"持表度天","pinyin":"chǐ biǎo dù tiān","abbr":"cbdt","explanation":"表：立柱，测日影长短；度：量。用很短的表来测量天。比喻学识浅薄不能深明事理。","source":{"text":"子立尺表以度天，直寸指以测渊，蒙大道而不悟，信诬说以为圣，殆非所望也。","book":"秦·孔鲋《孔丛子·答问》"}},{"id":21560,"word":"持论公允","pinyin":"chí lùn gōng yǔn","abbr":"clgy","explanation":"立论公正，不偏袒。","source":{"text":"仲舒通五经，能持论，善属文。","book":"东汉·班固《汉书·儒林传》"},"example":{"text":"某报创刊以来，一向～，所以人人爱读它。"},"usage":"作谓语、定语；用于写作或说话等"},{"id":21561,"word":"持重待机","pinyin":"chí zhòng dài jī","abbr":"czdj","explanation":"持重：小心谨慎。形容谨慎地等待时机。","source":{"text":"时朝廷以亮侨军远寇，利在急战，每命帝持重待机以候其变。","book":"《晋书·宣帝纪》"},"example":{"text":"否则宁可退让，～。","book":"毛泽东《中国革命战争的战略问题》"},"usage":"作谓语、定语；用于处事等"},{"id":21562,"word":"持鳌下酒","pinyin":"chí áo xià jiǔ","abbr":"caxj","explanation":"旧指文人嗜蟹嗜酒，逃避现实。","source":{"text":"一手持蟹鳌，一手持酒杯，拍浮酒池中，便足了一生。","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":21563,"word":"持鳌封菊","pinyin":"chí áo fēng jú","abbr":"cafj","explanation":"形容吃蟹看菊的情趣。","source":{"text":"得酒满数百斛，四时甘味置两头，右手持酒杯，左手持蟹鳌，拍浮酒池中，便足了一生。","book":"《晋书·华卓传》"}},{"id":21564,"word":"挂一漏万","pinyin":"guà yī lòu wàn","abbr":"gylw","explanation":"挂：钩取，这里指说到，提到；漏：遗漏。形容说得不全，遗漏很多。","source":{"text":"团辞试提挈，挂一念万漏。","book":"唐·韩愈《南山》诗"},"example":{"text":"相望二千里外，明月此心，恳恳侧厘，～。","book":"宋·文天祥《与游提刑汶》"},"similar":["涓滴不露"],"usage":"作谓语；作谦辞"},{"id":21565,"word":"挂冠归去","pinyin":"guà guān guī qù","abbr":"gggq","explanation":"冠：帽子，这里指官帽。把官帽取下挂起来。比喻辞官回家。","source":{"text":"时王莽杀其子宇，萌谓友人曰：‘三纲绝矣！不去，祸将及人。即解冠挂工都城门归，将家属浮海，客于辽东。","book":"《后汉书·逢萌传》"},"example":{"text":"气得彭教谕拂衣而去，遂～。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"similar":["辞官归隐","挂冠而归"],"opposite":["东山再起"],"usage":"作谓语；比喻辞官回家","story":["西汉末年，王莽的儿子王宇担心王莽树敌太多而进行血谏，被王莽大义灭亲而杀掉，逢萌看出了王莽的用意，认为这样的君王不值得忠贞，于是摘下头上的乌纱帽挂在都城东门外，悄悄地离开京城，携家逃到辽东，后来不久，王莽自杀新朝灭亡"]},{"id":21566,"word":"挂冠归隐","pinyin":"guà guān guī yǐn","abbr":"gggy","explanation":"冠：帽子，官帽。把官帽取下挂起来。比喻辞官归隐。","source":{"text":"有的咬了一口松皮饼，极口叹赏它的清香，说自己明天就要挂冠归隐，去享这样的清福。","book":"鲁迅《理水》"},"similar":["挂冠归去","挂冠而归"],"usage":"作谓语；比喻辞官回家"},{"id":21567,"word":"挂冠求去","pinyin":"guà guān qiú qù","abbr":"ggqq","explanation":"挂冠：把官帽挂起来。脱下官帽要求离去。比喻辞官归隐。","source":{"text":"时王莽杀其子宇，萌谓友人曰：‘三纲绝矣！不去，祸将及人。即解冠挂工都城门归，将家属浮海，客于辽东。","book":"《后汉书·逢萌传》"},"similar":["挂冠而归","挂冠归去"],"usage":"作谓语；指弃官","story":["西汉末年，王莽的儿子王宇担心王莽树敌太多而进行血谏，被王莽大义灭亲而杀掉，逢萌看出了王莽的用意，认为这样的君王不值得忠贞，于是摘下头上的乌纱帽挂在都城东门外，悄悄地离开京城，携家逃到辽东，后来不久，王莽自杀新朝灭亡"]},{"id":21568,"word":"挂冠神武","pinyin":"guà guān shén wán","abbr":"ggsw","explanation":"指辞官隐居。","source":{"text":"家贫，求宰县不遂。永明十年，脱朝服挂神武门，上表辞禄。","book":"《南史·隐逸传下·陶弘景》"},"example":{"text":"要～，几番说了，这回真个。","book":"宋·刘克庄《解连环》词"}},{"id":21569,"word":"挂冠而去","pinyin":"guà guān ér qù","abbr":"ggeq","explanation":"冠：官帽。指辞去官职。","source":{"text":"时王莽杀其子宇，萌谓友人曰：‘三纲绝矣！不去，祸将及人。’即解冠挂东都城门，归，将家属浮海，客于辽东。","book":"南朝·宋·范晔《后汉书·逢萌传》"},"example":{"text":"他不愿在官场与他们同流合污，于是～。"},"similar":["辞官归隐"],"opposite":["东山再起"],"usage":"作谓语；指弃官","story":["西汉末年，王莽的儿子王宇担心王莽树敌太多而进行血谏，被王莽大义灭亲而杀掉，逢萌看出了王莽的用意，认为这样的君王不值得忠贞，于是摘下头上的乌纱帽挂在都城东门外，悄悄地离开京城，携家逃到辽东，后来不久，王莽自杀新朝灭亡"]},{"id":21570,"word":"挂冠而归","pinyin":"guà guān ér guī","abbr":"ggeg","explanation":"挂冠：把官帽挂起来。脱下官帽随即离去。比喻辞官归隐。","source":{"text":"嗣因谗奸当道，朝政日非，老夫……随即挂冠而归。","book":"清·李汝珍《镜花缘》第15回"},"example":{"text":"清·李汝珍《镜花缘》第15回：“嗣因谗奸当道，朝政日非，老夫勤王无计，耻食周禄，随即～。”"},"similar":["挂冠归去"],"opposite":["东山再起"],"usage":"作谓语；比喻辞官归隐","story":["西汉末年，王莽的儿子王宇担心王莽树敌太多而进行血谏，被王莽大义灭亲而杀掉，逢萌看出了王莽的用意，认为这样的君王不值得忠贞，于是摘下头上的乌纱帽挂在都城东门外，悄悄地离开京城，携家逃到辽东，后来不久，王莽自杀新朝灭亡"]},{"id":21571,"word":"挂印悬牌","pinyin":"guà yìn xuán pái","abbr":"gyxp","explanation":"悬：挂。高挂官印、告牌（旧时官府用以喻示下级或百姓的告示牌）。指担任官职。","source":{"text":"那其间日转千阶，喜笑迎腮，挂印悬牌。","book":"元·关汉卿《裴度还带》"},"usage":"作谓语；指担任官职"},{"id":21572,"word":"挂席为门","pinyin":"guà xí wéi mén","abbr":"gxwm","explanation":"指隐士居处。亦形容贫穷或居处简陋。","source":{"text":"《史记·陈丞相世家》载：汉初丞相陈平，好读书，在未发迹时，家里很穷，挂着破席子当门。"},"example":{"text":"诛茅作室，～。","book":"唐·杨炯《寻杨陷居诗》序"},"usage":"作谓语、宾语、定语；用于贫寒的生活","story":["秦末汉初，陈平家境非常贫寒，挂着破席子当门，在张负的资助下从师学习，他先后投奔魏王咎、项羽及刘邦。刘邦认为他是个人才，就封他为曲逆侯及丞相，他先后6次用计使刘邦转危为安，为汉王朝的稳定和巩固作出巨大的贡献"]},{"id":21573,"word":"挂灯结彩","pinyin":"guà dēng jié cǎi","abbr":"gdjc","explanation":"悬挂红灯，系结彩绸。表示喜庆。","source":{"text":"到了那日，鼓乐喧天，挂灯结彩，说不尽那绵绣荣华，一段富贵。","book":"《荡寇志》第一一六回"},"example":{"text":"太平寨里的土豪、劣坤、地主、有钱人，那天晚上正在用农民租谷换来的钱，～，喝唒唱戏。","book":"应修人《旗子的故事》"},"similar":["张灯结彩"],"usage":"作谓语、状语；指喜庆气氛"},{"id":21574,"word":"挂羊头卖狗肉","pinyin":"guà yáng tóu mài gǒu ròu","abbr":"gytmgr","explanation":"比喻以好的名义做幌子，实际上名不副实或做坏事。","source":{"text":"悬羊头，卖狗肉，知它有甚凭据。","book":"宋·释惟白《续传灯录》第31卷"},"example":{"text":"我们的组织决不能叫一些～的反动分子、投机分子所欺骗。","book":"杨沫《青春之歌》第二部第28章"},"similar":["悬羊头，卖狗肉","名不副实"],"opposite":["名副其实"],"usage":"作谓语、补语；指名不副实","story":["春秋时期，齐灵公看见嫔妃穿得花花绿绿不顺眼，就命她们改穿男装。齐灵公看不顺眼，就让官吏禁止宫外女人穿男装，但屡禁不绝。晏子说宫内女子穿男装好比店外挂着牛头，店里卖马肉一样，难以让人信服"]},{"id":21575,"word":"挂羊头，卖狗肉","pinyin":"guà yáng tóu，mài gǒu ròu","abbr":"gytmgr","explanation":"挂着羊头，卖的却是狗肉。比喻以好的名义做招牌，实际上兜售低劣的货色。","source":{"text":"悬羊头，卖狗肉，坏后进，初几灭。","book":"《晏子春秋·内篇杂下》：“君使服之于内，而禁之于外，犹悬牛首于门而卖马脯于内也。”宋·释普济《五灯会元》卷十六"},"example":{"text":"中国现在的顽固派，正是这样。他们口里的宪政，不过是“～”。","book":"毛泽东《新民主主义的宪政》"}},{"id":21576,"word":"挂肚牵心","pinyin":"guà dù qiān xīn","abbr":"gdqx","explanation":"牵：牵挂。形容忧虑不安的心情。","source":{"text":"从今，再不去梦里搜寻，再不去愁中加病，再不去挂肚牵心。","book":"元·王元鼎《雁传书》"},"similar":["挂肚牵肠"],"usage":"作谓语、定语；用于处事"},{"id":21577,"word":"挂肚牵肠","pinyin":"guà dù qiān cháng","abbr":"gdqc","explanation":"极言牵挂，挂念。","source":{"text":"从别后……心儿里挂肚牵肠，废寝忘食。","book":"《白雪遗音·岭儿调·从别后》"},"example":{"text":"清·西周生《醒世姻缘传》第52回：“怎怪他不～。”"},"similar":["挂肚牵心","牵肠挂肚"],"usage":"作谓语、定语；用于处事"},{"id":21578,"word":"挂肠悬胆","pinyin":"guà cháng xuán dǎn","abbr":"gcxd","explanation":"形容担忧，放不下心来。","source":{"text":"送荆钗只愁富室褒谈，良媒竟没一句回俺，反教娘挂肠悬胆。","book":"元·柯丹邱《荆钗记·合卺》"}},{"id":21579,"word":"指一说十","pinyin":"zhǐ yī shuō shí","abbr":"zyss","explanation":"指着一说成是十。形容不顾事实，存心夸大。","source":{"text":"如今把他的锁扭开，明日未必不指一说十，讲那‘走了鱼儿是大的’话。","book":"清·李绿园《歧路灯》第三十回"},"usage":"作谓语、定语；用于处事"},{"id":21580,"word":"指不胜偻","pinyin":"zhǐ bù shèng lǚ","abbr":"zbsl","explanation":"形容数量很多，扳着指头数也数不过来。偻：弯曲。同“指不胜屈”。","source":{"text":"奇遇之多，指不胜偻，若今日所昵，未数数觏也。","book":"清·和邦额《夜谭随录·吴喆》"},"similar":["指不胜屈","指不胜数"],"opposite":["寥寥无几"],"usage":"作谓语、宾语、定语；形容数量多"},{"id":21581,"word":"指不胜屈","pinyin":"zhǐ bù shèng qū","abbr":"zbsq","explanation":"指：手指；屈：弯曲。扳着指头数也数不过来。形容为数很多。","source":{"text":"本朝大臣夺情任事者，指不胜屈。","book":"清·陈康祺《郎潜记闻》"},"example":{"text":"《春秋》之义，不以父命辞王命，不以家事辞王事。象这样的，～。","book":"清·曾朴《孽海花》第一回"},"similar":["不可胜数","举不胜举","不计其数"],"opposite":["屈指可数","寥寥无几","寥若晨星"],"usage":"作谓语、宾语、补语；形容数量多"},{"id":21582,"word":"指不胜数","pinyin":"zhǐ bù shèng shǔ","abbr":"zbss","explanation":"明·沈德符《万历野获编·国初荫叙》：“今仕宦子孙，富豪者多纵荡丧身，而贫弱者或衣食不给，其小有才者至窜入匪类，以辱先人，以余所见，指不胜屈。”","source":{"text":"今仕宦子孙，富豪者多纵荡丧身，而贫弱者或衣食不给，其小有才者至窜入匪类，以辱先人，以余所见，指不胜屈。","book":"明·沈德符《万历野获编·国初荫叙》"},"example":{"text":"至是书之足供研读后汉书之助者，尤为～。（《风俗通义校注叙例》）"},"similar":["指不胜偻","指不胜屈"],"usage":"作谓语、宾语、定语；形容数量多"},{"id":21583,"word":"指东划西","pinyin":"zhǐ dōng huà xī","abbr":"zdhx","explanation":"指说话时的手势动作。比喻说话避开主题，东拉西扯。","source":{"text":"说青道黄，指东划西。","book":"宋·释普济《五灯会元》卷十四"},"example":{"text":"张天翼《儿女们》：“廉大爷……～地告诉别人，他这回赶回家来是为了造门栅的。”"},"similar":["指东画西"],"usage":"作谓语、定语、状语；指瞎指挥"},{"id":21584,"word":"指东打西","pinyin":"zhǐ dōng dǎ xī","abbr":"zddx","explanation":"指着东边打西边，打得对手防不胜防。","source":{"text":"那女子一见，重新跳将下来，将那杠子抢到手里，掖上倭刀，一手抡开杠子，指东打西，指南打北，打了个落花流水，东倒西歪。","book":"清·文康《儿女英雄传》第六回"},"similar":["指南打北"],"usage":"作谓语、状语；用于处事"},{"id":21585,"word":"指东画西","pinyin":"zhǐ dōng huà xī","abbr":"zdhx","explanation":"指说话时的手势动作。比喻说话避开主题，东拉西扯。","source":{"text":"际出今日去却之乎者也，更不指东画西。","book":"宋·释普济《五灯会元》卷十四：“说青道黄，指东划西。”宋·释惟白《续传灯录》"},"example":{"text":"远远望着应伯爵与王妈妈二人，～，见了他来，便各自走散。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"similar":["指东划西"],"usage":"作谓语、宾语；指瞎指挥"},{"id":21586,"word":"指东话西","pinyin":"zhǐ dōng huà xī","abbr":"zdhx","explanation":"犹言东拉西扯。指说话文不对题或空言不实。","source":{"text":"连我也不懂得甚么。”三荷包无可奈何，只得辞了出来，又与丁师爷商量。","book":"清·李宝嘉《官场现形记》第七回：“三荷包再问问他，他便指东话西，一味支吾。又说：“临时我自来照料。”又说"},"example":{"text":"清·李宝嘉《官场现形记》第七回：“三荷包再问问他，他便～，一味支吾。”"},"similar":["指东说西"],"usage":"作谓语、定语、状语；用于处事"},{"id":21587,"word":"指东说西","pinyin":"zhǐ dōng shuō xī","abbr":"zdsx","explanation":"①见“指东话西”。②犹言指桑骂槐。","source":{"text":"你要骂我就骂我，别指东说西，欺负妈妈好说话。","book":"曹禺《雷雨》第三幕"},"example":{"text":"曾朴《孽海花》第11回：“你们别～的挖苦人。”"},"similar":["指东话西"],"usage":"作谓语、定语、状语；用于处事"},{"id":21588,"word":"指东骂西","pinyin":"zhǐ dōng mà xī","abbr":"zdmx","explanation":"指着东边骂西边。形容指着这个骂那个。","source":{"text":"这一丈青气忿忿的走到后边厨下，指东骂西，一顿海骂。","book":"明·兰陵笑笑生《金瓶梅词话》第二十八回"},"example":{"text":"起初还是指桑骂槐，～；再过几天，便渐渐骂到媳妇脸上来了。（清·吴趼人《二十年目睹之怪现状》第八十七回）"},"similar":["指桑骂槐","指桑说槐","指槐骂柳"],"usage":"作谓语、定语、状语；用于处事"},{"id":21589,"word":"指事类情","pinyin":"zhǐ shì lèi qíng","abbr":"zslq","explanation":"谓阐述事理，譬喻情状。","source":{"text":"然善属书离辞，指事类情，用剽剥儒、墨，虽当世宿学不能自解免。","book":"《史记·老子韩非列传》"},"example":{"text":"梅村诗有不可及者二：一则神韵悉本唐人，不落宋以后腔调，而～，又究转如意。","book":"清·赵翼《瓯北诗话·吴梅村诗》"},"usage":"作宾语、定语；用于书面语"},{"id":21590,"word":"指亲托故","pinyin":"zhǐ qīn tuō gù","abbr":"zqtg","explanation":"指为亲戚，假托故旧。即指攀附有权势的人。","source":{"text":"指亲托故厮还，趋时附势故相干。","book":"元·无名氏《渔樵记》第二折"},"usage":"作谓语、宾语；用于处事"},{"id":21591,"word":"指佞触邪","pinyin":"zhǐ nìng chù xié","abbr":"zncx","explanation":"佞：花言巧语的小人；邪：邪恶。指责申斥奸佞之人，抵制邪恶势力，","source":{"text":"献可替否，必在忠言。指佞触邪，须凭直士。","book":"唐·杨师立《烽陈敬十罪檄》"},"example":{"text":"宪官之职，在～，不在行李自大；侍臣之职，在献可替否，不在道路相高。（《旧唐书·温造传》）"},"usage":"作谓语、定语；用于书面语"},{"id":21592,"word":"指冬瓜骂葫芦","pinyin":"zhǐ dōng guā mà hú lú","abbr":"zdgmhl","explanation":"指表面上骂这个人，实际上骂那个人。","example":{"text":"你不要在此～。"},"similar":["指桑骂槐"],"usage":"作谓语、宾语；指指桑骂槐"},{"id":21593,"word":"指南打北","pinyin":"zhǐ nán dǎ běi","abbr":"zndb","explanation":"指着南边打北边，打得对手防不胜防。","source":{"text":"智深大怒，指东打西，指南打北，只饶了两头的。","book":"明·施耐庵《水浒全传》第四回"},"example":{"text":"一手抡开杠子，指东打西，～，打了个落花流水，东倒西歪。（清·文康《儿女英雄传》第六回）"},"similar":["指东打西"],"usage":"作谓语、状语；用于处事"},{"id":21594,"word":"指南攻北","pinyin":"zhǐ nán gōng běi","abbr":"zngb","explanation":"犹声东击西。","source":{"text":"明·罗贯中《三国演义》第一百十一回:“蜀人或声东击西，指南攻北，吾兵必须分头守把。”"},"similar":["指南打北","指东打西"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21595,"word":"指古摘今","pinyin":"zhǐ gǔ zhāi jīn","abbr":"zgzj","explanation":"指摘古今。形容才气纵横，言论锋利。","source":{"text":"稗畦洪先生以诗鸣长安，交游宴集，每白眼踞坐，指古摘今，无不心折。","book":"清·徐麟《长生殿序》"},"usage":"作谓语、定语；用于书面语"},{"id":21596,"word":"指名道姓","pinyin":"zhǐ míng dào xìng","abbr":"zmdx","explanation":"明确指出姓和名。","source":{"text":"华程继续指名道姓地批评，毫不容情。","book":"张天民《创业》"},"example":{"text":"他～地说，好像真有其事。"},"similar":["直呼其名","直言不讳","毫不隐讳"],"opposite":["旁敲侧击","隐约其辞","含沙射影"],"usage":"作谓语、状语；多指公开批评"},{"id":21597,"word":"指囷相助","pinyin":"zhǐ qūn xiāng zhù","abbr":"zqxz","explanation":"囷：古代一种圆形的粮仓。手指粮仓表示要帮助友人。形容慷慨大方。","source":{"text":"周瑜为居巢长，将数百人故过候肃，并求资粮。肃家有两囷米，各三千斛。肃乃指一囷与周瑜，瑜益知其奇也。","book":"《三国志·吴志·鲁肃传》"}},{"id":21598,"word":"指囷相赠","pinyin":"zhǐ què xiāng zèng","abbr":"zqxz","explanation":"囷：圆形的谷仓。指着谷仓里的粮食，表示要捐赠给他人。形容慷慨资助朋友。亦作“指囷相助”。","source":{"text":"瑜曰：‘子敬是我恩人，想昔日指囷相赠之情，如何不救你？你且宽心住数日，待江北探细的回，别有区处。’","book":"明·罗贯中《三国演义》第五十四回"},"example":{"text":"又复～，盛族觉是意外之侥幸，有不感激的么？","book":"《反美华工禁约文学集·黄金世界》"},"usage":"作谓语、定语；用于书面语"},{"id":21599,"word":"指大于臂","pinyin":"zhǐ dà yú bì","abbr":"zdyb","explanation":"手指比胳臂大。比喻下级的权力比上级大。","source":{"text":"臣求学闻指大于臂，臂大于股，若有此，则病必甚矣。","book":"《战国策·秦策三》"}},{"id":21600,"word":"指天为誓","pinyin":"zhǐ tiān wéi shì","abbr":"ztws","explanation":"誓：发誓。指着天誓。表示意志坚决或对人表示忠诚。","source":{"text":"指天日涕泣，誓生死不相背负，真若可信。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"人言那可凭，盍～。","book":"宋·洪迈《夷坚甲志·张夫人》"},"similar":["指天誓日","指日誓心","指矢天日"],"usage":"作谓语、状语；指发誓"},{"id":21601,"word":"指天射鱼","pinyin":"zhǐ tiān shè yú","abbr":"ztsy","explanation":"向着天空去射河里的鱼。比喻办事一定落空。","source":{"text":"譬其若夏至之日而欲夜之长也，射鱼指天而欲发之当也。","book":"汉·刘向《说苑·尊贤》"},"similar":["缘木求鱼"],"usage":"作谓语、定语、宾语；指办事方法不对头"},{"id":21602,"word":"指天画地","pinyin":"zhǐ tiān huà dì","abbr":"zthd","explanation":"形容说话没有顾忌，目中无人。","source":{"text":"歆指天画地，言甚刚切，坐免，归田里。","book":"《史记·魏其武安侯列传》：“招聚天下豪杰壮士与论议，腹诽而心谤，不仰视天而俯画地，辟倪两宫间，幸天下有变，而欲有大功。”《后汉书·侯霸传》"},"example":{"text":"唐先生方站在台上，兴高采烈，～的在那里开始他的雄辩。","book":"清·曾朴《孽海花》第三十四回"},"similar":["直言不讳","心直口快","实事求是"],"opposite":["欲言又止","吞吞吐吐"],"usage":"作谓语、定语；指人说话"},{"id":21603,"word":"指天誓心","pinyin":"zhǐ tiān shì xīn","abbr":"ztsx","explanation":"对天起誓，表示意志坚定或对人忠诚无欺。","source":{"text":"臣与一二贞士，指天誓心，枝梧群邪，捍城王室。","book":"唐·张说《为郭振让官表》"},"example":{"text":"宋·张孝祥《代总得居士与叶参政》：“父子百口，毕命驱驰，～，罔有二事，伏惟相公怜而察之。”"},"similar":["指日誓心","指天誓日"],"usage":"作谓语、定语；用于处事"},{"id":21604,"word":"指天誓日","pinyin":"zhǐ tiān shì rì","abbr":"ztsr","explanation":"誓：发誓。指着天对着太阳发誓。表示意志坚决或对人表示忠诚。","source":{"text":"指天日涕泣，誓生死不相背负，真若可信。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"其所以改悔自新者，～可表。","book":"宋·袁采《袁氏世苑·治家》"},"similar":["指天为誓","信誓旦旦"],"opposite":["背信弃义"],"usage":"作谓语、状语；指发誓"},{"id":21605,"word":"指天说地","pinyin":"zhǐ tiān shuō dì","abbr":"ztsd","explanation":"指着天说着地。形容无所不谈。","source":{"text":"刘学深又跑了过来，指天说地，他四人听了，都是些闻所未闻的话，倒也借此很开些知识。","book":"清·李宝嘉《文明小史》第十九回"},"similar":["谈天说地"],"usage":"作谓语、定语、状语；用于书面语"},{"id":21606,"word":"指奏相反","pinyin":"zhǐ zòu xiāng fǎn","abbr":"zzxf","explanation":"指奏：旨趣。主要的目的和意图相反，各执己见。","source":{"text":"故百家之言，指奏相反，其合道一体也。","book":"《淮南子·齐俗训》"},"usage":"作宾语、定语；用于书面语"},{"id":21607,"word":"指山卖岭","pinyin":"zhǐ shān mài lǐng","abbr":"zsml","explanation":"比喻不着边际的空谈。","example":{"text":"别～了，谁都了解你。"},"usage":"作谓语、宾语；指空谈"},{"id":21608,"word":"指山卖磨","pinyin":"zhǐ shān mài mò","abbr":"zsmm","explanation":"指着山上的石头当磨来卖。比喻事情还没有头绪就过早说出去或答应下来。也指以有名无实的手法进行欺骗。","source":{"text":"出来的都关来节去，私多公少，可曾有一件合天道？他每都指山卖磨，将百姓划地为牢。","book":"元·岳伯川《吕洞宾度铁拐李》第一折"},"example":{"text":"他～，见雀张罗。","book":"明·徐复祚《红梨记传奇》"},"similar":["指山说磨"],"usage":"作主语、谓语、宾语；指借此说彼"},{"id":21609,"word":"指山说磨","pinyin":"zhǐ shān shuō mò","abbr":"zssm","explanation":"比喻错此说彼。","source":{"text":"如何远打周折，指山说磨，拿人家来比奴一节，不是那样人。","book":"明·兰陵笑笑生《金瓶梅词话》第十回"},"similar":["指桑骂槐","指黑道白"],"usage":"作主语、谓语、宾语；指借此说彼"},{"id":21610,"word":"指成之间","pinyin":"zhǐ gù zhī jiān","abbr":"zczj","explanation":"指：用手指；顾：回头看。比喻时间十分短促。","source":{"text":"指顾之际，山与舟相逼，乃有彩船自山驰来。","book":"唐·李朝威《柳毅传》"}},{"id":21611,"word":"指手划脚","pinyin":"zhǐ shǒu huà jiǎo","abbr":"zshj","explanation":"用手指，用脚划。形容说话时用手脚示意，也比喻瞎指挥，乱加指点批评。","source":{"text":"问起根由，毛泼皮指手划脚，剖说那事。","book":"明·冯梦龙《醒世恒言》"},"example":{"text":"这就用不着你～了，我们当然要交给领导处理。","book":"浩然《艳阳天》第86章"},"similar":["指东划西","评头品足","比手划脚"],"usage":"作谓语、状语；指乱加指点"},{"id":21612,"word":"指手点脚","pinyin":"zhǐ shǒu diǎn jiǎo","abbr":"zsdj","explanation":"犹指指点点。形容背后指点议论之状。","source":{"text":"［彦思］走将出来时，众人便指手点脚，当一场笑话。","book":"明·凌濛初《初刻拍案惊奇》卷二十二"},"similar":["指指点点"],"usage":"作定语、状语；用于处事"},{"id":21613,"word":"指手画脚","pinyin":"zhǐ shǒu huà jiǎo","abbr":"zshj","explanation":"指说话时做出各种动作。形容说话时放肆或得意忘形。","source":{"text":"见这李虞侯、张干办在宋江前面指手划脚，你来我去，都有心要杀这厮，只是碍着宋江一个，不敢下手。","book":"明·施耐庵《水浒全传》第七十五回"},"example":{"text":"站在他们前头领导他们呢？还是站在他们后头～地批评他们呢？","book":"毛泽东《湖南农民运动考察报告》"},"similar":["指手划脚","比手划脚"],"usage":"作谓语、状语；指瞎指挥","story":["贾府热闹非凡，贾母开宴庆生日，贾政陪贾母一起玩闹、猜谜与讲笑话，大家十分高兴。贾政因故离开，宝玉就神气活现了，他跑至围屏灯前，指手画脚，满口批评，说这个的这句不好，那个的破的不恰当，就像开了锁的猴子一样活泼"]},{"id":21614,"word":"指手顿脚","pinyin":"zhǐ shǒu dùn jiǎo","abbr":"zsdj","explanation":"一面指着骂，一面跺着脚。形容蛮横不讲理的样子。","source":{"text":"这时她还在那里指手顿脚的撒野，张裕民不管三七二十一，两步抢到她面前，厉声问道：‘你要干什么？’","book":"丁玲《太阳照在桑干河上》三三"},"usage":"作定语、状语；用于处事"},{"id":21615,"word":"指指戳戳","pinyin":"zhǐ zhǐ chuō chuō","abbr":"zzcc","explanation":"指在人背后用手指点讲说。","source":{"text":"改扮停当，就从开封府角门内，大摇大摆的出来，招的众人无不嘲笑……三三两两。在背后指指戳戳。","book":"清·石玉昆《三侠五义》第四十一回"},"similar":["指指点点"],"usage":"作谓语、定语、状语；用于处事"},{"id":21616,"word":"指指点点","pinyin":"zhǐ zhǐ diǎn diǎn","abbr":"zzdd","explanation":"指给人点化或背后评论人。","source":{"text":"贾芹走进书房，只见那些下人指指点点，不知说什么。看起这个样儿，不象宫里要人。","book":"清·曹雪芹《红楼梦》第93回"},"example":{"text":"曾朴《孽海花》第33回：“看那老番，正望着怒瀑的两岬间，～地给徐骧讲话。”"},"similar":["说三道四","指手划脚"],"usage":"作谓语、宾语、定语、状语；用于评论"},{"id":21617,"word":"指挥可定","pinyin":"zhǐ huī kě dìng","abbr":"zhkd","explanation":"指一经调度安排，不须多久，局势即可平定。同“指麾可定”。","source":{"text":"某生长北方，闻燕人思归之情切矣，今若举事，指挥可定。","book":"宋·周煇《清波别志》卷上"},"similar":["指麾可定"],"usage":"作谓语、定语；用于处事"},{"id":21618,"word":"指挥若定","pinyin":"zhǐ huī ruò dìng","abbr":"zhrd","explanation":"形容态度冷静，考虑周全，指挥起来就象一切都事先规定好了似的。","source":{"text":"伯仲之间见伊吕，指挥若定失萧曹。","book":"唐·杜甫《咏怀古迹》诗"},"example":{"text":"他刚刚坐定，这一大群人已经跟了进来，用各种阿谀逢迎的言词称颂他神机妙算，“～”。","book":"姚雪垠《李自成》第一卷第十一章"},"similar":["胸有成竹","心中有数","稳操胜券"],"opposite":["心中无数","手忙脚乱"],"usage":"作谓语、定语；指胸有成竹"},{"id":21619,"word":"指掌可取","pinyin":"zhǐ zhǎng kě qǔ","abbr":"zzkq","explanation":"掌：手掌。手掌里的东西随时可以取得。形容非常容易。","source":{"text":"若能此际排难解纷，陈师鞠旅，共诛寇盗，迎奉銮舆，则富贵功名，指掌可取。","book":"《旧唐书·张濬传》"},"similar":["手到擒来"],"usage":"作谓语、定语；用于书面语"},{"id":21620,"word":"指敌忘身","pinyin":"zhǐ dí wàng shēn","abbr":"zdws","explanation":"指敌：指向敌人。同敌人作战，忘记了自己的生死。形容勇猛杀敌，舍生忘死。","source":{"text":"兵有五致：为将忘家，逾垠忘亲，指敌忘身，必死则生，急胜为下。百人被刃，陷行乱陈；千人被刃，擒敌杀将；万人被刃，横行天下。","book":"战国·尉缭《尉缭子·兵教下》"},"usage":"作谓语、定语；用于书面语"},{"id":21621,"word":"指方画圆","pinyin":"zhǐ fāng huà yuán","abbr":"zfhy","explanation":"指谈论时以手指比画。","source":{"text":"或共其议论，辄掀眉吐气，指方画圆，滚滚数千言不休。","book":"明·宋濂《王府君墓志铭》"}},{"id":21622,"word":"指日可下","pinyin":"zhǐ rì kě xià","abbr":"zrkx","explanation":"指日：指明日期。表示不久就可以攻下。","source":{"text":"故臣以谓兵出沐阳则山东指日可下。","book":"宋·辛弃疾《美芹十论·详战第十》"},"example":{"text":"这最后的抵抗如被冲破，武昌城便～。","book":"郭沫若《革命春秋·北伐途次》"},"similar":["指日可待"],"opposite":["遥遥无期"],"usage":"作谓语、宾语；指马上可以攻下"},{"id":21623,"word":"指日可俟","pinyin":"zhǐ rì kě sì","abbr":"zrkq","explanation":"指日：可以指出日期，为期不远；俟：等待。为期不远，不久就可以实现。","source":{"text":"中兴之功，指日可俟。","book":"宋·张守《应诏论事札子》"},"example":{"text":"高卧山巢，公然自负，以为黄袍之加，～矣。（清·蒲松龄《聊斋志异·九山王》）"},"similar":["指日可待","指日而待"],"opposite":["遥遥无期"],"usage":"作谓语、宾语、定语；指为期不远"},{"id":21624,"word":"指日可待","pinyin":"zhǐ rì kě dài","abbr":"zrkd","explanation":"指日：可以指出日期，为期不远；待：期待。为期不远，不久就可以实现。","source":{"text":"推今日欲治之心，为之不已；太平之功，指日可待。","book":"宋·曾肇《论内批直付有司》"},"example":{"text":"是以我主上神佑，泥马渡江，正位金陵，用贤任能，中兴～。","book":"清·钱彩《说岳全传》第三十一回"},"similar":["指日可下","计日程功","指日而待"],"opposite":["遥遥无期"],"usage":"作谓语、宾语、定语；指为期不远"},{"id":21625,"word":"指日告罄","pinyin":"zhǐ rì gào qìng","abbr":"zrgq","explanation":"指日：不久。指事情或工作很快就可以完成。"},{"id":21626,"word":"指日成功","pinyin":"zhǐ rì chéng gōng","abbr":"zrcg","explanation":"指不久即可成功。","source":{"text":"与我谨守堤岸，不可渗泄，指日成功，共享其利。","book":"元·高文秀《襄阳会》第三折：“觑曹操易如反掌，克日而破，指日成功。”元·杨梓《豫让吞炭》第二折"},"example":{"text":"明·施耐庵《水浒传》第78回：“水陆并进，船骑同行，方可～。”"},"similar":["指日可待"],"opposite":["遥遥无期"],"usage":"作谓语、定语；用于处事"},{"id":21627,"word":"指日而待","pinyin":"zhǐ rì ér dài","abbr":"zred","explanation":"指不久即可实现。同“指日可待”。","source":{"text":"将来执掌昭阳，可指日而待，为何夫人双眉反蹙起来？","book":"清·褚人获《隋唐演义》第七十一回"},"example":{"text":"孙中山《心理建设（孙文学说）》第四章：“倘计划既定，按图施工，则成效可～矣。”"},"similar":["指日可待","指日可俟"],"usage":"作谓语、宾语、定语；指为期不远"},{"id":21628,"word":"指日誓心","pinyin":"zhǐ rì shì xīn","abbr":"zrsx","explanation":"对着太阳发誓，表明忠诚无二。","source":{"text":"惟嗢没斯精诚上达，天诱其衷。拔自狼居之山，愿拜龙颜之主，封章沥恳，指日誓心，不夺之诚，介如石矣。","book":"唐·李德裕《〈异域归忠传〉序》"},"similar":["指天誓日","指矢天日"],"usage":"作谓语、定语；用于处事"},{"id":21629,"word":"指日高升","pinyin":"zhǐ rì gāo shēng","abbr":"zrgs","explanation":"指很快就可升官。旧时官场预祝之词。","source":{"text":"代天巡狩，赞称巡按；指日高升，预贺官僚。","book":"明·程登吉《幼学琼林·文臣》"},"example":{"text":"二老爷道:‘暖阁当中，不是‘当朝一品’，就是‘～’，从没有用过别的字眼。’","book":"清·李宝嘉《官场现形记》第四十五回"},"usage":"作谓语；用于官场预祝之词"},{"id":21630,"word":"指李推张","pinyin":"zhǐ lǐ tuī zhāng","abbr":"zltz","explanation":"指相互推委，逃避责任。","source":{"text":"临期听比，无指李推张之弊。","book":"清·黄六鸿《福惠全书·钱谷·比较》"},"usage":"作宾语、定语；用于比喻句"},{"id":21631,"word":"指树为姓","pinyin":"zhǐ shù wéi xìng","abbr":"zswx","explanation":"道教传说，老子生于李树下，因以李为姓。","source":{"text":"见晋·葛洪《神仙传·老子》。"},"example":{"text":"老君感星载诞，莫测受气之由；～，未详吹律之本。","book":"隋·薛道衡《老氏碑》"},"usage":"作宾语、定语；用于书面语"},{"id":21632,"word":"指桑说槐","pinyin":"zhǐ sāng shuō huái","abbr":"zssh","explanation":"比喻明指此而暗骂彼。同“指桑骂槐”。","source":{"text":"众丫头媳妇无不言三语四，指桑说槐，暗相讥刺。","book":"清·曹雪芹《红楼梦》第六十九回"},"similar":["指桑骂槐","指东骂西","指槐骂柳"],"usage":"作谓语、状语；用于说话与作文"},{"id":21633,"word":"指桑骂槐","pinyin":"zhǐ sāng mà huái","abbr":"zsmh","explanation":"指着桑树骂槐树。比喻表面上骂这个人，实际上是骂那个人。","source":{"text":"他每日边指桑树骂槐树，百般称快。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"},"example":{"text":"咱们家所有的这些管家奶奶，那一个是好缠的？错一点儿他们就笑话打趣，偏一点儿他们就～的抱怨。","book":"清·曹雪芹《红楼梦》第十六"},"similar":["指鸡骂狗","旁敲侧击","借题发挥"],"opposite":["直言不讳","直截了当","指名道姓"],"usage":"作主语、谓语、状语；用于说话与作文","story":["贾政寿辰那天，夏太监前来宣贾政入朝觐见，得知元春被加封贤德妃。喜讯传来，贾府上下欢天喜地，只有宝玉置若罔闻，他惦记黛玉回来，贾琏接完黛玉回来后见凤姐，凤姐倾诉家不好当，人们都在指桑骂槐地抱怨她"]},{"id":21634,"word":"指槐骂柳","pinyin":"zhǐ huái mà liǔ","abbr":"zhml","explanation":"指着桑树骂槐树。比喻表面上骂甲，实际上是骂乙","source":{"text":"然后，指槐骂柳的仍对两位小姐发言，而目标另有所在……","book":"老舍《四世同堂》"},"similar":["指桑骂槐","指桑说槐","指东骂西"],"usage":"作谓语、定语、状语；用于处事"},{"id":21635,"word":"指水盟松","pinyin":"zhǐ shuǐ méng sōng","abbr":"zsms","explanation":"盟：盟誓。指着流水、松树以为盟誓。形容情谊之深。","source":{"text":"章相与学士，初方指水盟誓，后反操戈入室，不免乘此机会，嘲他几句，有何不可？","book":"明·陈汝元《金莲记·诟奸》"},"usage":"作谓语、定语；用于书面语"},{"id":21636,"word":"指点江山","pinyin":"zhǐ diǎn jiāng shān","abbr":"zdjs","explanation":"指点：批评；江山：指国家。指批评国家大事。","source":{"text":"指点江山，激扬文字，粪土当年万户侯。","book":"毛泽东《沁园春·长沙》"},"example":{"text":"他习惯于～。"},"usage":"作谓语、定语；指批评国家大事"},{"id":21637,"word":"指猪骂狗","pinyin":"zhǐ zhū mà gǒu","abbr":"zzmg","explanation":"犹指桑骂槐。亦作“指鸡骂狗”。","source":{"text":"百般指猪骂狗，欺侮俺娘儿们。","book":"明·兰陵笑笑生《金瓶梅词话》第十一回"},"example":{"text":"清·李百川《绿野仙踪》第17回：“因文炜主持家政，气愤不过，天天～的吵闹。”"},"similar":["指桑骂槐","指鸡骂狗"],"usage":"作谓语、宾语、定语、状语；用于处事"},{"id":21638,"word":"指瑕造隙","pinyin":"zhǐ xiá zào xì","abbr":"zxzx","explanation":"犹言寻找事端，制造分裂。瑕，玉上的斑点。隙，裂缝。","source":{"text":"彼或内变既平，指瑕造隙，肆无厌之欲，发难从之请，其将何词以对？","book":"宋·朱熹《少帅魏国张公行状下》"},"usage":"作谓语、定语；用于处事"},{"id":21639,"word":"指画口授","pinyin":"zhǐ huà kǒu shòu","abbr":"zhks","explanation":"一面讲一面用手势帮助表达意思。形容详细地解说。","source":{"text":"盖四十年耳治目营，指画口授惟此，他无及也。","book":"清·查继佐《罪惟录·徐光启传》"},"similar":["口讲指画","口讲手画","口讲指划"],"usage":"作谓语、宾语；形容详细地解说"},{"id":21640,"word":"指皁为白","pinyin":"zhǐ zào wéi bái","abbr":"zzwb","explanation":"指混淆黑白，颠倒是非。"},{"id":21641,"word":"指皂为白","pinyin":"zhǐ zào wéi bái","abbr":"zzwb","explanation":"谓混淆黑白，颠倒是非。","source":{"text":"动不动神头鬼脸，投河奔井，拽巷逻街，张舌骗口，花言巧语，指皂为白。","book":"元·武汉臣《玉壶春》第三折"},"similar":["指鹿为马"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21642,"word":"指着和尚骂贼秃","pinyin":"zhǐ zhe hé shàng mà zéi tū","abbr":"zzhsmzt","explanation":"比喻表面上骂这个人，实际上是骂那个人。","example":{"text":"既然如此，他发多大的牢骚，那怕～，也得捏了鼻子受他的。（高阳《慈禧全传》七十五）"},"similar":["对着和尚骂贼秃"],"usage":"作谓语、宾语、定语；用于口语"},{"id":21643,"word":"指矢天日","pinyin":"zhǐ shǐ tiān rì","abbr":"zstr","explanation":"指着天、日发誓，表白心迹。同“指天誓日”。","source":{"text":"女要誓；南指矢天日，以坚永约，女乃允之。","book":"清·蒲松龄《聊斋志异·窦氏》"},"similar":["指天誓日","指日誓心"],"usage":"作谓语、状语；指发誓"},{"id":21644,"word":"指破迷团","pinyin":"zhǐ pò mí tuán","abbr":"zpmt","explanation":"指点解说，破除疑问。","source":{"text":"玉蟾道：‘妹子也疑这个托字不妥，今听姐姐之言，真是指破迷团，后人受益不浅。’","book":"清·李汝珍《镜花缘》第七十九回"},"similar":["指点迷津"],"usage":"作谓语、宾语；指指点"},{"id":21645,"word":"指破迷津","pinyin":"zhǐ pò mí jīn","abbr":"zpmj","explanation":"迷津：疑团。用指点破迷团。","source":{"text":"无奈到了争名夺利关头，心里不由就觉发迷，倒象自己永世不死，一味朝前奔命，将来到了昏迷时，怎能有人当头一棒，指破迷团？","book":"清·李汝珍《镜花缘》第十六回"}},{"id":21646,"word":"指空话空","pinyin":"zhǐ kōng huà kōng","abbr":"zkhk","explanation":"指故弄玄虚。","source":{"text":"非是我指空话空，做这等巧神通，也只为结婚姻本待谐鸾凤。","book":"元·王晔《桃花女》第四折"},"usage":"作谓语、定语、状语；用于处事"},{"id":21647,"word":"指腹为亲","pinyin":"zhǐ fù wéi qīn","abbr":"zfwq","explanation":"在怀孕时就为子女定下婚约。","source":{"text":"汝等将来所生，皆我之自出，可指腹为亲。","book":"《魏书·王宝兴传》"},"similar":["指腹成亲","指腹为婚"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":21648,"word":"指腹为婚","pinyin":"zhǐ fù wéi hūn","abbr":"zfwh","explanation":"在怀孕时就为子女定下婚约。","source":{"text":"汝等将来所生，皆我之自出，可指腹为亲。","book":"《魏书·王宝兴传》"},"example":{"text":"彼时九王爷因娘娘又怀身孕，曾与骆老爷～，倘生郡主，情愿与骆公子再续前姻。","book":"清·李汝珍《镜花缘》第五十六回"},"similar":["青梅竹马","两小无猜"],"usage":"作谓语、定语；指家长包揽婚姻","story":["东汉初年，将军贾复跟随刘秀南征北战，一次在战斗中不幸负重伤，光武帝刘秀十分心痛与难过，得知贾复的妻子怀孕在身，便对她说：“如果生女儿，我儿子娶她，如果生儿子，我女儿嫁给他。”"]},{"id":21649,"word":"指腹割衿","pinyin":"zhǐ fù gē jīn","abbr":"zfgj","explanation":"指腹：指双方父母为腹中的婴儿预订婚姻；割衿：指男女幼年由父母代订婚约，将衣襟裁为两幅，各执上方作为凭证。指从小订婚。","source":{"text":"诸男女议婚，有以指腹割衿为定者，禁之。","book":"《元史·刑法志二》"},"similar":["指腹裁襟"],"usage":"作宾语、定语；用于书面语"},{"id":21650,"word":"指腹成亲","pinyin":"zhǐ fù chéng qīn","abbr":"zfcq","explanation":"在怀孕时就为子女定下婚约。","source":{"text":"汝等将来所生，皆我之自出，可指腹为亲。","book":"《魏书·王宝兴传》"},"example":{"text":"《魏书·王宝兴传》：“汝等将来所生，皆我之自出，可指腹为亲。”"},"similar":["指腹为亲","指腹为婚"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":21651,"word":"指腹裁襟","pinyin":"zhǐ fù cái jīn","abbr":"zfcj","explanation":"指腹：指双方父母为腹中的婴儿预订婚姻；裁襟：指男女幼年由父母代订婚约，将衣襟裁为两幅，各执上方作为凭证。指从小订婚。","source":{"text":"诸男女议婚，有以指腹割衿为定者，禁之。","book":"《元史·刑法志二》"},"example":{"text":"我女已亡故三年，不说道纳采下茶，便是～，一些没有。（明·汤显祖《牡丹亭·硬拷》）"},"similar":["指腹割衿"],"usage":"作宾语、定语；用于书面语"},{"id":21652,"word":"指雁为羹","pinyin":"zhǐ yàn wéi gēng","abbr":"zywg","explanation":"比喻用空想来安慰自己。","source":{"text":"当初指雁为羹，似充饥画饼，道无情却有情。","book":"元·宋方壶《醉花阴·赶苏卿》"},"example":{"text":"假相期不志诚，恰便似～。","book":"明·朱有燉《半夜朝元》第一折"},"usage":"作谓语、宾语、定语；指空想"},{"id":21653,"word":"指顾之间","pinyin":"zhǐ gù zhī jiān","abbr":"zgzj","explanation":"指：用手指；顾：回头看。比喻时间十分短促。","source":{"text":"乞恩于指顾之间，为惠有生成之重。虽百谷之仰膏雨，","book":"唐·刘禹锡《上杜司徒书》"},"example":{"text":"他只道～就可与旧友重逢欢聚，哪知蓦地里竟起祸生不测。（金庸《射雕英雄传》第三十四回）"},"similar":["指顾之际","指顾间事"],"usage":"作宾语；用于书面语"},{"id":21654,"word":"指顾之际","pinyin":"zhǐ gù zhī jì","abbr":"zgzj","explanation":"指：用手指；顾：回头看。比喻时间十分短促。","source":{"text":"指顾之际，山与舟相逼，乃有彩船自山驰来。","book":"唐·李朝威《柳毅传》"},"similar":["指顾之间","指顾间事"],"usage":"作宾语；用于书面语"},{"id":21655,"word":"指顾从容","pinyin":"zhǐ gù cóng róng","abbr":"zgcr","explanation":"指：手指；顾：眼看。动作和眼神十分沉着冷静。形容行动迅速而又从容。","source":{"text":"及夫发谋决策，从容指顾，立定大计，谓千载而一时。","book":"宋·王安石《祭欧阳文忠公文》"}},{"id":21656,"word":"指顾倏忽","pinyin":"zhǐ gù shū hū","abbr":"zgsh","explanation":"指：用手指；顾：用眼看；倏忽：很快。抬手转眼之间。形容时间极其短暂。","source":{"text":"指顾倏忽，获车已实。乐不极盘，杀不尽物。","book":"汉·班固《东都赋》"}},{"id":21657,"word":"指顾间事","pinyin":"zhǐ gù jiān shì","abbr":"zgjs","explanation":"指：用手指；顾：回头看。用手一指或回头一看的瞬间。比喻时间十分短暂","source":{"text":"这时奉系军阀老巢的攻破，郭部亦操左券，只是指顾间事了。","book":"冯玉祥《我的生活》第32章"},"similar":["指顾之间","指顾之际"],"usage":"作宾语；用于书面语"},{"id":21658,"word":"指鸡骂狗","pinyin":"zhǐ jī mà gǒu","abbr":"zjmg","explanation":"指着鸡骂狗。比喻表面上骂这个人，实际上是骂那个人。","source":{"text":"李大嫂子，别指鸡骂狗，倒是谁白吃白喝？","book":"周立波《暴风骤雨》第一部"},"example":{"text":"你有话直说好了，用不着指鸡骂狗。"},"similar":["指桑骂槐","指猪骂狗"],"usage":"作主语、谓语、状语；指指桑骂槐"},{"id":21659,"word":"指鹿为马","pinyin":"zhǐ lù wéi mǎ","abbr":"zlwm","explanation":"指着鹿，说是马。比喻故意颠倒黑白，混淆是非。","source":{"text":"赵高欲为乱，恐群臣不听，乃先设验，持鹿献于二世，曰：‘马也。’二世笑曰：‘丞相误邪？谓鹿为马。’问左右，左右或默，或言马以阿顺赵高。","book":"《史记·秦始皇本纪》"},"example":{"text":"东床已招佳婿，何似以羊易牛；西邻纵有责言，终难～。","book":"明·冯梦龙《醒世恒言》卷七"},"similar":["混淆是非","颠倒黑白"],"opposite":["是非分明"],"usage":"作谓语、宾语、定语；指故意颠倒黑白","story":["秦末宦官赵高在秦始皇病故后假传圣旨命扶苏自杀，立胡亥为太子，他还想篡夺帝位，特地把一匹鹿当马送给秦二世胡亥，胡亥说是鹿，赵高叫胡亥问群臣。群臣有些迫于丞相赵高的势力违心说是鹿，只有部分说是鹿的大臣后被赵高所害"]},{"id":21660,"word":"指鹿作马","pinyin":"zhǐ lù zuò mǎ","abbr":"zlzm","explanation":"比喻有意颠倒黑白，混淆是非。同“指鹿为马”。","source":{"text":"大军还洛阳，曜有罪，勋奏绌遣。而曜密表勋私解邕事。昭曰：‘勋指鹿作马，收付廷尉。’","book":"《三国志·魏志·鲍勋传》"},"similar":["指鹿为马"],"usage":"作谓语、宾语、定语；指故意颠倒黑白"},{"id":21661,"word":"指麾可定","pinyin":"zhǐ huī kě dìng","abbr":"zhkd","explanation":"指一经调度安排，不须多久，局势即可平定。","source":{"text":"语出《史记·陈丞相世家》：“诚各去其两短，袭其两长，天下指麾则定矣。”《汉书·陈平传》作“天下指麾即定矣”。"},"example":{"text":"是时高宗锐意河南，以为～。","book":"《陈书·蔡景列传》"},"similar":["指挥可定"],"usage":"作谓语、定语；用于处事"},{"id":21662,"word":"挈妇将雏","pinyin":"qiè fù jiāng chú","abbr":"qfjc","explanation":"挈：带领；雏：幼儿。带着妻子儿女。","source":{"text":"惯于长夜过春时，挈妇将雏鬓有丝。","book":"鲁迅《南腔北调集·为了忘却的记念》"},"example":{"text":"但是，工厂已被“红革造”的那帮人掌了权，早把这个机修工人开除了。吴尚荣只得～回到河南老家。","book":"张贤亮《河的子孙》第七章"},"similar":["携妻带子"],"usage":"作谓语、宾语、定语；用于家庭"},{"id":21663,"word":"挈榼提壶","pinyin":"qiè kē tí hú","abbr":"qkth","explanation":"挈：持，提；榼：酒器。手提酒器和酒壶。形容嗜酒成性。","source":{"text":"止操卮执觚，动则挈榼提壶，唯酒是务，焉知其余。","book":"晋·刘伶《酒德颂》"},"example":{"text":"不恋着九间天子常朝殿，怎如三尺黄公旧酒炉。但行处～。","book":"元·王伯成《李太白贬夜郎》第二折"},"usage":"作谓语、定语；用于书面语"},{"id":21664,"word":"挈泰山以超江河","pinyin":"qiè tài shā yǐ chāo jiāng hé","abbr":"qtsycjh","explanation":"超：跨过；挈：用手提着。用手提着泰山跨过大江大河。比喻不可能做到的事情。","source":{"text":"夫挈泰山以超江河，自古之及今，生民而来，未尝有也。","book":"《墨子·兼爱下》"}},{"id":21665,"word":"挈瓶之智","pinyin":"qiè píng zhī zhì","abbr":"qpzz","explanation":"挈瓶：汲水用的容量小的瓶子。比喻浅薄的知识或智谋。亦作“智类挈瓶”、“挈瓶之知”。"},{"id":21666,"word":"挈瓶之智，守不假人","pinyin":"qiè píng zhī zhì，shǒu bù jiǎ rén","abbr":"qpzzsbjr","explanation":"挈瓶：汲水用的小瓶。仅有一点挈瓶汲水的浅薄见识就能守住汲器不外借。比喻慎其所有，忠于职守。","source":{"text":"挈瓶之智，守不假人。","book":"明·归有光《乞休申文》"},"similar":["挈瓶之智，守不假器"],"usage":"作宾语、定语；用于书面语"},{"id":21667,"word":"挈瓶之智，守不假器","pinyin":"qiè píng zhī zhì，shǒu bù jiǎ qì","abbr":"qpzzsbjq","explanation":"挈瓶：汲水用的小瓶。仅有一点挈瓶汲水的浅薄见识就能守住汲器不外借。比喻慎其所有，忠于职守。","source":{"text":"夫挈瓶之智，守不假器。吾既受之矣，何不急攻乎？","book":"晋·陈寿《三国志·魏志·田豫传》"},"similar":["挈瓶之智，守不假人"],"usage":"作宾语、定语；用于书面语"},{"id":21668,"word":"挈瓶之知","pinyin":"qiè píng zhī zhì","abbr":"qpzz","explanation":"挈瓶：汲水用的瓶，它装不了多少水。比喻知识浅薄，不能深明事理。","source":{"text":"人有言，挈瓶之知（智），不失守器。","book":"《左传·昭公七年》：“虽有挈瓶之知（智），守不假器，礼也。”《战国策·赵策一》"},"similar":["挈瓶小智"],"usage":"作宾语；指知识浅薄"},{"id":21669,"word":"挈瓶之知，不失守器","pinyin":"qiè píng zhī zhī，bù shī shǒu qì","abbr":"qpzzbssq","explanation":"挈瓶：汲水用的小瓶。仅有一点挈瓶汲水的浅薄见识就能守住汲器不外借。比喻慎其所有，忠于职守。","source":{"text":"挈瓶之知，不失守器。","book":"西汉·刘向《战国策·赵策》"},"similar":["挈瓶之智，守不假器"],"usage":"作宾语、定语；用于书面语"},{"id":21670,"word":"挈瓶小智","pinyin":"qiè píng xiǎo zhì","abbr":"qpxz","explanation":"挈瓶：汲水用的瓶，它装不了多少水。比喻知识浅薄，不能深明事理。","source":{"text":"虽有挈瓶之知，守不假器，礼也。","book":"《左传·昭公七年》"},"example":{"text":"既不办有抽剑两城之用，横槊搴旗之能，徒以～，名参佐命，常恐朝露一下，深恩不酬。","book":"《南齐书·刘善明传》"},"similar":["挈瓶之知"],"usage":"作宾语；指知识浅薄"},{"id":21671,"word":"挈领提纲","pinyin":"qiè lǐng tí gāng","abbr":"qltg","explanation":"挈衣之领，提网之纲。比喻抓住要领。","source":{"text":"若挈裘领，诎五指而而顿之，顺者不可胜数也。","book":"《韩非子·外储说右下》：“善张网者引其纲，不一一摄万目而后得。”《荀子·劝学》"},"example":{"text":"百病不究根由，只以多热为阴虚，多寒为阳虚，自夸为～之道，究竟伪术相师，能愈一大病乎。","book":"清·唐宗海《劝读十则》"},"similar":["提纲挈领"],"usage":"作谓语、定语、宾语；指简明扼要"},{"id":21672,"word":"按兵不举","pinyin":"àn bīng bù jǔ","abbr":"abbj","explanation":"犹按兵不动。","source":{"text":"岳家父子三人尽忠报国杀金人望风而走，岂有按兵不举之理？","book":"元·无名氏《开诏救忠》第三折：“你将那忠臣良将故赃谋，想着你按兵不举心更毒。”明·无名氏《精忠记·挂冠》"},"example":{"text":"侯虎曰：‘西伯侯姬昌好生可恶！今～，坐观成败。’","book":"明·许仲琳《封神演义》第四回"},"similar":["按兵不动"],"opposite":["闻风而动"],"usage":"作谓语、定语；指接到任务后不肯做"},{"id":21673,"word":"按兵不动","pinyin":"àn bīng bù dòng","abbr":"abbd","explanation":"按：止住。使军队暂不行动。现也比喻暂不开展工作。","source":{"text":"赵简子按兵而不动。","book":"《荀子·王制》：“偃然按兵不动。”《吕氏春秋·恃君览》"},"example":{"text":"又听得寨前炮响，史文恭～，只要等他入来，塌了陷坑，山后伏兵齐起，接应捉人。","book":"明·施耐庵《水浒全传》第六十八回"},"similar":["以逸待劳","裹足不前"],"opposite":["雷厉风行","闻风而动"],"usage":"作谓语、定语；多指接到任务后不肯做","story":["春秋末，卫国被迫与晋国结盟，成为晋国的附庸国。卫灵公为改变现状，与齐景公缔盟。晋国不能容忍卫国的行为，赵鞅派史默潜伏卫国。史默半年后回国报告说卫国启用贤臣蘧伯为相国，孔子的弟子子贡在出谋划策，赵鞅就按兵不动"]},{"id":21674,"word":"按兵束甲","pinyin":"àn bīng shù jiǎ","abbr":"absj","explanation":"按兵：军队停止行进。甲：铠甲，泛指武器装备。止兵不前，捆起铠甲。指解除武装，停战言降。","source":{"text":"若不能当，何不案兵束甲，北面而事之！","book":"《三国志·蜀志·诸葛亮传》"},"example":{"text":"何不～，北面而事之！","book":"《赤壁之战》"}},{"id":21675,"word":"按劳分配","pinyin":"àn láo fēn pèi","abbr":"alfp","explanation":"根据劳动的大小进行分配。","source":{"text":"坚持按劳分配原则。","book":"邓小平《关于发展工业的几点意见》"},"opposite":["按需分配"],"usage":"作谓语、宾语、主语、定语；用于分配"},{"id":21676,"word":"按劳取酬","pinyin":"àn láo qǔ chóu","abbr":"alqc","explanation":"按照劳动贡献的大小领取报酬。","source":{"text":"物质的分配也要按照‘各尽所能按劳取酬’的原则和工作的需要，决无所谓绝对的平均。","book":"毛泽东《关于纠正党内的错误思想》"},"similar":["按劳分配"],"usage":"作谓语、宾语、定语；用于分配"},{"id":21677,"word":"按名责实","pinyin":"àn míng zé shí","abbr":"amzs","explanation":"按照事物名称，要求与实相符。","source":{"text":"夫求才贵广，孝课贵精。求广在于各举所知，长吏之荐择是也；孝精在于按名责实，宰臣之序进是也。","book":"唐·陆贽《请许台省长官举荐属吏状》"},"example":{"text":"及～，台有评，省有核。","book":"明·李东阳《漳州府进士提名记》"},"similar":["循名责实"],"usage":"作谓语；指按照名单去落实"},{"id":21678,"word":"按图索籍","pinyin":"àn tú suǒ jí","abbr":"atsj","explanation":"按照地图，搜索典籍。","source":{"text":"可见按图索籍，山溪道路，一目了然。","book":"明·张岱《皇华考序》"}},{"id":21679,"word":"按图索骏","pinyin":"àn tú suǒ jùn","abbr":"atsj","explanation":"指按照画像去寻求好马。比喻墨守成规办事；也比喻按照线索去寻求。参见“按图索骥”。","source":{"text":"今不循伯者之道，乃欲以三代选举之法取当时之士，犹察伯乐之图求骐骥于市，而不可得，变已明矣。","book":"语出《汉书·梅福传》"},"example":{"text":"虽部胥掌阙簿者，亦不过～。","book":"宋·周密《癸辛杂识续集下·卖阙沈官人》"},"similar":["按图索骥"],"opposite":["不落窠臼"],"usage":"作宾语、定语；指按照线索去寻求"},{"id":21680,"word":"按图索骥","pinyin":"àn tú suǒ jì","abbr":"atsj","explanation":"索：找；骥：良马。按照画像去寻求好马。比喻墨守成规办事；也比喻按照线索去寻求。","source":{"text":"今不循伯者之道，乃欲以三代选举之法取当时之士，犹察伯乐之图求骐骥于市，而不可得，变已明矣。","book":"《汉书·梅福传》"},"example":{"text":"每见一班～者，多失于骊黄牝牡。","book":"明·赵汸《葬书问对》"},"similar":["照本宣科","生搬硬套"],"opposite":["不落窠臼"],"usage":"作谓语、定语、状语；比喻按照线索去寻求","story":["春秋时期相马专家孙阳（伯乐）根据自己的相马经验写了《相马经》，他的儿子很想把相马的绝技学到手，熟读《相马经》，根据经书上的标准选出的“千里马”——一只癞蛤蟆回家向其父报喜，伯乐看后哭笑不得"]},{"id":21681,"word":"按堵如故","pinyin":"àn dǔ rú gù","abbr":"adrg","explanation":"形容秩序良好，百姓和原来一样安居乐业。","source":{"text":"应劭曰：‘按，按次第。堵，墙堵也。’言不迁动也。","book":"《汉书·高帝纪上》：“与父老约法三章耳：杀人者死，伤人及盗抵罪。余悉除去秦法。吏民皆按堵如故。”颜师古注"},"example":{"text":"凡军民约三日入籴官米一斗，入昏钞二贯，民皆便之。由是～，而贼亦不敢犯其境。","book":"《元史·道童传》"},"similar":["安堵如故"],"usage":"作谓语、宾语；指社会秩序"},{"id":21682,"word":"按强助弱","pinyin":"àn qiáng zhù ruò","abbr":"aqzr","explanation":"按：抑制。抑制强暴，扶助弱小。","source":{"text":"按强助弱，圉暴止贪，存亡定危。","book":"《管子·霸言》"},"similar":["锄强扶弱","抑强扶弱"],"usage":"作谓语、定语、宾语；同“抑强扶弱”"},{"id":21683,"word":"按捺不下","pinyin":"àn nà bù xià","abbr":"anbx","explanation":"按捺：抑制，忍耐。无法抑制。","source":{"text":"狄员外虽是求了圣签，又解不出是甚意味，好生按捺不下。","book":"清·西周生《醒世姻缘传》第52回"},"example":{"text":"他～心中的暗喜。"},"similar":["按纳不住"],"opposite":["镇定自若"],"usage":"作谓语；指不能控制情绪"},{"id":21684,"word":"按捺不住","pinyin":"àn nà bù zhù","abbr":"anbz","explanation":"按捺：压抑，忍耐。心里急躁，克制不住。","source":{"text":"今见惜春又说这句，因按捺不住，因问惜春道：‘怎么就带累了你了？……’","book":"清·曹雪芹《红楼梦》第74回"},"example":{"text":"她～喜悦的心情。"},"similar":["按纳不住"],"opposite":["不动声色"],"usage":"作谓语；表示人的复杂情感控制不住"},{"id":21685,"word":"按步就班","pinyin":"àn bù jiù bān","abbr":"abjb","explanation":"按；按照；步：步骤；班：次序。按照一定的条理、步骤做事","source":{"text":"学校却按步就班，没有这弊病。","book":"鲁迅《书信集·致陶亢德》"},"example":{"text":"他习惯于～的生活"},"similar":["按部就班"],"opposite":["勇往直前"],"usage":"作谓语、宾语、定语；指按照老规矩办事"},{"id":21686,"word":"按甲不出","pinyin":"àn jiǎ bù chū","abbr":"ajbc","explanation":"使军队暂不行动，以待时机。同“按甲不动”。","source":{"text":"（源）洧欲退保江陵，颖士说曰：‘襄阳乃天下喉襟，一日不守，则大事去矣……’洧乃按甲不出。","book":"宋·洪迈《容斋随笔·五笔·萧颖士风节》"}},{"id":21687,"word":"按甲不动","pinyin":"àn jiǎ bù dòng","abbr":"ajbd","explanation":"甲：铠甲，古代战士的护身衣，引申为甲士，借指军队。使军队暂不行动，以待时机。","source":{"text":"宝应数挑战，昭达按甲不动。","book":"《陈书·章昭达传》"}},{"id":21688,"word":"按甲休兵","pinyin":"àn jiǎ xiū bīng","abbr":"ajxb","explanation":"收拾起铠甲武器。比喻停止军事行动。","source":{"text":"当今之计，不如按甲休兵，百里之内，牛洒日至，以飨士大夫，北首燕路，然而发一乘之使，奉咫尺之书以使燕，燕必不敢不听。","book":"《汉书·韩信传》"},"example":{"text":"将军可～，退一箭之地。","book":"明·李日华《南西厢记·许婚借援》"},"similar":["按甲寝兵"],"usage":"作谓语；指停战休整"},{"id":21689,"word":"按甲寝兵","pinyin":"àn jiǎ qǐn bīng","abbr":"ajqb","explanation":"收拾起铠甲武器。比喻停止军事行动。","source":{"text":"吴有长江之险，蜀有崇山之阻，难以威服，易以德怀。愚以为可且按甲寝兵，息军养士，定土分封，论功行赏。","book":"晋·司马彪《九州春秋·傅干》"},"example":{"text":"我们希望交战双方～，握手言和。"},"similar":["解甲归田","按甲休兵"],"usage":"作谓语；指停战"},{"id":21690,"word":"按纳不下","pinyin":"àn nà bù xià","abbr":"anbx","explanation":"按纳：抑制，忍耐。无法抑制。多指心里忍耐不住，情绪急躁或忧虑。","source":{"text":"朱仝见了，心头一把无明业火高三千丈，按纳不下。","book":"《水浒全传》第五十一回"}},{"id":21691,"word":"按纳不住","pinyin":"àn nà bù zhù","abbr":"anbz","explanation":"心里急躁，克制不住。","source":{"text":"不想遇着许仙，春心荡漾，按纳不住，一时冒犯天条。","book":"明·冯梦龙《警世通言·白娘子永镇雷峰塔》"},"example":{"text":"他激动得有些～了。"},"similar":["按捺不住"],"usage":"作谓语、状语；表示人的复杂情感控制不住"},{"id":21692,"word":"按行自抑","pinyin":"àn xíng zì yì","abbr":"axzy","explanation":"按：克制。约束自己的行为。","source":{"text":"忽崩赛上下兮，聊按行以自抑。","book":"唐·柳宗元《梦赋》"}},{"id":21693,"word":"按辔徐行","pinyin":"àn pèi xú xíng","abbr":"apxx","explanation":"辔：马缰绳。轻轻按着缰绳，让马慢慢地走。","source":{"text":"壁门士吏谓从属车骑曰：‘将军约，军中不得驱驰。’于是天子乃按辔徐行。","book":"《史记·绛侯周勃世家》"},"example":{"text":"～，鸣以和鸾。","book":"宋·陈亮《复喻谦父》"},"similar":["策马徐行"],"usage":"作谓语；指策马慢行"},{"id":21694,"word":"按迹循踪","pinyin":"àn jì xún zōng","abbr":"ajxz","explanation":"依循一定的线索和踪迹寻求真相。","source":{"text":"其间离合悲欢，兴衰际遇，俱是按迹循踪，不敢稍加穿凿，至失其真。","book":"清·曹雪芹《红楼梦》第一回"}},{"id":21695,"word":"按部就班","pinyin":"àn bù jiù bān","abbr":"abjb","explanation":"部、班：门类，次序；就：归于。按照一定的步骤、顺序进行。也指按老规矩办事，缺乏创新精神。","source":{"text":"然后选义案部，考辞就班。","book":"晋·陆机《文赋》"},"example":{"text":"但黄公俊的祖父，他开始读了书，象一般读书人似的，他～的要将八股型的才学，“货与帝王家”。","book":"郑振铎《黄公俊之最后》"},"similar":["循序渐进","墨守成规"],"opposite":["勇往直前","闻风而动"],"usage":"作谓语、状语、定语；形容按照老规矩办事"},{"id":21696,"word":"按部就队","pinyin":"àn bù jiù duì","abbr":"abjd","explanation":"巡察所辖的部属，归入所属队列。","source":{"text":"白日未移，前驱已届，群师按部，左右就队。","book":"汉·王粲《浮淮赋》"}},{"id":21697,"word":"挑三嫌四","pinyin":"tiāo sān xián sì","abbr":"tsxs","explanation":"指挑挑拣拣，嫌这嫌那。同“挑三拣四”。","source":{"text":"我为你黑间白日的操心，好容易找下这么个媳妇，你还挑三嫌四的。","book":"孔厥《新儿女英雄传》第四回"},"similar":["挑三拣四","挑三检四"],"usage":"作谓语、定语；形容过分地挑剔"},{"id":21698,"word":"挑三拣四","pinyin":"tiāo sān jiǎn sì","abbr":"tsjs","explanation":"指挑挑拣拣，嫌这嫌那。","source":{"text":"他们一旦了解了过去的痛苦，就会懂得今天我们对工作挑三拣四是多幺不对！","book":"徐特立《让革命的红旗世代相传》"},"similar":["挑肥拣瘦","挑三嫌四"],"usage":"作谓语、定语、宾语；形容过分地挑剔"},{"id":21699,"word":"挑三拨四","pinyin":"tiǎo sān bō sì","abbr":"tsbs","explanation":"指挑拨是非。同“挑三豁四”。","source":{"text":"这家伙在挑三拨四，我去闯破她不呢？","book":"周立波《山乡巨变》"},"similar":["挑三豁四","调三窝四","挑三窝四"],"usage":"作谓语、定语、宾语；用于口语"},{"id":21700,"word":"挑三检四","pinyin":"tiāo sān jiǎn sì","abbr":"tsjs","explanation":"指挑挑拣拣，嫌这嫌那。同“挑三拣四”。","source":{"text":"你这孩子，没有你弟弟乖，挑三检四的。","book":"金近《穿花裙的狼》"},"similar":["挑三拣四","挑三嫌四"],"usage":"作谓语、定语；形容过分地挑剔"},{"id":21701,"word":"挑三窝四","pinyin":"tiǎo sān wō sì","abbr":"tsws","explanation":"搬弄是非，挑拔离间。","source":{"text":"那平姑娘又是个正经人，从不会挑三窝四的。","book":"清·曹雪芹《红楼梦》第65回"},"example":{"text":"我不喜欢～的人。"},"similar":["调三窝四"],"usage":"作谓语、定语；指搬弄是非"},{"id":21702,"word":"挑三豁四","pinyin":"tiǎo sān huō sì","abbr":"tshs","explanation":"指挑拨是非。","source":{"text":"我们这个搅家不良，挑三豁四，丈二长的舌头，谁家着的他罢？","book":"清·西周生《醒世姻缘传》第57回"},"similar":["挑三拨四","调三窝四"],"usage":"作谓语、定语、宾语；用于口语"},{"id":21703,"word":"挑么挑六","pinyin":"tiāo yāo tiāo liù","abbr":"tytl","explanation":"挑剔，找差错。"},{"id":21704,"word":"挑唆是非","pinyin":"tiǎo suō shì fēi","abbr":"tssf","explanation":"挑唆：挑逗，引动。搬弄是非，使别人不团结。","source":{"text":"这人姓胡，名福，最爱挑唆是非，说人坏话。","book":"清·李宝嘉《官场现形记》第三十九回"},"example":{"text":"独孤后遂决意废立，屡在隋主面前，～。","book":"蔡东藩《南北史演义》第八十七回"}},{"id":21705,"word":"挑唇料嘴","pinyin":"tiǎo chún liào zuǐ","abbr":"tclz","explanation":"摇动嘴唇。指吵嘴，争吵。同“挑牙料唇”。","source":{"text":"谁与你挑唇料嘴，辨别个谁是谁非。","book":"元·李致远《还牢末》第一折"},"similar":["挑牙料唇"],"usage":"作谓语、宾语、定语；指吵架"},{"id":21706,"word":"挑大梁","pinyin":"tiǎo dà liáng","abbr":"tdl","explanation":"承担关键的任务，承担对全局有主要作用的工作。比喻起骨干作用。","example":{"text":"这个工程我来～。"},"usage":"作谓语、定语；指起骨干作用"},{"id":21707,"word":"挑字眼儿","pinyin":"tiāo zì yǎn ér","abbr":"tzye","explanation":"从措辞用字上找小毛病。","example":{"text":"评论文章不能光～。"},"usage":"作谓语、宾语；指找毛病"},{"id":21708,"word":"挑幺挑六","pinyin":"tiāo yāo tiāo liù","abbr":"tytl","explanation":"幺、六：骰子的点了。挑剔，找差错。","source":{"text":"这一点子小崽子，也挑幺挑六，咸嘴淡舌，咬群的骡子似的。","book":"清·曹雪芹《红楼梦》第五十八回"},"usage":"作谓语、定语；用于书面语"},{"id":21709,"word":"挑得篮里便是菜","pinyin":"tiǎo dé lán lǐ biàn shì cài","abbr":"tdllbsc","explanation":"比喻得到一点就行，毫不挑剔。","source":{"text":"挑得篮里便是菜，一个信送将进去，登时把陈定放了出来。","book":"明·凌濛初《二刻拍案惊奇》第20卷"},"usage":"作分句；指毫不挑剔"},{"id":21710,"word":"挑拨煽惑","pinyin":"tiǎo bō shān huò","abbr":"tbsh","explanation":"搬弄是非，煽动闹事。","source":{"text":"日寇、汉奸、托派之辈，则更利用这些缺点和错误，来进行其挑拨煽惑的阴谋，企图造成民变。","book":"邓小平《动员新兵及新兵政治工作》"},"similar":["挑拨离间"],"usage":"作谓语、宾语、定语；用于挑起事端"},{"id":21711,"word":"挑拨离间","pinyin":"tiǎo bō lí jiàn","abbr":"tblj","explanation":"〖释义〗搬弄是非，使别人不团结。","example":{"text":"～的人，有着不可告人的目的。"},"similar":["挑三豁四","拨弄是非","搬弄是非"],"opposite":["精诚团结","穿针引线"],"usage":"联合式；作谓语；含贬义"},{"id":21712,"word":"挑挑剔剔","pinyin":"tiāo tiāo tī tī","abbr":"tttt","explanation":"仔细而慎重地或显然存心挑剔地挑选。","example":{"text":"我不喜欢～。"},"similar":["挑三拣四"],"usage":"作谓语、宾语、定语；指挑三拣四"},{"id":21713,"word":"挑挑拣拣","pinyin":"tiāo tiāo jiǎn jiǎn","abbr":"ttjj","explanation":"挑：挑选；拣：分拣。指从中仔细挑选。","source":{"text":"在西瓜、桃李、杏枣中间穿行，挑挑拣拣，寻些百姓乐趣，倒也乐而忘忧。","book":"钱宁《圣人》第25章"},"example":{"text":"她～一大堆东西。"},"similar":["挑三拣四"],"usage":"作谓语、宾语；指筛选"},{"id":21714,"word":"挑毛拣刺","pinyin":"tiāo máo jiǎn cì","abbr":"tmjc","explanation":"故意挑剔毛病。","example":{"text":"你别～就算不错了"},"similar":["挑毛剔刺"],"usage":"作谓语、定语；指挑剔"},{"id":21715,"word":"挑灯拨火","pinyin":"tiǎo dēng bō huǒ","abbr":"tdbh","explanation":"搬弄是非。","example":{"text":"那些不怀好意的人更是～。"},"similar":["搬弄是非"],"usage":"作谓语、定语、宾语；指搬弄是非"},{"id":21716,"word":"挑牙料唇","pinyin":"tiǎo yá liào chún","abbr":"tylc","explanation":"摇动嘴唇。指吵嘴，争吵。","source":{"text":"又不是挑牙料唇，只待要寻争觅衅。","book":"元·无名氏《举案齐眉》第二折"},"similar":["挑唇料嘴"],"usage":"作谓语、宾语、定语；指吵架"},{"id":21717,"word":"挑精拣肥","pinyin":"tiāo jīng jiǎn féi","abbr":"tjjf","explanation":"犹挑肥拣瘦。比喻挑挑拣拣，光要对自己有利的。","source":{"text":"姚黄的养母气成了病，老太婆悔不该当初拆散了她许多好姻缘。挑精拣肥，反而落了一场空。","book":"徐迟《牡丹》"},"similar":["挑肥拣瘦"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21718,"word":"挑肥拣瘦","pinyin":"tiāo féi jiǎn shòu","abbr":"tfjs","explanation":"挑、拣：选择；肥：肥肉；瘦：瘦肉。比喻挑挑拣拣，光要对自己有利的。","source":{"text":"象娘这样费心，还不讨他说个是，只是挑精拣肥，我也犯不着要他这个劳。","book":"清·吴敬梓《儒林外史》第二十七回"},"example":{"text":"这和尚必是买十个钱的肉，～。","book":"清·郭小亭《济公全传》第一百二十六回"},"similar":["挑三拣四","拈轻怕重"],"opposite":["先人后己","舍己为人"],"usage":"作谓语、宾语、定语；指挑三拣四"},{"id":21719,"word":"挑茶斡刺","pinyin":"tiāo chá wò cì","abbr":"tcwc","explanation":"指寻事生非。","source":{"text":"非是我挑茶斡刺，则问你李美人生下的孩儿，要说个一卯二，不许你差三错四。","book":"元·无名氏《抱妆盒》第三折"},"similar":["寻是生非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21720,"word":"挑针打眼","pinyin":"tiāo zhēn dǎ yǎn","abbr":"tzdy","explanation":"苛评，带有一定程度的敌意的批评或评论。","example":{"text":"～的批评难以让人接受。"},"similar":["吹毛求疵"],"usage":"作宾语、定语；指尖酸刻薄"},{"id":21721,"word":"挑雪填井","pinyin":"tiāo xuě tián jǐng","abbr":"txtj","explanation":"比喻劳而无功。","source":{"text":"多少痴禅和尚挑雪去填井。","book":"唐·顾况《行路难三首》：“君不见担雪塞井空用力，炊沙作饭岂堪吃。”宋·释正受《嘉泰普灯录》"},"similar":["担雪填井"],"usage":"作谓语、定语；指劳而无功"},{"id":21722,"word":"挖墙脚","pinyin":"wā qiáng jiǎo","abbr":"wqj","explanation":"比喻拆台。","source":{"text":"彼此不挖墙脚，彼此不在对方军政军内组织秘密支部。","book":"毛泽东《统一战线的独立自主问题》"},"example":{"text":"他尽干些～的事。"},"usage":"作谓语、定语、宾语；指拆台"},{"id":21723,"word":"挖墙角","pinyin":"wā qiáng jiǎo","abbr":"wqj","explanation":"比喻破坏对方的基础，拆对方的台。","example":{"text":"彼此不～，彼此不在对方党政军内组织秘密支部。","book":"毛泽东《统一战线中的独立自主问题》"}},{"id":21724,"word":"挖空心思","pinyin":"wā kōng xīn sī","abbr":"wkxs","explanation":"比喻费尽心思，想尽一切办法。","source":{"text":"今此贼挖空心思，用到如许密计，图我安如泰山之郓城。","book":"清·俞万春《荡寇志》第一百二十六回"},"example":{"text":"例如问《十三经》是什么，文天祥是那朝人，全用不着自己来～做，一做，倒糟糕。","book":"鲁迅《花边文学·考场三丑》"},"similar":["搜索枯肠","费尽心机","绞尽脑汁"],"opposite":["无所用心"],"usage":"作谓语、状语；指想尽一切办法"},{"id":21725,"word":"挖耳当招","pinyin":"wā ěr dāng zhāo","abbr":"wedz","explanation":"见别人举手挖耳朵，却误以为是在招呼自己。比喻希望达到目的的心情非常迫切。","source":{"text":"那吴衙内记挂着贺小姐，一夜卧不安稳。早上贺司户相邀，正是挖耳当招。","book":"明·冯梦龙《醒世恒言·吴衙内邻舟赴约》"},"example":{"text":"溜须拍马到了～的地步实在让人发笑。"},"similar":["自作多情"],"usage":"作谓语、定语；指心情非常迫切"},{"id":21726,"word":"挖肉补疮","pinyin":"wā ròu bǔ chuāng","abbr":"wrbc","explanation":"挖下身上的好肉来补伤口。比喻只顾眼前，用有害的方法来救急。","source":{"text":"二月卖新丝，五月粜新谷；医得眼前疮，剜却心头肉。","book":"唐·聂夷中《咏田家》诗"},"example":{"text":"就财政上以论，外债之宜借者，不过为苟安目前，～之计。","book":"清·梁启超《外债平议》"},"similar":["剜肉补疮"],"usage":"作谓语、宾语、定语；指用有害的方法来救急"},{"id":21727,"word":"挝耳挠腮","pinyin":"zhuā ěr náo sāi","abbr":"wens","explanation":"挝：敲击。敲敲耳朵，挠挠脸颊。形容非常窘迫的样子。","source":{"text":"那李瓶儿挝耳挠腮，一头撞在地下，哭的昏过去半日，方才苏省。","book":"明·兰陵笑笑生《金瓶梅词话》第五十九回"},"example":{"text":"这个猪八戒的科诨排场，言语挑逗，故作～之状。（清·李绿园《歧路灯》第十回）"},"similar":["挝耳揉腮","抓耳挠腮"],"usage":"作谓语、定语、状语；指人的窘态"},{"id":21728,"word":"挝耳揉腮","pinyin":"zhuā ěr róu sāi","abbr":"wers","explanation":"挝：敲击；揉：来回擦或搓。抓抓耳朵，搓搓脸颊。形容窘迫的样子。","source":{"text":"挝耳揉腮，羞答答的半晌怎把头抬。","book":"元·无名氏《女姑姑》第二折"},"similar":["挝耳挠腮"],"usage":"作谓语、定语、状语；指人的窘态"},{"id":21729,"word":"挟主行令","pinyin":"jiā zhǔ xíng lìng","abbr":"jzxl","explanation":"挟持君主，发布命令。同“挟天子以令诸侯”。"},{"id":21730,"word":"挟人捉将","pinyin":"xié rén zhuō jiàng","abbr":"xrzj","explanation":"挟：制服。在战斗中能制服、活捉敌将。","source":{"text":"挟人捉将千般勇，武艺精熟敢战争。","book":"元·李文蔚《蒋神灵应》楔子"},"similar":["捉将挟人"],"usage":"作谓语、定语；用于作战等"},{"id":21731,"word":"挟冤记仇","pinyin":"xié yuān jì chóu","abbr":"xyjc","explanation":"把冤仇记在心上。","source":{"text":"倘若挟冤记仇，须贾，你觑者，俺这里雄兵百万，战将千员，有一日兵临城下，将至濠边，四下里安环，八下里拽炮，人平了你宅舍，马践了你庭堂。","book":"元·高文秀《谇范叔》第一折"}},{"id":21732,"word":"挟冰求温","pinyin":"xié bīng qiú wēn","abbr":"xbqw","explanation":"夹着冰块以求温暖。比喻行动与目的相违背，必然徒劳无功。","source":{"text":"信不足焉而祈物之必附，猜生于我而望彼之必怀，何异挟冰求温，抱炭希凉者哉？","book":"《三国志·魏志·高柔传》裴松之注引孙盛曰"},"usage":"作宾语、定语；用于比喻句"},{"id":21733,"word":"挟冰求温，抱炭希凉","pinyin":"xié bīng qiú wēn，bào tàn xī liáng","abbr":"xbqwbtxl","explanation":"夹着冰块以求温暖，抱着火炭希望能凉快。比喻行动与目的相违背，必然徒劳无功。","source":{"text":"信不足焉而祈物之必附，猜生于我而望彼之必怀，何异挟冰求温，抱炭希凉者哉？","book":"《三国志·魏志·高柔传》裴松之注引孙盛曰"}},{"id":21734,"word":"挟势弄权","pinyin":"xié shì nòng quán","abbr":"jsnq","explanation":"倚仗势力，玩弄权术。","source":{"text":"掌科给事中吴麟徵、掌道御史祁彪佳劾昌时挟势弄权，延儒颇不自安。","book":"《明史·奸臣传·吴昌时》"},"example":{"text":"况且弟兄姊妹，～，罪恶滔天，总皆由我，如何忏悔得尽！","book":"清·洪昇《长生殿·情悔》"},"usage":"作谓语、宾语、定语；用于处事等"},{"id":21735,"word":"挟天子令诸侯","pinyin":"xié tiān zǐ lìng zhū hóu","abbr":"xtzlzh","explanation":"挟：挟制；诸侯：帝王分封的列国统治者。挟制着皇帝，用其名义号令诸侯。比喻借用名义按自己的意思去指挥别人。","source":{"text":"此言岂不羞乎？天下岂不知你挟天子令诸侯？","book":"明·罗贯中《三国演义》第61回"},"similar":["挟天子而令诸侯","挟天子以令天下"],"usage":"作谓语、定语、宾语；指政治要挟"},{"id":21736,"word":"挟天子以令天下","pinyin":"xié tiān zǐ yǐ lìng tiān xià","abbr":"xtzyltx","explanation":"挟制着皇帝，用皇帝的名义发号施令。现比喻用领导的名义按自己的意思去指挥别人。同“挟天子以令诸侯”。","source":{"text":"据九鼎，按图籍，挟天子以令天下，天下莫敢不从。","book":"西汉·刘向《战国策·秦策》"},"similar":["挟天子以令诸侯","挟天子令诸侯"],"usage":"作谓语、定语、宾语；指政治要挟"},{"id":21737,"word":"挟天子以令诸侯","pinyin":"xié tiān zǐ yǐ lìng zhū hóu","abbr":"xtzylzh","explanation":"挟制着皇帝，用皇帝的名义发号施令。现比喻用领导的名义按自己的意思去指挥别人。","source":{"text":"今州城粗定，兵强士附，西迎大驾，即宫邺都，挟天子以令诸侯，蓄士马以讨不庭，谁能御之？","book":"《后汉书·袁绍传》"},"example":{"text":"朕命白虎驮邱生来，原恶其自矜汉学，凌蔑百家，～，故有投畀豺虎之意。","book":"清·袁枚《续子不语·麒麟喊冤》"},"similar":["挟天子以令天下"],"usage":"作谓语、定语、宾语；指政治要挟","story":["东汉末年，汉室日益衰弱，董卓废汉少帝刘辩立献帝刘协。曹操将献帝迎至许昌，并以皇帝的名义号令诸侯。刘备三顾茅庐请出诸葛亮，对付挟天子以令诸侯的曹操，刘备对诸葛亮言听计从，联合东吴抵制曹操"]},{"id":21738,"word":"挟天子以征四方","pinyin":"xié tiān zǐ yǐ zhēng sì fāng","abbr":"xtzyzsf","explanation":"挟：挟制。挟制皇帝，用朝廷的名来征讨四方。","source":{"text":"曹公，豺虎也，挟天子以征四方，动以朝廷为辞，今日拒之，事更不顺。","book":"宋·司马光《资治通鉴》"},"usage":"作谓语、定语；用于书面语"},{"id":21739,"word":"挟天子而令诸侯","pinyin":"xié tiān zǐ ér lìng zhū hóu","abbr":"xtzelzh","explanation":"挟：挟制；诸侯：帝王分封的列国统治者。挟制着皇帝，用其名义号令诸侯。比喻借用名义按自己的意思去指挥别人。","source":{"text":"今州城粗定，兵强士附，西迎大驾，即宫邺都，挟天子而令诸侯，蓄士马以讨后庭，谁能御之？","book":"南朝·宋·范晔《后汉书·袁绍传》"},"example":{"text":"慨魏武之雄图，终大济于横流，用兵戈以临四海，～。","book":"唐·高适《东征赋》"},"similar":["挟天子令诸侯","挟天子以令诸侯"],"usage":"作谓语、定语、宾语；指政治要挟"},{"id":21740,"word":"挟山超海","pinyin":"xié shān chāo hǎi","abbr":"xsch","explanation":"挟：挟持，夹着；刱：超越，跨过。夹着泰山跨越北海。比喻做绝对办不到的事。","source":{"text":"挟太山以超北海，语人曰：‘我不能，’是诚不能也。","book":"《孟子·梁惠王上》"},"example":{"text":"于此人也，而欲望以拿云之手段，回天之事功，～之意气，能乎不能？","book":"清·梁启超《少年中国说》"},"similar":["天方夜谭"],"usage":"作谓语、定语；指做绝对办不到的事"},{"id":21741,"word":"挟朋树党","pinyin":"xié péng shù dǎng","abbr":"xpsd","explanation":"朋：指互相勾结的同类人。依仗同朋，树立党派。","source":{"text":"外无逼主之嫌，内有专用之功，势倾天下，未之或悟，挟朋树党，政以贿成。","book":"南朝·梁·沈约《恩幸传论》"},"example":{"text":"《梁书·武帝纪论》：“然朱异之徒，作威作福，～，政以贿成。”"},"usage":"作谓语、宾语；用于处事等"},{"id":21742,"word":"挟权倚势","pinyin":"xié quán yǐ shì","abbr":"xqys","explanation":"凭借和倚仗权势。","source":{"text":"他本是个君子人则待挟权倚势，吹一吹登时教人烟灭飞灰。","book":"元·孔文卿《东窗事犯》第二折"},"usage":"作谓语、定语；用于处事等"},{"id":21743,"word":"挟泰山以超北海","pinyin":"xié tài shān yǐ chāo běi hǎi","abbr":"xtsycbh","explanation":"挟：挟持，夹着；刱：超越，跨过。夹着泰山跨越北海。比喻做绝对办不到的事。","source":{"text":"挟太山以超北海，语人曰：‘我不能，’是诚不能也。","book":"《孟子·梁惠王上》"},"usage":"作谓语、定语；用于书面语"},{"id":21744,"word":"挟筴读书","pinyin":"xié cè dú shū","abbr":"xcds","explanation":"挟：夹持；筴：同“策”，指简册，书籍。手拿书籍，一心读书。形容勤奋学习。","source":{"text":"臧与榖二人相与牧羊，而俱亡其羊。问臧奚事？则挟筴读书；问榖奚事？则博塞以游。","book":"《庄子·骈拇》"},"usage":"作谓语、定语；用于学习等"},{"id":21745,"word":"挟细拿粗","pinyin":"xié xì ná cū","abbr":"xxnc","explanation":"挟：挟制；拿：刁难。比喻寻事生非；挑剔冒犯。","source":{"text":"倚仗着恶党凶徒，害良民肆生淫欲，谁敢向他行挟细拿粗，逞刁顽全不想他妻我妇。","book":"元·关汉卿《鲁斋郎》第三折"},"usage":"作谓语、宾语；用于口语"},{"id":21746,"word":"挟贵倚势","pinyin":"xié guì yǐ shì","abbr":"xgys","explanation":"凭借和倚仗权势。","source":{"text":"他本是个君子人则待挟权倚势，吹一吹登时教人烟灭飞灰。","book":"元·孔文卿《东窗事犯》第二折"},"example":{"text":"端邸～，盛气凌人，汉大臣中，稍有才具者，必遭忌克。","book":"清·陈夔龙《梦蕉亭杂记》卷一"},"usage":"作谓语、定语；用于处事"},{"id":21747,"word":"挟长挟贵","pinyin":"xié zhǎng xié guì","abbr":"xzxg","explanation":"挟：倚仗。倚仗着自己年长和地位高。","source":{"text":"不挟长，不挟贵，不挟兄弟而友。","book":"《孟子·万章下》"},"usage":"作谓语、定语；用于处事"},{"id":21748,"word":"挠喉捩嗓","pinyin":"náo hóu liè sǎng","abbr":"nhls","explanation":"指违腔走调，不合声律。","source":{"text":"欲度新声休走样，忌的是挠喉捩嗓。","book":"明江廷讷《广陵月》第二出"},"usage":"作宾语；指走调"},{"id":21749,"word":"挠曲枉直","pinyin":"náo qū wǎng zhí","abbr":"nqwz","explanation":"指矫正曲直。","source":{"text":"俗非唐虞之时，而世非许由之民，而欲废法以治，是犹不用隐括斧斤欲挠曲枉直也。","book":"汉桓宽《盐铁论·大论》"},"usage":"作谓语；指矫正曲直"},{"id":21750,"word":"挠直为曲","pinyin":"náo zhí wéi qū","abbr":"nzwq","explanation":"将直的拗成弯的。比喻变刚强正直为阿世取容。","source":{"text":"挠直为曲，斫方为圆；秽素丝之洁，推亮直之心。","book":"汉荀悦《汉纪·成帝纪二》"},"example":{"text":"遂使世人削方为圆，～。","book":"晋熊远《因灾异上疏》"},"usage":"作谓语、定语；用于比喻句"},{"id":21751,"word":"挠腮撧耳","pinyin":"náo sāi juē ěr","abbr":"nsje","explanation":"抓搔腮颊，揪扯耳朵。形容慌乱焦急。","source":{"text":"我这里急忙忙过六街三市，行行里挠腮撧耳，抹泪揉眵。","book":"元关汉聊《蝴蝶梦》第一折"},"similar":["撧耳挠腮"],"usage":"作宾语、状语；指慌乱焦急"},{"id":21752,"word":"挡箭牌","pinyin":"dǎng jiàn pái","abbr":"djp","explanation":"古代可以抵挡刀箭用的盾牌。比喻推掉事情的借口或可你掩护的东西。","source":{"text":"好在有了这块挡箭牌，诸事无碍，宽心一放。","book":"高阳《胡雪岩全传·平步青云》中册"},"usage":"作宾语、定语；多用于比喻句"},{"id":21753,"word":"挢抂过正","pinyin":"jiǎo kuāng guò zhèng","abbr":"jkgz","explanation":"矫枉过正。指纠正偏差而超过必要的限度。"},{"id":21754,"word":"挢揉造作","pinyin":"jiǎo róu zào zuò","abbr":"jrzz","explanation":"矫揉造作。指过分做作，极不自然。","source":{"text":"按如此教小儿，可谓挢揉造作矣。","book":"清·俞樾《茶香室丛钞·饶州神童》"},"similar":["矫揉造作"],"usage":"作谓语、定语、宾语、状语；指故意做作"},{"id":21755,"word":"挢枉过正","pinyin":"jiǎo wǎng guò zhèng","abbr":"jwgz","explanation":"指纠正偏差而超过必要的限度。","source":{"text":"而藩国大者夸州兼郡，连城数十，宫室百官同制京师，可谓挢往过其正矣。","book":"东汉·班固《汉书·诸侯王表序》"},"similar":["矫枉过正"],"usage":"作谓语、宾语；同“矫枉过正”"},{"id":21756,"word":"挤手捏脚","pinyin":"jǐ shǒ niē jiǎo","abbr":"jsnj","explanation":"故意伸出手脚碰触对方身体，含有轻薄之意。","source":{"text":"每日在路，俱有人瞧着锦囊，挨肩擦背，挤手捏脚。","book":"清·夏敬渠《野叟曝言》第六十五回"}},{"id":21757,"word":"挤挤插插","pinyin":"jǐ jǐ chā chā","abbr":"jjcc","explanation":"物多人多，十分拥挤。","example":{"text":"院子里～住满了灾民。"},"usage":"作定语、状语；用于方言"},{"id":21758,"word":"挤牙膏","pinyin":"jǐ yá gāo","abbr":"jyg","explanation":"比喻不肯主动地谈问题，挤一点说一点。","example":{"text":"要从他嘴里得到消息就得用～的办法。"},"usage":"作宾语、定语；用于口语"},{"id":21759,"word":"挤眉弄眼","pinyin":"jǐ méi nòng yǎn","abbr":"jmny","explanation":"用眼睛、眉毛示意。","source":{"text":"挤眉弄眼，伶齿俐牙，攀高接贵，顺水推船。","book":"元·王实甫《破窑记》第一折"},"example":{"text":"不料偏又有几个滑贼看出形景来，都背后～，或是咳嗽扬声。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["指手划脚","眉来眼去","挤眉溜眼"],"usage":"作谓语、状语；指用眉眼传情与示意"},{"id":21760,"word":"挤眉溜眼","pinyin":"jǐ méi liū yǎn","abbr":"jmly","explanation":"用眼睛、眉毛示意。同“挤眉弄眼”。","source":{"text":"遇着不老实的妇人，和他挤眉溜眼，调顺私情。","book":"明·冯惟敏《僧尼共犯》第一折"},"example":{"text":"别老跟我～的。"},"similar":["挤眉弄眼"],"usage":"作谓语、状语；指用眉眼传情与示意"},{"id":21761,"word":"挥剑成河","pinyin":"huī jīn chéng hé","abbr":"hjch","explanation":"将宝剑一挥，就变出一条河。形容法术高明，神通广大，实力雄厚。","source":{"text":"为上将者，挥剑成河，撒豆成兵。","book":"元·无名氏《庞掠四郡》第二折"},"usage":"作谓语、宾语、定语；用于神话"},{"id":21762,"word":"挥戈反日","pinyin":"huī gē fǎn rì","abbr":"hgfr","explanation":"挥舞兵器，赶回太阳。比喻排除困难，扭转危局。","source":{"text":"鲁阳公与韩构难，战酣日暮，援戈而伪（挥）之，日为之反三舍。","book":"《淮南子·览冥训》"},"example":{"text":"不过说到开国会，定宪法，都是些扶墙摸壁的政治，没有一个～的奇才。","book":"清·曾朴《孽海花》第二十九回"},"similar":["挥戈回日","挥戈返日","挥戈退日"],"usage":"作谓语、宾语、定语；指人有雄才大略","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":21763,"word":"挥戈回日","pinyin":"huī gē huí rì","abbr":"hghr","explanation":"挥舞兵器，赶回太阳。形容力挽危局。","source":{"text":"鲁阳公与韩构难，战酣，日暮，援戈而挥之，日为之反三舍。","book":"西汉·刘安《淮南子·览冥训》"},"example":{"text":"却羡鲁阳功德盛，～至今传。","book":"明·刘基《次韵和石抹公悲红树》"},"similar":["挥戈退日"],"usage":"作谓语、定语；比喻排除困难，扭转危局","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":21764,"word":"挥戈返日","pinyin":"huī gē fǎn rì","abbr":"hgfr","explanation":"将戈一挥，可以使西下的太阳回转过来。①比喻留连光景，希望白天能够延长。②后常用以形容有能够排除困难，扭转危局的雄才大略。","source":{"text":"鲁阳公与韩构难，战酣，日暮，援戈而挥之，日为之反三舍。","book":"《淮南子·览冥训》"},"example":{"text":"向天道：“鲁阳尚能～光武尚且坚冰渡河，我独不能乎？”","book":"明·徐渭《续英烈传》第十八回"},"similar":["挥戈退日","挥戈反日","挥戈回日"],"usage":"作谓语、宾语、定语；指人有雄才大略"},{"id":21765,"word":"挥戈退日","pinyin":"huī gē tuì rì","abbr":"hgtr","explanation":"挥舞兵器，赶回太阳。形容力挽危局。同“挥戈反日”。","source":{"text":"自信挥戈能退日，河山依旧战旗红。","book":"朱德《赠友人》诗"},"similar":["挥戈返日","挥戈反日","挥戈回日"],"usage":"作谓语、宾语、定语；指人有雄才大略"},{"id":21766,"word":"挥拳掳袖","pinyin":"huī quán lǔ xiù","abbr":"hqlx","explanation":"形容动怒，准备打人或人的劲头足。","source":{"text":"挥拳掳袖的才要说他那个主意，忽然又道：‘你等等儿。’","book":"清·文康《儿女英雄传》第40回"},"similar":["摩拳擦掌"],"usage":"作谓语、定语、状语；指准备动武"},{"id":21767,"word":"挥斥八极","pinyin":"huī chì bā jí","abbr":"hcbj","explanation":"挥斥：奔放；八极：八方，极远之处。形容人的气概非凡，能力巨大。","source":{"text":"夫至人者，上窥青天，下潜黄泉，挥斥八极，神气不变。","book":"《庄子·田子方》"},"similar":["麾斥八极"],"usage":"作谓语、定语；指人的气概"},{"id":21768,"word":"挥日阳戈","pinyin":"huī rì yáng gē","abbr":"hryg","explanation":"犹言挥戈反日。挥舞兵器，赶回太阳。形容力挽危局。","source":{"text":"总然借挥日阳戈，难挽西飞箭。","book":"明·张景《飞丸记·盟寻泉石》"},"similar":["挥戈反日","挥戈退日","挥戈回日"],"usage":"作谓语、宾语、定语；指人有雄才大略"},{"id":21769,"word":"挥毫命楮","pinyin":"huī háo mìng chǔ","abbr":"hhmc","explanation":"毫：毛笔；命：使用；楮：木名，可造纸，借指纸。指开始写作。","source":{"text":"方且挥毫命楮，恣意著述，每一篇成，跳跃大呼，若狂若颠。","book":"明·袁宏道《瓶花斋集·答王百谷》"},"usage":"作谓语、定语；指写作"},{"id":21770,"word":"挥毫落纸","pinyin":"huī háo luò zhǐ","abbr":"hhlz","explanation":"毫：毛笔。指写字或作画。","source":{"text":"挥毫落纸如云烟。","book":"唐·杜甫《饮中八仙歌》"},"usage":"作谓语；指写字或作画"},{"id":21771,"word":"挥汗如雨","pinyin":"huī hàn rú yǔ","abbr":"hhry","explanation":"挥：洒，泼。形容天热出汗多。","source":{"text":"连衽成帷，举袂成幕，挥汗成雨。","book":"《战国策·齐策一》"},"example":{"text":"其人伏地惕息，～，自是怏怏如胅。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录五》"},"similar":["挥汗成雨","汗流浃背"],"usage":"作谓语、定语、状语；形容劳累或热得出汗多","story":["战国时期，说客苏秦到齐国游说齐宣王联合抗秦，他说道：“临淄有7万户人家，每家可以出了3个男人当兵，地方很富足，街上人很多，众人把衣袖举起来像帐幕，每人挥一把汗，简直像下雨一样，有这样的实力难道还要屈服于秦国？”"]},{"id":21772,"word":"挥汗成雨","pinyin":"huī hàn chéng yǔ","abbr":"hhcy","explanation":"挥：洒，泼。用手抹汗，汗洒下去就跟下雨一样。形容人多。","source":{"text":"连衽成帷，举袂成幕，挥汗成雨。","book":"《战国策·齐策一》"},"example":{"text":"正是摩肩如云，～的时候，烦渴的了不得。","book":"清·曾朴《孽海花》第十回"},"similar":["挥汗如雨"],"usage":"作谓语、定语；形容人多","story":["战国时期，说客苏秦到齐国游说齐宣王联合抗秦，他说道：“临淄有7万户人家，每家可以出了3个男人当兵，地方很富足，街上人很多，众人把衣袖举起来像帐幕，每人挥一把汗，简直像下雨一样，有这样的实力难道还要屈服于秦国？”"]},{"id":21773,"word":"挥沐吐餐","pinyin":"huī mù tǔ cān","abbr":"hmtc","explanation":"指礼贤下士。","source":{"text":"昔周公旦，父文兄武，九命作伯，以尹华夏，犹挥沐吐餐，垂接白屋，故周道以隆，天下归德。","book":"《后汉书·文苑传下·高彪》"},"example":{"text":"南朝·宋·范晔《后汉书·文苑传·高彪》：“昔周公旦，父文兄武，九命作伯，以尹华夏，犹～，垂接白屋，故周道以隆，天下归德。”"},"similar":["握发吐哺","吐哺握发"],"usage":"作宾语、定语；用于处事","story":["西周时期，周成王继承父亲的遗志，分封诸侯，他封伯禽为鲁侯，周公向兄弟伯禽祝贺，说：“你以前是鲁国的有名能士，你到任后不要忘记你是周文王的儿子，周武王的弟弟，现今成王的叔叔。你要一沐三握发，一饭三吐哺，爱惜人才。”"]},{"id":21774,"word":"挥洒自如","pinyin":"huī sǎ zì rú","abbr":"hszr","explanation":"挥：挥笔；酒：洒墨。形容画画、写字、作文，运笔能随心所欲。","source":{"text":"兴来洒素壁，挥笔如流星。","book":"唐·李颀《赠张旭》"},"example":{"text":"家人送上一枝蘸满墨水的笔。珏斋提笔，在纸上～的写了一百多字。","book":"清·曾朴《孽海花》第二十五回"},"similar":["运用自如","得心应手","心手相应"],"opposite":["东扶西倒","捉襟见肘"],"usage":"作谓语、定语；指画画、写字、作文"},{"id":21775,"word":"挥涕增河","pinyin":"huī tì zēng hé","abbr":"htzh","explanation":"抹下来的眼泪可以增添河水的分量。比喻行为对个人有损而对国家也无所补益。","source":{"text":"愚诚以挥涕增河，鼷鼠饮海，于朝万无损益，于臣家计甚有废损。","book":"三国·魏·曹植《谏取诸国士息表》"}},{"id":21776,"word":"挥翰临池","pinyin":"huī hàn lín chí","abbr":"hhlc","explanation":"翰：鸟羽，借指毛笔；临池：指写字。指运笔写字。","source":{"text":"晋·代卫恒《四体书势》谓东汉的张芝“临池学书，池水尽黑”。"},"example":{"text":"～，自然让龚和甫独步。","book":"清·曾朴《孽海花》第五回"},"similar":["临池学书"],"usage":"作谓语；指运笔写字"},{"id":21777,"word":"挥翰成风","pinyin":"huī hàn chéng fēng","abbr":"hhcf","explanation":"翰：鸟毛，借指毛笔。握笔写字，腕下生风。形容写字作画极快速和熟练。","source":{"text":"终日价挥翰成风，泼墨如雨，给不尽好事之求。","book":"清·李渔《意中缘·名逋》"},"usage":"作谓语、定语；用于写作等"},{"id":21778,"word":"挥袂生风","pinyin":"huī mèi shēng fēng","abbr":"hmsf","explanation":"袂：衣袖；挥袂：拂袖。挥动衣袖，平地生风。形容意气豪迈。","source":{"text":"挥袂则九野生风，慷慨则气成虹霓。","book":"三国·魏·曹植《七启》"}},{"id":21779,"word":"挥金如土","pinyin":"huī jīn rú tǔ","abbr":"hjrt","explanation":"挥：散。把钱财当成泥土一样挥霍。形容极端挥霍浪费。","source":{"text":"挥金如土，视官爵如等闲。","book":"宋·周密《齐东野语》卷二"},"example":{"text":"无奈彼时心高气傲，～，直把钱财看得不当东西。","book":"清·李宝嘉《官场现形记》第三十回"},"similar":["挥霍无度","穷奢极侈"],"opposite":["省吃俭用","节衣缩食","一毛不拔"],"usage":"作谓语、定语；指奢侈浪费"},{"id":21780,"word":"挥霍无度","pinyin":"huī huò wú dù","abbr":"hhwd","explanation":"挥霍：摇手称挥，反手称攉，意即动作敏捷，引伸为用钱没有节制；无度：没有限度。指滥用金钱，没有节制。","source":{"text":"因为儿子豹英一向挥霍无度，不敢交与他。","book":"清·吴趼人《二十年目睹之怪现状》第102回"},"example":{"text":"商纣王花天酒地、～，终被周武王所灭。"},"similar":["挥金如土"],"opposite":["节衣缩食","克勤克俭"],"usage":"作谓语、定语；指没有节制地浪费"},{"id":21781,"word":"挥霍谈笑","pinyin":"huī huò tán xiào","abbr":"hhtx","explanation":"挥霍：洒脱，无拘束。无拘无束，谈笑自如。","source":{"text":"那僧癞头跣足，那道跛足蓬头，疯疯癫癫，挥霍谈笑而至。","book":"清·曹雪芹《红楼梦》第一回"}},{"id":21782,"word":"挦毛捣鬓","pinyin":"tún máo dǎo bìn","abbr":"xmdb","explanation":"扯头发，打耳光。形容凶悍。","source":{"text":"他从问了出去，只到了大门外边，就要将人挦毛捣鬓，百般辱骂。","book":"清·西周生《醒世姻缘传》第三十五回"},"usage":"作谓语、定语；用于书面语"},{"id":21783,"word":"挦章扯句","pinyin":"xián zhāng chě jù","abbr":"xzcj","explanation":"寻求、摘取某些片断词句。","source":{"text":"挦章扯句……是又不知古人模拟之法。","book":"清·蒋湘南《与田叔子论古文第二书》"},"similar":["寻章摘句"],"usage":"作宾语、定语、谓语；同“寻章摘句”"},{"id":21784,"word":"挦章撦句","pinyin":"lóng zhāng zōng jù","abbr":"xzcj","explanation":"犹寻章摘句。搜求、摘取片断辞句。"},{"id":21785,"word":"挦绵扯絮","pinyin":"chán mián chě xù","abbr":"xmcx","explanation":"形容下大雪。","source":{"text":"恰便似粉妆成殿阁楼台，有如那挦绵扯絮随风洒。","book":"元·无名氏《渔樵记》第二折"},"example":{"text":"明·兰陵笑笑生《金瓶梅词话》第21回：“那雪如～，乱舞梨花。”"},"usage":"作宾语、定语；用于书面语"},{"id":21786,"word":"挨三顶五","pinyin":"āi sān dǐng wǔ","abbr":"asdw","explanation":"形容人多，连接不断。","source":{"text":"众人挨三顶四，簇拥将来，一个个伸出手来，求太医看脉。","book":"明·罗贯中《平妖传》"},"example":{"text":"但见红尘滚滚，车马纷纷，许多商贩客人驮着货物，～的进店安歇。","book":"明·冯梦龙《古今小说》卷五"},"similar":["捱三顶四"],"usage":"作定语；形容人多"},{"id":21787,"word":"挨三顶四","pinyin":"āi sān dǐng sì","abbr":"asds","explanation":"形容人多，连接不断。同“挨三顶五”。","source":{"text":"众人挨三顶四，簇拥将来，一个个伸出手来，求太医看脉。","book":"明·冯梦龙《平妖传》"}},{"id":21788,"word":"挨冻受饥","pinyin":"ái dòng shòu jī","abbr":"adsj","explanation":"挨：遭受。指缺衣少食的穷困状况","source":{"text":"弟子自知根行浅薄，所以冒危历险挨冻受饥求拜师尊，冀求脱胎换骨入圣超凡。","book":"清·无垢道人《八仙全传》第19回"},"similar":["挨冻受饿","饥寒交迫"],"opposite":["丰衣足食"],"usage":"作谓语、宾语、定语；指生活贫困"},{"id":21789,"word":"挨冻受饿","pinyin":"ái dòng shòu è","abbr":"adse","explanation":"指无衣无食的穷困境况。","source":{"text":"妈妈这一辈子想来还不至挨冻受饿。","book":"清·曹雪芹《红楼梦》第一百回"},"example":{"text":"对～忍苦的人民空谈道德的标准，这是奢侈，这是不道德的行为，因为这里面没有同情，没有爱。","book":"《巴金传·桂林笔战》"},"similar":["忍饥挨饿","挨饿受冻","挨冻受饥"],"opposite":["丰衣足食"],"usage":"作谓语、宾语、定语；指生活贫困"},{"id":21790,"word":"挨家按户","pinyin":"āi jiā àn hù","abbr":"ajah","explanation":"挨：依次，顺次。一家一户，户户不漏。","source":{"text":"自从他作了副里长，随着白巡长挨家按户地收铜铁，他的美誉便降落了许多。","book":"老舍《四世同堂》"},"example":{"text":"她～地发送传单。"},"similar":["挨家挨户","挨门逐户"],"usage":"作状语、定语；形容不漏掉一户"},{"id":21791,"word":"挨家挨户","pinyin":"āi jiā āi hù","abbr":"ajah","explanation":"每家每户，户户不漏。挨，依次，顺次。","source":{"text":"自从他作了副里长，随着白巡长挨家按户地收铜铁，他的美誉便降落了许多。","book":"老舍《四世同堂》"},"example":{"text":"居委会的同志们正在～地发送灭鼠药。"},"similar":["挨家逐户","挨门挨户","挨门逐户"],"opposite":["茫无头绪"],"usage":"作状语、定语；形容不漏掉一户"},{"id":21792,"word":"挨山塞海","pinyin":"āi shān sè hǎi","abbr":"assh","explanation":"形容人极多而拥挤不堪。","source":{"text":"那日观看的人，何止挨山塞海。","book":"明·凌濛初《初刻拍案惊奇》卷十七"},"similar":["人山人海"],"usage":"作定语、状语；形容人多拥挤"},{"id":21793,"word":"挨打受气","pinyin":"ái dǎ shòu qì","abbr":"adsq","explanation":"挨：遭受。受人打骂与虐待。","source":{"text":"洋车夫的命当如此，就如同一条狗必定挨打受气，连小孩子也会无缘无故的打他两棍子。","book":"老舍《骆驼祥子》"},"example":{"text":"老舍《骆驼祥子》：“洋车夫的命当如此，就如同一条狗必定挨打受气，连小孩子也会无缘无故的打他两棍子。”"},"similar":["挨打受骂"],"usage":"作谓语、定语、宾语；指受虐待"},{"id":21794,"word":"挨打受骂","pinyin":"ái dǎ shòu mà","abbr":"adsm","explanation":"受人打骂。指遭受虐待。","source":{"text":"我们这些奴才白陪着挨打受骂的。","book":"清·曹雪芹《红楼梦》第九回"},"example":{"text":"她在婆家经常～。"},"similar":["挨打受气"],"usage":"作谓语、定语、宾语；指受虐待"},{"id":21795,"word":"挨肩叠背","pinyin":"āi jiān dié bèi","abbr":"ajdb","explanation":"形容人群拥挤。","source":{"text":"当日看的是挨肩叠背。","book":"明·冯梦龙《醒世恒言·勘皮靴单证二郎神》"},"example":{"text":"人们～、鱼贯而入地进入火车站大厅。"},"similar":["挨肩擦背","挨肩擦膀"],"opposite":["地广人稀"],"usage":"作谓语、定语；形容人群十分拥挤的场面"},{"id":21796,"word":"挨肩叠足","pinyin":"āi jiān dié zú","abbr":"ajdz","explanation":"肩挨肩，脚碰脚。形容十分拥挤。","source":{"text":"行路之人皆得以挨肩叠足。","book":"宋·陈亮《甲辰秋答朱元晦书》"}},{"id":21797,"word":"挨肩并足","pinyin":"āi jiān bìng zú","abbr":"ajbz","explanation":"形容人群拥挤。","source":{"text":"那山中远近人家，都晓得高家新女婿才貌双全，竞来观看，挨肩并足，如看神会故事的一般热闹。","book":"明·冯梦龙《醒世恒言·钱秀才错占凤凰俦》"},"example":{"text":"操场上，同志们～地坐在一起看电影。"},"similar":["挨肩擦背","挨肩叠背"],"usage":"作谓语、定语、状语；形容人多拥挤"},{"id":21798,"word":"挨肩搭背","pinyin":"āi jiān dā bèi","abbr":"ajdb","explanation":"挨肩：肩和肩相靠。搭背：手搭在别人背上。形容极其亲昵的样子。","source":{"text":"小玉凤见是警察局的大人到了，连忙抛了各客，溜进房间里来，与袁伯珍挨肩搭背的坐在一块儿。","book":"《官场维新记》第九回"},"example":{"text":"看她俩挨肩搭背的样子，就知道是一对好朋友。"},"similar":["勾肩搭背"],"usage":"作谓语、定语、状语；形容关系亲密"},{"id":21799,"word":"挨肩擦背","pinyin":"āi jiān cā bèi","abbr":"ajcb","explanation":"肩挨肩，背擦背。形容人多拥挤。","source":{"text":"常常走到厨房下，挨肩擦背，调嘴弄舌。","book":"明·冯梦龙《醒世恒言》第三十四卷"},"example":{"text":"引惹得那楼下看灯的人，～，仰望上瞧。","book":"明·兰陵笑笑生《金瓶梅词话》第十五回"},"similar":["挨肩擦膀","挨肩迭背","压肩叠背"],"opposite":["敬而远之","地广人稀"],"usage":"作谓语、定语；形容人群十分拥挤的场面"},{"id":21800,"word":"挨肩擦脸","pinyin":"āi jiān cā liǎn","abbr":"ajcl","explanation":"挨：靠近。擦，接触。形容狎昵之状。","source":{"text":"贾珍便和三姐挨肩擦脸，百般轻薄起来。","book":"《脂砚斋重评石头记》六五回"},"similar":["挨肩搭背"],"usage":"作谓语；指狎昵的样子"},{"id":21801,"word":"挨肩擦膀","pinyin":"āi jiān cā bǎng","abbr":"ajcb","explanation":"指身体相贴近。也形容人群拥挤。","source":{"text":"你怎么偏要挨肩擦膀的，舒着手往我怀里摸甚么？","book":"元·刘君锡《来生债》第一折"},"example":{"text":"那两边围看的，～，不知其数。","book":"明·兰陵笑笑生《金瓶梅词话》第四二回"},"similar":["挨肩擦背"],"opposite":["地广人稀"],"usage":"作谓语、定语；形容人群十分拥挤的场面"},{"id":21802,"word":"挨肩迭背","pinyin":"āi jiān dié bèi","abbr":"ajdb","explanation":"形容人群拥挤。","source":{"text":"明·冯梦龙《醒世恒言·勘皮靴单证二郎神》：“当日看的是挨肩迭背。"},"similar":["挨肩擦背"],"opposite":["地广人稀"],"usage":"作谓语、定语；形容人群十分拥挤的场面"},{"id":21803,"word":"挨门挨户","pinyin":"āi mén āi hù","abbr":"amah","explanation":"挨：按照顺序。按照住户的顺序一家也不漏。同“挨门逐户”。","source":{"text":"她心生一计，挨门挨户问人家要不要水。","book":"李英儒《野火春风斗古城》第六章二"},"example":{"text":"她［一丈青大娘］又跑遍沿河几个村落，～乞讨零碎布头儿，给何满子缝了一件五光十色的百家衣。","book":"刘绍棠《蒲柳人家》一"},"similar":["挨家挨户","挨门逐户"],"usage":"作状语、定语；形容不漏掉一户"},{"id":21804,"word":"挨门逐户","pinyin":"āi mén zhú hù","abbr":"amzh","explanation":"挨家挨户，一家也没有漏掉。","source":{"text":"写出岳元帅父子受屈情由，挨门逐户的分派；约齐日子，共上民表，要替岳爷申冤。","book":"清·钱彩《说岳全传》第61回"},"example":{"text":"他～地送会议通知。"},"similar":["挨家挨户"],"opposite":["隔三差五"],"usage":"作状语；同“挨家挨户”"},{"id":21805,"word":"挨风缉缝","pinyin":"āi fēng jī fèng","abbr":"afjf","explanation":"比喻为了达到某种目的而找门路。","source":{"text":"但有一二分才貌的，那一个不挨风缉缝，央媒说合。","book":"明·冯梦龙《醒世恒言·钱秀才错占凤凰俦》第七卷"},"example":{"text":"他挺会～的，终于坐上了处长的宝座。"},"similar":["捱风缉缝","见缝插针"],"usage":"作谓语、定语、宾语；指会钻营的人"},{"id":21806,"word":"挨饿受冻","pinyin":"ái è shòu dòng","abbr":"aesd","explanation":"遭受饥饿与寒冷侵袭。指无衣无食的穷困境况。同“挨冻受饿”。","source":{"text":"你说的也有理！可是有什么法子教乡下人不卖儿卖女，不挨饿受冻呢？","book":"老舍《四世同堂》五八：“长顺儿又每月由高亦陀那里给她领十元的‘救济费’。她一时不至于挨饿受冻。”又《秦氏三兄弟》第三场"},"example":{"text":"我不想～了。"},"similar":["挨冻受饿"],"usage":"作谓语、宾语、定语；指生活贫困"},{"id":21807,"word":"挫骨扬灰","pinyin":"cuò gǔ yáng huī","abbr":"cgyh","explanation":"死后将骨头挫成灰撒掉。形容罪孽深重或恨之极深。","source":{"text":"倘然要把老爷的这项银子耽搁了，慢说我，就挫骨扬灰也抵不了这罪过。","book":"《儿女英雄传》第三回"},"example":{"text":"清·无垢道人《八仙全传》第23回：“或真应了你的誓言，非～不能救母，那么你救出来令堂之后，又有何人代你奉养呢？”"},"usage":"作谓语、定语；指人罪孽深重"},{"id":21808,"word":"振作有为","pinyin":"zhèn zuò yǒu wéi","abbr":"zzyw","explanation":"精神振作，有所作为。","source":{"text":"此时制台正想振作有为。都说他的人是个好的，只可惜了一件，是犯了‘不学无术’四个字的毛病。","book":"清·李宝嘉《官场现形记》第五十六回"},"example":{"text":"宋主骏年才三八，膂力方刚，正是～的时候。（蔡东藩《南北史演义》第十八回）"},"usage":"作谓语、定语、宾语；用于处事"},{"id":21809,"word":"振兴中华","pinyin":"zhèn xīng zhōng huá","abbr":"zxzh","explanation":"原为孙中山在建立兴中会时提出的挽救国家危亡的口号。现指奋发图强，使祖国更加繁荣强大。","source":{"text":"是会之设，专为振兴中华、维持国体起见。","book":"孙中山《兴中会章程》"}},{"id":21810,"word":"振兵泽旅","pinyin":"zhèn bīng shì lǚ","abbr":"zbzl","explanation":"收缴兵器，解散军队。同“振兵释旅”。","source":{"text":"古‘释’字作‘泽’。","book":"《史记·孝武本纪》：“古者先振兵泽旅，然后封禅。”裴骃集解引徐广曰"},"similar":["振兵释旅"],"usage":"作谓语、定语；用于书面语"},{"id":21811,"word":"振兵释旅","pinyin":"zhèn bīng shì lǚ","abbr":"zbsl","explanation":"收缴兵器，解散军队。","source":{"text":"纵马于华山之阳，放牛于桃林之虚；偃干戈，振兵释旅：示天下不复用也。","book":"《史记·周本纪》"},"example":{"text":"臣闻古之天子，方建大礼，必先～，以告成功。","book":"唐·陈子昂《谏曹仁师出军书》"},"similar":["振兵泽旅"],"usage":"作谓语、定语；用于书面语"},{"id":21812,"word":"振古如兹","pinyin":"zhèn gǔ rú zī","abbr":"zgrz","explanation":"振古：自古；兹：现在。从古到今。","source":{"text":"匪且有且，匪今斯今，振古如兹。","book":"《麻经·周颂·载芟》"},"example":{"text":"泰西治国之道，富强之原，非～也，盖自百年以来焉耳。（清·梁启超《论不变法之害》）"},"similar":["一成不变"],"usage":"作谓语、分句；用于书面语"},{"id":21813,"word":"振国之患","pinyin":"zhèn guó zhī huàn","abbr":"zgzh","explanation":"振：振兴，振兴国家，消除灾难。","source":{"text":"倾侧扰攘楚魏之间，卒归高帝。常出奇计，救纷纠之难，振国家之患。","book":"《史记·陈丞相世家》"},"usage":"作谓语；用于书面语"},{"id":21814,"word":"振奋人心","pinyin":"zhèn fèn rén xīn","abbr":"zfrx","explanation":"振奋：振作奋发。使人们振作奋发。","source":{"text":"啊，火把，这饱经革命风暴的胶东老根据地的乡亲们手中高举的火把，是那么炽热，那么明亮，那么振奋人心。","book":"峻青《火把赞》"},"example":{"text":"我们得到一个～的消息。"},"similar":["鼓舞人心"],"usage":"作谓语、定语；指使人振作"},{"id":21815,"word":"振振有词","pinyin":"zhèn zhèn yǒu cí","abbr":"zzyc","explanation":"振振：理直气壮的样子。形容自以为理由充分，说个没完。","source":{"text":"今者外人之以排外相诬者，既振振有词，其乌可更为无谋之举，以授之口实也。","book":"清·梁启超《关税权问题》"},"example":{"text":"小顺儿的妈的北平话，遇到理直气壮～的时候，是词汇丰富，而语调清脆，象清夜的小梆子似的。","book":"老舍《四世同堂》八"},"similar":["理直气壮","义正词严","念念有词"],"opposite":["理屈词穷","张口结舌","词不达意"],"usage":"作谓语、定语、状语；指人的态度"},{"id":21816,"word":"振振有辞","pinyin":"zhèn zhèn yǒu cí","abbr":"zzyc","explanation":"振振：理直气壮的样子。形容自以为理由充分，说个没完。","source":{"text":"今者外人之以排外相诬者，既振振有词，其乌可更为无谋之举，以授之口实也。","book":"清·梁启超《关税权问题》"},"example":{"text":"小顺儿的妈的北平话，遇到理直气壮～的时候，是词汇丰富，而语调清脆，象清夜的小梆子似的。","book":"老舍《四世同堂》八"},"similar":["振振有词","理直气壮"],"opposite":["理屈词穷"],"usage":"作谓语、定语、状语；指人说话"},{"id":21817,"word":"振旅而归","pinyin":"zhèn lǚ ér guī","abbr":"zleg","explanation":"旅：军队。整顿好军队返回。多指部队作战胜利归来。","source":{"text":"获车乘牛马驴骡各数千，资器山积，振旅而归。","book":"《左传·隐公五年》：“三年而治兵，入而振旅。”《三国志·吴志·诸葛恪传》"},"example":{"text":"岳及石他战于河滨，败之，斩他及其甲士一千五百级，赴河死者五千余人，悉收所虏，～。（《晋书·刘曜载记》）"},"similar":["凯旋而归"],"usage":"作谓语；用于书面语"},{"id":21818,"word":"振民育德","pinyin":"zhèn mín yù dé","abbr":"zmyd","explanation":"指接济帮助人民，涵养自己的德行。","source":{"text":"象曰：‘山下有风，蛊，君子以振民育德。","book":"《周易·蛊》"},"example":{"text":"《梁书·武帝纪中》：“虽禅代相舛，遭会异时，而微明迭用，其流远矣。莫不～，光被黎元。”"},"usage":"作谓语、定语；用于书面语"},{"id":21819,"word":"振穷恤寡","pinyin":"zhèn qióng xù guǎ","abbr":"zqxg","explanation":"救济贫穷和无依靠的人。","source":{"text":"壬寅，诏以旱故，命依旧雩祈，察理冤狱，掩胔埋骼，振穷恤寡。","book":"《北史·魏纪四·孝明帝》"},"usage":"作谓语、定语；用于书面语"},{"id":21820,"word":"振穷恤贫","pinyin":"zhèn qióng xù pín","abbr":"zqxp","explanation":"救济贫穷的人。","source":{"text":"壬寅，诏以旱故，命依旧雩祈，察理冤狱，掩胔埋骼，振穷恤寡。","book":"《北史·魏纪四》"},"example":{"text":"睦族敦旧，～，如恐不及。","book":"《明史·王越传》"},"usage":"作谓语、定语；用于书面语"},{"id":21821,"word":"振笔疾书","pinyin":"zhèn bǐ jí shū","abbr":"zbjs","explanation":"振笔：挥笔。挥动笔杆，急速地书写。形容书写速度很快。","source":{"text":"东向伏几，振笔如调文者，不如木索之急，棰楚之痛者也。","book":"汉·桓宽《盐铁论·取下》"},"example":{"text":"两个人刚刚跨进房门，只见秋谷正坐在那里，低着头～，不知写些什么。（清·张春帆《九尾龟》第一百五十五回）"},"usage":"作谓语、定语；用于写作等"},{"id":21822,"word":"振缨中朝","pinyin":"zhèn yīng zhōng cháo","abbr":"zyzc","explanation":"缨：古代帽子上系在颔下的带子；中朝：在朝廷上做事。整理好头冠，入朝处理政事。","source":{"text":"振缨公朝，则德音允集。","book":"晋·陶潜《晋故征西大将军长史孟府君传》"},"example":{"text":"馥～，素有俊彦之称；出据方岳，实有偏任之重，而高略不举，往往失和，危而不持，当与天下共受其责。（《晋书·周馥传》）"},"similar":["振缨公朝","振缨王室"],"usage":"作谓语、定语；用于书面语"},{"id":21823,"word":"振缨公朝","pinyin":"zhèn yīng gōng cháo","abbr":"zygc","explanation":"缨：古代帽子上系在颔下的带子；公朝：在朝廷上做事。整理好头冠，入朝处理政事。","source":{"text":"振缨公朝，则德音允集。","book":"晋·陶潜《晋故征西大将军长史孟府君传》"},"similar":["振缨中朝","振缨王室"],"usage":"作谓语、定语；用于书面语"},{"id":21824,"word":"振缨王室","pinyin":"zhèn yīng wáng shì","abbr":"zyws","explanation":"振缨：弹冠，出仕。指入朝做官","source":{"text":"日者明德世彦，振缨王室。","book":"南朝·陈·沈炯《祭梁吴郡袁府君文》"},"similar":["振缨中朝","振缨公朝"],"usage":"作谓语、定语；用于书面语"},{"id":21825,"word":"振聋发聩","pinyin":"zhèn lóng fā kuì","abbr":"zlfk","explanation":"聩：天生耳聋，引伸为不明事理。声音很大，使耳聋的人也听得见。比喻用语言文字唤醒糊涂麻木的人，使他们清醒过来。","source":{"text":"此数言，振聋发聩，想当时必有迂儒曲士以经学谈诗者。","book":"清·袁枚《随园诗话补遗》第一卷"},"example":{"text":"除了匕首，投枪，也还有～的木铎，有悠然发人深思的静夜钟声。","book":"茅盾《联系实际，学习鲁迅》"},"similar":["醍醐灌顶","震耳欲聋"],"usage":"作谓语、定语；指力量大"},{"id":21826,"word":"振聋启聩","pinyin":"zhèn lóng qǐ kuì","abbr":"zlqk","explanation":"聩：耳聋。使耳聋的人都受到振动和醒悟。比喻用语言文字唤醒糊涂麻木的人，指力量强大。","source":{"text":"创办一个《民心日报》，想在舆论方面，多做些振聋启聩的工作。","book":"李六如《六十年的变迁》第六章"},"similar":["振聋发聩","启聩振聋"],"usage":"作谓语、定语；指力量大"},{"id":21827,"word":"振臂一呼","pinyin":"zhèn bì yī hū","abbr":"zbyh","explanation":"振：挥动。挥动手臂呼喊（多用在号召）。","source":{"text":"然陵振臂一呼，创病皆起。","book":"汉·李陵《答苏武书》"},"example":{"text":"此话甚有道理。目前百姓生活于水深火热之中，朝不保夕，只要有人～，谁不揭竿而起。","book":"姚雪垠《李自成》"},"similar":["登高一呼"],"usage":"作谓语、定语；指大声号召","story":["西汉时期，李陵率5000步兵进攻匈奴，把匈奴3万人打败。单于只好下令撤退，不久他集结8万骑兵进攻汉军，把汉军围得水泄不通，李陵振臂一呼，汉军不论伤病都英勇杀敌，但因寡不敌众，终于经过两天拼杀，李陵兵败被俘"]},{"id":21828,"word":"振衣提领","pinyin":"zhèn yī chí lǐng","abbr":"zytl","explanation":"振：提起。要提起一件衣服，必须拎住衣领。比喻做事情要抓住关键。","source":{"text":"索隐穷源，振衣提领。","book":"北周·王褒《京师突厥寺碑》"},"similar":["振裘持领"],"usage":"作宾语、定语；用于比喻句"},{"id":21829,"word":"振衣濯足","pinyin":"zhèn yī zhuó zú","abbr":"zyzz","explanation":"濯足：洗脚。抖掉衣服上的灰尘，洗去脚上的污垢。形容放弃世俗生活的荣华富贵，立志在山中隐居。","source":{"text":"振衣千仞冈，濯足万里流。","book":"晋·左思《咏史诗八首》之五"},"example":{"text":"再拜先生泪如洗，～吾往矣。","book":"宋·吴曾《能改斋漫录·记诗》"},"usage":"作宾语、定语；用于书面语"},{"id":21830,"word":"振裘持领","pinyin":"zhèn qiú chí lǐng","abbr":"zqcl","explanation":"比喻抓住事物的关键。","source":{"text":"臣闻《春秋》诛恶及本，本诛则恶消；振裘持领，领正则毛理。","book":"汉·杨伦《上书案坐任嘉举主罪》"},"example":{"text":"长主君世，～，赏罚事殷，能不逾漏，宫省咳唾，义必先知。","book":"南朝·梁·萧子显 《南齐书·幸臣传论》"},"similar":["振衣提领"],"usage":"作谓语、定语；用于比喻句"},{"id":21831,"word":"振贫济乏","pinyin":"zhèn pín jì fá","abbr":"zpjf","explanation":"接济贫穷的人和没有依靠的人。亦作“振穷恤寡”、“振穷恤贫”。","source":{"text":"达穷开塞，振贫济乏，天不如钱。","book":"晋·鲁褒《钱神论》"},"usage":"作谓语、定语；用于处事"},{"id":21832,"word":"振领提纲","pinyin":"zhèn lǐng tí gāng","abbr":"zltg","explanation":"提纲挈领。","source":{"text":"总括油素，躬披缃缥，芟芜刈楚，振领提纲，去其繁杂，撮其指要，勒成一家，名曰《江都集礼》。","book":"《隋书·文学传·潘徽》"},"example":{"text":"唐·陈子昂《谏政理书》：“圣人之教，在于可大可久者，故臣欲陛下～，使天下自理也。”"},"similar":["提纲挈领"],"usage":"作谓语、定语、宾语；指简明扼要"},{"id":21833,"word":"振鹭充庭","pinyin":"zhèn lù chōng tíng","abbr":"zlct","explanation":"振：群飞的样子；鹭：白鹭。白鹭群飞，集于庭中。比喻朝廷里人才济济。","source":{"text":"振鹭之声充庭，鸿鸾之党渐阶。","book":"汉·扬雄《剧秦美新》"},"example":{"text":"君臣穆穆，守之以平，济济多士，端委缙綎，鸿渐盈阶，～。","book":"《后汉书·蔡邕传》"},"similar":["振鹭在庭"],"usage":"作谓语、定语；用于书面语"},{"id":21834,"word":"振鹭在庭","pinyin":"zhèn lù zài tíng","abbr":"zlzt","explanation":"振：群飞的样子；鹭：白鹭。白鹭群飞，集于庭中。比喻朝廷里人才济济。","source":{"text":"振鹭之声充庭，鸿鸾之党渐阶。","book":"汉·扬雄《剧秦美新》"},"example":{"text":"伏惟陛下道隐旒纩，信充符玺，六飞同尘，五让高世。白驹空谷，～，犹惧隐鳞卜祝，藏器屠保。（南朝·梁·任昉《为萧扬州荐士表》"},"similar":["振鹭充庭"],"usage":"作谓语、定语；用于书面语"},{"id":21835,"word":"挹兹注彼","pinyin":"yì zī zhù bǐ","abbr":"yzzb","explanation":"挹：舀，汲取；兹：这个；注：灌；彼：那个。把液体从一个容器中舀出，倒入另一个容器。引申为以有余来弥补不足。","source":{"text":"泂酌彼行潦，挹彼注兹。","book":"《诗经·大雅·泂酌》"}},{"id":21836,"word":"挹彼注兹","pinyin":"yì bǐ zhù zī","abbr":"ybzz","explanation":"挹：舀，汲取；彼：那个；注：灌；兹：这个。把液体从一个容器中舀出，倒入另一个容器。引伸为以有余来弥补不足。","source":{"text":"泂酌彼行潦，挹彼注兹。","book":"《诗经·大雅·泂酌》"},"example":{"text":"添补采买，为酌盈剂虚，～之计。","book":"《清会典事例·积储》"},"similar":["挹彼注此"],"usage":"作谓语、定语；指取长补短"},{"id":21837,"word":"挹彼注此","pinyin":"yì bǐ zhù cǐ","abbr":"ybzc","explanation":"指将彼器的液体倾注于此器。亦比喻取一方以补另一方。同“挹彼注兹”。","source":{"text":"假使政治是修明的，那么挹彼注此，损有余以补不足，尽可以用人力来和天灾抗衡。","book":"郭沫若《历史人物·甲申三百年祭》"},"similar":["挹盈注虚"],"usage":"作谓语、定语；用于书面语"},{"id":21838,"word":"挹斗扬箕","pinyin":"yì dǒu yáng jī","abbr":"ydyj","explanation":"指徒有虚名。","source":{"text":"言维此天上，其南则有箕星，不可以簸扬米粟；维此天上，其北则有斗星，不可以挹■(奭斗)其酒浆。","book":"《诗·小雅·大东》：“维南有箕，不可以簸扬；维北有斗，不可以挹酒浆。”孔颖达疏"},"example":{"text":"～误有名，扪参历井信浮生。","book":"清·钱谦益《剡城》诗之二"},"similar":["徒有虚名"],"usage":"作宾语、定语；用于书面语"},{"id":21839,"word":"挹盈注虚","pinyin":"yì yíng zhù xū","abbr":"yyzx","explanation":"指取有余以补不足。","source":{"text":"三日转运百产挹盈注虚者，凡行商之以舟车漕挽大宗货物者是也。","book":"梁启超《生计学学说沿革小史》第九章"},"similar":["挹彼注此"],"usage":"作谓语、定语；用于书面语"},{"id":21840,"word":"挺拔不群","pinyin":"tǐng bá bù qún","abbr":"tbbq","explanation":"《宋史·沈辽传》：“幼挺拔不群，长而好学尚友，傲睨一世。”","source":{"text":"幼挺拔不群，长而好学尚友，傲睨一世。","book":"《宋史·沈辽传》"},"usage":"作谓语、定语；用于书面语"},{"id":21841,"word":"挺而走险","pinyin":"tǐng ér zǒu xiǎn","abbr":"tezx","explanation":"挺：挺直；走险：奔赴险处。指被迫采取冒险行动","source":{"text":"铤而走险，急何能择。","book":"春秋·鲁·左丘明《左传·文公十七年》"},"example":{"text":"郭沫若《孔雀胆》第三幕：“老百姓们是因为不能聊生，所以才～。”"},"similar":["铤而走险"],"usage":"作谓语、定语；指被迫采取冒险行动"},{"id":21842,"word":"挺胸凸肚","pinyin":"tǐng xiōng tū dù","abbr":"txtd","explanation":"凸：凸出。挺着胸脯，鼓起肚皮。形容身壮力强，神气活现的样子。也可形容仗势傲物的样子。","source":{"text":"史见几个挺胸叠肚，指手画脚的人坐在大门上，说东谈西的。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"早进来了怒目横眉、～的一群人。","book":"清·文康《儿女英雄传》第二十一回"},"similar":["挺胸突肚","挺胸叠肚","趾高气扬"],"usage":"作谓语、定语；指得意或傲慢的样子"},{"id":21843,"word":"挺胸叠肚","pinyin":"tǐng xiōng dié dù","abbr":"txdd","explanation":"挺着胸脯，鼓起肚皮。形容身壮力强，神气活现的样子。也可形容仗势傲物的样子。","source":{"text":"史见几个挺胸叠肚，指手画脚的人坐在大门上，说东谈西的。","book":"清·曹雪芹《红楼梦》第六回"},"similar":["挺胸凸肚"],"usage":"作谓语、定语；指得意或傲慢的样子"},{"id":21844,"word":"挺胸突肚","pinyin":"tǐng xiōng tū dù","abbr":"txtd","explanation":"突：凸出。挺起肚皮，形容威武雄壮而傲慢的样子。","example":{"text":"忽然进来了怒目横眉、～的一群人。"},"similar":["插胸叠肚"],"usage":"作谓语、定语；指得意或傲慢的样子"},{"id":21845,"word":"挺身独出","pinyin":"tǐng shēn dú chū","abbr":"tsdc","explanation":"挺身：撑直身体。挺直身体站出来。形容面对着艰难或危险的事情，勇敢地站出来。","source":{"text":"后数日城陷，景思挺身而出。","book":"《旧五代史·唐景思传》"},"similar":["挺身而出"],"usage":"作谓语、定语；指勇敢地站出来"},{"id":21846,"word":"挺身而出","pinyin":"tǐng shēn ér chū","abbr":"tsec","explanation":"挺身：撑直身体。挺直身体站出来。形容面对着艰难或危险的事情，勇敢地站出来。","source":{"text":"后数日城陷，景思挺身而出。","book":"《旧五代史·周·唐景思传》"},"example":{"text":"有的～，被关在拘押所里。","book":"叶圣陶《多收了三五斗》"},"similar":["自告奋勇"],"opposite":["退避三舍","畏缩不前"],"usage":"作谓语、定语；指勇敢地站出来","story":["唐朝初期，皇太子李建成与齐王李元吉妒忌秦王李世民的威望，联合密谋要杀害李世民。李世民得到密报，先下手为强，在玄武门出其不意杀死李建成、李元吉。他们的部下率军攻打玄武门，守将敬君弘挺身而出，英勇杀敌，最后壮烈牺牲"]},{"id":21847,"word":"挺身而斗","pinyin":"tǐng shēn ér dòu","abbr":"tsed","explanation":"形容勇敢地投入战斗。","source":{"text":"匹夫见辱，拔剑而起，挺身而斗。此不足为勇也。","book":"宋·苏轼《留侯论》"}},{"id":21848,"word":"挺鹿走险","pinyin":"tǐng lù zǒu xiǎn","abbr":"tlzx","explanation":"挺而走险。指事急之时，被迫冒险行事。","source":{"text":"古人有言曰……‘鹿死不择音（荫）’小国之事大国也，德则其人也，不德则其鹿也，铤而走险，急何能择。","book":"语出《左传·文公十七年》"},"similar":["铤鹿走险","铤而走险"],"usage":"作谓语、定语；指冒险"},{"id":21849,"word":"挽弩自射","pinyin":"wǎn nǔ zì shè","abbr":"wnzs","explanation":"弩：强弓。拉弓自射。比喻自己做事害自己。","source":{"text":"我举鹆丞而还奏我，是挽弩自射也。","book":"《晋书·崔洪传》"},"similar":["自作自受"],"usage":"作谓语、宾语、定语；指自作自受"},{"id":21850,"word":"捅娄子","pinyin":"tǒng lóu zǐ","abbr":"tlz","explanation":"指闯祸","example":{"text":"你不要给我～了"},"similar":["捅马蜂窝"],"usage":"作谓语、定语、宾语；用于口语"},{"id":21851,"word":"捅马蜂窝","pinyin":"tǒng mǎ fēng wō","abbr":"tmfw","explanation":"比喻闯祸或敢于得罪厉害的人。","example":{"text":"对不正之风，我们要有～的精神。"},"similar":["敢做敢为"],"usage":"作宾语、定语；指敢做敢为"},{"id":21852,"word":"捆载而归","pinyin":"kǔn zǎi ér guī","abbr":"kzeg","explanation":"形容带回的东西很多。","source":{"text":"垂纛而入，转眼捆载而归。","book":"明·冯梦龙《精忠旗·北朝复地》"},"similar":["满载而归"],"usage":"作谓语；指满载而归"},{"id":21853,"word":"捉刀人","pinyin":"zhuō dāo rén","abbr":"zdr","explanation":"指曹操。引申顶替人做事或作文的人","source":{"text":"魏王雅望非常，然床头捉刀人，此乃英雄也。","book":"南朝·宋·刘义庆《世说新语·容止》"},"similar":["床头捉刀人"],"usage":"作宾语、定语；用于书面语","story":["三国时期，生性多疑的曹操在会见匈奴的使者时，为了显示他的威武形象就让一表人才的崔季珪装成他接见，自己则扮成武士提着刀站在床头。会见完毕就命间谍问匈奴使者对魏王的印象如何，匈奴使者说床头捉刀人才是真正的英雄"]},{"id":21854,"word":"捉刀代笔","pinyin":"zhuō dāo dài bǐ","abbr":"zddb","explanation":"指代人出力或代写文章。","source":{"text":"魏王雅望非常，然床头捉刀人，此乃英雄也。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"领导干部都有自己的～人。"},"similar":["请人捉刀"],"usage":"作谓语、宾语、定语；指为别人写东西","story":["三国时期，生性多疑的曹操在会见匈奴的使者时，为了显示他的威武形象就让一表人才的崔季珪装成他接见，自己则扮成武士提着刀站在床头。会见完毕就命间谍问匈奴使者对魏王的印象如何，匈奴使者说床头捉刀人才是真正的英雄"]},{"id":21855,"word":"捉奸捉双","pinyin":"zhuō jiān zhuō shuāng","abbr":"zjzs","explanation":"奸：通奸。捉拿奸情必须同时抓住奸夫淫妇。","source":{"text":"况且‘捉奸捉双’，我和你又无实迹凭据，随他说长道短。","book":"明·凌濛初《初刻拍案惊奇》第17卷"},"example":{"text":"捉贼捉赃，～。","book":"俗话说"},"similar":["捉贼见赃"],"opposite":["信口雌黄"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21856,"word":"捉奸要双，抓贼要赃","pinyin":"zhuō jiān yào shuāng，zhuā zéi yào zāng","abbr":"zjyszzyz","explanation":"奸：通奸；赃：赃物。指问罪要有真凭实据","source":{"text":"你别着急啊，捉奸要双，抓贼要赃，慢慢地来，等抓住他的证据再说。","book":"刘流《烈火金钢》第26回"},"similar":["捉贼要赃，捉奸要双"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21857,"word":"捉奸见双，抓贼见赃","pinyin":"zhuō jiān jiàn shuāng，zhuā zéi jiàn zāng","abbr":"zjjszzjz","explanation":"奸：通奸；赃：赃物。捉拿奸情必须同时抓住奸夫淫妇，捉拿盗贼必须同时抓住赃物。指做事必须要有证据","source":{"text":"你且忍耐，此事须要三思而行。自古道：‘捉奸见双，抓贼见赃。’倘或不了事，枉受了苦梦。","book":"明·冯梦龙《喻世明言》第38卷"},"similar":["捉奸见双，捉贼见赃"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21858,"word":"捉奸见双，拿贼要赃","pinyin":"zhuō jiān jiàn shuāng，ná zéi yào zāng","abbr":"zjjsnzyz","explanation":"奸：通奸。捉拿奸情必须同时抓住奸夫淫妇，捉拿盗贼必须同时抓住赃物。指做事必须要有证据","source":{"text":"‘捉奸见双，拿贼要赃’……无有对证，如何诬赖孤家呢！","book":"清·石玉昆《三侠五义》第102回"},"similar":["捉奸见双，捉贼见赃"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21859,"word":"捉奸见双，捉贼见赃","pinyin":"zhuō jiān jiàn shuāng，zhuō zéi jiàn zāng","abbr":"zjjszzjz","explanation":"奸：通奸。捉拿奸情必须同时抓住奸夫淫妇，捉拿盗贼必须同时抓住赃物。指做事必须要有证据。","source":{"text":"自古道：‘捉奸见双，捉贼见赃，杀人见伤。’你那哥哥的尸首又没了，你又不曾捉得他奸。","book":"明·施耐庵《水浒传》第26回"},"similar":["捉奸捉双，捉贼捉赃"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21860,"word":"捉奸见双，捉贼见赃，杀人见伤","pinyin":"zhuō jiān jiàn shuāng，zhuō zéi jiàn zāng，shā rén jiàn shāng","abbr":"zjjszzjzsrjs","explanation":"奸：通奸；赃：赃物。指问罪要有真凭实据","source":{"text":"自古道：‘捉奸见双，捉贼见赃，杀人见伤。’你那哥哥的尸首又没了，你又不曾捉得他奸。","book":"明·施耐庵《水浒传》第26回"},"similar":["捉奸见双，捉贼见赃"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21861,"word":"捉奸见床","pinyin":"zhuō jiān jiàn chuáng","abbr":"zjjc","explanation":"奸：通奸。捉拿奸情，必须发现在床上确有奸情","source":{"text":"谁是贼？老大人拿贼见赃，不曾捉奸见床来！","book":"明·汤显祖《牡丹亭·硬拷》"},"similar":["捉奸见双"],"usage":"作宾语、定语；用于处事"},{"id":21862,"word":"捉将官里去","pinyin":"zhuō jiāng guān lǐ qù","abbr":"zjglq","explanation":"指被朝廷、官府捉去","source":{"text":"朴言：‘独臣妻有诗一首云：更休落魄贪杯酒，亦莫猖狂爱咏诗。今朝捉将官里去，这回断送老头皮。’上大笑，放还山。","book":"宋·赵令榁《侯鲭录》第六卷"},"usage":"作谓语、定语；用于书面语","story":["宋朝时期，真宗下令访天下隐者，得到一个会作诗的杞人杨朴，召见时他却说不会诗，真宗问他临行有人作诗送他否？杨朴回答说：“臣妻有诗一首：更休落魄贪杯酒，亦莫猖狂爱咏诗。今朝捉将官里去，这回断送老头皮。”真宗大笑，就放他还山"]},{"id":21863,"word":"捉将挟人","pinyin":"zhuō jiàng xié rén","abbr":"zjxr","explanation":"挟：制服。在战斗中能制服、活捉敌将。","source":{"text":"挟人捉将千般勇，武艺精熟敢战争。","book":"元·李文蔚《蒋神灵应》楔子"},"similar":["挟人捉将"],"usage":"作谓语、定语；用于作战等"},{"id":21864,"word":"捉影捕风","pinyin":"zhuō yǐng bǔ fēng","abbr":"zybf","explanation":"比喻虚幻无实或无根据地臆测。","source":{"text":"这泼猴枉自也拿他不住；就拿住他，也似抟沙弄汞，捉影捕风。","book":"明·吴承恩《西游记》第二十五回"},"similar":["捕风捉影","捉风捕影","捉影追风"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":21865,"word":"捉影追风","pinyin":"zhuō yǐng zhuī fēng","abbr":"zyzf","explanation":"比喻说话做事没有确凿依据，随意而行","source":{"text":"许人话捉影追风，骗人财探囊取物。","book":"明·郑若庸《玉玦记·博弈》"},"similar":["捉影捕风","捉风捕影","捉风捕月"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":21866,"word":"捉摸不定","pinyin":"zhuō mō bù dìng","abbr":"zmbd","explanation":"捉摸：猜测。形容变化无常，无法猜测预料。","source":{"text":"却说朱武、杨春两个正在寨里猜疑，捉摸不定。","book":"明·施耐庵《水浒全传》第二回"},"example":{"text":"只是到底会不会受处分，他就～了。","book":"丁玲《太阳照在桑干河上》第二十六章"},"similar":["变化莫测"],"usage":"作谓语、定语；指难以猜测"},{"id":21867,"word":"捉班做势","pinyin":"zhuō bān zuò shì","abbr":"zbzs","explanation":"摆架子，装腔作势。","source":{"text":"万一不肯时，做妹子自会劝他，只是寻得主顾来，你却莫要捉班做势。","book":"明·冯梦龙《醒世恒言》卷三"},"similar":["装腔作势"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":21868,"word":"捉生替死","pinyin":"zhuō shēng tì sǐ","abbr":"zsts","explanation":"指晨昏颠倒。常用在无限制地享乐。","source":{"text":"官人每枉请著皇家禄，都只是捉生替死，屈陷无辜。","book":"元·王仲文《救孝子》第三折"},"example":{"text":"把宪规当作生涯做，～报阎罗。","book":"清·李渔《怜香伴·冤褫》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":21869,"word":"捉虎擒蛟","pinyin":"zhuō hǔ qín jiāo","abbr":"zhqj","explanation":"蛟：蛟龙。能上山捉老虎，下海擒蛟龙。比喻本领大。","source":{"text":"捉虎擒蛟真壮士，好汉声名播四方。","book":"明·无名氏《大劫牢》第三折"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":21870,"word":"捉衿肘见","pinyin":"zhuō jīn zhǒu jiàn","abbr":"zjzj","explanation":"衿，同“襟”。指整一整衣襟就露出了肘子。形容衣衫褴褛。引申为顾此失彼，处境困难。","source":{"text":"曾子居卫，十年不制衣，正冠而缨绝，捉衿而肘见。","book":"《庄子·让王》"},"example":{"text":"惟夫床琴于浚井之日，弦歌于绝粮之余，以致～而歌商声，箪食瓢饮而不改其乐，乃为境之逆而乐之真耳。","book":"明·杨慎《丹铅总录·境逆乐真》"},"similar":["捉衿露肘","捉襟露肘","捉襟见肘"],"usage":"作谓语、宾语、定语；指非常贫困"},{"id":21871,"word":"捉衿见肘","pinyin":"zhuō jīn jiàn zhǒu","abbr":"zjjz","explanation":"形容书法生动而有气势。","source":{"text":"曾子居卫，十年不制衣，正冠而缨绝，捉衿而肘见。","book":"《庄子·让王》"},"example":{"text":"～贫无敌，耸膊成山瘦可知。","book":"宋·陆游《衰疾》诗"},"similar":["捉衿露肘","捉襟见肘","捉襟肘见"],"usage":"作谓语、宾语、定语；指非常贫困"},{"id":21872,"word":"捉衿露肘","pinyin":"zhuō jīn lù zhǒu","abbr":"zjlz","explanation":"指整一整衣襟就露出肘子。形容衣衫褴褛。引申为顾此失彼，处境困难。","source":{"text":"伏以捉衿露肘，谁怜子夏之贫。","book":"明·焦竑《焦氏笔乘·募疏》"},"similar":["捉衿见肘","捉襟见肘","捉衿肘见"],"usage":"作谓语、宾语、定语；指非常贫困"},{"id":21873,"word":"捉襟肘见","pinyin":"zhuō jīn zhǒu jiàn","abbr":"zjzj","explanation":"指整一整衣襟就露出肘子。形容衣衫褴褛。引申为顾此失彼，处境困难。","source":{"text":"十年不制衣，正冠而缨绝，捉衿而肘见。","book":"《庄子·让王》"},"example":{"text":"只为一向窘迫，～，便东涂西抹不来，所以诸事胆怯。","book":"清·李绿园《歧路灯》第七十七回"},"similar":["捉襟见肘","捉襟露肘","捉衿露肘"],"usage":"作谓语、宾语、定语；指非常贫困"},{"id":21874,"word":"捉襟见肘","pinyin":"zhuō jīn jiàn zhǒu","abbr":"zjjz","explanation":"拉一拉衣襟，就露出臂肘。形容衣服破烂。比喻顾此失彼，穷于应付。","source":{"text":"十年不制衣，正冠而缨绝，捉襟而肘见，纳履而踵决。","book":"《庄子·让王》"},"example":{"text":"平时所过的早就是～的生活，更那有什么余钱来做归国的路费呢？","book":"郭沫若《学生时代·创造十年》"},"similar":["衣不蔽体","衣衫褴褛","百孔千疮"],"opposite":["绰有余裕","绰绰有余","完美无缺"],"usage":"作谓语、宾语、定语；指非常贫困","story":["春秋时期，孔子的弟子曾参隐居不仕，过着逍遥自在的生活。他住在卫国，面容憔悴，手脚都长满了茧子，衣服破烂不堪，生活十分困顿，有时连续三天不生火，十年没做新衣服，正一正帽子，帽上的缨绳就断，拉下衣襟，胳膊肘就露出来了"]},{"id":21875,"word":"捉襟露肘","pinyin":"zhuō jīn lù zhǒu","abbr":"zjlz","explanation":"拉一拉衣襟，就露出臂肘。形容衣服破烂。比喻顾此失彼，穷于应付。","source":{"text":"十年不制衣，正冠而缨绝，捉襟而肘见，纳履而踵决。","book":"《庄子·让王》"},"example":{"text":"平时所过的早就是～的生活，更那有什么余钱来做归国的路费呢？","book":"郭沫若《学生时代·创造十年》"},"similar":["捉衿肘见","捉襟肘见","捉襟见肘"],"usage":"作谓语、宾语、定语；指非常贫困"},{"id":21876,"word":"捉贼捉脏","pinyin":"zhuō zéi zhuō zāng","abbr":"zzzz","explanation":"比喻处理是非的事，要以事实为根据。","source":{"text":"谚曰：‘捉贼捉脏，捉捉双。’此虽俚言，极为有道。","book":"宋朝胡太初《昼帘绪论·治狱》"}},{"id":21877,"word":"捉贼捉赃","pinyin":"zhuō zéi zhuō zāng","abbr":"zzzz","explanation":"比喻处理是非的事，要以事实为根据。","source":{"text":"谚曰：‘捉贼捉脏，捉捉双。’此虽俚言，极为有道。","book":"宋·胡太初《昼帘绪论·治狱》"},"example":{"text":"～，捉奸见双。又无证见，如何断得他罪。","book":"明·冯梦龙《古今小说》卷三十五"},"similar":["捉奸捉双"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21878,"word":"捉贼捉赃，捉奸捉双","pinyin":"zhuō zéi zhuō zāng，zhuō jiān zhuō shuāng","abbr":"zzzzzjzs","explanation":"比喻处理是非的事，要以事实为根据。","source":{"text":"谚曰：‘捉贼捉赃，捉奸捉双。’此虽俚言，极为有道。","book":"宋·胡太初《昼帘绪论·治狱》"},"example":{"text":"那小子就在窑里面。俗话说，～。这下看他小子怎么办！","book":"路遥《平凡的世界》第一卷第49章"},"similar":["捉贼捉赃","捉奸捉双"],"usage":"作宾语、定语、分句；用于处事"},{"id":21879,"word":"捉贼要赃，捉奸要双","pinyin":"zhuō zéi yào zāng，zhuō jiān yào shuāng","abbr":"zzyzzjys","explanation":"赃：赃物；奸：通奸。指问罪要有真凭实据","source":{"text":"村长！捉贼要赃，捉奸要双，当了妇救会长就不说理了。","book":"赵树理《小二黑结婚》"},"similar":["捉奸要双，抓贼要赃"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21880,"word":"捉贼见赃","pinyin":"zhuō zéi jiàn zāng","abbr":"zzjz","explanation":"脏：偷盗或贪污受贿所得的财物。捉盗贼必须看到赃物。指必须要有真凭实据。","source":{"text":"常言道：‘捉贼见脏，捉奸见双。’燕大，你既要拿奸，如今还我奸夫来便罢。","book":"元·李文尉《燕青博鱼》第三折"},"example":{"text":"自古道：'捉奸见双，捉贼见赃，杀人见伤。'","book":"明·施耐庵《水浒传》第二十六回"},"similar":["捉奸见双"],"usage":"作谓语、宾语；指办事要以事实为根据"},{"id":21881,"word":"捉贼见赃，捉奸见双","pinyin":"zhuō zéi jiàn zāng，zhuō jiān jiàn shuāng","abbr":"zzjzzjjs","explanation":"赃：赃物；奸：通奸。指问罪要有真凭实据","source":{"text":"常言道：‘捉贼见赃，捉奸见双。’燕大，你既要拿奸，如今还我奸夫来便罢，若没奸夫……，我与你要见一个明白！","book":"元·李文蔚《燕青博鱼》第三折"},"example":{"text":"明·洪楩《清平山堂话本·简贴和尚》：“‘～’，又无佐证，如何断得他罪？”"},"similar":["捉奸见双，捉贼见赃，杀人见伤"],"usage":"作宾语、定语；指做事必须要有证据"},{"id":21882,"word":"捉风捕影","pinyin":"zhuō fēng bǔ yǐng","abbr":"zfby","explanation":"比喻虚幻无实或无根据地臆测。","source":{"text":"是事如捉风捕影，杳无实证，又不可刑求。断离断合，皆难保不误。","book":"清·纪昀《阅微草堂笔记》卷十"},"example":{"text":"清·李百川《绿野仙踪》第六回：“～逃将去，半神半鬼半人。”"},"similar":["捉影捕风","捕风捉影","捉风捕月"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":21883,"word":"捉风捕月","pinyin":"zhuō fēng bǔ yuè","abbr":"zfby","explanation":"比喻虚幻无实或无根据地臆测。","source":{"text":"自风雅之道衰，即愚若胡生，亦必捉风捕月，自诩五言之城。","book":"清·钮琇《觚剩续编·律例》"},"similar":["捉风捕影","捕风捉影","捉影捕风"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":21884,"word":"捉鬼卖钱","pinyin":"zhuō guǐ mài qián","abbr":"zgmq","explanation":"将鬼捉住卖钱。指不怕鬼。","source":{"text":"晋·张华《列异传》：宋定伯捉鬼卖钱"},"example":{"text":"他是～式的人物。"},"usage":"作宾语、定语；指不怕鬼","story":["南阳人宋定伯夜间走路碰到一个鬼，假装成鬼与鬼同行，他与鬼轮流背着走，机智地消除鬼对他的种种疑虑。天快亮时到达宛市，他背着鬼，紧抓不放，到了市中将鬼摔在地上，鬼变成一只羊。宋定伯向他吐口水，并将他卖了1500钱后回家"]},{"id":21885,"word":"捉鬼放鬼","pinyin":"zhuō guǐ fàng guǐ","abbr":"zgfg","explanation":"比喻又做坏事又装好人的两面派行为。","example":{"text":"他尽干些～的事情。"},"similar":["既做司公又做鬼"],"usage":"作谓语、定语；指耍两面派"},{"id":21886,"word":"捉鸡骂狗","pinyin":"zhuō jī mà gǒu","abbr":"zjmg","explanation":"犹指桑骂槐。比喻表面上骂这个人，实际上是骂那个人。","source":{"text":"次日，张氏晓得了，反怪媳妇做格，不去勾搭儿子干事，把一团美意，看做不良之心，捉鸡骂狗，言三语四，影射的发作了一场。","book":"明·冯梦龙《醒世恒言》第九卷"},"usage":"作谓语、宾语、定语；用于处事"},{"id":21887,"word":"捉鼠拿猫","pinyin":"zhuō shǔ ná māo","abbr":"zsnm","explanation":"拿：抓住。捉住老鼠和猫。比喻能制服敌手。","source":{"text":"若论我腹中的兵书，委的有神鬼不测之机，有捉鼠拿猫之法。","book":"元·无名氏《射柳捶丸》第一折"},"usage":"作宾语、定语；用于书面语"},{"id":21888,"word":"捋臂揎拳","pinyin":"luō bì xuān quán","abbr":"lbxq","explanation":"捋：卷起；揎：拳打。卷起袖子，伸出拳头，准备动手。","source":{"text":"这一个戗金铠身上穿，那一个蘸钢鞭腕上悬，一个个气昂昂性儿不善，他每都叫吼吼捋袖揎拳。","book":"元·无名氏《碧桃花》第三折"},"example":{"text":"喜则眉花眼笑，怒则～。","book":"清·夏敬渠《野叟曝言》第四十七回"},"similar":["捋袖揎拳"],"usage":"作谓语、定语、状语；指准备动武"},{"id":21889,"word":"捋虎须","pinyin":"luō hǔ xū","abbr":"lhx","explanation":"捋：抚摩。比喻触犯有权势的人或冒着很大的风险。","source":{"text":"太公道：‘好却甚好，只是不要捋虎须。’","book":"明·施耐庵《水浒传》第五回"},"example":{"text":"清·名教中人《好逑传》第11回：“叫我传话给水老相公，不要去～，自讨苦吃。”"},"usage":"作宾语、定语；用于处事"},{"id":21890,"word":"捋袖揎拳","pinyin":"luō xiù xuān quán","abbr":"lxxq","explanation":"捋：拉起。揎：卷起袖子。拉起袖子，伸出拳头。形容怒气冲冲准备动武的样子。","source":{"text":"他每都叫吼吼捋袖揎拳。","book":"元·无名氏《碧桃花》第三折"},"example":{"text":"则见他～，努目眬眉。","book":"明·无名氏《锁白猿》第一折"},"similar":["捋臂揎拳"],"usage":"作谓语、定语、状语；指准备动武"},{"id":21891,"word":"捎关打节","pinyin":"shāo guān dǎ jié","abbr":"sgdj","explanation":"指打通关节。","source":{"text":"只消我移宫换羽，便是我捎关打节。不是我自说，遮莫你贞烈心肠硬似铁，我将那打凤牢龙的计设。","book":"明·朱权《卓文君》第二折"},"similar":["稍关打节"],"usage":"作谓语、宾语、定语；指耍手段"},{"id":21892,"word":"捏一把汗","pinyin":"niē yī bǎ hàn","abbr":"nybh","explanation":"因担心而手上出汗。形容非常紧张的心情。","source":{"text":"赵姨娘正因彩云私赠了许多东西，被玉钏儿吵出，生恐查诘出来，每日捏一把汗打听信儿。","book":"清·曹雪芹《红楼梦》第六十二回"},"example":{"text":"我最初实在替这孩子～，待到掘出黄金一釜，这才觉得轻松。","book":"鲁迅《朝花夕拾·二十四孝图》"},"usage":"作谓语；形容担心"},{"id":21893,"word":"捏怪排科","pinyin":"niē guài pái kē","abbr":"ngpk","explanation":"作怪、捣鬼、为难之意。","source":{"text":"元·无名氏《百花亭》第一折：“着那等干眼热滑张杓，任从那些打草惊蛇，尽教他捏怪排科斯间谍。”"}},{"id":21894,"word":"捏手捏脚","pinyin":"niē shǒ niē jiǎo","abbr":"nsnj","explanation":"形容轻手轻脚地走。也形容轻薄的举动。","source":{"text":"乘他身边伏侍时节，与他捏手捏脚，私下肉麻。","book":"明·冯梦龙《醒世恒言》第三十三卷：“那贼略推一推，豁地开了，捏手捏脚，直到房中，并无一人知觉。”明·凌濛初《二刻拍案惊奇》卷十"},"example":{"text":"二爷趁空把细姑娘拉在一条板凳上坐着，同他～，亲热了一回。","book":"清·吴敬梓《儒林外史》第四十二回"},"similar":["蹑手蹑脚","动手动脚"],"usage":"作谓语、状语；形容轻手轻脚地走"},{"id":21895,"word":"捏捏扭扭","pinyin":"niē niē niǔ niǔ","abbr":"nnnn","explanation":"身体左右扭动。形容故作娇媚或有意做作。","source":{"text":"须知有一种不自重的女子，专欢喜涂脂抹粉，见了人，故意的捏捏扭扭，躲躲藏藏的。","book":"清·吴趼人《二十年目睹之怪现状》第21回"},"similar":["扭扭捏捏","扭手扭脚"],"usage":"作定语、状语；指装模作样"},{"id":21896,"word":"捏脚捏手","pinyin":"niē jiǎo niē shǒu","abbr":"njns","explanation":"放轻手脚走路，动作小心翼翼的样子。","source":{"text":"分付已毕，太尉便同一人过去，捏脚捏手，轻轻走到韩夫人窗前。","book":"明·施耐庵《水浒传》第二十一回：“唐牛儿捏脚捏手，上到楼上。”明·冯梦龙《醒世恒言》卷十三"},"similar":["捏手捏脚","蹑手蹑脚"],"usage":"作谓语、状语；指走路小心"},{"id":21897,"word":"捐华务实","pinyin":"juān huá wù shí","abbr":"jhws","explanation":"抛弃浮华，务求朴实。","source":{"text":"顷商贩逐末，竞早争新，折未实之果，收豪家之利，笼非膳之翼，为童戏之资，岂所以还风尚本，捐华务实？","book":"南朝·宋·刘彧《泰始三年禁采供不时诏》"},"usage":"作谓语、宾语；用于书面语"},{"id":21898,"word":"捐弃前嫌","pinyin":"juān qì qián xián","abbr":"jqqx","explanation":"抛弃旧有的嫌隙。","source":{"text":"瓦砾进宝兮，捐弃随和。","book":"汉·王褒《九怀·株昭》"},"example":{"text":"看在儿女面上，就～，破镜重圆吧。","book":"陈国凯《两情总是久长时》"},"similar":["宽大为怀","宽宏大量"],"opposite":["斤斤计较","锱铢必较","不共戴天"],"usage":"作谓语、宾语；指和解"},{"id":21899,"word":"捐忿弃瑕","pinyin":"juān fèn qì xiá","abbr":"jfqx","explanation":"瑕：玉上的斑痕裂纹，比喻旧有的裂痕。抛弃忿恨和裂痕。表示重修于好。","source":{"text":"孤亦愿自今之日与君王捐忿弃瑕，继平昔之欢。","book":"宋·苏轼《拟侯公说项羽辞》"},"usage":"作谓语、宾语；用于书面语"},{"id":21900,"word":"捐本逐末","pinyin":"juān běn zhú mò","abbr":"jbzm","explanation":"捐：抛弃；逐：追逐。指抛弃根本，追求末节。","source":{"text":"捐本逐末，流遍华壤，递相师祖，久而愈扇。","book":"《北史·李谔传》"},"similar":["舍本求末","本末倒置"],"usage":"作谓语、定语；指抛弃根本，追求末节"},{"id":21901,"word":"捐残去杀","pinyin":"juān cán qù shā","abbr":"jcqs","explanation":"感化残暴的人使其不再作恶，便可废除死刑。也指以德化民，太平至治。","source":{"text":"夫报忿除害，捐残去杀，朕之所图于将军也。","book":"《论语·子路》：“善人为邦百年，亦可以胜残去杀矣。”《汉书·李广传》"},"similar":["胜残去杀","去杀胜残"],"usage":"作宾语、定语；指以德化民"},{"id":21902,"word":"捐生殉国","pinyin":"juān shēng xùn guó","abbr":"jsxg","explanation":"捐生：舍弃生命；殉国：为国家而牺牲生命。为了国家而牺牲自己的生命。","source":{"text":"既见义忘家，捐生殉国，永言忠烈，何日忘之！","book":"北魏·杨衒之《洛阳伽蓝记·追光寺》"},"example":{"text":"正义愍公毓临节能固，～，成为令典，没世不忘。","book":"《隋书·豆毓传》"},"similar":["捐躯报国"],"opposite":["贪生怕死"],"usage":"作谓语、宾语；指为国捐躯"},{"id":21903,"word":"捐身徇义","pinyin":"juān shēn xùn yì","abbr":"jsxy","explanation":"为正义而牺牲生命。","source":{"text":"累准朝廷指挥催督，此正飞等捐身徇义之秋。","book":"宋·岳飞《申司进兵状》"},"similar":["捐躯报国"],"usage":"作谓语、定语；用于书面语"},{"id":21904,"word":"捐躯报国","pinyin":"juān qū bào guó","abbr":"jqbg","explanation":"舍弃身躯，报效国家。","source":{"text":"臣以布衣受恩，誓捐躯报国，今既偾军，得死为幸！","book":"《元史·王戢传》"},"example":{"text":"我想做了武将，固当～。","book":"清·钱采《说岳全传》第16回"},"similar":["尽忠报国","为国捐躯","精忠报国"],"opposite":["卖国求荣"],"usage":"作谓语、定语、宾语；指舍弃身躯，报效国家","story":["金章宗时期，元帅高琪推荐王戢任副统军，镇守涿鹿关，元太祖成吉思汗率军南下，在涿鹿激战三天，终于抓住了王戢。王戢昂然说自己深受金主恩惠，发誓捐躯报国，为主殉难是天经地义的事情。成吉思汗觉得他是个人才就放了他"]},{"id":21905,"word":"捐躯摩顶","pinyin":"juān qū mó dǐng","abbr":"jqmd","explanation":"摩：通“磨”，消耗；顶：指头颅。指粉身碎骨，牺牲自己的生命。","source":{"text":"不思捐躯摩顶以报万一，反恣胸臆擅作威福。","book":"清·蒲松龄《聊斋志异·续黄梁》"}},{"id":21906,"word":"捐躯殉国","pinyin":"juān qù xùn guó","abbr":"jqxg","explanation":"殉国：为国家的利益而牺牲生命。为了国家而献出生命。","source":{"text":"既见义忘家，捐生殉国，永言忠烈何日忘之！","book":"北魏·杨衒之《洛阳伽蓝记·追光寺》"},"example":{"text":"就使束手就擒，莫若～。","book":"宋·无名氏《新编五代史平话·晋史》卷下"},"similar":["捐生殉国","捐躯报国"],"opposite":["贪生怕死"],"usage":"作谓语、宾语；指为国捐躯"},{"id":21907,"word":"捐躯殒首","pinyin":"juān qù yǔn shǒu","abbr":"jqys","explanation":"舍弃身躯，丢掉头颅。","source":{"text":"仰荷天地至恩，捐躯殒首，无以上报。","book":"宋·王安石《第三札子》"},"example":{"text":"我道来不轻微，设若便～当出力。","book":"元·无名氏《娶小乔》第三折"},"similar":["捐躯殒命"],"usage":"作谓语、宾语、定语；用于处事"},{"id":21908,"word":"捐躯济难","pinyin":"juān qū jì nàn","abbr":"jqjn","explanation":"捐躯：牺牲生命；济：救助。牺牲生命，以解救国家的危难。","source":{"text":"夫忧国忘家，捐躯济难，忠臣之志也。","book":"晋·陈寿《三国志·魏志·陈思王植传》"},"usage":"作谓语、宾语；用于爱国者"},{"id":21909,"word":"捐躯赴难","pinyin":"juān qū fù nàn","abbr":"jqfn","explanation":"躯：身体。指舍弃生命，奔赴国难。","source":{"text":"捐躯赴国难，视死忽如归。","book":"三国·魏·曹植《白马篇》"},"example":{"text":"姓李名恺，率师拒敌，报国尽忠，～。","book":"《西湖佳话·三生石迹》"},"similar":["视死如归","慷慨就义"],"opposite":["贪生怕死"],"usage":"作谓语、定语、宾语；指为国捐躯"},{"id":21910,"word":"捐金抵璧","pinyin":"juān jīn dǐ bì","abbr":"jjdb","explanation":"指不重财物。","source":{"text":"上智不贵难得之财，故唐虞捐金而抵璧。","book":"语本晋·葛洪《抱朴子·安贫》"},"example":{"text":"陛下贞观之初，动遵尧舜，～，反朴还淳。","book":"唐·魏徵《十渐不克终疏》"},"usage":"作谓语、定语；用于比喻句"},{"id":21911,"word":"捐金沉珠","pinyin":"juān jīn chén zhū","abbr":"jjcz","explanation":"捐：舍弃，将金子丢弃在山中，将珠宝掷于湖水中。形容不贪图钱财，不奢求富贵。","source":{"text":"捐金于山，沉珠于渊。","book":"汉·陆贾《新语·术事》：“珠玉无用而宝之于身，故舜弃黄金于崭岩之山，捐珠玉于五湖之川，以杜淫邪之欲，绝琦玮之情。”汉·班固《东都赋》"}},{"id":21912,"word":"捕影拿风","pinyin":"bǔ yǐng ná fēng","abbr":"bynf","explanation":"风和影子是无法捉摸与束缚的。比喻虚幻无实或无根据地猜疑。","source":{"text":"怎知道被禅师神挑鬼弄，做一场捕影拿风。","book":"元·吴昌龄《东坡梦》第三折"},"similar":["捕风捉影","捕风系影"],"usage":"作谓语、定语、状语；指说话没有事实根据"},{"id":21913,"word":"捕影捞风","pinyin":"bǔ yǐng lāo fēng","abbr":"bylf","explanation":"捞：随便拾取。比喻说话做事没有确凿可靠的根据。","source":{"text":"官司缉匪，火急敢逗留？捕影捞风何处有？","book":"清·方成培《雷峰塔·虎阜》"},"similar":["捕风捉影"],"usage":"作谓语、定语、状语；指说话没有事实根据"},{"id":21914,"word":"捕影系风","pinyin":"bǔ yǐng xì fēng","abbr":"byxf","explanation":"风和影子都是抓不着的。比喻说话做事丝毫没有事实根据。","source":{"text":"但雕朽污粪，徒成延奖；捕影系风，终无效答。","book":"《梁书·刘孝绰传》"},"example":{"text":"于是连兵十数年，国削民乏，渺然视太平之象，更若～。","book":"南唐·史虚白《钓矶立谈》"},"similar":["捕风捉影"],"opposite":["耳闻目睹"],"usage":"作谓语、定语、状语；指说话没有事实根据"},{"id":21915,"word":"捕风弄月","pinyin":"bǔ fēng nòng yuè","abbr":"bfny","explanation":"捕：捉拿，捉取。形容事物虚无飘渺，没有根据。","source":{"text":"响马得财漏网，瘟太守面糊盆，不知苦辣，倒着落在我身上，要捕风弄月，教我哪里去追寻。","book":"清·褚人获《隋唐演义》第12回"},"similar":["捕风捉影"],"usage":"作谓语、定语、宾语；指说话或事情没有根据"},{"id":21916,"word":"捕风捉影","pinyin":"bǔ fēng zhuō yǐng","abbr":"bfzy","explanation":"风和影子都是抓不着的。比喻说话做事丝毫没有事实根据。","source":{"text":"若悠悠地似做不做，如捕风捉影，有甚长进？","book":"《汉书·郊祀志》：“听其言，洋洋满耳，若将可遇；求之，荡荡如系风捕景，终不可得。”《朱子全书》"},"example":{"text":"若被黜者一一求其所以得罪之故，～，捏造流言。","book":"明·张居正《乞鉴别忠邪以定国上疏》"},"similar":["望风捕影","无中生有","道听途说"],"opposite":["实事求是","耳闻目睹","确凿不移"],"usage":"作谓语、定语、状语；指说话做事没事实根据","story":["汉成帝40多岁还没有孩子，听信方士的话，热衷于祭祀鬼神，花费很大，但没有什么效验。光禄大夫谷永给汉成帝上书说世界上没有什么仙人及长生不老的药，要寻找他就像要缚住风，捉住影子一样不可能得到，汉成帝终于迷途知返"]},{"id":21917,"word":"捕风系影","pinyin":"bǔ fēng xì yǐng","abbr":"bfxy","explanation":"风和影子是无法捉摸与束缚的。比喻虚幻无实或无根据地猜疑。","source":{"text":"虚无恍惚，如捕风系影，圣人平日之言，恐无是也。","book":"宋·朱熹《答蔡季通》"},"similar":["捕风捉影","捕影拿风"],"usage":"作谓语、定语、状语；指说话没有事实根据"},{"id":21918,"word":"捞一把","pinyin":"lāo yī bǎ","abbr":"lyb","explanation":"用不正当手段取得一些利益。","source":{"text":"我们一定要趁热打铁，争取再多搞些活动，大捞一把。","book":"王朔《千万别把我当人》"},"example":{"text":"你们这些当官的不是真心为了老百姓，就图～。"},"similar":["大捞一把"],"usage":"作谓语、宾语；指谋利"},{"id":21919,"word":"捞捞搭搭","pinyin":"lāo lāo dā dā","abbr":"lldd","explanation":"动手动脚，拉拉扯扯。","example":{"text":"请自重一些，不要在大庭广众中～。"},"similar":["动手动脚","拉拉扯扯"],"usage":"作宾语、状语；用于口语"},{"id":21920,"word":"损上益下","pinyin":"sǔn shàng yì xià","abbr":"ssyx","explanation":"减少君上的权利以施惠下民。","source":{"text":"益，损上益下，民悦无疆。","book":"《周易·益》"},"example":{"text":"～，顺兆庶之悦；享以二簋，用至约之义。","book":"《晋书》"},"usage":"作谓语、定语、宾语；用于劝谏"},{"id":21921,"word":"损之又损","pinyin":"sǔn zhī yòu sǔn","abbr":"szys","explanation":"形容极为谦虚。","source":{"text":"故曰为道者日损，损之又损之，以至于无为。","book":"《庄子·知北游》"},"example":{"text":"真理虽然顿达，此情难以卒除。须长觉察，～，如风顿止，波浪渐停。","book":"宋·释普济《五灯会元》卷二"},"usage":"作谓语、定语；指十分谦虚"},{"id":21922,"word":"损人不利己","pinyin":"sǔn rén bù lì jǐ","abbr":"srblj","explanation":"损害别人对自己也没有好处。","source":{"text":"只有损人而不利己的事，我是反对的。","book":"鲁迅《书信·致曹聚仁》"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“稳当是稳当，可能劳而无功，也可能～，徒然搞垮永兴盛。”"},"similar":["损人害己"],"opposite":["损人利己"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21923,"word":"损人利己","pinyin":"sǔn rén lì jǐ","abbr":"srlj","explanation":"损害别人，使自己得到好处。","source":{"text":"为政者理则可矣，何必严刑树威。损人益己，恐非仁恕之道。","book":"《旧唐书·陆象先传》"},"example":{"text":"凡有～之心的人，其结果都不妙。","book":"毛泽东《新民主主义的宪政》"},"similar":["自私自利","见利忘义"],"opposite":["大公无私","舍己为人"],"usage":"作谓语、宾语、定语；指损害别人","story":["唐朝时期，陆象先少年志高，才华出众，得到当时吏部侍郎吉顼的赏识，评价他为“才望高雅”，推荐他担任洛阳尉。陆象先清心寡欲，知足常乐，为官廉正，不喜欢趋炎附势，也不损人利己，深受皇帝的器重，功劳卓著"]},{"id":21924,"word":"损人安己","pinyin":"sǔn rén ān jǐ","abbr":"sraj","explanation":"损人利己。","source":{"text":"你那厮损人安己，惹下祸灾。","book":"元·无名氏《小张屠》第三折"},"example":{"text":"她～，一点也不考虑后果。"},"similar":["损人利己","损人肥己"],"opposite":["损己利物"],"usage":"作谓语、定语；指损人利己"},{"id":21925,"word":"损人害己","pinyin":"sǔn rén hài jǐ","abbr":"srhj","explanation":"既害了别人，又害了自己。","source":{"text":"可是封建旧家庭的环境戕害了他的生机，他只能做损人害己的事情。","book":"巴金《和读者谈》"},"similar":["损人不利己"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21926,"word":"损人益己","pinyin":"sǔn rén yì jǐ","abbr":"sryj","explanation":"损害别人，使自己得到好处。","source":{"text":"为政者理则可矣，何必严刑树威。损人益己，恐非仁恕之道。","book":"《旧唐书·陆象先传》"},"example":{"text":"请不要干～的事情。"},"similar":["损人利己"],"opposite":["损己利物"],"usage":"作谓语、定语；指损人利己","story":["唐朝时期，陆象先少年志高，才华出众，得到当时吏部侍郎吉顼的赏识，评价他为“才望高雅”，推荐他担任洛阳尉。陆象先清心寡欲，知足常乐，为官廉正，不喜欢趋炎附势。他认为为政不能靠刑罚树威，不能干这种损人益己的事"]},{"id":21927,"word":"损人肥己","pinyin":"sǔn rén féi jǐ","abbr":"srfj","explanation":"犹损人利己。损害别人，使自己得到好处。","source":{"text":"如今这些贪人，拥着娇妻美妾，求田问舍，损人肥己，搬斤播两，何等肚肠。","book":"明·凌濛初《初刻拍案惊奇》第18卷"},"example":{"text":"你不能这样～。"},"similar":["损人利己"],"opposite":["损己利物"],"usage":"作谓语、定语；指损人利己"},{"id":21928,"word":"损公肥私","pinyin":"sǔn gōng féi sī","abbr":"sgfs","explanation":"损害公家的利益而使私人获利。","source":{"text":"在群众中，有些人损公肥私，无理取闹。","book":"《新华月报》1979年第1期"},"example":{"text":"我们不能～。"},"similar":["假公济私","损人利己"],"opposite":["大公无私"],"usage":"作谓语、宾语、定语；指私心重"},{"id":21929,"word":"损兵折将","pinyin":"sǔn bīng zhé jiàng","abbr":"sbzj","explanation":"损：损失。军士和将领都遭到损失。指打了败仗。","source":{"text":"俺如今领兵与他交战，丞相也枉则损兵折将。","book":"元·无名氏《千里独行》第三折"},"example":{"text":"若得太尉早来如此，也不教国家～，虚耗了钱粮。","book":"明·施耐庵《水浒全传》第八十二回"},"similar":["赔了夫人又折兵","损军折将"],"opposite":["大获全胜"],"usage":"作谓语、定语；指打了败仗"},{"id":21930,"word":"损军折将","pinyin":"sǔn jūn zhé jiàng","abbr":"sjzj","explanation":"犹损兵折将。兵士和将领都有损失。指作战失利。","source":{"text":"不争你和他相持，损军折将，则不如紧守城池。","book":"元·无名氏《乐毅图齐》第一折"},"example":{"text":"且言崇侯虎恃才妄作，提兵征伐，孰知今日～，心甚惭愧；只得将败残军兵收聚，扎下行营，郁郁不乐。","book":"明·许仲琳《封神演义》第二回"},"similar":["损兵折将","败兵折将"],"opposite":["大获全胜"],"usage":"作谓语、定语；指打了败仗"},{"id":21931,"word":"损己利人","pinyin":"sǔn jǐ lì rén","abbr":"sjlr","explanation":"损害自己，使别人得利。","source":{"text":"孝友忠信，损己利人，胜似今世称学道者。","book":"明·李贽《与庄纯夫书》"},"example":{"text":"无论从旧道德，从新道德，只要是～的，他就挑选上，自己背起来。","book":"鲁迅《南腔北调集·为了忘却的记念》"},"opposite":["损人利己"],"usage":"作谓语、定语、宾语；用于处事"},{"id":21932,"word":"损己利物","pinyin":"sǔn jǐ lì wù","abbr":"sjlw","explanation":"物：指别人。克制自己，利于别人。","source":{"text":"则温枕扇席，无替于晨昏；损己利物，有助于名教。","book":"《周书·孝义传序》"},"example":{"text":"她专干～的事情。"},"opposite":["损人利己"],"usage":"作谓语、定语；指大公无私"},{"id":21933,"word":"损有余补不足","pinyin":"sǔn yǒu yú bǔ bù zú","abbr":"syybbz","explanation":"损：减少。减少多余的，添补不足的。原指古代道家的一种平均思想。后也泛指一般的填平补齐。","source":{"text":"天之道，损有余而补不足。","book":"《老子》第七十七章"},"example":{"text":"借这些世间余财，聊救贫人，正所谓～，天道当然。","book":"明·凌濛初《二刻拍案惊奇·神偷寄兴一枝梅》"}},{"id":21934,"word":"损本逐末","pinyin":"sǔn běn zhú mò","abbr":"sbzm","explanation":"犹舍本逐末。谓抛弃根本，专在枝节上用功夫。","source":{"text":"损本逐末，流遍华壤，递相师祖，久而愈扇。","book":"《隋书·李谔传》"},"example":{"text":"你这是～的做法。"},"similar":["舍本逐末"],"usage":"作谓语、宾语、定语；指本末倒置","story":["隋朝初年，治书侍御史李谔文章写得好，口才也好。他担心受南北朝时期华美浮艳文风的影响，只注重华丽词藻、吟风嘲月的人因此而受到重用，这是失却根本，追逐枝节。朝廷不能选拔真正的人才，他的上书没有得到重视"]},{"id":21935,"word":"损阴坏德","pinyin":"sǔn yīn huài dé","abbr":"syhd","explanation":"损：亏损。指亏心伤德。","source":{"text":"如今有这机会，不如给他们几两银子盘费，各自去罢。当日祖宗手里都是有这例的。咱们如今损阴坏德，而且还小器。","book":"清·曹雪芹《红楼梦》第五十八回"}},{"id":21936,"word":"换斗移星","pinyin":"huàn dǒu yí xīng","abbr":"hdyx","explanation":"改变星斗的位置。比喻手段高超，神通广大。","source":{"text":"佛祖命脉，列圣钳锤，换斗移星，经天纬地。","book":"宋·克勤《圆悟佛果禅师语录》第十七卷"},"example":{"text":"不怕你有喜新厌旧的心肠，我自有～，手段。","book":"清·文康《儿女英雄传》第二十七回"},"usage":"作谓语、定语；用于比喻句"},{"id":21937,"word":"换日偷天","pinyin":"huàn rì tōu tiān","abbr":"hrtt","explanation":"比喻暗中改变事物的真相，以达到蒙混欺骗的目的。","source":{"text":"叵耐狂生诗太狂，只愁谤语外传扬，但凭换日偷天手，难免嘲风弄月殃。","book":"明·屠隆《彩毫记·宫禁生谗》"},"similar":["偷天换日"],"usage":"作谓语、定语；指欺骗"},{"id":21938,"word":"换柳移花","pinyin":"huàn liǔ yí huā","abbr":"hlyh","explanation":"把一种花木的枝条或嫩芽嫁接在另一种花木上。比喻暗中用手段更换人或事物来欺骗别人。","source":{"text":"同窗友认假作真，女秀才移花接木。","book":"明·凌濛初《二刻拍案惊奇》卷十七"},"example":{"text":"试看瞒神吓鬼，何难～，得价由吾卖。","book":"清·蒋士铨《空谷香》第五出"}},{"id":21939,"word":"换汤不换药","pinyin":"huàn tāng bù huàn yào","abbr":"htbhy","explanation":"煎药的水换了，但是药方却没有变。比喻名称或形式虽然改变了，内容还是老一套。","source":{"text":"那郎中看了，依旧换汤不换药的拿出两个纸包来。","book":"清·张南庄《何典》第三回"},"example":{"text":"去了一个段派，复来了一个段派，仍然是～。","book":"蔡东藩、许廑父《民国通俗演义》第一百十五回"},"opposite":["翻天覆地"],"usage":"作谓语、分句；比喻名称或形式改变实际不变"},{"id":21940,"word":"换羽移宫","pinyin":"huàn yǔ yí gōng","abbr":"hyyg","explanation":"见“移宫换羽”。亦作“移商换羽”。谓乐曲换调。宫、商、羽均为古代乐曲五音中之音调名。后也比喻事情的内容有所变更。","source":{"text":"洞房春暖，换羽移宫，珠圆丝莹。","book":"宋·杨无咎《点绛唇（小阁清幽）》词：“换羽移宫，绝唱谁能和。”元·虞集《烛影摇红（雪映虚檐）》词"},"example":{"text":"～万里愁，珠歌翠舞古梁州。","book":"清·吴伟业《圆圆曲（鼎湖当日弃人间）》词"}},{"id":21941,"word":"换骨夺胎","pinyin":"huàn gǔ duó tāi","abbr":"hgdt","explanation":"比喻诗文活用古人之意，推陈出新。","source":{"text":"然不易其意而造其语，谓之换骨法；窥入其意而形容之，谓之夺胎法。","book":"宋·释惠洪《冷斋夜话·换骨夺胎法》"},"example":{"text":"他临摹古画有～之妙，当然能够乱真。"},"similar":["脱胎换骨","夺胎换骨"],"usage":"作谓语、定语；用于诗文等","story":["换骨夺胎原是道家传说吃了金丹换去凡骨凡胎后成仙。古代文人借用以前古文的意思用自己的语言去表达，黄庭坚认为这是换骨法，深入研究古文的原意进一步加以刻划形容，这叫夺胎法。也有人说不蹈古人一言一句，用夺胎换骨法可以点铁成金"]},{"id":21942,"word":"换骨脱胎","pinyin":"huàn gǔ tuō tāi","abbr":"hgtt","explanation":"原为道教用语。指修道者得道以后，就转凡胎为圣胎，换凡骨为仙骨。现比喻通过教育，思想得到彻底改造。","source":{"text":"换骨脱胎归旧路，返童颜。","book":"金·侯善渊《杨柳枝·丱岁飘蓬住远山》词"},"similar":["脱胎换骨","抽胎换骨","脱骨换胎"],"usage":"作谓语、状语；指彻底改变"},{"id":21943,"word":"捣枕捶床","pinyin":"dǎo zhěn chuí chuáng","abbr":"dzcc","explanation":"烦躁，无奈，气愤或悲痛的样子。形容辗转难以入睡。同“捣枕槌床”。","source":{"text":"睡不着如翻掌，少可有一万声长吁短叹，五千遍捣枕捶床。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"～的夜晚不好过。"},"similar":["捶床捣枕"],"usage":"作谓语、宾语、状语；指难以入睡"},{"id":21944,"word":"捣枕槌床","pinyin":"dǎo zhěn chuí chuáng","abbr":"dzcc","explanation":"烦躁，无奈，气愤或悲痛的样子。形容辗转难以入睡。","source":{"text":"少可有一万声长吁短叹，五千遍捣枕槌床。","book":"元·王实甫《西厢记》第一本第二折"}},{"id":21945,"word":"捣虚批吭","pinyin":"dǎo xū pī háng","abbr":"dxph","explanation":"乘虚攻击敌人要害。同“批亢捣虚”。","source":{"text":"这一个田穰苴立兵书有智量，这一个下齐城捣虚批吭。","book":"明无名氏《十样锦》第三折"},"example":{"text":"夫声东击西者，贼寇之奸态也；～者，兵家之长策也。","book":"《旧唐书·裴矩传》"},"similar":["批吭捣虚"],"usage":"作谓语、定语；指攻击"},{"id":21946,"word":"捣虚披吭","pinyin":"dǎo xū pī háng","abbr":"dxpk","explanation":"捣虚：利用敌人空虚的地方攻击；吭：咽喉，比喻要害。攻击敌人空虚或要害的地方。","source":{"text":"准备着布纲张罗擒猛兽，捣虚披吭建功劳。","book":"元·无名氏《五马破曹》第一折"}},{"id":21947,"word":"捣虚撇抗","pinyin":"dǎo xū piē kàng","abbr":"dxpk","explanation":"指乘虚攻击。","source":{"text":"元·范居中《金殿喜重重·风雨秋堂套》：终日悬望，恰原来捣虚撇抗，误我一向，到此谗知言是谎。"}},{"id":21948,"word":"捣虚敌随","pinyin":"dǎo xū dí suí","abbr":"dxds","explanation":"捣虚：利用敌人空虚的地方攻击。攻击敌人空虚的地方，敌人便会跟着我方的行动转。这是一种变袪为主动调动敌人的一种战略。","source":{"text":"攻其敌，敌必从，捣其虚，敌必随。","book":"清·马慧裕《武备集要》"}},{"id":21949,"word":"捧到天上","pinyin":"pěng dào tiān shàng","abbr":"pdts","explanation":"比喻吹捧过分。","example":{"text":"你竟把这位王主任～了。"},"similar":["捧上天"],"usage":"作谓语、定语；用于拍马等"},{"id":21950,"word":"捧土加泰山","pinyin":"pěng tǔ jiā tài shān","abbr":"ptjts","explanation":"捧：两手承托；加：增加。用手捧土增加泰山的高度。比喻不自量力。","source":{"text":"臣赐何敢甚言，尚虑不及耳！臣誉仲尼，譬犹两手捧土而附泰山，其无益亦明矣；使臣不誉仲尼，譬犹两手杷泰山，无损亦明矣。","book":"汉·韩婴《韩诗外传》卷八"}},{"id":21951,"word":"捧头鼠窜","pinyin":"pěng tóu shǔ cuàn","abbr":"ptsc","explanation":"抱着脑袋，象老鼠似地逃窜。形容仓皇逃跑的狼狈相。","source":{"text":"常山王背项王，奉项婴头而窜，逃归于汉王。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"天威在上贼胆破，～吁可哀。","book":"宋·陆游《闻虏酋遁归漠北》"},"similar":["抱头鼠窜","奉头鼠窜"],"usage":"作谓语、定语、状语；形容敌人的狼狈相"},{"id":21952,"word":"捧心效西子","pinyin":"pěng xīn xiào xī zǐ","abbr":"pxxxz","explanation":"效：仿效。丑人用手扪着胸口学西施模样，反而愈显其丑。比喻胡乱模仿，效果极坏。","source":{"text":"故西施病心而颦，其里之丑人见而美之，归亦捧心而颦。其里之富人见之，坚闭门而不出；贫人见之，絜妻子而去之走。","book":"《庄子·天运》"},"example":{"text":"我岂医巫魇胜者耶？汝欲自～耳。","book":"清·蒲松龄《聊斋志异·嫦娥》"}},{"id":21953,"word":"捧心西子","pinyin":"pěng xīn xī zǐ","abbr":"pxxz","explanation":"西子：春秋时越国美女西施。西子因心痛而捧心皱眉，仍然显得很漂亮。形容美女娇弱之态。","source":{"text":"故西施病心而颦，其里之丑人见而美之，归亦捧心而颦。其里之富人见之，坚闭门而不出；贫人见之，絜妻子而去之走。","book":"《庄子·天运》"},"example":{"text":"出浴太真冰作影，～玉为魂。","book":"清·曹雪芹《红楼梦》第三十七回"},"usage":"作宾语、定语；用于比喻句"},{"id":21954,"word":"捧檄色喜","pinyin":"pěng xí sè xǐ","abbr":"pxsx","explanation":"檄：古代官府用以征召、晓喻或声讨的文书。指接到委任官职的通知而喜形于色。","source":{"text":"东汉毛义家贫，以孝出名，府檄召义为守令。义捧檄色喜。后其母死，辞职不干。","book":"《后汉书·刘平等传序》"},"example":{"text":"贤士原不可测，往日～，实是为亲屈志；今乃知毛君节操，实异常人！","book":"蔡东藩《后汉演义》第三十一回"}},{"id":21955,"word":"捧毂推轮","pinyin":"pěng gǔ tuī lún","abbr":"pgtl","explanation":"扶着车毂推车前进。古代帝王任命将帅时的隆重礼遇。","source":{"text":"燕王并大臣捧毂推轮，邀乐毅上黄金台，受天子百官之礼，与乐毅挂印为帅。","book":"《七国春秋平话》卷上"},"example":{"text":"一遇汉祖，筑坛拜将，～，后封王爵以酬其功。","book":"明·冯梦龙《喻世明言》第三十一卷"},"usage":"作谓语、宾语；用于书面语"},{"id":21956,"word":"捧腹大笑","pinyin":"pěng fù dà xiào","abbr":"pfdx","explanation":"用手捂住肚子大笑。形容遇到极可笑之事，笑得不能抑制。","source":{"text":"司马季主捧腹大笑曰：‘观大夫类有道术者，今何言之陋也，何辞之野也！’","book":"西汉·司马迁《史记·日者列传》"},"example":{"text":"王～。","book":"清·蒲松龄《聊斋志异·司文郎》"},"similar":["开怀大笑","令人捧腹"],"opposite":["号啕大哭"],"usage":"作谓语、状语；指笑声","story":["西汉时期，中大夫宋忠和博士贾谊来到东市拜访有名的占卜专家司马季之，见他在教弟子日月运行和阴阳吉凶的有关知识，他们被他的话吸引住了，问他为什么干此卑贱的工作。司马季之捧腹大笑道：“你们那些高官欺上瞒下、尔虞我诈就高贵吗？”"]},{"id":21957,"word":"捧腹轩渠","pinyin":"pěng fù xuān qú","abbr":"pfxq","explanation":"轩：高；渠：通“举”。原指幼儿高举两手欲就父母。后转为形容笑貌。","source":{"text":"东坡云：张融有言，不恨臣无二王法，恨二王无臣法。吾于黔安亦云然。他日，黔安见之，当捧腹轩渠也。","book":"宋·胡仔《苕溪渔隐丛话后集·山谷下》"},"usage":"作谓语、定语；用于书面语"},{"id":21958,"word":"捩手覆羹","pinyin":"liè shǒu fù gēng","abbr":"lsfg","explanation":"指手一动就把羹倒翻。比喻动辄闯祸。","source":{"text":"各有主张，私立名字，捩手覆羹，转喉触讳。凡所以使吾面目可憎、语言无味者，皆子之志也。","book":"唐·韩愈《送穷文》"}},{"id":21959,"word":"捬操踊跃","pinyin":"fǔ cāo yǒng yuè","abbr":"fcyy","explanation":"拍着手欢呼跳跃。形容喜悦兴奋的样子。","source":{"text":"鱼鳖禽兽闻之者，莫不张耳鹿骇，熊径鸟伸，鸱视狼顾，捬操踊跃。","book":"汉·马融《长笛赋》"}},{"id":21960,"word":"捭阖纵横","pinyin":"bǎi hé zòng héng","abbr":"bhzh","explanation":"捭阖，开合。纵横，合纵和连横的简称。以辞令探测、打动别人，在政治和外交上运用分化与争取的手段。","source":{"text":"捭阖纵横之人，其言辩以私。","book":"宋·李方叔《论文》"},"example":{"text":"元·胡忯遹《木兰花慢·赠歌妓》：“看～，东强西弱，一转危机。”"},"similar":["纵横捭阖"],"usage":"作宾语、定语；用于政治","story":["战国时期，各诸侯国之间都想对付秦国，但是他们的态度分为两派，以张仪为首的一帮人到处游说服从秦的领导，支持秦国统一六国，这一派叫横；以苏秦为首的鼓吹六国联合起来对付秦国的叫纵，但他们各自为政，最终被秦所灭"]},{"id":21961,"word":"据为己有","pinyin":"jù wéi jǐ yǒu","abbr":"jwjy","explanation":"将别人的东西拿来作为自己的。","source":{"text":"先从片进，累建大功，童贯占为己有欺瞒皇上。","book":"明·李开先《宝剑记》第二十四出"},"example":{"text":"话说袁伯珍见王德黼的矿山苗旺，有利可图，便想夺他的利权，～。","book":"清·无名氏《官场维新记》第六回"},"similar":["见利忘义","唯利是图","损人利己"],"opposite":["舍己为人","廉洁奉公","克己奉公"],"usage":"作谓语、宾语；指将不是自己的东西占有"},{"id":21962,"word":"据义履方","pinyin":"jù yì lǚ fāng","abbr":"jylf","explanation":"义：义理；履：遵循；方：方法。依据道义，遵循理法。指为人正直不苟。","source":{"text":"为人据义履方，邪席不坐，邪膳不食。","book":"晋·皇甫谧《高士传·许由》"},"example":{"text":"晋·皇甫谧《高士传·许由》：“为人据义履方，邪席不坐，邪膳不食。”"},"usage":"作谓语、定语；指为人正直"},{"id":21963,"word":"据图刎首","pinyin":"jù tú wěn shǒu","abbr":"jtws","explanation":"谓贪图未得的利益而断送自己的生命。","source":{"text":"使人左据天下之图而右刎喉，愚者不为也。","book":"《淮南子·泰笔训》"},"example":{"text":"且～，愚者不为；运斧全身，庸流所鉴。","book":"陈陵《使东魏值侯景乱与北齐尚书令求还记》"},"usage":"作宾语、定语；用于书面语"},{"id":21964,"word":"据徼乘邪","pinyin":"jù jiǎo chéng xié","abbr":"jjcx","explanation":"据：凭借；徼：侥幸；乘：趁；邪：不正当。指凭侥幸、乘邪险的道路来求得富贵。","source":{"text":"据徼乘邪，以求一日之富贵。","book":"汉·班固《答宾戏》"}},{"id":21965,"word":"据本生利","pinyin":"jù běn shēng lì","abbr":"jbsl","explanation":"根据本钱的多少来获取利息。","source":{"text":"凡民之贷，以国服为之息。疏曰：‘贷者，即今之举物生利，所出之利，各以其于国服事之税为息也。’周时，不据其赢多少，据本征利。","book":"《周礼·地官泉府》"}},{"id":21966,"word":"据梧而瞑","pinyin":"jù wǔ ér míng","abbr":"jwem","explanation":"梧：梧树；瞑：休息。靠着梧树休息。形容极其疲倦劳累的样子。","source":{"text":"故知尽虑穷，形劳神倦，或枝策假寐，或据梧而瞑。","book":"《庄子·齐物论》：“昭文之鼓琴也，师旷之枝策也，惠子之据梧也，三子之知几乎？”郭象注"}},{"id":21967,"word":"据水断桥","pinyin":"jù shuǐ duàn qiáo","abbr":"jsdq","explanation":"依靠河道阻断桥梁。形容胆识过人，勇敢善战。","source":{"text":"飞据水断桥，嗔目横矛曰：‘某是张益德也，可来共决死！’","book":"晋·陈寿《三国志·蜀志·张飞传》"},"example":{"text":"他有～的气魄。"},"usage":"作谓语、定语；指人勇敢","story":["公元208年，曹操率军攻打荆州，荆州刘琮投降曹操。刘备见势不妙就立即逃奔江南。曹操率军追至当阳的长坂坡，刘备丢下妻儿逃跑。张飞利用河道，站在桥上阻断曹军的进攻，他瞪起眼睛横握长矛，曹军不敢贸然行动。刘备得以逃脱"]},{"id":21968,"word":"据理力争","pinyin":"jù lǐ lì zhēng","abbr":"jllz","explanation":"依据道理，竭力维护自己方面的权益、观点等。","source":{"text":"老兄既管了一县的事，自己也应该有点主意。外国人呢，固然得罪不起，实在下不去的地方，也该据理力争。","book":"清·李宝嘉《文明小史》第三十八回"},"example":{"text":"我们再去～，非达到目的不走。","book":"巴金《家》八"},"similar":["力排众议","理直气壮"],"opposite":["强词夺理","理屈词穷"],"usage":"作谓语、宾语、状语；指努力争取"},{"id":21969,"word":"据经引传","pinyin":"jù jīng yǐn zhuàn","abbr":"jjyc","explanation":"据：依据；引：援引。引用经典书籍作为论证的依据。","source":{"text":"苟不取陈语以相证，恐听者益以骇愕，故凡论说，必据经引传，亦不得已焉耳。","book":"明·李贽《焚书·书答·复宋太守》"}},{"id":21970,"word":"据鞍读书","pinyin":"jù ān dú shū","abbr":"jads","explanation":"在马背或驴背上读书。后多形容学习勤奋。","source":{"text":"朝暮还往，常据鞍读书，至马惊坠地，损折支体，终亦不改。","book":"《北史·樊深传》"},"example":{"text":"江邻几调蓝山尉，骑驴赴官，每～，至迷失道，家人求之乃觉。","book":"《渊鉴类函·驴三》"},"usage":"作谓语、定语；指人勤奋"},{"id":21971,"word":"据鞍顾眄","pinyin":"jù ān gù miǎn","abbr":"jagm","explanation":"顾眄：回头看。在马背上回头看。形容年老而壮志不衰。","source":{"text":"援自请曰：‘臣尚能被甲上马。’帝令试之，援拒鞍顾眄，以示可用。帝笑曰：‘矍铄哉是翁地。’","book":"《后汉书·马援传》"},"example":{"text":"夙称幽燕老将，两臂能开八石弓，～，而意不衰，尚隐然有勒燕然、封狼胥之势者，必首推年台。","book":"明·朱泰祯《与某同年书》"}},{"id":21972,"word":"据高临下","pinyin":"jù gāo lín xià","abbr":"jglx","explanation":"凭借高处俯控低处，指凭仗优势地位足以控制别人。","source":{"text":"盖有土垒，则据高临下，敌必不克骤攻。","book":"清·郑观应《盛世危言·边防一》"},"example":{"text":"何况他们占东半球大陆的领袖地位，～……暗示全世纪以宇宙伟大的动力呢。","book":"瞿秋白《饿乡纪程》"},"similar":["居高临下"],"usage":"作谓语、定语；同“居高临下”"},{"id":21973,"word":"捰袖揎拳","pinyin":"luò xiù xuān quán","abbr":"lxxq","explanation":"形容怒气冲冲准备动武的样子。同“揎拳捰袖”。"},{"id":21974,"word":"捱三顶五","pinyin":"āi sān dǐng wǔ","abbr":"asdw","explanation":"形容人群拥挤，接连不断。","source":{"text":"覆帐之后，宾客如市，捱三顶五，不得空闲。","book":"明·冯梦龙《醒世恒言·卖油郎独占花魁》"},"similar":["捱三顶四"],"usage":"作定语；形容人多拥挤"},{"id":21975,"word":"捱三顶四","pinyin":"āi sān dǐng sì","abbr":"asds","explanation":"形容人群拥挤，接连不断。","source":{"text":"半仙到栅栏门首下马，也不进宅，径在堂中站着，众人捱三顶四，簇拥将来，一个个伸出手来，求太医看脉。","book":"《平妖传》第四回"},"example":{"text":"覆帐之后，宾客如市，捱三顶五，不得空闲。","book":"《醒世恒言·卖油郎独占花魁》"},"similar":["捱三顶五"],"usage":"作谓语、定语；形容人多拥挤"},{"id":21976,"word":"捱风缉缝","pinyin":"āi fēng qī fèng","abbr":"afqf","explanation":"指多方钻营，找门路。","source":{"text":"别个秀才要去结交县令，还要捱风缉缝，央人引见，拜在门下，认为老师。","book":"明·冯梦龙《醒世恒言·卢太学诗酒傲公侯》"},"example":{"text":"～的人往往容易获得实利。"},"similar":["挨风缉缝"],"usage":"作谓语、定语；指会钻营的人"},{"id":21977,"word":"捶床拍枕","pinyin":"chuí chuáng pāi zhěn","abbr":"ccpz","explanation":"形容辗转难以入睡。同“捶床捣枕”。","source":{"text":"他脾气越发坏了，不是捶床拍枕，就是咒天骂地。","book":"清·曾朴《孽海花》第三回"},"similar":["捶床捣枕"],"usage":"作谓语、宾语、状语；指难以入睡"},{"id":21978,"word":"捶床捣枕","pinyin":"chuí chuáng dǎo zhěn","abbr":"ccdz","explanation":"形容辗转难以入睡。","source":{"text":"风流鬼无奈……这一晚捶床捣枕，翻来翻去，如何睡得着。","book":"《捉鬼传》第七回"},"example":{"text":"《捉鬼传》第七回：“这一晚～，翻来覆去，如何睡得着。”"},"similar":["捶床拍枕"],"usage":"作谓语、宾语、状语；指难以入睡"},{"id":21979,"word":"捶胸跌脚","pinyin":"chuí xiōng diē jiǎo","abbr":"cxdj","explanation":"表示极为悲伤或悲愤。","source":{"text":"不是我炒炒闹闹，痛伤情捶胸跌脚。","book":"元·无名氏《冻苏秦》第二折"},"example":{"text":"八戒～，大叫道‘哥耶！倾了你也’","book":"《西游记》第六七回"},"similar":["捶胸跌足","捶胸顿足"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":21980,"word":"捶胸跌足","pinyin":"chuí xiōng diē zú","abbr":"cxdz","explanation":"表示极为悲伤或悲愤。","source":{"text":"只落的捶胸跌足空流泪。","book":"元·无名氏《杀狗劝夫》第二折"},"example":{"text":"老翁～道：‘眼面前错过了仙缘，悔之何及！’","book":"明·凌濛初《二刻拍案惊奇》第18卷"},"similar":["捶胸跌脚","捶胸顿脚"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":21981,"word":"捶胸跺脚","pinyin":"chuí xiōng duò jiǎo","abbr":"cxdj","explanation":"捶：敲打。捶击胸口，用脚跺地。指十分悲伤或痛愤。","source":{"text":"‘真正世界变了！’老通宝捶胸跺脚地没有办法。","book":"茅盾《春蚕》"},"similar":["捶胸顿脚","捶胸跌脚"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":21982,"word":"捶胸顿脚","pinyin":"chuí xiōng dùn jiǎo","abbr":"cxdj","explanation":"表示极为悲伤或悲愤。","source":{"text":"[何玉凤]拍着那棺材，捶胸顿脚，放声大哭。这场哭直哭得那铁佛伤心，石人落泪。","book":"《儿女英雄传》第十九回"},"example":{"text":"老寿说到这里，心里像是插了一把刀，他～地干号了起来。","book":"茹志鹃《剪辑错了的故事》"},"similar":["捶胸跌足","捶胸顿足"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":21983,"word":"捶胸顿足","pinyin":"chuí xiōng dùn zú","abbr":"cxdz","explanation":"捶：敲打；顿：跺。敲胸口，跺双脚。形容非常懊丧，或非常悲痛。","source":{"text":"我衷肠，除告天，奈天高，又不知，只落的捶胸顿足空流泪。","book":"元·萧德祥《杀狗劝夫》第二折"},"example":{"text":"孔明说罢，触动玄德衷肠，真个～，放声大哭。","book":"明·罗贯中《三国演义》第五十六回"},"similar":["呼天抢地","痛心疾首","椎心泣血"],"opposite":["眉开眼笑"],"usage":"作谓语、定语、状语；形容人焦急、悲伤"},{"id":21984,"word":"捶骨沥髓","pinyin":"chuí gǔ lì suǐ","abbr":"cgls","explanation":"比喻残酷搜括民财。同“敲骨吸髓”。","source":{"text":"今或重困疲羸，力求附益，捶骨沥髓，隳家取财，苟媚聚敛之司，以为仕进之路。","book":"唐·陆贽《论长吏以增户加税辟田为课绩》"},"similar":["槌骨沥髓","敲骨吸髓"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":21985,"word":"捷径窘步","pinyin":"jié jìng jiǒng bù","abbr":"jjjb","explanation":"捷径：近道；窘步：因行走太急而感到困难。比喻为了达到某种目的所采用的简便的速成办法，其结果并不理想。","source":{"text":"夫唯捷径以窘步。","book":"战国·楚·屈原《离骚》"},"example":{"text":"愿诸弟子守其师说，有所恢弘，以就其业，毋～为也。","book":"清·章炳麟《黄侃论学杂著序》"}},{"id":21986,"word":"捷报频传","pinyin":"jié bào pín chuán","abbr":"jbpc","explanation":"捷报：胜利的消息；频：屡次。胜利的消息不断地传来。","source":{"text":"华北大平原上捷报频传。以后大港油田、胜利油田，其他油田相继建成。","book":"徐迟《地质之光》"},"example":{"text":"奥运赛场上中国代表队～。"},"similar":["节节胜利"],"opposite":["节节败退"],"usage":"作谓语、状语；指不断胜利"},{"id":21987,"word":"捷足先得","pinyin":"jié zú xiān dé","abbr":"jzxd","explanation":"捷：快；足：脚步。比喻行动快的人先达到目的或先得到所求的东西。","source":{"text":"秦失其鹿，天下共逐之，于是高材疾足者先得焉。","book":"《史记·淮阴侯列传》"},"example":{"text":"尚炯笑着说：“自然是捷足者先得之。”","book":"姚雪垠《李自成》第一卷第二十六章"},"similar":["捷足先登"],"usage":"作谓语、定语；比喻行动快的人先达到目的"},{"id":21988,"word":"捷足先登","pinyin":"jié zú xiān dēng","abbr":"jzxd","explanation":"比喻行动快的人先达到目的或先得到所求的东西。","source":{"text":"秦失其鹿，天下共逐之，于是高材疾足者先得焉。","book":"《史记·淮阴侯列传》"},"example":{"text":"所谓秦人失鹿，～。","book":"清·叶稚斐《吉庆图传奇·会赴》"},"similar":["捷足先得"],"opposite":["姗姗来迟"],"usage":"作谓语、定语；指雷厉风行的人","story":["公元前197年，汉高祖刘邦带兵攻打巨鹿郡郡守陈豕希，韩信因为与陈关系好加上削爵有情绪就没去。刘邦的妻子吕后听信谗言，让萧何用计把韩信骗进长乐宫杀害。韩信临死时后悔没听蒯通的话。刘邦要处死蒯通，蒯通巧言被释无罪"]},{"id":21989,"word":"捷雷不及掩耳","pinyin":"jié léi bù jí yǎn ěr","abbr":"jlbjye","explanation":"犹迅雷不及掩耳。比喻事起突然，不及防备。","source":{"text":"此捷济上机，所谓捷雷不及掩耳。","book":"《晋书·苻坚载记上》"},"similar":["迅雷不及掩耳"],"usage":"作定语、分句；比喻来势凶猛"},{"id":21990,"word":"捻土为香","pinyin":"niǎn tǔ wéi xiāng","abbr":"ntwx","explanation":"捏泥成香。因不及备香，以此表示虔诚。","source":{"text":"捻土为香事有因，如今宜假不宜真。","book":"宋·曾敏行《独醒杂志》第五卷"},"example":{"text":"我也无那香，只是～，祷告神灵可怜见。","book":"元·郑廷玉《看钱奴》第一折"},"similar":["捻土焚香"],"usage":"作谓语、宾语；指人很虔诚"},{"id":21991,"word":"捻土焚香","pinyin":"niǎn tǔ fén xiāng","abbr":"ntfx","explanation":"因不及备香，以此表示虔诚。同“捻土为香”。","source":{"text":"我这里捻土焚香画地炉，我拜罢也忙瞻顾，多谢神灵佑护。","book":"元·孟汉卿《魔合罗》第一折"},"similar":["捻土为香"],"usage":"作谓语、宾语；指人很虔诚"},{"id":21992,"word":"捻着鼻子","pinyin":"niǎn zhé bí zǐ","abbr":"nzbz","explanation":"形容克制忍耐，受了气也不敢发作。","source":{"text":"朝奉带了舵公到汤少爷船上磕头，谢了说情的恩，捻着鼻子回船去了。","book":"清·吴敬梓《儒林外史》第43回"},"similar":["捏着鼻子","忍气吞声"],"usage":"作谓语；指人忍气吞声"},{"id":21993,"word":"捻神捻鬼","pinyin":"niǎn shén niǎn guǐ","abbr":"nsng","explanation":"形容惊慌害怕的样子。","source":{"text":"婆婆捻神捻鬼的叫噤声！","book":"明·冯梦龙《警世通言》第21卷"},"usage":"作谓语、定语；指害怕"},{"id":21994,"word":"捻脚捻手","pinyin":"niē jiǎo niǎn shǒu","abbr":"njns","explanation":"捻：通“捏”。手脚动作放轻。形容行动小心轻捷。","source":{"text":"门子只得捻脚捻手，把栓拽了，飞也似闪入房里躲了。","book":"明·施耐庵《水浒传》第四回"},"similar":["捏脚捏手"],"usage":"作谓语、状语；指手脚动作轻"},{"id":21995,"word":"掀天动地","pinyin":"xiān tiān dòng dì","abbr":"xtdd","explanation":"形容声势非常浩大，或巨大而彻底的变化。同“掀天揭地”。","source":{"text":"莱公两朝大臣，勋业之盛，掀天揭地。","book":"宋·辛敩《寇忠愍诗集后序》"},"example":{"text":"戎马～来，荆襄一路哭声哀。","book":"明·冯梦龙《喻世明言》卷二十二"},"similar":["掀天揭地","掀天斡地"],"usage":"作谓语、定语；指声势非常浩大"},{"id":21996,"word":"掀天扑地","pinyin":"xiān tiān pū dì","abbr":"xtpd","explanation":"可以撼动天地。形容声势非常浩大，或巨大而彻底的变化。也形容本领高强。","source":{"text":"老秦掀天扑地，只享十六年之安。","book":"宋·陈亮《与章德茂侍郎》"},"example":{"text":"做得来～，寨儿中鼎沸起。","book":"元·无名氏《云窗梦》第四折"},"usage":"作谓语、宾语；用于书面语"},{"id":21997,"word":"掀天揭地","pinyin":"xiān tiān jiē dì","abbr":"xtjd","explanation":"可以撼动天地。形容声势非常浩大，或巨大而彻底的变化。","source":{"text":"掀天揭地英雄手，拔石应宜似弄丸。","book":"宋·辛学《〈寇忠愍诗集〉后序》：“莱公两朝大臣，勋业之盛，掀天揭地。”明·施耐庵《水浒传》第二十八回"},"example":{"text":"欲做精金美玉的人品，定从烈火中煅来；思立～的事功，须向薄冰上履过。","book":"明·洪应明《菜根谭·修身》"},"similar":["翻天覆地","掀天动地","排山倒海"],"usage":"作谓语、定语；指声势非常浩大"},{"id":21998,"word":"掀天斡地","pinyin":"xiān tiān wò dì","abbr":"xtwd","explanation":"形容声势非常浩大，或巨大而彻底的变化。同“掀天揭地”。","source":{"text":"蜀江迸出岷山来，翻涛鼓浪成风雷。掀天斡地五千里，争赴东海相喧豗。","book":"宋·冯时行《遗夔门故旧》"},"similar":["掀天动地","掀天揭地"],"usage":"作谓语、定语；指声势非常浩大"},{"id":21999,"word":"掀拳裸袖","pinyin":"xiān quán luǒ xiù","abbr":"xqlx","explanation":"高举拳头，卷起衣袖。表示心情激动。","source":{"text":"行酒之间，说着许多豪杰勾当，掀拳裸袖，只恨相见之晚。","book":"明·凌濛初《二刻拍案惊奇》卷二十七"},"usage":"作谓语、状语；用于处事"},{"id":22000,"word":"掀雷决电","pinyin":"xiān léi jué diàn","abbr":"xljd","explanation":"掀：鼓荡；决：指迅速跳动。指雷鸣电闪。形容诗文气势宏伟，惊人耳目。","source":{"text":"愚尝览韩吏部歌诗累百首，其驱驾气势，若掀雷决电，撑抉于天地之垠。","book":"唐·司空图《题柳柳州集后》"},"usage":"作宾语、定语；用于比喻句"},{"id":22001,"word":"掀风作浪","pinyin":"xiān fēng zuò làng","abbr":"xfzl","explanation":"掀、作：引起。原指神话小说中妖魔鬼怪施展法术掀起风浪。后多比喻煽动情绪，挑起事端。","source":{"text":"乃风行涛作，水势浪奔壮。","book":"南朝·宋·谢灵运《山居赋》"},"example":{"text":"恁平白地～，恁空拳头拿三道两。","book":"明·茅僧昙《醉新丰·么》"}},{"id":22002,"word":"掀风播浪","pinyin":"xiān fēng bō làng","abbr":"xfbl","explanation":"掀起风波，传播浪潮。比喻煽动情绪，挑起事端。","source":{"text":"乃风行涛作，水势浪奔壮。","book":"南朝·宋·谢灵运《山居赋》"},"example":{"text":"这种说法一点根据都没有，你少在那里～，挑拨离间。"}},{"id":22003,"word":"掀风鼓浪","pinyin":"xiān fēng gǔ làng","abbr":"xfgl","explanation":"比喻煽动情绪，挑起事端。","source":{"text":"借着诺蒙坎停战协定的订立和日苏互不侵犯条约的传闻，掀风鼓浪，挑拨中苏两大民族间的感情。","book":"毛泽东《苏联利益和人类利益的一致》"},"example":{"text":"他最爱～，挑起事端。"},"similar":["兴风作浪"],"usage":"作谓语、宾语、定语；指挑起事端"},{"id":22004,"word":"掂斤估两","pinyin":"diān jīn gū liǎng","abbr":"djgl","explanation":"犹言掂斤播两。","source":{"text":"一饭之恩，报以千金，岂是掂斤估两的事？","book":"《隋唐演义》第九六回"},"similar":["掂斤播两"],"usage":"作谓语、定语；形容过分计较"},{"id":22005,"word":"掂斤抹两","pinyin":"diān jīn mò liǎng","abbr":"djml","explanation":"犹言掂斤播两。","source":{"text":"他更有截长补短的钉人钉，掂斤抹两的称人秤。","book":"明·朱有燉《小桃红》第一折"},"similar":["掂斤估两","掂斤播两"],"usage":"作谓语、定语；形容过分计较"},{"id":22006,"word":"掂斤播两","pinyin":"diān jīn bō liǎng","abbr":"djbl","explanation":"掂、播：托在掌上试轻重。比喻在小事情上过分计较。","source":{"text":"任凭人说短论长，他不怕掂斤播两。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"给他看也是枉然，非但不能照办，还要～，说些不相干的话。","book":"清·吴趼人《糊涂世界》第十回"},"similar":["斤斤计较"],"usage":"作谓语、定语；形容过分计较"},{"id":22007,"word":"掂梢折本","pinyin":"diān shāo shé běn","abbr":"dssb","explanation":"垫钱亏本。梢，钱的市语。","source":{"text":"休置俺这等掂梢折本的赔钱货，则守恁那远害全身的安乐窝。","book":"明·贾仲名《对玉梳》第二折"},"usage":"作谓语、定语、宾语；指亏本"},{"id":22008,"word":"掇乖弄俏","pinyin":"duō guāi nòng qiào","abbr":"dgnq","explanation":"卖弄乖巧风流。","source":{"text":"一个叫做轻薄鬼，生得体态轻狂，言语不实，最好掇乖弄俏。","book":"《捉鬼传》第七回"},"usage":"作谓语、定语；指卖弄自己"},{"id":22009,"word":"掇拾章句","pinyin":"duō shí zhāng jù","abbr":"dszj","explanation":"掇：拾取。摘取别人文章的句子。指东摘西抄地拼凑文章。"},{"id":22010,"word":"掇而不跂","pinyin":"duō ér bù qì","abbr":"debq","explanation":"掇：拾取；跂：抬起脚后跟站着。就近拾取，不必踮起脚跟企盼远处的。","source":{"text":"故遥而不闷，掇而不跂。","book":"《庄子·秋水》"}},{"id":22011,"word":"掇臀捧屁","pinyin":"duō tún pěng pì","abbr":"dtpp","explanation":"形容拍马讨好的丑态。","source":{"text":"白长吉自挨进了身子，无一日不来掇臀捧屁。","book":"明·冯梦龙《醒世恒言》卷二十五"},"example":{"text":"他如果现在还活着呢，咱每自然要借这点儿戚谊，～的支趋奉他。","book":"清·嬴宗季女《六月霜·张罗》"},"similar":["溜须拍马"],"usage":"作定语、补语；形容巴结别人"},{"id":22012,"word":"掇菁撷华","pinyin":"duō jīng xié huá","abbr":"djxh","explanation":"掇：拾取；菁：精华。撷：摘取。选取事物的精华。","source":{"text":"《文选》主于修辞，一知半解文章家有偏霸也；《文粹》掇菁撷华，迹选之鼓吹；《文鉴》主于政事，意不在文。","book":"清·黄宗羲《明文案序上》"},"usage":"作谓语、定语；用于做事"},{"id":22013,"word":"掇青拾紫","pinyin":"duō qīng shí zǐ","abbr":"dqsz","explanation":"指获取高官显位。青、紫，古时公卿的服色。","source":{"text":"况你颇有聪明，实指望掇青拾紫。我问你，至今功名何如？","book":"《歧路灯》第五二回"},"similar":["腰金衣紫"],"usage":"作宾语、定语；指有权势"},{"id":22014,"word":"授业解惑","pinyin":"shòu yè jiě huò","abbr":"syjh","explanation":"授：教授，传授；惑：疑难。教授学业，解除疑难。","source":{"text":"师者，所以传道、授业、解惑也。","book":"唐·韩愈《师说》"},"example":{"text":"～，务广先师之传；扬善进贤，用为圣主之报。","book":"宋·陆游《谢曾侍郎启》"},"similar":["传道授业"],"usage":"作谓语、宾语；用于教师等"},{"id":22015,"word":"授人以柄","pinyin":"shòu rén yǐ bǐng","abbr":"sryb","explanation":"把剑柄交给别人。比喻将权力交给别人或让人抓住缺点、失误，使自己被动。","source":{"text":"倒持泰阿，授楚其柄。","book":"东汉·班固《汉书·梅福传》"},"example":{"text":"委以耳目腹心，未有不倒持干戈，～者。","book":"清·纪昀《阅微草堂笔记·如是我闻一》"},"similar":["遗人口实","授柄于人"],"usage":"作谓语、定语；指使自己被动"},{"id":22016,"word":"授人口实","pinyin":"shòu rén kǒu shí","abbr":"srks","explanation":"授人：给人；口实：话柄。留给别人的话柄。多指供人攻击和非议的话柄。","source":{"text":"比年频致物论，四督失官，授人口实，宠反为辱。","book":"清·王闿运《致丁亲家书》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":22017,"word":"授受不亲","pinyin":"shòu shòu bù qīn","abbr":"ssbq","explanation":"授：给予；受：接受。旧指男女不能互相亲手递受物品。指儒家束缚男女的礼教。","source":{"text":"淳于髡曰：‘男女授受不亲，神情民？’孟子曰：‘礼也。’","book":"《孟子·离娄上》"},"example":{"text":"清·名教中人《好逑传》第六回：“我常常听见人说：‘男女～，礼也。’”"},"similar":["男女有别"],"usage":"作谓语、定语；指儒家束缚男女的礼教","story":["战国时期，齐国雄辩家淳于髡问孟子男女之间不用手递受物品是礼，那么嫂子掉进水里，小叔子用手去救是礼吗？孟子认为是礼。淳于髡又说天下的人都掉进水里，你为什么不去救？孟子回答说应该用道去救，而不是用手去救"]},{"id":22018,"word":"授手援溺","pinyin":"shòu shǒu yuán nì","abbr":"ssyn","explanation":"授手：给人以手，即伸手；溺：落水人。伸出手去救援落水的人。比喻救援苦难的人。","source":{"text":"天下溺，援之以道；嫂溺，授之以手。","book":"《孟子·离娄上》"},"example":{"text":"《邴原别传》：“实望根矩，仁为己任，～，振民于难。”"},"usage":"作谓语、定语；用于处事"},{"id":22019,"word":"授柄于人","pinyin":"shòu bǐng yú rén","abbr":"sbyr","explanation":"犹言授人以柄。比喻将权力交给别人或让人抓住缺点、失误，使自己被动。","source":{"text":"庶数年之后，可以自造自修，不至授柄于人。","book":"清·薛福成《创开中国铁路议》"},"example":{"text":"王朔《橡皮人》：“大概也觉得他的小伙计不够老练，说话造次，～，走上来隔开我们。”"},"similar":["授人以柄"],"usage":"作谓语、定语、宾语；指使自己被动"},{"id":22020,"word":"授职惟贤","pinyin":"shòu zhí wéi xián","abbr":"szwx","explanation":"授于职位只限有才德的人。","source":{"text":"晋、宋之后，只重门资，为奖人求官之风，乘授职惟贤之义。","book":"唐·薛登《请选举择贤才疏》"},"example":{"text":"领导干部的选拔要真正做到～。"},"similar":["任人唯贤"],"usage":"作谓语、定语、宾语；用于用人"},{"id":22021,"word":"掉三寸舌","pinyin":"diào sān cùn shé","abbr":"dscs","explanation":"掉：摆动，摇。玩弄口舌。多指进行游说。","source":{"text":"郦生一士，伏轼掉三寸之舌，下齐七十余城。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"我们不需要你来～。"},"usage":"作谓语、宾语；多指进行游说"},{"id":22022,"word":"掉书袋","pinyin":"diào shū dài","abbr":"dsd","explanation":"掉：摆动，摇动。指说话或写文章好引用古书言词来卖弄自己的学识渊博。","source":{"text":"对家人稚子，下逮奴隶，言必据书史，断章破句，以代常谈，俗谓之‘掉书袋’。","book":"《南唐书·彭利用传》"},"example":{"text":"不事斧凿，高则高矣，但时时～，要是一癖。","book":"宋·刘克庄《跋刘叔安感秋八词》"},"usage":"作谓语、定语、宾语；指显示自己"},{"id":22023,"word":"掉以轻心","pinyin":"diào yǐ qīng xīn","abbr":"dyqx","explanation":"掉：摆动；轻：轻率。对事情采取轻率的漫不经心的态度。","source":{"text":"故吾每为文章，未尝敢以轻心掉之。","book":"唐·柳宗元《答韦中立论师道书》"},"example":{"text":"由于这样，好些人就对于文学作品中另一方面的道理—装饰的美～了。","book":"秦牧《两只青蛙》"},"similar":["等闲视之","满不在乎","不屑一顾"],"opposite":["刮目相看","郑重其事"],"usage":"作谓语、宾语；用于否定句","story":["公元805年，唐代著名的文学家柳宗元被贬到永州当司马，韦刺史的孙子韦中立非常仰慕柳宗元，写信给他要拜师学艺。柳宗元治学特别严谨，作文章从不掉以轻心，他回信《答韦中立论师道书》，很详细与耐心阐述他治学的观点"]},{"id":22024,"word":"掉嘴弄舌","pinyin":"diào zuǐ nòng shé","abbr":"dzns","explanation":"指吵嘴。","source":{"text":"况且他是卖席子，你是做豆腐，各人做自家生理，何苦掉嘴弄舌，以至相争。","book":"明·天然智叟《石头点》卷六"},"usage":"作谓语、定语、宾语；指吵架"},{"id":22025,"word":"掉头不顾","pinyin":"diào tóu bù gù","abbr":"dtbg","explanation":"掉：摆动；顾：回头看，瞻望。摆动着手臂，头也不回。形容毫无眷顾，态度坚决。","source":{"text":"二公者，皆掉头不顾，只管衔杯。","book":"宋·刘过《沁园春·寄辛丞旨，时承旨招，不赴》"},"example":{"text":"他们会喜欢看你，不会像现在那样～了。","book":"茅盾《从牯岭到东京》"},"similar":["掉臂不顾"],"usage":"作谓语、定语；指人的态度"},{"id":22026,"word":"掉头鼠窜","pinyin":"diào tóu shǔ cuàn","abbr":"dtsc","explanation":"转过头来像老鼠一样逃窜。形容狼狈逃窜。","source":{"text":"他怎肯网开三面漫相遮，教我掉头鼠窜无宁帖。","book":"明·许自昌《水浒记·纵骑》"},"example":{"text":"敌人被打得～。"},"similar":["抱头鼠窜"],"usage":"作谓语、状语；指狼狈逃窜"},{"id":22027,"word":"掉臂不顾","pinyin":"diào bì bù gù","abbr":"dbbg","explanation":"掉：摆动。摆动着手臂，头也不回。形容毫无眷顾。","source":{"text":"日暮之后，过市朝者，掉臂而不顾。","book":"《史记·孟尝君列传》"},"example":{"text":"若优游无事，日逐往来，一旦有事，便～，岂是人之所为？（明·叶宪祖《鸾鎞记·仗侠》）"},"similar":["掉头不顾"],"usage":"作谓语、定语；指人的态度"},{"id":22028,"word":"掉舌鼓唇","pinyin":"diào shé gǔ chún","abbr":"dsgc","explanation":"炫耀口才，夸夸其谈。","source":{"text":"妆女的呈娇献媚，令人消魂；耍丑的掉舌鼓唇，令人捧腹。","book":"清·李绿园《歧路灯》第79回"},"example":{"text":"他一早就在教师里～。"},"similar":["夸夸其谈"],"usage":"作谓语；指夸夸其谈"},{"id":22029,"word":"掊斗折衡","pinyin":"pǒu dǒu zhé héng","abbr":"pdzh","explanation":"剖开量物的斗，折断称物的衡。指废除让人争多论少的斗衡。","source":{"text":"掊斗折衡，而民不争。","book":"《庄子·胠箧》"},"example":{"text":"故绝圣弃知，大盗乃止，擿玉毁珠，小盗不起，焚符破玺，而民朴鄙，～，而民不争。","book":"清·曹雪芹《红楼梦》第二十一回"},"usage":"作谓语、宾语；用于书面语"},{"id":22030,"word":"掌上明珠","pinyin":"zhǎng shàng míng zhū","abbr":"zsmz","explanation":"比喻接受父母疼爱的儿女，特指女儿。","source":{"text":"昔君视我，如掌中珠，何意一朝，弃我沟渠。","book":"晋·傅玄《短歌行》"},"example":{"text":"乳名黛玉，年方五岁，夫妻爱之如～。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["心肝宝贝"],"opposite":["视若敝屣"],"usage":"作宾语、定语；指儿女"},{"id":22031,"word":"掌上珍珠","pinyin":"zhǎng shàng zhēn zhū","abbr":"zszz","explanation":"放在手掌里的珍珠。比喻接受父母疼爱的儿女，特指女儿。","source":{"text":"昔君视我，如掌中珠，何意一朝，弃我沟渠。","book":"晋·傅玄《短歌行》"},"example":{"text":"那隐帝顿足捶胸，伤悼不止，就像真的失了无价至宝、～，登时传旨，埋葬了女乐尸首。（清·吴璿《飞龙全传》第四回）"},"similar":["掌上明珠"],"usage":"作宾语、定语；多指儿女等"},{"id":22032,"word":"掌上观文","pinyin":"zhǎng shàng guān wén","abbr":"zsgw","explanation":"比喻极其容易，毫不费力。","source":{"text":"曹操、孙权，吾视之若掌上观文，量此小县，何足介意！","book":"明·罗贯中《三国演义》第五十七回"},"similar":["掌上观纹"],"usage":"作宾语、定语；用于比喻句"},{"id":22033,"word":"掌上观纹","pinyin":"zhǎng shàng guān wén","abbr":"zsgw","explanation":"比喻极其容易，毫不费力。","source":{"text":"可不道状元郎怀中取物，觑富贵掌上观纹。","book":"元·关汉卿《陈母教子》第二折"},"example":{"text":"我觑那两员贼将，如～，探囊取物，师父放心，某擒拿走一遭去。","book":"明·无名氏《怒斩关平》头折"},"similar":["掌上观文"],"usage":"作宾语、定语；用于比喻句"},{"id":22034,"word":"掌声雷动","pinyin":"zhǎng shēng léi dòng","abbr":"zsld","explanation":"鼓掌的声音像打雷一样震动全场。形容非常热烈的欢乐场面。","source":{"text":"满厅掌声雷动中，忽然从外面气急败坏奔进一个人来，大家面色都吓变了。","book":"清·曾朴《孽海花》第三十五回"},"example":{"text":"顿时，全场一片掌声雷动，经久不息。"}},{"id":22035,"word":"掎挈伺诈","pinyin":"jǐ qiè sì zhà","abbr":"jqsz","explanation":"抓住人家过错，等待机会来陷害。","source":{"text":"有掎挈伺诈，权谋倾覆，以相颠倒，以靡敝之。","book":"《荀子·富国》"},"similar":["掎挈司诈"],"usage":"作谓语、定语；指抓小辫子"},{"id":22036,"word":"掎挈司诈","pinyin":"jǐ qiè sī zhà","abbr":"jqsz","explanation":"掎挈：指摘；司：同“伺”，侦候；诈：欺诈。抓住人家过错，等待机会来陷害。","source":{"text":"掎挈司诈，权谋倾覆，未免盗兵也。","book":"战国·赵·荀况《荀子·议兵》"},"similar":["掎挈伺诈"],"usage":"作谓语、定语；指抓小辫子"},{"id":22037,"word":"掎摭利病","pinyin":"jǐ zhí lì bìng","abbr":"jzlb","explanation":"掎摭：指摘；利病：好坏。形容品评善恶、好坏、利弊。","source":{"text":"刘季绪才不能逮于作者，而好诋呵文章，掎摭利病。","book":"三国·魏·曹植《与杨德祖书》"},"similar":["掎摭利弊"],"usage":"作谓语、宾语；用于书面语"},{"id":22038,"word":"掎裳连袂","pinyin":"jǐ cháng lián mèi","abbr":"jclm","explanation":"裙子牵住裙子，袖子连着袖子。形容人多。","source":{"text":"蹑踵侧户，掎裳连襼。","book":"晋·潘岳《藉田赋》"},"example":{"text":"袨服靓妆，继日而～；鲜车怒马，凌晨而结辙并駈。","book":"宋·刘从乂《重修开元寺行廊功德碑》"},"similar":["掎裳连襼"],"usage":"作宾语、定语；形容人多"},{"id":22039,"word":"掎裳连襼","pinyin":"jǐ shang lián zhēng","abbr":"jsly","explanation":"牵裙连袖。形容人多。","source":{"text":"蹑踵侧肩，掎裳连襼。","book":"晋·潘岳《藉田赋》"},"similar":["掎裳连袂"],"usage":"作宾语、定语；形容人多"},{"id":22040,"word":"掎角之势","pinyin":"jǐ jiǎo zhī shì","abbr":"jjzs","explanation":"掎：拉住，指拉住腿；角：指抓住角；掎角：夹击敌人。原指从两方面夹攻敌人。现比喻分出兵力，造成牵制敌人或互相支援的形势。","source":{"text":"譬如捕鹿，晋人角之，诸戎掎之，与晋掊之。","book":"《左传·襄公十四年》"},"example":{"text":"不若分兵屯小沛，守邳城，为掎角之势，以防曹操。","book":"明·罗贯中《三国演义》第二十二回"},"similar":["犄角之势"],"usage":"作宾语；比喻互相配合，两面夹击"},{"id":22041,"word":"掏沙壅河","pinyin":"tāo shā yōng hé","abbr":"tsyh","explanation":"壅：堆塞。比喻不毫无用处。","source":{"text":"不一命大将以扫丑虏而州郡稍稍肖役，连连不已。若排糠障风，掏沙壅河。","book":"汉·王符《潜夫论·救边》"}},{"id":22042,"word":"掐头去尾","pinyin":"qiā tóu qù wěi","abbr":"qtqw","explanation":"除去前头后头两部分，也比喻除去没有用的部分。","source":{"text":"一个月赶上俩节日，掐头去尾，一个月连半个月的活也干不上了！","book":"蒋子龙《拜年》"},"example":{"text":"他的记忆是血汗与苦痛砌成的，不能随便说着玩，一说起来也不愿～。","book":"老舍《骆驼祥子》二二"},"similar":["去头去尾"],"usage":"作谓语、宾语；用于事物有用部分"},{"id":22043,"word":"掐尖落钞","pinyin":"qiā jiān luò chāo","abbr":"qjlc","explanation":"乘机侵吞克扣经手的钱财。","source":{"text":"与我一百两钞，着我那姐夫张郎与我，他从来有些掐尖落钞，我数一数……则八十两钞。","book":"元·武汉臣《老生儿》楔子"},"example":{"text":"我们不能干这～的事情。"},"similar":["雁过拔毛"],"usage":"作谓语、定语；指克扣经手的钱财"},{"id":22044,"word":"排兵布阵","pinyin":"pái bīng bù zhèn","abbr":"pbbz","explanation":"指排列队伍，摆列战斗阵势。亦引申指安排、布置事情。","source":{"text":"执锐披坚领大兵，排兵布阵任非轻。","book":"元·郑光祖《三战吕布》第三折：“武艺精熟智量能，排兵布阵显威风。”元·无名氏《衣锦还乡》第一折"},"example":{"text":"安老爷、安太太便在这边暗暗的～，舅太太便在那边密密的引线穿针。","book":"清·文康《儿女英雄传》第二十四回"},"usage":"作谓语、宾语；指安排布置"},{"id":22045,"word":"排奡纵横","pinyin":"pái ào zòng héng","abbr":"pazh","explanation":"排奡：矫健的样子。指诗文书画笔力矫健奔放，不受约束。","source":{"text":"道济排奡纵横，以奔放胜；髡残沉着痛快，以谨严胜。","book":"《清史稿·髡残传》"},"usage":"作谓语、定语；用于人的风格"},{"id":22046,"word":"排山倒峡","pinyin":"pái shān dǎo xiá","abbr":"psdx","explanation":"排：排开；倒：翻倒。推开山岳，翻倒山峡。形容水势猛，力量强盛，声势浩大。","source":{"text":"但见城外水声淙淙，一望江湖，有排山倒峡之势。","book":"明·冯梦龙《东周列国志》第84回"},"similar":["排山倒海"],"usage":"作谓语、定语、状语；指声势浩大"},{"id":22047,"word":"排山倒海","pinyin":"pái shān dǎo hǎi","abbr":"psdh","explanation":"推开高山，翻倒大海。形容力量强盛，声势浩大。","source":{"text":"病势初来敌颇强，排山倒海也难当。","book":"《资治通鉴·齐纪高宗建武二年》：“昔世祖以回山倒海之威，步骑数十万，南临瓜步，诸郡尽降。”宋·杨万里《六月二十四日病起喜雨》"},"example":{"text":"这种～的巨潮，是任何顽固势力所不能抵挡得住的。","book":"邹韬奋《抗战以来·自动奋发的千万青年》"},"similar":["翻江倒海","翻天覆地"],"usage":"作谓语、定语、状语；指声势浩大"},{"id":22048,"word":"排山压卵","pinyin":"pái shān yā luǎn","abbr":"psyl","explanation":"比喻事情极容易成功，毫不费力。","source":{"text":"何邓执政，必为玄害，亦由排山压卵，以汤沃雪耳，奈何与之为亲？","book":"《晋书·列女传·杜有道妻严氏》"},"example":{"text":"闭口捕舍岂容遁，～孰与争！","book":"清·钱谦益《送马撰倩归会稽》诗"},"similar":["排山倒海"],"usage":"作谓语、定语、状语；指毫不费力"},{"id":22049,"word":"排忧解难","pinyin":"pái yōu jiě nàn","abbr":"pyjn","explanation":"排除忧愁，解除困难。","source":{"text":"各级党政负责同志，要经常深入学校，倾听广大师生的意见和呼声，为他们排忧解难。","book":"邓小平《把教育工作认真抓起来》"},"example":{"text":"进一步发挥舆论作用，为群众尽力～。"},"similar":["排难解纷"],"usage":"作谓语、宾语；指排除忧愁，解除困难"},{"id":22050,"word":"排患解纷","pinyin":"pái huàn jiě fēn","abbr":"phjf","explanation":"原指为人排除危难，解决纠纷。今指调停双方争执。同“排难解纷”。","source":{"text":"所谓贵于天下之士者，为人排患解纷而无取也！","book":"唐·崔知贤《三月三日宴王明府山亭》诗明·孙慎行序：“遗形却立，终希独善之资；排患解纷，未治随时之义。”明·余邵鱼《周朝秘史》第一百零九回"},"example":{"text":"其善用权谲，为人～率类此。","book":"清·吴伟业《柳敬亭传》"},"similar":["排难解纷"],"opposite":["搬弄是非"],"usage":"作谓语、定语；指为人排除危难"},{"id":22051,"word":"排愁破涕","pinyin":"pái chú pò tì","abbr":"pcpt","explanation":"排：推开；涕：泪水。推开忧愁，收住泪水。形容变忧愁为欢悦。","source":{"text":"且当视阴数箭，排愁破涕，人生乐耳，忧戚何为。","book":"《周书·王褒传》"},"usage":"作谓语、定语；指转忧为喜"},{"id":22052,"word":"排斥异己","pinyin":"pái chì yì jǐ","abbr":"pcyj","explanation":"排挤、清除和自己意见不同或不属于自己集团派系的人。","source":{"text":"顗见江绩亦以正直为仲堪所斥，知仲堪当逐异己，树置所亲。","book":"《晋书·殷顗传》"},"example":{"text":"至当路者借以～，遇有反唇则以优升杜其口。","book":"明·杨士聪《玉堂荟记》卷下"},"similar":["排除异己"],"usage":"作谓语、宾语、定语；用于处事"},{"id":22053,"word":"排沙简金","pinyin":"pái shā jiǎn jīn","abbr":"psjj","explanation":"排：除去；简：选取。拨开沙子来挑选金子。比喻从大量的东西中选取精华。","source":{"text":"潘文烂若披锦，无处不善；陆文若排沙简金，往往见宝。","book":"南朝宋·刘义庆《世说新语·文学》"},"similar":["披沙拣金","排沙见金"],"usage":"作谓语、定语；指从大量的东西中挑选精华","story":["晋朝时期，人们善于清谈，经常评论别人的作品。孙兴公认为潘岳的文采灿烂，如同张挂的锦绣，没有一处不美；陆机的文采如同去掉流沙捡起金子，常常遇到闪光的瑰宝"]},{"id":22054,"word":"排沙见金","pinyin":"pái shā jiàn jīn","abbr":"psjj","explanation":"比喻从大量的东西中选取精华。同“排沙简金”。","source":{"text":"元章之资，不减诸李，学力未到，任用天资。观其纤浓诡厉之态，犹排沙见金耳。","book":"清·项穆《书法雅言·资学·附评》"},"similar":["排沙简金"],"usage":"作谓语、定语；指从大量的东西中挑选精华"},{"id":22055,"word":"排糠障风","pinyin":"pái kāng zhàng fēng","abbr":"pkzf","explanation":"扬场而障住风，糠皮排去不了。比喻行动跟目的相反。","source":{"text":"不一命大将以扫丑虏而州郡稍稍肖役，连连不已。若排糠障风，掏沙壅河。","book":"汉·王符《潜夫论·救边》"},"similar":["南辕北辙"],"usage":"作宾语、定语；指行动跟目的相反"},{"id":22056,"word":"排门逐户","pinyin":"pái mén zhú hù","abbr":"pmzh","explanation":"挨家挨户。","source":{"text":"写出岳元帅父子受屈情由，排门逐户的分派，约齐蝎子，共上民表，要替岳爷申冤。","book":"清·钱彩《说岳全传》第六十一回"}},{"id":22057,"word":"排闼直入","pinyin":"pái tà zhí rù","abbr":"ptzr","explanation":"闼：门。推门就进去。指未经敲门得到许可就径直而入。","source":{"text":"群臣绛、灌等莫敢入。十余日，哙乃排闼直入，大臣随之。","book":"《史记·樊哙传》"},"example":{"text":"于是有一天清晨三点钟，带着从人，～，终于将张勋从床上唤了起来，见着了面。","book":"高阳《慈禧全传》一○八"}},{"id":22058,"word":"排除万难","pinyin":"pái chú wàn nán","abbr":"pcwn","explanation":"扫除重重障碍，克服各种困难。","source":{"text":"下定决心，不怕牺牲，排除万难，去争取胜利。","book":"毛泽东《愚公移山》"},"example":{"text":"总是主动挑起最艰巨最危险的任务，兢兢业业，～去圆满完成。","book":"邓小平《悼伯承》"},"similar":["誓死不二","矢志不移"],"opposite":["瞻前顾后","踌躇不前"],"usage":"作谓语、宾语、定语；指克服各种困难"},{"id":22059,"word":"排除异己","pinyin":"pái chú yì jǐ","abbr":"pcyj","explanation":"排挤、清除和自己意见不同或不属于自己集团派系的人。","source":{"text":"顗见江绩亦以正直为仲堪所斥，知仲堪当逐异己，树置所亲。","book":"《晋书·殷顗传》"},"example":{"text":"明年诸葛恪被杀后，孙峻、孙林兄弟相继专权，更加残暴，～，淫污宫廷。（吕振羽《简明中国通史》第十章）"},"similar":["排斥异己","摈斥异己"],"usage":"作谓语、宾语；指清除与自己意见不同的人"},{"id":22060,"word":"排难解纷","pinyin":"pái nàn jiě fēn","abbr":"pnjf","explanation":"原指为人排除危难，解决纠纷。今指调停双方争执。","source":{"text":"所贵于天下之士者，为人排患释难解纷乱而无取也。即有所取者，是商贾之人也，仲连不忍为也。","book":"《战国策·赵策三》"},"example":{"text":"况且～是我辈的常事，何足为奇。","book":"清·李渔《意中缘·设计》"},"similar":["排忧解难","息事宁人"],"opposite":["拨弄是非","搬弄是非"],"usage":"作谓语、定语；指为人排除危难","story":["公元前258年，秦国派兵包围了赵国国都邯郸，赵王向魏王求救。魏王派辛垣衍到邯郸劝赵国尊秦昭王为帝。齐国的鲁仲连听说此事就去见辛垣衍，讲秦称帝的诸多坏处。魏公子无忌夺权出兵解围，平原君酬谢鲁仲连为赵国排难解纷"]},{"id":22061,"word":"掘井及泉","pinyin":"jué jǐng jǐ quán","abbr":"jjjq","explanation":"掘：挖；及：到。挖井就要挖到泉眼之处。比喻做事善始善终。","source":{"text":"有为者辟若掘井，掘井九轫而及泉，犹为弃井也。","book":"《孟子·尽心上》"},"example":{"text":"～那用巧，磨砖作镜未为愚。","book":"宋·陆游《仰首座求钝庵诗》"},"usage":"作宾语、定语；用于处事"},{"id":22062,"word":"掘地寻天","pinyin":"jué dì xún tiān","abbr":"jdxt","explanation":"掘：挖；寻：找。挖地找天。比喻行为与目的相反，违反现实，不可能如愿。","source":{"text":"掘地讨天，虚空钉橛。","book":"《续指月录·常州华藏湛堂智深禅师》"},"example":{"text":"家缘事事待周全，更望一身成正果，～。","book":"元·王丹桂《炼丹砂》"}},{"id":22063,"word":"掘墓人","pinyin":"jué mù rén","abbr":"jmr","explanation":"挖墓穴埋葬死者的人。比喻摧毁旧制度的人。","example":{"text":"老百姓是丑恶腐败社会的～。"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":22064,"word":"掘墓鞭尸","pinyin":"jué mù biān shī","abbr":"jmbs","explanation":"挖开坟墓，鞭打尸体。形容凶恶或仇恨很深。","source":{"text":"伍子胥求昭王，既不得，力掘楚平王墓，出其尸，鞭之三百，然后已。","book":"西汉·司马迁《史记·伍子胥列传》"},"example":{"text":"他干～的事情不得人心。"},"usage":"作谓语、宾语、定语；用于仇恨很深","story":["春秋时期，伍子胥因父与兄被楚平王所杀逃到吴国，帮助吴王阖庐攻打楚国，五战五胜，打到楚国都城郢城，楚平王已死，伍子胥为报杀父之仇，掘墓鞭尸，友人反对，伍子胥说：“吾日莫途远，吾故倒行而逆施之。”"]},{"id":22065,"word":"掘室求鼠","pinyin":"jué shì qiú shǔ","abbr":"jsqs","explanation":"挖坏房子捉老鼠。比喻因小失大。","source":{"text":"坏塘以取龟，发屋而求狸，掘室而求鼠，割唇而治龋，桀跖之徒，君子不与。","book":"《淮南子·说山训》"},"similar":["竭泽而渔"],"usage":"作谓语、定语、宾语；指人做事方法不对"},{"id":22066,"word":"掞藻飞声","pinyin":"shǎn zǎo fēi shēng","abbr":"szfs","explanation":"掞：发舒；藻：辞藻；飞：飞扬；声：声誉。指施展文才，声誉远扬。","source":{"text":"今朝野之际，文场至广，掞藻飞声，森然林植。","book":"唐·萧颖士《赠韦司业书》"}},{"id":22067,"word":"掠人之美","pinyin":"lüè rén zhī měi","abbr":"lrzm","explanation":"掠：夺取。夺取别人的成绩、荣誉归自己所有。","source":{"text":"己恶而掠美为昏。","book":"《左传·昭公十四年》"},"example":{"text":"我不能～，《生活》周刊并不是由我创办的。","book":"邹韬奋《二十年来的经历·现实的教训》"},"similar":["冒名顶替","夺人之美"],"opposite":["成人之美"],"usage":"作谓语、宾语；指夺取别人的成绩"},{"id":22068,"word":"掠地攻城","pinyin":"lüè dì gōng chéng","abbr":"ldgc","explanation":"夺取地盘，攻战城池。形容向敌方进攻。","source":{"text":"勤王报国应无惮，掠地攻城也畏难。","book":"明·无名氏《精忠记·应诏》"},"example":{"text":"忠源着急万分，那赛大臣却雍容坐镇，视作没事模样，因此洪秀全～，势如破竹。","book":"蔡东藩《清史演义》第五十九回"},"similar":["攻城掠地","略地攻城"],"usage":"作谓语、宾语；指向敌方进攻"},{"id":22069,"word":"掠影浮光","pinyin":"lüè yǐng fú guāng","abbr":"lyfg","explanation":"指浮光掠影，浮于表面不深入。","source":{"text":"一个正视现实的人，不会只是去强调这掠影浮光，但亦决不故意去抹煞它。","book":"《新华日报》1943.8.28"},"similar":["浮光掠影"],"opposite":["一丝不苟"],"usage":"作宾语、定语；指轻浮不深入"},{"id":22070,"word":"掠是搬非","pinyin":"lüè shì bān fēi","abbr":"lsbf","explanation":"指搬弄是非。","source":{"text":"你如今掠是搬非，干讨得鬼哭神愁。","book":"明·无名氏《四贤记·挑斗》"},"similar":["搬弄是非"],"usage":"作谓语、定语、宾语；同“搬弄是非”"},{"id":22071,"word":"掠美市恩","pinyin":"lüě měi shì ēn","abbr":"lmse","explanation":"掠美：夺取别人的美名或功绩以为己有。市恩：买好，讨好。 指用别人的东西来买好。","source":{"text":"己恶而掠美为昏。","book":"《左传·昭公十四年》"},"example":{"text":"所谓曲意徇物，～，其用心要作甚？","book":"宋、　朱熹《朱子语类》卷二十九"}},{"id":22072,"word":"掠脂斡肉","pinyin":"lüè zhī wò ròu","abbr":"lzwr","explanation":"斡：转动。比喻极其残酷的剥削、搜刮。","source":{"text":"有叟有叟，暮投我宿。吁叹自语，云太苛酷。如何如何，掠脂斡肉。","book":"五代·贯休《酷吏词》"},"usage":"作谓语、宾语；用于贪官污吏等"},{"id":22073,"word":"探丸借客","pinyin":"tàn wán jiè kè","abbr":"twjk","explanation":"比喻游侠杀人报仇。","source":{"text":"长安中奸猾浸多，闾里少年群辈杀吏，受赇报仇，相与探丸为弹，得赤丸者斫武吏，得黑丸者斫文吏，白者主治丧。","book":"《汉书·酷吏传·尹赏》"},"example":{"text":"唐·卢照邻《长安古意》诗：“挟弹飞鹰杜陵北，～渭桥西。”"},"usage":"作谓语、宾语；用于书面语"},{"id":22074,"word":"探口而出","pinyin":"tàn kǒu ér chū","abbr":"tkec","explanation":"犹言脱口而出。不经考虑，随口说出。"},{"id":22075,"word":"探囊取物","pinyin":"tàn náng qǔ wù","abbr":"tnqw","explanation":"囊：口袋；探囊：向袋里摸取。伸手到口袋里拿东西。比喻能够轻而易举地办成某件事情。","source":{"text":"中国用吾为相，取江南如探囊中物尔。","book":"《新五代史·南唐世家》"},"example":{"text":"点小事，如～。","book":"梁斌《播火记》十二"},"similar":["轻而易举","手到擒来","十拿九稳"],"usage":"作谓语、定语；指很容易的事","story":["五代时期，北方后周人韩熙载到南唐去做官，朋友李谷为他饯行，韩熙载想带兵平定中原，李谷说他如果当上宰相一定带兵像手伸进口袋里一样夺取江南。李谷被周世宗任命为将军进攻南唐，取得节节胜利，后来升为宰相"]},{"id":22076,"word":"探囊胠箧","pinyin":"tàn náng wú qiè","abbr":"tnqq","explanation":"用手摸袋子，撬开小箱子。指偷盗。","source":{"text":"将为胠箧探囊发匮之盗，而为守备，则必摄缄縢，固扃鐍。","book":"语出《庄子·胠箧》"},"example":{"text":"清·俞樾《右台仙馆笔记·江西李某》：“不敢相欺，某乃江湖所谓‘铁算盘’者也，不必～，而能以术取人财。”"},"similar":["胠箧探囊"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":22077,"word":"探头探脑","pinyin":"tàn tóu tàn nǎo)","abbr":"tttn","explanation":"探：头或上体向前伸出。伸着头向左右张望。形容鬼鬼祟祟的探望。","source":{"text":"时时去他那下探头探脑，心下也须疑它那下有个好处在。","book":"宋·朱熹《朱子语类·大学五》"},"example":{"text":"却好交五更时候，只见那个头陀挟着木鱼，来巷口～。","book":"明·施耐庵《水浒全传》第四十五回"},"similar":["东张西望","探头缩脑"],"usage":"作谓语、定语；指人小心窥探"},{"id":22078,"word":"探头缩脑","pinyin":"tàn tóu suō nǎo","abbr":"ttsn","explanation":"小心胆怯张望的样子。","source":{"text":"到了园中，果然阴气逼人。贾赦还扎挣前走，跟的人都探头缩脑的。","book":"清·曹雪芹《红楼梦》第102回"},"similar":["探头探脑"],"usage":"作谓语、定语；指人小心窥探"},{"id":22079,"word":"探奇穷异","pinyin":"tàn qí qióng yì","abbr":"tqqy","explanation":"探寻奇迹，穷游异处。指游览奇异的山水景物。","source":{"text":"小生一时探奇穷异，实出无心，若是就了此亲，外人不晓得的，尽道小生是有所贪求而为此，反觉无颜。","book":"明·凌濛初《初刻拍案惊奇》卷二十四"},"similar":["探异玩奇","探奇访胜"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":22080,"word":"探奇访胜","pinyin":"tàn qí fǎng shèng","abbr":"tqfs","explanation":"探寻奇迹，访求胜地。指游览或寻访山水名胜。","source":{"text":"最爱游山玩水，常常领了一群人到处探奇访胜。","book":"朱自清《经典常谈·诗第十二》"},"similar":["探奇穷异"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":22081,"word":"探奥索隐","pinyin":"tàn ào suǒ yǐn","abbr":"tasy","explanation":"犹探赜索隐。探究深奥的道理，搜索隐秘的事情。","source":{"text":"生者不知其始，成者不见其终，探奥索隐，孰窥其宗？","book":"《云笈七签》卷一"},"similar":["探赜索隐"],"usage":"作谓语；指探究深奥的道理"},{"id":22082,"word":"探幽穷赜","pinyin":"tàn yōu qióng zé","abbr":"tyqz","explanation":"探：寻求，探测；赜：幽深玄妙。探究深奥的道理，搜索隐秘的事情。","source":{"text":"抽演微言，启发道真。探幽穷赜，温故知新。","book":"《晋书·潘尼传》"},"usage":"作谓语、宾语；用于书面语"},{"id":22083,"word":"探幽索胜","pinyin":"tàn yōu suǒ shèng","abbr":"tyss","explanation":"探：寻求，探测；幽：幽深玄妙；索：搜求。探寻幽深奇异的景物。","source":{"text":"轻舟危樯，笑歌相闻，聂如鱼鳞，列如雁行。至其寻幽探奇，更泊互进，迭为后先，有若偶然而相从。","book":"宋·陆九渊《题新兴寺壁》"},"example":{"text":"素性好游，凡吴郡诸山，阅历殆遍；竹杖芒鞋，～，登涉之劳，所不惮也。","book":"清·王韬《淞隐漫录·妙香》"}},{"id":22084,"word":"探幽索隐","pinyin":"tàn yōu suǒ yǐn","abbr":"tysy","explanation":"探探究深奥的道理，搜索隐秘的事情。同“探赜索隐”。","source":{"text":"夫仁者乐，知者好诚，秉礼者探幽索隐。","book":"汉·袁康《越绝书·外传纪策考》"},"example":{"text":"学习上也要有～的精神。"},"similar":["探赜索隐"],"usage":"作谓语、定语；用于学问等"},{"id":22085,"word":"探异玩奇","pinyin":"tàn yì wán qí","abbr":"tywq","explanation":"探寻异处，玩赏奇景。指游览奇异的山水景物。","source":{"text":"公之来思，探异玩奇，茇野憩林，而民悦之。","book":"唐·刘禹锡《含辉洞述》"},"similar":["探奇访胜"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":22086,"word":"探手可得","pinyin":"tàn shǒu kě dé","abbr":"tskd","explanation":"探：向前伸出。一伸手就可以得到。形容不费力气。","source":{"text":"自谓状元探手可得，岂知时运不济，榜上无名。","book":"元·曾瑞卿《留鞋记》楔子"},"example":{"text":"这是～的事情。"},"similar":["探囊取物","手到擒来"],"usage":"作谓语、定语；指轻而易举"},{"id":22087,"word":"探本溯源","pinyin":"tàn běn sù yuán","abbr":"tbsy","explanation":"比喻探求、追溯事物的根本、源头。同“探本穷源”。","source":{"text":"它对语词的探本溯源工作，作得还不到家。","book":"刘叶秋《中国字典史略》第五章第三节"},"similar":["探本穷源"],"usage":"作谓语、宾语、定语；用于处事"},{"id":22088,"word":"探本穷源","pinyin":"tàn bēn qióng yuán","abbr":"tbqy","explanation":"探：求索；本：树根；穷：探寻；源：水源。寻找树根水源。比喻探求、追溯事物的根本。","source":{"text":"一来可以扩扩眼界，长长见识。二来也可以把工艺一项探本穷源。","book":"清·李宝嘉《文明小史》第五十一回"},"similar":["探本溯源"],"usage":"作谓语、宾语、定语；用于处事"},{"id":22089,"word":"探汤手烂","pinyin":"tàn tāng shǒu làn","abbr":"ttsl","explanation":"汤：开水。把手伸进开水里就会把手烫烂。比喻冒险者不免要吃亏。","source":{"text":"又尝煮水令沸，以金指环投汤中，然后以手探汤：其直者，手不烂，有罪者，入汤即焦。","book":"晋·干宝《搜神记》卷二"}},{"id":22090,"word":"探汤蹈火","pinyin":"tàn tāng dǎo huǒ","abbr":"ttdh","explanation":"犹言赴汤蹈火。比喻不怕任何艰险。","source":{"text":"以桀诈尧，譬之若以卵投石，以指挠沸，若赴水火，入焉焦没耳。","book":"《荀子·议兵》"},"similar":["赴汤蹈火"],"usage":"作谓语、状语；比喻奋不顾身"},{"id":22091,"word":"探渊索珠","pinyin":"tàn yuān suǒ zhū","abbr":"tysz","explanation":"到深渊下去取得骊龙的宝珠。比喻探求事物的真义。","source":{"text":"恐非发石取玉，探渊索珠之谓也。","book":"宋·张君房《云笈七签》第109卷"},"example":{"text":"她在文字上反复～，力求完美。"},"similar":["探骊获珠"],"usage":"作谓语、宾语、定语；用于写作等"},{"id":22092,"word":"探源溯流","pinyin":"tàn yuán sù liú","abbr":"tysl","explanation":"探：探索；溯：追寻；流：源流。探索和寻求事物的根源。","source":{"text":"为诗要穷源溯流，先辨诸家之派。","book":"清·王士禛《然灯记闻》"}},{"id":22093,"word":"探玄珠","pinyin":"tàn xuán zhū","abbr":"txz","explanation":"探：摸取；玄珠：黑珍珠。比喻不懂装懂，一知半解。","source":{"text":"昔人闻赤水中有玄珠也，相与沐而探之。","book":"《叔苴子·外编》"},"example":{"text":"～者到底要原形毕露。"},"similar":["不懂装懂"],"usage":"作宾语、定语；用于接触新事物","story":["从前人们听说赤水里产玄珠，都潜水下去摸取。有人摸到螺蛳，有人摸到蚌壳，有人摸到鹅卵石，有人摸到瓦片。他们都以为自己摸到了玄珠。象罔听后大笑他们无知。他们则联合起来围攻象罔。象罔没法，只好躲到黄帝那儿三年不敢出门"]},{"id":22094,"word":"探竿影草","pinyin":"tàn gān yǐng cǎo","abbr":"tgyc","explanation":"探竿、影草、都是渔民使鱼聚集后下网捕捞之法。佛教禅宗借以喻启发性的随宜施教。","source":{"text":"有时一喝，如踞地金毛狮子；有时一喝，如探竿影草；有时一喝，不作一喝用。","book":"《镇州临济慧照禅师语录》"},"usage":"作宾语、定语；多用于比喻句"},{"id":22095,"word":"探观止矣","pinyin":"tàn guān zhǐ yǐ","abbr":"tgzy","explanation":"用来赞美看到的事物好到了极点。"},{"id":22096,"word":"探赜索隐","pinyin":"tàn zé suǒ yǐn","abbr":"tzsy","explanation":"探：寻求，探测；赜：幽深玄妙；索：搜求；隐：隐秘。探究深奥的道理，搜索隐秘的事情。","source":{"text":"探赜索隐，钩深致远，以定天下之吉凶。","book":"《周易·系辞上》"},"example":{"text":"惟群治之进，礼俗之源，～，鲜有专家。","book":"刘师培《论中土文字有益于世》"},"similar":["探幽索隐","探奥索隐"],"usage":"作谓语、定语；指探究深奥的道理"},{"id":22097,"word":"探赜索隐，钩深致远","pinyin":"tàn zé suǒ yǐn，gōu shēn zhì yuǎn","abbr":"tzsygszy","explanation":"探：寻求，探测；赜：幽深玄妙；索：搜求；隐：隐秘；致：招致。探究深奥的道理，搜索隐秘、深远的问题。","source":{"text":"探赜索隐，钩深致远，以定天下之吉凶，成天下之亹亹者，莫大乎蓍龟。","book":"《周易·系辞上》"}},{"id":22098,"word":"探赜钩深","pinyin":"tàn zé gōu shēn","abbr":"tzgs","explanation":"探索幽隐，求取深意。","source":{"text":"探赜索隐，钩深致远。","book":"语出《易·系辞上》"},"example":{"text":"汉·赵壹《非草书》：“～，幽赞神明，鉴天地之心，推圣人之情。”"},"similar":["探赜索隐"],"usage":"作谓语、定语；指探究深奥的道理"},{"id":22099,"word":"探骊得珠","pinyin":"tàn lí dé zhū","abbr":"tldz","explanation":"骊：古指黑龙。在骊龙的颔下取得宝珠。原指冒大险得大利。后常比喻文章含义深刻，措辞扼要，得到要领。","source":{"text":"取石来锻之。夫千金之珠，必在九重之渊，而骊龙颔下，子能得珠者，必遭其睡也。使骊龙而寤，子尚奚微之有哉？","book":"《庄子·列御寇》"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“我一定说实话，你老兄一开头就～了。”"},"similar":["探骊获珠"],"usage":"作宾语、定语；比喻做文章能扣紧主题","story":["战国时期有人去游说宋王，宋王一时糊涂相信了他，而且赐他十辆车。这人就骄傲地在庄周面前夸耀，庄周给他讲故事：有人在黄河得到一颗骊龙嘴里的珍珠，他父亲说他是趁骊龙睡着时偷到的，让他把珍珠砸了，以免骊龙来报复"]},{"id":22100,"word":"探骊获珠","pinyin":"tàn lí huò zhū","abbr":"tlhz","explanation":"骊：黑龙。《庄子·列御寇》记载：有个靠编织蒿草帘为生的人潜入深水，得一颗价值千金的珠。比喻诗文写作抓住了关键。","source":{"text":"四人探骊，子先获珠，所余麟角，何用！","book":"《古今诗话·探骊获珠》"},"similar":["探骊得珠"],"usage":"作宾语、定语；比喻做文章能扣紧主题","story":["唐朝时期，诗人元稹、刘禹锡、韦楚客等到乐天家做客，大家商量各作一首《金陵怀古》。刘禹锡一气呵成做成一首。元稹等感慨地说：“四人探骊，子先获珠，所余麟角，何用！”于是大家弃笔不做诗，开始喝酒作乐"]},{"id":22101,"word":"掣襟肘见","pinyin":"chè jīn zhǒu xiàn","abbr":"cjzj","explanation":"掣：牵拉；襟：衣襟。指捉襟见肘。形容身陷困境、窘迫不堪。","source":{"text":"边长兵寡，掣襟肘见。","book":"《明史·刘应节传》"},"similar":["捉襟见肘","掣襟露肘"],"usage":"作谓语、定语；指贫寒"},{"id":22102,"word":"掣襟露肘","pinyin":"chè jīn lù zhǒu","abbr":"cjlz","explanation":"掣：牵接。接一下衣襟胳膊肘儿就露出来。形容衣服破烂，生活贫困。","source":{"text":"边长兵寡，掣襟露肘。","book":"《明史·刘应节传》"},"example":{"text":"宗昭原是寒素之家，中了举，百务齐作的时候，去了这四十两银，弄得手里～。","book":"清·西周生《醒世姻缘传》"},"similar":["捉襟见肘","掣襟肘见"],"usage":"作谓语、定语；指贫寒"},{"id":22103,"word":"掤扒吊拷","pinyin":"bīng bā diào kǎo","abbr":"bbdk","explanation":"强行脱去衣服，捆绑并吊起来拷打。同“绷扒吊拷”。","source":{"text":"（张云）他敢怎的你。（唱）他将你掤扒吊栲施呈尽。（旦儿云）呸！我是他的夫人，他敢怎么的我？","book":"元·无名氏《渔樵记》第三折"},"example":{"text":"大尹升堂，验着衣领针线是实，明知无枉，喝教：‘用起刑来！’令招实情。～，备受苦楚，这些顽皮赖肉只不肯招。","book":"明·凌濛初《二刻拍案惊奇》卷五"}},{"id":22104,"word":"接三换九","pinyin":"jiē sān huàn jiǔ","abbr":"jshj","explanation":"旧时风俗，新嫁娘到夫家后，三朝要接回娘家一次，九朝要互送礼物，探望一次。","source":{"text":"你长大出嫁的时节，我与你打簪环，做铺盖，买梳子匣子，我当自家闺女一般接三换九。","book":"清·西周生《醒世姻缘传》第六十六回"},"usage":"作宾语、定语；用于婚俗"},{"id":22105,"word":"接三连四","pinyin":"jiē sān lián sì","abbr":"jsls","explanation":"接连不断。","source":{"text":"我又没逃了，这么连三接四的叫人来找。","book":"清·曹雪芹《红楼梦》第三十九回"},"example":{"text":"英兵闻警登城，～的开放大炮，招宝山上的英兵，又发炮相应。","book":"蔡东藩《清史演义》第五十四回"},"similar":["接二连三"],"usage":"作定语、状语；形容连续不断"},{"id":22106,"word":"接不上茬","pinyin":"jiē bù shàng chá","abbr":"jbsc","explanation":"接不上别人的话头说话，指不能继续下去。","example":{"text":"他的一连串问话让我～。"},"similar":["难以为继"],"usage":"作谓语、宾语；指不能继续下去"},{"id":22107,"word":"接二连三","pinyin":"jiē èr lián sān","abbr":"jels","explanation":"一个接着一个，接连不断。","source":{"text":"于是接二连三，牵五挂四，将一条街烧得如‘火焰山’一般。","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"满屋子的手都拱起来，膝关节和腿关节～地屈折，仿佛就要蹲了下去似的。","book":"鲁迅《彷徨·高老夫子》"},"similar":["接踵而至","接连不断"],"opposite":["后继无人","断断续续"],"usage":"作定语、状语；形容连续不断","story":["贾宝玉因父亲做主娶薛宝钗，林黛玉因此夭亡，贾宝玉得知后也大病一场，他吵着要去拜祭黛玉的灵柩，家人不同意。迎春已经出嫁，而且受到丈夫的虐待。元妃不幸病故，贾府的事情接二连三的发生，人们也就没心顾及大观园的事情了"]},{"id":22108,"word":"接应不暇","pinyin":"jiē yìng bù xiá","abbr":"jybx","explanation":"暇：空闲。指美景繁多，来不及观赏。后多形容来人或事情太多，应付不过来。","source":{"text":"普席又要吃酒，未免令人接应不暇了。","book":"清·李汝珍《镜花缘》第85回"},"similar":["应接不暇"],"usage":"作谓语、定语、状语；指十分忙碌"},{"id":22109,"word":"接木移花","pinyin":"jiē mù yí huā","abbr":"jmyh","explanation":"把一种花木的枝条或嫩芽嫁接在另一种花木上。比喻暗中用手段更换人或事物来欺骗别人。","source":{"text":"同窗友认假作真，女秀才移花接木。","book":"明·凌濛初《二刻拍案惊奇》卷十七"},"example":{"text":"恶书自是好身手，～掩先丑。","book":"清·叶兰《窃名器》诗"}},{"id":22110,"word":"接绍香烟","pinyin":"jiē shào xiāng yān","abbr":"jsxy","explanation":"香烟：祭祖时所燃的烟香。旧时比喻生养子孙，使家族繁衍不断。","source":{"text":"掐得这些少家私，却不曾生得个儿子，传授与他，接绍香烟。","book":"明·冯梦龙《醒世恒言》卷二十"},"similar":["接续香烟"],"opposite":["断子绝孙"],"usage":"作谓语、定语、宾语；用于繁衍后代"},{"id":22111,"word":"接续香烟","pinyin":"jiē xù xiāng yān","abbr":"jxxy","explanation":"香烟：祭祖时所燃的烟香。旧时比喻生养子孙，使家族繁衍不断。","source":{"text":"掐得这些少家私，却不曾生得个儿子，传授与他，接绍香烟。","book":"明·冯梦龙《醒世恒言》卷二十"},"example":{"text":"官人既然做了官，总以～为重，从此要早毕婚姻，成家立业要紧。","book":"清·石玉昆《三侠五义》第二十七回"},"similar":["接绍香烟"],"opposite":["断子绝孙"],"usage":"作谓语、定语、宾语；用于繁衍后代"},{"id":22112,"word":"接耳交头","pinyin":"jiē ěr jiāo tóu","abbr":"jejt","explanation":"接耳：嘴凑近耳朵；交头：头靠着头。形容靠得很近，低声交谈。","source":{"text":"便是那些服侍的，无不一个个接耳交头，颂扬赞赏。","book":"清·文康《儿女英雄传》第32回"},"example":{"text":"他们在～谈论什么。"},"similar":["交头接耳"],"usage":"作谓语、定语、状语；用于两人凑近低语"},{"id":22113,"word":"接袂成帷","pinyin":"jiē mèi chéng wéi","abbr":"jmcw","explanation":"袂：衣袖；帷：帷幕。衣襟可以连接成帷幕。形容城市繁华，人口众多。","source":{"text":"临淄之途，车毂，人戾摩，连衽成帷，举袂成幕，挥汗成雨。","book":"《战国策·齐策一》"},"example":{"text":"唐·张说《唐陈州龙兴寺碑》：“东门之下，～，觞宛丘之上，炫服成市，信豫章之郊一都会也。”"},"usage":"作谓语、定语；用于书面语"},{"id":22114,"word":"接贵攀高","pinyin":"jiē guì pān gāo","abbr":"jgpg","explanation":"攀：攀附；高：指居高位的人；贵：权贵。攀附接近高贵的人。","source":{"text":"成就了东床婿，伏低做小，宴会了西王母，接贵攀高。","book":"元·王子一《误入桃源》第四折"}},{"id":22115,"word":"接踵比肩","pinyin":"jiē zhǒng bǐ jiān","abbr":"jzbj","explanation":"踵：脚后跟。脚跟相接，肩膀相碰。形容人很多，相继不断。","source":{"text":"而今务进不避侥幸者，接踵比肩，布于文武之列。","book":"唐·韦嗣立《论职官多滥疏》"},"example":{"text":"清·褚人获《隋唐演义》第100回：“最恨小人女子，每～而起，搅乱天家父子意。”"},"similar":["比肩接踵"],"usage":"作谓语、定语；形容人很多"},{"id":22116,"word":"接踵而来","pinyin":"jiē zhǒng ér lái","abbr":"jzel","explanation":"指人们前脚跟着后脚，接连不断地来。形容来者很多，络绎不绝。","source":{"text":"入城，宣布德意，不戮一人，中原归附者踵接。","book":"《宋史·李显忠传》"},"example":{"text":"整个的“新饭碗”一时虽未找到，零碎的小事却～。","book":"邹韬奋《经历·新饭碗问题》"},"similar":["接二连三","络绎不绝"],"usage":"作谓语、定语；指接连不断地来"},{"id":22117,"word":"接踵而至","pinyin":"jiē zhǒng ér zhì","abbr":"jzez","explanation":"指人们前脚跟着后脚，接连不断地来。形容来者很多，络绎不绝。","source":{"text":"子来，寡人闻之，千里而一士，是比肩而立，百世而一圣，若随踵而至也，今子一朝而见七士，则士不亦众乎！","book":"《战国策·齐策三》"},"example":{"text":"台湾之割，青岛之割，威海之割，～。","book":"章炳麟《箴新党论》"},"similar":["联翩而至","川流不息","接二连三"],"usage":"作谓语、定语；用于书面语"},{"id":22118,"word":"接连不断","pinyin":"jiē lián bù duàn","abbr":"jlbd","explanation":"一个接着一个而不间断。","source":{"text":"陈设兵卫，自王宫起，直至光家之门，街衢皆满，接连不断。","book":"明·冯梦龙《东周列国志》第七十三回"},"example":{"text":"只见人烟辏集，作买作卖，～。","book":"清·李汝珍《镜花缘》第十一回"},"similar":["连续不断","纷来沓至"],"opposite":["断断续续","时隐时现"],"usage":"作谓语、定语、状语；指连续不间断"},{"id":22119,"word":"接风洗尘","pinyin":"jiē fēng xǐ chén","abbr":"jfxc","explanation":"指设宴款待远来的客人，以示慰问和欢迎。","source":{"text":"虽也送他两把俸金，几件人事，恰好侄儿也替他接风洗尘，只好直退。","book":"明·凌濛初《二刻拍案惊奇》第26卷"},"example":{"text":"第二天，周恩来把邓颖超接到自己的住处，亲手做了几个菜，为邓颖超～。","book":"马辂《国共和谈演义》第二十七回"},"similar":["洗尘接风"],"usage":"作谓语、宾语、定语；用于口语"},{"id":22120,"word":"控名责实","pinyin":"kòng míng zé shí","abbr":"kmzs","explanation":"控：引；责：求。使名声与实际相符。","source":{"text":"名家苛察缴绕，使人不得反其意，专决于名而失人情，故曰‘使人俭而善失真。’若夫控名责实，参伍不失，此不可不察也。","book":"《史记·太史公自序》"},"similar":["按名责实"],"usage":"作谓语；指引名以求实"},{"id":22121,"word":"推三宕四","pinyin":"tuī sān dàng sì","abbr":"tsds","explanation":"推：推托；宕：拖延。形容一再推托拖延。","source":{"text":"原来仑樵欠了米店两个月的米帐，没钱还他，那店伙天天来讨，总是推三宕四，那讨帐人发了急，所以就吵起来。","book":"清·曾朴《孽海花》第五回"},"similar":["推三挨四"],"usage":"作谓语、宾语；用于处事"},{"id":22122,"word":"推三拉四","pinyin":"tuī sān lā sì","abbr":"tsls","explanation":"推：推诿。找各种借口推托、阻挠。","source":{"text":"好生给姨太太捶腿。要茶要水，别推三拉四的。","book":"清·曹雪芹《红楼梦》第62回"},"similar":["推三阻四"],"usage":"作谓语；找各种借口推托"},{"id":22123,"word":"推三挨四","pinyin":"tuī sān āi sì","abbr":"tsas","explanation":"找各种借口推托。","source":{"text":"几次叫你做个手脚，你总是推三挨四，还打官话。","book":"茅盾《第一阶段的故事》"},"example":{"text":"你开头就～，不肯接受命令，现在又说材料不够，亏你说得出口来！","book":"茅盾《腐蚀·十月二十三日》"},"similar":["推三宕四"],"usage":"作谓语、宾语；用于处事"},{"id":22124,"word":"推三推四","pinyin":"tuī sān tuī sì","abbr":"tsts","explanation":"找各种借口推托。同“推三阻四”。","source":{"text":"你这家伙胆小怕死，还推三推四咧！你不敢去，我一个人也敢去！","book":"马烽《吕梁英雄传》第27回"},"similar":["推三阻四"],"usage":"作谓语；找各种借口推托"},{"id":22125,"word":"推三阻四","pinyin":"tuī sān zǔ sì","abbr":"tszs","explanation":"找各种借口推托。","source":{"text":"我如今并不推三阻四，任哥哥自主之。","book":"元·无名氏《隔江斗智》第一折"},"example":{"text":"我起意要这样办，你却要～的，所以我就没脸说下去了。","book":"清·吴趼人《二十年目睹之怪现状》第八十九回"},"similar":["推三拉四","推三推四"],"usage":"作谓语；找各种借口推托"},{"id":22126,"word":"推东主西","pinyin":"tuī dōng zhǔ xī","abbr":"tdzx","explanation":"推掉东面主西面。指借口推托，不说实情。","source":{"text":"兀那厮，我问着你，您休推东主西的！","book":"元·张国宾《薛仁贵》第三折"},"similar":["推三阻四"],"usage":"作谓语、定语；用于处事"},{"id":22127,"word":"推之四海而皆准","pinyin":"tuī zhī sì hǎi ér jiē zhǔn","abbr":"tzshejz","explanation":"四海：古人认为中国四境有海环绕，故称全国为“四海”；准：准确。比喻具有普遍性的真理到处都适用。","source":{"text":"推而放诸东海而准，推而放诸西海而准，推而放诸南海而准，推而放诸北海而准。","book":"《礼记·祭义》"},"example":{"text":"你，还抱住了二十岁时的理想，以为～，俟之百世而不惑。","book":"茅盾《创造》三"},"similar":["放之四海而皆准"],"usage":"作谓语、定语；指普遍性的真理"},{"id":22128,"word":"推亡固存","pinyin":"tuī wáng gù cún","abbr":"twgc","explanation":"推翻行亡道之国，巩固行存道之邦。","source":{"text":"佑贤辅德，显忠遂良。兼弱攻昧，取乱侮亡。推亡固存，邦乃其昌。","book":"《尚书·汤誓》"},"example":{"text":"齐主荒乱，不久必亡，～，古有常训，朕已决计北伐，无庸疑议！","book":"蔡东藩《南北史演义》第七十六回"},"usage":"作宾语、定语；用于书面语"},{"id":22129,"word":"推亡故存","pinyin":"tuī wáng gù cún","abbr":"twgc","explanation":"推倒乱亡之国，巩固已存之邦。","source":{"text":"佑贤辅德，显忠遂良。兼弱攻昧，取乱侮亡。推亡固存，邦乃其昌。","book":"《尚书·汤誓》"}},{"id":22130,"word":"推天抢地","pinyin":"tuī tiān qiǎng dì","abbr":"ttqd","explanation":"往前冲跌。形容冲撞争闹。","source":{"text":"他是个腰系红裙一妇人，你试议论，有甚事便推天抢地手粘身？","book":"元·孙仲章《勘头巾》第一折"},"usage":"作谓语、定语、状语；用于书面语"},{"id":22131,"word":"推宗明本","pinyin":"tuī zōng míng běn","abbr":"tzmb","explanation":"推：推求；明：阐明。指推求、阐明宗旨。","source":{"text":"其道经焉，其德经焉，推宗明本，穷玄极妙，总众枝于真根，报万条于一要。","book":"宋·张君房《云笈七签》卷六十五"},"usage":"作谓语、宾语；用于书面语"},{"id":22132,"word":"推崇备至","pinyin":"tuī chóng bèi zhì","abbr":"tcbz","explanation":"推崇：推重，敬佩。极其推重和敬佩。","source":{"text":"所谈西国政治、艺术，石破天惊，推崇备至，私心窃以为过当。","book":"清·曾朴《孽海花》第八回"},"usage":"作谓语、定语；用于书面语"},{"id":22133,"word":"推己及人","pinyin":"tuī jǐ jí rén","abbr":"tjjr","explanation":"用自己的心意去推想别人的心意。指设身处地替别人着想。","source":{"text":"推己及物。","book":"《论语·卫灵公》：“己所不欲，勿施于人”朱熹集注"},"example":{"text":"同学之间要做到将心比心，～，就能够搞好团结。"},"similar":["以己度人","设身处地"],"opposite":["诿过于人"],"usage":"作谓语、宾语、定语；指设身处地为别人着想","story":["春秋时期，齐景公穿着温暖的狐皮袍子站在窗前欣赏雪景。他觉得景致十分美丽，高兴地对晏子说天气很温和。晏子直截了当地说：“古时贤明的君主自己吃饱了还想到别人在挨饿，自己穿暖了还想到别人在挨冻，经常推己及人，这样国家才会兴旺。”"]},{"id":22134,"word":"推己及物","pinyin":"tuī jǐ jí wù","abbr":"tjjw","explanation":"用自己的心意去推想别人的心意。指设身处地替别人着想。同“推己及人”。","source":{"text":"以己及物，仁也，推己及物，恕也。","book":"宋·程颢《二程遗书》第11卷"},"usage":"作谓语、定语；用于处事"},{"id":22135,"word":"推干就湿","pinyin":"tuī gàn jiù shī","abbr":"tgjs","explanation":"形容抚育孩子的辛劳。同“推燥居湿”。","source":{"text":"三年乳哺恩爱深，推干就湿多劳顿。","book":"明·徐田臣《杀狗记·孙荣奠墓》"},"example":{"text":"郭沫若《虎符》附录《写作缘起》：“～，画荻和丸之类，都是儿女小时的事。”"},"similar":["推燥居湿"],"usage":"作谓语、宾语；用于母亲"},{"id":22136,"word":"推心置腹","pinyin":"tuī xīn zhì fù","abbr":"txzf","explanation":"把赤诚的心交给人家。比喻真心待人。","source":{"text":"萧王推赤心置人腹中，安得不投死！","book":"《后汉书·光武帝本纪》"},"example":{"text":"由于他平素对朝廷不满，又感于尚炯的～，就把他平日不轻对人谈的话都谈了出来。","book":"姚雪垠《李自成》第一卷第二十六章"},"similar":["肝胆相照","赤诚待人","推心致腹"],"opposite":["居心叵测"],"usage":"作谓语、定语、状语；指真心待人","story":["西汉末年，刘秀起兵反对王莽，被更始帝刘玄封为萧王，同时派往北方收编农民起义军铜马军。铜马军有几十万人投奔刘秀。刘秀还是保持他们原来的编制，对他们的将领推心置腹，打消他们的疑虑，让他们死心塌地地跟随他"]},{"id":22137,"word":"推心致腹","pinyin":"tuī xīn zhì fù","abbr":"txzf","explanation":"致：送达。把赤诚的心交给人家。比喻真心待人","source":{"text":"故得百万之师，如臂使指，亿兆之众，推心致腹。","book":"宋·王禹偁《请撰大行皇帝实录表》"},"similar":["推心置腹"],"usage":"作谓语、定语、状语；指真心待人"},{"id":22138,"word":"推情准理","pinyin":"tuī qíng zhǔn lǐ","abbr":"tqzl","explanation":"推：推测。按照情理来推测确定。","source":{"text":"假使八世，天子乃得事七；六世，诸侯方通祭五；推情准理，不其谬乎。","book":"《魏书·礼志二》"},"usage":"作谓语、宾语；用于书面语"},{"id":22139,"word":"推择为吏","pinyin":"tuī zé wéi lì","abbr":"tzwl","explanation":"推举选拔人才为官。","source":{"text":"始为布衣，贫无行，无得推择为吏。","book":"《史记·淮阴侯列传》"},"example":{"text":"早以文学得～，任至滁州全椒县尹。","book":"《元史·杨朴传》"}},{"id":22140,"word":"推推搡搡","pinyin":"tuī tuī sǎng sǎng","abbr":"ttss","explanation":"粗暴地、接连不断地猛推。","source":{"text":"大家推推搡搡，把灵香和女婿往一块弄。","book":"路遥《平凡的世界》第三卷第18章"},"example":{"text":"请不要～，注意安全。"},"similar":["推推拉拉"],"usage":"作宾语、定语；指争斗"},{"id":22141,"word":"推敲字句","pinyin":"tuī qiāo zì jù","abbr":"tqzj","explanation":"比喻斟酌字句，反复琢磨用意。","source":{"text":"岛初赴举京师，一日，于驴上得句云：‘鸟宿池边树，僧敲月下门。’始欲着‘推’字，又丰‘敲’字，……韩立马良久，谓岛曰：‘作敲字佳矣。’","book":"唐·韦绚《刘公嘉话录》"}},{"id":22142,"word":"推本溯源","pinyin":"tuī běn sù yuán","abbr":"tbsy","explanation":"探索根源，寻找原因。","example":{"text":"做学问必须下一番推本溯源的功夫。"},"similar":["推究根源"],"usage":"作谓语、定语；指勇于探索"},{"id":22143,"word":"推枯折腐","pinyin":"tuī kū shé fǔ","abbr":"tksf","explanation":"犹言摧枯拉朽。比喻腐朽势力极易打垮。","source":{"text":"今我至京师，陈上谷、渔阳兵马之众，还出太原、代郡，反复数十日，归发突骑以奔乌合之众，如推枯折腐耳。","book":"晋·袁宏《后汉纪·光武帝纪》"},"similar":["摧枯拉朽"],"usage":"作宾语、定语；用于书面语"},{"id":22144,"word":"推梨让枣","pinyin":"tuī lí ràng zǎo","abbr":"tlrz","explanation":"指兄弟友爱。","source":{"text":"汉末孔融兄弟七人，融居第六，四岁时，与诸兄共食梨，融取小者，大人问其故，答道：“我小儿，法当取小者。”见《后汉书·孔融传》李贤注。又南朝梁王泰幼时，祖母集诸孙侄，散枣栗于床，群儿皆竞取，泰独不取。问之，答道：“不取，自当得赐。”见"},"similar":["推枣让梨"],"usage":"作宾语、定语；用于交往等","story":["东汉末年，孔融四岁时，只取家里分给兄弟吃的梨的最小的，把大的让给哥哥们。南朝梁代人王泰年幼时，祖母分枣子与栗子给他们兄弟吃，只有他不上前哄抢，祖母问其故，他说：“不取，自当得赐。”"]},{"id":22145,"word":"推毂荐士","pinyin":"tuī gǔ jiàn shì","abbr":"tgjs","explanation":"毂：车轮中心，有窟窿可以插轴的部分。推毂如同推举人才，引荐贤士。","source":{"text":"其他推毂荐士，为汉廷臣，成天下重名硕望者，不可胜书。","book":"唐·权德舆《齐成公神道碑铭序》"},"usage":"作谓语、宾语；用于书面语"},{"id":22146,"word":"推波助浪","pinyin":"tuī bō zhù làng","abbr":"tbzl","explanation":"比喻从旁鼓动、助长事物（多指坏的事物）的声势和发展，扩大影响。","source":{"text":"真君建德之事，适足推波助澜，纵风止燎耳。","book":"南朝·宋·鲍照《观漏赋》"}},{"id":22147,"word":"推波助澜","pinyin":"tuī bō zhù lán","abbr":"tbzl","explanation":"澜：大波浪。比喻从旁鼓动、助长事物（多指坏的事物）的声势和发展，扩大影响。","source":{"text":"真君建德之事，足推波助澜，纵风止燎尔。","book":"隋·王通《文中子·问易篇》"},"example":{"text":"即或漏吞舟之鱼，而已暴鳃断鳍，颓然老矣，尚何能为～之事哉！","book":"严复《论世变之亟》"},"similar":["推波助浪","火上浇油"],"opposite":["随波逐流","息事宁人"],"usage":"作谓语、状语；指扩大影响"},{"id":22148,"word":"推波助澜，纵风止燎","pinyin":"tuī bō zhù lán，zòng fēng zhǐ liáo","abbr":"tbzlzfzl","explanation":"澜：大波浪。比喻从旁鼓动，助长事物的声势，扩大影响。","source":{"text":"真君、建德之事，适足推波助澜、纵风止燎尔！","book":"隋·王通《文中子·问易》"},"similar":["推波助澜"],"usage":"作宾语、定语；用于书面语"},{"id":22149,"word":"推涛作浪","pinyin":"tuī tāo zuò làng","abbr":"ttzl","explanation":"作：兴起。推动波涛，掀起浪头。比喻助长坏人坏事，煽动情绪，制造事端。","source":{"text":"呼风唤雨，推涛作浪，或策划于密室，或点火于基层。","book":"毛泽东《文汇报的资产阶级方向应当批判》"},"similar":["推波助澜"],"usage":"作谓语、定语；指制造事端"},{"id":22150,"word":"推燥居湿","pinyin":"tuī zào jū shī","abbr":"tzjs","explanation":"把干的地方让给幼儿，自己睡在湿的地方。形容抚育孩子的辛劳。","source":{"text":"母之于子也，鞠养殷勤，推燥居湿，绝少分甘。","book":"《孝经援神契》"},"example":{"text":"士安每病，母辄～，以复易单。","book":"晋·皇甫谧《自序》"},"similar":["居湿推燥","推干就湿"],"usage":"作谓语、定语；用于父母"},{"id":22151,"word":"推究根源","pinyin":"tuī jiū gēn yuán","abbr":"tjgy","explanation":"推究：推求论究。推求根本，论究来源。","source":{"text":"欲使察狱之官，精心悉意，推究根源。","book":"《北史·苏绰传》"},"similar":["推本溯源"],"usage":"作谓语、定语；指勇于探索"},{"id":22152,"word":"推群独步","pinyin":"tuī qún dú bù","abbr":"tqdb","explanation":"推群：超出一般人。指杰出超群，独一无二。","source":{"text":"这也没有什么奇处，那诸葛公弹琴退敌，谢太傅围棋财墅，名士大半专会摹调，只如今就算得江左夷吾，让他推群独步了。","book":"清·魏子安《花月痕》第七回"},"similar":["出类拔萃"],"usage":"作谓语、定语；用于书面语"},{"id":22153,"word":"推而广之","pinyin":"tuī ér guǎng zhī","abbr":"tegz","explanation":"广：宽，大。推展开来而且把它扩大。也指从一件事情推及其它。","source":{"text":"若其纪一事，咏一物，风云草木之兴，鱼虫禽兽之流，推而广之，不可胜载矣。","book":"南朝·梁·萧统《文选·序》"},"example":{"text":"～，弥纶万有而非有；统而会之，究竟寂灭而非灭。","book":"宋·释惟白《续传灯录》卷十"},"usage":"作谓语；用于口语"},{"id":22154,"word":"推聋作哑","pinyin":"tuī lóng zuò yǎ","abbr":"tlzy","explanation":"指装作不闻不问，什么都不知道。同“推聋妆哑”。","source":{"text":"我如今装醉如痴，推聋做哑，待时守分。","book":"元·无名氏《闹铜台》第二折"},"similar":["装聋作哑","推聋妆哑","推聋做哑"],"usage":"作谓语、宾语、状语；指故意当不知道"},{"id":22155,"word":"推聋做哑","pinyin":"tuī lóng zuò yǎ","abbr":"tlzy","explanation":"假装聋哑。指故意不理睬，假做不知。","source":{"text":"我如今装醉如痴，推聋做哑，待时守分。","book":"元·无名氏《闹铜台》第二折"},"example":{"text":"见相识免不的～，见姨夫使不的俐齿伶牙。","book":"明·胡文焕《群音类选·》曲"},"similar":["推聋作哑","装聋作哑","推聋妆哑"],"usage":"作谓语、宾语、状语；指故意当不知道"},{"id":22156,"word":"推聋妆哑","pinyin":"tuī lóng zhuāng yǎ","abbr":"tlzy","explanation":"指装作不闻不问，什么都不知道。","source":{"text":"伯伯，你不要推聋妆哑！你在城中岂不知道他两个是我兄弟？偏不是你的兄弟？","book":"明·施耐庵《水浒全传》第四十九回"},"example":{"text":"三藏闻言，～，瞑目宁心，寂然不答。","book":"明·吴承恩《西游记》第二十三回"},"similar":["推聋作哑","推聋做哑","装聋作哑"],"usage":"作谓语、宾语、状语；指故意当不知道"},{"id":22157,"word":"推聋装哑","pinyin":"tuī lóng zhuāng yǎ","abbr":"tlzy","explanation":"比喻装作一无所知的样子。","source":{"text":"三藏闻言，推聋妆哑，瞑目宁心，寂然不答。","book":"明·吴承恩《西游记》第23回"},"example":{"text":"你不要～了。"},"similar":["装聋作哑"],"usage":"作谓语、宾语、定语；指装聋作哑"},{"id":22158,"word":"推舟于陆","pinyin":"tuī zhōu yú lù","abbr":"tzyl","explanation":"推船在陆地上行走。比喻劳而无功。","source":{"text":"今薪行周于鲁，是犹推舟于陆地，劳而无功，身必有殃。","book":"战国·宋·庄周《庄子·天运》"},"example":{"text":"你这样做就等于是～。"},"similar":["罔水行舟"],"usage":"作宾语、定语；指人的行为失当","story":["春秋时期，孔子从鲁国西行到卫国去游说推行先王的仁义之道。学生颜渊问鲁国太师金能否成功。师金说：“推行先王已用过早已废弃的仁义之道就像祭祀用的草狗一样无用，他这样做就像把船推到陆地上希望代替车一样劳而无功。”"]},{"id":22159,"word":"推襟送抱","pinyin":"tuī jīn sòng bào","abbr":"tjsb","explanation":"襟、抱：指心意。向对方表示殷勤的心意。","source":{"text":"所可通梦交魂，推襟送抱，唯丈人而已。","book":"南朝·梁·张充《与王俭书》"},"example":{"text":"严比王太守与余同受业于沈鹿坪师，～，情谊独敦。","book":"清·陆以湉《冷庐杂识·严比王》"},"similar":["推诚相见","开诚布公"],"opposite":["虚情假意"],"usage":"作谓语、定语；指真诚待人"},{"id":22160,"word":"推诚不饰","pinyin":"tuī chéng bù shì","abbr":"tcbs","explanation":"推诚相见，毫不掩饰自己。比喻对人诚实，毫无虚假之意。","source":{"text":"体貌素朴，性推诚不饰。","book":"《三国志·蜀志·谯周传》"}},{"id":22161,"word":"推诚布信","pinyin":"tuī chéng bù xìn","abbr":"tcbx","explanation":"诚：真心；信：信义。拿出真心，广布信义。即以真心信义待人。","source":{"text":"翼又推诚布信，事存宽简，夷夏感悦，比之大小冯君焉。","book":"《周书·于翼传》"},"example":{"text":"《辛昂传》：“昂～，甚得夷獠欢心。”"},"similar":["推诚布公"],"usage":"作谓语、定语、状语；指真诚待人"},{"id":22162,"word":"推诚布公","pinyin":"tuī chéng bù gōng","abbr":"tcbg","explanation":"指以诚心待人，坦白无私。","source":{"text":"诸葛亮之为相国也，抚百姓，示仪轨，约官职，从权制，开诚心，布公道。","book":"《三国志·蜀志·诸葛亮传·评》"},"example":{"text":"尔二人自任阁事，～，不唯朕知之，天下无不知者。","book":"《清史稿·伊桑阿传》"},"similar":["开诚布公","推诚布信"],"usage":"作谓语、定语、状语；指真诚待人"},{"id":22163,"word":"推诚待物","pinyin":"tuī chéng dài wù","abbr":"tcdw","explanation":"拿出真心对待别人。","source":{"text":"明公推诚待物，物亦归心；若用猜忌，去霸业远矣。","book":"《资治通鉴·梁纪·高祖武皇帝大同四年》"},"example":{"text":"然或进退一人，处分一事，往往降中旨，使一二小人阴执其柄，是既任之而又疑之也。陛下岂不欲～哉？","book":"《明史·邹智传》"},"similar":["推诚接物"],"usage":"作谓语、定语；用于交往等"},{"id":22164,"word":"推诚接物","pinyin":"tuī chéng jiē wù","abbr":"tcjw","explanation":"拿出真心对待别人。","source":{"text":"太康末，拜北部都尉，明刑法，禁奸邪，轻财好施，推诚接物，五部俊杰无不至者。","book":"《晋书·刘元海载记》"},"similar":["推诚待物"],"usage":"作谓语、定语；用于交往等"},{"id":22165,"word":"推诚爱物","pinyin":"tuī chéng ài wù","abbr":"tcaw","explanation":"物：指他人。拿出真心去爱护他人。指以真诚的心意爱别人。","source":{"text":"力行务仁，推诚爱物。","book":"唐·陈子昂《九陇县独孤丞遗爱碑》"},"usage":"作谓语、定语；用于处事"},{"id":22166,"word":"推诚相与","pinyin":"tuī chéng xiāng yǔ","abbr":"tcxy","explanation":"诚：相信。指以真心诚意与他人相处。","source":{"text":"我与晋州推诚相待，何忽辄相猜阻，横生此言。","book":"《北齐书·慕容绍宗传》"}},{"id":22167,"word":"推诚相信","pinyin":"tuī chéng xiāng xìn","abbr":"tcxx","explanation":"诚：相信。指以真心对待人。","source":{"text":"我与晋州推诚相待，何忽辄相猜阻，横生此言。","book":"《北齐书·慕容绍宗传》"},"example":{"text":"臣与蜀主，～，知臣本心，必不肯杀臣之家小也。","book":"明·罗贯中《三国演义》第八十五回"},"similar":["推诚相见"],"usage":"作谓语、定语；指以真心对待人"},{"id":22168,"word":"推诚相待","pinyin":"tuī chéng xiāng dài","abbr":"tcxd","explanation":"诚：相信。指以真心诚意与他人相处。","source":{"text":"我与晋州推诚相待，何忽辄相猜阻，横生此言。","book":"《北齐书·慕容绍宗传》"},"similar":["推诚相见","推诚相信"],"usage":"作谓语、定语；指以真心对待人"},{"id":22169,"word":"推诚相见","pinyin":"tuī chéng xiāng jiàn","abbr":"tcxj","explanation":"诚：相信。指以真心对待人。","source":{"text":"臣与蜀主，推诚相信，知臣本心，必不肯杀臣之家小也。","book":"明·罗贯中《三国演义》第八十五回"},"example":{"text":"同学之间应该～。"},"similar":["开诚布公","肝胆相照"],"opposite":["钩心斗角","明争暗斗"],"usage":"作谓语、定语；指以真心对待人"},{"id":22170,"word":"推诚置腹","pinyin":"tuī chéng zhì fù","abbr":"tczf","explanation":"比喻真心待人。同“推心置腹”。","source":{"text":"萧王推赤心置人腹中，安得不投死！","book":"《后汉书·光武帝纪上》"},"example":{"text":"皇上待臣～，臣岂敢欺饰回报！","book":"二月河《乾隆皇帝》九"},"similar":["推心置腹","推心致腹"],"usage":"作谓语、定语、状语；指真心待人"},{"id":22171,"word":"推贤下士","pinyin":"tuī xián xià shì","abbr":"txxs","explanation":"对有才有德的人以礼相待，对一般有才能的人不计自己的身份去结交。","source":{"text":"当应推贤下士，先物后身，然后可以报恩明主，克保元吉。","book":"《梁书·徐勉传》"},"similar":["礼贤下士"],"usage":"作谓语、定语；用于交往等"},{"id":22172,"word":"推贤举善","pinyin":"tuī xián jǔ shàn","abbr":"txjs","explanation":"推荐贤士，引进好人。","source":{"text":"上亲自考试，用绝请托之门，是时文学相高，公道大振，得路者咸以推贤进善为意。","book":"唐·苏鹗《杜阳杂编》卷上"},"example":{"text":"喜孜孜～，永绵绵龙虎风云。","book":"元·无名氏《伐晋兴齐》第四折"},"similar":["推贤进善"],"usage":"作谓语、宾语；用于书面语"},{"id":22173,"word":"推贤乐善","pinyin":"tuī xián lè shàn","abbr":"txls","explanation":"推：推崇；乐：爱好。推崇贤人，爱好善事。","source":{"text":"疾恶如仇，推贤乐善，常慕季文子、仲山甫之志。","book":"《晋书·傅玄传》"},"usage":"作谓语、宾语；用于书面语"},{"id":22174,"word":"推贤任人","pinyin":"tuī xián rèn rén","abbr":"txrr","explanation":"推荐贤士，作用其人。","source":{"text":"公践台衡，专以推贤任人为务。","book":"唐·严郢《驳议吕諲》"},"usage":"作宾语、定语；用于处事"},{"id":22175,"word":"推贤扬善","pinyin":"tuī xián yáng shàn","abbr":"txys","explanation":"推：推崇；扬：弘扬。推崇贤人，弘扬善事。","source":{"text":"汤虽酷烈，及身蒙咎，其推贤扬善，固宜有后。","book":"《汉书·张汤传赞》"},"example":{"text":"追思立朝不能～，予愧叔晦，益者三友，叔晦不予愧也。","book":"《宋史·沈焕传》"}},{"id":22176,"word":"推贤让能","pinyin":"tuī xián ràng néng","abbr":"txrn","explanation":"推：举荐；让：谦让。举荐贤人，让位于能者。","source":{"text":"推贤让能，庶官乃和。","book":"《尚书·周官》"},"example":{"text":"在朝之士相让于上，草庐之人咸皆化之，～之风从此生矣。","book":"《晋书·刘寔传》"},"similar":["推贤逊能"],"opposite":["尸位素餐"],"usage":"作谓语、宾语、定语；指让贤"},{"id":22177,"word":"推贤进善","pinyin":"tuī xián jìn shàn","abbr":"txjs","explanation":"推荐贤士，引进好人。","source":{"text":"上亲自考试，用绝请托之门，是时文学相高，公道大振，得路者咸以推贤进善为意。","book":"唐·苏鹗《杜阳杂编》卷上"},"example":{"text":"宋·王谠《唐语林·赏誉》：“是时文学相高，当途者咸以～为意。”"},"similar":["推贤举善"],"usage":"作谓语、宾语；用于书面语"},{"id":22178,"word":"推贤进士","pinyin":"tuī xián jìn shì","abbr":"txjs","explanation":"推荐贤人，引进学者。","source":{"text":"近蒙奖擢，倍励驽庸，每以推贤进士为务，欲使公卿大夫称职。","book":"唐·姚崇《答张九龄书》"},"example":{"text":"宋·王楙《野客丛书·杨恽有外祖风》：“其故人任安予书，责以古人～之义。”"},"usage":"作宾语、定语；用于书面语"},{"id":22179,"word":"推贤逊能","pinyin":"tuī xián xùn néng","abbr":"txxn","explanation":"推：举荐。举荐贤人，让位于能者。","source":{"text":"推贤让能，庶官乃和。","book":"《尚书·周官》"},"example":{"text":"社稷宁谧，黎民乐业，皆晏婴～之功。","book":"邞·无名氏《伐晋兴齐》第四折"},"similar":["推贤让能"],"usage":"作谓语、宾语、定语；指让贤"},{"id":22180,"word":"推轮捧毂","pinyin":"tuī lún pěng gǔ","abbr":"tlpg","explanation":"捧：用手往上抬；毂：古称车轮中心的圆木，上有插车轴的两孔。抬起车毂，推动车轮。比喻推荐人才。","source":{"text":"推毂谓自卑下之，如为之推车毂也。","book":"《史记·魏其武安侯列传》：“魏其、武安俱好儒术，推毂赵琯为御史大夫。”司马贞索隐"},"example":{"text":"清·钱彩《说岳全传》第22回：“如萧相国‘～’故事。”"},"usage":"作宾语、定语；用于书面语"},{"id":22181,"word":"推避求全","pinyin":"tuī bì qiú quán","abbr":"tbqq","explanation":"为了保全自己，找个借口避开问题。","source":{"text":"危行言逊，吐刚茹柔，推避以求全，依违以免祸。","book":"唐·刘知几《史通·感经》"}},{"id":22182,"word":"推锋争死","pinyin":"tuī fēng zhēng sǐ","abbr":"tfzs","explanation":"推锋：手持兵器向前，指冲锋。指冲锋陷阵，争先恐后，不怕牺牲。","source":{"text":"三百人者闻秦击晋，皆求从，从而见缪公窘，亦皆推锋争死，以报食马之德。","book":"《史记·秦本纪》"}},{"id":22183,"word":"推门入桕","pinyin":"tuī mén rù jiù","abbr":"tmrj","explanation":"桕：旧式门上容纳榫头的槽。比喻两相凑合。","source":{"text":"死了，两个正是推门入桕。免不得买具棺木盛殓，把去烧了。","book":"明·冯梦龙《警世通言》卷二十"},"usage":"作宾语、定语；多用于比喻句"},{"id":22184,"word":"推陈出新","pinyin":"tuī chén chū xīn","abbr":"tccx","explanation":"指对旧的文化进行批判地继承，剔除其糟粕，吸取其精华，创造出新的文化。","source":{"text":"不特推陈出新，饶有别致。","book":"清·戴延年《秋灯丛话·忠勇祠联》"},"example":{"text":"研究棋艺，～。","book":"陈毅《题〈围棋名谱精选〉》诗"},"similar":["吐故纳新","除旧布新","新陈代谢"],"opposite":["墨守成规","因循守旧"],"usage":"作谓语、定语；指新陈代谢"},{"id":22185,"word":"推陈致新","pinyin":"tuī chén zhì xīn","abbr":"tczx","explanation":"①排除陈旧的，生出新的来。指肌体内的新陈代谢。②泛指排除旧的，创出新的。","source":{"text":"吴子野劝食白粥，云能推陈致新，利膈养胃。","book":"《东坡帖》"},"example":{"text":"清·曹庭栋《养生随笔·晨兴》：“每日空腹食淡粥一殴，能～，生津快胃，所益非细。”"},"similar":["推陈出新"],"usage":"作谓语、定语；用于书面语"},{"id":22186,"word":"推食解衣","pinyin":"tuī shí jiě yī","abbr":"tsjy","explanation":"推：让。把穿着的衣服脱下给别人穿，把正在吃的食物让别人吃。形容对人热情关怀。","source":{"text":"汉王授我上将军印，予我数万众，解衣衣我，推食食我。","book":"《史记·淮阴侯列传》"},"example":{"text":"某奉别公近二十年矣，别后不复一致书问，而公念某犹某也。～，至今犹然。","book":"明·李贽《又书使通州诗后》"},"similar":["解衣推食"],"usage":"作谓语、宾语、分句；指对人热情关怀","story":["楚汉相争时期，项羽手下的韩信因得不到重用就投靠刘邦。刘邦认为韩信是一个很好的人才，就把他的衣服送给韩信，还给韩信送去精美的食物、兵马。韩信带兵灭掉齐国。项羽派武涉去劝韩信自立为王，被韩信拒绝"]},{"id":22187,"word":"掩人不备","pinyin":"yǎn rén bù bèi","abbr":"yrbb","explanation":"掩：掩袭；备：防备。趁对方没有准备去进攻或逮捕。","source":{"text":"无掩人不备，穷人于□，不得断人支体，祼人形骸，放淫妇女。","book":"《史记·魏豹彭越列传》：“于是上使使掩梁王，梁王不觉，捕梁王，囚之洛阳。”《后汉书·郅恽传》"},"example":{"text":"家眷已至，大事待行，须速议出兵，～，迟恐有变。","book":"蔡东藩《唐史演义》第二回"}},{"id":22188,"word":"掩人耳目","pinyin":"yǎn rén ěr mù","abbr":"yrem","explanation":"遮掩别人的耳朵和眼睛。比喻用假象迷惑人，欺骗人。","source":{"text":"虽欲掩人之耳目，不可得也。","book":"《大宋宣和遗事》亨集"},"example":{"text":"必须假手他人，死于道路，方可～。","book":"明·冯梦龙《东周列国志》第十二回"},"similar":["欲盖弥彰","偷天换日","瞒上欺下"],"opposite":["原形毕露","真心实意","光明磊落"],"usage":"作谓语、宾语、定语；指欺骗人"},{"id":22189,"word":"掩其不备","pinyin":"yǎn qí bù bèi","abbr":"yqbb","explanation":"掩：掩袭。备：防备。趁敌人毫无防备时进行突然袭击。亦作“掩其无备”。","source":{"text":"今众少粮单，我悬彼固，正宜简精锐，掩其不备耳。","book":"《南齐书·刘怀珍传》"},"example":{"text":"故意到三更时分，～，一齐闯进弥陀寺，不论僧俗，见一个，拿一个。","book":"《官场维新记》第十回"},"similar":["掩其无备"],"usage":"作谓语、定语；指突然袭击"},{"id":22190,"word":"掩其无备","pinyin":"yǎn qí wú bèi","abbr":"yqwb","explanation":"掩：掩袭；备：防备。称乘敌方毫无防备时进行突袭。","source":{"text":"攻其无备，出其不意。","book":"《孙子·计篇》"},"example":{"text":"若经城勿攻，西入长安，～，天子虽还，失其襟带。","book":"《旧唐书·李密传》"},"similar":["掩其不备"],"usage":"作谓语、定语；指突然袭击"},{"id":22191,"word":"掩口卢胡","pinyin":"yǎn kǒu lú hú","abbr":"yklh","explanation":"卢胡：喉间的笑声。捂着嘴笑。","source":{"text":"昔郑人以乾鼠为璞，鬻之于周；宋愚夫亦宝燕石，缇十重。夫睹之者掩口卢胡而笑，斯文之族，无乃类旃。","book":"《后汉书·应劭传》"}},{"id":22192,"word":"掩口失声","pinyin":"yǎn kǒu shī shēng","abbr":"ykss","explanation":"指忍不住笑出声来。","source":{"text":"众闻予言，将以为诞也，皆掩口失声。","book":"明·马愈《马氏日抄·风异》"},"similar":["忍俊不禁"],"usage":"作谓语、状语；用于处事"},{"id":22193,"word":"掩口而笑","pinyin":"yǎn kǒu ér xiào","abbr":"ykex","explanation":"掩：捂。笑时捂住口，以防出声失礼。","source":{"text":"亮以麈尾掩口而笑。","book":"晋·陶渊明《晋故征西大将军长史孟府君传》"},"example":{"text":"左右皆～曰：“此天下强颜之女子也。”","book":"明·冯梦龙《东周列国志》第八十九回"},"similar":["掩口胡卢","掩口胡卢而笑"],"usage":"作谓语、定语；指暗笑"},{"id":22194,"word":"掩口胡卢","pinyin":"yǎn kǒu hú lú","abbr":"ykhl","explanation":"胡卢：笑貌。捂着嘴笑，指暗笑，窃笑。","source":{"text":"昔郑人以干鼠为璞，鬻之于周；宋愚夫亦宝燕石，缇漝十重。夫睹之者掩口卢胡而笑，斯文之族，无乃类旃。","book":"南朝·宋·范晔《后汉书·应劭传》"},"example":{"text":"视成所蓄，～而笑。","book":"清·蒲松龄《聊斋志异·促织》"},"similar":["掩口而笑"],"usage":"作谓语、定语；指暗笑"},{"id":22195,"word":"掩口胡卢而笑","pinyin":"yǎn kǒu hú lú ér xiào","abbr":"ykhlex","explanation":"胡卢：喉间的笑声。捂着嘴笑，指暗笑，窃笑","source":{"text":"视成所蓄，掩口胡卢而笑。","book":"清·蒲松龄《聊斋志异·促织》"},"similar":["掩口胡卢","掩口而笑"],"usage":"作谓语、定语；指暗笑"},{"id":22196,"word":"掩口葫芦","pinyin":"yǎn kǒu hú lú","abbr":"ykhl","explanation":"捂着嘴笑。","source":{"text":"昔郑人以乾鼠为璞，鬻之于周；宋愚夫亦宝燕石，缇十重。夫睹之者掩口卢胡而笑，斯文之族，无乃类旃。","book":"南朝·宋·范晔《后汉书·应劭传》"},"example":{"text":"我还不免～，想不到我竟然闹了这么一场笑话。","book":"冯玉祥《我的生活》第16章"},"similar":["掩口胡卢"],"usage":"作谓语；指暗笑"},{"id":22197,"word":"掩恶扬善","pinyin":"yǎn è yáng shàn","abbr":"yeys","explanation":"指对待别人讳言其过恶，称扬其好处。","source":{"text":"天子崩，大臣至南郊谥之者何？以为人臣之义莫不欲褒其君，掩恶扬善者也。","book":"汉·班固《白虎通·谥》"},"example":{"text":"而小异于肇者，不书人之过恶，以谓职非史官，而～者，君子之志也。","book":"宋·欧阳修《归田录》卷二"},"similar":["掩恶扬美","隐恶扬善"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":22198,"word":"掩恶扬美","pinyin":"yǎn è yáng měi","abbr":"yeym","explanation":"指对待别人讳言其过恶，称扬其好处。同“掩恶扬善”。","source":{"text":"丹之辅道副主，掩恶扬美，傅会善意，虽宿儒达士无以加焉。","book":"《汉书·王商史丹傅喜传赞》"},"similar":["掩恶扬善"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":22199,"word":"掩恶溢美","pinyin":"yǎn è yì měi","abbr":"yeym","explanation":"溢：水满流出，指过分。遮掩缺点，过分称赞。","source":{"text":"野史各有私，好恶固难尽信，若志状，则全是本家子孙、门人掩恶溢美之词，又可尽信乎。","book":"宋·周密《齐东野语·张魏公三战本末略》"},"usage":"作谓语、定语；用于书面语"},{"id":22200,"word":"掩旗息鼓","pinyin":"yǎn qí xī gǔ","abbr":"yqxg","explanation":"息：停止。放倒旗子，停止敲鼓。原指隐蔽行军，不暴露目标。现比喻无声无息地停止运动","source":{"text":"领着万余军马，人披软战，马摘銮铃，掩旗息鼓，疾驰到南土冈门口来。","book":"明·施耐庵《水浒传》第108回"},"example":{"text":"瞿秋白《饿乡纪程》第13回：“刘守清又骂了他们一顿，才算～的下去了。”"},"similar":["偃旗息鼓","卷旗息鼓"],"usage":"作谓语、定语、宾语；比喻停止斗争等"},{"id":22201,"word":"掩映生姿","pinyin":"yǎn yìng shēng zī","abbr":"yysz","explanation":"掩映：互相衬托。景物互相衬托而更加美好。","source":{"text":"两边碧渠如镜，掩映生姿。","book":"清·曾朴《孽海花》第二十回"},"usage":"作谓语、定语；用于景物描写"},{"id":22202,"word":"掩瑕藏疾","pinyin":"yǎn xiá cáng jí","abbr":"yxcj","explanation":"掩：遮盖。瑕：玉上的斑点，比喻缺点。藏：隐瞒。疾：毛病，过错。掩盖缺点，隐瞒过错。","source":{"text":"至于掩瑕藏疾，涤除疵垢，朝为寇仇，夕委心膂，虽未足希准古人，粗亦无负于新旧。","book":"《晋书·凉武昭王李玄盛传》"},"example":{"text":"《南齐书·陆厥传》：“至于～，合少谬多，则临淄所云‘人之著述，不能无病’者也。”"},"similar":["掩过饰非"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":22203,"word":"掩目捕雀","pinyin":"yǎn mù bǔ què","abbr":"ymbq","explanation":"遮着眼睛捉麻雀。比喻自己骗自己。","source":{"text":"谚有‘掩目捕雀’。夫微物尚不可欺以得志，况大国之事，其可以诈立乎！","book":"晋·陈寿《三国志·魏志·陈琳传》"},"example":{"text":"谚所谓‘～’。我却不见雀，不知雀却看见我。","book":"宋·朱熹《朱子语类》第72卷"},"similar":["掩耳盗铃","自欺欺人"],"usage":"作谓语、定语；指自欺欺人","story":["东汉后期，宦官与外戚争夺朝廷的统治权的斗争十分激烈，外戚何进掌握朝政，他想秘密调董卓进京消灭宦官的势力。何进的主簿陈琳认为行不通，就像掩目捕雀一样，万一失去控制就会失去主动权。何进不听陈琳的劝告，结果被宦官所杀"]},{"id":22204,"word":"掩眼捕雀","pinyin":"yǎn yǎn bǔ què","abbr":"yybq","explanation":"遮着眼睛捉麻雀。比喻自己骗自己。同“掩目捕雀”。","source":{"text":"惟欲指影以行权，假形而弄诏，此则掩眼捕雀，塞耳盗钟。","book":"《魏书·尔朱荣传》"},"similar":["掩目捕雀"],"usage":"作谓语、定语、宾语；指自欺欺人"},{"id":22205,"word":"掩罪饰非","pinyin":"yǎn zuì shì fēi","abbr":"yzsf","explanation":"非：坏事。遮盖罪行，文饰坏事。","source":{"text":"盖嵩权力足以假手下石……文词便给足以掩罪饰非。","book":"《明史·徐学诗传》"},"usage":"作谓语、定语；用于处事"},{"id":22206,"word":"掩耳偷钟","pinyin":"yǎn ěr tōu zhōng","abbr":"yetz","explanation":"掩：遮蔽，遮盖。偷钟怕别人听见而捂住自己的耳朵。比喻自己欺骗自己，明明掩盖不住的事情偏要想法子掩盖。","source":{"text":"百姓有得钟者，欲负而走，则钟大不可负。以椎毁之，钟况然有声。恐人闻之而夺己也，遽掩其耳。","book":"《吕氏春秋·自知》"}},{"id":22207,"word":"掩耳偷铃","pinyin":"yǎn ěr tōu líng","abbr":"yetl","explanation":"比喻自己欺骗自己。同“掩耳盗钟”。","source":{"text":"难道他掩耳偷铃，则待要见世生苗。","book":"元·无名氏《举案齐眉》第四折"},"example":{"text":"姐姐何必部他，他自～，好似失心疯的一般。","book":"《天雨花》第四回"},"similar":["掩耳盗铃","掩耳盗钟"],"usage":"作谓语、定语、状语；指自欺欺人"},{"id":22208,"word":"掩耳盗钟","pinyin":"yǎn ěr dào zhōng","abbr":"yedz","explanation":"捂住耳朵偷钟。比喻自己欺骗自己。","source":{"text":"范氏之亡也，百姓有得锺者，欲负而走。则锺大不可负，以椎毁之，锺怳然有音。恐人闻之而夺己也，遽揜其耳。","book":"语出《吕氏春秋·自知》"},"example":{"text":"明·杨慎《希夷易图》：“《后天图》见于邵伯温之序。朱子因其出希夷而讳之，殆～也。”"},"similar":["掩耳盗铃"],"usage":"作谓语、定语、状语；指自欺欺人"},{"id":22209,"word":"掩耳盗铃","pinyin":"yǎn ěr dào líng","abbr":"yedl","explanation":"掩：遮蔽，遮盖；盗：偷。偷铃铛怕别人听见而捂住自己的耳朵。比喻自己欺骗自己，明明掩盖不住的事情偏要想法子掩盖。","source":{"text":"百姓有得钟者，欲负而走，则钟大不可负。以椎毁之，钟况然有声。恐人闻之而夺己也，遽掩其耳。","book":"《吕氏春秋·自知》"},"example":{"text":"硬把汉奸合法化了，只是～的笨拙的把戏。","book":"闻一多《谨防汉奸合法化》"},"similar":["自欺欺人","弄巧成拙"],"opposite":["开诚布公"],"usage":"作谓语、定语、状语；指自欺欺人","story":["从前有个小偷发现人家家门口挂着一口很大的铜钟，他想偷但一个人搬不动，想把他敲碎卖碎铜，担心敲钟时别人听到声音而偷不成，终于想出一个绝妙的主意，就是把自己的耳朵用棉花塞住听不到声音，结果偷窃时被当场逮住"]},{"id":22210,"word":"掩耳而走","pinyin":"yǎn ěr ér zǒu","abbr":"yeez","explanation":"掩耳：遮着耳朵而逃走。指不愿意听别人的话。","source":{"text":"宁喜以殖之遗命，告于蘧瑗，瑗掩耳而走。","book":"明·冯梦龙《东周列国志》第六十五回"},"usage":"作谓语、状语；用于处事"},{"id":22211,"word":"掩耳蹙頞","pinyin":"yǎn ěr cù è","abbr":"yece","explanation":"蹙：缩小，皱起；頞：鼻梁。遮着耳朵，皱着鼻子。形容极其厌恶，不愿意听到谈起。","source":{"text":"自是虽戚里为邪行者，闻河间之名，则掩耳蹙頞，皆不欲道之。","book":"唐·柳宗元《河间妇传》"},"usage":"作谓语、定语、状语；用于处事"},{"id":22212,"word":"掩胳埋胔","pinyin":"yǎn gé mái zì","abbr":"ygmz","explanation":"掩：埋葬；胳：骨；胔：腐肉，统指腐烂的尸骨。指埋葬尸骨。","source":{"text":"毋聚大众，毋置城郭。掩胳埋胔。","book":"《礼记·月令》"}},{"id":22213,"word":"掩贤妒善","pinyin":"yǎn xián dù shàn","abbr":"yxds","explanation":"掩：压制；贤、善：指有才德的人。指压制和妒嫉优秀的人才。","source":{"text":"勿谓卫公掩贤妒善，牛相不罹大祸，亦幸而免。","book":"宋·孙光宪《北梦琐言》卷一"},"usage":"作谓语、定语；用于处事"},{"id":22214,"word":"掩过扬善","pinyin":"yǎn guò yáng shàn","abbr":"ygys","explanation":"指对待别人讳言其过恶，称扬其好处。同“掩恶扬善”。","source":{"text":"[丙吉]于官属掾吏，务掩过扬善。","book":"《汉书·丙吉传》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":22215,"word":"掩过饰非","pinyin":"yǎn guò shì fēi","abbr":"ygsf","explanation":"犹言文过饰非。掩饰过失、错误。","source":{"text":"他们想占有一切，他们的手不用以创造，而用以掩过饰非。","book":"李广田《〈散文三十篇〉序》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":22216,"word":"掩非饰过","pinyin":"yǎn fēi shì guò","abbr":"yfsg","explanation":"掩、饰：掩饰；非、过：错误。用漂亮的言词掩饰自己的过失和错误。","source":{"text":"辩足以饰非。","book":"《论语·子张》：“小人之过也必文。”《庄子·盗跖》"}},{"id":22217,"word":"掩面失色","pinyin":"yǎn miàn shī sè","abbr":"ymss","explanation":"遮着脸面，变了颜色。形容惊慌害怕。","source":{"text":"用刀刮骨，悉悉有声。帐上帐下见者，皆掩面失色。","book":"明·罗贯中《三国演义》第七十五回"},"usage":"作谓语、状语；用于处事"},{"id":22218,"word":"掩面而泣","pinyin":"yǎn miàn ér qì","abbr":"ymeq","explanation":"用两手掩着脸哭泣。","source":{"text":"或掩面而泣，悲不自胜。","book":"《三国志·魏志·三少帝纪》裴松之注引《汉晋春秋》"},"example":{"text":"燕青还要俄延，当不得执令旗的小校连次催促，止不住泪落满腮，上皇亦～。","book":"清·陈忱《水浒后传》第二十四回"}},{"id":22219,"word":"掩骼埋窆","pinyin":"yǎn gé mái biǎn","abbr":"ygmb","explanation":"指收葬暴露于野的尸骨。为古代的恤民之政。同“掩骼埋胔”。","source":{"text":"但以生者之情，不忍见形之毁，乃有掩骼埋窆之制。","book":"《后汉书·赵咨传》"},"similar":["掩骼埋胔"],"usage":"作谓语、定语；用于书面语"},{"id":22220,"word":"掩骼埋胔","pinyin":"yǎn gé mái zì","abbr":"ygmz","explanation":"指收葬暴露于野的尸骨。为古代的恤民之政。","source":{"text":"骨枯曰骼，肉腐曰胔。","book":"《礼记·月令》：“[孟春之月]掩骼埋胔。”郑玄注"},"example":{"text":"方春戒节，赈济乏厄，～之时。","book":"《后汉书·质帝纪》"},"similar":["掩骼埋窆"],"usage":"作谓语、定语；用于书面语"},{"id":22221,"word":"掩鼻偷香","pinyin":"yǎn bí tōu xiāng","abbr":"ybtx","explanation":"捂住鼻子去偷点燃的香。比喻自己欺骗自己。","source":{"text":"师曰：‘节目上更生节目。’僧无语。师曰：‘掩鼻偷香，空招罪犯。’","book":"宋·释普济《五灯会元·马颊本空禅师》"},"similar":["掩耳盗铃"],"usage":"作宾语、定语；用于比喻句"},{"id":22222,"word":"掩鼻而过","pinyin":"yǎn bí ér guò","abbr":"ybeg","explanation":"捂着鼻子走过去。形容对腥臭肮脏的东西的嫌恶。","source":{"text":"西子蒙不洁，则人皆掩鼻而过之。","book":"《孟子·离娄下》"},"similar":["人皆掩鼻"],"opposite":["蜂拥而至"],"usage":"作谓语、定语、宾语；指厌恶"},{"id":22223,"word":"措心积虑","pinyin":"cuò xīn jī lǜ","abbr":"cxjl","explanation":"犹言处心积虑。指长久考虑在心。","source":{"text":"逮迹其自为，则因循惰弛，罕克自强，措心积虑，甘心为小人，而不以为病。","book":"宋·何坦《西畴常言》"},"example":{"text":"有识之士疑之，则以谓潜师游方之外者也，其～皆与吾道殊，初不可以强而同。","book":"明·宋濂《序》"},"similar":["处心积虑"],"usage":"作宾语、状语；指费尽心思做坏事"},{"id":22224,"word":"措手不及","pinyin":"cuò shǒu bù jí","abbr":"csbj","explanation":"措手：着手处理。来不及动手应付。指事出意外，一时无法对付。","source":{"text":"咱今晚间，领着百十骑人马，偷营动寨，走一遭去，杀他个措手不及。","book":"元·无名氏《千里独行》楔子"},"example":{"text":"关公赤兔马快，早已跑到面前，颜良～，被云长手起一刀，刺于马下。","book":"明·罗贯中《三国演义》第二十五回"},"similar":["猝不及防","惊慌失措","手足无措"],"opposite":["措置裕如","从容不迫","镇定自若"],"usage":"作谓语、宾语、状语；指事情突然发生"},{"id":22225,"word":"措手不迭","pinyin":"cuò shǒu bù dié","abbr":"csbd","explanation":"形容做事快速、敏捷。","source":{"text":"薛明看见军伍散乱，心中着忙，措手不迭，被钟明斩于马下，拍马来夹攻徐福。","book":"明·冯梦龙《喻世明言》第二十一卷"},"example":{"text":"那些衙役，把……等行李，～的搬进舱去。","book":"清·夏敬渠《野叟曝言》第二十三回"},"similar":["措手不及"],"opposite":["笨手笨脚"],"usage":"作谓语、状语；指人做事快"},{"id":22226,"word":"措置乖方","pinyin":"cuò zhì guāi fāng","abbr":"czgf","explanation":"措置：布置安排；乖方：不合条理。指安排处置不合理。","source":{"text":"其措置乖方，人言藉藉，而无敢为皇上言者，或虑无实据也。","book":"《清史稿·王茂荫传》"},"opposite":["措置有方"],"usage":"作谓语、宾语；指人办事与处世"},{"id":22227,"word":"措置失宜","pinyin":"cuò zhì shī yí","abbr":"czsy","explanation":"措置：布置安排；宜：合适，适当。安排处理事情不妥当。"},{"id":22228,"word":"措置有方","pinyin":"cuò zhì yǒu fāng","abbr":"czyf","explanation":"措置：布置安排；方：方法，条理。安排布置很有条理。","source":{"text":"女子见他措置有方，只道投著好人，亦且此身无主，放心随他去。","book":"明·凌濛初《初刻拍案惊奇》卷十二"},"opposite":["措置乖方"],"usage":"作谓语、宾语；指人办事与处世"},{"id":22229,"word":"措置裕如","pinyin":"cuò zhì yù rú","abbr":"czyr","explanation":"措置：处理，安排；裕如：从容不迫，很有办法的样子。处理事情从容不迫。常用来称赞人有办事的才能和经验。","source":{"text":"前署苏松、福山等镇篆务措置裕如，堪以很令署理。","book":"清·刘坤一《提督因疾出缺请旨简放折》"},"example":{"text":"在所谓国民党偏师说的的指导之下，使得反对第四次“围剿”丧失了～的能力的事实。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["游刃有余","应付裕如","从容不迫"],"opposite":["手足无措","措手不及"],"usage":"作谓语、宾语、定语；用于赞扬别人"},{"id":22230,"word":"措颜无地","pinyin":"cuò yán wú dì","abbr":"cywd","explanation":"措：放置；颜：脸，指面子。脸没处搁。形容极其惭愧。","source":{"text":"逐臣吹毛洗垢，自知积罪如山；学士排难解纷，反使措颜无地。","book":"明·陈汝元《金莲记·释愤》"},"similar":["无地自容"],"usage":"作谓语、状语；形容十分惭愧"},{"id":22231,"word":"掳掠奸淫","pinyin":"lǔ lüè jiān yín","abbr":"lljy","explanation":"抢夺财物，奸淫妇女。","source":{"text":"谁知仍是强赊硬抢，掳掠奸淫，无所不至。","book":"清·吴趼人《痛史》第七回"}},{"id":22232,"word":"掳袖揎拳","pinyin":"lǔ xiù xuān quán","abbr":"lxxq","explanation":"掳：挽；揎：拳打。把袖子往上一推，露出胳膊，握着拳头。形容准备动手。","source":{"text":"一个个酒囊饭袋成何用，掳袖揎拳号俊杰。","book":"元·无名氏《渔樵闲话》第三折"},"similar":["揎拳掳袖"],"usage":"作谓语、状语、定语；用于行动"},{"id":22233,"word":"掴打挝揉","pinyin":"guó dǎ zhuā róu","abbr":"gdwr","explanation":"掴：用巴掌打；挝：敲，打；揉：折磨。巴掌打，棍子敲，还用各种手段加以折磨。形容凶猛毒辣。","source":{"text":"那里面藏圈套，都是些绵中刺，笑里刀，那一个出得他掴打挝揉。","book":"元·秦简夫《东堂老》第一折"},"usage":"作谓语、宾语、定语；指打击"},{"id":22234,"word":"掷地之材","pinyin":"zhì dì zhī cái","abbr":"zdzc","explanation":"指能写出文辞优美、声调铿锵的好文章的人才。","source":{"text":"惭非掷地之材，有玷他山之石。","book":"宋·王禹偁《重修北岳庙碑奉敕撰并序》"},"usage":"作宾语；用于书面语"},{"id":22235,"word":"掷地作金石声","pinyin":"zhì dì zuò jīn shí shēng","abbr":"zdzjss","explanation":"比喻文章词藻优美，声调铿锵。","source":{"text":"卿试掷地，当作金石声也。","book":"《晋书·孙绰传》"},"example":{"text":"真是字字～啊！","book":"习仲勋《彭总在西北战场》"},"similar":["掷地有声","掷地赋声","掷地金声"],"usage":"作谓语、宾语；用于文章","story":["晋朝时期，孙兴公写成《天台赋》，拿给范荣期看说：“你试着把它扔在地上会发出金石般的声音。”范荣期说：“恐怕该金石声不是五音中的乐声！”然而每读到好句子时，范荣期总是称赞说：“应该是我们这些人说的话。”"]},{"id":22236,"word":"掷地有声","pinyin":"zhì dì yǒu shēng","abbr":"zdys","explanation":"掷：投、扔。比喻文章文辞优美，语言铿锵有力。","source":{"text":"孙兴公作《天台赋》成，以示范荣期云：‘卿试掷地，要作金石声。’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"斩钉截铁，字字雪亮，此等灯迷，可谓～了。","book":"清·李汝珍《镜花缘》第八十一回"},"similar":["掷地金声","掷地赋声"],"opposite":["无声无息"],"usage":"作谓语、定语；用于说话与文章"},{"id":22237,"word":"掷地赋声","pinyin":"zhì dì fù shēng","abbr":"zdfs","explanation":"形容辞章优美。同“掷地金声”。","source":{"text":"腰印能如季士稀，恐掷地赋声难比。","book":"明·郑若庸《玉玦记·赴试》"},"similar":["掷地作金石声","掷地有声"],"usage":"作谓语、定语；用于书面语"},{"id":22238,"word":"掷地金声","pinyin":"zhì dì jīn shēng","abbr":"zdjs","explanation":"金：钟罄之类的乐器。比喻文章词藻优美。","source":{"text":"卿试掷地，当作金石声也。","book":"《晋书·孙绰传》"},"example":{"text":"佳哉，～也。","book":"清·黄周星《补张灵崔莹合传》"},"similar":["掷地赋声"],"opposite":["无声无息"],"usage":"作谓语；用于文章或说话"},{"id":22239,"word":"掷杖成龙","pinyin":"zhì zhàng chéng lóng","abbr":"zzcl","explanation":"后以之为典，借指还乡。","source":{"text":"传说东汉费长房见一老翁挂着一把壶卖药，然后就跳进壶里去。第二天，费去拜访他，和他一起入壶，但见房屋华丽，酒菜也很好。费于是向老翁学道，后来骑着老翁所给的竹杖回家，投杖于葛陂，变成一条龙。"},"example":{"text":"偶然～去，又过蓬莱日主祠。","book":"清·王士禛《送高念东先生予告还山》诗之二"},"usage":"作宾语、定语；指法术","story":["古代传说费长房有一次看见一个老翁挂着一把壶卖药，卖完后就跳进壶中。第二天他去拜访老翁，和老翁一起进入壶内，壶中房舍华丽，应有尽有。他向老翁学道，后来骑着老翁给他的竹杖回家，把竹杖扔在葛陂，竹杖变成一条巨龙飞了回去"]},{"id":22240,"word":"掷果潘安","pinyin":"zhì guǒ pān ān","abbr":"zgpa","explanation":"旧时比喻为女子所爱慕的美男子。","source":{"text":"安仁至美，每行，老妪以果掷之满车。","book":"南朝宋·刘义庆《世说新语·容止》：“潘岳妙有姿容，好神情。少时挟弹出洛阳道，妇人遇者，莫不连手共萦之。”刘孝标注引《语林》"},"example":{"text":"今日为头看，看你个离魂倩女，怎生的～。","book":"元·王实甫《西厢记》第三本第二折"},"similar":["潘郎车满"],"usage":"作宾语、定语；用于女性爱慕美男","story":["晋朝时期，荥阳中牟人潘岳（人称潘安）长得十分漂亮，文才出众，20岁就进京城洛阳做官。他经常乘坐华丽的车子到郊外去打猎。一路上被许多妇女围观，就连老太婆也争着往他车上投掷果品表达爱慕之情，每次回来都是满载而归"]},{"id":22241,"word":"掷果潘郎","pinyin":"zhì guǒ pān láng","abbr":"zgpl","explanation":"比喻美男子。同“掷果潘安”。","source":{"text":"安仁至美，每行，老妪以果掷之满车。","book":"南朝宋·刘义庆《世说新语·容止》：“潘岳妙有姿容，好神情。少时挟弹出洛阳道，妇人遇者，莫不连手共萦之。”刘孝标注引《语林》"},"example":{"text":"～谁不慕，朱门别见红妆露。","book":"唐·司空图《冯燕歌》"},"similar":["掷果潘安"],"usage":"作宾语、定语；用于女性"},{"id":22242,"word":"掷果盈车","pinyin":"zhì guǒ yíng chē","abbr":"zgyc","explanation":"比喻女子对美男子的爱慕。","source":{"text":"安仁至美，每行，老妪以果掷之满车。","book":"南朝·宋·刘义庆《世说新语·容止》：“潘岳妙有姿容，好神情。”刘孝标注引《语林》"},"example":{"text":"其人如玉，空教～，当此春景融和，不奈乡心迢递。","book":"明·梅鼎祚《玉合记·诇约》"},"usage":"作宾语、定语；用于书面语"},{"id":22243,"word":"掷鼠忌器","pinyin":"zhì shǔ jì qì","abbr":"zsjq","explanation":"犹言投鼠忌器。","source":{"text":"班与匡书云：‘《刘向传》曰：掷鼠忌器。器犹忌之，况卓今处宫阙之内，以天子为藩屏……","book":"《三国志·魏书·袁绍传》：“卓遣执金吾胡母班、将作大匠吴修赍诏书喻绍，绍使河内太守王匡杀之”裴松之注引三国吴·谢承《后汉书》"},"example":{"text":"～空持疑，喂虎割肉有尽时。","book":"清·林旭《叔峤印伯居伏魔寺数往访之》诗"},"similar":["投鼠忌器"],"usage":"作宾语、定语；用于处事"},{"id":22244,"word":"揆情审势","pinyin":"kuí qíng shěn shì","abbr":"kqss","explanation":"估量情况审察形势。","source":{"text":"我恶西人，我思古道，礼失求野，择善而从，以渐复我虞、夏、商、周之盛轨，揆情审势，旦暮之间耳。","book":"清·陈炽《〈盛世危言〉叙》"},"similar":["审时度势","揆时度势"],"usage":"作谓语、宾语；用于处事"},{"id":22245,"word":"揆情度理","pinyin":"kuí qíng duó lǐ","abbr":"kqdl","explanation":"揆：估量揣测；度：猜想。按照情和理估量，推测。","source":{"text":"能治五官之事者，不可揆度者也。","book":"《淮南子·兵略训》"},"example":{"text":"不怪；～想了去，此中也小小的有些天理人情。","book":"清·文康《儿女英雄传》第三十三回"},"similar":["详情度理"],"usage":"作主语；指按照情和理推测"},{"id":22246,"word":"揆文奋武","pinyin":"kuí wén fèn wǔ","abbr":"kwfw","explanation":"施行文教，振奋武事。","source":{"text":"揆，度也。度王者文教而行之。","book":"语出《书·禹贡》：“五百里绥服；三百里揆文教；二百里奋武卫。”孔传"},"example":{"text":"宰治天下，定鼎天京，立政任人，～。","book":"太平天国洪仁玕《英杰归真》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":22247,"word":"揆时度势","pinyin":"kuí shí dù shì","abbr":"ksds","explanation":"指审度时势。","source":{"text":"自鸦片烟之议兴，林则徐不能揆时度势，妥善办理，致夷人激而用兵，然振厉戎行，足以制伏夷人。","book":"清·平步青《霞外攟屑·掌故·陈侍御奏折》"},"example":{"text":"欲求一贤督抚言之，而～，不可轻动，故迟之。","book":"清·冯桂芬《江苏减赋记》"},"similar":["揆情审势","审时度势"],"usage":"作谓语、宾语；用于处事"},{"id":22248,"word":"揆理度势","pinyin":"kuí lǐ duó shì","abbr":"klds","explanation":"衡量道理，揣度情势。","source":{"text":"虽若确有把握，然专断一国贸易，与概断各国贸易，揆情度势，迥不相同。","book":"清·林则徐《复奏曾望颜条陈封关禁海事宜折》"},"usage":"作谓语；用于分析局势"},{"id":22249,"word":"揆理度情","pinyin":"kuí lǐ duó qíng","abbr":"kldq","explanation":"揆：揣测；理：事理；度：估计，猜度；情：常情。从情理上揣度。","source":{"text":"揆理度情，大有未便。","book":"明·刘若愚《酌中志·辽左弃地》"},"similar":["揆情度理"],"usage":"作谓语、分句；指从情理上揣度"},{"id":22250,"word":"揉眵抹泪","pinyin":"róu chī mǒ lèi","abbr":"rcml","explanation":"眵：眼屎，此指眼睛。擦着眼泪，揉着眼睛。形容落泪伤心的样子。","source":{"text":"老儿也似这般烦恼的无颠无倒，越惹你揉眵抹泪哭嚎啕。","book":"元·康进之《李逵负荆》第三折"}},{"id":22251,"word":"揎拳拢袖","pinyin":"xuān quán lǒng xiù","abbr":"xqlx","explanation":"捏紧拳头，卷起袖口。形容准备动武的样子。"},{"id":22252,"word":"揎拳捋袖","pinyin":"xuān quán luō xiù","abbr":"xqlx","explanation":"揎：卷起袖子；捋：拉起。伸出拳头，拉起袖子。形容怒气冲冲准备动武的样子。","source":{"text":"欺良压善没分晓，揎拳捋袖行凶暴。","book":"元·杨景贤《刘行首》第二折"},"example":{"text":"他看着我～，舒着拳头要打我。","book":"元·武汉臣《生金阁》第三折"},"similar":["揎拳掳袖"],"usage":"作谓语、状语、定语；指发怒的样子"},{"id":22253,"word":"揎拳捰袖","pinyin":"xuān quán lǒng xiù","abbr":"xqlx","explanation":"伸出拳头，捋起袖子。一种粗野蛮横或准备动武的姿态。"},{"id":22254,"word":"揎拳掳袖","pinyin":"xuān quán lǔ xiù","abbr":"xqlx","explanation":"把袖子往上一推，露出胳膊，握着拳头。形容准备动手。","source":{"text":"你个乐探哥哥何须闹，欺良压善没分晓，揎拳捋袖行凶暴，你你你不辨低高。","book":"元·杨景贤《马丹阳》"},"example":{"text":"顺天府五城青衣，都～的在那里搜检。","book":"清·文康《儿女英雄传》第34回"},"similar":["跃跃欲试","蠢蠢欲动"],"usage":"作谓语、状语、定语；用于行动"},{"id":22255,"word":"揎拳攘臂","pinyin":"xuān quán rǎng bì","abbr":"xqrb","explanation":"揎拳：卷袖出拳；攘臂：捋起袖子，露出胳膊。形容振奋或发怒的样子。","source":{"text":"一个尚是冷笑面孔；一个竟揎拳攘臂，雄纠纠的据坐榻床，掿起烟枪，把烟盘乱搠。","book":"清·韩邦庆《海上花列传》第十四回"}},{"id":22256,"word":"揎拳攞袖","pinyin":"xuān quán luó xiù","abbr":"xqlx","explanation":"伸出拳头，露出手臂。一种粗野蛮横的姿态。","source":{"text":"他见我早揎拳攞袖，怒目撑眉。","book":"元·无名氏《杀狗劝夫》第二折"},"example":{"text":"我见他手慌脚乱，～。急慌的，慌的便要杀。","book":"明·王元吉《流星马》第三折"},"similar":["揎拳捋袖","揎拳裸袖"],"usage":"作谓语、状语、定语；指发怒的样子"},{"id":22257,"word":"揎拳舞袖","pinyin":"xuān quán wǔ xiù","abbr":"xqwx","explanation":"伸出拳头，挥动衣袖。一种粗野蛮横的姿态。","source":{"text":"又有一班猛勇骁悍之辈，揎拳舞袖，说强夸胜，自称好汉，相见了便觉分外兴高，说话处脾胃多燥，行事时举步生风。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["揎拳裸袖"],"usage":"作谓语、定语、状语；用于处事"},{"id":22258,"word":"揎拳裸手","pinyin":"xuān quán luǒ shǒu","abbr":"xqls","explanation":"伸出拳头，露出手臂。一种粗野蛮横的姿态。","source":{"text":"江老夫妻，女儿三口，杀猪也似的叫喊，擂天倒地价哭。捕人每揎拳裸手，耀武扬威。","book":"明·凌濛初《二刻拍案惊奇》卷十五"},"similar":["揎拳裸臂","揎拳裸袖"],"usage":"作谓语、定语、状语；用于处事"},{"id":22259,"word":"揎拳裸臂","pinyin":"xuān quán luǒ bì","abbr":"xqlb","explanation":"伸出拳头，露出手臂。一种粗野蛮横的姿态。","source":{"text":"先把棺木放在一门厢房里，然后揎拳裸臂，跨入房中，教玉英姊妹走开。","book":"明·冯梦龙《醒世恒言》第二十七卷"},"similar":["揎拳裸手","揎拳裸袖"],"usage":"作谓语、定语、状语；用于处事"},{"id":22260,"word":"揎拳裸袖","pinyin":"xuān quán luǒ xiù","abbr":"xqlx","explanation":"犹言揎拳捋袖。","source":{"text":"［夏侯玄］揎拳裸袖，径击司马师，却被武士擒住。","book":"明·罗贯中《三国演义》第一百九回"},"example":{"text":"看他～，两眼睁得铜铃也似，一些笑颜也没有，一句闲话也不说，却象个怒气填胸，寻事发作的一般。","book":"明·凌濛初《初刻拍案惊奇》卷三十"},"similar":["裸袖揎拳"],"usage":"作谓语、状语；用于处事"},{"id":22261,"word":"揎腕攘臂","pinyin":"xuān wàn rǎng bì","abbr":"xwrb","explanation":"捋袖伸臂。一种粗暴的姿态。","source":{"text":"譬之盲僮跛竖，各以其意喜怒主人，而揎腕攘臂于藩篱之外，而主人曾莫知之也。","book":"清·戴名世《〈齐讴集〉自序》"},"similar":["揎拳裸袖"],"usage":"作谓语、定语、状语；用于处事"},{"id":22262,"word":"揎袖攘臂","pinyin":"xuān xiù rǎng bì","abbr":"xxrb","explanation":"揎袖：卷起袖子；攘臂：捋袖露臂。形容振奋或发怒的样子。","source":{"text":"乔故有心疾，恃阉益张，揎袖攘臂，狂易如瘈狗。","book":"清·钱谦益《明故陕西按察司按察使徐公墓志铭》"},"example":{"text":"吴松桥听说，～，和荡市豁起拳来。","book":"清·韩邦庆《海上花列传》第三回"}},{"id":22263,"word":"描写画角","pinyin":"miáo xiě huà jiǎo","abbr":"mxhj","explanation":"比喻无中生有。","source":{"text":"阮亭之意，必欲其描头画角若明七子，而后谓之窥盛唐乎？","book":"清·袁枚《随园诗话》卷三"},"example":{"text":"稚燕因把路上盗图的事说了一遍，却～，都推在雯青身上。","book":"清·曾朴《孽海花》第十九回"},"usage":"作谓语、定语；指无中生有"},{"id":22264,"word":"描头画角","pinyin":"miáo tóu huà jiǎo","abbr":"mthj","explanation":"比喻刻意模仿，毫无新意。","source":{"text":"阮亭之意，必欲其描头画角若明七子，而后谓之窥盛唐乎？","book":"清·袁枚《随园诗话》第三卷"},"example":{"text":"写法又明朗简洁，绝无旧文人～，宛转抑扬的恶习。","book":"鲁迅《集外集拾遗·后记》"},"usage":"作谓语、定语；指刻意模仿"},{"id":22265,"word":"描眉画眼","pinyin":"miáo méi huà yǎn","abbr":"mmhy","explanation":"指妇女描画眉毛、眼睛，化妆打扮。","source":{"text":"从九岁卖在王招宣府里，习学弹唱，就会描眉画眼，傅粉施朱。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"example":{"text":"一对一对的，俱是搽指抹粉，～，装腔作势，扭捏袅娜而来。","book":"清·夏敬渠《叟野曝言》第六十七回"},"usage":"作谓语、宾语、定语；多用于女性"},{"id":22266,"word":"描神画鬼","pinyin":"miáo shén huà guǐ","abbr":"mshg","explanation":"描画鬼神，指凭臆想描写不存在的事物。","source":{"text":"描神画鬼，毫无对证，本可以专靠了神思。","book":"鲁迅《且介亭杂文二集·叶紫序》"},"usage":"作谓语；指凭空杜撰"},{"id":22267,"word":"描鸾刺凤","pinyin":"miáo luán cì fèng","abbr":"mlcf","explanation":"形容女子工于刺绣。","source":{"text":"作赋吟诗，人人尽说蔡文姬的再生；描鸾刺凤，个个皆称薛夜来的神针。","book":"明·陆采《明珠记·由房》"},"example":{"text":"以至～，斗草簪花，低吟悄唱，拆字猜枚，无所不至，倒也十分快意。","book":"清·曹雪芹《红楼梦》第二十三回"},"similar":["描龙刺凤"],"usage":"作谓语、宾语、定语；用于刺绣等"},{"id":22268,"word":"描龙刺凤","pinyin":"miáo lóng cì fèng","abbr":"mlcf","explanation":"描：摹写或绘画；刺：刺绣。指精于刺绣。","source":{"text":"诗词歌赋，琴棋书画，描龙刺凤，女工织黹，饮馔酒浆。","book":"明·洪楩《清平山堂话本·风月瑞仙亭》"},"example":{"text":"咱们是要她们上马杀敌，却不是要她们坐在绣房里～，说起话来轻言细语。","book":"姚雪垠《李自成》第二卷第四十六章"},"similar":["描龙绣凤"],"usage":"作谓语、宾语、定语；用于刺绣等"},{"id":22269,"word":"描龙绣凤","pinyin":"miáo lóng xiù fèng","abbr":"mlxf","explanation":"指精美的手工刺绣。泛指古代女红。亦作“描鸾刺凤”、“描龙刺凤”。","source":{"text":"诗词歌赋，琴棋书画，描龙刺凤，女工织黹，饮馔酒浆。","book":"明·洪楩《清平山堂话本·风月瑞仙亭》"},"example":{"text":"不拘～，件件皆精；琴棋书画，般般都会。","book":"清·张南庄《何典》第七回"},"similar":["描龙刺凤","描鸾刺凤"],"usage":"作谓语、宾语、定语；用于刺绣等"},{"id":22270,"word":"提剑汗马","pinyin":"tí jiàn hàn mǎ","abbr":"tjhm","explanation":"汗马：所骑战马奔驰出汗。手提宝剑，身跨战马。比喻在战场上建立功勋。","source":{"text":"男儿当以取公侯，何能如先生为博士也。","book":"《周书·宇文贵传》"},"usage":"作谓语、宾语；用于书面语"},{"id":22271,"word":"提名道姓","pinyin":"tí míng dào xìng","abbr":"tmdx","explanation":"提、道：说。直呼他人姓名，对人不够尊敬。","source":{"text":"这里老太太才说这一个，他又来提名道姓的了。","book":"清·曹雪芹《红楼梦》第31回"},"example":{"text":"你最好不要～伤人自尊心。"},"similar":["指名道姓","题名道姓"],"opposite":["含沙射影"],"usage":"作谓语、宾语；指直呼他人姓名","story":["王夫人、薛宝钗、林黛玉等在贾母房内聊天，有人报告史湘云来了，众人迎接，大观园内又多了一位金钗。贾宝玉跑来看史湘云，一见十分高兴，亲热的叫她的名字。王夫人要他不要提名道姓，她们在一起又玩个天昏地暗"]},{"id":22272,"word":"提奖后辈","pinyin":"tí jiǎng hòu bèi","abbr":"tjhb","explanation":"辈：代。提拔勉励后一代。","source":{"text":"然提奖后辈，以名行为先，浮华轻险之徒，虽有都能，弗重也。","book":"《北史·魏收传》"},"usage":"作谓语、宾语；用于处事"},{"id":22273,"word":"提心吊胆","pinyin":"tí xīn diào dǎn","abbr":"txdd","explanation":"形容十分担心或害怕。","source":{"text":"众僧闻得此言，一个个提心吊胆，告天许愿。","book":"明·吴承恩《西游记》第十七回"},"example":{"text":"但他们往往遭农会严厉拒绝，所以他们总是悬心吊胆地过日子。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["担惊受怕","心惊胆战"],"opposite":["心安理得","谈笑自若","处之泰然"],"usage":"作谓语、宾语、状语；指担心或害怕"},{"id":22274,"word":"提心在口","pinyin":"tí xīn zài kǒu","abbr":"txzk","explanation":"心在口边，几乎要跳出来。形容担心、恐惧。","source":{"text":"不争你握雨携云，常使我提心在口。","book":"元·王实甫《西厢记》第四本第二折"},"example":{"text":"梁斌《播火记》：“他猛醒了一下，觉得失了口。立时～，回过头向左右看了看，见并没有别人，才放下心来。”"},"similar":["提心吊胆"],"usage":"作谓语、定语、状语；用于惊恐时"},{"id":22275,"word":"提牌执戟","pinyin":"tí pái zhí jǐ","abbr":"tpzj","explanation":"牌、戟：官府门前所用榜牌和作仪仗用的门戟。指在高官手下当差。形容身份、才能低下。","source":{"text":"他是个架海擎天的玉柱，看承做提牌执戟小人哉。","book":"元·无名氏《衣锦还乡》第一折"},"usage":"作谓语、定语；用于书面语"},{"id":22276,"word":"提纲举领","pinyin":"tí gāng jǔ lǐng","abbr":"tgjl","explanation":"比喻抓住要领，简明扼要。同“提纲挈领”。","source":{"text":"提纲举领，尽立主宾，如何是主？","book":"宋·释道原《景德传灯录·遇安禅师》"},"similar":["提纲挈领","提纲振领"],"usage":"作谓语、定语、宾语；指简明扼要"},{"id":22277,"word":"提纲挈领","pinyin":"tí gāng qiè lǐng","abbr":"tgql","explanation":"纲：鱼网的总绳；挈：提起。抓住网的总绳，提住衣的领子。比喻抓住要领，简明扼要。","source":{"text":"提纲而众目张，振领而群毛理。","book":"《韩非子·外储说右下》：“善张网者引其纲，不一一摄万目而后得。”《荀子·劝学》：“若挈裘领，诎五指而而顿之，顺者不可胜数也。”《宋史·职官志八》"},"example":{"text":"因此便想到一个～的法子。","book":"清·李宝嘉《官场现形记》第六十回"},"similar":["纲举目张","一针见血","提纲举领"],"opposite":["不得要领","言不及义"],"usage":"作谓语、定语、宾语；指简明扼要"},{"id":22278,"word":"提纲振领","pinyin":"tí gāng zhèn lǐng","abbr":"tgzl","explanation":"比喻抓住要领，简明扼要。同“提纲挈领”。","source":{"text":"每在执行，使庶僚则守法奉公，宰臣则提纲振领，必当彝伦攸叙。","book":"《旧五代史·职官志》"},"example":{"text":"三十年后莫道杨岐龙头蛇尾，其～大类云门。","book":"宋·释惟白《续传灯录》卷七"},"similar":["提纲举领","提纲挈领"],"usage":"作谓语、定语、宾语；指简明扼要"},{"id":22279,"word":"提要钩玄","pinyin":"tí yào gōu xuán","abbr":"tygx","explanation":"提要：指出纲要；钩玄：探索精微。精辟而简明地指明主要内容。","source":{"text":"记事者必提其要，篡言者必钩其玄。","book":"唐·韩愈《进学解》"},"example":{"text":"读记事篡言之书，博矣，详矣，～，则已约矣。","book":"清·陈澧《与王峻之书》"},"similar":["钩玄提要"],"usage":"作谓语；指探取精微，摘出纲要"},{"id":22280,"word":"插圈弄套","pinyin":"chā quān nòng tào","abbr":"cqnt","explanation":"比喻耍阴谋陷害人。","source":{"text":"糟老头子齐柏年，黄口小儿俞菖蒲，花言巧语，插圈弄套，哄骗我跟他们合伙打日本，我才不中他们的借刀杀人之计。","book":"刘绍棠《狼烟》二十二"}},{"id":22281,"word":"插插花花","pinyin":"chā chā huā huā","abbr":"cchh","explanation":"花花言巧语。","source":{"text":"不要你插插花花认我来，哭哭啼啼泪腮，你这般怨怨哀哀磕着头拜。","book":"元·无名氏《渔樵记》第二折"},"similar":["花言巧语"],"usage":"作状语；用于书面语"},{"id":22282,"word":"插架万轴","pinyin":"chā jià wàn zhóu","abbr":"cjwz","explanation":"插架：将藏书安放在书架上。轴：古代书卷中的杆，借指书籍。形容藏书丰富。","source":{"text":"邺侯家多书，插架三万轴。","book":"语出唐·韩愈《送诸葛觉往随州读书》诗"},"example":{"text":"～兮星宿悬，口吟目披兮游圣贤。","book":"宋·秦观《掩关铭》"},"similar":["汗牛充栋"],"usage":"作宾语、定语；指藏书多"},{"id":22283,"word":"插汉干云","pinyin":"chā hàn gān yún","abbr":"chgy","explanation":"持汉：插入河汉；干云：高入云霄。形容非常高。","source":{"text":"其水南流经鲁阳关左右，连山插汉，秀木干云。","book":"北魏·郦道元《水经注·淆水》"}},{"id":22284,"word":"插烛板床","pinyin":"chā zhú bǎn chuáng","abbr":"czbc","explanation":"指用木头做成的极简陋的蜡烛插架。形容生活作风廉洁朴素。","source":{"text":"傅昭为中书通事舍人时，居此职者皆权权倾天下，昭独廉静，无所干豫，器服率陋，身安粗粝，常插烛板床，明帝闻之，赐漆盒烛盘。","book":"唐·李延寿《南史·傅昭传》"}},{"id":22285,"word":"插科使砌","pinyin":"chā kē shǐ qì","abbr":"cksq","explanation":"砌，拼凑；捏造。指以滑稽的动作和诙谐的语言引人发笑。","source":{"text":"苦会插科使砌，何吝搽灰抹土，歌笑满堂中。","book":"宋·无名氏《张协状元》戏文第一出"},"similar":["插科打诨"],"usage":"作宾语、谓语；泛指开玩笑逗乐"},{"id":22286,"word":"插科打诨","pinyin":"chā kē dǎ hùn","abbr":"ckdh","explanation":"科：指古典戏曲中的表情和动作；诨：诙谐逗趣的话。戏曲、曲艺演员在表演中穿插进去的引人发笑的动作或语言。","source":{"text":"休论插科打诨，也不寻宫数调，只看子孝与妻贤。","book":"明·高明《琵琶记·报告戏情》"},"example":{"text":"事情出了岔子的时候，～，轻松的把责任卸在别人头上。","book":"丁玲《太阳照在桑干河上》三五"},"similar":["打诨插科","撒科打诨"],"usage":"作谓语、宾语、定语；泛指开玩笑逗乐"},{"id":22287,"word":"插翅难逃","pinyin":"chā chì nán táo","abbr":"ccnt","explanation":"插上翅膀也难逃走。比喻陷入困境，怎么也逃不了。","source":{"text":"插上翅膀也难逃走。比喻陷入困境，怎么也逃不了。"},"example":{"text":"重耳虽～也。","book":"明·冯梦龙《东周列国志》第三十六回"},"similar":["插翅难飞"],"opposite":["易如反掌"],"usage":"作谓语、定语；比喻逃脱不了"},{"id":22288,"word":"插翅难飞","pinyin":"chā chì nán fēi","abbr":"ccnf","explanation":"插上翅膀也难飞走。比喻陷入困境，怎么也逃不了。","source":{"text":"插上翅膀也难飞走。比喻陷入困境，怎么也逃不了。"},"example":{"text":"则不与他城子，便相如插翅也飞不出函谷关去。","book":"元·高文秀《保成公径赴渑池会》第一折"},"similar":["插翅难逃","束手无策"],"opposite":["轻而易举","易如反掌"],"usage":"作谓语、定语；比喻逃脱不了"},{"id":22289,"word":"揖盗开门","pinyin":"yī dào kāi mén","abbr":"ydkm","explanation":"比喻接纳坏人，自取其祸。","source":{"text":"望风迎附，揖盗开门……卒至恶积祸盈，如屠犬豕。","book":"清·王韬《记李贼事》"},"example":{"text":"引狼入室，～，吾党何日醒！","book":"清·夏清贻《何日醒·东海滨三》"},"similar":["开门揖盗"],"usage":"作主语、谓语、定语；同“开门揖盗”"},{"id":22290,"word":"揠苗助长","pinyin":"yà miáo zhù zhǎng","abbr":"ymzz","explanation":"揠：拔。把苗拔起，以助其生长。比喻违反事物发展的客观规律，急于求成，反而把事情弄糟。","source":{"text":"宋人有闵其苗之不长而揠之者，茫茫然归，谓其人曰：‘今日病矣，予助苗长矣。’其子趋而往视之，苗则槁矣。","book":"《孟子·公孙丑上》"},"example":{"text":"对学生的教育既不能～，也不能放任自流。"},"similar":["欲速不达"],"opposite":["放任自流","循序渐进"],"usage":"作主语、宾语；同“拔苗助长”","story":["从前宋国一个农夫担心自己田里的禾苗长不高，就天天到田边去看。三天过去了，禾苗没见动静。他想出一个办法，就急忙奔到田里，把禾苗一棵棵拔高一些。回去对儿子说禾苗长高了一大截，儿子跑到田里一看，禾苗全都枯死了"]},{"id":22291,"word":"握两手汗","pinyin":"wò liǎng shǒu hàn","abbr":"wlsh","explanation":"形容非常震惊、害怕或担心。","source":{"text":"秀才，汝浑身是胆耶！吾亦为汝握两手汗也。","book":"《元史·赵璧传》"}},{"id":22292,"word":"握云拿雾","pinyin":"wò yún ná wù","abbr":"wynw","explanation":"驾驭云雾。意谓善于掌握戎机。同“握雾拏云”。","source":{"text":"则你那龙韬虎略人难赛，握云拿雾施兵策，排兵布阵添精彩。","book":"元·陈以仁《存孝打虎》第一折"},"similar":["握雾拿云"],"usage":"作谓语、定语；用于书面语"},{"id":22293,"word":"握云携雨","pinyin":"wò yún xié yǔ","abbr":"wyxy","explanation":"比喻男女欢合。","source":{"text":"都则为春心荡，也只想握云携雨，谁承望惹祸遭殃。","book":"明·无名氏《苏九淫奔》第二折"},"example":{"text":"～，与埋香葬玉，别鹤离鸾。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"similar":["握雨携云"],"usage":"作谓语、定语；用于书面语"},{"id":22294,"word":"握发吐哺","pinyin":"wò fā tǔ bǔ","abbr":"wftb","explanation":"比喻为国家礼贤下士，殷切求才。","source":{"text":"一沐三握发，一饭三吐哺。","book":"《史记·周世家》"},"example":{"text":"陛下～之日，宵衣旰食之辰，士无贤愚，咸宜录用。","book":"唐·陆贽《兴元论解姜公辅状》"},"similar":["挥沐吐餐","吐哺握发"],"usage":"作宾语、定语；用于处事","story":["西周时期，周成王继承父亲的遗志，分封诸侯，他封伯禽为鲁侯，周公向兄弟伯禽祝贺，说：“你以前是鲁国的有名能士，你到任后不要忘记你是周文王的儿子，周武王的弟弟，现今成王的叔叔。你要一沐三握发，一饭三吐哺，爱惜人才。”"]},{"id":22295,"word":"握发吐飧","pinyin":"wò fā tǔ sūn","abbr":"wfts","explanation":"比喻为国家礼贤下士，殷切求才。同“握发吐哺”。"},{"id":22296,"word":"握发吐餐","pinyin":"wò fà tǔ cān","abbr":"wftc","explanation":"握发：握着头发；吐：吐出。为了礼贤下士而停止洗头和吃饭。指为国而礼贤下士。","source":{"text":"万国康，犹弗已。握发吐餐，下群士。惟我君，继殷周。","book":"南朝·宋·何承天《宋鼓吹饶歌·思悲公篇》"},"similar":["握发吐哺","握沐吐餐"],"usage":"作宾语、定语；用于处事"},{"id":22297,"word":"握图临宇","pinyin":"wò tú lín yǔ","abbr":"wtly","explanation":"图：图籍；宇：天下。掌握全国地图，君临天下。比喻拥有全国政权。","source":{"text":"伏惟皇魏握图临宇，总契裁极，道敷九有，德被八荒。","book":"《魏书·崔楷传》"},"usage":"作谓语、定语；用于书面语"},{"id":22298,"word":"握手成交","pinyin":"wò shǒu chéng jiāo","abbr":"wscj","explanation":"一种作买卖的方式，双方一握手就表示一笔买卖作定。","example":{"text":"～的方式现在还在使用。"},"similar":["拍板成交"],"usage":"作谓语、定语；指成交"},{"id":22299,"word":"握手极欢","pinyin":"wò shǒu jí huān","abbr":"wsjh","explanation":"握手谈笑。多形容发生不和，以后又和好。","source":{"text":"及相见，共语移日，握手极欢。","book":"《后汉书·李通传》"},"similar":["握手极欢","握手言和"],"usage":"作谓语；指亲热友好"},{"id":22300,"word":"握手言欢","pinyin":"wò shǒu yán huān","abbr":"wsyh","explanation":"握手谈笑。多形容发生不和，以后又和好。","source":{"text":"及相见，共语移日，握手极欢。","book":"《后汉书·李通传》"},"example":{"text":"文于去年北上，与公～，闻公谆谆以国家与人民为念，以一日在职为苦。","book":"蔡东藩、许廑父《民国通俗演义》第二八回"},"similar":["重归于好","握手极欢"],"opposite":["不欢而散"],"usage":"作谓语；指亲热友好","story":["王莽末年，南阳动乱，李通与堂弟李轶商量只有投奔刘秀才有出息，于是就去拜访刘秀。李通侃侃而谈，智谋出众，刘秀目光远大，知人善任，两人相见恨晚，十分愉快地握手告别。几年后李通与刘秀在棘阳县相遇，共同击破南阳郡"]},{"id":22301,"word":"握拳透掌","pinyin":"wò quán tòu zhǎng","abbr":"wqtz","explanation":"紧握拳头，指甲穿过掌心。形容愤慨到极点。同“握拳透爪”。","source":{"text":"其后盗发壶墓，尸僵，鬓发苍白，面如生，两手悉拳，爪甲穿达手背。","book":"《晋书·卞壶传》"},"example":{"text":"他恨得～。"},"similar":["握拳透爪"],"usage":"作谓语、状语；指非常愤怒","story":["晋朝时期，武将卞壶为保卫国土，抵抗叛贼苏峻的进攻，父子两人均战死沙场，被就地安葬。后来有盗墓贼偷盗卞壶的坟墓，发现卞壶的尸体已经僵硬，鬓发苍白，面色如活人一样，双手都握紧拳头，指甲都穿透了手背"]},{"id":22302,"word":"握拳透爪","pinyin":"wò quán tòu zhǎo","abbr":"wqtz","explanation":"爪：指甲。紧握拳头，指甲穿过掌心。形容愤慨到极点。","source":{"text":"棺配而肌肉如生，握拳不开，爪透手背，远近惊异。","book":"唐·郑綮《开天传言记》"},"example":{"text":"高虎文如大力争持，～。","book":"清·钱振伦《文评》"},"similar":["握拳透掌"],"usage":"作谓语、定语；指非常愤慨","story":["晋朝时期，武将卞壶为保卫国土，抵抗叛贼苏峻的进攻，父子两人均战死沙场，被就地安葬。后来有盗墓贼偷盗卞壶的坟墓，发现卞壶的尸体已经僵硬，鬓发苍白，面色如活人一样，双手都握紧拳头，指甲都穿透了手背"]},{"id":22303,"word":"握椠怀铅","pinyin":"wò qiàn huái qiān","abbr":"wqhq","explanation":"椠：古代书写的木板；铅：铅粉笔。拿着木板，带着铅粉笔。指写作或校勘。","source":{"text":"杨子云好事，常怀铅提椠，从诸计吏访殊方绝域四方之语。","book":"晋·葛洪《西京杂记》卷三"},"example":{"text":"耆旧者惟闻其名，后生者不睹其事，今故寻源讨本，～，兼疏本传之文。","book":"唐·史承节《后汉大司农郑公之碑》"},"similar":["抱椠怀铅"],"usage":"作谓语、定语；指写作"},{"id":22304,"word":"握沐吐餐","pinyin":"wò mù tǔ cān","abbr":"wmtc","explanation":"沐：洗头发；吐：吐出。为了礼贤下士而停止洗头和吃饭。指为国而礼贤下士，求贤若渴。","source":{"text":"周公资圣人，而握沐吐餐，下白屋，况下周公之人哉！","book":"《新唐书·张玄素传》"},"similar":["握发吐餐"],"usage":"作宾语、定语；用于处事"},{"id":22305,"word":"握炭流汤","pinyin":"wò tàn liú tāng","abbr":"wtlt","explanation":"握炽炭，蹈沸汤。比喻不畏危难，敢于用命。","source":{"text":"于是流汤之党，握炭之徒，守似藩离，战同枯朽。","book":"《六韬》：“纣之卒，握炭流汤者十八人。”晋·陆倕《石阙铭》"},"example":{"text":"《六韬》：“纣之卒，～者十八人。”"},"usage":"作定语；用于书面语"},{"id":22306,"word":"握瑜怀玉","pinyin":"wò yú huái yù","abbr":"wyhy","explanation":"瑜：美玉。怀藏有美玉。比喻富有文学才能。","source":{"text":"是以握瑜怀玉之士，瞻郑邦而知退；章甫翠履之人，望闽乡而叹息。","book":"《南史·刘虬传》"},"similar":["握瑜怀瑾"],"usage":"作谓语、定语；指人品与才能"},{"id":22307,"word":"握瑜怀瑾","pinyin":"wò yú huái jǐn","abbr":"wyhj","explanation":"比喻人具有纯洁优美的品德。","source":{"text":"怀瑾握瑜兮，穷不知所示。","book":"战国·楚·屈原《楚辞·九章·怀沙》"},"example":{"text":"～酬君恩，勒鼎铭钟人所羡。","book":"明·陈子龙《匡山吟寄灯岩子》"},"similar":["握瑜怀玉"],"usage":"作谓语、定语；指人品与才能"},{"id":22308,"word":"握管怀铅","pinyin":"wò guǎn huái qiān","abbr":"wghq","explanation":"怀：怀藏；铅：铅粉。常带书写工具，以备写作的需要。","source":{"text":"杨子云好事，常怀铅提椠，从诸计吏访殊方绝域四方之语。","book":"晋·葛洪《西京杂记》卷三"},"example":{"text":"余之无力，殆与东里少时伯促，犹冀以暇日～，拣卷小书短者抄之。","book":"清·黄宗羲《天一阁藏书记》"}},{"id":22309,"word":"握粟出卜","pinyin":"wò sù chū bo","abbr":"wscb","explanation":"后用以指祈求神明护佑，去凶赐吉。","source":{"text":"但持粟行卜，求其胜负。","book":"《诗·小雅·小宛》：“握粟出卜，是何能谷。”郑玄笺"},"example":{"text":"三国·吴·谢承《后汉书》：“昱惨戚消瘠，至目不交睫，～，祈祷泣血，乡党称其孝。”"},"usage":"作谓语、宾语；用于书面语","story":["三国时期，魏国广陵太守琅邪人赵昱，是一个有名的忠孝人士。他13岁时，母亲生病有三个月，他目不交睫地侍候在左右，经常握粟出卜祈求神明保佑他母亲，有时磕头都流出血来，明显消瘦了许多，乡亲们称赞他是个孝子"]},{"id":22310,"word":"握素怀铅","pinyin":"wò sù huái qiān","abbr":"wshq","explanation":"犹言握铅抱椠。指勤于写作、校勘。","source":{"text":"握素怀铅，重席解颐之士，间出于朝廷。","book":"《北史·儒林传序》"},"similar":["握铅抱椠","握素披黄"],"usage":"作谓语、定语；指写作"},{"id":22311,"word":"握素披黄","pinyin":"wò sù pī huáng","abbr":"wsph","explanation":"犹言握铅抱椠。素，白绢，古代用以书写。黄，雌黄，古代用以校点书籍。","source":{"text":"握素披黄，吟道咏德，苦辛无益者如日蚀，逸乐名利者如秋荼。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["握素怀铅"],"usage":"作谓语、定语；指写作"},{"id":22312,"word":"握纲提领","pinyin":"wò gāng tí lǐng","abbr":"wgtl","explanation":"握：拿、抓。比喻抓住要领或简明扼要地把内容提示出来。","source":{"text":"悠悠群吏，非子不整；嗷嗷众议，非子不靖。忽荷略纽，握纲提领；矫矫贞臣，惟国之屏。","book":"晋·潘尼《答傅咸》诗"},"similar":["提纲挈领"],"usage":"作宾语、定语；用于书面语"},{"id":22313,"word":"握蛇骑虎","pinyin":"wò shé qí hǔ","abbr":"wsqh","explanation":"比喻处境极险恶。","source":{"text":"兄识高年长，故知有夷险；彦和握蛇骑虎，不觉艰难。","book":"《魏书·彭城王传》"},"example":{"text":"记得太行山百万，曾入宗爷驾驭。今把作～。","book":"宋·刘克庄《贺新郎·送陈真州子华》"},"similar":["势如骑虎"],"usage":"作谓语、定语；指处境危险","story":["北魏时期，魏高祖死于行宫，彭城王元勰等为防不测，密不发丧，下诏徵世宗会驾。灵柩行至鲁阳，才发丧。当时咸阳王元禧怀疑元勰有阴谋说“你这样做很危险。”元勰怀恨在心说“兄识高年长，故知有夷险；彦和握蛇骑虎，不觉艰难。”"]},{"id":22314,"word":"握钩伸铁","pinyin":"wò gōu shēn tiě","abbr":"wgst","explanation":"把钩伸直，把铁成索。形容力量极大。","source":{"text":"把钩伸直，把铁成索。形容力量极大。"},"similar":["伸钩索铁"],"usage":"作谓语、定语；指力大"},{"id":22315,"word":"握铅抱椠","pinyin":"wò qiān bào qiàn","abbr":"wqbq","explanation":"铅，铅粉；椠，木简。皆书写用具。后遂以之为勤于写作、校勘的典故。","source":{"text":"扬子云好事，常怀铅提椠，从诸计吏，访殊方绝域四方之语。","book":"语出《西京杂记》卷三"},"example":{"text":"同治初元……勘定苏州，复次第削平常、镇、湖、嘉诸郡县，千里敉安，～之士散之四方者，至是咸归里。","book":"清·冯桂芬《苏州试院记》"},"similar":["握椠怀铅"],"usage":"作谓语、定语；指写作"},{"id":22316,"word":"握雨携云","pinyin":"wò yǔ xié yún","abbr":"wyxy","explanation":"指男女欢合。","source":{"text":"昔者先王尝游高唐，怠而昼寝，梦见一妇人，曰：‘妾巫山之女也，为高唐之客。闻君游高唐，原荐枕席。’王因幸之。去而辞曰：‘妾在巫山之阳，高丘之阻，旦为朝云，暮为行雨，朝朝暮暮，阳台之下。’","book":"战国楚宋玉《高唐赋》"},"example":{"text":"明·冯梦龙《醒世恒言》第16卷：“伎俩熟，口舌利，～多巧计。”"},"similar":["握云携雨"],"usage":"作谓语、定语；用于书面语"},{"id":22317,"word":"握雾拏云","pinyin":"wò wù ná yún","abbr":"wwny","explanation":"驾驭云雾。意谓善于掌握戎机。","source":{"text":"这其间多亏了张子房说地谈天口，韩元帅握雾拏云手。","book":"元·无名氏《连环记》第一折"}},{"id":22318,"word":"握雾拿云","pinyin":"wò wù ná yún","abbr":"wwny","explanation":"形容本领极大。","source":{"text":"这其间多亏了张子房说他说地谈天口，韩元帅握雾拿云手。","book":"元·无名氏《连环记》第一折"},"example":{"text":"明·无名氏《暗度陈仓》第三折：“轻舒～手，稳取山河是太平。”"},"similar":["握云拿雾"],"usage":"作谓语、定语；用于书面语"},{"id":22319,"word":"握风捕影","pinyin":"wò fēng bǔ yǐng","abbr":"wfby","explanation":"犹言捕风捉影。比喻说话做事丝毫没有事实根据。","source":{"text":"今谨录一百五十篇，编为一轴，封留献上，握风捕影，铸木镂冰，敢求恩知，但希镌琢。","book":"唐·杜牧《献诗启》"},"example":{"text":"唐·杜牧《献诗启》：“～，铸木镂冰，敢求恩和，但希镌琢。”"},"usage":"作宾语、定语；多用于比喻句"},{"id":22320,"word":"揣合逢迎","pinyin":"chuǎi hé féng yíng","abbr":"chfy","explanation":"揣：揣测，揣摩。现指揣摩、迎合权贵的心意，以谋求私利。","source":{"text":"就是那贫贱儒生，又不过做的是些揣合逢迎的考校。","book":"清·吴敬梓《儒林外史》第55回"},"example":{"text":"他很会～的手段。"},"similar":["阿谀逢迎"],"usage":"作谓语、宾语、定语、补语；指讨好别人"},{"id":22321,"word":"揣奸把猾","pinyin":"chuāi jiān bǎ huá","abbr":"cjbh","explanation":"揣：藏。奸：奸诈，狡诈，虚伪。心藏奸诈，行为狡猾。","source":{"text":"因某生前揣奸把猾，死后永做饿鬼。","book":"元·无名氏《十样锦》第二折"},"usage":"作谓语、定语；指人很狡猾"},{"id":22322,"word":"揣时度力","pinyin":"chuǎi shí duó lì","abbr":"csdl","explanation":"揣度形势，估量自己的能力。","source":{"text":"不肖揣时度力，屡欲乞归。","book":"明·张居正《答上师相徐存斋书》"},"example":{"text":"他～，决定参加这次比赛。"},"similar":["审时度势"],"usage":"作谓语、宾语；指正确估量自己"},{"id":22323,"word":"揣歪捏怪","pinyin":"chuāi wāi niē guài","abbr":"cwng","explanation":"藏着歪心，搞着怪事。","source":{"text":"俺两个全仗俺父亲的虎威，拿粗挟细，揣歪捏怪，帮闲钻懒，放刁撒泼。","book":"元·无名氏《陈州粜米》楔子"},"example":{"text":"自小里偷东摸西，～，胡行乱走，不老实。","book":"明·无名氏《拨宅飞升》楔子"},"usage":"作谓语、宾语；用于生事"},{"id":22324,"word":"揣骨听声","pinyin":"chuāi gǔ tīng shēng","abbr":"cgts","explanation":"原指旧时相法的一种。不相其面，而摸其骨骼，听其语声，以判贵贱。后用以比喻牵强附会，妄加评判。","source":{"text":"又有观画而以手摸之，相传以谓色不隐指者为佳画。此又耳鉴之下，谓之揣骨听声。","book":"宋·彭乘《墨客挥犀》卷一"},"example":{"text":"因吾书而考见今韵之由来，不至～，自生妄见。","book":"清·纪昀《后序》"},"usage":"作谓语、宾语、定语；用于评论等"},{"id":22325,"word":"揪心扒肝","pinyin":"jiū xīn bā gān","abbr":"jxbg","explanation":"指人极度焦虑，异常担忧。","example":{"text":"遇到～的事情也不要乱了方寸。"},"similar":["提心吊胆"],"usage":"作谓语、定语；用于处事"},{"id":22326,"word":"揪辫子","pinyin":"jiū biàn zǐ","abbr":"jbz","explanation":"抓辫子。比喻抓住对方的短处、缺点作为把柄。","source":{"text":"不管大家说什么，再不堪入耳，再反动再下流，一不打棍子二不揪辫子三不记黑帐。","book":"王朔《谁比谁傻多少》"},"example":{"text":"我们不～，不打棍子。"},"similar":["抓辫子"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":22327,"word":"揭不开锅","pinyin":"jiē bù kāi guō","abbr":"jbkg","explanation":"指没有粮食或没有伙食钱。","source":{"text":"大部分村子都有许多缺粮户，有的只能维持一两个月，有的当下就揭不开锅了。","book":"路遥《平凡的世界》第一卷第46章"},"example":{"text":"他们家已经～了。"},"usage":"作谓语、定语；指十分贫穷"},{"id":22328,"word":"揭人之短","pinyin":"jiē rén zhī duǎn","abbr":"jrzd","explanation":"将别人的短处揭露出来，公之于众。","example":{"text":"请不要～，让人难堪。"},"usage":"作谓语、宾语、定语；用于为人"},{"id":22329,"word":"揭债还债","pinyin":"jiē zhài huán zhài","abbr":"jzhz　","explanation":"揭债：借债。用借债的办法还债，亏空始终存在。","source":{"text":"若再揭起来，每日出利息来，将来搭了市房，还怕不够哩！那才是揭债还债，窟窿常在。","book":"清·李绿园《歧路灯》第三十回"},"usage":"作宾语、定语；用于亏空时"},{"id":22330,"word":"揭地掀天","pinyin":"jiē dì xiān tiān","abbr":"jdxt","explanation":"指翻天覆地。","source":{"text":"公乃以一身支柱其间，扶危定倾，使揭地掀天之日，为苞桑磐石之安。","book":"清·蒋涟《序》"},"example":{"text":"安良除暴已足贵，～应有心。","book":"张西曼《辛亥招募革命骑兵记》"},"similar":["翻天覆地"],"usage":"作定语；形容变化大"},{"id":22331,"word":"揭揭巍巍","pinyin":"jiē jiē wēi wēi","abbr":"jjww","explanation":"形容十分高大。","source":{"text":"服觉皓以殊俗兮，貌揭揭以巍巍。","book":"汉·刘向《九叹·远游》"}},{"id":22332,"word":"揭竿四起","pinyin":"jiē gān sì qǐ","abbr":"jgsq","explanation":"揭：高举；竿：竹竿，代旗帜。砍了树干当武器，举起竹竿当旗帜，进行反抗。指人民起义。","source":{"text":"率罢弊之卒，将数百之众，转而攻秦，斩木为兵，揭竿为旗。","book":"汉·贾谊《过秦论》"},"example":{"text":"然历代君人者，必以省刑罚，薄税敛为戒，其民始相安无事，否则～矣。","book":"李大钊《国情》"},"similar":["揭竿而起"],"usage":"作谓语、定语；指造反"},{"id":22333,"word":"揭竿而起","pinyin":"jiē gān ér qǐ","abbr":"jgeq","explanation":"揭：高举；竿：竹竿，代旗帜。砍了树干当武器，举起竹竿当旗帜，进行反抗。指人民起义。","source":{"text":"斩木为兵，揭竿为旗。","book":"汉·贾谊《过秦论》"},"example":{"text":"一时各路人马，～，不分昼夜，兼水路纷纷入鄂。","book":"白先勇《梁父吟》"},"similar":["逼上梁山"],"opposite":["忍辱偷生"],"usage":"作谓语、定语；指造反","story":["公元前209年，阳城地方官派官差押送900多名壮丁去渔阳守边，官差选陈胜、吴广管理壮丁，走到大泽乡遇到大雨，不能按期到达，按秦律规定这些人得全部处死，陈胜、吴广迫不得已，只好举起竹杆当义旗，进行起义"]},{"id":22334,"word":"揭箧担囊","pinyin":"jiē qiè dān náng","abbr":"jqdn","explanation":"盗窃箱笼等财物。","source":{"text":"然而巨盗至，则负匮揭箧担囊而趋。","book":"战国·宋·庄周《庄子·胠箧》"},"similar":["揭箧探囊"],"usage":"作定语、状语；用于书面语"},{"id":22335,"word":"揭箧探囊","pinyin":"jiē qiè tàn náng","abbr":"jqtn","explanation":"盗窃箱笼等财物。同“揭箧担囊”。","source":{"text":"然而巨盗至，则负匮揭箧提囊而趣。","book":"《庄子·胠箧》"},"similar":["揭箧担囊"],"usage":"作定语、状语；用于书面语"},{"id":22336,"word":"援之以手","pinyin":"yuán zhī yǐ shǒu","abbr":"yzys","explanation":"对他人进行救助","source":{"text":"天下溺，援之以道；嫂溺，援之以手。","book":"战国·邹·孟轲《孟子·离娄上》"},"usage":"作谓语、定语；用于处事"},{"id":22337,"word":"援古刺今","pinyin":"yuán gǔ cì jīn","abbr":"ygcj","explanation":"引述故事古义以讽刺今事。","source":{"text":"述怀咏史，不过词人之习态，不可以为援古刺今。","book":"明·杨慎《升庵诗话》卷六：“援古刺今，箴戒得失，谓之箴。”《天讨·豕韦之裔〈普告汉人〉》"},"similar":["援古证今"],"usage":"作谓语、定语、宾语；用于说话等"},{"id":22338,"word":"援古证今","pinyin":"yá gǔ zhèng jīn","abbr":"ygzj","explanation":"援：引。引述古事来证明今事。","source":{"text":"事类者，盖文章之外，据事以类义，援古以证今者也。","book":"南朝·梁·刘勰《文心雕龙·事类》"},"example":{"text":"～，极力为之。","book":"清·黄宗羲《柳敬亭传》"},"similar":["借古讽今","古为今用","借古喻今"],"usage":"作谓语、定语、宾语；指引述古事来证明今事"},{"id":22339,"word":"援引荐举","pinyin":"yuán yǐn jiàn jǔ","abbr":"yyjj","explanation":"荐：推荐。引进和推荐人材","source":{"text":"文章滂沛，不遭有力之将援引荐举，亦将弃遗于衡门之下。","book":"汉·王充《论衡·效力》"},"usage":"作谓语、定语；用于书面语"},{"id":22340,"word":"援溺振渴","pinyin":"yuán nì zhèn kě","abbr":"ynzk","explanation":"溺：指落水者；振：救济。援救落水者和干渴者。比喻援救受难的人。","source":{"text":"曾未期月，援溺振渴，事无巨细，悉究本末。","book":"宋·邵博《闻见后录》卷十五"},"similar":["济困扶危"],"usage":"作谓语、定语；用于处事"},{"id":22341,"word":"援疑质理","pinyin":"yuán yí zhì lǐ","abbr":"yyzl","explanation":"援：引、提出；质：询问。提出疑难，询问道理。","source":{"text":"援疑质理，俯身倾耳请。","book":"明·宋濂《送东阳马生序》"},"usage":"作谓语、宾语；用于处事"},{"id":22342,"word":"援笔成章","pinyin":"yuán bǐ chéng zhāng","abbr":"ybcz","explanation":"援笔：拿起笔来。拿起笔来就写文章。形容文思敏捷。","source":{"text":"生素多才思，援笔成章。","book":"唐·蒋防《霍小玉传》"},"similar":["下笔成章"],"usage":"作谓语、定语；指人文思敏捷"},{"id":22343,"word":"援笔立就","pinyin":"yuán bǐ lì jiù","abbr":"yblj","explanation":"援笔：拿笔。拿起笔立刻写成。形容才思敏捷。同“援笔立成”。","source":{"text":"每公卿会议，事关典故，邵援笔立就，证引该洽。","book":"《北史·刑峦传》"},"example":{"text":"以诗志别，分韵得‘秋’字，～，一气浑成。","book":"明·谢榛《四溟诗话》卷四"},"similar":["援笔立成"],"usage":"作谓语、定语、状语；用于写作"},{"id":22344,"word":"援笔立成","pinyin":"yuán bǐ lì chéng","abbr":"yblc","explanation":"援笔：拿笔。拿起笔立刻写成。形容才思敏捷。亦作“援笔成章”、“援笔而就”。","source":{"text":"思道援笔立成，文无加点，神举嘉而宥之。","book":"《三国志·魏志·陈思王植传》：“时邺铜爵台新成，太祖悉将诸子登台，使各为赋。植援笔立成，可观，太祖甚异之。”《隋书·卢思道传》"},"example":{"text":"李太白一斗百篇，～；杜子美改罢长吟，一字不苟。","book":"宋·罗大经《鹤林玉露》卷十六"},"similar":["援笔成章","援笔立就"],"usage":"作谓语、定语；用于写作等"},{"id":22345,"word":"援笔而就","pinyin":"yuán bǐ ér jiù","abbr":"ybej","explanation":"援笔：拿笔。拿起笔立刻写成。形容才思敏捷。同“援笔立成”。","source":{"text":"时议草赦令，咸推承庆，召使为之，无桡色误辞，援笔而就，众叹其壮。","book":"《新唐书·韦思谦传》"},"example":{"text":"我想求诗求字的，还容易打发，唯有索画一事，最难应酬。须要逐笔图写出来，不是可以倚马而成，～的。","book":"清·李渔《意中缘·名逋》"},"similar":["援笔立成","倚马可待"],"usage":"作谓语、定语；用于写作等"},{"id":22346,"word":"援经据典","pinyin":"yuán jīng jù diǎn","abbr":"yjjd","explanation":"援：援引；据：依据。引用经典书籍作为论证的依据。","source":{"text":"时人多不行妻服，虽在亲忧犹有吊问丧疾者，又私谥其君父及诸名士，爽皆引据大义，正之经典，虽不悉变，亦颇有改。","book":"《后汉书·荀爽传》"},"example":{"text":"或～，或取怀而予，或如分相偿，未尝不自信曰：“此真颠扑不破矣。”","book":"清·蒲松龄《聊斋志异·郭安》但明伦评"}},{"id":22347,"word":"援鳖失龟","pinyin":"yuán biē shī guī","abbr":"ybsg","explanation":"比喻得不偿失。","source":{"text":"杀戎马而求狐狸，援两鳖而失灵龟，断右臂而争一毛，折莫邪而争锥刀，用智如此，岂足高乎？","book":"《淮南子·说山训》"},"similar":["因小失大"],"usage":"作宾语、定语；指因小失大"},{"id":22348,"word":"揽名责实","pinyin":"lǎn míng zé shí","abbr":"lmzs","explanation":"指观其名而考其实绩。","source":{"text":"有益者谓之公，无益者谓之烦，揽名责实，不得虚言。","book":"汉·董仲舒《春秋繁露·考功名》"},"similar":["循名责实"],"usage":"作谓语；同“循名责实”"},{"id":22349,"word":"揽权怙势","pinyin":"lǎn quán hù shì","abbr":"lqhs","explanation":"揽：把持；怙：凭借。指总揽大权，倚仗权势。","example":{"text":"那张汤却揽权怙势，大有顺我便生，逆我就死的气势。","book":"蔡东藩《前汉演义》第七十一回"}},{"id":22350,"word":"揽权纳贿","pinyin":"lǎn quán nà huì","abbr":"lqnh","explanation":"揽：把持。纳：接纳。把持权势，并接受贿赂。","source":{"text":"到了湖北，方才晓得李统领因为京里有人参他揽权纳贿等事。","book":"清·无名氏《官场维新记》第六回"},"example":{"text":"他最喜欢～。"},"usage":"作谓语、宾语；指受贿"},{"id":22351,"word":"揽辔中原","pinyin":"lǎn pèi zhōng yuán","abbr":"lpzy","explanation":"表示刷新政治，澄清天下的抱负。也比喻人在负责一件工作之始，即立志要刷新这件工作，把它做好。同“揽辔澄清”。","source":{"text":"劫余仍遣同舟济，揽辔中原共死生。","book":"柳亚子《流亡杂诗》"},"similar":["揽辔登车","揽辔澄清"],"usage":"作谓语、定语；指人的抱负"},{"id":22352,"word":"揽辔澄清","pinyin":"lǎn pèi chéng qīng","abbr":"lpcq","explanation":"揽辔：拉住马缰；澄清：平治天下。表示刷新政治，澄清天下的抱负。也比喻人在负责一件工作之始，即立志要刷新这件工作，把它做好。","source":{"text":"滂登车揽辔，慨然有澄清天下之志。","book":"《后汉书·范滂传》"},"example":{"text":"少年～意，倦矣应怜缩手时。","book":"清·龚自珍《己亥杂诗》"},"similar":["揽辔登车","揽辔中原"],"usage":"作谓语；指人的抱负","story":["东汉时期，冀州发生饥荒，那些贪官污吏们照样过着糜烂的奢侈生活，对灾民不闻不问，饥民们纷纷起来造反。朝廷派范滂为清诏使前去考察情况。他接到命令感到责任重大，临行时他在马上手执缰绳对随从说：“一定要查明真相，澄清天下。”"]},{"id":22353,"word":"揽辔登车","pinyin":"lǎn pèi dēng chē","abbr":"lpdc","explanation":"揽辔：掌握马缰绳。指巡行各地监察吏治。","source":{"text":"先自京师，而访豺狼，然后揽辔登车，以清天下。","book":"唐·陈子昂《上军国利害事三条·出使》"},"example":{"text":"丈夫入世贵倜傥，～气何爽！","book":"清·毛奇龄《送吴明府超迁观察之闽》诗"},"similar":["揽辔澄清","揽辔中原"],"usage":"作谓语；指巡行各地监察吏治"},{"id":22354,"word":"搀前落后","pinyin":"chān qián luò hòu","abbr":"cqlh","explanation":"抢前落后，不整肃。","source":{"text":"贾政便也生气，说：‘往常还好，怎么今日不齐集至此？’抬头看那执事，却是搀前落后。","book":"《红楼梦》第九九回"},"similar":["参差不齐"],"usage":"作谓语、宾语；指不整齐"},{"id":22355,"word":"搀行夺市","pinyin":"chān háng duó shì","abbr":"chds","explanation":"跨行业抢生意。比喻越权夺职。","source":{"text":"这先锋合当我做，你怎么来搀行夺市的。","book":"明·无名氏《大战邳彤》第一折"},"similar":["欺行霸市"],"usage":"作谓语、定语、宾语；指抢夺别人的生意"},{"id":22356,"word":"搅海翻天","pinyin":"jiǎo hǎi fān tiān","abbr":"jhft","explanation":"搅：搅拌；翻：反转。比喻力量声势极其壮大。","source":{"text":"两人搅海翻天，只是打得高兴，周智在旁只叫‘利害！’","book":"明·伏雌教主《醋葫芦》第九回"},"similar":["搅海翻江"],"usage":"作谓语、定语；指声势大"},{"id":22357,"word":"搅海翻江","pinyin":"jiǎo hǎi fān jiāng","abbr":"jhfj","explanation":"搅：搅拌；翻：翻腾。江海翻腾。比喻声势或力量很大。","source":{"text":"他那里撼岭巴山，搅海翻江，倒树摧崖。","book":"元·马致远《荐福碑》第三折"},"example":{"text":"直杀得播土扬尘日光寒，～云变色。","book":"清·钱彩《说岳全传》第七十七回"},"similar":["排山倒海","搅海翻天"],"usage":"作谓语、定语；指声势大"},{"id":22358,"word":"搏手无策","pinyin":"bó shǒu wú cè","abbr":"bswc","explanation":"搓着双手，毫无办法。","source":{"text":"温州民谢生母，老病不肯服药，以夏月思生柑，不啻饥渴，谢生搏手无策。","book":"宋·洪迈《夷坚丁志·谢生灵柑》"},"similar":["束手无策"],"opposite":["足智多谋"],"usage":"作谓语、定语；形容无计可施"},{"id":22359,"word":"搏牛之虻","pinyin":"bó niú zhī méng","abbr":"bnzm","explanation":"原意是说主要目标应像击杀牛背上的虻虫一样去灭掉秦国，而不是像消除虮虱那样去与别人打败。后来比喻其志在大而不在小。","source":{"text":"夫搏牛之（虻），不可以破虮虱。","book":"《史记·项羽本纪》"},"usage":"作宾语、定语；用于处事"},{"id":22360,"word":"搏砂弄汞","pinyin":"bó shā nòng gǒng","abbr":"bsng","explanation":"搏：拨弄；弄：设法取得；汞：水银。拨弄砂子，收拾水银。比喻难以收拾。","source":{"text":"搏：拨弄；弄：设法取得；汞：水银。拨弄砂子，收拾水银。比喻难以收拾。"},"usage":"作宾语、定语；指难以收拾的事"},{"id":22361,"word":"搓手跺脚","pinyin":"cuō shǒu duò jiǎo","abbr":"csdj","explanation":"搓：手相摩。形容焦急不耐烦的样子。","source":{"text":"自己又不会水，急得他在亭子上搓手跺脚，无法可施。","book":"清·石玉昆《三侠五义》第28回"},"similar":["搓手顿脚"],"usage":"作谓语、定语；形容焦急的样子"},{"id":22362,"word":"搓手顿脚","pinyin":"cuō shǒu dùn jiǎo","abbr":"csdj","explanation":"形容焦急不耐烦的样子。","source":{"text":"闷坐在客厅里毫无聊赖，气闷得很，曹来苏只是搓手顿脚，没有法子。","book":"清·吴趼人《糊涂世界》第五回"},"example":{"text":"县太爷急的～，叫了签稿，请了刑名师爷，大家斟酌，想不出一个法子。","book":"清·李宝嘉《文明小史》第三十四回"},"similar":["搓手顿足"],"usage":"作谓语、定语；形容焦急的样子"},{"id":22363,"word":"搓手顿足","pinyin":"cuō shǒu dùn zú","abbr":"csdz","explanation":"形容焦急不安的样子。","source":{"text":"‘你要把老爷的大事误了那可怎么好！’说着急得搓手顿足。","book":"清·文康《儿女英雄传》第14回"},"example":{"text":"辅成～了半晌，没个理会。","book":"清·吴趼人《二十年目睹之怪现状》第70回"},"similar":["急不可待"],"opposite":["慢条斯理"],"usage":"作谓语、定语、状语；形容焦急的样子"},{"id":22364,"word":"搓粉团朱","pinyin":"cuō fěn tuán zhū","abbr":"cftz","explanation":"搓：手相摩；团：以手团弄；朱：朱红。隐喻男女欢爱。","source":{"text":"窃玉偷香，裁冰剪雪，搓粉团朱。","book":"明·朱权《卓文君》第二折"},"similar":["搓粉抟朱"],"usage":"作谓语、宾语；用于男女之间"},{"id":22365,"word":"搓粉抟朱","pinyin":"cuō fěn tuán zhū","abbr":"cftz","explanation":"粉、朱：女子化妆用的粉和胭脂；抟：以手团弄。隐喻男女欢爱。","source":{"text":"污平生冰雪玉洁，尽今霄搓粉抟朱，恐明朝怨紫啼红。","book":"元·无名氏《女真观》第二折"},"similar":["搓粉团朱"],"usage":"作谓语、宾语；用于男女之间"},{"id":22366,"word":"搓绵扯絮","pinyin":"cuō mián chě xù","abbr":"cmcx","explanation":"绵：丝绵；絮：粗丝绵或弹过的棉花。形容雪下得很大，就好像搓弄丝绵，撕扯绵絮一样。","source":{"text":"从玻璃窗内往外一看，原来不是日光，竟是一夜的雪，下得将有一尺厚，天上仍是搓绵扯絮一般。","book":"清·曹雪芹《红楼梦》第四十九回"},"usage":"作宾语、定语；用于比喻句"},{"id":22367,"word":"搔到痒处","pinyin":"sāo dào yǎng chù","abbr":"sdyc","explanation":"比喻说话说到点子上。","source":{"text":"杜诗韩集愁来读，似倩麻姑痒处抓。","book":"唐·杜牧《读韩杜集》诗"},"similar":["搔着痒处"],"opposite":["不痛不痒"],"usage":"作谓语、定语；比喻话说到点子上"},{"id":22368,"word":"搔头弄姿","pinyin":"sāo tóu nòng zī","abbr":"stnz","explanation":"原指梳妆打扮。后形容女子卖弄姿色（含贬义）。","source":{"text":"固独粉饰貌，搔头弄姿。","book":"《后汉书·李固传》"},"example":{"text":"我爱他们那既不招蜂引蝶，又不～的朴素本色。","book":"峻青《傲霜篇》"},"similar":["装腔作势","卖弄风骚","搔首弄姿"],"opposite":["落落大方","神态自若"],"usage":"作谓语、定语；用于女性"},{"id":22369,"word":"搔头抓耳","pinyin":"sāo tóu zhuā ěr","abbr":"stze","explanation":"抓抓头皮，摸摸耳朵。形容焦急的神态。","source":{"text":"两个搔头摸耳，没有法想。","book":"清·彭养鸥《黑籍冤魂》第12回"},"example":{"text":"王柏臣那面也晓得了，急得～，坐立不安。","book":"清·李宝嘉《官场现形记》第41回"},"similar":["抓耳挠腮","搔头摸耳"],"opposite":["静若处子"],"usage":"作谓语、宾语、状语；指焦急的神态"},{"id":22370,"word":"搔头摸耳","pinyin":"sāo tóu mō ěr","abbr":"stme","explanation":"抓抓头皮，摸摸耳朵。形容一时无法可想的焦急神态。","source":{"text":"两个人搔头摸耳，没有法想。","book":"清·彭养鸥《黑籍冤魂》第十三回"},"similar":["搔头抓耳"],"usage":"作谓语、状语；形容焦急"},{"id":22371,"word":"搔着痒处","pinyin":"sāo zhe yǎng chù","abbr":"szyc","explanation":"比喻正合心意，痛快之至。","source":{"text":"杜诗韩集愁来读，似倩麻姑痒处抓。","book":"唐·杜牧《读韩杜集》诗"},"example":{"text":"我是常不免于弄弄笔墨的，写了下来，印了出去，对于有些人似乎总是～的时候少。","book":"鲁迅《朝花夕拾·》"},"similar":["搔到痒处"],"usage":"作谓语、定语；比喻话说到点子上"},{"id":22372,"word":"搔耳捶胸","pinyin":"sāo ěr chuí xiōng","abbr":"secx","explanation":"搔耳朵，捶胸膛。形容后悔、烦恼的样子。","source":{"text":"心下十分悲咽，便搔耳捶胸，焦躁起来。","book":"《西湖佳话·三生石迹》"},"example":{"text":"他～，十分懊恼。"},"usage":"作谓语、定语；指烦恼的样子"},{"id":22373,"word":"搔首不知痒处","pinyin":"sāo shǒu bù zhī yǎng chù","abbr":"ssbzyc","explanation":"形容仓皇失措的样子。","source":{"text":"宋江听罢，搔首不知痒处，只叫得苦。","book":"明·施耐庵《水浒全传》第三十八回"}},{"id":22374,"word":"搔首弄姿","pinyin":"sāo shǒu nòng zī","abbr":"ssnz","explanation":"搔：用手指梳。形容装腔作势卖弄风情。","source":{"text":"大行在殡，路人掩涕。固独胡粉饰貌，搔头弄姿，槃旋偃仰，从容冶步，曾无惨怛之心。","book":"南朝·宋·范晔《后汉书·李固传》"},"example":{"text":"又开始～，掸掸衣服。","book":"曹禺《日出》第三幕"},"similar":["装腔作势","卖弄风骚","搔头弄姿"],"opposite":["落落大方","神态自若"],"usage":"作谓语、定语；指卖弄风情"},{"id":22375,"word":"搔首踟蹰","pinyin":"sāo shǒu chí chú","abbr":"sscc","explanation":"形容心情焦急，惶惑或犹豫。","source":{"text":"爱而不见，搔首踟蹰。","book":"《诗经·邶风·静女》"},"example":{"text":"他～的样子就证明了这点。"},"usage":"作谓语、定语；指焦急的样子"},{"id":22376,"word":"搜奇抉怪","pinyin":"sōu qí jué guài","abbr":"sqjg","explanation":"抉：挑选。搜寻新奇，挑选怪异。形容写作诗文刻意雕琢。","source":{"text":"志存乎《诗》、《书》，寓辞乎咏歌，往复循环，有唱斯和，搜奇抉怪，雕镂文字，与韦布里闾憔悴专一之士较其毫厘分寸。","book":"唐·韩愈《荆潭唱和诗序》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":22377,"word":"搜奇检怪","pinyin":"sōu qí jiǎn guài","abbr":"sqjg","explanation":"搜寻新奇，挑选怪异。形容写作诗文刻意雕琢。","source":{"text":"志存乎《诗》、《书》，寓辞乎咏歌，往复循环，有唱斯和，搜奇抉怪，雕镂文字，与韦布里闾憔悴专一之士较其毫厘分寸。","book":"唐·韩愈《荆潭唱和诗序》"},"example":{"text":"若只管丢了真情真事，且去～，一则失了咱们的闺阁面目，二则也与题目无涉了。","book":"清·曹雪芹《红楼梦》第七十六回"}},{"id":22378,"word":"搜奇索古","pinyin":"sōu qí suǒ gǔ","abbr":"sqsg","explanation":"搜：搜集；奇：奇异；索：搜寻。搜集奇异的，寻找三教的。","source":{"text":"惟务搜奇索古而已。","book":"元·钟嗣成《录鬼簿》卷下"}},{"id":22379,"word":"搜奇访古","pinyin":"sōu qí fǎng gǔ","abbr":"sqfg","explanation":"搜寻奇山异水，访问名胜古迹。","source":{"text":"喜游佳山水，搜奇访古，穷幽探绝，终日忘归。","book":"宋·赵佶《宣和画谱·山水二·高克明》"},"usage":"作谓语、定语、宾语；用于生活"},{"id":22380,"word":"搜奇选妙","pinyin":"sōu qí xuǎn miào","abbr":"sqxm","explanation":"搜：搜罗；奇：奇妙；选：挑选。指搜罗和挑选最奇妙的东西。","source":{"text":"若乃搜奇选妙，绝色寡双，鹄质曒鲜，玄的点锋，修短虽异，而光彩齐同。","book":"晋·张载《羽扇赋》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":22381,"word":"搜岩采干","pinyin":"sōu yán cǎi gàn","abbr":"sycg","explanation":"比喻想方设法罗致闲散的人才。","source":{"text":"剖蚌求珠，搜岩采干，野无投纶，朝盈逸翰。","book":"《魏书·段承根传》"},"usage":"作谓语、定语；比喻想方设法罗致闲散的人才"},{"id":22382,"word":"搜扬仄陋","pinyin":"sōu yáng zè lòu","abbr":"syzl","explanation":"搜：搜寻；扬：荐举，选拔；仄陋：隐伏，卑微，引申指地位低微。寻找和荐举地位低微的贤能之士。","source":{"text":"明明扬侧陋。”《后汉书·窦融传》“夫二三子得之不过房幄之闲，非复搜扬仄陋，选举而登也。","book":"《尚书·尧典》"},"example":{"text":"先王身下白屋，～，使山无扶苏之才，野无《伐檀》之咏。","book":"《晋书·纪瞻传》"},"similar":["搜扬侧陋"],"usage":"作谓语、宾语；用于书面语"},{"id":22383,"word":"搜扬侧陋","pinyin":"sōu yáng cè lòu","abbr":"sycl","explanation":"搜：搜寻；扬：荐举，选拔；侧陋：隐伏，卑微，引申指地位低微。寻找和荐举地位低微的贤能之士。","source":{"text":"明明扬侧陋。","book":"《尚书·尧典》"},"example":{"text":"思良股肱，嘉昔伊吕，～，举汤代禹。","book":"三国·魏·曹植《文帝诔》"},"similar":["搜扬仄陋"],"usage":"作谓语、宾语；用于书面语"},{"id":22384,"word":"搜根剔齿","pinyin":"sōu gēn tī chǐ","abbr":"sgtc","explanation":"指寻根究底，连细微处也不放过。","source":{"text":"只恨黄文炳那厮搜根剔齿，几番唆毒，要害我们。","book":"明·施耐庵《水浒传》第41回"},"similar":["寻根究底"],"usage":"作谓语、定语；指寻根究底"},{"id":22385,"word":"搜根问底","pinyin":"sōu gēn wèn dǐ","abbr":"sgwd","explanation":"指追问原因、结果。","source":{"text":"彩云的大姐，正要问那位叫的，只说得半句，被彩云啐了一口道：‘蠢货，谁要你扫根问底。’","book":"清·曾朴《孽海花》第八回"},"similar":["刨根问底"],"usage":"作谓语、定语；比喻追究底细"},{"id":22386,"word":"搜神夺巧","pinyin":"sōu shén duó qiǎo","abbr":"ssdq","explanation":"搜：搜索；神：神奇。多指园林景致非常精妙。","source":{"text":"有趣，有趣，真搜神夺巧之至。","book":"清·曹雪芹《红楼梦》第十七回"}},{"id":22387,"word":"搜章摘句","pinyin":"sōu zhāng zhāi jù","abbr":"szzj","explanation":"搜：寻求；摘：选取。指抄袭他人文章的词句。","source":{"text":"虽有余闲，博览书传历史，藉采奇异，不效诸生寻章摘句而已。","book":"《三国志·吴书·孙权传》：“遣都尉赵咨使魏。”裴松之注引《吴书》"},"example":{"text":"举明经，其友易之，秀实曰：“～，不足以立功。”乃弃去。","book":"《新唐书·段秀实传》"},"similar":["寻章摘句"],"usage":"作谓语、定语；指抄袭他人文章的词句"},{"id":22388,"word":"搜章擿句","pinyin":"sōu zhāng tī jù","abbr":"sztj","explanation":"搜：搜索；章：章节；擿：指使；句：句子。搜集文章，摘取章句。","source":{"text":"举明经，其友易之，秀实曰：‘搜章擿句，不足以立功。’乃弃去。","book":"《新唐书·段秀实传》"},"usage":"作谓语、宾语；用于写作等"},{"id":22389,"word":"搜索枯肠","pinyin":"sōu suǒ kū cháng","abbr":"sskc","explanation":"搜索：搜查；枯肠：比喻才思苦窘。形容写作时苦思苦想。","source":{"text":"三椀搜枯肠，唯有文字五千卷。","book":"唐·卢仝《走笔谢孟谏议寄新茶》诗"},"example":{"text":"今日宝云姐姐务要想个好顽的，若再教我～，那真坑死人了。","book":"清·李汝珍《镜花缘》第六十九回"},"similar":["挖空心思","搜肠刮肚","绞尽脑汁"],"opposite":["无所用心"],"usage":"作谓语；用于写作"},{"id":22390,"word":"搜索肾胃","pinyin":"sōu suǒ shèn wèi","abbr":"sssw","explanation":"形容竭力思索。指构思诗文。","source":{"text":"苦心竭思，搜索肾胃，如与世士出寄作新，夸多而斗捷，以角一时之名者。","book":"宋·陈师道《序》"},"similar":["搜索枯肠"],"usage":"作谓语、定语；用于写作等"},{"id":22391,"word":"搜肠刮肚","pinyin":"sōu cháng guā dù","abbr":"scgd","explanation":"比喻绞尽脑汁，苦思苦想。","source":{"text":"一个家搜肠刮肚，不知饥，不知渴，只觉得口内生烟。","book":"明·冯惟敏《不伏老》第一折"},"example":{"text":"似这作文，～，可待写上什么？","book":"清·蒲松龄《逃学传》"},"similar":["冥思苦想","挖空心思"],"opposite":["无所用心"],"usage":"作谓语、状语；用于人"},{"id":22392,"word":"搜肠润吻","pinyin":"sōu cháng rùn wěn","abbr":"scrw","explanation":"谓饮茶润泽喉吻，促进文思。极言饮茶的乐趣。","source":{"text":"一椀喉吻润，两椀破孤闷，三椀搜枯肠，唯有文字五千卷。","book":"唐·卢仝《走笔谢孟谏议寄新茶》诗"},"example":{"text":"清·钱谦益《谢于昭远寄庙后茶》诗：“～如有灵，破闷祛烦不须猛。”"},"usage":"作谓语、定语；用于饮茶等"},{"id":22393,"word":"搠枪使棒","pinyin":"shuò qiāng shǐ bàng","abbr":"sqsb","explanation":"搠：戳。搬弄兵器，指动武。","source":{"text":"他庄上如常有搠枪使棒的人来，如何知他做这般的事？","book":"明·施耐庵《水浒传》第18回"},"similar":["使枪弄棒"],"usage":"作谓语、宾语、定语；用于战斗等"},{"id":22394,"word":"搠笔巡街","pinyin":"shuò bǐ xún jiē","abbr":"sbxj","explanation":"搠笔：插着毛笔；巡街：在大街上走。指贫穷的文人在街上卖诗文。","source":{"text":"我则道留下青山怕没柴，拼的个搠笔巡街。","book":"元·郑廷玉《看钱奴》第二折"},"example":{"text":"他穷得只好去～。"},"usage":"作谓语、宾语、定语；指穷困书生"},{"id":22395,"word":"搢绅之士","pinyin":"jìn shēn zhī shì","abbr":"jszs","explanation":"搢：插；绅：大带；搢绅：宦官的代称。指做过官的大人先生。","source":{"text":"所谓搢绅之士者，搢芴而垂绅带也。","book":"《晋书·舆服志》"},"example":{"text":"当此之时，臣弑其君，子弑其父，而～安其禄而立其朝。","book":"《新五代史·一行传序》"},"similar":["搢绅先生","缙绅之士"],"usage":"作主语、宾语；指旧时大官"},{"id":22396,"word":"搢绅先生","pinyin":"jìn shēn xiān shēng","abbr":"jsxs","explanation":"搢：插；绅：大带；搢绅：宦官的代称。指做过官的大人先生。","source":{"text":"其在于诗书礼乐者，邹鲁之士，搢绅先生多能明之。","book":"战国·宋·庄周《庄子·天下》"},"similar":["缙绅先生"],"usage":"作主语、宾语、定语；指旧时大官"},{"id":22397,"word":"搤臂啮指","pinyin":"è bì niè zhǐ","abbr":"ebnz","explanation":"指至孝之人与父母心相感应。","source":{"text":"磐同郡蔡顺……尝出求薪，有客卒至，母望顺不还，乃噬其指。顺即心动，弃薪弛归。","book":"汉·王充《论衡·感虚》：“曾母……以右手搤其左臂。曾子左臂立痛，即弛至问母……” 《后汉书·周磐传》"},"example":{"text":"人以是知～，古孝子非虚语也。","book":"清·钱谦益《故福建宁府推官待赠吏科给事嘉善柯君墓志铭》"}},{"id":22398,"word":"搥床捣枕","pinyin":"chuí chuáng dǎo zhěn","abbr":"ccdz","explanation":"搥：同“捶”，拳击；捣：撞击。形容难以入睡，辗转反侧。","source":{"text":"李妈妈搥床捣枕说：‘这可不中用了！我白操了一世的心了。’","book":"清·曹雪芹《红楼梦》第57回"},"similar":["捶床捣枕"],"usage":"作谓语、宾语、状语；指难以入睡"},{"id":22399,"word":"搦朽摩钝","pinyin":"nuò xiǔ mó dùn","abbr":"nxmd","explanation":"钝：不锋利。形容事物的锐气都被磨灭了。","source":{"text":"当此之时，搦朽摩钝，铅刀皆能一断。","book":"汉·班固《答宾戏》"}},{"id":22400,"word":"搦朽磨钝","pinyin":"nuò xiǔ mó dùn","abbr":"nxmd","explanation":"指才能低下的人也在激励求进。","source":{"text":"朽钝谓不才之人也，搦、磨皆自激励也。言当此之时，不才者皆亦激厉以求侥幸，如铅锡之刀能一断割。","book":"《文选·班固〈答宾戏〉》：“当此之时，搦朽磨钝，铅刀皆能一断。”李善注引韦昭曰：“搦，摩也。”刘良注"},"usage":"作谓语、定语；用于书面语"},{"id":22401,"word":"搦管操觚","pinyin":"nuò guǎn cāo gū","abbr":"ngcg","explanation":"搦：持、拿；管：指毛笔；觚：简策，古人用以书写。指提笔作文。","source":{"text":"犹冀苍雁赪鲤，时传尺素，清风朗月，但寄相思，搦管操觚，声泪俱咽。","book":"南朝·陈·周弘让《答王裒书》"},"example":{"text":"虽忘筌戴笠，兴交态于灵台，而～，叶神心于胜气。","book":"唐·骆宾王《初秋于窦六郎宅宴并序》"},"usage":"作谓语、宾语；指写作"},{"id":22402,"word":"搬口弄唇","pinyin":"bān kǒu nòng chún","abbr":"bknc","explanation":"搬：搬弄；弄：卖弄。指说长道短，挑拔是非或卖弄口才。","source":{"text":"搬：搬弄；弄：卖弄。指说长道短，挑拔是非或卖弄口才。"},"example":{"text":"明·施耐庵《水浒传》第43回：“又见我两日不回，必有人搬口弄舌，想是疑心，不做买卖。”"},"similar":["搬唇弄舌"],"usage":"作谓语、宾语；指故意挑拨是非"},{"id":22403,"word":"搬口弄舌","pinyin":"bān kǒu nòng shé","abbr":"bkns","explanation":"挑拨是非。同“搬唇递舌”。","source":{"text":"必然嫂嫂见我做了这些衣裳，一定背后有说话；又见我两日不回，必有人搬口弄舌，想是疑心，不做买卖。","book":"明·施耐庵《水浒传》第四十四回"},"similar":["搬口弄唇"],"usage":"作谓语、宾语；指故意挑拨是非"},{"id":22404,"word":"搬唇弄舌","pinyin":"bān chún nòng shé","abbr":"bcns","explanation":"①挑拨是非。②卖弄口才。","source":{"text":"搬唇弄舌，口是心非，到底有失，不可轻信。","book":"明·徐田臣《杀狗记·看书苦谏》"},"example":{"text":"你们念书人底能干只会在女人面前～罢。","book":"许地山《海底孤星》"},"similar":["搬唇递舌"],"opposite":["缄口不言"],"usage":"作谓语、宾语；指故意挑拨是非"},{"id":22405,"word":"搬唇递舌","pinyin":"bān chún dì shé","abbr":"bcds","explanation":"挑拔是非。","source":{"text":"平白地送暖偷寒，猛可的搬唇递舌。","book":"元·无名氏《南珍珠马·情》"},"example":{"text":"不似你这个两闲白面，～的歹弟子孩儿。","book":"《古今杂剧·翠红乡儿女两团圆》"},"similar":["拨弄是非","搬唇弄舌"],"usage":"作谓语；指故意挑拨是非"},{"id":22406,"word":"搬弄是非","pinyin":"bān nòng shì fēi","abbr":"bnsf","explanation":"搬弄：挑拔。把别人的话传来传去，有意挑拔，或在背后乱加议论，引起纠纷。","source":{"text":"他在平公面前，搬弄我许多事非。","book":"《庄子·盗跖》：“摇唇鼓舌，擅生是非。”元·李寿卿《伍员吹箫》第一折"},"example":{"text":"况三姑六婆，里外搬弄是非，何能不生事端。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["搬口弄舌","挑拨是非"],"opposite":["排难解纷"],"usage":"作谓语、宾语；形容把别人的话传来传去","story":["贾宝玉与秦可卿的弟弟秦钟去贾家学房里念书，与薛蟠、金荣等发生了矛盾，贾瑞要求金荣向秦钟道歉。金荣的母亲觉得不公平就去贾珍府里找尤氏说理。尤氏说秦可卿恨那帮狐朋狗友搬弄是非，已经气得生病了，金荣的母亲自觉没趣就回去了"]},{"id":22407,"word":"搬斤播两","pinyin":"bān jīn bō liǎng","abbr":"bjbl","explanation":"专从细小的斤两上动脑筋。","source":{"text":"如今这些贪人，拥着娇妻美妾，求田问舍，损人肥已，搬斤播两，何等肚肠。","book":"明·凌濛初《初刻拍案惊奇》第十八卷"},"similar":["盘剥克扣"],"usage":"作谓语、定语；指盘剥克扣"},{"id":22408,"word":"搬石头砸自己的脚","pinyin":"bān shí tóu zá zì jǐ de jiǎo","abbr":"bstzzjdj","explanation":"比喻本来想损害别人，结果却害了自己。","example":{"text":"比喻本来想损害别人，结果却害了自己。"}},{"id":22409,"word":"搬石砸脚","pinyin":"bān shí zá jiǎo","abbr":"bszj","explanation":"比喻本来想害别人，结果害了自己。","example":{"text":"刘婉蓉道：“我说了怕你赌气，拂袖而去，那岂不自己～，得不偿失。”","book":"卧龙生《镖旗》第二十六回"},"similar":["搬石头砸自己的脚"],"usage":"作谓语、宾语、定语；用于处事"},{"id":22410,"word":"搬起石头打自己的脚","pinyin":"bān qǐ shí tóu dǎ zì jǐ de jiǎo","abbr":"bqstdzjdj","explanation":"搬：移动。比喻本来想害别人，结果害了自己。自食其果。","source":{"text":"我在1938年十月的中共六届六中全会上曾经说过：‘搬起石头打自己的脚，这就是张伯伦政策的必然结果。’","book":"毛泽东《关于国际新形势对新华日报记者的谈话》"},"example":{"text":"他这样做无疑是～。"},"similar":["自作自受","自食其果"],"usage":"作宾语、分句；指自食其果"},{"id":22411,"word":"搬起石头砸自己的脚","pinyin":"bān qǐ shí tóu zá zì jǐ de jiǎo","abbr":"bqstzzjdj","explanation":"比喻本来想损害别人，结果却害了自己","source":{"text":"这在物理上叫‘变压器效应’，在俗话上叫‘搬起石头砸自己的脚。’任你风吹浪打，我自岿然不动。","book":"王朔《千万别把我当人》"},"example":{"text":"他～，让他哭笑不得"},"similar":["搬石砸脚"],"usage":"作谓语、宾语、定语；用于处事"},{"id":22412,"word":"搭搭撒撒","pinyin":"dā dā sā sā","abbr":"ddss","explanation":"眼皮下垂。引申为没精打采的样子。","source":{"text":"话说这潘用中恨恨的跟了父亲，离了这条六部桥，有一步，没一步，连脚也拖不动，搭搭撒撒，就像折翅的老鸦一般。","book":"明·周辑《西湖二集》卷十二"}},{"id":22413,"word":"搭桥牵线","pinyin":"dā qiáo qiān xiàn","abbr":"dqqx","explanation":"搭桥：架设桥梁；牵线：指从中介绍。比喻为促成某事而做中介工作。","example":{"text":"他为贫困山区的教育～，建了很多座希望小学。"},"similar":["搭桥牵线"],"usage":"作宾语、定语；用于处事"},{"id":22414,"word":"搴旗取将","pinyin":"qiān qí qǔ jiàng","abbr":"qqqj","explanation":"拔取敌旗，斩杀敌将。形容勇猛善战。","source":{"text":"然则一军之中必有虎贲之士，力轻抗鼎，足轻戎马，搴旗取将，必有能者。","book":"《吴子·料敌》"},"similar":["搴旗虏将"],"usage":"作谓语；指英勇善战"},{"id":22415,"word":"搴旗斩将","pinyin":"qiān qí zhǎn jiàng","abbr":"qqzj","explanation":"拔取敌旗，斩杀敌将。","source":{"text":"然则一军之中，必有虎贲之士，力轻抗鼎，足轻戎马，搴旗斩将，必有能者。","book":"《吴子·料敌》"},"example":{"text":"即使～，威振疆场，亦偏将之任，非主公所宜也。","book":"《三国演义》第五十三回"},"similar":["搴旗斩馘"],"usage":"作谓语、宾语；指英勇善战"},{"id":22416,"word":"搴旗斩馘","pinyin":"qiān qí zhǎn guó","abbr":"qqzg","explanation":"搴：拔；馘：首。拔取敌方旗帜，斩获敌人首级。比喻勇猛善战。","source":{"text":"今日之伐，须如雷霆之震，虎豹之系，搴旗斩馘，扫孽除凶。","book":"唐·陈子昂《为建安王誓众词》"},"similar":["搴旗斩将"],"usage":"作谓语、宾语；指英勇善战"},{"id":22417,"word":"搴旗虏将","pinyin":"qiān qí lǔ jiàng","abbr":"qqlj","explanation":"搴：拔取；虏：俘获。拔取敌旗，斩杀敌将。形容勇猛善战。","source":{"text":"然则一军之中，必有虎贲之士，力轻抗鼎，足轻戎马，搴旗取将，必有能者。","book":"《吴子·料敌》"},"example":{"text":"乘间薄人，肝脑涂地，以～而为乐。","book":"宋·崔伯易《感山赋》"},"similar":["搴旗取将"],"usage":"作谓语；指英勇善战"},{"id":22418,"word":"携云挈雨","pinyin":"xié yún qiè yǔ","abbr":"xyqy","explanation":"比喻男女欢爱。","source":{"text":"旦为朝云，暮为行雨。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"尚还不彻相思债，～，批风切月，到处绸缪。","book":"元·关汉卿《套数·大石调》"},"similar":["携云握雨"],"usage":"作宾语、定语；用于比喻句"},{"id":22419,"word":"携云握雨","pinyin":"xié yún wò yǔ","abbr":"xywy","explanation":"指男女欢合。","source":{"text":"旦为朝云，暮为行雨。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"你往常时，在那鸳鸯帐底，那般儿～。","book":"元·秦简夫《东堂老》第三折"},"similar":["携云挈雨"],"usage":"作宾语、定语；用于比喻句"},{"id":22420,"word":"携儿带女","pinyin":"xié ér dài nǚ","abbr":"xedn","explanation":"携：拉着。带领着儿女。形容放任辛劳或生计艰难。","source":{"text":"闹热热携儿带女，苦凄凄单夫只妻。","book":"明·凌濛初《初刻拍案惊奇》卷三十八"},"example":{"text":"当时他们携儿带女，背筐挑担，纷纷从黄泛区逃出来，沿着陇海铁路一路西行。","book":"路遥《平凡的世界》第三部第一章"},"similar":["拖儿带女","扶老携幼"],"usage":"作谓语、状语、定语；用于书面语"},{"id":22421,"word":"携家带口","pinyin":"xié jiā dài kǒu","abbr":"xjdk","explanation":"携带家眷，指受家眷的拖累。","example":{"text":"这次外出不准～，只能单身上阵。"},"similar":["携家带眷","拉家带口"],"usage":"作谓语、宾语；指带着一家大小"},{"id":22422,"word":"携幼扶老","pinyin":"xié yòu fú lǎo","abbr":"xyfl","explanation":"搀着老人，领着小孩。同“扶老携幼”。","source":{"text":"施德垂赏以招致之，此必携幼扶老以旧圣德。","book":"东汉·班固《汉书·严助传》"},"similar":["扶老携幼"],"usage":"作宾语、状语；指搀着老人，领着小孩"},{"id":22423,"word":"携手并肩","pinyin":"xié shǒu bìng jiān","abbr":"xsbj","explanation":"手拉着手，肩靠着肩。形容十分亲密，一致行动。","source":{"text":"纱笼才过处，喝道转身，一壁小来且住。见许多才子艳质，携手并肩低语。","book":"明·凌濛初《二刻拍案惊奇》卷五"},"example":{"text":"等到那轮皓月复了圆，又～倚着门儿望了回月，见那素彩清辉，益发皓洁圆满。","book":"清·文康《儿女英雄传》第三十四回"}},{"id":22424,"word":"携手接武","pinyin":"xié shǒ jiē wǔ","abbr":"xsjw","explanation":"武：脚步。手拉着手，脚步跟着脚步。比喻跟别人亦步亦趋地学。","source":{"text":"为人若反是，虽携手接武，终不成道。","book":"宋·胡仔《苕溪渔隐丛话后集·回仙》"},"usage":"作谓语、宾语；用于书面语"},{"id":22425,"word":"携男挈女","pinyin":"xié nán qiè nǚ","abbr":"xnqn","explanation":"带领着男儿女儿。多用于形容旅途的辛苦或生计的艰辛。","source":{"text":"怀玉领兵，约行六七十里，只见道路之中，大队小队携男挈女而来。","book":"《杨家将演义》第五十一回"},"usage":"作定语、状语；用于人多的场合"},{"id":22426,"word":"携老扶幼","pinyin":"xié lǎo fú yòu","abbr":"xlfy","explanation":"携：牵引，搀扶。指搀着老人，领着小孩。形容不分老少全部出动。","source":{"text":"贞观初，频年霜早，几内户口并就关外，携老扶幼，来往数年，卒无一户亡去。","book":"《新唐书·魏征传》"},"example":{"text":"晋阳百姓感尹铎仁德，～，迎接入城。","book":"明·冯梦龙《东周列国志》第84回"},"similar":["扶老携幼"],"usage":"作宾语、状语；指全部出动","story":["西晋时期，并州刺史刘琨在赴任途中，见盗寇出没，百姓流离失所，四处逃散，留下的人十分有限。百姓携老扶弱往外讨饭。刘琨招募1000人，转战晋阳，打击盗贼，安抚农民从事农业生产，不到半年，流离的人逐渐回来安居乐业"]},{"id":22427,"word":"携老扶弱","pinyin":"xié lǎo fú ruò","abbr":"xlfr","explanation":"搀着老人，扶着体弱者。亦作“携老扶幼”、“携老挈幼”。","source":{"text":"臣自涉州疆，目睹困乏，流移四散，十不存二，携老扶弱，不绝于路。","book":"《晋书·刘琨传》"},"example":{"text":"他们～结伴而行。"},"similar":["携老扶幼","携老挈幼"],"usage":"作谓语、状语；指相互帮助","story":["西晋时期，并州刺史刘琨在赴任途中，见盗寇出没，百姓流离失所，四处逃散，留下的人十分有限。百姓携老扶弱往外讨饭。刘琨招募1000人，转战晋阳，打击盗贼，安抚农民从事农业生产，不到半年，流离的人逐渐回来安居乐业"]},{"id":22428,"word":"携老挈幼","pinyin":"xié lǎo qiè yòu","abbr":"xlqy","explanation":"搀着老人，拉着体幼小者。","source":{"text":"臣自涉州疆，目睹困乏，流移四散，十不存二，携老扶弱，不绝于路。","book":"《晋书·刘琨传》"},"example":{"text":"但见朱仙镇上的居民百姓，一路～，头顶香盘，挨挨挤挤，众口同声攀留元帅，哭声震地。","book":"清·钱彩《说岳全传》第五十九回"},"similar":["携老扶弱"],"usage":"作谓语、状语；指相互帮助"},{"id":22429,"word":"搽油抹粉","pinyin":"chá yóu mǒ fěn","abbr":"cymf","explanation":"粉：香粉。涂脂抹粉，刻意打扮。","source":{"text":"呜呼！尚凡以搽油抹粉，评老束足。","book":"清·秋瑾《精卫石》序"},"similar":["搽脂抹粉"],"usage":"作谓语、定语；用于女人"},{"id":22430,"word":"搽脂抹粉","pinyin":"chá zhī mǒ fěn","abbr":"czmf","explanation":"指化妆打扮。今亦用于形容掩饰、遮盖。","source":{"text":"每日起来，搽脂抹粉，那脸上的烟色，还可遮得过去。","book":"清·彭养鸥《黑籍冤魂》第19回"},"example":{"text":"是一些参观的人，还有一些～的太太在当中。","book":"丁玲《水》"},"similar":["涂脂抹粉","搽油抹粉"],"usage":"作谓语、定语；用于女人"},{"id":22431,"word":"摄威擅势","pinyin":"shè wēi shàn shì","abbr":"swss","explanation":"指凭借权势，专横跋扈。","source":{"text":"昔者齐简公释其国家之柄，而专任其大臣，将相摄威擅势，私门成党，而公道不行。","book":"《淮南子·氾论训》"},"usage":"作谓语、定语；用于处世等"},{"id":22432,"word":"摄官承乏","pinyin":"shè guān chéng fá","abbr":"sgcf","explanation":"摄：代理；承乏：指官位空着无人出任，暂且由自己承担。旧时常用作官场自谦语。","source":{"text":"敢告不敏，摄官承乏。","book":"《左传·文公二年》"},"example":{"text":"章炳麟《为辛亥同志俱乐部纠正段祺瑞废止法统令通电》：“虽～，亦应权宜，而毁法乱常，遂成习惯。”"},"usage":"作谓语、定语；用于官场等"},{"id":22433,"word":"摄手摄脚","pinyin":"shè shǒu shè jiǎo","abbr":"sssj","explanation":"摄：收敛。指轻手轻脚。","source":{"text":"说着也扬手一下打的那丫头一个趔趄，便摄手摄脚的走至窗前。","book":"清·曹雪芹《红楼梦》第四十四回"},"example":{"text":"到得晚饭时，姨妈便～，把那小包子里的混帐东西放在茶里面。","book":"清·吴趼人《二十年目睹之怪现状》第八十九回"}},{"id":22434,"word":"摄魄钩魂","pinyin":"shè pò gōu hún","abbr":"spgh","explanation":"摄：收取。旧时传说，妖魔鬼怪或某种迷信邪术，能钩取人的魂魄，来祸害人。","source":{"text":"你三个自今日，当远离，再休要咏月吟风，摄魄钩魂，把人狐魅。","book":"明·朱权《冲漠人》第二折"},"example":{"text":"这和尚法名性空，河南少林寺出身，皈依国师座下……有万夫不当之勇，能压生咒死，～。","book":"《野叟曝言》第四三回"},"similar":["勾魂摄魄"],"usage":"作谓语、定语；指十分有吸引力"},{"id":22435,"word":"摅忠报国","pinyin":"shū zhōng bào guó","abbr":"szbg","explanation":"摅：抒发。抒发忠诚，报效国家。","source":{"text":"汝等赴任之后，各宜摅忠报国，施展奇抱，不枉为一世之丈夫也。","book":"明·无名氏《杨家将演义》第三十九回"},"similar":["尽忠报国"],"usage":"作谓语；指人爱国"},{"id":22436,"word":"摅肝沥胆","pinyin":"shū gān lì dǎn","abbr":"sgld","explanation":"比喻真心相见，倾吐心里话。也形容非常忠诚。同“披肝沥胆”。","source":{"text":"窃为公计，莫若摅肝沥胆，激昂慷慨，极论天下之贤士，求当今政令之得失。","book":"元·揭傒斯《与萧维斗书》"},"similar":["披肝沥胆"],"usage":"作谓语、状语；指非常忠诚"},{"id":22437,"word":"摆八卦阵","pinyin":"bǎi bā guà zhèn","abbr":"bbgz","explanation":"比喻布置疑阵，故弄玄虚。","example":{"text":"你最好别给我～了！"},"similar":["故弄玄虚"],"usage":"作谓语、宾语；指故弄玄虚"},{"id":22438,"word":"摆尾摇头","pinyin":"bǎi wěi yáo tóu","abbr":"bwyt","explanation":"摆动头尾，形容喜悦或悠然自得的样子。","source":{"text":"只见麒麟迅速，狮子峥嵘，摆尾摇头，山林迎接。","book":"《大唐三藏取经诗话》上卷"},"example":{"text":"这鱼～在水内显，全不知深共浅。","book":"元·无名氏《鱼篮记》第一折"},"similar":["摇头摆尾"],"opposite":["垂头丧气"],"usage":"作谓语、状语；形容喜悦或悠然自得的样子"},{"id":22439,"word":"摆架子","pinyin":"bǎi jià zǐ","abbr":"bjz","explanation":"指自高自大，装腔作势","source":{"text":"林之洋道：‘他果另眼相看，俺更要摆架子说大话了。’","book":"清·李汝珍《镜花缘》第25回"},"example":{"text":"王朔《无人喝彩》：“他进了一家门脸很亲切不～但场面不小座位众多的饭庄。”"},"similar":["摆款儿"],"opposite":["平易近人"],"usage":"作谓语、宾语、定语；用于处事"},{"id":22440,"word":"摆老资格","pinyin":"bǎi lǎo zī gé","abbr":"blzg","explanation":"摆出自己具有基于年长的声誉或权威","example":{"text":"他动不动就爱～"},"similar":["摆架子"],"usage":"作谓语、宾语；用于处事"},{"id":22441,"word":"摆袖却金","pinyin":"bài xiù què jīn","abbr":"bxqj","explanation":"比喻为人廉洁，不受贿赂。","source":{"text":"执谊为翰林学士，受财为人求科第，夏卿不就应乃探囊中金以内夏卿袖，夏卿……摆袖引身而去。","book":"唐·韩愈《顺宗实录》"},"opposite":["照单全收"],"usage":"作谓语、定语；指拒贿"},{"id":22442,"word":"摆迷魂阵","pinyin":"bǎi mí hún zhèn","abbr":"bmhz","explanation":"比喻采取一个迷惑人的行动。","example":{"text":"你不要给我～。"},"usage":"作谓语；指迷惑人"},{"id":22443,"word":"摆龙门阵","pinyin":"bǎi lóng mén zhèn","abbr":"blmz","explanation":"闲谈，聊天，讲故事。","source":{"text":"他就喜欢听那些狼烟大话，听这些人帮着他摆龙门阵！","book":"管桦《清风店》"},"example":{"text":"我不喜欢你在此～。"},"usage":"作谓语；用于方言"},{"id":22444,"word":"摇吻鼓舌","pinyin":"yáo wěn gǔ shé","abbr":"ywgs","explanation":"耍嘴皮，嚼舌头。形容耍弄嘴皮进行挑拨煽动。","source":{"text":"多辞缪说，不耕而食，不织而衣，摇唇鼓舌，擅生是非，以迷天下之主。","book":"《庄子·盗跖》"},"example":{"text":"一时鲜廉寡耻之徒。往来乎其间，～，劝之以势，诱之以利。","book":"宋·陈亮《辩士传序》"},"similar":["摇唇鼓舌","摇唇鼓喙"],"usage":"作谓语、宾语、定语；指卖弄口才"},{"id":22445,"word":"摇唇弄舌","pinyin":"yáo chún nòng shé","abbr":"ycns","explanation":"耍嘴皮，嚼舌头。形容耍弄嘴皮进行挑拨煽动","source":{"text":"你休要摇唇弄舌，你纪大太爷是安善良民，守分百姓，岂可同贼人为伍？","book":"清·贪梦道人《彭公案》第100回"},"similar":["摇唇鼓舌"],"usage":"作谓语、宾语、定语；指卖弄口才"},{"id":22446,"word":"摇唇鼓吻","pinyin":"yáo chún gǔ wěn","abbr":"ycgw","explanation":"耍嘴皮，嚼舌头。形容耍弄嘴皮进行挑拨煽动。","source":{"text":"多辞缪说，不耕而食，不织而衣，摇唇鼓舌，擅生是非，以迷天下之主。","book":"《庄子·盗跖》"},"example":{"text":"不知小人得志，～，一时正人旋被斥逐，继而章惇复柄用，虽大防亦不能安其身于朝廷之上。","book":"《宋史·刘黻传》"}},{"id":22447,"word":"摇唇鼓喙","pinyin":"yáo chún gǔ huì","abbr":"ycgh","explanation":"犹言摇唇鼓舌。形容耍弄嘴皮进行挑拨煽动。","source":{"text":"世之好议论者，见其辞禄而归，摇唇鼓喙，诩诩相夸奖。","book":"明·宋濂《送徐大年还淳安序》"},"similar":["摇唇鼓舌","摇吻鼓舌"],"usage":"作谓语、宾语、定语；指卖弄口才"},{"id":22448,"word":"摇唇鼓舌","pinyin":"yáo chún gǔ shé","abbr":"ycgs","explanation":"耍嘴皮，嚼舌头。形容耍弄嘴皮进行挑拨煽动。","source":{"text":"多辞缪说，不耕而食，不织而衣，摇唇鼓舌，擅生是非，以迷天下之主。","book":"《庄子·盗跖》"},"example":{"text":"我正在这里指授进兵的方略，胆敢～，煽惑军心！","book":"清·李宝嘉《官场现形记》第十四回"},"similar":["拨是弄非","花言巧语","巧舌如簧"],"opposite":["哑口无言","沉默寡言","默不做声"],"usage":"作谓语、宾语、定语；指卖弄口才"},{"id":22449,"word":"摇嘴掉舌","pinyin":"yáo zuǐ diào shé","abbr":"yzds","explanation":"犹摇唇鼓舌。形容耍弄嘴皮进行挑拨煽动。","source":{"text":"得莺莺后便退干戈，不得后目前生祸。不共你摇嘴掉舌，不共你斗争斗合。","book":"金·董解元《西厢记诸宫调》第二卷"},"similar":["摇唇鼓舌"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":22450,"word":"摇头不算点头算","pinyin":"yáo tóu bù suàn diǎn tóu suàn","abbr":"ytbsdts","explanation":"明确表态。","source":{"text":"你看，姑娘一过门，吃的是珍馐美味，穿的是绫罗绸缎，这不是造化吗？怎样，摇头不算点头算，来个干脆的！","book":"老舍《茶馆》"},"usage":"作宾语、分句；指明确表态"},{"id":22451,"word":"摇头叹息","pinyin":"yáo tóu tàn xī","abbr":"yttx","explanation":"形容感慨或难过的表情。","source":{"text":"他们睁着眼睛不看责任制带来的好处，只管继续摇头叹息：‘社会主义已经不成体统了’。","book":"路遥《平凡的世界》第三卷第24章"},"example":{"text":"看着河水受污染的面积日益扩大，大家不禁～。"},"usage":"作谓语、定语、状语；用于处事"},{"id":22452,"word":"摇头幌脑","pinyin":"yáo tóu huǎng nǎo","abbr":"ythn","explanation":"脑袋摇来摇去。多形容自得其乐、自以为是的样子。同“摇头稾脑”。","source":{"text":"《自由谈》的编者刊出了‘吁请海内文豪，从兹多谈风月’的启事以来，很使老牌风月文豪摇头幌脑的高兴了一大阵。","book":"鲁迅《前记》"},"similar":["摇头晃脑"],"usage":"作状语、定语；指人的神态"},{"id":22453,"word":"摇头掉尾","pinyin":"yáo tóu diào wěi","abbr":"ytdw","explanation":"原形容鱼悠然自在的样子。现用来形容人摇头晃脑、轻浮得意的样子。","source":{"text":"临济门下有个赤梢鲤鱼，摇头摆尾向南方去，不知向谁家齑瓮里淹杀？","book":"宋·释普济《五灯会元》卷六"},"example":{"text":"只见庵后跑出一白犬，一黑猪，～，径奔至林澹然跟前。","book":"明·清溪道人《禅真逸史》第三十八回"}},{"id":22454,"word":"摇头摆尾","pinyin":"yáo tóu bǎi wěi","abbr":"ytbw","explanation":"原形容鱼悠然自在的样子。现用来形容人摇头晃脑、轻浮得意的样子。","source":{"text":"临济门下有个赤梢鲤鱼，摇头摆尾向南方去，不知向谁家齑瓮里淹杀？","book":"宋·释普济《五灯会元》"},"example":{"text":"坏人尽管～的得意，好人还得作好，咱们得忍着点。","book":"老舍《四世同堂》第七章"},"similar":["摇头晃脑","仰首伸眉","自鸣得意"],"opposite":["兴致索然","垂头丧气","萎靡不振"],"usage":"作谓语、定语；指得意轻浮的样子"},{"id":22455,"word":"摇头摆脑","pinyin":"yáo tóu bǎi nǎo","abbr":"ytbn","explanation":"脑袋摇来摇去。形容骄傲自得或自得其乐的样子。亦以形容读书吟诵的姿态。","source":{"text":"相得端明似虎形，摇头摆脑得人憎。","book":"宋·王明清《挥薼余话》第二卷"},"example":{"text":"沙汀《代理县长》：“代理县长～地笑起来，随又满足地叹了口气。”"},"similar":["摇头晃脑"],"usage":"作谓语、状语、定语；指人的神态"},{"id":22456,"word":"摇头晃脑","pinyin":"yáo tóu huàng nǎo","abbr":"ythn","explanation":"晃：摇动。脑袋摇来摇去。形容自己感觉很有乐趣或自己认为很不差的样子。","source":{"text":"怎奈他不来理论这话，倒瞪着两只眼睛，摇头晃脑，指手画脚。","book":"清·文康《儿女英雄传》第三十二回"},"example":{"text":"～的读起来，真是音调铿锵，使人不自觉其头晕。","book":"鲁迅《二心集·善于翻译的通信》"},"similar":["摇头摆尾","得意忘形","沾沾自喜"],"opposite":["正襟危坐","一本正经","道貌岸然"],"usage":"作谓语、状语、定语；指人的神态"},{"id":22457,"word":"摇头稾脑","pinyin":"yáo tóu gǎo nǎo","abbr":"ytgn","explanation":"脑袋摇来摇去。多形容自得其乐、自以为是的样子。"},{"id":22458,"word":"摇头穢脑","pinyin":"yáo tóu gǎo nǎo","abbr":"ytgn","explanation":"脑袋摇来摇去。多形容自得其乐、自以为是的样子。"},{"id":22459,"word":"摇头麰尾","pinyin":"yáo tóu móu wěi","abbr":"ytmw","explanation":"原形容鱼悠然自在的样子。现用来形容人摇头晃脑、轻浮得意的样子。同“摇头摆尾”。"},{"id":22460,"word":"摇头黣尾","pinyin":"yáo tóu móu wěi","abbr":"ytmw","explanation":"原形容鱼悠然自在的样子。现用来形容人摇头晃脑、轻浮得意的样子。同摇头摆尾”。"},{"id":22461,"word":"摇尾乞怜","pinyin":"yáo wěi qǐ lián","abbr":"ywql","explanation":"乞：乞求；怜：怜悯。狗摇着尾巴向主人乞求爱怜。比喻装出一副可怜相向人讨好。","source":{"text":"若俯首帖耳、摇尾而乞怜者，非我之志也。","book":"唐·韩愈《应科目时与人书》"},"example":{"text":"摇尾而乞怜，胁肩而取媚，以侥幸于寸进。","book":"元·吴滶《送何太虚北游序》"},"similar":["摇尾乞食","卑躬屈膝","乞哀告怜"],"opposite":["妄自尊大","目空一切","趾高气扬"],"usage":"作谓语、定语；指假装可怜"},{"id":22462,"word":"摇尾求食","pinyin":"yáo wěi qiú shí","abbr":"ywqs","explanation":"老虎被关进笼圈里，向人摇尾巴求取食物。比喻人的地位降低，向人乞求。","source":{"text":"猛虎在深山，百兽震恐，及在槛阱之中，摇尾而求食，积威约之渐也。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"下走被羁系久矣，犹未至～耳！褫吾皮以为鼓，恐亦不足郊天。","book":"章炳麟《致吴君遂书》"},"similar":["摇尾乞怜"],"opposite":["趾高气扬"],"usage":"作谓语、定语；指向人乞求"},{"id":22463,"word":"摇尾涂中","pinyin":"yáo wěi tú zhōng","abbr":"ywtz","explanation":"比喻自由自在地生活。曳尾，犹摇尾。","source":{"text":"战国时，楚王派大夫去请庄子做官，庄子对楚大夫说：听说楚国有神龟，死去已三千年，现在把它用匣子装起来藏在庙堂之上。你看此龟是留下骨头让人珍藏好呢，还是活着曳尾于泥涂中好？大夫说：当然是活着曳尾于涂中好。庄子说：那末我将曳尾于涂中。见"},"example":{"text":"晋·葛洪《抱朴子·勤求》：“老子以长生久视为业，而庄周贵于～，不为被网之龟，被绣之牛。”"},"similar":["曳尾涂中"],"usage":"作谓语、定语、宾语；用于书面语","story":["战国时期著名的思想家庄子很有才学，楚威王想请他来辅佐朝政，派两个使者带上许多珍珠玉帛，在濮水岸边见到隐居在此钓鱼的庄子，庄子对使者打比方说他愿意像保全性命曳尾涂中的乌龟，过着隐居生活。使者只好悻悻而去"]},{"id":22464,"word":"摇山振岳","pinyin":"yáo shān zhèn yuè","abbr":"yszy","explanation":"岳：高大的山。把高山都振动了。形容气势很大。","source":{"text":"一直到了宁国府前，只见府门大开，两边灯火，照如白昼。乱烘烘人来人往，里面哭声摇山振岳。","book":"清·曹雪芹《红楼梦》第十三回"}},{"id":22465,"word":"摇席破坐","pinyin":"yáo xí pò zuò","abbr":"yxpz","explanation":"指在饮宴中中途离席。同“摇席破座”。","source":{"text":"且教他孝顺席尊众亲两套词儿着，你这狗才就这等摇席破坐的。","book":"明·兰陵笑笑生《金瓶梅词话》第32回"},"similar":["摇席破座"],"usage":"作谓语、宾语；用于书面语"},{"id":22466,"word":"摇席破座","pinyin":"yáo xí pò zuò","abbr":"yxpz","explanation":"指在饮宴中中途离席。","source":{"text":"哥哥，你不达理！这般御酒不吃，摇席破座的，且去看甚么哩？","book":"明·吴承恩《西游记》第69回"},"similar":["摇席破坐"],"usage":"作谓语、宾语；用于书面语"},{"id":22467,"word":"摇手触禁","pinyin":"yáo shǒu chù jìn","abbr":"yscj","explanation":"摇：动；触：触犯。摇一下手就触犯禁令。比喻法令繁琐苛刻。","source":{"text":"民摇手触禁，不得耕桑，繇役烦剧。","book":"东汉·班固《汉书·食货志下》"},"example":{"text":"而迾之以丛棘，令士民～。","book":"清·章炳麟《释戴》"},"usage":"作谓语、定语；指法令繁琐苛刻"},{"id":22468,"word":"摇手顿足","pinyin":"yáo shǒu dùn zú","abbr":"ysdz","explanation":"形容惋惜或懊恨时的动作。","source":{"text":"摇手顿足曰：‘此人见识胜吾十倍，必为我国之祸。’","book":"明·罗贯中《三国演义》第四十五回"}},{"id":22469,"word":"摇摆不定","pinyin":"yáo bǎi bù dìng","abbr":"ybbd","explanation":"指心意犹豫不决，来回变化。","source":{"text":"小资产阶级也常摇摆不定，只有无产阶级是最不妥协的革命阶级。","book":"周恩来《现时政治斗争中之我们》"},"example":{"text":"不要与这些～的人谈生意。"},"similar":["犹豫不决"],"opposite":["坚定不移"],"usage":"作谓语、定语；指人的立场"},{"id":22470,"word":"摇摇华胄","pinyin":"yáo yáo huá zhòu","abbr":"yyhz","explanation":"胄：后代人。指距今年代久远的名人的后矞。","source":{"text":"昌寓团扇掩口而笑，谓坐客曰：‘遥遥华胄。’","book":"《南史·何昌寓传》"}},{"id":22471,"word":"摇摇摆摆","pinyin":"yáo yáo bǎi bǎi","abbr":"yybb","explanation":"①形容主意不定。②行走不稳的样子。③坦然自得的样子。","source":{"text":"一个妇女摇摇摆摆从府堂里出来，自言自语，与崔宁打了个胸厮撞。","book":"元·无名氏《陈州粜米》第四折：“我做个州官不歹，断事处摇摇摆摆。”《京本通俗小说·碾玉观音》"},"example":{"text":"这位玄奘再拜谢恩，在那大街上，烈烈轰轰，～。","book":"明·吴承恩《西游记》第十二回"},"similar":["摇摆不定"],"opposite":["立场坚定"],"usage":"作谓语、状语、定语；指立场不稳"},{"id":22472,"word":"摇摇晃晃","pinyin":"yáo yáo huǎng huǎng","abbr":"yyhh","explanation":"左右摇摆，不稳定。","source":{"text":"他说完这些话，就站起来，打开家门，摇摇晃晃地向外面的黑暗中走去……","book":"路遥《平凡的世界》第一卷第45章"},"example":{"text":"这张椅子～的，不能再坐了。"},"similar":["左右摇摆"],"opposite":["纹丝不动"],"usage":"作谓语、状语、定语；指左右摇摆"},{"id":22473,"word":"摇摇欲倒","pinyin":"yáo yáo yù dǎo","abbr":"yyyd","explanation":"摇摇：摇晃；欲：将要。形容很快就要倒塌，或不稳固，很快就要垮台。","source":{"text":"西方的希特勒在苏联红军严重打击之下有摇摇欲倒之势。","book":"毛泽东《学习和时局》"},"similar":["摇摇欲坠"],"usage":"作谓语、定语、状语；指很快就要垮台"},{"id":22474,"word":"摇摇欲坠","pinyin":"yáo yáo yù zhuì","abbr":"yyyz","explanation":"摇摇：摇动，摇晃；坠：落下。形容十分危险，很快就要掉下来，或不稳固，很快就要垮台。","source":{"text":"众视之，见其色昏暗，摇摇欲坠。","book":"明·罗贯中《三国演义》第一百零四回"},"example":{"text":"战士们靠近边缘向下一看，头晕目眩，觉得眼前的大岩来回晃动，自己的身体～。","book":"曲波《林海雪原》二七"},"similar":["摇摇欲倒","风雨飘摇","危如累卵"],"opposite":["稳如泰山","安如磐石"],"usage":"作谓语、定语、状语；指很快就要垮台"},{"id":22475,"word":"摇摇欲堕","pinyin":"yáo yáo yù duò","abbr":"yyyd","explanation":"摇摇：摇动，摇晃；堕：落下。形容十分危险，很快就要掉下来，或不稳固，很快就要垮台。","source":{"text":"众视之，见其色昏暗，摇摇欲坠。","book":"明·罗贯中《三国演义》第一百零四回"},"example":{"text":"那牛仰天卧在一块岩石上，四足挣扎，站不起来，那石～。","book":"金庸《射雕英雄传》第二十九回"}},{"id":22476,"word":"摇旗呐喊","pinyin":"yáo qí nà hǎn","abbr":"yqnh","explanation":"原指古代作战时摇着旗子，大声喊杀助威。现比喻给别人助长声势。","source":{"text":"你这般摇旗呐喊，簸土扬沙。","book":"元·乔孟符《两世姻缘》第三折"},"example":{"text":"球场上球迷们～，为各自的球队助威。"},"similar":["擂鼓助威","助长声势","呐喊助威"],"opposite":["鸣金收兵","偃旗息鼓","不动声色"],"usage":"作谓语、状语；比喻给别人助长声势"},{"id":22477,"word":"摇曳多姿","pinyin":"yáo yè duō zī","abbr":"yydz","explanation":"形容摆动的姿态变化多，优美动人。","example":{"text":"对席快清谈流连竟日，凭栏惊妙舞～。","book":"张恨水《春明外史》第六十七回"}},{"id":22478,"word":"摇相应和","pinyin":"yáo xiāng yìng hè","abbr":"yxyh","explanation":"遥：远远地；应：照应。远远地互相联系，互相配合。","source":{"text":"且郑成功出没闽、浙，奉其伪号，遥相应和，声势颇张。","book":"《清史稿·许友信传》"}},{"id":22479,"word":"摇笔即来","pinyin":"yáo bǐ jí lái","abbr":"ybjl","explanation":"不用多思索，一动笔就写出来了。形容写文章快。","source":{"text":"然而中国的习惯，这些句子是摇笔即来，不假思索的。","book":"鲁迅《且介亭杂文二集·论人言可畏》"},"similar":["挥笔而就"],"usage":"作谓语；指文思敏捷"},{"id":22480,"word":"摇笔弄舌","pinyin":"yáo bǐ nòng shé","abbr":"ybns","explanation":"耍笔杆，嚼舌头。形容耍弄嘴皮进行挑拨煽动。","example":{"text":"毋得～，舞文嚼字，为民贼之后援，然后能一新耳目以行进步之实也。","book":"清·梁启超《论进步》"}},{"id":22481,"word":"摇羽毛扇","pinyin":"yáo yǔ máo shàn","abbr":"yyms","explanation":"比喻出谋画策。同“摇鹅毛扇”。","source":{"text":"小说和戏剧上的诸葛亮，几百年来在群众中，形成了一个固定的形象，即所谓摇羽毛扇的人物。","book":"孙犁《秀露集·耕堂读书记（一）》"},"similar":["摇鹅毛扇"],"usage":"作谓语、定语、宾语；指出谋划策"},{"id":22482,"word":"摇身一变","pinyin":"yáo shēn yī biàn","abbr":"ysyb","explanation":"旧时神怪小说中描写有神通的人能用法术一晃身子就改变自己本来的模样。现用来形容人不讲道义原则，一下子来个大改变。","source":{"text":"悟空捻着诀，念动咒语，摇身一变，就变做一稞（棵）松树。","book":"明·吴承恩《西游记》第二回"},"example":{"text":"就这样铁路总公司的第七次的股东大会～变成了川汉铁路的“保路同志会”。","book":"郭沫若《反正前后》"},"similar":["变化多端","说变就变","变化无常"],"opposite":["一成不变"],"usage":"作谓语；指人变得很快"},{"id":22483,"word":"摇钱之树","pinyin":"yáo qián zhī shù","abbr":"yqzs","explanation":"旧时传说中的一种宝树，一摇钱就掉下来。比喻能够用来获取源源不断钱财的人或物。","source":{"text":"只是你的娘，把你当个摇钱之树，等闲也不轻放你出去。","book":"明·冯梦龙《醒世恒言》卷三"}},{"id":22484,"word":"摇钱树","pinyin":"yáo qián shù","abbr":"yqs","explanation":"神话中的一种宝树，一摇晃就有许多钱掉下来。指借以获得钱财的人或事物。","source":{"text":"只是你的娘，把你当个摇钱之树，等闲也不轻放你出去。","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"旧家庭把子弟做～，这种心理是很普遍的。","book":"恽代英《来鸿去雁录·致汪冀贤》"},"usage":"作主语、宾语、定语；指借以获得钱财的人"},{"id":22485,"word":"摇铃打鼓","pinyin":"yáo líng dǎ gǔ","abbr":"yldg","explanation":"比喻张扬，闹得大家都知道。","source":{"text":"既是你乔亲家爹主主张，兑三百二十两，抬了来罢，休要只顾摇铃打鼓的了。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"},"similar":["扬铃打鼓"],"usage":"作谓语；指大肆张扬"},{"id":22486,"word":"摇锣打鼓","pinyin":"yáng luó dǎ gǔ","abbr":"yldg","explanation":"又敲锣，又打鼓。比喻大声张扬。","source":{"text":"既是你乔亲家爹主主张，兑三百二十两，抬了来罢，休要只顾摇铃打鼓的了。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"}},{"id":22487,"word":"摇首吐舌","pinyin":"yáo shǒu tǔ shé","abbr":"ysts","explanation":"吐舌：说不出话。形容惊讶、害怕得说不出话来。","source":{"text":"良久，乃摇首吐舌道：‘长公子太不良了。’","book":"明·冯梦龙《喻世明言》卷十"},"similar":["摇首咋舌"],"usage":"作定语、状语；用于人的表情等"},{"id":22488,"word":"摇首咋舌","pinyin":"yáo shǒu zhà shé","abbr":"yszs","explanation":"咋舌：说不出话。形容惊讶、害怕得说不出话来。","source":{"text":"轿夫抬起，打从旧路，直至园门首，依原不见一人。那些皂快，没一个不摇首咋舌。","book":"明·冯梦龙《喻世明言》卷二十九"},"example":{"text":"莫说顾夫人是个女娘家，就险些儿吓得死了；便是一家们在那里守尸的，那一个不～。","book":"明·冯梦龙《醒世恒言》卷二十六"},"similar":["摇首吐舌"],"usage":"作定语、状语；用于人的表情等"},{"id":22489,"word":"摇首顿足","pinyin":"yáo shǒu dùn zú","abbr":"ysdz","explanation":"摇着头，跺着脚。非常懊恼或惋惜的神态。","source":{"text":"摇首顿足曰：‘此人见识胜吾十倍，今不除之，必为我国之祸！","book":"明·罗贯中《三国演义》第45回"},"usage":"作谓语、状语；指懊悔的神态"},{"id":22490,"word":"摇鹅毛扇","pinyin":"yáo é máo shàn","abbr":"yems","explanation":"传说诸葛亮常手执羽扇指挥作战，后世舞台上出现的一些军师也多执羽扇。以之比喻出谋画策。","source":{"text":"大家都说他是一个摇鹅毛扇的，是一个唱傀儡戏的提线的人。","book":"丁玲《太阳照在桑干河上》一"},"example":{"text":"我倒是觉得敬轩的那位～子的军师，生得鹰鼻子鹞眼，不是个善良家伙。","book":"姚雪垠《李自成》第十九章"},"similar":["摇羽毛扇"],"usage":"作谓语、定语、宾语；指出谋划策"},{"id":22491,"word":"摈斥异己","pinyin":"bìn chì yì jǐ","abbr":"bcyj","explanation":"摈斥：排斥；异己：同自己意见不合的人。排挤、清除和自己意见不同或利害冲突的人","source":{"text":"贤者摈于朝。","book":"西汉·刘安《淮南子·说林训》"},"example":{"text":"他一旦掌权就会～的"},"similar":["排斥异己","排除异己"],"usage":"作谓语、宾语、定语；用于处事"},{"id":22492,"word":"摈欲绝缘","pinyin":"bìn yù jué yuán","abbr":"byjy","explanation":"摈：抛弃。抛开一切欲望与断绝一切俗缘","source":{"text":"至于根本之学，还在明心见性，摈欲绝缘，此是神仙立命之源。","book":"清·无垢道人《八仙全传》第20回"},"usage":"作宾语、定语；用于书面语"},{"id":22493,"word":"摈诸门外","pinyin":"bìn zhū mén wài","abbr":"bzmw","explanation":"排斥在门外，不与之同流","example":{"text":"不是我们存心要把你～"},"usage":"作谓语、定语；用于书面语"},{"id":22494,"word":"摊书傲百城","pinyin":"tān shū ào bǎi chéng","abbr":"tsabc","explanation":"比喻藏书之富或嗜书之深。","source":{"text":"北魏李谧博览群书，无意做官，将家产都花在收罗书籍上。经他细加审订的书有四千卷之多。他有句名言：“丈夫拥书万卷，何假南面百城！”意即只要有万卷书，又何必做管辖百城的官。事见《魏书·李谧传》。"}},{"id":22495,"word":"摊书拥百城","pinyin":"tān shū yōng bǎi chéng","abbr":"tsybc","explanation":"比喻藏书之富或嗜书之深。同“摊书傲百城”。"},{"id":22496,"word":"摔丧驾灵","pinyin":"shuāi sāng jià líng","abbr":"ssjl","explanation":"摔丧：指摔丧盆子或摔丧罐子，旧时的丧礼；驾灵：主丧的孝子在灵柩前领路。指亲丧时，当孝子的礼节。","source":{"text":"又有小丫环名宝珠的，因秦氏无出，乃愿为义女，请任摔前驾灵之任。","book":"清·曹雪芹《红楼梦》第十三回"}},{"id":22497,"word":"摘句寻章","pinyin":"zhāi jù xún zhāng","abbr":"zjxz","explanation":"摘取、搜寻文章的片断词句。指读书局限于文字的推求。","source":{"text":"论文时芸窗下摘句寻章，论武时柳营内调丝弄竹。","book":"元·汤式《一枝花·赠人》套曲"},"example":{"text":"老夫少年虽曾～，推敲一道，从未谙之，这些壁间之作都是小女代为，不过初学涂鸦，有何好处。","book":"清·烟霞散人《凤凰池》第四回"},"similar":["寻章摘句"],"usage":"作谓语、宾语、定语；指抄袭"},{"id":22498,"word":"摘句搜章","pinyin":"zhāi jù sōu zhāng","abbr":"zjsz","explanation":"摘：选取；搜：寻求。指抄袭他人文章的词句。","source":{"text":"虽有余闲，博览书传历史，藉采奇异，不效诸生寻章摘句而已。","book":"《三国志·吴书·孙权传》：“遣都尉赵咨使魏。”裴松之注引《吴书》"},"example":{"text":"～终底用，求田问舍梅全迟。","book":"宋·洪刍《洪老圃集·始年四十》"}},{"id":22499,"word":"摘埴索涂","pinyin":"zhāi zhí suǒ tú","abbr":"zzst","explanation":"盲人以杖点地，探索道路。比喻盲目的行为。","source":{"text":"凡舟车之运转流行，道里之险易涩滑，岩墙之必压，坎陷之至凶，摘埴索涂，都忘趋避。","book":"严复《救亡决论》"},"example":{"text":"夸词以为美，嚣听而无所终，～，不获则反覆其词而自惑。","book":"孙中山 《民报》发刊词"},"similar":["擿埴索涂","擿植索涂"],"usage":"作宾语、定语；用于书面语"},{"id":22500,"word":"摘奸发伏","pinyin":"tī jiān fā fú","abbr":"zjff","explanation":"摘：通“擿”，揭发；发伏：检举；伏：隐藏。揭发检举隐藏的坏人坏事。","source":{"text":"真摘奸发伏如神，皆此类也。","book":"汉·荀悦《汉纪·宣帝纪》"},"example":{"text":"上乃奖永檀～，直陈无隐，擢佥都御史。","book":"《清史稿·仲永檀传》"},"similar":["擿奸发伏"],"usage":"作谓语、定语；用于书面语"}]
