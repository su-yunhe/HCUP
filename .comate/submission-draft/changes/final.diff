@@ -0,0 +1 @@
+[{"id":10001,"word":"卖空买空","pinyin":"mài kōng mǎi kōng","abbr":"mkmk","explanation":"买卖双方都没有货、款进出，只就到期的进出之间的差价结算盈亏。比喻投机倒把的行为。","source":{"text":"沪市卖空买空，昔年每元已涨过八钱。","book":"清·郑观应《盛世危言·铸银》"},"example":{"text":"～的风险很大，得慎重考虑。"},"similar":["买空卖空","投机取巧"],"opposite":["童叟无欺"],"usage":"作谓语、宾语、定语；指投机行为"},{"id":10002,"word":"卖笑生涯","pinyin":"mài xiào shēng yá","abbr":"mxsy","explanation":"生涯：生活。指妓女以出卖笑脸为业。","source":{"text":"倘使她实在是做卖笑生涯的，就并不是谩骂，倒是说了真实。","book":"鲁迅《谩骂》"},"usage":"作主语、宾语、定语；用于妓女等"},{"id":10003,"word":"卖笑追欢","pinyin":"mài xiào zhuī huān","abbr":"mxzh","explanation":"指娼妓取媚于人的营生。","source":{"text":"再不去卖笑追欢风月馆，再不去迎新送旧翠红乡。","book":"元·李行道《灰阑记》第一折"},"example":{"text":"～的行当应当加以限制。"},"opposite":["买笑追欢"],"usage":"作谓语、定语；指娼妓"},{"id":10004,"word":"卖身投靠","pinyin":"mài shēn tóu kào","abbr":"mstk","explanation":"出卖自己，投靠有权势的人。比喻丧失人格，甘心充当恶势力的工具。","source":{"text":"我见这富家儿的鹰犬，更深知明季的向权门卖身投靠之辈是怎样的阴险了。","book":"鲁迅《后记》"},"example":{"text":"本族人中许多奸恶分子～。凭借外族势力以求升官发财。","book":"蒲韧《二千年间·七》"},"similar":["卖国求荣","趋炎附势","卑躬屈膝"],"opposite":["精忠报国","坚贞不屈","赤胆忠心"],"usage":"作谓语、定语；指投靠有权势的人"},{"id":10005,"word":"南人驾船，北人乘马","pinyin":"nán rén jià chuán，běi rén chéng mǎ","abbr":"nrjcbrcm","explanation":"南方的人擅长驾船，北方的人擅长骑马。","source":{"text":"胡人便于马，越人便于舟。","book":"《淮南子·齐俗训》"},"example":{"text":"～，信有之也。","book":"明·罗贯中《三国演义》第五十四回"},"similar":["南船北马"],"usage":"作宾语、定语；用于书面语"},{"id":10006,"word":"南冠楚囚","pinyin":"nán guān chǔ qiú","abbr":"ngcq","explanation":"南冠：楚国在南方，因此称楚冠为南冠。本指被俘的楚国囚犯。后泛称囚犯或战俘。","source":{"text":"晋侯观于军府，见钟仪，问之曰：‘南冠而絷者，谁也？’有司对曰：‘郑人所献楚囚也。’使税之，召而吊之。再拜稽首。","book":"《左传·成公九年》"},"example":{"text":"鲈鱼正美不归去，空戴南冠学楚囚。","book":"唐·赵嘏《长安秋夕》诗"},"usage":"作宾语；泛指囚犯或战俘","story":["公元前584年，楚共王兴兵伐郑国，晋景公出兵援郑，大败楚军。楚官员钟仪被俘，囚禁在军需库中，他每天戴着楚国的帽子面南而站，思念自己的祖国。两年后，晋景公发现了他，请他弹琴，并亲自释放他回楚国，让他为两国和平出力"]},{"id":10007,"word":"南北东西","pinyin":"nán běi dōng xī","abbr":"nbdx","explanation":"指四方、到处、各地或方向；也指到处飘泊，行踪不定。","source":{"text":"惟知仓惶奔走；马听轰天之炮，难分南北东西。","book":"明·许仲琳《封神演义》第二回"},"example":{"text":"初来乍到，我人地两生，分不清～。"},"similar":["东西南北"],"usage":"作主语、宾语、定语；指方向"},{"id":10008,"word":"南去北来","pinyin":"nán qù běi lái","abbr":"nqbl","explanation":"指来来往往。","source":{"text":"南去北来人自老，夕阳长送钓船归。","book":"唐·杜牧《汉江》"},"example":{"text":"杏花杨柳年年好，～人自老。","book":"宋·王安石《送吴显道》"},"similar":["南来北往"],"usage":"作定语、状语；指来来往往"},{"id":10009,"word":"南山之寿","pinyin":"nán shān zhī shòu","abbr":"nszs","explanation":"南山：终南山。寿命像终南山那样长久。","source":{"text":"如南山之寿，不骞不崩。","book":"《诗经·小雅·天保》"},"example":{"text":"莫遣朝衣梅醭了，留祝～。","book":"宋·刘克庄《念奴娇》词"},"similar":["寿比南山"],"usage":"作宾语；用于祝寿"},{"id":10010,"word":"南山可移","pinyin":"nán shān kě yí","abbr":"nsky","explanation":"南山：终南山。比喻已经定案，不可更改。","source":{"text":"南山或可改移，此判终无摇动。","book":"《旧唐书·李元纮传》"},"example":{"text":"终以为～，此案不动。","book":"清·纪昀《阅微草堂笔记》卷三"},"similar":["南山铁案"],"usage":"作宾语；指事物不可更改","story":["唐睿宗时，太平公主蛮横无礼，大肆侵吞百姓的财产。一次她的手下到农民家抢走碾石，农民告上雍州官府，司户李元纮判交还碾石。李的上司窦怀贞害怕得罪了太平公主，亲自要李元纮改判。李元纮气愤地告诉他南山可移、判不可动摇"]},{"id":10011,"word":"南山可移，判不可摇","pinyin":"nán shān kě yí，pàn bù kě yáo","abbr":"nskypbky","explanation":"南山：终南山；判：裁决；摇：动摇。终南山可以移动，但已定下的案子决不能更改。","source":{"text":"南山可移，判不可摇也。","book":"《旧唐书·李元纮传》"},"example":{"text":"做法官要有～的精神。"},"similar":["南山可移，此案不动"],"usage":"作宾语、定语、分句；指已经定案","story":["唐睿宗时，太平公主蛮横无礼，大肆侵吞百姓的财产。一次她的手下到农民家抢走碾石，农民告上雍州官府，司户李元纮判交还碾石。李的上司窦怀贞害怕得罪了太平公主，亲自要李元纮改判。李元纮气愤地告诉他南山可移、判不可动摇"]},{"id":10012,"word":"南山可移，此案不动","pinyin":"nán shān kě yí，cǐ àn bù dòng","abbr":"nskycabd","explanation":"南山：终南山；动：动摇。终南山可以移动，但已定下的案子决不能更改。","source":{"text":"终以为南山可移，此案不动。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"similar":["南山可移，判不可摇"],"usage":"作宾语、定语、分句；指已经定案"},{"id":10013,"word":"南山有鸟，北山张罗","pinyin":"nán shān yǒu niǎo，běi shān zhāng luó","abbr":"nsynbszl","explanation":"鸟儿在南山，却到北山去张网捕捉。比喻方法不对，无法达到目的。","example":{"text":"我们不能干～的事情。"},"similar":["南辕北辙","北辕适楚"],"usage":"作分句、定语；指方法不对头","story":["春秋时期，吴王夫差的女儿紫玉爱上有才华的平民韩重。韩重将祖传的紫玉送给紫玉姑娘。夫差发现此事，将前来王宫求婚的韩重父母赶跑，逼紫玉嫁给一个贵族。紫玉气死，韩重到紫玉的墓前。紫玉的灵魂唱道：南山有鸟，北山张罗"]},{"id":10014,"word":"南山铁案","pinyin":"nán shān tiě àn","abbr":"nsta","explanation":"指已经判定、不可改变的案件。","source":{"text":"元纮早修谨，仕为雍州司户参军。时太平公主势震天下，百司顺望风指，尝与民竞碾硙，元纮还之民。长史窦怀贞大惊，趣改之，元纮大署判后曰：‘南山可移，判不可摇也。’","book":"典出《新唐书·李元纮传》"},"example":{"text":"前之所断，不愧～，盖其情实可诛，则虽死而无怨也。","book":"清·薛福成《庸庵笔记·轶闻·谳狱引律同而不同》"},"similar":["南山可移，判不可摇"],"usage":"作宾语、主语、定语；用于案件"},{"id":10015,"word":"南山隐豹","pinyin":"nán shān yǐn bào","abbr":"nsyb","explanation":"比喻隐居山林而不仕的贤者。","source":{"text":"妾闻南山有玄豹，雾雨七日而不下食者何也？","book":"《列女传·贤明·陶答子妻》"},"example":{"text":"我们要学～的气度。"},"usage":"作宾语、定语；指隐士","story":["春秋时期，宋国陶邑大夫答子任职三年，捞了不少钱财，就回到家中躲藏，他的妻子哭劝丈夫要学南山隐豹碰到大雨和大雾天，为了保护自己的皮毛可以七天不觅食。答子根本不理睬，后来遭人告发，宋王下令处死答子"]},{"id":10016,"word":"南州冠冕","pinyin":"nán zhōu guān miǎn","abbr":"nzgm","explanation":"南方人才中杰出的人。指才识出众的人。","source":{"text":"徽甚异之，称统当为南州士之冠冕。","book":"《三国志·蜀书·庞统传》"},"example":{"text":"～，德操称庞统之迈众；三河领袖，崔浩羡裴骏之超群。","book":"清·程允升《幼学琼林·身体》"},"usage":"作宾语、定语；指才识出众的人","story":["三国时期，襄阳地区大名士庞德公的侄儿庞统很有才学。庞德公介绍他去好友司马徽那里。司马徽发现这个18岁的青年是无所不知、无所不晓，见解也相当独特，不落俗套，称赞他是南方士人中的第一人。庞统后来成为刘备的重要谋士"]},{"id":10017,"word":"南征北伐","pinyin":"nán zhēng běi fá","abbr":"nzbf","explanation":"形容转战南北，经历了许多战斗。亦作“南征北讨”。亦作“南征北战”。","source":{"text":"历于宣王，挟中兴复古之德，雄南征北伐之威，卒不能定鲁侯之嗣。","book":"唐·柳宗元《封建论》"},"example":{"text":"李世民经过许多～终于登上王位。"},"similar":["南征北战"],"opposite":["安居乐业"],"usage":"作谓语、定语、宾语；用于经历的战争","story":["公元前828年，周厉王的儿子靖即位成为周宣王，他决心恢复周王朝的强盛，废除田籍制度，进行一些改革，还出兵攻伐北方的淮夷、徐戎和南方的蛮荆等部族，国势再度强盛起来，号称中兴之主。他破例立戏为鲁武公的继承人，让鲁国内乱"]},{"id":10018,"word":"南征北剿","pinyin":"nán zhēng běi jiǎo","abbr":"nzbj","explanation":"征：征伐；剿：征剿。形容转战南北，经历了许多战斗。","source":{"text":"历于宣王，挟中兴复古之德，雄南征北伐之威，卒不能定鲁侯之嗣。","book":"唐·陈子昂《为金吾将军陈令英请免官表》：“西踰流沙，东绝沧海，南征北伐，无所不至。”唐·柳宗元《封建论》"},"example":{"text":"不过我们还是东奔西走，～，决不偷懒。","book":"鲁迅《伪自由书·王化》"},"similar":["南征北讨"],"usage":"作谓语、定语、宾语；用于经历的战争"},{"id":10019,"word":"南征北战","pinyin":"nán zhēng běi zhàn","abbr":"nzbz","explanation":"形容转战南北，经历了许多战斗。","source":{"text":"历于宣王，挟中兴复古之德，雄南征北伐之威，卒不能定鲁侯之嗣。","book":"唐·柳宗元《封建论》"},"example":{"text":"老子出生入死，～，打了十几年天下，凭什么快到手中的果子让给别人吃？","book":"姚雪垠《李自成》第二卷第二十七章"},"similar":["身经百战","出生入死"],"opposite":["安营扎寨","安家落户","纸上谈兵"],"usage":"作谓语、定语；用于经历的战争","story":["公元前828年，周厉王的儿子靖即位成为周宣王，他决心恢复周王朝的强盛，废除田籍制度，进行一些改革，还出兵攻伐北方的淮夷、徐戎和南方的蛮荆等部族，国势再度强盛起来，号称中兴之主。他破例立戏为鲁武公的继承人，让鲁国内乱"]},{"id":10020,"word":"南征北战，东荡西杀","pinyin":"nán zhēng běi zhàn，dōng dàng xī shā","abbr":"nzbzddxs","explanation":"征：征战；荡：扫荡。形容转战南北，奋勇杀敌。","source":{"text":"父王的江山，是他郭家父子南征北战，东荡西杀，十大汗马功劳争来的。","book":"晋剧《打金枝》第二场"},"usage":"作谓语、定语、宾语；用于处事"},{"id":10021,"word":"南征北讨","pinyin":"nán zhēng běi tǎo","abbr":"nzbt","explanation":"形容转战南北，经历过多次战斗。","source":{"text":"想老夫幼年时，南征北讨，东荡西除，到今日都做了一场春梦也。","book":"元·朱凯《昊天塔》第一折"},"example":{"text":"昔日魏武祖皇帝，东荡西除，～，非容易得此天下。","book":"明·罗贯中《三国演义》第一百十九回"},"similar":["南征北伐","南征北战"],"usage":"作谓语、定语、宾语；用于经历的战争"},{"id":10022,"word":"南户窥郎","pinyin":"nán hù kuī láng","abbr":"nhkl","explanation":"称女子偷看男子。","source":{"text":"昭信谓去（刘越孙刘去）曰：‘前画工画望卿舍，望卿袒裼傅粉其傍。又数出入南户窥郎吏，疑有奸。’","book":"《汉书·广川惠王刘越传》"},"example":{"text":"正是腰才胜露，未曾～；年已破瓜，岂向西园待客。","book":"明·陈汝先《金莲记·弹丝》"},"usage":"作谓语、宾语；用于书面语"},{"id":10023,"word":"南方之强","pinyin":"nán fāng zhī qiáng","abbr":"nfzq","explanation":"南方坚强刚毅之人。","source":{"text":"南方之强与？北方之强与？抑而强与？","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"最后投降……是矢尽援绝，这才罢战的～。","book":"鲁迅《北人与南人》"},"usage":"作宾语；用于书面语"},{"id":10024,"word":"南来北去","pinyin":"nán lái běi qù","abbr":"nlbq","explanation":"泛指来来往往。","source":{"text":"南来北去二三年，年去年来两鬓斑。","book":"唐·杜荀鹤《秋宿临江驿》"},"example":{"text":"田园有计归须早，在家纵贫亦好，～何日了。光阴送尽，可怜青鬓，暗逐流年老。","book":"宋·曹组《青玉案》词"},"similar":["南来北往","南去北来"],"usage":"作定语、分句；指来来往往"},{"id":10025,"word":"南来北往","pinyin":"nán lái běi wǎng","abbr":"nlbw","explanation":"有的从南往北，有的从北往南。也泛指来来往往。","source":{"text":"南来北往，何忧带水拖泥；朝去暮来，不到撞头磕脑。","book":"宋·叶适《修路疏》"},"example":{"text":"所以这镇上就开了不少店铺，招徕着那些～的人们。","book":"峻青《海啸》第三章"},"similar":["来来往往","南去北来"],"usage":"作定语、分句；指来来往往"},{"id":10026,"word":"南枝北枝","pinyin":"nán zhī běi zhī","abbr":"nzbz","explanation":"南枝向暖，北枝受寒。比喻彼此处境的苦乐不同。","source":{"text":"可怜鹧鸪飞，飞向树南枝。南枝日照暖，北枝霜露滋。","book":"唐·李峤《鹧鸪》诗"},"example":{"text":"梅花忽露太极心，～开一遍。","book":"元·杨维桢《秀州相士歌》"},"usage":"作宾语、定语；比喻处境的苦乐不同"},{"id":10027,"word":"南柯一梦","pinyin":"nán kē yī mèng","abbr":"nkym","explanation":"形容一场大梦，或比喻一场空欢喜。","source":{"text":"唐·李公佐《南柯太守传》"},"example":{"text":"看荣华眨眼般疾，更疾如南柯一梦。","book":"元·郑廷玉《金凤钗》楔子"},"similar":["黄粱美梦"],"opposite":["梦想成真"],"usage":"作宾语、定语；指虚幻的梦境","story":["传说唐朝东平郡“游侠之士”淳于棼在他家南面的古老大槐树下睡了一觉，在梦中他成了槐安国的南柯太守，国王把他美貌的小公主嫁给他，他为官20年，生活十分幸福。后来因檀罗国进攻南柯郡，他防守不力被国王逐出了槐安国"]},{"id":10028,"word":"南棹北辕","pinyin":"nán zhào běi yuán","abbr":"nzby","explanation":"犹南航北骑。形容乘舟骑马，南北奔走。"},{"id":10029,"word":"南橘北枳","pinyin":"nán jú běi zhǐ","abbr":"njbz","explanation":"枳：落叶灌木，果实味苦酸，球形。古人认为南方之橘移植到淮河之北就会变成枳。后用来比喻同一物种因环境条件不同而发生变异。","source":{"text":"橘生淮南则为橘，生于淮北则为枳，叶徒相似，其实味不同。所以然者何？水土异也。","book":"《晏子春秋·内篇杂下》"},"example":{"text":"名谓～，便分两等，乃风俗之不等也。","book":"明·冯梦龙《喻世明言》卷二十五"},"usage":"作宾语、定语；用于比喻句"},{"id":10030,"word":"南箕北斗","pinyin":"nán jī běi dǒu","abbr":"njbd","explanation":"箕：星宿名，形状象簸箕；斗：星宿名，形状象酒斗。比喻徒有虚名而无实用。","source":{"text":"维南有箕，不可以簸扬；维北有斗，不可以挹酒浆。","book":"《诗经·小雅·大东》"},"example":{"text":"今国子虽有学官之名，而无教授之实，何异兔丝燕麦，～哉！","book":"《北史·邢邵传》"},"similar":["有名无实"],"usage":"作定语；指有名无实"},{"id":10031,"word":"南腔北调","pinyin":"nán qiāng běi diào","abbr":"nqbd","explanation":"原指戏曲的南北腔调。现形容说话口音不纯，搀杂着方言。","source":{"text":"每数十步间一戏台，南腔北调，备四方之乐。","book":"清·赵翼《檐曝杂记》卷一"},"example":{"text":"这个说话～的人，不适合当解说员。"},"similar":["北调南腔"],"opposite":["字正腔圆"],"usage":"作谓语、定语；形容口音不纯"},{"id":10032,"word":"南舣北驾","pinyin":"nán yǐ běi jià","abbr":"nybj","explanation":"犹南航北骑。形容乘舟骑马，南北奔走。"},{"id":10033,"word":"南航北骑","pinyin":"nán háng běi qí","abbr":"nhbq","explanation":"形容乘舟骑马，南北奔走。","source":{"text":"胡人便于马，越人便于舟。","book":"语出《淮南子·齐俗训》"},"example":{"text":"及西畹，应宾贡游两都，～，孺人与有勤焉，于是乎益瘁。","book":"明·吴承恩《寿胡内子张儒人六帙序》"},"similar":["南人驾船，北人乘马"],"usage":"作宾语、定语；用于书面语"},{"id":10034,"word":"南船北车","pinyin":"nán chuán běi chē","abbr":"ncbc","explanation":"比喻行踪不定。","source":{"text":"但恐宦海萍踪，南船北车，又在不定耳。","book":"清·李绿园《歧路灯》第九十六回"},"usage":"作宾语、定语；指人的行踪"},{"id":10035,"word":"南船北马","pinyin":"nán chuán běi mǎ","abbr":"ncbm","explanation":"南方人善于驾船，北方人善于骑马。指各人均有所长。","source":{"text":"北骑达山岳，南帆指江湖。","book":"唐·孟郊《送从最校书简南归》"},"similar":["南人驾船，北人乘马"],"usage":"作宾语、定语；用于书面语"},{"id":10036,"word":"南蛮鴂舌","pinyin":"nán mán xiāng shé","abbr":"nmjs","explanation":"旧时讥人操难懂的南方方言。鴂，伯劳鸟。"},{"id":10037,"word":"南蛮鴃舌","pinyin":"nán mán jué shé","abbr":"nmjs","explanation":"鴃：即伯劳。原为孟子讥讽楚人许行说话如鸟语。后用以讥笑操南方方言的人。","source":{"text":"今也南蛮鴃舌之人，非先王之道。","book":"《孟子·滕文公上》"},"example":{"text":"彼时江以南，为～之乡。","book":"清·采蘅子《虫鸣漫录》"},"usage":"作宾语、定语；用于讥笑南方的语言"},{"id":10038,"word":"南货斋果","pinyin":"nán huò zhāi guǒ","abbr":"nhzg","explanation":"南货：指闽粤一带产的食品；斋果：上供的果品。南方产的食品和上供用的供品。借指食物。","source":{"text":"尚书右仆高隆之，求南货于昕、收。","book":"《北史·魏收传》"},"example":{"text":"此外各地的小禁令还很多，如醴陵禁傩神游香，禁买～送情，禁中元烧衣包，禁新春贴瑞签。","book":"毛泽东《湖南农民运动考究考察报告》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":10039,"word":"南贩北贾","pinyin":"nán fàn běi gǔ","abbr":"nfbg","explanation":"为了谋生而到处奔走。","source":{"text":"南贩北贾，与怨为市，利得自治。","book":"汉·焦延寿《易林》卷八"},"usage":"作主语、宾语、定语；指谋生"},{"id":10040,"word":"南辕北辙","pinyin":"nán yuán běi zhé","abbr":"nybz","explanation":"想往南而车子却向北行。比喻行动和目的正好相反。","source":{"text":"犹至楚而北行也。","book":"《战国策·魏策四》"},"example":{"text":"你想这六条要求，与中央开出的六条款约，简直是～，相差甚远，有甚么和议可言。","book":"蔡东藩、许廑父《民国通俗演义》第六十八回"},"similar":["背道而驰"],"opposite":["有的放矢"],"usage":"作宾语、定语；指行动和目的正好相反","story":["战国时期，魏安王决定攻打赵国都城邯郸，大臣们都反对他，季梁给他讲一个故事：太行山的一个人驾车准备到楚国去，但他却坚持往北走，这样越走越远。争霸不是靠打仗，而是靠赢得民心，靠打仗就像南辕北辙一样。魏安王决定不打仗了"]},{"id":10041,"word":"南郭先生","pinyin":"nán guō xiān shēng","abbr":"ngxs","explanation":"比喻无才而占据其位的人。","source":{"text":"推贤之风不立，滥举之法不改，则南郭先生之徒盈于朝矣。","book":"《晋书·刘寔传》"},"example":{"text":"我们不能学～那样滥竽充数。"},"similar":["南郭处士"],"opposite":["北郭先生"],"usage":"作主语、宾语；指滥竽充数的人","story":["战国时期，齐国的国王非常喜欢听吹竽合奏，好吃懒做的南郭先生想办法混进了乐队，他不懂装懂、摇头晃脑，装出一幅行家的样子。不久老国王死后，新国王喜欢听吹竽独奏，南郭先生这下心虚了，害怕会露馅就连夜逃出了皇宫"]},{"id":10042,"word":"南郭处士","pinyin":"nán guō chǔ shì","abbr":"ngcs","explanation":"比喻无真正的才干而混在行家里面充数的人。同“滥竽充数”。","source":{"text":"南郭处士请为王吹竽，宣王说之。","book":"战国·韩·韩非《韩非子·内诸说上》"},"example":{"text":"我们不能学～的做法。"},"similar":["南郭先生"],"usage":"作宾语、定语；指滥竽充数的人","story":["战国时期，齐国的国王非常喜欢听吹竽合奏，好吃懒做的南郭先生想办法混进了乐队，他不懂装懂、摇头晃脑，装出一幅行家的样子。不久老国王死后，新国王喜欢听吹竽独奏，南郭先生这下心虚了，害怕会露馅就连夜逃出了皇宫"]},{"id":10043,"word":"南金东箭","pinyin":"nán jīn dōng jiàn","abbr":"njdj","explanation":"南方的金石，东方的竹箭。比喻优秀的人才。","source":{"text":"东南之美者，有会稽之竹箭焉；……西南之美者，有华山之金石焉。","book":"《尔雅·释地》"},"example":{"text":"顾、纪、贺、薛等并～，世胄高门。","book":"《晋书·顾荣纪瞻贺循薛兼传》"},"usage":"作宾语；指杰出的人才"},{"id":10044,"word":"南阮北阮","pinyin":"nán ruǎn běi ruǎn","abbr":"nrbr","explanation":"指聚居一处而贫富各殊的同族人家。","source":{"text":"阮仲容、步兵居道南，诸阮居道北，北阮富，南阮贫。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"闭门茅底偶为邻，北阮那怜南阮贫。","book":"唐·戴淑伦《旅次寄湖南张郎中》诗"},"usage":"作宾语、定语；指同族人","story":["魏晋时期，“竹林七贤”的阮籍与侄子阮咸两人住在家乡的路南，其他阮性的人住在路北，路南的人非常贫穷。按照当地的风俗，每年的七月七日都要曝晒衣服，阮咸也未能免俗，只拿出几条粗布短裤挂在竹竿上晒"]},{"id":10045,"word":"南阳三葛","pinyin":"nán yáng sān gě","abbr":"nysg","explanation":"三葛：指诸葛亮、讲葛瑾、讲葛诞三兄弟，他们三人都很有才能。比喻很有才能的人。","source":{"text":"讲葛瑾弟亮及从弟诞，并有盛名，各在一国，于是以为蜀得其龙，吴得其虎，魏得其狗。","book":"南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"但～，君得其龙，区区者又何足道。","book":"清·蒲松龄《聊斋志异·凤仙》"}},{"id":10046,"word":"南面之尊","pinyin":"nán miàn zhī zūn","abbr":"nmzz","explanation":"指王侯之位。","source":{"text":"桀藉累世之姿，居南面之尊。","book":"《列子·杨朱》"},"example":{"text":"神全气厚，脉秀络清。必居～，自有非常富贵。","book":"清·陈忱《水浒后传》第十三回"}},{"id":10047,"word":"南面王乐","pinyin":"nán miàn wáng lè","abbr":"nmwl","explanation":"指面向南称王称侯，享受王侯之乐。","source":{"text":"吾安能弃南面王乐而复为人间之劳乎？","book":"《庄子·至乐》"},"example":{"text":"卢柟日夕吟花课鸟，笑傲其间，虽～，亦不是过。","book":"明·冯梦龙《醒世恒言》卷二十九"}},{"id":10048,"word":"南面百城","pinyin":"nán miàn bǎi chéng","abbr":"nmbc","explanation":"南面：面朝南坐着，指居尊位；百城：上百座城。旧时比喻尊贵富有。也比喻藏书很多。","source":{"text":"丈夫拥万卷，何假南面百城。","book":"《魏书·李谧传》"},"example":{"text":"填词之乐，上天入地，作佛成仙，无一不随意到，较之～，洵有过焉者矣。","book":"清·李渔《闲情偶寄·音律第三》"},"usage":"作宾语；比喻统治者的尊贵富有"},{"id":10049,"word":"南面称孤","pinyin":"nán miàn chēng gū","abbr":"nmcg","explanation":"南面：面朝南；孤：皇帝、王侯的谦称。朝南坐着，自称孤家。指统治一方，称帝称王。","source":{"text":"凡人有此一德者，足以南面称孤矣。","book":"《庄子·盗跖》"},"example":{"text":"将军降曹，欲安所归呼？位不过封侯，车不过一乘，骑不过一匹，从不过数人，岂得～哉！","book":"明·罗贯中《三国演义》第四十三回"},"similar":["南面称王","南面称尊"],"usage":"作谓语、定语、宾语；指称帝"},{"id":10050,"word":"南面称尊","pinyin":"nán miàn chēng zūn","abbr":"nmcz","explanation":"指称王称帝。","source":{"text":"如今南面称尊，便撇在三限里不瞅间。","book":"元·尚仲贤《三夺槊》第三折"},"example":{"text":"不知国家大义，徒以～，自取灭亡。","book":"清·黄小配《洪秀全演义》第十二回"},"similar":["南面称王","南面称孤"],"usage":"作谓语、定语、宾语；指称帝"},{"id":10051,"word":"南面称王","pinyin":"nán miàn chēng wáng","abbr":"nmcw","explanation":"南面：古代帝王临朝坐北朝南。指称王称帝。","source":{"text":"信能右折燕齐，左振扶桑，凌轹沙漠，南面称王。","book":"《文选·孙楚》"},"similar":["南面称孤","南面称尊"],"usage":"作谓语、定语、宾语；指称帝"},{"id":10052,"word":"南风不竞","pinyin":"nán fēng bù jìng","abbr":"nfbj","explanation":"南风：南方的音乐；不竞：指乐音微弱。原指楚军战不能胜。后比喻竞赛的对手力量不强。","source":{"text":"不害，吾骤歌北风，又歌南风。南风不竞，多死声，楚必无功。","book":"《左传·襄公十八年》"},"example":{"text":"不料近十年国威扫地，～，中原成游牧之场。","book":"清·觉佛《女英雄》"},"usage":"作补语、定语；比喻竞赛的一方失利","story":["春秋时期，音乐家师旷劝晋悼公姬周施行仁政，晋悼公十分喜欢他的音乐。晋平公姬彪时，师旷的演奏技艺可以呼风唤雨。齐灵公吕环侵略鲁国，晋平公应鲁国的请求援救，齐国向楚军求救。师旷随军奏乐，使得楚军南风不竞，落荒而逃"]},{"id":10053,"word":"南鹞北鹰","pinyin":"nán yào běi yīng","abbr":"nyby","explanation":"鹞、鹰：两种猛禽。在南为鹞子，在北为老鹰。比喻性格严峻的人。","source":{"text":"丛生棘刺，来自博陵，在南为鹞，在北为鹰。","book":"《晋书·崔洪传》"},"usage":"作宾语、定语；指性格刚直严峻的人","story":["晋武帝时期，御史大夫崔洪为人刚正不阿，清正廉洁，他以敢于直言为著称，曾经多次直言进谏晋武帝，受到武帝的重用。朝中很多大臣都十分怕他，评论他是：“丛生棘刺，来自博陵，在南为鹞，在北为鹰。”"]},{"id":10054,"word":"博关经典","pinyin":"bó guān jīng diǎn","abbr":"bgjd","explanation":"博：广博；关：涉猎。广泛涉猎经典。形容知识广博。","source":{"text":"博士取博关经典，世履忠清，堪以为师者，年限四十以上。","book":"《魏书·高充传》"}},{"id":10055,"word":"博古知今","pinyin":"bó gǔ zhī jīn","abbr":"bgzj","explanation":"形容知识丰富。同“博古通今”。","source":{"text":"形容知识丰富。同“博古通今”。"},"similar":["博古通今"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；用于称颂人"},{"id":10056,"word":"博古通今","pinyin":"bó gǔ tōng jīn","abbr":"bgtj","explanation":"通：通晓；博：广博，知道得多。对古代的事知道得很多，并且通晓现代的事情。形容知识丰富。","source":{"text":"吾闻老聃博古知今。","book":"《孔子家语·观周》"},"example":{"text":"你向有才女之名，最是～。","book":"清·李汝珍《镜花缘》第五回"},"similar":["满腹经纶","真才实学","见多识广"],"opposite":["不学无术","寡见少闻","孤陋寡闻"],"usage":"作谓语、定语；用于称颂人"},{"id":10057,"word":"博士买驴","pinyin":"bó shì mǎi lǘ","abbr":"bsml","explanation":"博士：古时官名。博士买了一头驴子，写了三纸契约，没有一个“驴”字。讥讽写文章长篇累牍而说不到点子上。","source":{"text":"问一言辄酬数百，责其指归，或无要会。邺下谚云：‘博士买驴，书券三纸，未有驴字。’","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"写文章不能学～，不得要领。"},"similar":["不得要领"],"opposite":["言简意赅"],"usage":"作谓语；补语；形容文字表达不得要领","story":["从前有一个自以为是的文人被人戏称为博士，他上街买了一头驴子，按当时的习惯，买家要给卖家写一份合同。博士铺开白纸，下笔千言，足足写了三大张跟驴无关的废话。卖驴人等得不耐烦就催他快点，他忙说不急还没写到“驴”字"]},{"id":10058,"word":"博大精深","pinyin":"bó dà jīng shēn","abbr":"bdjs","explanation":"博：广，多。形容思想和学识广博高深。","source":{"text":"迄今读书，若揭日月而行千载，其博大精深之旨，非晚世学者所及。","book":"明·姜世昌《〈逸周书〉序》"},"example":{"text":"瑚之为学，～，以经世自任。","book":"《清史稿·陆世仪传》"},"similar":["博学多才","经天纬地"],"opposite":["才疏学浅","不学无术"],"usage":"作谓语、定语；用于人的思想与知识等"},{"id":10059,"word":"博学多才","pinyin":"bó xué duō cái","abbr":"bxdc","explanation":"学识广博，有多方面的才能。","source":{"text":"诜博学多才，环伟倜傥，不拘细行，州郡礼命并不应。","book":"《晋书·郤诜传》"},"example":{"text":"贯忠～，也好武艺，有肝胆。","book":"明·施耐庵《水浒全传》第九十一回"},"similar":["博学多闻","博古通今"],"opposite":["胸无点墨","才疏学浅","不学无术"],"usage":"作谓语、定语；用于赞扬别人"},{"id":10060,"word":"博学多识","pinyin":"bó xué duō shí","abbr":"bxds","explanation":"学问广博，见识丰富。","source":{"text":"只是圣人之所以圣，却不在博学多识，而在一以贯之。","book":"宋·朱熹《朱子语类·论语》第45卷"},"example":{"text":"章诒和《往事并不如烟·斯人寂寞》：“这个清华国学研究院毕业的包先生，～，通文史，精诗词，尤擅对联。”"},"similar":["博学多才","见多识广"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；用于赞扬别人"},{"id":10061,"word":"博学多闻","pinyin":"bó xué duō wén","abbr":"bxdw","explanation":"博学：广博。学识广博，见闻丰富。","source":{"text":"多闻曰博。","book":"《礼记·中庸》：“博学之，审问之，慎思之，明辨之，笃行之。”《荀子·修身》"},"example":{"text":"～，性气英迈，幅巾布裘，游于东西两浙间。","book":"明·瞿佑《剪灯新话·修文舍人传》"},"similar":["见多识广","博学多才"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；指人见识多"},{"id":10062,"word":"博学宏才","pinyin":"bó xué hóng cái","abbr":"bxhc","explanation":"博：广博；学：学问；宏：广大；才：才能。学识广博，有多方面的才能。","source":{"text":"陛下在内检一个博学宏才的，召他进来，面试一篇，不好再作区处。","book":"清·褚人获《隋唐演义》第36回"},"similar":["博学多才"],"opposite":["才疏学浅"],"usage":"作谓语、定语、宾语；用于赞扬别人"},{"id":10063,"word":"博学审问","pinyin":"bó xué shěn wèn","abbr":"bxsw","explanation":"博：多；审：详细。广泛地学习，详细地询问。指求学时的态度和应循的途径。","source":{"text":"博学之，审问之，慎思之，明辨之，笃行之。","book":"《礼记·中庸》"},"usage":"作谓语、定语；指人的学习态度"},{"id":10064,"word":"博学洽闻","pinyin":"bó xué qià wén","abbr":"bxqw","explanation":"博学：广博。学问广博，见识丰富。","source":{"text":"《晋书·荀顗传》：“性至孝，总角知名，博学洽闻，理思周密。”"},"similar":["博学多闻"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；指人见识多"},{"id":10065,"word":"博学笃志","pinyin":"bó xué dǔ zhì","abbr":"bxdz","explanation":"笃：忠实，一心一意。广泛学习而意志坚定。","source":{"text":"博学而笃志，切问而近思，仁在其中矣。","book":"《论语·子张》"},"usage":"作宾语、定语；用于劝诫人"},{"id":10066,"word":"博带褒衣","pinyin":"bó dài bāo yī","abbr":"bdby","explanation":"博：宽大；褒：阔。宽衣大带。指古代儒生的装束。","source":{"text":"博带褒衣，革履高冠。","book":"《新唐书·刘知畿传》"},"similar":["褒衣博带"],"usage":"作宾语、定语；指古代儒生的装束"},{"id":10067,"word":"博弈犹贤","pinyin":"bō yì yóu xián","abbr":"byyx","explanation":"后指不要饱食终日无所事事。","source":{"text":"子曰：‘饱食终日，无所用心，难矣哉！不有博弈者乎？为之，犹贤乎已。’","book":"语出《论语·阳货》"},"example":{"text":"您怎的连‘～’这句书也不记得。","book":"《儿女英雄传》第三四回"},"opposite":["饱食终日"],"usage":"作宾语、定语；用于劝诫人","story":["春秋时期，孔子经常教育他的学生向颜回学习，不要追慕富贵与享受，用心读书。孔子说如果一个人一天到晚吃得饱饱的没有事可干，不去用心思考问题，那就没有造就了。世上下棋的人虽然悠闲但也要用心，比起那些饱食终日的人来真是强多了"]},{"id":10068,"word":"博文约礼","pinyin":"bó wén yuè lǐ","abbr":"bwyl","explanation":"博：金我，广；约：约束。广求学问，恪守礼法。","source":{"text":"君子博学于文，约之以礼，亦可以弗畔矣夫！","book":"《论语·雍也》"},"example":{"text":"～，讵穷于钻仰也。","book":"清·王闿运《八代文粹序》"},"usage":"作谓语、定语；指虚心向学"},{"id":10069,"word":"博施济众","pinyin":"bó shī jì zhòng","abbr":"bsjz","explanation":"博：广泛；济：救济。给予群众以恩惠和接济。","source":{"text":"如有博施于民而能济众，何如。","book":"《论语·雍也》"},"example":{"text":"就是你老弟，每月印结分的好，也不过几十两银子，还没有到那“～”的时候，我也劝你不必出这冤钱。","book":"《官场现形记》第二十七回"},"similar":["普渡众生"],"usage":"作谓语、定语；形容乐于助人"},{"id":10070,"word":"博洽多闻","pinyin":"bó qià duō wén","abbr":"bqdw","explanation":"洽：广博；闻：见闻。知识丰富，见闻广博。","source":{"text":"林从竦受学，博洽多闻，时称通儒。","book":"《后汉书·杜林传》"},"similar":["博学多闻"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；指人的见闻"},{"id":10071,"word":"博物君子","pinyin":"bó wù jūn zǐ","abbr":"bwjz","explanation":"指博学多识的人。","source":{"text":"蕴椟古今，博物多闻，《三坟》之篇，《五集》之策，无所不览。","book":"《史记·吴太伯世家》：“延陵季子之仁心，慕义无穷，见微而知清浊。呜呼，又何其闳览博物君子也！”《后汉书·周荣传》"},"example":{"text":"然子产既云～，太叔乃为诸侯之选，国之大事，无过丧葬，必是义有吉凶，斯等岂得不用？","book":"《旧唐书·吕才传》"},"usage":"作宾语、定语；用于知识丰富的人"},{"id":10072,"word":"博物多闻","pinyin":"bó wù duō wén","abbr":"bwdw","explanation":"指见多识广，知识渊博。","source":{"text":"蕴椟古今，博物多闻，《三坟》之篇，《五集》之策，无所不览。","book":"《后汉书·周荣传》"},"similar":["博物洽闻","见多识广"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；指见多识广"},{"id":10073,"word":"博物洽闻","pinyin":"bó wù qià wén","abbr":"bwqw","explanation":"博、洽：广博。广知事物，学识丰富。","source":{"text":"以迁之博物洽闻，而不能以知自全，既陷极刑，幽而发愤，书亦信矣。","book":"《汉书·司马迁传》"},"example":{"text":"周吉甫晖，～，恢奇奥雅，诗句之美，冠绝当时。","book":"明·顾起元《客座赘语·文士》"},"similar":["见多识广"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；用于称颂人"},{"id":10074,"word":"博物通达","pinyin":"bó wù tōng dá","abbr":"bwtd","explanation":"通达：明白人情事理。形容常识渊博，通晓事理。","source":{"text":"桑大夫据当时，合时变，上权利之略，虽非正法，巨儒宿学，不能自解，博物通达之士也。","book":"《汉书·公孙列东王杨蔡陈郑传赞》"},"similar":["知书达理"],"usage":"作谓语、定语；指人知书达理"},{"id":10075,"word":"博硕肥腯","pinyin":"bó shuò féi tú","abbr":"bsft","explanation":"博硕：形状大；腯：音‘途’，肥壮。指六畜肥壮。","source":{"text":"故奉牲以告曰：‘博硕肥途。’","book":"《左传·桓公六年》"},"example":{"text":"家有水牛一，博硕肥途，爱之特甚。","book":"清·淮阴百一居士《壶天录》"},"similar":["膘肥体壮"],"usage":"作谓语、定语；形容肥壮"},{"id":10076,"word":"博者不知","pinyin":"bó zhě bù zhī","abbr":"bzbz","explanation":"博者：知道事物多的人；不知：不专精。指知道的东西太广泛的人，就不能深入其中一个方面，对事物就会所知不深。","source":{"text":"知者不博，博者不知。","book":"《老子》第八十一章"},"example":{"text":"他是一个～的人。"},"similar":["博而不精"],"usage":"作宾语、定语；指人的学识"},{"id":10077,"word":"博而不精","pinyin":"bó ér bù jīng","abbr":"bebj","explanation":"形容学识丰富，但不精深。","source":{"text":"贾君精而不博，郑君博而不精；既精既博，吾何加焉。","book":"南朝·宋·范晔《后汉书·马融传》"},"example":{"text":"他是～的读书人。"},"similar":["精而不博"],"opposite":["博大精深"],"usage":"作谓语、定语；指人的知识或能力","story":["东汉著名的经学家郑众潜心研究《周易》《毛诗》《周礼》，他学习渊博，先后为《周易》等十几部著作作过注，还开课讲学。马融研究《左传》后想注解《左氏春秋》，他认为贾逵的注本是精而不博，郑众的注本是博而不精"]},{"id":10078,"word":"博而寡要","pinyin":"bó ér guǎ yào","abbr":"begy","explanation":"《史记·太史公自序》：“故曰：博而寡要，劳而少功。”","source":{"text":"故曰：博而寡要，劳而少功。","book":"《史记·太史公自序》"},"similar":["不得要领"],"usage":"作谓语、定语；指人的知识"},{"id":10079,"word":"博见洽闻","pinyin":"bó jiàn qià wén","abbr":"bjqw","explanation":"博、洽：广博。广知事物，学识丰富。","source":{"text":"以迁之博物洽闻，而不能以知自全，既陷极刑，幽而发愤，书亦信矣。","book":"《汉书·司马迁传》"}},{"id":10080,"word":"博观约取","pinyin":"bó guān yuē qǔ","abbr":"bgyq","explanation":"广泛地阅览，扼要地选取。","source":{"text":"呜呼，吾子其去此而务学也哉！博观而约取，厚积而薄发，吾告子止于此矣。","book":"宋·苏轼《送张琥》"},"example":{"text":"古之学者非有大过人者，惟能～，知宗而用妙耳。","book":"宋·释惠洪《石门文字禅·题隆道人僧宝传》"}},{"id":10081,"word":"博览五车","pinyin":"bó lǎn wǔ chē","abbr":"blwc","explanation":"指读书多，学识渊博。","source":{"text":"真个是：才过子建，貌赛潘安。胸中博览五车，腹内广罗千古。","book":"《初刻拍案惊奇》卷十"},"similar":["博见多闻"],"opposite":["孤陋寡闻"],"usage":"作谓语；指人的学问"},{"id":10082,"word":"博览古今","pinyin":"bó lǎn gǔ jīn","abbr":"blgj","explanation":"博：广博。广泛阅读古今书籍，通晓古今学识。形容学问渊博。","source":{"text":"博览古今，容受直辞。","book":"东汉·班固《汉书·成帝纪赞》"},"example":{"text":"做学问必须要～，采纳众家之长。"},"similar":["博古通今"],"usage":"作谓语、定语；指人的学识"},{"id":10083,"word":"博览群书","pinyin":"bó lǎn qún shū","abbr":"blqs","explanation":"博：广泛。广泛地阅读各种书。形容读书很多。","source":{"text":"庾信，字子山，南阳新野人也。……幼而俊迈，聪敏绝伦，博览群书，尤善《春秋左氏传》。","book":"《周书·庾信传》"},"example":{"text":"我们要～来充实自己。"},"similar":["博学多才","学富五车","才高八斗"],"opposite":["不学无术","才疏学浅","目不识丁"],"usage":"作谓语、定语；用于学识渊博的人"},{"id":10084,"word":"博识多通","pinyin":"bó shí duō tōng","abbr":"bsdt","explanation":"博：广博。识：学识。通：精通事理。指学识广博，精通事理。","source":{"text":"宝鼎元年，张善为日南太守。郡民有得金凫，以献太守张善。善博识多通，考其年月，既是秦始皇墓金凫也。","book":"《太平广记·伎巧一》"}},{"id":10085,"word":"博识洽闻","pinyin":"bó shí qià wén","abbr":"bsqw","explanation":"见多识广，学识博大。","example":{"text":"我们被博士的～所征服。"},"similar":["博闻多识"],"usage":"作谓语、定语；指人的知识"},{"id":10086,"word":"博通经籍","pinyin":"bó tōng jīng jí","abbr":"btjj","explanation":"博：广博：籍：书籍。广博而又精通经典文献。形容人学识渊博。","source":{"text":"初，京兆挚恂以儒术教授隐于南山，不应征聘，名重关西。融从其游学，博通经籍，恂奇融才，以女妻之。","book":"《后汉书·马融传》"},"similar":["博古通今"],"usage":"作谓语、宾语；指人的学识"},{"id":10087,"word":"博采众议","pinyin":"bó cǎi zhòng yì","abbr":"bczy","explanation":"广泛采纳群众的建议。","source":{"text":"臣闻为政听民，律令与时推移，诚宜与将相大臣详择时宜，博采众议，宽刑轻赋，均息力役，以顺民望。","book":"《三国志·吴志·孙登传》"},"example":{"text":"于是依照了这定律，并且～，将《玉君》创造出来了。","book":"鲁迅《中国新文学大系·小说二集序》"},"similar":["博采群议"],"opposite":["独断专行"],"usage":"作谓语、定语；指广泛听取意见"},{"id":10088,"word":"博采众长","pinyin":"bó cǎi zhòng cháng","abbr":"bczc","explanation":"博采：广泛搜集采纳。从多方面吸取各家的长处。","source":{"text":"凡处尊位者，必以敬下顺德规谏，必开不讳之门，蹲节安静以藉之，谏者勿振以威，母格其言，博采其辞，乃择可观。","book":"汉·刘向《说苑·君道》"},"example":{"text":"他对学生、画友，从不以我画线，而是主张～，自立门户。","book":"黄胄《怀念望云老师》"},"similar":["集思广益"],"opposite":["刚愎自用","自以为是"],"usage":"作谓语、定语；形容吸收别人的长处"},{"id":10089,"word":"博采群议","pinyin":"bó cǎi qún yì","abbr":"bcqy","explanation":"博：广；议：建议。广泛采纳群众的建议。","source":{"text":"考括坟籍，博采群议。","book":"《魏书·刘芳传》"},"similar":["博采众议"],"opposite":["独断专行"],"usage":"作谓语、定语；指广泛听取意见"},{"id":10090,"word":"博闻多识","pinyin":"bó wén duō shí","abbr":"bwds","explanation":"博：广博；闻：见闻；识：学识。知识丰富，见闻广博。","source":{"text":"博闻多识，万门千户，所宜访询。","book":"《魏书·李业兴传》"},"example":{"text":"公子生长中原，～，必知此兽之名。","book":"明·冯梦龙《东周列国志》第35回"},"similar":["博学多闻","见多识广"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；指人的知识"},{"id":10091,"word":"博闻强志","pinyin":"bó wén qiáng zhì","abbr":"bwqz","explanation":"形容知识丰富，记忆力强。","source":{"text":"博闻强志，不合王制。","book":"《荀子·解蔽》"},"example":{"text":"～，明于治乱。","book":"《史记·屈原贾生列传》"},"similar":["博闻强识"],"usage":"作谓语、定语；指人的记忆力"},{"id":10092,"word":"博闻强记","pinyin":"bó wén qiáng jì","abbr":"bwqj","explanation":"闻：见闻。形容知识丰富，记忆力强。","source":{"text":"博闻强志，明于治乱，娴于辞令。","book":"《荀子·解蔽》：“博闻强志，不合王制，君子贱之。”《礼记·曲礼上》：“博闻强识而让，敦善行而不怠，谓之君子。”《史记·屈原贾生列传》"},"example":{"text":"粲～，人皆不及。","book":"明·罗贯中《三国演义》第四十回"},"similar":["博古通今","博学多才","博览群书"],"opposite":["不学无术","孤陋寡闻"],"usage":"作谓语、定语；用于称颂人"},{"id":10093,"word":"博闻强识","pinyin":"bó wén qiáng zhì","abbr":"bwqz","explanation":"闻：见闻。形容知识丰富，记忆力强。","source":{"text":"博闻强志，明于治乱，娴于辞令。","book":"《荀子·解蔽》：“博闻强志，不合王制，君子贱之。”《礼记·曲礼上》：“博闻强识而让，敦善行而不怠，谓之君子。”《史记·屈原贾生列传》"},"example":{"text":"这本书的作者一定是位～的学者。"},"similar":["博古通今","博学多才","博览群书"],"opposite":["不学无术","孤陋寡闻"],"usage":"作谓语、定语；用于称颂人","story":["三国时期，魏文帝曹丕自幼天资聪颖，下笔成章，博闻强识，才艺兼备。8岁时就能写文章，他的诗词歌赋文笔清新流畅。《典论》中的《论文》一篇是我国文学批判史上杰出作品。他跟随曹操南征北战，公元220年他废汉自立为皇"]},{"id":10094,"word":"博闻辩言","pinyin":"bó wén biàn yán","abbr":"bwby","explanation":"博：多。闻：传闻。辩言：巧言。形容道听途说，似是而非的言论。","source":{"text":"患人之博闻辩言而似通者。","book":"《吕氏春秋·疑似》"}},{"id":10095,"word":"卜夜卜昼","pinyin":"bǔ yè bǔ zhòu","abbr":"bybz","explanation":"卜：占卜。形容夜以继日地宴乐无度。","source":{"text":"臣卜其昼，未卜其夜，不敢。","book":"《左传·庄公二十二年》"},"example":{"text":"《左传·庄公二十二年》：“臣卜其昼，未卜其夜，不敢。”"},"similar":["卜昼卜夜"],"usage":"作谓语、定语；指荒淫无度"},{"id":10096,"word":"卜宅卜邻","pinyin":"bǔ zhái bǔ lín","abbr":"bzbl","explanation":"卜：占卜。迁居时不是先在住宅方面占卜吉凶，而是占卜邻居是不是可以为邻。指迁居应选择好邻居。","source":{"text":"非宅是卜，唯邻是卜，二三子先卜邻矣，违卜不祥。","book":"《左传·昭公三年》"}},{"id":10097,"word":"卜数只偶","pinyin":"bǔ shù zhǐ ǒu","abbr":"bszo","explanation":"卜：占卜；数：气数；只：仅；偶：偶然。占卜有时灵验，只是偶然巧合。比喻刚好碰巧。","source":{"text":"譬犹卜数只偶之类。","book":"《后汉书·桓谭传》"}},{"id":10098,"word":"卜昼卜夜","pinyin":"bǔ zhòu bǔ yè","abbr":"bzby","explanation":"卜：占卜。形容夜以继日地宴乐无度。","source":{"text":"臣卜其昼，未卜其夜，不敢。","book":"《左传·庄公二十二年》"},"example":{"text":"把这些指挥官们，招集在这列花车里，～、昏天黑地，一起比大欢喜。","book":"徐铸成《何成浚与叶蓬》"},"similar":["卜夜卜昼"],"usage":"作谓语、定语；指人荒淫无度"},{"id":10099,"word":"占为己有","pinyin":"zhàn wéi jǐ yǒu","abbr":"zwjy","explanation":"将不是自己的东西占为自己所有。","source":{"text":"又以他人之物，占为己有。","book":"清·蒲松龄《聊斋志异·刘姓》"},"example":{"text":"路遥《平凡的世界》第四卷第33章：“父亲买回来后，她看完就偷偷地～了。”"},"similar":["据为己有"],"opposite":["舍己为人"],"usage":"作谓语、宾语；指将不是自己的东西占有"},{"id":10100,"word":"占山为王","pinyin":"zhàn shān wéi wáng","abbr":"zsww","explanation":"占：占据，霸占；王：统治者。占据山头，自称为王。比喻独霸一方，称王称霸。","source":{"text":"第二件是我也不占山为王，不过是与你比并武艺，也就算完了。","book":"清·姜振名《永庆升平前传》第69回"},"example":{"text":"他想～，控制这一领域。"},"usage":"作谓语、定语；指称王称霸"},{"id":10101,"word":"占着茅坑不拉屎","pinyin":"zhàn zhe máo kēng bù lā shǐ","abbr":"zzmkbls","explanation":"比喻占着位置不干活。","source":{"text":"这样的领导干部，索性请他好好休息，不然占着茅坑不拉屎怎么行？","book":"邓小平《关于国防工业企业的整顿》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":10102,"word":"占风使帆","pinyin":"zhān fēng shǐ fān","abbr":"zfsf","explanation":"比喻随机应变，看风头办事。","source":{"text":"看人眉来眼去，占风使帆。","book":"《醒世姻缘传》第八回"},"similar":["随机应变"],"usage":"作谓语；指随机应变"},{"id":10103,"word":"占风望气","pinyin":"zhān fēng wàng qì","abbr":"zfwq","explanation":"察看风向云气。亦比喻看风使舵，随机应变。","source":{"text":"壬辰以外察原任去官，四君者……真实可惜；其他占风望气，詈夷为跖，自弃名教者，固不可胜数矣。","book":"明沈德符《野获编·言事·言官一言之失》"},"example":{"text":"其初亦有一二魁杰之士，出一奇，运一策，世竞传之；而～之徒，争相附和，群然国士自命矣。","book":"清周亮工《书影》卷十"},"similar":["观颜察色"],"usage":"作谓语、定语；用于处事"},{"id":10104,"word":"卤莽灭裂","pinyin":"lǔ mǎng miè liè","abbr":"lmml","explanation":"形容做事草率粗疏。","source":{"text":"昔予为禾，耕而卤莽之，则其实亦卤莽而报予；芸而灭裂之，其实亦灭裂而报予。","book":"先秦·庄周《庄子·则阳》"},"example":{"text":"校古书者～，有遇衍字不加删削。","book":"清·俞樾《古书疑义举例·因误衍而误倒例》"},"similar":["鲁莽灭裂"],"usage":"作谓语；指人草率"},{"id":10105,"word":"卧不安席","pinyin":"wò bù ān xí","abbr":"wbax","explanation":"睡不安宁。形容心事、忧虑重重。","source":{"text":"寡人卧不安席，食不甘味，心摇摇如悬旌，而无所终薄。","book":"《战国策·楚策一》"},"example":{"text":"寡人闻之，～。","book":"明·冯梦龙《东周列国志》第六回"},"similar":["卧不安枕"],"opposite":["高枕无忧"],"usage":"作谓语、定语、状语；指心事重重"},{"id":10106,"word":"卧不安枕","pinyin":"wò bù ān zhěn","abbr":"wbaz","explanation":"睡不安宁。形容心事、忧虑重重。","source":{"text":"寡人卧不安席，食不甘味，心摇摇如悬旌，而无所终薄。","book":"《战国策·楚策一》"},"example":{"text":"寡人闻之，～。","book":"明·冯梦龙《东周列国志》第六回"},"similar":["卧不安席"],"usage":"作谓语、定语、状语；指心事重重"},{"id":10107,"word":"卧以治之","pinyin":"wò yǐ zhì zhī","abbr":"wyzz","explanation":"卧：躺着。躺着就把政事处理好了。用以称颂政清事简。","source":{"text":"顾淮阳吏民不相得，吾徒得君之重，卧而治之。","book":"《史记·汲郑列传》"},"example":{"text":"朕难其材，卿实元勋，以忠许国，谓当亟往～。","book":"宋·王安石《赐观文殿学士兵部尚书欧阳修辞知青州不允诏二道》"}},{"id":10108,"word":"卧冰哭竹","pinyin":"wò bīng kū zhú","abbr":"wbkz","explanation":"卧冰：晋王祥卧冰求鱼事母；哭竹：楚人孟宗天寒求笋。指对父母十分孝顺","source":{"text":"说到此处，就是卧冰哭竹，扇枕温衾，也难报答万一。","book":"明·凌濛初《初刻拍案惊奇》第13卷"},"similar":["扇枕温衾"],"usage":"作宾语、定语；用于书面语","story":["晋朝时期，孝子王祥对待后母如同生母一样，后母得病想吃鱼，正天寒地冻，王祥脱衣卧冰，冰化开，跳出双鲤，王祥拿回家煮给后母吃。楚人孟宗对待母亲也十分孝顺，冬天母亲想吃竹笋，孟宗冒雪进入竹林，扶竹林而痛哭，竹为之感到而立即长出笋尖来"]},{"id":10109,"word":"卧冰求鲤","pinyin":"wò bīng qiú lǐ","abbr":"wbql","explanation":"卧在冰上以求得鲤鱼。指忍苦孝亲。","source":{"text":"卧在冰上以求得鲤鱼。指忍苦孝亲。"},"similar":["卧冰求鱼"],"usage":"作谓语、定语；用于处事","story":["晋朝时期，琅邪临沂人王祥特别孝顺父母。父母生病的时候，他一直都衣不解带地伺候在父母身边，汤药要自己先尝后给父母喝。有一次母亲想吃活鱼，正值冬天，王祥脱衣刨冰，突然河上的冰融化，鲤鱼自己跳上来，他赶紧抓住回家去孝敬父母"]},{"id":10110,"word":"卧床不起","pinyin":"wò chuáng bù qǐ","abbr":"wcbq","explanation":"病卧床上，不能起来。","source":{"text":"吴主孙休，闻司马炎已篡魏，知其必将伐吴，忧虑成疾，卧床不起。","book":"明·罗贯中《三国演义》"},"example":{"text":"他回家后就开始生病，～已经有半年时间了。"},"usage":"作谓语、定语；用于人生病"},{"id":10111,"word":"卧旗息鼓","pinyin":"wò qí xī gǔ","abbr":"wqxg","explanation":"放倒旗子，停止敲鼓。原指行军时隐蔽行踪，不让敌人觉察。现比喻事情终止或声势减弱。","source":{"text":"亮意气自若，敕军中皆卧旗息鼓，不得妄出菴幔，又令大开四城门，埽地卻洒。","book":"《三国志·蜀书·赵云传》裴松之注引《蜀记》"},"similar":["偃旗息鼓","卧鼓偃旗"],"usage":"作谓语、定语、宾语；多用于比喻句"},{"id":10112,"word":"卧榻之上，岂容他人鼾睡","pinyin":"wò tà zhī shàng，qǐ róng tā rén hān shuì","abbr":"wtzsqrtrhs","explanation":"自己的床铺边，怎么能让别人呼呼睡大觉？比喻自己的势力范围，不容许别人沾手。","source":{"text":"江南亦何罪，但天下一家，卧榻之侧，岂容他人安睡耶？","book":"宋·岳珂《桯史·徐铉入聘》"}},{"id":10113,"word":"卧榻之下，岂容他人酣睡","pinyin":"wò tà zhī xià，qǐ róng tā rén hān shuì","abbr":"wtzxqrtrhs","explanation":"自己的床铺边，怎么能让别人呼呼睡大觉？比喻自己的势力范围，不容许别人插手。","source":{"text":"‘卧榻之下，岂容他人酣睡！’希哲低声背诵着成语。","book":"郑振铎《漩涡》"},"example":{"text":"谁都明白“～”的道理。"},"similar":["卧榻之旁，岂容他人鼾睡"],"usage":"作定语、分句；指自己势力范围不允许别人插","story":["公元960年，赵匡胤建立宋朝，他采取各个击破的战略，先后攻灭了荆南、湖南、后蜀等国。974年，他召南唐后主李煜到汴京朝见。李煜担心自己被扣押，就派徐铉到汴京求和。宋太祖直截了当地说：“卧榻之旁，岂容他人鼾睡？”"]},{"id":10114,"word":"卧榻之侧","pinyin":"wò tà zhī cè","abbr":"wtzc","explanation":"榻：床；侧：旁边。在自己睡觉的床铺旁边。比喻自己的管辖范围之内。","source":{"text":"江南亦何罪，但天下一家，卧榻之侧，岂容他人安睡耶？","book":"宋·岳珂《桯史·徐铉入聘》"},"example":{"text":"姚雪垠《李自成》第一卷第24章：“所以虽然这个寨位置在‘～’，相离很近，但闯王决定暂不攻打。”"},"usage":"作宾语；指势力范围内"},{"id":10115,"word":"卧榻之侧，岂容他人鼾睡","pinyin":"wò tà zhī cè，qǐ róng tā rén hān shuì","abbr":"wtzcqrtrhs","explanation":"自己的床铺边，怎么能让别人呼呼睡大觉？比喻自己的势力范围或利益不容许别人侵占。","source":{"text":"卧榻之侧岂容他人鼾睡耶！","book":"宋·岳珂《徐铉入聘》"},"example":{"text":"明·程登吉《幼学琼林》第三卷：“～，宋太祖之语；一统之世真是胡越一家，唐太祖之时。”"},"similar":["卧榻之旁，岂容他人鼾睡"],"usage":"作宾语、分句；指势力范围内不允许别人插足","story":["公元960年，赵匡胤建立宋朝，他采取各个击破的战略，先后攻灭了荆南、湖南、后蜀等国。974年，他召南唐后主李煜到汴京朝见。李煜担心自己被扣押，就派徐铉到汴京求和。宋太祖直截了当地说：“卧榻之侧，岂容他人鼾睡？”"]},{"id":10116,"word":"卧榻之侧，岂容酣睡","pinyin":"wò tà zhī cè，qǐ róng hān shuì","abbr":"wtzcqrhs","explanation":"自己的床铺边，怎么能让别人呼呼睡大觉？比喻自己的势力范围或利益不容许别人侵占。","source":{"text":"你可知宋太祖说的好：‘卧榻之侧，岂容他人酣睡？’","book":"清·曹雪芹《红楼梦》第76回"},"similar":["卧榻之侧，岂容鼾睡"],"usage":"作宾语、分句；指势力范围内不允许别人插足"},{"id":10117,"word":"卧榻之侧，岂容鼾睡","pinyin":"wò tà zhī cè，qǐ róng hān shuì","abbr":"wtzcqrhs","explanation":"自己的床铺边，怎么能让别人呼呼睡大觉？比喻自己的势力范围或利益不容许别人侵占。","source":{"text":"不须多言，江南有何罪，但天下一家，卧榻之侧，岂可许他人鼾睡。","book":"宋·杨亿《谈苑》"},"similar":["卧榻之侧，岂容酣睡"],"usage":"作宾语、分句；指势力范围内不允许别人插足","story":["公元960年，赵匡胤建立宋朝，他采取各个击破的战略，先后攻灭了荆南、湖南、后蜀等国。974年，他召南唐后主李煜到汴京朝见。李煜担心自己被扣押，就派徐铉到汴京求和。宋太祖直截了当地说：“卧榻之侧，岂容他人鼾睡？”"]},{"id":10118,"word":"卧榻之旁，岂容他人鼾睡","pinyin":"wò tà zhī páng，qǐ róng tā rén hān shuì","abbr":"wtzpqrtrhs","explanation":"自己的床铺边，怎么能让别人呼呼睡大觉？比喻自己的势力范围或利益不容许别人侵占。","source":{"text":"昔人云：‘卧榻之旁，岂容他人鼾睡’，‘养痈致患’，猝然一发，势若燎原矣。","book":"清·夏敬渠《野叟曝言》第145回"},"example":{"text":"～，我能饶你吗？"},"similar":["卧榻之侧，岂容鼾睡"],"usage":"作宾语、分句；指势力范围内不允许别人插足","story":["公元960年，赵匡胤建立宋朝，他采取各个击破的战略，先后攻灭了荆南、湖南、后蜀等国。974年，他召南唐后主李煜到汴京朝见。李煜担心自己被扣押，就派徐铉到汴京求和。宋太祖直截了当地说：“卧榻之旁，岂容他人鼾睡？”"]},{"id":10119,"word":"卧榻岂容鼾睡","pinyin":"wò tà qǐ róng hān shuì","abbr":"wtqrhs","explanation":"不能让别人在自己的床铺旁边呼呼大睡。比喻不能让别人肆意侵占自己的利益。","source":{"text":"心知其狐，亦不恐，入而叱曰：‘卧榻岂容鼾睡！’","book":"清·蒲松龄《聊斋志异·凤仙》"},"usage":"作分句；指自己的势力范围不允许别人插足","story":["公元960年，赵匡胤建立宋朝，他采取各个击破的战略，先后攻灭了荆南、湖南、后蜀等国。974年，他召南唐后主李煜到汴京朝见。李煜担心自己被扣押，就派徐铉到汴京求和。宋太祖直截了当地说：“卧榻之旁，岂容他人鼾睡？”"]},{"id":10120,"word":"卧榻鼾睡","pinyin":"wò tà hān shuì","abbr":"wths","explanation":"别人在自己的床铺旁边呼呼大睡。比喻别人肆意侵占自己的利益。","source":{"text":"卧榻之侧，岂容他人安睡耶？","book":"宋·岳珂《程史·徐铉入聘》"}},{"id":10121,"word":"卧狼当道","pinyin":"wò láng dāng dào","abbr":"wldd","explanation":"当路躺着恶狼。形容前途凶险。","source":{"text":"那任他卧狼党群当道，暴虎逼人，扫尽江河影。","book":"清·筱波山人《爱国魂·国忧》"},"similar":["豺狼当道"],"usage":"作谓语、定语；用于书面语"},{"id":10122,"word":"卧而治之","pinyin":"wò ér zhì zhī","abbr":"wezz","explanation":"卧：躺着。躺着就把政事处理好了。用以称颂政清事简。","source":{"text":"顾淮阳吏民不相得，吾徒得君之重，卧而治之。","book":"《史记·汲郑列传》"},"example":{"text":"其无咎无誉，～，无大恶可指者，亦常十居六七焉。","book":"清·梁启超《论湖南应办之事》"}},{"id":10123,"word":"卧薪尝胆","pinyin":"wò xīn cháng dǎn","abbr":"wxcd","explanation":"薪：柴草。睡觉睡在柴草上，吃饭睡觉都尝一尝苦胆。形容人刻苦自励，发奋图强。","source":{"text":"越王勾路反国，乃苦身焦思，置胆于坐，坐卧即仰胆，饮食亦尝胆也。","book":"《史记·越王勾践世家》"},"example":{"text":"中国足球要想冲出亚洲，必须～，刻苦训练。"},"similar":["发愤图强","宵衣旰食"],"opposite":["乐不思蜀"],"usage":"作谓语、定语、状语；指发奋图强","story":["春秋时期，吴王夫差打败并俘虏了越王勾践。勾践给夫差喂了三年的马，受尽折磨，回国后立志报仇复国，请范蠡帮助训练军队，任用有贤能的人，自己亲自参加劳动并坚持睡在柴草上，每次饭前均要尝尝一个苦胆，后来终于灭掉吴国"]},{"id":10124,"word":"卧虎藏龙","pinyin":"wò hǔ cáng lóng","abbr":"whcl","explanation":"指隐藏着未被发现的人才，也指隐藏不露的人才。","source":{"text":"暗石疑藏虎，盘根似卧龙。","book":"北周·庾信《同会河阳公新造山地聊得寓目》诗"},"example":{"text":"这所大学～，人才济济。"},"similar":["藏龙卧虎"],"usage":"作宾语、定语；指未被发现的人才"},{"id":10125,"word":"卧雪吞毡","pinyin":"wò xuě tūn zhān","abbr":"wxtz","explanation":"原指汉代苏武被匈奴幽禁，睡在雪地里，吃毛毡，却坚贞不屈。比喻困境中的艰难生活。后用以比喻民族气节。","source":{"text":"乃幽武置大窑中，绝不饮食，天雨雪，武卧啮雪与旃毛并咽之，数日不死，匈奴以为神。","book":"《汉书·苏武传》"}},{"id":10126,"word":"卧雪眠霜","pinyin":"wò xuě mián shuāng","abbr":"wxms","explanation":"睡卧在霜雪之上，比喻艰苦的流浪生活。","source":{"text":"假若高皇差你个梅香，背井离乡，卧雪眠霜，若是他不恋恁春风画堂，我便封你一字王。","book":"元·马致远《汉宫秋》第三折"},"example":{"text":"明·无名氏《南牢记》第三折：“想俺祖宗栉风沐雨，～，带甲而食，裹创而战，当原创业，好艰难也。”"},"similar":["栉风沐雨"],"usage":"作谓语、宾语、定语；用于生活等"},{"id":10127,"word":"卧鼓偃旗","pinyin":"wò gǔ yǎn qí","abbr":"wgyq","explanation":"偃：仰卧，引申为倒下。停止敲鼓，放倒旗子。原指行军时隐蔽行踪，不让敌人觉察。现比喻事情终止或声势减弱。","source":{"text":"云入营，更大开门，偃旗息鼓，公军疑云有伏兵，引去。","book":"《三国志·蜀书·赵云传》裴松之注引《赵云别传》"},"example":{"text":"思政命～，若无人者。","book":"《资治通鉴·梁纪·高祖武皇帝太清二年》"},"similar":["偃旗息鼓","卧旗息鼓"],"usage":"作谓语、定语、宾语；多用于比喻句"},{"id":10128,"word":"卬头阔步","pinyin":"áng tóu kuò bù","abbr":"atkb","explanation":"指抬头大步前行。","source":{"text":"卬头阔步尘蒙蒙，不似缓耕泥洦洦。","book":"宋梅尧臣《十九日出曹门见水牛拽车》诗"},"similar":["昂头阔步"],"usage":"作谓语、定语；指人的精神"},{"id":10129,"word":"卬首信眉","pinyin":"áng shǒu shēn méi","abbr":"assm","explanation":"信，通“伸”。昂首伸眉。形容意气昂扬，不随波逐流。","source":{"text":"今已专职形为埽除之隶，在闒茸之中，乃欲卬首信眉，论列是非，不亦轻朝廷，羞当世之士邪！","book":"《汉书·司马迁传》"},"example":{"text":"随行逐队，则有持禄之讥；～，则有出位之戒，是亦何荣之有哉！","book":"宋朱熹《答汪尚书书》"},"similar":["昂首伸眉"],"opposite":["随波逐流"],"usage":"作谓语、定语；指人的精神面貌"},{"id":10130,"word":"印把子","pinyin":"yìn bà zǐ","abbr":"ybz","explanation":"官印的把子。代指官印。","source":{"text":"我也说继之丢了一个印把子，得了个儿子，只好算秤钩儿打钉——扯直罢了。","book":"清·吴趼人《二十年目睹之怪现状》第59回"},"usage":"作主语、宾语、定语；用于口语"},{"id":10131,"word":"印累绶若","pinyin":"yìn léi shòu ruò","abbr":"ylsr","explanation":"形容官吏身兼数职，声势显赫。","source":{"text":"牢邪石邪，五鹿客邪！印何累累，绶若若邪！","book":"东汉·班固《汉书·佞幸传·石显》"},"example":{"text":"然则～之徒，其必娇尾厉角。","book":"清·严复《论世变之亟》"},"usage":"作谓语、定语；指居高位"},{"id":10132,"word":"危于累卵","pinyin":"wēi yú lěi luǎn","abbr":"wyll","explanation":"比垒起的蛋还危险。比喻极其危险。","source":{"text":"当是时，魏危于累卵，天下之士相从谋。","book":"西汉·刘向《战国策·秦策四》"},"example":{"text":"必若所欲为，～，难于上天。","book":"汉·枚乘《上书谏吴王》"},"similar":["危如累卵"],"opposite":["稳如泰山"],"usage":"作谓语、宾语、定语；形容十分危险","story":["春秋时期，晋灵公为了享乐，要建一座九层高的楼台，造了三年还没有造好，弄得民不聊生，晋灵公还不准大臣劝谏。荀息想了一计，在晋灵公面前先用12个棋子垒在一起，然后在上面垒九个鸡蛋，最后鸡蛋倒下砸碎。晋灵公明白后下令停工"]},{"id":10133,"word":"危亡关头","pinyin":"wēi wáng guān tóu","abbr":"wwgt","explanation":"突如其来的、不可预见的紧急关头或困境，要求立即采取行动以避免造成灾难。","example":{"text":"在这～，我们千万不能掉以轻心。"},"similar":["生死关头","危急关头"],"usage":"作宾语、定语；用于特别紧急情况"},{"id":10134,"word":"危同累卵","pinyin":"wēi tóng lěi luǎn","abbr":"wtll","explanation":"累卵：把蛋累起来。比喻形势非常危险，如同堆起来的蛋，随时都有塌下打碎的可能。","source":{"text":"其君之危，犹累卵也。","book":"《韩非子·十过》"},"example":{"text":"妾伏念先皇帝顷在并汾，适逢屯难，～，急若倒悬，智勇俱穷，朝夕不保。","book":"蔡东藩《五代史演义》第三十六回"}},{"id":10135,"word":"危在旦夕","pinyin":"wēi zài dàn xī","abbr":"wzdx","explanation":"旦夕：早晨和晚上，形容时间短。形容危险就在眼前。","source":{"text":"今管亥暴乱，北海被围，孤穷无援，危在旦夕。","book":"《三国志·吴书·太史慈传》"},"example":{"text":"现在桂林又～，柳州也将不保。","book":"闻一多《组织民众与保卫大西南》"},"similar":["朝不保夕","危如朝露"],"opposite":["安如磐石"],"usage":"作谓语、定语；形容十分危险","story":["东汉末年，张角领导的农民起义军包围了孔融屯兵地都昌，孔融派太史慈去请平原相刘备出兵救援。太史慈到平原对刘备说孔融目前危在旦夕，盼望出兵前去解围，刘备立即派精兵3000随太史慈前去，起义军见援军已到，立即解除对都昌的包围"]},{"id":10136,"word":"危如丝发","pinyin":"wēi rú sī fà","abbr":"wrsf","explanation":"危：危险；丝发：头发丝。危险得如同用一根头发挂着。形容形势极其危急。","source":{"text":"败祖宗之盟，失中国之信，创开边隙，使天下势危如丝发。","book":"《新刊大宋宣和遗事·利集》"},"example":{"text":"王黼、童贯又从而结怨于二国，败祖宗之盟，失中国之信，创开边隙，使天下～。","book":"清·毕沅《续资治通鉴》卷九十五"}},{"id":10137,"word":"危如朝露","pinyin":"wēi rú zhāo lù","abbr":"wrzl","explanation":"危险得象清早的露水，太阳一出就会消失。比喻处境极危险。","source":{"text":"君之危若朝露，尚将延年益寿乎。","book":"《史记·商君列传》"},"example":{"text":"景炎新造，～，犹以台谏，非论宿素。","book":"清·黄宗羲《文渊阁大学士吏兵二部尚书谥文靖朱公墓志铭》"},"similar":["危若朝露"],"opposite":["安如泰山"],"usage":"作谓语、宾语、定语；指处境极危险"},{"id":10138,"word":"危如累卵","pinyin":"wēi rú lěi luǎn","abbr":"wrll","explanation":"比喻形势非常危险，如同堆起来的蛋，随时都有塌下打碎的可能。","source":{"text":"秦王之国，危于累卵，得臣则安。","book":"《韩非子·十过》：“其君之危，犹累卵也。”《史记·范睢蔡泽列传》"},"example":{"text":"大名～，破在旦夕。","book":"明·施耐庵《水浒全传》第六十三回"},"similar":["千钧一发","危在旦夕"],"opposite":["安如磐石","稳如泰山"],"usage":"作谓语、宾语、定语；形容十分危险","story":["春秋时期，晋灵公为了享乐，要建一座九层高的楼台，造了三年还没有造好，弄得民不聊生，晋灵公还不准大臣劝谏。荀息想了一计，在晋灵公面前先用12个棋子垒在一起，然后在上面垒九个鸡蛋，最后鸡蛋倒下砸碎。晋灵公明白后下令停工"]},{"id":10139,"word":"危急关头","pinyin":"wēi jí guān tóu","abbr":"wjgt","explanation":"不可预见的紧急关头或困境，要求立即采取行动以避免造成灾难。","source":{"text":"我对她也很好，一方面是感激她在危急关头毫不犹豫地站在我一边。","book":"王朔《一半是火焰，一半是海水》"},"example":{"text":"他能在～镇定自若、沉着应对。"},"similar":["危亡关头"],"usage":"作宾语、定语；用于特别紧急情况"},{"id":10140,"word":"危急存亡","pinyin":"wēi jí cún wáng","abbr":"wjcw","explanation":"危急：危险而紧急。指关系到生存灭亡的紧急关头。","source":{"text":"今天下三分，益州罢弊，此诚危急存亡之秋也。","book":"三国蜀·诸葛亮《出师表》"},"example":{"text":"当这个～，不顾性命的时候，还不振作起精神来，一致对外吗？！","book":"鲁迅《两地书》二七"},"usage":"作宾语、定语；比喻形势危险急迫"},{"id":10141,"word":"危急存亡之交","pinyin":"wēi jí cún wáng zhī jiāo","abbr":"wjcwzj","explanation":"危急：危险而紧急；交：指关键时刻。指关系到生存灭亡的紧急关头。","source":{"text":"今天下三分，益州罢弊，此诚危急存亡之秋也。","book":"三国·蜀·诸葛亮《出师表》"},"example":{"text":"在已治已安之时，人人不管国事，尚且不可，况今日在～者哉。","book":"清·梁启超《鄙人对于言论界之过失及将来》"}},{"id":10142,"word":"危急存亡之时","pinyin":"wēi jí cún wáng zhī shí","abbr":"wjcwzs","explanation":"危急：危险而紧急；时：时刻。指关系到生存灭亡的紧急关头。","source":{"text":"今天下三分，益州罢弊，此诚危急存亡之秋也。","book":"三国·蜀·诸葛亮《出师表》"},"example":{"text":"说便这等说，但～，欲维系人心，不得已而出此。","book":"清·褚人获《隋唐演义》第九十二回"}},{"id":10143,"word":"危急存亡之秋","pinyin":"wēi jí cún wáng zhī qiū","abbr":"wjcwzq","explanation":"危险至极的紧急关头。","example":{"text":"在～，往往会出现能扭转乾坤的伟大人物。"}},{"id":10144,"word":"危机一发","pinyin":"wēi jī yī fà","abbr":"wjyf","explanation":"一发：一根头发。危险到只有一根头发牵拉的时刻。比喻极其危险。","source":{"text":"汉以来，群儒修补，百孔千疮，随乱随失，其危如一发引千钧，绵绵延延，寖以微灭。","book":"唐·韩愈《与孟尚书书》"}},{"id":10145,"word":"危机四伏","pinyin":"wēi jī sì fú","abbr":"wjsf","explanation":"到处隐藏着危险的祸根。","source":{"text":"不要太乐观。上海此时也是危机四伏。","book":"茅盾《子夜》九"},"example":{"text":"他没有一点私心，甚至在红卫兵上了街，～，杀气腾腾的时候。","book":"巴金《探索集·怀念老舍同志》"},"similar":["四面楚歌"],"usage":"作谓语、宾语、定语；指十分危险"},{"id":10146,"word":"危而不持","pinyin":"wēi ér bù chí","abbr":"webc","explanation":"持：扶助，支持。国有危急之事，不须外力扶助便能安然平息。","source":{"text":"危而不持，颠而不扶，则将焉用彼相矣。","book":"战国·鲁·孔丘《论语》"},"example":{"text":"召而不入，～，亦天下之罪人也。","book":"《晋书·周浚传》"},"usage":"作谓语、定语；用于书面语"},{"id":10147,"word":"危而后济","pinyin":"wēi ér hòu jì","abbr":"wehj","explanation":"危：危险，危急；济：接济。到了十分危险的时候再给予救助。","source":{"text":"昔武皇帝征南郑，取张鲁，阳平之役，危而后济，又自往拔出夏侯渊军，数言‘南郑直为天狱，中斜谷道为五百里石穴耳，’言其深险，喜出渊军之辞也。","book":"《资治通鉴·魏纪·世祖太和元年》"},"example":{"text":"昔太祖武皇帝收张鲁时，～。","book":"明·罗贯中《三国演义》第九十六回"}},{"id":10148,"word":"危若朝露","pinyin":"wēi ruò zhāo lù","abbr":"wrzl","explanation":"危险得像清早的露水一样容易消失。比喻面临死亡。","source":{"text":"君之危若朝露，尚将欲延年益寿乎！","book":"西汉·司马迁《史记·商君列传》"},"example":{"text":"今李氏～，汝诸王不舍生取义。","book":"宋·司马光《资治通鉴·唐则天后垂拱四年》"},"similar":["危如累卵"],"opposite":["安如泰山"],"usage":"作谓语、宾语、定语；指处境极危险"},{"id":10149,"word":"危言危行","pinyin":"wēi yán wēi xíng","abbr":"wywx","explanation":"危：正直。说正直的话，做正直的事。","source":{"text":"邦有道，危言危行。","book":"春秋·鲁·孔丘《论语·宪问》"},"example":{"text":"～以处朝廷者，自明主所察也。","book":"晋·陈寿《三国志·魏志·杜畿传》"},"usage":"作主语、宾语；指人的言行"},{"id":10150,"word":"危言悚听","pinyin":"wēi yán sǒng tīng","abbr":"wyst","explanation":"危言：使人吃惊的话。指故意说些夸大的吓人的话，使人惊疑震动。","source":{"text":"我国民勿以吾为危言悚听也。","book":"梁启超《米禁危言》"},"similar":["危言耸听"],"usage":"作谓语、定语、宾语；指夸大事实吓唬人"},{"id":10151,"word":"危言核论","pinyin":"wēi yán hé lùn","abbr":"wyhl","explanation":"正直而翔实的言论。","source":{"text":"林宗虽善人伦，而不为危言核论，故宦官擅政而不能伤也。","book":"南朝·宋·范晔《后汉书·郭太传》"},"usage":"作宾语、定语；用于书面语"},{"id":10152,"word":"危言正色","pinyin":"wēi yán zhèng sè","abbr":"wyzs","explanation":"刚直的言论和严正的态度。","source":{"text":"必待非常之主，然后危言正色，抗议直辞，赵汤矍而不回。","book":"唐·陈子昂《谏灵驾入京书》"},"example":{"text":"她～地劝告你，希望能够尽快停止。"},"usage":"作定语、状语；指忠言"},{"id":10153,"word":"危言竦论","pinyin":"wēi yán sǒng lùn","abbr":"wysl","explanation":"使人感到惊恐或震动的言论。","source":{"text":"滞魄幽魂现形惊异类，危言竦论改过望同胞。","book":"清·彭养鸥《黑籍冤魂》第24回"},"usage":"作宾语、定语；用于书面语"},{"id":10154,"word":"危言耸听","pinyin":"wēi yán sǒng tīng","abbr":"wyst","explanation":"危言：使人吃惊的话；耸：惊动；耸听：使听话的人吃惊。指故意说些夸大的吓人的话，使人惊疑震动。","source":{"text":"我国民勿以吾为危言悚听也。","book":"清·梁启超《米禁危言》"},"example":{"text":"这不是什么“～”的道理，稍稍注意这个问题的人，是不难发现若干真凭实据的。","book":"郭小川《论“听话”》"},"similar":["耸人听闻","骇人听闻"],"usage":"作谓语、定语、状语；指夸大事实吓唬人"},{"id":10155,"word":"危言覈论","pinyin":"wēi yán hé lùn","abbr":"wyhl","explanation":"正直而翔实的言论。","source":{"text":"郭林宗虽善人伦，而不为危言覈论，故宦臣擅政而不能伤也。","book":"《后汉书·郭泰传》"}},{"id":10156,"word":"危言谠论","pinyin":"wēi yán dǎng lùn","abbr":"wydl","explanation":"危、谠：正直的意思。正直的言论。","source":{"text":"伏惟阁下危言谠论，流风善政，简在天子之心，而讽于士大夫之口，名声之盛，位势之尊，不宜以细故苟自贬损。","book":"宋·王安石《答孙元规大资书》"},"similar":["危言高论"],"usage":"作宾语、定语；用于书面语"},{"id":10157,"word":"危言逆耳","pinyin":"wēi yán nì ěr","abbr":"wyne","explanation":"正直的规劝听起来不顺耳。","source":{"text":"龙攀凤附不自由，何乃弃君来事仇。危言逆耳谁为谋？","book":"明·李东阳《太白行》"},"similar":["忠言逆耳"],"usage":"作宾语、定语；用于劝诫人"},{"id":10158,"word":"危言骇世","pinyin":"wēi yán hài shì","abbr":"wyhs","explanation":"骇；震惊，害怕。故作惊人之语，使世人听了吃惊。","source":{"text":"意者危言骇世，姑一快胸中之愤也。","book":"宋·吕祖谦《馆职策》"}},{"id":10159,"word":"危言高论","pinyin":"wēi yán gāo lùn","abbr":"wygl","explanation":"正直而不同凡响的言论。","source":{"text":"初，躬待诏，数危言高论，自恐遭害，著绝命辞。","book":"《汉书·息夫躬传》"},"example":{"text":"仲容博学，少有盛名，颇任气使酒，好～，士友以此少之。","book":"《南史·庾仲容传》"},"similar":["危言谠论"],"usage":"作宾语、定语；用于书面语"},{"id":10160,"word":"危辞耸听","pinyin":"wēi cí sǒng tīng","abbr":"wcst","explanation":"故意说吓人的话使人听了吃惊、害怕。","example":{"text":"请不要～了。"},"similar":["危言耸听"],"usage":"作宾语、定语；指危言耸听"},{"id":10161,"word":"危迫利诱","pinyin":"wēi pò lì yòu","abbr":"wply","explanation":"用暴力压迫，用利益引诱。形容软硬兼施，企图使人服从。","example":{"text":"～不能动摇一个爱国志士的坚强意志。"}},{"id":10162,"word":"危邦不入","pinyin":"wēi bāng bù rù","abbr":"wbbr","explanation":"危：危险；邦：邦国，代指地方。局势不稳定的地方不要去。","source":{"text":"笃信好学，守死善道，危季不入，乱邦不居。","book":"《论语·泰伯》"},"example":{"text":"业抚膺叹道：“古人云：‘～，乱邦不居。’我情愿饮药便了。”","book":"蔡东藩《后汉演义》第十九回"}},{"id":10163,"word":"即事穷理","pinyin":"jí shì qióng lǐ","abbr":"jsql","explanation":"指根据事实深究它的道理。","source":{"text":"有即事以穷理，无立理以限事。","book":"清·王夫之《续春秋左氏传博议·士文伯论日食》"},"usage":"作宾语；指追究事理"},{"id":10164,"word":"即以其人之道，还治其人之身","pinyin":"jí yǐ qí rén zhī dào，huán zhì qí rén zhī shēn","abbr":"jyqrzdhzqrzs","explanation":"就用那个人对付别人的办法返回来对付那个人自己。","source":{"text":"故君子之治人也，即以其人之道，还治其人之身。","book":"宋·朱熹《中庸集注》第十三章"},"example":{"text":"况这班奸党，不知屈害多少忠良，～，极是快心之事。","book":"清·陈忱《水浒后传》第二十二回"},"similar":["以牙还牙"],"usage":"作宾语、分句；指以牙还牙"},{"id":10165,"word":"即兴之作","pinyin":"jí xìng zhī zuò","abbr":"jxzz","explanation":"即兴：根据当时的兴致和感觉；作：作品。根据当时的感受而写成的作品。","example":{"text":"这是我的～，请勿见笑。"},"usage":"作主语、宾语；用于文章或书画等"},{"id":10166,"word":"即即世世","pinyin":"jí jí shì shì","abbr":"jjss","explanation":"诅咒人该死的话。旧时戏曲中常用。","source":{"text":"谁承望这即即世世老婆婆，着莺莺做妹妹拜哥哥。","book":"元·王实甫《西厢记》第二本第三折"}},{"id":10167,"word":"即小见大","pinyin":"jí xiǎo jiàn dà","abbr":"jxjd","explanation":"从小处或小事见到大道理。","source":{"text":"即小见大我于是竟悟出一件长久不解的事来。","book":"鲁迅《热风·即小见大》"},"example":{"text":"短篇小说的题材不怕‘小’，关键是在于要‘～’，这就要看作家的思想水平和观察生活、表现生活的工力了。","book":"《人民文学》1977年第12期"},"similar":["以小见大"],"usage":"作宾语、分句；指以小见大"},{"id":10168,"word":"即席赋诗","pinyin":"jí xí fù shī","abbr":"jxfs","explanation":"即席：当场。当场作诗。比喻才思敏捷。","source":{"text":"初，武帝总延后进二十余人，置酒赋诗。臧盾以诗不成，罚酒一斗。盾饮尽，颜色不变，言笑自若，解染翰便成，文无加点。","book":"《南史·萧解传》"}},{"id":10169,"word":"即心是佛","pinyin":"jí xīn shì fó","abbr":"jxsf","explanation":"佛教禅宗认为只要求之于内心，便可悟道成佛。","source":{"text":"初参大寂，问如何是佛。大寂云：‘即心是佛。’师即大悟。","book":"宋·释道原《景德传灯录》"},"example":{"text":"若欲求佛，～。若欲会道，无心是道。","book":"宋·释普济《五灯会元》卷二"},"similar":["即心即佛"],"usage":"作谓语、定语；用于佛教等"},{"id":10170,"word":"即景生情","pinyin":"jí jǐng shēng qíng","abbr":"jjsq","explanation":"对眼前的情景有所感触而产生某种思想情感。","source":{"text":"善咏物者，妙在即景生情。","book":"清·李渔《闲情偶寄·词曲部·词采第二》"},"example":{"text":"但春秋时赋诗引诗，是～，在彼此晤对的背景之下，尽管断章取义，还是亲近易晓。","book":"朱自清《比兴》"},"similar":["触景生情"],"usage":"作谓语、宾语；指由眼前景象触发某种情绪"},{"id":10171,"word":"即温听厉","pinyin":"jí wēn tīng lì","abbr":"jwtl","explanation":"后以之称面受尊者的教诲。","source":{"text":"君子有三变：望之俨然，即之也温，听其言也厉。","book":"《论语·子张》"},"example":{"text":"不得～，良以为歉。","book":"宋·胡继宗《书言故事·会遇》"},"usage":"作谓语、定语；用于书面语"},{"id":10172,"word":"即物穷理","pinyin":"jí wù qióng lǐ","abbr":"jwql","explanation":"程朱理学的主要范畴之一。指“理”在物先，事事物物皆是“理”的表现，要依据具体事物穷究其“理”。","source":{"text":"来书云：闻语学者，乃谓‘即物穷理’之说亦是玩物丧志，人取萁‘厌繁就约’‘涵养本原’数说标示学者，指为晚年定论，此亦恐非。朱子所谓格物云者，在即物而穷其理也。","book":"明·徐爱《传习录·答顾东挢书》"}},{"id":10173,"word":"即穷验问","pinyin":"jí qióng yàn wèn","abbr":"jqyw","explanation":"即穷：追究到极点；验：检验。抓住事实，追究查问。","source":{"text":"便有司即穷验问。","book":"汉·刘向《列女传·辩通》"}},{"id":10174,"word":"即鹿无虞","pinyin":"jí lù wú yú","abbr":"jlwy","explanation":"原意是进山打鹿，没有熟悉地形和鹿性的虞官帮助，那是白费气力。后比喻做事如条件不成熟就草率行事，必定劳而无功。","source":{"text":"即鹿无虞，惟入于林中；君子几，不如舍，往吝。","book":"《周易·屯》"},"example":{"text":"今欲凿空寻访水利，所谓～，岂惟徒劳，必大烦忧。","book":"宋·苏轼《上神宗皇帝书》"},"usage":"作宾语；比喻盲目从事，徒劳无功"},{"id":10175,"word":"却之不恭","pinyin":"què zhī bù gōng","abbr":"qzbg","explanation":"却：推却。指对别人的邀请、赠与等，如果拒绝接受，就显得不恭敬。","source":{"text":"却之却之为不恭。","book":"《孟子·万章下》"},"example":{"text":"我们觉得～，只好让他劳驾。","book":"邹韬奋《经历·惨淡经营之后》"},"similar":["盛情难却","受之有愧"],"opposite":["置之不理"],"usage":"作谓语、宾语；常与“受之有愧”连用","story":["战国时期，孟子的学生万章向孟子请教人际交往的问题，孟子认为对人应该恭敬。万章说：“一再推却，拒绝别人的礼物是不恭敬的，为什么？”孟子说：“高贵的人送东西给你，你如果拒绝就是不恭敬的，因此你应该接受。”"]},{"id":10176,"word":"却客疏士","pinyin":"què kè shū shì","abbr":"qkss","explanation":"却：拒绝；疏：疏远；客：外来人；士：读书人。比喻囿于地方观念，不用外来的人，也不用有才能的人。指妒贤嫉能。","source":{"text":"向使四君却客而不内，疏士而不用，是使国无富利之实，而秦无强大之名也。","book":"秦·李斯《谏逐客书》"}},{"id":10177,"word":"却步图前","pinyin":"què bù tú qián","abbr":"qbtq","explanation":"却步：向后退。比喻向后退是为了前进。","source":{"text":"谅却步以图前兮，不浸近而愈远。","book":"唐·韩愈《复志赋》"}},{"id":10178,"word":"却病延年","pinyin":"què bìng yán nián","abbr":"qbyn","explanation":"除去疾病，延长寿命。","source":{"text":"修真养性，服食导引，却病延年。","book":"明·冯梦龙《东周列国志》第83回"},"example":{"text":"第二种却也是～的要诀，连古之儒者也不讳言的。","book":"鲁迅《且介亭杂文·病后杂谈》"},"usage":"作谓语、定语；用于书面语"},{"id":10179,"word":"却老还童","pinyin":"què lǎo huán tóng","abbr":"qlht","explanation":"指返老还童。","source":{"text":"摄神御气，救护命宝，可以却老还童。","book":"清·黄钧宰《金壶遁墨·候仙》"},"similar":["返老还童"],"usage":"作谓语、定语、宾语；指人的外貌或精神"},{"id":10180,"word":"却行求前","pinyin":"què xíng qiú qián","abbr":"qxqq","explanation":"指以倒退求前进，比喻方法不对，因而不可能达到目的。","source":{"text":"夫明镜者所以照形也，往古者所以知今也。夫知恶往古之所以危亡，而不袭蹈其所以安存者，则无异乎却行而求逮于前人也。","book":"汉·韩婴《韩诗外传》卷五"},"example":{"text":"陛下但务其华，不寻其实，犹缘木希鱼，～。","book":"《资治通鉴·汉纪·孝顺皇帝下"},"similar":["缘木求鱼"],"usage":"作宾语、定语；用于比喻句"},{"id":10181,"word":"却金暮夜","pinyin":"què jīn mù yè","abbr":"qjmy","explanation":"指为官清廉。","source":{"text":"东汉杨震为东莱太守，途经昌邑，县令王密求见。至晚，以十金奉杨曰：“暮夜无知者。”杨曰：“天知，神知，我知，子知。何谓无知者？”遂拒而不受。见《后汉书·杨震传》。"},"example":{"text":"明·归有光《送郡别驾王侯考绩序》：“侯为人清廉不忧，真有～、饮贪泉而不易之操。”"},"similar":["暮夜却金"],"usage":"作定语、宾语；用于为人等","story":["东汉时期，太守杨震为人正直，清正廉洁，从来不收受别人的贿赂。受他举荐的昌邑县令王密趁着夜色，给他送去10斤黄金。杨震十分不高兴，王密说夜深人静没人知晓的。杨震说：“天知、地知、你知、我知，我不能收这不义之财。”"]},{"id":10182,"word":"卵与石斗","pinyin":"luǎn yǔ shí dòu","abbr":"lysd","explanation":"鸡蛋碰石头。比喻自不量力，一定失败。","source":{"text":"卵与石斗，麋碎无疑；动而有悔，出不得时。","book":"汉·焦延寿《易林》卷十三"},"similar":["以卵击石","自不量力"],"usage":"作宾语；比喻自不量力，一定失败"},{"id":10183,"word":"卵石不敌","pinyin":"luǎn shí bù dí","abbr":"lsbd","explanation":"比喻双方力量相差极大。","source":{"text":"卵与石斗，麋碎无疑；动而有悔，出不得时。","book":"汉·焦延寿《易林》卷十三"},"example":{"text":"某屡欲誊词上控，为母训所阻，且贫富悬殊，～，只得忍止。","book":"清·吴趼人《九命奇冤》第十九回"},"similar":["卵与石斗"],"usage":"作宾语、定语；用于比喻句"},{"id":10184,"word":"卵翼之恩","pinyin":"luǎn yì zhī ēn","abbr":"lyze","explanation":"卵翼：鸟用翅膀掩护其蛋。比喻抚育和庇护。也形容生养哺育之恩。","source":{"text":"卵翼之恩，方斯莫喻。","book":"《左传·哀公十六年》：“胜如卵，余翼而长之。”《陈书·周迪传》"},"example":{"text":"安石之于惠卿，有～，有父师之义，方其求进，则胶固为一，更相汲引，以欺朝廷。","book":"清·毕沅《续资治通鉴》卷七十九"}},{"id":10185,"word":"卵覆鸟飞","pinyin":"luán fù niǎo fēi","abbr":"lfnf","explanation":"鸟飞走了，卵也打破了。比喻两头空，一无所得。","source":{"text":"人之无良，舍其旧而新是谋，卒之卵覆而鸟亦飞，天之所报亦惨矣！","book":"清·蒲松龄《聊斋志异·阿霞》"},"usage":"作宾语、定语；用于比喻句"},{"id":10186,"word":"卷土重来","pinyin":"juǎn tǔ chóng lái","abbr":"jtcl","explanation":"卷土：人马奔跑时尘土飞卷。比喻失败之后，重新恢复势力。","source":{"text":"江东子弟多才俊，卷土重来未可知。","book":"唐·杜牧《题乌江亭》诗"},"example":{"text":"他们要挣扎，他们要变天，他们要～。","book":"曲波《林海雪原》一"},"similar":["死灰复燃","东山再起","重起炉灶"],"opposite":["偃旗息鼓","万劫不复","一蹶不振"],"usage":"作谓语、宾语、定语；用于坏人","story":["楚汉相争时期，项羽由于刚愎自用轻敌，在垓下中了韩信的埋伏大败，只好带领八千江东子弟到乌江边，项羽兵败自杀。杜牧《题乌江亭》感慨项羽的事：“胜败兵家事不期，色羞忍耻是男儿；江东子弟多才俊，卷土重来未可知。”"]},{"id":10187,"word":"卷地皮","pinyin":"juǎn dì pí","abbr":"jdp","explanation":"把地皮都卷走了。比喻官吏的残酷搜刮。","source":{"text":"扬州恶百姓，疑我卷地皮。","book":"唐·卢仝《萧宅二三子赠答诗（客谢井）》"},"similar":["刮地皮"],"usage":"作谓语、宾语、定语；用于贪官"},{"id":10188,"word":"卷帙浩繁","pinyin":"juàn zhì hào fán","abbr":"jzhf","explanation":"卷帙：书籍或书籍的篇章。形容书籍很多或一部书的部头很大。","source":{"text":"卷帙浩繁，也恐一时纸价腾贵，赀力不给。","book":"清·李绿园《歧路灯》第九十六回"},"example":{"text":"从地板一直到天花板，一眼望去，～，颇有书城巍巍的气象。","book":"余光中《三间书房》"},"usage":"作谓语、定语；比喻书籍众多纷繁"},{"id":10189,"word":"卷席而居","pinyin":"juǎn xí ér jū","abbr":"jxej","explanation":"极言生活之不安定，随时准备逃难。","source":{"text":"冬，纵兵临寿春，屠马塘，走其守令狐通，焚霍丘，淮南郡邑大骇，民人卷席而居。","book":"唐·沈亚之《万胜岗新城录》"},"usage":"作谓语、定语；用于生活"},{"id":10190,"word":"卷席而葬","pinyin":"juǎn xí ér zàng","abbr":"jxez","explanation":"指用苇席裹尸而埋葬。极言葬礼之薄。","source":{"text":"父让王莽时为城门校尉，封修远伯，使奉少昊后，寓于北地而卒。鸿时尚幼，以遭乱世，因卷席而葬。","book":"《后汉书·逸民传·梁鸿》"},"usage":"作谓语、定语；用于书面语"},{"id":10191,"word":"卷旗息鼓","pinyin":"juǎn qí xī gǔ","abbr":"jqxg","explanation":"犹偃旗息鼓。原指行军时隐蔽行踪，不让敌人觉察。现比喻事情终止或声势减弱。","source":{"text":"云入营，更大开门，偃旗息鼓，公军疑云有伏兵，引去。","book":"《三国志·蜀书·赵云传》裴松之注引《赵云别传》"},"example":{"text":"须等那不贤之妇亲口道允，我等才～，斩宽一时。","book":"清·孙郁《绣帏灯·公讨》"},"similar":["偃旗息鼓"],"opposite":["大张旗鼓"],"usage":"作谓语、定语、宾语；比喻停止斗争等"},{"id":10192,"word":"卷甲倍道","pinyin":"juǎn jiǎ bèi dào","abbr":"jjbd","explanation":"卷起铠甲，急速前进。","source":{"text":"是故卷甲而趋，日夜不处，倍道兼行，百里而争利。","book":"先秦·孙武《孙子·军事》"},"example":{"text":"燕王度忠必争居庸，帅精兵八千，～趋怀来。","book":"《明史·宋忠传》"},"usage":"作谓语；指急行军"},{"id":10193,"word":"卷甲束兵","pinyin":"juǎn jiǎ shù bīng","abbr":"jjsb","explanation":"卷起铠甲，收起兵器。"},{"id":10194,"word":"卷甲衔枚","pinyin":"juǎn jiǎ xián méi","abbr":"jjxm","explanation":"指行军时轻装疾进，保持肃静，以利奇袭。","source":{"text":"其外轻赍游阙，随机赴响，卷甲衔枚，出其不意。","book":"《北史·隋纪下·炀帝》"},"usage":"作谓语、定语；用于战争等"},{"id":10195,"word":"卷甲韬戈","pinyin":"juǎn jiǎ tāo gē","abbr":"jjtg","explanation":"卷起铠甲，收起武器。指停止战斗。","source":{"text":"故卷甲韬戈，啖以金帛，彼既得所欲，理当自退。","book":"《资治通鉴·唐高祖武德九年》"},"example":{"text":"～，率众臣附。","book":"明·宋濂《追封蕲国公谥武义康公神道碑铭序》"},"similar":["案兵束甲","卷甲束兵"],"usage":"作谓语、宾语；用于战争等"},{"id":10196,"word":"卷铺盖","pinyin":"juǎn pū gai","abbr":"jpg","explanation":"收拾行李离去。比喻被解雇或辞去职务，离开原来工作地点。","source":{"text":"叫他去开销蒋福，立时三刻要他卷铺盖滚出去。","book":"清·李宝嘉《官场现形记》第五回"},"example":{"text":"我们不是想叫你～走人。"},"similar":["炒鱿鱼"],"usage":"作谓语、宾语；指解雇或炒鱿鱼"},{"id":10197,"word":"卸磨杀驴","pinyin":"xiè mò shā lǘ","abbr":"xmsl","explanation":"把拉完磨的驴卸下来杀掉。比喻把曾经为自己出过力的人一脚踢开。","source":{"text":"只怕归队以后，打下萍水县城，他就得卸磨杀驴。","book":"刘绍棠《狼烟》"},"example":{"text":"作为领导人千万不能～，否则会失去人心的。"},"similar":["过河拆桥","翻脸无情"],"opposite":["感恩戴德","一往情深"],"usage":"作谓语、分句；同“过河拆桥”"},{"id":10198,"word":"卿卿我我","pinyin":"qīng qīng wǒ wǒ","abbr":"qqww","explanation":"形容夫妻或相爱的男女十分亲昵。","source":{"text":"亲卿爱卿，是以卿卿，我不卿卿，谁当卿卿？","book":"南朝·宋·刘义庆《世说新语·惑溺》"},"example":{"text":"它们在春情发动期，雌的和雄的碰在一起，难免“～”的来一阵。","book":"鲁迅《准风月谈·男人的进化》"},"similar":["恩恩爱爱"],"usage":"作谓语、定语；用于男女之间"},{"id":10199,"word":"历世摩钝","pinyin":"lì shì mó dùn","abbr":"lsmd","explanation":"激励世人，使鲁钝的人奋发有为。亦作“历世磨钝”。"},{"id":10200,"word":"历世磨钝","pinyin":"lì shì mó dùn","abbr":"lsmd","explanation":"激励世人，使鲁钝的人奋发有为。同“历世摩钝”。"},{"id":10201,"word":"历久弥坚","pinyin":"lì jiǔ mí jiān","abbr":"ljmj","explanation":"弥：越，更加。经历时间越长久，越显得坚定不移。"},{"id":10202,"word":"历乱无章","pinyin":"lì luàn wú zhāng","abbr":"llwz","explanation":"历乱：凌乱。十分凌乱，没有一点章法。","source":{"text":"尤来无行伍，历乱如覃葛。","book":"南朝·宋·鲍照《绍古辞》"}},{"id":10203,"word":"历井扪天","pinyin":"lì jǐng mén tiān","abbr":"ljmt","explanation":"井：星宿名。手能触天，形容极高。","source":{"text":"诸子送我，历井扪天，汝不忘我，我不忘先。","book":"宋·苏辙《卜居赋》"},"usage":"作谓语；形容极高"},{"id":10204,"word":"历兵秣马","pinyin":"lì bīng mò mǎ","abbr":"lbmm","explanation":"磨利兵器，喂饱马匹。指作好战斗准备。"},{"id":10205,"word":"历兵粟马","pinyin":"lì bīng sù mǎ","abbr":"lbsm","explanation":"磨快兵器喂饱马。指准备作战。"},{"id":10206,"word":"历历可数","pinyin":"lì lì kě shǔ","abbr":"llks","explanation":"历历：清楚、分明的样子。可以清楚地一个个或一件件数出来。","source":{"text":"濮州进重修河堤图，沿河地名，历历可数。","book":"《旧五代史·明宗纪十》"},"example":{"text":"则用细草制为楼阁，大如橼，小如橘，约二十余座，每座梁栋榱题，～。","book":"清·蒲松龄《聊斋志异·仙人岛》"},"similar":["屈指可数","历历在目","一清二楚"],"opposite":["漆黑一团","昏天黑地"],"usage":"作谓语、定语；指清楚"},{"id":10207,"word":"历历可考","pinyin":"lì lì kě kǎo","abbr":"llkk","explanation":"指可以清清楚楚的找到依据所在。","source":{"text":"卜子夏为修文郎，郭璞为水仙伯，陶弘景为蓬莱都水监，李长吉召撰白玉楼记，皆历历可考，不能尽数。","book":"明·凌濛初《初刻拍案惊奇》卷二十八"}},{"id":10208,"word":"历历可见","pinyin":"lì lì kě jiàn","abbr":"llkj","explanation":"历历：分明、清楚。看得清清楚楚。","source":{"text":"登州海中时有云气如宫室、台观、城堞、人物、车马、冠盖，历历可见，谓之‘海市。’","book":"宋·沈括《梦溪笔谈·异事》"},"example":{"text":"殿前挂大镜，照人心腑，～。","book":"宋·洪迈《夷坚甲志·郑邻再生》"},"similar":["历历可辨"],"usage":"作谓语；指十分清楚"},{"id":10209,"word":"历历可辨","pinyin":"lì lì kě biàn","abbr":"llkb","explanation":"可以清晰地辨别清楚。","source":{"text":"圉人因寻马踪，以天雨新霁，历历可辨。","book":"唐·张读《宣室志·韩生》"},"example":{"text":"面目冠裳，～。","book":"宋·洪迈《夷坚丙志·朱真人》"},"similar":["历历可见"],"usage":"作谓语；指十分清楚"},{"id":10210,"word":"历历在目","pinyin":"lì lì zài mù","abbr":"llzm","explanation":"历历：清楚，分明的样子。指远方的景物看得清清楚楚，或过去的事情清清楚楚地重现在眼前。","source":{"text":"历历开元事，分明在眼前。","book":"唐·杜甫《历历》诗"},"example":{"text":"雾开，峰峦～，登陟有路。","book":"《清史稿·觉罗武默讷传》"},"similar":["一清二楚","历历可数","记忆犹新"],"opposite":["漆黑一团","昏天黑地"],"usage":"作谓语、补语；用于对往事的回忆"},{"id":10211,"word":"历历在耳","pinyin":"lì lì zài ěr","abbr":"llze","explanation":"形容听到的某种声音清清楚楚地盘旋在耳边。","source":{"text":"念昔暂违，今焉永决，历历在耳，言犹未绝。","book":"宋·陈文尉《祭朱先生》"},"example":{"text":"见他两个戏谑歌呼，～，气得按捺不下，打一砖去。","book":"明·冯梦龙《警世通言》卷二十八"},"usage":"作谓语；指清楚地在耳边"},{"id":10212,"word":"历历如画","pinyin":"lì lì rú huà","abbr":"llrh","explanation":"形容描述清楚、生动，犹如绘画一般。","source":{"text":"写景历历如画，引人入胜。","book":"清·爱新觉罗·弘历《唐宋诗醇·和三月三十日四韵》"},"similar":["历历如绘"],"usage":"作谓语、定语、状语；用于写作等"},{"id":10213,"word":"历历如绘","pinyin":"lì lì rú huì","abbr":"llrh","explanation":"形容描述清楚、生动，犹如绘画一般。","source":{"text":"言皆妄诞，然谈兵家事历历如绘。","book":"清·昭梿《啸亭杂录》卷八"},"example":{"text":"我早识先生，并识先生之夫人，貌作何状；令姊，貌作何状，～。","book":"清·梁章钜《楹联丛话·佳话》"},"similar":["历历如画"],"usage":"作谓语、定语、状语；用于写作等"},{"id":10214,"word":"历历落落","pinyin":"lì lì luò luò","abbr":"llll","explanation":"清清楚楚。指零乱不堪、参差不齐的样子。","source":{"text":"所谓一杖一条痕，一掴一掌血，使之历历落落，分明开去，莫要含糊。","book":"宋·朱熹《朱子语类》第115卷"},"example":{"text":"船夫们往来上下～若甚杂乱。","book":"茅盾《归途杂拾》"},"similar":["清清楚楚"],"usage":"作谓语、定语；指凌乱"},{"id":10215,"word":"历尽沧桑","pinyin":"lì jìn cāng sāng","abbr":"ljcs","explanation":"历：经历；沧桑：沧海桑田，指变化很大。形容饱经忧患，经历了许多变故。","example":{"text":"腾霄还是从前的模样，而找已是～。","book":"梁羽生《游剑江湖》第二十五回"}},{"id":10216,"word":"历日旷久","pinyin":"lì rì kuàng jiǔ","abbr":"lrkj","explanation":"经历的时间非常久。","source":{"text":"必且历日旷久，则系牦能挈石，驾马亦能致远。","book":"《史记·田敬仲完世家》：“是人必封不久矣”唐·裴骃集解"},"similar":["旷日持久"],"usage":"作谓语；指经历的时间长"},{"id":10217,"word":"历朝圣训","pinyin":"lì cháo shèng xùn","abbr":"lcsx","explanation":"前几代皇帝的遗训。比喻旧的教条。","source":{"text":"先遣内侍持历代圣训授君，传上言。","book":"梁启超《谭嗣同传》"},"usage":"作主语、宾语；用于处事"},{"id":10218,"word":"历精为治","pinyin":"lì jīng wéi zhì","abbr":"ljwz","explanation":"振奋精神，治理好国家。"},{"id":10219,"word":"历精图治","pinyin":"lì jīng tú zhì","abbr":"ljtz","explanation":"振奋精神，力图治理好国家。","source":{"text":"历精图治，将大有为。","book":"《宋史·神宗纪赞》"},"example":{"text":"请一月三朝，以副～至意。","book":"《清史稿·礼志七》"}},{"id":10220,"word":"历精更始","pinyin":"lì jīng gèng shǐ","abbr":"ljgs","explanation":"振奋精神，从事革新。"},{"id":10221,"word":"历练老成","pinyin":"lì liàn lǎo chéng","abbr":"lllc","explanation":"历练：长久从事而有经验；老成：阅历多。指阅历丰富，练达世事。","source":{"text":"老将军黄滚历练老成，可任军国重务。","book":"明·许仲琳《封神演义》第六十八回"},"example":{"text":"从小儿大妹妹玩笑时就有杀伐决断，如今出了阁，到那府里办事，越发～了。","book":"清·曹雪芹《红楼梦》第十三回"},"similar":["老成历练"],"usage":"作谓语、定语；用于人的阅历"},{"id":10222,"word":"历落嵚崎","pinyin":"lì luò qīn qí","abbr":"llqq","explanation":"嵚崎：山岭高峻的样子，指人品格不凡；历落：形容仪态俊伟，指人的仪表品格特异。比喻人杰出不群，潇洒不凡。","source":{"text":"周伯仁道桓茂伦：嵚崎历落可笑人。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"且消闲，歌呼达旦，一杯擎手。～人间世，最是高名难受。","book":"清·叶绍本《金缕曲·月下醉歌》"}},{"id":10223,"word":"历阶而上","pinyin":"lì jiē ér shàng","abbr":"ljes","explanation":"历：依次。沿着台阶，依次登上。","source":{"text":"迁遂按剑历阶而上。","book":"《礼记·檀弓下》：“杜蒉入寝，历阶而升。”《史记·平原君虞卿列传》"},"example":{"text":"诸候献酬甫毕，管仲～。","book":"明·冯梦龙《东周列国志》第十八回"}},{"id":10224,"word":"厉世摩钝","pinyin":"lì shì mó dùn","abbr":"lsmd","explanation":"厉：劝勉；钝：鲁钝。指磨砺世人，使笨拙的人奋发有为。","source":{"text":"爵禄束帛者，天下之底石，高祖所以厉世摩钝也。","book":"东汉·班固《汉书·梅福传》"},"example":{"text":"洵可谓热心公益而～者矣。","book":"清·徐自华《鉴湖女侠秋君墓表》"},"similar":["厉世磨钝"],"usage":"作谓语；指激励世人，使笨拙的人奋发有为"},{"id":10225,"word":"厉兵秣马","pinyin":"lì bīng mò mǎ","abbr":"lbmm","explanation":"厉：同“砺”，磨；兵：兵器；秣：喂牲口。磨好兵器，喂好马。形容准备战斗。","source":{"text":"郑穆公使视客馆，则束载厉兵秣马矣。","book":"《左传·僖公三十三年》"},"example":{"text":"孙权克仗先烈，雄据江东，举贤任能，～，以伺中国之变。","book":"宋·陈亮《酌古论·吕蒙》"},"similar":["秣马厉兵","严阵以待"],"opposite":["高枕无忧"],"usage":"作谓语、定语；指准备战斗","story":["春秋时期，秦国、晋国联合围攻郑国，郑国派大臣烛之武单独与秦国结盟，按约秦国派杞子、逢孙和杨孙率军驻在郑国，秦国退兵。杞子派人偷偷回国要秦穆公出兵，秦军就大举进攻，郑国商人弦高冒充使臣警告秦国，秦国只好攻打滑国"]},{"id":10226,"word":"厉兵粟马","pinyin":"lì bīng sù mǎ","abbr":"lbsm","explanation":"磨快兵器喂饱马。指准备作战。","source":{"text":"虽孽竖跳梁，士力未完，宜厉兵粟马，乘无备，击不意，百下百全。","book":"《新唐书·刘仁轨传》"},"similar":["厉兵秣马","励兵秣马","励戈秣马"],"opposite":["马放南山"],"usage":"作谓语；指准备战斗"},{"id":10227,"word":"厉志贞亮","pinyin":"lì zhì zhēn liàng","abbr":"lzzl","explanation":"厉志：激励心志。志行坚贞，品德高尚。","source":{"text":"虓厉志贞亮，无愧古烈。","book":"《晋书·周访传》"}},{"id":10228,"word":"厉精为治","pinyin":"lì jīng wéi zhì","abbr":"ljwz","explanation":"振奋精神，设法把国家治理好。","source":{"text":"宣帝始亲万机，厉精为治，练群臣，核名实，而相总领众职，甚称上意。","book":"《汉书·魏相传》"},"example":{"text":"荆州军旅之后，公私空乏，憺［萧憺］～，广屯田，省力役，存问兵死之家，供其乏困。","book":"《资治通鉴·梁武帝天监元年》"},"usage":"作谓语、宾语；用于统治者"},{"id":10229,"word":"厉精图治","pinyin":"lì jīng tú zhì","abbr":"ljtz","explanation":"厉：振作，振奋；图：设法，谋求；治：治理国家。振奋精神，想办法治理好国家","source":{"text":"熙宁中，王介甫初参大政，神考方厉精图治。","book":"宋·邵博《闻见后录》第23卷"},"example":{"text":"《清史稿·礼志》：“请一月三朝，以副～至意。”"},"similar":["励精图治","厉精求治","厉精为治"],"usage":"作主语、谓语、宾语；用于统治者"},{"id":10230,"word":"厉精更始","pinyin":"lì jīng gēng shǐ","abbr":"ljgs","explanation":"厉：振作，奋勉；更始：除旧布新。振奋精神，进行革新。","source":{"text":"其赦天下，与士大夫厉精更始。","book":"《汉书·宣帝纪》"},"example":{"text":"上有～之意，而士大夫之苟且不务任责者自若。","book":"《宋史·乔行简传》"},"usage":"作谓语；指振奋精神，进行革新"},{"id":10231,"word":"厉精求治","pinyin":"lì jīng tú zhì","abbr":"ljqz","explanation":"图：谋求，设法。厉：奋勉。治：治理。振奋精神，设法把国家治理好。亦作“励精图治”、“厉精求治”、“厉精为治”。","source":{"text":"厉精图治，将大有为。","book":"《宋史·神宗纪赞》"},"example":{"text":"请一月三朝，以副～至意。","book":"《清史稿·礼志七》"},"similar":["厉精图治","励精求治"],"usage":"作谓语、宾语；用于统治者"},{"id":10232,"word":"厉行节约","pinyin":"lì xíng jié yuē","abbr":"lxjy","explanation":"厉：严格。严格地实行节约。","source":{"text":"要使我国富强起来，需要几十年艰苦奋斗的时间，其中包括执行厉行节约、反对浪费这样一个勤俭建国的方针。","book":"毛泽东《关于正确处理人民内部矛盾的问题》"},"example":{"text":"工作中必须厉行节约，反对浪费。"},"opposite":["铺张浪费","解甲归田","偃旗息鼓"],"usage":"作谓语、宾语；指严格认真地实行节约"},{"id":10233,"word":"压倒一切","pinyin":"yā dǎo yī qiè","abbr":"ydyq","explanation":"精神气度高高在上，把一切都比下去了。","source":{"text":"他身穿着玄色皱纱时行的棉袍，罩着一件深蓝库缎巴图鲁马甲，飞扬神俊，有压倒一切的气概。","book":"陆士谔《续孽海花》第33回"},"example":{"text":"以～的气势宣告旧时代一去不复返了。","book":"邓拓《钱松曑的山水画》"},"usage":"作谓语、定语；指最重要的东西"},{"id":10234,"word":"压倒元白","pinyin":"yā dǎo yuán bái","abbr":"ydyb","explanation":"元、白：指唐代诗人元稹和白居易。用来比喻作品胜过同时代有名的作家。","source":{"text":"时元、白俱在，皆赋诗于席上。唯刑部杨汝士侍郎后成。元、白览之失色。……汝士其日大醉，归谓子弟曰：‘我今日压倒元、白。’","book":"五代·王定保《唐摭言·慈恩寺题名游赏赋咏杂记》卷三"},"example":{"text":"辞章～。","book":"元·钟嗣成《录鬼簿》卷下"},"usage":"作谓语、定语；指有名的作家","story":["唐宝历年间，杨嗣复在新昌里宅邸宴客，诗人元稹、白居易也在座。宾客们在一块赋诗助兴，邢部侍郎杨汝士的诗最后写成。元稹、白居易一看大惊失色，杨汝士特别高兴，喝得醉醺醺的回家对子弟说：“我今日压倒元白。”"]},{"id":10235,"word":"压卷之作","pinyin":"yā juàn zhī zuò","abbr":"yjzz","explanation":"压：超过。指诗文书画中能超过其它同类作品的、最出色的作品。","example":{"text":"请把你的～拿来展览"},"usage":"作主语、宾语；用于书画等"},{"id":10236,"word":"压寨夫人","pinyin":"yā zhài fū rén","abbr":"yzfr","explanation":"指山寨头领的妻子。","source":{"text":"半万贼屯合寺门，手横着霜刃，高叫道要莺莺做压寨夫人。","book":"元·王实甫《西厢记》"},"example":{"text":"你愿意做我的～吗？"},"similar":["正宫娘娘"],"usage":"作主语、宾语、定语；指妻子"},{"id":10237,"word":"压山探海","pinyin":"yā shān tàn hǎi","abbr":"ysth","explanation":"形容人数众多。","example":{"text":"外面到处是人群，好像～似的。"},"usage":"作谓语、宾语；用于口语"},{"id":10238,"word":"压岁钱","pinyin":"yā suì qián","abbr":"ysq","explanation":"过阴历年时长辈给小孩儿的钱。","source":{"text":"两府男妇小厮丫鬟亦按差役上中下行礼毕，散押岁钱、荷包、金银锞，摆上合欢宴来。","book":"清·曹雪芹《红楼梦》"},"usage":"作主语、宾语、定语；用于口语"},{"id":10239,"word":"压线年年","pinyin":"yā xiàn nián nián","abbr":"yxnn","explanation":"压线：指缝纫；年年：年复一年。年年作缝纫活。比喻徒为他人长期忙碌。","source":{"text":"苦恨年年压金线，为他人作嫁衣裳。","book":"唐·秦韬玉《贫女》"},"example":{"text":"～事已非，泪痕零落旧征衣。如何窈窕如花女，也学来鸿去燕飞？","book":"清·魏子安《花月痕》第二十六回"}},{"id":10240,"word":"压肩叠背","pinyin":"yā jiān dié bèi","abbr":"yjdb","explanation":"指人众多密集。","source":{"text":"江州府看的人，真乃压肩叠背，何止一二千人。","book":"《水浒传》第四十回"},"example":{"text":"火车站站前广场人山人海，人们～，纷乱不堪"},"similar":["挨肩叠背"],"usage":"作谓语、定语；用于人群拥挤的场面"},{"id":10241,"word":"压肩迭背","pinyin":"yā jiān dié bèi","abbr":"yjdb","explanation":"迭：重迭。形容观看的人极多。","source":{"text":"江州府看的人，真乃压肩迭背，何止一二千人。","book":"明·施耐庵《水浒全传》第四十回"},"similar":["挨肩迭背"],"usage":"作谓语、定语；形容人多"},{"id":10242,"word":"压良为贱","pinyin":"yā liáng wéi jiàn","abbr":"ylwj","explanation":"旧指强买平民女子为奴婢。","source":{"text":"自烈祖相吴，禁压良为贱。","book":"宋·司马光《资治通鉴·后晋天福八年》"},"example":{"text":"洞山云：‘和尚莫～。’","book":"宋·释道原《景德传灯录·池州南泉普愿禅师》"},"similar":["逼良为娼"],"usage":"作谓语、定语；指逼良为娼"},{"id":10243,"word":"压轴戏","pinyin":"yā zhóu xì","abbr":"yzx","explanation":"压：压倒，超过；轴：大轴。指放到最后的最精彩的项目。","source":{"text":"大观园里的压轴戏是刘姥姥骂山门。那是要老旦出场的。","book":"鲁迅《大观园的人才》"},"usage":"作主语、宾语、定语；指精彩节目"},{"id":10244,"word":"压雪求油","pinyin":"yā xuě qiú yóu","abbr":"yxqy","explanation":"比喻难以作到的事。","source":{"text":"八戒道：‘莫管，我这一去，钻冰取火寻斋至，压雪求油化饭来。’","book":"明·吴承恩《西游记》第二十八回"},"usage":"作宾语、定语；用于比喻句"},{"id":10245,"word":"厌塞众议","pinyin":"yàn sāi zhòng yì","abbr":"yszy","explanation":"厌塞：压制、抑制。压制各种意见。","source":{"text":"其所举奏，莫不厌塞众议。","book":"《后汉书·范滂传》"}},{"id":10246,"word":"厌家鸡，爱野雉","pinyin":"yàn jiā jī，ài yě zhì","abbr":"yjjayz","explanation":"厌：憎恶；雉：野鸡。憎恶家鸡，喜欢野鸡。原意是晋庚翼把自己的书法喻为家鸡，把王羲之的书法喻为野鸡。比喻贱近贵远。","source":{"text":"在荆州与都下书云：‘小儿辈贱厌家鸡，爱野雉，皆进逸少书，须吾还，当比之。’","book":"晋·何法盛《晋中兴书》第七卷"}},{"id":10247,"word":"厌故喜新","pinyin":"yàn gù xǐ xīn","abbr":"ygxx","explanation":"讨厌旧的，喜欢新的。","source":{"text":"使天地大义有所废阙，而厌故喜新，败亡相寻而不悟也。","book":"《问答上》"},"example":{"text":"夫人类之中，有一普通之性质，此～是也。","book":"刘师培《人类均力说》"},"similar":["喜新厌旧"],"usage":"作谓语、宾语、定语；指喜新厌旧"},{"id":10248,"word":"厌旧喜新","pinyin":"yàn jiù xǐ xīn","abbr":"yjxx","explanation":"厌弃旧的，喜欢新的。多指爱情不专一。","source":{"text":"卵则惟因妄想而生；胎因男女爱欲之情而有；湿以自业及外境暖湿之气和合而感；化以厌旧喜新，离此托彼而应。","book":"《楞严经》卷四"},"example":{"text":"诸位都在声声念旧，我当然也不能～。","book":"吴越《括仓山恩仇记》第七十二回"}},{"id":10249,"word":"厌闻饫听","pinyin":"yàn wén yù tīng","abbr":"ywyt","explanation":"指充分听取。","source":{"text":"既已得其所处之乐，而厌闻饫听其人民之事，而江君又有聪明敏急之材。","book":"宋·曾巩《送江任序》"},"usage":"作谓语、定语；用于书面语"},{"id":10250,"word":"厌难折冲","pinyin":"yàn nán zhé chōng","abbr":"ynzc","explanation":"指能克服困难，抗敌取胜。","source":{"text":"故虞有宫之奇，晋献公为之终夜不寐；楚有子玉、得臣，文公为之侧席而坐。远乎！贤者之厌难折冲也。","book":"汉·刘向《说苑·尊贤》"},"example":{"text":"明·文征明《乡里祭沈都宪文》：“～，边用靖谧。”"},"similar":["折冲厌难"],"usage":"作宾语、定语；用于书面语"},{"id":10251,"word":"厕足其间","pinyin":"cè zú qí jiān","abbr":"czqj","explanation":"厕足：插足。在里面插一脚。","source":{"text":"绝无一女子厕足其间，而仍光怪陆离，不感寂寞，大为超俗。","book":"鲁迅《月界旅行辩言》"},"example":{"text":"这件事我不想～。"},"similar":["蹑足其间"],"usage":"作谓语；比喻参与了某事"},{"id":10252,"word":"厕身其间","pinyin":"cè shēn qí jiān","abbr":"csqj","explanation":"指某件事自己参与在内。","example":{"text":"你们处理吧，我不想～。"},"similar":["厕足其间"],"opposite":["超然象外","置身事外","超然事外"],"usage":"作谓语、宾语；用于书面语"},{"id":10253,"word":"厘奸剔弊","pinyin":"lí jiān tì bì","abbr":"ljtb","explanation":"厘：整理，治理。整治坏人坏事，革新社会弊端。","source":{"text":"既而巡按苏、松，厘奸剔弊。","book":"清·王士慎《池北偶谈·葛端肃公家训》"}},{"id":10254,"word":"厚今薄古","pinyin":"hòu jīn bó gǔ","abbr":"hjbg","explanation":"厚：推崇，重视；薄：轻视，怠慢。重视现代的，轻视古代的。多用于学术研究方面。","source":{"text":"宋初讹而新：从质及讹，弥迈弥澹。何则？竞今疏古，风味气衰也。","book":"南朝·梁·刘勰《文心雕龙·通变》"},"example":{"text":"～是中国史学的传统。","book":"范文澜《历史研究必须厚今薄古》"},"opposite":["厚古薄今"],"usage":"作主语、谓语、定语；多用于学术研究方面"},{"id":10255,"word":"厚古薄今","pinyin":"hòu gǔ bó jīn","abbr":"hgbj","explanation":"厚：推崇，重视；薄：轻视，怠慢。推崇古代的，轻视现代的。多用于学术研究方面。","source":{"text":"夫尊古而卑今，学者之流也。","book":"《庄子·外物》"},"example":{"text":"～，是剥削阶级为维护自己的统治，不许人民进步的手法。","book":"谢觉哉《小谈今古》"},"similar":["尊古卑今","重古轻今","是古非今"],"opposite":["厚今薄古","今非昔比"],"usage":"作主语、谓语、定语；指推崇古代的轻视现代"},{"id":10256,"word":"厚味腊毒","pinyin":"hòu wèi xī dú","abbr":"hwxd","explanation":"指味美者毒烈。","source":{"text":"厚味，喻重禄也。腊，亟也，读若‘广’。昔酒焉，味厚者，其毒亟也。","book":"《国语·周语下》：“高位寔疾颠，厚味寔腊毒。”韦昭注"},"example":{"text":"～，物极必反。","book":"章炳麟《检论·订文》附录《正名杂义》"},"usage":"作宾语、定语；用于处事"},{"id":10257,"word":"厚往薄来","pinyin":"hòu wǎng báo lái","abbr":"hwbl","explanation":"在交往中施予丰厚而纳受微薄。","source":{"text":"厚往，谓诸侯还国，王者以其材贿厚重往报之。薄来，谓诸侯贡献使轻薄而来。如此，则诸侯归服。","book":"《礼记·中庸》：“厚往而薄来，所以怀诸侯也。”孔颖达疏"},"example":{"text":"不利其土地，不劳其人民，～，羁縻而已。","book":"明·陈子龙《用夷目兵》"},"usage":"作宾语、定语；用于处事"},{"id":10258,"word":"厚德载物","pinyin":"hòu dé zài wù","abbr":"hdzw","explanation":"旧指道德高尚者能承担重大任务。","source":{"text":"君子以厚德载物。","book":"《周易·坤》"},"example":{"text":"乾坤以有亲可久，君子以～。","book":"晋·潘岳《西征赋》"},"usage":"作谓语、定语；指厚德育人"},{"id":10259,"word":"厚德载福","pinyin":"hòu dé zǎi fú","abbr":"hdzf","explanation":"后指有德者能多受福。","source":{"text":"吾闻之，唯厚德者能受多福，无德而服者众，必自伤也。","book":"《易·坤》：“地势坤，君子以厚德载物。”《国语·晋语六》"},"usage":"作宾语、定语；用于书面语"},{"id":10260,"word":"厚施薄望","pinyin":"hòu shī bó wàng","abbr":"hsbw","explanation":"施舍接济别人的很多，但并不希求人家知恩报答。","source":{"text":"及解年长，更折节为俭，以德报怨，厚施而薄望。","book":"《史记·郭解列传》"}},{"id":10261,"word":"厚栋任重","pinyin":"hòu dòng rèn zhòng","abbr":"hdrz","explanation":"栋：房屋的正梁。栋梁必须粗大才能承受得住巨大的压力。比喻有德行、有才能的人的才可以担任重要职务。","source":{"text":"不厚其栋，不能任重；重莫如国，栋莫如德。","book":"《国语·鲁语》"}},{"id":10262,"word":"厚此薄彼","pinyin":"hòu cǐ bó bǐ","abbr":"hcbb","explanation":"重视或优待一方，轻视或怠慢另一方。比喻对两方面的待遇不同。","source":{"text":"所以然者，出嫁则有受我，出后则有传重，并欲薄于此而厚于彼，此服虽降，彼服则隆。","book":"《梁书·贺琛传》"},"example":{"text":"张树声出身淮军，对边军支援，～，已经有许多人说过话。","book":"高阳《清宫外史》下册"},"similar":["另眼相看","薄彼厚此","厚彼薄此"],"opposite":["不偏不倚","天公地道","一视同仁"],"usage":"作谓语、宾语、定语、状语；形容对事物有偏"},{"id":10263,"word":"厚生利用","pinyin":"hòu shēng lì yòng","abbr":"hsly","explanation":"指富裕民生物尽其用。","source":{"text":"利用者，工作什器，商通货财之类，所以利民之用也。厚生者，衣帛食肉，不饥不寒之类，所以厚民之生也。","book":"语出《书·大禹谟》：“正德，利用，厚生，惟和。”蔡沈集传"},"example":{"text":"举凡政治之所营，教育之所期，文学技术之所风尚，万马奔驰，无不齐集于～之一途。","book":"陈独秀《敬告青年》"},"usage":"作宾语、定语；用于书面语"},{"id":10264,"word":"厚皮老脸","pinyin":"hòu pí lǎo liǎn","abbr":"hpll","explanation":"指人脸皮厚，不知羞耻。","source":{"text":"想不到外国去了一趟，学得这样厚皮老脸，也许混在鲍小姐那一类女朋友里训练出来的。","book":"钱钟书《围城》"},"usage":"作宾语、定语；用于口语"},{"id":10265,"word":"厚礼卑辞","pinyin":"hòu lǐ bēi cí","abbr":"hlbc","explanation":"丰厚的礼品，谦卑的言辞。","source":{"text":"我本待要养性修真避世尘，今日个厚礼卑辞征聘紧。","book":"元·高文秀《襄阳会》楔子"}},{"id":10266,"word":"厚禄重荣","pinyin":"hòu lù zhòng róng","abbr":"hlzr","explanation":"俸禄优厚，官居高位。","source":{"text":"如使臣享厚禄，居重荣，衣狐坐熊，而无事于世者，固所不能安也。","book":"《宋书·王僧达传》"}},{"id":10267,"word":"厚禄高官","pinyin":"hòu lù gāo guān","abbr":"hlgg","explanation":"禄：俸禄。泛指职位高，待遇优。","source":{"text":"下之不能积日累劳，取尊官厚禄，以为宗族交游光宠。","book":"《荀子·议兵》：“是高爵丰禄之所加也，荣孰大焉。”汉·司马迁《报任少卿书》"},"example":{"text":"有些清朝人却较为聪明，虽然辫发胡服，～，他也一声不响。","book":"鲁迅《集外集·选本》"},"similar":["高官厚禄"],"usage":"作宾语、定语；泛指职位高，待遇优"},{"id":10268,"word":"厚积薄发","pinyin":"hòu jī bó fā","abbr":"hjbf","explanation":"厚积：指大量地、充分地积蓄；薄发：指少量地、慢慢地放出。多多积蓄，慢慢放出。形容只有准备充分才能办好事情。"},{"id":10269,"word":"厚貌深情","pinyin":"hòu mào shēn qíng","abbr":"hmsq","explanation":"外貌厚道，内心不可捉摸。","source":{"text":"人者厚貌深情，故有貌愿而益，有长若不肖。","book":"《庄子·列御寇》"},"example":{"text":"然民伪日滋，～，其变午状，昭明者十之六七，两可难决亦十而二三也。","book":"明·海瑞《兴革条例·刑属·疑狱》"},"similar":["厚貌深辞","厚貌深文"],"usage":"作谓语、定语；指外貌厚道，内心不可捉摸"},{"id":10270,"word":"厚貌深文","pinyin":"hòu mào shēn wén","abbr":"hmsw","explanation":"外貌厚道，内心不可捉摸。同“厚貌深情”。","source":{"text":"指天誓日，厚貌深文，足以动人。","book":"清·陈梦雷《绝交书》"},"similar":["厚貌深辞","厚貌深情"],"usage":"作谓语、定语；指外貌厚道，内心不可捉摸"},{"id":10271,"word":"厚貌深辞","pinyin":"hòu mào shēn cí","abbr":"hmsc","explanation":"外貌厚道，内心不可捉摸。同“厚貌深情”。","source":{"text":"小娥厚貌深辞，聪明端特，煤炼指跛足，誓求真如。","book":"唐·李公佐《谢小娥传》"},"similar":["厚貌深情","厚貌深文"],"usage":"作谓语、定语；指外貌厚道，内心不可捉摸"},{"id":10272,"word":"厚酒肥肉","pinyin":"hòu jiǔ féi ròu","abbr":"hjfr","explanation":"厚：浓厚。指丰盛的饮食。","source":{"text":"夫香美脆味，厚酒肥肉，甘口而病形。","book":"战国·韩·韩非《韩非子·扬权》"},"example":{"text":"我不会对这～感兴趣的。"},"similar":["肥肉厚酒","大鱼大肉"],"usage":"作主语、宾语、定语；指美食"},{"id":10273,"word":"厚重少文","pinyin":"hòu zhòng shǎo wén","abbr":"hzsw","explanation":"厚重：敦厚稳重；文：文采。形容人稳重敦厚，质朴平实。","source":{"text":"机云入洛，厌北人厚重少文，嗜羊枣而啖酥酪，不如南方之莼羹鱼脍，辄目之为伧父。","book":"《余嘉锡论文学杂著·释伧楚》"},"usage":"作谓语、定语；用于为人"},{"id":10274,"word":"厚颜无耻","pinyin":"hòu yán wú chǐ","abbr":"hywc","explanation":"颜：脸面。指人脸皮厚，不知羞耻。","source":{"text":"岂可使芳杜厚颜，薜荔蒙耻。","book":"《诗经·小雅·巧言》：“巧言如簧，颜之厚矣。”南朝·齐·孔稚圭《北山移文》"},"example":{"text":"此种自私自利完全蔑视国家利益之理由，北平各团体竟敢说出，吾人殊服其～。","book":"鲁迅《伪自由书·战略关系》引周敬侪《奇文共赏》"},"similar":["恬不知耻"],"opposite":["自惭形秽"],"usage":"作宾语、状语；指人脸皮厚"},{"id":10275,"word":"厝火燎原","pinyin":"cuò huǒ liǎo yuán","abbr":"chly","explanation":"放火燎原，比喻小乱子酿成大祸患。","source":{"text":"惟近日东北用兵，聚三大帅娄十万众，尽没辽水，坐成厝火燎原之势，差为不竞耳。","book":"明·沈德符《野获编·兵部·西南诸捷》"},"usage":"作宾语、定语；用于劝诫人"},{"id":10276,"word":"厝火积薪","pinyin":"cuò huǒ jī xīn","abbr":"chjx","explanation":"厝：放置；薪：柴草。把火放到柴堆下面。比喻潜伏着很大危险。","source":{"text":"夫抱火厝之积薪之下，而寝其上，火未及燃，因谓之安，偷安者也。","book":"汉·贾谊《新书·数宁》"},"example":{"text":"乃事过境迁，恬嬉如故，～之下，而寝处其上，酣歌恒舞，民怨沸腾，卒至鱼烂土崩，不可收拾。","book":"蔡东藩、许廑父《民国通俗演义》"},"similar":["盲人瞎马","朝不保夕","危在旦夕"],"usage":"作宾语、定语；比喻隐藏极大的祸患","story":["西汉初年，著名的政治家贾谊多次向汉文帝上书陈述社会的弊端，写出了著名的《陈政事疏》，他认为当前的政治局势很不好，出现很多违背情理、伤害道义的事情，应该想办法革除。如果看不到的话就像厝火积薪一样危险"]},{"id":10277,"word":"厝薪于火","pinyin":"cuò xīn yú huǒ","abbr":"cxyh","explanation":"厝：同“措”，放置；薪：柴。置柴堆于火之上。比喻潜伏着极大危机。","source":{"text":"躬蹈四罪，而犹逞志角力，谬欲收拾人心，是厝薪于火而云安，结巢于幕而云固也。","book":"《清史稿·诸王》"},"similar":["厝火积薪","积薪厝火"],"usage":"作宾语、定语；比喻隐藏极大的祸患"},{"id":10278,"word":"原原委委","pinyin":"yuán yuán wěi wěi","abbr":"yyww","explanation":"原原本本。","source":{"text":"且说这段故事出在那个地方，甚么人家，怎的起头，怎的了结？看官不要性急，待小子原原委委说来。","book":"明·凌濛初《二刻拍案惊奇》卷九"},"example":{"text":"［门上大叔］见冤鬼来打听，弗瞒天，弗瞒地，～，一本直说。","book":"清·张南庄《何典》第八回"},"similar":["原原本本"],"usage":"作宾语、状语；用于事情等"},{"id":10279,"word":"原原本本","pinyin":"yuán yuán běn běn","abbr":"yybb","explanation":"从头到尾按原来的样子。指详细叙述事情的全部起因和整个过程，一点不漏。","source":{"text":"元元本本，殚见洽闻。","book":"汉·班固《西都赋》"},"example":{"text":"差官便抢上一步，把这事情～详陈一遍。","book":"清·李宝嘉《文明小史》第十二回"},"similar":["从头到尾","有头有尾"],"opposite":["有头无尾","东鳞西爪"],"usage":"作定语、状语；指实际"},{"id":10280,"word":"原始反终","pinyin":"yuán shǐ fǎn zhōng","abbr":"ysfz","explanation":"探究事物发展的始末。","source":{"text":"此言‘圣人’考察万物之始，故知其所以生，究求万物之终，故知其所以死。","book":"《易·系辞上》：“原始反终，故知死生之说。”高亨注"},"example":{"text":"如曰：‘太虚聚为气，气散为太虚，贤愚同尽’，则何谓‘～，故知死生之说’乎？","book":"清·魏源《默觚上·学篇一》"},"similar":["原始见终","原始要终"],"usage":"作谓语、定语；指追根溯源"},{"id":10281,"word":"原始察终","pinyin":"yuán shǐ chá zhōng","abbr":"yscz","explanation":"原：推求。探求事物发展的起源和结果。","source":{"text":"王迹所兴，原始察终，见盛观衰，论考之行事，略推三代，录秦汉，上记轩辕，下至于兹，著十二本纪，既科条之矣。","book":"《史记·太史公自序》"}},{"id":10282,"word":"原始要终","pinyin":"yuán shǐ yào zhōng","abbr":"ysyz","explanation":"原、要：推求。探求事物发展的起源和结果。","source":{"text":"《易》之为书也，原始要终，以为质也。","book":"《周易·系辞下》"},"example":{"text":"～，而卒背于圣人之道，故名曰异端而不可学也。","book":"宋·陈亮《子房贾生孔明魏征何以学异端》"},"similar":["追根溯源","原始反终","原始见终"],"usage":"作谓语、定语；指追根溯源"},{"id":10283,"word":"原始见终","pinyin":"yuán shǐ jiàn zhōng","abbr":"ysjz","explanation":"考察事物的开端而预见到它的结果。","source":{"text":"仆虽不敏，又素不能原始见终。","book":"汉·王充《论衡˙实知》：“凡圣人见祸福也，亦揆端推类，原始见终。”《三国志·魏书·臧洪传》"},"example":{"text":"晋·葛洪《抱朴子·正郭》：“夫以明并日月，～，且犹有失，不能常中。”"},"similar":["原始反终","原始要终"],"usage":"作谓语、定语；指追根溯源"},{"id":10284,"word":"原宥海涵","pinyin":"yuán yǒu hǎi hán","abbr":"yyhh","explanation":"宥：宽宥，赦罪；原宥：原谅而宽赦其罪；海涵：形容人的肚量大。原谅宽赦其罪，不去计较。","source":{"text":"蕃因朝会，固理膺等，请加原宥，升之爵任。","book":"《后汉书·陈蕃传》"},"example":{"text":"量宏意美，～，刻毒嫉妒，吵闹难堪。","book":"《闺训千字文》"},"opposite":["不可饶恕"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":10285,"word":"原封不动","pinyin":"yuán fēng bù dòng","abbr":"yfbd","explanation":"原封：没有开封。原来贴的封口没有动过。比喻完全按照原样，一点不加变动。","source":{"text":"是你的老婆，这等呵，我可也原封不动，送还你罢。","book":"元·王仲文《救孝子》第四折"},"example":{"text":"他把那个人送来的礼物～地退了回去。"},"similar":["依然如故","纹丝不动","一成不变"],"opposite":["除旧布新","改头换面"],"usage":"作谓语、定语、状语；指不改变任何东西"},{"id":10286,"word":"原封未动","pinyin":"yuán fēng wèi dòng","abbr":"yfwd","explanation":"保持原样，不加变动。","source":{"text":"过节那天设的酒肴，都原封未动，大家感到奇怪。","book":"《太平天国故事歌谣选·竹签的来历》"},"example":{"text":"不要在这次会议上许了愿，到明年召开‘八大’时还照样有那么多缺点、错误，～。","book":"毛泽东《在中国共产党全国代表会议上的讲话》五"},"similar":["原封不动"],"opposite":["面目全非"],"usage":"作谓语、定语、状语；指不改变任何东西"},{"id":10287,"word":"原形毕露","pinyin":"yuán xíng bì lù","abbr":"yxbl","explanation":"原形：原来的形状；毕：完全。本来面目完全暴露。指伪装被彻底揭开。","source":{"text":"讵意被其一火，原形已露，骨肉仅存，死期将至。","book":"清·钱泳《履园丛话·十六·朱方旦》"},"example":{"text":"白纸黑字，虽说印的是魑魅魍魉的话，也未始不可发生另外一种作用：～，看它往哪里逃遁呵！（何其芳《理性与历史》）"},"similar":["真相大白","暴露无遗","不打自招"],"opposite":["不露声色","鬼头鬼脑","藏头露尾"],"usage":"作谓语、定语、宾语；指本来面目"},{"id":10288,"word":"原形败露","pinyin":"yuán xíng bài lù","abbr":"yxbl","explanation":"本来面目暴露出来。","source":{"text":"高疤脸先想以一个老实胆小的小商贩的面目混过厘卡，现在见原形败露，知道哀求无用，只有狠心出一笔大钱来买通。","book":"唐浩明《曾国藩》第一部第九章四"},"example":{"text":"他那～的样子让人恶心"},"similar":["原形毕露"],"usage":"作谓语、定语；用于口语"},{"id":10289,"word":"原心定罪","pinyin":"yuán xīn dìng zuì","abbr":"yxdz","explanation":"追究他心里的动机来确定有无罪过或罪过轻重。","source":{"text":"《春秋》之义，原心定罪。","book":"《汉书·哀帝纪》"},"example":{"text":"欲使朝廷～，便行诛戮，其间有云“苏辙持密命以告人，志在朋邪而害正”。","book":"宋·苏辙《乞验实贾易谢上表所言札子》"}},{"id":10290,"word":"原情定罪","pinyin":"yuán qíng dìng zuì","abbr":"yqdz","explanation":"追究他心里的动机来确定有无罪过或罪过轻重。","source":{"text":"罔上害人，左道乱政，原情定罪，非杀而何！","book":"《旧唐书·王玙传》"},"example":{"text":"乡亭之系有岸，朝廷之系有狱，谁敢作奸犯科；死者不可复生，刑者不可复续，上当～。","book":"明·程登吉《幼学琼林·讼狱》"}},{"id":10291,"word":"原情定过","pinyin":"yuán qíng dìng guò","abbr":"yqdg","explanation":"追究他心里的动机来确定有无罪过或罪过轻重。","source":{"text":"谞闻春秋之义，原情定过，赦事诛意，故许止虽弒君而不罪，赵盾以纵贼而见书。","book":"《后汉书·霍谞传》"}},{"id":10292,"word":"原情比迹","pinyin":"yuán qíng bǐ jì","abbr":"yqbj","explanation":"指探寻原由，比照踪迹。","source":{"text":"凡言成事者，以功著易显；谋几初者，以理隐难昭。斯固原情比迹，所宜推察者也。","book":"《后汉书·任光等传论》"}},{"id":10293,"word":"原本穷末","pinyin":"yuán běn qióng mò","abbr":"ybqm","explanation":"原本：探求根源；穷末：寻究到尽头。追溯事物的由来。","source":{"text":"设象以为民纪、式美以相应，比缀以书，原本穷末。","book":"《管子·小匡》"},"similar":["追根溯源"],"usage":"作谓语、定语、宾语；用于处事"},{"id":10294,"word":"原来如此","pinyin":"yuán lái rú cǐ","abbr":"ylrc","explanation":"原来：表示发现真实情况。原来是这样。","source":{"text":"原来如此，倒教我们悬了几日心。","book":"清·曹雪芹《红楼梦》第六十六回"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“‘～！’胡雪岩很欣赏芙蓉的态度。”"},"usage":"作状语、分句；表示发现真实情形"},{"id":10295,"word":"原汁原味","pinyin":"yuán zhī yuán wèi","abbr":"yzyw","explanation":"食物原有的味道和汤汁。比喻事物的原貌或原有特点。"},{"id":10296,"word":"原璧归赵","pinyin":"yuán bì guī zhào","abbr":"ybgz","explanation":"用蔺相如完璧归赵的典故。指原物归还，并无损失。","source":{"text":"［你］敢是有甚么方法，能把那位客人失去的四百番花边，原璧归赵么？","book":"清·王浚卿《冷眼观》第十八回"},"similar":["完璧归赵","物归原主"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":10297,"word":"原野厌人之肉","pinyin":"yuán běn yàn rén zhī ròu","abbr":"yyyrzr","explanation":"大地都吃饱死人的肉了。比喻战场中战死的人非常多。","source":{"text":"原野厌人之肉，川谷流人之血。","book":"汉·扬雄《法言·渊骞》"}},{"id":10298,"word":"原隰衍沃","pinyin":"yuán xí yǎn wò","abbr":"yxyw","explanation":"原隰：广平低湿的地方。指平坦低湿的肥沃土地。","source":{"text":"犹其原隰之有衍沃也。","book":"《诗经·小雅·信南山》：“畇畇原隰，曾孙田之。”《国语·周语》"},"example":{"text":"民之有口也，犹土之有山川也，财用于是乎出：犹其有～也，衣食於是乎生。","book":"《史记·周本纪》"},"usage":"作宾语、定语；用于书面语"},{"id":10299,"word":"厥角稽首","pinyin":"juè jiǎo qǐ shǒu","abbr":"jjqs","explanation":"厥角：叩头；稽首：叩头到底。古代最恭敬的礼节。","source":{"text":"若崩，厥角稽首。","book":"《孟子·尽心下》"},"example":{"text":"～二百州，正气扫地山河羞！","book":"蔡东藩《元史演义》第二十一回"}},{"id":10300,"word":"厮抬厮敬","pinyin":"sī tái sī jìng","abbr":"stsj","explanation":"厮：互相；敬：尊敬。指互相尊敬。","source":{"text":"这是怎么说？素日咱们都是厮抬厮敬，今日忽然提起这些事来。怪不得人人都说你是个亲近不得的人。","book":"清·曹雪芹《红楼梦》第七十九回"},"example":{"text":"要象如今这样～的，那里能把这些东西白遭塌了呢。","book":"清·曹雪芹《红楼梦》第八十七回"}},{"id":10301,"word":"厮敬厮爱","pinyin":"sī jìng sī ài","abbr":"sjsa","explanation":"厮：互相。即互敬互爱。","source":{"text":"满生与文姬夫妻二人，僡加厮敬厮爱，欢畅非常。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"usage":"作谓语、宾语；指互敬互爱"},{"id":10302,"word":"去伪存真","pinyin":"qù wěi cún zhēn","abbr":"qwcz","explanation":"除掉虚假的，留下真实的。","source":{"text":"实由主义恶华好朴，去伪从真，使海内词人，翕然尊古，有周风雅，再阐今日。","book":"唐·殷璠《河岳英灵集序》"},"example":{"text":"将丰富的感觉材料加以去粗取精、～、由此及彼、由表及里的改造制作功夫。","book":"毛泽东《实践论》"},"similar":["去粗取精","本来面目"],"opposite":["鱼龙混杂","泥沙俱下"],"usage":"作定语、宾语；指筛选资料"},{"id":10303,"word":"去住两难","pinyin":"qù zhù liǎng nán","abbr":"qzln","explanation":"去也不好，留也不好，左右为难。","source":{"text":"去住两情兮谁具陈。","book":"汉·蔡琰《胡笳十八拍》"},"example":{"text":"～，踌躇不决。","book":"明·冯梦龙《东周列国志》第二十九回"},"similar":["进退两难"],"usage":"作宾语、状语、定语；指难以抉择去留"},{"id":10304,"word":"去其糟粕，存其精华","pinyin":"qù qí zāo pò，cún qí jīng huá","abbr":"qqzpcqjh","explanation":"糟粕：酒糟，比喻无用的东西。把有用的东西留下，把无用的东西丢掉。","source":{"text":"他们对于中国的旧东西和外国的新东西……是‘去其糟粕，存其精华’，是‘斟酌国情，两无所偏’。","book":"李锐《毛泽东同志的初期革命活动·学生时代》"},"similar":["取其精华，去其糟粕"],"usage":"作宾语、定语；用于处事"},{"id":10305,"word":"去危就安","pinyin":"qù wēi jiù ān","abbr":"qwja","explanation":"离开危险，趋于安全。","source":{"text":"夫见机而动，周易所称；去危就安，人事常理。","book":"《魏书·慕容白曜传》"},"example":{"text":"一经战阵，非死即逃，我等怎可束手待毙，～，正在今日，未知诸君意下如何？","book":"蔡东藩《五代史演义》第五十三回"},"usage":"作谓语、宾语；用于处事"},{"id":10306,"word":"去天尺五","pinyin":"qù tiān chǐ wǔ","abbr":"qtcw","explanation":"天：指宫廷或皇帝。极言与宫廷相近。","source":{"text":"城南韦杜，去天五尺。","book":"汉·辛氏《三秦记》"},"example":{"text":"泠然棹入川流，～。","book":"宋·张炎《清波引》词"},"usage":"作谓语、定语；用于书面语"},{"id":10307,"word":"去太去甚","pinyin":"qù tai qù shèn","abbr":"qtqs","explanation":"适可而止，不可过分。同“去泰去甚”。","source":{"text":"梁主敕撰《通史》，定为吴蜀世家，持彼僭君，比诸列国，去太去甚，其得折中之规乎。","book":"唐·刘知幾《史通·世家》"},"similar":["去泰去甚","去甚去泰"],"usage":"作谓语、定语；用于劝诫人"},{"id":10308,"word":"去头去尾","pinyin":"qù tóu qù wěi","abbr":"qtqw","explanation":"除去前头后头两部分，也比喻除去没有用的部分。"},{"id":10309,"word":"去如黄鹤","pinyin":"qù rú huáng hè","abbr":"qrhh","explanation":"去：离开。如同仙人骑着黄鹤一般，飞走之后再没回来。比喻走得无影无踪。","source":{"text":"黄鹤一去不复返，白云千载空悠悠。","book":"唐·崔灏《黄鹤楼》诗"},"example":{"text":"贫不自给，典质渐空，日望宫至以为经理，而宫灭迹匿影～矣。","book":"清·蒲松龄《聊斋志异·宫梦弼》"}},{"id":10310,"word":"去害兴利","pinyin":"qù hài xīng lì","abbr":"qhxl","explanation":"去：除掉；兴：兴办。去掉有害的兴办有利的。","source":{"text":"后佐河阳军，任事去害兴利。","book":"唐·韩愈《国子助教河东薛君墓志铭》"},"example":{"text":"神宗修建法度，务以～而已。","book":"清·毕沅《续资治通鉴》卷九十"},"similar":["兴利除弊"],"usage":"作谓语、定语；用于处事"},{"id":10311,"word":"去就之分","pinyin":"qù jiù zhī fēn","abbr":"qjzf","explanation":"去就；进退或取舍。分：分寸。引申为应持的态度。比喻进取、取舍的分寸。亦作“去就之际”。","source":{"text":"仆虽怯懦，欲苟活，亦颇识去就之分矣。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"夫际会之间，请命乞身，何哉？欲洁～也。","book":"明·罗贯中《三国演义》第七十八回"},"similar":["去就之际"],"usage":"作宾语；用于处事"},{"id":10312,"word":"去就之际","pinyin":"qù jiù zhī jì","abbr":"qjzj","explanation":"就：接近。指进退的分寸。","source":{"text":"寻君去就之际非有他故，直以不能内审诸己，外受流言，以至于此。","book":"南朝·梁·丘迟《与陈伯之书》"},"similar":["去就之分"],"usage":"作宾语；用于处事"},{"id":10313,"word":"去恶务尽","pinyin":"qù è wù jìn","abbr":"qewj","explanation":"去：除掉；务：务必。清除坏人一定要彻底。比喻不能姑息坏人坏事。","source":{"text":"树德莫如滋，去疾莫如尽。","book":"《左传·哀公元年》"},"example":{"text":"～，元祐诸贤，不知此义，遂致受殃。","book":"蔡东藩《宋史演义》第四十五回"}},{"id":10314,"word":"去故就新","pinyin":"qù gù jiù xīn","abbr":"qgjx","explanation":"就：归于，留下。除去旧的，留下新的。","source":{"text":"《白虎通》云：‘沽者，故也。洗者，鲜也。’言万物去故就新，莫不鲜明也。","book":"《史记·律书》：“三月也，律中姑洗。”张守节正义"},"example":{"text":"子啜一觞，携朋挈俦，～，驾尘彍风。","book":"唐·韩愈《送穷文》"},"similar":["去故纳新"],"usage":"作宾语、定语；用于书面语"},{"id":10315,"word":"去故纳新","pinyin":"qù gù nà xīn","abbr":"qgnx","explanation":"犹言去旧迎新。","source":{"text":"以迎新年，相聚酣饮，留宿岁饭，至新年十二日，则弃之街衢，以为去故纳新也。","book":"南朝·梁·宗懔《荆楚岁时记》"},"similar":["去故就新"],"usage":"作宾语、定语；用于书面语"},{"id":10316,"word":"去日苦多","pinyin":"qù rì kǔ duō","abbr":"qrkd","explanation":"去日：过去的日子；苦：患，苦于。已经过去的日子太多了。用于感叹光阴易逝之语。","source":{"text":"对酒当歌，人生几何？譬如朝露，去日苦多。","book":"汉·曹操《短歌行》"}},{"id":10317,"word":"去暗投明","pinyin":"qù àn tóu míng","abbr":"qatm","explanation":"脱离黑暗势力，走向光明的道路。","source":{"text":"高鸟相良木而栖，贤臣择明主而佐。背暗投明，古之常理。","book":"元·尚仲贤《单鞭夺槊》楔子"},"example":{"text":"经历～，家眷俱蒙奶奶不杀之恩，周某自当尽心竭力，图效犬马。","book":"明·凌濛初《初刻拍案惊奇》卷三十一"},"similar":["弃暗投明","背暗投明"],"opposite":["死不改悔"],"usage":"作谓语、定语、宾语；指改邪归正"},{"id":10318,"word":"去末归本","pinyin":"qù mò guī běn","abbr":"qmgb","explanation":"去：弃；末：非根本的，古时称工商等业为末业；本：根本的，古称农业为本业。使人民离弃工商业，从事农业，以发展农业生产。","source":{"text":"信臣劝民农桑，去末归本，郡以殷富。","book":"《汉书·地理志下》"},"example":{"text":"将明画一之法，大布惟新之命，陶甄化源，～。","book":"《旧唐书·代宗本纪》"},"usage":"作谓语、定语；指重视农业"},{"id":10319,"word":"去本就末","pinyin":"qù běn jiù mò","abbr":"qbjm","explanation":"指弃农经商。","source":{"text":"郡国辐凑，浮食者多，民去本就末。","book":"东汉·班固《汉书·地理志》"},"similar":["去本趋末"],"opposite":["去末归本"],"usage":"作谓语、宾语、定语；用于选择"},{"id":10320,"word":"去本趋末","pinyin":"qù běn qū mò","abbr":"qbqm","explanation":"指弃农经商。同“去本就末”。","source":{"text":"……诈伪萌生则去本趋末，弃耕作之业而务锥刀之利。","book":"西汉·刘安《淮南子·本经训》：“昔者仓颉作书而天雨粟鬼夜哭。”汉·高诱注"},"similar":["去本就末"],"usage":"作谓语、宾语、定语；用于选择"},{"id":10321,"word":"去杀胜残","pinyin":"qù shā shèng cán","abbr":"qssc","explanation":"感化残暴的人使其不再作恶，便可废除死刑。也指以德化民，太平至治。","source":{"text":"感化残暴的人使其不再作恶，便可废除死刑。也指以德化民，太平至治。"},"example":{"text":"《论语·子路》：“善人为邦百年，亦可以胜残去杀矣。”《汉书·李广传》：“夫报忿除害，捐残去杀，朕之所图于将军也。"},"similar":["胜残去杀","捐残去杀"],"usage":"作宾语、定语；指以德化民"},{"id":10322,"word":"去梯之言","pinyin":"qù tī zhī yán","abbr":"qtzy","explanation":"拿走上楼用的梯子后，再民之交谈。比喻极端机密的话。","source":{"text":"琦乃将亮游观后园，共上高楼。饮宴之间，令人去梯，因谓亮曰：‘今日上不至天，下不至地，言出子口，入于吾耳，可以言示？’","book":"《三国志·蜀志·诸葛亮传》"},"example":{"text":"此万世一时，机不可失。仆荷眷深重，故吐～，宜详其祸福。","book":"《宋书·蔡兴宗传》"},"usage":"作宾语；用于谈话等","story":["东汉末年，刘表把新野送给刘备，让刘备抵御曹操。同时准备让次子刘琮继承自己的位置，这让长子刘琦感到处境比较危险。刘琦请诸葛亮到自家后花园高楼上吃饭，命人把楼梯撤去，虚心向诸葛亮求救，诸葛亮要刘琦去当江夏太守脱险"]},{"id":10323,"word":"去泰去甚","pinyin":"qù tài qù shèn","abbr":"qtqs","explanation":"泰、甚：过分。适可而止，不可过分。","source":{"text":"天下神器不可为也。为者败之，执者失之……是以圣人去甚、去奢、去泰。","book":"语出《老子》"},"example":{"text":"匪朴匪斵，～。","book":"晋·左思《魏都赋》"},"similar":["去甚去泰","去太去甚"],"usage":"作谓语、定语；用于劝诫人"},{"id":10324,"word":"去甚去泰","pinyin":"qù shèn qù tài","abbr":"qsqt","explanation":"指做事不能太过分。","source":{"text":"故去甚去泰，身乃无害。","book":"语出《老子》第二十九章：“是以圣人去甚、去奢、去泰。”《韩非子·扬权》"},"example":{"text":"惟静惟默，澄神之极；～，居物之外。","book":"唐·姚元崇《口箴》"},"similar":["去泰去甚"],"usage":"作谓语、定语；用于劝诫人"},{"id":10325,"word":"去粗取精","pinyin":"qù cū qǔ jīng","abbr":"qcqj","explanation":"除去粗糙的部分，留取其精华。","source":{"text":"将丰富的感觉材料加以去粗取精、去伪存真、由此及彼、由表及里的改造制作工夫。","book":"毛泽东《实践论》"},"example":{"text":"对于古典文学，我们要～，辩证对待。"},"similar":["取精用宏"],"opposite":["眉毛胡子一把抓"],"usage":"作定语、宾语；用于文化方面"},{"id":10326,"word":"去而之他","pinyin":"qù ér zhī tā","abbr":"qezt","explanation":"之：到，往。离开一个地方又到另一个地方去。","source":{"text":"卒之东郭墦间，之祭者，乞其余，不足，又顾而之他。","book":"《孟子·离娄下》"},"example":{"text":"能胜敌则迫众推戴，还废怀帝，不能胜敌，即～，或仍回东海，据守一方。","book":"蔡东藩《两晋演义》第二十三回"},"usage":"作谓语、定语；用于书面语"},{"id":10327,"word":"去芜存精","pinyin":"qù wú cún jīng","abbr":"qwcj","explanation":"芜：芜杂。除去粗糙的部分，留取其精华。","source":{"text":"上海京剧院将这样一出冷了多年的老戏，经过去芜存精加以重新编排，使其重放麟派艺术的光彩。","book":"《人民日报》"},"similar":["去粗取精","去芜存菁"],"usage":"作定语、宾语；用于文化方面"},{"id":10328,"word":"去芜存菁","pinyin":"qù wú cún jīng","abbr":"qwcj","explanation":"芜：芜杂。除去粗糙的部分，留取其精华。","example":{"text":"我们写作收集材料时要～，文章才会精练。"},"similar":["去芜存精","去粗取精"],"usage":"作定语、宾语；用于文化方面"},{"id":10329,"word":"去逆效顺","pinyin":"qù nì xiào shùn","abbr":"qnxs","explanation":"逆：违背。脱离叛逆者，效法忠于国家的人。","source":{"text":"如能去逆效顺，因事建功，明设科条，以示褒劝。","book":"唐·陆贽《诏谕淮西将吏诏》"},"example":{"text":"当由四川省臣据实奏闻，文宗以他～，厚加慰谕。","book":"蔡东藩《元史演义》第四十五回"},"usage":"作谓语；用于选择"},{"id":10330,"word":"去邪归正","pinyin":"qù xié guī zhèng","abbr":"qxgz","explanation":"指去掉邪恶，归于正道。","source":{"text":"有能弃邪从正，箪食壶浆以迎王师者，国有常典，封宠大小，各有品限。","book":"《三国志·蜀志·后主传》：“五年春，丞相亮出屯汉中，营沔北阳平石马。”裴松之注引《诸葛亮集》载后主刘禅诏曰"},"example":{"text":"哥哥你说的是壮士言，到京师见帝王，则要你～为良将，治国安邦万人讲。","book":"元·刘元卿《降桑椹》第三折"},"similar":["改邪归正"],"usage":"作谓语、定语；用于书面语"},{"id":10331,"word":"去顺效逆","pinyin":"qù shùn xiào nì","abbr":"qsxn","explanation":"顺、逆：指对君主、国家的叛逆和忠顺。比喻背离道，仿效坏人干坏事。","source":{"text":"去顺效逆，所以速祸也。","book":"《左传·隐公三年》"},"example":{"text":"试想用弱敌强，怎得为明？～，怎得为智？去顺效逆，怎得为忠？","book":"蔡东藩《后汉演义》第四十六回"}},{"id":10332,"word":"去题万里","pinyin":"qù tí wàn lǐ","abbr":"qtwl","explanation":"去：离开。比喻写文章偏离了题目，越扯越远。"},{"id":10333,"word":"去食存信","pinyin":"qù shí cún xìn","abbr":"qscx","explanation":"比喻宁可失去粮食而饿死，也要坚持信义。","source":{"text":"去食，自古缘有死，民无信不立。","book":"《论语·颜渊》"},"example":{"text":"《传》称“～”，孔子曰：“民无信不立。”昔项羽既入咸阳，已制天下，向能力行仁信，谁夺耶？","book":"唐·吴兢《贞观政要·诚信》"},"usage":"作宾语、定语；用于处事","story":["春秋时期，子贡问孔子有关为政之道。孔子说：“有足够的食物与军事力量，百姓讲信义就可以。”子贡问：“迫不得已要去掉其中一项怎么办？”孔子答道：“去兵”，子贡再问还要去掉其中之一怎么办？孔子道：“去食。自古下皆有死，民无信不立。”"]},{"id":10334,"word":"叁天两地","pinyin":"sān tiān liǎng dì","abbr":"stld","explanation":"叁：三。原为易卦立数之义，古代指天取奇数，地取偶数，三是奇数的开端。引申为人的德行可以与天地相比，或人配合天地以成三才。","source":{"text":"叁天两地而倚数。","book":"《周易·说卦》"}},{"id":10335,"word":"参伍错纵","pinyin":"cān wǔ cuò zòng","abbr":"cwcz","explanation":"指交互错杂。同“参伍错综”。","source":{"text":"活数者如揲蓍求卦之初，参伍错纵而阴阳未分者也；死数者如卦画已成之后，为九为六而阴阳既定者也。","book":"明·唐顺之《与万思节主事书》"}},{"id":10336,"word":"参伍错综","pinyin":"cēn wǔ cuò zōng","abbr":"cwcz","explanation":"指交互错杂。","source":{"text":"参伍以变，错综其数。","book":"语出《易·系辞上》"},"example":{"text":"四象经过～，而成了八个和六十四个，“天下之文”和“天下之数”于是尽在其中。圣人再根据这些象，作成许多厚生利用的人间器物。","book":"《原道》"}},{"id":10337,"word":"参前倚衡","pinyin":"cān qián yǐ héng","abbr":"cqyh","explanation":"意指言行要讲究忠信笃敬，站着就仿佛看见“忠信笃敬”四字展现于眼前，乘车就好像看见这几个字在车辕的横木上。泛指一举一动，一。","source":{"text":"子张问行，子曰：‘言忠信，行笃敬，虽蛮貊之邦，行矣。言不忠信，行不笃敬，虽州里，行乎哉？立则见其参於前也，在舆则见其倚於衡也，夫然后行。’子张书诸绅。","book":"《论语·卫灵公》"},"example":{"text":"然以为有物，则何睹何闻；以为无物，则～，瞻前忽后，非胸中不卦世间一物。","book":"明·唐顺之《答王遵岩书》"},"usage":"作谓语、定语；指一切场合"},{"id":10338,"word":"参参伍伍","pinyin":"sān sān wǔ wǔ","abbr":"ccww","explanation":"形容三五成群。","source":{"text":"岸上谁家游冶郎，参参伍伍映垂杨。","book":"唐·李白《采莲曲》"},"similar":["三三五五"],"usage":"作定语、状语；用于书面语"},{"id":10339,"word":"参商之虞","pinyin":"shēn shāng zhī yú","abbr":"sszy","explanation":"参、商：星宿名。参在西、商在东，此出彼没，永不相见。虞：忧虑。比喻人分离不得见面的忧虑。也比喻有不和睦的可能。"},{"id":10340,"word":"参回斗转","pinyin":"shēn huí dǒu zhuǎn","abbr":"shdz","explanation":"指夜深。参，参星；斗，北斗星。","source":{"text":"天近月明黄道冷，参回斗转碧霄空。","book":"宋·张孝祥《望江南》词"},"similar":["深更半夜"],"usage":"作宾语、定语；指夜深"},{"id":10341,"word":"参天两地","pinyin":"sān tiān liǎng dì","abbr":"ctld","explanation":"①为《易》卦立数之义。②引申为人之德可与天地相比。亦作“参天贰地”。","source":{"text":"倚，立也。既用蓍求卦，其揲蓍所得，取奇数于天，取耦数于地。","book":"《易·说卦》：“参天两地而倚数。”孔颖达疏"},"example":{"text":"“二阳一阴成气三。”：“阳之数以三而奇，阴之数以二而偶，所谓～也。”","book":"清·俞樾《诸子平议·淮南子内篇一》"},"similar":["参天贰地"],"usage":"作定语、状语；用于人"},{"id":10342,"word":"参天贰地","pinyin":"cān tiān èr dì","abbr":"cted","explanation":"为《易》卦立数之义。后引申为人之德可与天地相比。同“参天两地”。","source":{"text":"拘文牵俗，循诵习传，当世取说云尔哉！必将崇论闳议，创业垂统，为万世规。故驰骛乎兼容并包，而勤思乎参天贰地。","book":"《史记·卷一百一十七·司马相如列传》第五十七"},"example":{"text":"东汉·班固《汉书·司马相如传下》：“而勤思乎～。”"},"similar":["参天两地"],"usage":"作定语、状语；用于人"},{"id":10343,"word":"参差不一","pinyin":"cēn cī bù yī","abbr":"ccby","explanation":"形容不整齐或不一致。同“参差不齐”。","source":{"text":"周公定礼，内职始备列焉。秦、汉以下，代有沿革，品秩差次，前史载之详矣。齐、梁以降，历魏暨周，废置益损，参差不一。","book":"《南齐书·礼志上》：“至于嗣位之君，参差不一，宜有定制。”《隋书·后妃传》"},"example":{"text":"《南齐书·礼志上》：“至于嗣位之君，参差不一，宜有定制。”《隋书·后妃传》：“周公定礼，内职始备列焉。秦、汉以下，代有沿革，品秩差次，前史载之详矣。齐、梁以降，历魏暨周，废置益损，参差不一。”"},"similar":["参差不齐"],"opposite":["整整齐齐"],"usage":"作谓语、定语；表示不整齐"},{"id":10344,"word":"参差不齐","pinyin":"cēn cī bù qí","abbr":"ccbq","explanation":"参差：长短、高低不齐。形容水平不一或很不整齐。","source":{"text":"参差：长短、高低不齐。形容水平不一或很不整齐。"},"example":{"text":"礼生见他们～，也只好由着他们敷衍了事。","book":"清·李宝嘉《官场现形记》第一回"},"similar":["良莠不齐","犬牙交错"],"opposite":["整齐划一"],"usage":"作谓语、定语、补语；表示不整齐"},{"id":10345,"word":"参差错落","pinyin":"cēn cī cuò luò","abbr":"cccl","explanation":"参差：长短、高低、大小不一致。错落：交错、交织的样子。各种不同的事物，错综复杂地交织在一起。","source":{"text":"那七个铃便不一齐都响，亦复参差错落，应机赴节。","book":"清·刘鹗《老残游记》第十回"},"example":{"text":"我们看韩愈的‘气盛言宜’的理论和他的～的文句，也正是多多少少在口语化。","book":"朱自清《论雅俗共赏》"},"similar":["参差不齐"],"opposite":["井井有条"],"usage":"作谓语、定语；指交错不齐"},{"id":10346,"word":"参横斗转","pinyin":"shēn héng dǒu zhuǎn","abbr":"shdz","explanation":"北斗转向，参星打横。指天快峦的时候。","source":{"text":"参横北斗欲三更。","book":"三国·魏·曹操《善哉行》：“月没参横，北斗阑干。”《宋史·乐志》：“斗转参横将旦，天开地辟如春。”宋·苏轼《六月二十日夜渡海》诗"}},{"id":10347,"word":"参武错纵","pinyin":"sān wǔ cuò zòng","abbr":"cwcz","explanation":"形容交互错杂。","source":{"text":"活数者如揲耆求卦之初，参武错纵而阴阳未分者也。","book":"明·唐顺之《与万思节主事书》"},"similar":["参武错综"],"usage":"作谓语、定语；用于书面语"},{"id":10348,"word":"参武错综","pinyin":"sān wǔ cuò zōng","abbr":"cwcz","explanation":"错综：交错综合。形容交互错杂。","source":{"text":"参武以变，错综其数。","book":"《周易·系辞上》"},"example":{"text":"二曜五纬，～。","book":"清·刘献廷《广阳杂记》第三卷"},"similar":["参武错纵"],"usage":"作谓语、定语；用于书面语"},{"id":10349,"word":"参辰卯酉","pinyin":"shēn chén mǎo yǒu","abbr":"scmy","explanation":"①参、辰，二星名。参星酉时出于西方，辰星卯时出于东方。参与辰，卯与酉相对立，故用以比喻互不相关或势不两立。②犹是非曲直。","source":{"text":"我觑着那珠翠金银，我可便浑如似参辰卯酉。","book":"元·关汉卿《陈母教子》第二折"},"example":{"text":"握金章，悬紫绶，一例唯唯否否，全不管～，只盼到腰缠万贯上扬州。","book":"清·惜秋旅生《维新梦·感愤》"},"similar":["参辰日月","是非曲直"],"usage":"作宾语、定语；指对立"},{"id":10350,"word":"参辰日月","pinyin":"shēn chén rì yuè","abbr":"scry","explanation":"参、辰，二星名。参与辰，日与月相对立，故用以比喻互不相关或势不两立。","source":{"text":"则他这夫妻儿女两离别，总是我业彻，也强如参辰日月不交接。","book":"元·白朴《墙头马上》第三折"}},{"id":10351,"word":"参透机关","pinyin":"cān tòu jī guān","abbr":"ctjg","explanation":"参：检验，察看。机关：阴谋或秘密所在。看透了阴谋和秘密。","source":{"text":"那知孙寡妇已先参透机关，将个假货送来。","book":"明·冯梦龙《醒世恒言·乔太守乱点鸳鸯谱》"},"example":{"text":"她已经～，就不再说什么了。"},"similar":["看破红尘"],"usage":"作谓语；指看透了阴谋和秘密"},{"id":10352,"word":"参错重出","pinyin":"cēn cuò chóng chū","abbr":"cccc","explanation":"参错：参差错落。许多事物交错在一起不断出现。形容事物错综复杂。","source":{"text":"万端千绪，参错重出。","book":"唐·韩愈《殿中侍御史李君墓志铭》"},"similar":["错综复杂"],"usage":"作谓语、定语；用于事物等"},{"id":10353,"word":"又一个弱","pinyin":"yòu yī gè ruò","abbr":"yygr","explanation":"弱：丧失，减少。又少了一个。旧时哀悼人去世的话。","source":{"text":"二惠竞爽犹可，又弱一个焉，姜其危哉！","book":"《左传·昭公三年》"},"example":{"text":"何当远耗来，又惜一个弱。","book":"清·赵翼《扬州哭秋园之讣》"}},{"id":10354,"word":"又作别论","pinyin":"yòu zuò bié lùn","abbr":"yzbl","explanation":"应当另外作出评价。","source":{"text":"这自然是专就我的故乡而言，若是‘模范县’里的人民，那当然又作别论。","book":"鲁迅《朝花夕拾·五猖会》：“他们既然是五猖，便也无法可想，而且自然也就‘又作别论’了。”又《无常》"},"similar":["又当别论"],"usage":"作谓语、宾语；指另外评价"},{"id":10355,"word":"又弱一个","pinyin":"yòu ruò yī gè","abbr":"yryg","explanation":"弱：丧失，减少。又少了一个。旧时哀悼人去世的话。","source":{"text":"二惠竞爽犹可，又弱一个焉，姜其危哉！","book":"《左传·昭公三年》"},"example":{"text":"西山之门，存者几人；～，莫赎百身。","book":"宋·刘克庄《祭林元晋武博文》"},"usage":"作谓语；表示哀悼人去世"},{"id":10356,"word":"又当别论","pinyin":"yòu dāng bié lùn","abbr":"ydbl","explanation":"应当另外作出评价。","source":{"text":"至孙许之荫以锦衣，官二品三品，忠臣之后又当别论。","book":"明·朱国祯《涌幢小品·世荫不同》"},"example":{"text":"到黄金时代的路上，究竟是悲哀，是痛苦，是兴奋，是痛快？这都是～，不在乱弹之列。","book":"瞿秋白《乱弹·世纪末的悲哀》"},"similar":["又作别论"],"usage":"作谓语、分句；指另外评价"},{"id":10357,"word":"又惊又喜","pinyin":"yòu jīng yòu xǐ","abbr":"yjyx","explanation":"既惊讶又高兴。","source":{"text":"忽闻有人唤他，强展星眸，一见是宝玉，又惊又喜，又悲又痛，忙一把死攥住他的手。","book":"清·曹雪芹《红楼梦》第77回"},"example":{"text":"三五年一定胜利，大家听了～。","book":"邓小平《跃进中原的胜利形势与今后的政策策略》"},"similar":["惊喜交集"],"usage":"作谓语、状语；用于意外时","story":["王夫人因发现男女性爱图腾手袋后，对大观园内所有丫鬟进行搜查，赶走了迎春的丫鬟司棋，因宝玉已经成熟，就把漂亮丫鬟晴雯赶出大观园。宝玉偷偷摸摸去晴雯家探望她，晴雯觉得又惊又喜，同时很委屈，只因为长得漂亮就被一口咬定为狐狸精"]},{"id":10358,"word":"又生一秦","pinyin":"yòu shēng yī qín","abbr":"ysyq","explanation":"指又造成一个强敌。","source":{"text":"陈王相国房君谏曰：‘秦未亡而诛武臣等家，此又生一秦也。’","book":"《史记·张耳陈馀列传》"},"example":{"text":"自增仇敌曰～。","book":"宋·胡继宗《书言故事·古今喻类》"},"usage":"作谓语、宾语；用于处事"},{"id":10359,"word":"又红又专","pinyin":"yòu hóng yòu zhuān","abbr":"yhyz","explanation":"具有无产阶级的世界观，又掌握专业知识和专门技术。","source":{"text":"毛泽东同志提倡知识分子又红又专，鼓励大家改造资产阶级世界观，树立无产阶级世界观。","book":"邓小平《在全国科学大会开幕式上的讲话》"},"example":{"text":"我们要做～的新人。"},"similar":["德才兼备"],"usage":"作谓语、定语；指人才"},{"id":10360,"word":"及宾有鱼","pinyin":"jí bīn yoǔ yú","abbr":"jbyy","explanation":"用别人的鱼请客。比喻借机培植私人势力。","source":{"text":"言有他人之物，于义不可及宾也。","book":"《周易·姤》：“包有鱼，义不及宾也。”孔颖达疏"},"example":{"text":"莫教养寇容奸，～。","book":"明·许三阶《节侠记·毒媚》"},"usage":"作谓语、宾语；指培植私人势力"},{"id":10361,"word":"及时应令","pinyin":"jí shí yīng lìng","abbr":"jsyl","explanation":"与季节时令相适应。","source":{"text":"又忙着替孙子做了一套及时应令的棉袍褂，预备开贺的那一天好穿了陪客。","book":"清·李宝嘉《官场现形记》第一回"},"example":{"text":"我们做事应～，否则让人感觉到格格不入。"},"opposite":["不合时宜"],"usage":"作谓语、定语；用于处事"},{"id":10362,"word":"及时行乐","pinyin":"jí shí xíng lè","abbr":"jsxl","explanation":"不失时机，寻欢作乐。","source":{"text":"汉乐府《西门行》诗：“夫为乐，为乐当及时。”《古诗十九首·生年不满百》：“ 为乐当及时，何能待来兹”。"},"example":{"text":"此时离行期尚远，正当～，反要伤悲，岂不将好好时光都变成苦海吗？","book":"清·李汝珍《镜花缘》第六十八回"},"similar":["灯红酒绿","醉生梦死","花天酒地"],"opposite":["奋发图强","乐极生悲"],"usage":"作谓语、宾语、定语、分句；指消极性享乐"},{"id":10363,"word":"及时雨","pinyin":"jí shí yǔ","abbr":"jsy","explanation":"下得非常及时的雨。比喻及时的援助。","source":{"text":"那知无心云，解作及时雨。","book":"宋·李弥孙《赤松》"},"usage":"作宾语、定语；多用于比喻句"},{"id":10364,"word":"及溺呼船","pinyin":"jí nì hū chuán","abbr":"jnhc","explanation":"比喻祸到临头，求救无及。","source":{"text":"臣闻扬汤止沸，不如灭火去薪，溃痈虽痛，胜于养肉，及溺呼船，悔之无及。","book":"《三国志·魏志·董卓传》：“卓遂将其众，迎帝于北芒，还宫”裴松之注引《典略》"},"example":{"text":"初，刘璋遣人迎先主，主簿黄权怒而言曰：‘厝火积薪，其势必焚；～，悔将无及。’","book":"明·冯梦龙《智囊补·明智·黄权》"},"usage":"作谓语、宾语、定语；指为时已晚"},{"id":10365,"word":"及瓜而代","pinyin":"jí guā ér dài","abbr":"jged","explanation":"及：到。到明年瓜熟时派人接替。指任职期满由他人继任。","source":{"text":"齐侯使连称，管至父戍葵丘。瓜时而往，曰：‘及瓜而代。’","book":"《左传·庄公八年》"},"example":{"text":"～，主公所亲许也。","book":"明·冯梦龙《东周列国志》第十四回"},"usage":"作谓语、宾语；指任职期满由他人接替","story":["春秋时期，齐襄公会同宋等四国伐卫，鲁庄公出兵援卫，打败了齐襄公。齐襄公派大将连称、管至父去葵丘驻守。他们迫于压力去了，问什么时候派人去接替。齐襄公随口说声及瓜而代。第二年瓜熟时连称派人给齐襄公送瓜提醒。齐襄公大怒，逼得他们造反"]},{"id":10366,"word":"及笄年华","pinyin":"jí jī nián huá","abbr":"jjnh","explanation":"笄：古代盘头发用的簪子。古代女子已订婚者十五而笄；未订婚者二十而笄。指少女到了可以出嫁的年龄。","source":{"text":"女子十有五年笄。","book":"《礼记·内则》"},"similar":["年已及笄"],"usage":"作宾语、定语；用于书面语"},{"id":10367,"word":"及第成名","pinyin":"jí dì chéng míng","abbr":"jdcm","explanation":"及第：科举时代考试中选。通过考试并得到功名。","source":{"text":"学士怎肯似那等穷酸恶醋，得一个及第成名，却又早负德辜恩。","book":"元·戴善夫《风光好》第三折"},"usage":"作宾语、定语；用于入仕等"},{"id":10368,"word":"及锋一试","pinyin":"jí fēng yī shì","abbr":"jfys","explanation":"及：趁着；锋：锋利。趁锋利的时候用它。比喻乘可行之机而行事。","source":{"text":"然科名是读书人的第二生命，一听见了开考的消息，不管多垒四部，总想及锋一试，雯青也是其中的一个。","book":"曾朴《孽海花》第三回"},"similar":["及锋而试"],"usage":"作谓语、宾语；比喻乘可行之机而行事"},{"id":10369,"word":"及锋而试","pinyin":"jí fēng ér shì","abbr":"jfes","explanation":"及：乘；锋：锋利，比喻士气高昂；试：试用。趁锋利的时候用它。原指乘士气高涨的时候使用军队，后比喻乘有利的时机行动。","source":{"text":"吏卒皆山东之人，日夜企而望归，及其锋而用之，可以有大功。","book":"《汉书·高帝纪上》"},"example":{"text":"此后自当避免些无须必践的荆棘，养精蓄锐，以待～。","book":"鲁迅《两地书·五》"},"similar":["见机行事","乘胜追击","及锋一试"],"opposite":["坐失良机"],"usage":"作谓语、宾语；比喻乘可行之机而行事","story":["秦朝末年，项羽自立为西楚霸王，他封刘邦为汉王去驻守汉中，项羽送他3万楚军，部队到了南郑时，很多楚军开始逃跑，于是韩信向刘邦建议及锋而试，可以成大业。刘邦听从韩信的建议，违约出兵攻击项羽，和项羽争夺天下取得了成功"]},{"id":10370,"word":"及门之士","pinyin":"jí mén zhī shì","abbr":"jmzs","explanation":"及：到。旧泛指登门求教的弟子。","source":{"text":"及门之士，著录者千余人。","book":"《论语·先进》：“从我于陈、蔡者，皆不及门也。”《元史·许廉传》"}},{"id":10371,"word":"友于兄弟","pinyin":"yǒu yú xiōng dì","abbr":"yyxd","explanation":"友于：兄弟般的情谊。兄弟之情非常浓厚。","source":{"text":"孝乎惟考，友于兄弟，施于有政。","book":"《论语·为政》"},"example":{"text":"以遗命去国仪，仍用藩镇法，除民逋赋，～，慎择贤能，所以吴越一方，安堵如恒。","book":"蔡东藩《五代史演义》第二十三回"},"usage":"作谓语、定语；用于书面语"},{"id":10372,"word":"友于甚笃","pinyin":"yǒu yú shèn dǔ","abbr":"yysd","explanation":"友于：兄弟般的情谊。兄弟之情非常浓厚。","source":{"text":"孝乎惟考，友于兄弟，施于有政。","book":"《论语·为政》"},"example":{"text":"每远游，恒经岁不返。兄鼐，江北名士，～。劝弟勿游，将为择偶。","book":"清·蒲松龄《聊斋志异·伍秋月》"}},{"id":10373,"word":"友风子雨","pinyin":"yǒu fēng zǐ yǔ","abbr":"yfzy","explanation":"指云。云以风为友，以雨为子。盖风与云并行，雨因云而生。","source":{"text":"托地而游宇，友风而子雨。","book":"《荀子·赋》"},"usage":"作主语、宾语；指云"},{"id":10374,"word":"双修福慧","pinyin":"shuāng xiū fú huì","abbr":"sxfh","explanation":"修：善。福德和智慧都修行到了。指既有福，又聪明。","source":{"text":"菩萨为行，福慧双修，智人得果，不忘其本。","book":"唐·慧立《大慈恩寺三藏法师传》卷五"},"example":{"text":"但愿更求精进，自度度人，～。","book":"清·谭嗣同《秋雨年华之馆从脞书·戊戌北上留别内子》"}},{"id":10375,"word":"双凫一雁","pinyin":"shuāng fú yī yàn","abbr":"sfyy","explanation":"汉苏武出使匈奴被羁，归国时留别李陵的诗中有“双凫俱北飞，一雁独南翔”之句。后以“双凫一雁”为感伤离别之词。"},{"id":10376,"word":"双喜临门","pinyin":"shuāng xǐ lín mén","abbr":"sxlm","explanation":"指两件喜事一齐到来。","source":{"text":"于是众客一齐站起来，又是一番足恭道喜；一个个嘴里都说道：‘这才是双喜临门呢！’总镇也自扬扬得意。","book":"《二十年目睹之怪现状》第八三回"},"example":{"text":"现在就派你去罢！你刚进了党，正要露露脸，办一件大事，挂一个头功！——哈，机会也真凑巧，今天是～了！","book":"茅盾《子夜》四"},"similar":["喜上加喜"],"opposite":["祸不单行"],"usage":"作谓语、宾语；指好事成双"},{"id":10377,"word":"双宿双飞","pinyin":"shuāng sù shuāng fēi","abbr":"sssf","explanation":"宿在一起，飞在一起。比喻相爱的男女形影不离。","source":{"text":"不如池上鸳鸯鸟，双宿双飞过一生。","book":"无名氏《杂词》"},"example":{"text":"你肯教～过一生，便则我子弟每行依平。","book":"元·石德玉《紫云庭》楔子"},"similar":["比翼齐飞","双栖双宿"],"opposite":["形单影只"],"usage":"作谓语、定语；指男女形影不离"},{"id":10378,"word":"双心一意","pinyin":"shuāng xīn yī yì","abbr":"sxyy","explanation":"双心：彼此的心意。指彼此的心意一致。","source":{"text":"双心一意俱徊翔，吐情寄君君莫忘。","book":"南朝·梁·沈约《四时白纻歌·秋白纻》"}},{"id":10379,"word":"双拳不敌四手","pinyin":"shuāng quán bù dí sì shǒu","abbr":"sqbdss","explanation":"一个人打不过众人。指寡不敌众。","source":{"text":"他这班人，却是亡命之徒，常言道，双拳不敌四手。","book":"清·褚人获《隋唐演义》第23回"},"example":{"text":"清·钱彩《说岳全传》第48回：“那岳飞～，纵有通天本事，只怕也难逃厄。”"},"similar":["寡不敌众"],"usage":"作宾语、定语；用于口语"},{"id":10380,"word":"双斧伐孤树","pinyin":"shuāng fǔ fá gū shù","abbr":"sffgs","explanation":"指嗜酒好色，摧残身体。","source":{"text":"而惟曲蘖是耽，妃姬是好，是犹双斧伐孤树，未有不颠仆者。","book":"《元史·阿沙不花传》"},"example":{"text":"明·程登吉《幼学琼林》第三卷：“酒色是耽如以～；力量不胜如以寸胶澄黄河。”"},"usage":"作宾语、定语；多用于比喻句"},{"id":10381,"word":"双柑斗酒","pinyin":"shuài gān dǒu jiǔ","abbr":"sgdj","explanation":"比喻春天游玩胜景。","source":{"text":"戴颙春携双柑斗酒，人问何之，曰：‘往听黄鹂声。此俗耳针砭，诗肠鼓吹，汝知之乎？’","book":"唐·冯贽《云仙杂记》卷二引《高隐外书》"},"example":{"text":"明日重来应烂漫，～听黄鹂。","book":"宋·刘泰《春日湖上》诗"},"usage":"作宾语、定语；指春游"},{"id":10382,"word":"双栖双宿","pinyin":"shuāng qī shuāng sù","abbr":"sqss","explanation":"宿在一起，飞在一起。比喻相爱的男女形影不离。","source":{"text":"眼想心思梦里惊，无人知我此时情。不如池上鸳鸯鸟，双宿双飞过一生。","book":"宋·尤袤《全唐诗话》卷六"},"example":{"text":"～比鸳鸯，女貌郎才两颉颃，不是一番寒彻骨，争得梅花扑鼻香。","book":"明·叶宪祖《鸾鎞记·谐婚》"},"similar":["双宿双飞"],"opposite":["形单影只"],"usage":"作谓语、定语；指男女形影不离"},{"id":10383,"word":"双桂联芳","pinyin":"shuāng guì lián fāng","abbr":"sglf","explanation":"比喻兄弟二人俱获功名。","source":{"text":"且喜双桂联芳，已遂凌云之志。","book":"元·施惠《幽闺记·衣锦还乡》"},"example":{"text":"兄弟～，擢居首选。","book":"明·邵璨《香囊记·分歧》"},"usage":"作谓语、宾语；用于比喻句"},{"id":10384,"word":"双珠填耳","pinyin":"shuāng zhū tián ěr","abbr":"szte","explanation":"填：填塞。两颗珠子填塞了耳朵。形容被蒙蔽。","source":{"text":"两叶掩目，则冥默无睹；双珠填耳，必寂寞无闻。","book":"汉·桓谭《新论·专学》"}},{"id":10385,"word":"双眉不展","pinyin":"shuāng méi bù zhǎn","abbr":"smbz","explanation":"展：舒展。由于忧愁而双眉紧锁。形容心事重重的样子。","source":{"text":"正好不对烟月，双眉不展自如钩。","book":"唐·姚鹄《随州献李侍御》之二：“旧隐每杯空竟夕，愁眉不展几经春。”明·杨慎《升庵诗话·附录》"},"example":{"text":"彭德怀和毛泽东都走在三军团的后尾。彭德怀仍然面色严峻，～。","book":"魏巍《地球的红飘带》七十"}},{"id":10386,"word":"双眉大眼","pinyin":"huān méi dà yǎn","abbr":"smdy","explanation":"形容眉开眼笑，十分高兴的样子。","source":{"text":"凤兰双眉大眼的坐在贵德的旁边。","book":"谷峪《新事新办》"}},{"id":10387,"word":"双瞳剪水","pinyin":"shuāng tóng jiǎn shuǐ","abbr":"stjs","explanation":"瞳：瞳孔，指眼睛。形容眼睛清澈明亮。","source":{"text":"骨重神寒天庙器，一双瞳人剪秋水。","book":"唐·李贺《唐儿歌》"},"example":{"text":"不要说什么，你且看他～迎人滟，风流万种谈笑间。","book":"明·周履靖《锦笺记·初晤》"},"usage":"作定语；用于女性"},{"id":10388,"word":"双瞳如豆","pinyin":"shuāng tóng rú dòu","abbr":"strd","explanation":"瞳：瞳孔。形容人的目光短浅。","source":{"text":"笑君双瞳如豆，屡以金资动人。","book":"清·蒲松龄《聊斋志异·王桂庵》"},"example":{"text":"只是要娶到家来作个媳妇，世上这般～、一叶迷山的，以至糊涂下人，又有几个深明大义的呢！","book":"清·文康《儿女英雄传》第二十五回"}},{"id":10389,"word":"双管齐下","pinyin":"shuāng guǎn qí xià","abbr":"sgqx","explanation":"管：指笔。原指手握双笔同时作画。后比喻做一件事两个方面同时进行或两种方法同时使用。","source":{"text":"唐张璪员外画山水松石名重于世。尤于画松特出意象，能手握双管一时齐下，一为生枝，一为枯干，势凌风雨，气傲烟霞。","book":"宋·郭若虚《图画见闻志·故事拾遗》"},"example":{"text":"如此～，就有可能克服大地主大资产阶级的投降危险并争取时局的好转前途。","book":"毛泽东《克服投降危险，力争时局好转》"},"similar":["齐头并进","并驾齐驱"],"opposite":["另起炉灶"],"usage":"作谓语、定语；表示两件事同时进行","story":["唐朝著名画家张璪擅长画山水和松石，他画的松树让人叫绝。每次作画时都是双手握笔，一手画松树树干，一手画松枝，两手同时进行。凡是看过他作画的人没有一个不佩服他双管齐下的本事。当时有人评论“张璪作画，真是双管齐下。”"]},{"id":10390,"word":"双苗爱叶","pinyin":"huān miáo ài yè","abbr":"smay","explanation":"比喻欢乐恩爱的情感。","source":{"text":"单则为一点情根，种出那双苗爱叶，他怜我慕，两下无分别。","book":"清·洪昇《长生殿·补恨》"}},{"id":10391,"word":"双豆塞耳","pinyin":"shuāng dòu sāi ěr","abbr":"sdse","explanation":"用两粒豆子塞住耳朵。比喻被暂时的现象和眼前的利益所蒙蔽，看不到事物的全貌和本质。","source":{"text":"夫耳之主听，目之主明。一叶蔽目，不见太山；两豆塞耳，不闻雷霆。","book":"《鹖冠子·天则》"},"similar":["两耳塞豆","两豆塞耳"],"usage":"作宾语、定语；用于处事"},{"id":10392,"word":"双豆塞聪","pinyin":"shuāng dòu sāi cōng","abbr":"sdsc","explanation":"聪：听觉灵敏。用两粒豆子塞住耳朵。比喻被暂时的现象和眼前的利益所蒙蔽，看不到事物的全貌和本质。","source":{"text":"两叶能蔽目，双豆能塞聪。","book":"《鹖冠子·天则》：“夫耳之主听，目之主明。一叶蔽目，不见太山；两豆塞耳，不闻雷霆。”唐·聂夷中《杂兴》"}},{"id":10393,"word":"双足重茧","pinyin":"shuāng zú chóng jiǎn","abbr":"szcj","explanation":"形容奔走劳苦。","source":{"text":"昔者楚欲攻宋。墨子闻而悼之，自鲁趋而十日十夜，足重茧而不休息。","book":"《淮南子·修务训》"},"usage":"作谓语、定语；用于书面语"},{"id":10394,"word":"反侧自安","pinyin":"fǎn cè zì ān","abbr":"fcza","explanation":"反侧：翻来覆去难以入睡，心神不安的样子。让那些心神不安的人自然而然地安下心来。表示安抚人心的措施很奏效。","source":{"text":"收文书，得吏人与郎交关谤毁者数千章。光武不省，会诸将军烧之。曰：‘令反侧子自安。’","book":"《后汉书·光武帝纪上》"},"example":{"text":"此皆良百姓受贼耳，若株连者众，何以令反侧子自安乎？","book":"清·汪琬《文林郎岑谿知县刘公墓表》"},"similar":["反侧获安"],"usage":"作谓语、定语；用于政策等","story":["东汉初年，光武帝刘秀率军围攻邯郸城，攻破邯郸后，杀死守将王郎。在收到的各种文书中，其中有许多与王郎交往密切的官吏上书毁谤的文书数千篇。光武帝很不高兴，就率手下大将将这些文书全部烧掉，并说：“令反侧子自安。”"]},{"id":10395,"word":"反侧获安","pinyin":"fǎn cè huò ān","abbr":"fcha","explanation":"反侧：翻来覆去不能入睡，心神不安。形容心神不安的人自然而然地安下心去。指安抚人心的措施很奏效。","source":{"text":"昨者改元施令，悔往布新，将反侧获安，则干戈日弭。","book":"唐·陆贽《奉天遣使宣慰诸道诏》"},"similar":["反侧自安"],"usage":"作谓语、定语；用于政策等"},{"id":10396,"word":"反其意而用之","pinyin":"fǎn qí yì ér yòng zhī","abbr":"fqyeyz","explanation":"其：他的；意：意义；用：使用。指按照与原来相反的意思去引用或使用词语、典故等。也用来指文艺创作等有创新或突破前人的束缚。","source":{"text":"反其意而用之者，非识学素高，超越寻常拘挛之见，不规然蹈袭前人陈迹者，何以致此。","book":"宋·严有翼《艺苑雌黄》"}},{"id":10397,"word":"反其道而行之","pinyin":"fǎn qí dào ér xíng zhī","abbr":"fqdexz","explanation":"其：他的；道：方法，办法。采取同对方相反的办法行事。","source":{"text":"名虽为霸，实失天下心。故曰其强易弱。今大王诚能反其道，任天下武勇，何所不诛。","book":"《史记·淮阴侯列传》"},"example":{"text":"只是宗兄劝你去做教习，你却去做学生，未免～。","book":"清·吴趼人《痛史》"},"similar":["反治其身"],"usage":"作谓语；指采取同对方相反的办法行事"},{"id":10398,"word":"反劳为逸","pinyin":"fǎn láo wéi yì","abbr":"flwy","explanation":"劳：疲劳；逸：安闲，休息。把疲劳转化为安逸。","source":{"text":"我一战而人数应，误逸为劳；人数战而人数休，反劳为逸；逸则可作，劳则可败。","book":"明·揭喧《兵经百篇·更字》"},"usage":"作谓语；用于做事"},{"id":10399,"word":"反反复复","pinyin":"fǎn fǎn fù fù","abbr":"ffff","explanation":"一次又一次。","source":{"text":"因此要对党内干部作反反复复的教育，才能保证其执行。","book":"邓小平《贵州新区工作的策略》"},"example":{"text":"邓小平《贵州新区工作的策略》：“因此要对党内干部作～的教育，才能保证其执行。”"},"similar":["反反覆覆"],"usage":"作定语、状语；用于处事或事物等"},{"id":10400,"word":"反反覆覆","pinyin":"fǎn fǎn fù fù","abbr":"ffff","explanation":"反：翻转。形容一次又一次重复。","source":{"text":"人治一家一国，尚且有照管不到处，况天下之大，所以反反覆覆说，不是大著个心去理会，如何照管得。","book":"宋·朱熹《朱子语类·大学》"},"similar":["反反复复"],"usage":"作定语、状语；指重复"},{"id":10401,"word":"反吟伏吟","pinyin":"fǎn yín fú yín","abbr":"fyfy","explanation":"迷信说法，以人出生时的年月日，推算福祸和婚姻成败。旧时用以象征婚姻难成。","source":{"text":"功名上早则不遂心，婚姻上更反吟伏吟。","book":"元·王实甫《西厢记》第三本第四折"}},{"id":10402,"word":"反吟复吟","pinyin":"fǎn yín fù yín","abbr":"fyfy","explanation":"迷信说法，以人出生的年月日推算祸福和婚姻成败。指象征婚姻难成。","source":{"text":"功名上早则不遂心，婚姻上更反吟复吟。","book":"元·王实甫《西厢记》第三本第四折"},"similar":["反阴复阴"],"usage":"作宾语、定语；用于迷信等"},{"id":10403,"word":"反听内视","pinyin":"fǎn tīng nèi shì","abbr":"ftns","explanation":"内视：向内看；反听：听外面的。指既能反省自己的言行，也能听取别人的意见。","source":{"text":"反听之谓聪，内视之谓明，自胜之谓强。","book":"西汉·司马迁《史记·商君列传》"},"example":{"text":"则～，求其所由，必远观诸物，近验诸身。","book":"《晋书·挚虞传》"},"usage":"作谓语、宾语、定语；指人善于处理问题"},{"id":10404,"word":"反听收视","pinyin":"fǎn tīng shōu shì","abbr":"ftss","explanation":"不听不视。指不为外物所惊扰。","source":{"text":"务实去华，育德之方斯在；反听收视，养恬之义相应。","book":"宋˙范仲淹《蒙以养正赋》"}},{"id":10405,"word":"反咬一口","pinyin":"fǎn yǎo yī kǒu","abbr":"fyyk","explanation":"不仅不承认自己的错误，却反过来诬赖对方。比喻干了干事的人反过来诬谄受害者或干坏事的首要分子嫁祸于胁从者。","source":{"text":"袁世凯卖国也要一手包办。替他做掮客的人会被他反咬一口，说是汉奸。","book":"《锻炼》"},"example":{"text":"我们要提防他～。"},"similar":["倒打一耙"],"usage":"作谓语、宾语；同“倒打一耙”"},{"id":10406,"word":"反哺之情","pinyin":"fǎn bǔ zhī qíng","abbr":"fbzq","explanation":"比喻子女长大奉养父母，报答恩情。","source":{"text":"慈鸟：此鸟初生，母哺六十日，长则反哺六十日，可谓慈孝矣。","book":"明·李时珍《本草纲目·禽部》"},"example":{"text":"他按月把钱寄给乡下的母亲，好让母亲从这～中来体会儿子对她的孝心。"},"similar":["返哺之恩"],"usage":"作宾语；比喻报答亲恩"},{"id":10407,"word":"反哺之私","pinyin":"fǎn bǔ zhī sī","abbr":"fbzs","explanation":"反哺：幼鸟长大后，衔食喂其母。比喻子女长大奉养父母，报答养育之恩。","source":{"text":"雏既壮而能飞兮，乃衔食而反哺。","book":"晋·成公绥《乌赋》"},"example":{"text":"我们都有～，赡养老人是天职。"},"similar":["反哺之情"],"usage":"作宾语；指子女对父母"},{"id":10408,"word":"反哺衔食","pinyin":"fǎn bǔ xián shí","abbr":"fbxs","explanation":"反哺：乌雏长大后，衔食哺母乌。小乌又衔食喂其母。比喻子女报答父母恩情。","source":{"text":"雏既壮而能飞兮，乃衔食而反哺。","book":"晋·成公绥《乌赋》"}},{"id":10409,"word":"反唇相稽","pinyin":"fǎn chún xiāng jī","abbr":"fcxj","explanation":"反唇：回嘴、顶嘴；稽：计较。受到指责不服气，反过来责问对方。","source":{"text":"妇姑不相说（悦），则反唇而相稽。","book":"《汉书·贾谊传》"},"example":{"text":"语侵妇，妇～。","book":"清·蒲松龄《聊斋志异·吕无病》"},"similar":["反唇相讥"],"opposite":["哑口无言","无言以对"],"usage":"作谓语、状语；用于争论场合"},{"id":10410,"word":"反唇相讥","pinyin":"fǎn chún xiāng jī","abbr":"fcxj","explanation":"反唇：回嘴、顶嘴。受到指责不服气，反过来讥讽对方。","source":{"text":"妇姑不相说（悦），则反唇而相稽。","book":"《汉书·贾谊传》"},"example":{"text":"济渡满不买帐，～：“皇上信得过我，干您哪一条？”","book":"华而实《汉衣冠》七"},"similar":["反唇相稽"],"opposite":["张口结舌","无言以对"],"usage":"作谓语、状语；用于争斗的场合"},{"id":10411,"word":"反复不常","pinyin":"fǎn fù bù cháng","abbr":"ffbc","explanation":"反复：颠过来倒过去。经常变化没有稳定状态，形容情况变来变去没有定准。","source":{"text":"人疑其反复不常，而末如之何。","book":"宋·周密《齐东野语·端平襄州本末》"},"example":{"text":"清·无名氏《刘公案》第74回：“见银钱忘恩义，见刀剑且顾水性杨花，～。”"},"similar":["反复无常"],"usage":"作谓语、宾语、定语、状语；用于人或事物"},{"id":10412,"word":"反复推敲","pinyin":"fǎn fù tuī qiāo","abbr":"fftq","explanation":"多次捉摸，选择最佳方案。","source":{"text":"贾岛初赴举，在京师，一日，于驴上得句云：‘鸟宿池边树，僧敲月下门。’又欲着‘推’字，炼之未定。","book":"《诗话总龟》"},"example":{"text":"经过～，我们终于选择了这个方案。"},"similar":["仔细琢磨"],"usage":"作谓语、宾语；指仔细琢磨","story":["唐朝时期，诗人贾岛因考试不中就去当和尚，法名无本。他爱好作诗，作诗时十分认真。一次得诗“鸟宿池边树，僧推月下门”，便去请教韩愈，韩愈建议他用“僧敲月下门”，韩愈被贾岛的这种严谨治学所感动"]},{"id":10413,"word":"反复无常","pinyin":"fǎn fù wú cháng","abbr":"ffwc","explanation":"无常：变化不定。形容常常变化，一会儿是这样，一会儿又是那样，变动不定。","source":{"text":"当年翻复无常定。","book":"南朝·梁·费昶《行路难》诗"},"example":{"text":"叫我怎么能赦你这～的罪呢！","book":"清·曾朴《孽海花》第十七回"},"similar":["出尔反尔","翻云覆雨"],"opposite":["始终如一","始终不渝"],"usage":"作谓语、宾语、定语、状语；形容人经常变卦"},{"id":10414,"word":"反客为主","pinyin":"fǎn kè wéi zhǔ","abbr":"fkwz","explanation":"客人反过来成为主人。比喻变被动为主动。","source":{"text":"拔寨前进，步步为营，诱渊来战而擒之，此乃反客为主之法。","book":"明·罗贯中《三国演义》第七十一回"},"example":{"text":"心里正在为难，只听得那女子～，让着说道：“尊客，请屋里坐。”","book":"清·文康《儿女英雄传》第四回"},"similar":["喧宾夺主"],"usage":"作谓语、定语；比喻变被动为主动"},{"id":10415,"word":"反戈一击","pinyin":"fǎn gē yī jī","abbr":"fgyj","explanation":"掉转武器向自己原来所属的阵营进行攻击。","source":{"text":"吾与杨将军反戈击之。但看火起为号，温侯以兵相应可也。","book":"《尚书·武成》：“前徙倒戈，攻于后以北。”  明·罗贯中《三国演义》第十七回"},"example":{"text":"又因为从旧垒中来，情形看得较为分明，～，易制强敌的死命。","book":"鲁迅《坟·写在〈坟〉后面》"},"similar":["恩将仇报","以义割恩"],"opposite":["同恶相济","朋比为奸"],"usage":"作谓语、定语、分句；指转变"},{"id":10416,"word":"反戈相向","pinyin":"fǎn gē xiāng xiàng","abbr":"fgxx","explanation":"戈：古代的兵器；向：对着。掉转兵器，相与对立。比喻帮助敌人反对自己。","source":{"text":"前徙倒戈，攻于后以北。","book":"《尚书·武成》"}},{"id":10417,"word":"反手可得","pinyin":"fǎn shǒu kě dé","abbr":"fskd","explanation":"反：翻转。翻转手掌学可得到。形容极其易得。","source":{"text":"诛旦公，定楚国，如反手尔。","book":"《荀子·非相》"},"example":{"text":"我等费了许多军马，用了许多钱粮，目下南郡～。","book":"明·罗贯中《三国演义》第五十一回"},"similar":["唾手可得"],"usage":"作谓语；指很容易"},{"id":10418,"word":"反掌之易","pinyin":"fǎn zhǎng zhī yì","abbr":"fzzy","explanation":"反掌：反手。比喻事情十分容易办到。","source":{"text":"得了两州，心中大喜，不胜矜夸，谓取宋天下如反掌之易耳。","book":"《杨家将演义·邕州侬智高叛宋》"},"similar":["易如反掌"],"usage":"作宾语；指容易"},{"id":10419,"word":"反掖之寇","pinyin":"fǎn yè zhī kòu","abbr":"fyzk","explanation":"掖：同“腋”；寇：敌人；反掖：反于腋下，从内部叛变。指从内部叛变的敌人。","source":{"text":"夫弃城而败军，则反掖之寇必袭城矣。","book":"《韩非子·存韩》"}},{"id":10420,"word":"反攻倒算","pinyin":"fǎn gōng dào suàn","abbr":"fgds","explanation":"反攻、倒算：十多位　指坏人的反扑、报复。进行反扑报复。形容坏人得势时，向人民采取的报复行动。","source":{"text":"地主及其走狗和反动派勾结在一起，对群众进行反攻倒算，任意欺侮劳动人民。","book":"穆欣《南线巡回·在中央红色区域》"},"similar":["卷土重来","秋后算帐"],"usage":"作谓语、宾语、定语；用于坏势力等"},{"id":10421,"word":"反本修古","pinyin":"fǎn běn xiū gǔ","abbr":"fbxg","explanation":"本：根本；反本：复归本源，引申为人的禀性。恢复人的禀性，维持最初的善良品质。","source":{"text":"礼也者，反本修古，不忘其初者也。","book":"《礼记·礼器》"}},{"id":10422,"word":"反本溯源","pinyin":"fǎn běn sù yuán","abbr":"fbsy","explanation":"反：同“返”，归，还；溯：寻源。比喻追寻事情的根源。","source":{"text":"昔之人孔之乎，渊渊深思，盖知之矣，故反本溯源，立胎教之义，教之于未成形质以前。","book":"康有为《大同书》已部"},"similar":["追根溯源","溯流穷源","推本溯源"],"usage":"作谓语、宾语；用于探求事理等"},{"id":10423,"word":"反本还原","pinyin":"fǎn běn huán yuán","abbr":"fbhy","explanation":"反：同“返”，归，还。指回复到原来的状态。","source":{"text":"连服一二次，方才反本还原，知得人事。","book":"明·吴承恩《西游记》第11回"},"example":{"text":"清·李汝珍《镜花缘》第91回：“这叫做‘～’。”"},"similar":["返本还原"],"usage":"作谓语、宾语；用于人或事物等"},{"id":10424,"word":"反朴归真","pinyin":"fǎn pǔ guī zhēn","abbr":"fpgz","explanation":"反：通“返”，回；朴：质朴；归：返回；真：天然，自然。去掉外饰，还其本质。比喻回复原来的自然状态。","source":{"text":"连刘先生似的想白话‘返朴归真’的意思也全没有。","book":"鲁迅《花边文学·玩笑只当它玩笑（下）》"},"similar":["返朴归真","回归自然"],"usage":"作谓语、宾语、定语；形容回复本真"},{"id":10425,"word":"反朴还淳","pinyin":"fǎn pǔ huán chún","abbr":"fphc","explanation":"复归于朴实、淳正。","source":{"text":"先生曰：‘子以明道者，使其反朴还淳，而见诸行事之实乎；抑将美其言辞，而徒以譊譊于世也？","book":"明·王守仁《传习录》卷上"},"similar":["反正还淳"],"usage":"作谓语、定语；用于书面语"},{"id":10426,"word":"反来复去","pinyin":"fǎn lái fù qù","abbr":"flfq","explanation":"来回翻动。形容多次重复。","source":{"text":"江涛反来复去，看了又看。","book":"梁斌《红旗谱》第三卷"},"similar":["翻来复去"],"usage":"作定语、状语；指重复"},{"id":10427,"word":"反正拨乱","pinyin":"fǎn zhèng bō luàn","abbr":"fzbl","explanation":"治理乱世，使之恢复安定、正常。","source":{"text":"拨乱世，反诸正，莫近诸《春秋》。","book":"语出《公羊传·哀公十四年》"},"example":{"text":"向不遇～之主，曾何以措其筋力与韬钤，载其刀笔与喉舌，使祭则与，食则血。","book":"唐·杜甫《朝享太庙赋》"},"similar":["返正拨乱","拨乱反正"],"usage":"作谓语、宾语、定语；指纠正重大错误"},{"id":10428,"word":"反正还淳","pinyin":"fǎn zhèng huán chún","abbr":"fzhc","explanation":"复归于朴实、淳正。同“反朴还淳”。","source":{"text":"今乃人人侈用，一变至此，诚不可不反正还淳。","book":"明·李诩《戒庵老人漫笔·张罗峰》"},"similar":["反朴还淳"],"usage":"作谓语、定语；用于书面语"},{"id":10429,"word":"反水不收","pinyin":"fǎn shuǐ bù shōu","abbr":"fsbs","explanation":"水已泼出去，不能再收回。比喻不可挽回。","source":{"text":"虽仲尼为相，孙子为将，犹恐无能为益。反水不收，后悔无及。","book":"南朝·宋·范晔《后汉书·光武帝纪上》"},"example":{"text":"谁都知道～的道理。"},"similar":["覆水难收"],"usage":"作宾语、补语；比喻不可挽回","story":["商朝时期，姜尚（姜太公）才学过人，精通兵法，但因家贫，他的妻子马氏见他年老没出息就离开他，他只好到渭水边搭茅屋钓鱼为生，周文王拜他为国师，姜太公助周文王灭了商朝，他的妻子要求复合，他取一盆水泼地如能收回就复合"]},{"id":10430,"word":"反求诸己","pinyin":"fǎn qiú zhū jǐ","abbr":"fqzj","explanation":"求：追究，寻求；诸：“之于”的合成词。反过来追究自己。指从自己方面找原因。","source":{"text":"不怨胜己者，反求诸己而已矣。","book":"《孟子·公孙丑上》"},"example":{"text":"君子之遇艰阻，必～，而益自修。","book":"《二程全书·伊川易品三》"},"similar":["反躬自问","严于律己","闭门思过"],"opposite":["苛求于人"],"usage":"作宾语、定语；指反省"},{"id":10431,"word":"反治其身","pinyin":"fǎn zhì qí shēn","abbr":"fzqs","explanation":"治：整治；身：身体；其身：自身。反而整治自身。指自己反被自己整治的别人的方法所治服。"},{"id":10432,"word":"反璞归真","pinyin":"fǎn pǔ guī zhēn","abbr":"fpgz","explanation":"璞：蕴藏有玉的石头，也指未雕琢的玉；归：返回；真：天然，自然。去掉外饰，还其本质。比喻回复原来的自然状态。","source":{"text":"归真反璞，则终身不辱。","book":"《战国策·齐策四》"},"similar":["返璞归真"],"usage":"作谓语、宾语、定语；形容回复本真"},{"id":10433,"word":"反目成仇","pinyin":"fǎn mù chéng chóu","abbr":"fmcc","explanation":"反目：翻脸了。翻脸而变成仇敌。一般指夫妻不和，矛盾激化，互相对立。","source":{"text":"甚致怜新弃旧，反目成仇，多着呢？","book":"清·曹雪芹《红楼梦》"},"example":{"text":"这事使他们兄弟～。"},"similar":["反眼不识","反面无情"],"opposite":["琴毖和谐","双宿双飞","相敬如宾"],"usage":"作谓语、补语；指反眼相看成仇人"},{"id":10434,"word":"反眼不识","pinyin":"fǎn yǎn bù shí","abbr":"fybs","explanation":"反：翻转。翻脸不认人。形容改变态度，对人冷漠无情。","source":{"text":"一旦临小利害，仅如毛发比，反眼若不相识。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"他经常以～的态度待人。"},"similar":["翻脸无情"],"usage":"作谓语、定语；指人转变态度"},{"id":10435,"word":"反经从权","pinyin":"fǎn jīng cóng quán","abbr":"fjcq","explanation":"反经：不循常规；权：权宜的办法。为顺应形势，违反常规，采取权宜变通的做法。","source":{"text":"依我所见，不若反经从权，顺从改适，以财礼为公姑养老之资。","book":"明·天然痴叟《石点头》第二回"},"similar":["反经行权","反经合权"],"usage":"作谓语、宾语；指采取变通的手段"},{"id":10436,"word":"反经合义","pinyin":"fǎn jīng hé yì","abbr":"fjhy","explanation":"虽违背常道，但仍合于义理。","source":{"text":"荣女先为明帝嫔，欲上立为后，帝疑未决。给事黄门侍郎祖莹曰：‘昔文公在秦，怀嬴入侍。事有反经合义，陛下独何疑焉？","book":"《北史·尔朱荣传》"},"example":{"text":"然杨能～，足矫奢葬之愆。","book":"唐·刘知幾《史通·杂说中》"},"similar":["反经合道"],"usage":"作谓语、定语；用于做事"},{"id":10437,"word":"反经合权","pinyin":"fǎn jīng hé quán","abbr":"fjhq","explanation":"反经：不循常规；权：权宜的办法。为顺应形势，违反常规，采取权宜变通的做法。","source":{"text":"诸吕为从，谋弱京师，而勃反经合于权。","book":"西汉·司马迁《史记·太史公自序》"},"similar":["反经行权","反经从权"],"usage":"作谓语、宾语；指采取变通的手段"},{"id":10438,"word":"反经合道","pinyin":"fǎn jīng hé dào","abbr":"fjhd","explanation":"虽违背常道，但仍合于义理。同“反经合义”。","source":{"text":"此正教做以叔援嫂，因急行权；矫诏诛羌，反经合道。","book":"明·徐渭《女状元》第一出"},"similar":["反经合义"],"usage":"作谓语、定语；用于做事"},{"id":10439,"word":"反经行权","pinyin":"fǎn jīng xíng quán","abbr":"fjxq","explanation":"经：常道；权：权宜的办法。指违反常规，采取权宜之计。","source":{"text":"诸吕为从，谋弱京师，而勃反经合于权。","book":"《公羊传·桓公十一年》：“权者何？权者反于经，然后有善者也。”《史记·太史公自序》"},"example":{"text":"而今客居数千里之外，只得～，目下图个伴寂寥之计，他日娶了正妻，遣还了他亦无不可。","book":"明·凌濛初《二刻拍案惊奇》卷三十二"},"similar":["反经从权","反经合权"],"usage":"作谓语、宾语；指采取变通的手段"},{"id":10440,"word":"反老为少","pinyin":"fǎn lǎo wéi shào","abbr":"flws","explanation":"反：同“返”，返回；少：年轻。由衰老恢复青春。","source":{"text":"既变丑以成妍，亦反老而为少。","book":"南朝·梁·何逊《七召·神仙》"},"similar":["反老成童","返老还童"],"usage":"作定语、宾语；用于老年人"},{"id":10441,"word":"反老成童","pinyin":"fǎn lǎo chéng tóng","abbr":"flct","explanation":"反：同“返”，归，还。道教语，由衰老恢复青春。形容老年人充满了活力。","source":{"text":"服一刀圭，可愈痿弱重膇之疾，复能反老成童。","book":"《旧唐书·王守澄传》"},"similar":["反老还童","返老还童","反老为少"],"usage":"作定语、宾语；用于老年人"},{"id":10442,"word":"反老还童","pinyin":"fǎn lǎo huán tóng","abbr":"flht","explanation":"反：同“返”，归，还。道教语，由衰老恢复青春。形容老年人充满了活力","source":{"text":"《急就章》‘长乐无极老复丁’即《参同契》所云老翁复丁壮也，今变之曰反老还童。","book":"清·翟灏《通俗编·识馀》"},"example":{"text":"这药有～的功效"},"similar":["返老还童"],"usage":"作定语、宾语、补语；用于老年人","story":["西汉时期，淮南王刘安喜欢求仙问道，他潜心钻研，四处派人打听返老还童之术，访寻长生不老之药，一天一个白发老翁求见，说有返老还童之术，刘安认为老汉不可能有法术，就打发他走，只见一眨眼功夫，老汉就变成了儿童"]},{"id":10443,"word":"反脸无情","pinyin":"fān liǎn wú qíng","abbr":"flwq","explanation":"形容翻脸不认人，不讲情谊。","source":{"text":"但自日俄战争结束后，它就反脸无情，和清朝反动政府勾结起来。","book":"吴玉章《从甲午战争前后到辛亥革命前后的回忆》"},"example":{"text":"谁也没想到他会这么快就～。"},"similar":["忘恩负义","反面无情"],"opposite":["情深义重"],"usage":"作谓语、定语；指翻脸不认人"},{"id":10444,"word":"反行两得","pinyin":"fǎn xíng liǎng dé","abbr":"fxld","explanation":"行：行事。从反面着手行事，收到正面和反面两种效果。","source":{"text":"今以草茅之地，徕三晋之民，而使之事本。此其损敌也，与战胜同实；而秦得以为粟，此反行两登之计也。","book":"《商君书·徕民》"}},{"id":10445,"word":"反行两登","pinyin":"fǎn xíng liǎng dēng","abbr":"fxld","explanation":"行：做，行事；登：通“得”，取得，获得。从反面着手行事收到正反两面的效果。","source":{"text":"此其损敌也，与战胜同实；而秦得之以为粟，此反行两登之计也。","book":"战国·卫·商鞅《商君书·徕民》"},"usage":"作谓语、定语；用于做事等"},{"id":10446,"word":"反裘伤皮","pinyin":"fǎn qiú shāng pí","abbr":"fqsp","explanation":"古人穿皮衣毛朝外，反穿则毛在里，皮必受损。比喻愚昧不知本末。","source":{"text":"无异于愚人，反裘而负薪，爱其毛，不知其皮尽也。","book":"汉·桓宽《盐铁论·非鞅》"},"example":{"text":"今详欲因人之饥，以要三倍，～，未足喻之。","book":"《晋书·张轨传》"},"similar":["反裘负薪","反裘负刍"],"usage":"作谓语、定语；指不知轻重本末"},{"id":10447,"word":"反裘负刍","pinyin":"fǎn qiú fù chú","abbr":"fqfc","explanation":"反裘：反穿皮衣；负：背；刍：柴草。反穿皮袄背柴。形容贫穷劳苦。也比喻为人愚昧，不知本末。","source":{"text":"晏子之晋，至中牟，睹弊冠反裘负刍，息于涂侧者，以为君子也。","book":"《晏子春秋·杂上》"},"similar":["反裘负薪"],"usage":"作谓语、定语；指不知轻重本末"},{"id":10448,"word":"反裘负薪","pinyin":"fǎn qiú fù xīn","abbr":"fqfx","explanation":"反穿皮袄背柴。形容贫穷劳苦。也比喻为人愚昧，不知本末。同“反裘负刍”。","source":{"text":"无异于愚人，反裘而负薪，爱其毛，不知其皮尽也。","book":"汉·桓宽《盐铁论·非鞅》"},"example":{"text":"故囊漏贮中，识者不吝；～，存毛实难。","book":"《宋书·范泰传》"},"similar":["反裘负刍","反裘伤皮"],"usage":"作谓语、定语；指不知轻重本末"},{"id":10449,"word":"反覆无常","pinyin":"fǎn fù wú cháng","abbr":"ffwc","explanation":"指变化不定。","source":{"text":"操曰：‘袁谭小子，反覆无常，吾难准信。’","book":"《三国演义》第三三回"},"example":{"text":"嗳呀！你们底感情，真是～。","book":"许地山《缀网劳蛛·命命鸟》"},"similar":["反复无常","反复不常"],"opposite":["一成不变"],"usage":"作谓语、宾语、定语、状语；形容人经常变卦"},{"id":10450,"word":"反败为功","pinyin":"fǎn bài wéi gōng","abbr":"fbwg","explanation":"反：翻转，回转。扭转败局转为胜利。","source":{"text":"臣有一计，可以反败为功。","book":"明·冯梦龙《东周列国志》第21回"},"similar":["反败为胜"],"usage":"作谓语、状语；指扭转败局"},{"id":10451,"word":"反败为胜","pinyin":"fǎn bài wéi shèng","abbr":"fbws","explanation":"扭转败局，变为胜利。","source":{"text":"将军在匆忙之中，能整兵坚垒，任谤任劳，使反败为胜，虽古之名将，何以加兹！","book":"明·罗贯中《三国演义》第16回"},"example":{"text":"我们只要把好这一关就能～。"},"similar":["转危为安","转败为胜","扭转乾坤"],"usage":"作谓语、状语；指扭转败局"},{"id":10452,"word":"反跌文章","pinyin":"fǎn diē wén zhāng","abbr":"fdwz","explanation":"反着说正面话或欲扬故抑的文章。","source":{"text":"原来三荷包进来的时候，本想做反跌文章，先说个不成功，好等他哥来还价，他用的是‘引船就岸’的计策。","book":"清·李宝嘉《官场现形记》第五回"},"usage":"作宾语、定语；用于作文等"},{"id":10453,"word":"反身自问","pinyin":"fǎn shēn zì wèn","abbr":"fszw","explanation":"回过头来检查自己的言行得失。同“反躬自问”。","source":{"text":"呜呼！人孰不有母，读孝子之事，反身自问，竟何如哉！","book":"清·戴名世《程孝子传》"},"similar":["反躬自问"],"opposite":["血口喷人"],"usage":"作谓语、宾语；用于人严于律己"},{"id":10454,"word":"反躬自省","pinyin":"fǎn gōng zì xǐng","abbr":"fgzx","explanation":"躬：自身；省：检查。回过头来检查自己的言行得失。","source":{"text":"好恶无节于内，知诱于外，不能反躬，天理灭矣。","book":"《礼记·乐记》"},"example":{"text":"这次事故，你是有责任的，你应该～。"},"similar":["闭门思过","反躬自问","澈夜扪心"],"opposite":["嫁祸于人","血口喷人","暗箭伤人"],"usage":"作谓语、定语、状语；用于有过失的人"},{"id":10455,"word":"反躬自责","pinyin":"fǎn gōng zì zé","abbr":"fgzz","explanation":"回过头来责备自己。","source":{"text":"假如当局者稍有良心，应如何反躬自责，激发一点天良？","book":"鲁迅《华盖集续编·无花的蔷薇之二》"},"example":{"text":"特别是潼关南原战败之后，这种～的心情更甚。","book":"姚雪垠《李自成》第一卷第十五章"},"similar":["反躬自问"],"usage":"作谓语、宾语；指反省"},{"id":10456,"word":"反躬自问","pinyin":"fǎn gōng zì wèn","abbr":"fgzw","explanation":"躬：自身；问：检查。回过头来检查自己的言行得失。","source":{"text":"好恶无节于内，知诱于外，不能反躬，天理灭矣。","book":"《礼记·乐记》"},"example":{"text":"这次事故，你是有责任的，你应该～。"},"similar":["反躬自省","扪心自问","内视反听"],"opposite":["嫁祸于人","血口喷人"],"usage":"作谓语、宾语；用于人严于律己"},{"id":10457,"word":"反道败德","pinyin":"fǎn dào bài dé","abbr":"fdbd","explanation":"违反正道，败坏道德。","source":{"text":"侮慢自贤，反道败德。","book":"《尚书·大禹谟》"}},{"id":10458,"word":"反邪归正","pinyin":"fǎn xié guī zhèng","abbr":"fxgz","explanation":"邪：不正当，不正派；归：回到。从邪路上回到正路上来，不再做坏事。","source":{"text":"将军反邪归正，与宋某同灭田虎，回朝报奏朝廷，自当录用。","book":"明·施耐庵《水浒传》第97回"},"similar":["改邪归正"],"opposite":["执迷不悟","死不改悔"],"usage":"作谓语、宾语；指重新做人"},{"id":10459,"word":"反间之计","pinyin":"fǎn jiàn zhī jì","abbr":"fjzj","explanation":"间：离间。原意为利用敌人的间谍把假情况告知敌人使之失误的计策。后来指离间敌人内部，使之不团结的计策。","source":{"text":"反间者，因其敌间而用之。","book":"《孙子·用间》"},"example":{"text":"闿曰：‘此乃诸葛亮～，欲令我两人不知。’”","book":"明·罗贯中《三国演义》第八十七回"},"similar":["反间计"],"usage":"作宾语；指离间对方的计谋"},{"id":10460,"word":"反阴复阴","pinyin":"fǎn yīn fù yīn","abbr":"fyfy","explanation":"迷信说法，以人出生时的年月日，推算福祸和婚姻成败。旧时用以象征婚姻难成。","source":{"text":"今年见吊客临，丧门聚，反阴复阴，半载其余。","book":"元·关汉卿《调风月》第四折"},"similar":["反吟复吟"],"usage":"作宾语、定语；用于迷信等"},{"id":10461,"word":"反面教员","pinyin":"fǎn miàn jiào yuán","abbr":"fmjy","explanation":"反面：坏的，消极的一面。指与人民为敌的人的言行，可以从反面教育人民。","source":{"text":"它是全世界人民的反面教员。","book":"毛泽东《我们党的一些历史经验》"},"example":{"text":"出了最大的～，我们的党可以从这场血淋淋的惨痛的教训中汲取教益。","book":"李娴娟《血染的爱》"},"similar":["反面教材"],"opposite":["正面教员","光辉典范"],"usage":"作主语、宾语；指反面人物"},{"id":10462,"word":"反面教材","pinyin":"fǎn miàn jiào cái","abbr":"fmjc","explanation":"消极的供教学用的资料。借指坏的典型。","source":{"text":"做反面教材，使人民都知道投降派。","book":"路遥《平凡的世界》第二卷第29章"},"usage":"作宾语、定语；用于口语"},{"id":10463,"word":"反面文章","pinyin":"fǎn miàn wén zhāng","abbr":"fmwz","explanation":"从事情的反面做的文章。多指反语。","source":{"text":"紫芝道：‘我仿《毛诗》：巨屦扬矣，于彼高冈；大足光矣，于彼馨香。’春辉道：‘“馨香”二字是褒中带贬，反面文章，含蓄无穷，颇有风人之旨。’","book":"清·李汝珍《镜花缘》第八十七回"},"example":{"text":"倘使都当～看，可就太骇人了。","book":"鲁迅《推背图》"},"similar":["反面材料"],"opposite":["正面文章","正面材料"],"usage":"作主语、宾语；多指反语"},{"id":10464,"word":"反面无情","pinyin":"fǎn miàn wú qíng","abbr":"fmwq","explanation":"翻转脸面，不讲情义。形容翻脸不认人。","source":{"text":"状元，成就了吧，他也是一个君主，恐怕反面无情，那时节悔之晚矣。","book":"明·邵粲《香囊记·辞婚》"},"example":{"text":"唉，安禄山，安禄山，你受了唐天子那样大恩，尚且兴兵反叛，休怪俺李猪儿今日～也。","book":"清·洪昇《长生殿》第三十四出"},"similar":["反咬一口","反目成仇","忘恩负义"],"opposite":["情意深重","深情厚谊"],"usage":"作谓语、定语；指翻脸不认人"},{"id":10465,"word":"反风灭火","pinyin":"fǎn fēng miè huǒ","abbr":"ffmh","explanation":"比喻施行德政。","source":{"text":"诏问昆曰：‘前在江陵，反风灭火，后守弘农，虎北渡河，行何德政而致是事？’昆对曰：‘偶然耳。’左右皆笑其质讷。帝叹曰：‘此乃长者之言也。’","book":"《后汉书·儒林传上·刘昆》"},"example":{"text":"但知私财不入，公事夙办，便云我能治民，不知诚己刑物，执辔如组，～，化鸱为凤之术也。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作宾语、定语；用于处事","story":["汉朝时期，皇帝下诏问刘昆说：“前在江陵，反风灭火，后守弘农，虎北渡河，行何德政而致是事？”，刘昆见皇帝夸奖他，就推说是偶然而已。左右人都笑他不会表功与木讷。皇帝感叹地说：“此乃长者之言也。”"]},{"id":10466,"word":"反首拔舍","pinyin":"fǎn shǒu bá shè","abbr":"fsbs","explanation":"反首：把头发散乱向下垂着；拔舍：除掉杂草，就地住宿。头发散乱着就地住宿。形容军队打败仗后的狼狈状况。","source":{"text":"秦获晋侯以归。晋大夫反首拔舍从之。","book":"《左传·僖公十五年》"},"usage":"作谓语、状语；用于战败"},{"id":10467,"word":"反骄破满","pinyin":"fǎn jiāo pò mǎn","abbr":"fjpm","explanation":"反对骄傲，破除自满。","source":{"text":"市有关领导要求各企业反骄破满，把主要精力从增加产品数量转移到主要抓提高产品质量、搞好产品更新换代和新产品开发上来，增产国内外市场畅销产品。","book":"《人民日报》1983.11.15"},"usage":"作谓语、定语、宾语；用于处事"},{"id":10468,"word":"反骨洗髓","pinyin":"fǎn gǔ xǐ suǐ","abbr":"fgxs","explanation":"反骨：换骨；洗髓：换骨髓。换掉骨髓。形容彻底改变。","source":{"text":"三千年一反骨洗髓，二千年一剥骨伐毛。","book":"汉·郭宪《洞冥记》"}},{"id":10469,"word":"发上冲冠","pinyin":"fā shàng chōng guàn","abbr":"fscg","explanation":"犹言发上指冠。形容极度愤怒。","source":{"text":"王授璧，相如因持璧却立，倚柱，怒发上冲冠。","book":"西汉·司马迁《史记·廉颇蔺相如列传》"},"example":{"text":"灌将军目眦层裂，～，怒骂之，极诋其生平，不值一钱。","book":"清·曹宗璠《翟公客》"},"similar":["怒发冲冠","发怒冲冠"],"usage":"作谓语、状语、定语；形容极端愤怒","story":["战国时期，秦昭襄王为得到赵国的和氏璧，便允诺赵惠王以15座城池交换。迫于秦国势力，赵王派蔺相如带和氏璧去交换，秦王闭口不谈城池的事，蔺相如用计夺回和氏璧，并怒发冲冠地说：“如果不以城池交换，我就与和氏璧同归于尽。”"]},{"id":10470,"word":"发上指冠","pinyin":"fā shàng zhǐ guàn","abbr":"fszg","explanation":"毛发竖起貌。形容极度愤怒。","source":{"text":"盗跖闻之，目如明星，发上指冠。","book":"战国·宋·庄周《庄子·盗跖》"},"example":{"text":"湘灵命酒连举十余觞，大醉欢呼，～，已复悲歌出涕。","book":"清·刘大櫆《序》"},"similar":["发上冲冠","怒发冲冠"],"usage":"作谓语、状语、定语；形容极端愤怒"},{"id":10471,"word":"发人深思","pinyin":"fā rén shēn sī","abbr":"frss","explanation":"深：无限，没有穷尽。启发人深入地思考。形容语言或文章有深刻的含意，耐人寻味。","source":{"text":"虽平平淡淡，却颇发人深思，让人牵肠动情。","book":"京夫《手杖》"},"example":{"text":"这件事情真是～。"},"similar":["发人深省"],"usage":"作谓语、定语；指让人深思"},{"id":10472,"word":"发人深省","pinyin":"fā rén shēn xǐng","abbr":"frsx","explanation":"发：启发；省：醒悟。启发人深刻思考，有所醒悟。","source":{"text":"欲觉闻晨钟，令人发深省。","book":"唐·杜甫《游龙门奉先寺》诗"},"example":{"text":"以当清夜闻钟，～。","book":"《虞初新志·金忠洁公传评》"},"similar":["发人深思","发人深醒","振聋发聩"],"opposite":["执迷不悟"],"usage":"作谓语、定语；用于讲话与文章","story":["洛阳附近龙门石窟始建于北魏孝文帝，在长约一公里的山崖上，共雕刻佛像近十万尊，艺术水平最高的是奉先寺，寺内供奉的是卢舍那佛，高17米。杜甫作《游龙门奉先寺》描写僧侣的晨钟暮鼓生活：“天阙象纬逼，云卧衣裳冷。欲觉闻晨钟，令人发深省。"]},{"id":10473,"word":"发凡举例","pinyin":"fā fán jǔ lì","abbr":"ffjl","explanation":"发凡：揭示全书的通例；举：提出。指举例以阐明要点。说明全书通例。","source":{"text":"时编摩之士，皆山林布衣，发凡举例，一仰于濂。","book":"明·焦竑《玉堂丛语·纂修》"},"similar":["举例发凡"],"usage":"作宾语；指举例以阐明要点"},{"id":10474,"word":"发凡言例","pinyin":"fā fán yán lì","abbr":"ffyl","explanation":"发凡：揭示全书的通例。分类举例以说明书的体例。","source":{"text":"其发凡以言例，皆经国之常制。","book":"晋·杜预《序》"},"similar":["发凡举例"],"usage":"作宾语、定语；用于书本"},{"id":10475,"word":"发凡起例","pinyin":"fā fán qǐ lì","abbr":"ffql","explanation":"发凡：提示全书的通例。指说明全书要旨，拟定编写体例。","source":{"text":"其发凡以言例，皆经国之常制。","book":"晋·杜预《春秋左氏传序》"},"example":{"text":"本拟为志局～，商订章程。","book":"《艺凤堂友朋书札·陆心源》"},"similar":["起例发凡"],"usage":"作宾语；用于书籍资料"},{"id":10476,"word":"发号出令","pinyin":"fā hào chū lìng","abbr":"fhcl","explanation":"发：发布；号：号令；令：命令。发布命令，下指示进行指挥。","source":{"text":"发号出令而民说谓之和，上下相亲谓之仁。","book":"西汉·戴圣《礼记·经解》"},"example":{"text":"且今之为政者，必有堂宇以为～之地。","book":"明·李东阳《重建成都府学记》"},"similar":["发号布令","发号施令","发号吐令"],"usage":"作谓语、定语、宾语；指指挥"},{"id":10477,"word":"发号吐令","pinyin":"fā hào tǔ lìng","abbr":"fhtl","explanation":"发：发布；号：号令；令：命令。发布命令，下指示进行指挥。","source":{"text":"发号吐令，则訇若雷霆之激响，而不为邪辨改其正。","book":"晋·葛洪《抱朴子·君道》"},"similar":["发号布令","发号施令","发号出令"],"usage":"作谓语、定语、宾语；指指挥"},{"id":10478,"word":"发号布令","pinyin":"fā hào bù lìng","abbr":"fhbl","explanation":"发：发布；号：号令；布：发布；令：命令。发布命令，下指示进行指挥。","source":{"text":"夫发号布令而人乐闻，兴师动众而人乐战，交兵接刃而人乐死。","book":"战国·卫·吴起《吴子·励士》"},"similar":["发号施令","发号出令","发号吐令"],"usage":"作谓语、定语、宾语；指指挥"},{"id":10479,"word":"发号施令","pinyin":"fā hào shī lìng","abbr":"fhsl","explanation":"号：号令；施：发布。发布命令。现在也用来形容指挥别人。","source":{"text":"发号施令，天下莫不从风。","book":"《尚书·冏命》：“发号施令，罔有不藏。”《淮南子·本经训》"},"example":{"text":"我们历来主张革命要依靠人民群众，大家动手，反对只依靠少数人～。","book":"《毛泽东选集·对晋绥日报编辑人员的谈话》"},"similar":["调兵遣将","指挥若定"],"opposite":["线抽傀儡"],"usage":"作谓语、定语、宾语；指指挥"},{"id":10480,"word":"发名成业","pinyin":"fā míng chéng yè","abbr":"fmcy","explanation":"发扬名声，成就事业。","source":{"text":"一抵京师就明经试，退曰：‘此不足发名成业。’","book":"唐·韩愈《司徒兼侍中中书令赠太尉许国公神道碑铭》"},"similar":["功成名就"],"usage":"作谓语、宾语、定语；用于人"},{"id":10481,"word":"发喊连天","pinyin":"fā hǎn lián tiān","abbr":"fhlt","explanation":"连天：与天相连。叫喊的声音直达天上。形容喊声宏大。","source":{"text":"凭着俺猛将千员，士卒勇健，相征战，则听的发喊连天，将武艺可便从施展。","book":"明·无名氏《四马投唐》第一折"},"usage":"作谓语、定语；指喊声大"},{"id":10482,"word":"发堿决塘","pinyin":"fā kàn jué táng","abbr":"fjjt","explanation":"堿：指堤岸；塘L堤。因发大水使堤岸溃决。","source":{"text":"夫防民之所害，开民之所利，威行也。若发堿决塘，故循流而下，易以至。","book":"《淮南子·主术训》"}},{"id":10483,"word":"发奋为雄","pinyin":"fā fèn wéi xióng","abbr":"ffwx","explanation":"发奋：振作兴起。决心奋斗使自己成为杰出人才。","source":{"text":"虽处布衣而以天下为己任，此其人必能发奋为雄，卓异自立。","book":"孙中山《上李鸿章书》"},"similar":["发愤自雄"],"usage":"作谓语、宾语；用于人的志向"},{"id":10484,"word":"发奋图强","pinyin":"fā fèn tú qiáng","abbr":"fftq","explanation":"下定决心，努力追求进步。","source":{"text":"无知丕士麦才智过人，发奋图强，于1866年，用很迅速手段。","book":"孙中山《民权主义第四讲》"},"example":{"text":"～、自力更生，对于落后队贫困落后的面貌的改变，当然起着极其重要的作用。","book":"《人民日报》1959.9.3"},"similar":["发愤图强"],"opposite":["无所作为"],"usage":"作谓语、定语；指追求进步"},{"id":10485,"word":"发奋有为","pinyin":"fā fèn yǒu wéi","abbr":"ffyw","explanation":"精神振作，有所作为。","source":{"text":"你也可以借此报效朝廷，正是男子汉发奋有为之时。","book":"清·吴敬梓《儒林外史》第39回"},"similar":["奋发有为"],"usage":"作谓语、定语；指人的精神"},{"id":10486,"word":"发奋蹈厉","pinyin":"fā fèn dǎo lì","abbr":"ffdl","explanation":"发：奋发，振作；蹈：跳、踏；厉：猛烈，有力。后比喻精神奋发，意气风发昂扬。","source":{"text":"总以为社会大众谋幸福为第一义；发奋蹈厉，艰苦备尝，为的是这件事。","book":"邹韬奋《萍踪寄语》"},"similar":["发扬蹈厉"],"usage":"作谓语、定语；指意气风发"},{"id":10487,"word":"发奸摘覆","pinyin":"fā jiān zhāi fù","abbr":"fjzf","explanation":"发：揭发。揭发隐秘的坏人坏事。形容治理政事精明。","source":{"text":"彼铺张于条教号令之末，矜诩于发奸摘覆之神，曷足语知道？","book":"清·魏源《默觚下·治篇》"},"similar":["发奸露覆","发奸摘隐","发擿奸伏"],"usage":"作谓语、定语；用于处事"},{"id":10488,"word":"发奸摘隐","pinyin":"fā jiān zhāi yǐn","abbr":"fjzy","explanation":"发：揭发。揭发隐秘的坏人坏事。形容治理政事精明。","source":{"text":"再说陆公在任，公文不要，爱民如子，况又发奸摘隐，剔清利弊。","book":"明·冯梦龙《醒世恒言》第29卷"},"similar":["发奸摘覆","发擿奸伏","发隐摘伏"],"usage":"作谓语、定语；用于处事"},{"id":10489,"word":"发奸擿伏","pinyin":"fā jiān tì fú","abbr":"fjtf","explanation":"发、擿：揭发；奸：奸臣，坏人；伏：指隐瞒坏事。揭发隐秘的坏人坏事。","source":{"text":"其发奸擿伏如神。","book":"《汉书·赵广汉传》"},"example":{"text":"闻丈人～，惠化如神，何以至此？","book":"《南史·傅琰传》"},"similar":["发隐擿伏"],"opposite":["姑息养奸"],"usage":"作谓语；指揭发隐蔽的坏人坏事","story":["汉宣帝时颖川太守赵广汉秉公办案，诛杀许多残害百姓的豪强。后来他调到都城长安任京兆尹，亲自办案，捉拿坏人，经常能把藏匿的坏人坏事揭露出来，就连一般隐藏未露的情况，他也能了解得非常清楚，就像神一样灵验"]},{"id":10490,"word":"发奸露覆","pinyin":"fā jiān lù fù","abbr":"fjlf","explanation":"揭发隐秘的坏人坏事。形容治理政事精明。","source":{"text":"窃怪二千年来，通人大儒，肩背相望，而咸为瞀惑，无一人焉发奸露覆，雪先圣之沉冤。","book":"康有为《序》"},"similar":["发奸摘覆","发奸摘隐","发奸擿伏"],"usage":"作谓语、定语；用于处事"},{"id":10491,"word":"发威动怒","pinyin":"fā wēi dòng nù","abbr":"fwdn","explanation":"发威风，动怒气。","source":{"text":"你们太闹的不象了，他是个姑娘家，不肯发威动怒。","book":"清·曹雪芹《红楼梦》第五十五回"},"usage":"作谓语、宾语、定语；用于人的情绪"},{"id":10492,"word":"发宪布令","pinyin":"fā xiàn bù lìng","abbr":"fxbl","explanation":"犹发号施令。","source":{"text":"试用家君发宪布令其家。","book":"《墨子·尚同下》"},"similar":["发号施令"],"usage":"作谓语、定语、宾语；指指挥"},{"id":10493,"word":"发家致富","pinyin":"fā jiā zhì fù","abbr":"fjzf","explanation":"发展家业，使家庭变得富裕起来。","source":{"text":"这个村子里的‘大能人’，更关心的却是个人的发家致富。","book":"魏巍《东方》第三部第一章"},"example":{"text":"这几乎成为我们～的唯一出路了。"},"similar":["发财致富"],"opposite":["倾家荡产"],"usage":"作谓语、定语；指发财"},{"id":10494,"word":"发屋求狸","pinyin":"fā wū qiú lí","abbr":"fwql","explanation":"拆除房屋以求捕得狸猫。比喻因小失大。","source":{"text":"坏塘以取龟，发屋而求狸，掘室而求鼠，割唇而治龋，桀跖之徒，君子不与。","book":"《淮南子·说山训》"},"similar":["杀鸡取卵","因小失大"],"usage":"作宾语、定语；用于处事"},{"id":10495,"word":"发引千钧","pinyin":"fà yǐn qiān jūn","abbr":"fyqj","explanation":"一根头发系着千钧重的东西。比喻极危急。","source":{"text":"其危如一发引千钧。","book":"唐·韩愈《与孟尚书书》"},"similar":["千钧一发"],"usage":"作宾语、定语；同“千钧一发”"},{"id":10496,"word":"发怒冲冠","pinyin":"fā nù chōng guàn","abbr":"fncg","explanation":"形容极度愤怒。同“发上冲冠”。","source":{"text":"歌曰：‘风萧萧兮易水寒，壮士一去兮不复还。’高渐离击筑，宗意和之。如壮声则发怒冲冠，为哀声则士皆流涕。","book":"《燕丹子》下卷"},"similar":["怒发冲冠"],"usage":"作谓语、状语、定语；形容极端愤怒","story":["公元前227年，秦国打败赵国，迫近燕国。燕国太子丹请勇士荆轲去刺杀秦王。荆轲带上秦王的仇人樊于期的人头及督亢地地图。太子丹把他送到易水河边，高渐离为荆轲奏乐，荆轲怒发冲冠高唱：“风萧萧兮易水寒，壮士一去兮不复还。”"]},{"id":10497,"word":"发怒穿冠","pinyin":"fà nù chuān guān","abbr":"fncg","explanation":"毛发竖起的样子。形容极度愤怒。同“发上冲冠”。","source":{"text":"张目决眦，发怒穿冠。","book":"三国·魏·曹植《鼙舞歌五首》之五"}},{"id":10498,"word":"发愤图强","pinyin":"fā fèn tú qiáng","abbr":"fftq","explanation":"发愤：决心努力；图：谋求。决心奋斗，努力谋求强盛。","source":{"text":"孙先生在那次聚会上谈得并不多，只泛泛地谈到了中国积弱太甚了，应该发愤图强，彻底革命。","book":"何香凝《孙中山与廖仲恺》"},"example":{"text":"上下一心，日夜兢兢业业，勤勤恳恳，～。","book":"姚雪垠《李自成》第二卷第15章"},"similar":["奋发图强","发奋图强","卧薪尝胆"],"opposite":["胸无大志","无所作为","妄自菲薄"],"usage":"作谓语、定语；指要求进步","story":["春秋时期，孔子带领学生周游列国讲学，来到楚国叶邑，叶公沈诸梁接待了他，他对孔子不怎么了解，就悄悄地问子路，子路一时不知怎么回答他。孔子事后得知就对子路说以后就说：“其为人也，发愤忘食，乐以忘忧，不知老之将至。”"]},{"id":10499,"word":"发愤展布","pinyin":"fā fèn zhǎn bù","abbr":"ffzb","explanation":"发愤：下决心，立志；展：伸展；布：展开；展布：施展才能、抱负。发奋振作，施展才能。","source":{"text":"则一现女身，纵天地予以奇才，无复有发愤展布之日，仅为一家一姓育子女。","book":"康有为《大同书》戍部第一章"},"usage":"作谓语、宾语、定语；用于人的志向等"},{"id":10500,"word":"发愤忘食","pinyin":"fā fèn wàng shí","abbr":"ffws","explanation":"努力学习或工作，连吃饭都忘了。形容十分勤奋。","source":{"text":"发愤忘食，乐以忘忧，不知老之将至云尔。","book":"《论语·述而》"},"example":{"text":"既这样～起来，也好，就由你去。","book":"清·文康《儿女英雄传》第三十四回"},"similar":["废寝忘食","发愤忘餐"],"opposite":["游手好闲"],"usage":"作谓语、定语；形容十分勤奋","story":["春秋时期，孔子带领学生周游列国讲学，来到楚国叶邑，叶公沈诸梁接待了他，他对孔子不怎么了解，就悄悄地问子路，子路一时不知怎么回答他。孔子事后得知就对子路说以后就说：“其为人也，发愤忘食，乐以忘忧，不知老之将至。”"]},{"id":10501,"word":"发愤忘餐","pinyin":"fā fèn wàng cān","abbr":"ffwc","explanation":"发愤：下决心，立志；餐：吃饭。发愤学习或工作，连吃饭都忘了。形容十分勤奋。","source":{"text":"拔萃衡门，俱渐鸿翼，发愤忘餐，岂要斗食。","book":"《魏书·高允传》"},"similar":["发愤忘食"],"usage":"作补语、定语；形容十分勤奋"},{"id":10502,"word":"发愤自厉","pinyin":"fā fèn zì lì","abbr":"ffzl","explanation":"发愤：下决心，立志；厉：磨砺。立志磨炼自己。","source":{"text":"夫处阴极玄黄之世，材者宜发愤自厉，复我种族。","book":"章炳麟《与刘揆一书》"},"usage":"作谓语、宾语、定语；用于人的志向等"},{"id":10503,"word":"发愤自雄","pinyin":"fā fèn zì xióng","abbr":"ffzx","explanation":"决心奋斗，而使自己强盛有实力。","source":{"text":"愿吾弟发愤自雄，勿蹈乃兄故辙也。","book":"清·郑燮《潍县署中与舍弟第五书》"},"example":{"text":"然苟我～，西人将见好于我不暇，遑敢我。","book":"邹鲁《中国同盟会》"},"similar":["发奋为雄"],"usage":"作谓语、宾语；用于人的志向"},{"id":10504,"word":"发扬光大","pinyin":"fā yáng guāng dà","abbr":"fygd","explanation":"发扬：发展，提倡；光大：辉煌而盛大。使好的作风、传统等得到发展和提高。","source":{"text":"坤厚载物，德合无疆，含弘光大，品物咸享。","book":"《周易·坤》"},"example":{"text":"最合理的孝道恐怕是继承父辈的成就，把它～，好教下一辈得到更好的精神的与物质的遗产。","book":"老舍《四世同堂》六十四"},"similar":["踵事增华"],"usage":"作谓语、宾语；多用于讲话"},{"id":10505,"word":"发扬岩穴","pinyin":"fā yáng yán xué","abbr":"fyyx","explanation":"岩穴：山洞，引申为隐居之处或隐士。表彰提倡不求功名的人。","source":{"text":"臣愚以为宜下明诏，博求幽隐，发扬岩穴，宠进儒雅。","book":"《后汉书·樊宏传》附樊准上书"}},{"id":10506,"word":"发扬踔厉","pinyin":"fā yáng chuō lì","abbr":"fycl","explanation":"原指周初《武》乐的舞蹈动作。手足发扬，蹈地而猛烈，象征太公望辅助武王伐纣时勇往直前的意志。后比喻精神奋发，意气昂扬。","source":{"text":"发扬蹈厉，太公之志也。","book":"《礼记·乐记》"},"example":{"text":"倘或换一个～的的局面，人心一变，鼓舞向上，那时候大申天讨，倒要让大家看看，到底谁行谁不行．","book":"高阳《清宫外史》下册"},"similar":["发扬蹈厉"],"usage":"作谓语；比喻精神奋发，意气昂扬"},{"id":10507,"word":"发扬蹈励","pinyin":"fā yáng dǎo lì","abbr":"fydl","explanation":"发：奋发，振作；扬：昂扬；蹈：跳、踏。后比喻精神奋发，意气风发昂扬。","source":{"text":"至若老吕，以鹰扬称，以发扬蹈励称，未免露出将才气象，此老吕不及老伊处也。","book":"明·唐顺之《寄赵浚谷》"},"similar":["发扬蹈厉","发扬踔厉"],"usage":"作谓语、定语；指意气风发"},{"id":10508,"word":"发扬蹈厉","pinyin":"fā yáng dǎo lì","abbr":"fydl","explanation":"原指周初《武》乐的舞蹈动作。手足发扬，蹈地而猛烈，象征太公望辅助武王伐纣时勇往直前的意志。后比喻精神奋发，意气昂扬。","source":{"text":"发扬蹈厉，太公之志也。","book":"《礼记·乐记》"},"example":{"text":"优游国域决行藏，搅海翻江惊天地。～，功名万里。","book":"清·吴璿《飞龙全传》第五十五回"},"similar":["意气风发","发扬蹈励"],"opposite":["无精打采","委靡不振"],"usage":"作谓语、定语；指意气风发"},{"id":10509,"word":"发指眦裂","pinyin":"fà zhǐ zì liè","abbr":"fzzl","explanation":"发指：头发直竖；眦裂：眼眶裂开。头发向上竖，眼睑全张开。形容非常愤怒。","source":{"text":"瞋目视项王，头发上指，目眦尽裂。","book":"《史记·项羽本纪》"},"example":{"text":"瞧见这部书，便追溯庚子年的事，说到激烈之处，不觉～。","book":"清·李宝嘉《文明小史》第五十九回"},"similar":["怒火冲天","怒火中烧"],"opposite":["和颜悦色","眉开眼笑"],"usage":"作谓语、宾语；形容非常愤怒","story":["西汉三年，项羽拥兵40万在新丰鸿门，听从谋士范增的意见尽快除掉刘邦，项伯将消息透露给张良，张良向刘邦汇报。第二天刘邦就去鸿门赴宴，宴上项庄舞剑要杀刘邦，刘邦的卫士樊哙怒目而视，头发直竖，誓死保卫刘邦"]},{"id":10510,"word":"发摘奸隐","pinyin":"fā zhāi jiān yǐn","abbr":"fzjy","explanation":"发：揭发。揭发隐秘的坏人坏事。形容治理政事精明。","source":{"text":"彦光下车，发摘奸隐，有若神明。","book":"《北史·循吏传·梁彦光》"},"similar":["发擿奸伏","发奸擿伏"],"usage":"作谓语、定语；用于处事"},{"id":10511,"word":"发擿奸伏","pinyin":"fā tì jiān fú","abbr":"ftjf","explanation":"发：揭发。揭发隐秘的坏人坏事。形容治理政事精明。","source":{"text":"善政事，好发擿奸伏，盗贼稀发，吏人畏爱之。","book":"南朝·宋·范晔《后汉书·法雄传》"},"example":{"text":"参天学术，然刚果严深，喜～，不假贷。","book":"《宋史·李参传》"},"similar":["发奸擿伏","发奸摘隐","发隐摘伏"],"usage":"作谓语、定语、宾语；用于处事"},{"id":10512,"word":"发政施仁","pinyin":"fā zhèng shī rén","abbr":"fzsr","explanation":"发布政令，实施仁政。比喻统治者施行开明政治。","source":{"text":"方是时，二圣在位，发政施仁，惟恐不及。","book":"宋·苏轼《论赏罚及修河事》"},"example":{"text":"～四海扬，太平世尊荣坐享。","book":"明·无名氏《南牢记》第四折"},"usage":"作谓语；比喻统治者施行开明政治"},{"id":10513,"word":"发明耳目","pinyin":"fā míng ěr mù","abbr":"fmem","explanation":"发明：启发，使明白。开阔视听，扩大见闻。","source":{"text":"发明耳目，宁体便人。","book":"战国·楚·宋玉《风赋》"}},{"id":10514,"word":"发昏章第十一","pinyin":"fā hūn zhāng dì shí yī","abbr":"fhzdsy","explanation":"昏头昏脑的风趣话。仿《孝经》“某某章第几”的说法。","source":{"text":"一者冤魂缠定，二乃天理难容，三来怎当武松神力，至见头在下，脚在上，倒撞落在当街心里去了，跌得个发昏章第十一。","book":"明·施耐庵《水浒传》第26回"},"example":{"text":"所谓‘北大同人’，正在～，排班欢迎。","book":"鲁迅《两地书》"},"usage":"作谓语、宾语；指发昏"},{"id":10515,"word":"发棠之请","pinyin":"fā táng zhī qǐng","abbr":"ftzq","explanation":"发：发放；棠：齐国地名，积谷之处；请：请求。原指孟轲劝请齐王发放棠邑粮食赈济饥民。后指请示赈济。","source":{"text":"齐饥，陈瑧曰：‘国人皆以夫子将复为发棠之请。’","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"地震灾后，人们都在盼望～。"},"usage":"作宾语；指请示赈济"},{"id":10516,"word":"发植穿冠","pinyin":"fà zhí chuān guān","abbr":"fzcg","explanation":"形容极度愤怒。同“发上冲冠”。","source":{"text":"荆轲西刺秦王，高渐离、宋意为击筑而歌于易水之上，闻者瞋目裂眦，发植穿冠。","book":"《淮南子·泰族训》"}},{"id":10517,"word":"发潜阐幽","pinyin":"fā qián chǎn yōu","abbr":"fqcy","explanation":"阐发沉潜深奥的事义道理。","source":{"text":"夫彰往而察来，而显微阐幽。","book":"《周易·系辞下》"},"example":{"text":"此翰苑笔也，聊赠一枝，以报～之厚意。","book":"清·薛福成《庸盦笔记·桃花夫人示梦》"},"usage":"作谓语、定语；用于处事"},{"id":10518,"word":"发皇张大","pinyin":"fā huáng zhāng dà","abbr":"fhzd","explanation":"发皇：显豁，开朗。发展扩大。","source":{"text":"我取为书名，无非暗示蒋政权压迫左翼文艺，虽甚残酷，然而左翼文艺必将发皇张大，有如宿莽之冬生不死或遇冬不枯也。","book":"《新华文摘》1981年第11期"},"usage":"作谓语、定语；指发展扩大"},{"id":10519,"word":"发皇耳目","pinyin":"fā huáng ěr mù","abbr":"fhem","explanation":"发皇：启发。开阔视听，扩大见闻。","source":{"text":"分决狐疑，发皇耳目。","book":"战国·楚·宋玉《风赋》：“发明耳目，宁体便人。”汉·枚乘《七发》"}},{"id":10520,"word":"发瞽振聋","pinyin":"fā gǔ zhèn lóng","abbr":"fgzl","explanation":"发：开启；瞽：盲人；振：振动；聋：耳聋。使盲人也能看见，使聋人也听得见。比喻言论文章使人清醒感奋。","source":{"text":"当时之是，虽有淹病滞疾，犹将伸佉起蹙，发瞽振聋而观望之也。","book":"汉·枚乘《七发》"},"similar":["发蒙振聩"],"usage":"作谓语、定语；用于文章等"},{"id":10521,"word":"发短心长","pinyin":"fà duǎn xīn cháng","abbr":"fdxc","explanation":"发短：指年老；心长：智谋深。头发稀少，心计很多。形容年老而智谋高。","source":{"text":"彼其发短而心甚长，其或寝处我矣。","book":"《左传·昭公三年》"},"example":{"text":"汉家尚壮今则老，～知奈何。","book":"唐·李端《赠康洽》诗"},"similar":["老谋深算"],"usage":"作补语、定语；形容年老而智谋高"},{"id":10522,"word":"发硎新试","pinyin":"fā xíng xīn shì","abbr":"fxxs","explanation":"硎：磨刀石。象新磨的刀那样锋利。比喻刚参加工作就显露出出色的才干。","source":{"text":"是以十九年而刀刃若新发于硎。","book":"《庄子·养生主》"},"example":{"text":"生喜，捉臂登床，～，其快可知。","book":"清·蒲松龄《聊斋志异·巧娘》"},"similar":["初露锋芒"],"usage":"作宾语、补语；指初露锋芒"},{"id":10523,"word":"发秃齿豁","pinyin":"fà tū chǐ huò","abbr":"ftch","explanation":"关发脱光，牙齿豁落。形容人已衰老。","source":{"text":"私自怜悼，悔其初心，发秃齿豁，不见知己。","book":"唐·韩愈《上兵部李侍郎书》"},"example":{"text":"他已经到了～的年纪。"},"similar":["老态龙钟"],"usage":"作谓语、定语；形容人已衰老"},{"id":10524,"word":"发科打诨","pinyin":"fā kē dǎ hùn","abbr":"fkdh","explanation":"以滑稽的动作和语言引人发笑。","source":{"text":"锦心绣腹，宣扬《老子》经文，发科打诨，不离机锋；课嘴撩牙，长存道眼。","book":"明·陶宗仪《南村辍耕录·连枝秀》"},"similar":["插科打诨","发科打趣"],"usage":"作谓语、宾语、定语；泛指开玩笑逗乐"},{"id":10525,"word":"发科打趣","pinyin":"fā kē dǎ qù","abbr":"fkdq","explanation":"科：古戏曲用语；打趣：用诙谐的言语凑趣助兴。以滑稽的动作和诙谐的语言逗人发笑或拿人开玩笑。","source":{"text":"那稿子是同黄通理大家参酌，中间也有发科打趣的处在。","book":"清·颐琐《黄绣球》第15回"},"similar":["发科打诨"],"usage":"作谓语、宾语、定语；泛指开玩笑逗乐"},{"id":10526,"word":"发策决科","pinyin":"fā cè jué kē","abbr":"fcjk","explanation":"策：策问；科：等第。拆阅策问题目，以决定录取。旧指应试取中。","source":{"text":"或曰：‘书与经同，而世不尚，治之可乎？’曰：‘可。’或人哑尔笑曰：‘须以发策决科。’","book":"汉·扬雄《法言·学行》"},"example":{"text":"～者，授子而不憟。","book":"唐·柳宗元《贺进士王对元失火书》"},"similar":["金榜题名"],"opposite":["名落孙山"],"usage":"作谓语、宾语；指应试取中"},{"id":10527,"word":"发纵指使","pinyin":"fā zòng zhǐ shǐ","abbr":"fzzs","explanation":"操纵指挥。亦作“发踪指使”。","source":{"text":"几十年前，发纵指使略夺东亚满洲的参谋本部——彼得之城，不意今日又成远东革命声浪留音之机。","book":"瞿秋白《赤都心史》四一"},"example":{"text":"《骆宾王文集》凡十卷，是郗云卿奉唐中宗之命搜集的，我想这一定是上官婉儿的主张。因为中宗时代的措施，大抵出于上官昭容的～。","book":"郭沫若《我怎样写〈武则天〉"},"similar":["发纵指示","发踪指使","发踪指示"],"usage":"作谓语、定语、宾语；指幕后指使"},{"id":10528,"word":"发纵指示","pinyin":"fā zòng zhǐ shì","abbr":"fzzs","explanation":"发：发现；纵：放纵，也通“踪”。发现野兽的踪迹，指示猎狗跟踪追捕。比喻暗中操纵指挥。","source":{"text":"夫猎，追杀兽兔者狗也，而发踪指示兽处者人也。","book":"西汉·司马迁《史记·萧相国世家》"},"example":{"text":"所谓‘自治运动’，始终在～，未曾忘怀，早是公开的秘密。","book":"邹韬奋《外交的途经》"},"similar":["发踪指示","发纵指使"],"usage":"作谓语、宾语；比喻在后面操纵指挥","story":["秦朝末年，刘邦起兵被封为沛公后，萧何成为刘邦的得力助手，他帮助刘邦保存秦朝的各种文献档案，留守关中，为刘邦提供军粮和新兵，引荐大将韩信。在汉朝建立后刘邦论功行赏时，他评论萧何是发踪指示的猎人，功劳最大"]},{"id":10529,"word":"发综指示","pinyin":"fā zōng zhǐ shì","abbr":"fzzs","explanation":"猎人发现野兽的踪迹，指示猎狗跟踪追捕。比喻在后面操纵指挥。","source":{"text":"夫猎，追杀兽兔者狗也，而发踪指示兽处者人也。","book":"《史记·萧相国世家》"},"example":{"text":"不过是要小翁～，我们自然协力同心。","book":"《续孽海花》第四十五回"}},{"id":10530,"word":"发聋振聩","pinyin":"fā lóng zhèn kuì","abbr":"flzk","explanation":"聩：耳聋。声音很大，连耳聋的人也听得见。比喻用语言文字唤醒麻木的人。","source":{"text":"此数言，振聋发聩，想当时必有曲士以经学谈诗者。","book":"清·袁枚《随园诗话补遗》"},"example":{"text":"出了匕首、投枪，也还有～的木铎，有悠然发人深思的静夜钟声。","book":"茅盾《联系实际、学习鲁迅》"},"similar":["发聩振聋","醍醐灌顶"],"usage":"作谓语、定语；比喻唤醒麻木的人","story":["清朝时期，英国舰船经常侵犯中国领海主权，以保护向中国输送鸦片的贸易，鸿胪寺卿黄爵滋忧心忡忡。他上《禁烟议疏》给道光皇帝，列举大量的数据与材料证明鸦片的危害，提出为了严禁鸦片，应不惜动用死刑，以达到发聋振聩的目的"]},{"id":10531,"word":"发荣滋长","pinyin":"fā róng zī zhǎng","abbr":"frzz","explanation":"荣：草类开花或谷类结穗；滋长：生长。指草木繁茂生长。比喻茁壮成长。","source":{"text":"四者之入于心，如木之于地，根深柢固，故能发荣滋长，畅茂荣达而生色也。","book":"明·高攀龙《讲义·君子所性仁义礼智根于心》"},"example":{"text":"人类尚未长成，人道自然也尚未长成，但总在那里～。","book":"鲁迅《热风·随感录》"},"usage":"作谓语、定语；用于草木及人等"},{"id":10532,"word":"发蒙启滞","pinyin":"fā méng qǐ zhì","abbr":"fmqz","explanation":"发蒙：启发蒙昧；滞：不流通。启发蒙昧，打通阻塞。","source":{"text":"古之建国，教学为先，弘风训世，莫当于此，发蒙启滞，咸必之。","book":"《宋书·武帝纪下》"},"similar":["发蒙启蔽"],"usage":"作谓语、定语；用于教师等"},{"id":10533,"word":"发蒙启蔽","pinyin":"fā méng qǐ bì","abbr":"fmqb","explanation":"发蒙：启发蒙昧；蔽：蒙蔽。启发蒙昧。","source":{"text":"发蒙启蔽，时或未省，而退实沉思。","book":"明·李贽《答李见罗先生书》"},"similar":["发蒙启滞"],"usage":"作谓语、定语；用于教师等"},{"id":10534,"word":"发蒙振槁","pinyin":"fā méng zhèn gǎo","abbr":"fmzg","explanation":"发：揭开；蒙：蒙盖物；振：抖动。揭开蒙盖物，摇掉将落的枯叶。比喻轻而易举。","source":{"text":"盖天速其祸，如发蒙振槁，无烦驱除矣。","book":"《明史·杨乃郭詹等传论》"},"similar":["发蒙振落"],"usage":"作谓语、宾语、定语；比喻事情很容易做到"},{"id":10535,"word":"发蒙振聩","pinyin":"fā méng zhèn kuì","abbr":"fmzk","explanation":"声音很大，连耳聋的人也听得见。比喻用语言文字唤醒麻木的人。","source":{"text":"此数言，振聋发聩，想当时必有曲士以经学谈诗者。","book":"清·袁枚《随园诗话补遗》"},"example":{"text":"先生，你这一番议论，真可谓之～。","book":"清·吴敬梓《儒林外史》第四十四回"},"similar":["振聋发聩"],"usage":"作谓语、定语；用于文章等"},{"id":10536,"word":"发蒙振落","pinyin":"fā méng zhèn luò","abbr":"fmzl","explanation":"蒙：遮盖，指物品上的罩物；振：摇动。把蒙在物体上的东西揭掉，把将要落的树叶摘下来。比喻事情很容易做到。","source":{"text":"至如说丞相弘，如发蒙振落耳。","book":"《史记·汲郑列传》"},"example":{"text":"若一切许其登录，锐意奖进，则去此如～，如是而王道荡平，大圜停水之中，无少有坎窞矣。","book":"章炳麟《代议然否论》"},"similar":["轻而易举","发蒙振槁"],"usage":"作谓语、宾语；比喻事情很容易做到","story":["西汉主管封爵事务的主爵都尉汲黯是位忠正耿直的大臣，他敢于直言进谏，有时让汉武帝下不了台。淮南王刘安准备反叛，他害怕汲黯，叫手下严防汲黯，而对付丞相公孙弘，好像揭开蒙盖在眼睛上的障碍，振落树上的枯叶一样容易"]},{"id":10537,"word":"发蒙解惑","pinyin":"fā méng jiě huò","abbr":"fmjh","explanation":"发蒙：启发蒙昧；解惑：解除疑惑。指启发开导，脱离蒙昧，解除疑惑。","source":{"text":"故曰发蒙解惑，不足以言也。","book":"汉·枚乘《七发》"},"similar":["发蒙解缚"],"usage":"作宾语、定语；指启蒙"},{"id":10538,"word":"发蒙解缚","pinyin":"fā méng jiě fu","abbr":"fmjf","explanation":"发蒙：启发蒙昧；解缚：解除束缚。指启发蒙昧，解除束缚。","source":{"text":"其龌龊处，又恨不得就明公而为发蒙解缚也。","book":"明·唐顺之《与顾箸溪书》"},"example":{"text":"他的书有～的功效。"},"similar":["发蒙解惑"],"usage":"作宾语、定语；指启蒙"},{"id":10539,"word":"发言盈庭","pinyin":"fā yán yíng tíng","abbr":"fyyt","explanation":"盈：满。形容好多人聚在一起议论，意见纷纷，得不出一致的结论。","source":{"text":"谋夫孔多，是用不聚。发言盈庭，谁敢执其咎。","book":"《诗经·小雅·小旻》"},"example":{"text":"有主战的，有主和的，～，日中未决。","book":"蔡东藩、许廑父《民国通俗演义》第六十五回"},"similar":["人多口杂","众说纷纭"],"opposite":["异口同声","众口一词"],"usage":"作谓语；指人多言杂"},{"id":10540,"word":"发誓赌咒","pinyin":"fā shì dǔ zhòu","abbr":"fsdz","explanation":"咒：誓言。庄严地说出表示决心的话或对某事提出保证。","source":{"text":"先是我发誓赌咒砸这劳什子，你都没劝过，说我疯的？刚刚的这几日才好了，你又来怄我。","book":"清·曹雪芹《红楼梦》第57回"},"example":{"text":"王朔《一点正经没有》：“马青指着脑门子～。”"},"similar":["赌咒发誓"],"usage":"作谓语、宾语、定语、状语；指发誓"},{"id":10541,"word":"发财致富","pinyin":"fā cái zhì fù","abbr":"fczf","explanation":"因获得大量财物而富裕起来。","source":{"text":"只要努力，每个人都有发财致富的机会。","book":"魏巍《东方》第六部第五章"},"example":{"text":"有人做梦都在～。"},"similar":["发家致富"],"usage":"作谓语、定语；指获得财物而富裕起来"},{"id":10542,"word":"发踊冲冠","pinyin":"fà yǒng chōng guān","abbr":"fycg","explanation":"毛发竖起貌。形容极度愤怒。同“发上冲冠”。","source":{"text":"毛发竖起貌。形容极度愤怒。同“发上冲冠”。"},"example":{"text":"宋·徐爰《旄头说》：“臣谓壮士之怒，发踊冲冠，义取於此。”"},"similar":["发怒冲冠","发上冲冠"],"usage":"作谓语、状语、定语；形容极端愤怒"},{"id":10543,"word":"发踪指使","pinyin":"fā zōng zhǐ shǐ","abbr":"fzzs","explanation":"操纵指挥。同“发纵指使”。","source":{"text":"美国在一九一七年的参加世界大战，也是出于华尔街的发踪指使。","book":"邹韬奋《萍踪忆语》四"},"similar":["发踪指示","发纵指示"],"usage":"作谓语、定语、宾语；指幕后指使"},{"id":10544,"word":"发踪指示","pinyin":"fā zōng zhǐ shì","abbr":"fzzs","explanation":"踪：踪迹。发现野兽的踪迹，指示猎狗跟踪追捕。比喻在幕后操纵指挥。","source":{"text":"夫猎，追杀兽兔者狗也，而发踪指示兽处者人也。","book":"西汉·司马迁《史记·萧相国世家》"},"example":{"text":"不过是要小翁～，我们自然协力同心。","book":"《续孽海花》第四十五回"},"similar":["幕后操纵","发踪指使"],"usage":"作谓语、定语、宾语；指幕后指使","story":["秦朝末年，刘邦起兵被封为沛公后，萧何成为刘邦的得力助手，他帮助刘邦保存秦朝的各种文献档案，留守关中，为刘邦提供军粮和新兵，引荐大将韩信。在汉朝建立后刘邦论功行赏时，他评论萧何是发踪指示的猎人，功劳最大"]},{"id":10545,"word":"发轫之始","pinyin":"fā rèn zhī shǐ","abbr":"frzs","explanation":"发轫：把支住车轮的木头抽掉，使车辆前进。比喻事情的开始。","source":{"text":"以李彦青一生事业而论，此时还不过发轫之始。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十八回"},"usage":"作宾语；指事情的开始"},{"id":10546,"word":"发迹变泰","pinyin":"fā jì biàn tài","abbr":"fjbt","explanation":"指人升了官，发了财，志得意满。","source":{"text":"说公案，皆是搏刀赶棒及发迹变泰之事。","book":"宋·灌圃耐得翁《都城纪胜·瓦舍众伎》"},"example":{"text":"自他未曾～的时节，也就是个铁铮铮的好汉。","book":"明·冯梦龙《警世通言·赵太祖千里送京娘》"},"usage":"作定语；用于人的命运"},{"id":10547,"word":"发隐摘伏","pinyin":"fā yǐn zhāi fú","abbr":"fyzf","explanation":"发：揭发。揭发隐秘的坏人坏事。形容治理政事精明。","source":{"text":"发隐摘伏，敏捷如神。","book":"宋·秦观《越州请立程给事祠堂状》"},"similar":["发擿奸伏","发奸摘覆","发奸露覆"],"usage":"作谓语、定语；用于处事"},{"id":10548,"word":"发隐擿伏","pinyin":"fā yǐn tī fú","abbr":"fytf","explanation":"揭露隐蔽的坏人坏事。","source":{"text":"［程给事］发隐擿伏，敏捷如神。","book":"宋·秦观《越州请立程给事祠堂状》"},"similar":["发隐摘伏"],"usage":"作谓语、定语；用于处事"},{"id":10549,"word":"叔度陂湖","pinyin":"shū dù bēi hú","abbr":"sdbh","explanation":"叔度，黄宪字。后比喻人度量宽大。","source":{"text":"叔度汪汪若千顷陂，澄之不清，淆之不浊，不可量也。","book":"南朝·宋·范晔《后汉书·黄宪传》"},"example":{"text":"多君于士元廊庙，待我以～。","book":"唐·黄滔《祭崔补阙道融文》"},"usage":"作宾语、定语；指人的度量"},{"id":10550,"word":"取与不和","pinyin":"qǔ yǔ bù hé","abbr":"qybh","explanation":"指用不正当的手段获取财物。","source":{"text":"取与不和，虽和，与者无罪。","book":"《故唐律疏议》卷四"}},{"id":10551,"word":"取义成仁","pinyin":"qǔ yì chéng rén","abbr":"qycr","explanation":"指为正义而牺牲生命。","source":{"text":"志士仁人，无求生以害仁，有杀身以成仁。","book":"春秋·鲁·孔丘《论语·卫灵公》"},"example":{"text":"～今日事，人间遍种自由花。","book":"陈毅《梅岭三章》"},"usage":"作谓语、宾语、定语；用于处世"},{"id":10552,"word":"取之不尽","pinyin":"qǔ zhī bù jìn","abbr":"qzbj","explanation":"拿不尽。形容极其丰富。","source":{"text":"他那源头只管来得不绝，取之不尽用之不竭，来供自家用。","book":"宋·朱熹《朱子语类·孟子·离娄下》"},"example":{"text":"我们拥有～的宝山，只等我们虚心地去开发。","book":"巴金《谈我的短篇小说》"},"similar":["取之不竭","取之不尽，用之有余"],"usage":"作谓语、定语；用于书面语"},{"id":10553,"word":"取之不尽，用之不竭","pinyin":"qǔ zhī bù jìn，yòng zhī bù jié","abbr":"qzbjyzbj","explanation":"竭：尽，完。拿不完，用不尽。形容非常丰富。","source":{"text":"唯江上之清风，与山间之明月，耳得之而为声，目遇之而成色，取之无禁，用之不竭。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"水资源并不是～，因此我们要珍惜用水。"},"similar":["无穷无尽","源源不断"],"opposite":["空无一物"],"usage":"作宾语、定语、分句；形容数量多","story":["宋朝时期，苏轼被贬到黄州后，他游览赤壁后，即兴作《赤壁赋》“惟江上之清风，与山间之明月，耳得之而为声，目遇之而成色，取之无禁，用之不竭，是造物者之无尽藏也。”倾诉他的怀才不遇之感怀"]},{"id":10554,"word":"取之不尽，用之有余","pinyin":"qǔ zhī bù jìn，yòng zhī yǒu yú","abbr":"qzbjyzyy","explanation":"拿不完，用不尽。形容非常丰富，源源不断。","source":{"text":"你自己的家财取之不尽，用之有余……却是因何舍了自己的祖业，去住人家的不吉房廊？","book":"清·西周生《醒世姻缘传》第94回"},"similar":["取之不尽","取之不尽，用之不竭"],"usage":"作宾语、定语、分句；形容数量多"},{"id":10555,"word":"取之不竭","pinyin":"qǔ zhī bù jié","abbr":"qzbj","explanation":"竭：尽，完。拿不完，用不尽。形容非常丰富。","source":{"text":"注焉而不满，酌焉而不竭。","book":"《庄子·天地》"},"example":{"text":"兄之文章，有源有委，……～。","book":"宋·陈亮《祭郑景元提干文》"},"similar":["取之不尽","取之不尽，用之有余"],"usage":"作谓语、定语；用于书面语"},{"id":10556,"word":"取乱侮亡","pinyin":"qǔ luàn wǔ wáng","abbr":"qlww","explanation":"古代国家的一种自视正义的对外策略。指夺取政治荒乱的国家，侵侮将亡的国家。","source":{"text":"兼弱攻昧，取乱侮亡。","book":"《尚书·仲虺之诰》"},"example":{"text":"陷晋州转败为胜，擒齐主～。","book":"蔡东藩《南北史演义》第七十八回"}},{"id":10557,"word":"取乱存亡","pinyin":"qǔ luàn cún wáng","abbr":"qlcw","explanation":"古代国家的一种自视正义的对外策略。指夺取政治荒乱的国家，保全将亡的国家。"},{"id":10558,"word":"取予有节","pinyin":"qǔ yù yǒu jié","abbr":"qyyj","explanation":"获取和给予是有节制的，比喻不苟贪得。","source":{"text":"取予有节，出入有时。","book":"《淮南子·本经训》"},"usage":"作谓语、定语；指不贪"},{"id":10559,"word":"取以来","pinyin":"qu yi lai","abbr":"qyl","explanation":"把他们搬取到我这里来。"},{"id":10560,"word":"取信于人","pinyin":"qǔ xìn yú rén","abbr":"qxyr","explanation":"比喻取得别人的信赖。","source":{"text":"取信于人主之怀，止谤于众多之口。","book":"晋·陆机《豪士赋序》"},"example":{"text":"大王犹自狐疑未定，安能～？","book":"明·罗贯中《三国演义》第八十四回"},"similar":["取信于民"],"usage":"作谓语、定语；用于处事"},{"id":10561,"word":"取信于民","pinyin":"qǔ xìn yú mín","abbr":"qxym","explanation":"取得人民的信任。","source":{"text":"览往事之戒，以折中取信。","book":"《汉书·楚元王传》"},"example":{"text":"当时的情况是弱国抵抗强国。文中指出了战前的政治准备——～。（毛泽东《中国革命战争的战略问题》）"},"similar":["取信于人"],"usage":"作谓语、定语、宾语；用于处事"},{"id":10562,"word":"取其精华，去其糟粕","pinyin":"qǔ qí jīng huá，qù qí zāo bó","abbr":"qqjhqqzp","explanation":"精华：事物最好的部分；糟粕：酒糟、豆渣一类的东西，喻指无用之物。吸取事物中最好的东西，舍弃事物中坏的，无用的东西。","source":{"text":"我们现在提倡读书要用批判的眼光，要取其精华，去其糟粕，这个主张古代读书人却没有胆量提出。","book":"马南邨《不要秘诀的秘诀》"},"similar":["去其糟粕，存其精华"],"usage":"作宾语、定语；用于处事"},{"id":10563,"word":"取友必端","pinyin":"qǔ yǒu bì duān","abbr":"qybd","explanation":"取：选取；端：端正。正派的人选择朋友必然端正。形容选择朋友必须是品行端正的人。","source":{"text":"夫伊公之他，端人也，其取友必端矣。","book":"《孟子·离娄下》"}},{"id":10564,"word":"取名致官","pinyin":"qǔ míng zhì guān","abbr":"qmzg","explanation":"致：取得、获得。获得了名声和官爵。比喻名利双收。","source":{"text":"夫今之务利而遗道，其学其问以之取名致官而已，得一名获一位。","book":"唐·韩愈《上考功崔虞部书》"}},{"id":10565,"word":"取威定功","pinyin":"qǔ wēi dìng gōng","abbr":"qwdg","explanation":"取得威望，策定功勋。比喻功高威重。","source":{"text":"明者举大略细，不忮不求，故能取威定功，成天平地。","book":"《抱朴子·接疏》"},"example":{"text":"辅弼之臣，军国是赖。兴化致理，秉钧以居。～，则分阃而出。","book":"《旧唐书·裴度传》"}},{"id":10566,"word":"取威定霸","pinyin":"qǔ wēi dìng bà","abbr":"qwdb","explanation":"取得威望，策定霸业。比喻功高威重。","source":{"text":"取威定霸，于是乎在。","book":"《左传·僖公二十七年》"},"example":{"text":"出民水火，大仁也。兴灭继绝，大名也。～，大功也。","book":"蔡东藩《清史演义》第十二回"}},{"id":10567,"word":"取容当世","pinyin":"qǔ róng dāng shì","abbr":"qrds","explanation":"取容：取悦；当世：旧指权贵。比喻博取当权者的欢喜。","source":{"text":"以不能取容当世，故终身不仕。","book":"《汉书·张释之传》"},"example":{"text":"公孙弘则智足饰奸，～，以视董子辕固之守正不阿，固大相径庭矣。","book":"蔡东藩《前汉演义》第六十五回"}},{"id":10568,"word":"取巧图便","pinyin":"qǔ qiǎo tú biàn","abbr":"qqtb","explanation":"使用手段谋取好处，图得便宜。","example":{"text":"……做了这一切，才能缩短战争的时间，此外不能有任何～的法门。","book":"毛泽东《论持久战》"}},{"id":10569,"word":"取快一时","pinyin":"qǔ kuài yī shí","abbr":"qkys","explanation":"只图暂时的快乐，不顾其他的利害关系。","source":{"text":"我行小时亦何审，人生取快宁多时。","book":"元·吴师道《舟行得风》"},"example":{"text":"青年人爱讽刺，冷嘲热骂，一学就成，挥之不去；但是这只足以～，久了也会无聊起来的。","book":"朱自清《论青年》"}},{"id":10570,"word":"取易守难","pinyin":"qǔ yì shǒu nán","abbr":"qysn","explanation":"夺取天下容易，守住天下困难。形容创业容易，守业难。","source":{"text":"岂取之易，守之难乎？","book":"唐·魏征《谏太宗十思疏》"},"example":{"text":"廷弼不得已出关，次右屯，而驰奏海州～，不宜轻举。","book":"《明史·熊廷弼传》"}},{"id":10571,"word":"取民愈广","pinyin":"qu min yu guang","abbr":"qmyg","explanation":"攫取民众的财货,劳力越多."},{"id":10572,"word":"取法乎上","pinyin":"qǔ fǎ hū shàng","abbr":"qfhs","explanation":"取法：取为法则。比喻效仿于高超、精湛的学识、技艺等。","source":{"text":"汝当更求古之哲王以为师，如吾，不足法也。夫取法于上，仅得其中；取法于中，不免为下。","book":"唐·李世民《帝范》"},"example":{"text":"诗宗韩、杜、苏三家，自是～之意。","book":"清·袁枚《小仓山房尺牍》卷一百二十九"},"similar":["取法于上，仅得乎中"],"usage":"作宾语、定语；用于处事"},{"id":10573,"word":"取法乎上，仅得乎中","pinyin":"qǔ fǎ hū shàng，jìn dé hū zhōng","abbr":"qfhsjdhz","explanation":"取上等的为准则，也只能得到中等的。指做事要高标准严要求。","source":{"text":"取法于上，仅得为中，取法于中，故为其下。","book":"语出唐太宗《帝范》卷四"},"example":{"text":"清·李渔《凰求凤·筹婚》：“古语说得好，～，要选第一等的才郎，到其间只好得个中平之婿。”"},"similar":["取法于上，仅得乎中"],"usage":"作宾语、定语；用于处事"},{"id":10574,"word":"取法于上，仅得乎中","pinyin":"qǔ fǎ yú shàng，jìn dé hū zhōng","abbr":"qfysjdhz","explanation":"法：标准，规范。取上等的为标准，也只能得到中等的。指做事要高标准严要求。","source":{"text":"取法于上，仅得乎中，取法于中，故为其下。","book":"唐·唐太宗《帝范》第四卷"},"example":{"text":"语曰：～，择其中而取法之，是岂智者所为耶？","book":"孙中山《中国民主革命之重要》"},"similar":["取法乎上，仅得乎中"],"usage":"作宾语、定语；用于处事"},{"id":10575,"word":"取法于上，仅得其中","pinyin":"qǔ fǎ yú shàng，jǐn dé qí zhōng","abbr":"qfysjdqz","explanation":"取法：取为法则。比喻效仿于高超、精湛的学识、技艺等，也只能达到中等水平。","source":{"text":"汝当更求古之哲王以为师，如吾，不足法也。夫取法于上，仅得其中；取法于中，不免为下。","book":"唐·李世民《帝范》"}},{"id":10576,"word":"取瑟而歌","pinyin":"qǔ sè ér gē","abbr":"qseg","explanation":"瑟：弦乐器。弹瑟歌唱。比喻用曲折的方式表达情意。","source":{"text":"孺悲欲见孔子，孔子辞以疾，将命者出户，取瑟而歌，使之闻之。","book":"春秋·鲁·孔丘《论语·阳货》"},"example":{"text":"这两句话岂仅～，简直就是俗话说的‘杀鸡骇猴’。","book":"高阳《母子君臣》"},"usage":"作谓语、定语；用于处事"},{"id":10577,"word":"取精用宏","pinyin":"qǔ jīng yòng hóng","abbr":"qjyh","explanation":"用：享受。从大量材料中选取精华充分加以运用。","source":{"text":"蕞尔国，而三世执其政柄，其用物也弘矣，其取精也多矣。","book":"先秦·左丘明《左传·昭公七年》"},"example":{"text":"读书多的，～，自然深了，读书少的便不能如此。","book":"朱自清《文选序》"},"similar":["去粗取精"],"opposite":["鱼龙混杂"],"usage":"作谓语、定语；指运用精华"},{"id":10578,"word":"取精用弘","pinyin":"qǔ jīng yòng hóng","abbr":"qjyh","explanation":"精：精华；用：享受，占有；弘：大。从丰富的材料里提取精华。","source":{"text":"蕞尔国，而三世执其政柄，其用物也弘矣，其取精也多矣。","book":"《左传·昭公七年》"},"example":{"text":"尤必印证于良师益友，庶收～之益。","book":"清·况周颐《惠风词话》卷一"},"similar":["取精用宏"],"usage":"作谓语、定语；指提炼"},{"id":10579,"word":"取而代之","pinyin":"qǔ é dài zhī","abbr":"qedz","explanation":"指夺取别人的地位而由自己代替。现也指以某一事物代替另一事物。","source":{"text":"秦始皇游会稽，渡浙江，梁与籍俱观，籍曰：‘彼可取而代也。’","book":"《史记·项羽本纪》"},"example":{"text":"清帝方今玩于彼股掌之上，及其时则～耳。","book":"蔡东藩、许廑父《民国通俗演义》第八十六回"},"similar":["改朝换代"],"opposite":["一如既往"],"usage":"作谓语、宾语；用于人或事物","story":["楚国末年名将项燕的孙子项羽从小死了父亲，跟着叔叔项梁学习剑术，项羽却豪言壮语地说要学习对付千军万马的本领，项梁就教他兵法。项梁杀了人，他们逃到吴中，秦始皇东游会稽山路过吴中，项羽远远观望并对项梁说“彼可取而代也”"]},{"id":10580,"word":"取舍两难","pinyin":"qǔ shě liǎng nán","abbr":"qsln","explanation":"采用或舍弃都能决定。指难以抉择。","example":{"text":"这事让我～。"},"opposite":["取舍得当"],"usage":"作谓语、定语；指难以抉择"},{"id":10581,"word":"取譬引喻","pinyin":"qǔ pì yǐn yù","abbr":"qpyy","explanation":"打比方，作譬喻，用以说明道理。"},{"id":10582,"word":"取诸宫中","pinyin":"qǔ zhū gōng zhōng","abbr":"qzgz","explanation":"宫，古代对房屋的通称。后指取用于自己家中，极言其便利。","source":{"text":"且许子何不为陶冶，舍皆取诸其宫中而用之？","book":"《孟子·滕文公上》"},"example":{"text":"明·冯梦龙《醒世恒言》第三卷：“偏生九阿姐造化，讨得着，年时赚了若干钱钞，临出门还有这一主大财，又是～，不劳余力。”"},"usage":"作谓语、定语；用于书面语"},{"id":10583,"word":"取辖投井","pinyin":"qǔ xiá tóu jǐng","abbr":"qxtj","explanation":"比喻挽留客人极坚决。","source":{"text":"遵嗜酒，每大饮，宾客满堂，辄关门，取客车辖投井中。虽有急，终不得去。","book":"东汉·班固《汉书·陈遵传》"},"example":{"text":"你不要～，我还有重要事情要办。"},"similar":["闭门投辖"],"usage":"作谓语、宾语；指热情待客","story":["西汉末年京兆尹陈遵性格豪爽，很有才气，而且非常好客，各地官员和四方豪杰都仰慕他的大名，经常去拜访他。陈遵大摆宴席，陪客人喝酒，为了留住客人，他命令仆人把客人马车上的辖拆下投到井里，客人只好留下来陪他喝酒"]},{"id":10584,"word":"取长弃短","pinyin":"qǔ cháng qì duǎn","abbr":"qcqd","explanation":"吸取长处抛弃短处。","source":{"text":"并前人已传之业，亦为取长弃短，别出瑕瑜，使人知所从违。","book":"清·李渔《闲情偶寄·结构》"},"example":{"text":"当然没有现代的见解，～，只要那‘斗志’能鼓动青年战士的心，就足够了。","book":"鲁迅《集外集·编校后记》"},"usage":"作宾语、定语；用于选择"},{"id":10585,"word":"取长补短","pinyin":"qǔ cháng bǔ duǎn","abbr":"qcbd","explanation":"吸取别人的长处，来弥补自己的不足之处。也泛指在同类事物中吸取这个的长处来弥补那个的短处。","source":{"text":"今滕绝长补短，将五十里也，犹可以为善国。","book":"《孟子·滕文公上》"},"example":{"text":"外来干部和本地干部各有长处，也各有短处，必须互相～，才能有进步。","book":"毛泽东《整顿党的作风》"},"similar":["扬长避短"],"opposite":["故步自封"],"usage":"作谓语、定语；指弥补自己的不足","story":["战国时期，滕文公从楚国路经宋国时会见孟子，孟子给他讲一些人性本是善良的道理，勉励他要以尧舜之道治理天下，还要他截长补短，发挥地区优势，以仁政来治理天下，滕国可以成为一个强国。滕文公听了孟子的言论未置可否，只是微笑应付"]},{"id":10586,"word":"取青妃白","pinyin":"qǔ qīng fēi bái","abbr":"qqfb","explanation":"取青媲白。同“取青媲白”。","source":{"text":"世之模拟窜窃，取青媲白，肥皮厚肉，柔筋脆骨，而以为辞者之读之也，其大笑固宜。","book":"唐·柳宗元《读韩愈所著毛颖传后题》"},"example":{"text":"况百家小道，～之区区者乎？","book":"清·王夫之《读通鉴论·梁元帝》"},"similar":["取青媲白"],"usage":"作谓语、宾语；用于诗文等"},{"id":10587,"word":"取青媲白","pinyin":"qǔ qīng pì bái","abbr":"qqpb","explanation":"以青配白。比喻斟酌字句以使文句对偶工整。","source":{"text":"世之模拟窜窃，取青媲白，肥皮厚肉，柔筋脆骨，而以为辞者之读之也，其大笑固宜。","book":"唐·柳宗元《读韩愈所著毛颖传后题》"},"example":{"text":"而今之剽窃补缀，肥皮厚肉，～，而白诩为工者，辄取薄熙甫为不足学，又远美之徒所窃笑者已。","book":"清·张士元《震川文抄》"},"similar":["取青妃白"],"usage":"作谓语、宾语；用于诗文等"},{"id":10588,"word":"受之无愧","pinyin":"shòu zhī wú kuì","abbr":"szwk","explanation":"受：接受，得到。得到某种奖励或荣誉没有什么可惭愧的。","source":{"text":"这笔钱是老朋友的赠款，不是民国的官俸，所以这位相国也就受之无愧。","book":"陶菊隐《袁世凯演义》第26回"},"example":{"text":"你接受这个荣誉可以说～。"},"similar":["当之无愧","心安理得"],"opposite":["受之有愧"],"usage":"作谓语、定语；用于奖励与荣誉等"},{"id":10589,"word":"受之有愧","pinyin":"shòu zhī yǒu kuì","abbr":"szyk","explanation":"指接受某种馈赠和奖赏心里感到惭愧。多用作自谦之辞。","source":{"text":"官人傥然要说俺侄儿媳 妇，自恁来闲讲罢了，何必费烦又买礼来，使老身却之不恭，受之有愧。","book":"明·兰陵笑笑生《金瓶梅词话》第七回"},"example":{"text":"他弟兄四人既不敢说不要，也不能说～，更绝对的不能说多少。","book":"张恨水《金粉世家》第八十三回"},"opposite":["受之无愧"],"usage":"作谓语、定语；用于自谦"},{"id":10590,"word":"受制于人","pinyin":"shòu zhì yù rén","abbr":"szyr","explanation":"制：控制。被别人控制。","source":{"text":"吾不能举全吴之地，十万之众，受制于人。","book":"《三国志·蜀志·诸葛亮传》"},"example":{"text":"～，威名顿尽。","book":"《梁书·侯景传》"},"similar":["任人宰割"],"usage":"作谓语、定语；指被动局面"},{"id":10591,"word":"受命于危难之间","pinyin":"shòu mìng yú wēi nàn zhī jiān","abbr":"smywnzj","explanation":"在危急困难的时刻接受任命，担当重任。","source":{"text":"受任于败军之际，奉命于危难之间。","book":"三国·蜀·诸葛亮《出师表》"}},{"id":10592,"word":"受命于天","pinyin":"shòu mìng yú tiān","abbr":"smyt","explanation":"古代统治阶级为巩固统治地位，宣扬“君权神受”论，说他们作帝王是顺从天意，接受天命。","source":{"text":"大受命于天，下受命于君，是大受命也。","book":"《庄子·内篇》：“受命于地，唯松柏独也正，在冬夏青青；受命于天，唯尧、舜独也正，在万物之首。”《谷梁传·庄公元年》：“臣子大受。”疏"},"example":{"text":"修此三者，而大本举矣，人～，固超然异于群生。","book":"蔡东藩《前汉演义》第五十八回"}},{"id":10593,"word":"受天之祜","pinyin":"shòu tiān zhī hù","abbr":"stzh","explanation":"蒙受老天的保祐。","source":{"text":"昭兹来许，绳其祖武，于万斯年，受天之祜。","book":"《诗经·大雅·下武》"},"example":{"text":"陟降孔时，粲然有文。～，多稼如云。","book":"《宋史·乐志九十》"}},{"id":10594,"word":"受夹板气","pinyin":"shòu jiā bǎn qì","abbr":"sjbq","explanation":"夹在中间受气，两头不讨好。","example":{"text":"我不想在此～。"},"similar":["受夹板罪"],"usage":"作谓语、宾语；指两头不讨好"},{"id":10595,"word":"受夹板罪","pinyin":"shòu jiā bǎn zuì","abbr":"sjbz","explanation":"夹在中间受罪，两头不讨好。","example":{"text":"她夹在他们之间～。"},"similar":["受夹板气"],"usage":"作谓语、定语；指两头不讨好"},{"id":10596,"word":"受宠若惊","pinyin":"shòu chǒng ruò jīng","abbr":"scrj","explanation":"宠：宠爱。因为得到宠爱或赏识而又高兴，又不安。","source":{"text":"受宠若惊，况被非常之命，事君无隐，敢倾至恳之诚。","book":"《老子》第十三章：“宠辱若惊……得之若惊，失之若惊，是谓宠辱若惊。”宋·欧阳修《辞特转吏部侍郎表》"},"example":{"text":"～，居亢无悔。","book":"《宋史·张洎传》"},"similar":["大喜过望"],"opposite":["麻木不仁"],"usage":"作谓语、定语、状语；指人惊讶","story":["唐太宗时期，官吏卢承庆奉命调查漕运船只失事的责任问题，先后三次给漕运官更改考评政绩“中下、中中、中上”，该官吏表现出宠辱不惊。后来卢本人也大起大落，命运坎坷，他的心情始终平静如水，并不因起落无常而受宠若惊"]},{"id":10597,"word":"受怕担惊","pinyin":"shòu pà dān jīng","abbr":"spdj","explanation":"形容十分担心或害怕。","source":{"text":"他是个娇滴滴美玉无瑕，粉脸生春，云鬓堆鸦。恁的般受怕担惊，又不图甚浪酒闲茶。","book":"元·王实甫《西厢记》第三本第三折"},"example":{"text":"她自来到这里以后，心情也突然变得轻松起来，无须再像在内地那样，时时～，处处都得提防戒备。","book":"聂云岚《玉娇龙》第三十六回"},"similar":["担惊受怕"],"usage":"作谓语、定语、状语；形容担心害怕"},{"id":10598,"word":"受益匪浅","pinyin":"shòu yì fěi qiǎn","abbr":"syfq","explanation":"匪：通“非”。得到的好处很多。","source":{"text":"这类‘讲座’还售门票，并兼售演讲本人的著作，使得这类活动让各方面都受益匪浅。","book":"路遥《平凡的世界》第五卷第25章"},"similar":["受益非浅"],"usage":"作谓语、定语；用于自谦"},{"id":10599,"word":"受益无穷","pinyin":"shòu yì wú qióng","abbr":"sywq","explanation":"形容受益很多，不可限量。","similar":["受益匪浅"]},{"id":10600,"word":"受赇枉法","pinyin":"shòu qiú wǎng fǎ","abbr":"sqwf","explanation":"受赇：接受贿赂；枉：歪曲，破坏。贪污受贿，违犯法纪。","source":{"text":"及杀人先自告，及吏坐受赇枉法，守县官财物而即盗之，已论命复有笞罪者，皆弃市。","book":"先秦歌谣《优孟歌》：“又恐受赇枉法为奸触大罪，身死而家灭，贪吏安可为也。”《汉书·刑法志》"},"example":{"text":"庆则因赂蔡京得金吾卫副千户，乃愈肆，求药纵欲～无不为。","book":"鲁迅《中国小说史略》第十九篇"}},{"id":10601,"word":"变俗易教","pinyin":"biàn sú yì jiào","abbr":"bsyj","explanation":"改变原有的习俗和教化。","source":{"text":"变俗易教，不知化不可。","book":"《管子七法》"},"similar":["变容改俗"],"usage":"作谓语、定语；指改变原来的习惯"},{"id":10602,"word":"变动不居","pinyin":"biàn dòng bù jū","abbr":"bdbj","explanation":"指事物不断变化，没有固定的形态。","source":{"text":"言阴阳六爻更互变动，不恒居一体也。","book":"《易系辞下》：“《易》之为书也不可远；为道也，屡迁，变动不居，周流六虚。”孔颖达疏"},"example":{"text":"发现和掌握规律，就是从个别中找到了一般，从～的现象中找到了相对稳定的本质。","book":"艾思奇《辩证唯物主义历史唯物主义》"},"similar":["变化无常"],"usage":"作谓语、定语；指事物不断变化"},{"id":10603,"word":"变化万端","pinyin":"biàn huà wàn duān","abbr":"bhwd","explanation":"端：头绪。形容变化之多。","source":{"text":"于天柱山得石室内《九丹金液经》，能变化万端，不可胜纪。","book":"宋·张君房《云笈七签》卷八十五"},"example":{"text":"这七八年来，真是～，单就北新而论，就已被封过两回门。","book":"鲁迅《书信集·致程琪英》"},"similar":["变化多端"],"opposite":["一成不变"],"usage":"作谓语、定语；形容变化的样子极多"},{"id":10604,"word":"变化不测","pinyin":"biàn huà bù cè","abbr":"bhbc","explanation":"变化无常，无法捉摸。","source":{"text":"当是时，见王于北亭，犹高山区深巨谷，龙虎变化不测。","book":"唐·韩愈《殿中少监马君墓志》"},"example":{"text":"律诗对偶，固须铢两悉称，然必看了上句，使人想不出下句，方见～。","book":"清·王应奎《柳南随笔》卷二"},"similar":["变化莫测","变化无常"],"opposite":["一成不变"],"usage":"作谓语、宾语、定语；形容变化多而不定"},{"id":10605,"word":"变化不穷","pinyin":"biàn huà bù qióng","abbr":"bhbq","explanation":"指变化多种多样，没有穷尽。","source":{"text":"编中所述鬼狐最夥，层见叠出，变化不穷。","book":"清·赵起杲《青本刻例言》"},"similar":["变化无穷"],"opposite":["一成不变"],"usage":"作谓语、定语；用于各种事物"},{"id":10606,"word":"变化多端","pinyin":"biàn huà duō duān","abbr":"bhdd","explanation":"端：头绪。形容变化极多。也指变化很大。","source":{"text":"这齐天大圣神通广大，变化多端。","book":"明·冯梦龙《古今小说·陈从善梅岭失浑家》"},"example":{"text":"明·冯梦龙《古今小说·陈从善梅岭失浑家》：“这齐天大圣神通广大，变化多端。”"},"similar":["再接再厉","变化莫测"],"opposite":["一成不变","强弩之末","一如既往"],"usage":"作谓语、定语；形容变化的样子极多"},{"id":10607,"word":"变化如神","pinyin":"biàn huà rú shén","abbr":"bhrs","explanation":"神：神奇。形容变化迅速而神奇。","source":{"text":"太祖自统御海内，芟夷群丑，其行军用师，大较依孙、吴之法，而因事设奇，变化如神。","book":"《三国志·魏志·武帝纪》裴松之注引《魏书》"},"example":{"text":"出奇制胜，～。","book":"宋·陈亮《酌古论二·邓禹》"},"similar":["变化无常"],"opposite":["一成不变"],"usage":"作谓语、定语；指变化快"},{"id":10608,"word":"变化无常","pinyin":"biàn huà wú cháng","abbr":"bhwc","explanation":"无常：没有常态。指事物经常变化，没有规律性。","source":{"text":"忽漠无形，变化无常。","book":"《庄子·天下》"},"example":{"text":"近来天气～，一会儿晴空万里，一会儿又大雨倾盆。"},"similar":["变化多端","变化莫测","变幻莫测"],"opposite":["一成不变","原封不动","依然如故"],"usage":"作谓语、定语；用于各种事物或人的情绪"},{"id":10609,"word":"变化无方","pinyin":"biàn huà wú fāng","abbr":"bhwf","explanation":"方：方向。善于变化而没有固定的方向和程式。形容变化灵活，捉摸不定。","source":{"text":"曹公善用兵，变化无方，众虽小，未可轻也，不如以久持之。","book":"《三国志·魏志·袁绍传》"},"example":{"text":"《三国志·魏志·袁绍传》：“曹公善用兵，变化无方，众虽小，未可轻也，不如以久持之。”"},"similar":["变化无常","变幻莫测"],"opposite":["一成不变"],"usage":"作谓语、定语；用于各种事物或人的情绪","story":["东汉末期，袁绍和曹操从小是十分要好的朋友，世事变化无方，为了争夺天下，两人成为不共戴天的仇人。董卓要废汉自立，袁绍起兵反对，曹操成为袁绍手下的奋武将军。董卓死后，曹操的力量日益强大，以许昌为大本营与刘备、袁绍等对立"]},{"id":10610,"word":"变化无穷","pinyin":"biàn huà wú qióng","abbr":"bhwq","explanation":"穷：尽，终结。形容不断变化，没有止境。","source":{"text":"须臾之间，变化无穷。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"如今三公子神通广大，～。","book":"明·无名氏《杨家将演义》第五十七回"},"similar":["变化莫测","变化多端"],"opposite":["一成不变","原封不动"],"usage":"作谓语、定语；用于各种事物"},{"id":10611,"word":"变化有时","pinyin":"biàn huà yǒu shí","abbr":"bhys","explanation":"时：定时，一定的时期。随时间发展而发生变化。","source":{"text":"去就有序，变化有时。","book":"《史记·秦始皇本纪》"}},{"id":10612,"word":"变化莫测","pinyin":"biàn huà mò cè","abbr":"bhmc","explanation":"测：估测。变化很多，不能预料。","source":{"text":"当是时，见王于北亭，犹高山深林巨谷龙虎，变化不测，杰魁人也。","book":"唐·韩愈《殿中少监马君墓志》"},"example":{"text":"七十二座天门阵～，昼则凄风冷雨，夜则鬼哭神号。","book":"明·无名氏《杨家将演义》第二十五回"},"similar":["变化无常","变化不测"],"opposite":["一成不变"],"usage":"作谓语、宾语；形容变化多而不定"},{"id":10613,"word":"变危为安","pinyin":"biàn wēi wéi ān","abbr":"bwwa","explanation":"变危急为平安。","source":{"text":"陛下当此之时变危为安，变乱为治，易于返掌。","book":"宋·司马光《论周琰事乞不坐冯浩状》"},"example":{"text":"他的出现，形势马上就～。"},"similar":["转危为安","化险为夷"],"opposite":["得而复失"],"usage":"作谓语、定语；用于局势等"},{"id":10614,"word":"变古乱常","pinyin":"biàn gǔ làun cháng","abbr":"bglc","explanation":"更改或打乱祖宗常法。","source":{"text":"晁错为家令时，数言事不用；后擅权，多所变更。诸侯发难，不急匡救，欲报私仇，反以亡躯。语曰：‘变古乱常，不死则亡’，岂错等谓邪！","book":"《史记·袁盎晁错列传论》"},"similar":["变古易常"],"usage":"作谓语、定语；指改变原有的准则"},{"id":10615,"word":"变古易俗","pinyin":"biàn gǔ yì sú","abbr":"bgys","explanation":"改变传统的法制和习俗。","source":{"text":"变古易俗兮世衰，今之相者兮举肥。","book":"《楚辞·九辩》"},"similar":["移风易俗"],"usage":"作谓语、定语；指改变习惯"},{"id":10616,"word":"变古易常","pinyin":"biàn gǔ yì cháng","abbr":"bgyc","explanation":"改变传统的法制和准则。","source":{"text":"不知治者，必曰：‘无变古，毋易常。’","book":"语出《韩非子·南面》"},"example":{"text":"《春秋》之法，上～，应是而有天灾者，谓幸国。","book":"汉·董仲舒《春秋繁露·必仁且知》"},"similar":["移风易俗"],"usage":"作谓语、定语；指改变原有的准则"},{"id":10617,"word":"变名易姓","pinyin":"biàn míng yì xìng","abbr":"bmyx","explanation":"改换了原来的姓名。","source":{"text":"乃乘扁舟浮于江湖，变名易姓。","book":"《史记·货殖列传》"},"example":{"text":"日三食，慎勿忘，但过万日，仍自纵横，～，升天游兵皆可耳。","book":"宋·张君房《云笈七签》卷八十二"},"similar":["改名换姓"],"usage":"作谓语、宾语、定语；指人改变名字","story":["春秋末期，楚国的范蠡和文种到越国去做官，辅佐被吴王夫差打败的勾践，他们发奋图强，终于使越国强大后灭了吴国。范蠡深知勾践的为人就到齐国变名易姓去经商，他劝文种离开说：“狡兔死，走狗烹”。文种不信后被勾践所杀"]},{"id":10618,"word":"变姓埋名","pinyin":"biàn xìng mái míng","abbr":"bxmm","explanation":"隐瞒自己的真实姓名，不让别人知道。","source":{"text":"即将所有金银犒赏三军，涕泣起行，退居濮州雷夏泽中，变姓埋名，农樵为乐。","book":"清·褚人获《隋唐演义》第39回"},"similar":["隐姓埋名","改名换姓"],"usage":"作谓语、定语、状语；用于处事"},{"id":10619,"word":"变容改俗","pinyin":"biàn róng gǎi sú","abbr":"brgs","explanation":"指改变风貌习俗。","source":{"text":"教变容改俗而莫得其所受之，此之谓顺情。","book":"《吕氏春秋·上德》"},"usage":"作谓语、宾语；指改变习惯"},{"id":10620,"word":"变幻不测","pinyin":"biàn huà bù cè","abbr":"bhbc","explanation":"指变化无常，无法预测。","source":{"text":"因是终日会睡，变幻不测如龙，所以人叫他懒龙。","book":"《二刻折案惊奇》卷三九"},"example":{"text":"清·李汝珍《镜花缘》第一回：“且神道～，亦难详其底细。”"},"similar":["变幻莫测"],"usage":"作谓语、定语；用于气候、政治风云、命运等"},{"id":10621,"word":"变幻无常","pinyin":"biàn huàn wú cháng","abbr":"bhwc","explanation":"指事物经常变化，没有规律性。","source":{"text":"忽漠无形，变化无常。","book":"《庄子·天下》"},"example":{"text":"唐古拉山天气～，往往大晴天里忽然刮起了风雪。"},"similar":["白云苍狗","变化多端","云谲波诡"],"opposite":["一成不变","依然如故","原封不动"],"usage":"作谓语、定语；用于人或事物的变化"},{"id":10622,"word":"变幻无穷","pinyin":"biàn huàn wú qióng","abbr":"bhwq","explanation":"变化多种多样，没有穷尽。极言变化之多。","source":{"text":"鲁迅《书信集·致杨霁云》；“但是‘作家’之变幻无穷，一面固觉得是文坛之不幸，一面也使真相更分明。”"},"example":{"text":"它给大海涂上万种色彩，而且～。","book":"郭小川《致大海》诗"},"similar":["千变万化","变幻无常"],"opposite":["一成不变"],"usage":"作谓语、定语、宾语；形容变化多"},{"id":10623,"word":"变幻莫测","pinyin":"biàn huàn mò cè","abbr":"bhmc","explanation":"变幻：变化不可测度。变化很多，不能预料。","source":{"text":"当是时，见王于北亭，犹高山深林巨谷龙虎，变化不测，杰魁人也。","book":"唐·韩愈《殿中少监马君墓志》"},"example":{"text":"吾“红水阵”内夺壬癸之精，藏天乙之妙，～。","book":"明·许仲琳《封神演义》第四十四回"},"similar":["变化多端","瞬息万变","千变万化"],"opposite":["依然如故","一成不变"],"usage":"作谓语、定语；用于气候、政治风云、命运等"},{"id":10624,"word":"变徵之声","pinyin":"biàn zhǐ zhī shēng","abbr":"bzzs","explanation":"徵：古代五声之一。乐声中徵调变化，常作悲壮之声。","source":{"text":"高渐离击筑，荆柯和而歌，为变徵之声，士皆垂泪涕泣。","book":"《史记·刺客列传》"},"usage":"作宾语；指悲凉的声音","story":["战国末期，燕太子丹从秦国逃回，请义士荆轲与高渐离出面去刺杀秦王嬴政。一切准备就绪，太子丹率手下着白装送他们到易水边，高渐离击筑，荆轲高唱：“风萧萧兮易水寒，壮士一去兮不复还！”唱变徵之声，慷慨激昂，一行人洒泪告别"]},{"id":10625,"word":"变心易虑","pinyin":"biàn xīn yì lǜ","abbr":"bxyl","explanation":"改变思想；改变打算。","source":{"text":"四海之内，莫不变心易虑以化顺之。","book":"《荀子·儒效》"},"example":{"text":"[寡人]以为一从不事秦，非国之长利也。乃且愿～，割地谢前过以事秦。","book":"《史记·张仪列传》"},"usage":"作谓语、宾语；指改变主意"},{"id":10626,"word":"变态百出","pinyin":"biàn tài běi chū","abbr":"btbc","explanation":"形容事物形态变化之多。","source":{"text":"历代盛衰，文章与时高下。然其变态百出，不可穷极，何其多也。","book":"《新唐书·艺文志一》"},"example":{"text":"又往往登临楼阁，壮丽闳伟；云霞草木，～，类非人间所有。","book":"清·戴名世《记梦》"},"similar":["变幻无常"],"opposite":["一成不变"],"usage":"作宾语、定语；指变化多"},{"id":10627,"word":"变故易常","pinyin":"biàn gǔ yì cháng","abbr":"bgyc","explanation":"改变传统的法制和准则。","source":{"text":"好变故易常者亡，昔阳氏之君，自伐而好变，事无故业，官无定位，民运于下，阳氏以亡。","book":"《逸周书·史记》"},"example":{"text":"～，乃为政之大忌；严刑酷罚，非致治之弘规。","book":"《周书·颜之仪传》"},"similar":["变古易常"],"usage":"作谓语、定语；指改变原有的准则"},{"id":10628,"word":"变服诡行","pinyin":"biàn fú guǐ xíng","abbr":"bfgx","explanation":"变：更换；服：服装；诡：诡秘。更换服装，秘密赶路。","source":{"text":"变服诡行，日倍百里。","book":"唐·韩愈《清边郡王杨燕奇碑文》"},"opposite":["衣锦昼行"],"usage":"作谓语；指秘密赶路"},{"id":10629,"word":"变本加厉","pinyin":"biàn běn jiā lì","abbr":"bbjl","explanation":"厉：猛烈。指比原来更加发展。现指情况变得比本来更加严重。","source":{"text":"盖踵其事而增华，变其本而加厉，物既有之，文亦宜然。","book":"南朝·梁·萧统《文选·序》"},"example":{"text":"断句取义是在一句两句里拉出一个两个字来发挥，比起断章取义，真是～了。","book":"朱自清《经典常谈·诗经第四》"},"similar":["肆无忌惮","有加无己"],"opposite":["微不足道","大题小作"],"usage":"作谓语、定语、状语；用于坏行为等","story":["南朝梁武帝萧衍的长子萧统编撰我国最早的文学总集《文选》，收录从周代到六朝的文学作品，成为当时知识分子必修课本。他认为文学作品是社会生活的反映与升华，犹如冰是水凝成，但它又变本加厉，比水冷得多一样"]},{"id":10630,"word":"变炫无穷","pinyin":"biàn xuán wú qióng","abbr":"bxwq","explanation":"变化多种多样，没有穷尽。极言变化之多。","source":{"text":"自元嘉以降，内职稍繁，椒庭绮观，千门万户，而淫妆怪饰，变炫无穷。","book":"《宋书·后妃传论》"},"similar":["变幻无穷"],"opposite":["一成不变"],"usage":"作谓语、定语；指变化不定"},{"id":10631,"word":"变生不测","pinyin":"biàn shēng bù cè","abbr":"bsbc","explanation":"变：有重大影响的突然变化；不测：意外。变故发生于突然之间。","source":{"text":"变生不测凤姐泼醋，喜出望外平儿理妆。","book":"清·曹雪芹《红楼梦》第四十四回"},"example":{"text":"江西省议会及总商会，恐～屡电到鄂，请黎莅任。","book":"蔡东藩、许廑父《民国通俗演义》第二十六回"},"similar":["飞来横祸"],"usage":"作宾语；指意外发生变故"},{"id":10632,"word":"变生意外","pinyin":"biàn shēng yì wài","abbr":"bsyw","explanation":"变：变化。指意外发生变故。","source":{"text":"时甫罹大变，众心未一，事机少忽，变生意外。","book":"元·苏天爵《元朝名臣事略·枢密赵文正公》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第89回：“本是这样，原是一件照例之事。却不料～！”"},"similar":["变生不测"],"usage":"作宾语；指意外发生变故"},{"id":10633,"word":"变生肘腋","pinyin":"biàn shēng zhǒu yè","abbr":"bszy","explanation":"肘腋：胳肢窝。比喻事变就发生在身边。","source":{"text":"主公之在公安也，北畏曹公之强，东惮孙权之逼，近则惧孙夫人生变于肘腋之下，当斯之时，进退狼跋。","book":"《三国志·蜀志·法正传》"},"example":{"text":"万一中外合谋，～，郑国非公之有矣。","book":"明·冯梦龙《东周列国志》第四回"},"similar":["心腹之患","祸生肘腋"],"usage":"作谓语、状语；形容内乱","story":["东汉末年，曹操出兵攻打汉中张鲁，益州牧刘璋听从张松的说辞，派法正去荆州请刘备入蜀。法正向刘备献计献策，刘备在刘璋死后取益州建立蜀国，任命法正为蜀郡太守。法正大报个人恩怨。诸葛亮说刘备担心变生肘腋，报恩才任命法正"]},{"id":10634,"word":"变脸变色","pinyin":"biàn liǎn biàn sè","abbr":"blbs","explanation":"因内心惊、惧、急、怒而改变面色。","source":{"text":"那知李尚尚一听，就变脸变色地发起脾气来。","book":"《小说选刊》1981年第9期"},"similar":["变颜变色"],"opposite":["面不改色"],"usage":"作宾语、定语、状语；用于心情紧张的场合"},{"id":10635,"word":"变色之言","pinyin":"biàn sè zhī yán","abbr":"bszy","explanation":"使脸色改变的话。多指为争论是非曲直而冲动发怒时说的话。","source":{"text":"朝有变色之言，则下有争斗之患。","book":"《汉书·匡衡传》"},"usage":"作宾语；指气话"},{"id":10636,"word":"变色易容","pinyin":"biàn sè yì róng","abbr":"bsyr","explanation":"变、易：改变。色、容：脸色、表情。形容惊惶失措的神情。","source":{"text":"是日见范睢，见者无不变色易容。","book":"《战国策·秦策·范睢说秦王》"},"similar":["变脸变色"],"usage":"作宾语、定语、状语；用于神情"},{"id":10637,"word":"变贪厉薄","pinyin":"biǎn tān lì bó","abbr":"btlb","explanation":"指改变、劝勉贪图财利、行为轻薄的人使之廉洁忠厚。","source":{"text":"此章言伯夷、柳下惠变贪厉薄，千载闻之，犹有感激。","book":"《孟子·尽心下》：“圣人百世之师也，伯夷、柳下惠是也。”宋·孙奭疏"},"usage":"作谓语、宾语；指改变别人"},{"id":10638,"word":"变起萧墙","pinyin":"biàn qǐ xiāo qiáng","abbr":"bqxq","explanation":"萧墙：古代宫室内当门的小墙，比喻内部。指祸变发生在内部。","source":{"text":"乃者王室之难，变起萧墙，赖公之灵，弘济艰险。","book":"《晋书·文帝纪》"},"example":{"text":"他书后明说着：衅生他族，～。","book":"明·汤显祖《南柯记·疑惧》"},"similar":["祸起萧墙"],"usage":"作谓语、宾语、定语；指内乱"},{"id":10639,"word":"变躬迁席","pinyin":"biàn gōng qiān xí","abbr":"bgqx","explanation":"移动身体，离开席位。表示谦恭。","source":{"text":"桓公变躬迁席，拱手而曰：‘敢问何谓其体？’","book":"《管子·霸形》"},"opposite":["骄横跋扈"],"usage":"作谓语；指人很谦恭"},{"id":10640,"word":"变迹埋名","pinyin":"biàn jì mái míng","abbr":"bjmm","explanation":"改变行踪，隐匿姓名，使人不知。","source":{"text":"虽已变迹埋名，还要弃家访道。","book":"明·梅鼎祚《玉合记·诇约》"},"similar":["匿迹藏行","隐姓埋名"],"usage":"作谓语、定语；指隐居"},{"id":10641,"word":"变醨养瘠","pinyin":"biàn lí yǎng jí","abbr":"blyj","explanation":"使薄酒变醇，瘠土变得肥沃。比喻改变贫穷落后面貌。","source":{"text":"公所到处，便能变醨养瘠，元气昭回：古今人若合一辙。","book":"清·袁枚《随园诗话》卷十一"},"usage":"作谓语、定语；指改变面貌"},{"id":10642,"word":"变颜变色","pinyin":"biàn yán biàn sè","abbr":"bybs","explanation":"因内心惊、惧、急、怒而改变面色。","source":{"text":"阔大爷注意到两个老头变颜变色的有点为难的样子，便惊讶地竖起眉毛。","book":"管桦《不讲理的人》"},"example":{"text":"别理她，小心她会～的。"},"similar":["变脸变色"],"opposite":["面不改色"],"usage":"作宾语、定语；用于心情紧张的场合"},{"id":10643,"word":"变风改俗","pinyin":"biàn fēng yì sú","abbr":"bfgs","explanation":"指改变旧的风气和习俗。","source":{"text":"故凡欲变风改俗者，其行赏罚者也，必使足惊心破胆，民乃易视。","book":"汉·王符《潜力夫·论三式》"},"similar":["变风易俗"],"usage":"作谓语、定语；指移风易俗"},{"id":10644,"word":"变风易俗","pinyin":"biàn fēng yì sú","abbr":"bfys","explanation":"指改变旧的风气和习俗。","source":{"text":"向使秦缓其刑罚，薄赋倒敛……变风易俗，化于海内，则世世必安矣。","book":"《史记·平津侯主父列传》"},"example":{"text":"浩曰：“太祖用漠北淳朴之人，南人汉地，～，化洽四海，自与羲、农、舜、禹齐烈，臣岂能仰名？”","book":"《北史·崔浩传》"},"similar":["变风改俗"],"usage":"作谓语、定语；指移风易俗"},{"id":10645,"word":"叠岭层峦","pinyin":"dié lǐng céng luán","abbr":"dlcl","explanation":"叠：重叠；层：重复，接连出现。形容山峦重叠连绵不断。","source":{"text":"走的是些悬崖峭壁崎岖路，叠岭层峦险峻山。","book":"明·吴承恩《西游记》第15回"},"similar":["叠嶂层峦","层峦叠嶂"],"usage":"作宾语、谓语、状语；用于地势等"},{"id":10646,"word":"叠嶂层峦","pinyin":"dié zhàng céng luán","abbr":"dzcl","explanation":"嶂：形势高险像屏障的山。层：重。峦：就是连着的山。形容山峦重叠，连绵不断。","source":{"text":"叠嶂层峦，点点苍苔铺翡翠。","book":"明·冯梦龙《醒世恒言》卷二十九"},"similar":["层峦叠嶂","叠岭层峦"],"usage":"作宾语、谓语、状语；用于地势等"},{"id":10647,"word":"叠床架屋","pinyin":"dié chuáng jià wū","abbr":"dcjw","explanation":"床上搁床，屋上架屋。比喻重复、累赘。","source":{"text":"魏晋已来，所著诸子，理重事複，递相模学，犹屋下架屋，床上施床耳。","book":"北齐·颜之推《颜氏家训·序致》"},"example":{"text":"讲到成语，有些人的脑子里不是没有若干成语，但是用起来，～，拖泥带水。","book":"邹韬奋《经历·外国文和外国教师》"},"similar":["床上安床","屋上架屋"],"opposite":["删繁就简","简明扼要"],"usage":"作谓语、定语；指累赘","story":["南北朝时期，南齐的毛棱和父亲毛惠远、叔父毛惠秀都是有名的画家，他们的画各有优缺点，惠远作品挥洒自如，惠秀作品精工细致。毛棱的布局就不及父亲和叔父，下笔敏捷有余而奇巧不足，但构图布局则是床上安床、屋下架屋"]},{"id":10648,"word":"叠矩重规","pinyin":"dié jǔ chóng guī","abbr":"djcg","explanation":"规与规相重，矩矩与相迭，度数相同，完全符合。原比喻动静合乎法度或上下相合，后形容模仿、重复。","source":{"text":"君臣协美于朝，黎庶欣戴于野，动若重规，静若迭矩。","book":"《三国志·蜀书·郤正传》"},"example":{"text":"因先生之言，以读先生之书，如～，毫厘不失，灼然与才子之笔，分路而扬镳。","book":"清·纪昀《阅微草堂笔记·姑妄听之四》"},"similar":["重规叠矩"],"usage":"作主语、宾语；指烦琐的规矩"},{"id":10649,"word":"叠石为山","pinyin":"dié shí wéi shān","abbr":"dsws","explanation":"叠：重叠。把石头堆成山。指假山。","source":{"text":"宅后又构一园，大可二三顷，凿池引水，叠石为山，制度极其精巧。","book":"明·冯梦龙《醒世恒言》第29卷"},"usage":"作谓语、宾语；指假山"},{"id":10650,"word":"叠见层出","pinyin":"dié xiàn céng chū","abbr":"djcc","explanation":"叠：一次又一次。层：重复。指屡次出现。","source":{"text":"予读施愚山侍读五言诗，爱其温柔敦厚，一唱三叹，有风人之旨。其章法之妙，如天衣无缝……至于清词丽句，叠见层出。","book":"清·王士禛《池北偶谈·谈艺三·摘句图》"},"usage":"作谓语、定语、状语；用于重复"},{"id":10651,"word":"叠见杂出","pinyin":"dié xiàn zá chū","abbr":"djzc","explanation":"叠：重叠；见：同“现”，出现。多次重复错杂出现。","source":{"text":"今民穷财殚，府藏虚罄，水旱盗贼，星象草木之变叠见杂出。","book":"《明史·刘茞传》"},"usage":"作谓语、定语、状语；用于重复出现"},{"id":10652,"word":"口不二价","pinyin":"kǒu bù èr jià","abbr":"kbej","explanation":"指卖物者不说两种价钱。","source":{"text":"常采药名山，卖于长安市，口不二价，三十余年。","book":"南朝·宋·范晔《后汉书·逸民传·韩康》"},"example":{"text":"国营商业～的作风也该变革一下了。"},"similar":["说一不二"],"usage":"作谓语、宾语；用于买卖等","story":["汉朝时期，出身豪门的韩康不愿入仕当官，经常游名山采药到长安市场上去卖，三十年如一日坚持言不二价。有一次，一个女子向韩康买药，讨价还价，女子说她早就知道韩康言不二价，韩康叹息自己隐名避世还是被人认出，就隐遁于霸陵山中"]},{"id":10653,"word":"口不应心","pinyin":"kǒu bù yìng xīn","abbr":"kbyx","explanation":"应：符合。心口不一致。","source":{"text":"俺娘好口不应心也呵。","book":"元·王实甫《西厢记·夫人停婚》"},"example":{"text":"官人，你昨夜恁般说了，却又～，做下那事！（明·冯梦龙《醒世恒言》卷八）"},"similar":["口是心非","心口不一"],"opposite":["言出必行","言行一致"],"usage":"作谓语、宾语、状语；指心口不一"},{"id":10654,"word":"口不择言","pinyin":"kǒu bù zé yán","abbr":"kbzy","explanation":"指情急时说话不能正确用词表达或指说话随便。","source":{"text":"性甚褊急，当其急也，口不择言，手自捶击。","book":"《北史·魏艾陵伯子华传》"},"example":{"text":"周近他居然这样～，他怎么能这样说！","book":"郭沫若《蔡文姬》第一幕"},"similar":["口无遮拦"],"opposite":["妙语连珠"],"usage":"作谓语、宾语、状语；用于紧急情况"},{"id":10655,"word":"口不绝吟","pinyin":"kǒu bù jué yín","abbr":"kbjy","explanation":"吟：吟咏，背诵。嘴里不停地吟诵。形容学习非常刻苦。","source":{"text":"先生口不绝吟于六艺之文，手不停披于百家之编。","book":"《旧唐书·韩愈传》"},"usage":"作谓语、状语；用于读书等"},{"id":10656,"word":"口不言钱","pinyin":"kǒu bù yán qián","abbr":"kbyq","explanation":"形容廉洁清高，不讲钱财。","source":{"text":"王夷甫雅尚玄远，常疾其妇贪浊，口未尝言钱。妇欲试之，令婢以钱绕床，不得行。夷甫晨起，见钱阂行，令婢：‘举阿堵物！’","book":"南朝·宋·刘义庆《世说新语·规箴》"},"example":{"text":"郭氏恃势作威，贪鄙无厌，衍以妻为非，～。","book":"蔡东藩《两晋演义》第十回"}},{"id":10657,"word":"口中蚤虱","pinyin":"kǒu zhōng zǎo shī","abbr":"kzzs","explanation":"比喻极易消灭的敌人，犹如口中之虱。故又作“口中虱”。","source":{"text":"（王）以临东阳，则邯鄣口中虱也。","book":"《韩非子·七术》"},"example":{"text":"校尉韩威进曰：“以新室之威而吞胡虏，无异～。”","book":"《汉书·王莽传》"},"similar":["口中之虱"],"usage":"作主语、宾语；指易消灭的敌人"},{"id":10658,"word":"口中雌黄","pinyin":"kǒu zhōng cí huáng","abbr":"kzch","explanation":"雌黄：即鸡冠石，过去写字用黄纸，写错了就用雌黄涂沫后重写。随口更改说得不恰当的话。比喻言论前后矛盾，没有一定见解。","source":{"text":"义理有所不安，随即更改，世号口中雌黄。","book":"《晋书·王衍传》"},"example":{"text":"议论反复曰～。","book":"宋·胡继宗《书言故事·事物譬类》"},"similar":["言而无信","出尔反尔"],"usage":"作宾语；比喻言论前后矛盾","story":["西晋时期，太尉王衍喜欢谈论老庄，他所论的义理随时更改，被人称为口中雌黄。他找到当时对老庄深有研究的郭象来探讨。郭象对老庄思想作了系统全面的分析，让王衍无法插嘴。王衍对他十分佩服说他谈老庄思想如同悬河泻水一样永不枯竭"]},{"id":10659,"word":"口举手画","pinyin":"kǒu jǔ shǒu huà","abbr":"kjsh","explanation":"一面讲一面用手势帮助表达意思。","source":{"text":"其经承子厚口讲指画，为文词者，悉有法度可观。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"酒酣，为人称说古今成败废兴之故，～，议论风生。","book":"清·汪琬《彭公子篯传》"}},{"id":10660,"word":"口传心授","pinyin":"kǒu chuán xīn shòu","abbr":"kcxs","explanation":"指师徒间口头传授，内心领会。","source":{"text":"学书之法，非口传心授，不得其精。","book":"明·解缙《春雨杂述·评书》"},"example":{"text":"尽管在旧社会得不到出版发行的便利，千百年来通过无数艺人的～，终于很好地保留下来了。","book":"光未然《戏曲遗产中的现实意义》"},"usage":"作谓语、定语、宾语；指师徒间口头传授"},{"id":10661,"word":"口似悬河","pinyin":"kǒu sì xuán hé","abbr":"ksxh","explanation":"形容能说会辨，说起来没个完。同“口若悬河”。","source":{"text":"假使苏秦、张仪、陆贾、郦生复出，口似悬河，舌如利刃，安能动我心哉！","book":"明·罗贯中《三国演义》第四十五回"},"example":{"text":"从无心闲话里谈到十三妹，果然引动了那老头儿的满肚皮牢骚，不必等人盘问，他早不禁不由～的讲将起来。","book":"清·文康《儿女英雄传》第十六回"},"similar":["口若悬河","口如悬河"],"opposite":["沉默寡言"],"usage":"作谓语、宾语、定语；指口才很好"},{"id":10662,"word":"口体之奉","pinyin":"kǒu tǐ zhī fèng","abbr":"ktzf","explanation":"奉：奉养。指衣食方面的奉养。","source":{"text":"心欲求道，而以口体之奉不若人为耻，其识趣之卑陋甚矣，何足与议于道哉？","book":"宋·朱熹《论语集注》卷二"},"example":{"text":"不知～不若人也。","book":"明·宋濂《送东阳马生序》"}},{"id":10663,"word":"口出不逊","pinyin":"kǒu chū bù xùn","abbr":"kcbx","explanation":"逊：谦逊、恭顺。说出的话非常不谦逊。","source":{"text":"却说关公正坐帐中，忽探马飞报：‘曹操差于禁为将，领七枝精壮兵到来。前部先锋庞德，军前抬一木榇，口出不逊之言，誓欲与将军决一死战。兵离城止三十里矣。’","book":"明·罗贯中《三国演义》第七十四回"},"example":{"text":"崇应彪～之言，请丞相军令定夺。","book":"明·许仲琳《封神演义》第二十八回"},"similar":["出言不逊"],"opposite":["彬彬有礼"],"usage":"作谓语、宾语；指非常不谦虚"},{"id":10664,"word":"口出大言","pinyin":"kǒu chū dā yán","abbr":"kcdy","explanation":"说大话。形容说话狂妄。","source":{"text":"御者见考叔口出大言，更不敢上前，且立住脚观看。","book":"明·冯梦龙《东周列国志》第七回"},"example":{"text":"某家好意劝你，乐得两邦和好；你反～！不必多言，放马来罢。","book":"清·钱彩《说岳全传》第七十回"},"similar":["口出狂言"],"usage":"作谓语、宾语；指讲大话"},{"id":10665,"word":"口出狂言","pinyin":"kǒu chū kuáng yán","abbr":"kcky","explanation":"嘴里说出狂妄自大的话。指说话狂妄、放肆。也指胡说八道。","source":{"text":"宋江听得，慌忙过来看时，却是‘九纹龙’史进，‘没遮拦’穆弘，在阁子内吃得大醉，口出狂言。","book":"明·施耐庵《水浒传》第七十二回"},"example":{"text":"刺客姓李名景纯，直隶正定府人。身体短悍，面貌凶恶。手脚系以铁锁，依然～，侮蔑政府。","book":"老舍《赵子曰》二十三"},"similar":["大言不惭"],"usage":"作谓语、宾语、定语；用于说话","story":["隋朝时期，杨广谋取太子之位，在宇文述的鼓动下，借机陷害姓李的人，于是天下姓李的人纷纷逃避。惟独李靖不信邪，他到庙宇求卜，他当众口出狂言想有成为天子的非分之想，可惜卦象显现他只是一个辅臣而已，他只有待时而动了"]},{"id":10666,"word":"口口声声","pinyin":"kǒu kǒu shēng shēng","abbr":"kkss","explanation":"形容一次一次地说，或经常说。","source":{"text":"你也曾听杜宇，他那里口口声声，撺掇先生不如归去。","book":"元·石君宝《秋胡戏妻》第三折"},"example":{"text":"韩世忠带领人马已到城下，～要拿走二位王爷。","book":"清·钱彩《说岳全传》第四十七回"},"similar":["有口无心","言不由衷","指天誓日"],"opposite":["心口如一","言为心声","一言不发"],"usage":"作状语；形容反反复复地陈述"},{"id":10667,"word":"口口相传","pinyin":"kǒu kǒu xiāng chuán","abbr":"kkxc","explanation":"不著文字，口头相传。","source":{"text":"经云：‘知白守黑，神明自来。’是知玄为万物母，圣人秘之，不形文字，口口相传。","book":"宋·张君房《云笈七签》第七十二卷"},"example":{"text":"虽然他败坏了～的韵事。","book":"鲁迅《且介亭杂文·病后杂谈》"},"similar":["口传心授"],"usage":"作谓语；指口头传布或传授"},{"id":10668,"word":"口吐珠玑","pinyin":"kǒu tǔ zhū jī","abbr":"ktzj","explanation":"珠、玑：都是珠宝，圆的叫珠，不圆的叫玑。形容说话有文采。","source":{"text":"因俺夫人闻知苏轼胸怀锦绣，口吐珠玑，有贯世之才。","book":"元·无名氏《醉写赤壁赋》一折"},"example":{"text":"他常常～，有不凡之论。"},"similar":["咳唾成珠"],"usage":"作谓语、定语；形容说话有文采"},{"id":10669,"word":"口含天宪","pinyin":"kǒu hán tiān xiàn","abbr":"khtx","explanation":"天宪：指朝廷法令。比喻说话就是法律，可以决定人的生死。","source":{"text":"手握王爵，口含天宪，非复掖廷永巷之职。","book":"南朝·宋·范晔《后汉书·宦者传论》"},"example":{"text":"他真还有～的命，3岁就登基做皇帝。"},"similar":["口衔天宪"],"usage":"作宾语、定语；比喻说话就是法律"},{"id":10670,"word":"口吻生花","pinyin":"kǒu wěn shēng huā","abbr":"kwsh","explanation":"比喻谈吐文雅。","source":{"text":"张祜苦吟，妻孥唤之不应，以责祜。祜曰：‘吾方口吻生花，岂恤汝辈。’","book":"唐·冯贽《云仙杂记》第五卷引《白氏金锁》"},"example":{"text":"自家做来做去，原觉得～；他人看了又看也必定拈花微笑。","book":"清·李汝珍《镜花缘》第100回"},"usage":"作谓语；比喻吟诗得意，兴趣极浓"},{"id":10671,"word":"口呆目瞪","pinyin":"kǒu dāi mù dèng","abbr":"kdmd","explanation":"嘴说不出话，眼发直。形容很吃惊的样子。","source":{"text":"那军士见妲己美貌，已自有十分怜惜，再加他娇滴滴，叫了几声将军长，将军短。便把这些军士，叫得骨软筋酥，口呆目瞪，软痴痴作一堆麻，酥酥成一块，莫能动履。","book":"明·许仲林《封神演义》第九十七回"},"example":{"text":"林氏却又把小白菜的事情，细细向刘锡彤说了一遍，刘锡彤听得，不禁吓得～。","book":"《杨乃武与小白菜》第三十回"},"similar":["目瞪口呆","口呆目钝"],"usage":"作谓语、状语；用于惊讶的场合"},{"id":10672,"word":"口呆目钝","pinyin":"kǒu dāi mù dùn","abbr":"kdmd","explanation":"形容很吃惊的样子。同“口呆目瞪”。","source":{"text":"张福寿顿时口呆目钝，半天才小声说：‘我晓得的喃！我又没去戴过红花、吃过油大。’","book":"克非《春潮急》"},"example":{"text":"他惊讶得～了。"},"similar":["口呆目瞪"],"usage":"作谓语、状语；用于惊讶的场合"},{"id":10673,"word":"口坠天花","pinyin":"kǒu zhuì tiān huā","abbr":"kzth","explanation":"比喻指以夸诞之词动人听闻或以甘言骗人。","source":{"text":"据《大乘本生心地观经·序品》载，佛祖说法，感动天神，“六欲诸天及天子众，以天福力雨种种华：优钵罗华，波头摩华……于虚空中缤纷乱坠”，“天华乱坠满虚空，众香普熏于大会”。华，同“花”。"},"example":{"text":"饶伊～，难逃我双眸似电。","book":"清·李渔《奈何天·媒欺》"},"similar":["天花乱坠"],"usage":"作谓语、状语；用于比喻句"},{"id":10674,"word":"口壅若川","pinyin":"kǒu yōng ruò chuān","abbr":"kyrc","explanation":"比喻禁舆论之害。","source":{"text":"防民之口，甚于防川。川壅而溃，伤人必多，民亦如之。","book":"《国语·周语上》"},"example":{"text":"夫心险如山，～，怨怒之情不一，欢谑之言无方。","book":"南朝·梁·刘勰《文心雕龙·谐隐》"},"usage":"作宾语、定语；用于比喻句"},{"id":10675,"word":"口多食寡","pinyin":"kǒu duō shí guǎ","abbr":"kdsg","explanation":"吃饭的人多，但是食物很少。","source":{"text":"愈不善自谋，口多而食寡。","book":"唐·韩愈《答胡生书》"},"example":{"text":"解放前夕，我们全家六口流落在这座小城市里，～，连一天三顿饭都无法维持。"},"similar":["僧舵粥少"],"usage":"作宾语、定语；用于生活"},{"id":10676,"word":"口头禅","pinyin":"kǒu tóu chán","abbr":"ktc","explanation":"原指和尚常说的禅语或佛号。现指经常挂在口头上而无实际意义的词句。","source":{"text":"平生不学口头禅，脚踏实地性虚天。","book":"宋·王楙《临终诗》"},"example":{"text":"‘有闻必录’或‘并无能力’的话，都不是向上的负责的记者所该采用的～。","book":"鲁迅《且介亭杂文二集·论人言可畏》"},"usage":"作宾语；指经常挂在口头上而无实际意义的词"},{"id":10677,"word":"口如悬河","pinyin":"kǒu rú xuán hé","abbr":"krxh","explanation":"形容能说会辨，说起来没个完。同“口若悬河”。","source":{"text":"德称口如悬河，宾主颇也得合。","book":"唐·韩愈《石鼓歌》：“安能以此上论列，愿借辩口如悬河。”明·冯梦龙《警世通言》第十七卷"},"example":{"text":"陈宫保倒着实和秋谷谈了一回，见秋谷～的滔滔不绝，不由得心中暗暗称奇。","book":"清·张春帆《九尾龟》第一百六八回"},"similar":["口若悬河","口似悬河"],"opposite":["噤若寒蝉"],"usage":"作谓语、宾语、定语；指口才很好","story":["晋朝读书人郭象，他善于思考问题，把书本上的知识灵活地运用到谈话上，他经过潜心研究老子、庄子的学说，不愿意做官。他谈起话来引经据典，头头是道，人们对天很敬佩，评论他的谈话好像“悬河泻水，注而不竭”"]},{"id":10678,"word":"口尚乳臭","pinyin":"kǒu shàng rǔ xiù","abbr":"ksrx","explanation":"乳臭：奶腥气。嘴里还有奶腥味。表示对年轻人的轻视。","source":{"text":"是口尚乳臭，不能当韩信。","book":"东汉·班固《汉书·高帝纪上》"},"example":{"text":"吾尚在湖南，见其少年子弟，～，目不识蟹文。","book":"梁启超《论中国人种之将来》"},"similar":["乳臭未干"],"opposite":["老谋深算"],"usage":"作谓语、补语；表示对年轻人的轻视","story":["楚汉相争时期，刘邦因西魏王魏豹要背叛就准备出兵讨伐。他询问郦食其魏豹的将领情况。郦食其说魏豹的大将是柏直，刘邦认为柏直是口尚乳臭，就派韩信、灌婴、曹参率军前去攻打魏豹，并获得大胜，活捉了魏豹"]},{"id":10679,"word":"口巧手拙","pinyin":"kǒu qiǎo shǒu zhuō","abbr":"kqsz","explanation":"巧：灵巧；拙：笨拙。光是嘴上能说，动手能力相当差。","example":{"text":"她是一个～的女孩。"},"usage":"作谓语、定语；用于人的能力"},{"id":10680,"word":"口干舌焦","pinyin":"kǒu gàn shé jiāo","abbr":"kgsj","explanation":"形容话说得很多或费尽口舌。同“口燥唇干”。","source":{"text":"指导员跟他平心静气地讲道理，讲得口干舌焦。","book":"袁静《伏虎记》第二回"},"example":{"text":"你就是讲到～也无济于事。"},"similar":["口干舌燥"],"usage":"作谓语、状语；指非常干渴"},{"id":10681,"word":"口干舌燥","pinyin":"kǒu gān shé zào","abbr":"kgsz","explanation":"燥：干。口舌都干了。形容说话太多。","source":{"text":"来日大难，口燥唇干；今日相乐，皆当喜欢。","book":"三国·魏·曹植《善哉行》"},"example":{"text":"那白氏心中正自烦恼，况且连歌数曲，～，声气都乏了，为何肯再唱。","book":"明·冯梦龙《醒世恒言·独孤生归途闹梦》"},"similar":["舌敝唇焦"],"usage":"作谓语、状语；指非常干渴"},{"id":10682,"word":"口快心直","pinyin":"kǒu kuài xīn zhǐ","abbr":"kkxz","explanation":"有啥说啥，想啥说啥。形容人性情直爽，语言明快。","source":{"text":"云姑娘，你如今长大了，越发心直嘴快了。","book":"清·曹雪芹《红楼梦》"},"example":{"text":"他是一个～的人。"},"similar":["心直口快","心直嘴快"],"opposite":["笨嘴笨舌"],"usage":"作谓语、宾语、定语；形容人性情直爽"},{"id":10683,"word":"口惠而实不至","pinyin":"kǒu huì ér shí bù zhì","abbr":"khesbz","explanation":"惠：恩惠。只在口头上答应给别人好处，而实际的利益却得不到别人身上。","source":{"text":"口惠而实不至，怨灾及其身。","book":"《礼记·表记》"},"example":{"text":"河间冯树柟，粗通笔札，落拓京师十余年，每遇机缘，辄无成就，干祈于人，率～。","book":"清·纪昀《阅微草堂笔记》卷三"},"similar":["空头支票"],"opposite":["言出必行"],"usage":"作谓语、补语；指说漂亮话"},{"id":10684,"word":"口授心传","pinyin":"kǒu shòu xīn chuán","abbr":"ksxc","explanation":"通过口头讲授和心领神会来传授。","source":{"text":"耳闻目见者，非众所共读之文；口授心传者，非人所同得之学。","book":"宋·华岳《翠微南征录·马政》"},"example":{"text":"～，只有叛逆才敢改造。","book":"老舍《新诗》"}},{"id":10685,"word":"口无择言","pinyin":"kǒu wú zé yán","abbr":"kwzy","explanation":"指出口皆合道理，无需选择。","source":{"text":"数年，扬州刺史观恂荐般在国口无择言，行无怨恶，宜蒙旌显。","book":"《孝经·卿大夫章》：“是故非法不言，非道不行。口无择言，身无择行。”《后汉书·刘般传》"},"example":{"text":"心根孝友，器包礼乐，动蹑思后，故～。","book":"唐·张说《赠吏部尚书萧公神道碑》"},"similar":["口无择言，身无择行"],"usage":"作宾语、定语；用于书面语"},{"id":10686,"word":"口无择言，身无择行","pinyin":"kǒu wú zé yán，shēn wú zé xíng","abbr":"kwzyswzx","explanation":"说出口的话和做出的事无需选择。形容说的话及做的事都很正确。","source":{"text":"是故非法不言，非道不行。口无择言，身无择行。","book":"《孝经·卿大夫章》"},"similar":["口无择言"],"usage":"作宾语、定语；用于书面语"},{"id":10687,"word":"口是心苗","pinyin":"kǒu shì xīn miáo","abbr":"ksxm","explanation":"犹言为心声。言语是思想的反映，从一个人的话里可以知道他的思想感情。","source":{"text":"氤氲篆烟袅，昏惨剌银灯照。玉漏迢迢，才是初更报。暗觑清霄，盼梦里他来到。却不道口是心苗，不住的频频叫。","book":"元·白朴《梧桐雨》第四折"},"example":{"text":"常言道：～，我们听出他的意图了"},"similar":["言为心声"],"usage":"作宾语、定语；用于说话"},{"id":10688,"word":"口是心非","pinyin":"kǒu shì xīn fēi","abbr":"ksxf","explanation":"嘴里说得很好，心里想的却是另一套。指心口不一致。","source":{"text":"口是心非，背向异辞。","book":"汉·桓谭《新论·辨惑》：“如非其人，口是而心非者，虽寸断支解，而道犹不出也。”《抱朴子·微旨》"},"example":{"text":"俺哥哥原来是～，不是好人了也。","book":"明·施耐庵《水浒全传》第七十三回"},"similar":["阳奉阴违","言不由衷"],"opposite":["言为心声","言行一致","表里如一"],"usage":"作定语、宾语；指言行不一"},{"id":10689,"word":"口有同嗜","pinyin":"kǒu yǒu tóng shì","abbr":"kyts","explanation":"每个人在口味上嗜好都相同。","source":{"text":"口之于味也，有同耆也；易牙先得我口之所耆者也。","book":"《孟子·告子上》"},"example":{"text":"～，不分贫富老少男女。","book":"梁实秋《豆汁儿》"}},{"id":10690,"word":"口服心服","pinyin":"kǒu fú xīn fú","abbr":"kfxf","explanation":"服：信服。心里嘴上都信服。指真心信服。","source":{"text":"毛主席从革命的根本利益出发，启发我们顾全大局，使我口服心服。","book":"《人民文学》1977年第9期"},"example":{"text":"我们就是要让他～。"},"similar":["心服口服"],"usage":"作谓语、宾语、状语；指信服"},{"id":10691,"word":"口没遮拦","pinyin":"kǒu méi zhē lán","abbr":"kmzl","explanation":"指说话没任何顾忌，信口胡言。","source":{"text":"这位‘大人’的口没遮拦，也是出了名的。","book":"高阳《胡雪岩全传·红顶商人》"},"similar":["不吐不快","口无遮拦","口不择言"],"usage":"作谓语、定语、状语；用于说话"},{"id":10692,"word":"口沸目赤","pinyin":"kǒu fèi mù chì","abbr":"kfmc","explanation":"形容人情绪激动，声音脸色都很严厉的样子。","source":{"text":"言人之非，瞋目扼腕，疾言喷喷，口沸目赤。","book":"《韩诗外传》卷九"},"usage":"作状语、定语；形容人情绪激动"},{"id":10693,"word":"口燥唇干","pinyin":"kǒu zào chún gān","abbr":"kzcg","explanation":"燥：干。口腔和嘴唇都干了。形容话说得很多或费尽口舌。","source":{"text":"来日大难，口燥唇干。今日相乐，皆当喜欢。","book":"南宋·郭茂倩《乐府诗集·相和歌辞十一·善哉行》"},"example":{"text":"指导员跟他平心静气地讲道理，讲得～。","book":"袁静《伏虎记》第二回"},"similar":["口干舌燥"],"usage":"作谓语、定语、状语；形容口渴、焦灼或说话"},{"id":10694,"word":"口燥喉干","pinyin":"kǒu zào hóu gān","abbr":"kzhg","explanation":"燥：干。形容非常干渴。","source":{"text":"直喊到他口燥喉干，心中发空，才打道进城回公寓。","book":"老舍《赵子曰》"},"similar":["舌焦口燥"],"usage":"作谓语、定语、状语；用于口语"},{"id":10695,"word":"口直心快","pinyin":"kǒu zhí xīn kuài","abbr":"kzxk","explanation":"想什么说什么，为人直爽。","source":{"text":"倒是觉慧口直心快，他终于说了出来。","book":"巴金《家》"},"example":{"text":"～的人容易犯错误。"},"similar":["心直口快"],"usage":"作谓语、定语；指为人直爽"},{"id":10696,"word":"口碑载道","pinyin":"kǒu bēi zài dào","abbr":"kbzd","explanation":"口碑：比喻群众口头称颂象文字刻在碑上一样；载：充满；道：道路。形容群众到处都在称赞。","source":{"text":"劝君不用镌顽石，路上行人口似碑。","book":"宋·释普济《五灯会元》卷十七"},"example":{"text":"自从老爷到任，并没见为国出力，倒先有了～。","book":"清·曹雪芹《红楼梦》第九十九回"},"similar":["交口称誉","有口皆碑"],"opposite":["怨声载道","民怨鼎沸"],"usage":"作谓语、宾语、定语；指好名声"},{"id":10697,"word":"口祸之门","pinyin":"kǒu huò zhī mén","abbr":"khzm","explanation":"祸：灾祸。嘴是招惹祸患的大门。形容话多易惹祸。","source":{"text":"口是祸之门，舌是斩身刀。","book":"后周·冯道《舌》"}},{"id":10698,"word":"口称三昧","pinyin":"kǒu chēng sān mèi","abbr":"kcsm","explanation":"佛教用语。指专心念诵佛经而达到拔除杂念、心神平静的境界。","source":{"text":"若得定心三昧及口称三昧者，心眼即开，见彼净土一切庄严，说无穷尽。","book":"《观念法门》卷一"}},{"id":10699,"word":"口绝行语","pinyin":"kǒu jué xíng yǔ","abbr":"kjxy","explanation":"说话严谨，不外传。","source":{"text":"自初及终未始背汝，心无异谋，口绝行语。","book":"唐·韩愈《送穷文》"}},{"id":10700,"word":"口耳之学","pinyin":"kǒu ěr zhī xué","abbr":"kezx","explanation":"指只知道耳朵进口里出的一些皮毛之见，而没有真正的学识。","source":{"text":"小人之学耳也，入乎耳，出乎口；口耳之间则四寸耳，曷足以美七尺之躯哉？","book":"《荀子·劝学》"},"example":{"text":"是当时虽从事于经义，亦皆～。","book":"清·赵翼《廿二史札记》卷八"},"usage":"作宾语；指道听途说的肤浅之学"},{"id":10701,"word":"口耳并重","pinyin":"kǒu ěr bìng zhòng","abbr":"kebz","explanation":"对说和听的训练同等重视。","source":{"text":"好容易给他进了中西折中的学堂，英文又专是‘口耳并重’的。","book":"鲁迅《彷徨·肥皂》"},"usage":"作宾语、定语；指对说和听的训练同等重视"},{"id":10702,"word":"口耳相传","pinyin":"kǒu ěr xiāng chuán","abbr":"kexc","explanation":"口说耳听地往下传授。","source":{"text":"口耳相传，或逮后世。","book":"鲁迅《汉文学史纲要》第一篇"},"similar":["口传心授"],"usage":"作宾语；指口头传授"},{"id":10703,"word":"口耳相承","pinyin":"kǒu ěr xiāng chéng","abbr":"kexc","explanation":"指接受传闻。","source":{"text":"数年来士大夫不察其实，口耳相承，猥有所称引，愈久愈讹，遂以滋甚。","book":"明·方孝孺《答王仲缙书》之一"},"similar":["口传心授"],"usage":"作宾语、定语；用于没有文字的教育"},{"id":10704,"word":"口耳讲说","pinyin":"kǒu ěr jiǎng shuō","abbr":"kejs","explanation":"耳朵刚听到嘴就说出去了。","source":{"text":"岂徒悬空口耳讲说，而遂可以谓之学孝乎？","book":"明·王守仁《传习录》"}},{"id":10705,"word":"口腹之累","pinyin":"kǒu fù zhī lěi","abbr":"kfzl","explanation":"口腹：指饮食；累：连累。指因为饮食而受到牵累。","source":{"text":"仲叔怪而问之，知，乃叹曰：‘闵仲叔岂以口腹累安邑邪？’遂去，客沛。","book":"汉·班固《东观汉记·闵贡》"},"example":{"text":"独是君子虽贫，不轻干人，乃以～，喋喋公堂，品斯下矣。","book":"清·蒲松龄《聊斋志异·狂生》"},"usage":"作宾语；用于书面语"},{"id":10706,"word":"口腹自役","pinyin":"kǒu fù zì yì","abbr":"kfzy","explanation":"口腹：饮食。饮食自理，不靠他人。","source":{"text":"尝从人事，皆口腹自役。","book":"《孟子·告子上》：“饮食之人，天有失也，则口腹岂适为尺寸之肤哉？”晋·陶渊明《归去来兮辞·序》"}},{"id":10707,"word":"口若悬河","pinyin":"kǒu ruò xuán hé","abbr":"krxh","explanation":"若：好像；悬河：激流倾泻。讲起话来滔滔不绝，像瀑布不停地奔流倾泻。形容能说会辨，说起来没个完。","source":{"text":"安能以此上论列，愿借辩口如悬河。","book":"南朝·宋·刘义庆《世说新语·赏誉》：“郭子玄语议如悬河泻水，注而不竭。”唐·韩愈《石鼓歌》"},"example":{"text":"知县见他说的～，又是本朝确切贼，不由得不信。","book":"清·吴敬梓《儒林外史》第四回"},"similar":["夸夸其谈","侃侃而谈","能言善辩"],"opposite":["沉默寡言","噤若寒蝉","闭口无言"],"usage":"作谓语、宾语、定语；指口才很好","story":["晋朝读书人郭象，他善于思考问题，把书本上的知识灵活地运用到谈话上，他经过潜心研究老子、庄子的学说，不愿意做官。他谈起话来引经据典，头头是道，人们对天很敬佩，评论他的谈话好像“悬河泻水，注而不竭”"]},{"id":10708,"word":"口蜜腹剑","pinyin":"kǒu mì fù jiàn","abbr":"kmfj","explanation":"嘴上说的很甜美，凡里却怀着害人的主意。形容两面派的狡猾阴险。","source":{"text":"世谓李林甫‘口有蜜，腹有剑’。","book":"《资治通鉴·唐纪·玄宗天宝元年》"},"example":{"text":"这厮～，正所为慝怨而友者也。","book":"明·王世桢《鸣凤记》第二十五出"},"similar":["甜言蜜语","佛口蛇心","笑里藏刀"],"opposite":["心直口快","心口如一"],"usage":"作谓语、定语；指人阴险","story":["唐玄宗李隆基在位时，宰相李林甫非常阴险狡猾，对皇帝阿谀奉承、溜须拍马以取得信任；对朝中官员就以甜言蜜语取得信任，骗取对方的好感和欢心，然后背后出卖别人或加以陷害，用尽两面三刀的手段。人们说他是“口有蜜，腹有剑”"]},{"id":10709,"word":"口血未干","pinyin":"kǒu xuè wèi gān","abbr":"kxwg","explanation":"古时订立盟约，要在嘴上涂上牲口的血。指订约不久就毁约。","source":{"text":"与大国盟，口血未干而背之，可乎？","book":"《左传·襄公九年》"},"example":{"text":"～，宋人背盟，寡人伐之。","book":"明·冯梦龙《东周列国志》第十一回"},"similar":["尸骨未寒"],"usage":"作谓语、宾语；指订盟约不久就毁约","story":["春秋时期，各诸侯国不断打仗，晋国联合鲁国进攻郑国，郑国见他们来势凶猛，只好派代表公子马非到戏地与晋国大将荀偃歃血为盟，签订合约。不久，楚国派兵来进攻郑国，晋国坐视不救，公子马非认为晋国口血未干而不救就与楚结盟"]},{"id":10710,"word":"口衔天宪","pinyin":"kǒu xián tiān xiàn","abbr":"kxtx","explanation":"比喻说话就是法律，可以决定人的生死。同“口含天宪”。","source":{"text":"天宪，王法也；谓刑戮出于其口也。","book":"《资治通鉴·汉桓帝永兴元年》：“当今中官近习，窃持国柄，受握王爵，口衔天宪。”胡三省注"},"similar":["口含天宪"],"usage":"作宾语、定语；比喻说话就是法律"},{"id":10711,"word":"口角春风","pinyin":"kǒu jiǎo chūn fēng","abbr":"kjcf","explanation":"口角：嘴边。原指言语评论如春风之能生长万物。后比喻替人吹嘘或替人说好话。","source":{"text":"孔公诸清谈高论，口虚枯吹生。","book":"《后汉书·郑太传》"},"example":{"text":"陈健听说，就如～，说得天花乱坠，差不多恨天无柱，恨地无环，方是他干营生的手段。","book":"清·黄小配《廿载繁华梦》第十九回"},"similar":["口角生风","为人说项"],"usage":"作宾语；比喻为人美言，助成其事"},{"id":10712,"word":"口角流沫","pinyin":"kǒu jiǎo liú mò","abbr":"kjlm","explanation":"口角：嘴边。口角飞溅唾沫。形容说话时慷慨激昂的样子。","source":{"text":"愿书万本诵万过，口角流沫右手胝。","book":"唐·李商隐《韩碑》"}},{"id":10713,"word":"口角流涎","pinyin":"kǒu jiǎo liú xián","abbr":"kjlx","explanation":"形容对喜爱又不能占有之物的羡慕之态。","source":{"text":"学生睡法，饱饭靠椅，口角流涎，自喜以谓得其妙。","book":"宋·释惠洪《石门文字禅·题自诗与隆上人》"},"example":{"text":"已造成了玉液琼浆，香醪佳酿。大圣止不住～，就要去吃。","book":"明·吴承恩《西游记》第五回"}},{"id":10714,"word":"口角生风","pinyin":"kǒu jiǎo shēng fēng","abbr":"kjsf","explanation":"比喻说话流利，能说会道。","source":{"text":"这样骂人的时候却是口角生风，不再有‘这个是’的打搅了。","book":"郭沫若《洪波曲》第11章"},"example":{"text":"这种语言艺术要求演员唱得字正腔圆，说得～。"},"similar":["能说会道"],"opposite":["笨嘴拙舌"],"usage":"作谓语、宾语、状语；形容人说话"},{"id":10715,"word":"口角锋芒","pinyin":"kǒu jiǎo fēng máng","abbr":"kjfm","explanation":"口角：嘴边。言词尖锐，不让人。","source":{"text":"就是他的性情爽利，口角锋芒些，究竟也不曾得罪你们。想是他过于生得好了，反被这好所误。","book":"清·曹雪芹《红楼梦》第七十七回"}},{"id":10716,"word":"口角风情","pinyin":"kǒu jiǎo fēng qíng","abbr":"kjfq","explanation":"口头表示的情爱。","source":{"text":"那些用小钱的主子，只还他些口角风情罢了。","book":"清·李渔《比目鱼·联班》"},"example":{"text":"～不值得一信。"},"usage":"作主语、宾语；用于口头示爱"},{"id":10717,"word":"口讲手画","pinyin":"kǒu jiǎng shǒu huà","abbr":"kjsh","explanation":"一面讲一面用手势帮助表达意思。","source":{"text":"其经承子厚口讲指画，为文词者，悉有法度可观。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"好学者从之请问，～，终席或至千字。","book":"宋·黄庭坚《题跋》"},"similar":["口讲指画","口讲指划","指画口授"],"usage":"作谓语、宾语；形容详细地解说"},{"id":10718,"word":"口讲指划","pinyin":"kǒu jiǎng zhǐ huà","abbr":"kjzh","explanation":"一面讲一面用手势帮助表达意思。形容详细地解说。","source":{"text":"每条凳子可容几人，哪里是站台，哪里是门……都口讲指划地详细说给他们听。","book":"冯玉祥《我的生活》第七章"},"similar":["口讲指画","口讲手画","指画口授"],"usage":"作谓语、状语；形容详细地解说"},{"id":10719,"word":"口讲指画","pinyin":"kǒu jiǎng zhǐ huà","abbr":"kjzh","explanation":"一面讲一面用手势帮助表达意思。","source":{"text":"其经承子厚口讲指画，为文词者，悉有法度可观。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"他给学生上课经常是～的。"},"similar":["口讲手画","口讲指划"],"usage":"作谓语、宾语；形容详细地解说"},{"id":10720,"word":"口诛笔伐","pinyin":"kǒu zhū bǐ fá","abbr":"kzbf","explanation":"诛：痛斥，责罚；伐：声讨，攻打。从口头和书面上对坏人坏事进行揭露和声讨。","source":{"text":"此丈夫所当履其道，免笔诛口伐于荜门闺窦之间。","book":"宋·陈亮《畏羞于君子》"},"example":{"text":"他捐廉弃耻，向权门富贵贪求，全不知～是诗人句，垄上璠间识者羞。","book":"明·汪廷讷《三祝记·同谪》"},"similar":["大张挞伐"],"usage":"作谓语、宾语、定语；表示对坏人坏事的揭发"},{"id":10721,"word":"口语籍籍","pinyin":"kǒu yǔ jí jí","abbr":"kyjj","explanation":"籍籍：杂乱的样子。指议论纷纷，五花八门。","source":{"text":"国中口语籍籍，慎无复至江都。","book":"《汉书·景十三王传》"},"example":{"text":"夫四主凶人，共杀一女子，如屠犬豕，往来踪迹，～，岂为难察之狱。","book":"明·归有光《答唐虔伯书》"}},{"id":10722,"word":"口说无凭","pinyin":"kǒu shuō wú píng","abbr":"kswp","explanation":"单凭口说，不足为据。","source":{"text":"你不合打凤牢龙，翻云覆雨，陷人坑井。咱两个口说无凭。","book":"元·乔梦符《扬州梦》第四折"},"example":{"text":"此皆～，待我亲去踏看明。","book":"明·凌濛初《二刻拍案惊奇》卷十二"},"similar":["空口无凭"],"opposite":["有凭有据"],"usage":"作补语、分句；指口头说不能作为凭据"},{"id":10723,"word":"口诵心惟","pinyin":"kǒu sòng xīn wéi","abbr":"ksxw","explanation":"诵：朗读；惟：思考。口中朗诵，心里思考。","source":{"text":"手披目视，口诵其言，心惟其义。","book":"唐·韩愈《上襄阳于相公书》"},"example":{"text":"侪辈往往～，吟哦上下，记忆不少休。","book":"宋·陈亮《送吴恭你知县序》"},"similar":["口诵心维"],"usage":"作谓语、宾语；指口中念诵，心里思考"},{"id":10724,"word":"口诵心维","pinyin":"kǒu sòng xīn wéi","abbr":"ksxw","explanation":"口里念诵，心里思考。","source":{"text":"[礼部]谓内书堂进世则所进，与《忠鉴录》同立课程，使其口诵心维，可以迁善改过。","book":"明·沈德符《野获编补遗·内监·纪述内臣》"},"example":{"text":"不觉～，手舞足蹈。","book":"友梅氏《〈武昌两日记〉序》"},"similar":["口诵心惟"],"usage":"作谓语、宾语；指口中念诵，心里思考"},{"id":10725,"word":"口谈道德，志在穿窬","pinyin":"kǒu tán dào dé，zhì zài chuān yú","abbr":"ktddzzcy","explanation":"穿窬：指偷摸盗窃的行为。嘴上在讲仁义道德，心里却在想着翻墙越壁偷东西。常用以讽刺伪君子。","source":{"text":"名为山人而心同商贾，口谈道德而志在穿窬。","book":"明·李贽《焚书·又与焦弱侯》"}},{"id":10726,"word":"口谐辞给","pinyin":"kǒu xié cí jǐ","abbr":"kxcg","explanation":"指言辞诙谐敏捷。","source":{"text":"上以朔口谐辞给，好作问之。","book":"《汉书·东方朔传》"},"usage":"作谓语、定语；用于书面语"},{"id":10727,"word":"口轻舌薄","pinyin":"kǒu qīng shé bó","abbr":"kqsb","explanation":"形容说话刻薄尖酸。","source":{"text":"小小年纪无厚道，口轻舌薄诮谁人？","book":"《天雨花》第25回"},"example":{"text":"你得福不知，只管～取笑人家。","book":"钱钟书《围城》"},"similar":["尖酸刻薄"],"usage":"作谓语；指人说话"},{"id":10728,"word":"口辩户说","pinyin":"kǒu biàn hù shuō","abbr":"kbhs","explanation":"户：住户。口头争辩并挨户劝说。","source":{"text":"虽口辩户说之，不能化一人。","book":"《淮南子·原道训》"}},{"id":10729,"word":"口齿伶俐","pinyin":"kǒu chǐ líng lì","abbr":"kcll","explanation":"口齿：说话、言谈；伶俐：聪明，灵活。谈吐麻利，应付自如。形容口才好。","source":{"text":"宝玉素日虽然口齿伶俐，此时一心却为金钏儿感伤，恨不得也身亡命殒。","book":"清·曹雪芹《红楼梦》第33回"},"example":{"text":"他是一个～的男孩。"},"similar":["伶牙俐齿"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；指口才好"},{"id":10730,"word":"口齿生香","pinyin":"kǒu chǐ shēng xiāng","abbr":"kcsx","explanation":"嘴和牙齿都有香味。比喻所读的作品意味深长，隽永宜人。","source":{"text":"前者捧读诸位姐姐佳作，真令人口齿生香。","book":"清·李汝珍《镜花缘》第五十六回"},"usage":"作谓语、宾语；用于文章等"},{"id":10731,"word":"古为今用","pinyin":"gǔ wéi jīn yòng","abbr":"gwjy","explanation":"批判地继承文化遗产，使之为今天的无产阶级政治服务。","source":{"text":"古为今用，洋为中用。","book":"毛泽东《书信选集·致陆定一》"},"example":{"text":"他也竭力主张中国五千年封建文化的精华应当继承而发展，而使～。","book":"茅盾《向鲁迅学习》"},"similar":["援古证今"],"opposite":["以古非今"],"usage":"作定语；指继承文化遗产"},{"id":10732,"word":"古之遗直","pinyin":"gǔ zhī yí zhí","abbr":"gzyz","explanation":"遗：留下来的；直：正直。有古代遗风的正直的人。","source":{"text":"叔向，古之遗直也。治国制刑，不隐于亲，三数叔鱼之恶，不为末减。","book":"《左传·昭公十四年》"},"example":{"text":"《陈书·孔奂传》：“世祖曰：‘～，复见于卿。’”"},"usage":"作主语、宾语；用于书面语"},{"id":10733,"word":"古井不波","pinyin":"gǔ jǐng bù bō","abbr":"gjbb","explanation":"古井：枯竭的老井。波：波澜。枯竭的老井已不会再起波澜。比喻心境沉寂，不会因外界的影响而动感情。旧时指寡妇不思再嫁。亦作“古井无波”、“无波古井”。","source":{"text":"无波古井水，有节秋竹竿。","book":"唐·白居易《赠元稹》诗"},"example":{"text":"吾自今以后，惟当更守身如玉，使此心如～。","book":"恽代英《致沈宝秀书》"}},{"id":10734,"word":"古井无波","pinyin":"gǔ jǐng wú bō","abbr":"gjwb","explanation":"古井：枯井。比喻内心恬静，情感不为外界事物所动。","source":{"text":"无波古井水，有节秋竹竿。","book":"唐·白居易《赠元稹》诗"},"example":{"text":"知从了义透音闻，～岂更浑。","book":"宋·范成大《次韵乐先生吴中见寄八首》诗"},"usage":"作宾语、定语；比喻内心恬静"},{"id":10735,"word":"古今一揆","pinyin":"gǔ jīn yī kuí","abbr":"gjyk","explanation":"揆：道理。指从古至今道理相同。","source":{"text":"汉有马良，清有马良，协穆二家，亦复古今一揆。","book":"章太炎《驳神我宪政论》"},"example":{"text":"章炳麟《驳神我宪政说》：“汉有马良，清有马良，协穆二家，亦复～。”"},"similar":["古今一辙"],"usage":"作谓语、宾语、定语；指没有改变"},{"id":10736,"word":"古今一辙","pinyin":"gǔ jīn yī zhé","abbr":"gjyz","explanation":"辙：车轮碾过的痕迹。指某事物从古到今没有改变。","source":{"text":"立言者骛高，读书者好奇，与其詹詹，毋宁炎炎，古今一辙，颠扑不破。","book":"清·姚华《曲海一勺·述旨第一》"},"similar":["一成不变","古今一揆"],"usage":"作谓语、宾语、定语；指没有改变"},{"id":10737,"word":"古今中外","pinyin":"gǔ jīn zhōng wài","abbr":"gjzw","explanation":"指从古代到现代，从国内到国外。泛指时间久远，空间广阔。","source":{"text":"历观古今中外正史小说所记载英雄患难之事，惊心动魄者，不一而足。","book":"清·梁启超《意大利建国三杰传》第五节"},"example":{"text":"翻遍了～的历史，没有一个国家曾经用这种所谓示威运动而变成了既富且强。","book":"茅盾《子夜》九"},"similar":["古往今来"],"usage":"作宾语、定语、状语；指古代现代国内外"},{"id":10738,"word":"古古怪怪","pinyin":"gǔ gǔ guài guài","abbr":"gggg","explanation":"稀奇怪异的样子。","source":{"text":"一座古古怪怪的高山，好凶险！","book":"明·许仲琳《封神演义》第59回"},"example":{"text":"明·冯梦龙《警世通言》第40卷：“一心心要与人报冤家，～的好怕。”"},"similar":["稀奇古怪"],"opposite":["平淡无奇"],"usage":"作谓语、定语、状语；用于事物或行为等"},{"id":10739,"word":"古圣先贤","pinyin":"gǔ shèng xiān xián","abbr":"gsxx","explanation":"圣：学识或技能有极高成就的人；贤：有德行的人。古时候的圣人和贤人。","source":{"text":"试看古圣先贤，守先如执玉，到临死时候，还是一个’如临深渊，如履薄冰‘的光景。","book":"清·李绿园《歧路灯》第五十八回"},"example":{"text":"良心是～给他制备好了的。","book":"老舍《黑白李》"},"usage":"作主语、宾语、定语；用于口语"},{"id":10740,"word":"古寺青灯","pinyin":"gǔ sì qīng dēng","abbr":"gsqd","explanation":"古寺：年代久远的寺庙；青灯：以植物油为燃料的灯，其光发青。形容虔诚修行者生活的凄苦与寂寞。","source":{"text":"可怜绣户侯门女，独卧青灯古佛前。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"一个立志修行的何玉凤，要向～寻活计。","book":"清·文康《儿女英雄传》第二十四回"},"usage":"作宾语、定语；用于修行等"},{"id":10741,"word":"古已有之","pinyin":"gǔ yǐ yǒu zhī","abbr":"gyyz","explanation":"古时候就已经存在了。","source":{"text":"他们说我们贿选，这是古已有之的。","book":"冯玉祥《我的生活》第三十章"},"example":{"text":"这种现象～，不足为奇"},"opposite":["空前绝后"],"usage":"作宾语、定语、分句；用于事情或现象等"},{"id":10742,"word":"古往今来","pinyin":"gǔ wǎng jīn lái","abbr":"gwjl","explanation":"从古到今。泛指很长一段时间。","source":{"text":"往古今来谓之宙，四方上下谓之宇。","book":"《淮南子·齐俗训》"},"example":{"text":"虽然住了两三天，日子却不多，把～没见过的，没吃过的，没听见的，都经验过了。","book":"清·曹雪芹《红楼梦》第四十二回"},"similar":["自古以来"],"usage":"作定语、状语；指从古到今"},{"id":10743,"word":"古心古貌","pinyin":"gǔ xīn gǔ mào","abbr":"gxgm","explanation":"貌：容貌。形容外表和内心具有古人的风范。","source":{"text":"古心古貌，读前辈未见之书。","book":"宋·陈亮《谢陈同知启》"},"similar":["古貌古心"],"usage":"作谓语、定语；指有古人的风范"},{"id":10744,"word":"古是今非","pinyin":"gǔ shì jīng fēi","abbr":"gsjf","explanation":"古代、现在的是非得失。指评论从古到今的功过曲直。","source":{"text":"一个待咏月嘲风，一个待飞觞走斝，谈些古是今非，下学上达。","book":"元·马致远《青衫泪》"},"usage":"作宾语、定语；用于书面语"},{"id":10745,"word":"古木参天","pinyin":"gǔ mù cān tiān","abbr":"gmct","explanation":"参天：高入云天。古老的树木枝繁叶茂异常高大。","source":{"text":"孔明庙前有老柏，柯如青铜根如石，霜皮溜雨四十围，黛色参天二千尺。","book":"唐·杜甫《古柏行》"},"example":{"text":"不一时来到一个所在，～，藤萝满径。","book":"明·罗贯中《平妖传》第六回"},"usage":"作谓语、定语；用于景物描写"},{"id":10746,"word":"古来今往","pinyin":"gǔ lái jīn wǎng","abbr":"gljw","explanation":"从古代到现代。","source":{"text":"古来今往夕阳中，江山依旧在，塔影自凌空。","book":"明·天然痴叟《石点头·江都市孝妇屠身》"},"similar":["古往今来"],"usage":"作定语、状语；指从古到今"},{"id":10747,"word":"古稀之年","pinyin":"gǔ xī zhī nián","abbr":"gxzn","explanation":"稀：少。指人到七十岁。","source":{"text":"酒债寻常行处有，人生七十古来稀。","book":"唐·杜甫《曲江二首》"},"example":{"text":"七十～是人生难得的。","book":"明·冯梦龙《醒世恒言·李道人独步云门》"},"similar":["年逾古稀"],"usage":"作宾语；指男性70岁"},{"id":10748,"word":"古肥今瘠","pinyin":"gǔ féi jīn shòu","abbr":"gfjj","explanation":"比喻书法的不同风格。","source":{"text":"无常谓之古肥，子敬谓之今瘠。古今既殊，肥瘦颇反。","book":"唐·张远彦《书法要录》卷二"},"usage":"作定语；比喻书法的不同风格"},{"id":10749,"word":"古色古香","pinyin":"gǔ sè gǔ xiāng","abbr":"gsgx","explanation":"形容器物书画等富有古雅的色彩和情调。","source":{"text":"古画色墨，或淡墨，则积尘所成，有一种古香可爱。","book":"宋·赵希鹄《洞天清录》"},"example":{"text":"你可以从明亮的窗玻璃后面看到～的字画、瓷器、铜鼎和小铜佛等等。","book":"徐迟《真迹》"},"similar":["古香古色"],"usage":"作定语、宾语；形容艺术品等"},{"id":10750,"word":"古语常言","pinyin":"gǔ yǔ cháng yán","abbr":"gycy","explanation":"古时候就已流传，至今人们还经常说的话。","source":{"text":"正按着陈婆婆古语常言。","book":"元·关汉卿《蝴蝶梦》第三折"},"usage":"作主语、宾语、定语；用于语言等"},{"id":10751,"word":"古调不弹","pinyin":"gǔ diào bù tán","abbr":"gdbt","explanation":"古调：古代的曲调。陈调不再弹。比喻过时的东西不受欢迎。","source":{"text":"泠泠七弦上，静吹松风寒。古调虽自爱，今人多不弹。","book":"唐·刘长卿《听弹琴》诗"},"opposite":["老调重谈"],"usage":"作宾语；指过时的东西不受欢迎","story":["唐朝时期，诗人刘长卿写《听弹琴》诗：“泠泠七弦上，静听松风寒，古调虽自爱，今人多不弹。”感慨世事与人心的变化，人心不古。他以此来讽刺今人不如古人高尚，大有知音难觅的感觉"]},{"id":10752,"word":"古调单弹","pinyin":"gǔ diào dān tán","abbr":"gddt","explanation":"比喻言行不合时宜。","source":{"text":"泠泠七弦上，静吹松风寒。古调虽自爱，今人多不弹。","book":"唐·刘长卿《听弹琴》诗"}},{"id":10753,"word":"古调独弹","pinyin":"gǔ diào dú tán","abbr":"gddd","explanation":"独弹：独自弹。曲调古雅，没有人能相附和。比喻人的行为不合时宜，难觅知音同道。","source":{"text":"清琴有古调，更向何人操。","book":"唐·刘长卿《客舍赠别》"}},{"id":10754,"word":"古貌古心","pinyin":"gǔ mào gǔ xīn","abbr":"gmgx","explanation":"形容外表和内心具有古人的风度。","source":{"text":"孟生江海上，古貌又古心。","book":"唐·韩愈《孟生》诗"},"example":{"text":"季苇萧迎了上去，见那人方巾阔服，～。","book":"清·吴敬梓《儒林外史》第二十八回"},"similar":["古心古貌"],"usage":"作谓语、定语；指有古人的风范"},{"id":10755,"word":"古道热肠","pinyin":"gǔ dào rè cháng","abbr":"gdrc","explanation":"古道：上古时代的风俗习惯，形容厚道；热肠：热心肠。指待人真诚、热情。","source":{"text":"同邑余成之，杨蓉裳先生宅相也，古道热肠，颇有任侠气。","book":"清·邹弢《三借庐笔谈·余成之》"},"example":{"text":"如今人情薄，肯以义气为重，～，肝胆照人的人毕竟不多。","book":"姚雪垠《李自成》第二卷第17章"},"similar":["古道心肠"],"usage":"作谓语、定语；比喻热心肠的人"},{"id":10756,"word":"古里古怪","pinyin":"gǔ lǐ gǔ guài","abbr":"glgg","explanation":"怪异、奇特。","source":{"text":"你在想什么古里古怪的心思？","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"她的脾气～。"},"similar":["稀奇古怪"],"opposite":["平淡无奇"],"usage":"作谓语、定语；指奇特"},{"id":10757,"word":"古香古色","pinyin":"gǔ xiāng gǔ sè","abbr":"gxgs","explanation":"古香：古书画散发出来的气味。古雅的色调、意趣。形容器物、书画和建筑等。","source":{"text":"哼！中国的古老文化……什么东西只要古香古色的那就是！","book":"王统照《青岛素描》"},"similar":["古色古香"],"usage":"作定语、宾语；形容艺术品等"},{"id":10758,"word":"句斟字酌","pinyin":"jù zhēn zì zhuó","abbr":"jzzz","explanation":"指写文章或说话时慎重细致，一字一句地推敲琢磨。","source":{"text":"宋儒积一生精力，字斟句酌，亦断非汉儒所及。","book":"清·纪昀《阅微草堂笔记》卷一"},"example":{"text":"他说话从不随随便便，而是～。"},"similar":["字斟句酌"],"usage":"作谓语；指逐句逐字仔细推敲"},{"id":10759,"word":"句栉字比","pinyin":"jù zhì zì bǐ","abbr":"jzzb","explanation":"一句句梳理，一字字比较。形容认真校核。","source":{"text":"讲解一卷两卷，不须句栉字比。","book":"明·朱之瑜《答奥村庸礼书》"},"example":{"text":"不敢以不敏二字塞责，即当～，瑜中索暇，以报台命。","book":"清·李渔《笠翁文集·复尤展先生后五札（其三）》"},"similar":["句比字栉"],"usage":"作宾语、定语、谓语；用于文章等"},{"id":10760,"word":"句比字栉","pinyin":"jù bǐ zì zhì","abbr":"jbzz","explanation":"逐字逐句仔细推敲。同“句栉字比”。","source":{"text":"宋子建尽取六代三唐之诗，句比字栉，继声属和，名之曰《遥和集》。","book":"清·钱谦益《宋子建序》"},"similar":["句栉字比"],"usage":"作宾语、定语、分句；用于文章等"},{"id":10761,"word":"另开生面","pinyin":"lìng kāi shēng miàn","abbr":"lksm","explanation":"另外创造新的形式或开创新的局面。","source":{"text":"凌烟功臣少颜色，将军下笔开生面。","book":"唐·杜甫《丹青诗》"},"example":{"text":"今日行这酒令，已是独出心裁，～。","book":"清·李汝珍《镜花缘》第九十一回"},"similar":["别开生面"],"opposite":["千篇一律"],"usage":"作谓语、定语；形容不同一般"},{"id":10762,"word":"另当别论","pinyin":"lìng dāng bié lùn","abbr":"ldbl","explanation":"另：另外；论：评论。指原来的看法或结论不能成立而应当另外加以评论。","example":{"text":"穆宗是年方弱冠，不急于此，谁知祸起不测，～。","book":"高阳《慈禧全传》一○六"}},{"id":10763,"word":"另有企图","pinyin":"lìng yǒu qǐ tú","abbr":"lyqt","explanation":"另外的图谋。","example":{"text":"小心他～，不要上当受骗。"},"usage":"作谓语、定语；用于口语"},{"id":10764,"word":"另有所图","pinyin":"lìng yǒu suǒ tú","abbr":"lyst","explanation":"图：图谋。指有别的目的。","source":{"text":"她到这县城的高中是另有所图的——说不定在这两年中，她能高攀一个条件好的男人。","book":"路遥《平凡的世界》第一卷第17章"},"example":{"text":"图：图谋。指有别的目的。"},"similar":["别有企图"],"usage":"作谓语、宾语；指有别的目的"},{"id":10765,"word":"另有洞天","pinyin":"lìng yǒu dòng tiān","abbr":"lydt","explanation":"另有一种新鲜的境界。","example":{"text":"岩洞中～的景色，引人入胜，不可言状。"}},{"id":10766,"word":"另楚寒巫","pinyin":"lìng chǔ hán wū","abbr":"lchw","explanation":"楚：楚怀王；巫：巫山神女。指夫妇或情人分居两地，孤单寂寞。","source":{"text":"孤帷冷簟，难辞白发于北堂；另楚寒巫，更撇红颜于别闼。","book":"明·陈汝元《金莲记·偕计》"},"similar":["牛郎织女"],"usage":"作宾语；指孤单寂寞的两地生活"},{"id":10767,"word":"另眼相待","pinyin":"lìng yǎn xiāng dài","abbr":"lyxd","explanation":"用另一种眼光看待。指看待某个人不同一般。也指不被重视的人得到重视。","source":{"text":"奴婢蒙娘娘另眼相待，实有冤苦在心。","book":"明·无名氏《霞笺记·拆情得喜》"},"example":{"text":"自己又仗着是刑夫人的陪房，连王夫人尚～，何况别人。","book":"清·曹雪芹《红楼梦》第七十四回"},"similar":["另眼相看"],"opposite":["一视同仁"],"usage":"作谓语、宾语；指特殊照顾"},{"id":10768,"word":"另眼相看","pinyin":"lìng yǎn xiāng kàn","abbr":"lyxk","explanation":"用另一种眼光看待。指看待某个人不同一般。也指不被重视的人得到重视。","source":{"text":"不想一见大王，查问来历，我等一实对，便把我们另眼相看。","book":"明·凌濛初《初刻拍案惊奇》卷八"},"example":{"text":"大家晓得他与中丞有旧，莫不～。","book":"清·李宝嘉《官场现形记》第十一回"},"similar":["刮目相看","另眼相待"],"opposite":["等量齐观","一视同仁","一律平等"],"usage":"作谓语；表示重视或歧视"},{"id":10769,"word":"另眼看待","pinyin":"lìng yǎn kàn dài","abbr":"lykd","explanation":"用不同于一般的眼光看待。","source":{"text":"侍郎与夫人看见人物标致，更加礼仪齐备，心下喜欢，另眼看待。","book":"明·凌濛初《二刻拍案惊奇》第15卷"},"example":{"text":"您是我家兄介绍来的，说实话，我真是～。","book":"杨沫《青春之歌》第二部第五章"},"similar":["另眼相看","刮目相看"],"opposite":["一视同仁"],"usage":"作谓语、定语；指重视或轻视"},{"id":10770,"word":"另眼看戏","pinyin":"lìng yǎn kàn xì","abbr":"lykx","explanation":"犹另眼相看。指看待某个人不同一般。也指不被重视的人得到重视。"},{"id":10771,"word":"另眼看承","pinyin":"lìng yǎn kàn chéng","abbr":"lykc","explanation":"用另一种眼光看待。指看待某个人不同一般。也指不被重视的人得到重视。","source":{"text":"实不相瞒，小僧原是羽林卫军人，名叫曾虎二，去年出征，拨在老爷部下。因见我勇力过人，留我帐前亲随，另眼看承。","book":"明·冯梦龙《醒世恒言》卷二十七"}},{"id":10772,"word":"另眼看觑","pinyin":"lìng yǎn kàn qù","abbr":"lykq","explanation":"犹另眼相看。","source":{"text":"官府都另眼看觑，谁人轻贱你？","book":"明·冯梦龙《喻世明言》第十七卷"},"example":{"text":"岐王不曾～咱哩。","book":"明·王衡《郁轮袍》第二折"},"similar":["另眼相看","另眼相待"],"opposite":["一视同仁"],"usage":"作谓语、定语；用于处事"},{"id":10773,"word":"另行高就","pinyin":"lìng xíng gāo jiù","abbr":"lxgj","explanation":"指变换工作环境，找更好的工作。","example":{"text":"我无钱时你当然～，你不漂亮时，我当然再找别的女人。","book":"柏杨《婚恋物语·敬意和爱心》"}},{"id":10774,"word":"另请高明","pinyin":"lìng qǐng gāo míng","abbr":"lqgm","explanation":"另外请一个较高明的人，意即不想受委托或聘请。","source":{"text":"既蒙苦苦相留，只好单这大令郎，做我个陈蔡及门；你这个二令郎，凭你另请高明。","book":"清·文康《儿女英雄传》第十八回"},"example":{"text":"至于破那妖术，愚兄弟是深山息影之人，也是毫无办法，大圣还是～。","book":"张恨水《八十一梦·第七十二梦》"},"similar":["另谋高就"],"usage":"作谓语；常用来作为推脱任务的用语"},{"id":10775,"word":"另谋高就","pinyin":"lìng móu gāo jiù","abbr":"lmgj","explanation":"指另找一份职业，意即辞去原职。","example":{"text":"他在此处无法发挥所长，只好～。"},"opposite":["另请高明"],"usage":"作谓语、宾语；用于口语"},{"id":10776,"word":"另起炉灶","pinyin":"lìng qǐ lú zào","abbr":"lqlz","explanation":"另外重支炉灶。比喻放弃原来的，另外从头做起。","source":{"text":"必至闹到‘出而哇之’，饭粪莫辨，这才‘另起炉灶’。","book":"清·李汝珍《镜花缘》第十四回"},"example":{"text":"第二师范解散，要～重新招生，重新招聘教职员。","book":"梁斌《红旗谱》五十"},"similar":["别具一格","标新立异","别树一帜"],"opposite":["一如既往","一成不变"],"usage":"作主语、谓语、定语；用于做事"},{"id":10777,"word":"另辟蹊径","pinyin":"lìng pì xī jìng","abbr":"lpxj","explanation":"另外开辟一条路。比喻另创一种风格或方法。","source":{"text":"对于这样另辟蹊径的教育宗旨与方法，自己确有坚强的信念。","book":"叶圣陶《倪焕之》"},"example":{"text":"他泼辣大胆，勇于实践和～"},"similar":["独辟蹊径"],"opposite":["随大流"],"usage":"作谓语、定语、宾语；指另创一种风格"},{"id":10778,"word":"叨在知己","pinyin":"tāo zài zhī jǐ","abbr":"tzzj","explanation":"叨：谦词，表示辱没他人，自觉惭愧；知己：友谊深厚的朋友。有愧于作为您的知己朋友。","source":{"text":"谓叨在知己，亟当如命。","book":"清·霁园主人《夜潭随录·崔秀才》"},"usage":"作宾语；用于自谦"},{"id":10779,"word":"叨陪末座","pinyin":"tāo péi mò zuò","abbr":"tpmz","explanation":"叨：谦词，受到（好处）；陪：奉陪；末座：席中最后的座位。这是受人宴请的客气话。","source":{"text":"兴，筵末坐啐醴。","book":"《仪礼·士冠礼》"},"example":{"text":"学艺社曾经大大地欢宴过他们，请了章士钊做陪客，我自己也曾～。","book":"郭沫若《革命春秋·创造十年续编》"},"usage":"作谓语；用于交往谦辞"},{"id":10780,"word":"叩天无路","pinyin":"kòu tiān wú lù","abbr":"ktwl","explanation":"叩：敲；阍：宫门；叩阍：鸣冤。指没办法申诉冤屈。","source":{"text":"生员自小女被恶侯抢劫，叩天无路，逢人哭诉。","book":"清·名教中人《好逑传》第二回"},"similar":["叩阍无路"],"usage":"作谓语；用于有冤无处诉"},{"id":10781,"word":"叩心泣血","pinyin":"kòu xīn qì xuè","abbr":"kxqx","explanation":"形容悲痛之极。","source":{"text":"裕等所以叩心泣血，不遑启处者也。","book":"《宋书·武帝纪上》"},"example":{"text":"此臣之所以～，呼天乞怜，而不能自己者也。","book":"明·张居正《再乞归葬疏》"},"usage":"作谓语；指十分悲痛"},{"id":10782,"word":"叩源推委","pinyin":"kòu yuán tuī wěi","abbr":"kytw","explanation":"指追究其根源。","source":{"text":"徐昌穀虽不得叩源推委，而风调高秀，十不能得五。","book":"明·王世贞《艺苑卮言》卷六"},"similar":["追根溯源"],"usage":"作谓语、宾语；用于探求根源"},{"id":10783,"word":"叩石垦壤","pinyin":"kòu shí kěn rǎng","abbr":"kskr","explanation":"叩：敲打；垦：开垦。敲石挖土。指破土动工。","source":{"text":"遂率子孙荷担者三千，叩石垦壤，箕畚运于渤海之尾。","book":"《列子·汤问》"},"similar":["破土动工"],"usage":"作谓语、宾语；指破土动工"},{"id":10784,"word":"叩角商歌","pinyin":"kòu jiǎo shāng gē","abbr":"kjsg","explanation":"角：牛角；商歌：悲伤的歌。敲着牛角，唱着低沉悲凉的歌。形容用言语和歌声自荐求官。","source":{"text":"甯戚饭牛车下，叩角而商歌。","book":"汉·蔡邕《琴操》"},"usage":"作谓语、定语；用于书面语"},{"id":10785,"word":"叩阍无计","pinyin":"kòu hūn wú jì","abbr":"khwj","explanation":"叩：敲；阍：宫门；叩阍：鸣冤。指没办法申诉冤屈。","source":{"text":"此恨怎消真可痛，叩阍无计欲呼天。","book":"清·秋瑾《精卫石》第四回"},"example":{"text":"老百姓经常是～的。"},"similar":["叩阍无路","叩天无路"],"usage":"作谓语；用于有冤无处诉"},{"id":10786,"word":"叩阍无路","pinyin":"kòu hūn wú lù","abbr":"khwl","explanation":"叩：敲。阍：宫门。无法敲到宫廷的门。形容百姓无处伸冤。亦作“叩阍无计”、“叩天无路”。","source":{"text":"翠羽南巡，叩阍无路，徒有冲冠发。孤忠耿耿，剑芒冷浸秋月。","book":"宋·黄中辅《念奴娇》词"},"example":{"text":"大臣造膝无从，小臣～。","book":"《明史·翟凤羽中传》"},"similar":["叩阍无计"],"usage":"作谓语；用于有冤无处诉"},{"id":10787,"word":"叩马而谏","pinyin":"kòu mǎ ér jiàn","abbr":"kmej","explanation":"勒住马头进行规劝。形容竭力进行劝谏。","source":{"text":"西伯卒，武王载木主，号为文王，东伐纣。伯夷、叔齐叩马而谏曰：‘父死不葬，爰及干戈，可谓孝乎？以臣弑君，可谓仁乎？’左右欲之。太公曰：‘此义人者。’扶而去之。","book":"《史记·伯夷列传》"},"example":{"text":"左右众将见夷、齐～，军士不得前进。","book":"明·许仲琳《封神演义》第六十八回"},"usage":"作谓语、定语；用于书面语","story":["商朝末年，伯夷与叔齐是孤竹国国君的儿子，孤竹君死后，两人互相推让不愿为王，跑到周文王那里。文王死后，武王要出兵讨伐暴君商纣王，伯夷与叔齐拉着武王的马劝谏他说：“父死不葬，爰及干戈，可谓孝乎？以臣弑君，可谓仁乎？”"]},{"id":10788,"word":"只争旦夕","pinyin":"zhǐ zhēng dàn xī","abbr":"zzdx","explanation":"力争在最短时间内达到目的。亦作“只争朝夕”。","source":{"text":"今朝宠命来首锡，掌枢衡只争旦夕。","book":"明·徐复祚《投梭记·却说》"},"similar":["只争朝夕"],"usage":"作谓语、定语；指抓紧时间"},{"id":10789,"word":"只争朝夕","pinyin":"zhǐ zhēng zhāo xī","abbr":"zzzx","explanation":"朝：早晨；夕：晚上；朝夕：形容时间短暂。比喻抓紧时间，力争在最短的时间内达到目的。","source":{"text":"今朝宠命来首锡，掌枢衡只争旦夕。","book":"明·徐复祚《投梭记·却说》"},"example":{"text":"天地转，光阴迫。一万年太久，～。","book":"毛泽东《满江红·和郭沫若同志》词"},"similar":["分秒必争","争分夺秒","朝乾夕惕"],"opposite":["虚度年华","蹉跎岁月","空耗时日"],"usage":"作谓语、定语、分句；指抓紧时间"},{"id":10790,"word":"只准州官放火，不准百姓点灯","pinyin":"zhǐ zhǔn zhōu guān fàng huǒ，bù zhǔn bǎi xìng diǎn dēng","abbr":"zzzgfhbzbxdd","explanation":"州官：一州的长官。指反动统治者自己可以胡作非为，老百姓没有正当活动的自由","source":{"text":"可是只准州官放火，不准百姓点灯，却是中国政治的一个通病。","book":"冯玉祥《我的生活》第12章"},"similar":["只准州官放火，不许百姓点灯"],"usage":"作宾语、分句；指肆意妄为"},{"id":10791,"word":"只准州官放火，不许百姓点灯","pinyin":"zhǐ zhǔn zhōu guān fàng huǒ，bù xǔ bǎi xìng diǎn dēng","abbr":"zzzgfhbxbxdd","explanation":"指统治者自己可以胡作非为，老百姓却连正当活动也要受到限制。","source":{"text":"田登作郡，自讳其名，触者必怒，吏卒多被榜笞。于是举州皆谓灯为火。上元放灯许人入州治游观，吏人遂书榜揭于市曰：‘本州依例放火三日。’","book":"宋·陆游《老学庵笔记》卷五"},"similar":["只许州官放火，不许百姓点灯"],"usage":"作宾语、分句；指肆意妄为"},{"id":10792,"word":"只凤孤凰","pinyin":"zhī fèng gū huáng","abbr":"zfgh","explanation":"孤单单的一只凤凰。","source":{"text":"意厮投门厮对户厮当，成就了只凤孤凰。","book":"元·郑光祖《梅香》"},"similar":["只鸾单凤"],"usage":"作宾语、定语；用于书面语"},{"id":10793,"word":"只可共患难，不可同安乐","pinyin":"zhǐ kě gòng huàn nàn，bù kě tóng ān lè","abbr":"zkghnbktal","explanation":"只能一起共度危险困难的日子，却不能一起共享安定快乐的生活。","source":{"text":"越王为人长颈鸟喙，可与共患难，不可与共乐。","book":"《史记·越王勾践世家》"}},{"id":10794,"word":"只可意会，不可言传","pinyin":"zhǐ kě yì huì，bù kě yán chuán","abbr":"zkyhbkyc","explanation":"只能用心去揣摩体会，没法用话具体地表达出来。指道理奥妙，难以说明。有时也指情况微妙，不便说明。","source":{"text":"意之所随者，不可以言传也。","book":"《庄子·天道》"},"example":{"text":"凡行文多寡短长，抑扬高下，无一定之律，而有一定之妙，可以意会，而不可以言传。","book":"清·刘大櫆《论文偶记》"},"similar":["可以意会，不可言传"],"usage":"作宾语、定语；指只可内心体会"},{"id":10795,"word":"只可智取，不可力敌","pinyin":"zhǐ kě zhì qǔ，bù kě lì dí","abbr":"zkzqbkld","explanation":"敌：抵挡。只能用智谋来取胜，不能凭实力硬拼。","source":{"text":"我和你只两个同心合意，如何敢近傍他？只可智取，不可力敌。","book":"明·施耐庵《水浒全传》第四十二回"},"example":{"text":"我兵少，贼兵多；只可智取，不可力敌，宜出奇兵应之。（明·冯梦龙《喻世明言》卷二十一）"},"usage":"作谓语、定语、宾语；用于处事"},{"id":10796,"word":"只听楼梯响，不见人下来","pinyin":"zhǐ tīng lóu tī xiǎng，bù jiàn rén xià lái","abbr":"ztltxbjrxl","explanation":"比喻只是口头说说，没有实际行动。","example":{"text":"～，别再吹了。"},"similar":["干打雷不下雨"],"usage":"作宾语、分句；指空谈"},{"id":10797,"word":"只字不提","pinyin":"zhī zì bù tí","abbr":"zzbt","explanation":"只：一个。一个字也不谈起。比喻有意不说。","source":{"text":"在这本‘党史’里，李大钊同志的历史功绩不见了，只字不提他是中国共产党的创始人之一。","book":"贾芝《重版后记》"},"example":{"text":"他对此事～。"},"similar":["缄口不言","绝口不提"],"usage":"作谓语；指有意不说"},{"id":10798,"word":"只字片纸","pinyin":"zhī zì piàn zhǐ","abbr":"zzpz","explanation":"不多的几句话，极少的几个字。指零碎的文字材料。","source":{"text":"胡为议论独见假，只字片纸皆收藏。","book":"晋·陆机《谢平原内史表》：“片言只字，不关其间。”宋·苏轼《石苍舒醉墨堂》"}},{"id":10799,"word":"只字片言","pinyin":"zhī zì piàn yán","abbr":"zzpy","explanation":"指零星的文字和很短的话。形容提到的很少。","source":{"text":"只字片言，曾蒙激赏；连谗被谤，备与辨明；察于危难之情，知在明教之地。","book":"五代·王定保《唐摭言·怨怒戆直附》"},"similar":["片言只语","片言只字","片言一字"],"usage":"作宾语、定语；用于书面语"},{"id":10800,"word":"只影单形","pinyin":"zhī yǐng dān xíng","abbr":"zydx","explanation":"只：单独。只有自己的身体和自己的影子。形容孤独，没有同伴。","source":{"text":"又见辛环已死，只影单形。","book":"明·许仲琳《封神演义》第五十二回"},"similar":["只影孤形","只身孤影","形影相吊"],"usage":"作宾语、定语；用于书面语"},{"id":10801,"word":"只影孤形","pinyin":"zhī yǐng gū xíng","abbr":"zygx","explanation":"只：单独。只有自己的身体和自己的影子。形容孤独，没有同伴。","source":{"text":"长念青春易老，尚区区、枯蓬断梗。人间天上，喟然俯仰，只身孤影。","book":"宋·葛长庚《水龙吟》词"},"example":{"text":"～、相印冷池塘。"},"similar":["只影单形","只身孤影","形单影只"],"opposite":["成双成对"],"usage":"作宾语、定语；用于书面语"},{"id":10802,"word":"只手单拳","pinyin":"zhī shǒu dān quán","abbr":"zsdq","explanation":"比喻一个人力量弱小。","source":{"text":"我不在家呵，你是只手单拳，若被人欺压遭人骗，我回来后将他消遣。","book":"明·沈璟《义侠记·委属》"},"similar":["单枪匹马"],"usage":"作宾语、定语；用于书面语"},{"id":10803,"word":"只手擎天","pinyin":"zhī shǒu qíng dān","abbr":"zsqt","explanation":"擎：举。一只手便可把天举起。形容本领很大。","source":{"text":"先生真只手擎天者也。","book":"清·夏敬渠《野叟曝言》第一百十一回"},"usage":"作定语；用于书面语"},{"id":10804,"word":"只手空拳","pinyin":"zhī shǒu kōng quán","abbr":"zskq","explanation":"指单有一双手而没有武器。","source":{"text":"假如有此利器，望那鳞缝中发去，充其力量，可入数寸，使之满身芒刺，着药便烂，虽不能登时剁却，任他负痛而逃，亦终创溃而死。此时只手空拳，如何抵挡。","book":"清·夏敬渠《野叟曝言》第三回"},"similar":["赤手空拳"],"usage":"作宾语、定语；用于书面语"},{"id":10805,"word":"只手遮天","pinyin":"zhī shǒu zhē tiān","abbr":"zszt","explanation":"一只手把天遮住。形容依仗权势，玩弄手段，蒙蔽群众。","source":{"text":"难将一人手，掩得天下目。","book":"唐·曹邺《读李斯传》诗"},"example":{"text":"又说皇上已知道了这件事，终究会水落石出，旁人别想～，瞒过了圣明天子。","book":"金庸《鹿鼎记》第五十回"}},{"id":10806,"word":"只此一家，别无分店","pinyin":"zhǐ cǐ yī jiā，bié wú fēn diàn","abbr":"zcyjbwfd","explanation":"原是一些店铺招揽生意的用语，向顾客表明他没分店，只能在他这一家店里买到某种商品。泛指某种事物独一无二或独自垄断。","source":{"text":"为群众所接受，所实践，而不是闭门造车，自作聪明，只此一家，别无分店的那种贵族式的所谓‘政治家’。","book":"毛泽东《在延安文艺座谈会上的讲话》"},"example":{"text":"～的垄断局面被打破。"},"similar":["独此一家","独一无二"],"usage":"作定语、分句；招揽生意的用语"},{"id":10807,"word":"只知其一，不知其二","pinyin":"zhǐ zhī qí shān，bù zhī qí èr","abbr":"zzqybzqe","explanation":"只知道事物的一方面，而不知道它的另一方面。","source":{"text":"识其一，不知其二；治其内，而不治其外。","book":"《庄子·天地》"},"example":{"text":"八戒道：“哥哥，你～。”","book":"明·吴承恩《西游记》第四十七回"},"similar":["一知半解"],"opposite":["了如指掌"],"usage":"作宾语、定语、分句；指没有全面了解"},{"id":10808,"word":"只知其一，未知其二","pinyin":"zhǐ zhī qí yī，wèi zhī qí èr","abbr":"zzqywzqe","explanation":"形容了解的情况不全面。同“只知其一，不知其二”。","source":{"text":"哈哈，你是只知其一，未知其二。你说，咱们先买地，后盖房呢，还是先盖了房子后买地？","book":"茅盾《霜叶红似二月花》五"},"example":{"text":"我对此事～，你还是问别人吧"},"similar":["知其一，不知其二"],"usage":"作谓语、定语；用于处事等"},{"id":10809,"word":"只知其然，而不知其所以然","pinyin":"zhī zhī qí rán，ér bù zhī qí suǒ yǐ rán","abbr":"zzqrebzqsyr","explanation":"然：这样。只知道是这样，却不知道为什么是这样。形容只了解表面现象，不了解事物的本质或事情的根底。","source":{"text":"自然者，物见其然，不知所以然；同焉皆得，不知所以得。","book":"《庄子·秋水》：“今予动吾天机，而不知其所以然。”南朝·梁·刘孝标《辩命论》"},"example":{"text":"他～，所以没有进步"},"similar":["知其然而不知其所以然"],"usage":"作谓语、宾语；用于书面语"},{"id":10810,"word":"只要功夫深，铁杵磨成针","pinyin":"zhǐ yào gōng fū shēn，tiě chǔ mó chéng zhēn","abbr":"zygfstcmcz","explanation":"杵：舂米或捣衣的棒。谚语。比喻只要有决心，肯下功夫，多么难的事也能做成功。","source":{"text":"宋·祝穆《方舆胜览·眉州·磨针溪》：世传李白读书象耳山中，学业未成，即弃去，“过是溪，逢老媪方磨铁杵，问之，曰：‘欲作针。’太白感其意，还卒业”。"},"example":{"text":"～，经过五年的刻苦努力，他熟练地掌握了英语。"},"similar":["只要工夫深，铁杵磨成针"],"usage":"作宾语、定语、分句；用于劝诫人","story":["唐朝著名诗人李白小时候从不认真读书，经常是把书本一抛就出去玩耍。一天李白碰到一个白发苍苍的老婆婆正拿着一根大铁棒在石头上磨，觉得好奇问她做什么，老婆婆告诉他要磨成绣花针，李白深受感动，从此就用功读书，终于成为文豪"]},{"id":10811,"word":"只要工夫深，铁杵磨成针","pinyin":"zhǐ yào gōng fū shēn，tiě chǔ mó chéng zhēn","abbr":"zygfstcmcz","explanation":"比喻持之以恒，终必有成。功，亦作“工”。同“只要功夫深，铁杵磨成针”。","source":{"text":"‘只要工夫深，铁杵磨成针。’你是个能下功夫的人，有肯动脑筋，自然都能干出个眉目来。","book":"程树榛《大学时代》第二十五章"},"similar":["只要功夫深，铁杵磨成针"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":10812,"word":"只见树木，不见森林","pinyin":"zhǐ jiàn shù mù，bù jiàn sēn lín","abbr":"zjsmbjsl","explanation":"比喻只看到局部，看不到整体或全部。","source":{"text":"这就叫作片面地看问题。或者叫做只看见局部，不看见全体，只看见树木，不看见森林。","book":"毛泽东《矛盾论·矛盾的特殊性》"},"example":{"text":"一种是认识停止在现象的表面～，不善于区别本质与现象，主流与支流。","book":"王朝闻《论凤姐》第九章"},"similar":["一叶障目","目光短浅"],"usage":"作谓语、定语、分句；指眼光短浅"},{"id":10813,"word":"只言片语","pinyin":"zhī yán piàn yǔ","abbr":"zypy","explanation":"个别词句或片断的话。","source":{"text":"其中或者有只言片语可采，敬烦删定。","book":"高阳《胭脂井》"},"example":{"text":"你的～对我也是一种安慰。"},"similar":["只字片言"],"usage":"作主语、宾语、定语；指很少的话"},{"id":10814,"word":"只许州官放火，不许百姓点灯","pinyin":"zhǐ xǔ zhōu guān fàng huǒ，bù xǔ bǎi xìng diǎn dēng","abbr":"zxzgfhbxbxdd","explanation":"指反动统治者自己可以胡作非为，老百姓却连正当活动也要受到限制。","source":{"text":"田登作郡，自讳其名，触者必怒，吏卒多被榜笞。于是举州皆谓灯为火。上元放灯许人入州治游观，吏人遂书榜揭于市曰：‘本州依例放火三日。’","book":"宋·陆游《老学庵笔记》卷五"},"example":{"text":"可是你“～”。我们偶说一句妨碍的话，你就说不吉利。","book":"清·曹雪芹《红楼梦》第七十七回"},"similar":["肆意妄为"],"usage":"作宾语、分句；指肆意妄为","story":["北宋时期，州太守田登为人专制蛮横，因他名“登”，下令州内百姓不许说任何一个与“登”字同音的字，否则治罪。元宵节照惯例要放焰火点三天灯，出告示的官员只好写成“本州依例放火三日”，外地人纷纷离开这个是非之地"]},{"id":10815,"word":"只词褒贬","pinyin":"zhī cí bāo biǎn","abbr":"zcbb","explanation":"褒：赞扬，夸奖；贬：给予不好的评价。一个字的褒扬或贬斥。泛指记事论人，用字措辞严谨有分寸。","source":{"text":"春秋虽以一字为褒贬，然皆须数句以成言。","book":"晋·杜预《春秋经传集解·序》"}},{"id":10816,"word":"只谈风月","pinyin":"zhǐ tán fēng yuè","abbr":"ztfy","explanation":"只谈风、月等景物。隐指莫谈国事。","source":{"text":"今昔止可谈风月，不宜及公事。","book":"《南史·徐勉传》"},"example":{"text":"喜作闲人，酒席间～。明·张岱《游山小启》"},"similar":["止谈风月"],"usage":"作谓语、定语；指不谈政事"},{"id":10817,"word":"只身孤影","pinyin":"zhī shēn gū yǐng","abbr":"zsgy","explanation":"只：单独的。指孤单一人。亦作“只影孤形”、“只影单形”。","source":{"text":"长念青春易老，尚区区、枯蓬断梗。人间天上，喟然俯仰，只身孤影。","book":"宋·葛长庚《水龙吟》词"},"example":{"text":"一个十八岁的孩子，～，流落异乡，在父亲实在不能放心。","book":"冯玉祥《我的生活》第四章"},"similar":["形单影只","只影孤形","只影单形"],"opposite":["成双成对"],"usage":"作宾语、定语；用于书面语"},{"id":10818,"word":"只轮不反","pinyin":"zhī lún bù fǎn","abbr":"zlbf","explanation":"比喻全军覆没。同“只轮无反”。","source":{"text":"必剪元雄，悬首麾下，乃将只轮不反，战轊无旋矣。","book":"晋·潘岳《西征赋》：“曾只轮之不反，绁三帅而济河。”南朝梁·沈约《宋书·袁淑传》"},"example":{"text":"其崔暹～，臣崇与臣逡巡复路。","book":"北齐·魏收《魏书·太武五王传》"},"similar":["只轮无反","只轮不返","只骑不反"],"usage":"作谓语、定语；指彻底失败"},{"id":10819,"word":"只轮不返","pinyin":"zhī lún bù fǎn","abbr":"zlbf","explanation":"只：一个。连战车的一只轮子都未能返回。比喻全军覆没。","source":{"text":"然而晋人与姜戎要之殽而击之，匹马只轮无反者。","book":"《公羊传·僖公三十三年》"},"example":{"text":"兵贵神速，今夜分四路去劫大寨，杀得他～。","book":"清·陈忱《水浒后传》第七回"},"similar":["只轮不反"],"usage":"作谓语、定语；指彻底失败"},{"id":10820,"word":"只轮无反","pinyin":"zhī lún wú fǎn","abbr":"zlwf","explanation":"连战车的一只轮子都未能返回。比喻全军覆没。","source":{"text":"然而晋人与姜戎要之殽而击之，匹马只轮无反者。","book":"《公羊传·僖公三十三年》"},"example":{"text":"今日不是某夸口自荐，若用某为将，必使齐兵只轮不返。","book":"明·冯梦龙《东周列国志》第八十六回"},"similar":["只轮不返"],"usage":"作谓语、定语；指彻底失败"},{"id":10821,"word":"只轮莫返","pinyin":"zhī lún mò fǎn","abbr":"zlmf","explanation":"只：一个。连战车的一只轮子都未能返回。比喻全军覆没。","source":{"text":"《公羊传·僖公三十三年》：“然而晋人与姜戎要之殽而击之，匹马只轮无反者。”唐·祖君彦《为李密檄洛州文》遂令亿兆夷人，只轮莫返。"},"example":{"text":"韩山之役，女妓自随，才闻敌鼓，与妾俱逝，不待贞阳，故～。（蔡东藩《南北史演义》第六十回）"},"similar":["只轮不反","只轮无反"],"opposite":["大获全胜"],"usage":"作谓语、定语；指彻底失败"},{"id":10822,"word":"只重衣衫不重人","pinyin":"zhǐ zhòng yī shān bù zhòng rén","abbr":"zzysbzr","explanation":"指人势力，看人只重衣着。","source":{"text":"五陵公子争夸富，百衲老僧不厌贫，近来世俗多颠倒，只重衣衫不重人。","book":"宋·释普济《五灯会元·黄龙心禅师法嗣》"},"example":{"text":"～的做法是行不通的。"},"similar":["以貌取人"],"usage":"作谓语、定语；指以貌取人"},{"id":10823,"word":"只骑不反","pinyin":"zhī qí bù fǎn","abbr":"zqbf","explanation":"比喻全军覆没。同“只轮不反”。","source":{"text":"只骑不反，踦轮无匹。","book":"南朝·梁·江淹《齐太祖高皇帝诔》"},"example":{"text":"敌人被我军打得～"},"similar":["只轮不反","只轮莫返","只轮无反"],"usage":"作定语、状语；指彻底失败"},{"id":10824,"word":"只鳞片甲","pinyin":"zhī lín piàn jiǎ","abbr":"zlpj","explanation":"鳞：鱼鳞；甲：甲壳。一片鳞，一片甲。比喻极少的一部分。","source":{"text":"这里的三篇信札体的论文，便是他的这类著作的只鳞片甲。","book":"鲁迅《译本序》"},"example":{"text":"这里的三篇信札体的论文，便是他的这类著作的～。（鲁迅《二心集·〈艺术论〉译本序》）"},"similar":["一鳞一爪","一鳞半爪"],"usage":"作宾语、定语；指残缺不全"},{"id":10825,"word":"只鸡斗酒","pinyin":"zhī jī dǒu jiǔ","abbr":"zjdj","explanation":"斗：酒器。准备好一只鸡，一壶酒。原指对死者的祭奠物品，多用作追悼亡友之辞。后也指招待来客。","source":{"text":"殂逝之后，路有经由，不以斗酒只鸡过相沃酹，车过三步，腹痛勿怪。","book":"汉·曹操《祀故太尉桥玄文》"},"example":{"text":"既然肯来赴约呵，您兄弟～，等待我的哥哥也。","book":"元·宫大用《范张鸡黍》楔子"},"similar":["斗酒只鸡"],"usage":"作宾语；指作为追悼亡友的话"},{"id":10826,"word":"只鸡樽酒","pinyin":"zhī jī zūn jiǔ","abbr":"zjzj","explanation":"指简单的酒菜。同“只鸡斗酒”。","source":{"text":"此非人情，只鸡樽酒，山中未为乏也。","book":"宋·叶绍翁《四朝闻见录·胡紘李沐》"},"similar":["斗酒只鸡"],"usage":"作宾语、定语；指作为追悼亡友的话"},{"id":10827,"word":"只鸡絮酒","pinyin":"zhī jī xù jiǔ","abbr":"zjxj","explanation":"指悼念故人，祭品菲薄。","source":{"text":"稚尝为太尉黄琼所辟，不就。及琼卒归葬，稚乃负粮徒步到江夏赴之，设鸡酒薄祭，哭毕而去。不告姓名。","book":"南朝·宋·范晔《后汉书·徐稚传》"},"example":{"text":"以～酬韵香，韵香必含笑于九泉。","book":"清·无名氏《帝城花样·韵香传》"},"similar":["炙鸡絮酒"],"usage":"作宾语、定语；指悼念故人","story":["汉朝时期，徐稚受太尉黄琼所荐而当官，后来离职。黄琼病故归葬故乡，徐稚则在家里烧烤一只鸡，用一两棉絮渍酒后晒干裹住鸡，背上干粮到黄琼的家乡江夏去拜祭。在黄琼的坟前，他用水渍棉出酒，拜祭完毕就回家"]},{"id":10828,"word":"只鸾单凤","pinyin":"zhī luán dān fèng","abbr":"zldf","explanation":"鸾：传说中凤凰一类的鸟。孤单单的一只凤凰。","source":{"text":"他年不骑鹤，何日可登鳌，今夜恰乘龙。说甚的只鸾单凤，天与配雌雄。","book":"元·王子一《误入桃源》第二折"},"similar":["只凤孤凰"],"usage":"作宾语、定语；用于书面语"},{"id":10829,"word":"叫化子","pinyin":"jiào huā zǐ","abbr":"jhz","explanation":"乞丐。","source":{"text":"管他有衣服没衣服，比要饭的叫化子总强点，就算那间厨房旁边的小房子，也怪暖和的，没有什么不可以的。","book":"清·刘鹗《老残游记续集遗稿》第四回"},"example":{"text":"自觉没趣丢脸，像赶在洋车后面的～，跑了好些路，没讨到手一个小钱，要停下来却又不甘心。","book":"钱钟书《围城》"},"similar":["叫花子"],"usage":"作主语、宾语、定语；用于口语"},{"id":10830,"word":"叫叫嚷嚷","pinyin":"jiào jiào rǎng rǎng","abbr":"jjrr","explanation":"大叫大嚷，吵吵闹闹。","source":{"text":"他们把碗筷敲得震天价响，踏泥带水、叫叫嚷嚷地跑过院坝，向南面总务处那一排窑洞的墙根下蜂拥而去。","book":"路遥《平凡的世界》第一卷第一章"},"example":{"text":"我娘和家珍～地把他扶起来，扶到他自己的床上。","book":"余华《活着》"},"similar":["大叫大嚷","吵吵闹闹"],"usage":"作定语、状语；用于口语"},{"id":10831,"word":"叫苦不迭","pinyin":"jiào kǔ bù dié","abbr":"jkbd","explanation":"不迭：不停止。形容连声叫苦。","source":{"text":"徽宗叫苦不迭，向外榻上忽然惊觉来，吓得浑身冷汗。","book":"宋·无名氏《大宋宣和遗事》享集"},"example":{"text":"只见靠壁一个蓬头孩子，曲着身子，睡得好不自在，夫人暗暗～。","book":"明·冯梦龙《醒世恒言》卷二十八"},"similar":["叫苦连天","长吁短叹"],"opposite":["眉开眼笑","乐不可支"],"usage":"作谓语、定语；用于突然陷入困境时"},{"id":10832,"word":"叫苦连天","pinyin":"jiào kǔ lián tiān","abbr":"jklt","explanation":"不住地叫苦。形容十分痛苦。","source":{"text":"你怎么正战到好处，却就叫苦连天的走了？","book":"明·吴承恩《西游记》第五十五回"},"example":{"text":"今番受了轮船火车上下劳顿，早害得他～。","book":"清·李宝嘉《官场现形记》第三十五回"},"similar":["叫苦不迭","长吁短叹"],"opposite":["眉开眼笑","乐不可支","喜出望外"],"usage":"作谓语、宾语；用于陷于困境或极为痛苦"},{"id":10833,"word":"召之即来","pinyin":"zhào zhī jí lái","abbr":"zzjl","explanation":"召：同“招”。一经召唤立即就来。形容唯命是从。","source":{"text":"麾之即去，招亦须来。","book":"宋·辛弃疾《沁园春》"},"example":{"text":"我不想你成为～的人。"},"similar":["召之即来，挥之即去"],"usage":"作谓语、定语；指唯命是从"},{"id":10834,"word":"召之即来，挥之即去","pinyin":"zhào zhī jí lái，huī zhī jí qù","abbr":"zzjlhzjq","explanation":"召：召唤。挥：摆手。手一召就来，手一摆就去。形容非常听从指挥。","source":{"text":"无关紧要的人物一律招之即来，挥之即去，毫不客气。","book":"老舍《老舍自传》第六章第五节"},"example":{"text":"我们保证召之即来，挥之即去，绝对服从指挥。"},"similar":["招之即来，挥之即去"],"usage":"作宾语、定语；用于书面语"},{"id":10835,"word":"召父杜母","pinyin":"shào fù dù mǔ","abbr":"zfdm","explanation":"西汉召信臣和东汉杜诗，先后为南阳太守，二人都有善政。颂扬地方长官政绩的套语。","source":{"text":"《东观汉记》卷十五；《后汉书·杜诗传》"},"usage":"作主语、宾语、定语；用于称赞地方官","story":["西汉时期的南阳太守召信臣和东汉时期的南阳太守杜诗，这两人在担任南阳太守期间都能为民兴利，开凿水利沟渠，开垦荒地与坡地，广拓耕田，注重农业的发展，深受老百姓的爱戴，被老百姓称为“前有召父，后有杜母。”"]},{"id":10836,"word":"召神弄鬼","pinyin":"zhào shén nòng guǐ","abbr":"zsng","explanation":"召唤或迫使精灵或魔鬼等出现或服从自己。","example":{"text":"他好用～去吓唬别人。"},"similar":["装神弄鬼"],"usage":"作谓语、宾语；指装神弄鬼去吓唬别人"},{"id":10837,"word":"叮叮当当","pinyin":"dīng dīng dāng dāng","abbr":"dddd","explanation":"形容金属、瓷器等撞击的声音。","source":{"text":"一回儿，檐下的铁马也只管叮叮当当的乱敲起来。一时雪雁先吃完了，进来伺候。","book":"清·曹雪芹《红楼梦》第87回"},"example":{"text":"清·曹雪芹《红楼梦》第87回：“一回儿，檐下的铁马也只管～的乱敲起来。一时雪雁先吃完了，进来伺候。”"},"usage":"作定语、状语；用于象声"},{"id":10838,"word":"可一而不可再","pinyin":"kě yī ér bù kě zài","abbr":"kyebkz","explanation":"只可做一次而不可再做。","source":{"text":"劝借可暂而不可常，可一而不可再。","book":"明·归有光《昆山县倭寇始末记》"},"example":{"text":"事体～，往后相这等的状，姐姐千万不可再告。","book":"清·西周生《醒世姻缘传》第八十九回"},"usage":"作谓语、定语；用于处事"},{"id":10839,"word":"可丁可卯","pinyin":"kě dīng kě mǎo","abbr":"kdkm","explanation":"恰好，不多不少，程度正适合。","example":{"text":"要做到～的程度并不难。"},"usage":"作谓语、定语、状语；用于口语"},{"id":10840,"word":"可乘之机","pinyin":"kě chéng zhī jī","abbr":"kczj","explanation":"可以利用的时机。","source":{"text":"宜缮甲养锐，劝课农殖，待可乘之机，然后一举荡灭。","book":"《晋书·吕纂传》"},"example":{"text":"按宋南渡后亦未尝无～。","book":"清·赵翼《二十四史札记·卷二十六·和议》"},"similar":["待机而动","机不可失","时不再来"],"opposite":["无隙可乘"],"usage":"作宾语；指可以利用的机会"},{"id":10841,"word":"可乘之隙","pinyin":"kě chéng zhī xì","abbr":"kczx","explanation":"隙：空子，机会。可以被对方利用的弱点、空隙。","source":{"text":"当是时，皆有可乘之隙，而中国不可取。","book":"宋·晁补之《鸡肋集》"},"example":{"text":"小沛原非久居之地。今徐州既有～，失此不取，悔之晚矣。","book":"明·罗贯中《三国演义》第十四回"},"similar":["可乘之机","机不可失"],"usage":"作宾语；指可以利用的机会"},{"id":10842,"word":"可人风味","pinyin":"kě rén fēng wèi","abbr":"krfw","explanation":"可：适合。令人满意而又有特色的风光或事物。","source":{"text":"往事输他范蠡。泛扁舟、仍携佳丽。毫端幻出，淡妆浓抹，可人风味。","book":"宋·杨无咎《水龙吟·赵祖文画西湖图，名曰总相宜》词"},"example":{"text":"～撩诗兴，不记姚家宫样黄。","book":"谢薖《山间》"}},{"id":10843,"word":"可以意会，不可言传","pinyin":"kě yǐ yì huì，bù kě yán chuán","abbr":"kyyhbkyc","explanation":"只能用心去揣摩体会，没法用话具体地表达出来。指道理奥妙，难以说明。有时也指情况微妙，不便说明。","source":{"text":"意之所随者，不可以言传也。","book":"《庄子·天运》"},"example":{"text":"这些事～，要说，一时亦说不了许多。","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["只可意会，不可言传"],"usage":"作宾语、定语；指只可内心体会"},{"id":10844,"word":"可发一噱","pinyin":"kě fā yī jué","abbr":"kfyj","explanation":"真引人发笑。","example":{"text":"这个故事～。"},"usage":"作谓语；指引人发笑"},{"id":10845,"word":"可同患，难处安","pinyin":"kě tóng huàn，nán chǔ ān","abbr":"kthnca","explanation":"患：患难；处：相处；安：安乐。在危险时可以同忧患，在安乐时却无法同享受。形容忘恩负义，刻薄寡情。","source":{"text":"且勾践为人，可与同患，难与处安。","book":"《史记·越王勾践世家》"},"usage":"作谓语、定语；用于为人"},{"id":10846,"word":"可喜可愕","pinyin":"kě xǐ kě è","abbr":"kxke","explanation":"喜：欢喜；愕：惊讶。又欢喜又惊讶。","source":{"text":"推画者之意，岂以佛氏之作止语默皆与人同，而世之学佛者徒求卓诡变幻可喜可愕之迹，故为此图以警发之与？","book":"明·黄淳耀《李龙眼画罗汉记》"},"example":{"text":"春抌机杼，鸡犬之鸣吠，远近断续，随风高下，一切～之音，咸会于溪。","book":"清·朱仕琇《〈溪音〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":10847,"word":"可喜可贺","pinyin":"kě xǐ kě hè","abbr":"kxkh","explanation":"值得欢喜与庆贺的","source":{"text":"所以此番厄运，倒不是你的不幸，简直是一件可喜可贺的事情咧。","book":"清·无垢道人《八仙全传》第26回"},"usage":"作谓语、定语；用于口语"},{"id":10848,"word":"可圈可点","pinyin":"kě quān kě diǎn","abbr":"kqkd","explanation":"原指文章中有精妙的句子，值得欣赏和赞美。现广泛用来称赞一切出色、精彩、值得称道的事物。","usage":"多用于褒义。"},{"id":10849,"word":"可心如意","pinyin":"kě xīn rú yì","abbr":"kxry","explanation":"符合心意。","source":{"text":"称心如意，剩活人间几岁？","book":"宋·朱敦儒《感皇恩》词"},"example":{"text":"这如今要办正事，不是我女孩儿没羞耻，必得我拣个素日～的人，才跟他。","book":"清·曹雪芹《红楼梦》第六十五回"},"similar":["称心如意"],"usage":"作定语、宾语、补语；指符合心意"},{"id":10850,"word":"可怜巴巴","pinyin":"kě lián bā bā","abbr":"klbb","explanation":"非常令人可怜的样子。","source":{"text":"这样说，他这个杂货店也可怜巴巴的。","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"看到他～的样子，我的怒火也就灭了。"},"similar":["可怜兮兮"],"usage":"作定语、状语；指可怜的样子"},{"id":10851,"word":"可惊可愕","pinyin":"kě jīng kě è","abbr":"kjke","explanation":"惊、愕：惊讶。形容非常惊讶。","source":{"text":"其所见山奔海立，沙起雷行，雨鸣树偃，幽谷大都，人物鱼鸟，一切可惊可愕之状，皆一一达之于诗。","book":"明·袁宏道《徐文长传》"},"example":{"text":"日本自明治变法，三十年来进步之速，～。弟的这书也不过断烂朝报，一篇陈帐，不适用的了。","book":"清·曾朴《孽海花》第十八回"}},{"id":10852,"word":"可想而知","pinyin":"kě xiǎng ér zhī","abbr":"kxez","explanation":"不用说明就能想象得到。","source":{"text":"而郊以吟诗废务，上官差官以摄其职，分其半禄，酸寒之壮，可想而知。","book":"宋·王楙《野客丛书》"},"example":{"text":"你想日本人练陆军把东三省地图当作功课，其用心～。","book":"清·高鹗《老残游记续集》第一回"},"similar":["不言而喻"],"opposite":["不可思议"],"usage":"作谓语、宾语、补语、状语；用于推测想象等"},{"id":10853,"word":"可操左券","pinyin":"kě cāo zuǒ quàn","abbr":"kczq","explanation":"操：掌握；左券：古代契约分为左右两联，双方各执其一，左券即左联，常用为索偿的凭证。比喻成功有把握。","source":{"text":"公常执左券以责于秦韩。","book":"西汉·司马迁《史记·田敬仲完世家》"},"example":{"text":"人生为农最可愿，得饱正如执左券。","book":"宋·陆游《剑南诗稿·禽言》"},"similar":["胜利在望"],"usage":"作谓语；指取胜"},{"id":10854,"word":"可有可无","pinyin":"kě yǒu kě wú","abbr":"kykw","explanation":"可以有，也可以没有。指有没有都无关紧要。","source":{"text":"因此把一切都看成浊物，可有可无。","book":"清·曹雪芹《红楼梦》第二十回"},"example":{"text":"她活了五十年，第一次感觉到自己还不是一个～的人。","book":"茹志娟《如愿》"},"similar":["无足轻重"],"opposite":["举足轻重"],"usage":"作定语；形容事物无足轻重"},{"id":10855,"word":"可望不可即","pinyin":"kě wàng bù kě jí","abbr":"kwbkj","explanation":"即：接近。能望见，但达不到或不能接近。常比喻目前还不能实现的事物。","source":{"text":"白云在青天，可望不可即。","book":"唐·宋之问《明河篇》：“明河可望不可亲，愿得乘槎一问津。”明·刘基《登卧龙山写怀二十八韵》"},"example":{"text":"所以虽是牛鬼蛇神的妓女，他见了就如海上神仙一般，～的了。","book":"清·吴趼人《二十年目睹之怪现状》第九十八回"},"similar":["望尘莫及"],"opposite":["垂手可得","力所能及"],"usage":"作定语、宾语；指事情还很难实现"},{"id":10856,"word":"可望不可及","pinyin":"kě wàng bù kě jí","abbr":"kwbkj","explanation":"及：接近。指只可仰望而不可接近。","source":{"text":"锦绣之地远去，虽历历在目可望不可及。","book":"王朔《橡皮人》"},"example":{"text":"面对这～的尤物，他的心动了。"},"similar":["可望不可即"],"usage":"作谓语、定语、分句；指达不到"},{"id":10857,"word":"可望而不可即","pinyin":"kě wàng ér bù kě jí","abbr":"kwebkj","explanation":"即：接近。能望见，但达不到或不能接近。常比喻目前还不能实现的事物。","source":{"text":"白云在青天，可望不可即。","book":"唐·宋之问《明河篇》：“明河可望不可亲，愿得乘槎一问津。”明·刘基《登卧龙山写怀二十八韵》"},"example":{"text":"视吾贞昉，则若威风之翔千仞，～，得与失又为何如哉。","book":"明·宋濂《危孝子传》"},"similar":["可望而不可及","可望不可即"],"usage":"作谓语、定语；指不能实现的事"},{"id":10858,"word":"可望而不可及","pinyin":"kě wàng ér bù kě jí","abbr":"kwebkj","explanation":"指只可仰望而不可接近。","source":{"text":"可望而不可及的古之人，你们的鼓声透过了几千万重的黑幕，传达到我耳里来了！","book":"郭沫若《月蚀》"},"example":{"text":"我们不想那些～的事情。"},"similar":["可望不可即"],"usage":"作谓语、定语、分句；指达不到"},{"id":10859,"word":"可杀不可辱","pinyin":"kě shā bù kě rǔ","abbr":"ksbkr","explanation":"辱：侮辱。可以牺牲生命但不可遭受侮辱。形容做人的尊严。","source":{"text":"儒有可亲而不可却，可近而不可迫，可杀而不可辱。","book":"《孔子家语·儒行解》"},"example":{"text":"即此我便随汝前往，但我英雄旨趣，～。","book":"清·华伟生《开国奇冤·被擒》"},"usage":"作谓语、定语；用于人的处世"},{"id":10860,"word":"可歌可泣","pinyin":"kě gē kě qì","abbr":"kgkq","explanation":"泣：不出声地流泪。值得歌颂、赞美，使人感动流泪。形容英勇悲壮的感人事迹。","source":{"text":"国初方列之概，无异平原复生。追念及之，可歌可泣。","book":"《周易·中孚》：“得敌，或鼓或罢，或泣或歌。”  明·海瑞《方孝孺临麻姑仙坛记跋》"},"example":{"text":"《长恨歌》一篇，有声有色，～。","book":"清·赵翼《瓯北诗话》卷四"},"similar":["悲喜交集"],"opposite":["歌功颂德"],"usage":"作谓语、定语；指英勇的感人事迹"},{"id":10861,"word":"可歌可涕","pinyin":"kě gē kě tì","abbr":"kgkt","explanation":"可：值得；歌：歌颂，赞扬。值得歌颂赞美并使人感动流泪。形容英勇悲壮的感人事迹。","source":{"text":"幸得追随其步趋，而相与上下往复其议论，无不动心骇魄，可歌可涕。","book":"清·汪琬《计甫草序》"},"similar":["可歌可泣","可泣可歌"],"usage":"作谓语、定语；指英勇的感人事迹"},{"id":10862,"word":"可泣可歌","pinyin":"kě qì kě gē","abbr":"kqkg","explanation":"形容英勇悲壮的感人事迹。同“可歌可泣”。","source":{"text":"见案上有见赐于书，哭似村诸绝，情文双至，可泣可歌。","book":"清·袁枚《小仓山房尺牍》第170首"},"example":{"text":"夏衍《心防》第二幕：“说起来实在是～。”"},"similar":["可歌可泣","可歌可涕"],"usage":"作谓语、定语；指英勇的感人事迹"},{"id":10863,"word":"可见一斑","pinyin":"kě jiàn yī bān","abbr":"kjyb","explanation":"斑：杂色的花纹或斑点。比喻见到事物的一少部分也能推知事物的整体。","source":{"text":"此郎亦管中窥豹，时见一斑。","book":"南朝·宋·刘义庆《世说新语·方正》"},"example":{"text":"以酗酒狎妓之微嫌，遂没其困苦艰难之功业，清朝之赏罚不均，～。","book":"《清朝野史大观》"},"similar":["管窥一斑","管中窥豹"],"usage":"作谓语；指可以看到事物的一部分"},{"id":10864,"word":"可遇难求","pinyin":"kě yù nán qiú","abbr":"kynq","explanation":"可以偶然遇到但刻意难以办到或得到的机会或事情","source":{"text":"那真是千载难逢、可遇难求的机会。","book":"清·无垢道人《八仙全传》第二回"},"similar":["可遇不可求"],"usage":"作谓语、定语；用于口语"},{"id":10865,"word":"台柱子","pinyin":"tái zhù zǐ","abbr":"tzz","explanation":"剧团里的主要舞台表演演员，比喻集体中挑大梁的人。","source":{"text":"而且在将来的抗日政府和抗日军队中必然要成为坚强的台柱子，使日本……的拆台政策，不能达到最后的目的。","book":"毛泽东《论反对日本帝国主义的策略》"},"example":{"text":"他是我们单位的～。"},"usage":"作主语、宾语、定语；指主要人物"},{"id":10866,"word":"台阁生风","pinyin":"tái gé shēng fēng","abbr":"tgsf","explanation":"台阁：东汉尚书的办公室。泛指官府大臣在台阁中严肃的风气。比喻官风清廉。","source":{"text":"每有奏劾，或值日暮，捧白简，整簪带，竦踊不寐，坐而待旦。于是贵游慑伏，台阁生风。","book":"《晋书·傅玄传》"},"usage":"作谓语；指官风正"},{"id":10867,"word":"叱咤喑呜","pinyin":"chì zhà yìn wū","abbr":"czyw","explanation":"喑呜：怒声呼喝。形容气势壮盛。","source":{"text":"世间岂无一好汉，叱咤喑呜气吞虏。","book":"宋·陆游《雨夜不寐观壁间所张魏郑公砥柱铭》"},"usage":"作谓语、状语；用于气势等"},{"id":10868,"word":"叱咤风云","pinyin":"chì zhà fēng yún","abbr":"czfy","explanation":"叱咤：怒喝声。一声呼喊、怒喝，可以使风云翻腾起来。形容威力极大。","source":{"text":"叱咤则风云兴起，鼓动则嵩华倒拔。","book":"《梁书·元帝纪》"},"example":{"text":"因此，一变而为欺人与自欺，而应当～的武士都变成了小丑。","book":"老舍《四世同堂》九"},"similar":["气壮山河","气势磅礴"],"opposite":["心平气和"],"usage":"作宾语、定语；形容有重大影响力的人","story":["武则天14岁入宫成为唐太宗的才人，太宗死，高宗李治立她为皇后。中宗李显即位后，武则天临朝参政，后来废中宗、睿宗，自己登基，改国号周。李敬业等率军讨伐武则天，请骆宾王写《讨武檄文》：“暗呜则山岳崩颓，叱咤则风云变经”"]},{"id":10869,"word":"叱嗟风云","pinyin":"chì jiē fēng yún","abbr":"cjfy","explanation":"形容声势、威力极大。","source":{"text":"五季之乱，方酣于兵。叱嗟风云，卓乎人英。","book":"宋·陆游《锺离真人赞》"},"similar":["叱咤风云"],"usage":"作宾语、定语；多指将帅或左右世局者"},{"id":10870,"word":"叱石成羊","pinyin":"chì shí chéng yáng","abbr":"cscy","explanation":"叱：呼喊。一声呼喊能把石头变成许多只羊。形容法力神奇。","source":{"text":"兄问：‘羊安在？’曰：‘近在山东耳。’初起往视之不见。但见白石而还。初平与初起俱往看之，初平乃叱曰：‘羊起。’于是石皆成羊。","book":"晋·葛洪《神仙传·黄初平》"},"example":{"text":"神仙～只是骗局而已。"},"usage":"作宾语、定语；指神奇的事情","story":["传说黄初平14岁那年去山上放羊，遇到一位道士，道士把他领到金华山的石屋里传授一些神奇的本事，一晃就是40年，他的哥哥黄初起找到他，问他放的羊哪里去了，黄初平说在东山，兄长一看全是石头，黄初平叱石成羊，顿时就有几万只羊"]},{"id":10871,"word":"史不绝书","pinyin":"shǐ bù jué shū","abbr":"sbjs","explanation":"书：指记载。史书上不断有记载。过去经常发生这样的事情。","source":{"text":"鲁之于晋也，职贡不乏，玩好时至，公卿大夫相继于朝，史不绝书。","book":"《左传·襄公二十九年》"},"example":{"text":"子弑父，父杀子，兄弟互相残杀，～。","book":"姚雪垠《李自成》第一卷第十七章"},"opposite":["史无前例"],"usage":"作谓语、分句；指历史上经常发生这样"},{"id":10872,"word":"史争旦夕","pinyin":"zhǐ zhēng dàn xī","abbr":"szdx","explanation":"旦夕：早晨和晚上。形容时间短暂。比喻抓紧时间，力争在最短的时间内达到目的。","source":{"text":"今朝宠命来首锡，掌枢衡只争旦夕。","book":"明·徐复祚《投梭记·却说》"}},{"id":10873,"word":"史无前例","pinyin":"shǐ wú qián lì","abbr":"swql","explanation":"历史上从来没有过的事。指前所未有。","source":{"text":"牢落文章第一人，天门垂翅竟何因？百年记注无前例，万事枢机有要津。","book":"清·丘逢甲《岭云海日楼诗钞》卷十二"},"example":{"text":"现在的贫富悬殊是～；现在的享用娱乐也是～的。（朱自清《论且顾眼前》）"},"similar":["前所未有","空前绝后"],"opposite":["接连不断"],"usage":"作谓语、定语；用于重大事情"},{"id":10874,"word":"史策丹心","pinyin":"shǐ cè dān xīn","abbr":"scdx","explanation":"宁死不屈的民族气节。","source":{"text":"人士自古谁无死，留取丹心照汗青。","book":"元·脱脱《宋史·文天祥传》"},"usage":"作宾语、定语；指人的气节","story":["南宋末年，文天祥抗元兵败被俘，被押往潮阳郡蒙军元帅张弘范处。张弘范希望他投降，同时让他写信给张世杰大将也投降。文天祥言辞拒绝，当即作诗：“惶恐滩头说惶恐，零丁洋里叹零丁。人士自古谁无死，留取丹心照汗青。”"]},{"id":10875,"word":"史鱼之俦","pinyin":"shǐ yú zhī chóu","abbr":"syzc","explanation":"史鱼：春秋时卫国大夫，以直谏著名；俦：同伴。像史鱼一样正直。常用于形容刚直的人。","source":{"text":"忠直不同，则史鱼之俦；清俭守约，则季文之匹。","book":"《三国志·魏志·崔林传》"}},{"id":10876,"word":"史鱼历节","pinyin":"shǐ yú lì jié","abbr":"sylj","explanation":"史鱼：春秋时卫国大夫，以直谏著名；历：指历尽；节：节操。史鱼历尽节操。形容人保持节操，坚持正义而忠贞不渝。","source":{"text":"孟轲敦素，史鱼秉直。","book":"《论语·卫灵公》：“直哉史鱼！邦有道，如矢；邦无道，如矢。”南朝·梁·周兴嗣《千字文》"},"example":{"text":"～，殆无以过也。","book":"明·罗贯中《三国演义》第二十三回"},"usage":"作宾语、定语；用于为人"},{"id":10877,"word":"史鱼秉直","pinyin":"shǐ yú bǐng zhí","abbr":"sybz","explanation":"史鱼：春秋时卫国大夫，以直谏著名；秉：秉性；直：正直。史鱼秉性正直。形容人秉性刚直不阿。","source":{"text":"孟轲敦素，史鱼秉直。","book":"《论语·卫灵公》：“直哉史鱼！邦有道，如矢；邦无道，如矢。”南朝·梁·周兴嗣《千字文》"},"example":{"text":"天呵，非是俺“求古寻论”，恰正是“～”。","book":"明·汤显祖《牡丹亭》第十七出"},"usage":"作宾语、定语；用于为人"},{"id":10878,"word":"右传之八章","pinyin":"yòu chuán zhī bā zhāng","abbr":"yczbz","explanation":"打了一顿巴掌。","source":{"text":"左右照管贻安骄傲之脸，放肆之嘴，打了十个‘右传之八章’。","book":"清·李绿园《歧路灯》第64回"},"usage":"作宾语；指挨打"},{"id":10879,"word":"右军习气","pinyin":"yòu jūn xí qì","abbr":"yjxq","explanation":"右军：晋著名书法家王羲之，曾任右军将军，世称王右军。比喻一味摹拟古人，不能自创一格。","source":{"text":"既脱天腕，仍养于心，方无右军习气。","book":"清·宋曹《书法约言》"},"usage":"作宾语、定语；指没有自己的风格"},{"id":10880,"word":"右剪左屠","pinyin":"yòu jiǎn zuǒ tú","abbr":"yjzt","explanation":"右边用剪子剪，左边用刀砍。形容纵横刺杀。","source":{"text":"右剪左屠，聿禽其良。","book":"唐·柳宗元《平淮夷雅二篇》"}},{"id":10881,"word":"右手持酒杯，左手持蟹螯","pinyin":"yòu shǒu chí jiǔ bēi，zuǒ shǒu chí xiè áo","abbr":"yscjbzscxa","explanation":"既有美酒，又有佳肴。形容心满意足的样子。","source":{"text":"得酒满数百斛船，四时甘味置两头，右手持酒杯，左手持蟹螯，拍浮酒船中，便足了一生矣。","book":"《晋书·毕卓传》"},"example":{"text":"因释毕缚，毕尝谓～，便足了过一生。","book":"蔡东藩《两晋演义》第十回"}},{"id":10882,"word":"右手画圆，左手画方","pinyin":"yòu shǒu huà yuán，zuǒ shǒu huà fāng","abbr":"yshyzshf","explanation":"比喻用心不专，什么事也办不成。也形容心思聪明，动作敏捷。","source":{"text":"右手画圆，左手画方，不能两成。","book":"《韩非子·功名》"},"usage":"作宾语、定语；用于处事"},{"id":10883,"word":"右翦左屠","pinyin":"yòu jiǎn zuǒ tú","abbr":"yjzt","explanation":"指歼灭净尽。"},{"id":10884,"word":"叶公好龙","pinyin":"yè gōng hào lóng","abbr":"yghl","explanation":"叶公：春秋时楚国贵族，名子高，封于叶（古邑名，今河南叶县）。比喻口头上说爱好某事物，实际上并不真爱好。","source":{"text":"汉·刘向《新序·杂事》记载：叶公子高非常喜欢龙，器物上刻着龙，房屋上也画着龙。真龙知道了，来到叶公家里，把头探进窗子。叶公一见，吓得拔腿就跑。"},"example":{"text":"～，好其是而非者。","book":"清·梁启超《敬告国人之误解宪政者》"},"similar":["表里不一","言不由衷"],"opposite":["名副其实","名实相符"],"usage":"作定语、宾语；指表里不一","story":["春秋时期，楚国叶地诸侯子弟沈诸梁自称叶公，他特别喜欢龙，他的屋梁、柱子、门窗及所有家具甚至连衣服上都雕刻或绣制龙的图案。天上的真龙得知后，专程去探望叶公，从窗户上探进头去。叶公一见真龙，吓得魂不附体，连忙逃跑"]},{"id":10885,"word":"叶散冰离","pinyin":"yè sǎn bīng lí","abbr":"ysbl","explanation":"离：离散。树叶飘散，冰雪消融。比喻原先聚于一处的人或物分散消失","source":{"text":"而祖宗之遗典，群公之旧章，莫不叶散冰离，扫地尽矣。","book":"《宋书·刘穆之王弘传论》"},"usage":"作谓语、定语、状语；用于比喻句"},{"id":10886,"word":"叶瘦花残","pinyin":"yè shòu huā cán","abbr":"yshc","explanation":"比喻女人的衰老。","source":{"text":"趁你青春年少，正好做人，只怕后来叶瘦花残，悔之晚矣。","book":"明·王玉峰《焚香记·构祸》"},"usage":"作谓语、定语；用于比喻句"},{"id":10887,"word":"叶落归根","pinyin":"yè luò guī gēn","abbr":"ylgg","explanation":"树叶从树根生发出来，凋落后最终还是回到树根。比喻事物总有一定的归宿。多指作客他乡的人最终要回到本乡。","source":{"text":"叶落归根，来时无口。","book":"宋·释道原《景德传灯录》卷五"},"example":{"text":"树高千丈，～，将来总得有个着落，不能不说说明白。","book":"清·李宝嘉《官场现形记》第二十二回"},"similar":["饮水思源","木落归本"],"opposite":["忘恩负义"],"usage":"作谓语、宾语、定语；比喻事物有一定的归宿"},{"id":10888,"word":"叶落归秋","pinyin":"yè luò guī qiū","abbr":"ylgq","explanation":"比喻事物有一定的归宿。","source":{"text":"美卷眷爱，俏伴侣。叶落归秋，花生满路。","book":"元·贯云石《斗鹌鹑·佳偶》曲"},"example":{"text":"明·康海《王兰卿》第一折：“病淹渐折倒的宠儿瘦，但得个夫妻美满，便是我～。”"},"usage":"作宾语、定语；用于书面语"},{"id":10889,"word":"叶落知秋","pinyin":"yè luò zhī qiū","abbr":"ylzq","explanation":"看到树叶落，便知秋天到来。比喻从细微的变化可以推测事物的发展趋向。","source":{"text":"见一叶落而知岁之将暮。","book":"《淮南子·说山训》"},"example":{"text":"动弦别曲，～，举一明三。","book":"宋·释普济《五灯会元》卷二十"},"usage":"作定语、分句；指从细微的变化可预测"},{"id":10890,"word":"号令如山","pinyin":"hào lìng rú shān","abbr":"hlrs","explanation":"指军令严肃，不容更改。","source":{"text":"岳节使号令如山，若与之敌，万无生理，不如往降。","book":"《宋史·岳飞传》"},"example":{"text":"端的是～把神鬼慑。","book":"清·洪昇《长生殿·侦报》"},"similar":["军令如山"],"opposite":["有禁不止"],"usage":"作谓语、定语；指军令严肃","story":["南宋时期，岳飞勤学苦练，武艺方面可以左右开弓，百发百中，作战布阵十分有智谋，他统率的军队更是号令如山，纪律严明，被百姓称为“冻死不拆屋，饿死不掳掠”，敌军听到“岳家军”三字闻风丧胆。他抗金有功，遭到秦桧父子的陷害"]},{"id":10891,"word":"号咷大哭","pinyin":"háo táo dà kū","abbr":"htdk","explanation":"号咷：也写作“嚎啕”，大声哭叫。形容放声大哭。","source":{"text":"同人先号咷而后笑。","book":"《周易·同人》"},"example":{"text":"不能思想，只是号咷大哭。","book":"叶圣陶《春光不是她的了》"}},{"id":10892,"word":"号唃大哭","pinyin":"háo táo dà kū","abbr":"htdk","explanation":"号唃也写作嚎啕”，大声哭叫。形容放声大哭。","source":{"text":"同人先号唃而后笑。","book":"《周易·同人》"},"quote":{"text":"不能思想，只是号唃大哭。","book":"叶圣陶《春光不是她的了》"}},{"id":10893,"word":"号啕大哭","pinyin":"háo táo dà kū","abbr":"htdk","explanation":"号啕：大哭声。放声大哭。","source":{"text":"同人先号咷而后笑。","book":"《周易·同人》"},"example":{"text":"不能思想，只是号咷大哭。","book":"叶圣陶《春光不是她的了》"},"similar":["号啕痛哭"],"usage":"作谓语、定语、状语；用于悲伤时"},{"id":10894,"word":"号啕痛哭","pinyin":"háo táo tòng kū","abbr":"httk","explanation":"号啕：大哭声。放声大哭。","source":{"text":"却说那和尚把袈裟骗到手，拿在后房灯下，对袈裟号啕痛哭。","book":"明·吴承恩《西游记》第16回"},"example":{"text":"清·褚人获《隋唐演义》第12回：“张奇妻子举家～。”"},"similar":["号咷大哭"],"usage":"作谓语、状语；指放声大哭"},{"id":10895,"word":"号天叩地","pinyin":"háo tiān kòu dì","abbr":"htkd","explanation":"号：大叫；叩：敲击。大声呼天，以头撞地。形容极度悲痛。","example":{"text":"看到她那～的样子，我也禁不住流下了眼泪。"},"similar":["号天扣地","呼天抢地"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":10896,"word":"号天叫屈","pinyin":"háo tiān jiào qū","abbr":"htjq","explanation":"号：大声哭叫。大哭大喊地说自己受了冤枉和委屈。","source":{"text":"又是一顿板子，送下死囚牢里。方六一随入看视，假意号天叫屈。","book":"明·天然智叟《石头点》"}},{"id":10897,"word":"号天哭地","pinyin":"háo tiān kū dì","abbr":"htkd","explanation":"哭天抢地。形容十分悲伤。","source":{"text":"只见林冲的娘子，号天哭地叫将来，女使锦儿抱着一包衣服，一路寻到酒店里。","book":"明·施耐庵《水浒传》第八回"},"example":{"text":"女人遇到伤心事大都喜欢～。"},"similar":["号天搭地","哭天抢地","呼天抢地"],"opposite":["兴高采烈"],"usage":"作谓语、定语、状语；用于伤心时"},{"id":10898,"word":"号天扣地","pinyin":"háo tiān kòu dì","abbr":"htkd","explanation":"扣：叩，撞。大专呼天，用头撞地。形容十分悲痛的样子。","source":{"text":"初闻此旨，魂爽飞越，号天叩地，不能自胜。","book":"《周书·晋荡公护传》"},"example":{"text":"朕以不造，奄丁闵凶，～，靡知所诉。","book":"《晋书·孝武帝纪》"},"similar":["号天叩地"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":10899,"word":"号天拍地","pinyin":"háo tiān pāi dì","abbr":"htpd","explanation":"大声哭叫。形容放声大哭","source":{"text":"咽了这一口怨气，扯住了丈夫，哭了又哭，号天拍地的不肯放手。","book":"明·凌濛初《初刻拍案惊奇》第20卷"},"example":{"text":"她伤心得～，痛不欲生"},"similar":["号天哭地","号天叩地"],"usage":"作谓语、定语、状语；用于伤心时"},{"id":10900,"word":"号天搭地","pinyin":"háo tiān dā dì","abbr":"htdd","explanation":"大声哭叫。形容放声大哭。","example":{"text":"她伤心得～，痛不欲生。"}},{"id":10901,"word":"号寒啼饥","pinyin":"háo hán tí jī","abbr":"hhtj","explanation":"因为饥饿寒冷而哭叫。形容挨饿受冻的悲惨生活。","source":{"text":"唐·韩愈《进学解》：“冬暖而儿号哭寒，年丰而凄啼饥。"},"example":{"text":"天涯百指携空囊，～日相恼。","book":"宋·高登《辞馈金》"},"similar":["啼饥号寒"],"usage":"作谓语、定语；形容极为贫困"},{"id":10902,"word":"号恸崩摧","pinyin":"háo tòng bēng cuī","abbr":"htbc","explanation":"恸：哀痛之极，大哭；崩：死亡；摧：伤心。放声痛哭，异常悲伤，几乎昏死过去。形容极度悲伤。","source":{"text":"翩翩孤嗣，号恸崩摧。","book":"三国·魏·曹植《王仲宣诔》"}},{"id":10903,"word":"司农仰屋","pinyin":"sī nóng yǎng wū","abbr":"snyw","explanation":"主管钱粮的官员一筹莫展，无计可施。形容国库空虚，财政拮据。","source":{"text":"朝廷因连年国费浩烦，且因赔款又重，又要办理新政，正在司农仰屋的时候，势不免裁者经费。","book":"黄小配《廿载繁华梦》第30回"},"example":{"text":"据国计民生上立论，府库日虚，～，若再兴大工，尤恐支绌！","book":"蔡东藩《元史演义》第五十四回"},"usage":"作定语；用于书面语"},{"id":10904,"word":"司空不视涂","pinyin":"sī kōng bù shì tú","abbr":"skbst","explanation":"司空：古代管理道路的官；涂：路；不视涂：不看道路。司空不察看道路。指放弃本职工作，玩忽职守。","source":{"text":"侯不在疆，司空不视涂，泽不陂，川不梁，野有庾积，场功未毕，道无列树，垦田若蓺，膳宰不致饩，司里泽不授馆。","book":"《国语·周语中》"}},{"id":10905,"word":"司空眼惯","pinyin":"sī kōng yǎn guàn","abbr":"skyg","explanation":"司空：古代官名。指某事常见，不足为奇。","source":{"text":"雅兴杂鱼龙，妙算回鸾凤。莫道司空眼惯，还入清宵梦。","book":"宋·李廷忠《卜算子·萧计议席上》"},"similar":["司空见惯","见惯司空"],"opposite":["盖世无双"],"usage":"作谓语、定语、宾语；形容常见的东西"},{"id":10906,"word":"司空见惯","pinyin":"sī kōng jiàn guàn","abbr":"skjg","explanation":"司空：古代官名。指某事常见，不足为奇。","source":{"text":"司空见惯浑闲事，断尽江南刺史肠。","book":"唐·孟棨《本事诗·情感》载刘禹锡诗"},"example":{"text":"“帝国主义”这种字样，在现今已是～了，但在当年却几乎是一种讳名。","book":"郭沫若《革命春秋·创造十年续篇》"},"similar":["屡见不鲜","习以为常"],"opposite":["绝无仅有","盖世无双","少见多怪"],"usage":"作谓语、定语、宾语；形容常见的东西","story":["唐朝著名诗人刘禹锡因为政治革新被贬职回京，司空李绅设宴款待他，席间命歌妓以歌舞劝酒。刘禹锡感慨万分，当场写诗一首：“高髻云鬟宫样装，春风一曲杜韦娘。司空见惯浑闲事，断尽江南刺史肠”"]},{"id":10907,"word":"司马昭之心","pinyin":"sī mǎ zhāo zhī xīn","abbr":"smzzx","explanation":"比喻人所共知的野心。","source":{"text":"司马昭之心，路人所知也。","book":"晋·陈寿《三国志·魏志·高贵乡公传》：“高贵乡公卒”裴松之注引《汉晋春秋》"},"example":{"text":"岂所谓～，路人皆见者耶？","book":"清·梁启超《新民论·论民族竞争之大势》"},"similar":["路人皆知"],"usage":"作主语、宾语；指人所共知的野心","story":["三国时，魏文帝曹丕死后，由司马懿和曹爽辅佐曹睿执政。曹睿死，司马懿杀了曹爽，司马懿的儿子司马师立曹髦为皇帝。司马师的弟弟司马昭不把曹髦看在眼里，威胁要封晋公。曹髦气愤不过，说：“司马昭的心，路人所知也。”"]},{"id":10908,"word":"司马昭之心，路人皆知","pinyin":"sī mǎ zhāo zhī xīn，lù rén jiē zhī","abbr":"smzzxlrjz","explanation":"路人：路上的人，指所有的人。比喻人所共知的野心。","source":{"text":"司马昭之心，路人皆知。","book":"《三国志·魏书·高贵乡公传》裴松之注引《汉晋春秋》"},"usage":"作宾语、分句；指人所共知的野心","story":["三国时，魏文帝曹丕死后，由司马懿和曹爽辅佐曹睿执政。曹睿死，司马懿杀了曹爽，司马懿的儿子司马师立曹髦为皇帝。司马师的弟弟司马昭不把曹髦看在眼里，威胁要封晋公。曹髦气愤不过，说：“司马昭的心，路人所知也。”"]},{"id":10909,"word":"司马牛之叹","pinyin":"sī mǎ niú zhī tàn","abbr":"smnzt","explanation":"比喻对孑然一身、孤立无援的感叹。","source":{"text":"司马牛忧曰：‘人皆有兄弟，我独亡。’","book":"《论语·颜渊》"},"example":{"text":"清·曹雪芹《红楼梦》第45回：“咱们也算同病相怜，你也是个明白人，何必作‘～’？”"},"usage":"作宾语；用于书面语"},{"id":10910,"word":"司马牛之忧","pinyin":"sī mǎ niú zhī yōu","abbr":"smnzy","explanation":"司马牛：名耕，孔子的学生。司马牛因为没有兄弟而忧愁。比喻对孑然一身、孤立无援的担忧。","source":{"text":"司马牛忧曰：‘人皆有兄弟，我独亡。’","book":"《论语·颜渊》"},"example":{"text":"夫仲尼亮～，祁奚明叔向之过，在昔之美义也。","book":"《三国志·魏志·高柔传》"}},{"id":10911,"word":"司马称好","pinyin":"sī mǎ chēng hǎo","abbr":"smch","explanation":"喻指老好人是非不分，事理不明。","source":{"text":"（后汉司马徽）口不谈人之短。与人语，莫问好恶，皆言好。有乡人问徽安否，答曰好。有人自陈子死，答曰大好。妻责之曰：人以君有德，故相告，何忽闻人子死，便言好！徽曰：卿言亦大好。","book":"五代·李瀚《蒙求》诗：“司马称好。”徐子光集注"},"usage":"作宾语、定语；用于处事","story":["汉朝时期，司马徽从不说别人的短处，与人说话时，从来不问别人的好恶，都说好话。一个同乡来问他安否，他回答好。有一个说自己的儿子死了，他也说大好。妻子骂他缺德，别人死了儿子为什么还要说好，司马徽说：“你的话也太好了。”"]},{"id":10912,"word":"司马青衫","pinyin":"sī mǎ qīng shān","abbr":"smqs","explanation":"司马：古代官名，唐代诗人白居易曾贬官为江州司马。司马的衣衫为泪水所湿。形容极度悲伤。","source":{"text":"座中泣下谁最多，江州司马青衫湿。","book":"白居易《琵琶行》诗"},"example":{"text":"我岂学做重婚王允愚？岂湿着～泪？","book":"明·王世贞《鸣凤记》第二十九出"},"usage":"作主语、宾语、定语；形容极度悲伤","story":["唐朝时期，诗人白居易被降职为江州郡司马，一个秋天的夜晚他送客到湓浦口码头，江面上传来悦耳的琵琶声，就将琵琶女叫来询问，得知她从小在长安跟随名师学艺，因年老色衰而不得已嫁给一个商人为妻，联想到自身，感动得泪流满面"]},{"id":10913,"word":"叹为观止","pinyin":"tàn wéi guān zhǐ","abbr":"twgz","explanation":"叹：赞赏；观止：看到这里就够了。指赞美所见到的事物好到了极点。","source":{"text":"德至矣哉，大矣！如天之无不帱也，如地之无不载也。虽甚盛德，其蔑以加于此矣，观止矣。若有他乐，吾不敢请已。","book":"春秋·鲁·左丘明《左传·襄公二十九年》"},"example":{"text":"更佐以乐音灯影，光怪陆离，不可逼视。生抚掌称奇，～。","book":"清·王韬《淞隐漫录·海外壮游》"},"similar":["蔚为大观"],"opposite":["海底捞针"],"usage":"作宾语、定语；用于事情等","story":["公元前544年，吴公子季札来到鲁国，表示愿与鲁国结盟世代友好下去，鲁国用舞乐招待他。季札精通舞乐，一边观赏，一边品评，当演出《韶箭》舞时，季札便断定是最后一个节目，说就看到这里吧。鲁国人非常吃惊他能预知最后的节目"]},{"id":10914,"word":"叹老嗟卑","pinyin":"tàn lǎo jiē bēi","abbr":"tljb","explanation":"感叹年已老大而犹未显达。","source":{"text":"小筑幽栖与拙宜，读书写字伴儿嬉。已无叹老嗟卑意，却喜分冬守岁时。","book":"宋·陆游《岁莫》"},"example":{"text":"得意的自然有，却只是少数，失意的可太多了。所以总是～，长歌当哭，哭丧着脸一副可怜相。","book":"朱自清《论书生的酸气》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":10915,"word":"叹观止矣","pinyin":"tàn guān zhǐ yǐ","abbr":"tgzy","explanation":"用来赞美看到的事物好到了极点。","source":{"text":"观止矣。","book":"《左传·襄公二十九年》记载：吴国的季札在鲁国看各种乐舞，看到舜时的乐舞，十分赞美，说"},"example":{"text":"皆不足奇，得此而～。","book":"清·钱泳《履园丛话·石钟山》"}},{"id":10916,"word":"叽叽咕咕","pinyin":"jī jī gū gū","abbr":"jjgg","explanation":"指脸挨脸地小声说话，以免别人听见。","source":{"text":"在一个床铺旁边，嘴里叽叽咕咕的说了两句听不懂的话，便有一个人在被窝里钻出来。","book":"清·吴趼人《二十年目睹之怪现状》第二回"},"example":{"text":"在她房里～了一会儿，孙小姐出来请辛楣等进去，那女同志正细看孙小姐的毕业文凭。","book":"钱钟书《围城》"},"similar":["唧唧咕咕"],"usage":"作谓语、定语；用于说话"},{"id":10917,"word":"叽叽喳喳","pinyin":"jī jī zhā zhā","abbr":"jjzz","explanation":"语音杂乱。","source":{"text":"忽然又听得隔房一阵人声，叽叽喳喳说的都是天津话。","book":"清·吴趼人《二十年目睹之怪现状》第77回"},"example":{"text":"他们在那边～没完。"},"similar":["叽叽嘎嘎"],"opposite":["鸦雀无声"],"usage":"作谓语、定语、状语；指鸟叫或杂乱场面"},{"id":10918,"word":"叽哩咕噜","pinyin":"jī lǐ gū lū","abbr":"jlgl","explanation":"形容说话别人听不清或不明白。","source":{"text":"老三还在那里叽哩咕噜说：‘是个好些儿的，就去中进士做官给我看，不要在我们家里混闲饭吃。’","book":"清·李宝嘉《官场现形记》第一回"},"example":{"text":"～的洋文，弄不清楚。","book":"高阳《胡雪岩全传·红顶商人》"},"similar":["叽里咕噜"],"opposite":["字正腔圆"],"usage":"作谓语、定语；指人说话或响声"},{"id":10919,"word":"叽里咕噜","pinyin":"jī lǐ gū lū","abbr":"jlgl","explanation":"形容说话别人听不清或不明白。","source":{"text":"忽又听见他们叽里咕噜的说起外国话来，我以为他们请了外国客来了。","book":"清·吴趼人《二十年目睹之怪现状》第77回"},"example":{"text":"她～一大通，我一句都没听懂。"},"similar":["叽里呱啦","叽哩咕噜"],"usage":"作谓语、定语；指人说话或响声"},{"id":10920,"word":"吁咈都俞","pinyin":"yù fú dōu yú","abbr":"yfdy","explanation":"吁、咈，反对的感叹词。都、俞，赞美、同意的感叹词。形容君臣议事融洽。","source":{"text":"禹曰：‘都，帝，慎乃在位。’帝曰：‘俞！’","book":"语本《书经·尧典》：“帝曰：‘吁！咈哉！’”语本《书经·益稷》"},"example":{"text":"都俞吁咈，荣名动百僚；进退周旋，治道期千载。","book":"明·王世贞《鸣凤记》第十五出"},"usage":"作谓语、定语；用于书面语"},{"id":10921,"word":"吁天呼地","pinyin":"yù tiān hū dì","abbr":"ythd","explanation":"呼天唤地。形容极度悲切。","source":{"text":"翊从潇湘，空竭关陇，荆梁左右，汉沔东西。吁天呼地，望伫哀救。","book":"南朝陈徐陵《檄周文》"},"similar":["呼天唤地"],"usage":"作谓语、状语；指十分悲伤"},{"id":10922,"word":"吃一堑，长一智","pinyin":"chī yī qiàn，zhǎng yī zhì","abbr":"cyqzyz","explanation":"堑：壕沟，比喻困难、挫折。受一次挫折，增长一分见识。","source":{"text":"经一蹶者长一智，今日之失，未必不为后日之得。","book":"明·王阳明《与薛尚谦书》"},"example":{"text":"所谓“失败者成功之母”，“～”，就是这个道理。","book":"毛泽东《实践论》"},"similar":["失败乃成功之母","上当学乖"],"opposite":["重蹈覆辙"],"usage":"作主语、谓语、分句；用于总结经验教训"},{"id":10923,"word":"吃不了兜着走","pinyin":"chī bù liǎo dōu zhe zǒu","abbr":"cbldzz","explanation":"比喻受不了或担当不起。","source":{"text":"你安下人摽柱他汉子在院里过夜，这里要他老婆，我叫你吃不了包着走。","book":"明·兰陵笑笑生《金瓶梅词话》第十三回"},"example":{"text":"不可拿进园去，叫人知道了，我就“～”了。","book":"清·曹雪芹《红楼梦》第二十三回"},"usage":"作补语、分句；指不能承受"},{"id":10924,"word":"吃人不吐骨头","pinyin":"chī rén bù tǔ gǔ tóu","abbr":"crbtgt","explanation":"比喻又残暴，又贪婪。","source":{"text":"但此人一肚子坏水儿，吃人不吐骨头，成事不足，败事有余，只能拉拢，不能得罪。","book":"端木蕻良《曹雪芹》第27章"},"example":{"text":"他是个～的家伙。"},"usage":"作谓语、宾语、定语；指人凶残"},{"id":10925,"word":"吃力不讨好","pinyin":"chī lì bù tǎo hǎo","abbr":"clbth","explanation":"讨：求得。费了好大力气，也得不到称赞。形容事情棘手难办，或工作方法笨拙，不对头。","source":{"text":"老实说，有了钱，与其这样化的吃力不讨好，我倒不如拿来孝敬点给叔公了。","book":"清·吴趼人《二十年目睹之怪现状》第十八回"},"example":{"text":"严格说来，诗歌的翻译是～的事。","book":"茅盾《白居易及其同时代的诗人》"},"similar":["费力不讨好"],"usage":"作定语、分句；指白费力"},{"id":10926,"word":"吃吃喝喝","pinyin":"chī chī hē hē","abbr":"cchh","explanation":"指有目的的相互请吃饭，请喝酒。","source":{"text":"年纪一大把，乐得看开些，吃吃喝喝，四处八方去逛逛，让我也开开眼界。","book":"高阳《胡雪岩全传·平步青云》中册"},"example":{"text":"你别整天只知道～，干些实事吧。"},"similar":["大吃大喝"],"usage":"作谓语、宾语；指吃喝"},{"id":10927,"word":"吃哑巴亏","pinyin":"chī yǎ bā kuī","abbr":"cybk","explanation":"自己遭受暗算或受损吃亏，不敢声张或无法申诉，只好自认吃亏。","source":{"text":"且说苗家父子丢了银子，因是暗昧之事，也不敢声张，竟吃了哑巴亏了。","book":"清·石玉昆《三侠五义》第14回"},"example":{"text":"天不怕，地不怕，绝对不低着头～。","book":"老舍《骆驼祥子》"},"similar":["有苦难言"],"usage":"作谓语、宾语；指只好自认吃亏"},{"id":10928,"word":"吃喝嫖赌","pinyin":"chī hē piáo dǔ","abbr":"chpd","explanation":"嫖：狎妓；赌：赌博。指男人不务正业。","source":{"text":"单是这一个最坏，才上了十三四岁，便学的吃喝嫖赌，无所不为了，在家里还时常闯祸。","book":"清·吴趼人《二十年目睹之怪现状》第29回"},"example":{"text":"我年轻时～，什么浪荡的事都干过。","book":"余华《活着》"},"similar":["吃喝玩乐"],"usage":"作主语、宾语、定语；用于人生"},{"id":10929,"word":"吃喝拉撒","pinyin":"chī hē lā sā","abbr":"chls","explanation":"吃饭、喝水、拉屎、撒尿。指一个人的基本生活需要。","source":{"text":"当一个文化熟到了稀烂的时候，人们会麻木不仁的把惊魂夺魄的事情与刺激放在一旁，而专意到吃喝拉撒中的小节目上去。","book":"老舍《四世同堂》"},"example":{"text":"路遥《平凡的世界》第二卷第35章：“人们宁愿去关心一个蹩脚电影演员的～和鸡毛蒜皮。”"},"similar":["吃喝拉撒睡"],"usage":"作宾语、定语；用于人的生活"},{"id":10930,"word":"吃喝玩乐","pinyin":"chī hē wán lè","abbr":"chwl","explanation":"指过恣意享乐的生活。","source":{"text":"吃喝玩乐的惯了，再天天啃窝窝头？受不了。","book":"老舍《上任》"},"example":{"text":"我们不能只顾～，要干一番事业。"},"usage":"作主语、宾语、定语；指人的生理需求"},{"id":10931,"word":"吃四方饭","pinyin":"chī sì fāng fàn","abbr":"csff","explanation":"和尚道士到处化缘为生，也指一般人走到任何地方都能生活。","example":{"text":"和尚道士是～的人。"},"similar":["四海为家"],"usage":"作谓语、定语；指僧道尼等"},{"id":10932,"word":"吃大锅饭","pinyin":"chī dà guō fàn","abbr":"cdgf","explanation":"比喻企业不论盈亏，个人不分勤懒，全由国家包干的办法。","source":{"text":"现在工资规定低一点也可以，但不能太低，不能搞平均主义，不能吃大锅饭。","book":"邓小平《高级干部要带头发扬党的优良传统》"},"example":{"text":"～是不能发挥人的个性的。"},"similar":["平均主义"],"usage":"作主语、谓语、宾语；指搞集体分配"},{"id":10933,"word":"吃小亏占大便宜","pinyin":"chī xiǎo kuī zhàn dà biàn yí","abbr":"cxkzdby","explanation":"指暂时觉得吃亏，将来能得到大的好处。","example":{"text":"这样做就叫～。"},"similar":["吃小亏得大便宜"],"opposite":["因小失大"],"usage":"作宾语、定语；指以小换大"},{"id":10934,"word":"吃小亏得大便宜","pinyin":"chī xiǎo kuī dé dà biàn yí","abbr":"cxkddby","explanation":"指暂时亏损一点期待将来的收益。","example":{"text":"他就是～。"},"similar":["放长线钓大鱼"],"usage":"作谓语、宾语、分句；用于人"},{"id":10935,"word":"吃得苦中苦，方为人上人","pinyin":"chī dé kǔ zhōng kǔ，fāng wéi rén shàng rén","abbr":"cdkzkfwrsr","explanation":"方：始；人上人：指才能出众的人。吃得千辛万苦，才能获取功名富贵，成为别人敬重的人。","source":{"text":"这才合了俗语说的一句话，叫做‘吃得苦中苦，方为人上人’。","book":"清·李宝嘉《官场现形记》第一回"},"example":{"text":"高阳《胡雪岩全传·萧瑟洋场》：“瑞香，你总要记牢，～。”"},"usage":"作宾语、定语；用于劝诫人"},{"id":10936,"word":"吃惊受怕","pinyin":"chī jīng shòu pà","abbr":"cjsp","explanation":"受惊骇。","source":{"text":"铁扇子宋清策着一乘山轿，抬着宋太公到来，众人扶策下轿上厅来。宋江见了，喜从天降，笑逐颜开。宋江再拜道：‘老父惊恐，宋江做了不孝之子，负累了父亲吃惊受怕。’","book":"明·施耐庵《水浒传》第四十二回"},"similar":["担惊受怕"],"usage":"作谓语、定语、状语；形容担心害怕"},{"id":10937,"word":"吃水忘源","pinyin":"chī shuǐ wàng yuán","abbr":"cswy","explanation":"喝水的时候忘记了水是从哪儿来的。比喻人处境优越时忘其所由来。","source":{"text":"我今日虽非抛桃寻枣之境，却作了吃水忘源之事了。","book":"清·无名氏《春柳莺》第九回"}},{"id":10938,"word":"吃现成饭","pinyin":"chī xiàn chéng fàn","abbr":"cxcf","explanation":"比喻自己不出力，只享受现成的利益。","source":{"text":"他却一直不引见、不到省，仍旧在老子任上当少爷，吃现成饭，静候机缘。","book":"清·李宝嘉《官场现形记》第23回"},"example":{"text":"你就知道～。"},"similar":["不劳而获"],"opposite":["自力更生"],"usage":"作宾语、定语；指享受现成"},{"id":10939,"word":"吃白食","pinyin":"chī bái shí","abbr":"cbs","explanation":"白吃别人的饭，光吃饭不工作，吃东西不付钱，也指不务正业专靠讹诈为生。","source":{"text":"况列位在此，无有我不破钞，反吃白食的。","book":"明·凌濛初《初刻拍案惊奇》第18卷"},"example":{"text":"靠～过活的人让人瞧不起。"},"similar":["吃白饭"],"usage":"作谓语、宾语；用于为人"},{"id":10940,"word":"吃着不尽","pinyin":"chī zhuó bù jìn","abbr":"czbj","explanation":"着：穿衣。吃的穿的，享用不尽。比喻生活富裕。","source":{"text":"王沂公曾青州发解，及南省程试，皆为首冠。中山刘子仪为翰林学士，戏语之曰：‘状元试三场，一生吃着不尽。’沂公正色答曰：‘曾平生之志，不在温饱。’","book":"宋·魏泰《东轩笔录》卷十四"},"example":{"text":"常言某处有一金佛，可往取归，一生～。","book":"章炳麟《又致吴君遂》"},"similar":["吃著不尽"],"usage":"作谓语、定语；比喻生活富裕"},{"id":10941,"word":"吃着碗里瞧着锅里","pinyin":"chī zhe wǎn lǐ qiáo zhe guō lǐ","abbr":"czwlqzgl","explanation":"比喻贪心不足。","source":{"text":"那薛老大也是‘吃着碗里瞧着锅里’的。","book":"清·曹雪芹《红楼梦》十六回"}},{"id":10942,"word":"吃着碗里，瞧着锅里","pinyin":"chī zhe wǎn lǐ，qiáo zhe guō lǐ","abbr":"czwlqzgl","explanation":"比喻贪心不足。","source":{"text":"那薛老大也是‘吃着碗里，瞧着锅里’的，这一年来的时候，他为香菱儿不能到手，和姑妈打了多少饥荒。","book":"清·曹雪芹《红楼梦》第16回"},"similar":["贪心不足"],"usage":"作谓语、宾语；用于为人贪婪"},{"id":10943,"word":"吃硬不吃软","pinyin":"chī yìng bù chī ruǎn","abbr":"cybcr","explanation":"好言好语不听从，态度一强硬，反使屈从了。形容人的外强中干，欺软怕硬。","source":{"text":"戴大理嘱咐他的一番话，说明统领的为人，吃硬不吃软。","book":"清·李宝嘉《官场现形记》第17回"},"example":{"text":"他～，该强硬对待。"},"similar":["欺软怕硬"],"opposite":["吃软不吃硬"],"usage":"作谓语、定语；指人的处世态度"},{"id":10944,"word":"吃穿用度","pinyin":"chī chuān yòng dù","abbr":"ccyd","explanation":"指日常衣食费用。","source":{"text":"他近日所见的这三等仆妇，吃穿用度，已是不凡了。","book":"清·曹雪芹《红楼梦》第三回"},"example":{"text":"我们要计划好每天的～。"},"similar":["日常开销"],"usage":"作主语、宾语；指日常开销"},{"id":10945,"word":"吃粮不管事","pinyin":"chī liáng bù guǎn shì","abbr":"clbgs","explanation":"只拿钱不做事。比喻工作不负责。","source":{"text":"这些忘八羔子，一个都不在家！他们成年家吃粮不管事。","book":"清·曹雪芹《红楼梦》第93回"},"example":{"text":"我们不需要～的人。"},"similar":["尸位素餐"],"usage":"作谓语、宾语、定语；指不认真"},{"id":10946,"word":"吃糠咽菜","pinyin":"chī kāng yàn cài","abbr":"ckyc","explanation":"糠：稻、麦等谷物的皮；菜：野菜。指吃谷糠，吞野菜。形容生活的贫困与艰辛。","source":{"text":"你赶快命人给新弟兄送十天粮食，再送去两头猪，二十只山羊，两担烧酒，让大家快快活活地吃喝一顿。他们在家中吃糠咽菜，不少人吃树皮草根，把肠子都饿细啦。","book":"姚雪垠《李自成》第三章"},"example":{"text":"不回老家吧，死想家乡。总觉得只要回到家乡，～也比流落在外乡好。可是一回到家乡呢，见到幼年时候的老朋友们，过著烟心的日子，又觉得起心眼里难受。","book":"梁斌《红旗谱》七"}},{"id":10947,"word":"吃肥丢瘦","pinyin":"chī féi diū shòu","abbr":"cfds","explanation":"比喻专做占便宜的事。","source":{"text":"你背着我，吃肥丢瘦。","book":"向春《煤城激浪》"},"example":{"text":"开采矿产资源不能～。"},"similar":["挑肥拣瘦","挑三拣四"],"usage":"作谓语、定语、宾语；指专做占便宜的事"},{"id":10948,"word":"吃自在饭","pinyin":"chī zì zài fàn","abbr":"czzf","explanation":"指做没有风险与责任的事，安闲享福","source":{"text":"那赵聪原是个极贪安宴，十日九不在书房里的，做先生倒落得吃自在饭，得了重资，省了气力。","book":"明·凌濛初《初刻拍案惊奇》第13卷"},"usage":"作谓语、宾语、定语；用于口语"},{"id":10949,"word":"吃苦在先，享受在后","pinyin":"chī kǔ zài xiān，xiǎng shòu zài hòu","abbr":"ckzxxszh","explanation":"吃苦的事情走在别人前面，享受的事走在别人后面。","source":{"text":"不与群众同甘苦，不实行吃苦在先，享受在后，不服从组织决定，不接受群众监督。","book":"邓小平《坚持四项基本原则》"},"similar":["吃苦在前，享乐在后"],"usage":"作谓语、宾语、定语；用于处世"},{"id":10950,"word":"吃苦在前，享受在后","pinyin":"chī kǔ zài qián，xiǎng shòu zài hòu","abbr":"ckzqxszh","explanation":"吃苦的事情走在别人前面，享受的事走在别人后面。","source":{"text":"他吃苦在前，享受在后，不同别人计较享受的优劣，而同别人比较革命工作的多少和艰苦奋斗的精神。","book":"刘少奇《论共产党员的修养》"},"similar":["吃苦在先，享受在后"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":10951,"word":"吃苦耐劳","pinyin":"chī kǔ nài láo","abbr":"cknl","explanation":"耐：禁受得住。能过困苦的生活，也经得起劳累。","source":{"text":"新中国虽然已在望中，可是得吃苦耐劳，才能到我们手里。","book":"朱自清《新中国在望中》"},"example":{"text":"我们要有～的精神才能成功。"},"similar":["任劳任怨"],"usage":"作定语、宾语；形容人坚韧不拔"},{"id":10952,"word":"吃著不尽","pinyin":"chī zhuó bù jìn","abbr":"czbj","explanation":"著：通“着”，穿衣。吃的穿的，享用不尽。比喻生活富裕。","source":{"text":"中山刘子仪为翰林学士，戏语之曰：‘状元试三场，一生吃著不尽。’沂公正色答曰：‘曾平生之志，不在温饱。’","book":"宋·魏泰《东轩笔录》第14卷"},"similar":["吃着不尽"],"usage":"作谓语、定语；比喻生活富裕"},{"id":10953,"word":"吃衣著饭","pinyin":"chī yī zhuó fàn","abbr":"cyzf","explanation":"著：穿。指贫家卖米制衣，又典衣买米做饭。形容生活贫苦或安排不当。也比喻怪异的医疗方法。","source":{"text":"今人米谷登场，则去米制衣；及至粮竭，复典衣而食；谓之之著饭吃衣。或传食绢方为神仙上药；又寒疾者稻席常愈。人嘲曰：君吃衣著饭，大是奇方。","book":"清·潘永因《宋稗类钞》"}},{"id":10954,"word":"吃软不吃硬","pinyin":"chī ruǎn bù chī yìng","abbr":"crbcy","explanation":"对态度强硬者，绝不屈从，对好言好语，可以听从。形容个性顽强，不怕强硬。","source":{"text":"从来小孩爱戴高帽儿，吃软不吃硬。","book":"清·醉月山人《狐狸缘全传》第三回"},"example":{"text":"他就是～的性格。"},"opposite":["吃硬不吃软"],"usage":"作谓语、定语；形容个性顽强，不怕强硬"},{"id":10955,"word":"吃醋拈酸","pinyin":"chī cù niān suān","abbr":"ccns","explanation":"指为了追求同一异性而发生嫉妒情绪，明争暗斗。","source":{"text":"嘴儿搽得红，眉儿画得浓，只要吃醋拈酸打老公。","book":"明·王錂《春芜记·宴赏》"},"example":{"text":"我们很是那～容不下人的不成，怎么‘拔出肉中刺，眼中钉’？是谁的钉，谁的刺？","book":"清·曹雪芹《红楼梦》第80回"},"similar":["拈酸吃醋","争风吃醋"],"usage":"作谓语、宾语；用于嫉妒人"},{"id":10956,"word":"吃里扒外","pinyin":"chī lǐ pá wài","abbr":"clpw","explanation":"接受这一方面的好处，却为那一方面卖力。也指将自己方面的情况告诉对方。","source":{"text":"人心隔肚皮，备不住有那吃里扒外的家伙走风漏水，叫韩老六跑了。","book":"周立波《暴风骤雨》第一部"},"example":{"text":"他～，出卖公司机密给竞争对手。"},"similar":["吃里爬外"],"opposite":["一心为公"],"usage":"作谓语、宾语；指胳膊往外拐"},{"id":10957,"word":"吃里爬外","pinyin":"chī lǐ pá wài","abbr":"clpw","explanation":"接受这一方面的好处，却为那一方面卖力。也指将自己方面的情况告诉对方。","source":{"text":"朝臣都不一心，总是吃里爬外，恐怕将来闹糟了算呀！","book":"清·程道一《消闲演义》"},"example":{"text":"这种～的事，我劝你不要做。"},"similar":["吃里扒外"],"opposite":["舍己救人","大公无私"],"usage":"作谓语、定语；比喻背叛自己集体为别人办事"},{"id":10958,"word":"吃闭门羹","pinyin":"chī bì mén gēng","abbr":"cbmg","explanation":"羹：流汁食品。比喻串门时，主人不在家，被拒绝进门或受其他冷遇。","example":{"text":"我们出外最担心～。"},"usage":"作谓语、宾语；指碰壁","story":["古代宣城妓女史风长得标致风流，能歌善舞，十分闻名，那些浪荡公子和好色之徒纷纷登门拜访，把妓院经常围得水泄不通。史风把他们分成不同的等级，上等的客人来，她下楼接待，还做羹款待，下等客人来她不愿同他们见面，关起门来让他吃羹"]},{"id":10959,"word":"吃饭防噎，走路防跌","pinyin":"chī fàn fáng yē，zǒu lù fáng diē","abbr":"cffyzlfd","explanation":"吃饭时要防止被食物噎住，走路时要防止摔跤。形容处事小心谨慎。","source":{"text":"岂不闻古人言：‘吃饭防噎，走路防跌？’","book":"明·施耐庵《水浒传》第十回"},"usage":"作宾语、定语；用于处事"},{"id":10960,"word":"各不为礼","pinyin":"gè bù wéi lǐ","abbr":"gbwl","explanation":"礼：礼遇。彼此之间互不以礼相待。比喻各不相干。","source":{"text":"帝师释迦之徒，天下僧人师也；余孔子之徒，天下儒人师也，谓各不为礼。","book":"《元史·孛术鲁翀传》"}},{"id":10961,"word":"各不相下","pinyin":"gè bù xiāng xià","abbr":"gbxx","explanation":"相下：处于下风。指双方相比，不分高低胜负。","source":{"text":"与申大善士一帮旗鼓相当，彼此各不相下。","book":"清·李宝嘉《官场现形记》第三十五回"},"example":{"text":"几个车夫～的加快速度，贪图多得一两个铜元。","book":"老舍《老张的哲学》第九章"},"similar":["不分胜负"],"usage":"作谓语、定语、宾语；用于局势"},{"id":10962,"word":"各不相让","pinyin":"gè bù xiāng ràng","abbr":"gbxr","explanation":"让：歉让。互不谦让、让步。","source":{"text":"于是两方明争暗斗，各不相让，一天利（历）害一天。","book":"冯玉祥《我的生活》第23章"},"example":{"text":"～对大家都没好处。"},"similar":["互不相让"],"opposite":["你谦我让","拱手让人"],"usage":"作谓语、宾语；指互不谦让"},{"id":10963,"word":"各不相谋","pinyin":"gè bù xiāng móu","abbr":"gbxm","explanation":"谋：商量，计义。各自按照自己的意思办事，不互相商量。","source":{"text":"子曰：‘道不同，不相为谋。’","book":"《论语·卫灵公》"},"similar":["各自为政"],"usage":"作谓语；指各自行事"},{"id":10964,"word":"各个击破","pinyin":"gè gè jī pò","abbr":"ggjp","explanation":"各个：逐个；击：攻。军事术语。指利用优势兵力将被分割开的敌军一部分一部分消灭。有时也比喻将问题逐个解决。","source":{"text":"集中红军相机应付当前之敌，反对分兵，避免被敌人各个击破。","book":"毛泽东《中国的红色政权为什么能够存在？》"},"example":{"text":"我们利用他们的矛盾实行～。"},"usage":"作谓语、宾语；指分别逐个击败对方"},{"id":10965,"word":"各为其主","pinyin":"gè wèi qí zhǔ","abbr":"gwqz","explanation":"各人为自己的主人效力。","source":{"text":"及爽解印绶，将出，主簿杨综止之曰：‘公挟主握权，舍此以至东市乎？’爽不从。有司奏综导爽反，宣王曰：‘各为其主也。’宥之，以为尚书郎。","book":"《三国志·魏志·曹爽传》裴松之注引《世语》"},"example":{"text":"徐茂公，你放手，往日咱两个是朋友，今日～也。","book":"元·尚仲贤《单鞭夺槊》第三折"},"similar":["狗吠非主"],"usage":"作谓语；指各人为自己的主人效力"},{"id":10966,"word":"各人自扫门前雪","pinyin":"gè rén zì sǎo mén qián xuě","abbr":"grzsmqx","explanation":"比喻不要多管闲事。","source":{"text":"进去罢，各人自扫门前雪，莫管他家瓦上霜。","book":"明·张凤翼《灌园记·后识法章》"},"example":{"text":"然而也有经过许多人经验之后，倒给了后人坏影响的，如俗语说“～，莫管他人瓦上霜”的便是其一。","book":"鲁迅《经验》"},"usage":"作宾语、分句；常与“莫管他人瓦上霜”连用"},{"id":10967,"word":"各人自扫门前雪，休管他人瓦上霜","pinyin":"gè rén zì sǎo mén qián xuě,xiū guǎn tā rén wǎ shàng shuāng","abbr":"grzsmqxxgtrwss","explanation":"比喻只管自己的事，不管别人的事。","source":{"text":"比喻只管自己的事，不管别人的事。"},"similar":["各人自扫门前雪，莫管他人瓦上霜"],"usage":"作宾语、定语、分句；用于处世"},{"id":10968,"word":"各人自扫门前雪，莫管他人瓦上霜","pinyin":"gè rén zì sǎo mén qián xuě，mò guǎn tā rén wǎ shàng shuāng","abbr":"grzsmqxmgtrwss","explanation":"莫管：不要管。比喻不要多管闲事。","source":{"text":"自家扫取门前雪，莫管他人屋上霜。","book":"宋·陈元靓《事林广记·警世格言》"},"example":{"text":"然而也有经过许多人经验之后，倒给了后人坏影响的，如俗语说“～”的便是其一。","book":"鲁迅《南腔北调集·经验》"},"similar":["各人自扫门前雪，休管他人瓦上霜"],"usage":"作宾语、定语、分句；用于处世"},{"id":10969,"word":"各人自扫门前雪，莫管他家瓦上霜","pinyin":"gè rén zì sǎo mén qián xuě，mò guǎn tā jiā wǎ shàng shāng","abbr":"grzsmqxmgtjwss","explanation":"比喻每人只管自己的事，不管别人的事。","source":{"text":"王定拜别三官而去。正是：各人自扫门前雪，莫管他家瓦上霜。","book":"《警世通言·玉堂春落难逢夫》"},"example":{"text":"现在就以‘～’来做例子罢，这乃是被压迫者们的格言。","book":"鲁迅《南腔北调集·谚语》"},"similar":["各人自扫门前雪，莫管他人瓦上霜"],"usage":"作宾语、定语、分句；用于处世"},{"id":10970,"word":"各从其志","pinyin":"gè cóng qí zhì","abbr":"gcqz","explanation":"从：听任；志：志向。各人执照各人的意志行事。","source":{"text":"道不同，不相为谋，亦各从其志也。","book":"《史记·伯夷列传》"},"example":{"text":"如以实权为难舍，以虚号为可娱，则解释法律，正复多端，亦～而已。","book":"蔡东藩、许廑父《民国通俗演义》第一百三十五回"},"similar":["各行其志"],"usage":"作谓语、宾语；指各人依照各人的意志行事"},{"id":10971,"word":"各从其类","pinyin":"gè cóng qí lèi","abbr":"gcql","explanation":"从，归属；类：种类。指人或事物按其优劣、种类聚集在一起。","source":{"text":"本乎天者亲上，本于地者亲下，则各从其类也。","book":"《周易·乾》"},"example":{"text":"路遥《平凡的世界》第六卷第31章：“人，昆虫，飞禽，走兽，～，相依为命，有生有灭。”"},"similar":["物以类聚"],"usage":"作宾语、定语；用于人或事物等"},{"id":10972,"word":"各从所好","pinyin":"gè cóng suǒ hào","abbr":"gcsh","explanation":"从：顺从，听从。各自按照自己的爱好去做事情。","source":{"text":"各从所好，各骋所长，无一人之不中用。","book":"明·李贽《焚书·答耿中丞》"}},{"id":10973,"word":"各以所长，相轻所短","pinyin":"gè yǒu suǒ cháng，xiāng qīng suǒ duǎn","abbr":"gyszxqsd","explanation":"长：长处；短：不足。各自以自己的长处，轻视别人的不足之处。","source":{"text":"夫人善于自见，而文非一体，鲜能备善，是以各以所长，相轻所短。","book":"三国·魏·曹丕《典论·论文》"},"example":{"text":"但我们现在所处的并非汉魏之际，也不必恰如那时的文人，一定要“～。”","book":"鲁迅《“文人相轻”》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":10974,"word":"各别另样","pinyin":"gè bié lìng yàng","abbr":"gbly","explanation":"形容与众不同。","source":{"text":"你看宝玉何尝肯念书？你若略一经心，无有不能的。他那一种脾气，也是各别另样。","book":"清·曹雪芹《红楼梦》第一百二十回"}},{"id":10975,"word":"各取所长","pinyin":"gè qǔ suǒ cháng","abbr":"gqsc","explanation":"指要善于运用事物或人本身所具有的长处。","source":{"text":"用人如器，各取所长。","book":"唐·吴兢《贞观政要》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":10976,"word":"各取所需","pinyin":"gè qǔ suǒ xū","abbr":"gqsx","explanation":"各自选取自己所需要的。","source":{"text":"读者们不是一块铁板，他们有各人的看法，他们是‘各取所需’。","book":"巴金《在尼斯》"},"example":{"text":"在这里我们可以～。"},"similar":["各得其所"],"usage":"作谓语、宾语；指各自选取自己所需要的"},{"id":10977,"word":"各司其事","pinyin":"gè sī qí shì","abbr":"gsqs","explanation":"司：主管，经营。各自管好各自的一摊事。","source":{"text":"今日便须派定路数，各司其事。","book":"明·冯梦龙《东周列国志》第八十四回"},"example":{"text":"大堂两旁，堆着无数的墨卷箱，承值书吏，～。","book":"清·文康《儿女英雄传》第三十五回"},"similar":["各尽其责"],"usage":"作谓语；指各自管好各自的一摊事"},{"id":10978,"word":"各司其职","pinyin":"gè sī qí zhí","abbr":"gsqz","explanation":"司：主管，经营；职：职务。每个人尽自己的职责，做好所承担的工作。","source":{"text":"今日便须派定路数，各司其事。","book":"明·冯梦龙《东周列国志》第八十四回"}},{"id":10979,"word":"各奔东西","pinyin":"gè bēn dōng xī","abbr":"gbdx","explanation":"各：各自；奔：奔向。各自走各自的路，借指分手。","source":{"text":"大家撒腿就跑，各奔东西。","book":"清·石玉昆《小五义》第72回"},"example":{"text":"大难当头，他们～。"},"similar":["各奔前程"],"usage":"作谓语、宾语；指分手"},{"id":10980,"word":"各奔前程","pinyin":"gè bèn qián chéng","abbr":"gbqc","explanation":"奔：投向，奔往；前程：前途。各走各的路。比喻各人按不同的志向，寻找自己的前途。","source":{"text":"万户升了边上参将，各奔前程去了。","book":"明·凌濛初《二刻拍案惊奇》卷三十"},"example":{"text":"三爷，年月不对了，我们应当～！","book":"老舍《四世同堂》三十四"},"similar":["分道扬镳"],"opposite":["万众一心","同舟共济"],"usage":"作谓语、宾语；用于人"},{"id":10981,"word":"各如其意","pinyin":"gè rú qí yì","abbr":"grqy","explanation":"如：达到；愿：意愿。每个人都能达到或实现自己的愿望。","source":{"text":"每诏令议义，诸老先生不能言，贾生尽为之对，人人各如其意所欲出，诸生于是乃以为能不及也。","book":"《史记·屈原贾生列传》"},"example":{"text":"我们希望大家～，满载而归。"},"usage":"作谓语、定语；指各自都如愿以偿","story":["汉朝初期大才子贾谊18岁时已经非常有名，跟随河南吴太守进京，孝文帝十分喜欢他，封他为太中大夫。贾谊向孝文帝提出重农抑商等许多良好的建议。因遭到其他大臣的谗言攻击，被下放到长沙做王太傅。后来回京做梁怀王刘楫的老师"]},{"id":10982,"word":"各安本业","pinyin":"gè ān běn yè","abbr":"gaby","explanation":"本业：本职工作。各自安心从事自己的职业，过自己的生活。","source":{"text":"我去高老庄探亲，哥哥去花果山称圣，白龙马归大海成龙……我们都各安生理去也。","book":"明·吴承恩《西游记》第八十二回"},"example":{"text":"凡尔村乡市镇，不用惊惶，士农工商，～。","book":"清·黄小配《洪秀全演义》第三十五回"},"similar":["各安生理"],"usage":"作谓语、宾语；指社会局面"},{"id":10983,"word":"各安生业","pinyin":"gè ān shēng yè","abbr":"gasy","explanation":"各自安心从事自己的职业，过自己的生活。","source":{"text":"我去高老庄探亲，哥哥去花果山称圣，白龙马归大海成龙……我们都各安生理去也。","book":"明·吴承恩《西游记》第八十二回"},"example":{"text":"希望一切外国侨民～，保持秩序。","book":"毛泽东《中国人民解放军布告》"}},{"id":10984,"word":"各安生理","pinyin":"gè ān shēng lǐ","abbr":"gasl","explanation":"生理：指职业和日常生活。各自安心从事自己的职业，过自己的生活。","source":{"text":"我去高老庄探亲，哥哥去花果山称圣，白龙马归大海成龙……我们都各安生理去也。","book":"明·吴承恩《西游记》第八十二回"},"example":{"text":"～的日子也就是和平的保证"},"similar":["各安本业"],"usage":"作谓语、宾语、定语；指社会局面"},{"id":10985,"word":"各就各位","pinyin":"gè jiù gè wèi","abbr":"gjgw","explanation":"各自到自己的岗位上。","source":{"text":"所有的人已各就各位，摆好了阵势。","book":"徐迟《汉水桥头》"},"example":{"text":"～，预备，出发！"},"similar":["各尽其责"],"usage":"作谓语、分句；指各自做自己应该做的事"},{"id":10986,"word":"各尽其责","pinyin":"gè jìn qí zé","abbr":"gjqz","explanation":"各：各自，每个；尽：完全；责：职责。指每个人要尽到自己的职责。","example":{"text":"我们要～，团结一致。"},"similar":["各司其职"],"usage":"作宾语、定语；指各自完成自己的使命"},{"id":10987,"word":"各尽所能","pinyin":"gè jìn suǒ néng","abbr":"gjsn","explanation":"尽：用尽；能：才能。各人尽自己的能力去做。","source":{"text":"汉遭秦余，礼坏乐崩，且因循故事，未可观省，有知其说者，各尽所能。","book":"《后汉书·曹褒传》"},"example":{"text":"其次，是许多人梦想着将来的好社会，“～”呀，“大同世界”呀，很有些“越轨”气息了。","book":"鲁迅《南腔北调集·听说梦》"},"usage":"作谓语；指各人尽自己的能力去做"},{"id":10988,"word":"各尽所能，按劳分配","pinyin":"gè jìn suǒ néng，àn láo fēn pèi","abbr":"gjsnalfp","explanation":"社会主义社会个人生活资料的分配原则，劳动者尽其所能地为社会劳动，社会按照各个劳动者提供的劳动数量和质量分配生活资料。","example":{"text":"社会主义的～的原则不能改变。"},"usage":"作谓语、宾语、定语；用于政策等"},{"id":10989,"word":"各尽所能，按需分配","pinyin":"gè jìn suǒ néng，àn xū fēn pèi","abbr":"gjsnaxfp","explanation":"共产主义社会个人生活资料的分配原则，劳动者尽其所能地为社会劳动，社会根据各人的需要来进行分配。","example":{"text":"～的社会最终会实现。"},"usage":"作谓语、宾语、定语；用于政策等"},{"id":10990,"word":"各式各样","pinyin":"gè shì gè yàng","abbr":"gsgy","explanation":"指多种不同的式样、种类或方式。","source":{"text":"毒太阳晒得马路上的柏油发软，汽车轮辗过，就印成了各式各样的花纹。","book":"茅盾《子夜》十二"},"example":{"text":"儿童乐园里的玩具～，真是好玩极了。"},"similar":["多种多样"],"usage":"作定语；指多种多样"},{"id":10991,"word":"各得其宜","pinyin":"gè dé qí yí","abbr":"gdqy","explanation":"指人或事物都得到适当的安置。","source":{"text":"圣王在上，图德而定次，量能而授官，皆使民载其事而各得其宜。","book":"《荀子·正论》"},"example":{"text":"请以漳水为一渎，并前为五。以淮水配西岳，漳水配北岳，济水配中岳，庶随正方，～，阴阳克和，风雨时若。","book":"唐·封演《封氏闻见记·漳渎》"},"similar":["各得其所"],"usage":"作谓语；指各人都得到满足"},{"id":10992,"word":"各得其所","pinyin":"gè dé qí suǒ","abbr":"gdqs","explanation":"原指各人都得到满足。后指每个人或事物都得到恰当的位置或安排。","source":{"text":"日中为市，致天下之民，聚天下之货，交易而退，各得其所。","book":"《周易·系辞下》"},"example":{"text":"全国人民都要有说话的机会，都要有衣穿，有饭吃，有事做，有书读，总之是要～。","book":"毛泽东《在陕甘宁边区参议会的演说》"},"similar":["各取所需"],"opposite":["乱点鸳鸯"],"usage":"作谓语、定语；指各人都得到满足","story":["汉武帝处死妹妹隆虑公主的独生子昭平君，以维护法律的公正性，但心中一直郁郁寡欢。东方朔在酒宴上向武帝敬酒安慰说：“赏功不论仇敌，罚罪不论骨肉，陛下这样做是天下人的幸福。”武帝事后责备东方朔，东方朔说这于公于私均好"]},{"id":10993,"word":"各打五十大板","pinyin":"gè dǎ wǔ shí dà bǎn","abbr":"gdwsdb","explanation":"各：各自。给双方同样的待遇或不分清责任，让双方共同承担责任。","example":{"text":"他办案总是不分青红皂白，～。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":10994,"word":"各执一词","pinyin":"gè zhí yī cí","abbr":"gzyc","explanation":"执：坚持。各人坚持各人的说法。形容意见不一致。","source":{"text":"两下各执一词，难以定招。","book":"明·冯梦龙《醒世恒言》卷二十九"},"example":{"text":"辩论会上，双方～，争执不下。"},"similar":["各执己见"],"usage":"作谓语；形容意见不一致"},{"id":10995,"word":"各执己见","pinyin":"gè zhí jǐ jiàn","abbr":"gzjj","explanation":"各人都坚持自己的意见。","source":{"text":"凡中书有军国政事，则中书舍人各执所见，杂署其名，谓之五花判事。","book":"宋·钱易《南部新书·乙》"},"example":{"text":"两人终日谈论，～，不相上下。","book":"明·北梦龙《古今小说·明悟禅师赶五戒》"},"similar":["各持己见"],"usage":"作谓语；指各人都坚持自己的意见"},{"id":10996,"word":"各执所见","pinyin":"gè zhí suǒ jiàn","abbr":"gzsj","explanation":"执：坚持。各自坚持自己的观点和意见。","source":{"text":"凡中书有军国政事，则中书舍人各执所见，杂署其名。","book":"宋·钱易《南部新书》"},"similar":["各持己见"],"usage":"作谓语、宾语、定语；指意见分歧"},{"id":10997,"word":"各抒己见","pinyin":"gè shū jǐ jiàn","abbr":"gsjj","explanation":"抒：抒发，发表。各人充分发表自己的意见。","source":{"text":"先儒穿凿，各伸己见，皆托古圣贤之名以信其语，故其所记各不同也。","book":"唐·李翱《李文权文集·陵庙日时朔祭议》"},"example":{"text":"据我主意，何不～，出个式子，岂不新鲜些？","book":"清·李汝珍《镜花缘》第七十四回"},"similar":["各持己见","各抒所见","畅所欲言"],"opposite":["众口一词"],"usage":"作谓语、定语；指各人充分发表自己的意见"},{"id":10998,"word":"各抒所见","pinyin":"gè shū suǒ jiàn","abbr":"gssj","explanation":"各人充分发表自己的意见。同“各抒己见”。","source":{"text":"中国历代帝王继统，分有常尊，然而明良喜起，吁咈庚歌，往往略分言情，各抒所见。","book":"郑观应《盛世危言·议院》"},"example":{"text":"际兹一发千钧，全国国民宜各立所志，各尽所能，～。","book":"鲁迅《二心集·沉滓的泛起》引叶华文"},"similar":["各抒己见"],"usage":"作谓语、定语；指各人充分发表自己的意见"},{"id":10999,"word":"各持己见","pinyin":"gè chí jǐ jiàn","abbr":"gcjj","explanation":"持：抓住不放。各人都坚持自己的意见。","source":{"text":"凡中书有军国政事，则中书舍人各执所见，杂署其名，谓之五花判事。","book":"宋·钱易《南部新书·乙》"},"example":{"text":"然此辈执术疏，谋生急，信口欺诈，言人人殊，甚至徒毁其师，子讥其父，～，彼此相非。","book":"清·黄钧宰《金壶七墨·堪舆》"},"similar":["各抒己见","各执一词"],"opposite":["众口一词"],"usage":"作谓语；用于讨论问题"},{"id":11000,"word":"各擅胜场","pinyin":"gè shàn shèng chǎng","abbr":"gssc","explanation":"擅：独占；胜场：胜利之场所。各自占有胜利的位置。形容技艺精湛，各有所长。","source":{"text":"秦政利觜长虎，终得擅场。","book":"汉·张衡《东京赋》"},"usage":"作谓语、定语；指人的本事等"},{"id":11001,"word":"各显神通","pinyin":"gè xiǎn shén tōng","abbr":"gxst","explanation":"比喻在各自工作中显身手。","source":{"text":"正是八仙过海，独自显神通。","book":"明·吴承恩《西游记》第81回"},"similar":["八仙过海"],"usage":"作谓语、宾语；比喻个人有自己的本领"},{"id":11002,"word":"各显身手","pinyin":"gè xiǎn shēn shǒu","abbr":"gxss","explanation":"显：表现；身手：本领。各自显示自己的本领。","source":{"text":"正是弟兄们各显身手的时期。","book":"清·曾朴《孽海花》第二十五回"},"similar":["各显神通"],"usage":"作谓语、定语；用于口语"},{"id":11003,"word":"各有利弊","pinyin":"gè yǒu lì bì","abbr":"gylb","explanation":"利：好处；弊：坏处。事物各自所起的作用用好也有坏。","source":{"text":"这些办法，这些道路，对我们当时情况又各有利弊。","book":"刘少奇《论党内斗争》"},"example":{"text":"这事的几种处理方法～。"},"usage":"作谓语；指有好处也有坏处"},{"id":11004,"word":"各有千秋","pinyin":"gè yǒu qiān qiū","abbr":"gyqq","explanation":"千秋：千年，引伸为久远。各有各的存在的价值。比喻各人有各人的长处，各人有各人的特色。","source":{"text":"嘉会难再遇，三载为千秋。","book":"汉·李陵《与苏武三首》"},"example":{"text":"中国抒情诗与叙事诗一向同样地发展，～的呵。","book":"茅盾《〈诗论〉管窥》"},"similar":["各有所长"],"opposite":["一无是处"],"usage":"作谓语、宾语；指各有优点和特色","story":["传说彭祖是颛顼的第二代孙子，彭祖的父亲陆终娶了鬼方氏的女儿女贵。女贵怀孕三年，从腋窝生下6个儿子。彭祖是其中之一，姓坚名铿，传说他活了800多岁。传说中的寿星活了1000多岁，有歇后语“彭祖遇寿星——各有千秋。"]},{"id":11005,"word":"各有巧妙不同","pinyin":"gè yǒu qiǎo miào bù tóng","abbr":"gyqmbt","explanation":"比喻为人做事像变戏法，各自有其灵巧奥妙的变化。","source":{"text":"个别谈话……或先软后硬，或先硬后软，或忽硬忽软，各有巧妙不同。","book":"《上饶集中营·炼狱杂记》"},"usage":"作谓语、分句；用于说话等"},{"id":11006,"word":"各有所好","pinyin":"gè yǒu suǒ hào","abbr":"gysh","explanation":"好：爱好。各人有各人的爱好。指人的爱好出自人的本性，只应听其自然。","source":{"text":"缅怀云岩路，欲往无由缘；物各有所好，违之伤自然。","book":"唐·萧颖士《仰答韦司业垂访五首》"},"example":{"text":"～，我们不必强求他。"},"similar":["各有所爱"],"usage":"作谓语、宾语；指各自的兴趣不同"},{"id":11007,"word":"各有所爱","pinyin":"gè yǒu suǒ ài","abbr":"gysa","explanation":"爱：喜爱，爱好。各人有各人的爱好。指人的爱好出自人的本性。","example":{"text":"～，我们不要强求他这样。"},"similar":["各有所好"],"usage":"作谓语、宾语；指各自的兴趣不同"},{"id":11008,"word":"各有所短","pinyin":"gè yǒu suǒ duǎn","abbr":"gysd","explanation":"短：不足。各有各的不足。","source":{"text":"……及孙王离为项羽所虏，不亦宜乎！彼各有所短也。","book":"《史记·白起王翦列传》"},"opposite":["各有所长"],"usage":"作宾语、谓语；一般多指人才而言"},{"id":11009,"word":"各有所职","pinyin":"gè yǒu suǒ zhí","abbr":"gysz","explanation":"各人有各人负责的事。比喻分工明确。","source":{"text":"各有所职，而百事举。","book":"《周礼·天官·冢宰》"},"example":{"text":"～，我们可以按部就班了。"},"similar":["各尽其职"],"usage":"作谓语、宾语、分句；比喻分工明确"},{"id":11010,"word":"各有所能","pinyin":"gè yǒu suǒ néng","abbr":"gysn","explanation":"能：才能。各有各的才能、优点。一般多指人才而言。","source":{"text":"龙舟整楫，王良不能执也；骥騄骑行，越人不敢越也，各有所能。","book":"晋·傅玄《傅子》"}},{"id":11011,"word":"各有所长","pinyin":"gè yǒu suǒ chéng","abbr":"gysc","explanation":"长：长处、优点。各有各的长处、优点。一般多指人才而言。","source":{"text":"而获亲近，非独色爱，能亦各有所长。","book":"西汉·司马迁《史记·太史公自序》"},"example":{"text":"虽～，皆不免著于一偏。","book":"清·刘熙载《艺概·文概》"},"similar":["各有特长"],"opposite":["各有所短"],"usage":"作宾语、谓语；一般多指人才而言"},{"id":11012,"word":"各种各样","pinyin":"gè zhǒng gè yàng","abbr":"gzgy","explanation":"具有多种多样的特征或具有各不相同的种类。","source":{"text":"各种各样的人，抱着各种各样的想法，川流不息地来访。","book":"罗瑞卿《西安事变与周恩来同志》"},"example":{"text":"社会上的人～。"},"similar":["各式各样","多种多样"],"usage":"作谓语、定语；形容种类多"},{"id":11013,"word":"各自一家","pinyin":"gè zì yī jiā","abbr":"gzyj","explanation":"各自成为一家。指原本就不是一家。","source":{"text":"元起常资给先主，元起妻曰：‘各自一家，何能常尔耶。’","book":"《蜀志·先主传》"}},{"id":11014,"word":"各自为战","pinyin":"gè zì wéi zhàn","abbr":"gzwz","explanation":"各自成为独立的单位进行战斗。","source":{"text":"君王能自陈以东傅海，尽与韩信；睢阳以北至谷城，以与彭越；使各自为战，则楚易败也。","book":"《史记·项羽本纪》"},"example":{"text":"后来他们被敌人隔开，～。","book":"姚雪垠《李自成》第二卷第二十六章"},"similar":["各自为政"],"usage":"作谓语；指各自独立行战"},{"id":11015,"word":"各自为政","pinyin":"gè zì wéi zhèng","abbr":"gzwz","explanation":"为政：管理政事，泛指行事。各自按自己的主张办事，不互相配合。比喻不考虑全局，各搞一套。","source":{"text":"畴昔之羊，子为政，今日之事，我为政。","book":"《诗经·小雅·节南山》：“不自为政，卒劳百姓。”《左传·宣公二年》"},"example":{"text":"诸将专威于外，～，莫或同心。","book":"《三国志·吴志·胡综传》"},"similar":["各自为营"],"opposite":["同心协力","群策群力","步调一致"],"usage":"作谓语、定语；形容互相都不配合","story":["公元前607年，郑国出兵攻打宋国，宋国派华元为主帅，统率宋军前去迎战。华元为鼓舞士气，杀羊犒劳将士，忙乱中忘了给他的马夫羊斟，羊斟怀恨在心，交战时说分羊肉你说了算驾车我说了算，就把华元和战车开往郑国军营投降"]},{"id":11016,"word":"各色人等","pinyin":"gè sè rén děng","abbr":"gsrd","explanation":"色：种类；人等：人们。社会上各种职业各个阶层的人们。","source":{"text":"各色人等，务望各安本分，勿再稍事纷扰，自召虚惊。","book":"蔡东藩、许廑父《民国通俗演义》第六十一回"},"usage":"作主语、宾语、定语；指不同的人"},{"id":11017,"word":"各色各样","pinyin":"gè sè gè yàng","abbr":"gsgy","explanation":"色：种类。各种类别，各种式样。","source":{"text":"却说盛公子一派话儿，把官亲投任的人，各色各样，形容的一个详而且尽。","book":"清·李绿园《歧路灯》第87回"},"example":{"text":"那天楼底下坐着许多老百姓，男女老少，～的人物都有。","book":"冯玉祥《我的生活》第34章"},"similar":["各种各样","各式各样"],"usage":"作定语；指各种类别，各种式样"},{"id":11018,"word":"各色名样","pinyin":"gè sè gè yàng","abbr":"gsmy","explanation":"色：种类。各种类别，各种式样。","source":{"text":"却说盛公子一派话儿，把官亲投任的人，各色名样，形容的一个祥而且尽。","book":"清·李绿园《歧路灯》第八十七回"}},{"id":11019,"word":"各行其志","pinyin":"gè xíng qí zhì","abbr":"gxqz","explanation":"各人执照各人的意志行事。同“各从其志”。","source":{"text":"尉迟运惧，私谓孝伯曰：‘吾徙必不免祸，奈何？’孝伯曰：‘今堂上有老母，地下有武帝，为臣为子，知欲何之！且委质事人，本徇名义，谏而不入，将焉逃死？足下若为身计，宜远之。’于是各行其志。","book":"《北史·宇文孝伯传》"},"example":{"text":"范景仁与温公为异性兄弟，心未尝不合，元祐出处，～，不失为同也，人安得议其优劣？","book":"宋·戴埴《鼠璞·温公申公议论》"},"similar":["各从其志"],"usage":"作谓语、宾语；用于处事"},{"id":11020,"word":"各行其是","pinyin":"gè xíng qí shì","abbr":"gxqs","explanation":"行：做，办；是：对的。按照各自认为对的去做。比喻各搞一套。","source":{"text":"天下非有公是也，而各是其所是。","book":"《庄子·徐无鬼》"},"example":{"text":"我之求死，你之求生，是～。","book":"清·吴趼人《痛史》第二十一回"},"similar":["各谋其是","各自为政"],"opposite":["同心同德","同心协力","戮力同心"],"usage":"作谓语、宾语；指各自为政"},{"id":11021,"word":"各行其道","pinyin":"gè xíng qí dào","abbr":"gxqd","explanation":"各自按照自己的轨迹行走或按认为对的去做。","source":{"text":"当我们纷纷走向了社会，在人生旅途上各行其道，殊途不同归。","book":"王朔《动物凶猛》"},"example":{"text":"大家～，彼此不干扰。"},"similar":["各行其是"],"usage":"作谓语、宾语；用于事物之间"},{"id":11022,"word":"各行各业","pinyin":"gè háng gè yè","abbr":"ghgy","explanation":"泛指所有的人所从事的各种行业。","source":{"text":"过去我们想请各行各业开个名单，提高一些人的工资，说了好久，只是停留在口头上，没有实现。","book":"邓小平《办好学校，培养干部》"},"example":{"text":"～都出现新气象。"},"similar":["七十二行"],"usage":"作主语、宾语、定语；指各种行业"},{"id":11023,"word":"各言其志","pinyin":"gè yán qí zhì","abbr":"gyqz","explanation":"各自表明自己的愿望和志向。"},{"id":11024,"word":"各门另户","pinyin":"gè mén lìng hù","abbr":"gmlh","explanation":"各自立有自己的门户。指一个大家庭已分成一个个小家庭，各自独立。","source":{"text":"这是俺姐姐请你，各门另户的，有什么碍处。","book":"清·西周生《醒世姻缘传》第六十四回"},"example":{"text":"清·西周生《醒世姻缘传》第64回：“这是俺姐姐请你，～的，有什么碍处？”"},"similar":["各门各户"],"usage":"作宾语、定语；用于口语"},{"id":11025,"word":"各门各户","pinyin":"gè mén gè hù","abbr":"gmgh","explanation":"各自立有自己的门户。指一个大家庭已分成一个个小家庭，各自独立。","source":{"text":"各门各户的，你有本事排揎你们那边的人去。","book":"清·曹雪芹《红楼梦》第七十一回"},"similar":["各门另户"],"usage":"作宾语、定语；用于口语"},{"id":11026,"word":"各随其好","pinyin":"gè suí qí hào","abbr":"gsqh","explanation":"随：随顺；好：爱好。使每个人都顺随自己的爱好。"},{"id":11027,"word":"各霸一方","pinyin":"gè bà yī fāng","abbr":"gbyf","explanation":"各：各自；霸：强横占据。指凭借势力各自称霸一个地方。","source":{"text":"方今天下分崩，英雄并起，各霸一方。","book":"明·罗贯中《三国演义》第73回"},"example":{"text":"他们～，形成‘国中之国’，省政府无权过问。","book":"陶菊隐《北洋军阀统治时期史话》第43章"},"similar":["割据一方"],"usage":"作谓语、宾语、定语；用于地方势力等"},{"id":11028,"word":"各骋所长","pinyin":"gè chěng suǒ cháng","abbr":"gcsz","explanation":"骋：驰骋，引申为发挥。每个人都充分发挥自己的特长。","source":{"text":"各从所好，各骋所长，无一人之不中用。","book":"明·李贽《焚书·答耿中丞》"}},{"id":11029,"word":"吆五喝六","pinyin":"yāo wǔ hè liù","abbr":"ywhl","explanation":"掷骰子时的喊声(五、六是骰子的点子)，泛指赌博时的喧哗声。","source":{"text":"你这个将军，好不知事务，只管的吆五喝六，叫我如何使出这盘头盖顶来？","book":"清·钱彩《说岳全传》第48回"},"example":{"text":"他整天～也不嫌累。"},"similar":["吆三喝四"],"usage":"作谓语、定语；指大声呵斥"},{"id":11030,"word":"合不拢嘴","pinyin":"hé bù lǒng zuǐ","abbr":"hblz","explanation":"指人高兴得关不住嘴。","source":{"text":"他父母亲又会怎样高兴得合不拢嘴巴……","book":"路遥《平凡的世界》第六卷第32章"},"example":{"text":"他的一个笑话逗得大家～。"},"usage":"作状语；形容人的欢笑等"},{"id":11031,"word":"合两为一","pinyin":"hé liǎng wéi yī","abbr":"hlwy","explanation":"指将两者合为一个整体。同“合二为一”。","source":{"text":"合两坊而为一宅。","book":"《后汉书·杨震传》：“伏见诏书为阿母兴起津城门内第舍，，连里竟街，雕修缮饰，穷极巧伎。”李贤注"},"similar":["合而为一","合二为一"],"opposite":["一分为二"],"usage":"作谓语；指两个事物合成一个"},{"id":11032,"word":"合二为一","pinyin":"hé èr wéi yī","abbr":"hewy","explanation":"指将两者合为一个整体。","source":{"text":"一人劈面来，急走如飞，势甚猛，傅不及避，两胸相撞，竟与己身合二为一。","book":"清·袁枚《新齐谐·佟觭角》"},"example":{"text":"我们要把这两个车间～。"},"similar":["合两为一"],"opposite":["一分为二"],"usage":"作谓语、宾语；指将两者合为一个整体"},{"id":11033,"word":"合从连横","pinyin":"hé zòng lián héng","abbr":"hclh","explanation":"从：通“纵”；横：通“衡”。泛指纵横捭阖的手段。","source":{"text":"约从连横，兵革不藏。","book":"西汉·刘向《战国策·秦策》"},"example":{"text":"天下方务于～，以攻伐为贤。","book":"西汉·司马迁《史记·孟子荀卿列传》"},"similar":["合纵连横"],"usage":"作宾语、定语；用于书面语"},{"id":11034,"word":"合从连衡","pinyin":"hé zòng lián héng","abbr":"hzlh","explanation":"从：通“纵”；衡：通“横”。指联合抗敌。","source":{"text":"约从连横，兵革不藏。","book":"《战国策·秦策一》"},"example":{"text":"陵夷至于战国，天下分而为七，～，经数十年，秦遂并兼四海。","book":"《汉书·地理志上》"},"similar":["合从连横"],"usage":"作宾语、定语；指联合抗敌","story":["战国时期，诸侯之间战争频起，闹得兵荒马乱，人们不能安居乐业。秦国十分强大，对齐、楚、燕、韩、赵、魏六国虎视耽耽。为了阻止秦国的吞并，苏秦到六国去游说他们联合起来对抗秦国的进攻。而张仪则游说六国向秦国俯首称臣"]},{"id":11035,"word":"合刃之急","pinyin":"hé rèn zhī jí","abbr":"hrzj","explanation":"合刃：兵器的锋刃碰在了一起，指交战。指战斗到了最激烈最危急的时刻。也形容事情发展到了最危急的时刻。","source":{"text":"臣又闻用兵临战，合刃之急者三。","book":"《汉书·晁错传》"}},{"id":11036,"word":"合则留，不合则去","pinyin":"hé zé liú，bù hé zé qù","abbr":"hzlbhzq","explanation":"指脾气相投或意见一致，就在一起共事，反之则离开。","source":{"text":"增年已七十，合则留，不合则去。不以此时明去就之分，而欲依项羽以成功名，陋也。","book":"宋·苏轼《范增论》"},"example":{"text":"诤而不听，～，此吾夫子所以……不脱冕而行也。","book":"清·文康《儿女英雄传》第三十七回"},"usage":"作定语、分句；用于处事"},{"id":11037,"word":"合家欢","pinyin":"hé jiā huān","abbr":"hjh","explanation":"全家老小合拍的照片。","source":{"text":"刘芝田做上海道的时候，出五百银子，请他画一张合家欢。","book":"清·吴趼人《二十年目睹之怪现状》第37回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第37回：“刘芝田做上海道的时候，出五百银子，请他画一张～。”"},"similar":["全家福"],"usage":"作主语、宾语、定语；用于口语"},{"id":11038,"word":"合心合意","pinyin":"hé xīn hé yì","abbr":"hxhy","explanation":"犹称心如意。","source":{"text":"你还装什么呆。你难道不知道林姑爷升了湖北的粮道，娶了一位继母，十分合心合意。","book":"清·曹雪芹《红楼梦》第八十二回"}},{"id":11039,"word":"合情合理","pinyin":"hé qíng hé lǐ","abbr":"hqhl","explanation":"符合情理。","source":{"text":"黄为民心情显得轻松，觉得周祺这个人很可爱，既有原则，又能合情合理地帮助他解除思想包袱。","book":"陈残云《山谷风烟》第11章"},"example":{"text":"学校认为这个方案～，就定为制度。","book":"柯岩《特邀代表》"},"opposite":["不合情理"],"usage":"作谓语、状语、宾语；指符合情理"},{"id":11040,"word":"合抱之木，生于毫末","pinyin":"hé bào zhī mù，shēng yú háo mò","abbr":"hbzmsyhm","explanation":"合抱：两臂围拢，形容树粗大；毫末：指幼苗，比喻细小。粗大的树木都是由小树苗长成的。比喻大事是由小事逐渐发展演变而来的。","source":{"text":"合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。","book":"《老子》第六十四章"}},{"id":11041,"word":"合浦珠还","pinyin":"hé pǔ zhū huán","abbr":"hpzh","explanation":"合浦：汉代郡名，在今广西合浦县东北。比喻东西失而复得或人去而复回。","source":{"text":"（合浦）郡不产谷实，而海出珠宝，与交阯比境……尝到官，革易前敝，求民病利。曾未逾岁，去珠复还，百姓皆反其业。","book":"《后汉书·循吏传·孟尝》"},"example":{"text":"我当时虽失的一件无足重轻的东西，究竟能够～，我心里总觉喜欢得很。","book":"《晚清文学丛钞·冷眼观》第十五回"},"similar":["物归原主","合浦还珠","汶阳田反"],"usage":"作宾语；比喻物归原主或人去而复归","story":["东汉时期，合浦郡盛产珍珠闻名海外，当地老百姓以采珠为生，贪官污吏趁机盘剥，使得珠民大肆捕捞，珠蚌产量越来越低，饿死不少人。汉顺帝刘保派孟尝当合浦太守，他革除弊端，不准滥捕。不到一年，合浦又盛产珍珠了"]},{"id":11042,"word":"合浦还珠","pinyin":"hé pǔ huán zhū","abbr":"hphz","explanation":"比喻东西失而复得或人去而复回。同“合浦珠还”。","source":{"text":"今分一颗与你带去，我自留一颗，以寓合浦还珠之意。","book":"明·沈鲸《双珠记·母子分珠》"},"example":{"text":"～自有时，惊危目下且安之。","book":"《初刻拍案惊奇》卷八"},"similar":["合浦珠还"],"usage":"作宾语；比喻物归原主或人去而复归","story":["东汉时期，合浦郡盛产珍珠闻名海外，当地老百姓以采珠为生，贪官污吏趁机盘剥，使得珠民大肆捕捞，珠蚌产量越来越低，饿死不少人。汉顺帝刘保派孟尝当合浦太守，他革除弊端，不准滥捕。不到一年，合浦又盛产珍珠了"]},{"id":11043,"word":"合盘托出","pinyin":"hé pán tuō chū","abbr":"hptc","explanation":"指全部显露或说出。","source":{"text":"鄙夫欣羡之眼，败家妇不足之心，合盘托出。","book":"清·李光庭《乡言解颐·地部·婚姻》"},"example":{"text":"我很为你恳挚纯真的感情，无保留～的气度和敏锐深入的思考所打动。","book":"刘心武《写在水仙花旁》"},"similar":["和盘托出","直言不讳","畅所欲言"],"opposite":["含糊其词"],"usage":"作谓语；比喻全都讲出来"},{"id":11044,"word":"合眼摸象","pinyin":"hé yǎn mō xiàng","abbr":"hymx","explanation":"闭着眼睛摸象。比喻盲目行事。","source":{"text":"山谷云：‘诗词高胜，要从学问中来。后来学诗者，虽时有妙句，譬如合眼摸象，随所触体得一处。’","book":"宋·胡仔《苕溪渔隐丛话前集·山谷上》"},"usage":"作宾语、定语；用于比喻句"},{"id":11045,"word":"合而为一","pinyin":"hé ér wéi yī","abbr":"hewy","explanation":"把散乱的事物合在一起。","source":{"text":"臣为王虑，莫若善楚。秦楚合而为一以临韩，韩必敛手。","book":"《史记·春申君列传》"},"example":{"text":"学者能集众长～，若易牙以五味调和，则为全味矣。","book":"明·谢榛《四溟诗话》第三卷"},"similar":["合二为一","水乳交融"],"opposite":["分而为二","一分为二"],"usage":"作谓语；指两个或更多的事物合成一个"},{"id":11046,"word":"合胆同心","pinyin":"hé dǎn tóng xīn","abbr":"hdtx","explanation":"犹言同心同德。","source":{"text":"和气自然兄弟众，合胆同心拜五人。","book":"《共同和合歌》"},"example":{"text":"兄弟们～，没有战胜不了的困难。"},"similar":["同心同德"],"usage":"作谓语、定语；指齐心"},{"id":11047,"word":"合衷共济","pinyin":"hé zhōng gòng jì","abbr":"hzgj","explanation":"犹言同心协力。","source":{"text":"进步党亦感两党提携之必要，故遇事胥能合衷共济。","book":"谢彬《民国政党史》第四节"},"similar":["和衷共济"],"usage":"作谓语、定语、状语；比喻同心协力"},{"id":11048,"word":"吉丢古堆","pinyin":"jí diū gǔ duī","abbr":"jdgd","explanation":"形容波涛汹涌澎湃的声音。","example":{"text":"我喜欢聆听大海～的涛声。"},"usage":"作定语；用于声音"},{"id":11049,"word":"吉人天相","pinyin":"jí rén tiān xiàng","abbr":"jrtx","explanation":"吉人：善人；相：帮助，保佑。迷信的人认为好人会得到天的帮助。多用作对别人的患病或遇到困难、不幸的安慰话。","source":{"text":"晋楚唯天所相，不可与争。","book":"《左传·宣公三年》：“石癸曰：‘吾闻，姬、姞耦，其子孙必蕃。姞，吉人也。’”又《昭公四年》"},"example":{"text":"既然庚贴返去，原聘也必然还璧。但～，令郎尊恙，终有好日，还要三思而行。","book":"明·冯梦龙《醒世恒言》卷九"},"similar":["大吉大利","官运亨通"],"opposite":["多灾多难","祸不单行","恶有恶报"],"usage":"作宾语、分句；用于祝福或感叹"},{"id":11050,"word":"吉人自有天相","pinyin":"jí rén zì yǒu tiān xiàng","abbr":"jrzytx","explanation":"相：帮助，保佑。谓天佑善人。同“吉人天相”。","source":{"text":"吉人自有天相，小姐请自宽心。","book":"明·冯梦龙《醒世恒言》第二十五卷：“自古道：‘吉人自有天相。’遐叔正在帅府门首叹气，傍边忽转过一个道士问道：‘君子何叹？’”清·李渔《意中缘·拒妁》"},"example":{"text":"二姨太太道：“他的心术，你们难道不知？自古道：‘～。’任他怎么做去，我只是不管。”","book":"清·黄小配《廿载繁华梦》第六回"},"similar":["吉人天相"],"usage":"作宾语、定语；用于宽慰处境艰危的人"},{"id":11051,"word":"吉光凤羽","pinyin":"jí guāng fèng yǔ","abbr":"jgfy","explanation":"吉光与凤凰的毛羽。比喻艺术珍品。","source":{"text":"吾所缀集，皆待诏中年以后书，真吉光凤羽，缉而成裘，后人其宝守之。","book":"明·王世贞《题三吴楷法十册》之六"},"similar":["吉光片羽","吉光片裘"],"usage":"作主语、宾语；用于比喻句"},{"id":11052,"word":"吉光片羽","pinyin":"jí guāng piàn yǔ","abbr":"jgpy","explanation":"吉光：古代神话中的神兽名；片羽：一片毛。比喻残存的珍贵文物。","source":{"text":"武帝时西域献吉光裘，入水不濡。","book":"汉·刘歆《西京杂记》卷一"},"example":{"text":"祖宗诗文，在旁人观之，不过行云流水，我们后辈视之，～，皆金玉珠贝。","book":"清·李绿园《歧路灯》第九十二回"},"similar":["无价之宝","凤毛麟角","奇珍异宝"],"usage":"作宾语、定语、分句；比喻残存的珍贵文物"},{"id":11053,"word":"吉光片裘","pinyin":"jí guāng piàn qiú","abbr":"jgpq","explanation":"比喻残存的珍贵文物。同“吉光片羽”。","source":{"text":"余有宋仲温书子昂《兰亭跋》，诸体皆备，而仅九段，然亦吉光片裘也。","book":"明·陈继儒《妮古录》卷一"},"similar":["吉光片羽"],"usage":"作宾语、定语、分句；比喻残存的珍贵文物"},{"id":11054,"word":"吉凶未卜","pinyin":"jí xiōng wèi bǔ","abbr":"jxwb","explanation":"吉凶：吉利与不吉利，引申为祸福，成败；卜：占卜，引申为预测。无法预测是福是祸、是成是败。","source":{"text":"圣上命我进京，怎敢抗旨？但奸臣在朝，此去吉凶未卜。","book":"清·钱彩《说岳全传》第59回"},"example":{"text":"这次赴京～，你得作好充分的准备。"},"similar":["生死未卜"],"usage":"作谓语、宾语；指无法预测是福是祸"},{"id":11055,"word":"吉凶祸福","pinyin":"jí xiōng huò fú","abbr":"jxhf","explanation":"吉祥、不幸、灾祸、幸福。","source":{"text":"是为吉凶祸福等耳，吾不独受此罪。","book":"晋·陈寿《三国志·吴志·太史慈传》"},"example":{"text":"每个人都有～的。"},"usage":"作宾语、定语；指人的各种境遇"},{"id":11056,"word":"吉少凶多","pinyin":"jí shǎo xiōng duō","abbr":"jsxd","explanation":"凶：不吉利。指估计事态的发展趋势不妙，凶害多，吉利少。","source":{"text":"朝廷大怒，今差国丈庞集领兵到来，只怕吉少凶多，如何是好？","book":"清·无名氏《说呼全传》"},"similar":["凶多吉少"],"usage":"作谓语、定语、宾语；指形势不妙"},{"id":11057,"word":"吉日良时","pinyin":"jí rì liáng shí","abbr":"jrls","explanation":"吉利的日子，美好的时光。同“吉日良辰”。","source":{"text":"子牙对惧留孙曰：‘命土行孙乘今日吉日良时，与邓小姐成亲，何如？’","book":"明·施耐庵《水浒传》第七十一回：“宋江拣了吉日良时，焚一炉香，鸣鼓聚众，都到堂上。”明·许仲琳《封神演义》第五十六回"},"example":{"text":"不到三天，彩云就择定了～，搬进燕庆里。","book":"清·曾朴《孽海花》第三十二回"},"similar":["吉日良辰"],"usage":"作宾语；指好日子"},{"id":11058,"word":"吉日良辰","pinyin":"jí rì liáng chén","abbr":"jrlc","explanation":"吉：吉利；良：好；辰：时日。美好的时辰，吉利的日子。后常用以称宜于成亲的日子。","source":{"text":"吉日兮辰良，穆将愉兮上皇。","book":"战国·楚·屈原《九歌·东皇太一》"},"example":{"text":"则今日是～，辞别了母亲，便索长行也。","book":"元·尚仲贤《柳毅传书》第一折"},"similar":["良辰美景","吉日良时"],"usage":"作宾语；指好日子"},{"id":11059,"word":"吉星高照","pinyin":"jí xīng gāo zhào","abbr":"jxgz","explanation":"吉星：指福、禄、寿三星。吉祥之星高高照临。","source":{"text":"那是他在香港当学徒时刺上的，带有'吉星高照'之意。","book":"陈残云《热带惊涛录》"},"example":{"text":"此后，～，他在政治上将有飞黄腾达的日子。","book":"徐迟《牡丹》"},"similar":["大吉大利","吉祥如意","洪福齐天"],"opposite":["天灾人祸","祸不单行"],"usage":"作主语、宾语、定语；用于书面语"},{"id":11060,"word":"吉祥善事","pinyin":"jí xiáng shàn shì","abbr":"jxss","explanation":"吉利的好事情。","source":{"text":"泽流千世，称之而勿绝，与天下终。岂非道之符，而圣人所谓吉祥善事与？","book":"《战国策·秦策三》"}},{"id":11061,"word":"吉祥如意","pinyin":"jí xiáng rú yì","abbr":"jxry","explanation":"祥：祥瑞。如意称心。多用祝颂他人美满称心。","source":{"text":"为亡父母敬造观音像一区，合家大小八口人等供奉，吉祥如意。","book":"北齐·张成《造像题字》"},"example":{"text":"再休想～，多管是你恶限临逼。","book":"元·无名氏《赚蒯通》第二折"},"similar":["万事亨通","尽如人意","如愿以偿"],"opposite":["多灾多难","事与愿违"],"usage":"作谓语、定语；指吉利祥和，万事如意"},{"id":11062,"word":"吉祥止止","pinyin":"jí xiáng zhǐ zhǐ","abbr":"jxzz","explanation":"第一个止字是留止的意思，第二个止字是助词。指喜庆。","source":{"text":"瞻彼阕者，虚室生白，吉祥止止。","book":"《庄子·人间世》"},"usage":"作谓语、宾语；指喜庆"},{"id":11063,"word":"吉网罗钳","pinyin":"jí wǎng luó qián","abbr":"jwlq","explanation":"比喻酷吏朋比为奸，陷害无辜。","source":{"text":"唐天宝初，李林甫为相，任酷吏吉温、罗希奭为御史。吉罗承李旨意，诬陷异己，制造冤狱，时称“罗钳吉网”。事见《旧唐书·酷吏传下·罗希奭》。"},"example":{"text":"～开阁纳，斧声烛影隔江听。","book":"吴梅《检点》诗"},"similar":["罗钳吉网"],"usage":"作宾语、定语；指酷吏","story":["唐玄宗时期，酷吏吉温与罗希奭善于拍马奉承，得到右丞相李林甫的赏识，让他们掌管刑狱，他们两人办案均根据李林甫的旨意行事，搞“欲加之罪，何患无辞”，帮助李林甫排斥与打击异己，落入他们手中如同被钳夹住或落入网中一样"]},{"id":11064,"word":"吉隆之喜","pinyin":"jí lóng zhī xǐ","abbr":"jlzx","explanation":"吉祥盛大的喜事。","source":{"text":"凶阨之患，吉隆之喜，其术皆出焉。","book":"《汉书·艺文志》"}},{"id":11065,"word":"吊儿浪荡","pinyin":"diào ér làng dàng","abbr":"deld","explanation":"浪荡：放浪。形容散漫放浪。","source":{"text":"知道吗？游击队并不是吊儿浪荡的，游击队是要守纪律的！","book":"姚雪垠《牛全德与红萝卜》"},"similar":["吊儿郎当"],"usage":"作谓语、定语、状语；用于口语中"},{"id":11066,"word":"吊儿郎当","pinyin":"diào er láng dāng","abbr":"deld","explanation":"形容仪容不整，作风散漫，态度不严肃或不认真。","source":{"text":"正说着，石岜吊儿郎当走进后台。","book":"王朔《浮出海面》"},"example":{"text":"你不能总是这样吊儿郎当的好不好？"},"similar":["放荡不羁","不拘小节","玩世不恭"],"opposite":["一本正经","正襟危坐","安分守己"],"usage":"作谓语、定语、状语；用于口语中"},{"id":11067,"word":"吊古伤今","pinyin":"diào gǔ shāng jīn","abbr":"dgsj","explanation":"吊：凭吊。凭吊古迹，追忆往昔，对现今状况有所感伤。","source":{"text":"铺究前史，吊古伤今。","book":"南朝·梁·简文帝《悔赋》"},"example":{"text":"先生采药弄水之暇，得无遇之而与之～欤？（清·黄宗羲《宪副郑平子先生七十寿序》）"},"usage":"作谓语、宾语、定语；用于感怀"},{"id":11068,"word":"吊古寻幽","pinyin":"diào gǔ xún yōu","abbr":"dgxy","explanation":"吊：凭吊；幽：幽境。凭吊古迹，寻找幽境，感怀旧事。","source":{"text":"游山玩水，吊古寻幽，赏月吟风，怡情遣兴，诗赋文词，山川殆遍。","book":"明·冯梦龙《古今小说》第30卷"},"example":{"text":"我平生最大的爱好就是～。"},"usage":"作谓语、定语、宾语；指凭吊古迹，寻找幽境"},{"id":11069,"word":"吊尔郎当","pinyin":"diào er láng dāng","abbr":"deld","explanation":"形容仪容不整，作风散漫，态度不严肃或不认真。","example":{"text":"你不能总是这样～的好不好？"}},{"id":11070,"word":"吊形吊影","pinyin":"diào xíng diào yǐng","abbr":"dxdy","explanation":"犹言形影相吊。比喻孤独寂寞。","source":{"text":"独自吊形吊影，谁人知暖知寒。","book":"明·袁宏道《别恨篇为方子公赋》诗"},"similar":["形影相吊"],"usage":"作谓语、宾语、定语；指孤单"},{"id":11071,"word":"吊拷掤扒","pinyin":"diào kǎo bēng bā","abbr":"dkbb","explanation":"用绳索捆绑身体，吊起来拷打。","source":{"text":"由你由你，既待舍死忘生，怕什么吊拷掤扒。","book":"元·杨梓《豫让吞炭》第三折"},"example":{"text":"他将你孩儿拖到官中，受尽三推六问，～。","book":"元·关汉卿《窦娥冤》第四折"}},{"id":11072,"word":"吊拷棚扒","pinyin":"diào kǎo péng bā","abbr":"dkpb","explanation":"吊：悬挂；拷：拷打；扒：脱掉。把人绳绑吊起，剥去衣服严刑拷打。","source":{"text":"由你由你，既待舍死忘生，怕什么吊拷棚扒。","book":"元·杨梓《豫让吞炭》第三折"},"similar":["棚扒吊拷"],"usage":"作宾语、定语；指古代刑罚"},{"id":11073,"word":"吊拷绷扒","pinyin":"diào kǎo bēng bā","abbr":"dkbb","explanation":"强行脱去衣服，捆绑并吊起来拷打。","source":{"text":"则我这身上罪何日开除？腹中冤向谁诉与？被他人混赖了我孩儿，更陷我毒杀夫主。吃不过吊拷绷扒，撞不着清廉官府。","book":"元·李行道《灰阑记》第三折"},"example":{"text":"有他娘子将小人告到官中，三推六问，～，打的小人受不过，只得屈招了。","book":"元·孙仲章《勘头巾》第三折"}},{"id":11074,"word":"吊死扶伤","pinyin":"diào sǐ fú shāng","abbr":"dsfs","explanation":"吊祭死者，扶救伤者。","source":{"text":"公奉辞伐罪，戒旦晨征，兵车始交，氛祲时荡，吊死扶伤，弘宣皇泽。","book":"《南史·齐纪上·高帝》"},"example":{"text":"震孺出关，延见将士，～，军民大悦。","book":"《明史·方震孺传》"},"similar":["吊死问疾"],"usage":"作谓语、比喻、定语；用于领导者"},{"id":11075,"word":"吊死问生","pinyin":"diào sǐ wèn shēng","abbr":"dsws","explanation":"吊祭死者，慰问生者。","source":{"text":"燕王吊死问生，与百姓同甘苦。","book":"西汉·刘向《战国策·燕策》"},"example":{"text":"～，甚有恩纪。","book":"《北史·循吏传·杜纂》"},"similar":["吊死问疾"],"usage":"作谓语、宾语、定语；形容关心人民群众"},{"id":11076,"word":"吊死问疾","pinyin":"diào sǐ wèn jí","abbr":"dswj","explanation":"吊祭死者，慰问病人。形容关心人民群众的疾苦。","source":{"text":"又私自送往迎来，吊死问疾，养孤长幼在其中。","book":"汉·晁错《论贵粟疏》"},"example":{"text":"晋宋人墨迹，多是～书简。","book":"宋·沈括《梦溪笔谈·书画》"},"similar":["救死扶伤"],"usage":"作谓语、宾语、定语；形容关心人民群众"},{"id":11077,"word":"吊民伐罪","pinyin":"diào mín fá zuì","abbr":"dmfz","explanation":"吊：慰问；伐：讨伐。慰问受苦的人民，讨伐有罪的统治者。","source":{"text":"诛其罪，吊其民，如时雨降，民大悦。","book":"《孟子·滕文公下》"},"example":{"text":"丞相兴仁义之兵，～，官渡一战，破袁绍百万之众。","book":"明·罗贯中《三国演义》第三十一回"},"similar":["锄强扶弱"],"usage":"作谓语；指锄强扶弱"},{"id":11078,"word":"吊胆惊心","pinyin":"diào dǎn jīng xīn","abbr":"ddjx","explanation":"犹言吊胆提心。","source":{"text":"众将进前射箭，射中的磨旗擂鼓，不中的吊胆惊心。","book":"《说唐》第八回"},"example":{"text":"你不必这样～地过日子。"},"similar":["提心吊胆"],"usage":"作谓语、状语；指害怕"},{"id":11079,"word":"吊胆提心","pinyin":"diào dǎn tí xīn","abbr":"ddtx","explanation":"提心吊胆。 形容非常担心或害怕。","source":{"text":"一个个擦拳磨掌、吊胆提心的，只等姑娘一句话。","book":"清·文康《儿女英雄传》第25回"},"example":{"text":"你真让我～。"},"similar":["提心吊胆"],"opposite":["心安理得"],"usage":"作谓语、宾语、状语；指担心或害怕"},{"id":11080,"word":"吊誉沽名","pinyin":"diào yù gū míng","abbr":"dygm","explanation":"沽：买；钓：用饵引鱼上钩，比喻骗取。用某种不正当的手段捞取名誉。","source":{"text":"彼虽硁硁有类沽名者。","book":"《管子·法法》：“钓名之人，无贤士焉。”《后汉书·逸民传序》"}},{"id":11081,"word":"同业相仇","pinyin":"tóng yè xiāng chóu","abbr":"tyxc","explanation":"犹言同行是冤家。形容同行业的人不易相处。","source":{"text":"同类相妒，同业相仇。","book":"汉·黄石公《素书》"},"similar":["文人相轻"],"usage":"作宾语、定语；用于书面语"},{"id":11082,"word":"同中之异","pinyin":"tóng zhōu zhī yì","abbr":"tzzy","explanation":"相同之中的不同点。","example":{"text":"乃区为八例，以明～，异中之同。","book":"《清史稿·凌廷堪传》"}},{"id":11083,"word":"同仁一视","pinyin":"tóng rén yī shì","abbr":"trys","explanation":"同仁：同样的亲切。原指圣人对百姓一样看待，同施仁爱。后多表示对人同样看待，不分厚薄。","source":{"text":"是故圣人一视同仁，笃近而举远。","book":"唐·韩愈《原人》卷十一"},"example":{"text":"孰绍介是，吾校之功，～，泱泱大风。","book":"清化大学校歌"}},{"id":11084,"word":"同仇敌忾","pinyin":"tóng chóu dí kài","abbr":"tcdk","explanation":"同仇：共同对敌；敌：对抗，抵拒；忾：愤怒。指全体一致痛恨敌人。","source":{"text":"诸侯敌王所忾，而献其功。","book":"《诗经·秦风·无衣》：“修我戈矛，与子同仇。”《左传·文公四年》"},"example":{"text":"因为读者大众的对于某一作者，是未必和“批评”或“批判”者～的。","book":"鲁迅《且介亭杂文二集·五论“文人相轻”—明术》"},"similar":["同仇敌慨"],"usage":"作谓语、定语、分句；指共同作战","story":["春秋时期流传一首歌谣，歌词大意是：国王兴兵打仗，快把刀枪修好，我与你共同对付仇敌。公元前623年，卫国的宁俞出使鲁国，鲁文王设宴招待他，并让乐工演唱周天子酬谢诸侯的《湛露》和《彤弓》以表示愿意结盟共同对付外敌"]},{"id":11085,"word":"同仇敌慨","pinyin":"tóng chóu dí kǎi","abbr":"tcdk","explanation":"同仇：一致对付仇敌。指全体一致痛恨敌人，打击敌人","source":{"text":"读者大众的对于某一作者，是未必和‘批评’或‘批判’者同仇敌慨的。","book":"鲁迅《且介亭杂文二集·五论“文人相轻”——明术》"},"similar":["同仇敌忾"],"usage":"作谓语、定语；指共同作战"},{"id":11086,"word":"同休共戚","pinyin":"tóng xiū gòng qī","abbr":"txgq","explanation":"①指同欢乐共忧患。形容关系密切，利害一致。②偏指共患难。亦作“同休等戚”。","source":{"text":"且王与君侯，譬犹一体，同休等戚，祸福共之，愚为君侯，不宜计官号之高下，爵禄之多少为意也。","book":"《三国志·蜀志·费祎传》"},"example":{"text":"吾居将相，与国舅甥，同休共戚，义由一体。","book":"《周书·尉迟迥传》"},"similar":["同休等戚","休戚相关"],"usage":"作谓语、定语；用于书面语"},{"id":11087,"word":"同休等戚","pinyin":"tóng xiū děng qī","abbr":"txdq","explanation":"指同欢乐共忧患。形容关系密切，利害一致。亦偏指共患难。同“同休共戚”。","source":{"text":"且王与君侯，譬犹一体，同休等戚，祸福共之，愚为君侯，不宜计官号之高下，爵禄之多少为意也。","book":"《三国志·蜀志·费祎传》"},"example":{"text":"陛下与高氏通和，岁逾一纪，舟车往复，相望道路，必将分灾卹患，～。","book":"蔡东藩《南北史演义》第六十回"},"similar":["同休共戚"],"usage":"作谓语、定语；用于书面语"},{"id":11088,"word":"同出一辙","pinyin":"tóng chū yī zhé","abbr":"tcyz","explanation":"两种言论或行为完全一样。","source":{"text":"此四人之过，如出一辙。","book":"宋·洪迈《容斋随笔》卷十一"},"example":{"text":"这两种说法～。"},"similar":["如出一辙"],"usage":"作谓语；指相同的"},{"id":11089,"word":"同利相死","pinyin":"tóng lì xiāng sǐ","abbr":"tlxs","explanation":"指有共同利益，就能舍命相助。","source":{"text":"同欲相趋，同利相死。","book":"《史记·吴王濞列传》"},"example":{"text":"故～，同情相成，同欲相助。","book":"《淮南子·兵略训》"},"usage":"作宾语、定语；用于书面语"},{"id":11090,"word":"同力协契","pinyin":"tóng lì xié qì","abbr":"tlxq","explanation":"犹言同心协力。团结一致，共同努力。","source":{"text":"同力协契，所在蜂起。","book":"《南史·宋纪·武帝》"},"similar":["同心协力"],"usage":"作谓语、定语、状语；用于处事"},{"id":11091,"word":"同功一体","pinyin":"tóng gōng yī tǐ","abbr":"tgyt","explanation":"指功绩和地位相同。","source":{"text":"往年杀彭越，前年杀韩信，此三人者，同功一体之人也，自疑祸及身，故反耳。","book":"《史记·黥布列传》"},"example":{"text":"郑父与克，～之人，克诛，郑父安得不惧。","book":"明·冯梦龙《东周列国志》第二十九回"},"usage":"作谓语、定语；指功绩和地位相同"},{"id":11092,"word":"同呼吸，共命运","pinyin":"tóng hū xī，gòng mìng yùn","abbr":"thxgmy","explanation":"利害一致，命运相同。"},{"id":11093,"word":"同命运共呼吸","pinyin":"tóng mìng yùn gòng hū xī","abbr":"tmyghx","explanation":"形容双方关系密切，利害一致。","example":{"text":"我们都是～的人。"},"similar":["同呼吸共命运"],"usage":"作谓语、定语；指利害一致"},{"id":11094,"word":"同垂不朽","pinyin":"tóng chuí bù xiǔ","abbr":"tcbx","explanation":"一同流传，永不磨灭。","source":{"text":"烈士的纪念碑，同书写碑文的卓越的无产阶级文化战士，是同垂不朽的。","book":"《人民文学》1978年第7期"},"usage":"作谓语、定语；用于书面语"},{"id":11095,"word":"同堂兄弟","pinyin":"tóng táng xiōng dì","abbr":"ttxd","explanation":"同祖的兄弟，即堂兄弟。","source":{"text":"二公孙，同堂兄弟耳。","book":"《北史·公孙表传》"},"usage":"作宾语、定语；用于书面语"},{"id":11096,"word":"同声一辞","pinyin":"tóng shēng yī cí","abbr":"tsyc","explanation":"犹言众口一辞。指大家说得都一样。","source":{"text":"何至使八百诸侯同声一辞，冠带之伦服膺新命！","book":"清·陈确《死节论》"},"similar":["同然一辞","异口同声","众口一词"],"usage":"作谓语、定语；用于书面语"},{"id":11097,"word":"同声之应","pinyin":"tóng shēng zhī yìng","abbr":"tszy","explanation":"同类的事物相互感应。指志趣、意见相同的人互相响应，自然地结合在一起。","source":{"text":"同声相应，同气相求。水流湿，火就燥。","book":"《周易·乾》"},"example":{"text":"我也想上个折子，作为～。","book":"高阳《慈禧全传》四十七"},"similar":["同声相应"],"usage":"作宾语；指意气相投"},{"id":11098,"word":"同声共气","pinyin":"tóng shēng gòng qì","abbr":"tsgq","explanation":"比喻亲密无间，志趣相合。","source":{"text":"我想世上的人，同声共气的也有，谁似我们两个德性、才华，不争分寸。","book":"清·李渔《蜃中楼·耳卜》"},"similar":["同声同气"],"usage":"作谓语、定语；用于交往等"},{"id":11099,"word":"同声同气","pinyin":"tóng shēng tóng qì","abbr":"tstq","explanation":"比喻亲密无间，志趣相合。同“同声共气”。","source":{"text":"故小弟要进京里寻个知己，代他干营，好来任这海关监督，这时同声同气，才好做事。","book":"清·黄小配《廿载繁华梦》第四回"},"similar":["同声共气"],"usage":"作谓语、定语；用于交往等"},{"id":11100,"word":"同声异俗","pinyin":"tóng shēng yì sú","abbr":"tsys","explanation":"人刚出生时啼哭的声音相同，长大后习惯各不相同。","source":{"text":"干、越、夷、貊之子，生而同声，长而异俗，教使之然也。","book":"《荀子·劝学》"}},{"id":11101,"word":"同声相呼","pinyin":"tóng shēng xiāng hū","abbr":"tsxh","explanation":"同类的事物相互感应。指志趣、意见相同的人互相响应，自然地结合在一起。","source":{"text":"欲开情者，象而比之，以牧其辞。同声相呼，实理同归。","book":"《鬼谷子·反应》"}},{"id":11102,"word":"同声相应","pinyin":"tóng shēng xiāng yìng","abbr":"tsxy","explanation":"同类的事物相互感应。指志趣、意见相同的人互相响应，自然地结合在一起。","source":{"text":"同声相应，同气相求。水流湿，火就燥，云从龙，风从虎。圣人作而万物睹。","book":"《周易·乾》"},"example":{"text":"～，同气相求，心心相印，脉脉相通。","book":"续范亭《号召山西人民推翻万恶无耻军阀阎锡山》"},"similar":["意气相投","情投意合"],"opposite":["格格不入"],"usage":"作谓语、宾语；指意气相投"},{"id":11103,"word":"同声相应，同气相求","pinyin":"tóng shēng xiāng yìng，tóng qì xiāng qiú","abbr":"tsxytqxq","explanation":"同类的事物相互感应。指志趣、意见相同的人互相响应，自然地结合在一起。","source":{"text":"同声相应，同气相求。水流湿，火就燥。","book":"《易·乾》"},"example":{"text":"此外都是～，日夕过从，纵谈甚乐。","book":"清·岭南羽衣女士《东欧女豪杰》第一回"},"usage":"作宾语、定语、分句；可分开使用"},{"id":11104,"word":"同声相求","pinyin":"tóng shēng xiāng qiú","abbr":"tsxq","explanation":"指志趣相同者互相吸引、聚合。","source":{"text":"同声相求，尔后我先，安得而不问哉？","book":"唐·萧颖士《江有归舟》"},"usage":"作谓语、定语；用于交往"},{"id":11105,"word":"同好弃恶","pinyin":"tóng hǎo qì è","abbr":"thqe","explanation":"弃：抛弃；恶：旧恶。同修前好，抛弃旧怨。","source":{"text":"吾与女同好弃恶，复修旧德，以追念前勋。","book":"《左传·成公十三年》"}},{"id":11106,"word":"同室操戈","pinyin":"tóng shì sāo gē","abbr":"tscg","explanation":"同室：一家，指自己人；操：拿起；戈：古代的兵器。自家人动刀枪。指兄弟争吵。泛指内部斗争。","source":{"text":"《左传·昭公元年》"},"example":{"text":"为宋学者，不第攻汉儒而已也，仰且～矣。","book":"清·江藩《宋学渊源记序》卷上"},"similar":["相煎何急","自相残杀"],"opposite":["同仇敌忾","同心协力"],"usage":"作谓语、宾语；指内部斗争","story":["春秋时期，郑国王室公孙黑与公孙楚同时看中大夫徐吾犯的妹妹。徐吾犯十分为难，就去向子产讨教。子产让徐吾犯的妹妹自己决定。徐妹看中公孙楚，两人结婚时，公孙黑不服气就全副武装冲进公孙楚的家，公孙楚拿戈相迎把他赶出家门"]},{"id":11107,"word":"同寅协恭","pinyin":"tóng yín xié gōng","abbr":"tyxg","explanation":"同寅：原指同具敬畏之心，后指在一处做官的人；协恭：友好合作。形容人们互相尊敬，同心协力地工作。","source":{"text":"同寅协恭和衷哉。","book":"《尚书·皋陶漠》"},"example":{"text":"可见你我都是天榜有名，将来～，多少事业都要同做。","book":"清·吴敬梓《儒林外史》第七回"}},{"id":11108,"word":"同尘合污","pinyin":"tóng chén hé wū","abbr":"tchw","explanation":"指行为同于流俗之人，合于污浊之世。","source":{"text":"同尘合污，与世委蛇。","book":"明·李贽《藏书·大臣传·狄仁杰》"},"similar":["同流合污"],"usage":"作谓语、定语、宾语；用于处世等"},{"id":11109,"word":"同居异爨","pinyin":"tóng jū yì cuàn","abbr":"tjyc","explanation":"异：分开；爨：烧火煮饭。在一起居住而不在一起吃饭。","source":{"text":"植虽自州送禄奉母及赡诸弟，而各别资财，同居异爨，一门数灶，盖亦染江南之俗也。","book":"《魏书·裴叔业传》"},"example":{"text":"铁算盘已死，这兄弟两个一发无拘无束，畅所欲为，一宅分为两院，～，各败各钱。","book":"清·俞万春《荡寇志》第九十五回"}},{"id":11110,"word":"同工异曲","pinyin":"tóng gōng yì qǔ","abbr":"tgyq","explanation":"工：细致，巧妙；异：不同的。不同的曲调演得同样好。比喻话的说法不一而用意相同，或一件事情的做法不同而都巧妙地达到目的。","source":{"text":"子云相如，同工异曲。","book":"唐·韩愈《进学讲》"},"example":{"text":"这两部著作几乎是同时出版的，～，各有千秋。","book":"朱德熙《序》"},"similar":["异曲同工"],"usage":"作谓语、定语；同“异曲同工”","story":["西汉时期有名文学家司马相如和扬雄都是以词赋见长，司马相如是汉景帝时期的人，作品有《子虚赋》《上林赋》，辞藻华丽；扬雄是汉成帝时人，作品有《甘泉赋》《河东赋》，主张修政。唐朝文学家韩愈评价说“子云相如，同工异曲。”"]},{"id":11111,"word":"同年而校","pinyin":"tóng nián ér xiào","abbr":"tnex","explanation":"犹言相提并论。把不同的人或不同的事放在一起谈论或看待。","source":{"text":"体若骈枝，语反简核；岂与夫苏轼陈亮苟为辞费者同年而校乎？","book":"章炳麟《文学说例》"},"similar":["相提并论","同年而语"],"usage":"作谓语、定语；用于书面语"},{"id":11112,"word":"同年而语","pinyin":"tóng nián ér yǔ","abbr":"tney","explanation":"将两种情况或两件事情放在同一时间来比较、评论。形容相提并论。","source":{"text":"试使山东之国，与陈涉度长絜大、比权量力，则不可同年而语矣。","book":"汉·贾谊《过秦论》"},"example":{"text":"梁启超《立宪政体与政治道德》：“然正以权限严明故，故行政部有莫大之威权，非他种政体可～。”"},"similar":["同日而语","同日而言","同年而校"],"usage":"作谓语、宾语；用于否定句"},{"id":11113,"word":"同床共寝","pinyin":"tóng chuáng gòng qǐn","abbr":"tcgq","explanation":"共同睡一张床。形容两人关系密切。","source":{"text":"殊不知我与罗郎虽同床共寝两月，而此身从未沾染，此心可对天日。","book":"清·褚人获《隋唐演义》第61回"},"example":{"text":"清·韩邦庆《海上花列传》第42回：“云甫吃了稀饭，和覃丽娟～。”"},"similar":["同床共枕"],"usage":"作谓语、宾语、定语；多用于夫妻间"},{"id":11114,"word":"同床共枕","pinyin":"tóng chuáng gòng zhěn","abbr":"tcgz","explanation":"指同床并头而眠。多指夫妻生活。","source":{"text":"我王若依小臣奏，休信同床共枕人。","book":"《明成化说唱词话丛刊·石郎附马传》"},"example":{"text":"以下就是本人，说女性蓄发挽髻，从男性方面而言，视觉嗅觉都有妙美的趣味，尤其是～的时侯。","book":"叶圣陶《李太太的头发》"},"similar":["同床共寝"],"usage":"作谓语、宾语、定语；多用于男女间"},{"id":11115,"word":"同床各梦","pinyin":"tóng chuáng gè mèng","abbr":"tcgm","explanation":"比喻共同生活或共做一事而各有打算。","source":{"text":"同床各做梦，周公且不能学得，何必一一说到孔明哉！","book":"宋·陈亮《与朱元晦秘书书·乙巳春书之一》"},"example":{"text":"我们不想做～的夫妻。"},"similar":["同床异梦"],"opposite":["同心同德"],"usage":"作谓语、定语、状语；用于人"},{"id":11116,"word":"同床异梦","pinyin":"tóng chuáng yì mèng","abbr":"tcym","explanation":"异：不同。原指夫妇生活在一起，但感情不和。比喻同做一件事而心里各有各的打算。","source":{"text":"同床各做梦，周公且不能学得，何必一一说到孔明哉！","book":"宋·陈亮《与朱元晦秘书书》"},"example":{"text":"但彼等乌合之众，～，一战即溃。","book":"姚雪垠《李自成》第一卷第一章"},"similar":["钩心斗角","离心离德"],"opposite":["同心同德","情投意合"],"usage":"作谓语、定语、状语；用于人"},{"id":11117,"word":"同归于尽","pinyin":"tóng guī yú jìn","abbr":"tgyj","explanation":"尽：完。一起死亡或一同毁灭。","source":{"text":"大小虽殊，同归于尽耳。","book":"《列子·天瑞》：“天地终乎？与我偕终”卢重玄解"},"example":{"text":"只图自己安逸，那管世事艰难，弄到后来，不是～吗？","book":"清·姬文《市声》第十四回"},"similar":["玉石俱焚"],"opposite":["贪生怕死"],"usage":"作谓语、宾语；指一起死亡或共同毁灭"},{"id":11118,"word":"同归殊涂","pinyin":"tóng guī shū tú","abbr":"tgst","explanation":"原指天下万事初虽异，然终究同归于一。后泛指途径不同而结果相同。","source":{"text":"天下同归而殊涂，一致而百虑。","book":"语出《易·系辞下》"},"example":{"text":"汉·荀悦《汉纪·平帝纪》：“昔秦燔诗书以立私议，莽诵六经以文奸言，～，俱用亡灭。”"},"similar":["殊途同归"],"usage":"作宾语、定语；用于书面语"},{"id":11119,"word":"同归殊途","pinyin":"tóng guī shū tú","abbr":"tgst","explanation":"归：归宿；殊：不同；途：道路。通过不同的途径，到达同一个目的地。比喻采取不同的方法而得到相同的结果。","source":{"text":"天下同归而殊途，一致而百虑。","book":"《易·系辞下》"},"example":{"text":"一道题，往往有几种解法，但～，答案只能有一个。"},"similar":["殊途同归"],"usage":"复句式；作谓语、定语；"},{"id":11120,"word":"同德一心","pinyin":"tóng dé yī xīn","abbr":"tdyx","explanation":"指全心全意为共同目标努力。","source":{"text":"为此说者，既不肯同德一心，以成人之美，使生者竟此外交之绪，则亦已矣。","book":"独立苍茫子《东京学界告乡人书》"},"similar":["同德协力"],"usage":"作谓语、定语；用于处事等"},{"id":11121,"word":"同德协力","pinyin":"tóng dé xié lì","abbr":"tdxl","explanation":"为同一目标而共同尽力。","source":{"text":"使其万众一心，同德协力，共逐白山之兽，追还我黄帝之魂。","book":"铁郎《论各省宜速响应湘赣革命军》"},"similar":["同心协力"],"usage":"作谓语、定语；用于处事等"},{"id":11122,"word":"同德同心","pinyin":"tóng dé tóng xīn","abbr":"tdtx","explanation":"谓思想行动完全一致。同“同心同德”。","source":{"text":"然君臣同德同心，于兹可见。","book":"《旧唐书·马燧传》“长城压境，巨舰济川，同德同心，扶危持颠。”明·罗贯中《平山冷燕》第一回"},"example":{"text":"普劝国人，勿分尔我，～，自成团体。","book":"清·洪楝园《警黄钟》第十出"},"similar":["同心同德"],"usage":"作谓语、定语、状语；指思想统一"},{"id":11123,"word":"同心一力","pinyin":"tóng xīn yī lì","abbr":"txyl","explanation":"团结一致，共同努力。同“同心协力”。","source":{"text":"近欲徙水北营，合于水南，同心一力，人自为战，何有不克哉？","book":"晋·袁宏《后汉纪·光武帝纪》"},"example":{"text":"南朝·宋·范晔《后汉书·吴汉传》：“若能～，人自为战，大功可立。”"},"similar":["齐心协力"],"usage":"作谓语、定语、状语；用于处事"},{"id":11124,"word":"同心一德","pinyin":"tóng xīn yī dé","abbr":"txyd","explanation":"指思想统一，信念一致。同“同心同德”。","source":{"text":"予有乱臣十人，同心同德。","book":"《尚书·泰誓中》"},"example":{"text":"伏望圣慈早进范纯仁，庶得贤者在位，～，以辅圣政。","book":"清·毕沅《续资治通鉴》卷七十九"},"similar":["同心同德","同心合德"],"usage":"作谓语、定语、状语；指思想统一"},{"id":11125,"word":"同心一意","pinyin":"tóng xīn yī yì","abbr":"txyy","explanation":"指心志一致。","source":{"text":"肃请得奉命吊表二子……及说备使抚表众，同心一意，共治曹操。","book":"《三国志·吴志·鲁肃传》"},"example":{"text":"～，顿兴灸艾分痛之真情；因病生怜，遂起借花献佛之妄念。","book":"明·李贽《代常通病僧告文》"},"similar":["一心一意"],"usage":"作谓语、定语、状语；用于处事"},{"id":11126,"word":"同心僇力","pinyin":"tóng xīn jié lì","abbr":"txll","explanation":"指齐心合力。同“同心戮力”。","source":{"text":"陛下宵衣旰食，征天下兵，与群臣兆姓同心僇力，期灭此朝食，以雪不共戴天之耻。","book":"《明史·王直传》"},"similar":["同心戮力","戮力同心"],"usage":"作谓语、定语；指齐心合力"},{"id":11127,"word":"同心僯力","pinyin":"tóng xīn jié lì","abbr":"txjl","explanation":"指齐心合力。同同心戮力”。"},{"id":11128,"word":"同心共济","pinyin":"tóng xīn gòng jì","abbr":"txgj","explanation":"指齐心协力，克服困难。亦作“同心协济”。","source":{"text":"以之修身，则同道而相益；以之事国，则同心共济。","book":"宋·欧阳修《朋党论》"},"example":{"text":"清·吴璿《飞龙全传》第58回：“吾与公以肺腑之交，为国家大将，～，何用相疑？”"},"similar":["同心协济","和衷共济"],"usage":"作谓语、定语；用于处事"},{"id":11129,"word":"同心共胆","pinyin":"tóng xīn gòng dǎn","abbr":"txgd","explanation":"心志一致。亦作“同心合胆”。","source":{"text":"不肯同心共胆，与齐进退。","book":"《后汉书·郑太传》"},"example":{"text":"你道是～，还待要骗口张舌。","book":"元·无名氏《马陵道》第四折"},"similar":["同心合胆"],"usage":"作谓语、定语；用于书面语"},{"id":11130,"word":"同心协力","pinyin":"tóng xīn xié lì","abbr":"txxl","explanation":"心：思想；协：合。团结一致，共同努力。","source":{"text":"然后与宇文行台，同心协力，电讨不庭，则桓文之勋，复兴于兹日矣。","book":"汉·贾谊《过秦论》：“且天下尝同心并力攻秦矣，然困于险阻而不能进者，岂勇力智慧不足哉？”《周书·崔谦传》"},"example":{"text":"只要我们大家～，就没有克服不了的困难。"},"similar":["齐心协力"],"usage":"联合式；作谓语、定语、状语；含褒义"},{"id":11131,"word":"同心协契","pinyin":"tóng xīn xié qì","abbr":"txxq","explanation":"契：投合。齐心协力。","source":{"text":"同心协契，所在蜂起，即日斩伪徐州刺史安成王修、青州刺史弘。","book":"《南史·宋纪·武帝》"},"similar":["齐心协力"],"usage":"作谓语、定语、状语；用于处事"},{"id":11132,"word":"同心协德","pinyin":"tóng xīn xié dé","abbr":"txxd","explanation":"指思想统一，信念一致。同“同心同德”。","source":{"text":"与杲卿同心协德，亦著微诚。","book":"唐·颜真卿《祭伯父豪州刺史文》"},"similar":["同心同德"],"usage":"作谓语、定语、状语；指思想统一"},{"id":11133,"word":"同心协济","pinyin":"tóng xīn xié jì","abbr":"txxj","explanation":"指齐心协力，克服困难。同“同心共济”。","source":{"text":"故仁宗皇帝时，虽有西夏元吴之叛，而晏然若无事者，以韩琦、范仲淹同心协济也。","book":"清·陈忱《续资治通鉴·宋高宗绍兴四年》"},"similar":["同心共济"],"usage":"作谓语、定语；用于处事"},{"id":11134,"word":"同心叶力","pinyin":"tóng xīn yè lì","abbr":"txyl","explanation":"团结一致，共同努力。同“同心协力”。"},{"id":11135,"word":"同心合力","pinyin":"tóng xīn hé lì","abbr":"txhl","explanation":"团结一致，共同努力。","source":{"text":"且天下尝同心并力攻秦矣，然困于险阻而不能进者，岂勇力智慧不足哉？","book":"汉·贾谊《过秦论》"},"example":{"text":"凡此你我三个人，须要但随和睦，～侍奉双亲。","book":"清·文康《儿女英雄传》第二十八回"},"similar":["齐心协力"],"usage":"作谓语、定语、状语；指齐心协力"},{"id":11136,"word":"同心合德","pinyin":"tóng xīn hé dé","abbr":"txhd","explanation":"指思想统一，信念一致。同“同心同德”。","source":{"text":"我有两个同胞兄弟，一个是洞庭君，一个钱塘君。洞庭与俺同心合德。","book":"清·李渔《蜃中楼·献寿》"},"similar":["同心同德"],"usage":"作谓语、定语、状语；指思想统一"},{"id":11137,"word":"同心合意","pinyin":"tóng xīn hé yì","abbr":"txhy","explanation":"指心志一致。同“同心一意”。","source":{"text":"先帝委政于君而弃群臣，朕得奉宗庙，诚嘉与君同心合意。","book":"《汉书·王莽传》"},"example":{"text":"那四个人自然是～的，俱各欢欢喜喜的，一路望朱仙镇而来。","book":"清·钱彩《说岳全传》第七十六回"},"similar":["一心一意"],"usage":"作谓语、定语；用于处事"},{"id":11138,"word":"同心合胆","pinyin":"tóng xīn hé dǎn","abbr":"txhd","explanation":"心志一致。同“同心共胆”。","source":{"text":"若丞相肯放回去，就当招安本部人马，同心合胆，方可归顺。’","book":"明·罗贯中《三国演义》第八十八回"},"example":{"text":"娘子，你夫妻是一世之事，莫要冷眼相看，须将好言谏劝丈夫，～，共做人家。","book":"明·冯梦龙《警世通言》第三十一卷"},"similar":["同心共胆"],"usage":"作谓语、定语；用于书面语"},{"id":11139,"word":"同心同德","pinyin":"tóng xīn tóng dé","abbr":"txtd","explanation":"同德：为同一目的而努力。指思想统一，信念一致。","source":{"text":"予有乱臣十人，同心同德。","book":"《尚书·泰誓中》"},"example":{"text":"朕得天下，皆我君臣～以成大功。","book":"《金史·太祖本纪》"},"similar":["同心协力","同心戮力"],"opposite":["同床异梦","离心离德"],"usage":"作谓语、定语、状语；指思想统一","story":["商朝末年，纣王荒淫无道、暴虐成性。手下的官员都是离心离德，军心涣散。周武王联合西部的八个诸侯，集结4万兵力，亲自率军征讨纣王。在出发前的誓师会上，他发表演讲，表示上下要同心同德，不消灭纣王誓不罢休"]},{"id":11140,"word":"同心并力","pinyin":"tóng xīn bìng lì","abbr":"txbl","explanation":"团结一致，共同努力。","source":{"text":"且天下尝同心并力而攻秦矣，然困于险阻而不能进者。","book":"汉·贾谊《过秦论下》"},"example":{"text":"有寇而战，则～。","book":"宋·苏轼《策别十三》"},"similar":["齐心协力","同心同德"],"opposite":["离心离德"],"usage":"作谓语、状语；指团结一致，共同努力"},{"id":11141,"word":"同心戮力","pinyin":"tóng xīn lù lì","abbr":"txll","explanation":"指齐心合力。","source":{"text":"太后新摄政，政之巨细，多委陈蕃、窦武，同心戮力，以奖王室。","book":"晋·袁宏《后汉纪·灵帝纪》"},"example":{"text":"八亿神州，～，坚无不摧，胜利可期。","book":"童第周《有感》"},"similar":["齐心合力","同心协力"],"usage":"作谓语、定语；指齐心合力","story":["夏朝末年，末代君主夏桀非常残暴，对内实行残酷统治，百姓怨声载道，民不聊生。诸侯小国商的国君汤是一个贤明的君主，他找到大贤人伊尹辅佐，商国实力空前强大，汤见时机成熟，君臣戮力同心，齐心合力，终于灭掉夏朝"]},{"id":11142,"word":"同心敌忾","pinyin":"tóng xīn dí kài","abbr":"txdk","explanation":"同怀强烈的愤恨以对付敌人。","source":{"text":"勉以同心敌忾，为长庚雪雠愤。","book":"清·魏源《圣武记》第八卷"},"example":{"text":"《辛亥革命前十年间时论选集·论国会为治本外交之本》：“是故政府之对国民也，当公听并观，以收～，而不可过事猜防。”"},"similar":["同仇敌忾"],"usage":"作谓语、定语；用于书面语"},{"id":11143,"word":"同心断金","pinyin":"tóng xīn duàn jīn","abbr":"txdj","explanation":"形容心齐力量大。","source":{"text":"二人同心，其利断金。","book":"《易·系辞上》"},"example":{"text":"明·张凤翼《灌园记·法章闻变》：“感吾师～，愧吾身有戈难枕。”"},"usage":"作谓语、定语；用于书面语"},{"id":11144,"word":"同心毕力","pinyin":"tóng xīn bì lì","abbr":"txbl","explanation":"指齐心尽力。","source":{"text":"永元初，外戚秉权，朝臣畏悚，莫敢抗者，惟隗与袁安同心毕力，数犯颜谏。","book":"《东观汉记·任隗传》"},"similar":["齐心协力"],"usage":"作定语、状语；用于处事"},{"id":11145,"word":"同心竭力","pinyin":"tóng xīn jié lì","abbr":"txjl","explanation":"指齐心尽力。同“同心毕力”。","source":{"text":"陛下诚有意于此，臣等敢不同心竭力，对扬而行之。","book":"宋·司马光《交趾献奇兽赋》"},"example":{"text":"清·褚人获《隋唐演义》第95回：“众人闻言感激，愿～，以守此城。”"},"similar":["齐心协力","同心毕力"],"usage":"作谓语、定语、状语；用于处事"},{"id":11146,"word":"同心结","pinyin":"tóng xīn jié","abbr":"txj","explanation":"用锦带打成的连环回文样式的结子，作为男女相爱的象征。","source":{"text":"腰间双绮带，梦为同心结。","book":"南朝·梁·萧衍《有所思》"},"example":{"text":"那女待诏把前前后后的话，细细陈说了一遍，才向袖中取出那～的凤头簪儿，递与海陵。","book":"明·冯梦龙《醒世恒言》卷二十三"}},{"id":11147,"word":"同志合道","pinyin":"tóng zhì hé dào","abbr":"tzhd","explanation":"志：志趣；道：道路。志趣相同，意见一致。","source":{"text":"始知公忠孝发于至诚，体国忧民，常恨未得同志合道人，相与辅成治教。","book":"清·方望溪《兵部尚书法公墓表》"},"similar":["志同道合"],"usage":"作谓语、定语；用于志趣相投的人"},{"id":11148,"word":"同忧相救","pinyin":"tóng yōu xiāng jiù","abbr":"tyxj","explanation":"指忧患相同者互相救助。","source":{"text":"同病相怜，同忧相救，惊翔之鸟相随而集濑下之水因复俱流。","book":"汉·赵晔《吴越春秋·阖闾内传》"},"example":{"text":"明·杨慎《祭玉垒王舜卿文》：“古语有之：‘同病相怜，～’。”"},"similar":["同病相怜"],"usage":"作宾语、定语；用于处事等"},{"id":11149,"word":"同恶共济","pinyin":"tóng è gòng jì","abbr":"tegj","explanation":"坏人互相勾结，共同作恶。同“同恶相济”。","source":{"text":"要之官官相护，同恶共济。","book":"《“五四”爱国运动资料·曹汝霖》"},"similar":["同恶相济"],"usage":"作谓语、定语；指狼狈为奸"},{"id":11150,"word":"同恶相党","pinyin":"tóng è xiāng dǎng","abbr":"texd","explanation":"共为恶者相结为党。","source":{"text":"言其同恶相党，共行虐政也。","book":"《诗·大雅·皇矣》“维彼四国，爰究爰度”唐·孔颖疏"},"usage":"作谓语、定语；用于处事等"},{"id":11151,"word":"同恶相助","pinyin":"tóng wù xiāng zhù","abbr":"twxz","explanation":"指对共同憎恶者，必相互援助以对付之。亦作“同恶相恤”。","source":{"text":"同恶相助，同好相留。","book":"《史记·吴王濞列传》"},"similar":["同恶相求","同恶相救"],"usage":"作谓语、宾语；指坏人"},{"id":11152,"word":"同恶相恤","pinyin":"tóng wù xiāng xù","abbr":"twxx","explanation":"指对共同憎恶者，必相互援助以对付之。同“同恶相助”。","source":{"text":"简书，同恶相恤之谓也。","book":"春秋·鲁·左丘明《左传·闵公元年》"},"similar":["同恶相助"],"usage":"作宾语、定语；用于处事等"},{"id":11153,"word":"同恶相救","pinyin":"tóng è xiāng jiù","abbr":"texj","explanation":"同恶：共同作恶的人；救：帮助。坏人互相勾结，共同作恶。","source":{"text":"马超成宜，同恶相济。","book":"《史记·吴王濞列传》：“同恶相助，同好相留。”《三国志·魏书·武帝纪》"},"similar":["同恶相助","同恶相求"],"usage":"作谓语、宾语；指坏人"},{"id":11154,"word":"同恶相求","pinyin":"tóng è xiāng qiú","abbr":"texq","explanation":"坏人与坏人相互勾结。","source":{"text":"同恶相求，如市贾焉，何难？","book":"《左传·昭公十三年》"},"example":{"text":"吴晗《灯下集·郑国的商人》：“他们在社会上起互通有无的作用，所以有‘～，如市贾焉’的话。”"},"similar":["同恶相助"],"usage":"作谓语、宾语；指坏人"},{"id":11155,"word":"同恶相济","pinyin":"tóng è xiāng jì","abbr":"texj","explanation":"同恶：共同作恶的人；济：助。坏人互相勾结，共同作恶。","source":{"text":"马超成宜，同恶相济。","book":"《史记·吴王濞列传》：“同恶相助，同好相留。”《三国志·魏书·武帝纪》"},"example":{"text":"惟此群凶，～。","book":"《南史·梁本纪》"},"similar":["狼狈为奸","同敝相济"],"usage":"作谓语、定语；指狼狈为奸"},{"id":11156,"word":"同患难共生死","pinyin":"tóng huàn nàn gòng shēng sǐ","abbr":"thngss","explanation":"指为了一定的目标共度患难，出生入死。","source":{"text":"罗马虽属落城，大事今且未了，余不能舍吾同患难共生死之部下，吾且将有所为。","book":"梁启超《意大利建国三杰传》第八节"},"example":{"text":"梁启超《意大利建国三杰传》第八节：“罗马虽属落城，大事今且未了，余不能舍吾同患难共生死之部下，吾且将有所为。”"},"similar":["同生死共患难"],"usage":"作谓语、定语；用于处事"},{"id":11157,"word":"同患难，共生死","pinyin":"tóng huàn nàn，gòng shēng sǐ","abbr":"thngss","explanation":"一同经历磨难，一同生死。形容彼此间利害一致，生死与共。","example":{"text":"我与汝等戮力数年，～，仿佛如家人骨肉一般。","book":"蔡东藩《清史演义》第四十五回"}},{"id":11158,"word":"同情相成","pinyin":"tóng qíng xiāng chéng","abbr":"tqxc","explanation":"指有共同志趣，利害关系一致的人互相帮助把事情办好。","source":{"text":"与人同病相救，同情相成，同恶相助，同好相趋，故无甲兵而胜，无冲机而攻，无沟堑而守。","book":"周·姜尚《六韬·武韬·发启》"},"example":{"text":"言出君之口，入臣之耳，人孰知之者乎？且～，同利相死。君其图之。","book":"《淮南子·人间训》"}},{"id":11159,"word":"同成异败","pinyin":"tóng chéng yì bài","abbr":"tcyb","explanation":"异：不同。同心就能成功，不同心就会失败。指做事必须齐心协力。","source":{"text":"同则成，异则败，皆然也。","book":"唐·韩愈《送许郢州序》"}},{"id":11160,"word":"同敝相济","pinyin":"tóng bì xiāng jì","abbr":"tbxj","explanation":"犹同恶相济。坏人互相勾结，共同作恶。","source":{"text":"同敝相济，故其有繁，败国蠹政之事，不可单书。","book":"南朝·宋·范晔《后汉书·宦者传序》"},"similar":["同恶相济"],"usage":"作谓语、定语；指狼狈为奸"},{"id":11161,"word":"同文共规","pinyin":"tóng wén gòng guī","abbr":"twgg","explanation":"比喻国家统一。同“同文共轨”。","source":{"text":"削平天下，同文共规。","book":"南朝·梁·江淹《恨赋》"},"similar":["同文共轨"],"usage":"作谓语、定语；比喻国家统一"},{"id":11162,"word":"同文共轨","pinyin":"tóng wén gòng guǐ","abbr":"twgg","explanation":"〖释义〗同文：全国所用的文字相同；共轨：全国车辙阔狭相同。统一文字，统一车辙。比喻国家统一。","source":{"text":"今天下车同轨，书同文，行同伦。","book":"《礼记·中庸》"},"usage":"联合式；作谓语、定语；比喻国家统一"},{"id":11163,"word":"同日而言","pinyin":"tóng rì ér yán","abbr":"trey","explanation":"把不同的人或不同的事放在一起谈论或看待。同“同日而论”。","source":{"text":"及愍怀太子之废，可谓柔而有正。武秋失节之士，何可同日而言！","book":"《晋书·郗鉴传》"},"similar":["同日而语","同年而语"],"usage":"作谓语、宾语；用于否定句"},{"id":11164,"word":"同日而论","pinyin":"tóng rì ér lùn","abbr":"trel","explanation":"犹言相提并论。把不同的人或不同的事放在一起谈论或看待。","source":{"text":"夫破人之与破于人也，臣人之与臣于人也，岂可同日而论哉！","book":"西汉·司马迁《史记·苏秦列传》"},"example":{"text":"南朝·宋·范晔《后汉书·李国传》：“明公踵伯成之高，全不朽之誉，岂与外戚凡辈耽荣好位者～哉！”"},"similar":["同日而言","同日而语"],"usage":"作谓语、宾语；用于否定句"},{"id":11165,"word":"同日而语","pinyin":"tóng rì ér yǔ","abbr":"trey","explanation":"日：时日。同时来讲。比喻一样看待。","source":{"text":"夫破人之与破于人也，臣人之与臣于人也，岂可同日而言之哉？","book":"《战国策·赵策二》"},"example":{"text":"由此观之，其为乐未可以～也。","book":"宋·苏轼《放鹤亭记》"},"similar":["混为一谈","相提并论","等量齐观"],"opposite":["分门别类","较短论长"],"usage":"作谓语、宾语；用于否定句"},{"id":11166,"word":"同日而道","pinyin":"tóng rì ér dào","abbr":"tred","explanation":"把不同的人或不同的事放在一起谈论或看待。同“同日而论”。","source":{"text":"夫臣与主岂可同日而道哉！","book":"西汉·司马迁《史记·张耳陈余列传》"},"similar":["同日而论","同日而语"],"usage":"作谓语、宾语；用于否定句"},{"id":11167,"word":"同时并举","pinyin":"tóng shí bìng jǔ","abbr":"tsbj","explanation":"在同一时间内一起进行。","source":{"text":"以伏汛将至，近河诸地岁频歉，贫民甚多，谕疏筑诸工同时并举，以工代赈。","book":"《清史稿·嵇璜传》"},"example":{"text":"若把新旧两种道德～，岂不是认道德可以反背吗？","book":"俞平伯《我的道德谈》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":11168,"word":"同明相照","pinyin":"tóng míng xiāng zhào","abbr":"tmxz","explanation":"指二光相互映照而愈明。比喻杰出人物得贤者揄扬而声名更显。","source":{"text":"同明相照，同类相求，云从龙，风从虎。","book":"《史记·伯夷列传》"},"example":{"text":"况如弟者，～，情切自倍。","book":"明·汤显祖《玉茗堂尺牍·复瞿睿夫》卷五"},"usage":"作宾语、定语；用于书面语"},{"id":11169,"word":"同是天涯沦落人","pinyin":"tóng shì tiān yá lún luò rén","abbr":"tstyllr","explanation":"大家都是有不幸的遭遇的人。","source":{"text":"同是天涯沦落人，相逢何必曾相识。","book":"唐·白居易《琵琶行》"},"example":{"text":"我们～，得相互提携。"},"similar":["同病相怜"],"usage":"作谓语、分句；指共命运"},{"id":11170,"word":"同条共贯","pinyin":"tóng tiáo gòng guàn","abbr":"ttgg","explanation":"条：枝条；贯：钱串。长在同一枝条上。比喻事理相通，脉络连贯。","source":{"text":"夫帝王之道，岂不同条共贯与？","book":"东汉·班固《汉书·董仲舒传》"},"example":{"text":"～，无取于甘辛相忌也。","book":"章炳麟《文学说例》"},"usage":"作谓语；指事理相通，脉络连贯"},{"id":11171,"word":"同欲相助","pinyin":"tóng yù xiāng zhù","abbr":"tyxz","explanation":"指志趣、欲望相同的人互相帮助。","source":{"text":"故同利相死，同情相成，同欲相助。","book":"《淮南子·兵略训》"}},{"id":11172,"word":"同欲相趋","pinyin":"tóng yù xiāng qū","abbr":"tyxq","explanation":"欲望相同，趋向一致。","source":{"text":"同欲相趋，同利相死。","book":"《史记·吴王濞列传》"}},{"id":11173,"word":"同气之亲","pinyin":"tóng qì zhī qīn","abbr":"tqzq","explanation":"指同胞兄弟。","source":{"text":"凡匹夫一介，尚不忘箪食之惠，况臣居宰相之位，同气之亲哉！","book":"《后汉书·东平献王苍传》"},"example":{"text":"继文汝之令弟，李弼尔之旧臣，一则有～，一则有耆年之故。","book":"清·毕沅《续资治通鉴》卷六"}},{"id":11174,"word":"同气共类","pinyin":"tóng qì gòng lèi","abbr":"tqgl","explanation":"气质相同，共属一类。","source":{"text":"同气共类，动相招致。","book":"汉·王充《论衡·寒温》"}},{"id":11175,"word":"同气相求","pinyin":"tóng qì xiāng qiú","abbr":"tqxq","explanation":"比喻志趣相同的人自然结合在一起。","source":{"text":"同声相应，同气相求。水流湿，火就燥，云从龙，风从虎。圣人作而万物睹。","book":"《周易·乾》"},"example":{"text":"要视作家如友朋，～，体会其甘苦。","book":"孙犁《澹定集·金梅序》"},"similar":["意气相投","情投意合"],"opposite":["格格不入"],"usage":"作谓语、宾语；指情投意合"},{"id":11176,"word":"同气连枝","pinyin":"tóng qì lián zhī","abbr":"tqlz","explanation":"比喻同胞的兄弟姐妹。","source":{"text":"孔怀兄弟，同气连枝。","book":"南朝梁·周兴嗣《千字文》"},"example":{"text":"我自然爱我的弟弟，我们原是～的。","book":"冰心《寄小读者·横滨》"},"similar":["同气连根"],"usage":"作谓语、宾语；比喻同胞的兄弟姐妹"},{"id":11177,"word":"同气连根","pinyin":"tóng qì lián gēn","abbr":"tqlg","explanation":"比喻同胞的兄弟姐妹的手足之情。","source":{"text":"孔怀兄弟，同气连枝。","book":"南朝·梁·周兴嗣《千字文》"},"similar":["同气连枝"],"usage":"作谓语、宾语；多用于比喻句"},{"id":11178,"word":"同流合污","pinyin":"tóng liú hé wū","abbr":"tlhw","explanation":"流：流俗；污：肮脏。指跟坏人一起干坏事。","source":{"text":"同乎流俗，合乎污世。","book":"《孟子·尽心下》"},"example":{"text":"此数贼者，～，败坏国政。","book":"清·陈忱《水浒后传》第二十二回"},"similar":["同恶相济","狼狈为奸","随俗浮沉"],"opposite":["泾渭分明","洁身自好"],"usage":"作谓语、宾语；指跟坏人一起干坏事","story":["战国时期，孟子同他的学生万章谈起孔子十分厌恶“乡愿”，万章不明白乡愿是什么人。孟子说乡愿是乡里那些八面玲珑、惯于奉承讨好别人的老好人，也就是“好好先生”，他们“同乎流俗，合乎污世”，骨子里很坏，让人厌恶"]},{"id":11179,"word":"同浴讥裸","pinyin":"tóng yù jī luǒ","abbr":"tyjl","explanation":"在一起洗澡却讥嘲他人赤身裸体。比喻与他人有着同样缺陷，却以此嘲讽他人。","source":{"text":"予以喜谈好作，且有刻本，独恶其日趋于文，而无用于世，岂非同浴而讥裸桯乎？","book":"明·李开先《董孟才诗集序》"}},{"id":11180,"word":"同源共流","pinyin":"tóng yuán gòng liú","abbr":"tygl","explanation":"有同一源头、流向。比喻同一，统一。","source":{"text":"是以六合之内，莫不同源共流，沐浴玄德，禀仰大龢。","book":"东汉·班固《答宾戏》"},"usage":"作谓语、定语；用于书面语"},{"id":11181,"word":"同源异派","pinyin":"tóng yuán yì pai","abbr":"tyyp","explanation":"指起始、发端相同而趋向、终结不同。同“同源异流”。","source":{"text":"填词非末技，乃与史传诗文同源而异派者也。","book":"清·李渔《闲情偶寄·词曲·结构》"},"similar":["同源异流"],"usage":"作谓语、定语、宾语；多用于比喻句"},{"id":11182,"word":"同源异流","pinyin":"tóng yuán yì liú","abbr":"tyyl","explanation":"指起始、发端相同而趋向、终结不同。","source":{"text":"君就河内栖，予从关西役；同源异流止，抚事乘心迹。","book":"明·何景明《寄粹夫》诗之一"},"example":{"text":"[仲默]惟七言律与献吉～。","book":"清·陈田《明诗纪事丁签·何景明》"},"similar":["同源异派"],"usage":"作谓语、定语、宾语；多用于比喻句"},{"id":11183,"word":"同然一辞","pinyin":"tóng rán yī cí","abbr":"tryc","explanation":"犹异口同声。指大家说得都一样。","source":{"text":"听者不察也，和而唱之，同然一辞。","book":"唐·韩愈《讳辩》"},"example":{"text":"明·李贽《答刘晋川书》：“何乃～，效儿女故态也。”"},"similar":["众口一词","异口同声"],"usage":"作谓语、宾语；用于书面语"},{"id":11184,"word":"同甘共苦","pinyin":"tóng gān gòng kǔ","abbr":"tggk","explanation":"甘：甜。共同享受幸福，共同担当艰苦。","source":{"text":"燕王吊死问生，与百姓同其甘苦。","book":"《战国策·燕策一》"},"example":{"text":"夫耕于前，妻耘于后，～，相敬如宾。","book":"明·李昌祺《剪灯余话·鸾鸾传》"},"similar":["有福同享，有难同当","同甘同苦"],"opposite":["同床异梦"],"usage":"作谓语、定语、状语；指共同进退","story":["战国时期，燕昭王姬平继位后面对被齐国打败的烂摊子，就请郭隗善出谋划策治理朝政，按照郭的计谋重用郭，消息传出后，魏国的乐毅，齐国的邹衍等纷纷前来投靠，燕昭王与老百姓同甘共苦，经过28年的努力，终于国富民强"]},{"id":11185,"word":"同生共死","pinyin":"tóng shēng gòng sǐ","abbr":"tsgs","explanation":"生死与共，形容情谊极深。","source":{"text":"郑译与朕同生共死，间关危难，兴言急此，何日忘之。","book":"《隋书·郑译传》"},"example":{"text":"一对～的战友，肩并着肩；火热的手，紧紧地握在一起。","book":"罗广斌、杨益言《在烈火中永生》"},"similar":["同生死共存亡"],"usage":"作谓语、定语；指生死与共"},{"id":11186,"word":"同生死共患难","pinyin":"tóng shēng sǐ gòng huàn nàn","abbr":"tssghn","explanation":"指为了一定的目标共度患难，出生入死。","source":{"text":"将狱中情形描写出来，使全国红军和革命的工农群众，知道他们同生死共患难的战友们，正在国民党监狱内，挨日子。","book":"方志敏《狱中纪实》"},"similar":["同患难共生死"],"usage":"作谓语、定语；用于处事"},{"id":11187,"word":"同生死，共存亡","pinyin":"tóng shēng sǐ，gòng cún wáng","abbr":"tssgcw","explanation":"一同生，一同死。形容彼此间利害一致，生死与共。","source":{"text":"郑译与朕同生共死，间关危难，兴言急此，何日忘之。","book":"《隋书·郑译传》"}},{"id":11188,"word":"同生死，共患难","pinyin":"tóng shēng sǐ，gòng huàn nàn","abbr":"tssghn","explanation":"《隋书·郑译传》：“郑译与朕同生共死，间关危难，兴言急此，何日忘之。”","source":{"text":"郑译与朕同生共死，间关危难，兴言急此，何日忘之。","book":"《隋书·郑译传》"},"example":{"text":"咱们的将士多年来随我一道造反，～，如今虽然有怨言，也有人想开小差，可是鼓噪还不会。","book":"姚雪垠《李自成》第一卷第二十四章"}},{"id":11189,"word":"同病相怜","pinyin":"tóng bìng xiāng lián","abbr":"tbxl","explanation":"怜：怜悯，同情。比喻因有同样的遭遇或痛苦而互相同情。","source":{"text":"子不闻河上之歌乎？同病相怜，同忧相救。","book":"汉·赵晔《吴越春秋·阖闾内传》"},"example":{"text":"～，缀河上之悲曲。","book":"南朝梁·刘璠《广绝交论》"},"similar":["同舟共济","患难与共"],"opposite":["同床异梦","幸灾乐祸"],"usage":"作谓语、定语；用于人","story":["春秋时期，楚国奸臣费无极杀害郤宛全家。郤宛的亲戚伯暿听到消息，连夜逃到吴国，向吴王及伍子胥汇报此事。伍子胥说：“咱们一样有冤仇，你是否听过《河上歌》？这歌真让人有同病相怜、同忧相救之感。”"]},{"id":11190,"word":"同病相怜，同忧相救","pinyin":"tóng bìng xiāng lián，tóng yōu xiāng jiù","abbr":"tbxltyxj","explanation":"比喻因有同样的遭遇或痛苦而互相同情、援助。","source":{"text":"子不闻河上之歌乎？同病相怜，同忧相救。","book":"汉·赵晔《吴越春秋·阖闾内传》"},"similar":["同病相怜"],"usage":"作定语、宾语；用于人的处境","story":["春秋时期，楚国奸臣费无极杀害郤宛全家。郤宛的亲戚伯暿听到消息，连夜逃到吴国，向吴王及伍子胥汇报此事。伍子胥说：“咱们一样有冤仇，你是否听过《河上歌》？这歌真让人有同病相怜、同忧相救之感。”"]},{"id":11191,"word":"同盘而食","pinyin":"tóng pán ér shí","abbr":"tpes","explanation":"同吃一个盘中的食物。形容兄弟之间骨肉情深。","source":{"text":"吾兄弟，若在家，必同盘而食，若有近行，不至，必待其还，亦有过中不食，忍饥相待。","book":"《魏书·杨椿传》"},"usage":"作谓语、定语；用于兄弟之间"},{"id":11192,"word":"同窗契友","pinyin":"tóng chuāng qì yǒu","abbr":"tcqy","explanation":"同窗：同学；契：意气相合。老同学，好朋友。","source":{"text":"瑜告众官曰：‘此吾同窗契友也。’","book":"明·罗贯中《三国演义》第45回"},"similar":["同窗故友"],"usage":"作宾语、定语；用于交往等"},{"id":11193,"word":"同窗好友","pinyin":"tóng chuāng hǎo yǒu","abbr":"tchy","explanation":"同窗：同学。老同学，好朋友。","source":{"text":"我有个同窗故友，姓韩名辅臣。","book":"元·关汉卿《金线池》楔子"},"example":{"text":"我在开封拜托了亲戚、世交、～友，向各衙门说情，同时也递上申诉状词。","book":"姚雪垠《李自成》第二卷第三十章"}},{"id":11194,"word":"同窗故友","pinyin":"tóng chuāng gù yǒu","abbr":"tcgy","explanation":"同窗：同学。老同学，老朋友。","source":{"text":"我有个同窗故友，姓韩名辅臣。","book":"元·关汉卿《金线池》楔子"},"example":{"text":"有一～谢端卿，在庐山东林寺落发为僧，修行办道，一十五年，不下禅床。","book":"元·吴昌龄《东坡梦》第一折"},"similar":["同窗契友"],"usage":"作宾语、定语；用于交往等"},{"id":11195,"word":"同符合契","pinyin":"tóng fú hé qì","abbr":"tfhq","explanation":"比喻完全相合，完全相同。","source":{"text":"一与君同符合契，有永固之分，今便行矣。","book":"晋·陈寿《三国志·吴志·孙策传》：“术甚奇之，以坚部曲还策”裴松之注引《吴历》"},"example":{"text":"北周·庾信《齐王进赤雀表》：“即事所观，～。”"},"usage":"作谓语、定语；多用于见解与现象等"},{"id":11196,"word":"同类相从","pinyin":"tóng lèi xiāng cóng","abbr":"tlxc","explanation":"指物之同类者互相依从。","source":{"text":"同类相从，同声相应，固天之理也。","book":"战国·宋·庄周《庄子·渔父》"},"usage":"作宾语、定语；用于书面语"},{"id":11197,"word":"同类相妒","pinyin":"tóng lèi xiāng dù","abbr":"tlxd","explanation":"形容同类者不易相处。"},{"id":11198,"word":"同类相求","pinyin":"tóng lèi xiāng qiú","abbr":"tlxq","explanation":"指物之同类者互相聚合。","source":{"text":"同明相照，同类相求，云从龙，风从虎。","book":"西汉·司马迁《史记·伯夷列传》"},"example":{"text":"～，他们很容易结合的。"},"similar":["情投意合"],"opposite":["格格不入"],"usage":"作宾语、定语；指相互投合","story":["西汉时期，贾谊认为商朝末年的伯夷与叔齐不食周粟饿死在首阳山是有气节，孔子为他们树碑立传，认为有德行的人会为名节而死。之所以孔子会为他们树碑立传呢？是因为同类相求，道德相同的人才会心心相印"]},{"id":11199,"word":"同美相妒","pinyin":"tóng měi xiāng dù","abbr":"tmxd","explanation":"妒：忌妒。指容貌或才情好的人互相忌妒。","source":{"text":"同美相妒，女则武后、韦庶人、萧良娣是也；男则赵高、李斯是也。","book":"《素书·安体》"},"example":{"text":"清·翟灏《通俗编·交际》：“～，同业相仇。”"},"similar":["文人相轻","同业相仇"],"usage":"作宾语、定语；用于处世等"},{"id":11200,"word":"同胞共气","pinyin":"tóng bāo gòng qì","abbr":"tbgq","explanation":"喻指亲兄弟。","source":{"text":"体道居宗，人雄之望，海内瞻仰，同胞共气，家国所凭。","book":"《北齐书·孝昭帝纪》"},"example":{"text":"宋·叶廷珪《海录碎事·人事》：“～，谓兄弟也。”"},"usage":"作宾语、定语；用于书面语"},{"id":11201,"word":"同舟之惧","pinyin":"tóng zhōu zhī jù","abbr":"tzzj","explanation":"比喻共同为某事而忧虑、畏惧。","source":{"text":"外内齐虑，有同舟这惧，虽不能终自保完，犹足以延期挺命于深江之外矣。","book":"《三国志·魏志·傅嘏传》"}},{"id":11202,"word":"同舟共命","pinyin":"tóng zhōu gòng mìng","abbr":"tzgm","explanation":"比喻命运相同，利害一致。","source":{"text":"占光又催着道：‘我们此刻，统共一十四个人，真正同舟共命，务求大家想个法子，脱了干系才好。’","book":"清·吴研人《二十年目睹之怪现状》第一百二回"},"similar":["同船共命"],"usage":"作宾语、定语；用于处事"},{"id":11203,"word":"同舟共济","pinyin":"tóng zhōu gòng jì","abbr":"tzgj","explanation":"舟：船；济：渡，过洒。坐一条船，共同渡河。比喻团结互助，同心协力，战胜困难。也比喻利害相同。","source":{"text":"夫吴人与越人相恶也，当其同舟而济，遇风，其相救也如左右手。","book":"《孙子·九地》"},"example":{"text":"通常在林海里人与人相遇，和在远洋航海中～一样，为什么他竟这样势不两立。","book":"曲波《林海雪原》二十七"},"similar":["患难与共","风雨同舟","同舟而济"],"opposite":["反目成仇","各行其事"],"usage":"作谓语、定语；指齐心协力","story":["春秋时期，有人问孙武怎样用兵才能不败，孙武回答说用兵布阵应该像蛇一样反击猎手，蛇形阵能够首尾兼顾成为一个整体，孙武说吴国人与敌对的越国人同舟遇到风浪都能同舟共济，何况这些无仇的士兵呢？"]},{"id":11204,"word":"同舟敌国","pinyin":"tóng zhōu dí guó","abbr":"tzdg","explanation":"同舟共济的人成了敌人。","source":{"text":"若君不修德，舟中之人尽为敌国也。","book":"《史记·孙子吴起列传》"},"example":{"text":"饮恨亲冤已数年，枕戈思报叹无缘。～今相遇，又隔江山路几千。","book":"明·冯梦龙《醒世恒言》卷三十六"},"similar":["舟中敌国"],"usage":"作宾语、定语；指同舟共济的人成了敌人"},{"id":11205,"word":"同舟而济","pinyin":"tóng zhōu ér jì","abbr":"tzej","explanation":"舟：船；济：渡，过洒。坐一条船，共同渡河。比喻团结互助，同心协力，战胜困难。也比喻利害相同。","source":{"text":"夫吴人与越人相恶也，当其同舟而济，遇风，其相救也如左右手。","book":"《孙子·九地》"},"example":{"text":"汉·朱穆《复奏记梁冀》：“夫将相大臣，均体之首，共舆而驰，～，舆倾舟覆，患实共之。”"},"similar":["同舟共济"],"usage":"作谓语、定语；指齐心协力"},{"id":11206,"word":"同舟遇风","pinyin":"tóng zhōu yù fēng","abbr":"tzyf","explanation":"比喻同遭逆境。","source":{"text":"同舟遇风，胡越可使为左右手，况吾民乎！","book":"宋·苏轼《钟子翼哀辞》引"},"usage":"作宾语、定语；多用于比喻句"},{"id":11207,"word":"同船合命","pinyin":"tóng chuán hé mìng","abbr":"tchm","explanation":"比喻处境相同，利害相关。","source":{"text":"一齐扯住了宗爷的衣服道：‘老元戎，你我四人乃是同船合命的。’","book":"清·钱彩《说岳全传》第12回"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“现在大家～，大人请放心。”"},"similar":["同舟合命"],"usage":"作谓语、定语；用于比喻句"},{"id":11208,"word":"同袍同泽","pinyin":"tóng páo tóng zé","abbr":"tptz","explanation":"袍：长衣服的通称；泽：内衣。原形容士兵互相友爱，同仇敌忾。比喻共事的关系（多指军人）。也指有交情的的友人。","source":{"text":"岂曰无衣，与子同袍。王于兴师，修我戈矛，与子同仇。岂曰无衣，与子同泽，王于兴师，修我矛戟，与子偕作。","book":"《诗经·秦风·无衣》"},"usage":"作谓语、定语；用于朋友之间"},{"id":11209,"word":"同谘合谋","pinyin":"tóng zī hé móu","abbr":"tzhm","explanation":"谘、谋：询问，商量。共同商量谋划。","source":{"text":"故遂与操同谘合谋，授以裨师，谓其鹰犬之才，爪牙可任。","book":"明·罗贯中《三国演义》第二十二回"}},{"id":11210,"word":"同道相益","pinyin":"tóng dào xiāng yì","abbr":"tdxy","explanation":"相：互相；益：有益。有共同志趣的人在一起，可以相互得到帮助。","source":{"text":"以之修身，则同道而相益。","book":"宋·欧阳修《朋党论》"}},{"id":11211,"word":"同门共业","pinyin":"tóng mén gòng yè","abbr":"tmgy","explanation":"同门：在同一个老师门下；业：读书。同在一个老师的门下读书。即同学。","source":{"text":"同门共业，自以为知古今之义，明君臣之礼。","book":"汉·桓宽《盐铁论·殊路》"}},{"id":11212,"word":"同门异户","pinyin":"tóng mén yì hù","abbr":"tmyh","explanation":"名义一样，实质不同。","source":{"text":"至于子思孟轲诡哉，曰吾于孙卿与，见同门而异户也。","book":"汉·扬雄《法言·君子》"},"usage":"作宾语、定语；指名义相同而实质不同"},{"id":11213,"word":"同音共律","pinyin":"tóng yīn gòng lǜ","abbr":"tygl","explanation":"音律相同。比喻关系密切。","source":{"text":"且吴与越，同音共律，上合星宿，下共一理。","book":"汉·赵晔《吴越春秋·夫差内传》"},"usage":"作谓语、定语；多用于比喻句"},{"id":11214,"word":"名下无虚","pinyin":"míng xià wú xū","abbr":"mxwx","explanation":"原意是名气大的人一定有真才实学。后比喻名不虚传。","source":{"text":"沛国刘臻，窃于公馆访《汉书》疑事十余条，并为剖析，皆有经据。臻谓所亲曰：‘名下定无虚士。’","book":"《陈书·姚察传》"},"example":{"text":"今得幸遇，真是～。","book":"清·李汝珍《镜花缘》第五十二回"},"similar":["名不虚传"],"opposite":["名不副实"],"usage":"作谓语、宾语、定语；比喻名不虚传"},{"id":11215,"word":"名下无虚士","pinyin":"míng xià wú xū shì","abbr":"mxwxs","explanation":"虚：假。原意是名气大的人一定有真才实学。后比喻名不虚传。","source":{"text":"沛国刘臻，窃于公馆访《汉书》疑事十余条，并为剖析，皆有经据。臻谓所亲曰：‘名下定无虚士。’","book":"《陈书·姚察传》"},"example":{"text":"～，秀成智勇足备，吾不如之。","book":"清·黄小配《洪秀全演义》第十四回"}},{"id":11216,"word":"名不副实","pinyin":"míng bù fù shí","abbr":"mbfs","explanation":"副：相称，符合。名声或名义和实际不相符。指空有虚名。","source":{"text":"中情之人，名不副实，用之有效。","book":"汉·祢衡《鹦鹉赋》：“惧名实之不副，耻才能之无奇。”三国·魏·刘邵《人物志·效难》"},"example":{"text":"县、区、乡各级民众政权是普遍地组织了，但是～。","book":"毛泽东《井冈山的斗争》"},"similar":["徒有虚名"],"opposite":["名副其实","名不虚传"],"usage":"作谓语、定语、定语；指空有虚名","story":["从前有一个人给大儿子取名盗，给小儿子取名殴，两个儿子聪明能干，深得父母的喜爱。一天大儿子盗拿把锄头到田间除草，母亲担心他穿得太单薄，就叫盗，官吏以为盗是贼就把他抓住，母亲叫殴去解释，大叫殴，官吏于是大殴盗"]},{"id":11217,"word":"名不常存","pinyin":"míng biāo qīng shǐ","abbr":"mbcc","explanation":"标：写明；青史：古代在竹简上记事，因称史书。把姓名事迹记载在历史书籍上。形容功业巨大，永垂不朽。","source":{"text":"古人日以远，青史字不泯。","book":"唐·杜甫《赠郑十八贲》诗"},"example":{"text":"老宰辅，你若存的赵氏孤儿，当～，万古流芳。","book":"元·纪君祥《赵氏孤儿》第二折"}},{"id":11218,"word":"名不徒显","pinyin":"míng bù tú xiǎn","abbr":"mbtx","explanation":"徒：空；显：显露。名望不会轻易得来。","source":{"text":"凡国不徒安，名不徒显，必得贤士。","book":"《吕氏春秋·期贤》"}},{"id":11219,"word":"名不正则言不顺","pinyin":"míng bù zhèng zé yán bù shùn","abbr":"mbzzybs","explanation":"名：名分；顺：合理。原指在名分上用词不当，言语就不能顺理成章。后多指说话要与自己的地位相称，否则道理上就讲不通。","source":{"text":"名不正则言不顺，言不顺则事不成。","book":"《论语·子路》"},"example":{"text":"～，以此而求国民之效死恐后，于义终有未安。","book":"邹韬奋《抗战以来·再谈抗日各党派对宪政的要求》"}},{"id":11220,"word":"名不正，言不顺","pinyin":"míng bù zhèng，yán bù shùn","abbr":"mbzybs","explanation":"指名分不正或名实不符。","source":{"text":"名不正，则言不顺；言不顺，则事不成。","book":"先秦·孔子《论语·子路》"},"example":{"text":"十之八九皆守之以僧，～，莫此为甚。","book":"清·刘献廷《广阳杂记》第二卷"},"opposite":["名正言顺"],"usage":"作宾语、定语；指名分不正或名实不符","story":["春秋时期，孔子带领弟子们周游列国，再次到达卫国时，卫国政局发生重大改变，卫出公赶走父亲而即位，孔子认为这是“名不正，言不顺”。大夫孔悝拿出一堆金币要孔子为卫出公正名，说卫出公名正言顺。孔子严正地拒绝他的要求"]},{"id":11221,"word":"名不符实","pinyin":"míng bù fú shí","abbr":"mbfs","explanation":"名声与实际不符。","source":{"text":"所谓盛名难负，名不符实，反为见笑。","book":"廖仲恺《对黄埔军校第三期入伍生训话》"},"example":{"text":"我们不能～，表里不一。"},"similar":["名不副实"],"opposite":["名副其实"],"usage":"作谓语、宾语；指名声与实际不符"},{"id":11222,"word":"名不虚传","pinyin":"míng bù xū chuán","abbr":"mbxc","explanation":"虚：假。传出的名声不是虚假的。指实在很好，不是空有虚名。","source":{"text":"然其私意廉洁退让，有足称者，名不虚言，士不虚附。","book":"《史记·游侠列传》"},"example":{"text":"系船白面问溪翁，～说未通。","book":"宋·华岳《白面渡》诗"},"similar":["名副其实"],"opposite":["徒有虚名"],"usage":"作谓语、定语；指名实相符"},{"id":11223,"word":"名不虚得","pinyin":"míng bù xū dé","abbr":"mbxd","explanation":"指盛名非凭空取得。","source":{"text":"倩娘端妍绝伦，紫云名不虚得。","book":"明·谢肇淛《五杂俎·人部》"},"example":{"text":"明·谢肇淛《五杂俎·人部》：“倩娘端妍绝伦，紫云～。”"},"similar":["名不虚立"],"opposite":["名不副实"],"usage":"作谓语、定语；指名实相符"},{"id":11224,"word":"名不虚立","pinyin":"míng bù xū lì","abbr":"mbxl","explanation":"指宜有此盛名，果然不虚妄。","source":{"text":"名不虚立，士不虚附。","book":"西汉·司马迁《史记·游侠列传》"},"example":{"text":"晋·陈寿《三国志·魏志·徐邈传》：“帝大笑，顾左右曰：‘～。’”"},"similar":["名不虚传","名不虚行"],"opposite":["名不副实"],"usage":"作谓语、定语；指名实相符"},{"id":11225,"word":"名不虚行","pinyin":"míng bù xū xíng","abbr":"mbxx","explanation":"虚：不真实。传出的名声与实际相符，不是虚假的。","source":{"text":"帝顾四坐曰：‘名不虚行。’","book":"《晋书·唐彬传》"},"similar":["名不虚得","名不虚立"],"opposite":["名不副实"],"usage":"作谓语、定语；指名实相符"},{"id":11226,"word":"名书竹帛","pinyin":"míng shū zhú bó","abbr":"mszb","explanation":"书：书写，记载；竹帛：史书。把名字留在史书上。比喻好名声永远流传。","source":{"text":"昔李陵，提步卒五千，不免身降匈奴，尚得名书竹帛。","book":"唐·吴兢《贞观政要·任贤》"},"similar":["名书锦轴","名垂竹帛"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":11227,"word":"名书锦轴","pinyin":"míng shū jǐn zhóu","abbr":"msjz","explanation":"锦轴：古代把历史写在带轴的锦缎上，代称历史。将名字写在史书上。","source":{"text":"遗子黄金宝，何如教一经。姓名书锦轴，朱紫佐朝廷。","book":"《神童诗·劝学》"},"similar":["名书竹帛","名垂竹帛"],"usage":"作谓语、定语；用于书面语"},{"id":11228,"word":"名从主人","pinyin":"míng cóng zhǔ rén","abbr":"mczr","explanation":"事物以主人所称之名为名。","source":{"text":"孔子曰：‘名从主人，物从中国。’","book":"《榖梁传·桓公二年》"},"example":{"text":"李去病听见他开口说‘支那’两字，心中好生不悦，忖道：怎么连～的道理都不懂得？","book":"梁启超《新中国未来记》第五回"},"usage":"作宾语、定语；指事物应以原主为名"},{"id":11229,"word":"名价日重","pinyin":"míng jià rì zhòng","abbr":"mjrz","explanation":"名价：声望；日重：一天天增加。名声一天天大起来。","source":{"text":"初，父邵使与南阳宗少文谈系象，往复数番，少文每欲屈，握麈尾叹曰：‘吾道东矣。’于是名价日重。","book":"《宋书·张敷传》"}},{"id":11230,"word":"名倾一时","pinyin":"míng qīng yī shí","abbr":"mqys","explanation":"倾：倾慕，钦佩。在一个时期内名声很大。","source":{"text":"王翚名倾一时，原祁高旷之致实过之。","book":"《清史稿·艺术·王时敏传附原祁》"},"similar":["名重一时"],"usage":"作谓语、定语；指名声传扬于一个时期"},{"id":11231,"word":"名公大笔","pinyin":"míng gōng dà bǐ","abbr":"mgdb","explanation":"名家的大手笔。","source":{"text":"名公大笔，却是本家风味。","book":"清·曹雪芹《红楼梦》第18回"},"usage":"作主语、宾语、定语；用于作品等"},{"id":11232,"word":"名公巨人","pinyin":"míng gōng jù rén","abbr":"mgjr","explanation":"指有名望的显要人物。亦作“名公钜人”。","source":{"text":"自秦至今，名公巨人，继跡史书。","book":"唐·韩愈《徐偃王庙碑》"},"example":{"text":"细看下款，才知道这是所谓京兆布衣知堂先生周作人的近影，并非～的遗像。","book":"廖沫沙《人间何世》"},"similar":["名流巨子"],"opposite":["匹夫匹妇"],"usage":"作主语、宾语、定语；指名人"},{"id":11233,"word":"名公巨卿","pinyin":"míng gōng jù qīng","abbr":"mgjq","explanation":"指有名望的权贵。亦作“名公钜卿”。","source":{"text":"与他往来的，俱是名公巨卿。","book":"明·冯梦龙《醒世恒言》第29卷"},"example":{"text":"这些案件，是不是有～在内的。","book":"鲁迅《论人言可畏》"},"similar":["达官贵人","公子王孙"],"usage":"作主语、宾语、定语；指高官"},{"id":11234,"word":"名公钜人","pinyin":"míng gōng jù rén","abbr":"mgjr","explanation":"指有名望的显要人物。同“名公巨人”。"},{"id":11235,"word":"名公钜卿","pinyin":"míng gōng jù qīng","abbr":"mgjq","explanation":"指有名望的权贵。同“名公巨卿”。"},{"id":11236,"word":"名列前茅","pinyin":"míng liè qián máo","abbr":"mlqm","explanation":"比喻名次列在前面。","source":{"text":"蔿敖为宰，择楚国之令典，军行，右辕，左追蓐，前茅虑无，中权，后劲。","book":"《左传·宣公十二年》"},"example":{"text":"去年弟在京师，听说二公子中了秀才，且～，颇为学台赏识，实在可贺可贺。","book":"姚雪垠《李自成》第二卷第十七章"},"similar":["首屈一指"],"opposite":["名落孙山"],"usage":"作谓语、定语；指名次列在前面","story":["春秋时期，晋国派大将荀林父做统率援助郑国，还没到黄河边，郑国就投降了楚国，他们执行楚国的好法典，楚军分右、左、前、中、后五军，由前军拿着茅草当旌旗开路。中军辅佐先不听荀林父的指挥而攻楚，结果大败而归"]},{"id":11237,"word":"名利之境","pinyin":"míng lì zhī jìng","abbr":"mlzj","explanation":"境：场所。名和利的场所。指官场。","source":{"text":"不扫一室，自怀包括之心；独守太玄，且忘名利之境。","book":"唐·杨炯《李君神道碑》"}},{"id":11238,"word":"名利兼收","pinyin":"míng lì jiān shōu","abbr":"mljs","explanation":"收：收获。又有名又得利。","source":{"text":"人家可以这样作，作了还来个名利兼收。","book":"老舍《赵子曰》"},"example":{"text":"老舍《赵子曰》：“人家可以这样作，作了还来个～。”"},"similar":["名利双收"],"usage":"作谓语、宾语；指既得名声又获利益"},{"id":11239,"word":"名利双收","pinyin":"míng lì shuāng shōu","abbr":"mlss","explanation":"既得名声，又获利益。","source":{"text":"因为他此番奉委，一定名利双收，因此大家借了趵突泉地方，凑了公分备了一席酒替他送行。","book":"清·李宝嘉《官场现形记》第七回"},"example":{"text":"其实～，三百六十行生意，再没有强如做官的了。","book":"清·彭养鸥《黑籍冤魂》第六回"},"similar":["功成名就","名利兼收"],"usage":"作谓语、宾语；指既得名声又获利益"},{"id":11240,"word":"名副其实","pinyin":"míng fù qí shí","abbr":"mfqs","explanation":"名声或名义和实际相符。","source":{"text":"君澡身浴德，流声本州，忠能成绩，为世美谈，名实相符，过人甚远。","book":"汉·曹操《与王修书》"},"example":{"text":"而况教育能不能～，还是个不能便下断语的问题。","book":"叶圣陶《桥上》"},"similar":["名符其实"],"opposite":["名不副实"],"usage":"作谓语、定语；指名义和实际相符"},{"id":11241,"word":"名动天下","pinyin":"míng dòng tiān xià","abbr":"mdtx","explanation":"动：震动。名声震动天下。形容人声名显赫。","source":{"text":"年十七八，已名动郡邑间，比登进士，遂名动天下。","book":"明·焦竑《玉堂丛语·文学》"}},{"id":11242,"word":"名卿巨公","pinyin":"míng qīng jù gōng","abbr":"mqjg","explanation":"有名声的权贵。","source":{"text":"名卿巨公往往见于余文。","book":"宋·欧阳修《江邻几文集序》"},"example":{"text":"～多所推尊，叶內翰清臣牧金陵。","book":"宋·释惟白《续传灯录》卷十"},"similar":["名公巨卿","达官贵人"],"usage":"作主语、宾语、定语；指高官"},{"id":11243,"word":"名卿钜公","pinyin":"míng qīng jù gōng","abbr":"mqjg","explanation":"名公巨卿。指有名望的权贵。"},{"id":11244,"word":"名同实异","pinyin":"míng tóng shí yì","abbr":"mtsy","explanation":"名称相同，而实质不一样。","source":{"text":"俱与有术之士有谈说之名，而实相去千万也，此夫名同而实异者也。","book":"《韩非子·奸劫弑臣》"},"example":{"text":"元稹所说均田是均田赋，与唐朝前期的均田制～。","book":"范文澜《中国通史》第三编第二章第四节"},"usage":"作谓语、定语、宾语；多用于事物"},{"id":11245,"word":"名噪一时","pinyin":"míng zào yī shí","abbr":"mzys","explanation":"噪：群鸣。一时名声很大。名声传扬于一个时期。","source":{"text":"娄上王辰玉、松江董元宰入都，名噪一时。","book":"明·沈德符《万历野获编·国师阅文偶误》"},"example":{"text":"朱半仙，时文中之能手也，～。","book":"清·宣鼎《夜雨秋灯录三集·科场》"},"similar":["名震一时"],"opposite":["默默无闻"],"usage":"作谓语、定语；指名声传扬于一个时期"},{"id":11246,"word":"名垂万古","pinyin":"míng chuí wàn gǔ","abbr":"mcwg","explanation":"指名声永远流传。","source":{"text":"德尊一代常坎坷，名垂万古知何用。","book":"唐·杜甫《醉时歌》"},"example":{"text":"平生牵系为浮名，～知何用。","book":"宋·欧阳珣《踏落行》词"},"similar":["名垂千古"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指好名声"},{"id":11247,"word":"名垂千古","pinyin":"míng chuí qiān gǔ","abbr":"mcqg","explanation":"比喻好名声永远流传。","source":{"text":"德尊一代常坎坷，名垂万古知何用。","book":"唐·杜甫《醉时歌》"},"example":{"text":"六朝金粉足能使它～，何况它还有明、清两代的政治大潮，还有近代和现代的殷殷血火。","book":"余秋雨《文化苦旅·五城记》"},"similar":["名垂青史","名垂后世","名垂万古"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指好名声"},{"id":11248,"word":"名垂千秋","pinyin":"míng chuí qiān qiū","abbr":"mcqq","explanation":"比喻好名声永远流传。","source":{"text":"往者二贤，名垂千秋。","book":"《乐府诗集·满歌行二首》其二"},"example":{"text":"这三人何尝不是残废？但却～万世！在宽，一死易耳，大丈夫当在绝难之中以求生！","book":"梁羽生《江湖三女侠》第十三回"}},{"id":11249,"word":"名垂后世","pinyin":"míng chuí hòu shì","abbr":"mchs","explanation":"好名声流传的后代。","source":{"text":"范蠡三迁皆有荣名，名垂后世。","book":"西汉·司马迁《史记·越王勾践世家》"},"example":{"text":"身著图象，～。","book":"晋·陈寿《三国志·魏志·臧洪传》"},"similar":["名垂百世"],"usage":"作谓语、定语；指好名声"},{"id":11250,"word":"名垂宇宙","pinyin":"míng chuí yǔ zhòu","abbr":"mcyz","explanation":"垂：流传。名誉传遍天下。","source":{"text":"诸葛大名垂宇宙，宗臣遗像肃清高。","book":"唐·杜甫《咏怀古迹》五"}},{"id":11251,"word":"名垂百世","pinyin":"míng chuí bǎi shì","abbr":"mcbs","explanation":"垂：流传下去。好名声流传后代。","source":{"text":"范蠡三迁皆有荣名，名垂后世。臣主若此，欲毋显得乎。","book":"《史记·越王勾践世家》"},"example":{"text":"命终三纪，～。","book":"明·罗贯中《三国演义》第五十七回"},"similar":["名垂后世"],"usage":"作谓语、定语；指好名声"},{"id":11252,"word":"名垂竹帛","pinyin":"míng chuí zhú bó","abbr":"mczb","explanation":"比喻好名声永远流传。","source":{"text":"声可托于弦管，名可留于竹帛。","book":"《吴越春秋·勾践伐吴外传》"},"example":{"text":"十万人马不是一个小数目，将军如真能为朝廷效力，将来定能建不世功业，～。","book":"姚雪垠《李自成》第一卷第十六章"},"similar":["名书竹帛","名垂青史"],"usage":"作谓语、定语；指好名声"},{"id":11253,"word":"名垂罔极","pinyin":"míng chuí wǎng jí","abbr":"mcwj","explanation":"罔极：没有极限，极为久远。名声流传的极为久远。","source":{"text":"所谓金相玉质，百世无匹，名垂罔极，永不刊灭者矣。","book":"汉·王逸《楚辞章句·序》"}},{"id":11254,"word":"名垂青史","pinyin":"míng chuí qīng shǐ","abbr":"mcqs","explanation":"青史：古代在竹简上记事，因称史书。把姓名事迹记载在历史书籍上。形容功业巨大，永垂不朽。","source":{"text":"古人日以远，青史字不泯。","book":"唐·杜甫《赠郑十八贲》诗"},"example":{"text":"无不希望捧着张献忠成就大事，自己成为开国功臣，封侯拜相，封妻荫子，并且～。","book":"姚雪垠《李自成》第二卷第二十三章"},"similar":["万古流芳","名垂千古","名垂后世"],"opposite":["遗臭万年","不见经传"],"usage":"作谓语、定语、分句；指好名声"},{"id":11255,"word":"名士夙儒","pinyin":"míng shì sù rú","abbr":"mssr","explanation":"名士：有名的人；夙儒：有学问的人。知名人士和老学者。","source":{"text":"复衣垢弊，居一室，学自力，非名士夙儒不与游。","book":"《新唐书·萧复传》"},"usage":"作主语、宾语、定语；用于名学者"},{"id":11256,"word":"名士风流","pinyin":"míng shì fēng liú","abbr":"msfl","explanation":"名士：指恃才放达不拘小节的人。名士的风度和习气。指有才学而不拘礼法。","source":{"text":"汉世这所谓名士者，其风流可知矣。","book":"《后汉书·方术传论》"},"example":{"text":"好好！咱们～，下该洒脱些才是。","book":"清·李宝嘉《文明小史》第三十一回"},"similar":["名士风度"],"usage":"作宾语；指名士的风度和气韵"},{"id":11257,"word":"名声在外","pinyin":"míng shēng zài wài","abbr":"mszw","explanation":"名声：名誉，声望。指人出名后，名声在外流传，为众人所知。","example":{"text":"他不但有名有姓，还是～。","book":"林斤澜《阳台》"}},{"id":11258,"word":"名声扫地","pinyin":"míng shēng sǎo dì","abbr":"mssd","explanation":"名声：名誉，声望；扫地：比喻破坏无余。比喻名誉和声望被彻底破坏。","example":{"text":"他们要想对付哪一个人，是先收集能使此人～的“材料”，或是动用酷刑，叫他招承一连串耸人听闻的罪状。","book":"孙犁《耕堂读书记》七"}},{"id":11259,"word":"名声籍甚","pinyin":"míng shēng jí shèn","abbr":"msjs","explanation":"比喻名声极大。","source":{"text":"陆生以此游汉廷公卿间，名声籍甚。","book":"《史记·陆贾列传》"},"example":{"text":"策入等，以秘书郎签书平江军判官，～。","book":"《宋史·李清臣传》"},"similar":["大名鼎鼎"],"opposite":["默默无闻"],"usage":"作谓语、定语；用于书面语"},{"id":11260,"word":"名声若日月","pinyin":"míng shēng ruò rì yuè","abbr":"msrry","explanation":"名声：名誉；若：象。名誉声望象日月之光，永不消失。形容德高望重。","source":{"text":"盗跖吟口，名声若日月。","book":"《荀子·不苟》"}},{"id":11261,"word":"名声过实","pinyin":"míng shēng guò shí","abbr":"msgs","explanation":"名声超过实际。指虚有其名。","source":{"text":"及为将军守边，招致宾客而下士，名声过实。","book":"《史记·韩信卢绾列传》"},"similar":["名过其实"],"usage":"作谓语、定语；指名声超过实际才能"},{"id":11262,"word":"名存实亡","pinyin":"míng cún shí wáng","abbr":"mcsw","explanation":"名义上还存在，实际上已消亡。","source":{"text":"郡邑皆有孔子庙，或不能修事，虽设博士弟子，或役于有司，名存实亡。","book":"唐·韩愈《处州孔子庙碑》"},"example":{"text":"五代兵革相继，礼法陵夷，顾惟考课之文祗拘州县之辈，黜陟既异，～。","book":"《宋史·梁鼎传》"},"similar":["有名无实"],"opposite":["名副其实"],"usage":"作谓语、补语；形容只剩一个空名"},{"id":11263,"word":"名存实废","pinyin":"míng cún shí fèi","abbr":"mcsf","explanation":"名义上还存在，实际上已废除。","source":{"text":"郡邑皆有孔子庙，或不能修事，虽设博士弟子，或役于有司，名存实亡。","book":"唐·韩愈《处州孔子庙碑》"},"example":{"text":"堤以“永济”名者，自唐已有之，今～，不可复考。","book":"明·李东阳《冀州城重修记》"}},{"id":11264,"word":"名实不副","pinyin":"míng shí bù fù","abbr":"msbf","explanation":"名：名称；副：相称，相符合。名声和实际不相符。指空有虚名。","source":{"text":"宰衡官以正百僚、平海内为职，而无印信，名实不副。","book":"东汉·班固《汉书·王莽传上》"},"example":{"text":"无论怎样言行不符，～。","book":"鲁迅《十四年的“读经”》"},"similar":["名不副实"],"opposite":["名副其实"],"usage":"作谓语、定语、定语；指空有虚名"},{"id":11265,"word":"名实相副","pinyin":"míng shí xiāng fù","abbr":"msxf","explanation":"名声和实际一致。","source":{"text":"昔国家东迁，文举盛叹鸿豫名实相副，综达经学，出于郑玄，又明《司马法》；鸿豫亦称文举奇逸博闻。","book":"汉·陆粹《为曹公与孔融书》"},"example":{"text":"又如臣下有所建议，君主便叫他去做，看他能照所说的作到否。～的赏；否则罚。","book":"朱自清《经典常谈·诸子第十》"},"similar":["名实相符","名副其实"],"opposite":["名不副实"],"usage":"作谓语、定语；指名声与实际一致"},{"id":11266,"word":"名实相称","pinyin":"míng shí xiāng chèn","abbr":"msxc","explanation":"指名声与实际一致。","source":{"text":"妹子这个名字，叫做有名无实，那里及得尧蓂姐姐弹得幽雅，他才名实相称哩。","book":"清·李汝珍《镜花缘》第72回"},"similar":["名实相符","名实相副"],"opposite":["徒有虚名","名不副实"],"usage":"作谓语、定语；指名声与实际一致"},{"id":11267,"word":"名实相符","pinyin":"míng shí xiāng fú","abbr":"msxf","explanation":"名声与实际一致。","source":{"text":"君澡身澡德，流声本州，忠能成绩，为世美谈，名实相符，过人甚远。","book":"三国·曹操《与王修书》"},"example":{"text":"海口市是一个～的花园城市。"},"similar":["名副其实","名实相称"],"opposite":["徒有虚名","名不副实"],"usage":"作谓语、定语；指名声与实际一致"},{"id":11268,"word":"名实难副","pinyin":"míng shí nán fù","abbr":"msnf","explanation":"名声大，实际才能与名声不相称。","source":{"text":"阳春之曲，和者必寡。盛名之下，其实难副。","book":"南朝·宋·范晔《后汉书·黄琼传》"},"example":{"text":"这儿的特产真是～。"},"similar":["名实不副"],"opposite":["名副其实"],"usage":"作谓语、定语；指实际才能与名声不相称"},{"id":11269,"word":"名山之席","pinyin":"míng shān zhī xí","abbr":"mszx","explanation":"指书院负责人。","source":{"text":"独恨此辈既充塞国中，岂无上膺执政之权，下拥名山之席者？","book":"清·严复《道学外传》"}},{"id":11270,"word":"名山事业","pinyin":"míng shān shì yè","abbr":"mssy","explanation":"名山：古代帝王藏策之府。世故在帝王藏策之府的事业。多指不朽的著作。","source":{"text":"藏之名山，副在京师，俟后世圣人君子。","book":"《史记·太史公自序》"},"example":{"text":"我在这个生活圈内，我岂能泰然晏居，从事于～吗？（郭沫若《行路难》）"},"usage":"作宾语；指不朽的著作"},{"id":11271,"word":"名山大川","pinyin":"míng shān dà chuān","abbr":"msdc","explanation":"泛指有名的高山和源远流长的大河。","source":{"text":"底商之罪，告于皇天后土，所过名山大川。","book":"《尚书·武成》"},"example":{"text":"虽然那子胥多有本事，凭着俺这～，长江险阻，那伍子胥怎便容易到的俺国来。","book":"元·郑廷玉《楚昭公》第一折"},"similar":["锦绣河山"],"opposite":["穷山恶水"],"usage":"作主语、宾语、定语；指好的风景"},{"id":11272,"word":"名山胜川","pinyin":"míng shān shèng chuān","abbr":"mssc","explanation":"风景优美的著名河山。","source":{"text":"居职不留心碎务，纵意游肆，名山胜川，靡不穷究。","book":"《晋书·孙统传》"},"example":{"text":"祖国的～数不胜数。"},"similar":["名山大川","名山胜水"],"opposite":["穷山恶水"],"usage":"作主语、宾语、定语；指著名山川"},{"id":11273,"word":"名山胜水","pinyin":"míng shān shèng shuǐ","abbr":"msss","explanation":"风景优美的著名河山。同“名山胜川”。","source":{"text":"底商之罪，告于皇天后土，所过名山大川。","book":"《尚书·武成》"},"example":{"text":"这绣江县是济南府的外县，离府城一百一十里路，是山东有数的大地方，四境多有～。","book":"清·西周生《醒世姻缘传》第二十三回"},"similar":["名山胜川"],"usage":"作主语、宾语、定语；指著名山川"},{"id":11274,"word":"名师出高徒","pinyin":"míng shī chū gāo tú","abbr":"mscgt","explanation":"高明的师傅一定能教出技艺高的徒弟。比喻学识丰富的人对于培养人才的重要。","source":{"text":"顾先生摇头道：‘唉！名师出高徒，名师出高徒。","book":"钱钟书《围城》"},"example":{"text":"真是～，你的学生真是好样的。"},"similar":["严师出高徒"],"usage":"作宾语、定语；用于夸奖人"},{"id":11275,"word":"名微众寡","pinyin":"míng wēi zhòng guǎ","abbr":"mwzg","explanation":"微、寡：小，少；众：人数。名声小，人数少。","source":{"text":"彼名微众寡，易以讨御，吾不过一月，自足周旋。","book":"《晋书·傉檀传》"},"example":{"text":"曹操比诸袁绍，～，乃竟并吞袁氏，转弱为强，虽赖天时，亦借人谋。","book":"蔡东藩《后汉演义》第八十二回"}},{"id":11276,"word":"名德重望","pinyin":"míng dé zhòng wàng","abbr":"mdzw","explanation":"犹德高望重。道德高尚，名望很大。","source":{"text":"所幸菩萨不至终穷，有柳塘老以名德重望为东道主。","book":"明·李贽《与弱侯焦太史书》"},"example":{"text":"当时尝屡布之诏令，是以～若范文正公家。亦有是事。","book":"清·叶廷琯《吹网录·赵用圹志书女再嫁》"},"usage":"作宾语、定语；用于人"},{"id":11277,"word":"名我固当","pinyin":"míng wǒ gù dāng","abbr":"mwgd","explanation":"叫我这个名字实在很恰当。"},{"id":11278,"word":"名扬四海","pinyin":"míng yáng sì hǎi","abbr":"mysh","explanation":"四海：天下。名声传扬到天下。形容名声很大。","source":{"text":"这是一段姻缘天上来，现如今名扬四海。","book":"元·郑光祖《刍梅香》第四折"},"example":{"text":"潮汕功夫茶～。"},"similar":["名扬天下"],"opposite":["默默无闻"],"usage":"作谓语、定语；指出名"},{"id":11279,"word":"名扬天下","pinyin":"míng yáng tiān xià","abbr":"mytx","explanation":"形容名声极大。","source":{"text":"名满于天下，不若其已也。","book":"《管子·白心》"},"example":{"text":"驾着宝船到达圣地麦加，成为一家之中第三位“马哈吉”，成为～的中国穆斯林！","book":"霍达《穆斯林的葬礼》第三章"},"similar":["名高天下","名满天下"],"usage":"作谓语、定语；比喻全国闻名"},{"id":11280,"word":"名教罪人","pinyin":"míng jiào zuì rén","abbr":"mjzr","explanation":"名教：指以正名定分为主的封建礼教。指破坏封建名分礼教的人。","source":{"text":"公论弗容，士友交谪，皆以为名教罪人，臣实惧也。","book":"宋·袁燮《又乞归田里第一奏》"},"example":{"text":"故于非圣无法者，不得不诋为～，以求亲媚于君上。","book":"吴虞《明李卓吾别传》"}},{"id":11281,"word":"名显天下","pinyin":"míng xiǎn tiān xià","abbr":"mxtx","explanation":"形容名声极大。","source":{"text":"孙膑以此名显天下，世传其兵法。","book":"西汉·司马迁《史记·孙子吴起列传》"},"similar":["名闻天下","名扬天下"],"usage":"作谓语、定语；比喻全国闻名"},{"id":11282,"word":"名标青史","pinyin":"míng biāo qīng shǐ","abbr":"mbqs","explanation":"标：写明；青史：古代在竹简上记事，因称史书。把姓名事迹记载在历史书籍上。形容功业巨大，永垂不朽。","source":{"text":"古人日以远，青史字不泯。","book":"唐·杜甫《赠郑十八贲》诗"},"example":{"text":"老宰辅，你若存的赵氏孤儿，当～，万古流芳。","book":"元·纪君祥《赵氏孤儿》第二折"},"similar":["永垂不朽","名垂青史"],"opposite":["遗臭万年"],"usage":"作谓语、宾语；指功业、名声等"},{"id":11283,"word":"名正理顺","pinyin":"míng zhèng lǐ shùn","abbr":"mzls","explanation":"指名义正当，合乎道理。","source":{"text":"太宗諡曰文，行周道也。名正理顺，垂之无穷。","book":"唐·颜真卿《请复七圣谥号状》"},"example":{"text":"三酒之名，以酌有事者，取赐酒则别为一名，庶几～。","book":"宋·赵彦卫《云麓漫钞》卷三"},"similar":["名正言顺"],"usage":"作谓语、定语、补语；用于说话"},{"id":11284,"word":"名正言顺","pinyin":"míng zhèng yán shùn","abbr":"mzys","explanation":"名：名分，名义；顺：合理、顺当。原指名分正当，说话合理。后多指做某事名义正当，道理也说得通。","source":{"text":"《论语·子路》“名不正则言不顺，言不顺则事不利。”"},"example":{"text":"待小生得官回来，谐两姓之好，却不～。","book":"元·郑德辉《倩女离魂》第二折"},"similar":["理直气壮"],"opposite":["理屈词穷"],"usage":"作谓语、定语、补语；用于说话","story":["孔子因不满鲁定公沉迷酒色，带领学生来到卫国，因卫灵公言而无信，就留下子路一人，他带领其他学生离开卫国。卫出公继位后，让子路去请孔子来卫国辅政。孔子说：“只有名义正当，说话合理，才能干成大事。”"]},{"id":11285,"word":"名流巨子","pinyin":"míng liú jù zǐ","abbr":"mljz","explanation":"著名人士与重要人物。","source":{"text":"凭着个人奋斗而出人头地，不是变成百万富翁，就是当上名流巨子。","book":"萧乾《未带地图的旅人》"},"example":{"text":"他做梦都想跻身于～之列"},"similar":["名公巨人"],"opposite":["凡夫俗子"],"usage":"作主语、宾语、定语；指知名人物"},{"id":11286,"word":"名满天下","pinyin":"míng mǎn tiān xià","abbr":"mmtx","explanation":"天下闻名。形容名声极大。","source":{"text":"名满于天下，不若其已也。","book":"《管子·白心》"},"example":{"text":"执事～，而位不过五品，其容色温然而不怒，其文章宽厚敦朴而无怨言。","book":"宋·苏轼《上梅直讲书》"},"similar":["名高天下","天下闻名"],"usage":"作谓语、定语；指名声极大"},{"id":11287,"word":"名登鬼录","pinyin":"míng dēng guǐ lù","abbr":"mdgl","explanation":"鬼录：也叫“鬼箓”，旧时迷信的人指冥间死人的名册。名字已登上鬼录了。指人将要死亡或已经死亡。","source":{"text":"顷撰其遗文，都为一集，观其姓名，已为鬼录。","book":"三国·魏·曹丕《与吴质书》"}},{"id":11288,"word":"名目繁多","pinyin":"míng mù fán duō","abbr":"mmfd","explanation":"指事物的花样或名称非常多。","source":{"text":"还有学生卫兵，女子精武军，及男女赤十字会，名目繁多，数不胜数。","book":"蔡东藩《民国通俗演义》第四回"},"example":{"text":"农民以前的苛捐杂税～。"},"similar":["巧立名目"],"usage":"作谓语、定语；指种类多"},{"id":11289,"word":"名符其实","pinyin":"míng fú qí shí","abbr":"mfqs","explanation":"符：符合。名声或名义和实际相符","source":{"text":"那边的‘国术场’还有一个老头子穿了长衫舞刀，这在中年太太之流看来，还不是名符其实的‘大杂耍’么？","book":"茅盾《全运会印象》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“只是做官要做得～，官派十足，那就不容易了。”"},"similar":["名副其实"],"opposite":["名不副实"],"usage":"作谓语、定语；指名义和实际相符"},{"id":11290,"word":"名纸生毛","pinyin":"míng zhǐ shēng máo","abbr":"mzsm","explanation":"名片都已磨出了毛，以致字迹模糊不清。比喻时间多次未见而不得见。","source":{"text":"无钱将乞樊知客，名纸毛生不肯通。","book":"唐·刘鲁风《江西投谒所知为典客所阻因赋》"},"usage":"作宾语、定语；用于人的处境"},{"id":11291,"word":"名缰利索","pinyin":"míng jiāng lì suǒ","abbr":"mjls","explanation":"缰：马缰绳；索：绳子。比喻功名利禄如束缚人的缰绳和锁链。","source":{"text":"岂非看破红尘，顿开名缰利索么？","book":"清·李汝珍《镜花缘》第40回"},"similar":["名缰利锁"],"usage":"作宾语、定语；比喻名利束缚人"},{"id":11292,"word":"名缰利锁","pinyin":"míng jiāng lì suǒ","abbr":"mjls","explanation":"缰：缰绳。比喻名利束缚人就象缰绳和锁链一样。","source":{"text":"向此免名缰利锁，虚费光阴。","book":"宋·柳永《夏云峰》词"},"example":{"text":"我们原系方外闲人，逍遥散淡，无束无拘，又何～之不能解脱耶。","book":"明·许仲琳《封神演义》第八十回"},"similar":["名缰利索"],"usage":"作宾语、定语；比喻名利束缚人"},{"id":11293,"word":"名胜古迹","pinyin":"míng shèng gǔ jī","abbr":"msgj","explanation":"风景优美和有古代遗迹的著名地方。","source":{"text":"首都所有的名胜古迹都去了两次以上。","book":"路遥《平凡的世界》第一卷第45章"},"example":{"text":"中国的名胜古迹值得我们去参观。"},"similar":["名山大川"],"usage":"作宾语；指风景优美和有古代遗迹的著名地方"},{"id":11294,"word":"名臣硕老","pinyin":"míng chén shuò lǎo","abbr":"mcsl","explanation":"硕：大；老：对古代公卿大夫的尊称。指有名望的大臣。","source":{"text":"夫国家二百年来，名臣硕老，强半出自玉堂精选。","book":"明·焦竑《玉堂丛语·序》"}},{"id":11295,"word":"名花无主","pinyin":"míng huā wú zhǔ","abbr":"mhwz","explanation":"名贵的花没有主人。比喻还没有嫁人的名门闺秀或有名气的美女。","source":{"text":"咱花枝无主，一任东风嫁。","book":"《浣溪沙传奇》"}},{"id":11296,"word":"名落孙山","pinyin":"míng luò sūn shān","abbr":"mlss","explanation":"名字落在榜末孙山的后面。指考试或选拔没有录取。","source":{"text":"吴人孙山，滑稽才子也。赴举他郡，乡人讬以子偕往。乡人子失意，山缀榜末，先归。乡人问其子得失，山曰：‘解名尽处是孙山，贤郎更在孙山外。’","book":"宋·范公偁《过庭录》"},"example":{"text":"若不幸～，那时更自难堪。","book":"清·黄小配《大马扁》第一回"},"similar":["一败涂地"],"opposite":["名列前茅"],"usage":"作谓语、定语、补语；指落选","story":["宋朝苏州滑稽才子孙山与朋友去苏州参加乡试。考完以后，孙山考中但是最后一名。朋友没考中留在省城。孙山回到乡里接受乡亲的祝贺。朋友的父亲来打听儿子的情况，他作诗“解名尽处是孙山，贤郎更在孙山外”来回答朋友的父亲"]},{"id":11297,"word":"名葩异卉","pinyin":"míng pā yì huì","abbr":"mpyh","explanation":"卉：草的总称。原意是指名贵少见的花草。也比喻美妙的文章作品等。","source":{"text":"明晃晃辉金碧，修完济楚，栽接奇异，有长松矮柏，名葩异卉。","book":"元·董解元《西厢记》第三折"},"example":{"text":"园中古藤奇木，～，山禽怪兽，种种备焉。","book":"清·沈德潜《兰雪堂记》"}},{"id":11298,"word":"名誉扫地","pinyin":"míng yù sǎo dì","abbr":"mysd","explanation":"指彻底失去声誉。","source":{"text":"我也在一边坐下，喘出一口气，感到名誉扫地，威信扫地。","book":"王朔《过把瘾就死》"},"example":{"text":"她～，没法在此呆下去了。"},"similar":["声名狼籍"],"opposite":["名扬天下"],"usage":"作谓语；指失去声誉"},{"id":11299,"word":"名贸实易","pinyin":"míng mào shí yì","abbr":"mmsy","explanation":"贸：齐等；易：变易。指名称相似，实质不同。","source":{"text":"二者名贸实易，不可不察也。","book":"《商君书·开塞》"},"usage":"作谓语、定语；指名称相似，实质不同"},{"id":11300,"word":"名过其实","pinyin":"míng guò qí shí","abbr":"mgqs","explanation":"名声超过实际才能。","source":{"text":"故禄过其功者削，名过其实者损。","book":"汉·韩婴《韩诗外传》卷一"},"example":{"text":"臣向者～，食浮于人，兄弟并窃于贤科，衣冠或以为盛事。","book":"宋·苏轼《谢量移汝州表》"},"similar":["名不副实","名声过实"],"opposite":["名副其实"],"usage":"作谓语、定语；指名声超过实际才能"},{"id":11301,"word":"名重一时","pinyin":"míng zhòng yī shí","abbr":"mzys","explanation":"名：名声；一时：当代。一个时期内名声很大，受到广泛重视。","source":{"text":"师住径山时，名重一时，如侍郎张公子韶，状元汪公圣锡少卿、冯公济川俱问道。","book":"宋·释惟白《续传灯录》卷二十七"},"example":{"text":"这位朱大人，学问经济，～。","book":"清·李宝嘉《官场现形记》第三十三回"},"similar":["名倾一时","名噪一时"],"usage":"作谓语、定语；指名声传扬于一个时期"},{"id":11302,"word":"名重天下","pinyin":"míng zhòng tiān xià","abbr":"mztx","explanation":"天下闻名。形容名声极大。","source":{"text":"欲言非，此君为善士，不宜虚言；欲言是，元龙名重天下。","book":"《管子·白心》：“名满于天下，不若其已也。”《三国志·魏志·陈登传》"},"example":{"text":"一来辱没相国家谱；二来张生日后～，施恩于人，忍令反受其辱哉？","book":"元·王实甫《西厢记》第四本第二折"}},{"id":11303,"word":"名重当时","pinyin":"míng zhòng dāng shí","abbr":"mzds","explanation":"重：敬重，器重。名望很高，在当时很有名。","source":{"text":"茂与孔休，蔡勋、刘宣、龚胜、鲍宣六人同志，不仕王莽，并名重当时。","book":"南朝·宋·范晔《后汉书·卓茂传》"},"similar":["名重一时"],"usage":"作谓语、定语；指名声传扬于一个时期"},{"id":11304,"word":"名重识暗","pinyin":"míng zhòng shí àn","abbr":"mzsa","explanation":"暗：愚昧不明。形容名气很大但学识浅薄。","source":{"text":"伯仁志大而才短，名重而识暗，好乘人之弊，此非自全之道。","book":"《晋书·周顗母李氏传》"}},{"id":11305,"word":"名门世族","pinyin":"míng mén shì zú","abbr":"mmsz","explanation":"有名望的世家大族。","source":{"text":"余见名门右族，莫不由祖先中孝勤俭以成立之。","book":"宋·朱熹《小学·外篇·嘉言》"},"example":{"text":"即如家嫂，是～，他本族家进士一大堆，他偏是异样的难讲。","book":"清·李绿园《歧路灯》第一百三回"}},{"id":11306,"word":"名门右族","pinyin":"míng mén yòu zú","abbr":"mmyz","explanation":"名门：有声望的豪门。有声望的世族之家。","source":{"text":"夫名门右族，莫不由祖考忠孝勤俭以成立之，莫不由子孙顽率奢傲以覆坠之。","book":"《新唐书·柳玭传》"},"example":{"text":"余见～，莫不由祖先中孝勤俭以成立之。","book":"宋·朱熹《小学·外篇·嘉言》"},"similar":["名门旧族"],"usage":"作主语、宾语、定语；指有名望的人"},{"id":11307,"word":"名门大族","pinyin":"míng mén dà zú","abbr":"mmdz","explanation":"名门：豪门。高贵的、地位显要的家庭或有特权的家族。","source":{"text":"你将近三十年纪，名门大族之家……切切不可干这样营生。","book":"清·西周生《醒世姻缘传》第94回"},"example":{"text":"清·西周生《醒世姻缘传》第94回：“你将近三十年纪，～之家……切切不可干这样营生。”"},"similar":["名门望族","名门世家"],"usage":"作主语、宾语、定语；指有名望的人"},{"id":11308,"word":"名门旧族","pinyin":"míng mén jiù zú","abbr":"mmjz","explanation":"名门：有声望的豪门。有声望的世族之家。","source":{"text":"这个人就是当初老相公借银子的刘员外，他是名门旧族，现有百万家财。","book":"元·无名氏《鸳鸯被》第一折"},"similar":["名门世家","名门右族"],"usage":"作主语、宾语、定语；指有名望的人"},{"id":11309,"word":"名门望族","pinyin":"míng mén wàng zú","abbr":"mmwz","explanation":"名门：豪门。高贵的、地位显要的家庭或有特权的家族。","source":{"text":"即如家嫂，是名门望族，他本族本家进士一大堆，他偏是异样的难讲。","book":"清·李绿园《歧路灯》第103回"},"example":{"text":"他出身于～。"},"similar":["名门大族"],"usage":"作主语、宾语、定语；指有名望的人"},{"id":11310,"word":"名门闺秀","pinyin":"míng mén guī xiù","abbr":"mmgx","explanation":"名门：有名望的门第；闺秀：旧指有才德的女子。出身于豪族门第的女子。","source":{"text":"这位郭观察虽是和他要好，却一向不晓得他的家事，只道贝夫人是个名门闺秀，自然是贝太史的内助，三从俱备、四德兼全的了。","book":"清·张春帆《九尾龟》第五十回"},"example":{"text":"如果她是一般的～，她必会对他全心爱慕。","book":"姚雪垠《李自成》第五卷第一章"}},{"id":11311,"word":"名闻利养","pinyin":"míng wén lì yǎng","abbr":"mwly","explanation":"佛家语。指名声远闻，以利养身。","source":{"text":"不求世间名闻利养，不乐多畜饮食、衣服、卧具、医药及余资具。","book":"《佛母般若经·菩萨相品》"},"example":{"text":"西土有诸讲师，家置一编，户抱一偈，～之故。","book":"清·龚自珍《妙法莲花经四十二问》"}},{"id":11312,"word":"名闻天下","pinyin":"míng wén tiān xià","abbr":"mwtx","explanation":"形容名声极大。","source":{"text":"功业显著，名闻天下。","book":"《北齐书·魏收传》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“这个以韩信而～的古淮阴，是南来水陆要冲的第一大码头。”"},"similar":["名扬天下","名满天下"],"usage":"作谓语、定语；比喻全国闻名"},{"id":11313,"word":"名闻遐迩","pinyin":"míng wén xiá ěr","abbr":"mwxe","explanation":"名声传扬到各地，形容名声很大。","source":{"text":"奚斤辨捷智谋，名闻遐迩。","book":"《魏书·崔浩传》"},"example":{"text":"中国的长城～。"},"similar":["名噪一时","名闻天下"],"opposite":["默默无闻"],"usage":"作谓语、定语、补语；指名声很大"},{"id":11314,"word":"名震一时","pinyin":"míng zhèn yī shí","abbr":"mzys","explanation":"名声震动当时社会。","source":{"text":"号神童，名震一时。","book":"《新唐书·刘晏传》"},"example":{"text":"《新唐书·刘晏传》：“号神童，名震一时。”"},"similar":["名噪一时"],"opposite":["默默无闻"],"usage":"作谓语、定语；指一个时期名气很大"},{"id":11315,"word":"名靰利鞚","pinyin":"míng jī lì kòng","abbr":"mwlk","explanation":"靰：马缰绳；鞚：马笼头。比喻名利束缚人就象缰绳和锁链一样。","source":{"text":"漾舟遥指烟波，群山森动，神闲意耸。迴首名靰利鞚，此情谁共。","book":"宋·方勺《泊宅编》卷一"}},{"id":11316,"word":"名鞿利鞚","pinyin":"míng jī lì zhōu","abbr":"mjlk","explanation":"犹名缰利锁。比喻名利束缚人就象缰绳和锁链一样。"},{"id":11317,"word":"名韟利鞚","pinyin":"míng jī lì zhōu","abbr":"mjlz","explanation":"犹名缰利锁。比喻名利束缚人就象缰绳和锁链一样。"},{"id":11318,"word":"名题雁塔","pinyin":"míng tí yàn tǎ","abbr":"mtyt","explanation":"雁塔：西安慈恩寺内的大雁塔，唐代进士多题姓名于塔下。在大雁塔内题名。旧时考中进士的代称。","source":{"text":"进士题名，自神龙之后，过关宴后，率皆期集于慈恩塔下题名。","book":"五代·王定保《唐摭言》卷三"},"example":{"text":"放榜集慈恩，～旁。","book":"金松岑《慈恩寺浮屠》"}},{"id":11319,"word":"名高天下","pinyin":"míng gāo tiān xià","abbr":"mgtx","explanation":"比喻全国闻名。","source":{"text":"名高天下，而光烛邻国。","book":"《史记·鲁仲连邹阳列传》"},"example":{"text":"尝君～，天下知有孟尝君，不知有齐王，不日孟尝君且代齐矣！","book":"明·冯梦龙《东周列国志》第九十四回"},"similar":["名满天下"],"usage":"作谓语、定语；比喻全国闻名"},{"id":11320,"word":"名高难副","pinyin":"míng gāo nán fù","abbr":"mgnf","explanation":"副：相称。指盛名之下，实际难与相符。","source":{"text":"峣峣者易缺，皦皦者易污，阳春之曲，和者必寡，盛名之下，其实难副。","book":"《后汉书·黄琼传》"},"example":{"text":"当时文人，皆邵之下，但以不持威仪，～，朝廷不令出境。","book":"《北史·邢邵传》"},"similar":["名高难符","名不副实","名过其实"],"opposite":["名副其实"],"usage":"作谓语、定语；指徒有虚名","story":["东汉时期，隐士黄琼不想应汉顺帝的诏书出山为官，李固写信劝他，不想为官就学巢父与许由隐居山林，不要学鲁阳隐士樊英那样名高难副，你要以事实证明你的才能。于是黄琼应诏为议郎，政绩突出，不久后升为尚书令、太尉"]},{"id":11321,"word":"后不为例","pinyin":"hòu bù wéi lì","abbr":"hbwl","explanation":"例：先例，成例。下次不可以再这样做。表示只通融这一次。","source":{"text":"时署部少宰杨时乔力谏不从，上但云后不为例而已。","book":"明·沈德符《野获编·中宫外家恩泽》"},"example":{"text":"这事到此为止，～。"},"similar":["下不为例"],"usage":"作谓语、分句；用于违规等"},{"id":11322,"word":"后不僭先","pinyin":"hòu bù jiàn xiān","abbr":"hbjx","explanation":"僭：非法占取，超越本分。后来的人不超越先来的人。形容排列有序，先后有别。","source":{"text":"你这么明白的人，难道连‘亲不隔疏，后不僭先’也不知道？","book":"《清·曹雪芹《红楼梦》第二十回"},"similar":["先来后到"],"usage":"作宾语、定语；指先后有别"},{"id":11323,"word":"后仰前合","pinyin":"hòu yǎng qián hé","abbr":"hyqh","explanation":"仰：仰面朝天；合：弯身俯地。身体前后晃动，不能自持。形容大笑的样子。","example":{"text":"我被他的幽默搞笑得～。"},"similar":["前仰后合","后合前仰"],"usage":"作状语、补语；形容站立不稳的样子"},{"id":11324,"word":"后会可期","pinyin":"hòu huì kě qī","abbr":"hhkq","explanation":"会：相见，见面；期：时期。以后还有见面的日子或机会。","example":{"text":"不要伤心，我们还有相见的一天，～。"},"similar":["后会有期"],"opposite":["后会无期","后会难期"],"usage":"作谓语；指分别时的客套话"},{"id":11325,"word":"后会无期","pinyin":"hòu huì wú qī","abbr":"hhwq","explanation":"期：时间。以后何时相会还没有一定的日期。","source":{"text":"老翁送元宝出，云：‘后会难期。’以为凄恨，别甚殷勤。","book":"北魏·杨衒之《洛阳伽蓝记·大统寺》"},"example":{"text":"某旦夕南迁，～，不能无怅惘也。","book":"宋·苏轼《与范梦得八首》其一"},"similar":["后会难期"],"opposite":["后会有期"],"usage":"作谓语、宾语；指以后很难见面了"},{"id":11326,"word":"后会有期","pinyin":"hòu huì yǒu qī","abbr":"hhyq","explanation":"期：时间。以后有见面的时候（用在分别时安慰对方）。","source":{"text":"小官公事忙，后会也有期。","book":"元·乔梦符《扬州梦》第三折"},"example":{"text":"女菩萨千万保重！我们～，暂且失陪。","book":"清·李汝珍《镜花缘》第五十一回"},"similar":["后会可期"],"opposite":["后会难期"],"usage":"作谓语；指分别时的客套话"},{"id":11327,"word":"后会难期","pinyin":"hòu huì nán qī","abbr":"hhnq","explanation":"期：盼望。以后难以盼到再有见面的机会。","source":{"text":"老翁送元宝出，云：‘后会难期。’以为凄恨，别甚殷勤。","book":"北魏·杨衒之《洛阳伽蓝记·大统寺》"},"example":{"text":"从此永别，～，无以将意。","book":"明·李昌祺《剪灯余话·田洙遇薛涛联句记》"},"similar":["后会无期"],"opposite":["后会可期"],"usage":"作谓语、宾语；指以后很难见面了"},{"id":11328,"word":"后出转精","pinyin":"hòu chū zhǎn jīng","abbr":"hczj","explanation":"后来的人变得更加细致。指在学术研究方面，后人的作用更大，见解比前人更为精深和高明。","source":{"text":"前修未密，后出转精。","book":"清·章炳麟《国故论衡》上"}},{"id":11329,"word":"后发制人","pinyin":"hòu fā zhì rén","abbr":"hfzr","explanation":"发：发动；制：控制，制服。等对方先动手，再抓住有利时机反击，制服对方。","source":{"text":"后之发，先之至，此用兵之要术也。","book":"《荀子·议兵》"},"example":{"text":"秦晋淝水之战等等有名的大战，都是双方强弱不同，弱者先让一步，～，因而战胜的。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["以退为进","以退为攻"],"opposite":["先发制人","先下手为强"],"usage":"作谓语；用于军事等方面"},{"id":11330,"word":"后台老板","pinyin":"hòu tái lǎo bǎn","abbr":"htlb","explanation":"戏班子的老板。指背后操纵、支持的人或集团。","source":{"text":"有党的领导，和供销社拉上关系，又有国家银行做后台老板，咱怕什么？","book":"柳青《创业史》第一部第13章"},"example":{"text":"我们要把他的～挖出来。"},"usage":"作宾语、定语；指幕后操纵"},{"id":11331,"word":"后合前仰","pinyin":"hòu hé qián yǎng","abbr":"hhqy","explanation":"合：曲身俯地；仰：仰面朝天。身体前后晃动。形容大笑或困倦得直不起腰的样子。","source":{"text":"东倒西歪，后合前仰，离席上。这酒兴颠狂，醉魂儿望家往。","book":"元·高文秀《遇上皇》第一折"},"similar":["前仰后合"],"usage":"作状语、补语；形容站立不稳的样子"},{"id":11332,"word":"后实先声","pinyin":"hòu shí xiān shēng","abbr":"hsxs","explanation":"实：实力；声：声势。比喻先用声势挫折敌方士气，然后交战。","source":{"text":"兵固有先声而后实者，此之谓也。","book":"《史记·淮阴侯列传》"},"similar":["先声后实","先礼后兵"],"usage":"作谓语、定语；指先礼后兵"},{"id":11333,"word":"后巷前街","pinyin":"hòu xiàng qián jiē","abbr":"hxqj","explanation":"指四处的街坊民户。","source":{"text":"不由我气扑扑按不住心头怒，打这厮不成才不识贤愚。那厮每走遍了后巷前街，几曾冲州撞府。","book":"元·无名氏《孟母三移》第二折"},"example":{"text":"若把这神术学就，孛强以在～，每日家闲茶浪酒。","book":"明·无名氏《拔宅飞升》第二折"},"usage":"作宾语、定语；用于口语"},{"id":11334,"word":"后恭前倨","pinyin":"hòu gōng qián jù","abbr":"hgqj","explanation":"倨：傲慢。以前态度傲慢，后来恭敬有礼。形容前后态度截然不同。","source":{"text":"这的是舔痔吮痈，后恭前倨，奴颜婢膝。","book":"明·孙仁孺《东郭记·殆不可复》"},"similar":["前倨后恭"],"usage":"作谓语、状语、定语；指人的前后态度"},{"id":11335,"word":"后悔不及","pinyin":"hòu huǐ bù jí","abbr":"hhbj","explanation":"后悔已经来不及了。","source":{"text":"既成谋矣，何及其未作也，先诸？作而后悔，亦无及也。","book":"《左传·哀公六年》"},"example":{"text":"及至说出口来，一觉着自己这句不好意思，一时～。","book":"清·文康《儿女英雄传》第二十二回"},"similar":["后悔莫及"],"usage":"作谓语；形容悔恨或劝诫人","story":["春秋时期，齐景公病重，让国惠子、高昭子帮助公子荼当上国君。齐景公死，其他公子分别逃往卫国、鲁国等地。齐国的陈乞想杀死国惠子和高昭子，从中挑拨他们与大夫们的关系，说不消灭他们就会后悔莫及，因此挑起了战争"]},{"id":11336,"word":"后悔何及","pinyin":"hòu huǐ hé jí","abbr":"hhhj","explanation":"指后悔已经来不及了。","source":{"text":"舍此不为，中道而退，便恐人皆解体，士各有心。一失事机，后悔何及。","book":"《周书·崔谦传》"},"example":{"text":"明·无名氏《杨家将演义》第二卷：“圣上以遗言为重，若不早图，～。”"},"similar":["后悔无及","后悔不及"],"usage":"作谓语；指后悔已经来不及了"},{"id":11337,"word":"后悔无及","pinyin":"hòu huǐ wú jí","abbr":"hhwj","explanation":"后悔已经来不及了。","source":{"text":"既成谋矣，何及其未作也，先诸？作而后悔，亦无及也。","book":"《左传·哀公六年》"},"example":{"text":"挨了半日，只听他说了一句“～”，早已气断身亡。","book":"清·李汝珍《镜花缘》第九十七回"},"similar":["后悔莫及","后悔不及","后悔何及"],"usage":"作谓语；指后悔已经来不及了","story":["春秋时期，吴王夫差准备攻打齐国，越王勾践带人为夫差助威，伍子胥对夫差说越国才是心腹之患，应该除掉，等越国强大了，想消灭就后悔莫及了。夫差不听劝告，反而疏远伍子胥并命他自杀。11年后，强大了的越国一举消灭吴国"]},{"id":11338,"word":"后悔莫及","pinyin":"hòu huǐ mò jí","abbr":"hhmj","explanation":"后悔：事后的懊悔。指事后的懊悔也来不及了。","source":{"text":"反水不收，后悔不及。","book":"南朝·宋·范晔《后汉书·光武帝纪上》"},"example":{"text":"做事要小心，万一出了什么意外就～了。"},"similar":["追悔莫及","悔之无及"],"usage":"作谓语、定语；形容悔恨或劝诫人","story":["春秋时期，齐景公病重，让国惠子、高昭子帮助公子荼当上国君。齐景公死，其他公子分别逃往卫国、鲁国等地。齐国的陈乞想杀死国惠子和高昭子，从中挑拨他们与大夫们的关系，说不消灭他们就会后悔莫及，因此挑起了战争"]},{"id":11339,"word":"后患无穷","pinyin":"hòu huàn wú qióng","abbr":"hhwq","explanation":"以后的祸害没有个完。","source":{"text":"夫刘备，人杰也。今不击，必有后患。","book":"《三国志·魏志·武帝纪》"},"example":{"text":"纵容破坏植被、滥砍乱伐，是～的事。"},"similar":["放虎归山","祸不单行"],"opposite":["斩草除根","后福无量"],"usage":"作谓语、宾语、定语、分句；指今后的祸害","story":["汉献帝建安元年，徐州牧刘备受到袁术的攻击就只身投靠曹操。曹操表面上重用刘备，让刘备招兵买马到徐州去攻打袁绍。谋士郭嘉听说放走了刘备，肯定会后患无穷。曹操立即意识到这一点，就带兵攻打徐州，刘备赶紧投靠了袁绍"]},{"id":11340,"word":"后手不上","pinyin":"hòu shǒu bù shàng","abbr":"hsbs","explanation":"指平时不注意留有余地，日后接应不上，无法继续维持。","source":{"text":"日复一日，须有尽时，日后后手不上了，悔之无及矣。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"}},{"id":11341,"word":"后手不接","pinyin":"hòu shǒu bù jiē","abbr":"hsbj","explanation":"指平时不注意留有余地，日后接应不上，无法继续维持。","source":{"text":"日复一日，须有尽时，日后后手不上了，悔之无及矣。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"example":{"text":"我虽不管事，心里每常闲了，替他们一算，出的多，进的少。如今若不省俭，必致～。","book":"清·曹雪芹《红楼梦》第六十二回"},"usage":"作谓语、宾语；指接济不上"},{"id":11342,"word":"后拥前呼","pinyin":"hòu yōng qián hū","abbr":"hyqh","explanation":"后面簇拥，前面吆喝。形容出行时气派很大。","source":{"text":"怎如你喜都都，后拥前呼。","book":"元·张国宾《薛仁贵》第一折"},"example":{"text":"只见～，众官员下马，在前厅换衣服良久。","book":"《金瓶梅词话》第六四回"},"similar":["前呼后拥","后拥前驱"],"usage":"作谓语、宾语、状语；用于权贵等"},{"id":11343,"word":"后拥前遮","pinyin":"hòu yōng qián zhē","abbr":"hyqz","explanation":"遮：阻拦。形容十分拥挤、喧闹的样子。","source":{"text":"果是英雄，凭着自己本领，怕甚王孙公子，又怕甚后拥前遮。","book":"清·褚人获《隋唐演义》第18回"},"similar":["前遮后拥"],"usage":"作宾语、定语、状语；指十分拥挤"},{"id":11344,"word":"后拥前驱","pinyin":"hòu yōng qián qū","abbr":"hyqq","explanation":"拥：保护。前面有人吆喝开路，后面有人围着。形容权贵们的气势。","source":{"text":"后拥前驱，教一时光彩生门户。","book":"明·汤显祖《紫钗记·回求仆马》"},"similar":["后拥前呼"],"usage":"作谓语、宾语、状语；用于权贵等"},{"id":11345,"word":"后来之秀","pinyin":"hòu lái zhī xiù","abbr":"hlzx","explanation":"秀：特别优秀的。后辈中的优秀人物。","source":{"text":"范豫章谓王荆州：‘卿风流俊望，真后来之秀。’王曰：‘不有此舅，焉有甥？’","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"当日仆试江宁之张童子也，有子胜斐然之志，近更砥砺于学，藻思芊绵，不愧～。","book":"清·袁枚《小仓山房尺牍》第二十八首"},"similar":["后起之秀"],"usage":"作宾语；指年轻人","story":["东晋时期，年轻官员王忱去拜访他的学者舅舅范宁，刚好张玄也在范家，张玄摆出一副老前辈的架势，想叫王忱给他施礼，王忱没有理他。范宁责怪王忱，王忱认为老前辈应该谦逊。范宁认为王忱年轻有见识，真可谓后来之秀"]},{"id":11346,"word":"后来佳器","pinyin":"hòu lái jiā qì","abbr":"hljq","explanation":"佳：好。将来大有作为的人才。指人很有发展前途。","source":{"text":"诣司徒袁粲，粲谓人曰：‘后来佳器也。’","book":"《南齐书·豫章文献王嶷传》"}},{"id":11347,"word":"后来居上","pinyin":"hòu lái jū shàng","abbr":"hljs","explanation":"后来的超过先前的。有以称赞后起之秀超过前辈。","source":{"text":"陛下用群臣，如积薪耳，后来者居上。","book":"《史记·汲郑列传》"},"example":{"text":"今老矣，乐不预少年文酒之会，～，又不知其为谁？","book":"清·纪昀《阅微草堂笔记》卷二十四"},"similar":["青出于蓝"],"opposite":["一代不如一代"],"usage":"作谓语、定语；指后者胜前者","story":["汉武帝时文官汲黯生性坦率，总是直言劝谏皇帝，汉武帝派他去边远的地方做官，他在东海郡政绩显著，汉武帝将他调回宫中。他本性不改，汉武帝重新冷落他。他感慨道：“皇帝用人就像堆柴，真是后来者居上。”"]},{"id":11348,"word":"后来者居上","pinyin":"hòu lái zhě jū shàng","abbr":"hlzjs","explanation":"后来的超过先前的。","source":{"text":"陛下用群臣，如积薪耳，后来者居上。","book":"《史记·汲郑列传》"},"similar":["后来居上"],"usage":"作谓语、定语；指后者胜前者","story":["西汉时期，文官汲黯生性坦率，总是直言劝谏皇帝，汉武帝派他去边远的地方做官，他在东海郡政绩显著，汉武帝将他调回宫中。他本性不改，汉武帝重新冷落他。他感慨道：“皇帝用人就像堆柴，真是后来者居上。”"]},{"id":11349,"word":"后果前因","pinyin":"hòu guǒ qián yīn","abbr":"hgqy","explanation":"起因和结果。泛指事情的整个过程。","source":{"text":"儒家之教，宪章祖述，引古证今，于学易悟。今树以前因，报以后果，业行交酬，连锁相袭。","book":"《南齐书·高逸传》"}},{"id":11350,"word":"后浪催前浪","pinyin":"hòu làng cuī qián làng","abbr":"hlcql","explanation":"比喻新生的事物推动或替换陈旧的事物，不断前进。","source":{"text":"只看后浪催前浪，当悟新人换旧人。","book":"宋·文珦《过苕溪》诗"},"example":{"text":"仅教他～，楚臣放心，休想我新人换旧人。","book":"明·贾仲名《对玉梳》第一折"},"similar":["后浪推前浪"],"usage":"作宾语；指新生事物"},{"id":11351,"word":"后浪推前浪","pinyin":"hòu làng tuī qián làng","abbr":"hltql","explanation":"江水奔流，前后相继。比喻后面的事物推动前面的事物，象后浪推动前浪一样，不断前进。","source":{"text":"祗看后浪催前浪，当悟新人换旧人。","book":"宋·文珦《过苕溪》诗"},"example":{"text":"俺哥哥称孤道寡世无双，我关某疋马单刀镇荆襄，长江，今经几战场，却正是～。","book":"元·关汉卿《单刀会》第二折"},"similar":["后浪催前浪"],"usage":"作宾语；指新生事物"},{"id":11352,"word":"后海先河","pinyin":"hòu hǎi xiān hé","abbr":"hhxh","explanation":"比喻做事要先本后末。","source":{"text":"三王之祭川也，皆先河而后海。","book":"语出《礼记·学记》"},"example":{"text":"及乎年齿渐大，闻见益增，始知～，为山覆篑，而炳烛之光，桑榆之效，亦已晚矣。","book":"清·顾炎武《与陆桴亭札》"},"usage":"作宾语、定语；用于处事"},{"id":11353,"word":"后生可畏","pinyin":"hòu shēng kě wèi","abbr":"hskw","explanation":"后生：年轻人，后辈；畏：敬畏。年轻人是可敬畏的。形容青年人能超过前辈。","source":{"text":"后生可畏，焉知来者之不如今也。","book":"《论语·子罕》"},"example":{"text":"～，非虚言也。","book":"宋·朱熹《寄陈同甫书》十二"},"similar":["少年老成"],"opposite":["少不更事","乳臭未干"],"usage":"作谓语、宾语、分句；称赞年轻人","story":["春秋时期，孔子周游列国时遇到几个小孩在游玩，他问其中一个不玩的小孩，小孩说疯玩会有伤害的。小孩筑城挡住了孔子的车，孔子问为什么不让车，小孩说从来都是车避让城堡没有城堡让车的，孔子听后叹息道：“真是后生可畏！”"]},{"id":11354,"word":"后生小子","pinyin":"hòu shēng xiǎo zǐ","abbr":"hsxz","explanation":"指年轻晚辈。","source":{"text":"恐数十年后老成凋丧，后生小子，不知根柢，耳濡目染，目变而复还。","book":"宋·俞文豹《吹剑四录》"},"example":{"text":"这位老先生，吃饱了晚饭，喜欢说几句仁义道德的话，劝劝我们～。","book":"洪深《少奶奶的扇子》"},"similar":["后生晚学"],"usage":"作宾语；指年轻晚辈"},{"id":11355,"word":"后生晚学","pinyin":"hòu shēng wǎn xué","abbr":"hswx","explanation":"指年纪轻、资历浅的人。也用作在前辈面前的自谦之词。","source":{"text":"仙里年来向学者甚众，风习可尚，正赖长者不惮告教，使后生晚学得知前辈风采，谦冲就实，无徒长虚诞。","book":"宋·陆九渊《与傅全美书》"},"example":{"text":"以智永、怀素前为之倡，名盖辈流，耸动当世，则～瞠若光尘者，不啻羶蚁之慕。","book":"宋·赵佶《宣和书谱·释梦龟》"},"similar":["后生晚辈"],"usage":"作宾语、定语；用于自谦"},{"id":11356,"word":"后福无量","pinyin":"hòu fú wú liàng","abbr":"hfwl","explanation":"量：限度，限量。将来的幸福无穷。","source":{"text":"白璧不可为，容容多后福。","book":"《后汉书·左雄传》"},"usage":"作谓语、定语；用于祝福等"},{"id":11357,"word":"后继乏人","pinyin":"hòu jì fá rén","abbr":"hjfr","explanation":"继：继承；乏：缺少。没有后人来继承前人的事业。","example":{"text":"任何一个学科都不可～。"}},{"id":11358,"word":"后继无人","pinyin":"hòu jì wú rén","abbr":"hjwr","explanation":"继：继承。没有后人来继承前人的事业。","source":{"text":"这位老中医的医术没有得到应有的重视，而且后继无人。","book":"罗瑞卿《党的三大作风的楷模——回忆周总理》"},"example":{"text":"这项伟大的事业怎么会～呢？"},"similar":["后继乏人"],"opposite":["后继有人"],"usage":"作谓语、定语；形容事业缺少接班人"},{"id":11359,"word":"后继有人","pinyin":"hòu jì yǒu rén","abbr":"hjyr","explanation":"继：继承。有后人继承前人的事业。","source":{"text":"这是后继有人，令人喜悦不止。","book":"艾芜《鞍钢呵，我回来了》"},"example":{"text":"革命事业，～。"},"similar":["青出于蓝"],"opposite":["后继无人","后继乏人"],"usage":"作谓语、宾语、定语；形容事业有接班人"},{"id":11360,"word":"后者处上","pinyin":"hòu zhě chǔ shàng","abbr":"hzcs","explanation":"原指堆积柴火，后搬来的反而在上面。后指资历浅的人反而位居资格老的人之上。也泛指后来的人超过前辈。","source":{"text":"故圣人虚无因循，常后而不先，譬如积薪燎，后者处上。","book":"《淮南子·缪称训》：“故圣人不为物先，而常制之其类，若积薪樵，后者在上。”《文子·上德》"}},{"id":11361,"word":"后起之秀","pinyin":"hòu qǐ zhī xiù","abbr":"hqzx","explanation":"后来出现的或新成长起来的优秀人物。","source":{"text":"卿风流俊望，真后来之秀。","book":"《晋书·王忱传》"},"example":{"text":"及浪游南北，与乡里阔疏，～，不乏其人。","book":"清·盛大士《溪山卧游录》卷三"},"similar":["青出于蓝","后来居上"],"usage":"作主语、宾语；形容出类拔萃的人物","story":["东晋时期，年轻官员王忱去拜访他的学者舅舅范宁，刚好张玄也在范家，张玄摆出一副老前辈的架势，想叫王忱给他施礼，王忱没有理他。范宁责怪王忱，王忱认为老前辈应该谦逊。范宁认为王忱年轻有见识，真可谓后来之秀"]},{"id":11362,"word":"后车之戒","pinyin":"hòu chē zhī jiè","abbr":"hczj","explanation":"对后面跟上来的车子的警戒。比喻以前的失败或挫折，可以作为以后做事情的借鉴或教训。","source":{"text":"秦王道：‘孤当初不听先生们之谏，致有此难，将来后车之戒，孤当谨重。’","book":"清·褚人获《隋唐演义》第52回"},"example":{"text":"这事可做为～。"},"similar":["前车之戒"],"usage":"作宾语；指对后面车子的警戒"},{"id":11363,"word":"后进之秀","pinyin":"hòu jìn zhī xiù","abbr":"hjzx","explanation":"犹言后起之秀。后来出现的或新成长起来的优秀人物。","source":{"text":"畅少与从兄敷、演、敬齐名，为后进之秀。","book":"《宋书·张畅传》"},"example":{"text":"遵义曹兴蕲，宪政会～也。","book":"周素园《贵州民党痛史》第四篇第三章"},"similar":["后起之秀","后来之秀"],"usage":"作主语、宾语；形容出类拔萃的人物"},{"id":11364,"word":"后进领袖","pinyin":"hòu jìn lǐng xiù","abbr":"hjlx","explanation":"晚辈中最杰出的人。","source":{"text":"时人为之语曰：‘后进领袖裴秀。’","book":"《晋书·裴秀传》"},"example":{"text":"绘为～，机悟多能。","book":"《南齐书·刘绘传》"},"similar":["后起之秀","后来之秀"],"usage":"作主语、宾语；用于书面语"},{"id":11365,"word":"后院起火","pinyin":"hòu yuàn qǐ huǒ","abbr":"hyqh","explanation":"比喻内部闹矛盾，发生纠纷。","example":{"text":"这年头～就更糟了。"},"usage":"作谓语、主语、宾语；指家庭矛盾"},{"id":11366,"word":"后顾之忧","pinyin":"hòu gù zhī yōu","abbr":"hgzy","explanation":"顾：回头看。来自后方的忧患。指在前进过程中，担心后方发生问题。","source":{"text":"朕以仁明忠雅，委以台司之寄，使我出境无后顾之忧。","book":"《魏书·李冲传》"},"example":{"text":"将军为殿，寡人～矣。","book":"明·冯梦龙《东周列国志》第六十二回"},"similar":["后顾之虞","后顾之患","后顾之虑"],"opposite":["无忧无虑"],"usage":"作宾语；指后方的忧患","story":["北魏有名宰相李冲办事认真公正，深得孝文帝的信赖。孝文帝每次出征，他都将朝中的事打点得井然有序。李冲病故后，孝文帝痛惜不已，在他的墓前说道：“我如出征，朝事交给你就无后顾之忧了。”"]},{"id":11367,"word":"后顾之患","pinyin":"hòu gù zhī huàn","abbr":"hgzh","explanation":"顾：回视；后顾：回过头照顾。指来自后方或家里的忧患。","source":{"text":"卢文纪劝帝驻河桥，庚赞华为契丹主，以兵援送入蕃，则契丹主有后顾之患，不能久驻汉地矣。","book":"《旧五代史·唐书·末帝纪》"},"similar":["后顾之忧","后顾之虑","后顾之虞"],"usage":"作宾语；指后方的忧患"},{"id":11368,"word":"后顾之虑","pinyin":"hòu gù zhī lǜ","abbr":"hgzl","explanation":"顾：回视；后顾：回过头照顾。指来自后方或家里的忧患。","source":{"text":"贼无后顾之虑，长驱而来。","book":"宋·刘弈《上韩范二招讨书》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“他此去没有～，专心一致对付公事，当然无往不利。”"},"similar":["后顾之忧","后顾之患","后顾之虞"],"usage":"作宾语；指后方的忧患"},{"id":11369,"word":"后顾之虞","pinyin":"hòu gù zhī yú","abbr":"hgzy","explanation":"顾：回视；后顾：回过头照顾；虞：臆度，料想。指来自后方或家里的忧患。","source":{"text":"大营距府城未远，势相犄角，无后顾之虞。","book":"《清史稿·常青传》"},"similar":["后顾之忧","后顾之患","后顾之虑"],"usage":"作宾语；指后方的忧患"},{"id":11370,"word":"吐丝自缚","pinyin":"tǔ sī zì fù","abbr":"tszf","explanation":"比喻自己的所作所为阻碍了自己的行动自由。","source":{"text":"闻声执法坐禅，如蚕吐丝自缚。","book":"宋·释道原《景德传灯录》"},"similar":["作茧自缚"],"usage":"作谓语、定语；指作茧自缚"},{"id":11371,"word":"吐凤之才","pinyin":"tǔ fèng zhī cái","abbr":"tfzc","explanation":"形容写作技巧极高。也比喻精于写作的人。","source":{"text":"雄著《太玄经》，梦吐凤凰，集‘玄’之上，顷而灭。","book":"晋·葛洪《西京杂记》卷二"},"example":{"text":"爰及我朝，挺生贤俊，文皇帝解戎衣而开学校，饰贲帛而礼儒生；门罗～，人擅握蛇之价。","book":"《旧唐书·文苑上》"}},{"id":11372,"word":"吐凤喷珠","pinyin":"tǔ fèng pēn zhū","abbr":"tfpz","explanation":"形容诗文的华丽。","source":{"text":"雄著《太玄经》，梦吐凤凰，集‘玄’之上，顷而灭。","book":"晋·葛洪《西京杂记》卷二"},"example":{"text":"众仙老之诗，真个是～，游夏莫赞。厚爱高情，感之极矣。","book":"明·吴承恩《西游记》第六十四回"}},{"id":11373,"word":"吐刚茹柔","pinyin":"tǔ gāng rú róu","abbr":"tgrr","explanation":"柔：软；刚：硬。吐出硬的，吃下软的。比喻怕强欺软。","source":{"text":"人亦有言，柔则茹之，刚则吐之。","book":"《诗经·大雅·烝民》"},"example":{"text":"毛玠清公素履，司马芝忠亮不倾，庶乎不～。","book":"《三国志·魏志·崔琰等传赞》"},"similar":["欺软怕硬","欺弱怕强"],"opposite":["锄强扶弱","劫富济贫"],"usage":"作谓语、定语；指怕强欺弱"},{"id":11374,"word":"吐哺捉发","pinyin":"tǔ bǔ zhuō fā","abbr":"tbzf","explanation":"比喻为了招揽人才而操心忙碌。同“吐哺握发”。","source":{"text":"今虽不能如周公吐哺捉发，亦宜引而进之，察其所以而去就之，不宜默默而已也。","book":"唐·韩愈《后廿九日复上书》"},"similar":["吐哺握发"],"usage":"作谓语、定语；指爱惜人才"},{"id":11375,"word":"吐哺握发","pinyin":"tǔ bǔ wò fà","abbr":"tbwf","explanation":"哺：口吕咀嚼着的食物。吃饭时多次吐出口中的食物，洗头时多次把头发握在手中。比喻为了招揽人才而操心忙碌。","source":{"text":"我一沐三捉发，一饭三吐哺，起以待士，犹恐失天下之贤人。","book":"《史记·鲁周公世家》"},"example":{"text":"周公在周盛时，天下太平，四夷宾服，犹且～，以纳天下贤士。","book":"明·冯梦龙《东周列国志》第十八回"},"similar":["礼贤下士","吐哺捉发"],"usage":"作谓语、定语；指爱惜人才","story":["西周时期，周成王继承父亲的遗志，分封诸侯，他封伯禽为鲁侯，周公向兄弟伯禽祝贺，说：“你以前是鲁国的有名能士，你到任后不要忘记你是周文王的儿子，周武王的弟弟，现今成王的叔叔。你要一沐三握发，一饭三吐哺，爱惜人才。”"]},{"id":11376,"word":"吐哺辍洗","pinyin":"tǔ bǔ chuò xǐ","abbr":"tbcx","explanation":"后世以之为礼贤下士之典实。","source":{"text":"据《韩诗外传》卷三载，周公殷勤待客，甚至于“一饭三吐哺”，唯恐失天下之士。又据《史记·高祖本纪》载，郦食其求见刘邦，刘邦方踞床洗足。郦生不拜，且斥其不宜踞见长者，于是刘邦起而谢之，延上坐。"},"similar":["吐哺握发"],"usage":"作谓语、宾语；用于书面语","story":["秦朝末年，刘邦驻守陈留县，才学过人的郦食其去投奔刘邦，刘邦正在洗脚，郦食其不拜并指责不尊重长者。刘邦一听赶忙起立道歉，请郦食其上坐。后来郦食其成为刘邦的得力谋士，为刘邦一统天下而出谋划策"]},{"id":11377,"word":"吐属不凡","pinyin":"tǔ shǔ bù fán","abbr":"tsbf","explanation":"吐属：谈吐，措辞。指言谈话语或诗文的遣辞用意不同凡响。","source":{"text":"瑀之吐属，心不如此。","book":"《三国志·魏志·阮瑀传》裴松之注引《典略》"},"example":{"text":"那太傅正在请不着先生，又见他虽是寒素，～，心下早有几分愿意。","book":"清·文康《儿女英雄传》第十八回"},"similar":["谈吐不凡"],"usage":"作谓语、定语；用于书面语"},{"id":11378,"word":"吐属大方","pinyin":"tǔ zhǔ dà fāng","abbr":"tsdf","explanation":"吐属：谈吐，措辞。指言谈话语或诗文的遣辞用意得体自然。","source":{"text":"瑀之吐属，心不如此。","book":"《三国志·魏志·阮瑀传》裴松之注引《典略》"}},{"id":11379,"word":"吐心吐胆","pinyin":"tǔ xīn tǔ dǎn","abbr":"txtd","explanation":"比喻赤诚相待，说出心里话。同“吐肝露胆”。","source":{"text":"日用之间，应事接物，直是判断得直截分明，而推以及人，吐心吐胆，亦只如此，更无回互。","book":"宋·朱熹《答刘季章书》"},"similar":["吐肝露胆","倾心吐胆"],"usage":"作定语、状语；用于比喻句"},{"id":11380,"word":"吐故纳新","pinyin":"tǔ gù nà xīn","abbr":"tgnx","explanation":"原指人呼吸时，吐出浊气，吸进新鲜空气。现多用来比喻扬弃旧的、不好的，吸收新的，好的。","source":{"text":"吹呴呼吸，吐故纳新。","book":"《庄子·刻意》"},"example":{"text":"最人涅伏，～，败果既落，新葩欲吐。","book":"鲁迅《集外集·说鈤》"},"similar":["推陈出新","新陈代谢"],"opposite":["招降纳叛"],"usage":"作谓语、定语、分句；指不断更新"},{"id":11381,"word":"吐气扬眉","pinyin":"tǔ qì yáng méi","abbr":"tqym","explanation":"形容受压抑的心情得以舒展而感到快意。","source":{"text":"吐气扬眉，青云激励，却怜小友尚穷乏。","book":"明·孙仁孺《东郭记·与之大夫》"},"example":{"text":"现在是我们～的时候了。"},"similar":["扬眉吐气"],"usage":"作谓语、定语；指人的心情"},{"id":11382,"word":"吐珠于泽，谁能不含","pinyin":"tǔ zhū yú zé，shuí néng bù hán","abbr":"tzyzsnbh","explanation":"含：衔在嘴里。明珠出于水泽，则人人都会取来衔在嘴里。比喻君权旁落，则人人都要谋夺。","source":{"text":"故孔子曰：‘吐珠于泽，谁能不含。’谕君之权柄外假，则毕竟取以为己利，犹出于泽中，谁能不含。","book":"南朝·宋·范晔《后汉书·翟峬传》"},"usage":"作宾语、定语；用于书面语"},{"id":11383,"word":"吐肝露胆","pinyin":"tǔ gān lù dǎn","abbr":"tgld","explanation":"比喻赤诚相待，说出心里话。","source":{"text":"我既真切向道，彼决无有厌恶之理……决无不吐肝露胆与我共证明之意。","book":"明·李贽《复京中友朋》"},"similar":["倾心吐胆"],"usage":"作定语、状语；用于比喻句"},{"id":11384,"word":"吐胆倾心","pinyin":"tǔ dǎn qīng xīn","abbr":"tdqx","explanation":"倾：倒出。将埋藏在心底里的话全部讲出来。比喻痛快地说出了心里话。","source":{"text":"幽幽千端郎不听，倾心吐胆犹不止。","book":"宋·刘斧《青琐高议·别集·越娘记》"},"example":{"text":"街坊也却不道您～说真实。（元·李行道《灰阑记》第四折）"},"similar":["吐肝露胆","赤诚相见"],"usage":"作谓语、状语；指赤诚相见"},{"id":11385,"word":"吐露心腹","pinyin":"tǔ lù xīn fù","abbr":"tlxf","explanation":"指说出心里的话。","source":{"text":"司户初时逊谢不敢，被司理言之再三，说到相知的分际，司户隐瞒不得，只得吐露心腹。","book":"明·冯梦龙《喻世明言》卷十七"},"example":{"text":"慕君之才，本欲与君～，幸勿相逼。","book":"明·冯梦龙《醒世恒言》卷三十二"}},{"id":11386,"word":"吐食握发","pinyin":"tǔ shí wò fā","abbr":"tswf","explanation":"比喻为了招揽人才而操心忙碌。同“吐哺握发”。","source":{"text":"虽笔不集札，菽麦不辨，为之倒屣，吐食握发。","book":"晋·葛洪《抱朴子·交际》"},"similar":["吐哺握发","吐哺捉发"],"usage":"作谓语、定语；指爱惜人才"},{"id":11387,"word":"向上一路","pinyin":"xiàng shàng yī lù","abbr":"xsyl","explanation":"佛教禅宗指不可思议的彻悟境界。","source":{"text":"向上一路，千圣不传。学者劳形，如猿捉影。","book":"《碧岩录》第二卷"},"example":{"text":"清·王夫之《夕堂永日绪论外编》：“要之，更有～在。”"},"usage":"作宾语、定语；用于书面语"},{"id":11388,"word":"向壁虚构","pinyin":"xiàng bì xū gòu","abbr":"xbxg","explanation":"向壁：对着墙壁。即对着墙壁，凭空造出来的。比喻不根据事实而凭空捏造。","source":{"text":"世人大共非訾，以为好奇者也，故诡更正文，乡壁虚造不可知之书，变乱常行，以耀于世。","book":"汉·许慎《说文解字·序》"},"example":{"text":"乡壁虚造，顺非而泽，持之似有故，言之若成理。","book":"严复《救亡决论》"},"similar":["向壁虚造","面壁虚构"],"usage":"作谓语、宾语、定语；指凭空想象和杜撰"},{"id":11389,"word":"向壁虚造","pinyin":"xiàng bì xū zào","abbr":"xbxz","explanation":"向壁：对着墙壁；虚造：虚构。。即对着墙壁，凭空造出来的。比喻无事实根据，凭空捏造。","source":{"text":"乡壁虚造不可知之书，变乱常行，以耀于世。","book":"汉·许慎《说文解字·序》"},"example":{"text":"～，顺非而泽，持之似有故，言之若成理。","book":"严复《救亡决论》"},"similar":["无中生有"],"usage":"作谓语、宾语、定语；指凭空想象和杜撰"},{"id":11390,"word":"向声背实","pinyin":"xiàng shēng bèi shí","abbr":"xsbs","explanation":"声：声名，这里指虚名；背：违背。指向往声名，背离实际。","source":{"text":"常人贵远贱亲，向声背实；又患暗于自见，谓己为贤。","book":"三国·魏·曹丕《典论·论文》"},"example":{"text":"此并～，舍真从伪。","book":"唐·刘知己《史通·杂说中》"},"usage":"作谓语、定语；用于处事等"},{"id":11391,"word":"向天而唾","pinyin":"xiàng tiān ér tuò","abbr":"xtet","explanation":"仰头向着天吐唾沫，唾沫还是落在自己的脸上。比喻本来想损害别人，结果受害的还是自己。","example":{"text":"～的行为极为不雅"},"similar":["仰面唾天"],"usage":"作谓语、定语；用于比喻句"},{"id":11392,"word":"向平之原","pinyin":"xiàng píng zhī yuán","abbr":"xpzy","explanation":"称子女婚嫁事为“向平之愿”，子女婚嫁事毕为“向平愿了”。"},{"id":11393,"word":"向平之愿","pinyin":"xiàng píng zhī yuàn","abbr":"xpzy","explanation":"向平：即东汉时向长，字子平。向平的心愿。指子女婚嫁之事。","source":{"text":"这般一走，便可与杜郎相会，遂了向平之愿了。","book":"明·凌濛初《初刻拍案惊奇》第36卷"},"example":{"text":"如今儿子已经长大，拟于秋间为之完姻，以了‘～’。","book":"清·李宝嘉《官场现形记》第56回"},"similar":["向平愿了"],"usage":"作宾语；指子女婚嫁之事","story":["东汉光武帝建武年间，隐士向长（字子平，河内朝歌人）一生有才学，就是不愿做官，他抚养几个儿女长大成人，并帮他们成家后，自己同家人告别，同友人北海禽庆遍游五岳名山，最后客死他乡，不知所终"]},{"id":11394,"word":"向平愿了","pinyin":"xiàng píng yuàn liǎo","abbr":"xpyl","explanation":"向平：即东汉时向长，字子平；了：了结。向平的心愿已了。指儿女都已婚嫁。","source":{"text":"建武中，男女嫁既毕，敕断家事勿相关，当如我死也。于是遂肆意与同好北海禽庆俱游五岳名山，竟不知所终。","book":"《后汉书·向长传》"},"usage":"作谓语、定语；用于书面语","story":["东汉光武帝建武年间，隐士向长（字子平，河内朝歌人）一生有才学，就是不愿做官，他抚养几个儿女长大成人，并帮他们成家后，自己同家人告别，同友人北海禽庆遍游五岳名山，最后客死他乡，不知所终"]},{"id":11395,"word":"向明而治","pinyin":"xiàng míng ér zhì","abbr":"xmez","explanation":"向明：天将要亮了；治：治理。形容勤于政事。","source":{"text":"圣人南面而听天下，向明而治。","book":"《周易·说卦》"},"example":{"text":"且人君恭己南面，～，紫微黄屋，至尊至重。","book":"清·毕沅《续资治通鉴》卷十六"},"usage":"作谓语、定语；用于官吏等"},{"id":11396,"word":"向火乞儿","pinyin":"xiàng huǒ qǐ ér","abbr":"xhqe","explanation":"向火：烤火；乞儿：乞丐。近火取暖的乞丐。比喻趋炎附势的人。","source":{"text":"今时之朝彦皆是向火乞儿，一旦火尽灰冷，暖气何在？","book":"五代·王仁裕《开元天宝遗事·向火乞儿》"},"example":{"text":"纷纷～多，独有君如择乳鹅。","book":"宋·显万《送炭与湘山西堂惠然师》"},"usage":"作宾语、定语；指趋炎附势的人"},{"id":11397,"word":"向炎乞儿","pinyin":"xiàng yán qǐ ér","abbr":"xyqe","explanation":"近火取暖的乞丐。比喻趋炎附势之徒。","example":{"text":"他的这种行为让我想起了～。"},"usage":"作宾语、定语；用于处事"},{"id":11398,"word":"向若而叹","pinyin":"xiàng ruò ér tàn","abbr":"xret","explanation":"比喻向高明者折服，而自叹不如。","source":{"text":"至于北海，东面而视，不见水端，于是焉河伯始旋其面目，望洋向若而叹曰：‘……今我睹子之难穷也，吾非至于子之门则殆矣。’","book":"战国·宋·庄周《庄子·秋水》"},"example":{"text":"未有不望崖而返、～者也。","book":"清·钱谦益《汲古阁毛氏新刻十七史序》"},"similar":["自叹不如"],"usage":"作谓语；指自叹不如"},{"id":11399,"word":"向阳花木","pinyin":"xiàng yáng huā mù","abbr":"xyhm","explanation":"向阳的花木光照条件比较好，春天早早发育。比喻因占有方便的条件而获得利益或照顾。","source":{"text":"近水楼台先得月，向阳花木易逢春。","book":"宋·苏麟《断句》"}},{"id":11400,"word":"向隅之感","pinyin":"xiàng yú zhī gǎn","abbr":"xyzg","explanation":"向：对着；隅：墙角。一个人面对墙脚哭泣的感觉。形容没有人理睬，非常孤立的情形。","source":{"text":"今有满堂饭酒者，有一人独索然向隅而泣，则一堂之人皆不乐矣。","book":"汉·刘向《说苑·贵德》"},"example":{"text":"若是座中只三五个人，这也可以是一个愉快的场面，虽然不免有人抱～。","book":"朱自清《撩天儿》"},"usage":"作宾语；用于处事"},{"id":11401,"word":"向隅之泣","pinyin":"xiàng yú zhī qì","abbr":"xyzq","explanation":"向：对着；隅：墙角；泣：小声地哭。一个人面对墙脚哭泣。形容没有人理睬，非常孤立。","source":{"text":"今有满堂饭酒者，有一人独索然向隅而泣，则一堂之人皆不乐矣。","book":"汉·刘向《说苑·贵德》"},"example":{"text":"不劳有力之呼，无复～。","book":"宋·陈亮《谢留丞相启》"},"similar":["向隅而泣"],"usage":"作宾语；用于处事"},{"id":11402,"word":"向隅独泣","pinyin":"xiàng yú dú qì","abbr":"xydq","explanation":"向：对着；隅：墙角；泣：小声地哭。一个人面对墙脚哭泣。形容没有人理睬，非常孤立，只能绝望地哭泣。","source":{"text":"今有满堂饭酒者，有一人独索然向隅而泣，则一堂之人皆不乐矣。","book":"汉·刘向《说苑·贵德》"},"example":{"text":"每逢时移节换，家远身孤，吊影自伤，～。","book":"唐·杜牧《上吏部高尚书书状》"},"similar":["向隅而泣"],"usage":"作谓语、定语；指绝望地哭"},{"id":11403,"word":"向隅而泣","pinyin":"xiàng yú ér qì","abbr":"xyeq","explanation":"向：对着；隅：墙角；泣：小声地哭。一个人面对墙脚哭泣。形容没有人理睬，非常孤立，只能绝望地哭泣。","source":{"text":"今有满堂饭酒者，有一人独索然向隅而泣，则一堂之人皆不乐矣。","book":"汉·刘向《说苑·贵德》"},"example":{"text":"一人～，满堂为之不乐，教授既尔，吾曹何心乐饮哉？（宋·洪迈《夷坚丁志·王从事妻》）"},"similar":["唉声叹气","穷途末路"],"opposite":["春风得意","得意忘形"],"usage":"作谓语、定语；指绝望地哭"},{"id":11404,"word":"向风慕义","pinyin":"xiàng fēng mù yì","abbr":"xfmy","explanation":"指向往其教化，仰慕其礼义。或指向往其风度，仰慕其义行。","source":{"text":"因而连合西僧，向风慕义，交臂请贡，献琛来王。","book":"明·张居正《番夷求贡疏》"},"example":{"text":"参加的有社友，也有～来的非社友，共有一百有九人之多。","book":"郑逸梅《南社丛谈·南社后期活动》"},"similar":["乡风慕义"],"usage":"作谓语；用于书面语"},{"id":11405,"word":"向风靡然","pinyin":"xiàng fēng mǐ rán","abbr":"xfmr","explanation":"向风：闻风仰慕；靡然：倒伏的样子。形容人倾心向往。","source":{"text":"黜黄老、刑名、延文学儒者以百数，而公孙弘以治《春秋》为丞相封侯，天下学士，靡然乡风。","book":"《汉书·儒林传》"},"example":{"text":"于是怀文之士，莫不～。","book":"唐·卢照邻《乐府杂诗序》"},"usage":"作谓语、定语；用于书面语"},{"id":11406,"word":"吓鬼瞒神","pinyin":"xià guǐ mán shén","abbr":"xgms","explanation":"形容欺上瞒下。","source":{"text":"岂不闻湛湛青天不可欺，据着你这所为，来这里唬鬼瞒神，做的个藏头露尾。","book":"元·孔文卿《东窗事犯》第二折"},"example":{"text":"欺君卖国无双士，～第一流。","book":"清·钱彩《说岳全传》第二十四回"}},{"id":11407,"word":"吕安题凤","pinyin":"lǚ ān tí fèng","abbr":"latf","explanation":"比喻造访不遇。","source":{"text":"嵇康与吕安善，每一相思，千里命驾。安后来，值康不在，喜出户延之，不入。题门上作‘凤’字而去。","book":"南朝·宋·刘义庆《世说新语·简傲》"},"example":{"text":"须知子猷访戴步翩跹，谁知～惜留连。","book":"明·许自昌《水浒记·渔色》"},"similar":["登门拜访"],"usage":"作宾语、定语；比喻造访不遇","story":["晋朝时期，竹林七贤之一嵇康与吕安是很好的朋友。有一次吕安去拜访嵇康，刚好嵇康外出，他的哥哥嵇喜邀请他进屋休息等候，吕安不想进去，就在门上写了个“凤”字而去，借以讥讽嵇喜平庸"]},{"id":11408,"word":"吕武操莽","pinyin":"lǚ wǔ cāo mǎng","abbr":"lwcm","explanation":"吕雉、武则天、曹操、王莽的合称。旧时都被认为是以阴谋手段篡夺君位的野心家。因以之指窃取政权的国贼。","source":{"text":"即不爱皇，即不爱国，亦当爱身家，其忍听吕武操莽为我写卖奴契也？","book":"梁启超《复金山中华会馆书》"},"usage":"作主语、宾语、定语；指窃国者"},{"id":11409,"word":"吕端大事不糊涂","pinyin":"lǚ duān dà shì bù hú tú","abbr":"lddsbht","explanation":"喻指办事坚持原则。亦指在大是大非面前保持清醒的头脑。","source":{"text":"太宗欲相端。或曰：‘端为人糊涂。’太宗曰：‘端小事糊涂，大事不糊涂。’决意相之。","book":"《宋史·吕端传》"},"example":{"text":"诸葛一生唯谨慎，～。","book":"南怀瑾《论语别裁》"}},{"id":11410,"word":"君仁臣直","pinyin":"jūn rén chén zhí","abbr":"jrcz","explanation":"仁：仁义；直：正直。君主仁爱，臣下才能直言相谏。","source":{"text":"臣闻其君仁者其臣直，向者，翟黄之言直，臣是以知君仁君也。","book":"充·刘向《新序·杂事》"}},{"id":11411,"word":"君侧之恶","pinyin":"jūn cè zhī è","abbr":"jcze","explanation":"恶：佞臣，小人。君子身边的佞臣。","source":{"text":"晋赵鞅取晋阳之甲，以逐荀演与士吉射。荀演与士吉射者曷为者也？君侧之恶人也。","book":"《公羊传·定公十三年》"},"example":{"text":"诛～臣，清国朝之秕政，然后还守藩翰，以保臣节，实臣之至愿也。","book":"蔡东藩《南北史演义》第六十回"}},{"id":11412,"word":"君命无二","pinyin":"jūn mìng wú èr","abbr":"jmwe","explanation":"指君主的命令不可更改。形容君命有绝对的权威性。","source":{"text":"君命无二，古之制也。","book":"《左传·僖公二十四年》"},"usage":"作宾语、定语；用于书面语"},{"id":11413,"word":"君唱臣和","pinyin":"jūn chàng chén hè","abbr":"jcch","explanation":"唱：歌唱，吟咏；和：应和。形容臣子紧紧遵循君主的旨意办事。","source":{"text":"君唱臣和，教之隆也。","book":"《晏子外编》"},"example":{"text":"～，君先臣随。","book":"东汉·班固《汉书·司马迁传》"},"usage":"作宾语、定语、分句；用于政治等"},{"id":11414,"word":"君圣臣贤","pinyin":"jūn shèng chén xián","abbr":"jscx","explanation":"君主圣明，臣子贤良。形容君臣契合，政治清明。","source":{"text":"当今乃尧舜之世，君圣臣贤。","book":"《旧唐书·马燧传》：“道无不行，谋无不臧，君圣臣贤，运泰时康。”明·罗贯中《三遂平妖传》第十九回"},"example":{"text":"～国运昌，不须迁务长生方。","book":"好古主人《赵太祖三下南唐》第五十一回"}},{"id":11415,"word":"君子一言，快马一鞭","pinyin":"jūn zǐ yī yán，kuài mǎ yī biān","abbr":"jzyykmyb","explanation":"比喻一言为定，决不翻诲。","source":{"text":"快马一鞭，快人一言。有事何不出头来，无事各自珍重。","book":"宋·释道原《景德传灯录》卷六"},"example":{"text":"～，人而无信，不知其可也。","book":"明·兰陵笑笑生《金瓶梅词话》第五十三回"},"similar":["一言既出，驷马难追","言而有信"],"opposite":["言而无信"],"usage":"作状语、分句；指人说话算数"},{"id":11416,"word":"君子三戒","pinyin":"jūn zǐ sān jiè","abbr":"jzsj","explanation":"戒：戒规。君子有三条戒规：少年时戒美色；壮年时戒殴斗；老年时戒贪图。","source":{"text":"君子有三戒：少之时，血气未定，戒之在色；及其壮也，血气方刚，戒这在斗；及其老也，血气既衰，戒之在得。","book":"《论语·季氏》"}},{"id":11417,"word":"君子不器","pinyin":"jūn zǐ bù qì","abbr":"jzbq","explanation":"君子不象器具那样，作用仅仅限于某一方面。用于赞美别人多才多艺。","source":{"text":"子曰：‘君子不器。’","book":"《论语·为政》"},"example":{"text":"清·韩邦庆《海上花列传》第45回：“最容易是‘平上入去’：‘时使薄敛’、‘～’、‘而后国治’……”"},"usage":"作宾语、定语；用于书面语","story":["春秋时期，孔子的弟子子贡原是卫国的商人，姓端木名赐，他因为有钱，经常穿华丽的服饰，孔子看不惯他的新潮，说他为君子不器。他沾沾自喜，他问孔子自己是什么器，孔子随意说是瑚琏之器。子贡更加飘飘然，不知孔子在说他内心空虚"]},{"id":11418,"word":"君子不夺人之好","pinyin":"jūn zǐ bù duó rén zhī hào","abbr":"jzbdrzh","explanation":"君子：指品格高尚的人；好：喜爱。道德高尚的人不夺取人家喜爱的东西。","source":{"text":"我这里劝着道着他不采分毫，别人的首级他强要，他小心儿不肯自量度，可不道君子不夺人之好。","book":"元·马致远《马丹阳三度任风子》"},"similar":["君子成人之美"],"opposite":["夺人之好"],"usage":"作宾语、定语；用于为人等"},{"id":11419,"word":"君子不究既往","pinyin":"jūn zǐ bù jiù jì wǎng","abbr":"jzbjjw","explanation":"君子：指品格高尚的人；究：追究；既往：已经过去的事情。道德高尚的人不追究已过去的事情。","source":{"text":"就是俗语说：君子不究既往嘛。何况咱们还是亲戚！","book":"《柳暗花明》"},"usage":"作宾语、定语；用于为人"},{"id":11420,"word":"君子之交","pinyin":"jūn zǐ zhī jiāo","abbr":"jzzj","explanation":"贤者之间的交情，平淡如水，不尚虚华。","source":{"text":"且君子之交淡若水，小人之交甘若醴；君子淡以亲，小人甘以绝。","book":"战国·宋·庄周《庄子·山木》"},"example":{"text":"咱们可是～，不要来那一套。"},"similar":["君子之交淡如水"],"opposite":["小人之交"],"usage":"作主语、宾语；指纯洁的交往"},{"id":11421,"word":"君子之交接如水","pinyin":"jūn zǐ zhī jiāo jiē rú shuǐ","abbr":"jzzjjrs","explanation":"君子：品行端正的人。君子的交往清淡如水，而不是互相拉拢、利用。","source":{"text":"故君子之接如水，小人之接如醴；君子淡以成，小人甘以坏。","book":"西汉·戴圣《礼记·表记》"},"similar":["君子之交淡如水","君子之交淡若水"],"opposite":["小人之交甜如蜜"],"usage":"作宾语、分句；指纯洁的交往"},{"id":11422,"word":"君子之交淡如水","pinyin":"jūn zǐ zhī jiāo dàn rú shuǐ","abbr":"jzzjdrs","explanation":"交：交情。贤者之间的交情，平淡如水，不尚虚华。","source":{"text":"且君子之交淡若水，小人之交甘若醴；君子淡以亲，小人甘以绝。","book":"《庄子·山木》"},"example":{"text":"我止望周人之急紧如金，～。","book":"元·费唐臣《贬黄州》第三折"},"similar":["君子之交","君子之交接如水"],"opposite":["小人之交甜如蜜"],"usage":"作宾语、分句；指纯洁的交往"},{"id":11423,"word":"君子之交淡若水","pinyin":"jūn zǐ zhī jiāo dàn ruò shuǐ","abbr":"jzzjdrs","explanation":"君子：品行端正的人。君子的交往清淡如水，而不是互相拉拢、利用。","source":{"text":"且君子之交淡若水，小人之交甘若醴；君子淡以亲，小人甘以绝。","book":"战国·宋·庄周《庄子·山木》"},"similar":["君子之交淡如水","君子之交接如水"],"opposite":["小人之交甜如蜜"],"usage":"作宾语、分句；指纯洁的交往"},{"id":11424,"word":"君子之泽，五世而斩","pinyin":"jūn zǐ zhī zé，wǔ shì ér zhǎn","abbr":"jzzzwsez","explanation":"泽：原指雨露，引申为祖业；斩：衰败。君子的祖业，经过五代就会衰败，最终断绝。","source":{"text":"君子之泽，五世而斩；小人之泽，五世而斩。","book":"《孟子·离娄下》"}},{"id":11425,"word":"君子之过","pinyin":"jūn zǐ zhī guò","abbr":"jzzg","explanation":"过：过错。品行高尚的人犯错误就象日蚀和月蚀，别人看得很清楚，只要改正，别人仍然敬仰他。","source":{"text":"君子之过也，如日月之食焉。过也，从皆见之，更也，人皆仰之。","book":"《论语·子张》"},"example":{"text":"古人说过：“～如日月之蚀，其过也人皆见之，其改也人皆仰之。”","book":"姚雪垠《李自成》第二卷第五十章"}},{"id":11426,"word":"君子交绝不出恶声","pinyin":"jūn zǐ jiāo jué bù chū è shēng","abbr":"jzjjbces","explanation":"绝：断绝；恶：坏；声：话。君子即使同别人断绝交往，也不说其坏话。这是儒家宣扬的处世准则。","source":{"text":"臣闻古之君子交绝不出恶声。","book":"《史记·乐毅列传》"},"example":{"text":"然古～，临去犹作最后之通告，故敢尽怀披陈，唯我公详查焉！","book":"丁中江《北洋军阀史话》二二九"}},{"id":11427,"word":"君子交绝，不出恶声","pinyin":"jūn zǐ jiāo jué，bù chū è shēng","abbr":"jzjjbces","explanation":"君子：指品格高尚的人；交：交情；恶声：伤害诋毁的话。有道德的人即使绝交也不互相诋毁。","source":{"text":"臣闻古之君子交绝不出恶声。","book":"西汉·司马迁《史记·乐毅列传》"},"usage":"作宾语、定语、分句；用于为人"},{"id":11428,"word":"君子劳心，小人劳力","pinyin":"jūn zǐ láo xīn，xiǎo rén láo lì","abbr":"jzlxxrll","explanation":"君子从事脑力劳动，小人从事体力劳动。这是剥削阶级轻视体力劳动的观点。","source":{"text":"君子劳心，小人劳力，先王之制也。","book":"《左传·襄公九年》"}},{"id":11429,"word":"君子协定","pinyin":"jūn zǐ xié dìng","abbr":"jzxd","explanation":"双方不经过书面签字，只以口头承诺或交换函件而订立的协定，它与书面条约具有同等的效力。本用于国际事务间，后亦用为事先约定的套语。又称作“绅士协定”。","source":{"text":"我们不是有君子协定在先，任人唯贤，因材施教。","book":"王朔《顽主》"},"example":{"text":"咱们还是订立一个～。"},"usage":"作主语、宾语、定语；用于处事"},{"id":11430,"word":"君子固穷","pinyin":"jūn zǐ gù qióng","abbr":"jzgq","explanation":"君子：有教养、有德行的人；固穷：安守贫穷。指君子能够安贫乐道，不失节操。","source":{"text":"子曰：‘君子固穷，小人穷斯滥矣。’","book":"《论语·卫灵公》"},"example":{"text":"接连便是难懂的话，什么“～”，什么“者乎”之类，引得众人都哄笑起来。","book":"鲁迅《孔乙己》"},"usage":"作宾语、定语；用于为人等","story":["春秋时期，孔子带领弟子们周游列国，先后在卫、陈、蔡等国碰壁后，突然受到了楚国的邀请，孔子立即带领弟子启程赴楚，陈国立即串通蔡国放出囚犯围堵孔子。在孔子师徒被围困中，子路抱怨穷困潦倒，孔子说：“君子固穷，小人穷斯滥矣。”"]},{"id":11431,"word":"君子好逑","pinyin":"jūn zǐ hào qiú","abbr":"jzhq","explanation":"逑，通“仇”。仇:配偶。原指君子的佳偶。后遂用为男子追求佳偶之套语。","source":{"text":"窈窕淑女，君子好逑。","book":"《诗经·周南·关睢》"},"example":{"text":"公婆再想不到拿着我玉凤姐姐那样一个‘窈窕淑女’，玉郎他竟不肯‘～’。","book":"清·文康《儿女英雄传》第23回"},"usage":"作谓语；用于男性"},{"id":11432,"word":"君子成人之美","pinyin":"jūn zǐ chéng rén zhī měi","abbr":"jzcrzm","explanation":"君子：指品格高尚的人；成：成全，帮助；美：好事。道德高尚的人成全别人的好事。","source":{"text":"君子成人之美，不成人之恶。","book":"春秋·鲁·孔丘《论语·颜渊》"},"example":{"text":"又道是‘～’，便是个漠不相关的朋友，咱们还要劝他作成这件事，何况我合他呢？","book":"清·文康《儿女英雄传》第16回"},"similar":["成人之美"],"usage":"作宾语、定语、分句；用于为人"},{"id":11433,"word":"君子报仇，十年不晚","pinyin":"jūn zǐ bào chóu，shí nián bù wǎn","abbr":"jzbcsnbw","explanation":"君子：泛指品德高尚的人。指有志之士报仇雪恨不必性急，等待时机再动手。","source":{"text":"孩子，君子报仇，十年不晚！你把这笔账牢牢地记在心里！","book":"《儿女风尘记》"},"example":{"text":"～，待时机成熟再说。"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":11434,"word":"君子爱人以德","pinyin":"jūn zǐ ài rén yǐ dé","abbr":"jzaryd","explanation":"爱人：爱护别人；德：德行。按照道德标准去爱护人。泛指对人不偏私偏爱，不姑息迁就。","source":{"text":"君子之爱人也以德，细人之爱人也以姑息。","book":"《礼记·檀弓上》"},"example":{"text":"邹韬奋《抗战以来·爱我们的祖国》：“但是～，小人爱人以姑息，我们对于政治改革的要求，为着抗战必胜、建国必成的目的，也一点不能松。"},"similar":["爱人以德"],"usage":"作宾语、定语；用于书面语"},{"id":11435,"word":"君子爱财，取之有道","pinyin":"jūn zǐ ài cái，qǔ zhī yǒu dào","abbr":"jzacqzyd","explanation":"君子：有才德的人。君子喜欢正道得到的财物，不要不义之财。","source":{"text":"君子爱财，取之有道，该当你老夫子的，自然当仁不让。","book":"高阳《胡雪岩全传·平步青云》上册"},"usage":"作宾语、定语、分句；用于处世"},{"id":11436,"word":"君射臣决","pinyin":"jūn shè chén jué","abbr":"jscj","explanation":"射：射箭；决：射箭用具，即扳指，用以钩弦。君主喜好射箭，臣下自然经常带着射箭用具。比喻上司的爱好，随从者自然极力效法。","source":{"text":"君射则臣决。楚庄王好细腰，故朝有饿人。","book":"《荀子·君首》"}},{"id":11437,"word":"君暗臣蔽","pinyin":"jūn àn chén bì","abbr":"jacb","explanation":"暗：昏庸；蔽：欺瞒。君主昏庸无道，臣子欺瞒蒙骗。","source":{"text":"君暗臣蔽，枉杀至此。夫将士被擒乞降，使其可赎，犹当赎之，奈何戮其妻子！","book":"《清史稿·太守本纪》"},"example":{"text":"究竟原因只在如今～，所以枉杀多人。","book":"姚雪垠《李自成》第三卷第二十九章"}},{"id":11438,"word":"君臣佐使","pinyin":"jūn chén zuǒ shǐ","abbr":"jczs","explanation":"原指君主、臣僚、僚佐、使者四种人分别起着不同的作用，后指中药处方中的各味药的不同作用。","source":{"text":"上药一百二十种为君，主养命；中药一百二十种为臣，主养性；下药一百二十种为佐使，主治病；用药须合君臣佐使。","book":"《神农本草经》"},"example":{"text":"开中药处方时，要安排好各味药的～关系。"},"usage":"作定语、宾语；用于中药方面"},{"id":11439,"word":"君辱臣死","pinyin":"jūn rǔ chén sǐ","abbr":"jrcs","explanation":"封建礼教认为，帝王遭受耻辱，臣僚应当死节。","source":{"text":"臣闻之，为人臣者，君忧臣劳，君辱臣死。","book":"《国语·越语下》"},"example":{"text":"“～”，吾被李傕所杀，乃分也！","book":"明·罗贯中《三国演义》第十三回"},"usage":"作宾语、定语；指旧礼教规定"},{"id":11440,"word":"吝啬鬼","pinyin":"lìn sè guǐ","abbr":"lsg","explanation":"吝啬的或过度节俭的人。","example":{"text":"我很讨厌你这个～。"},"similar":["小气鬼"],"usage":"作主语、宾语、定语；指人小气"},{"id":11441,"word":"吞云吐雾","pinyin":"tūn yún tǔ wù","abbr":"tytw","explanation":"原形容道士修炼养气，不吃五谷，后形容人吸烟。","source":{"text":"始餐霞而吐雾，终凌虚而倒影。","book":"南朝梁·沈约《郊居赋》"},"example":{"text":"但我们现在只听说许多人躺着～，却很少见有人象外国水兵似的满街发酒疯。","book":"鲁迅《南腔北调集·家庭为中国之基本》"},"usage":"作谓语、定语；含讥讽意味"},{"id":11442,"word":"吞凤之才","pinyin":"tūn fèng zhī cái","abbr":"tfzc","explanation":"指丰美的文采。常用来形容擅长写作。","source":{"text":"雄著《太玄经》，梦吐凤凰，集‘玄’之上，顷而灭。","book":"晋·葛洪《西京杂记》卷二"}},{"id":11443,"word":"吞刀刮肠","pinyin":"tūn dāo guā cháng","abbr":"tdgc","explanation":"比喻决心改过自新。","source":{"text":"若许某自尊新，必吞刀刮肠，饮灰洗胃。","book":"《南史·荀伯玉传》"},"similar":["痛改前非"],"usage":"作谓语；指决心改过自新"},{"id":11444,"word":"吞刀吐火","pinyin":"tūn dāo tǔ huǒ","abbr":"tdth","explanation":"古杂剧之一，泛称魔术。","source":{"text":"吞刀吐火，云雾杳冥。","book":"汉·张衡《西京赋》"},"example":{"text":"丹、珠乃拔马破舌，～。","book":"《晋书·夏统传》"},"usage":"作谓语、宾语；泛称魔术"},{"id":11445,"word":"吞吞吐吐","pinyin":"tūn tūn tǔ tǔ","abbr":"tttt","explanation":"想说，但又不痛痛快快地说。形容说话有顾虑。","source":{"text":"你一味的吞吞吐吐，支支吾吾，你把我作何等人看待。","book":"清·文康《儿女英雄传》第五回"},"example":{"text":"至于新作，现在可是难了，较好的简直无处发表，但若做得～，自己又觉无聊。（鲁迅《书信集·致曹靖华》）"},"similar":["含糊其词","闪烁其辞"],"opposite":["直言不讳","开门见山"],"usage":"作谓语、宾语、补语；用于说话等"},{"id":11446,"word":"吞声忍恨","pinyin":"tūn shēng rěn hèn","abbr":"tsrh","explanation":"吞声：不敢出声；忍恨：强忍怨恨。指受了气勉强忍耐，有话不敢说出来。","source":{"text":"从今后忍气吞声，再不敢嚎咷痛哭。","book":"元·杨显之《潇湘雨》第四折"}},{"id":11447,"word":"吞声忍气","pinyin":"tūn shēng rěn qì","abbr":"tsrq","explanation":"吞声：不敢出声；忍：忍耐。形容受了气而勉强忍耐，不敢出声。","source":{"text":"我只是吞声忍气，匿迹潜形。","book":"元·高文秀《黑旋风》第一折"},"example":{"text":"鲁迅《且介亭杂文二集·论“人言可畏”》：“对强者它是弱者，但对更弱者它却还是强者，所以有时虽然～，有时仍可以耀武扬威。”"},"similar":["忍声吞气"],"usage":"作谓语、宾语、定语；用于处事"},{"id":11448,"word":"吞声忍泣","pinyin":"tūn shēng rěn qì","abbr":"tsrq","explanation":"吞声：咽下哭声；忍泣：忍住泪水。眼泪只能往肚里流，不敢哭出声来。形容受压迫时，忍受痛苦，不敢公开表露。","source":{"text":"琼英知了这消息，如万箭攒心，日夜吞声饮泣，珠泪偷弹，思报父母之仇，时刻不忘。","book":"明·施耐庵《水浒全传》第九十八回"},"example":{"text":"我非为牛马也，杂气集满胸，汝父以愤死，我所以～者，为无儿耳。","book":"清·蒲松龄《聊斋志异·段氏》"},"similar":["吞声饮泣"],"usage":"作谓语、宾语、定语；指默默承受"},{"id":11449,"word":"吞声忍泪","pinyin":"tūn shēng rěn lèi","abbr":"tsrl","explanation":"形容强忍悲伤。","source":{"text":"迢递可知闺阁，吞声忍泪孤眠。","book":"《敦煌曲子词·破阵子》"},"example":{"text":"清·伤时子《苍鹰击·题词》：“冷尽初心恨未休，～几春秋？”"},"similar":["吞声饮泪"],"usage":"作谓语、宾语；用于处事"},{"id":11450,"word":"吞声饮恨","pinyin":"tūn shēng yǐn hèn","abbr":"tsyh","explanation":"指抱恨无言。","source":{"text":"自古皆有死，莫不饮恨而吞声。","book":"语出南朝·梁·江淹《恨赋》"},"example":{"text":"清·湘灵子《轩亭冤·哭墓》：“从今惹得俺～，凭吊秋坟！”"},"usage":"作谓语、定语；用于处事"},{"id":11451,"word":"吞声饮气","pinyin":"tūn shēng yǐn qì","abbr":"tsyq","explanation":"犹吞声忍气。形容受了气而勉强忍耐，不敢出声。","source":{"text":"吞声饮气，恶呻吟之响，忍酸辛之酷哉！","book":"《北史·儒林传下》"},"example":{"text":"她只好～，默不做声。"},"similar":["吞声饮泣"],"usage":"作谓语、宾语；指默默承受"},{"id":11452,"word":"吞声饮泣","pinyin":"tūn shēng yǐn qì","abbr":"tsyq","explanation":"吞声：咽下哭声；饮泣：忍住泪水。眼泪只能往肚里流，不敢哭出声来。形容受压迫时，忍受痛苦，不敢公开表露。","source":{"text":"琼英知道了这个消息，如万箭攒心，日夜吞声饮泣，珠泪偷弹。","book":"明·施耐庵《水浒传》第89回"},"example":{"text":"我们不能～来对待这个问题。"},"similar":["吞声饮气","吞声忍泣"],"usage":"作谓语、宾语、定语；指默默承受"},{"id":11453,"word":"吞声饮泪","pinyin":"tūn shēng yǐn lèi","abbr":"tsyl","explanation":"吞声：咽下哭声；饮泪：忍住泪水。眼泪只能往肚里流，不敢哭出声来。形容受压迫时，忍受痛苦，不敢公开表露。","source":{"text":"其母彭氏，吞声饮泪，对着明升道：‘事已至此，不如早降，以免生灵之苦。’","book":"明·徐渭《英烈传》第七十七回"},"example":{"text":"可怜的三妹～，陪着个冰凉的青蛙呀共枕同眠！","book":"老舍《青蛙》第六场"},"similar":["吞声饮泣"],"usage":"作谓语、宾语；用于处事"},{"id":11454,"word":"吞炭为哑","pinyin":"tūn tàn wéi yǎ","abbr":"ttwy","explanation":"吞炭：喉咙吞炭使哑。指故意改变声音，使人不能认出自己。","source":{"text":"居顷之，豫让又漆身为厉，吞炭为哑，使形状不可知，行乞于市。","book":"《史记·刺客列传》"},"example":{"text":"今欲刺赵襄子，又恐认的我形容，是以漆身为癞，～，且妆风魔，行乞于市则个。","book":"元·杨梓《豫让吞炭》第四折"}},{"id":11455,"word":"吞炭漆身","pinyin":"tūn tàn qī shēn","abbr":"ttqs","explanation":"以之为忍辱含垢，矢志复仇的典实。","source":{"text":"战国时，豫让受知于智伯。后，韩、赵、魏三家合力攻杀智伯。豫让为报知遇之恩，矢志复仇。于是漆身为厉，吞炭为哑，改变声音形貌，伺机刺杀赵襄子，事败而死。事见《战国策·赵策一》、《史记·刺客列传》。"},"example":{"text":"清·文康《儿女英雄传》第25回：“我这番举动，也就如古人的卧薪尝胆、～一般。”"},"similar":["漆身吞炭"],"usage":"作宾语、定语；用于书面语","story":["春秋末期，晋国内乱，大夫赵襄子杀了大夫智伯。智伯的心腹家将豫让发誓要杀赵襄子，他潜入赵襄子的宅内行刺未遂。赵襄子佩服他的义气把他放了。第二次他把全身漆成癞子，然后吞下烧红的炭使声音变哑，再次去行刺未遂而自杀"]},{"id":11456,"word":"吞牛之气","pinyin":"tūn niú zhī qì","abbr":"tnzq","explanation":"形容气势很盛。","source":{"text":"小儿五岁气食牛，满堂宾客皆回头。","book":"唐·杜甫《徐卿二子歌》"},"example":{"text":"月君赐令平身，却见曾彪相貌奇特，狠狠然有～。","book":"吕熊《女仙外史》第三十六回"}},{"id":11457,"word":"吞符翕景","pinyin":"tūn fú xī jǐng","abbr":"tfxj","explanation":"指道者吞符箓，服日霞。"},{"id":11458,"word":"吞纸抱犬","pinyin":"tūn zhǐ bào quǎn","abbr":"tzbq","explanation":"吞纸充饥，抱犬御寒。形容家贫好学。","source":{"text":"好学，家贫无资，累日不爨，乃时吞纸以实腹；寒无毡被，抱犬而卧。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作宾语、定语；用于书面语","story":["南北朝时期，好学的朱詹小时候，因为家里十分贫穷，经常几天没钱买米下锅做饭，但他还是坚持学习，饥饿时只有吞纸下去饱肚。冬天没有毡被盖，只有抱着狗取暖睡觉。由于勤奋学习，终于成为有用之才"]},{"id":11459,"word":"吞舟之鱼","pinyin":"tūn zhōu zhī yú","abbr":"tzzy","explanation":"能吞舟的大鱼。常以喻人事之大者。","source":{"text":"网漏于吞舟之鱼，而吏治烝烝，不至于奸，黎民艾安。","book":"《庄子·庚桑楚》：“吞舟之鱼，砀而失水。”《列子·杨朱》：“吞舟之鱼，不游枝流；鸿鹄高飞，不集污池。”《史记·酷吏列传序》"},"example":{"text":"吾顿八纮之网以收之，即或漏～，而已暴腮断鳍，颓然老矣。","book":"严复《论世变之亟》"},"usage":"作宾语；多用于比喻句"},{"id":11460,"word":"吞舟之鱼，不游枝流","pinyin":"tūn zhōu zhī yú，bù yóu zhī liú","abbr":"tzzybyzl","explanation":"大鱼不在小河里游。比喻志节高尚的人不与世俗同流合污。","source":{"text":"吞舟之鱼，不游枝流，鸿鹄高飞，不集污池。","book":"《列子·杨朱》"}},{"id":11461,"word":"吞舟是漏","pinyin":"tūn zhōu shì lòu","abbr":"tzsl","explanation":"本指大鱼漏网，后常以喻罪大者逍遥法外。","source":{"text":"主上屈法申恩，吞舟是漏。","book":"《南史·陈庆之传》"},"similar":["吞舟漏网"],"usage":"作宾语、定语；多用于比喻句"},{"id":11462,"word":"吞舟漏网","pinyin":"tūn zhōu lòu wǎng","abbr":"tzlw","explanation":"本指大鱼漏网，后常以喻罪大者逍遥法外。同“吞舟是漏”。","source":{"text":"宽斯严，简斯定，吞舟漏网，而不敢再触梁笱者何也？","book":"清·王夫之《读通鉴论·秦始皇》"},"similar":["吞舟是漏"],"usage":"作宾语、定语；多用于比喻句"},{"id":11463,"word":"吞花卧酒","pinyin":"tūn huā wò jiǔ","abbr":"thwj","explanation":"指赏花饮酒，游春行乐。","source":{"text":"握月担风且留后日，吞花卧酒不可过时。","book":"唐·冯贽《云仙杂记》卷五"},"example":{"text":"尽游赏～，握月担风，谁诉离绪。","book":"元·洪希文《倦寻芳》词"}},{"id":11464,"word":"吞言咽理","pinyin":"tūn yán yān lǐ","abbr":"tyyl","explanation":"指不敢声张和申辩。","source":{"text":"其人虽众，然皆患彰遐迩，事隔天朝，故吞言咽理，无敢论诉。","book":"《南史·王藻传》"},"usage":"作谓语、定语；用于处事等"},{"id":11465,"word":"吞风饮雨","pinyin":"tūn fēng yǐn yǔ","abbr":"tfyy","explanation":"犹言餐风宿露。形容四处奔波，生活艰辛。","source":{"text":"急莫急于国课，去年职开征之始，昼夜焦蒿，吞风饮雨，仅得免于参罚。","book":"明·袁宏道《乞改稿》"},"usage":"作谓语、定语、宾语；用于生活"},{"id":11466,"word":"吟弄风月","pinyin":"yín nòng fēng yuè","abbr":"ynfy","explanation":"旧指文人写作或朗诵以风月等自然景色为题材的作品。现多形容作品空虚无聊。","source":{"text":"此天地之强阳气也，谁能以久生於是方。嘘竹莩，致膜眼。吟弄风月，使客忘返。","book":"宋·黄庭坚《席子泽盘礡图赞》"},"example":{"text":"与君～，端不负平生。","book":"宋·朱熹《水调歌头》词"}},{"id":11467,"word":"吟花咏柳","pinyin":"yín huā yǒng liǔ","abbr":"yhyl","explanation":"犹言吟风弄月。","source":{"text":"本军师于军次中、案箧内，每见诗卷，多是吟花咏柳。偶披览之，即于怀肠相悖。","book":"太平天国·洪仁玕《军次实录》"},"similar":["吟风弄月"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":11468,"word":"吟风咏月","pinyin":"yín fēng yǒng yuè","abbr":"yfyy","explanation":"旧指文人写作或朗诵以风月等自然景色为题材的作品。现多形容作品空虚无聊。","source":{"text":"吟咏风月，席天幕地，但贵其适所以适，不知夫所以然而然。","book":"唐·范传正《李翰林白墓志铭》"},"similar":["吟风弄月","咏月嘲风"],"usage":"作谓语、定语、宾语；指文学作品"},{"id":11469,"word":"吟风弄月","pinyin":"yín fēng nòng yuè","abbr":"yfny","explanation":"旧指文人写作或朗诵以风月等自然景色为题材的作品。现多形容作品空虚无聊。","source":{"text":"吟咏风月，席天幕地，但贵其适所以适，不知夫所以然而然。","book":"唐·范传正《李翰林白墓志铭》"},"example":{"text":"于是曹雪芹平静地说：“绣春，你别以为我们诗社里，都是～，无病呻吟。”","book":"高阳《曹雪芹别传》"},"similar":["咏日嘲月"],"usage":"作谓语、定语、宾语；指文学作品"},{"id":11470,"word":"吠形吠声","pinyin":"fèi xíng fèi shēng","abbr":"fxfs","explanation":"比喻跟在别人后面盲目附和。","source":{"text":"谚云：‘一犬吠形，百犬吠声’。","book":"汉·王符《潜夫论·贤难》"},"similar":["吠影吠形","人云亦云"],"usage":"作谓语、定语；用于书面语"},{"id":11471,"word":"吠影吠声","pinyin":"fèi yǐng fèi shēng","abbr":"fyfs","explanation":"比喻跟在别人后面盲目附和。","source":{"text":"谚云：‘一犬吠形，百犬吠声’。","book":"汉·王符《潜夫论·贤难》"},"example":{"text":"叭儿们何尝知道什么是民族主义，又何尝想到民族，只要一吠有骨头吃，便～了。","book":"《鲁迅书信集·致杨霁云》"},"similar":["随声附和","人云亦云"],"opposite":["针锋相对"],"usage":"作谓语、定语；用于书面语"},{"id":11472,"word":"吠非其主","pinyin":"fèi fēi qí zhǔ","abbr":"ffqz","explanation":"吠：狗叫。狗朝着外人乱叫。旧比喻各为其主。","source":{"text":"跖之狗吠尧，非贵跖而贱尧也。狗固吠非其主也。","book":"《战国策·齐策六》"},"example":{"text":"峤虽不辨逆顺，然亦为当时之谋～，不可追讨其罪。","book":"《旧唐书·李峤传》"},"similar":["各为其主"],"usage":"作谓语、定语；比喻各为其主"},{"id":11473,"word":"否去泰来","pinyin":"pǐ qù tài lái","abbr":"pqtl","explanation":"指厄运过去，好运到来。","source":{"text":"否去泰来终可待，寒夜休唱《饭牛歌》。","book":"前蜀·韦庄《湘中作》诗"},"similar":["否往泰来","否极泰来"],"usage":"作谓语、宾语；指厄运结束"},{"id":11474,"word":"否往泰来","pinyin":"pǐ wǎng tài lái","abbr":"pwtl","explanation":"指厄运过去，好运到来。同“否去泰来”。","source":{"text":"否往泰来，圣作惠出。","book":"唐·林谔《石壁寺铁弥勒像颂》"},"example":{"text":"～，灾生福过；考诸物理，斯为格言。","book":"前蜀·杜光庭《胡璠尚书地纲醮词》"},"similar":["否极泰来","否去泰来"],"usage":"作谓语、宾语；指厄运结束"},{"id":11475,"word":"否极泰回","pinyin":"pǐ jí tài huí","abbr":"pjth","explanation":"指坏运到了头好运就来了。同“否极泰来”。","source":{"text":"想何年甚时，否极泰回，夫荣子贵。","book":"明·沈采《千金记·漏贼》"},"similar":["否极泰来"],"usage":"作谓语、宾语；指厄运结束"},{"id":11476,"word":"否极泰来","pinyin":"pǐ jí tài lái","abbr":"pjtl","explanation":"逆境达到极点，就会向顺境转化。指坏运到了头好运就来了。","source":{"text":"泰，小往大来，吉亨。","book":"《易·否》：“否之匪人，不利君子贞，大往小来。”《易·泰》"},"example":{"text":"任何事物的发展都是物极必反，～。"},"similar":["否去泰来","时来运转","苦尽甘来"],"usage":"作谓语、宾语；指厄运结束"},{"id":11477,"word":"否极泰至","pinyin":"pǐ jí tài zhì","abbr":"fjtz","explanation":"否：坏；泰：好，顺利。坏的达到极点，好的就来了。指厄运终了好运就来。指事物发展到极端就会向相反的方面转化。","source":{"text":"否极泰至，虽物理之常然；昔弃今收，岂罪余之敢望！","book":"宋·苏轼《量移廉州表》"},"similar":["泰来否极"],"usage":"作谓语、宾语；指厄运结束"},{"id":11478,"word":"否极生泰","pinyin":"pǐ jí shēng tài","abbr":"fjst","explanation":"否：坏；泰：好，顺利。坏的达到极点，好的就来了。指厄运终了好运就来。","source":{"text":"几时得否极生泰，看别人青云独步立瑶阶。","book":"元·关汉卿《裴度还带》第一折"},"example":{"text":"你不要指望会立即出现～了。"},"similar":["否极泰来"],"usage":"作谓语、宾语；指厄运结束"},{"id":11479,"word":"否极而泰","pinyin":"pǐ jí ér tài","abbr":"fjet","explanation":"否、泰：64卦中的两个卦名。指坏的到了尽头就要好起来。","source":{"text":"时过于期，否终则泰。","book":"《周易·否》：“否之匪人，不利君子贞，大往小来。”《周易·泰》：“泰，小往大来，吉亨。”《吴越春秋·勾践入臣外传》"},"example":{"text":"不然，邢即～，亦恶能仓卒起楼阁、累巨金哉？","book":"清·蒲松龄《聊斋志异·邢子仪》"},"similar":["否极泰来"],"usage":"作定语；用于时运"},{"id":11480,"word":"否极阳回","pinyin":"pǐ jí yáng huí","abbr":"pjyh","explanation":"犹言否极泰来。《泰》卦内阳而外阴，故称阳。指坏运到了头好运就来了。","source":{"text":"祸盈业满，否极阳回。","book":"清·陈梦雷《丁巳秋道山募建普度疏》"},"similar":["否极泰回","否极泰来"],"usage":"作谓语、宾语；指厄运结束"},{"id":11481,"word":"否终则泰","pinyin":"pǐ zhōng zé tài","abbr":"pzzt","explanation":"指闭塞到极点，则转向通泰。","source":{"text":"时过于期，否终则泰。","book":"《易·杂卦》：“否泰，反其类也。”汉·赵晔《吴越春秋·勾践入臣外传》"},"example":{"text":"夫～，屯极则亨，若日月之回环，犹阴阳之报复。","book":"南朝·陈·徐陵《为陈武帝作相时与岭南酋豪书》"},"similar":["否终复泰","否终而泰"],"usage":"作谓语、宾语；指厄运结束"},{"id":11482,"word":"否终复泰","pinyin":"pǐ zhōng fù tài","abbr":"pzft","explanation":"指厄运终结，好运转来。","source":{"text":"实冀否终而泰，属运在今。","book":"《晋书·庚亮传》"},"similar":["否终则泰"],"usage":"作谓语、宾语；指厄运结束"},{"id":11483,"word":"否终斯泰","pinyin":"pǐ zhōng sī tài","abbr":"fzst","explanation":"否：坏；泰：好，顺利。坏运到了尽头，好运就来了。","source":{"text":"夫否终斯泰，屯极则亨，若日月之回环，犹阴阳之报复。","book":"南朝·梁·徐陵《为陈武帝作相时与岭南酋豪书》"},"similar":["否终而泰","否终复泰","否终则泰"],"usage":"作谓语、宾语；指厄运结束"},{"id":11484,"word":"否终而泰","pinyin":"pǐ zhōng ér tài","abbr":"fzet","explanation":"否：坏；泰：好，顺利。坏运到了尽头，好运就来了。","source":{"text":"实冀否终而泰，属运在今。","book":"《晋书·庾亮传》"},"similar":["否终复泰","否终则泰","否终斯泰"],"usage":"作谓语、宾语；指厄运结束"},{"id":11485,"word":"含仁怀义","pinyin":"hán rén huái yì","abbr":"hrhy","explanation":"指有仁义之德。","source":{"text":"故麒麟麕首牛尾，圆顶一角，含仁怀义。","book":"汉·刘向《说苑·辨物》"},"example":{"text":"伊一角之仁兽，禀五行之粹精，必含仁而怀义，不群居而旅行。","book":"宋·吴淑《麟赋》"},"usage":"作谓语、定语；用于处事"},{"id":11486,"word":"含冤受屈","pinyin":"hán yuān shòu qū","abbr":"hysq","explanation":"遭受委曲，忍受冤枉。同“含冤负屈”。","source":{"text":"文艺工作者含冤受屈，管文艺的同志也无可奈何，只有随声应和，得以幸存。","book":"艾芜《关于三十年文艺的一些感想》四"},"similar":["含冤负屈"],"usage":"作宾语、定语、状语；指忍受冤枉"},{"id":11487,"word":"含冤抱恨","pinyin":"hán yuān bào hèn","abbr":"hybh","explanation":"蒙受冤屈以后，心里满怀怨恨。","source":{"text":"朝权国柄，委之群孽，剿戮忠贤，诛残台辅，含冤报痛，噍类靡余。","book":"《梁书·武帝纪上》"},"example":{"text":"或迎合朕意使人～者，朕之所恶，卿等其以为戒。","book":"明·余继登《典故纪闻》卷八"}},{"id":11488,"word":"含冤抱痛","pinyin":"hán yuān bào tòng","abbr":"hybt","explanation":"痛：怨恨。蒙受冤屈以后，心里满怀怨恨。","source":{"text":"朝权国柄，委之群孽，剿戮忠贤，诛残台辅，含冤报痛，噍类靡余。","book":"《梁书·武帝纪上》"}},{"id":11489,"word":"含冤莫白","pinyin":"hán yuān mò bái","abbr":"hymb","explanation":"含：包藏；莫：无处，无法；白：弄明白。指有冤屈无处申诉、无法昭雪。","example":{"text":"他在“文革”期间差点含冤莫白地离开人世。"},"similar":["沉冤莫白","含冤负屈","抱恨终天"],"opposite":["申冤吐气","平反昭雪"],"usage":"作宾语、定语、状语；指有冤屈"},{"id":11490,"word":"含冤负屈","pinyin":"hán yuān fù qū","abbr":"hyfq","explanation":"遭受委曲，忍受冤枉。","source":{"text":"他只待强拆开我长搀搀的连理枝，生摆断我颤巍巍的并头莲。其实负屈衔冤。","book":"元·关汉卿《望江亭》第四折"},"example":{"text":"说无休诉不尽的～情。","book":"元·武汉臣《生金阁》第四折"},"similar":["衔冤负屈","叫苦连天","委曲求全"],"usage":"作宾语、定语、状语；指忍受冤枉"},{"id":11491,"word":"含冰茹檗","pinyin":"hán bīng rú bò","abbr":"hbrb","explanation":"檗，黄檗。形容生活清苦，为人清白。同“饮冰食檗”。","source":{"text":"太夫人舍生不遂，乃奉君姑并携六月孤儿，伴榇回浙，赁居于海宁桐木村旧戚马氏之见远山楼。自此含冰茹檗之中，惟曲尽其事长抚雏之责矣。","book":"清·李枢《〈精忠传弹词〉序》"},"usage":"作谓语、定语；用于生活"},{"id":11492,"word":"含含糊糊","pinyin":"hán hán hū hū","abbr":"hhhh","explanation":"含混不清的样子。","source":{"text":"老太太与凤姐姐方才说话含含糊糊，不知是什么意思。","book":"清·曹雪芹《红楼梦》第85回"},"example":{"text":"即所谓《对张杨的训词》，内容～，曲曲折折，实为中国政治文献中一篇有趣的文章。","book":"毛泽东《关于蒋介石声明的声明》"},"similar":["含糊其词","模模糊糊"],"opposite":["一清二楚"],"usage":"作谓语、定语、状语；指不清晰","story":["大观园里人员逐渐在减少，宝钗搬回家，史湘云也回了家。宝玉已经开始去上学，贾母与凤姐等商议把薛宝钗许给宝玉，他们只有背着宝玉偷偷议论。宝玉听不懂她们含含糊糊的对话，就去问袭人。袭人也不知就里，只是安慰他安心读书"]},{"id":11493,"word":"含哺而熙，鼓腹而游","pinyin":"hán bǔ ér xī，gǔ fù ér yóu","abbr":"hbexgfey","explanation":"哺：口中所含的食物；熙：游戏；鼓腹：鼓起肚子，即饱食。口含食物，手拍肚子。形容太平时代无忧无虑的生活。","source":{"text":"夫赫胥氏之时，民居不知所为，行不知所之，含哺而熙，鼓腹而游，民能以此矣。","book":"《庄子·马蹄》"},"example":{"text":"当此之时，万民猖狂，不知东西，～。","book":"《淮南子·俶真训》"},"similar":["含哺鼓腹"],"usage":"作谓语、定语；用于生活等"},{"id":11494,"word":"含哺鼓腹","pinyin":"hán bǔ gǔ fù","abbr":"hbgf","explanation":"哺：口中所含的食物；鼓腹：鼓起肚子，即饱食。口含食物，手拍肚子。形容太平时代无忧无虑的生活。","source":{"text":"夫赫胥氏之时，民居不知所为，行不知所之，含哺而熙，鼓腹而游，民能以此矣。","book":"《庄子·马蹄》"},"example":{"text":"糯米蒸糕，大嚼了一个～。","book":"清·李绿园《歧路灯》第八十四回"},"similar":["鼓腹含哺"],"usage":"作谓语、定语；形容人过着安乐的生活"},{"id":11495,"word":"含商咀征","pinyin":"hán shāng jǔ zhēng","abbr":"hsjz","explanation":"指沉浸于优美的乐曲之中。“宫”、“商”、“征”均中国古乐中的音阶名。亦作“含宫咀征”。"},{"id":11496,"word":"含商咀徵","pinyin":"hán shāng jǔ zhēng","abbr":"hsjz","explanation":"“宫”、“商”、“徵”都是中国古乐中的音阶名。指沉浸于优美的乐曲之中。同“含宫咀徵”。","source":{"text":"含商咀徵歌露晞，珠履飒沓纨袖飞。","book":"南朝·宋·鲍照《代白紵舞歌辞》之一"},"example":{"text":"～双幽咽，软豰疏罗共萧屑。","book":"唐·温庭筠《觱篥歌》"},"similar":["含商咀徵"],"usage":"作宾语、定语；用于书面语"},{"id":11497,"word":"含垢包羞","pinyin":"hán gòu bāo xiū","abbr":"hgbx","explanation":"指忍受耻辱。同“含垢忍耻”。","source":{"text":"使诸君子有一毫道理不尽，我根潜伏，恶能含垢包羞，与世委蛇若此？","book":"明·袁宏道《广庄·人间世》"},"similar":["含垢忍辱","含垢忍耻","含污忍垢"],"usage":"作谓语、定语、状语；用于处世等"},{"id":11498,"word":"含垢匿瑕","pinyin":"hán gòu nì xiá","abbr":"hgnx","explanation":"包容污垢，隐匿缺失。形容宽宏大度。","source":{"text":"瑾瑜匿瑕，国君含垢。","book":"语出《左传·宣公十五年》"},"example":{"text":"官封代袭，刑赏自专，国家～，垂六十载。","book":"《旧唐书·田弘正传》"},"similar":["含垢纳污"],"usage":"作谓语、定语、状语；指气度大"},{"id":11499,"word":"含垢弃瑕","pinyin":"hán gòu qì xiá","abbr":"hgqx","explanation":"包容污垢，不责过失。形容宽宏大度。","source":{"text":"况当今陛下在宥四海，与人为天，特降含垢弃瑕之书，且授随才任能之柄于阁下。","book":"唐·元稹《上门下裴相公书》"},"similar":["含垢藏瑕"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":11500,"word":"含垢忍污","pinyin":"hán gòu rěn wū","abbr":"hgrw","explanation":"指忍受耻辱。同“含垢忍耻”。","source":{"text":"我为三爷含垢忍污的同牛马落交，却又因亲近牛马，得罪了三爷，岂不大失算吗？","book":"《老残游记续集遗稿》第四回"},"similar":["含垢忍耻","含垢忍辱","含污忍垢"],"usage":"作谓语、定语、状语；用于处世等"},{"id":11501,"word":"含垢忍耻","pinyin":"hán gòu rěn chǐ","abbr":"hgrc","explanation":"指忍受耻辱。","source":{"text":"陛下尚不觉悟，竭民膏血而不恤，忘国大雠而不报，含垢忍耻，举天下而臣之，甘心焉。","book":"宋·胡铨《上高宗封事》"},"example":{"text":"而那般～积来世福或者梦想死后天堂的‘芸芸众生’却早已被人忘记，连埋骨之所也无人知道了。","book":"巴金《梦与醉·生》"},"similar":["含垢忍辱","含垢忍污","含垢包羞"],"usage":"作谓语、定语、状语；用于处世等"},{"id":11502,"word":"含垢忍辱","pinyin":"hán gòu rěn rǔ","abbr":"hgrr","explanation":"忍、含：忍受。形容忍受耻辱。","source":{"text":"有善莫名，有恶莫辞，忍辱含垢，常若畏惧，是谓卑弱下人也。","book":"《后汉书·曹世叔妻传》"},"example":{"text":"宋徽宗在位时，不可一世，而被掳后偏会～。","book":"鲁迅《南腔北调集·谚语》"},"similar":["逆来顺受","忍辱负重"],"opposite":["盛气凌人","忍无可忍","恃才傲物"],"usage":"作谓语、定语、状语；同“忍辱负重”"},{"id":11503,"word":"含垢纳污","pinyin":"hán gòu nà wū","abbr":"hgnw","explanation":"垢：耻辱；污：污蔑。容忍耻辱和污蔑。指气度大，能包容一切。","source":{"text":"谚曰：‘高下在心，川泽纳污，山薮藏疾，瑾瑜匿瑕。’国君含垢，天之道也。","book":"《左传·宣公十五年》"},"example":{"text":"退而上书数万言，大抵皆劝神宗忠恕仁厚，～，屈己以裕人也。","book":"宋·苏轼《辩试馆职策问札子》之二"},"similar":["忍气吞声","忍辱负重","逆来顺受"],"opposite":["盛气凌人","忍无可忍","恃才傲物"],"usage":"作谓语、定语、状语；指气度大"},{"id":11504,"word":"含垢藏瑕","pinyin":"hán gòu cáng xiá","abbr":"hgcx","explanation":"包容污垢，隐匿缺失。形容宽宏大度。同“含垢匿瑕”。","source":{"text":"康性含垢藏瑕，爱恶不争于怀，喜怒不寄于颜。","book":"《世说新语·德行》“未尝见其喜愠之色”刘孝标注引《嵇康别传》"},"similar":["含垢弃瑕","含垢匿瑕"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":11505,"word":"含垢藏疾","pinyin":"hán gǒu cáng jí","abbr":"hgcj","explanation":"本谓应有包容的气量，后转用以指包容坏人坏事。","source":{"text":"谚曰：‘高下在心，川泽纳污，山薮藏疾，瑾瑜匿瑕。’国君含垢，天之道也。","book":"《左传·宣公十五年》"},"example":{"text":"自擅江表，～。","book":"《三国志·魏公孙渊传》"},"similar":["含垢纳污"],"usage":"作谓语、定语；形容宽仁大度"},{"id":11506,"word":"含宫咀征","pinyin":"hán gōng jǔ zhēng","abbr":"hgjz","explanation":"指沉浸于优美的乐曲之中。同“含商咀征”。"},{"id":11507,"word":"含宫咀徵","pinyin":"hán gōng jǔ zhēng","abbr":"hgjz","explanation":"“宫”、“商”、“徵”都是中国古乐中的音阶名。指沉浸于优美的乐曲之中。同“含商咀徵”。","source":{"text":"目成造次非相谋，含宫咀徵何悠悠！","book":"景耀月《长歌行》"},"similar":["含商咀徵"],"usage":"作宾语、定语；用于书面语"},{"id":11508,"word":"含屈而死","pinyin":"hán qū ér sǐ","abbr":"hqes","explanation":"含着委屈而死去。","example":{"text":"他在文革期间～。"},"similar":["负屈而亡","含冤而死"],"opposite":["含笑九泉"],"usage":"作谓语；指死不瞑目","story":["刘备当了皇帝后，关羽死在孙权手里。刘备急于派张飞去攻打东吴，就封张飞为车骑大将军，西乡侯。张飞听说关羽已死，就从阆中赶去见刘备领战。张飞回到阆中因报仇心切急于备战，因惩罚范疆与张达办事不力被他们刺杀，含屈而死"]},{"id":11509,"word":"含恨九泉","pinyin":"hán hèn jiǔ quán","abbr":"hhjq","explanation":"指抱怨而死，在地下还带着怨恨。","source":{"text":"只因去寻吴瑞庵，遂被功名耽延岁月，归来迟了，以致白小姐含恨九泉。","book":"清·荑荻散人《玉娇梨》第18回"},"opposite":["死而无憾"],"usage":"作谓语、定语；用于处事"},{"id":11510,"word":"含悲茹痛","pinyin":"hán bēi rú tòng","abbr":"hbrt","explanation":"含：含蕴；茹：吃。忍受痛苦。","example":{"text":"经过一段时间的～，她终于走出心理误区。"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":11511,"word":"含情脉脉","pinyin":"hán qíng mò mò","abbr":"hqmm","explanation":"饱含温情，默默地用眼神表达自己的感情。常用以形容少女面对意中人稍带娇羞但又无限关切的表情。","source":{"text":"一则含情脉脉，如有思而不得，类西施之容冶。","book":"唐·李德裕《二芳丛赋》"},"example":{"text":"现在又见她～，不带点些儿轻狂。","book":"张恨水《啼笑姻缘》第二回"},"similar":["脉脉含情"],"opposite":["横眉怒目","冷酷无情","爱理不理"],"usage":"作定语、状语；形容用眼神传递情意"},{"id":11512,"word":"含意未申","pinyin":"hán yì wèi shēn","abbr":"hyws","explanation":"申：表述，表达出来。心中的想法还没来得及说出来。","source":{"text":"齐心同所愿，含意俱未申。","book":"南朝·梁·萧统《文选·古诗十九首之四》"}},{"id":11513,"word":"含明隐迹","pinyin":"hán míng yǐn jì","abbr":"hmyj","explanation":"犹韬光匿迹。藏匿光彩，掩蔽形迹。形容不自炫露。","source":{"text":"妙哉隗生！含明隐迹而莫之闻，可谓镜穷达而洞吉凶者也。","book":"晋·干宝《搜神记》卷二"},"similar":["韬光匿迹"],"usage":"作谓语、定语；用于说话等"},{"id":11514,"word":"含毫吮墨","pinyin":"hán háo shǔn mò","abbr":"hhsm","explanation":"毫：毛笔的笔尖；含毫：将笔尖含在口中，指以口润笔；吮墨：以口吸吮墨汁。形容构思作品或准备写作。也指凝神遐想，进行写作。","source":{"text":"由此而谈，又何容易，故韬翰吮墨，多历寒暑。","book":"晋·陆机《文赋》：“或操觚以率尔，或含毫而邈然。”《梁书·刘孝绰传》"}},{"id":11515,"word":"含毫命简","pinyin":"hán háo mìng jiǎn","abbr":"hhmj","explanation":"毫：毛笔的笔尖；命：拿，使用；简：古时书写用的竹片，后泛指纸张。口里含着笔尖，书桌上放好纸张。指开始写作著述。","source":{"text":"方且挥毫命楮，恣意著述，每一篇成，跳跃大呼，若狂若颠。","book":"明·袁宏道《瓶花斋集之十·尺牍·答王百谷》"},"example":{"text":"试一问此超越欧美之中国文学家，果有能心知作文之法则，而后～者乎？","book":"孙中山《心理建设》第三章"},"usage":"作谓语、定语；用于写作等"},{"id":11516,"word":"含污忍垢","pinyin":"hán wū rěn gòu","abbr":"hwrg","explanation":"指忍受屈辱。","source":{"text":"若令含污忍垢，即死填沟壑，目且不瞑。","book":"《明史·周经传》"},"similar":["含垢忍辱","含垢忍耻","含垢包羞"],"usage":"作谓语、定语、状语；用于处世等"},{"id":11517,"word":"含沙射影","pinyin":"hán shā shè yǐng","abbr":"hssy","explanation":"传说一种叫蜮的动物，在水中含沙喷射人的影子，使人生病。比喻暗中攻击或陷害人。","source":{"text":"含沙射流影，吹蛊痛行晖。","book":"晋·干宝《搜神记》卷十二：“其名曰蜮，一曰短狐，能含沙射人，所中者则身体筋急，头痛、发热，剧者至死。”南朝宋·鲍照《苦热行》"},"example":{"text":"张氏昨日又在《青光》栏上登一启事，～，肆意诬毁。","book":"鲁迅《伪自由书·后记》引黎烈文启事"},"similar":["含血喷人","指桑骂槐","恶语中伤"],"opposite":["光明正大","直截了当"],"usage":"作谓语、定语、状语；指人说话","story":["古代传说水中怪物蜮，形状像鳖，只有三条腿，嘴里有一条像弓的横肉，看到岸上或水上人或人影经过时就喷射沙子，被喷之人就会生病，非常痛苦，严重的直到死亡。由于它很坏，人们一旦见了一般都是想办法避开"]},{"id":11518,"word":"含牙带角","pinyin":"hán yá dài jiǎo","abbr":"hydj","explanation":"有牙有角，形容兽类。同“含牙戴角”。","source":{"text":"凡有血气之虫，含牙带角，前爪后距。","book":"《淮南子·兵略训》"},"similar":["含牙戴角"],"usage":"作谓语、定语；指兽类"},{"id":11519,"word":"含牙戴角","pinyin":"hán yá dài jiǎo","abbr":"hydj","explanation":"有牙有角，形容兽类。同“含牙带角”。","source":{"text":"含牙戴角，前爪后距。","book":"《淮南子·修务训》"},"similar":["含牙带角"],"usage":"作谓语、定语；指兽类"},{"id":11520,"word":"含瑕积垢","pinyin":"hán xiá jī gòu","abbr":"hxjg","explanation":"比喻蒙受耻辱。","source":{"text":"况仆含瑕积垢以此终世，惟应躬耕灌园，矢沟壑之志，保桑榆之路，补东隅之失，庶几不诒田夫野人讪笑。","book":"明·唐顺之《与郭似庵巡按书》"},"usage":"作谓语、宾语；用于处事"},{"id":11521,"word":"含着骨头露着肉","pinyin":"hán zhe gǔ tóu lù zhe ròu","abbr":"hzgtlzr","explanation":"比喻说话半吞半吐，不把意思完全说出来。","source":{"text":"你要我收下这个东西，须先和我说明白了。要是这么‘含着骨头露着肉’的，我倒不收。","book":"清·曹雪芹《红楼梦》第八十八回"},"usage":"作定语、宾语；用于说话等"},{"id":11522,"word":"含章天挺","pinyin":"hán zhāng tiān tǐng","abbr":"hztt","explanation":"指内怀美质而挺秀。同“含章挺生”。","source":{"text":"公含章天挺，命世诞生。","book":"北周·庚信《周上柱国齐王宪神道碑》"},"similar":["含章挺生"],"usage":"作谓语、定语；用于书面语"},{"id":11523,"word":"含章挺生","pinyin":"hán zhāng tǐng shēng","abbr":"hzts","explanation":"指内怀美质而挺秀。同“含章天挺”。","source":{"text":"王褒炜烨而秀发，扬雄含章而挺生。","book":"晋·左思《蜀都赋》"},"example":{"text":"～，孚尹旁达。","book":"清·钱谦益《祖逢阳》"},"similar":["含章天挺"],"usage":"作谓语、定语；用于书面语"},{"id":11524,"word":"含笑九原","pinyin":"hán xiào jiǔ yuán","abbr":"hxjy","explanation":"原：泛指墓地。在九泉之下满含笑容。指死后也感到心安，没什么牵挂。","source":{"text":"齿发如公自古稀，定应含笑九原归。","book":"宋·王十朋《王忠文公集·黄府君挽词四首》"},"similar":["含笑九泉","含笑九幽"],"usage":"作谓语；指死而无憾"},{"id":11525,"word":"含笑九幽","pinyin":"hán xiào jiǔ yōu","abbr":"hxjy","explanation":"在九泉之下满含笑容。指死后也感到心安，没什么牵挂。","source":{"text":"公得此深明大义之贞姬，复有此为国捐躯之肖子，洵可含笑九幽。","book":"清·陈康祺《郎潜纪闻》"},"similar":["含笑九泉","含笑九原"],"usage":"作谓语；指死而无憾"},{"id":11526,"word":"含笑九泉","pinyin":"hán xiào jiǔ quán","abbr":"hxjq","explanation":"九泉：地下深处，旧指人死之后埋葬的地方。也作：“黄泉”。在九泉之下满含笑容。表示死后也感到欣慰和高兴。","source":{"text":"我儿前去，得能替我出半臂之劳，我亦含笑九泉。","book":"清·李汝珍《镜花缘》第三回"},"example":{"text":"办成此事，我也可～了。"},"similar":["含笑九原","含笑九幽"],"usage":"作谓语；指死而无憾"},{"id":11527,"word":"含笑入地","pinyin":"hán xiào rù dì","abbr":"hxrd","explanation":"面带笑容而死。犹言死而无憾。","source":{"text":"韶曰：‘长活沟壑之人，而以此伏罪，含笑入地矣。’","book":"《后汉书·韩韶传》"},"example":{"text":"克臣报之曰：‘汝能以身徇国，吾～矣。","book":"《宋史·忠义传二·唐重》"},"similar":["含笑九泉","死而无憾"],"usage":"作谓语；同“含笑九泉”"},{"id":11528,"word":"含糊不明","pinyin":"hán hú bù míng","abbr":"hhbm","explanation":"不清楚的意思。","example":{"text":"他发着高热，～地说了好些话，可是没有人明白那是什么意思。"}},{"id":11529,"word":"含糊不清","pinyin":"hán hú bù qīng","abbr":"hhbq","explanation":"指说话声音不清楚或事物没有分辨清楚。也指不能明辨是非。","source":{"text":"各级党组织直到每个支部的态度都要十分坚定，不能有任何游移不定、含糊不清的表现。","book":"邓小平《目前的形势和任务》"},"example":{"text":"她的话语表达～。"},"similar":["模糊不清","含含糊糊"],"opposite":["一清二楚"],"usage":"作谓语、定语；指人的态度"},{"id":11530,"word":"含糊其词","pinyin":"hán hú qí cí","abbr":"hhqc","explanation":"含糊：不明确，不清晰。词：话语。故意把话说得模棱两可，不清楚，不明确。","source":{"text":"即相执证，理全辨明，朝廷每为含糊，未尝穷究曲直。","book":"唐·陆贽《论缘边守备事宜壮》"},"example":{"text":"二人先受岸贾之瞩，～，不肯替赵氏分辨。","book":"明·冯梦龙《东周列国志》第五十七回"},"similar":["含糊其辞"],"opposite":["开门见山"],"usage":"作谓语、定语、状语；指话说得不清不楚"},{"id":11531,"word":"含糊其辞","pinyin":"hán hú qí cí","abbr":"hhqc","explanation":"话说得不清不楚，含含糊糊。形容有顾虑，不敢把话照直说出来。","source":{"text":"是非予夺，多含糊其辞；公则不然，可则曰可，否则曰否。","book":"宋·袁燮《絜斋集》第十八卷"},"example":{"text":"发表时候，为了避免反动政府检查，有的地方故意～，现在把它们弄明确了。","book":"沙汀《短篇小说集·后记》"},"similar":["闪烁其辞","含糊其词"],"opposite":["单刀直入","心直口快","开门见山"],"usage":"作谓语、定语、状语；指话说得不清不楚"},{"id":11532,"word":"含羞忍耻","pinyin":"hán xiū rěn chǐ","abbr":"hxrc","explanation":"含、忍：忍受。指忍受羞辱。","source":{"text":"胜败兵家事不期，包羞忍耻是男儿。","book":"唐·杜牧《题乌江亭》诗"},"example":{"text":"杨妃～参拜毕，俯伏在地，玄宗赐他平身。","book":"清·褚人获《隋唐演义》第七十九回"}},{"id":11533,"word":"含羞忍辱","pinyin":"hán xiū rěn rǔ","abbr":"hxrr","explanation":"含：包容；辱：耻辱。形容忍受羞耻侮辱。","source":{"text":"那金钏儿含羞忍辱的出去，不在话下。","book":"清·曹雪芹《红楼梦》第30回"},"example":{"text":"清·曹雪芹《红楼梦》第30回：“那金钏儿～的出去，不在话下。”"},"similar":["含垢忍辱"],"usage":"作谓语、定语、状语；用于被迫的场赶"},{"id":11534,"word":"含苞吐萼","pinyin":"hán bāo tǔ è","abbr":"hbte","explanation":"形容花朵将要开放时的状态。","source":{"text":"又命催花使者，往来保护，以期含苞吐萼之时，加之呈妍。","book":"清·李汝珍《镜花缘》"},"similar":["含苞待放","含苞未放"],"usage":"作定语；用于花"},{"id":11535,"word":"含苞待放","pinyin":"hán bāo dài fàng","abbr":"hbdf","explanation":"形容花朵将要开放时的形态。也比喻将成年的少女。","source":{"text":"又命催花使者，往来保护，以期含苞吐萼之时，加之呈妍。","book":"清·李汝珍《镜花缘》"},"example":{"text":"这样的挑选，有名无实，纵使貌艳如花，但～，十分颜色只露得十分。","book":"高阳《玉座珠帘》上册"},"similar":["豆蔻年华","含苞未放","含苞欲放"],"opposite":["落英纷飞"],"usage":"作谓语、定语；形容花或少女"},{"id":11536,"word":"含苞未放","pinyin":"hán bāo wèi fàng","abbr":"hbwf","explanation":"苞：花苞；放：开放。形容花朵将要开放。也比喻将成年的少女。","source":{"text":"鲁迅的书桌上刻着一个‘早’字，字是横着刻的，很像一个含苞未放的花骨朵，又像一支小巧玲珑的火把。","book":"《三味书屋》"},"similar":["含苞待放","含苞欲放"],"usage":"作谓语、定语；形容花或少女"},{"id":11537,"word":"含苞欲放","pinyin":"hán bāo yù fàng","abbr":"hbyf","explanation":"苞：花苞；欲：将要；放：开放。形容花将开而未开时的样子。","source":{"text":"山上田野里桃花含苞欲放，我的心激动得要跳出胸膛。","book":"《大仓老师》"},"example":{"text":"她到了～的年龄。"},"similar":["含苞待放","含苞未放"],"usage":"作谓语、定语；形容花或少女"},{"id":11538,"word":"含英咀华","pinyin":"hán yīng jǔ huá","abbr":"hyjh","explanation":"咀：细嚼，引伸为体味；英、华：这里指精华。比喻读书吸取其精华。","source":{"text":"沈浸浓郁，含英咀华。","book":"唐·韩愈《进学解》"},"example":{"text":"～，早预蓬莱道山之选。","book":"宋·陆游《答建宁陈通判启》"},"similar":["含菁咀华"],"opposite":["生吞活剥","不求甚解","囫囵吞枣"],"usage":"作谓语、定语；用于文章等"},{"id":11539,"word":"含荼茹毒","pinyin":"hán tú rú dú","abbr":"htrd","explanation":"荼：苦菜；茹：吃。比喻历尽辛苦。","source":{"text":"不肖自罹大敌，求归未得，含荼茹毒，蒙垢忍辱，须发磻然，已具有足老状矣。","book":"明·张居正《答松谷陈相公书》"},"usage":"作谓语、宾语；用于比喻句"},{"id":11540,"word":"含菁咀华","pinyin":"hán jīng jǔ huá","abbr":"hjjh","explanation":"比喻读书吸取其精华。同“含英咀华”。","source":{"text":"今世学者，含菁咀华，选词吐艳，盖人人能矣。","book":"明·张居正《赠吴霁翁督学山东序》"},"similar":["含英咀华"],"usage":"作谓语、定语；用于文章等"},{"id":11541,"word":"含蓼问疾","pinyin":"hán liǎo wèn jí","abbr":"hlwj","explanation":"蓼：一种苦味水草。不顾辛苦，慰问疾病。旧时比喻君主安抚军民，跟百姓同甘共苦。","source":{"text":"观其所以结物情者，岂徒投醪抚寒，含蓼问疾而已哉？","book":"《三国志·蜀书·先主传》裴松之注引习凿齿文"},"usage":"作谓语、定语；指君主跟百姓同甘共苦","story":["春秋时期，吴王夫差打败了越王勾践，囚禁了他三年时间，后来放他回国。越王勾践为了复仇，对内不顾辛苦，卧薪尝胆，夜以继日地拼命工作，眼睛疲倦了就口含辛辣的蓼草；对外慰问百姓的疾病，抚慰百姓，终于使国家强大并消灭吴国"]},{"id":11542,"word":"含血吮疮","pinyin":"hán xuè shǔn chuāng","abbr":"hxsc","explanation":"吮：用嘴吸。用嘴把病人疮里的脓血吸出来。旧时形容将领关怀、爱护自己手下的士兵。","source":{"text":"卒有病疽者，起为吮之。","book":"《史记·孙子吴起列传》"},"example":{"text":"～抚战士，思摩奋呼乞效死。","book":"唐·白居易《七德舞》"},"usage":"作谓语、定语；用于比喻句"},{"id":11543,"word":"含血喷人","pinyin":"hán xuè pēn rén","abbr":"hxpr","explanation":"比喻捏造事实陷害别人。","source":{"text":"含血喷人，先污其口；百丈野狐，失头狂走。","book":"宋·晓莹《罗湖野录》卷二"},"example":{"text":"况且没有把柄的事，给一个低三下四的奴才，～，自己倒站着听风凉话儿！","book":"清·曾朴《孽海花》第十八回"},"similar":["恶语中伤","血口喷人","含沙射影"],"usage":"作主语、谓语、定语；指诬陷好人"},{"id":11544,"word":"含血噀人","pinyin":"hán xuè xùn rén","abbr":"hxxr","explanation":"噀，喷。比喻捏造事实陷害别人。同“含血喷人”。","source":{"text":"含血噀人，先污其口。百丈野狐，失头狂走。蓦地唤回，打个筋斗。","book":"《五灯会元·黄龙新禅师法嗣·崇觉空禅师》"},"similar":["含血喷人"],"usage":"作谓语、定语；指诬陷好人"},{"id":11545,"word":"含血潠人","pinyin":"hán xuè xùn rén","abbr":"hxxr","explanation":"比喻捏造事实陷害别人。同“含血喷人”。"},{"id":11546,"word":"含辛忍苦","pinyin":"hán xīn rěn kǔ","abbr":"hxrk","explanation":"形容忍受辛苦或吃尽辛苦。同“含辛茹苦”。","source":{"text":"至于商家，连疑心也不当人子，只好含辛忍苦，自己懊悔怨怅，没个处法。","book":"《二刻拍案惊奇》卷二十"},"similar":["含辛茹苦"],"usage":"作谓语、定语、状语；比喻忍受千辛万苦"},{"id":11547,"word":"含辛茹苦","pinyin":"hán xīn rú kǔ","abbr":"hxrk","explanation":"辛：辣；茹：吃。形容忍受辛苦或吃尽辛苦。","source":{"text":"无所不至，茹苦含辛，更百千万亿生而后成。","book":"宋·苏轼《中和胜相院记》"},"example":{"text":"他想起母亲十多年来～的生活所指望者，就是他，然而现在她将不再看见他的儿子了。","book":"茅盾《一个女性》"},"similar":["饱经风霜","千辛万苦"],"opposite":["无忧无虑","养尊处优"],"usage":"作谓语、定语、状语；比喻忍受千辛万苦"},{"id":11548,"word":"含霜履雪","pinyin":"hán shuāng lǚ xuě","abbr":"hslx","explanation":"比喻品行高洁。","source":{"text":"含霜履雪，义不苟合；据道推方，嶷然不群。","book":"晋·葛洪《抱朴子·汉过》"},"usage":"作谓语、定语；用于比喻句"},{"id":11549,"word":"含饴弄孙","pinyin":"hán yí nòng sūn","abbr":"hyns","explanation":"饴：麦芽糖。含着糖逗小孙子玩。形容晚年生活的乐趣。","source":{"text":"吾但当含饴弄孙，不能复知政事。","book":"《后汉书·明德马皇后纪》"},"example":{"text":"佳儿佳妇，吾将～，不复理家政矣。","book":"清·淮阴百一居士《壶天录》"},"similar":["天伦之乐","饴含抱孙"],"usage":"作谓语、定语；用于书面语"},{"id":11550,"word":"含齿戴发","pinyin":"hán chǐ dài fā","abbr":"hcdf","explanation":"口中有齿，头上长发。指人类。","source":{"text":"遂乃擅废太后，离隔二宫，拷掠胡定，诬王行毒，含齿戴发，莫不悲惋。","book":"《魏书·韩子熙传》"},"example":{"text":"固宜～之伦，生死沐浴于覆焘之下，未有能喧者也。","book":"清·王夫之《绎思》"},"similar":["戴发含齿"],"usage":"作谓语、定语；指人类"},{"id":11551,"word":"听之任之","pinyin":"tīng zhī rèn zhī","abbr":"tzrz","explanation":"听、任：随，任凭；之：代词，代人或事物。任凭事物存在发展而不去过问。","source":{"text":"见损害群众利益的行为不愤恨，不劝告，不制止，不解释，听之任之，这是第八种。","book":"毛泽东《反对自由主义》"},"example":{"text":"除了儿子有时乘机劝说几句，一般～。","book":"沙汀《青棡坡》"},"similar":["听其自然","听天由命"],"opposite":["因势利导"],"usage":"作谓语、宾语、定语；用于人或事物"},{"id":11552,"word":"听人穿鼻","pinyin":"tīng rén chuān bí","abbr":"trcb","explanation":"听：任凭；穿鼻：牛鼻子穿桊。比喻听凭别人摆布。","source":{"text":"徐孝嗣才非柱石，听人穿鼻。","book":"《南史·张弘策传》"},"example":{"text":"梁主不达时机，～。","book":"《旧五代史·梁书·末帝纪上》"},"similar":["任人摆布"],"usage":"作谓语、定语；指任人摆布","story":["公元493年，南朝齐武帝死后，萧昭业继位，吏部尚书徐孝嗣辅佐执政。西昌侯萧鸾密谋要篡位，就密告徐孝嗣。徐孝嗣没有反对，两人联合勒死萧昭业，篡位成功。张弘策评论徐孝嗣像在鼻子穿上绳的牛一样，听人牵引"]},{"id":11553,"word":"听其自便","pinyin":"tīng qí zì biàn","abbr":"tqzb","explanation":"听凭其任意行动。","source":{"text":"中国出洋之民数百万，粤人以佣工为较多，其俗虽贱视之，尚能听其自便，衣食之外，颇积馀财。","book":"清·薛福成《请豁除旧禁招徕华民疏》"},"example":{"text":"球迷只要不到犯法，～。这就叫民主。"},"similar":["听其自然","听其自流"],"usage":"作谓语、宾语；表示不干涉"},{"id":11554,"word":"听其自流","pinyin":"tīng qí zì liú","abbr":"tqzl","explanation":"指不加约束、引导，听任自由发展。","source":{"text":"听其自流，待其自生，则鲧禹之功不立，而后稷之智不用。","book":"《淮南子·修务训》"},"similar":["听其自便","听其自然"],"usage":"作谓语、宾语；表示不干涉"},{"id":11555,"word":"听其自然","pinyin":"tīng qí zì rán","abbr":"tqzr","explanation":"听：任凭。听任它自然发展，不去过问。","source":{"text":"王玉辉也不懊悔，听其自然，每日在牛公庵看书。","book":"清·吴敬梓《儒林外史》第四十八回"},"example":{"text":"清·吴敬梓《儒林外史》第四十八回：“王玉辉也不懊悔，听其自然，每日在牛公庵看书。”"},"similar":["听之任之","听天由命"],"opposite":["因势利导"],"usage":"作谓语、宾语；表示不干涉"},{"id":11556,"word":"听其言而观其行","pinyin":"tīng qí yán ér guān qí xíng","abbr":"tqyegqx","explanation":"听了他的话，还要看他的行动。指不要只听言论，还要看实际行动。","source":{"text":"始吾于人也，听其言而信其行，今吾于人也，听其言而观其行。","book":"春秋·鲁·孔丘《论语·公冶长》"},"example":{"text":"自以为举世可欺，～，殊不知肺肝如见。","book":"蔡东藩《民国通俗演义》第131回"},"similar":["听其言观其行"],"usage":"作宾语、分句；指不要只听言论","story":["春秋时期，孔子带领弟子们周游列国，从陈国逃往蔡国后，也没得到蔡君的重用，常发“饱食终日，无所用心”的感慨，一天发现弟子宰予中午还在睡大觉，气得说宰予是朽木不可雕，弟子们赶紧来安慰孔子，孔子说今后听其言而观其行，好自为之"]},{"id":11557,"word":"听其言观其行","pinyin":"tīng qí yán guān qí xíng","abbr":"tqygqx","explanation":"听一个人说什么，又看他做什么。","source":{"text":"自以为举世可欺，听其言而观其行，殊不知肺肝如见。","book":"蔡东藩《民国通俗演义》第131回"},"example":{"text":"我们～，看她有什么动作。"},"similar":["听言观行","听其言而观其行"],"usage":"作谓语、定语；指等待行动"},{"id":11558,"word":"听命由天","pinyin":"tīng mìng yóu tiān","abbr":"tmyt","explanation":"听：任凭；由：顺随。听任事态自然发展变化，不做主观努力。","source":{"text":"不，莫管我，且听命由天。","book":"郑振铎《桂公塘》"},"example":{"text":"郑振铎《桂公塘》：“不，莫管我，且～。”"},"similar":["听天由命","听天任命"],"usage":"作谓语、定语、宾语；指不做主观努力"},{"id":11559,"word":"听天任命","pinyin":"tīng tiān rèn mìng","abbr":"ttrm","explanation":"天：天意；命：命运。听凭命运的摆布，不作主观努力。","source":{"text":"听天任命，慎厥所修。","book":"《孔丛子·鹗赋》"},"example":{"text":"清·文康《儿女英雄传》第一回：“老爷又是位循规蹈矩，～，不肯苟且的人，只得呈报销假投供。”"},"similar":["听天由命","听命由天","听天委命"],"usage":"作谓语、定语、宾语；指不做主观努力"},{"id":11560,"word":"听天委命","pinyin":"tīng tiān wěi mìng","abbr":"ttwm","explanation":"听凭命运的摆布，不作主观努力。同“听天任命”。","source":{"text":"我们学道之人听天委命，不可怕死。","book":"明·屠隆《彩毫记·汾阳报恩》"},"similar":["听天由命","听天任命","听天安命"],"usage":"作谓语、定语、宾语；指不做主观努力"},{"id":11561,"word":"听天安命","pinyin":"tīng tiān ān mìng","abbr":"ttam","explanation":"听任事态自然发展变化，该怎么样就怎么样。同“听天由命”。","source":{"text":"也说不上满意，这不过是听天安命罢了。","book":"巴金《秋》四"},"similar":["听天由命","听天任命","听命由天"],"usage":"作谓语、定语、宾语；指不做主观努力"},{"id":11562,"word":"听天由命","pinyin":"tīng tiān yóu mìng","abbr":"ttym","explanation":"由：听从，随顺。听任事态自然发展变化，不做主观努力。也比喻碰机会，该怎么样就怎么样。","source":{"text":"死活存亡，听天由命去罢。","book":"清·刘鹗《老残游记续集》第二回"},"example":{"text":"我们应当与命运抗争，而不应～地生活。"},"similar":["听其自然","听之任之"],"opposite":["改天换地"],"usage":"连动式；作谓语、定语、宾语；含贬义"},{"id":11563,"word":"听微决疑","pinyin":"tīng wēi jué yí","abbr":"twjy","explanation":"注意细微的情节，解决疑难的问题。形容思想缜密，善于通过听察解决疑难。","source":{"text":"圣王者有听微决疑之道，能屏谗权实。","book":"《鹖冠子·天则》"},"example":{"text":"公以臣能～，故使为理。","book":"《史记·循吏列传》第五十九"},"usage":"作谓语、定语；用于书面语"},{"id":11564,"word":"听而不闻","pinyin":"tīng ér bú wén","abbr":"tebw","explanation":"闻：听。听了跟没听到一样。形容不关心，不在意。","source":{"text":"心不在焉，视而不见，听而不闻，食而不知其味。","book":"《老子》第十四章：“听之不闻名曰希。”《礼记·大学》"},"example":{"text":"就只再芳芳姐姐一心只想学课，只怕是～。","book":"清·李汝珍《镜花缘》第九十回"},"similar":["视而不见","漠不关心"],"usage":"作谓语、定语；指漠不关心"},{"id":11565,"word":"听而无闻，视而无见","pinyin":"tīng ér wú wén，shì ér wú jiàn","abbr":"tewwsewj","explanation":"视：看。指不注意，不重视，睁着眼却没看见。也指不理睬，看见了当作没看见，听到了当作没听见。","source":{"text":"知无道，上乱天文，下灭地理，中绝人和，治渐终始，故听而无闻，视而无见，白昼而暗，有义而失谥。","book":"《鹖冠子·度万八》"},"similar":["视而不见，听而不闻"],"usage":"作谓语、定语、宾语；用于处事"},{"id":11566,"word":"听聪视明","pinyin":"tīng cōng shì míng","abbr":"tcsm","explanation":"听：听觉；聪：灵敏；视：视觉；明：清楚。听得清，看得明。形容对事物有清楚而正确的认识。","source":{"text":"听聪而视明，公正而敦大。","book":"唐·韩愈《释言》"},"example":{"text":"～，法式生知。并包蓄养，解愠弦挥。","book":"《清史稿·乐志七》"}},{"id":11567,"word":"听见风就是雨","pinyin":"tīng jiàn fēng jiù shì yǔ","abbr":"tjfjsy","explanation":"刚听到一点儿风声，就当要下雨了。形容听到一点风声就竭力附和渲染。","source":{"text":"他们做都老爷的，听见风就是雨，皇上原许他风闻奏事，说错了又没有不是的。","book":"清·李宝嘉《官场现形记》第25回"},"example":{"text":"她这种～的人不值得信任。"},"similar":["见风是雨"],"usage":"作谓语、定语；指轻信而夸大事实"},{"id":11568,"word":"听谗惑乱","pinyin":"tīng chán huò luàn","abbr":"tchl","explanation":"谗：谗言，挑拨离间的话。形容专门听别人的挑拔，最后把自己也搞糊涂了。","source":{"text":"绍听谗惑乱，公浸润不行，此明胜也。","book":"明·罗贯中《三国演义》第十八回"}},{"id":11569,"word":"听风听水","pinyin":"tīng fēng tīng shuǐ","abbr":"tfts","explanation":"形容善于赏玩自然景色。","source":{"text":"弟子部中留一色，听风听水作《霓裳》。","book":"相传龟兹国王与乐人于大山间倾听风和水声，感兴而制乐。唐·王建《霓裳辞》之一"},"example":{"text":"《霓裳曲》，前世传记论说颇详，不知～为何事也。白乐天有《霓裳歌》甚详，亦无风水之说，第记之，或有遗亡者尔。","book":"宋·欧阳修《六一诗话》"},"usage":"作宾语、定语；用于书面语"},{"id":11570,"word":"听风就是雨","pinyin":"tīng fēng jiù shì yǔ","abbr":"tfjsy","explanation":"比喻听到一点点不确切的消息就信以为真。","source":{"text":"得不的风儿，就是雨儿。","book":"明·兰陵笑笑生《金瓶梅词话》第四十二回"}},{"id":11571,"word":"吮墨舐毫","pinyin":"shǔn mò shì háo","abbr":"smsh","explanation":"吮墨：以口吮吸毛笔上的墨；舐毫：以舌舔毛笔的笔尖。指写诗作文或绘画等。","source":{"text":"善图山水，酒酣，或击鼓吹笛，舐笔辄成。","book":"唐·李商隐《太尉公会昌一品制集序》：“吮墨摛词，咏日月之光华。”《旧唐书·张志和传》"},"example":{"text":"笔墨业也只好主张～，以免国粹渐就沦丧。","book":"鲁迅《且介亭杂文二编·论毛笔之类》"}},{"id":11572,"word":"吮毫搦管","pinyin":"shǔn háo nuò guǎn","abbr":"shng","explanation":"搦：持、拿；管：指毛笔。磨好墨汁，把毛笔沾湿。常指写文章构思、动笔的神态。","source":{"text":"吮墨摛词，咏日月之光华。","book":"南朝·陈·周弘让《答王裒书》：“犹冀苍雁赪鲤，时传尺素，清风朗月，但寄相思，搦管操觚，声泪俱咽。”唐·李商隐《太尉公会昌一品制集序》"}},{"id":11573,"word":"吮疽舐痔","pinyin":"shǔn jū shì zhì","abbr":"sjsz","explanation":"见“吮痈舐痔”。谓以口吸痈疽，以舌舔痔疮而祛其毒。后形容卑屈媚上的龌龊行为。","source":{"text":"文帝尝病痈，邓通常为帝唶吮之。","book":"西汉·司马迁《史记·佞幸列传》"},"example":{"text":"苟于进取以速利禄，～无所不为者，非伥鬼欤？","book":"宋·苏轼《渔憔闲话录》下篇"},"similar":["吮痈舐痔","吮痈噬痔"],"usage":"作谓语、定语；指卑劣地奉承人"},{"id":11574,"word":"吮痈噬痔","pinyin":"shǔn yōng shì zhì","abbr":"sysz","explanation":"吮：用嘴吸；痈：毒疮；噬：咬。指用口舌为人舔吸疮痔上的脓血。比喻卑劣地奉承人。","source":{"text":"他们把那瓣香祖传来的奴颜婢膝的面孔，吮痈噬痔的长技，向来在本国有权力的人里头用熟的，近来都用在外国人身上了。","book":"《新中国未来记》第三回"},"similar":["吮痈舐痔","吮疽舐痔"],"usage":"作谓语、定语；指卑劣地奉承人"},{"id":11575,"word":"吮痈舐痔","pinyin":"shǔn yōng shì zhì","abbr":"sysz","explanation":"吮：聚拢嘴唇来吸；痈：毒疮；舐：舔。只为人舔吸疮痔上的脓血。比喻卑劣地奉承人。","source":{"text":"秦王有病召医，破痈溃座者得车一乘；舐痔者得车五乘。所治愈下，得车愈多。","book":"《庄子·列御寇》"},"example":{"text":"附势趁权，不辞～；市恩固宠，那知沥胆披肝。","book":"明·无名氏《鸣凤记·严嵩庆寿》"},"similar":["阿谀奉承","曲意逢迎","吮疽舐痔"],"opposite":["刚正不阿"],"usage":"作谓语、定语；指卑劣地奉承人","story":["战国时期，宋偃王派曹商出使秦国，曹商能说会道，深得秦惠王的宠信，秦惠王特意赏赐他100辆马车。曹商回国后对庄子炫耀，庄子看不惯他的所作所为，说：“秦王对那些帮助他吮痈舐痔的人都可以赏赐马车，越脏的地方给的车越多。”"]},{"id":11576,"word":"吮血劘牙","pinyin":"shǔn xuè mó yá","abbr":"sxmy","explanation":"吮：吸吮；劘：削，切。形容凶狠残暴地肆虐。","source":{"text":"磨牙吮血，杀人如麻。","book":"唐·李白《蜀道难》诗"},"example":{"text":"～，习为故智。","book":"清·侯方域《代司徒公屯田奏议》"}},{"id":11577,"word":"启宠纳侮","pinyin":"qǐ chǒng nà wǔ","abbr":"qcnw","explanation":"指开宠端而招致侮慢。","source":{"text":"启宠纳侮，其此之谓也。","book":"春秋·鲁·左丘明《左传·定公元年》"},"usage":"作谓语；用于劝诫人"},{"id":11578,"word":"启瞶振聋","pinyin":"qǐ guì zhèn lóng","abbr":"qgzl","explanation":"比喻唤醒糊涂与麻木不仁者。"},{"id":11579,"word":"启羞兴戎","pinyin":"qǐ xiū xīng róng","abbr":"qxxr","explanation":"启：开；戎：战争。因说话不谨慎而招致羞辱挑起事端。","source":{"text":"惟口终日无所事事，或大言不惭，或空谈无补；甚或启羞兴戎，为全体之累。","book":"清·吴趼人《俏皮话·手足》"},"usage":"作谓语、宾语；用于好事人等"},{"id":11580,"word":"启聩振聋","pinyin":"qǐ kuì zhèn lóng","abbr":"qkzl","explanation":"聩：耳聋。使耳聋的人都受到振动和醒悟。比喻用语言文字唤醒糊涂麻木的人，指力量强大。","source":{"text":"居德善俗，启聩振聋，儒者之效，匪徒言说。","book":"清·邓显鹤《邹君墓志铭》"},"example":{"text":"作为新闻工作者必须要做～的工作。"},"similar":["振聋发聩","振聋启聩"],"usage":"作谓语、定语；指力量大"},{"id":11581,"word":"吱哩哇啦","pinyin":"zhī lī wā lā","abbr":"zlwl","explanation":"象声词。形容大声说话。","source":{"text":"门关住，吵架呢；吱哩哇啦打娃呢。","book":"卢跃刚《大国寡民》"}},{"id":11582,"word":"吴下阿蒙","pinyin":"wú xià ā méng","abbr":"wxam","explanation":"吴下：现江苏长江以南；阿蒙：指吕蒙。居处吴下一隅的吕蒙。比喻人学识尚浅。","source":{"text":"吾谓大弟但有武略耳，至于今者，学识英博，非复吴下阿蒙。","book":"《三国志·吴书·吕蒙传》裴松之注引《江表传》"},"example":{"text":"马湾有鬣，德小是崇，先生天游，而人曰佳墉。嗟乎！非～。","book":"明·徐宏祖《徐霞客游记·续篇》"},"usage":"作宾语；指人学识尚浅","story":["三国时期，东吴能武不能文的武将吕蒙听了孙权的劝告后，发奋读书。一段时间后，都督鲁肃来视察吕蒙的防地。吕蒙就对蜀防备的事情讲得有条有理，还写份建议书给鲁肃，鲁肃很惊讶地说道：“你再也不是从前吴下的那个阿蒙了。”"]},{"id":11583,"word":"吴头楚尾","pinyin":"wú tóu chǔ wěi","abbr":"wtcw","explanation":"今江西北部，春秋时是吴、楚两国交界的地方，它处于吴地长江的上游，楚地长江的下游，好像首尾互相衔接。","source":{"text":"《职方乘序》：‘吴头楚尾。’","book":"宋·王象之《舆地纪胜》"},"example":{"text":"～路如何？","book":"清·王士慎《江上》诗"},"similar":["楚尾吴头"],"usage":"作宾语；指江西一带"},{"id":11584,"word":"吴市之箫","pinyin":"wú shì zhī xiāo","abbr":"wszx","explanation":"比喻在街头行乞。同“吴市吹箫”。","source":{"text":"沉冤望雪，曾传吴市之箫；急难号天，爱下秦庭之泪。","book":"清·杨昭《跋》"},"similar":["吴市吹箫"],"usage":"作宾语、定语；用于书面语"},{"id":11585,"word":"吴市吹箫","pinyin":"wú shì chuī xiāo","abbr":"wscx","explanation":"吴：古国名。原指春秋时楚国的伍子胥逃至吴国，在市上吹箫乞食。比喻在街头行乞。","source":{"text":"伍子胥橐载而出昭关，夜行昼伏，至于陵水，无以糊其口，膝行蒲伏，稽首肉袒，鼓腹吹箫，乞食于吴市。","book":"《史记·范睢蔡泽列传》"},"similar":["吴市之箫"],"usage":"作谓语、定语；指在街头行乞","story":["春秋时期，费无极怂恿楚平王占有太子毕建的新娘，设计要害死太子毕建及他的老师伍奢全家，派儿子费得雄去樊城诱骗伍员回京受诛。伍子胥得到的消息，就逃出楚国，到吴国的街市上靠吹箫乞讨为生，后被人发现推荐去辅佐吴王攻楚"]},{"id":11586,"word":"吴带当风","pinyin":"wú dài dāng fēng","abbr":"wddf","explanation":"唐画家吴道子善画佛像，笔势圆转，所画衣带如被风吹拂。后人以之称美其高超画技与飘逸的风格。","source":{"text":"吴带当风，曹衣出水。","book":"宋·郭若虚《图画见闻志·论曹吴体法》"},"example":{"text":"苏曼殊《断鸿零雁记》第15章：“风采盎然，碧罗为衣，颇得‘～’之致。”"},"usage":"作宾语、定语；用于书面语"},{"id":11587,"word":"吴牛喘月","pinyin":"wú niú chuǎn yuè","abbr":"wncy","explanation":"吴牛：指产于江淮间的水牛。吴地水牛见月疑是日，因惧怕酷热而不断喘气。比喻因疑心而害怕。","source":{"text":"吴牛望见月则喘，彼之苦于日，见月怖喘矣。","book":"南朝宋·刘义庆《世说新语·言语》：“臣犹见牛，见月而喘。”《太平御览》卷四引《风俗通》"},"example":{"text":"～时，拖船一何苦。","book":"唐·李白《丁都护歌》"},"similar":["喘月吴牛"],"usage":"作宾语、定语；指因疑心而害怕","story":["晋武帝对吏部侍郎满奋特别器重，经常召见他。晋武帝故意装一扇透明的屏风让畏寒的满奋坐在附近，满奋以为空屏风不能挡风不敢上前，见到是透明屏风后自我解嘲说：“臣简直就像吴地的水牛，夜里见到月亮也怕得直喘气。”"]},{"id":11588,"word":"吴越同舟","pinyin":"wú yuè tóng zhōu","abbr":"wytz","explanation":"吴越：指吴国人和越国人。比喻团结互助，同心协力，战胜困难。","source":{"text":"夫吴人与越人相恶也，当其同舟而济，遇风，其相救也，如左右手。","book":"春秋·齐·孙武《孙子·九地》"},"example":{"text":"我们要学～，一致抗日。"},"similar":["同舟共济"],"opposite":["勾心斗角"],"usage":"作宾语、定语；指共患难","story":["春秋时期，吴国和越国经常交战，一天在船上有十几个吴人和越人，双方谁也不搭理谁，气氛显得十分沉闷。船到江心，天色突变，船帆拉不下来，十分危险。不管是吴人还是越人齐心协力去解绳索，顺利地解下船帆，渡过了这个难关"]},{"id":11589,"word":"吵吵闹闹","pinyin":"chǎo chǎo nào nào","abbr":"ccnn","explanation":"故意发出各种争吵声的情况。","source":{"text":"若是那些小人知道，来这门首吵吵闹闹，却怎么了？","book":"清·褚人获《隋唐演义》第23回"},"example":{"text":"路遥《平凡的世界》第一卷第九章：“大人娃娃夹在一起，有站的，有坐的，～，像一锅煮沸了的水。”"},"similar":["热热闹闹"],"opposite":["安安静静"],"usage":"作谓语、定语；用于环境等"},{"id":11590,"word":"吸新吐故","pinyin":"xī xīn tǔ gù","abbr":"xxtg","explanation":"吸进新气，吐出浊气。","source":{"text":"吸新吐故以练臧，专意积精以适神，于以养生，岂不长哉！","book":"汉·王吉《谏昌邑王疏》"},"similar":["纳新吐故","吐故纳新"],"usage":"作谓语、宾语；指新陈代谢"},{"id":11591,"word":"吸血鬼","pinyin":"xī xuè guǐ","abbr":"xxg","explanation":"榨取他人血汗、劫取他人钱财、思想或者其他资源的人。","example":{"text":"资本家不再被认为是～。"},"usage":"作宾语、定语；用于比喻句"},{"id":11592,"word":"吸风饮露","pinyin":"xī fēnɡ yǐn lù","abbr":"xfyl","explanation":"道家及诗文中常用以指神仙的绝食五谷。","source":{"text":"藐姑射之山，有神人居焉。……不食五谷，吸风饮露。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"好像他们的一群倒是～，带了自己的家私来给社会服务的志士。","book":"鲁迅《后记》"},"similar":["餐风饮露"],"usage":"作谓语、定语；比喻不吃饭"},{"id":11593,"word":"吹叶嚼蕊","pinyin":"chuī yè jiáo ruǐ","abbr":"cyjr","explanation":"指吹奏、歌唱。","source":{"text":"柳枝，洛中里娘也……吹叶嚼蕊，调丝擫管，作天海风涛之曲，幽忆怨断之音。","book":"唐·李商隐《柳枝》诗序"},"similar":["吹花嚼蕊"],"usage":"作宾语、定语；用于弹琴等"},{"id":11594,"word":"吹吹打打","pinyin":"chuī chuī dǎ dǎ","abbr":"ccdd","explanation":"指各种乐器的合奏。也用以形容故意渲染某种言行或事物，吸引别人注意。","source":{"text":"忙忙与女儿说知，叫老妈央人相帮打点。早鼓乐吹吹打打，迎人村来了。","book":"明·天然智叟《石头点·郭挺之榜前认子》"},"example":{"text":"俺倒去～伏待著他听。","book":"清·孔尚任《桃花扇·听稗》"},"similar":["敲锣打鼓"],"usage":"作宾语；指故意渲染"},{"id":11595,"word":"吹吹拍拍","pinyin":"chuī chuī pāi pāi","abbr":"ccpp","explanation":"阿谀逢迎，过分称颂、赞许。","source":{"text":"反而觉得那些拉拉扯扯、吹吹拍拍的人对他很好，对他有温暖，而这种东西就是一种腐蚀剂。","book":"邓小平《骄傲自满是团结的大敌》"},"example":{"text":"除了～，他没别的能耐。"},"similar":["阿谀逢迎","吹牛拍马"],"opposite":["刚正不阿"],"usage":"作谓语、定语、宾语；指阿谀逢迎"},{"id":11596,"word":"吹唇唱吼","pinyin":"chuī chún chàng hǒu","abbr":"ccch","explanation":"形容喧闹喊叫。","source":{"text":"丑徒数万，同共吹唇唱吼而上。","book":"《南史·侯景传》"},"similar":["大吵大闹"],"usage":"作谓语、宾语；形容喧闹喊叫"},{"id":11597,"word":"吹唇沸地","pinyin":"chuī chún fèi dì","abbr":"ccfd","explanation":"吹口气就能使大地沸腾起来。形容威势极大。","source":{"text":"彭城王勰等三十六军前后相继，众号百万，吹唇沸地。","book":"《资治通鉴·齐明帝建武四年》"},"example":{"text":"～势纵横，约束人称峡路兵。","book":"清·查慎行《黔阳杂诗四首》"}},{"id":11598,"word":"吹垢索瘢","pinyin":"chuī gòu suǒ bān","abbr":"cgsb","explanation":"犹言吹毛求疵。","source":{"text":"石州此谱为二百年来仅有之作，余非敢咱们垢索瘢，正以其大体既醇，更愿为去微瑕以归粹美耳。","book":"清·叶适琯《吹网录·亭林年谱有沿误处》"},"similar":["吹毛求疵"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11599,"word":"吹埙吹箎","pinyin":"chuī xūn chuī chí","abbr":"cxcc","explanation":"埙、箎：古时的两种乐器。埙和箎两种乐器合奏起来，声音和谐。用于赞美兄弟之间感情和睦融洽。","source":{"text":"伯氏吹埙，仲氏吹箎。","book":"《诗经·小雅·何人斯》"}},{"id":11600,"word":"吹大法螺","pinyin":"chuī dà fǎ luó","abbr":"cdfl","explanation":"法螺：做佛事时用的乐器。原比喻佛之说法广被大众。后借以讽刺吹牛皮，说大话。","source":{"text":"今佛世尊欲说大法，雨大法雨，吹大法螺，击大法鼓，演大法义。","book":"《妙法莲花经·序品》"},"example":{"text":"他最爱～。"},"similar":["吹牛皮"],"usage":"作谓语、宾语；指说大话"},{"id":11601,"word":"吹弹得破","pinyin":"chuī tán dé pò","abbr":"ctdp","explanation":"好像吹一吹、弹一弹就会弄破似的。形容面部的皮肤非常细嫩。","source":{"text":"观俺姐姐这个脸儿吹弹得破，张生有福也呵。","book":"元·王实甫《西厢记·崔莺莺夜听琴杂剧》"},"example":{"text":"果然白雪团儿脸，泛出桃花瓣颜色，真乃～。","book":"清·李绿园《歧路灯》第七十七回"},"usage":"作谓语、状语；形容面部的皮肤非常细嫩"},{"id":11602,"word":"吹弹歌舞","pinyin":"chuī tán gē wǔ","abbr":"ctgw","explanation":"演奏管弦乐器，唱歌跳舞。泛指音乐舞蹈娱乐活动。","source":{"text":"居士，如今那高楼上吹弹歌舞，饮酒欢娱，敢管待那士大夫哩。","book":"元·无名氏《来生债》第二折"},"example":{"text":"这人～，刺枪使棒，相扑玩耍，颇能诗书词赋。","book":"清·陈忱《水浒后传》第二回"},"usage":"作主语、宾语；指音乐舞蹈娱乐活动"},{"id":11603,"word":"吹影镂尘","pinyin":"chuī yǐng lòu chén","abbr":"cylc","explanation":"镂：雕刻。吹影子，刻尘土。比喻工艺精细到不见形迹。","source":{"text":"言之如吹影，思之如镂尘，圣智造迷，鬼神不识。","book":"《关尹子·一宇》"},"similar":["徒劳无功"],"usage":"作谓语；比喻不见形迹"},{"id":11604,"word":"吹毛利刃","pinyin":"chuī máo lì rèn","abbr":"cmlr","explanation":"将毛、发置于刀或剑刃上，用力一吹即可削断毛发。形容刀剑极为锋利。","example":{"text":"许多武侠小说常以吹毛利刃和削铁如泥，来形容兵器的锋利。"}},{"id":11605,"word":"吹毛取瑕","pinyin":"chuī máo qǔ xiá","abbr":"cmqx","explanation":"瑕：玉上的疵点，缺点，毛病。吹开皮上的毛，寻找里面的毛病。比喻故意挑剔别人的毛病、缺点，寻找差错。","source":{"text":"是以世人为文，竞于诋呵，吹毛取瑕，次骨为戾。","book":"南朝·宋·刘义庆《文心雕龙·奏启》"},"similar":["吹毛求瑕","吹毛求瘢"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11606,"word":"吹毛数睫","pinyin":"chuī máo shù jié","abbr":"cmsj","explanation":"比喻目光短浅，只注意微末细节。","source":{"text":"《明史·黄道周传》；“自古迄今，决无数米量薪，可成远大之猷；吹毛数睫，可奏三五之治者。”"},"usage":"作宾语、定语；用于处事"},{"id":11607,"word":"吹毛求瑕","pinyin":"chuī máo qiú xiá","abbr":"cmqx","explanation":"吹开皮上的毛寻疤痕。比喻故意挑剔别人的缺点，寻找差错。","source":{"text":"擿抉细微，吹毛求瑕。","book":"《三国志·吴志·步骘传》"},"example":{"text":"今员外～，务在驳放。","book":"唐·封演《封氏闻见记·制科》"},"similar":["吹毛求疵"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11608,"word":"吹毛求疵","pinyin":"chuī máo qiú cī","abbr":"cmqc","explanation":"求：找寻；疵：毛病。吹开皮上的毛寻疤痕。比喻故意挑剔别人的缺点，寻找差错。","source":{"text":"不吹毛而求小疵，不洗垢而察之难。","book":"《韩非子·大体》"},"example":{"text":"若～，天下人安得全无过失者？","book":"清·阮葵生《茶余客话》卷一"},"similar":["洗垢求瘢","无中生有"],"opposite":["宽大为怀","宽宏大量","通情达理"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11609,"word":"吹毛求瘢","pinyin":"chuī máo qiú bān","abbr":"cmqb","explanation":"求：寻找；瘢：疤痕。吹开皮上的毛，寻找里面的毛病。比喻故意挑剔别人的毛病、缺点，寻找差错。","source":{"text":"凡遇院中公牍，送府用印，孔辄吹毛求瘢，见有瑕疵可指，当即驳还。","book":"蔡东藩《民国通俗演义》第79回"},"similar":["吹毛索瘢"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11610,"word":"吹毛洗垢","pinyin":"chuī máo xǐ gòu","abbr":"cmxg","explanation":"吹开皮上的毛而洗去所藏的污垢。比喻一意寻找他人的过失或缺点。","source":{"text":"游道禀性遒悍，是非肆口，吹毛洗垢，疮疵人物。","book":"《北齐书·酷吏传·宋游道》"},"example":{"text":"逐臣～，自知积罪如山；学士排难解纷，反使措颜无地。","book":"明·陈汝元《金莲记·释愤》"},"similar":["吹毛索垢"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11611,"word":"吹毛索垢","pinyin":"chuī máo suǒ gòu","abbr":"cmsg","explanation":"吹开皮上的毛寻疤痕。比喻故意挑剔别人的缺点，寻找差错。","source":{"text":"一入此局，即为后世之人吹毛索垢。","book":"清·顾炎武《记与孝感熊先生语》"},"similar":["吹毛索疵","吹毛洗垢"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11612,"word":"吹毛索疵","pinyin":"chuī máo suǒ cī","abbr":"cmsc","explanation":"吹开皮上的毛寻疤痕。比喻故意挑剔别人的缺点，寻找差错。","source":{"text":"及至其后，渐以滋章，吹毛索疵，诋欺无限。","book":"《后汉书·杜林传》"},"similar":["吹毛索瘢","吹毛索垢"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11613,"word":"吹毛索瘢","pinyin":"chuī máo suǒ bān","abbr":"cmsb","explanation":"吹开皮上的毛寻疤痕。比喻故意挑剔别人的缺点，寻找差错。","source":{"text":"田（田文镱）以为讪己，愈恶之，每见嗔喝，吹毛索瘢。","book":"清·邹弢《三借庐笔谈·杨文乾》"},"similar":["吹毛索疵","吹毛求疵"],"usage":"作谓语、定语、宾语；用于指故意挑剔"},{"id":11614,"word":"吹气如兰","pinyin":"chuī qì rú lán","abbr":"cqrl","explanation":"气息象兰花那样香。形容美女的呼吸。也用于形容文词华美。","source":{"text":"个侬吹气如兰，奉身如玉。","book":"清·陈裴之《汀烟小录·闰湘居士序》"},"example":{"text":"彭羡门惊才绝艳，词家推为独步。王阮亭称其～，每当十郎，辄自愧伧父。","book":"清·王晫《今世说·企羡》"},"similar":["吹气胜兰"],"usage":"作谓语、定语；用于文辞等"},{"id":11615,"word":"吹气胜兰","pinyin":"chuī qì shèng lán","abbr":"cqsl","explanation":"气息象兰花那样香。形容美女的呼吸。","source":{"text":"陈嘉辞而云对兮，吐芬芳其若兰。","book":"战国·楚·宋玉《神女赋》"},"example":{"text":"宫人丽娟，年十四，玉肤柔软，～。","book":"明·李贽《初谭集·夫妇三》"},"similar":["吹气如兰"],"usage":"作谓语；形容美女"},{"id":11616,"word":"吹灯拔蜡","pinyin":"chuī dēng bá là","abbr":"cdbl","explanation":"比喻垮台；散伙。","source":{"text":"鬼子也不长了，眼看就要吹灯拔蜡了。","book":"杨朔《春子姑娘》"},"example":{"text":"姑娘们和‘奶油小生’～的那几天……和小伙子也显得亲热起来。","book":"《人民文学》1984年第1期"},"opposite":["重起炉灶"],"usage":"作谓语、定语；指结束"},{"id":11617,"word":"吹灰之力","pinyin":"chuī huī zhī lì","abbr":"chzl","explanation":"吹灰尘的力气。比喻极轻微的力量。也比喻做事容易。","source":{"text":"若是我两个引进你，乃吹灰之力。","book":"明·吴承恩《西游记》第四十四回"},"example":{"text":"那几个土匪，若要平地，不费～。","book":"清·李宝嘉《文明小史》第三十七回"},"similar":["举手之劳"],"usage":"作宾语；比喻用力极小"},{"id":11618,"word":"吹灰找缝","pinyin":"chuī huī zhǎo fèng","abbr":"chzf","explanation":"吹掉灰尘，寻找细小的缝隙。形容挖空心思，寻找可乘之隙。"},{"id":11619,"word":"吹牛拍马","pinyin":"chuī niú pāi mǎ","abbr":"cnpm","explanation":"吹牛：吹牛皮；拍马：拍马屁。指爱说大话，喜欢自我吹嘘和一味逢迎巴结别人的行为。","source":{"text":"我想假如曾某能把那种吹牛拍马的精力……用到求实学一点上，所得不是要更多些吗？","book":"鲁迅《伪自由书·后记》"},"example":{"text":"简直是一帮～的坏蛋。","book":"杜鹏程《保卫延安》第二章"},"similar":["阿谀奉承","吹吹拍拍"],"usage":"作宾语、定语；指奉承别人"},{"id":11620,"word":"吹牛皮","pinyin":"chuī niú pí","abbr":"cnp","explanation":"说大话，闲聊天。","source":{"text":"煤矿工人连不识字的女人都难找下，竟然有省报的女记者爱你小子？吹牛皮哩！","book":"路遥《平凡的世界》第五卷第七章"},"example":{"text":"我平生最大的爱好就是～。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":11621,"word":"吹皱一池春水","pinyin":"chuī zhòu yī chí chūn shuǐ","abbr":"czyccs","explanation":"原形容风儿吹指水面，波浪涟漪。后作为与你有何相干或多管闲事的歇后语。","source":{"text":"风乍起，吹皱一池春水。","book":"南唐·冯延巳《谒金门》词"},"example":{"text":"这话又说回来了，～，干卿底事，天下可悲可泣的事多着呢，我管得了许多吗？（张恨水《丹凤街》第二章）"},"similar":["管你何事"],"usage":"作分句；比喻事不关己"},{"id":11622,"word":"吹竹弹丝","pinyin":"chuī zhú tán sī","abbr":"czds","explanation":"吹奏管乐器，弹拨弦乐器。","source":{"text":"阁下凭几而听之，未必不如听吹竹弹丝、敲金击石也。","book":"唐·韩愈《代张籍与李浙东书》"},"example":{"text":"～谁不爱，焚琴煮鹤人何肯。","book":"宋·洪适《满江红·春色怱怱》词"},"similar":["吹竹调丝"],"usage":"作宾语、定语；用于音乐"},{"id":11623,"word":"吹竹调丝","pinyin":"chuí zhú tiáo sī","abbr":"czds","explanation":"竹：管乐器；调：调弄；丝：弦乐器。指管弦乐合奏。泛指音乐活动。","source":{"text":"吹竹调丝，行炙劝酒。","book":"清·纪昀《阅微草堂笔记·滦阳续录》"},"similar":["吹竹弹丝"],"usage":"作宾语、定语；用于音乐"},{"id":11624,"word":"吹箎乞食","pinyin":"chuī chí qǐ shí","abbr":"ccqs","explanation":"箎：古时的一种乐器；乞：乞讨。吹着箎向人乞讨。指在街头行乞。","source":{"text":"伍子胥橐载而出昭关，夜行昼伏，至于陵水，无以糊其口，膝行蒲伏，稽首肉袒，鼓腹吹箎，乞食于吴市。","book":"《史记·范雎列传》"}},{"id":11625,"word":"吹箫乞食","pinyin":"chuī xiāo qǐ shí","abbr":"cxqs","explanation":"原指伍春秋时子胥于吴市吹箫向人乞讨。后指沿街乞讨。","source":{"text":"伍子胥橐载而出昭关，夜行昼伏，至于陵水，无以糊其口，膝行蒲伏，稽首肉袒，鼓腹吹篪，乞食于吴市。","book":"《史记·范睢蔡泽列传》"},"similar":["吴市吹箫"],"usage":"作宾语、定语；用于乞讨","story":["春秋时期，费无极怂恿楚平王占有太子毕建的新娘，设计要害死太子毕建及他的老师伍奢全家，派儿子费得雄去樊城诱骗伍员回京受诛。伍子胥得到的消息，就逃出楚国，到吴国的街市上靠吹箫乞讨为生，后被人发现推荐去辅佐吴王攻楚"]},{"id":11626,"word":"吹篪乞食","pinyin":"chuī chí qǐ shí","abbr":"ccqs","explanation":"吹着篪讨吃的。指在街头行乞。篪：古代的一种音乐，象笛子，有八孔。","source":{"text":"膝行蒲伏，稽首肉袒，鼓腹吹篪，乞食于吴市。","book":"西汉·司马迁《史记·范睢蔡泽列传》"},"example":{"text":"曾经名噪一时的艺术家如今到了～的地步。"},"similar":["吹箫乞食"],"usage":"作宾语、定语；用于乞讨","story":["春秋时期，费无极怂恿楚平王占有太子毕建的新娘，设计要害死太子毕建及他的老师伍奢全家，派儿子费得雄去樊城诱骗伍员回京受诛。伍子胥得到的消息，就逃出楚国，到吴国的街市上靠吹箫乞讨为生，后被人发现推荐去辅佐吴王攻楚"]},{"id":11627,"word":"吹糠见米","pinyin":"chuī kāng jiàn mǐ","abbr":"ckjm","explanation":"比喻见效快。","source":{"text":"有人提出：多派些人到外地搞副业，抓现钱，说这个办法‘吹糠见米’，收效快。","book":"《人民日报》1975.7.8"},"example":{"text":"这个办法可以有～的效果。"},"similar":["立竿见影"],"usage":"作谓语、定语；形容收效快"},{"id":11628,"word":"吹网欲满","pinyin":"chuī wǎng yù mǎn","abbr":"cwym","explanation":"对网吹气，欲使之满。比喻不可能。","source":{"text":"后世学者，渔猎文字语言，正如吹网欲满，非禺即狂。","book":"元·念常《佛祖历代通载·佛印了元禅师》"},"usage":"作宾语、定语；用于不可能的事"},{"id":11629,"word":"吹胡子瞪眼","pinyin":"chuī hú zi dèng yǎn","abbr":"chzdy","explanation":"形容很生气的样子。","source":{"text":"这个挨了骂的司务长恼羞成怒，吹胡子瞪眼，在桥上张牙舞爪。","book":"刘绍棠《渔火》第一章三"},"example":{"text":"他被你气得～。"},"similar":["吹胡子瞪眼睛"],"usage":"作宾语、状语、定语；用于人发怒时"},{"id":11630,"word":"吹胡子瞪眼睛","pinyin":"chuī hú zǐ dèng yǎn jīng","abbr":"chzdyj","explanation":"形容生气、发怒的样子。","source":{"text":"三老汉直气得吹胡子瞪眼睛，手指颤抖着。","book":"王吉呈《上李村》"},"example":{"text":"你～也是白搭。"},"similar":["横眉竖眼"],"opposite":["喜笑颜开"],"usage":"作谓语、状语；指发怒的样子"},{"id":11631,"word":"吹花嚼蕊","pinyin":"chuī huā jiáo ruǐ","abbr":"chjr","explanation":"①指吹奏、歌唱。②引申指反复推敲声律、词藻。","source":{"text":"十八年来堕世间，吹花嚼蕊弄冰弦，多情情寄阿谁边？","book":"清·纳兰性德《浣溪沙》词"},"example":{"text":"余素不工词，～，嗣作遂多。","book":"清·陈裴之《香国宾馆楼忆语》"},"similar":["吹叶嚼蕊"],"usage":"作宾语、定语；用于作文等"},{"id":11632,"word":"吹角连营","pinyin":"chuī jiǎo lián yíng","abbr":"cjly","explanation":"角：古代军中所吹的乐器。指整个军营响着进攻的号角。","source":{"text":"醉里挑灯看剑，梦回吹角连营。","book":"宋·辛弃疾《破阵子·为陈同甫赋壮语以寄》"},"usage":"作宾语、定语；用于书面语"},{"id":11633,"word":"吹鼓手","pinyin":"chuī gǔ shǒu","abbr":"cgs","explanation":"旧时婚丧礼仪中吹打乐器的人，比喻专为别人捧场的人。","source":{"text":"叫班吹鼓手，壮观壮观。","book":"清·褚人获《隋唐演义》第22回"},"example":{"text":"做领导的既要有～，也要有打手。"},"usage":"作主语、宾语、定语；用于讽刺人"},{"id":11634,"word":"吼三喝四","pinyin":"hǒu sān hè sì","abbr":"hshs","explanation":"大声吆喝。","example":{"text":"请不要在公共场合～的。"},"similar":["大吼大叫"],"usage":"作谓语、状语；指叫嚷，用于方言"},{"id":11635,"word":"吼天喊地","pinyin":"hǒu tiān hǎn dì","abbr":"hthd","explanation":"吼：大声叫。大声喊叫，形容极为烦躁痛苦。","source":{"text":"她甚至对吼天喊地的玉亭抱着一种嘲笑的态度。","book":"路遥《平凡的世界》第五卷第23章"},"similar":["呼天喊地"],"usage":"作谓语、状语；用于口语"},{"id":11636,"word":"吾家千里驹","pinyin":"wú jiā qiān lǐ jū","abbr":"wjqlj","explanation":"千里驹：日行千里的马。我家的千里马。夸赞自家优秀的子侄。","source":{"text":"坚尝目之曰：‘吾家千里驹也。’","book":"《晋书·符朗载记》"}},{"id":11637,"word":"吾日三省","pinyin":"wú rì sān xǐng","abbr":"wrss","explanation":"省：检查、反省。原指每日从三个方面检查自己，后指多次自觉地检查自己。","source":{"text":"曾子曰：‘吾日三省吾身，为人谋而不忠乎？’","book":"《论语·学而》"}},{"id":11638,"word":"吾膝如铁","pinyin":"wú xī rú tiě","abbr":"wxrt","explanation":"比喻刚强不屈。","source":{"text":"吾膝如铁，岂肯为贼屈？","book":"《元史·李齐传》"},"usage":"作谓语；用于处事"},{"id":11639,"word":"吾自有处","pinyin":"wú zì yǒu chǔ","abbr":"wzyc","explanation":"我自有办法对付。"},{"id":11640,"word":"吾谁与归","pinyin":"wú shuí yǔ guī","abbr":"wsyg","explanation":"我同谁一起相处。指对志同道合者的寻求。","source":{"text":"死者若可作也，吾谁与归。","book":"《国语·晋语八》"},"example":{"text":"这事怎办，～？"},"usage":"作谓语、分句；用于疑问句"},{"id":11641,"word":"吾道东矣","pinyin":"wú dào dōng yǐ","abbr":"wddy","explanation":"道：主张。自己的学术主张得人继承和推广。","source":{"text":"问毕辞归，融喟然谓门人曰：‘郑生今去，吾道东矣！’","book":"南朝·宋·范晔《后汉书·郑玄传》"},"usage":"作谓语、分句；指学术推广"},{"id":11642,"word":"吾道将东","pinyin":"wú dào jiāng dōng","abbr":"wdjd","explanation":"道：学术主张。指自己的学术或主张得到继承和推广。","source":{"text":"问毕辞归，融喟然谓门人曰：‘郑生今去，吾道东矣。’","book":"《后汉书·郑玄传》"},"example":{"text":"～矣，秋风更飒然。","book":"唐·钱起《寇中送张司马归洛》"}},{"id":11643,"word":"吾门标秀","pinyin":"wú mén biāo xiù","abbr":"wmbx","explanation":"吾门：我家；标秀：出类拔萃。我家杰出的儿子。","source":{"text":"此儿非惟吾门之标秀，乃佐时之良器也。","book":"《晋书·慕容皝载记》"}},{"id":11644,"word":"呀呀学语","pinyin":"yā yā xué yǔ","abbr":"yyxy","explanation":"呀呀：象声词，摹拟婴儿学说话的声音。形容婴儿咿咿呀呀地学大人说话的神情。","source":{"text":"二女则牙牙学语，五男则雁雁成行。","book":"唐·司空图《障车文》"},"example":{"text":"红已经做了人妻，连她新生的孩子，也已开始～。","book":"阎连科《最后一名女知青》第四部"},"similar":["牙牙学语","哑哑学语"],"usage":"作谓语、定语；形容小孩说话的神情"},{"id":11645,"word":"呆似木鸡","pinyin":"dāi sì mù jī","abbr":"dsmj","explanation":"呆得象木头鸡一样。形容因恐惧或惊异而发愣的样子。","source":{"text":"几矣。鸡虽有鸣者，已无变矣，望之似木鸡矣，其德全矣；异鸡无敢应者，反走矣。","book":"《庄子·达生》"},"similar":["呆如木鸡"],"usage":"作谓语、状语、补语；指呆板"},{"id":11646,"word":"呆头呆脑","pinyin":"dāi tóu dāi nǎo","abbr":"dtdn","explanation":"呆：呆板，不灵活。形容思想、行动迟钝笨拙。","source":{"text":"似这等呆脑呆头劝不回，呸！可不干赚了我奔走红尘九千里。","book":"元·马致远《岳阳楼》第三折"},"example":{"text":"小凤仙的脾气，人家说她不合时宜，其实她也是～，不惯作妓女腔，与人不合。","book":"蔡东藩、许廑父《民国通俗演义》第五十一回"},"similar":["目瞪口呆","张口结舌"],"opposite":["天真烂漫","生龙活虎"],"usage":"作状语、定语；指愚笨"},{"id":11647,"word":"呆如木鸡","pinyin":"dāi rú mù jī","abbr":"drmj","explanation":"呆得象木头鸡一样。形容因恐惧或惊异而发愣的样子。","source":{"text":"几矣。鸡虽有鸣者，已无变矣，望之似木鸡矣，其德全矣；异鸡无敢应者，反走矣。","book":"《庄子·达生》"},"example":{"text":"那几个军人和财主，一个个～。","book":"鲁彦周《廖仲恺》第六章八五"},"similar":["呆若木鸡"],"usage":"作谓语、状语、补语；指呆板"},{"id":11648,"word":"呆若木鸡","pinyin":"dāi ruò mù jī","abbr":"drmj","explanation":"呆：傻，发愣的样子。呆得象木头鸡一样。形容因恐惧或惊异而发愣的样子。","source":{"text":"几矣。鸡虽有鸣者，已无变矣，望之似木鸡矣，其德全矣；异鸡无敢应者，反走矣。","book":"《庄子·达生》"},"example":{"text":"匪首侯殿坤，在得知这个噩耗之后，特别是知道了老妖道的落网后，当即～。","book":"曲波《林海雪原》二八"},"similar":["呆头呆脑","目瞪口呆"],"opposite":["活泼可爱","神色自若"],"usage":"作谓语、状语、定语；指呆板","story":["西周时期，纪渻子专门为宣王养斗鸡，宣王一再催问纪渻子养的斗鸡如何样了？40天过后，纪渻子养的斗鸡像一只木头做的，不惊不动，别的鸡见它都吓跑了，这只鸡天下无敌"]},{"id":11649,"word":"呆里撒奸","pinyin":"dāi lǐ sā jiān","abbr":"dlsj","explanation":"形容外表痴呆，内心奸诈。","source":{"text":"你休要呆里撒奸。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"你休～，我手里使不的你巧语花言。","book":"明·兰陵笑笑生《金瓶梅词话》第八十六回"},"usage":"作谓语、定语、宾语；指人狡猾"},{"id":11650,"word":"呆里藏乖","pinyin":"dāi lǐ cáng guāi","abbr":"dlcg","explanation":"呆：痴呆，傻。外表呆头呆脑而内心却很机灵。","source":{"text":"不想那方帮是个呆里藏乖的人，打听得消息不好……竟拿了那些银子，先自挈家而走。","book":"明·无名氏《鼓掌绝尘》"}},{"id":11651,"word":"告哀乞怜","pinyin":"gào āi qǐ lián","abbr":"gaql","explanation":"告：请求；乞：求，讨。向别人乞求怜悯、帮助。","source":{"text":"杜又派人分头疏通，告哀乞怜地请求他们勿再辞勋。","book":"陶菊隐《北洋军阀统治时期史话》第71章"},"example":{"text":"男人不能靠～过日子。"},"similar":["乞哀告怜"],"usage":"作谓语、宾语、状语；指乞求别人的同情怜悯"},{"id":11652,"word":"告往知来","pinyin":"gào wǎng zhī lái","abbr":"gwzl","explanation":"告诉了这一点，就可以知道另一点。比喻能明了事物的因果同异的关系，据此知彼。","source":{"text":"赐也，始可与言《诗》已矣，告诸往而知来者。","book":"《论语·学而》"},"example":{"text":"与赐、商言诗，切磋绘事，～。","book":"清·魏源《诗比兴笺序》"},"usage":"作谓语、定语；指据此知彼"},{"id":11653,"word":"告朔饩羊","pinyin":"gù shuò xì yáng","abbr":"gsxy","explanation":"原指鲁国自文公起不亲到祖庙告祭，只杀一只羊应付一下。后比喻照例应付，敷衍了事。","source":{"text":"子贡欲去告朔之忾羊。","book":"《论语·八佾》"},"example":{"text":"不过外蒙古一部分，已不啻～，名存实亡了。","book":"蔡东藩、许廑父《民国通俗演义》第三十八"},"usage":"作宾语、定语；用于处事"},{"id":11654,"word":"告老在家","pinyin":"gào lǎo zài jiā","abbr":"glzj","explanation":"告老：因年老而告退；家：故乡、故里。指因年老而辞职在故乡安度晚年。","source":{"text":"一位杨乡宦到了宫保尚书，赐了全俸，告老在家。","book":"清·西周生《醒世姻缘传》第23回"},"example":{"text":"我已～，不闻政事。"},"usage":"作谓语、宾语；指退休在家"},{"id":11655,"word":"告老还乡","pinyin":"gào lǎo huán xiāng","abbr":"glhx","explanation":"年老辞职，回到家乡。","source":{"text":"西京洛阳县有一官人，姓刘名弘敬，字元普，曾任过青州刺史，六十岁上告老还乡。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“做官的‘年将半百’，便要‘～’，买田买地做‘老员外’享清福。”"},"similar":["告老还家"],"usage":"作谓语、宾语；指官员辞官回家"},{"id":11656,"word":"告老还家","pinyin":"gào lǎo huán jiā","abbr":"glhj","explanation":"告老：因年老而告退；还：回，返；家：故乡、故里。因年老而辞职回归故乡安度晚年。","source":{"text":"名唤王忠，曾做过宰辅，如今告老还家。","book":"清·曹雪芹《红楼梦》第54回"},"example":{"text":"我随时可以～。"},"similar":["告老还乡"],"usage":"作谓语、宾语；指官员辞官回家"},{"id":11657,"word":"告贷无门","pinyin":"gào dài wú mén","abbr":"gdwm","explanation":"告贷：向别人借钱。想借钱但没有地主借。指生活陷入困境。","source":{"text":"各勋之索米索饷，刻不可迟，称贷无门，征催莫济。","book":"明·瞿式耜《表急公绅士疏》"},"example":{"text":"～，今冬情形，不但无垫米之银，更恐无可实之米。","book":"清·林则徐《江苏阴雨连绵田稻欠收情形片》"},"similar":["山穷水尽","借贷无门"],"usage":"作宾语、定语；指陷于孤立"},{"id":11658,"word":"呕心吐胆","pinyin":"ǒu xīn tǔ dǎn","abbr":"oxtd","explanation":"呕：吐。形容费尽心血，历尽艰辛。","source":{"text":"呕心吐胆，不足语穷；锻发炼年，奚能喻苦？","book":"南朝·宋·刘义庆《世说新语·隐秀》"},"similar":["呕心镂骨"],"usage":"作谓语、定语；指尽力"},{"id":11659,"word":"呕心抽肠","pinyin":"ǒu xīn chōu cháng","abbr":"oxcc","explanation":"形容极度悲伤。","source":{"text":"那些呕心抽肠的鬼，更不知哭到几时，才是住手！","book":"明·凌濛初《二刻拍案惊奇》卷一"},"usage":"作谓语、定语；指人很悲伤"},{"id":11660,"word":"呕心沥血","pinyin":"ǒu xīn lì xuè","abbr":"oxlx","explanation":"呕：吐；沥：一滴一滴。比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。","source":{"text":"刳肝以为纸，沥血以书辞。","book":"唐·李商隐《李长吉小传》：“是儿要当呕出心乃已尔。”唐·韩愈《归彭城》诗"},"example":{"text":"～，讴歌社会主义，受到群众的欢迎。","book":"臧克家《老舍永在》"},"similar":["煞费苦心","挖空心思"],"opposite":["无所用心","粗制滥造"],"usage":"作谓语、定语、状语；用于教师等","story":["唐朝诗人李贺不愿暴露他的皇室远亲身分，只身参加科举做了小官。他在诗歌上却花费了全部的精力与心血，他经常命书童背一个袋子装他路上偶得的诗句，他的“长歌破衣襟，短歌断白发”堪称他治学的写照，他母亲认为他是在吐心"]},{"id":11661,"word":"呕心滴血","pinyin":"ǒu xīn dī xuè","abbr":"oxdx","explanation":"比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。同“呕心沥血”。","source":{"text":"余愿呕心滴血以拜求之，祈余二万万女同胞无负此国民责任也。","book":"清·秋瑾《精卫石·序》"},"example":{"text":"这也就是后人所说的‘～’了。","book":"郭沫若《李白与杜甫》"},"similar":["呕心沥血"],"usage":"作谓语、定语、状语；用于教师等"},{"id":11662,"word":"呕心镂骨","pinyin":"ǒu xīn lòu gǔ","abbr":"oxlg","explanation":"形容费尽心思与精力（多用于文艺创作）。","source":{"text":"李义山《咏柳》云：‘堤远意相随。’真写刘之魂魄。与唐人‘山远始为容，江奔地欲随’之句，皆是呕心镂骨而成。","book":"清·袁枚《随园诗话》卷一"},"similar":["呕心吐胆"],"usage":"作谓语、定语；指尽力"},{"id":11663,"word":"呜呜咽咽","pinyin":"wū wū yè yè","abbr":"wwyy","explanation":"指人伤心哽泣的声音。","source":{"text":"这一夜思茶无茶，思水无水，思睡无衾枕，呜呜咽咽直哭了一夜。","book":"清·曹雪芹《红楼梦》第61回"},"example":{"text":"清·曹雪芹《红楼梦》第61回：“这一夜思茶无茶，思水无水，思睡无衾枕，～直哭了一夜。”"},"similar":["抽抽噎噎"],"usage":"作定语、状语；用于人伤心时"},{"id":11664,"word":"呜呼哀哉","pinyin":"wū hū āi zāi","abbr":"whaz","explanation":"呜呼：叹词；哉：语气助词。原为表示哀痛的感叹语，旧时祭文中常用。现用以指死亡或完蛋。","source":{"text":"於乎哀哉，维今之人，不尚有旧。”《左传·哀十六年》“呜呼哀哉，尼父！无自律！","book":"《诗经·大雅·召旻》"},"example":{"text":"那婆娘精神恍惚，自觉无颜。解腰间绣带，悬梁自缢，～。","book":"明·冯梦龙《警世通言》卷二"},"similar":["寿终正寝","一命呜呼"],"opposite":["健康长寿"],"usage":"作谓语、定语；含讽刺意味"},{"id":11665,"word":"呜呼噫嘻","pinyin":"wū hū yī xī","abbr":"whyx","explanation":"叹词。表示慨叹。"},{"id":11666,"word":"呢喃细语","pinyin":"ní nán xì yǔ","abbr":"nnxy","explanation":"形容小声说话。","source":{"text":"乃向西北奋飞，喃喃细语。","book":"《北史·隋·房陵王勇传》"},"example":{"text":"《北史·隋·房陵王勇传》：“乃向西北奋飞，喃喃细语。”"},"similar":["轻言细语","窃窃私语"],"usage":"作谓语、宾语；指小声说话"},{"id":11667,"word":"周全之道","pinyin":"zhōu quán zhī dào","abbr":"zqzd","explanation":"周全：周到。考虑细致全面的方法。","source":{"text":"此盖失于周全之道，而取诸偏至之端者也。","book":"《后汉书·独行传》"}},{"id":11668,"word":"周公吐哺","pinyin":"zhōu gōng tǔ bǔ","abbr":"zgtb","explanation":"后用为在位者礼贤下士之典实。","source":{"text":"周公戒伯禽曰：‘我文王之子，武王之弟，成王之叔父，我於天亦不贱矣。然我一沐三捉发，一饭三吐哺，起以待士，犹恐失天下之贤人。子之鲁，慎无以国骄人。’","book":"《史记·鲁周公世家》"},"example":{"text":"～，天下归心。","book":"三国·魏·曹操《短歌行》"},"usage":"作宾语、定语；用于书面语"},{"id":11669,"word":"周听不蔽","pinyin":"zhōu tīng bù bì","abbr":"ztbb","explanation":"蔽：蒙蔽。广泛听取意见就不会被蒙蔽。","source":{"text":"周听则不蔽，稽验则不惶。","book":"汉·贾谊《新书·道术》"},"usage":"作谓语、定语；用于处事"},{"id":11670,"word":"周妻何肉","pinyin":"zhōu qī hé ròu","abbr":"zqhr","explanation":"周：南朝周颙；何：南朝何胤。周颙有妻子，何胤吃肉。比喻各有所累。","source":{"text":"太子又问颙：‘卿精进何如何胤？’颙曰：‘三涂八难，共所未免。然各有其累。’太子曰：‘所累伊何？’对曰：‘周妻何肉。’其言辞应变，皆如此也。","book":"《南齐书·周颙传》"},"example":{"text":"所谓俭而难遵矣，余～，免俗未能，于酒则窃学东坡短处，愿以羊易之。（钱钟书《槐聚诗存》）"},"usage":"作宾语、定语；用于书面语"},{"id":11671,"word":"周急济贫","pinyin":"zhōu jí jì pín","abbr":"zjjp","explanation":"救济帮助有急难和贫乏的人。同“周急继乏”。","source":{"text":"我怎敢便忘了你那周急济贫时！","book":"元·郑廷玉《看钱奴》第四折"},"similar":["周急济贫"],"usage":"作谓语、宾语、定语；用于处事"},{"id":11672,"word":"周急继乏","pinyin":"zhōu jí jì fá","abbr":"zjjf","explanation":"周：接济。继：帮助。救济帮助有急难和贫乏的人。亦作“周急济贫”、“周贫济老”。","source":{"text":"于饥荒之际，收恤朋友孤遗，中外贫宗，周急继乏，信义见称。","book":"《三国志·魏书·任峻传》"},"example":{"text":"晋·陈寿《三国志·魏志·任峻传》：“于饥荒之际，收恤朋友孤遗，中外贫宗，～，信义见称。”"},"similar":["周急济贫"],"usage":"作谓语、宾语、定语；用于处事"},{"id":11673,"word":"周情孔思","pinyin":"zhōu qíng kǒng sī","abbr":"zqks","explanation":"周公、孔子的思想感情。封建社会奉之为思想情操的楷模、典范。","source":{"text":"日光玉洁，周情孔思。","book":"唐·李汉《韩昌黎集序》"},"example":{"text":"华表松枝向北寒，～楷模看。","book":"清·钱彩《说岳全传》第六十一回"},"usage":"作主语、宾语；指封建意识"},{"id":11674,"word":"周游列国","pinyin":"zhōu yuó liè guó","abbr":"zylg","explanation":"周游：全都走到，游遍。原指孔丘带着他的学生周游当时的许多国家，希望得到重用，以便推行儒家的政治主张。后指走遍各地。","source":{"text":"孔子的学生说：‘鲁君不办正事，咱们走吧！’打那以后，孔子离开鲁国，带着一批学生周游列国，希望找个机会实行他的政治主张。","book":"曹余章《上下五千年·孔子周游列国》"},"example":{"text":"扁鹊深入民间，‘～’，‘随俗为变’，解除人民疾病的痛苦。","book":"陶铸《崇高的理想》"},"usage":"作谓语、宾语；指旅行","story":["春秋时期，孔子带领他的学生们到各诸侯国游学，因孔子是保守派，与当时诸侯争霸不合拍，常常受到冷遇。一次孔子与弟子走散，孔子呆在东门旁发呆，子贡问郑国人孔子在何处。郑国人说东门边有个老头子像一只丧家之狗在发呆"]},{"id":11675,"word":"周瑜打黄盖","pinyin":"zhōu yú dǎ huáng gài","abbr":"zydhg","explanation":"两相情愿。","example":{"text":"做生意是～，一家愿打，一家愿挨。"},"similar":["两相情愿"],"usage":"作宾语、定语；指两相情愿","story":["三国时期，东吴的大将黄盖受命诈降到曹操的军营，为了取信于曹操，周瑜故意借故痛打黄盖一顿，让黄盖假装气愤而投敌。黄盖劝曹操将战船连在一块，给孔明利用火攻创造条件，最终孙刘联盟取得赤壁之战的胜利"]},{"id":11676,"word":"周穷恤匮","pinyin":"zhōu qióng xù kuì","abbr":"zqxk","explanation":"接济、救助鳏寡孤独及其它贫困的人。","source":{"text":"素鄙吝者，欲其观古人之贵义轻财，少私寡欲，忌盈恶满，周穷恤匮，赧然悔耻，积而能散也。","book":"北齐·颜之推《颜氏家训·勉学》"}},{"id":11677,"word":"周而不比","pinyin":"zhōu ér bù bǐ","abbr":"zebb","explanation":"周：亲和、调合；比：勾结。关系密切，但不勾结。指与众相合，但不做坏事。","source":{"text":"子曰：‘君子周而不比。’","book":"《论语·为政》"},"example":{"text":"那里肯～。","book":"元·贾仲名《萧淑兰》第二折"},"opposite":["狼狈为奸"],"usage":"作谓语、定语；指与众相合，但不做坏事"},{"id":11678,"word":"周而复始","pinyin":"zhōu ér fù shǐ","abbr":"zefs","explanation":"周：环绕一圈；复：又，再。转了一圈又一圈，不断循环。","source":{"text":"精健日月，星辰度理，阴阳五行，周而复始。","book":"《汉书·礼乐志》"},"example":{"text":"季节的春夏秋冬，植物的生长荣枯，～，年年如此。"},"similar":["循环往复","终而复始"],"opposite":["一去不复返"],"usage":"作谓语、定语、状语；指循环往复"},{"id":11679,"word":"周而复生","pinyin":"zhōu ér fù shēng","abbr":"zefs","explanation":"周：环绕一周；复：又。转了一圈又一圈，不断循环","source":{"text":"故曰音始于宫，穷于角；数始于一，终于十，成于三；气始于冬至，周而复生。","book":"西汉·司马迁《史记·律书》"},"similar":["周而复始"],"usage":"作谓语、定语、状语；指循环往复"},{"id":11680,"word":"周规折矩","pinyin":"zhōu guī zhé jǔ","abbr":"zgzj","explanation":"本指行礼时步趋合乎规矩。后引申为拘泥于成法、准则。","source":{"text":"周还中规，折还中矩。","book":"语出《礼记·玉藻》"},"example":{"text":"以彼其文，忌不～，尺步绳趋？","book":"清·冯桂芬《复庄卫生书》"},"usage":"作宾语、定语；用于书面语"},{"id":11681,"word":"周贫济老","pinyin":"zhōu pín jì lǎo","abbr":"zpjl","explanation":"救济帮助有急难和贫乏的人。同“周急继乏”。","source":{"text":"论理我不该讨情，我想老太太好日子，发狠的还舍钱舍米，周贫济老，咱们家先倒折磨起人家来了。","book":"清·曹雪芹《红楼梦》第七十一回"}},{"id":11682,"word":"周郎顾曲","pinyin":"zhōu láng gù qǔ","abbr":"zlgq","explanation":"原指周瑜业于音乐。后泛指通音乐戏曲的人。","source":{"text":"瑜少精意于音乐，虽三爵之后，其有阙误，瑜必知之，知之必顾，故时有人谣曰：‘曲有误，周郎顾。’","book":"《三国志·吴书·周瑜传》"},"example":{"text":"谁谓～之场，非即生公说法之地乎？","book":"清·俞樾《余莲村劝善杂剧序》"},"usage":"作宾语、定语；指懂音乐的人"},{"id":11683,"word":"呱呱坠地","pinyin":"gū gū zhuì dì","abbr":"ggzd","explanation":"形容婴儿出生或事物问世。","source":{"text":"尔呱呱坠地，无几月，即生父见背。","book":"苏曼殊《断鸿零雁记》第三章"},"example":{"text":"欢迎～之新中华。","book":"李大钊《之使命》"},"similar":["呱呱堕地"],"usage":"作谓语、定语；指出生"},{"id":11684,"word":"呱呱堕地","pinyin":"gū gū duò dì","abbr":"ggdd","explanation":"形容婴儿出生或事物问世。同“呱呱坠地”。","source":{"text":"到六月七日那一天，七八年梦寐萦怀的《生活日报》居然呱呱堕地了。","book":"邹韬奋《经历》"},"similar":["呱呱坠地"],"usage":"作谓语、定语；指出生"},{"id":11685,"word":"呱呱而泣","pinyin":"gū gū ér qì","abbr":"ggeq","explanation":"呱呱：婴儿的啼哭声；泣：小声哭。像婴孩一样哭啼不停。","source":{"text":"启呱呱而泣。","book":"《尚书·益稷》"},"example":{"text":"汝姊在我怀～。","book":"明·归有光《项脊轩志》"}},{"id":11686,"word":"味同嚼蜡","pinyin":"wèi tóng jiáo là","abbr":"wtjl","explanation":"象吃蜡一样，没有一点儿味。形容语言或文章枯燥无味。","source":{"text":"当横陈时，味同嚼醋。","book":"《楞严经》卷八"},"example":{"text":"但世人一见了功名，便舍着性命去求他，及至到手之后，～。","book":"清·吴敬梓《儒林外史》第一回"},"similar":["平淡无味","兴味索然"],"opposite":["饶有风趣","妙语连珠"],"usage":"作谓语；指乏味"},{"id":11687,"word":"味如嚼蜡","pinyin":"wèi rú jiáo là","abbr":"wrjl","explanation":"象吃蜡一样，没有一点儿味。形容语言或文章枯燥无味。见“味同嚼蜡”。","source":{"text":"我无欲心，应汝行事，于横陈时，味如嚼蜡。","book":"《楞严经》第八卷"},"example":{"text":"鲁迅《两地书》：“周刊上常有极锋利肃杀的诗，其实是没有意思的，情随事迁，即～。”"},"similar":["味同嚼蜡"],"opposite":["妙语连珠"],"usage":"作谓语、定语；指乏味"},{"id":11688,"word":"味如嚼醋","pinyin":"wèi rú jiáo cù","abbr":"wrjc","explanation":"象吃醋一样，没有一点儿味。形容语言或文章枯燥无味。","source":{"text":"当横陈时，味如嚼醋。","book":"《楞严经》卷八"}},{"id":11689,"word":"味如鸡肋","pinyin":"wèi rú jī lèi","abbr":"wrjl","explanation":"鸡肋：鸡的肋骨，没有肉，比喻无多大意味而又不忍舍弃的东西。比喻事情不做可惜，做起来没有多大好处。","source":{"text":"夫鸡肋，弃之可惜，食之无所得，以比汉中，知王欲还也。","book":"晋·司马彪《九州春秋》"},"example":{"text":"这样做～，没有什么意思。"},"similar":["弃之可惜，食之无味"],"usage":"作谓语、宾语；指少有实惠","story":["公元217年，夏侯渊被刘备杀死，汉中失守。曹操率大军前去汉中，双方对峙几个月，曹军处境越来越不妙。一天晚上曹操吃饭发现汤中有鸡肋，随口说出“鸡肋”两字，被杨修误以为是退兵的意思。第二天曹操果然下令回师"]},{"id":11690,"word":"呴湿濡沫","pinyin":"xǔ shī rú mò","abbr":"xsrm","explanation":"呴，慢慢呼气。比喻同处困境，互相救助。","source":{"text":"泉涸，鱼……相呴以湿，相濡以沫。","book":"语出《庄子·大宗师》"},"example":{"text":"清·钱谦益《祭姚母文夫人》：“镞砺道义，切磨文章，～。”"},"similar":["相濡以沫"],"usage":"作宾语、定语；用于书面语"},{"id":11691,"word":"呵佛骂祖","pinyin":"hē fó mà zǔ","abbr":"hfmz","explanation":"原指如果不受前人拘束，就可以突破前人。后比喻没有顾虑，敢做敢为。","source":{"text":"是子将来有把茅盖头，呵佛骂祖去在。","book":"宋·释道原《景德传灯录》卷十五"},"example":{"text":"若得一把茅盖头，必能为公～。","book":"宋·朱弁《曲洧旧闻》卷八"},"similar":["敢作敢为"],"usage":"作谓语、定语；指敢做敢为"},{"id":11692,"word":"呵壁问天","pinyin":"hē bì wèn tiān","abbr":"hbwt","explanation":"呵：大声呵斥；问天：向天发问。形容文人不得志而发牢骚。","source":{"text":"屈原放逐，忧心愁悴，彷徨山泽，经历陵陆，嗟号昊旻，仰天叹息。……因书其壁，呵而问之，以渫愤懑，舒泻愁思。","book":"汉·王逸《天问序》"},"example":{"text":"分明犹惧公不信，公看呵壁书问天。(唐·李贺《公无出门》诗"},"usage":"作谓语；用于文人不得志","story":["战国时期，屈原离开郢都，乘一叶孤舟沿江而下，踏上归家的路途，他多么希望能够与楚王共议国事，推行法治。他来到荒滩野地之间，弃舟登岸，彷徨山泽之间，见到先王的宗庙，他感慨万千，于是面壁呵斥，大声质问苍天为什么会怀才不遇"]},{"id":11693,"word":"呵欠连天","pinyin":"hē qiàn lián tiān","abbr":"hqlt","explanation":"呵欠：困倦时往往情不自禁地张开大口吸气的现象。不断的打哈欠。①形容尚未睡醒。②比喻非常疲倦的样子。亦作“哈气连天”。","source":{"text":"众人都被风颠得头晕，个个是呵欠连天，不肯同去。","book":"①明·凌濛初《初刻拍案惊奇》卷六：“春花也为起得早了，在小师父房里打盹，听得家主婆叫响，呵欠连天，走到面前。”②又卷一"},"example":{"text":"王朔《玩儿的就是心跳》：“后来我饿了，去厨房给自己下鸡蛋面条并问～收拾东西的警察们要不要也‘来上一碗’。”"},"opposite":["精神抖擞"],"usage":"作谓语、定语；用于人发困时"},{"id":11694,"word":"呵笔寻诗","pinyin":"hē bǐ xún shī","abbr":"hbxs","explanation":"呵笔：冬天笔凉或冻结，用口吹暖气使之解冻；寻诗：寻觅诗句。用口吹暖气，使笔解冻，然后挥笔作诗。形容冬日苦吟。","source":{"text":"寒窗呵笔寻诗句，一片飞来纸上销。","book":"唐·罗隐《雪》诗"},"usage":"作宾语；指读书"},{"id":11695,"word":"呶呶不休","pinyin":"náo náo bù xiū","abbr":"nnbx","explanation":"呶呶：形容说话唠叨；休：停止。唠唠叨叨，说个不停。","source":{"text":"岂可使呶呶者早晚弗吾耳，骚吾心！","book":"唐·柳宗元《答韦中立师道书》"},"example":{"text":"对于国民党则敢于连篇累牍，～，劝其降顺。","book":"毛泽东《评国民党十一中全会和三届二次国民参政会》"},"similar":["喋喋不休"],"opposite":["沉默寡言"],"usage":"作谓语、状语；指唠叨"},{"id":11696,"word":"呷醋节帅","pinyin":"xiā cù jié shuài","abbr":"xcjs","explanation":"此为具有高尚品德和节操的典实。","source":{"text":"唐任迪简为天德军判官，一日军宴，军吏误以醋酌迪简，以军使李景略严暴，恐罪及军吏，乃强饮之，吐血而归。军中闻者皆为感泣。及景略卒，军中请以为主，官至易定节度使，时人呼为呷醋节归。见唐·李肇《唐国史补》卷中。"}},{"id":11697,"word":"呼不给吸","pinyin":"hū bù jǐ xī","abbr":"hbjx","explanation":"形容吓得来不及喘气。","source":{"text":"眯不给抚，呼不给吸。","book":"《淮南子·兵略训》"},"usage":"作谓语、定语；用于人恐惧等时"},{"id":11698,"word":"呼之即来，挥之即去","pinyin":"hū zhī jí lái，huī zhī jí qù","abbr":"hzjlhzjq","explanation":"即：就，立刻；挥：挥手。叫他来就来，叫他走就走。形容统治阶级对下属或奴才的任意使唤。","source":{"text":"至于缓急之际，决大策，安大众，呼之则来，挥之则散者，唯世臣巨室为能。","book":"宋·苏轼《王忠仪真赞序》"},"example":{"text":"她不想成为他～的工具。"},"similar":["召之即来，挥之即去"],"usage":"作定语、分句；形容任意使唤"},{"id":11699,"word":"呼之即至，挥之即去","pinyin":"hū zhī jí zhì，huī zhī jí qù","abbr":"hzjzhzjq","explanation":"呼：召唤；即：就，立刻；挥：挥手。叫他来就来，叫他走就走。形容任意使唤支使。","source":{"text":"潘金莲房中，养着一只白狮子猫儿……呼之即至，挥之即去，妇人常叫他雪贼。","book":"明·兰陵笑笑生《金瓶梅词话》第60回"},"similar":["呼之即来，挥之即去"],"usage":"作定语、分句；形容任意使唤"},{"id":11700,"word":"呼之或出","pinyin":"hū zhī huò chū","abbr":"hzhc","explanation":"呼：招呼；之：代词，指代呼唤的对象。形容所描绘的人物生动逼真，也指人选已酝酿成熟，即将就任。","source":{"text":"空蒙寂历，烟雨灭没，恕先在焉，呼之或出。","book":"宋·苏轼《郭忠恕画赞序》"},"similar":["呼之欲出"],"usage":"作谓语、定语；形容画像生动逼真"},{"id":11701,"word":"呼之欲出","pinyin":"hū zhī yù chū","abbr":"hzyc","explanation":"呼：叫，喊。形容人像画得逼真，似乎叫一声就会从画中走出来。泛指文学作品中人物的描写十分生动。","source":{"text":"恕先在焉，呼之或出。","book":"宋·苏轼《郭忠恕画赞序》"},"example":{"text":"海立山奔，烟云灭没，谓有龙焉，～。","book":"明·张岱《木犹龙铭》"},"similar":["维妙维肖","栩栩如生","跃然纸上"],"opposite":["画虎类犬","平淡无奇"],"usage":"作谓语、定语；形容画像生动逼真"},{"id":11702,"word":"呼卢喝雉","pinyin":"hū lú hè zhì","abbr":"hlhz","explanation":"呼、喝：喊叫；卢、雉：古时赌具上的两种颜色。泛指赌博。","source":{"text":"呼卢喝雉连暮夜，击兔伐狐穷岁年。","book":"宋·陆游《风顺舟行甚疾戏书》诗"},"example":{"text":"却忆咸阳客舍里，～烛花底。","book":"明·瞿佑《骰子》诗"},"similar":["喝雉呼卢"],"usage":"作谓语、宾语；指赌博"},{"id":11703,"word":"呼吸之间","pinyin":"hū xī zhī jiān","abbr":"hxzj","explanation":"形容极为短暂的时间。","source":{"text":"决胜负于一朝，定成败于呼吸。","book":"《晋书·郗鉴传》"},"example":{"text":"须先理其气，气若顺，则～，自然痊可。","book":"明·罗贯中《三国演义》第四十九回"},"usage":"作宾语；指短时间"},{"id":11704,"word":"呼吸相通","pinyin":"hū xī xiāng tōng","abbr":"hxxt","explanation":"呼气与吸气，朴素贯通。比喻认识一致，利害相关。","source":{"text":"脉脉者有条有绪，若呼吸相通，寻之有端而即之殊远。","book":"明·陈祚明《采菽堂古诗选·古诗十九首》十"},"example":{"text":"闽粤互为唇齿，～。","book":"《清史稿·颜伯焘传》"},"similar":["命运与共"],"usage":"作谓语；比喻利害一致，命运相关"},{"id":11705,"word":"呼天不应","pinyin":"hū tiān bù yìng","abbr":"htby","explanation":"向天呼唤求助，但天却不应答。比喻求告无门，无处诉说。"},{"id":11706,"word":"呼天不闻","pinyin":"hū tiān bù wén","abbr":"htbw","explanation":"向天呼唤求助，但天却听不到。比喻求告无门，无处诉说。"},{"id":11707,"word":"呼天叩地","pinyin":"hū tiān kòu dì","abbr":"htkd","explanation":"大声叫天，用头撞地。形容极度悲伤。同“呼天抢地”。","source":{"text":"今张浩忽背前约，使妾呼天叩地，无所告投。","book":"《警世通言·宿香亭张浩遇莺莺》"},"similar":["呼天抢地"],"usage":"作谓语、定语；形容极度悲伤"},{"id":11708,"word":"呼天叫地","pinyin":"hū tiān jiào dì","abbr":"htjd","explanation":"形容极为冤屈、怨恨或痛苦。同“呼天号地”。","source":{"text":"[韩魏公曰]百姓多愚，或为枉断，抱憾终身，早夜呼天叫地，我岂安乎？","book":"清·唐训方《里语徵实》卷下引《暗室灯》"},"similar":["呼天唤地","呼天号地","吼天喊地"],"usage":"作谓语、状语；形容极为痛苦"},{"id":11709,"word":"呼天号地","pinyin":"hū tiān hào dì","abbr":"hthd","explanation":"哭叫天地。形容极为冤屈、怨恨或痛苦。亦作“呼天叫地”。","source":{"text":"我祖我父，一心王宝……不死于虏，则死于盗贼；若子若孙，呼天号地，此恨难磨。","book":"宋·周密《齐东野语·嘉定宝玺》"},"example":{"text":"祖母詹忧危甚，每一病作，～，殆不欲生。","book":"明·袁宏道《去吴七牍·乞归稿一》"},"similar":["呼天唤地","呼天叫地"],"usage":"作谓语、状语；形容极为痛苦"},{"id":11710,"word":"呼天吁地","pinyin":"hū tiān yù dì","abbr":"htyd","explanation":"指呼喊天地以求救助。","source":{"text":"[异史氏曰]恶乎哉！呼天吁地，忽尔披发向银床。","book":"清·蒲松龄《聊斋志异·马介甫》"},"example":{"text":"渐渐炊烟将欲断，～俱无门。","book":"《醒世缘弹词》第十四回"},"similar":["呼天喊地"],"usage":"作谓语、状语；用于求助"},{"id":11711,"word":"呼天唤地","pinyin":"hū tiān huàn dì","abbr":"hthd","explanation":"哭天叫地，形容极为痛苦。","source":{"text":"回来说，汤富海在屋子里呼天唤地叫痛。","book":"周而复《上海的早晨》第一部"},"example":{"text":"死者的亲人扑在尸体旁边，～的大哭。","book":"高云览《小城春秋》第六章"},"similar":["呼天号地","呼天叫地"],"usage":"作谓语、状语；形容极为痛苦"},{"id":11712,"word":"呼天抢地","pinyin":"hū tiān qiāng dì","abbr":"htqd","explanation":"抢地：触地。大声叫天，用头撞地。形容极度悲伤。","source":{"text":"肖云仙呼天抢地，尽哀尽礼，治办丧事，十分尽心。","book":"清·吴敬梓《儒林外史》第四十回"},"example":{"text":"彼等何辜，忍令其～而死也。","book":"《清史稿·韩朋赋》"},"similar":["嚎啕大哭","痛不欲生","痛哭流涕"],"opposite":["兴高采烈","放声大笑","得意洋洋"],"usage":"作谓语、定语；形容极度悲伤"},{"id":11713,"word":"呼天钥地","pinyin":"hū tiān yào dì","abbr":"htyd","explanation":"指呼喊天地以求救助。"},{"id":11714,"word":"呼幺喝六","pinyin":"hū yāo hè liù","abbr":"hyhl","explanation":"幺、六：骰子的点了。掷骰子时的喊声。泛指赌博。也形容吆喝。","source":{"text":"咱则道舌刺刺言十妄九，村棒棒呼幺喝六。","book":"元·无名氏《气英布》第三折"},"example":{"text":"看见楼上灯烛辉煌，夹着～的声音，甚是热闹。","book":"《负曝闲谈》第五回"},"similar":["呼卢喝雉","盛气凌人","指手划脚"],"opposite":["卑躬屈膝","低声下气"],"usage":"作谓语、状语；指赌博"},{"id":11715,"word":"呼应不灵","pinyin":"hū yìng bù líng","abbr":"hybl","explanation":"指消息不能正常传递，指挥不能正常进行。","source":{"text":"真实不过有点呼应不灵，到得后来，渐渐的这个官竟象他二人做的一样。","book":"清·李宝嘉《官场现形记》第五回"},"usage":"作谓语、宾语、定语；用于做事"},{"id":11716,"word":"呼庚呼癸","pinyin":"hū gēng hū guǐ","abbr":"hghg","explanation":"庚、癸：天干的第七位和第十位，古时用作军粮的隐语。原是军中乞粮的隐语。后指向人借钱。","source":{"text":"梁则无矣，粗粮有之，若登首山以呼，曰：‘庚癸乎！’则诺。","book":"《左传·哀公十三年》记载：春秋时吴王夫差与晋、鲁等国会盟，吴大夫申叔仪向鲁大夫公孙有山氏乞粮。回答说"},"example":{"text":"况时逢丰穰，～，一岁自兆重登。","book":"明·张岱《杂著·失题》"},"similar":["庚癸之呼"],"usage":"作宾语；指向人借钱","story":["春秋时期，吴王夫差与晋、鲁等国会盟，吴国大夫申叔仪向鲁国大夫公孙有山氏借军粮，大家不好直说，只好用隐语代替。鲁国大夫公孙有回答说：“高梁已经没有了，粗粮还有一些，到时登上山高声呼喊：‘庚癸乎！’我们就知道了。”"]},{"id":11717,"word":"呼昼作夜","pinyin":"hū zhòu zuò yè","abbr":"hzzy","explanation":"昼：白天。把白天叫作夜晚。比喻颠倒黑白，不分是非。","source":{"text":"且不可呼昼作夜，更饶善巧，终不能指东为西。","book":"宋·释道原《景德传灯录》卷二十"}},{"id":11718,"word":"呼朋唤友","pinyin":"hū péng huàn yǒu","abbr":"hphy","explanation":"指招引意气相投的人。","source":{"text":"呼朋唤友把窑子进。身入迷魂，装烟倒茶，好不殷勤。","book":"《白雪遗音·马头调·逛窑子》"},"example":{"text":"～，把他一班三老四少、打鱼摸虾的老朋友们都提拔做小组长了。","book":"周立波《暴风骤雨》第二部"},"similar":["呼朋引类"],"usage":"作谓语、分句；指招引意气相投的人"},{"id":11719,"word":"呼朋引类","pinyin":"hū péng yǐn lèi","abbr":"hpyl","explanation":"呼：叫；引：招来；类：同类。指招引志趣相同的人。","source":{"text":"奈何引类呼朋，摇头鼓翼。","book":"宋·欧阳修《憎苍蝇赋》"},"example":{"text":"丹士～，又去约了两三个帮手来做。","book":"明·凌濛初《初刻拍案惊奇》卷十八"},"similar":["同类呼朋","相互勾结"],"usage":"作谓语；指招引志趣相同的人"},{"id":11720,"word":"呼来喝去","pinyin":"hū lái hè qù","abbr":"hlhq","explanation":"呼、喝：大声喊叫。呼之即来，喝之即去。形容随意驱使。","source":{"text":"这菩萨卖弄神通，把老孙这等呼来喝去，全不费力也！","book":"明·吴承恩《西游记》第四十二回"}},{"id":11721,"word":"呼牛也可，呼马也可","pinyin":"hū niú yě kě，hū mǎ yě kě","abbr":"hnykhmyk","explanation":"呼：称呼；可：可以。叫我牛也好，叫我马也好，我不在乎。指不管别人说什么，自己还是按自己意愿去做。","source":{"text":"昔者子呼我牛也，而谓之牛；呼我马也，而谓之马。","book":"战国·宋·庄周《庄子·天道》"},"example":{"text":"却又一片深心，打了个～的主意，任是谁说什么，我只拿定主意，干我的大事去。","book":"清·文康《儿女英雄传》第17回"},"similar":["呼牛呼马","呼马呼牛","呼牛作马"],"usage":"作宾语、定语；用于口语"},{"id":11722,"word":"呼牛作马","pinyin":"hū niú zuò mǎ","abbr":"hnzm","explanation":"比喻别人骂也好，称赞也好，决不计较。同“呼牛呼马”。","source":{"text":"昔者子呼我牛也，而谓之牛，呼我马也，而谓之马。","book":"《庄子·天道》"},"example":{"text":"时不偶，且躬操敝帚，任他人～，只低头。","book":"明·徐复祚《宵光记·慰弟》"},"similar":["呼牛呼马","呼马呼牛"],"usage":"作谓语；指毁誉由人，悉听自然"},{"id":11723,"word":"呼牛呼马","pinyin":"hū niú hū mǎ","abbr":"hnhm","explanation":"呼：称呼。称我牛也好，称我马也好。比喻别人骂也好，称赞也好，决不计较。","source":{"text":"昔者子呼我牛也，而谓之牛，呼我马也，而谓之马。","book":"《庄子·天道》"},"example":{"text":"～，无关轻重也。","book":"清·俞樾《七侠五义序》"},"similar":["呼牛呼马","呼牛作马"],"usage":"作谓语；指毁誉由人，悉听自然"},{"id":11724,"word":"呼群结党","pinyin":"hū qún jié dǎng","abbr":"hqjd","explanation":"指招引同伙，聚集成帮。","source":{"text":"夏初，楚兵昼夺十三行，背负肩担而去，呼群结党，散赴各乡，累日不归，不知所事。","book":"清·黄钧宰《金壶浪墨·疲兵》"},"similar":["拉帮结派"],"usage":"作谓语、定语；用于处事"},{"id":11725,"word":"呼蛇容易遣蛇难","pinyin":"hū shé róng yì qiǎn shé nán","abbr":"hsryqsn","explanation":"把蛇引过来容易，但要把它赶走就困难了。比喻招小人来容易，而要把他打发走就困难了。","source":{"text":"你将为常言俗语道：呼蛇容易遣蛇难。怕日久岁深，盘费重大。","book":"江东老蟫《京本通俗小说》第十三回"}},{"id":11726,"word":"呼风唤雨","pinyin":"hū fēng huàn yǔ","abbr":"hfhy","explanation":"旧指神仙道士的法力。现比喻人具有支配自然的伟大力量。也可形容反动势力猖獗。","source":{"text":"罨画溪头乌鸟乐，呼风唤雨不能休。","book":"宋·孙觌《罨溪行》"},"example":{"text":"兄弟，你真是玛志尼一流人物，天生成～，搅得一国的原动力的了。","book":"清·梁启超《新中国未来记》第三回"},"similar":["兴风作浪","推波助澜","兴妖作怪"],"opposite":["息事宁人"],"usage":"作谓语、宾语、定语、状语；指有非凡的本事"},{"id":11727,"word":"呼马呼牛","pinyin":"hū mǎ hū niú","abbr":"hmhn","explanation":"呼：称呼。叫我牛也好，叫我马也好，我不在乎。","source":{"text":"论理法难听受，总不如装聋塞耳，一任他呼马呼牛。","book":"明·冯惟敏《耍孩儿·十自由》"},"similar":["呼牛呼马","呼牛作马"],"usage":"作谓语；指毁誉由人，悉听自然"},{"id":11728,"word":"呼鹰走狗","pinyin":"hū yīng zǒu gǒu","abbr":"hyzg","explanation":"放出鹰狗去追捕野兽。指打猎游荡的生活。","source":{"text":"放出鹰狗去追捕野兽。指打猎游荡的生活。"}},{"id":11729,"word":"命与仇谋","pinyin":"mìng yǔ chóu móu","abbr":"mycm","explanation":"仇：仇敌。命运使自己经常与仇人打交道。形容命运不好，常遇挫折。","source":{"text":"命与仇谋，取败几时。","book":"唐·韩愈《进学解》"},"similar":["命运多舛"],"usage":"作谓语、定语；指命运不好"},{"id":11730,"word":"命世之才","pinyin":"mìng shì zhī cái","abbr":"mszc","explanation":"原指顺应天命而降世的人才。后多指名望才能为世人所重的杰出人才。亦作“命世之英”、“命世之雄”。","source":{"text":"贾谊、亚夫之徒，皆信命世之才，抱将相之具。","book":"汉·李陵《答苏武书》"},"example":{"text":"有侄萧衍，年虽幼小，智识不凡，～。","book":"明·冯梦龙《喻世明言》卷三十七"},"usage":"作宾语；用于名人"},{"id":11731,"word":"命世之英","pinyin":"mìng shì zhī yīng","abbr":"mszy","explanation":"原指顺应天命而降世的人才。后多指名望才能为世人所重的杰出人才。","source":{"text":"吴、蜀二国四州之地，大王命世之英，诸葛亮亦一时之杰也。","book":"《三国志·蜀志·邓芝传》"},"example":{"text":"懿维我祖，～。","book":"毛泽东《祭文·祭黄帝陵》"}},{"id":11732,"word":"命中注定","pinyin":"mìng zhōng zhù dìng","abbr":"mzzd","explanation":"迷信的人认为人的一切遭遇都是命运预先决定的，人力无法挽回。","source":{"text":"这是我命中注定，该做他家的女婿。","book":"明·冯梦龙《醒世恒言》"},"example":{"text":"他～要身败名裂的。"},"similar":["命里注定"],"usage":"作谓语、宾语、分句；指宿命论"},{"id":11733,"word":"命俦啸侣","pinyin":"mìng chóu xiào lǚ","abbr":"mcxl","explanation":"命、啸：呼引，呼唤；俦、侣：同伴。招乎意气相投的人，一道从事某一活动。","source":{"text":"众灵杂还，命俦啸侣。","book":"三国魏·曹植《洛神赋》"},"example":{"text":"临水登山，～。","book":"梁元帝《怀旧志序》"},"similar":["呼朋引类"],"usage":"作谓语；指呼朋引类"},{"id":11734,"word":"命在旦夕","pinyin":"mìng zài dàn xī","abbr":"mzdx","explanation":"旦夕：早晚之间，形容极短的时间。生命垂危，很快会死去。","source":{"text":"尽病水肿，命在旦夕。","book":"唐·陈子昂《为建安王与诸将书》"},"example":{"text":"今日之中国，又积数千年之沈疴，合四百兆之痼疾，盘踞膏肓，～者也。","book":"清·梁启超《新民说·附录》"},"similar":["命在朝夕"],"usage":"作谓语、定语；指十分危险"},{"id":11735,"word":"命在朝夕","pinyin":"mìng zài zhāo xī","abbr":"mzcx","explanation":"命：生命。生命就在早晚之间。形容生命垂危。","source":{"text":"素愚，加以年老被病，命在朝夕，随使君上道，必死道路。","book":"东汉·班固《汉书·龚胜传》"},"similar":["命在旦夕"],"usage":"作谓语、定语；指十分危险"},{"id":11736,"word":"命如丝发","pinyin":"mìng rú sī fà","abbr":"mrsf","explanation":"性命就像挂在一根细线、一丝头发上。形容生命十分危险。","source":{"text":"臣为贼所围，命如丝发，赖茂负臣逾城。","book":"《后汉书·刘茂传》"},"example":{"text":"田悦逆贼，在重围，～，使我叛君弃兄，发兵昼夜赴之，幸而得存。","book":"《资治通鉴·唐纪·德宗兴元元年》"}},{"id":11737,"word":"命悬一线","pinyin":"mìng xuán yī xiàn","abbr":"mxyx","explanation":"形容处境十分危险。","similar":["命若悬丝","命在旦夕"],"opposite":["安然无恙","平安无事"]},{"id":11738,"word":"命染黄沙","pinyin":"mìng rǎn huáng shā","abbr":"mrhs","explanation":"染：沾上。身体挨上黄沙。指死亡。","source":{"text":"倘若大限来到来，身归泉世，命染黄沙，如何留得？","book":"明·洪楩《清平山堂话本·张子房慕道记》"},"example":{"text":"不期命蹇，染了疯疾，满身麻木，不能行动，几乎～。","book":"明·清溪道人《禅真逸史》第二十回"},"similar":["马革裹尸"],"usage":"作谓语、定语；指死亡"},{"id":11739,"word":"命根子","pinyin":"mìng gēn zǐ","abbr":"mgz","explanation":"有生命或精力来源的东西。比喻最受人重视的晚辈或最重要或最受重视的事物。","source":{"text":"她看见母亲和姐姐坐在炕上哭，知道猪还没喂——这口猪可是他们家的命根子呀！","book":"路遥《平凡的世界》第一卷第六章"},"example":{"text":"贾宝玉是贾母的～。"},"usage":"作宾语、定语；用于比喻句"},{"id":11740,"word":"命缘义轻","pinyin":"mìng yuán yì qīng","abbr":"myyq","explanation":"缘：因为，由于。生命由于崇高的道义而显得轻微。比喻为了道义可以牺牲一切。","source":{"text":"又专诸、荆卿之感激，侯生、豫子之投身，情为恩使，命缘义轻。","book":"《后汉书·朱晖传附朱穆传》"}},{"id":11741,"word":"命舛数奇","pinyin":"mìng chuǎn shù jī","abbr":"mcsq","explanation":"舛：不顺，不幸；奇：单数，古人认为单数不吉。指命运不好，事多不顺利。用以形容人的经历坎坷，潦倒失意。","source":{"text":"数奇命蹇，遂无望于高门；日往月来，竟消声于下邑。","book":"唐·杨炯《原州百泉县令李君神道碑》"}},{"id":11742,"word":"命若悬丝","pinyin":"mìng ruò xuán sī","abbr":"mrxs","explanation":"比喻生命垂危。","source":{"text":"今张纡失信，众羌大动，经常屯兵，不下二万，转运之费，空竭府帑，凉州吏人，命县丝发。","book":"《后汉书·邓训传》"},"example":{"text":"吾～，专望救援。","book":"明·罗贯中《三国演义》第三十六回"},"similar":["危在旦夕","奄奄一息"],"usage":"作谓语；比喻生命垂危"},{"id":11743,"word":"命薄相穷","pinyin":"mìng bó xiāng qióng","abbr":"mbxq","explanation":"命薄：命运不好，没有福分；相：长相。生来命运不好，没有福分，一副穷相。","source":{"text":"命薄相穷，不称此职，不敢受也。","book":"明·罗贯中《三国演义》第六十九回"}},{"id":11744,"word":"命薄缘悭","pinyin":"mìng báo yuán qiān","abbr":"mbyq","explanation":"指命运坏，缘分浅。","source":{"text":"不必多吁多叹，恨命薄缘悭，功名恩爱两难全。","book":"明·王玉峰《焚香记·饯别》"},"example":{"text":"维明也笑道：“怎能～。”","book":"《天雨花》第五回"},"usage":"作谓语、定语；指命运不好"},{"id":11745,"word":"命词遣意","pinyin":"mìng cí qiǎn yì","abbr":"mcqy","explanation":"运用文词表达思想。同“命辞遣意”。","source":{"text":"军檄笺启，日有百数，新楷命词遣意，轻重悉宜。","book":"王闿运《郭新楷传》"},"similar":["命辞遣意","遣词造句"],"usage":"作谓语、宾语；指作文"},{"id":11746,"word":"命该如此","pinyin":"mìng gāi rú cǐ","abbr":"mgrc","explanation":"命里注定就应该是这样。是一种迷信的、唯心的说法。","source":{"text":"如今木已成舟，也是林兄命该如此了。","book":"清·李汝珍《镜花缘》第三十四回"},"example":{"text":"倘若被水淹死了，虽然是你～，总算要是没于王事。","book":"清·李宝嘉《官场现形记》第三十回"}},{"id":11747,"word":"命蹇时乖","pinyin":"mìng jiǎn shí guāi","abbr":"mjsg","explanation":"蹇：一足偏废，引伸为不顺利；乖：不顺利。指命运不济，遭遇坎坷。这是唯心主义宿命论的观点。","source":{"text":"大古来布衣走上金銮殿，可甚么笙歌引至画堂前，也是我时乖命蹇。","book":"元·乔孟符《金钱记》第三折"},"example":{"text":"不想我今日被高俅那贼陷害，流落到此，天地也不容我，直如此～。","book":"明·施耐庵《水浒全传》第十一回"},"similar":["时运不济"],"usage":"作宾语；指命运不济"},{"id":11748,"word":"命轻鸿毛","pinyin":"mìng qīng hóng máo","abbr":"mqhm","explanation":"鸿毛：大雁的毛。生命轻如鸿毛。形容生命毫无价值。","source":{"text":"人固有一死，或重于泰山，或轻于鸿毛。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"臣德薄蝉翼，～，累蒙国恩，猥厕朝列。","book":"《旧唐书·郭子仪传》"}},{"id":11749,"word":"命辞遣意","pinyin":"mìng cí qiǎn yì","abbr":"mcqy","explanation":"运用文词表达思想。亦作“命词遣意”。","source":{"text":"变风中固多好诗，虽其间有没意思者。然亦须得其命辞遣意方可。","book":"《朱子语类》卷八十"},"similar":["命词遣意"],"usage":"作谓语、宾语；指作文"},{"id":11750,"word":"命运多舛","pinyin":"mìng yùn duō chuǎn","abbr":"mydc","explanation":"舛：违背。一生经历坎坷，遭遇不好。","source":{"text":"时运不济，命运多舛。","book":"唐·王勃《滕王阁序》"},"similar":["时运不济"],"usage":"作谓语、定语、宾语；指命运不好"},{"id":11751,"word":"命途多舛","pinyin":"mìng tú duō chuǎn","abbr":"mtdc","explanation":"舛：不顺，不幸。命运充满不顺。指一生坎坷，屡受挫折。","source":{"text":"时运不齐，命途多舛。","book":"唐·王勃《滕王阁饯别序》"},"example":{"text":"而兄以青～，家室飘零，尤垂青眼，青非木石，安得木然无动于中？","book":"张恨水《春明外史》第五十二回"}},{"id":11752,"word":"命里注定","pinyin":"mìng lǐ zhù dìng","abbr":"mlzd","explanation":"旧时迷信说法，命运早已决定安排好了。亦作“命中注定”。","source":{"text":"这是我命中注定，该做他家的女婿。","book":"明·冯梦龙《醒世恒言》卷七"},"example":{"text":"可见人有得那横财的，都也是各人的～。","book":"清·西周生《醒世姻缘传》第一百回"},"similar":["命中注定"],"usage":"作谓语、宾语、定语；指宿命论"},{"id":11753,"word":"咀嚼英华","pinyin":"jǔ jué yīng huá","abbr":"jjyh","explanation":"咀嚼：用牙齿磨碎食物，比喻反复体会；英华：此指精华。比喻细细体会文章中的精华。","source":{"text":"才高词赡，举体华美。气少于公幹，文劣于仲宣。尚规矩，不贵绮错，有伤直致之奇。然其咀嚼英华，厌饫膏泽，文章之渊泉也。张公叹其大才，信矣！","book":"南朝·梁·钟嵘《诗品·晋平原相陆机》"},"example":{"text":"五者不去，虽心希难老，口诵至言，～，呼吸太阳，不能回其操，不免夭其年。","book":"宋·张君房《云笈七签》卷三十五"},"usage":"作谓语；用于比喻句"},{"id":11754,"word":"咂嘴咂舌","pinyin":"zā zuǐ zā shé","abbr":"zzzs","explanation":"形容贪吃的馋相。亦表示食物味道美好。","source":{"text":"菜上来了，老头儿咂嘴咂舌地夸奖这菜的滋味。","book":"端木蕻良《科尔沁旗草原》二"},"similar":["咂嘴舔唇","咂嘴弄舌"],"usage":"作谓语、定语、状语；指人吃惊"},{"id":11755,"word":"咂嘴弄唇","pinyin":"zā zuǐ nòng chún","abbr":"zznc","explanation":"表示惊奇或为难。","source":{"text":"［王举人］眼看见那小学生的仿纸上的名字是荀玫，不觉就吃了一惊；一会儿咂嘴弄唇的，脸上做出许多怪物像。","book":"清·吴敬梓《儒林外史》第二回"},"similar":["咂嘴弄舌"],"usage":"作谓语、定语；指人吃惊"},{"id":11756,"word":"咂嘴弄舌","pinyin":"zā zuǐ nòng shé","abbr":"zzns","explanation":"形容贪馋的样子。","source":{"text":"他一时慌了，弯下腰去抓那粉汤，又被两个狗争着，咂嘴弄舌的来抢那地下的粉汤吃。","book":"清·吴敬梓《儒林外史》第十回"},"example":{"text":"菜上来了，老头子～地夸奖这菜的味道。","book":"端木蕻良《科尔沁旗草原》"},"similar":["咂嘴弄唇","咂嘴咂舌","咂嘴舔唇"],"usage":"作谓语、定语、状语；指人吃惊"},{"id":11757,"word":"咂嘴舔唇","pinyin":"zā zuǐ tiǎn chún","abbr":"zztc","explanation":"形容贪馋的样子。亦表示食物味道美好。","source":{"text":"武震却吃得又香又甜，一面吃一面还咂嘴舔唇的，品着滋味。","book":"杨朔《三千里江山》第十段"},"similar":["咂嘴弄舌","咂嘴咂舌"],"usage":"作谓语、定语；指人吃惊"},{"id":11758,"word":"咂舌攒眉","pinyin":"zā shé cuán méi","abbr":"zscm","explanation":"形容人吃酸物的表情或惊讶的神情","source":{"text":"一人咂舌攒眉曰：‘如何有此酸酒，莫不把醋错拿了来？’","book":"清·游戏主人《笑林广记》第三卷"},"usage":"作定语、状语；用于人的表情"},{"id":11759,"word":"咄咄书空","pinyin":"duō duō shū kōng","abbr":"ddsk","explanation":"形容失志、懊恨之态。","source":{"text":"《晋书·殷浩传》载殷浩虽被黜放，口无怨言，但终日书空作“咄咄怪事”四字。"},"example":{"text":"[梁鼎芬]既失志，有～之感，去秋，遂因政变作符命数篇，诗以记之。","book":"章炳麟《梁园客》诗自注"},"usage":"作宾语、定语；用于人的情态"},{"id":11760,"word":"咄咄怪事","pinyin":"duō duō guài shì","abbr":"ddgs","explanation":"表示吃惊的声音。形容不合常理，难以理解的怪事。","source":{"text":"殷中军（殷浩）被废在信安，终日恒书空作字，扬州吏民寻义逐之，窃视，唯作‘咄咄怪事’四字而已。","book":"南朝·宋·刘义庆《世说新语·黜免》"},"example":{"text":"噫！一小说之微，而竟有如斯之法律，以圭臬于著述界之前途，亦～，～。","book":"清·陶曾佑《论小说之势力及其影响》"},"similar":["莫名其妙","不可思议"],"opposite":["合情合理","顺理成章","天经地义"],"usage":"作宾语；与“岂非”、“真是”等连用","story":["东晋扬州刺史殷浩与大将桓温不合，王羲之劝他大敌当前应以国事为重，殷浩不但不听，领兵北伐，屡战屡败，被废为平民，流放到信安，他整天无忧无虑地读书吟诗，老是在纸上写“咄咄怪事”四个字来表示心中的不平"]},{"id":11761,"word":"咄咄逼人","pinyin":"duō duō bī rén","abbr":"ddbr","explanation":"咄咄：使人惊奇的声音。形容气势汹汹，盛气凌人，使人难堪。也指形势发展迅速，给人压力。","source":{"text":"卫有一弟子王逸少，甚能学卫真书，咄咄逼人。","book":"晋·卫铄《与释某书》"},"example":{"text":"书中攻击杨朱、墨翟两派，辞锋～。","book":"朱自清《经典常谈·四书第七》"},"similar":["盛气凌人","气势汹汹"],"opposite":["和颜悦色","温文尔雅"],"usage":"作谓语、定语、状语；指气势汹汹的样子","story":["东晋文学家顾恺之到殷仲堪家中做客，恒温的儿子恒玄也在，三人高兴抽签玩文字游戏，就“危”字他们说道：“矛头淅米剑头炊”、“百岁老翁攀枯枝”、“井上辘轳卧婴儿”，殷仲堪部下参军咄咄逼人道“盲人骑瞎马，夜半临深池”"]},{"id":11762,"word":"咄嗟之间","pinyin":"duō jiē zhī jiān","abbr":"djzj","explanation":"一呼一诺之间。表示时间极短。","source":{"text":"乌合之众，易可崩离。若简练骁勇，衔枚夜袭，径趋营下，出其不意，咄嗟之间，便可擒殄。","book":"《北齐书·李浑传》"},"similar":["转瞬之间"],"usage":"作宾语、分句；形容时间很短"},{"id":11763,"word":"咄嗟便办","pinyin":"duō jiē biàn bàn","abbr":"djbb","explanation":"咄嗟：一呼一诺之间，形容时间短。比喻马上就办到。","source":{"text":"石崇为客作豆粥，咄嗟便办。","book":"南朝·宋·刘义庆《世说新语·汰侈》"},"example":{"text":"你吩咐的事情，我们～。"},"similar":["立等可取","咄嗟立办"],"usage":"作谓语；比喻马上就可办到"},{"id":11764,"word":"咄嗟叱咤","pinyin":"duō jiē chì zhà","abbr":"djcz","explanation":"咄嗟、叱咤：发怒时大声呵叱、吆喝。形容发怒时大声喊叫的声音。","source":{"text":"昔者项籍有百战百胜之威而执诸侯之柄，咄嗟叱咤奋其暴怒。","book":"宋·苏辙《三国论》"},"usage":"作谓语、状语；用于人发怒"},{"id":11765,"word":"咄嗟立办","pinyin":"duō jiē lì bàn","abbr":"djlb","explanation":"咄嗟：一呼一诺之间，形容时间短。比喻马上就办到。","source":{"text":"石崇为客作豆粥，咄嗟便办。","book":"南朝·宋·刘义庆《世说新语·汰侈》"},"example":{"text":"是故为山九仞，可以篑土积成，峻宇雕墙，可以～。","book":"清·无名氏《杜诗言志》卷二"},"similar":["咄嗟便办"],"usage":"作谓语；比喻马上就可办到"},{"id":11766,"word":"咆哮如雷","pinyin":"páo xiāo rú léi","abbr":"pxrl","explanation":"形容人暴怒喊叫的神态。","source":{"text":"章琪大怒，丢下讨李来打那汉，那汉咆哮如雷，伸开一双蓝手，劈面交还，打在一处。","book":"明·罗贯中《粉妆楼》第三十八回"},"example":{"text":"曾沧海舞着那半段鸦片烟枪，～，一手抢起一枝锡烛台，就又避面掷过去。","book":"茅盾《子夜》四"},"usage":"作谓语、状语；指人暴怒喊叫的神态"},{"id":11767,"word":"咋舌不下","pinyin":"zhà shé bù xià","abbr":"zsbx","explanation":"咋舌：咬舌或忍住不言。形容不敢说话或说不出话来，极度悔恨或畏缩。","source":{"text":"岂有知其无成，而但萎腲咋舌，叉手从族乎？","book":"南朝·宋·范晔《后汉书·马援传》"},"usage":"作谓语、定语；指人的态度"},{"id":11768,"word":"和乐且孺","pinyin":"hé lè qiě rú","abbr":"hlqr","explanation":"孺：孩子，这里指孩子气。随和乐观，孩子气十足。"},{"id":11769,"word":"和事不表理","pinyin":"hé shì bù biǎo lǐ","abbr":"hsbbl","explanation":"和事：平息争端；表理：摆道理，讲理。只平息争端，而不去评论是非曲直。"},{"id":11770,"word":"和事老","pinyin":"hé shì lǎo","abbr":"hsl","explanation":"和事：平息事件或争端。调停争端的人。多指不讲原则，不问是非而一味劝使双方和解之人。也指对任何事情都漠不关心的人。","source":{"text":"中宗不能穷也，诏琬与楚客，处讷约兄弟两解之，故世谓帝为‘和事天子’。","book":"《新唐书·宗楚客传》"},"example":{"text":"就待我去见三府公，讲一讲明，与你们做个～罢。","book":"元·无名氏《鼓掌绝尘·月集》第七回"},"similar":["和事佬"],"usage":"作宾语、定语；用于口语"},{"id":11771,"word":"和光同尘","pinyin":"hé guāng tóng chén","abbr":"hgtc","explanation":"和、同：混合。和光：混合各种光彩；同尘：与尘俗相同。指不露锋芒，与世无争的消极处世态度。也比喻同流合污。","source":{"text":"和其光，同其尘。","book":"《老子》第四章"},"example":{"text":"休要欺三瞒四，我赵某不是与你～的。","book":"明·冯梦龙《警世通言》卷二十一"},"similar":["浑俗和光","与世无争"],"usage":"作谓语、定语；指随俗而处"},{"id":11772,"word":"和合双全","pinyin":"hé hé shuāng quán","abbr":"hhsq","explanation":"和：和睦；合：投合。用于祝贺新婚夫妇终生和睦相处，白头偕老。","source":{"text":"回手又把腕上的一幅金镯子褪下来，给他带上，圈口大小，恰如合适，说：‘和合双全的罢。’","book":"清·文康《儿女英雄传》第十二回"},"usage":"作谓语、定语；用于祝福"},{"id":11773,"word":"和和气气","pinyin":"hé hé qì qì","abbr":"hhqq","explanation":"态度平顺温和。","source":{"text":"你们一心一计和和气气的，省得我是你们眼里的刺似的。只有一件，你们知好歹只疼我那孩子就是了。","book":"清·曹雪芹《红楼梦》第101回"},"example":{"text":"王朔《一半是火焰，一半是海水》：“他～同我们聊了会儿，喝了吴迪沏的绿茶。”"},"similar":["客客气气"],"opposite":["恶声恶气"],"usage":"作定语、状语；用于人际交往"},{"id":11774,"word":"和和睦睦","pinyin":"hé hé mù mù","abbr":"hhmm","explanation":"指相处融洽友好。","source":{"text":"你们为什么要这样？难道你们不能走到一块和和睦睦过日子吗？","book":"路遥《平凡的世界》第四卷第38章"},"similar":["和和谐谐"],"usage":"作定语、状语；用于口语"},{"id":11775,"word":"和如琴瑟","pinyin":"hé rú qín sè","abbr":"hrqs","explanation":"比喻夫妻相亲相爱。","source":{"text":"妻子好合，如鼓琴瑟。","book":"《诗经·小雅·常棣》"}},{"id":11776,"word":"和容悦色","pinyin":"hé róng yuè sè","abbr":"hrys","explanation":"形容和善可亲。同“和颜悦色”。","source":{"text":"那凤姐却是和容悦色，满嘴里‘好妹妹’不离口。","book":"《红楼梦》第六八回"},"example":{"text":"[张姑娘]先～，低声下气的叫了声姐姐。","book":"《儿女英雄传》第二五回"},"similar":["和颜悦色"],"opposite":["凶神恶煞"],"usage":"作定语、状语；形容和善可亲"},{"id":11777,"word":"和尚吃八方","pinyin":"hé shàng chī bā fāng","abbr":"hscbf","explanation":"比喻向各处伸手，捞好处占便宜。","source":{"text":"俗话说：和尚吃八方。他家太太老伯连着师姑庵里的钱都会募了来做好事，也算神通广大了。","book":"清·李宝嘉《官场现形记》第三十四回"}},{"id":11778,"word":"和平共处","pinyin":"hé píng gòng chǔ","abbr":"hpgc","explanation":"彼此不发生军事冲突而共存。","source":{"text":"处理国与国之间的关系，和平共处五项原则是最好的方式。","book":"邓小平《和平共处原则具有强大生命力》"},"similar":["和平共存","相安无事"],"usage":"作谓语、定语、状语；同“相安无事”"},{"id":11779,"word":"和氏之璧，夜光之珠","pinyin":"hé shì zhī bì，yè guāng zhī zhū","abbr":"hszbygzz","explanation":"和氏：春秋时楚人卞和；璧：玉器。指世上罕有的珍宝。","source":{"text":"和氏之璧，焉得独曜于郢握；夜光之珠，何得未玩于随掌？","book":"晋·刘琨《答卢谌诗一首并书》"},"similar":["和氏之璧，隋侯之珠"],"usage":"作宾语、定语；指珍贵的东西"},{"id":11780,"word":"和氏之璧，隋侯之珠","pinyin":"hé shì zhī bì，suí hóu zhī zhū","abbr":"hszbshzz","explanation":"和氏：春秋时楚人卞和；璧：玉器；隋侯：周代姬姓诸侯。指世上罕有的珍宝。","source":{"text":"譬如隋侯之珠，和氏之璧，得之者富，失之者贫。","book":"西汉·刘安《淮南子·览冥训》"},"similar":["和璧隋珠","和氏之璧，夜光之珠"],"usage":"作宾语、定语；指珍贵的东西","story":["春秋时珠宝匠卞和发现一块璞玉，进献给楚厉王，楚厉王砍了他的左脚；进献给楚武王，楚武王砍了他的右脚，只有楚文王识货，这块玉叫“和氏璧”。“汉东之国”姓姬的隋侯救蛇，蛇吐出一颗大珍珠报答他，这颗珍珠就是“隋珠”"]},{"id":11781,"word":"和气生财","pinyin":"hé qì shēng cái","abbr":"hqsc","explanation":"指待人和善能招财进宝。","source":{"text":"一个人总要和气些，‘和气生财’，对不对？","book":"鲁迅《彷徨·离婚》"},"example":{"text":"老人一辈子最重要的格言是‘～’。","book":"老舍《四世同堂》"},"opposite":["两败俱伤"],"usage":"作谓语、定语、宾语；指生意之道"},{"id":11782,"word":"和气致祥","pinyin":"hé qì zhì xiáng","abbr":"hqzx","explanation":"致：招致。和睦融洽，可致吉祥。","source":{"text":"和气致祥，乖气致异。","book":"《汉书·刘向传》"},"example":{"text":"田家因不分家，那棵紫荆又活转过来，岂不是“～”的明验吗？","book":"清·李汝珍《镜花缘》第七十一回"},"usage":"作谓语；用于劝诫人"},{"id":11783,"word":"和气致祥，乖气致异","pinyin":"hé qì zhì xiáng，guāi qì zhì yì","abbr":"hqzxgqzy","explanation":"和气：温和的气象；致：招致；祥：吉祥；乖气：不和谐的气氛；戾：罪过。和睦融洽的气氛可致吉祥，不和谐的气氛则招致灾祸。","source":{"text":"由此观之，和气致祥，乖气致异。祥多者其国安，异众者其国危，天地之常经，古今之通义也。","book":"《汉书·刘向传》"},"similar":["和气致祥，乖气致戾"],"usage":"作宾语、定语、分句；用于书面语"},{"id":11784,"word":"和气致祥，乖气致戾","pinyin":"hé qì zhì xiáng，guāi qì zhì lì","abbr":"hqzxgqzl","explanation":"和气：和睦；乖气：不和顺；戾：罪过。和睦招致吉祥，不和招致灾祸。","source":{"text":"和气致祥，乖气致戾，处家固然也，即涉世亦何不莫然！","book":"清·百一居士《壶天录》中卷"},"similar":["和气致祥，乖气致异"],"usage":"作宾语、定语、分句；用于书面语"},{"id":11785,"word":"和璧隋珠","pinyin":"hé bì suí zhū","abbr":"hbsz","explanation":"和壁：和氏璧，隋珠：古传说中的夜明珠。比喻极珍贵的东西。","source":{"text":"和氏之璧，不饰以五采；隋侯之珠，不饰以银黄；其质之美，物不足以饰之。","book":"《韩非子·解老》"},"example":{"text":"去奇伎淫巧，损～，不见可欲，使心不乱，自然波清四海，尘消九城。","book":"唐·张庭珪《请勤政王崇俭约疏》"},"similar":["奇珍异宝"],"usage":"作宾语、定语；比喻极名贵的东西","story":["春秋时珠宝匠卞和发现一块璞玉，进献给楚厉王，楚厉王砍了他的左脚；进献给楚武王，楚武王砍了他的右脚，只有楚文王识货，这块玉叫“和氏璧”。“汉东之国”姓姬的隋侯救蛇，蛇吐出一颗大珍珠报答他，这颗珍珠就是“隋珠”"]},{"id":11786,"word":"和盘托出","pinyin":"hé pán tuō chū","abbr":"hptc","explanation":"和：连同。连盘子也端出来了。比喻全都讲出来，毫不保留。","source":{"text":"今日特为你起模画样，和盘托出。","book":"元·明本述《天目中峰和尚广录》卷十六"},"example":{"text":"现在除非把这事～，再添上些枝叶，或者可以激怒于他，稍助一臂之力。","book":"清·李宝嘉《官场现形记》第二十七回"},"similar":["言无不尽","直言不讳","畅所欲言"],"opposite":["含糊其词","闪烁其辞","讳莫如深"],"usage":"作谓语；比喻全都讲出来，毫不保留"},{"id":11787,"word":"和睦相处","pinyin":"hé mù xiāng chǔ","abbr":"hmxc","explanation":"彼此和好地相处。","source":{"text":"上下和睦，周旋不逆。","book":"春秋·鲁·左丘明《左传·成公六年》"},"example":{"text":"我们要～，团结友爱。"},"similar":["和平共处","天伦之乐"],"opposite":["同床异梦","骨肉相残","自相残杀"],"usage":"作谓语、宾语；用于人际关系"},{"id":11788,"word":"和稀泥","pinyin":"huò xī ní","abbr":"hxn","explanation":"比喻调和纷争。","example":{"text":"你又在～了。"},"similar":["抹稀泥"],"usage":"作谓语、定语、宾语；指无原则地调和折中"},{"id":11789,"word":"和而不同","pinyin":"hé ér bù tóng","abbr":"hebt","explanation":"和：和睦；同：苟同。和睦地相处，但不随便附和。","source":{"text":"君子和而不同，小人同而不和。","book":"《论语·子路》"},"example":{"text":"彼既人而无礼，此亦～。","book":"《旧五代史·世袭列传》"},"usage":"作谓语、状语；指为人处世"},{"id":11790,"word":"和而不唱","pinyin":"hé ér bù chàng","abbr":"hebc","explanation":"赞同别人的意见，不坚持自己的说法。","source":{"text":"和而不唱，知不出乎四城。","book":"《庄子·德充符》"},"usage":"作谓语、定语；用于处事等"},{"id":11791,"word":"和蔼可亲","pinyin":"hé ǎi kě qīn","abbr":"hakq","explanation":"和蔼：和善。态度温和，容易接近。","source":{"text":"迄今才八阅月，绝从生之文法，除苛细之科条，虽若凛不可犯，而实蔼然可亲。","book":"明·李开先《贺邑令贺洪滨奖异序》"},"example":{"text":"假若有人愿意来看他，他是个顶～的人。","book":"老舍《四世同堂》二"},"similar":["平易近人","和颜悦色"],"opposite":["气势汹汹","冷若冰霜","横眉怒目"],"usage":"作谓语、定语、状语；形容人的态度谦和"},{"id":11792,"word":"和蔼近人","pinyin":"hé ǎi jìn rén","abbr":"hajr","explanation":"和蔼：和善。态度温和，容易接近。","source":{"text":"迄今才八阅月，绝从生之文法，除苛细之科条，虽若凛不可犯，而实蔼然可亲。","book":"明·李开先《贺邑令贺洪滨奖异序》"},"example":{"text":"但不知怎的总觉得他其实是～，并不如先前自己揣想那样的可怕。","book":"鲁迅《离婚》"},"similar":["和蔼可亲"],"opposite":["冷若冰霜"],"usage":"作谓语、定语、状语；形容人的态度谦和"},{"id":11793,"word":"和衣而卧","pinyin":"hé yī ér wò","abbr":"hyew","explanation":"和：连着；卧：躺下。穿着衣服躺下睡觉。","source":{"text":"和：连着；卧：躺下。穿着衣服躺下睡觉。"},"example":{"text":"老程师爷是喝得当面退席，～。","book":"清·文康《儿女英雄传》第二十八回"},"similar":["和衣而睡"],"usage":"作谓语、宾语、状语；指穿着衣服睡觉"},{"id":11794,"word":"和衣而睡","pinyin":"hé yī ér shuì","abbr":"hyes","explanation":"和：连着。穿着衣服睡觉。","source":{"text":"因挣扎走了几步，身体愈觉困倦，坐不得一刻，就和衣而睡。","book":"清·名教中人《好逑传》第六回"},"example":{"text":"清·名教中人《好逑传》第六回：“因挣扎走了几步，身体愈觉困倦，坐不得一刻，就～。”"},"similar":["和衣而卧"],"usage":"作谓语、宾语、状语；指穿着衣服睡觉"},{"id":11795,"word":"和衷共济","pinyin":"hé zhōng gòng jì","abbr":"hzgj","explanation":"衷：内心；济：渡。大家一条心，共同渡过江河。比喻同心协力，克服困难。","source":{"text":"同寅协恭和衷哉。”《国语·鲁语下》“夫苦匏不材于人，共济而已。","book":"《尚书·皋陶谟》"},"example":{"text":"他见了启事便跑到书店里来，谈了些～的话。","book":"郭沫若《学生时代·创造十年》"},"similar":["同舟共济","齐心协力","风雨同舟"],"opposite":["貌合神离","离心离德","同床异梦"],"usage":"作谓语、定语、状语；比喻同心协力"},{"id":11796,"word":"和隋之珍","pinyin":"hé suí zhī zhěn","abbr":"hszz","explanation":"和：和氏璧；隋：隋侯珠。像和氏璧和隋侯珠那样的珍贵宝物。形容极其珍贵或极为难得的东西。","source":{"text":"先贱而后贵者，和隋之珍也。","book":"汉·班固《答宾戏》"},"similar":["和璧隋珠","和氏之璧，隋侯之珠"],"usage":"作宾语、定语；指珍贵的东西"},{"id":11797,"word":"和颜悦色","pinyin":"hé yán yuè sè","abbr":"hyys","explanation":"颜：面容；悦：愉快；色：脸色。脸色和霭喜悦。形容和善可亲。","source":{"text":"善柔，谓面柔，和颜悦色以诱人者也。","book":"《论语·季氏》：“友便辟，友善柔、友便佞，损也。”邢昺疏"},"example":{"text":"申子平急上前，～的把原委说了一遍。","book":"清·刘鹗《老残游记》第八回"},"similar":["平易近人","和蔼可亲"],"opposite":["横眉怒目","杀气腾腾","声色俱厉"],"usage":"作定语、状语；形容和善可亲"},{"id":11798,"word":"和颜说色","pinyin":"hé yán yuè sè","abbr":"hyys","explanation":"形容和善可亲。同“和颜悦色”。","source":{"text":"言和颜说色为难也。","book":"《论语·为政》“子夏问孝，子曰：‘色难。’”刘宝楠正义引汉·郑玄注"}},{"id":11799,"word":"和风丽日","pinyin":"hé fēng lì rì","abbr":"hflr","explanation":"指天气温暖而晴朗。","source":{"text":"正是和风丽日，几许繁红嫩绿，雅称嬉游去。","book":"宋·柳永《西平乐》词"},"example":{"text":"那时节～满东园。","book":"元·李爱山《集贤宾·春日伤别》套曲"},"similar":["风和日丽"],"usage":"作宾语、定语；用于天气描写"},{"id":11800,"word":"和风细雨","pinyin":"hé fēng xì yǔ","abbr":"hfxy","explanation":"和风：指春天的风。温和的风，细小的雨。比喻方式和缓，不粗暴。","source":{"text":"清风吹麦垄，细雨濯梅林。","book":"南朝·陈·张正见《陪衡阳王游耆阇寺》"},"example":{"text":"正不寒不暖，～，困人天气。","book":"宋·张先《八宝装》词"},"similar":["和颜悦色","温文尔雅"],"opposite":["暴风骤雨","咄咄逼人"],"usage":"作主语、宾语、定语；指人的态度"},{"id":11801,"word":"咎有应得","pinyin":"jiù yǒu yīng dé","abbr":"jyyd","explanation":"罪过和灾祸完全是应得的。","source":{"text":"虽然李德标一时冒犯，触犯乌绅，咎有应得，但是领取人口要缴领状，是警局的向章，求大人明鉴。","book":"清·张春帆《宦海》第七回"},"example":{"text":"原来我的识见，就正和唐朝的‘不知其源者’相同，贻讥于千载之前，真是～。","book":"鲁迅《后记》"},"similar":["罪有应得"],"opposite":["积善得果"],"usage":"作宾语；指自作自受"},{"id":11802,"word":"咎由自取","pinyin":"jiù yóu zì qǔ","abbr":"jyzq","explanation":"咎：灾祸。灾祸或罪过是自己招来的。指自作自受。","source":{"text":"览其举措，迹其规矩，招祸取咎，无不自己也。","book":"《三国志·齐封等传评》"},"example":{"text":"然而据我看来，他实在是～。","book":"清·吴趼人《二十年目睹之怪现状》第七十回"},"similar":["自食其果","罪有应得","自作自受"],"opposite":["改过自新","回头是岸"],"usage":"作谓语、宾语、定语；指自作自受"},{"id":11803,"word":"咏嘲风月","pinyin":"yǒng cháo fēng yuè","abbr":"ycfy","explanation":"指描写风云月露等景象而思想内容贫乏的写作。同“咏月嘲风”。","source":{"text":"从此每夕辄至，商确古今，咏嘲风月。","book":"清·葆光子《物妖志·虫类·蟒》"},"similar":["咏月嘲风"],"usage":"作谓语、宾语；用于作文等"},{"id":11804,"word":"咏月嘲花","pinyin":"yǒng yuè cháo huā","abbr":"yych","explanation":"指创作诗歌。花和月经常作为诗人歌咏的对象，故称。","source":{"text":"一年年觉此身衰，一日日知前事非。咏月嘲花先要减，登山临水亦宜稀。","book":"唐·白居易《将归渭村先寄舍弟》诗"},"similar":["咏月嘲风"],"usage":"作宾语、定语；用于书面语"},{"id":11805,"word":"咏月嘲风","pinyin":"yǒng yuè cháo fēng","abbr":"yycf","explanation":"指描写风云月露等景象而思想内容贫乏的写作。","source":{"text":"免学他嘲风咏月，污人行止。","book":"晋·王嘉《拾遗记》"},"example":{"text":"～先要减，登山临水亦宜稀。","book":"唐·白居易《将归渭村先寄舍弟》"},"similar":["嘲风咏月","咏嘲风月"],"usage":"作谓语、宾语；指无聊的作品"},{"id":11806,"word":"咏桑寓柳","pinyin":"yǒng sāng yù liǔ","abbr":"ysyl","explanation":"咏的是“桑”，而实际说的是“柳”。比喻借题传情。","source":{"text":"每日一入学中，四处各坐，却八目勾留，或设言托意，或咏桑寓柳，遥以心照，却外面自为避人眼目。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["指桑骂槐"],"usage":"作谓语、定语；用于书面语"},{"id":11807,"word":"咏絮之才","pinyin":"yǒng xù zhī cái","abbr":"yxzc","explanation":"用来赞许能赋诗的女子。","source":{"text":"俄而雪骤，公欣然曰：‘白雪纷纷何所拟？’兄子胡儿曰：‘撒盐空中差可拟。’兄女曰：‘未若柳絮因风起。’公大笑乐。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"抑且～，可与吉人相唱和，故敢衒玉求售，仰扳秦晋，不识肯俯就否？","book":"清·烟霞散人《凤凰池》第十回"}},{"id":11808,"word":"咏雪之慧","pinyin":"yǒng xuě zhī huì","abbr":"yxzh","explanation":"用来赞许能赋诗的女子。","source":{"text":"谢太傅寒雪日。内集，与儿女议论文义，俄而雪骤。公欣然曰：‘白雪纷纷何所似？’兄子胡儿曰：‘撒盐空中差可拟。’兄女曰：‘未若柳絮因风起。’","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"只是我娘子虽多～，却少剉荐之风。","book":"明·汪廷讷《狮吼记·叙别》"},"usage":"作宾语；赞誉女性","story":["东晋时期，尚书仆射谢安在大雪纷飞的冬天里把儿女辈召集在一起谈论诗文经义，要求子侄们用诗形容此时的大雪，侄儿谢朗作诗“撒盐空中差可拟”，侄女谢道韫说“未若柳絮因风起”。谢安大笑，欣赏侄女的诗才"]},{"id":11809,"word":"咏雪之才","pinyin":"yǒng xuě zhī cái","abbr":"yxzc","explanation":"表示人有卓越的文学才能。多指女子。","source":{"text":"俄而雪骤，公欣然曰：‘白雪纷纷何所拟？’兄子胡儿曰：‘撒盐空中差可拟。’兄女曰：‘未若柳絮因风起。’公大笑乐。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"忽见世妹惊鸿飞下，对客挥毫，以～，写簪花之格。","book":"清·袁枚《小仓山房尺牍·与汪顺哉世妹》"}},{"id":11810,"word":"咏风嘲月","pinyin":"yǒng fēng cháo yuè","abbr":"yfcy","explanation":"旧指文人写作或朗诵以风月等自然景色为题材的作品。现多形容作品空虚无聊。","source":{"text":"免学他嘲风咏月，污人行止。","book":"晋·王嘉《拾遗记》"}},{"id":11811,"word":"咒天骂地","pinyin":"zhòu tiān mà dì","abbr":"ztmd","explanation":"形容信口乱骂。","source":{"text":"他脾气越发坏了，不是捶床拍枕，就是咒天骂地。","book":"清·曾朴《孽海花》第三回"},"example":{"text":"曾朴《孽海花》第三回：“他脾气越发坏了，不是捶床拍枕，就是～。”"},"usage":"作谓语、宾语、状语、定语；指乱骂"},{"id":11812,"word":"咕咕哝哝","pinyin":"gū gū nóng nóng","abbr":"ggnn","explanation":"嘴很少动，低声说出难于听懂的话。","source":{"text":"到了自己房中，将东西丢在一边，嘴里咕咕哝哝自言自语道：‘这个又算了个什么儿呢。’","book":"清·曹雪芹《红楼梦》第67回"},"example":{"text":"清·李宝嘉《官场现形记》第三回：“他两人的交情很厚，在席面上～，谈个不了，还咬了半天耳朵。”"},"similar":["唧唧咕咕"],"usage":"作定语、状语；指小声说话"},{"id":11813,"word":"咕咕噜噜","pinyin":"gū gū lū lū","abbr":"ggll","explanation":"象声词，水流动或物体滚动的声音。","source":{"text":"说得很轻，咕咕噜噜听不清什么，尤五有些不耐烦。","book":"高阳《胡雪岩全传·平步青云》中册"},"example":{"text":"他～地喝下一瓶啤酒。"},"usage":"作定语、状语；用于拟声"},{"id":11814,"word":"咨牙俫嘴","pinyin":"zī yá lái zuǐ","abbr":"zylz","explanation":"张着嘴巴，露出牙齿。形容凶狠或疼痛难忍的样子","example":{"text":"对面来了几个～的怪物"},"similar":["龇牙咧嘴","龇牙裂嘴"],"usage":"作谓语、状语；指人的外貌"},{"id":11815,"word":"咫尺万里","pinyin":"zhǐ chǐ wàn lǐ","abbr":"zcwl","explanation":"形容画幅虽小，意境深远。后也指诗文的含意深远。","source":{"text":"能书善画，于扇上图山水，咫尺之内，便觉万里为遥。","book":"《南史·萧贲传》"},"example":{"text":"杜甫歌行，自称鲍、庾，加以时事，大作波涛，～，非虚夸矣。","book":"清·王闿运《湘绮楼论唐诗》"},"similar":["咫尺千里","咫尺天涯"],"usage":"作主语、谓语、宾语；形容事物内容丰富"},{"id":11816,"word":"咫尺之义","pinyin":"zhǐ chǐ zhī yì","abbr":"zczy","explanation":"咫尺：短小；义：义理。旨狭隘的义理。","source":{"text":"今拘学或抱咫尺之义，久孤于世，岂若卑论侪俗，与世沈浮而取荣名哉！","book":"《史记·游侠列传》"}},{"id":11817,"word":"咫尺之书","pinyin":"zhǐ chǐ zhī shū","abbr":"zczs","explanation":"书信。古代书写用木简，信札之简长盈尺，故称。","source":{"text":"欲徒手奉咫尺之书，自托于执事，将使执事何从而知之，何从而信之哉？","book":"《史记·淮阴侯列传》：“而后遣辩士奉咫尺之书，暴其所长于燕，燕必不敢不听从。”宋·苏洵《上欧阳内翰第一书》"},"example":{"text":"闻得钱騕智勇足备，明公若驰～，厚具礼币，只说越州贼寇未平，向董昌借钱騕来此征剿。","book":"明·冯梦龙《喻世明言》第二十一卷"},"usage":"作宾语；指书信"},{"id":11818,"word":"咫尺之功","pinyin":"zhǐ chǐ zhī gōng","abbr":"zczg","explanation":"咫尺：比喻微小。微小的功劳。","source":{"text":"虽有高世之明，无咫尺之功者，不赏。","book":"《战国策·秦策五》"},"usage":"作宾语；用于否定句"},{"id":11819,"word":"咫尺千里","pinyin":"zhǐ chǐ qiān lǐ","abbr":"zcql","explanation":"比喻距离虽近，但很难相见，象是远在天边一样。","source":{"text":"含情咫尺千里，况听家家远砧。","book":"唐·鱼玄机《隔汉江寄子安》"},"example":{"text":"维水之害，～。","book":"宋·苏轼《何公桥》"},"similar":["咫尺万里"],"usage":"作主语、谓语、宾语；形容事物内容丰富"},{"id":11820,"word":"咫尺天涯","pinyin":"zhǐ chǐ tiān yá","abbr":"zcty","explanation":"咫：古代长度单位，周制八寸，合今市尺六寸二分二厘；咫尺：比喻距离很近。比喻距离虽近，但很难相见，象是远在天边一样。","source":{"text":"天威不违颜咫尺。","book":"《左传·僖公九年》"},"example":{"text":"左右如今也不容相近，～一般，有甚舍不得处？","book":"明·冯梦龙《古今小说》第二十二卷"},"similar":["咫尺千里","远在天边","天各一方"],"opposite":["一衣带水","天涯若比邻"],"usage":"作主语、谓语、宾语；形容难以相见"},{"id":11821,"word":"咫尺天颜","pinyin":"zhǐ chǐ tiān yán","abbr":"zcty","explanation":"比喻离天子容颜极近。亦指天子之颜。","source":{"text":"天威不违颜咫尺。原谓天鉴察不远，威严如常在面前。","book":"语本《左传·僖公九年》"},"example":{"text":"～，瞻仰尤为亲切。","book":"清·陈康祺《郎潜纪闻》卷一"},"similar":["咫尺颜","咫尺威颜"],"usage":"作宾语、定语；用于书面语"},{"id":11822,"word":"咫尺威颜","pinyin":"zhǐ chǐ wēi yán","abbr":"zcwy","explanation":"比喻离天子容颜极近。亦指天子之颜。同“咫尺天颜”。","source":{"text":"联翩人贺知君意，咫尺威颜不隔霄。","book":"宋·王安石《和蔡枢密孟夏旦日西府书事》"},"similar":["咫只天颜"],"usage":"作宾语、定语；用于书面语"},{"id":11823,"word":"咫尺颜","pinyin":"zhǐ chǐ yán","abbr":"zcy","explanation":"咫尺：很近；颜：龙颜。距龙颜只有咫尺。形容离皇帝很近。","source":{"text":"天威不违颜咫尺。","book":"《左传·僖公九年》"},"example":{"text":"密视枢机草，偷瞻～。（唐·元稹《酬乐天待漏入阁见赠》）"}},{"id":11824,"word":"咫角骖驹","pinyin":"zhǐ jiǎo cān jū","abbr":"zjcj","explanation":"未壮的牛马，比喻人年少。","source":{"text":"齐有闾丘邛年十八，道遮宣王曰：‘家贫亲老，愿得小仕。’……宣王曰：‘未有咫角骖驹而能服重致远者也。’","book":"汉·刘向《新序·杂事五》"},"usage":"作宾语、定语；用于书面语"},{"id":11825,"word":"咬人狗儿不露齿","pinyin":"yǎo rén gǒu ér bù lòu chǐ","abbr":"yrgeblc","explanation":"比喻真正厉害的人在外表是不显露出来的。","source":{"text":"那厮正是咬人狗儿不露齿。","book":"元·张国宾《罗李郎》第三折"},"example":{"text":"元·张国宾《罗李郎》第三折：“那厮正是～。”"},"usage":"作宾语、定语；用于比喻句"},{"id":11826,"word":"咬姜呷醋","pinyin":"yǎo jiāng xiā cù","abbr":"yjgc","explanation":"形容生活清苦。","source":{"text":"礼祠主膳，淡吃齑面；兵职驾库，咬姜呷醋。","book":"宋·陆游《老学庵笔记》卷六"},"example":{"text":"只恐使用不来，路上～，件件省缩。","book":"明·罗贯中《平妖传》第十二回"},"usage":"作谓语、宾语、定语；用于生活"},{"id":11827,"word":"咬字眼儿","pinyin":"yǎo zì yǎn ér","abbr":"yzye","explanation":"在措辞用字方面过分挑剔。","example":{"text":"你不要过分～。"},"similar":["咬文嚼字"],"usage":"作谓语、宾语；指在措辞用字方面过分挑剔"},{"id":11828,"word":"咬定牙关","pinyin":"yǎo dìng yá guān","abbr":"ydyg","explanation":"形容下定决心，坚忍不拔。","source":{"text":"这长老咬定牙关，声也不透。","book":"明·吴承恩《西游记》第五十五回"},"example":{"text":"李逵浑身脱剥，～，手掿双斧，从城濠里飞杀过来。","book":"《水浒传》第六六回"},"similar":["咬定牙根","咬紧牙关","咬起牙关"],"usage":"作谓语、定语；用于处事"},{"id":11829,"word":"咬定牙根","pinyin":"yǎo dìng yá gēn","abbr":"ydyg","explanation":"忍受痛苦而坚持到底，或意志坚定不移。","source":{"text":"李逵浑身脱剥，咬定牙根，手双斧，从城濠里飞杀过来。","book":"明·施耐庵《水浒传》第六十六回"},"example":{"text":"众商都是愚夫，听了他的话，～不肯答应。","book":"清·李宝嘉《文明小史》第三十二回"},"similar":["咬定牙关","咬起牙关","咬紧牙根"],"usage":"作谓语、定语；用于处事"},{"id":11830,"word":"咬得菜根","pinyin":"yǎo dé cài gēn","abbr":"ydcg","explanation":"旧指安贫守道。现也形容安于艰苦的生活。","source":{"text":"汪信民尝言：‘人常咬得菜根，则百事可做。’","book":"宋·朱熹《小学·善行实敬身》"},"example":{"text":"～无别异，看将桃叶与君同。","book":"董必武《口占和叶参谋长韵》诗"},"similar":["咬菜根"],"usage":"作谓语、定语；指生活清苦"},{"id":11831,"word":"咬指吐舌","pinyin":"yǎo zhǐ tǔ shé","abbr":"yzts","explanation":"咬着手指甲，吐出舌头。形容害怕的神态。","source":{"text":"众门客仆从见贾政这个形景，便知又是为宝玉了，一个个咬指吐舌，连忙退出。","book":"清·曹雪芹《红楼梦》第三十三回"},"example":{"text":"众军伸头缩脑，慢慢的走将出来，聚在一处，个个～。","book":"清·吴璿《飞龙全传》第四回"}},{"id":11832,"word":"咬文啮字","pinyin":"yǎo wén niè zì","abbr":"ywnz","explanation":"形容过分地斟酌字句。多指死扣字眼而不注意精神实质。同“咬文嚼字”。","source":{"text":"酒场遇不读书人，所以觞政，切不可咬文啮字，兼以诗词困人。","book":"清·朱焘《北窗呓语》"},"example":{"text":"我又最恨人家～的评文，但我却又有点‘考据癖’。","book":"胡適《〈水浒传〉考证》"},"similar":["咬文嚼字","嚼字咬文"],"usage":"作谓语、定语、状语；指死扣字眼"},{"id":11833,"word":"咬文嚼字","pinyin":"yǎo wén jiáo zì","abbr":"ywjz","explanation":"形容过分地斟酌字句。多指死扣字眼而不注意精神实质。","source":{"text":"哎，使不的你咬文嚼字。","book":"元·无名氏《杀狗劝夫》第四折"},"example":{"text":"学习文件不能只～，关键是领会文件的精神实质。"},"similar":["字斟句酌"],"opposite":["走马观花","一挥而就","文不加点"],"usage":"作谓语、定语、状语；指死扣字眼"},{"id":11834,"word":"咬文齧字","pinyin":"yǎo wén niè zì","abbr":"ywnz","explanation":"形容过分地斟酌字句。多指死扣字眼而不注意精神实质。同“咬文嚼字”。"},{"id":11835,"word":"咬牙切齿","pinyin":"yǎo yá qiè chǐ","abbr":"yyqc","explanation":"切齿：咬紧牙齿，表示痛恨。形容极端仇视或痛恨。也形容把某种情绪或感觉竭力抑制住。","source":{"text":"为甚事咬牙切齿，諕的犯罪人面色如金纸。","book":"元·孙仲章《勘头巾》第二折"},"example":{"text":"只见水军头领早把张清解来。众多兄弟都被他打伤，～，尽要来杀张清。","book":"明·施耐庵《水浒传》第七十回"},"similar":["恨之入骨","痛心疾首","深恶痛绝"],"opposite":["笑容可掬"],"usage":"作谓语、定语、状语；指极端仇视或痛恨"},{"id":11836,"word":"咬牙恨齿","pinyin":"yǎo yá hèn chǐ","abbr":"yyhc","explanation":"形容极端仇视或痛恨。也形容把某种情绪或感觉竭力抑制住。同“咬牙切齿”。","source":{"text":"八戒闻言，咬牙恨齿，忍不住举起钯，把那坟冢，一顿筑倒。","book":"明·吴承恩《西游记》第八十六回"},"similar":["咬牙切齿"],"usage":"作谓语、定语、状语；指极端仇视或痛恨"},{"id":11837,"word":"咬紧牙关","pinyin":"yǎo jīn yá guān","abbr":"yjyg","explanation":"尽最大努力忍受痛苦或克服困难。","source":{"text":"一面问个着落，一面咬紧牙关把朴斋腿膀狠命的摔一把。朴斋忍不住叫声‘阿呀’。","book":"清·韩邦庆《海上花列传》第十三回"},"example":{"text":"他～，忍受剐心似的痛楚。","book":"周而复《上海的早晨》第一部四"},"similar":["咬定牙根","咬定牙关","咬起牙关"],"usage":"作谓语、定语、状语；用于处事"},{"id":11838,"word":"咬紧牙根","pinyin":"yǎo jǐn yá gēn","abbr":"yjyg","explanation":"形容尽最大的努力克服困难，忍耐坚持，决不改变既定的意向。","source":{"text":"黄河三千年一度清，蟠桃五百年一次开花。鹤勒那咬定牙关，朱顶王呵呵大笑。","book":"宋·释惟白《续传灯录》卷三十一"},"example":{"text":"只要咱们～，抗过这一时，就一定能大获全胜，将逆贼一举全歼，不留后患。","book":"二月河《康熙大帝》五十三"},"similar":["咬起牙关","咬定牙关","咬定牙根"],"usage":"作谓语、定语、状语；用于处事"},{"id":11839,"word":"咬耳朵","pinyin":"yǎo ěr duǒ","abbr":"yed","explanation":"指耳语。","source":{"text":"又同管家大爷咬耳朵，说他自己不敢冒昧。","book":"清·李宝嘉《官场现形记》第11回"},"usage":"作谓语、定语；用于说话等"},{"id":11840,"word":"咬菜根","pinyin":"yǎo cài gēn","abbr":"ycg","explanation":"旧指安贫守道。现也形容安于艰苦的生活。","source":{"text":"汪信民尝言：‘人常咬得菜根，则百事可做。’","book":"宋·朱熹《小学·善行实敬身》"},"example":{"text":"宋祁那边常常宴会歌舞，宋效听不下去，教人和他弟弟说，问他还记得当年在和尚庙里～否？","book":"朱自清《论吃饭》"},"similar":["咬得菜根"],"usage":"作谓语、定语；指生活清苦"},{"id":11841,"word":"咬血为盟","pinyin":"yǎo xuè wéi méng","abbr":"yxwm","explanation":"指咬臂出血，发誓定盟，以示坚决。"},{"id":11842,"word":"咬起牙关","pinyin":"yǎo qǐ yá guān","abbr":"yqyg","explanation":"形容尽最大的努力克服困难，忍耐坚持，决不改变既定的意向。","source":{"text":"黄河三千年一度清，蟠桃五百年一次开花。鹤勒那咬定牙关，朱顶王呵呵大笑。","book":"宋·释惟白《续传灯录》卷三十一"},"example":{"text":"歇了一会，并没减轻疲乏，觉得身上潮湿得厉害，索性～，一股劲地往前跑。","book":"梁斌《红旗谱》二十六"},"similar":["咬紧牙关","咬紧牙根","咬定牙关"],"usage":"作谓语、定语、状语；用于处事"},{"id":11843,"word":"咬钉嚼铁","pinyin":"yǎo dīng jiáo tiě","abbr":"ydjt","explanation":"牙齿能咬碎铁钉。比喻意志坚强。","source":{"text":"来往的，尽是咬钉嚼铁汉；出入的，无非沥血剖肝人。","book":"明·施耐庵《水浒传》第九回"},"example":{"text":"～言言在，舌剑唇枪句句真。","book":"清·陈瑞生《再生缘》第67回"},"usage":"作谓语、定语；指意志坚强"},{"id":11844,"word":"咬音咂字","pinyin":"yǎo yīn zā zì","abbr":"yyzz","explanation":"形容说话一字一板，郑重其事。","source":{"text":"‘所以你这臭丫头就没了魂似地跟了下去，对吗？’老妇人咬音咂字地说。","book":"萧乾《栗子·皈依》"},"usage":"作定语、状语；用于说话"},{"id":11845,"word":"咳唾成珠","pinyin":"ké tuò chéng zhū","abbr":"ktcz","explanation":"咳唾：咳嗽吐唾沫，比喻谈吐、议论。“咳”也写作“欬”。比喻言辞精当，议论高明。也形容文词极其优美。","source":{"text":"势家多所宜，咳唾自成珠。","book":"《庄子·秋水》：“子不见夫唾者乎？喷则大者如珠，小者如雾。”　《后汉书·赵壹传》"},"example":{"text":"池塘梦句君能得，～我未闲。","book":"宋·梅尧臣《依韵和宋次道答弟中道喜还朝》"},"similar":["咳珠唾玉"],"usage":"作谓语、宾语；比喻言谈不凡或诗文优美"},{"id":11846,"word":"咳声叹气","pinyin":"hāi shēng tàn qì","abbr":"hstq","explanation":"因忧伤、烦闷或痛苦而发出叹息的声音。","source":{"text":"江裴度无法，只得咳声叹气的出得行门，偏偏包车夫又不知去向，把他恨得跺脚。","book":"《负曝闲谈》第六回"},"example":{"text":"（她）决不垂头丧气，决不～。","book":"朱自清《房东太太》"},"similar":["唉声叹气"],"opposite":["喜气洋洋"],"usage":"作谓语、定语；指不如意而叹息"},{"id":11847,"word":"咳珠唾玉","pinyin":"ké zhū tuò yù","abbr":"kzty","explanation":"比喻为文措辞优美。","source":{"text":"势家多所宜，咳唾自成珠。","book":"《庄子·秋水》：“子不见夫唾者乎？喷则大者如珠，小者如雾。”　《后汉书·赵壹传》"},"example":{"text":"梅花海里吟香云，～何缤纷。","book":"清·丘逢甲《岭云海日楼诗抄》"},"similar":["咳唾成珠"],"usage":"作谓语、宾语；用于言谈或诗文等"},{"id":11848,"word":"咸与惟新","pinyin":"xián yǔ wéi xīn","abbr":"xywx","explanation":"指一切除旧更新。同“咸与维新”。","source":{"text":"天吏逸德，烈于猛火，歼厥渠魁，胁从罔治。旧染污俗，咸与惟新。","book":"《尚书·胤征》"},"similar":["咸与维新"],"usage":"作谓语；指一切除旧更新"},{"id":11849,"word":"咸与维新","pinyin":"xián yǔ wéi xīn","abbr":"xywx","explanation":"咸：皆，都；与：参与。指一切除旧更新。","source":{"text":"天吏逸德，烈于猛火，歼厥渠魁，胁从罔治。旧染污俗，咸与维新。","book":"《尚书·胤征》"},"example":{"text":"这是“～”的时候了，所以他们便谈得很投机。","book":"鲁迅《阿Ｑ正传》第七章"},"similar":["咸与惟新"],"usage":"作谓语、定语；指一切除旧更新"},{"id":11850,"word":"咸五登三","pinyin":"xián wǔ dēng sān","abbr":"xwds","explanation":"指帝德广被，同于五帝而超于三王。","source":{"text":"咸，皆也，言汉德与五帝皆盛，而登于三王之上也。","book":"《史记·司马相如列传》：“方将增泰山之封，加梁父之事，鸣和鸾，扬乐颂，上咸五，下登三。”《汉书·司马相如传下》引此文，颜师古注"},"example":{"text":"《南齐书·王融传》：“然后天云动，勒封岱宗，～，追踪七十，百神肃警，万国俱僚。”"},"usage":"作谓语、定语；用于赞颂"},{"id":11851,"word":"咸嘴淡舌","pinyin":"xián zuǐ dàn shé","abbr":"xzds","explanation":"比喻无事生非或没话找话说。","source":{"text":"这一点子小崽子也挑么挑六，咸嘴淡舌，咬群的骡子似的。","book":"清·曹雪芹《红楼梦》第五十八回"},"similar":["搬弄是非"],"usage":"作谓语、定语、宾语；指挑拨是非"},{"id":11852,"word":"咸遂濡泽","pinyin":"xián suì rú zé","abbr":"xsrz","explanation":"咸：都；濡泽：沾湿，比喻恩泽。比喻都沾了光。","source":{"text":"毅之族咸遂濡泽。以其春秋积序，容状不衰，南海之人，靡无惊异。","book":"唐·李朝威《柳毅传》"}},{"id":11853,"word":"咸酸苦辣","pinyin":"xián suān kǔ là","abbr":"xskl","explanation":"本指四种味道。也比喻生活经历中的各种世态人情滋味。","source":{"text":"盖咸酸苦辣，着口即知。","book":"《鹖冠子·环流五》：“阴阳不同气，然其为和同也；酸咸甘苦之味相反，然其为善均也。” 明·张岱《老饕集序》"},"example":{"text":"回想起这些往事，他心中如同打翻了五味瓶，～麻，滋味儿种种，滋味儿难分。","book":"梁晓声《疲惫的人》八"},"similar":["酸咸苦辣","甜酸苦辣"],"usage":"作主语、宾语、定语；多用于比喻句"},{"id":11854,"word":"咸阳一炬","pinyin":"xián yáng yī jǔ","abbr":"xyyj","explanation":"咸阳：秦朝的都城；炬：火把，引申为火焚。咸阳的一把大火。指项羽率军到咸阳后将秦宫全部烧毁。泛指一把火烧光。","source":{"text":"项羽引兵西屠咸阳，杀秦降王子婴，烧秦宫室，火三月不灭。","book":"《史记·项羽本纪》"},"example":{"text":"张钟山欲借～，了此业障。","book":"明·张岱《与祁世培》"},"usage":"作宾语、定语；用于书面语"},{"id":11855,"word":"咸风蛋雨","pinyin":"xián fēng dàn yǔ","abbr":"xfdy","explanation":"指海上风雨。","source":{"text":"其在岛也，小屋一间，咸风蛋雨，虽丈夫所不耐。","book":"梁启超《记东侠》"},"usage":"作主语、宾语、定语；指海上的风雨"},{"id":11856,"word":"咽喉要地","pinyin":"yān hóu yào dì","abbr":"yhyd","explanation":"一种军事地理形势。指军事上像咽喉一样十分要害的地方。","example":{"text":"我们要尽快占领这块～。"},"usage":"作宾语、主语、定语；用于军事等"},{"id":11857,"word":"咽苦吐甘","pinyin":"yàn kǔ tǔ gān","abbr":"yktg","explanation":"指母亲自己吃粗劣食物，而以甘美之物哺育婴儿。形容母爱之深。","source":{"text":"子之于母，慈爱特深；非母不育；推燥居湿，咽苦吐甘，生养劳瘁，恩斯极矣。","book":"《旧唐书·礼仪志七》"},"example":{"text":"想着他～，偎干就湿，怎生抬举。","book":"元无名氏《神奴儿》第三折"},"usage":"作谓语、定语、宾语；用于母性"},{"id":11858,"word":"咽苦吞甘","pinyin":"yàn kǔ tūn gān","abbr":"yktg","explanation":"犹咽苦吐甘。偏指吃苦。","source":{"text":"想着我咽苦吞甘，十月怀耽，乳哺三年。","book":"元关汉卿《蝴蝶梦》第三折"},"usage":"作谓语；指吃苦"},{"id":11859,"word":"咿咿呀呀","pinyin":"yī yī yā yā","abbr":"yyyy","explanation":"物体转动或摇动的声音，小儿学语或低哭声，也指鸟叫声。","source":{"text":"全村的大人娃娃，说说笑笑，咿咿呀呀，手舞足蹈，都穿上了自己最体面的衣裳，纷纷走出家门。","book":"路遥《平凡的世界》第二卷第54章"},"similar":["咿咿哑哑"],"usage":"作定语、状语；用于声音等"},{"id":11860,"word":"咿咿哑哑","pinyin":"yī yī yā yā","abbr":"yyyy","explanation":"物体转动或摇动的声音，小儿学语或低哭声，也指鸟叫声。","source":{"text":"只听得屋梁上边咿咿哑哑说话之声道：‘皇爷与娘娘只顾要掷四掷六，也让高力士起来直直腰。’","book":"清·褚人获《隋唐演义》第87回"},"example":{"text":"清·褚人获《隋唐演义》第87回：“只听得屋梁上边～说话之声道：‘皇爷与娘娘只顾要掷四掷六，也让高力士起来直直腰。’”"},"similar":["咿咿呀呀"],"usage":"作定语、状语；用于声音等"},{"id":11861,"word":"哀丝豪竹","pinyin":"āi sī háo zhú","abbr":"ashz","explanation":"丝：指弦乐器；竹：指管乐器；豪竹：粗大的竹管制成的乐器。形容管弦乐声的悲壮动人。","source":{"text":"酒肉如山又一时，初筵哀丝动豪竹。","book":"唐·杜甫《醉为马坠诸公携酒相看》诗"},"example":{"text":"～颂英烈，此是北昆跃进花。","book":"茅盾《观北昆剧院初演〈红霞〉》"},"usage":"作宾语；形容音乐动人"},{"id":11862,"word":"哀丝豪肉","pinyin":"āi sī háo ròu","abbr":"ashr","explanation":"丝：琴瑟之类的弦乐器，弦乐；肉：指喉咙，歌喉。悲切的弦乐，洪亮的歌喉。","source":{"text":"无端乙夜，哀丝豪肉，激得异乡愁断。","book":"清·黄景仁《柳初新·七月初二日夜宴》"}},{"id":11863,"word":"哀乐中节","pinyin":"āi lè zhōng jié","abbr":"ayzj","explanation":"中：合乎；节：适度。指哀伤和欢乐都适度，抒发感情不过分。","source":{"text":"不发乎情，即非礼义，故诗要有乐有哀；发乎情，未必即礼义，故诗要哀乐中节。","book":"清·刘熙载《艺概·诗概》"}},{"id":11864,"word":"哀乐相生","pinyin":"āi lè xiāng shēng","abbr":"ayxs","explanation":"悲哀与欢乐可以互为因果，相互转化。","source":{"text":"乐之所至，哀亦至焉，哀乐相生。","book":"西汉·戴圣《礼记·孔子闲居》"},"example":{"text":"要记住～的道理，避免乐极生悲。"},"similar":["乐极生悲"],"usage":"作宾语、定语；指哀乐的关系"},{"id":11865,"word":"哀兵必胜","pinyin":"āi bīng bì shèng","abbr":"abbs","explanation":"原意是力量相当的两军对阵，悲愤的一方获得胜利。后指因受欺侮而奋起抵抗的军队，必定能取胜。","source":{"text":"祸莫大于轻敌，轻敌几丧吾宝，故抗兵相加，哀者胜矣。","book":"《老子》第六十九章"},"example":{"text":"不，～！不要乐，要哀，何小姐能弹《易水吟》的谱子吗？","book":"张恨水《啼笑因缘续集》第十回"},"similar":["师直为壮"],"opposite":["骄兵必败"],"usage":"作谓语、定语；用于军事"},{"id":11866,"word":"哀告宾服","pinyin":"āi gào bīn fú","abbr":"agbf","explanation":"宾服：古指诸侯或边远部落按时朝贡，表示依服、服从。后泛指归顺、服从。指哀求饶恕，愿意服从。","source":{"text":"我见他慌悚踌躇，左支右吾，跪在街衢，哀告宾服。","book":"元·无名氏《延安府》第一折"},"example":{"text":"他已经～了，我们接受他的投降吧。"},"similar":["跪地求饶"],"usage":"作谓语；表示服从"},{"id":11867,"word":"哀哀欲绝","pinyin":"āi āi yù jué","abbr":"aayj","explanation":"哀哀：极度悲哀；绝：断气，死。形容极其悲痛。","source":{"text":"那宝珠按未嫁女之礼在灵前哀哀欲绝。","book":"清·曹雪芹《红楼梦》第十三回"},"example":{"text":"那安太太进门，一眼便看见姑娘，～的跪在那里……便一直的奔了姑娘去。","book":"清·文康《儿女英雄传》第二十回"},"similar":["哀痛欲绝","哀天叫地"],"opposite":["兴高采烈"],"usage":"作谓语、定语、补语；形容极度悲哀"},{"id":11868,"word":"哀哀父母","pinyin":"āi āi fù mǔ","abbr":"aafm","explanation":"可哀呀可哀，我的父母啊！原指古时在暴政下的人民终年在外服劳役，对父母病痛、老死不能照料而悲哀。","source":{"text":"蓼蓼者莪，匪莪伊蒿，哀哀父母，生我劬劳。","book":"《诗经·小雅·蓼莪》"},"example":{"text":"咱人有子方知不孝娘，岂不问～情肠！","book":"元·无名氏《小张屠》第一折"},"similar":["可怜天下父母心"],"usage":"作宾语、分句；指父母可怜"},{"id":11869,"word":"哀喜交并","pinyin":"āi xǐ jiāo bìng","abbr":"axjb","explanation":"悲伤和喜悦交织在一起。","source":{"text":"哀喜交并，不知所措。","book":"《三国志·吴志·诸葛恪传》"},"example":{"text":"我一时～，不知所措。"},"similar":["悲喜交集"],"opposite":["麻木不仁"],"usage":"作谓语、定语；形容又高兴又难过"},{"id":11870,"word":"哀声叹气","pinyin":"āi shēng tàn qì","abbr":"astq","explanation":"因伤感郁闷或悲痛而发出叹息的声音。","source":{"text":"终日价没心没想，哀声叹气。","book":"明·凌濛初《二刻拍案惊奇》卷三十八"},"example":{"text":"老实说，什么“合作”事业，危小姐完全是～。","book":"丁易《择婿》"},"similar":["咳声叹气"],"opposite":["喜气洋洋","眉开眼笑"],"usage":"作谓语、宾语、定语；指叹息"},{"id":11871,"word":"哀天叫地","pinyin":"āi tiān jiào dì","abbr":"atjd","explanation":"哀：悲哀。悲哀地呼天喊地。形容悲痛至极。","source":{"text":"平儿丰儿等哭的哀天叫地，贾政心中也着了忙。","book":"清·曹雪芹《红楼梦》第二十五回"},"example":{"text":"平儿丰儿等哭的～，贾政心中也着了忙。","book":"清·曹雪芹《红楼梦》第二十五回"},"similar":["呼天喊地"],"opposite":["兴高采烈"],"usage":"作谓语、状语；用于悲伤"},{"id":11872,"word":"哀思如潮","pinyin":"āi sī rú cháo","abbr":"asrc","explanation":"哀伤的思绪如同潮涌一般。形容极度悲痛。","source":{"text":"赵勇刚（唱）哀思如潮热泪洒，平川有边仇无涯。","book":"京剧《平原作战》第五场"},"example":{"text":"丈夫遭遇不幸，她～。"},"similar":["痛不欲生"],"opposite":["欣喜若狂"],"usage":"作谓语、宾语；形容极度悲痛"},{"id":11873,"word":"哀感中年","pinyin":"āi gǎn zhōng nián","abbr":"agzn","explanation":"形容人到中年对亲友离别的伤感情绪。","source":{"text":"谢太傅（安）语王右军（王羲之）曰：‘中年伤于哀乐，与亲友别，辄作数是恶。’","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"神丹浪说解还童，～遇谢公。","book":"清·丘逢甲《东北感春诗》"},"usage":"作谓语、定语；用于人的感情"},{"id":11874,"word":"哀感天地","pinyin":"āi gǎn tiān dì","abbr":"agtd","explanation":"形容极其哀痛，使天地都为之感动。","source":{"text":"王闻失声号恸，哀感天地。","book":"宋·释普济《五灯会元·卷一·二祖阿难尊者》"},"example":{"text":"她那～的哭号让人震惊。"},"similar":["哀感顽艳"],"opposite":["兴高采烈"],"usage":"作谓语；形容极度悲伤"},{"id":11875,"word":"哀感顽艳","pinyin":"āi gǎn wán yàn","abbr":"agwy","explanation":"顽：愚顽。原意是指内容凄切，文辞华丽，使愚笨和聪慧的人同样受感动。后多用来指艳情的小说、戏曲、电影中的感人情节。","source":{"text":"咏北狄之遐征，奏胡马之长嘶，凄入肝脾，哀感顽艳。","book":"三国·魏·繁钦《与魏文帝笺》"},"example":{"text":"这封信却是骈四骈六的，足有三千多字，写得异常的～。","book":"清·吴趼人《二十年目睹之怪现状》第七十一回"},"similar":["哀恸顽艳"],"usage":"作谓语、宾语、状语；形容作品哀怨感伤"},{"id":11876,"word":"哀戚之情","pinyin":"āi qī zhī qíng","abbr":"aqzq","explanation":"戚：悲哀。丧亲后的悲痛心情。","source":{"text":"孝子之丧亲也，哭不偯，礼无容，言不文，服美不安，闻乐不乐，食旨不甘，此哀戚之情也。","book":"《孝经·丧亲章》"}},{"id":11877,"word":"哀梨并剪","pinyin":"āi lí bìng jiǎn","abbr":"albj","explanation":"并剪：并州产的锋利剪刀。比喻言语、文章流畅爽利。","source":{"text":"天生健笔一枝，爽如哀梨，快如并剪。","book":"清·赵翼《瓯北诗话·苏东坡诗》"}},{"id":11878,"word":"哀梨蒸食","pinyin":"āi lí zhēng shí","abbr":"alzs","explanation":"将哀梨蒸着吃。比喻不识货。糊里糊涂地糟蹋好东西。","source":{"text":"桓南郡每见人不快，辄嗔曰：‘君得哀家梨，当复不烝食不？’","book":"南朝·宋·刘义庆《世说新语·轻诋》"},"example":{"text":"这年头大有“～”的人在。"},"usage":"作宾语、定语；指不识货","story":["晋朝时期，金陵哀仲家种的梨味道鲜美，入口便化解了，如果蒸一下就会变了味道。大将军桓温每对人不满，便说：“你得到哀家的梨，能不能不再蒸了。”讥笑对方真愚蠢"]},{"id":11879,"word":"哀死事生","pinyin":"āi sǐ shì shēng","abbr":"asss","explanation":"哀恸死者，侍奉生者。","source":{"text":"哀死事生，以待天命。","book":"西汉·司马迁《吴太伯世家》"},"example":{"text":"复命哭墓，～，孰与先衅而动，治其未乱？","book":"唐·独孤及《吴季子札论》"},"similar":["养生送死"],"usage":"作谓语、宾语；指对待生死者的态度"},{"id":11880,"word":"哀毁瘠立","pinyin":"āi huǐ jī lì","abbr":"ahjl","explanation":"旧时形容在父母丧中因过度悲伤而瘦得只剩一把骨头。","source":{"text":"（崔浑）丁母艰，勺饮不入口，哀毁瘠立。","book":"唐·张鷟《朝野佥载·补辑》"},"example":{"text":"现在丧亲不会像古代那样～了。"},"similar":["哀毁骨立"],"opposite":["哀而不伤"],"usage":"作主语、分句；形容丧亲之悲痛"},{"id":11881,"word":"哀毁骨立","pinyin":"āi huǐ gǔ lì","abbr":"ahgl","explanation":"哀：悲哀；毁：损坏身体；骨立：形容极瘦，只剩下骨架。旧时形容在父母丧中因过度悲伤而瘦得只剩一把骨头。","source":{"text":"王戎虽不备礼，而哀毁骨立。","book":"《后汉书·韦彪传》：“孝行纯至，父母卒，哀毁三年，不出庐寝。服竟，羸瘠骨立异形，医疗数年乃起。”南朝宋·刘义庆《世说新语·德行》"},"example":{"text":"众亲戚已到，商量在本族亲房立了一个儿子过来，然后大殓治丧。蘧公子～，极尽半子之谊。","book":"清·吴敬梓《儒林外史》第十二回"},"similar":["无肠可断","哀毁瘠立"],"opposite":["笑逐颜开","哀而不伤"],"usage":"作主语、分句；形容守孝期间悲痛尽礼","story":["古代有名的孝子王戎与和峤两人同时丧父母，和峤按照风俗习惯，守孝三年，神气丝毫没有损伤。而王戎则不同，他在父母的灵前搭了一个小棚，整天陪伴父母的灵，十分伤心，而且吃的很少，整个身体变成骨瘦如柴，三年后经很长时间调养才恢复"]},{"id":11882,"word":"哀痛欲绝","pinyin":"āi tòng yù jué","abbr":"atyj","explanation":"伤心得要死。形容悲痛到了极点。","source":{"text":"那宝珠按未嫁女之礼在灵前哀哀欲绝。","book":"清·曹雪芹《红楼梦》第十三回"},"example":{"text":"宝庆给大哥唱了一曲挽歌，直唱得泣不成声，～。","book":"老舍《鼓书艺人》十七"},"similar":["悲痛欲绝","悲不自胜"],"opposite":["欢欣若狂","兴高采烈","欣喜若狂"],"usage":"作定语、补语；形容因失去亲人的悲哀与伤心"},{"id":11883,"word":"哀矜勿喜","pinyin":"āi jīn wù xǐ","abbr":"ajwx","explanation":"矜：怜悯。对落难者要同情而不要幸灾乐祸。","source":{"text":"如得其情，则哀矜勿喜。","book":"《论语·子张》"},"example":{"text":"屡劝他缓狱恤刑，～，偏姑父习以为常，遂致怨家挟恨。","book":"蔡东藩、许廑父《民国通俗演义》第九十七回"},"opposite":["幸灾乐祸"],"usage":"作谓语、定语；用于劝诫人"},{"id":11884,"word":"哀矜惩创","pinyin":"āi jīn chěng chuàng","abbr":"ajcc","explanation":"哀、矜：怜悯；创：惩罚。爱怜而又责罚。","source":{"text":"有一不善，从而罚之，又从而哀矜惩创之。","book":"宋·苏轼《刑赏忠孝之至论》"},"example":{"text":"人的感情是很复杂的，～的现象时而有之。"},"usage":"作谓语、宾语、定语；指对人的态度"},{"id":11885,"word":"哀穷悼屈","pinyin":"āi qióng dào qū","abbr":"aqdq","explanation":"哀：怜恤；穷：境遇不好，指不得志；悼：伤心；屈：冤屈。对身处逆境的人，表示怜恤和伤感。","source":{"text":"尚贤而与能，哀穷而悼屈。","book":"唐·韩愈《上书部李侍郎书》"}},{"id":11886,"word":"哀而不伤","pinyin":"āi ér bù shāng","abbr":"aebs","explanation":"哀：悲哀；伤：伤害。忧愁而不悲伤，形容感情有节制；另形容诗歌、音乐优美雅致，感情适度。比喻做事没有过头也无不及。","source":{"text":"子曰：‘《关雎》乐而不淫，哀而不伤。’","book":"《论语·八佾》"},"example":{"text":"她喜欢打扮，愿意有朋友，可是这都不过是一些小小的、～的、青春的游戏。","book":"老舍《四世同堂》四十三"},"similar":["哀感顽艳"],"opposite":["亡国之音"],"usage":"作主语、谓语、分句；比喻做事适中"},{"id":11887,"word":"哀莫大于心死","pinyin":"āi mò dà yú xīn sǐ","abbr":"amdyxs","explanation":"心死：指心像死灰的灰烬。指最可悲哀的事，莫过于思想顽钝，麻木不仁。","source":{"text":"夫哀莫大于心死，而人死亦次之。","book":"《庄子·田子方》"},"example":{"text":"人说：“～。”我的心已经死了。我不该再到你们公馆里来，打扰你们。","book":"巴金《家》二回"},"similar":["心灰意冷"],"opposite":["发愤图强"],"usage":"作谓语、宾语；形容悲哀的程度比心死还重"},{"id":11888,"word":"哀鸿满路","pinyin":"āi hóng mǎn lù","abbr":"ahml","explanation":"哀鸿：哀鸣的鸿雁，比喻灾民。比喻到处都是流离失所、呻吟呼号的饥民。","source":{"text":"流离百室，哀鸿满路悲戚。","book":"清·洪昇《长生殿·收京》"},"example":{"text":"一旦爆发战争就会出现～的局面。"},"similar":["哀鸿遍野"],"opposite":["国泰民安"],"usage":"作谓语、定语、分句；形容无家可归景象"},{"id":11889,"word":"哀鸿遍地","pinyin":"āi hóng biàn dì","abbr":"ahbd","explanation":"哀鸿：哀鸣的鸿雁。比喻啼饥号寒的灾民。比喻在天灾人祸中到处都是流离失所、呻吟呼号的饥民。","source":{"text":"鸿雁于飞，哀鸣嗷嗷。","book":"《诗经·小雅·鸿雁》"},"example":{"text":"天涯吟望，～，都成愁侣。","book":"黄侃《水龙吟·秋花》词"},"similar":["哀鸿遍野"],"opposite":["国泰民安"],"usage":"作定语；形容灾民很多"},{"id":11890,"word":"哀鸿遍野","pinyin":"āi hóng biàn yě","abbr":"ahby","explanation":"哀鸿：哀鸣的鸿雁。比喻啼饥号寒的灾民。比喻在天灾人祸中到处都是流离失所、呻吟呼号的饥民。","source":{"text":"鸿雁于飞，哀鸣嗷嗷。","book":"《诗经·小雅·鸿雁》"},"example":{"text":"我记得历史上的罗马何等殷阗繁盛，怎么今日却是～，春燕无归，满眼凄惶。","book":"清·梁启超《新罗马》"},"similar":["啼饥号寒","饿蜉载道","民不聊生"],"opposite":["安居乐业","国泰民安","丰衣足食"],"usage":"作谓语、定语、分句；形容无家可归景象","story":["西周时期，周厉王任命荣夷公为卿士，对内残酷剥削，疯狂敛财，搞得民不聊生，哀鸿遍野。派卫巫监督百姓的言行，搞得人心惶惶。愤怒的人们起来反抗，赶走了周厉王。周宣王即位，他带领卿士巡访城郊，见到到处都是“鸿雁于飞，哀鸣嗷嗷。”的惨状"]},{"id":11891,"word":"品头论足","pinyin":"pǐn tóu lùn zú","abbr":"ptlz","explanation":"指无聊的人随意议论妇女的容貌体态。现亦比喻在小节上一味挑剔。同“品头题足”。","source":{"text":"他们指手划脚，品头论足。","book":"郭澄清《大刀记》开篇十二"},"example":{"text":"我们都应当投身到四化建设中大干一场，不应当站在一边～，徘徊观望。"},"similar":["评头论足"],"usage":"作谓语、宾语；指乱发议论"},{"id":11892,"word":"品头评足","pinyin":"pǐn tóu píng zú","abbr":"ptpz","explanation":"原指轻浮地议论妇女的容貌。现也比喻对人对事任意挑剔。","source":{"text":"那全副精神又注在各妓，那个好颜色，那个好太度，评头品足，少不免要乱哦几句诗出来了。","book":"清·黄小配《大马扁》第四回"},"example":{"text":"清·黄小配《大马扁》第四回：“那全副精神又注在各妓，那个好颜色，那个好太度，评头品足，少不免要乱哦几句诗出来了。”"},"similar":["说三道四","评头品足"],"usage":"作谓语、宾语；指对事任意挑剔"},{"id":11893,"word":"品头题足","pinyin":"pǐn tóu tí zú","abbr":"pttz","explanation":"指无聊的人随意议论妇女的容貌体态。","source":{"text":"清·蒲松龄《聊斋志异·阿宝》：“［生］遥见有女子憩树下，恶少年环如墙堵。众曰：‘此必阿宝也。’趋之，果宝也。审谛之，娟丽无双。少倾人益稠。女起遽去。众情颠倒，品头题足，纷纷若狂。"},"example":{"text":"大家都赞他国色天香，是苏小小关盼盼一流人物。～，闹了一时。","book":"清·彭养鸥《黑籍冤魂》第二十一回"},"similar":["品头论足","评头论足"],"usage":"作谓语、宾语；指乱发议论"},{"id":11894,"word":"品学兼优","pinyin":"pǐn xué jiān yōu","abbr":"pxjy","explanation":"兼：都。思想品德和学业都很优秀。","source":{"text":"一定是一位品学兼优，阅历通达的老长辈。","book":"清·文康《儿女英雄传》第九回"},"example":{"text":"他是一名～的好学生。"},"similar":["德才兼备","文武双全"],"opposite":["德薄能鲜","不学无术"],"usage":"作谓语、宾语、定语；指人的品德与才学"},{"id":11895,"word":"品德文章","pinyin":"pǐn dé wén zhāng","abbr":"pdwz","explanation":"指学问和品德。","source":{"text":"至于品德文章，令郎自有家传。","book":"清·吴敬梓《儒林外史》第46回"},"usage":"作主语、宾语、定语；用于人的品性"},{"id":11896,"word":"品目繁多","pinyin":"pǐn mù fán duō","abbr":"pmfd","explanation":"品目：物品的名目、种类，也作等第讲。名目种类很多。","source":{"text":"品目繁多，随事俯仰，刘毅所云‘下品无高门，一品无贱族’者也。","book":"《宋书·恩幸传》"},"example":{"text":"至大银钞始行，～，民犹未悟，而又兼行铜钱，虑有相妨。","book":"清·毕沅《续资治通鉴》卷一百九十六"}},{"id":11897,"word":"品竹弹丝","pinyin":"pǐn zhú tán sī","abbr":"pzts","explanation":"品：吹弄乐器；竹：指箫笛之类管乐器；丝：指琵琶、二胡之类弦乐器。指吹弹乐器。","source":{"text":"又不会卖风流，弄粉调脂；又不会按宫商，品竹弹丝。","book":"元·无名氏《货郎担》第四折"},"example":{"text":"不过十二三岁，就会描眉画眼，傅粉施朱，～。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"usage":"作宾语、定语；指吹弹乐器"},{"id":11898,"word":"品竹调丝","pinyin":"pǐn zhú tiáo sī","abbr":"pzts","explanation":"泛指吹弹管弦乐器。","source":{"text":"品竹调丝，称商换羽。","book":"元·王子一《误入桃源》第二折"},"example":{"text":"安得海是个阉人，要娈童妙女何用？我却不解。～，悠扬不绝。","book":"蔡东蕃《清史演义》第七十七回"},"similar":["品竹调弦"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":11899,"word":"品竹调弦","pinyin":"pǐn zhú diào xián","abbr":"pzdx","explanation":"泛指吹弹管弦乐器。亦作“品竹调丝”。","source":{"text":"一行行品竹调弦。","book":"元·武汉臣《玉壶春》第一折"},"example":{"text":"明·施耐庵《水浒传》第69回：“原来董平心灵机巧，三教九流，无所不通，～，无有不会。”"},"similar":["品竹调丝"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":11900,"word":"品箫弄笛","pinyin":"pǐn xiāo nòng dí","abbr":"pxnd","explanation":"吹奏洞箫和笛子。指人擅长音乐。","example":{"text":"她嫁了个会～的男人。"},"usage":"作谓语、定语、宾语；用于音乐等"},{"id":11901,"word":"品而第之","pinyin":"pǐn ér dì zhī","abbr":"pedz","explanation":"品：品评，区分；第：等第，等级。品评优劣而后确定他的等级。","source":{"text":"坚亲临太学，考学生经义优劣，品而第之。","book":"《晋书·苻坚载记上》"}},{"id":11902,"word":"品评卓逸","pinyin":"pǐn píng zhuó yì","abbr":"ppzy","explanation":"品：辨别；评：评议；卓：高明；逸：超出一般。","source":{"text":"于病中犹作《汉晋春秋》，品评卓逸。","book":"南朝·宋·刘义庆《世说新语·文学》"}},{"id":11903,"word":"品貌非凡","pinyin":"pǐn mào fēi fán","abbr":"pmff","explanation":"品貌：人品和容貌；非凡：不同寻常。品行相貌都超出一般。","source":{"text":"世兄品貌非凡，将来是要一定发达的。","book":"清·李宝嘉《官场现形记》第四十四回"},"example":{"text":"那仲熊生得虎头燕额，颧方耳大，面如冠玉，唇若涂抹，使两口旋风雁翎刀，端的～，人材出众。","book":"清·俞万春《荡寇志》第一百三回"}},{"id":11904,"word":"哄动一时","pinyin":"hōng dòng yī shí","abbr":"hdys","explanation":"在一个时期内惊动很多人。","source":{"text":"这哄动一时的事件，经过了一通空论，已经渐渐冷落了。","book":"鲁迅《且介亭杂文二集·论人言可畏》"},"example":{"text":"这件事曾经～。"},"similar":["轰动一时"],"usage":"作谓语、定语；指在一个时期内惊动很多人"},{"id":11905,"word":"哄堂大笑","pinyin":"hōng táng dà xiào","abbr":"htdx","explanation":"形容全屋子的人同时大笑。","source":{"text":"唐御史有台院、殿院、罕院，以一御史知杂事，谓之杂端。公堂会食，皆绝笑言。惟杂端笑而三院皆笑，谓之哄笑，则不罚。","book":"唐·赵璘《因话录》卷五"},"example":{"text":"因把在筱亭客厅上的事情，说了一遍。大家～。","book":"清·曾朴《孽海花》第十四回"},"similar":["前俯后仰","捧腹大笑","烘堂大笑"],"opposite":["哑然失笑","泣不成声","涕泗滂沱"],"usage":"作谓语、补语；指大家都笑","story":["五代时期，冯道与和凝同在中书办理事物。和凝见冯道穿新衣与新鞋，就问冯道的新鞋多少钱，冯道举左脚说才900文。和凝马上就训斥下人，说他买鞋贪污他900文，冯道马上举右脚说这也是900文，于是大家哄堂大笑起来"]},{"id":11906,"word":"响不辞声","pinyin":"xiǎng bù cí shēng","abbr":"xbcs","explanation":"回音由声音而来。比喻人的名誉根据他的行动而得来。","source":{"text":"曾子曰：‘响不辞声，鉴不辞形，君子正一，而万物皆成。’","book":"汉·刘向《说苑·杂言》"},"usage":"作宾语、定语；用于比喻句"},{"id":11907,"word":"响和景从","pinyin":"xiǎng hé jǐng cóng","abbr":"xhjc","explanation":"比喻两者紧密相连。同“响答影随”。","source":{"text":"稽古盛际，同寅协恭，百僚师之，以洽时雍，譬伯与仲，响和景从。","book":"明·张居正《光禄大夫柱国少傅……吕公墓志铭》"},"similar":["响答影随"],"usage":"作宾语、定语；用于比喻句"},{"id":11908,"word":"响彻云表","pinyin":"xiǎng chè yún biǎo","abbr":"xcyb","explanation":"形容声音响亮，好像可以穿过云层，直达高空。同“响彻云霄”。","source":{"text":"兰香亦鼓云和之瑟，音韵悠扬，响彻云表。","book":"清·王韬《淞滨琐话·仙井》"},"similar":["响彻云霄","响彻云际"],"usage":"作谓语、定语、状语；形容声音响亮"},{"id":11909,"word":"响彻云际","pinyin":"xiǎng chè yún jì","abbr":"xcyj","explanation":"形容声音响亮，好像可以穿过云层，直达高空。同“响彻云霄”。","source":{"text":"侍妇数百皆习之，后宫齐首高唱，声彻云霄。","book":"晋·葛洪《西京杂记·戚夫人歌舞》"},"example":{"text":"忽听得街上乐声漂渺，～。","book":"明·冯梦龙《喻世明言》卷四"},"similar":["响彻云霄"],"usage":"作谓语、定语、状语；形容声音响亮"},{"id":11910,"word":"响彻云霄","pinyin":"xiǎng chè yún xiāo","abbr":"xcyx","explanation":"彻：贯通；云霄：高空。形容声音响亮，好像可以穿过云层，直达高空。","source":{"text":"侍妇数百皆习之，后宫齐首高唱，声彻云霄。","book":"晋·葛洪《西京杂记·戚夫人歌舞》"},"example":{"text":"教这一笛儿，真吹得～，鸾翔鹤舞，楼下万万千千的人，都定睛侧耳，寂然无声。","book":"清·禇人获《隋唐演义》第八十六回"},"similar":["响彻云际","响遏行云"],"opposite":["闷声不响"],"usage":"作谓语、定语、状语；形容声音响亮"},{"id":11911,"word":"响答影随","pinyin":"xiǎng dá yǐng suí","abbr":"xdys","explanation":"如应声和答、形影相随。比喻两者紧密相连。","source":{"text":"由是论之，罪福报应，犹响答影随，不差毫末。","book":"宋·张君房《云笈七签》卷一百十七"},"similar":["响和景从"],"usage":"作宾语、定语；用于比喻句"},{"id":11912,"word":"响遏行云","pinyin":"xiǎng è xíng yún","abbr":"xexy","explanation":"遏：阻止；行云：飘动的云彩。形容歌声嘹亮，高入云霄，连浮动着的云彩也被止住了。","source":{"text":"抚节悲歌，声振林术，响遏行云。","book":"《列子·汤问》"},"example":{"text":"跟手又唱第二出，便是《一夜九更天》，用老生挂白须，扮老人家，唱过岭时，全用高字，真是～。","book":"清·黄小配《廿载繁华梦》第八回"},"similar":["响彻云霄","震耳欲聋","震天动地"],"opposite":["悄无声息"],"usage":"作宾语、定语、补语；形容歌声嘹亮","story":["战国时期秦国歌手薛潭向歌唱家秦青拜师学艺，经过一段时间的刻苦学习。薛潭的技艺有了很大的提高，就向老师辞行。秦青在郊外设宴送行，席间唱了一曲十分悲壮的歌曲，声振林木，响遏行云，薛潭觉得十分惭愧，于是留下继续学习"]},{"id":11913,"word":"响震失色","pinyin":"xiǎng zhèn shī sè","abbr":"xzss","explanation":"响：回声；震：响雷。像听到回声或响雷一样迅速变了脸色。","source":{"text":"权以示群下，莫不震响失色。","book":"宋·司马光《资治通鉴》"},"usage":"作谓语、状语；指惊吓"},{"id":11914,"word":"哑口无声","pinyin":"yǎ kǒu wú shēng","abbr":"ykws","explanation":"形容理屈词穷的样子。同“哑口无言”。","source":{"text":"话说孟夫人听了这些言语，只气的哑口无声。","book":"《再生缘》第三九回"},"similar":["哑口无言"],"usage":"作谓语、定语、状语；指惊讶等"},{"id":11915,"word":"哑口无言","pinyin":"yǎ kǒu wú yán","abbr":"ykwy","explanation":"哑口：象哑巴一样。象哑巴一样说不出话来。形容理屈词穷的样子。","source":{"text":"‘他也有儿子，少不也要娶媳妇。看三朝可肯放回家去？闻得亲母是个知礼之人，亏他怎样说了出来？’一番言语，说得张六嫂哑口无言。","book":"明·冯梦龙《醒世恒言》卷八"},"example":{"text":"他的一席话，使在场的人个个～。"},"similar":["张口结舌","默默无闻","理屈词穷"],"opposite":["振振有词","理直气壮","口若悬河"],"usage":"作谓语、定语、状语；指惊讶等"},{"id":11916,"word":"哑哑学语","pinyin":"yā yā xué yǔ","abbr":"yyxy","explanation":"形容婴儿咿咿呀呀地学大人说话的神情","source":{"text":"已生一子周岁，刚是哑哑学语。","book":"《精卫石》第二回"},"similar":["呀呀学语","牙牙学语"],"usage":"作谓语、定语、宾语；形容小孩说话的神情"},{"id":11917,"word":"哑子做梦","pinyin":"yǎ zǐ zuò mèng","abbr":"yzzm","explanation":"比喻有话或苦衷说不出。","source":{"text":"哑子做梦——说不得。","book":"宋·苏轼《杂纂》"},"example":{"text":"我这是～，有话说不出"},"similar":["哑子得梦","哑子托梦","哑子寻梦"],"usage":"作宾语、定语；用于比喻句"},{"id":11918,"word":"哑子做梦说不清","pinyin":"yǎ zǐ zuò mèng shuō bù qīng","abbr":"yzzmsbq","explanation":"比喻满腹心事，无处倾诉。","source":{"text":"痖子得梦向谁说，须弥顶上浪滔天。","book":"宋·释普济《五灯会元·石霜圆禅师》"}},{"id":11919,"word":"哑子吃苦瓜","pinyin":"yǎ zǐ chī kǔ guā","abbr":"yzckg","explanation":"比喻有苦说不出。","source":{"text":"僧问：‘如何是默默相应底事？’师曰：‘哑子吃苦瓜。’","book":"宋·释普济《五灯会元》卷十四"},"example":{"text":"～，与你说不得。你要知此苦，还须你自吃。","book":"明·王阳明《传习录》卷上"}},{"id":11920,"word":"哑子吃黄连","pinyin":"yǎ zǐ chī huáng lián","abbr":"yzchl","explanation":"歇后语。比喻有苦说不出。","source":{"text":"哑子漫尝黄蘖味，难将苦口对人言。","book":"江东老蟫《京本通俗小说·错斩崔宁》"},"example":{"text":"曾朴《孽海花》第八回：“只苦我国不知地理，～，说不出的苦。”"},"similar":["哑巴吃黄连","有苦难言"],"usage":"作宾语、定语；指有苦说不出"},{"id":11921,"word":"哑子吃黄连，说不出的苦","pinyin":"yǎ zǐ chī huáng lián，shuō bù chū de kǔ","abbr":"yzchlsbcdk","explanation":"黄连：中药，味苦。哑巴吃了黄连，嘴里说不出来。比喻有苦难言","source":{"text":"只苦我国不知地理，哑子吃黄连，说不出的苦。","book":"曾朴《孽海花》第八回"},"similar":["哑巴吃黄连，有苦说不出"],"usage":"作宾语、定语；用于书面语"},{"id":11922,"word":"哑子寻梦","pinyin":"yǎ zǐ xún mèng","abbr":"yzxm","explanation":"比喻有话或苦衷说不出。同“哑子做梦”。","source":{"text":"似鳔胶粘住口角，似鱼刺嘎了喉咙，低着头似哑子寻梦。","book":"元·纪君祥《赵氏孤儿》第二折"},"similar":["哑子托梦","哑子得梦","哑子做梦"],"usage":"作宾语、定语；用于比喻句"},{"id":11923,"word":"哑子得梦","pinyin":"yǎ zǐ dé mèng","abbr":"yzdm","explanation":"比喻满腹心事，无处倾诉。","source":{"text":"痖子得梦向谁说，须弥顶上浪滔天。","book":"宋·释普济《五灯会元·石霜圆禅师》"},"similar":["哑子托梦","哑子寻梦","哑子做梦"],"usage":"作宾语、定语；用于比喻句"},{"id":11924,"word":"哑子托梦","pinyin":"yǎ zǐ tuō mèng","abbr":"yztm","explanation":"比喻有话或苦衷说不出。同“哑子做梦”。","source":{"text":"做了个哑子托梦，说不的这场板障。","book":"元·郑廷玉《看钱奴》第三折"},"similar":["哑子得梦","哑子寻梦","哑子做梦"],"usage":"作宾语、定语；用于比喻句"},{"id":11925,"word":"哑子漫尝黄柏味，自家有苦自家知","pinyin":"yǎ zǐ màn cháng huáng bǎi wèi，zì jiā yǒu kǔ zì jiā zhī","abbr":"yzmchbwzjykzjz","explanation":"哑子：哑巴；黄柏：黄檗，味苦。哑子尝到黄柏的苦味，知苦说不出。比喻有苦难言","source":{"text":"文姜深闺寂寞，怀念诸儿，病势愈加，却是胸中展转，难以出口。正是‘哑子漫尝黄柏味，自家有苦自家知。’","book":"明·冯梦龙《东周列国志》第九回"},"similar":["哑巴吃黄连，有苦说不出"],"usage":"作宾语、定语；用于比喻句"},{"id":11926,"word":"哑巴亏","pinyin":"yǎ bā kuī","abbr":"ybk","explanation":"吃了亏不便说或不愿说。","source":{"text":"且说苗家父子丢了银子，因是暗昧之事，也不敢声张，竟吃了哑巴亏了。","book":"清·石玉昆《三侠五义》第14回"},"example":{"text":"她吃了～，只好自认倒霉。"},"similar":["有苦不能言"],"usage":"作宾语、定语；用于口语"},{"id":11927,"word":"哑巴吃黄连，有苦说不出","pinyin":"yǎ bā chī huáng lián，yǒu kǔ shuō bù chū","abbr":"ybchlyksbc","explanation":"黄连：中药，味苦。哑巴吃了黄连，嘴里说不出来。比喻有苦难言","source":{"text":"寡妇孤儿，恐怕受人欺侮，真是‘哑巴吃黄连，有苦说不出。’","book":"李六如《六十年的变迁》第一章"},"similar":["有苦难言"],"usage":"作宾语、定语；用于书面语"},{"id":11928,"word":"哑然一笑","pinyin":"yǎ rán yī xiào","abbr":"yryx","explanation":"哑然：形容笑声。禁不住笑出声来。","source":{"text":"禹济江南省水理，黄龙负舟，舟中人怖骇，禹乃哑然而笑。","book":"汉·赵晔《吴越春秋·越王无余外传》"},"example":{"text":"令狐冲吃了一惊，随即～，囚居数月，从不梳洗，自然是如此龌龊了。","book":"金庸《天龙八部》第二十一回"},"similar":["哑然失笑","哑然自笑"],"usage":"作谓语、定语、状语；指禁不住笑出声"},{"id":11929,"word":"哑然大笑","pinyin":"yǎ rán dà xiào","abbr":"yrdx","explanation":"哑然：形容笑声。禁不住大笑起来。","source":{"text":"同行者哑然大笑，曰：‘予昔给若，此晋国耳。’","book":"《列子·周穆王》"},"example":{"text":"那时我一把无名业火从脚跟下直透顶门，只是碍着众亲友，不好动粗。我便变作一番～。","book":"清·文康《儿女英雄传》第十五回"},"similar":["哑然而笑"],"usage":"作谓语、状语；用于处事"},{"id":11930,"word":"哑然失笑","pinyin":"yǎ rán shī xiào","abbr":"yrsx","explanation":"失笑：忍不住地笑起来。禁不住笑出声来。","source":{"text":"禹乃哑然而笑。","book":"汉·赵晔《吴越春秋·越王无余外传》"},"example":{"text":"王子安方寸之中，顷刻万绪，想鬼狐窃笑已久，故乘其醉而玩弄之，床头人醒，宁不～哉。","book":"清·蒲松龄《聊斋志异·王子安》"},"similar":["情不自禁","忍俊不禁"],"opposite":["哄堂大笑","痛哭流涕"],"usage":"作谓语、定语、状语；指禁不住笑出声"},{"id":11931,"word":"哑然而笑","pinyin":"yǎ rán ér xiào","abbr":"yrex","explanation":"哑然：形容笑声。禁不住笑出声来。","source":{"text":"禹济江南省水理，黄龙负舟，舟中人怖骇，禹乃哑然而笑。","book":"汉·赵晔《吴越春秋·越王无余外传》"},"example":{"text":"孔明听罢，～曰：“鹏飞万里，其志岂群鸟能识哉？”","book":"明·罗贯中《三国演义》第四十三回"},"similar":["哑然大笑"],"usage":"作谓语、状语；用于处事"},{"id":11932,"word":"哑然自笑","pinyin":"yǎ rán zì xiào","abbr":"yrzx","explanation":"哑然：形容笑声。禁不住笑出声来。","source":{"text":"禹济江南省水理，黄龙负舟，舟中人怖骇，禹乃哑然而笑。","book":"汉·赵晔《吴越春秋·越王无余外传》"},"example":{"text":"质明视之，恰符五数。～神之戏己也。","book":"清·蒲松龄《聊斋志异·五羖大夫》"},"similar":["哑然失笑","哑然一笑"],"usage":"作谓语、定语、状语；指禁不住笑出声"},{"id":11933,"word":"哑羊僧","pinyin":"yǎ yáng sēng","abbr":"yys","explanation":"佛教用语，比喻不知悟解的人。","source":{"text":"譬若白羊，及至人杀，不能作声，是名哑羊僧。","book":"《大智度论》卷三"}},{"id":11934,"word":"哓哓不休","pinyin":"xiāo xiāo bù xiū","abbr":"xxbx","explanation":"哓哓：争辩声；休：停止，完。形容争辩个没完。","source":{"text":"择其可语者诲之，犹时与吾悖，其声哓哓。","book":"唐·韩愈《重答张籍书》"},"example":{"text":"若再参商，～，岂非前因未了，又启后世萌芽？","book":"清·李汝珍《镜花缘》第八十作回"},"similar":["喋喋不休"],"opposite":["干脆利索"],"usage":"作谓语、状语；指争吵不停"},{"id":11935,"word":"哓音瘏口","pinyin":"xiāo yīn tú kǒu","abbr":"xytk","explanation":"犹言舌敝唇焦。形容说话之多，费尽口舌。","source":{"text":"虽然，菲封不弃，敝帚自珍，哓音瘏口，亦已三年，言念前劳，不欲泯没。","book":"梁启超《本馆第一百册祝辞》"},"example":{"text":"《辛亥革命·政闻社宣言书》：“不惮～为国民告，务唤起一般国民政治上之热心。”"},"usage":"作定语、状语；用于书面语"},{"id":11936,"word":"哕心沥血","pinyin":"yuě xīn lì xuè","abbr":"hxlx","explanation":"哕：呕吐；沥：滴。吐出心，流出血。比喻费尽心思和精力。","source":{"text":"读公当时十失四事诸疏，盖皆哕心沥血之诚也。","book":"明·沈榜《宛署杂记·志遗六》"},"similar":["呕心沥血"],"usage":"作谓语、定语、状语；用于教师等"},{"id":11937,"word":"哗世动俗","pinyin":"huá shì dòng sú","abbr":"hsds","explanation":"用浮夸的言行去惊动世俗之人。","source":{"text":"其为人，居家孝友，遇人和易质厚，不为聪明技巧以哗世动俗。","book":"宋·曾巩《殿中丞致仕王君墓志铭》"},"usage":"作谓语、宾语；指显示自己"},{"id":11938,"word":"哗世取名","pinyin":"huá shì qǔ míng","abbr":"hsqm","explanation":"用浮夸的言行使世人兴奋激动，博取虚名。","source":{"text":"窃慕隐居求志之风，尤耻哗世取名之事。","book":"宋·陆游《除宝谟阁待制谢表》"},"similar":["哗世取宠","欺世盗名"],"usage":"作谓语、定语；用于处事"},{"id":11939,"word":"哗世取宠","pinyin":"huá shì qǔ chǒng","abbr":"hsqc","explanation":"哗世：使世人激动兴奋；宠：喜爱。以浮夸的言论迎合群众，骗取群众的信赖和支持。","source":{"text":"然惑者既失精微，而辟者又随时扬抑，违离道本，苟以哗众取宠。","book":"《汉书·艺文志》"},"example":{"text":"而末流亦弥以～。","book":"清·章炳麟《原儒》"},"similar":["哗众取宠"],"usage":"作宾语、定语；形容轻浮好虚荣"},{"id":11940,"word":"哗众取宠","pinyin":"huá zhòng qǔ chǒng","abbr":"hzqc","explanation":"以浮夸的言论迎合群众，骗取群众的信赖和支持。","source":{"text":"然惑者既失精微，而辟者又随时扬抑，违离道本，苟以哗众取宠。","book":"《汉书·艺文志》"},"example":{"text":"～的人，是不受人欢迎的。"},"similar":["夸大其词"],"opposite":["实事求是"],"usage":"作宾语、定语；形容轻浮好虚荣"},{"id":11941,"word":"哭丧着脸","pinyin":"kū sāng zhe liǎn","abbr":"kszl","explanation":"心里不愉快，脸上显出不高兴的样子。","source":{"text":"那老头子哭丧着脸，不知说了一句甚么话，符老爷登时大发雷霆起来，把那独脚桌子一掀，匉訇一声，桌上的东西翻了个满地。","book":"清·吴趼人《二十年目睹之怪现状》第七十四回"},"example":{"text":"你不要老是～。"},"similar":["愁眉苦脸"],"opposite":["眉开眼笑"],"usage":"作谓语、宾语；指不高兴的样子"},{"id":11942,"word":"哭哭啼啼","pinyin":"kū kū tí tí","abbr":"kktt","explanation":"不停的哭泣。","source":{"text":"不由我哭哭啼啼，思量起雨泪沾衣。","book":"元·无名氏《冻苏秦》第二折"},"example":{"text":"她整天～，不吃不喝。"},"similar":["呜呜咽咽","抽抽噎噎"],"opposite":["哈哈大笑"],"usage":"作谓语、状语；指哭泣"},{"id":11943,"word":"哭天喊地","pinyin":"kū tiān hǎn dì","abbr":"kthd","explanation":"提高嗓门又哭又叫。","source":{"text":"说完在罗刹女肚子里连踢带打，痛得罗刹女面色苍白，哭天喊地，在地上乱滚。","book":"明·吴承恩《西游记》第二十三回"},"example":{"text":"但震惊过度，又得忙着应变，竟无人～。","book":"亦舒《流金岁月》六"},"similar":["呼天喊地"],"usage":"作谓语、状语；指悲痛"},{"id":11944,"word":"哭天抢地","pinyin":"kū tiān qiāng dì","abbr":"ktqd","explanation":"嘴里喊着天，头撞着地大声哭叫。","example":{"text":"芝秀娘～，痛不欲生，又打又骂芝秀的爹，家里乱成了一锅粥。","book":"刘绍棠《鱼菱风景》"}},{"id":11945,"word":"哭天抹泪","pinyin":"kū tiān mǒ lèi","abbr":"ktml","explanation":"形容哭哭啼啼。","source":{"text":"前日不知为什么撵出去，在家里哭天抹泪的。","book":"清·曹雪芹《红楼梦》第32回"},"example":{"text":"他听到这个小心立即～，大放悲声。"},"similar":["哭眼擦泪"],"opposite":["喜笑颜开"],"usage":"作谓语、定语；指哭泣","story":["贾宝玉调戏王夫人身边的丫鬟金钏儿，正欲动手动脚时，被王夫人看见，王夫人将金钏儿狠狠教训了一顿后，把她赶出大观园。金钏儿受了委屈，在家里哭天抹泪的，没几天就跳井自杀。贾宝玉听到消息后，找机会出门拜祭她"]},{"id":11946,"word":"哭岐泣练","pinyin":"kū qí qì liàn","abbr":"kqql","explanation":"指人的本质原本相同，只是由于受外来因素的影响而出现了差异。","source":{"text":"杨子见逵路而哭之，为其可以南，可以北。墨子见练丝而泣之，为其可以黄，可以黑。","book":"《淮南子·说林训》"}},{"id":11947,"word":"哭眼抹泪","pinyin":"kū yǎn mǒ lèi","abbr":"kyml","explanation":"哭着诉说或控诉，形容哭哭啼啼。","source":{"text":"那老婆儿哭眼抹泪的说道：‘阿弥陀佛！说也不当好听的话。’","book":"清·文康《儿女英雄传》第七回"},"similar":["哭天抹泪"],"usage":"作谓语、定语；指哭泣"},{"id":11948,"word":"哭眼擦泪","pinyin":"kū yǎn cā lèi","abbr":"kycl","explanation":"哭着诉说或控诉，形容哭哭啼啼。","source":{"text":"前日不知为什么撵出去，在家里哭天抹泪的，也都不理会他。","book":"清·曹雪芹《红楼梦》第三十二回"},"example":{"text":"再说大喜的事，这么～的，是为什么呢？","book":"清·文康《儿女英雄传》第三十二回"},"similar":["哭眼抹泪","哭天抹泪"],"usage":"作谓语、定语；指哭泣"},{"id":11949,"word":"哭笑不得","pinyin":"kū xiào bù dé","abbr":"kxbd","explanation":"哭也不好，笑也不好。形容很尴尬。","source":{"text":"好一场恶一场，哭不得笑不得。","book":"元·高安得《皮匠说谎》"},"example":{"text":"否则咬着了辣椒，～的时候，我不能负责。","book":"鲁迅《伪自由书·止哭文学》"},"similar":["啼笑皆非","不尴不尬"],"opposite":["落落大方","泰然处之"],"usage":"作谓语、定语、补语；形容处境尴尬"},{"id":11950,"word":"哲人其萎","pinyin":"zhé rén qí wěi","abbr":"zrqw","explanation":"指贤人病逝。","source":{"text":"泰山其颓乎，梁木其坏乎，哲人其萎乎！","book":"西汉·戴圣《礼记·檀弓上》"},"example":{"text":"学人文人同声哀悼，‘泰山其颓，～’的成语，在祭文挽联哀诗中随处露脸。","book":"叶圣陶《乡里善人》"},"similar":["泰山其颓"],"usage":"作谓语；用于慰唁词"},{"id":11951,"word":"哺糟啜醨","pinyin":"bǔ zāo chuò lí","abbr":"bzcl","explanation":"吃酒糟，喝薄酒。指追求一醉。亦比喻屈志从俗；随波逐流。亦比喻文字优美，令人陶醉。同“哺糟歠醨”。","source":{"text":"同甘苦于人类，好哺糟而啜醨。","book":"汉·王延寿《王孙赋》"},"similar":["哺糟歠醨"],"usage":"作谓语、宾语、定语；用于处世"},{"id":11952,"word":"哺糟歠醨","pinyin":"bǔ zāo chuò lí","abbr":"bzcl","explanation":"比喻效法时俗，随波逐流。亦作“哺糟啜醨”。","source":{"text":"语出《楚辞·渔父》“众人皆醉，何不餔其糟而歠其醨”"},"example":{"text":"～，俯同妄作，披褐怀玉，无由自陈。","book":"唐·刘知幾《史通·核才》"},"similar":["哺糟啜醨","餔糟啜醨"],"usage":"作谓语、宾语、定语；用于处世"},{"id":11953,"word":"哼哈二将","pinyin":"hēng hā èr jiàng","abbr":"hhej","explanation":"佛教守护庙门的两个金刚力士。比喻有权势者手下的干将。","source":{"text":"曹梦兰三字，比四金刚还要响亮，和琴楼梦的女主人花翠琴齐名，当时号称‘哼哈二将’。","book":"曾朴《孽海花》第32回"},"example":{"text":"他手下有～。"},"usage":"作宾语、定语；指得力助手"},{"id":11954,"word":"哼哼唧唧","pinyin":"hēng hēng jī jī","abbr":"hhjj","explanation":"形容说话装模作样，拿腔拿调。也形容生病时的呻吟声。","source":{"text":"他们必把一句话拉长了，作两三截儿，咬文嚼字，拿着腔儿，哼哼唧唧的，急的我冒火，他们那里知道。","book":"清·曹雪芹《红楼梦》第二十七回"},"example":{"text":"凤姐姐带病～的说……。","book":"清·曹雪芹《红楼梦》第一百五回"},"similar":["叽叽喳喳"],"opposite":["不哼不哈"],"usage":"作定语、状语；指小声说话"},{"id":11955,"word":"哽咽难言","pinyin":"gěng yē nán yán","abbr":"gyny","explanation":"因感情激动难以说出话来。形容很伤心痛苦而说不出话来。","source":{"text":"巧姐听了，不敢回言，只气得哽咽难鸣的哭起来了。","book":"清·曹雪芹《红楼梦》第一百十四回"},"example":{"text":"颖石说到这里，已经哭得～。","book":"冰心《斯人独憔悴》"},"usage":"作谓语、状语；用于人的神态"},{"id":11956,"word":"哽咽难鸣","pinyin":"gěng yē nán míng","abbr":"gynm","explanation":"因感情激动难以发出声音。形容很伤心而又不能痛痛快快地放声大哭。","source":{"text":"巧姐听了，不敢回言，只气得哽咽难鸣的哭起来了。","book":"清·曹雪芹《红楼梦》第一百十四回"}},{"id":11957,"word":"哽哽咽咽","pinyin":"gěng gěng yè yè","abbr":"ggyy","explanation":"不能痛快的出声哭。","source":{"text":"黛玉此时心中干急，又说不出来，哽哽咽咽。","book":"清·曹雪芹《红楼梦》第82回"},"example":{"text":"清·曹雪芹《红楼梦》第82回：“黛玉此时心中干急，又说不出来，～。”"},"similar":["呜呜咽咽"],"usage":"作谓语、状语、定语；用于哭泣"},{"id":11958,"word":"哽噎难言","pinyin":"gěng yē nán yán","abbr":"gyny","explanation":"哽：声气阻塞；噎：嗓子被食物堵塞。形容悲痛气塞，哭不出声或说不出话的样子。","source":{"text":"颖石说到这里，已经哭得哽噎难言。","book":"冰心《斯人独憔悴》"},"similar":["哽噎难鸣"],"usage":"作谓语、状语；指人很悲痛"},{"id":11959,"word":"哽噎难鸣","pinyin":"gěng yē nán míng","abbr":"gynm","explanation":"哽：声气阻塞；噎：嗓子被食物堵塞。形容悲痛气塞，哭不出声或说不出话的样子。","source":{"text":"巧姐听了，不敢回言，只气得哽噎难鸣的哭起来了。","book":"清·曹雪芹《红楼梦》第114回"},"similar":["哽噎难言"],"usage":"作谓语、状语；指人很悲痛"},{"id":11960,"word":"唇不离腮","pinyin":"chún bù lí sāi","abbr":"cbls","explanation":"比喻关系亲近，经常待在一起。","source":{"text":"你不去却怎样儿的，少不的唇不离腮，还在一处儿。","book":"明·兰陵笑笑生《金瓶梅词话》第76回"},"example":{"text":"我明白他们是“～”的关系。"},"similar":["秤不离砣","公不离婆"],"usage":"作主语、定语、宾语；比喻关系亲近"},{"id":11961,"word":"唇亡齿寒","pinyin":"chún wáng chǐ hán","abbr":"cwch","explanation":"嘴唇没有了，牙齿就会感到寒冷。比喻利害密要相关。","source":{"text":"夫鲁，齐晋之唇，唇亡齿寒，君所知也。","book":"《左传·哀公八年》"},"example":{"text":"这两家公司有着多种业务关系，正所谓是～。"},"similar":["唇齿相依","息息相关"],"opposite":["隔岸观火","素昧平生"],"usage":"作谓语、定语；用于国家、人际之间的关系","story":["春秋时期，晋国为攻打虢国，晋王采纳大将荀息的建议，送晋王的玉石与宝马给虞王，向虞国借道攻虢。虞王不接受宫之奇邻国之间就是嘴唇与牙齿的关系的观点，允许晋国借道攻虢，结果晋灭虢后三年就消灭虞国，夺回宝物"]},{"id":11962,"word":"唇如激丹","pinyin":"chún rú jī dān","abbr":"crjd","explanation":"激丹：鲜明的红色。形容嘴唇红润。","source":{"text":"今将军兼此三者，身长八尺二寸，面目有光，唇如激丹，齿如齐贝，音中黄钟，而名曰盗跖。","book":"战国·宋·庄周《庄子·盗跖》"},"usage":"作谓语；用于人的容貌"},{"id":11963,"word":"唇尖舌利","pinyin":"chún jiān shé lì","abbr":"cjsl","explanation":"指言词尖利。","example":{"text":"你唇尖舌利，让人无法回答。"}},{"id":11964,"word":"唇干口燥","pinyin":"chún gān kǒu zào","abbr":"cgkz","explanation":"形容说话过多而出现口干舌燥的现象。","source":{"text":"来日大难，口燥唇干。","book":"《古乐府·善哉行》"}},{"id":11965,"word":"唇揭齿寒","pinyin":"chún jiē chǐ hán","abbr":"cjch","explanation":"嘴唇没有了，牙齿就会感到寒冷。比喻利害密要相关。同“唇亡齿寒”。"},{"id":11966,"word":"唇敝舌腐","pinyin":"chún bì shé fǔ","abbr":"cbsf","explanation":"犹唇焦舌敝。形容说话太多，费尽唇舌。"},{"id":11967,"word":"唇枪舌剑","pinyin":"chún qiāng shé jiàn","abbr":"cqsj","explanation":"舌如剑，唇象枪。形容辩论激烈，言词锋利，象枪剑交锋一样。","source":{"text":"不在唇枪舌剑，人前斗，惺惺广学多知。","book":"金·丘处机《神光灿》"},"example":{"text":"日内瓦，话重说。换～，议倾坛席。","book":"陈毅《满江红·送周总理赴日内瓦》词"},"similar":["针锋相对"],"opposite":["促膝谈心"],"usage":"作谓语、定语、宾语；用于辩论、争论"},{"id":11968,"word":"唇焦口燥","pinyin":"chún jiāo kǒu zào","abbr":"cjkz","explanation":"焦：干。形容说话过多而口唇干燥。","source":{"text":"公然抱茅入竹去，唇焦口燥呼不得。","book":"唐·杜甫《茅屋为秋风所破歌》"},"similar":["口干舌燥"],"usage":"作谓语、状语；形容费尽口舌"},{"id":11969,"word":"唇焦舌干","pinyin":"chún jiāo shé gān","abbr":"cjsg","explanation":"说话过多，舌头干燥，嘴唇焦裂。形容费尽口舌，苦心劝说。","source":{"text":"日夜焦唇干舌，欲与吴王接踵而死。","book":"《史记·仲尼弟子列传》"},"example":{"text":"走到中午，烈日当空，四个人都～。","book":"金庸《书剑恩仇录》第十五回"}},{"id":11970,"word":"唇焦舌敝","pinyin":"chún jiāo shé bì","abbr":"cjsb","explanation":"焦：干；敝：破。嘴唇干，舌头破。形容说话太多，费尽唇舌。","source":{"text":"焦唇干舌，苦身劳力，上事群臣，下养百姓。","book":"汉·赵晔《吴越春秋·夫差内传》"},"example":{"text":"菲亚又往各自村落，逢人说项，～，语不离宗，一连跑了一个来月。","book":"清·岭南羽衣女士《东欧女豪杰》第二回"},"similar":["费尽口舌","口干舌燥"],"usage":"作谓语、状语；指费尽口舌"},{"id":11971,"word":"唇竭齿寒","pinyin":"chún jié chǐ hán","abbr":"cjch","explanation":"嘴唇没有了，牙齿就会感到寒冷。比喻利害密要相关。","source":{"text":"故曰，唇竭齿寒，鲁酒薄而邯郸围，圣人生而大盗起。","book":"《庄子·胠箧》"},"example":{"text":"川竭而谷虚，丘夷而渊塞，唇竭而齿寒。","book":"《淮南子·说林训》"},"similar":["唇亡齿寒"],"usage":"作谓语、定语；用于国家、人际之间的关系"},{"id":11972,"word":"唇红齿白","pinyin":"chún hóng chǐ bái","abbr":"chcb","explanation":"嘴唇红，牙齿白。形容人容貌俊美。","source":{"text":"唇红齿白痴小儿，不羞障面欺群丑。","book":"宋·韩驹《善相陈君持介甫子瞻手字示予戏赠短歌》"},"example":{"text":"只见～，桃花脸，绿鬓朱颜柳叶眉，因此不忍而去。","book":"明·胡文焕《琼琚记·桑下戏妻》"},"similar":["齿白唇红"],"usage":"作谓语、定语；指人的相貌"},{"id":11973,"word":"唇腐齿落","pinyin":"chún fǔ chǐ luò","abbr":"cfcl","explanation":"比喻读书讽诵极为勤苦。","source":{"text":"今子大夫修先生之术，慕圣人之义，讽诵诗书百家之言，不可胜记，著于竹帛，唇腐齿落，服膺而不可释。","book":"汉·东方朔《答客难》"},"example":{"text":"多立小数，一经至数百万言。致令学者难晓，虚诵问答，～而不知益。","book":"《隋书·经籍志一》"},"usage":"作宾语、定语；用于读书等"},{"id":11974,"word":"唇辅相连","pinyin":"chún fǔ xiāng lián","abbr":"cfxl","explanation":"犹言唇齿相依。比喻关系密切，相互依靠。","source":{"text":"辅车相依，唇亡齿寒。","book":"语出《左传·僖公五年》"},"example":{"text":"此诚不足患，却是吴三桂坐拥雄藩，将来必倡大乱，广西～，但恐封疆延祸矣。","book":"清·蒋士铨《桂林·霜幕议》"},"similar":["唇齿相须"],"usage":"作谓语、定语；用于国家地区、人际之间等"},{"id":11975,"word":"唇齿之戏","pinyin":"chún chǐ zhī xì","abbr":"cczx","explanation":"唇齿：代指言语；戏：嘲弄，开玩笑。在言语上开玩笑、兜圈子。","source":{"text":"足下深知安邦定国之道，何在唇齿之戏哉！","book":"明·罗贯中《三国演义》第八十六回"}},{"id":11976,"word":"唇齿之邦","pinyin":"chún chǐ zhī bāng","abbr":"cczb","explanation":"嘴唇与牙齿互相储存依存。比喻双方关系密切，利害与共。","source":{"text":"王师屡征而未有所克者，盖以吴、蜀唇齿相依，凭阻山水，有难拔之势故也。","book":"《三国志·魏志·鲍勋传》"},"example":{"text":"吾与孙权～，不容不相援。","book":"明·罗贯中《三国演义》第六十二回"},"similar":["唇齿之国"],"usage":"作宾语；比喻国家间关系密切"},{"id":11977,"word":"唇齿相依","pinyin":"chún chǐ xiāng yī","abbr":"ccxy","explanation":"象嘴唇和牙齿那样互相依靠。比喻关系密切，相互依靠。","source":{"text":"盖以吴、蜀唇齿相依，凭阴山水，有难拔之势故也。","book":"《三国志·魏书·鲍勋传》"},"example":{"text":"高丽王倒也识见宏远，道大宋与辽百年和好，～，不宜改图。","book":"清·陈忱《水浒后传》第十三回"},"similar":["唇亡齿寒","辅车相依"],"opposite":["不共戴天","势不两立"],"usage":"作谓语、定语；用于国家地区、人际之间等","story":["三国时期，魏文帝想攻打吴国，御史中丞鲍勋面谏魏文帝说“王师屡征而未有所克者，盖以吴蜀唇齿相依，凭阻山水，有难拔之势故也。”文帝不但不考虑有益的意见，反而十分愤怒地贬他为治书执法官"]},{"id":11978,"word":"唇齿相须","pinyin":"chún chǐ xiāng xū","abbr":"ccxx","explanation":"犹唇齿相依。比喻关系密切，相互依靠。","source":{"text":"宣镇东起四海冶、火焰山，接昌镇、黄花镇界。四海冶正直黄花镇北，适当山陵后背，乃唇齿相须之地。","book":"明·蒋一葵《长安客话·四海冶》"},"similar":["唇齿相依"],"usage":"作谓语、定语；用于国家地区、人际之间等"},{"id":11979,"word":"唉声叹气","pinyin":"āi shēng tàn qì","abbr":"astq","explanation":"因伤感郁闷或悲痛而发出叹息的声音。","source":{"text":"终日价没心没想，哀声叹气。","book":"明·凌濛初《二刻拍案惊奇》卷三十八"},"example":{"text":"我看你脸上一团私欲愁闷气色！这会子又～，你那些还不足，还不自在？","book":"清·曹雪芹《红楼梦》第三十三回"},"similar":["长吁短叹","垂头丧气","无精打采"],"opposite":["喜眉笑眼","喜笑颜开","喜气洋洋"],"usage":"作谓语、状语、补语；用于忧愁等叹息"},{"id":11980,"word":"唐临晋帖","pinyin":"táng lín jìn tiē","abbr":"tljt","explanation":"临：摹仿字画；帖：书法、绘画的范本。唐人书法多临摹晋人范本，脱胎变化而成。比喻善临摹，少独创。","source":{"text":"德机诗如何？曰：‘德机诗如唐临晋帖。’","book":"明·陶宗仪《辍耕录·论诗》"},"usage":"作宾语、定语；多用于比喻句"},{"id":11981,"word":"唐哉皇哉","pinyin":"táng zāi huáng zāi","abbr":"tzhz","explanation":"形容规模宏伟，气势盛大。也用于贬义，形容表面上庄严体面的样子。","source":{"text":"汪汪乎丕天之大律，其畴能亘之哉？唐哉皇哉！皇哉唐哉？","book":"《后汉书·班畸传》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第49回：“没有人知道，不象那～收女弟子的。”"},"similar":["冠冕堂皇"],"usage":"作谓语、定语；指规模宏伟，气势盛大"},{"id":11982,"word":"唐突西子","pinyin":"táng tū xī zǐ","abbr":"ttxz","explanation":"唐突：冒犯；西子：即西施，春秋时美女。冒犯了西施。比喻抬高了丑的，贬低了美的。","source":{"text":"何乃刻画无盐，以唐突西子也。","book":"南朝宋·刘义庆《世说新语·轻诋》"},"example":{"text":"前书可谓刻画无盐，～矣。","book":"清·恽敬《与李汀洲》"},"similar":["唐突西施"],"usage":"作谓语、定语；指亵渎比自己强的人","story":["东晋初年，很有名望的尚书仆射周顗为人特别谦虚。人们总喜欢把他与当时同样有名望的尚书令乐广相提并论，说他们两人都是才学过人、德高望重。周顗谦虚地说：“把我与他相比，是亵渎了他，那是刻画无盐、唐突西施了。”"]},{"id":11983,"word":"唐突西施","pinyin":"táng tū xī shī","abbr":"ttxs","explanation":"唐突：冒犯。西施：春秋时美女，冒犯了西施。比喻为了突出丑的，而贬低了美的。亦作“唐突西子”。","source":{"text":"以《史记》所记原歌作尾声，近于唐突西施，点窜尧典。","book":"梁启超《诗话》"},"example":{"text":"我们不能干～的时期。"},"similar":["唐突西子"],"usage":"作谓语、定语；指亵渎比自己强的人","story":["东晋初年，很有名望的尚书仆射周顗为人特别谦虚。人们总喜欢把他与当时同样有名望的尚书令乐广相提并论，说他们两人都是才学过人、德高望重。周顗谦虚地说：“把我与他相比，是亵渎了他，那是刻画无盐、唐突西施了。”"]},{"id":11984,"word":"唐虞之治","pinyin":"táng yú zhī zhì","abbr":"tyzz","explanation":"唐虞：唐尧、虞舜，传说中的古代圣帝贤君。旧指上古政治清明，人民康乐的理想时代。","source":{"text":"吴楚材等尾批‘谁谓唐虞之治，不可见于今哉。’","book":"《古文观止·王鏊〈亲政篇〉》"}},{"id":11985,"word":"唠唠叨叨","pinyin":"lāo lāo dāo dāo","abbr":"lldd","explanation":"说话罗嗦，一说起来没个完。","source":{"text":"古人胸中高明，一见便了……未若后世唠唠叨叨，支支离离，弃本逐末，侈为乖谬。","book":"宋·郑思肖《答吴山人问远游观地理书》"},"example":{"text":"他的老婆老是～个没完。"},"similar":["絮絮叨叨"],"opposite":["干净利落"],"usage":"作谓语、宾语；指说话罗嗦"},{"id":11986,"word":"唧唧咕咕","pinyin":"jī jī gū gū","abbr":"jjgg","explanation":"低声说话。","source":{"text":"说刚才二奶奶从老太太屋里回来，不似往日欢天喜地的，叫了平儿去，唧唧咕咕的不知说了些什么。","book":"清·曹雪芹《红楼梦》第67回"},"example":{"text":"王朔《橡皮人》：“干脆不理我，同张燕生～，活象一对粪里刨食的公母鸡。”"},"similar":["嘀嘀咕咕"],"usage":"作定语、状语；指小声说话"},{"id":11987,"word":"唧唧哝哝","pinyin":"jī jī nóng nóng","abbr":"jjnn","explanation":"小声唠叨。形容说话声音低且含混不清。","source":{"text":"安祖向建德耳边唧唧哝哝的说了许多话，却又快活起来。","book":"清·褚人获《隋唐演义》第59回"},"example":{"text":"清·褚人获《隋唐演义》第59回：“安祖向建德耳边～的说了许多话，却又快活起来。”"},"similar":["唧唧咕咕","唧唧啾啾"],"opposite":["大喊大叫"],"usage":"作定语、状语；指小声嘀咕"},{"id":11988,"word":"唧唧喳喳","pinyin":"jī jī zhā zhā","abbr":"jjzz","explanation":"形容杂乱尖细的声音。","source":{"text":"里面住了许多窝麻雀，一天到晚唧唧喳喳的，倒也有一番热闹景致。","book":"路遥《平凡的世界》第一卷第21章"},"example":{"text":"女孩子们一直在～地说话。"},"similar":["叽叽喳喳"],"usage":"作谓语、状语；形容杂乱尖细的声音"},{"id":11989,"word":"唧唧嘎嘎","pinyin":"jī jī gā gā","abbr":"jjgg","explanation":"象声词，形容说笑声等。","example":{"text":"请保持安静，不要发出～的声音。"},"similar":["叽叽嘎嘎"],"usage":"作定语、状语；用于拟声"},{"id":11990,"word":"唬鬼瞒神","pinyin":"xià guǐ mán shén","abbr":"hgms","explanation":"唬：同“吓”。形容欺下瞒上。","source":{"text":"据着你这所为，来这里唬鬼瞒神，做的个藏头露尾。","book":"元·孔文卿《东窗事犯》第二折"},"example":{"text":"姐姐，你休信人～，却是些趋人叹人。","book":"明·胡文焕《群音类选·斗鹌鹑》"},"similar":["欺下瞒上"],"usage":"作谓语、定语；指欺骗"},{"id":11991,"word":"售胝足之药","pinyin":"shòu zhī zú zhī yào","abbr":"szzzy","explanation":"胝：手掌或脚掌上的老茧。指卖狗皮膏药骗人。","source":{"text":"昔人有以胝足之药售于市者，辄揭扁于门曰：‘供御。’","book":"《厅史》"},"usage":"作谓语、宾语；指卖狗皮膏药","story":["从前有人在市场上卖治脚茧药，在门上挂“供御”的招牌，人们讥笑他不诚实。皇帝知道后，派人传唤他，并把他投入监狱。他遇大赦而回家，就又重操旧业，在招牌上面增加“曾经宣唤”4字，以此来招徕顾客"]},{"id":11992,"word":"唯一无二","pinyin":"wéi yī wú èr","abbr":"wywe","explanation":"没有相同的或没有可以相比的。","source":{"text":"独一无二，即真解脱。","book":"宋·延寿辑《宗镜录》卷三十一"},"example":{"text":"这件事儿，说也话长，真是江苏省内～的新闻。","book":"清·张春帆《九尾龟》第四十九回"},"similar":["独一无二"],"usage":"作谓语、定语；指唯一"},{"id":11993,"word":"唯利是从","pinyin":"wéi lì shì cóng","abbr":"wlsc","explanation":"唯：只有。一心求利，别的什么都不顾。","source":{"text":"卿勿以部曲轻少，难于东迈。齐人浇薄，唯利是从。","book":"《魏书·侯渊传》"},"example":{"text":"小人之情，～，若见新军如此，则旧兵皆不为朝廷用矣。","book":"清·毕沅《续资治通鉴》卷八十九"},"similar":["唯利是图","惟利是趋"],"usage":"作谓语、定语、宾语；用于处事"},{"id":11994,"word":"唯利是图","pinyin":"wéi lì shì tú","abbr":"wlst","explanation":"唯：只有；图：图谋，追求。只要有利可图，什么事都干。","source":{"text":"余虽与晋出入，余唯利是视。","book":"《左传·成公十三年》"},"example":{"text":"原来这黄祸居乡，～，无恶不作。","book":"清·颐琐《黄绣球》第五回"},"similar":["自私自利","见利忘义"],"opposite":["大公无私","见义勇为"],"usage":"作谓语、宾语、定语；指只要有利就干","story":["春秋时期，秦桓公经常不讲信义，他与晋厉公在令狐签订盟约，回国后就背信弃义，怂恿狄、楚去进攻晋国，他对楚王说：“余虽与晋出入，余唯利是视。”晋厉公非常气愤，派大臣吕相去与秦国绝交，两国断交后不久就发生了战争"]},{"id":11995,"word":"唯利是求","pinyin":"wéi lì shì qiú","abbr":"wlsq","explanation":"以利为着眼点。指一心只顾谋取利益。同“唯利是视”。","source":{"text":"其衣冠子弟，多自修立，非气类者，唯利是求，暴物乱政。","book":"南朝·梁·沈约《齐故安陆昭王碑文》：“征赋严切，唯利是求。”《隋书·百官志上》"},"example":{"text":"张虔钊多贪……心与口背，～。","book":"宋·孙光宪《北梦琐言》卷十九"},"similar":["唯利是从","唯利是视","惟利是视"],"usage":"作谓语、定语、宾语；用于处事"},{"id":11996,"word":"唯利是视","pinyin":"wéi lì shì shì","abbr":"wlss","explanation":"以利为着眼点。指一心只顾谋取利益。亦作“唯利是求”。亦作“唯利是图”。","source":{"text":"余虽与晋出入，余唯利是视。","book":"《左传·成公十三年》"},"example":{"text":"晋·陈寿《三国志·魏志·吕布传评》：“吕布有虓虎之勇，而无英奇之略，轻较反复，～。”"},"similar":["唯利是求","唯利是从","惟利是视"],"usage":"作谓语、定语、宾语；用于处事"},{"id":11997,"word":"唯利是趋","pinyin":"wéi lì shì qū","abbr":"wlsq","explanation":"唯：只有。一心求利，别的什么都不顾。","source":{"text":"余虽与晋出入，余唯利是视。","book":"《左传·成公十三年》"},"example":{"text":"故凡待援于人者，类为人所持以自毙。况夷狄之～，不可以理感情合者乎？","book":"清·王夫之《读通鉴论·德宗》"}},{"id":11998,"word":"唯力是视","pinyin":"wéi lì shì shì","abbr":"wlss","explanation":"唯：助词。是：指示代词，复指前置宾语。“唯……是……”是古汉语的一种格式，有强调语意的作用。指在任务重、困难多的情况下，能否达到目的，主要就看自己的力","source":{"text":"除君之恶，唯力是视。","book":"《左传·僖公二十四年》"},"example":{"text":"即如前次北师深入，寇扰边民，外臣职守所关，～；难道北朝政府，反导人不忠么？","book":"蔡东藩《南北史演义》第三十三回"}},{"id":11999,"word":"唯吾独尊","pinyin":"wéi wú dú zūn","abbr":"wwdz","explanation":"原为佛家语，称颂释迦牟尼最高贵、最伟大。现指认为只有自己最了不起。形容极端自高自大。同“唯我独尊”。","source":{"text":"天上天下，唯吾独尊。","book":"宋·释普济《五灯会元·七佛·释迦牟尼佛》"},"similar":["唯我独尊"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指人自高自大"},{"id":12000,"word":"唯命是从","pinyin":"wéi mìng shì cóng","abbr":"wmsc","explanation":"唯：唯独。是命令就服从。形容完全服从命令","source":{"text":"今周与四国服事君王，将唯命是从，岂其爱鼎？","book":"春秋·鲁·左丘明《左传·昭公十二年》"},"example":{"text":"清·荑荻散人《玉娇梨》第三回：“学生在此做的是朝廷的官，朝廷有命，东西南北，～。”"},"similar":["百依百顺","唯唯诺诺"],"opposite":["桀骜不驯"],"usage":"作谓语、宾语、定语；指完全服从命令","story":["公元前597年，楚庄王率大军讨伐郑国，攻破郑国都城。郑襄公裸露上身跪迎楚庄王，说可以占领郑国，让郑国人作奴仆，或者给他一个朝贡的机会，他都可以唯命是从。楚庄王看他十分可怜就答应退兵，允许郑国求和，并订立盟约"]},{"id":12001,"word":"唯命是听","pinyin":"wéi mìng shì tīng","abbr":"wmst","explanation":"是命令就服从，不敢有半点违抗。","source":{"text":"孤不天，不能事君，使君怀怒以及敝邑，孤之罪也。敢不唯命是听。","book":"《左传·昭公十二年》"},"example":{"text":"那我不费俄顷的的迟疑，或许早就是～的。","book":"郭沫若《革命春秋·创造十年》"},"similar":["唯命是从"],"usage":"作谓语、宾语、定语；指完全服从命令"},{"id":12002,"word":"唯唯否否","pinyin":"wěi wěi fǒu fǒu","abbr":"wwff","explanation":"唯唯：回答时表示同意的应声；否否：别人说否，自己也跟着说否。形容胆小怕事，一味顺从。","source":{"text":"君所谓可，据（指梁邱据）亦曰可；君所谓否，据亦曰否。","book":"《左传·昭公二十年》"},"example":{"text":"请你作出明确的回答，不要～。"}},{"id":12003,"word":"唯唯听命","pinyin":"wéi wéi tīng mìng","abbr":"wwtm","explanation":"是命令就服从，不敢有半点违抗。形容绝对服从。","source":{"text":"孤不天，不能事君，使君怀怒以及敝邑，孤之罪也。敢不唯命是听。","book":"《左传·昭公十二年》"},"example":{"text":"如海又说：“择了出月初二日小女入都，吾兄即同路而往，岂不两便？”雨村～。","book":"清·曹雪芹《红楼梦》第三回"}},{"id":12004,"word":"唯唯绸否","pinyin":"wěi wěi fǒu fǒu","abbr":"wwcf","explanation":"唯唯：同意的应声；否否：别人说否，自己也跟着说否。形容虚与委蛇，不可置否。","source":{"text":"太史公曰：‘唯唯，否否，不然。’","book":"西汉·司马迁《史记·太史公自序》"},"example":{"text":"老头子的话似乎就不会有完结的时候。青年只是～地应着。","book":"巴金《雾》"},"similar":["不可置否"],"usage":"作谓语、定语；形容胆小怕事"},{"id":12005,"word":"唯唯诺诺","pinyin":"wěi wěi nuò nuò","abbr":"wwnn","explanation":"诺诺：答应的声音。形容自己没有主意，一味附和，恭顺听从的样子。","source":{"text":"此人主未命而唯唯，未使而诺诺，先意承旨，观貌察色，以先主心者也。","book":"《韩非子·八奸》"},"example":{"text":"他思念父母面上，一体同气，听其教诲，～，并不违拗。","book":"明·冯梦龙《醒世恒言》卷二"},"similar":["唯唯否否","唯唯连声","唯命是从"],"opposite":["强头倔脑","桀骜不驯"],"usage":"作谓语、定语、状语；指没主见"},{"id":12006,"word":"唯唯连声","pinyin":"wěi wěi lián shēng","abbr":"wwls","explanation":"唯唯：谦卑的应答。连声应答，以示顺从。","source":{"text":"徒闻唯唯，不闻周舍之谔谔。","book":"《史记·赵世家》"},"example":{"text":"船家～，搭扶手，请上了船。","book":"清·吴敬梓《儒林外史》第二十二回"},"similar":["唯唯诺诺"],"usage":"作谓语、状语；指顺从"},{"id":12007,"word":"唯妙唯肖","pinyin":"wéi miào wéi xiào","abbr":"wmwx","explanation":"唯：同“惟”；肖：相似。形容描绘或仿造得简直和真的一模一样","source":{"text":"这样从锣鼓中把古人的一举一动形容得唯妙唯肖。","book":"老舍《赵子曰》"},"example":{"text":"他把她画得～"},"similar":["惟妙惟肖"],"usage":"作状语、定语；同“惟妙惟肖”"},{"id":12008,"word":"唯心主义","pinyin":"wéi xīn zhǔ yì","abbr":"wxzy","explanation":"物质世界是意识、精神的产物，意识、精神是第一性的，物质是第二性的哲学观点。","example":{"text":"～的观点难以苟同。"},"similar":["唯心论"],"opposite":["唯物主义"],"usage":"作主语、宾语、定语；用于哲学等"},{"id":12009,"word":"唯恐天下不乱","pinyin":"wéi kǒng tiān xià bù luàn","abbr":"wktxbl","explanation":"恐：恐怕。指希望天下大乱以达到自身的目的。","source":{"text":"这种混乱状况确实给一些唯恐天下不乱的人的活动，提供了一方面的有利条件。","book":"邓小平《贯彻调整方针，保证安定团结》"},"example":{"text":"王朔《一半是火焰，一半是海水》：“瞬息万变，～。”"},"usage":"作谓语、宾语、定语；用于处世"},{"id":12010,"word":"唯我独尊","pinyin":"wéi wǒ dú zūn","abbr":"wwdz","explanation":"原为佛家语，称颂释迦牟尼最高贵、最伟大。现指认为只有自己最了不起。形容极端自高自大。","source":{"text":"天上天下，唯吾独尊。","book":"宋·释普济《五灯会元》卷一"},"example":{"text":"孤家看来，朝里朝外，～。","book":"元·无名氏《连环计》第一折"},"similar":["妄自尊大","自高自大"],"opposite":["虚怀若谷","虚己以听"],"usage":"作谓语、定语；指人自高自大","story":["古印度北部迦毗罗卫国净饭王的儿子释迦牟尼29岁痛感人世生老病死的各种苦恼，放弃王族生活，出家修道，经过6年的修行终于得道，创立了佛教。佛经里说他从右肋出生，能立即走路，左手指天，右手指地，大声说：“天上天下，惟我独尊。”"]},{"id":12011,"word":"唯所欲为","pinyin":"wéi suǒ yù wéi","abbr":"wsyw","explanation":"随心所欲，任意而为。","source":{"text":"扞铜仪呴所以准验辰历，分考次度，其于揆测，唯所欲为之者也。","book":"语出《隋书·天文志上》"},"example":{"text":"严复《辟韩》：“今韩子务尊其尤强硬，最能欺夺之一人，使安坐而出其～之令。”"},"similar":["为所欲为"],"usage":"作谓语、定语；一样书面语"},{"id":12012,"word":"唯才是举","pinyin":"wéi cái shì jǔ","abbr":"wcsj","explanation":"只要是有才能的人就荐举。","source":{"text":"二三子其佐我仄陋，唯才是举，吾得而用之。","book":"三国·魏·曹操《求贤令》"},"example":{"text":"今选举不采职政之优劣，专简年劳之多少，斯非尽才之谓。宜弃彼朽劳，～。","book":"《北史·高允传》"}},{"id":12013,"word":"唯物主义","pinyin":"wéi wù zhǔ yì","abbr":"wwzy","explanation":"认为世界就其本质来说是物质的，是不依赖于人的意识而客观存在的，意识是物质存在在人脑中的反映的哲学观点。","source":{"text":"我们要坚持马克思主义的～观。"},"example":{"text":"我们要坚持马克思主义的～观"},"similar":["唯物论"],"opposite":["唯心主义"],"usage":"作主语、宾语、定语；用于哲学等"},{"id":12014,"word":"唯邻是卜","pinyin":"wéi lín shì bǔ","abbr":"wlsb","explanation":"指找住房应该选择邻居。","source":{"text":"非宅是卜，唯邻是卜。","book":"《左传·昭公三年》"},"usage":"作谓语、定语；用于处事"},{"id":12015,"word":"唯阿之间","pinyin":"wéi ā xhī jiān","abbr":"wazj","explanation":"唯、阿：为答应声。比喻差别不大。","source":{"text":"宰卫相去，唯阿之间。","book":"《老子》第二十章：“唯之与阿，相去几何？”《宋书·蔡兴宗传》"}},{"id":12016,"word":"唯食忘忧","pinyin":"wéi shí wàng yōu","abbr":"wswy","explanation":"食：吃饭；忧：忧愁。人生要经历许多愁苦，只有在吃饭时可以暂时忘却。","source":{"text":"唯食忘忧，吾子置食之间三叹，何也。","book":"《左传引谚》：“唯食忘忧，民保于信。”《左传·昭公二十八年》"}},{"id":12017,"word":"唯马首是瞻","pinyin":"wéi mǎ shǒu shì zhān","abbr":"wmssz","explanation":"瞻：往前或向上看。原指古代作战时士兵看着主将的马头决定进退。后比喻追随某人行动。","source":{"text":"鸡鸣而驾，塞井夷灶，唯余马首是瞻。","book":"《左传·襄公十四年》"}},{"id":12018,"word":"唱反调","pinyin":"chàng fǎn diào","abbr":"cfd","explanation":"发表完全对立的言论；采取对立的举措。","source":{"text":"后悔自己笨，一味的唱反调。","book":"向春《煤城激浪》"},"similar":["唱对台戏"],"usage":"作谓语、宾语、定语；用于口语"},{"id":12019,"word":"唱对台戏","pinyin":"chàng duì tái xì","abbr":"cdtx","explanation":"过去，两个戏班子为了抢生意，有时候会硐一时间演同样的戏，称为唱对台戏。比喻采取与对方相对的行动，来反对或搞垮对方。","source":{"text":"毛主席说，要唱对台戏，唱对台戏比单干好。","book":"邓小平《共产党要接受监督》"},"example":{"text":"他特别喜欢～。"},"similar":["唱反调"],"opposite":["齐心协力"],"usage":"作谓语、宾语、定语；指与对方对着干"},{"id":12020,"word":"唱沙作米","pinyin":"chàng shā zuò mǐ","abbr":"cszm","explanation":"比喻以假乱真或以劣为优。","source":{"text":"予所谓多，谓不可删逸之多，非唱沙作米、强凫变鹤之多也。","book":"清·李渔《闲情偶寄·词曲·宾白》"},"similar":["唱筹量沙"],"usage":"作宾语、定语；用于处事"},{"id":12021,"word":"唱筹量沙","pinyin":"chàng chóu liáng shā","abbr":"ccls","explanation":"把沙当做米，量时高呼数字。比喻安定军心，制造假象来迷惑敌人。","source":{"text":"道济夜唱筹量沙，以所余少米散其上。","book":"《南史·檀道济传》"},"example":{"text":"那时同了你高飞远走，他怎生奈何我？这叫做～的计。","book":"清·俞万春《荡寇志》第七十二回"},"similar":["唱沙作米"],"usage":"作谓语、定语；指制造假象迷惑对方","story":["南朝宋文帝元嘉元年，宋朝将军檀道济北伐北魏，一路孤军深入，粮草难继，北魏援军接到投降士兵的报告说守兵无粮，深夜潜入宋兵营探听虚实。檀道济命令士兵用沙充当大米称量并大声唱筹来迷惑北魏间谍，终于平安撤军回宋"]},{"id":12022,"word":"唱高调","pinyin":"chàng gāo diào","abbr":"cgd","explanation":"发表似乎高明但脱离实际的论调或说得很好听而不实际去做。","source":{"text":"外边树梢头的蝉儿却在那里唱高调：‘要死哟！要死哟！’","book":"茅盾《茅盾选集·雷雨前》"},"example":{"text":"他习惯于～。"},"similar":["说大话"],"opposite":["唱低调"],"usage":"作谓语、宾语、定语；指人爱吹牛"},{"id":12023,"word":"唾地成文","pinyin":"tuò dì chéng wén","abbr":"tdcw","explanation":"形容文思敏捷。","source":{"text":"有人谒李贺，见其久而不言，唾地者三，俄而成文三篇。","book":"唐·冯贽《云仙杂记》有“唾地成文”一目，赞李贺云"},"similar":["出口成章","脱口成章"],"usage":"作谓语、定语；用于书面语"},{"id":12024,"word":"唾壶击碎","pinyin":"tuò hú jī suì","abbr":"thjs","explanation":"唾壶：古代的痰盂。形容对文学作品的高度赞赏。","source":{"text":"以如意打唾壶，壶口尽缺。","book":"南朝·宋·刘义庆《世说新语·豪爽》"},"example":{"text":"主人顾我何不歌，～意则那？","book":"李木庵《延安雅集》"},"similar":["唾壶敲缺","唾壶击缺"],"usage":"作宾语、定语；指对文学作品的高度赞赏","story":["晋朝时期，大将军王敦每次喝完酒后总是吟咏曹操的诗句：“老骥伏枥，志在千里。烈士暮年，壮心不已。”一边吟咏一边用如意敲打唾壶，壶口都给敲破了"]},{"id":12025,"word":"唾壶击缺","pinyin":"tuò hú jī quē","abbr":"thjq","explanation":"形容心情忧愤或感情激昂。","source":{"text":"王处仲（王敦）每酒后辄咏‘老骥伏枥，志在千里。烈士暮年，壮心不已’。以如意打唾壶，壶口尽缺。","book":"南朝·宋·刘义庆《世说新语·豪爽》"},"similar":["唾壶敲缺","唾壶击碎"],"usage":"作宾语、定语；指对文学作品的高度赞赏","story":["晋朝时期，大将军王敦对时局十分关切，常忧国忧民，每次喝完酒后总是吟咏曹操的诗句：“老骥伏枥，志在千里。烈士暮年，壮心不已。”一边吟咏一边用如意敲打唾壶，壶口都给敲破了"]},{"id":12026,"word":"唾壶敲缺","pinyin":"tuò hú qiāo quē","abbr":"thqq","explanation":"形容心情忧愤或感情激昂。同“唾壶击缺”。","source":{"text":"以如意打唾壶，壶口尽缺。","book":"南朝·宋·刘义庆《世说新语·豪爽》"},"example":{"text":"清·吴愧庵《营中送春》：“一半春光缧绁过，～待如何。”"},"similar":["唾壶击缺","唾壶击碎"],"usage":"作宾语、定语；指对文学作品的高度赞赏","story":["晋朝时期，大将军王敦忧国忧民，面对当前的局势总是十分感慨。每次喝完酒后总是吟咏曹操的诗句：“老骥伏枥，志在千里。烈士暮年，壮心不已。”一边吟咏一边用如意敲打唾壶，壶口都给敲破了"]},{"id":12027,"word":"唾手可取","pinyin":"tuò shǒu kě qǔ","abbr":"tskq","explanation":"唾手：往手上吐唾沫。比喻极容易得到。","source":{"text":"但遣一二慎将，付锐兵十万，翔会云輣，唾手可取。","book":"《新唐书·褚遂良传》"},"example":{"text":"～的东西我们不能拿。"},"similar":["唾手可得"],"opposite":["难上加难"],"usage":"作谓语、定语；比喻极容易得到","story":["唐太宗时，唐朝属国高丽国发生内乱，大臣支离杀死唐太宗立的国王后自立为王，唐太宗想亲征高丽。大将褚遂良认为这点小事不必皇帝亲征，派一两名精干的大将带上十万兵马出征，小小高丽就“唾手可取”"]},{"id":12028,"word":"唾手可待","pinyin":"tuò shǒu kě dài","abbr":"tskd","explanation":"唾手：往手上吐唾沫。比喻很快就可以得到或成功。","source":{"text":"可乘此机会，就好取幽州。若得了幽州，辽国之亡，唾手可待。","book":"明·施耐庵《水浒传》第86回"},"similar":["唾手可得"],"usage":"作谓语、定语；用于处事"},{"id":12029,"word":"唾手可得","pinyin":"chuí shǒu kě dé","abbr":"tskd","explanation":"垂：垂下。手不动就能得到。形容毫不费力。","source":{"text":"那个姿性，读不上三二年，功名是可以垂手而得的。","book":"清·李绿园《歧路灯》第三十八回"},"example":{"text":"只除教呼延灼将军赚开城门～！","book":"清·陈忱《水浒后传》第十八回"},"similar":["易如反掌","轻而易举","唾手而得"],"opposite":["大海捞针","难于登天"],"usage":"作谓语、定语；指容易得到","story":["唐太宗时，唐朝属国高丽国发生内乱，大臣支离杀死唐太宗立的国王后自立为王，唐太宗想亲征高丽。大将褚遂良认为这点小事不必皇帝亲征，派一两名精干的大将带上十万兵马出征，小小高丽就“唾手可取”"]},{"id":12030,"word":"唾手而得","pinyin":"tuò shǒu ér dé","abbr":"tsed","explanation":"唾手：往手上吐唾沫。比喻极容易得到的东西。","source":{"text":"如果说过去日寇差不多不费一点气力唾手而得东四省，现在就非经过血战不能占领中国的土地了。","book":"毛泽东《和英国记者贝特兰的谈话》"},"example":{"text":"毛泽东《和英国记者贝特兰的谈话》：“如果说过去日寇差不多不费一点气力～东四省，现在就非经过血战不能占领中国的土地了。”"},"similar":["唾手可得"],"usage":"作谓语、定语；指容易得到"},{"id":12031,"word":"唾玉钩银","pinyin":"tuò yù gōu yín","abbr":"tygy","explanation":"唾：出言；钩银：形容字的笔划刚劲有力。字如银钩，出言如美玉。用作对他人书法诗文的赞美之辞。","source":{"text":"谢人惠书云辱银钩玉唾。","book":"宋·胡继宗《书言故事·书翰类》"},"example":{"text":"和篇勤唾玉，枉教妙钩银。","book":"元·方回《湖口寄方去言》"},"similar":["银钩玉唾"],"usage":"作宾语、定语；多用于比喻句"},{"id":12032,"word":"唾面自干","pinyin":"tuò miàn zì gān","abbr":"tmzg","explanation":"别人往自己脸上吐唾沫，不擦掉而让它自干。形容受了污辱，极度容忍，不加反抗。","source":{"text":"其弟守代州，辞之官，教之耐事。弟曰：‘有人唾面，洁之乃已。’师德曰：‘未也，洁之，是违其怒，正使自干耳。’","book":"《新唐书·娄师德传》"},"example":{"text":"若讲能够忍耐的，莫若本朝去世不久的娄师德了：他告诉兄弟，教他～。","book":"清·李汝珍《镜花缘》第三十八回"},"similar":["逆来顺受"],"opposite":["针锋相对"],"usage":"作谓语、定语；指逆来顺受","story":["唐朝监察御史娄师德率军抗击吐蕃进攻，八战八捷，深得武则天的器重，提拔为宰相。他为人处世宽宏大量，他问即将出任代州刺史的弟弟如何对待别人挑衅，弟弟说即使别人吐唾沫到脸上自己擦掉就行了，而他坚持要让唾沫自己干"]},{"id":12033,"word":"商山四皓","pinyin":"shāng shān sì hào","abbr":"sssh","explanation":"旧时泛指有名望的隐士。","source":{"text":"《史记·留侯世家》中记载的汉初商山的四个隐士。"},"example":{"text":"一叫做东园公，一叫做夏黄公，一叫做绮里季，一叫做甪里先生。向来蛰居商山，号为～。","book":"蔡东藩《前汉演义》第三十九回"}},{"id":12034,"word":"商彝周鼎","pinyin":"shāng yí zhōu dǐng","abbr":"syzd","explanation":"彝、鼎：古代祭祀用的鼎、尊等礼器。商周的青铜礼器。泛称极其珍贵的古董。","source":{"text":"得其片言只字，自令旷心怡神，非必商彝周鼎之为宝也。","book":"明·沈榜《宛署杂记·古墨斋》"},"example":{"text":"满架图书，却堆得七横八竖，桌上列着无数的～，古色斑斓。","book":"清·曾朴《孽海花》第十一回"}},{"id":12035,"word":"商彝夏鼎","pinyin":"shāng yí xià dǐng","abbr":"syxd","explanation":"夏商的青铜礼器。泛称极其珍贵的古董。","source":{"text":"君文气息逼似《两京》，次者亦韩潮苏海，若以此猎取功名，譬犹执商彝夏鼎鬻诸五都之肆，非弗宝贵，而无如识者希也。","book":"清·沈起凤《谐铎·吕仙宝筏》"},"example":{"text":"其为害也，惊心振耳，污～之光。","book":"清·李百川《绿野仙踪》第七回"},"similar":["夏鼎商彝"],"usage":"作宾语、定语；指文物"},{"id":12036,"word":"商羊鼓舞","pinyin":"shāng yáng gǔ wǔ","abbr":"sygw","explanation":"商羊：传说鸟名。商羊飞舞定有大雨。比喻重大变故发生之前的预兆。","source":{"text":"且谣曰：‘天将大雨，商羊鼓舞。’","book":"《孔子家语·辨政》"},"example":{"text":"明·冯梦龙《警世通言》第40卷：“石燕飞翔，～。滂沱的云中泻下，就似倾盆。”"},"similar":["商羊起舞"],"usage":"作宾语、定语；指大雨的预兆","story":["春秋时期，齐国有一种独脚的鸟飞到宫殿上方，停在大殿前，单脚起跳，跳得很欢。齐侯觉得十分奇怪，因为没有见过，就派聘鲁去问孔子。孔子告诉他这种鸟叫商羊，像儿童玩单脚跳，边跳边展翅舞动，表示天将下暴雨"]},{"id":12037,"word":"商鉴不远","pinyin":"shāng jiàn bù yuǎn","abbr":"sjby","explanation":"鉴：镜子；商鉴：可以作为商朝的借鉴。前朝覆灭时间不长，应从中吸取教训。后泛指前人失败的教训就在眼前，应引以为鉴。","source":{"text":"空国之师，商鉴不远，彼必不肯再用危道，万一猖獗，特不过调沿边戍卒而已，戍卒岂能必其胜，此一不敢必战也。","book":"宋·辛弃疾《美芹十论·察情》"},"example":{"text":"～，而伦又欲陛下效之。","book":"蔡东藩《宋史演义》第七十三回"}},{"id":12038,"word":"啖之以利","pinyin":"dàn zhī yǐ lì","abbr":"dzyl","explanation":"啖：吃，引诱；利：利益、好处。用优厚的利益和好处引诱或收买人。","source":{"text":"沛公以为诈，乃用张良计，使郦生、陆贾往说秦将，啖以利。","book":"《史记·高祖纪》"}},{"id":12039,"word":"啖以甘言","pinyin":"dàn yǐ gān yán","abbr":"dygy","explanation":"啖：引诱；甘：甜。用甜言蜜语去引诱人。","source":{"text":"啖以甘言，效其珍物，有求则从，惟恐少拂其意。","book":"宋·陈亮《酌古论·孙权》"},"usage":"作谓语、定语；用于处事"},{"id":12040,"word":"啖以重利","pinyin":"dàn yǐ zhòng lì","abbr":"dyzl","explanation":"啖：吃，引诱；重：大、厚；利：利益、好处。用优厚的利益和好处引诱或收买人。","source":{"text":"沛公以为诈，乃用张良计，使郦生、陆贾往说秦将，啖以利。","book":"《史记·高祖纪》"},"usage":"作谓语、定语；指收买人"},{"id":12041,"word":"啖指咬舌","pinyin":"dàn zhǐ yǎo shé","abbr":"dzys","explanation":"啖：吃。恐惧不敢多言的样子。","example":{"text":"他被爆炸吓得～。"},"usage":"作定语、状语；用于害怕"},{"id":12042,"word":"啖饭之道","pinyin":"dàn fàn zhī dào","abbr":"dfzd","explanation":"啖：吃：道：方法，道理。指谋生的方法。含嘲弄的意味。","source":{"text":"登仕，是啖饭之道，归隐，也是啖饭之道。","book":"鲁迅《隐士》"},"example":{"text":"人离不开～。"},"usage":"作宾语；指谋生，含嘲笑意思"},{"id":12043,"word":"啛啛喳喳","pinyin":"cuì cuì chā chā","abbr":"cccc","explanation":"“啛”念cuì。象声词。形容杂乱细碎的说话声。","example":{"text":"夜深了，他们还在啛啛喳喳的说个没完。"}},{"id":12044,"word":"啜英咀华","pinyin":"chuò yīng jǔ huá","abbr":"cyjh","explanation":"“啜”念chuò。比喻品赏、体味诗文的精华。","source":{"text":"沉浸醲郁，含英咀华。","book":"语出唐·韩愈《进学解》"},"similar":["含英咀华"],"usage":"作谓语、宾语；用于诗文等"},{"id":12045,"word":"啜菽饮水","pinyin":"chuò shū yǐn shuǐ","abbr":"csys","explanation":"啜：吃；菽：豆类。饿了吃豆羹，渴了喝清水。形容生活清苦。","source":{"text":"孔子曰：啜菽饮水尽其欢，斯之谓孝。","book":"《荀子·天论》：“君子啜菽饮水，非愚也，是节然也。”《礼记·檀弓下》"},"example":{"text":"使举吾民～之资，而悉节减之以偿国债。","book":"清·梁启超《国民筹还国债问题》"},"similar":["饮水啜菽"],"usage":"作谓语、宾语、定语；形容生活很艰苦"},{"id":12046,"word":"啜食吐哺","pinyin":"chuò shí tǔ bǔ","abbr":"cstb","explanation":"辍：中止，停止。停止用饭，吐出口中含的食物。","source":{"text":"汉王辍食吐哺，骂曰：‘竖儒，几败而公事！’","book":"《史记·留侯世家》"}},{"id":12047,"word":"啧啧称奇","pinyin":"zé zé chēng qí","abbr":"zzcq","explanation":"啧啧：咂嘴赞叹的声音。咂着嘴表示赞叹和惊奇。","source":{"text":"是日，红豆之喜固到尽情，鸾吹之喜亦真竭致，合府之人，眼见骨肉奇逢，个个眉花眼笑，啧啧称奇。","book":"清·夏敬渠《野叟曝言》第一百二十二回"},"example":{"text":"一灯听了他的解释，不由得～。（金庸《神雕侠侣》第三十回）"}},{"id":12048,"word":"啧啧称美","pinyin":"zé zé chēng měi","abbr":"zzcm","explanation":"啧啧：咂嘴赞叹的声音。咂着嘴表示赞美。","source":{"text":"众官看了，见楷书如美女簪花，草书如龙蛇飞舞，隶书擅蔡邕之长，篆书尽李斯之妙，无不点首吐舌，啧啧称美。","book":"明·罗贯中《平山冷燕》第四回"},"example":{"text":"席上陈设，多是南方佳玩，就是银杯象箸，亦无不雕刻玲珑。约且饮且赏，～。（蔡东藩《南北史演义》第八十七回）"}},{"id":12049,"word":"啧啧称羡","pinyin":"zé zé chēng xiàn","abbr":"zzcx","explanation":"啧啧：咂嘴声，表示赞叹。啧啧连声地表示羡慕。亦作“啧啧称赞”。","source":{"text":"那批热中朋友，谁不啧啧称羡。","book":"蔡东藩、许廑父《民国演义》第一百二十八回"},"example":{"text":"清·秋瑾《敬告姊妹们》：“在家时，颐指气使，威阔得了不得……外人也就～。”"},"similar":["啧啧称赞","啧啧赞美"],"usage":"作谓语；用于书面语"},{"id":12050,"word":"啧啧称赏","pinyin":"zé zé chēng shǎng","abbr":"zzcs","explanation":"啧啧：咂嘴赞叹的声音。","source":{"text":"一部卒妻郭氏有令姿，见之无不啧啧称赏，李心慕焉。","book":"明·陶宗仪《辍耕录·贞烈墓》"},"example":{"text":"姚观察等也大家～，多说叫天儿是曲中神品，别人唱起来那里有他这样雍容大雅、裂石穿云？（清·张春帆《九尾龟》第一百五十三回）"}},{"id":12051,"word":"啧啧称赞","pinyin":"zé zé chēng zàn","abbr":"zzcz","explanation":"啧啧：咂嘴赞叹的声音。口里啧啧作声，表示赞美。","source":{"text":"一部卒妻郭氏有令姿，见之无不啧啧称赏，李心慕焉。","book":"明·陶宗仪《辍耕录·贞烈墓》"},"example":{"text":"那知道未及一个时辰，已经结案，沿路口碑，～。","book":"清·刘鹗《老残游记》第十八回"},"similar":["啧啧称羡","啧啧赞美"],"usage":"作谓语、定语；用于处事"},{"id":12052,"word":"啧啧赞美","pinyin":"zé zé zàn měi","abbr":"zzzm","explanation":"啧啧：咂嘴赞叹的声音。口里啧啧作声表示赞美","source":{"text":"一位陶冶于‘高级趣味’中的小姐本来不听他的，但到后来也啧啧赞美起来。","book":"茅盾《想到》"},"similar":["啧啧称赞","啧啧称羡"],"usage":"作谓语、定语；用于处事"},{"id":12053,"word":"啧有烦言","pinyin":"zé yǒu fán yán","abbr":"zyfy","explanation":"啧：争辩；烦言：气愤不满的话。形容议论纷纷，报怨责备。","source":{"text":"会同难，啧有烦言，莫之治也。","book":"《左传·定公四年》"},"example":{"text":"我辈与之遗老，本不能志同道合，其～，正是应有之事。","book":"《鲁迅书信集·致许寿裳》"},"similar":["怨天尤人","怨声载道"],"opposite":["交口称誉","口碑载道"],"usage":"作谓语、宾语、分句；指争论"},{"id":12054,"word":"啬己奉公","pinyin":"sè jǐ fèng gōng","abbr":"sjfg","explanation":"啬：节俭。自己节俭，尽力办好公共的事业。","example":{"text":"他为官清廉，～，赢得众人的钦佩。"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":12055,"word":"啮檗吞针","pinyin":"niè bò tūn zhēn","abbr":"nbtz","explanation":"檗：俗称黄柏，味苦。啮檗：食用黄檗，比喻食物之味如黄檗之苦。吞针：将针吞下，比喻食物极难入口。形容食物难以下咽。","source":{"text":"及至冰餐，俱置一匙于口，各相眄良久，咸若啮檗吞针 。","book":"唐·康骈《李使君》"}},{"id":12056,"word":"啮臂为盟","pinyin":"niè bì wèi méng","abbr":"nbwm","explanation":"啮：咬。咬臂发誓定盟，以示坚决。","source":{"text":"吴小员外焚香设誓，啮臂为盟。","book":"明·冯梦龙《警世通言》第30卷"},"similar":["啮血为盟"],"usage":"作谓语、定语；指结盟"},{"id":12057,"word":"啮臂之好","pinyin":"niè bì zhī hǎo","abbr":"nbzh","explanation":"旧时指男女密约婚嫁之事。","source":{"text":"修月生与文香甚昵，素有啮臂之好。","book":"清·二石生《十洲春语》卷下"},"usage":"作宾语；多用于男女之间"},{"id":12058,"word":"啮血为盟","pinyin":"niè xuè wéi méng","abbr":"nxwm","explanation":"指咬臂出血，发誓定盟，以示坚决。","source":{"text":"杨度初时，倡言排满，与黄兴、刘揆一啮血为盟，图为刺客，将赫然革命之健者。","book":"揆郑《哀政闻社员》"},"similar":["啮臂为盟"],"usage":"作谓语、定语；指结盟"},{"id":12059,"word":"啮血沁骨","pinyin":"niè xuè qìn gǔ","abbr":"nxqg","explanation":"形容极端诚信。","source":{"text":"先是生母冯阻绝东村，病死……啮血沁骨，棺敛以葬。","book":"清·顾嗣立《元诗选·丁孝子鹤年》"},"usage":"作谓语、定语；用于为人"},{"id":12060,"word":"啮雪吞毡","pinyin":"niè xuě tūn zhān","abbr":"nxtz","explanation":"指为坚持气节而过艰苦的生活。","source":{"text":"汉武帝天汉元年，苏武以中郎将出使匈奴，单于留不遣，欲降武，乃幽武于大窖中，绝其饮食。天雨雪，武卧啮雪，与毡毛并咽之，终不屈。事见《汉书·苏武传》。"},"example":{"text":"[李清]想道古人～，尚且救了性命；这里无雪无毡，只有烂泥在手中，便去抓一把来咽下。","book":"《醒世恒言·李道人独步去门》"},"similar":["啮雪餐毡"],"usage":"作谓语、定语；用于书面语","story":["西汉时期，汉武帝派大臣苏武等为使者出使西域同匈奴单于修好，因汉朝降将鍭侯王的反叛，单于大怒，扣押了苏武等人，把他幽禁在大窖里，苏武靠啮雪餐毡活命，坚决不投降，被迫沦为匈奴的奴隶在茫茫草原上放羊，19年后才回到汉朝"]},{"id":12061,"word":"啮雪餐毡","pinyin":"niè xuě cān zhān","abbr":"nxcz","explanation":"比喻困境中的艰难生活。","source":{"text":"信熊掌和魚怎得兼，便有龙肝凤髓，也只合啮雪餐毡。","book":"《群音类选·祝发记·分食寄姑》"},"example":{"text":"明·胡文焕《群音类选·》：“信熊掌和鱼怎得兼，便有龙肝凤髓，也只合～。”"},"similar":["啮雪吞毡"],"usage":"作谓语、定语；用于书面语","story":["西汉时期，汉武帝派大臣苏武等为使者出使西域同匈奴单于修好，因汉朝降将鍭侯王的反叛，单于大怒，扣押了苏武等人，把他幽禁在大窖里，苏武靠啮雪餐毡活命，坚决不投降，被迫沦为匈奴的奴隶在茫茫草原上放羊，19年后才回到汉朝"]},{"id":12062,"word":"啸侣命俦","pinyin":"xiāo lǚ mìng chóu","abbr":"xlmc","explanation":"指召唤同伴。","source":{"text":"鸳鸯于飞，啸侣命俦，朝游高原，夕宿中洲。","book":"三国魏嵇康《赠史秀才入军》诗"},"similar":["呼朋引类","命俦啸侣"],"usage":"作谓语、定语；指呼朋引类"},{"id":12063,"word":"啸傲林泉","pinyin":"xiào ào lín quán","abbr":"xalq","explanation":"林泉：山林泉石，指退隐之地。形容自由自在，放旷不受拘束的隐居生活。","source":{"text":"所居之宅，枕带林泉。","book":"晋·陶潜《饮酒》：“啸傲东轩下，聊复得此生。”《北史·韦夐传》"},"example":{"text":"他～与世隔绝，他抱虎枕蛟与人无争。","book":"李存葆《我为捕虎者说》三"},"similar":["啸傲湖山","啸傲风月"],"usage":"作宾语、定语；用于隐士生活等"},{"id":12064,"word":"啸傲湖山","pinyin":"xiào ào hú shān","abbr":"xahs","explanation":"啸傲：随意长啸吟咏游乐。在江湖山野中自由自在地吟咏游赏。","source":{"text":"折揽胜登临，亦传啸傲湖山之作。","book":"姚华《曲海一勺》"},"similar":["啸傲林泉"],"usage":"作宾语、定语；用于生活等"},{"id":12065,"word":"啸傲风月","pinyin":"xiào ào fēng yuè","abbr":"xafy","explanation":"啸傲：随意长啸吟咏游乐。在江湖山野中自由自在地吟咏游赏。","source":{"text":"他们都是些逃避现实的无病呻吟的梦想家，或者是啸傲风月的隐士。","book":"茅盾《夜读偶记》五"},"similar":["笑傲风月"],"usage":"作谓语、定语；用于书面语"},{"id":12066,"word":"啸吒风云","pinyin":"xiào zhà fēng yún","abbr":"xzfy","explanation":"形容威力极大。同“叱咤风云”。"},{"id":12067,"word":"啸咤风云","pinyin":"xiào zhà fēng yún","abbr":"xzfy","explanation":"形容威力极大。同“叱咤风云”。"},{"id":12068,"word":"啸聚山林","pinyin":"xiào jù shān lín","abbr":"xjsl","explanation":"啸聚：互相呼召着聚合起来。指反抗反动统治而聚众起事。","source":{"text":"我这伙好汉，非比啸聚山林之辈。","book":"明·施耐庵《水浒传》第八十五回"},"example":{"text":"那李乐亦是～之贼，今不得已而召之。","book":"明·罗贯中《三国演义》第十三回"},"usage":"作谓语、宾语；用于书面语"},{"id":12069,"word":"啼啼哭哭","pinyin":"tí tí kū kū","abbr":"ttkk","explanation":"哭泣不止。","source":{"text":"只见许多男女，啼啼哭哭，在街上过。","book":"清·吴敬梓《儒林外史》第一回"},"example":{"text":"清·无名氏《说呼全传》第20回：“俺女儿金莲时常想起了他，就要～。”"},"similar":["哭哭啼啼"],"usage":"作谓语、状语；指哭泣"},{"id":12070,"word":"啼天哭地","pinyin":"tí tiān kū dì","abbr":"ttkd","explanation":"呼天叫地的哭号，形容非常悲痛。","source":{"text":"奉使来时，惊天动地，奉使去时，乌天黑地，官吏都欢天喜地，百姓却啼天哭地。","book":"元·陶宗仪《南村辍耕录·阑路驾上书》"},"example":{"text":"明·陶宗仪《辍耕录·阑驾上书》：“奉使来时，惊天动地；奉使去时，乌天黑地；官吏都欢天喜地，百姓却～。”"},"similar":["呼天喊地"],"usage":"作谓语、定语、状语；用于书面语"},{"id":12071,"word":"啼笑皆非","pinyin":"tí xiào jiē fēi","abbr":"txjf","explanation":"啼：哭；皆非：都不是。哭也不是，笑也不是，不知如何才好。形容处境尴尬或既令人难受又令人发笑的行为。","source":{"text":"刘久发啼笑皆非地站起来了。","book":"沙汀《烦恼》"},"similar":["哭笑不得","狼狈不堪"],"opposite":["镇定自若"],"usage":"主谓式；作谓语、宾语、状语、补语；含贬义"},{"id":12072,"word":"啼饥号寒","pinyin":"tí jī háo hán","abbr":"tjhh","explanation":"啼：哭；号：叫。因为饥饿寒冷而哭叫。形容挨饿受冻的悲惨生活。","source":{"text":"冬暖而儿号寒，年丰而妻啼饥。","book":"唐·韩愈《进学解》"},"example":{"text":"值岁凶，～。","book":"清·王晫《今世说·贤媛》"},"similar":["饥寒交迫","哀鸿遍野"],"opposite":["丰衣足食","家给人足"],"usage":"作谓语、宾语；指人民饥寒交迫"},{"id":12073,"word":"啾啾唧唧","pinyin":"jiū jiū jī jī","abbr":"jjjj","explanation":"象声词。小细声。形容虫、鸟等细碎的叫声或吵闹。","source":{"text":"正要朦胧睡去，听得竹枝上不知有多少家雀儿的声儿，啾啾唧唧，叫个不住。","book":"清·曹雪芹《红楼梦》第82回"},"usage":"作定语、状语；用于拟声"},{"id":12074,"word":"喃喃低语","pinyin":"nán nán dī yǔ","abbr":"nndy","explanation":"轻到几乎听不见的说话声。","example":{"text":"我听见他们的～。"},"similar":["喃喃细语"],"usage":"作谓语、宾语；指小声说话"},{"id":12075,"word":"喃喃细语","pinyin":"nán nán xì yǔ","abbr":"nnxy","explanation":"形容小声说话。","source":{"text":"乃向西北奋头，喃喃细语。","book":"《北史·隋·房陵王勇传》"},"example":{"text":"竹影斜侵月照棂，～人倾听。","book":"清·李绿园《歧路灯》第35回"},"similar":["呢喃细语"],"usage":"作谓语、宾语；形容小声说话"},{"id":12076,"word":"喃喃自语","pinyin":"nán nán zì yǔ","abbr":"nnzy","explanation":"喃喃：连续不断地小声说话。小声地自己跟自己说话。","source":{"text":"他的头一直抵在办公桌冰凉的玻璃板上，昏乱中竟然荒唐地喃喃自语说：‘我的上级哪！’","book":"路遥《平凡的世界》第五卷第26章"},"example":{"text":"他一个人在那喃喃自语。"},"similar":["自言自语","喃喃细语"],"usage":"作谓语、状语；形容自言自语"},{"id":12077,"word":"善与人交","pinyin":"shàn yǔ rén jiāo","abbr":"syrj","explanation":"善于与别人交朋友。","source":{"text":"子曰：‘晏平仲善与人交，久而敬之。’","book":"《论语·公冶长》"},"example":{"text":"性谦和，～，宾无贵贱，待之若一，而颇敬媚权贵。","book":"《晋书·邓攸传》"},"opposite":["不善交际"],"usage":"作谓语；指善于与别人交朋友"},{"id":12078,"word":"善与人同","pinyin":"shàn yǔ rén tóng","abbr":"syrt","explanation":"自己有优点，愿意别人同自己一样，别人有长处，就向别人学习。","source":{"text":"善与人同，舍己从人，乐取于人以为善。","book":"《孟子·公孙丑上》"}},{"id":12079,"word":"善为我辞","pinyin":"shàn wéi wǒ cí","abbr":"swwc","explanation":"好好地替我辞谢掉。后多用于请人代为说辞。","source":{"text":"李氏使闵子骞为费宰。闵子骞曰：‘善为我辞焉。’","book":"《论语·雍也》"},"example":{"text":"实久谢人事，饰巾待终罢了，幸君～！","book":"蔡东藩《后汉演义》第六十三回"}},{"id":12080,"word":"善为说辞","pinyin":"shàn wéi shuō cí","abbr":"swsc","explanation":"说辞：讲话。形容很会讲话。后指替人说好话。","source":{"text":"宰我、子贡善为说辞。","book":"《孟子·公孙丑上》"},"example":{"text":"见了五科哥，好歹替我～。","book":"清·李宝嘉《官场现形记》第十一回"},"similar":["为人说项"],"usage":"作谓语；指替人说好话"},{"id":12081,"word":"善书不择纸笔","pinyin":"shàn shū bù zhé zhǐ bǐ","abbr":"ssbzzb","explanation":"工于书法的人，不会过于选择纸和笔。比喻功力深厚，易见实效。","source":{"text":"善书不择纸笔，妙在心手，不在物也。","book":"唐·张怀瓘《书断列传》卷三：“曰：‘何如欧阳询？’曰：‘闻询不择纸笔，皆能如志，官岂得若此。’”宋·陈师道《后山谈丛》"}},{"id":12082,"word":"善人义士","pinyin":"shàn rén yì shì","abbr":"srys","explanation":"善良之人，仁义之士。","source":{"text":"原来天理昭然，佑护善人义士，因这场大雪，救了林冲的性命。","book":"明·施耐庵《水浒传》第十回"}},{"id":12083,"word":"善人能受尽言","pinyin":"shàn rén néng shòu jìn yán","abbr":"srnsjy","explanation":"品行好的人能接受别人的意见。","source":{"text":"立于淫乱之国，而好尽言，以招人过，怨之本也，惟善人能受尽言。","book":"《国语·周语下》"},"example":{"text":"而重故国无穷之祸，为乱臣贼子所笑，予实有厚望焉。记有之：“～。”","book":"蔡东藩《清史演义》第十三回"}},{"id":12084,"word":"善以为宝","pinyin":"shàn yǐ wéi bǎo","abbr":"sywb","explanation":"善：善良。把美德当作珍宝。","source":{"text":"楚国无以为宝，惟善以为宝。","book":"《礼记·大学》"}},{"id":12085,"word":"善体下情","pinyin":"shàn tǐ xià qíng","abbr":"stxq","explanation":"体：体贴；下：下属。善于体察下属的冷暖。形容关心下级。","source":{"text":"一时清议，谓坐视非理者，亦百不一二，谓善体下情者，亦十恒八九也。","book":"清·纪昀《阅微草堂笔记·姑妄听之三》"}},{"id":12086,"word":"善刀而藏","pinyin":"shàn dāo ér cáng","abbr":"sdec","explanation":"善：拭；善刀：把刀擦干净。将刀擦净，收藏起来。比喻适可而止，自敛其才。","source":{"text":"提刀而立，为之四顾，为之踌躇满志，善刀而藏之。","book":"《庄子·养生主》"},"example":{"text":"交流空涌波，言诸名士之交接，各处炫奇而争胜也。然则此时少陵之真意，早已～。","book":"清·无名氏《杜诗言志》卷一"},"similar":["适可而止"],"opposite":["锋芒毕露"],"usage":"作谓语、宾语；用于劝诫人"},{"id":12087,"word":"善响者不于响于声","pinyin":"shàn xiǎng zhě bù yú xiǎng yú shēng","abbr":"sxzbyxys","explanation":"回响好听是因为声音好听。比喻做事要着力于根本。","source":{"text":"治其身而天下治，故善响者不于响于声，善影者不于影于形。为天下者，不于天下于身。","book":"《吕氏春秋·先己》"}},{"id":12088,"word":"善善从长","pinyin":"shàn shàn cóng cháng","abbr":"sscc","explanation":"善善：褒扬美德；从长：源远流长的意思。原指褒扬美德，源远流长。后用来比喻吸取别人的长处。","source":{"text":"君子之善善也长，恶恶也短；恶恶止其身，善善及子孙。","book":"《公羊传·昭公二十年》"},"example":{"text":"我们只好～，不要说出那般诛心的话，叫人听着寒心。","book":"清·李宝嘉《文明小史》第31回"},"usage":"作谓语、宾语；指褒扬美德"},{"id":12089,"word":"善善恶恶","pinyin":"shàn shàn wù è","abbr":"sswe","explanation":"称赞善事，憎恶坏事。形容人区别善恶，爱憎分明。","source":{"text":"善善恶恶，贤贤贱不肖。","book":"《史记·太史公自序》"},"example":{"text":"久闻刘景升～，特往谒之。","book":"明·罗贯中《三国演义》第三十五回"},"similar":["奖善嫉恶"],"opposite":["善恶不分"],"usage":"作定语；指爱憎分明"},{"id":12090,"word":"善始令终","pinyin":"shàn shǐ lìng zhōng","abbr":"sslz","explanation":"做事情有好的开头，也有好的结尾。形容办事认真。同“善始善终”。","source":{"text":"既丰赡以多姿，又善始而令终。","book":"三国·魏·嵇康《琴赋》"},"example":{"text":"殊勋懿行，溢美于青编；～，腾劳于明代。","book":"宋·王禹偁《右卫将军赠侍中宋公神道碑》"},"similar":["善始善终"],"usage":"作谓语、定语；指做事情有头有尾"},{"id":12091,"word":"善始善终","pinyin":"shàn shǐ shàn zhōng","abbr":"sssz","explanation":"做事情有好的开头，也有好的结尾。形容办事认真。","source":{"text":"以荣名终，称贤相，岂不善始善终哉？","book":"《庄子·大宗师》：“善妖善老，善始善终。”《史记·陈丞相世家赞》"},"example":{"text":"不如早达时务，～，全了恩人生前一段美意。","book":"明·冯梦龙《警世通言》卷二十五"},"similar":["有始有终","有头有尾","善始令终"],"opposite":["有始无终","虎头蛇尾"],"usage":"作谓语、定语；指做事情有头有尾","story":["秦朝末年，家境贫寒的陈平爱好道表法里的黄老之术，他担任过魏王咎的太仆，项羽的都尉，刘邦的军中尉。他献计使项羽疏远谋士范增，汉朝建立后，他被封为曲逆侯，历任惠帝、吕后、文帝三朝丞相，他能应付各种情况并能善始善终"]},{"id":12092,"word":"善恶之报，若影随形","pinyin":"shàn è zhī bào，ruò yǐng suí xíng","abbr":"sezbrysx","explanation":"比喻好的或坏的报应，不但来得快，而且不会有差误。","source":{"text":"善恶之报，若影随形。此是儒书之言，岂徒佛经所说。","book":"《旧唐书·儒学列传·张士衡传》"}},{"id":12093,"word":"善恶昭彰","pinyin":"shàn è zhāo zhāng","abbr":"sezz","explanation":"昭彰：明显。好坏或是非分明。","source":{"text":"善恶昭彰，如影随形。","book":"明·《旧唐书·儒学列传·张士衡传》：“善恶之报，若影随形。此是儒书之言，岂徒佛经所说。”吴承恩《西游记》第十回：“正是人生却莫把心欺，神鬼昭彰放过谁？善恶到头终有报，只争来早与来迟。”清·李汝珍《镜花缘》第七十一回"},"example":{"text":"然天夺之魄而益其疾，使其自呼服罪，痛极致亡，乃知～，无施不报。","book":"蔡东藩《前汉演义》第六十四回"}},{"id":12094,"word":"善文能武","pinyin":"shàn wén néng wǔ","abbr":"swnw","explanation":"既有文才，又通武艺。现常指既能动笔又有实际工作能力。","source":{"text":"则为那善文能武人千里。","book":"元·王实甫《西厢记》第二本楔子"},"similar":["能文能武","文武双全"],"usage":"作谓语、定语；用于书面语"},{"id":12095,"word":"善有善报","pinyin":"shàn yǒu shàn bào","abbr":"sysb","explanation":"善：好的。报：报应。做好事必有好的报答。常与“恶有恶报”连用。","source":{"text":"便好道：‘善有善报，恶有恶报，天若不降严霜，松柏不如蒿草。’","book":"南朝·梁·萧衍《新酒肉文》：“行十恶者，受于恶报；行十善者，受于善报。”元·无名氏《朱砂担》第二折"},"example":{"text":"积～，积恶有恶报。","book":"明·凌濛初《初刻拍案惊奇》卷二十一"},"opposite":["恶有恶报"],"usage":"作宾语、分句；用于劝诫人"},{"id":12096,"word":"善有善报，恶有恶报","pinyin":"shàn yǒu shàn bào，è yǒu è bào","abbr":"sysbeyeb","explanation":"谓行善和作恶到头来都有报应。","source":{"text":"又问目连：‘何者是行报耶？’目连白佛言：‘随其缘对，善有善报，恶有恶报。’","book":"《缨络经·有行无行品》"},"example":{"text":"～，天网恢恢，疏而不漏。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"usage":"作宾语、定语；用于劝诫人"},{"id":12097,"word":"善死者不亡","pinyin":"shàn sǐ zhě bù wáng","abbr":"sszbw","explanation":"形容为了国家或救人危急而牺牲的人虽然死了，但精神不灭，还跟活着一样。","source":{"text":"善战者不死，善死者不亡。","book":"《谷梁传·庄公八年》"}},{"id":12098,"word":"善死者不阵","pinyin":"shàn sǐ zhě bù zhèn","abbr":"sszbz","explanation":"形容善于指挥作战的人，不需要摆阵势就可以战胜敌人。","source":{"text":"善为国者不师，善师者不陈（同阵）。","book":"《谷梁传·庄公八年》"}},{"id":12099,"word":"善气迎人","pinyin":"shàn qì yíng rén","abbr":"sqyr","explanation":"善气：和蔼可亲的态度。形容用和蔼可亲的态度对待人。","source":{"text":"善气迎人，亲如兄弟；恶气迎人，害于戈兵。","book":"《管子·心术下》"},"example":{"text":"每见先生飘然而来，则～。","book":"清·袁枚《寄张有虔先生》"},"usage":"作宾语、定语；指对人的态度"},{"id":12100,"word":"善治善能","pinyin":"shàn zhì shàn néng","abbr":"szsn","explanation":"治：管理；能：能力。形容处理政事善于疏理，遇事善于变通。","source":{"text":"政，善治，事，善能。","book":"《老子》第八章"}},{"id":12101,"word":"善游者溺","pinyin":"shàn yóu zhě nì","abbr":"syzn","explanation":"会游泳的人，往往淹死。比喻人自以为有某种本领，因此而惹祸。","source":{"text":"夫善游者溺，善骑者堕，各以其所好，反自为祸。","book":"《淮南子·原道训》"},"similar":["善骑者堕"],"usage":"作宾语、定语；用于劝诫人"},{"id":12102,"word":"善甲厉兵","pinyin":"shàn jiǎ lì bīng","abbr":"sjlb","explanation":"缮甲：修治铠甲。指做军事准备。","source":{"text":"弊邑恐惧慑伏，缮甲厉兵，饰车骑，习驰射，力田积粟，守四封之内，愁居慑处，不敢动摇，唯大王有意督过之也。","book":"《诗经·郑风·叔于田序》：“叔处于京，缮甲治兵。”《战国策·赵策二》"},"example":{"text":"特正分部众为二垒，自居东营，令弟流居西营，～，设伏以待。","book":"蔡东藩《两晋演义》第十四回"}},{"id":12103,"word":"善男信女","pinyin":"shàn nán xìn nǚ","abbr":"snxn","explanation":"佛教用语。原指皈依佛法的男女。后泛指信仰佛教的男男女女。","source":{"text":"善男子，善女子，发阿耨多罗三藐三菩提心。","book":"《金刚经·善现启请分》"},"example":{"text":"但～们不远千里朝拜金顶的仍然在老河口、石花街和草店的大道上络绎不绝。","book":"姚雪垠《李自成》第一卷第十六章"},"similar":["善男善女"],"usage":"作主语、宾语；指两人以上"},{"id":12104,"word":"善男善女","pinyin":"shàn nán shàn nǚ","abbr":"snsn","explanation":"佛教用语。原指皈依佛法的男女。后泛指信仰佛教的男男女女。","source":{"text":"善男子，善女子，发阿耨多罗三藐三菩提心。","book":"《金刚经·善现启请分》"},"example":{"text":"她会到晓荷常常去的通善社或崇善社去和那些有钱的，有闲的，想用最小的投资而获得永生的～们鬼混半天。","book":"老舍《四世同堂》四三"}},{"id":12105,"word":"善眉善眼","pinyin":"shàn méi shàn yǎn","abbr":"smsy","explanation":"形容容貌善良。","source":{"text":"门房里坐着一个老人，善眉善眼象世传当仆人的样子。","book":"清·西周生《醒世姻缘传》第九回：“虽是吊死……倒比活的时节去了那许多的杀气，反是善眉善眼的。”老舍《老张的哲学》十一"},"example":{"text":"他的弟弟都精精壮壮，唯他瘦弱，～的一副忠厚可怜相。","book":"杨绛《写〈围城〉的钱钟书》"},"similar":["慈眉善眼"],"opposite":["凶神恶煞"],"usage":"作谓语、定语、状语；指人面善"},{"id":12106,"word":"善罢干休","pinyin":"shàn bà gān xiū","abbr":"sbgx","explanation":"善：好好地；甘休：情愿罢休。好好地解决纠纷，不再闹下去（多用于否定）。","source":{"text":"他看见奶奶比他标致，可比他得人心儿，他就肯善罢干休了？","book":"清·曹雪芹《红楼梦》第六十五回"},"example":{"text":"你五尺五的汉子，就这样忍气吞声～吗？不！","book":"李英儒《野火春风斗古城》第七章"},"similar":["善罢甘休"],"usage":"作谓语、宾语；多用于否定句"},{"id":12107,"word":"善罢甘休","pinyin":"shàn bà gān xiū","abbr":"sbgx","explanation":"轻易地了结纠纷，心甘情愿地停止再闹。","source":{"text":"奶奶就是让着他，他见奶奶比他标致，又比他得人心儿，他就善罢甘休了？","book":"清·曹雪芹《红楼梦》"},"example":{"text":"不去呢，她必不会～；去呢，她也不会绕了他。","book":"老舍《骆驼祥子》"},"similar":["息事宁人","隐约其辞"],"opposite":["寻事生非","无理取闹"],"usage":"作谓语、宾语；多用于否定句"},{"id":12108,"word":"善自为谋","pinyin":"shàn zì wéi móu","abbr":"szwm","explanation":"善于替自己打算。也指替自己好好地想办法。","source":{"text":"君子曰：‘善自为谋。’","book":"春秋·鲁·左丘明《左传·桓公六年》"},"example":{"text":"丈夫岂以妻子之故，怠君父之急乎？公辈～，吾行决矣。","book":"《旧唐书·孔纬传》"},"usage":"作谓语；指善于为自己谋划"},{"id":12109,"word":"善自处置","pinyin":"shàn zì chǔ zhì","abbr":"szcz","explanation":"处置：自理。自己妥善地处理安排。","source":{"text":"从荣负咱恩，尔曹善自处置，休惊动我百姓。","book":"《新编五代史平话·唐史》卷下"}},{"id":12110,"word":"善自珍重","pinyin":"shàn zì zhēn zhòng","abbr":"szzz","explanation":"善；好好地；珍重：保重。好好地保重自己。","example":{"text":"先帝所遗四位辅政大臣，眼下只有你一人得用，且安心养病，～。","book":"二月河《康熙大帝》四十四"}},{"id":12111,"word":"善行无辙迹","pinyin":"shàn xíng wú zhé jì","abbr":"sxwzj","explanation":"善于行走的人，不留下足迹或车辙。形容具有高尚行为的人，不愿意人们对他有所觉察。","source":{"text":"善行无辙迹，善言无瑕谪；善数不用筹策；善闭无关楗而不可开，善结无绳约而不可解。","book":"《老子》第二十七章"},"example":{"text":"～，吾亦安能穷。","book":"唐·储光羲《刘先生闲居》"}},{"id":12112,"word":"善观风色，善择时机","pinyin":"shàn guān fēng sè，shàn zé shí jī","abbr":"sgfsszsj","explanation":"风色：指不断发生变化的客观情况。善于观察和掌握不断变化着的各种情况，善于选择有利时机。","example":{"text":"这种善观风色和善择时机的聪明是不容易的，惟有虚心研究，勤于考察和思索的人们可以获得。","book":"毛泽东《抗日游击战争的战略问题》"}},{"id":12113,"word":"善解人意","pinyin":"shàn jiě rén yì","abbr":"sjry","explanation":"善：善于；解：理解。善于理解别人的意图。","source":{"text":"他总不离杨妃左右，最能言语，善解人意，聪慧异常，杨妃爱之如宝，呼为雪衣女。","book":"清·褚人获《隋唐演义》第87回"},"example":{"text":"章诒和《往事并不如烟·最后的贵族》：“她与康老一样的～，却很少将自己的事随便告人。”"},"similar":["通情达理"],"usage":"作谓语、宾语、定语；用于为人处世"},{"id":12114,"word":"善言不入耳","pinyin":"shàn yán bù rù ěr","abbr":"sybre","explanation":"善言：好话。好话听不进耳朵里。","source":{"text":"非其耳之有塞，善言不入耳乎？","book":"汉·桓谭《新论·贵言》"}},{"id":12115,"word":"善言暖于布帛","pinyin":"shàn yán nuǎn yú bù bó","abbr":"synybb","explanation":"好话比衣服还温暖。形容有益的语言能给人很大的鼓舞和安慰。","source":{"text":"与人善言，暖于布帛；伤人以言，深于矛戟。","book":"《荀子·荣辱》"}},{"id":12116,"word":"善诱循循","pinyin":"shàn yòu xún xún","abbr":"syxx","explanation":"善：善于；诱：引导；循循：有次序的样子。指善于引导别人进行学习。","source":{"text":"仰之弥高，钻之弥坚，瞻之在前，忽焉在后，夫子循循然善诱人。","book":"《论语·子罕》"},"example":{"text":"观夫子这与颜渊言至于终日而渊叹之，以为～，博文约礼，则圣人之所以教人有始有卒。","book":"宋·朱熹《读苏氏纪年》"}},{"id":12117,"word":"善诱恂恂","pinyin":"shàn yòu xún xún","abbr":"syxx","explanation":"善：善于；诱：引导；恂恂：有次序的样子。指善于引导别人进行学习。","source":{"text":"岂悟君子，自生怠倦，失恂恂善诱之德，同亡国骄惰之志！盖见机而作，不俟终日，是以夙退自引，畏使君劳。","book":"汉·赵壹《报皇甫规书》"}},{"id":12118,"word":"善财难舍","pinyin":"shàn cái nán shě","abbr":"scns","explanation":"善财：原为释迦牟弟子名，后取“善”之“爱惜”意，指“爱惜钱财”。舍：施舍。指人爱惜钱财，不愿施舍于人。常用来讥讽人非常吝啬。","source":{"text":"菩萨骂道：‘你这猴子！你便一毛也不拔，教我这善财也难舍。’","book":"明·吴承恩《西游记》第四十二回"},"example":{"text":"看起来总是～哟！","book":"魏巍《火凤凰》一○"},"usage":"作谓语、定语；用于为人"},{"id":12119,"word":"善败由己","pinyin":"shàn bài yóu jǐ","abbr":"sbyj","explanation":"事情的成功或失败，是由当事人的主观努力所决定的。","source":{"text":"善败由己，而由人乎哉？","book":"《左传·僖公二十年》"}},{"id":12120,"word":"善贾而沽","pinyin":"shàn jià ér gū","abbr":"sgeg","explanation":"贾：通“价”。善贾：好价钱；沽：出卖。等好价钱卖出。比喻怀才不遇，等有的赏识的人再出来做事。也比喻有了肥缺，才肯任职。","source":{"text":"有美玉于斯，韫椟而藏诸，求善贾（价）而沽诸？","book":"《论语·子罕》"},"similar":["待价而贾"],"usage":"作谓语、宾语；指怀才不遇的人","story":["春秋时期，孔子自认为当权者会推行他的仁政，在鲁国任职期间，鲁君受到季氏的控制，他只有感叹：“苟有用我者，期月而已可也，三年有成。”鲁君没有重用他，他说：“邦有道，则仕；邦无道，则行。”于是抱着“善贾而沽”的念头去周游列国"]},{"id":12121,"word":"善门难开","pinyin":"shàn mén nán kāi","abbr":"smnk","explanation":"善门：为善之门。旧指一旦行善助人，许多人都会来求援，凡无法应付了。","source":{"text":"大善士见机，晓得善门难开。","book":"清·李宝嘉《官场现形记》第34回"},"example":{"text":"真是～，我们难以应付这么多需要救济的人。"},"similar":["好人难做"],"usage":"作宾语、定语；指好人难做"},{"id":12122,"word":"善闭无关楗","pinyin":"shàn bì wú guān jiàn","abbr":"sbwgj","explanation":"楗：门闩，插门的木棍。善于关闭，不用闩、锁。表示对待外来侵略不能单方纯采取消极的防御措施。","source":{"text":"善闭无关楗而不可开，善结无绳约而不可解。","book":"《老子》第二十七章"}},{"id":12123,"word":"善问者如攻坚木","pinyin":"shàn wèn zhě rú gōng jiān mù","abbr":"swzrgjm","explanation":"形容在学问上善于问难的人，应当是先易后难，循序渐进，像木工砍硬木先从易进斧的地方下手一样。","source":{"text":"善问者如攻坚木，庑其易者，后其节目。","book":"《礼记·学记》"}},{"id":12124,"word":"善阵者不战","pinyin":"shàn zhèn zhě bù zhàn","abbr":"szzbz","explanation":"形容善于指挥布阵作战的人不必同别人战斗。即不战而胜。","source":{"text":"故曰：善阵者不战，此之谓也。","book":"《谷梁传·庄公八年》"},"example":{"text":"善胜者不争，～；善战者不败，善败者不乱。","book":"明·吴承恩《西游记》第十回"}},{"id":12125,"word":"善颂善祷","pinyin":"shàn sòng shàn dǎo","abbr":"sssd","explanation":"关于颂扬，关于祝祷。用来称赞能在颂扬之中带有规劝的意思。","source":{"text":"北面再拜稽首。君子谓之善颂善祷。","book":"西汉·戴圣《礼记·檀弓下》"},"example":{"text":"～，三加弥尊。","book":"《宋史·乐志十四》"},"usage":"作谓语；指善于颂扬和祈求","story":["晋文子赵武家里新落成一所房屋，晋国大夫张老去祝贺说：“美哉轮焉，美哉奂焉！歌于斯，哭于斯，聚国族于斯！”旁人十分惊讶。晋文子接上：“武也得歌于斯，哭于斯，聚国族于斯，是全腰领以从先大夫于九原也！”人称晋文子善颂善祷"]},{"id":12126,"word":"善马熟人","pinyin":"shàn mǎ shú rén","abbr":"smsr","explanation":"指良马与武艺精熟的勇士。","source":{"text":"左右牵马来，轻弓短箭，善马熟人，百骑往北邙走一遭去。","book":"元·高文秀《渑池会》第二折：“则今日点就百十骑人马，都轻弓短箭，善马熟人，便索赴渑池会。”元·郑光祖《老君堂》第一折"},"example":{"text":"一日，武侯引三千军，轻弓短箭，～，军师素车一辆，令人骂司马懿。","book":"《三国志平话》卷下"}},{"id":12127,"word":"善骑者堕","pinyin":"shàn qí zhě duò","abbr":"sqzd","explanation":"惯于骑马的人常常会从马上摔下来。比喻善长某一技艺的人，往往因大意而招致失败。","source":{"text":"夫善游者溺，善骑者堕，各以其所好，反自为祸。","book":"《淮南子·原道训》"},"similar":["善游者溺"],"usage":"作宾语、定语；用于劝诫人"},{"id":12128,"word":"喉清韵雅","pinyin":"hóu qīng yùn yǎ","abbr":"hqyy","explanation":"歌喉清脆响亮，韵味优美幽致。形容歌唱水平很高。","source":{"text":"便命取了一支紫竹箫来，命佩凤吹箫，文花唱曲，喉清韵雅，甚令人心动神移。","book":"清·曹雪芹《红楼梦》第七十五回"},"usage":"作谓语、定语；用于书面语"},{"id":12129,"word":"喉焦唇干","pinyin":"hóu jiāo chún gān","abbr":"hjcg","explanation":"喉咙和嘴唇都非常干。形容极力劝说。","source":{"text":"龙马上山，焦无水泉，喉焦唇干，渴不能言。","book":"汉·焦延寿《易林》第13卷"},"similar":["口干舌燥"],"usage":"作谓语、状语；指非常渴"},{"id":12130,"word":"喉舌之官","pinyin":"hóu shé zhī guān","abbr":"hszg","explanation":"掌管主要机关的官吏。比喻国家的重臣。旧时特指御史之类的谏官。","source":{"text":"宜擢在喉舌之官，必有匡弼之益。","book":"《诗经·大雅·烝民》：“出纳王命，王之喉舌。”《后汉书·左雄传》"}},{"id":12131,"word":"喉长气短","pinyin":"hóu cháng qì duǎn","abbr":"hcqd","explanation":"喉：喉咙。喉咙虽很长，但却喘不上来气。形容大说大叫，声嘶力竭。","source":{"text":"那过善本来病势已有八九分了，却又勉强料理这事，喉长气短，费舌劳唇，劳碌这半日，到晚上愈加沉重。","book":"明·冯梦龙《醒世恒言》卷十七"}},{"id":12132,"word":"喊冤叫屈","pinyin":"hǎn yuān jiào qū","abbr":"hyjq","explanation":"为遭受冤屈而喊叫。","source":{"text":"金桂将桌椅杯盏尽行打翻，那宝蟾只管喊冤叫屈，哪里理会他？","book":"清·曹雪芹《红楼梦》"},"example":{"text":"你～也是徒劳。"},"similar":["叫苦连天","鸣冤叫屈"],"opposite":["委曲求全"],"usage":"作谓语、宾语；形容为自己的事辨白"},{"id":12133,"word":"喋喋不休","pinyin":"dié dié bù xiū","abbr":"ddbx","explanation":"喋喋：形容说话多；体：停止。唠唠叨叨，说个没完没了。","source":{"text":"夫绛侯、东阳侯称为长者，此两人言事曾不能出口，岂效此啬夫喋喋利口捷给哉！","book":"《汉书·张释之传》"},"example":{"text":"廖二嫂还满腹闷气，～。","book":"沙汀《呼嚎》"},"similar":["滔滔不绝","口若悬河","津津乐道"],"opposite":["默不做声","守口如瓶","默默无言"],"usage":"作谓语、定语、状语；指人说话","story":["西汉时期，汉文帝派一位公主给匈奴王稽粥做王后，确保边境安宁，让宦官中行护送公主前去，中行到后就投降匈奴，为匈奴出谋划策。汉朝的使臣去讥笑匈奴人一家住一个帐篷，中行回敬他们只会衣冠楚楚喋喋不休地说过没完"]},{"id":12134,"word":"喋喋不已","pinyin":"dié dié bù yǐ","abbr":"ddby","explanation":"喋喋：形容说话的声音；已：止。唠唠叨叨，说个没完。","source":{"text":"奏牒繁多，喋喋不已。","book":"宋·司马光《辞知制诰状》"},"example":{"text":"遗骸骨冀得安寝，汝乃～耶。","book":"《元史·太祖纪》"},"similar":["喋喋不休"],"usage":"作谓语、定语、状语；指人说话"},{"id":12135,"word":"喏喏连声","pinyin":"nuò nuò lián shēng","abbr":"nnls","explanation":"喏喏：答应的声音。一声接一声地答应。形容十分恭顺的样子。","source":{"text":"闪的我孤孤另另，说的话诞诞邓邓，俺也曾轻轻唤着，躬躬前来，喏喏连声。","book":"元·关汉卿《金线池》第三折"},"example":{"text":"说得龙济光满面羞惭，没奈何～，告别而去。","book":"蔡东藩、许廑父《民国通俗演义》第六十九回"},"similar":["诺诺连声"],"usage":"作谓语、状语；表示顺从的样子"},{"id":12136,"word":"喑呜叱咤","pinyin":"yīn wū chì zhà","abbr":"ywcz","explanation":"喑呜：怀怒气；叱咤：发怒时的叫喊声。指厉声怒喝。","source":{"text":"不然，则喑呜叱咤，使风驰霆击，则侯之威灵暴矣哉！","book":"宋·欧阳修《樊侯庙灾记》"},"similar":["喑噁叱咤"],"usage":"作谓语；指发怒"},{"id":12137,"word":"喑噁叱咤","pinyin":"yīn wù chì zhà","abbr":"yecz","explanation":"喑噁：发怒声。叱咤：呵斥声。形容厉声怒喝。","source":{"text":"项王喑噁叱咤，千人皆废，然不能任属贤将，此特匹夫之勇耳。","book":"《史记·淮阴侯列传》"},"similar":["喑呜叱咤"],"usage":"作谓语；指发怒"},{"id":12138,"word":"喑恶叱咤","pinyin":"yìn wū chì zhà","abbr":"yecz","explanation":"指发怒而厉声喝叫。形容风云人物威势很大。","source":{"text":"项王喑恶叱咤，千人皆废，然不能任属贤将，此特匹夫之勇耳。","book":"《史记·淮阴侯列传》"}},{"id":12139,"word":"喔咿儒儿","pinyin":"ō yī rú ér","abbr":"oyre","explanation":"喔咿：献媚强笑的样子，形容声音含糊不清。形容老着脸皮，强作欢颜。","source":{"text":"栗斯，喔咿儒睨以事妇人乎？","book":"战国·楚·屈原《卜居》"},"similar":["喔咿儒睨"],"usage":"作状语；指强作欢颜"},{"id":12140,"word":"喔咿儒睨","pinyin":"ō yī rú nì","abbr":"oyrn","explanation":"儒睨：强笑的样子。形容老着脸皮，强作欢颜。","source":{"text":"栗斯，喔咿儒睨以事妇人乎？","book":"战国·楚·屈原《卜居》"},"similar":["喔咿儒儿"],"usage":"作状语；指强作欢颜"},{"id":12141,"word":"喔咿嚅唲","pinyin":"ōu yī rǔ ér","abbr":"oyre","explanation":"嚅唲：强笑的样子。指老着脸皮向人媚笑。","source":{"text":"宁超然高举，以保真乎？将哫訾栗斯，喔咿嚅唲以事妇人乎？宁廉洁正直以自清乎?","book":"战国·楚·屈原《卜居》"}},{"id":12142,"word":"喘息之机","pinyin":"chuǎn xī zhī jī","abbr":"cxzj","explanation":"暂停活动、舒缓一段时间。","example":{"text":"我们趁敌人～快速集结，迅速出击。"},"usage":"作宾语；指短的时间"},{"id":12143,"word":"喘息之间","pinyin":"chuǎn xī zhī jiān","abbr":"cxzj","explanation":"喘一口气的功夫。比喻时间短。","source":{"text":"若鱼遊釜中，喘息须臾之间耳！","book":"《后汉书·张纲传》"},"usage":"作宾语；指短时间"},{"id":12144,"word":"喘息未定","pinyin":"chuǎn xī wèi dìng","abbr":"cxwd","explanation":"喘息：呼吸急促。呼吸急促，还没有平稳下来。比喻时间短促，情况紧张，人还未歇过气来。","source":{"text":"立寨甫毕，喘息未定，忽闻寨后一声炮响，火光连天。","book":"明·冯梦龙《东周列国志》第七回"},"example":{"text":"方才进步，～，只见前面尘起，叫杀连天。","book":"明·施耐庵《水浒全传》第七十七回"},"similar":["喘息未安"],"usage":"作谓语、定语；比喻时间短"},{"id":12145,"word":"喘月吴牛","pinyin":"chuǎn yuè wú niú","abbr":"cywn","explanation":"比喻因受某事物之苦而畏惧其类似者。","source":{"text":"喘月吴牛知夜至，嘶风胡马识秋来。","book":"五代·谭用之《寄王侍御》诗"},"example":{"text":"吠尧桀犬浑多事，～苦问天。","book":"柳亚子《读郭沫若》诗"},"similar":["吴牛喘月"],"usage":"作主语、宾语；用于书面语","story":["晋武帝对吏部侍郎满奋特别器重，经常召见他。晋武帝故意装一扇透明的屏风让畏寒的满奋坐在附近，满奋以为空屏风不能挡风不敢上前，见到是透明屏风后自我解嘲说：“臣简直就像吴地的水牛，夜里见到月亮也怕得直喘气。”"]},{"id":12146,"word":"喙长三尺","pinyin":"huì cháng sān chǐ","abbr":"hcsc","explanation":"喙：嘴。嘴长三尺。形容人善于辨说。","source":{"text":"丘愿有喙三尺。彼之谓不道之道，此之谓不言之辩。","book":"《庄子·徐无鬼》"},"example":{"text":"与君俯首大艰阻，～不得语。","book":"唐·马异《答卢仝结交诗》"},"similar":["能言善辩"],"usage":"作谓语、定语；形容人能言善辩"},{"id":12147,"word":"喜上眉梢","pinyin":"xǐ shàng méi shāo","abbr":"xsms","explanation":"喜悦的心情从眉眼上表现出来。","source":{"text":"思索良久，得了主意，不觉喜上眉梢。","book":"清·文康《儿女英雄传》第23回"},"example":{"text":"人们一见船影，都～。","book":"郭澄清《大刀记》第14章"},"similar":["喜眉笑眼","喜笑颜开"],"opposite":["悲从心来","愁眉不展"],"usage":"作谓语；指高兴"},{"id":12148,"word":"喜不自禁","pinyin":"xǐ bù zì jīn","abbr":"xbzj","explanation":"抑制不住内心的喜悦。形容极其高兴。","source":{"text":"‘你无聊不无聊？’石静看我兴高采烈喜不自禁的样儿嗔问。","book":"王朔《永失我爱》"},"example":{"text":"我已经～了。"},"similar":["喜不自胜"],"usage":"作谓语；指十分高兴"},{"id":12149,"word":"喜不自胜","pinyin":"xǐ bù zì shèng","abbr":"xbzs","explanation":"胜：能承受。喜欢得控制不了自己。形容非常高兴。","source":{"text":"小生去时，承夫人亲自饯行，喜不自胜。","book":"元·王实甫《西厢记》第五本第四折"},"example":{"text":"国太只道孙权好意，～。","book":"明·罗贯中《三国演义》第五十五回"},"similar":["喜出望外","大喜过望"],"opposite":["痛哭流涕","悲不欲生"],"usage":"作谓语、定语、状语；形容非常高兴"},{"id":12150,"word":"喜从天降","pinyin":"xǐ cóng tiān jiàng","abbr":"xctj","explanation":"喜事从天上掉下来。比喻突然遇到意想不到的喜事。","source":{"text":"贵脚踏践地，使下官喜从天降。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"张顺见了宋江，～。","book":"明·施耐庵《水浒全传》第四十回"},"similar":["喜出望外","大喜过望"],"opposite":["大祸临头","天灾人祸"],"usage":"作谓语；指意外的喜事"},{"id":12151,"word":"喜出望外","pinyin":"xǐ chū wàng wài","abbr":"xcww","explanation":"望：希望，意料。由于没有想到的好事而非常高兴。","source":{"text":"契阔八年，岂谓复有见日？渐近中原，辱书尤数，喜出望外。","book":"宋·苏轼《与李之仪书》"},"example":{"text":"这可真叫他～。","book":"沙汀《催粮》"},"similar":["大喜过望","喜从天降"],"opposite":["祸不单行"],"usage":"作谓语、定语、状语；指非常高兴"},{"id":12152,"word":"喜则气缓","pinyin":"xǐ zé qì huǎn","abbr":"xzqh","explanation":"气缓：心气舒缓或和达。喜能使人精神兴奋，心情和达，气机通利。","source":{"text":"喜则气缓，……喜则气和志达，荣卫通利，故气缓矣。","book":"《素问·举痛论》"},"usage":"作谓语、定语；指使人精神兴奋"},{"id":12153,"word":"喜功好大","pinyin":"xǐ gōng hào dà","abbr":"xghd","explanation":"功：功绩，成就；好：爱好，喜欢。喜爱干大事，建大功业。多形容浮夸的作风。","source":{"text":"喜功好大，妄逞材能。","book":"清·平步青《霞外捃屑·彭尚书奏折》"},"similar":["好大喜功"],"opposite":["脚踏实地"],"usage":"作谓语、定语、分句；指人浮夸"},{"id":12154,"word":"喜地欢天","pinyin":"xǐ dì huān tiān","abbr":"xdht","explanation":"形容非常高兴。","source":{"text":"送星官回转本宫，他才遂心满意，喜地欢天，在于天宫快乐，无挂无碍。","book":"明·吴承恩《西游记》第四回"},"example":{"text":"又因先生许说文字甚佳，可取十名之内，一路上～，恨不得一步跨到家内。","book":"清·西周生《醒世姻缘传》第三十八回"}},{"id":12155,"word":"喜容可掬","pinyin":"xǐ róng kě jū","abbr":"xrkj","explanation":"掬：双手捧取。形容笑容满面的样子。","source":{"text":"又见韩夫人精神旺相，喜容可掬。","book":"明·冯梦龙《醒世恒言》卷十三"},"example":{"text":"雄信三十两银子，得了千里龙驹，捧着马价银出来，～。","book":"清·褚人获《隋唐演义》第八回"}},{"id":12156,"word":"喜形于色","pinyin":"xǐ xíng yú sè","abbr":"xxys","explanation":"形：表现；色：脸色。内心的喜悦表现在脸上。形容抑制不住内心的喜悦。","source":{"text":"太宗闻其言，喜形于色，谓群臣曰：‘……及见魏征所论，始觉大非道理。’","book":"唐·吴兢《贞观政要·纳谏》"},"example":{"text":"章奇先生～了。","book":"蒋光慈《短裤党》二"},"similar":["眉飞色舞","喜上眉梢","喜形于颜"],"opposite":["闷闷不乐","忧心忡忡"],"usage":"作谓语、定语、状语；指控制不住内心喜悦","story":["南北朝时期，魏国大臣高允深受皇帝的宠爱，在他暮年时期，他坚信自己能活到100岁。一次得了小病，家人给他请大夫看病，他始终坚持料理政务。皇帝派人给他送去很多礼物，估计他活不多久了作为办丧事用。高允喜形于色，认为皇帝对他无微不至"]},{"id":12157,"word":"喜形于颜","pinyin":"xǐ xíng yú yán","abbr":"xxyy","explanation":"形：表现；颜：脸色。内心的喜悦表现在脸上。形容抑制不住内心的喜悦。","source":{"text":"而攸之始奉国讳，喜形于颜，普天同哀，己以为庆。","book":"《南齐书·柳世隆传》"},"similar":["喜形于色"],"opposite":["无动于衷"],"usage":"作谓语、定语、状语；指控制不住内心喜悦"},{"id":12158,"word":"喜怒不形于色","pinyin":"xǐ nù bù xìng yú sè","abbr":"xnbxys","explanation":"高兴和恼怒都不表现在脸色上。指人沉着而有涵养，感情不外露。","source":{"text":"高兴和恼怒都不表现在脸色上。指人沉着而有涵养，感情不外露。"},"example":{"text":"那人不甚好读书，性宽和，寡言语，～。","book":"明·罗贯中《三国演义》第一回"},"similar":["喜愠不形于色"],"opposite":["喜形于色"],"usage":"作谓语、定语；用于处事等"},{"id":12159,"word":"喜怒哀乐","pinyin":"xǐ nù āi lè","abbr":"xnal","explanation":"喜欢、恼怒、悲哀、快乐。泛指人的各种不同的感情。","source":{"text":"喜怒哀乐之未发谓之中，发而皆中节谓之和。","book":"《礼记·中庸》"},"example":{"text":"虽是海外之邦，不过言语不同，衣服有异，那～的人情，原是一样的。","book":"清·陈忱《水浒后传》第三十一回"},"similar":["人之常情","悲欢离合","喜怒哀惧"],"opposite":["心平气和"],"usage":"作主语、宾语、定语；表现人的心情"},{"id":12160,"word":"喜怒哀惧","pinyin":"xǐ nù āi jù","abbr":"xnaj","explanation":"喜欢、恼怒、悲哀、恐惧。泛指人的各种不同的感情。","source":{"text":"何谓人情？喜怒哀惧爱恶欲，七者，弗学而能。","book":"《礼记·礼运》"},"example":{"text":"性者，仁义礼智信也；情者，～好恶欲也。","book":"宋·张君房《云笈七签》卷九十"},"similar":["喜怒哀乐"],"usage":"作主语、宾语；表现人的心情"},{"id":12161,"word":"喜怒无处","pinyin":"xǐ nù wú chù","abbr":"xnwc","explanation":"无处：变化不定。一会儿高兴，一会儿生气。形容态度多变。","source":{"text":"喜怒无处，言谈日易。","book":"《吕氏春秋·诬徒》"},"similar":["喜怒无常"],"usage":"作谓语、宾语、定语；指情绪变化无定"},{"id":12162,"word":"喜怒无常","pinyin":"xǐ nù wú cháng","abbr":"xnwc","explanation":"一会儿高兴，一会儿生气。形容态度多变。","source":{"text":"喜怒无处，言谈日易。","book":"《吕氏春秋· 诬徒》"},"example":{"text":"宝玉和黛玉是从小儿一处长大的，他兄妹间多有不避嫌疑之处，嘲笑不忌，～。","book":"清·曹雪芹《红楼梦》第二十七回"},"similar":["喜怒哀乐","喜形于色","喜怒无处"],"opposite":["一成不变","温文尔雅"],"usage":"作谓语、宾语、定语；指情绪变化无定"},{"id":12163,"word":"喜怒无度","pinyin":"xǐ nù wú dù","abbr":"xnwd","explanation":"无度：没有限度。一会儿高兴，一会儿生气。形容态度多变。","source":{"text":"喜怒无度，严诛无赦，臣下振恐，不知所错，则人反其故。","book":"《管子·七臣七主》"}},{"id":12164,"word":"喜愠不形于色","pinyin":"xǐ yùn bù xìng yú sè","abbr":"xybxys","explanation":"愠：恼怒怨恨。高兴和恼怒都不表现在脸色上。指人沉着而有涵养，感情不外露。","source":{"text":"石侯弟嘉，少沉敏，喜愠不形于色，兼有武略。","book":"《魏书·太武五王传》"},"example":{"text":"赠中书令，追封魏王，赐谥，后改吴王，又改越王。德昭～。","book":"《宋史·宗室传三》"},"similar":["喜怒不形于色"],"opposite":["喜形于色","喜形于颜"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":12165,"word":"喜新厌故","pinyin":"xǐ xīn yàn gù","abbr":"xxyg","explanation":"喜欢新的，厌弃旧的。多指爱情不专一。同“喜新厌旧”。","source":{"text":"专门之学，自古为病，正谓出于一律，而不肯听者，不可罪不听之人，迨由陈迹，人之耳目喜新厌故，天下之同情也，故予以为大人达士不局於一家者，此也。","book":"宋·郭熙淳《林泉高致·山水训》"},"example":{"text":"张子诚自从讨了如夫人以后，～。","book":"清·彭养鸥《《黑籍冤魂》第二十二回"},"similar":["喜新厌旧"],"opposite":["始终如一"],"usage":"作谓语、宾语、定语；指感情不专一"},{"id":12166,"word":"喜新厌旧","pinyin":"xǐ xīn yàn jiù","abbr":"xxyj","explanation":"喜欢新的，厌弃旧的。多指爱情不专一。","source":{"text":"不怕你有喜新厌旧的心肠，我自有移星换斗的手段。","book":"清·文康《儿女英雄传》第二十七回"},"example":{"text":"他～，跟哪一个人都好不长久。","book":"巴金《秋》十六"},"similar":["朝三暮四","见异思迁"],"opposite":["坚定不移","地久天长"],"usage":"作谓语、宾语、定语；指感情不专一"},{"id":12167,"word":"喜气冲冲","pinyin":"xǐ qì chōng chōng","abbr":"xqcc","explanation":"充满了欢喜的神色或气氛。","source":{"text":"合衙门的人因为老爷得了保案，都是喜气冲冲的。","book":"清·李宝嘉《官场现形记》第四十五回"},"example":{"text":"歪面孔和周阿梅他们刚回到各自的船上，接着蔡永良也～回来了。","book":"矛盾《锻炼》二十"}},{"id":12168,"word":"喜气洋洋","pinyin":"xǐ qì yáng yáng","abbr":"xqyy","explanation":"洋洋：得意的样子。充满了欢喜的神色或气氛。","source":{"text":"登斯楼也，则有心旷神怡，宠辱皆忘，把酒临风，其喜洋洋者矣。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"马上的将士们都　是精神抖擞，～，丝毫不象是吃过败仗。","book":"姚雪垠《李自成》第二卷第三十五章"},"similar":["欢天喜地","喜眉笑眼"],"opposite":["愁眉苦脸","愁眉锁眼"],"usage":"作谓语、定语、状语；指非常得意"},{"id":12169,"word":"喜溢眉宇","pinyin":"xǐ yì méi yǔ","abbr":"xymy","explanation":"指人眉目之间充满了欢乐之情。","source":{"text":"生喜溢眉宇，问：‘居何里？’吴诡曰：‘西南山中，去此可三十余里。’生又嘱再四，吴锐身自任而去。","book":"清·蒲松龄《聊斋志异·婴宁》"},"example":{"text":"慈禧后～，格外畅适。","book":"蔡东藩《清史演义》第八十三回"}},{"id":12170,"word":"喜溢眉梢","pinyin":"xǐ yì méi shāo","abbr":"xyms","explanation":"形容人很快乐的精神。","example":{"text":"想到将与阔别已久的好友相见，他不禁～。"}},{"id":12171,"word":"喜眉笑眼","pinyin":"xǐ méi xiào yǎn","abbr":"xmxy","explanation":"喜在眉梢，笑在眼里。形容面带笑容、十分高兴的样子。","source":{"text":"好像迎接贵客一样，喜眉笑眼朝着沟里张望。","book":"柳青《铜墙铁壁》第十章"},"example":{"text":"一个～的小伙子打趣地说，他乜了那姑娘，调皮地眨了眨眼睛。","book":"《山村新人》"},"similar":["喜气洋洋","喜笑颜开"],"opposite":["愁眉苦脸"],"usage":"作定语、状语、补语；指人高兴"},{"id":12172,"word":"喜眉笑脸","pinyin":"xǐ méi xiào liǎn","abbr":"xmxl","explanation":"指人十分高兴。","source":{"text":"这家伙喜眉笑脸地对他悄悄伸出一个大拇指，说：‘好！’","book":"路遥《平凡的世界》第一卷第二章"},"opposite":["愁眉苦脸"],"usage":"作谓语、定语、状语；用于人的形貌"},{"id":12173,"word":"喜笑怒骂","pinyin":"xǐ xiào nù mà","abbr":"xxnm","explanation":"比喻不论什么题材和形式，都能任意发挥，写出好文章来。","source":{"text":"东坡之酒，赤壁之笛，嬉笑怒骂，皆成文章。","book":"宋·黄庭坚《东坡先生真赞》"}},{"id":12174,"word":"喜笑盈腮","pinyin":"xǐ xiào yíng sāi","abbr":"xxys","explanation":"盈：充满；腮：面颊。笑容满面。形容十分高举的样子。","source":{"text":"这场灾，一时间命运衰，早则解放愁怀，喜笑盈腮。","book":"元·关汉卿《蝴蝶梦》第四折"},"example":{"text":"不信三生石上，相逢处～。","book":"清·西周生《醒世姻缘传》第四十回"},"similar":["喜笑颜开","笑容满面"],"opposite":["愁眉苦脸"],"usage":"作谓语、定语；用于人的情绪"},{"id":12175,"word":"喜笑颜开","pinyin":"xǐ xiào yán kāi","abbr":"xxyk","explanation":"颜开：脸面舒开，指笑容。形容心里高兴，满面笑容。","source":{"text":"故人相见，喜笑颜开，遂留于衙署中安歇。","book":"明·冯梦龙《醒世恒言》卷三十"},"example":{"text":"穿过牌楼，人来人往，莫不～。","book":"清·李汝珍《镜花缘》第九十九回"},"similar":["笑逐颜开","笑容可掬"],"opposite":["愁肠百结","忧心忡忡"],"usage":"作谓语、定语、状语；指很高兴"},{"id":12176,"word":"喜行于色","pinyin":"xǐ xíng yú sè","abbr":"xxys","explanation":"高兴显现在脸上。","example":{"text":"他们听到这个好消息，不禁～。"}},{"id":12177,"word":"喜见乐闻","pinyin":"xǐ jiàn lè wén","abbr":"xjlw","explanation":"闻：听。喜欢听，乐意看。指很受欢迎。","source":{"text":"就其形式来说是群众性的（为人民大众所喜见乐闻的）。","book":"茅盾《夜读偶记》"},"similar":["喜闻乐见"],"usage":"作谓语、定语；指很受欢迎"},{"id":12178,"word":"喜见于色","pinyin":"xǐ jiàn yú sè","abbr":"xjys","explanation":"内心的喜悦表现在脸上。形容抑制不住内心的喜悦。同“喜形于色”。","source":{"text":"［尔朱荣］与葛荣众寡非敌。葛荣闻之，喜见于色。","book":"《北史·尔朱荣传》"},"example":{"text":"齐人伐燕，取其财而俘其民。王朝而受俘，～。","book":"明·刘基《郁离子·螇螰》"},"similar":["喜形于色"],"opposite":["喜怒不形于色"],"usage":"作谓语、定语、状语；指控制不住内心喜悦"},{"id":12179,"word":"喜跃抃舞","pinyin":"xǐ yuè biàn wǔ","abbr":"xybw","explanation":"抃：鼓掌。喜欢得跳跃、鼓掌、起舞。形容极度欢乐而手舞足蹈的情状。","source":{"text":"娥还，复为曼声长歌，一里老幼喜跃抃舞，弗能自禁，忘向之悲也。","book":"《列子·汤问》"},"similar":["手舞足蹈"],"usage":"作谓语；形容极度欢乐"},{"id":12180,"word":"喜逐颜开","pinyin":"xǐ zhú yán kāi","abbr":"xzyk","explanation":"逐：追随；颜：脸面，面容。形容十分喜悦，满脸笑容。","source":{"text":"宋江见了，喜从天降，笑逐颜开。","book":"明·施耐庵《水浒全传》第四十二回"},"example":{"text":"学道看罢，不觉～，一天愁都没有了。","book":"清·吴敬梓《儒林外史》第七回"},"similar":["笑逐颜开"],"usage":"作谓语、宾语、状语；指十分高兴"},{"id":12181,"word":"喜闻乐见","pinyin":"xǐ wén lè jiàn","abbr":"xwlj","explanation":"喜欢听，乐意看。指很受欢迎。","source":{"text":"仆诚喜闻而乐道，自顾何德以承之。","book":"明·王守仁《王文成公全书》"},"example":{"text":"他的卧薪尝胆的故事，两千多年来为人民所～。","book":"吴晗《卧薪尝胆的故事》"},"similar":["脍炙人口","喜闻乐道"],"opposite":["痛恨不已"],"usage":"作谓语、定语；指很受欢迎"},{"id":12182,"word":"喝倒彩","pinyin":"hè dào cǎi","abbr":"hdc","explanation":"指以嘘声来嘲弄或攻击。也指表示不赞同或不满意的叫声。","source":{"text":"这出戏不容我不唱，哪怕台下喝倒彩，我也要把它唱完。","book":"高阳《胡雪岩全传·平步青云》下册"},"usage":"作谓语、宾语、定语；用于处事"},{"id":12183,"word":"喝西北风","pinyin":"hē xī běi fēng","abbr":"hxbf","explanation":"原作“吸风”。指道家所宣扬的一种境界，即不食人间烟火，只靠呼吸空气生存。指没有东西吃，空着肚子过日子。","source":{"text":"边云四顾浓，饥马嗅枯丛。万里八九月，一身西北风。","book":"《庄子·逍遥游》：“藐姑射之山，有神人居焉……不食五谷，吸风饮露。”唐·枉檐《游边》"},"example":{"text":"叫我们管山吃山，管水吃水，都象你这一毛不拔，我们喝西北风。","book":"清·吴敬梓《儒林外史》第四十一回"},"usage":"作谓语、宾语；指没有东西吃"},{"id":12184,"word":"喝雉呼卢","pinyin":"hè zhì hū lú","abbr":"hzhl","explanation":"喝、呼：呼喊；雉、卢：古时摴蒱骰子掷出的两种彩。形容赌徒赌兴正酣时的样子。也指赌博。","source":{"text":"呼卢喝雉连暮夜，击兔伐狐穷岁年。","book":"唐·李白《少年行》诗：“呼卢百万终不异，报仇千里如咫尺。”宋·陆游《风顺舟中甚疾戏书》"},"example":{"text":"一到周末，他们一伙人～，闹得家里乌烟瘴气"},"similar":["呼卢喝雉"],"usage":"作谓语、宾语、定语；指赌博"},{"id":12185,"word":"喟然叹息","pinyin":"kuì rán tàn xī","abbr":"krtx","explanation":"喟然：叹气的样子。形容因深有感慨而叹息。","source":{"text":"太祖贵其公亮，喟然叹息，迁中尉。","book":"晋·陈寿《三国志·魏志·崔琰传》"},"similar":["喟然长叹","喟然而叹"],"usage":"作谓语、状语；指感慨"},{"id":12186,"word":"喟然太息","pinyin":"kuì rán tài xī","abbr":"krtx","explanation":"喟然：叹气的样子；太息：大声叹息。因感慨而大声叹息。","source":{"text":"伯乐喟然太息曰：‘一至于此乎！’","book":"《列子·说符》"},"example":{"text":"四座有经历世故者，多～。","book":"清·纪昀《阅微草堂笔记·姑妄听之一》"},"similar":["喟然而叹"],"usage":"作谓语、状语；指感慨"},{"id":12187,"word":"喟然而叹","pinyin":"kuì rán ér tàn","abbr":"kret","explanation":"喟然：叹气的样子。形容因深有感慨而叹息。","source":{"text":"昔者仲尼与于蜡宾，事毕，出游于观上，喟然而叹。","book":"西汉·戴圣《礼记·礼运》"},"example":{"text":"余读风雅诸诗，未尝不～也。","book":"清·汪琬《王子底诗集·序》"},"similar":["喟然叹息"],"usage":"作谓语；指感慨"},{"id":12188,"word":"喟然长叹","pinyin":"kuì rán cháng tàn","abbr":"krct","explanation":"喟然：叹气的样子。因感慨而深深地叹气。","source":{"text":"颜渊喟然叹曰：‘仰之弥高，钻之弥坚。’","book":"《论语·子罕》"},"example":{"text":"时莫能听用其谋，～，自伤不遭。","book":"冯衍《自论赋》"},"similar":["喟然太息"],"usage":"作谓语、状语；用于感怀"},{"id":12189,"word":"喧嚣一时","pinyin":"xuān xiāo yī shí","abbr":"xxys","explanation":"喧嚣：叫嚣。叫嚣了很短的时间。指昙花一现的事物。","source":{"text":"长矜争之心，恣喧嚣之慢。","book":"《魏书·韩麒鳞传》"},"example":{"text":"‘四人帮’曾经～，颠倒是非，搞乱了人们的思想。","book":"邓小平《在全国科学大会开幕式上的讲话》"},"usage":"作谓语、定语；指昙花一现的事物"},{"id":12190,"word":"喧客夺主","pinyin":"xuān kè duó zhǔ","abbr":"xkdz","explanation":"喧：声音大。客人的声音压倒了主人的声音。比喻外来的或次要的事物占据了原有的或主要的事物的位置。","source":{"text":"遂觉一传中义庆事转少，鲍照事转多，此未免喧客夺主矣。","book":"清·赵翼《廿二史札记·宋齐书带叙法》"},"example":{"text":"回教祖摩诃末子孙，由西而东，争至天山南路，生齿渐蕃，～，察哈台的后裔，反弄到没有主权。","book":"蔡东藩《清史演义》第三十七回"},"similar":["喧宾夺主"],"usage":"作谓语、定语、宾语；指位置颠倒"},{"id":12191,"word":"喧宾夺主","pinyin":"xuān bīn duó zhǔ","abbr":"xbdz","explanation":"喧：声音大。客人的声音压倒了主人的声音。比喻外来的或次要的事物占据了原有的或主要的事物的位置。","source":{"text":"近有喧宾夺主之势。","book":"清·杨宜治《俄程日记》"},"example":{"text":"成了多数政治，还怕什么外种人～吗？（清·梁启超《新中国未来记》第三回）"},"similar":["反客为主","本末倒置"],"opposite":["客随主便"],"usage":"作主语、谓语、定语；指位置颠倒"},{"id":12192,"word":"喷云吐雾","pinyin":"pēn yún tǔ wù","abbr":"pytw","explanation":"喷吐出云雾来。","source":{"text":"炕上还斜躺着几个，正在喷云吐雾抽大烟。","book":"安正福《敌后插刀》"},"example":{"text":"他一抽烟就～。"},"similar":["吞云吐雾","烟雾弥漫"],"usage":"作谓语、定语；指喷吐出云雾来"},{"id":12193,"word":"喷云泄雾","pinyin":"pēn yún xiè wù","abbr":"pyxw","explanation":"形容云霭缭绕山岳的景象。","source":{"text":"火维地荒足妖怪，天假神柄专其雄；喷云泄雾藏半腹，虽有绝顶谁能穷？","book":"唐·韩愈《谒衡岳庙遂宿岳寺题门楼》诗"},"example":{"text":"在读书人的脑中，仿佛它真像是一个‘天假神柄专其雄’的神物，时常在‘～’。","book":"郭沫若《洪波曲》第16章"},"usage":"作谓语、定语；用于书面语"},{"id":12194,"word":"喷唾成珠","pinyin":"pēn tuò chéng zhū","abbr":"ptcz","explanation":"唾：唾沫。咳嗽出来的唾沫都化成了珍珠。形容博学多才，出口成章。","source":{"text":"子不见夫唾者乎？喷则大者如珠，小者如雾。","book":"战国·宋·庄周《庄子·秋水》"},"similar":["咳唾成珠"],"usage":"作谓语、宾语；比喻言谈不凡或诗文优美"},{"id":12195,"word":"喷珠吐玉","pinyin":"pēn zhū tǔ yù","abbr":"pzty","explanation":"嘴里喷吐出珍珠美玉。形容博学多才，出口成章。","source":{"text":"他的字迹真乃笔走龙蛇，好似钟王妙楷；看他诗句，真乃喷珠吐玉，不殊曹谢丰采。","book":"明·罗贯中《粉妆楼》第十三回"},"example":{"text":"他的文才很好，经常～。"},"similar":["咳唾成珠"],"usage":"作谓语、定语；指人文才好"},{"id":12196,"word":"喷珠噀玉","pinyin":"pēn zhū xùn yù","abbr":"pzxy","explanation":"口中喷出珠玉。形容口齿伶俐，文辞优美。","source":{"text":"满酌流霞浩歌劝，喷珠噀玉，走凤蟠蛟酬献。","book":"元·姬翼《感皇恩》第九折"},"example":{"text":"大哥哥，枉可惜了你～谈天口。","book":"元·关汉卿《陈母教子》第二折"}},{"id":12197,"word":"喷薄欲出","pinyin":"pēn bó yù chū","abbr":"pbyc","explanation":"喷薄：涌起，上升的样子；欲：将要。形容水涌起或太阳初升时涌上地平线的样子。","source":{"text":"乱流争迅湍，喷薄如雷风。","book":"唐·岑参《冬夜宿仙游寺南凉堂呈谦道人》"},"example":{"text":"它是立于高山之巅远看东方已见光芒四射～的一轮朝日。","book":"毛泽东《星星之火，可以燎原》"},"similar":["如日东升"],"opposite":["日薄西山"],"usage":"作谓语、定语；指新生事物"},{"id":12198,"word":"喷血自污","pinyin":"pēn xuè zì wū","abbr":"pxzw","explanation":"含血喷人，却先污己口。比喻本欲恶毒地污蔑、攻击他人，结果却先害了自己。","source":{"text":"窥窃虚名，而不自知先陷于大群之罪，所谓喷血以自污，求名而不得，可恶也，亦可哀也。","book":"明·张居正《答操江胡玉吾》"},"usage":"作宾语、定语；用于比喻句"},{"id":12199,"word":"喷雨嘘云","pinyin":"pēn yǔ xū yún","abbr":"pyxy","explanation":"形容浪花水气的飞溅散逸。","source":{"text":"君不见岷山导戒南纪，喷雨嘘云九千里，瞿唐剑阁键重关，锦城花绕成都市。","book":"明·刘基《送陈庭学之成都卫照磨任》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":12200,"word":"喻之以理","pinyin":"yù zhī yǐ lǐ","abbr":"yzyl","explanation":"喻：晓喻，开导。用道理来开导说服人。","source":{"text":"然此妇见鸷兽不怖悸，乃能言之有理，亦难能也。","book":"宋·洪迈《夷坚志·丙志》第14卷"},"similar":["晓之以理"],"usage":"作谓语、定语；指开导别人"},{"id":12201,"word":"喻以利害","pinyin":"yù yǐ lì hài","abbr":"yylh","explanation":"喻：使人知道。把事情的利害关系给人讲清楚。","source":{"text":"遂轻诣垒下，晓以利害。","book":"《北齐书·薛修义传》"}},{"id":12202,"word":"嗑牙料嘴","pinyin":"kē yá liào zuǐ","abbr":"kylz","explanation":"多嘴多舌。","source":{"text":"我这里道姓呼名，他那里嗑牙料嘴。","book":"元·王子一《误入桃源》第三折"},"example":{"text":"请不要在我面前～了，我不会相信你的"},"similar":["磕牙料嘴"],"usage":"作宾语、定语；指多嘴多舌"},{"id":12203,"word":"嗒焉自丧","pinyin":"tà yān zì sàng","abbr":"dyzs","explanation":"嗒焉：沮丧的样子。形容若有所失或灰心丧气的心态。","source":{"text":"仰天而嘘，嗒焉似丧其耦。","book":"战国·宋·庄周《庄子·齐物论》"},"similar":["垂头丧气"],"usage":"作谓语、定语；指灰心"},{"id":12204,"word":"嗒焉若丧","pinyin":"tà yān ruò sàng","abbr":"dyrs","explanation":"嗒焉：沮丧的样子。原指形神解体，物我皆失。后多形容懊丧的神情。","source":{"text":"仰天而嘘，嗒焉似丧其耦。","book":"《庄子·齐物论》"},"example":{"text":"女入室痴坐，～，终日不食，扫榻遽寝。","book":"清·蒲松龄《聊斋志异·江城》"}},{"id":12205,"word":"嗒然若丧","pinyin":"tà rán ruò sàng","abbr":"trrs","explanation":"形容懊丧的神情。","source":{"text":"仰天而嘘，嗒焉似丧其耦。","book":"《庄子·齐物论》"},"example":{"text":"欧阳业在他挟持之下，状似木鸡，～。","book":"梁羽生《牧野流星》第五十四回"},"similar":["嗒焉自丧"],"usage":"作谓语、状语；用于人的深情"},{"id":12206,"word":"嗔拳不打笑面","pinyin":"chēn quán bù dǎ xiào miàn","abbr":"cqbdxm","explanation":"比喻不可以欺凌态度和悦的人。","source":{"text":"自古嗔拳不打笑面，他又不曾伤犯着你，你有钱看平日相交与他些，没钱罢了，如何只顾打他？","book":"明·兰陵笑笑生《金瓶梅词话》第96回"},"example":{"text":"～”，你何必跟他一般见识呢","book":"常言道"},"usage":"作宾语、定语、分句；用于处事"},{"id":12207,"word":"嗔目切齿","pinyin":"chēn mù qiē chǐ","abbr":"cmqc","explanation":"嗔目：发怒时睁大眼睛。瞪大眼睛，咬紧牙齿。形容极端愤怒的样子。","source":{"text":"复辟之贻害清室也如彼，不利于国家也如此。内之不特非清室自动，而孀妃耆博，且不胜其疾首痛心。外之不特非群公劝进，而比户编氓，各不相谋，而嗔目切齿。","book":"丁中江《北洋军阀史话·段祺瑞马厂誓师》"}},{"id":12208,"word":"嗛嗛之德","pinyin":"xián xián zhī dé","abbr":"qqzd","explanation":"嗛嗛：微小。指小小的美德，或微小的恩德。","source":{"text":"嗛嗛之德，不足就也，不可以矜，而祗取忧也。","book":"《国语·晋语一》"}},{"id":12209,"word":"嗛嗛之食","pinyin":"xián xián zhī shí","abbr":"qqzs","explanation":"嗛嗛：微小。指很少的一点食物。","source":{"text":"嗛嗛之食，不足狃也，不能为膏，而祗罹咎也。","book":"《国语·晋语一》"}},{"id":12210,"word":"嗛而未发","pinyin":"xián ér wèi fā","abbr":"qewf","explanation":"嗛：怀恨隐忍。怀恨在心而未露表露出来。","source":{"text":"景帝恚，心嗛而未发。","book":"《史记·外戚世家》"}},{"id":12211,"word":"嗜杀成性","pinyin":"shì shā chéng xìng","abbr":"sscx","explanation":"嗜：爱好。好杀人成了习性。形容极端凶残。","source":{"text":"‘孰能一之？’对曰：‘不嗜杀人者能一之。’","book":"战国·邹·孟轲《孟子·梁惠王上》"},"example":{"text":"日本帝国主义侵略者～，我们要坚决还击。"},"usage":"作谓语、定语；指人好战"},{"id":12212,"word":"嗜痂之癖","pinyin":"shì jiā zhī pǐ","abbr":"sjzp","explanation":"嗜：喜爱；痂：疮口结的硬壳；癖：积久的嗜好。原指爱吃疮痂的癖性。后形容怪癖的嗜好。","source":{"text":"邕性嗜食疮痂，以为味似鳆鱼。","book":"《南史·刘穆之传》"},"example":{"text":"但他却可以有几条希望，就是望吃菜的没有“～”。","book":"鲁迅《热风·对于批评家的希望》"},"similar":["嗜痂成癖"],"usage":"作宾语；形容怪癖的嗜好"},{"id":12213,"word":"嗜痂成癖","pinyin":"shì jiā chéng pǐ","abbr":"sjcp","explanation":"比喻人有怪异的不良嗜好癖。","source":{"text":"东邕性嗜食疮痂，以为味似鳆鱼。尝诣孟灵休。灵休先患炙疮，疮痂落在床，邕取食之，灵休大惊。","book":"语出南朝·宋·刘敬叔《异苑》卷十"},"example":{"text":"例如喜欢墨家，便连墨家崇拜鬼神都要替它辩解，或说出一番民主的意义出来，那未免近于～了。","book":"郭沫若《新陈代谢》"},"similar":["嗜痂之癖"],"usage":"作宾语、定语；形容怪癖的嗜好","story":["传说古代东莞人刘邕有吃人身上的疮疤痂的爱好，他觉得吃起来像吃鳆鱼一样的味道。有一次他去拜访孟灵休。孟灵休先患炙疮，疮痂落在床，刘邕拿来津津有味地吃起来，吓得孟灵休立即劝阻他不要这样"]},{"id":12214,"word":"嗜痂有癖","pinyin":"shì jiā yǒu pǐ","abbr":"sjyp","explanation":"嗜：喜爱；痂：疮口结的硬壳；癖：积久的嗜好。原指爱吃疮痂的癖性。后形容人爱好特殊的事物已成一种癖好。","source":{"text":"邕所至嗜食疮痂，以为味似鳆鱼。","book":"《宋书·刘邕传》"},"example":{"text":"此辈猪仔，自吾人民视之，不值一文，乃竟有价三千以收买之者，可谓～。","book":"蔡东藩、许廑父《民国通俗演义》第一百五十一回"}},{"id":12215,"word":"嗜胆嗜枣","pinyin":"shì dǎn shì zǎo","abbr":"sdsz","explanation":"嗜：爱好。喜欢吃苦胆，喜欢吃酸枣。比喻人有某种特殊的爱好。","source":{"text":"文王嗜胆，曾晳嗜枣，胆苦枣酸，圣贤甘之，与众异也。","book":"北齐·刘书《刘子·言苑》"}},{"id":12216,"word":"嗜血成性","pinyin":"shì xuè chéng xìng","abbr":"sxcx","explanation":"嗜：爱好。爱好吸血成了习性。指贪婪地进行敲诈勒索，榨取民脂民膏。","example":{"text":"李愬久经沙场，～，杀人如麻。","book":"刘静生《月黑风高》五"}},{"id":12217,"word":"嗟悔亡及","pinyin":"jiē huǐ wáng jí","abbr":"jhwj","explanation":"嗟：感叹，叹息；亡及：来不及。后悔也来不及。","source":{"text":"夫以人之死争胜，跌而不振，则悔之亡及矣。","book":"东汉·班固《汉书·晁错传》"},"similar":["后悔不及","悔之晚矣"],"usage":"作谓语；指后悔不及"},{"id":12218,"word":"嗟悔无及","pinyin":"jiē huǐ wú jí","abbr":"jhwj","explanation":"嗟：叹息。叹息和后悔已经来不及了。","source":{"text":"汝悔身何及。","book":"《尚书·盘庚上》"},"example":{"text":"否则，因循坐误，责有攸归；全国丧亡，～。","book":"毛泽东《为动员一切力量争取抗战胜利而斗争》"},"similar":["后悔莫及"],"usage":"作谓语；指后悔已经来不及了"},{"id":12219,"word":"嗟来之食","pinyin":"jiē lái zhī shí","abbr":"jlzs","explanation":"指带有侮辱性的施舍。","source":{"text":"予唯不食嗟来之食，以至于斯也！","book":"《礼记·檀弓下》"},"example":{"text":"志士不饮盗泉之水，廉者不受～。","book":"明·冯梦龙《东周列国志》第八十五回"},"similar":["盗泉之水","残羹冷炙"],"usage":"作主语、宾语、定语；指带有侮辱性的","story":["春秋时期，齐国发生严重的饥荒，很多人被活活地饿死，贵族钱敖想发点善心，他在大路上摆上食物，准备施舍给饥饿的人群，当有难民经过时，他傲慢地喝道：“喂，来吃吧！”谁知那饿汉表示宁愿饿死也不吃这嗟来之食"]},{"id":12220,"word":"嗤之以鼻","pinyin":"chī zhī yǐ bí","abbr":"czyb","explanation":"嗤：讥笑。用鼻子吭声冷笑。表示轻蔑。","source":{"text":"尝欲作器物，先种梓漆，时人嗤之。","book":"《后汉书·樊宏传》"},"example":{"text":"说于乡，乡人笑之；说于市，市人非之；请于巨绅贵族，更～。","book":"清·颐琐《黄绣球》第七回"},"similar":["不以为然","不屑一顾","视如敝屣"],"opposite":["五体投地"],"usage":"作谓语、宾语；用于对错误言行的蔑视"},{"id":12221,"word":"嗫嗫嚅嚅","pinyin":"niè niè rú rú","abbr":"nnrr","explanation":"犹吞吞吐吐。想说，但又不痛痛快快地说。形容说话有顾虑。","source":{"text":"只得来见襄敏公。却也嗫嗫嚅嚅，未敢一直说失去小衙内的事。","book":"明·凌濛初《二刻拍案惊奇》卷五"},"example":{"text":"石永公在旁边～地说。","book":"柳青《铜墙铁壁》第八章"},"similar":["吞吞吐吐"],"usage":"作定语、状语；用于书面语"},{"id":12222,"word":"嗫嚅小儿","pinyin":"niè rú xiǎo ér","abbr":"nrxe","explanation":"比喻见识浅陋。","source":{"text":"其经营泰东也，则横贯万里不毛之西伯利亚，建一空前绝后之大铁路。自嗫嚅小儿之国民视之，几以为五石之瓢匏，落而无所容。","book":"梁启超《欧洲地理大势论》"},"usage":"作宾语、定语；用于书面语"},{"id":12223,"word":"嗳声叹气","pinyin":"āi shēng tàn qì","abbr":"astq","explanation":"因伤感、烦闷或悲痛而发出叹息声。","source":{"text":"薛蟠急得说又不好，劝又不好，打又不好，央告又不好，只是出入嗳声叹气。","book":"清·曹雪芹《红楼梦》第80回"},"example":{"text":"刁迈彭一面让他起，一面故意做出～的样子，说‘这是怎么好！这是怎么好！叫我怎么对得起死的大哥！’","book":"李宝嘉《官场现形记》第五十一回"},"similar":["唉声叹气"],"opposite":["喜笑颜开"],"usage":"作谓语、状语、补语；用于忧愁等叹息"},{"id":12224,"word":"嗷嗷待哺","pinyin":"áo áo dài bǔ","abbr":"aadb","explanation":"嗷嗷：哀鸣声；待：等待；哺：喂食。饥饿时急于求食的样子。形容受饥饿的悲惨情景。","source":{"text":"作治数年，天下遍被其劳，国家疲弊，府库空虚，下至众庶，嗷嗷苦之。","book":"《诗经·小雅·鸿雁》：“鸿雁于飞，哀鸣嗷嗷。”汉·荀悦《前汉纪·成帝纪三》"},"example":{"text":"文章尽可在别的刊物上发表，对于～的创造社的几种刊物却一字也不肯飞来。","book":"郭沫若《学生时代·创造十年续编》"},"similar":["饥寒交迫","啼饥号寒"],"opposite":["丰衣足食","家给人足"],"usage":"作谓语、定语；用于处于困境需要援助"},{"id":12225,"word":"嗷嗷待食","pinyin":"áo áo dài shí","abbr":"aads","explanation":"嗷嗷：哀鸣声；待：等待；食：喂养。迫于饥饿而急于求食的样子。形容灾民受饥饿，处于困境等待援助。","source":{"text":"况家中尚不致嗷嗷待食，亦无需吾哥焦灼家用。","book":"清·秋瑾《致秋誉章书其五》"},"similar":["嗷嗷待哺"],"opposite":["丰衣足食"],"usage":"作谓语、定语；用于处于困境需要援助"},{"id":12226,"word":"嗷嗷无告","pinyin":"áo áo wú gào","abbr":"aawg","explanation":"无告：指无处可以告贷和求救。形容身陷饥饿和困境中无处可以求援。","source":{"text":"赤子嗷嗷无告，不可以不拯。","book":"宋·陈亮《中兴论》"}},{"id":12227,"word":"嘀嘀咕咕","pinyin":"dí dí gū gū","abbr":"ddgg","explanation":"小声说，私下里说。","source":{"text":"他们两个水手在那里嘀嘀咕咕的，两个人交头接耳，不知议论什么事情。","book":"清·石玉昆《小五义》第107回"},"example":{"text":"他一个人在那～。"},"similar":["嘟嘟哝哝"],"usage":"作谓语、状语；指小声说话"},{"id":12228,"word":"嘁哩喀喳","pinyin":"qī lǐ kā chā","abbr":"qlkc","explanation":"形容说话做事干脆、利索。","example":{"text":"他说话做事～的十分利索。"},"similar":["干脆利索"],"opposite":["婆婆妈妈"],"usage":"作状语；指人说话做事"},{"id":12229,"word":"嘁嘁喳喳","pinyin":"qī qī zhā zhā","abbr":"qqzz","explanation":"低声议论，搬弄是非。","source":{"text":"说着便叫过一个心腹婆子来，耳根底下嘁嘁喳喳说了几句话。","book":"清·曹雪芹《红楼梦》第25回"},"example":{"text":"小妇人的～，又何尝不可以消闲。","book":"鲁迅《准风月谈·归厚》"},"similar":["嘁嘁嚓嚓"],"usage":"作宾语、定语；指搬弄是非"},{"id":12230,"word":"嘁嘁嚓嚓","pinyin":"qī qī chā chā","abbr":"qqcc","explanation":"形容悄悄地小声说话。也指说长道短，搬弄是非。","source":{"text":"成千上万的乌鸦飞过天空。战士们嘁嘁嚓嚓地说，乌鸦是世界上最败兴的东西！","book":"杜鹏程《保卫延安》第一章七"},"example":{"text":"行帮气息太浓厚了，除去那些～的作者之外，甚至浓厚到只要是自己圈子里的人，即使曾经投敌，也毫不警惕。","book":"《人民文学》1977年第8期"},"similar":["嘁嘁喳喳"],"usage":"作宾语、定语；指搬弄是非"},{"id":12231,"word":"嘈嘈杂杂","pinyin":"cáo cáo zá zá","abbr":"cczz","explanation":"指声音喧闹、杂乱扰人。","source":{"text":"忽听外边嘈嘈杂杂，六七个小校，扛进行李与一坛酒，食盒中放着肴馔。","book":"清·褚人获《隋唐演义》第59回"},"example":{"text":"曾朴《孽海花》第七回：“夹着外面风声、水声，～，闹得心烦意乱，不知怎样才好。”"},"opposite":["安安静静","清清静静"],"usage":"作定语、状语；用于环境等"},{"id":12232,"word":"嘉肴旨酒","pinyin":"jiā yáo zhǐ jiǔ","abbr":"jyzj","explanation":"旨酒：美酒。指美味的酒食。","source":{"text":"夫嘉肴旨酒，非不美也，夏禹盛以陶豆，殷纣贮以玉杯，而此圣已兴，彼愚以灭。","book":"晋·钮滔母《与从弟孝徵书》"}},{"id":12233,"word":"嘉肴美馔","pinyin":"jiā yáo měi zhuàn","abbr":"jymz","explanation":"肴：做熟的鱼肉等；馔：饮食。美味的饭菜美食。","source":{"text":"允预备嘉肴美馔，候吕布至，允出门迎迓，接入后堂，延之上座。","book":"明·罗贯中《三国演义》第八回"}},{"id":12234,"word":"嘉言善状","pinyin":"jiā yán shàn zhuàng","abbr":"jysz","explanation":"有教育意义的好言语和好行为。同“嘉言善行”。","source":{"text":"至于通材达识，义烈节士，嘉言善状，皆见于篇。","book":"宋·曾巩《寄欧阳舍人书》"},"similar":["嘉言善行","嘉言懿行"],"usage":"作主语、宾语；指美善的言行"},{"id":12235,"word":"嘉言善行","pinyin":"jiā yán shàn xíng","abbr":"jysx","explanation":"嘉：善、美。有教育意义的好言语和好行为。","source":{"text":"见人嘉言善行，则敬慕而记录之。","book":"《尚书·大禹谟》：“若允兹，嘉言罔攸伏，野无遗贤，万邦贤宁。”宋·朱熹《朱子全书·学五》"},"example":{"text":"我料贤弟必有～，教训老夫咱。","book":"元·关汉卿《谢天香》第一折"},"similar":["嘉言懿行","嘉言善状"],"opposite":["污言秽行"],"usage":"作主语、宾语；指美善的言行"},{"id":12236,"word":"嘉言懿行","pinyin":"jiā yán yì xíng","abbr":"jyyx","explanation":"嘉、懿：善、美。有教育意义的好言语和好行为。","source":{"text":"见人嘉言善行，则敬慕而记录之。","book":"《尚书·大禹谟》：“若允兹，嘉言罔攸伏，野无遗贤，万邦贤宁。”宋·朱熹《朱子全书·学五》"},"example":{"text":"这部书叫《帝鉴图说》，出于明朝张居正的手笔，辑录历代贤主的～。","book":"高阳《玉座珠帘》上册"},"similar":["瑰意琦行"],"opposite":["污言秽行","为非作歹"],"usage":"作主语、宾语；指有益的言论和高尚的行为"},{"id":12237,"word":"嘉谋善政","pinyin":"jiā mǒu shàn zhèng","abbr":"jmsz","explanation":"嘉、善：好。好的计策和政绩。","source":{"text":"及其入处国钧，未有嘉谋善政；出总戎律，唯闻蹙国丧师。","book":"《晋书·诸葛恢传》"},"example":{"text":"天子所乏，～有益于下者。","book":"《新唐书·权万纪传》"}},{"id":12238,"word":"嘎七马八","pinyin":"gā qī mǎ bā","abbr":"gqmb","explanation":"指毫无条理，乱七八糟。","source":{"text":"他就嘎七马八的买回一大堆食物，给他们俩吃。","book":"老舍《骆驼祥子》"},"similar":["嘎七杂八"],"usage":"作定语、状语；指杂乱"},{"id":12239,"word":"嘘唏不已","pinyin":"xū xī bù yǐ","abbr":"xxby","explanation":"嘘唏：哽咽；已：停止。形容抽抽噎噎地不断哭泣","source":{"text":"歔欷不已，若丧所生。","book":"《晋书·后妃·左贵嫔传》"},"similar":["歔欷不已"],"usage":"作谓语、状语；用于书面语"},{"id":12240,"word":"嘘寒问暖","pinyin":"xū hán wèn nuǎn","abbr":"xhwn","explanation":"嘘：缓缓吹气。形容对人的生活十分关切，问冷问热。","source":{"text":"孩子们安静听话，太太笑脸相迎，嘘寒问暖。","book":"冰心《关于女人·我最尊敬体贴她们》"},"example":{"text":"他经常过来～。"},"similar":["关怀备至","无微不至","体贴入微"],"opposite":["勾心斗角","漠不关心"],"usage":"作主语、谓语、状语；指关心别人"},{"id":12241,"word":"嘘枯吹生","pinyin":"xū kū chuī shēng","abbr":"xkcs","explanation":"嘘：呵气。枯了的吹气使生长，生长着的吹气使枯干。比喻在言论中有批评的，有表扬的。","source":{"text":"孔公绪，清淡高论，嘘枯吹生，并无军旅之才，执锐之干。","book":"《后汉书·郑太传》"},"example":{"text":"陵夷至于魏、晋，浮屠稍炽，以～为能事。","book":"章炳麟《实学报叙》"},"similar":["能说会道"],"usage":"作谓语、定语；指能说会道"},{"id":12242,"word":"嘟嘟哝哝","pinyin":"dū dū nóng nóng","abbr":"ddnn","explanation":"连续地小声地自言自语。有时也带有抱怨的意思。","source":{"text":"这个人定要疯了！昨夜嘟嘟哝哝直闹到五更天才睡下，没一顿功夫天就亮了。","book":"清·曹雪芹《红楼梦》第48回"},"example":{"text":"她～了大半天，我一句都没听清。"},"similar":["嘟嘟囔囔"],"usage":"作谓语、状语；多表示不满"},{"id":12243,"word":"嘟嘟囔囔","pinyin":"dū dū nāng nāng","abbr":"ddnn","explanation":"不断地、含混地自言自语。","source":{"text":"一面向宝玉脸上用指头画了几画，口内嘟嘟囔囔的。","book":"清·曹雪芹《红楼梦》第25回"},"example":{"text":"请不要～的，有话好好说。"},"similar":["嘟嘟哝哝"],"usage":"作谓语、状语；多表示不满"},{"id":12244,"word":"嘤其鸣矣，求其友声","pinyin":"yīng qí míng yǐ，qiú qí yǒu shēng","abbr":"yqmyqqys","explanation":"嘤：鸟鸣声。鸟儿在嘤嘤地鸣叫，寻求同伴的应声。比喻寻求志同道合的朋友。","source":{"text":"嘤其鸣矣，求其友声。相彼鸟矣，犹求友声；矧伊人矣，不求友生。","book":"《诗经·小雅·伐木》"},"example":{"text":"《诗经》上说的：“～”。我们正是处在这种时候。","book":"毛泽东《斯大林是中国人民的朋友》"},"similar":["嘤鸣求友"],"usage":"作宾语、分句；指找朋友"},{"id":12245,"word":"嘤鸣求友","pinyin":"yīng míng qiú yǒu","abbr":"ymqy","explanation":"嘤：鸟鸣声。鸟儿在嘤嘤地鸣叫，寻求同伴的回声。比喻寻求志同道合的朋友。","source":{"text":"嘤其鸣矣，求其友声。相彼鸟矣，犹求友声；矧伊人矣，不求友生。","book":"《诗经·小雅·伐木》"},"example":{"text":"而脱稿后求能与世相见，～之心，詸人人所共有。","book":"茅盾《〈新绿丛辑〉旨趣》"},"similar":["嘤其鸣矣，求其友声"],"usage":"作宾语、定语；指寻知音"},{"id":12246,"word":"嘤鸣求友声","pinyin":"yīng míng qiú yǒu shēng","abbr":"ymqys","explanation":"嘤：鸟鸣声。鸟儿在嘤嘤地鸣叫，寻求同伴的应声。比喻寻求志同道合的朋友。","source":{"text":"嘤其鸣矣，求其友声。相彼鸟矣，犹求友声；矧伊人矣，不求友生。","book":"《诗经·小雅·伐木》"}},{"id":12247,"word":"嘤鸣求声","pinyin":"yīng míng qiú shēng","abbr":"ymqs","explanation":"嘤：鸟鸣声。鸟儿在嘤嘤地鸣叫，寻求同伴的应声。比喻寻求志同道合的朋友。","source":{"text":"嘤其鸣矣，求其友声。相彼鸟矣，犹求友声；矧伊人矣，不求友生。","book":"《诗经·小雅·伐木》"}},{"id":12248,"word":"嘲风咏月","pinyin":"cháo fēng yǒng yuè","abbr":"cfyy","explanation":"指描写风云月露等景象而思想内容贫乏的写作。","source":{"text":"至于梁陈间，率不过嘲风雪弄花草而已。","book":"唐·白居易《与元九书》"},"example":{"text":"德行文章没包弹，绰有赋名诗价。选甚～。","book":"金·董解元《西厢记诸宫调》第一卷"},"similar":["嘲风弄月"],"usage":"作谓语、定语、宾语；指描写风月的差作品","story":["宋朝时期，赵匡胤取南唐，南唐后主李煜主动投降，成为有名无实的“金吾大将军”，宋太宗赵光义信步到翰林苑，看到李煜在侍侯着原南唐旧臣徐铉等，觉得奇怪就问为什么，徐铉斜视李煜说他没能力治国，只会嘲风咏月，只配如此"]},{"id":12249,"word":"嘲风弄月","pinyin":"cháo fēng nòng yuè","abbr":"cfny","explanation":"嘲：嘲笑；弄：玩赏；风、月：泛指各种自然景物。指描写风云月露等景象而思想内容贫乏的写作。","source":{"text":"咏月嘲风先要减，登山临水亦宜稀。","book":"晋·王嘉《拾遗记》：“免学他嘲风咏月，污人行止。”唐·白居易《将归渭村先寄舍弟》诗"},"example":{"text":"我和你今日啸傲烟霞，～，何等自在。","book":"清·陈忱《水浒后传》第六回"},"similar":["嘲风咏月"],"usage":"作谓语、宾语、定语；指描写风月的差作品"},{"id":12250,"word":"嘴上功夫","pinyin":"zuǐ shàng gōng fū","abbr":"zsgf","explanation":"指没有实际本事，只是口头说说而已。","example":{"text":"他的～还不错。"},"similar":["口头功夫"],"opposite":["真才实学"],"usage":"作主语、宾语；指口头说说"},{"id":12251,"word":"嘴上无毛，办事不牢","pinyin":"zuǐ shàng wú máo，bàn shì bù láo","abbr":"zswmbsbl","explanation":"指年轻人办事不老练与牢靠","source":{"text":"俗语说道，‘嘴上无毛，办事不牢’，像你诸位一定是靠得住，不会冤枉人的了？","book":"清·李宝嘉《官场现形记》第15回"},"usage":"作宾语、定语、分句；多指年轻人"},{"id":12252,"word":"嘴上春风","pinyin":"zuǐ shàng chūn fēng","abbr":"zscf","explanation":"比喻口头上的关切与安慰或是帮别人说好话。","example":{"text":"别太在意她的～。"},"usage":"作主语、宾语、定语；指客套话"},{"id":12253,"word":"嘴多舌长","pinyin":"zuǐ duō shé cháng","abbr":"zdsz","explanation":"好闲谈，好传播流言蜚语。","example":{"text":"她是一个～存心不良的人。"},"usage":"作谓语、定语；指传播流言蜚语"},{"id":12254,"word":"嘴大喉咙小","pinyin":"zuǐ dà hóu lóng xiǎo","abbr":"zdhlx","explanation":"吃得进吞不下，比喻心有余而力不足。","example":{"text":"他是个～的人，十分贪心。"},"similar":["心有余而力不足"],"usage":"作谓语、定语；指人贪心"},{"id":12255,"word":"嘴尖牙利","pinyin":"zuǐ jiān yá lì","abbr":"zjyl","explanation":"说话尖酸刻薄。","example":{"text":"～的晴雯遭到王熙凤等人的迫害。"},"usage":"作谓语、定语；指人说话"},{"id":12256,"word":"嘴尖皮厚腹中空","pinyin":"zuǐ jiān pí hòu fù zhōng kōng","abbr":"zjphfzk","explanation":"说话尖酸刻薄，脸皮厚，腹中没有真才实学。","source":{"text":"有一副对子，是替这种人画像的。那对子说：墙上芦苇，头重脚轻根底浅；山间竹笋，嘴尖皮厚腹中空。","book":"毛泽东《改造我们的学习》"},"usage":"作宾语、定语；用于处世"},{"id":12257,"word":"嘴尖舌头快","pinyin":"zuǐ jiān shé tóu kuài","abbr":"zjstk","explanation":"比喻话多而轻率。","source":{"text":"单管嘴尖舌头快的，不管你事也来插一脚。","book":"明·兰陵笑笑生《金瓶梅词话》第四十三回"},"similar":["嘴尖舌快"],"usage":"作谓语、宾语；指人说话"},{"id":12258,"word":"嘴尖舌快","pinyin":"zuǐ jiān shé kuài","abbr":"zjsk","explanation":"比喻话多而轻率","source":{"text":"不期成茂妻子，一则不知就里，二则嘴尖舌快，竟把‘都大叔进学迎过，不到我家’的话一一说完。","book":"明·伏雌教主《醋葫芦》第15回"},"similar":["嘴尖舌头快"],"usage":"作谓语、宾语；指人说话"},{"id":12259,"word":"嘴快舌长","pinyin":"zuǐ kuài shé cháng","abbr":"zksc","explanation":"指爱说长道短。","source":{"text":"妇言不是花言巧语，嘴快舌长，须是不苟言，不苟笑，内言不出，外言不入，总说一句，便是‘贞静’两个字。","book":"《儿女英雄传》第二十七回"}},{"id":12260,"word":"嘴是两张皮","pinyin":"zuǐ shì liǎng zhāng pí","abbr":"zslzp","explanation":"爱怎么说就怎么说。","example":{"text":"～，你爱怎么说就怎么说吧。"},"usage":"作宾语、分句；用于口语"},{"id":12261,"word":"嘴清舌白","pinyin":"zuǐ qīng shé bái","abbr":"zqsb","explanation":"指话说得明确清楚。","source":{"text":"连这毛丫头也来放肆了……想烫坏我么？料想她也不敢，还不是有人在背后指使么？你给我一句嘴清舌白的回话。","book":"茅盾《子夜》八"},"usage":"作定语；用于书面语"},{"id":12262,"word":"嘴甜心苦","pinyin":"zuǐ tián xīn kǔ","abbr":"ztxk","explanation":"说话和善，居心不良。","source":{"text":"‘嘴甜心苦，两面三刀’，‘上头一脸笑着，脚下就使绊子’，‘明是一盆火，暗是一把刀’，他都全占了。","book":"清·曹雪芹《红楼梦》第65回"},"example":{"text":"那些人儿，～，你要仔细提防。","book":"《白雪遗音·马头调·劝嫖》"},"similar":["口蜜腹剑"],"usage":"作谓语、定语；指居心狠毒"},{"id":12263,"word":"嘴直心快","pinyin":"zuǐ zhí xīn kuài","abbr":"zzxk","explanation":"性情直爽，有话就说。","source":{"text":"我要是在营里混下去，早晚有一天非砍了头不可，我嘴直心快，容易得罪了上司！","book":"老舍《秦氏三兄弟》第二幕"}},{"id":12264,"word":"嘴硬心软","pinyin":"zuǐ yìng xīn ruǎn","abbr":"zyxr","explanation":"嘴上不服软，心里却认输。指人嘴好强。","example":{"text":"她是一个～的人。"},"usage":"作谓语、宾语、定语；指人嘴好强"},{"id":12265,"word":"嘴里牙多","pinyin":"zuǐ lǐ yá duō","abbr":"zlyd","explanation":"谑语，指会说话。","source":{"text":"算啦算啦！你嘴里牙多，我说不过你。","book":"马力《黑牡丹》"},"similar":["能说会道"],"usage":"作谓语、定语；用于口语，指能说会道"},{"id":12266,"word":"嘹嘹呖呖","pinyin":"liáo liáo lì lì","abbr":"llll","explanation":"形容声音清脆婉转动听。","source":{"text":"妥娘唱毕，大家又称赞了一会儿，朱贵儿方在轻吞慢吐，嘹嘹呖呖，唱将起来。","book":"清·褚人获《隋唐演义》第30回"},"usage":"作定语、状语；用于声音等"},{"id":12267,"word":"嘻嘻哈哈","pinyin":"xī xī hā hā","abbr":"xxhh","explanation":"嬉笑打闹，形容嬉笑欢乐的样子。也形容态度不严肃、不认真。","source":{"text":"只见秋纹、碧痕嘻嘻哈哈的说笑着进来，两个人共提着一桶水，一手撩着衣裳，趔趔趄趄，泼泼撒撒的。","book":"清·曹雪芹《红楼梦》第24回"},"example":{"text":"他是个乐天派，整天～的。"},"similar":["嬉皮笑脸"],"opposite":["一本正经"],"usage":"作谓语、定语、状语；指态度不严肃","story":["贾宝玉从外边回来，见袭人不在，晴雯也不在，要喝茶与洗澡，小红立即上前献殷勤。宝玉觉得奇怪，但没有别的使唤的丫鬟只好将就。这时秋纹、碧痕两个人共提着一桶水嘻嘻哈哈的说笑着进来，走路趔趔趄趄的，小红只好知趣地走开"]},{"id":12268,"word":"嘻皮涎脸","pinyin":"xī pí xián liǎn","abbr":"xpxl","explanation":"形容轻佻嘻笑不知羞耻的样子。","source":{"text":"糖葫芦嘻皮涎脸的答道：‘我不到你那里去，我到我相好的家里去！’","book":"清·李宝嘉《官场现形记》第二十九回"},"similar":["嬉皮笑脸"],"usage":"作定语、状语；用于处事"},{"id":12269,"word":"嘻皮笑脸","pinyin":"xī pí xiào liǎn","abbr":"xpxl","explanation":"①形容嘻嘻哈哈的样子。②形容轻薄嘻笑的样子。③形容谄笑讨好的样子。","source":{"text":"金旺来了，嘻皮笑脸向小芹说：‘这会可算是个空子吧？","book":"①《红楼梦》第三十回：“你要仔细！你见我和谁玩过！有和你素日嘻皮笑脸的那些姑娘们，你该问他们去！”②赵树理《小二黑结婚》三"},"example":{"text":"③张郎才说了一个宝字，财主就～跑到张郎面前：‘小兄弟，你犁到金子银子了吗？给我看看。’","book":"《中国民间故事选·张郎赛宝》"},"similar":["喜笑颜开"],"opposite":["一本正经","道貌岸然"],"usage":"作谓语、定语、状语；指态度不严肃"},{"id":12270,"word":"嘻笑怒骂","pinyin":"xī xiào nù mà","abbr":"xxnm","explanation":"①指嬉戏、欢笑、愤怒、詈骂等不同的情绪表现。②指不拘守规格，率情任意地发挥表现。③嘲弄辱骂。","source":{"text":"嘻笑怒骂，自是苏文病处；君子之文必庄重。","book":"①清·李渔《闲情偶寄·词曲·词采》：“照此法填词，则离合悲欢，嘻笑怒骂，无一语、一字，不带机趣而行矣。”②清·冯班《钝吟杂录·读古浅说》"},"example":{"text":"③他对权贵～，对平民扶危济困，就是在传说中被神化了的济颠僧。","book":"于敏《西湖即景》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":12271,"word":"嘿嘿无言","pinyin":"mò mò wú yán","abbr":"hhwy","explanation":"不声不响，闭口无言。","source":{"text":"端端正正，嘿嘿无言，静听这一班邪人的胡说。","book":"清·西周生《醒世姻缘传》第85回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第83回：“一席话，骂得言中丞～。”"},"similar":["默默无言"],"usage":"作谓语、宾语；指沉默不说话"},{"id":12272,"word":"嘿然不语","pinyin":"mò rán bù yǔ","abbr":"hrby","explanation":"沉默着不说一句话。","source":{"text":"兀术嘿然不语，在营纳闷。","book":"清·钱彩《说岳全传》第42回"},"similar":["默默不语"],"usage":"作谓语、定语、状语；指沉默"},{"id":12273,"word":"噀玉喷珠","pinyin":"xùn yù pēn zhū","abbr":"xypz","explanation":"形容口齿伶俐，说话悦耳动听。","source":{"text":"言谈处噀玉喷珠舌上挑，咽作处换气偷声使褃巧。","book":"元·汤式《醉花阴·离思》"},"usage":"作谓语、定语；用于说话等"},{"id":12274,"word":"噍类无遗","pinyin":"jiào lèi wú yí","abbr":"jlwy","explanation":"噍：嚼，吃东西；噍类：指活着的人。没有剩下活人。","source":{"text":"含冤抱痛，噍类靡余。","book":"南朝·梁·任昉《策梁公九锡文》"},"example":{"text":"天兵至此，本应灭尔部落，～。","book":"《清史稿·属国四》"},"usage":"作宾语；指战后或灾后"},{"id":12275,"word":"噎噎咽咽","pinyin":"yē yē yè yè","abbr":"yyyy","explanation":"断断续续的哽咽声。","example":{"text":"她～地哭了一夜。"},"usage":"作定语、状语；用于哭泣时"},{"id":12276,"word":"噙齿戴发","pinyin":"qín chǐ dài fā","abbr":"qcdf","explanation":"形容男子汉的豪迈气概。","source":{"text":"孩儿也，你是个男子汉，顶天立地，噙齿戴发，带眼安眉，连皮带肉，带骨连皮，你这般冤仇，怎生不报。","book":"元·无名氏《连环计》第三折：“奉先你是个男子汉，顶天立地，噙齿戴发，与老婆做不的主，要你何用！”元·无名氏《独角牛》第二折"},"example":{"text":"武二是个顶天立地、～男子汉，不是那等败坏风俗、没人伦的猪狗。","book":"明·施耐庵《水浒传》第二十四回"},"usage":"作谓语、定语；多用于男性"},{"id":12277,"word":"噤口不言","pinyin":"jìn kǒu bù yán","abbr":"jkby","explanation":"噤：闭口不作声。闭着嘴不说话。","source":{"text":"近来世上人多诈，尽著布衣称道者。问他金木是何般，噤口不言如害哑。","book":"唐·吕岩《寄白龙洞刘道人》"},"example":{"text":"朱泚构逆，遣人就第问讯，欲令掌兵，晞佯瘖，～，泚以兵胁之，晞终不语，贼知其不可用，乃止。","book":"《旧唐书·郭晞传》"}},{"id":12278,"word":"噤口卷舌","pinyin":"jìn kǒu juǎn shé","abbr":"jkjs","explanation":"指缄默不言。","source":{"text":"迁其赏于不谏，迁其刑于谏，宜乎臣之噤口卷舌，而乱亡随之也。","book":"宋·苏洵《谏论下》"},"example":{"text":"至此几于～，而绝不敢复措其手足。","book":"清·王韬《弢园文录·洋务下》"},"similar":["缄口不言"],"usage":"作谓语、宾语；指不说话"},{"id":12279,"word":"噤口捲舌","pinyin":"jìn kǒu juǎn shé","abbr":"jkjs","explanation":"指缄默不言。"},{"id":12280,"word":"噤若寒蝉","pinyin":"jìn ruò hán chán","abbr":"jrhc","explanation":"噤：闭口不作声。象深秋的蝉那样一声不吭。比喻因害怕有所顾虑而不敢说话。","source":{"text":"刘胜位为大夫，见礼上宾，而知善不荐，闻恶无言，隐情惜己，自同寒蝉，此罪人也。","book":"《后汉书·杜密传》"},"example":{"text":"他的话完了，台下有几个人拚命地高声鼓掌，而更多的人却～、面面相觑。","book":"杨沫《青春之歌》第二部第三十八章"},"similar":["缄口结舌","守口如瓶","沉默寡言"],"opposite":["口若悬河","侃侃而谈","直言不讳"],"usage":"作谓语、定语、状语；形容害怕不敢说话","story":["汉朝时期河南尹杜密为官清廉，依法办事，因得罪了宦官而免职回到颖川老家，他对国家大事还十分关心，批评刘胜太守退职回家对政事不闻不问，像寒冷天气下的蝉一样，只顾保全自己。汉灵帝时期，杜密重新被启用"]},{"id":12281,"word":"器二不匮","pinyin":"qì èr bù kuì","abbr":"qebk","explanation":"比喻东西有储备，就不怕短缺。","source":{"text":"器二不匮，君二多难。","book":"《左传·哀公六年》"},"similar":["有备无患"],"usage":"作谓语；指作事有准备"},{"id":12282,"word":"器宇不凡","pinyin":"qì yǔ bù fán","abbr":"qybf","explanation":"器宇：指仪表，气度。不凡：不平凡，不寻常。形容仪表、风度很不平常。","source":{"text":"玄德视其人，松形鹤骨，器宇不凡。","book":"明·罗贯中《三国演义》第三十五回"},"example":{"text":"众人见他～，都不敢轻视，见礼让坐。","book":"清·李汝珍《镜花缘》第八十八回"},"similar":["气宇不凡"],"usage":"作谓语、定语；用于人的气势"},{"id":12283,"word":"器宇轩昂","pinyin":"qì yǔ xuān áng","abbr":"qyxa","explanation":"器宇：人的仪表、风度、襟怀；轩昂：精神饱满的样子。形容人精力充沛，风度不凡。","source":{"text":"张昭等见孔明丰神飘洒，器宇轩昂，料到此人必来游说。","book":"明·罗贯中《三国演义》第四十三回"},"example":{"text":"观卿～，门庭雅饰，定然佳士。","book":"清·禇人获《隋唐演义》第七十八回"},"similar":["气宇轩昂"],"usage":"作谓语、定语、状语；指风度不凡"},{"id":12284,"word":"器小易盈","pinyin":"qì xiǎo yì yíng","abbr":"qxyy","explanation":"盈：满。器物小，容易满。原指酒量小。后比喻器量狭小，容易自满。","source":{"text":"小器易盈，先取沈顿。","book":"汉·吴质《在元城与魏太子笺》"},"example":{"text":"若令～，妄自尊大，那些骄傲俗吏看见，真要愧死。","book":"清·李汝珍《镜花缘》第十二回"},"usage":"作谓语、定语；指器局狭小，容易自满"},{"id":12285,"word":"器满则覆","pinyin":"qì mǎn zé fù","abbr":"qmzf","explanation":"容器满溢，则将倾覆。比喻事物发展超过一定界限就会向相反方面转化。亦以喻骄傲自满将导致失败。亦作“器满将覆”。","source":{"text":"物极则复，器满则覆，当断不断，将受其乱。","book":"《新唐书·苏安恒传》"},"similar":["器满将覆"],"usage":"作宾语、定语；用于书面语"},{"id":12286,"word":"器满将覆","pinyin":"qì mǎn jiāng fù","abbr":"qmjf","explanation":"比喻事物发展超过一定界限就会向相反方面转化。亦以喻骄傲自满将导致失败。同“器满则覆”。","source":{"text":"不敢具宾主，若兵备则竟隅侍，鸾晏然受之。人谓其器满将覆矣。","book":"明·沈德符《野获编·兵部·仇鸾谈兵之舛》"},"similar":["器满则覆"],"usage":"作宾语、定语；用于书面语"},{"id":12287,"word":"器满意得","pinyin":"qì mǎn yì dé","abbr":"qmyd","explanation":"骄傲自大、得意忘形的样子。","source":{"text":"毛成翼长，蝉蜕泉壤，便自轩昂，目不步足，器满意得，视人犹芥。","book":"晋·葛洪《抱朴子·刺骄》"},"usage":"作宾语、定语；指人骄傲"},{"id":12288,"word":"器鼠难投","pinyin":"qì shǔ nán tóu","abbr":"qsnt","explanation":"躲在器物旁边的老鼠难以投打。比喻坏人有了庇护就难以制服。","source":{"text":"君言且莫仇，他辙鱼方困，器鼠难投，小哥不要反了面。","book":"明·郑若庸《玉玦记·投贤》"},"similar":["投鼠忌器"],"usage":"作宾语、定语；用于慨叹"},{"id":12289,"word":"噩噩浑浑","pinyin":"è è hún hún","abbr":"eehh","explanation":"指质朴忠厚的样子。指上古之世。","source":{"text":"于是天文地理，皆定位于高高下下之中；孔思周情，各呈露于噩噩浑浑之际。","book":"清·魏源《序》"},"usage":"作定语、宾语；指上古之世"},{"id":12290,"word":"噫呜流涕","pinyin":"yì wū liú tì","abbr":"ywlt","explanation":"噫呜：哭声。噫噫呜呜哭着流泪。","source":{"text":"及与公卿言国家事，未尝不噫呜流涕。","book":"南朝·宋·范晔《后汉书·袁安传》"},"similar":["痛哭流涕"],"opposite":["兴高采烈"],"usage":"作谓语、定语；指哭泣"},{"id":12291,"word":"噬不见齿","pinyin":"shì bù jiàn chǐ","abbr":"sbjc","explanation":"噬：咬；齿：牙齿。凶猛的野兽咬人时不露牙齿。比喻害人者阴险狠毒狡猾，不露凶相。","source":{"text":"夫飞鸟之挚也俯其首，猛兽之攫也匿其爪，虎豹不外其爪而噬不见齿。故用兵之道，示之以柔，而迎之以刚。","book":"《淮南子·兵略训》"}},{"id":12292,"word":"噬指弃薪","pinyin":"shì zhǐ qì xīn","abbr":"szqx","explanation":"噬指：咬手指。指母子眷念的感情。","source":{"text":"顺少孤，养母，尝出求薪，有客卒至，母望顺不还，乃噬其指，顺即心动，弃薪驰归，跪问其故。","book":"南朝·宋·范晔《后汉书·周磐传》"},"example":{"text":"～的故事证明母子心灵可以感应。"},"usage":"作宾语、定语；用于母子","story":["东汉时期，汝南安成人蔡顺以孝闻名天下，他从小失去父亲，靠母亲扶养他成人。一次他外出打柴，家里来了客人找他，蔡母左等右盼不见他回来，就咬自己的手指头，蔡顺心有所感，立即丢掉柴禾跑回家问母亲有什么事"]},{"id":12293,"word":"噬脐何及","pinyin":"shì qí hé jí","abbr":"sqhj","explanation":"噬脐：用嘴咬肚脐。象咬自己肚脐似的，够不着。比喻后悔也来不及。","source":{"text":"若不早图，后君噬齐（脐），其及图之乎？","book":"《左传·庄公六年》"},"example":{"text":"如若抗拒，真火焰昆冈，俱为齑粉，～？","book":"明·许仲琳《封神演义》第四十二回"},"similar":["噬脐莫及","后悔莫及"],"usage":"作谓语、分句；指后悔也来不及","story":["春秋时期，楚文王向邓国借道攻打申国，邓国的国王邓祁侯是楚文王的舅舅，他亲自迎接楚文王，他的儿子要父亲提防这个外甥，可邓祁侯不听，让楚文王攻打申国，可等他灭了申国后回师途中就进攻邓国，邓祁侯真是后悔莫及"]},{"id":12294,"word":"噬脐无及","pinyin":"shì qí wú jí","abbr":"sqwj","explanation":"自咬腹脐够不着。比喻后悔不及。亦作“噬脐莫及”。","source":{"text":"一失其机，噬脐无及。","book":"唐·高彥休《唐阙史·卢相国指挥镇州事》"},"example":{"text":"宜急旋，稍晚，～矣。","book":"明·宋濂《谢烈妇传》"},"similar":["噬脐莫及","噬脐何及"],"usage":"作谓语、定语；指后悔也来不及"},{"id":12295,"word":"噬脐莫及","pinyin":"shì qí mò jí","abbr":"sqmj","explanation":"噬脐：用嘴咬肚脐。象咬自己肚脐似的，够不着。比喻后悔也来不及。","source":{"text":"一失其机，噬脐无及。","book":"唐·高彦休《唐阙史·卢相国指挥镇州事》"},"example":{"text":"若不趁此刻猛省回头，以后虽欲改图，～。","book":"清·林则徐《晓谕粤省士商军民人等速戒鸦片告示稿》"},"similar":["噬脐何及","后悔莫及","噬脐无及"],"usage":"作谓语、定语；指后悔也来不及","story":["春秋时期，楚文王向邓国借道攻打申国，邓国的国王邓祁侯是楚文王的舅舅，他亲自迎接楚文王，他的儿子要父亲提防这个外甥，可邓祁侯不听，让楚文王攻打申国，可等他灭了申国后回师途中就进攻邓国，邓祁侯真是后悔莫及"]},{"id":12296,"word":"噼噼啪啪","pinyin":"pī pī pā pā","abbr":"pppp","explanation":"形容爆裂、拍打等的连续声音。","source":{"text":"形容爆裂、拍打等的连续声音。"},"example":{"text":"地上坑坑洼洼，满是尸体和烧毁了的大炮枪支，烧黑了的军车还在～。","book":"余华《活着》"},"similar":["噼里啪啦"],"usage":"作定语、状语；指爆裂的声音"},{"id":12297,"word":"噼里啪啦","pinyin":"pī lǐ pā lā","abbr":"plpl","explanation":"形容爆裂、拍打等的连续声音。","example":{"text":"大火烧得～的乱响。"},"similar":["劈里啪啦","噼噼啪啪"],"usage":"作定语、状语；指爆裂的声音"},{"id":12298,"word":"嚎啕大哭","pinyin":"háo táo dà kū","abbr":"htdk","explanation":"大声哭叫。","source":{"text":"今日看他悲哀欲绝，心里更加不忍，竟嚎啕大哭起来。","book":"清·曹雪芹《红楼梦》第106回"},"example":{"text":"我情不自禁地～起来。"},"similar":["抱头痛哭","号啕痛哭"],"usage":"作谓语；指哭叫"},{"id":12299,"word":"嚎天动地","pinyin":"háo tiān dòng dì","abbr":"htdd","explanation":"大声哭叫。形容极端悲痛。亦作“嚎天喊地”。","source":{"text":"凤姐儿滚到尤氏怀里，嚎天动地，大放悲声。","book":"《红楼梦》第六八回"},"example":{"text":"里边丈母嚎天喊地的哭。","book":"《儒林外史》第二十回"},"similar":["嚎天喊地","呼天唤地"],"usage":"作谓语、状语；指极端悲痛"},{"id":12300,"word":"嚎天喊地","pinyin":"háo tiān hǎn dì","abbr":"hthd","explanation":"大声哭叫。形容极端悲痛。","source":{"text":"里边丈母嚎天喊地的哭。","book":"《儒林外史》第二十回"},"similar":["呼天喊地","嚎天动地"],"usage":"作谓语、状语；指极端悲痛"},{"id":12301,"word":"嚣张一时","pinyin":"xiāo zhāng yī shí","abbr":"xzys","explanation":"指恶势力在短时间内喧闹一起。","example":{"text":"这帮土匪在这穷山沟也只能～，一待大军到来，他们就会做鸟兽散了。"}},{"id":12302,"word":"嚣浮轻巧","pinyin":"xiāo fú qīng qiǎo","abbr":"xfqq","explanation":"嚣浮：浮夸。形容人不踏实可靠。","source":{"text":"人心嚣浮轻巧。","book":"《新唐书·朱朴传》"},"opposite":["诚实可靠"],"usage":"作谓语、定语；指人轻浮"},{"id":12303,"word":"嚣风遂行","pinyin":"xiāo fēng suì xíng","abbr":"xfsx","explanation":"嚣风：喧闹的风气。指不安静，不遵守纪律的风气逐渐兴盛起来。","source":{"text":"夫厚貌深衷，险如谿壑，择言观行，犹惧弗周，况今万品千群，俄折乎一面，庶僚百位，专断于一司，于是嚣风遂行，不可抑止。","book":"《资治通鉴·宋纪·孝武帝大明二年》"},"usage":"作谓语、定语；用于局面等"},{"id":12304,"word":"嚼墨喷纸","pinyin":"jué mò pēn zhǐ","abbr":"jmpz","explanation":"本是传说，后形容人能写文章。","source":{"text":"班孟者，不知何许人……又能吞墨，舒纸著前，嚼墨喷之，皆成文字，满纸各有意义。","book":"晋·葛洪《神仙传·班孟》"},"usage":"作宾语、定语；用于比喻句"},{"id":12305,"word":"嚼字咬文","pinyin":"jiáo zì yǎo wén","abbr":"jzyw","explanation":"嚼：将食物咬烂。形容过分地斟酌字句。多指死扣字眼而不注意实质。","source":{"text":"讵能嚼字咬文，又何须之乎者也。","book":"清·张南庄《何曲·序》"},"similar":["咬文嚼字","咬文啮字"],"usage":"作谓语、定语、状语；指死扣字眼"},{"id":12306,"word":"嚼穿龈血","pinyin":"jiáo chuān yín xuè","abbr":"jcyx","explanation":"形容十分仇恨。","source":{"text":"想男儿慷慨，嚼穿龈血。","book":"宋·文天祥《满江红·代王夫人作》"},"similar":["咬牙切齿","嚼齿穿龈"],"usage":"作谓语、定语；指十分仇恨"},{"id":12307,"word":"嚼腭搥床","pinyin":"jiáo è chuí chuáng","abbr":"jecc","explanation":"形容极其愤恨。"},{"id":12308,"word":"嚼舌头","pinyin":"jiáo shé tóu","abbr":"jst","explanation":"比喻说是非或者说废话。","source":{"text":"去吧！别嚼舌头了！","book":"成荫《打得好》"},"similar":["嚼舌根"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":12309,"word":"嚼舌头根","pinyin":"jiáo shé tou gēn","abbr":"jstg","explanation":"诅咒的话。把舌头从根部咬下来。表示说了坏话，应该受到这样的惩治。后也用以指顺嘴胡说，搬弄是非。","source":{"text":"哥阿，我不曾骂你，若骂你，就嚼了舌头根。","book":"明·吴承恩《西游记》第三十一回"},"example":{"text":"却说那形容鬼的家婆，叫做醋八姐，是个小人家出身，嘴花捩撇的专喜～。","book":"清·张南庄《何典》"}},{"id":12310,"word":"嚼铁咀金","pinyin":"jiáo tiě jǔ jīn","abbr":"jtjj","explanation":"指说话斩截。"},{"id":12311,"word":"嚼饭喂人","pinyin":"jiáo fàn wèi rén","abbr":"jfwr","explanation":"比喻把经过改写而缺乏新意的作品塞给别人。","source":{"text":"改梵为秦，失其藻蔚，虽得大意，殊隔文体，有似嚼饭与人，非徒失味，乃令人呕哕也。","book":"晋·鸠摩罗什《西方辞体论》"},"example":{"text":"若蹈前人之意，虽字句稍异，仍是前人之作，～，有何趣味？","book":"清·薛雪《一瓢诗话》"}},{"id":12312,"word":"嚼齿穿龈","pinyin":"jiáo chǐ chuān yín","abbr":"jccy","explanation":"齿：牙齿。穿：咬破。龈：牙龈。紧咬牙齿，竟咬破了牙龈。形容对敌人恨之入骨。","source":{"text":"张睢阳生犹骂贼，嚼齿穿龈；颜平原死不忘君，握拳透掌。","book":"宋·苏轼《东坡题跋·偶书》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“颜平原鼓烈气，握拳透爪；张睢阳愤义声，～。”"},"similar":["嚼穿龈血"],"usage":"作谓语、定语；指十分仇恨","story":["唐朝时期，大将张巡守睢阳，被人尊称为“张睢阳”。他作战英勇，而且善于领导。在讨伐安史之乱时，他经常大声呼喊，鼓舞士气，在一次动员大会上，他情绪激昂，嚼齿穿龈"]},{"id":12313,"word":"囊中取物","pinyin":"náng zhōng qǔ wù","abbr":"nzqw","explanation":"囊：口袋。从口袋中取东西。比喻办事毫不费力就可以办到。","source":{"text":"孔明大笑曰：‘吾擒此人，如囊中取物耳。","book":"《三国志通俗演义·诸葛亮二擒孟获》"},"similar":["探囊取物"],"usage":"作宾语、定语；指事情很容易"},{"id":12314,"word":"囊中羞涩","pinyin":"náng zhōng xiū sè","abbr":"nzxs","explanation":"囊：口袋。指口袋中的钱不多了。","source":{"text":"到了最南方的大都市，已是疲惫不堪，囊中羞涩，尝到了孤独的滋味。","book":"王朔《空中小姐》"},"similar":["囊空如洗","床头金尽"],"opposite":["腰缠万贯"],"usage":"作谓语、定语、状语；指缺钱"},{"id":12315,"word":"囊匣如洗","pinyin":"náng xiá rú xǐ","abbr":"nxrx","explanation":"形容异常贫困。","source":{"text":"小人投人不着，囊匣如洗，无面目还乡。","book":"明·凌濛初《二刻拍案惊奇》第11卷"},"similar":["囊空如洗"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；指生活贫困"},{"id":12316,"word":"囊底智","pinyin":"náng dǐ zhì","abbr":"ndz","explanation":"囊：口袋。口袋底下的智谋。指所怀的智谋很多。","source":{"text":"且吾投老，扣囊底智，足以克之。","book":"《魏书·慕容垂传》"},"example":{"text":"富贵何须～，功名无若杯中酒。","book":"元·李孝光《满江红》词"},"usage":"作宾语、定语；用于书面语"},{"id":12317,"word":"囊括四海","pinyin":"náng kuò sì hǎi","abbr":"nksh","explanation":"囊括：比喻统统包罗在内；四海：指全国。指统一全国。","source":{"text":"秦孝公据殽函之固，拥雍州之地，君臣固守，以窥周室，有席卷天下、包举宇内、囊括四海之意，并吞八荒之心。","book":"汉·贾谊《过秦论》"},"example":{"text":"陛下智周万物，～。","book":"唐·吴兢《贞观政要·纳谏》"},"usage":"作谓语、定语；指统一全国","story":["秦始皇统一天下，让人们议论纷纷。汉代贾谊专门写《过秦论》分析秦为什么能统一天下，秦孝公雄心勃勃，支持商鞅变法，使秦国逐渐强大起来。原文如下：“有席卷天下，包举宇内，囊括四海之意，并吞八荒之心。”"]},{"id":12318,"word":"囊括无遗","pinyin":"náng kuò wú yí","abbr":"nkwy","explanation":"囊括：把全部包罗在内。指完全包罗在内，无所遗漏。","source":{"text":"喜则喜空洞能容，为则为囊括无遗。","book":"明·冯惟敏《仙桂引》"},"example":{"text":"其他重要行政之顾问权，土地租借权，均皆～。","book":"李大钊《国民之薪胆》"},"usage":"作谓语、宾语；指全部包括"},{"id":12319,"word":"囊橐充盈","pinyin":"náng tuó chōng yíng","abbr":"ntcy","explanation":"囊橐：泛指口袋；充盈：满。形容身边财物很多。","source":{"text":"不如趁此囊橐充盈，见机而作。","book":"清·李宝嘉《官场现形记》第十八回"},"example":{"text":"好在～，倒也无所顾恋。","book":"清·李宝嘉《官场现形记》第四十一回"},"similar":["囊橐累累"],"opposite":["囊橐萧瑟","囊箧萧条","囊橐萧然"],"usage":"作宾语、定语；用于比喻句"},{"id":12320,"word":"囊橐累累","pinyin":"náng tuó lěi lěi","abbr":"ntll","explanation":"囊橐：口袋。形容身边财产很多。","source":{"text":"换回来日用品再到后方出售，于是一转手间就获利巨万而囊橐累累了。","book":"《上饶集中营·集中营在福建》"},"similar":["囊橐充盈"],"opposite":["囊橐萧瑟","囊箧萧条","囊橐萧然"],"usage":"作宾语、定语；用于比喻句"},{"id":12321,"word":"囊橐萧然","pinyin":"náng tuó xiāo rán","abbr":"ntxr","explanation":"囊橐：口袋。形容缺乏财物，没有什么积蓄。","source":{"text":"以疾归，囊橐萧然，图书数卷而已。","book":"《重修扬州府志》第48卷"},"similar":["囊橐萧瑟","囊箧萧条"],"opposite":["囊橐充盈","囊橐累累"],"usage":"作宾语、定语；用于比喻句"},{"id":12322,"word":"囊橐萧瑟","pinyin":"náng tuó xiāo sè","abbr":"ntxs","explanation":"囊橐：口袋。形容缺乏财物，没有什么积蓄。","source":{"text":"老夫闻知，惟恐被害，逃到外洋。无耐囊橐萧瑟，衣食甚难。","book":"清·李汝珍《镜花缘》第15回"},"similar":["囊橐萧然","囊箧萧条"],"opposite":["囊橐充盈","囊橐累累"],"usage":"作宾语、定语；用于比喻句"},{"id":12323,"word":"囊漏储中","pinyin":"náng lòu chǔ zhōng","abbr":"nlcz","explanation":"常比喻实际利益并未外流。同“囊漏贮中”。","source":{"text":"谚者，直语也……邹鲁公云‘囊漏储中’，皆其类也。","book":"南朝·梁·刘勰《文心雕龙·书记》"},"similar":["囊漏贮中"],"usage":"作宾语、定语；用于比喻句"},{"id":12324,"word":"囊漏贮中","pinyin":"náng lòu zhù zhōng","abbr":"nlzz","explanation":"指粮食从小器漏入大器，其实并未漏掉。常比喻实际利益并未外流。贮，盛米器，大于囊。亦作“囊漏储中”。","source":{"text":"汝知小计而不知大计。周谚曰：‘囊漏贮中。’而独弗闻欤？","book":"汉·贾谊《新书·春秋》"},"example":{"text":"故～，识者不吝；反裘负薪，存毛实难。","book":"《宋书·范泰传》"},"similar":["囊漏储中"],"usage":"作宾语、定语；用于比喻句"},{"id":12325,"word":"囊空如洗","pinyin":"náng kōng rú xǐ","abbr":"nkrx","explanation":"口袋里空得象洗过一样。形容口袋里一个钱也没有。","source":{"text":"我非无此心。但教坊落籍，其费甚多，非千金不可。我囊空如洗，如之奈何？","book":"明·冯梦龙《警世通言》卷三十二"},"example":{"text":"这个月开销太大，不到月底就～了。"},"similar":["身无分文","一贫如洗","不名一文"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；形容人身无分文"},{"id":12326,"word":"囊箧萧条","pinyin":"náng qiè xiāo tiáo","abbr":"nqxt","explanation":"箧：箱子之类；萧条：形容空虚。形容缺少钱财衣物，没有什么积蓄。","source":{"text":"但阿姊千里间关，同郎君远去，囊箧萧条，曾无约束，此乃吾等之事。","book":"明·冯梦龙《警世通言》卷三十二"},"similar":["囊中羞涩","囊橐萧瑟","囊橐萧然"],"opposite":["囊橐充盈","囊橐累累"],"usage":"作宾语、定语；用于比喻句"},{"id":12327,"word":"囊萤映雪","pinyin":"náng yíng yìng xuě","abbr":"nyyx","explanation":"囊萤：晋代车胤少时家贫，夏天以练囊装萤火虫照明读书；映雪：晋代孙康冬天常映雪读书。形容家境贫穷，勤学苦读。","source":{"text":"既笔耕为养，亦拥书成学，至乃集萤映雪，编蒲辑柳。","book":"南朝·梁·任昉《为萧扬州荐士表》"},"example":{"text":"虽无汗马眠霜苦，曾受～芳。","book":"元·贾仲名《萧淑兰》第一折"},"similar":["囊萤照雪"],"usage":"作宾语、定语；指勤学苦读","story":["晋代车胤从小就好学不倦，因家贫没钱买灯油供他晚上读书，在夏夜他见室外飞舞着萤火虫，就用白纱布袋把捉来的萤火虫吊在书本上方，借着微弱的光线进行读书。同朝的孙康因为家贫，雪夜里借着窗外映来的雪光进行读书"]},{"id":12328,"word":"囊萤照书","pinyin":"náng yíng zhào shū","abbr":"nyzs","explanation":"囊萤：把萤火虫放在袋子中。形容家境贫寒，勤苦读书。","source":{"text":"车胤恭勤不倦，博学多通，家贫不常得油，夏月则练囊盛数十萤火以照书，以夜继日焉。","book":"《晋书·车胤传》"},"similar":["囊萤映雪","囊萤照雪","囊萤照读"],"usage":"作谓语、定语；指勤学苦读","story":["晋代车胤从小就好学不倦，但因家贫没钱买灯油供他晚上读书，因此浪费晚上的时间他觉得十分可惜。在一个夏日的夜晚，他见室外到处飞舞着萤火虫，就用白纱布袋把捉来的几十只萤火虫吊在书本的上方，借着微弱的光线进行读书"]},{"id":12329,"word":"囊萤照读","pinyin":"náng yíng zhào shū","abbr":"nyzd","explanation":"用口袋装萤火虫，照着读书。形容家境贫寒，勤苦读书。","source":{"text":"车胤恭勤不倦，博学多通，家贫不常得油，夏月则练囊盛数十萤火以照书，以夜继日焉。","book":"《晋书·车胤传》"},"example":{"text":"古时候曾有“～”、“凿壁偷光”的志士。","book":"鲁迅《且介亭杂文·难行和不信》"},"similar":["囊萤映雪"],"usage":"作谓语、定语；指勤学苦读","story":["晋代车胤从小就好学不倦，但因家贫没钱买灯油供他晚上读书，因此浪费晚上的时间他觉得十分可惜。在一个夏日的夜晚，他见室外到处飞舞着萤火虫，就用白纱布袋把捉来的几十只萤火虫吊在书本的上方，借着微弱的光线进行读书"]},{"id":12330,"word":"囊萤照雪","pinyin":"náng yíng zhào xuě","abbr":"nyzx","explanation":"囊萤：把萤火虫放在袋子中。形容家境贫寒，勤苦读书。","source":{"text":"车胤恭勤不倦，博学多通，家贫不常得油，夏月则练囊盛数十萤火以照书，以夜继日焉。","book":"《晋书·车胤传》"},"similar":["囊萤照读","囊萤映雪"],"usage":"作谓语、定语；指勤学苦读","story":["晋代车胤从小就好学不倦，但因家贫没钱买灯油供他晚上读书，因此浪费晚上的时间他觉得十分可惜。在一个夏日的夜晚，他见室外到处飞舞着萤火虫，就用白纱布袋把捉来的几十只萤火虫吊在书本的上方，借着微弱的光线进行读书"]},{"id":12331,"word":"囊萤积雪","pinyin":"náng yíng jī xuě","abbr":"nyjx","explanation":"囊萤：晋代人车胤收集萤火虫读书；积雪：晋代人孙康映雪读书。形容刻苦攻读，勤学上进。","source":{"text":"便好道君子不重则不威，枉了你穷九经三史诸子百家，不学上古贤人囊萤积雪，凿壁偷光，则学乱作胡为。","book":"元·乔孟符《金钱记》第三折"},"similar":["积雪囊萤","囊萤映雪"],"usage":"作宾语、定语；用于求学等","story":["晋代时期，车胤从小就好学不倦，因家贫没钱买灯油供他晚上读书，在夏夜他见室外飞舞着萤火虫，就用白纱布袋把捉来的萤火虫吊在书本上方，借着微弱的光线进行读书。同朝的孙康因为家贫，雪夜里借着窗外映来的雪光进行读书"]},{"id":12332,"word":"囊血射天","pinyin":"náng xuè shè tiān","abbr":"nxst","explanation":"囊血：盛满血的皮囊；射：射击。将充血的皮囊挂在高处用箭射。比喻暴虐狂妄，犯上作乱。","source":{"text":"为革囊，盛血，仰而射之，命曰‘射天’。","book":"西汉·司马迁《史记·殷本纪》"},"usage":"作谓语、定语；指人狂妄","story":["商朝后期，帝王武乙暴虐无道，搞得天怨人怒。他用木头和泥土制作天神，并与之打斗。还想出一个法子，用皮囊装满一袋血挂在高处，让人在底下往皮囊射箭，弄得血污四溅，腥臭无比。他称这种游戏为“射天”"]},{"id":12333,"word":"囊里盛锥","pinyin":"náng lǐ shèng zhuī","abbr":"nlsz","explanation":"指让有才能的人得到机会表现自己。","source":{"text":"平原君曰：‘夫贤士之处世也，譬若锥之处囊中，其末立见……’毛遂曰：‘臣乃今日请处囊中耳。使遂早得处囊中，乃颖脱而出，非特其末见而已。’","book":"《史记·平原君虞卿列传》"},"example":{"text":"问了三声道，有好男子跟的孙孔目哥哥往泰安神州烧香去，你正是～，尖者自出，我便道我敢去。","book":"元·高文秀《黑旋风》第三折"},"similar":["锥处囊中"],"usage":"作宾语、定语；用于比喻句","story":["战国时期，赵国平原君的门客毛遂主动自荐随同平原君前去与楚王谈判，平原君见他平时没有名气，说：“夫贤士之处世也，譬若锥之处囊中，其末立见。”毛遂说他愿意得处囊中才能脱颖而出。平原君允许他去，结果终于说动楚国出兵抗秦救赵"]},{"id":12334,"word":"囊锥露颖","pinyin":"náng zhuī lù yǐng","abbr":"nzly","explanation":"比喻显露才华。","source":{"text":"始则囊锥露颖，稍有知音；寻则天骥呈才，急于试效。","book":"《旧唐书·高骈传》"},"usage":"作谓语、定语；用于比喻句"},{"id":12335,"word":"囚牛好音","pinyin":"qiú niú hào yīn","abbr":"qnhy","explanation":"囚牛：胡琴头上所刻的兽。刻在胡琴头上的兽，表现出一副喜爱音乐的样子。比喻冒充内行。","source":{"text":"龙生九子，不成龙，各有所好蒲牢好鸣，形钟纽上。囚牛好音，形琴瑟上。","book":"明·陈仁锡《潜确类书》"}},{"id":12336,"word":"囚首丧面","pinyin":"qiú shǒu sàng miàn","abbr":"qssm","explanation":"头不梳如囚犯，脸不洗如居丧。","source":{"text":"囚首丧面而谈诗书，此岂情也哉？","book":"宋·苏洵《辨奸论》"},"example":{"text":"那～衣衫褴褛的乞儿——他们代表世界的悲哀，人间的不幸。","book":"蒋光慈《少年漂泊者》"},"similar":["囚首垢面","蓬头垢面"],"usage":"作谓语、定语；用于人的外表"},{"id":12337,"word":"囚首垢面","pinyin":"qiú shǒu gòu miàn","abbr":"qsgm","explanation":"象监狱里的犯人，好久没有理发和洗脸。形容不注意清洁、修饰。","source":{"text":"莽侍疾，亲尝药，乱首垢面，不解衣带连月。","book":"《汉书·王莽传上》"},"example":{"text":"女又引两青衣械一人至，～。","book":"清·和邦额《夜谭随录·新安富人》"},"similar":["囚首丧面","不修边幅"],"usage":"作谓语、宾语、定语；指人的仪表"},{"id":12338,"word":"四不像","pinyin":"sì bù xiàng","abbr":"sbx","explanation":"麋鹿。比喻不伦不类的事物。","example":{"text":"化妆师把一个个俊俏的男女青年打扮成～的蠢姑娘和傻小子。"},"similar":["不伦不类"],"usage":"作主语、宾语、定语、状语；指不伦不类"},{"id":12339,"word":"四不拗六","pinyin":"sì bù niù liù","abbr":"sbnl","explanation":"指少数人拗不过多数人的意见。","source":{"text":"古语云‘三占从二’，今谚云‘四不拗六’，言贵从众也。","book":"明·杨慎《鲁之郊禘辨》"},"example":{"text":"他～，只好服从了。"},"similar":["少数服从多数"],"usage":"作谓语、分句；指少数人拗不过多数人"},{"id":12340,"word":"四世三公","pinyin":"sì shì sān gōng","abbr":"sssg","explanation":"世：父子相继；三公：执掌朝政的大臣。指世代官居高位。","source":{"text":"《三国志·魏志·袁绍传》记载：汉代袁安在汉章帝刘烜时为司徒，儿子袁敞为司空，孙子袁汤为太尉，曾孙袁逢为司空，袁隗为太傅，四世居三公位，人称“四世三公”。"},"example":{"text":"吾家～，百姓所归；吾效应天顺人，正位九五。","book":"明·罗贯中《三国演义》第十七回"}},{"id":12341,"word":"四乡八镇","pinyin":"sì xiāng bā zhèn","abbr":"sxbz","explanation":"泛指周围的许多乡村和集镇。","source":{"text":"当下统率大队走到乡下，东南西北，四乡八镇。整整兜了一个大圈子。","book":"清·李宝嘉《官场现形记》第14回"},"usage":"作宾语、定语；用于书面语"},{"id":12342,"word":"四书五经","pinyin":"sì shū wǔ jīng","abbr":"sswj","explanation":"四书：亦称四子书，即《大学》、《中庸》、《论语》、《孟子》；五经：《诗》、《书》、《礼》、《易》、《春秋》。指儒家经典。","source":{"text":"汉·班固《白虎通·五经》：“五经何谓？谓《易》、《尚书》、《诗》、《礼》、《春秋》也。”宋·朱熹著有《四书集注》。"},"example":{"text":"君子是只读～，做八股，非常规矩的。","book":"鲁迅《二心集·上海文艺之一瞥》"},"usage":"作主语、宾语、定语；指儒家经典"},{"id":12343,"word":"四亭八当","pinyin":"sì tíng bā dàng","abbr":"stbd","explanation":"亭、当：即停当，妥贴。形容一切事情都安排得十分妥贴。","source":{"text":"不知如何整顿得此身心四亭八当，无许多凹凸也。","book":"宋·朱熹《答吕伯恭书》"},"similar":["四平八稳","四停八当"],"usage":"作谓语、定语；比喻十分妥贴"},{"id":12344,"word":"四会五达","pinyin":"sì huì wǔ dá","abbr":"shwd","explanation":"形容交通极便利。也形容通向各方。","source":{"text":"重江复关之隩，四会五达之庄。","book":"《史记·郦生陆贾列传》：“夫陈留，天下之冲，四通五达之郊也。”南朝·宋·鲍照《芜城赋》"}},{"id":12345,"word":"四体不勤","pinyin":"sì tǐ bù qín","abbr":"stbq","explanation":"四肢不劳动，形容脱离劳动。","source":{"text":"子路问曰：‘子见夫子乎？’丈人曰：‘四体不勤，五谷不分，孰为夫子？’","book":"先秦·孔子《论语·微子》"},"example":{"text":"你也该学一学人家眉妹子，不应～，好逸恶劳。","book":"刘绍棠《瓜棚柳巷》"},"similar":["饱食终日","无所事事"],"opposite":["孜孜不倦","不辞辛劳"],"usage":"作谓语、定语；指脱离劳动","story":["春秋时期，孔子带领弟子周游列国，经历卫、陈、蔡等国的碰壁后，从叶邑出来迷了路，子路前去问路，回来后发现不见了孔子，就问地里耕种的农夫，农夫说：“四体不勤，五谷不分，孰为夫子？”子路发现遇到德高的隐者，只好自己寻找"]},{"id":12346,"word":"四体不勤，五谷不分","pinyin":"sì tǐ bù qín，wǔ gǔ bù fēn","abbr":"stbqwgbf","explanation":"四体：指人的两手两足；五谷：通常指稻、黍、稷、麦、菽。指不参加劳动，不能辨别五谷。形容脱离生产劳动，缺乏生产知识。","source":{"text":"丈人曰：‘四体不勤，五谷不分，孰为夫子？’","book":"《论语·微子》"},"example":{"text":"我们新时代的青年绝不能做～的书呆子。"},"similar":["饱食终日","无所事事"],"opposite":["孜孜不倦","不辞辛劳"],"usage":"作定语、分句；指书呆子","story":["春秋时期，孔子带他的学生子路周游列国宣扬儒家思想，一天子路掉队，遇到一老农，就问其见到他的老师没有？老农说：“四体不勤，五谷不分，孰为夫子？”子路意识到自己的鲁莽就道歉，老农将他领回家。第二天孔子认为老农是位隐士"]},{"id":12347,"word":"四体百骸","pinyin":"sì tǐ bǎi hái","abbr":"stbh","explanation":"人体的各个部分。泛指全身。同“四肢百骸”。","source":{"text":"胎一成，则四体百骸气随欲至，如珠滚荷盘，如烟含柳缕，无不可到之处也。","book":"清·李百川《绿野仙踪》第73回"},"similar":["四肢百骸"],"usage":"作主语、宾语；用于书面语"},{"id":12348,"word":"四停八当","pinyin":"sì tíng bā dāng","abbr":"stbd","explanation":"形容一切事情都安排得十分妥贴。同“四亭八当”。","source":{"text":"须要熟看熟思，久久之间，自然见个道理，四停八当。","book":"宋·朱熹《朱子语类》第11卷"},"similar":["四亭八当"],"usage":"作谓语、定语；比喻十分妥贴"},{"id":12349,"word":"四冲八达","pinyin":"sì chōng bā dá","abbr":"scbd","explanation":"指四通八达的要道。同“四冲六达”。","source":{"text":"然通之为名，盖取譬于道路，四冲八达，无不可至，谓之通也。","book":"清·章学诚《文史通义·横通》"},"similar":["四通八达","四冲六达"],"usage":"作宾语、定语；用于书面语"},{"id":12350,"word":"四冲六达","pinyin":"sì chōng liù dá","abbr":"scld","explanation":"指四通八达的要道。","source":{"text":"徐地东近齐鲁，北属赵魏，南引江淮，西通梁宋，四冲六达之郊，南北之亢颈也。","book":"宋·陈师道《徐州学纪》"},"similar":["四冲八达"],"usage":"作宾语、定语；用于书面语"},{"id":12351,"word":"四分五剖","pinyin":"sì fēn wǔ pōu","abbr":"sfwp","explanation":"四分五裂。形容分散，不统一。","source":{"text":"往者周网解结，群鹿争逸，离为十二，合为六七，四分五剖，并为战国。","book":"汉·扬雄《解嘲》"},"example":{"text":"清·曾国藩《李忠武公神道碑铭》：“～，精锐军散。”"},"similar":["四分五裂"],"usage":"作谓语、定语、状语；用于局面等"},{"id":12352,"word":"四分五落","pinyin":"sì fēn wǔ luò","abbr":"sfwl","explanation":"形容分散零乱。","source":{"text":"蓦闻人道，森森地唬得魂离壳。全家眷爱，多应是四分五落。","book":"金·董解元《西厢记诸宫调》卷二"},"example":{"text":"霎时间大火竟起，烈焰飞天，～，都穿在大船内。前后官船，一齐烧着。","book":"明·施耐庵《水浒传》第七十九回"},"similar":["四纷五落"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":12353,"word":"四分五裂","pinyin":"sì fēn wǔ liè","abbr":"sfwl","explanation":"形容不完整，不集中，不团结，不统一。","source":{"text":"张仪为秦连横说魏王曰：‘魏南与楚而不与齐，则齐攻其东；东与齐而不与赵，则赵攻其北；不合于韩，是韩攻其西；不亲于楚，则楚攻其南：此所谓四分五裂之道也。’","book":"《战国策·魏策一》"},"example":{"text":"故其端起于大夫士之怙私，而其祸可至于亡国灭种，～，而不可收拾。","book":"严复《论世变之亟》"},"similar":["支离破碎","一盘散沙","四分五剖"],"opposite":["万众一心"],"usage":"作谓语、定语、状语；用于政治等","story":["战国后期，秦国经过商鞅变法后日益强大，其他诸侯国害怕秦国强大就采取“合纵”的办法联合抗秦。秦惠王任用魏国人张仪为相，到各国宣扬“连横”的策略，离间六国，威胁和引诱六国依附秦国。在张仪的活动下，六国联盟马上四分五裂"]},{"id":12354,"word":"四塞之固","pinyin":"sì sài zhī gù","abbr":"sszg","explanation":"原形容国境线四面地势险要，易守难攻。后泛指地势险要坚固的地方。","source":{"text":"是故始皇因四塞之固，据崤、函之阻，跨陇、蜀之饶，听众人之策，乘六世之烈，以蚕食六国，兼战后，并有天下。","book":"《战国策·书录》"},"example":{"text":"陕西既归，得地数千里，得兵十三万，得马二万，有～，居天下上游，可谓强盛。","book":"清·毕沅《续资治通鉴》卷一百二十二"}},{"id":12355,"word":"四壁萧然","pinyin":"sì bì xiāo rán","abbr":"sbxr","explanation":"四壁：四面墙壁；萧然：寂寞冷落。屋里空荡荡的，没什么东西。形容生活非常贫困。","source":{"text":"有金可散还多事，四壁萧然计未疏。","book":"宋·陆游《题庵壁》"},"example":{"text":"房中～，除一张竹几外，只地下三个蒲团。","book":"金庸《射雕英雄传》第三十回"}},{"id":12356,"word":"四大皆空","pinyin":"sì dà jiē kōng","abbr":"sdjk","explanation":"四大：古印度称地、水、火风为“四大”。佛教用语。指世界上一切都是空虚的。是一种消极思想。","source":{"text":"佛言当念身中四大，各自有名，都无我者。","book":"《四十二章经》二十"},"example":{"text":"胞胎浑沌，～，没甚姓名。","book":"清·陈忱《水浒后传》第三十一回"},"similar":["心无杂念"],"usage":"作谓语、宾语；指无牵无挂"},{"id":12357,"word":"四姻九戚","pinyin":"sì yīn jiǔ qī","abbr":"syjq","explanation":"比喻亲戚极多。"},{"id":12358,"word":"四山五岳","pinyin":"sì shān wǔ yuè","abbr":"sswy","explanation":"泛指四面八方各个地区。","source":{"text":"引一千余军马，尽是七长八短汉，四山五岳人。","book":"明·施耐庵《水浒传》第63回"},"example":{"text":"清·曹雪芹《红楼梦》第50回：“他从小儿见的世面倒多，跟他父亲～都走遍了。”"},"similar":["三山五岳"],"usage":"作宾语、定语；用于地理等"},{"id":12359,"word":"四平八稳","pinyin":"sì píng bā wěn","abbr":"spbw","explanation":"原形容身体各部位匀称、结实。后常形容说话做事稳当。也形容做事只求不出差错，缺乏积极创新精神。","source":{"text":"戴宗、杨林看裴宣时，果然好表人物，生得面白肥胖，四平八稳，心中暗喜。","book":"明·施耐庵《水浒全传》第四十四回"},"example":{"text":"总而言之，现在倘再发那些～的“救救孩子”似的议论，连我自己听去，也觉得空空洞洞了。","book":"鲁迅《而已集·答有恒先生》"},"similar":["老成持重","稳扎稳打"],"opposite":["轻举妄动","操之过急"],"usage":"作谓语、定语、补语；指平稳"},{"id":12360,"word":"四德三从","pinyin":"sì dé sān cóng","abbr":"sdsc","explanation":"封建礼教束缚妇女的道德标准之一。","source":{"text":"九嫔掌妇学之法，以九教御：妇德、妇言、妇容、妇功。","book":"《仪礼·丧服·子夏传》：“妇人有三从之义，无专用之道。故未嫁从父，既嫁从夫，夫死从子。”《周礼·天官·九嫔》"},"example":{"text":"娶了个～宰相女，平生愿足，托赖著众亲故。","book":"元·王实甫《西厢记》第五本第四折"},"similar":["三从四德"],"usage":"作主语、宾语、定语；指封建礼教"},{"id":12361,"word":"四战之国","pinyin":"sì zhàn zhī guó","abbr":"szzg","explanation":"指四面平坦，无险可守，容易受攻击的地方。","source":{"text":"赵，四战之国也，其民习兵，伐之不可。","book":"《商君书·兵守》：“四战之国贵守战，负海之国贵攻战。”《史记·乐毅列传》"},"example":{"text":"西汉·司马迁《史记·乐毅列传》：“赵，～也，其民习兵，伐之不可。”"},"usage":"作主语、宾语；用于书面语"},{"id":12362,"word":"四战之地","pinyin":"sì zhàn zhī dì","abbr":"szzd","explanation":"指四面平坦，无险可守，容易受攻击的地方。","source":{"text":"赵，四战之国也，其民习兵，伐之不可。","book":"西汉·司马迁《史记·乐毅列传》"},"example":{"text":"颖川，～也，天下有变，常为兵冲。","book":"南朝·宋·范晔《后汉书·荀彧传》"},"similar":["四战之国"],"usage":"作宾语；指容易受攻击的地方","story":["战国时期，上将军乐毅为燕昭王扩大疆土，攻占齐国70多座城池，被封为昌国君。燕惠王中了齐国人田单的反间计，乐毅受到诬陷，逃到赵国去。齐国趁机修复失地，燕惠王问乐毅的儿子能否攻赵，乐闲认为赵国是四战之地不宜攻"]},{"id":12363,"word":"四方之志","pinyin":"sì fāng zhī zhì","abbr":"sfzz","explanation":"指志向远大。","source":{"text":"子有四方之志，其闻之者，吾杀之矣。","book":"《左传·僖公二十三年》"}},{"id":12364,"word":"四方云扰","pinyin":"sì fāng yún rǎo","abbr":"sfyr","explanation":"扰：扰乱，纷扰。指天下纷乱，如同乌云翻涌。形容局势动荡不安，到处骚乱。","source":{"text":"今汉室倾危，四方云扰，孤承父兄余业，思有桓文之功。","book":"《三国志·吴志·鲁肃传》"},"example":{"text":"方今天下大乱，～，欲见孔明，求安邦定国之策耳。","book":"明·罗贯中《三国演义》第三十七回"}},{"id":12365,"word":"四方八面","pinyin":"sì fāng bā miàn","abbr":"sfbm","explanation":"到处；各个方面。","source":{"text":"莫问早行奇绝处，四方八面野香来。","book":"宋·释道原《景德传灯录·怀岳禅师》：“忽遇四方八面来怎么生？”宋·杨万里《过百家渡四绝句》之二"},"example":{"text":"多种族，如弟兄，～自由风。","book":"郭沫若《新华颂》"},"similar":["四面八方"],"usage":"作主语、宾语、定语；形容范围广"},{"id":12366,"word":"四方离乱","pinyin":"sì fāng lí luàn","abbr":"sfll","explanation":"四方：天下，各处。指到处发生割据，战乱。","source":{"text":"如今四方离乱，民遭涂炭，士民荒凉。","book":"元·刘唐卿《白兔记》第十五出"}},{"id":12367,"word":"四方辐辏","pinyin":"sì fāng fú còu","abbr":"sffc","explanation":"比喻四方的人才或货物像车轮上的辐条聚集在毂上那样汇集到一处。后引申为从各方聚集的意思。","source":{"text":"人人奉职，四方辐辏。","book":"《汉书·孙叔通传》"}},{"id":12368,"word":"四时之气","pinyin":"sì shí zhī qì","abbr":"sszq","explanation":"本指一年四季的气象，后以“备四时之气”喻指人的气度弘远。","source":{"text":"谢太傅绝重褚公，常称褚季野虽不言而四时之气亦备。","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"唐·李白《任城县厅壁记》：“季野备～，士元非百里之才。”"},"usage":"作主语、宾语；用于书面语"},{"id":12369,"word":"四时充美","pinyin":"si shi chong mei","abbr":"sscm","explanation":"一年四季都很富足美好。"},{"id":12370,"word":"四时八节","pinyin":"sì shí bā jié","abbr":"ssbj","explanation":"四时：指春夏秋冬四季；八节：指立春、春分、立夏、夏至、立秋、秋分、立冬、冬至。泛指一年四季中各节气。","source":{"text":"四时八节还拘礼，女拜弟妻男拜弟。","book":"唐·马总《意林》卷一引《隋巢子》：“鬼神为四时八节以纪育人。”唐·杜甫《短歌行赠四兄》诗"},"example":{"text":"～，企其祭祀，祭祀既不精，即为祸患。","book":"宋·张君房《云笈七签》卷八十一"},"usage":"作主语、宾语、定语；指季节"},{"id":12371,"word":"四时气备","pinyin":"sì shí qì bèi","abbr":"ssqb","explanation":"四时：春、夏、秋、冬。四时之气具备。比喻人的气度弘远。","source":{"text":"谢太傅绝重褚公，常称褚季野虽不言而四时之气亦备。","book":"南朝·宋·刘义庆《世说新语·德行》"},"usage":"作谓语、定语；用于书面语"},{"id":12372,"word":"四海一家","pinyin":"sì hǎi yī jiā","abbr":"shyj","explanation":"四海之内，犹如一家。形容天下一统。","source":{"text":"四海之内若一家，通达之属莫不从服。","book":"战国·赵·荀况《荀子·议兵》"},"example":{"text":"清·吴敬梓《儒林外史》第39回：“而今是～的时候，任你荆轲、聂政，也只好叫做乱民。”"},"similar":["天下一统"],"opposite":["四分五裂","支离破碎"],"usage":"作谓语、定语；用于局面等"},{"id":12373,"word":"四海为家","pinyin":"sì hǎi wéi jiā","abbr":"shwj","explanation":"原指帝王占有全国。后指什么地方都可以当作自己的家。指志在四方，不留恋家乡或个人小天地。","source":{"text":"且夫天子以四海为家。","book":"《汉书·高帝记》"},"example":{"text":"我们是～的，我们是以一切人民为兄弟姐妹的。","book":"孙犁《看护》"},"similar":["浪迹天涯","远走高飞"],"opposite":["安土重迁"],"usage":"作谓语、定语；指志在四方","story":["汉高祖刘邦经过几年征战，终于完成统一大业，命令相国萧何建设新都城长安。公元前200年，新都建成，皇宫修得富丽堂皇，雄伟壮观。刘邦见皇宫金壁辉煌，十分生气，萧何说：“皇上以四海为家，宫室修得庄严雄伟，可以使四方臣服”"]},{"id":12374,"word":"四海之内皆兄弟","pinyin":"sì hǎi zhī nèi jiē xiōng dì","abbr":"shznjxd","explanation":"四海：指全国。全国的人民都象兄弟一样。","source":{"text":"君子敬而无失，与人恭而有礼，四海之内，皆兄弟也。","book":"《论语·颜渊》"},"example":{"text":"～也，便收了罢。","book":"明·徐渭《英烈传》第六回"},"similar":["四海皆兄弟"],"usage":"作分句；指亲如一家","story":["春秋时期，孔子的弟子司马牛问孔子怎样做君子，孔子说君子不忧愁，不害怕，经常反省自己。司马牛见到师兄子夏后忧愁地说自己没有兄弟。子夏安慰他说君子和人交往态度恭瑾而合乎礼节，那么普天之下到处都是兄弟"]},{"id":12375,"word":"四海九州","pinyin":"sì hǎi jiǔ zhōu","abbr":"shjz","explanation":"指全中国。","source":{"text":"那人王乃四海九州之主，代天宣化，岂肯颠倒，强人所难。","book":"清·李汝珍《镜花缘》第二回"},"example":{"text":"清·无垢道人《八仙全传》第16回：“顶快的腾云每天才能游遍～。”"},"similar":["神州赤县","五湖四海"],"usage":"作宾语、定语；用于书面语"},{"id":12376,"word":"四海他人","pinyin":"sì hǎi tā rén","abbr":"shtr","explanation":"指没有亲戚关系。","source":{"text":"俺虽然是旧忠臣，则是四海他人。","book":"元·尚仲贤《三夺槊》第三折"},"usage":"作宾语、定语；用于书面语"},{"id":12377,"word":"四海升平","pinyin":"sì hǎi shēng píng","abbr":"shsp","explanation":"升平：太平。指天下太平。","source":{"text":"一、位当五行图箓之序；二、时会四海升平之运；三、德具钦明文思之美。是谓与天合符，名不死矣。","book":"唐·张说《大唐封禅颂》"},"example":{"text":"寡人御极以来，幸喜～，八方宁靖。","book":"元·无名氏《抱妆盒》第三折"},"similar":["天下太平"],"opposite":["四海鼎沸"],"usage":"作谓语、定语；指天下太平"},{"id":12378,"word":"四海困穷","pinyin":"sì hǎi kùn qióng","abbr":"shkq","explanation":"天下的人民困苦贫穷。","source":{"text":"四海困穷，天禄永终。","book":"《尚书·大禹漠》"},"example":{"text":"汉文帝承秦、项战争之后，～，天子不能具钧驷，乃示以敦朴，身衣弋绨，足履革舄，未几天下富安，四夷咸服。","book":"《金史·陈规传》"}},{"id":12379,"word":"四海承平","pinyin":"sì hǎi chéng píng","abbr":"shcp","explanation":"承平：太平。指全国境内在一个相当长的时间内太平无事。","source":{"text":"孝武纂极，四海承平。志尚奢丽，尤敬神明。","book":"《史记·孝武本纪》"},"example":{"text":"当今～，万方朝贡，有什么紧急事情，这等大惊小怪？","book":"清·褚人获《隋唐演义》第二十九回"},"similar":["天下承平"],"opposite":["天下大乱"],"usage":"作谓语、定语；用于局面等"},{"id":12380,"word":"四海承风","pinyin":"sì hǎi chéng fēng","abbr":"shcf","explanation":"指全国都接受教化。","source":{"text":"舜之为君也，其政好生而恶杀，……是以四海承风。","book":"《孔子家语·好生》"},"usage":"作谓语；指全国都接受教化"},{"id":12381,"word":"四海昇平","pinyin":"sì hǎi shēng píng","abbr":"shsp","explanation":"指天下太平。"},{"id":12382,"word":"四海昻平","pinyin":"sì hǎi shēng píng","abbr":"shsp","explanation":"指天下太平。"},{"id":12383,"word":"四海晏然","pinyin":"sì hǎi yàn rán","abbr":"shyr","explanation":"四海：天下，国家；晏然：平静，安定。指全国各地太平安定。","source":{"text":"陛下圣德系兴，再隆大命，即位以来，四海晏然。","book":"《后汉书·蔡茂传》"},"example":{"text":"自朕嗣位以来，～，八方宁静。","book":"元·马致远《汉宫秋》楔子"}},{"id":12384,"word":"四海波静","pinyin":"sì hǎi bō jìng","abbr":"shbj","explanation":"比喻天下太平。"},{"id":12385,"word":"四海皆兄弟","pinyin":"sì hǎi jiē xiōng dì","abbr":"shjxd","explanation":"世界各国的人民都象兄弟一样。同“四海之内皆兄弟”。","source":{"text":"［净］人生四海皆兄弟，蓬荜生辉不我违。","book":"清·方成培《雷峰塔·再访》"},"example":{"text":"清·荑荻散人《玉娇梨》第六回：“穿绿的道：‘～，这个何妨。’”"},"similar":["四海之内皆兄弟"],"usage":"作宾语、定语、分句；用于口语"},{"id":12386,"word":"四海飘零","pinyin":"sì hǎi piāo líng","abbr":"shpl","explanation":"四海：代指全国各地。飘零：比喻遭到不幸，失去依靠，生活不安定。指到处飘泊，生活无着。","source":{"text":"云几番欲来相投，只恐袁绍见怪。四海飘零，无容身之地。前偶过此处，适遇裴元绍下山来欲夺吾马，云因杀之，借此安身。","book":"明·罗贯中《三国演义》第二十八回"}},{"id":12387,"word":"四海鼎沸","pinyin":"sì hǎi dǐng fèi","abbr":"shdf","explanation":"四海：古人以为中国四境有海环绕，用以指全国各地；鼎沸：比喻局势不安定，如同鼎水沸腾。形容天下大乱。","source":{"text":"若四海鼎沸，豪杰并起，吾与足下，当相避于中原耳。","book":"《晋书·祖逖传》"},"example":{"text":"今江都篡逆，～。","book":"《旧唐书·李袭志传》"},"similar":["天下大乱"],"opposite":["四海升平"],"usage":"作宾语、定语；指天下大乱"},{"id":12388,"word":"四清六活","pinyin":"sì qīng liù huó","abbr":"sqlh","explanation":"形容机灵干练。","source":{"text":"何涛道：‘这几个都是久惯做公的，四清六活的人，却怎地也不晓事，如何不着一只船转来回报？不想这些带来的官兵，人人亦不知颠倒’","book":"明·施耐庵《水浒传》第十九回"},"usage":"作谓语、定语；指人机灵"},{"id":12389,"word":"四百四病","pinyin":"sì bǎi sì bìng","abbr":"sbsb","explanation":"指四肢百体的四时病痛。泛指各种疾病。","source":{"text":"学究用手揭起匣盖，只有文书一卷，取出看罢，即是医治四百四病之书。","book":"《三国志平话》上卷"},"example":{"text":"明·洪楩《清平山堂话本·花莲轿蓬女或佛记》：“～人可守，惟有相思难受。”"},"usage":"作宾语、定语；用于书面语"},{"id":12390,"word":"四离五散","pinyin":"sì lí wǔ sàn","abbr":"slws","explanation":"表示不在一起，四散分离。","example":{"text":"打起仗，一家人就～了，亲娘老子也见不上自己的儿女。","book":"杜鹏程《保卫延安》第二章五"}},{"id":12391,"word":"四纷五落","pinyin":"sì fēn wǔ luò","abbr":"sfwl","explanation":"形容分散零乱。同“四分五落”。","source":{"text":"刘繇军兵大败，众皆四纷五落。","book":"明·罗贯中《三国演义》第15回"},"similar":["四分五落"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":12392,"word":"四维不张","pinyin":"sì wéi bù zhāng","abbr":"swbz","explanation":"四维：旧时称礼、义、廉、耻为四维；张：展开，推行。四维不能伸张。比喻纲纪废弛，政令不行。","source":{"text":"四维不张，国乃灭亡。","book":"《管子·牧民》"},"example":{"text":"礼义廉耻，国之四维。～，国乃灭亡。今日君欲立国之纲纪，必张四维，以使其民。","book":"明·冯梦龙《东周列国志》第十六回"}},{"id":12393,"word":"四肢百体","pinyin":"sì zhī bǎi tǐ","abbr":"szbt","explanation":"人体的各个部分。泛指全身。同“四肢百骸”。","source":{"text":"赵子曰四肢百体一齐往外涨，差一些没把大袄，幸亏是新买的，撑开了绽。","book":"老舍《赵子曰》"},"similar":["四肢百骸","四体百骸"],"usage":"作主语、宾语；用于书面语"},{"id":12394,"word":"四肢百骸","pinyin":"sì zhī bǎi hái","abbr":"szbh","explanation":"人体的各个部分。泛指全身。","source":{"text":"四肢与百骸，屈曲如杯锩。","book":"宋·文天祥《高沙道中》诗"},"similar":["四体百骸","四肢百体"],"usage":"作主语、宾语；用于书面语"},{"id":12395,"word":"四脚朝天","pinyin":"sì jiǎo cháo tiān","abbr":"sjct","explanation":"四脚：指四肢。形容仰面跌倒。也形容人死去。","source":{"text":"叫声未绝，早被大鹏一嘴啄得四脚朝天，呜呼哀哉。","book":"清·钱彩《说岳全传》第一回"},"example":{"text":"这完这句，便～，一声不言语了。（清·李宝嘉《官场现形记》第三十回）"},"similar":["仰面朝天"],"opposite":["面朝黄土背朝天"],"usage":"作状语、宾语；指仰面跌倒"},{"id":12396,"word":"四至八道","pinyin":"sì zhì bā dào","abbr":"szbd","explanation":"旧时标志土地界域的用语。表示四面八方所到之处及通往的道路。","source":{"text":"安营既毕，便画四至八道地理形状图本来我看。","book":"明·罗贯中《三国演义》第95回"},"example":{"text":"清·俞万春《荡寇志》第71回：“何道士就在空地上安放了罗经，打了响桩，另画了～的界限。”"},"usage":"作宾语、定语；旧时地界标志"},{"id":12397,"word":"四荒八极","pinyin":"sì huāng bā jí","abbr":"shbj","explanation":"四面八方极偏远之地。","source":{"text":"四荒八极，毕贽琛珍。","book":"唐·白居易《八骏图》诗：“四荒八极踏欲遍，三十二蹄无歇时。”前蜀·杜光庭《寿春节进元始天尊帧并功德疏表》"},"example":{"text":"前蜀·杜光庭《寿春节进元始天尊帧并功德疏表》：“～，毕贽琛珍。”"},"usage":"作主语、宾语、定语；用于书面语"},{"id":12398,"word":"四衢八街","pinyin":"sì qú bā jiē","abbr":"sqbj","explanation":"指大城市街道非常多。"},{"id":12399,"word":"四角俱全","pinyin":"sì jiǎo jù quán","abbr":"sjjq","explanation":"比喻完美无缺。","source":{"text":"若要外头说去，老太太断不中意，不如把你林妹妹定给他，岂不四角俱全？","book":"清·曹雪芹《红楼梦》第57回"},"similar":["完美无缺"],"usage":"作谓语、定语；用于书面语"},{"id":12400,"word":"四近之臣","pinyin":"sì jìn zhī chén","abbr":"sjzc","explanation":"四近：四辅，古代天子身边的四个辅臣。旧指辅佐天子的四位大臣。喻指皇帝身边的近臣。","source":{"text":"王者前有疑，后有丞，左有辅，右有弼，谓之四近。言前后左右近臣，当畏敬之，不可以非其人也。","book":"《孔丛子·论书》"}},{"id":12401,"word":"四通五达","pinyin":"sì tōng wǔ dá","abbr":"stwd","explanation":"形容交通极便利。也形容通向各方。","source":{"text":"夫陈留，天下之冲，四通五达之郊也。","book":"《史记·郦生陆贾列传》"},"example":{"text":"宋·洪迈《容斋随笔·地险》：“唯宋卫之郊，～，无一险可恃。”"},"similar":["四通八达"],"usage":"作谓语、定语；指道路等"},{"id":12402,"word":"四通八达","pinyin":"sì tōng bā dá","abbr":"stbd","explanation":"四面八方都有路可通。形容交通极便利。也形容通向各方。","source":{"text":"其途之所出，四通而八达，游士之所凑也。","book":"《子华子·晏子问党》"},"example":{"text":"滑台～，非帝王之所居。","book":"《晋书·慕容德载记》"},"similar":["畅行无阻","六通四达"],"opposite":["水泄不通"],"usage":"作谓语、定语；指道路等"},{"id":12403,"word":"四通辐辏","pinyin":"sì tōng fú còu","abbr":"stfc","explanation":"辐辏：车辐凑集于毂上。比喻四方人才或货物像车辐聚于毂上一样地汇集在一起。","source":{"text":"地四平，诸侯四通辐辏，无名山大川之限。","book":"《史记·张仪列传》"}},{"id":12404,"word":"四邻不安","pinyin":"sì lín bù ān","abbr":"slba","explanation":"指周围的人都受到干扰，不得安宁。","example":{"text":"连日带夜地大呼小叫，吵得～，房间里酒气熏天，烟雾腾腾，走都走不进去。","book":"吴越《九死还魂草》第五十章"}},{"id":12405,"word":"四邻八舍","pinyin":"sì lín bā shè","abbr":"slbs","explanation":"指左右邻居。","source":{"text":"那成家一般也动了诸亲百眷、四邻八舍，送人情，斗分子，虽然娶妾，倒也四司六局，一毫不苟。","book":"明·伏雌教主《醋葫芦》第六回"},"example":{"text":"某些爱显能的婆姨还端着自己新收的东西，吆喝着送给～，夸耀自己的光景日月过得如何红火。","book":"路遥《平凡的世界》第六卷第34章"},"similar":["左邻右舍"],"usage":"作宾语、定语；用于口语"},{"id":12406,"word":"四郊多垒","pinyin":"sì jiāo duō lěi","abbr":"sjdl","explanation":"垒：营垒。敌军四面逼近，形势危急。也比喻竞争的对手多。","source":{"text":"四郊多垒，此卿大夫之辱也。","book":"《礼记·曲礼上》"},"example":{"text":"如果都象他们似的定要吃饭，在这～的时候，那里来这许多饭？（鲁迅《华盖集·牺牲谟》）"},"similar":["四面楚歌"],"usage":"作定语；指敌军四面逼近，形势危急"},{"id":12407,"word":"四面八方","pinyin":"sì miàn bā fāng","abbr":"smbf","explanation":"指各个方面或各个地方。","source":{"text":"忽遇四面八方怎么生？","book":"宋·释道原《景德传灯录》卷二十"},"example":{"text":"你们瞧见了，然后连皮带骨，一概都化成一股灰，再化一股烟，一阵大风，吹的～，都登时散了。","book":"清·曹雪芹《红楼梦》第五十七回"},"similar":["五湖四海"],"opposite":["一步之遥"],"usage":"作主语、宾语、定语；形容范围广"},{"id":12408,"word":"四面出击","pinyin":"sì miàn chū jī","abbr":"smcj","explanation":"形容工作全面展开，没有重点。","source":{"text":"总之不要四面出击。四面出击，全国紧张，很不好。","book":"毛泽东《不要四面出击》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":12409,"word":"四面受敌","pinyin":"sì miàn shòu dí","abbr":"smsd","explanation":"各个方面受到敌对势力的威胁或攻击。","source":{"text":"四面受敌，谓之衢处之国。","book":"春秋·齐·管仲《管子·国蓄》"},"example":{"text":"鲁迅《题记》：“记得当时的《新青年》是正在～之中，我所对付的不过一小部分。”"},"similar":["四面楚歌"],"usage":"作宾语、定语；用于局面等"},{"id":12410,"word":"四面楚歌","pinyin":"sì miàn chǔ gē","abbr":"smcg","explanation":"比喻陷入四面受敌、孤立无援的境地。","source":{"text":"项王军壁垓下，兵少食尽，汉军及诸侯兵围之数重。夜闻汉军四面皆楚歌，项王乃大惊，曰：‘汉皆已得楚乎？是何楚人之多也。’","book":"《史记·项羽本纪》"},"example":{"text":"在这～里，凭你怎样伶牙俐齿，也只得服从了。","book":"朱自清《航船中的文明》"},"similar":["腹背受敌","山穷水尽"],"opposite":["安然无恙","旗开得胜"],"usage":"作定语、状语；指孤立无援","story":["楚汉相争时期，项羽攻占秦都以后，烧杀掳掠，人民怨声载道。汉王刘邦趁机出击想衣锦还乡的项羽，让大军把项羽围在垓下，并设下“四面楚歌”之计，项羽以为汉军已经攻占楚地，以为天要灭他，只好边饮酒边唱歌，悲壮自刎身亡"]},{"id":12411,"word":"四面碰壁","pinyin":"sì miàn pèng bì","abbr":"smpb","explanation":"比喻遇受阻碍或遭到拒绝。也指事情行不通或达不到目的。","example":{"text":"她～，陷入绝境，我们得帮她了。"},"similar":["到处碰壁"],"usage":"作谓语、定语、状语；用于人的处境"},{"id":12412,"word":"四马攒蹄","pinyin":"sì mǎ cuán tí","abbr":"smct","explanation":"指两手两脚被捆在一起。","source":{"text":"叫：‘小的们，拿绳来！’众头目即取绳索。三怪把行者扳翻倒，四马攒蹄捆住，揭起衣裳看时，足足是个弼马温。","book":"明·吴承恩《西游记》第七十五回"},"example":{"text":"父女二人便把灯来照看，一齐动手，把那衙内同孙高、薛宝都洗剥了上盖衣服，连那两个亲随，都～，紧紧的捆了。","book":"清·俞万春 《荡寇志》第七十四回"},"usage":"作谓语、宾语、分句；指被绑"},{"id":12413,"word":"回光反照","pinyin":"huí guāng fǎn zhào","abbr":"hgfz","explanation":"指日落时由于反射作用而天空中短时发亮。比喻人死前精神突然兴奋。也比喻事物灭亡前夕的短暂兴旺。","source":{"text":"阳台雾锁，楚岫云遮，弃死归生，回光返照。","book":"元·杨暹《刘行首》第三折"},"example":{"text":"我看这群浑蛋都有点～，长不了。","book":"老舍《茶馆》第三幕"},"similar":["回光返照"],"usage":"作谓语、定语、状语；用于事物灭亡前夕"},{"id":12414,"word":"回光返照","pinyin":"huí guāng fǎn zhào","abbr":"hgfz","explanation":"指太阳刚落山时，由于光线反射而发生的天空中短时发亮的现象。比喻人死前精神突然兴奋。也比喻事物灭亡前夕的表面兴旺。","source":{"text":"诸禅德若能一念回光返照，到自己脚跟下，褫剥究竟，将来可谓洞门豁开，楼阁重重，十分普视，海会齐彰。","book":"宋·释普济《五灯会元·黄龙南禅师法嗣》"},"example":{"text":"所以唐末宋初，骈体文又～了一下。","book":"朱自清《经典常谈·文第十三》"},"similar":["回光反照"],"opposite":["生机勃勃"],"usage":"作谓语、定语、状语；用于事物灭亡前夕","story":["贾宝玉失了命根子“通灵宝玉”后失魂落魄、疯疯癫癫。贾母和王夫人决定让他娶薛宝钗来冲喜。这对林黛玉是当头一棒，气得直吐鲜血，从此一蹶不振，面无血色。在宝玉结婚的当晚，林黛玉也一病不起，回光返照时间不长，郁闷而死"]},{"id":12415,"word":"回味无穷","pinyin":"huí wèi wú qióng","abbr":"hwwq","explanation":"回味：指吃过东西以后的余味。比喻回想某一事物，越想越觉得有意思。","source":{"text":"良久有回味，始觉甘如饴。","book":"宋·王禹偁《橄榄》诗"},"example":{"text":"这篇文章含义深刻，使人～。"},"similar":["耐人寻味"],"opposite":["索然无味","味如嚼蜡"],"usage":"作谓语、宾语、补语；指回想过去有意义的事"},{"id":12416,"word":"回嗔作喜","pinyin":"huí chēn zuò xǐ","abbr":"hczx","explanation":"嗔：生气。由生气转为喜欢。","source":{"text":"这两个孩儿，要在他手里过日子，只得回嗔作喜。","book":"元·李致远《还牢末》第一折"},"example":{"text":"邓九公听太鸾之言，～。","book":"明·许仲琳《封神演义》第五十六回"},"similar":["破涕为笑","回瞋作喜"],"usage":"作谓语；指转怒为喜"},{"id":12417,"word":"回天之力","pinyin":"huí tiān zhī lì","abbr":"htzl","explanation":"原比喻言论正确，极有力量，影响深远。现多比喻能挽回严重局势的力量。","source":{"text":"张公论事，有回天之力。","book":"《魏书·帝纪篇末史臣总论》：“佞阉处当轴之权，婢媪擅回天之力，卖官鬻狱，乱政淫刑。”《新唐书·张玄素传》"},"example":{"text":"～，全寄托在这个奏折上，所以曹毓英笔下虽快，却是握管踌躇。","book":"高阳《玉座珠帘》上册"},"similar":["旋转乾坤"],"opposite":["回天乏术"],"usage":"作主语、宾语；指力量巨大","story":["公元630年，唐太宗下诏重修洛阳宫乾阳殿，张玄素认为此举不当，就上书力陈不妥。唐太宗接受规劝就立即下令停建，并赐给他彩绸200匹，表彰他的直言劝谏。魏征听说此事后，赞叹张玄素的话真是有回天之力，是仁人之言"]},{"id":12418,"word":"回天之势","pinyin":"huí tiān zhī shì","abbr":"htzs","explanation":"比喻权势极大。","source":{"text":"商协回天之执（势）。","book":"《后汉书·梁冀传论》"}},{"id":12419,"word":"回天乏术","pinyin":"huí tiān fá shù","abbr":"htfs","explanation":"回天：比喻力量大，能移转极难挽回的时势；乏术：缺少方法。比喻局势或病情严重，已无法挽救。","source":{"text":"后探得的耗，万箭攒心，脏腑欲裂。但木已成舟，回天乏术。","book":"清·冯起凤《昔柳摭谈·秋风自悼》"},"example":{"text":"占元保境有责，～，请查照前电，任命萧耀南为湖北督军，或可挽回危局。","book":"蔡东藩、许厪父《民国通俗演义》第一百二十五回"},"similar":["回天无力"],"opposite":["回天之力"],"usage":"作谓语；比喻已无法挽救的局势或病情严重"},{"id":12420,"word":"回天倒日","pinyin":"huí tiān dǎo rì","abbr":"htdr","explanation":"犹言旋转乾坤。","source":{"text":"夫以回天倒日之力，而不能振形骸之内。","book":"晋·陆机《吊魏武帝文》"},"similar":["回天挽日","回天转日","挥戈反日"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":12421,"word":"回天再造","pinyin":"huí tiān zài zào","abbr":"htzz","explanation":"回：挽回，扭转。指转变不好的形势，重新建设国家。形容忠心卫国，功勋卓著。","source":{"text":"二月壬申朔。甲戌，制赐全忠‘回天再造竭忠守正功臣’名。","book":"《旧唐书·昭宗纪》"},"usage":"作定语；用于书面语"},{"id":12422,"word":"回天挽日","pinyin":"huí tiān wǎn rì","abbr":"htwr","explanation":"犹言旋转乾坤。","source":{"text":"则回天挽日之功，皆出宪台起死嘘枯之赐矣。","book":"清·黄六鸿《福惠全书·莅任·禀贴赘说》"},"similar":["回天转日","回天倒日","回天转地"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":12423,"word":"回天无力","pinyin":"huí tiān wú lì","abbr":"htwl","explanation":"回天：比喻力量大，能移转极难挽回的时势；无力：没有力量。比喻局势或病情严重，已无法挽救。","source":{"text":"后探得的耗，万箭攒心，脏腑欲裂。但木已成舟，回天乏术。","book":"清·冯起凤《昔柳摭谈·秋风自悼》"},"example":{"text":"我家家传将种，系出清门，先君爱国如焚，～。","book":"清·梁启超《侠情记传奇·纬忧》"},"similar":["回天乏术"],"usage":"作谓语、宾语；指难以挽回"},{"id":12424,"word":"回天转地","pinyin":"huí tiān zhuǎn dì","abbr":"htzd","explanation":"犹言旋转乾坤。比喻改变君王的情绪或态度。","source":{"text":"挟山超海之力，望此犹轻；回天转地之威，方斯更烈。","book":"唐·刘肃《大唐新语·刚正》"},"example":{"text":"上又晏诸王于木兰殿，天颜大悦。方知回雪流风，可以～。","book":"宋·乐史《杨太真外传》"},"similar":["回天转日","回天倒日","回天挽日"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":12425,"word":"回天转日","pinyin":"huí tiān zhuǎn rì","abbr":"htzr","explanation":"使天倒转，让太阳转动。比喻权势、威力极大，能扭转危局。","source":{"text":"虽挟山超海之力，望此犹轻；回天转日之威，方斯更劣。","book":"《旧唐书·王义方传》"},"similar":["回天转地","回天挽日","回天倒日"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":12426,"word":"回天运斗","pinyin":"huí tiān yùn dǒu","abbr":"htyd","explanation":"犹言旋转乾坤。","source":{"text":"荡海吞江制中国，回天运斗应南面。","book":"唐·张鼎《邺城引》"},"similar":["回天挽日","回天转地"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":12427,"word":"回头是岸","pinyin":"huí tóu shì àn","abbr":"htsa","explanation":"佛家语，指有罪的人只要回心转意，痛改前非，就能登上“彼岸”，获得超度。后比喻做坏事的人，只要决心悔改，就有出路。","source":{"text":"世俗人没来由，争长竞短，你死我活。有呵吃些个，有呵穿些个。苦海无边，回头是岸。","book":"元·无名氏《度翠柳》第一折"},"example":{"text":"只要他们认破迷津，那便～。","book":"郭沫若《南冠草》第一幕"},"similar":["浪子回头","迷途知返"],"opposite":["执迷不悟","怙恶不悛"],"usage":"作谓语、分句；比喻只要悔改就有出路"},{"id":12428,"word":"回寒倒冷","pinyin":"huí hán dǎo lěng","abbr":"hhdl","explanation":"回：掉转；倒：颠倒。天气一会儿热，一会儿冷，变化无常。形容反反复复，变化不定。","source":{"text":"才赶出去，又叫进来，回寒倒冷的事情。","book":"清·李绿园《歧路灯》第三十六回"}},{"id":12429,"word":"回山倒海","pinyin":"huí shān dǎo hǎi","abbr":"hsdh","explanation":"形容力量和气势极强大，能压倒一切。","source":{"text":"昔世祖以回山倒海之威，步骑数十万南临瓜步，诸郡尽降。","book":"北齐·魏收《魏书·高闾传》"},"example":{"text":"～不关身，古人与我各何人。","book":"宋·杨万里《题周鲠臣浩斋》诗"},"similar":["排山倒海"],"usage":"作谓语、定语；比喻力强势大，能压倒一切"},{"id":12430,"word":"回山转海","pinyin":"huí shān zhuǎn hǎi","abbr":"hszh","explanation":"转动山海。比喻力量巨大。","source":{"text":"回山转海不作难，倾情倒意无所惜。","book":"唐·李白《忆旧游寄谯郡元参军》诗"},"similar":["回山倒海"],"usage":"作谓语、定语；比喻力强势大，能压倒一切"},{"id":12431,"word":"回干就湿","pinyin":"huí gān jiù shī","abbr":"hgjs","explanation":"指母亲育儿时，让婴儿居干处，自己就湿处。","source":{"text":"慈母德，实堪哀，十月三年受苦灾；冒热冲寒劳气力，回干就湿费心怀。","book":"《敦煌变文集·父母恩重经讲经文》"},"usage":"作谓语、定语；用于处事"},{"id":12432,"word":"回心向善","pinyin":"huí xīn xiàng shàn","abbr":"hxxs","explanation":"改变态度，走上正道。","source":{"text":"如卞在朝，人人惴恐，不敢回心向善。","book":"宋·任伯雨《论章惇蔡卞》"},"example":{"text":"九公此言，真可令人～，警戒不小。","book":"清·李汝珍《镜花缘》第十回"},"usage":"作谓语、宾语；指改过自新"},{"id":12433,"word":"回心转意","pinyin":"huí xīn zhuǎn yì","abbr":"hxzy","explanation":"心、意：心思；回、转：掉转。重新考虑，改变原来的想法和态度。","source":{"text":"且人一日间，此心是起多少私意，起多少计较，都不会略略回心转意去看。","book":"宋·朱熹《朱子语类·训门人·五》"},"example":{"text":"要不然时，叫他趁早～，有多少好处。","book":"清·曹雪芹《红楼梦》第四十六回"},"similar":["弃旧图新","洗心革面","一改故辙"],"opposite":["执迷不悟","一意孤行","义无反顾"],"usage":"作谓语、定语；用于消除嫌隙，重归于好","story":["三国时期，蜀主刘备病死，他的大臣雍闿投降吴国，吴国派他担任永昌太守，他走马上任。永昌郡守将吕凯忠于蜀国，不肯放雍闿进城，特地给雍闿回了一封文书，希望他能回心转意，将会有所作为的，再大的官都可以做"]},{"id":12434,"word":"回惊作喜","pinyin":"huí jīng zuò xǐ","abbr":"hjzx","explanation":"回：转换。由惊恐变为喜悦。","source":{"text":"国王闻言，回惊作喜。","book":"明·吴承恩《西游记》第六十二回"}},{"id":12435,"word":"回文织锦","pinyin":"huí wén zhī jǐn","abbr":"hwzj","explanation":"比喻有关相思的绝妙诗文。","source":{"text":"窦滔妻苏氏，始平人也，名蕙，字若兰。善属文。滔，苻坚时为秦州刺史，被徙流沙，苏氏思之，织锦为回文旋图诗以赠滔。宛转循环以读之，词甚凄惋，凡八百四十字。","book":"典出《晋书·列女传·窦滔妻苏氏》"},"example":{"text":"则为你彩笔题诗，～；送得人卧枕着床，忘餐废寝。","book":"元·王实甫《西厢记》第三本第四折"},"similar":["织锦回文"],"usage":"作宾语、定语；指情诗","story":["前秦时期，秦州刺史窦滔因得罪了苻坚的手下大官被流放到流沙县。夫妻天各一方，他的妻子苏蕙特地在一块锦缎上绣上840个字，纵横29个字的方图，可以任意地读，共能读出3752首诗，表达了她对丈夫的思念与关心之情"]},{"id":12436,"word":"回旋余地","pinyin":"huí xuán yú dì","abbr":"hxyd","explanation":"指做事或说话给自己留有足够进退的空间。","source":{"text":"虽然丧失若干土地，还有广大的回旋余地，可以促进并等候国内的进步、国际的增援和敌人的内溃，这是抗日战争的上策。","book":"毛泽东《论持久战》"},"example":{"text":"关于主权问题，中国在这个问题上没有～。","book":"邓小平《我们对香港问题的基本立场》"},"usage":"作宾语、定语；用于做事或说话等"},{"id":12437,"word":"回旋进退","pinyin":"huí xuán jìn tuì","abbr":"hxjt","explanation":"回旋：盘旋，转动；进退：前进和后退。在前进和后退过程中转动。比喻事情可以变通。","source":{"text":"回旋进退，莫不中节。","book":"《列子·汤问》"}},{"id":12438,"word":"回春之术","pinyin":"huí chūn zhī shù","abbr":"hczs","explanation":"回春：本指冬去春来，比喻医道高明，能治愈难治之病，挽救垂危的病人。术：医术。指起死回生的医术。同“妙手回春”。"},{"id":12439,"word":"回春妙手","pinyin":"huí chūn miào shǒu","abbr":"hcms","explanation":"回春：使春天重返，比喻将快死的人救活。指医生医术高明。","source":{"text":"倘杖回春妙手，生死肉骨，也尽些朋友之谊。","book":"清·碧荷馆主人《黄金世界》第七回"},"similar":["妙手回春"],"usage":"作宾语；用于大夫等"},{"id":12440,"word":"回生起死","pinyin":"huí shēng qǐ sǐ","abbr":"hsqs","explanation":"起死回生。形容医道高明，能把垂死的人求活。也用以形容挽回了看来没有希望的事物。","source":{"text":"回生起死妙难言，拯惫扶危更多益。","book":"明·施耐庵《水浒传》第七十回"},"example":{"text":"转败成功，伊谁之力；～，实尔之由。","book":"清·李渔《奈何天·闹封》"},"similar":["起死回生"],"usage":"作谓语、定语；指医术高明"},{"id":12441,"word":"回眸一笑","pinyin":"huí móu yī xiào","abbr":"hmyx","explanation":"眸：眼珠。转动眼珠，嫣然一笑。常用以形容女子妩媚的表情。","source":{"text":"回眸一笑百媚生，六宫粉黛无颜色。","book":"唐·白居易《长恨歌》"},"example":{"text":"唐·白居易《长恨歌》：“回眸一笑百媚生，六宫粉黛无颜色。”"},"similar":["嫣然一笑"],"usage":"作主语、谓语；用于女性"},{"id":12442,"word":"回瞋作喜","pinyin":"huí chēn zuò xǐ","abbr":"hczx","explanation":"瞋：发怒时瞪大眼睛。由发怒转为高兴。","source":{"text":"徐氏一见知心人，回瞋作喜。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"similar":["回嗔作喜"],"usage":"作谓语；指转怒为喜"},{"id":12443,"word":"回禄之灾","pinyin":"huí lù zhī zāi","abbr":"hlzz","explanation":"回禄：传说中的火神。指火灾。","source":{"text":"近闻永嘉有回禄之灾，高居不至惊恐否？","book":"宋·朱熹《答包定之》"},"usage":"作宾语、主语；指火灾"},{"id":12444,"word":"回筹转策","pinyin":"huí chóu zhuǎn cè","abbr":"hczc","explanation":"运筹决策。","source":{"text":"[孙权]又问：‘卿何如滕胤？’恪答曰：‘登阶蹑履，臣不如胤，回筹转策，胤不如臣。’","book":"《三国志·吴志·诸葛恪传》：“恪之才捷，皆此类也。”裴松之注引三国·魏·管辰《诸葛恪别传》"},"usage":"作谓语、定语；用于书面语"},{"id":12445,"word":"回肠九转","pinyin":"huí cháng jiǔ zhuǎn","abbr":"hcjz","explanation":"好像肠子在旋转。形容内心痛苦焦虑已极。","source":{"text":"是以肠一日而九回。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"元洪数月以来，踌躇再四，爱功忧乱，五内交萦，～，忧心百结。","book":"蔡东藩、许厪父《民国通俗演义》第十四回"},"similar":["回肠百转"],"usage":"作谓语、定语；形容内心痛苦与焦虑不安"},{"id":12446,"word":"回肠伤气","pinyin":"huí cháng shāng qì","abbr":"hcsq","explanation":"形容音乐、文章等缠绵悱恻，感人之极。","source":{"text":"言上诸声，能回转入肠，伤断人气。","book":"战国·楚·宋玉《高唐赋》：“纤条悲鸣，声似竽籁，清浊相和，五变四会，感心动耳，回肠伤气。孤子寡妇，寒心酸鼻。”李善注"},"similar":["回肠荡气","回肠结气"],"usage":"作谓语、定语；比喻音乐文章感人之深"},{"id":12447,"word":"回肠寸断","pinyin":"huí cháng cùn duàn","abbr":"hccd","explanation":"形容极端悲苦、忧伤。","source":{"text":"我发短回肠寸断，眼昏眵泪双淹。","book":"明·汤显祖《还魂记·诘病》"},"similar":["肝肠寸断"],"usage":"作谓语、定语；形容极其悲痛"},{"id":12448,"word":"回肠百转","pinyin":"huí cháng bǎi zhuǎn","abbr":"hcbz","explanation":"形容内心痛苦焦虑已极。同“回肠九转”。","source":{"text":"采秋从这日起，翠眉懒画，鸦鬓俯梳，真个一日之中，回肠百转。","book":"清·魏秀仁《花月痕》第三十四回"},"example":{"text":"思既往想将来～，大丈夫处乱世，要力任艰难。","book":"欧阳予倩《梁红玉》第三场"},"similar":["回肠九转"],"usage":"作谓语、定语；形容内心痛苦与焦虑不安"},{"id":12449,"word":"回肠结气","pinyin":"huí cháng jié qì","abbr":"hcjq","explanation":"回：回转。使肝肠回旋，使心气激荡。形容文章、乐曲十分婉转动人。","source":{"text":"其词凄丽妍约，情不自胜，令人诵之回肠结气，几欲掩过纳兰容若。","book":"清·李慈铭《越缦堂诗话》上卷"},"similar":["回肠荡气","回肠伤气"],"usage":"作谓语、定语；比喻音乐文章感人之深"},{"id":12450,"word":"回肠荡气","pinyin":"huí cháng dàng qì","abbr":"hcdq","explanation":"回：回转；荡：动摇。使肝肠回旋，使心气激荡。形容文章、乐曲十分婉转动人。","source":{"text":"女娥长歌，声协宫商，感心动耳，荡气回肠。","book":"战国·楚·宋玉《高唐赋》：“感心动耳，回肠伤气。”三国·魏·曹丕《大墙上蒿行》"},"example":{"text":"就令有悲哀底景闪过他们的眼前，他们坦率的心怀也能将他融和，使他再没有～底力量。","book":"朱自清《读〈湖畔〉诗集》"},"similar":["沁人肺腑","扣人心弦","回肠伤气"],"usage":"作谓语、定语；比喻音乐文章感人之深"},{"id":12451,"word":"回船转舵","pinyin":"huí chuán zhǎn duò","abbr":"hczd","explanation":"行船遇事的回原路。比喻掉转话头，缓和僵局。","source":{"text":"那尤辰领借颜俊家本钱，平日奉承他的，见他有咈然不悦之意，即忙回船转舵道：‘大官人莫要性急，且请坐下，细细商议。’","book":"明·冯梦龙《醒世恒言》卷七"},"similar":["见风使舵","随机应变"],"usage":"作谓语、定语；比喻说话做事随机应变"},{"id":12452,"word":"回邪入正","pinyin":"huí xié rù zhèng","abbr":"hxrz","explanation":"犹言改邪归正。","source":{"text":"《百论》为回邪入正。","book":"隋·吉藏《三论玄义》卷下"},"similar":["改邪归正"],"opposite":["执迷不悟"],"usage":"作谓语、宾语；指重新做人"},{"id":12453,"word":"回霜收电","pinyin":"huí shuāng shōu diàn","abbr":"hssd","explanation":"比喻改变原来冷漠严厉的态度。","source":{"text":"重蒙陛下恺悌之宥，回霜收电，使不损越。","book":"晋·陆机《谢平原内史表》"}},{"id":12454,"word":"回黄转绿","pinyin":"huí huáng zhuǎn lǜ","abbr":"hhzl","explanation":"树叶由绿变黄，由黄变绿。原指时令的变迁，后比喻世事的反复。","source":{"text":"回黄转绿无定期，世事反复君所知。","book":"《古诗源·休洗红》"},"example":{"text":"但鲁迅杂文的艺术手法，仍然是～，掩映多姿。","book":"茅盾《联系实际，学习鲁迅》"},"usage":"作谓语；比喻世事的反复"},{"id":12455,"word":"因乌及屋","pinyin":"yīn wū jí wū","abbr":"ywjw","explanation":"因某一事物而兼及其它有关事物。","source":{"text":"臣闻之也：爱人者，兼其屋上之乌。","book":"《尚书大传·大战》"},"example":{"text":"邹容《革命军》第五章：“呜呼！是又～之微意也。”"},"similar":["爱屋及乌"],"usage":"作谓语、定语、宾语；形容过分偏爱","story":["商朝末年，周武王攻克商都，建立周王朝，周武王不知如何处置商朝遗孤大臣，军师姜子牙说：“如果爱一个人，就连带爱他屋上的乌鸦。他们都助纣为虐，应该处死。”大臣周公认为不妥，商纣王的罪过不能由他们承担"]},{"id":12456,"word":"因事制宜","pinyin":"yīn shì zhì yí","abbr":"yszy","explanation":"根据不同的事情，制定适宜的措施。","source":{"text":"明王之御世也，遭时为法，因事制宜。","book":"东汉·班固《汉书·韦贤传》"},"example":{"text":"夫～，法不能尽；顺民施法，责在守令。","book":"宋·苏辙《西掖告词》"},"opposite":["一视同仁"],"usage":"作谓语、定语；指不同事情区别对待"},{"id":12457,"word":"因人制宜","pinyin":"yīn rén zhì yí","abbr":"yrzy","explanation":"因：依据；制：制定；宜：合适。根据人们的不同情况，采取适当的方法解决问题。","source":{"text":"方法不能千篇一律，必须因人制宜。","book":"李欣《老生常谈·以人为鉴》"},"example":{"text":"方法不能千篇一律，必须～。","book":"李欣《老生常谈·以人为鉴》"},"usage":"作谓语、定语、状语；用于处事"},{"id":12458,"word":"因人废言","pinyin":"yīn rén fèi yán","abbr":"yrfy","explanation":"困为那个人不好或地位低下，就把他正确的言论也否定了。","source":{"text":"君子不以言举人，不以人废言。","book":"《论语·魏灵公》"},"example":{"text":"我们似乎不能～，他们是否有私情那是一回事，他们的证据是否捏造那又是另一回事！","book":"梁羽生《幻剑灵旗》第三回"}},{"id":12459,"word":"因人成事","pinyin":"yīn rén chéng shì","abbr":"yrcs","explanation":"因：依靠。依靠别人的力量办成事情。","source":{"text":"公等碌碌，所谓因人成事者也。","book":"《史记·平原君虞卿列传》"},"example":{"text":"小将～，何足道哉！","book":"元·李寿卿《伍员吹箫》第四折"},"usage":"作谓语；指依凭他人办成事情"},{"id":12460,"word":"因人而异","pinyin":"yīn rén ér yì","abbr":"yrey","explanation":"因人的不同而有所差异。","source":{"text":"然而风格和情绪、倾向之类，不但因人而异，而且因事而异，因时而异。","book":"鲁迅《准风月谈·难得糊涂》"},"example":{"text":"这个配方要～，不能混为一谈。"},"opposite":["一视同仁"],"usage":"作谓语、定语；指具体问题具体对待"},{"id":12461,"word":"因人而施","pinyin":"yīn rén ér shī","abbr":"yres","explanation":"指按照各人不同的情况采取不同的方法、措施区别对待。","source":{"text":"倪二素日虽然是泼皮，却也因人而施，颇有义侠之名。","book":"清·曹雪芹《红楼梦》第二十四回"}},{"id":12462,"word":"因人设事","pinyin":"yīn rén shè shì","abbr":"yrss","explanation":"为了安置人而设置机构。"},{"id":12463,"word":"因任授官","pinyin":"yīn rèn shòu guān","abbr":"yrsg","explanation":"根据才能授予官职。","source":{"text":"因任而授官，循名而责实。","book":"《韩非子·定法》"},"usage":"作谓语、宾语；用于选拔干部"},{"id":12464,"word":"因公假私","pinyin":"yīn gōng jiǎ sī","abbr":"ygjs","explanation":"借公务谋取私利。","source":{"text":"因公假私，依正行邪。","book":"《后汉书·李固传》"},"similar":["假公济私"],"usage":"作谓语；指假公济私"},{"id":12465,"word":"因公行私","pinyin":"yīn gōng xíng sī","abbr":"ygxs","explanation":"借公务谋取私利。同“因公假私”。","source":{"text":"断狱者急于篣格酷烈之痛，执宪者烦于诋欺访滥之文，或因公行私，逞纵威福。","book":"《后汉书·陈宠传》"},"similar":["因公假私"],"usage":"作谓语、定语；指假公济私"},{"id":12466,"word":"因其固然","pinyin":"yin qi gu ran","abbr":"yqgr","explanation":"顺着它本来的结构。"},{"id":12467,"word":"因利乘便","pinyin":"yīn lì chéng biàn","abbr":"ylcb","explanation":"因：顺着。凭藉有利的形势。","source":{"text":"因利乘便，宰割天下，分裂河山。","book":"汉·贾谊《过秦论》"},"example":{"text":"古话说，“～”，确实是不应该坐失良机。","book":"姚雪垠《李自成》第二卷第五十四章"},"usage":"作谓语、定语；指利用有利条件"},{"id":12468,"word":"因利制权","pinyin":"yīn lì zhì quán","abbr":"ylzq","explanation":"因：依据，凭借；权：权变。因时因事而异而变通方法。指依据利害得失而采取相应的行动。","source":{"text":"将听吾计，用之必胜，留之；将不听吾计，用之必败，去之。计利以听，乃为之势，以佐其外。势者，因利而制权也。","book":"《孙子·计篇》"}},{"id":12469,"word":"因势乘便","pinyin":"yīn shì chéng biàn","abbr":"yscb","explanation":"根据形势顺便达到目的。","source":{"text":"因利乘便，宰割天下，分裂山河。","book":"汉·贾谊《过秦论》"},"usage":"作谓语、定语；指顺势"},{"id":12470,"word":"因势利导","pinyin":"yīn shì lì dǎo","abbr":"ysld","explanation":"因：顺着；势：趋势；利导：引导。顺着事情发展的趋势，加以引导。","source":{"text":"善战者因其势而利导之。","book":"《史记·孙子吴起列传》"},"example":{"text":"所以开明的行政者对于民意是～的，民意得到畅达，社会也就健全地发展了起来。","book":"郭沫若《革命春秋·创造十年续篇》"},"similar":["顺水推舟"],"opposite":["倒行逆施"],"usage":"作谓语、定语、状语；指善于处理问题","story":["战国时期，齐人孙膑和魏人庞涓一起在鬼谷子门下学习兵法。庞涓在魏国做大将，残酷迫害孙膑。孙膑受到齐威王的重用，让他协助田忌救援被魏国围困的韩国。他因势利导运用减灶计，迷惑庞涓，庞涓中了埋伏，成功杀死庞涓"]},{"id":12471,"word":"因势而动","pinyin":"yīn shì ér dòng","abbr":"ysed","explanation":"因：依据；势：趋势。顺着事情的发展趋势来行动。","source":{"text":"如敌之强实强于我，我先攻其弱，无损其强，而力已疲矣。先强先弱，总在因势而动。","book":"清·陈光宪《历代名将事略·先击》"}},{"id":12472,"word":"因势顺导","pinyin":"yīn shì shùn dǎo","abbr":"yssd","explanation":"因：顺着；势：趋势；顺导：引导。顺着事情发展的趋势，加以引导。","source":{"text":"善战者因其势而利导之。","book":"《史记·孙子吴起列传》"},"example":{"text":"邦民非难治，又见贤使君严明如此，皆已存不犯有司之念。～，殆如反掌。","book":"宋·陈亮《与韩子师侍郞》"}},{"id":12473,"word":"因变制宜","pinyin":"yīn biàn zhì yí","abbr":"ybzy","explanation":"变：突然发生的事件。根据突然发生的事件，采取与之相应的措施。","source":{"text":"充因自请，愿使匈奴。诏问其状，充对曰：‘因变制宜，以敌为师，事不可豫图。’","book":"《汉书·江充传》"},"example":{"text":"若此二者，所谓阴虚者阳必凑之而然，此则或从补，或从汗，当～，权其缓急，而治分虚实也。","book":"明·张景岳《景岳全书》卷六"}},{"id":12474,"word":"因噎去食","pinyin":"yīn yē qù shí","abbr":"yyqs","explanation":"原意是说，因为有人吃饭噎死了，就想让天下人都不吃饭，这太荒谬了。比喻要做的事情由于出了点小毛病或怕出问题就索性不去干。","source":{"text":"夫有以噎死者，欲禁天下之食，悖。","book":"《吕氏春秋·荡兵》"}},{"id":12475,"word":"因噎废食","pinyin":"yīn yē fèi shí","abbr":"yyfs","explanation":"原意是说，因为有人吃饭噎死了，就想让天下人都不吃饭，这太荒谬了。比喻要做的事情由于出了点小毛病或怕出问题就索性不去干。","source":{"text":"夫有以噎死者，欲禁天下之食，悖。","book":"《吕氏春秋·荡兵》"},"example":{"text":"若是后人不问来由，一律的奉以为法，岂不～了么？","book":"清·吴趼人《二十年目睹之怪现状》第二十一回"},"similar":["一朝被蛇咬，十年怕井绳"],"opposite":["百折不挠"],"usage":"作定语、谓语、宾语；指机械处事","story":["一财主大摆酒宴，席间划拳行令，喧声如潮，一个老头因牛肉没嚼烂而卡住脖子，顿时大汗淋漓，翻白眼，众人纷纷为他想办法处理，把老汉左右折腾，老头气得大喊而吐出牛肉。财主见状要各位回家，说有了前车之鉴，从此再也不吃饭了"]},{"id":12476,"word":"因地制宜","pinyin":"yīn dì zhì yí","abbr":"ydzy","explanation":"因：依据；制：制定；宜：适当的措施。根据各地的具体情况，制定适宜的办法。","source":{"text":"夫筑城郭，立仓库，因地制宜，岂有天气之数以威邻国者乎？","book":"汉·赵晔《吴越春秋·阖闾内传》"},"example":{"text":"惟各省情形不一，～，随时变通。","book":"《清史稿·朱嶟传》"},"similar":["因势利导"],"opposite":["一成不变"],"usage":"作谓语、宾语、状语；指具体问题具体对待","story":["从前长安城里有一个佝偻人郭骆驼以种树为生，很多有钱人争相请他去移栽树木，因为他有丰富的种树经验，经他移栽的树木长势很好，有人询问经验时，他说只是因地制宜，让其自然生长，很多人从他种树经验上悟出治国的道理"]},{"id":12477,"word":"因小失大","pinyin":"yīn xiǎo shī dà","abbr":"yxsd","explanation":"为了小的利益而失去大的利益。","source":{"text":"灭国亡身为天下笑，以贪小利失其大利也。","book":"汉·刘昼《新论·贪爱》"},"example":{"text":"他却只是不理，只道他身在洋界，可以没事。不知查抄起来，反恐～，他却如何懂得？（清·黄小配《廿载繁华梦》）"},"similar":["舍本逐末"],"opposite":["一举两得"],"usage":"作谓语、宾语、定语；指贪小便宜"},{"id":12478,"word":"因小见大","pinyin":"yīn xiǎo jiàn dà","abbr":"yxjd","explanation":"从小地方、小事情上可以看出大问题。","example":{"text":"他已经学会了～的处事方式"},"similar":["以小见大"],"usage":"作谓语、宾语、定语；用于看问题等"},{"id":12479,"word":"因循坐误","pinyin":"yīn xún zuò wù","abbr":"yxzw","explanation":"因循：迟延拖拉；坐误：坐失。指情况有了变化，还照老一套办，因而耽误了事情。","source":{"text":"威毅伯还在梦里，要等英、俄公使调停的消息哩！照这样因循坐误，无怪有名的御史韩以高约会了全台，在宣武门外松筠庵开会，提议参劾哩！","book":"清·曾朴《孽海花》第二十四回"},"example":{"text":"否则，～，责有攸归；全国丧亡，嗟悔无及。","book":"毛泽东《为动员一切力量争取抗战胜利而斗争》"},"usage":"作谓语；指误事"},{"id":12480,"word":"因循守旧","pinyin":"yīn xún shǒu jiù","abbr":"yxsj","explanation":"因循：沿袭；守旧：死守老的一套。死守老一套，缺乏创新的精神。","source":{"text":"光因循守职，无所改作。","book":"《汉书·循吏传序》"},"example":{"text":"如果～不求进取，那么人就不会进步。"},"similar":["墨守成规"],"opposite":["破旧立新","推陈出新"],"usage":"作谓语、定语、状语；指缺乏创新"},{"id":12481,"word":"因循敷衍","pinyin":"yīn xún fū yǎn","abbr":"yxfy","explanation":"因循：沿袭；敷衍：应付。指因袭旧套，搪塞应付，不思长进。","source":{"text":"闰二月甲申，诏严预备立宪责成，戒部臣、疆臣因循敷衍，放弃责任。","book":"《清史稿·宣统皇帝纪》"},"example":{"text":"而李鸿章壅于上闻，不以实情出奏，～，不知和议成为何日。","book":"高阳《慈禧全传》八十八"},"similar":["因循苟且"],"usage":"作谓语、宾语、定语；指不会变通"},{"id":12482,"word":"因循苟且","pinyin":"yīn xún gǒu qiě","abbr":"yxgq","explanation":"沿袭旧的，敷衍应付。","source":{"text":"以此等语言自恕，则因循苟且，无一事可为矣！","book":"宋·吕祖谦《答潘叔度》"},"example":{"text":"我们的文化或者只能产生我这样～的家伙，而不能产生壮怀激烈的好汉。","book":"老舍《四世同堂》"},"similar":["敷衍塞责"],"opposite":["革故鼎新"],"usage":"作谓语、宾语、定语；指不会变通"},{"id":12483,"word":"因循苟安","pinyin":"yīn xún gǒu ān","abbr":"yxga","explanation":"因循：沿袭；苟安：暂且偷生。指因袭旧套，搪塞应付，不思长进。","source":{"text":"是以慎忌集于中，由政事废于表，因循苟且之心作，强毅久大之性亏。","book":"唐·白居易《为人上宰相书》"},"example":{"text":"同时，他也忘了自己的～，而想到小顺儿的将来——一个最有希望与光明的将来！","book":"老舍《四世同堂》七十三"},"usage":"作谓语、定语、状语；用于处事"},{"id":12484,"word":"因循误事","pinyin":"yīn xún wù shì","abbr":"yxws","explanation":"因循：沿袭。指情况有了变化，还照老一套办，因而耽误了事情。","source":{"text":"而同圩有贫富之不等，有公私之相吝，而一人为之阻隔，以致因循误事。","book":"清·钱泳《履园丛话·围田》"},"example":{"text":"卢循探悉情形，才悔～，急遣战舰十余艘，进攻石头城的防栅。","book":"蔡东藩《两晋演义》第九十六回"}},{"id":12485,"word":"因循贻误","pinyin":"yīn xún yí wù","abbr":"yxyw","explanation":"因循：沿袭。沿袭旧的一套，使错误也沿袭下去，以至受害。","source":{"text":"臣等分饬司道次第妥办，以期渐复旧规，断不敢稍任因循贻误。","book":"清·林则徐《筹议新漕事宜折》"},"example":{"text":"明日后，又有明日，世人～，都以此言为厉阶。","book":"蔡东藩《元史演义》第二十九回"}},{"id":12486,"word":"因敌为资","pinyin":"yīn dí wéi zī","abbr":"ydwz","explanation":"犹因敌取资。从敌人方面取得资用、给养。","source":{"text":"今军无见粮，当因敌为资。","book":"《三国志·魏志·张既传》"},"similar":["因敌取资"],"usage":"作宾语、定语；用于处事"},{"id":12487,"word":"因敌制胜","pinyin":"yīn dì zhì shèng","abbr":"ydzs","explanation":"因：根据；制胜：取胜。依据敌情变化，制定不同的作战策略而取得胜利。","source":{"text":"夫兵形象水，水之行避高而趋下，兵之形避实而击虚；水因地而制流，兵因敌而制胜。","book":"《孙子·虚实》"}},{"id":12488,"word":"因敌取粮","pinyin":"yīn dí qǔ liáng","abbr":"ydql","explanation":"因：依靠；粮：粮食。从敌人方面取得粮食等科物资。","source":{"text":"愿将锐卒虎步江南，因敌取资，事必克捷。","book":"《三国志·魏志·董昭传》"}},{"id":12489,"word":"因敌取资","pinyin":"yīn dí qǔ zī","abbr":"ydqz","explanation":"因：依，靠；资：财物，资用。从敌人方面取得资用、给养。","source":{"text":"愿将锐卒虎步江南，因敌取资，事必克捷。","book":"《三国志·董昭传》"},"example":{"text":"军无辎重樵爨之苦，轻行速捷，～，此南方所以疲敝，北方所以常胜也。","book":"《魏书·燕风传》"},"similar":["因敌为资"],"usage":"作谓语；指从敌人方面取得所需的物资"},{"id":12490,"word":"因时制宜","pinyin":"yīn shí zhì yí","abbr":"yszy","explanation":"根据不同时期的具体情况，采取适当的措施。","source":{"text":"器械者，因时变而制宜适也。","book":"《淮南子·氾论训》"},"example":{"text":"除了几处通商口岸，稍能～，欺侮十八行省，那一处不是执迷不化，捍格不通呢？","book":"清·李宝嘉《文明小史》第一回"},"similar":["因地制宜","因时施宜"],"opposite":["一概而论"],"usage":"作谓语、宾语；指根据时间来处理"},{"id":12491,"word":"因时施宜","pinyin":"yīn shí shī yí","abbr":"yssy","explanation":"根据不同时期的具体情况，采取适当的措施。","source":{"text":"器械者，因时变而制宜适也。","book":"《淮南子·氾论训》"},"example":{"text":"臣窃谓虽三代圣人，其法不能无弊，是以易贡为助，易助为彻，要以～，无害于民而已。","book":"宋·苏辙《论衙前及诸役人不便札子》"},"similar":["因时制宜"],"usage":"作谓语、宾语；指根据时间来处理"},{"id":12492,"word":"因机立胜","pinyin":"yīn jī lì shèng","abbr":"yjls","explanation":"因：趁，依据；机：机会。掌握机会取得胜利。","source":{"text":"善为将者，必因机以立胜也。","book":"明·章婴《诸葛孔明异传·机形》"}},{"id":12493,"word":"因机而变","pinyin":"yīn jī ér biàn","abbr":"yjeb","explanation":"因：趁，随顺；机：机会。随机会变化而变化自己的策略。","source":{"text":"苟能审势而行，因机而变，则敌焉能乘我哉？","book":"明·西湖逸士《投笔肤谈》"}},{"id":12494,"word":"因材施教","pinyin":"yīn cái shī jiào","abbr":"ycsj","explanation":"因：根据；材：资质；施：施加；教：教育。指针对学习的人的志趣、能力等具体情况进行不同的教育。","source":{"text":"子游能养而或失于敬，子夏能直义而或少温润之色，各因其材之高下与其所失而告之，故不同也。","book":"《论语·为政》“子游问孝”、“子夏问孝”朱熹集注引宋程颐曰"},"example":{"text":"教师应当注意学生各方面的差异，以便～。"},"similar":["对症下药"],"opposite":["一视同仁"],"usage":"作谓语、定语、宾语；用于教育","story":["春秋时期，孔子善于根据学生的智力、性格等去教导他们。子路问他听到正确意见是否立即照做，孔子让他先请示一下父兄，而对冉有说可以立即照做。学生公西华不解，孔子解释说冉有为人谦让应鼓励，子路轻率刚猛要慎重行事"]},{"id":12495,"word":"因果不爽","pinyin":"yīn guǒ bù shuǎng","abbr":"ygbs","explanation":"爽：失。按佛教轮回说法，行善必有善报，行恶必有恶报，从来没有违背的。","example":{"text":"～的观念不一定正确"},"similar":["因果报应"],"usage":"作宾语、定语；用于书面语"},{"id":12496,"word":"因果报应","pinyin":"yīn guǒ bào yìng","abbr":"ygby","explanation":"因果：原因和结果。佛教迷信，认为今生种什么因，来生结什么果，善有善报，恶有恶报。","source":{"text":"唯谈玄论道，问因果报应。","book":"《慈恩传》"},"example":{"text":"浴罢则凉鞋蕉扇，或坐或卧，听邻老谈～事。三鼓归卧，周体清凉，几不知身居城市矣。","book":"清·沈复《浮生六记·闺房记乐》"},"usage":"作宾语、定语；佛教观点"},{"id":12497,"word":"因树为屋","pinyin":"yīn shù wéi wū","abbr":"ysww","explanation":"依树架屋。喻指隐居乡野。","source":{"text":"乃绝迹于梁砀之间，因树为屋，自同佣人。","book":"《后汉书·申屠蟠传》"},"example":{"text":"宋·朱熹《答黄子厚书》：“世间群小，无非敌国，便能～，自同佣人。”"},"usage":"作谓语、定语；用于书面语"},{"id":12498,"word":"因祸为福","pinyin":"yīn huò wéi fú","abbr":"yhwf","explanation":"变坏事为好事。","source":{"text":"智者举事，因祸为福，转败为功。","book":"西汉·司马迁《史记·苏秦列传》"},"example":{"text":"善～，君何处焉？","book":"西汉·司马迁《史记·李斯列传》"},"similar":["因祸得福"],"usage":"作谓语、定语、宾语；指人的处世"},{"id":12499,"word":"因祸得福","pinyin":"yīn huò dé fú","abbr":"yhdf","explanation":"变坏事为好事。","source":{"text":"其为政也，善因祸为福，转败为功。","book":"《史记·管晏列传》"},"example":{"text":"伯翁，你说我误事不误事，如今不是～吗？","book":"清·姬文《市声》第六回"},"similar":["塞翁失马","否极泰来"],"opposite":["乐极生悲"],"usage":"作谓语、定语、宾语；指人的运气","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":12500,"word":"因私枉法","pinyin":"yīn sī wǎng fǎ","abbr":"yswf","explanation":"因：因为；枉：歪曲，破坏。因为私人感情而破坏法律。指因私不能秉公办事。","source":{"text":"你说的何尝不是。但事关人命，蒙皇上隆恩起复委用，正竭力图报之时，岂可因私枉法，是实不忍为的。","book":"清·曹雪芹《红楼梦》第四回"}}]
