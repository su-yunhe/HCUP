diff --git a/feature/goods/src/main/ets/component/CommentImageViewer.ets b/feature/goods/src/main/ets/component/CommentImageViewer.ets
new file mode 100644
index 0000000000000000000000000000000000000000..a351f63cc0d645e0f3838d1b07fe1cf34dfceb12
--- /dev/null
+++ b/feature/goods/src/main/ets/component/CommentImageViewer.ets
@@ -0,0 +1,107 @@
+import { P100 } from "designsystem";
+
+/**
+ * @file 评价图片全屏查看器组件
+ */
+@ComponentV2
+export struct CommentImageViewer {
+  /**
+   * 当前评价的完整图片列表
+   */
+  @Param
+  pics: string[] = [];
+  /**
+   * 顶部安全区高度（vp）
+   */
+  @Param
+  topInset: number = 0;
+  /**
+   * 底部安全区高度（vp）
+   */
+  @Param
+  bottomInset: number = 0;
+  /**
+   * 关闭回调
+   */
+  @Param
+  onClose: () => void = (): void => {
+  };
+  /**
+   * 当前显示的图片下标
+   */
+  @Local
+  private currentIndex: number = 0;
+
+  /**
+   * 构建全屏图片查看器
+   * @returns {void} 无返回值
+   */
+  build(): void {
+    Stack({ alignContent: Alignment.Top }) {
+      Swiper() {
+        ForEach(this.pics, (pic: string, index: number): void => {
+          Image(pic)
+            .id(`comment_image_viewer_image_${index}`)
+            .width(P100)
+            .height(P100)
+            .objectFit(ImageFit.Contain);
+        }, (pic: string, index: number): string => `${pic}-${index}`);
+      }
+      .id("comment_image_viewer_swiper")
+      .index(this.currentIndex)
+      .loop(false)
+      .autoPlay(false)
+      .indicator(false)
+      .width(P100)
+      .height(P100)
+      .margin({ bottom: this.bottomInset })
+      .onAnimationStart((index: number, targetIndex: number): void => {
+        this.currentIndex = targetIndex;
+      })
+      .onChange((index: number): void => {
+        this.currentIndex = index;
+      });
+
+      this.TopBar();
+    }
+    .id("comment_image_viewer")
+    .width(P100)
+    .height(P100)
+    .backgroundColor(Color.Black);
+  }
+
+  /**
+   * 顶部页码与关闭按钮
+   * @returns {void} 无返回值
+   */
+  @Builder
+  private TopBar(): void {
+    Stack() {
+      Text(`${this.currentIndex + 1}/${this.pics.length}`)
+        .id("comment_image_viewer_indicator")
+        .fontSize($r("app.float.body_large"))
+        .fontColor($r("app.color.text_white"));
+
+      Row() {
+        Button($r("app.string.modal_close"))
+          .id("comment_image_viewer_close")
+          .accessibilityText($r("app.string.modal_close"))
+          .fontSize($r("app.float.body_medium"))
+          .fontColor($r("app.color.text_white"))
+          .backgroundColor($r("app.color.mask"))
+          .onClick((): void => {
+            this.onClose();
+          });
+      }
+      .width(P100)
+      .justifyContent(FlexAlign.End);
+    }
+    .width(P100)
+    .padding({
+      left: $r("app.float.space_horizontal_medium"),
+      right: $r("app.float.space_horizontal_medium"),
+      top: this.topInset + 8,
+      bottom: $r("app.float.space_vertical_small")
+    });
+  }
+}
diff --git a/feature/goods/src/main/ets/component/GoodsCommentCard.ets b/feature/goods/src/main/ets/component/GoodsCommentCard.ets
new file mode 100644
index 0000000000000000000000000000000000000000..8c45e2de0c4ee471a8bc3263882450e9b1bfc90d
--- /dev/null
+++ b/feature/goods/src/main/ets/component/GoodsCommentCard.ets
@@ -0,0 +1,77 @@
+import { ColumnStart, P100, SpaceVerticalMedium } from "designsystem";
+import { Comment } from "model";
+import { Card, TitleWithLine } from "ui";
+import { GoodsCommentItem } from "./GoodsCommentItem";
+
+/**
+ * @file 商品评价卡片组件
+ */
+@ComponentV2
+export struct GoodsCommentCard {
+  /**
+   * 评价列表
+   */
+  @Param
+  comments: Comment[] = [];
+  /**
+   * 评价图片点击回调
+   */
+  @Param
+  onImageClick: (pics: string[]) => void = (pics: string[]): void => {
+  };
+
+  /**
+   * 构建商品评价卡片
+   * @returns {void} 无返回值
+   */
+  build(): void {
+    ColumnStart({
+      widthValue: P100,
+      paddingValue: {
+        left: $r("app.float.space_horizontal_medium"),
+        right: $r("app.float.space_horizontal_medium"),
+        top: $r("app.float.space_vertical_medium")
+      }
+    }) {
+      Card({
+        widthValue: P100,
+        paddingValue: $r("app.float.space_padding_medium")
+      }) {
+        Column() {
+          Row() {
+            TitleWithLine({ text: $r("app.string.goods_reviews") });
+          }
