+[{"id":5001,"word":"人无远虑，必有近忧","pinyin":"rén wú yuǎn lǜ，bì yǒu jìn yōu","abbr":"rwylbyjy","explanation":"虑：考虑；忧：忧愁。人没有长远的考虑，一定会出现眼前的忧患。表示看事做事应该有远大的眼光，周密的考虑。","source":{"text":"子曰：‘人无远虑，必有近忧。’","book":"《论语·卫灵公》"},"example":{"text":"～，不如到官处断开了，庶杜绝后患。","book":"明·兰陵笑笑生《金瓶梅词话》第九回"},"usage":"作宾语、分句；用于劝诫人","story":["三国时期，曹操出兵40万来攻打东吴。东吴孙权召集文武百官研究对策，大将吕蒙建议在濡须口修筑船坞，孙权称赞道：“人无远虑，必有近忧，吕蒙有远见。”于是连夜修建。等魏军到时，船坞已修好，魏军在这一战中损失惨重"]},{"id":5002,"word":"人有脸，树有皮","pinyin":"rén yǒu liǎn，shù yǒu pí","abbr":"rylsyp","explanation":"人有脸面，就象树有树皮一样。比喻人都有羞耻之心，不能不顾脸面。","source":{"text":"人人有面，树树有皮。","book":"明·兰陵笑笑生《金瓶梅词话》第七十六回"},"example":{"text":"～，我怎么能伸手接你的卖身钱？","book":"刘绍棠《花街》七"}},{"id":5003,"word":"人望所归","pinyin":"rén wàng suǒ guī","abbr":"rwsg","explanation":"人望：众望；归：归向。大家一致期望的。指得到群众的信任。","source":{"text":"拥节度之重权，人望所归，天心攸属。","book":"《隋书·高祖纪上》：“内史上大夫郑泽、御正大夫刘昉，以高祖皇后之父，众望所归，遂矫诏引高祖入总朝政。”宋·无名氏《新编五代史平话·晋史》"},"example":{"text":"所以当他少年时代，他已是民间～了。","book":"胡适《说儒·自序》"}},{"id":5004,"word":"人杀鬼杀","pinyin":"rén shā guǐ shā","abbr":"rsgs","explanation":"被人杀和被鬼杀。比喻被好人和被坏人杀掉结果是一样的。","source":{"text":"人杀鬼杀，有何殊也，岂能为告人事乎！","book":"《旧唐书·魏玄同传》"},"example":{"text":"～，亦复何殊，岂能作告密人邪！","book":"《资治通鉴·唐纪·则天永昌元年》"}},{"id":5005,"word":"人材出众","pinyin":"rén cái chū zhòng","abbr":"rccz","explanation":"人品才能超出众人。同“人才出众”。","source":{"text":"我想我们二官人材出众，生得又秀气，何老头子见了，一定是中意的。","book":"清·吴趼人《情变》第四回"},"example":{"text":"清·吴趼人《情变》第四回：“我想我们二官～，生得又秀气，何老头子见了，一定是中意的。”"},"similar":["人才出众"],"usage":"作谓语、定语；用于夸奖人"},{"id":5006,"word":"人来人往","pinyin":"rén lái rén wǎng","abbr":"rlrw","explanation":"人来来往往连续不断。也形容忙于应酬。","source":{"text":"这两三天人来人往，我瞧着那些人都照应不到，想必你没有吩咐。","book":"清·曹雪芹《红楼梦》第110回"},"example":{"text":"在这～的地方没办法集中精力。"},"opposite":["冷冷清清","荒无人烟"],"usage":"作谓语、定语；指人不断"},{"id":5007,"word":"人来客去","pinyin":"rén lái kè qù","abbr":"rlkq","explanation":"指礼节性的应酬往来。也指来往客人很多。","source":{"text":"人来客去还须议，莫遣他人作主人。","book":"唐·司空图《南至四首》"},"example":{"text":"妈妈睡罢，一天到晚～的也乏了，歇歇罢。","book":"清·曹雪芹《红楼梦》第一百十回"},"similar":["人来客往"],"usage":"作宾语、定语；用于口语"},{"id":5008,"word":"人来客往","pinyin":"rén lái kè wǎng","abbr":"rlkw","explanation":"指礼节性的应酬往来。也指来往客人很多。同“人来客去”。","source":{"text":"人来客去还须议，莫遣他人作主人。","book":"唐·司空图《南至四首》"},"example":{"text":"偶然在家里空闲两日，又得分拨家事，整理行囊，再加上～，道乏辞行，转眼间早已假期将满。","book":"清·文康《儿女英雄传》第四十回"},"similar":["人来客去"],"usage":"作宾语、定语；用于口语"},{"id":5009,"word":"人杰地灵","pinyin":"rén jié dì líng","abbr":"rjdl","explanation":"杰：杰出；灵：好。指有杰出的人降生或到过，其地也就成了名胜之区。","source":{"text":"人杰地灵，徐孺下陈蕃之榻。","book":"唐·王勃《滕王阁序》"},"example":{"text":"实在襄阳的～，恐怕比它的山水形胜更值得人赞美。","book":"闻一多《孟浩然》"},"similar":["藏龙卧虎","钟灵毓秀"],"opposite":["绸人广众","人稠物穰"],"usage":"作主语、宾语、定语；指赞美别人的家乡","story":["“初唐四杰”的王勃因为他的《檄英王鸡》得罪了唐高宗而被放逐，他到交趾探望父亲路经洪州，恰逢重阳节，洪州都督阎伯屿大宴宾客，吟诗作乐，王勃即兴作《滕王阁序》：“物华天宝，龙光射斗牛之墟，人杰地灵，徐孺下陈蕃之榻。”"]},{"id":5010,"word":"人极计生","pinyin":"rén jí jì shēng","abbr":"rjjs","explanation":"指人到绝境就会产生计谋。","source":{"text":"那人急了，正好没出豁，却见明晃晃一把劈柴斧头，正在手边，也是人极计生，被他绰起，一斧正中刘官人面门。","book":"《醒世恒言·十五贯戏言成巧祸》"},"similar":["人急计生"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5011,"word":"人模人样","pinyin":"rén mó rén yàng","abbr":"rmry","explanation":"生得像是人的模样。","source":{"text":"怎人模人样，做出这等不君子待何如？","book":"元·石君宝《秋胡戏妻》第三折"},"similar":["人五人六"],"usage":"作定语；指装成人样"},{"id":5012,"word":"人模狗样","pinyin":"rén mú gǒu yàng","abbr":"rmgy","explanation":"身分是人，举止形容却像狗。多用于嘲讽。","source":{"text":"他也想象到怎样顺手儿教训教训那些人模狗样的科长科员们。","book":"老舍《骆驼祥子》十四：“祥子在棚里坐着呢，人模狗样的，脸上的疤被灯光照得像块玉石。”又《四世同堂》四九"},"example":{"text":"王朔《一半是火焰，一半是海水》：“‘当老师了，～的。’我跟史义德开玩笑。”"},"similar":["人模人样"],"usage":"作谓语、定语；用于讽刺"},{"id":5013,"word":"人欢马叫","pinyin":"rén huān mǎ jiào","abbr":"rhmj","explanation":"人在呼喊，马在嘶鸣。形容一片喧闹声。","source":{"text":"只听得外面喧嚷，似有人喊马嘶之声，渐渐近前堂来了。","book":"明·凌濛初《二刻拍案惊奇》卷十四"},"example":{"text":"田野上～，一片丰收的景象。"},"similar":["人喊马嘶"],"usage":"作谓语、定语；形容一片喧闹声"},{"id":5014,"word":"人欲横流","pinyin":"rén yù héng liú","abbr":"ryhl","explanation":"人欲：人的欲望嗜好；横流：泛滥的意思。指社会风气败坏，人们放纵情欲，不顾道德正义。","source":{"text":"后世人主不知学，人欲横流，安知天位非人君所可得而私？","book":"宋·陆九渊《语录》上"},"example":{"text":"积疲若反极，反使～，一发而不可止。（清·谭嗣同《仁学》第二十二章）"},"usage":"作谓语、定语；指社会风气败坏"},{"id":5015,"word":"人死留名","pinyin":"rén sǐ liú míng","abbr":"rslm","explanation":"指人生前建立了功绩，死后可以传名于后世。","source":{"text":"彦章武人，不知书，常为俚语谓人曰：‘豹死留皮，人死留名。’","book":"宋·欧阳修《新五代史·王彦章传》"},"example":{"text":"我们要做到～。"},"similar":["流芳百世"],"opposite":["默默无闻"],"usage":"作宾语、分句；常与“豹死留皮”连用","story":["五代时期，梁朝名将“王铁枪”王彦章跟随梁太祖朱温南征北战，屡立战功，深受重用。梁末帝朱贞继位后，唐军进攻梁国。王彦章受命御敌，但因寡不敌众被俘。唐庄宗劝王彦章归降。王彦章说：豹死留皮，人死留名，宁死不降。不久就被杀害"]},{"id":5016,"word":"人殊意异","pinyin":"rén shū yì yì","abbr":"rsyy","explanation":"殊：不同，特殊；异：不同。人各不同，思想也都不一样。","source":{"text":"此下诸将，人殊意异，未必服从。","book":"《三国志·魏志·董昭传》"},"example":{"text":"明公兴义兵以除暴乱，入朝辅佐天子，此五霸之功也。但诸将～，未必服从。今若留此，恐有不便。","book":"明·罗贯中《三国演义》十四回"}},{"id":5017,"word":"人比黄花瘦","pinyin":"rén bǐ huáng huā shòu","abbr":"rbhhs","explanation":"黄花：指菊花。人比菊花还要瘦弱。比喻人憔悴，暗示相思之深。","source":{"text":"莫道不消魂，帘卷西风，人比黄花瘦。","book":"宋·李清照《醉花阴》词"}},{"id":5018,"word":"人民城郭","pinyin":"rén mín chéng guō","abbr":"rmcg","explanation":"城郭：城墙。城郭还是旧有的，可人都不是原来的。感叹事态变迁，物是人非。","source":{"text":"有鸟有鸟丁令威，去家千年今始归。城郭如故人民非，何不学仙冢垒垒。","book":"晋·陶潜《搜神后记》卷一"},"example":{"text":"像乡下人上街听了许多新奇故事。又像站在高山顶上观察～。","book":"毛泽东《反对本本主义》"},"usage":"作宾语、定语；用于感叹"},{"id":5019,"word":"人浮于事","pinyin":"rén fú yú shì","abbr":"rfys","explanation":"浮：超过。原指人的才德高过所得俸禄的等级。后指工作中人员过多或人多事少。","source":{"text":"故君子与其使食浮于人也，宁使人浮于食。","book":"《礼记·坊记》"},"example":{"text":"老兄还没有晓得这里的情形，实在～，安插不来。","book":"清·张春帆《宦海》第九回"},"similar":["十羊九牧","投闲置散"],"opposite":["人尽其才","各得其所"],"usage":"作谓语、定语、宾语；指人多事少","story":["西汉时期，戴圣在《礼记》中讲述才能与俸禄的关系：俸禄和职位超过自己的能力和贡献，那就类似贪污；自己的勇力和贡献超过了俸禄和职位，就近似于廉洁。因此君子宁肯让自己浮于俸禄之上，也不愿让俸禄浮于自己能力之上"]},{"id":5020,"word":"人浮于食","pinyin":"rén fú yú shí","abbr":"rfys","explanation":"浮：超过。原指人的才德高过所得俸禄的等级。后指工作中人员过多或人多事少。","source":{"text":"故君子与其使食浮于人也，宁使人浮于食。","book":"《礼记·坊记》"},"similar":["人浮于事"],"opposite":["人尽其才"],"usage":"作谓语、定语、宾语；指人多事少"},{"id":5021,"word":"人海战术","pinyin":"rén hǎi zhàn shù","abbr":"rhzs","explanation":"以众多人数来进行战斗或解决问题的方法。","source":{"text":"……不敬师长，共产公妻，人海战术，总之是一群青面獠牙，十恶不赦的人。","book":"毛泽东《丢掉幻想，准备斗争》"},"example":{"text":"现代科技的发展，～是难以立足了。"},"usage":"作主语、宾语、定语；指靠人力做事"},{"id":5022,"word":"人涉卬否","pinyin":"rén shè áng fǒu","abbr":"rsaf","explanation":"别人涉水过河，而我独不渡。后用以比喻自有主张，不随便附和。","source":{"text":"人皆涉，我友未至。我独待之而不涉。以言室家之道，非得所適贞女不行，非得礼义昏姻不成。","book":"《诗·邶风·匏有苦叶》：“招招舟子，人涉卬否。人涉卬否，卬须我友。”毛传：“卬，我也。”郑玄笺"},"example":{"text":"虽有犀舟劲楫，犹～，有须者也。","book":"《后汉书·张衡传》"},"usage":"作宾语、定语；用于书面语"},{"id":5023,"word":"人满为患","pinyin":"rén mǎn wéi huàn","abbr":"rmwh","explanation":"因人多造成了困难。","source":{"text":"客栈小，已经人满为患。","book":"郭沫若《洪波曲》第二章一"},"example":{"text":"各地监狱，都有～之苦。","book":"方志敏《狱中记实》一"},"usage":"作谓语、定语；用于口语"},{"id":5024,"word":"人满之患","pinyin":"rén mǎn zhī huàn","abbr":"rmzh","explanation":"患：灾患。人太多的祸患。"},{"id":5025,"word":"人烟凑集","pinyin":"rén yān còu jí","abbr":"rycj","explanation":"人烟：指人家、住户。指居民密集。","source":{"text":"连日在途，人烟凑集，不敢下手。","book":"明·范受益《寻亲记·托梦》"},"similar":["人烟辐辏","人烟稠密"],"usage":"作谓语、定语；指某地方人口很多"},{"id":5026,"word":"人烟浩穰","pinyin":"rén yān hào rǎng","abbr":"ryhr","explanation":"指某地方人口很多。","source":{"text":"官巷口、棚心、众安桥，食物店铺，人烟浩穰。","book":"宋·耐得翁《都城纪胜·市井》"},"similar":["人烟凑集","人烟辐辏"],"usage":"作谓语、定语；指某地方人口很多"},{"id":5027,"word":"人烟稀少","pinyin":"rén yān xī shǎo","abbr":"ryxs","explanation":"人烟：指住户。指住户少。","source":{"text":"西门豹到了那里，看到田地荒芜，人烟稀少，就找了位老大爷来，问他是怎么回事。","book":"《西门豹》"},"example":{"text":"在这～的地区生意是很难做的。"},"similar":["荒无人烟"],"opposite":["人口稠密"],"usage":"作谓语、定语；指人口密度低"},{"id":5028,"word":"人烟稠密","pinyin":"rén yān chóu mì","abbr":"rycm","explanation":"指某地方人口很多。","source":{"text":"景和一力荐拔为延州府太守，管辖二州七县，地方广阔，钱粮极多，人烟稠密，百姓富庶，是一个膏腴的都会。","book":"明·方汝浩《禅真逸史》第二十七回"},"example":{"text":"那个地方虽然很小，但是人烟稠密。"},"similar":["人烟凑集"],"opposite":["人烟稀少"],"usage":"作谓语、定语；指某地方人口很多"},{"id":5029,"word":"人烟辐辏","pinyin":"rén yān fú còu","abbr":"ryfc","explanation":"人烟：指人家、住户；辐辏：形容人或物聚集像车辐集中于车毂一样。指居民密集。","source":{"text":"人烟辐辏，车马骈阆。","book":"《京本通俗小说·西山一窟鬼》"},"similar":["人烟稠密","人烟浩穰"],"usage":"作谓语、定语；指某地方人口很多"},{"id":5030,"word":"人烟阜盛","pinyin":"rén yān fù shèng","abbr":"ryfs","explanation":"阜：大，盛。指某地方人口很多。","source":{"text":"自上了轿，进入城中从纱窗向外瞧了一瞧，其街市之繁华，人烟之阜盛，自与别处不同。","book":"清·曹雪芹《红楼梦》第三回"},"example":{"text":"稻田尽头的平原上出现了一座～、楼厦密集的大城市。","book":"王朔《玩得就是心跳》二十"}},{"id":5031,"word":"人烦马殆","pinyin":"rén fán mǎ dài","abbr":"rfmd","explanation":"烦：烦躁；殆：通“怠”，疲乏。形容旅途劳顿。","source":{"text":"日既西倾，车殆马烦，尔乃税驾乎蘅皋，秣驷乎芝田。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"～禽兽尽，百里腥膻禾黍稀。","book":"唐·郑嵎《津阳门诗》"}},{"id":5032,"word":"人熟理不熟","pinyin":"rén shú lǐ bù shú","abbr":"rslbs","explanation":"理：道理，规矩。人虽然相熟，但还应该按理办事。","source":{"text":"但是，人熟理不熟，医院有规定，如果我违反，就将扣我的所有工资和奖金去充账。","book":"谭力《夏季欲望》第十六章"}},{"id":5033,"word":"人琴两亡","pinyin":"rén qín liǎng wáng","abbr":"rqlw","explanation":"形容看到遗物，怀念死者的悲伤心情。同“人琴俱亡”。","source":{"text":"予羸老矣，伤心几何。人琴两亡，命也命也。","book":"唐·张说《为人作祭弟文》"},"example":{"text":"丹壑非昔，～，惟旧之怀，有深追悼。","book":"《旧唐书·文苑传中·贺知章》"},"similar":["人琴俱逝","人琴俱亡"],"usage":"作宾语、定语；指怀念死者的心情"},{"id":5034,"word":"人琴俱亡","pinyin":"rén qín jù wáng","abbr":"rqjw","explanation":"俱：全，都；亡：死去，不存在。形容看到遗物，怀念死者的悲伤心情。","source":{"text":"取献之琴弹之，久而不调，叹曰：‘呜呼子敬，人琴俱亡。’","book":"南朝·宋·刘义庆《世说新语·伤逝》：“子敬，子敬，人琴俱亡。”《晋书·王徽之传》"},"example":{"text":"～，颇劳梦寐。","book":"明·张岱《赠沈歌叙序》"},"similar":["人琴俱逝","睹物思人","人琴两亡"],"usage":"作宾语、定语；指怀念死者的心情","story":["王献之与王徵之兄弟感情非常深厚，在老年兄弟都患重病。王献之先去世，王徵之的家人封锁消息，他坚持要去找王献之，在他的灵床上坐下，要弹奏几曲不成调子，就举琴摔到地上说：“子敬子敬，人琴俱亡！”悲痛得昏死过去"]},{"id":5035,"word":"人琴俱逝","pinyin":"rén qín jù shì","abbr":"rqjs","explanation":"形容看到遗物，怀念死者的悲伤心情。同“人琴俱亡”。","source":{"text":"人琴俱逝，赏音阒然。","book":"清·王鹏运《缰村词序》"},"similar":["人琴俱逝","人琴两亡"],"usage":"作宾语、定语；指怀念死者的心情"},{"id":5036,"word":"人生一世，草生一春","pinyin":"rén shēng yī shì，cǎo shēng yī chūn","abbr":"rsyscsyc","explanation":"一生一世像草生一春一样非常短暂。","source":{"text":"人生一世，草生一秋！我们只管打鱼营生，学得他们过一日也也。","book":"明·施耐庵《水浒全传》第十四回"},"example":{"text":"我想～，多久的光阴，转眼就过去了。","book":"张恨水《金粉世家》第三十八回"}},{"id":5037,"word":"人生一世，草生一秋","pinyin":"rén shēng yī shì，cǎo shēng yī qiū","abbr":"rsyscsyq","explanation":"一生一世像草生一秋一样非常短暂。","source":{"text":"一生一世像草生一秋一样非常短暂。"},"example":{"text":"终不然～，就只管这般闷昏昏过日子不成？那见得那正气不偷情的就举了节妇，名标青史？","book":"明·冯梦龙《醒世恒言》卷二十三"},"usage":"作宾语、定语、分句；用于感慨"},{"id":5038,"word":"人生七十古来稀","pinyin":"rén shēng qī shí gǔ lái xī","abbr":"rsqsglx","explanation":"稀：稀少。七十岁高龄的人从古以来就不多见。指得享高寿不易。","source":{"text":"酒债寻常行处有，人生七十古来稀。","book":"唐·杜甫《杜工部诗·曲江二首》"},"example":{"text":"～的说法在现今社会已不适应了。"},"usage":"作宾语、定语；用于口语"},{"id":5039,"word":"人生何处不相逢","pinyin":"rén shēng hé chù bù xiāng féng","abbr":"rshcbxf","explanation":"指人与人分手后总是有机会再见面的。","source":{"text":"人心此会应相重，人情今夜初相共，人生何处不相逢，早忘却更长漏永。","book":"元·王子一《误入桃源》"},"example":{"text":"～，相逢何必曾相识。"},"usage":"作宾语、定语；用于慨叹人生"},{"id":5040,"word":"人生在世","pinyin":"rén shēng zài shì","abbr":"rszs","explanation":"指人生活在世上。","source":{"text":"人生在世，本自非常，吾年已老，前路几何？","book":"南朝·齐·萧嶷《遗令》第六卷"},"example":{"text":"～，吃喝两字。"},"usage":"作分句；用于口语"},{"id":5041,"word":"人生在勤","pinyin":"rén shēng zài qín","abbr":"rszq","explanation":"人的生存和生活都要靠辛勤地劳动。","source":{"text":"人生在勤，不索何获？","book":"汉·张衡《应间》"},"example":{"text":"～，当以力田为先。","book":"《宋史·辛弃疾传》"}},{"id":5042,"word":"人生地不熟","pinyin":"rén shēng dì bù shú","abbr":"rsdbs","explanation":"指初到一地对当地的人与环境、习俗等不熟悉。","source":{"text":"由于人生地不熟，他也不感到这身破衣服在公众场所中的寒酸，自由自在地在这个城市的四面八方逛荡。","book":"路遥《平凡的世界》第一卷第二章"},"similar":["人地两生"],"opposite":["熟门熟路"],"usage":"作谓语、宾语、定语；指不熟悉环境"},{"id":5043,"word":"人生如寄","pinyin":"rén shēng rú jì","abbr":"rsrj","explanation":"寄：寓居，暂住。指人的生命短促，就象暂时寄居在人世间一样。","source":{"text":"人生如寄，多忧何为。","book":"《古诗十九首》：“人生忽如寄，寿无金石固。”三国·魏·曹丕《善哉行》"},"example":{"text":"世故多虞，～，一榻容安息。","book":"元·段成已《大江东去·赠答杨彦衡》"},"similar":["人生若寄"],"opposite":["人寿年丰"],"usage":"作宾语、定语；指人的生命短促"},{"id":5044,"word":"人生如朝露","pinyin":"rén shēng rú zhāo lù","abbr":"rsrzl","explanation":"朝露：早晨的露水，比喻存在的时间短。比喻人生短促。","source":{"text":"人生如朝露，何久自苦如此。","book":"《汉书·苏武传》"},"example":{"text":"日月如跳丸，～，生死事大，无常迅速。","book":"明·赵弼《觉寿居士传》"},"similar":["人生如寄"],"usage":"作宾语、定语、分句；比喻人生短促"},{"id":5045,"word":"人生如梦","pinyin":"rén shēng rú mèng","abbr":"rsrm","explanation":"人生如同一场梦。形容世事无定，人生短促。","source":{"text":"人生如梦，一樽还酹江月。","book":"宋·苏轼《念奴娇·赤壁怀古》"},"example":{"text":"～，转眼就是30年。"},"similar":["人生若梦"],"usage":"作谓语、宾语、定语；指世事无常"},{"id":5046,"word":"人生如风灯","pinyin":"rén shēng rú fēng dēng","abbr":"rsrfd","explanation":"人的生命短暂而微弱，像风前的灯随时都可能熄灭。","source":{"text":"‘顾人生如风灯石火，不饮将何为。’晚年沉湎尤甚，人称为‘酒仙’云。","book":"《辽史·耶律和尚传》"},"example":{"text":"～，该及时行乐。"},"similar":["人生如朝露"],"usage":"作宾语、定语；用于感叹句","story":["辽兴宗时期，御史大夫耶律和尚品行高尚，经常把自己的钱财分给贫困的亲友，人们都很尊敬他。他爱喝酒，不认真办公事，有人给他提意见，他说人生短暂，如风前之灯、石击之火，转瞬即逝，不及时行乐更待何时。他晚年有“酒仙”的称号"]},{"id":5047,"word":"人生朝露","pinyin":"rén shēng zhāo lù","abbr":"rscl","explanation":"形容人生短暂。","example":{"text":"他年方三十，正是旭日东升的时候，前途无量，但却骤然去世，使人不由得有～之感。"}},{"id":5048,"word":"人生自古谁无死","pinyin":"rén shēng zì gǔ shuí wú sǐ","abbr":"rszgsws","explanation":"人生自古以来有谁能够长生不死，但应死得有价值。","source":{"text":"人生自古谁无死，留取丹心照汗青。","book":"宋·文天祥《过零丁洋》诗"},"example":{"text":"～，嗟此恨凭谁语。可怜衰绖拜坟茔，不作锦衣归故里。","book":"元·高明《琵琶记·风木余恨》"},"usage":"作宾语、定语；用于感叹等"},{"id":5049,"word":"人生若寄","pinyin":"rén shēng ruò jì","abbr":"rsrj","explanation":"指人的生命短促，就象暂时寄居在人世间一样。同“人生如寄”。","source":{"text":"人生若寄，憔悴有时。","book":"晋·陶潜《荣木》诗"},"similar":["人生如寄"],"usage":"作宾语、定语；指人的生命短促"},{"id":5050,"word":"人生行乐耳","pinyin":"rén shēng xíng lè ěr","abbr":"rsxle","explanation":"人生在世上只有寻欢作乐罢了。这是封建士大夫的消极人生观。","source":{"text":"人生行乐耳，须富贵何时？","book":"汉·杨恽《报孙会宗书》"},"example":{"text":"～，身后虚名，何似生前一杯酒。","book":"宋·辛弃疾《洞仙歌·访泉于奇石村，得周氏泉，为赋》"}},{"id":5051,"word":"人生观","pinyin":"rén shēng guān","abbr":"rsg","explanation":"对人生价值和意义所持有的观点。","source":{"text":"他在他们面前装得很老练很大方，侃侃而谈，吹着他那套生意经和人生观。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"年轻人要有正确的～。"},"usage":"作宾语、定语；用于生活"},{"id":5052,"word":"人生识字忧患始","pinyin":"rén shēng shí zì yōu huàn shǐ","abbr":"rsszyhs","explanation":"忧患：忧愁，苦难。人的一生忧愁苦难是从识字开始的。指一个人识字以后，从书中增长了见识，对周围事物就不会无动于衷。","source":{"text":"人生识字忧患始，姓名粗记可以休。","book":"宋·苏轼《石苍舒醉墨堂》诗"}},{"id":5053,"word":"人生路不熟","pinyin":"rén shēng lù bù shú","abbr":"rslbs","explanation":"比喻初到一个地方各方面都很陌生。","source":{"text":"我们初到此地，人生路不熟，必要找作一个人做向导才好。","book":"清·吴研人《二十年目睹之怪现状》第三十六回"},"example":{"text":"贵府人多，虽有丫环仆妇，只是～，倒茶打水，究竟不便。","book":"清·黄小配《廿载繁华梦》第六回"},"similar":["人地两生"],"usage":"作谓语、定语；用于口语"},{"id":5054,"word":"人生面不熟","pinyin":"rén shēng miàn bù shú","abbr":"rsmbs","explanation":"人的面貌陌生，素不相识。","source":{"text":"孩子见大郎如此待得他好，心里虽也欢喜，只是人生面不熟，又不知娘的意思怎么，有些不妥贴，还想要去。","book":"明·凌濛初《二刻拍案惊奇》卷十"},"example":{"text":"～的，别忙，你老等我劝劝他。","book":"清·文康《儿女英雄传》第七回"},"similar":["素不相识"],"usage":"作宾语、定语、分句；指陌生的事物"},{"id":5055,"word":"人百其身","pinyin":"rén bǎi qí shēn","abbr":"rbqs","explanation":"百其身：自身死一百次。别人愿意死一百次来换取死者的复生。表示对死者极沉痛的悼念。","source":{"text":"如可赎兮，人百其身。","book":"《诗·秦风·黄鸟》"},"example":{"text":"你之牺牲是革命长恨，～赎不回。","book":"陈毅《哭叶军长希夷同志》诗"},"similar":["百身莫赎"],"usage":"作宾语；表示对死者极沉痛的悼念"},{"id":5056,"word":"人皆掩鼻","pinyin":"rén jiē yǎn bí","abbr":"rjyb","explanation":"人人都捂住鼻子。本指秽气难闻，后指行为丑恶，谁都不愿接近。","source":{"text":"西子蒙不洁，则人皆掩鼻而过之。","book":"《孟子·离娄下》"},"example":{"text":"这等的秽德彰闻，焉得不～？","book":"清·文康《儿女英雄传》第三十七回"}},{"id":5057,"word":"人眼是秤","pinyin":"rén yǎn shì chèng","abbr":"rysc","explanation":"众人的眼睛如同秤一样的公平。比喻群众的意见公正合理。"},{"id":5058,"word":"人神共嫉","pinyin":"rén shén gòng jí","abbr":"rsgj","explanation":"人与神都憎恨厌恶。极言民怨之甚。","source":{"text":"实由自邀功赏，造作兵端，人神共嫉，以致殃咎。","book":"唐·韩愈《黄家贼事宜状》"},"similar":["人神同嫉"],"usage":"作定语、状语；用于民愤很大"},{"id":5059,"word":"人神共愤","pinyin":"rén shén gòng fèn","abbr":"rsgf","explanation":"人和神都愤恨。形容民愤极大。","source":{"text":"肆行暴虐，人神共愤，法令不容。","book":"《旧唐书·于柚传》"},"example":{"text":"恶已贯盈，～。","book":"明·许仲琳《封神演义》第八十回"},"similar":["民怨沸腾"],"usage":"作谓语、定语；指极为愤怒","story":["唐朝时期，湖州刺史于頔重修西湖灌溉工程，让百姓受益匪浅。他任苏州刺史时下令拆除神庙，破除迷信。他的政绩卓著，为人比较专横，死后唐宪宗赐号“厉”。他的儿子请唐穆宗改“厉”为“思”，太常博士王彦威说他肆行暴虐，人神共愤，法令不容"]},{"id":5060,"word":"人神同嫉","pinyin":"rén shén tóng jí","abbr":"rstj","explanation":"人与神都憎恨厌恶。极言民怨之甚。同“人神共嫉”。","source":{"text":"虐政密如蛛网，生民坠于涂炭，人神同嫉，天地不容。","book":"杨玉如《辛亥革命著记》第五章"},"similar":["人神共嫉"],"usage":"作定语、状语；用于民愤很大"},{"id":5061,"word":"人神同愤","pinyin":"rén shén tóng fèn","abbr":"rstf","explanation":"人和神都愤恨。形容民愤极大。","source":{"text":"曾不怀音，公行反噬，肆兹悖逆，人神同愤。","book":"《魏书·道武七王传》"}},{"id":5062,"word":"人离乡贱","pinyin":"rén lí xiāng jiàn","abbr":"rlxj","explanation":"指离开故乡，无亲无故，失去依靠，遭人轻视。","source":{"text":"长老闻言，满眼垂泪道：‘可怜，可怜！这才是人离乡贱。’","book":"明·吴承恩《西游记》第三十六回"},"usage":"作宾语、定语；用于书面语"},{"id":5063,"word":"人离家散","pinyin":"rén lí jiā sàn","abbr":"rljs","explanation":"一家人东离西散，无法在一起安生度日。比喻遇到了灾祸。","source":{"text":"这三街四巷，凭他是谁，若得罪了醉金刚倪二街坊，管叫他人离家散。","book":"清·曹雪芹《红楼梦》第二十四回"}},{"id":5064,"word":"人稠物穰","pinyin":"rén chóu wù ráng","abbr":"rcwr","explanation":"稠：稠密，多。穰：丰盛。人口众多，物产丰盛。形容城市繁荣昌盛的景象。","source":{"text":"人稠物穰景非常，真乃是鱼龙变化之乡。","book":"元·胡用和《粉蝶儿·题金陵景》套曲"},"example":{"text":"直到大街上，～，正是热闹。","book":"《古今小说·杨思温燕山逢故人》"},"usage":"作谓语、定语；用于书面语"},{"id":5065,"word":"人穷反本","pinyin":"rén qióng fǎn běn","abbr":"rqfb","explanation":"指人在走投无路之时，呼叫天地、父母。","source":{"text":"夫天者，人之始也；父母者，人之本也。人穷则反本，故劳苦倦极，未尝不呼天地；疾痛惨怛，未尝不呼父母也。","book":"《史记·屈原贾生列传》"}},{"id":5066,"word":"人穷嘴碎","pinyin":"rén qióng zuǐ suì","abbr":"rqzs","explanation":"人越是穷苦越是说话啰嗦。","example":{"text":"真是～，少说几句吧。"},"usage":"作宾语、定语；用于人状态"},{"id":5067,"word":"人穷志不穷","pinyin":"rén qióng zhì bù qióng","abbr":"rqzbq","explanation":"穷：困厄。人的处境虽困厄，但志向却远大。","source":{"text":"你晓得我吃软不吃硬，人穷志不穷的脾气，这样才会投缘。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"～，我一定能发达的。"},"opposite":["人穷志短"],"usage":"作谓语、补语；指穷人的志向"},{"id":5068,"word":"人穷志短","pinyin":"rén qióng zhì duǎn","abbr":"rqzd","explanation":"穷：困厄；短：短小。人的处境困厄，志向也就小了。","source":{"text":"又道是人穷志短，李生听了这句话，便认为真。","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"example":{"text":"所谓～，我那里敢和他较量，只索避了。","book":"清·吴趼人《二十年目睹之怪现状》第四十一回"},"similar":["人穷智短","马瘦毛长"],"opposite":["人穷志不穷"],"usage":"作谓语、补语；指穷人的志向"},{"id":5069,"word":"人穷智短","pinyin":"rén qióng zhì duǎn","abbr":"rqzd","explanation":"穷：困厄；短：短小。指人一到无路可走的时候，思想迟钝，办法也就不多了。","source":{"text":"人穷令智短，百巧千穷只短檠。","book":"《鸡肋编》下卷引陈无己诗"},"example":{"text":"我们不能～。"},"similar":["人贫智短"],"usage":"作谓语、宾语、定语；指穷人的智力"},{"id":5070,"word":"人穷气短","pinyin":"rén qióng qì duǎn","abbr":"rqqd","explanation":"指穷人说话没有底气。","source":{"text":"俗话说：人穷气短。","book":"路遥《平凡的世界》第六卷第34章"},"usage":"作宾语、定语；用于口语"},{"id":5071,"word":"人约黄昏","pinyin":"rén yuē huáng hūn","abbr":"ryhh","explanation":"人在黄昏时约会。指情人约会。","source":{"text":"散了客宾，早教我急煎煎心困，我则怕辜负了人约黄昏。","book":"宋·欧阳修《生查子》词：“去年元夜时，花市灯如在昼。月到柳梢头，人约黄昏后。”元·无名氏《云窗梦》第二折"},"example":{"text":"柳梢头晚上天街静，又早～，论秋月四时偏胜。","book":"明·祝允明《八声甘州》词"},"usage":"作宾语、定语；用于约会等"},{"id":5072,"word":"人给家足","pinyin":"rén jǐ jiā zú","abbr":"rjjz","explanation":"给：富裕，充足。家家户户丰衣足食。","source":{"text":"汉兴七十余年，国家无事，非遇水旱之灾，民则人给家足。","book":"西汉·司马迁《史记·平准书》"},"example":{"text":"土宜姜芋，水多蛙鱼，贫者得以～。","book":"东汉·班固《汉书·东方朔传》"},"similar":["丰衣足食","人足家给"],"usage":"作谓语、定语；指社会繁荣","story":["战国时期，宋国工匠出身的墨翟对儒学繁琐的“礼”不满，就另立新学说，主张“非儒”。墨家成员提倡“节用”与“节葬”，住土房吃粗饭穿麻衣，成员内部互相救助，严守纪律，服从首领，强调加强农业，节省用度，人人饱暖，家家富足"]},{"id":5073,"word":"人老心不老","pinyin":"rén lǎo xīn bù lǎo","abbr":"rlxbl","explanation":"指人虽然老了，但有一颗年轻的心。","source":{"text":"都是他自己，一心还想弄两个年轻的，人老心不老，不晓得在交什么墓库运！","book":"高阳《胡雪岩全传·平步青云》中册"},"example":{"text":"他～，始终坚持学习。"},"similar":["老骥伏枥","宝刀未老"],"opposite":["未老先衰"],"usage":"作谓语、定语；用于老年人","story":["三国时期，魏国大将张郃率军要攻打蜀国的葭萌关。孟达赶紧向刘备求援。孔明正在发愁之际，老将黄忠与严颜请求前往，别人提出质疑。孔明认为他们人老心不老。黄忠与严颜相互配合巩固葭萌关。同时断了魏军粮草，夺取了汉中"]},{"id":5074,"word":"人老珠黄","pinyin":"rén lǎo zhū huáng","abbr":"rlzh","explanation":"旧时比喻女子老了被轻视，就象因年代久远而失去光泽的珍珠一样不值钱。","source":{"text":"娘子正在青年，翻身的日子很有呢，不像俺是人老珠黄不值钱呢。","book":"明·兰陵笑笑生《金瓶梅词话》第二回"},"example":{"text":"真正～不值钱，走了这点点路，果然就吃力起来，我也要回去睡个觉呢。（清·吴趼人《瞎编奇闻》第七回）"},"opposite":["国色天香"],"usage":"作谓语、定语；用于女性"},{"id":5075,"word":"人而无信，不知其可","pinyin":"rén ér wú xìn，bù zhī qí kě","abbr":"rewxbzqk","explanation":"信：信用；其：那；可：可以，行。一个人不讲信用，真不知道怎么能行。指人不讲信用是不行的。","source":{"text":"人而无信，不知其可也。","book":"《论语·为政》"},"example":{"text":"列位呵，“～。”你们才说有本事进得来，出得去，不伤身体者，就拜他为王。","book":"明·吴承恩《西游记》第一回"},"usage":"作分句；指人不讲信用是不行的","story":["春秋时期，著名大思想家孔子经常教育人们要讲信义，他说：“作为人却不讲信用，真不知道那怎么可以，就好像高大的马车没有驾马的倪，小的马车没有驾马的轨，它们凭什么才能行走呢？为人必须做到言而有信，才能取信于人。”"]},{"id":5076,"word":"人自为战","pinyin":"rén zì wéi zhàn","abbr":"rzwz","explanation":"为战：作战。人人能独立地战斗。","source":{"text":"此所谓驱市人而战之，其势非置之死地，使人人自为战。","book":"《史记·淮阴侯列传》"},"example":{"text":"今深入万里，置之死地，士无反顾之心，所谓～者也。","book":"《晋书·袁乔传》"},"usage":"作谓语、补语、定语；指英勇作战","story":["楚汉相争时期，汉军大将韩信带领10万人去攻打依附于项羽的赵国，赵王和主将陈余在井阱一带集中20万大军抵抗。井阱这条路很窄，两辆战车不能并行，行进的队伍拉得很长，形势对韩信十分不利，但他们的士兵都能独立作战，最终取胜"]},{"id":5077,"word":"人自为政","pinyin":"rén zì wéi zhèng","abbr":"rzwz","explanation":"各人推行自己的主张。比喻各行其是。","source":{"text":"传奇格局，有一定而不可移者，有可仍、可改，听人自为政者。","book":"清·李渔《闲情偶寄·词曲·格局》"},"example":{"text":"现在京沪木刻运动，仍然销沉，而且颇散漫，几有～之概。","book":"鲁迅《书信集·致李桦》"},"similar":["各自为政","各行其是"],"usage":"作谓语、定语；形容互相都不配合"},{"id":5078,"word":"人自为斗","pinyin":"rén zì wéi dòu","abbr":"rzwd","explanation":"每个人都在为报私怨而争斗。","source":{"text":"家自为怒，人自为斗，各报其怨而攻其仇，县杀其令丞，郡杀其守尉。","book":"《史记·张耳陈余列传》"},"example":{"text":"当此之时，贼渠率众无专主，遇官军，～，胜则争进，败则窜山谷不相顾。","book":"《明史·流贼列传》"}},{"id":5079,"word":"人荒马乱","pinyin":"rén huāng mǎ luàn","abbr":"rhml","explanation":"形容局势动荡不安。","source":{"text":"现在又是这么的人荒马乱，交通不方便。","book":"鲁迅《故事新编·理水》"},"similar":["兵荒马乱"],"opposite":["国泰民安"],"usage":"作谓语、定语、状语；用于社会局面等"},{"id":5080,"word":"人莫予毒","pinyin":"rén mò yú dú","abbr":"rmyd","explanation":"莫：没有；予：我；毒：分割，危害。再也没有人怨恨我、伤害我了。形容劲敌被消灭后高兴的心情。","source":{"text":"及楚杀子玉，公喜而后可知也，曰：‘莫余毒也已。’是晋再克而楚再败也，楚是以再世不竞。","book":"《左传·宣公十二年》"},"example":{"text":"长此不悟，纵令势力弥满，～，亦乃与满州亲贵等夷。","book":"章炳麟《致张继、于右任书》"},"similar":["莫予毒也"],"usage":"作谓语、宾语、定语；指妄自尊大"},{"id":5081,"word":"人莫知其子之恶","pinyin":"rén mò zhī qí zǐ zhī è","abbr":"rmzqzze","explanation":"莫：不；恶：恶劣。溺爱的人不知道自己孩子的坏处。","source":{"text":"故谚有之云：人莫知其子之恶，莫知其苗之硕。","book":"《礼记·大学》"}},{"id":5082,"word":"人莫若故","pinyin":"rén mò ruò gù","abbr":"rmrg","explanation":"还是老朋友亲。","source":{"text":"衣莫若新，人莫若故。","book":"《晏子春秋·内篇·杂上》"}},{"id":5083,"word":"人言不足恤","pinyin":"rén yán bù zú xù","abbr":"rybzx","explanation":"人言：别人的议论；恤：忧虑。别人的议论不值得忧虑。形容不怕别人议论。","source":{"text":"礼义不愆，何恤于人言。","book":"《左传·昭公四年》"},"example":{"text":"天变不足畏，祖宗不足法，～。","book":"《宋史·王安石传》"}},{"id":5084,"word":"人言凿凿","pinyin":"rén yán záo záo","abbr":"ryzz","explanation":"凿：明确真实。指人们议论确有其事。","source":{"text":"我不晓得是真是假，但是人言凿凿，谅非无因。","book":"清·吴趼人《糊涂世界》第十一回"}},{"id":5085,"word":"人言可畏","pinyin":"rén yán kě wèi","abbr":"rykw","explanation":"人言：别人的评论，指流言蜚语；畏：怕。指在背后的议论或诬蔑的话很可怕。","source":{"text":"人之多言，亦可畏也。","book":"《诗经·郑风·将仲子》"},"example":{"text":"但是～，必定也要明明心；就是你不怕什么，难道我们老大死了，还当王八么？","book":"清·李宝嘉《活地狱》第三十回"},"similar":["流言蜚语","人言藉藉"],"opposite":["有口皆碑","口碑载道"],"usage":"作分句、宾语；指流言蜚语很可怕","story":["古代时青年男子仲子爱上一个漂亮的姑娘，两个人的感情十分深厚，但是他们的爱情还没得到双方父母的同意。而仲子忍不住思恋，想偷偷地去姑娘家幽会。姑娘告诉他也十分想念他，只是没有父母之命，担心流言蜚语，人言可畏"]},{"id":5086,"word":"人言啧啧","pinyin":"rén yán zé zé","abbr":"ryzz","explanation":"人们不满地议论纷纷。","source":{"text":"话说王府娶亲之日，周女不愿叩拜翁姑，以至一场扫兴，任人言啧啧，他只在房里抽烟。","book":"清·黄小配《廿载繁华梦》"},"example":{"text":"内阁的名单发表，不免～。","book":"冯玉祥《我的生活》"},"similar":["议论纷纷","怨声载道"],"opposite":["赞叹不已"],"usage":"作谓语、分句；指议论纷纷"},{"id":5087,"word":"人言籍籍","pinyin":"rén yán jí jí","abbr":"ryjj","explanation":"指人们议论纷纷。","source":{"text":"妾亦闻外面人言籍籍，归怨相公。","book":"《京本通俗小说·拗相公》"},"example":{"text":"毕珠也晓得～，心上很想做出一桩重大之事给人家看看。","book":"《中国现在记》第六回"},"similar":["人言可畏","流言蜚语"],"usage":"作谓语、定语；指人们议论纷纷"},{"id":5088,"word":"人言藉藉","pinyin":"rén yán jí jí","abbr":"ryjj","explanation":"籍籍：纷乱的样子。人们指责、攻击的话哪里都流传着。多用在说有关人家名誉的事。","source":{"text":"国中口语籍籍，慎无复至江都。","book":"《汉书·江都易王非传》"},"example":{"text":"妾亦闻外面～，归怨相公。","book":"明·冯梦龙《警世通言》卷四"}},{"id":5089,"word":"人语马嘶","pinyin":"rén yǔ mǎ sī","abbr":"ryms","explanation":"人叫喊，马嘶鸣。形容纷乱扰攘或热闹欢腾的情景。","source":{"text":"大小三军，收拾什物，不许人语马嘶。","book":"唐·卢纶《送韦判官得雨中山》：“人语马嘶听不得，更堪长路在云中。”元·无名氏《五马破曹》第三折"},"example":{"text":"却说夏侯渊一军抄过山后，见重雾垂空，又闻～，恐有伏兵，急催人马行动。","book":"明·罗贯中《三国演义》第六十七回"},"similar":["人喊马嘶"],"usage":"作谓语、定语；形容一片喧闹的景象"},{"id":5090,"word":"人谋不臧","pinyin":"rén móu bù zāng","abbr":"rmbz","explanation":"人谋：人的谋划；臧：善。事情之所以不成，或失败是由于人没有谋划好，与天时、地利无关。","example":{"text":"虽说是大意，究竟也是～。","book":"姚雪垠《李自成》第五卷第二十二章"}},{"id":5091,"word":"人财两失","pinyin":"rén cái liǎng shī","abbr":"rcls","explanation":"人和钱财都无着落或都有损失。同“人财两空”。","source":{"text":"王三中了举，不久到了京，白白地要了玉堂春去，可不人财两失？","book":"《警世通言·玉堂春落难遇夫》"},"example":{"text":"他有偌多的东西在我担里，我若同了这带脚的货去，前途被他喊破，可不～。","book":"明·凌濛初《初刻拍案惊奇》卷三十六"},"similar":["人财两空"],"opposite":["两全其美"],"usage":"作谓语、定语；指人和财物都没有了"},{"id":5092,"word":"人财两空","pinyin":"rén cái liǎng kōng","abbr":"rclk","explanation":"人和钱财都无着落或都有损失。","source":{"text":"你自打算打算，这注财要耗费多少银子？归根我落个人财两空，你如何还说做得呢？","book":"《三侠五义》第三五回"},"example":{"text":"泸州遭了日本鬼子的轰炸，店铺炸毁了，亲戚人家都炸死了，因此上落得～。","book":"郭沫若《金刚坡下》"},"similar":["人才两失","鸡飞蛋打"],"opposite":["两全其美"],"usage":"作谓语、定语；指人和财物都没有了","story":["王熙凤背着太太她们为守备与张家调停婚约之争，张家父母见贾府派人来调停，自然爱势贪财，就把以前的婚约退掉，没想到他的女儿是个烈女，就自缢身亡。原婚约的男方守备之子听说金哥自缢，也投河而尽，让张李两家人财两空，凤姐坐得3000两银子"]},{"id":5093,"word":"人贫志短","pinyin":"rén pín zhì duǎn","abbr":"rpzd","explanation":"短：短小。人的处境困厄，志向也就小了。","example":{"text":"俗话说：～，马瘦毛长。"},"similar":["人穷志短","人贫志短，马瘦马长"],"opposite":["人穷志不穷"],"usage":"作谓语、定语、宾语；指穷人的志向"},{"id":5094,"word":"人贫智短","pinyin":"rén pín zhì duǎn","abbr":"rpzd","explanation":"指人一到无路可走的时候，思想迟钝，办法也就不多了。同“人穷智短”。","source":{"text":"常言道‘人贫智短’，他恁地贫困，如何怪得他失张失智？","book":"《古今小说·陈御史巧勘金钗钿》"},"example":{"text":"明·冯梦龙《喻世明言》第二卷：“常言‘～’，他恁地贫困，如何怪得他失张失智？”"},"similar":["人穷智短"],"usage":"作谓语、宾语、定语；指穷人的智力"},{"id":5095,"word":"人贵有自知之明","pinyin":"rén guì yǒu zì zhī zhī míng","abbr":"rgyzzzm","explanation":"明：聪明。指能够正确认识自己的人，才算是聪明的。","source":{"text":"知人者智，自知者明。胜人者有力，自胜者强。","book":"《老子》第三十三章"},"example":{"text":"～。名人尤其贵有自知之明。","book":"梁晓声《狡猾是一种冒险》第二章"}},{"id":5096,"word":"人贵知心","pinyin":"rén guì zhī xīn","abbr":"rgzx","explanation":"人与人相互交往，可贵的是知心。","source":{"text":"人之相知，贵相知心。","book":"汉·李陵《答苏武书》"}},{"id":5097,"word":"人贵自立","pinyin":"rén guì zì lì","abbr":"rgzl","explanation":"贵：可贵；自立：独立。一个人可贵之处是能够独立生活，不依靠别人。","source":{"text":"然尧舜之圣，初未尝因朱均而减。瞽鲧之愚，亦不能因舜禹而掩。所以人贵自立也。","book":"明·洪应明《菜根谭》"},"example":{"text":"～，如寻常儿女之哭泣穷途，自经沟渎而莫之知者，果何补耶！","book":"蔡东藩《元史演义》第三回"}},{"id":5098,"word":"人赃俱获","pinyin":"rén zāng jù huò","abbr":"rzjh","explanation":"人：犯人；赃：赃物、赃款。嫌犯与不正当取得的财物同时被捕获。","source":{"text":"牛公取笔，请张生一一写出，按名捕捉，人赃俱获，没一个逃得脱的。","book":"明·凌濛初《初刻拍案惊奇》卷三十六"},"example":{"text":"有劳牌头这许多时，今日幸得成功，～。我们一面解到州里发落去。","book":"明·凌濛初《二刻拍案惊奇》卷二十一"}},{"id":5099,"word":"人赃并获","pinyin":"rén zāng bìng huò","abbr":"rzbh","explanation":"人：犯人；赃：赃物、赃款。犯人和赃物赃款一起被捕获。","source":{"text":"你想上海的包探何等精细，金月兰又不会改头换面，不多几日，早被两个包探访了出来，立时协同巡捕，将金月兰人赃并获，解到公堂。","book":"清·张春帆《九尾龟》第十回"},"example":{"text":"鹿杖客心想你别要又让我上当，我背负韩姬出去，你声张起来，那时～，还有甚么可说的。","book":"金庸《倚天屠龙记》第二十六章"}},{"id":5100,"word":"人足家给","pinyin":"rén zú jiā jǐ","abbr":"rzjj","explanation":"同“人给家足”。人人饱暖，家家富裕。","source":{"text":"人足家给，富饶洽于公私。","book":"宋·曽巩《监司制》"},"similar":["人给家足"],"usage":"作谓语、定语；指社会繁荣"},{"id":5101,"word":"人过留名，雁过留声","pinyin":"rén guò liú míng，yàn guò liú shēng","abbr":"rglmygls","explanation":"人度过一生要留下姓名，雁飞过后要留下声音。比喻人的一生不能虚度，应做些有益于后人的事。","source":{"text":"我也闹了一辈子，人过留名，雁过留声，算是这么件事。老弟，你瞧着行得行不得？”","book":"清·文康《儿女英雄传》第三十二回"},"example":{"text":"在我们流浪的时候，你就常说，“～”，我就觉得你的个人名利心太严重了！","book":"魏巍《火凤凰》第二卷四十一"}},{"id":5102,"word":"人迹罕至","pinyin":"rén jì hǎn zhì","abbr":"rjhz","explanation":"人的足迹很少到达。指荒凉偏僻的地方。","source":{"text":"而夷狄殊俗之国，辽绝异党之地，舟车不通，人迹罕至。","book":"汉·荀悦《汉纪·孝武纪二》"},"example":{"text":"它们所以不被人知，仅仅是因为它们处在～、交通阻隔的地方。","book":"冯牧《瀑布之歌》"},"similar":["荒山野岭","穷乡僻壤"],"opposite":["人来人往","人山人海"],"usage":"作宾语、定语；指荒凉的地方"},{"id":5103,"word":"人逢喜事精神爽","pinyin":"rén féng xǐ shì jīng shén shuǎng","abbr":"rfxsjss","explanation":"人遇到喜庆之事则心情舒暢。","source":{"text":"人逢喜事精神爽，闷向心来瞌睡多。","book":"清·褚人获《隋唐演义》第七回"},"example":{"text":"现在我们很快就可以达到目的了，怎么能不高兴呢？‘～’，真是一点也不假。","book":"魏国禄《随周恩来副主席长征》"},"usage":"作宾语、定语、分句；用于人的精神面貌"},{"id":5104,"word":"人遐室迩","pinyin":"rén xiá shì ěr","abbr":"rxse","explanation":"室：房屋；迩：近。房屋就在近处，可是房屋的主人却离得远了。多用于思念远别的人或悼念死者。","source":{"text":"山川在目，室迩人遐。","book":"《诗经·郑风·东门之墠》：“其室则迩，其人甚远。”唐·骆宾王《与博昌父老书》"}},{"id":5105,"word":"人道主义","pinyin":"rén dào zhǔ yì","abbr":"rdzy","explanation":"道：道义。关心人类幸福。","source":{"text":"如果你不是以救死扶伤的革命人道主义去对待他，那无异于落井下石、谋财害命，把自己的欢乐建筑在他人的痛苦之上！","book":"王朔《你不是一个俗人》"},"example":{"text":"我们要讲～。"},"similar":["博爱主义"],"usage":"作主语、宾语、定语；指慈善方面"},{"id":5106,"word":"人镜芙蓉","pinyin":"rén jìng fú róng","abbr":"rjfr","explanation":"比喻考试将获得第一名。","source":{"text":"李固言遇一老姥，言郎君明年芙蓉镜下及第。明年果状元及第，诗赋有‘人镜芙蓉’之语。","book":"唐·段成式《酉阳杂俎》"}},{"id":5107,"word":"人间地狱","pinyin":"rén jiān dì yù","abbr":"rjdy","explanation":"人世间的活地狱。比喻黑暗的社会。","source":{"text":"许多烟鬼横在地上，像蛆虫似地在那里蠕动，吞云吐雾，活像人间地狱。","book":"叶元《林则徐》"},"example":{"text":"这里真是一座～。"},"opposite":["人间天堂"],"usage":"作宾语；比喻黑暗的社会"},{"id":5108,"word":"人间天上","pinyin":"rén jiān tiān shàng","abbr":"rjts","explanation":"人世社会和神仙世界。指景物极美好的处所。多比喻境遇完全不同。","source":{"text":"仙裙玉佩空自知，天上人间不相见。","book":"唐·崔颢《七夕词》"},"example":{"text":"真乃是～全珠。","book":"元·汤式《端正好·咏荆南佳丽》"},"similar":["人间天堂"],"usage":"作宾语、定语；用于比喻句"},{"id":5109,"word":"人间天堂","pinyin":"rén jiān tiān táng","abbr":"rjtt","explanation":"指人世间极美好的地方。","source":{"text":"山外云山天外天，人间天堂——共产主义乐园呵，到明天一定要实现！","book":"曹靖华《凭吊“新处女”》"},"example":{"text":"苏杭被称为～。"},"similar":["人间天上"],"usage":"作主语、宾语、定语；指美好的地方"},{"id":5110,"word":"人间行路难","pinyin":"rén jiān xíng lù nán","abbr":"rjxln","explanation":"在人间行走艰难。比喻世道艰险。","source":{"text":"人间行路难，踏地出赋租。不如鱼蛮子，驾浪浮空虚。","book":"宋·苏轼《鱼蛮子》词"},"example":{"text":"身外事，意阑珊。人间行路难。寻思百计不如闲，休贪朱两轓。","book":"宋·张炎《阮郎归》词"}},{"id":5111,"word":"人间重晚晴","pinyin":"rén jiān zhòng wǎn qíng","abbr":"rjzwq","explanation":"原指人们珍视晚晴天气，后多用以比喻社会上尊重德高望重的老前辈。","source":{"text":"天意怜幽草，人间重晚晴。","book":"唐·李商隐《晚晴》诗"},"usage":"作宾语、定语；用于书面语"},{"id":5112,"word":"人非土木","pinyin":"rén fēi tǔ mù","abbr":"rftm","explanation":"指人是有思想感情的。","source":{"text":"谢荷公公！张协人非土木，必有报谢之期。","book":"宋·无名氏《张协状元》第十二出"},"example":{"text":"[珠蕊小姐]念我双星如此，则言言金玉也。双星～，焉敢不从！","book":"清·无名氏《定情人》十五"},"similar":["人非草木"],"usage":"作谓语、宾语、定语；用于感叹等"},{"id":5113,"word":"人非圣贤，孰能无过","pinyin":"rén fēi shèng xián，shú néng wú guò","abbr":"rfsxsnwg","explanation":"旧时指一般人犯错误是难免的。","source":{"text":"人谁无过，过而能改，善莫大焉。","book":"春秋·鲁·左丘明《左传·宣公二年》"},"example":{"text":"你不必自责了，～。"},"opposite":["十全十美"],"usage":"作分句；用于劝诫人","story":["春秋时期，晋灵公十分残暴，滥杀无辜，大臣赵盾和士季进宫劝谏，晋灵公态度冷淡，不情愿地认错。士季说：“人谁无过，过而能改，善莫大焉。”晋灵公根本听不进，于是派人暗杀了赵盾。人们奋起反抗，赵穿将穷凶极恶的晋灵公杀死"]},{"id":5114,"word":"人非尧舜，谁能尽善","pinyin":"rén fēi yáo shùn，shuí néng jìn shàn","abbr":"rfyssnjs","explanation":"尧舜：传说中上古的两位帝王。一般的人并非尧舜那样的圣贤，谁能够尽善尽美呢。比喻人不可能没有缺点。","source":{"text":"且人非尧舜，谁能尽善？","book":"唐·李白《与韩荆州书》"}},{"id":5115,"word":"人非木石","pinyin":"rén fēi mù shí","abbr":"rfms","explanation":"指人是有思想感情的，容易为外界事物所打动，不同于无生命、无知觉、无感情的树木石头。","source":{"text":"身非木石，独与法吏为伍，深幽囹圄之中，谁可告诉者？","book":"西汉·司马迁《报任安书》"},"example":{"text":"她虽则是一个纯真的小孩子，但～，究竟总有一点感情。","book":"郁达夫《迟桂花》"},"similar":["人非草木","心非木石"],"opposite":["铁石心肠"],"usage":"作宾语、分句；常与“孰能无情”连用","story":["西汉时期，著名的史学家司马迁因汉将李陵攻打匈奴失败被迫投降一事，为李陵说了情，遭到了宫刑并被关入大牢，面对这奇耻大辱，他只好给好友任安写信倾诉他的不幸：“身非木石，独与法吏为伍，深幽囹圄之中，谁可告诉者？”"]},{"id":5116,"word":"人非物是","pinyin":"rén fēi wù shì","abbr":"rfws","explanation":"指人事变迁，景物依旧。","source":{"text":"蓬莱院月悴花憔，昭阳殿人非物是。","book":"清·洪昇《长生殿·寄情》"},"similar":["物是人非"],"usage":"作谓语、宾语、定语；指怀念故人"},{"id":5117,"word":"人非草木","pinyin":"rén fēi cǎo mù","abbr":"rfcm","explanation":"指人是有思想感情的，容易为外界事物所打动，不同于无生命、无知觉、无感情的树木石头。同“人非木石”。","source":{"text":"众人道：‘上复观察，小人们人非草木，岂不省的？’","book":"明·施耐庵《水浒传》第十七回"},"example":{"text":"庞涓复问曰：‘然则兄长亦还忆故乡坟墓否？’膑曰：‘～，能忘本原？’先生于吾临行，亦言：‘功名终在故土。","book":"《东周列国志》第八十八回"},"similar":["人非木石"],"usage":"作宾语、分句；常与“孰能无情”连用"},{"id":5118,"word":"人面兽心","pinyin":"rén miàn shòu xīn","abbr":"rmsx","explanation":"面貌虽然是人，但心肠象野兽一样凶狠。形容为人凶残卑鄙。","source":{"text":"被发左衽，人面兽心。","book":"《列子·黄帝》：“夏桀、殷纣、鲁醒、楚穆，状貌七窍皆同于人，而有禽兽之心。”《汉书·匈奴传赞》"},"example":{"text":"大虫见了“兽面人心”的既不敢伤，若见了“～”的如何不啖。","book":"清·李汝珍《镜花缘》第十回"},"similar":["人头畜鸣","狼心狗肺","衣冠禽兽"],"opposite":["正人君子"],"usage":"作谓语、宾语、定语；指人的品行","story":["杨朱特地请老子到家里请教问题，老子给他将各种各样的为人，圣人都是看心智的而不是看外表，凡人则看中人的外表。伏羲氏、女娲氏、神农氏都是蛇身人面，牛头虎鼻，没有人的外表。而夏桀、殷纣、鲁桓、楚穆这些人面兽心的家伙危害人间"]},{"id":5119,"word":"人面桃花","pinyin":"rén miàn táo huā","abbr":"rmth","explanation":"形容男女邂逅钟情，随即分离之后，男子追念旧事的情形。","source":{"text":"去年今日此门中，人面桃花相映红。人面不知何处去，桃花依旧笑春风。","book":"唐·崔护《题都城南庄》诗"},"example":{"text":"蝉联岁华，怕游丝到处将春挂，闷孤眠帐额芙蓉，可重逢～。","book":"明·梅鼎祚《玉合记·言祖》"},"similar":["人去楼空"],"opposite":["长相厮守"],"usage":"作定语、宾语；用于忆念爱人","story":["唐朝节度使崔护年轻时进京赶考落第，清明节去长安城南郊游，在一桃花盛开的庄园内见到一漂亮女子含情脉脉，彼此眉目传情。第二年清明再访，见不到该女。题诗“去年今日此门中，人面桃花相映红。人面不知何处去，桃花依旧笑春风”"]},{"id":5120,"word":"人面狗心","pinyin":"rén miàn gǒu xīn","abbr":"rmgx","explanation":"①比喻容貌美好而才学低下的人。②犹言人面兽心。","source":{"text":"朗曰：‘吏部为谁，非人面而狗心，狗面而人心兄弟者乎？’王忱丑而才慧，国宝美貌而才劣于弟，故朗云然。","book":"《晋书·苻朗载记》"},"example":{"text":"鲁迅《书信集·致曹靖华》：“上海之所谓‘文人’，有些真是坏到出乎意料之外，即～，恐亦不至于此。”"},"similar":["人面兽心"],"usage":"作谓语、宾语、定语；指人的品行"},{"id":5121,"word":"人面逐高低","pinyin":"rén miàn zhú gāo dī","abbr":"rmzgd","explanation":"人面：人情；逐：追逐。指人与人之间的情谊随着对方地位和钱财的变化而变化。","source":{"text":"到的这柴门前便唤咱儿名讳，他那里默无声弄盏传杯。一个个紧低头不睬佯妆醉，方信道人面逐高低。","book":"元·王子一《误入桃源》第三折"},"example":{"text":"世情看冷暖，～。你当初有钱是个财主，人自然趋奉你。","book":"明·冯梦龙《醒世恒言》卷三十七"}},{"id":5122,"word":"人面逐高低，世情着冷暖","pinyin":"rén miàn zhú gāo dī，shì qíng zháo lěng nuǎn","abbr":"rmzgdsqzln","explanation":"指世风日下，对人的态度随地位和权势的高低有所不同。","source":{"text":"常言道：‘人面逐高低，世情着冷暖。’冯主事虽然欠下老爷银两，见老爷死了，你又在难中，谁肯唾手交还？","book":"明·冯梦龙《古今小说》第40回"},"example":{"text":"～，你不可太认真。"},"usage":"作宾语、分句；指人情世故","story":["明朝时期，奸相严嵩父子专权，忠臣沈符因揭露他们的劣迹被害至死，子女被流放。严嵩吩咐押解差官张千、李万在途中杀死沈小霞及其妻闻氏，被沈小霞识破，借口中途讨要巨款逃脱。正是人面逐高低，世情着冷暖。八年后严嵩倒台，他们夫妻才团聚"]},{"id":5123,"word":"人面鬼心","pinyin":"rén miàn guǐ xīn","abbr":"rmgx","explanation":"指表面很好，内心很坏。","example":{"text":"我们要提防那些～的人。"},"similar":["人面兽心"],"opposite":["菩萨心肠"],"usage":"作谓语、定语；指心肠坏"},{"id":5124,"word":"人面鸟咮","pinyin":"rén miàn niǎo shòu","abbr":"rmnz","explanation":"鸟咮：鸟嘴。虽有人的面貌却有鸟一样的嘴。形容有杰出才能的人相貌不凡。","source":{"text":"中行衍，人面鸟咮。降佐太戊及周天子，皆有明德。","book":"汉·刘向《新序》"}},{"id":5125,"word":"人马平安","pinyin":"rén mǎ píng ān","abbr":"rmpa","explanation":"人和马都安全。比喻旅途顺利。","source":{"text":"我若是到荆樊，则原得人马平安，稳情取峥嵘现眼。","book":"元·郑德辉《王粲登楼》第一折"},"example":{"text":"梁山泊自此～，都无甚事，每日在山寨中教演武艺，操练人马。","book":"明·施耐庵《水浒全传》第七十四回"}},{"id":5126,"word":"人鼠之叹","pinyin":"rén shǔ zhī tàn","abbr":"rszt","explanation":"感叹人与人之间的地位悬殊。","source":{"text":"于是李斯乃叹曰：‘人之贤、不肖，譬如鼠矣，在所自处耳！’","book":"西汉·司马迁《史记·李斯列传》"},"example":{"text":"看到贵族与平民，人们难免会有～。"},"usage":"作宾语；指人与人的差距","story":["秦朝大臣李斯年轻时上厕所见到老鼠争吃蛆吃，见到人来后仓皇逃跑，到官仓时见到老鼠们正在细嚼慢咽，根本不理会人。李斯不由感慨万分，同是老鼠竟有天壤之别，生活的环境不同，爬上去为贤者、君子，沦落下层的就是愚民、小人"]},{"id":5127,"word":"亿万斯年","pinyin":"yì wàn sī nián","abbr":"ywsn","explanation":"斯：语助词，无义。亿万年。形容长远的年代。旧时多用于祝国运绵长。","source":{"text":"于万斯年，受天之祜。","book":"《诗经·大雅·下武》"},"example":{"text":"～，福禄攸同。","book":"《宋史·乐志》"},"usage":"作宾语、状语；多用于祝国运绵长"},{"id":5128,"word":"亿兆一心","pinyin":"yì zhào yī xīn","abbr":"yzyx","explanation":"全国人民一条心。","source":{"text":"亿兆一心，战则必胜。还我河山，卫我国权。","book":"毛泽东《祭文·祭黄帝陵》诗"}},{"id":5129,"word":"亿则屡中","pinyin":"yì zé lǚ zhòng","abbr":"yzlz","explanation":"亿：通“臆”；中：正中。料事总是能与实际相符。","source":{"text":"赐不受命，而货殖焉，亿则屡中。","book":"《论语·先进》"},"example":{"text":"庶几所谓不惑，而非依仿象类、～者。","book":"《宋史·邵雍传》"}},{"id":5130,"word":"亿忌信谗","pinyin":"yì jì xìn chán","abbr":"yjxc","explanation":"亿忌：通“意忌”，猜忌；谗：谗言。怀疑忌妒，听信谗言。","source":{"text":"大王诚能出捐数万斤金，行反间，间其君臣，以疑其心，项王为人意忌信谗，必内相诛。","book":"《史记·陈丞相世家》"}},{"id":5131,"word":"亿辛万苦","pinyin":"yì xīn wàn kǔ","abbr":"yxwk","explanation":"极言辛苦之甚。","source":{"text":"民既托庇于其下，在理当负斯责，亿辛万苦，其又何辞。","book":"李大钊《大哀篇》"},"similar":["千辛万苦"],"usage":"作宾语、定语；用于书面语"},{"id":5132,"word":"什一之利","pinyin":"shí yī zhī lì","abbr":"syzl","explanation":"什一：十分之一。泛指商人得到的利润。","source":{"text":"恽幸有余禄，方籴贱贩贵，逐什一之利，此贾竖之事，污辱之处，恽亲行之。","book":"《汉书·杨恽传》"},"example":{"text":"明·冯梦龙《东周列国志》第90回：“季子不治耕获，力工商，求～，乃思以口舌博富贵，并见成之业。”"},"usage":"作宾语；用于商业等"},{"id":5133,"word":"什伍东西","pinyin":"shí wǔ dōng xī","abbr":"swdx","explanation":"什伍：纵横错杂。原指南斗六星，牵牛六星，箕四星等分布得杂乱无章。后多形容事物错杂纷乱。","source":{"text":"名声相乘除，得少失有余。三星各在天，什伍东西陈。","book":"唐·韩愈《三星行》诗"},"similar":["杂乱无章"],"usage":"作定语、状语；用于书面语"},{"id":5134,"word":"什围伍攻","pinyin":"shí wéi wǔ gōng","abbr":"swwg","explanation":"古时兵法，谓以十敌一则围歼之，以五敌一则攻击之。参见“十围五攻”。","source":{"text":"古之善用兵者，虽能以寡覆众，而什围伍攻之道未尝忽焉。","book":"宋·秦观《李陵论》"},"example":{"text":"～兵法存，发踪指示知何人。","book":"明·詹同《出猎图》诗"},"similar":["十围五攻"],"usage":"作宾语、定语；用于军事"},{"id":5135,"word":"什袭以藏","pinyin":"shí xí yǐ cáng","abbr":"sxyc","explanation":"什：形容多；袭：重迭。一层又一层把东西包裹起来。形容十分珍重地收藏好物品。同“什袭而藏”。","source":{"text":"人家竞相传钞，什袭以藏。","book":"清·李绿园《歧路灯》第九十五回"},"similar":["什袭而藏"],"usage":"作谓语；形容极珍重地收藏物品","story":["春秋时期，有个宋国人在梧台东边拾到一块燕石，觉得很漂亮，以为是价值连城的宝贝，带回家用十层绸布包裹，再里外用十个木箱包装，并到处宣扬他得到一块宝玉，邻居要求展示，他郑重其事地打开让人观看。邻居说这只是一块普通石头"]},{"id":5136,"word":"什袭珍藏","pinyin":"shí xí zhēn cáng","abbr":"sxzc","explanation":"什：形容多；袭：量词，套，层。将物品层层包裹，珍重地藏好。形容极珍重地收藏物品。","source":{"text":"宋之愚人得燕石于梧台之东，归而藏之，以为大宝。周客闻而观焉。主人冕玄服以发宝。华匮十重，缇巾十袭。","book":"《太平御览》卷五十一引《阚子》"},"example":{"text":"今日无意中落于君手，此乃无价之宝，须～，不可轻示于人也。","book":"明·冯梦龙《东周列国志》第九十六回"},"similar":["什袭以藏","什袭尔藏","什袭而藏"],"usage":"作谓语；形容极珍重地收藏物品"},{"id":5137,"word":"什袭而藏","pinyin":"shí xí ér cáng","abbr":"sxec","explanation":"什：形容多；袭：量词，套，层。将物品层层包裹，珍重地藏好。形容极珍重地收藏物品。","source":{"text":"宋之愚人得燕石于梧台之东，归而藏之，以为大宝。周客闻而观焉。主人冕玄服以发宝。华匮十重，缇巾十袭。","book":"《太平御览》卷五十一引《阚子》"},"example":{"text":"此书无一字刓缺，当与夏璜赵璧什袭而藏。","book":"宋·张守《跋唐千文帖》"},"similar":["什袭珍藏","什袭以藏"],"usage":"作谓语；形容极珍重地收藏物品","story":["春秋时期，有个宋国人在梧台东边拾到一块燕石，觉得很漂亮，以为是价值连城的宝贝，带回家用十层绸布包裹，再里外用十个木箱包装，并到处宣扬他得到一块宝玉，邻居要求展示，他郑重其事地打开让人观看。邻居说这只是一块普通石头"]},{"id":5138,"word":"仁义之兵","pinyin":"rén yì zhī bīng","abbr":"ryzb","explanation":"兵：军队。伸张仁爱正义讨伐邪恶的军队。同“仁义之师”。","source":{"text":"丞相兴仁义之兵，吊民伐罪，官渡一战，破袁绍百万之众。","book":"明·罗贯中《三国演义》第三十一回"}},{"id":5139,"word":"仁义之师","pinyin":"rén yì zhī shī","abbr":"ryzs","explanation":"师：军队。伸张仁爱正义讨伐邪恶的军队。亦作“仁义之兵”。","source":{"text":"君候起仁义之师，吊民伐罪，四海引领而望，孰不归心？","book":"明·罗贯中《三国演义》第一一五回：“吾欲兴仁义之师，伐无道之主，汝安敢逆吾意！”明·方汝浩《禅真逸史》第十九回"},"example":{"text":"如此说来，虽然谋叛之徒，倒也忠义可嘉。本帅～，何愁杨枭不灭。","book":"清·钱彩《说岳全传》第四十九回"},"similar":["仁义之兵"],"usage":"作主语、宾语；用于称赞军队"},{"id":5140,"word":"仁义君子","pinyin":"rén yì jūn zǐ","abbr":"ryjz","explanation":"原指好心肠的正派人，后泛指能热心帮助别人的人。","source":{"text":"戮过其罪，死不可生，纵虐于此，岁以巨计，此乃仁义君子所不忍闻，而况行之于政乎？","book":"《晋书·刑法志》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":5141,"word":"仁义礼智","pinyin":"rén yì lǐ zhì","abbr":"rylz","explanation":"仁：仁爱；义：忠义；礼：礼仪；智：见识。遵守仁爱、忠信、礼仪并勤学以增见识等伦理规范。是儒家的伦理思想。","source":{"text":"仁之实，事亲是也；义之实，从兄是也；智之实，知斯二者弗去是也；礼之实，节文斯二者是也。","book":"《孟子·离娄上》"},"example":{"text":"若论～，主行忠良，却是不会。","book":"明·施耐庵《水浒全传》第二回"}},{"id":5142,"word":"仁义道德","pinyin":"rén yì dào dé","abbr":"rydd","explanation":"泛指旧时鼓吹的道德规范。","source":{"text":"后之人，其欲闻仁义道德之说，孰从而听之。","book":"唐·韩愈《原道》"},"example":{"text":"你说凡是一口～的人，都是些伪君子，真是一点也不错。","book":"郭沫若《屈原》第二幕"},"usage":"作宾语、定语；指旧道德标准"},{"id":5143,"word":"仁人义士","pinyin":"rén rén yì shì","abbr":"rrys","explanation":"有德行并信守节义的人。","source":{"text":"古之仁人义士，视刀锯如饮食。","book":"明·方孝孺《云敝赞》"},"example":{"text":"然而我们从古典里，听熟了～，来解倒悬的胡说了。","book":"鲁迅《花边文学·倒提》"},"similar":["仁人志士"],"usage":"作主语、宾语、定语；有德行节义的人"},{"id":5144,"word":"仁人君子","pinyin":"rén rén jūn zǐ","abbr":"rrjz","explanation":"仁：仁爱。旧称好心肠的正派人。亦用作反语讽刺伪君子。","source":{"text":"刑之则止，而加之斩戮，戮过其罪，死不可生，纵虐于此，岁以巨计，此乃仁人君子所不忍闻，而况行之政乎？","book":"《晋书·刑法志》"},"example":{"text":"处于布衣窘迫之中，千金不改其志，端的是～也。","book":"元·关汉卿《裴度还带》第三折"},"similar":["正人君子"],"usage":"作主语、宾语、定语；指好心人"},{"id":5145,"word":"仁人志士","pinyin":"rén rén zhì shì","abbr":"rrzs","explanation":"原指仁爱而有节操，能为正义牺牲生命的人。现在泛指爱国而为革命事业出力的人。","source":{"text":"志士仁人，无求生以害仁，有杀身以成仁。","book":"《论语·卫灵公》"},"example":{"text":"大批～，满腔悲愤，万种辛酸，想有所为而不能为，真是英雄无用武之地。","book":"郭沫若《科学的春天》"},"similar":["志士仁人"],"usage":"作主语、宾语、定语；有信守节义的人","story":["春秋时期，孔子的弟子问仁德忠义与生命发生冲突怎么办？孔子说：“真正的志士仁人都不会因为贪生怕死而损害仁义，为了成全仁德，可以不顾自己的生命。”子贡问怎样培养仁德，孔子回答必须从上面作起，带动百姓效仿"]},{"id":5146,"word":"仁同一视","pinyin":"rén tóng yī shì","abbr":"rtys","explanation":"犹言一视同仁。","source":{"text":"於戏！庆衍无疆，既正名于国，本仁同一视，尚均福于黎元。","book":"《元典章·诏令一·成宗立皇太子诏》"},"similar":["一视同仁"],"usage":"作谓语、定语、状语；形容平等对待"},{"id":5147,"word":"仁心仁术","pinyin":"rén xīn rén shù","abbr":"rxrs","explanation":"心地仁慈，医术高明。","source":{"text":"今有仁心仁闻，而民不被其泽，不可法于后世者，不行先王之道也。","book":"《孟子·离娄上》"},"example":{"text":"他送给张医生一块牌匾，上面写着～四字，表扬张医生医德高尚，医术精湛。"},"usage":"作宾语；指称颂医生"},{"id":5148,"word":"仁心仁闻","pinyin":"rén xīn rén wén","abbr":"rxrw","explanation":"闻：出名，有声望。有仁慈的心肠，有仁爱的声誉。","source":{"text":"今有仁心仁闻，而民不被其泽，不可法于后世者，不行先王之道也。","book":"《孟子·离娄上》"},"usage":"作宾语、定语；用于书面语"},{"id":5149,"word":"仁柔寡断","pinyin":"rén róu guǎ duàn","abbr":"rrgd","explanation":"谓柔弱而缺乏主见。","source":{"text":"其孱弱少用如此，是则仁柔寡断之主，汉献、唐昭之俦耳！","book":"章炳麟《驳康有为论革命书》"},"similar":["优柔寡断"],"usage":"作谓语、定语、宾语；指人不果断"},{"id":5150,"word":"仁民爱物","pinyin":"rén mín ài wù","abbr":"rmaw","explanation":"仁：仁爱。对人亲善，进而对生物爱护。旧指官吏仁爱贤能。","source":{"text":"君子之于物也，爱人而弗仁；于民也，仁之而弗亲，亲亲而仁民，仁民而爱物。","book":"《孟子·尽心上》"},"example":{"text":"至于畏天事神，～之际，未尝有须臾懈也。","book":"宋·曾巩《移沧州过阙上殿札子》"},"usage":"作谓语、宾语、定语；用于官吏"},{"id":5151,"word":"仁浆义粟","pinyin":"rén jiāng yì sù","abbr":"rjys","explanation":"指施舍给人的钱米。","source":{"text":"于是丰富之家各出义谷，助官禀贷。","book":"《搜神记·杨伯雍》：“公汲水作义于坂头，行者皆饮之。”《后汉书·黄昏传》"},"usage":"作宾语、定语；用于书面语"},{"id":5152,"word":"仁者不杀","pinyin":"rén zhě bù shā","abbr":"rzbs","explanation":"杀：杀生。有仁爱之心的人爱万物而不杀生。","source":{"text":"仁者，不杀之禁也。","book":"北齐·颜之推《颜氏家训·归心》"}},{"id":5153,"word":"仁者乐山","pinyin":"rén zhě yào shān","abbr":"rzls","explanation":"具有仁义之心的人安于义理，不为功名利禄所动摇，象山一样稳固不动。","source":{"text":"知者乐山，仁者乐山，知者动，仁者静，知者乐，仁者寿。","book":"《论语·雍也》"}},{"id":5154,"word":"仁者必寿","pinyin":"rén zhě bì shòu","abbr":"rzbs","explanation":"寿：长寿。仁德的人一定会长寿。","source":{"text":"知者动，仁者静，知者乐，仁者寿。","book":"《论语·雍也》"},"example":{"text":"贤者必贵，～，人之所欲也。","book":"宋·苏轼《邵茂诚诗集叙》"}},{"id":5155,"word":"仁者能仁","pinyin":"rén zhě néng rén","abbr":"rznr","explanation":"旧指有身份的人所做的事总是有理。","source":{"text":"卖弄你仁者能仁，倚仗你身里出身。","book":"元·王实甫《西厢记》第五本第三折"},"example":{"text":"都只为美貌潘安，～，一会家心中自忖，谁与俺通个殷勤。","book":"元·白朴《东墙记》第一折"},"usage":"作宾语、定语；用于书面语"},{"id":5156,"word":"仁者见仁，智者见智","pinyin":"rén zhě jiàn rén，zhì zhě jiàn zhì","abbr":"rzjrzzjz","explanation":"仁者见它说是仁，智者见它说是智。比喻对同一个问题，不同的人从不同的立场或角度有不同的看法。","source":{"text":"仁者见之谓之仁，智者见之谓之智。","book":"《周易·系辞上》"},"example":{"text":"俗话说：～，所以我们对这些人的看法应该理解。"},"similar":["各执己见"],"opposite":["异口同声"],"usage":"作主语、分句；形容对某问题的不同看法"},{"id":5157,"word":"仁至义尽","pinyin":"rén zhì yì jìn","abbr":"rzyj","explanation":"至：极，最；尽：全部用出。竭尽仁义之道。指人的善意和帮助已经做到了最大限度。","source":{"text":"蜡之祭，仁之至，义之尽也。","book":"《礼记·郊特牲》"},"example":{"text":"况且他们还说和我们共同管理，总算是～的了！","book":"冰心《斯人独憔悴》"},"similar":["无微不至","急公好义"],"opposite":["漠不关心"],"usage":"作谓语、定语、宾语；指尽心尽力的最大限度"},{"id":5158,"word":"仁言利博","pinyin":"rén yán lì bó","abbr":"rylb","explanation":"博：多，广。指有仁德的人说一句话，别人就能得到很大的好处。","source":{"text":"仁人之言，其利博哉。晏子一言而齐侯省刑。","book":"《左传·昭公三年》"},"similar":["仁言利溥"],"usage":"作谓语、定语；用于称赞人"},{"id":5159,"word":"仁言利溥","pinyin":"rén yán lì pǔ","abbr":"rylp","explanation":"指有德行的人说的话益处很大。","source":{"text":"仁人之言，其利溥如此哉！","book":"清·王夫之《读通鉴论·后汉光武二十》"},"example":{"text":"号电诵悉，关怀桑梓，～，至堪钦佩。","book":"孙中山《致上海各粤侨团体书》"},"similar":["仁言利博"],"usage":"作谓语、定语；用于称赞人"},{"id":5160,"word":"仅以身免","pinyin":"jǐn yǐ shēn miǎn","abbr":"jysm","explanation":"仅：才能够；身：自身；免：避免。指没有被杀或只身逃出了险境。","source":{"text":"齐王逃遁走莒，仅以身免。“","book":"《战国策·燕策二》"},"example":{"text":"难（句难）等相率北走，～。","book":"《晋书·谢玄传》"},"usage":"作分句；指除了生命以外其他都损失了"},{"id":5161,"word":"仅容旋马","pinyin":"jǐn róng xuán mǎ","abbr":"jrxm","explanation":"指住宅地方狭小。","source":{"text":"治第封丘门内，厅事前仅容旋马。","book":"《宋史·李沆传》"},"usage":"作谓语、定语；指地方小"},{"id":5162,"word":"仅此而已","pinyin":"jǐn cǐ ér yǐ","abbr":"jcey","explanation":"只有这样罢了。","source":{"text":"不过，一切也都仅此而已了。","book":"路遥《平凡的世界》第一卷第11章"},"example":{"text":"这儿的条件很差，好的东西～。"},"usage":"作谓语、状语、分句；指唯独如此"},{"id":5163,"word":"仅识之无","pinyin":"jǐn shí zhī wú","abbr":"jszw","explanation":"之无：指最简单的字。形容识字不多。","source":{"text":"张曰：‘我仅识之无耳？乌能是？’道士笑曰：‘迂哉，名医何必多识字乎，但行之耳！’","book":"清·蒲松龄《聊斋志异·医术》"},"similar":["略识之无"],"opposite":["学富五车"],"usage":"作谓语、定语；形容识字不多"},{"id":5164,"word":"仆仆亟拜","pinyin":"pú pú jí bài","abbr":"ppjb","explanation":"一再作揖行礼。","source":{"text":"子思以为鼎肉使己仆仆尔亟拜也，非养君子之道也。","book":"语出《孟子·万章下》"},"example":{"text":"他只管那样～，我这里一点不知，彼有所施，我无所受，徒然对了那木头牌子去拜，何苦呢！","book":"《二十年目睹之怪现象》第四二回"},"usage":"作谓语、定语；用于书面语"},{"id":5165,"word":"仆仆道途","pinyin":"pú pú dào tú","abbr":"ppdt","explanation":"奔走于道路。形容途中劳顿。","source":{"text":"如客店必照例造报月一陈核，则仆仆道途，不胜其苦矣。","book":"清·严如熤《三省边防备览·策略》"},"example":{"text":"它嫂平安，惟它兄～，不知身体如何耳。","book":"鲁迅《书信集·致曹靖华》"},"usage":"作谓语；用于旅途"},{"id":5166,"word":"仆仆风尘","pinyin":"pú pú fēng chén","abbr":"ppfc","explanation":"仆仆：行路劳累的样子；风尘：指行旅，含有辛苦之意。形容奔波忙碌，旅途劳累。","source":{"text":"你索是远路风尘的故人。","book":"元·尚仲贤《柳毅传书》"},"example":{"text":"又想菲亚～，席不暇暖，现在又被囚系，少不免担惊受苦。","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"similar":["风尘仆仆"],"usage":"作谓语；形容奔波忙碌，旅途劳累"},{"id":5167,"word":"仆妾为雀鼠","pinyin":"pú qiè wéi què shǔ","abbr":"pqwqs","explanation":"旧时比喻女子、小人离间主人兄弟之间的关系，像鸟雀和老鼠在房上和房基里打洞一样危害家庭。","source":{"text":"譬犹居室，一穴则塞之，一穴则涂之，则无颓毁之。如雀鼠之不恤，风雨之不防，壁陷楹沦，无可救矣。仆妾之为雀鼠，妻子之为风雨，甚哉。","book":"北齐·颜之推《颜氏家训·兄弟》"}},{"id":5168,"word":"仆旗息鼓","pinyin":"pū qí xī gǔ","abbr":"pqxg","explanation":"息：停止。放倒旗子，停止敲鼓。原指隐蔽行军，不暴露目标。现比喻无声无息地停止运动。","source":{"text":"会蛮踵来，还攻大度河，仆旗息鼓。","book":"《新唐书·南蛮传》"},"similar":["偃旗息鼓","掩旗息鼓"],"opposite":["大张旗鼓"],"usage":"作谓语、定语、宾语；比喻停止斗争等"},{"id":5169,"word":"仇人相见，分外明白","pinyin":"chóu rén xiāng jiàn，fèn wài míng bai","abbr":"crxjfwmb","explanation":"指当敌对的双方相逢时，彼此对对方都格外警觉和敏感。","source":{"text":"可不道仇人相见，分外明白。","book":"元·李致远《还牢末》第四折"},"similar":["仇人相见，分外眼明"],"usage":"作宾语、定语、分句；用于小说等"},{"id":5170,"word":"仇人相见，分外眼明","pinyin":"chóu rén xiāng jiàn，fèn wài yǎn míng","abbr":"crxjfwym","explanation":"指当敌对的双方相逢时，彼此对对方都格外警觉和敏感。","source":{"text":"燕青牵了那匹千里龙驹，径到大寨。宋江看了大喜，仇人相见，分外眼明。","book":"明·施耐庵《水浒传》六十八回"},"example":{"text":"有一天，冤家路窄，这一位守备……在马路上大声叫‘东洋车’。被他看见了，真是～。”","book":"《二十年目睹之怪现状》第十回"},"similar":["仇人相见，分外明白"],"opposite":["恩人相见，分外眼青"],"usage":"作宾语、定语、分句；用于小说等"},{"id":5171,"word":"仇人相见，分外眼睁","pinyin":"chóu rén xiāng jiàn，fèn wài yǎn zhēng","abbr":"crxjfwyz","explanation":"指当敌对的双方相逢时，彼此对对方都格外警觉和敏感。","source":{"text":"相公所见极是明理；只是仇人相见，分外眼睁，这几日何如好过！","book":"《醒世恒言·蔡瑞虹忍辱报仇》"},"example":{"text":"宋江看了，心中一喜一怒：喜者得卢员外建功，怒者恨史文恭射杀晁天王，～。","book":"《水浒传》第六八回"},"similar":["仇人相见，分外眼红"],"usage":"作宾语、分句；用于敌对双方相逢时"},{"id":5172,"word":"仇人相见，分外眼红","pinyin":"chóu rén xiāng jiàn，fèn wài yǎn hóng","abbr":"crxjfwyh","explanation":"眼红：激怒的样子。仇敌碰在一起，彼此更加激怒。","source":{"text":"仇人相见，分外眼明，我领着大人的言语，拿李孔目去来。","book":"元·李政远《还牢末》第一折"},"example":{"text":"那太子～，赶上一步，揪住乌云宝髻，大骂：“贱婢！你是何等之人？”","book":"明·冯梦龙《东周列国志》第二回"},"similar":["仇人见面，分外眼红"],"opposite":["恩人相见，分外眼青"],"usage":"作宾语、分句；指敌对双方相逢时愤怒的样子"},{"id":5173,"word":"仇人见面，分外眼红","pinyin":"chóu rén jiàn miàn，fèn wài yǎn hóng","abbr":"crjmfwyh","explanation":"眼红：激怒的样子。仇敌碰在一起，彼此更加激怒。","source":{"text":"真是仇人见面，分外眼红。","book":"赖传珠《模范红五团的新荣誉》"},"example":{"text":"赖传珠《模范红五团的新荣誉》：“真是～。”"},"similar":["仇人相见，分外眼红"],"usage":"作宾语、分句；指敌对双方相逢时愤怒的样子"},{"id":5174,"word":"今不如昔","pinyin":"jīn bù rú xī","abbr":"jbrx","explanation":"昔：往昔，过去。现在不如过去。多用于表示对世事的不满情绪。","source":{"text":"洪觉范《冷斋夜话》，谓山谷嫡宜州，殊坦夷，作诗曰：‘老色日上面，欢宗日去心，今既不如昔，后当不如今。","book":"宋·吴曾《能改斋漫录·冷斋不读书》"},"example":{"text":"你不能老是有～的想法。"},"similar":["每况愈下"],"opposite":["今非昔比","昔不如今"],"usage":"作宾语、定语；表示对世事的感慨"},{"id":5175,"word":"今古奇观","pinyin":"jīn gǔ qí guān","abbr":"jgqg","explanation":"奇观：奇异的景象。指古今奇怪而少见的事。","source":{"text":"所恨者新丧未久，况且女求于男，难以启齿。","book":"明·抱瓮老人《今古奇观·庄子休鼓盆成大道》"},"example":{"text":"这种现象真是～。"},"similar":["海外奇闻"],"usage":"作宾语、定语；指奇异的景象"},{"id":5176,"word":"今吾非故吾","pinyin":"jīn wǔ fēi gù wǔ","abbr":"jwfgw","explanation":"吾：我；故：过去。今天的我不是过去的我了。指对过去有悔悟、否定的意思。","source":{"text":"年光除日又元日，心事今吾非故吾。","book":"宋·王炎《元日书怀诗》"}},{"id":5177,"word":"今夕何夕","pinyin":"jīn xī hé xī","abbr":"jxhx","explanation":"今夜是何夜？多用作赞叹语。指此是良辰。","source":{"text":"扣舷独笑，不知今夕何夕。","book":"《诗经·唐风·绸缪》：“今夕何夕？见此良人。”宋·张孝祥《念奴娇·过洞庭》词"},"example":{"text":"歌云：～？存耶？没耶？良人去兮天之涯，园树伤心兮三见花。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"usage":"作宾语、分句；用于赞叹语"},{"id":5178,"word":"今夕有酒今夕醉","pinyin":"jīn xī yǒu jiǔ jīn xī zuì","abbr":"jxyjjxz","explanation":"今天有酒则今天痛饮。形容人只顾眼前享乐，没有长远打算。","source":{"text":"你的危言诤论，并不能叫小杜居安思危，反使得他决心去及时行乐，今夕有酒今夕醉！","book":"茅盾《子夜》"},"similar":["今朝有酒今朝醉"],"usage":"作宾语、定语、分句；用于处世"},{"id":5179,"word":"今愁古恨","pinyin":"jīn chóu gǔ hèn","abbr":"jcgh","explanation":"愁：忧愁；恨：怨恨。古今的恨事。形容感慨极多。","source":{"text":"今愁古恨入丝竹，一曲凉州无限情。","book":"唐·白居易《题灵岩寺》诗"},"usage":"作主语、宾语；形容感慨极多"},{"id":5180,"word":"今日有酒今日醉","pinyin":"jīn rì yǒu jiǔ jīn rì zuì","abbr":"jryjjrz","explanation":"比喻过一天算一天。也形容人只顾眼前，没有长远打算。同“今朝有酒今朝醉”。","source":{"text":"他们这种‘自信’，这种‘有前途’的自觉，就使得他们的要求快乐跟罗马帝国衰落时代的有钱人的纵乐完全不同，那时罗马的有钱人感得大难将到而又无可挽救，于是‘今日有酒今日醉’了。","book":"茅盾《狂欢的解剖》"},"similar":["今夕有酒今夕醉"],"usage":"作宾语、定语、谓语；用于处世"},{"id":5181,"word":"今昔之感","pinyin":"jīn xī zhī gǎn","abbr":"jxzg","explanation":"从今天的现实回忆过去的事。","source":{"text":"今日卿等老者少者，存者没者，俱不一其人；使朕不胜今昔之感，所以郁郁不乐耳。","book":"明·许仲琳《封神演义》第九十八回"},"example":{"text":"诸旧好俱在，谭孝老已作古人。～，凄怆莫状。","book":"清·李绿园《歧路灯》第十四回"},"usage":"作宾语；表示对世事的感慨"},{"id":5182,"word":"今是昔非","pinyin":"jīn shì xī fēi","abbr":"jsxf","explanation":"现在是对的，过去是错的。指认识过去的错误。同“今是昨非”。","source":{"text":"若其今是昔非，不觚而觚者，百固不能二三也。","book":"明·王世贞《觚不觚录》"},"similar":["今是昨非"],"usage":"作宾语、定语、分句；形容人悔恨以前的错误"},{"id":5183,"word":"今是昨非","pinyin":"jīn shì zuó fēi","abbr":"jszf","explanation":"现在是对的，过去是错的。指认识过去的错误。","source":{"text":"实迷途其未远，觉今是而昨非。","book":"晋·陶潜《归去来辞》"},"example":{"text":"但我们究竟还有一点记忆，回想起来，怎样的“～”呵，怎样的“口是心非”呵，怎样的“今日之我与昨日之我战”呵。","book":"鲁迅《导师》"},"similar":["今非昔比","今是昔非"],"usage":"作宾语、定语、分句；形容人悔恨以前的错误"},{"id":5184,"word":"今月古月","pinyin":"jīn yuè gǔ yuè","abbr":"jygy","explanation":"指月亮古今如一，而人事代谢无常。","source":{"text":"今人不见古时月，今月曾经照古人。","book":"唐·李白《把酒问月》诗"},"usage":"作宾语、定语；表示感慨人事代谢无常"},{"id":5185,"word":"今朝有酒今朝醉","pinyin":"jīn zhāo yǒu jiǔ jīn zhāo zuì","abbr":"jzyjjzz","explanation":"比喻过一天算一天。也形容人只顾眼前，没有长远打算。","source":{"text":"今朝有酒今朝醉，明日愁来明日愁。","book":"唐·罗隐《自遣》诗"},"example":{"text":"不能～，还应该节省点，拿出一部分救济穷苦的老百姓。","book":"魏文建《华阳游击队》"},"similar":["及时行乐"],"usage":"作宾语、分句；形容人只顾眼前","story":["唐朝时期，诗人罗隐从小勤奋好学，才识过人，他胸怀大志要报效国家，可是两次考进士都名落孙山。他从此消沉下去，不再追逐功名，回浙江余杭隐居，他作《自遣》诗来安慰自己：“今朝有酒今朝醉，明日愁来明日愁。”"]},{"id":5186,"word":"今来古往","pinyin":"jīn lái gǔ wǎng","abbr":"jlgw","explanation":"犹古往今来。从古到今。泛指很长一段时间。","source":{"text":"今来古往人满地，劳生未了归丘墟。","book":"唐·崔珏《道林寺》诗"},"example":{"text":"没了两个有正经的老人家时时拘管他，便使出那～、天下通行、不省事、不达理、没见食面、不知香臭的小妇性子。","book":"清·西周生《醒世姻缘传》第七十七回"},"similar":["古往今来"],"usage":"作定语、状语；指从古到今"},{"id":5187,"word":"今生今世","pinyin":"jīn shēng jīn shì","abbr":"jsjs","explanation":"此生此世。指有生之年。","source":{"text":"这歪剌骨便是黄花女儿，刚刚扯的一把，也不消这等使性，平空的推了我一交，我肯干罢！就当面赌个誓与你：我今生今世不要他做老婆，我也不算好男子。","book":"元·关汉卿《窦娥冤》第一折"},"example":{"text":"扰了这一家人家，～还不的他，来生来世是必填还他则个。","book":"明·凌濛初《初刻拍案惊奇》卷三十五"},"similar":["有生之年"],"usage":"作宾语、状语；指有生之年"},{"id":5188,"word":"今蝉蜕壳","pinyin":"jīn chán tuì ké","abbr":"jctk","explanation":"金蝉脱壳。今，通“金”。指使用计谋而逃脱。","source":{"text":"被小将使一个金蝉脱壳之计，撤身得空，把这和尚拿来，奉献大王，聊表一餐之敬。","book":"明·吴承恩《西游记》第二十回"},"example":{"text":"他使用～之计才得以脱身"},"similar":["金蝉蜕壳","金蝉脱壳"],"usage":"作宾语、定语；比喻用掩人耳目的手段"},{"id":5189,"word":"今雨新知","pinyin":"jīn yǔ xīn zhī","abbr":"jyxz","explanation":"比喻新近结交的朋友。","source":{"text":"秋，杜子卧病长安旅次，多雨生鱼，青苔及榻，常时车马之客，旧，雨来；今，雨不来。","book":"唐·杜甫《秋述》"},"example":{"text":"她们都是我的～"},"usage":"作宾语、定语；用于书面语"},{"id":5190,"word":"今非昔比","pinyin":"jīn fēi xī bǐ","abbr":"jfxb","explanation":"昔：过去。现在不是过去能比得上的。多指形势、自然面貌等发生了巨大的变化。","source":{"text":"问讯南州守。怅吾生，今非昔比，后犹在否？","book":"宋·李曾伯《贺新郎·自和前韵》词"},"example":{"text":"“胜败军家常事”，何得为愧。～，不可欺敌。","book":"明·许仲琳《封神演义》第三十八回"},"similar":["日新月异","昔不如今"],"opposite":["今不如昔"],"usage":"作谓语、定语、分句；形容变化非常大"},{"id":5191,"word":"介胄之间","pinyin":"jiè zhòu zhī jiān","abbr":"jzzj","explanation":"介胄：古代作战时将士们穿戴的铠甲和头盔。借指在战争中或战场上。","source":{"text":"而韩信、黥布之徒相继而起者七国，高祖死于介胄之间而莫能止也。","book":"宋·苏洵《上韩枢密书》"}},{"id":5192,"word":"仍陋袭简","pinyin":"réng lòu xí jiǎn","abbr":"rlxj","explanation":"因陋就简。指凭借原有的简陋条件办事。","source":{"text":"上疏曰：‘臣所领镇，外控岛夷，城池楼橹仍陋袭简，非独不足壮国威，猝有风潮之变，捍御无所，势须改为。","book":"《明史·王铭传》"},"similar":["因陋就简"],"usage":"作谓语、定语、状语；指将就"},{"id":5193,"word":"从一以终","pinyin":"cóng yī yǐ zhōng","abbr":"cyyz","explanation":"从：跟随；终：终身，一辈子。丈夫死了不得再嫁人，也比喻忠臣不事二主。","source":{"text":"呜呼，全而生这之必全而归之，从一以终兮尚得正，其何悲！","book":"宋·文天祥《刘良臣母哀辞》"},"similar":["从一而终"],"usage":"作谓语、定语；指不事二主"},{"id":5194,"word":"从一而终","pinyin":"cóng yī ér zhōng","abbr":"cyez","explanation":"丈夫死了不再嫁人，这时旧时束缚妇女的封建礼教。","source":{"text":"曰妇人贞洁，从一而终也。","book":"《周易·恒》"},"example":{"text":"同一个人，怎的女子就该～，男子便许大妻大妾？","book":"清·文康《儿女英雄传》第二十七回"},"similar":["一女不事二夫"],"usage":"作谓语、定语；指不事二主"},{"id":5195,"word":"从中作梗","pinyin":"cóng zhōng zuò gěng","abbr":"czzg","explanation":"梗：阻塞，妨碍。在事情进行中，设置障碍，故意为难。","source":{"text":"是以粮道必应酬将军者，畏其从中作梗也。","book":"清·张集馨《道咸宦海见闻录》"},"example":{"text":"英、美两公使不免恐慌，暗想日、俄两国～，定是不怀好意。","book":"蔡东藩、许廑父《民国通俗演义》第十回"},"similar":["没事找事"],"usage":"作谓语；指故意为难"},{"id":5196,"word":"从中斡旋","pinyin":"cóng zhōng wò xuán","abbr":"czwx","explanation":"斡旋：扭转，调整，引申为调解矛盾和争端。在矛盾的双方之间周旋，从中调解争端。","source":{"text":"大钧播群物，斡旋不作难。","book":"宋·范成大《两本》"}},{"id":5197,"word":"从中渔利","pinyin":"cóng zhōng yú lì","abbr":"czyl","explanation":"渔：劳取。渔利：乘机谋取不正当的权益。人当中捞取好处。","source":{"text":"广州解放后，地下庄就展开了人民币的投机‘炒卖’。他们制造黑市……乘机从中渔利。","book":"穆欣《南线巡回·广州——南中国的门户》"},"opposite":["拔葵去织"],"usage":"作谓语；指从中捞取好处"},{"id":5198,"word":"从井救人","pinyin":"cóng jǐng jiù rén","abbr":"cjjr","explanation":"从：跟从。跳到井里去救人。原比喻徒然危害自己而对别人没有好处的行为。现多比喻冒险救人。","source":{"text":"宰我问曰：‘仁者，虽告之曰：井有仁（人）焉，其从之也？’子曰：‘何为其然也？君子可逝也，不可陷也。’","book":"《论语·雍也》"},"example":{"text":"那岸上看的人，虽然有救捞之念，只是风水利害，谁肯～。","book":"明·冯梦龙《醒世恒言》卷十"},"opposite":["落井下石","打死老虎"],"usage":"作谓语；比喻冒险救人","story":["春秋时期，孔子带领弟子们周游列国，在蔡国的日子里，孔子给弟子们讲仁，讲见义勇为，发现宰予在课堂上睡觉，叫醒宰予，宰予问孔子有人落井，跳下去救死了是仁和见义勇为，不救是见死不救是不仁。孔子说可以用其他办法救"]},{"id":5199,"word":"从从容容","pinyin":"cóng cóng róng róng","abbr":"ccrr","explanation":"留有足够的时间，而且常常有余。","source":{"text":"谁知韵高却从从容容笑道：‘先生谬赞不敢当，哪里及先生的大著朴实说理呢！’","book":"曾朴《孽海花》第13回"},"example":{"text":"他～地走上红地毯。"},"similar":["绰绰有余","从容不迫"],"opposite":["慌慌张张"],"usage":"作定语、状语；指镇定"},{"id":5200,"word":"从令如流","pinyin":"cóng lìng rú liú","abbr":"clrl","explanation":"从令：服从命令；如流：好像流水向下，形容迅速。形容绝对服从命令。","source":{"text":"是以三军之众，从令如流，死而不旋踵。","book":"战国·卫·商鞅《商君书·画策》"},"example":{"text":"带兵作战就必须～。"},"opposite":["三令五申"],"usage":"作谓语、定语；形容绝对服从命令"},{"id":5201,"word":"从何说起","pinyin":"cóng hé shuō qǐ","abbr":"chsq","explanation":"从哪里开始说。","source":{"text":"这一席话，不觉把雯青说得呆了半晌，方挣出一句道：‘这从何说起呢？’","book":"曾朴《孽海花》第20回"},"example":{"text":"这话～？"},"usage":"作谓语；常用于疑问句"},{"id":5202,"word":"从俗就简","pinyin":"cóng sú jiù jiǎ","abbr":"csjj","explanation":"依照通俗的做法，以求简易。","source":{"text":"今士人有作一二十字简帖，必旋检本，模仿笔画，从俗就简。","book":"宋·周辉《清波别志》卷下"},"example":{"text":"开始的时候，他只能～，买回一台旧电脑用。"},"usage":"作谓语、宾语；指依照通俗的做法，力求简易"},{"id":5203,"word":"从俗浮沉","pinyin":"cóng sú fú chén","abbr":"csfc","explanation":"顺着世俗或浮或沉。指能够随着世俗或时势的变化而变化。","source":{"text":"故且从俗浮沉，与时俯仰，以通其狂感。","book":"汉·司马迁《报任少卿书》"},"similar":["随俗浮沉"],"usage":"作谓语、定语；指没有主见"},{"id":5204,"word":"从吾所好","pinyin":"cóng wǔ suǒ hào","abbr":"cwsh","explanation":"吾：我；好：爱好，嗜好。根据自己的爱好行事。","source":{"text":"富而可求也，虽执鞭之士，吾亦为之，如不可求，从吾所好。","book":"《论语·述而》"},"usage":"作谓语、定语；用于处事"},{"id":5205,"word":"从善如流","pinyin":"cóng shàn rú liú","abbr":"csrl","explanation":"从：听从；善：好的，正确的；如流：好像流水向下，形容迅速。形容能迅速地接受别人的好意见。","source":{"text":"君子曰：从善如流，宜哉。","book":"《左传·成公八年》"},"example":{"text":"“八毛！”他也立刻懂得，将五分钱让去，真是“～”，有正人君子的风度。","book":"鲁迅《华盖集续编·马上日记》"},"similar":["从谏如流","从善若流"],"opposite":["独断专行","刚愎自用"],"usage":"作谓语、宾语、定语；指听从别人的意见","story":["春秋时期，晋国派大将栾武子率军援郑国，楚国只好从郑国收兵，栾武子乘机攻打蔡国，楚王立刻派兵增援蔡国。栾武子采用知庄子、范文子、韩献子的建议不打而撤军。后来他又听取他们三人善意的规劝，成功地消灭蔡国、楚国及沈国"]},{"id":5206,"word":"从善如登","pinyin":"cóng shàn rú dēng","abbr":"csrd","explanation":"指为善如登山那样不易，比喻学好很难。","source":{"text":"如登，喻难；如崩，喻易。","book":"《国语·周语下》：“谚曰：从善如登，从恶如崩。”韦昭注"},"opposite":["从恶如崩"],"usage":"作谓语、定语；比喻学好很难"},{"id":5207,"word":"从善如登，从恶如崩","pinyin":"cóng shàn rú dēng，cóng è rú bēng","abbr":"csrdcerb","explanation":"从：顺随。顺随善良象登山一样，顺随恶行象山崩一样。比喻学好很难，学坏极容易。","source":{"text":"从善如登，从恶是崩。","book":"春秋·鲁·左丘明《国语·周语下》"},"example":{"text":"大家都知道“～”，可就是不容易做到。"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":5208,"word":"从善若流","pinyin":"cóng shàn ruò liú","abbr":"csrl","explanation":"形容能迅速地接受别人的好意见。同“从善如流”。","source":{"text":"从善若流，尚恐不逮，饰非拒谏，祸可既乎？","book":"《新唐书·张玄素传》"},"similar":["从善如流"],"usage":"作谓语、宾语、定语；指听从别人的意见"},{"id":5209,"word":"从壁上观","pinyin":"cóng bì shàng guān","abbr":"cbsg","explanation":"壁：壁垒。原指双方交战，自己站在壁垒上旁观。后多比喻站在一旁看着，不动手帮助。","source":{"text":"及楚击秦，诸将皆从壁上观。","book":"《史记·项羽本纪》"},"similar":["作壁上观","袖手旁观"],"usage":"作谓语、定语；指袖手旁观","story":["秦朝末年，大将章邯领兵攻打赵国，赵军大败，逃到巨鹿死守，等待救援，各路反秦大军按兵不动。只有项羽率军把秦军包围，项羽力能扛鼎，冲入敌阵，斩杀敌将苏角，大败秦军。巨鹿之战，消灭秦军主力，原来作壁上观的人纷纷投靠"]},{"id":5210,"word":"从天而下","pinyin":"cóng tiān ér xià","abbr":"ctex","explanation":"比喻出于意外，突然出现。","source":{"text":"直入武库，击鸣鼓。诸侯闻之，以为将军从天而下也。","book":"《汉书·周亚夫传》"},"example":{"text":"哥哥，你真是从天而降也！万望救我一救！","book":"明·吴承恩《西游记》第三十一回"},"similar":["从天而降"],"usage":"作谓语、定语；形容出乎意料突然发生"},{"id":5211,"word":"从天而降","pinyin":"cóng tiān ér jiàng","abbr":"ctej","explanation":"降：下落。比喻出于意外，突然出现。","source":{"text":"直入武库，击鸣鼓。诸侯闻之，以为将军从天而下也。","book":"《汉书·周亚夫传》"},"example":{"text":"哥哥，你真是～也！万乞救我一救。","book":"明·吴承恩《西游记》第三十一回"},"similar":["突如其来","从天而下"],"opposite":["意料之中"],"usage":"作谓语、定语；形容出乎意料突然发生","story":["西汉初年，汉景帝听从汉文帝的意见，重用名将周勃的儿子周亚夫带兵去平吴楚七国诸侯叛乱。周亚夫听信赵涉的建议，派兵从小道进军洛阳，同时轻取叛军的粮道。面对这从天而降的汉军，叛军溃败。周亚夫因平叛有功，官至丞相"]},{"id":5212,"word":"从头做起","pinyin":"cóng tóu zuò qǐ","abbr":"ctzq","explanation":"从：自。从开始做起。","source":{"text":"现在得从头做起，最难的是注文用的白话……得创作。","book":"朱自清《古文学的欣赏》"},"example":{"text":"王朔《过把瘾就死》：“我们双方又都能从今天～，重新做起。”"},"similar":["重起炉灶"],"usage":"作谓语、宾语；用于处事"},{"id":5213,"word":"从头到尾","pinyin":"cóng tóu dào wěi","abbr":"ctdw","explanation":"从开头到结尾。指某件事物的全过程或全部内容。","source":{"text":"是金声底，从头到尾只是金声；是玉声底，从头到尾只是玉声；是丝竹之声，从头到尾只是丝竹之声。","book":"《朱子全书·孟子三》"},"similar":["从头至尾"],"usage":"作状语；用于写文章、说话等"},{"id":5214,"word":"从头彻尾","pinyin":"cóng tóu chè wěi","abbr":"ctcw","explanation":"自始至终。","source":{"text":"不免索性说了，从头彻尾只是此一个病根也。","book":"宋·朱熹《答吕伯恭》"},"example":{"text":"活死人正在有苦无话处，便一五一十～的告诉他。","book":"清·张南庄《何典》第六回"},"similar":["彻头彻尾","自始至终"],"opposite":["半途而废"],"usage":"作状语；指始终坚持"},{"id":5215,"word":"从头至尾","pinyin":"cóng tóu zhì wěi","abbr":"ctzw","explanation":"从开头至结尾。指某件事物的全过程或全部内容。","source":{"text":"今来所问，皆是不会仔细看书，又不曾从头到尾看，只是中间接起一句一字来备礼发问。","book":"宋·朱熹《朱子语类》卷二十"},"example":{"text":"象一个人受了一辈子的冤屈，如今遇到一个亲人，他得～倾吐出来。","book":"巴金《火》第二部第十节"},"similar":["自始至终","彻头彻尾"],"opposite":["半途而废"],"usage":"作状语；用于写文章、说话等"},{"id":5216,"word":"从容不迫","pinyin":"cóng róng bù pò","abbr":"crbp","explanation":"从容：不慌不忙，很镇静；不迫：不急促。不慌不忙，沉着镇定。","source":{"text":"《旧唐书·刘世龙传》“而思礼以为得计，从容自若，尝与相忤者，必引令枉诛。”"},"example":{"text":"这些人～地叩了头，花费了半点钟以上的时间。","book":"巴金《家》十五"},"similar":["处之泰然","视若等闲","从从容容"],"opposite":["惊慌失措","手足无措"],"usage":"作谓语、定语、状语；形容人举止不慌","story":["战国时期宋国哲学家庄周与哲学家惠子同在濠水岸边观鱼。庄子说鱼在水中游得从容自在，惠子问庄子怎么知道鱼的感受。庄子说：“我与你在濠水边同游观鱼，悠闲自在，自得其乐，鱼在水中游戏，从容不迫地观看我们，当然也快乐。”"]},{"id":5217,"word":"从容就义","pinyin":"cóng róng jiù yì","abbr":"crjy","explanation":"就义：为正义而死。无所畏惧地为正义事业而牺牲。","source":{"text":"感慨杀身者易，从容就义者难。","book":"宋·朱熹《近思录》"},"example":{"text":"徐荫轩以身殉国，～，应该附奏清恤！","book":"高阳《胭脂井》"},"similar":["舍生取义"],"opposite":["贪生怕死"],"usage":"作谓语、定语；形容为革命而献身"},{"id":5218,"word":"从容应对","pinyin":"cóng róng yìng duì","abbr":"cryd","explanation":"从容：舒缓，悠然。不慌不忙地应付答对。","source":{"text":"有问乃答，不问即默，安闲自在，从容应答，不敢慢之，不可敬之。","book":"明·李贽《焚书·杂述·豫约》"},"usage":"作谓语；指对付"},{"id":5219,"word":"从容指顾","pinyin":"cóng róng zhǐ gù","abbr":"crzg","explanation":"指：手指；顾：眼看。动作和眼神十分沉着冷静。形容行动迅速而又从容。","source":{"text":"及夫发谋决策，从容指顾，立定大计，谓千载而一时。","book":"宋·王安石《祭欧阳文忠公文》"},"example":{"text":"江心独立，看巫峡巫山，头吴尾楚，任我～。（叶剑英《长江大桥》）"}},{"id":5220,"word":"从容无为","pinyin":"cóng róng wú wéi","abbr":"crww","explanation":"从容：舒缓，不慌不忙。顺其自然，不加人为的力量。","source":{"text":"从容无为而万物炊累焉，吾又何暇治天下哉？","book":"《庄子·在宥》"}},{"id":5221,"word":"从容有常","pinyin":"cóng róng yǒu cháng","abbr":"cryc","explanation":"举动、进退保持常态。","source":{"text":"古者长民，衣服不贰，从容有常，以齐其民。","book":"《诗经·小雅·都人士序》"}},{"id":5222,"word":"从容自如","pinyin":"cóng róng zì rú","abbr":"crzr","explanation":"不慌不忙，得心应手。","source":{"text":"熟练的纺手趁着一线灯光或者朦胧的月色也能摇车，抽线，上线，一切做得从容自如。","book":"吴伯箫《记一辆纺车》"},"example":{"text":"他～，毫无惧色。"},"similar":["从容自若","从容不迫","从从容容"],"opposite":["慌里慌张"],"usage":"作谓语、状语、定语；指人不慌乱"},{"id":5223,"word":"从容自若","pinyin":"cóng róng zì ruò","abbr":"crzr","explanation":"从容：不慌不忙，很镇静；自若：自在，如常，保持原样。不慌不忙，沉着镇定。","source":{"text":"《旧唐书·刘世龙传》“而思礼以为得计，从容自若，尝与相忤者，必引令枉诛。”"},"example":{"text":"“请你数一数高家究竟有几个象样的人！”觉民～地嘲讽道，仿佛他自己并不是高家的子弟。","book":"巴金《春》三十一"},"similar":["从容自如","镇定自若"],"opposite":["慌里慌张"],"usage":"作谓语、定语；指人很沉着"},{"id":5224,"word":"从宽发落","pinyin":"cóng kuān fā luò","abbr":"ckfl","explanation":"发落：处分，处置。指处罚从宽，轻予放过。","source":{"text":"想仲尼不为已甚，诸公遵守孔门家法，决知从宽发落、许其改过自新无疑。","book":"明·李贽《与周友山书》"},"example":{"text":"蔡公先问罗公起居，然后说到就是仁寿二年皂角林那桩事，我也～。","book":"清·禇人获《隋唐演义》第十四回"},"similar":["宽大处理","既往不咎","手下留情"],"opposite":["执法如山","严惩不贷"],"usage":"作谓语、宾语；指宽大处理"},{"id":5225,"word":"从心之年","pinyin":"cóng xīn zhī nián","abbr":"cxzn","explanation":"从心：随心。随心所欲的年龄。后用为七十岁的称谓。","source":{"text":"七十而从心所欲，不逾矩。","book":"《论语·为政》"}},{"id":5226,"word":"从心所欲","pinyin":"cóng xīn suǒ yù","abbr":"cxsy","explanation":"按照自己的意思，想怎样便怎样。","source":{"text":"六十而耳顺，七十而从心所欲，不逾矩。","book":"《论语·为政》"},"example":{"text":"从此可以高枕而卧，～了。","book":"邹韬奋《患难余生记·进步文化的遭难》"},"similar":["随心所欲"],"usage":"作谓语；指随自己心意办事"},{"id":5227,"word":"从恶如崩","pinyin":"cóng è rú bēng","abbr":"cerb","explanation":"指为恶如山崩那样容易。","source":{"text":"谚曰：从善如登，从恶如崩。","book":"《国语·周语下》"},"example":{"text":"若复染寻常百姓之习，则～，不可复振矣。","book":"清·顾炎武《留书与山史》"},"similar":["从恶若崩"],"opposite":["从善如流"],"usage":"作宾语；用于劝诫人"},{"id":5228,"word":"从恶是崩","pinyin":"cóng è shì bēng","abbr":"cesb","explanation":"学坏象高山崩塌一样迅速。比喻学坏很容易。","source":{"text":"谚曰：‘从善如登，从恶是崩。’","book":"《国语·周语下》"}},{"id":5229,"word":"从恶若崩","pinyin":"cóng è ruò bēng","abbr":"cerb","explanation":"崩：倒塌。学坏像高山崩塌一样迅速。比喻学坏很容易。","source":{"text":"谚曰：‘从善如登，从恶如崩。’","book":"《国语·周语下》"},"example":{"text":"语曰‘～’，盖言其易。","book":"《北齐书·幼主纪》"},"similar":["从恶如崩"],"opposite":["从善如登"],"usage":"作宾语；用于劝诫人"},{"id":5230,"word":"从流忘反","pinyin":"cóng liú wàng fǎn","abbr":"clwf","explanation":"指习从流俗而不可扭转。","source":{"text":"一记得了，久而久之，不论尊卑长幼，远近亲疏，一股脑子，把称谓搁起来，都叫别号，尤其怪。照这样从流忘反，流到我大清二百年后，只怕就会有‘甲斋父亲’‘乙亭儿子’的通称了。","book":"《儿女英雄传》第二九回"},"usage":"作谓语、定语；用于处事"},{"id":5231,"word":"从者如云","pinyin":"cóng zhě rú yún","abbr":"czry","explanation":"从：跟随。形容跟随的人很多。","source":{"text":"从者如云，得者宁几。","book":"宋·陈亮《祭陈肖夫文》"},"usage":"作谓语、定语；用于响应的人很多"},{"id":5232,"word":"从规矩定方圆","pinyin":"cóng guī jǔ dìng fāng yuán","abbr":"cgjdfy","explanation":"从：听从；规矩：圆规和曲尺。根据圆规和曲尺来确定方圆的大小形状。比喻凡事都得遵循一定的法则。","source":{"text":"天地神鬼人五仙，尽从规矩定方圆，逆则路路生颠倒，顺则头头身外玄。","book":"元·无名氏《冤家债主》楔子"},"usage":"作谓语、定语；用于处事"},{"id":5233,"word":"从谏如流","pinyin":"cóng jiàn rú liú","abbr":"cjrl","explanation":"谏：直言规劝。听从规劝像流水一样自然。形容乐于接受别人的批评意见。","source":{"text":"从谏如顺流，趣时如响赴。","book":"汉·班彪《王命论》"},"example":{"text":"也有少数聪明点的，为了坐稳江山，笼络人心，也能～。","book":"臧克家《纳谏与止谤》"},"similar":["从善如流"],"opposite":["独断专行","讳疾忌医","刚愎自用"],"usage":"作谓语、宾语；形容乐于接受批评意见"},{"id":5234,"word":"从轻发落","pinyin":"cóng qīng fā luò","abbr":"cqfl","explanation":"发落：处分，处置。指处罚从宽，轻予放过。","source":{"text":"想仲尼不为已甚，诸公遵守孔门家法，决知从宽发落、许其改过自新无疑。","book":"明·李贽《与周友山书》"},"example":{"text":"少不得欢天喜地，把令亲～的。","book":"清·张南庄《何典》第二回"},"similar":["从宽发落"],"opposite":["严惩不贷"],"usage":"作谓语、宾语；用于处理案件等"},{"id":5235,"word":"从长商议","pinyin":"cóng cháng shāng yì","abbr":"ccsy","explanation":"犹言从长计议。","source":{"text":"[苏定]也道：‘梁山泊吴用那厮，诡计多谋，不可轻敌，只宜退守；待救兵到来，从长商议。’","book":"《水浒传》第六八回"},"example":{"text":"须与郎～一个计策便好。","book":"《初刻拍案惊奇》卷二三"},"similar":["从长计议"],"usage":"作谓语；用于不急于作出决定"},{"id":5236,"word":"从长计议","pinyin":"cóng cháng jì yì","abbr":"ccjy","explanation":"用较长的时间慎重考虑、仔细商量。","source":{"text":"且待女孩儿到来，慢慢的与他从长计议，有何不可。","book":"《左传·僖公四年》：“筮短龟长，不如从长。”元·李行道《灰阑记》楔子"},"example":{"text":"少奶奶到了此时，真是无可如何，只得说道：“公公婆婆，且先请起，凡事都可以～。","book":"清·吴趼人《二十年目睹之怪现状》第八十九回"},"similar":["从长商议","稳扎稳打"],"opposite":["操之过急","仓促行事"],"usage":"作谓语；用于不急于作出决定"},{"id":5237,"word":"从长计较","pinyin":"cóng cháng jì jiào","abbr":"ccjj","explanation":"犹言从长计议。","source":{"text":"婶子且住，休要急速行，我从长计较，慢慢地商量。","book":"《水浒传》第四五回"},"example":{"text":"我这意见对不对，请大家～。","book":"茅盾《蚀·动摇》"},"similar":["从长计议"],"opposite":["操之过急"],"usage":"作谓语；用于不急于作出决定"},{"id":5238,"word":"从风而服","pinyin":"cóng fēng ér fú","abbr":"cfef","explanation":"从：顺从；服：服从。象顺风倒下一样就迅速服从了。","source":{"text":"山东之国，从风而服。","book":"《战国策·秦策一》"},"similar":["从风而靡"],"usage":"作谓语；比喻弱者折服于强势"},{"id":5239,"word":"从风而靡","pinyin":"cóng fēng ér mí","abbr":"cfem","explanation":"指如风之吹草，草随风倾倒。①比喻强弱悬殊，弱者不堪一击，即告瓦解。②比喻仿效、风行之迅速。","source":{"text":"于是用广武君策，发使燕，燕从风而靡。","book":"《汉书·韩信传》"},"example":{"text":"上意所向，～，士大夫欲追逐时好，从非其学，亦将矫入此门。","book":"宋·俞文豹《吹剑四录》"},"similar":["从风而服"],"usage":"作谓语、定语；用于书面语"},{"id":5240,"word":"仓卒主人","pinyin":"cāng cù zhǔ rén","abbr":"cczr","explanation":"仓卒：匆忙。客人突然到来，仓促中招待不周，难尽主人之礼。","source":{"text":"有仓卒客，无仓卒主人。","book":"晋·葛洪《西京杂记》第四卷"},"example":{"text":"请原谅我这个～。"},"opposite":["不速之客"],"usage":"作主语、宾语；用于自我解嘲"},{"id":5241,"word":"仓卒之际","pinyin":"cāng cù zhī jì","abbr":"cczj","explanation":"仓卒：仓促，匆忙。匆忙之间。","source":{"text":"天下大乱，豪杰并起，在仓卒之际，强弱未分。","book":"晋·陈寿《三国志·魏志·王粲传》裴松之注引《文士传》"},"example":{"text":"在这～，最好慎做决定。"},"similar":["转眼之间"],"usage":"作宾语；指匆忙之间"},{"id":5242,"word":"仓卒从事","pinyin":"cāng cù cóng shì","abbr":"cccs","explanation":"仓卒：勿促，仓促；从事：参加做某件事。匆匆忙忙地去做某件事。","source":{"text":"但是第五次没有打破‘围剿’而被迫突围时，还表现了不应有的仓卒从事。","book":"毛泽东《中国革命战争的战略问题》"},"example":{"text":"最好不要～，避免失误。"},"similar":["仓卒应战"],"opposite":["谨慎从事"],"usage":"作谓语、宾语；指匆忙应付"},{"id":5243,"word":"仓卒应战","pinyin":"cāng cù yìng zhàn","abbr":"ccyz","explanation":"指没有准备匆忙对付。","source":{"text":"只有不肯退却，仓卒应战（例如硝石战斗），表面上似乎在力争主动，实际上是被动的。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["仓卒从事"],"usage":"作谓语、宾语；用于处事"},{"id":5244,"word":"仓皇不定","pinyin":"cāng huáng bù dìng","abbr":"chbd","explanation":"仓皇：匆忙，慌张。形容匆匆忙忙，心情慌乱。","source":{"text":"仓皇不定。","book":"《抱朴子·正郭》"}},{"id":5245,"word":"仓皇出逃","pinyin":"cāng huáng chū táo","abbr":"chct","explanation":"仓皇：匆忙，慌张。慌慌张张地外出逃跑。","source":{"text":"最是仓皇离庙日，教坊犹奏别离歌。","book":"南唐·李煜《破阵子》"},"similar":["仓皇逃窜"],"usage":"作谓语；指逃跑"},{"id":5246,"word":"仓皇失措","pinyin":"cāng huáng shī cuò","abbr":"chsc","explanation":"仓皇：匆忙，慌张。匆忙慌张，不知所措。","source":{"text":"僧仓皇失措，不暇走，兵已大掠。","book":"宋·洪迈《夷坚志·铁塔神》"},"example":{"text":"血溢不止，少顷已绝，妪～。","book":"清·蒲松龄《聊斋志异·金生色》"},"similar":["惊惶失措","张皇失措"],"opposite":["从容不迫","镇定自若","泰然处之"],"usage":"作谓语、定语、状语；指惊慌忙乱的场面"},{"id":5247,"word":"仓皇无措","pinyin":"cāng huáng wú cuò","abbr":"chwc","explanation":"慌慌张张地外出逃跑。同“仓皇失措”。","source":{"text":"次日崇之至，值河泛涨，中流失楫，舟人仓皇无措。","book":"明·朱国祯《涌幢小品·判土地》"},"similar":["仓皇失措"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；指惊慌忙乱的场面"},{"id":5248,"word":"仓皇退遁","pinyin":"cāng huáng tuì dùn","abbr":"chtd","explanation":"仓皇：匆忙，慌张；遁：逃跑。慌慌张张地退却逃跑。"},{"id":5249,"word":"仓箱可期","pinyin":"cāng xiāng kě qī","abbr":"cxkq","explanation":"仓箱：盛粮食的工具。粮仓有望装满。比喻丰收大有希望。","source":{"text":"乃求千斯仓，乃求万斯箱。","book":"《诗经·小雅·甫田》"},"example":{"text":"笞笠就绪，～。","book":"唐·权德舆《中书门下贺雨表》"},"opposite":["颗粒无存"],"usage":"作谓语；用于农业等"},{"id":5250,"word":"仓腐寄顿","pinyin":"cāng fǔ jì dùn","abbr":"cfjd","explanation":"仓：仓库；腐：腐烂；寄顿：储存。仓库里储存的陈米已经腐烂。","source":{"text":"仓腐寄顿，陈陈逼人，时则为米气。","book":"宋·文天祥《正气歌序》"}},{"id":5251,"word":"仔仔细细","pinyin":"zǐ zǐ xì xì","abbr":"zzxx","explanation":"指人处事认真细心，丝毫不马虎。","source":{"text":"只见都氏慌忙的一把挈起，声也不做，仔仔细细的看上一回。","book":"明·伏雌教主《醋葫芦》第18回"},"example":{"text":"我瞅见史良～地把小红花一个个嵌入上衣的扣眼，嵌好后还左右端详。","book":"章诒和《往事并不如烟·正在有情无思间》"},"similar":["认认真真"],"usage":"作定语、状语；用于处事"},{"id":5252,"word":"仕女班头","pinyin":"shì nǚ bān tóu","abbr":"snbt","explanation":"仕女：美女；班头：第一。指第一美女。","source":{"text":"秀才是文章魁首，姐姐是仕女班头。","book":"元·王实甫《西厢记·草桥店梦莺莺》第三折"},"similar":["绝代佳人"],"usage":"作主语、宾语、定语；指美女"},{"id":5253,"word":"仕途经济","pinyin":"shì tú jīng jì","abbr":"stjj","explanation":"仕途：做官的途径，也指官场；经济：经世济民，治理国家。做官治理国家。","source":{"text":"也该常会会这些为官作宦的，谈讲谈讲那些仕途经济，也好将来应酬事务。","book":"《宋史·王安石传论》：“朱熹尝论安石文章节行高一世，而尤以道德经济为己任。”清·曹雪芹《红楼梦》第三十二回"},"example":{"text":"一说～，玉兄就掩耳而逃。我想过，要没有懂仕途经济的撑着局面，有那个大观园极乐世界给石兄去享受？","book":"二月河《乾隆皇帝》十七"}},{"id":5254,"word":"他乡异县","pinyin":"tā xiāng yì xiàn","abbr":"txyx","explanation":"指远离家乡的外地。","source":{"text":"他乡各异县，展转不可见。","book":"《乐府诗集·饮马长城窟行》"},"example":{"text":"少长周旋，如有贤哲，每相狎侮，不加礼敬；～，微借风声，延颈企踵，甚于饥渴。","book":"南北朝·颜之推《颜氏家训》卷第二"},"similar":["天涯海角"],"opposite":["本乡本土"],"usage":"作主语、宾语、定语；指外地"},{"id":5255,"word":"他乡故知","pinyin":"tā xiāng gù zhī","abbr":"txgz","explanation":"故知：老朋友，熟人。在异地遇到老朋友或熟人。","source":{"text":"他乡故知，分外亲热。","book":"明·天然智叟《石头点·贪婪汉六院卖风流》"},"similar":["他乡遇故知"],"usage":"作宾语、定语；指遇到好友"},{"id":5256,"word":"他乡遇故知","pinyin":"tā xiāng yù gù zhī","abbr":"txygz","explanation":"在远里家乡的地方碰到了老朋友。指使人高兴的事。","source":{"text":"果然有志竟成，上月被他打死一个，今日又去打虎，谁知恰好遇见贤侄。邂逅相逢，真是‘万里他乡遇故知’可谓三生有幸！","book":"清·李汝珍《镜花缘》第十回"},"example":{"text":"老残，我多时不见你的诗了，今日总算‘～’，您也该做首诗，我们拜读拜读。","book":"清·刘鹗《老残游记》第十二回"},"similar":["他乡故知"],"usage":"作宾语、定语；指异地遇到老乡等"},{"id":5257,"word":"他山之攻","pinyin":"tā shān zhī gōng","abbr":"tszg","explanation":"比喻能帮助自己改正缺点的人或意见。同“他山之石”。","source":{"text":"藏夜光于嵩山岫，不受他山之攻。","book":"晋·葛洪《抱朴子·畅玄》"},"example":{"text":"章侯诗，谨为较阅，不无窜改数字，聊效～。","book":"清·陈翰《与薛蒻园》"},"similar":["他山之石"],"usage":"作主语、宾语；指可以借鉴的东西"},{"id":5258,"word":"他山之石","pinyin":"tā shān zhī shí","abbr":"tszs","explanation":"比喻能帮助自己改正缺点的人或意见。","source":{"text":"他山之石，可以为错。","book":"《诗经·小雅·鹤鸣》"},"example":{"text":"所谓可资‘～’的东西实在太贫乏。","book":"鲁迅《集外集拾遗补编·小引》"},"similar":["引以为戒","前车之鉴"],"opposite":["重蹈覆辙"],"usage":"作主语、宾语；指可以借鉴的东西"},{"id":5259,"word":"他山之石，可以攻玉","pinyin":"tā shān zhī shí，kě yǐ gōng yù","abbr":"tszskygy","explanation":"攻：琢磨。别的山上的石头，能够用来琢磨玉器。原比喻别国的贤才可为本国效力。后比喻能帮助自己改正缺点的人或意见。","source":{"text":"他山之石，可以攻玉。","book":"《诗经·小雅·鹤鸣》"},"example":{"text":"感公虚己下问，且自念～。","book":"明·海瑞《启熊镜湖军门》"},"similar":["他山攻玉"],"usage":"作主语、宾语；指可以借鉴的东西"},{"id":5260,"word":"他山攻错","pinyin":"tā shān gōng cuò","abbr":"tsgc","explanation":"比喻拿别人的长处，补救自己的短处。","source":{"text":"他山之石，可以为错。","book":"《诗经·小雅·鹤鸣》"},"example":{"text":"借～之资，集世界交通之益，翘盼旌旄，勿吝金玉！","book":"清·曾朴《孽海花》第十八回"},"similar":["他山之攻"],"usage":"作宾语、定语；指取长补短"},{"id":5261,"word":"仗义执言","pinyin":"zhàng yì zhí yán","abbr":"zyzy","explanation":"直言：直接说出来。为了正义说公道话。指能伸张正义。","source":{"text":"此人姓范名汝为，仗义执言，救民水火。","book":"明·冯梦龙《警世通言》卷十二"},"example":{"text":"人类便应声而起，～，与魔鬼战斗。（鲁迅《野草·失掉的好地狱》）"},"similar":["理直气壮","直言不讳"],"opposite":["违天悖理"],"usage":"作谓语、宾语；指敢说话"},{"id":5262,"word":"仗义疏财","pinyin":"zhàng yì shū cái","abbr":"zysc","explanation":"仗义：讲义气；疏财：分散家财。旧指讲义气，拿出自己的钱财来帮助别人。","source":{"text":"则为我救困扶危，疏财仗义，都做了注福消愆。","book":"元·无名氏《来生债》第四折"},"example":{"text":"自己只是在家中广行善事，～。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"similar":["慷慨解囊","博施济众","疏财仗义"],"opposite":["一毛不拔"],"usage":"作谓语、定语；指讲义气"},{"id":5263,"word":"仗义直言","pinyin":"zhàng yì zhí yán","abbr":"zyzy","explanation":"仗义：主持正义。指伸张正义，说公道话","source":{"text":"此人姓范名汝为，仗义直言，救民水火。","book":"《京本通俗小说·冯玉梅团回》"},"similar":["仗义执言"],"usage":"作谓语、宾语；指敢说话"},{"id":5264,"word":"仗义行仁","pinyin":"zhàng yì xíng rén","abbr":"zyxr","explanation":"注重义气，施行仁德。","source":{"text":"素知将军仗义行仁，扶危济困，不想果然如此义气！倘蒙存微命，当以捐躯保奏。","book":"明·施耐庵《水浒传》第55回"},"usage":"作谓语、定语；用于处世等"},{"id":5265,"word":"仗势欺人","pinyin":"zhàng shì qī rén","abbr":"zsqr","explanation":"仗：凭借，依靠。依仗某种权势欺压人。","source":{"text":"他学师友，君子务本；你倚父兄，仗势欺人。","book":"元·王实甫《西厢记》第五本第三折"},"example":{"text":"许多人发展了官僚主义的作风，～，用强迫命令的方法去完成工作任务。","book":"毛泽东《在晋绥干部会议上的讲话》"},"similar":["狗仗人势","欺人太甚"],"opposite":["锄强扶弱","除暴安良"],"usage":"作谓语、定语；指小人"},{"id":5266,"word":"仗气使酒","pinyin":"zhàng qì shǐ jiǔ","abbr":"zqsj","explanation":"仗：凭借，倚仗；使：放任。指任性发酒疯。","source":{"text":"与赵郡李概为莫逆之交。概将东还，瞻遗之书曰：‘仗气使酒，我之常弊，底诃指切，在卿尤甚。’","book":"《北齐书·崔瞻传》"},"similar":["使酒仗气"],"usage":"作谓语、宾语、定语；指发酒疯"},{"id":5267,"word":"仗气直书","pinyin":"zhàng qì zhí shū","abbr":"zqzs","explanation":"仗：凭借。坚持正义，如实地把事实写出来。","source":{"text":"若南、董之仗气直书，不避强御；韦、崔之肆情奋笔，无所阿容。","book":"唐·刘知己《史通·直言》"},"example":{"text":"唐·刘知几《史通·直书》：“若南董之～，不避强御。”"},"similar":["仗义执言"],"usage":"作谓语、宾语；用于处事"},{"id":5268,"word":"仗节死义","pinyin":"zhàng jié sǐ yì","abbr":"zjsy","explanation":"指坚守节操，为正义而死。","source":{"text":"前山阳亡徒苏令，纵横史士，临难莫肯仗节死义者，以守相威权素夺故也。","book":"宋·苏轼《上皇帝书》"},"example":{"text":"杜子美《送严武还朝》诗：‘公若登台辅，临危莫爱身。’劝以～也。","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵八》"},"usage":"作谓语、定语；用于处事"},{"id":5269,"word":"仗马寒蝉","pinyin":"zhàng mǎ hán chán","abbr":"zmhc","explanation":"仗马：皇宫仪仗中的立马。象皇宫门外的立仗马和寒天的知了一样。比喻一句话也不敢说。","source":{"text":"君等独不见立仗马乎？终日无声而饫三品刍豆，一鸣则黜之矣。","book":"《新唐书·李林甫传》"},"example":{"text":"一般～，反得各居显要，尸位素餐，未免好恶倒置，令人不解。","book":"《晚清文学丛钞·冷眼观》第三十回"},"similar":["噤若寒蝉","寒蝉仗马"],"usage":"作宾语、定语；指人不开口说话"},{"id":5270,"word":"付与东流","pinyin":"fù yǔ dōng liú","abbr":"fydl","explanation":"付：交给；东流：向东的河流。扔在东流的江河里冲走。比喻希望落空，成果丧失，前功尽弃。","source":{"text":"叹人生、杳似浮萍，又翻成轻别，都将深恨，付与东流。","book":"宋·查荎《透碧霄·惜别》"},"example":{"text":"王夺我政权，又加兵于我，三世勤王之绩，～。","book":"明·冯梦龙《东周列国志》第九回"},"similar":["付之东流","付东流","付诸东流"],"usage":"作谓语、定语；比喻成果丧失，前功尽弃"},{"id":5271,"word":"付东流","pinyin":"fù dōng liú","abbr":"fdl","explanation":"付：交给；东流：向东的河流。扔在东流的江河里冲走。比喻希望落空，成果丧失，前功尽弃。","source":{"text":"往常个侍衾裯，都做了付东流。","book":"元·关汉卿《金线池》第二折"},"similar":["付之东流","付与东流"],"usage":"作谓语、定语；比喻成果丧失，前功尽弃"},{"id":5272,"word":"付之一叹","pinyin":"fù zhī yī tàn","abbr":"fzyt","explanation":"叹一口气。多指对不满意的某件事表示无可奈何。","source":{"text":"前日之事，我也不计较长短，付之一叹罢了。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"example":{"text":"时事如此，无法挽回，也只得～的了。","book":"清·李宝嘉《官场现形记》第二十四回"},"usage":"作谓语；用于处事"},{"id":5273,"word":"付之一哂","pinyin":"fù zhī yī shěn","abbr":"fzys","explanation":"哂：微笑。用笑一笑来回答。表示不值得理会。","source":{"text":"上无日：‘此难能’，更无日，‘乃公从马上得之’，乌用此迂儒之常谈，而付之一哂也。","book":"《清史稿·沈文奎传》"},"similar":["付之一笑"],"usage":"作谓语、定语；表示毫不在意"},{"id":5274,"word":"付之一炬","pinyin":"fù zhī yī jù","abbr":"fzyj","explanation":"付：给；之：它；炬：火把。一把火给烧了。","source":{"text":"戍卒叫，函谷举，楚人一炬，可怜焦土。","book":"唐·杜牧《阿房宫赋》"},"example":{"text":"除夕，京师富家竞购千竿爆竹，～。","book":"清·淮阴百一居士《壶天录》"},"similar":["付之丙丁"],"usage":"作谓语；表示野蛮残暴","story":["唐敬宗时，朝廷大兴土木，挥霍无度，杜牧十分气愤，就写一篇《阿房宫赋》，讲述秦朝的阿房宫是十分的繁华，最后被西楚霸王项羽放火烧了三个月才烧完，借古讽今，希望能让当权者吸取秦亡的教训"]},{"id":5275,"word":"付之一笑","pinyin":"fù zhī yī xiào","abbr":"fzyx","explanation":"用笑一笑来回答。比喻不计较，不当一回事。","source":{"text":"乃知朝士妄想，自古已然，可付一笑。","book":"宋·陆游《老学庵笔记》卷四"},"example":{"text":"康有为两人去后，袁世凯犹是～，觉他们举动都不必理他。","book":"清·黄小配《大马扁》第十二回"},"similar":["一笑了之","一笑置之"],"opposite":["大笑不止"],"usage":"作谓语、定语；表示毫不在意"},{"id":5276,"word":"付之丙丁","pinyin":"fù zhī bǐng dīng","abbr":"fzbd","explanation":"指用火烧掉。","source":{"text":"其日丙丁。","book":"《吕氏春秋·孟夏纪》"},"similar":["付之一炬","付诸丙丁"],"usage":"作谓语；指用火烧掉"},{"id":5277,"word":"付之东流","pinyin":"fù zhī dōng liú","abbr":"fzdl","explanation":"扔在东流的水里冲走。比喻希望落空，成果丧失，前功尽弃，好像随着流水冲走了一样。","source":{"text":"生事应须南亩田，世事尽付东流水。","book":"唐·高适《封丘作》诗"},"example":{"text":"缉捕使臣等听得这话，传在耳朵里，也只好笑笑，谁敢向他家道个“不”字？这件事只索～了。","book":"明·凌濛初《二刻拍案惊奇》卷二十"},"similar":["前功尽弃","付诸东流"],"usage":"作谓语、定语；比喻成果丧失，前功尽弃"},{"id":5278,"word":"付之度外","pinyin":"fù zhī dù wài","abbr":"fzdw","explanation":"度外：心意计度之外。放在考虑之外，形容不计安危、成败的行为。","source":{"text":"以小舟涉鲸波，出无可奈何，而死固付之度外矣!","book":"宋·文天祥《指南录后序》"},"example":{"text":"宝玉将昨日的事已～。","book":"清·曹雪芹《红楼梦》第21回"},"similar":["置之度外"],"opposite":["耿耿于怀"],"usage":"作谓语；指不计安危、成败的行为"},{"id":5279,"word":"付之梨枣","pinyin":"fù zhī lí zǎo","abbr":"fzlz","explanation":"指刻版刊印书籍。梨枣：旧时刻书多用梨木枣木，古代称书版。","source":{"text":"然欲付梨枣而啬于资，素愿莫偿，恒深歉怅。","book":"清·蒲松龄《聊斋志异·段序》"},"usage":"作谓语、定语；用于出版等"},{"id":5280,"word":"付之流水","pinyin":"fù zhī liú shuǐ","abbr":"fzls","explanation":"付：交给；之：它。扔在流水里冲走。比喻希望落空，成果丧失，前功尽弃。","source":{"text":"别人总未解得他四个人的言语，因此付之流水。","book":"清·曹雪芹《红楼梦》第30回"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“让李鸿章喧宾夺主，那就一世英名～了。”"},"similar":["付之东流","付诸东流","付之逝水"],"usage":"作谓语、定语；比喻前功尽弃"},{"id":5281,"word":"付之逝水","pinyin":"fù zhī shì shuǐ","abbr":"fzss","explanation":"付：交给；之：它。扔在流水里冲走。比喻希望落空，成果丧失，前功尽弃。","source":{"text":"亲朋为之惋惜：以为半生功名付之逝水。","book":"清·汤斌《汤子遗书·请旨行取疏》"},"similar":["付之流水","付之东流","付诸流水"],"usage":"作谓语、定语；比喻前功尽弃"},{"id":5282,"word":"付诸一炬","pinyin":"fù zhū yī jù","abbr":"fzyj","explanation":"炬：火把。一把火全部烧了。同“付之一炬”。","source":{"text":"在这许多名片里面，捡出一张，上写着颜轶回，……其余都付诸一炬。","book":"清·李宝嘉《文明小史》第四十六回"},"similar":["付之一炬"],"usage":"作谓语；表示野蛮残暴"},{"id":5283,"word":"付诸一笑","pinyin":"fù zhū yī xiào","abbr":"fzyx","explanation":"用一笑来对待或回答。比喻不值得理会。同“付之一笑”。","source":{"text":"仲英乃恍然大悟，付诸一笑，就在高椅上坐下，问雪香道：‘耐意思要我成日成夜陪仔耐坐来里，勿许到别场花去，阿是嗄？’","book":"清·韩邦庆《海上花列传》第六回"},"example":{"text":"把一切诞罔不经之事，～，那就不负我今日一番饶舌了。","book":"清·壮者《扫迷帚》第九回"},"similar":["付之一笑"],"usage":"作谓语、定语；表示毫不在意"},{"id":5284,"word":"付诸丙丁","pinyin":"fù zhū bǐng dīng","abbr":"fzbd","explanation":"丙丁：火日，借指火。指用火烧掉","source":{"text":"已被陶大人付诸丙丁，你从何处领起？","book":"清·李百川《绿野仙踪》第三回"},"similar":["付之丙丁"],"usage":"作谓语；指用火烧掉"},{"id":5285,"word":"付诸东流","pinyin":"fù zhū dōng liú","abbr":"fzdl","explanation":"付：交给；诸：之于。扔在东流的水里冲走。比喻希望落空，成果丧失，前功尽弃，好像随着流水冲走了一样。","source":{"text":"生事应须南亩田，世事尽付东流水。","book":"唐·高适《封丘作》诗"},"example":{"text":"惜丙寅清水潭决，稿本～，故录其梗概于此。","book":"清·黄钧宰《金壶七墨·鸳鸯印传奇始末》"},"similar":["付之东流","付与东流","付东流"],"opposite":["继日成功"],"usage":"作谓语、定语；比喻希望落空，前功尽弃"},{"id":5286,"word":"付诸度外","pinyin":"fù zhū dù wài","abbr":"fzdw","explanation":"度外：心意计度之外。放在考虑之外，形容不计安危、成败的行为。","source":{"text":"自身生死且尚付诸度外，毁誉更不计及也。","book":"范文澜《中国近代史》上册第一章"},"similar":["付之度外"],"usage":"作谓语；用于处事"},{"id":5287,"word":"付诸洪乔","pinyin":"fù zhū hóng qiáo","abbr":"fzhq","explanation":"洪乔：晋朝人，姓殷名羡，字洪乔。比喻书信遗失。","source":{"text":"殷洪乔作豫章郡，临去，都下人因附百许函书。既至石头，悉掷水中，因祝曰：‘沉者自沉，浮者自浮，殷洪乔不能作致书邮。’","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"现代社会寄信再不会～了。"},"similar":["洪乔捎书"],"usage":"作谓语、宾语；指书信遗失","story":["晋朝豫章太守殷羡，字洪乔，在离任时，很多人委托他捎带书信回家乡，因那时还没有邮局，只有托人捎带。他很客气地接受了100多封信，可到了石头渚就将信全部扔进河水里。当人们收不到信总联想到信是托洪乔捎带的"]},{"id":5288,"word":"仙乎仙乎","pinyin":"xiān hū xiān hū","abbr":"xhxh","explanation":"形容飘飘然，如登仙一般。","source":{"text":"仙乎仙乎，去故而就新，宁忘怀乎！","book":"汉·伶玄《飞燕外传》"},"example":{"text":"远看北京十三门，万家官阙在中央，至此万物在足下，～我心良。","book":"张恨水《金粉世家》第十回"}},{"id":5289,"word":"仙凡路隔","pinyin":"xiān fán lù gé","abbr":"xflg","explanation":"仙：神仙；凡：凡人。天上神仙和人间凡人互不往来。","source":{"text":"你我相遇，亦是夙缘。今三年限满，仙凡路隔，岂复有相见之期乎。","book":"明·冯梦龙《醒世恒言》卷三十一"},"example":{"text":"且～，尤不应以违心之言，释当日之恨。","book":"清·李汝珍《镜花缘》第八十八回"},"similar":["仙尘路隔","天人路隔"],"usage":"作谓语、定语；用于比喻句"},{"id":5290,"word":"仙姿佚貌","pinyin":"xiān zī yì mào","abbr":"xzym","explanation":"仙女的姿质，美女的容貌。形容女子姿态容貌都美。","source":{"text":"三千玉貌休自夸，十二金钗独相问。","book":"唐·郑嵎《津阳门》诗：“鸣鞭后骑何躞蹀，宫妆禁袖皆仙姿。”《乐府诗集·宫怨》"},"example":{"text":"那娘娘生得来～，说不尽幽闲窈窕。","book":"清·洪昇《长生殿》第三十八出"},"similar":["仙姿玉质","仙姿玉色"],"usage":"作宾语、定语；多用于女性"},{"id":5291,"word":"仙姿玉色","pinyin":"xiān zī yù sè","abbr":"xzys","explanation":"形容女子姿态容貌极美。","source":{"text":"三千玉貌休自夸，十二金钗独相问。","book":"唐·郑嵎《津阳门》诗：“鸣鞭后骑何躞蹀，宫妆禁袖皆仙姿。”《乐府诗集·宫怨》"},"example":{"text":"宫中郑娘娘，乃是郑参政之女，数月前选入宫中，～，世上无双。","book":"明·谢谠《四喜记·巧夕宫筵》"},"similar":["天姿国色"],"usage":"作谓语、补语；形容女子很美"},{"id":5292,"word":"仙姿玉貌","pinyin":"xiān zī yù mào","abbr":"xzym","explanation":"形容女子姿态容貌都美。","source":{"text":"三千玉貌休自夸，十二金钗独相问。","book":"唐·郑《津阳门》诗：“鸣鞭后骑何躞蹀，宫妆禁袖皆仙姿。”《乐府诗集·宫怨》"},"similar":["仙姿玉色"],"usage":"作宾语、定语；用于女子"},{"id":5293,"word":"仙姿玉质","pinyin":"xiān zī yù zhì","abbr":"xzyz","explanation":"形容姿容清秀品格高洁。","source":{"text":"他两家仙姿玉质从无上，压倒群芳。","book":"《白雪遗音·马头调·梅雪争艳》"},"similar":["仙姿佚貌","仙姿玉色"],"usage":"作宾语、定语；多用于女性"},{"id":5294,"word":"仙尘路隔","pinyin":"xiān chén lù gé","abbr":"xclg","explanation":"一个在天上，一个在人间。比喻道路远隔，阻碍重重，难以相见。","source":{"text":"仙尘路隔，不能相依。妾亦不忍以鱼水之爱，夺膝下之欢。容徐谋之。","book":"清·蒲松龄《聊斋志异·罗刹海市》"},"similar":["仙凡路隔","天人路隔"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":5295,"word":"仙山楼阁","pinyin":"xiān shān lóu gé","abbr":"xslg","explanation":"指仙人所居住的仙境。多用于形容奇异不凡或美妙空幻的境界或景象等。","source":{"text":"《史记·封禅书》：“自威（齐威王）、宣（齐宣王）、燕昭使人入海求蓬莱、方丈、瀛洲。此三神山者，其傅在勃海中……盖尝有至者，诸仙人及不死之药皆在焉。其物禽兽尽白，而黄金银为宫阙。未至，望之如云；及到，三神山反居水下。临之，风辄引去，"},"example":{"text":"忽闻海上有仙山，山在虚无缥缈间。楼阁玲珑五云起，其中绰约多仙子。","book":"唐白居易《长恨歌》"},"similar":["仙山琼阁"],"usage":"作宾语、定语；指美妙幻境","story":["传说古代齐威王、齐宣王、燕昭王等均派人到东海上的蓬莱、方丈、瀛洲三座仙山去求长生不老的仙药，远远望去山上禽兽都是白色的，宫殿都是黄金白银砌成的。远看如云，到面前则见神仙住在水下，到山上就隐去，他们还是没有办法得到"]},{"id":5296,"word":"仙山琼阁","pinyin":"xiān shān qióng gé","abbr":"xsqg","explanation":"仙山：指蓬莱、方丈、瀛洲三神山；琼阁：精美的楼阁。传说中神仙居住的地方。现在也比喻虚无缥缈的美妙幻境。","source":{"text":"忽闻海上有仙山，山在虚无缥缈间。楼阁玲珑五云起，其中绰约多仙子。","book":"唐·白居易《长恨歌》"},"example":{"text":"借问君去何方？雀儿答道：“有～。”","book":"毛泽东《念奴娇·鸟儿问答》词"},"similar":["仙山楼阁"],"usage":"作宾语、定语；指美妙幻境","story":["传说古代齐威王、齐宣王、燕昭王等均派人到东海上的蓬莱、方丈、瀛洲三座仙山去求长生不老的仙药，远远望去山上禽兽都是白色的，宫殿都是黄金白银砌成的。远看如云，到面前则见神仙住在水下，到山上就隐去，他们还是没有办法得到"]},{"id":5297,"word":"仙才鬼才","pinyin":"xiān cái guǐ cái","abbr":"xcgc","explanation":"形容超人的才化。","source":{"text":"庆历间宋景文诸公在馆，尝评唐人之诗，云：‘太白仙才，长吉鬼才，其余不尽记也。’","book":"宋·王得臣《尘史·诗话》"},"usage":"作宾语、定语；用于书面语"},{"id":5298,"word":"仙液琼浆","pinyin":"xiān yè qióng jiāng","abbr":"xyqj","explanation":"指美酒。","source":{"text":"东一院作金齑玉脍，西一院就酿仙液琼浆。","book":"清·褚人获《隋唐演义》第27回"},"example":{"text":"那娘娘生得来～，说不尽幽闲窈窕。","book":"清·洪昇《长生殿》第三十八出"},"similar":["琼浆玉液"],"usage":"作主语、宾语、定语；比喻仙水、美酒等"},{"id":5299,"word":"仙露明珠","pinyin":"xiān lù míng zhū","abbr":"xlmz","explanation":"比喻人风神秀异。也形容书法秀逸圆润。","source":{"text":"松风水月，未足比其清华；仙露明珠，讵能方其朗润？","book":"唐太宗《三藏圣教序》"},"usage":"作宾语、定语；形容书法秀逸圆润"},{"id":5300,"word":"仙风道格","pinyin":"xiān fēng dào gé","abbr":"xfdg","explanation":"犹言仙风道骨。仙人的风度，道长的气概。形容人的风骨神采与众不同。","source":{"text":"公襟上高爽，有仙风道格，日与二三逸人，放意于江山之间。","book":"宋·苏舜钦《朝奉大夫天章阁待制王公行状》"},"similar":["仙风道气"],"usage":"作宾语、定语；用于人的气质等"},{"id":5301,"word":"仙风道气","pinyin":"xiān fēng dào qì","abbr":"xfdq","explanation":"犹仙风道骨。仙人的风度，道长的气概。形容人的风骨神采与众不同。","source":{"text":"老爷身着宫锦袍，头戴华阳巾，仙风道气，轩轩霞举。","book":"明·屠隆《彩毫记·泛舟采石》"},"similar":["仙风道格","仙风道骨"],"usage":"作宾语、定语；用于人的气质等"},{"id":5302,"word":"仙风道骨","pinyin":"xiān fēng dào gǔ","abbr":"xfdg","explanation":"骨：气概。仙人的风度，道长的气概。形容人的风骨神采与众不同。","source":{"text":"余昔于江陵见天台司马子微，谓余有仙风道骨，可与神游八极之表，因著《大鹏遇希有鸟赋》以自广。","book":"唐·李白《大鹏赋序》"},"example":{"text":"唐·李白《大鹏赋序》：“余昔于江陵见天台司马子微，谓余有仙风道骨，可与神游八极之表，因著《大鹏遇希有鸟赋》以自广。”"},"similar":["仙风道气"],"usage":"作宾语、定语；形容人的风骨神采与风度"},{"id":5303,"word":"代为说项","pinyin":"dài wéi shuō xiàng","abbr":"dwsx","explanation":"比喻替别人说好话。","source":{"text":"几度见诗诗尽好，及观标格过于诗，平生不解藏人善，到处逢人说项斯。","book":"宋·计有功《唐诗纪事·项斯》"},"example":{"text":"这年头～的人动机都不纯了。"},"similar":["代人说项"],"opposite":["血口喷人"],"usage":"作谓语、宾语、定语；指替人说情","story":["唐朝时期，江东年轻人项斯，字子迁，参加会考开始没有什么名气，别人拿他的卷子去给杨敬之看。杨特别喜欢就作诗“几度见诗诗尽好，及观标格过于诗，平生不解藏人善，到处逢人说项斯。”没多久，他就被长安方面录取"]},{"id":5304,"word":"代人受过","pinyin":"dài rén shòu guò","abbr":"drsg","explanation":"受：承受，担待；过：过失，过错。替别人承担过错的责任。","source":{"text":"各省系军阀慑于人民的巨大力量，都不肯代人受过，曹辊也就不敢一意孤行。","book":"陶菊隐《北洋军阀统治时期史话》第61章"},"example":{"text":"你这是～，你不觉得冤吗？"},"similar":["代为受过"],"opposite":["嫁祸于人"],"usage":"作宾语；指替罪羊","story":["在普救寺张生与崔莺莺一见钟情，在丫鬟红娘的帮助下，两人书信来往，频频幽会，给老夫人觉察了，老夫人把红娘叫去问话，红娘不说实情，老夫人就惩罚红娘，红娘凭着智慧，终于让张生与崔莺莺有情人终成眷属"]},{"id":5305,"word":"代人捉刀","pinyin":"dài rén zhuō dāo","abbr":"drzd","explanation":"捉刀：代别人写文章。指代别人做事，多指写文章。","source":{"text":"魏王雅望非常，然床头捉刀人，此乃英雄也。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"他经常～。"},"similar":["请人捉刀"],"usage":"作谓语；指替代干活","story":["三国时期，生性多疑的曹操在会见匈奴的使者时，为了显示他的威武形象就让一表人才的崔季珪装成他接见，自己则扮成武士提着刀站在床头。会见完毕就命间谍问匈奴使者对魏王的印象如何，匈奴使者说床头捉刀人才是真正的英雄"]},{"id":5306,"word":"代人说项","pinyin":"dài rén shuō xiàng","abbr":"drsx","explanation":"替人说好话。","source":{"text":"几度见诗诗尽好，及观标格过于诗，平生不解臧人善，到处逢人说项斯。","book":"宋·计有功《唐诗纪事·项斯》"},"example":{"text":"他总爱～。"},"similar":["代为说项"],"opposite":["血口喷人"],"usage":"作谓语、宾语；指替人说情","story":["唐朝时期，江东年轻人项斯，字子迁，参加会考开始没有什么名气，别人拿他的卷子去给杨敬之看。杨特别喜欢就作诗“几度见诗诗尽好，及观标格过于诗，平生不解藏人善，到处逢人说项斯。”没多久，他就被长安方面录取"]},{"id":5307,"word":"代代相传","pinyin":"dài dài xiāng chuán","abbr":"ddxc","explanation":"一代接一代地相继传下去。","example":{"text":"我们一定要将林州人民战天斗地、艰苦创业的“红旗渠精神”代代相传。"},"similar":["世代相传"],"usage":"作谓语、宾语；指一代代流传"},{"id":5308,"word":"代拆代行","pinyin":"dài chāi dài xíng","abbr":"dcdx","explanation":"拆：拆开，指拆阅来电来文；行：发出。一般指首长不在时由专人负责代理拆阅和审批、处理公文。形容权力极大。","source":{"text":"其时抚台请病假，各事都由藩司代拆代行。","book":"清·李宝嘉《官场现形记》第九回"},"example":{"text":"这些文件都是由他～。"},"usage":"作谓语；形容权力很大"},{"id":5309,"word":"代越庖俎","pinyin":"dài yuè páo zǔ","abbr":"dypz","explanation":"比喻越出本分，代行其事。","source":{"text":"庖人虽不治庖，尸、祝不越樽俎而代之矣。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"是英雄自有英雄面，怕甚么～，还他个一矢双穿。","book":"清·陈天华《狮子吼》楔子"},"similar":["越俎代庖"],"usage":"作谓语、定语；指包办"},{"id":5310,"word":"代远年湮","pinyin":"dài yuǎn nián yān","abbr":"dyny","explanation":"湮：埋没。过去的年代已距今十分久远，无法记忆，无从考证。"},{"id":5311,"word":"代马不思越","pinyin":"dài mǎ bù sī yuè","abbr":"dmbsy","explanation":"代：古国名，在今河北蔚县、山西东北部一带，泛指北方；越：古国名，泛指南方。北方所产的马不思念南方。比喻眷恋故土。","source":{"text":"代马不思越，越禽不恋燕，情性有所习，土风固其然。","book":"唐·李白《古风五十九首》六"}},{"id":5312,"word":"代马依北风","pinyin":"dài mǎ yī běi fēng","abbr":"dmybf","explanation":"代：古国名，泛指北方。北方所产的马总是怀恋北边吹来的风。比喻人心眷恋故土，不愿老死它乡。","source":{"text":"故代马依北风，飞鸟翔古巢，莫不哀其声。","book":"汉·桓宽《盐铁论·未通》"}},{"id":5313,"word":"代马依风","pinyin":"dài mǎ yī fēng","abbr":"dmyf","explanation":"代：古国名，泛指北方。北方所产的马总是怀恋北边吹来的风。比喻人心眷恋故土，不愿老死它乡。","source":{"text":"故代马依北风，飞鸟翔古巢，莫不哀其声。","book":"汉·桓宽《盐铁论·未通》"},"example":{"text":"臣闻太公封齐，五世葬周，狐死首丘，～。","book":"《后汉书·班超传》"},"similar":["代马望北","狐死首丘"],"usage":"作宾语；指思恋故乡"},{"id":5314,"word":"代马望北","pinyin":"dài mǎ wàng běi","abbr":"dmwb","explanation":"比喻人心眷恋故土，不愿老死他乡。","source":{"text":"且夫人重迁，恋慕坟墓，贤不肖之所同也。……代马望北，狐死首丘，边民谨顿，尢恶内留。","book":"汉·王符《潜夫论·实边》"},"similar":["代马依风"],"usage":"作宾语、定语；指思恋故乡"},{"id":5315,"word":"令不虚行","pinyin":"lìng bù xū xíng","abbr":"lbxx","explanation":"指制定的法令必须切实执行。","source":{"text":"国不虚重，兵不虚胜，民不虚用，令不虎行。","book":"《管子·重令》"},"usage":"作宾语、定语；用于书面语"},{"id":5316,"word":"令之以文，齐之以武","pinyin":"lìng zhī yǐ wén，qí zhī yǐ wǔ","abbr":"lzywqzyw","explanation":"令：命名，引申为施教；齐：使整齐。指用政治道义教育部队，用军纪军法来统一步伐。","source":{"text":"卒未亲附而罚之则不服，不服则难用也；卒已亲附而罚不行，则不可用也。故令之以文，齐之以武，是谓必取。","book":"《孙子兵法·行军篇》"}},{"id":5317,"word":"令人作呕","pinyin":"lìng rén zuò ǒu","abbr":"lrzo","explanation":"呕：恶心，想吐。比喻使人极端厌恶。","source":{"text":"他的下流动作真～。"},"example":{"text":"他的下流动作真～"},"similar":["令人切齿","丑态毕露","令人咋舌"],"opposite":["令人神往","赞不绝口"],"usage":"作谓语、定语；形容让人厌恶的言行"},{"id":5318,"word":"令人切齿","pinyin":"lìng rén qiè chǐ","abbr":"lrqc","explanation":"令：使；切齿：牙齿相磨切，表示极其愤恨。使人非常愤恨。","source":{"text":"著《史记》非贬孝武，令人切齿。","book":"《三国志·魏志·王肃传》"},"example":{"text":"此外久办洋务的周家楣、李凤苞、马建忠、盛宣怀，亦无不～。","book":"高阳《慈禧全传》五十九"},"usage":"作谓语、定语；用于书面语"},{"id":5319,"word":"令人发指","pinyin":"lìng rén fà zhǐ","abbr":"lrfz","explanation":"发指：头发竖起来，形容极为愤怒。使人头发都竖起来了。形容使人极度愤怒。","source":{"text":"谒者入通，盗跖闻之大怒，目如明星，发上指冠。","book":"《庄子·盗跖》"},"example":{"text":"历年以来，不知害了我们多少同志，说来真真～。","book":"清·岭南羽衣女士《东欧女豪杰》第二回"},"similar":["怒气冲冲","怒不可遏","怒形于色"],"opposite":["喜形于色","兴高采烈","欢欣鼓舞"],"usage":"作谓语、定语；指十分愤怒","story":["公元前227年，秦国打败赵国迫近燕国。燕国太子丹请荆轲去刺杀秦王。荆轲带上秦王的仇人樊于期的人头及督亢地地图。太子丹把他送到易水边，高渐离击筑，荆轲高唱：“风萧萧兮易水寒，壮士一去兮不复还。”歌声激昂，场面真是令人发指"]},{"id":5320,"word":"令人发竖","pinyin":"lìng rén fà shù","abbr":"lrfs","explanation":"发竖：头发竖起来，形容极为愤怒。使人头发都竖起来了。形容使人极度愤怒。","source":{"text":"谒者入通，盗跖闻之大怒，目如明星，发上指冠。","book":"《庄子·盗跖》"},"example":{"text":"阅详，所犯多属重辟，～。","book":"明·吴世济《太和县御寇始末·土寇王本仁解道申文》"}},{"id":5321,"word":"令人吃惊","pinyin":"lìng rén chī jīng","abbr":"lrcj","explanation":"让人感到惊讶。","source":{"text":"这种以耳代目的情况是令人吃惊的，但这种情况却并不是罕见的。","book":"臧克家《以耳代目之类》"},"example":{"text":"他的行为～。"},"usage":"作谓语、定语、状语；用于人或事物等"},{"id":5322,"word":"令人喷饭","pinyin":"lìng rén pēn fàn","abbr":"lrpf","explanation":"形容事情或说话十分可笑。","source":{"text":"与可是日与其妻游谷中，烧笋晚食，发函得诗，失笑喷饭满案。","book":"宋·苏轼《文与可画禹筜谷偃竹记》"},"example":{"text":"百戏之类，件件都可解得睡魔，也可～。","book":"清·李汝珍《镜花缘》第二十三回"},"similar":["令人捧腹"],"usage":"作谓语、定语；指十分可笑"},{"id":5323,"word":"令人寒心","pinyin":"lìng rén hán xīn","abbr":"lrhx","explanation":"让人失望而痛心。","source":{"text":"我们做了封疆大吏，上头还如此不放心我们，听了叫人寒心！","book":"清·李宝嘉《官场现形记》第47回"},"example":{"text":"他这样处理问题～。"},"similar":["令人心寒"],"usage":"作谓语、定语、状语；用于口语"},{"id":5324,"word":"令人捧腹","pinyin":"lìng rén pěng fǔ","abbr":"lrpf","explanation":"捧腹：捂着肚子。让人捂着肚子。形容笑得很厉害。","source":{"text":"要丑的掉舌鼓唇，令人捧腹。","book":"清·李绿园《歧路灯》第七十九回"},"example":{"text":"又照烛看墙角一首，～。","book":"清·李绿园《歧路灯》第一○一回"},"similar":["令人喷饭"],"usage":"作谓语、定语；指可笑"},{"id":5325,"word":"令人注目","pinyin":"lìng rén zhù mù","abbr":"lrzm","explanation":"注目：视线集中在一点上。指引起别人的注意或重视。","source":{"text":"不过大部分都是含苞未放，枝子弯曲而有力，令人注目。","book":"巴金《家》"},"example":{"text":"这块金字招牌～。"},"similar":["引人注目"],"usage":"作谓语、定语；指有吸引力"},{"id":5326,"word":"令人满意","pinyin":"lìng rén mǎn yì","abbr":"lrmy","explanation":"指让人意愿得到满足。","source":{"text":"合作运动也还不能令人满意。","book":"邓小平《太行区的经济建设》"},"example":{"text":"你这样处理太难～了。"},"opposite":["令人寒心"],"usage":"作谓语、定语；用于人或事物等"},{"id":5327,"word":"令人生畏","pinyin":"lìng rén shēng wèi","abbr":"lrsw","explanation":"使人害怕、胆怯。","example":{"text":"他平时就是目光炯炯，～，今日更是目光如剑，好像要刺透别人心肺。","book":"姚雪垠《李自成》第五卷第一章"}},{"id":5328,"word":"令人痛心","pinyin":"lìng rén tòng xīn","abbr":"lrtx","explanation":"指让人悲愤痛恨。","source":{"text":"特别是我们这些负责的同志还有不少的歪风，给予工作的损害也是令人痛心的。","book":"邓小平《在北方局党校整风动员会上的讲话》"},"example":{"text":"路遥《平凡的世界》第三卷第24章：“我的朋友！这多么～。”"},"similar":["令人心痛"],"usage":"作谓语、定语；用于事情等"},{"id":5329,"word":"令人瞩目","pinyin":"lìng rén zhǔ mù","abbr":"lrzm","explanation":"瞩：注视。使人注视。","source":{"text":"那年国际共运在全球、首先在东南亚取得了令人瞩目的胜利。","book":"王朔《动物凶猛》"},"example":{"text":"这项工程之大令人瞩目。"},"similar":["众目睽睽"],"opposite":["不屑一顾"],"usage":"作谓语、定语；指使人注视"},{"id":5330,"word":"令人神往","pinyin":"lìng rén shén wǎng","abbr":"lrsw","explanation":"令：使，让；神往：心神向往。使人非常向往。","source":{"text":"今著术湮没，怅望当时蹈海之风，令人神往不已。","book":"明·胡应麟《少室山房笔丛》卷二十七"},"example":{"text":"明·胡应麟《少室山房笔丛》卷二十七：“今著术湮没，怅望当时蹈海之风，令人神往不已。”"},"similar":["望眼欲穿","心向往之","望穿秋水"],"opposite":["令人痛心","令人切齿","令人发指"],"usage":"作谓语、定语；指人的愿望"},{"id":5331,"word":"令人羡慕","pinyin":"lìng rén xiàn mù","abbr":"lrxm","explanation":"指让人爱慕，钦慕，希望自己拥有。","source":{"text":"杨用之那番红光满面，春风得意的神情，看来着实令人羡慕。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"像带领一帮手拿锄头和镰刀的泥腿子去打土豪的农会领袖手中挥舞的系红绸子的驳壳枪～。","book":"王朔《动物凶猛》"},"usage":"作谓语、定语；用于口语"},{"id":5332,"word":"令人莫测","pinyin":"lìng rén mò cè","abbr":"lrmc","explanation":"形容情况复杂，使人无法推测。","source":{"text":"既然送什么小姐到上海，为甚又带行李到南京去呢？真是行踪诡秘，令人莫测了。","book":"清·吴趼人《二十年目睹之怪现状》第八十二回"},"example":{"text":"正在难解难分之际，忽由北京递来八百里加紧排单，促国藩带兵勤王。突如其来，～。","book":"蔡东藩《清史演义》第六十九回"},"similar":["高深莫测"],"usage":"作谓语、定语；用于人或事物等"},{"id":5333,"word":"令人起敬","pinyin":"lìng rén qǐ jìng","abbr":"lrqj","explanation":"使人产生敬意。","source":{"text":"赵公之孝谨醇笃，虽古人犹难之，三复其书，令人起敬。","book":"宋·朱熹《跋赵中丞行实》"},"example":{"text":"宋·朱熹《跋赵中丞行实》：“赵公之孝谨醇笃，虽古人犹难之，三复其书，令人起敬。”"},"usage":"作谓语、定语；用于人或事情等"},{"id":5334,"word":"令人钦佩","pinyin":"lìng rén qīn pèi","abbr":"lrqp","explanation":"让人高度敬重。","source":{"text":"在我们党和人民战胜林彪、‘四人帮’的斗争中，文艺工作者做出了令人钦佩的、不可磨灭的贡献。","book":"邓小平《在中国文学艺术工作者第四次代表大会上的祝词》"},"example":{"text":"王朔《一半是火焰，一半是海水》：“就是那些‘小晃’还有点江湖义气，有点～的担事的勇气。”"},"usage":"作谓语、定语；用于人或事迹等"},{"id":5335,"word":"令人齿冷","pinyin":"lìng rén chǐ lěng","abbr":"lrcl","explanation":"齿冷：耻笑。比喻使人瞧不起。","source":{"text":"人笑禇公，至今齿冷。","book":"《南史·乐预传》"},"example":{"text":"本朝人演本朝事，而颠倒纰缪至此，殊～。","book":"鲁迅《小说旧闻钞·杂说》"},"similar":["令人喷饭","令人捧腹"],"opposite":["肃然起敬","令人起敬"],"usage":"作谓语、定语；指使人耻笑"},{"id":5336,"word":"令仪令色","pinyin":"lìng yí lìng sè","abbr":"lyls","explanation":"伭仪：和善美好的仪表；令色：和善的面容。美好的仪表，和悦的面容。","source":{"text":"令仪令色，小心翼翼。","book":"《诗经·大雅·烝民》"}},{"id":5337,"word":"令出如山","pinyin":"lìng chū rú shān","abbr":"lcrs","explanation":"命令一发出就一定彻底执行。","source":{"text":"果然现任县太爷一呼百诺，令出如山。","book":"《尚书·周官》：“慎乃出令，令出惟行，弗惟反。”清·李宝嘉《官场现形记》第十三回"},"example":{"text":"观袁氏之～，军警亦奉行惟谨。","book":"蔡东藩、许廑父《民国通俗演义》第三十五回"},"similar":["令出惟行"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5338,"word":"令出惟行","pinyin":"lìng chū wéi xíng","abbr":"lcwx","explanation":"命令一发出就一定彻底执行。","source":{"text":"慎乃出令，令出惟行，弗惟反。","book":"《尚书·周官》"},"example":{"text":"俾公～，崇为符信，钦念哉！","book":"蔡东藩、许廑父《民国通俗演义》第九回"},"similar":["令出如山"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5339,"word":"令原之戚","pinyin":"líng yuán zhī qī","abbr":"lyzq","explanation":"指兄、弟去世。","source":{"text":"脊令在原，兄弟急难，每有良朋，况也永叹。","book":"《诗经·小雅·常棣》"},"example":{"text":"绍定改元，适有～，闭门谢客，因追思，捉笔纪录。","book":"宋·张世南《序》"},"usage":"作宾语；指兄、弟去世"},{"id":5340,"word":"令名不终","pinyin":"lìng míng bù zhōng","abbr":"lmbz","explanation":"令名：美名；终：指人死。好名声不能保持到底。","source":{"text":"纵使才大如海，也会令名不终。","book":"清·文康《儿女英雄传》第三十二回"}},{"id":5341,"word":"令月吉日","pinyin":"lìng yuè jí rì","abbr":"lyjr","explanation":"令：好，吉祥。吉月吉日。指吉利的好日子。","source":{"text":"令月吉日，始加元服。","book":"《仪礼·士冠礼》"},"example":{"text":"～，始加元服，寿考维祺，以介景福。","book":"《明史·嘉礼志》"}},{"id":5342,"word":"令苛则不听","pinyin":"lìng kē zé bù tīng","abbr":"lkzbt","explanation":"苛：细碎烦琐；听：听从。法令细碎繁琐，执法者无法执行。形容事物如果繁杂，就会适得其反。","source":{"text":"令苛则不听，令多则不行。","book":"《吕氏春秋·吕览·适威》"}},{"id":5343,"word":"令行如流","pinyin":"lìng xíng rú liú","abbr":"lxrl","explanation":"指命令的推行象水流向下一样迅速顺利。","source":{"text":"故行水得其理，漂石折舟；用民得其性，则令行如流。","book":"银雀山汉墓竹简《孙膑兵法·奇正》"},"usage":"作宾语、定语；指执行命令顺利快捷"},{"id":5344,"word":"令行禁止","pinyin":"lìng xíng jìn zhǐ","abbr":"lxjz","explanation":"下令行动就立即行动，下令停止就立即停止。形容法令严正，执行认真。","source":{"text":"令则行，禁则止，宪之所及，俗之所破。如百体之从心，政之所期也。","book":"《管子·立政》"},"example":{"text":"以一新进小生，摧抑豪猾，乡中十余万人，～，赌盗之风顿息。","book":"清·梁启超《诗话》"},"similar":["大张旗鼓","雷厉风行"],"opposite":["温文尔雅","和风细雨"],"usage":"作谓语、宾语、定语；指政策等","story":["商朝末年，纣王暴虐无道，大肆挥霍民脂民膏，姬昌知道纣王的日子不会太长，就联络各地诸侯准备推翻商朝的统治。在临终前叫儿子姬发到床前，教导他要做到令行禁止才会成就王业。姬发继承父亲的遗志起兵终于推翻商朝的统治"]},{"id":5345,"word":"令闻令望","pinyin":"lìng wén lìng wàng","abbr":"lwlw","explanation":"令闻：美好的名声；令望：有美好的威仪，使人景仰。有美好的名声和品德，使人仰慕效法。","source":{"text":"颙颙昂昂，如圭如璋，令闻令望，岂弟君子，四方为纲。","book":"《诗经·大雅·卷阿》"},"example":{"text":"公德冠四海，道嗣前哲，～，必与此山俱传。至若湛辈，乃当如公言耳。","book":"《晋书·羊祜传》"}},{"id":5346,"word":"令闻嘉誉","pinyin":"lìng wén jiā yù","abbr":"lwjy","explanation":"对有功德的人记载其功绩，进爵嘉奖。","source":{"text":"故为车服、旗章以旌之，为贽币、瑞节以镇之，为班爵、贵贱以列之，为令闻嘉誉以声之。","book":"《国语·周语上》"}},{"id":5347,"word":"令闻广誉","pinyin":"lìng wén guǎng yù","abbr":"lwgy","explanation":"令：美、善；闻：名声。美好的名声，很大的荣誉。","source":{"text":"令闻广誉施于身，所以不愿人之文绣也。","book":"《孟子·告子上》"},"example":{"text":"然将读过的细味起来，那膏梁文绣，比着～，真是不啻百倍的了。","book":"清·曹雪芹《红楼梦》第一百十五回"}},{"id":5348,"word":"令骥捕鼠","pinyin":"lìng jì bǔ shǔ","abbr":"ljbs","explanation":"驱使千里马去追捕老鼠。比喻任用有才能的人承担他所不能胜任的工作。","source":{"text":"驱使千里马去追捕老鼠。比喻任用有才能的人承担他所不能胜任的工作。"}},{"id":5349,"word":"以一儆百","pinyin":"yǐ yī jǐng bǎi","abbr":"yyjb","explanation":"惩罚一个人以警戒众人。同“以一警百”。","source":{"text":"连队的指导员是个复员军人，本想以一儆百，好好批评她一通。","book":"萧复兴《贴深蓝色海绵的球拍》"},"similar":["以一警百"],"usage":"作定语、宾语；用于处事"},{"id":5350,"word":"以一击十","pinyin":"yǐ yī jī shí","abbr":"yyjs","explanation":"一个人抵挡十个人。形容军队英勇善战。","source":{"text":"楚战士无不一以当十，楚兵呼声动天，诸侯军无不人人惴恐。","book":"《战国策·齐策一》：“一而当十，十而当百，百而当千。”《史记·项羽本纪》"}},{"id":5351,"word":"以一奉百","pinyin":"yǐ yī fèng bǎi","abbr":"yyfb","explanation":"奉：供养。用一个人生产的物品供养一百个人。指生产的人少，消费的人多。","source":{"text":"今察洛阳资末业者，什于农夫；虚伪游手，什于末业。是则一夫耕，百人食之；一妇桑，百人衣之；以一奉百，孰能供之？","book":"汉·王符《潜夫论·浮侈》"},"usage":"作谓语、定语；指产销关系"},{"id":5352,"word":"以一当十","pinyin":"yǐ yī dāng shí","abbr":"yyds","explanation":"当：相当。一个人抵挡十个人。形容军队英勇善战。","source":{"text":"必一而当十，十而当百，百而当千。","book":"西汉·刘向《战国策·齐策一》"},"example":{"text":"我们～，以十当百地战斗着。","book":"张南生《回顾长征·遵义会议的光芒》"},"similar":["以少胜多","以一为十","以寡敌众"],"opposite":["一夫之用","卵与石斗"],"usage":"作谓语、宾语、定语；形容人能力大","story":["春秋时期齐人孙武受吴王阖闾的邀请来到吴国著书讲学，一段时间后阖闾想见识孙武的真本事，孙武以宫女代替士兵演练给吴王看。吴王封他为上将军。公元506年，孙武率三万精兵攻打楚国，消灭20多万楚军，创造一个以一当十的战例"]},{"id":5353,"word":"以一当百","pinyin":"yǐ yī dāng bǎi","abbr":"yydb","explanation":"当：相当。一个人抵挡一百个人。形容军队英勇善战。","source":{"text":"一而当十，十而当百，百而当千。","book":"《史记·项羽本纪》：“楚战士无不一以当十，楚兵呼声动天，诸侯军无不人人惴恐。”《战国策·齐策一》"},"example":{"text":"此时前有松林，后有鼎新，前后夹击，马步连环迭进，无不～，枪丸如雨而下，呼声雷动。","book":"蔡东藩《清史演义》第七十六回"},"similar":["以一当十"],"usage":"作谓语、宾语、定语；形容人能力大"},{"id":5354,"word":"以一持万","pinyin":"yǐ yī chí wàn","abbr":"yycw","explanation":"持：把握。形容抓住关键，可以控制全局。","source":{"text":"法先王，统礼义，一制度，以浅持博，以古持今，以一持万。","book":"《荀子·儒效》"},"similar":["纲举目张","提纲挈领"],"usage":"作谓语；同“提纲挈领”"},{"id":5355,"word":"以一知万","pinyin":"yǐ yī zhī wàn","abbr":"yyzw","explanation":"从了解一点到推知其他许多事物。","source":{"text":"以近知远，以一知万，以微知明，此之谓也。","book":"《荀子·非相》"},"example":{"text":"正确的学习方法是举一反三，～。"},"usage":"作谓语、定语；指见微知著"},{"id":5356,"word":"以一篑障江河","pinyin":"yǐ yī kuì zhàng jiāng hé","abbr":"yykzjh","explanation":"篑：盛土的筐。用一筐土去堵塞长江大河的泛滥。比喻所用力量微薄，无济于事。","source":{"text":"何武、王嘉，区区以一篑障江河，用没其身。","book":"《汉书·何武等传赞》"}},{"id":5357,"word":"以一警百","pinyin":"yǐ yī jǐng bǎi","abbr":"yyjb","explanation":"惩罚一个人来警戒其他的人。","source":{"text":"其有所取也，以一警百，吏民皆服，恐惧改行自新。","book":"东汉·班固《汉书·尹翁归传》"},"example":{"text":"本想～，好好批评她一通。","book":"萧复兴《贴深蓝色海绵的球拍》"},"similar":["杀一儆百"],"usage":"作定语、宾语；指管理手段","story":["西汉时期，河东太守田延年巡视霍光的家乡平阳发现市场吏尹翁归是个难得的人才，于是奏请皇上任命他为东海太守。东海是一个强盗横行的地方，尹翁归决定采取杀一儆百的办法，处决土匪豪强许仲孙，于是东海变得安定起来"]},{"id":5358,"word":"以一驭万","pinyin":"yǐ yī yù wàn","abbr":"yyyw","explanation":"驭：驾驶，控制。形容抓住关键，可以控制全局。","source":{"text":"法先王，统礼义，一制度，以浅持博，以古持今，以一持万。","book":"《荀子·儒效》"},"example":{"text":"君主能够兼用法、术、势，就可～，以静制动，无为而治。","book":"朱自清《经典常谈·诸子第十》"},"similar":["以一持万"],"usage":"作谓语、定语；用于书面语"},{"id":5359,"word":"以不变应万变","pinyin":"yǐ bù biàn yìng wàn biàn","abbr":"ybbywb","explanation":"用既定的原则，应付千变化万的事态发展。","source":{"text":"我经历了四个朝代，总结出的经验是‘以不变应万变’。","book":"章诒和《往事并不如烟·最后的贵族》"},"example":{"text":"但三人打定了～的主意，不管她使甚么怪招奇术，总是只守不攻，逐步进迫。","book":"金庸《神雕侠侣》第二十六回"},"similar":["以静制动"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5360,"word":"以不济可","pinyin":"yǐ fǒu jì kě","abbr":"yfjk","explanation":"指用否定错误意见的办法，帮助国君走上成功之路。不，同“否”。济，成。","source":{"text":"否，不可也。献君之否，以成君可。","book":"《左传·昭公二十年》：“君所谓可，而有否焉，臣献其否，以成其可；君所谓否，而有可焉，臣献其可，以去其否。是以政平而不干，民无争心。”杜预注"},"example":{"text":"营平（赵充国，封营平侯）皤皤，立功立论，～，上谕其信。","book":"《汉书·叙传下》"},"usage":"作谓语、定语；用于书面语"},{"id":5361,"word":"以丰补歉","pinyin":"yǐ fēng bǔ qiàn","abbr":"yfbq","explanation":"把丰年积余的粮食储备起来，留待灾年歉收时使用。","source":{"text":"以丰补歉，很有必要。","book":"毛泽东《做革命的促进派》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":5362,"word":"以为口实","pinyin":"yǐ wéi kǒu shí","abbr":"ywks","explanation":"作为谈资。也指作为指责、攻击他人的把柄。","source":{"text":"若不恤其患，而以为口实，其无乃不堪任命，而翦为仇雠，敝邑是惧。","book":"《左传·襄公二十二年》"},"example":{"text":"宰相命奉使即行遣，苗请付司详议，勿使宪司～。","book":"清·毕沅《续资治通鉴》卷二百十九"},"similar":["引为口实"],"usage":"作谓语、定语；用于书面语"},{"id":5363,"word":"以为后图","pinyin":"yǐ wéi hòu tú","abbr":"ywht","explanation":"为以后作打算。","source":{"text":"斗伯比言于楚子曰：‘……汉东之国随为大，随张，必弃小国。’小国离，楚之利也。少师侈，请羸师以张之。熊率且比曰：‘季梁在，何益？’斗伯比曰：‘以为后图，少师得其君。’","book":"《左传·桓公六年》"},"usage":"作谓语、定语；用于书面语"},{"id":5364,"word":"以义为利","pinyin":"yǐ yì wéi lì","abbr":"yywl","explanation":"把道义作为利益。","source":{"text":"此谓国不以利为利，以义为利也。","book":"《礼记·大学》"},"example":{"text":"仁者～，不以利为利，故以财发身，不仁者则以身发财，菑害并至矣。","book":"《清史稿·祁俊藻传》"}},{"id":5365,"word":"以义割恩","pinyin":"yǐ yì gē ēn","abbr":"yyge","explanation":"义：道义。用大义割断私恩。指秉公办事，不殉私情。","source":{"text":"夫小不忍乱大谋，恩之所不能已者义之所割也。","book":"《汉书·孝成赵皇后传》"},"similar":["以义断恩"],"usage":"作谓语、定语；指不殉私情"},{"id":5366,"word":"以义断恩","pinyin":"yǐ yì duàn ēn","abbr":"yyde","explanation":"用大义割断私恩。指秉公行事，不徇私情。","source":{"text":"凡所以立品设状者，求人才以理物也，非虚饰名誉，相为好丑。虽孝悌之行，不施朝廷，故门外之事，以义断恩。","book":"《晋书·刘毅传》"},"similar":["以义割恩"],"usage":"作谓语、定语；指不殉私情"},{"id":5367,"word":"以义灭身","pinyin":"yǐ yì miè shēn","abbr":"yyms","explanation":"灭身：牺牲生命。为追求道义而牺牲。","source":{"text":"及至袁绍据河北，兵势强盛，孤自度势，实不敌之，但计投死为国，以义灭身，足垂于后。","book":"三国·魏·曹操《让县自明本志令》"}},{"id":5368,"word":"以乐慆忧","pinyin":"yǐ lè tāo yōu","abbr":"ylty","explanation":"乐：快乐。以娱乐度过忧患。比喻以快乐的方式来掩饰忧愁。","source":{"text":"政在家门，民无所依，君日不悛，以乐慆忧。","book":"《左传·昭公三年》"}},{"id":5369,"word":"以书为御","pinyin":"yǐ shū wéi yù","abbr":"yswy","explanation":"按照书本上学来的知识去驾驭马匹。比喻死守教条，难以成事。","source":{"text":"谚曰：‘以书为御者，不尽于马之情。以古制今者，不达于事之变。’","book":"《战国策·赵策二》"},"usage":"作宾语、定语；用于处事"},{"id":5370,"word":"以乱易暴","pinyin":"yǐ luàn yì bào","abbr":"ylyb","explanation":"以：用；易：改变，更换；暴：残暴。用残暴势力代替残暴势力。指统治者换了，暴虐的统治没有改变。","source":{"text":"登彼高山，言采其薇。以乱易暴，不知其非。神农虞夏，忽焉没兮，我适安归。","book":"《乐府诗集·采薇操》"},"example":{"text":"割牲而盟以为信，因四内与共头以明行，扬梦以说众，杀伐以要利，以此绍殷，是～也。","book":"《吕氏春秋·诚廉》"}},{"id":5371,"word":"以五十步笑百步","pinyin":"yǐ wǔ shí bù xiào bǎi bù","abbr":"ywsbxbb","explanation":"作战时后退了五十步的人讥笑后退了百步的人。比喻自己跟别人有同样的缺点错误，只是程度上轻一些，却毫无自知之明地去讥笑别人。","source":{"text":"填然鼓之，兵刃既接，弃甲曳兵而走，或百步而后止，或五十步而后止。以五十步笑百步，则何如？","book":"《孟子·梁惠王上》"},"example":{"text":"老舍《四世同堂》：“他和瑞丰原来差不多，他看不起瑞丰也不过是～罢了。”"},"similar":["五十步笑百步"],"usage":"作谓语、定语；用于处事","story":["战国时期，梁惠王向孟子请教为什么人口不增长的原因，孟子说：“你是关心百姓的疾苦，但你喜欢打仗，不少百姓死于战争。打比方说战争中潜逃50步的士兵讥笑逃100步的士兵，逃跑的本质是一样的。”梁惠王表示将要停止打仗"]},{"id":5372,"word":"以人为本","pinyin":"yǐ rén wéi běn","abbr":"yrwb","explanation":"指尊重人的人格，维护人的权益，发展人的潜能，满足人的需要。"},{"id":5373,"word":"以人为鉴","pinyin":"yǐ rén wéi jiàn","abbr":"yrwj","explanation":"《书·酒诰》：“古人有言曰：‘人无于水监，当于民监。’”于，以；监，通“鉴”，镜。《国语·吴语》：“王其盍亦鉴于人，无鉴于水。”韦昭注引《书》曰：“人无于水鉴，当于民鉴。”","source":{"text":"以铜为鉴，可正衣冠；以古为鉴，可知兴替，～，可明得失。 ★《新唐书·魏徵传》"},"example":{"text":"以铜为鉴，可正衣冠；以古为鉴，可知兴替，～，可明得失。","book":"《新唐书·魏徵传》"},"similar":["以人为镜"],"usage":"作谓语、定语；指借鉴别人的经验"},{"id":5374,"word":"以人为镜","pinyin":"yǐ rén wéi jìng","abbr":"yrwj","explanation":"把别人的成败得失作为自己的借鉴。","source":{"text":"君子不镜于水而镜于人。镜于水，见面之容；镜于人，则知吉与凶。","book":"战国·宋·墨翟《墨子·非攻中》"},"example":{"text":"以古为镜，可以知兴替，～，可以明得失。","book":"《旧唐书·魏徵传》"},"similar":["以人为鉴"],"usage":"作谓语、定语；指借鉴别人的经验"},{"id":5375,"word":"以人废言","pinyin":"yǐ rén fèi yán","abbr":"yrfy","explanation":"以：因为；废：废弃。因为说话人的地位的低下或犯有错误就不采纳他所说的正确的意见。","source":{"text":"君子不以言举人，不以人废言。","book":"《论语·卫灵公》"},"example":{"text":"径寸之宝，或隐沙泥；～，君子斯戒。","book":"《梁书·武帝纪中》"},"similar":["因人废言"],"usage":"作谓语、定语；指因喜好而看问题"},{"id":5376,"word":"以人择官","pinyin":"yǐ rén zé guān","abbr":"yrzg","explanation":"根据人的才能选授适当的官职。","source":{"text":"以此推之，知国家以人择官，不为官择人也。","book":"晋·陈寿《三国志·魏书·任苏杜郑仓传》"}},{"id":5377,"word":"以仁为本","pinyin":"yǐ rén wéi běn","abbr":"yrwb","explanation":"仁：仁爱；本：根本。以仁爱为治理国家的根本。","source":{"text":"古者以人为本，以义治之之谓正。","book":"《司马法·仁本》"},"example":{"text":"举大事者必～，今人归我，奈何弃之？","book":"明·罗贯中《三国演义》第四十一回"}},{"id":5378,"word":"以介眉寿","pinyin":"yǐ jiè méi shòu","abbr":"yjms","explanation":"介：祀求；眉寿：长辈。古人认为眉毛长的人寿命也长。祀求长寿。","source":{"text":"八月剥枣，十月获稻。为此春酒，以介眉寿。","book":"《诗经·豳风·七月》"},"example":{"text":"顾予缵服，均霈多士，进秩之宠，隐显同之。往服异恩，～。","book":"宋·苏辙《致仕马充等以登极恩改承奉郎》"}},{"id":5379,"word":"以众击寡","pinyin":"yǐ zhòng jī guǎ","abbr":"yzjg","explanation":"用多数人去进攻少数人。比喻用优势的兵力去进攻劣势的敌人。","source":{"text":"我专为一，敌分为十，是以十攻其一也，则我众而敌寡；能以众击寡者，则吾之所与战者，约矣。","book":"《孙子·虚实》"},"example":{"text":"君尝以寡击众，取胜如神，况以强击弱，～乎？","book":"《战国策·中山策》"}},{"id":5380,"word":"以众暴寡","pinyin":"yǐ zhòng bào guǎ","abbr":"yzbg","explanation":"以人多势众的一帮去欺凌、迫害人少势弱的一方。","source":{"text":"神农既没，以强胜弱，以众暴寡。","book":"《商君书·画策》"},"example":{"text":"山林独善，不能制群体之曼延，橧巢见并，松栎为摧，～，又可睹矣！","book":"章炳麟《〈无政府主义〉序》"},"usage":"作谓语、定语；用于处事"},{"id":5381,"word":"以众暴寡，以强凌弱","pinyin":"yǐ zhòng bào guǎ，yǐ qiáng líng ruò","abbr":"yzbgyqlr","explanation":"暴、凌：欺侮，侵犯；寡：少。凭借强大或人多，去欺侮弱小者。","source":{"text":"自是之后，以强陵弱，以众暴寡，汤、武以来，皆乱人之徒也。","book":"《庄子·盗跖》"},"similar":["以强凌弱，以众暴寡","倚强凌弱"],"usage":"作宾语、定语；用于处事"},{"id":5382,"word":"以伪乱真","pinyin":"yǐ wěi luàn zhēn","abbr":"ywlz","explanation":"把假的混在真的里面，使真假不分。","source":{"text":"《汉书·王莽赞》云：‘紫色蛙声，馀分闰位。’谓以伪乱真耳！","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"～恣惶惑，何人辨析荡清廓。","book":"高燮《题变雅楼三十年词徴》"},"similar":["以假乱真"],"usage":"作谓语、定语、宾语；指弄虚作假"},{"id":5383,"word":"以伪谤真","pinyin":"yǐ wěi bàng zhēn","abbr":"ywbz","explanation":"用假的去冒充真的，致使人分辨不清。","source":{"text":"校之形迹，精粗已悬；核以至理，真伪岂隐。若以粗笑精，以伪傍真，是瞽对离朱曰我明也。","book":"南朝·梁·刘勰《灭论》"}},{"id":5384,"word":"以佚待劳","pinyin":"yǐ yì dài láo","abbr":"yydl","explanation":"多指作战时采取守势，养精蓄锐，让敌人来攻，然后乘其疲劳，战而胜之。","source":{"text":"以近待远，以佚待劳，以饱待饥，此治力者也。","book":"《孙子·军争》"},"similar":["以逸待劳","以逸击劳"],"usage":"作谓语、定语；用于书面语"},{"id":5385,"word":"以假乱真","pinyin":"yǐ jiǎ luàn zhēn","abbr":"yjlz","explanation":"以：用；乱：混乱。用假的东西去冒充或混杂真的东西。","source":{"text":"馀分闰位，谓以伪乱真耳。","book":"北齐·颜之推《颜氏家训》"},"example":{"text":"如此办法，势必～，以少报多。","book":"清·李百川《绿野仙踪》第四卷"},"similar":["似是而非","鱼目混珠","似真似假"],"opposite":["画虎类犬","刻鹄类鹜"],"usage":"作谓语、定语、分句；指弄虚作假"},{"id":5386,"word":"以偏概全","pinyin":"yǐ piān gài quán","abbr":"ypgq","explanation":"以：用；偏：片面；概：概括；全：全部。用片面的观点看待整体问题。","source":{"text":"首先要对讨论和批评的问题研究清楚，绝不能以偏概全，草木皆兵，不能以势压人，强词夺理。","book":"邓小平《党在组织战线和思想战线上的迫切任务》"},"example":{"text":"只有分析地阅读，才能学得深透，不致囫囵吞枣，一知半解；只有综合地阅读，才能学得完整系统，不致断章取义，～","book":"吴家国《普通逻辑》"},"similar":["一孔之见","以管窥天","一概而论"],"usage":"作谓语、定语；指看问题片面"},{"id":5387,"word":"以偏盖全","pinyin":"yǐ piān gài quán","abbr":"ypgq","explanation":"偏：片面，　一方面。以片面去掩盖全体。形容看问题片面狭窄。"},{"id":5388,"word":"以儆效尤","pinyin":"yǐ jǐng xiào yóu","abbr":"yjxy","explanation":"儆：使人警醒，不犯错误；效：仿效，效法；尤：过失。指处理一个坏人或一件坏事，用来警告那些学着做坏事的人。","source":{"text":"郑伯效尤，其亦将有咎！","book":"《左传·庄公二十一年》"},"example":{"text":"我以为各人均应先打屁股百下，～。","book":"鲁迅《准风月谈·文床秋梦》"},"similar":["杀鸡儆猴","杀一儆百"],"opposite":["如法炮制"],"usage":"作谓语；同“杀一儆百”"},{"id":5389,"word":"以党举官","pinyin":"yǐ dǎng jǔ guān","abbr":"ydjg","explanation":"按照朋党关系来选拔官吏。","source":{"text":"今若以誉进能，则臣离上而下比周；若以党举官，则民务交而不求用于法。故官之失能者其国乱。","book":"《韩非子·有度》"}},{"id":5390,"word":"以公灭私","pinyin":"yǐ gōng miè sī","abbr":"ygms","explanation":"指出以公心而去掉个人的私情或恩怨。","source":{"text":"以天下之公理，灭一己之私情。","book":"《书·周官》：“以公灭私，民其允怀。”蔡沈集传"},"example":{"text":"太史必当谨书灾异。愿陛下翕受敷施，以壮人才之精神；虚心容纳，以植人言之骨干。念邦本而～，严边备而思患豫防。","book":"元·脱脱《宋史·马廷鸾传》"},"usage":"作谓语、定语；用于书面语"},{"id":5391,"word":"以其人之道，还治其人之身","pinyin":"yǐ qí rén zhī dào，huán zhì qí rén zhī shēn","abbr":"yqrzdhzqrzs","explanation":"以：拿；治：惩处。用别人的办法来惩治别人。","source":{"text":"故君子之治人也，即以其人之道，还治其人之身。","book":"宋·朱熹《中庸集注》"},"example":{"text":"对于敌人的挑衅，我们要以其人之道，还治其人之身。"},"similar":["以牙还牙","以眼还眼"],"usage":"作谓语、宾语；指以牙还牙"},{"id":5392,"word":"以其昏昏，使人昭昭","pinyin":"yǐ qí hūn hūn，shǐ rén zhāo zhāo","abbr":"yqhhsrzz","explanation":"昏昏：模糊，糊涂；昭昭：明白。指自己还糊里糊涂，却要去教别人明白事理。","source":{"text":"贤者以其昭昭，使人昭昭；今以其昏昏，使人昭昭。","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"毛泽东同志曾教导我们，～，是不行的。","book":"邓小平《在全国科学大会开幕式上的讲话》"},"similar":["以讹传讹"],"usage":"作谓语、宾语；指以讹传讹"},{"id":5393,"word":"以养伤身","pinyin":"yǐ yǎng shāng shēn","abbr":"yyss","explanation":"为了获得养育自己的条件，反而使身体受到损害。比喻得不偿失。","source":{"text":"《庄子·让王》：“夫人王亶父，可谓能尊生矣。能尊生者，虽贵富，不以养伤身；虽贫贱，不以利累形。今世之人，居高官尊爵者，皆重失之。见利轻亡其身，岂不惑哉！”按，此语亦见《吕氏春秋·审为》与《淮南子·道应训》。"},"usage":"作宾语、定语；用于书面语"},{"id":5394,"word":"以冠补履","pinyin":"yǐ guān bǔ lǚ","abbr":"ygbl","explanation":"冠：帽子；履：鞋子。用帽子补鞋。比喻以贵重物品配贱物。","source":{"text":"履虽鲜不如于枕，冠虽敝不以苴履。","book":"《汉书·贾谊论》"},"usage":"作谓语、宾语、定语；指以贵重物品配贱物"},{"id":5395,"word":"以冰致蝇","pinyin":"yǐ bīng zhì yíng","abbr":"ybzy","explanation":"致：招引。用冰块引苍蝇。比喻事情必难实现。","source":{"text":"以狸致鼠，以冰致蝇，虽工不能。","book":"《吕氏春秋·功名》"},"similar":["以狸致鼠","缘木求鱼"],"usage":"作谓语、宾语、定语；比喻事情必难实现"},{"id":5396,"word":"以刑去刑","pinyin":"yǐ xíng qù xíng","abbr":"yxqx","explanation":"用刑罚遏止刑罚，意指从重量刑，使百姓畏惧而不敢犯法，以收到不用刑的效果。","source":{"text":"以刑去刑，国治。","book":"《商君书·靳令》：“行罚，重其轻者，轻其重者，轻者不至，重者不来，此谓以刑去刑，刑去事成。”高亨注：“‘轻其重者’一句是衍文，《韩非子·饬令篇》无，是其证。”又《去强》"},"similar":["以刑止刑"],"usage":"作宾语、定语；用于书面语"},{"id":5397,"word":"以刑止刑","pinyin":"yǐ xíng zhǐ xíng","abbr":"yxzx","explanation":"犹以刑去刑。","source":{"text":"以刑止刑，世轻世重。罪不及嗣，皆有定科。","book":"《周书·武帝纪下》"},"example":{"text":"不立制度，则未之前闻，故曰～，以杀止杀。","book":"《唐律·名例一》"},"similar":["以刑去刑"],"usage":"作宾语、定语；用于书面语"},{"id":5398,"word":"以刑致刑","pinyin":"yǐ xíng zhì xíng","abbr":"yxzx","explanation":"对重罪施以轻刑，则罪犯无所畏惧，其结果将导致不断用刑。","source":{"text":"罪重而刑轻，刑轻而则事生，此谓以刑致刑，其国必削。","book":"《商君书·靳令》：“罪重刑轻，刑至事生，此谓以刑致刑，其国必削。”又《去强》：“以刑致刑，国治。”《韩非子·饬令》"},"usage":"作宾语、定语；用于书面语"},{"id":5399,"word":"以利相倾","pinyin":"yi li xiang qu","abbr":"ylxq","explanation":"依靠钱财争权夺利，互相排挤。"},{"id":5400,"word":"以利累形","pinyin":"yǐ lì lěi xíng","abbr":"yllx","explanation":"为了谋取利益而危害身体。","source":{"text":"虽贫贱，不以利累形。","book":"《吕氏春秋·审为》"},"usage":"作谓语、定语；用于劝诫人"},{"id":5401,"word":"以刺世事","pinyin":"yǐ cì shì shì","abbr":"ycss","explanation":"以：表示目的的连词。来讽刺当世之事。","source":{"text":"上称帝喾，下道齐桓，中述汤、武，以刺世事。","book":"西汉·司马迁《史记·屈原贾生列传》"},"usage":"作谓语；指讽刺"},{"id":5402,"word":"以剑补履","pinyin":"yǐ jiàn bǔ lǚ","abbr":"yjbl","explanation":"用宝剑来补鞋子。指所用的方法、措施无法解决问题。比喻运用不当。","source":{"text":"诚用之未当，令骥捕鼠，则何由得也；以剑补履，则无由克也。","book":"唐·李观《上陆相公书》"}},{"id":5403,"word":"以力服人","pinyin":"yǐ lì fú rén","abbr":"ylfr","explanation":"力：权势，武力。用强制手段使人服从。","source":{"text":"以力服人者，非心服也，力不赡也。","book":"《孟子·公孙丑上》"},"example":{"text":"压服的结果总是压而不服。～是不行的。","book":"毛泽东《在中国共产党全国宣传工作会议上的讲话》"},"similar":["蛮不讲理"],"opposite":["以理服人"],"usage":"作主语、谓语、宾语；指蛮不讲理","story":["战国时期，孟子到各地去游说他的仁道，有人说靠武力照样可以称霸，根本用不上讲仁道。孟子说：“靠武力称霸必须要以国富民强为基础，是武力压服而非心悦诚服，而以仁道称霸，则可以让人心悦诚服，使国力强大。”"]},{"id":5404,"word":"以功补过","pinyin":"yǐ gōng bǔ guò","abbr":"ygbg","explanation":"用功劳来弥补过错。","source":{"text":"追悔既往，洗心自新。虽失之于壮齿，冀收之于晚节。以功补过，过落而功全；以正易邪，邪忘而正在。","book":"《云笈七签》卷九十三"},"example":{"text":"宋·张君房《云笈七签》第93卷：“～，过落而功全；以正易邪，邪忘而正在。”"},"similar":["将功补过","以功覆过"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":5405,"word":"以功覆过","pinyin":"yǐ gōng fù guò","abbr":"ygfg","explanation":"用功劳来补偿过错。","source":{"text":"据以为天下未定，宜以功覆过，弃瑕取用，举清厉浊，足以沮功，若一时贬黜，惧有后咎。","book":"《三国志·吴志·朱据传》"},"similar":["以功补过"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":5406,"word":"以功赎罪","pinyin":"yǐ gōng shú zuì","abbr":"ygsz","explanation":"用功劳抵消罪过。","source":{"text":"以功赎罪。","book":"晋·陈寿《三国志·吴志·凌统传》"},"similar":["将功赎罪"],"usage":"作谓语、宾语、定语；指拿功劳补偿过失","story":["三国时期，东吴孙权任命凌统为破贼都尉，让他与张异领兵攻打麻屯。将领陈勤固执傲慢，看不起凌统，于是百般羞辱他。凌统忍无可忍就杀了他。在攻打麻屯的战斗中，凌统立下大功，班师回朝，他向孙权负荆请罪，孙权让他以功赎罪"]},{"id":5407,"word":"以劳击逸","pinyin":"yǐ láo jī yì","abbr":"yljy","explanation":"用疲劳的军队去进攻养精蓄锐的敌人。","source":{"text":"卿逾河历险，以劳击逸，以寡胜众，功过南仲，勤逾吉甫。此勋非但破胡，乃永宁河右，使吾长无西顾之念矣。","book":"三国·魏·曹丕《与张既诏》"}},{"id":5408,"word":"以势压人","pinyin":"yǐ shì yā rén","abbr":"ysyr","explanation":"以：凭借。凭借自己的权势去压制别人。","source":{"text":"首先要对讨论和批评的问题研究清楚，绝不能以偏概全，草木皆兵，不能以势压人，强词夺理。","book":"邓小平《党在组织战线和思想战线上的迫切任务》"},"example":{"text":"你这样做叫～。"},"similar":["以大欺小"],"usage":"作谓语、定语、宾语；用于处事"},{"id":5409,"word":"以勤补拙","pinyin":"yǐ qín bǔ zhuō","abbr":"yqbz","explanation":"用勤奋补救笨拙，含有自谦之意。","source":{"text":"心无别虑，笔不暂停。或毕景忘餐，或连宵不寐。以勤补拙，不遑自处。","book":"隋·李德林《〈霸朝集〉序》"},"similar":["将勤补拙"],"usage":"作谓语、定语；用于处事"},{"id":5410,"word":"以匡不逮","pinyin":"yǐ kuāng bù dǎi","abbr":"ykbd","explanation":"匡：匡正；不逮：不及，考虑不周的地方。达到改正不周全地方的目的。多用于请人提意见。","source":{"text":"幸托椒房，位列上将。幕府初开，欲辟天下奇伟，以匡不逮，惟诸君博求其器。","book":"《后汉书·李充传》"},"example":{"text":"上国是箕子开基，文明礼乐，自汉唐以来，世多硕辅。这几人都是昔日盟友，相助分理，～。","book":"清·陈忱《水浒后传》第四十回"}},{"id":5411,"word":"以升量石","pinyin":"yǐ shēng liáng dàn","abbr":"ysld","explanation":"升、石：容量单位，十升为一斗，十斗为一石。比喻以肤浅的理解力推测深奥的道理。","source":{"text":"使尧度舜则可，使桀度尧，是犹以升量石也。","book":"《淮南子·缪称训》"},"usage":"作谓语、定语；指处世方法不对"},{"id":5412,"word":"以半击倍","pinyin":"yǐ bàn jī bèi","abbr":"ybjb","explanation":"用半数兵力击破一倍于己的敌人。形容取胜之易。","source":{"text":"敌国器备，不可施行；故此虽半，可以击彼之倍。","book":"《管子·制分》：“人事荒乱，以十破百；器备不行，以半击倍。”尹知章注"},"example":{"text":"诸侯未会，君臣未和，沟垒未成，禁令未施，三军匈匈，欲前不能，欲去不敢，～，百战不殆。","book":"《吴子·料敌》"},"usage":"作宾语、定语；用于军事或处事等"},{"id":5413,"word":"以华制华","pinyin":"yǐ huá zhì huá","abbr":"yhzh","explanation":"华：中国人；制：控制。用中国人控制中国人","source":{"text":"它将更厉害地进行其‘以华制华’的政治进攻和‘以战养战’的经济侵略。","book":"毛泽东《关于国际新形势对新华日报记者的谈话》"},"opposite":["以夷制夷"],"usage":"作宾语、定语；用于外国人"},{"id":5414,"word":"以华治华","pinyin":"yǐ huá zhì huá","abbr":"yhzh","explanation":"近百年来帝国主义侵略中国一惯利用中国的投降派、卖国贼政府来间接控制中国的政策。"},{"id":5415,"word":"以博一粲","pinyin":"yǐ bó yī càn","abbr":"ybyc","explanation":"以：用；博：赢得；粲：笑时露出牙齿的样子。设法赢得对方一笑，","source":{"text":"上月印《故事新编》一本，游戏之作居多，已托书店寄上一本，以博一粲耳。 ★鲁迅《书信集·致杨霁云》"}},{"id":5416,"word":"以危为安，以乱为治","pinyin":"yǐ wēi wéi ān，yǐ luàn wéi zhì","abbr":"ywwaylwz","explanation":"把危亡视为安定，把暴乱视为天下太平。比喻看不到潜在的政治危机，苟且偷安。","source":{"text":"夫以天下之位，乘今之时，因天之助，尚惮以危为安，以乱为治。","book":"汉·贾谊《治安策》"},"usage":"作宾语、定语；用于处事"},{"id":5417,"word":"以卵击石","pinyin":"yǐ luǎn jī shí","abbr":"yljs","explanation":"拿蛋去碰石头。比喻不估计自己的力量，自取灭亡。","source":{"text":"经桀作尧，譬之若以卵投石，以指绕沸。","book":"《荀子·议兵》"},"example":{"text":"刘豫州不识天时，强欲与争，正如～，安得不败乎？","book":"明·罗贯中《三国演义》第四十三回"},"similar":["以卵投石","不自量力"],"usage":"作谓语、定语、宾语；指自不量力","story":["战国时期著名思想家墨子，他到齐国去的路上碰到一个算命先生，算命先生说他脸色不好，不宜前去。墨翟根本不相信他的这一套，说算命先生是迷信，迷信是战胜不了真理的，拿迷信来否定真理就好比“以卵击石”，对真理毫无损伤"]},{"id":5418,"word":"以卵就石","pinyin":"yǐ luǎn jiù shí","abbr":"yljs","explanation":"拿蛋去碰石头。比喻不估计自己的力量，自取灭亡。","source":{"text":"以其言非吾言者，是犹以卵投石也，尽天下之卵，其石犹是也，不可毁也。","book":"《荀子·议兵》：“经桀作尧，譬之若以卵投石，以指绕沸。”《墨子·贵义》"},"example":{"text":"无如彼党日渐猖獗，一经妄动，不啻飞蛾投火，～。","book":"清·李汝珍《镜花缘》第五十七回"}},{"id":5419,"word":"以卵投石","pinyin":"yǐ luǎn tóu shí","abbr":"ylts","explanation":"拿蛋去碰石头。比喻不估计自己的力量，自取灭亡。","source":{"text":"以其言非吾言者，是犹以卵投石也，尽天下之卵，其石犹是也，不可毁也。","book":"《荀子·议兵》：“经桀作尧，譬之若以卵投石，以指绕沸。”《墨子·贵义》"},"example":{"text":"以人力而欲与理势为敌，譬犹～，以蜉撼树，徒见其不自重耳。","book":"清·梁启超《立宪法议》"},"similar":["不自量力","无济于事","自取灭亡"],"opposite":["行之有效"],"usage":"作谓语、定语、宾语；指自取灭亡","story":["战国时期著名思想家墨子，他到齐国去的路上碰到一个算命先生，算命先生说他脸色不好，不宜前去。墨翟根本不相信他的这一套，说算命先生是迷信，迷信是战胜不了真理的，拿迷信来否定真理就好比“以卵击石”，对真理毫无损伤"]},{"id":5420,"word":"以卵敌石","pinyin":"yǐ luǎn dí shí","abbr":"ylds","explanation":"用蛋去抵挡石头，比喻不自量力。","source":{"text":"周瑜小子，偏怀浅戆，自负其能，辄欲以卵敌石；兼之擅作威福，无罪受刑，有功不赏。盖系旧臣，无端为所摧辱，心实恨之！","book":"明·罗贯中《三国演义》第四十七回"},"example":{"text":"清·无垢道人《八仙全传》第16回：“若要和他抵抗，正是～，必败无疑。”"},"similar":["以卵击石","以卵投石","以蛋碰石"],"usage":"作谓语、定语、宾语；指自取灭亡"},{"id":5421,"word":"以叔援嫂","pinyin":"yǐ shū yuán sǎo","abbr":"ysys","explanation":"指权宜行事。","source":{"text":"淳于髡曰：‘男女授受不亲，礼与？’孟子曰：‘礼也。’曰：‘嫂溺，则援之以手乎？’曰‘嫂溺不援，是豺狼也。男女授受不亲，礼也；嫂溺援之以手者，权也。’","book":"《孟子·离娄上》"},"example":{"text":"春桃若肯改妆一战，管倩取唾手魁名……此正教做～，因急行权。","book":"明·徐渭《女状元》第一出"},"usage":"作宾语、定语；用于书面语"},{"id":5422,"word":"以口问心","pinyin":"yǐ kǒu wèn xīn","abbr":"ykwx","explanation":"一面口中自问，一面心中盘算。","source":{"text":"［程元玉］随又忖道：‘妇人之言，何足凭谁！况且他一顿饭钱，尚不能预备，就有惊恐，他如何出力相报得？’以口问心，行了几里。","book":"明·凌濛初《初刻拍案惊奇》卷四"},"example":{"text":"［杨佥宪］～，计较已定，踱将出厅来。","book":"明·凌濛初《二刻拍案惊奇》卷四"},"similar":["扪心自问"],"usage":"作谓语、定语；用于处事"},{"id":5423,"word":"以古为鉴","pinyin":"yǐ gǔ wéi jiàn","abbr":"ygwj","explanation":"借历史上的成败得失作为鉴戒。","source":{"text":"《新唐书·魏徵传》：“以铜为鉴，可正衣寇；以古为鉴，可知兴替；以人为鉴，可明得失。”按《旧唐书·魏徵传》“鉴”作“镜”。"},"similar":["以古为镜"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5424,"word":"以古为镜","pinyin":"yǐ gǔ wéi jìng","abbr":"ygwj","explanation":"借历史上的成败得失作为鉴戒。同“以古为鉴”。","source":{"text":"夫以铜为镜，可以正衣冠；以古为镜，可以知兴替；以人为镜，可以明得失。","book":"《旧唐书·魏徵传》"},"similar":["以古为鉴"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5425,"word":"以古制今","pinyin":"yǐ gǔ zhì jīn","abbr":"ygzj","explanation":"按照古代的成规来处理当今的事务。","source":{"text":"谚曰：‘以书为御者，不尽于马之情。以古制今者，不达于事之变。’","book":"《战国策·赵策二》"}},{"id":5426,"word":"以古喻今","pinyin":"yǐ gǔ yù jīn","abbr":"ygyj","explanation":"喻：说明。借用古代的事来说明今天的事情或道理。","source":{"text":"昔叔孙辞沃壤之地，萧何就穷僻之乡，以古方今，无渐曩哲。","book":"《北史·长孙嵩传》"},"similar":["以古非今","借古讽今","以古为鉴"],"usage":"作谓语、定语、状语；借用古代的事来说明现"},{"id":5427,"word":"以古方今","pinyin":"yǐ gǔ fāng jīn","abbr":"ygfj","explanation":"用古代人的人事与今天的人事相比。","source":{"text":"昔叔孙辞沃壤之地，萧何就穷僻之乡，以古方今，无惭曩哲。","book":"《北史·长孙嵩传》"},"example":{"text":"圣贤所行，因为尽礼，季孙宿亦能如是。～，相去何直千万也。","book":"宋·洪迈《容斋随笔·古人无忌讳》"},"usage":"作宾语、定语；用于书面语"},{"id":5428,"word":"以古非今","pinyin":"yǐ gǔ fēi jīn","abbr":"ygfj","explanation":"非：非难，否定。用历史故事抨击当前的政治。","source":{"text":"有敢偶语《诗》《书》者弃市，以古非今者族。吏见知不举者与同罪。","book":"《史记·秦始皇本纪》"},"similar":["以古讽今"],"usage":"作谓语、定语、状语；指用历史故事非难当今","story":["公元前213年，秦始皇在咸阳宫中摆酒贺寿。70位博士前来拜寿，丞相李斯当众宣布：“今后必须把《诗》、《书》及诸子百家的著作统统烧掉，再谈论者处死，以古非今也要处死，甚至满门操斩，秦始皇当众下诏通告天下"]},{"id":5429,"word":"以名取士","pinyin":"yǐ míng qǔ shì","abbr":"ymqs","explanation":"名：名声；取：取用。依据名望的高低作为选用人才的标准。","source":{"text":"何谓三累：惟亲所信，一累。以名取士，二累。近故亲疏，三累。","book":"《邓析子·无厚篇》"}},{"id":5430,"word":"以吕易嬴","pinyin":"yǐ lǚ yì yíng","abbr":"ylyy","explanation":"把吕姓代替嬴姓。比喻异姓乱宗。","source":{"text":"至若景泰以吕易嬴，是嬴亡于庄襄之手：弱晋以牛易马，是马灭于怀愍之时。","book":"清·程允升《幼学琼林·人事》"},"example":{"text":"若欲～，则吾岂敢。","book":"清·袁枚《小仓山房尺牍·答庆树斋少宰》"}},{"id":5431,"word":"以咽废飧","pinyin":"yǐ yè fèi sūn","abbr":"yyfs","explanation":"原意是说，因为有人吃饭噎死了，就想让天下人都不吃饭，这太荒谬了。比喻要做的事情由于出了点小毛病或怕出问题就索性不去干。","source":{"text":"夫有以噎死者，欲禁天下之食，悖。","book":"《吕氏春秋·荡兵》"},"example":{"text":"今不使外人呈事，于义可否？无人废职，职可废乎？职废则人乱，人乱则国安乎？～，此之谓也。","book":"《梁书·贺琛传》"}},{"id":5432,"word":"以售其伎","pinyin":"yǐ shòu qí jì","abbr":"ysqj","explanation":"售：销售。用来推行他的奸计。","source":{"text":"偷一旦之容以售其伎，吾无有也。","book":"唐·柳宗元《送娄图南秀才游淮南将入道序》"},"similar":["以售其奸"],"usage":"作谓语、定语；用于处事"},{"id":5433,"word":"以售其奸","pinyin":"yǐ shòu qí jiān","abbr":"ysqj","explanation":"售：销售。用来推行他的奸计。","source":{"text":"偷一旦之容以售其伎，吾无有也。","book":"唐·柳宗元《送娄图南秀才游淮南将入道序》"},"example":{"text":"有些明知故犯的人，例如张国焘，则利用许多党员的无知～。","book":"毛泽东《中国共产党在民族战争中的地位》"},"similar":["以售其伎"],"usage":"作谓语；指准备作恶"},{"id":5434,"word":"以售其术","pinyin":"yǐ shòu qí shù","abbr":"ysqs","explanation":"售：销售。用来推行他的谋术。","source":{"text":"后代葬说出于巫史，一物有失，便谓灾及死生，多为妨禁，以售其术，附妄凭妖。","book":"唐·柳宗元《送娄图南秀才游淮南将入道序》：“偷一旦之容以售其伎，吾无有也。”《新唐书·吕才传》"},"example":{"text":"此即所谓口技，特借之～耳。","book":"清·蒲松龄《聊斋志异·口技》"}},{"id":5435,"word":"以噎废飡","pinyin":"yǐ yē fèi cān","abbr":"yyfc","explanation":"由于吃饭打噎，便不敢再进食。比喻因偶然受到挫折，就停止应做的事情。"},{"id":5436,"word":"以噎废餐","pinyin":"yǐ yē fèi cān","abbr":"yyfc","explanation":"由于吃饭打噎，便不敢再进食。比喻因偶然受到挫折，就停止应做的事情。","source":{"text":"卿又云‘百司莫不奏事，诡竞求进’。今不许外人呈事，于义可否？以噎废餐，此之谓也。","book":"《南史·贺琛传》"},"similar":["因噎废食"],"usage":"作谓语、定语；用于比喻句"},{"id":5437,"word":"以壮观瞻","pinyin":"yǐ zhuàng guān zhān","abbr":"yzgz","explanation":"壮：加强。对事物的外观加以修饰，给人留下深刻的印象。","source":{"text":"云车丰马，从卫观瞻。","book":"《宋史·乐志》"},"example":{"text":"穿着彩衣的象奴从宣武门内象房中牵来六匹大象，守卫午门，～。","book":"姚雪垠《李自成》第四卷第二十章"}},{"id":5438,"word":"以备万一","pinyin":"yǐ bèi wàn yī","abbr":"ybwy","explanation":"万一：可能性极小的变化。事先做好周密防备，以防止万一发生变化。","source":{"text":"大时代来了，我们必须练习到脚能跑，手能作、肩能扛，以备万一。","book":"《八十一梦·第八梦》"},"example":{"text":"你走后，夫人担心慧梅姑娘在混战中会有三长两短，命老神仙立即动身赶来，～。","book":"姚雪垠《李自成》第三卷第六十章"},"similar":["以备不虞","以防万一"],"usage":"作谓语、宾语、定语；指预防"},{"id":5439,"word":"以备不虞","pinyin":"yǐ bèi bù yú","abbr":"ybby","explanation":"虞：猜度，预料。以防备预料不到的事。","source":{"text":"战国·吴起《吴子·图国》：”古之明王，必谨君臣之礼，饰上下之仪，安集吏民，顺俗而教，简募良材，以备不虞。“"},"example":{"text":"咱们吃过饭就去石门谷，好，要抢在官军前头！只是我有两个愚见请你听从，～。","book":"姚雪垠《李自成》第二卷第八章"},"similar":["以备万一"],"usage":"作谓语、定语、宾语；用于处事"},{"id":5440,"word":"以夜继日","pinyin":"yǐ yè jì rì","abbr":"yyjr","explanation":"用夜晚的时间接上白天，日夜不停。","source":{"text":"中山之俗，以昼为夜，以夜继日，男女切倚，固无休息。","book":"《吕氏春秋·先识》"},"example":{"text":"家贫借书，～，古人阅市偷光，殆不过此。","book":"元·辛文房《唐才子传·汪遵》"},"similar":["夜以继日","夜以接日","夜以继昼"],"usage":"作谓语、定语、状语；用于工作等"},{"id":5441,"word":"以夜继昼","pinyin":"yǐ yè jì zhòu","abbr":"yyjz","explanation":"犹言以夜继日。","source":{"text":"陛下远猎山林，以夜继昼，其如社稷宗庙何！","book":"《东观汉记·郅恽传》"},"example":{"text":"［子琮］又广拓旁邻，增修宅宇，～，未曾休息。","book":"《北史·冯子琮传》"},"similar":["以夜继朝","以夜继日","以夜续昼"],"usage":"作定语、状语；用于书面语"},{"id":5442,"word":"以夜继朝","pinyin":"yǐ yè jì zhāo","abbr":"yyjz","explanation":"犹言以夜继日。","source":{"text":"元帝在江荆间，复所爱习，召置学生，亲为教授，废寝忘食，以夜继朝。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["以夜继昼","以夜继日","以夜续昼"],"usage":"作定语、状语；用于书面语"},{"id":5443,"word":"以夜续昼","pinyin":"yǐ yè xù zhòu","abbr":"yyxz","explanation":"犹言以夜继日。","source":{"text":"灵运表陈疾，赐假东归。将行，上书劝伐河北，而游娱宴集，以夜续昼。","book":"《南史·谢灵运传》"},"similar":["以夜继昼","以夜继日","以夜继朝"],"usage":"作定语、状语；用于书面语"},{"id":5444,"word":"以大恶细","pinyin":"yǐ dà wù xì","abbr":"ydwx","explanation":"用大的罪名来责备人微小的过失。"},{"id":5445,"word":"以大欺小","pinyin":"yǐ dà qī xiǎo","abbr":"ydqx","explanation":"以：凭借。凭借自己强大去欺负弱小群体。","example":{"text":"我们不能～、以强欺弱。"},"similar":["以强欺弱"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5446,"word":"以天下为己任","pinyin":"yǐ tiān xià wéi jǐ rèn","abbr":"ytxwjr","explanation":"把国家的兴衰治乱作为自己的责任。","source":{"text":"休源风范强正，明练政体，常以天下为己任。","book":"《南史·孔休源传》"},"example":{"text":"经过这样磨炼成长起来的青年，才会有～的抱负。","book":"《人民日报》1965.6.1"},"usage":"作谓语、定语、宾语；用于处世","story":["春秋时期，孔子在鲁国政坛受到排挤，只好带领弟子周游列国，在卫国也没得到卫灵公的重视，他努力推销他的仁政，得不到当权者的认同，只好再次启程，在去匡城的途中感慨自己以天下为己任，到了花甲之年还在奔波，没有一个安身之所"]},{"id":5447,"word":"以夷伐夷","pinyin":"yǐ yí fá yí","abbr":"yyfy","explanation":"夷：旧指外族或外国。指在军事上利用对方本身的矛盾，使自相冲突，削弱力量。","source":{"text":"议者咸以羌胡相攻，县官之利，以夷伐夷，不宜禁护。","book":"《后汉书·邓训传》"},"example":{"text":"今幸遭天授，北虏分争，～，国家之利，宜可听许。","book":"宋·司马光《资治通鉴·汉纪·章帝章和二年》"},"similar":["以夷制夷","以夷攻夷","以夷治夷"],"usage":"作定语；指借助外界力量"},{"id":5448,"word":"以夷制夷","pinyin":"yǐ yí zhì yí","abbr":"yyzy","explanation":"夷：外族。利用外族和外国之间的内部矛盾，使其相互冲突，削弱其力量。","source":{"text":"议者咸以羌胡相攻，县官之利，以夷伐夷，不宜禁护。","book":"南朝·宋·范晔《后汉书·邓训传》"},"example":{"text":"我还记得，当去年中国有许多人，一味哭诉国联的时候，日本的报纸上往往加以讥笑，说这是中国祖传的～的老手段。","book":"鲁迅《伪自由书·～》"},"similar":["以夷治夷","以夷伐夷","以夷攻夷"],"usage":"作宾语、定语；指借助外界力量"},{"id":5449,"word":"以夷攻夷","pinyin":"yǐ yí gōng yí","abbr":"yygy","explanation":"使夷人自相攻伐。本是封建统治阶级对少数民族实行的一种民族分化政策。晚清时，亦指利用西方的科学技术来对付资本主义国家的侵略。","source":{"text":"给事中唐尧钦等亦言：‘材以夷攻夷，功不可泯。’","book":"《汉书·晁错传》：“以蛮夷攻蛮夷，中国之形也。”颜师古注：“不烦华夏之兵，使其同类互相攻击也。”《明史·李材传》"},"example":{"text":"是书何以作？曰：为～而作。","book":"清·魏源《〈海国图志〉序》"},"similar":["以夷治夷","以夷伐夷","以夷制夷"],"usage":"作宾语、定语；指借助外界力量"},{"id":5450,"word":"以夷治夷","pinyin":"yǐ yí zhì yí","abbr":"yyzy","explanation":"利用外族或外国之间的矛盾，使其互相冲突，削减力量，以便控制或攻伐。","source":{"text":"以夷治夷，可不烦兵而下。","book":"《明史·张祐传》"},"similar":["以夷制夷","以夷攻夷","以夷伐夷"],"usage":"作宾语、定语；指借助外界力量"},{"id":5451,"word":"以子之矛，攻子之盾","pinyin":"yǐ zǐ zhī máo，gōng zǐ zhī dùn","abbr":"yzzmgzzd","explanation":"子：对别人的称呼；矛：进攻敌人的刺击武器；盾：保护自己挡住敌人刀箭的牌。比喻拿对方的观点、方法或言论来反驳对方。","source":{"text":"楚人有鬻楯与矛者，誉之曰：‘吾楯之坚，莫能陷也。’又誉其矛曰：‘吾矛之利，于物无不陷也。’或曰：‘以子之矛陷子之楯何如？’其人弗能应也。","book":"《韩非子·难一》"},"example":{"text":"菲薄古书者，惟读过古书者最有力，这是的确的。因为他洞知弊病，能“～”。","book":"鲁迅《华盖集续编·古书与白话》"},"similar":["自相矛盾"],"usage":"作谓语、宾语；指矛盾的人或事物","story":["战国时期，大思想家韩非子曾讲有一个卖矛和盾的人，见人推销他的矛是世界上最尖利的矛，没有穿不透的东西；一会又向人推销他的盾是世界上最坚硬的盾，没有什么东西能戳穿它。人群中有人问他用他的矛戳他的盾，他只好落荒而逃"]},{"id":5452,"word":"以学愈愚","pinyin":"yǐ xué yù yú","abbr":"yxyy","explanation":"指用学习改变愚昧的秉性。"},{"id":5453,"word":"以守为攻","pinyin":"yǐ shǒu wéi gōng","abbr":"yswg","explanation":"用防御作为击破敌人的手段。","source":{"text":"盖充国以先零穷寇，急与之角，则中国必有馈挽转输之劳，故罢骑留屯而图以期月，此则以守为攻者也。","book":"宋·秦观《边防策下》"},"example":{"text":"我军决定暂时～，消耗敌人兵力，然后再集中力量突过河去，全歼敌人。","book":"李天银《扼住敌人的咽喉》"},"usage":"作谓语、宾语、定语；用于战争或处事"},{"id":5454,"word":"以实为虚","pinyin":"yǐ shí wéi xū","abbr":"yswx","explanation":"虚：空；实：满。军事上迷惑对方，使其难辨虚实、真伪的一种战术。","source":{"text":"诗有实字而善用之者，以实为虚。","book":"宋·杨万里《诚斋诗话》"}},{"id":5455,"word":"以宫笑角","pinyin":"yǐ gōng xiào jué","abbr":"ygxj","explanation":"宫、角，均为古代五音之一。拿宫调讥笑角调。比喻用自以为是的偏见去讽刺、否定别人。","source":{"text":"今代之人，为武者则非文，为文者则嗤武，各执其所长而相是非，犹以宫笑角，非适才之情，得实之论也。","book":"北齐·刘昼《新论·文武》"},"example":{"text":"宁藏拙而不为则可，若护其所短，而反讥人之所长，则不可。所谓～，以白诋青者，谓之陋儒。","book":"清·袁枚《随园诗话》卷五"},"usage":"作宾语、定语；用于比喻句"},{"id":5456,"word":"以容取人","pinyin":"yǐ róng qǔ rén","abbr":"yrqr","explanation":"只凭容貌来衡量人的品质和才能。","source":{"text":"以容取人，则失之子羽； 以辞取人，则失之宰予。","book":"《韩非子·显学》：“孔子曰：‘以容取人乎，失之子羽；以言取人乎，失之宰予。”《孔子家语·子路初见》"},"similar":["以貌取人"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5457,"word":"以宽服民","pinyin":"yǐ kuān fú mín","abbr":"ykfm","explanation":"宽：宽厚；服：信服。宽厚待人，民众才能顺服。","source":{"text":"唯有德者能以宽服民，其次莫如猛。","book":"《左传·昭公二十年》"}},{"id":5458,"word":"以寡敌众","pinyin":"yǐ guǎ dí zhòng","abbr":"ygdz","explanation":"寡：少；敌：抵挡；众：多。以少量的人抵挡众多的人。","source":{"text":"选其二百人为爪牙，每先锋以寡敌众，周人惮之。","book":"《北齐书·綦连猛传》"},"example":{"text":"白雕飞下接去，百不失一，是以对之已生感情，又见白雕～，三个人不住口的为白雕呐喊助威。","book":"金庸《射雕英雄传》第五回"},"similar":["以半击倍"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":5459,"word":"以小人之心，度君子之腹","pinyin":"yǐ xiǎo rén zhī xīn，duó jūn zǐ zhī fù","abbr":"yxrzxdjzzf","explanation":"用卑劣的心意去猜测品行高尚的人。","source":{"text":"愿以小人之腹为君子之心，属厌而已。","book":"《左传·昭公二十八年》"},"example":{"text":"他处处怀疑别人在跟他过不去，真是～。"},"similar":["以升量石","以己度人"],"opposite":["易地而处","将心比心","设身处地"],"usage":"作谓语、宾语、分句；指看人","story":["公元前514年，晋国魏舒继任执政大臣，他派魏戊去当梗阳县令。魏戊把一桩不好了断的官司上报给魏舒。官司的一法方送一个漂亮的女乐人给魏舒。大臣阎没和女宽借吃饭之机，劝谏魏舒，说他们是以小人之心，度君子之腹"]},{"id":5460,"word":"以小见大","pinyin":"yǐ xiǎo jiàn dà","abbr":"yxjd","explanation":"从小的可以看出大的，指通过小事可以看出大节，或通过一小部分看出整体。","source":{"text":"这样的事实不能算他的重要建设，可是以小见大，这几件小事不是没有完全了解新思潮的意义的人们所能办到的。","book":"老舍《赵子曰》"},"example":{"text":"～，我们可以看出他的为人。"},"similar":["以微知著","由小见大"],"opposite":["以管窥天","以蠡测海"],"usage":"作谓语、宾语、定语；用于看问题等"},{"id":5461,"word":"以少胜多","pinyin":"yǐ shǎo shèng duō","abbr":"yssd","explanation":"用少量兵力战胜强大的敌人。","source":{"text":"抗日战争打了八年，抗美援朝打了三年，我们有以少胜多、以弱胜强的传统。","book":"邓小平《我们有信心把中国的事情做得更好》"},"example":{"text":"历史上～的军事案例还不少。"},"usage":"作谓语、定语；多用于军事冲突"},{"id":5462,"word":"以尽吾齿","pinyin":"yi jin wu ci","abbr":"yjwc","explanation":"来度过我的一生."},{"id":5463,"word":"以屈求伸","pinyin":"yǐ qū qiú shēn","abbr":"yqqs","explanation":"屈：弯曲；伸：伸直伸展。用弯曲来求得向前伸展。比喻以退为进的策略。","source":{"text":"尺蠖之屈，以求信（伸）也。","book":"《周易·系辞下》"},"similar":["以退为进"],"usage":"作谓语、定语；指做事的策略"},{"id":5464,"word":"以己之心，度人之心","pinyin":"yǐ jǐ zhī xīn，dù rén zhī xīn","abbr":"yjzxdrzx","explanation":"用自己的想法去推测别人的心思。","source":{"text":"以己之心度人之心，未尝不同，则道之不远于人者可见。故己之所不欲，则勿以施至于人。","book":"《中庸》“施诸己而不愿亦勿施于人”宋·朱熹注"},"example":{"text":"朱吟秋 却在那里微笑；他听得孙吉人提到了什么长途汽车，什么矿山，他便老实断定孙吉人的办银行是‘淴浴主义’；他是最会～的。","book":"茅盾《子夜》三"},"similar":["以己度人","以己之心，度人之腹"],"usage":"作宾语、定语；用于处事"},{"id":5465,"word":"以己之心，度人之腹","pinyin":"yǐ jǐ zhī xīn，dù rén zh fù","abbr":"yjzxdrzf","explanation":"用自己的想法去推测别人的心思。同“以己之心，度人之心”。","source":{"text":"杨（杨慎）以朱（朱熹）忌而毁之，岂以己之心度人之腹乎！","book":"明·胡应麟《少室山房笔丛·艺林学山八》"},"example":{"text":"这真是以己之心度人之腹。这是极其可悲的民族虚无主义！","book":"巴金《随想录·一谈〈望乡〉》"},"similar":["以己度人","以己之心，度人之心"],"usage":"作宾语、定语；用于处事"},{"id":5466,"word":"以己养养鸟","pinyin":"yǐ jǐ yǎng yǎng niǎo","abbr":"yjyyn","explanation":"以人自己的生活方式来养鸟。比喻违背事物的客观规律，凭主观行事，必然招致失败。","source":{"text":"昔者海鸟止于鲁郊，鲁侯御而觞之于庙，奏九韶以为乐，具太牢以为膳。鸟乃眩视忧悲，不敢食一脔，不敢饮一杯，三日而死。此以己养养鸟也，非以鸟养养鸟也。","book":"《庄子·至乐》"}},{"id":5467,"word":"以己度人","pinyin":"yǐ jǐ duó rén","abbr":"yjdr","explanation":"度：揣度，推测。用自己的心思（多指不好的）去猜度别人。","source":{"text":"然则圣人何以不可欺也？曰：圣人以己度人者也，以心度心，以情度情，以类度类，古今一也。","book":"汉·韩婴《韩诗外传》卷三"},"example":{"text":"夫论事料敌，当～。","book":"《三国志·魏志·钟毓传》"},"similar":["审时度势","揆情度理"],"opposite":["解衣推食","推己及人"],"usage":"作谓语、定语、分句；指乱猜测"},{"id":5468,"word":"以己律人","pinyin":"yǐ jǐ lǜ rén","abbr":"yjlr","explanation":"用自己的主张去约束别人。","source":{"text":"但可惜大家总不肯这样办，偏要以己律人，所以天下就多事。","book":"鲁迅《论“费厄泼赖”应该缓行》"},"example":{"text":"～的做法太武断了。"},"usage":"作谓语、定语；指约束别人"},{"id":5469,"word":"以弱为弱","pinyin":"yǐ ruò wéi ruò","abbr":"yrwr","explanation":"本来弱小而愈显示出力量更小的样子，以麻痹对方，寻隙对敌方攻击。","source":{"text":"以强为强者，搏我也；以弱为弱者，误我也。","book":"明·无名氏《投笔肤谈·敌情》"}},{"id":5470,"word":"以弱制强","pinyin":"yǐ ruò zhì qiáng","abbr":"yrzq","explanation":"以：用，靠。弱：弱小。制：制服。靠着弱小的力量去制服强大的力量。亦作“以弱毙强”。","source":{"text":"善将者，其刚不可折，其柔不可卷，故以弱制强，以柔制刚。","book":"三国·蜀·诸葛亮《将苑·将刚》"},"example":{"text":"清·褚人获《隋唐演义》第50回：“陛下尝能～，稍得一胜，便起骄矜之意，以致三军损折，不以为戒，妾等无所托矣！”"},"usage":"作谓语、定语；用于处事"},{"id":5471,"word":"以弱毙强","pinyin":"yǐ ruò bì qiáng","abbr":"yrbq","explanation":"用弱小的力量制服强大的力量。","source":{"text":"善将者，其刚不可折，其柔不可卷，故以弱制强，以柔制刚。","book":"三国·蜀·诸葛亮《将苑·将刚》"},"example":{"text":"多慢则生乱，思善则生治，理之常也。故周文养民，以少取多；句践恤众，～。","book":"明·罗贯中《三国演义》第一百十二回"}},{"id":5472,"word":"以弱示强","pinyin":"yǐ ruò shì qiáng","abbr":"yrsq","explanation":"示：显示。把力量弱小伪装成十分强碱的样子，使对方产生威慑。","source":{"text":"凡与敌战，若敌众我寡，敌强我弱，须多设旌旗，倍增火灶，示强于敌，使彼能测我众寡强弱之形，则敌必不轻与我战，我可速去，则全军远害。","book":"明·刘基《百战奇略·弱战》"},"example":{"text":"至于曹操的赤壁之战，荷坚的淝水之战，则是～，大大夸大了自己人马的数量。","book":"姚雪垠《李自成》第四卷第四章"}},{"id":5473,"word":"以弱胜强","pinyin":"yǐ ruò shèng qiáng","abbr":"yrsq","explanation":"凭弱小的力量战胜力量强大的。","source":{"text":"抗日战争打了八年，抗美援朝打了三年，我们有以少胜多、以弱胜强的传统。","book":"邓小平《我们有信心把中国的事情做得更好》"},"example":{"text":"～的例子举不胜举。"},"similar":["以少胜多"],"opposite":["以强凌弱"],"usage":"作谓语、定语；指用计谋取胜"},{"id":5474,"word":"以强凌弱","pinyin":"yǐ qiáng líng ruò","abbr":"yqlr","explanation":"凌：欺侮。仗着自己强大就欺侮弱者。","source":{"text":"自是之后，以强凌弱，以众暴寡。","book":"《庄子·盗跖》"},"example":{"text":"于是一乡自为一国，一姓自为一群，以众暴寡，～，牵邻之牛，割邻之禾，视为固然。","book":"清·康有为《大同书》甲部"},"similar":["倚势凌人","弱肉强食","倚强凌弱"],"opposite":["除暴安良","抑强扶弱"],"usage":"作谓语、宾语；指人际关系等","story":["春秋时期，孔子去劝说弟子柳下季的弟弟盗跖。盗跖是奴隶起义首领，拥有9000兵力。孔子希望他自拥城称王，不要再骚扰百姓。盗跖说以前人们耕种取食，纺织取衣，没有加害之心，现在是凭借强大欺凌弱小的时代，不必再劝了"]},{"id":5475,"word":"以强凌弱，以众暴寡","pinyin":"yǐ qiáng líng ruò，yǐ zhòng bào guǎ","abbr":"yqlryzbg","explanation":"凌：侵犯，欺侮；暴：欺侮；寡：少。仗着自己强大就欺侮弱者，仗着人多去侵犯人少的对方","source":{"text":"自是之后，以强凌弱，以众暴寡，汤武以来，皆乱人之徒也。","book":"战国·宋·庄周《庄子·盗跖》"},"similar":["以众暴寡，以强凌弱"],"usage":"作宾语、定语；用于处事"},{"id":5476,"word":"以强欺弱","pinyin":"yǐ qiáng qī ruò","abbr":"yqqr","explanation":"以：凭借。凭借自己强大去欺负弱小群体。","source":{"text":"贤弟，我等忠义自守，以强欺弱，非所愿也。","book":"明·施耐庵《水浒传》第64回"},"example":{"text":"我讨厌那些～的人。"},"similar":["以大欺小"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5477,"word":"以强胜弱","pinyin":"yǐ qiáng shèng ruò","abbr":"yqsr","explanation":"指凭强大的力量欺凌弱小者和少数。","source":{"text":"神农既没，以强胜弱，以众暴寡。","book":"《商君书·画策》"}},{"id":5478,"word":"以彰报施","pinyin":"yǐ zhāng bào shī","abbr":"yzbs","explanation":"彰：显示，显扬；报施：报应。用来显示不断遭到报应。","source":{"text":"与其令杨氏出世报仇，又结来生不了之案，莫若令一天魔下界，扰乱唐室，任其自兴自灭，以彰报施。","book":"清·李汝珍《镜花缘》第三回"}},{"id":5479,"word":"以往鉴来","pinyin":"yǐ wǎng jiàn lái","abbr":"ywjl","explanation":"用过去的经验教训作为以后办事的借鉴。","source":{"text":"愿陛下动则三思，虑而后行，重慎出入，以往鉴来。","book":"《三国志·魏书·杨阜传》"},"similar":["前车可鉴"],"usage":"作谓语、定语；指借鉴以前经验"},{"id":5480,"word":"以微知着","pinyin":"yǐ wēi zhī zhù","abbr":"ywzz","explanation":"微：微小；着：显着。从事物露出的苗头，可以推知它的发展趋向或他的实质。","source":{"text":"惟天下之静者乃能见微而知着。","book":"宋·苏洵《辨奸论》"}},{"id":5481,"word":"以微知著","pinyin":"yǐ wēi zhī zhù","abbr":"ywzz","explanation":"微：微小；著：显著。从事物露出的苗头，可以推知它的发展趋向或他的实质。","source":{"text":"惟天下之静者乃能见微而知著。","book":"宋·苏洵《辨奸论》"},"similar":["举一反三","触类旁通","见微知著"],"opposite":["习焉不察"],"usage":"作谓语、宾语；指看问题的方法"},{"id":5482,"word":"以德报德","pinyin":"yǐ dé bào yu","abbr":"ydbd","explanation":"德：恩惠。用恩惠报答恩惠。","source":{"text":"或曰：‘以德报怨何如？’子曰：‘何以报德？以直报怨，以德报德。’","book":"《论语·宪问》"},"example":{"text":"九公才说恐女儿国将舅兄留下，日后倘有此事，我们就去救你出来，也算“～”了。","book":"清·李汝珍《镜花缘》第十九回"},"similar":["知恩图报"],"opposite":["恩将仇报"],"usage":"作谓语、宾语、定语；指知恩图报","story":["春秋时期，有人问孔子用恩德去酬报怨恨自己的人是否可行？孔子说：“如果怨恨我的人，我用恩德去酬报他，那么对我有恩德的人该如何酬报呢？因此，怨恨我的人，不如用正直的道理去开导他，对我有恩德的人，才能用思想去报答他。”"]},{"id":5483,"word":"以德报怨","pinyin":"yǐ dé bào yuàn","abbr":"ydby","explanation":"德：恩惠。怨：仇恨。不记别人的仇，反而给他好处。","source":{"text":"或曰：‘以德报怨何如？’子曰：‘何以报德？以直报怨，以德报德。’","book":"《论语·宪问》"},"example":{"text":"君子不念旧恶，～。","book":"宋·崔鶠《杨嗣复论》"},"similar":["以直报怨","以礼相待","以德报德"],"opposite":["忘恩负义","无情无义","翻脸无情"],"usage":"作谓语、宾语、定语；指品德高的人","story":["春秋时期，有人问孔子用恩德去酬报怨恨自己的人是否可行？孔子说：“如果怨恨我的人，我用恩德去酬报他，那么对我有恩德的人该如何酬报呢？因此，怨恨我的人，不如用正直的道理去开导他，对我有恩德的人，才能用思想去报答他。”"]},{"id":5484,"word":"以德服人","pinyin":"yǐ dé fú rén","abbr":"ydfr","explanation":"以良好的德行使百姓归顺、服从统治者。","source":{"text":"臣闻以德服人，天下欣戴，以力服人，天下怨望。","book":"宋·范仲淹《奏上时务书》"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“这样，便只有‘～’来打码头，想起‘冲天炮’的嘴脸，实在可恨。”"},"usage":"作宾语、定语；用于处事"},{"id":5485,"word":"以德追祸","pinyin":"yǐ dé zhuī huò","abbr":"ydzh","explanation":"指上对下施恩不当，适以招来祸患。","source":{"text":"故明主除人臣之所苦而立人主之所乐，上下之利莫长于此。不察私门之内，轻虑重事，厚诛薄罪，久怨细过，长侮偷快，数以德追祸，是断手而续以玉也，故世有易身之患。","book":"《韩非子·用人》"}},{"id":5486,"word":"以心传心","pinyin":"yǐ xīn chuán xīn","abbr":"yxcx","explanation":"佛教禅宗用语。指离开语文文字而以慧心相传授。","source":{"text":"法则以心传心，皆令自悟自解。","book":"《六祖大师法宝坛经·行由品》"},"example":{"text":"师问：“只如古德，岂不是～？”","book":"宋·释道原《景德传灯录》卷十八"},"similar":["口传心授"],"usage":"作谓语、宾语、定语；指口传心授"},{"id":5487,"word":"以心问心","pinyin":"yǐ xīn wèn xīn","abbr":"yxwx","explanation":"在心中自问自盘算。","source":{"text":"［知观］以心问心，忽然道：‘有计了。’","book":"明·凌濛初《初刻拍案惊奇》卷十七"},"example":{"text":"［翰林］～，跌足道：‘一二十年的事，三四千里的路，有甚查帐处？’","book":"明·凌濛初《二刻拍案惊奇》卷三"},"similar":["扪心自问"],"usage":"作谓语、宾语；用于处事"},{"id":5488,"word":"以忍为阍","pinyin":"yǐ rěn wéi hūn","abbr":"yrwh","explanation":"用忍耐作门。表示不轻易动怒而出言伤人，以免招来祸患。","source":{"text":"戒哉我口之启，尔心之门。无为我兵，当为我藩。以慎为键，以忍为阍。可以多食，勿以多言。","book":"唐·刘禹锡《口兵戒》"},"similar":["以慎为键"],"usage":"作谓语、定语；用于处事"},{"id":5489,"word":"以快先睹","pinyin":"yǐ kuài xiān dǔ","abbr":"ykxd","explanation":"犹言先睹为快。","source":{"text":"朝廷之士，引颈东望，若景星凤皇之始见也，争先睹之为快。","book":"语出唐·韩愈《与少室李拾遗书》"},"example":{"text":"《灵宝刀图》的复印本，真如原版一样，我希望这书的早日印成，～。","book":"鲁迅《书信集·致郑振铎》"},"similar":["先睹为快"],"usage":"作谓语、定语；用于书面语"},{"id":5490,"word":"以快言论","pinyin":"yǐ kuài yán lùn","abbr":"ykyl","explanation":"以：目的连词；快：使痛快。使言论痛快。","source":{"text":"询天下之异文鄙事以快言论。","book":"清·刘开《问说》"},"usage":"作谓语；指使言论痛快"},{"id":5491,"word":"以怨报德","pinyin":"yǐ yuàn bào dé","abbr":"yybd","explanation":"怨：仇恨；德：恩惠。用怨恨来回报别人的恩惠。","source":{"text":"以怨报德，不仁。","book":"《国语·周语》"},"example":{"text":"你自己想一想，你们做的事合理不合理？是不是～？","book":"冰心《斯人独憔悴》"},"similar":["忘恩负义","恩将仇报","翻脸无情"],"opposite":["以德报怨","以礼相待","以直报怨"],"usage":"作谓语、定语、宾语；指恩将仇报"},{"id":5492,"word":"以恶报恶","pinyin":"yǐ è bào è","abbr":"yebe","explanation":"用恶行去回报别人的恶行。","source":{"text":"前十八年。宋伐齐之丧，是恶也；今齐乘胜而报，是以恶报恶也。","book":"《榖梁传·僖公二十三年》：“伐国不言围邑。此言围邑，何也？不正其以恶报恶也。”范宁注"},"example":{"text":"他不主张～的，他的意思是皇帝叫我们去当兵，我们不去当兵。","book":"鲁迅《集外集拾遗补编·关于知识阶级》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":5493,"word":"以患为利","pinyin":"yǐ huàn wéi lì","abbr":"yhwl","explanation":"患：祸患，不利。把于己不利之处转变为有利。","source":{"text":"凡用兵之法，将受命于君，合军聚众，交和而舍，莫难于军争。军争之难者，以迂为直，以患为利。","book":"《孙子·军争篇》"}},{"id":5494,"word":"以意为之","pinyin":"yǐ yì wéi zhī","abbr":"yywz","explanation":"只凭自己的主观想法去做。","source":{"text":"故圣人耐以天下为一家，以中国为一人者，非意之也，必知其情，辟于其义，明于其利，达于其患，然后能为之。","book":"西汉·戴圣《礼记·礼运》"},"example":{"text":"假使～，那就决不能真切，深刻，也就不成为艺术。","book":"鲁迅《书信集·致李桦》"},"similar":["一意孤行"],"usage":"作谓语、定语；指为所欲为"},{"id":5495,"word":"以意逆志","pinyin":"yǐ yì nì zhì","abbr":"yynz","explanation":"意：意图；逆：猜度；志：心思。用自己的想法去揣度别人的心思。","source":{"text":"故说《诗》者，不以文害辞，不以辞害志；以意逆志，是为得之。","book":"《孟子·万章上》"},"example":{"text":"～，是以己之意迎受诗人之志而加以钩考。","book":"朱自清《诗言志辨·比兴》"},"similar":["以己度人"],"usage":"作谓语、定语；同“以己度人”"},{"id":5496,"word":"以慎为键","pinyin":"yǐ shèn wéi jiàn","abbr":"yswj","explanation":"用谨慎作锁。表示处事十分小心，不以言惹祸。","source":{"text":"戒哉我口之启，尔心之门。无为我兵，当为我藩。以慎为键，以忍为阍。可以多食，勿以多言。","book":"唐·刘禹锡《口兵戒》"},"similar":["以忍为阍"],"usage":"作谓语、定语；用于处事"},{"id":5497,"word":"以戈舂米","pinyin":"yǐ gē chōng mǐ","abbr":"ygcm","explanation":"戈：兵器；舂：捣米。拿戈去捣米。比喻使用工具不当，劳而无功。","source":{"text":"不道理宪，以《诗》、《书》为之，譬之犹以指测河也，以戈舂黍也，以锥飧壶也，不可以得之矣。","book":"《荀子·劝学》"}},{"id":5498,"word":"以戈舂黍","pinyin":"yǐ gē chōng shǔ","abbr":"ygcs","explanation":"用戈去舂黍米。比喻达不到目的。","source":{"text":"不道礼宪，以《诗》、《书》为之，譬之犹以指测河也，以戈舂黍也，以锥餐壶也，不可以得之矣。","book":"《荀子·劝学》"},"similar":["以指测河"],"usage":"作宾语、定语；用于比喻句"},{"id":5499,"word":"以战养战","pinyin":"yǐ zhàn yǎng zhàn","abbr":"yzyz","explanation":"利用战争中获取来的人力、物力和财力，继续进行战争。","source":{"text":"它将更厉害地进行其‘以华制华’的政治进攻和‘以战养战’的经济侵略。","book":"毛泽东《关于国际新形势对新华日报记者的谈话》"},"usage":"作宾语、定语；用于军事"},{"id":5500,"word":"以战去战","pinyin":"yǐ zhàn qù zhàn","abbr":"yzqz","explanation":"用战争消灭战争。","source":{"text":"故以战去战，虽战可也。","book":"《商君书·画策》"},"example":{"text":"～，盛王之道。","book":"《后汉书·耿秉传》"},"similar":["以杀去杀"],"usage":"作谓语、定语；指制止战争的方法"},{"id":5501,"word":"以战去战，以杀去杀","pinyin":"yǐ zhàn qù zhàn，yǐ shā qù shā","abbr":"yzqzysqs","explanation":"去：消除。用战争去消灭战争，用严峻的法律禁止人犯法。","source":{"text":"故以战去战，虽战可也；以杀去杀，虽杀可也；以刑去刑，虽重刑可也。","book":"《商君书·画策》"},"similar":["以战去战","以杀止杀"],"usage":"作宾语、定语；用于处事"},{"id":5502,"word":"以手加额","pinyin":"yǐ shǒu jiā é","abbr":"ysje","explanation":"把手放在额上。表示欢欣庆幸。","source":{"text":"斯言一出，十邑之民，以手加额，家传人诵。","book":"宋·杨万里《章贡道院记》"},"example":{"text":"国人见庄公母子同归，无不～，称庄公之孝。","book":"明·冯梦龙《东周列国志》第四回"},"similar":["额首相庆"],"usage":"作谓语；指人的神态"},{"id":5503,"word":"以手加颡","pinyin":"yǐ shǒu jiā sǎng","abbr":"ysjs","explanation":"加：搁、放；颡：额头。把手放在额上。表示欢欣庆幸。","source":{"text":"墀就敏中，厅问其事，皞益不挠。墀以手加额手皞，赏其孤直。","book":"唐·裴庭裕《东观奏记·上·懿安郭太后》"}},{"id":5504,"word":"以手叩额","pinyin":"yǐ shǒu kòu é","abbr":"yske","explanation":"把手放在额上。表示欢欣庆幸。","source":{"text":"墀就敏中，厅问其事，皞益不挠。墀以手加额手皞，赏其孤直。","book":"唐·裴庭裕《东观奏记·上·懿安郭太后》"}},{"id":5505,"word":"以指挠沸","pinyin":"yǐ zhǐ náo fèi","abbr":"yznf","explanation":"挠：搅；沸：开水。用手指搅动开水。比喻不自量力，一定失败。","source":{"text":"以桀诈尧，譬之若以卵投石，以指挠沸。","book":"《荀子·议兵》"},"example":{"text":"彼即不量其力，欲与我抗，譬之以卵投石，～，至则糜烂尔已，何能有幸哉。","book":"明·朱之瑜《中原阳九述略·灭虏之策》"},"similar":["以卵投石"],"usage":"作谓语、定语；指方法不对头"},{"id":5506,"word":"以指测河","pinyin":"yǐ zhǐ cè hé","abbr":"yzch","explanation":"用手指测量河水的深浅。比喻达不到目的。","source":{"text":"不道礼宪，以《诗》、《书》为之，譬之犹以指测河也，以戈舂黍也，以锥餐壶也，不可以得之矣。","book":"《荀子·劝学》"},"similar":["以戈舂黍","以锥餐壶"],"usage":"作宾语、定语；用于比喻句"},{"id":5507,"word":"以攻为守","pinyin":"yǐ gōng wéi shǒu","abbr":"ygws","explanation":"以进攻作为防御的手段。","source":{"text":"以攻为守，以守为攻，此兵之变也。","book":"宋·陈亮《酌古论一·先主》"},"example":{"text":"在这次足球比赛中，主队采取了～的战术。"},"similar":["以退为进","以屈求伸"],"opposite":["以守为攻"],"usage":"作谓语、状语、宾语；用于战斗、政治等"},{"id":5508,"word":"以敌借敌","pinyin":"yǐ dí jiè dí","abbr":"ydjd","explanation":"借：利用。用已分化出来的一部分敌人，去争取另一部分敌人。","source":{"text":"甚且以敌借敌，借敌之借，使敌不知而终为我借，使敌既知而不得不为我借，则借法巧也。","book":"明·揭喧《兵经百言》"}},{"id":5509,"word":"以文乱法","pinyin":"yǐ wén luàn fǎ","abbr":"ywlf","explanation":"文：指儒家的经典。引用儒家的经典，非议国家法令。","source":{"text":"儒以文乱法，侠以武犯禁。","book":"战国·韩·韩非《韩非子·五蠹》"},"example":{"text":"《五蠹篇》曰：‘儒～，侠以武犯禁。’","book":"章炳麟《诸子学略说》"},"usage":"作谓语、宾语；指读书人"},{"id":5510,"word":"以文会友","pinyin":"yǐ wén huì yǒu","abbr":"ywhy","explanation":"会：结交。指通过文字来结交朋友。","source":{"text":"君子以文会友，以友辅人。","book":"《论语·颜渊》"},"example":{"text":"君子讲学，～，有何不可？（元·柯丘丹《荆钗记·会讲》）"},"usage":"作谓语、宾语、补语；用于文人"},{"id":5511,"word":"以文害辞","pinyin":"yǐ wén hài cí","abbr":"ywhc","explanation":"指拘于文字而误解整个语句的意义。","source":{"text":"文，字也。辞，语也……言说《诗》之法，不可以一字而害一句之义，不可以一句而害设辞之志。","book":"《孟子·万章上》：“故说《诗》者，不以文害辞，不以辞害志。以意逆志，是为得之。”朱熹集注"},"example":{"text":"子美诗，备诸家体，非必率合程度，侃侃者然也。是篇落句处凡五杜鹃岂可～、辞害意耶？","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵二》"},"usage":"作谓语、定语；用于书面语"},{"id":5512,"word":"以日为岁","pinyin":"yǐ rì wéi suì","abbr":"yrws","explanation":"过一天象过一年那样长。形容日子很不好过。","source":{"text":"下风倾首，以日为年。","book":"北周·庾信《谢赵王示新诗启》"},"example":{"text":"望神之来，以日为岁，飚舆在望，亦既劳止。","book":"宋·张孝祥《迎嘉显孚济侯求雨文》"},"similar":["以日为年","度日如年"],"usage":"作谓语、定语、状语；用于处事"},{"id":5513,"word":"以日为年","pinyin":"yǐ rì wéi nián","abbr":"yrwn","explanation":"过一日如同过一年的时间那样漫长难熬。形容心情焦急。亦作“以日为岁”。","source":{"text":"下风倾首，以日为年。","book":"北周·庾信《谢赵王示新诗启》"},"example":{"text":"《周书·张轨传》：“高欢逆谋，已传行路。人情西望，～。”"},"similar":["度日如年","以日为岁"],"usage":"作谓语、定语、状语；用于处事"},{"id":5514,"word":"以日继夜","pinyin":"yǐ rì jì yè","abbr":"yrjy","explanation":"白天接着夜晚，日夜不停。","source":{"text":"灼家贫，抄义疏以日继夜，笔毫尽，每削用之。","book":"《陈书·郑灼传》"},"example":{"text":"兰芝姐姐：天已黄昏，所谓‘臣卜其昼，未卜其夜’请赐饭罢。妹子就用'黄昏'三字交卷，以记是日欢聚几至～之意。","book":"清·李汝珍《镜花缘》第九十二回"},"similar":["夜以接日"],"usage":"作谓语、状语；用于处事"},{"id":5515,"word":"以是为恨","pinyin":"yǐ shì wéi hèn","abbr":"yswh","explanation":"恨：遗憾。把这件事当作遗憾。","source":{"text":"不得永奉陛下，以是为恨。","book":"宋·王谠《唐语林·雅量》"},"usage":"作谓语；指把这件事当作遗憾"},{"id":5516,"word":"以昼卜夜","pinyin":"yǐ zhòu bǔ yè","abbr":"yzby","explanation":"卜：占卜。形容夜以继日地宴乐无度。","source":{"text":"臣卜其昼，未卜其夜，不敢。","book":"《左传·庄公二十二年》"}},{"id":5517,"word":"以暴易乱","pinyin":"yǐ bào yì luàn","abbr":"ybyl","explanation":"以：用；易：改变，更换；暴：残暴。用残暴势力代替残暴势力。指统治者换了，暴虐的统治没有改变。","source":{"text":"虽袁绍龚行，芟夷无余，然以暴易乱，亦何云及！","book":"《后汉书·宦者传》"},"example":{"text":"譬之负薪救火，扬汤止沸，～，与乱同道，莫可测也，后嗣何观！","book":"唐·吴兢《贞观政要·君道》"},"similar":["以暴易暴"],"usage":"作谓语、定语；指残暴统治"},{"id":5518,"word":"以暴易暴","pinyin":"yǐ bào yì bào","abbr":"ybyb","explanation":"以：用；易：改变，更换；暴：残暴。用残暴势力代替残暴势力。指统治者换了，暴虐的统治没有改变。","source":{"text":"登彼西山兮，采其薇矣，以暴易暴兮，不知其非矣。","book":"《史记·伯夷列传》"},"example":{"text":"吏转念去一狐，得一狐，是～也，游移不敢即应。","book":"清·蒲松龄《聊斋志异·周三》"},"similar":["以暴易乱"],"usage":"作谓语、定语；指残暴统治","story":["商朝末年，伯夷与叔齐都是孤竹国国君的儿子，孤竹君死后，两人互相推让都不愿为王，跑到周文王那里。文王死后，武王要出兵讨伐暴君商纣王，出发那天，伯夷与叔齐拉着武王的马劝他不要采取军事行动，认为“以暴易暴兮，不知其非矣！”"]},{"id":5519,"word":"以杀去杀","pinyin":"yǐ shā qù shā","abbr":"ysqs","explanation":"用严峻的法律禁止人犯法。","source":{"text":"以杀去杀，虽杀可也。","book":"《商君书·画策》"},"similar":["以暴制暴"],"usage":"作谓语、定语；指统治方法"},{"id":5520,"word":"以杀止杀","pinyin":"yǐ shā zhǐ shā","abbr":"yszs","explanation":"用严峻的法律禁止人犯法。","source":{"text":"故以战去战，虽战可也。以杀去杀，虽杀可也。","book":"《商君书·画策》"},"example":{"text":"盖闻～，圣人之不得已。以暴易暴，悍夫之无所成。","book":"明·刘基《拟连珠》"},"similar":["以战去战，以杀去杀"],"usage":"作宾语、定语；用于处事"},{"id":5521,"word":"以权谋私","pinyin":"yǐ quán móu sī","abbr":"yqms","explanation":"以：凭借；权：权力；谋：谋求；私：私利。用手中的权力牟取私利。","source":{"text":"有的党政机关设了许多公司，把国家拨的经费拿去做生意，以权谋私，化公为私。","book":"邓小平《一靠理想二靠纪律才能团结起来》"},"example":{"text":"要坚决打击～的犯罪分子。"},"similar":["贪赃枉法","营私舞弊","巧取豪夺"],"opposite":["一心为公","奉公守法","公而忘私"],"usage":"作谓语、定语、宾语；指为官者"},{"id":5522,"word":"以权达变","pinyin":"yǐ quán dá biàn","abbr":"yqdb","explanation":"用灵活的态度去适应变化发展的时势。","source":{"text":"不知时之所尚，势之所趋，终贵因事制宜，以权达变。","book":"清·王韬《变法自强》下"},"usage":"作谓语、定语；用于处事"},{"id":5523,"word":"以杙为楹","pinyin":"yǐ yì wéi yíng","abbr":"yywy","explanation":"杙：小木棍；楹：厅堂前部的柱子。把小木棍当作大柱子用。比喻误将小材作大用。","source":{"text":"是所谓诘匠氏之不以杙为楹，而訾医师以昌阳引年，欲进其豨苓也。","book":"唐·韩愈《进学解》"}},{"id":5524,"word":"以枢应环","pinyin":"yǐ shū yìng huán","abbr":"ysyh","explanation":"枢：门轴，引申为重要的部分；环：园形之物，这里比喻空虚。枢立环中，可以周转贯通。超脱是非，故能应付是非。也比喻配合自如。","source":{"text":"彼是莫得其偶，谓之道枢。枢始得其环中，以应无穷。","book":"《庄子·齐物论》"}},{"id":5525,"word":"以柔克刚","pinyin":"yǐ róu kè gāng","abbr":"yrkg","explanation":"用柔软的去克制刚强的。","source":{"text":"善将者，其刚不可折，其柔不可卷，故以弱制强，以柔制刚。","book":"三国·蜀·诸葛亮《将苑》"},"example":{"text":"他要拼老命，孤注一掷，我们则要忍耐，力避同敌人正面交锋，～，在敌人的后方狠狠地打。","book":"李连庆《风云急》"},"similar":["以屈求伸"],"opposite":["以暴制暴"],"usage":"作谓语、定语；指人的处世等"},{"id":5526,"word":"以柔制刚","pinyin":"yǐ róu zhì gāng","abbr":"yrzg","explanation":"以：用。柔：柔和。制：制服。刚：刚强。用柔和的办法去制服刚强的。","source":{"text":"善将者，其刚不可折，其柔不可卷，故以弱制强，以柔制刚。","book":"三国·蜀·诸葛亮《将苑·将刚》"},"example":{"text":"《清史稿·河渠志》：“专在固守高偃，实得全河关键，～，其法最善。”"},"similar":["以柔克刚"],"usage":"作谓语、定语；用于处事"},{"id":5527,"word":"以桃代李","pinyin":"yǐ táo dài lǐ","abbr":"ytdl","explanation":"比喻以自身去顶替别人。","source":{"text":"咳，且慢些笑他的失节，或者刘燕玉也是以桃代李的机关，亦未可定。","book":"《再生缘》第三二回"},"similar":["李代桃僵"],"usage":"作宾语、定语；用于比喻句"},{"id":5528,"word":"以正视听","pinyin":"yǐ zhèng shì tīng","abbr":"yzst","explanation":"为保证事实的正确理解。","example":{"text":"我们要坚决打击盗版好～。"},"opposite":["混淆视听"],"usage":"作谓语、定语；指纠正不良行为"},{"id":5529,"word":"以此类推","pinyin":"yǐ cǐ lèi tuī","abbr":"yclt","explanation":"根据这一事物的道理，去推出与此类似的其他事物的道理。","source":{"text":"宣和间，宗室围炉次，索炭，既至，诃斥左右云：‘炭色红，今黑，非是。’盖尝供熟火也。以此类推之，岂识世事艰难！","book":"宋·周煇《清波杂志》卷六"},"example":{"text":"先生不信，拣几个岛名试试他，果然记得，那真没法难他了。～，可见浅近的物理学，生理学等类，他都晓得。","book":"清·李宝嘉《文明小史》第二十五回"},"similar":["依此类推"],"usage":"作分句、状语；用于逻辑推理"},{"id":5530,"word":"以死济之","pinyin":"yǐ sǐ jì zhī","abbr":"ysjz","explanation":"不惜牺牲自己的生命来把某事干到底。比喻决心很大。","source":{"text":"臣竭股肱之力，加之以忠贞。其济，君之灵也。不济，则以死继之。","book":"《左传·僖公九年》"},"example":{"text":"炎公受省宪付托之重，更当～。","book":"清·章炳麟《电湘救赵》"},"similar":["以死继之"],"usage":"作谓语、定语；用于书面语"},{"id":5531,"word":"以死继之","pinyin":"yǐ sǐ jì zhī","abbr":"ysjz","explanation":"不惜牺牲自己的生命来把某事干到底。比喻决心很大。","source":{"text":"臣竭股肱之力，加之以忠贞。其济，君之灵也。不济，则以死继之。","book":"《左传·僖公九年》"},"example":{"text":"女笑曰：“痴婢能自主乎？”曰：“不济，则～。”","book":"清·蒲松龄《聊斋志异·青梅》"},"similar":["以死济之"],"usage":"作谓语、定语；用于书面语"},{"id":5532,"word":"以毁为罚","pinyin":"yǐ huǐ wéi fá","abbr":"yhwf","explanation":"根据人们的非毁给以惩罚。","source":{"text":"以毁誉为赏罚，则官自然失理。","book":"《管子·明法》：“是故官之失其治也，是主以誉为赏，以毁为罚也，然则喜赏恶罚之人离公道而行私术矣。”尹知章注"},"example":{"text":"以誉为赏，～也，则好赏恶罚之人，释公行，行私术，比周以相为也。","book":"《韩非子·有度》"},"usage":"作宾语、定语；用于书面语"},{"id":5533,"word":"以毒攻毒","pinyin":"yǐ dú gōng dú","abbr":"ydgd","explanation":"攻：治。中医用语，指用含有毒性的药物治疗毒疮等恶性病。比喻利用不良事物本身的矛盾来反对不良事物，或利用恶人来对付恶人。","source":{"text":"骨咄犀，蛇角也，其性至毒，而能解毒，盖以毒攻毒也。","book":"明·陶宗仪《辍耕录》卷二十九"},"example":{"text":"～，反而证明了反对白话者自己的不识字，不通文。","book":"鲁迅《且介亭杂文二集·从“别字”说开去》"},"similar":["针锋相对","以牙还牙","以眼还眼"],"opposite":["解衣推食","以沫相濡"],"usage":"作谓语、定语、宾语；指治病或对策"},{"id":5534,"word":"以毛相马","pinyin":"yǐ máo xiàng mǎ","abbr":"ymxm","explanation":"根据毛色判断马的优劣。比喻从表面上看问题，其所得认识往往与实际不符。","source":{"text":"故以言举人，若以毛相马，此其所以多不称举。","book":"汉·桓宽《盐铁论·利议》"},"usage":"作宾语、定语；用于处事"},{"id":5535,"word":"以水投水","pinyin":"yǐ shuǐ tóu shuǐ","abbr":"ysts","explanation":"把一条河里的水倒到另一条河里。比喻事物相似，很难辨别。","source":{"text":"白公问曰：‘若石水投水，何如？’孔子曰：‘吴之善没者能取之。’曰：‘若以水投水，何如？’孔子曰：‘淄渑之合，易牙尝而知之。’","book":"《列子·说符》"},"usage":"作谓语；指同类事物"},{"id":5536,"word":"以水投石","pinyin":"yǐ shuǐ tóu shí","abbr":"ysts","explanation":"比喻意见相左，不能为对方所接受。","source":{"text":"其言也。如以水投石，莫之受也。","book":"三国·魏·李康《运命论》"},"usage":"作宾语、定语；用于比喻句"},{"id":5537,"word":"以水救水","pinyin":"yǐ shuǐ jiù shuǐ","abbr":"ysjs","explanation":"引水来救水灾，水势越盛。比喻不仅不加以制止，相反更助长其势。","source":{"text":"是以火救火，以水救水，名之曰‘益多’。","book":"《庄子·人世间》"},"similar":["以火救火"],"usage":"作谓语、定语、宾语；指方法不对"},{"id":5538,"word":"以水洗水","pinyin":"yǐ shuǐ xǐ shuǐ","abbr":"ysxs","explanation":"用清水来清除清水。比喻采取的手段悖谬，必然于事无补。","source":{"text":"如鹦鹉学人语，话自语不得，为无智慧故，譬如将水洗水，将火烧火，都无义趣。","book":"宋·释道原《景德传灯录》卷二十六"},"example":{"text":"若谓水师不甚可靠，并有通盗者，以盗捕盗，直是～。","book":"清·张集馨《道咸宦海见闻录》"}},{"id":5539,"word":"以水洗血","pinyin":"yǐ shuǐ xǐ xuè","abbr":"ysxx","explanation":"指消除冤仇，以求和好。","source":{"text":"吾今以水洗血，不亦善乎！","book":"《旧唐书·源休传》"},"usage":"作宾语、定语；用于处事"},{"id":5540,"word":"以水济水","pinyin":"yǐ shuǐ jì shuǐ","abbr":"ysjs","explanation":"用水来给水增味。比喻随声附和，对事情没有好处。","source":{"text":"君所谓可，据亦曰可，君所谓否，据亦曰否。若以水济水，谁能食之？","book":"《左传·昭公二十年》"},"example":{"text":"有可而无否，其弊必至于～之喻。","book":"宋·杨万里《驳配向不当议》"},"usage":"作谓语、定语；指处理方法不对"},{"id":5541,"word":"以求一逞","pinyin":"yǐ qiú yī chěng","abbr":"yqyc","explanation":"逞：如愿，称心如意。指企图达到不正当的目的。","example":{"text":"敌人不甘心失败，～，颠覆社会主义政权。"},"usage":"作谓语、状语；指动机不纯"},{"id":5542,"word":"以汤止沸","pinyin":"yǐ tāng zhǐ fèi","abbr":"ytzf","explanation":"用开水去制止水的沸腾。比喻不从根本上着手，对事情没有帮助。","source":{"text":"夫以汤止沸，沸愈不止，去其火则止矣。","book":"战国·卫·吕不韦《吕氏春秋·尽数》"},"example":{"text":"如～，抱薪救火，愈甚之益也。","book":"东汉·班固《汉书·董仲舒传》"},"similar":["以火救火","以汤沃沸"],"usage":"作谓语、定语、宾语；指处理方式不对"},{"id":5543,"word":"以汤沃沸","pinyin":"yǐ tāng wò fèi","abbr":"ytwf","explanation":"汤：开水；沃：浇；沸：滚，开。拿开水去制止沸腾。比喻处理方法不对，不但不能制止，反而助长已成的气势。","source":{"text":"若以汤沃沸，乱乃逾甚。是故鞭噬狗，策蹄马，而欲教之，虽伊尹、造父弗能化。","book":"《淮南子·原道训》"},"similar":["以汤止沸","以火止沸"],"usage":"作谓语、定语、宾语；指处理方式不对"},{"id":5544,"word":"以汤沃雪","pinyin":"yǐ tāng wò xuě","abbr":"ytwx","explanation":"汤：开水；沃：浇。用开水浇雪。比喻效果明显。也比喻事情很容易做。","source":{"text":"若以水灭火，若以汤沃雪，何往而不遂，何之而不用？","book":"《淮南子·兵略训》"},"example":{"text":"何邓执权，必为玄害，亦犹排山压卵，～耳，奈何与之为亲。","book":"明·李贽《初潭集·夫妇二》"},"usage":"作谓语、定语；比喻事情很容易做"},{"id":5545,"word":"以沫相濡","pinyin":"yǐ mò xiāng rú","abbr":"ymxr","explanation":"沫：唾沫；濡：沾湿，湿润。泉水干了，鱼吐沫互相润湿。比喻一同在困难的处境里，用微薄的力量互相帮助。","source":{"text":"泉涸，鱼相与处于陆，相呴以湿，相濡以沫。","book":"战国·宋·庄周《庄子·大宗师》"},"example":{"text":"十年携手共艰危，～亦可哀。","book":"鲁迅《题三集赠许广平》诗"},"similar":["相濡以沫","濡沫涸辙","同舟共济"],"usage":"作主语、谓语、宾语；指共同患难"},{"id":5546,"word":"以法为教","pinyin":"yǐ fǎ wéi jiào","abbr":"yfwj","explanation":"以：用；教：教育。引用法律条文充当教育的内容。","source":{"text":"故明主之国，无书简之文，以法为教。","book":"《韩非子·五蠹》"},"usage":"作宾语、定语；用于处事"},{"id":5547,"word":"以泪洗面","pinyin":"yǐ lèi xǐ miàn","abbr":"ylxm","explanation":"拿眼泪来洗脸。形容极度忧伤悲痛，终日流泪。","source":{"text":"又韩玉汝家有李国主归朝后与金陵旧宫人书云：‘此中日夕，只以眼泪洗面。’","book":"宋·王铚《默记》卷下"},"example":{"text":"本来是个女流，没甚能力，此时更如坐针毡，自料母子难保，惟～罢了。","book":"蔡东藩《五代史演义》第三回"}},{"id":5548,"word":"以泽量尸","pinyin":"yǐ zé liáng shī","abbr":"yzls","explanation":"指尸体遍野，可以沼泽为单位计量。极言死人之多。","source":{"text":"四入郊圻躏齐鲁，破邑屠城不可数，刳腹绝肠，折颈折颐，以泽量尸。","book":"清·顾炎武《羌胡引》"},"usage":"作谓语、定语；用于书面语"},{"id":5549,"word":"以渴服马","pinyin":"yǐ kě fú mǎ","abbr":"ykfm","explanation":"使马忍渴受训，从人驱遣。比喻用苛政治民，不能使人真心顺服。","source":{"text":"造父为齐王驸驾，以渴服马，百日而服成……王曰：‘效驾于圃驾于圃中。’造父驱车入圃，马见圃池而走，造父不能禁。造父以渴服马久矣，今马见池，馯而走，虽造父不能治……","book":"《韩非子·外储说右下》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":5550,"word":"以溺自照","pinyin":"yǐ nì zì zhào","abbr":"ynzz","explanation":"溺：尿。撒泡尿自己好好照一下。比喻让他人自我检点，看够不够格。多含讥讽之意。","source":{"text":"何不以溺自照面，看做得三路运使无？","book":"宋·程颢、程颐《大全集拾遗》"},"example":{"text":"此等语何不～。又俞仲蔚古调本是名家，五言律亦不恶，沾沾为七言律不已，何也？","book":"明·王世贞《艺苑卮言》卷七"}},{"id":5551,"word":"以火去蛾","pinyin":"yǐ huǒ qù é","abbr":"yhqe","explanation":"娥喜投火，用火驱赶飞蛾，蛾越多。比喻行为和目的自相矛盾，只能得到相反的结果。","source":{"text":"以火去蛾蛾愈多，以鱼殴蝇蝇愈至。","book":"《太平御史》卷九四四引《韩子》"},"similar":["以骨去蚁"],"usage":"作宾语、定语；用于比喻句"},{"id":5552,"word":"以火救火","pinyin":"yǐ huǒ jiù huǒ","abbr":"yhjh","explanation":"用火来救火灾。比喻工作方法不对头，不但无益，反而有害。","source":{"text":"是以火救火，以水救水，名之曰益多。","book":"《庄子·人世间》"},"example":{"text":"《纲鉴会纂》第12卷：“～，益增其酷，奚取社稷臣为哉！”"},"similar":["负薪救火"],"usage":"作谓语、定语；指做法不对头"},{"id":5553,"word":"以火救火，以水救水","pinyin":"yǐ huǒ jiù huǒ，yǐ shuǐ jiù shuǐ","abbr":"yhjhysjs","explanation":"用火来救火灾，用水来救水灾。比喻工作方法不对头，不但不能制止，反而助长其势","source":{"text":"是以火救火，以水救水，名之曰益多。","book":"战国·宋·庄周《庄子·人间世》"},"similar":["以火救火","以水救水"],"usage":"作宾语、定语；指做法不对头"},{"id":5554,"word":"以火止沸","pinyin":"yǐ huǒ zhǐ fèi","abbr":"yhzf","explanation":"比喻处理方法不对，不但不能制止，反而助长已成的气势。同“以汤止沸”。","source":{"text":"汉初乘弊而不改易，畜利变币，欲以反本，是犹以煎止燔，以火止沸也。","book":"汉·桓宽《盐铁论·错币》"},"similar":["以汤止沸","以汤沃沸"],"usage":"作谓语、定语、宾语；指处理方式不对"},{"id":5555,"word":"以点带面","pinyin":"yǐ diǎn dài miàn","abbr":"yddm","explanation":"用一个单位或地方的成功经验来带动许多单位或成片地区的工作。","source":{"text":"考虑全面布局，因此是点面结合，以点带面。","book":"竺可桢《一年来的综合考察》"},"example":{"text":"当领导必须坚持点面结合，善于～。"},"usage":"作谓语、宾语；指以小带多"},{"id":5556,"word":"以煎止燔","pinyin":"yǐ jiān zhǐ fán","abbr":"yjzf","explanation":"用加热来制止燃烧。比喻处理方法不对，反而助长已成之势。","source":{"text":"汉初乘弊而不改易，畜利变币，欲以反本，是犹以煎止燔，以火止沸也。","book":"汉·桓宽《盐铁论·错币》"},"similar":["以火止沸"],"usage":"作谓语、定语、宾语；指处理方式不对"},{"id":5557,"word":"以牙还牙","pinyin":"yǐ yá huán yá","abbr":"yyhy","explanation":"用牙咬来对付牙咬。比喻针锋相对地进行回击。","source":{"text":"以眼还眼，以牙还牙，以手还手，以脚还脚。","book":"《旧约全书·申命记》"},"example":{"text":"‘犯而不校’是恕道，‘以眼还眼，～’是直道。","book":"鲁迅《坟·论“费厄泼赖”应该缓行》"},"similar":["针锋相对"],"opposite":["退避三舍"],"usage":"作谓语、定语、状语；常与“以眼还眼”连用"},{"id":5558,"word":"以狸至鼠","pinyin":"yǐ lí zhì shǔ","abbr":"ylzs","explanation":"比喻事情不能成功。同“以狸饵鼠”。"},{"id":5559,"word":"以狸致鼠","pinyin":"yǐ lǐ zhì shǔ","abbr":"ylzs","explanation":"狸：猫。捉老鼠用猫作诱饵。比喻事情不能成功。","source":{"text":"以狸致鼠，以冰致绳，虽工不能。","book":"《吕氏春秋·功名》"},"similar":["以狸饵鼠"],"usage":"作谓语、定语；比喻事情不能成功"},{"id":5560,"word":"以狸致鼠，以冰致绳","pinyin":"yǐ lí zhì shǔ，yǐ bīng zhì shéng","abbr":"ylzsybzs","explanation":"用猫招引老鼠，用冰作绳索。比喻事情不能成功。","source":{"text":"以狸致鼠、以冰致绳，虽工不能。","book":"《吕氏春秋·功名》"}},{"id":5561,"word":"以狸饵鼠","pinyin":"yǐ lǐ ěr shǔ","abbr":"yles","explanation":"狸：猫；饵：诱。捉老鼠用猫作诱饵。比喻事情不能成功。","source":{"text":"我不以货事上而求迁者，则如以狸饵鼠尔，必不冀矣。","book":"《商君书·农战》"},"similar":["以狸致鼠"],"usage":"作谓语、定语；比喻事情不能成功"},{"id":5562,"word":"以玉抵乌","pinyin":"yǐ yù dǐ wū","abbr":"yydw","explanation":"比喻有珍贵之物而不知爱重。同“以玉抵鹊”。","source":{"text":"昆山之下，以玉抵乌；彭蠡之滨，以鱼食犬，而人不爱者，非性轻财，所丰故也。","book":"北齐·刘昼《新论·辩施》"},"example":{"text":"北齐·刘昼《新论·辩施》：“昆山之下，～；彭蠡之滨，以鱼食犬，而人不爱者，非性轻财，所丰故也。”"},"similar":["以玉抵鹊"],"usage":"作谓语、定语；用于比喻句"},{"id":5563,"word":"以玉抵鹊","pinyin":"yǐ yù dǐ què","abbr":"yydq","explanation":"抵，抛掷。比喻有珍贵之物而不知爱重。","source":{"text":"南越以孔雀珥门户，昆山之旁以玉璞抵乌鹊。","book":"汉·桓宽《盐铁论·崇礼》"},"example":{"text":"少时叶子九来以近刻诗见贻，开卷见得下叙，读之而叹。斯所谓昆山之人，～者也？","book":"清·钱谦益《叶九来锄经堂诗序》"},"similar":["以玉抵乌"],"usage":"作谓语、定语；用于比喻句"},{"id":5564,"word":"以珠弹雀","pinyin":"yǐ zhū tán què","abbr":"yztq","explanation":"用珍珠弹麻雀。比喻轻重颠倒，得不偿失。","source":{"text":"今且有人于此，以隋侯之珠弹千仞之雀，世必笑之，是何也？则其所用者重，而所要者轻也。","book":"《庄子·让王》"},"example":{"text":"盖人当困心衡虑之既极，往往不惜倒行逆施，～。","book":"清·梁启超《中国外交方针私议》"},"similar":["得不偿失"],"usage":"作谓语、定语；指方法不对","story":["鲁哀公听说颜阖非常贤明，就派人给他送礼物请他出山。贫穷的颜阖不受。庄子就此事发表感慨，颜阖无意于富贵，富资送上门，他不欢迎。这样的人难得。而那些不惜牺牲生命去追求富贵就如同“以隋侯之珠，弹千仞之雀”一样不值得"]},{"id":5565,"word":"以理服人","pinyin":"yǐ lǐ fú rén","abbr":"ylfr","explanation":"用道理来说服人。","source":{"text":"以力服人者，非心服也，力不赡也；以德服人者，中心悦而诚服也，如七十子之服孔子也。","book":"战国·邹·孟轲《孟子·公孙丑上》"},"example":{"text":"对于错误的意见，不能压服，而是说服，～。","book":"毛泽东《在中国共产党全国宣传工作会议上的讲话》"},"similar":["心服口服","心悦诚服","言之有理"],"opposite":["以势压人","仗势欺人","以力服人"],"usage":"作谓语、宾语、状语；指讲道理","story":["战国时期，孟子到各地去游说他的仁道，有人说靠武力照样可以称霸，根本用不上讲仁道。孟子说：“靠武力称霸必须要以国富民强为基础，是武力压服而非心悦诚服，而以仁道称霸，以理服人，则可以让人心悦诚服，使国力强大。”"]},{"id":5566,"word":"以疏间亲","pinyin":"yǐ shū jiàn qīn","abbr":"ysjq","explanation":"指关系疏远的人离间关系亲近的人。","source":{"text":"齐东郭偃、棠无咎专崔氏之政，而侮崔成、崔彊，是疏远而间亲戚也。","book":"春秋·鲁·左丘明《左传·隐公三年》：“远间亲”唐·孔颖达疏"},"example":{"text":"不是我说句～的话，令伯这种行径，不定是有意回避你的了。","book":"清·吴趼人《二十年目睹之怪现状》第四回"},"usage":"作谓语、定语；指离间别人"},{"id":5567,"word":"以疑决疑","pinyin":"yǐ yí jué yí","abbr":"yyjy","explanation":"用疑惑的认识来判断捉摸不定的事物。","source":{"text":"彼愚者之定物，以疑决疑，决必不当。夫苟不当，安能无过乎！","book":"《荀子·解蔽》"},"usage":"作谓语、定语；用于愚昧的人"},{"id":5568,"word":"以疾掩迟","pinyin":"yǐ jí yǎn chí","abbr":"yjyc","explanation":"疾：急速，猛烈；迟：迟缓；掩：乘人不备而进袭。用快速的行动方式去袭击动作迟缓的敌方。","source":{"text":"当以生击死，以盛乘衰，以疾掩迟，以饱制饥。","book":"《淮南子·兵略训》"},"example":{"text":"善战者，必以胜而乘衰，以实而击虚，以疾而掩迟，以饱而制饥。","book":"明·何良臣《阵记》卷三"}},{"id":5569,"word":"以白为黑","pinyin":"yǐ bái wéi hēi","abbr":"ybwh","explanation":"指颠倒是非。","source":{"text":"故君虽尊，以白为黑，臣不能听。","book":"《吕氏春秋·应同》"},"example":{"text":"王凤擅权，谷永比之申伯；王商忠议，张匡谓之左道：此皆～，欺天罔君者也。","book":"《三国志·魏志·武帝纪》"},"similar":["颠倒黑白","以黑为白","指鹿为马"],"opposite":["泾渭分明"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5570,"word":"以白诋青","pinyin":"yǐ bái dǐ qīng","abbr":"ybdq","explanation":"以白色诋毁青色。比喻用自以为是的偏见去否定别人。","source":{"text":"宁藏拙而不为则可，若护其所短，而反讥人之所长，则不可。所谓以宫笑角，以白诋青者，谓之陋儒。","book":"清·袁枚《随园诗话》卷五"},"usage":"作谓语、宾语；用于书面语"},{"id":5571,"word":"以盲辨色","pinyin":"yǐ máng biàn sè","abbr":"ymbs","explanation":"让盲人去分辨颜色。比喻缺乏必要条件，事情无法弄清楚。","source":{"text":"不是师法，而好自用，譬之是犹以盲辨色，以聋辨声也，舍乱妄无为也。","book":"《荀子·修身》"},"similar":["以聋辨声"],"usage":"作宾语、定语；用于处事"},{"id":5572,"word":"以直报怨","pinyin":"yǐ zhí bào yuàn","abbr":"yzby","explanation":"直：公正、正直。以公道对待自己怨恨的人。","source":{"text":"以直报怨，以德报德。","book":"《论语·宪问》"},"example":{"text":"这叫做～，以德报德。","book":"明·冯梦龙《警世通言》卷十一"},"similar":["以德报怨","以礼相待"],"opposite":["忘恩负义"],"usage":"作谓语、宾语；指对人的态度"},{"id":5573,"word":"以直报怨，以德报德","pinyin":"yǐ zhí bào yuàn，yǐ dé bào dé","abbr":"yzbyydbd","explanation":"直：公正、正直。以公道的态度对待自己怨恨的人，把恩惠施与对自己有恩的人。","source":{"text":"或曰：‘以德报怨，何如？’子曰：‘何以报德？以直报怨，以德报德。","book":"《论语·宪问》"},"example":{"text":"明·冯梦龙《警世通言》第11卷：“超度苏二爷，朱婆及苏胜夫妇亡灵，这叫做～。”"},"similar":["以直报怨","以德报德"],"usage":"作谓语、宾语、定语；指对人的态度"},{"id":5574,"word":"以直抱怨","pinyin":"yǐ zhí bào yuàn","abbr":"yzby","explanation":"别人对自己有仇怨，自己以大公无私的态度对待之。","example":{"text":"他与同事相处，一向抱着～的宗旨，因此往往能化敌为友，融洽共处。"}},{"id":5575,"word":"以眦睚杀人","pinyin":"yǐ zì yá shā rén","abbr":"yzysr","explanation":"眦：眼眶；睚：眼边；睚眦：瞪眼睛发怒，指极小的仇恨。因为小小的事杀了人。","source":{"text":"程一日果以眦睚杀人，上大怒，立命斥出。","book":"宋·王谠《唐语林·雅量》"},"usage":"作谓语、定语；用于处事"},{"id":5576,"word":"以眼还眼","pinyin":"yǐ yǎn huán yǎn","abbr":"yyhy","explanation":"用瞪眼回击瞪眼。比喻用对方使用的手段来回击对方。","source":{"text":"以眼还眼，以牙还牙，以手还手，以脚还脚。","book":"《旧约全书·申命记》"},"example":{"text":"我们～，以牙还牙！敌人用大炮来轰我们，我们也用大炮去回答他们。","book":"张天翼《新生》"},"similar":["以毒攻毒","以牙还牙","以暴易暴"],"opposite":["以德报怨","以直报怨"],"usage":"作谓语、宾语、分句；常与“以牙还牙”连用"},{"id":5577,"word":"以眼还眼，以牙还牙","pinyin":"yǐ yǎn huán yǎn，yǐ yá huá yá","abbr":"yyhyyyhy","explanation":"用瞪眼回击瞪眼，用牙齿咬人对付牙齿咬人。指对方使用什么手段，就用什么手段进行回击。","source":{"text":"以眼还眼，以牙还牙，以手还手，以脚还脚。","book":"《旧约全书·申命记》"},"example":{"text":"“～”，这样“还”下去是没有了局的。","book":"叶圣陶《英文教授》"},"similar":["针锋相对"],"opposite":["退避三舍"],"usage":"作谓语、分句；指针锋相对"},{"id":5578,"word":"以瞽引瞽","pinyin":"yǐ gǔ yǐn gǔ","abbr":"ygyg","explanation":"让盲人给盲人引路。比喻让愚昧无知的人去引导愚昧无知的人，只能使其更加迷惑。","source":{"text":"怪人佛老之徒出，自中魔计，以瞽引瞽，讹人以不可知之事，以售己诈……兼之魔鬼入心，遂造出无数怪诞邪说，迷惑害累世人。","book":"太平天国·洪秀全《原道觉世训》"},"example":{"text":"迨至妖胡窃天国，～害愈深。","book":"中国近台史资料丛刊《太平天国·醒世文》"},"usage":"作宾语、定语；用于比喻句"},{"id":5579,"word":"以石投卵","pinyin":"yǐ shí tóu luǎn","abbr":"ystl","explanation":"用石头去砸鸡蛋。比喻以强攻弱，必胜无疑。","source":{"text":"今之进讨，若以石投卵耳。","book":"《孙子·势篇》：“兵之所加，如以碫投卵者，虚实是也。《晋书·温峤传》"},"similar":["以碫投卵"],"opposite":["以卵击石"],"usage":"作谓语、宾语、定语；指必胜"},{"id":5580,"word":"以石投水","pinyin":"yǐ shí tóu shuǐ","abbr":"ysts","explanation":"象石头投入水里就沉没一样。原比喻想消灭形迹而终不能。后比喻互相合得来。","source":{"text":"及其遭汉祖，其言也，如以石投水，莫之逆也。","book":"《列子·说符》：“白公问曰：‘若以石投水，何如？’孔子曰：‘吴之善没者能取之。’”三国·魏·李萧远《运命论》"},"example":{"text":"如此之人，有前代之资，～，无所比之也。","book":"宋·张君房《云笈七签》卷五十九"},"usage":"作谓语、定语；用于书面语"},{"id":5581,"word":"以碫投卵","pinyin":"yǐ duàn tóu luǎn","abbr":"ydtl","explanation":"碫：磨刀石。用磨刀石去砸蛋。比喻以强攻弱，必胜无疑。","source":{"text":"《孙子·势篇》：“兵之所加，如以碫投卵者，虚实是也。"},"similar":["以长攻短"],"opposite":["以卵投石"],"usage":"作谓语、宾语、定语；指必胜"},{"id":5582,"word":"以磛投卵","pinyin":"yǐ duàn tóu luǎn","abbr":"ydtl","explanation":"磛磨刀石。用磨刀石去砸蛋。比喻以强攻弱，必胜无疑。","source":{"text":"兵之所加，如以磛投卵者，虚实是也。","book":"《孙子·势篇》"}},{"id":5583,"word":"以礼悔祸","pinyin":"yǐ lǐ huǐ huò","abbr":"ylhh","explanation":"悔祸：追悔所造成的祸害。以礼待人，追悔过去给他人造成的祸害。","source":{"text":"若寡人得没于地，天其以礼悔祸于许？无宁兹许公复奉其社稷。","book":"《左传·隐公十一年》"}},{"id":5584,"word":"以礼相待","pinyin":"yǐ lǐ xiāng dài","abbr":"ylxd","explanation":"用应有的礼节接待。","source":{"text":"赵枢密留住禇坚，以礼相待。","book":"明·施耐庵《水浒全传》第八十九回"},"example":{"text":"他既是读书之人，须要～。","book":"清·石玉昆《三侠五义》第七十三回"},"similar":["礼尚往来"],"opposite":["趾高气扬","盛气凌人","目中无人"],"usage":"作谓语、定语；指人有礼貌"},{"id":5585,"word":"以私害公","pinyin":"yǐ sī hài gōng","abbr":"yshg","explanation":"指因私情而损害公道或公德。","source":{"text":"楚白公之难，有庄之善者，辞其母，将死君……比至朝，三废车中。其仆曰：‘子惧，何不反也？’曰：‘惧，吾私也；死君，吾公也。吾闻君子不以私害公。’遂往死之。","book":"《韩诗外传》卷一"},"example":{"text":"义重而恩轻，则不～。","book":"宋·秦观《白敏中论》"},"similar":["以私废公"],"usage":"作谓语、定语；用于处事","story":["楚白公在危难中，庄之善辞别母亲准备去代替楚白公去死，快要到朝廷上，庄三次不敢下车，身边人问他如果害怕就可以回去。庄说：“害怕是我的私事，为君主去死是公事，君子是不会以私害公的。”于是毫不犹豫去替死"]},{"id":5586,"word":"以私废公","pinyin":"yǐ sī fèi gōng","abbr":"ysfg","explanation":"由于私情而废弃公务。","source":{"text":"晃回顾众将，厉声大叫曰：‘若取得云长首级者，重赏千金！’公惊曰：‘公明何出此言？’晃曰：‘今日乃国家之事，某不敢以私废公。’言讫，挥大斧直取关公。","book":"明·罗贯中《三国演义》第七十六回"},"similar":["以私害公"],"usage":"作谓语、定语；用于处事"},{"id":5587,"word":"以筌为鱼","pinyin":"yǐ quán wéi yú","abbr":"yqwy","explanation":"筌：捕鱼的竹器。把捕鱼工具看作是鱼。比喻满足对事物表面肤浅认识，不去更深入了解事物本质。","source":{"text":"不再想去见识经典，那就是以筌为鱼，未免辜负编撰者的本心了。","book":"朱自清《经典常谈》序"},"example":{"text":"不再去想见识经典，那就是～，未免孤负编撰者的本心了。","book":"朱自清《经典常谈·序》"},"usage":"作宾语、定语；用于比喻句"},{"id":5588,"word":"以筦窥天","pinyin":"yǐ guǎn kuī tiān","abbr":"ygkt","explanation":"筦，同“管”。比喻同闻狭隘或看事片面。见“以管窥天”。"},{"id":5589,"word":"以简御繁","pinyin":"yǐ jiǎn yù fán","abbr":"yjyf","explanation":"御：治理，统治。以简便的办法去对付复杂繁多的事情。","source":{"text":"复出为山阴令，民户三万，政事烦扰，讼诉殷积，阶庭常数百人，秉之御繁以简，常得无事。","book":"南朝·梁·沈约《宋书·江秉之传》"},"usage":"作谓语、定语；用于处事"},{"id":5590,"word":"以简驭繁","pinyin":"yǐ jiǎn yù fán","abbr":"yjyf","explanation":"用简捷了当的方法来处理复杂纷繁的事物。","source":{"text":"复出为山阴令，民户三万，政事烦扰，讼诉殷积，阶庭常数百人，秉之御繁以简，常得无事。","book":"南朝·梁·沈约《宋书·江秉之传》"}},{"id":5591,"word":"以管窥天","pinyin":"yǐ guǎn kuī tiān","abbr":"ygkt","explanation":"管：竹管；窥：从小孔或缝隙里看。通过竹管子的孔看天。比喻见闻狭隘或看事片面。","source":{"text":"是直用管窥天，用锥指地也，不亦小乎？","book":"战国·宋·庄周《庄子·秋水》"},"example":{"text":"夫子之为方也，若～。以郄视文。","book":"汉·司马迁《史记·扁鹊仓公列传》"},"similar":["坐井观天"],"usage":"作谓语、定语、宾语；指片面看问题","story":["春秋时期齐国神医扁鹊经过虢国听说虢太子猝死，就问中庶子太子的症状，认为虢太子只是假死可以救活。中庶子不信，扁鹊认为他是以管窥天孤陋寡闻，就在太子的穴位上扎针，太子就苏醒过来，再经汤药调解，20天后就完全康复"]},{"id":5592,"word":"以管窥天，以蠡测海","pinyin":"yǐ guǎn kuī tiān，yǐ lǐ cè hǎi","abbr":"ygktylch","explanation":"管：竹管；窥：从小孔或缝隙里看；蠡：贝壳做的瓢。通过竹管子的孔看天，用瓢来量海。比喻见闻狭隘或看事片面。","source":{"text":"以管窥天，以蠡测海，以莛撞钟。岂能通其条贯，考其文理，发其声音哉！","book":"汉·东方朔《答客难》"},"example":{"text":"然则王蕃所传，盖～之义也。","book":"《旧唐书·天文志》"}},{"id":5593,"word":"以管窥豹","pinyin":"yǐ guǎn kuī bào","abbr":"ygkb","explanation":"用竹管看豹，只能见其身上的一斑。比喻目光狭隘，见识短浅。","source":{"text":"此郎亦管中窥豹，时见一斑。","book":"语出南朝·宋·刘义庆《世说新语·方正》"},"example":{"text":"至于杨修小儿，目光不离其鼻，～，更不足以知此。","book":"徐懋庸《鸡肋》"},"similar":["管中窥豹"],"usage":"作谓语、定语、状语；指片面看问题"},{"id":5594,"word":"以类相从","pinyin":"yǐ lèi xiāng cóng","abbr":"ylxc","explanation":"指按其类别各相归属。","source":{"text":"故象刑殆非生于治古，并起于乱今也。治古不然，凡爵列、官职、赏庆、刑罚皆报也，以类相从者也。","book":"《荀子·正论》"},"example":{"text":"又分造词赋，～，或称大山，或称小山，其义犹《诗》之有《大雅》《小雅》也。","book":"鲁迅《汉文学史纲要》第八篇"},"usage":"作宾语、定语；用于书面语"},{"id":5595,"word":"以索续组","pinyin":"yǐ suǒ xù zǔ","abbr":"ysxz","explanation":"用粗绳去连接丝带。比喻后继者的才学远逊前人。","source":{"text":"贤君见抑，而贼臣是党，求诸旧例，理独有违。但此是绝笔获麟之后，弟子追书其事。岂由以索续组，不类将圣之能者乎？何其乖剌之甚也！","book":"唐·刘知幾《史通·杂说上》"},"similar":["狗尾续貂"],"usage":"作宾语、定语；用于书面语"},{"id":5596,"word":"以紫为朱","pinyin":"yǐ zǐ wéi zhū","abbr":"yzwz","explanation":"比喻将奸邪小人当作廉洁公正的贤者。同“以紫乱朱”。","source":{"text":"俾好作恶，以紫为朱。","book":"明·刘基《官箴中》"},"similar":["以紫乱朱"],"usage":"作谓语、定语；用于坏人"},{"id":5597,"word":"以紫乱朱","pinyin":"yǐ zǐ luàn zhū","abbr":"yzlz","explanation":"比喻将奸佞小人当作廉洁公正的君子。","source":{"text":"子曰：‘恶紫之夺朱也，恶郑声之乱雅乐也，恶利口之覆邦家者。’","book":"春秋·鲁·孔丘《论语·阳货》"},"example":{"text":"俾好作恶，～。","book":"明·刘基《官箴中》"},"similar":["善恶不分","以紫为朱"],"usage":"作谓语、定语；用于坏人"},{"id":5598,"word":"以约驭博","pinyin":"yǐ yuē yù bó","abbr":"yyyb","explanation":"约：简要；驭：驾驭；博：广博。用简要的去统帅广博的。","source":{"text":"博学而详说之，将以反说约也。","book":"《孟子·离娄下》"}},{"id":5599,"word":"以终天年","pinyin":"yǐ zhōng tiān nián","abbr":"yztn","explanation":"以：表示目的。终：结束，完了。天年：指人的自然的年寿。指养老送终。","source":{"text":"师父只在此间过了，小弟奉养你母子二人，以终天年，多少是好！","book":"明·施耐庵《水浒传》第二回"},"usage":"作谓语、定语；用于书面语"},{"id":5600,"word":"以绝后患","pinyin":"yǐ jué hòu huàn","abbr":"yjhh","explanation":"消除祸根，来杜绝以后可能产生的祸患。","source":{"text":"如今朦胧奏过圣人，将他两个押赴市曹杀坏了，以绝后患。","book":"元·无名氏《谢金吾》第三折"},"usage":"作谓语、定语；用于处事"},{"id":5601,"word":"以羊易牛","pinyin":"yǐ yáng yì niú","abbr":"yyyn","explanation":"易：更换。用羊来替换牛。比喻用这个代替另一个。","source":{"text":"王坐于堂上，有牵牛而过堂下者。……曰：‘何可废也，以羊易之。’","book":"《孟子·梁惠王上》"},"example":{"text":"东床已招佳选，何知～；西邻纵有责言，终难指鹿为马。","book":"明·冯梦龙《醒世恒言》卷七"},"usage":"作谓语、宾语；指相互替换","story":["战国时期，孟子与齐宣王谈论治国之道，齐宣王问孟子国君要有怎样的仁德才能统治天下呢？孟子说要爱护人民才能天下无敌，于是孟子讲他听大臣说齐宣王以羊易牛去涂新钟的故事，认为齐宣王有慈悲心，足以统治天下了"]},{"id":5602,"word":"以羽扣钟","pinyin":"yǐ yǔ kòu zhōng","abbr":"yykz","explanation":"用羽毛敲钟。比喻才疏学浅却不自量力地做根本办不到的事情。也比喻拿浅显的东西向学识渊博的人请教，","source":{"text":"臣以意欲造君命者，干君之乱臣；子以意欲造父命者，胁父之逆子。至于天而徒怀干胁之情，犹以羽扣钟，以指移山，求其济也，必不可得已。","book":"清·王夫之《姜斋文集·君相可以造命论》"}},{"id":5603,"word":"以老卖老","pinyin":"yǐ lǎo mài lǎo","abbr":"ylml","explanation":"凭着自己年纪老，有意卖弄自己的老成","source":{"text":"张：（遇见了爷爷辈的这般以老卖老的同事，只好顺嘴胡溜，嘻嘻地）是啊是啊，陈奶奶。","book":"曹禺《北京人》第一幕"},"similar":["倚老卖老"],"usage":"作谓语、定语；用于处事"},{"id":5604,"word":"以耳为目","pinyin":"yǐ ěr wéi mù","abbr":"yewm","explanation":"拿听到的当作亲眼目睹的。比喻不亲自了解情况，只听信别人说的。","source":{"text":"但是如今的那班督抚，也都是些以耳为目、不分黑白的人。","book":"清·张春帆《九尾龟》第一百七十回"},"example":{"text":"据我那小东人说得来十三妹姑娘怎的个孝义，怎的个英雄，我那老东人～，便轻信了这话。","book":"清·文康《儿女英雄传》第十七回"},"similar":["以耳代目"],"usage":"作谓语、定语、宾语；指不去实践"},{"id":5605,"word":"以耳代目","pinyin":"yǐ ěr dài mù","abbr":"yedm","explanation":"以：用；代：代替。拿眼睛当耳朵。指不亲自去调查了解，光听信别人说的。","source":{"text":"这种以耳代目的情况是令人吃惊的，但这种情况却并不是罕见的。","book":"臧克家《以耳代目之类》"},"example":{"text":"～的做法不可取。"},"similar":["以耳为目"],"usage":"作谓语、定语；指不去实践"},{"id":5606,"word":"以聋辨声","pinyin":"yǐ lóng biàn shēng","abbr":"ylbs","explanation":"让聋子分辨声音。比喻缺乏必要条件，事情无法弄清楚。","source":{"text":"不是师法，而好自用，譬之是犹以盲辨色，以聋辨声也，舍乱妄无为也。","book":"《荀子·修身》"},"similar":["以盲辨色"],"usage":"作宾语、定语；用于处事"},{"id":5607,"word":"以肉去蚁","pinyin":"yǐ ròu qù yǐ","abbr":"yrqy","explanation":"用肉驱赶蚂蚁，蚂蚁越多。比喻行为和目的自相矛盾，只能得到相反的结果。","source":{"text":"以肉去蚁，蚁愈多；以鱼驱蝇，蝇愈至。","book":"《韩非子·外储说左下》"},"similar":["以骨去蚁"],"usage":"作宾语、定语；用于比喻句"},{"id":5608,"word":"以肉啖虎","pinyin":"yǐ ròu dàn hǔ","abbr":"yrdh","explanation":"比喻白白地送死。同“以肉喂虎”。","source":{"text":"以揽权要秦王，正如以肉啖虎耳。","book":"明·李贽《史纲评要·周纪·赧王》"},"similar":["以肉餧虎","以肉喂虎"],"usage":"作宾语、定语；用于比喻句"},{"id":5609,"word":"以肉喂虎","pinyin":"yǐ ròu wèi hǔ","abbr":"yrwh","explanation":"比喻白白地送死。","source":{"text":"今赴秦军，如以肉喂虎，当何益也！","book":"汉·荀悦《汉纪·高祖纪一》"},"example":{"text":"时当（邓当）职吏以蒙年小轻之，曰：‘彼竖子何能为？此欲～耳！’","book":"《三国志·吴志·吕蒙传》"},"similar":["以肉餧虎","以肉啖虎"],"usage":"作宾语、定语；用于比喻句"},{"id":5610,"word":"以肉餧虎","pinyin":"yǐ ròu sì hǔ","abbr":"yrwh","explanation":"比喻白白地送死。","source":{"text":"今赴秦军，如以肉餧虎，当何益也。","book":"汉·荀悦《汉纪·文帝纪》"},"similar":["以肉喂虎","以肉啖虎"],"usage":"作宾语、定语；用于比喻句"},{"id":5611,"word":"以肉驱蝇","pinyin":"yǐ ròu qū yíng","abbr":"yrqy","explanation":"比喻行为和目的自相矛盾，只能得到相反的结果。","source":{"text":"令人不解宽义，一切务为姑息弛纵，贾誉于众，以致士习骄侈，风俗日坏，间有一二力欲挽之，则又崇饰虚谈，自开邪径，所谓以肉驱蝇，负薪救火也。","book":"明·张居正《答南学院周乾明》"},"similar":["负薪救火","以骨去蚁","以肉去蚁"],"usage":"作宾语、定语；用于比喻句"},{"id":5612,"word":"以胶投漆","pinyin":"yǐ jiāo tóu qī","abbr":"yjtq","explanation":"比喻相合而密不可分。","source":{"text":"晋世杜元凯又为《左氏集解》，专取丘明之传以释孔氏之经，所谓子应乎母，以胶投漆，虽欲勿合，其可离乎！","book":"唐·孔颖达《〈春秋正义〉序》"},"usage":"作宾语、定语；用于比喻句"},{"id":5613,"word":"以能问于不能，以多问于寡","pinyin":"yǐ néng wèn yú bù néng，yǐ duō wèn yú guǎ","abbr":"ynwybnydwyg","explanation":"于：向。有才能的人向没有才能的人请教；知识渊博的人向学识肤浅的人请教。比喻不耻下问。","source":{"text":"以能问于不能，以多问于寡；有若无，实若虚，犯而不校，昔者吾友尝从事于斯矣。","book":"《论语·泰伯》"},"usage":"作宾语、定语；用于书面语"},{"id":5614,"word":"以色事人","pinyin":"yǐ sè shì rén","abbr":"yssr","explanation":"指妇女以姿色来博取男人的欢心。","source":{"text":"我以容貌之好，得从微贱爱幸于上。夫以色事人者，色衰而爱弛，爱弛则恩绝。","book":"《汉书·孝武李夫人传》"}},{"id":5615,"word":"以色从人","pinyin":"yǐ sè cóng rén","abbr":"yscr","explanation":"指妇女以姿色来博取男人的欢心。","source":{"text":"吾闻之，以色事人者，色衰而爱弛。今夫人事太子，甚爱而无子，不以此时蚤自结于诸子中贤孝者，举立以为适而子之。","book":"《史记·吕不韦列传》"},"example":{"text":"～自古然，幸逢圣主得称贤。","book":"宋·李觏《景阳宫井》"}},{"id":5616,"word":"以荷析薪","pinyin":"yǐ hè xī xīn","abbr":"yhxx","explanation":"原指父亲劈柴，儿子不能承受担当。后比喻继承父业。","source":{"text":"古人有言曰：‘其父析薪，其子弗克负荷。’","book":"《左传·昭公七年》"},"example":{"text":"冲故吏青州治中房长瑜谓孜（冲子）曰：‘前使君忠贯昊天，操逾松竹。郎君但当端坐画一，～。幅巾待命，以下从使君。’","book":"《南齐书·张冲传》"},"usage":"作宾语、定语；用于书面语"},{"id":5617,"word":"以莛叩钟","pinyin":"yǐ tíng kòu zhōng","abbr":"ytkz","explanation":"莛：草茎。原意是钟的音量大，用草茎去敲，就不能使它发出应有的响声。后比喻学识浅薄的人向知识渊博的人请教。","source":{"text":"以管窥天，以蠡测海，以莛撞钟，岂能通其条贯，考其文理，发其音声哉。","book":"汉·东方朔《答客难》"},"example":{"text":"今欲上质高贤，又恐语涉浅陋，未免“～”，自觉唐突，何敢冒昧请教！","book":"清·李汝珍《镜花缘》第十六回"},"similar":["以莛撞钟","以莛扣钟"],"usage":"作谓语、定语；用于人"},{"id":5618,"word":"以莛扣钟","pinyin":"yǐ tíng kòu zhōng","abbr":"ytkz","explanation":"莛：草茎。用草茎打钟，毫无声响。比喻应答的双方才学悬殊。","source":{"text":"白马与陈思答赠，伟长与公幹往复，虽日以莛扣钟，亦能闲雅矣。","book":"南朝·梁·锺嵘《诗品》卷下"},"similar":["以莛撞钟","以莛叩钟"],"usage":"作谓语、定语；用于人"},{"id":5619,"word":"以莛撞钟","pinyin":"yǐ tíng zhuàng zhōng","abbr":"ytzz","explanation":"莛：草茎。用草茎打钟，毫无声响。比喻才识浅陋的人向高明的学者发问，得不到回答。","source":{"text":"语曰：‘以管窥天，以蠡测海，以莛撞钟，岂能通其条贯，考其文理，发其音声哉！’","book":"《汉书·东方朔传》"},"example":{"text":"汉·东方朔《答客难》：“以蠡测海，～，岂能通其条贯，考其文理，发其音声哉。”"},"similar":["以莛扣钟","以莛叩钟"],"usage":"作谓语、定语；用于人"},{"id":5620,"word":"以虚为实","pinyin":"yǐ xū wéi shí","abbr":"yxws","explanation":"虚：空；实：满。军事上迷惑对方，使其难辨虚实、真伪的一种战术。","source":{"text":"御史一经检究，耻于不成，杖木之下，以虚为实，无罪不能自雪者，岂可胜道哉？","book":"《魏书·高恭之传》"}},{"id":5621,"word":"以虚为实，以实为虚","pinyin":"yǐ xū wéi shí，yǐ shí wéi xū","abbr":"yxwsyswx","explanation":"虚：空；实：满。军事上迷惑对方，使其难辨虚实、真伪的一种战术。","source":{"text":"诗有实字而善用之者，以实为虚。","book":"《魏书·高恭之传》：“御史一经检究，耻于不成，杖木之下，以虚为实，无罪不能自雪者，岂可胜道哉？”宋·杨万里《诚斋诗话》"},"example":{"text":"但臣与逆贼周旋三年，深知逆贼狡计甚多，常常～。","book":"姚雪垠《李自成》第一卷第三十二章"},"usage":"作谓语、定语；用于处事"},{"id":5622,"word":"以虚带实","pinyin":"yǐ xū dài shí","abbr":"yxds","explanation":"虚：指政治觉悟、理论；实：实际的计划和行动。比喻用理论为指导以带动促进具体工作；用提高人的觉悟来促进具体工作的进展。"},{"id":5623,"word":"以虞待不虞","pinyin":"yǐ yú dài bù yú","abbr":"yydby","explanation":"虞：猜度，预料。以预先有准备以防预料不到的事。","source":{"text":"故知胜有五：知可以战与不可以战者胜，识众寡之用者胜，上下同欲者胜，以虞待不虞者胜，将能而君不御者胜。此五者，知胜之道也。","book":"《孙子·谋攻》"}},{"id":5624,"word":"以蚓投鱼","pinyin":"yǐ yǐn tóu yú","abbr":"yyty","explanation":"用蚯蚓做鱼饵钓鱼。比喻用较小的代价换得较大的收获。","source":{"text":"陈使缚縡聘齐，以道衡兼主客郎接对之。縡赠诗五十韵，道衡和之，南北称美。魏收曰：‘傅縡所谓以蚓投鱼耳。’","book":"《隋书·薛道衡传》"},"similar":["抛砖引玉"],"usage":"作谓语、定语；即抛砖引玉"},{"id":5625,"word":"以蛋碰石","pinyin":"yǐ dàn pèng shí","abbr":"ydps","explanation":"拿蛋去碰石头。比喻不估计自己的力量，自取灭亡。","source":{"text":"以其言非吾言者，是犹以卵投石也，尽天下之卵，其石犹是也，不可毁也。","book":"《荀子·议兵》：“经桀作尧，譬之若以卵投石，以指绕沸。”《墨子·贵义》"},"similar":["以卵投石","以卵击石","以卵敌石"],"usage":"作谓语、定语、宾语；指自取灭亡"},{"id":5626,"word":"以螳当车","pinyin":"yǐ táng dāng chē","abbr":"ytdc","explanation":"用螳臂阻挡车轮前进。比喻自不量力。","source":{"text":"以人力而欲与理势为御，譬犹以卵投石，以螳当车，多见其不知量而已。","book":"梁启超《论专制政体有百害于君主而无一利》"}},{"id":5627,"word":"以螳挡车","pinyin":"yǐ táng dǎng chē","abbr":"ytdc","explanation":"用螳螂的胳膊来阻挡车轮前进。比喻自不量力","source":{"text":"以人力而欲与理势为御，譬犹以卵投石，以螳挡车，多见其不知量而已。","book":"梁启超《论专制政体有百害于君主而无一利》"},"similar":["螳臂当车"],"usage":"作宾语、定语；用于书面语"},{"id":5628,"word":"以蠡挹海","pinyin":"yǐ lǐ yì hǎi","abbr":"ylyh","explanation":"蠡：贝壳做的瓢。用瓢来量海。比喻观察和了解很狭窄很片面。","source":{"text":"以管窥天，以蠡测海。","book":"汉·东方朔《答客难》"},"example":{"text":"仆匏系长崎，如坐井观天，～，惟祈明教之。","book":"明·朱之瑜《答小宅生顺问六十一条》"}},{"id":5629,"word":"以蠡测海","pinyin":"yǐ lǐ cè hǎi","abbr":"ylch","explanation":"蠡：贝壳做的瓢。用贝壳来量海。比喻观察和了解很狭窄很片面。","source":{"text":"以管窥天，以蠡测海。","book":"汉·东方朔《答客难》"},"example":{"text":"彼言者，直坐井窥天，～耳！","book":"清·王韬《变法自强》"},"similar":["坐井观天","以管窥天","管窥蠡测"],"opposite":["兼收并蓄","博大精深"],"usage":"作谓语、定语、宾语、分句；指方法不对"},{"id":5630,"word":"以血偿血","pinyin":"yǐ xuè cháng xuè","abbr":"yxcx","explanation":"用仇敌的血来偿还血仇。指杀敌报仇。","source":{"text":"我国人皆欲杀汝，唯我不然。汝国已杀突董等，吾又杀汝，犹以血洗血，污益甚尔。","book":"《旧唐书·源休传》"},"example":{"text":"倘有敌人，我们就早该抽刃而起，要求～了。","book":"鲁迅《华盖集·忽然想到》"},"similar":["以血洗血","血债血偿"],"opposite":["以水洗血"],"usage":"作谓语、定语；指报仇雪恨"},{"id":5631,"word":"以血洗血","pinyin":"yǐ xuè xǐ xuè","abbr":"yxxx","explanation":"洗：洗雪。用仇敌的血来洗雪血仇。指杀敌报仇。","source":{"text":"我国人皆欲杀汝，唯我不然。汝国已杀突董等，吾又杀汝，犹以血洗血，污益甚尔。","book":"《旧唐书·源休传》"},"similar":["血债血偿","以血偿血"],"opposite":["以水洗血"],"usage":"作谓语、定语；指报仇雪恨"},{"id":5632,"word":"以血还血","pinyin":"yǐ xuè huán xuè","abbr":"yxhx","explanation":"用仇敌的血来偿还血仇。指杀敌报仇。","source":{"text":"我国人皆欲杀汝，唯我不然。汝国已杀突董等，吾又杀汝，犹以血洗血，污益甚尔。","book":"《旧唐书·源休传》"}},{"id":5633,"word":"以观后效","pinyin":"yǐ guān hòu xiào","abbr":"yghx","explanation":"后效：以后的效果。指将罪犯从轻处分，再看他以后的表现。","source":{"text":"秋节既立，鸷鸟将用，且复重申，以观后效。","book":"《后汉书·安帝纪》"},"example":{"text":"蒋中丞人尚忠厚，因见两司代为求情，亦就答应暂时留差，～。","book":"清·李宝嘉《官场现形记》第四十八回"},"usage":"作谓语、定语；用于犯过错的人"},{"id":5634,"word":"以规为瑱","pinyin":"yǐ guī wéi tiàn","abbr":"ygwt","explanation":"规：规劝；瑱：古人冠冕上垂在两侧以塞耳的玉。把规劝的话当作塞耳的瑱。比喻不听别人的规劝。","source":{"text":"赖君用之也，故言。不然，巴浦之犀犛兕象，其可尽乎！其又以规为瑱也。","book":"《国语·楚语上》"},"usage":"作谓语、定语；指不听劝告","story":["春秋时期，楚灵王公子围篡位成功后，大肆攻打齐国与赖国，对内对看不顺眼的人就处死，还大肆建造豪华宫殿。子张向楚灵王进谏，希望做一个贤明的君主，楚灵王说他的进谏只能当作瑱塞耳。子张说如果以规为瑱还不如用犀角和象牙"]},{"id":5635,"word":"以解倒悬","pinyin":"yǐ jiě dào xuán","abbr":"yjdx","explanation":"解：解救；倒悬：头朝下悬挂着。比喻解除百姓的困苦。","source":{"text":"当今之时，万乘之国行仁政，民之悦之，犹解倒悬也。","book":"《孟子·公孙丑上》"},"example":{"text":"有游客张君瑞，奉书令小僧拜投于麾下，欲求将军～之危。","book":"元·王实甫《西厢记》第二本第三折楔子"}},{"id":5636,"word":"以言为讳","pinyin":"yǐ yán wéi huì","abbr":"yywh","explanation":"人们把说话当作忌讳。形容统治阶级对言论箝制之严。","source":{"text":"妨人之口，法禁严切。","book":"《汉书·梅福传》：“间者愚民上疏，多触不急之法，或下廷尉，而死者众。自阳朔以来，天下以言为讳，朝廷尤甚。”颜师古注"},"usage":"作谓语、定语、宾语；用于处事"},{"id":5637,"word":"以言举人","pinyin":"yǐ yán jǔ rén","abbr":"yyjr","explanation":"根据言论来举荐人才。","source":{"text":"［文学］议论称诵，窃商赐之辞；刺讥言治，过管晏之才。心卑卿相，志小万乘。及授之政，昏乱不治。故以言举人，若以毛相马，此其所以多不称举。","book":"汉·桓宽《盐铁论·利议》"},"usage":"作宾语、定语；用于处事"},{"id":5638,"word":"以言取人","pinyin":"yǐ yán qǔ rén","abbr":"yyqr","explanation":"根据人的口才去判断其智能。","source":{"text":"孔子闻之，曰：‘吾以言取人，失之宰予；以貌取人，失之子羽。’","book":"《史记·仲尼弟子列传》"},"example":{"text":"清·黄宗羲《子刘子行状》：“～，失之宰予。”"},"similar":["以辞取人"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5639,"word":"以言徇物","pinyin":"yǐ yán xùn wù","abbr":"yyxw","explanation":"用违心的话语附和别人。"},{"id":5640,"word":"以誉为赏","pinyin":"yǐ yù wéi shǎng","abbr":"yyws","explanation":"根据人们的称誉给以奖赏。","source":{"text":"以毁誉为赏罚，则官自然失理。","book":"《管子·明法》：“是故官之失其治也，是主以誉为赏，以毁为罚也，然则喜赏恶罚之人离公道而行私术矣。”尹知章注"},"example":{"text":"～，以毁为罚也，则好赏恶罚之人，释公行，行私术，比周以相为也。","book":"《韩非子·有度》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":5641,"word":"以誉为赏，以毁为罚","pinyin":"yǐ yù wéi shǎng，yǐ huǐ wéi fá","abbr":"yywsyhwf","explanation":"誉：赞扬；毁：批评。指受人赞扬的官员应嘉奖，受人批评的官员应惩罚","source":{"text":"是故官之失其治也，是主以誉为赏，以毁为罚也。","book":"春秋·齐·管仲《管子·明法》"},"example":{"text":"战国·韩·韩非《韩非子·有度》：“～也，则好赏恶罚之人，释公行，行私术，比周以相为也。”"},"usage":"作宾语、定语；用于书面语"},{"id":5642,"word":"以誉进能","pinyin":"yǐ yù jìn néng","abbr":"yyjn","explanation":"根据人们的称誉去进用贤能。"},{"id":5643,"word":"以计代战","pinyin":"yǐ jì dài zhàn","abbr":"yjdz","explanation":"用计谋来代替阵前的交战。"},{"id":5644,"word":"以讦为直","pinyin":"yǐ jié wéi zhí","abbr":"yjwz","explanation":"讦：攻击别人的短处或揭发他人隐私。用揭别人的短或隐私来表明直率。","source":{"text":"恶讦以为直者。","book":"《论语·阳货》"},"example":{"text":"然则～，固非忠厚之道。","book":"清·纪昀《阅微草堂笔记·姑妄听之二》"},"usage":"作宾语、定语；用于书面语"},{"id":5645,"word":"以讹传讹","pinyin":"yǐ é chuán é","abbr":"yece","explanation":"以：拿，把；讹：谬误。指把本来就不正确的话又错误地传出去，越传越错。","source":{"text":"世上相传女娲补天炼五色石于此，故名采石，以讹传讹。","book":"宋·俞琰《席上腐谈》"},"example":{"text":"这两件事虽无考，古往今来，～，好事者竟故意的弄出这些古迹来以惑愚人。","book":"清·曹雪芹《红楼梦》第五十一回"},"similar":["三人成虎","谬种流传"],"opposite":["衣钵相传","一脉相承"],"usage":"作谓语、定语、状语；指错误相传","story":["从前楚国有个猎人，他捕鸟技艺很精湛。一次他捕获一只美丽的山鸡准备到城里去卖，过路的富翁询问是什么鸟，猎人骗他是凤凰，于是以2000金卖给富翁。富翁觉得凤凰应该进献给楚王，可是山鸡在路上死了。消息传到楚王那里，楚王嘉奖他的忠心"]},{"id":5646,"word":"以词害意","pinyin":"yǐ cí hài yì","abbr":"ychy","explanation":"因拘泥于辞义而误会或曲解作者的原意。","source":{"text":"太白‘斗酒诗百篇’，‘东坡嬉笑怒骂，皆成文章’，不过一时兴到语，不可以词害意。","book":"清·袁枚《随园诗话》卷七"},"example":{"text":"清·袁枚《随园诗话》第七卷：“不过一时兴到语，不可～。”"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":5647,"word":"以诚相见","pinyin":"yǐ chéng xiāng jiàn","abbr":"ycxj","explanation":"真心实意地相对待。","example":{"text":"今袁抚书中，虽欲敛兵息怨，尚恐未出至诚，请喇嘛归后，劝他～为是。","book":"蔡东藩《清史演义》第五回"}},{"id":5648,"word":"以谋为本","pinyin":"yǐ móu wéi běn","abbr":"ymwb","explanation":"谋：计谋，计策；本：事物的根源或根基。把计谋作为用兵的根本。","source":{"text":"本谋者，以谋为本也。","book":"明·无名氏《投笔肤谈》"}},{"id":5649,"word":"以貌取人","pinyin":"yǐ mào qǔ rén","abbr":"ymqr","explanation":"根据外貌来判别一个的的品质才能。","source":{"text":"吾以言取人，失之宰之；以貌取人，失之子羽。","book":"《史记·仲尼弟子列传》"},"example":{"text":"真是糟糕，他早又不说，但也只怪我们～，在事前没有经过一道甄别了。","book":"郭沫若《涂家埠》"},"similar":["表里如一","以容取人"],"opposite":["量才录用"],"usage":"作谓语、定语、宾语；用于人","story":["春秋时期，孔子的学生子羽相貌丑陋，孔子对他很冷淡，他只有离开孔子回去自修，后成为有名的学者。而学生宰予长得很好，但不学无术，不久就被齐王处死。孔子感慨地说：“不能以貌取人，也不能凭人说话来衡量别人。”"]},{"id":5650,"word":"以貍至鼠","pinyin":"yǐ lí zhì shǔ","abbr":"ylzs","explanation":"比喻事情不能成功。同“以貍饵鼠”。","source":{"text":"彼言者，直坐井窥天，～耳！ ★清·王韬《变法自强》"}},{"id":5651,"word":"以责后效","pinyin":"yǐ zé hòu xiào","abbr":"yzhx","explanation":"责：要求。对犯法或犯错误的人做出宽恕处理的决定后，要求其在一段时间内改正其错误。","source":{"text":"豹欲径进，鉴执不听。协又奏免鉴官，委豹为前锋，以鉴兵配之，降号折冲将军，以责后效。","book":"《晋书·蔡豹传》"},"example":{"text":"惟王宗濋首引卫兵逃遁，以致都城失守，不可不责。此外一切不问，～后效。","book":"清·毕沅《续资治通鉴》卷九十八"}},{"id":5652,"word":"以资切磋","pinyin":"yǐ zī qiē cuō","abbr":"yzqc","explanation":"资：帮助；切磋：古代把兽骨、象牙磨制成器物。借以帮助共同研究。","source":{"text":"有匪君子，如切如磋，如琢如磨。","book":"《诗经·淇奥》"},"usage":"作谓语；指共同研究"},{"id":5653,"word":"以踵解结","pinyin":"yǐ zhǒng jiě jié","abbr":"yzjj","explanation":"踵：脚后跟；结：疙瘩。用脚后跟去解疙瘩。比喻做事徒劳无功。","source":{"text":"董子曰：‘子信鬼神，何异以踵解结，终无益也。’","book":"《淮南子》：“数米简发，烦而不察，有为之甚也，何异乎以膝搔背，以踵解结矣。”唐·马总《意林》"}},{"id":5654,"word":"以身作则","pinyin":"yǐ shēn zuò zé","abbr":"yszz","explanation":"身：自身；则：准则，榜样。以自己的行动做出表率。","source":{"text":"其身正，不令而行；其身不正，虽令不从。","book":"《论语·子路》"},"example":{"text":"这其间不顾一切阻碍～做一个开路先锋的便是许倩如。","book":"巴金《家》二十五"},"similar":["言传身教","身先士卒","身体力行"],"opposite":["以身试法"],"usage":"作谓语、宾语；指自己做榜样","story":["齐国相国晏婴历仕三朝，德高望重，他对自己要求甚严，处处以身作则，倡行廉洁，吃糙米饭，穿粗布衣，坐简易车，住低矮民房。齐景公过意不去，就要送他新车新衣，他坚决不受。齐景公要给他盖新房，他还是坚持不接受"]},{"id":5655,"word":"以身报国","pinyin":"yǐ shēng bào guó","abbr":"ysbg","explanation":"把身体献给国家。指宁愿为国家的安危奉献自己的生命。","source":{"text":"卿等备位纳言，当以身报国。","book":"《魏书·辛雄传》"},"example":{"text":"不幸吾计不成，反中敌计，我二人惟有～的了。","book":"清·吴趼人《痛史》第四回"},"similar":["以身殉国"],"opposite":["苟且偷生"],"usage":"作谓语、定语；指为国捐躯"},{"id":5656,"word":"以身殉国","pinyin":"yǐ shēng xùn guó","abbr":"ysxg","explanation":"忠于自己的国家而献出生命。","source":{"text":"伯宗曰：‘丈夫当死战场，以身殉国，安能归死儿女手中乎？’","book":"南朝·梁·沈约《宋书·沈文秀传》"},"example":{"text":"或是表现在不做新朝的官甚至～上。","book":"朱自清《论气节》"},"similar":["为国捐躯","以身报国"],"opposite":["苟且偷生"],"usage":"作谓语、定语；指为国捐躯"},{"id":5657,"word":"以身殉职","pinyin":"yǐ shēn xùn zhí","abbr":"ysxz","explanation":"殉：为实现某一目标而献出生命。为忠于本职工作而献出生命。","source":{"text":"孟子曰：‘天下有道，以道殉身；天下无道，以身殉道；未闻以道殉乎人者也。’","book":"《孟子·尽心上》"},"example":{"text":"（白求恩）去年春上到延安，后来到五台山工作，不幸～。","book":"毛泽东《纪念白求恩》"},"similar":["以身许国","忠心耿耿","忠于职守"],"opposite":["苟且偷生","玩忽职守"],"usage":"作谓语、定语；指尽责"},{"id":5658,"word":"以身许国","pinyin":"yǐ shēng xǔ guó","abbr":"ysxg","explanation":"许：预先答应给与。把身体献给国家。指宁愿为国家的安危奉献自己的生命。","source":{"text":"横尸庙门，遂其由来以身许国之志。","book":"南朝·梁·沈约《宋书·武帝纪上》"},"example":{"text":"盖～，但求福利民，与民除害。","book":"清·林则徐《家书·给妻郑夫人书》"},"similar":["舍生取义","以身殉职","肝脑涂地"],"opposite":["苟且偷生","苟且偏安","贪生怕死"],"usage":"作谓语、定语；指为国尽忠"},{"id":5659,"word":"以身试法","pinyin":"yǐ shēn shì fǎ","abbr":"yssf","explanation":"身：亲身，亲自；试：尝试。试着亲身去做触犯法律的事。指明知故犯。","source":{"text":"明慎所职，毋以身试法。","book":"《汉书·王尊传》"},"example":{"text":"我们每个公民都要奉公守法，不要～。"},"similar":["违法乱纪","作奸犯科","知法犯法"],"opposite":["廉洁奉公","以身作则","奉公守法"],"usage":"作谓语、宾语、定语；指明知故犯","story":["西汉时期，高阳人王尊由衙门听差逐渐官至安定郡太守，他非常痛恨那些作威作福、以身试法的官员，决心整顿吏治，惩办一些贪官污吏。同时他以身作则，勤于政事。经过一段时间的治理，安定郡变得安定了"]},{"id":5660,"word":"以身试祸","pinyin":"yǐ shēn shì huò","abbr":"yssh","explanation":"身：亲身，亲自；试：尝试。试着亲身去做触犯法律的事。指明知故犯。","source":{"text":"以为足下当暞力同心，匡翼汉室，而阴谋不轨，以身试祸，岂不痛哉！","book":"《三国志·魏志·袁术传》"},"example":{"text":"而阴谋不轨，～，欲吾营私阿附，有死不能也。","book":"《资治通鉴·汉纪·孝献帝建安二年》"}},{"id":5661,"word":"以身试险","pinyin":"yǐ shēn shì xiǎn","abbr":"yssx","explanation":"身：亲身，亲自；试：尝试。试着亲身去做触犯法律的事。指明知故犯。","source":{"text":"明慎所职，毋以身试法。","book":"《汉书·王尊传》"},"example":{"text":"向来搜检夹带，每每从宽。因其急于功名，～情尚可宥。","book":"清·李绿园《歧路灯》第九十三回"}},{"id":5662,"word":"以辞取人","pinyin":"yǐ cí qǔ rén","abbr":"ycqr","explanation":"根据人的口才去判断其智能。同“以言取人”。","source":{"text":"宰我有文雅之辞，而智不充其辩。孔子曰：‘ ……以辞取人，则失之宰予。’","book":"《孔子家语·子路初见》"},"similar":["以言取人"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5663,"word":"以辞害意","pinyin":"yǐ cí hài yì","abbr":"ychy","explanation":"因拘泥于辞义而误会或曲解作者的原意。","source":{"text":"战国·邹·孟轲《孟子·万章上》： “说《诗》者不以文害辞，不以辞害志。”"},"example":{"text":"说《诗》者不以文害辞，不～也。","book":"南朝·宋·刘勰《文心雕龙·夸饰》"},"similar":["以词害意"],"usage":"作谓语、定语；指曲解别人的意思"},{"id":5664,"word":"以迂为直","pinyin":"yǐ yū wéi zhí","abbr":"yywz","explanation":"迂：曲折，绕远。用迂回曲折的途径达到近直的目的。","source":{"text":"军争之难者，以迂为直，以患为利。故迂其途，而诱之以利，后人发，先人致，此知迂直之计者也。","book":"《孙子·军争》"}},{"id":5665,"word":"以近知远","pinyin":"yǐ jìn zhī yuǎn","abbr":"yjzy","explanation":"以：用，根据。根据近的可以推知远的。","source":{"text":"以近知远，以一知万，以微知明，此之谓也。","book":"《荀子·非相》"},"example":{"text":"孔子之明，以小知大，～，通于论者也。","book":"《淮南子·齐俗训》"}},{"id":5666,"word":"以进为退","pinyin":"yǐ jìn wéi tuì","abbr":"yjwt","explanation":"指表面上故作进攻的姿态，实际上是准备退却，也指表面故作进升的阶梯，实际上却以此作出退让的打算。","source":{"text":"辞强而进驱者，退也。","book":"《孙子·行军》"},"example":{"text":"此刻所以要连问他三件为难之事，那是～，令他深信不疑。","book":"金庸《天龙八部》第四十八回"},"usage":"作宾语、定语；用于处事"},{"id":5667,"word":"以退为进","pinyin":"yǐ tuì wéi jìn","abbr":"ytwj","explanation":"本指以谦让取得德行的进步，后指以退让的姿态作为进取的手段。","source":{"text":"昔乎颜渊以退为进，天下鲜俪焉。","book":"汉·扬雄《法言·君子》"},"example":{"text":"世道之衰也，士大夫不知礼义为何物，往往知进而不知退，及其变也，或～。","book":"清·黄宗羲《子刘子行状上》"},"similar":["掩人耳目","以守为攻","故作姿态"],"opposite":["突飞猛进","乘胜前进"],"usage":"作谓语、定语；指处世手段"},{"id":5668,"word":"以逸击劳","pinyin":"yǐ yì jī láo","abbr":"yyjl","explanation":"用充分养息的军队攻击疲劳的敌人。","source":{"text":"今罕羌欲为敦煌、酒泉寇，饬兵马，练战士，以须其至，坐得致敌之术，以逸击劳，取胜之道也。","book":"《汉书·赵充国传》"},"example":{"text":"敬业畏直捣江都，必将邀我中路，吾今乘胜进，又～，破之必矣！","book":"《新唐书·魏元忠传》"},"similar":["以佚待劳","以逸待劳"],"usage":"作谓语、定语；用于书面语"},{"id":5669,"word":"以逸制劳","pinyin":"yǐ yì zhì láo","abbr":"yyzl","explanation":"逸：安闲；劳：疲劳。指在战争中做好充分准备，养精蓄锐，等疲乏的敌人来犯时给以迎头痛击。","source":{"text":"以近待远，以佚待劳，以饱待饥，此治力者也。","book":"《孙子·军争》"},"example":{"text":"上流诸军，素无戒备，晋水师顺流前来，势必至此，不如整兵待着，～。","book":"蔡东藩《两晋演义》第五回"}},{"id":5670,"word":"以逸待劳","pinyin":"yǐ yì dài láo","abbr":"yydl","explanation":"逸：安闲；劳：疲劳。指在战争中做好充分准备，养精蓄锐，等疲乏的敌人来犯时给以迎头痛击。","source":{"text":"以近待远，以佚待劳，以饱待饥，此治力者也。","book":"《孙子·军争》"},"example":{"text":"他踞了碉楼，～，我们倒难以刻期取胜。","book":"清·吴敬梓《儒林外史》第四十三回"},"similar":["养精蓄锐","用逸待劳"],"opposite":["疲于奔命"],"usage":"作谓语、宾语、状语；指作战、工作等方法","story":["东汉初年，隗嚣占据陇西，后投降四川称帝的公孙述，汉光武帝派冯异为征西大将军。冯异想进攻恂邑，隗嚣也率军进攻。冯异手下建议避免正面交锋，冯异主张先占据该城，然后以逸待劳，等待疲劳的隗嚣来攻，这样把隗嚣打得狼狈不堪"]},{"id":5671,"word":"以邻为壑","pinyin":"yǐ lín wéi hè","abbr":"ylwh","explanation":"拿邻国当做大水坑，把本国的洪水排泄到那里去。比喻只图自己一方的利益，把困难或祸害转嫁给别人。","source":{"text":"是故禹以四海为壑。今吾子以邻国为壑。","book":"《孟子·告子下》"},"example":{"text":"有些自私自利的人，做事从来不为别人着想，甚至～。"},"similar":["嫁祸于人"],"opposite":["雪中送炭","相濡以沫","与人为善"],"usage":"作谓语、定语；指嫁祸于人","story":["战国时期魏国宰相白圭，他在国内大兴水利，发展农业，他在治理洪水方面采取修筑堤坝，阻拦洪水流入国内。他骄傲地对孟子说他治水胜过大禹。孟子说大禹治水是以海为壑，而你是以邻为壑，把洪灾推给了邻国"]},{"id":5672,"word":"以郄视文","pinyin":"yǐ xì shì wén","abbr":"yxsw","explanation":"从缝隙里看杂色文采。比喻见识浅陋狭隘。郄，通“隙”。","source":{"text":"扁鹊仰天叹曰：‘夫子之为方也，若以管窥天，以郄视文。越人（扁鹊名）之为方也，不待切脉望色，听声写形，言病之所在。’","book":"《史记·扁鹊仓公列传》"},"usage":"作宾语、定语；用于比喻句"},{"id":5673,"word":"以酒浇愁","pinyin":"yǐ jiǔ jiāo chóu","abbr":"yjjc","explanation":"借助酒来排遗心中的积郁。","source":{"text":"抽刀断水水更流，举杯销愁愁更愁。","book":"唐·李白《宣州谢眺楼饯别校书叔云》"},"example":{"text":"今日无意中遇上一位武功堪与自己相匹的英雄，偏又无缘结识，只得～。","book":"金庸《天龙八部》第二十四回"}},{"id":5674,"word":"以酒解酲","pinyin":"yǐ jiǔ jiě chéng","abbr":"yjjc","explanation":"酲：喝醉了神志不清。用酒来解酒醉。比喻用有害的方法救急。","source":{"text":"伶跪而祝曰：‘天生刘伶，以酒为名，一饮一斛，五斗解酲，妇人之言，慎不可听！’便引酒进肉，隗然已醉矣。","book":"南朝宋·刘义庆《世说新语·任诞》"},"usage":"作宾语、定语；指用酒来解酒醉","story":["刘伶特别馋酒，向老婆要酒喝，老婆把酒器砸烂把酒倒掉，哭着对他说：“你不能再喝了，这样会伤害身体的，赶快戒酒吧。”刘伶答应，但要求在神面前发誓。老婆十分高兴，在神案前摆好酒肉。刘伶向神宣誓，边说边喝酒，结果又醉了"]},{"id":5675,"word":"以酒解醒","pinyin":"yǐ jiǔ jiě xǐng","abbr":"yjjx","explanation":"用酒来解酒醉。比喻用有害的方法救急。","source":{"text":"伶跪而祝曰：‘天生刘伶，以酒为名，一饮一斛，五斗解酲，妇人之言，慎不可听！’便引酒进肉，隗然已醉矣。","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":5676,"word":"以铢称镒","pinyin":"yǐ zhū chēng yì","abbr":"yzcy","explanation":"用铢同镒相比，表示力量极不相称，处于绝对劣势。","source":{"text":"二十两为镒，二十四铢为两。此言有制之兵对无制之兵，轻重不侔也。","book":"《孙子·形》：“故胜兵若以镒称铢，败兵若以铢称镒。”王皙注：“言铢、镒者，以明轻重之至也。”张预注"},"similar":["以铢程镒","以镒称铢"],"usage":"作宾语、定语；用于书面语"},{"id":5677,"word":"以铢程镒","pinyin":"yǐ zhū chéng yì","abbr":"yzcy","explanation":"用铢同镒作比较，表示很不相称。","source":{"text":"陈水南臬宪尝以南唐李昪宜继唐后，遂改马令《南唐书》为《唐馀纪传》，此犹萧常以《三国·蜀志》为《续后汉书》也。然昭烈世系甚明，犹觉以铢程镒……昪本安吉砦将潘某之子，昪姓实潘也……","book":"明·姚士粦《见只编》卷上"},"similar":["以铢称镒","以镒称铢"],"usage":"作宾语、定语；用于书面语"},{"id":5678,"word":"以锥刺地","pinyin":"yǐ zhuī cì dì","abbr":"yzcd","explanation":"用锥子刺地来测量地的深浅。比喻见识浅陋，所知甚少。","source":{"text":"是直用管窥天，用锥指地也，不亦小乎！","book":"《庄子·秋水》"},"similar":["以蠡测海","以管窥天"],"usage":"作谓语、宾语、定语；指见识少"},{"id":5679,"word":"以锥飡壸","pinyin":"yǐ zhuī cān kǔn","abbr":"yzck","explanation":"用锥子到壶里取东西吃。比喻达不到目的。"},{"id":5680,"word":"以锥餐壶","pinyin":"yǐ zhuī cān hú","abbr":"yzch","explanation":"用锥子到壶里取东西吃。比喻达不到目的。","source":{"text":"不道礼宪，以《诗》、《书》为之，譬之犹以指测河也，以戈舂黍也，以锥餐壶也，不可以得之矣。","book":"《荀子·劝学》"},"similar":["以指测河","以戈舂黍"],"usage":"作宾语、定语；用于比喻句"},{"id":5681,"word":"以镒称铢","pinyin":"yǐ yì chēng zhū","abbr":"yycz","explanation":"用镒同铢相比，表示力量处于绝对优势。","source":{"text":"言铢、镒者，以明轻重之至也。","book":"《孙子·形》：“故胜兵若以镒称铢，败兵若以铢称镒。”王皙注"},"similar":["以铢称镒","以铢程镒"],"usage":"作宾语、定语；用于书面语"},{"id":5682,"word":"以长攻短","pinyin":"yǐ cháng gōng duǎn","abbr":"yzgd","explanation":"利用自己的长处去攻击别人的短处。","example":{"text":"～很容易取胜。"},"similar":["以碫投卵"],"opposite":["以卵击石"],"usage":"作谓语、主语、宾语；用于战争等","story":["宋江因犯案被发配到江州，与江湖上的戴宗与李逵到江边的琵琶亭酒馆喝酒，他要喝鲜鱼汤。李逵到江边渔船上去取，与渔船主人张顺发生争执就打了起来，张顺利用李逵不通水性，把他拉下水狠打，戴宗前去劝架，两人遂成为好朋友"]},{"id":5683,"word":"以防万一","pinyin":"yǐ fáng wàn yī","abbr":"yfwy","explanation":"万一：意外变化。用以防备难以预料的事情。","source":{"text":"许晓轩他们就学写陈然的仿宋字体，以防万一。","book":"罗广斌《挺进报》"},"example":{"text":"我们要提高警惕，～敌人来偷袭。"},"similar":["有备无患","防患未然","防微杜渐"],"opposite":["追悔莫及","亡羊补牢","悔之晚矣"],"usage":"作谓语；指预防"},{"id":5684,"word":"以防不测","pinyin":"yǐ fáng bù cè","abbr":"yfbc","explanation":"防：防备；测：预测。用来防备不曾料想到的事。","source":{"text":"公必欲去，我等引甲士护从，以防不测。","book":"明·罗贯中《三国演义》第三回"},"example":{"text":"我们必须全力以赴，做好抢险的一切准备，～，绝不能有一丝一毫的侥幸心理。","book":"张中明《人生劫》"},"similar":["防患未然","防微杜渐","有备无患"],"opposite":["临阵磨枪","临渴掘井"],"usage":"作谓语、宾语；指预防"},{"id":5685,"word":"以防未然","pinyin":"yǐ fáng wèi rán","abbr":"yfwr","explanation":"对可能发生的事情预先做好防备。","source":{"text":"孝成皇帝承建业之基，乘征伐之威，兵革不动，国家无事，而大臣倾邪，谗佞在朝，曾不深惟本末之难，以防未然之戒，欲专主威，排妒有功。","book":"《汉书·陈汤传》"},"example":{"text":"并饬王自主其国，仰遵祖训，勿挠有司～，庶内有以安宗社，外有以保懿亲，一举两善，无逾于此。","book":"蔡东藩《明史演义》第五十一回"},"usage":"作谓语、定语；用于处事"},{"id":5686,"word":"以附骥尾","pinyin":"yǐ fù jì wěi","abbr":"yfjw","explanation":"骥：千里马。苍蝇附在千里马的尾巴上随着千里马跑至远方。比喻因沾别人光而成名。","source":{"text":"颜渊虽笃学，附骥尾而行益显。","book":"《史记·伯夷列传》"},"example":{"text":"请教先生，不知尊选上面可好添上小弟一个名字，与先生同选，～？","book":"清·吴敬梓《儒林外史》第十三回"}},{"id":5687,"word":"以顺诛逆","pinyin":"yǐ shùn zhū nì","abbr":"yszn","explanation":"顺：顺应；逆：违反发展趋势。顺应趋势，征伐逆历史趋势的势力。","source":{"text":"皆高垒深壁，勿与战，益为疑兵，示天下形势，以顺诛逆，可立定也。","book":"《三国志·魏志·武帝纪》"},"example":{"text":"但未尝孤军决胜，戎事殆非所长，臣服晦智，晦知臣勇。今奉命往讨，～，定可为陛下擒晦呢！","book":"蔡东藩《南北史演义》第九回"}},{"id":5688,"word":"以风风人","pinyin":"yǐ fēng fèng rén","abbr":"yffr","explanation":"风：风化；凤（fèng）：感人。用教化古人。比喻及时给人教益和帮助。","source":{"text":"吾不能以春风风人，吾不能以夏雨雨人，吾穷必矣。","book":"汉·刘向《说苑·贵德》"}},{"id":5689,"word":"以骨去蚁","pinyin":"yǐ gǔ qù yǐ","abbr":"ygqy","explanation":"用肉驱赶蚂蚁，蚂蚁越多。比喻行为和目的自相矛盾，只能得到相反的结果。同“以肉去蚁”。","source":{"text":"以骨去蚁，蚁愈多；以鱼驱蝇，蝇愈至。","book":"南朝·梁元帝《金楼子·立言下》"},"similar":["以肉去蚁"],"usage":"作宾语、定语；用于比喻句"},{"id":5690,"word":"以鱼驱蝇","pinyin":"yǐ yú qū yíng","abbr":"yyqy","explanation":"鱼腥能招来苍蝇，用鱼驱赶苍蝇，苍蝇更多。比喻行为和目的自相矛盾，只能得到相反的结果。","source":{"text":"以鱼驱蝇，蝇愈至。","book":"《韩非子·外储说左下》：“以肉去蚁，蚁愈多；以鱼驱蝇，蝇愈至。”南朝·梁元帝《金楼子·立言下》"},"example":{"text":"南朝·梁元帝《金楼子·立言下》：“～，蝇愈至。”"},"similar":["以肉去蚁"],"usage":"作宾语、定语；用于比喻句"},{"id":5691,"word":"以鹿为马","pinyin":"yǐ lù wéi mǎ","abbr":"ylwm","explanation":"把鹿说成马。比喻故意颠倒是非。","source":{"text":"秦二世之时，赵高驾鹿而从行，王曰:‘丞相何为驾鹿？’高曰:‘马也。’王曰:‘丞相误邪，以鹿为马也。’高曰:‘乃马也。陛下以臣之言为不然，愿问群臣。’于是乃问群臣，群臣半言马半言鹿。","book":"汉·陆贾《新语·辨惑》"},"example":{"text":"若论不直，其粗至於～，也是不直。","book":"宋·朱熹《朱子语类》卷三十二"}},{"id":5692,"word":"以黑为白","pinyin":"yǐ hēi wéi bái","abbr":"yhwb","explanation":"指颠倒是非。","source":{"text":"父虽亲，以黑为白，子不能从。","book":"《吕氏春秋·应同》"},"example":{"text":"‘罔’只是脱空作伪，做人不诚实，以非为是，～。如不孝于父，却与人说我孝。","book":"《朱子语类》卷三二"},"similar":["以白为黑","颠倒是非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":5693,"word":"以鼠为璞","pinyin":"yǐ shǔ wéi pú","abbr":"yswp","explanation":"璞：未经雕琢的玉。把死老鼠当成是未经雕琢的玉。比喻以假充真，名不符实的人或事物。","source":{"text":"郑人谓玉未理者璞。周人谓鼠未腊者朴。周人怀朴过郑贾曰：‘欲买朴乎？’郑贾曰：‘欲之。’出其朴视之，乃鼠也。因谢不取。","book":"《战国策·秦策三》"}},{"id":5694,"word":"仪态万千","pinyin":"yí tài wàn qiān","abbr":"ytwq","explanation":"仪态：姿态，容貌。形容容貌、姿态各方面都很美。","source":{"text":"素女为我师，仪态盈万方。","book":"汉·张衡《同声赋》"},"example":{"text":"湖上的明月和落日，湖上的浓阴和微雨，我都见过了，真是～。","book":"冰心《寄小读者·通讯七》"},"similar":["仪态万方"],"usage":"作谓语、定语；多用于女子或事物"},{"id":5695,"word":"仪态万方","pinyin":"yí tài wàn fāng","abbr":"ytwf","explanation":"仪态：姿态，容貌；万方：多方面。形容容貌、姿态各方面都很美。","source":{"text":"素女为我师，仪态盈万方。","book":"汉·张衡《同声赋》"},"example":{"text":"忽有一女郎诣词焚香，翩然而入，～，容光四映。","book":"清·王韬《淞滨琐话·真吾炼师》"},"similar":["仪态万千","倾国倾城","天姿国色"],"opposite":["面目可憎","其貌不扬"],"usage":"作谓语、定语；用于女子"},{"id":5696,"word":"仪表堂堂","pinyin":"yí biǎo táng táng","abbr":"ybtt","explanation":"仪表：人的外表，风度；堂堂：仪容庄严大方的样子。形容人的容貌端正。","source":{"text":"曹丞相魁梧奇伟，仪表堂堂。","book":"郭沫若《蔡文姬》第二幕"},"example":{"text":"他生得～，一表人才。"},"similar":["一表人才"],"opposite":["相貌平平"],"usage":"作谓语、宾语、定语、状语；形容男子庄重"},{"id":5697,"word":"仪静体闲","pinyin":"yí jìng tǐ xián","abbr":"yjtx","explanation":"形容女子态度文静，体貌素雅。","source":{"text":"环姿艳溢，仪静体闲。","book":"三国魏·曹植《洛神赋》"},"usage":"作谓语、定语；指女子仪态"},{"id":5698,"word":"仰不愧天","pinyin":"yǎng bù kuì tiān","abbr":"ybkt","explanation":"抬头仰望，对天无愧。指没有做过坏事，问心无愧。","source":{"text":"仰不愧于天，俯不怍于人。","book":"战国·邹·孟轲《孟子·尽心上》"},"example":{"text":"～，俯不愧人，内不愧心。","book":"唐·韩愈《昌黎集·卷十八·与孟尚书书》"},"similar":["问心无愧","堂堂正正","光明正大"],"opposite":["问心有愧","伤天害理"],"usage":"作谓语、定语；指为人公正"},{"id":5699,"word":"仰之弥高","pinyin":"yǎng zhī mí gāo","abbr":"yzmg","explanation":"愈仰望愈觉得其崇高。表示极其敬仰之意。","source":{"text":"颜渊喟然叹曰：‘仰之弥高，钻之弥坚，瞻之在前，忽焉在后，夫子循循然诱人。博我以文，约我以礼，欲罢不能，既竭吾才，如有所立卓尔，未由也已。’","book":"《论语·子罕》"},"similar":["高插云霄","高不可攀","高山仰止"],"opposite":["如履平地"],"usage":"作宾语、分句；指越望越高"},{"id":5700,"word":"仰之弥高，钻之弥坚","pinyin":"yǎng zhī mí gāo，zuān zhī mí jiān","abbr":"yzmgzzmj","explanation":"愈仰望愈觉得其崇高；越钻研越觉得其艰深。表示极其敬仰之意。","source":{"text":"颜渊喟然叹曰：‘仰之弥高，钻之弥坚，瞻之在前，忽焉在后，夫子循循然诱人。博我以文，约我以礼，欲罢不能，既竭吾才，如有所立卓尔，未由也已。’","book":"《论语·子罕》"},"example":{"text":"惟我用夙夜匪懈，日钻其道，而～，我用欲罢不敢。","book":"《晋书·夏侯湛传》"}},{"id":5701,"word":"仰事俛畜","pinyin":"yǎng shì fǔ chù","abbr":"ysfc","explanation":"泛指维持一家生活。同“仰事俯畜”。"},{"id":5702,"word":"仰事俯畜","pinyin":"yǎng shì fǔ xù","abbr":"ysfx","explanation":"上要侍奉父母，下要养活妻儿。泛指维持一家生活。","source":{"text":"是故明君制民之产，必使仰足以事父母，俯足以畜妻子。","book":"《孟子·梁惠王上》"},"example":{"text":"坐书院可～。","book":"清·恽敬《答来卿》"},"similar":["仰事俯育"],"usage":"作谓语；泛指维持全家生活"},{"id":5703,"word":"仰事俯育","pinyin":"yǎng shì fǔ yù","abbr":"ysfy","explanation":"上要侍奉父母，下要养活妻儿。泛指维持一家生活。同“仰事俯畜”。","source":{"text":"春耕夏耘，仰事俯育。","book":"宋·陆游《戊申严州劝农文》"},"example":{"text":"吾忝为丈夫，而不能～，诚自愧恧。","book":"清·吴炽昌《客窗闲话初集·沈竹楼》"},"similar":["仰事俯畜"],"usage":"作谓语；泛指维持全家生活"},{"id":5704,"word":"仰人眉睫","pinyin":"yǎng rén méi jié","abbr":"yrmj","explanation":"指看别人的脸色行事。","source":{"text":"自可观书于市，安能看人眉睫乎！","book":"《北史·崔亮传》"},"example":{"text":"‘我不惯～。’我听了这句话，倒不便再劝他了。","book":"清·吴趼人《恨海》第十回"},"usage":"作谓语、定语；指看别人的脸色行事"},{"id":5705,"word":"仰人鼻息","pinyin":"yǎng rén bí xī","abbr":"yrbx","explanation":"仰：依赖；息：呼吸时进出的气。依赖别人的呼吸来生活。比喻依赖别人，不能自主。","source":{"text":"袁绍孤客穷军，仰我鼻息，譬如婴儿在股掌之上，绝其哺乳，立可饿杀。","book":"《后汉书·袁绍传》"},"example":{"text":"百年梦，国势弱，叹蹉跎。～，奴才思想奈天何！","book":"陈毅《水调歌头·四游良口》词"},"similar":["寄人篱下","傍人门户","身不由己"],"opposite":["自力更生","自食其力"],"usage":"作谓语、定语；指傍人门户","story":["东汉末年，袁绍起兵讨伐董卓，很多郡县纷纷响应，冀州牧韩馥看到袁绍的强大十分不安，就克扣他的军粮。袁绍派公孙瓒发兵威胁冀州，派高干去游说韩馥。韩馥不听谋士的意见，就把冀州让给这个仰他鼻息的袁绍，最终被逼自杀"]},{"id":5706,"word":"仰取俯拾","pinyin":"yǎng qǔ fǔ shí","abbr":"yqfs","explanation":"低头拾地上的东西，抬头拿上面的东西。形容一举一动都有收获。","source":{"text":"以铁冶起，富至巨万。然家自父兄子孙约，俯有拾，仰有取。","book":"西汉·司马迁《史记·货殖列传》"},"example":{"text":"家藏金穴自封闭，～仍贪饕。","book":"清·唐孙华《时世公子行》"},"similar":["仰拾俯取"],"usage":"作谓语、定语；形容一举一动都有收获"},{"id":5707,"word":"仰天大笑","pinyin":"yǎng tiān dà xiào","abbr":"ytdx","explanation":"仰头朝天而大声地笑。多就对某件事不以为然而采取旁若无人的态度而言。","source":{"text":"齐王使淳于髡之赵请求兵，赍金百斤，车马十驷。淳于髡仰天大笑，冠缨索绝。","book":"《史记·滑稽列传》"},"example":{"text":"～出门去，我辈岂是蓬蒿人。","book":"唐·李白《南陵别儿童入京》"}},{"id":5708,"word":"仰天而笑","pinyin":"yǎng tiān ér xiào","abbr":"ytex","explanation":"仰头朝天而大声地笑。多就对某件事不以为然而采取旁若无人的态度而言。","source":{"text":"王抽旃旄而抑兕首，仰天而笑。","book":"《战国策·楚策一》"},"example":{"text":"孔明见众官中，一人～，面亦有喜色。","book":"明·罗贯中《三国演义》第八十五回"}},{"id":5709,"word":"仰屋之勤","pinyin":"yǎng wū zhī qín","abbr":"ywzq","explanation":"仰：脸向上；勤：勤奋。形容一心放在著作上。","source":{"text":"时世祖居藩，颇事声誉，勤心著述，卮酒未尝妄进，恭每从容谓人曰：‘下官历观世人，多有不好欢乐，乃仰眠床上，看屋梁而著书。千秋万岁，谁传此者。’","book":"《梁书·南平元襄王伟传》"},"similar":["仰屋著书"],"usage":"作谓语、定语；指一心写作"},{"id":5710,"word":"仰屋兴叹","pinyin":"yǎng wū xīng tàn","abbr":"ywxt","explanation":"仰望屋顶长叹。指毫无办法，一筹莫展。","example":{"text":"对此我只好～。"},"similar":["仰屋窃叹","仰屋兴嗟"],"usage":"作谓语、宾语；指毫无办法"},{"id":5711,"word":"仰屋兴嗟","pinyin":"yǎng wū xīng jiē","abbr":"ywxj","explanation":"仰望屋顶，发出叹息。形容处于困境，无可奈何。","source":{"text":"及其归舍，口虽不言，而仰屋窃叹，莫不知其多冤，无敢牾陛下者。","book":"《后汉书·寒朗传》"},"example":{"text":"勤既就职，日虑国用不足，往往～，不得已商诸太尉张禹，及司空张敏。","book":"蔡东藩《后汉演义》第三十八回"},"similar":["仰屋兴叹"],"usage":"作谓语、宾语；指毫无办法"},{"id":5712,"word":"仰屋浩叹","pinyin":"yǎng wū hào tàn","abbr":"ywht","explanation":"仰望屋顶，深深叹息。形容处于困境，无可奈何。","source":{"text":"及其归舍，口虽不言，而仰屋窃叹，莫不知其多冤，无敢牾陛下者。","book":"《后汉书·寒朗传》"}},{"id":5713,"word":"仰屋着书","pinyin":"yǎng wū zhù shū","abbr":"ywzs","explanation":"仰：脸向上；着：写。形容一心放在著作上。","source":{"text":"下官历观世人，多有不好欢乐，乃仰眠床上，看屋梁而着书。千秋万岁，谁传此者。","book":"《梁书·南平元襄王伟传》"}},{"id":5714,"word":"仰屋窃叹","pinyin":"yǎng wū qiè tàn","abbr":"ywqt","explanation":"窃：私自。仰望屋顶，私自叹息。形容处于困境，无可奈何。","source":{"text":"及其归舍，口虽不言而仰屋窃叹，莫不知其多冤，无敢牾陛下言者。","book":"《资治通鉴·汉纪明帝永平十四年》"},"similar":["仰屋兴叹"],"usage":"作谓语、宾语；指无可奈何"},{"id":5715,"word":"仰屋著书","pinyin":"yǎng wū zhù shū","abbr":"ywzs","explanation":"仰：脸向上；著：写。形容一心放在著作上。","source":{"text":"下官历观世人，多有不好欢乐，乃仰眠床上，看屋梁而著书。千秋万岁，谁传此者。","book":"《梁书·南平元襄王伟传》"},"similar":["仰屋之勤"],"usage":"作谓语、定语；指一心写作"},{"id":5716,"word":"仰息他人","pinyin":"yǎng xī tā rén","abbr":"yxtr","explanation":"仰：依赖；息：呼吸时进出的气。依赖别人的呼吸来生活。比喻依赖别人，不能自主。","source":{"text":"袁绍孤客穷军，仰我鼻息，譬如婴儿在股掌之上，绝其哺乳，立可饿杀。","book":"《后汉书·袁绍传》"},"example":{"text":"转思三十里非遥，何必～？","book":"清·蒲松龄《聊斋志异·婴宁》"},"similar":["仰人鼻息","仰承鼻息"],"usage":"作谓语、定语；指傍人门户"},{"id":5717,"word":"仰手接飞猱，俯身散马蹄","pinyin":"yǎng shǒu jiē fēi náo，fǔ shēn sǎn mǎ tí","abbr":"ysjfnfssmt","explanation":"接：迎面射；猱：猿类；马蹄：一种箭靶的名称。扬起手射中飞猿，俯下身射破箭靶。形容技艺高超","source":{"text":"仰手接飞猱，俯身散马蹄。狡捷过猿猴，勇剽若豹螭。","book":"三国·魏·曹植《白马篇》"},"example":{"text":"吴伯箫《记一辆纺车》：“那种感情，是凯旋的骑士对战马的感情，是‘～’的射手对良弓的感情。”"},"usage":"作宾语、定语；用于书面语"},{"id":5718,"word":"仰承鼻息","pinyin":"yǎng chéng bí xī","abbr":"ycbx","explanation":"仰：依赖；息：呼吸时进出的气。依赖别人的呼吸来生活。比喻依赖别人，不能自主。","source":{"text":"袁绍孤客穷军，仰我鼻息，譬如婴儿在股掌之上，绝其哺乳，立可饿杀。","book":"《后汉书·袁绍传》"},"example":{"text":"奈员逆受制于绍深，事事～，适值绍深妻死，遂把宣娇再嫁绍深。","book":"清·魏子安《花月痕》第四十二回"},"similar":["仰人鼻息","仰息他人"],"usage":"作谓语、定语；指傍人门户"},{"id":5719,"word":"仰拾俯取","pinyin":"yǎng shí fǔ qǔ","abbr":"ysfq","explanation":"形容一举一动都有收获。同“仰取俯拾”。","source":{"text":"家藏金穴自封闭，仰拾俯取仍贪饕。","book":"清·唐孙华《时世公子行》"},"similar":["仰取俯拾"],"usage":"作谓语、定语；形容一举一动都有收获"},{"id":5720,"word":"仰攀俯取","pinyin":"yǎng pān fǔ qǔ","abbr":"ypfq","explanation":"仰身可以攀折，俯身可以拾取。比喻可以随处多得。","source":{"text":"家自父兄子孙约，俯有拾，仰有取。","book":"《史记·货殖列传》"},"example":{"text":"服庇草木蔽穹隆，～食以充。","book":"唐·柳宗元《南岳弥陀和尚碑》"}},{"id":5721,"word":"仰望终身","pinyin":"yǎng wàng zhōng shēn","abbr":"ywzs","explanation":"仰望：依赖，指望。封建礼教要求妇女从一而终，所以一辈子都要把丈夫当成唯一的依靠。","source":{"text":"良人者，所仰望而终身也。","book":"《孟子·离娄下》"},"example":{"text":"一来使二女得嫁贤人，有所～；二来就可试他待父母如何。","book":"清·无名氏《小五义》第二十二回"}},{"id":5722,"word":"仰而赋诗","pinyin":"yang er fu shi","abbr":"yefs","explanation":"仰头歌唱作诗。"},{"id":5723,"word":"仰观俯察","pinyin":"yǎng guān fǔ chá","abbr":"ygfc","explanation":"仰：抬起头；俯：低下头，弯下腰。指多方或仔细观察。","source":{"text":"仰以观于天文，俯以察于地理，是故知幽明之故。","book":"《周易·系辞上》"},"example":{"text":"～之间，定有活泼天机来往胸中。","book":"太平天国·洪仁玕《军次实录·谕天下读书士子》"},"usage":"作谓语；指多方或仔细观察"},{"id":5724,"word":"仰视俯育","pinyin":"yǎng shì fǔ yù","abbr":"ysfy","explanation":"育：养活。上要侍奉父母，下要养活妻儿。泛指维持一家生活。","source":{"text":"是故明君制民之产，必使仰足以事父母，俯足以畜妻子。","book":"《孟子·梁惠王上》"}},{"id":5725,"word":"仰面唾天","pinyin":"yǎng miàn tuò tiān","abbr":"ymtt","explanation":"仰头向着天吐唾沫，唾沫还是落在自己的脸上。比喻本来想损害别人，结果受害的还是自己。"},{"id":5726,"word":"仰面朝天","pinyin":"yǎng miàn cháo tiān","abbr":"ymct","explanation":"脸朝上平卧或身向后摔倒的样子。","source":{"text":"江樊往后倒退了几步，身不由己的也就仰面朝天的躺下了。","book":"清·石玉昆《三侠五义》第49回"},"example":{"text":"李豹啊的一声，往后一仰身，一个～，就躺在地上了。","book":"陈荫荣《兴唐传·闹花灯》"},"similar":["四脚朝天"],"usage":"作宾语、状语；指向后摔倒"},{"id":5727,"word":"仰首伸眉","pinyin":"yǎng shǒu shēn méi","abbr":"yssm","explanation":"仰首：仰起头来；伸眉：舒展眉头。形容意气昂扬的样子。","source":{"text":"乃欲仰首伸眉，论列是非，不亦轻朝廷羞当世之士耶？","book":"汉·司马迁《报任少卿书》"},"example":{"text":"我困囚系，死生毫厘，尚欲于中，～。","book":"宋·陈亮《祭郑景元提干文》"},"similar":["扬眉吐气"],"usage":"作谓语；用于书面语"},{"id":5728,"word":"价值连城","pinyin":"jià zhí lián chéng","abbr":"jzlc","explanation":"连城：连在一起的许多城池。形容物品十分贵重。","source":{"text":"赵惠文王时，得楚和氏璧。秦昭王闻之，使人遗赵王书，原以十五城请易璧。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"周先生，此乃府上之宝，～。","book":"清·钱彩《说岳全传》第十回"},"similar":["无价之宝","连城之价"],"opposite":["一钱不值","无足轻重"],"usage":"作谓语、定语、分句；形容物品十分贵重","story":["秦昭王得知赵惠王得到价值连城的和氏璧，想假装以15座城池与他交换来骗取它。赵惠王派蔺相如前去交易，秦王拿到和氏璧后而不谈城池交换事宜。蔺相如设计骗回和氏璧，并派人连夜将它送回赵国，秦王气得要杀死蔺相如"]},{"id":5729,"word":"价增一顾","pinyin":"jià zēng yī gù","abbr":"jzyg","explanation":"原意是卖不出去的好马，被伯乐看中了，就增加了十倍的价钱。比喻本来默默无闻，遇到赏识的人而抬高了身价。","source":{"text":"伯乐乃还而视之，去而顾之，一旦马价十倍。","book":"《战国策·燕策二》"}},{"id":5730,"word":"价廉物美","pinyin":"jià lián wù měi","abbr":"jlwm","explanation":"廉：便宜。东西价钱便宜，质量又好。","source":{"text":"苏州有个朋友写信来，要印一部书。久仰贵局的价廉物美，所以特来求教。","book":"清·吴趼人《近十年之怪现状》第十回"},"example":{"text":"福兴楼的清炖鱼翅，一元一大盘，～，现在不知增加了否？","book":"鲁迅《彷徨·祝福》"},"similar":["物有所值"],"usage":"作谓语、定语；指东西价钱便宜，质量又好"},{"id":5731,"word":"价等连城","pinyin":"jià děng lián chéng","abbr":"jdlc","explanation":"指价值等于连成一片的许多城池。","source":{"text":"今陛下赐刊一字，足以价等连城。","book":"《北史·彭城王勰传》"},"example":{"text":"他从地下挖掘出这～的宝物。"},"similar":["价值连城"],"opposite":["一钱不值"],"usage":"作谓语、定语、分句；形容物品十分贵重"},{"id":5732,"word":"价重连城","pinyin":"jià zhòng lián chéng","abbr":"jzlc","explanation":"价：价格；连城：连成一片的城池。形容物品极为珍贵，价值极高。","source":{"text":"也知价重连城璧，一纸万金犹不惜。","book":"唐·韦庄《乞彩笺歌》"},"example":{"text":"明·程登吉《幼学琼林》第三卷：“惠王之珠光能照乘；和氏之璧～。”"},"similar":["价值连城"],"opposite":["一钱不值"],"usage":"作谓语、定语、分句；形容物品十分贵重"},{"id":5733,"word":"任人唯亲","pinyin":"rèn rén wéi qīn","abbr":"rrwq","explanation":"任：任用；唯：只；亲：关系密切。指用人不问人的德才，只选跟自己关系亲密的人。","source":{"text":"过去张国焘的干部政策与此相反，实行‘任人唯亲’，拉拢私党，组织小派别。","book":"毛泽东《中国共产党在民族战争中的地位》"},"example":{"text":"人事上，也有些～的旧传统。","book":"徐铸成《风雨故人》"},"similar":["顺之者昌"],"opposite":["任人唯贤","举贤任能"],"usage":"作谓语、定语、宾语；指用人不当"},{"id":5734,"word":"任人唯贤","pinyin":"rèn rén wéi xián","abbr":"rrwx","explanation":"贤：有德有才的人。指用人只选有德有才的人。","source":{"text":"任官惟贤才，左右惟其人。","book":"《尚书·咸有一德》"},"example":{"text":"选拔干部应当是～。"},"similar":["量才录用","知人善用"],"opposite":["任人唯亲","以貌取人"],"usage":"作谓语、定语、宾语；指选拔人才","story":["春秋时期，齐襄公荒淫无道，两个公子跑到国外避难，齐国内乱，襄王被杀。管仲在公子纠的指使下阻拦公子小白回国。小白回国继位后，在鲍叔牙的推荐下，小白不计前仇，任人唯贤，任命曾有一箭之仇的管仲为相国治理齐国"]},{"id":5735,"word":"任人宰割","pinyin":"rèn rén zǎi gē","abbr":"rrzg","explanation":"宰：杀；割：切。听凭别人宰杀与欺辱，没有反抗的能力。","example":{"text":"落后就要挨打，只好～。"},"similar":["随人宰割"],"usage":"作谓语、定语、宾语；指无力反抗"},{"id":5736,"word":"任人摆布","pinyin":"rèn rén bǎi bù","abbr":"rrbb","explanation":"听凭别人操纵处置。","source":{"text":"糖葫芦装作不知，任他摆布。","book":"清·李宝嘉《官场现形记》第29回"},"example":{"text":"面对强大的势力，她只有～了。"},"similar":["听人穿鼻"],"usage":"作谓语、宾语、定语；指人的处境"},{"id":5737,"word":"任人摆弄","pinyin":"rèn rén bǎi nòng","abbr":"rrbn","explanation":"听凭别人操纵处置。","source":{"text":"其次是把非党干部、把群众看成任人摆弄的傀儡，必然脱离群众，引起群众的反对。","book":"邓小平《党与抗日民主政权》"},"similar":["任人摆布"],"usage":"作谓语、宾语、定语；指人的处境"},{"id":5738,"word":"任从风浪起，稳坐钓鱼船","pinyin":"rèn cóng fēng làng qǐ，wěn zuò diào yú chuán","abbr":"rcflqwzdyc","explanation":"比喻随便遇到什么险恶的情况，都信心十足，毫不动摇。同“任凭风浪起，稳坐钓鱼船”。","source":{"text":"中国有两句谚语：‘谁人背后无人说，那个人前不说人？’‘任从风浪起，稳坐钓鱼船。’","book":"刘少奇《论共产党员的休养》"},"similar":["任凭风浪起，稳坐钓鱼船"],"usage":"作宾语、定语、分句；用于处事"},{"id":5739,"word":"任其自便","pinyin":"rèn qí zì biàn","abbr":"rqzb","explanation":"自便：按自己的方便行动。任凭自己的意思行事。","source":{"text":"次日谭绍闻要去，众僧也不强留，任其自便。","book":"清·李绿园《歧路灯》第四十四回"},"example":{"text":"半个月以前，官军从河北强迫五百个百姓运粮食过河，结果被李自成的人马捉住，剁了右手，～。","book":"姚雪垠《李自成》第三卷五十二章"}},{"id":5740,"word":"任其自流","pinyin":"rèn qí zì liú","abbr":"rqzl","explanation":"指不加约束、引导，听任自由发展。","source":{"text":"故五谷得遂长。听其自流，待其自生，则鲧禹之功不立，而后稷之智不用。","book":"西汉·刘安《淮南子·修务训》"},"example":{"text":"有些党员放任党内某些缺点、错误和各种坏的现象不管，而～地发展。","book":"刘少奇《论共产党员的修养》"},"similar":["放任自流"],"usage":"作谓语、状语；指听任自由发展"},{"id":5741,"word":"任其自然","pinyin":"rèn qí zì rán","abbr":"rqzr","explanation":"任：听任；其：代词，他，它。听任人或事物自然发展。","source":{"text":"大要在固脏气之外，任其自然耳。","book":"宋·周密《齐东野语》卷七"},"example":{"text":"倘若有了开始，以后什么都可以～了。","book":"叶圣陶《归宿》"},"similar":["任其自流","放任自流"],"opposite":["循规蹈矩"],"usage":"作谓语；用于对事物或人的态度"},{"id":5742,"word":"任凭风浪起，稳坐钓鱼台","pinyin":"rèn píng fēng làng qǐ，wěn zuò diào yú tái","abbr":"rpflqwzdyt","explanation":"比喻随便遇到什么险恶的情况，都信心十足，毫不动摇。同“任凭风浪起，稳坐钓鱼船”。","source":{"text":"他如今是‘任凭风浪起，稳坐钓鱼台’，单等撒网下钩了。","book":"《人民文学》1976年第6期"},"example":{"text":"他如今是“～”，单等撒网下钩了"},"similar":["任凭风浪起，稳坐钓鱼船"],"usage":"作宾语、定语、分句；用于处事"},{"id":5743,"word":"任凭风浪起，稳坐钓鱼船","pinyin":"rèn píng fēng làng qǐ，wěn zuò diào yú chuán","abbr":"rpflqwzdyc","explanation":"比喻随便遇到什么险恶的情况，都信心十足，毫不动摇。","source":{"text":"我们有在不同革命时期经过考验的这样一套干部，就可以‘任凭风浪起，稳坐钓鱼船’。要有这个信心。","book":"毛泽东《在中国共产党第八届中央委员会第二次全体会议上的讲话》四"},"similar":["任凭风浪起，稳坐钓鱼台"],"usage":"作宾语、定语、分句；用于处事"},{"id":5744,"word":"任劳任怨","pinyin":"rèn láo rèn yuàn","abbr":"rlry","explanation":"任：担当，经受。不怕吃苦，也不怕招怨。","source":{"text":"诚不能以一躯称快万众，任天下之怨。","book":"汉·桓宽《盐铁论·刺权》：“夫食万人之力者，蒙其忧，任其怨劳。”《汉书·石显传》"},"example":{"text":"而杨嗣昌也完全执行他的主张，～。","book":"姚雪垠《李自成》第二卷第十九章"},"similar":["勤勤恳恳","任怨任劳"],"opposite":["怨天尤人"],"usage":"作谓语、定语、状语；指人的态度","story":["春秋时期，晋国相国赵盾想出走他国，赵穿知道后就率200卫兵把晋灵公杀了。太史在朝廷大事册上写“秋正月，赵盾在桃园谋害了国君夷皋。”赵盾叫太史改，太史不愿意。赵盾觉得大人物要任劳任怨，于是自我解嘲只有于心无愧就行"]},{"id":5745,"word":"任性妄为","pinyin":"rèn xìng wàng wéi","abbr":"rxww","explanation":"任性：放纵性情；妄：胡乱。凭着自己的性情胡乱作事。","source":{"text":"任性恣情，肆行暴虐。","book":"晋·戴逵《释能生存论》"},"example":{"text":"“发往极边，充当苦差，永不释回”，因为他“在山西巡抚任内纵容拳匪，戕害教士教民，～”之故。","book":"高阳《慈禧全传》八十七"}},{"id":5746,"word":"任性恣情","pinyin":"rèn xìng zì qíng","abbr":"rxzq","explanation":"任、恣：放纵。放纵自己的性情，一点约束都没有。","source":{"text":"任性恣情，肆行暴虐。","book":"晋·戴逵《释能生存论》"},"example":{"text":"近来仗着祖母溺爱，父母亦不能十分严紧拘管，更觉放荡弛纵，～，最不喜务正。","book":"清·曹雪芹《红楼梦》第十九回"}},{"id":5747,"word":"任怨任劳","pinyin":"rèn yuàn rèn láo","abbr":"ryrl","explanation":"任：担当，经受。不怕招怨，也不怕吃苦。同“任劳任怨”。","source":{"text":"诚不能以一躯称快万众，任天下之怨。","book":"汉·桓宽《盐铁论·刺权》：“夫食万人之力者，蒙其忧，任其怨劳。”《汉书·石显传》"},"example":{"text":"正是国家隆重之典，仕路清浊之源，非徒～，还要其难其慎。","book":"清·李渔《怜香伴·搜挟》"},"similar":["任劳任怨"],"opposite":["怨天尤人"],"usage":"作谓语、定语、状语；指人的态度"},{"id":5748,"word":"任情恣性","pinyin":"rèn qíng zì xìng","abbr":"rqzx","explanation":"任、恣：放任。放任自己的性情，不受任何拘束。","source":{"text":"书者，散也。欲书先散怀抱，任情恣性，然后书之；若迫于事，虽中山兔豪不能佳也。","book":"汉·蔡邕《笔论》"},"example":{"text":"近来仗着祖母溺爱，父母亦不能十分严紧拘管，更觉放纵弛荡，～，最不喜务正。","book":"清·曹雪芹《红楼梦》第十九回"}},{"id":5749,"word":"任所欲为","pinyin":"rèn suǒ yù wéi","abbr":"rsyw","explanation":"任：听凭；所欲为：想要做的。想干什么就干什么。","source":{"text":"又多是土棍青皮，平时鱼肉乡愚，无恶不作，到这时候有了护符，更是任所欲为的了。","book":"清·李宝嘉《官场现形记》第12回"},"example":{"text":"丧葬既毕，西太后处置国政独断独行，～。","book":"《慈禧太后演义》第17回"},"similar":["为所欲为"],"usage":"作谓语、宾语、状语；指随心所欲"},{"id":5750,"word":"任真自得","pinyin":"rèn zhēn zì dé","abbr":"rzzd","explanation":"任真：任其自然；自得：自己有所体会。凭任自己的体会。指写文章不受拘束，有自己的风格。","source":{"text":"潜少有高趣，博学善属文，颖脱不群，任真自得。","book":"南朝·梁·萧统《陶渊明传》"},"example":{"text":"博学善属文，颖脱不群，～，为乡邻之所贵。","book":"《晋书·陶潜传》"}},{"id":5751,"word":"任贤使能","pinyin":"rèn xián shǐ néng","abbr":"rxsn","explanation":"任用有德行有才能的人。","source":{"text":"舜、禹承安继治，任贤使能，恭己无为而天下治。","book":"《荀子·王制》：“欲立功名，则莫若尚贤使能矣。”汉·王充《论衡·自然》"},"example":{"text":"吴主浮江万艘，带甲百万，～，志存经略。","book":"明·罗贯中《三国演义》第八十二回"},"similar":["贤者在位，能者在职"],"usage":"作谓语、宾语、定语；指任用贤人"},{"id":5752,"word":"任贤受谏","pinyin":"rèn xián shòu jiàn","abbr":"rxsj","explanation":"贤：有德有才的人。任用有才德的人，接受劝谏。","source":{"text":"观自古帝王，在于忧危之间，则任贤受谏。及至安乐，必怀宽怠，言事者惟令兢惧，日陵月替，以至危亡。","book":"唐·吴兢《贞观政要·君道》"}},{"id":5753,"word":"任贤用能","pinyin":"rèn xián yòng néng","abbr":"rxyn","explanation":"任：任用；贤：德才兼备的人。任用有德行有才能的人。","source":{"text":"舜、禹承安继治，任贤使能，恭己无为而天下治。","book":"《荀子·王制》：“欲立功名，则莫若尚贤使能矣。”汉·王充《论衡·自然》"},"example":{"text":"刘季玉虽有益州之地，禀性暗弱，不能～。","book":"明·罗贯中《三国演义》第六十回"}},{"id":5754,"word":"任达不拘","pinyin":"rèn láo bù jū","abbr":"rdbj","explanation":"任性放纵，不受礼法拘束。","source":{"text":"咸任达不拘，与叔父籍为竹林之游，当世礼法者讥其所为。","book":"《晋书·阮咸传》"},"similar":["放荡不羁"],"usage":"作谓语、定语；指人豪放"},{"id":5755,"word":"任重才轻","pinyin":"rèn zhòng cái qīng","abbr":"rzcq","explanation":"责任重大，才能薄弱。表示力不胜任。常作谦词。","source":{"text":"任重才轻，故多阙漏。","book":"三国蜀·诸葛亮《与参军掾属教》"},"usage":"作宾语、定语；常作谦词"},{"id":5756,"word":"任重至远","pinyin":"rèn zhòng zhì yuǎn","abbr":"rzzy","explanation":"愿意指负载沉重而可以到达远方。后比喻抱负远大，能闯出新的天地，做出宏伟的业绩。","source":{"text":"服牛乘马，引重致远。","book":"《易·击辞下》"}},{"id":5757,"word":"任重致远","pinyin":"rèn zhòng zhì yuǎn","abbr":"rzzy","explanation":"指负载沉重而能到达远方。后比喻抱负远大，能闯出新的前景，做出宏伟的业绩。","source":{"text":"服牛乘马，引重致远。","book":"《周易·系辞下》"},"example":{"text":"大王要～，就得虚心自慝，多隐藏一些才是。","book":"曹禺《胆剑篇》第二幕"},"similar":["致远任重","引重致远"],"usage":"作谓语、定语；指有压力才会有动力"},{"id":5758,"word":"任重道悠","pinyin":"rèn zhòng dào yōu","abbr":"rzdy","explanation":"比喻责任重大，要经历长期的奋斗。同“任重道远”。","source":{"text":"任重道悠，利深祸速。","book":"《后汉书·皇后纪序》"},"example":{"text":"功大力薄，～，徒怀寸心，行将白首。","book":"宋·司马光《谢赐资治通鉴序表》"},"similar":["任重道远"],"opposite":["无所作为"],"usage":"作谓语、定语；指责任重大"},{"id":5759,"word":"任重道远","pinyin":"rèn zhòng dào yuǎn","abbr":"rzdy","explanation":"任：负担；道：路途。担子很重，路很远。比喻责任重大，要经历长期的奋斗。","source":{"text":"士不可以不弘毅，任重而道远。仁以为己任，不亦重乎？死而后已，不亦远乎？","book":"《论语·泰伯》"},"example":{"text":"人民教师肩负着培养祖国建设接班人的重担，～。"},"similar":["全力以赴","负重致远"],"opposite":["无所事事","无所作为","轻车熟路"],"usage":"作谓语、定语；指责任重大"},{"id":5760,"word":"仿徨失措","pinyin":"báng huáng shī cuò","abbr":"fhsc","explanation":"指心神不宁，举动失常。","example":{"text":"当他听到这个不利的消息后，显得～。"}},{"id":5761,"word":"企予望之","pinyin":"qǐ yú wàng zhī","abbr":"qywz","explanation":"企：踮起脚跟；予：相当于“而”，助词。踮起脚后跟向远处眺望。形容盼望心切。","source":{"text":"企予望之，步立踌躇。","book":"三国·魏·曹丕《秋胡行》"},"example":{"text":"持此与多士争衡，庶不为持衡者齿冷。秋风日劲，企予望之！","book":"清·文康《儿女英雄传》第三十四回"}},{"id":5762,"word":"企伫之心","pinyin":"qǐ zhù zhī xīn","abbr":"qzzx","explanation":"企伫：踮起脚跟而望。形容盼望心切。","source":{"text":"窃所独守，实怀鹤立企伫之心，敢复陈闻者，冀陛下倘发天聪而垂神听也。","book":"三国·魏·曹植《求通亲亲表》"}},{"id":5763,"word":"企者不立","pinyin":"qǐ zhě bù lì","abbr":"qzbl","explanation":"企：踮脚。踮脚而立的人难以久站。比喻不踏实工作的人站不住脚。","source":{"text":"企者不立，跨者不行。","book":"《道德经》第二十四章"}},{"id":5764,"word":"企而望归","pinyin":"qǐ ér wàng guī","abbr":"qewg","explanation":"企：踮起脚后跟。踮起脚后跟盼望归来。形容殷切地期望。","source":{"text":"吏卒皆山东之人，日夜企而望归。","book":"东汉·班固《汉书·高帝纪》"},"usage":"作谓语；指殷切盼望"},{"id":5765,"word":"企足矫首","pinyin":"qǐ zú jiǎo shǒu","abbr":"qzjs","explanation":"企：踮脚站着；矫：举起。踮起脚后跟，抬起头，比喻盼望等待之殷切。","source":{"text":"巍然被衮，号称天子，顾乃企足矫首待晋之予夺以为轻重，何其衰也。","book":"宋·吕祖谦《东莱博议》卷四"},"usage":"作定语、状语；用于书面语"},{"id":5766,"word":"企足而待","pinyin":"qǐ zú ér dài","abbr":"qzed","explanation":"抬起脚后跟来等着。比喻很快就能实现。","source":{"text":"巍然被衮，号称天子，顾乃企足矫首待晋之予夺以为轻重，何其衰也。","book":"宋·吕祖谦《东莱博议》卷四"},"example":{"text":"请～我们的捷报。"},"similar":["企踵可待"],"usage":"作谓语、定语；指即将成功"},{"id":5767,"word":"企踵可待","pinyin":"qǐ zhǒng kě dài","abbr":"qzkd","explanation":"比喻很快就可以等到。","source":{"text":"治平之期，企踵可待。","book":"宋·司马光《上皇帝疏》"},"example":{"text":"宋·司马光《上皇帝疏》：“治平之期，～。”"},"similar":["企足而待"],"usage":"作谓语、定语；指即将成功"},{"id":5768,"word":"伈伈睍睍","pinyin":"xǐn xǐn xiàn xiàn","abbr":"xxxx","explanation":"伈伈：小心恐惧的样子。睍睍：也作“伣伣”，眼睛不敢睁大的样子。小心害怕或低声下气的样子。","source":{"text":"及与议事，又唯诺惟谨，伈伈伣伣，若有所不敢，反不如一二俗吏足以任事。此陛下所为疑也，臣窃以为过矣。","book":"唐·韩愈《祭鳄鱼文》：“刺史虽驽弱，亦安肯为鳄鱼低首下心，伈伈睍睍，为民吏羞，以偷活于此耶?”《明史·邹智传》"},"example":{"text":"严复《论世变之亟》：“谓有人焉，～，低首下心，讲其事而咨其术，此非病狂无耻之民，不为是也。”"},"usage":"作谓语、定语、状语；用于处事"},{"id":5769,"word":"伉俪情深","pinyin":"kàng lì qíng shēn","abbr":"klqs","explanation":"伉俪：夫妻，配偶。夫妻之间的感情深厚。","source":{"text":"盖圣德仁厚，加以中宫前后同忧患者积年，伉俪情更加笃挚。","book":"明·沈得符《万历野获编》"},"example":{"text":"纵使你～，一时未忍，久后这中馈乏人，总不是事。","book":"清·吴趼人《二十年目睹之怪现状》第七十回"},"similar":["情深伉俪"],"usage":"作谓语、宾语；用于夫妻间"},{"id":5770,"word":"伉俪荣谐","pinyin":"kàng lì róng xié","abbr":"klrx","explanation":"伉俪：夫妻；谐：和，合。旧时用于祝人结婚。","source":{"text":"贺人娶妻，曰荣谐伉俪；留物与妻，曰归遗细君。","book":"清·程允升《幼学琼林·夫妇》"},"example":{"text":"鸳鸯谱订成佳耦，～到百年。"}},{"id":5771,"word":"伊于何底","pinyin":"yī yú hé dǐ","abbr":"yyhd","explanation":"伊：句首助词；于：到；胡：何，哪；底：尽头。到什么地步为止。表示事情不堪设想，到了不可收拾的地步。","source":{"text":"我视谋犹，伊于胡底？","book":"《诗经·小雅·小旻》"},"example":{"text":"彼也力绵，我也命薄，茫茫孽海，不知伊于何底矣。","book":"清·俞樾《右台仙馆笔记》卷三"}},{"id":5772,"word":"伊于胡底","pinyin":"yī yú hú dǐ","abbr":"yyhd","explanation":"伊：句首助词；于：到；胡：何，哪；底：尽头。到什么地步为止（对不好的现象表示感叹）。","source":{"text":"我视谋犹，伊于胡底？","book":"《诗经·小雅·小旻》"},"example":{"text":"那知这个杨右相，却一味大言欺君，全无定乱安邦之策，将来国家祸患，不知～。","book":"清·禇人获《隋唐演义》第八十九回"},"similar":["不堪设想","伊何底止"],"usage":"作谓语；指对不好的现象表示感叹"},{"id":5773,"word":"伊何底止","pinyin":"yī hé dǐ zhǐ","abbr":"yhdz","explanation":"不知将弄到什么地步为止，不堪设想的意思。同“伊于胡底”。","source":{"text":"起观斯世之忍心害理，几全如陈叔宝之无心肝。长此滔滔，伊何底止？","book":"鲁迅《〈朝花夕拾〉后记》"},"similar":["伊于胡底","不堪设想"],"usage":"作谓语、定语；指对不好的现象表示感叹"},{"id":5774,"word":"伏伏腊腊","pinyin":"fú fú là là","abbr":"ffll","explanation":"极其顺服的样子。","example":{"text":"他被母老虎收拾得～。"},"similar":["服服帖帖"],"usage":"作定语、状语；用于口语"},{"id":5775,"word":"伏低做小","pinyin":"fú dī zuò xiǎo","abbr":"fdzx","explanation":"处于低下卑微的地位。形容低声下气，巴结奉承。","source":{"text":"我又索含容折节，屈脊躬身，伏低做小，跪膝在尘埃。","book":"元·李文蔚《圯桥进履》第二折"},"example":{"text":"若召到蜀中，以部曲待之，刘备安肯～？若以客礼待之，又一国不容二主。","book":"明·罗贯中《三国演义》第六十回"},"similar":["做小伏低","巴结奉承"],"usage":"作谓语、定语；指甘愿处于低下的地位"},{"id":5776,"word":"伏地圣人","pinyin":"fú dì shèng rén","abbr":"fdsr","explanation":"指在某一方面略有知识就逞能的人。"},{"id":5777,"word":"伏处枥下","pinyin":"fú chǔ lì xià","abbr":"fclx","explanation":"枥：马房。象老马一样，一辈子都困守在马房里，见闻不广。","source":{"text":"若汝等伏处枥下，眼界不开，而将来仍不免一杀，何苦我之得开眼界而死者哉。","book":"清·吴趼人《俏皮话·鸡》"}},{"id":5778,"word":"伏尸流血","pinyin":"fú shī liú xuè","abbr":"fslx","explanation":"伏尸：横尸在地。指人死亡。形容杀人众多。","source":{"text":"古之人君一怒必伏尸流血，故圣王重行之。","book":"东汉·班固《汉书·主父偃传》"},"example":{"text":"天赐六年，天文多变，占者云当有逆臣～。","book":"《魏书·昭成子孙列传》"},"similar":["伏尸百万，流血千里"],"usage":"作谓语、定语；用于战争等"},{"id":5779,"word":"伏尸百万","pinyin":"fú shī bǎi wàn","abbr":"fsbw","explanation":"伏在地上的尸体有一百万。形容死伤惨重。","source":{"text":"天子之怒，伏尸百万，流血千里。","book":"《战国策·魏策四》"}},{"id":5780,"word":"伏尸百万，流血千里","pinyin":"fú shī bǎi wàn，liú xuè qiān lǐ","abbr":"fsbwlxql","explanation":"伏在地上的尸体有一百万，流出的血淌了一千里。形容死伤惨重。","source":{"text":"天子之怒，伏尸百万，流血千里。","book":"《战国策·魏策四》"},"example":{"text":"章炳麟《驳革命驳议》：“彼所以侈陈维新，讳言革命者，非谓革命之举，必～，大蹂大搏，以与凶顽争命。”"},"similar":["伏尸流血"],"usage":"作谓语、定语；用于战争等"},{"id":5781,"word":"伏法受诛","pinyin":"fú fǎ shòu zhū","abbr":"ffsz","explanation":"伏法：由于违法而受处死刑；诛：杀死。犯法被杀。","source":{"text":"假令仆伏法受诛，若九牛一毛，与蝼蚁何以异？","book":"汉·司马迁《报任少卿书》"},"usage":"作谓语、宾语；用于案件等"},{"id":5782,"word":"伏维尚飨","pinyin":"fú wéi shàng xiǎng","abbr":"fwsx","explanation":"旧时祭文中的套语。意思是恭敬地请你来吃。后用做死亡的戏谑说法。","source":{"text":"呜呼哀哉，伏维尚飨。","book":"唐·陈子昂《祭韦府君文》"},"example":{"text":"王禄多说了几句话，渐渐有声无气，挨到黄昏，只有出的气，没有入的气，呜呼哀哉，～。","book":"明·凌濛初《二刻拍案惊奇》卷二十一"},"usage":"作分句；用于死亡的讽刺说法"},{"id":5783,"word":"伏而咶天","pinyin":"fú ér shì tiān","abbr":"fest","explanation":"咶：以舌舔物。伏地以舌舔天。比喻所行与所求不一致，无法达到目的。","source":{"text":"辟之是犹伏而咶天，救经而引其足也。","book":"《荀子·仲尼》"},"similar":["恰得其反","背道而驰"],"usage":"作谓语；指无法达到目的"},{"id":5784,"word":"伏而唂天","pinyin":"fú ér shì tiān","abbr":"fest","explanation":"?阂陨嗵蛭铩７地以舌舔天。比喻所行与所求不一致，无法达到目的。","source":{"text":"辟之是犹伏而唂天，救经而引其足也。","book":"《荀子·仲尼》"}},{"id":5785,"word":"伏节死义","pinyin":"fú jié sǐ yì","abbr":"fjsy","explanation":"伏节：坚守节操而死；死义：为正义而死。为坚守节操和正义而死。","source":{"text":"好直谏，守节死义，难惑以非。","book":"《史记·汲郑列传》"}},{"id":5786,"word":"伏节死谊","pinyin":"fú jié sǐ yì","abbr":"fjsy","explanation":"伏节：坚守节操而死；死谊：为情谊而死。指坚守节操，致死不相负。","source":{"text":"今以四海之大，曾无伏节死谊之臣。","book":"《汉书·讲葛丰传》"}},{"id":5787,"word":"伏虎降龙","pinyin":"fú hǔ xiáng lóng","abbr":"fhxl","explanation":"伏：屈服；降：用用威力使屈服。用威力使猛虎和恶龙屈服。形容力量强大，能战胜一切敌人和困难。","source":{"text":"闻两虎交斗，咆响振岩，乃以锡杖中解，各散而去。","book":"南朝·梁·慧皎《梁高僧传》卷十：“能以秘咒咒下神龙。”唐·道宣《续高僧传·习禅一·僧稠》"},"example":{"text":"学师父～，跨鸾乘凤。","book":"元·马致远《任风子》第二折"},"similar":["降龙伏虎"],"usage":"作宾语、定语；指人本事大"},{"id":5788,"word":"伏阁受读","pinyin":"fú gé shòu dú","abbr":"fgsd","explanation":"形容恭敬受教。","source":{"text":"时《汉书》始出，多未能通者，同群马融，伏于阁下从昭受读。","book":"《后汉书·曹世叔妻传》"}},{"id":5789,"word":"伏首帖耳","pinyin":"fú shǒu tiē ěr","abbr":"fste","explanation":"伏：俯伏；帖：帖伏，顺从。低着头，耷拉着耳朵。形容卑躬屈膝非常驯服的样子。","source":{"text":"伏首帖耳，狗畏人貌。","book":"清·蒲松龄《聊斋志异·马介甫》：“万石不言，惟伏首贴耳而泣。”何垠注"},"similar":["俯首帖耳"],"usage":"作谓语、定语、状语；指非常驯服的样子"},{"id":5790,"word":"伏首贴耳","pinyin":"fú shǒu tiē ěr","abbr":"fste","explanation":"畏缩恐惧的样子。","source":{"text":"万石不言，惟伏首贴耳而泣。","book":"清·蒲松龄《聊斋志异·马介甫》"},"similar":["俯首帖耳"],"usage":"作谓语、定语、状语；指非常驯服的样子"},{"id":5791,"word":"伏鸾隐鹄","pinyin":"fú luán yǐn hú","abbr":"flyg","explanation":"伏鸾、隐鹄分别是三国时期魏国邓艾和陆云的别号。后泛指隐居的贤人。"},{"id":5792,"word":"伏龙凤雏","pinyin":"fú lóng fèng chú","abbr":"flfc","explanation":"伏龙：（卧龙）诸葛孔明。凤雏：庞士元。两人都是汉末三国时期著名的谋略家，军事家。后指隐而未现的有较高学问和能耐的人。","source":{"text":"《三国志·蜀志·诸葛亮传》裴松之注引《襄阳记》：“刘备访世事于司马德操。德操曰：‘儒生俗士，岂识时务？识时务者在乎俊杰。此间自有伏龙、凤雏。’备问为谁，曰：‘诸葛孔明、庞士元也。’"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“～，司马徽称孔明庞士元之奇。”"},"usage":"作宾语、定语；指能人","story":["三国时期，刘备向司马徽请教指点时局，司马徽向他推荐说，这里有伏龙、凤雏都是识时务的俊杰。刘备急切问他们的名字，司马徽告诉他伏龙就是南阳的诸葛亮，凤雏就是庞统。刘备于是三顾茅庐请来诸葛亮，后来又得到庞统的辅助"]},{"id":5793,"word":"伐冰之家","pinyin":"fá bīng zhī jiā","abbr":"fbzj","explanation":"伐冰，凿取冰塊。古代唯有卿大夫以上的贵族丧祭得以用冰，用以称达官贵族。","source":{"text":"卿大夫以上丧祭用冰。","book":"《礼记·大学》：“伐冰之家，不畜牛羊。”郑玄注"},"example":{"text":"珍羞百品，同～。","book":"《梁书·武帝纪上》"},"usage":"作宾语；指豪门贵族"},{"id":5794,"word":"伐功矜能","pinyin":"fá gōng jīn néng","abbr":"fgjn","explanation":"伐、矜：夸耀。指吹嘘自己的功劳和才能。形容居高自大，恃才傲物。","source":{"text":"奉法循礼之吏，不伐功矜能，百姓无称，亦无过行。","book":"西汉·司马迁《史记·太史公自序》"},"example":{"text":"齐王～，谋不逮下，废黜贤良，信任谄谀。","book":"《七国春秋平话》后集中卷"},"similar":["自吹自擂"],"usage":"作谓语、定语；指自我吹嘘"},{"id":5795,"word":"伐善攘羭","pinyin":"fā shàn ràng yú","abbr":"fsry","explanation":"伐善：夸耀自己的长处；攘羭：窃取肥美的绵羊。夸耀自己，掠人之美。","source":{"text":"取伐善以攘羭。","book":"唐·李商隐《为荥阳公桂州谢上表》"},"usage":"作谓语；用于处事"},{"id":5796,"word":"伐异党同","pinyin":"fá yì dǎng tóng","abbr":"fydt","explanation":"伐：讨伐，攻击。指结帮分派，偏向同伙，打击不同意见的人。","source":{"text":"自武帝以后，崇尚儒学，怀经协术，所在雾会。至有石渠分争之论，党同伐异之说。","book":"《后汉书·党锢传序》"},"example":{"text":"给事中李成名复劾焕～，焕遂称疾笃，坚不起。","book":"《明史·赵焕传》"},"similar":["党同伐异"],"usage":"作谓语、宾语、定语；同“党同伐异”"},{"id":5797,"word":"伐性之斧","pinyin":"fá xìng zhī fǔ","abbr":"fxzf","explanation":"伐：砍伐；性：性命，生机。砍毁人性的斧头。比喻危害身心的事物。","source":{"text":"靡曼皓齿，郑卫之音，务以自乐，命之曰伐性之斧。","book":"《吕氏春秋·本性》"},"example":{"text":"旧社会，烟馆赌局到处都是，在这些～下丧生的大有人在。"},"usage":"作宾语；比喻危害身心的事物"},{"id":5798,"word":"伐树削迹","pinyin":"fá shù xiāo jì","abbr":"fsxj","explanation":"比喻正人君子不为世所容。","source":{"text":"故伐树于宋，削迹于卫。","book":"《庄子·天运》"},"example":{"text":"某～，不齿于缙绅，固不容辄登一时贵人之门。","book":"宋·孙觌《与杨枢密》"}},{"id":5799,"word":"伐毛换髓","pinyin":"fá máo huàn suǐ","abbr":"fmhs","explanation":"削去旧的毛发，换去旧的骨髓。比喻彻底改变原来的面貌。","source":{"text":"你此去伐毛换髓，变姓逃形，我何处会得你着。","book":"明·梅鼎祚《昆仑奴》第四折"},"similar":["脱胎换骨","伐毛洗髓"],"usage":"作谓语、定语；指改变面貌"},{"id":5800,"word":"伐毛洗髓","pinyin":"fá máo xǐ suǐ","abbr":"fmxs","explanation":"刮去毛发，洗清骨髓。比喻彻底清除自身的污秽。","source":{"text":"吾却食吞气，已九千余年，目中童子，皆有青光，能见幽隐之物，三千年一返骨洗髓，二千年一剥皮伐毛，吾生来已三洗髓五伐毛矣。","book":"汉·郭宪《东方朔传》"},"example":{"text":"如要去掉他这劣根性，竟非大大的～，拿他重新做个人不成。","book":"《晚清文学丛钞·中国现在记》第三回"},"similar":["伐毛换髓","脱胎换骨","洗心革面"],"usage":"作谓语；指脱胎换骨"},{"id":5801,"word":"伐罪吊人","pinyin":"fá zuì diào rén","abbr":"fzdr","explanation":"讨伐有罪，拯救百姓。常用以作为发动战争的口号。“人”当作“民”，因避太宗讳改。同“伐罪吊民”。","source":{"text":"道济曰：‘伐罪吊人，正在今日。’皆释而遣之。","book":"《南史·檀道济传》"},"similar":["伐罪吊民"],"usage":"作谓语、宾语、定语；指锄强扶弱"},{"id":5802,"word":"伐罪吊民","pinyin":"fá zuì diào mín","abbr":"fzdm","explanation":"伐：讨伐。吊：慰问。讨伐有罪，拯救百姓。常用以作为发动战争的口号。","source":{"text":"伐罪吊民，正在今日。","book":"《宋书·檀道济传》"},"example":{"text":"及取宋，责其背约，名为～。","book":"元·刘祁《归潜志》第12卷"},"similar":["吊民伐罪","伐罪吊人"],"usage":"作谓语、宾语；指锄强扶弱"},{"id":5803,"word":"休休有容","pinyin":"xiū xiū yǒu róng","abbr":"xxyr","explanation":"形容君子宽容而有气量。","source":{"text":"其心休休焉，其如有容。","book":"《尚书·秦誓》"},"example":{"text":"此非～者不能也。","book":"明·李贽《大臣总论》"},"similar":["宽宏大量"],"usage":"作谓语、定语；用于书面语"},{"id":5804,"word":"休兵罢战","pinyin":"xiū bīng bà zhàn","abbr":"xbbz","explanation":"休、罢：停止。停止或结束战争。","source":{"text":"只不过休兵罢战还朝呵，是我暗暗地自思寻。","book":"元·孔文卿《东窗事犯》楔子"},"similar":["息兵罢战"],"usage":"作谓语、宾语、定语；指停战"},{"id":5805,"word":"休养生息","pinyin":"xiū yǎng shēng xī","abbr":"xysx","explanation":"休养：何处保养；生息：人口繁殖。指在战争或社会大动荡之后，减轻人民负担，安定生活，恢复元气。","source":{"text":"高宗中睿，休养生息。","book":"唐·韩愈《平淮西碑》"},"example":{"text":"许其修睦，因以罢兵，庶几～，各正性命，仰合于天心。","book":"清·毕沅《续资治通鉴·宋纪高宗绍兴十年》"},"similar":["安居乐业","养精蓄锐"],"opposite":["动荡不安","离乡背井","颠沛流离"],"usage":"作谓语、定语；用于战后等"},{"id":5806,"word":"休声美誉","pinyin":"xiū shēng měi yù","abbr":"xsmy","explanation":"休：美好。美好的声誉。","source":{"text":"陈留王协，圣德伟懋，规矩肃然；居丧哀戚，言不以邪；休声美誉，天下所闻；宜承洪业，为万世统。","book":"明·罗贯中《三国演义》第四回"},"usage":"作宾语、定语；指美好的声望名誉"},{"id":5807,"word":"休征嘉应","pinyin":"xiū zhēng jiā yìng","abbr":"xzjy","explanation":"吉利的征兆，美好的回报。","source":{"text":"观其文辞，方外百蛮，亡思不服；休征嘉应，颂声并作。","book":"《汉书·平帝纪赞》"},"usage":"作宾语、定语；用于书面语"},{"id":5808,"word":"休戚与共","pinyin":"xiū qī yǔ gòng","abbr":"xqyg","explanation":"忧喜、福祸彼此共同承担。形容关系密切，利害相同。","source":{"text":"吾与元规休戚是同，悠悠之谈，宜绝智者之口。","book":"《晋书·王导传》"},"example":{"text":"我们是～的好同学。"},"similar":["同甘共苦","同舟共济","风雨同舟"],"opposite":["不共戴天","无关痛痒","漠不相关"],"usage":"作谓语、定语；指关系密切"},{"id":5809,"word":"休戚共之","pinyin":"xiū qī gòng zhī","abbr":"xqgz","explanation":"忧喜、福祸彼此共同承担。形容关系密切，利害相同。","source":{"text":"且王与君侯，譬犹一体，同休等戚，祸福共之，愚为君侯，不宜计官号之高下，爵禄之多少为意也。","book":"《三国志·蜀志·费祎传》"},"example":{"text":"汝亲则同气，～，事不相涉，何烦致谢。","book":"《周书·齐炀王宪传》"}},{"id":5810,"word":"休戚是同","pinyin":"xiū qī shì tóng","abbr":"xqst","explanation":"休：喜庆；戚：忧愁。忧喜、福祸彼此相关联。形容关系密切，利害相关。","source":{"text":"晋国有忧，未尝不戚，有庆，未尝不怡。……为晋休戚，不背本也。","book":"《国语·周语下》"},"example":{"text":"今既盟之后，言归其好，分灾恤患，～。","book":"《魏书·许谦传》"},"similar":["休戚与共"],"usage":"作谓语、定语；指关系密切","story":["晋朝时期，庾亮因德高望重及善于用兵被派驻镇守边关，南蛮校尉陶称敌不过庾亮，就在当时权臣王导面前施用反间计，说庾亮拥兵自重准备举兵造反，要王导严加防范。王导说：“吾与元规休戚是同，悠悠之谈，宜绝智者之口。”"]},{"id":5811,"word":"休戚相关","pinyin":"xiū qī xiāng guān","abbr":"xqxg","explanation":"休：欢乐，吉庆；戚：悲哀，忧愁。忧喜、福祸彼此相关联。形容关系密切，利害相关。","source":{"text":"晋国有忧，未尝不戚，有庆，未尝不怡。……为晋休戚，不背本也。","book":"《国语·周语下》"},"example":{"text":"岂可委之荒野，任凭暴露，全无一点～之意。","book":"元·石君宝《曲江池》第四折"},"similar":["息息相关","唇齿相依"],"opposite":["漠不关心","无关痛痒"],"usage":"作谓语、定语；指关系密切","story":["春秋时期，晋厉公为了不让公子们争夺权利而惹是生非，把他们排挤到国外去。公子姬周到单襄公手下做大臣，对晋国的安危十分关心，同晋国共悲欢。单襄公认为他是与晋国休戚相关的人。晋厉公被杀后，姬周回国继位为晋悼公"]},{"id":5812,"word":"休明盛世","pinyin":"xiū míng shèng shì","abbr":"xmss","explanation":"休明：美好，清平；盛：兴旺；世：世代。美好清平的兴盛时代。","source":{"text":"当休明之盛世，托菲薄之陋质。","book":"晋·潘岳《西征赋》"},"similar":["太平盛世"],"usage":"作宾语、定语；同“太平盛世”"},{"id":5813,"word":"休牛归马","pinyin":"xiū niú guī mǎ","abbr":"xngm","explanation":"放归军用的牛马，表示停止战事。","source":{"text":"于是八荒无外，九服大同，四海为家，万里为宅。乃休牛散马，偃武修文。","book":"语出《书·武成》：“乃偃武修文，归马于华山之阳，放牛于桃林之野，示天下书弗服。”《隋书·薛道衡传》"},"example":{"text":"岂直～，但美于偃兵，保大定功，空歌于成德者哉！","book":"宋·卢多逊《新修周武王庙碑》"},"similar":["休牛放马"],"usage":"作谓语、宾语、定语；指停战"},{"id":5814,"word":"休牛放马","pinyin":"xiū niú fàng mǎ","abbr":"xnfm","explanation":"将牛马放牧，不再作军用。比喻天下太平，不再用兵。","source":{"text":"今丧乱即平，休牛牧马，烽燧灭影。","book":"《抱朴子·释滞》"},"similar":["休牛归马"],"usage":"作谓语、宾语、定语；指停战"},{"id":5815,"word":"休牛散马","pinyin":"xiū niú sàn mǎ","abbr":"xnsm","explanation":"放归军用的牛马，表示停止战事。","source":{"text":"于是八荒无外，九服大同，四海为家，万里为宅。乃休牛散马，偃武修文。","book":"唐·魏徵寿《隋书·薛道衡传》"},"similar":["休牛归马"],"usage":"作谓语、宾语、定语；指停战"},{"id":5816,"word":"众人周知","pinyin":"zhòng rén zhōu zhī","abbr":"zrzz","explanation":"周：普遍。大家普遍知道的。","source":{"text":"这是～的事情，难以掩饰。"},"example":{"text":"这是～的事情，难以掩饰"},"similar":["众所周知"],"usage":"作谓语、分句；用于书面语"},{"id":5817,"word":"众人国士","pinyin":"zhòng rén guó shì","abbr":"zrgs","explanation":"众人：普通人；国士：国中杰出的人物。指一般人和国中杰出的人才。","source":{"text":"臣事范中行氏，范中行氏以众人遇臣，臣故众人报之；知伯以国士遇臣，臣故国士报之。","book":"《战国策·赵策一》"},"example":{"text":"岂不闻豫让“～”之论乎？刘玄德待云长不过恩厚耳。","book":"明·罗贯中《三国演义》第二十五回"},"usage":"作宾语；指一般人和国中杰出的人才"},{"id":5818,"word":"众人察察","pinyin":"zhòng rén chá chá","abbr":"zrcc","explanation":"察察：清楚明辨。众人都很明白。","source":{"text":"众人察察，我独闷闷。","book":"《老子》第二十章"}},{"id":5819,"word":"众人广坐","pinyin":"zhòng rén guǎng zuò","abbr":"zrgz","explanation":"犹大庭广众。人多而公开的场合。","source":{"text":"嬴乃夷门抱关者也，而公子亲枉车骑，自迎嬴于众人广坐之中，不宜有所过。","book":"《史记·魏公子列传》"},"example":{"text":"在～中居然还有如此事情"},"similar":["大庭广众"],"usage":"作宾语、定语；指公共场合"},{"id":5820,"word":"众人役役","pinyin":"zhòng rén yì yì","abbr":"zryy","explanation":"役役：劳作不息。普通人都辛勤劳动不息。","source":{"text":"众人役役，圣人愚芚。","book":"《庄子·齐物论》"},"example":{"text":"～，因善价而沽诸。（唐·朱遵度《栖贤寺碑》）"}},{"id":5821,"word":"众人拾柴火焰高","pinyin":"zhòng rén shí chái huǒ yàn gāo","abbr":"zrschyg","explanation":"比喻人多力量大。","example":{"text":"～，我们齐心协力吧。"},"similar":["人多势众"],"usage":"作宾语、分句、定语；指人多力量大"},{"id":5822,"word":"众人摸象","pinyin":"zhòng rén mō xiàng","abbr":"zrmx","explanation":"比喻对事物只凭片面的了解或局部的经验，就乱加猜测，想做出全面的判断。","source":{"text":"其触牙者即言象形如芦菔根，其触耳者言象如箕，其触头者言象如石，其触鼻者言象如杵，其触脚者言象如木臼，其触脊者言象如床，其触腹者言象如甕，其触尾者言象如绳。","book":"《大般涅槃经》三二"},"example":{"text":"～，各执己见"},"similar":["众盲摸象","盲人摸象"],"usage":"作宾语、定语、分句；指看问题以偏概全"},{"id":5823,"word":"众人昭昭","pinyin":"zhòng rén zhāo zhāo","abbr":"zrzz","explanation":"昭昭：明显。众人对某事非常清楚。","source":{"text":"众人昭昭，我独昏昏。","book":"《老子》第二十章"}},{"id":5824,"word":"众人重利","pinyin":"zhòng rén zhòng lì","abbr":"zrzl","explanation":"众人：普通人。普通人看重利益。","source":{"text":"众人重利，廉士重名，贤士尚志，圣人贵精。","book":"《庄子·刻意》"},"example":{"text":"众人以毁形为耻，君子以毁义为辱；～，廉士重名。（汉·刘向《说苑·谈丛》）"}},{"id":5825,"word":"众功皆兴","pinyin":"zhòng gōng jiē xīng","abbr":"zgjx","explanation":"众：多。许许多多行业都兴盛起来。","source":{"text":"信饬百官，众功皆兴。","book":"《史记·五帝本纪》"},"usage":"作宾语、定语；用于书面语"},{"id":5826,"word":"众叛亲离","pinyin":"zhòng pàn qīn lí","abbr":"zpql","explanation":"叛：背叛；离：离开。众人反对，亲人背离。形容完全孤立。","source":{"text":"阻兵无众，安忍无亲，众叛亲离，难以济矣。","book":"《左传·隐公四年》"},"example":{"text":"他坚持与人民为敌，以至～，死无葬身之地。"},"similar":["土崩瓦解","孤家寡人","分崩离析"],"opposite":["团结一致","同舟共济","和衷共济"],"usage":"作谓语、定语、宾语；指不得人心","story":["春秋时期，卫国公子州吁杀死他的哥哥卫桓公篡位，对内残暴统治，对外穷兵黩武。鲁隐公问大臣对公子州吁的看法，众仲认为公子州吁残暴狠毒，失去亲信的拥护，众叛亲离必定失败。后果然让石儒设计让陈国陈桓公除掉了州吁"]},{"id":5827,"word":"众口一词","pinyin":"zhòng kǒu yī cí","abbr":"zkyc","explanation":"所有的人都说同样的话。","source":{"text":"众口一辞（词），纷然不正。","book":"宋·欧阳修《论议濮安懿王典礼札子》"},"example":{"text":"适才仇老所言姻事，～，此美事也，有何不可？","book":"明·凌濛初《初刻拍案惊奇》卷二十四"},"similar":["异口同声"],"opposite":["众说纷纭","言人人殊","莫衷一是"],"usage":"作谓语、状语；指说法一致"},{"id":5828,"word":"众口一辞","pinyin":"zhòng kǒu yī cí","abbr":"zkyc","explanation":"辞：言词。许多人所说的话都一样。形容意见一致","source":{"text":"众口一辞，纷然不止。","book":"宋·欧阳修《濮仪》第四卷"},"example":{"text":"夏衍《读杂谈历史剧》：“田汉同志的《关汉卿》是一出好戏，思想性和艺术性都很强烈，这一点几乎是～。”"},"similar":["众口一词","众口同声","众口如一"],"usage":"作谓语、定语、状语；用于处事"},{"id":5829,"word":"众口之辩","pinyin":"zhòng kǒu zhī biàn","abbr":"zkzb","explanation":"比喻各学派间的辩论","source":{"text":"公孙龙问于魏牟曰：‘龙少学先王之道，长而明仁义之行，合同异，杂坚白，然不然，可不可，因百家之知，穷众口之辩，吾自以为至达已。’","book":"战国·宋·庄周《庄子·秋水》"},"usage":"作宾语；用于书面语"},{"id":5830,"word":"众口交传","pinyin":"zhòng kǒu jiāo chuán","abbr":"zkjc","explanation":"众人辗转述说。","source":{"text":"就是不幸受伤身死，众口交传，全国哀痛，还要铸几个铜像，立几个石碑，万古流芳，永垂不朽。","book":"清·陈天华《警世钟》"},"similar":["众口相传"],"usage":"作谓语、定语；用于书面语"},{"id":5831,"word":"众口交攻","pinyin":"zhòng kǒu jiāo gōng","abbr":"zkjg","explanation":"许多人一齐谴责。","source":{"text":"言陛下召应熊，必因其秉国之日，众口交攻，以为孤立无党，孰知其同年密契，肺腑深联。","book":"《明史·王应熊传》"},"usage":"作宾语、定语；用于书面语"},{"id":5832,"word":"众口交荐","pinyin":"zhòng kǒu jiāo jiàn","abbr":"zkjj","explanation":"许多人一致推荐。","source":{"text":"玄宗见众口交荐李白之才，便传旨赐李白五品冠带朝见。","book":"清·褚人获《隋唐演义》第八十二回"},"usage":"作谓语、定语；用于书面语"},{"id":5833,"word":"众口交詈","pinyin":"zhòng kǒu jiāo lì","abbr":"zkjl","explanation":"众人一致责骂。","source":{"text":"牛督拥兵护逃，众口交詈。","book":"清·夏燮《中西纪事·海疆殉难记上》"},"opposite":["众口交赞"],"usage":"作谓语、定语；用于处事"},{"id":5834,"word":"众口交赞","pinyin":"zhòng kǒu jiāo zàn","abbr":"zkjz","explanation":"众人交相赞美。","source":{"text":"列公，你看只一个长姐儿，也会闹得这等千里逢迎，众口交赞，可见‘声气’这途也不可不走的。","book":"清·文康《儿女英雄传》第三十九回"},"similar":["交口称赞"],"opposite":["众口交詈"],"usage":"作谓语、定语；用于处事"},{"id":5835,"word":"众口同声","pinyin":"zhòng kǒu tóng shēng","abbr":"zkts","explanation":"大家所说的都一样。","source":{"text":"上既难抗君命，下又重违诸媳，中复朝绅满座，众中同声。","book":"清·夏敬渠《野叟曝言》第一百十八回"},"example":{"text":"大家～地称赞她献身于教育事业的精神。"},"similar":["异口同声"],"opposite":["众说纷纭"],"usage":"作谓语、状语；指大家说得都一样"},{"id":5836,"word":"众口嗷嗷","pinyin":"zhòng kǒu áo áo","abbr":"zkaa","explanation":"嗷嗷：哀号声。形容人们因饥饿而嗷嗷哀号。","source":{"text":"说什么贫不忧愁富不骄，赤紧的众口嗷嗷。","book":"元·秦简夫《赵礼让肥》第二折"},"usage":"作谓语、定语；用于书面语"},{"id":5837,"word":"众口嚣嚣","pinyin":"zhòng kǒu xiāo xiāo","abbr":"zkxx","explanation":"嚣嚣：吵闹，喧哗。许多人都在七嘴八舌地说话，十分吵闹。","source":{"text":"从之，则县官用废，虚言不可实而行之；不从，文学以","book":"汉·桓宽《盐铁论·遵道》"},"example":{"text":"游于乡之校，～。（唐·韩愈《子产不毁乡校颂》）"},"usage":"作谓语、状语；用于书面语"},{"id":5838,"word":"众口如一","pinyin":"zhòng kǒu rú yī","abbr":"zkry","explanation":"许多人都说同样的话，看法或意见一致。同“众口一辞”。","source":{"text":"而谓科臣但当内擢，其最不肖者间出一二人于外，则众口如一。","book":"明·沈德符《野获编·吏部一·都给事升转》"},"similar":["众口一词","众口一辞","众口同声"],"opposite":["众口纷纭"],"usage":"作谓语、状语；指说法一致"},{"id":5839,"word":"众口捧月","pinyin":"zhòng kǒu pěng yuè","abbr":"zkpy","explanation":"大家共同捧举月亮。比喻共同拥戴一个人。"},{"id":5840,"word":"众口烁金","pinyin":"zhòng kǒu shuò jīn","abbr":"zksj","explanation":"形容舆论力量大，连金属都能熔化。比喻谣言多可以混淆是非","source":{"text":"众口烁金，积毁销骨。","book":"汉·荀悦《汉纪·景帝纪》"},"similar":["众口铄金","众口销金","众口销铄"],"usage":"作谓语、定语；用于书面语"},{"id":5841,"word":"众口熏天","pinyin":"zhòng kǒu xūn tiān","abbr":"zkxt","explanation":"指群言可以动天。比喻舆论力量大。","source":{"text":"毁誉成党，众口熏天。","book":"《吕氏春秋·离谓》"},"usage":"作宾语、定语；用于书面语"},{"id":5842,"word":"众口相传","pinyin":"zhòng kǒu xiāng chuán","abbr":"zkxc","explanation":"众人辗转述说。见“众口交传”。","source":{"text":"礼部的调查毫无结果，于是只能回奏：当时众口相传，首先讹传者无法查明。","book":"黄仁宇《万历十五年》"},"similar":["众口交传"],"usage":"作谓语、定语；用于书面语"},{"id":5843,"word":"众口纷纭","pinyin":"zhòng kǒu fēn yún","abbr":"zkfy","explanation":"纷纭：多而姑乱。人多嘴杂，议论纷纷。","source":{"text":"然当纯公既没，众说纷纭，卒能坚忍植立。","book":"元·戴表元《剡源集·跋濂溪二程谥议》"},"example":{"text":"君无二心，妾岂不知？但～，恐不免秋扇之捐。","book":"清·蒲松龄《聊斋志异·阿纤》"},"similar":["众说纷纭","人多嘴杂"],"opposite":["众口一词","异口同声"],"usage":"作谓语、状语；指人多嘴杂"},{"id":5844,"word":"众口铄金","pinyin":"zhòng kǒu shuò jīn","abbr":"zksj","explanation":"铄：熔化。形容舆论力量大，连金属都能熔化。比喻众口一词可以混淆是非。","source":{"text":"众心成城，众口铄金。","book":"《国语·周语下》"},"example":{"text":"群言淆乱，异说争鸣；～，积非成是。","book":"鲁迅《三闲集·述香港恭祝圣诞》"},"similar":["积毁销骨","人言可畏"],"usage":"作谓语、分句；常与“积毁销骨”连用"},{"id":5845,"word":"众口铄金，积毁销骨","pinyin":"zhòng kǒu shuò jīn，jī huǐ xiāo gǔ","abbr":"zksjjhxg","explanation":"铄金：熔化金属；积毁：积累的毁谤；销骨：熔化骨头。众人的言论能够熔化金属，纷纷而来的毁谤足以致人于死地。比喻舆论力量的强大","source":{"text":"积羽沉舟，群轻折轴，众口铄金，积毁销骨。","book":"西汉·司马迁《史记·张仪列传》"},"example":{"text":"唐弢《硝忆》：“中国有句成语，叫做‘～’，一次一次的造谣毁谤，也可以将真理埋没。”"},"similar":["众口铄金","积毁销骨"],"usage":"作宾语、定语；用于书面语"},{"id":5846,"word":"众口销金","pinyin":"zhòng kǒu xiāo jīn","abbr":"zkxj","explanation":"众人的言论能够熔化金属。比喻舆论影响的强大。亦喻众口同声可混淆视听。见“众口铄金”。","source":{"text":"众口销金，愆言不验。","book":"汉·焦赣《易林·萃之巽》"},"similar":["众口铄金","众口烁金"],"usage":"作宾语、定语；用于书面语"},{"id":5847,"word":"众口销铄","pinyin":"zhòng kǒu xiāo shuò","abbr":"zkxs","explanation":"铄：熔化。形容舆论力量大，连金属都能熔化。比喻众口一词可以混淆是非。","source":{"text":"盖身後立节，当无诡随，其应诠拣不精，玉石相混，致令众口销铄，为知音所痛。","book":"唐·殷璠《河岳英灵集序》"},"example":{"text":"这是～的事，我已经习以为常了"},"similar":["众口铄金，积毁销骨"],"usage":"作谓语、定语；用于书面语"},{"id":5848,"word":"众口难调","pinyin":"zhòng kǒu nán tiáo","abbr":"zknt","explanation":"调：协调。原意是各人的口味不同，很难做出一种饭菜使所有的人都感到好吃。比喻做事很难让所有的人都满意。","source":{"text":"补仲山之衮，虽曲尽于巧心；和傅说之羹，实难调于众口。","book":"宋·欧阳修《归田录》卷一"},"example":{"text":"臣非纵子不忠，奈～。","book":"明·许仲琳《封神演义》第三十三回"},"similar":["莫衷一是","见仁见智"],"opposite":["一模一样","毫无二致","如出一辙"],"usage":"作谓语、定语、分句；形容很难满足众人"},{"id":5849,"word":"众品交荐","pinyin":"zhòng kǒu jiāo jiàn","abbr":"zpjj","explanation":"许多人一致推荐。","source":{"text":"玄宗见众口交荐李白之才，便传旨赐李白五品冠带朝见。","book":"清·褚人获《隋唐演义》第八十二回"}},{"id":5850,"word":"众啄同音","pinyin":"zhòng zhòu tóng yīn","abbr":"zzty","explanation":"犹众口一词。所有的人都说同样的话。","source":{"text":"和会方开，公论犹在。青岛归我，众啄同音。","book":"《“五四”爱国运动资料·上海罢市救亡史》"},"similar":["众口同声","众口一辞"],"usage":"作宾语、定语；用于书面语"},{"id":5851,"word":"众喣山动","pinyin":"zhòng xǔ shān dòng","abbr":"zxsd","explanation":"众人吹气，可以移山。比喻人多力量大。同“众喣漂山”。","source":{"text":"役未及兴，而众喣山动。","book":"明·李东阳《余肃敏公传》"},"similar":["众喣飘山","众喣漂山"],"usage":"作宾语、定语；用于比喻句"},{"id":5852,"word":"众喣漂山","pinyin":"zhòng xǔ piāo shān","abbr":"zxps","explanation":"喣：吹气。许多人吹气，能使山漂走。比喻说坏话的人多了，能使人受到很大的损害。也比喻人多力量大。","source":{"text":"夫众喣漂山，聚蚊成雷。","book":"《汉书·中山靖王胜传》"},"example":{"text":"～不易安，势张那复抚狂澜。","book":"元·王恽《秋涧全集·哀挽亡友中丞王兄五首》"},"similar":["众喣飘山","众喣山动"],"usage":"作宾语、定语；用于比喻句"},{"id":5853,"word":"众喣飘山","pinyin":"zhòng xǔ piāo shān","abbr":"zxps","explanation":"众人吹气，可以移山。比喻人多力量大。同“众喣漂山”。","source":{"text":"众喣飘山，聚蚊成雷，盖骄佚所从生也。","book":"《后汉书·第五伦传》"},"similar":["众喣漂山","众喣山动"],"usage":"作宾语、定语；用于比喻句"},{"id":5854,"word":"众多非一","pinyin":"zhòng duō fēi yī","abbr":"zdfy","explanation":"指类别甚多，不止一种。","source":{"text":"孔子道美，故譬以宗庙，众多非一，故喻以百官。","book":"汉·王充《论衡·别通》"}},{"id":5855,"word":"众好众恶","pinyin":"zhòng hào zhòng wù","abbr":"zhzw","explanation":"众人喜爱或众人厌恶。","source":{"text":"子曰：‘众恶之，必察焉；众好之，必察焉。’","book":"《论语·卫灵公》"},"usage":"作宾语、定语；用于书面语"},{"id":5856,"word":"众好必察","pinyin":"zhòng hào bì chá","abbr":"zhbc","explanation":"好：喜爱；察：调查。大家都喜欢的未必就好，必须要调查后才能下结论。","source":{"text":"众恶之，必察焉；众好焉，必察焉。","book":"《论语·卫灵公》"},"usage":"作宾语、定语；用于处事"},{"id":5857,"word":"众妙之门","pinyin":"zhòng miào zhī mén","abbr":"zmzm","explanation":"众：一切；妙：玄妙。通向一切奥妙的大门。","source":{"text":"玄之又玄，众妙之门。","book":"《老子》第一章"}},{"id":5858,"word":"众寡不敌","pinyin":"zhòng guǎ bù dí","abbr":"zgbd","explanation":"众：多；寡：少；敌：抵挡。少数敌不过多数。","source":{"text":"众寡不敌，三战三北。","book":"唐·孙揆《灵应传》"},"example":{"text":"群众是浮躁，急不可待的。忍耐不过，～，自难免日久变生，越发不可收拾。","book":"鲁迅《两地书·二一》"},"similar":["众寡悬殊","寡不敌众"],"opposite":["势均力敌","旗鼓相当","棋逢对手"],"usage":"作谓语、定语；指力量悬殊"},{"id":5859,"word":"众寡势殊","pinyin":"zhòng guǎ shì shū","abbr":"zgss","explanation":"众：多；寡：少。形容双方人力的多少相差极大。","source":{"text":"襄阳失守，边情沮丧，加众寡势殊，以至陷没。","book":"晋·桓冲《上言吉挹忠节》"},"similar":["众寡悬殊","众寡悬绝"],"usage":"作谓语、宾语、定语；指差距很大"},{"id":5860,"word":"众寡悬殊","pinyin":"zhòng guǎ xuán shū","abbr":"zgxs","explanation":"众：多；寡：少；悬：表示极端的程度。形容双方人力的多少相差极大。","source":{"text":"每恨众寡悬殊，未能灭贼。","book":"晋·桓冲《上言吉挹忠节》：“襄阳失守，边情沮丧，加众寡势殊，以至陷没。” 《隋书·杨善会传》"},"example":{"text":"琼华不能再笑了，在～的形势下，她有些可怜这位被呼为“遗产”的少年了。","book":"茅盾《一个女性》"},"similar":["寡不敌众","众寡不敌","大相径庭"],"opposite":["势均力敌","旗鼓相当","半斤八两"],"usage":"作谓语、宾语、定语、分句；指差距很大"},{"id":5861,"word":"众寡悬绝","pinyin":"zhòng guǎ xuán jué","abbr":"zgxj","explanation":"双方人力多少相差极大。","source":{"text":"布打城既克复，奥俄军奋战益力，众寡悬绝……此匈加利千钧一发之时也。","book":"梁启超《匈加利爱国者噶苏士传》第十节"},"similar":["众寡势殊","众寡悬殊"],"usage":"作谓语、宾语、定语；指差距很大"},{"id":5862,"word":"众寡莫敌","pinyin":"zhòng guǎ mò dí","abbr":"zgmd","explanation":"众：多；寡：少；敌：抵挡。少数敌不过多数。","source":{"text":"其势不分，众寡莫敌。","book":"《三国志·魏志·郭淮传》：“诸将议众寡不敌，备便乘胜，欲依水为阵以拒之。”《周书·李贤传》"},"example":{"text":"欲奋勇行师，～；欲收军还国，事属嫌疑。（明·许仲琳《封神演义》第五十六回）"},"similar":["众寡不敌","众寡难敌","众少不敌"],"usage":"作谓语、定语；指力量悬殊"},{"id":5863,"word":"众寡难敌","pinyin":"zhòng guǎ nán dí","abbr":"zgnd","explanation":"众：多；寡：少；敌：抵挡。少数敌不过多数。形容彼此力量悬殊，难以匹敌。","source":{"text":"诸将议众寡不敌，备便乘胜，欲依水为阵以拒之。","book":"《三国志·魏志·郭淮传》"},"example":{"text":"已曾选下精兵八千，远渡江东，诚恐～，为此又行出榜。（明·沈采《千金记》第七出）"},"similar":["众寡不敌","众少不敌","众寡莫敌"],"usage":"作谓语、定语；指力量悬殊"},{"id":5864,"word":"众少不敌","pinyin":"zhòng shǎo bù dí","abbr":"zsbd","explanation":"众：多；敌：抵挡。少数敌不过多数。","source":{"text":"时汝南葛陂贼万馀人攻褚壁，褚众少不敌，力战疲极。","book":"《三国志·魏志·许褚传》"},"example":{"text":"其后，胡贼寇境，大亮～，遂单马诣贼营，召其豪帅，谕以祸福，群胡感悟，相率请降。（《旧唐书·李大亮传》）"},"similar":["众寡不敌","众寡难敌","众寡莫敌"],"usage":"作谓语、定语；指力量悬殊"},{"id":5865,"word":"众少成多","pinyin":"zhòng shǎo chéng duō","abbr":"zscd","explanation":"犹积少成多。指只要不断积累，就会从少变多。","source":{"text":"众少成多，积小致钜。","book":"《汉书·董仲舒传》"},"usage":"作宾语、定语；用于书面语"},{"id":5866,"word":"众川赴海","pinyin":"zhòng chuān fù hǎi","abbr":"zcfh","explanation":"众多的河流都奔赴大海。比喻众多的力量汇集在一起。","source":{"text":"天覆地载，成以四时。惟皇是则，比大于兹。群星拱极，众川赴海。万宇骏奔, 一朝咸在。","book":"《隋书·音乐志中》"},"similar":["众流归海"],"usage":"作宾语、定语；多用于比喻句"},{"id":5867,"word":"众建贤才","pinyin":"zhōng jiàn xián cái","abbr":"zjxc","explanation":"建：建树。多多地选用优秀人才。","source":{"text":"盖夫天下之大器也，非大明法度，不足以维持，非众建贤才，不足以保守。","book":"宋·王安石《上时政疏》"},"usage":"作宾语、定语；用于书面语"},{"id":5868,"word":"众心不安","pinyin":"zhòng xīn bù ān","abbr":"zxba","explanation":"指民心不安","source":{"text":"京房《易传》曰：‘众心不安，君政厥妖，豕入居室。’","book":"东汉·班固《汉书·五行志》"},"usage":"作定语、状语；用于书面语"},{"id":5869,"word":"众心如城","pinyin":"zhòng xīn rú chéng","abbr":"zxrc","explanation":"万众一心，象坚固的城墙一样不可摧毁。比喻团结一致，力量无比强大。","source":{"text":"众心成城，众口铄金。","book":"《国语·周语下》"},"example":{"text":"弘誓既远，昏疑皆破，故～，施者成市。","book":"唐·独孤及《洪州大云寺钟铭》"}},{"id":5870,"word":"众心归附","pinyin":"zhòng xīn guī fù","abbr":"zxgf","explanation":"归：归附，趋向。众人所期望和敬仰的。形容在群众中威望很高","source":{"text":"随世宗征伐，屡建大功，众心归附。","book":"明·无名氏《杨家将演义》第一卷"},"similar":["众望有归","众望所归","众望攸归"],"usage":"作谓语、定语；用于书面语"},{"id":5871,"word":"众心成城","pinyin":"zhòng xīn chéng chéng","abbr":"zxcc","explanation":"指万众一心，如坚固城堡。比喻众人团结一致，力量无比强大。","source":{"text":"众心所好，莫之能败，其固如城也。","book":"《国语·周语下》：“众心成城，众口铄金。”韦昭注"},"example":{"text":"～，俗说曰：众人同心者，可共筑起一城，同心共饮，雒阳酒可尽也。","book":"《艺文类聚》卷六三引汉·应劭《风俗通》"},"similar":["众志成城"],"usage":"作谓语、定语；指万众一心"},{"id":5872,"word":"众志成城","pinyin":"zhòng zhì chéng chéng","abbr":"zzcc","explanation":"万众一心，象坚固的城墙一样不可摧毁。比喻团结一致，力量无比强大。","source":{"text":"众心成城，众口铄金。","book":"《国语·周语下》"},"example":{"text":"段祺瑞既得国务员同情，便以为～，正可一战。","book":"蔡东藩、许廑父《民国通俗演义》第八十八回"},"similar":["众擎易举","万众一心","戮力同心"],"opposite":["一盘散沙","四分五裂","同床异梦"],"usage":"作谓语、定语；指万众一心","story":["春秋末年，周景王突然废止小钱而造大钱，搜刮百姓的财产，他把从民间搜刮来的铜铸成大钟，大臣都反对，司乐官州鸠也不能劝阻他。一年后大钟造成，拍马的人都说声音好听，州鸠认为要天下百姓拥护才行，告诫说众心成城，众口铄金"]},{"id":5873,"word":"众怒如水火","pinyin":"zhòng nù rú shuǐ huǒ","abbr":"znrsh","explanation":"众人的愤怒如同水火一样无情。形容百姓的意愿不可冒犯。","source":{"text":"众怒如水火焉，不可为谋。","book":"《左传·昭公十三年》"},"example":{"text":"君蚤自图，无取辱焉。～，不可救也。（《史记·楚世家》）"},"usage":"作宾语、定语；用于比喻句"},{"id":5874,"word":"众怒难任","pinyin":"zhòng nù nán rèn","abbr":"znnr","explanation":"指众人的愤怒难以抵当。","source":{"text":"众怒难任，蓄怨终泄。","book":"唐·陆贽《奉天请罢琼林大盈二库状》"},"similar":["众怒难犯"],"usage":"作宾语、定语；同“众怒难犯”"},{"id":5875,"word":"众怒难犯","pinyin":"zhòng nù nán fàn","abbr":"znnf","explanation":"犯：触犯、冒犯。群众的愤怒不可触犯。表示不可以做群众不满意的事情。","source":{"text":"众怒难犯，专欲难成，合二难以安国，危之道也。","book":"《左传·襄公十年》"},"example":{"text":"你们来意甚善，只是～，赶快去吧。","book":"清·刘鹗《老残游记》第一回"},"similar":["众怒难任"],"usage":"作宾语、定语；表示不可以做群众不满意的事","story":["春秋时期，郑国发生叛乱，大夫尉止杀死大夫子驷，子孔与子产一起平定叛乱，杀死尉止。子孔掌权后，制作盟书，规定官员各守其位，听从他的命令。子产劝阻他，希望他不要犯了众怒，否则国家就不会安宁。子孔当众烧掉盟书"]},{"id":5876,"word":"众怒难犯，专欲难成","pinyin":"zhòng nù nán fàn，zhuān yù nán chéng","abbr":"znnfzync","explanation":"专欲：一个人的欲望，众人的债怒不可触犯，一人的欲望难于实现。指不能违背多数人的意愿","source":{"text":"众怒难犯，专欲难成，合二难以安国，危之道也。","book":"春秋·鲁·左丘明《左传·襄公十年》"},"similar":["众怒难犯"],"usage":"作宾语、定语；用于书面语"},{"id":5877,"word":"众怨之的","pinyin":"zhòng yuàn zhī dì","abbr":"zyzd","explanation":"众人怨恨的目标。","source":{"text":"可见得我们就这大关的事不是好事，我这当督检的，还是众怨之的呢。","book":"清·吴研人《二十年目睹之怪现状》第十一回"},"similar":["众矢之的"],"usage":"作宾语；用于书面语"},{"id":5878,"word":"众恶必察","pinyin":"zhòng wù bì chá","abbr":"zebc","explanation":"恶：厌恶；察：考察。大家都不喜欢的，未必就坏，一定要调查后才可下结论。","source":{"text":"众恶之，必察焉；众好之，必察焉。","book":"《论语·卫灵公》"},"example":{"text":"～，众好必察易，自恶必察，自好必察难。（明·程登吉《幼学琼林·持躬》）"},"usage":"作宾语、定语；用于处事"},{"id":5879,"word":"众所共知","pinyin":"zhòng suǒ gòng zhī","abbr":"zsgz","explanation":"众：很多人。大家普遍知道的。","source":{"text":"虽十目视十手指众所共知之处，亦自七颠八倒了，更如何地谨独。","book":"宋·朱熹《朱子语类·大学三》"},"example":{"text":"子声望～，我素识苗甚平善，何敢占骗。","book":"清·蒲松龄《聊斋志异·刘姓》"},"similar":["众所周知"],"usage":"作谓语、定语、宾语；用于人或事物等"},{"id":5880,"word":"众所周知","pinyin":"zhòng suǒ zhōu zhī","abbr":"zszz","explanation":"大家普遍知道的。","source":{"text":"城中宣杂难住，莫苦就在众所周知石村卜一居，与白公为邻。","book":"《玉娇梨》第二十回"},"example":{"text":"这种小说的生产，～，主要是为了“爆炸”，所以他特别注意的是政治上的应时。","book":"孙犁《文林谈屑（一）·运动文学与揣摩小说》"},"similar":["尽人皆知","妇孺皆知","有目共睹"],"opposite":["一无所知"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":5881,"word":"众所瞩目","pinyin":"zhòng suǒ zhǔ mù","abbr":"zszm","explanation":"瞩目：注视。为大家所注视","source":{"text":"最近在这块小天地里，虽然又成了众所瞩目的人物，但到底还没经历过大场面，主持过像今天这样上百人的会议。","book":"克非《春潮急》"},"similar":["举世瞩目"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":5882,"word":"众所瞻望","pinyin":"zhòng suǒ zhān wàng","abbr":"zszw","explanation":"大家所仰望的。形容为大家所景仰。","source":{"text":"足下语论，众所瞻望。","book":"宋·蔡襄《答赵内翰书》"},"usage":"作宾语、定语；用于书面语"},{"id":5883,"word":"众擎易举","pinyin":"zhòng qíng yì jǔ","abbr":"zqyj","explanation":"擎：往上托。许多人一齐用力，容易把东西举起来。比喻大家同心协力就容易把事情办成。","source":{"text":"盖众擎易举，独力难支。","book":"明·张岱《募修岳鄂王祠姆疏》"},"example":{"text":"现在我们大家替他打算，～，已有个成数了，不日便可奉请开复。","book":"清·文康《儿女英雄传》第十三回"},"similar":["众志成城","人多势众"],"opposite":["寡不敌众","独木难支","孤掌难鸣"],"usage":"作定语、分句；形容大家齐心协力"},{"id":5884,"word":"众散亲离","pinyin":"zhòng sàn qīn lí","abbr":"zsql","explanation":"离：离开。众人反对，亲人背离。形容完全孤立。","source":{"text":"淮南之败，众散亲离，而垂侍卫圣躬，诚不可忘。","book":"《晋书·慕容垂载记》"},"example":{"text":"及至时运衰微，禄命将终之日，不但～，人心背叛。（清·褚人获《隋唐演义》第八十九回）"},"similar":["众叛亲离","亲离众叛"],"usage":"作谓语、定语、宾语；指不得人心"},{"id":5885,"word":"众星拱北","pinyin":"zhòng xīng gǒng běi","abbr":"zxgb","explanation":"拱：环绕，拱卫；北：指北极星。天上众星拱卫北辰。旧指有德的国君在位，得到天下臣民的拥戴。","source":{"text":"为致以德，譬如北辰，居其所而众星共之。","book":"《论语·为政》"},"example":{"text":"恰便似～，万水朝东。","book":"元·王实甫《丽春堂》第一折"},"similar":["众星拱辰"],"usage":"作定语；指四方归于一处"},{"id":5886,"word":"众星拱月","pinyin":"zhòng xīng gǒng yuè","abbr":"zxgy","explanation":"许多星星聚集、环绕着月亮。比喻众人拥戴一人或众物围绕一物。同“众星攒月”。","source":{"text":"而在那个主要工程的位置上，则缀有一颗大红宝石。在它的周围又加众星拱月，环绕着好些较小的红宝石。","book":"徐迟《搜尽奇峰打草稿》"},"example":{"text":"像～似的，学生们围在老教授身边，肩膀靠着肩膀，胳膊挽着胳膊。","book":"碧野《报晓峰》"},"similar":["众星捧月","众星攒月"],"usage":"作宾语、定语；用于书面语"},{"id":5887,"word":"众星拱极","pinyin":"zhòng xīng gǒng jí","abbr":"zxgj","explanation":"比喻众物围绕一物或众人拥戴一人。同“众星环极”。","source":{"text":"有土者莫不跨峙一隅，有民者莫不荣其私号，不遵众星拱极之道，不慕细流归海之义。","book":"《魏书·卢水胡沮渠蒙逊传》"},"example":{"text":"俾来四海之朝宗，尽类众星而拱极。","book":"南唐·刘崇远《宴石山记》"},"similar":["众星拱北","众星拱辰"],"usage":"作宾语、定语；指四方归于一处"},{"id":5888,"word":"众星拱辰","pinyin":"zhòng xīng gǒng chén","abbr":"zxgc","explanation":"拱：环绕，拱卫；辰：指北极星。天上众星拱卫北辰。旧指有德的国君在位，得到天下臣民的拥戴。后也比喻四方归向一处。","source":{"text":"为致以德，譬如北辰，居其所而众星共之。","book":"《论语·为政》"},"example":{"text":"四渎宗海，～，亿万斯年，藻朗日新。","book":"唐·李德裕《仁圣文武至神大孝皇帝真容赞》"},"similar":["众星拱北","众星拱极"],"usage":"作宾语、定语；指四方归于一处"},{"id":5889,"word":"众星捧月","pinyin":"zhòng xīng pěng yuè","abbr":"zxpy","explanation":"许多星星衬托着月亮。比喻众人拥护着一个他们所尊敬爱戴的人。","source":{"text":"为致以德，譬如北辰，居其所而众星共之。","book":"《论语·为政》"},"example":{"text":"乘着这个改朝换代的时机，咱们得～，把他抬出去！","book":"老舍《四世同堂》七"},"similar":["众星拱辰","众望所归","人心所向"],"opposite":["离心离德","各奔前程"],"usage":"作谓语、宾语；指公众爱戴的人"},{"id":5890,"word":"众星攒月","pinyin":"zhòng xīng cuán yuè","abbr":"zxcy","explanation":"许多星星聚集、环绕着月亮。比喻众人拥戴一人或众物围绕一物。","source":{"text":"问：‘众星攒月时如何？’师曰：‘唤甚么作月？’","book":"《五灯会元·清凉益禅师法嗣·黄山良匡禅师》"},"similar":["众星拱月","众星捧月"],"usage":"作宾语、定语；用于书面语"},{"id":5891,"word":"众星环极","pinyin":"zhòng xīng huán jí","abbr":"zxhj","explanation":"比喻众物围绕一物或众人拥戴一人。","source":{"text":"譬如星之环极，叛赫戏以辉煌。","book":"《论语·为政》：“譬如北辰，居其所而众星共之。”北辰，北极星。共，“拱”的古字，环绕。汉·张衡《西京赋》"},"similar":["众星捧月","众星攒月","众星拱月"],"usage":"作宾语、定语；用于书面语"},{"id":5892,"word":"众曲不容直","pinyin":"zhòng qū bù róng zhí","abbr":"zqbrz","explanation":"曲：弯曲，比喻邪恶；直：笔直，比喻正直。比喻在众多的坏人里不能容纳正直的人","source":{"text":"此所谓同污而异涂者，众曲不容直，众枉不容正。","book":"西汉·司马迁《淮南子·说山训》"},"usage":"作宾语、定语；用于书面语"},{"id":5893,"word":"众望所依","pinyin":"zhòng wàng suǒ yī","abbr":"zwsy","explanation":"众望：众人的希望。大家一致期望的。指得到群众的信任。","source":{"text":"贾谧与后共谋，以华庶族，儒雅有筹略，进无逼上之嫌，退为众望所依，欲倚以朝纲，访以政事。","book":"《晋书·张华传》"},"example":{"text":"他～，赢得了这次大选"},"similar":["众望攸归","众望所属","众望有归"],"usage":"作谓语、定语；用于书面语"},{"id":5894,"word":"众望所属","pinyin":"zhòng wàng suǒ shǔ","abbr":"zwss","explanation":"众望：众人的希望。大家一致期望的。指得到群众的信任。","source":{"text":"翼王，章宗之兄，显宗长子，众望所属，元帅决策立之，万世之功也。","book":"《金史·徒单镒传》"},"similar":["众望攸归","众望所依"],"usage":"作谓语、定语；用于书面语"},{"id":5895,"word":"众望所归","pinyin":"zhòng wàng suǒ guī","abbr":"zwsg","explanation":"众望：众人的希望；归：归向。大家一致期望的。指得到群众的信任。","source":{"text":"舍试揭榜，伏承遂释褐于崇化堂前，众望所归，此选增重，凡在友朋之列者，意气为之光鲜。","book":"《晋书·列传三十传论》：“于是武皇之胤，惟有建兴，众望攸归，曾无与二。”宋·陈亮《复陆伯寿》"},"example":{"text":"他非去不可！～，还有什么可说的呢？","book":"老舍《四世同堂》三十五"},"similar":["人心所向","德高望重","年高德劭"],"opposite":["众叛亲离","土崩瓦解","分崩离析"],"usage":"作谓语、宾语、定语；指得到群众的信任"},{"id":5896,"word":"众望所积","pinyin":"zhòng wàng suǒ jī","abbr":"zwsj","explanation":"众望：众人的希望。大家一致期望的。指得到群众的信任。","source":{"text":"至于才望资品，循可尚书郎，讷可太子洗马、舍人。此乃众望所积，非但企及清途，苟充方选也。","book":"《晋书·贺循传》"}},{"id":5897,"word":"众望攸归","pinyin":"zhòng wàng yōu guī","abbr":"zwyg","explanation":"众人所期望和敬仰的。形容在群众中威望很高。","source":{"text":"于是武皇之胤，惟有建兴，众望攸归，曾无与二。","book":"《晋书·解系阎鼎等传论》"},"similar":["众望所属","众望所依","众望有归"],"usage":"作谓语、定语；用于书面语"},{"id":5898,"word":"众望有归","pinyin":"zhòng wàng yǒu guī","abbr":"zwyg","explanation":"众望：众人的希望。深得众人拥护、爱戴，为人心所归依。形容得到大家的信任。","source":{"text":"俄而周帝以众望有归，乃下诏。","book":"《隋书·高祖纪上》"},"example":{"text":"又见～，阴劝高祖应天受命，高祖从之。（《隋书·崔仲方传》）"},"similar":["众望所归","众望攸归","众望所依"],"usage":"作谓语、定语；用于书面语"},{"id":5899,"word":"众楚群咻","pinyin":"zhòng chǔ qún xiū","abbr":"zcqx","explanation":"指众多的楚国人共同来喧扰。后指众多外来的干扰。","source":{"text":"一齐人傅之，众楚人咻之，虽日挞而求其齐也，不可得矣。","book":"语出《孟子·滕文公下》"},"example":{"text":"百工居肆欲其专也；～，喻其散也。","book":"清·李渔《闲情偶寄·词曲·词采》"},"usage":"作宾语、定语；用于书面语"},{"id":5900,"word":"众毁所归","pinyin":"zhōng huǐ suǒ guī","abbr":"zhsg","explanation":"众人的毁谤集中之处。形容被大家所不齿。","source":{"text":"籴贱贩贵，逐什一之利，此贾竖之事，污辱之处，恽亲行之。下流之人，众毁所归，不寒而栗。","book":"汉·杨恽《报孙会宗书》"},"usage":"作宾语、定语；用于书面语"},{"id":5901,"word":"众毁销骨","pinyin":"zhòng huǐ xiāo gǔ","abbr":"zhxg","explanation":"指众多的毁谤，可以销熔人的骨骼。比喻谗言多可以混淆是非。","source":{"text":"众毁销骨，虽贻投抒之嗟；太阳中天，必冀容光之照。","book":"宋·李纲《宫词谢表》"},"similar":["众口铄金"],"usage":"作宾语、定语；用于书面语"},{"id":5902,"word":"众毛攒裘","pinyin":"zhòng máo cuán qiú","abbr":"zmcq","explanation":"攒：聚；裘：皮衣。聚集许多小块皮毛，能够缝成一件皮衣。比喻积少成多。","source":{"text":"常言道：‘众毛攒裘。’","book":"明·吴承恩《西游记》第六十九回"},"similar":["集腋成裘"],"usage":"作宾语、定语；指积少成多"},{"id":5903,"word":"众毛飞骨","pinyin":"zhòng máo fēi gǔ","abbr":"zmfg","explanation":"指众多轻物能掀起重物。","source":{"text":"群轻折轴，下沉黄泉；众毛飞骨，上凌青天。","book":"唐·李白《雪谗诗赠友人》"},"usage":"作宾语、定语；用于书面语"},{"id":5904,"word":"众流归海","pinyin":"zhòng liú guī hǎi","abbr":"zlgh","explanation":"大小河流同归于海。比喻众多分散的事物汇集于一处。","source":{"text":"众流归海意，万国奉君心。","book":"唐·杜甫《长江》诗之二"},"example":{"text":"怎当得丁生连掷胜采，两人出注，正如～，尽数赶在丁生处了。","book":"明·凌濛初《二刻拍案惊奇》卷八"},"similar":["众川赴海"],"usage":"作宾语、定语；多用于比喻句"},{"id":5905,"word":"众犬吠声","pinyin":"zhòng quǎn fèi shēng","abbr":"zqfs","explanation":"比喻随声附和。","source":{"text":"众犬吠声，因盲者得视，远近翕赫，其下车骑常数千百，酒肉滂沲。","book":"汉·应劭《风俗通·怪神·李君神》"},"usage":"作宾语、定语；用于书面语"},{"id":5906,"word":"众目俱瞻","pinyin":"zhòng mù jù zhān","abbr":"zmjz","explanation":"具瞻：为众人所瞻仰。许多人都景仰。","example":{"text":"况内地更有好处，为五方杂处、～的上海等处所不及的。","book":"朱自清《”海阔天空”与“古今中外”》"}},{"id":5907,"word":"众目共睹","pinyin":"zhòng mù gòng dǔ","abbr":"zmgd","explanation":"所有人的眼睛都看到了。形容非常明显。亦作“众目共视”、“众目具瞻”。","source":{"text":"且观世大士所降近验，并即表身世，众目共睹，祈求之家，其事相继。","book":"宋·何尚之《答宋文帝赞扬佛教事》"},"example":{"text":"明·冯梦龙《喻世明言》第二卷：“这是小人们～。只银子数目多少，小人不知。”"},"similar":["众目共视"],"usage":"作谓语、定语；用于书面语"},{"id":5908,"word":"众目共视","pinyin":"zhòng mù gòng shì","abbr":"zmgs","explanation":"所有人的眼睛都看到了。形容非常明显。同“众目共睹”。","source":{"text":"言一出则万口争传，众目共视，虽欲为私，其势不可。","book":"宋·欧阳修《论台谏官唐介等宜早牵复札子》"},"similar":["众目共睹"],"usage":"作谓语、定语；用于书面语"},{"id":5909,"word":"众目具瞻","pinyin":"zhòng mù jù zhān","abbr":"zmjz","explanation":"所有人的眼睛都看到了。形容非常明显。同“众目共睹”。","source":{"text":"况内地更有好处，为五方杂处，众目具瞻的上海等处所不及的；如花木的趣味，盆栽的趣味便是。","book":"朱自清《“海阔天空”与“古今中外”》"}},{"id":5910,"word":"众目所归","pinyin":"zhòng mù suǒ guī","abbr":"zmsg","explanation":"众人的目光集中之处。指一致看好。","source":{"text":"兹乃众目所归，不待较而可得矣。","book":"宋·赵佶《宣和画谱·道释二·辛澄》"},"usage":"作宾语、定语；用于书面语"},{"id":5911,"word":"众目昭彰","pinyin":"zhòng mù zhāo zhāng","abbr":"zmzz","explanation":"昭彰：明显。大家都看得很清楚。","source":{"text":"在你家里搜出人腿来，众目昭彰，一传出去，不到得轻放过了你。","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"example":{"text":"这事～，你不必强词夺理了。"},"similar":["众目睽睽","大庭广众","有目共睹"],"opposite":["掩人耳目"],"usage":"作谓语、定语、分句；用于书面语"},{"id":5912,"word":"众目睽睽","pinyin":"zhòng mù kuí kuí","abbr":"zmkk","explanation":"睽睽：张目注视的样子。许多人争着眼睛看着。指在广大群众注视之下。","source":{"text":"公私扫地赤立，新旧不相保持，万目睽睽，公于此时能安以治之。","book":"唐·韩愈《郓州溪堂诗并序》"},"example":{"text":"～之下，拿他调到一边咬耳朵，人家心里会怎么想？","book":"高阳《清宫外史》下册"},"similar":["有目共睹","大庭广众","众目昭彰"],"opposite":["掩人耳目"],"usage":"作谓语、定语；指在广大群众注视之下"},{"id":5913,"word":"众盲摸象","pinyin":"zhòng máng mō xiàng","abbr":"zmmx","explanation":"许多瞎子摸象，摸到象腿的说象一根柱子，摸到象身子的说象一堵墙，摸到象尾的说象一条蛇，互相争论不休。比喻看问题以偏概全。","source":{"text":"其触牙者即言象形如芦菔根，其触耳者言象如箕，其触头者言象如石，其触鼻者言象如杵，其触脚者言象如木臼，其触脊者言象如床，其触腹者言象如甕，其触尾者言象如绳。","book":"《大般涅槃经》三二"},"example":{"text":"少林冷坐，门人各说异端，大似～。","book":"宋·普济《五灯会元》卷十八"},"similar":["众人摸象","盲人摸象"],"usage":"作宾语、定语；用于比喻句"},{"id":5914,"word":"众矢之的","pinyin":"zhòng shǐ zhī dì","abbr":"zszd","explanation":"矢：箭；的：箭靶的中心。众箭所射的靶子。比喻大家攻击的对象。","source":{"text":"是此四孤者，实为众射之地。","book":"清·李渔《义士李伦表传》"},"example":{"text":"语堂为提倡语录体，在此几成～。","book":"鲁迅《书信集·致许寿裳》"},"similar":["过街老鼠"],"opposite":["明目张胆"],"usage":"作宾语、定语；指目标"},{"id":5915,"word":"众虎同心","pinyin":"zhòng hǔ tóng xīn","abbr":"zhtx","explanation":"许多虎一条心做事。比喻众多有本事的人团结一致，力量会更大。","source":{"text":"三山聚义打青州，众虎同心归水泊。","book":"明·施耐庵《水浒传》第五十七回"},"usage":"作谓语、定语；用于比喻句"},{"id":5916,"word":"众议成林","pinyin":"zhòng yì chéng lín","abbr":"zycl","explanation":"指众人的议论可使人相信平地上出现森林。比喻流言多可以乱真。","source":{"text":"众人皆议平地生林，无翼之禽能飞，凡人信之以为实然也。","book":"《淮南子·说山训》：“众议成林，无翼而飞。”高诱注"},"usage":"作宾语、定语；用于比喻句"},{"id":5917,"word":"众议纷纭","pinyin":"zhòng yì fēn yún","abbr":"zyfy","explanation":"纷纭：多而杂乱。人多嘴杂，议论纷纷。","source":{"text":"帝升御座，亲量三教优劣废立，众议纷纭，各随情见较其大抵。","book":"唐·释道宣《续高僧传》卷二十三"},"example":{"text":"人主欲定大事，不过一二臣可以与谋，今～，徒乱人意，我当与卿专决此事。（蔡东藩《两晋演义》第六十六回）"},"similar":["众说纷纭"],"usage":"作谓语、定语；用于书面语"},{"id":5918,"word":"众说纷揉","pinyin":"zhòng shuō fēn róu","abbr":"zsfr","explanation":"各种说法纷乱而混杂。形容有各种各样的议论。","source":{"text":"麟，瑞兽也，旷世而不可睹，其于经有名而无形，传记有形，而去圣久远。纵说纷揉，自非圣人，莫能识其真。","book":"宋·司马光《进交趾献奇兽赋表》"},"similar":["众说纷纭"],"usage":"作谓语、定语；用于书面语"},{"id":5919,"word":"众说纷纭","pinyin":"zhòng shuō fēn yún","abbr":"zsfy","explanation":"纷纭：多而杂乱。人多嘴杂，议论纷纷。","source":{"text":"然当纯公既没，众说纷纭，卒能坚忍植立。","book":"元·戴表元《剡源集·跋濂溪二程谥议》"},"example":{"text":"臣尝询访边方年高知事之人，～，各有所见。","book":"明·李承勋《陈言边务疏》"},"similar":["议论纷纷","言人人殊","各抒己见"],"opposite":["众口一词","异口同声","千篇一律"],"usage":"作谓语；常与“莫衷一是”连用"},{"id":5920,"word":"众醉独醒","pinyin":"zhòng zuì dú xǐng","abbr":"zzdx","explanation":"比喻众人沉迷糊涂，独自保持清醒。","source":{"text":"屈原曰：‘举世皆浊而我独清，众人皆醉而我独醒，是以见放。’","book":"战国楚·屈原《渔父》"},"similar":["众人皆醉我独醒"],"usage":"作定语、宾语；指与众不同"},{"id":5921,"word":"众阳之长","pinyin":"zhòng yáng zhī zhǎng","abbr":"zyzz","explanation":"太阳的别称","source":{"text":"夫日者众阳之长，辉光所烛，万里同晷。","book":"东汉·班固《汉书·李寻传》"},"usage":"作宾语；用于书面语"},{"id":5922,"word":"众难群疑","pinyin":"zhòng nán qún yí","abbr":"znqy","explanation":"众人心中都有疑难。","source":{"text":"群疑满腹，众难塞胸。","book":"三国·蜀·诸葛亮《后出师表》"},"example":{"text":"～曰：‘是必有强国焉阴助之耳；不然，倭乌能如是！’","book":"清·严复《原强续篇》"},"usage":"作谓语、宾语；指大疑问"},{"id":5923,"word":"众难群移","pinyin":"zhòng nán qún yí","abbr":"znqy","explanation":"众人心中都有疑难。","source":{"text":"群疑满腹，众难塞胸。","book":"三国蜀·诸葛亮《后出师表》"}},{"id":5924,"word":"优优简简","pinyin":"yōu yōu jiǎn jiǎn","abbr":"yyjj","explanation":"形容从容舒缓的样子。","source":{"text":"规之为度也，转而不复，员而不垸，优而不纵，广大以宽，感动有理，发通有纪，优优简简，百怨不起。","book":"《举证南子·时则训》"}},{"id":5925,"word":"优劣得所","pinyin":"yōu liè dé suǒ","abbr":"ylds","explanation":"好的差的各得其所。","example":{"text":"我们尽量做到～。"},"similar":["各得其所"],"usage":"作宾语；指各得其所"},{"id":5926,"word":"优哉游哉","pinyin":"yōu zāi yóu zāi","abbr":"yzyz","explanation":"优、游：悠闲的样子。指生活悠闲自在。","source":{"text":"优哉游哉，亦是戾矣。","book":"《诗经·小雅·采菽》"},"example":{"text":"凡是有名的隐士，他总是已经有了“～，聊以卒岁”的幸福的。","book":"鲁迅《且介亭杂文二集·隐士》"},"similar":["逍遥自在","悠闲自在","安闲自得"],"opposite":["束手束脚","缩手缩脚","谨小慎微"],"usage":"作谓语、定语、状语；指悠闲"},{"id":5927,"word":"优存劣败","pinyin":"yōu cún liè bài","abbr":"yclb","explanation":"指生物在生存竞争中适应力强的保存下来，适应力差的被淘汰。这是达尔文进化论的一个基本论点。","source":{"text":"优胜劣败，取乱侮亡，自不必说。","book":"清·吴趼人《痛史》第一回"}},{"id":5928,"word":"优孟衣冠","pinyin":"yōu mèng yī guān","abbr":"ymyg","explanation":"优孟：春秋时楚国著名的的演杂戏的人，擅长滑稽讽谏。比喻假扮古人或模仿他人。也指登场演戏。","source":{"text":"《史记·滑稽列传》记载：楚相孙叔敖死后，儿子很穷。优孟穿戴了孙叔敖的衣冠去见楚庄王。楚庄五受到感动，封了孙叔敖的儿子。"},"example":{"text":"若不容许变，那就只有模拟，甚至只有抄袭；那种～，甚至土偶木人，又有什么意义可言。","book":"朱自清《经典常谈·诗第十二》"},"similar":["东施效颦","邯郸学步","鹦鹉学舌"],"opposite":["别具一格","别开生面","独辟蹊径"],"usage":"作宾语、定语；用于书面语","story":["春秋时期楚国王宫艺人优孟听说前相国孙叔敖死后儿子过着十分清贫的生活，觉得过意不去，就穿戴孙叔敖的衣冠，模仿他的音容笑貌去见楚王，楚王即景生情，优孟趁机讲述孙叔敖儿子的现状，楚王深受感动，就重封孙叔敖的儿子"]},{"id":5929,"word":"优差美缺","pinyin":"yōu chā měi quē","abbr":"ycmq","explanation":"美差肥缺，好的职位。","example":{"text":"他拼命讨好上司，争取得到一个能赚钱的～。"},"similar":["美差肥缺"],"usage":"作主语、宾语、定语；指好职位"},{"id":5930,"word":"优昙一现","pinyin":"yōu tán yī xiàn","abbr":"ytyx","explanation":"优昙钵花如莲花十二瓣，一开即敛。比喻事物或景象稍现即逝，难得见到。","source":{"text":"佛告舍利弗，如是妙法，诸佛如来时乃说之，如优昙钵花时一现耳。","book":"语出《法华经·方便品》"},"example":{"text":"遂推为两京法主，三帝国师，仰佛日之再中，庆～。","book":"唐·张说《唐玉泉寺大通禅师碑》"},"similar":["昙花一现"],"usage":"作宾语、定语；用于书面语"},{"id":5931,"word":"优柔不断","pinyin":"yōu róu bù duàn","abbr":"yrbd","explanation":"优柔：犹豫不决。指做事犹豫，缺乏决断。","source":{"text":"贡禹、薛广德、韦元成、匡衡也，四人皆握娖自好，当优柔不断之朝，无所规救。","book":"宋·洪迈《容斋续笔》卷九"},"example":{"text":"自太祖开基，太宗承统，其中列圣相传，并无荒淫暴虐之主，只是～，姑息为心。","book":"清·陈忱《水浒后传》第一回"}},{"id":5932,"word":"优柔厌饫","pinyin":"yōu róu yàn yù","abbr":"yryy","explanation":"比喻为学之从容求索，深入体味。同“优柔餍饫”","source":{"text":"遐尔学徒，争奔走其门，先生随其资器，孳孳训迪，必使优柔厌饫而后已。","book":"明·宋濂《故东吴先生吴公墓碣铭》"},"similar":["优柔餍饫"],"usage":"作谓语、定语；用于书面语"},{"id":5933,"word":"优柔失断","pinyin":"yōu róu shī duàn","abbr":"yrsd","explanation":"优柔：犹豫不决。形容遇事犹豫，不能当机立断。","source":{"text":"由是攫金有耻，伏莽知非，人怀汉道之宽平，不责高皇之慢骂。然而优柔失断，浸润得行，诛文静则议法不从，酬裴寂则曲恩太过。","book":"《旧唐书·高祖纪论》"},"similar":["优柔寡断","优柔无断"],"usage":"作谓语、定语、宾语；指人不果断"},{"id":5934,"word":"优柔寡断","pinyin":"yōu róu guǎ duàn","abbr":"yrgd","explanation":"优柔：犹豫不决；寡：少。指做事犹豫，缺乏决断。","source":{"text":"缓心而无成，柔茹而寡断，好恶无决，而无所定立者，可亡也。","book":"《韩非子·亡征》"},"example":{"text":"他做什么事都没有主见，是一个～的人。"},"similar":["犹豫不决","举棋不定"],"opposite":["当机立断","斩钉截铁"],"usage":"作谓语、定语、宾语；指人不果断"},{"id":5935,"word":"优柔无断","pinyin":"yōu róu wú duàn","abbr":"yrwd","explanation":"优柔：犹豫不决。指做事犹豫，拿不定主意。","source":{"text":"观此语意，疑若优柔无断者；至其端委庙堂，决澶渊之策，其气锐然，奋仁者之勇，全与此诗意不相类。盖人之难知也如此！","book":"宋·胡仔《苕溪渔隐丛话》"},"example":{"text":"前后七上疏请除罢释氏，词皆激切，帝春秋高而～。","book":"元·释念常《佛祖通载》卷十一"},"similar":["优柔失断","优柔寡断"],"opposite":["当机立断"],"usage":"作谓语、定语、宾语；指人不果断"},{"id":5936,"word":"优柔餍饫","pinyin":"yōu róu yàn yù","abbr":"yryy","explanation":"比喻为学之从容求索，深入体味。亦作“优柔厌饫”。","source":{"text":"优而柔之，使自求之；餍而饫之，使自趋之。","book":"语出晋·杜预《〈春秋左传集解〉序》"},"example":{"text":"如此然后求诸四君子之全书，沉潜反覆，～，以致其博而反诸约焉。","book":"清·戴名世《〈四书朱子大全〉序》"},"similar":["优柔厌饫"],"usage":"作谓语、定语；用于书面语"},{"id":5937,"word":"优柔魇饫","pinyin":"yōu róu yàn yù","abbr":"yryy","explanation":"优柔：不慌不忙地；魇：吃饱后满足的样子；饫：饱食。比喻从容舒缓地体味其含义，并从中得到满足。","source":{"text":"优而柔之，使自求之；魇而饫之，使自趋之。","book":"晋·杜预《春秋左氏传序》"}},{"id":5938,"word":"优游不断","pinyin":"yōu yóu bù duàn","abbr":"yybd","explanation":"指处世迟疑，没有决断。","source":{"text":"而上牵制文义，优游不断，孝宣之业衰焉。","book":"东汉·班固《汉书·元帝纪赞》"},"example":{"text":"孝元固已自知之，卒以～，堕宣帝之业。","book":"明·归有光《河南策问对二道》"},"similar":["犹豫不决"],"opposite":["当机立断"],"usage":"作谓语、定语；指人不果断"},{"id":5939,"word":"优游不迫","pinyin":"yōu yóu bù pò","abbr":"yybp","explanation":"优游：悠闲自得；不迫：不紧不急的样子。形容从容闲适的样子。","source":{"text":"其大概有二：曰优游不迫，曰沉着痛快。","book":"宋·严羽《沧浪诗话·诗辩》"},"example":{"text":"诗之为体有六：曰雄浑，曰悲壮，曰平淡，曰苍古，曰沉着痛快，曰～。","book":"元·杨载《诗法家数》"}},{"id":5940,"word":"优游卒岁","pinyin":"yōu yóu zú suì","abbr":"yyzs","explanation":"悠闲度日。","source":{"text":"春秋·鲁·左丘明《左传·襄公二十一年》： “《诗》曰：‘优哉游哉，聊以卒岁。’”"},"example":{"text":"次即束身自好，～，以自处于朝隐。","book":"章炳麟《驳康有为论革命书》"},"similar":["优哉游哉"],"usage":"作谓语；指悠闲度日"},{"id":5941,"word":"优游少断","pinyin":"yōu yóu shǎo duàn","abbr":"yysd","explanation":"优柔：犹豫不决。指遇事犹豫，不果断。","source":{"text":"之绍平日自以其性遇事优游少断，故号果齐以自励。","book":"《元史·李之绍传》"}},{"id":5942,"word":"优游岁月","pinyin":"yōu yóu suì yuè","abbr":"yysy","explanation":"悠闲舒适地过日子。","source":{"text":"可惜他这位儿子虽名为‘家驹’，实在还比不上一条‘家狗’，因此早该是退休享福的曾沧海却还不能优游岁月，甚至柴米油盐等等琐细，都得他老人家操一份心。","book":"茅盾《子夜》四"},"example":{"text":"茅盾《子夜》：“因此早该是退休享福的曾沧海却还不能优游岁月，甚至柴米油盐等等琐细，都得他老人家操一份心。”"},"usage":"作谓语、定语；用于处事"},{"id":5943,"word":"优游恬淡","pinyin":"yōu yóu tián dàn","abbr":"yytd","explanation":"优游：悠闲自得的样子；恬淡：悠闲安适。悠闲自得，不求名利。","source":{"text":"所以优游恬淡而不进者，重伤人物也。","book":"汉·黄石公《三略·下略》"},"example":{"text":"松峰下，水边石畔，遣兴饮流霞。一灵常皎洁，～，真乐无涯。","book":"元·马钰《满庭芳》词"}},{"id":5944,"word":"优游涵泳","pinyin":"yōu yóu hán yǒng","abbr":"yyhy","explanation":"指从容求索，深入体会。","source":{"text":"圣人言此，一以示学者当优游涵泳，不可躐等而进。","book":"春秋·鲁·孔丘《论语·为政》：“七十而从心所欲，不逾矩”朱熹集注引胡氏曰"},"example":{"text":"杨树达《积微居小学述林·温故知新说》：“夫曰‘温故而知新’者，先温故而后知新也。～于故业之中，而新知忽涌焉。”"},"similar":["优柔魇饫"],"usage":"作谓语、定语；用于书面语"},{"id":5945,"word":"优游自在","pinyin":"yōu yóu zì zài","abbr":"yyzz","explanation":"指悠闲舒适。","source":{"text":"太平无事，尚可优游自在，一旦有警，早已吓得意乱心慌，等到上头派了下来，更把他急的走头无路。","book":"清·李宝嘉《官场现形记》第十二回"},"example":{"text":"清·李宝嘉《官场现形记》第11回：“太平无事，尚可～；一旦有警，早已吓得意乱心慌。”"},"similar":["优游自适","优游自得"],"usage":"作定语、状语；用于处事"},{"id":5946,"word":"优游自如","pinyin":"yōu yóu zì rú","abbr":"yyzr","explanation":"①悠闲适意，无拘无束。②犹言从容不迫。","source":{"text":"然职清务简，优游自如，世谓之玉堂仙。","book":"明·彭时《彭文宪笔记》"},"example":{"text":"熟炼的纺手，趁着一豆灯光或者朦胧的月光，也能摇车，抽线，上线，一切做得～。","book":"吴伯箫《北极星·记一辆纺车》"},"similar":["从容不迫","优游自若"],"opposite":["手忙脚乱"],"usage":"作定语、状语；用于处事"},{"id":5947,"word":"优游自得","pinyin":"yōu yóu zì dé","abbr":"yyzd","explanation":"指悠闲如意。","source":{"text":"莫不优游而自得，玉润而金声。","book":"汉·班固《东都赋》"},"example":{"text":"吾丈～，心恬体舒，必享龟鹤之寿。","book":"宋·苏轼《答杨君素书》"},"similar":["优游自如","优柔自在"],"usage":"作谓语、定语、状语；用于处事"},{"id":5948,"word":"优游自若","pinyin":"yōu yóu zì ruò","abbr":"yyzr","explanation":"从容不迫，不变常态。","source":{"text":"凡置卷数百，二仆待侧，左展卷，右收卷，循环不息。待者告疲，公优游自若也。","book":"清·陆以湉《冷庐识·彭文勤公》"},"example":{"text":"《清朝野史大观·记彭元瑞》：“侍者告疲，公～也。”"},"similar":["优游自如"],"usage":"作定语、状语；用于处事"},{"id":5949,"word":"优游自适","pinyin":"yōu yóu zì shì","abbr":"yyzs","explanation":"悠闲适意。","source":{"text":"城南有别墅，每良辰美景，以小车载酒，优游自适。","book":"宋·吴处厚《青箱杂记》第十卷"},"similar":["优游自得"],"usage":"作定语、状语；用于处事"},{"id":5950,"word":"优胜劣败","pinyin":"yōu shèng liè bài","abbr":"yslb","explanation":"指生物在生存竞争中适应力强的保存下来，适应力差的被淘汰。这是达尔文进化论的一个基本论点。","source":{"text":"优胜劣败，取乱侮亡，自不必说。","book":"清·吴趼人《痛史》第一回"},"example":{"text":"在人类社会中，～的现象经常发生。"},"similar":["适者生存","弱肉强食","优胜劣汰"],"usage":"作谓语、宾语；指社会竞争"},{"id":5951,"word":"优贤扬历","pinyin":"yōu xián yáng lì","abbr":"yxyl","explanation":"指敬重贤才，表扬其事迹。亦作“优贤飏历”。","source":{"text":"遂兴无为之治，优贤扬历，表善绌恶，遵九德以绥民，崇晏晏之惠康。","book":"《隶释·汉成阳令唐扶颂》"},"example":{"text":"若宁固执匪石，守志箕山，追迹洪崖，参踪巢许，斯亦圣朝同符唐虞，～，垂声千载。","book":"《三国志·魏志·管宁传》"},"usage":"作谓语、定语；用于书面语"},{"id":5952,"word":"优贤飏历","pinyin":"yōu xián yáng lì","abbr":"yxyl","explanation":"指敬重贤才，表扬其事迹。同“优贤扬历”。"},{"id":5953,"word":"会家不忙","pinyin":"huì jiā bù máng","abbr":"hjbm","explanation":"行家对自己熟悉的事，应付裕如，不会慌乱。同“会者不忙”。","source":{"text":"程朝奉正是会家不忙，见接了银子，晓得有了机关。","book":"明·吴承恩《西游记》第七十六回：“行者正是会家不忙，掣铁棒，劈面相迎。”明·凌濛初《二刻拍案惊奇》卷二十八"},"example":{"text":"左公子正是～。","book":"《天雨花》第二回"},"similar":["会者不忙"],"usage":"作宾语、定语；用于处事"},{"id":5954,"word":"会少离多","pinyin":"huì shǎo lí duō","abbr":"hsld","explanation":"相会少，别离多。感慨人生聚散无常或别离之苦。","source":{"text":"会少离多看两鬓，万缕千丝，何况新来病。","book":"宋·辛弃疾《蝶恋花·送祐之弟》词"},"example":{"text":"只问你那～，有影无形。","book":"元·王实甫《西厢记》第一本第三折"},"usage":"作谓语、宾语；用于感慨人生"},{"id":5955,"word":"会心一笑","pinyin":"huì xīn yī xiào","abbr":"hxyx","explanation":"会心：领会到别人内心的意思。领会到对方没有表明的意思而微微一笑。","source":{"text":"使同类者知道也还有谁在袭击古老坚固的堡垒，较之看见浩大而灰色的军容，或者反可以会心一笑。","book":"鲁迅《通讯》"},"example":{"text":"她对我报以～。"},"usage":"作谓语、宾语；指高兴"},{"id":5956,"word":"会者不忙","pinyin":"huì zhě bù máng","abbr":"hzbm","explanation":"行家对自己熟悉的事，应付裕如，不会慌乱。","source":{"text":"言犹未毕，草荒中钻出一个人来，手执钢叉，望公子便搠。公子会者不忙，将铁棒架住。","book":"明·冯梦龙《警世通言》第二十一卷"},"example":{"text":"清·吴璿《飞龙全传》第55回：“正是忙着不会，～，怀德只一把，早将李豹暖肚一手擒牢。”"},"similar":["会家不忙"],"usage":"作宾语、定语；用于处事"},{"id":5957,"word":"会逢其适","pinyin":"huì féng qí shì","abbr":"hfqs","explanation":"会：恰巧，适逢；适：往。原指恰巧走到那儿了。转指正巧碰上了那件事。","source":{"text":"子谓仲长子光曰：‘山林可居乎？’曰：‘会逢其适也，焉知其可？’","book":"隋·王通《文中子·周公》"},"example":{"text":"舒守谦以被逐，逃死于舒元舆，亦～也。","book":"清·秦笃辉《平书·人事下》"},"similar":["躬逢其盛"],"usage":"作谓语；指正巧碰上了那件事"},{"id":5958,"word":"会道能说","pinyin":"huì dào néng shuō","abbr":"hdns","explanation":"形容很会讲话。同“能说会道”。","source":{"text":"但甜瓜软处偏捏。蜡枪头会道能说。","book":"元·无名氏《渔樵闲话》第三折"},"example":{"text":"她有一个～的嘴，让人不好对付。"},"similar":["能说会道"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；形容人口才很好"},{"id":5959,"word":"伟绩丰功","pinyin":"wěi jì fēng gōng","abbr":"wjfg","explanation":"伟大的功绩。同“丰功伟绩”。","source":{"text":"伟绩丰功，笼络一世。","book":"明·黄绾《明道编》第三卷"},"example":{"text":"衣冠剑佩今何在，～万古存。","book":"茅盾《周总理挽诗》"},"similar":["丰功伟绩"],"opposite":["罪大恶极"],"usage":"作主语、宾语、定语；指功绩很大"},{"id":5960,"word":"传三过四","pinyin":"chuán sān guò sì","abbr":"csgs","explanation":"传闲话，说是非。","source":{"text":"就是有那些不识好歹的人说几句闲言杂语，你在大爹面前，也该遮盖遮盖，怎么传三过四，又惹他老人家生气！","book":"石灵《捕蝗者》"},"example":{"text":"大老爷们怎么能干～的事。"},"similar":["搬嘴递舌","说三道四"],"usage":"作谓语、宾语、定语；指搬弄是非"},{"id":5961,"word":"传为佳话","pinyin":"chuán wéi jiā huà","abbr":"cwjh","explanation":"指传扬开去，成为人们赞美、称颂的事情。","source":{"text":"鲁人至今以为美谈。","book":"《公羊传·闵公二年》"},"example":{"text":"遂以玉卿诗，比之陈琳一檄，一时词林，～。","book":"清·王韬《海陬冶游续录》卷下"},"similar":["传为美谈"],"usage":"作谓语、宾语；指传为美谈"},{"id":5962,"word":"传为笑柄","pinyin":"chuán wéi xiào bǐng","abbr":"cwxb","explanation":"笑柄：被人取笑的材料。流传开去被人们当作取笑的资料。","source":{"text":"男家埋怨他办事无首尾，女家骂他占骗……合域传为笑柄。","book":"清·李绿园《歧路灯》第九十回"},"example":{"text":"总办倒也拿他无可知何，从此外面便～。","book":"清·吴趼人《二十年目睹之怪现状》第一百回"},"similar":["传为笑谈"],"usage":"作谓语；指流传为笑话"},{"id":5963,"word":"传为笑谈","pinyin":"chuán wéi xiào tán","abbr":"cwxt","explanation":"笑谈：笑话；笑料。流传开去成为人们谈笑的资料。","source":{"text":"公子虽愧恨，犹不知所题，折帖示仆。闻者传为笑谈。","book":"清·蒲松龄《聊斋志异·嘉平公子》"},"example":{"text":"大家就嘻嘻哈哈～。","book":"赵树理《小二黑结婚》"},"similar":["传为笑柄"],"usage":"作谓语、定语；用于人或事等"},{"id":5964,"word":"传为美谈","pinyin":"chuán wéi měi tán","abbr":"cwmt","explanation":"美谈：人们津津乐道的好事。指传扬开去，成为人们赞美、称颂的事情。","source":{"text":"鲁人至今以为美谈。","book":"《公羊传·闵公二年》"},"example":{"text":"元旦昧爽，复衣冠送出，萧山至今～。","book":"明·张岱《募造无主祠堂疏》"},"similar":["传为佳话"],"usage":"作谓语、宾语；指流传"},{"id":5965,"word":"传之不朽","pinyin":"chuán zhī bù xiǔ","abbr":"czbx","explanation":"朽：磨灭。使之永远流传，不至泯没。","source":{"text":"寻个出头的国手较一较高低……博他一个远乡异域的高名，传之不朽。","book":"明·凌濛初《二刻拍案惊奇·小道人一着饶天下》"},"example":{"text":"大人能够如此，包管大人的名声格外好，也同古人一样，～。","book":"清·李宝嘉《官场现形记》第十七回"},"usage":"作谓语、定语；用于人或事物等"},{"id":5966,"word":"传圭袭组","pinyin":"chuán guī xí zǔ","abbr":"cgxz","explanation":"指取得功名。圭，古代帝王、诸侯举行隆重仪式时所用的玉制礼器；组，古代官员系印的丝带，转指官印。","source":{"text":"士君子非以传圭袭组为难，能世其德业为难。","book":"明·宋濂《送黄仲恭赴官馀姚序》"},"similar":["传龟袭紫"],"usage":"作宾语、定语；用于继承祖业做官"},{"id":5967,"word":"传宗接代","pinyin":"chuán zōng jiē dài","abbr":"czjd","explanation":"宗：宗教，家族。代：后代。传延宗教，接续后代。旧指生了独生子可以使家世一代一代传下去。","source":{"text":"自己辛苦了一辈子，挣了这分大家私，死下来又没有个传宗接代的人，不知当初要留着这些钱何用。","book":"清·李宝嘉《官场现形记》第四十九回"},"example":{"text":"我想劝他讨个“小”，将来生个儿子也可以～。","book":"巴金《秋》第三十七章"},"similar":["后继有人"],"opposite":["后继无人"],"usage":"作谓语、定语；指繁衍后代"},{"id":5968,"word":"传杯弄斝","pinyin":"chuán bēi nòng jiǎ","abbr":"cbnj","explanation":"传：传递，传送；弄：酒宴中戏弄；斝：古代青铜制的圆口三足酒器。指酒宴中互相斟酒。","source":{"text":"投至得今日开筵，传杯弄斝。","book":"元·无名氏《符金锭》"},"similar":["传杯弄盏"],"usage":"作谓语；指酒宴中互相斟酒"},{"id":5969,"word":"传杯弄盏","pinyin":"chuán bēi nòng zhǎn","abbr":"cbnz","explanation":"指酒宴中互相斟酒。","source":{"text":"两傍列坐，传杯弄盏，花簇锦攒。","book":"明·兰陵笑笑生《金瓶梅词话》第十回"},"example":{"text":"～多欢悦，忽地夫人皱双眉。","book":"清·秋瑾《精卫石》第二回"},"similar":["传杯换盏","传杯送盏"],"usage":"作主语、谓语；指酒宴中互相斟酒"},{"id":5970,"word":"传杯换盏","pinyin":"chuán bēi huàn zhǎn","abbr":"cbhz","explanation":"指酒宴中互相斟酒。","source":{"text":"传杯换盏，吃到午后。","book":"《儒林外史》第五二回：“说着，家人摆上酒来，三个人传杯换盏，吃到半酣。”又第二九回"},"similar":["传杯弄盏","传杯送盏"],"usage":"作谓语；指酒宴中互相斟酒"},{"id":5971,"word":"传杯送盏","pinyin":"chuán bēi sòng zhǎn","abbr":"cbsz","explanation":"指酒宴中互相斟酒。同“传杯弄盏”。","source":{"text":"喜孜孜驻拍停歌，笑吟吟传杯送盏。","book":"清·洪昇《长生殿·惊发》"},"example":{"text":"且说那弟兄二人，当日分付整备筵席，款待匡胤。三人～，谈论闲文，不觉饮至更阑时分，方才撤席。","book":"清·吴璿《飞龙全传》第五回"},"similar":["传杯弄盏","传杯弄斝"],"usage":"作谓语；指酒宴中互相斟酒"},{"id":5972,"word":"传杯递盏","pinyin":"chuán bēi dì zhǎn","abbr":"cbdz","explanation":"传：传递，传送；盏：浅而小的杯子。指酒宴中互相斟酒，借指饮酒作乐","source":{"text":"自己却藏好了书札批文，与张、罗二人传杯递盏，畅饮舒怀。","book":"清·吴璿《飞龙全传》第三回"},"similar":["传杯弄盏","传杯换盏","传杯送盏"],"usage":"作谓语、定语、宾语；指酒宴中互相斟酒"},{"id":5973,"word":"传柄移籍","pinyin":"chuán bǐng yí jí","abbr":"cbyj","explanation":"柄：权力；籍：通“阼”，皇位。权势地位转移。","source":{"text":"恶自治之劳惮，使君臣辐凑之变，因传柄移籍，使杀生之机、夺予之要在大臣。","book":"战国·韩·韩非《韩非子·三守》"},"usage":"作宾语、定语；用于权势变迁等"},{"id":5974,"word":"传柄移藉","pinyin":"chuán bǐng yí jiè","abbr":"cbyj","explanation":"指权势转移。","source":{"text":"藉，势位也。","book":"《韩非子·三守》：“恶自治之劳惮，使君辐凑之变，因传柄移藉，使杀生之机，夺予之要在大臣。”陈奇猷集释引高亨曰"}},{"id":5975,"word":"传檄可定","pinyin":"chuán xí kě dìng","abbr":"cxkd","explanation":"传：传送，传递；檄：讨敌文书；定：平定。比喻不待出兵，只要用一纸文书，就可以降服敌方。指不战而使对方归顺","source":{"text":"传檄可定，极言敌之易破；迎刃而解，甚言事之易为。","book":"明·程登吉《幼学琼林》第三卷"},"similar":["传檄而定","迎刃而解"],"usage":"作谓语、定语；指不战而胜"},{"id":5976,"word":"传檄而定","pinyin":"chuán xí ér dìng","abbr":"cxed","explanation":"檄：讨敌文书；定：平定。比喻不待出兵，只要用一纸文书，就可以降服敌方，安定局势。","source":{"text":"今大王举而东，三秦可传檄而定也。","book":"《史记·淮阴侯列传》"},"example":{"text":"获操则威震天下，中原虽广，可～。","book":"明·罗贯中《三国演义》第四十一回"},"similar":["传檄可定"],"usage":"作谓语；指不战而胜"},{"id":5977,"word":"传爵袭紫","pinyin":"chuán jué xí zǐ","abbr":"cjxz","explanation":"指继承高爵显位。汉制，公侯皆佩紫绶龟纽金印。"},{"id":5978,"word":"传神写照","pinyin":"chuán shén xiě zhào","abbr":"csxz","explanation":"传神：指优美文学艺术作品描绘的人物生动逼真；写照：画像。形容用图画或文字描写人物，能生动逼真地描画出来。","source":{"text":"顾长康画人，或数年不点目精（睛）。人问其故，顾曰：‘四体妍蚩，本无关于妙处，传神写照，正在阿堵中’","book":"南朝·宋·刘义庆《世说新语·巧艺》"},"similar":["传神阿堵"],"usage":"作宾语、定语；指十分逼真","story":["晋朝时期，顾长康画人像十分有名，有的画了几年不点上眼睛。有人问他原因，顾长康说：“四肢身体的美丑，本与神韵无关，要想人像画得传神，关键在于这眼睛上。”"]},{"id":5979,"word":"传神阿堵","pinyin":"chuán shén ē dǔ","abbr":"csad","explanation":"传神：指好的文学艺术作品描绘的人物生动、逼真；阿堵：六朝人口语，即这、这个。形容用图画或文字描写人物，能得其精神。","source":{"text":"顾长康画人，或数年不点目精（睛）。人问其故，顾曰：‘四体妍蚩，本无善于妙处，传神写照，正在阿堵中’","book":"南朝宋·刘义庆《世说新语·巧艺》"},"similar":["传神写照"],"usage":"作宾语；指十分逼真","story":["晋朝时期，顾长康画人，有的画了几年不点上眼睛。有人问他原因，顾长康说：“四肢身体的美丑，本与神韵无关，要想人像画得传神，关键在于这眼睛上。”"]},{"id":5980,"word":"传经送宝","pinyin":"chuán jīng sòng bǎo","abbr":"cjsb","explanation":"经：经典，经验。把成功的经验和办法传送给别人。","example":{"text":"欢迎兄弟单位来我厂传经送宝。"},"similar":["传道授业"],"usage":"作定语、状语；用于尊称别人的好经验"},{"id":5981,"word":"传诵一时","pinyin":"chuán sòng yī shí","abbr":"csys","explanation":"诵：称诵、传述。在某一个时期内，人们到处传述。","source":{"text":"这故事颇为传诵一时……不过其中是带一点反对革命的意味的。","book":"鲁迅《洋服的没落》"},"example":{"text":"这部作品曾经～。"},"usage":"作谓语、定语；指一时流行"},{"id":5982,"word":"传诵不绝","pinyin":"chuán sòng bù jué","abbr":"csbj","explanation":"传：流传；诵：诵读。指流传后世被长期诵读。","source":{"text":"那篇数百年来传诵不绝的《正气歌》，博得广大人民的热爱和尊敬。","book":"穆欣《南线巡回·又照秦淮一叶枫》"},"example":{"text":"那篇数百年来～的《正气歌》，博得广大人民的热爱和尊敬。"},"usage":"作谓语、定语；用于事迹或作品等"},{"id":5983,"word":"传道受业","pinyin":"chuán dào shòu yè","abbr":"cdsy","explanation":"受：通“授”。传授道理，教授学业。","source":{"text":"师者，所以传道受业解惑也。","book":"唐·韩愈《师说》"}},{"id":5984,"word":"传道授业","pinyin":"chuán dào shòu yè","abbr":"cdsy","explanation":"传授道理，教授学业。","source":{"text":"古之学者必有师。师者，所以传道、授业、解惑也。","book":"唐·韩愈《师说》"},"similar":["授业解惑"],"usage":"作谓语、宾语；用于教师等"},{"id":5985,"word":"传道穷经","pinyin":"chuán dào qióng jīng","abbr":"cdqj","explanation":"道：孔孟之道；穷：穷尽；经：经典。传授道理，穷尽经典。","source":{"text":"这些中进士、做翰林的，和他说到传道穷经，他便说迂而不道。","book":"清·吴敬梓《儒林外史》第二十六回"},"usage":"作谓语、宾语；用于教学等"},{"id":5986,"word":"传闻不如亲见","pinyin":"chuán wén bù rú qīn jiàn","abbr":"cwbrqj","explanation":"听人传说总不如亲眼所见。","source":{"text":"臣愚以为传闻不如亲见，视景（影）不如察形。","book":"《后汉书·马援传》"},"similar":["耳闻不如目睹"],"usage":"作宾语、定语；用于处事"},{"id":5987,"word":"传闻失实","pinyin":"chuán wén shī shí","abbr":"cwss","explanation":"传闻：辗转传述听到的。由于辗转相传，已不符合起初的情况。","source":{"text":"至塞外群流，江南诸派，道元足迹，皆所未经，故于滦河之正源，三藏水之次序，白檀要阳之建置，俱不免附会乖错，甚至以浙江妄合姚江，尤为传闻失实。","book":"宋·郦道元《水经注》"},"usage":"作谓语、宾语、定语；用于事情等"},{"id":5988,"word":"传闻异辞","pinyin":"chuán wén yì cí","abbr":"cwyc","explanation":"传闻：原指久远的事，后指听来的传说；异辞：原指措词有所不同，后指说法不一致。指传说不一致。","source":{"text":"所见异辞，所闻异辞，所传闻异辞。","book":"《公羊传·隐公元年》"},"example":{"text":"台事～，我们如堕五里雾中。","book":"清·曾朴《孽海花》第三十二回"},"similar":["说法不一"],"opposite":["众口一词"],"usage":"作主语、宾语；指传说不一致"},{"id":5989,"word":"传风扇火","pinyin":"chuán fēng shān huǒ","abbr":"cfsh","explanation":"犹扇风点火。比喻鼓动别人做某种事。多用于贬义。","source":{"text":"这么传风扇火，直扇得玉翠她爹都受了传染——天天替女儿着急，时时埋怨女儿眼皮太高。","book":"康濯《春种秋收·故事》"},"similar":["煽风点火","传风搧火"],"usage":"作谓语、宾语；指煽动闹事"},{"id":5990,"word":"传风搧火","pinyin":"chuán fēng yǒu huǒ","abbr":"cfsh","explanation":"犹煽风点火。搧，同“扇”。比喻煽动别人闹事。多用于贬义。"},{"id":5991,"word":"传龟袭紫","pinyin":"chuán guī xí zǐ","abbr":"cgxz","explanation":"指继承高爵显位。汉制，公侯皆佩紫绶龟纽金印。","source":{"text":"公侯紫绶金印龟纽。","book":"《后汉书·阴识传赞》：“恂恂苗胤，传龟袭紫。”李贤注"},"example":{"text":"夫孝者，非以～为也，非以玉帛充牣为也。","book":"明·宋濂《赠马氏复姓序》"},"similar":["传圭袭组"],"usage":"作宾语、定语；用于继承祖业做官"},{"id":5992,"word":"伤其十指，不如断其一指","pinyin":"shāng qí shí zhǐ，bù rú duàn qí yī zhǐ","abbr":"sqszbrdqyz","explanation":"比喻击溃敌人全部，不如彻底消灭其中一部分。","example":{"text":"这个战略正合乎孙子兵法的“倍则围之”，与“～”的兵学原理。","book":"梁羽生《慧剑心魔》第三十八回"}},{"id":5993,"word":"伤化虐民","pinyin":"shāng huà nǜè mín","abbr":"shnm","explanation":"伤：伤害；化：风俗；虐：残害。破坏传统的风尚习俗，残害平民百姓。","source":{"text":"司空曹操，祖父腾，故中常侍，与左悺、徐璜并作妖孽，饕餮放横，伤化虐民。","book":"《三国志·魏志·袁绍传》裴松之注引《魏晋春秋》"}},{"id":5994,"word":"伤化败俗","pinyin":"shāng huà bài sú","abbr":"shbs","explanation":"指败坏教化和风俗。","source":{"text":"又况掘冢搏掩，犯奸成富，曲叔、稽发、雍乐成之徒，犹夏齿列，伤化败俗，大乱之道也。","book":"《汉书·货殖传》"},"example":{"text":"若有深奸巨猾，～，悖乱人伦，不忠不孝，故为背道者，杀一利百，以清王化，重刑可也。","book":"《周书·苏绰传》"},"similar":["伤风败俗","伤风败化","败俗伤风"],"usage":"作谓语、定语、宾语；多用来遣责"},{"id":5995,"word":"伤天害理","pinyin":"shāng tiān hài lǐ","abbr":"sthl","explanation":"伤、害：损害；天：天道；理：伦理。形容做事凶恶残忍，丧尽天良。","source":{"text":"堂上公以我为天下之龌龊教官，勒索伤天害理之钱，以吮人痈痔者耶？","book":"清·蒲松龄《聊斋志异·吕无病》"},"example":{"text":"只为过于要做官，且急于要做大官，所以～的做到这样。","book":"清·刘鹗《老残游记》第六回"},"similar":["灭绝人性","惨无人道","丧尽天良"],"opposite":["乐善好施"],"usage":"作谓语、宾语、定语；指毫无人性"},{"id":5996,"word":"伤夷折衄","pinyin":"shāng yí zhé nǜ","abbr":"syzn","explanation":"伤夷：创伤；折衄：挫败。受到创伤，遭到失败。","source":{"text":"至乃愚佻短虑，轻进易退，伤夷折衄，数丧师徒。","book":"《三国志·魏志·袁绍传》"},"usage":"作宾语、定语；用于书面语"},{"id":5997,"word":"伤廉愆义","pinyin":"shāng lián qiān yì","abbr":"slqy","explanation":"伤廉：损害廉洁；愆：丧失。指某种行为损害廉洁，丧失道义。","source":{"text":"苟伤廉而愆义，亦虽爱而必捐。","book":"《孟子·离娄下》：“可以取，可以无取，取伤廉。”晋·陆机《文赋》"}},{"id":5998,"word":"伤弓之鸟","pinyin":"shāng gōng zhī niǎo","abbr":"sgzn","explanation":"被弓箭吓怕了的鸟。比喻受过惊吓，遇到一点动静就怕的人。","source":{"text":"伤弓之鸟，落于虚发。","book":"《战国策·楚策四》；《晋书·苻生载记》"},"example":{"text":"败了的，似～。","book":"明·许仲琳《封神演义》第四十三回"},"similar":["惊弓之鸟"],"usage":"作宾语；同“惊弓之鸟”","story":["从前精通射箭的更赢和魏王谈论箭术，刚好一只大雁由东向西飞过，更赢拉弓便射，可惜虚发一箭，谁知大雁应声落地。魏王不解，更赢说：“这只受伤的大雁离了群，飞得低，听到弓弦响，吓得不知道怎么办，一用力伤口破裂而掉地。”"]},{"id":5999,"word":"伤心惨目","pinyin":"shāng xīn cǎn mù","abbr":"sxcm","explanation":"伤心：使人心痛；惨目：惨不忍睹。形容非常悲惨，使人不忍心看。","source":{"text":"伤心惨目，有如是也？","book":"唐·李华《吊古战场文》"},"example":{"text":"因得常哭于芸娘之墓，形单影只，备极凄凉。且偶经故居，～。","book":"清·沈复《浮生六记·坎坷记愁》"},"similar":["惨不忍睹"],"usage":"作谓语、定语；指景象非常凄惨"},{"id":6000,"word":"伤心疾首","pinyin":"shāng xīn jí shǒu","abbr":"sxjs","explanation":"痛心疾首，形容痛心之至。","source":{"text":"吾民伤心疾首之事，孰有过于是耶！","book":"《“五四”爱国运动资料·学界风潮记》"},"similar":["痛心疾首"],"usage":"作谓语、定语；用于书面语"},{"id":6001,"word":"伤心蒿目","pinyin":"shāng xīn hāo mù","abbr":"sxhm","explanation":"旧时指志士仁人对艰危时世的关切忧虑。","source":{"text":"[孔夫子]于是乎就喟叹曰：‘吾与点也，’这句话正是个伤心蒿目之词，不是个志同道合之语。","book":"《儿女英雄传》第三九回"},"example":{"text":"清·文康《儿女英雄传》第39回：“这句话正是个～之词，不是个志同道合之语。”"},"usage":"作谓语、定语；用于书面语"},{"id":6002,"word":"伤教败俗","pinyin":"shāng jiào bài sú","abbr":"sjbs","explanation":"指败坏教化和风俗。同“伤化败俗”。","source":{"text":"今诸小道家浅陋无理，葬得善地，虽杀人巨盗，亦可获福；课得美占，虽弑父与君，亦无大害。伤教败俗，莫过于此。","book":"明·马中锡《罪言》"},"similar":["伤化败俗","伤风败俗"],"usage":"作谓语、定语、宾语；多用来遣责"},{"id":6003,"word":"伤时感事","pinyin":"shāng shí gǎn shì","abbr":"ssgs","explanation":"指为时事而感伤。","example":{"text":"年底下看见小民生计艰难，流言四起，民心浮动，～。","book":"高阳《慈禧全传》四十一"}},{"id":6004,"word":"伤春悲秋","pinyin":"shāng chūn bēi qiū","abbr":"scbq","explanation":"伤：忧思，悲伤。因季节、景物的变化而引起悲伤的情绪。多形容多愁善感。","source":{"text":"绮靡浓艳，伤春悲秋，至于‘春蚕到死’、‘蜡烛成灰’，深情罕譬，可以涸爱河而干欲火。","book":"清·钱谦益《李义山诗笺注》序"}},{"id":6005,"word":"伤筋动骨","pinyin":"shāng jīn dòng gǔ","abbr":"sjdg","explanation":"本指身受重伤。后比喻事物受到重大损害。","source":{"text":"打得来伤筋动骨，更疼似悬头刺股。","book":"元·关汉卿《蝴蝶梦》第二折"},"example":{"text":"此等结束甚妙，生旦相见不十分吃力，相会亦不曾吃力，到底不曾～。","book":"明·周朝俊《红梅记·总评》"},"opposite":["毫发未损"],"usage":"作谓语、定语；指重大改动"},{"id":6006,"word":"伤言扎语","pinyin":"shāng yán zhā yǔ","abbr":"syzy","explanation":"方言。指说讽刺话。","source":{"text":"伤言扎语，学生们听了，心里不好受。","book":"周立波《山乡巨变》上二十：“嫂嫂指鸡骂狗，伤言扎语，家里一天也待不下去了。”又《盖满爹》"},"usage":"作谓语、宾语；用于口语"},{"id":6007,"word":"伤财劳众","pinyin":"shāng cái láo zhòng","abbr":"sclz","explanation":"伤：耗费；劳：病。既使人劳苦，又浪费钱财。","source":{"text":"毕竟鳅船难取胜，伤财劳众枉徒然。","book":"明·施耐庵《水浒传》第80回"},"similar":["劳民伤财"],"usage":"作谓语、定语、宾语；指无益的劳动"},{"id":6008,"word":"伤风败俗","pinyin":"shāng fēng bài sú","abbr":"sfbs","explanation":"伤、败：败坏。指败坏社会风俗。多用来遣责道德败坏的行为。","source":{"text":"伤风败俗，传笑四方，非细事也。","book":"唐·韩愈《论佛骨表》"},"example":{"text":"纣王以为妲己好意，岂知内藏～之情，大坏纲常礼义之防。","book":"明·许仲琳《封神演义》第十九回"},"similar":["不堪入目","不堪入耳","伤化败俗"],"opposite":["高风亮节","移风易俗"],"usage":"作谓语、定语、宾语；指道德败坏的行为","story":["唐朝文学家韩愈在担任国子监博士期间，见唐宪宗把佛祖释迦牟尼的一块遗骨迎进宫内供奉，他特写《论佛骨表》劝谏唐宪宗说：“佛教并不能使人长寿，有的百姓愚昧无知，发疯地自残，干出一些伤风败俗的事情，于国于民都不利。”"]},{"id":6009,"word":"伤风败化","pinyin":"shāng fēng bài huà","abbr":"sfbh","explanation":"指败坏社会风俗。多用来遣责道德败坏的行为。同“伤风败俗”。","source":{"text":"世人都把那淫欲之事当作‘情’字，所以作出伤风败化的事来，还自谓风月多情，无关紧要。","book":"清·曹雪芹《红楼梦》第一一一回"},"example":{"text":"清·无名氏《刘公案》第59回：“分明是～弄谣言！”"},"similar":["伤风败俗","毁风败俗"],"usage":"作谓语、定语；指道德败坏的行为"},{"id":6010,"word":"伫候佳音","pinyin":"zhù hòu jiā yīn","abbr":"zhjy","explanation":"伫：久立而等待。久久站着等候好的消息。","example":{"text":"请～吧。"},"similar":["静候佳音"],"usage":"作谓语；指殷切盼望"},{"id":6011,"word":"伫结之情","pinyin":"zhù jié zhī qíng","abbr":"zjzq","explanation":"伫：长久地站着；结：企望之情郁积。指极为深沉的思念之情。","source":{"text":"相与乡里，隔绝日久，会遇甚难。时事利害，人各有心，非所论也。愿单出一相见，以写伫结之情。","book":"《资治通鉴·晋纪·孝宗永和七年》"},"usage":"作宾语；用于书面语"},{"id":6012,"word":"伯乐一顾","pinyin":"bō lè yī gù","abbr":"blyg","explanation":"比喻受人知遇赏识。","source":{"text":"《战国策·燕策二》载：战国时，苏代说淳于髡，谓人有告伯乐曰，臣有骏马欲卖，连三旦立于市，人莫与言；愿子一顾之，请献一朝之费。伯乐乃环而视之，去而顾之，一旦而马价十倍。"},"example":{"text":"数蒙～之价，而苍蝇之飞，不过数步，即托骥尾，得以绝群。","book":"《后汉书·隗嚣传》"},"similar":["伯乐相马"],"usage":"作宾语、定语；指得到名人的赏识","story":["春秋时期，秦穆公的相马专家孙阳特别善于观察品评马匹的优劣，人们用神话中掌管天马的星宿名“伯乐”来称赞他，凡他相中的马，身价立即提高。一次有人牵马去市场卖，三天都没人问津，他请伯乐去光顾，立即就有人高价收购"]},{"id":6013,"word":"伯乐相马","pinyin":"bó lè xiàng mǎ","abbr":"blxm","explanation":"伯乐：相传为秦穆公时的人，姓孙名阳，善相马。指个人或集体发现、推荐、培养和使用人才的人。","source":{"text":"她带上多年写下的社会科学论文和空前的决心去接受伯乐相马的考验了。","book":"《十月》1981年第6期"},"example":{"text":"我们盼望有～的机会。"},"similar":["伯乐选马"],"usage":"作宾语、定语；用于选人才","story":["春秋时期，秦国选马大臣孙阳，世称伯乐，他专门为秦穆公在全国挑选千里马，凡是经过他挑出的好马一定是千里马。一次他选中一匹病马经过精心饲养，恢复了千里马的本色，三个月后便随秦穆公攻下12个国家，称霸中原"]},{"id":6014,"word":"伯仁由我而死","pinyin":"bó rén yóu wǒ ér sǐ","abbr":"brywes","explanation":"伯仁：晋周颙的字。表示对别人的死亡负有某种责任。","source":{"text":"吾虽不杀伯仁，伯仁由我而死。","book":"《晋书·周颙传》"},"example":{"text":"倘～，尚不免罪有所归。","book":"清·纪昀《阅微草堂笔记·姑妄听之二》"},"usage":"作宾语、分句；指对别人的死感到内疚","story":["晋元帝时期，仆射周颙与宰相王导是好朋友，王导的堂兄王敦谋反杀了周颙。王敦曾经因此事征求王导的意见，王导未置可否。后来王导得知周颙曾在元帝面前为王敦谋反事多次为自己辩护，不禁流泪感慨：“我虽没杀他，但他由我而死。”"]},{"id":6015,"word":"伯仲之间","pinyin":"bó zhòng zhī jiān","abbr":"bzzj","explanation":"伯仲：兄弟排行的次第，伯是老大，仲是老二；间：中间。比喻差不多，难分优劣。","source":{"text":"傅毅之于班固，伯仲之间耳。","book":"三国·魏·曹丕《曲论·论文》"},"example":{"text":"～见伊吕，指挥若定失萧曹。","book":"唐·杜甫《咏怀古迹》诗"},"similar":["不相上下"],"opposite":["天渊之别","天壤之别"],"usage":"作谓语、补语；用于两人才能、势力不相上下"},{"id":6016,"word":"伯仲叔季","pinyin":"bó zhòng shū jì","abbr":"bzsj","explanation":"兄弟排行的次序，伯是老大，仲是第二，叔是第三，季是最小的。","source":{"text":"亦唯伯仲叔季图之。","book":"春秋·鲁·左丘明《左传·昭公二十六年》"},"example":{"text":"请按～的顺序排列。"},"similar":["甲乙丙丁"],"usage":"作宾语、定语；指排列顺序"},{"id":6017,"word":"伯俞泣杖","pinyin":"bó yú qì zhàng","abbr":"byqz","explanation":"指孝顺父母。","source":{"text":"伯俞有过，其母笞之，泣，其母曰：‘他日笞子未尝见泣，今泣何也？’对曰：‘他日俞得罪，笞尝痛，今母之之力不能使痛，是以泣。","book":"汉·刘向《说苑·建本》"},"example":{"text":"你孝顺似那王祥卧冰，你恰似～。","book":"元·关汉卿《陈母教子》第三折"},"usage":"作宾语、定语；指孝顺父母","story":["相传古代有名的孝子伯俞犯了错误，他的母亲拿拐杖打他，伯俞哭了，母亲觉得奇观，问他为什么哭。他说：“以前我犯错时你打我，我感觉到痛，如今你老了，不能打痛我了。是我不好，还让年迈的你为我操心，心中有愧。”"]},{"id":6018,"word":"伯劳飞燕","pinyin":"bó láo fēi yàn","abbr":"blfy","explanation":"借指离别的亲人或朋友。","source":{"text":"东飞伯劳西飞燕，黄姑织女时相见。","book":"《玉台新咏·古词〈东飞伯劳歌〉》"},"example":{"text":"～东西别，忍向江城一笛吹。","book":"郁达夫《别戴某》诗"},"similar":["劳燕分飞"],"usage":"作主语、宾语；指离别的亲人"},{"id":6019,"word":"伯埙仲篪","pinyin":"bó xūn zhòng chí","abbr":"bxzc","explanation":"伯、仲：兄弟排行的次第，伯是老大，仲是老二；埙：陶土烧制的乐器；篪：竹制的乐器。埙篪合奏，乐音和谐。旧时赞美兄弟和睦。","source":{"text":"伯氏吹埙，仲氏吹篪。","book":"《诗经·小雅·何人斯》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“玉昆金友，羡兄弟之俱贤；～，谓声气之相应。”"},"opposite":["兄弟阋墙"],"usage":"作宾语、定语；用于赞美别人兄弟"},{"id":6020,"word":"伯歌季舞","pinyin":"bó gē jì wǔ","abbr":"bgjw","explanation":"伯：大哥；季：小弟。哥哥唱歌，弟弟跳舞。比喻兄弟之间亲密无间。","source":{"text":"秋风牵手，相提笑语。伯歌季舞，燕乐以喜。","book":"汉·焦赣《易林·否之损》"},"example":{"text":"他们家两兄弟～，共同面对困难。"},"opposite":["兄弟阋墙"],"usage":"作定语、分句；形容兄弟友爱"},{"id":6021,"word":"伯牙绝弦","pinyin":"bó yá jué xián","abbr":"byjx","explanation":"牙：伯牙。钟子期死后，伯牙从此不弹琴。比喻知音的难遇。","source":{"text":"是故钟期死，伯牙绝弦破琴而不肯与众鼓。","book":"《汉书·扬雄传》"},"example":{"text":"～失子期，更无知音之辈；管宁割席拒华歆，调非同志之人。","book":"清·程允升《幼学琼林·朋友宾主》"}},{"id":6022,"word":"伯牛之疾","pinyin":"bó niú zhī jí","abbr":"bnzj","explanation":"伯牛：人名，春秋鲁国人，孔子弟子。伯牛不幸生了癞疮，那里是不治之症。因此用以指人患的不治的恶疾。","source":{"text":"伯牛有疾，子问之，自牖执其其手曰：‘亡之，命矣夫！斯人也，而有斯疾也，斯人也，而有斯疾也。’","book":"《论语·雍也》"}},{"id":6023,"word":"伯玉知非","pinyin":"bó yù zhī fēi","abbr":"byzf","explanation":"伯玉：蘧瑗，字伯玉，春秋时卫国人；非：不对。比喻知道以前不对。","source":{"text":"故蘧瑗伯玉年五十，而有四十九年非。","book":"《淮南子·原道训》"},"usage":"作宾语、定语；指认识错误"},{"id":6024,"word":"伯虑愁眠","pinyin":"bó lǜ chóu mián","abbr":"blcm","explanation":"伯虑：国名；愁：忧愁。伯虑国的人忧虑睡眠。形容太过忧虑。","source":{"text":"海外都说：‘杞人忧天，伯虑愁眠。’","book":"清·李汝珍《镜花缘》第27回"},"example":{"text":"你这是～，自寻烦恼。"},"similar":["杞人忧天"],"usage":"作宾语、定语；指过虑"},{"id":6025,"word":"伯道无儿","pinyin":"bó dào wú ér","abbr":"bdwe","explanation":"伯道：邓伯道。旧时对他人无子的叹息。","source":{"text":"天道无知，使邓伯道无儿。","book":"《晋书·邓攸传》"},"example":{"text":"中郎有女能传业，～可保家。","book":"唐·韩愈《游西林寺题萧二兄郎中旧堂》"},"opposite":["儿孙满堂"],"usage":"作宾语、定语；多为同情、惋惜","story":["晋代邓攸，字伯道，襄陵人。为了躲避战乱，带着儿子和侄儿一起逃难，在危难关头，舍弃自己的儿子，保全了侄儿。后来他终身没有孩子，当时很多人为之感动，抱憾地说：“天道无知，使邓伯道无儿。”"]},{"id":6026,"word":"伴君如伴虎","pinyin":"bàn jūn rú bàn hǔ","abbr":"bjrbh","explanation":"陪伴君王像陪伴老虎一样，随时有杀身之祸。指大人物喜怒无常","source":{"text":"古人云：‘伴君如伴虎，刻刻要当心。","book":"清·无名氏《说呼全传》第四回"},"usage":"作宾语、定语；用于处世等"},{"id":6027,"word":"伴风搭雨","pinyin":"bàn fēng dā yǔ","abbr":"bfdy","explanation":"伴随着风雨做事，形容为人辛苦。","example":{"text":"我们终于结束了这～的旅程。"},"usage":"作谓语、定语、宾语；用于处事"},{"id":6028,"word":"伴食中书","pinyin":"bàn shí zhōng shū","abbr":"bszs","explanation":"指执政大臣庸懦而不堪任事。","source":{"text":"孙近傅会桧议，遂得参知政事，天下望治有如饥渴，而近伴食中书，漫不敢可否事。","book":"《宋史·胡铨传》"},"example":{"text":"人有投匿名诗云：“文章声价斗山齐，～日又西；回首湘江春水绿，鹧鸪啼罢子规啼。”","book":"明·郎瑛《七修类稿·事物·李西涯》"},"similar":["伴食宰相"],"usage":"作主语、宾语；比喻碌碌无为的官员"},{"id":6029,"word":"伴食宰相","pinyin":"bàn shí zǎi xiàng","abbr":"bszx","explanation":"伴食：陪着人家一道吃饭。用来讽刺无所作为，不称职的官员。","source":{"text":"开元三年，迁黄门监。怀慎与紫微令姚崇对掌枢密，怀慎自以为吏道不及崇，每事皆推让之，时人谓之伴食宰相。","book":"《旧唐书·卢怀慎传》"},"example":{"text":"愿他此去调羹庙廊，莫做了～。 （明·朱鼎《玉镜台记·得书》）"},"similar":["混世魔王","伴食中书"],"usage":"作主语、宾语；比喻碌碌无为的官员","story":["唐代官员卢怀慎开元三年升黄门监，与紫微令姚崇共同处理军机大事。他胆小怕事、懦弱无能，遇事都不敢自己做主，一切事务全推给姚崇处理。很多人都对卢怀慎的这种吃饭不做事的行为不满，私下送他“伴食宰相”的外号"]},{"id":6030,"word":"伶仃孤苦","pinyin":"líng dīng gū kǔ","abbr":"ldgk","explanation":"伶仃：孤独，没有依靠。孤单困苦，没有依靠。","source":{"text":"伶仃孤苦，至于成立。","book":"晋·李密《陈情表》"},"example":{"text":"高局长被人陷害之后，只她带着儿子，～。","book":"李劼人《天魔舞》第24章"},"similar":["孤苦伶仃"],"usage":"作谓语、定语；指孤独困苦，无依无靠","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母，尊重老人。他想启用西蜀尚书郎李密，就下诏书任命李密为郎中。李密不愿出来做官，就写《陈情表》上书晋武帝，说自己的祖母形影相吊、孤苦伶仃，待伺候祖母后再出来做官"]},{"id":6031,"word":"伶伶仃仃","pinyin":"líng líng dīng dīng","abbr":"lldd","explanation":"指孤苦无依靠。","source":{"text":"宋江怕他不死，再复一刀，那颗头，伶伶仃仃，落在枕头上。","book":"明·施耐庵《水浒传》第21回"},"example":{"text":"清·韩邦庆《海上花列传》第43回：“挂的玻璃灯打碎了一架，～欲坠未坠。”"},"similar":["孤孤单单"],"usage":"作谓语、定语；指单一"},{"id":6032,"word":"伶俐乖巧","pinyin":"líng lì guāi qiǎo","abbr":"llgq","explanation":"伶俐：机灵；乖巧：合人心意。形容人机警，让人满意。","source":{"text":"却说蒋兴歌跟随父亲做客，走了几遍，学得伶俐乖巧，生意行中，百般都会。","book":"明·冯梦龙《喻世明言》卷一"},"example":{"text":"女儿也是～的个孩子，因是初三有新月时候生的，所以叫是勾姐。","book":"清·西周生《醒世姻缘传》第八十四回"},"usage":"作谓语、状语、定语；用于夸奖人"},{"id":6033,"word":"伶牙俐嘴","pinyin":"líng yá lì zuǐ","abbr":"lylz","explanation":"伶：通“灵”，灵活；俐：聪明、乖巧。形容为人机灵，能说会道。","source":{"text":"你划地敢伶牙俐嘴，夸强说会，使不着你唬鬼瞒神。","book":"明·朱权《冲漠子》第二折"},"similar":["伶牙俐齿"],"usage":"作谓语、定语、状语；指人口才好"},{"id":6034,"word":"伶牙俐齿","pinyin":"líng yá lì chǐ","abbr":"lylc","explanation":"伶、俐：聪明，灵活。形容人机灵，很会说话。","source":{"text":"你休那里便伶牙俐齿，调三干四，说人好歹，讦人暧昧，损人行止。","book":"元·吴昌龄《张天师》第三折"},"example":{"text":"元·吴昌龄《张天师》第三折：“你休那里便伶牙俐齿，调三干四，说人好歹，讦人暧昧，损人行止。”"},"similar":["聪明伶俐","玲珑剔透","能说会道"],"opposite":["笨口拙舌","呆头呆脑","张口结舌"],"usage":"作谓语、定语、状语；指人口才好"},{"id":6035,"word":"伶牙利爪","pinyin":"líng yá lì zhǎo","abbr":"lylz","explanation":"爪：动物的脚，这里代指手脚。形容能说会道，聪明能干。","source":{"text":"只是宝玉身边一干人，都是伶牙利爪的，那里插的下手去。","book":"清·曹雪芹《红楼梦》第二十四回"}},{"id":6036,"word":"伶牙利齿","pinyin":"líng yá lì chǐ","abbr":"lylc","explanation":"伶：聪明，乖巧；利：流利，锋利。口齿流利。形容为人机灵，能说会道。","source":{"text":"袭人本来老实，不是伶牙利齿的人，薛姨妈说一句，他应一句。","book":"清·曹雪芹《红楼梦》第120回"},"similar":["伶牙俐齿"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语、状语；指人口才好"},{"id":6037,"word":"伸冤理枉","pinyin":"shēn yuān lǐ wǎng","abbr":"sylw","explanation":"指洗雪冤枉。","source":{"text":"大略多守着现成的案，能有几个伸冤理枉的？","book":"明·凌濛初《二刻拍案惊奇》卷二十一"},"example":{"text":"赔了一千三百的银子，并无领过官银，叫他妻子与他～。","book":"清·西周生《醒世姻缘传》第七十一回"},"usage":"作谓语、定语、宾语；用于处事等"},{"id":6038,"word":"伸大拇哥","pinyin":"shēn dà mǔ gē","abbr":"sdmg","explanation":"竖起大拇指称赞。","example":{"text":"对于她的表现，全班都～。"},"usage":"作谓语；用于口语"},{"id":6039,"word":"伸头探脑","pinyin":"shēn tóu tàn nǎo","abbr":"sttn","explanation":"不断伸着脑袋张望。形容迟疑观望，或心中有鬼。","source":{"text":"他在那锅门前，更无心烧火，不时的伸头探脑，出来观看。","book":"明·吴承恩《西游记》第二十四回"},"example":{"text":"又走不上几步，转过弯来，只见宋信在那里～的张望。","book":"明·罗贯中《平山冷燕》第十八回"},"similar":["舒头探脑"],"usage":"作谓语、定语、状语；指人的行为"},{"id":6040,"word":"伸头缩颈","pinyin":"shēn tóu suō jǐng","abbr":"stsj","explanation":"形容在暗中察看的神态。","source":{"text":"豪门送物鹅伸颈，好客临门鳖缩头。","book":"清·翟灏《能人编·身体》"},"similar":["伸头探脑"],"usage":"作定语、状语；用于处事"},{"id":6041,"word":"伸手不见五指","pinyin":"shēn shǒu bù jiàn wǔ zhǐ","abbr":"ssbjwz","explanation":"形容光线非常暗，看不见四周围的事物。","source":{"text":"走入一间小房，黑漆漆的伸手不见五指，脚踏下去，七高八低，都是泥土。","book":"清·颐琐《黄绣球》第四回"},"example":{"text":"外面～，我们得准备手电。"},"similar":["漆黑一团"],"usage":"作谓语、定语；形容天很黑"},{"id":6042,"word":"伸手不见掌","pinyin":"shēn shǒu bù jiàn zhǎng","abbr":"ssbjz","explanation":"形容光线非常暗，看不见四周围的事物。","source":{"text":"问：‘如何有和尚家风？’师曰：‘伸手不见掌。’","book":"宋·释普济《五灯会元》卷十二"},"example":{"text":"那真的赵知县在阶下，也不等大尹台旨，解开黄袱，揭开盒子，只见风雨便下，～。","book":"明·冯梦龙《警世通言》卷三十六"}},{"id":6043,"word":"伸手可得","pinyin":"shēn shǒu kě dé","abbr":"sskd","explanation":"一伸手就可以取得。比喻极容易得到。","source":{"text":"自谓状元探手可得，岂知时运不济，榜上无名。","book":"元·无名氏《王月英元夜留鞋记》楔子"}},{"id":6044,"word":"伸眉吐气","pinyin":"shēn méi tǔ qì","abbr":"smtq","explanation":"舒展眉头，吐出怨气。形容摆脱了长期受压状态后高兴痛快的样子。","source":{"text":"何惜阶前盈尺之地，不使白扬眉吐气，激昂青云耶？","book":"唐·李白《与韩荆州书》"},"similar":["扬眉吐气"],"opposite":["忍生吞气"],"usage":"作谓语、定语、状语；指高兴"},{"id":6045,"word":"伸钩索铁","pinyin":"shēn gōu suǒ tiě","abbr":"sgst","explanation":"把錣伸直，把铁成索。形容力量极大。","source":{"text":"帝桀淫虐有才，力能伸钩索铁，手搏熊虎。","book":"晋·皇甫谧《帝王世纪》"},"similar":["握钩伸铁"],"usage":"作谓语、定语；指力大"},{"id":6046,"word":"伺瑕导蠙","pinyin":"sì xiá dǎo pín","abbr":"sxdp","explanation":"指寻衅生事。"},{"id":6047,"word":"伺瑕导隙","pinyin":"sì xiá dǎo xì","abbr":"sxdx","explanation":"指寻衅生事。","source":{"text":"日本必欲取之者，非报德也，非助英也，盖欲伺瑕导隙，借以问鼎神州。","book":"李大钊《警告全国父老书》"},"similar":["伺瑕抵隙"],"usage":"作谓语、宾语；指寻衅生事"},{"id":6048,"word":"伺瑕抵蠙","pinyin":"sì xiá dǐ pín","abbr":"sxdp","explanation":"指寻衅生事。同“伺瑕导蠙”。"},{"id":6049,"word":"伺瑕抵隙","pinyin":"sì xiá dǐ xì","abbr":"sxdx","explanation":"指寻衅生事。同“伺瑕导蠙”。","source":{"text":"习于旧污者，视民主政治为仇雠，伺瑕抵隙，思中伤之为快。","book":"孙中山《自传》"},"similar":["伺瑕导隙"],"usage":"作谓语、宾语；指寻衅生事"},{"id":6050,"word":"伺间候隙","pinyin":"sì jiàn hòu xì","abbr":"cjhx","explanation":"利用空隙或漏洞以等待机会。","source":{"text":"王弥好乱乐祸，挟诈怀奸，命俦啸侣，伺间候隙。","book":"晋·傅玄《傅子》：“分任授职，乘间伺隙，兵不妄动，故战少败而江南安。”《晋书·王弥等传论》"}},{"id":6051,"word":"似懂非懂","pinyin":"sì dǒng fēi dǒng","abbr":"sdfd","explanation":"好像懂，又好象不懂。","source":{"text":"然而学生还是似懂非懂，教他们回讲往往讲不出来。","book":"叶圣陶《得失》"},"example":{"text":"他～的还没完全明白过来。"},"similar":["一知半解"],"opposite":["了如指掌","心中有数"],"usage":"作谓语；用于事情等"},{"id":6052,"word":"似是而非","pinyin":"sì shì ér fēi","abbr":"ssef","explanation":"似：像；是：对；非：不对。好像是对的，实际上不对。","source":{"text":"孔子曰：‘恶似而非者。’","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"同学们的讲解，有的～，有的简直错得可笑。","book":"叶圣陶《文心》"},"similar":["以假乱真","张冠李戴"],"opposite":["天经地义","不刊之论"],"usage":"作谓语、定语、状语；指没弄懂","story":["战国时期，庄子带学生游学各地，见伐木工人砍树问为什么不去砍大树，工人说因为它已没有用处了。到了朋友家，仆人问杀鸡的事，主人说杀不会打鸣的鸡。庄子对学生说：“应该处于有用和无用之间，似是而非，这样才谁也抓不住把柄。”"]},{"id":6053,"word":"似曾相识","pinyin":"sì céng xiāng shí","abbr":"scxs","explanation":"好像曾经见过。形容见过的事物再度出现。","source":{"text":"无可奈何花落去，似曾相识燕归来，小园香径独徘徊。","book":"宋·晏殊《浣溪沙》词"},"example":{"text":"文淑忽然惊喜地想到，她看见了一张～的黑黑的脸。","book":"巴金《火》第三部"},"opposite":["素昧平生"],"usage":"作谓语、定语；形容见过的事物再度出现"},{"id":6054,"word":"似有如无","pinyin":"sì yǒu rú wú","abbr":"syrw","explanation":"只当没有这回事。形容不在乎，不在意。","source":{"text":"眼见的争名夺利眉儿先皱，耳听着受职为官胆儿便虚，俺子当似有如无。","book":"明·冯惟敏《涞邑初度自述》"},"example":{"text":"这春梅也不瞧，接过来～，掠在抽屉内。","book":"《金瓶梅词话》第七三回"},"usage":"作谓语、定语；用于处事等"},{"id":6055,"word":"似梦初觉","pinyin":"sì mèng chū jué","abbr":"smcj","explanation":"像刚从梦中醒来。比喻过去一直糊涂，刚刚明白过来。","source":{"text":"三藏闻言，如醉方醒，似梦初觉，乐以忘忧，称谢不尽。","book":"明·吴承恩《西游记》第54回"},"similar":["如梦初觉","如梦初醒","如梦方醒"],"usage":"作谓语、定语、状语；形容人突然醒悟"},{"id":6056,"word":"似水如鱼","pinyin":"sì shuǐ rú yú","abbr":"ssry","explanation":"像鱼和水一样不能离开。形容关系密切，不可分离。多指男女情人。","source":{"text":"李靖人豪，张姬女侠，相逢似水如鱼。","book":"元·王实甫《西厢记》第五本第四折：“若不是大恩人拔刀相助，怎能勾好夫妻似水如鱼。”明·张凤翼《红拂记·传奇大意》"},"example":{"text":"[正旦唱]这厮只因饱暖生淫欲……[正旦唱]便休想～。","book":"明·贾仲名《对玉梳》第三折"},"similar":["如鱼似水"],"usage":"作谓语、定语、状语；多用于夫妻或情侣等"},{"id":6057,"word":"似水柔情","pinyin":"sì shuǐ róu qíng","abbr":"ssrq","explanation":"柔：温柔。温柔的情感象水一样。形容男女之间情思缠绵不断。","source":{"text":"柔情似水，佳期如梦，忍顾鹊桥归路。","book":"宋·秦观《鹊桥仙》词"}},{"id":6058,"word":"似水流年","pinyin":"sì shuǐ liú nián","abbr":"ssln","explanation":"流年：光阴。形容时间一去不复返。","source":{"text":"则为你如花美眷，似水流年，是答儿闲寻遍，在幽闺自怜。","book":"明·汤显祖《牡丹亭·惊梦》"},"example":{"text":"又侧耳时，只听唱道：‘则为你如花美眷，～，……’","book":"清·曹雪芹《红楼梦》第23回"},"similar":["光阴似箭","日月如梭"],"opposite":["度日如年"],"usage":"作主语、宾语；形容时间流逝之快"},{"id":6059,"word":"似漆如胶","pinyin":"sì qī rú jiāo","abbr":"sqrj","explanation":"形容情投意合，难舍难分。","source":{"text":"亲哥，我和你同心合意，似漆如胶，并不曾有半点儿差池，你为何今日有不瞅不睬之意？","book":"明·施耐庵《水浒传》第四七回：“徒闻似漆与如胶，利害场中忍便抛。”明·方汝浩《禅真逸史》第十三回"},"example":{"text":"真是言和意顺，～。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["如胶似漆","如胶如漆","如胶投漆"],"usage":"作谓语、状语、定语；形容关系极为密切"},{"id":6060,"word":"似漆投胶","pinyin":"sì qī tóu jiāo)","abbr":"sqtj","explanation":"象胶和漆那样黏结。形容感情炽烈，难舍难分。多指夫妻恩爱。","source":{"text":"以胶投漆中，谁能别离此。","book":"《史记·鲁仲连邹阳列传》：“感于心，合于行，亲于胶漆，昆弟不能离，岂惑于众口哉。”《古诗十九首·孟冬寒气至》"},"example":{"text":"金奴与吴山在楼上，如鱼得水，～，两个无非说些深情密意的话。","book":"明·冯梦龙《喻世明言》卷三"}},{"id":6061,"word":"似玉如花","pinyin":"sì yù rú huā","abbr":"syrh","explanation":"似：似乎，好像。像美玉和鲜花那样美好。形容女子姿容美艳。","source":{"text":"公寓的老板就能请出一两位似玉如花的大姑娘作陪。","book":"老舍《赵子曰》"},"example":{"text":"这儿的姑娘个个长得～。"},"similar":["如花似玉"],"usage":"作谓语、定语、状语；形容女子姿容秀丽"},{"id":6062,"word":"似笑非笑","pinyin":"sì xiào fēi xiào","abbr":"sxfx","explanation":"像笑又不笑。","source":{"text":"后来大家又都知道了她的脾气，只要有孩子在眼前，便似笑非笑的先问她。","book":"鲁迅《彷徨·祝福》"},"example":{"text":"后来见的次数多了，大家～，用以代替招呼。","book":"苏青《结婚十年》第四章"}},{"id":6063,"word":"似箭在弦","pinyin":"sì jiàn zài xián","abbr":"sjzx","explanation":"好像箭已经搭在弓弦上，不得不发。","source":{"text":"一句问话，似箭在弦，直冲到眉卿的脸上了。","book":"茅盾《子夜》八"}},{"id":6064,"word":"似醉如痴","pinyin":"sì zuì rú chī","abbr":"szrc","explanation":"犹如醉如痴。形容神态失常，失去自制。","source":{"text":"着人脑盖天灵碎，唬的他似醉如痴。","book":"明·无名氏《魏徵改诏》第二折"},"example":{"text":"明·施耐庵《水浒传》第72回：“酒保说柴进的话，王班直～，回到家中。”"},"similar":["如醉如痴"],"usage":"作谓语、定语、状语；指神态失常"},{"id":6065,"word":"似非而是","pinyin":"sì fēi ér shì","abbr":"sfes","explanation":"看来与常识相矛盾或相反而事实上却可能是正确的。","example":{"text":"这一项～的答案让我迷迷糊糊。"},"opposite":["似是而非"],"usage":"作谓语、定语；用于书面语"},{"id":6066,"word":"但愿如此","pinyin":"dàn yuàn rú cǐ","abbr":"dyrc","explanation":"希望能这样。多表示怀疑。","source":{"text":"但愿长如此，躬耕非所叹。","book":"晋·陶潜《庚戌岁九月中于西田获早稻》"},"example":{"text":"～，我们还得努力。"},"usage":"作谓语、分句；指就这样"},{"id":6067,"word":"但求无过","pinyin":"dàn qiú wú guò","abbr":"dqwg","explanation":"但：仅，只要；过：错误。只追求没有过错。形容做事保守平庸怕出差错。","source":{"text":"明知不对，少说为佳；明哲保身，但求无过。","book":"毛泽东《反对自由主义》"},"example":{"text":"很多人都抱着不求有功，～的想法。"},"usage":"作谓语；指人保守"},{"id":6068,"word":"位不期骄","pinyin":"wèi bù qī jiāo","abbr":"wbqj","explanation":"指地位高了，就会骄傲。","source":{"text":"位不期骄，禄不期侈，恭俭惟德，无载尔伪。","book":"《书·周官》"},"usage":"作谓语、定语；用于书面语"},{"id":6069,"word":"位卑言高","pinyin":"wèi bēi yán gāo","abbr":"wbyg","explanation":"指职位低的人议论职位高的人主持的政务。","source":{"text":"位卑而言高，罪也。","book":"战国·邹·孟轲《孟子·万章下》"},"example":{"text":"臣本书生……今将告归，不敢终默，～，罪当万死，惟陛下裁赦。","book":"《清波杂志》"},"usage":"作谓语；指职位低的人议论高官主管的政务"},{"id":6070,"word":"位尊势重","pinyin":"wèi zūn shì zhòng","abbr":"wzsz","explanation":"位：官位。指官位越高权势越大。","source":{"text":"今君侯位尊势重，而怀德者鲜，畏威者众，殆非小心求福之道也。","book":"《资治通鉴·魏纪·邵陵厉公中正始九年》"},"example":{"text":"今君侯～，人鲜怀德，徒多畏威，恐非小心求福的道理。","book":"蔡东藩《后汉演义》第九十六回"}},{"id":6071,"word":"位尊贱隔","pinyin":"wèi zūn jiàn gé","abbr":"wzjg","explanation":"位：官位；贱：指地位卑贱的人，即老百姓。官位越高就与百姓之间的距离越大。","source":{"text":"阁下位益尊，伺候于门墙者日益进，夫位益尊则贱者日隔。","book":"唐·韩愈《与陈给事书》"}},{"id":6072,"word":"位居极品","pinyin":"wèi jū jí pǐn","abbr":"wjjp","explanation":"极：顶点。指大臣中地位最高的人，泛指身为重臣，官位很高。","example":{"text":"作为～的人，你不应该犯这样的错误。"},"similar":["位极人臣","贵极人臣"],"usage":"作谓语、宾语；泛指身为重臣"},{"id":6073,"word":"位望通显","pinyin":"wèi wàng tōng xiǎn","abbr":"wwtx","explanation":"旧指地位和声望都很显赫。","source":{"text":"及位望通显，每崇俭素，不尚华丽。","book":"《晋书·刘寔传》"},"example":{"text":"大亮虽～，而居处卑陋，衣服俭率。","book":"《旧唐书·李大亮传》"}},{"id":6074,"word":"位极人臣","pinyin":"wèi jí rén chén","abbr":"wjrc","explanation":"君主时代指大臣中地位最高的人。","source":{"text":"吾本东方下士，误用于先帝，位极人臣，禄赐百亿。","book":"三国·蜀·诸葛亮《答李严书》"},"example":{"text":"虽～，皆行尸走骨矣。","book":"宋·张君房《云笈七签》卷六十"},"similar":["位居极品"],"usage":"作谓语、宾语；泛指身为重臣"},{"id":6075,"word":"位极则残","pinyin":"wèi jí zé cán","abbr":"wjzc","explanation":"位：官位；残：凶暴，残忍。指统治者地位越高越残忍。","source":{"text":"宠之以位，位极则残；顺之以恩，恩竭则慢。","book":"明·罗贯中《三国演义》第六十五回"}},{"id":6076,"word":"低三下四","pinyin":"dī sān xià sì","abbr":"dsxs","explanation":"形容态度卑贱低下也指工作性质卑贱低下。","source":{"text":"我常州姓沈的，不是甚么低三下四的人家。","book":"清·吴敬梓《儒林外史》第四十回"},"example":{"text":"想当初，我在城里头作艺，不肯～地侍候有势力的人，教人家打了一顿。","book":"老舍《龙须沟》第一幕"},"similar":["低眉顺眼","俯首帖耳","奴颜婢膝"],"opposite":["不可一世","神气活现","盛气凌人"],"usage":"作谓语、定语、状语；指对人的态度"},{"id":6077,"word":"低人一等","pinyin":"dī rén yī děng","abbr":"dryd","explanation":"比别人低一级。多指社会地位低下。","source":{"text":"这一点使孙少平非常高兴，觉得自己并不是什么都低人一等。","book":"路遥《平凡的世界》第一卷第三章"},"example":{"text":"来自农村的孩子不要有～的想法。"},"opposite":["高人一等"],"usage":"作谓语、定语；指不如别人"},{"id":6078,"word":"低低切切","pinyin":"dī dī qiè qiè","abbr":"ddqq","explanation":"形容声音低微细小。","source":{"text":"吾与(汝)并肩携手，低低切切，何事不语？何情不诉。","book":"清·林觉民《与妻书》"},"usage":"作谓语、定语；形容声音低"},{"id":6079,"word":"低吟浅唱","pinyin":"dī yín qiǎn chàng","abbr":"dyqc","explanation":"低吟：低声吟咏。浅唱小声唱歌。形容小声哼着抒情歌曲。也形容小虫在夜里鸣唱。","example":{"text":"小虫在～，星星在眨眼，夜色十分迷人。"},"usage":"作谓语、宾语；用于唱歌等"},{"id":6080,"word":"低唱浅斟","pinyin":"dī chàng qiǎn zhēn","abbr":"dcqz","explanation":"低唱：轻柔地歌唱；斟：喝酒。听人轻柔地歌唱,并自在地慢慢饮酒。形容一种安乐自在的神态。","source":{"text":"陶谷学士，尝买得党太尉家故妓。过定陶，取雪水烹团茶，谓妓曰：‘彼粗人也，安有此景，但能销金暖帐下，浅斟低唱，饮羊羔美酒耳。’谷愧其言。","book":"宋·无名氏《湘湖近事》"},"example":{"text":"诗难咏，画怎描，欠渔翁玉蓑独钓。～金帐晓，胜烹茶党家风调。","book":"元·卢挚《寿阳曲》"},"similar":["浅斟低唱"],"usage":"作谓语、定语；形容一种安乐自在的神态"},{"id":6081,"word":"低唱浅酌","pinyin":"dì chàng qiǎn zhuó","abbr":"dcqz","explanation":"低唱：轻柔地歌唱；酌：饮酒。听人轻柔地歌唱，并自在地慢慢饮酒。形容一种安乐自在的神态。","source":{"text":"则这今晚开筵，正是中秋令节。只合低唱浅酌，莫待他花残月缺。","book":"元·关汉卿《望江亭》第三折"}},{"id":6082,"word":"低回不已","pinyin":"dī huí bù yǐ","abbr":"dhby","explanation":"低回：徘徊留恋；不已：不停止。不停地徘徊，留恋忘返。形容伤感难忘的心情。","source":{"text":"低回阴山翔以纡曲兮，吾乃今目睹西王母曤然白首。","book":"《史记·司马相如列传》"}},{"id":6083,"word":"低声下气","pinyin":"dī shēng xià qì","abbr":"dsxq","explanation":"形容说话和态度卑下恭顺的样子。","source":{"text":"更瘦小低声下气，送暖偷寒，逢其所喜，避其所讳。","book":"明·冯梦龙《醒世恒言》卷三"},"example":{"text":"宝玉背地里拉着他，～，要问黛玉的话，紫娟从没好话回答。","book":"清·曹雪芹《红楼梦》第一○○回"},"similar":["低三下四"],"opposite":["不卑不亢"],"usage":"作谓语、定语、状语；指人卑微","story":["大观园内的快枯死的海棠反季节开花，预示将有大事发生。不久贾宝玉把从娘胎里衔出的通灵宝玉丢了，贾府上下都出动为宝玉找玉，宝玉因此大病一场，只苦了袭人，在宝玉跟前低声下气的伏侍劝慰。元妃这时去世，让贾府上下雪上加霜，从此走下坡路"]},{"id":6084,"word":"低声哑气","pinyin":"dī shēng yǎ qì","abbr":"dsyq","explanation":"犹言低声下气。","source":{"text":"陈颜低声哑气答道：‘本县知县相公，在此拜方义士。’","book":"《醒世恒言·李汧公穷邸遇侠客》"},"similar":["低声下气"],"usage":"作谓语、定语、状语；指人卑微"},{"id":6085,"word":"低声细语","pinyin":"dī shēng xì yǔ","abbr":"dsxy","explanation":"形容小声说话。","source":{"text":"汤阿英在枕边低声细语说了最近的往来，时断时续，还是有些羞答答的，怕难为情。","book":"周而复《上海的早晨》第一部"},"example":{"text":"她们在～地议论最近的事。"},"similar":["窃窃私语"],"opposite":["粗声粗气"],"usage":"作主语、宾语、状语；指小声说话"},{"id":6086,"word":"低头下心","pinyin":"dī tóu xià xīn","abbr":"dtxx","explanation":"下心：屈服于人。形容屈服顺从。","source":{"text":"他连忙低头下心的劝道：‘不要着急，不要着急，我说着玩玩的！房里冷，快来睡！’","book":"郑振铎《风波》"},"similar":["低头俯心","低首下心"],"usage":"作谓语、定语、状语；指屈服"},{"id":6087,"word":"低头丧气","pinyin":"dī tóu sàng qì","abbr":"dtsq","explanation":"指失意颓丧的样子。","source":{"text":"严畯低头丧气而不能对。","book":"《三国演义》第四三回"},"example":{"text":"这位‘管乐’西服革履，趾高气扬。后来忽然～起来。","book":"孙犁《澹定集摘抄》"},"similar":["垂头丧气"],"usage":"作谓语、定语、状语；形容受挫折无精打采"},{"id":6088,"word":"低头倾首","pinyin":"dī tóu qīng shǒu","abbr":"dtqs","explanation":"垂着头。形容小心翼翼而顺从的样子。","source":{"text":"憕世无贵世，解褐不守侍郎，既羁旅，不被擢用。常叹曰：‘岂能五十年戴帻，死一校尉，低头倾首，俯仰而向人也。’常郁郁不得志。","book":"《北史·薛憕传》"}},{"id":6089,"word":"低头哈腰","pinyin":"dī tóu hā yāo","abbr":"dthy","explanation":"指谦卑恭顺的样子。","source":{"text":"‘请说吧，请说吧。’检验员低头哈腰的，‘别说一件，就是十件我也不推辞。’","book":"陆文夫《荣誉》"},"example":{"text":"做人不能～。"},"similar":["点头哈腰"],"opposite":["昂首挺胸","扬眉吐气"],"usage":"作谓语、定语；指卑微"},{"id":6090,"word":"低头搭脑","pinyin":"dī tóu dā nǎo","abbr":"dtdn","explanation":"形容惶恐或无精打采的样子。同“低头耷脑”。","source":{"text":"老祥子大娘正点着灯做晚饭，看见朱老巩走进来，低头搭脑坐在台阶上。","book":"梁斌《红旗谱》一"},"similar":["低头耷脑"],"usage":"作谓语、状语；指无精打采的样子"},{"id":6091,"word":"低头耷脑","pinyin":"dī tóu dā nǎo","abbr":"dtdn","explanation":"形容惶恐或无精打采的样子。","source":{"text":"他的办公室也变得冷下来了，谁进来干什么，都低头耷脑，蹑手蹑脚。","book":"袁静《伏虎记》第七回"},"example":{"text":"你怎么老是那么～的！"},"similar":["低头搭脑","垂头丧气"],"opposite":["昂首挺胸"],"usage":"作谓语、状语；指无精打采的样子"},{"id":6092,"word":"低头认罪","pinyin":"dī tóu rèn zuì","abbr":"dtrz","explanation":"低下头承认自己的罪行。","source":{"text":"才使得大量的反革命分子没有藏身之所，而不得不低头认罪、接受改造和重新做人吗？","book":"邓小平《关于修改党的章程的报告》"},"example":{"text":"面对强大的舆论攻势，他只好～了。"},"usage":"作谓语、宾语；指承认罪行"},{"id":6093,"word":"低心下意","pinyin":"dī xīn xià yì","abbr":"dxxy","explanation":"指小心谨慎、专注不移。","source":{"text":"下学是低心下意做，到那做得超越，便是上达。","book":"《朱子语类》卷四四"},"usage":"作谓语、定语、状语；用于处事"},{"id":6094,"word":"低情曲意","pinyin":"dī qíng qū yì","abbr":"dqqy","explanation":"指对不住，不得已。","source":{"text":"今日鲁肃低情曲意，暂取荆州，以为救民之急；待仓廪丰盈，然后再献与将军掌领。","book":"元·关汉卿《单刀会》第四折"},"usage":"作谓语、定语；用于处事"},{"id":6095,"word":"低眉下意","pinyin":"dī méi xià yì","abbr":"dmxy","explanation":"形容非常驯良的样子。","source":{"text":"人或说之使壮，仲御勃然作色，谓之曰：‘我安能随俗低眉下意乎？’","book":"宋·李昉《太平御览·晋书》"}},{"id":6096,"word":"低眉下首","pinyin":"dī méi xià shǒu","abbr":"dmxs","explanation":"低：低下；下：低；首：头。低着眉垂下头。形容顺良，顺从。","source":{"text":"叫我物色相当的女人；年纪约三十岁左右，养过两三个儿子，人要沉默老实，又肯做事，还要对他底大妻肯低眉下首。","book":"柔石《为奴隶的母亲》"},"similar":["低眉顺眼"],"usage":"作谓语、定语；指顺从"},{"id":6097,"word":"低眉倒运","pinyin":"dī méi dǎo yùn","abbr":"dmdy","explanation":"倒霉，失意。","source":{"text":"你记住吧！人总有个低眉倒运的时候。","book":"草明《婚事》"},"opposite":["得心应手"],"usage":"作谓语、定语；指不顺利"},{"id":6098,"word":"低眉垂眼","pinyin":"dī méi chuí yǎn","abbr":"dmcy","explanation":"低着头，垂着眼。形容害羞的样子。","source":{"text":"桂香袖手床沿坐，低眉垂眼做新人。","book":"清·陶贞怀《天雨花》第四回"},"usage":"作定语、状语；用于人的神态"},{"id":6099,"word":"低眉折腰","pinyin":"dī méi zhé yāo","abbr":"dmzy","explanation":"形容在人面前显出卑躬屈膝的样子。","source":{"text":"安能摧眉折腰事权贵，使我不得开心颜。","book":"唐·李白《梦游天姥吟留别》"}},{"id":6100,"word":"低眉顺眼","pinyin":"dī méi shùn yǎn","abbr":"dmsy","explanation":"低着眉头，两眼流露出顺从的神情。形容驯良、顺从。","source":{"text":"人或说之使仕，仲御勃然作色，谓之曰：‘我安然随俗低眉下意乎？’","book":"晋·王隐《晋书》"},"example":{"text":"我们不喜欢那种～、唯唯诺诺的人。"},"similar":["百依百顺","俯首帖耳","唯命是从"],"opposite":["盛气凌人","刚愎自用","自以为是"],"usage":"作谓语、定语；指顺从"},{"id":6101,"word":"低腰敛手","pinyin":"dī yāo liǎn shǒu","abbr":"dyls","explanation":"低腰：微微地弯腰；敛手：缩手。弯着腰，缩着手。形容小心翼翼，谦卑恭顺的样子。","source":{"text":"低腰复敛手，心体不遑安。","book":"唐·白居易《酬李少府曹长官舍见赠》"}},{"id":6102,"word":"低首下心","pinyin":"dī shǒu xià xīn","abbr":"dsxx","explanation":"首：头；下心：屈服于人。形容屈服顺从。","source":{"text":"刺史虽驽弱，亦安肯为鳄鱼低首下心，伈伈睍睍，为民吏羞，以偷活于此邪？","book":"唐·韩愈《鳄鱼文》"},"example":{"text":"就照在青云山口似悬河的那派谈锋，也不愁姑娘不～的诚服首肯。","book":"清·文康《儿女英雄传》第二十五回"},"similar":["低眉顺眼"],"usage":"作谓语、定语；指屈服"},{"id":6103,"word":"低首下气","pinyin":"dī shǒu xià qì","abbr":"dsxq","explanation":"形容有所畏惧而不得不屈服。","example":{"text":"为了保住这份高薪职位，以养活全家大小，他不得不～，忍气吞声。"}},{"id":6104,"word":"低首俯心","pinyin":"dī shǒu fǔ xīn","abbr":"dsfx","explanation":"形容屈服顺从。","source":{"text":"余以为八家、少陵复生，必有低首俯心而遵其改者，必有反复辩论而不遵其改者。","book":"清·袁枚《随园诗话》第一卷"},"similar":["低首下心","低头下心"],"usage":"作谓语、定语；指屈服"},{"id":6105,"word":"佐国之谋","pinyin":"zuǒ guó zhī móu","abbr":"zgzm","explanation":"佐：协助；谋：谋略。协助治国的谋略","source":{"text":"拔于囚虏之中，信其佐国之谋。","book":"南朝·宋·范晔《后汉书·第五伦传》"},"usage":"作宾语；用于书面语"},{"id":6106,"word":"佐雍得尝","pinyin":"zuǒ yōng dé cháng","abbr":"zydc","explanation":"比喻助人为善，自己也分享光荣。","source":{"text":"王子晋云：‘佐雍得尝，佐斗得伤。’此书为善则预，为恶则去，不欲党人非义之事也。","book":"北齐·颜之推《颜氏家训·省事》"}},{"id":6107,"word":"佐饔得尝","pinyin":"zuǒ yōng dé cháng","abbr":"zydc","explanation":"比喻助人为善者得善报。","source":{"text":"佐饔者得尝焉，佐斗者伤焉。","book":"《国语·周语下》"},"example":{"text":"王子晋云：‘～，佐斗得伤。’此书为善则预，为恶则去，不欲党人非义之事也。","book":"北齐·颜之推《颜氏家训·省事》"},"similar":["善有善报"],"opposite":["佐斗得伤"],"usage":"作谓语、定语；用于劝诫人"},{"id":6108,"word":"体体面面","pinyin":"tǐ tǐ miàn miàn","abbr":"ttmm","explanation":"指人光彩荣耀。","source":{"text":"看来这件事可以做得体体面面，把老人家送回家去。","book":"清·李宝嘉《官场现形记》第52回"},"example":{"text":"在那么困难的年月里，都咬着牙办得有声有响，～。","book":"路遥《平凡的世界》第二卷第30章"},"similar":["风风光光"],"usage":"作定语、状语；用于口语"},{"id":6109,"word":"体国安民","pinyin":"tǐ guó ān mín","abbr":"tgam","explanation":"体：划分；国：都城。把都城划分为若干区域，由官宦贵族分别居住或让奴隶平民耕作。泛指治理国家。","source":{"text":"《周礼·天官·序官》：“惟王建国，辨方正位，体国经野，高官分职，以民为极。"},"usage":"作谓语、宾语；用于书面语"},{"id":6110,"word":"体国经野","pinyin":"tǐ guó jīng yě","abbr":"tgjy","explanation":"体：划分；国：都城；经：丈量；野：田野。把都城划分为若干区域，由官宦贵族分别居住或让奴隶平民耕作。泛指治理国家。","source":{"text":"《周礼·天官·序官》：“惟王建国，辨方正位，体国经野，高官分职，以民为极。"},"example":{"text":"李鸿章尤赏之，尝蔬荐称有物与民胞之量，～之才。","book":"《清史稿·金福曾传》"},"usage":"作谓语、定语；泛指创建与治理国家"},{"id":6111,"word":"体大思精","pinyin":"tǐ dà sī jīng","abbr":"tdsj","explanation":"体：体制，规模；思：思虑；精：精密。指著作规模宏大，思虑精密。","source":{"text":"自古体大而思精，未有此也。","book":"南朝·宋·范晔《后汉书自序》"},"example":{"text":"李才高气逸而调雄，杜～而格浑。","book":"明·胡应麟《诗薮·近体上》"},"usage":"作谓语、分句；指著作、设计等"},{"id":6112,"word":"体天格物","pinyin":"tǐ tiān gé wù","abbr":"ttgw","explanation":"体天：体察天意；格物：推究事物的规律。能体察上天的意志，推究事物的规律而适应它。","source":{"text":"于是太上皇，皇太后大喜，深赞当今至孝纯仁，体天格物。","book":"清·曹雪芹《红楼梦》第十六回"},"example":{"text":"万岁这才叫～，善知老年人的心哪。","book":"二月河《康熙大帝》三十一"}},{"id":6113,"word":"体察民情","pinyin":"tǐ chá mín qíng","abbr":"tcmq","explanation":"体察：考查，观察。考察民间生活生产情况。","source":{"text":"上命差来此处歇马，体察民情。","book":"元·关汉卿《裴度还带》"},"example":{"text":"当官的必须要～，不能拍老袋想当然。"},"usage":"作谓语、宾语；指了解民间情况"},{"id":6114,"word":"体恤入微","pinyin":"tǐ xù rù wēi","abbr":"txrw","explanation":"形容对人照顾或关怀非常细心、周到。同“体贴入微”。","source":{"text":"俄国特设教女收生院，凡胎前产后一切要症，必须明白透澈，体恤入微。","book":"郑观应《盛世危言·女教》"},"similar":["体贴入微"],"usage":"作谓语、定语、状语；指关心"},{"id":6115,"word":"体无完皮","pinyin":"tǐ wú wán pí","abbr":"twwp","explanation":"全身的皮肤没有一块好的。形容遍体都是伤。也比喻理由全部被驳倒，或被批评、责骂得很厉害。同“体无完肤”。","source":{"text":"纂性急少恩，死之日体无完皮。","book":"晋·郭讼《魏晋世语》"},"similar":["体无完肤","身无完肤"],"usage":"作谓语、定语、状语；用于被打等"},{"id":6116,"word":"体无完肤","pinyin":"tǐ wú wán fū","abbr":"twwf","explanation":"全身的皮肤没有一块好的。形容遍体都是伤。也比喻理由全部被驳倒，或被批评、责骂得很厉害。","source":{"text":"师纂亦与艾俱死……死之日体无完皮。","book":"《三国志·魏书·邓艾传》“子忠与艾俱死”裴松之注引《世语》"},"example":{"text":"他就静悄悄地看下去，看到把各种责难都驳斥得～之后，他又低声念起来。"},"similar":["遍体鳞伤","皮开肉绽"],"opposite":["完好无损","安然无恙","完美无缺"],"usage":"作谓语、定语、状语；用于被打或驳斥等"},{"id":6117,"word":"体物缘情","pinyin":"tǐ wù yuán qíng","abbr":"twyq","explanation":"指诗赋的状物与抒情。","source":{"text":"诗缘情而绮靡，赋体物而浏亮。","book":"语出晋·陆机《文赋》"},"example":{"text":"宋·潘若同《郡阁雅言·李远》：“李远～，皆谓臻妙。”"},"usage":"作谓语、宾语；用于书面语"},{"id":6118,"word":"体规画圆","pinyin":"tǐ guī huà yuán","abbr":"tghy","explanation":"犹言依样画葫芦。指墨守成规，一味模仿。","source":{"text":"若体规画圆，准方作矩，终为人之臣仆。","book":"宋·宋祁《宋景文公笔记·释俗》"},"example":{"text":"明·宋濂《答章秀才论诗书》：“若～，准方作矩，终为人之臣仆，尚乌得谓之诗哉！”"},"similar":["依样画葫芦"],"usage":"作谓语、宾语；用于处事"},{"id":6119,"word":"体贴入妙","pinyin":"tǐ tiē rù miào","abbr":"ttrm","explanation":"指体会领悟深刻细致，而使描写或模仿巧妙逼真。","source":{"text":"姿容艳丽，性格柔婉，所演剧甚多，俱能体贴入妙。","book":"清·昭梿《啸亭杂录·檀栾卿》"},"similar":["体贴入微"],"usage":"作谓语、定语、状语；用于书面语"},{"id":6120,"word":"体贴入微","pinyin":"tǐ tiē rù wēi","abbr":"ttrw","explanation":"体贴：细心体谅别人的心情和处境，给予关心和照顾；入微：达到细微的程度。形容对人照顾或关怀非常细心、周到。","source":{"text":"至于寻常写景，不必有意惊人，而体贴入微，亦复人不能到。","book":"清·赵翼《瓯北诗话·杜少陵诗·四》"},"example":{"text":"这却全在美人心意上着想，倒也～。（清·吴趼人《二十年目睹之怪现状》第三十九回）"},"similar":["关怀备至","无微不至"],"opposite":["漠不关心"],"usage":"作谓语、定语、状语；指关心"},{"id":6121,"word":"体面扫地","pinyin":"tǐ miàn sǎo dì","abbr":"tmsd","explanation":"体面：面子。比喻面子丢尽了。","example":{"text":"护士刚为他接过小便，他由于不得不当众小便而感到～，一脸懊丧。","book":"王朔《浮出海面》五"}},{"id":6122,"word":"何乐不为","pinyin":"hé lè bù wéi","abbr":"hlbw","explanation":"乐：乐意；为：做。有什么不乐于去做的呢？表示愿意去做。","source":{"text":"此地河道，为患已久，居民被害已深，闻贵人修治河道，虽士商人等，亦必乐于从事；况又发给工钱饭食，那些小民，何乐不为？","book":"清·李汝珍《镜花缘》第三十六回"},"example":{"text":"这件事对国家对个人都有益处，～？"},"opposite":["迫不得已"],"usage":"作状语；表示当然可以"},{"id":6123,"word":"何乐而不为","pinyin":"hé lè ér bù wéi","abbr":"hlebw","explanation":"有什么不乐于去做的呢？表示愿意去做。","source":{"text":"此地河道，为患已久，居民被害已深，闻贵人修治河道，虽士商人等，亦必乐于从事；况又发给工钱饭食，那些小民，何乐不为？","book":"清·李汝珍《镜花缘》第三十六回"},"example":{"text":"这件事对国家对个人都有益处，～？"},"similar":["何乐不为"],"usage":"作谓语、分句；用于加强语气"},{"id":6124,"word":"何以家为","pinyin":"hé yī jiā wéi","abbr":"hyjw","explanation":"还要家干什么。用反问的语气表示没有时间或没有心情去考虑个人的家庭问题。","source":{"text":"匈奴不灭，无以家为也。","book":"《汉书·霍去病传》"},"example":{"text":"方深国虑，～？","book":"金·赵秉文《谢宣慰赐夫人葬赙赠龙脑·水银·锦缎表》"}},{"id":6125,"word":"何其毒也","pinyin":"hé qí dú yě","abbr":"hqdy","explanation":"也：文言助语，置于词尾，与“何”相配合，构成反诘语气。多么狠毒呀！。","example":{"text":"这个妇人是～，我已领教过了。"},"usage":"作谓语；用于口语"},{"id":6126,"word":"何其相似乃尔","pinyin":"hé qí xiāng sì nǎi ěr","abbr":"hqxsne","explanation":"二者多么相象，竟然到了这样的地步。形容十分相象。"},{"id":6127,"word":"何其衰也","pinyin":"he qi ai ye","abbr":"hqsy","explanation":"怎么这么衰颓啊！"},{"id":6128,"word":"何去何从","pinyin":"hé qù hé cóng","abbr":"hqhc","explanation":"去：离开；从：跟随。离开哪儿，走向哪儿。多指在重大问题上选择什么方向。","source":{"text":"此孰吉孰凶？何去何从？","book":"战国·楚·屈原《卜居》"},"example":{"text":"～，罢龟策之臧否；自开自落，任天地之荣枯。","book":"唐·李峤《上雍州高长史书》"},"similar":["择喜而从"],"opposite":["听天由命","听之任之"],"usage":"作主语、谓语；形容心中没底，不知去向"},{"id":6129,"word":"何往不利","pinyin":"hé wǎng bù lì","abbr":"hwbl","explanation":"指到任何地方都能有所得。","source":{"text":"公抱匡济之才，何往不利？","book":"明·罗贯中《三国演义》第五十七回"}},{"id":6130,"word":"何德堪之","pinyin":"he de kan zi","abbr":"hdkz","explanation":"有什么德能承受得起这样的封赏。"},{"id":6131,"word":"何必当初","pinyin":"hé bì dāng chū","abbr":"hbdc","explanation":"表示后悔过去的作为。","source":{"text":"宝玉在身后面叹道：‘既有今日，何必当初。’","book":"清·曹雪芹《红楼梦》第十二八回"},"example":{"text":"他因一念之差误入歧途，断送美好前程，如今后悔莫及，人皆谓其既知今日，～。"},"similar":["既有今日，何必当初"],"usage":"作谓语、分句；常与“早知如此”连用"},{"id":6132,"word":"何思何虑","pinyin":"hé sī hé lǜ","abbr":"hshl","explanation":"虑：忧。指没有什么可思虑的。形容胸襟开阔或无所用心。","source":{"text":"天下何思何虑，天下同归而殊涂，一致而百虑。","book":"《周易·系辞》"},"usage":"作谓语；用于口语"},{"id":6133,"word":"何患无辞","pinyin":"hé huàn wú cí","abbr":"hhwc","explanation":"何患：哪怕；辞：言辞。哪里用得着担心没有话说呢？常与“欲加之罪”连用，表示坏人诬陷好人时，无端捏造罪名，还说得振振有词。","source":{"text":"不有废也，君何以兴？欲加之罪，其无辞乎？","book":"《左传·僖公十年》"},"usage":"作分句；常与“欲加之罪”连用"},{"id":6134,"word":"何所不为","pinyin":"hé suǒ bù wéi","abbr":"hsbw","explanation":"还有什么事他不能做出来呢？形容什么坏事都能干得出来。","source":{"text":"有小儿，年十岁，偷刈邻家稻一束，琇之付狱案罪，或谏之，琇之曰：‘十年便能为盗，长大何所不为？’","book":"《南史·孔琇之传》"},"usage":"作谓语；用于疑问句","story":["南朝时期，孔琇之担任地方官时，遇到一个十岁小孩偷割邻居的稻谷，邻居将他送到公堂。琇之按盗窃罪论处，手下人为小孩求情，琇之说：“一个人十岁就能做小偷，那么长大后有什么事情干不出来的呢？”"]},{"id":6135,"word":"何所不有","pinyin":"hé suǒ bù yǒu","abbr":"hsby","explanation":"用反问的语气表示无所不有。","source":{"text":"此事前所未闻，是知穷荒绝檄，天奇地怪，亦何所不有，未可以见闻所未及，遂以为诞也。","book":"宋·周密《齐东野语·黄婆》"},"example":{"text":"《山海经》有兽，以其尾飞；有鸟，以其须飞。则覆载之间，负类反伦，～。","book":"宋·陆佃《埤雅·释虫》"}},{"id":6136,"word":"何所不至","pinyin":"hé suǒ bù zhì","abbr":"hsbz","explanation":"①用反问的语气表示无所不至。指没有达不到的地方。②指什么坏事都干。"},{"id":6137,"word":"何罪之有","pinyin":"hé zuì zhī yǒu","abbr":"hzzy","explanation":"即“有何罪”，有什么罪呢？用反问的语气表示清白无辜，没有过错。","source":{"text":"闻子为梯，将以攻宋，宋何罪之有？","book":"战国·宋·墨翟《墨子·公输》"},"example":{"text":"他～，你为什么要抓他？"},"usage":"作谓语；用反问的语气表示清白无辜"},{"id":6138,"word":"何肉周妻","pinyin":"hé ròu zhōu qī","abbr":"hrzq","explanation":"周：南朝周颙；何：南朝何胤。周颙有妻子，何胤吃肉。比喻各有所累。","source":{"text":"太子又问颙：‘卿精进何如何胤？’颙曰：‘三涂八难，共所未免。然各有其累。’太子曰：‘所累伊何？’对曰：‘周妻何肉。’其言辞应变，皆如此也。","book":"《南齐书·周颙传》"},"example":{"text":"～业并深，台宗古辙幸窥寻。（清·龚自珍《己亥杂诗》）"}},{"id":6139,"word":"何至于此","pinyin":"hé zhì yǔ cǐ","abbr":"hzyc","explanation":"怎么能够到了这种境地？表示不会或不应该到这种地步。","source":{"text":"请斩之以谢众，方可安辑。玄感曰：‘何至于此？’","book":"《旧唐书·李密传》"},"example":{"text":"早听我的忠告，～。"},"usage":"作宾语、分句；用于感慨等"},{"id":6140,"word":"何苦乃尔","pinyin":"hé kǔ nǎi ěr","abbr":"hkne","explanation":"乃：竟然；尔：如此。何苦到这种地步呢？用反问的语气，表示不值得，没有必要。"},{"id":6141,"word":"何见之晚","pinyin":"hé jiàn zhī wǎn","abbr":"hjzw","explanation":"为什么到现在才见到它？讽刺人孤陋寡闻。","source":{"text":"故秋霜降者草花落，水摇动者万物作，此必然之效也。君何见之晚？","book":"《史记·李斯列传》"}},{"id":6142,"word":"何许人也","pinyin":"hé xǔ rén yě","abbr":"hxry","explanation":"何：什么；许：地方。指不知来自何方，来历不明的人。","source":{"text":"汉阴老父者，不知何许人也。","book":"《后汉书·逸民传》"},"example":{"text":"先生不知～，亦不详其姓字，宅边有五柳树，因以为号焉。","book":"晋·陶潜《五柳先生传》"},"usage":"作宾语、分句；多用于疑问句"},{"id":6143,"word":"何足为奇","pinyin":"hé zú wéi qí","abbr":"hzwq","explanation":"有什么值得奇怪的呢？表示不值得奇怪。","source":{"text":"恰才你摆的阵势，都是可破的，何足为奇。","book":"元·无名氏《马陵道》第一折"},"example":{"text":"肉也要用四五千斤，银子～！","book":"清·吴敬梓《儒林外史》第三回"},"similar":["不足为奇"],"usage":"作谓语、宾语；指不值得奇怪"},{"id":6144,"word":"何足介意","pinyin":"hé zú jiè yì","abbr":"hzjy","explanation":"介意：放在心上，耿耿于怀，哪里值得放在心上呢？指事情很小，没有必要斤斤计较。","source":{"text":"所亡少少，何足介意。","book":"《后汉书·度尚传》"},"example":{"text":"袁公路岂忧国忘家都邪？冢中枯骨，～。","book":"《三国志·蜀志·先主刘备传》"},"similar":["何必介意"],"usage":"作谓语、宾语；指没有必要放在心上"},{"id":6145,"word":"何足挂齿","pinyin":"hé zú guà chǐ","abbr":"hzgc","explanation":"足：值得；挂齿：提及，谈及。哪里值得挂在嘴上。不值一提的意思。","source":{"text":"此特群盗鼠窃狗盗，何足置齿牙间哉？","book":"《汉书·叔孙通传》"},"example":{"text":"不过先人留下来的几本破书，卖又不值钱，随便带在行箧解解闷儿，当小说书看罢了，～。","book":"清·刘鹗《老残游记》第三回"},"similar":["无足挂齿","微不足道","何足道哉"],"opposite":["津津乐道","大书特书","至关紧要"],"usage":"作谓语、宾语；用于客套话","story":["秦朝末年，陈胜吴广举旗造反，四方响应。秦二世慌忙召集博士与儒生议论军情。儒生认为应该发兵讨伐。叔孙通看出秦二世胆怯，明白他对儒生的话很反感，就说当前四方太平，那几个反叛的兵卒只是区区小事，何必把他们放在嘴上呢？"]},{"id":6146,"word":"何足道哉","pinyin":"hé zú dào zāi","abbr":"hzdz","explanation":"足：值得。哪里值得谈起呢？表示不值一提，带有轻蔑之意。","source":{"text":"意在言外，而幽怨之情自见，不待明言之也，诗贵夫如此。若使人一览而意尽，亦何足道哉。","book":"宋·胡仔《苕溪渔隐丛语·杜牡之》"},"example":{"text":"四始六义阙焉，而犹谓之诗，此则仆这所不识也，而念祖以未能工此为虑，是～。","book":"清·朱彝尊《与高念祖论诗书》"},"similar":["不足为道"],"usage":"作分句；带有轻蔑之意"},{"id":6147,"word":"何郎傅粉","pinyin":"hé láng fù fěn","abbr":"hlff","explanation":"傅粉：抹粉。原指何晏脸色白净，如同擦了粉一般。后指美男子。","source":{"text":"何平叔美姿仪，面至白，魏明帝疑其傅粉。","book":"南朝·宋·刘义庆《世说新语·容止》"},"similar":["傅粉何郎"],"usage":"作宾语；指美男子","story":["三国时期，曹操的女婿何晏长得十分俊美，他经常涂脂抹粉。曹丕称帝后，想亲自检验一下何晏有多美，在一个烈日当空的中午，他请何晏在宫内喝酒，让他吃加辣的热鸡汤面。何晏一边吃，一边不停地擦汗。一碗面吃完，脸上的脂粉全部被擦干净了"]},{"id":6148,"word":"余业遗烈","pinyin":"yú yè yí liè","abbr":"yyyl","explanation":"遗留下来的事业与功绩。","source":{"text":"及春秋时，已四五百载矣，然其余业遗烈，流而未灭。","book":"《战国策·刘向书录》"},"usage":"作宾语、定语；用于书面语"},{"id":6149,"word":"余光分人","pinyin":"yú guāng fēn rén","abbr":"ygfr","explanation":"比喻顺便帮助别人不必有任何花费。","source":{"text":"妾以无烛，故常先至，扫室布席，何爱余明之照四壁者？幸以赐妾，何妨于处女？","book":"西汉·刘向《战国策·秦策二》"},"example":{"text":"～对你没有什么害处。"},"usage":"作谓语、宾语；指人的能力等","story":["在江岸边的大房屋内有很多纺线女在纺棉线，晚上她们点蜡纺线，一个贫女没有点蜡烛，别人以为她贪小便宜，就把她赶出来。她说她也没有沾她们的光，每天她都提前来帮她们搞卫生，你们的余光分人也不会有什么害处"]},{"id":6150,"word":"余勇可贾","pinyin":"yú yǒng kě gǔ","abbr":"yykg","explanation":"余勇：剩下来的勇力；贾：卖。原意是说，我还有余力可卖，谁要就可以来买。表示还有力量没有用完。","source":{"text":"欲勇者贾余余勇。","book":"《左传·成公二年》"},"example":{"text":"其在过渡以后，达于彼举，踌躇满志，其有～与否，亦难料也。","book":"清·梁启超《过渡时代论》"},"opposite":["无能为力"],"usage":"作谓语、宾语；指老年人","story":["春秋时期，齐国同时进攻鲁国和卫国，晋国趁机进攻齐国，齐顷公派大将高固率军抵抗，高固驾着一辆战车攻入晋军大营，活捉晋军的一员大将，回营向齐顷公献上战俘后，就在战车上拴一棵桑树，驾着战车对将士喊道还有余勇可以卖"]},{"id":6151,"word":"余可类推","pinyin":"yú kě lèi tuī","abbr":"yklt","explanation":"余下的可以根据上面说的原则推断出来。","source":{"text":"格物穷理，非是要尽穷天下之物；但于一事上穷尽，其他可以类推。","book":"宋·程颢、程颐《二程语录》卷九"},"example":{"text":"大约自元旦至初八日总宜睛和为佳；即如初五为午，转是日有狂风暴雨，当主牛有灾病。～。","book":"清·李汝珍《镜花缘》第八十七回"}},{"id":6152,"word":"余味回甘","pinyin":"yú wèi huí gān","abbr":"ywhg","explanation":"甘：甜。余下的味道越回味越觉得美好。形容文学或艺术作品深刻含蓄，耐人寻味。"},{"id":6153,"word":"余味无穷","pinyin":"yú wèi wú qióng","abbr":"ywwq","explanation":"形容美妙的诗文、歌曲或可口的食物耐人回味。","example":{"text":"这个故事十分动情，让人～。"},"similar":["意犹未尽"],"usage":"作谓语、定语；指事物耐人回味"},{"id":6154,"word":"余响绕梁","pinyin":"yú xiǎng rào liáng","abbr":"yxrl","explanation":"形容歌声高亢圆润，余韵无穷。亦比喻诗文意味深长，耐人寻味。","source":{"text":"秦青顾谓其友曰：‘昔韩娥东之齐，遗粮，过雍门，鬻歌假食而去，馀响绕梁，三日不绝，左右以其人弗去。’","book":"晋·张华《博物志》卷八"},"example":{"text":"韩娥过齐雍门，鬻歌假食，既毕，而～，三日不绝。","book":"唐·李亢《独异志》卷中"},"similar":["余音绕梁"],"usage":"作谓语、定语、宾语；指声音"},{"id":6155,"word":"余声三日","pinyin":"yú shēng sān rì","abbr":"yssr","explanation":"形容乐声余韵无穷，不绝于耳。","source":{"text":"（韩娥）鬻歌假食，既去，而余音绕梁欐，三日不绝。","book":"语出《列子·汤问》"},"example":{"text":"但令闻一曲，～飞。","book":"北周·庾信《听歌一绝》"},"similar":["余音绕梁"],"usage":"作定语；用于书面语"},{"id":6156,"word":"余妙绕梁","pinyin":"yú miào rào liáng","abbr":"ymrl","explanation":"形容歌声美妙动听，长远留在人们耳边。","source":{"text":"初音鱼踊，馀妙饶梁，何止田文慨慷，刘靖心伤而已哉！","book":"南朝·梁·萧统《七契》"},"similar":["余音绕梁"],"usage":"作谓语、定语、宾语；指声音"},{"id":6157,"word":"余子碌碌","pinyin":"yú zǐ lù lù","abbr":"yzll","explanation":"余子：其他的人。指其他人平庸无能，表示对别人的轻视。","source":{"text":"唯善鲁国孔融及弘农杨修。常称曰：‘大儿孔文举，小儿杨德祖。余子碌碌，莫足数也。’","book":"《后汉书·猿文苑传下·祢衡》"},"example":{"text":"仆尝谓六朝无诗，陶公有诗趣，谢公有诗料，～，无足观者。","book":"明·袁宏道《与李龙湖书》"},"usage":"作宾语、定语；用于书面语"},{"id":6158,"word":"余杯冷炙","pinyin":"yú bēi lěng zhì","abbr":"yblz","explanation":"指吃剩下来的酒食。","source":{"text":"受用余杯冷炙，胜如剩粉残膏。","book":"明·汤显祖《牡丹亭·寻梦》"},"similar":["残羹冷炙"],"usage":"作宾语、定语；指剩余的东西"},{"id":6159,"word":"余桃啖君","pinyin":"yú táo dàn jūn","abbr":"ytdj","explanation":"比喻爱憎喜怒无常。","source":{"text":"《韩非子·说难》：“昔者弥子瑕有宠于卫君。卫国之法，窃驾君车者罪刖。弥子瑕母病，人间往夜告弥子，弥子矫驾君车以出，君闻而贤之口：‘孝哉，为母之故，忘其刖罪。’异日，与君游于果园，食桃而甘，不尽，以其半啖君，君曰：‘爱我哉， [下续示例]"},"example":{"text":"[上接出处] 忘其口味及弥子色衰爱弛，得罪于君，君曰：‘是固尝矫驾吾车，又尝啖我以余桃。’故弥子之行未变于初也，向以前之所以见贤，而后获罪者，爱憎之变也。”"},"usage":"作宾语、定语；用于书面语","story":["战国时期，卫君宠爱弥子瑕，一次弥的母亲生病，他偷偷驾驶卫君的车回家探望，卫君知道后没有按律砍足，夸他有孝心。他与卫君游桃园，把吃剩的半个桃给卫君吃，卫君夸他尽忠。后来弥色衰爱弛，失宠于卫君，卫君借这两件事治他的罪"]},{"id":6160,"word":"余波未平","pinyin":"yú bō wèi píng","abbr":"ybwp","explanation":"指某一事件虽然结束了，可是留下的影响还在起作用。","example":{"text":"我们趁此事～的时候趁热打铁。"},"usage":"作谓语、定语；指影响还没结束"},{"id":6161,"word":"余烬复燃","pinyin":"yú jìn fù rán","abbr":"yjfr","explanation":"比喻已经消失了的恶势力又重新活动起来。同“死灰复燃”。","source":{"text":"复从火后创出奇论，几使余烬复燃，烧天灼地。","book":"清·夏敬渠《野叟曝言》第五回"},"similar":["死灰复燃","死灰复燎"],"usage":"作谓语、宾语；指失势的人重新得势"},{"id":6162,"word":"余腥残秽","pinyin":"yú xīng cán huì","abbr":"yxch","explanation":"指吃剩的食物。","source":{"text":"逐逐于众人之后，求其余腥残秽以自饫。","book":"明·方孝孺《畸亭记》"},"similar":["残羹冷炙"],"usage":"作宾语、定语；用于书面语"},{"id":6163,"word":"余膏剩馥","pinyin":"yú gāo shèng fù","abbr":"ygsf","explanation":"比喻前人留下的文学遗产。同“残膏剩馥”。","source":{"text":"景道喜丹青，而无贵公子气，盖亦余膏剩馥所沾丐而然。","book":"《宣和画谱·景道》"},"similar":["残膏剩馥"],"usage":"作宾语；比喻前人留下的文学遗产"},{"id":6164,"word":"余钱剩米","pinyin":"yú qián shèng mǐ","abbr":"yqsm","explanation":"有剩余的金钱与大米。形容生活富裕。","source":{"text":"第一部分是有余钱剩米的，即用其体力或脑力劳动所得，除自给外，每年有余剩。","book":"毛泽东《中国社会各阶级的分析》"},"usage":"作宾语、定语；用于生活"},{"id":6165,"word":"余霞成绮","pinyin":"yú xiá chéng qǐ","abbr":"yxcq","explanation":"晚霞象美丽的锦缎一样。形容晚霞色彩绚丽。","source":{"text":"余霞散成绮，澄江静如练。","book":"南朝齐·谢眺《晚登三山还望京邑》诗"},"similar":["余霞散绮"],"usage":"作宾语、定语；用于景物描写"},{"id":6166,"word":"余霞散绮","pinyin":"yú xiá sàn qǐ","abbr":"yxsq","explanation":"常用来评论文章结尾有不尽之意。同“余霞成绮”。","source":{"text":"堪赏，圆月摇金，余霞散绮，五云多处易昏黄。","book":"清·洪昇《长生殿·定情》"},"example":{"text":"清·洪昇《长生殿·定情》：“堪赏，圆月摇金，～，五云多处易昏黄。”"},"similar":["余霞成绮"],"usage":"作宾语、定语；用于景物描写"},{"id":6167,"word":"余音绕梁","pinyin":"yú yīn rào liáng","abbr":"yyrl","explanation":"形容歌声优美，给人留下难忘的印象。","source":{"text":"昔韩娥东之齐，匮粮，过雍门，鬻歌假食，既去而余音绕梁，三日不绝，左右以其人弗去。","book":"《列子·汤问》"},"example":{"text":"受罪半天，能听到一段回肠荡气的唱儿，就很值得，“～，三日不绝”，确是真有那种感觉。","book":"梁实秋《听戏》"},"similar":["绕梁三日","莺舌百啭","如闻天籁"],"opposite":["不堪入耳"],"usage":"作谓语、定语、宾语；指声音","story":["战国时期韩国歌女韩娥以卖唱为生，一天她到一家客栈去投宿，被店家赶出来，她只好在店外唱着如泣如诉的曲子，客人们感动得不吃不喝，店主无奈，只好请她住店唱歌。离店前她唱了欢快的曲子，三天后那悦耳的歌声还在客栈房梁上萦绕"]},{"id":6168,"word":"余音绕梁，三日不绝","pinyin":"yú yīn rào liáng，sān rì bù jué","abbr":"yyrlsrbj","explanation":"绕梁：环绕屋梁。优美动听的音乐长久地在屋梁上回荡。形容歌声优美，给人留下难忘的印象。","source":{"text":"昔韩娥东之齐，匮粮，过雍门，鬻歌假食，既去而余音绕梁，三日不绝，左右以其人弗去。","book":"《列子·汤问》"},"example":{"text":"清·刘鹗《老残游记》第二回：“当年读书，见古人形容歌声的好处，有那‘～’的话，我总不懂。”"},"similar":["余音绕梁","余韵绕梁"],"usage":"作谓语、定语、宾语；指声音","story":["战国时期，韩国歌女韩娥以卖唱为生，一天她到一家客栈去投宿，被店家赶出来，她只好在店外唱着如泣如诉的曲子，客人们感动得不吃不喝，店主无奈，只好请她住店唱歌。离店前她唱了欢快的曲子，三天后那悦耳的歌声还在客栈房梁上萦绕"]},{"id":6169,"word":"余音缭绕","pinyin":"yú yīn liáo rào","abbr":"yylr","explanation":"优美动听的音乐长久地回荡。形容悦耳的歌声或乐曲使人听了不能一下子忘掉。","source":{"text":"昔韩娥东之齐，匮粮，过雍门，鬻歌假食，既去而余音绕梁，三日不绝，左右以其人弗去。","book":"《列子·汤问》"},"example":{"text":"听了他的演唱会，至今还感觉～"},"similar":["余音绕梁"],"usage":"作谓语、定语；用于书面语"},{"id":6170,"word":"余音袅袅","pinyin":"yú yīn niǎo niǎo","abbr":"yynn","explanation":"形容音乐悦耳动听，令人沉醉。","source":{"text":"其声呜呜然，如怨如慕，如泣如诉；余音袅袅，不绝如缕。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"王朔《玩儿的就是心跳》：“那些声音又回来了，像一根根弦接连绷断，铮然作响后在寂静中～。”"},"similar":["余音缭绕"],"usage":"作谓语、定语；指声音悦耳"},{"id":6171,"word":"余韵流风","pinyin":"yú yùn liú fēng","abbr":"yylf","explanation":"传留后世的韵致风度。","source":{"text":"家传旧清白，余韵流风正洋溢，愿寿考弥高，华峰难敌。","book":"《群音类选·》"},"example":{"text":"文达抚浙，创诂经精舍，督粤，创学海堂，提唱隽流，扇扬雅道，～，到今未沫。","book":"清·陈康祺《郎潜纪闻》卷十四"},"usage":"作宾语、定语；用于书面语"},{"id":6172,"word":"余韵绕梁","pinyin":"yú yùn rào liáng","abbr":"yyrl","explanation":"韵：韵律。形容歌声高亢、优美悦耳，余味无穷","source":{"text":"行文如曼歌缓舞，余韵绕梁，耐人寻味。","book":"茅盾《关于长篇历史小说的通信》"},"similar":["余音绕梁"],"usage":"作谓语、定语、宾语；指声音"},{"id":6173,"word":"余风遗文","pinyin":"yú fēng yí wén","abbr":"yfyw","explanation":"传留下来的习气和文章。余，通“馀”。","source":{"text":"而乐松之徒，招集浅陋，故杨赐号为驩兜，蔡邕比之俳优，其馀风遗文，盖蔑如也。","book":"南朝·梁·刘勰《文心雕龙·时序》"},"usage":"作宾语、定语；用于书面语"},{"id":6174,"word":"余食赘行","pinyin":"yú shí zhuì xíng","abbr":"yszx","explanation":"吃剩的食物，身上的赘疣。比喻遭人讨厌的东西。","source":{"text":"自伐者无功，自矜者不长，其在道也，曰余食赘行，物或恶之。","book":"《老子》"},"usage":"作主语、宾语、定语；指多余的东西"},{"id":6175,"word":"余香满口","pinyin":"yú xiāng mǎn kǒu","abbr":"yxmk","explanation":"吃过东西后满口都是余下的香味。比喻文学或艺术作品耐人回味。","source":{"text":"林黛玉把花具且都放下，接书来瞧，从头看去，越看越爱看，不到一顿饭工夫，将十六出俱已看完，自觉词藻警人，余香满口。","book":"清·曹雪芹《红楼梦》第二十三回"}},{"id":6176,"word":"佛口圣心","pinyin":"fó kǒu shèng xīn","abbr":"fksx","explanation":"佛的嘴巴，圣人的心肠。指言语温厚，心地慈善。","source":{"text":"佛口圣心，自然入妙。","book":"清·梁绍壬《两般秋雨庵随笔》卷二"},"opposite":["佛口蛇心"],"usage":"作宾语、定语；用于人的心肠"},{"id":6177,"word":"佛口蛇心","pinyin":"fó kǒu shé xīn","abbr":"fksx","explanation":"佛的嘴巴，蛇的心肠。比喻话虽说得好听，心肠却极狠毒。","source":{"text":"诸佛出世，打劫杀人，祖师西来，吹风放火，古今善知识佛口蛇心，天下衲僧自投笼槛。","book":"宋·释普济《五灯会元》卷二十"},"example":{"text":"我面貌虽丑，心地却是善良，不似你～。","book":"清·钱彩《说岳全传》第七十回"},"similar":["口蜜腹剑"],"opposite":["菩萨心肠","佛口圣心"],"usage":"作补语、定语；比喻嘴甜心毒"},{"id":6178,"word":"佛头加秽","pinyin":"fó tóu jiā huì","abbr":"ftjh","explanation":"比喻不好的东西放在好东西上面，玷污的好的东西。","source":{"text":"崔相公入寺，见鸟雀于佛头上放粪，乃问师曰：‘鸟雀还有佛性也无？’师曰：‘有。’崔曰：‘为什么向佛头上放粪？’师曰：‘是伊为什么不向鹞子头上放？’","book":"宋·释道原《景德传灯录》卷七"},"example":{"text":"我每日簿书案牍，荒于笔墨，怎敢～。","book":"清·李绿园《歧路灯》第七十一回"},"similar":["佛头着粪"],"usage":"作谓语、宾语、定语；指亵渎美好的事物","story":["唐穆宗时期，崔群游览湖南东寺，见鸟雀在佛像头上拉屎，就对住持说鸟雀没有佛性，对佛大不敬，住持说鸟雀有佛性，它们选择在佛头上拉屎，是因为佛性慈善，容忍众生，对外物从不计较，鸟雀也明白这点"]},{"id":6179,"word":"佛头着粪","pinyin":"fó tóu zhuó fèn","abbr":"ftzf","explanation":"着：放置。原指佛性慈善，在他头上放粪也不计较。后多比喻不好的东西放在好东西上面，玷污的好的东西。","source":{"text":"崔相公入寺，见鸟雀于佛头上放粪，乃问师曰：‘鸟雀还有佛性也无？’师曰：‘有。’崔曰：‘为什么向佛头上放粪？’师曰：‘是伊为什么不向鹞子头上放？’","book":"宋·释道原《景德传灯录》卷七"},"example":{"text":"今人标点古书而古书亡，因为他们乱点一通，～：这是古书的水火兵虫以外的三大厄。","book":"鲁迅《且介亭杂文·病后杂谈之余》"},"similar":["佛头著粪"],"opposite":["奉若神明"],"usage":"作谓语、宾语、定语；指亵渎美好的事物","story":["唐穆宗时期，崔群游览湖南东寺，见鸟雀在佛像头上拉屎，就对住持说鸟雀没有佛性，对佛大不敬，住持说鸟雀有佛性，它们选择在佛头上拉屎，是因为佛性慈善，容忍众生，对外物从不计较，鸟雀也明白这点"]},{"id":6180,"word":"佛头著粪","pinyin":"fó tóu zhuó fèn","abbr":"ftzf","explanation":"往佛像的头上拉粪。比喻美好的事物被亵渎、玷污。","source":{"text":"崔相公入寺，见鸟雀于佛头上放粪，乃问师曰：‘鸟雀还有佛性也无？’师云：‘有。’崔云：‘为什么向佛头上放粪？’师云：‘是伊为什么不向鹞子头上放？’","book":"宋·释道原《景德传灯录》"},"example":{"text":"拙诗亦见录存，不亦～耶？","book":"苏曼殊《与高天梅论文学书》"},"similar":["佛头着粪","佛头加秽"],"opposite":["奉若神明"],"usage":"作谓语、宾语、定语；指亵渎美好的事物","story":["唐穆宗时期，崔群游览湖南东寺，见鸟雀在佛像头上拉屎，就对住持说鸟雀没有佛性，对佛大不敬，住持说鸟雀有佛性，它们选择在佛头上拉屎，是因为佛性慈善，容忍众生，对外物从不计较，鸟雀也明白这点"]},{"id":6181,"word":"佛心蛇口","pinyin":"fó xīn shé kǒu","abbr":"fxsk","explanation":"比喻话虽说得好听，心肠却极狠毒。"},{"id":6182,"word":"佛性禅心","pinyin":"fó xìng chán xīn","abbr":"fxcx","explanation":"指佛教徒一意修行、清静寂定之心性。","source":{"text":"那众僧都在法坛上看见了这妇人，自不觉都手之舞之，足之蹈之，一时间愚迷了佛性禅心，拴不定心猿意马。","book":"《水浒传》第四五回"},"example":{"text":"那众和尚见了武大这个老婆，一个个都昏迷了～。","book":"《金瓶梅词话》第八回"},"usage":"作宾语、定语；用于口语"},{"id":6183,"word":"佛旨纶音","pinyin":"fó zhǐ lún yīn","abbr":"fzly","explanation":"佛的旨意，皇帝的诏令。指必须执行的命令。","source":{"text":"便是佛旨纶音，要把她送到龙宫去，作个龙女，也许是万两黄金，买不动她那不字儿。","book":"清·文康《儿女英雄传》第四十回"},"usage":"作宾语、定语；用于书面语"},{"id":6184,"word":"佛是金妆，人是衣妆","pinyin":"fó shì jīn zhuāng，rén shì yī zhuāng","abbr":"fsjzrsyz","explanation":"指佛靠金子装点，人靠衣饰打扮。比喻人内里不足，要靠外表。","source":{"text":"虽然如此，佛是金装，人是衣装，打援他是极要紧的。","book":"明·沈自晋《望湖亭传奇》第十出"},"example":{"text":"～，房子要招徕顾客，据说非要一番粉饰不可。","book":"陈若曦《求田问舍》"},"similar":["佛是金装，人是衣装"],"usage":"作宾语、分句；指佛靠涂金装点，人靠衣饰"},{"id":6185,"word":"佛是金装，人是衣装","pinyin":"fó shì jīn zhuāng，rén shì yī zhuāng","abbr":"fsjzrsyz","explanation":"意为佛像的光彩要靠涂金，人样的俊俏要靠衣饰。比喻人内里不足，要靠外表。","source":{"text":"常言道：佛是金装，人是衣装。","book":"明·冯梦龙《醒世恒言》第一卷"},"similar":["佛是金妆，人是衣妆"],"usage":"作宾语、分句；指佛靠涂金装点，人靠衣饰"},{"id":6186,"word":"佛眼佛心","pinyin":"fó yǎn fó xīn","abbr":"fyfx","explanation":"比喻善意看待别人。","source":{"text":"你还是佛眼佛心，把人全当成好人。","book":"孙梨《白洋淀纪事·光荣》"},"usage":"作宾语、定语；用于处世"},{"id":6187,"word":"佛眼相看","pinyin":"fó yǎn xiāng kàn","abbr":"fyxk","explanation":"用佛的眼光去看。比喻好意对待，不加伤害。","source":{"text":"经此功德，回施众生，悉发菩萨心，慈心相向，佛眼相看。","book":"《大唐善导和尚经·观经疏·叙经大猷举造疏之意》"},"example":{"text":"你若和我好意，～；若不好时，带累一城百姓受苦，都死于非命。","book":"明·冯梦龙《警世通言》卷二十八"},"opposite":["横眉立目"],"usage":"作谓语、宾语；指善意看待"},{"id":6188,"word":"佛面刮金","pinyin":"fó miàn guā jīn","abbr":"fmgj","explanation":"在佛的脸上搜刮金子。比喻从不该侵犯的地方或从有限的一点油水中竭力搜刮、掠取。","source":{"text":"英魂久向兹埋玉，佛面今为汝削金。","book":"宋·刘克庄《盗以蔡端明墓一首，和竹溪韵》"},"example":{"text":"不是我们争嘴，堪恨你这厮们无道理，佛面上去刮金。","book":"明·施耐庵《水浒全传》第八十三回"}},{"id":6189,"word":"佛高一尺，魔高一丈","pinyin":"fó gāo yī chǐ，mó gāo yī zhàng","abbr":"fgycmgyz","explanation":"原为佛家告诫修行者，要警惕外界诱惑。佛，指佛法；魔，指魔法。后用以比喻一方势力（多指正义的）增长，与之对立的另一方势力（多指非正义的）则加倍增长。","source":{"text":"‘佛高一尺，魔高一丈。’昔人此言，只要人知有佛即有魔，如形之有影，声之有响，必然不相离者。","book":"明·李贽《与梅衡湘书》"},"usage":"作宾语、定语；用于口语"},{"id":6190,"word":"作不如程","pinyin":"zuò bù rú chéng","abbr":"zbrc","explanation":"程：规矩、格式，也作期限。做的不合规格或不能如期完成","source":{"text":"作不如程，则刖耳、嬶鼻、敲刖胫趾，君能之乎？","book":"清·蒲松龄《聊斋志异·锦瑟》"},"usage":"作宾语、定语；用于书面语"},{"id":6191,"word":"作乱犯上","pinyin":"zuò luàn fàn shàng","abbr":"zlfs","explanation":"犯：冒犯。违抗尊长或朝廷，为悖逆或叛乱的行为。","source":{"text":"孝弟之行，华戎之辨，仇国之痛，作乱犯上之戒，宜一切习闻之。","book":"章炳麟《序》"},"similar":["犯上作乱"],"opposite":["遵纪守法"],"usage":"作谓语、定语；用于反抗或作乱"},{"id":6192,"word":"作事不时","pinyin":"zuò shì bù shí","abbr":"zsbs","explanation":"不时：不合时宜。做事违背农时。泛指不合时宜","source":{"text":"作事不时，怨读言动于民。","book":"春秋·鲁·左丘明《左传·昭公八年》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":6193,"word":"作作有芒","pinyin":"zuò zuò yǒu máng","abbr":"zzym","explanation":"作作：光芒四射的样子。形容光芒四射。也比喻声势显赫。","source":{"text":"岁阴在酉，星居午。……作作有芒。","book":"《史记·天官书》"},"similar":["作作生芒"],"opposite":["无声无息"],"usage":"作谓语、定语；指人的声名"},{"id":6194,"word":"作作生芒","pinyin":"zuò zuò shēng máng","abbr":"zzsm","explanation":"作作：光芒四射的样子。形容光芒四射。也比喻声势显赫。","source":{"text":"岁阴在酉，星居午。……作作有芒。","book":"《史记·天官书》"},"example":{"text":"张雨帅眼光奕奕，常思染指中原，扩张势力，既得老徐密电，正好乘机展足，～。","book":"蔡东藩、许厪父《民国通俗演义》第一一五回"},"similar":["作作有芒"],"usage":"作谓语、定语；指人的声名"},{"id":6195,"word":"作作索索","pinyin":"zuò zuò suō suō","abbr":"zzss","explanation":"象声词。描写老鼠活动的声音。","source":{"text":"有鼠作作索索。","book":"《虞初新志·秋声诗自序》"},"usage":"作谓语、定语；象声词"},{"id":6196,"word":"作古正经","pinyin":"zuò gǔ zhèng jīng","abbr":"zgzj","explanation":"犹言一本正经。","source":{"text":"陈家驼背子板起面孔，作古正经地说：‘我刚才想了好一阵，一定是那会事情’","book":"艾芜《一个女人的悲剧》五"},"example":{"text":"何家二媳妇一面照着念，一面用铅笔在小簿子上～的摹写。","book":"周立波《扫盲志异》"},"similar":["一本正经"],"usage":"作谓语、定语、状语；用于方言"},{"id":6197,"word":"作善降祥","pinyin":"zuò shàn jiàng xiáng","abbr":"zsjx","explanation":"旧指平日行善，可获吉祥。","source":{"text":"作善降之百祥，作不善降之百殃。","book":"《尚书·伊训》"},"example":{"text":"‘～’的古训，六朝人本已有些怀疑了，他们作墓志，竟会说：‘积善不报，终自欺人’的话。","book":"鲁迅《论睁了眼看》"},"similar":["善有善报"],"usage":"作谓语、定语；用于劝诫人"},{"id":6198,"word":"作困兽斗","pinyin":"zuò kùn shòu dòu","abbr":"zksd","explanation":"虽受困顿，也要奋力相拼，抗争不休。","example":{"text":"敌人还在～，我们得进行坚决还击。"},"similar":["困兽犹斗"],"usage":"作谓语、定语；指抗争不休"},{"id":6199,"word":"作壁上观","pinyin":"zuò bì shàng guān","abbr":"zbsg","explanation":"壁：壁垒。原指双方交战，自己站在壁垒上旁观。后多比喻站在一旁看着，不动手帮助。","source":{"text":"及楚击秦，诸将皆从壁上观。","book":"《史记·项羽本纪》"},"example":{"text":"我以为对于校长主张去留的人，俱不免各有其复杂的背景，所以我是袖手～的。","book":"鲁迅《两地书·七》"},"similar":["袖手旁观","隔岸观火","置身事外"],"opposite":["见义勇为","拔刀相助","蹑足其问"],"usage":"作谓语、定语；指袖手旁观","story":["秦朝末年，大将章邯领兵攻打赵国，赵军大败，逃到巨鹿死守，等待救援，各路反秦大军按兵不动。只有项羽率军把秦军包围，项羽力能扛鼎，冲入敌阵，斩杀敌将苏角，大败秦军。巨鹿之战，消灭秦军主力，原来作壁上观的人纷纷投靠"]},{"id":6200,"word":"作奸犯科","pinyin":"zuò jiān fàn kē","abbr":"zjfk","explanation":"奸：坏事；科：法律条文。为非作歹，触犯法令。","source":{"text":"若有作奸犯科及为忠善者，宜付有司论其刑赏。","book":"三国蜀·诸葛亮《出师表》"},"example":{"text":"今儿子既在你处，必然是你～，诱藏了我娘子，有甚么得解说？","book":"明·凌濛初《二刻拍案惊奇》卷三十八"},"similar":["违法乱纪","以身试法","知法犯法"],"opposite":["安分守己","奉公守法","循规蹈矩"],"usage":"作主语、谓语、定语；指犯法","story":["三国时期，蜀主刘备死后，昏庸无能的阿斗继位，他只知享乐，把国内的军政大权交给诸葛亮处理。诸葛亮一面联吴伐魏，积极准备两次北伐，在北伐前夕给阿斗写《前出师表》希望他整顿朝纲，将作奸犯科者严惩以巩固政权"]},{"id":6201,"word":"作奸犯罪","pinyin":"zuò jiān fàn zuì","abbr":"zjfz","explanation":"为非作歹，干犯律条。","source":{"text":"她不禁一叹道：‘月黑风高，正是作奸犯罪的好时刻，老天爷好像在帮坏人的忙呢！’","book":"司马紫烟《荒野游龙》第二章"}},{"id":6202,"word":"作好作歹","pinyin":"zuò hǎo zuò dǎi","abbr":"zhzd","explanation":"比喻用各种理由或方式反复劝说。","source":{"text":"众人做歉做好，劝了他们回去。","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"example":{"text":"路旁走过两个老翁，～，从公评定，令隶卒照价拿了八折货物，这才交易而去。","book":"清·李汝珍《镜花缘》第十一回"},"similar":["做好做歹"],"usage":"作谓语；比喻用各种理由或方式反复劝说"},{"id":6203,"word":"作如是观","pinyin":"zuò rú shì guān","abbr":"zrsg","explanation":"如是：如此，这样；观：看，看法。抱这样的看法。泛指对某一事物作如此的看法。","source":{"text":"一切有为法，如梦幻泡影，如露亦如电，应作如是观。","book":"《金刚经》"},"example":{"text":"只～，虽然太煞风景，对不住‘正人君子’们。","book":"鲁迅《而已集·大衍发微》"},"usage":"作主语、谓语；泛指对某事物作如此看法"},{"id":6204,"word":"作威作福","pinyin":"zuò wēi zuò fú","abbr":"zwzf","explanation":"原意是只有君王才能独揽权威，行赏行罚。后泛指凭借职位，滥用权力。","source":{"text":"惟辟作福，惟辟作威，惟辟玉食。臣无有作福作威玉食。","book":"语出《书·洪范》"},"example":{"text":"姜三膘子一辈子是～，花天酒地。","book":"曲波《林海雪原》二"},"similar":["耀武扬威","横行霸道","盛气凌人"],"opposite":["仁至义尽"],"usage":"作谓语、定语；指独断专横","story":["11岁汉顺帝继位后，大权落在宦官孙程手中。7年后，汉顺帝重用议郎李固。李固为人正直，疾恶如仇，看不惯宦官专权。孙程对他恨之入骨，想置之死地而后快，诬陷李固妄自尊大、依仗权势、作威作福。汉顺帝征询梁皇后后保住李固"]},{"id":6205,"word":"作嫁衣裳","pinyin":"zuò jià yī shāng","abbr":"zjys","explanation":"指白白替别人操劳，自己却一无所得。","source":{"text":"苦恨年年压金线，为他人作嫁衣裳。","book":"唐·秦韬玉《贫女》诗"},"example":{"text":"谁知又为张郎～也。","book":"清·无名氏《玉娇梨》第九回"},"similar":["为人作嫁"],"usage":"作谓语、定语；指为别人操劳"},{"id":6206,"word":"作小服低","pinyin":"zuò xiǎo fú dī","abbr":"zxfd","explanation":"指与人作妾或顺从比己低下者。形容谦退温顺。","source":{"text":"宝玉又是天生成惯能作小服低，赔身下气，情性体贴，话语绵缠。","book":"清·曹雪芹《红楼梦》第九回"}},{"id":6207,"word":"作张作致","pinyin":"zuò zhāng zuò zhì","abbr":"zzzz","explanation":"张：模样。装模作样，故意做作。","source":{"text":"随意看了两三处，也有坐着两三人的，也有三五人的，村村俏俏，作张作致。","book":"《品花宝鉴》第23回"},"similar":["做张做致","装模作样"],"usage":"作谓语、状语；指装模作样"},{"id":6208,"word":"作怪兴妖","pinyin":"zuò guài xīng yāo","abbr":"zgxy","explanation":"原指妖魔兴事害人。后比喻坏人破坏捣乱，或坏思想扩大影响。","source":{"text":"你既然还有阳寿，阴曹地府不管，你却这等兴妖作怪。","book":"元·无名氏《碧桃花》第三折"},"example":{"text":"今人于开场一出，便欲异人，乃装神扮鬼，～。","book":"明·张岱《答袁箨庵》"},"similar":["兴妖作怪","兴妖作孽","兴妖作乱"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":6209,"word":"作恶多端","pinyin":"zuò è duō duān","abbr":"zedd","explanation":"作恶：做干事。做了许多坏事。指罪恶累累。","source":{"text":"想当初作恶多端，这三四日斋戒，那里就积得过来。","book":"明·吴承恩《西游记》第四十二回"},"example":{"text":"在载垣等，未尝不自恃为顾命大臣，纵使～，定邀宽典。","book":"清·薛福成《庸盦笔记·咸丰季年三奸伏诛》"},"similar":["无恶不作"],"opposite":["乐善好施"],"usage":"作谓语、定语；指坏人"},{"id":6210,"word":"作歹为非","pinyin":"zuò dǎi wéi fēi","abbr":"zdwf","explanation":"做各种坏事。","source":{"text":"详察这生分女作歹为非，更和这忤逆男随波逐浪。","book":"元·孟汉卿《魔合罗》第三折"},"example":{"text":"清·吴璿《飞龙全传》第一回：“无道昏君！我又不谋反叛逆，又不～，怎么把我充军起来？”"},"similar":["为非作歹"],"usage":"作谓语、定语、宾语；用于处事"},{"id":6211,"word":"作死马医","pinyin":"zuò sǐ mǎ yī","abbr":"zsmy","explanation":"比喻明知事情已经无可求药，仍然抱一丝希望，积极挽救。也泛指做最后的尝试。","source":{"text":"赵固所乘马忽死，甚悲惜之。……于是如言，果得一物，似猿。持归，入门见死马，跳梁走往死马头，嘘吸其鼻。顷之，马即能起，奋迅嘶鸣，饮食如常。","book":"晋·干宝《搜神记》卷三"},"example":{"text":"世俗无可奈何尚欲救之者，谓之～。","book":"宋·朱翌《猗觉寮杂记》下"},"usage":"作谓语、宾语、定语；用于处事","story":["古代赵固乘的一匹马忽然死了，十分惋惜，就去问郭璞。郭璞要他派几十人持竹竿到东面三十里外的山林中去抓一个东西。他们去后果然抓了一个似猿一样的东西回来放在死马旁边，该动物吮吸马鼻，马立即腾起，可以照常饮食，奔跑如常"]},{"id":6212,"word":"作法自弊","pinyin":"zuò fǎ zì bì","abbr":"zfzb","explanation":"指自己立法反而使自己受害。","source":{"text":"（秦惠王）发吏捕商君。商君亡至关下，欲舍客舍，客人不知其是商君也，曰：‘商君之法，舍人无验者，坐之。’商君喟然叹曰：‘嗟乎！为法之敝一至此哉！’","book":"《史记·商君列传》"},"example":{"text":"章谊叟侍郎有田有明州……叹其赋重。从兄彦武在俯视曰：‘此～之过也。’","book":"宋·庄季裕《鸡肋编》卷中"},"similar":["作法自毙"],"usage":"作宾语、定语；用于处事"},{"id":6213,"word":"作法自毙","pinyin":"zuò fǎ zì bì","abbr":"zfzb","explanation":"自己立法反而使自己受害。泛指自做自受。","source":{"text":"商君亡至关下，欲舍客舍，客人不知其是商君也，曰：‘商君之法，舍人无验者，坐之。’商君喟然叹曰：‘嗟乎！为法之敝一至此哉！’","book":"《史记·商君列传》"},"example":{"text":"怎奈此时官场中人，十居其九是吃烟的，那一个肯建这个政策～呢？","book":"清·吴趼人《二十年目睹之怪现状》第十三回"},"similar":["作茧自缚","自食其果","自投罗网"],"opposite":["嫁祸于人"],"usage":"作谓语、宾语、定语；指自作自受","story":["战国时期，秦孝公任用商鞅在秦国进行一系列政治和经济制度改革，太子驷触犯新法被商鞅定罪。秦国逐渐富强起来。后来太子驷成为秦惠文王，他公报私仇要治商鞅罪过。商鞅出逃，没人敢收留，没想到商鞅作法自毙，被秦王所杀"]},{"id":6214,"word":"作浪兴风","pinyin":"zuò làng xīng fēng","abbr":"zlxf","explanation":"掀起风浪。比喻制造事端。","source":{"text":"［郡主］心中本有些须醋，被江妈，作浪兴风煽惑他。","book":"《再生缘》第七十四回"},"example":{"text":"清·无垢道人《八仙全传》第二回：“不过身子太大，偶一转侧，就免不了～。”"},"similar":["兴风作浪"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":6215,"word":"作牛作马","pinyin":"zuò niú zuò mǎ","abbr":"znzm","explanation":"牛、马：比喻供人使唤的人。指被当作牛马驱使","source":{"text":"问‘受施主供养将何报答？’师曰：‘作牛作马。’","book":"宋·释道原《景德传灯录·韶州云门山爽和尚》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":6216,"word":"作福作威","pinyin":"zuò fú zuò wēi","abbr":"zfzw","explanation":"原指国君专行赏罚，独揽威权。后用以形容妄自尊大，滥用权势。","source":{"text":"惟辟作福，惟辟作威，惟辟玉食。臣无有作福作威玉食。","book":"语出《书·洪范》"},"example":{"text":"仆固情恩岂有反状！皆由尔鼠～，惧死不敢入朝。","book":"《旧唐书·周智光传》"},"similar":["作威作福"],"usage":"作谓语、定语；指独断专横"},{"id":6217,"word":"作耍为真","pinyin":"zuò shuǎ wéi zhēn","abbr":"zswz","explanation":"耍：戏弄，玩耍。把玩笑当作真的","source":{"text":"这才是个有分教；弄巧翻拙，作耍却为真。","book":"明·吴承恩《西游记》第70回"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":6218,"word":"作育人材","pinyin":"zuò yù rén cái","abbr":"zyrc","explanation":"培育人才。","source":{"text":"周王寿考，遐不作人？","book":"《诗经·大雅·域朴》"},"example":{"text":"学政虽是差使，但一省之中，与将军、督抚平起平坐，体制尊崇，而且王先谦颇有一番～的抱负。","book":"高阳《清宫外史》上册"},"usage":"作谓语、宾语；指培育人才"},{"id":6219,"word":"作舍道旁","pinyin":"zuò shě dào páng","abbr":"zsdp","explanation":"比喻众说纷纭，事情难成。","source":{"text":"此所谓筑舍道傍，无时可成。","book":"宋·司马光《资治通鉴·晋孝武帝太元七年》"},"example":{"text":"～的人永远也成不了事。"},"similar":["筑舍道傍"],"usage":"作宾语、定语；同“作舍道边”","story":["东汉时期，汉章帝想命令博士曹褒负责修订礼乐工作，班固则主张召集京城所有的儒生共同研究制定礼乐。汉章帝认为让儒生来做就等于“作舍道傍，三年不成”，就坚持让曹褒完成，经审阅，共采纳150篇"]},{"id":6220,"word":"作舍道边","pinyin":"zuò shě dào biān","abbr":"zsdb","explanation":"在路旁筑室，和过路人商量。比喻各有各的说法，事情没法做成功。","source":{"text":"如彼筑室于道谋，是用不溃于成。","book":"《诗经·小雅·小旻》"},"example":{"text":"谚言～，三年不成。","book":"南朝·宋·范晔《后汉书·曹褒传》"},"similar":["筑舍道傍"],"usage":"作宾语、定语；比喻众谋难成","story":["东汉时期，汉章帝想命令博士曹褒负责修订礼乐工作，班固则主张召集京城所有的儒生共同研究制定礼乐。汉章帝认为让儒生来做就等于“作舍道傍，三年不成”，就坚持让曹褒完成，经审阅，共采纳150篇"]},{"id":6221,"word":"作茧自缚","pinyin":"zuò jiǎn zì fù","abbr":"zjzf","explanation":"蚕吐丝作茧，把自己裹在里面。比喻做了某件事，结果使自己受困。也比喻自己给自己找麻烦。","source":{"text":"人生如春蚕，作茧自缠裹。","book":"唐·白居易《江州赴忠州至江陵已来舟中示舍弟五十韵》诗：“烛蛾谁救护，蚕茧自缠萦。”宋·陆游《剑南诗稿·书叹》"},"example":{"text":"我们需要制定必要的规章制度，但不可过于繁琐，弄得～，捆住自己的手脚。"},"similar":["作法自毙","自讨苦吃","自作自受"],"opposite":["嫁祸于人"],"usage":"作谓语、定语、宾语；指自作自受","story":["从前有一副拆字对联，上联为：“鸿为江边鸟”，下联是“蚕是天下虫”。天虫凑成蚕字。蚕是小青虫，胖胖的身体，整天埋头吃桑叶，过一个月左右蚕就作茧自缚其中，再经过一个月左右就化成飞蛾，人们借以指使自己受困"]},{"id":6222,"word":"作茧自缠","pinyin":"zuò jiǎn zì chán","abbr":"zjzc","explanation":"蚕吐丝作茧，把自己裹在里面。比喻做事自陷困境","source":{"text":"此鬼沾沾于遗蜕，殊未免作茧自缠。","book":"清·纪昀《阅微草堂笔记·如是我闻》"},"similar":["作茧自缚","造茧自缚"],"usage":"作谓语、宾语；指自作自受"},{"id":6223,"word":"作言造语","pinyin":"zuò yán zào yǔ","abbr":"zyzy","explanation":"指编造虚诞的言辞。","source":{"text":"尔作言造语，妄称文武，冠技术之冠，带死牛之胁，多辞缪说，不耕而食，不织而衣，摇唇鼓舌，擅生是非。","book":"《庄子·盗跖》"},"usage":"作谓语、定语；用于书面语"},{"id":6224,"word":"作贼心虚","pinyin":"zuò zéi xīn xū","abbr":"zzxx","explanation":"指做坏事怕人知道，心神不安","source":{"text":"却顾侍者云：‘适来有人看方丈么？’侍者云：‘有。’师云：‘作贼人心虚。’","book":"宋·释悟明《联灯会要·重显禅师》"},"example":{"text":"郭沫若《孔雀胆》第二幕：“他匆匆忙忙地便把他们带走了，这不更显得是～！”"},"similar":["做贼心虚"],"opposite":["镇定自若","处之泰然"],"usage":"作谓语、定语、状语；指心神不安"},{"id":6225,"word":"作贾行商","pinyin":"zuò gǔ xíng shāng","abbr":"zjhs","explanation":"贾：有固定店面的商人。指有固定店面的商人和转运贩卖的行商","example":{"text":"～都是商人"},"similar":["坐贾行商"],"usage":"作宾语、定语；指商人"},{"id":6226,"word":"作辍无常","pinyin":"zuò chuò wú cháng","abbr":"zcwc","explanation":"时作时歇、不能持久。辍：停止；无常：变化不定。","source":{"text":"或曰：‘何以处伪？’曰：‘有人则作、无人则辍之谓伪。观人者，审其作辍而已矣。’","book":"汉·扬雄《法言·孝至》"}},{"id":6227,"word":"作金石声","pinyin":"zuò jīn shí shēng","abbr":"zjss","explanation":"金石：钟磬之类的乐器，声音清脆优美。比喻文章优美，音调铿锵。","source":{"text":"孙兴公作《天台赋》成，以示范荣期云：‘卿试掷地，要作金石声。’","book":"南朝宋·刘义庆《世说新语·文学》"},"similar":["掷地有声"],"usage":"作谓语、定语；用于文章"},{"id":6228,"word":"你不仁，我不义","pinyin":"nǐ bù rén，wǒ bù yì","abbr":"nbrwby","explanation":"你不讲仁义道德，我也就不道义了。","example":{"text":"俗话说：～，别怪我无情。"},"opposite":["你仁我义"],"usage":"作宾语、分句；用于人际关系"},{"id":6229,"word":"你东我西","pinyin":"nǐ dōng wǒ xī","abbr":"ndwx","explanation":"指分手离去。","source":{"text":"谁想当面一番错过，便如此你东我西，料想那还有再会的日子！","book":"明·凌濛初《二刻拍案惊奇》第九卷"},"example":{"text":"～，各自去了。","book":"清·张南庄《何典》第十回"},"usage":"作谓语、分句；指分手"},{"id":6230,"word":"你争我夺","pinyin":"nǐ zhēng wǒ duó","abbr":"nzwd","explanation":"指相互争夺。","source":{"text":"这些富贵公子，你争我夺，依了张家，违了李家。","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"今后这种～的场面还不少。"},"similar":["你夺我争"],"opposite":["你推我让"],"usage":"作谓语、定语；指相互争夺"},{"id":6231,"word":"你倡我随","pinyin":"nǐ chàng wǒ suí","abbr":"ncws","explanation":"倡：带头，倡导。指彼此呼应。","source":{"text":"真是那狮吼之声，山鸣谷应，你倡我随。","book":"清·西周生《醒世姻缘传》第91回"},"similar":["你唱我和"],"usage":"作宾语、定语；指彼此呼应"},{"id":6232,"word":"你兄我弟","pinyin":"nǐ xiōng wǒ dì","abbr":"nxwd","explanation":"双方以兄弟相称，形容关系密切。","source":{"text":"你逐日在外头呼朋唤友，你兄我弟，是没有工夫料理家务的。","book":"清·蒲松龄《东郭外传》"},"example":{"text":"我们以后就以兄弟相称，～，这样更加亲切。"},"usage":"作宾语、定语；用于口语"},{"id":6233,"word":"你吹我捧","pinyin":"nǐ chuī wǒ pěng","abbr":"ncwp","explanation":"指互相吹嘘对方以达到某种目的。","example":{"text":"我很讨厌～的做法。"},"similar":["互相吹嘘"],"usage":"作谓语、定语、状语；指互相吹嘘"},{"id":6234,"word":"你唱我和","pinyin":"nǐ chàng wǒ hé","abbr":"ncwh","explanation":"和：依照别人诗词的题材、体裁和韵脚来写作诗词。①指用诗词相互酬答。②指双方意见相同，互相支持。","source":{"text":"日日的吟诗作赋，你唱我和。","book":"明·周楫《西湖二集》"},"example":{"text":"一时便有许多同类，～。","book":"《照世杯·百和坊将天作有》"},"similar":["我唱你和"],"usage":"作宾语、分句；指协调一致"},{"id":6235,"word":"你夺我争","pinyin":"nǐ duó wǒ zhēng","abbr":"ndwz","explanation":"指相互争夺。亦作“你争我斗”、“你争我夺”。","source":{"text":"东扯西拽，你夺我争，纷纷乱嚷。","book":"明·冯梦龙《醒世恒言》第20卷"},"similar":["你争我夺"],"usage":"作谓语、定语；指相互争夺"},{"id":6236,"word":"你怜我爱","pinyin":"nǐ lián wǒ ài","abbr":"nlwa","explanation":"指人们之间相互尊敬怜爱。","source":{"text":"何玉凤、张金凤彼此性情相照，患难与共，那种你怜我爱的光景，不同寻常姐妹。","book":"清·文康《儿女英雄传》第31回"},"example":{"text":"清·文康《儿女英雄传》第31回：“何玉凤、张金凤彼此性情相照，患难与共，那种～的光景，不同寻常姐妹。”"},"similar":["你敬我爱"],"usage":"作宾语、定语、分句；用于人际关系"},{"id":6237,"word":"你恩我爱","pinyin":"nǐ ēn wǒ ài","abbr":"newa","explanation":"指夫妻或情侣间相亲相爱。","source":{"text":"你恩我爱，不觉已过一年。","book":"明·凌濛初《初刻拍案惊奇》第九卷"},"example":{"text":"后才结了夫妇，～，也可以称得和好。","book":"清·西周生《醒世姻缘传》第79卷"},"similar":["你贪我爱"],"usage":"作宾语、分句；用于夫妻或情人之间"},{"id":6238,"word":"你推我让","pinyin":"nǐ tuī wǒ ràng","abbr":"ntwr","explanation":"指双方互相谦让。","source":{"text":"他三个兀自你推我让。","book":"明·冯梦龙《醒世恒言》第二卷"},"example":{"text":"他们～的，谁都不想当这个头。"},"similar":["你谦我让"],"opposite":["你争我夺"],"usage":"作谓语、定语、状语；指相互推让"},{"id":6239,"word":"你敬我爱","pinyin":"nǐ jìng wǒ ài","abbr":"njwa","explanation":"指人们之间相互尊敬怜爱。","source":{"text":"满生与朱氏门当户对，年貌相当，你敬我爱，如胶似漆。","book":"明·凌濛初《二刻拍案惊奇》第11卷"},"example":{"text":"清·荑荻散人《玉娇梨》第15回：“只因这两首诗，～，又添上许多亲热。”"},"similar":["你怜我爱"],"usage":"作宾语、定语、分句；用于人际关系"},{"id":6240,"word":"你来我去","pinyin":"nǐ lái wǒ qù","abbr":"nlwq","explanation":"指亲朋好友之间交往频繁。","source":{"text":"见这李虞候，张干办在宋江面前指手划脚，你来我去，都有心要杀这厮，只是碍著宋江一个，不敢下手。","book":"明·施耐庵《水浒全传》第七十五回"},"example":{"text":"如此亲朋～，也不能计数。","book":"清·曹雪芹《红楼梦》第十三回"},"similar":["你来我往"],"usage":"作谓语、定语；指交往"},{"id":6241,"word":"你来我往","pinyin":"nǐ lái wǒ wǎng","abbr":"nlww","explanation":"指亲朋好友之间交往频繁。","source":{"text":"见这李虞候，张干办在宋江面前指手划脚，你来我去，都有心要杀这厮，只是碍著宋江一个，不敢下手。","book":"明·施耐庵《水浒全传》第七十五回"},"example":{"text":"在过去的岁月里，他其实只知道人和人之间存在着恩怨，恩恩怨怨，～。","book":"霍达《穆斯林的葬礼》第十三章"},"similar":["你来我去"],"usage":"作谓语、分句；指交往"},{"id":6242,"word":"你死我活","pinyin":"nǐ sǐ wǒ huó","abbr":"nswh","explanation":"不是你死，就是我活。形容双方斗争非常激烈。","source":{"text":"大海只将折箸搅，你死我活，猛火燃铛煮佛。","book":"宋·释普济《五灯会元》卷五十六"},"example":{"text":"世俗人没来由，争长竞短，～。","book":"元·无名氏《度柳翠》第一折"},"similar":["不共戴天","誓不两立"],"opposite":["同生共死","生死与共"],"usage":"作定语、状语、补语；指双方不能共存"},{"id":6243,"word":"你死我生","pinyin":"nǐ sǐ wǒ shēng","abbr":"nsws","explanation":"形容斗争非常激烈、不能共存。","source":{"text":"如要再叫唤，我就打你致命，今日赌一个你死我生！","book":"清·西周生《醒世姻缘传》第95回"},"similar":["你死我活"],"usage":"作定语、状语、宾语；指双方不能共存"},{"id":6244,"word":"你知我知","pinyin":"nǐ zhī wǒ zhī","abbr":"nzwz","explanation":"只有你我两人才知道这个秘密，不能对别人说。","source":{"text":"你又青春，我又年少，则除是天知地知，你知我知，咱两个好歹要成了这亲事罢。","book":"明·无名氏《女姑姑》第二折"},"example":{"text":"清·吴璿《飞龙全传》第45回：“但此事只可～，不宜泄漏。”"},"similar":["天知地知"],"usage":"作定语；用于口语"},{"id":6245,"word":"你言我语","pinyin":"nǐ yán wǒ yǔ","abbr":"nywy","explanation":"言：说，讲。指人们互相议论或争论。","source":{"text":"二人你言我语，一面行走，一面说笑，不觉到了柳叶渚，顺着柳堤走来。","book":"清·曹雪芹《红楼梦》第59回"},"example":{"text":"寄姐的性气岂是叫人数落发作的人，～，彼此相强。","book":"清·西周生《醒世姻缘传》第79回"},"similar":["你一言，我一语"],"usage":"作谓语、状语；指相互议论"},{"id":6246,"word":"你谦我让","pinyin":"nǐ qiān wǒ ràng","abbr":"nqwr","explanation":"谦：谦让。指双方互相谦让。","source":{"text":"这是一件正经大事，大家鼓舞起来，别你谦我让的。","book":"清·曹雪芹《红楼梦》第37回"},"example":{"text":"～的局面不多见。"},"similar":["你推我让"],"opposite":["你争我夺","各不相让"],"usage":"作谓语、定语；指相互推让"},{"id":6247,"word":"你贪我爱","pinyin":"nǐ tān wǒ ài","abbr":"ntwa","explanation":"指夫妻或情侣间相亲相爱。","source":{"text":"况且今日你贪我爱，一说一上，幽期密约，一墙之隔。","book":"明·冯梦龙《警世通言》第24卷"},"example":{"text":"绍闻与巫氏虽非佳偶，却是少年夫妇，～之时。","book":"清·李绿园《歧路灯》第82回"},"similar":["你恩我爱"],"usage":"作宾语、定语、分句；用于夫妻或情人之间"},{"id":6248,"word":"你追我赶","pinyin":"nǐ zhuī wǒ gǎn","abbr":"nzwg","explanation":"形容竞赛激烈，大家都不甘落后。","source":{"text":"我们正处在一个你追我赶、飞跃向前的建设热潮中。","book":"《新华半月刊》1960年第14期"},"example":{"text":"他们～，捷报频传。"},"similar":["争先恐后"],"opposite":["退避三舍","坐观成败"],"usage":"作谓语、定语；指竞争"},{"id":6249,"word":"佣中佼佼","pinyin":"yòng zhōng jiǎo jiǎo","abbr":"yzjj","explanation":"指在平凡之人中才能较为特出。","source":{"text":"卿所谓铁中铮铮，佣中佼佼者也。","book":"南朝·宋·范晔《后汉书·刘盆子传》"},"example":{"text":"～不值得骄傲。"},"similar":["庸中佼佼"],"usage":"作主语、宾语、定语；指超出常人的人"},{"id":6250,"word":"佩弦自急","pinyin":"pèi xián zì jí","abbr":"pxzj","explanation":"弦：弓弦。身佩弓弦以提醒自己要像弓弦那样紧张。比喻警惕自己的缺点、错误，避免重新出现。","source":{"text":"西门豹之性急，故佩韦以自缓；董安于之性缓，故佩弦以自急。","book":"战国·韩·韩非《韩非子·观行》"},"similar":["佩韦自缓"],"usage":"作谓语、宾语、定语；用于警惕"},{"id":6251,"word":"佩紫怀黄","pinyin":"pèi zǐ huái huáng","abbr":"pzhh","explanation":"腰间佩挂紫色印绶，怀里揣着黄金官印。汉代丞相、太尉等皆金印紫绶。指身居高官。","source":{"text":"吾持粱刺齿肥，跃马疾驱，怀黄金之印，结紫绶於要，揖让人主之前，食肉富贵，四十三年足矣！","book":"语出《史记·范雎蔡泽列传》"},"example":{"text":"今功臣名将，雁行有序。～，赞帷幄之谋；乘轺建节，奉疆埸之任。","book":"南朝·梁·丘迟《与陈伯之书》"},"similar":["怀黄佩紫"],"usage":"作谓语、定语；指身居高位"},{"id":6252,"word":"佩金带紫","pinyin":"pèi jīn dài zǐ","abbr":"pjdz","explanation":"金：金印；紫：紫色的印绶。佩带金印紫绶，以示身份高贵。","source":{"text":"吾闻丈夫处世当佩金带紫，焉有屈洪流一而执丝妇之事？","book":"南朝·宋·刘义庆《世说新语·言语》"}},{"id":6253,"word":"佩韦佩弦","pinyin":"pèi wéi pèi xián","abbr":"pwpx","explanation":"韦：熟牛皮，弦：弓弦。原指西门豹性急，佩韦自戒；董安于性缓，佩弦自戒。原形容随时警戒自己。后常比喻有益的规劝。","source":{"text":"西门豹之性急，故佩韦以缓己；董安于之性缓，故佩弦，故佩弦以自急。","book":"《韩非子·观行》"},"usage":"作谓语、定语；指自我警戒"},{"id":6254,"word":"佩韦自缓","pinyin":"pèi wéi zì huǎn","abbr":"pwzh","explanation":"韦：皮带。身佩熟牛皮以提醒自己要像熟牛皮那样软韧。比喻警惕自己的缺点、错误，避免重新出现。","source":{"text":"西门豹之性急，故佩韦以自缓；董安于之性缓，故佩弦以自急。","book":"战国·韩·韩非《韩非子·观行》"},"similar":["佩弦自急"],"usage":"作谓语、宾语、定语；用于警惕"},{"id":6255,"word":"佯为不知","pinyin":"yáng wéi bù zhī","abbr":"ywbz","explanation":"佯：假装。假装不知道。","source":{"text":"其追北佯为不及，见其利佯为不知。","book":"《吴子·论将》"},"example":{"text":"玉娘暗解其意，～，坐在厨下。","book":"明·冯梦龙《醒世恒言》卷十九"}},{"id":6256,"word":"佯狂避世","pinyin":"yáng kuáng bì shì","abbr":"ykbs","explanation":"佯：假装；避世：指隐居不仕。假装疯颠，逃避世事。指封建士大夫逃避现实的一种消极处世态度。","source":{"text":"费贻，字奉君，南安人也。公孙述时，漆身为厉，佯狂避世。","book":"晋·常璩《华阳国志》卷十中"},"example":{"text":"少不得借鉴着～，放浪形骸，以为遮饰地步。","book":"清·李宝嘉《文明小史》第四十一回"},"usage":"作谓语、定语；用于处事"},{"id":6257,"word":"佯羞诈鬼","pinyin":"yáng xiū zhà guǐ","abbr":"yxzg","explanation":"佯：假装；诈鬼：骗人。假装出一副害羞的样子来骗人。形容作风造作，不老实。","source":{"text":"幸他是个知书达礼的，虽是女儿，还不是那种佯羞诈鬼、一味轻薄造作之辈。","book":"清·曹雪芹《红楼梦》第五十七回"}},{"id":6258,"word":"佯轮诈败","pinyin":"yáng lún zhà bài","abbr":"ylzb","explanation":"指故意败阵。"},{"id":6259,"word":"佯输诈败","pinyin":"yáng shū zhà bài","abbr":"yszb","explanation":"佯、诈：假装。假装败下阵来，引人上当。","source":{"text":"明日吾自引一千兵搦战，却佯输诈败，诱到北山之前，放炮为号，三面夹攻，必获大胜。","book":"明·罗贯中《三国演义》第九十六回"},"example":{"text":"刘、龚二人～，四散去了，云长夺得州县，安民已定，班师回许昌。","book":"《三国演义》第二六回"},"similar":["诈败佯输"],"usage":"作谓语、宾语；指假装战败"},{"id":6260,"word":"佯风诈冒","pinyin":"yáng fēng zhà mào","abbr":"yfzm","explanation":"犹言装疯卖傻。故意装成疯疯癫癫，傻里傻气。","source":{"text":"你个弟子孩儿，吃了两钟酒，佯风诈冒，手之舞之的打我，你敢再来打我么？","book":"元·武汉臣《生金阁》第三折"},"similar":["装疯卖傻"],"usage":"作谓语、定语；用于书面语"},{"id":6261,"word":"佳人才子","pinyin":"jiā rén cái zǐ","abbr":"jrcz","explanation":"年轻貌美的女子和才华横溢的男子。泛指年貌相当，有婚姻或爱情关系的青年男女。","source":{"text":"自古及今，佳人才子，少得当年双美。且恁相偎依。","book":"唐·李隐《潇湘录·呼延冀》：“妾既与君匹偶，诸邻皆谓之才子佳人。”宋·柳永《玉女摇仙佩·佳人》"},"example":{"text":"如今我国的小说戏曲太不讲究了，～，千篇一律。","book":"清·曾朴《孽海花》第十八回"},"similar":["才子佳人"],"usage":"作主语、宾语、定语；指青年男女"},{"id":6262,"word":"佳人薄命","pinyin":"jiā rén bó mìng","abbr":"jrbm","explanation":"指年轻美女命不好。","source":{"text":"自昔佳人薄命，对古来，一片伤心月。","book":"宋·辛弃疾《贺新郎·送杜叔高》"},"example":{"text":"端的是～断亲缘。","book":"明·谢谠《四喜记·亲忆琼英》"},"similar":["红颜薄命"],"usage":"作宾语；指年轻美女命不好","story":["汉成帝刘骜的许皇后生得美貌聪慧，精通经史，两人感情不错。汉成帝继位后遇上连年灾荒及儿女夭折，皇太后认为是后宫的罪过，汉成帝下令减少许皇后的开销，同时疏远这位佳人，由于她的两个姐姐的事发而让汉成帝逼她自杀，真是佳人薄命"]},{"id":6263,"word":"佳偶自天成","pinyin":"jiā ǒu zì tiān chéng","abbr":"joztc","explanation":"好的配偶是上天作合而成的。","source":{"text":"良缘由夙缔，佳偶自天成。","book":"清·程允升《幼学琼林·婚姻》"},"example":{"text":"清·程允升《幼学琼林·婚姻》：“良缘由夙缔，佳偶自天成。”"},"usage":"作宾语、定语；用于书面语"},{"id":6264,"word":"佳儿佳妇","pinyin":"jiā ér jiā fù","abbr":"jejf","explanation":"指好儿子，好媳妇。","source":{"text":"朕佳儿佳妇，今以付卿。","book":"《资治通鉴·唐纪·永徽六年》"},"example":{"text":"成亲后，夫妇同到张家拜见妈妈。妈妈看见～，十分美满。","book":"明·凌濛初《初刻拍案惊奇》卷二十九"},"opposite":["不孝之子"],"usage":"作主语、宾语；指称心的儿子、媳妇"},{"id":6265,"word":"佳兵不祥","pinyin":"jiā bīng bù xiáng","abbr":"jbbx","explanation":"指再好的用兵都是不吉利的。","source":{"text":"夫佳兵者，不祥之器，物之恶也。","book":"先秦·李耳《老子》"},"example":{"text":"然～，不戢自焚。","book":"蔡东藩《民国通俗演义》第121回"},"usage":"作宾语；指最好不要用兵"},{"id":6266,"word":"佳弟子","pinyin":"jiā dì zǐ","abbr":"jdz","explanation":"佳：好，优。指德才超群的晚辈。","source":{"text":"汝是我佳弟子，当不减阮主簿。","book":"南朝·宋·刘义庆《世说新语·赏誉下》"},"example":{"text":"石中玉本是个千中之选的～，偏偏不肯学好。","book":"金庸《侠客行》七"}},{"id":6267,"word":"佳肴美味","pinyin":"jiā yáo měi wèi","abbr":"jymw","explanation":"指上等的、第一流的食品，精致可口的饭菜或味道鲜美的食品。","source":{"text":"因此萧后日常饮恨，眉头不展，凭你佳肴美味，拿到面前，亦不喜吃。","book":"清·褚人获《隋唐演义》第70回"},"example":{"text":"路遥《平凡的世界》第五卷第11章：“但她现在已经优雅地坐在了这里，品尝着～……”"},"similar":["美味佳肴"],"usage":"作主语、宾语、定语；指精美的食物"},{"id":6268,"word":"佳肴美馔","pinyin":"jiā yáo měi zhuàn","abbr":"jymz","explanation":"馔：食物。指上等的、第一流的食品，精致可口的饭菜或味道鲜美的食品。","source":{"text":"两口儿自去厨下安排些佳肴美馔酒食，管待武松。","book":"明·施耐庵《水浒传》第31回"},"similar":["佳肴美味","美味佳肴"],"usage":"作主语、宾语、定语；指精美的食物"},{"id":6269,"word":"佴之蚕室","pinyin":"er zi chan shi","abbr":"ezcs","explanation":"居住于蚕室，指受宫刑。佴：被放置。蚕室，指密封之室，因受刑人怕风，所以室内温暖严密。"},{"id":6270,"word":"佶屈聱口","pinyin":"jí qū áo kǒu","abbr":"jqak","explanation":"佶屈：曲折、不通顺；聱口：不顺口。形容文句艰涩，不通顺畅达。","source":{"text":"佶屈：曲折、不通顺；聱口：不顺口。形容文句艰涩，不通顺畅达。"},"example":{"text":"郭沫若《王阳明礼赞》：“佶屈聱口的古书在青年实在不易理解，只徒糜费时日。”"},"similar":["佶屈聱牙"],"usage":"作谓语、定语、补语；用于书面语"},{"id":6271,"word":"佶屈聱牙","pinyin":"jí qū áo yá","abbr":"jqay","explanation":"佶屈：曲折；聱牙：不顺口。指文章读起来不顺口。","source":{"text":"周浩殷盘，佶屈聱牙。","book":"唐·韩愈《进学解》"},"example":{"text":"有些文字，尤其是所谓直译的文字，写得～。","book":"邹韬奋《经历·课外阅读》"},"similar":["佶屈聱口","诘诎聱牙"],"opposite":["出口成章","琅琅上口"],"usage":"作谓语、定语、补语；用于书面语"},{"id":6272,"word":"佹形僪状","pinyin":"guǐ xíng yù zhuàng","abbr":"gxyz","explanation":"指奇形怪状。","source":{"text":"独角之犀来自九真，食火之鸡贡于三佛齐之境，其他佹形僪状，藉藉纷纷。","book":"明·宋濂《龙马赞》"},"similar":["奇形怪状"],"usage":"作谓语、定语；形容物体的外形"},{"id":6273,"word":"佹得佹失","pinyin":"guī dé guǐ shī","abbr":"gdgs","explanation":"佹：出于偶然的。指得失出于偶然。也指有得有失。","source":{"text":"佹佹成者，俏成者也，初非成也。佹佹败者，俏败者也，初非败也。","book":"《列子·力命》"},"example":{"text":"慨然各以平贼自任，而乃百计仰攻，～。","book":"清·陈康祺《燕下乡脞录》卷二"},"similar":["有得有失"],"usage":"作谓语；指得失出于偶然"},{"id":6274,"word":"佻身飞镞","pinyin":"tiāo shēn fēi zú","abbr":"tsfz","explanation":"只身射箭杀敌。形容杀敌英勇，视死如归。","source":{"text":"瓒誓命沈城，佻身飞镞。","book":"南朝·宋·颜延之《阳给事诔》"},"example":{"text":"临危不渝，～。","book":"清·冯桂芬《按察司金公墓志铭》"},"usage":"作谓语、定语；指人勇敢无畏"},{"id":6275,"word":"佼佼者","pinyin":"jiǎo jiǎo zhě","abbr":"jjz","explanation":"美好、突出的人物。","source":{"text":"卿所谓铁中铮铮，佣中佼佼者。","book":"南朝·宋·范晔《后汉书·刘盆子传》"},"example":{"text":"他是这个行业的～。"},"similar":["杰出人物"],"opposite":["平庸之辈"],"usage":"作主语、宾语、定语；指杰出人物","story":["东汉初年，赤眉军首领樊崇得知光武帝刘秀不杀降将的消息后，就率领傀儡皇帝刘盆子及丞相徐宣等30多万人前来投降，刘秀宽待他们，赏给他们饭菜吃，问他们是否真心投降，徐宣等表示真心归顺，刘秀认为他们是铁中之钢、人中佼佼者"]},{"id":6276,"word":"使之闻之","pinyin":"shǐ zhī wén zhī","abbr":"szwz","explanation":"闻：听见。故意让人听见。","source":{"text":"将命者出户，取瑟而歌，使之闻之。","book":"《论语·阳货》"},"example":{"text":"乃院电径将罗电直达刘，～，不啻使刘与罗横生意见。","book":"丁中江《北洋军阀史话》一百二十一"}},{"id":6277,"word":"使乖弄巧","pinyin":"shǐ guāi nòng qiǎo","abbr":"sgnq","explanation":"①耍手腕；耍花招。②犹言卖俏。","source":{"text":"一任你使乖弄巧奇异，只要我们墙价不低。","book":"清·李渔《比目鱼·改生》"},"example":{"text":"喜容原好，愁容也好，蓦地间怒容越好，一点娇嗔，衬出桃花红小，有心儿～。","book":"清·吴研人《二十年目睹之怪现状》第三十九回"},"usage":"作谓语、宾语；用于处事"},{"id":6278,"word":"使功不如使过","pinyin":"shǐ gōng bù rú shǐ guò","abbr":"sgbrsg","explanation":"使：用。使用有功绩的人，不如使用有过失的人，使其能将功补过。","source":{"text":"太守受诛，诚不敢言，但恐天下惶惧，各生疑变。夫使功者不如使过，原以身代太守之命。","book":"南朝·宋·范晔《后汉书·索卢放传》"},"example":{"text":"且饶他这遭，况～，着他戴罪杀贼，未为不可。","book":"明·张四维《双烈记·女戎》"},"usage":"作谓语、分句；指用人","story":["新朝后期，民众受不了王莽的压榨，爆发了全国性的大起义，拥立刘玄为更始帝。更始帝上台后想树立好的形象，并派人去查处东郡太守贪赃枉法的事，属官索卢放前去向使者求情，认为国家需要稳定，只有遵照使功不如使过，让他们戴罪立功"]},{"id":6279,"word":"使嘴使舌","pinyin":"shǐ zuǐ shǐ shé","abbr":"szss","explanation":"搬弄口舌。","source":{"text":"相於廷专好使嘴使舌的说我，不知几时着了我手，也是这般一顿，方才解我积恨。","book":"清·西周生《醒世姻缘传》第六十三回"},"similar":["搬嘴递舌","搬弄是非"],"usage":"作谓语、宾语、状语；用于处事"},{"id":6280,"word":"使心作倖","pinyin":"shǐ xīn zuò xìng","abbr":"sxzx","explanation":"用心机。亦作“使心用倖”。"},{"id":6281,"word":"使心作幸","pinyin":"shǐ xīn zuò xìng","abbr":"sxzx","explanation":"用心机。亦作“使心用幸”。","source":{"text":"都为他皓齿明眸，不由我使心作幸。","book":"元·关汉卿《玉镜台》第二折"},"example":{"text":"多谢你～白头翁，若不是这些懵懂，怎能勾一家儿团聚喜融融。","book":"元·王晔《桃花女》第四折"},"similar":["使心用幸"],"usage":"作谓语、宾语、定语；用于处事"},{"id":6282,"word":"使心别气","pinyin":"shǐ xīn bié qì","abbr":"sxbq","explanation":"指发脾气。","source":{"text":"可知有你这歪老货搬弄，致使我家娘一向使心别气。","book":"《石点头》第十二回"},"usage":"作谓语、宾语；用于处事等"},{"id":6283,"word":"使心憋气","pinyin":"shǐ xīn biē qì","abbr":"sxbq","explanation":"使：致使；憋气：指有委屈或烦恼不能发泄。让人心情不舒畅，使性子，发脾气。","source":{"text":"可知有你这歪老货搬弄，致使我家娘一向使心憋气。","book":"明·天然智叟《石头点》卷十二"}},{"id":6284,"word":"使心用倖","pinyin":"shǐ xīn yòng xìng","abbr":"sxyx","explanation":"用心机。同“使心作倖”。"},{"id":6285,"word":"使心用幸","pinyin":"shǐ xīn yòng xìng","abbr":"sxyx","explanation":"用心机。同“使心作幸”。","source":{"text":"早起晚眠，吃辛受苦，也不知瞒心昧己，使心用幸，做下了许多冤业。","book":"元·武汉臣《老生儿》第一折"},"similar":["使心作幸"],"usage":"作宾语、定语；用于处事"},{"id":6286,"word":"使心用腹","pinyin":"shǐ xīn yòng fù","abbr":"sxyf","explanation":"用心思，使坏心眼。","source":{"text":"至于贪淫纵欲，使心用腹，污秽人家女眷，没有一个不减算夺禄，或是妻女见报，阴中再不饶过。","book":"明·凌濛初《初刻拍案惊奇》卷三十二"},"usage":"作谓语、宾语；用于处事"},{"id":6287,"word":"使性傍气","pinyin":"shǐ xìng bàng qì","abbr":"sxbq","explanation":"发脾气；撒气。同“使性谤气”。","source":{"text":"连这等一个刚毅不屈的仲由老官尚且努唇胀嘴，使性傍气，嘴舌先生。","book":"清·西周生《醒世姻缘传》第三十三回"},"similar":["使性掼气","使性谤气"],"usage":"作谓语、宾语；用于处事等"},{"id":6288,"word":"使性掼气","pinyin":"shǐ xìng guàn qì","abbr":"sxgq","explanation":"发脾气；撒气。同“使性谤气”。","source":{"text":"五更鼓出来拜堂，听见说有婆婆，就惹了一肚气，出来使性掼气，磕了几个头，也没有茶，也没有鞋。","book":"清·吴敬梓《儒林外史》第二十七回"},"similar":["使性傍气","使性谤气"],"usage":"作谓语、宾语；用于处事等"},{"id":6289,"word":"使性谤气","pinyin":"shǐ xìng bàng qì","abbr":"sxbq","explanation":"发脾气；撒气。亦作“使性傍气”。亦作“使性掼气”。","source":{"text":"这玉簪又气不愤，使性谤气，牵家打伙，在厨房内打小鸾，骂兰香。","book":"《金瓶梅词话》第九十一回"},"example":{"text":"狄希陈～，一顿穿了袄裤，系上袜子，也只说他穿完衣服，要往书房里去。","book":"清·西周生《醒世姻缘传》第三十三回"},"similar":["使性掼气","使性傍气"],"usage":"作谓语、宾语；用于处事等"},{"id":6290,"word":"使愚使过","pinyin":"shǐ yú shǐ guò","abbr":"sysg","explanation":"使：用；愚：笨。用人所短，为己服务。也形容利用人的不同特点，以发挥他的长处。","source":{"text":"前春延安之战，大挫国威，朝廷有使愚使过之议，遂及于臣。","book":"宋·范仲淹《让观察使第一表》"}},{"id":6291,"word":"使料所及","pinyin":"shǐ liào suǒ jí","abbr":"slsj","explanation":"料：料想，估计；及：到。当初已经料想到的。","source":{"text":"《中国的西北角·成兰纪行一》：“人事的变化，往往非使料所及。”。"}},{"id":6292,"word":"使智使勇","pinyin":"shǐ zhì shǐ yǒng","abbr":"szsy","explanation":"使：用。用人所长，以收其功。","source":{"text":"军法曰：‘使智使勇，使贪使愚，故智者乐立其功，勇者好行其志，贪者邀趋其利，愚者不计其死。’是以前圣使人，必收所长而弃所短。","book":"《新唐书·侯君集传》"},"similar":["使贪使愚"],"usage":"作谓语、宾语；用于人"},{"id":6293,"word":"使智使勇，使贪使愚","pinyin":"shǐ zhì shǐ yǒng，shǐ tān shǐ yú","abbr":"szsystsy","explanation":"使：用；贪：不知足；愚：笨。用人所长，以收到好的功效。形容利用人的不同特点，以发挥他的长处。","source":{"text":"军法曰：‘使智使勇，使贪使愚，故智者乐立其功，勇者好行其志，贪者邀趋其利，愚者不计其死。’是以前圣使人，必收所长而弃所短。","book":"《新唐书·侯君集传》"}},{"id":6294,"word":"使枪弄棒","pinyin":"shǐ qiāng nòng bàng","abbr":"sqnb","explanation":"指使弄刀枪棍棒等兵器，借指习武。","source":{"text":"因他会写诸家字体，人都唤他做圣手书生。又会使枪弄棒，舞剑抡刀。","book":"明·施耐庵《水浒传》第39回"},"example":{"text":"奈他自幼专爱～，因此太公访求几个名公教师，教了他十八般武艺，使得两柄好双斧。","book":"清·钱彩《说岳全传》第33回"},"similar":["舞枪弄棒"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6295,"word":"使民以时","pinyin":"shǐ mín yǐ shí","abbr":"smys","explanation":"时：农时。执政者要按照农时使用民力。指在农闲时使用民力，避免影响农业生产。","source":{"text":"道千乘之国，敬事而信，节用而爱人，使民以时。","book":"《论语·学而》"},"example":{"text":"臣闻～，使臣以礼，自古未有不由斯道而致隆平者。","book":"《元史·盖苗传》"},"usage":"作宾语、定语；用于书面语"},{"id":6296,"word":"使法量功","pinyin":"shǐ fǎ liáng gōng","abbr":"sflg","explanation":"依照法则规章来衡量功绩。","source":{"text":"良将之为政也，使人择这，不自举；使法量功，不自度。","book":"《韩非子·明法》：“是故先王之治国也，使法择人，不自举也。使法量功，不自度也。”三国·蜀·诸葛亮《兵要》"}},{"id":6297,"word":"使绊儿","pinyin":"shǐ bàn ér","abbr":"sbe","explanation":"摔交时用腿脚勾住对方的腿脚使跌倒。比喻用不正当手段暗害别人。","example":{"text":"她嘴上说话比蜜甜，暗中～算计人。"}},{"id":6298,"word":"使绊子","pinyin":"shǐ bàn zǐ","abbr":"sbz","explanation":"摔交时用腿脚勾住对方的腿脚使跌倒。比喻用不正当手段暗害别人","source":{"text":"有文化的人有几个不是笑里藏刀、口蜜腹剑，脸上一盆火，脚下使绊子？","book":"王朔《枉然不供》"},"example":{"text":"她嘴上说话比蜜甜，暗中～算计人"},"similar":["使绊子"],"usage":"作谓语、宾语；用于口语"},{"id":6299,"word":"使羊将狼","pinyin":"shǐ yáng jiàng láng","abbr":"syjl","explanation":"将：统率，指挥。派羊去指挥狼。比喻不足以统率指挥。也比喻使仁厚的人去驾驭强横而有野心的人，这要坏事。","source":{"text":"且太子所与俱诸将，皆尝与上定天下枭将也。今使太子将之，此无异使羊将狼也。","book":"西汉·司马迁《史记·留侯世家》"},"example":{"text":"弱者，犹～也，其乱必矣。","book":"西汉·桓宽《盐铁论·除狭》"},"usage":"作谓语、宾语；指不足以统众","story":["汉高祖刘邦得天下后论功行赏分封了一些大功臣为异性王，这些功臣们内心不平，相继出现谋反事件，英布眼看功臣被杀也举起了反旗。刘邦派太子率老将们出征平叛，想借故废掉太子。吕后看出刘邦这使羊将狼的计谋，于是苦谏请刘邦亲征"]},{"id":6300,"word":"使者屣履","pinyin":"shǐ zhě xǐ lǚ","abbr":"szxl","explanation":"使者：指汉朝的暴胜之，为直接使者；屣履：趿着鞋。趿着鞋迎客。形容对贤士的恭敬。","source":{"text":"暴胜之不直接使者，胜之素闻不疑贤，至渤海，遣吏请与相见。胜之开阁延请，望见不疑容貌尊严，衣冠甚伟，胜之屣履起迎。","book":"《汉书·隽不疑传》"}},{"id":6301,"word":"使臂使指","pinyin":"shǐ bì shǐ zhǐ","abbr":"sbsz","explanation":"象使用自己的手臂和手指一样。比喻指挥自如。","source":{"text":"令海内之势，如身之使臂，臂之使指，莫不制从。","book":"《管子·轻重乙》：“若此，则如胸中使臂，臂之使指也。”《汉书·贾谊传》"},"similar":["如臂指使"],"usage":"作谓语、宾语；比喻指挥自如"},{"id":6302,"word":"使蚊负山","pinyin":"shǐ wén fù shān","abbr":"swfs","explanation":"使：派，令；负：背。派蚊子去背山。比喻力不胜任。","source":{"text":"其于治天下也，犹涉海凿河，而使蚊负山也。","book":"《庄子·应帝王》"},"similar":["力不胜任"],"usage":"作宾语；指力不胜任"},{"id":6303,"word":"使贤任能","pinyin":"shǐ xián rèn néng","abbr":"sxrn","explanation":"任用有品德有才能的人。","source":{"text":"越王曰：‘吾使贤任能，各殊其事，孤虚心高望，冀闻报复之谋，今咸匿声隐形，不闻其语，厥咎安在？","book":"汉·赵晔《吴越春秋·勾践阴谋外传》"},"usage":"作谓语、宾语；用于官场等"},{"id":6304,"word":"使贪使愚","pinyin":"shǐ tān shǐ yú","abbr":"stsy","explanation":"使：用；贪：不知足；愚：笨。用人所短，为己服务。也形容利用人的不同特点，以发挥他的长处。","source":{"text":"军法曰：‘使智使勇，使贪使愚，故智者乐立其功，勇者好行其志，贪者邀趋其利，愚者不计其死。’是以前圣使人，必收所长而弃所短。","book":"《新唐书·侯君集传》"},"similar":["使智使勇"],"usage":"作谓语、宾语；用于人"},{"id":6305,"word":"使酒仗气","pinyin":"shǐ jiǔ zhàng qì","abbr":"sjzq","explanation":"仗：凭借，倚仗；使：放任。指任性发酒疯。","source":{"text":"与赵郡李概为莫逆之交。概将东还，瞻遗之书曰：‘仗气使酒，我之常弊，底诃指切，在卿尤甚。’","book":"《北齐书·崔瞻传》"},"example":{"text":"昭略字茂隆，性狂隽，不事公卿，～，无所推下。","book":"《南史·沈庆之传》"},"similar":["仗气使酒"],"usage":"作谓语、宾语、定语；指发酒疯"},{"id":6306,"word":"使酒骂坐","pinyin":"shǐ jiǔ mà zuò","abbr":"sjmz","explanation":"称在酒宴上借酒使性、辱骂同席的人。同“使酒骂座”。","source":{"text":"知训尝使酒骂坐，语侵隆演，隆演愧耻涕泣，而知训愈辱之。","book":"《新五代史·吴世家·杨隆演》"},"similar":["灌夫骂坐","使酒骂座"],"usage":"作谓语、宾语、定语；用于处事等","story":["公元前131年，安武侯田蚡娶燕王的女儿，失势的魏其侯窦婴与将军灌夫奉王太后的命令前去祝贺。灌夫给他们敬酒，田蚡及他的手下不理不睬，灌夫大骂他们，田蚡抓了灌夫全家。王太后出面要挟杀了灌夫，窦婴也被流言蜚语所杀"]},{"id":6307,"word":"使酒骂座","pinyin":"shǐ jiǔ mà zuò","abbr":"sjmz","explanation":"称在酒宴上借酒使性、辱骂同席的人。","source":{"text":"汉灌夫为人刚直不阿，好使酒。一日，与魏其侯窦婴共赴丞相田蚡宴。夫怒蚡傲慢无礼，遂借行酒之机指临汝侯灌贤而骂之，其意实在蚡。蚡乃劾夫骂坐不敬。事见《史记·魏其武安侯列传》。"},"example":{"text":"清·蒲松龄《聊斋志异·酒狂》：“缪醉，～，忤客。客怒，一座大哗。”"},"similar":["使酒骂坐","灌夫骂坐"],"usage":"作谓语、宾语、定语；用于处事等","story":["公元前131年，安武侯田蚡娶燕王的女儿，失势的魏其侯窦婴与将军灌夫奉王太后的命令前去祝贺。灌夫给他们敬酒，田蚡及他的手下不理不睬，灌夫大骂他们，田蚡抓了灌夫全家。王太后出面要挟杀了灌夫，窦婴也被流言蜚语所杀"]},{"id":6308,"word":"侃侃而言","pinyin":"kǎn kǎn ér yán","abbr":"kkey","explanation":"理直气壮、从容不迫地说话。","source":{"text":"朝，与下大夫言，侃侃如也。","book":"《论语·乡党》"},"example":{"text":"是以老夫～，使足下怏怏而别。","book":"元·关汉卿《谢天香》第四折"},"similar":["侃侃而谈"],"usage":"作谓语、定语；指人说话"},{"id":6309,"word":"侃侃而谈","pinyin":"kǎn kǎn ér tán","abbr":"kket","explanation":"侃侃：理直气壮，从容不迫。理直气壮、从容不迫地说话。","source":{"text":"朝，与下大夫言，侃侃如也。","book":"《论语·乡党》"},"example":{"text":"却从来不曾见过象这位蛮子般的那末～，旁若无人的气概。","book":"郑振铎《桂公塘·三》"},"similar":["口若悬河","夸夸其谈","娓娓而谈"],"opposite":["闭口无言","吞吞吐吐","张口结舌"],"usage":"作谓语、定语；指人说话","story":["春秋末期大思想家孔子大力提倡“仁政”，并认为仁必须要以礼为规范，因此他日常的一举一动都力求按周礼去做，在家说话温和恭顺，与下大夫谈话时无所顾忌，侃侃而谈，而上大夫或国君谈话时和颜悦色，十分谦逊，严格按周礼行事"]},{"id":6310,"word":"侃侃訚訚","pinyin":"kǎn kǎn yín yín","abbr":"kkyy","explanation":"形容和悦而从容不迫地谈话。","source":{"text":"朝，与下大夫言，侃侃如也；与上大夫言，訚訚如也。","book":"语出《论语·乡党》"},"example":{"text":"将吏咸集，佩章有序，铿铿济济，～。","book":"唐·张说《东都酺宴并序》"},"similar":["訚訚侃侃"],"usage":"作谓语；用于人的态度"},{"id":6311,"word":"侃侃谔谔","pinyin":"kǎn kǎn è è","abbr":"kkee","explanation":"侃侃：理直气壮，从容不迫；谔谔：说话正直。说话正直，理直气壮。","source":{"text":"千羊之皮，不如一狐之腋；千人之诺诺，不如一士之谔谔。","book":"《论语·乡党》：“朝，与下大夫言，侃侃如也；与上大夫言，訚訚如也。”《史记·商君传》"},"example":{"text":"亏得朝中有刚正大臣，如姚崇、宋璟辈～，不畏强御。","book":"清·禇人获《隋唐演义》第七十八回"},"similar":["直言不讳"],"usage":"作谓语、定语；指人说话"},{"id":6312,"word":"侃然正色","pinyin":"kan ran zheng she","abbr":"krzs","explanation":"刚直严肃的样子。"},{"id":6313,"word":"侈丽闳衍","pinyin":"chǐ lì hóng yǎn","abbr":"clhy","explanation":"华丽繁富。多用以指文辞。","source":{"text":"其后宋玉唐勒，汉兴，枚乘司马相如，下及扬子云，竞为侈丽闳衍之词，没其风谕之义。","book":"《汉书·艺文志》"},"example":{"text":"由于两汉辞赋的发展，这种～的写作技巧，给当时文人以一种新的启发。","book":"郭绍虞《中国文学批评史》第三章第十三节"},"usage":"作谓语、定语；用于文辞"},{"id":6314,"word":"侈人观听","pinyin":"chǐ rén guān tīng","abbr":"crgt","explanation":"指加强人们在观感听觉上的印象。","source":{"text":"直从大禹以前，就有七十九代，都有曾封禅。后来只有秦始皇和汉武帝两个，这怎叫得有道之君？无非要粉饰太平，侈人观听。","book":"《醒世恒言·李道人独步云门》"},"usage":"作谓语、宾语；用于书面语"},{"id":6315,"word":"侈侈不休","pinyin":"chǐ chǐ bù xiū","abbr":"ccbx","explanation":"说话没完没了；唠叨。","source":{"text":"左嘉很快就把问题拉在自己身上去了，侈侈不休的辩解起来，直到好一阵才把话头牵开。","book":"沙汀《闯关》一"},"example":{"text":"我这样～地谈我对鲁讯小说的一些体会，并不是要求大家把他的作品框框，如法炮制。","book":"《人民文学》1977处第12期"},"similar":["喋喋不休"],"usage":"作谓语、定语、状语；指人说话"},{"id":6316,"word":"侈恩席宠","pinyin":"chǐ ēn xí chǒng","abbr":"cexc","explanation":"指张扬恩遇，凭恃宠幸。","source":{"text":"吾平生学在师心，不蕲人知，不但一时之毁誉不关于虑，即万世之是非，亦所弗计也，况欲侈恩席宠，以夸耀流俗乎？","book":"明·张居正《答湖广巡按朱谨吾辞建亭书》"},"usage":"作谓语、宾语；用于为人"},{"id":6317,"word":"侈纵偷苟","pinyin":"chǐ zòng tōu gǒu","abbr":"cztg","explanation":"指奢侈放纵，苟且偷生。","source":{"text":"其祖国初督学山西，饶于财，子姓习侈纵偷苟，妹始嫁，家中落而未尽。","book":"清·方苞《谢季方传》"},"usage":"作谓语、宾语；用于求生"},{"id":6318,"word":"侈衣美食","pinyin":"chǐ yī měi shí","abbr":"cyms","explanation":"侈衣，华美的衣服；美食，鲜美的食物。言衣食俱精。","source":{"text":"今夫攻者，砥厉五兵，侈衣美食，发且有日矣，所被攻者不乐。","book":"《吕氏春秋·精通》"},"similar":["锦衣玉食"],"opposite":["粗衣粝食"],"usage":"作谓语、宾语；用于生活"},{"id":6319,"word":"例直禁简","pinyin":"lì zhí jìn jiǎn","abbr":"lzjj","explanation":"法律或禁令简单明了，人民就容易理解和遵守。","source":{"text":"例直易见，禁简允犯。","book":"《晋书·杜预传》"},"usage":"作谓语、定语；用于法律等"},{"id":6320,"word":"例行公事","pinyin":"lì xíng gōng shì","abbr":"lxgs","explanation":"按照惯例办理的公事。现在多指刻板的形式主义的工作。","source":{"text":"那一种凌虐苛刻，看的同例行公事一般，哪里还知道这是不应为而为之事。","book":"清·吴趼人《痛史》第十三回"},"example":{"text":"回来等我把那些～办毕了，还有几句要紧的话同你商量呢。","book":"清·王浚卿《冷眼观》第十四回"},"similar":["依样葫芦","公事公办"],"opposite":["别出心裁","另辟蹊径"],"usage":"作宾语；用于形势主义的工作"},{"id":6321,"word":"例行差事","pinyin":"lì xíng chāi shì","abbr":"lxcs","explanation":"指按照规定或惯例处理的公事。","source":{"text":"现在还要来查对一番，只不过是为了完成例行差事罢了。","book":"杜鹏程《保卫延安》第六章"},"example":{"text":"朝九晚五上下班是我每天的～。"},"similar":["例行公事"],"usage":"作主语、宾语；指形式上的事情"},{"id":6322,"word":"侍执巾栉","pinyin":"shì zhí jīn zhì","abbr":"szjz","explanation":"巾栉：手巾和梳子。拿着毛巾、梳子侍侯。形容妻妾服侍夫君。","source":{"text":"寡君之使婢子侍执巾栉，以固子也。","book":"春秋·鲁·左丘明《左传·僖公二十二年》"},"example":{"text":"君弃此三者，何以使人？虽妄亦无以～！","book":"汉·刘向《烈女传·晋赵衰妻》"},"usage":"作谓语；用于女性"},{"id":6323,"word":"侍执巾节","pinyin":"shì zhí jīn jié","abbr":"szjj","explanation":"拿着手巾、梳子伺候，形容妻妾服事夫君。"},{"id":6324,"word":"侏儒一节","pinyin":"zhū rǔ yī jié","abbr":"zryj","explanation":"比喻能体现事物全貌的局部。","source":{"text":"侏儒见一节，而长短可知。","book":"汉·桓谭《新论·道赋》引谚语"},"example":{"text":"观～，而他事可知。","book":"唐·刘知幾《史通·核才》"},"usage":"作宾语、定语；指局部"},{"id":6325,"word":"侏儒观戏","pinyin":"zhū rǔ guān xì","abbr":"zrgx","explanation":"比喻自己没有主见，只是跟着别人说。","source":{"text":"譬侏儒观戏，人笑亦笑，谓众人决不误我者，比比皆是也。","book":"宋·朱弁《曲洧旧闻》卷七"},"similar":["矮子观场","人云亦云"],"usage":"作宾语、定语；指没主见"},{"id":6326,"word":"侔色揣称","pinyin":"móu sè chuǎi chèn","abbr":"mscc","explanation":"侔：相等；揣：估量；称：好。形容描写景物，恰到好处。","source":{"text":"抽子秘思，骋子妍辞，侔色揣称，为寡人赋之。","book":"南朝·宋·谢惠连《雪赋》"},"example":{"text":"夫绘藻之丽，遣辞之富，～，感物造端。","book":"宋·宋庠《尚书工部郎中太原王君诗序》"},"usage":"作谓语；形容描写景物，恰到好处"},{"id":6327,"word":"供不应求","pinyin":"gōng bù yìng qiú","abbr":"gbyq","explanation":"供：供给，供应；求：需求，需要。供应不能满足需求。","source":{"text":"现在接受了南方六个单位的订货单，每天生产一至二吨，供不应求。","book":"茅盾《长春南关行》"},"example":{"text":"当时在成都新的书报很受欢迎，常常～。","book":"巴金《忆·觉醒与活动》"},"similar":["粥少僧多"],"opposite":["供过于求"],"usage":"作谓语、定语；用于人或商品"},{"id":6328,"word":"供认不讳","pinyin":"gòng rèn bù huì","abbr":"grbh","explanation":"供认：被告对于某一事实或断言的真实性予以承认；讳：避讳。指对某项指控完全认同。","source":{"text":"我对所犯犯罪事实均供认不讳。","book":"王朔《一半是火焰，一半是海水》"},"example":{"text":"他对此～。"},"opposite":["矢口抵赖"],"usage":"作谓语；指认罪"},{"id":6329,"word":"供过于求","pinyin":"gōng guò yú qiú","abbr":"ggyq","explanation":"供给的数量比需要的多。","source":{"text":"凡物之在世也，供过于求，则价格下落。","book":"清·梁启超《生计学学说沿革小史》"},"example":{"text":"～，而岌岌向外以觅市场为尾闾之疏泄也。","book":"孙中山《心理建设（孙文学说）》第七章"},"opposite":["供不应求"],"usage":"作谓语；用于人或商品"},{"id":6330,"word":"侜张为幻","pinyin":"zhōu zhāng wéi huàn","abbr":"zzwh","explanation":"侜张：欺骗作伪。用欺骗迷惑人。","source":{"text":"民无或胥侜张为幻。","book":"《尚书·无逸》"},"example":{"text":"其倡率生事，～，即此亦大可见矣。","book":"侠少《国会问题之真相》"},"similar":["蛊惑人心"],"usage":"作谓语、定语；指欺骗人"},{"id":6331,"word":"依丱附木","pinyin":"yī kuàng fù mù","abbr":"ykfm","explanation":"比喻凭借他人势力，为非作歹。也比喻不能自立，依靠别人。同“依草附木”。"},{"id":6332,"word":"依乷附木","pinyin":"yī kuàng fù mù","abbr":"ykfm","explanation":"比喻凭借他人势力，为非作歹。也比喻不能自立，依靠别人。同依草附木”。"},{"id":6333,"word":"依人作嫁","pinyin":"yī rén zuò jià","abbr":"yrzj","explanation":"原意是说穷苦人家的女儿没有钱置备嫁衣，却每年辛辛苦苦地用金线刺乡，给别人做嫁衣。比喻空为别人辛苦。","source":{"text":"苦为年年压金线，为他人作嫁衣裳。","book":"唐·秦韬玉《贫女》诗"},"example":{"text":"要他绝了功名之念，一辈子～，实在于心不甘。","book":"高阳《状元娘子》一"}},{"id":6334,"word":"依人篱下","pinyin":"yī rén lí xià","abbr":"yrlx","explanation":"依：依附，依靠；篱：篱笆。依附于他人篱笆下。指依靠他人生活。","source":{"text":"丈夫当删诗书，制礼乐，何至因循寄人篱下？","book":"《南史·张融传》"},"example":{"text":"但彼尚不过连续俄路，～而已。","book":"孙中山《铁路计划》"},"similar":["寄人篱下"],"usage":"作谓语、定语；同“寄人篱下”"},{"id":6335,"word":"依仁游艺","pinyin":"yī rén yóu yì","abbr":"yryy","explanation":"旧指儒家的道德标准以“仁”为依据，用六艺之教陶冶身心。泛指从事道德修养和技艺的锻炼。","source":{"text":"依于仁，游于艺。","book":"《论语·述而》"},"example":{"text":"领军将军孔安国贞慎清正，出内播誉，可以本官领东海王师，必能导达津梁，～。","book":"《晋书·孔安国传》"}},{"id":6336,"word":"依依不舍","pinyin":"yī yī bù shě","abbr":"yybs","explanation":"依依：依恋的样子；舍：放弃。形容舍不得离开。","source":{"text":"那卢楠直送五百余里，两下依依不舍。","book":"明·冯梦龙《醒世恒言·卢太学诗酒傲王候》"},"example":{"text":"晚会结束已经大半天了，同学们才～地离去。"},"similar":["依依惜别","恋恋不舍","留连不舍"],"opposite":["一刀两断"],"usage":"作定语、宾语、状语；指眷恋"},{"id":6337,"word":"依依惜别","pinyin":"yī yī xī bié","abbr":"yyxb","explanation":"依依：留恋的样子；惜别：舍不得分别。形容十分留恋，舍不得分开。","source":{"text":"百壶载酒游凌云，醉中挥袖别故人，依依向我不忍别，谁似峨嵋半轮月。","book":"宋·陆游《舟中对月》"},"example":{"text":"钱钟书《围城》：“孙小姐也～，舍不下她。”"},"similar":["恋恋不舍","难舍难分","留连不舍"],"opposite":["一刀两断"],"usage":"作谓语、宾语、定语；指十分留恋"},{"id":6338,"word":"依依难舍","pinyin":"yī yī nán shě","abbr":"yyns","explanation":"依依：恋慕的样子；舍：放开。形容留恋舍不得离开。","source":{"text":"说到其间，两下好不依依难舍。","book":"清·褚人获《隋唐演义》第80回"},"similar":["依依不舍"],"usage":"作定语、宾语、状语；指眷恋"},{"id":6339,"word":"依头缕当","pinyin":"yī tóu lǚ dàng","abbr":"ytld","explanation":"依头：理出头绪；缕当：了当。比喻把事情一件件弄清楚。","source":{"text":"则要你依头缕当，分星劈两，责状招实。","book":"元·孟汉卿《魔合罗》第四折"},"usage":"作谓语；指把事情一件件理清"},{"id":6340,"word":"依头顺尾","pinyin":"yī tóu shùn wěi","abbr":"ytsw","explanation":"指对上下各方都听从、依顺。","source":{"text":"前儿我们还议论到这里，再不能依头顺尾，必有两场气生。","book":"清·曹雪芹《红楼梦》第五十五回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":6341,"word":"依头顺脑","pinyin":"yī tóu shùn nǎo","abbr":"ytsn","explanation":"形容规规矩矩，十分顺从的样子。","source":{"text":"生小儿体貌玮梧，性格轩爽，说话百伶百俐，弄得父母两个，恼里变作欢喜，愁中化作快活，依头顺脑，是一个极孝顺小厮。","book":"明·陆云龙《清夜钟》第七回"},"example":{"text":"她要丈夫对她一片忠诚，～，一切听她驾驭。","book":"杨绛《洗澡》第一部第一章"}},{"id":6342,"word":"依山临水","pinyin":"yī shān lín shuǐ","abbr":"ysls","explanation":"靠着山，临着水。形容景色优美的地方。","source":{"text":"彼连营拥众，依山傍水，举螳螂之斧，被蛣蜣之甲。","book":"北齐·杜弼《檄梁文》"},"example":{"text":"益州城西十五里，有道观焉。～，松桂深寂，道流非修习精悫者莫得而居之。","book":"宋·李昉《太平广记》卷三十六"}},{"id":6343,"word":"依山傍水","pinyin":"yī shān bàng shuǐ","abbr":"ysbs","explanation":"指地理位置靠近山岭和水流。","source":{"text":"奔迸渡江求活者几二十万家，而依山傍水相保聚以自固者亦几二十万家。","book":"宋·叶適《安集两淮申省状》"},"example":{"text":"维曰：陈仓城池坚固，郝昭守御甚密，又得王双相助，实不可取。不若令一大将，～，下寨固守。","book":"明·罗贯中《三国演义》第九十七回"},"similar":["倚山傍水"],"usage":"作谓语、定语；指地理位置"},{"id":6344,"word":"依希犹记","pinyin":"yī xī yóu jì","abbr":"yxyj","explanation":"依希：模糊，不清楚。模模糊糊还记得。","source":{"text":"前世德云今我是，依希犹记妙高台。","book":"宋·苏轼《题灵峰寺壁》"},"usage":"作谓语、定语；用于书面语"},{"id":6345,"word":"依心像意","pinyin":"yī xīn xiàng yì","abbr":"yxxy","explanation":"犹言称心如意。","source":{"text":"张廪生如此算计，若是后来依心像意，真是天没眼睛了。","book":"明·凌濛初《二刻拍案惊奇》卷二：“或者不拘那里天有缘在，等待依心像意寻个对得我来的好女儿为妻，方了平生之愿！”又卷四"},"similar":["称心如意"],"usage":"作谓语、定语、状语；用于书面语"},{"id":6346,"word":"依本画葫芦","pinyin":"yī běn huà hú lú","abbr":"ybhhl","explanation":"比喻单纯模仿原样照搬或没有改变、创新。同“依样画葫芦”。","source":{"text":"仲弓却只是据见本子做，只是依本画葫芦。","book":"《朱子语类》卷四二"},"example":{"text":"怕我连真带草，一剗数黑论黄，写仿描朱，从头至尾，～。","book":"元·王伯成《贬夜郎》第二折"},"similar":["依样画葫芦","依样葫芦"],"usage":"作谓语、状语；比喻单纯模仿"},{"id":6347,"word":"依样画葫芦","pinyin":"yī yàng huà hú lú","abbr":"yyhhl","explanation":"照别人画的葫芦的样子画葫芦。比喻单纯模仿，没有创新。","source":{"text":"颇闻翰林草制，皆捡前人旧本，改换词语，此乃俗所谓诊样画葫芦耳，何宣力之有？","book":"宋·魏泰《东轩笔录》卷一"},"example":{"text":"侄女既不认得，又不知从何下笔，只好～，细细临写。","book":"清·李汝珍《镜花缘》第八回"},"similar":["生搬硬套","依模画样","照猫画虎"],"opposite":["独树一帜","另辟蹊径","别开生面"],"usage":"作谓语、状语；比喻单纯模仿","story":["宋朝初年，翰林学士陶谷自以为文笔高超、才能出众，想好好表现一下升职，他劝宋太祖重视文字工作。赵匡胤以为他的工作只是抄写而已，说是依样画葫芦。陶谷的目的没有达到，就在住处墙上题诗：“堪笑翰林陶学士，年年依样画葫芦”"]},{"id":6348,"word":"依样葫芦","pinyin":"yī yàng hú lu","abbr":"yyhl","explanation":"照别人画的葫芦的样子画葫芦。比喻单纯模仿，没有创新。同“依样画葫芦”。","source":{"text":"太祖笑曰：‘颇闻翰林草制，皆检前人旧本，改换词语，此乃俗所谓‘依样画葫芦’耳，何宣力之有？’","book":"宋·魏泰《东轩笔录》第一卷"},"example":{"text":"我们～总可以学好。"},"similar":["照猫画虎","照本宣科","依样画葫芦"],"opposite":["别开生面","推陈出新"],"usage":"作宾语、状语；比喻单纯模仿","story":["宋朝初年，翰林学士陶谷自以为文笔高超、才能出众，想好好表现一下升职，他劝宋太祖重视文字工作。赵匡胤以为他的工作只是抄写而已，说是依样画葫芦。陶谷的目的没有达到，就在住处墙上题诗：“堪笑翰林陶学士，年年依样画葫芦”"]},{"id":6349,"word":"依模照样","pinyin":"yī mó zhào yàng","abbr":"ymzy","explanation":"按照模式样子描摹。比喻面貌、性格等十分相似。","source":{"text":"正当恁么时，有人问如何是月，向明暗未分处道得一句，便与古人共出一只手。如或未然，宝峰不免依模画样，应个时节。","book":"宋·释普济《五灯会元》卷十二"},"example":{"text":"一个情投意合的义姊，一个～的义妹，又是嬷嬷妈、嬷嬷妹妹，一盆火似价的哄着姑娘。","book":"清·文康《儿女英雄传》第二十回"}},{"id":6350,"word":"依模画样","pinyin":"yī mó huà yàng","abbr":"ymhy","explanation":"按照模式样子描摹。比喻单纯模仿，缺乏创新。","source":{"text":"正当恁么时，有人问如何是月，向明暗未分处道得一句，便与古人共出一只手。如或未然，宝峰不免依模画样，应个时节。","book":"宋·释普济《五灯会元》卷十二"},"example":{"text":"买帽相头，～。","book":"宋·释普济《五灯会元》卷十六"}},{"id":6351,"word":"依此类推","pinyin":"yī cǐ lèi tuī","abbr":"yclt","explanation":"按此标准向同类推理。","source":{"text":"盖尝供熟火也，以此类推之，岂识世事艰难！","book":"宋·周煇《清波杂志》第六卷"},"example":{"text":"～，我们进入前十名是不成问题的。"},"similar":["以此类推"],"usage":"作分句、状语；用于逻辑推理"},{"id":6352,"word":"依法炮制","pinyin":"yī fǎ páo zhì","abbr":"yfpz","explanation":"依照老办法制中药。后比喻按照已有的模式去做。","source":{"text":"但还少见到有人衷心羡慕这种罪恶，认为大有依法炮制的价值。","book":"邹韬奋《法西斯作风的罪恶》"},"similar":["如法炮制"],"usage":"作谓语、定语、状语；用于处事"},{"id":6353,"word":"依法砲制","pinyin":"yī fǎ pào zhì","abbr":"yfpz","explanation":"依照老办法制中药。后比喻按照已有的模式去做。"},{"id":6354,"word":"依流平进","pinyin":"yī liú píng jìn","abbr":"ylpj","explanation":"流：品级；依流：依照品级；平进：循序渐进。指做官按照资历一步步提升。","source":{"text":"吾家本素族，自可依流平进，不须苟求也。","book":"《南史·王骞传》"},"usage":"作谓语；用于仕途"},{"id":6355,"word":"依然如故","pinyin":"yī rán rú gù","abbr":"yrrg","explanation":"依然：仍旧；故：过去，从前。指人没有什么长进，还是从前的老样子。","source":{"text":"舅甥之分，依然如故。","book":"唐·薛调《刘无双传》"},"example":{"text":"他吃、喝、玩、耍，～。","book":"叶圣陶《一个朋友》"},"similar":["依然故我","依然如旧","一仍目贯"],"opposite":["变幻无常","荡然无存","摇身一变"],"usage":"作谓语、定语；用于人的状况没改变"},{"id":6356,"word":"依然故吾","pinyin":"yī rán gù wǔ","abbr":"yrgw","explanation":"依然：仍旧；故：过去的。形容自己一切跟从前一样，没有变得更好。","source":{"text":"谁料腥埃妨阔步，孤瘦依然故我。","book":"宋·陈著《贺新郎·次韵戴时芳》词"}},{"id":6357,"word":"依然故态","pinyin":"yī rán gù tài","abbr":"yrgt","explanation":"依然：依旧。依旧是往日的面貌或情况。多指人的思想作风没有改变，一如既往。","source":{"text":"且饬诸子以己为戒，然《和令狐绹相》云：‘鲜有一身兼将相，更能四面占文章。’则依然故态。","book":"宋·刘克庄《后村全集·诗话》"},"example":{"text":"张敬尧从长沙逃到岳州后，～不改，他手下的残兵败将霸占民房，奸淫抢劫，杀人放火，无法无天。","book":"丁中江《北洋军阀史话》一六六"}},{"id":6358,"word":"依然故我","pinyin":"yī rán gù wǒ","abbr":"yrgw","explanation":"形容自己一切跟从前一样，没有变得更好。","source":{"text":"舅甥之分，依然如故。","book":"唐·薛调《刘无双传》"},"example":{"text":"二分明月，照向谁家，一个诗人，～。","book":"清·吴锡麒《家慕桥诗集序》"},"similar":["原封不动","一如既往","依然如故"],"opposite":["面目全非","一反常态","瞬息万变"],"usage":"作谓语、宾语；形容人的思想等"},{"id":6359,"word":"依然故物","pinyin":"yī rán gù wù","abbr":"yrgw","explanation":"依旧是昔日的事物。","source":{"text":"休将看花泪眼，闻弦酸骨。对遗民、有如皎日。行万里、依然故物。","book":"宋·陈亮《三部乐·七月送丘宗卿使虏》词"}},{"id":6360,"word":"依经傍注","pinyin":"yī jīng bàng zhù","abbr":"yjbz","explanation":"依照经典及其注释。指说话有根有据。","source":{"text":"那世上说谎的也尽多，少不得依经傍注，有个边际，从没有见你恁样说瞒天谎的祖师。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"similar":["引经据典"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":6361,"word":"依翠偎红","pinyin":"yī cuì wēi hóng","abbr":"ycwh","explanation":"指同年轻女子厮混的风流韵事。翠，翡翠一类饰物；红，脂粉脣膏一类化妆品。“翠”与“红”均借指女人。","source":{"text":"不如且讨红裙趣，依翠偎红院宇中。","book":"明·兰陵笑笑生《金瓶梅词话》第十五回"},"similar":["倚翠偎红"],"usage":"作谓语、定语、宾语；用于男性"},{"id":6362,"word":"依草附木","pinyin":"yī cǎo fù mù","abbr":"ycfm","explanation":"原指鬼神有所依凭，擅作威福。后比喻凭借他人势力，为非作歹。也比喻不能自立，依靠别人。","source":{"text":"日既恃威福，岁久为精灵，依草与附木，诬诡殊不经。","book":"五代·王周《巫庙》诗"},"example":{"text":"想必有那～、冒着俺家名姓做这等事情的也不可知。","book":"元·康进之《李逵负荆》第二折"},"similar":["攀龙附凤"],"usage":"作谓语、定语；指无能之人"},{"id":6363,"word":"依葫芦画瓢","pinyin":"yī hú lu huà piáo","abbr":"yhlhp","explanation":"照着真葫芦的样子画葫芦。比喻刻板地照着做。","source":{"text":"如果就事论事，依葫芦画瓢，就会写成：一条搭肩六尺长，劳动一天沾了灰。","book":"《诗刊》1977年第12期"},"example":{"text":"自己一向这样做，别人要他们这样做，一般人都这样做，他们就‘～’，照样做去。","book":"《想和做》"},"similar":["依样画葫芦"],"usage":"作谓语、宾语、定语；用于口语"},{"id":6364,"word":"依违两可","pinyin":"yī wéi liǎng kě","abbr":"ywlk","explanation":"依：赞成；违：反对；两可：二者都可以。指对问题态度犹豫，没有确定的意见。","source":{"text":"昨见子敬寄来丁田文字，不论文字工拙，但依违两可，主意不定。","book":"明·归有光《与傅体元书》"},"example":{"text":"刚正不挠，无所阿响者，君子也；～，工于趋避者，小人也。","book":"《清史稿·倭仁传》"},"similar":["模棱两可"],"opposite":["斩钉截铁"],"usage":"作谓语、定语；指态度不明朗"},{"id":6365,"word":"依违两端","pinyin":"yī wéi liǎng duān","abbr":"ywld","explanation":"依：赞成；违：反对；两端：二者都可以。指对问题态度犹豫，没有确定的意见。","source":{"text":"昨见子敬寄来丁田文字，不论文字工拙，但依违两可，主意不定。","book":"明·归有光《与傅体元书》"},"example":{"text":"再召，会有三王并封之议，叔承遗书数千言，谓当引大义以去就力争，不当～，负主恩，辜物望。","book":"《明史·王叔承传》"}},{"id":6366,"word":"依门傍户","pinyin":"yī mén bàng hù","abbr":"ymbh","explanation":"指依附于人而不能自立。","source":{"text":"以此猛烈，赴道不难，与世上好人依门傍户者何啻千里。","book":"明·李贽《富莫富于常知足》：“无骨力则待人而行，倚势乃立，东西恃赖耳，依门傍户，真同仆妾，非贱而何？”又《史纲评要·周纪·威烈王》"},"similar":["倚门傍户"],"usage":"作谓语、宾语、定语；用于处事"},{"id":6367,"word":"依门卖笑","pinyin":"yī mén mài xiào","abbr":"ymmx","explanation":"以色媚人。旧指娼妓生涯。"},{"id":6368,"word":"依阿两可","pinyin":"yī ē liǎng kě","abbr":"yalk","explanation":"依阿：依靠阿谀；两可：不置可否，不明确表示是非。一味顺从附和，没有主见。","source":{"text":"臣恐自今奉使贼廷者以武为戒，苟求便身，率为依阿两可之言，莫肯尽诚具陈利害，如此，非国家之利也。","book":"《资治通鉴·唐纪·宪宗元和四年》"},"similar":["依违两可"],"usage":"作谓语、定语；用于处事"},{"id":6369,"word":"依阿取容","pinyin":"yī ē qǔ róng","abbr":"yeqr","explanation":"指依附随顺以取悦于人。","source":{"text":"又不依阿取容以循世俗，使怨嫉谤怒丛于一身，以受侮于群小。","book":"宋·欧阳修《〈归田录〉序》"},"example":{"text":"你没有丝毫～的姿态，但你也不荒伧。","book":"郭沫若《银杏》诗"},"usage":"作谓语、定语、宾语；用于处事"},{"id":6370,"word":"依阿无心","pinyin":"yī ē wú xīn","abbr":"yawx","explanation":"依阿：随声附和。随声附和，没有主见，曲从不察。","source":{"text":"其倚杖虚旷，依阿无心者，皆名重海内。","book":"晋·干宝《晋记·总论》"}},{"id":6371,"word":"侠肝义胆","pinyin":"xiá gān yì dǎn","abbr":"xgyd","explanation":"侠客的肝，义士的胆。形容见义勇为、锄强扶弱、打抱不平的心肠和行动。","source":{"text":"一家听着，先是生气，担惊，继而又被赵录明的侠肝义胆和一片热心所感动了。","book":"《蒲柳人家·后记》"},"similar":["助人为乐","见义勇为"],"opposite":["见死不救","见利忘义"],"usage":"作主语、谓语、宾语；指见义勇为"},{"id":6372,"word":"侧目而视","pinyin":"cè mù ér shì","abbr":"cmes","explanation":"侧：斜着。斜着眼睛看人。形容憎恨或又怕又愤恨。","source":{"text":"今天下重足而立，侧目而视矣。","book":"《史记·汲郑列传》"},"example":{"text":"诸君记得当年常肃剥皮做衮州府的时候，何尝不是这样？总是做得人人～就完了。","book":"清·刘鹗《老残游记》第三回"},"similar":["望而生畏","望而却步","怒目而视"],"opposite":["目不斜视"],"usage":"作谓语、状语；形容愤怒、不瞒或畏惧的样子","story":["战国时期，著名的大说客苏秦游说连横之策没有成功，穷困潦倒地回到家里，妻子不理睬他，嫂子看不起他。他潜心学习，学问大增。后游说赵王合纵抗秦，一举成名，衣锦还乡。妻子吓得恭恭敬敬站在一边，侧目而视，嫂子跪拜谢罪"]},{"id":6373,"word":"侧词艳曲","pinyin":"cè cí yàn qǔ","abbr":"ccyq","explanation":"侧：不正；艳：艳丽。文词艳丽而流于轻佻。","source":{"text":"少敏悟，薄行无检幅，多作侧词艳曲。","book":"《雅言杂录》"},"similar":["淫词艳曲"],"usage":"作主语、宾语；指轻佻的言词"},{"id":6374,"word":"侧足而立","pinyin":"cè zú ér lì","abbr":"czel","explanation":"形容有所畏惧，不敢正立。","source":{"text":"汉性强力，每从征伐，帝未安，恒侧足而立。","book":"南朝·宋·范晔《后汉书·吴汉传》"},"example":{"text":"他吓得～。"},"usage":"作谓语；指人敬畏或惧怕"},{"id":6375,"word":"侭多侭少","pinyin":"jǐn duō jǐn shǎo","abbr":"jdjs","explanation":"方言。犹言尽其所有。"},{"id":6376,"word":"侯服玉食","pinyin":"hóu fú yù shí","abbr":"hfys","explanation":"侯服：王侯之服；玉食：珍美食品。穿王侯的衣服，吃珍贵的食物。形容豪华奢侈的生活。","source":{"text":"侯服王食，败俗伤化。","book":"《汉书·叙传下》"},"example":{"text":"湛族为盛门，性颇豪侈，～，穷滋极珍。","book":"《晋书·夏侯湛传》"},"similar":["锦衣玉食"],"usage":"作宾语、定语；形容豪华奢侈的生活"},{"id":6377,"word":"侯王将相","pinyin":"hóu wáng jiàng xiàng","abbr":"hwjx","explanation":"王侯、武将和文臣。指古代统治阶级的上层代表势力。","source":{"text":"侯王将相望久绝，神纵欲福难为功。","book":"唐·韩愈《谒衡岳庙遂宿岳寺题门楼》"},"usage":"作主语、宾语、定语；指高官"},{"id":6378,"word":"侯门似海","pinyin":"hóu mén sì hǎi","abbr":"hmsh","explanation":"王公贵族的门庭像大海那样深遂。旧时豪门贵族、官府的门禁森严，一般人不能轻易进入。也比喻旧时相识的人，后因地位悬殊而疏远。","source":{"text":"公子王孙逐后尘，绿珠垂泪滴罗中；侯门一入深如海，从此萧郎是路人。","book":"唐·崔郊《赠去婢》诗"},"example":{"text":"～”，我是个什么东西儿！他家人又不认得我，去了也是白跑。 ★清·曹雪芹《红楼梦》第六回","book":"可是说的"},"similar":["侯门如海"],"usage":"作宾语；指显贵之家门禁森严","story":["唐朝秀才崔郊与他姑母家的婢女相恋，感情很深，后来她被卖给连帅，两人不得相见。一天，崔郊与她在路上相遇而不能交谈。崔郊感慨万分，就写下一诗：“公子王孙逐后尘，绿珠垂泪滴罗巾。侯门一入深如海，从此萧郎是路人。”"]},{"id":6379,"word":"侯门如海","pinyin":"hóu mén rú hǎi","abbr":"hmrh","explanation":"侯门：旧指显贵人家；海：形容深。侯门象大海那样深邃。比喻旧时相识的人，后因地位悬殊而疏远隔绝。","source":{"text":"公子王孙逐后尘，绿珠垂泪滴罗巾。侯门一入深如海，从此萧郎是路人。","book":"唐·崔郊《赠去婢》诗"},"example":{"text":"可是说的了：“～”，我是个什么东西儿！他家人又不认得我，去了也是白跑。","book":"清·曹雪芹《红楼梦》第六回"},"similar":["侯门似海"],"usage":"作宾语；指显贵之家门禁森严","story":["唐朝秀才崔郊与他姑母家的婢女相恋，感情很深，后来她被卖给连帅，两人不得相见。一天，崔郊与她在路上相遇而不能交谈。崔郊感慨万分，就写下一诗：“公子王孙逐后尘，绿珠垂泪滴罗巾。侯门一入深如海，从此萧郎是路人。”"]},{"id":6380,"word":"便僻侧媚","pinyin":"biàn pì cè mèi","abbr":"bpcm","explanation":"便僻：顺人之所欲，避人之所恶；侧媚：奸邪谄媚。指逢迎谄媚或逢迎谄媚的人。","source":{"text":"慎简乃僚，无以巧言令色，便僻侧媚，其惟吉士。","book":"《尚书·冏命》"}},{"id":6381,"word":"便宜从事","pinyin":"biàn yú cóng shì","abbr":"bycs","explanation":"指可斟酌情势，不拘规制条文，不须请示，自行处理。","source":{"text":"臣愿丞相御史且无拘臣以文法，得一切便宜从事。","book":"《汉书·循吏传·龚遂》"},"example":{"text":"汝既为水军都督，可以～，何必禀我？","book":"《三国演义》第四五回"},"similar":["便宜行事"],"usage":"作谓语、宾语；指方便行事"},{"id":6382,"word":"便宜施行","pinyin":"biàn yú shī xíng","abbr":"bysx","explanation":"指可斟酌情势，不拘规制条文，不须请示，自行处理。同“便宜从事”。","source":{"text":"[萧何]为法令约束，立宗庙社稷宫室县邑，辄奏上，可，许以从事；即不及奏上，辄以便宜施行，上来以闻。","book":"《史记·萧相国世家》"},"example":{"text":"一应军行调度，并听～。","book":"宋·周密《齐东野语·赵信国辞相》"},"similar":["便宜行事"],"usage":"作主语、宾语；根据具体情况自行采取适当处"},{"id":6383,"word":"便宜无好货","pinyin":"pián yí wú hǎo huò","abbr":"pywhh","explanation":"价格低廉就没有质量好的东西。","source":{"text":"便宜无好货，这药是吃了不中用的。","book":"清·李宝嘉《官场现形记》第49回"},"example":{"text":"俗话说：～，不能一概而论。"},"opposite":["价廉物美"],"usage":"作宾语、定语；多用于口语"},{"id":6384,"word":"便宜行事","pinyin":"biàn yì xíng shì","abbr":"byxs","explanation":"便宜：方便，适宜。指可以根据实际情况斟酌处理，不必请示。","source":{"text":"即不及奏上，辄以便宜施行，上来以闻。","book":"《史记·萧相国世家》"},"example":{"text":"既然大权交代于你，你就得～。","book":"清·李宝嘉《官场现形记》第十二回"},"similar":["见机行事","随机应变","便宜施行"],"opposite":["唯命是从"],"usage":"作主语、宾语；根据具体情况自行采取适当处"},{"id":6385,"word":"便辞巧说","pinyin":"biàn cí qiǎo shuō","abbr":"bcqs","explanation":"指牵强附会、巧为立说。","source":{"text":"便辞巧说，破坏形体，说五字之文，至于二三万言。","book":"《汉书·艺文志》"}},{"id":6386,"word":"便还就孤","pinyin":"bian huan jiu gu","abbr":"bhjg","explanation":"就撤回到我这里."},{"id":6387,"word":"促促刺刺","pinyin":"cù cù cì cì","abbr":"cccc","explanation":"形容很不安宁的样子。","source":{"text":"促促复刺刺，水中无鱼无山石。","book":"唐·王建《促促词》"}},{"id":6388,"word":"促忙促急","pinyin":"cù máng cù jí","abbr":"cmcj","explanation":"匆匆忙忙，慌慌张张。","source":{"text":"你应二爹今日手素，促忙促急，没带的甚么在身边，改日送胭粉钱来罢。","book":"明·兰陵笑笑生《金瓶梅词话》第二十二回"}},{"id":6389,"word":"促死促灭","pinyin":"cù sǐ cù miè","abbr":"cscm","explanation":"促：急。快死。咒骂人或自己起誓的话。"},{"id":6390,"word":"促膝而谈","pinyin":"cù xī ér tán","abbr":"cxet","explanation":"促：靠近。靠近坐着谈心里话。","source":{"text":"你看他剖橙而食，促膝而谈，欲去欲留，相调相谑。","book":"明·凌濛初《二刻拍案惊奇》第40卷"},"example":{"text":"我们兄弟～，十分融洽。"},"similar":["促膝谈心"],"usage":"作谓语；表示说知心话"},{"id":6391,"word":"促膝谈心","pinyin":"cù xī tán xīn","abbr":"cxtx","explanation":"促：靠近；促膝：膝碰膝，坐得很近。形容亲密地谈心里话。","source":{"text":"即有友人，不过十余知音之侣，来则促膝谈心，率皆圣贤之道，不敢稍涉异言。","book":"唐·田颖《揽云台记》"},"example":{"text":"依弟愚见，这厅事也太阔落，意欲借尊斋，只需一席酒，我四人～，方才畅快。","book":"清·吴敬梓《儒林外史》第十回"},"similar":["夜雨对床","促膝而谈"],"opposite":["唇枪舌剑"],"usage":"作谓语；表示说知心话"},{"id":6392,"word":"促鳞短羽","pinyin":"cù lín duǎn yǔ","abbr":"cldy","explanation":"指小鱼小鸟。","source":{"text":"愁洽百年，苦溢千岁，何异促鳞之游汀泞，短羽之栖翳荟。","book":"晋·张协《七命》"}},{"id":6393,"word":"俊杰廉悍","pinyin":"jùn jié lián hàn","abbr":"jjlh","explanation":"俊秀出众，廉洁不贪，精明强悍。","source":{"text":"俊杰廉悍，议论证据今古，出入经史百子。","book":"唐·韩愈《柳子厚墓志铭》"},"usage":"作谓语、定语；指人出众"},{"id":6394,"word":"俎上之肉","pinyin":"zǔ shàng zhī ròu","abbr":"zszr","explanation":"俎：菜板。菜板上的肉。比喻可以任人宰割","source":{"text":"……如令人方为刀俎，我为鱼肉，何辞为？","book":"西汉·司马迁《史记·项羽本纪》"},"usage":"作宾语；用于比喻句"},{"id":6395,"word":"俎樽折冲","pinyin":"zǔ zūn zhé chōng","abbr":"zzzc","explanation":"指在会盟的席上或外交谈判中制胜对方。","source":{"text":"许国之忠，应变之略，隐然有俎樽折冲之风。","book":"《续资治通鉴·宋宁宗嘉定十四年》"},"similar":["折冲尊俎"],"usage":"作谓语、定语；指外交谈判"},{"id":6396,"word":"俏成俏败","pinyin":"qiào chéng qiào bài","abbr":"xcxb","explanation":"近似于成或败，指非真成真败。","source":{"text":"佹佹成者，俏成也，初非成也；佹佹败者，俏败也，初非败也。故迷生于俏。","book":"《列子·力命》"},"usage":"作谓语、定语；用于书面语"},{"id":6397,"word":"俐齿伶牙","pinyin":"lì chǐ líng yá","abbr":"lcly","explanation":"指能说会道。","source":{"text":"你休听那厮说短论长，那般的俐齿伶牙。","book":"元张国宾《合汗衫》第二折"},"example":{"text":"一个铺眉苫眼，滔滔口若悬河；一个～，喋喋舌如干将。","book":"《醒世姻缘传》"},"similar":["伶牙俐齿"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；指能说会道"},{"id":6398,"word":"俗下文字","pinyin":"sú xià wén zì","abbr":"sxwz","explanation":"指为应付世事而写的平庸的应酬文章。","source":{"text":"时时应事作俗下文字，下笔令人惭。","book":"唐·韩愈《与冯宿论文书》"},"example":{"text":"明·徐渭《序》：“至于应事作～，下笔令人惭，小惭者人以为小好，大惭者即必以为大好。”"},"usage":"作宾语、定语；用于书面语"},{"id":6399,"word":"俗不伤雅","pinyin":"sú bù shāng yǎ","abbr":"sbsy","explanation":"俗：凡俗；雅：高尚的。虽然凡俗，但不流于鄙陋而有伤高雅。","example":{"text":"不过，我既没发财的志愿，也就不便多此一举，虽然贩卖旧书之举也许是～的吧。","book":"老舍《五月的青岛》"}},{"id":6400,"word":"俗不可医","pinyin":"sú bù kě yī","abbr":"sbky","explanation":"俗气已深，不可救药。","source":{"text":"人瘦尚可肥，士俗不可医。","book":"宋·苏轼《于潜僧绿筠轩》诗"},"similar":["俗不可耐"],"usage":"作谓语、定语；指俗气得不可救药"},{"id":6401,"word":"俗不可耐","pinyin":"sú bù kě nài","abbr":"sbkn","explanation":"俗：庸俗；耐：忍受得住。庸俗得使人受不了。","source":{"text":"一美人置白金一铤，可三四两许，秀才掇内袖中。美人取巾握手笑出曰：‘俗不可耐。’","book":"清·蒲松龄《聊斋志异·沂水秀才》"},"example":{"text":"她是一个～的胖女人。","book":"曹禺《日出》"},"similar":["不堪入目"],"opposite":["高风亮节","雅人深致"],"usage":"作谓语、定语；指庸俗得使人受不了"},{"id":6402,"word":"俗不堪耐","pinyin":"sú bù kān nài","abbr":"sbkn　","explanation":"俗：庸俗；耐：忍受得住。庸俗得使人受不了。","source":{"text":"一美人置白金一铤，可三四两许，秀才掇内袖中。美人取巾握手笑出曰：‘俗不可耐。’","book":"清·蒲松龄《聊斋志异·沂水秀才》"},"example":{"text":"壶的磁质是很粗糙的，浮出许多红绿的人物出来，在我看来实在是～。","book":"郭沫若《湖心亭》"},"similar":["俗不可耐"],"usage":"作谓语、定语；指庸俗得使人受不了"},{"id":6403,"word":"俗之所排","pinyin":"sú zhī suǒ pái","abbr":"szsp","explanation":"俗：流俗；排：排斥。世俗之见所排斥的。","source":{"text":"明君取士，贵拔众之所遗；忠臣荐善，不废俗之所排。","book":"汉·扬雄《连珠》"}},{"id":6404,"word":"俗手伶工","pinyin":"sú shǒu líng gōng","abbr":"sslg","explanation":"伶：旧时指唱戏的人。指平凡的乐工。","source":{"text":"此谱即当宣付梨园，但恐俗手伶工，未谙其妙。","book":"清·洪昇《长生殿·制谱》"}},{"id":6405,"word":"俗易风移","pinyin":"sú yì fēng yí","abbr":"syfy","explanation":"易：变换；移：改变。改变旧的风俗习惯。","source":{"text":"乐者，圣人之所乐也，而可以善民心，其感人深，其移风易俗，故先王导之以礼乐而民和睦。","book":"《荀子·乐论》"},"example":{"text":"是知～，必由上之所好，非夫圣明御世，亦无以振斯颓俗矣。","book":"《晋书·儒林传》"}},{"id":6406,"word":"俗耳针砭","pinyin":"sú ěr zhēn biān","abbr":"sezb","explanation":"俗：庸俗；砭：古代治病用的针砭；针砭：古人砭石为针的治病术。旧时指医治庸俗的听觉而使之高雅。","source":{"text":"戴颙春携双柑斗酒，人问何之，曰：‘往听黄鹂声。此俗耳针砭，诗肠鼓吹，汝知之乎？’","book":"唐·冯贽《云仙杂记》卷二引《高隐外书》"}},{"id":6407,"word":"俗语常言","pinyin":"sú yǔ cháng yán","abbr":"sycy","explanation":"早已在民间流传，至今人们还经常说的话。","source":{"text":"岂不闻俗语常言，酒解愁肠。","book":"元·高文秀《遇上皇》第一折"},"example":{"text":"～，鬼行地中，如鱼行水中；鬼不见地，亦如鱼不见水。","book":"清·刘鹗《老残游记》第九回"}},{"id":6408,"word":"俗谚口碑","pinyin":"sú yàn kǒu bēi","abbr":"sykb","explanation":"俗：通俗。谚：谚语。口碑：指流传的口头俗语。广泛流传的通俗的谚语和俗语。","source":{"text":"一面说，一面从顺袋中取出一张抄的护官符来，递与雨村看时，上面皆是本地大族名宦之家的俗谚口碑。","book":"清·曹雪芹《红楼梦》第四回"}},{"id":6409,"word":"俛拾仰取","pinyin":"fǔ shí yǎng qǔ","abbr":"fsyq","explanation":"俛，同“俯”。指低头则必拾地上之物，仰首则必取树上之物。形容极其勤劳节俭。","source":{"text":"然家自父兄子孙约，俛有拾，仰有取，贳贷行贾徧郡国。","book":"语出《史记·货殖列传》"}},{"id":6410,"word":"俛拾地芥","pinyin":"bì shí dì jiè","abbr":"fsdj","explanation":"比喻极易获得。"},{"id":6411,"word":"俛首帖耳","pinyin":"mǎ shǒu tiē ěr","abbr":"fste","explanation":"驯服恭顺的样子。"},{"id":6412,"word":"俛首系颈","pinyin":"fǔ shǒu xì jǐng","abbr":"fsxj","explanation":"俛：同“俯”，低下。低下头，用绳子拴着脖子。形容卑躬屈膝低头认罪。","source":{"text":"百越之君，俛首系颈，委命下吏。","book":"汉·贾谊《过秦论》"},"usage":"作谓语、定语；用于处世"},{"id":6413,"word":"保业守成","pinyin":"bǎo yè shǒu chéng","abbr":"bysc","explanation":"守成：保持已取得的成就。保持已取得的成就和业绩。","source":{"text":"夫道者所以反本复始。义者所以行事立功。谋者所以违害就利。要者所以保业守成。","book":"战国·吴起《吴子·图国》"}},{"id":6414,"word":"保固自守","pinyin":"bǎo gù zì shǒu","abbr":"bgzs","explanation":"指凭借天险，坚守不战。","source":{"text":"及王莽之败，霸保固自守，卒全一郡。","book":"《后汉书·侯霸传》"}},{"id":6415,"word":"保国安民","pinyin":"bǎo guó ān mín","abbr":"bgam","explanation":"保卫国家，使人民安居乐业。","source":{"text":"依此而行，可救宋江，保国安民，替天行道。","book":"明·施耐庵《水浒全传》第五十四回"},"example":{"text":"而友邦远国，顺天事大，～，皇天监之，亦克昌焉。","book":"《明史·西域四》"},"similar":["保家卫国","保境安民"],"usage":"作谓语、宾语；指军队的职责"},{"id":6416,"word":"保境安民","pinyin":"bǎo jìng ān mín","abbr":"bjam","explanation":"安民：安定人民生活。保卫国境，使人民安居乐业","source":{"text":"但愿共存忠义于心，同著功勋于国，替天行道，保境安民。","book":"明·施耐庵《水浒传》第71回"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“现在局势越来越紧，～，耽误不得。”"},"similar":["保国安民"],"usage":"作谓语、宾语；指军队的职责"},{"id":6417,"word":"保境息民","pinyin":"bǎo jìng xī mín","abbr":"bjxm","explanation":"保卫国家边疆，使人民得以安宁。","source":{"text":"先是，国家与齐通好，约言各保境息民，不相侵扰。","book":"《周书·刘雄传》"},"example":{"text":"王能～，则福可长享。","book":"《明史·外国五》"},"similar":["保国安民"],"usage":"作谓语、定语；指军队的职责"},{"id":6418,"word":"保守主义","pinyin":"bǎo shǒu zhǔ yì","abbr":"bszy","explanation":"守旧、不想改进的思想和行为。","source":{"text":"正确地规定战略方向，进攻时反对冒险主义，防御时反对保守主义，转移时反对逃跑主义。","book":"毛泽东《中国革命战争的战略问题》"},"usage":"作主语、宾语、定语；用于处事"},{"id":6419,"word":"保家卫国","pinyin":"bǎo jiā wèi guó","abbr":"bjwg","explanation":"保卫家乡和祖国。","source":{"text":"在保家卫国的强烈感情里，我们两国人民是血肉相连的！","book":"冰心《跟小朋友谈访埃观感》"},"example":{"text":"男子汉应担当起～的重任。"},"opposite":["卖国求荣"],"usage":"作谓语、宾语、定语；用于战争时期"},{"id":6420,"word":"保护伞","pinyin":"bǎo hù sǎn","abbr":"bhs","explanation":"比喻赖以不受伤害的资本","example":{"text":"你不要充当黑势力的～"},"similar":["保护神"],"usage":"作宾语、定语；多用于比喻句"},{"id":6421,"word":"保残守缺","pinyin":"bǎo cán shǒu quē","abbr":"bcsq","explanation":"①指汉代今文经学派儒生墨守残缺不全的今文经典而拘执一家之言。后常用以比喻泥古守旧，不知改进。②指保藏残缺的古籍文献。","source":{"text":"信口说而背传记，是末师而非往古……犹欲保残守缺，挟恐见破之私意，而无从善服义之公心，或怀妒嫉，不考情实，雷同相从，随声是非，抑此三学。","book":"《汉书·刘歆传》"},"example":{"text":"两汉而下，维多～之人，六经所传，未有继往开来之哲。","book":"清·顾炎武《华阴县朱子祠堂上梁文》"},"similar":["抱残守缺","补残守缺","泥古不化"],"opposite":["推陈出新"],"usage":"作谓语、宾语、状语；形容人守旧"},{"id":6422,"word":"保泰持盈","pinyin":"bǎo tài chì yíng","abbr":"btcy","explanation":"指保持安定兴盛的局面。","source":{"text":"孝宗儿能恭俭有制，勤政爱民，兢兢于保泰持盈之道，用使朝序清宁，民物康阜。","book":"《明史·孝宗纪赞》"},"example":{"text":"循劂端绪，则朝章国典，沿革人文，而惩前毖后，～，胥可言外得之。","book":"清·谭献《序》"},"similar":["保盈持泰"],"usage":"作宾语、定语；指维持社会安定"},{"id":6423,"word":"保盈持泰","pinyin":"bǎo yíng chì tài","abbr":"byct","explanation":"指保持安定兴盛的局面。","source":{"text":"参见“保泰持盈”。"},"example":{"text":"因要～，避免地中海的危机严重化而对意德有所让步。","book":"邹韬奋《国际形势与中国抗战》"},"similar":["保泰持盈"],"usage":"作宾语、定语；指维持社会安定"},{"id":6424,"word":"保纳舍藏","pinyin":"bǎo nà shè cáng","abbr":"bnsc","explanation":"收容并窝藏。","source":{"text":"保纳舍藏者融也，当坐之。","book":"《后汉书·孔融传》"}},{"id":6425,"word":"俟河之清","pinyin":"sì hé zhī qīng","abbr":"shzq","explanation":"俟：等待。等待黄河变清。比喻期望的事情不能实现。","source":{"text":"《周诗》有之曰：‘俟河之清，人寿几何？’","book":"《左传·襄公八年》"},"example":{"text":"真所谓“～”呢！","book":"叶圣陶《桥上》"},"usage":"作谓语、定语；指难以实现的事"},{"id":6426,"word":"俟河之清，人寿几何","pinyin":"sì hé zhī qīng，rén shòu jǐ hé","abbr":"shzqrsjh","explanation":"俟：等待。人的寿命很短，等待黄河变清是不可能的。比喻期望的事情不能实现。","source":{"text":"《周诗》有之曰：‘俟河之清，人寿几何？’","book":"《左传·襄公八年》"}},{"id":6427,"word":"俠多俠少","pinyin":"jǐn duō jǐn shǎo","abbr":"jdjs","explanation":"方言。犹言尽其所有。"},{"id":6428,"word":"信不由衷","pinyin":"xìn bù yóu zhōng","abbr":"xbyz","explanation":"信：诚实；衷：内心。诚实不是出自内心。比喻假意敷衍。","source":{"text":"然犹复云云者，仆以是知足下之言，信不由衷，将以救祸也。","book":"《左传·隐公三年》：“信不由中，质无益也。”《一国志·魏志·臧洪传》"},"example":{"text":"败之自彼，信不由衷，～。","book":"《宋史·林栗传》"},"usage":"作谓语、定语；用于书面语"},{"id":6429,"word":"信以为实","pinyin":"xìn yǐ wéi shí","abbr":"xyws","explanation":"信：相信。指把虚无的当作真实存在的","source":{"text":"况且窝盗为事，声名扬开去不好听，别人不管好歹，信以为实，就怕来缠帐。","book":"明·凌濛初《二刻拍案惊奇》第15卷"},"example":{"text":"清·吴璿《飞龙全传》第26回：“定睛细看，乃是个泥塑的土地，方才～。”"},"similar":["信以为真"],"usage":"作谓语；指把假的当作真的"},{"id":6430,"word":"信以为本","pinyin":"xìn yǐ wéi běn","abbr":"xywb","explanation":"信：诚实。以诚实可信作为处世的根本。指言行要遵守信用。","source":{"text":"武将信以为本，循而行之。","book":"春秋·鲁·左丘明《左传·昭公九年》"},"usage":"作宾语、定语；用于书面语"},{"id":6431,"word":"信以为真","pinyin":"xìn yǐ wéi zhēn","abbr":"xywz","explanation":"相信他是真的。指把假的当作真的。","source":{"text":"只因他平日冒称是宰相房玄龄之后，在人前夸炫家世，同僚中不知他的来历，信以为真，把他十分敬重。","book":"明·冯梦龙《醒世恒言·李汧公穷邸遇侠客》"},"example":{"text":"宝玉又问他地名庄名，来往远近，坐落何方，刘老老便顺口诌了出来。宝玉～。","book":"清·曹雪琴《红楼梦》第三十九回"},"similar":["坚信无疑"],"opposite":["疑神疑鬼","将信将疑"],"usage":"作谓语；指把假的当作真的"},{"id":6432,"word":"信以传信，疑以传疑","pinyin":"xìn yǐ chuán xìn，yí yǐ chuán yí","abbr":"xycxyycy","explanation":"可信的，就作为可信的留传下去；可疑的，仍然作为可疑的留传下去。指对文献资料及传说中的不同说法，采取客观审慎的态度。","source":{"text":"五年春，正月甲戌、己丑，陈侯鲍卒。鲍卒，何为以二日卒之？春秋之义，信以传信，疑以传疑。","book":"《谷梁传·桓公五年》"},"example":{"text":"鬼神不能自成，须人而生，柰何无父而生乎！一言有父，一言无父，～，故两言之。","book":"《史记·三代世表》"},"usage":"作宾语、定语；用于书面语"},{"id":6433,"word":"信使往来","pinyin":"xìn shǐ wǎng lái","abbr":"xswl","explanation":"信使：指传递消息或承担使命的人，即使者。双方互派的使者来来往往。","source":{"text":"西域虽通魏氏，而中原始平，天子方以混一为心，未遑征伐。其信使往来，深得羁縻勿绝之道耳。","book":"《魏书·西域传论》》"},"example":{"text":"从此闯、曹两营～不断，都瞒着西营耳目。","book":"姚雪垠《李自成》第三卷第九章"},"similar":["信使往还"],"usage":"作宾语、定语；用于交往等"},{"id":6434,"word":"信使往还","pinyin":"xìn shǐ wǎng huán","abbr":"xswh","explanation":"信使：指传递消息或承担使命的人，即使者。双方互派的使者来来往往。","source":{"text":"寿阳被围，大军出拒之，信使往还，须禀节度。","book":"《资治通鉴·陈纪·高宗宣皇帝太建四年》"},"example":{"text":"却说傅宗龙、杨文岳会师之前，已经通过～，确定了基本方略，以稳重为上策。","book":"姚雪垠《李自成》第三卷第十八章"},"similar":["信使往来"],"usage":"作宾语、定语；用于交往等"},{"id":6435,"word":"信及豚鱼","pinyin":"xìn jí tún yú","abbr":"xjty","explanation":"及：达到；豚：小猪。信用及于小猪和鱼那样微贱的东西。比喻信用非常好。","source":{"text":"豚鱼吉。信及豚鱼也。","book":"《周易·中孚》"},"example":{"text":"百揆时叙，六乐克和。～，恩加动植。","book":"前蜀·杜光庭《谢允上尊号表》"},"usage":"作谓语；比喻信用非常好"},{"id":6436,"word":"信受奉行","pinyin":"xìn shòu fèng xíng","abbr":"xsfx","explanation":"信：信仰；奉：执行。接受教诲，虔敬奉行。比喻坚信不移，奉行不悖。","source":{"text":"一切大众闻佛所说，皆大欢喜，信受奉行。","book":"《仁王经·末》"},"usage":"作谓语、定语；用于书面语"},{"id":6437,"word":"信口开合","pinyin":"xìn kǒu kāi hé","abbr":"xkkh","explanation":"比喻随口乱说一气。","source":{"text":"你休只管信口开合，絮絮聒聒，俺张孔目怎肯缘木求鱼。","book":"元·关汉卿《鲁斋郎》第四折"},"example":{"text":"他说得高兴，就～起来。"},"similar":["信口开河","信口开喝","顺口开河"],"usage":"作谓语、宾语、状语；指随口乱说"},{"id":6438,"word":"信口开呵","pinyin":"xìn kǒu kāi hē","abbr":"xkkh","explanation":"比喻随口乱说一气。同“信口开合”。","source":{"text":"你待要着死撞活，将功折过，你休那里信口开呵。","book":"元·尚仲贤《气英布》第一折"},"similar":["信口开喝","信口开河","信口开合"],"usage":"作谓语、宾语、状语；指随口乱说","story":["楚汉相争时期，刘邦与项羽在灵壁激战，刘邦败北，屯兵荥阳。项羽授英布为“当阳君”，率40万进驻九江。刘邦派“典谒官”随何去劝说英布投降。英布则说随何信口开河，然而他还是投降刘邦。刘邦故意气他，后设宴款待，封“九江侯”"]},{"id":6439,"word":"信口开喝","pinyin":"xìn kǒu kāi hē","abbr":"xkkh","explanation":"比喻随口乱说一气。同“信口开合”。","source":{"text":"非是俺全身远害，免教人信口开喝。","book":"元·张养浩《新水令·辞官》"},"similar":["信口开呵","信口开合","信口开河"],"usage":"作谓语、宾语、状语；指随口乱说"},{"id":6440,"word":"信口开河","pinyin":"xìn kǒu kāi hé","abbr":"xkkh","explanation":"比喻随口乱说一气。","source":{"text":"你那里休聒，不当一个信口开合知。","book":"元·王实甫《西厢记》第二本第三折"},"example":{"text":"村老老是～，情哥哥偏寻根究底。","book":"清·曹雪芹《红楼梦》第三十九回"},"similar":["胡言乱语","胡说八道","信口胡言"],"opposite":["信而有征","言之凿凿"],"usage":"作谓语、宾语、状语；指随口乱说","story":["楚汉相争时期，刘邦与项羽在灵壁激战，刘邦败北，屯兵荥阳。项羽授英布为“当阳君”，率40万进驻九江。刘邦派“典谒官”随何去劝说英布投降。英布则说随何信口开河，然而他还是投降刘邦。刘邦故意气他，后设宴款待，封“九江侯”"]},{"id":6441,"word":"信口胡言","pinyin":"xìn kǒu hú yán","abbr":"xkhy","explanation":"随口乱说。指毫无根据、不负责任地瞎说。","source":{"text":"这里什么去处，你敢信口胡言！","book":"清·吴璿《飞龙全传》第一回"},"example":{"text":"请不要相信他的～"},"similar":["信口开河","信口胡诌"],"usage":"作谓语、宾语、状语；指随口乱说"},{"id":6442,"word":"信口胡诌","pinyin":"xìn kǒu hú zhōu","abbr":"xkhz","explanation":"随口乱说。指毫无根据，不负责任地瞎说。","source":{"text":"若说有君有长时用敬，则无君无亲无长之时，将不敬乎？都不思量，只是信口胡说。","book":"宋·朱熹《朱子语类》卷十二"},"example":{"text":"今番泼水难收，到那里问缘由，怎敢便～。","book":"元·康进之《李逵负荆》第一折"},"similar":["信口胡言","信口开河"],"usage":"作谓语、宾语、状语；指随口乱说"},{"id":6443,"word":"信口胡说","pinyin":"xìn kǒu hú shuō","abbr":"xkhs","explanation":"随口乱说。指毫无根据，不负责任地瞎说。","source":{"text":"若说有君有长时用敬，则无君无亲无长之时，将不敬乎？都不思量，只是信口胡说。","book":"宋·朱熹《朱子语类》卷十二"},"example":{"text":"崇祯脸色大变，怒气填胸，问道：“陈新甲可知道谢升在朝房～？”","book":"姚雪垠《李自成》第三卷第七章"}},{"id":6444,"word":"信口雌黄","pinyin":"xìn kǒu cí huáng","abbr":"xkch","explanation":"信：任凭，听任；雌黄：即鸡冠石，黄色矿物，用作颜料。古人用黄纸写字，写错了，用雌黄涂抹后改写。比喻不顾事实，随口乱说。","source":{"text":"王衍，字夷甫，能言，于意有不安者，辄更易之，时号口中雌黄。","book":"晋·孙盛《晋阳秋》"},"example":{"text":"如果孙俊英按事实讲也没有什么，但是她加油添醋，～，凭空捏造，极尽诬蔑挑拨之能事。","book":"冯德英《迎春花》第二十一章"},"similar":["胡说八道","胡言乱语","信口开河"],"opposite":["信而有征","言之凿凿","守口如瓶"],"usage":"作谓语、宾语、定语；指说话随便","story":["晋朝清谈家王衍担任元城县令时很少办公事，经常约人在一起没完没了地闲聊。他最喜欢老子和庄子的玄理，清谈时手里拿着鹿尾拂尘，侃侃而谈，经常前后矛盾，漏洞百出，有人质疑时，他随口更改，随心所欲。人们说他是“口中雌黄”"]},{"id":6445,"word":"信嘴胡说","pinyin":"xìn zuǐ hú shuō","abbr":"xzhs","explanation":"信：由。由着嘴胡说八道。","source":{"text":"别是宝玉有嘴无心，傻子似的从没个忌讳，高兴了信嘴胡说也是有的。","book":"清·曹雪芹《红楼梦》第78回"},"example":{"text":"请不要～。"},"similar":["信口开合"],"usage":"作谓语、宾语；用于人的言语"},{"id":6446,"word":"信外轻毛","pinyin":"xìn wài qīng máo","abbr":"xwqm","explanation":"佛教语。信心动摇不定，像鸿毛轻飘浮动。","source":{"text":"况我信外轻毛，敢知旨趣。","book":"《观经玄义分》"},"usage":"作谓语；用于书面语"},{"id":6447,"word":"信守不渝","pinyin":"xìn shǒu bù yú","abbr":"xsby","explanation":"坚守信用不变。","example":{"text":"为顾客提供最佳品质的产品，是这家公司几十年来始终～的宗旨。"},"similar":["信守诺言"],"opposite":["言而无信"],"usage":"作谓语、定语、状语；用于处事"},{"id":6448,"word":"信心十足","pinyin":"xìn xīn shí zú","abbr":"xxsz","explanation":"非常有信心。","similar":["信心百倍","胸有成竹"],"usage":"多用于褒义。"},{"id":6449,"word":"信手拈出","pinyin":"xìn shǒu niān chū","abbr":"xsnc","explanation":"信手：随手；拈：用手指捏取东西。随手拿出来。多指写文章时能自由纯熟的选用词语或应用典故，用不着怎么思考。","source":{"text":"学诗当如初学禅，未悟且遍参诸方。一朝悟罢正法眼，信手拈出皆成章。","book":"宋·韩驹《赠赵伯鱼》"},"example":{"text":"乾隆～一枝，取了签标看时，上头是一首诗。","book":"二月河《乾隆皇帝》十七"}},{"id":6450,"word":"信手拈来","pinyin":"xìn shǒu niān lái","abbr":"xsnl","explanation":"信手：随手；拈：用手指捏取东西。随手拿来。多指写文章时能自由纯熟的选用词语或应用典故，用不着怎么思考。","source":{"text":"前身子美只君是，信手拈来俱天成。","book":"宋·苏轼《次韵孔毅甫集古人句见赠》诗"},"example":{"text":"惹一番～斧痕。","book":"元·无名氏《度柳翠》第一折"},"similar":["顺手牵羊","唾手可得"],"opposite":["大海捞针","来之不易"],"usage":"作谓语、定语、状语；用于写作等"},{"id":6451,"word":"信手涂鸦","pinyin":"xìn shǒu tú yā","abbr":"xsty","explanation":"信：听凭，随意；信手：随意书写；涂鸦：比喻字写得很拙劣，随便乱涂乱画。形容字写得很潦草。也常用作自谦之词。","source":{"text":"不知四体正困惫，泥人啼哭声呀呀。忽来案上翻墨汁，涂抹诗书如老鸦。","book":"唐·卢仝《示添丁》诗"}},{"id":6452,"word":"信步漫游","pinyin":"xìn bù màn yóu","abbr":"xbmy","explanation":"信、漫：随意。随意走走逛逛。","source":{"text":"曳杖东冈信步行，夕阳偏向竹间明。","book":"宋·陆游《龟堂杂兴》诗"},"example":{"text":"～了一会，听得晚鸟还巢叫声，抬头看了看天，西天边上抹出几道红色云霞。","book":"李英儒《野火春风斗古城》第二章"},"similar":["信步而行"],"usage":"作谓语、状语；用于走路等"},{"id":6453,"word":"信步而行","pinyin":"xìn bù ér xíng","abbr":"xbex","explanation":"信：随意。无目的地随意行走。","source":{"text":"曳杖东冈信步行，夕阳偏向竹间明。","book":"宋·陆游《龟堂杂兴》诗"},"example":{"text":"明·冯梦龙《警世通言》第11卷：“单说朱婆与郑夫人寻思黑夜无路投奔，～，只拣僻静处走去。”"},"similar":["信步漫游"],"usage":"作谓语、状语；用于走路等"},{"id":6454,"word":"信笔涂鸦","pinyin":"xìn bǐ tú yā","abbr":"xbty","explanation":"信：听凭，随意；信笔：随意书写；涂鸦：比喻字写得很拙劣，随便乱涂乱画。形容字写得很潦草。也常用作自谦之词。","source":{"text":"不知四体正困惫，泥人啼哭声呀呀。忽来案上翻墨汁，涂抹诗书如老鸦。","book":"唐·卢仝《示添丁》诗"},"example":{"text":"僻处蛮乡，无师讲究，不过～。","book":"清·李渔《意中缘·先订》"},"opposite":["工工整整"],"usage":"作谓语、定语；常用作自谦之"},{"id":6455,"word":"信而好古","pinyin":"xìn ér hào gǔ","abbr":"xehg","explanation":"信：相信；好：爱好。相信并爱好古代的东西。","source":{"text":"述而不作，信而好古。","book":"《论语·述而》"},"example":{"text":"这样，我们的～的态度，便发生了新意义。","book":"钱钟书《写在人生边上·读》"},"usage":"作谓语、定语；用于人的爱好"},{"id":6456,"word":"信而有征","pinyin":"xìn ér yǒu zhēng","abbr":"xeyz","explanation":"信：确实；征：征验，证据。可靠而且有证据。","source":{"text":"君子之言，信而有征。","book":"《左传·昭公八年》"},"example":{"text":"称多则吾岂敢，言拙～。","book":"晋·潘岳《闲居赋》"},"similar":["有凭有据","千真万确"],"opposite":["捕风捉影","无凭无据"],"usage":"作谓语、宾语；指可信"},{"id":6457,"word":"信而有证","pinyin":"xìn ér yǒu zhèng","abbr":"xeyz","explanation":"真实而有根据。","source":{"text":"君子之言，信而有征。","book":"《左传·昭公八年》"},"example":{"text":"～者从之，乖异传疑者不录。","book":"元·马端临《文献通考序》"},"usage":"作谓语、定语；用于人或事物等"},{"id":6458,"word":"信言不美","pinyin":"xìn yán bù měi","abbr":"xybm","explanation":"信：真实。美：美妙，漂亮。真实的话未经加工，所以不美妙动听。","source":{"text":"信言不美，美言不信。","book":"《老子》第八十一章"},"example":{"text":"是的，“美言不信，～”，我必须告诉你真实的情况。","book":"《霍达》穆斯林的葬礼》第十章"},"usage":"作宾语、定语；用于书面语"},{"id":6459,"word":"信誉卓著","pinyin":"xìn yù zhuó zhù","abbr":"xyzz","explanation":"卓著：突出显著。信用与名誉特别好。","example":{"text":"他这块金字招牌～。"},"usage":"作谓语、定语；用于处事"},{"id":6460,"word":"信誓旦旦","pinyin":"xìn shì dàn dàn","abbr":"xsdd","explanation":"信誓：表示诚意的誓言；旦旦：诚恳的样子。誓言说得真实可信。","source":{"text":"言笑晏晏，信誓旦旦。","book":"《诗经·卫风·氓》"},"example":{"text":"臣乃脉定于内，心正于怀，～，秉志不回，翻然高举，与彼长辞。","book":"鲁迅《汉文学史纲要》第十篇"},"similar":["海枯石烂","指天誓日","言而有信"],"opposite":["言而无信","食言而肥"],"usage":"作谓语、定语、状语；用于发誓","story":["春秋时期，卫国淇水边住着一个被丈夫遗弃的女子，他年轻天真漂亮。一个奸诈男子看中她，甜言蜜语向她求婚，信誓旦旦地表示要与她白头偕老。秋后，他们结为夫妻。丈夫违背先前的诺言，占有她的财物，并无情地抛弃了她"]},{"id":6461,"word":"信赏必罚","pinyin":"xìn shǎng bì fá","abbr":"xsbf","explanation":"信：真实不欺。有功劳的一定奖赏，有罪过的一定惩罚。形容赏罚严明。","source":{"text":"信赏必罚，其足以战。","book":"《韩非子·外储说右上》"},"example":{"text":"诸葛治蜀，赏信必罚，彭羕、李严，皆纵横之魁杰，故羕诛而严流。","book":"章炳麟《诸子学略说》"},"similar":["赏罚分明"],"usage":"作谓语、定语；指奖罚分明"},{"id":6462,"word":"信马游缰","pinyin":"xìn mǎ yóu jiāng","abbr":"xmyj","explanation":"信：听凭。骑着马随意游荡。指没主意，受外力左右。指不受约束，任意游荡。","source":{"text":"这四五年来，每日信马游缰，如在醉梦中一般。","book":"清·李绿园《歧路灯》第14回"},"similar":["信马由缰"],"usage":"作谓语、定语；指无目的的游荡"},{"id":6463,"word":"信马由缰","pinyin":"xìn mǎ yóu jiāng","abbr":"xmyj","explanation":"信、由：听任。骑着马无目的地闲逛。比喻随便走走。也比喻无主见，随外力而转移。","source":{"text":"却说王氏是一个昏天黑地的母亲，绍闻是一个信马由缰的儿子。","book":"清·李绿园《歧路灯》第八十六回"},"example":{"text":"他～地走到中央公园，糊里糊涂地买了一张门券进去。（老舍《老张的哲学》第三十二章）"},"similar":["信马游缰"],"usage":"作谓语、状语；比喻随便走走"},{"id":6464,"word":"俨乎其然","pinyin":"yǎn hū qí rán","abbr":"yhqr","explanation":"十分严肃正经的样子。带有讽刺意味。","source":{"text":"刊物上登载一篇俨乎其然的像煞有介事的文章，我们就知道字里行间还有看不见的鬼把戏。","book":"鲁迅《伪自由书·文学上的折扣》"},"example":{"text":"听起来，那人坐在或站在正对面，～地审问他。","book":"孔厥《新儿女英雄续传》"},"usage":"作定语、状语；指俨然"},{"id":6465,"word":"俪青妃白","pinyin":"lì qīng pèi bái","abbr":"lqfb","explanation":"俪：成双，成对；妃：同“配”。用青配白。比喻文句对偶工整。","source":{"text":"世之模拟窜窃，取青媲白，肥皮厚肉，柔筋脆骨，而以为辞者之读之也，其大笑固矣。","book":"唐·柳宗元《读韩愈所著毛颖传后题》"}},{"id":6466,"word":"俭不中礼","pinyin":"jiǎn bù zhòng lǐ","abbr":"jbzl","explanation":"指节省太过而不合于礼。","source":{"text":"《蟋蟀》，刺晋僖公也。俭不中礼，故作是诗以闵之。","book":"《诗经·唐风·蟋蟀序》"},"example":{"text":"珪既～，时论以是少之。","book":"《旧唐书·王珪传》"},"usage":"作谓语；指过分节俭"},{"id":6467,"word":"俭以养廉","pinyin":"jiǎn yǐ yǎng lián","abbr":"jyyl","explanation":"俭：节俭；廉：廉洁。节俭可以培养廉洁的作风。","source":{"text":"夫君子之行，静以养身，俭以养德。","book":"三国·蜀·诸葛亮《诫子书》"},"example":{"text":"～看起来容易，做起来难。"},"similar":["俭可养廉"],"usage":"作定语、主语；指节俭可以培养廉洁的作风"},{"id":6468,"word":"俭以养德","pinyin":"jiǎn yǐ yǎng dé","abbr":"jyyd","explanation":"节俭有助于养成质朴勤劳的德操。","source":{"text":"夫君子之行，静以修身，俭以养德。","book":"三国·蜀·诸葛亮《诫子书》"},"usage":"作宾语、定语；用于劝诫人"},{"id":6469,"word":"俭可以养廉","pinyin":"jiǎn kě yǐ yǎng lián","abbr":"jkyyl","explanation":"俭：节省，俭约；廉：廉洁。节俭可以帮助养成廉洁的操守。","source":{"text":"又谓惟淡可以从俭，惟俭可以养廉。有味哉，有味哉！","book":"明·周顺昌《第后柬德升诸兄弟》"},"similar":["俭可以助廉"],"usage":"作宾语、定语；用于劝诫人"},{"id":6470,"word":"俭可以助廉","pinyin":"jiǎn kě yǐ zhù lián","abbr":"jkyzl","explanation":"俭：节省，俭约；廉：廉洁。节俭可以帮助养成廉洁的操守。","source":{"text":"亲族有请教者，纯仁曰：‘惟俭可以助廉，惟恕可以成德。","book":"《宋史·范纯仁传》"},"similar":["俭可以养廉"],"usage":"作宾语、定语；用于劝诫人"},{"id":6471,"word":"俭可养廉","pinyin":"jiǎn kě yǎng lián","abbr":"jkyl","explanation":"俭：节俭；廉：廉洁。节俭可以养成廉洁的操守。","source":{"text":"惟俭可以助廉，惟恕可以成德。","book":"《宋史·范纯仁传》"},"similar":["俭以养廉"],"usage":"作定语、宾语；指节俭可以培养廉洁的作风"},{"id":6472,"word":"俭存奢失","pinyin":"jiǎn cún shē shī","abbr":"jcss","explanation":"俭：节俭。存：留存。奢：奢侈。节俭的人就是能留存下来，奢侈的人必然败亡。","source":{"text":"俭存奢失今在目，安用高墙围大屋。","book":"唐·白居易《杏为梁》"}},{"id":6473,"word":"俭故能广","pinyin":"jiǎn gù néng guǎng","abbr":"jgng","explanation":"平素俭省，所以能够富裕。","source":{"text":"慈故能勇，俭故能广。","book":"《老子》"},"usage":"作宾语、定语；用于劝诫人"},{"id":6474,"word":"俭者心常富","pinyin":"jiǎn zhě xīn cháng fù","abbr":"jzxcf","explanation":"俭：节俭；富：富足。节俭的人常常觉得很富足。","source":{"text":"奢者心常贫，俭者心常富。","book":"五代·谭峭《化书》卷六"}},{"id":6475,"word":"俭腹高谈","pinyin":"jiǎn fù gāo tán","abbr":"jfgt","explanation":"俭腹：腹中空空，比喻知识匮乏。腹中知识匮乏，却喜欢高谈阔论。","source":{"text":"俭腹高谈我用忧，肯肩朴学胜封侯。","book":"清·龚自珍《己亥杂诗》"},"usage":"作宾语、定语；用于书面语"},{"id":6476,"word":"俭薄不充","pinyin":"jiǎn bó bù chōng","abbr":"jbbc","explanation":"俭：节俭；充：充裕。指生活极为俭朴，不富裕。","source":{"text":"居贫养母，俭薄不充。","book":"《后汉书·周磐传》"}},{"id":6477,"word":"修仁行义","pinyin":"xiū rén xíng yì","abbr":"xrxy","explanation":"修：培养；行：推行。建立爱民的仁政，推行正义的的措施。","source":{"text":"汤、武之王，乃由契、后稷修仁行义十余世，不期而会孟津八百诸侯，犹以为未可，其后乃放弒。","book":"《史记·秦楚之际月表》"},"example":{"text":"今边境无事，正宜～，尚于无为，令家给人足，安业乐产。","book":"蔡东藩《后汉演义》第三十二回"},"usage":"作谓语、定语；用于处事"},{"id":6478,"word":"修修补补","pinyin":"xiū xiū bǔ bǔ","abbr":"xxbb","explanation":"修理破损之物使之完好。","source":{"text":"一句话，就是要革命，不要改良，不要修修补补。","book":"邓小平《用先进技术和管理方法改造企业》"},"example":{"text":"他一回家就～。"},"usage":"作谓语、定语、宾语；指修理补全"},{"id":6479,"word":"修好结成","pinyin":"xiū hǎo jié chéng","abbr":"xhjc","explanation":"重归于好，缔结为盟。","source":{"text":"楚子使公子辰如晋，报钟仪之使，请修好结成。","book":"《左传·成公九年》"},"usage":"作谓语、定语；用于书面语"},{"id":6480,"word":"修学务早","pinyin":"xiū xué wù zǎo","abbr":"xxwz","explanation":"修学：研习学问；务：必须。学习知识必须趁年少进行","source":{"text":"盖少则志一而难忘，长则神放易失，故修学务早。","book":"晋·葛洪《抱朴子·勉学》"},"usage":"作宾语、定语；用于劝诫人"},{"id":6481,"word":"修己安人","pinyin":"xiū jǐ ān rén","abbr":"xjar","explanation":"修己：修身。提高自身修养，使人民安乐","source":{"text":"子曰：‘修己以敬。’曰：‘如斯而已乎？’曰：‘修己以安人。’","book":"春秋·鲁·孔丘《论语·宪问》"},"usage":"作宾语、定语；用于处事"},{"id":6482,"word":"修德慎罚","pinyin":"xiū dé shè fá","abbr":"xdsf","explanation":"修德：修养道德；慎罚：慎重使用刑罚。形容旧时行仁政、安定民心的政治措施。","source":{"text":"鉴之往古，事有可征。要之祈天永命，固有其道，修德慎罚，亦一端耳。","book":"《明太祖宝训》卷三"},"example":{"text":"且劝吴主～，以安内为念，不当以黩武为事。","book":"明·罗贯中《三国演义》第五十七回"},"usage":"作谓语、定语；用于治政等"},{"id":6483,"word":"修心养性","pinyin":"xiū xīn yǎng xìng","abbr":"xxyx","explanation":"修心：使心灵纯洁；养性：使本性不受损害。通过自我反省体察，使身心达到完美的境界。","source":{"text":"则被这东坡学士相调戏，可着我满寺里告他谁，我如今修心养性在庐山内，怎生瞒过了子瞻，赚上了牡丹，却教谁人来替？","book":"元·吴昌龄《东坡梦》第二折"},"example":{"text":"我纵欲～，那得此半年空闲，幕天席地的日子？","book":"冰心《寄小读者》"},"similar":["修身洁行"],"usage":"作谓语、宾语；指注重自己的德行"},{"id":6484,"word":"修文偃武","pinyin":"xiū wén yǎn wǔ","abbr":"xwyw","explanation":"修：昌明，修明；偃：停止。提倡文教，停息武事。","source":{"text":"正当海晏河清日，便是修文偃武时。","book":"唐·薛逢《九日曲池游眺》"},"example":{"text":"明·伏雌教主《醋葫芦》第20回：“那时宋朝自从南渡以来，家国偏安，仅云小康，正是～之际，重的极是文人。”"},"similar":["偃武修文"],"usage":"作谓语、定语、宾语；用于政策等"},{"id":6485,"word":"修文地下","pinyin":"xiū wén dì xià","abbr":"xwdx","explanation":"修文：修明文教。指文人死亡","source":{"text":"一代风流尽，修文地下深。","book":"唐·杜甫《哭李常侍郎》诗"},"usage":"作宾语、定语；用于书面语"},{"id":6486,"word":"修文演武","pinyin":"xiū wén yǎn wǔ","abbr":"xwyw","explanation":"指演练武艺，修习文章。同“修文偃武”。","source":{"text":"你今日修文治国平天下，你如今待演武安邦定杀伐。儿呵？你如今修文演武未通达。","book":"元·狄君厚《介子推》第三折"},"example":{"text":"自古～，取功名于乱世。终不然恋酒贪花，堕却壮志。","book":"明·李唐宾《梧桐叶》楔子"},"similar":["演武修文"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6487,"word":"修旧利废","pinyin":"xiū jiù lì fèi","abbr":"xjlf","explanation":"把破旧的修补好，把废物利用起来。指厉行节约。","source":{"text":"幽厉之后，王道缺，礼乐衰，孔子修旧起废，废《诗》、《书》，作《春秋》，则学者至今则之。","book":"东汉·班固《汉书·司马迁传》"},"example":{"text":"我们～，充分利用资源。"},"similar":["修旧起废"],"usage":"作谓语、宾语、定语；指厉行节约"},{"id":6488,"word":"修旧起废","pinyin":"xiū jiù qǐ fèi","abbr":"xjqf","explanation":"原指修诗书，兴礼乐。后引申为把旧有的修理好。把废置的利用起来。","source":{"text":"幽、厉之后，王道缺，礼乐衰，孔子修旧起废，论《诗》、《书》，作《春秋》，则学者至今则之，","book":"《汉书·司马迁传》"},"example":{"text":"此而不葺，殆非～，悦民便俗之理。","book":"宋·吕陶《净德集·重修成都西楼记》"},"similar":["修旧利废"],"usage":"作谓语、宾语、定语；指厉行节约"},{"id":6489,"word":"修桥补路","pinyin":"xiū qiáo bǔ lù","abbr":"xqbl","explanation":"修建桥梁，补好道路。旧喻热心公益，解囊行善。","source":{"text":"我贾仁也会斋僧布施，盖寺建塔，修桥补路，惜孤念寡，敬老怜贫。","book":"元·无名氏《看钱奴》第一折"},"example":{"text":"我丈夫是个善人，一生好的是～，敬老怜贫。","book":"明·吴承恩《西游记》第二十七回"},"usage":"作谓语、宾语；指热心公益事业"},{"id":6490,"word":"修真养性","pinyin":"xiū zhēn yǎng xìng","abbr":"xzyx","explanation":"学道修行，涵养性情。","source":{"text":"吾传太清之道，隐于昆仑山中，以东华至真之气，碧海之上，苍灵之墟，修真养性，累积善功，以成正道，掌管玉霄紫府、洞天福地、三岛十洲、蓬莱之境。","book":"元·无名氏《玩江亭》第一折"},"example":{"text":"那里会惜玉怜香，只晓得～。","book":"明·吴承恩《西游记》第五十五回"},"similar":["修真炼性"],"usage":"作宾语、定语；用于书面语"},{"id":6491,"word":"修真炼性","pinyin":"xiū zhēn liàn xìng","abbr":"xzlx","explanation":"修真：使心灵纯洁；炼性：磨炼本性。通过自我反省体察，使身心达到完美的境界。","source":{"text":"髻挽青丝杀气浮，修真炼性隐山邱；炉中玄妙趄叁界，掌上风雷震九州。","book":"明·许仲琳《封神演义》第四十七回"},"example":{"text":"其次者，～，吐故纳新，筑坎离以延年，煮铅汞以济物。","book":"明·凌濛初《初刻拍案惊奇》卷十七"},"similar":["修真养性"],"usage":"作宾语、定语；用于书面语"},{"id":6492,"word":"修短有命","pinyin":"xiū duǎn yǒu mìng","abbr":"xdym","explanation":"修：长；命：天命。人的寿命长短是由天注定的。","source":{"text":"命之修短有数；人之富贵在天。","book":"明·程登吉《幼学琼林》第三卷"},"example":{"text":"他始终相信～，因此也不参加锻炼。"},"similar":["命中注定"],"usage":"作宾语、定语；指宿命论"},{"id":6493,"word":"修短随化","pinyin":"xiū duǎn suí huà","abbr":"xdsh","explanation":"修：长；化：造化，旧指自然界的主宰者，迷信说法指运气、命运。人的寿命长短，随造化而定。","source":{"text":"况修短随化，终期于尽。","book":"晋·王羲之《兰亭集序》"},"usage":"作宾语、定语；用于书面语"},{"id":6494,"word":"修身养性","pinyin":"xiū shēn yǎng xìng","abbr":"xsyx","explanation":"修身：使心灵纯洁；养性：使本性不受损害。通过自我反省体察，使身心达到完美的境界。","source":{"text":"贫道本是南阳一耕夫，岂管尘世之事 只可修身养性，贫道去不的也。","book":"元·无名氏《博望烧屯》第一折"},"example":{"text":"王朔《玩儿的就是心跳》：“上了年纪就安安静静地～颐养天年了。”"},"usage":"作谓语、定语、状语；用于处世"},{"id":6495,"word":"修身慎行","pinyin":"xiū shēn shèn xíng","abbr":"xssx","explanation":"修：学问、品德方面的学习和锻炼。努力提高自身的修养，谨慎小心地处理问题。","source":{"text":"夫修身慎行，敦方正直，清廉洁白，恬淡无为。","book":"汉·王符《潜夫论·实贡》"},"example":{"text":"虽博识多闻，备明今古；而～，颇负祖先。","book":"《旧五代史·庄宗纪》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":6496,"word":"修身洁行","pinyin":"xiū shēn jié xíng","abbr":"xsjx","explanation":"修养品性，保持洁白的德行。","source":{"text":"臣修身洁行数十年，终不以监门困故而受公子财。","book":"《史记·魏公子列传》"},"similar":["修心养性"],"usage":"作谓语、宾语；指修心养性"},{"id":6497,"word":"修身立节","pinyin":"xiū shēn lì jié","abbr":"xslj","explanation":"修：修养；立：树立；节：气节。修养自身的言行，树立坚贞的节操。","source":{"text":"士之修身立节，竟不遇知己，前古以来，不可胜数。","book":"唐·韩愈《与汝州户郎中论荐侯喜状》"},"usage":"作宾语、定语；用于处事"},{"id":6498,"word":"修身齐家","pinyin":"xiū shēn qí jiā","abbr":"xsqj","explanation":"指修养自身，理好家政。","source":{"text":"身修而后家齐，家齐而后国治，国治而后天下平。","book":"《礼记·大学》"},"example":{"text":"父亲，有甚么～的事，训教你儿者。","book":"元·无名氏《九世同居》第一折"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":6499,"word":"修身齐家治国平天下","pinyin":"xiū shēn qí jiā zhì guó píng tiān xià","abbr":"xsqjzgptx","explanation":"提高自身修养，理好家政，治理好所在的地区，最后使全国安宁","source":{"text":"身修而后家齐，家齐而后国治，国治而后天下平。","book":"西汉·戴圣《礼记·大学》"},"similar":["治国齐家"],"usage":"作宾语、定语；用于书面语"},{"id":6500,"word":"修辞立其诚","pinyin":"xiū cí lì qí chéng","abbr":"xclqc","explanation":"原指君子要注重文化修养，做到立身诚实。后多指写文章应表现出作者的真实意图。","source":{"text":"修辞立其诚，所以居业也。","book":"《周易·乾》"},"example":{"text":"～，盖辞无所不修，而意则主于达。","book":"明·王世贞《艺苑卮言》卷一"},"similar":["修辞立诚"],"usage":"作宾语、定语；用于写作等"},{"id":6501,"word":"修辞立诚","pinyin":"xiū cí lì chéng","abbr":"xclc","explanation":"原指君子要注重文化修养，做到立身诚实。后多指写文章应表现出作者的真实意图。","source":{"text":"修辞立其诚，所以居业也。","book":"《周易· 乾》"},"example":{"text":"皋文、涤生，尚有谖言，虑非～之道。","book":"清·章炳麟《与邓实书》"},"similar":["修辞立其诚"],"usage":"作宾语、定语；用于写作"},{"id":6502,"word":"修饰边幅","pinyin":"xiū shì biān fú","abbr":"xsbf","explanation":"边幅：本指布帛的边缘，比喻人的仪表。修饰整个人的仪表。也比喻修饰表面，无关大局。","source":{"text":"天下雄雌未定，公孙不吐哺走迎国士，与图成败，反修饰边幅，如偶人形。此子何足久稽天下士乎？","book":"《后汉书·马援传》"},"example":{"text":"他日卷土重来，不过～，而与长江大局无与也。","book":"章炳麟《与熊克武书》"},"opposite":["不修边幅"],"usage":"作谓语、宾语、定语；指修饰整个人的仪表","story":["西汉末年，隗嚣派马援去联合公孙述对付刘秀。马援与公孙述是同乡要好，公孙述嫌马援不修边幅，派人送去官服修饰边幅，装出皇帝的架子，马援十分不悦就去投奔刘秀，见刘秀有雄才大略，就去洛阳投奔他，因他屡立战功，被封为伏波将军"]},{"id":6503,"word":"修鳞养爪","pinyin":"xiū lín yǎng zhǎo","abbr":"xlyz","explanation":"比喻保养、积蓄战斗力。","source":{"text":"处州党员极多，因该处崇山峻岭，可为修鳞养爪之用。","book":"邹鲁《浙江光复》"},"usage":"作宾语、定语；用于比喻句"},{"id":6504,"word":"修齐治平","pinyin":"xiū qí zhì píng","abbr":"xqzp","explanation":"泛指伦理哲学和政治理论。","source":{"text":"古之欲明明德于天下者，先治其国；欲治其国者，先齐其家，欲齐其家者，先修其身。","book":"西汉·戴圣《礼记·大学》"},"example":{"text":"先生倡行易知难之说及三民主义、五权宪法、建国大纲，于～之道。","book":"廖仲恺《孙文主义丛刊序》"},"similar":["治国齐家"],"usage":"作宾语、定语；泛指伦理哲学和政治理论"},{"id":6505,"word":"俯仰一世","pinyin":"fǔ yǎng yī shì","abbr":"fyys","explanation":"俯仰：低头，抬头，指周旋、应付。周旋、应付一辈子。","source":{"text":"夫人之相与，俯仰一世，或取诸怀抱，晤言一室之内。","book":"晋·王羲之《兰亭集序》"}},{"id":6506,"word":"俯仰之间","pinyin":"fǔ yǎng zhī jiān","abbr":"fyzj","explanation":"一低头，一抬头的工夫。形容时间极短。","source":{"text":"以大为小，以强为弱，在俯仰之间耳。","book":"《汉书·晁错传》"},"example":{"text":"～，已为陈迹。","book":"晋·王羲之《兰亭集序》"},"similar":["转瞬之间"],"usage":"作宾语；形容时间极短"},{"id":6507,"word":"俯仰于人","pinyin":"fǔ yǎng yú rén","abbr":"fyyr","explanation":"俯仰：低头和抬头，泛指一举一动。形容一举一动都随人摆布。","source":{"text":"平生诗文甚多，不能俯仰于人，故能不显云。","book":"明·焦竑《玉堂丛语·宠遇》"},"similar":["俯仰由人","俯仰随人"],"usage":"作谓语、定语；比喻一切受人支配"},{"id":6508,"word":"俯仰唯唯","pinyin":"fǔ yǎng wéi wéi","abbr":"fyww","explanation":"唯唯：答应的声音。点头答应。比喻谦卑地应付。","source":{"text":"毅撝退辞谢，俯仰唯唯。","book":"唐·李朝威《柳毅传》"},"usage":"作谓语、状语；用于处事"},{"id":6509,"word":"俯仰异观","pinyin":"fǔ yǎng yì guān","abbr":"fyyg","explanation":"俯仰：低头，抬头；异观：不同的表现。一低头，一抬头，都有不同的表现。指霎时间出现的多种多样的姿态。","source":{"text":"意密体疏，俯仰异观，含喜微笑，窃视流眄。","book":"战国·楚·宋玉《登徒子好色赋》"}},{"id":6510,"word":"俯仰无愧","pinyin":"fǔ yǎng wú kuì","abbr":"fywk","explanation":"府仰：低头与抬头。比喻没有做亏心事，并不感到惭愧。","source":{"text":"洗鄙夫患失之风，增善类敢言之气，俯仰无愧，进退两高。","book":"《孟子·尽心上》：“仰不愧于天，俯不愧于人。”宋·陆游《贺辛给事启》"},"example":{"text":"如果不是品行学识都～的智者，便是或多或少不知道惭愧的骗子。","book":"郭沫若《创造十年续篇》一"},"similar":["问心无愧"],"opposite":["问心有愧"],"usage":"作谓语、定语；指问心无愧"},{"id":6511,"word":"俯仰由人","pinyin":"fǔ yǎng yóu rén","abbr":"fyyr","explanation":"俯仰：低头和抬头，泛指一举一动。比喻一切受人支配。","source":{"text":"且子独不见夫桔槔者乎？引之则俯，舍之则仰，彼人之所引，非引人也。故俯仰而不得罪于人。","book":"《庄子·天运》"},"example":{"text":"不甘心做～的傀儡。","book":"陶菊隐《北洋军阀统治时期史话》第六十五章"},"similar":["俯仰随人"],"usage":"作谓语、定语；比喻一切受人支配"},{"id":6512,"word":"俯仰随人","pinyin":"fǔ yǎng suí rén","abbr":"fysr","explanation":"一举一动都随人摆布。","source":{"text":"安能终老尘土下，俯仰随人如桔槔。","book":"宋·苏轼《送李公恕赴阙》诗"},"example":{"text":"纵横自有凌云笔，～亦可怜。","book":"金·元好问《论诗》诗之二一"},"similar":["俯仰由人","俯仰于人"],"usage":"作谓语、定语；比喻一切受人支配"},{"id":6513,"word":"俯仰随俗","pinyin":"fǔ yǎng suí sú","abbr":"fyss","explanation":"俯仰：低头，抬头，指一举一动。举止言谈随和着社会的风俗习惯。","source":{"text":"从俗浮沉，与时俯仰。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"大可～，不事纷更。","book":"茅盾《追求》二"}},{"id":6514,"word":"俯拾仰取","pinyin":"fǔ shí yǎng qǔ","abbr":"fsyq","explanation":"低头拾地上的东西，抬头拿上面的东西。形容一举一动都有收获。","source":{"text":"然家自父兄子孙约，俯有拾，仰有取。","book":"西汉·司马迁《史记·货殖列传》"},"example":{"text":"土无寸旷，人无晷暇，～，宾祭有经。","book":"清·曾国藩《欧阳氏姑妇节孝家传》"},"usage":"作谓语；形容极其勤劳节俭"},{"id":6515,"word":"俯拾即是","pinyin":"fǔ shí jí shì","abbr":"fsjs","explanation":"俯：低头，弯腰；即：就。只要低下头来捡取，到处都是。形容多而易得。","source":{"text":"俯拾即是，不取诸邻。","book":"唐·司空图《诗品·自然》"},"example":{"text":"松树林里，松果密密麻麻落在地上，～。"},"similar":["比比皆是","触目皆是","不胜枚举"],"opposite":["凤毛麟角","寥寥无几","屈指可数"],"usage":"作谓语、宾语、补语；用于书面语"},{"id":6516,"word":"俯拾地芥","pinyin":"fǔ shí dì jiè","abbr":"fsdj","explanation":"象低头拾一根小草那样。比喻容易得到或容易成功。","source":{"text":"士病不明经术，经术苟明，其取青紫，犹俯拾地芥耳。","book":"《汉书·夏侯胜传》"},"usage":"作宾语；比喻容易得到"},{"id":6517,"word":"俯拾皆是","pinyin":"fǔ shí jiē shì","abbr":"fsjs","explanation":"只要低下头来捡取，到处都是。形容多而易得。","source":{"text":"俯拾即是，不取诸邻。","book":"唐·司空图《诗品·自然》"},"example":{"text":"松树林里，松果密密麻麻落在地上，～。"},"similar":["比比皆是","触目皆是","不胜枚举"],"opposite":["凤毛麟角","寥寥无几","屈指可数"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6518,"word":"俯拾青紫","pinyin":"fǔ shí qīng zǐ","abbr":"fsqz","explanation":"青紫：卿大夫的服饰。形容轻易地得到官职。","source":{"text":"青紫：卿大夫的服饰。形容轻易地得到官职。"},"example":{"text":"自谓～，乃诣金陵求举，屡黜于有司。","book":"宋·胡仔《苕溪渔隐丛话后集·五季杂记》"},"usage":"作谓语、宾语；用于官场等"},{"id":6519,"word":"俯顺舆情","pinyin":"fǔ shùn yú qíng","abbr":"fsyq","explanation":"顺从民意，照舆论来行事。"},{"id":6520,"word":"俯首下心","pinyin":"fǔ shǒu xià xīn","abbr":"fsxx","explanation":"俯首：低着头；下心：把心气低下来。低着头，把心气低下来。指服气认输。"},{"id":6521,"word":"俯首受命","pinyin":"fǔ shǒu shòu mìng","abbr":"fssm","explanation":"俯：低下；首：头。形容人驯服顺从的样子。","source":{"text":"欲使悍将骄兵，俯首受命，宁非痴人说梦乎？","book":"蔡东藩《民国通俗演义》第132回"},"example":{"text":"我不想～。"},"similar":["俯首听命"],"usage":"作谓语、宾语、定语；指非常驯服的样子"},{"id":6522,"word":"俯首听命","pinyin":"fǔ shǒu tīng mìng","abbr":"fstm","explanation":"听：服从，顺从；命：命令。形容人驯顺的样子。","source":{"text":"召诸将会，告以降敌之间。诸将愕然，以上将既复，乃俯首听命，遂连署降表。","book":"《旧五代史·杜重威传》第一百零九回"},"example":{"text":"惟教育总长，改任了汤化龙，交通总长，改任了梁敦彦。大家～，毫无异言。","book":"蔡东藩、许廑父《民国通俗演义》第四十回"},"similar":["俯首帖耳","低眉折腰","唯唯连声"],"opposite":["桀骜不驯"],"usage":"作谓语、宾语、定语；指非常驯服的样子"},{"id":6523,"word":"俯首就擒","pinyin":"fǔ shǒu jiù qín","abbr":"fsjq","explanation":"低头受擒拿。","example":{"text":"他打了败仗，只好～。"},"similar":["束手就擒"],"usage":"作谓语、定语；指不反抗"},{"id":6524,"word":"俯首就缚","pinyin":"fǔ shǒu jiù fù","abbr":"fsjf","explanation":"低下头让人捆绑。形容无法反抗或自愿认罪。","example":{"text":"我军节节胜利，敌人只好～。"},"similar":["低头认罪"],"usage":"作谓语、宾语、定语；用于战败等"},{"id":6525,"word":"俯首帖耳","pinyin":"fǔ shǒu tiē ěr","abbr":"fste","explanation":"象狗见了主人那样低着头，耷拉着耳朵。形容卑屈驯服的样子。","source":{"text":"若俯首帖耳，摇尾而乞怜者，非我之志也。","book":"唐·韩愈《应科目时与人书》"},"example":{"text":"他们习惯于猛于虎的官威，以为老百姓只要一加威吓，便自会～。","book":"郭沫若《少年时代·反正前后》"},"similar":["俯首贴耳"],"opposite":["放荡不羁"],"usage":"作谓语、定语、状语；指非常驯服的样子"},{"id":6526,"word":"俯首弭耳","pinyin":"fǔ shǒu mǐ ěr","abbr":"fsme","explanation":"形容卑屈驯服的样子。同“俯首帖耳”。","source":{"text":"其虎见勤自励到来，把前足跪地，俯首弭耳，口中有声，似有乞怜之意。","book":"《醒世恒言·大树坡义虎送亲》"},"similar":["俯首帖耳","俯首戢耳","俯首贴耳"],"usage":"作谓语、定语、状语；指非常驯服的样子"},{"id":6527,"word":"俯首戢耳","pinyin":"fǔ shǒu jí ěr","abbr":"fsje","explanation":"形容卑屈驯服的样子。同“俯首帖耳”。","source":{"text":"我军人俯首戢耳以听其鞭策者，亦既二百六十有馀年。","book":"孙中山《大总统告陆海军士文》"},"similar":["俯首帖耳","俯首弭耳"],"opposite":["桀骜不逊"],"usage":"作谓语、定语、状语；指非常驯服的样子"},{"id":6528,"word":"俯首贴耳","pinyin":"fǔ shǒu tiē ěr","abbr":"fste","explanation":"俯首：低头。低着头，耷拉着耳朵。形容恭顺服从，屈卑驯服的样子。","source":{"text":"若俯首帖耳，摇尾而乞怜者，非我之志也。","book":"唐·韩愈《应科目时与人书》"},"example":{"text":"他只好～，唯命是从了。"},"similar":["俯首听命","胁肩低眉","奴颜婢膝"],"opposite":["桀骜不驯","放荡不羁"],"usage":"作谓语、定语、状语；指屈卑驯服的样子"},{"id":6529,"word":"俱收并蓄","pinyin":"jù shōu bìng xù","abbr":"jsbx","explanation":"把各种不同的东西一同吸收进来，保存起来。","source":{"text":"玉札丹砂，赤箭青芝，牛溲马勃，败鼓之皮，俱收并蓄，待用无遗者，医师之良也。","book":"唐·韩愈《进学解》"},"example":{"text":"要把那些蝇营狗苟，奴颜婢膝，昏夜乞怜，白昼骄人的各色人等，～，无不宽容下去。","book":"聂绀弩《鲁迅的褊狭与向培良的大度》"},"similar":["兼收并蓄"],"opposite":["不可兼得"],"usage":"作谓语、定语、宾语；指容量大"},{"id":6530,"word":"俳优畜之","pinyin":"pái yōu xù zhī","abbr":"pycz","explanation":"俳优：旧指演戏的人；畜：畜养。当作演戏逗乐来畜养他。指古时皇帝对文人的态度。","source":{"text":"近乎卜祝之间，固主上所戏弄，俳优畜之，流俗之所轻也。","book":"西汉·司马迁《报任少卿书》"},"example":{"text":"后来却不过叫他献诗作赋，‘～’，只在弄臣之列。","book":"鲁迅《从帮忙到扯淡》"},"usage":"作宾语、定语；用于对人的态度"},{"id":6531,"word":"俾夜作昼","pinyin":"bǐ yè zuò zhòu","abbr":"byzz","explanation":"把夜晚当作白昼一般利用，夜以继日。","source":{"text":"四令生斥弃百虑以志学，俾夜作昼，孜孜矻矻。","book":"唐·白行简《李娃传》"},"example":{"text":"奴家劝他斥去百虑，以志于学，～。","book":"明·徐霖《乡襦记·剔目劝学》"},"similar":["夜以继日"],"opposite":["俾昼作夜"],"usage":"作谓语、定语；形容不分昼夜干某事"},{"id":6532,"word":"俾昼作夜","pinyin":"bǐ zhòu zuò yè","abbr":"bzzy","explanation":"指晨昏颠倒。常用在无限制地享乐。","source":{"text":"或号式呼，俾昼作夜。","book":"《诗经·大雅·荡》"},"example":{"text":"乡下人家不比上海，是通宵达旦，～的。","book":"《晚清文学丛钞·情变》第四回"},"similar":["夜以继日"],"opposite":["俾夜作昼"],"usage":"作谓语、定语；形容不分昼夜干某事"},{"id":6533,"word":"倍日并行","pinyin":"bèi rì bìng xíng","abbr":"brbx","explanation":"日夜赶路。","source":{"text":"乃弃其步军，与其轻锐倍日并行逐之。","book":"《史记·孙子吴起列传》"},"example":{"text":"唐·赵蕤《反经·变通》：“乃弃其步兵，与轻锐～逐之。”"},"similar":["倍道兼行"],"usage":"作谓语；指日夜赶路"},{"id":6534,"word":"倍称之息","pinyin":"bèi chèn zhī xī","abbr":"bczx","explanation":"倍称：借一还二；息：利息。取一还二的债款利息。指百分之百的高利贷。","source":{"text":"当具有者半贾而卖，亡者，取倍称之息。","book":"《汉书·食货志》"},"example":{"text":"昔日富豪以～，折夺良家子女，人无敢言者。","book":"清·蒲松龄《聊斋志异·王大》"}},{"id":6535,"word":"倍道兼行","pinyin":"bèi dào jiān xíng","abbr":"bdjx","explanation":"倍、兼：加倍；道：指行程。每天加倍行进，一天走两天的路程。形容加速急行。","source":{"text":"日夜不处，倍道兼行，百里而争利，则擒三将军。","book":"《孙子·军争》"},"example":{"text":"～，召三方兵，大会于陈许之郊。","book":"《晋书·景帝纪》"},"similar":["倍道兼进"],"usage":"作谓语；指加速行进"},{"id":6536,"word":"倍道兼进","pinyin":"bèi dào jiān jìn","abbr":"bdjj","explanation":"倍：加倍；道：行程。形容加快速度行进。","source":{"text":"迎二帝于沙漠，救生民于涂炭，尔其倍道兼进，以慰朕怀。","book":"清·钱采《说岳全传》第22回"},"similar":["倍道兼行"],"usage":"作谓语、宾语；指加快速度行进"},{"id":6537,"word":"倍道而行","pinyin":"bèi dào ér xíng","abbr":"bdex","explanation":"加快速度，一天走两天的行程。","source":{"text":"司马懿背道而行，八日已到新城，孟达措手不及。","book":"《失街亭》"},"example":{"text":"我们～，估计天亮前可到达目的地。"},"similar":["倍道而进","倍道兼行"],"usage":"作谓语；形容加快速度前进"},{"id":6538,"word":"倍道而进","pinyin":"bèi dào ér jìn","abbr":"bdej","explanation":"倍：加倍；道：行程。形容加快速度前进。","source":{"text":"倍：加倍；道：行程。形容加快速度前进。"},"example":{"text":"明·罗贯中《三国演义》第十一回：“曹兵闻失兖州，必然倍道而进，待其过半，一击可擒也。”"},"similar":["倍道兼进"],"usage":"作谓语；形容加快速度前进"},{"id":6539,"word":"倏忽之间","pinyin":"shū hū zhī jiān","abbr":"shzj","explanation":"倏：忽然，极快地。指极短的时间。","source":{"text":"昼游乎茂树，夕调乎酸咸，倏忽之间，坠于公子之乎。","book":"西汉·刘向《战国策·楚策四》"},"similar":["转瞬之间"],"usage":"作宾语；形容极短的时间"},{"id":6540,"word":"倏来忽往","pinyin":"shū lái hū wǎng","abbr":"slhw","explanation":"倏：极快地。指来去迅速。","source":{"text":"栎雌妒异，倏来忽往。","book":"晋·潘岳《射雉赋》"},"example":{"text":"～，不可为象。","book":"唐·杨炯《浮讴赋》"},"usage":"作谓语、状语；指来去迅速"},{"id":6541,"word":"倒三颠四","pinyin":"dǎo sān diān sì","abbr":"dsds","explanation":"形容言行无条理或神智不清，精神恍惚。","source":{"text":"五娘，你信我奶奶倒三颠四的！","book":"明·兰陵笑笑生《金瓶梅词话》第58回"},"example":{"text":"他是一个～的人。"},"similar":["颠三倒四"],"usage":"作谓语、定语、状语；指人说话或做事"},{"id":6542,"word":"倒冠落佩","pinyin":"dǎo guān luò pèi","abbr":"dglp","explanation":"冠：帽子；佩：佩玉。这里指官服。脱下帽子，摘去佩玉。形容辞官还乡。","source":{"text":"倒冠落佩兮与世阔疏，敖敖兮真徇其愚而隐居者乎。","book":"唐·杜牧《晚晴赋》"},"example":{"text":"但当谢冠对妻子，～从嘲骂。","book":"宋·苏轼《定惠院寓居月夜偶出》"},"usage":"作谓语；指隐居"},{"id":6543,"word":"倒冠落珮","pinyin":"dǎo guàn luò pèi","abbr":"dglp","explanation":"①指弃官归隐。冠、珮是官员正服的打扮。②指隐者装束。亦作“倒冠落佩”。"},{"id":6544,"word":"倒凤颠鸾","pinyin":"dǎo fèng diān luán","abbr":"dfdl","explanation":"比喻顺序失常。旧小说用来形容男女交欢。","source":{"text":"天孙缲丝天女织，倒凤颠鸾金粟尺。","book":"金·元好问《赠答张教授仲文》诗"},"example":{"text":"二人～，顷刻云收雨散。","book":"明·洪楩《清平山堂话本·风月瑞仙亭》"},"similar":["颠鸾倒凤"],"usage":"作谓语、定语；形容男女交欢"},{"id":6545,"word":"倒四颠三","pinyin":"dǎo sì diān sān","abbr":"dsds","explanation":"颠：颠倒。形容言行无条理或神智不清。","source":{"text":"来呵！到明日，只弄得倒四颠三，一个黑沙，也是不值。","book":"明·兰陵笑笑生《金瓶梅词话》第33回"},"similar":["倒三颠四"],"usage":"作谓语、定语、状语；指人说话或做事"},{"id":6546,"word":"倒因为果","pinyin":"dǎo yīn wéi guǒ","abbr":"dywg","explanation":"颠倒因果关系，把原因说成结果。","example":{"text":"论何推论应合乎情理，决不能倒因为果。"},"similar":["倒果为因"],"usage":"作谓语、宾语；指颠倒了因果关系"},{"id":6547,"word":"倒屣相迎","pinyin":"dào xǐ xiāng yíng","abbr":"dxxy","explanation":"屣：鞋。古人家居脱鞋席地而坐，争于迎客，将鞋穿倒。形容热情欢迎宾客。","source":{"text":"闻粲在门，倒屣迎之，","book":"《三国志·魏书·王粲传》"},"similar":["倒屣迎宾","倒屣而迎"],"usage":"作谓语、定语；形容热情欢迎宾客","story":["东汉时期，著名学者蔡邕特别好结交文学人士，一次门人报告王粲来访，他匆匆忙忙把鞋都穿倒了就去迎接，众人一见来者是一个乳臭未干的少年，感到十分奇怪，蔡邕说王粲的智力超群，文采很好，让人钦佩"]},{"id":6548,"word":"倒屣而迎","pinyin":"dào xǐ ér yíng","abbr":"dxey","explanation":"屣：鞋。古人家居脱鞋席地而坐，争于迎客，将鞋穿倒。形容热情欢迎宾客。","source":{"text":"闻粲在门，倒屣迎之，","book":"《三国志·魏书·王粲传》"},"example":{"text":"我倒为他起了个早，～，真不上算。","book":"清·姬文《市声》第三十三回"},"similar":["倒屣相迎","倒屣迎宾"],"usage":"作谓语、定语；形容热情欢迎宾客","story":["唐朝时期，进士曹唐十分有才学，诗做得很好，他的《游仙诗》才情缥缈，被人们广为传诵。好友岳阳的李远员外特别喜欢他，每次吟其诗而思其人。有一天，曹唐到李远家去拜访，李远激动得倒屣而迎"]},{"id":6549,"word":"倒屣迎宾","pinyin":"dào xǐ yíng bīn","abbr":"dxyb","explanation":"倒：逆；屣：鞋。倒穿着鞋急忙迎客。形容热情待客。","source":{"text":"金友玉昆，良田广宅，而能吐食下士，倒屣迎宾。","book":"唐·杨炯《唐恒州刺史建昌公王公神道碑》"},"similar":["倒屣相迎","倒屣而迎"],"usage":"作谓语、定语；形容热情欢迎宾客"},{"id":6550,"word":"倒山倾海","pinyin":"dǎo shān qīng hǎi","abbr":"dsqh","explanation":"把山推倒，把海倾翻。形容声势很大，力量无比。","source":{"text":"及残寇乘之，倒山倾海，昆冈之火，自兹而焚，《版荡》之篇，于焉而极。","book":"《后汉书·董卓传》"},"example":{"text":"东坡词气，～，然亦未知琴。","book":"宋·胡仔《苕溪隐渔丛话前集·韩吏部上》"},"similar":["排山倒海"],"usage":"作谓语、定语；形容声势浩大"},{"id":6551,"word":"倒峡泻河","pinyin":"dǎo xiá xiè hé","abbr":"dxxh","explanation":"比喻文笔酣暢，气势磅礴。","source":{"text":"只那一枝笔，拈在手中，便如龙飞凤舞，落在纸上，便如倒峡泻河，真有扫千军万马之势。","book":"《平山冷燕》第九回"},"similar":["悬河泻水"],"usage":"作宾语、定语；用于写作等"},{"id":6552,"word":"倒廪倾囷","pinyin":"dǎo lǐn qīng qūn","abbr":"dlqq","explanation":"倾倒出粮仓中全部储藏。比喻罄其所有、尽其所知。","source":{"text":"虽使古之君子，积道藏德，遁其光而不曜，胶其口而不传者，遇足下之请恳恳，犹将倒廪倾囷，罗列而进也。","book":"唐·韩愈《答窦秀才书》"},"similar":["倒箧倾筐"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":6553,"word":"倒悬之危","pinyin":"dào xuán zhī wēi","abbr":"dxzw","explanation":"倒悬：象人被倒挂着一样。比喻处境极端困难。","source":{"text":"当今之时，万乘之国，行仁政，民之悦之，如解倒悬也。","book":"《孟子·公孙丑上》"},"example":{"text":"有游客张君瑞，奉书令小僧拜投于麾下，欲求将军以解～。","book":"元·王实甫《西厢记》第二本第一折"},"similar":["倒悬之急","倒悬之患"],"usage":"作宾语；比喻处境极端艰难"},{"id":6554,"word":"倒悬之急","pinyin":"dào xuán zhī jí","abbr":"dxzj","explanation":"倒悬：象人被倒挂着一样。比喻处境极端困难。","source":{"text":"北鄙将若倒悬之急。","book":"《孟子·公孙丑上》：“当今之时，万乘之国，行仁政，民之悦之，如解倒悬也。”《后汉书·臧洪传》"},"example":{"text":"盗贼蜂起，奸雄鹰扬，社稷有累卵之危，生灵有～。","book":"明·罗贯中《三国演义》第九十三回"},"similar":["倒悬之危","倒悬之苦"],"usage":"作宾语；比喻处境极端艰难"},{"id":6555,"word":"倒悬之患","pinyin":"dào xuán zhī huàn","abbr":"dxzh","explanation":"倒悬：头向下、脚向上悬挂着。比喻极其艰难、危险的困境。","source":{"text":"而士大夫方有倒悬之患。","book":"晋·陈寿《三国志·吴志·全琮传》"},"example":{"text":"齐、楚不和，交兵岁久，民有～。","book":"明·冯梦龙《喻世明言》第25卷"},"similar":["倒悬之急","倒悬之危","倒悬之苦"],"usage":"作宾语；比喻处境极端艰难"},{"id":6556,"word":"倒悬之苦","pinyin":"dào xuán zhī kǔ","abbr":"dxzk","explanation":"倒悬：象人被倒挂着一样。比喻处境极端困难。同“倒悬之急”。","source":{"text":"群生愁叹，四民废业，贫者弃子以偷生，富者鬻产而应役，倒悬之苦，日甚一日。","book":"《元史·外夷传》"},"example":{"text":"清·吴璿《飞龙全传》第一回：“战争不息，人民有～，将士多汗马之劳。”"},"similar":["倒悬之急","倒悬之患"],"usage":"作宾语；比喻处境极端艰难"},{"id":6557,"word":"倒戈卸甲","pinyin":"dǎo gē xiè jiǎ","abbr":"dgxj","explanation":"倒：倒转，翻转；卸：解除。比喻放下武器认输。","source":{"text":"问：‘人皆畏炎热，我爱夏日长。薰风自南来，殿阁生微凉时如何？’师曰：‘倒戈卸甲，虎丘忌日拈香。’","book":"宋·释普济《五灯会元·虎丘隆禅师法嗣》"},"example":{"text":"雪峰三上投子，九到洞山，为什么～？（宋·惟白《续传灯录》）"},"similar":["倒戈弃甲"],"usage":"作谓语、宾语；指认输投降"},{"id":6558,"word":"倒戈弃甲","pinyin":"dǎo gē qì jiǎ","abbr":"dgqj","explanation":"倒：颠倒，翻转；弃：抛弃。比喻放下武器认输。","source":{"text":"汝若上识天时，下穷人事，倒戈弃甲，束手归命，犹不庙绝血食。","book":"《杨家将演义·汉继业调兵拒宋》"},"example":{"text":"清·褚人获《隋唐演义》第50回：“智及见兄囚在陷车，心胆已碎，又见众军～而去，忙欲……”"},"similar":["倒戈卸甲"],"usage":"作谓语、宾语；指认输投降"},{"id":6559,"word":"倒戢干戈","pinyin":"dǎo jí gān gē","abbr":"djgg","explanation":"把武器倒着放起来，比喻没有战争，天下太平。同“倒载干戈”。","source":{"text":"偃革为轩，倒戢干戈，示不复用兵。","book":"汉·荀悦《汉纪·高祖纪二》"},"example":{"text":"～，苞以兽皮。","book":"《晋书·华谭传》"},"similar":["倒载干戈"],"usage":"作谓语；指停止作战"},{"id":6560,"word":"倒打一瓦","pinyin":"dào dǎ yī wǎ","abbr":"ddyw","explanation":"犹言倒打一耙。","source":{"text":"先生并没说什么呀，你别先倒打一瓦！","book":"老舍《骆驼祥子》七"},"similar":["倒打一耙"],"usage":"作谓语、定语、宾语；指反咬一口"},{"id":6561,"word":"倒打一耙","pinyin":"dào dǎ yī pá","abbr":"ddyp","explanation":"《西游记》故事：猪八戒以钉耙为武器，常用回身倒打一耙的绝技战胜对手。自己做错了，不仅拒绝别人的指摘，反而指摘对方。","source":{"text":"我输了理可不输气，输了气也不输嘴。且翻打他一耙，倒问他！","book":"清·文康《儿女英雄传》"},"example":{"text":"得啦，你不要～！我真是为你好。","book":"杨沫《青春之歌》第一部第18章"},"similar":["反咬一口","恩将仇报","混淆是非"],"opposite":["以德报怨","是非分明"],"usage":"作谓语、定语、宾语；指反咬一口"},{"id":6562,"word":"倒执手版","pinyin":"dǎo zhí shǒu bǎn","abbr":"dzsb","explanation":"古代官员持手版以朝。倒执手版，指惊惶失态。","source":{"text":"[桓温]入赴山陵，止新亭，大陈兵卫，将移晋室，呼安及王坦之，欲于座害之。坦之甚惧……既见温，坦之汗流沾衣，倒执手版。安从容就席。","book":"《晋书·谢安传》"},"similar":["倒持手板"],"usage":"作谓语、定语；用于处事","story":["东晋时期，大将军桓温把持朝政，他去山陵的途中，在新亭休息，调集大兵护卫，准备迁移晋室以自代，派人去请谢安和王坦之赴约，准备在席间杀了他们。王坦之十分害怕，但又不得不去见，吓得汗流浃背，倒执手版。而谢安则从容就席"]},{"id":6563,"word":"倒持太阿","pinyin":"dǎo chí tài ē","abbr":"dcta","explanation":"太阿：宝剑名。倒拿着剑，把剑柄给别人。比喻把大权交给别人，自己反受其害。","source":{"text":"自三数年来，奸臣窃权，陛下不可倒持太阿，授人鳟柄。","book":"《旧唐书·陈夷行传》"},"example":{"text":"况今驻华各使，惟利是视，以值修约之际，蹈瑕伺间，诡谋百出，不豫为之防，是～以授之也。","book":"清·薛福成《筹洋刍议》"},"similar":["倒持泰阿","太阿倒持"],"usage":"作谓语、定语；用于处事"},{"id":6564,"word":"倒持太阿，授人以柄","pinyin":"dào chí tài ē，shòu rén yǐ bǐng","abbr":"dctasryb","explanation":"泰阿：宝剑名。倒拿着剑，把剑柄给别人。比喻把大权交给别人，自己反受其害。","source":{"text":"大兵合聚，强者为雄，所为倒持干戈，授人以柄，功必不成，祗为乱阶。","book":"《汉书·梅福传》：“倒持泰阿，授楚其柄。”汉·陈琳《谏何进召外兵》"},"example":{"text":"今执事者先拔其本，弃重取轻，所谓～。","book":"覣·陆贽《论关中事宜状》"}},{"id":6565,"word":"倒持干戈","pinyin":"dǎo chí gān gē","abbr":"dcgg","explanation":"犹言倒持泰阿。干、戈，皆兵器。","source":{"text":"大兵聚会，强者为雄，所谓倒持干戈，授人以柄，功必不成，只为乱阶。","book":"《后汉书·何进传》"},"similar":["倒持戈矛","倒持泰阿","授人以柄"],"usage":"作谓语、定语；用于处事"},{"id":6566,"word":"倒持戈矛","pinyin":"dǎo chí gē máo","abbr":"dcgm","explanation":"犹言倒持泰阿。戈、矛，皆兵器。","source":{"text":"舍此不务而反为所乘，斯谓倒持戈矛，以鳟授寇者也。","book":"《新唐书·陆贽传》"},"similar":["倒持干戈"],"usage":"作谓语、定语；用于处事"},{"id":6567,"word":"倒持手板","pinyin":"dǎo chí shǒu bǎn","abbr":"dcsb","explanation":"古代官员持手板以朝。倒持手板，指惊惶失态。同“倒执手版”。","source":{"text":"待得新亭，倒持手板，何似抽还政事堂。","book":"宋·刘克庄《沁园春·再和林卿韵》词"},"similar":["倒执手版"],"usage":"作谓语、定语；用于处事"},{"id":6568,"word":"倒持泰阿","pinyin":"dào chí tài ē","abbr":"dcte","explanation":"泰阿：宝剑名。倒拿着剑，把剑柄给别人。比喻把大权交给别人，自己反受其害。","source":{"text":"倒持泰阿，授楚其柄。","book":"《汉书·梅福传》"},"example":{"text":"二子以爱姬示人，掇丧身之祸。所谓～，授人以柄。","book":"宋·乐史《绿珠传》"},"similar":["倒持太阿"],"usage":"作谓语、定语；比喻轻率相信别人"},{"id":6569,"word":"倒枕捶床","pinyin":"dǎo zhěn chuí chuáng","abbr":"dzcc","explanation":"倒：翻转；捶：用拳头敲打。形容悲痛欲绝的样子。","source":{"text":"短叹常吁，千声万声，倒枕捶床，到三更四更。","book":"元·关汉卿《调风月》第三折"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第26卷：“又且想着他两个此时快乐，一发睡不去了，～了一夜。”"},"similar":["捶床捣枕"],"usage":"作谓语、宾语；用于悲痛时"},{"id":6570,"word":"倒枕搥床","pinyin":"dǎo zhěn chuí chuáng","abbr":"dzcc","explanation":"烦躁，无奈，气愤或悲痛的样子。形容辗转难以入睡。同“捣枕槌床”。","source":{"text":"着我倒枕搥床怎生卧，到二三更暖不温和，连这没人情的被窝儿也奚落我！","book":"元·陈子厚《醉花阴·宝钏松金髻云亸套》曲"},"example":{"text":"左思右想，真个亿万声长吁短叹，几千遍～，直捱到数更才朦胧睡去。","book":"《飞花艳想》第五回"}},{"id":6571,"word":"倒枕槌床","pinyin":"dǎo zhěn chuí chuáng","abbr":"dzcc","explanation":"倒：推倒；槌：敲打用的棒，借指敲打。翻枕头敲床。形容非常悲痛。","source":{"text":"短叹长吁，千声万声，倒枕槌床，到三更四更。","book":"元·关汉卿《调风月》第三折"},"example":{"text":"小可有一万声长吁短叹，五千遍～。","book":"元·王实甫《西厢记》第一本第二折"}},{"id":6572,"word":"倒果为因","pinyin":"dào guǒ wéi yīn","abbr":"dgwy","explanation":"果：结果；因：原因。把结果当成原因，颠倒了因果关系。","source":{"text":"曾不问资本所以群趋于都会之故，是所谓倒果为因者耳。","book":"民意《告非难民生主义者》"},"example":{"text":"如果以美国联邦制度就是富强的原因，那便是～。","book":"孙中山《民权主义》第四讲"},"similar":["本末倒置","颠倒是非"],"usage":"作谓语、宾语；指颠倒了因果关系"},{"id":6573,"word":"倒栽葱","pinyin":"dào zāi cōng","abbr":"dzc","explanation":"指栽跟斗时头先着地，即栽得很重。比喻一次惨重的失败。","source":{"text":"照脊梁一拳，打个不提备，跌了一个倒栽葱，把一个小孩子也丢在路边啼哭。","book":"清·褚人获《隋唐演义》第33回"},"example":{"text":"这样不顾大局，不识大体的人，早晚会～的。","book":"顾工《翻案》"},"usage":"作宾语、定语；用于比喻句"},{"id":6574,"word":"倒海移山","pinyin":"dǎo hǎi yí shān","abbr":"dhys","explanation":"倒：颠倒，翻转。翻转大海，移动山岳。指气势或力量洪大。","source":{"text":"飞北上……都是倒海移山雄猛客。","book":"明·许仲琳《封神演义》第82回"},"example":{"text":"清·无垢道人《八仙全传》第八回：“只消把法身一动便能～，连阴阳两界不得安全。”"},"similar":["排山倒海"],"usage":"作谓语、定语；用于气势"},{"id":6575,"word":"倒海翻江","pinyin":"dǎo hǎi fān jiāng","abbr":"dhfj","explanation":"形容力量或声势非常浩大。","source":{"text":"五更颠风吹急雨，倒海翻江洗残暑。","book":"宋·陆游《夜宿阳山矶》诗"},"example":{"text":"风仗雨势，雨借风威，那雨像～似地下了起来。"},"similar":["排山倒海","翻江倒海"],"opposite":["风平浪静"],"usage":"作谓语、定语；形容心情无比激动"},{"id":6576,"word":"倒箧倾囊","pinyin":"dǎo qiè qīng náng","abbr":"dqqn","explanation":"倾囊倒箧。形容倾尽其所有。","source":{"text":"索将他倒箧倾囊，付质求沽尽易钱。","book":"清·嬴宗季女《六月霜·典钗》"},"similar":["倒箧倾筐"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":6577,"word":"倒箧倾筐","pinyin":"dǎo qiè qīng kuāng","abbr":"dqqk","explanation":"形容倾其所有。","source":{"text":"其他修祠宇、平道路、焚责券，苟有利于人，倒箧倾筐恐后也。","book":"清·刘大櫆《赠资政大夫吴府君墓表》"},"similar":["倒廪倾囷","倒箧倾囊"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":6578,"word":"倒绷孩儿","pinyin":"dào bēng hái ér","abbr":"dbhe","explanation":"绷：包扎。接生婆把初生婴儿裹倒了。比喻一向做惯了的事因一时疏忽而弄错了。","source":{"text":"岂有三十年为老娘而倒绷孩儿者乎？","book":"《事文类聚前集》卷二十七"},"example":{"text":"作老娘三十年，今日～，亦复何说！","book":"清·蒲松龄《聊斋志异·念秧》"},"usage":"作谓语、定语；比喻不应该的失误","story":["宋仁宗时期，读书人苗振做了几年官然后去朝廷应试，当朝丞相晏殊让他温习功课。苗振说自己不会倒绷孩儿的。结果苗振在考试中把“普天之下，莫非王土”写成“普天之下莫非王”而落选。苗振见晏殊觉得十分羞愧"]},{"id":6579,"word":"倒置干戈","pinyin":"dào zhì gān gē","abbr":"dzgg","explanation":"把武器收藏起来，不再打仗。","source":{"text":"殷事已毕，偃革为轩，倒置干戈，覆以虎皮，以示天下不复用兵。","book":"西汉·司马迁《史记·留侯世家》"},"example":{"text":"老百姓都希望统治者～。"},"similar":["倒载干戈","马放南山"],"usage":"作谓语；表示不再打仗"},{"id":6580,"word":"倒背如流","pinyin":"dào bèi rú liú","abbr":"dbrl","explanation":"背：背诵。把书或文章倒过来背，背得像流水一样流畅。形容背得非常熟练，记得非常牢。","source":{"text":"她把说明小册子的英文部分似乎已经读得来倒背如流了。","book":"郭沫若《苏联纪行日记·六月廿七日》"},"example":{"text":"他每篇课文都可以～。"},"similar":["滚瓜烂熟"],"usage":"作谓语；多指背诵"},{"id":6581,"word":"倒行逆施","pinyin":"dào xíng nì shī","abbr":"dxns","explanation":"原指做事违反常理，不择手段。现多指所作所为违背时代潮流或人民意愿。","source":{"text":"吾日暮途远，吾故倒行而逆施之。","book":"《史记·伍子胥列传》"},"example":{"text":"在压迫得透不过气来的时候，疏解和抗议都无用，压迫者是可以任所欲为，～的。","book":"邹韬奋《患难余生记·离渝前的政治形势》"},"similar":["胡作非为","为非作歹","横行霸道"],"opposite":["嘉言善行","因势利导"],"usage":"作主语、谓语、定语；指违背情理","story":["春秋时伍子胥因父与兄被楚平王所杀逃到吴国，帮助吴王阖庐攻打楚国，五战五胜，打到楚国都城郢城，楚平王已死，伍子胥为报杀父之仇，掘坟鞭尸，友人反对，伍子胥说：“吾日莫途远，吾故倒行而逆施之。”"]},{"id":6582,"word":"倒街卧巷","pinyin":"dǎo jiē wò xiàng","abbr":"djwx","explanation":"指露宿街头。","source":{"text":"波子……看着宋江道：‘押司没事睬那乞丐做甚么？那斯一地里去搪酒吃，只是搬是搬非。这等倒街卧巷的横死贼，也来上门上户欺负人！’","book":"《水浒传》第二一回"},"usage":"作谓语、定语；用于生活"},{"id":6583,"word":"倒裳索领","pinyin":"dào cháng suǒ lǐng","abbr":"dcsl","explanation":"索：搜寻、寻求。把衣裳倒过来寻找领口。比喻办事抓不到要点。","source":{"text":"斯逆理而求之，犹倒裳而索领。","book":"《邓析子·无厚》"},"example":{"text":"你不要干～一样的蠢事。"},"similar":["缘木求鱼"],"usage":"作谓语、定语；指人办事"},{"id":6584,"word":"倒载干戈","pinyin":"dào zài gān gē","abbr":"dzgg","explanation":"倒：把锋刃向里倒插着；载：陈设，放置；干戈：古代的两种兵器，泛指武器。把武器倒着放起来，比喻没有战争，天下太平。","source":{"text":"倒载干戈，包之以虎皮，将帅之士……然后天下知武王之不复用兵也。","book":"西汉·戴圣《礼记·乐记》"},"example":{"text":"一戎而～，万国而混同文轨。","book":"宋·王禹偁《单州成武县行宫上梁文》"},"similar":["倒置干戈"],"usage":"作谓语；指停止作战"},{"id":6585,"word":"倔头倔脑","pinyin":"juè tóu juè nǎo","abbr":"jtjn","explanation":"形容说话、态度固执生硬的样子。","example":{"text":"我就是这～的性格。"},"similar":["倔头强脑"],"usage":"作谓语、定语；指人说话或做事"},{"id":6586,"word":"倔头强脑","pinyin":"juè tóu jiàng nǎo","abbr":"jtjn","explanation":"形容言语动作生硬执拗的样子。","source":{"text":"当时我就觉得其中两个，一男一女，倔头强脑，大不顺眼。","book":"茅盾《霜叶红似二月花》"},"similar":["倔头倔脑"],"usage":"作宾语、定语；指人的言行"},{"id":6587,"word":"倔强倨傲","pinyin":"jué jiàng jù ào","abbr":"jjja","explanation":"倔强：执拗；倨傲：傲慢。执拗而又傲慢。","source":{"text":"倔强而倨敖，自称老夫。","book":"汉·桓宽《盐铁论·论功》"},"usage":"作谓语、定语；指人的性格"},{"id":6588,"word":"倘来之物","pinyin":"tǎng lái zhī wù","abbr":"tlzw","explanation":"指意外得到的或非本分应得的东西。同“傥来之物”。","source":{"text":"这钱财是倘来之物。","book":"元·秦简夫《东堂老》第三折"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第八卷：“嬴时节，道是～，就有粘头的、讨赏的、帮衬的，大家都来撮哄。”"},"similar":["傥来之物"],"usage":"作宾语；指无意中得到的财物"},{"id":6589,"word":"倚人庐下","pinyin":"yǐ rén lú xià","abbr":"yrlx","explanation":"指依靠别人生活。","source":{"text":"最初流到贵州省城，其次又流到云南省城，倚人庐下，受了种种的虐待。","book":"郭沫若《芭蕉花》"},"similar":["寄人篱下"],"usage":"作谓语、定语；用于书面语"},{"id":6590,"word":"倚傍门户","pinyin":"yǐ bàng mén hù","abbr":"ybmh","explanation":"指依附、投靠某一门派或集团。","source":{"text":"克新，汝阳人。由青州推官擢御史，劾右庶子叶灿、光禄卿钱春、按察使张光缙倚傍门户，且请速诛熊廷弼。忠贤大喜，立传旨行刑。","book":"《明史·阉党传·门克新》"},"example":{"text":"自立门户者，如子孙不藉先人之业，赤手可以起家；～者，如奴仆占风望气，必较量主者之炎凉。","book":"清·黄宗羲《答汪魏美问济洞两宗争端书》"},"similar":["倚人庐下","倚门傍户"],"usage":"作谓语、定语；指没有自己的见解"},{"id":6591,"word":"倚势凌人","pinyin":"yǐ shì líng rén","abbr":"yslr","explanation":"凭借权势，欺侮别人。","source":{"text":"吾姓关，名羽，字长生，后改云长，河东解良人也。因本处势豪，倚势凌人，被吾杀了；逃难江湖，五六年矣。","book":"明·罗贯中《三国演义》第一回"},"similar":["仗势欺人"],"usage":"作谓语、定语；指仗势欺人"},{"id":6592,"word":"倚势挟权","pinyin":"yǐ shì jiá quán","abbr":"ysxq","explanation":"凭借权势，欺压别人。","source":{"text":"行至郊外，撞见一个倚势挟权的葛彪，马踏死小生的母，又打死我的浑家。","book":"元·无名氏《延安府》第一折"},"usage":"作谓语、定语；用于书面语"},{"id":6593,"word":"倚势欺人","pinyin":"yǐ shì qī rén","abbr":"ysqr","explanation":"倚：倚仗；欺：欺侮。依仗某种权势欺压人。","source":{"text":"他虽是倚势欺人，我家放着有护持圣旨，这里和他理论不得，须是京师也有大似他的。","book":"明·施耐庵《水浒全传》第五十二回"},"example":{"text":"你既不会～，难道还有谁欺负到你举人头上？","book":"姚雪垠《李自成》第一卷第二十六章"},"similar":["仗势欺人"],"usage":"作谓语、定语；用于小人"},{"id":6594,"word":"倚大欺小","pinyin":"yǐ dà qī xiǎo","abbr":"ydqx","explanation":"凭借自己强大去欺负弱小的人","source":{"text":"你就将铁锤打他，也算你倚大欺小，量窄不容。","book":"清·吴璿《飞龙全传》第24回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":6595,"word":"倚天拔地","pinyin":"yǐ tiān bá dì","abbr":"ytbd","explanation":"倚天而立，拔地而起。极言魁伟雄奇。","source":{"text":"至杜陵，负其倚天拔地之材，更欲驾《风》、《骚》而上之，则有所不能。","book":"清·陈廷焯《白雨斋词话》卷七"},"usage":"作谓语、定语；用于书面语"},{"id":6596,"word":"倚姣作媚","pinyin":"yǐ jiāo zuò mèi","abbr":"yjzm","explanation":"倚：凭借；姣：美好；媚：迷人。凭着自己美貌，任意撒娇胡闹。","source":{"text":"先时不过挟制薛蟠，后来倚姣作媚，将及薛姨妈，后将至宝钗。","book":"清·曹雪芹《红楼梦》第七十九回"},"usage":"作谓语、定语；用于女性"},{"id":6597,"word":"倚官仗势","pinyin":"yǐ guān zhàng shì","abbr":"ygzs","explanation":"依仗官府的权势。","source":{"text":"你说领着省事，掌着军权，居着高位，又道会亲处倚官挟势。","book":"元·关汉卿《玉镜台》第三折"},"example":{"text":"我不会～，暗地里给人小鞋穿。"},"similar":["仗势欺人","倚财仗势"],"usage":"作谓语、宾语；指爪牙"},{"id":6598,"word":"倚官挟势","pinyin":"yǐ guān xié shì","abbr":"ygxs","explanation":"倚仗官府的权势。","source":{"text":"从公道，依正理，怎做得倚官挟势。","book":"元·关汉卿《玉镜台》第三折：“你说领着省事，掌着军权，居着高位，又道会亲处倚官挟势。”元·武汉臣《玉壶春》第四折"},"example":{"text":"打一棍时问一句，～要欺人。","book":"《明成化说唱词话丛刊·包龙图陈州粜米记》"},"similar":["倚官仗势"],"usage":"作谓语、宾语；指爪牙"},{"id":6599,"word":"倚山傍水","pinyin":"yǐ shān bàng shuǐ","abbr":"ysbs","explanation":"倚：依靠；傍：临近。指地理位置靠近山岭和水流","source":{"text":"只见枯桩上缆着数只小渔船，疏篱外晒着一张破鱼网，倚山傍水，约有十数间草房。","book":"明·施耐庵《水浒传》第15回"},"example":{"text":"清·贪梦道人《彭公案》第69回：“这所宅院～，半天产，半人工，果然好一块风水地。”"},"similar":["依山傍水"],"usage":"作谓语、定语；指地理位置"},{"id":6600,"word":"倚庐之望","pinyin":"yǐ lú zhī wàng","abbr":"ylzw","explanation":"靠着家门向远处眺望。形容父母盼望子女归来的迫切心情。","source":{"text":"女朝出而晚来，则吾倚门而望，女暮出而不还，则吾倚闾而望。","book":"《战国策·齐策六》"},"similar":["倚闾而望","倚闾之望","倚门倚闾"],"usage":"作宾语；多用于父母等"},{"id":6601,"word":"倚强凌弱","pinyin":"yǐ qiáng líng ruò","abbr":"yqlr","explanation":"倚：仗，凭借；凌：欺压。仗着自己强大就欺侮弱者。","source":{"text":"须不是我仗强凌弱，还是你自揽祸招灾。","book":"元·康进之《李逵负荆》第四折"},"example":{"text":"你不能～。"},"similar":["仗强欺弱","以强凌弱"],"opposite":["锄强扶弱"],"usage":"作谓语、宾语；指欺负弱小","story":["春秋时期，孔子去劝说弟子柳下季的弟弟盗跖。盗跖是奴隶起义首领，拥有9000兵力。孔子希望他自拥城称王，不要再骚扰百姓。盗跖说以前人们耕种取食，纺织取衣，没有加害之心，现在是凭借强大欺凌弱小的时代，不必再劝了"]},{"id":6602,"word":"倚此为命","pinyin":"yǐ cǐ wéi mìng","abbr":"ycwm","explanation":"靠它作为生命的支柱。","example":{"text":"粮食，我们～。"},"similar":["倚此为生"],"usage":"作谓语；指靠着它才能活"},{"id":6603,"word":"倚玉之荣","pinyin":"yǐ yù zhī róng","abbr":"yyzr","explanation":"倚：倚傍；荣：荣幸。得到了依傍美人身边的荣幸。形容结成美满婚姻。","source":{"text":"得为新姻，言谐倚玉之荣。","book":"宋·胡继宗《书言故事·婚姻类》"}},{"id":6604,"word":"倚玉偎香","pinyin":"yǐ yù wēi xiāng","abbr":"yywx","explanation":"形容同女性亲热昵爱。","source":{"text":"念倚玉偎香，前事顿轻掷。","book":"宋·柳永《法曲献仙音》词"},"example":{"text":"花飞絮舞春归矣，～复几时。","book":"明·周履靖《锦笺记·草奏》"},"similar":["倚翠偎红"],"usage":"作谓语、定语；多用于男子"},{"id":6605,"word":"倚翠偎红","pinyin":"yǐ cuì wēi hóng","abbr":"ycwh","explanation":"倚翠：接近女性。形容同女性亲热昵爱。","source":{"text":"悔过了窃玉偷香胆，删抹了倚翠偎红话。","book":"元·王实甫《西厢记》第三本第三折"},"example":{"text":"每到饮酒宴行的时节，任我～。","book":"清·李渔《奈何天·隐妒》"},"similar":["依翠偎红","倚玉偎香"],"usage":"作谓语、定语；用于男子"},{"id":6606,"word":"倚老卖老","pinyin":"yǐ lǎo mài lǎo","abbr":"ylml","explanation":"仗着年纪大、资格老而自以为比人高明。","source":{"text":"张：（遇见了爷爷辈的这般以老卖老的同事，只好顺嘴胡溜，嘻嘻地）是啊是啊，陈奶奶。","book":"曹禺《北京人》第一幕"},"example":{"text":"周而复《上海的早晨》第四部：“我担心的是其老这样的人，～，横冲直撞，不把我们放在眼里。”"},"similar":["老气横秋","老物可憎"],"opposite":["老当益壮"],"usage":"作谓语、定语、状语；指摆老资格"},{"id":6607,"word":"倚草附木","pinyin":"yǐ cǎo fù mù","abbr":"ycfm","explanation":"①比喻依附有能力或权势的人。②指精灵倚托草木等物而成妖作怪。","source":{"text":"洪教头道：‘大官人只因好习枪棒，往往流配军人都来倚草附木，皆道我是枪棒教师，来投庄上，诱些酒食钱米。’","book":"明·施耐庵《水浒传》第九回"},"example":{"text":"因此到所在，人多～，成行逐队来皈依他，义声赫然。","book":"明·凌濛初《二刻拍案惊奇》卷三十九"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":6608,"word":"倚财仗势","pinyin":"yǐ cái zhàng shì","abbr":"yczs","explanation":"倚、仗：凭借。倚仗着自己的财产和势力。","source":{"text":"表兄薛蟠，倚财仗势，打死人命，现在应天府案下审理。","book":"清·曹雪芹《红楼梦》第三回"},"similar":["仗势欺人"],"usage":"作谓语、定语；指仗势欺人"},{"id":6609,"word":"倚酒三分醉","pinyin":"yǐ jiǔ sān fēn zuì","abbr":"yjsfz","explanation":"仗着喝点酒就装出醉态来。形容借一点因由，故意扩大事态。","source":{"text":"贾琏见了人，越发‘倚酒三分醉’，逞起威风来，故意要杀凤姐儿。","book":"清·曹雪芹《红楼梦》第44回"},"example":{"text":"他这是～，小心他在使坏。"},"usage":"作谓语、定语、宾语；用于处事"},{"id":6610,"word":"倚门之望","pinyin":"yǐ mén zhī wàng","abbr":"ymzw","explanation":"靠着家门向远处眺望。形容父母盼望子女归来的迫切心情。","source":{"text":"女朝出而晚来，则吾倚门而望，女暮出而不还，则吾倚闾而望。","book":"《战国策·齐策六》"},"example":{"text":"一者使贫道有传道之人，二乃免他老母～。","book":"明·施耐庵《水浒全传》第八十五回"}},{"id":6611,"word":"倚门倚闾","pinyin":"yǐ mén yǐ lǚ","abbr":"ymyl","explanation":"闾：古代里巷的门。形容父母盼望子女归来的迫切心情。","source":{"text":"女朝出而晚来，则吾倚门而望，女暮出而不还，则吾倚闾而望。","book":"《战国策·齐策六》"},"example":{"text":"～久相望，不可以留行束装。","book":"清·黄遵宪《别赖云芝同年》诗"},"similar":["倚庐之望"],"usage":"作状语、定语；指盼望子女归来","story":["战国时期，齐闵王的侍臣王孙贾每次入朝当差回家，他的母亲总是倚在门外等候，有时回来晚了，他母亲则到巷口去等。公元前284年，燕昭王派乐毅讨伐齐国。齐闵王弃城仓皇出逃，王孙贾找不到他就只好回家，他的母亲要他赶快去找"]},{"id":6612,"word":"倚门傍户","pinyin":"yǐ mén bàng hù","abbr":"ymbh","explanation":"倚、傍：靠着。比喻做学问自己没有见解，只袭取别人的说法。","source":{"text":"僧问纸衣和尚：‘如何是宾中宾？’师曰：‘倚门傍户。’","book":"宋·释普济《五灯会元》卷十一"},"example":{"text":"学问之道，以各人自用得著者为真。凡～、依样画葫芦者，非俗流之士，则经生之业也。","book":"明·黄寮羲《明儒学案·凡例》"},"similar":["倚傍门户"],"usage":"作谓语、定语；指没有自己的见解"},{"id":6613,"word":"倚门卖俏","pinyin":"yǐ mén mài qiào","abbr":"ymmq","explanation":"形容妓女卖弄风骚的生活。","source":{"text":"刺绣文，不如倚市门。","book":"西汉·司马迁《史记·货殖列传》"},"example":{"text":"或论文清书如姑禅入定，待讲书如布帛菽粟，太守书如～。","book":"清·钱泳《履园丛话·书学·总论》"},"similar":["倚门卖笑","卖俏倚门"],"usage":"作谓语、定语；指妓女生活"},{"id":6614,"word":"倚门卖笑","pinyin":"yǐ mén mài xiào","abbr":"ymmx","explanation":"旧时形容妓女的生活。","source":{"text":"刺绣文不如倚市门。","book":"《史记·货殖列传》"},"example":{"text":"伫看我们这样打扮，并不象那～的娼妓。","book":"清·刘鹗《老残游记续集遗稿》第二回"},"similar":["倚门卖俏","倚门献笑"],"usage":"作谓语、定语；指妓女生活"},{"id":6615,"word":"倚门献笑","pinyin":"yǐ mén xiàn xiào","abbr":"ymxx","explanation":"旧指妓女卖淫。同“倚门卖笑”。","source":{"text":"美娘道：‘奴是好人家儿女，误落风尘，倘得姨娘主张从良，胜造九级浮图。若要我倚门献笑，送旧迎新，宁甘一死，决不情愿。’","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"却说那妓女，原不是～、涂脂沫粉的一流，姓赵，名素馨，字曰友梅。","book":"清·烟水散人《合浦珠》第三回"},"similar":["倚门卖笑"],"usage":"作谓语、定语；指妓女生活"},{"id":6616,"word":"倚门窥户","pinyin":"yǐ mén kuī hù","abbr":"ymkh","explanation":"指攀附企望于他人。","source":{"text":"然不敢自列于下执事者，以为贱贵有伦，等威有序，以闲人持不急之务，朝夕倚门窥户，抑亦侍郎之所恶也。","book":"唐·王维《与工部李侍郎书》"},"usage":"作谓语、定语；用于书面语"},{"id":6617,"word":"倚门而望","pinyin":"yǐ mén ér wàng","abbr":"ymew","explanation":"靠着家门向远处眺望。形容父母盼望子女归来的迫切心情。","source":{"text":"女朝出而晚来，则吾倚门而望，女暮出而不还，则吾倚闾而望。","book":"《战国策·齐策六》"},"example":{"text":"吾想汝等父母、兄弟、妻子必～；若听知阵败，定然割肚牵肠，眼中流血。","book":"明·罗贯中《三国演义》第八十七回"}},{"id":6618,"word":"倚闾之思","pinyin":"yǐ lǚ zhī sī","abbr":"ylzs","explanation":"闾：古代里巷的门。靠着家门思念子女。形容父母盼望子女归来的迫切心情。","source":{"text":"女朝出而晚来，则吾倚门而望，女暮出而不还，则吾倚闾而望。","book":"《战国策·齐策六》"},"usage":"作宾语；多用于子女等"},{"id":6619,"word":"倚闾之望","pinyin":"yǐ lǚ zhī wàng","abbr":"ylzw","explanation":"闾：古代里巷的门。靠着家门等候。形容父母盼望子女归来的迫切心情。","source":{"text":"女朝出而晚来，则吾倚门而望，女暮出而不还，则吾倚闾而望。","book":"《战国策·齐策六》"},"similar":["倚门倚闾","倚庐之望","倚闾而望"],"usage":"作宾语；多用于父母等"},{"id":6620,"word":"倚闾望切","pinyin":"yǐ lǘ wàng qiē","abbr":"ylwq","explanation":"闾：古代里巷的门。靠在里巷的门口向远处殷切地望着。形容父母盼望子女归来的心情十分殷切。亦作“倚闾而望”、“倚门而望”、“倚门倚闾”、“倚门之望”、“倚门而望”、","source":{"text":"亲老多病，倚闾望切，屡屡寄信前来叫卑职回去。","book":"清·李宝嘉《官场现形记》第十八回"}},{"id":6621,"word":"倚闾而望","pinyin":"yǐ lǚ ér wàng","abbr":"ylew","explanation":"闾：古代里巷的门。靠着家门向远处眺望。形容父母盼望子女归来的迫切心情。","source":{"text":"女朝出而晚来，则吾倚门而望，女暮出而不还，则吾倚闾而望。","book":"《战国策·齐策六》"},"example":{"text":"母无依，必定～；况又不知我有刑陷之灾。","book":"明·许仲琳《封神演义》第二十三回"},"similar":["倚闾之望","倚门倚闾","倚庐之望"],"usage":"作宾语；多用于父母等","story":["战国时期，齐闵王的侍臣王孙贾每次入朝当差回家，他的母亲总是倚在门外等候，有时回来晚了，他母亲则到巷口去等。公元前284年，燕昭王派乐毅讨伐齐国。齐闵王弃城仓皇出逃，王孙贾找不到他就只好回家，他的母亲要他赶快去找"]},{"id":6622,"word":"倚马七纸","pinyin":"yǐ mǎ qī zhǐ","abbr":"ymqz","explanation":"比喻文章写得快。","source":{"text":"桓宣武北征，袁虎时从，被责免官。会须露布文，唤袁倚马前令作。手不掇笔，俄得七纸，殊可观。","book":"南朝·宋·刘义庆《世说新语·文学》"},"similar":["倚马千言"],"usage":"作宾语、定语；指文章写得快","story":["东晋豫州刺史谢尚发现袁虎文才很好，就把他推荐给大司马桓温。桓温让他负责府内文书起草工作。袁尚作《东征赋》赞扬东晋许多名士。他跟随桓温北伐前燕，在前线，桓温让他写讨伐檄文，他靠在马背上很快就写完一篇得体的檄文"]},{"id":6623,"word":"倚马万言","pinyin":"yǐ mǎ wàn yán","abbr":"ymwy","explanation":"倚：靠着。倚靠在马旁，马上写成一篇文章。形容才思敏捷。","source":{"text":"桓宣武北征，袁虎时从，被责免官。会须露布文，唤袁倚马前令作。手不掇笔，俄得七纸，殊可观。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"秋翁向来诗才敏捷，真可～，想必不至受罚。我辈拭目以俟佳作便了。","book":"清·张春帆《九尾龟》第十一回"}},{"id":6624,"word":"倚马之才","pinyin":"yǐ mǎ zhī cái","abbr":"ymzc","explanation":"倚：靠着。有倚在战马前起草文章就可以迅速完稿的才能。比喻才思敏捷。","source":{"text":"桓宣武北征，袁虎时从，被责免官，会须露布文，唤袁倚马前令作，手不掇笔，俄得七纸，殊可观。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"奇资异质，本自天成，发迹贤科，～空冀北。","book":"明·李开先《闲居集·钝庵赵尹征粮受奖帐文》"}},{"id":6625,"word":"倚马千言","pinyin":"yǐ mǎ qiān yán","abbr":"ymqy","explanation":"倚马：靠着战马。倚靠在即将出发的战马前起草文件，千言立就。形容才思敏捷。","source":{"text":"多少英雄豪杰，该富的不得富，该贵的不得贵；能文的倚马千言，用不着时，几张纸，盖不完酱瓿。","book":"明·凌濛初《初刻拍案惊奇》第一卷"},"example":{"text":"他～，很快就完成了调查报告。"},"similar":["倚马可待","才高倚马","倚马长才"],"usage":"作谓语、定语；指写文章","story":["东晋豫州刺史谢尚发现袁虎文才很好，就把他推荐给大司马桓温。桓温让他负责府内文书起草工作。袁尚作《东征赋》赞扬东晋许多名士。他跟随桓温北伐前燕，在前线，桓温让他写讨伐檄文，他靠在马背上很快就写完一篇得体的檄文"]},{"id":6626,"word":"倚马可待","pinyin":"yǐ mǎ kě dài","abbr":"ymkd","explanation":"倚在即将出发的战马前起草文件，可以等着完稿。比喻文章写得快。","source":{"text":"桓宣武北征，袁虎时从，被责免官，会须露布文，唤袁倚马前令作，手不掇笔，俄得七纸，殊可观。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"请日试万言，～。","book":"唐·李白《与韩荆州书》"},"similar":["倚马七纸"],"usage":"作谓语、定语；比喻文章写得快","story":["东晋豫州刺史谢尚发现袁虎文才很好，就把他推荐给大司马桓温。桓温让他负责府内文书起草工作。袁尚作《东征赋》赞扬东晋许多名士。他跟随桓温北伐前燕，在前线，桓温让他写讨伐檄文，他靠在马背上很快就写完一篇得体的檄文"]},{"id":6627,"word":"倚马立成","pinyin":"yǐ mǎ lì chéng","abbr":"ymlc","explanation":"倚：靠着；民：完成。倚在即将出发的战马前起草文件，可以等着完稿。比喻文章写得快。","source":{"text":"桓宣武北征，袁虎时从，被责免官，会须露布文，唤袁倚马前令作，手不掇笔，俄得七纸，殊可观。","book":"南朝·宋·刘义庆《世说新语·文学》"}},{"id":6628,"word":"倚马长才","pinyin":"yǐ mǎ cháng cái","abbr":"ymzc","explanation":"倚：靠着。有倚在战马前起草文章就可以迅速完稿的才能。比喻才思敏捷。","source":{"text":"桓宣武北征，袁虎时从，被责免官，会须露布文，唤袁倚马前令作，手不掇笔，俄得七纸，殊可观。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"两人不来多嘴，全凭那斫轮老手徐世昌，及～王式通，悉心研究。","book":"蔡东藩、许廑父《民国通俗演义》第六十七回"},"similar":["倚马可待","倚马千言","才高倚马"],"usage":"作宾语、定语；比喻文章写得快"},{"id":6629,"word":"倜傥不羁","pinyin":"tì tǎng bù jī","abbr":"ttbj","explanation":"倜傥：洒脱，不拘束；羁：马笼头，比喻束缚、拘束。形容洒脱豪放，不受拘束。","source":{"text":"耽字彦道，少有才气，俶傥不羁，为士类所称。","book":"《晋书·袁耽传》"},"example":{"text":"为人～，轻财尚义。","book":"明·东鲁古狂生《醉醒石》第一回"},"similar":["豪放不羁"],"usage":"作谓语、定语；用于人"},{"id":6630,"word":"倜傥不群","pinyin":"tì tǎng bù qún","abbr":"ttbq","explanation":"倜傥：洒脱，不拘束。形容洒脱豪放与众不同。","source":{"text":"或若登高望其类，或若既往而中顾，或若倜傥不群，或若自检于常度。","book":"《晋书·索靖传》"},"example":{"text":"余友毕怡庵，～，豪纵自喜。","book":"清·蒲松龄《聊斋志异·狐梦》"},"similar":["鹤立鸡群"],"usage":"作谓语、定语；指卓越不凡"},{"id":6631,"word":"倜傥之才","pinyin":"tì tǎng zhī cái","abbr":"ttzc","explanation":"倜傥：卓异，洒脱不拘。卓越、突出的才能。","source":{"text":"其负倜傥之才，变通之术。","book":"五代·王定保《唐摭言·散序进士》"},"usage":"作主语、宾语；用于书面语"},{"id":6632,"word":"倜傥风流","pinyin":"tì tǎng fēng liú","abbr":"ttfl","explanation":"倜傥：卓异，洒脱不拘；风流：有才学而不拘礼法。形容人有才华而言行不受世俗礼节的拘束。","source":{"text":"羡英年壮节堪多，似冰心在玉壶，散财结客，侠比三河，风流倜傥，名倾六辅。","book":"明·许三阶《节侠记·私仰》"},"example":{"text":"这位许澄波，倒也十会～，不象个风尘俗吏。","book":"清·吴趼人《二十年目睹之怪现状》第三十八回"},"similar":["风流倜傥"],"usage":"作谓语、定语；指人很潇洒"},{"id":6633,"word":"借书留真","pinyin":"jiè shū liú zhēn","abbr":"jslz","explanation":"指借别人的书，抄写后留下正本，把抄本还给别人。","source":{"text":"从民得善书，必为好写与之，留其真。","book":"《汉书·河间献王传》"},"usage":"作谓语、定语；用于处事"},{"id":6634,"word":"借事生端","pinyin":"jiè shì shēng duān","abbr":"jssd","explanation":"以某事为借口而制造事端。","source":{"text":"不肖者则借事生端，望风寻趁。","book":"清·冯舒《上瞿知县卖荒揭》"}},{"id":6635,"word":"借交报仇","pinyin":"jiè jiāo bào chóu","abbr":"jjbc","explanation":"帮助别人报仇。","source":{"text":"（解）以躯借交报仇。","book":"《史记·郭解列传》"},"similar":["借客报仇","借身报仇"],"usage":"作谓语、宾语；指舍身助人报仇"},{"id":6636,"word":"借他人酒杯，浇自己块垒","pinyin":"jiè tā rén jiǔ bēi，jiāo zì jǐ kuài lěi","abbr":"jtrjbjzjkl","explanation":"块垒：由土块垒成的土堆，借喻心中积郁的愁闷。借助酒来排遣心中的积郁。","source":{"text":"阮籍，胸中垒块，故须酒浇之。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"有了现成的歌儿，就可以～，随时拣一以合适的唱唱，也足可消愁解闷。","book":"朱自清《经典常谈·诗经第四》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":6637,"word":"借公行私","pinyin":"jiè gōng xíng sī","abbr":"jgxs","explanation":"借公事的名义谋取私利。","source":{"text":"见善忘举者妒，知恶不劾者比，依违是非者谲，借公行私者佞。","book":"清·刘献廷《广阳杂记》第一卷"},"example":{"text":"～，针砭时弊，是杂文的主要特点。"},"similar":["假公营私"],"usage":"作谓语、宾语、定语；用于自私的人"},{"id":6638,"word":"借刀杀人","pinyin":"jiè dāo shā rén","abbr":"jdsr","explanation":"比喻自己不出面，借别人的手去害人。","source":{"text":"恩相明日奏仲淹为环庆路经略招讨使，以平无昊，这所谓借刀杀人。","book":"明·汪廷讷《三祝记·造陷》"},"example":{"text":"凤姐虽恨秋桐，且喜借他先可发脱二姐，用～之法。","book":"清·曹雪芹《红楼梦》第六十九回"},"similar":["以夷制夷","暗箭伤人"],"opposite":["亲历亲为"],"usage":"作谓语、宾语、定语、状语；用于处事","story":["三国时期，孔明病故，魏延在军中做了一个头上生角的梦就认为自己可以称王的预兆，就对孔明的安排不满，与马岱起兵攻打杨仪，杨仪看了孔明的锦囊妙计，就叫魏延叫“谁敢杀我”，魏延高呼，马岱在后杀死魏延，这是孔明生前安排的"]},{"id":6639,"word":"借剑杀人","pinyin":"jiè jiàn shā rén","abbr":"jjsr","explanation":"比喻自己不出面，借别人的手去害人。同“借刀杀人”。","source":{"text":"‘坐山看虎斗’，‘借剑杀人’，‘引风吹火’，‘站干岸儿’，‘推倒了油瓶不扶’，都是全挂子的本事。","book":"清·曹雪芹《红楼梦》第16回"},"similar":["借刀杀人"],"usage":"作谓语、宾语、定语、状语；指借别人的手害"},{"id":6640,"word":"借古喻今","pinyin":"jiè gǔ yù jīn","abbr":"jgyj","explanation":"借：假借；喻：比喻。假借古人古事比喻现实中的今人今事。","example":{"text":"请不要用诗来～了，我们清醒得很。"},"similar":["借古讽今"],"usage":"作谓语、定语、宾语；用于处事"},{"id":6641,"word":"借古讽今","pinyin":"jiè gǔ fěng jīn","abbr":"jgfj","explanation":"借评论古代的人和事来影射讽刺现实。","source":{"text":"因为父亲曾经发表过的一部历史人物传记中赞扬了一位含冤而死的兵部尚书，被认为借古讽今。","book":"张抗抗《国魂》"},"example":{"text":"～，针砭时弊，是杂文的主要特点。"},"similar":["指鸡骂狗","指桑骂槐","含沙射影"],"usage":"作谓语、定语；表示对现实不满"},{"id":6642,"word":"借听于聋","pinyin":"jiè tīng yú lóng","abbr":"jtyl","explanation":"借；借助。借助于耳聋的人打探消息。比喻找错了求教的对象。","source":{"text":"足下求速化之术不于其人，乃以访愈，是所谓借听于聋，求道于盲。","book":"唐·韩愈《答陈生书》"}},{"id":6643,"word":"借坡下驴","pinyin":"jiè pō xià lǘ","abbr":"jpxl","explanation":"凭借有利的地势下驴。比喻利用有利条件行事。","source":{"text":"李英民咕嘟一声灌了一口汤，想找个台阶借坡下驴：‘好男不跟女斗。’","book":"张笑天《死岛情仇》"},"similar":["见风使舵","因势利导"],"opposite":["守株待兔","刻舟求剑"],"usage":"作谓语、宾语；指利用有利条件"},{"id":6644,"word":"借客报仇","pinyin":"jiè kè bào chóu","abbr":"jkbc","explanation":"帮助别人报仇。","source":{"text":"少时通轻侠，借客报仇。","book":"《汉书·朱云传》"},"similar":["借交报仇","借身报仇"],"usage":"作谓语、宾语；指舍身助人报仇"},{"id":6645,"word":"借寇兵，赍盗粮","pinyin":"jiè kòu bīng，jī dào liáng","abbr":"jkbjdl","explanation":"赍：资助。把武器借给了贼兵，把粮食送给了盗匪。比喻帮助自己的敌人增强力量。","source":{"text":"非其人而教之，赍盗粮，借贼兵也。","book":"《荀子·大略》"},"example":{"text":"则智气两者亦无从发达完满，就使有智，亦不过～，就是有气，亦不过是一团客气。","book":"清·梁启超《新中国未来记》第二回"},"similar":["赍盗粮，借贼兵","借寇赍盗"],"usage":"作谓语、定语、宾语；用于处事"},{"id":6646,"word":"借寇赍盗","pinyin":"jiè kòu jī dào","abbr":"jkjd","explanation":"赍：资助。把武器借给了贼兵，把粮食送给了盗匪。比喻帮助自己的敌人增强力量。","source":{"text":"非其人而教之，赍盗粮，借贼兵也。","book":"《荀子·大略》"},"example":{"text":"其中近年所买夷炮，约居三分之一，尽以～，深堪愤恨。","book":"清·林则徐《答奕将军防御粤省六条》"},"similar":["借寇兵，赍盗粮","借贼兵，赍盗粮"],"usage":"作谓语、定语、宾语；用于处事"},{"id":6647,"word":"借尸还阳","pinyin":"jiè shī huán yáng","abbr":"jshy","explanation":"犹言借尸还魂。比喻已经消灭或没落的事物又以另一种形式出现。","source":{"text":"以后再有法西斯蒂的鬼魂借尸还阳的话，总可以少骗几个人吧。","book":"何其芳《理性与历史》"},"similar":["借尸还魂"],"usage":"作谓语、宾语、定语；指死灰复燃"},{"id":6648,"word":"借尸还魂","pinyin":"jiè shī huán hún","abbr":"jshh","explanation":"迷信者认为，人死后可将灵魂附于他人尸体而复活。比喻已经消灭或没落的事物又以另一种形式出现。","source":{"text":"岳寿，谁想你浑家将你尸骸烧化了，我如今着你借尸还魂，尸骸是小李屠，魂灵是岳寿。","book":"元·岳伯川《铁拐李·楔子》"},"example":{"text":"可是地主就在那边，工作团刚刚走，斗争刚刚过后，人家就来报仇，也能够～哩！","book":"孙犁《诉苦翻心》"},"similar":["东山再起","死灰复燃"],"usage":"作谓语、宾语、定语；指死灰复燃"},{"id":6649,"word":"借故推辞","pinyin":"jiè gù tuī cí","abbr":"jgtc","explanation":"借：假托；故：借口。找借口推托别人的请求。"},{"id":6650,"word":"借故敲诈","pinyin":"jiè gù qiāo zhà","abbr":"jgqz","explanation":"借：假托；故：借口。找借口敲诈、勒索别人的钱财。"},{"id":6651,"word":"借景生情","pinyin":"jiè jǐng shēng qíng","abbr":"jjsq","explanation":"借眼前的事物激发思想感情。","source":{"text":"郭祥抱着卡宾枪，食指不离扳机，不断地借景生情地喊着鼓动口号。","book":"魏巍《东方》第四部第二章"},"example":{"text":"他在此只是～而已。"},"similar":["触景生情"],"usage":"作谓语、宾语、状语；指见景生情"},{"id":6652,"word":"借水推船","pinyin":"jiè shuǐ tuī chuán","abbr":"jstc","explanation":"指趁势行事。亦作“借水行舟”。","source":{"text":"狱官借水推船，权把吴清收监。","book":"明·冯梦龙《警世通言》第30卷"},"similar":["借水行舟"],"usage":"作谓语、宾语、定语；用于趁便"},{"id":6653,"word":"借水行舟","pinyin":"jiè shuǐ xíng zhōu","abbr":"jsxz","explanation":"指趁势行事。同“借水推船”。","source":{"text":"我家老爷是个清官，并无许多银两，又说小人借水行舟，希图这三百两银子，将我打了二十板子。","book":"清·石玉昆《三侠五义》第46回"},"example":{"text":"拜他以为义子，这也不过是～，有何不可？","book":"欧阳予倩《桃花扇》第二场"},"similar":["借水推船"],"usage":"作谓语、宾语、定语；用于趁便"},{"id":6654,"word":"借端生事","pinyin":"jiè duān shēng shì","abbr":"jdss","explanation":"端：事端。以某种事由为借口，制造纠纷，惹事生非。","source":{"text":"如有借端生事者，立拿重处。","book":"清·陆陇其《三鱼堂外集·乡钓保甲示》"},"example":{"text":"老饕借端又生事，假称防患设科条。","book":"清·吴思祖《香会谣》"}},{"id":6655,"word":"借箸代筹","pinyin":"jiè zhù dài chóu","abbr":"jzdc","explanation":"箸：筷子；筹：过去用以计算的工具，引伸为策划。原意是借你前面的的筷子来指画当前的形势。后比喻从旁为人出主意，计划事情。","source":{"text":"请借前箸以筹之。","book":"《史记·留侯世家》"},"example":{"text":"～一县策，纳楹闲访百城书。","book":"清·刘鹗《老残游记》第七回"},"usage":"作谓语；指代人出主意","story":["楚汉相争时期，刘邦与项羽争执不下时，谋士鹂食其也没有别的好办法，这时张良进来拜谒。刘邦问怎样才能尽快战胜西楚霸王项羽。张良见刘邦桌上有筷子，就拿起筷子在桌上画起来，指点江山。刘邦顿时茅塞顿开、喜笑颜开"]},{"id":6656,"word":"借篷使风","pinyin":"jiè péng shǐ fēng","abbr":"jpsf","explanation":"比喻借他人之力办事。","source":{"text":"黄通理叹了一口气，见这张先生酒落欢肠，话颇坦直，虽然是个蠹吏，性情是了亮容易打夥的，便动了借篷使风的主意。","book":"清·颐琐《黄绣球》第四回"},"usage":"作宾语、定语；用于处事"},{"id":6657,"word":"借花献佛","pinyin":"jiè huā xiàn fó","abbr":"jhxf","explanation":"比喻用别人的东西做人情。","source":{"text":"今我女弱不能得前，请寄二花以献于佛。","book":"《过去现在因果经》一"},"example":{"text":"今儿有人送极新鲜的山鸡，烫了吃，很好的，我就～了。","book":"清·刘鹗《老残游记》第六回"},"similar":["顺水人情"],"opposite":["真心实意"],"usage":"作谓语、宾语、定语；比喻用别人的东西做人"},{"id":6658,"word":"借词卸责","pinyin":"jiè cí xiè zé","abbr":"jcxz","explanation":"借词：找借口；卸：推卸。寻找借口推卸责任。"},{"id":6659,"word":"借贷无门","pinyin":"jiè dài wú mén","abbr":"jdwm","explanation":"借贷：借钱。没有地方借钱。","source":{"text":"翁家乏食，借贷无门，典质已尽，搔首踟蹰，牛衣对泣而已。","book":"清·宣鼎《夜雨秋灯录·义猫》"},"example":{"text":"偃久羁京师，资用乏绝，～，不得已乞灵文字，草成数千言，诣阙呈入。","book":"蔡东藩《前汉演义》第六十六回"},"similar":["告贷无门"],"usage":"作宾语、定语；指陷于孤立"},{"id":6660,"word":"借贼兵，赍盗粮","pinyin":"jiè zéi bīng，jī dào liáng","abbr":"jzbjdl","explanation":"赍：资助。把武器借给了贼兵，把粮食送给了盗匪。比喻帮助自己的敌人增强力量。","source":{"text":"非其人而教之，赍盗粮，借贼兵也。","book":"《荀子·大略》"},"similar":["借寇赍盗","借寇兵，赍盗粮"],"usage":"作谓语、定语、宾语；用于处事"},{"id":6661,"word":"借身报仇","pinyin":"jiè shēn bào chóu","abbr":"jsbc","explanation":"指舍身助人报仇。同“借交报仇”。","source":{"text":"结交须结游侠儿，借身报仇心不疑。","book":"明·高启《结交少年场行》"},"similar":["借客报仇","借交报仇"],"usage":"作谓语、宾语；指舍身助人报仇"},{"id":6662,"word":"借酒浇愁","pinyin":"jiè jiǔ jiāo chóu","abbr":"jjjc","explanation":"用喝酒来浇灭郁积在心中的气愤或愁闷。","source":{"text":"只恁以酒浇愁，愁不能遣，而且日增。","book":"明·李开先《后冈陈提学传》"},"example":{"text":"龟井的文章，立意的大部分是在给他们国内的人看的，当然不免有'～'的气味。","book":"鲁迅《书信集·致胡风》"},"similar":["借酒消愁"],"usage":"作谓语、宾语；指喝闷酒"},{"id":6663,"word":"借镜观形","pinyin":"jiè jìng guān xíng","abbr":"jjgx","explanation":"借：凭借。比喻参考和吸取别人的经验教训。","source":{"text":"人目短于自见，故借镜以观形。","book":"《刘子新论·贵言》"},"usage":"作谓语、宾语；用于处事"},{"id":6664,"word":"借面吊丧","pinyin":"jiè miàn diào sāng","abbr":"jmds","explanation":"意谓虚有其表。","source":{"text":"文若，可借面吊丧。","book":"《后汉书·弥衡传》载：汉末弥衡恃才傲物，别人问他对荀彧（字文若）的看法，他认为荀彧虽仪容堂堂，但实则徒有虚表，故答道"},"example":{"text":"此人成天板着面孔，这也看不惯，那也不行，其实没啥本事，这副嘴脸，可～。"},"usage":"作谓语、定语；用于讥讽人","story":["东汉末期，文人祢衡恃才傲物，自高自大，看不起别人。一次有人问他对荀彧（字文若）的看法，他认为荀彧虽仪容堂堂，但实则徒有虚表，就直言不讳地答道：“文若，可借面吊丧。”"]},{"id":6665,"word":"借题发挥","pinyin":"jiè tí fā huī","abbr":"jtfh","explanation":"借着某件事情为题目来做文章，以表达自己真正的意见或主张。也指假借某事为由，去做其它的事。","source":{"text":"我触动起来，顺口骂他两句。就是你们文人说的，甚么‘借题发挥’的意思呢。","book":"清·吴趼人《痛史》第七回"},"example":{"text":"尽管是～，而且是借错了题，我对王芸生的手法，依然是佩服的。","book":"郭沫若《摩登唐吉诃德的一种手法》"},"similar":["小题大作","指桑骂槐"],"opposite":["大题小作"],"usage":"作谓语、宾语、定语、状语；指故意闹事"},{"id":6666,"word":"借风使船","pinyin":"jiè fēng shǐ chuán","abbr":"jfsc","explanation":"风向哪里吹，船往哪里行。比喻凭借别人的力量以达到自己的目的。","source":{"text":"今见金桂所为，先已开了端，他便乐得借风使船，先弄薛昨蝌到手，不怕金桂不依。","book":"清·曹雪芹《红楼梦》第九十一回"},"similar":["见风使舵","见机行事"],"usage":"作谓语；比喻顺势行事"},{"id":6667,"word":"倡情冶思","pinyin":"chàng qíng yě sī","abbr":"cqys","explanation":"冶荡轻佻的情思。","source":{"text":"余游四方，往往闻农夫细民倡情冶思之所歌谣，虽其辞为方言鄙语，而亦时有义意之存。","book":"清·戴名世《吴他山诗序》"},"usage":"作宾语、定语；指轻佻的情思"},{"id":6668,"word":"倡条冶叶","pinyin":"chāng tiáo yě yè","abbr":"ctyy","explanation":"倡：通‘娼’；冶：妖艳。原形容杨柳的枝叶婀娜多姿。后比喻任人玩赏攀折的花草枝叶。借指妓女。","source":{"text":"蜜房羽客类芳心，冶叶倡条遍相识。","book":"唐·李商隐《燕春台》诗"},"example":{"text":"～姿留连，飘荡轻于花上絮。","book":"宋·欧阳修《玉楼春·二五》词：唱筹量沙"},"similar":["闲花野草"],"usage":"作宾语、定语；指妓女"},{"id":6669,"word":"倡而不和","pinyin":"chàng ér bù hè","abbr":"cebh","explanation":"倡：同“唱”。和：响应。领唱无人应和。形容有人领导，但无人响应的冷清局面。","source":{"text":"倡而不和，意而不戴。","book":"汉·刘安《淮南子·缪称训》"},"opposite":["一呼百应"],"usage":"作谓语、定语；用于交往等"},{"id":6670,"word":"倦尾赤色","pinyin":"juàn wěi chì sè","abbr":"jwcs","explanation":"比喻困苦之极。","source":{"text":"鲂鱼赤尾。","book":"《诗经·周南·汝坟》"},"example":{"text":"怜君满腹富文彩，～无波澜。","book":"宋·曾巩《送吴秀才》诗"},"usage":"作谓语；指十分困苦"},{"id":6671,"word":"倦翼知还","pinyin":"juàn yì zhī huán","abbr":"jyzh","explanation":"疲倦的鸟知道飞回自己的巢。比喻辞官后归隐田园；也比喻从旅居之地返回故乡。","source":{"text":"云无心以出岫，鸟倦飞而知还。","book":"晋·陶潜《归去来辞》"},"example":{"text":"惟公遵养已久，亦宜及时效用，幸早戒行，以慰群望。昔也～，今也无心出岫。","book":"明·张居正《与楚学宪胡庐山》"}},{"id":6672,"word":"倦鸟知还","pinyin":"juàn niǎo zhī huán","abbr":"jnzh","explanation":"疲倦的鸟知道飞回自己的巢。比喻辞官后归隐田园；也比喻从旅居之地返回故乡。","source":{"text":"云无心以出岫，鸟倦飞而知还。","book":"晋·陶潜《归去来辞》"},"example":{"text":"～，晚云遥映，山气欲黄昏。此还真意，故应欲辨忘言。","book":"宋·叶梦得《念奴娇·南归渡扬子作，杂用渊明语》词"},"usage":"作宾语、定语；用于比喻句"},{"id":6673,"word":"倨傲无礼","pinyin":"jù ào wú lǐ","abbr":"jawl","explanation":"倨傲：傲慢。指人高傲自大，对人没有礼貌。","source":{"text":"且说唐玄宗因内监冯神威奏言安禄山不迎接诏书，倨傲无礼，心中甚怒。","book":"清·褚人获《隋唐演义》第88回"},"similar":["傲慢无礼"],"usage":"作谓语、定语、状语；用于为人处事"},{"id":6674,"word":"倩人捉刀","pinyin":"qiàn rén zhuō dāo","abbr":"qrzd","explanation":"倩：请；捉刀：代人执笔作文。请人代做文章。","source":{"text":"魏王雅望非常，然床头捉刀人，此乃英雄也。","book":"《三国志·魏志·陈思王植传》：“言出为论，下笔成章，顾当面试，奈何倩人？”南朝宋·刘义庆《世说新语·容止》"},"similar":["请人捉刀"],"usage":"作谓语、定语；指请人代做文章","story":["三国时期，生性多疑的曹操在会见匈奴的使者时，为了显示他的威武形象就让一表人才的崔季珪装成他接见，自己则扮成武士提着刀站在床头。会见完毕就命间谍问匈奴使者对魏王的印象如何，匈奴使者说床头捉刀人才是真正的英雄"]},{"id":6675,"word":"倩女离魂","pinyin":"qiàn nǚ lí hún","abbr":"qnlh","explanation":"旧指少女为爱情而死。","source":{"text":"唐·陈玄祐《离魂记》"},"example":{"text":"想着那引肖娘写恨书千里；搬～酒一杯，携文君逃走琴三尺。","book":"元·马致远《青衫泪》第三折"},"similar":["离魂倩女"],"usage":"作宾语、定语；用于男女爱情","story":["唐朝时期，衡阳郡张镒的女儿倩娘十分漂亮，爱上她的表哥王宙。张镒忘记他的承诺而将倩娘另嫁。王宙痛苦地离开衡阳，夜晚倩娘追他而去，与他一起逃到四川成都成家。十几年才回衡阳，回来发现一起去成都的只是倩娘的灵魂"]},{"id":6676,"word":"债台高筑","pinyin":"zhài tái gāo zhù","abbr":"ztgz","explanation":"形容欠债很多。","source":{"text":"分为二周，有逃债之台。","book":"《汉书·诸侯王表序》"},"example":{"text":"由于经营不善，这家公司现已陷入～的境地。"},"similar":["家徒四壁","民劣财尽"],"opposite":["绰有余裕","金玉满堂"],"usage":"作谓语、补语；指欠钱","story":["战国后期，周赧王听信楚孝烈王，用天子的名义召集六国出兵伐秦，他让西周公拼凑6000士兵，由于没有军费，只好向富商地主借钱，可六国根本不听他的话，他借的钱很快就花完，债主纷纷上门讨债，他只好隐藏在宫中的一座高台上"]},{"id":6677,"word":"债多不愁","pinyin":"zhài duō bù chóu","abbr":"zdbc","explanation":"债欠多了反而不忧愁。比喻困难成堆，认为反正一时解除不了，也就不去愁它了。","source":{"text":"人言债多人不愁，我为债务终夜忧。","book":"清·翟灏《风俗通·货财·债多不愁》引李流芳诗"},"example":{"text":"但管目前，随他如何进行，总教借款有着，便好偷安旦夕，得过且过，～。","book":"蔡东藩、许廑父《民国通俗演义》第十一回"},"similar":["虱多不痒"],"usage":"作谓语、定语；指习以为常了"},{"id":6678,"word":"倾危之士","pinyin":"qīng wēi zhī shì","abbr":"qwzs","explanation":"倾：危，邪。诡辩、阴险、奸诈。比喻对国家和人民有很大危险的人。","source":{"text":"张仪之行事甚于苏秦，然世恶苏秦者，以其先死，而仪振暴其短以扶其说，成其衡道。要之，此两人真倾危之士哉。","book":"《史记·张仪列传》"}},{"id":6679,"word":"倾吐衷肠","pinyin":"qīng tǔ zhōng cháng","abbr":"qtzc","explanation":"完全吐露出内心的真实思想或心理状态。","example":{"text":"她很想跟你～。"},"similar":["倾心吐胆"],"usage":"作谓语、宾语、定语；指倾诉"},{"id":6680,"word":"倾囊倒箧","pinyin":"qīng náng dào qiè","abbr":"qndq","explanation":"把大小箱子里的东西都倒出来。比喻全部倒出来。","source":{"text":"不上一年，倾囊倒箧，骗得一空。","book":"明·冯梦龙《警世通言》第24卷"},"example":{"text":"曾朴《孽海花》第15回：“虽都无成效，却消费了无数金钱，历年运动来的资本已～了。”"},"similar":["倾箱倒箧","倾筐倒庋","倾筐倒箧"],"usage":"作谓语、状语；比喻全部倒出来"},{"id":6681,"word":"倾囊相助","pinyin":"qīng náng xiāng zhù","abbr":"qnxz","explanation":"囊：口袋。把衣袋里所有的钱都拿出来帮助别人。","source":{"text":"梅闻之泣下，但求怜拯，女思良久，曰：‘无已，我私蓄数金，当倾囊相助。’梅拜谢，因潜告张。","book":"清·蒲松龄《聊斋志异·青梅》"}},{"id":6682,"word":"倾国倾城","pinyin":"qīng guó qīng chéng","abbr":"qgqc","explanation":"倾：倾覆；城：国。原指因女色而亡国。后多形容妇女容貌极美。","source":{"text":"北方有佳人，绝世而独立，一顾倾人城，再顾倾人国。","book":"《诗·大雅·瞻卬》：“哲夫成城，哲妇倾城。”《汉书·外戚传》"},"example":{"text":"一个太真妃～。","book":"元·白朴《梧桐雨》第一折"},"similar":["倾城倾国","国色天香","出水芙蓉"],"opposite":["奇丑无比"],"usage":"作谓语、定语；用于女性","story":["汉朝时期，中山李氏兄妹三人到京城长安发展，李延年进入皇宫乐府，他向汉武帝推荐他妹妹是绝世佳人，一见倾城，再顾倾国。汉武帝十分高兴就召见李延年的妹妹并封她为夫人，生下昌邑王刘贺，汉武帝十分宠爱这个绝色夫人"]},{"id":6683,"word":"倾城倾国","pinyin":"qīng chéng qīng guó","abbr":"qcqg","explanation":"倾：倾覆；城：国。原指因女色而亡国。后多形容妇女容貌极美。","source":{"text":"北方有佳人，绝世而独立，一顾倾人城，再顾倾人国。","book":"东汉·班固《汉书·外戚传下·孝武李夫人》"},"example":{"text":"所谓～者，盖一城一国之人皆倾心而爱悦之。","book":"宋·袁文《瓮牖闲评》第二卷"},"similar":["绝色佳人","倾国倾城"],"usage":"作谓语、定语；用于女性","story":["汉朝中山李氏兄妹三人到京城长安发展，李延年进入皇宫乐府，他向汉武帝推荐他妹妹是绝世佳人，一见倾城，再顾倾国。汉武帝十分高兴就召见李延年的妹妹并封她为夫人，生下昌邑王刘贺，汉武帝十分宠爱这个绝色夫人"]},{"id":6684,"word":"倾城而出","pinyin":"qīng chéng ér chū","abbr":"qcec","explanation":"倾城：全城人。全城人一齐出动。比喻人的数量很多。","source":{"text":"倾城远追送，钱我千里道。","book":"晋·林子荆《征西官属送于陟阳侯作》"},"example":{"text":"葑门荷宕天启壬戌六月二十四日，偶至苏州，见士女～，毕集于葑门外之荷花宕。","book":"明·张岱《陶庵梦忆·硚园》"}},{"id":6685,"word":"倾家尽产","pinyin":"qīng jiā jìn chǎn","abbr":"qjjc","explanation":"倾：倒出。丧失全部家产。","source":{"text":"故富者则倾家尽产，贫者举假贷贵，专买生口以赎其妻。","book":"《魏略》"},"similar":["倾家竭产","倾家破产"],"usage":"作谓语、定语、补语；指破产"},{"id":6686,"word":"倾家破产","pinyin":"qīng jiā pò chǎn","abbr":"qjpc","explanation":"拿出或丧失掉全部家产。","source":{"text":"倾家破产，急士之穷，轻身下气，而交名胜。","book":"宋·陈师道《序》"},"example":{"text":"因为那孤儿加入了保卫团，于是杨家便给予一个严重的宗法上的制裁，叫他～。","book":"郭沫若《少年时代·黑猫》"},"similar":["倾家荡产"],"usage":"作谓语、定语、补语；指破产"},{"id":6687,"word":"倾家竭产","pinyin":"qīng jiā jié chǎn","abbr":"qjjc","explanation":"倾：倒出；竭：用尽，弄光。全部家产都被弄光了。","source":{"text":"货殖之家，侯服玉食，婚姻葬送，倾家竭产。","book":"《三国志·蜀志·董和传》"},"similar":["倾家荡产","倾家尽产"],"usage":"作谓语、定语、补语；指破产"},{"id":6688,"word":"倾家荡产","pinyin":"qīng jiā dàng chǎn","abbr":"qjdc","explanation":"倾：倒出；荡：扫除，弄光。全部家产都被弄光了。","source":{"text":"货殖之家，侯服玉食，婚姻葬送，倾家竭产。","book":"《三国志·蜀书·董和传》"},"example":{"text":"匪徒们眼瞪着他们的大锅盔，～。","book":"曲波《林海雪原》三十"},"similar":["一贫如洗","家徒四壁"],"opposite":["兴家立业"],"usage":"作谓语、定语、状语；指破产"},{"id":6689,"word":"倾家败产","pinyin":"qīng jiā bài chǎn","abbr":"qjbc","explanation":"全部家产都被弄光了。同“倾家荡产”。","source":{"text":"为这点小事弄的人家倾家败产，也不算什么能为！","book":"清·曹雪芹《红楼梦》第48回"},"similar":["倾家荡产","倾家竭产","荡产倾家"],"usage":"作谓语、定语、补语；指破产"},{"id":6690,"word":"倾巢出动","pinyin":"qīng cháo chū dòng","abbr":"qccd","explanation":"倾：倒出；巢：巢穴。比喻敌人出动全部兵力进行侵扰。","source":{"text":"哪怕是一点最小的风吹草动，触及了蛛丝牵动了蛛网，便会立刻引起这座巨大巢穴里的蜘蛛们的倾巢出动。","book":"罗广斌《红岩》第六章"},"example":{"text":"敌人～，刚好中了我军的埋伏。"},"similar":["倾巢而出"],"usage":"作谓语；指出动全部兵力"},{"id":6691,"word":"倾巢而出","pinyin":"qīng cháo ér chū","abbr":"qcec","explanation":"倾：倒出；巢：巢穴。比喻敌人出动全部兵力进行侵扰。","source":{"text":"由是倾巢举落，望德如归。","book":"南朝·梁·沈约《齐故安陆昭王碑文》"},"example":{"text":"平日不大出门的人，这两天也都～。（端木蕻良《曹雪芹》第十二章）"},"similar":["不遗余力","倾城而出"],"opposite":["按兵不动"],"usage":"作谓语；指出动全部兵力"},{"id":6692,"word":"倾心吐胆","pinyin":"qīng xīn tǔ dǎn","abbr":"qxtd","explanation":"比喻痛快地说出了心里话。","source":{"text":"怕不待倾心吐胆商量嫁，都是些瞒神諕鬼求食话。","book":"元·杨显之《酷寒亭》第一折"},"example":{"text":"这里别无外人，方可～，对哥哥说。","book":"明·施耐庵《水浒全传》第十四回"},"similar":["开诚相见","倾心露胆"],"usage":"作状语；指真心待人"},{"id":6693,"word":"倾心露胆","pinyin":"qīng xīn lù dǎn","abbr":"qxld","explanation":"倾心：竭尽忠诚。形容待人竭尽诚心。","source":{"text":"次日又排筵宴，各各倾心露胆，讲说平生之怀。","book":"明·施耐庵《水浒传》第82回"},"similar":["倾心吐胆"],"usage":"作状语；指真心待人"},{"id":6694,"word":"倾抱写诚","pinyin":"qīng bào xiě chéng","abbr":"qbxc","explanation":"指推诚相待。","source":{"text":"君既习于祁公，又与诸君倾抱写诚，契合无间。","book":"清·曾国藩《苗先簏墓志铭》"},"usage":"作谓语；用于人际关系"},{"id":6695,"word":"倾摇懈弛","pinyin":"qīng yáo xiè chí","abbr":"qyxc","explanation":"心绪不宁，精神懈怠。","source":{"text":"倾摇懈弛无忧且勤之心。","book":"宋·曾巩《送李材叔知柳州序》"}},{"id":6696,"word":"倾柯卫足","pinyin":"qīng kē wèi zú","abbr":"qkwz","explanation":"指善于保护自己。","source":{"text":"葵倾叶向日，以蔽其根。","book":"《左传·成公十七年》：“仲尼曰：‘鲍庄子之知不如葵，葵犹能卫其足。’”杜预注"},"example":{"text":"《梁书·刘孝绰传》：“臣不能衔珠避颠，～，以兹疏幸，与物多忤。”"},"usage":"作谓语、宾语；用于比喻句"},{"id":6697,"word":"倾注全力","pinyin":"qīng zhù quán lì","abbr":"qzql","explanation":"倾注：把精神或力量集中到一个目标。把所有力量集中在一个目标。","source":{"text":"以便等到时机一到，就倾注全力，大举反攻，收复失地。","book":"毛泽东《关于国际新形势对新华日报记者的谈话》"},"example":{"text":"我在这门功课上已经～了。"},"similar":["全神贯注"],"usage":"作谓语；指集中精力"},{"id":6698,"word":"倾盆大雨","pinyin":"qīng pén dà yǔ","abbr":"qpdy","explanation":"雨大得象盆里的水直往下倒。形容雨大势急。","source":{"text":"白帝城中云出门，白帝城下雨翻盆。","book":"唐·杜甫《白帝》诗"},"example":{"text":"烟拥层峦云拥腰，～定明朝。","book":"宋·苏轼《雨意》诗"},"similar":["大雨如柱","大雨滂沱"],"opposite":["细雨霏霏"],"usage":"作主语、宾语、定语；比喻下大雨"},{"id":6699,"word":"倾盖之交","pinyin":"qīng gài zhī jiāo","abbr":"qgzj","explanation":"盖：古车篷；倾盖：停车。指一见如故的朋友。","source":{"text":"误认倾盖之交，遂罹丧资之祸。","book":"清·蒲松龄《聊斋志异·念秧》"},"usage":"作主语、宾语；指朋友"},{"id":6700,"word":"倾盖如故","pinyin":"qīng gài rú gù","abbr":"qgrg","explanation":"偶然结识的新朋友却像友谊深厚的旧故交一样。","source":{"text":"语曰：‘白头如新，倾盖如故。’何则？知与不知也。","book":"汉·邹阳《狱中上书自明》"},"example":{"text":"两个也可谓‘～’的极了。","book":"清·西周生《醒世姻缘传》第六回"}},{"id":6701,"word":"倾筐倒庋","pinyin":"qīng kuāng dào guǐ","abbr":"qkdg","explanation":"庋，放东西的架子。把大小箱子里的东西全部倾倒出来。比喻全部拿出来或彻底翻检。","source":{"text":"王家见二谢，倾筐倒庋；见汝辈来，平平尔；汝可无烦复往。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"similar":["倾筐倒箧","倾囊倒箧"],"usage":"作谓语、状语；比喻全部倒出来","story":["东晋丞相王导给太尉郗鉴的女儿做媒，把侄儿王羲之介绍给她。郗鉴亲自上王羲之家，别人指着东床坦腹的那个就是。谢安、谢万经常去郗鉴家玩，郗鉴倾筐倒箧地款待他们，而对“话不投机半句多”的两个妻舅却比较冷淡"]},{"id":6702,"word":"倾筐倒箧","pinyin":"qīng kuāng dào qiè","abbr":"qkdq","explanation":"把大小箱子里的东西全部倾倒出来。比喻全部拿出来或彻底翻检。","source":{"text":"王家见二谢，倾筐倒庋；见汝辈来，平平尔；汝可无烦复往。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"许把来意～说完了，心头仿佛松快一点。","book":"叶圣陶《感同身受》"},"similar":["倾箱倒箧","倾筐倒庋","倾囊倒箧"],"usage":"作谓语、状语；比喻全部倒出来","story":["东晋丞相王导给太尉郗鉴的女儿做媒，把侄儿王羲之介绍给她。郗鉴亲自上王羲之家，别人指着东床坦腹的那个就是。谢安、谢万经常去郗鉴家玩，郗鉴倾筐倒箧地款待他们，而对“话不投机半句多”的两个妻舅却比较冷淡"]},{"id":6703,"word":"倾箱倒箧","pinyin":"qīng xiāng dào qiè","abbr":"qxdq","explanation":"箧：小箱子。把大小箱子里的东西都倒出来。比喻全部拿出来或彻底翻脸。","source":{"text":"王家见二谢，倾筐倒庋，见汝辈来，平平尔；汝可无烦复往。","book":"南朝宋·刘义庆《世说新语·贤媛》"},"example":{"text":"急得陈大郎性发，～的寻个遍，只是不见，便破口骂老婆起来。","book":"明·冯梦龙《古今小说》卷一"},"similar":["倾筐倒箧","倾囊倒箧"],"usage":"作谓语、状语；比喻全部倒出来"},{"id":6704,"word":"倾耳侧目","pinyin":"qīng ěr cè mù","abbr":"qecm","explanation":"倾耳：侧过耳朵倾听；侧目：斜眼而看。侧着耳朵听，斜着眼睛看。形容畏惧的样子。","source":{"text":"妻侧目而视，倾耳而听。","book":"《战国策·秦策一》"},"example":{"text":"今者先帝新弃万国，天子始亲政事，当海内～之秋，而相公实为社稷柱石莫先之臣。","book":"宋·苏洵《上韩昭文论山陵书》"}},{"id":6705,"word":"倾耳戴目","pinyin":"qīng ěr dài mù","abbr":"qedm","explanation":"戴目：仰视的样子，指望着远处。形容期待、盼望的样子。","source":{"text":"北地残氓，东都遗老，莫不茹泣吞悲，倾耳戴目，翘心仁政，延首王风。","book":"南朝·齐·王融《画汉武北伐图上疏》"},"example":{"text":"南朝·齐·王融《画汉武北伐图上疏》：“北地残氓，东都遗老，莫不茹泣吞悲，～。”"},"similar":["戴目倾耳"],"usage":"作谓语、状语；用于书面语"},{"id":6706,"word":"倾耳拭目","pinyin":"qīng ěr shì mù","abbr":"qesm","explanation":"倾耳：侧着耳朵；拭目：擦眼睛。认真听，仔细看。表示急切想看到所期待的事物。","source":{"text":"今天子以盛年初即位，天下莫不拭目倾耳，观化听风。","book":"《汉书·张敞传》"},"example":{"text":"恭惟陛下龙飞御极之初，天下～之时，所当戒者，惟嗜好而已。","book":"宋·陆游《上殿札子》"},"similar":["倾耳注目"],"usage":"作谓语、定语、状语；指关心的事物"},{"id":6707,"word":"倾耳注目","pinyin":"qīng ěr zhù mù","abbr":"qezm","explanation":"注目：集中视线注意看。原形容权势极大，为众敬畏。后也形容注意力极其集中。","source":{"text":"夫能使天下倾耳注目者，当权者是矣，故谋能移主，威能慑下。","book":"晋·陈寿《三国志·魏志·陈思王植传》"},"example":{"text":"大家都～地听着他的报告。"},"similar":["倾耳拭目"],"usage":"作谓语、定语、状语；指关心的事物"},{"id":6708,"word":"倾耳细听","pinyin":"qīng ěr xì tīng","abbr":"qext","explanation":"侧耳留意而听。","example":{"text":"不绝如缕的音乐从窗外传进来，～，原来是月光曲。"}},{"id":6709,"word":"倾耳而听","pinyin":"qīng ěr ér tīng","abbr":"qeet","explanation":"倾：歪，侧着。侧着耳朵仔细听。","source":{"text":"倾耳而听之，不可得而闻也。","book":"《礼记·孔子闲居》"},"example":{"text":"民皆引领而望，～，悲号仰天，叩心而怨上，故陈胜大呼，天下响应。","book":"《史记·淮南衡山列传》"},"usage":"作谓语；指仔细听"},{"id":6710,"word":"倾肝沥胆","pinyin":"qīng gān lì dǎn","abbr":"qgld","explanation":"形容对人极其忠诚。","source":{"text":"倾肝沥胆谢不敏，岂可便恃张良才。","book":"宋·梅尧臣《闻密赐》"},"similar":["披肝沥胆"],"usage":"作谓语、状语；指非常忠诚"},{"id":6711,"word":"倾肠倒肚","pinyin":"qīng cháng dào dǔ","abbr":"qcdd","explanation":"比喻把心里的话全都讲出来。","source":{"text":"圣人肚肠，更无许多廉纤缠绕，丝来线去。","book":"《朱子语录》"},"similar":["倾肠倒腹"],"usage":"作状语；指讲心里话"},{"id":6712,"word":"倾肠倒腹","pinyin":"qīng cháng dào fǔ","abbr":"qcdf","explanation":"倾：倒出。将埋藏在心底里的话全部讲出来。比喻痛快地说出了心里话。","source":{"text":"唯孤胁兴化，亦乃克宾受辱，若是临济儿孙，终不依草附木，资福喜见，同参今日，倾肠倒腹。","book":"宋·释普济《五灯会元·乌巨行禅师法嗣》"},"similar":["倾肠倒肚"],"usage":"作状语；指讲心里话"},{"id":6713,"word":"倾身营救","pinyin":"qīng shēn yíng jiù","abbr":"qsyj","explanation":"比喻尽所有的力量设法去援救。","source":{"text":"刺史陶谦举茂才，不应，谦以为轻己，遂见拘执。昱倾身营救，方以得免。","book":"《三国志·吴志·张昭传》"},"example":{"text":"乡里有忧患者，淑辄～，为州闾所称。","book":"《后汉书·贾淑传》"}},{"id":6714,"word":"偃兵修文","pinyin":"yǎn bīng xiū wén","abbr":"ybxw","explanation":"停止武事，振兴文教。同“偃武修文”。","source":{"text":"陛下亮成天工，克济大业，偃兵修文，群帅反旅。","book":"《后汉书·杜诗传》"},"similar":["偃武修文"],"usage":"作谓语、宾语、定语；指停止战斗"},{"id":6715,"word":"偃兵息甲","pinyin":"yǎn bīng xī jiǎ","abbr":"ybxj","explanation":"放倒武器，收起盔甲。指停止战斗。","source":{"text":"于是偃兵息甲，修立文学。","book":"后魏·高允《片士颂》"},"similar":["偃武修文"],"usage":"作谓语、宾语；用于书面语"},{"id":6716,"word":"偃旗仆鼓","pinyin":"yǎn qí pú gǔ","abbr":"yqpg","explanation":"原指行军时隐蔽行踪，不让敌人觉察。现比喻事情终止或声势减弱。同“偃旗息鼓”。","source":{"text":"偃旗仆鼓，寂若无气，严戢兵士，敢哗者斩。","book":"宋·苏洵《权书·法制》"},"similar":["偃旗卧鼓","偃旗息鼓"],"usage":"作谓语、定语、宾语；比喻停止斗争等"},{"id":6717,"word":"偃旗卧鼓","pinyin":"yǎn qí wò gǔ","abbr":"yqwg","explanation":"原指行军时隐蔽行踪，不让敌人觉察。现比喻事情终止或声势减弱。同“偃旗息鼓”。","source":{"text":"及贼前锋次江口，僧辩乃命众军，乘城固守，偃旗卧鼓，安若无人。","book":"《梁书·王僧辩传》"},"example":{"text":"慎列树三棚，相去数里，～。于中栅声鼓，三栅悉兵以击，贼众大乱。","book":"《旧唐书·伊慎传》"},"similar":["偃旗仆鼓","偃旗息鼓"],"usage":"作谓语、定语、宾语；比喻停止斗争等"},{"id":6718,"word":"偃旗息鼓","pinyin":"yǎn qí xī gǔ","abbr":"yqxg","explanation":"偃：仰卧，引伸为倒下。放倒旗子，停止敲鼓。原指行军时隐蔽行踪，不让敌人觉察。现比喻事情终止或声势减弱。","source":{"text":"云入营，更大开门，偃旗息鼓，公军疑云有伏兵，引去。","book":"《三国志·蜀书·赵云传》裴松之注引《赵云别传》"},"example":{"text":"秦显家的听了，轰去了魂魄，垂头丧气，登时～，卷包而去。","book":"清·曹雪芹《红楼梦》第六十二回"},"similar":["销声匿迹"],"opposite":["大张旗鼓","重整旗鼓"],"usage":"作谓语、定语、宾语；比喻停止斗争等","story":["三国时期，刘备派老将黄忠率兵去袭击曹操的粮草大军，被曹操包围，赵云前去解围，被曹操追杀。赵云兵少势弱，他敞开营门，偃旗息鼓，只身站在营门口，曹操怕中计就撤退，被赵云的士兵伏击，赵云趁机追击，把曹军打得大败"]},{"id":6719,"word":"偃武休兵","pinyin":"yǎn wǔ xiū bīng","abbr":"ywxb","explanation":"停息武备，不事战争。同“偃武息戈”。","source":{"text":"今讲好已定，两宫天眷，不日可还；偃武休兵，可期岁月。","book":"宋·岳飞《乞解军务第三札子》"},"similar":["偃武息戈","偃武櫜兵"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6720,"word":"偃武修文","pinyin":"yǎn wǔ xiū wén","abbr":"ywxw","explanation":"偃：停止；修：昌明，修明。停止武事，振兴文教。","source":{"text":"王来自商，至于丰，乃偃武修文。","book":"《尚书·武成》"},"example":{"text":"乃～，归马于华山之阳，放牛于桃林之野，以示天下大服。","book":"明·许仲琳《封神演义》第九十八回"},"similar":["国泰民安","天下太平"],"opposite":["兵荒马乱","烽火连天"],"usage":"作谓语、宾语、定语；指停止战斗"},{"id":6721,"word":"偃武兴文","pinyin":"yǎn wǔ xīng wén","abbr":"ywxw","explanation":"偃：停止；兴：振兴。停止武事，振兴文教。","source":{"text":"王来自商，至于丰，乃偃武修文。","book":"《尚书·武成》"},"example":{"text":"太尉官罢久矣，丞相兼之，所以～也。","book":"《汉书·黄霸传》"},"similar":["偃武行文","偃武修文","偃兵修文"],"usage":"作谓语、宾语、定语；指停止战斗"},{"id":6722,"word":"偃武崇文","pinyin":"yǎn wǔ chóng wén","abbr":"ywcw","explanation":"停息武备，崇尚文教。","source":{"text":"国朝偃武崇文，偏舍来久，州镇兵人，或有雄勇，不闲武艺。","book":"《魏书·咸阳王禧传》"},"similar":["偃武修文","偃革尚文"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6723,"word":"偃武息戈","pinyin":"yǎn wǔ xī gē","abbr":"ywxg","explanation":"停息武备，不事战争。","source":{"text":"嚣（隗嚣）不及此时推危乘胜，以争天命，而退欲为西伯之事，尊章句，宾友处士，偃武息戈，卑辞事汉，喟然自以文王复出也。","book":"《后汉书·公孙述传》"},"similar":["偃武休兵"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6724,"word":"偃武櫜兵","pinyin":"yǎn wǔ gāo bīng","abbr":"ywgb","explanation":"停息武备，不事战争。同“偃武息戈”。","source":{"text":"偃武櫜兵，唯文是恤。","book":"《北史·高允传》"},"similar":["偃武息戈","偃武休兵"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6725,"word":"偃武行文","pinyin":"yǎn wǔ xíng wén","abbr":"ywxw","explanation":"停止武事，振兴文教。同“偃武修文”。","source":{"text":"今陛下能偃武行文，不复用兵乎？","book":"《史记·留侯世家》"},"example":{"text":"冀闻‘康哉’之歌，～之美。","book":"三国·魏·曹植《陈审举表》"},"similar":["偃武兴文","偃武修文"],"usage":"作谓语、宾语、定语；指停止战斗"},{"id":6726,"word":"偃武觌文","pinyin":"yǎn wǔ dí wén","abbr":"ywdw","explanation":"停止武事，振兴文教。同“偃武修文”。","source":{"text":"偃武觌文，风行四国。","book":"清·李振裕《祠阙里雅》"},"similar":["偃武修文","偃武行文","偃兵修文"],"usage":"作谓语、宾语、定语；指停止战斗"},{"id":6727,"word":"偃甲息兵","pinyin":"yǎn jiǎ xī bīng","abbr":"yjxb","explanation":"甲：古代作战时穿的护身服。兵：兵器。停止战争。"},{"id":6728,"word":"偃革为轩","pinyin":"yǎn gé wéi xuān","abbr":"ygwx","explanation":"指停息武备，修治文教。","source":{"text":"革者，革车也；轩者，赤黻乘轩也。偃武备而治礼乐也。","book":"《史记·留侯世家》：“殷事已毕，偃革为轩，倒置兵戈，覆以虎皮，以示天下不复用兵。”裴駰集解引如淳曰"},"similar":["偃革尚文"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":6729,"word":"偃革倒戈","pinyin":"yǎn gé dǎo gē","abbr":"ygdg","explanation":"指停息武备，不事战争。","source":{"text":"偃革倒戈，归马放牛，乃灭殷以后事；今楚汉相持，正是兵锋之交，而言及此，曾不顾其为迂，何也？","book":"元·刘壎《隐居通议·经史一》"},"similar":["偃兵息甲"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6730,"word":"偃革尚文","pinyin":"yǎn gé shàng wén","abbr":"ygsw","explanation":"停息武备，注重文教。","source":{"text":"穆宗初，两河底定，俛与段文昌当国，谓四方无虞，遂议太平事，以为武不可黩，劝帝偃革尚文。","book":"《新唐书·萧俛传》"},"similar":["偃武崇文","偃武修文"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":6731,"word":"偃鼠饮河","pinyin":"yǎn shǔ yǐn hé","abbr":"ysyh","explanation":"比喻所需极有限。","source":{"text":"偃鼠饮河，不过满腹。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"所谓～，不过满腹者也。","book":"清·夏敬渠《野叟曝言》第148回"},"usage":"作宾语、定语；比喻所需极有限"},{"id":6732,"word":"假人假义","pinyin":"jiǎ rén jiǎ yì","abbr":"jrjy","explanation":"伪装仁慈善良。","source":{"text":"明明他心里也巴不得杀了安德海，偏是嘴里假人假义。","book":"高阳《玉座珠帘》下册"}},{"id":6733,"word":"假人辞色","pinyin":"jiǎ rén cí sè","abbr":"jrcs","explanation":"指好言好语、和颜悦色地待人。","source":{"text":"老钱柜子很少这么假人辞色。","book":"吴祖光《闯江湖》第二幕"},"similar":["假以辞色"],"usage":"作谓语；指和颜悦色地待人"},{"id":6734,"word":"假仁假义","pinyin":"jiǎ rén jiǎ yì","abbr":"jrjy","explanation":"伪装仁慈善良。","source":{"text":"汉高祖私意分数少，唐太宗一切假仁假义以行其私。","book":"《朱子全书·历代一·唐》"},"example":{"text":"他第一便想抢曾乡绅的家，那暴发的绅士，～的，好不可恶！","book":"郑振铎《黄公俊的最后》"},"similar":["虚情假义"],"opposite":["肝胆相照","坦诚相待"],"usage":"作定语、状语、宾语；指假装仁义"},{"id":6735,"word":"假仁假意","pinyin":"jiǎ rén jiǎ yì","abbr":"jrjy","explanation":"伪装仁慈，其实内心奸恶。","example":{"text":"这个～，阴险毒辣的伪君子表面上很诚恳，但心里却另有一套。"}},{"id":6736,"word":"假仁纵敌","pinyin":"jiǎ rén zòng dí","abbr":"jrzd","explanation":"假：假装；纵：放任。假施仁义，放纵敌人。后指姑息养奸，酿成祸患。","source":{"text":"君子不重伤，不禽二毛，古之为军也，不以阻碍也，寡人虽亡国之余，不鼓不成列。","book":"《左传·僖公二十二年》"},"example":{"text":"我们千万不能～。"},"usage":"作谓语、宾语、定语；指给自己招致祸患","story":["春秋时期，宋襄公十分羡慕霸主齐桓公，自己也想称霸。于是带兵去攻打郑国。楚国立即出兵救郑。宋军面对混乱不堪的楚军，宋襄公没有采纳大臣司马子鱼趁混乱消灭楚军的建议，坚持光明正大地作战，结果被打败，自己客死他乡"]},{"id":6737,"word":"假以辞色","pinyin":"jiǎ yǐ cí sè","abbr":"jycs","explanation":"假：给；辞：言辞；色：神色。指好言好语、和颜悦色地对待。","source":{"text":"贞甫为人伉厉，喜自修饰，介介自持，非其人未尝假以辞色。","book":"宋·陈亮《与章德茂侍郎书》：“彼亦知世间有所谓人品者，门下岂亦以此假之辞色哉？”明·归有光《沈贞甫墓志铭》"},"example":{"text":"叫他传了那厨子来当一次差，我们在旁边～，逐细盘问他，怕问不出来？（清·吴趼人《二十年目睹之怪现状》第四十六回）"},"similar":["假人辞色"],"usage":"作谓语；指好言好语、和颜悦色待人"},{"id":6738,"word":"假传圣旨","pinyin":"jiǎ chuán shèng zhǐ","abbr":"jcsz","explanation":"比喻假借上峰的旨意去达到自己的目的。","source":{"text":"他们假传圣旨，说是奉了第三厅厅长郭沫若的命令搜查书店。","book":"郭沫若《洪波曲·反推进》"}},{"id":6739,"word":"假公济私","pinyin":"jiǎ gōng jì sī","abbr":"jgjs","explanation":"假：借；济：帮助。假借公家的名义，谋取私人的利益。","source":{"text":"他假公济私，我怎肯和他干罢了也呵！","book":"《汉书·杜业传》：“方进终不举白，专作威福，阿党所厚，排挤英俊，托公报私，横厉无所畏忌。”元·无名氏《陈州粜米》第一折"},"example":{"text":"现在那些招摇撞骗，～的玩意儿太多了。","book":"欧阳山《三家巷》二六"},"similar":["损公肥私"],"opposite":["公事公办","大公无私"],"usage":"作谓语、定语、状语；指损公肥私"},{"id":6740,"word":"假公营私","pinyin":"jiǎ gōng yíng sī","abbr":"jgys","explanation":"假借公家的名义，谋取私人的利益。同“假公济私”。","source":{"text":"照得近年以来，在外诸司不详站赤生受指，以进表为由，假公营私，滥行给驿。","book":"《元典章·礼部一·进表》"},"example":{"text":"应该先从他们开刀：渎职，贪污，～，忘了公仆的身份。","book":"臧克家《裁员》诗"},"similar":["假公济私"],"opposite":["公事公办"],"usage":"作谓语、宾语、定语；指假公济私"},{"id":6741,"word":"假力于人","pinyin":"jiǎ lì yú rén","abbr":"jlyr","explanation":"借别人的力量做事。","source":{"text":"耻假力于人，誓手剑以屠黑卵。","book":"《列子·汤问》"},"similar":["假手于人"],"usage":"作谓语；借别人的力量做事"},{"id":6742,"word":"假名托姓","pinyin":"jiǎ míng tuō xìng","abbr":"jmtx","explanation":"假、托：假借。假冒别人的姓名。","source":{"text":"燕燕怎敢假名托姓。","book":"元·关汉卿《调风月》第三折"},"example":{"text":"俺哥哥不是这般的人，多有依草附木，～的在外头胡做。","book":"明·施耐庵《水浒全传》第七十三回"},"similar":["冒名顶替"],"usage":"作谓语、宾语；指冒名"},{"id":6743,"word":"假天假地","pinyin":"jiǎ tiān jiǎ dì","abbr":"jtjd","explanation":"假天：指开天窗；假地：在室内架阁板。开天窗为室内增添光线，架阁板为子女安顿住处。形容居住条件恶劣，生活窘迫。","source":{"text":"贫者以室不露明，上安油瓦，以窃微光。又或四邻局寒暑，则半空架板版，叠垛箱筥，分寝儿女，故有假天假地之称。","book":"宋·陶谷《清异录·居室》"}},{"id":6744,"word":"假情假意","pinyin":"jiǎ qíng jiǎ yì","abbr":"jqjy","explanation":"虚假的情意，不是真心实意。","example":{"text":"请收起你的～。"},"similar":["虚情假意","假情假义"],"usage":"作状语、宾语、定语；指虚假的情意"},{"id":6745,"word":"假惺惺","pinyin":"jiǎ xīng xīng","abbr":"jxx","explanation":"假心假意的样子。","source":{"text":"想当日，楚屈原，假惺惺醉倒步兵厨。","book":"元·乔孟符《金钱记》第一折"},"example":{"text":"赫尔利～地跳到延安来，显然是心怀叵测的。","book":"方纪《挥手之间》"},"similar":["假心假意"],"usage":"作状语、定语；指假心假意的样子"},{"id":6746,"word":"假意撇清","pinyin":"jiǎ yì piē qīng","abbr":"jypq","explanation":"假意：假装。本不清高，却故意自命清高。","source":{"text":"兰花便在朱十老面前，假意撇清说：‘小官人几番调戏，好不老实。’","book":"明·冯梦龙《醒世恒言》卷三"},"example":{"text":"若是你一定不肯受，那就倒反不是真心和我要好，好像是假意撇清的了。","book":"清·张春帆《九尾龟》第一百六十八回"}},{"id":6747,"word":"假意虚情","pinyin":"jiǎ yì xū qíng","abbr":"jyxq","explanation":"虚：假。装着对人热情，不是真心实意。","source":{"text":"大圣假意虚情，相陪相笑，没奈何，也与他相倚相偎。","book":"明·吴承恩《西游记》第六十回"},"example":{"text":"秋谷看了暗中好笑，想他们堂子里头的妓女惯会做出一番的～。","book":"清·张春帆《九尾龟》第四十一回"}},{"id":6748,"word":"假慈悲","pinyin":"jiǎ cí bēi","abbr":"jcb","explanation":"慈悲：慈善，怜悯。表面上装出一付慈爱怜悯的样子。","source":{"text":"他一点没有假慈悲的伪君子的色彩。","book":"毛泽东《论鲁迅》"},"example":{"text":"明·伏雌教主《醋葫芦》第三回：“我道昨日为何劈空～，将甚么鸟儿我吃，自又不吃。”"},"opposite":["大慈大悲"],"usage":"作谓语、定语、宾语；用于处事"},{"id":6749,"word":"假戏真做","pinyin":"jiǎ xì zhēn zuò","abbr":"jxzz","explanation":"指戏演得逼真或把假的事情当作真的来做。","source":{"text":"表演的所以能感动人，就是因为演员的诚恳，所谓‘假戏真做’。","book":"洪深《电影戏剧表演术》第三章"},"example":{"text":"你们同台跳过《罗密欧与朱丽叶》，如果～，可是有损名声？","book":"丛维熙《第十个弹孔》"},"usage":"作谓语、宾语；用于做事"},{"id":6750,"word":"假手于人","pinyin":"jiǎ shǒu yú rén","abbr":"jsyr","explanation":"假：利用。借助别人来为自己办事。","source":{"text":"今虽三弟早死，门户泯绝，而娥亲犹在，岂可假手于人哉！","book":"晋·皇甫谧《烈女传》"},"example":{"text":"至于～，也合各有一件事敷奏，食禄于朝，岂当如是！","book":"《旧五代史·晋书·高祖纪》"},"similar":["假公济私","假手旁人"],"opposite":["公而忘私"],"usage":"作谓语、定语；指借助别人的行为","story":["古代福禄县赵君安被恶霸李寿杀害，他的三个儿子因瘟疫而死。报仇的重任落到女儿赵娥亲身上。李寿见赵家无男丁就开始放松了警惕。赵娥亲想尽快报仇，她对人说自己父母之仇不共戴天，报仇之事绝不假手于人。后来她亲自手刃了仇人李寿"]},{"id":6751,"word":"假手旁人","pinyin":"jiǎ shǒu páng rén","abbr":"jspr","explanation":"假：利用。借助别人来为自己办事。","source":{"text":"诸将谓布曰：‘将军常欲杀刘备，今可假手于术。’","book":"《尚书·伊训》：“于其子孙弗率，皇天降灾，假手于我有命。”《后汉书·吕布传》"},"example":{"text":"本部院凡事秉公办理，从不～。","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["假手于人"],"usage":"作谓语、定语；指借助别人的行为"},{"id":6752,"word":"假模假式","pinyin":"jiǎ mó jiǎ shì","abbr":"jmjs","explanation":"模、式：模样、姿态。指故意做作，故做姿态。","source":{"text":"装模作样，恼吾气满胸膛。","book":"宋·史浩《荆钗记传奇》"},"example":{"text":"我和你说句心里话，我还就是看不惯那些～的“谦虚”。","book":"周梅森《中国制造》第三章"}},{"id":6753,"word":"假物为用","pinyin":"jiǎ wù wéi yòng","abbr":"jwwy","explanation":"假：借。借助外物，为自己所用。"},{"id":6754,"word":"假痴不癫","pinyin":"jiǎ chī bù diān","abbr":"jcbd","explanation":"痴：傻，呆；癲：疯癫，癫狂。假装呆傻，实际并不疯癫。形容外表看似愚钝，而心里却十分清醒。","source":{"text":"当其机未发时，静屯似痴；若假癲，则不但露机，且乱动而群疑；故假痴者胜，假癲者败。","book":"《三十六计》第二十七计"},"usage":"作谓语、定语；用于为人"},{"id":6755,"word":"假痴假呆","pinyin":"jiǎ chī jiǎ dāi","abbr":"jcjd","explanation":"装傻；假装糊涂。","source":{"text":"我有要紧事体请耐来，啥个假痴假呆！","book":"《海上花列传》第48回"},"example":{"text":"她自己隐瞒了两匹次布，还～地向人家做报告。","book":"陆文夫《荣誉》"},"similar":["装疯卖傻"],"usage":"作谓语、状语；指装傻"},{"id":6756,"word":"假眉三道","pinyin":"jiǎ méi sān dào","abbr":"jmsd","explanation":"方言。装模作样。","source":{"text":"地头蛇本来一窍不通，可是为了在丈人跟前装门面，也只好假眉三道的胡应承。","book":"马烽、西戎《吕梁英雄传》第九回"},"example":{"text":"燕燕赌着气坐起来说：‘分明是按老封建规矩办事，偏要叫人～去出洋相。’","book":"赵树理《登记》"},"similar":["装模作样"],"usage":"作定语、状语；用于方言"},{"id":6757,"word":"假虎张威","pinyin":"jiǎ hǔ zhāng wēi","abbr":"jhzw","explanation":"假：借。借别人的声威恫吓他人。","source":{"text":"费尽他机和智，只是要贪名固位，假虎张威。","book":"明·胡文焕《群音类选·忠孝记·欲进谏章》"},"example":{"text":"臣愚不敢请，似这等大恶，～，毒痡四海，助桀为虐，使居天子左右，将来不知如何结局。","book":"明·许仲琳《封神演义》第二十八回"},"similar":["狐假虎威"],"usage":"作谓语、宾语；指狐假虎威"},{"id":6758,"word":"假誉驰声","pinyin":"jiǎ yù chí shēng","abbr":"jycs","explanation":"指没有真才实学，靠互相吹捧扬名。","source":{"text":"比来举荐，多不以才，假誉驰声，互相推奖。","book":"《旧唐书·薛登传》"},"usage":"作宾语；指传播虚假的名声"},{"id":6759,"word":"假越救溺","pinyin":"jiǎ yuè jiù nì","abbr":"jyjn","explanation":"假：借助；溺：被水淹。原指到很远的越国请善游水的人来救溺水的孩子。比喻行动适应不了紧急的需要。","source":{"text":"昔有假人于越而救溺子，越人虽善游，子必不生矣。","book":"《韩非子·说林上》"}},{"id":6760,"word":"假途灭虢","pinyin":"jiǎ tú miè guó","abbr":"jtmg","explanation":"假：借；途：道路；虢：春秋时诸侯国，在今山西平陆及河南三门峡一带。泛指用借路的名义而灭亡这个国家。","source":{"text":"晋荀息请以屈产之乘，与垂棘之璧，假道于虞以伐虢。","book":"《左传·僖公二年》"},"example":{"text":"此乃“～”之计也。虚名收川，实限荆州。","book":"明·罗贯中《三国演义》第五十六回"},"similar":["假道灭虢"],"usage":"作谓语、定语；指用借路的名义而消灭这个国","story":["春秋时期，晋献公要向虞国借路去攻打虢国，同时给虞国送去宝马和贵重礼物。虞国国君贪财，大夫宫之奇劝阻说：“虢国是虞国的近邻，它的灭亡必然会导致虞国灭亡。”虞国君主不听劝谏，答应晋军过境，结果晋国灭掉虢国立即灭虞"]},{"id":6761,"word":"假道灭虢","pinyin":"jiǎ dào miè guó","abbr":"jdmg","explanation":"假：借；道：道路；虢：春秋时诸侯国，在今山西平陆及河南三门峡一带。泛指用借路的名义而灭亡这个国家。","source":{"text":"晋荀息请以屈产之乘，与垂棘之璧，假道于虞以伐虢。","book":"春秋·鲁·左丘明《左传·僖公二年》"},"example":{"text":"你要注意他～的把戏。"},"similar":["假途灭虢"],"usage":"作谓语、定语；指用借路的名义而消灭这个国","story":["春秋时期，晋献公要向虞国借路去攻打虢国，同时给虞国送去宝马和贵重礼物。虞国国君贪财，大夫宫之奇劝阻说：“虢国是虞国的近邻，它的灭亡必然会导致虞国灭亡。”虞国君主不听劝谏，答应晋军过境，结果晋国灭掉虢国立即灭虞"]},{"id":6762,"word":"假金方用真金镀","pinyin":"jiǎ jīn fāng yòng zhēn jīn dù","abbr":"jjfyzjd","explanation":"方：才。假的金子才用真真镀。比喻只有假的或劣质的东西才需装饰，以冒充真的或质量好的。","source":{"text":"假金方用真金镀，若是真金不镀金。十载长安得一第,何须空腹用高心。","book":"唐·李绅《答章孝标》"}},{"id":6763,"word":"假门假事","pinyin":"jiǎ mén jiǎ shì","abbr":"jmjs","explanation":"做得像真的一样。","source":{"text":"我的女儿好咬文嚼字，信耶稣，好办个慈善事业，有点假门假事的。","book":"曹禺《日出》第二幕"},"similar":["假门假氏"],"usage":"作宾语、定语；指做得像真的一样"},{"id":6764,"word":"假门假氏","pinyin":"jiǎ mén jiǎ shì","abbr":"jmjs","explanation":"做得像真的一样。同“假门假事”。","source":{"text":"林柄下了轿子，假门假氏地要让老师先走。","book":"《括苍山恩仇记》第七回"},"similar":["假门假事"],"usage":"作状语、定语；指做得像真的一样"},{"id":6765,"word":"假阶救火","pinyin":"jiǎ jiē jiù huǒ","abbr":"jjjh","explanation":"假：借；阶：梯子。比喻做事不讲效率，做事机械。","source":{"text":"赵成阳堪，其宫火，欲灭之，无阶可升。","book":"《燕书》"},"usage":"作宾语、定语；指做事不分轻重缓急","story":["古代赵国人成阳堪家房子着了火，让儿子成阳肭去奔水家借梯子，成阳肭则慢条斯理来到奔水家，跟随主人缓步登堂赴宴。奔水问他来意，他这才说家里着火想借梯子去救火。奔水直骂他迂腐，立即命人带上梯子去救火，到达时成家只剩下一片灰烬了"]},{"id":6766,"word":"偎干就湿","pinyin":"wēi gàn jiù shī","abbr":"wgjs","explanation":"形容母亲抚育幼儿之辛苦。指幼儿溺床，母亲宁可以身就湿，使小儿卧处常干。","source":{"text":"且休说怀耽十月，只从小偎干就湿，几口气抬举他偌大，便恰似燕子衔食。","book":"元·无名氏《冻苏秦》第二折"},"example":{"text":"说不的，成日反你耽心儿来看。《金瓶梅词话》第五九回"},"similar":["推干就湿"],"usage":"作谓语、宾语、定语；多用于母亲"},{"id":6767,"word":"偎慵堕懒","pinyin":"wēi yōng duò lǎn","abbr":"wydl","explanation":"犹言懒惰，偷懒。","source":{"text":"我想他在俺家做了二十年夫婿，每日家偎慵堕懒，生理不做，今日做了官，就眼高了。","book":"元·无名氏《渔樵记》第三折"},"usage":"作谓语、定语；用于书面语"},{"id":6768,"word":"偎红倚翠","pinyin":"wēi hóng yǐ cuì","abbr":"whyc","explanation":"指亲狎女色；狎妓。","source":{"text":"李煜在国，微行娼家，遇一僧张席，煜遂为不速之客。僧酒令、讴吟、吹弹莫不高了……。煜乘醉大书右壁曰：浅斟低唱偎红倚翠大师鸳鸯寺主，传持风流教法。","book":"宋·陶榖《清异录·偎红倚翠大师》"},"example":{"text":"～初承领，羡他名士悦倾城，这都是圣祖神宗与证盟。","book":"清·蒋士铨《冬青树·梦报》"},"similar":["偎香倚玉"],"usage":"作谓语、定语；指玩弄妓女","story":["南唐时期，后主李煜有偎红倚翠大师的称号，一次他微服去妓院，见一僧人正在妓院，自己倒成了不速之客，那僧人酒令、吟唱、吹弹十分出色，李煜十分喜欢，两人谈得十分投机，于是乘醉大书“浅斟低唱偎红倚翠大师鸳鸯寺主，传持风流教法。”"]},{"id":6769,"word":"偎香倚玉","pinyin":"wēi xiāng yǐ yù","abbr":"wxyy","explanation":"偎：紧贴；依：靠着。指玩弄妓女。","source":{"text":"一笑情通，傍柳随花，偎香倚玉，弄月抟风。","book":"元·徐琰《青楼十咏·初见》"},"similar":["偎红倚翠"],"usage":"作谓语、定语；指玩弄妓女"},{"id":6770,"word":"偏三向四","pinyin":"piān sān xiàng sì","abbr":"psxs","explanation":"指偏向、袒护某方。","source":{"text":"这叫什么话？我们偏三向四啦？","book":"马烽 西戎《吕梁英雄传》第三十回"},"example":{"text":"如果有一点～的，定要争呀吵呀地闹意见。","book":"西戎《纠纷》"},"usage":"作谓语、宾语；用于偏袒"},{"id":6771,"word":"偏乡僻壤","pinyin":"piān xiāng pì rǎng","abbr":"pxpr","explanation":"指荒凉偏僻的地方。","source":{"text":"兹查通都大邑，剪辫者已多，至偏乡僻壤，留辫者尚复不少。","book":"孙中山《大总统令内务部晓示人民一律剪辫文》"},"opposite":["通都大邑"],"usage":"作主语、宾语、定语；指荒凉地"},{"id":6772,"word":"偏信则暗","pinyin":"piān xìn zé àn","abbr":"pxza","explanation":"偏信：只听信一方面的话；暗：糊涂。只听信一方面的话，就不能明辨是非。","source":{"text":"君之所以明者，兼听也；其所以暗者，偏信也。","book":"汉·王符《潜夫论·明暗》"},"opposite":["兼听则明"],"usage":"作宾语、定语；指不能明辨是非"},{"id":6773,"word":"偏听偏信","pinyin":"piān tīng piāng xìn","abbr":"ptpx","explanation":"偏面地听了一方面的话就信以为真。多指处理事情的态度不公正。","source":{"text":"君之所以明者，兼听也；其所以暗者，偏信也。","book":"汉·王符《潜夫论·明暗》"},"example":{"text":"他总是乐于听取大家的意见，从不～。"},"similar":["偏信偏听"],"opposite":["兼听则明"],"usage":"作谓语、定语；指处事的态度","story":["唐太宗李世民任命魏征做宰相，他问魏征怎样才能成为贤明皇帝。魏征说尧舜善于听取多方面的意见，所以就贤明，能保住天下；他又说秦二世、梁武帝和隋炀帝偏听偏信，不去了解真实情况，所以就亡国。唐玄宗认为言之有理"]},{"id":6774,"word":"偏听偏言","pinyin":"piān tīng piān yán","abbr":"ptpy","explanation":"偏：只注重一方面。只听信一方面，指处理问题态度不公正，方法不妥当。","source":{"text":"君之所以明者，兼听也；其所以暗者，偏信也。","book":"汉·王符《潜夫论·明暗》"},"similar":["偏听则暗"],"opposite":["兼听则明"],"usage":"作谓语、宾语；指处事的态度"},{"id":6775,"word":"偏安一隅","pinyin":"piān ān yī yú","abbr":"payy","explanation":"偏安：偷安；隅：角落。在残存的一片土地上苟且偷安。","source":{"text":"先帝虑汉贼不两立，王业不偏安，故托臣以讨贼也。","book":"晋·陈寿《三国志·蜀志·诸葛亮传》裴松之注引《汉晋春秋》"},"example":{"text":"赖尔岳飞竭力勤王，尽心捍御，得以～。","book":"清·钱彩《说岳全传》第47回"},"similar":["苟且偷安"],"usage":"作谓语、宾语；用于国土沦丧时"},{"id":6776,"word":"偏怀浅戆","pinyin":"piān huái qiǎn gàng","abbr":"phqg","explanation":"偏怀：胸怀偏窄；浅：浅陋；戆：愚拙。指心思偏窄，浅陋愚拙。","source":{"text":"周瑜小子，偏怀浅戆，自负其能，辄欲以卵敌石；兼之擅作威福，无罪受刑，有功不赏。","book":"明·罗贯中《三国演义》第四十七回"},"example":{"text":"东方将吏，无有愚智，皆知其不可，唯周瑜鲁肃～，意未解耳。","book":"蔡东蕃《后汉演义》第八十四回"},"usage":"作谓语、定语；用于为人"},{"id":6777,"word":"偕生之疾","pinyin":"xié shēng zhī jí","abbr":"xszj","explanation":"偕生：与生俱来。先天性的疾病。","source":{"text":"今有偕生之疾，与体偕长，今为汝攻之何如？","book":"《列子·汤问》"},"similar":["先天不足"],"usage":"作宾语；指先天性的疾病"},{"id":6778,"word":"做一天和尚撞一天钟","pinyin":"zuò yī tiān hé shàng zhuàng yī tiān zhōng","abbr":"zythszytz","explanation":"俗语。过一天算一天，凑合着混日子。比喻遇事敷衍，得过且过。也有无可奈何，勉強从事的意思。","source":{"text":"我们做一天和尚撞一天钟，只要不像从前那位老中堂，摆在面上被人家骂什嚒卖国贼，我就得了。","book":"清·李宝嘉《文明小史》第四十四回"},"example":{"text":"敷衍了事，得过且过，～。","book":"毛泽东《反对自由主义》"},"similar":["得过且过"],"opposite":["忠于职守"],"usage":"作谓语、宾语、定语、分句；指不负责任"},{"id":6779,"word":"做一日和尚撞一天钟","pinyin":"zuò yī rì hé shàng zhuàng yī tiān zhōng","abbr":"zyrhszytz","explanation":"俗语。比喻遇事敷衍，得过且过。也有无可奈何，勉強从事的意思。","source":{"text":"留着我中甚么用！也不过像俗语说的，‘做一日和尚撞一日钟’罢了！就是拼性命去干，现在的事也是弄不好的。","book":"清·李宝嘉《官场现形记》第二十五回"},"example":{"text":"人活着要有理想，有作为，切不可做一日和尚撞一天钟。"}},{"id":6780,"word":"做一日和尚撞一日钟","pinyin":"zuò yī rì hé shàng zhuàng yī rì zhōng","abbr":"zyrhszyrz","explanation":"俗语。比喻遇事敷衍，得过且过。也有无可奈何，勉強从事的意思。","source":{"text":"行者方丢了钟杵，笑道：‘你那时晓得，我这是做一日和尚撞一日钟的。’","book":"明·吴承恩《西游记》第十六回"},"example":{"text":"常言道：‘～，往后贞节轮不到你身上了。’","book":"《金瓶梅词话》第二十六回"},"similar":["做一天和尚撞一天钟"],"usage":"作谓语、宾语、定语、分句；指不负责任"},{"id":6781,"word":"做人做世","pinyin":"zuò rén zuò shì","abbr":"zrzs","explanation":"指在社会上立身行事。","source":{"text":"咱们来到这震南农场，原来不是想跟它做人做世，厮守一辈了的。","book":"欧阳山《三家巷》二四：“咱俩都快要走进社会——做人做世了，你怎么还只管任性胡来呢！”又《苦斗》六一"},"similar":["做人做事"],"usage":"作谓语、定语；用于处事"},{"id":6782,"word":"做人做事","pinyin":"zuò rén zuò shì","abbr":"zrzs","explanation":"指在社会上立身处世。","source":{"text":"咱俩都快要走进社会——做人做事了，你怎么还只管任性胡来呢！","book":"欧阳山《三家巷》"},"similar":["立身处世"],"usage":"作谓语、宾语、定语；用于处世"},{"id":6783,"word":"做刚做柔","pinyin":"zuò gāng zuò róu","abbr":"zgzr","explanation":"指用各种方法进行劝说。","source":{"text":"那禁子们做刚做柔的的解劝。","book":"《醒世姻缘传》第五回：“又叫宅里再暖出一大瓶酒来与脚户吃，做刚做柔的将脚户打发散去。”又第四三回"},"similar":["做好做歹","做歉做好"],"usage":"作谓语、定语；指装作好人或坏人"},{"id":6784,"word":"做好做恶","pinyin":"zuò hǎo zuò è","abbr":"zhze","explanation":"假装做好人或恶人，以事应付。","source":{"text":"两个公人，一路上做好做恶，管押了行。","book":"《水浒传》第六二回"},"usage":"作谓语；用于处事"},{"id":6785,"word":"做好做歹","pinyin":"zuò hǎo zuò dǎi","abbr":"zhzd","explanation":"犹言好说歹说。指用各种方法进行劝说。","source":{"text":"陆秉义见刘二打得凶，和谢胖子做好做歹，反他劝的去了。","book":"《金瓶梅词话》第九九回"},"example":{"text":"叔齐只得接了瓦罐，～的硬劝伯夷喝了一口半。","book":"鲁迅《故事新编·采薇》"},"similar":["作好作歹","做歉做好","做刚做柔"],"usage":"作谓语、定语；指装作好人或坏人"},{"id":6786,"word":"做小伏低","pinyin":"zuò xiǎo fú dī","abbr":"zxfd","explanation":"形容低声下气，巴结奉承。","source":{"text":"你只是装着做小伏低，你若是得空偷闲便择离。","book":"元·无名氏《莽张飞大闹石榴园》第一折"},"example":{"text":"若召到蜀中，以部曲待之，刘备安肯～。","book":"明·罗贯中《三国演义》第六十回"},"similar":["低声下气","做小服低"],"usage":"作谓语、定语；指甘居人下"},{"id":6787,"word":"做小服低","pinyin":"zuò xiǎo fú dī","abbr":"zxfd","explanation":"形容低声下气，甘居人下。","source":{"text":"一方面是芙蓉柔顺，甘于做小服低。","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"你难道就一辈子这样～下去吗？"},"similar":["做小伏低"],"usage":"作谓语、定语；指甘居人下"},{"id":6788,"word":"做张做势","pinyin":"zuò zhāng zuò shì","abbr":"zzzs","explanation":"装模作样，故意做出一种姿态。","source":{"text":"那些有势有力的不肯出钱，专要讨人便宜。及至肯出几两银子的，女儿又嫌好道歉，做张做智的不肯。","book":"语出《醒世恒言·卖油郎独占花魁》"},"example":{"text":"[蒋淑真]梳个纵鬓头儿，着件叩身衫子，～，乔模乔样。","book":"《醒世通言蒋淑真刎颈鸳鸯会》"},"similar":["装模作样","虚张声势","装腔作势"],"opposite":["本来面目"],"usage":"作谓语、定语；指装模作样"},{"id":6789,"word":"做张做智","pinyin":"zuò zhāng zuò zhì","abbr":"zzzz","explanation":"犹言装模作样，装腔作势。","source":{"text":"那些有势有力的不肯出钱，专要讨人便宜。及至肯出几两银子的，女儿又嫌好道歉，做张做智的不肯。","book":"《醒世恒言·卖油郎独占花魁》"},"example":{"text":"[阮小七]提着双拳说道：“我老爷在此吃几杯酒儿，干你鸟事！～要来拿我！”","book":"《水浒传》第一回"},"similar":["做张做势","装模作样"],"opposite":["一本正经","本来面目"],"usage":"作谓语；指装模作样"},{"id":6790,"word":"做张做致","pinyin":"zuò zhāng zuò zhì","abbr":"zzzz","explanation":"犹言装模作样，装腔作势。","source":{"text":"那些有势有力的不肯出钱，专要讨人便宜。及至肯出几两银子的，女儿又嫌好道歉，做张做智的不肯。","book":"语出《醒世恒言·卖油郎独占花魁》"},"example":{"text":"沈琼枝看那两个妇人时，一个二十六七岁光景，一个十七八岁，乔素打扮，～的。","book":"清·吴敬梓《儒林外史》第四十一回"},"similar":["做张做智","装模作样","作张作致"],"opposite":["本来面目"],"usage":"作谓语、状语；指装模作样"},{"id":6791,"word":"做歉做好","pinyin":"zuò qiàn zuò hǎo","abbr":"zqzh","explanation":"比喻用各种理由或方式反复劝说。","source":{"text":"众人做歉做好，劝了他们回去。","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"similar":["做好做歹","做刚做柔"],"usage":"作谓语、定语；指装作好人或坏人"},{"id":6792,"word":"做眉做眼","pinyin":"zuò méi zuò yǎn","abbr":"zmzy","explanation":"摆脸色。","example":{"text":"他最爱～给别人看。"},"similar":["挤眉弄眼"],"usage":"作谓语、宾语；指做脸色"},{"id":6793,"word":"做神做鬼","pinyin":"zuò shén zuò guǐ","abbr":"zszg","explanation":"指鬼鬼祟祟；使用欺骗的手段。","source":{"text":"既这么样，怎么不进来，以做神做鬼的？","book":"《红楼梦》第四七回"},"example":{"text":"张家是甚么有意思的人！想起我前日这一番是非，那里是甚么光棍！就是他的佃户，商议定了，～，来弄送我。","book":"《儒林外史》第四回"},"similar":["装神弄鬼","做鬼做神"],"usage":"作谓语、定语；用于处事"},{"id":6794,"word":"做贼心虚","pinyin":"zuò zéi xīn xū","abbr":"zzxx","explanation":"虚：怕。指做了坏事怕人知道，心里老是不安。","source":{"text":"却顾侍者云：‘适来有人看方丈么？’侍者云：‘有。’师云：‘作贼人心虚。’","book":"宋·释悟明《联灯会要·重显禅师》"},"example":{"text":"一切违法乱纪者都是～，他们损害国家和群众的利益，见不得阳光。"},"similar":["作贼心虚","贼胆心虚"],"opposite":["问心无愧","心安理得","理直气壮"],"usage":"作谓语、定语、状语；指理亏心虚"},{"id":6795,"word":"做鬼做神","pinyin":"zuò guǐ zuò shén","abbr":"zgzs","explanation":"鬼鬼祟祟；使用欺骗的手段。","source":{"text":"商议定了，做鬼做神，来弄送我。","book":"清·吴敬梓《儒林外史》第四回"},"similar":["做神做鬼"],"usage":"作谓语、定语；用于处事"},{"id":6796,"word":"停云落月","pinyin":"tíng yún luò yuè","abbr":"tyly","explanation":"表示对亲友的怀念（旧时多用在书信里）。","source":{"text":"落月满屋梁，犹疑照颜色。","book":"晋·陶潜《停云诗序》：“停云，思亲友也。”唐·杜甫《梦李白》诗"},"usage":"作谓语；常用于书信中"},{"id":6797,"word":"停传常满","pinyin":"tíng chuán cháng mǎn","abbr":"tccm","explanation":"停传：馆舍。馆舍里经常住满客人。形容交游广泛，应接不暇。","source":{"text":"俾夜作昼，星言夙驾，送往迎来，停传常满。","book":"三国·魏·徐干《中论》"}},{"id":6798,"word":"停僮葱翠","pinyin":"tíng tóng cōng cuì","abbr":"ttcc","explanation":"停僮：枝叶茂密；葱翠：苍绿色。形容树木枝叶十分茂密。","source":{"text":"尔乃搫场拄翳，停僮葱翠。","book":"晋·潘岳《射雉赋》"}},{"id":6799,"word":"停妻再娶","pinyin":"tíng qī zài qǔ","abbr":"tqzq","explanation":"有妻并未离异，又与人正式结婚。","source":{"text":"员外，你不回家来，原来在这里，做个停妻再娶妻。我和你见官去。","book":"元·杨景贤《刘行首》第三折"},"example":{"text":"据我看来，这人年纪虽觉得大些，然究竟现居官场，断不敢干那～和明妻暗妾的事。","book":"清·无名氏《官场维新记》第十一回"},"usage":"作谓语、定语；指重婚"},{"id":6800,"word":"停工待料","pinyin":"tíng gōng dài liào","abbr":"tgdl","explanation":"停止生产，等待原料。","source":{"text":"五月十五日，上海日本第七纱厂停工待料。","book":"陶菊隐《北洋军阀统治时期史话》第68章"},"example":{"text":"在～期间，我们安排工人检修机器。"},"usage":"作谓语、宾语、定语；指等待材料"},{"id":6801,"word":"停滞不前","pinyin":"tíng zhì bù qián","abbr":"tzbq","explanation":"滞：滞留。停止下来，不继续前进。","source":{"text":"凡百学问，莫不发源于上右，而或则逐渐发达，或则停滞不前，彼停滞焉者，必有为之阻力者也。","book":"清·梁启超《生计学学说沿革小史》"},"example":{"text":"社会是发展的、进步的，决不会～，或者倒退。"},"similar":["畏缩不前","踌躇不前"],"opposite":["锐意进取","马不停蹄"],"usage":"作谓语、宾语、定语；指不继续前进"},{"id":6802,"word":"停留长智","pinyin":"tíng liú zhǎng zhì","abbr":"tlzz","explanation":"指事情耽搁久了，就会想出主意来。","source":{"text":"常言道‘停留长智’。那妖精倘或今晚不睡，把师父害了，却如之何？","book":"明·吴承恩《西游记》第91回"},"example":{"text":"我们快去，千万别让他～。"},"usage":"作谓语；指事情耽搁久了会想出主意来"},{"id":6803,"word":"停瞋息怒","pinyin":"tíng chēn xī nù","abbr":"tcxn","explanation":"瞋：发怒时睁大眼睛。停止发怒和生气。多用作劝说，停息恼怒之辞。","source":{"text":"夫人休闪了手，且息怒停瞋，听红娘说。","book":"元·王实甫《西厢记》第四本第二折"},"example":{"text":"经过我好一番折腾，他终算～了"},"similar":["息怒停瞋"],"usage":"作谓语、定语；用于处事"},{"id":6804,"word":"停辛伫苦","pinyin":"tíng xīn zhù kǔ","abbr":"txzk","explanation":"停：止息，停留；伫：贮积。辛劳长期缠身。形容经历了不少艰难困苦。","source":{"text":"栀子交加香蓼繁，停辛伫苦留待君。","book":"唐·李商隐《河内诗二首》之一"},"usage":"联合式；作谓语；指历尽艰辛"},{"id":6805,"word":"停辛贮苦","pinyin":"tíng xīn zhù kǔ","abbr":"txzk","explanation":"辛劳长期缠身。形容经历了不少艰难困苦。同“停辛伫苦”。","source":{"text":"及读意大利建国史，而观其千回百折、停辛贮苦、吞酸茹险之状，自设身以当此境，度未有不索然气沮。","book":"梁启超《意大利建国三杰传·结论》"},"similar":["停辛伫苦"],"usage":"作谓语；指历尽艰辛"},{"id":6806,"word":"停阴不解","pinyin":"tíng yīn bù jiě","abbr":"tybj","explanation":"停阴：集结不散的阴云；解：散开。集结着的阴云一直不散开。形容久雨不晴。","source":{"text":"停阴结不解，通衢化为渠。","book":"晋·陆机《赠尚书郎顾彦先二首》其二"}},{"id":6807,"word":"健步如飞","pinyin":"jiàn bù rú fēi","abbr":"jbrf","explanation":"健步：脚步快而有力。步伐矫健，跑得飞快。","source":{"text":"丽人牵坐路侧，自乃捉足，脱履相假。女喜着之，幸不凿枘，复起从行，健步如飞。","book":"清·蒲松龄《聊斋志异·凤阳士人》"},"example":{"text":"他走起路来～。"},"similar":["急若流星","大步流星"],"opposite":["姗姗来迟","慢条斯理","步履艰难"],"usage":"作谓语、定语；形容步伐快"},{"id":6808,"word":"偭规越矩","pinyin":"miǎn guī yuè jǔ","abbr":"mgyj","explanation":"偭：违背；越：逾越；规、矩：一定的标准、法则和习惯。违反正常的法则。","source":{"text":"固时俗之工巧兮，偭规矩而改错。","book":"战国·楚·屈原《离骚》"},"example":{"text":"西洋习俗如此，教士～，亦犹中国僧道之不能尽守戒律。","book":"清·薛福成《分别教案治本治标计疏》"},"similar":["偭规错矩"],"usage":"作谓语、定语；指违背改变正常的法则"},{"id":6809,"word":"偭规错矩","pinyin":"miǎn guī cuò jǔ","abbr":"mgcj","explanation":"偭：违背；规、矩：标准、法则和习惯。指违背改变正常的法则。","source":{"text":"固时俗之工巧兮，偭规矩而改错。","book":"战国·楚·屈原《楚辞·离骚》"},"example":{"text":"西洋习俗如此，教士～，亦犹中国僧道之不能尽守戒律。","book":"清·薛福成《分别教案治本治标之计疏》"},"similar":["偭规越矩"],"usage":"作谓语、定语；指违背改变正常的法则"},{"id":6810,"word":"偶一为之","pinyin":"ǒu yī wéi zhī","abbr":"oywz","explanation":"偶：偶尔；为：做。指平常很少这样做，偶尔才做一次。","source":{"text":"若夫纵而来归而赦之，可偶一为之尔。","book":"宋·欧阳修《纵囚论》"},"example":{"text":"但我以为这些方法，也只能随时随地，～，难以多做。","book":"鲁迅《书信集·致赖少祺》"},"similar":["逢场作戏","蜻蜓点水"],"opposite":["勤学苦练","韦编三绝"],"usage":"作谓语、宾语、分句；表示偶尔做一次"},{"id":6811,"word":"偶变投隙","pinyin":"ǒu biàn tóu xì","abbr":"obtx","explanation":"犹言投机取巧。指用不正当的手段谋取私利。也指靠小聪明占便宜。","source":{"text":"每观今时偶变投隙之士，操数寸之管，书方尺之纸，无不拾取青紫为宗族荣耀。","book":"宋·秦观《谢王学士书》"},"usage":"作宾语、定语；指人处事"},{"id":6812,"word":"偶影独游","pinyin":"ǒu yǐng dú yóu","abbr":"oydy","explanation":"偶：配偶，伴侣。以影为伴，独自游览。比喻孤单。","source":{"text":"春服既成，景物斯和，偶影独游，欣慨交心。","book":"晋·陶潜《时运·序》"},"usage":"作谓语；指孤单"},{"id":6813,"word":"偶烛施明","pinyin":"ǒu zhú shī míng","abbr":"ozsm","explanation":"偶：双；施：施行。两支蜡烛大放光明。比喻两种事物相得益彰。","source":{"text":"尧舜之德，譬犹偶烛施明于幽室也，前烛照之，后烛益明，非前烛昧，后烛彰也，乃二烛相因而成大光。","book":"汉·王符《潜夫论》"},"usage":"作宾语、定语；用于两者之间"},{"id":6814,"word":"偶语弃市","pinyin":"ǒu yǔ qì shì","abbr":"oyqs","explanation":"偶语：二人相对私语；弃市：古刑罚，将犯人处死后将尸体暴露于街头示众。指在封建暴政下，人们相聚谈话就会被杀害。","source":{"text":"有敢偶语《诗》、《书》者，弃市。","book":"《史记·秦始皇本纪》"},"example":{"text":"一时期新疆变成了一个～，到处监狱的恐怖世界。","book":"陶菊隐《北洋军阀统治时期史话》第八十章注"},"usage":"作宾语、定语；用于书面语"},{"id":6815,"word":"偷东摸西","pinyin":"tōu dōng mō xī","abbr":"tdmx","explanation":"指小偷小摸。","source":{"text":"那个弟子孩，不似好人，偷东摸西，打发他去了吧。","book":"元·无名氏《村乐堂》第二折"},"example":{"text":"自小里～，揣歪捏怪，胡行乱走，不老实。","book":"明·无名氏《拨宅飞升》楔子"},"similar":["小偷小摸"],"usage":"作谓语、宾语、定语；指小偷"},{"id":6816,"word":"偷偷摸摸","pinyin":"tōu tōu mō mō","abbr":"ttmm","explanation":"形容瞒着别人做事，不敢让别人知道。","source":{"text":"偏咱们就这样丁是丁卯是卯的，只许你们偷偷摸摸的哄骗了去。","book":"清·曹雪芹《红楼梦》第73回"},"example":{"text":"敌人汉奸派遣反革命特务分子～地钻入共产党、八路军、新四军内施行破坏工作。","book":"毛泽东《质问国民党》"},"similar":["鬼鬼祟祟"],"opposite":["光明正大"],"usage":"作宾语、定语、状语；指行为放不开","story":["大观园内发现绣春囊，邢夫人立即组织庞大的检查团进行逐个搜查。迎春的乳母王住儿的儿媳妇因聚赌被抓，她们来求迎春说情，迎春是个懦弱的人，没有给她们帮忙。于是王住儿家的就大发牢骚说她们被偷偷摸摸的哄骗了去，因为邢姑娘的原因才会这样"]},{"id":6817,"word":"偷合取容","pinyin":"tōu hé qǔ róng","abbr":"thqr","explanation":"奉承迎合别人，使自己能苟且地生活下去。同“偷合苟容”。","source":{"text":"偷合取容，以至圽身。","book":"《史记·白起王翦列传论》"},"similar":["偷合苟容"],"usage":"作谓语、定语；指迎合别人","story":["战国末期，秦国逐步消灭了六国，统一了中国，大将白起与王翦起了举足轻重的作用，白起用兵如神威震天下，后因不能迎合秦王与范雎被逼自杀。王翦则在统一大功告成时偷合取容，告老还乡，被秦王封为武成侯，安享天年"]},{"id":6818,"word":"偷合苟从","pinyin":"tōu hé gǒu cóng","abbr":"thgc","explanation":"指苟且迎合以取悦于人。亦作“偷合取容”。","source":{"text":"偷合苟从，未肯极言，朕甚闵焉。","book":"东汉·班固《汉书·元帝纪》"},"usage":"作谓语、定语；用于书面语"},{"id":6819,"word":"偷合苟容","pinyin":"tōu hé gǒu róng","abbr":"thgr","explanation":"偷：苟且。奉承迎合别人，使自己能苟且地生活下去。","source":{"text":"不恤君之荣辱，不恤国之藏否，偷合苟容，以持禄养交而已耳，谓之国贼。","book":"《荀子·臣道》"},"example":{"text":"尔曹昔为相国，位极人臣，贪欲无厌，求利不止，～。","book":"明·赵弼《丹景报应录》"},"similar":["偷合取容"],"usage":"作谓语、定语；指奉承迎合"},{"id":6820,"word":"偷声细气","pinyin":"tōu shēng xì qì","abbr":"tsxq","explanation":"指轻声轻气。","source":{"text":"啥话？看你偷声细气的样子！","book":"柳青《创业史》第一部题叙"},"similar":["轻声细气"],"usage":"作定语、状语；用于处事"},{"id":6821,"word":"偷天妙手","pinyin":"tōu tiān miào shǒu","abbr":"ttms","explanation":"偷天：形容本领神奇；妙手：指有才能的人。形容写作技巧娴熟，文笔非常优美，富有独创性的作家、艺术家。","source":{"text":"能凿壁，会悬梁，偷天妙手绣文章。","book":"明·汤显祖《牡丹亭·言怀》"}},{"id":6822,"word":"偷天换日","pinyin":"tōu tiān huàn rì","abbr":"tthr","explanation":"比喻暗中改变事物的真相，以达到蒙混欺骗的目的。","source":{"text":"且说尹子崇自从做了这一番偷天换日的大事业，等到银子到手，便把原有的股东一齐写信去招呼。","book":"清·李宝嘉《官场现形记》第五十三回"},"example":{"text":"他所玩弄的～的鬼把戏，早被大家识破了。"},"similar":["移花接木","弄虚作假","偷梁换柱"],"opposite":["正大光明"],"usage":"作谓语、定语；指欺骗"},{"id":6823,"word":"偷奸取巧","pinyin":"tōu jiān qǔ qiǎo","abbr":"tjqq","explanation":"用投机取巧的办法不付出力气而得到好处。","example":{"text":"别只顾～，干点实事吧。"},"similar":["投机取巧"],"usage":"作谓语、宾语、定语；指投机"},{"id":6824,"word":"偷媚取容","pinyin":"tōu mèi qǔ róng","abbr":"tmqr","explanation":"巧黠谄媚以取悦于人。","source":{"text":"并偷媚取容，实名教之罪人也。","book":"唐·张鷟《朝野佥载·张岌》"},"usage":"作谓语、定语；用于处事","story":["唐朝武周时期，官场腐败，到处是偷媚取容的人，最为典型的是张岌为了取悦武则天的情人薛师和尚，亲自拿着黄绢跟随薛师之后，遇到薛师要上马时就匍匐在地当马镫。还有侍御史郭霸亲自品尝来俊臣的粪便，宋之问为张易之捧便桶等等"]},{"id":6825,"word":"偷安旦夕","pinyin":"tōu ān dàn xī","abbr":"tadx","explanation":"偷安：苟且求安；旦夕：早晚，形容时间短。只图眼前的一时安逸。","source":{"text":"若偷安旦夕，迷而不反，大兵一发，玉石俱碎。","book":"三国魏·钟会《移蜀将吏士檄》"},"similar":["苟且偷生"],"usage":"作谓语、宾语、定语；指只图眼前的一时安逸"},{"id":6826,"word":"偷安苟且","pinyin":"tōu ān gǒu qiě","abbr":"tagq","explanation":"偷安：只图眼前的安逸；苟且：得过且过。只顾眼前的安逸，不顾将来。","source":{"text":"承晏安太平之后，苟且偷安，昧于远图，政令日弛，法度日隳。","book":"宋·汪应辰《文定集·廷试策》"},"example":{"text":"正当示之以形势，庶几乎激忠起懦，而三四大帅者，亦不敢怀～之心。","book":"清·毕沅《续资治通鉴》卷一百十七"},"similar":["苟且偷安"],"usage":"作谓语、宾语、定语；用于处事"},{"id":6827,"word":"偷寒送暖","pinyin":"tōu hán sòng nuǎn","abbr":"thsn","explanation":"暗里照顾寒暖。比喻奉承拍马。也比喻对人关切。","source":{"text":"枉骂他偷寒送暖小奴才，要这般当面抢白。","book":"元·白朴《墙头马上》第二折"},"example":{"text":"这些宦官宫妾，见皇后有些偏向，自然～，添嘴搠舌。","book":"清·禇人获《隋唐演义》第二回"},"similar":["问寒问暖"],"opposite":["不闻不问","漠不关心","置之不理"],"usage":"作谓语、定语；比喻对人关切"},{"id":6828,"word":"偷工减料","pinyin":"tōu gōng jiǎn liào","abbr":"tgjl","explanation":"原指商人为了牟取暴利而暗中降低产品质量，削减工料。现也指做事图省事，马虎敷衍。","source":{"text":"演戏作寿，受贿贪赃；侵冒钱粮，偷工减料。","book":"清·文康《儿女英雄传》第十三回"},"example":{"text":"不过在这书店都～的时候，这本却还可以说是一部印得较好的书。","book":"鲁迅《书信集·致孙用》"},"similar":["敷衍了事"],"opposite":["一丝不苟","精雕细刻"],"usage":"作谓语、定语、状语；指马虎敷衍"},{"id":6829,"word":"偷懒耍滑","pinyin":"tōu lǎn shuǎ huá","abbr":"tlsh","explanation":"指有意逃避、耍弄手段使自己少出力或不担责任。","source":{"text":"做这种事谁也不再提平常他们最看重的工分问题，更没有人偷懒耍滑。","book":"路遥《平凡的世界》第一卷第26章"},"similar":["投机取巧"],"usage":"作谓语、宾语、定语；用于处事"},{"id":6830,"word":"偷梁换柱","pinyin":"tōu liáng huàn zhù","abbr":"tlhz","explanation":"比喻暗中玩弄手法，以假代真，以劣代优。","source":{"text":"偏偏凤姐想出一条偷梁换柱之计，自己也不好过潇湘馆来，竟未能少尽姊妹之情，真真可怜可叹。","book":"清·曹雪芹《红楼梦》第九十七回"},"example":{"text":"他采取～的手法，将别人的科研成果据为己有。"}},{"id":6831,"word":"偷狗戏鸡","pinyin":"tōu gǒu xì jī","abbr":"tgxj","explanation":"比喻不务正业。","source":{"text":"那里承望到如今生下这些畜生来，每日家偷狗戏鸡，爬灰的爬灰，养小叔子的养小叔子。","book":"清·曹雪芹《红楼梦》第七回"}},{"id":6832,"word":"偷狗捉鸡","pinyin":"tōu gǒu zhuō jī","abbr":"tgzj","explanation":"指偷窃的行为。也指不正经的勾当。","source":{"text":"小人如今在此，只做得些偷鸡盗狗的勾当，几时是了；跟随的二位哥哥上山去，却不好？","book":"明·施耐庵《水浒全传》第四十六回"}},{"id":6833,"word":"偷猫盗狗","pinyin":"tōu māo dào gǒu","abbr":"tmdg","explanation":"指偷窃。也指不正当的男女关系。","source":{"text":"既作绿林大盗，便与那偷猫盗狗的不同，也断不肯悄悄儿的下来。","book":"清·文康《儿女英雄传》第11回"},"similar":["偷鸡盗狗","偷鸡摸狗"],"usage":"作谓语、定语；指偷窃"},{"id":6834,"word":"偷生惜死","pinyin":"tōu shēng xī sǐ","abbr":"tsxs","explanation":"苟且活命，舍不得死。","source":{"text":"岂偷生之士，而惜死之人哉。","book":"汉·李陵《答苏武书》"},"example":{"text":"雄诞今若从公，不过诞生百日。大丈夫怎可～，自陷不义？","book":"蔡东藩《唐史演义》第十一回"}},{"id":6835,"word":"偷营劫寨","pinyin":"tōu yíng jié zhài","abbr":"tyjz","explanation":"营：军营，军队驻扎的地方。劫：强夺。寨：防守用的栅栏，引申为军营。偷袭敌方的营寨。","source":{"text":"和尚言：‘老僧今年胆大。’先生道：‘住！贫道从来胆大，专会偷营劫寨。夺了袖中金锤，留下三千世界。’","book":"明·冯梦龙《醒世恒言》第二十二卷"},"example":{"text":"明·冯梦龙《醒世恒言》第22卷：“贫道从来胆大，专会～。”"},"usage":"作谓语、宾语；用于战争等"},{"id":6836,"word":"偷闲躲静","pinyin":"tōu xián duǒ jìng","abbr":"txdj","explanation":"摆脱杂务，得个清静。","source":{"text":"第一个凤姐事多任重，别人或可偷闲躲静，独他是不能脱得的。","book":"清·曹雪芹《红楼梦》第19回"},"usage":"作谓语、定语；指偷懒"},{"id":6837,"word":"偷香窃玉","pinyin":"tōu xiāng qiè yù","abbr":"txqy","explanation":"比喻引诱妇女。","source":{"text":"时西域有贡奇香，一著人则经月不歇，帝甚贵之，惟以赐充及大司马陈骞。其女密盗以遗寿，充僚属与寿燕处，闻其芬馥，称之于充。……","book":"《晋书·贾充传》"},"example":{"text":"稳坐了七香车，高揭了三檐伞，请受了金花诰，再不赴～期。","book":"元·石子章《竹坞听琴》第四折"},"similar":["寻花问柳","坠入情网","窃玉偷香"],"opposite":["安分守己","循规蹈矩"],"usage":"作宾语、定语；指偷情"},{"id":6838,"word":"偷鸡不着蚀把米","pinyin":"tōu jī bù zháo shí bǎ mǐ","abbr":"tjbzsbm","explanation":"俗语。鸡没有偷到，反而损失了一把米。比喻本想占便宜反而吃了亏。","source":{"text":"这艄公好晦气，却不是偷鸡不着，反折了一把米？","book":"清·钱彩《说岳全传》第二十五回"},"example":{"text":"我们白跑了一趟，～，就是了。","book":"叶圣陶《一个练习生》"},"similar":["偷鸡不成反蚀把米"],"usage":"作宾语、定语、分句；用于有坏心的人"},{"id":6839,"word":"偷鸡戏狗","pinyin":"tōu jī xì gǒu","abbr":"tjxg","explanation":"指偷窃的行为。也指不正经的勾当。","source":{"text":"小人如今在此，只做得些偷鸡盗狗的勾当，几时是了；跟随的二位哥哥上山去，却不好？","book":"明·施耐庵《水浒全传》第四十六回"}},{"id":6840,"word":"偷鸡摸狗","pinyin":"tōu jī mō gǒu","abbr":"tjmg","explanation":"指偷窃的行为。也指不正经的勾当。","source":{"text":"小人如今在此，只做得些偷鸡盗狗的勾当，几时是了；跟随的二位哥哥上山去，却不好？","book":"明·施耐庵《水浒全传》第四十六回"},"example":{"text":"成日家～，腥的臭的，都拉了你屋里去！","book":"清·曹雪芹《红楼梦》第四十四回"},"similar":["小偷小摸","偷鸡盗狗","偷猫盗狗"],"opposite":["光明正大","安分守己"],"usage":"作谓语、定语；指偷窃"},{"id":6841,"word":"偷鸡盗狗","pinyin":"tōu jī dào gǒu","abbr":"tjdg","explanation":"指偷窃的行为。也指不正经的勾当。同“偷鸡摸狗”。","source":{"text":"小人如今在此，只做得些偷鸡盗狗的勾当，几时是了。","book":"明·施耐庵《水浒传》第四十六回"},"example":{"text":"不比先前在王婆家茶房里，只是～之欢。","book":"明·兰陵笑笑生《金瓶梅词话》第六回"},"similar":["偷鸡摸狗"],"opposite":["光明正大","安分守己"],"usage":"作谓语、定语；指偷窃","story":["西门庆窜通王婆勾引潘金莲，被郓哥看破，武大郎亲自捉奸，被西门庆一脚踢倒。王婆指使潘金莲用砒霜药死武大郎，并一把火烧了尸体。用不着像偷鸡盗狗般的偷情，于是明目张胆地同居起来，结果被武松回来杀死"]},{"id":6842,"word":"偿其大欲","pinyin":"cháng qí dà yù","abbr":"cqdy","explanation":"偿：达到，满足。欲：欲望。大欲：野心。指满足了他最大的欲望，或达到了他的野心。","source":{"text":"日寇原欲在中国求偿其大欲，但中国的长期抵抗，将使日本帝国主义本身走上崩溃的道路。","book":"毛泽东《和英国记者贝特兰的谈话》"}},{"id":6843,"word":"傀儡登场","pinyin":"kuǐ lěi dēng chǎng","abbr":"kldc","explanation":"傀儡：木偶戏中的木头人。比喻受人操纵的人上台执政。","source":{"text":"乘帝观剧，摘疏中‘傀儡登场’语，谓比帝于偶人，不杀无以示天下，帝颔之。","book":"《明史·文震孟传》"},"example":{"text":"亲日派大资产阶级早已彻底投降日本，准备～。","book":"毛泽东《目前抗日统一战线中的策略问题》"},"usage":"作谓语、宾语、定语；指受人控制"},{"id":6844,"word":"傅粉何郎","pinyin":"fù fěn hé láng","abbr":"ffhl","explanation":"傅粉：敷粉，抹粉；何郎：何晏，字平叔，曹操养子。原指何宴面白，如同搽了粉一般。后泛指美男子。","source":{"text":"何平叔美姿仪，面至白，魏明帝疑其傅粉。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"唬的那有情人恨无个地缝儿藏，羞杀我也～。","book":"元·郑德辉《刍梅香》第三折"},"similar":["何郎傅粉"],"usage":"作宾语；指美男子","story":["三国时期，曹操的女婿何晏长得十分俊美，他经常涂脂抹粉。曹丕称帝后，想亲自检验一下何晏有多美，在一个烈日当空的中午，他请何晏在宫内喝酒，让他吃加辣的热鸡汤面。何晏一边吃，一边不停地擦汗。一碗面吃完，脸上的脂粉全部被擦干净了"]},{"id":6845,"word":"傅粉施朱","pinyin":"fù fěn shī zhū","abbr":"ffsz","explanation":"傅：搽；朱：红，指胭脂。搽粉抹胭脂。泛指修饰打扮。","source":{"text":"无不熏衣剃面，傅粉施朱。","book":"战国·楚·宋玉《登徒子好色赋》：“著粉则太白，施朱则太赤。眉如翠羽，肌如白雪。”北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"描眉画眼，～。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"similar":["涂脂抹粉"],"usage":"作谓语、定语；指擦脂抹粉"},{"id":6846,"word":"傅纳以言","pinyin":"fù nà yǐ yán","abbr":"fnyy","explanation":"傅：陈述。让人陈述自己的意见而加以采纳。","source":{"text":"古之选贤，傅纳以言，明试以功。","book":"《汉书·成帝纪》"}},{"id":6847,"word":"傅致其罪","pinyin":"fù zhì qí zuì","abbr":"fzqz","explanation":"傅：同“附”。指虚构罪名，陷害无辜。","source":{"text":"诸哀帝外戚，及大臣居位素所不说者，莽皆傅其罪。","book":"《汉书·王莽传》"}},{"id":6848,"word":"傍人篱壁","pinyin":"bàng rén lí bì","abbr":"brlb","explanation":"傍：依靠；篱壁：篱笆墙。依靠着别人家的篱笆墙。比喻依赖或模仿别人。","source":{"text":"是自家闭门凿破此片田地。即非傍人篱壁，拾人涕唾得来者。","book":"宋·严羽《沧浪诗话》"},"similar":["傍人门户","傍人篱落"],"opposite":["自力更生"],"usage":"作谓语、宾语；指依靠别人"},{"id":6849,"word":"傍人篱落","pinyin":"bàng rén lí luò","abbr":"brll","explanation":"比喻依赖他人。","source":{"text":"参见“傍人篱壁”。"},"example":{"text":"吾辈所恃，在自家本领足以垂之后代，不必～，亦不屑与人争名。","book":"清·顾炎武《与人札》"},"similar":["傍人篱壁"],"opposite":["自力更生"],"usage":"作谓语、宾语；指依靠别人"},{"id":6850,"word":"傍人门户","pinyin":"bàng rén mén hù","abbr":"brmh","explanation":"傍：依靠，依附；门户：门第。比喻依赖别人，不能自立。","source":{"text":"吾辈不肖，方傍人门户，何暇争闲气耶？","book":"宋·苏轼《东坡志林》卷十二"},"example":{"text":"虽说咱们穷，究竟比他～好多着呢。","book":"清·曹雪芹《红楼梦》第一０九回"},"similar":["傍人依户","寄人篱下"],"opposite":["自力更生","自立门户","独树一帜"],"usage":"作谓语、宾语；形容依赖他人，不能自立","story":["传说古代过节要贴桃符及门神，还要做一个艾叶草人插在门上。桃符抬头看见艾人就骂道：“汝何等草芥，敢居我上！”艾人低头应道：“你已半截入土还要争高低？”双方大吵。门神劝解他们说：“吾辈不肖，方傍人门户，何暇争闲气？”"]},{"id":6851,"word":"傍柳随花","pinyin":"bàng liǔ suí huā","abbr":"blsh","explanation":"春天依倚花草柳树而游乐的情调。比喻狎妓。","source":{"text":"云淡风轻近午天，傍花随柳过前川。","book":"北宋·程颢《春日偶成诗》"},"example":{"text":"一笑情通，～，偎香倚玉，弄月搏风。","book":"元·徐琰《青楼十咏·初见》"},"similar":["傍花随柳"],"usage":"作谓语、宾语；指狎妓"},{"id":6852,"word":"傍花随柳","pinyin":"bàng huā suí liǔ","abbr":"bhsl","explanation":"形容春游的快乐。","source":{"text":"云淡风轻近午天，傍花随柳过前川。","book":"宋·程灏《春日偶成》"},"example":{"text":"幸居同泗水之滨，况地接九山之胜，尽可～，庶几游目聘怀。","book":"明·陶宗仪《辍耕录·真率会》"},"similar":["傍柳随花"],"usage":"作谓语、宾语；指狎妓"},{"id":6853,"word":"傍若无人","pinyin":"páng ruò wú rén","abbr":"prwr","explanation":"好像旁边没有人在。形容神情态度高傲自如。","source":{"text":"虽渐离击筑，傍若无人，高凤读书，不知暴雨。","book":"《后汉书·延笃传》"},"example":{"text":"陈太尉初下船时，昂昂然～，坐在中间。","book":"明·施耐庵《水浒传》第七十五回"},"similar":["旁若无人"],"usage":"作谓语、定语、状语；指人的态度","story":["晋朝时期，王子敬从会稽经过吴郡，听说顾辟疆有个名园就去参观，碰见顾辟疆在园内设宴畅饮，王子敬游遍整个园子后在那里指指点点，旁若无人。顾辟疆气得把他的下人全赶出园子，接着就赶王子敬，王始终坦然自若，置之不理"]},{"id":6854,"word":"傍观冷眼","pinyin":"bàng guān lěng yǎn","abbr":"bgly","explanation":"傍：通“旁”。用冷眼或冷淡的态度在一旁瞧着。","source":{"text":"诗云：‘一局输赢料不真，香销茶尽尚逡巡。欲知目下兴衰兆，顺问傍观冷眼人。’","book":"《脂砚斋评红楼梦》第二回"}},{"id":6855,"word":"傍观必审","pinyin":"bàng guān bì shěn","abbr":"bgbs","explanation":"傍观：在旁边观察。在一旁观察，必定明晰、清楚。","source":{"text":"傍观：在旁边观察。在一旁观察，必定明晰、清楚。"}},{"id":6856,"word":"傍观者审，当局者迷","pinyin":"páng guān zhě shěn，dāng jú zhě mí","abbr":"bgzsdjzm","explanation":"傍：通“旁”。指局外人清晰地看待问题，当事人往往会迷惑。","source":{"text":"夫为人画策，则工；若自为计，多拙。故曰傍观者审，当局者迷。","book":"宋·马永卿《懒真子》第三卷"},"example":{"text":"正所谓‘～’，你们的棋局，他可是看得清清楚楚的呵。"},"similar":["当局者迷，旁观者清"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":6857,"word":"傍观者清","pinyin":"bàng guān zhě qīng","abbr":"bgzq","explanation":"傍：同“旁”。旁观者：在一旁观看的人。同一事物，在一旁观看的人比当事者看得全面、清楚。常与“当局者迷”连用。亦作“旁观者清”。","source":{"text":"当局称迷，傍观必审，何所为疑而不申列？","book":"《旧唐书·元行冲传》"}},{"id":6858,"word":"傍门依户","pinyin":"bàng mén yī hù","abbr":"bmyh","explanation":"傍：依傍，靠着；门、户：家。依靠在别人门庭上。指依赖别人，不能自立。","source":{"text":"尽宇内秦楚燕韩，傍门依户者，共是俺一家友生。","book":"明·孙仁孺《东郭记·人之所以求富贵利达者》"},"similar":["傍人门户"],"opposite":["独立自主"],"usage":"作谓语、宾语；形容依赖他人"},{"id":6859,"word":"傥来之物","pinyin":"tǎng lái zhī wù","abbr":"tlzw","explanation":"傥来：偶然、意外得来的。无意中得到的或非本分应得的财物。","source":{"text":"物之傥来，寄者也。","book":"《庄子·缮性》"},"example":{"text":"赢时节道是～，就有粘头的，讨赏的、帮衬的，大家来撮哄。 ◎明·凌濛初《二刻拍案惊奇》卷八"},"similar":["倘来之物","意外之财"],"usage":"偏正式；作宾语；指无意中得到的财物"},{"id":6860,"word":"储精蓄锐","pinyin":"chǔ jīng xù ruì","abbr":"cjxr","explanation":"储：积累；蓄：积蓄；锐：锐气。保养精神，蓄集锐气。","source":{"text":"修行人储精蓄锐，精进思维，而欲现种种身，善巧方使，说法利生，原属善意；无奈于定中起心动念，同时有所贪求，便为魔所乘，而来恼乱。","book":"《楞严经》卷九"}},{"id":6861,"word":"傫如丧狗","pinyin":"lěi rú sàng gǒu","abbr":"lrsg","explanation":"形容人失意而精神颓丧。傫，古同“累”。","source":{"text":"丧家之狗，主人哀荒，不见饮食，故累然而不得意。孔子生于乱世，道不得行，故累累然不得志之貌也。","book":"语本《史记·孔子世家》：“孔子适郑，与弟子相失，孔子独立郭东门……累累若丧家之狗。”裴骃集解引王肃曰"},"example":{"text":"看到他～的样子，他很内疚"},"usage":"作定语、状语；用于书面语"},{"id":6862,"word":"催人泪下","pinyin":"cuī rén lèi xià","abbr":"crlx","explanation":"催：催促，促使。形容事迹十分感人，使人不禁流下眼泪。","source":{"text":"电影里的相声和幽默小品不能使我们解颐一笑，甚至绝对催人泪下的悲剧我们从头看到尾也始终无动于衷。","book":"王朔《过把瘾就死》"},"example":{"text":"这本～的小说，我至少读了三遍。"},"opposite":["令人捧腹"],"usage":"作谓语、定语；用于感染力强的东西"},{"id":6863,"word":"催命鬼","pinyin":"cuī mìng guǐ","abbr":"cmg","explanation":"催人早死的人，比喻人催促别人很紧很急。","source":{"text":"不一时，催命鬼领了几个弟男子侄来到庙前。","book":"清·张南庄《何典》第二回"},"example":{"text":"别催了，你这个～真太讨厌。"},"usage":"作主语、宾语、定语；用于口语"},{"id":6864,"word":"傲上矜下","pinyin":"ào shàng jīn xià","abbr":"asjx","explanation":"矜：自夸。对上对下都自傲自大。","source":{"text":"却说卢柟素性刚直豪爽，是个傲上矜下之人。","book":"明·冯梦龙《醒世恒言》卷二十九"}},{"id":6865,"word":"傲不可长","pinyin":"ào bù kě zhǎng","abbr":"abkz","explanation":"傲慢之心不可以滋长。","source":{"text":"傲不可长，欲不可纵，志不可满，乐不可极。","book":"《礼记·曲礼上》"},"example":{"text":"～，像他那样傲慢的孩子，家长应加强教育。"}},{"id":6866,"word":"傲世妄荣","pinyin":"ào shì wàng róng","abbr":"aswr","explanation":"不屈于世俗，置荣华富贵于度外。","source":{"text":"逸群公子，体奇好异，傲世妄荣，绝弃人事。","book":"晋·成公绥《啸赋》"}},{"id":6867,"word":"傲世轻物","pinyin":"ào shì qīng wù","abbr":"asqw","explanation":"傲世：傲视当世；物：他人或环境。鄙弃世俗，看不起别人。也指高傲自大。","source":{"text":"敖（傲）世轻物，不污于俗。","book":"《淮南子·齐俗训》"},"similar":["孤芳自赏"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指人的处世观"},{"id":6868,"word":"傲头傲脑","pinyin":"ào tóu ào nǎo","abbr":"atan","explanation":"形容倔强、桀骜不驯的样子。","source":{"text":"现今之小厮傲头傲脑，也要娶个辣燥些的媳妇来制着他才好。","book":"《儒林外史》第二七回"},"similar":["桀骜不驯"],"usage":"作谓语、定语；指人很傲气"},{"id":6869,"word":"傲慢不逊","pinyin":"ào màn bù xùn","abbr":"ambx","explanation":"逊：谦逊。态度高傲自大，对人不讲谦让。","source":{"text":"有司奏君责使者礼，遇丞相无礼，廉声不闻，敖（傲）慢不逊。","book":"东汉·班固《汉书·萧望之传》"},"example":{"text":"我们对人千万不能～。"},"similar":["傲慢少礼"],"opposite":["彬彬有礼"],"usage":"作谓语、定语；指对人的态度"},{"id":6870,"word":"傲慢少礼","pinyin":"ào màn shǎo lǐ","abbr":"amsl","explanation":"态度傲慢，对人不讲礼节。","source":{"text":"视人君相忤，是乃祀所谓傲慢；傲慢则无礼，无礼则不臣，不臣则犯罪，犯罪则陷不测矣。","book":"《三国志·吴志·三嗣主传》裴松之注引孙皓侍中李仁之言"},"example":{"text":"自襄阳赶刘玄德不着，来投韩玄；玄怪其～，不肯重用。","book":"明·罗贯中《三国演义》第五十三回"},"similar":["傲慢无礼"],"opposite":["彬彬有礼"],"usage":"作谓语、定语；指人的修养"},{"id":6871,"word":"傲慢无礼","pinyin":"ào màn wú lǐ","abbr":"amwl","explanation":"态度傲慢，对人不讲礼节。","source":{"text":"视人君相忤，是乃祀所谓傲慢；傲慢则无礼，无礼则不臣，不臣则犯罪，犯罪则陷不测矣。","book":"《三国志·吴志·三嗣主传》裴松之注引孙皓侍中李仁之言"},"example":{"text":"他可真是～，没有教养。"},"similar":["傲慢少礼"],"opposite":["彬彬有礼"],"usage":"作谓语、定语、补语；指对人的态度"},{"id":6872,"word":"傲然屹立","pinyin":"ào rán yì lì","abbr":"aryl","explanation":"形容坚定，不可动摇地站立着。","source":{"text":"抽茎了，长叶了，铁骨青枝，傲然屹立。","book":"古华《芙蓉镇》"},"similar":["巍然屹立","岿然不动"],"opposite":["东倒西歪","摇摇欲坠"],"usage":"作谓语；形容高大挺拔，意志坚定不移"},{"id":6873,"word":"傲然挺立","pinyin":"ào rán tǐng lì","abbr":"artl","explanation":"傲然：坚强不屈的样子。挺立：像山峰一样高高地耸立。形容坚强而不可动摇。","source":{"text":"难道你竟一点也不联想到，在敌后的广大土地上，到处有坚强不屈，就象这白杨树一样傲然挺立的守卫他们家乡的哨兵？","book":"茅盾《白杨礼赞》"},"example":{"text":"黄山上的松树依然～在严冬中。"},"similar":["傲然屹立"],"usage":"作谓语；形容高大挺拔，意志坚定不移"},{"id":6874,"word":"傲睨一世","pinyin":"ào nì yī shì","abbr":"anys","explanation":"睨：斜视。高傲地旁观，对当代的一切都不看在眼里。形容傲慢自负，目空一切。","source":{"text":"但其再来，遂负虚骄之气，傲睨一世，自以人莫能及。","book":"宋·朱熹《朱子语类》卷三十四：“便有傲睨一世，污浊朝廷之意。”宋·高斯得《耻堂存稿·留赵给事奏札》"},"example":{"text":"辽字睿达，幼挺拔不群，长而好学尚友，～。","book":"《宋史·沈辽传》"},"similar":["傲睨一切"],"opposite":["谦虚敬慎"],"usage":"作谓语、定语；指人的处世态度"},{"id":6875,"word":"傲睨一切","pinyin":"ào nì yī qiè","abbr":"anyq","explanation":"睨：斜视。斜着眼看一切事物。形容目空一切，什么都瞧不起。","source":{"text":"宋·黄庭坚《豫章文集·卷二十六·跋俞秀老清老诗颂》：“清老往与余共学于涟水，其傲睨万物，滑稽以玩世，白首不哀”。"},"example":{"text":"更有那放荡不羁，～，偏低首下心，作儿女之态。","book":"清·魏秀仁《花月痕》第一回"},"similar":["傲睨万物"],"opposite":["谦虚敬慎"],"usage":"作谓语、定语；用于人的态度"},{"id":6876,"word":"傲睨万物","pinyin":"ào nì wàn wù","abbr":"anww","explanation":"睨：斜视。斜着眼看一切事物。形容目空一切，什么都瞧不起。","source":{"text":"宋·黄庭坚《豫章文集·卷二十六·跋俞秀老清老诗颂》：“清老往与余共学于涟水，其傲睨万物，滑稽以玩世，白首不哀”。"},"example":{"text":"……益自尊大，宝自有而～。","book":"鲁迅《文化偏至论》"},"similar":["目空一切"],"opposite":["谦虚警慎"],"usage":"作谓语、定语；指人的态度"},{"id":6877,"word":"傲睨得志","pinyin":"ào nì dé zhì","abbr":"andz","explanation":"傲睨：傲慢地斜眼看。得志：愿望实现。形容因实现愿望而看不起一切的神情。","source":{"text":"原来曹操自破马超回，傲睨得志，每日饮宴，无事少出，国政皆在相府商议。","book":"明·罗贯中《三国演义》第六十回"},"usage":"作谓语、定语；指人的神态"},{"id":6878,"word":"傲睨自若","pinyin":"ào nì zì ruò","abbr":"anzr","explanation":"睨：斜视；自若：指满不在乎。形容自高自大、藐视一切的样子。","source":{"text":"郑太穆郎中为金州刺史，一日忽致书于襄阳于司空頔，其言恳切，而傲睨自若，似无郡僚之礼。","book":"宋·王谠《唐语林·豪爽》"},"example":{"text":"简雍在城下唤门。（刘）璋令开门接入。雍坐在车中，傲睨自若。","book":"明·罗贯中《三国演义》第六十五回"},"similar":["自高自大","目空一切"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；形容自高自大"},{"id":6879,"word":"傲贤慢士","pinyin":"ào xián màn shì","abbr":"axms","explanation":"贤：有才德的人；士：读书人和有才干的人。用傲慢的态度对待有德有才的人。","source":{"text":"何期逆贼恣逞奸雄，傲贤慢士，故特来见明公。","book":"明·罗贯中《三国演义》第六十回"},"opposite":["爱才如命"],"usage":"作谓语、定语；指看不起有才能的人"},{"id":6880,"word":"傲雪凌霜","pinyin":"ào xuě líng shuāng","abbr":"axls","explanation":"形容不畏霜雪严寒，外界条件越艰苦越有精神。比喻经过长期磨练，面对冷酷迫害或打击毫不示弱、无所畏惧。傲，傲慢、蔑视。","source":{"text":"傲雪凌霜，平欺寒力，搀借春光。","book":"宋·杨无咎《柳梢青》"},"example":{"text":"如松柏之性，～。","book":"清·钱泳《履园丛话·谭诗·总论》"},"similar":["傲雪欺霜","无所畏惧"],"opposite":["含垢忍辱","逆来顺受","委曲求全"],"usage":"作谓语、宾语、定语；比喻经历磨炼"},{"id":6881,"word":"傲雪欺霜","pinyin":"ào xuě qī shuāng","abbr":"axqs","explanation":"形容不畏霜雪严寒，外界条件越艰苦越有精神。比喻经过长期磨练，面对冷酷迫害或打击毫不示弱、无所畏惧。傲，傲慢、蔑视。","source":{"text":"梅花云：我这梅花……玉骨冰肌谁可匹，傲雪凌霜夺第一。","book":"元·吴昌龄《张天师》"},"example":{"text":"玉骨冰肌谁可匹，～夺第一。","book":"元·吴昌龄《张天师》第三折"},"similar":["傲雪凌霜","战天斗地","无所畏惧"],"opposite":["忍辱偷生","委曲求全","含垢忍辱"],"usage":"作谓语、定语、宾语；形容意志坚定"},{"id":6882,"word":"傲霜斗雪","pinyin":"ào shuāng dòu xuě","abbr":"asdx","explanation":"傲视寒霜，抗击白雪。形容不畏严寒。比喻人身处逆境而不屈服。","source":{"text":"玉骨冰肌谁可匹，傲雪欺霜夺第一。","book":"元·吴昌龄《张天师》第三折"},"similar":["傲雪欺霜"],"usage":"作谓语、定语；指人的骨气"},{"id":6883,"word":"傲霜枝","pinyin":"ào shuāng zhī","abbr":"asz","explanation":"傲：傲慢，蔑视。形容菊花凌霜傲雪，不为严寒所屈。","source":{"text":"荷尽已无擎雨盖，菊残犹有傲霜枝。","book":"宋·苏轼《赠刘景文》诗"},"usage":"作宾语、定语；指人的气节"},{"id":6884,"word":"傲骨嶙嶙","pinyin":"ào gǔ lín lín","abbr":"agll","explanation":"傲骨：指高傲不屈的性格。嶙嶙：山崖突兀貌。比喻高傲不屈。","source":{"text":"清·蒲松龄《聊斋志异·叶生》“行踪落落，对影长愁；傲骨嶙嶙，搔头自爱。”"},"similar":["铁骨铮铮"],"usage":"作谓语、定语；指人的性格"},{"id":6885,"word":"傻头傻脑","pinyin":"shǎ tóu shǎ nǎo","abbr":"stsn","explanation":"形容思想糊涂，愚笨痴呆。","source":{"text":"只是我愁宝玉还是那么傻头傻脑的。","book":"清·曹雪芹《红楼梦》第99回"},"example":{"text":"不要这么～了，还是回去！睡觉去！","book":"鲁迅《彷徨·长明灯》"},"similar":["笨头笨脑"],"opposite":["聪明伶俐"],"usage":"作谓语、定语、状语；指人傻气"},{"id":6886,"word":"傻眉愣眼","pinyin":"shǎ méi lèng yǎn","abbr":"smly","explanation":"形容发呆的样子。","source":{"text":"还不快往前搜索！傻眉愣眼立在那儿干什么？","book":"管桦《惩罚》三"}},{"id":6887,"word":"傻眉楞眼","pinyin":"shǎ méi lèng yǎn","abbr":"smly","explanation":"形容发呆的样子。","source":{"text":"还不快往前搜索！傻眉楞眼立在那儿干什么？","book":"管桦《惩罚》"},"example":{"text":"他一天都是～的样子。"},"usage":"作谓语、定语、状语；指人发呆"},{"id":6888,"word":"傻里傻气","pinyin":"shǎ lǐ shǎ qì","abbr":"slsq","explanation":"形容愚蠢、糊涂的样子。","source":{"text":"七姑奶奶哈哈大笑，弯腰顿足，笑得傻里傻气。","book":"高阳《胡雪岩全传·平步青云》中册"},"similar":["傻头傻脑","傻里巴机"],"opposite":["聪明伶俐"],"usage":"作定语、状语；用于口语"},{"id":6889,"word":"像形夺名","pinyin":"xiàng xíng duó míng","abbr":"xxdm","explanation":"比拟其形状，而讹易本名。","source":{"text":"又有叫作甚麽绿荑的，还有甚么丹椒、蘼芜、风连，见于《蜀都赋》。如今年深岁改，人不能识，故皆象形夺名，渐渐的唤差了，也是有的。","book":"清·曹雪芹《红楼梦》第十七回"}},{"id":6890,"word":"像心像意","pinyin":"xiàng xīn xiàng yì","abbr":"xxxy","explanation":"指顺遂心愿，合乎心意。","source":{"text":"这海陵像心像意侮弄了几多时节。","book":"《京本通俗小说·海陵王荒淫》"},"example":{"text":"我们一心计路要寻个～的女婿，直至如今不曾寻着。","book":"清·张南庄《何典》第七回"},"usage":"作定语、状语；用于处事等"},{"id":6891,"word":"像心如意","pinyin":"xiàng xīn rú yì","abbr":"xxry","explanation":"指顺心如意。","source":{"text":"只要于己有一丝的好处，且把良心歪到半边，千方百计，竭力钻谋，便像心如意了，还不住手。","book":"《黄金世界》第一回"},"similar":["称心如意"],"usage":"作谓语、定语；用于处事等"},{"id":6892,"word":"像心称意","pinyin":"xiàng xīn chēng yì","abbr":"xxcy","explanation":"指称心满意。","source":{"text":"公子身边最讲得话、像心称意的，有两个门客，一个是萧管朋友贾清夫，一个是拳棒教师赵能武。一文一武，出入不离左右。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["称心满意"],"usage":"作定语、宾语、状语；用于处事等"},{"id":6893,"word":"像心适意","pinyin":"xiàng xīn shì yì","abbr":"xxsy","explanation":"指随心所欲。","source":{"text":"［畔房小姐］自恃是太师爷的女儿，凡事像心适意，敢作敢为。","book":"清·张南庄《何典》第八回"},"similar":["随心所欲"],"usage":"作谓语、定语、状语；用于处事等"},{"id":6894,"word":"像模像样","pinyin":"xiàng mó xiàng yàng","abbr":"xmxy","explanation":"形容着重或隆重的样子。","source":{"text":"这番调动，老爷可必得像模像样答上头的情才使得呢。","book":"清·文康《儿女英雄传》第二回"},"example":{"text":"小镇到处都在盘算和议论着，怎样～地给将军送行。","book":"陈世旭《小镇上的将军》"},"similar":["郑重其事","有模有样"],"usage":"作谓语、定语；指体面好看"},{"id":6895,"word":"像煞有介事","pinyin":"xiàng shà yǒu jiè shì","abbr":"xsyjs","explanation":"指似乎真有其事。多用以形容小题大作或装腔作势的样子。","source":{"text":"我们的‘友邦’好友，顶喜欢宣传中国的古怪事情，尤其是‘共党’的，四年以前，将‘裸体游行’说得像煞有介事，于是中国人也跟着叫了好几个月。","book":"鲁迅《二心集·再来一条“顺”的翻译》"},"example":{"text":"至于所谓当场夺获的手枪，虽然～地举出号数，使人相信，但我总奇怪。","book":"朱自清《执政府大屠杀记》"},"similar":["象煞有介事"],"usage":"作谓语、状语；指装模作样"},{"id":6896,"word":"僧多粥少","pinyin":"sēng duō zhōu shǎo","abbr":"sdzs","explanation":"和尚多，而供和尚喝的粥少。比喻物少人多，不够分配。","source":{"text":"师爷的席面是看得见的东西，再要来一个撞席的，便就僧多粥薄，相公就不够吃了。","book":"清·西周生《醒世姻缘传》第六十二回"},"example":{"text":"我们要打破～的局面。"},"similar":["粥少僧多","人浮于事"],"opposite":["供过于求"],"usage":"作谓语、定语、分句；指人浮于事"},{"id":6897,"word":"僧来看佛面","pinyin":"sēng lái kàn fó miàn","abbr":"slkfm","explanation":"僧：和尚。和尚来了要看在佛的面子招待他。比喻看有关人士的面子对待来者。","source":{"text":"这个人是你王公公荐来的，僧来看佛面，不可轻慢于他。","book":"清·李宝嘉《官场现形记》第二回"},"example":{"text":"～，还是少招惹他吧。"},"similar":["不看僧面看佛面"],"usage":"作宾语、定语、分句；指对人的态度"},{"id":6898,"word":"僭赏滥刑","pinyin":"jiàn shǎng làn xíng","abbr":"jslx","explanation":"赏的不是有功的人，罚的不是有罪的人。泛指赏罚不当。","source":{"text":"善为国者，赏不僭而刑不滥。","book":"《左传·襄公二十六年》"},"similar":["赏罚不当"],"usage":"作谓语、宾语、定语；用于处事"},{"id":6899,"word":"僵仆烦愦","pinyin":"jiāng pū fán kuì","abbr":"jpfk","explanation":"疲惫而卧，心烦意乱。","source":{"text":"岂可使呶呶者早暮咈吾耳，骚吾心？则固僵仆烦愦，愈不可过矣。","book":"唐·柳宗元《答韦中水论师道书》"}},{"id":6900,"word":"僵李代桃","pinyin":"jiāng lǐ dài táo","abbr":"jldt","explanation":"比喻代人受罪责或以此代彼。亦作“僵桃代李”。","source":{"text":"彼逾墙钻隙，固有玷夫儒冠；而僵李代桃，诚难消其冤气。","book":"清蒲松龄《聊斋志异·胭脂》"},"example":{"text":"遂密斩来使，行～之计。","book":"《冷眼观》第二八回"},"similar":["李代桃僵"],"usage":"作谓语、定语、宾语；指代人受过","story":["从前有兄弟五人都是游手好闲的浪荡子因为得到皇帝赏识，当上了侍中郎，过上奢华的生活。兄弟中一人犯法，其他的则互相倾轧。有人就用诗评判：“桃生露井上，李树在桃傍，虫来啮桃根，李树代桃僵。树木身相代，兄弟还相忘！”"]},{"id":6901,"word":"僵桃代李","pinyin":"jiāng táo dài lǐ","abbr":"jtdl","explanation":"比喻代人受罪责或以此代彼。同“僵李代桃”。","source":{"text":"僵桃代李诚无与，摧花斫柳夫何取？","book":"清·赢宗季女《六月霜·对簿》"},"similar":["僵李代桃"],"usage":"作谓语、定语、宾语；指代人受过"},{"id":6902,"word":"僶俛从事","pinyin":"mǐn miǎn cóng shì","abbr":"mfcs","explanation":"努力工作。","source":{"text":"是以僶俛从事，自同全人。","book":"《文选·解尚书表》"},"similar":["黾勉从事"],"usage":"作谓语；指努力工作"},{"id":6903,"word":"僻字涩句","pinyin":"pì zì sè jù","abbr":"pzsj","explanation":"冷僻的字、词和晦涩的文句。","source":{"text":"其《新唐书》好用僻字涩句，以矜其博，使人读之，胸臆间格格不纳，殊不爽朗。","book":"清·昭梿《啸亭杂录·诗文涩体》"},"example":{"text":"或乃竞为～，以骇庸众，斫自然之元气，斯又才士之所同蔽，戒律之所必严。","book":"清·曾国藩《复陈右铭太守书》"},"usage":"作主语、宾语、定语；指冷僻艰涩的字句"},{"id":6904,"word":"僾见忾闻","pinyin":"ài jiàn kài wén","abbr":"ajkw","explanation":"僾：隐约，仿佛；忾：叹息。仿佛看见身影，听到叹息。多形容对已过世尊长的怀念。","source":{"text":"祭之日，入室，僾然必有见乎其位，出户而听，忾然必有闻乎其叹息之声。","book":"《礼记·祭义》"},"example":{"text":"人死则魂散魄杳，正人子所慕而不可得者，所以～，圣人之祭则如在也。","book":"清·李绿园《歧路灯》第十二回"},"usage":"作宾语、定语；用于对去世的亲人思念"},{"id":6905,"word":"儋石之储","pinyin":"dàn shí zhī chǔ","abbr":"dszc","explanation":"犹言少量的财富。儋，成担贷物的计量单位。","source":{"text":"家产不过十金，乏无儋石之储，晏如也。","book":"《汉书·扬雄传上》"},"example":{"text":"继母虐不子，厥子先生事之愈恭，既而改适他氏，无～。","book":"明·宋濂《元故湛渊先生白公墓铭》"},"usage":"作宾语；指储粮很少"},{"id":6906,"word":"儒士成林","pinyin":"rú shì chéng lín","abbr":"rscl","explanation":"儒士：指读书人。比喻读书人很多。","source":{"text":"缙绅如云，儒士成林。","book":"《后汉书·张衡传》"}},{"id":6907,"word":"儒家经书","pinyin":"rú jiā jīng shū","abbr":"rjjs","explanation":"中国儒家学派的经典著作。","example":{"text":"我最喜欢研究～。"},"usage":"作主语、宾语、定语；指经典著作","story":["我国儒家学派的经典著作最初是诗、书、礼、乐、易、春秋“六经”和周礼、仪礼、礼记“三礼”，宋代为十三经，即诗、书、易、周礼、仪礼、《礼记》、《春秋左传》、《公羊传》、《谷梁传》、《论语》、《孝经》、《尔雅》和《孟子》"]},{"id":6908,"word":"儒林丈人","pinyin":"rú lín zhàng rén","abbr":"rlzr","explanation":"尊称学识渊博的前辈。","source":{"text":"名秀为儒林丈人，沈为文籍先生，望、会亦各有名号。","book":"《三国志·魏志·高贵乡公传》裴松之注引《晋诸公传》"},"example":{"text":"为报～道，如今从此鬓星星。","book":"唐·刘禹锡《闻韩宾擢第归觐以诗美之兼贺韩十五曹长时韩牧永州》"}},{"id":6909,"word":"儒雅风流","pinyin":"rú yǎ fēng liú","abbr":"ryfl","explanation":"①文雅而飘逸。②指风雅淳正。","source":{"text":"方巾与有带飘巾，同为雅者之服。飘巾儒雅风流，方巾老成持重。","book":"清·李渔《闲情偶寄·演习·脱套》"},"example":{"text":"二公表章经籍，笃古崇儒，至求淑相攸，必属之东鲁圣人之裔，诚不愧～矣。","book":"清·陈康祺《郎潜纪闻》卷七"},"usage":"作谓语、定语；指人的修养"},{"id":6910,"word":"儗不于伦","pinyin":"lǐ bù yú lún","abbr":"nbyl","explanation":"拿不能相比的人或事物来比方。儗，古通“拟”，比拟。同“儗非其伦”。"},{"id":6911,"word":"儗非其伦","pinyin":"nǐ fēi qí lún","abbr":"nfql","explanation":"拿不能相比的人或事物来比方。儗，古通“拟”，比拟。","source":{"text":"儗人必于其伦。","book":"语本《礼记·曲礼下》"},"example":{"text":"太白又与吴筠齐名，见唐史。虽～，时亦矫矫。","book":"明·明应麟《诗薮·唐下》"},"similar":["儗不于伦","拟非其伦"],"usage":"作谓语、宾语；指比拟不当"},{"id":6912,"word":"儿大不由娘","pinyin":"ér dà bù yóu niáng","abbr":"edbyn","explanation":"儿子长大了，由不得母亲作主。","source":{"text":"别说我是他妗子，我就是他娘，他‘儿大不由娘’，我也管不的他。","book":"清·西周生《醒世姻缘传》第89回"},"example":{"text":"～，我也没办法了。"},"similar":["儿大不由爷"],"usage":"作宾语、定语、分句；指孩子大了"},{"id":6913,"word":"儿大不由爷","pinyin":"ér dà bù yóu yé","abbr":"edbyy","explanation":"儿子长大了，由不得父亲作主。","source":{"text":"如今就是你把你大爷叫起来，儿大不由爷，他也管我不住。","book":"清·李绿园《歧路灯》第32回"},"example":{"text":"～，让他自己决定吧！"},"similar":["儿大不由爷"],"usage":"作宾语、定语、分句；指孩子大了"},{"id":6914,"word":"儿女之债","pinyin":"ér nǔ zhī zhài","abbr":"enzz","explanation":"债：欠债。旧指父母对子女的教养、婚嫁等所担负的责任和费用。","source":{"text":"愿相公早毕儿女之债。","book":"元·高明《琵琶记·丞相教女》"},"example":{"text":"为人父母就得承担这～。"},"usage":"作主语、宾语；指父母的责任"},{"id":6915,"word":"儿女之态","pinyin":"ér nǔ zhī tài","abbr":"enzt","explanation":"儿女间表现的情态。常指缠绵悱恻，恋恋不舍等。","source":{"text":"无为儿女态，憔悴悲贱贫。","book":"唐·韩愈《北极一首赠李观》"}},{"id":6916,"word":"儿女之情","pinyin":"ér nǔ zhī qíng","abbr":"enzq","explanation":"特指男女之间缠绵的恋情。","source":{"text":"孩儿今已离尘奉道，岂复有儿女之情。","book":"明·冯梦龙《警世通言·范鳅儿双镜重圆》"},"example":{"text":"今为～，一时不能自禁，猖狂至此。","book":"明·凌濛初《二刻拍案惊奇·满少卿饥附饱飏》"},"similar":["儿女私情"],"usage":"作主语、宾语、定语；用于男女间"},{"id":6917,"word":"儿女亲家","pinyin":"ér nǚ qìng jiā","abbr":"enqj","explanation":"指两家儿女结为婚姻的亲戚关系。","source":{"text":"历有数年，便发起财，也娶了亲，与秃头做个儿女亲家。","book":"《花月痕》第52回"},"example":{"text":"不管中人保人，你和他是～，你也好帮帮他的忙。","book":"洪深《香稻米》第二幕"},"similar":["指腹为婚"],"usage":"作宾语；指亲家的关系"},{"id":6918,"word":"儿女夫妻","pinyin":"ér nǚ fū qī","abbr":"enfq","explanation":"从小在一起长大的原配夫妻。","source":{"text":"他是你儿女夫妻，做这等勾当，你告他去，我是证见。","book":"元·无名氏《村乐堂》第二折"},"example":{"text":"他们是一对～。"},"similar":["结发夫妻"],"usage":"作宾语、定语；指原配"},{"id":6919,"word":"儿女子语","pinyin":"ér nǚ zǐ yǔ","abbr":"enzy","explanation":"妇孺之言。比喻不识大体的言论。","source":{"text":"汝为人将，不能以死敌我，乃欲以儿女子语诱我乎？","book":"《宋史·宗泽传》"},"usage":"作宾语、定语；用于蔑视"},{"id":6920,"word":"儿女心肠","pinyin":"ér nǚ xīn cháng","abbr":"enxc","explanation":"年轻男女的柔情。亦指感情丰富、助人为乐的心性。","source":{"text":"殊不知有了英雄至情，才成就得儿女心肠。","book":"清·文康《儿女英雄传》缘起首回"},"example":{"text":"秀姑这个人，秉着～，却有英雄气慨。","book":"张恨水《啼笑姻缘》第十六回"},"similar":["儿女之情"],"usage":"作宾语；指感情丰富、助人为乐的心肠"},{"id":6921,"word":"儿女情多","pinyin":"ér nǚ qíng duō","abbr":"enqd","explanation":"指男女相爱的感情丰富。","source":{"text":"项羽帐中之饮，荆卿易水之歌，何壮夫之懦节，伊儿女之情多。","book":"唐·卢照邻《五悲文·悲穷通》"},"similar":["儿女情长"],"usage":"作谓语、定语；用于人的感情"},{"id":6922,"word":"儿女情多，风云气少","pinyin":"ér nǚ qíng duō，fēng yún qì shǎo","abbr":"enqdfyqs","explanation":"指男女相爱的感情多，胸怀大局的气概少。比喻文艺作品中男欢女爱多，社会斗争题材少。","source":{"text":"虽名高曩代，而疏亮之士，犹恨其儿女情多，风云气少。","book":"南朝·梁·钟嵘《诗品·晋司空张华》"},"example":{"text":"齐、梁小赋，唐末小诗、五代小词，虽小却好，盖所谓‘～’也。","book":"清·刘熙载《艺概·词曲概》"},"similar":["儿女情长，英雄气短"],"usage":"作宾语、定语；用于口语"},{"id":6923,"word":"儿女情长","pinyin":"ér nǚ qíng cháng","abbr":"enqc","explanation":"指过分看重爱情。","source":{"text":"尤恨其儿女情多，风云气少。","book":"南朝·梁·钟嵘《诗品》中"},"example":{"text":"这一晚，把个沈国英旅长，闹得未免有些～，英雄气短。","book":"张恨水《啼笑姻缘》第二十一回"},"similar":["舐犊情深","男欢女爱"],"opposite":["冷酷无情"],"usage":"作谓语、定语；指感情很深","story":["晋代著名诗人张华的代表作《七哀诗》，他喜欢模仿王粲的风格，词藻绚丽，讲究用字，追求诗事的华美，运用多种表现手法，在当时的名声很高。南朝梁代的钟嵘在《诗品》中评价是：“尤恨儿女情多，风云气少。”"]},{"id":6924,"word":"儿女情长，英雄气短","pinyin":"ér nǚ qíng cháng，yīng xióng qì duǎn","abbr":"enqcyxqd","explanation":"指男女之间恋情绵绵不断，而慷慨奋发的气概消沉不足。","source":{"text":"人常说道儿女情长，英雄气短。宋公明为人倒是反这两句话，故此担阁了嫂嫂。","book":"明·许自昌《水浒记》第18出"},"example":{"text":"这一晚，把个沈国英旅长，闹得未免有些～。","book":"张恨水《啼笑姻缘》第21回"},"similar":["儿女情多，风云气少"],"usage":"作宾语、定语；用于口语"},{"id":6925,"word":"儿女成行","pinyin":"ér nǚ chéng háng","abbr":"ench","explanation":"可以把儿女排成一个行列。形容子女很多。","source":{"text":"昔别君未婚，儿女忽成行。","book":"唐·杜甫《赠卫八处士》"},"example":{"text":"乃密营别馆，众妾罗列，～。","book":"明·李贽《初潭集·夫妇一》"},"similar":["儿孙满堂"],"opposite":["断子绝孙","膝下孤独"],"usage":"作谓语、定语；形容子女很多"},{"id":6926,"word":"儿女私情","pinyin":"ér nǔ sī qíng","abbr":"ensq","explanation":"特指男女之间缠绵的恋情。","source":{"text":"孩儿今已离尘奉道，岂复有儿女之情。","book":"明·冯梦龙《警世通言·范鳅儿双镜重圆》"},"example":{"text":"从未将～，略萦心上。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["儿女之情"],"usage":"作主语、宾语、定语；用于男女间"},{"id":6927,"word":"儿女英雄","pinyin":"ér nǚ yīng xióng","abbr":"enyx","explanation":"指感情丰富，年轻有作为的英雄人物。","source":{"text":"纵横九万里，上下五千年，求其儿女英雄。一身兼备的，也只见得两个。","book":"清·文康《儿女英雄传》缘起首回"},"usage":"作主语、宾语、定语；用于夸奖"},{"id":6928,"word":"儿孙自有儿孙计","pinyin":"ér sūn zì yǒu ér sūn jì","abbr":"eszyesj","explanation":"后代人自然会为自己的生计作打算，做长辈的不必过多为此操心。","source":{"text":"汲汲光阴似水流，随风得过便须休。儿孙自有儿孙计，莫与儿孙做马牛。","book":"宋·徐守信《绝句》"}},{"id":6929,"word":"儿怜兽扰","pinyin":"ér lián shòu rǎo","abbr":"elsr","explanation":"怜：怜爱；扰：驯顺。像小孩儿那样惹人怜爱，像牲畜那样驯顺。","source":{"text":"儿怜兽扰，卒俾来臣。","book":"宋·欧阳修《文正范公神道碑铭》"},"usage":"作宾语、分句；用于书面语"},{"id":6930,"word":"儿怜瘦扰","pinyin":"ér lián shòu rǎo","abbr":"elsr","explanation":"像小孩一样加以抚爱，像野兽一样加以驯化。","source":{"text":"公居三年，怯勇隳完，儿怜瘦扰，卒俾来臣。","book":"宋·欧阳修《文正范公神道碑铭》"}},{"id":6931,"word":"儿皇帝","pinyin":"ér huáng dì","abbr":"ehd","explanation":"五代时期石敬瑭勾结契丹建立后晋，对契丹主自称儿皇帝。后泛指投靠外国，建立傀儡政权的统治者。","source":{"text":"学士以先君之命为书以赐国君，其书常曰：‘报儿皇帝云。’","book":"《新五代史·四夷附录第一》"},"example":{"text":"伪满政府曾经成为日本统治下的～。"},"usage":"作宾语、定语；指卖国求荣的人","story":["五代时期，石敬瑭起兵反唐被契丹王野律德光册立为晋国儿皇帝。石敬瑭死后由儿子石重光继位即出帝。944年，契丹进犯晋国，出帝率军抵抗失败，皇太后李氏写降书请求皇帝阿翁放他们一条生路，表示自己说过的话驷马难追"]},{"id":6932,"word":"儿童之见","pinyin":"ér tóng zhī jiàn","abbr":"etzj","explanation":"比喻幼稚无知的言论。","source":{"text":"如子虚亡是公相与问答，皆赋矣。而统谓之叙，此与儿童之见何异。","book":"宋·苏轼《答刘沔都曹书》"},"example":{"text":"其愚陋无识特～耳。","book":"明·方孝孺《读三略》"},"opposite":["远见卓识"],"usage":"作宾语；指无知"},{"id":6933,"word":"儿童走卒","pinyin":"ér tóng zǒu zú","abbr":"etzz","explanation":"比喻见闻最浅陋的人。","source":{"text":"光居洛十五年，儿童走卒皆知司马君实。","book":"《宋史·司马光传》"},"example":{"text":"明之末世，五遭倾覆，一命之士，文学之儒，无不建义旗以抗仇敌者，下至贩夫乞子，～，执志不屈而仰药剚刃以死者，不可胜计也。","book":"章炳麟《驳康有为论革命书》"},"usage":"作主语、宾语、定语；用于口语"},{"id":6934,"word":"儿行千里母担忧","pinyin":"ér xíng qiān lǐ mǔ dān yōu","abbr":"exqlmdy","explanation":"子女出远门在外，做母亲的心里总是牵挂不已。形容母爱真挚深厚。","source":{"text":"你这个冤家，在何处饮酒，这早晚方回，全不知儿行千里母担忧。","book":"清·褚人获《隋唐演义》第二十四回"},"example":{"text":"清·姜振名《永庆升平前传》第40回：“逢年过节，老太太时常想念，不过是～。”"},"usage":"作宾语、定语；用于母子关系"},{"id":6935,"word":"兀兀穷年","pinyin":"wù wù qióng nián","abbr":"wwqn","explanation":"兀兀：劳苦的样子；穷年：终年。一年到头辛苦劳动，勤劳不懈。","source":{"text":"故工人之用钝器也，劳筋苦骨，终日矻矻。","book":"东汉·班固《汉书·王褒传》"},"example":{"text":"他从唐诗下手，目不窥园，足不下楼，～，呕心沥血。","book":"臧克家《闻一多先生的说和做》"},"usage":"作谓语；指辛勤劳动"},{"id":6936,"word":"允恭克让","pinyin":"yǔn gōng kè ràng","abbr":"ygkr","explanation":"允：诚信；克：能够；让：谦让。诚实、恭敬又能够谦让。","source":{"text":"曰若稽古帝尧，曰放勋，钦、明、文、思、安安，允恭克让，光被四表，格于上下。","book":"《尚书·尧典》"},"example":{"text":"先大行皇帝天表奇伟、大智夙成、宏才肆应、～、宽裕有容、天章睿发、烛照如神。（二月河《乾隆皇帝》四）"},"usage":"作谓语、定语；用于书面语"},{"id":6937,"word":"允执其中","pinyin":"yǔn zhí qí zhōng","abbr":"yzqz","explanation":"允：诚信；执：保持；其：代词，那个；中：不偏不倚。真诚地坚持中庸之道。比喻真正做到恰到好处。","source":{"text":"天之历数在尔躬，允执其中。","book":"《尚书·大禹谟》：“人心惟危，道心惟微，惟精惟一，允执厥中。”《论语·尧曰》"},"example":{"text":"僧伽罗辞不获免，～，恭揖群官，遂即王位。","book":"唐·玄奘《大唐西域记·僧伽罗国》"},"similar":["允执厥中"],"usage":"作谓语；比喻真正做到恰到好处"},{"id":6938,"word":"允执厥中","pinyin":"yǔn zhí jué zhōng","abbr":"yzjz","explanation":"指言行符合不偏不倚的中正之道。","source":{"text":"人心惟危，道心惟微，惟精惟一，允执厥中。","book":"《书·大禹谟》"},"example":{"text":"圣人之道，中而已矣，堯、舜、禹三圣人为万世法，一‘～’也。","book":"明·方孝儒《夷齐》"},"similar":["允执其中"],"usage":"作谓语、定语；用于处事"},{"id":6939,"word":"允文允武","pinyin":"yǔn wén yǔn wǔ","abbr":"ywyw","explanation":"允：文言助词。形容能文能武。","source":{"text":"允文允武，昭假烈祖。","book":"《诗经·鲁颂·泮水》"},"example":{"text":"传忠传孝，～。","book":"明·张岱《孙忠烈公世乘序》"},"similar":["能文能武","文武双全"],"usage":"作谓语、定语；指文武双全"},{"id":6940,"word":"允理惬情","pinyin":"yǔn lǐ qiè qíng","abbr":"ylqq","explanation":"允：得当；惬：合适。指合情合理。","source":{"text":"常谓中都之制，允理惬情。","book":"《梁书·顾宪之传》"},"similar":["合情合理"],"usage":"作谓语、定语；用于书面语"},{"id":6941,"word":"元亨利贞","pinyin":"yuán hēng lì zhēn","abbr":"yhlz","explanation":"《周易》乾卦卦辞。用作序数，相当于甲、乙、丙、丁","source":{"text":"元者，善之长也；亨者，嘉之合也；利者，义之和也；贞者事之干也。君子行此四德者，故曰：乾，元亨利贞。","book":"《周易·乾·文言》"},"example":{"text":"清·李百川《绿野仙踪》第91回：“可是～的元字么？”"},"similar":["甲乙丙丁"],"usage":"作宾语、定语；用于书面语"},{"id":6942,"word":"元元之民","pinyin":"yuán yuán zhī mín","abbr":"yyzm","explanation":"众百姓；善良的百姓。","source":{"text":"即元元之民，冀得安其性命，莫不虚心而仰上。","book":"汉·贾谊《过秦论》"},"example":{"text":"～，莫不乐安于无事。","book":"清·龙启瑞《读曹参传书后》"},"usage":"作主语、宾语；用于书面语"},{"id":6943,"word":"元元本本","pinyin":"yuán yuán běn běn","abbr":"yybb","explanation":"元元：探索原始；本本：寻求根本。原指探索事物的根由底细。后指详细叙述事情的全部起因和整个过程，一点不漏。","source":{"text":"元元本本，殚见洽闻。","book":"汉·班固《西都赋》"},"example":{"text":"他把这件事情～地陈述了一遍。"},"similar":["原原本本"],"usage":"作宾语、状语；指事情的过程"},{"id":6944,"word":"元凶巨恶","pinyin":"yuán xiōng jù è","abbr":"yxje","explanation":"后指元凶魁首。","source":{"text":"王曰：‘封，元恶大憝，矧惟不孝不友。’","book":"《尚书·康诰》"},"example":{"text":"段誉伸左手拭了拭眼泪，心下一片茫然，想要以六脉神剑杀了眼前这个～，为父母报仇。","book":"金庸《天龙八部》第四十八回"},"similar":["元恶大奸","元恶大憝"],"usage":"作主语、宾语、定语；指坏人"},{"id":6945,"word":"元凶首恶","pinyin":"yuán xiōng shǒu è","abbr":"yxse","explanation":"罪魁祸首。","source":{"text":"据着我胸襟胆气，焉敢拒敌官军，剪除君侧元凶首恶？","book":"明·施耐庵《水浒传》第20回"},"similar":["罪魁祸首","大奸极恶"],"usage":"作主语、宾语；指坏头目"},{"id":6946,"word":"元奸巨恶","pinyin":"yuán jiān jù è","abbr":"yjje","explanation":"指大奸首恶。","source":{"text":"若果然当此之际，一毫马脚不露，那人便是元奸巨恶，还合他讲甚么性情来！","book":"清·文康《儿女英雄传》第二十七回"},"example":{"text":"不是那～，和曹孟德一样的行为；就是个木偶刍灵，和晋惠帝一般的人物。","book":"清·张春帆《九尾龟》第七十一回"}},{"id":6947,"word":"元恶大奸","pinyin":"yuán è dà jiān","abbr":"yedj","explanation":"原指大为人所憎恶。后指元凶魁首。","source":{"text":"元恶大奸，莫此之甚。","book":"《后汉书·陈蕃传》"},"example":{"text":"圣人设赎刑，乃施於小过，俾民自新。若～，无可赎之理。","book":"《明史·杨慎传》"},"similar":["罪魁祸首","元恶大憝","元凶巨恶"],"usage":"作主语、宾语、定语；指坏人"},{"id":6948,"word":"元恶大憝","pinyin":"yuán è dà duì","abbr":"yedd","explanation":"元恶：首恶；憝：奸恶。原指大为人所憎恶。后指元凶魁首。","source":{"text":"自非元恶大憝，岂无欲善之心乎！","book":"宋·陈亮《与石天民》"},"example":{"text":"～，暴戾恣睢。","book":"明·归有光《与嘉定诸友书》"},"similar":["罪魁祸首","元恶大奸"],"usage":"作主语、宾语、定语；指坏人"},{"id":6949,"word":"元恶未枭","pinyin":"yuán è wèi xiāo","abbr":"yewx","explanation":"枭：杀头。指没有惩治首恶。","source":{"text":"方今天下骚扰，元恶未枭，君受大任，干国之重，而久自挹损，非所以光扬洪烈矣。","book":"《三国志·蜀志·诸葛亮传》"},"usage":"作谓语、定语；用于书面语"},{"id":6950,"word":"元戎启行","pinyin":"yuán róng qǐ xíng","abbr":"yrqx","explanation":"指大军出发。","source":{"text":"元戎十乘，以先启行。","book":"语本《诗·小雅·六月》"},"example":{"text":"唐·柳宗元《剑门铭》：“鼖鼓一振，～，取其渠魁，以为大戮。”"},"opposite":["班师回朝","凯旋而归"],"usage":"作谓语、定语；用于书面语"},{"id":6951,"word":"元方季方","pinyin":"yuán fāng jì fāng","abbr":"yfjf","explanation":"意指两人难分高下。后称兄弟皆贤为“难兄难弟”或“元方季方”。","source":{"text":"东汉陈寔有子陈纪字元方、陈谌字季方，两人皆以才德见称于世。元方之子长文与季方之子孝先各论其父功德，争之不能决，问于陈寔，寔曰：“元方难为兄，季方难为弟。”事见南朝·宋·刘义庆《世说新语·德行》。"},"example":{"text":"有～之长幼，传学诗学礼之门风。","book":"唐·杨炯《唐上骑都尉高君神道碑》"},"similar":["难兄难弟"],"usage":"作宾语、定语；用于书面语","story":["东汉时期，颖川县官陈寔廉洁奉公，百姓十分爱戴。他的儿子元方与季方也有很高的德行，被朝廷重用，他们的头像被挂在城墙上成为百姓学习的典范。孙子长文与孝先问陈寔他们的父亲谁的功德高，陈寔说：“元方难为兄，季方难为弟。”"]},{"id":6952,"word":"元经秘旨","pinyin":"yuán jīng mì zhǐ","abbr":"yjmz","explanation":"微妙的道理。","source":{"text":"所说言语，都是元经秘旨，不能记忆。","book":"清·袁枚《续新齐谐·雁岩仙女》"},"usage":"作宾语、定语；用于书面语"},{"id":6953,"word":"元轻白俗","pinyin":"yuán qīng bái sú","abbr":"yqbs","explanation":"元：指元稹；白：指白居易。泛指文笔粗俗浅近，轻浮靡丽。","source":{"text":"元轻白俗，郊寒岛瘦。","book":"宋·苏轼《祭柳子玉文》"},"example":{"text":"更著新声定场屋，～浪争先。","book":"宋·张扩《次韵徐端明师川清明见访小集》"}},{"id":6954,"word":"元龙豪气","pinyin":"yuán lóng háo qì","abbr":"ylhq","explanation":"元龙：三国时陈登，字元龙，曾慢待许氾；豪：豪放。形容性格豪放。","source":{"text":"氾曰：‘陈元龙湖海之士，豪气不除。’","book":"《三国志·魏志·陈登传》"},"usage":"作宾语、定语；指人的性格"},{"id":6955,"word":"元龙高卧","pinyin":"yuán lóng gāo wò","abbr":"ylgw","explanation":"元龙：三国时陈登，字元龙。原指陈登自卧大床，让客人睡下床。后比喻对客人怠慢无礼。","source":{"text":"元龙无客主之意，久不相与语，自上大床卧，使客卧下床。","book":"《三国志·魏书·陈登传》"},"example":{"text":"佳客相逢，女元龙何敢高卧。","book":"清·蒲松龄《聊斋志异·巧娘》"},"similar":["元龙豪气"],"usage":"作宾语、定语；指无礼"},{"id":6956,"word":"兄友弟恭","pinyin":"xiōng yǒu dì gōng","abbr":"xydg","explanation":"哥哥对弟弟友爱，弟弟对哥哥恭敬。形容兄弟间互爱互敬。","source":{"text":"皆因中国，雨顺风调，……兄友弟恭，夫义妻贤，中外和乐，以致祯祥屡现，百福咸臻。","book":"《史记·五帝本纪》：“使布五教于四方，父义，母慈，兄友弟恭，子孝，内平外成。”明·朱有燉《灵芝庆寿》第一折"},"example":{"text":"后世不论官宦和平民人家，只要是有产业的，兄弟叔侄争产，势同仇人，平日所讲的仁义忠信，～，全都一风吹了。","book":"姚雪垠《李自成》第一卷第十七章"},"opposite":["兄弟阋墙"],"usage":"作谓语、定语；用于家庭关系"},{"id":6957,"word":"兄弟参商","pinyin":"xiōng dì shēn shāng","abbr":"xdss","explanation":"参、商：星宿名，二星此出则彼没，永不相见。比喻兄弟之间不和睦。","source":{"text":"面有逸景之速，别有参商之阔。","book":"三国·魏·曹植《与吴季重书》"},"example":{"text":"他父母非良，～，告废了人伦大纲，因此上自上张。","book":"元·杨景贤《西游记》第五本第十八折"},"usage":"作宾语、定语；用于书面语"},{"id":6958,"word":"兄弟孔怀","pinyin":"xiōng dì kǒng huái","abbr":"xdkh","explanation":"孔：甚、很；怀：思念。兄弟彼此之间非常思念、关怀。指兄弟间的友爱之情。","source":{"text":"死丧之威，兄弟孔怀。","book":"《诗经·小雅·常棣》"},"example":{"text":"死丧之威，～，愿为一郡，以恤幼孤。","book":"宋·苏轼《陈侗知陕州》"},"usage":"作谓语、定语；用于书面语","story":["隋朝京兆人田真、田广、田庆兄弟三人成家后，便要分家独自生活，堂屋前有一棵茂盛的紫荆树，他们计议第二天坎了分成三份。紫荆树一夜之间就枯死了，田真感慨地对兄弟说：“本同株，当分析便憔悴，况人兄弟孔怀，而可离异。”于是决定不分家了"]},{"id":6959,"word":"兄弟怡怡","pinyin":"xiōng dì yí yí","abbr":"xdyy","explanation":"兄弟和悦相亲的样子。","source":{"text":"朋友切切偲偲，兄弟怡怡。","book":"《论语·子路》"},"example":{"text":"你昨天竟急得那么样，叫旁人看了也不能不感动，这真所谓‘～’。","book":"鲁迅《彷徨·弟兄》"},"usage":"作谓语、定语；用于书面语"},{"id":6960,"word":"兄弟手足","pinyin":"xiōng dì shǒu zú","abbr":"xdsz","explanation":"亲如兄弟，情同手足。形容彼此之间的关系非常亲密。","source":{"text":"孝乎惟孝，友于兄弟，施于有政。","book":"《尚书·君陈》"},"example":{"text":"且如父子天性，～，这是一本连枝，割不断的。","book":"明·冯梦龙《警世通言》卷二"},"usage":"作宾语、定语；用于比喻句"},{"id":6961,"word":"兄弟阋于墙","pinyin":"xiōng dì xì yú qiáng","abbr":"xdxyq","explanation":"阋：争吵；墙：门屏。原指兄弟互相争吵。后比喻兄弟纷争。","source":{"text":"兄弟阋于墙，外御其侮。","book":"《诗经·小雅·常棣》"},"example":{"text":"季羡林《牛棚杂忆》：“则夫妻离婚者有之，父子反目者有之，至少也是‘～’，天天在家里吵架。”"},"similar":["兄弟阋于墙，外御其侮"],"usage":"作宾语、定语；用于兄弟之间"},{"id":6962,"word":"兄弟阋于墙，外御其侮","pinyin":"xiōng dì xì yú qiáng，wài yù qí wǔ","abbr":"xdxyqwyqw","explanation":"阋：争吵；墙：门屏。兄弟们虽然在家里争吵，但能一致抵御外人的欺侮。比喻内部虽有分歧，但能团结起来对付外来的侵略。","source":{"text":"兄弟阋于墙，外御其侮。","book":"《诗经·小雅·常棣》"},"example":{"text":"正是，兄弟阋墙，外御其侮。蜗角纷争，惟利是务。","book":"蔡东藩、许厪父《民国通俗演义》第一百三十回"},"similar":["阋墙御侮"],"usage":"作宾语、分句；形容兄弟"},{"id":6963,"word":"兄弟阋墙","pinyin":"xiōng dì xì qiáng","abbr":"xdxq","explanation":"阋：争斗。兄弟之间的纠纷，也比喻内部争斗。","source":{"text":"兄弟阋于墙，外御其侮。","book":"《诗经·小雅·常棣》"},"example":{"text":"而侠累那家伙，偏偏要～，引狼入室！","book":"郭沫若《棠棣之花》第二幕"},"similar":["祸起萧墙","同室操戈"],"opposite":["一致对外"],"usage":"作谓语、补语、分句；指内部争斗"},{"id":6964,"word":"兄弟阋墙，外御其侮","pinyin":"xiōng dì xì qiáng，wài yù qí wǔ","abbr":"xdxqwyqw","explanation":"阋：争吵；墙：门屏；御：抵御。兄弟们虽然在家里争吵，但一致抵御外人的欺侮。比喻内部虽有分歧，但能一致对外","source":{"text":"兄弟阋墙，外御其侮。蜗角纷争，惟利是务。","book":"蔡东藩《民国通俗演义》第130回"},"similar":["兄弟阋于墙，外御其侮"],"usage":"作宾语、分句；用于兄弟间"},{"id":6965,"word":"兄死弟及","pinyin":"xiōng sǐ dì jí","abbr":"xsdj","explanation":"原指哥哥死了，弟弟即位做君主。后也指弟弟接替哥哥的职位和事业。","source":{"text":"不与当，父死子继，兄死弟及之辞也。","book":"《公羊传·昭公二十二年》"},"similar":["兄终弟及"],"usage":"作谓语、定语；指弟承兄业"},{"id":6966,"word":"兄终弟及","pinyin":"xiōng zhōng dì jí","abbr":"xzdj","explanation":"原指哥哥死了，弟弟即位做君主。后也指弟弟接替哥哥的职位和事业。","source":{"text":"裂地王之，分财而赐之，父死子继，兄终弟及。","book":"《公羊传·昭公二十二年》：“不与当，父死子继，兄死弟及之辞也。”《汉书·武五子传》"},"example":{"text":"立子以嫡，礼也。然次于克，朕所缠爱，今以托卿。异日～，惟卿主持。","book":"明·冯梦龙《东周列国志》第十一回"},"similar":["兄死弟及"],"usage":"作谓语、定语；指弟承兄业"},{"id":6967,"word":"兄肥弟瘦","pinyin":"xiōng féi dì shòu","abbr":"xfds","explanation":"旧喻兄弟相爱，临难争死。","source":{"text":"及天下乱，人相食。孝弟礼为饿贼所得，孝闻之，即自缚诣贼，曰：‘礼久饿羸瘦，不如孝肥饱。’贼大惊，并放之。","book":"《后汉书·赵孝传》"},"example":{"text":"友于兄弟，分形共气，～，无复相代之期；让枣推梨，长罢欢愉之日。","book":"《南史·梁武陵王传》"},"usage":"作宾语、定语；用于兄弟之间","story":["汉朝末年，天下大乱，饥民遍野，人饿得吃人。赵孝的弟弟赵礼一次被盗贼捉住，即将被吃，赵孝绑起自己去见盗贼说赵礼饿得太瘦，不如自己肥胖能够让你们多吃一点。盗贼深感惊奇，便把他们兄弟二人都放了"]},{"id":6968,"word":"充天塞地","pinyin":"chōng tiān sāi dì","abbr":"ctsd","explanation":"指整个宇宙。","source":{"text":"‘你看这个天地中间，甚么是天地的心？’对曰：‘尝闻人是天地的心。’曰：‘人又甚么教做心？’对曰：‘只是一个灵明。’可知充天塞地中间，只有这个灵明。","book":"明·王守仁《传习录》卷下"},"usage":"作谓语、定语；用于事物等"},{"id":6969,"word":"充栋汗牛","pinyin":"chōng dòng hàn niú","abbr":"cdhn","explanation":"指书籍堆得高及栋梁，多至牛马运得出汗。形容藏书或著述之富。","source":{"text":"其为书，处则充栋宇，出则汗牛马。","book":"语出唐·柳宗元《陆文通先生墓表》"},"example":{"text":"在最后的不到百年间则作者几超出十倍，作品更为～，不可胜计。","book":"郑振铎《插图本中国文学史》第五八章"},"similar":["汗牛充栋"],"opposite":["屈指可数"],"usage":"作谓语；指非常多"},{"id":6970,"word":"充栋盈车","pinyin":"chōng dòng yíng chē","abbr":"cdyc","explanation":"chōng  dòng  yíng  chē","source":{"text":"充栋盈车，鞠为黄壤。","book":"明·胡应麟《诗薮·遗逸》"},"similar":["汗牛充栋"],"usage":"作谓语、定语；用于指藏书等"},{"id":6971,"word":"充箱盈架","pinyin":"chōng xiāng yíng jià","abbr":"cxyj","explanation":"充、盈：满。盛满书箱，摆满书架。形容藏书丰富。","source":{"text":"你看十三经、廿一史、九流三教、诸子百家、腐烂时文、新奇小说，上下充箱盈架，高低列肆连楼。","book":"清·孔尚任《桃花扇·逮社》"}},{"id":6972,"word":"充类至尽","pinyin":"chōng lèi zhì jìn","abbr":"clzj","explanation":"充类：推究同类事理；至尽：到极精密处。指就事理作充分的推论。","source":{"text":"夫谓非其有而取之者，盗也，充类至义之尽也。","book":"《孟子·万章下》"},"example":{"text":"而尚有几微之未尽善，则公当直指其其，或～，以见吾儒至精微处。","book":"清·叶廷琯《鸥陂渔话·杨硕甫事陆顾二公论辩》"},"usage":"作谓语；指用类推的办法把道理引申到顶"},{"id":6973,"word":"充耳不闻","pinyin":"chōng ěr bù wén","abbr":"cebw","explanation":"充：塞住。塞住耳朵不听。形容有意不听别人的意见。","source":{"text":"叔兮伯兮，褎如充耳。","book":"《诗经·邶风·旄丘》"},"example":{"text":"这里袁伯珍只装作～，一面出了告示，按户收起捐来。","book":"清·无名氏《官场维新记》第九回"},"similar":["不闻不问","装聋作哑"],"opposite":["洗耳恭听"],"usage":"作谓语、定语；表示对别人的意见不在意"},{"id":6974,"word":"充闾之庆","pinyin":"chōng lǚ zhī qìng","abbr":"clzq","explanation":"充闾：光大门楣；庆：喜庆。能使门第光大的喜庆事。","source":{"text":"贾充，字公闾，平阳襄陵人也。父逵魏豫州刺史、阳里亭侯。逵晚始生充，言后当有充闾之庆，故以为名字焉。","book":"《晋书·贾充传》"},"example":{"text":"贺生子，云～。","book":"宋·胡继宗《书言故事·子孙类》"},"similar":["弄璋之庆","弄璋之喜"],"usage":"作宾语；用于祝贺别人生子"},{"id":6975,"word":"充饥画饼","pinyin":"chōng jī huà bǐng","abbr":"cjhb","explanation":"画个饼子来解饿。比喻虚有其名而无补于实际。也比喻用空想来安慰自己。","source":{"text":"当初指雁为羹，充饥画饼，道无情却有情。","book":"元·宋方壶《醉花阴·走苏卿》"},"example":{"text":"～让人笑，但可以自我解嘲。"},"similar":["画饼充饥"],"usage":"作主语、定语、宾语；指用空想来安慰"},{"id":6976,"word":"兆载永劫","pinyin":"zhào zǎi yǒng jié","abbr":"zzyj","explanation":"佛教语。极言时间之悠远漫长。","source":{"text":"所修佛国，开廓广大，超胜独妙，建立常然，无衰无变；于不可思议兆载永劫，积植菩萨无量德行。","book":"《无量寿经》卷上"},"usage":"作谓语；指时间漫长"},{"id":6977,"word":"先下手为强","pinyin":"xiān xià shǒu wéi qiáng","abbr":"xxswq","explanation":"在对手没有准备好的时候首先动手，取得主动地位。","source":{"text":"兵马悉他家物，一先下手，大事便去。","book":"《隋书·元胄传》"},"example":{"text":"这个说不得。从来说“～”。况且原该是我的。","book":"明·凌濛初《二刻拍案惊奇》卷十七"},"similar":["先发制人"],"usage":"作谓语、分句；用于劝诫人"},{"id":6978,"word":"先下手为强，后下手遭殃","pinyin":"xiān xià shǒu wéi qiáng，hòu xià shǒu zāo yāng","abbr":"xxswqhxszy","explanation":"先下手可以取得优势，后动手常常吃亏。","source":{"text":"兵马悉他家物，一先下手，大事便去矣。","book":"《隋书·元胄传》"},"example":{"text":"不趁此时下手他，还到几时！正是～。","book":"明·吴承恩《西游记》第八十一回"},"similar":["先下手为强"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":6979,"word":"先为之容","pinyin":"xiān wèi zhī róng","abbr":"xwzr","explanation":"事先为人介绍，美言。","source":{"text":"蟠木根柢，轮囷离奇，而为万乘器者，何则？以左右先为之容也。","book":"汉·邹阳《狱中上书自明文》"},"usage":"作谓语、定语；用于书面语"},{"id":6980,"word":"先事虑事","pinyin":"xiān shì lǜ shì","abbr":"xsls","explanation":"做事之前要把事情考虑周全。","source":{"text":"先事虑事谓之接，接则事优成。","book":"《荀子·大略》"},"usage":"作谓语、定语；用于处事"},{"id":6981,"word":"先人后己","pinyin":"xiān rén hòu jǐ","abbr":"xrhj","explanation":"首先考虑别人，然后想到自己。","source":{"text":"子云：‘君子贵人而贱己，先人而后己。’","book":"《礼记·坊记》"},"example":{"text":"这也表现了他～、艰苦朴素的崇高品质。","book":"朱敏《深情怀念周伯伯》"},"similar":["大公无私"],"opposite":["先己后人"],"usage":"作谓语、定语、宾语；指考虑别人"},{"id":6982,"word":"先人夺人","pinyin":"xiān rén duó rén","abbr":"xrdr","explanation":"夺：争取。先于别人去夺取别人的心。","source":{"text":"赵盾曰：‘先人有夺人之心，军之善谋也。’","book":"春秋·鲁·左丘明《左传·文公七年》"},"usage":"作宾语、定语；用于处事"},{"id":6983,"word":"先从隗始","pinyin":"xiān cóng wěi shǐ","abbr":"xcks","explanation":"隗：指战国燕人郭隗；始：开始。以先任用我郭隗为开端。表示自我推荐。","source":{"text":"王必欲致士，先从隗始。况贤于隗者，岂远千里哉！","book":"《史记·燕昭公世家》"}},{"id":6984,"word":"先代所美","pinyin":"xian dai shuo mei","abbr":"xdsm","explanation":"这是前人所称道的事。"},{"id":6985,"word":"先入为主","pinyin":"xiān rù wéi zhǔ","abbr":"xrwz","explanation":"指先听进去的话或先获得的印象往往在头脑中占有主导地位，以后再遇到不同的意见时，就不容易接受。","source":{"text":"唯陛下观览古今，反复参考，无以先入之语为主。","book":"《汉书·息夫躬传》"},"example":{"text":"见长幼尊卑之节有一定不易之理，～，故后起之私心，终有所顾忌而不敢逞。","book":"清·阮葵生《茶余客话》卷七"},"similar":["先入之见"],"opposite":["实事求是","后来居上"],"usage":"作谓语、定语、宾语、分句；指观念等","story":["汉朝时期，汉哀帝宠信董贤、孙庞、息夫躬，给他们封侯。丞相王嘉劝哀帝不能封侯，避免生出祸患。息夫躬担心董贤权势越来越大，就劝哀帝对匈奴出兵，王嘉劝哀帝不要对他的意见先入为主，应该和平共处。息夫躬计谋败露遭灭门之祸"]},{"id":6986,"word":"先入之见","pinyin":"xiān rù zhī jiàn","abbr":"xrzj","explanation":"指在对某事物进行调查研究之前就形成或接受的看法。指成见。","source":{"text":"唯陛下观览古今，反复参考，无以先入之语为主。","book":"《汉书·息夫躬传》"},"example":{"text":"我们常不免有一种～，看见讽刺作品，就觉得这不是文学上的正路。","book":"鲁迅《且介亭杂文二集·论讽刺》"},"similar":["先入为主","自以为是"],"opposite":["放马后炮"],"usage":"作宾语；指成见"},{"id":6987,"word":"先公后私","pinyin":"xiān gōng hòu sī","abbr":"xghs","explanation":"先以公事为重，然后考虑私事。","source":{"text":"忧公忘私者必不然，但先公后私即自办也。","book":"《三国志·魏志·杜恕传》"},"example":{"text":"卿～，可谓大忠矣。","book":"明·冯梦龙《东周列国志》第九十七回"},"usage":"作谓语、宾语、定语；指处理公私关系"},{"id":6988,"word":"先务之急","pinyin":"xiān wù zhī jí","abbr":"xwzj","explanation":"先务：最需要先做的事。指最急着要做的事。","source":{"text":"知者无不知也，当务之为急；仁者无不爱也，急亲贤之为务。","book":"《孟子·尽心上》"},"example":{"text":"陛下移跸东南，将图恢复之举，～，宜莫如兵。","book":"清·毕沅《续资治通鉴》卷一百一十"},"similar":["当务之急"],"usage":"作主语、宾语；用于处事"},{"id":6989,"word":"先即制人","pinyin":"xiān jí zhì rén","abbr":"xjzr","explanation":"制：控制。先下手取得主动就可制服对方。泛指做事应先争取主动。","source":{"text":"吾闻，先即治人，后则为人所制。","book":"西汉·司马迁《史记·项羽本纪》"},"similar":["先发制人"],"usage":"作谓语、宾语、定语；指主动出击"},{"id":6990,"word":"先发制人","pinyin":"xiān fā zhì rén","abbr":"xfzr","explanation":"发：开始行动；制：控制，制服。原指丢动手的牌主动地位，可以控制对方。后也泛指争取主动，先动手来制服对方。","source":{"text":"先发制人，后发制于人。","book":"《汉书·项籍传》"},"example":{"text":"剑波没等这位警长开口，便理直气壮地来个～。","book":"曲波《林海雪原》三"},"similar":["先声夺人","先下手为强"],"opposite":["后发制人"],"usage":"作谓语、宾语、定语、状语；指主动出击","story":["秦末，陈胜吴广起义后，会稽太守殷通也蠢蠢欲动，请有威望的项梁去商量起义的事宜。项梁听殷通说“先即制人，后则为人所制”就反客为主，叫项羽杀了殷通，自立为会稽太守，然后率领八千江东子弟宣布起义反秦"]},{"id":6991,"word":"先号后庆","pinyin":"xiān hào hòu qìng","abbr":"xhhq","explanation":"指初凶后吉。","source":{"text":"鲍永沉吟，晚乃归正，志达义全，先号后庆。","book":"南朝·宋·范晔《后汉书·申屠刚鲍永等传赞》"},"similar":["先号后笑"],"opposite":["先笑后号"],"usage":"作谓语、定语；用于处事等"},{"id":6992,"word":"先号后笑","pinyin":"xiān hào hòu xiào","abbr":"xhhx","explanation":"①指命运先凶后吉。②指文章或著作结尾比开头精彩。","source":{"text":"九五，同人先号咷而后笑，大师克相遇。","book":"《易·同人》"},"example":{"text":"所最可惜者，本是通经著述之书，却言为举业而作，先之以标题举业，继之以别论经义，～，曲终奏雅，高明之士一见讲章面目，不待终卷已欠申恐卧矣。清·钱谦益《与"},"similar":["先号后庆"],"opposite":["先笑后号"],"usage":"作谓语、定语；用于处事等"},{"id":6993,"word":"先吾著鞭","pinyin":"xiān wǔ zhuó biān","abbr":"xwzb","explanation":"著鞭：上马挥鞭。比喻快走一步，占先。","source":{"text":"吾枕戈待旦，志枭逆虏，常恐祖生先吾著鞭耳。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"similar":["先我着鞭"],"usage":"作谓语；指抢先一步"},{"id":6994,"word":"先国后己","pinyin":"xiān guó hòu jǐ","abbr":"xghj","explanation":"把国事放在自己事的前面。","source":{"text":"辞不忘国，忠信也；先国后己，卑让也。","book":"《左传·昭公二年》"}},{"id":6995,"word":"先圣先师","pinyin":"xiān shèng xiān shī","abbr":"xsxs","explanation":"旧时尊称孔子；也称周公和孔子或孔子和颜渊。","source":{"text":"凡始立学者，必释奠于先圣先师。","book":"《礼记·文王世子》"},"usage":"作主语、宾语、定语；指孔子"},{"id":6996,"word":"先声后实","pinyin":"xiān shēng hòu shí","abbr":"xshs","explanation":"声：声势；实：实力。比喻先用声势挫折敌方士气，然后交战。","source":{"text":"兵固有先声而后实者，此之谓也。","book":"《史记·淮阴侯列传》"},"example":{"text":"臣艾切谓兵有先声而后实者，今因平蜀之势以乘吴，此席卷之时也。","book":"明·罗贯中《三国演义》第一百十八回"},"similar":["先声夺人","先礼后兵"],"usage":"作谓语、定语；指先礼后兵"},{"id":6997,"word":"先声夺人","pinyin":"xiān shēng duó rén","abbr":"xsdr","explanation":"先张扬自己的声势以压倒对方。也比喻做事抢先一步。","source":{"text":"军志曰：‘先人有夺人之心，’薄之也。","book":"《左传·宣公十二年》"},"example":{"text":"他深深懂得～的道理，就预先做了广告，因此货销售得很快。"},"similar":["先发制人"],"opposite":["甘拜下风"],"usage":"作谓语、定语、状语；指做事抢先一步","story":["东汉末年，地方官吏割据一方，曹操、孙权、刘表、袁绍等积极扩充自己的地盘。刘备也不甘示弱，听徐庶说诸葛亮是一个军事天才，就三顾茅庐请出诸葛亮，引起了张飞、关羽的不满。刘备说：“我得到孔明，如鱼得水，你们不必再说了。"]},{"id":6998,"word":"先天下之忧而忧，后天下之乐而乐","pinyin":"xiān tiān xià zhī yōu ér yōu，hòu tiān xià zhī lè ér lè","abbr":"xtxzyeyhtxzlel","explanation":"忧虑在天下人之前，享受在天下人之后。比喻吃苦在前，享受在后。","source":{"text":"然则何时而乐耶？其必曰：‘先天下之忧而忧，后天下之乐而乐乎！’","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"在被贬外逐时，还念念不忘‘～。’","book":"陶斯亮《一封终于发出的信》"},"similar":["吃苦在前，享受在后"],"usage":"作宾语、定语、分句；用于处世等","story":["宋朝时期，滕子京因遭诬陷被贬到岳州当知州，重新修复了岳阳楼，范仲淹受他的嘱托写一篇《岳阳楼记》：“古代的仁人志士不因美景而高兴，也不因处境坏而哀伤，总是先天下之忧而忧，后天下之乐而乐。”"]},{"id":6999,"word":"先天不足","pinyin":"xiān tiān bù zú","abbr":"xtbz","explanation":"先天：人或动物的胚胎时期。原指人或动物生下来体质就不好。后也指事物的根基差。","source":{"text":"小弟闻得仙人与虚合体，日中无影；又老人之子，先天不足，亦或日中无影。寿麻之人无影，不知何故？","book":"清·李汝珍《镜花缘》第二十六回"},"example":{"text":"但是，剧本中若只出现几个店员，总显得有些～。","book":"老舍《我怎么写〈春华秋实〉剧本》"},"similar":["后天不良"],"opposite":["得天独厚"],"usage":"作谓语、定语、分句；用于人或事物"},{"id":7000,"word":"先小人后君子","pinyin":"xiān xiǎo rén hòu jūn zǐ","abbr":"xxrhjz","explanation":"先不讲客气，说明条件，按章办事，然后再讲礼貌。","source":{"text":"凡事先小人后君子好，先君子后小人就不好了。","book":"清·西周生《醒世姻缘传》第49回"},"example":{"text":"我们还是～，把条件讲清楚。"},"opposite":["先礼后兵"],"usage":"作谓语、定语；指丑化说在前边"},{"id":7001,"word":"先小人，后君子","pinyin":"xiān xiǎo rén，hòu jūn zǐ","abbr":"xxrhjz","explanation":"先做小人，后做君子。指先把计较利益得失的话说在前头，然后再讲情谊。","source":{"text":"化这们说。凡事先小人后君子好，先君子后小人就不好了。","book":"清·西周生《醒世姻缘传》第四十九回"},"example":{"text":"咱们～。说明了，我可就给一间的房钱。","book":"清·石玉昆《三侠五义》第三十二回"}},{"id":7002,"word":"先庚后庚","pinyin":"xiān gēng hòu gēng","abbr":"xghg","explanation":"先后申令各三天，使得大家都知道。","source":{"text":"先庚三日，后庚三日。","book":"《周易·巽》"},"example":{"text":"至于巽之九五，以其上下皆柔，故必无初有终，是故～，不为物首也。","book":"宋·张载《横渠易说》"}},{"id":7003,"word":"先得我心","pinyin":"xiān dé wǒ xīn","abbr":"xdwx","explanation":"得：适合，契合。比喻别人先说出了自己心里想说的话。","source":{"text":"心之所同然者何也？谓理也、义也。圣人先得我心之所同然耳，故理义之悦我心，犹刍豢之悦我口。","book":"《孟子·告子上》"},"example":{"text":"心之所同然者何也？谓理也，义也，性善也。圣人～之所同然耳，性相近也。","book":"清·陈澧《东塾读书记·孟子》"},"similar":["先获我心"],"usage":"作宾语；用于称赞别人"},{"id":7004,"word":"先忧事者后乐事，先乐事者后忧事","pinyin":"xiān yōu shì zhě hòu lè shì，xiān lè shì zhě hòu yōu shì","abbr":"xyszhlsxlszhys","explanation":"先为事业而忧虑，后来就为事业的成功而安乐；事业未成先享乐，后来就会为事业而忧虑。","source":{"text":"先忧事者后乐事，先乐事者后忧事。","book":"汉·戴德《大戴礼记·曾子立事》"},"similar":["先忧事者后乐，先傲事者后忧"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7005,"word":"先忧事者后乐，先傲事者后忧","pinyin":"xiān yōu shì zhě hòu lè,xiān ào shì zhě hòu yōu","abbr":"xyszhlxaszhy","explanation":"先为事业而忧虑，后来就为事业的成功而安乐；事业未成先骄傲，后来就会为事业而忧虑。","source":{"text":"先忧事者后乐，先傲事者后忧。","book":"汉·刘向《说苑·谈丛》"},"similar":["先忧事者后乐事，先乐事者后忧事"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7006,"word":"先忧后乐","pinyin":"xiān yōu hòu lè","abbr":"xyhl","explanation":"忧虑在天下人之先，安乐在天下人之后。比喻吃苦在先，享受在后。","source":{"text":"先天下之忧而忧，后天下之乐而乐。","book":"汉·刘向《说苑·谈丛》：“先忧事者后乐，先傲世者后忧。”宋·范仲淹《岳阳楼记》"},"example":{"text":"你～师忠彦，由义居仁效昔贤。","book":"明·无名氏《鸣凤记·邹林游学》"},"similar":["先天下之忧而忧，后天下之乐而乐"],"usage":"作谓语、定语；用于大公无私的人","story":["宋朝时期，滕子京因遭诬陷被贬到岳州当知州，重新修复了岳阳楼，范仲淹受他的嘱托写一篇《岳阳楼记》：“古代的仁人志士不因美景而高兴，也不因处境坏而哀伤，总是先天下之忧而忧，后天下之乐而乐。”"]},{"id":7007,"word":"先忧后喜","pinyin":"xiān yōu hòu xǐ","abbr":"xyhx","explanation":"先愁苦，后欢乐。比喻吃苦在先，安乐在后。","source":{"text":"先天下之忧而忧，后天下之乐而乐。","book":"汉·刘向《说苑·谈丛》：“先忧事者后乐，先傲世者后忧。”宋·范仲淹《岳阳楼记》"},"example":{"text":"您稳放着个～，我空怀着个有苦无甘。","book":"元·贾仲名《萧淑兰》第二折"},"similar":["先忧后乐"],"usage":"作谓语、定语；用于处事"},{"id":7008,"word":"先悉必具","pinyin":"xiān xī bì jù","abbr":"xxbj","explanation":"纤悉：细微详尽。细微详尽，全都载明。","source":{"text":"律于发冢之条，如知情买卖器物砖石、薰猩平园之类，纤悉必具。","book":"明·归有光《上宋明府书》"},"example":{"text":"凡促织之态貌性情，～。","book":"明·袁宏道《蓄促织》"}},{"id":7009,"word":"先意希旨","pinyin":"xiān yì xī zhǐ","abbr":"xyxz","explanation":"指孝子不等父母开口就能顺父母的心意去做。后指揣摸人意，谄媚逢迎。同“先意承志”。","source":{"text":"君子之所为孝者，先意承志，谕父母于道。","book":"《韩非子·八奸》：“此人主未命而唯唯，未使而诺诺，先意承旨，观貌察色，以先主心者也。”《礼记·祭义》"},"example":{"text":"贾能～，偁常疾之。","book":"清·毕沅《续资治通鉴》卷十"},"similar":["先意承志","先意承旨","先意承指"],"usage":"作谓语、宾语、定语；用于处事"},{"id":7010,"word":"先意承志","pinyin":"xiān yì chéng zhì","abbr":"xycz","explanation":"指孝子不等父母开口就能顺父母的心意去做。后指揣摸人意，谄媚逢迎。","source":{"text":"君子之所为孝者，先意承志，谕父母于道。","book":"西汉·戴圣《礼记·祭义》"},"example":{"text":"我不是别人，那知道别人的意思呢？‘～’的妙法，又未曾学过。","book":"鲁迅《华盖集续编·海上通信》"},"similar":["先意承旨"],"usage":"作谓语、定语；指奉承上级"},{"id":7011,"word":"先意承指","pinyin":"xiān yì chéng zhǐ","abbr":"xycz","explanation":"指孝子不等父母开口就能顺父母的心意去做。后指揣摸人意，谄媚逢迎。同“先意承志”。","source":{"text":"先意承指者，佞谄之徒也。","book":"晋·葛洪《抱朴子·臣节》"},"similar":["先意承志","先意承旨","先意希旨"],"usage":"作谓语、宾语、定语；用于处事"},{"id":7012,"word":"先意承旨","pinyin":"xiān yì chéng zhǐ","abbr":"xycz","explanation":"先意：超先想到；承旨：遵从意旨。原指不等父母开口就能迎合父母的心意去做。后指揣摸上级意图，极力奉承。","source":{"text":"君子之所为孝者，先意承志，谕父母于道。","book":"《韩非子·八奸》：“此人主未命而唯唯，未使而诺诺，先意承旨，观貌察色，以先主心者也。”《礼记·祭义》"},"similar":["先意承指","先意承志","先意希旨"],"usage":"作谓语、宾语、定语；指奉承上级"},{"id":7013,"word":"先意承颜","pinyin":"xiān yì chéng yán","abbr":"xycy","explanation":"指孝子不等父母开口就能顺父母的心意去做。后指揣摸人意，谄媚逢迎。同“先意承志”。","source":{"text":"未知养亲者，欲其观古人之先意承颜，怡声下气。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["先意承志","先意承指","先意承旨"],"usage":"作谓语、定语；指奉承上级"},{"id":7014,"word":"先我着鞭","pinyin":"xiān wǒ zhuó biān","abbr":"xwzb","explanation":"着：下。比喻快走一步，占先。","source":{"text":"吾枕戈待旦，志枭逆虏，常恐祖先生吾着鞭耳。","book":"南朝宋·刘义庆《世说新语·赏誉》"},"example":{"text":"我国若不先自下手，自办银行，自筑铁路，必被外人～，倒是心腹大患哩。","book":"清·曾朴《孽海花》第十八回"},"similar":["先吾著鞭"],"usage":"作谓语；指抢先一步"},{"id":7015,"word":"先斩后奏","pinyin":"xiān zhǎn hòu zòu","abbr":"xzhz","explanation":"原指臣子先把人处决了，然后再报告帝王。现比喻未经请示就先做了某事，造成既成事实，然后再向上级报告。","source":{"text":"珍偏将张仁遇珍曰：‘ 军中有犯令者，请先斩而后白。’","book":"《汉书·申屠嘉传》：“吾悔不先斩错乃请之。”颜师古注：“言先斩而后奏。”《新五代史·梁臣传·朱珍》"},"example":{"text":"圣人命俺巡抚江南，敕赐势剑金牌，体察奸蠹，理枉分冤，～。","book":"元·无名氏《冯玉兰》第三折"},"similar":["先礼后兵","先斩后闻","先行后闻"],"opposite":["事先请示"],"usage":"作谓语、宾语、定语；用于办事","story":["窦天章为了换取上京赶考的路费，把女儿窦娥抵押给蔡婆婆做童养媳，10年后窦娥的丈夫去世，地痞张驴儿想霸占窦娥，诬陷她毒死他的父亲。窦娥被官府断案不明斩杀。6年后深受皇帝信任有先斩后奏之权的窦天章为女儿伸了冤"]},{"id":7016,"word":"先斩后闻","pinyin":"xiān zhǎn hòu wén","abbr":"xzhw","explanation":"原指臣子先把人处决了，然后再报告帝王。现比喻未经请示就先做了某事，造成既成事实，然后再向上级报告。","source":{"text":"申屠悔不先斩而后奏，故发愤而致死。","book":"《汉书·申屠嘉传》：“吾悔不先斩错乃请之。”颜师古注：“言先斩而后奏。”北齐·刘昼《刘子·贵速》"},"example":{"text":"奉圣人的命，着老夫再差一员正直的去陈州，结断此一桩公事，就敕赐势剑金牌，～。","book":"元·无名氏《陈州粜米》第二折"},"similar":["先斩后奏","先行后闻","先断后闻"],"usage":"作谓语、宾语、定语；用于办事"},{"id":7017,"word":"先断后闻","pinyin":"xiān duàn hòu wén","abbr":"xdhw","explanation":"指先处理后奏闻。","source":{"text":"护第屯兵禁卫，盛于宫阙，事无巨细，皆先断后闻。","book":"《北史·宇文护传》"},"similar":["先斩后奏","先行后闻"],"usage":"作谓语、定语、宾语；用于处事"},{"id":7018,"word":"先来后到","pinyin":"xiān lái hòu dào","abbr":"xlhd","explanation":"按照来到的先后确定次序。","source":{"text":"何作嗟迟疾，从来有后先，所期皆一到，我到尔应还。","book":"宋·梅尧臣《宛陵文集》"},"example":{"text":"像和尚、道士家，师兄师弟，只论～，不论年纪。","book":"清·李绿园《歧路灯》"},"similar":["先入为主"],"opposite":["惩前毖后"],"usage":"作谓语、宾语；用于人或事"},{"id":7019,"word":"先河后海","pinyin":"xiān hé hòu hǎi","abbr":"xhhh","explanation":"先祭河神，后祭海神。比喻治学要弄清源流。","source":{"text":"三王之祭川也，皆先河而后海，或源也，或委也，此之谓务本。","book":"《礼记·学记》"},"example":{"text":"清·陈康祺《郎潜纪闻》第九卷：“非～之义，宜增入者。”"},"usage":"作宾语、定语；用于书面语"},{"id":7020,"word":"先甲后甲","pinyin":"xiān jiǎ hòu jiǎ","abbr":"xjhj","explanation":"先后申令各三日，使众人都知道。","source":{"text":"先甲三日，后甲三日。","book":"《周易·蛊》"}},{"id":7021,"word":"先睹为快","pinyin":"xiān dǔ wéi kuài","abbr":"xdwk","explanation":"睹：看见。以能尽先看到为快乐。形容盼望殷切。","source":{"text":"朝廷之士，引颈东望，若景星凤皇之始见也，争先睹之为快。","book":"唐·韩愈《与少室李拾遗书》"},"example":{"text":"现在我们特地和西滢先生商量，把“闲话”选集起来，印成专书，留心文艺界掌故的人，想必都以～。","book":"鲁迅《而已集·革“首领”》"},"similar":["近水楼台"],"opposite":["后发制人"],"usage":"作谓语、宾语、定语；指优先观看"},{"id":7022,"word":"先知先觉","pinyin":"xiān zhī xiān jué","abbr":"xzxj","explanation":"知：认识；觉：觉悟。指认识事理较一般人为早的人。","source":{"text":"使先知觉后知，使先觉觉后觉也。","book":"《孟子·万章下》"},"example":{"text":"文艺家先时讲的话，渐渐大家都记起来了，大家都赞成他，恭维他是～。","book":"鲁迅《集外集·文艺与政治的歧途》"},"similar":["先见之明","先觉先知"],"opposite":["后知后觉"],"usage":"作主语、宾语、定语；指对事物的认识"},{"id":7023,"word":"先礼后兵","pinyin":"xiān lǐ hòu bīng","abbr":"xlhb","explanation":"礼：礼貌；兵：武力。先按通常的礼节同对方交涉，如果行不能，再用武力或其他强硬手段解决。","source":{"text":"刘备远来救援，先礼后兵，主公当用好言答之，以慢备心，然后进兵攻城，城可破也。","book":"明·罗贯中《三国演义》第十一回"},"example":{"text":"你这～方法实在高明。"},"similar":["先声夺人"],"opposite":["突然袭击","不宣而战"],"usage":"作谓语、宾语、分句；指办事方法巧妙","story":["东汉末年，曹操攻打徐州，徐州太守陶谦派人请刘备出兵解围，刘备率关羽、张飞攻入徐州。陶谦要让位给刘备。刘备给曹操写信请他退兵，来一个先礼后兵。曹操想杀来使，谋士郭嘉劝止，刚好吕布攻打兖州，曹操只好给刘备一个面子"]},{"id":7024,"word":"先笑后号","pinyin":"xiān xiào hòu hào","abbr":"xxhh","explanation":"指命运先吉后凶。","source":{"text":"九五，同人先号咷而后笑，大师克相遇。","book":"《易·同人》"},"opposite":["先号后笑"],"usage":"作谓语、定语；用于处事等"},{"id":7025,"word":"先自隗始","pinyin":"xiān zì wěi shǐ","abbr":"xzws","explanation":"隗：指战国燕人郭隗；始：开始。以先任用我郭隗为开端。表示自我推荐。","source":{"text":"今王诚欲致士，先从隗始，隗且见事，况贤于隗者乎？","book":"《战国策·燕策一》"},"similar":["毛遂自荐"],"usage":"作谓语；表示自我推荐","story":["战国时期，燕昭王即位后，一心想振兴燕国，想招揽天下贤才为之服务，就与谋士郭隗商量计策。郭隗说：“今大王想招揽贤才，请先从我郭隗开始。像我这样的人都能被重用，那么比我能干的人肯定会来归附的。”燕昭王采纳他的意见"]},{"id":7026,"word":"先花后果","pinyin":"xiān huā hòu guǒ","abbr":"xhhg","explanation":"旧时比喻先生女后生男。","source":{"text":"生下三女一男：儿子名曰承祖，长女名玉英，次女名桃英，三女名月英。元来是先花后果的。倒是玉英居长，次即承祖。","book":"明·冯梦龙《醒世恒言》第二十七卷"},"usage":"作谓语、分句；比喻先生女后生男"},{"id":7027,"word":"先苦后甜","pinyin":"xiān kǔ hòu tián","abbr":"xkht","explanation":"指先经历苦难然后过上幸福的日子。","source":{"text":"你是那遇难成祥，先苦后甜的命。","book":"王朔《我是你爸爸》"},"example":{"text":"～的人生值得回味。"},"usage":"作宾语、定语；用于教诲人"},{"id":7028,"word":"先获我心","pinyin":"xiān huò wǒ xīn","abbr":"xhwx","explanation":"比喻别人先说出了自己心里想说的话。","source":{"text":"心之所同然者何也？谓理也、义也。圣人先得我心之所同然耳，故理义之悦我心，犹刍豢之悦我口。","book":"《孟子·告子上》"},"example":{"text":"岑春煊主张裁撤湖北、广东、云南三省巡抚，许多人有～之感。","book":"高阳《慈禧全传》八十三"},"similar":["先得我心"],"usage":"作宾语；用于说话"},{"id":7029,"word":"先行后闻","pinyin":"xiān xíng hòu wén","abbr":"xxhw","explanation":"比喻未经请示就先做了某事，造成既成事实，然后再向上级报告。","source":{"text":"故临民之职，专事威断，族灭奸轨，先行后闻。","book":"《后汉书·酷吏列传》"},"similar":["先断后闻","先斩后奏"],"usage":"作谓语、定语、宾语；用于处事"},{"id":7030,"word":"先见之明","pinyin":"xiān jiàn zhī míng","abbr":"xjzm","explanation":"明·指眼力。事先看清问题的能力。指对事物发展的预见性。","source":{"text":"愧无日磾先见之明，犹怀老牛舐犊之爱。","book":"《后汉书·杨彪传》"},"example":{"text":"他觉得胆小的杜竹斋有时候实在颇具～，因而也省了多少烦恼。","book":"茅盾《子夜》十七"},"similar":["料事如神"],"opposite":["放马后炮"],"usage":"作宾语；指对事物发展的预见性","story":["东汉末年，曹操手下的主簿杨修积极为曹植出谋划策争夺太子地位，使曹操感到忧虑，在曹植失败后，曹操借故杀了杨修。曹操去见杨修的父亲杨彪并问候他，杨彪说：“愧无日磾先见之明，犹怀老牛舐犊之爱。”曹操十分尴尬"]},{"id":7031,"word":"先见败征","pinyin":"xiān jiàn bài zhēng","abbr":"xjbz","explanation":"征：征兆，迹象。事先就察觉了失败的迹象。","source":{"text":"兵未战而先见败征，此可谓知兵矣。","book":"西汉·司马迁《史记·项羽本纪》"},"usage":"作谓语、定语；用于事情等"},{"id":7032,"word":"先觉先知","pinyin":"xiān jué xiān zhī","abbr":"xjxz","explanation":"觉：觉悟；知：认识。指认识事理较一般人为早的人。","source":{"text":"天之生此民也，使先知觉后知，使先觉觉后觉也。","book":"《孟子·万章下》"},"similar":["先知先觉"],"usage":"作主语、宾语、定语；指对事物的认识"},{"id":7033,"word":"先言往行","pinyin":"xiān yán wǎng xíng","abbr":"xywx","explanation":"从前贤人所说的话和所做的事。","source":{"text":"君子以多识前言往行，以畜其德。","book":"《周易·大畜》"},"example":{"text":"与记室参军蔡仲熊登张仪楼，商略～及蜀土人物。","book":"《南史·齐高帝诸子列传》"},"similar":["前言往行"],"usage":"作宾语、定语；用于书面语"},{"id":7034,"word":"先计后战","pinyin":"xiān jì hòu zhàn","abbr":"xjhz","explanation":"计：计划，计谋；战：作战。先筹划好后再战。指不打无准备的仗。","source":{"text":"权谋者，以正守国，以奇用兵，先计划而后战，兼形势包阴阳，用计巧者也。","book":"东汉·班固《汉书·艺文志》"},"usage":"作宾语、定语；用于处事等"},{"id":7035,"word":"先辨淄渑","pinyin":"xiān biàn zī miǎn","abbr":"xbzm","explanation":"淄、渑二水的味道不同，分开能辨别，合起来无法分辨。泛指事物融合后难以分辨。","source":{"text":"目将眇者先睹秋毫，耳将聋者先闻蚋飞，口将爽者先辨淄渑。","book":"《列子·仲尼》"},"usage":"作谓语、定语；用于书面语"},{"id":7036,"word":"先难后获","pinyin":"xiān nán hòu huò","abbr":"xnhh","explanation":"难：艰难，劳苦；获：收获。先付出劳动然后再取得收获。比喻不坐享其成。","source":{"text":"仁者，先难而后获，可谓仁矣。","book":"春秋·鲁·孔丘《论语·雍也》"},"example":{"text":"故夫子尝以～为仁。","book":"宋·朱熹《答林退思书》"},"opposite":["不劳而获"],"usage":"作谓语、宾语；比喻不坐享其成"},{"id":7037,"word":"先驱蝼蚁","pinyin":"xiān qū lóu yǐ","abbr":"xqly","explanation":"蝼蚁：蝼蛄和蚂蚁。自己先死埋葬地下，为别人驱除蝼蚁。比喻效命于人，不惜先死。","source":{"text":"臣入则编席，出则陪乘。大王万岁千秋之后，愿得以身试黄泉，蓐蝼蚁。","book":"《战国策·楚策》"},"example":{"text":"人以寿为欢，老臣以寿为戚。既不能～，乃复频见此事。","book":"明·李贽《初潭集·君臣二》"},"usage":"作宾语；指马前卒"},{"id":7038,"word":"光前启后","pinyin":"guāng qián qǐ hòu","abbr":"gqqh","explanation":"犹光前裕后。形容人功业伟大。","source":{"text":"名已就，子亦有。凤毛麟角，光前启后。","book":"明·王九思《绣停针·寿康对山太史》套曲"},"similar":["光前裕后"],"usage":"作定语、宾语；形容人功业伟大"},{"id":7039,"word":"光前绝后","pinyin":"guāng qián jué hòu","abbr":"gqjh","explanation":"光：光大，扩充；绝：断绝。扩充了前人所不及的事，做出了后人难以做到的事。形容功业伟大或成就卓著。","source":{"text":"而堤文友拔超峻，光前绝后，以柳视之，殆犹碔砄之美玉也。","book":"宋·洪迈《容斋四笔·蓝田丞壁记》"},"example":{"text":"小人的事都在节级肚里，今夜晚间只要～。","book":"明·施耐庵《水浒全传》第六十二回"},"similar":["空前绝后","绝后空前"],"usage":"作定语；比喻事情做得干净利落"},{"id":7040,"word":"光前耀后","pinyin":"guāng qián yào hòu","abbr":"gqyh","explanation":"光前：光兴前业。光耀祖先，造福后代。","source":{"text":"大丈夫峥嵘恁时候，扶汤佐周，光前耀后，直教万古清名长不朽。","book":"元·亢文苑《一枝花·为玉叶儿作》"},"example":{"text":"明·冯梦龙《喻世明言》第21卷：“你骨法非常，必当大贵，～，愿好生自爱。”"},"similar":["光前裕后","光前启后"],"usage":"作定语、宾语；形容人功业伟大"},{"id":7041,"word":"光前裕后","pinyin":"guāng qián yù hòu","abbr":"gqyh","explanation":"光前：光大前业；裕后：遗惠后代。为祖先增光，为后代造福。形容人功业伟大。","source":{"text":"扬名声，显父母，光于前，裕于后。","book":"南朝·陈·徐陵《欧阳頠德政碑》：“方其盛也，绰有光前。”《尚书·仲虺之诰》：“以义制事，以礼制心，垂裕后昆。”宋·王应麟《三字经》"},"example":{"text":"似这般～，一灵儿可也知不？","book":"元·宫大用《范张鸡黍》第三折"},"similar":["光宗耀祖","造福后代"],"usage":"作定语、宾语；形容人功业伟大"},{"id":7042,"word":"光华夺目","pinyin":"guāng huá duó mù","abbr":"ghdm","explanation":"犹光彩夺目。形容鲜艳耀眼。","source":{"text":"其花大如丹盘，五色灿烂，光华夺目。","book":"《醒世恒言·灌园叟晚逢仙女》"},"example":{"text":"[这女人]颈里一条白丝围巾，身上绿绸旗袍，～。","book":"钱锺书《围城》五"},"similar":["光彩夺目","光辉夺目","光耀夺目"],"opposite":["暗淡无光"],"usage":"作谓语、定语；形容颜色鲜艳耀眼"},{"id":7043,"word":"光可鉴人","pinyin":"guāng kě jiàn rén","abbr":"gkjr","explanation":"光：光亮；鉴：照。闪闪的光亮可以照见人影。形容头发乌黑，肌肤润泽艳丽或器物光滑明亮。","source":{"text":"昔有仍氏生女黰黑而基美，光可以鉴。","book":"《左传·昭公二十八年》"},"example":{"text":"盖闻～，谅非兰膏所泽。","book":"明·叶小鸾《返生香·拟连珠·发》"},"similar":["油光发亮"],"usage":"作谓语、定语；形容光亮照人"},{"id":7044,"word":"光复旧京","pinyin":"guāng fù jiù jīng","abbr":"gfjj","explanation":"光复：恢复。指收复曾被敌人侵占的祖国山河。","source":{"text":"诚宜远图庙算，大存经略，光复旧京，疆理华夏。","book":"《晋书·桓温传》"},"similar":["光复旧物"],"usage":"作谓语；指收复故土或恢复旧时典章"},{"id":7045,"word":"光复旧物","pinyin":"guāng fù jiù wù","abbr":"gfjw","explanation":"光复：恢复；旧物：旧有的东西。指收复曾被敌人侵占的祖国山河。","source":{"text":"臣愿陛下姑以光复旧物而自期。","book":"《晋书·桓温传》：“光复旧京，疆理华夏。”宋·辛弃疾《美芹十论》"},"example":{"text":"往昔所希，惟在～，政俗革新，不图废清甚易，改政易俗，竟无毫铢可望，而腐败反甚于前。","book":"章炳麟《与龚未生书》"},"similar":["光复旧京"],"usage":"作谓语；指收复故土或恢复旧时典章、文物"},{"id":7046,"word":"光天化日","pinyin":"guāng tiān huà rì","abbr":"gthr","explanation":"光天：最大的天，大白天；化日：生长万物的太阳。原形容太平盛世。后比喻大家看得非常清楚的场合。","source":{"text":"化国之日舒以长，故其民闲暇而力有余。","book":"《尚书·益稷》：“帝光天之下，至于海隅苍生。”《后汉书·王符传》"},"example":{"text":"彼残忍乖邪之气，不能荡溢于～之下。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["大庭广众","众目昭彰","众目睽睽"],"opposite":["暗无天日"],"usage":"作主语、宾语、定语；常与“之下”连用"},{"id":7047,"word":"光宗耀祖","pinyin":"guāng zōng yào zǔ","abbr":"gzyz","explanation":"宗：宗族；祖：祖先。指子孙做了官出了名，使祖先和家族都荣耀。","source":{"text":"今幸得一举登科，荣宗耀祖。","book":"元·石君宝《曲江池》第四折"},"example":{"text":"儿子管他，也为的是光宗耀祖。","book":"清·曹雪芹《红楼梦》第三十三回"},"similar":["耀祖光宗","光前裕后"],"usage":"作谓语、宾语；指为祖先争光"},{"id":7048,"word":"光彩夺目","pinyin":"guāng cǎi duó mù","abbr":"gcdm","explanation":"夺目：耀眼。形容鲜艳耀眼。也用来形容某些艺术作品和艺术形象的极高成就。","source":{"text":"乃令左右引于宫内游观，玉台翠树，光彩夺目。","book":"宋·张君房《云笈七签》卷一百十三"},"example":{"text":"解开来，只见一团绵裹着寸许大一颗夜明珠，～。","book":"明·凌濛初《初刻拍案惊奇》卷一"},"similar":["光辉灿烂","光芒耀眼","色彩鲜明"],"opposite":["暗淡无光","黯然失色"],"usage":"作谓语、定语；形容颜色鲜艳耀眼","story":["西晋时期，荆州刺史石崇靠抢劫外地商人而积累了万贯家财，被调至京城做卫尉，大肆挥霍。晋武帝的舅舅王恺也极力铺张浪费，想办法与石崇比富。王恺得到一株珊瑚十分得意，拿到石崇家。石崇拿出六七株光彩夺目的珊瑚送给他。王恺自叹不如"]},{"id":7049,"word":"光彩射人","pinyin":"guāng cǎi shè rén","abbr":"gcsr","explanation":"光彩：光泽和颜色；射：照射。形容光泽色彩鲜艳耀眼。","source":{"text":"遥望清风宛在，鹤处鸡群。近观而光彩射人，龙来洞口。","book":"《敦煌变文集》第五卷"},"similar":["光彩射目","光彩夺目"],"usage":"作谓语、定语；形容颜色鲜艳耀眼"},{"id":7050,"word":"光彩射目","pinyin":"guāng cǎi shè mù","abbr":"gcsm","explanation":"光彩：光泽和颜色；射：照射。形容光泽色彩鲜艳耀眼。","source":{"text":"几、榻、裙、衣，不知何名，光彩射目。","book":"清·蒲松龄《聊斋志异》第一卷"},"similar":["光彩射人","光采夺目","光耀夺目"],"usage":"作谓语、定语；形容颜色鲜艳耀眼"},{"id":7051,"word":"光彩溢目","pinyin":"guāng cǎi yì mù","abbr":"gcym","explanation":"犹光彩夺目。形容鲜艳耀眼。","source":{"text":"[石崇]乃命取珊瑚，有三尺，光彩溢目者六十七枚。","book":"《太平御览》卷七○三引晋·裴启《语林》"},"similar":["光彩耀目","光彩夺目"],"usage":"作谓语、定语；形容颜色鲜艳耀眼","story":["西晋时期，荆州刺史石崇靠抢劫外地商人而积累了万贯家财，被调至京城做卫尉，大肆挥霍。晋武帝的舅舅王恺也极力铺张浪费，想办法与石崇比富。王恺得到一株珊瑚十分得意，拿到石崇家。石崇拿出六七株光彩溢目的珊瑚送给王恺。王恺自叹不如"]},{"id":7052,"word":"光彩耀目","pinyin":"guāng cǎi yào mù","abbr":"gcym","explanation":"光采鲜明，视之耀眼。","source":{"text":"待女六七人扶阿稚，红巾覆面，锦衣绣裳，一涌而入。妆奁随之以进，光彩耀目，填塞草堂。","book":"晋·葛洪《神仙记·王远》：“衣有文采，又非锦绮，光彩耀目，不可名状。”清·和邦额《夜谭随录·阿稚》"},"example":{"text":"卧榻遍饰金犀，～。","book":"清·支机生《珠江名花小传》卷二"},"similar":["光彩射目"],"usage":"作谓语、定语；形容颜色鲜艳耀眼","story":["西晋时期，荆州刺史石崇靠抢劫外地商人而积累了万贯家财，被调至京城做卫尉，大肆挥霍。晋武帝的舅舅王恺也极力铺张浪费，想办法与石崇比富。王恺得到一株光彩耀目的珊瑚十分得意，拿到石崇家。石崇拿出六七株送给王恺。王恺自叹不如"]},{"id":7053,"word":"光彩陆离","pinyin":"guāng cǎi lù lí","abbr":"gcll","explanation":"指色彩斑斓错杂。","source":{"text":"龛上供千手眼大士像，二臂合掌，馀擎莲花、火轮、剑、杵、简、槊并日月轮、火焰之属，身着袈，金碧错杂，光彩陆离。","book":"清·李斗《扬州画舫录·桥东录》"},"example":{"text":"这统一就像一幅～的油画，表示有无限的魄力。","book":"郭沫若《羽书集·日寇残酷心理的解剖》"},"similar":["五彩斑斓"],"usage":"作谓语、定语；指色彩繁杂"},{"id":7054,"word":"光怪陆离","pinyin":"guāng guài lù lí","abbr":"ggll","explanation":"光怪：光彩奇异；陆离：开卷参差。形容奇形怪状，五颜六色。","source":{"text":"冢上有光怪，云气五色，上属于天，曼延数里。","book":"战国·楚·屈原《离骚》：“纷总总其离合兮，斑陆离其上下。”《三国志·吴志·孙坚传》裴松之注引《吴书》"},"example":{"text":"那柴烧的一块一块的，结成就和太湖石一般，～。","book":"清·吴敬梓《儒林外史》第五十五回"},"similar":["斑驳陆离"],"usage":"作谓语、定语；形容五颜六色的景色"},{"id":7055,"word":"光恶不善","pinyin":"guāng è bù shàn","abbr":"gebs","explanation":"只做恶事，不做善事。","example":{"text":"为人不能～，没有朋友。"},"usage":"作谓语、定语；指恶人","story":["商朝末年，商纣王的大将闻仲太师的十绝阵被姜子牙破了六阵，就只好向罗浮洞飞去请赵公明助阵。赵公明带上神鞭、缚龙索、定海珠前去，将姜子牙打伤，同时也打伤了玉鼎真人等五位大仙，坏事干绝。姜子牙在昆仑山陆压的帮助人打败"]},{"id":7056,"word":"光明大道","pinyin":"guāng míng dà dào","abbr":"gmdd","explanation":"指正确的有前途的道路。","source":{"text":"我们已加入革命阵线，走上光明大道，何至于再入岔路，钻回黑暗中吗？","book":"冯玉祥《我的生活》第三十九章"},"example":{"text":"摆若能安养其根，不为物障，常使～，见性乃全。","book":"宋·苏轼《东坡志林·读坛经》在我们面前的是～，前途无量。"},"similar":["阳光大道","前程似锦"],"opposite":["坎坷不平"],"usage":"作宾语、定语；指人的前程等"},{"id":7057,"word":"光明正大","pinyin":"guāng míng zhèng dà","abbr":"gmzd","explanation":"原指明白不偏邪。现多指心怀坦白，言行正派。","source":{"text":"圣人所说底话，光明正大，须是先理会光明正大底纲领条目。","book":"宋·朱熹《朱子语类》卷七三"},"example":{"text":"大仙是～之人，就以他的诳语作真。","book":"明·吴承恩《西游记》第五回"},"similar":["光明磊落"],"opposite":["鬼鬼祟祟"],"usage":"作谓语、定语、状语；指人的作风"},{"id":7058,"word":"光明洞彻","pinyin":"guāng míng dòng chè","abbr":"gmdc","explanation":"明亮通透。","source":{"text":"赤者如珊瑚，白者如截肪，黑者如泽漆，青者如翠羽，黄者如紫金，而皆光明洞彻如坚冰也。","book":"晋·葛洪《抱朴子·仙药》"},"example":{"text":"若能安养其根，不为物障，常使～，见性乃全。","book":"宋·苏轼《东坡志林·读坛经》"},"usage":"作谓语、宾语；用于书面语"},{"id":7059,"word":"光明灿烂","pinyin":"guāng míng càn làn","abbr":"gmcl","explanation":"灿烂：光彩明亮的样子。形容光明耀眼，色彩艳丽。比喻事业的伟大辉煌。","source":{"text":"灼然一切处，光明灿烂去。","book":"宋·释普济《五灯会元》第11卷"},"example":{"text":"中共中央特为我们民族的～的前途庆贺。","book":"周恩来《中共中央为公布国共合作宣言》"},"similar":["光辉灿烂"],"opposite":["暗淡无光"],"usage":"作谓语、宾语、定语；指事业或前程等"},{"id":7060,"word":"光明磊落","pinyin":"guāng míng lěi luò","abbr":"gmll","explanation":"磊落：心地光明坦白。胸怀坦白，正大光明。","source":{"text":"譬如人光明磊落底便是好人，昏昧迷暗底便不是好人。","book":"《晋书·右勒载记下》：“大丈夫行事，当礌（磊）落落，如日月皎然。”宋·朱熹《朱子语类》卷七十四"},"example":{"text":"公子光明磊落，为天人所钦瞩。","book":"清·蒲松龄《聊斋志异·聂小倩》"},"similar":["襟怀坦白","光明正大"],"opposite":["居心叵测"],"usage":"作谓语、定语、状语；指人很正直"},{"id":7061,"word":"光杆司令","pinyin":"guāng gǎn sī lìng","abbr":"ggsl","explanation":"形容只剩下孤单一人，没有任何人帮助。","example":{"text":"她现在是～了。"},"similar":["孤家寡人"],"usage":"作主语、宾语、定语；指人很孤立"},{"id":7062,"word":"光棍一条","pinyin":"guāng gùn yī tiáo","abbr":"ggyt","explanation":"光棍：没有配偶的人。指孤身一人。","example":{"text":"我～，我怕谁？"},"similar":["光杆司令"],"usage":"作谓语、宾语；指一个人"},{"id":7063,"word":"光棍不吃眼前亏","pinyin":"guāng gùn bù chī yǎn qián kuī","abbr":"ggbcyqk","explanation":"聪明人暂时躲开眼前的不利处境，待日后有机会再采取行动。","source":{"text":"俗语说的好，光棍不吃眼前亏。","book":"清·无名氏《刘公案》第六回"},"example":{"text":"俗话说：～，我们还是保存实力吧。"},"similar":["好汉不吃眼前亏"],"usage":"作宾语、定语、分句；用于口语"},{"id":7064,"word":"光焰万丈","pinyin":"guāng yàn wàn zhàng","abbr":"gywz","explanation":"光焰：光辉。灿烂的光辉射向远方。原形容诗文美妙，留传后世。现多形容新生事物前程远大。","source":{"text":"李杜文章在，光焰万丈长。","book":"唐·韩愈《调张籍》诗"},"example":{"text":"～地，将要出现了哟——新生的太阳！","book":"郭沫若《女神·太阳礼赞》"},"similar":["光芒万丈"],"usage":"作宾语、定语；形容新生事物前程远大"},{"id":7065,"word":"光耀夺目","pinyin":"guāng yào duó mù","abbr":"gydm","explanation":"夺目：耀眼。形容光采极为鲜明，令人眼花缭乱。","source":{"text":"黄龙缭绕……光耀夺目。","book":"《辽史·太祖纪》"},"similar":["光华夺目","光辉夺目","光彩夺目"],"opposite":["暗淡无光"],"usage":"作谓语、定语；形容颜色鲜艳耀眼"},{"id":7066,"word":"光芒万丈","pinyin":"guāng máng wàn zhàng","abbr":"gmwz","explanation":"形容光辉灿烂，照耀到远方。","source":{"text":"李杜文章在，光焰万丈长。","book":"唐·韩愈《调张籍》诗"},"example":{"text":"当我注意到那座～的星的山的时候，我仿佛又听见了那无数的灯光的私语。","book":"巴金《旅途随笔·香港的夜》"},"similar":["光辉灿烂"],"opposite":["漆黑一团"],"usage":"作状语；形容新生事物，前程远大"},{"id":7067,"word":"光芒四射","pinyin":"guāng máng sì shè","abbr":"gmss","explanation":"强烈的光线射向四面八方。","source":{"text":"天边的火红的云彩里有一个光芒四射的太阳，如流动的金球包在荒谷的熔岩中。","book":"鲁迅《故事新编·补天》"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“左宗棠那双眼睛，颇具威严，～似地，将他从头望到底。”"},"similar":["光芒万丈"],"opposite":["暗淡无光"],"usage":"作定语、谓语；用于阳光等"},{"id":7068,"word":"光被四表","pinyin":"guāng bèi sì biǎo","abbr":"gbsb","explanation":"被：加于，及于；四表：四周很远的地方。形容盛德善行远播四方。","source":{"text":"光被四表，格于上下。","book":"《尚书·尧典》"},"example":{"text":"皮言公～，而为民物之所瞻仰。","book":"吴楚材在《古文观止》中注"}},{"id":7069,"word":"光说不练","pinyin":"guāng shuō bù liàn","abbr":"gsbl","explanation":"指只会说而不干实事。","example":{"text":"～是行不通的。"},"usage":"作主语、宾语、定语；指只会说"},{"id":7070,"word":"光车骏马","pinyin":"guāng chē jùn mǎ","abbr":"gcjm","explanation":"指装饰华丽的车马。","source":{"text":"光车骏马游都城，高谈雅步何盈盈。","book":"晋·陆机《百年歌》之二"},"usage":"作主语、宾语、定语；用于奢华生活"},{"id":7071,"word":"光辉夺目","pinyin":"guāng huī duó mù","abbr":"ghdm","explanation":"夺目：耀眼。形容光采极为鲜明，令人眼花缭乱。","source":{"text":"见两旁有金山玉山二座，光辉夺目。","book":"明·冯梦龙《东周列国志》第98回"},"similar":["光彩夺目","光采夺目","光耀夺目"],"opposite":["暗淡无光"],"usage":"作谓语、定语；形容颜色鲜艳耀眼"},{"id":7072,"word":"光辉灿烂","pinyin":"guāng huī càn làn","abbr":"ghcl","explanation":"色彩光亮耀眼。多比喻前程的远大或事业的伟大。","source":{"text":"灼然一切处，光明灿烂去。","book":"宋·释普济《五灯会元》卷十一"},"example":{"text":"其中有着时代的眉目，也决不是英雄们的八宝箱，一朝打开，便见～。","book":"鲁迅《且介亭杂文·序言》"},"similar":["灿烂辉煌"],"opposite":["黯然失色","漆黑一团","暗淡无光"],"usage":"作谓语、宾语；指事业或前程等"},{"id":7073,"word":"光采夺目","pinyin":"guāng cǎi duó mù","abbr":"gcdm","explanation":"夺目：耀眼。形容光采极为鲜明，令人眼花缭乱","source":{"text":"五台翠树，光采夺目。","book":"明·凌濛初《初刻拍案惊奇》第28卷"},"similar":["光彩夺目","光辉夺目","光耀夺目"],"usage":"作谓语、定语；形容颜色鲜艳耀眼"},{"id":7074,"word":"光阴似箭","pinyin":"guāng yīn sì jiàn","abbr":"gysj","explanation":"光阴：时间。时间如箭，迅速流逝。形容时间过得极快。","source":{"text":"但见时光流似箭，岂知天道曲如弓。","book":"唐·韦庄《关河道中》诗"},"example":{"text":"～，日月如梭，不觉半年有余。","book":"明·冯梦龙《警世通言》卷三十三"},"similar":["日月如梭","白驹过隙"],"opposite":["度日如年"],"usage":"作定语、分句；形容时间过得极快"},{"id":7075,"word":"光阴似箭，日月如梭","pinyin":"guāng yīn sì jiàn，rì yuè rú suō","abbr":"gysjryrs","explanation":"梭：织布机上引导纬纱与经纱交织的构件。形容时间过得很快。","source":{"text":"时光似箭，日月如梭，也有一年以上。","book":"《京本通俗小说·碾玉观音》"},"example":{"text":"～，只等忙着吃了粽子，又吃月饼。","book":"清·文康《儿女英雄传》第24回"},"similar":["光阴荏苒，日月如梭"],"usage":"作宾语、定语、分句；可分开使用"},{"id":7076,"word":"光阴如电","pinyin":"guāng yīn rú diàn","abbr":"gyrd","explanation":"光阴：时间。时间如闪电，迅速流逝。形容时间过得极快。","source":{"text":"光阴如电逝难追，百岁开怀能几回。","book":"明·陆采《怀春记·青销相窥》"},"similar":["光阴如箭","光阴似箭"],"usage":"作定语、分句；形容时间过得极快"},{"id":7077,"word":"光阴如箭","pinyin":"guāng yīn rú jiàn","abbr":"gyrj","explanation":"光阴：时间。时间如箭，迅速流逝。形容时间过得极快。","source":{"text":"但见时光流似箭，岂知天道曲如弓。","book":"唐·韦庄《关河道中》诗"},"example":{"text":"～逝难追，百岁开怀能几回。","book":"明·陆采《怀香记·青琐相窥》"},"similar":["光阴似箭"],"opposite":["度日如年"],"usage":"作定语、分句；形容时间过得极快"},{"id":7078,"word":"光阴荏苒","pinyin":"guāng yīn rěn rǎn","abbr":"gyrr","explanation":"荏苒：时间一点一点的流逝。指时间渐渐地过去了。","source":{"text":"玄德回新野之后，光阴荏苒，双是新春。","book":"明·罗贯中《三国演义》第三十七回"},"example":{"text":"～须当惜，风雨阴睛任变迁。","book":"清·曹雪芹《红楼梦》第二十二回"},"similar":["光阴似箭","日月如梭"],"usage":"作宾语、定语；指时间飞快地流逝"},{"id":7079,"word":"光阴荏苒，日月如梭","pinyin":"guāng yīn rěn rǎn，rì yuè rú suō","abbr":"gyrrryrs","explanation":"荏苒：不知不觉地过去；梭：织布机上引导纬纱与经纱交织的构件。形容时间过得很快。","source":{"text":"光阴荏苒，日月如梭，转眼间倪继祖已然十六岁。","book":"清·石玉昆《三侠五义》第71回"},"similar":["光阴荏苒，日月如流"],"usage":"作宾语、定语、分句；可分开使用"},{"id":7080,"word":"光阴荏苒，日月如流","pinyin":"guāng yīn rěn rǎn，rì yuè rú liú","abbr":"gyrrryrl","explanation":"荏苒：不知不觉地过去。形容时间过得很快。","source":{"text":"光阴荏苒，日月如流，早过一月有余。","book":"明·施耐庵《水浒传》第62回"},"similar":["光阴荏苒，日月如梭"],"usage":"作宾语、定语、分句；可分开使用"},{"id":7081,"word":"光阴虚度","pinyin":"guāng yīn xū dù","abbr":"gyxd","explanation":"光阴：时间；虚：空。时光白白度过。","source":{"text":"惟有那布袋笑呵呵，他笑我光阴虚度青春蹉。","book":"湘剧《思凡》"},"similar":["光阴虚过"],"usage":"作宾语、定语；用于慨叹等"},{"id":7082,"word":"光阴虚过","pinyin":"guāng yīn xū guò","abbr":"gyxg","explanation":"光阴：时间；虚：空。时光白白度过。","source":{"text":"免使少年，光阴虚过。","book":"宋·柳永《定风波》"},"similar":["光阴虚度"],"usage":"作宾语、定语；用于慨叹等"},{"id":7083,"word":"光风霁月","pinyin":"guāng fēng jì yuè","abbr":"gfjy","explanation":"光风：雨后初晴时的风；霁：雨雪停止。形容雨过天晴时万物明净的景象。也比喻开阔的胸襟和心地。","source":{"text":"舂陵周茂叔，人品甚高，胸怀洒落，如光风霁月。","book":"宋·黄庭坚《豫章集·濂溪诗序》"},"example":{"text":"胸无城府，～，令我忆君之天真有如提孩。","book":"陈毅《哭叶军长希夷同志》"},"similar":["霁月光风"],"usage":"作宾语、定语；比喻开阔的胸襟和心地"},{"id":7084,"word":"克丁克卯","pinyin":"kè dīng kè mǎo","abbr":"kdkm","explanation":"做事认真，一丝不苛。","source":{"text":"当个铁面无私，克丁克卯的检查员。","book":"刘心武《醒来吧！弟弟》"},"usage":"作谓语、定语；用于口语"},{"id":7085,"word":"克伐怨欲","pinyin":"kè fá yuàn yù","abbr":"kfyy","explanation":"①指好胜、骄傲、忌刻、贪婪四种恶德。②指关于四种恶德的理论。","source":{"text":"‘克伐怨欲不行焉，可以为仁矣。’子曰：‘可以为难矣，仁则吾不知也。’","book":"《论语·宪问》"},"example":{"text":"万厉甲辰九日，东林会讲～。","book":"清·俞正燮《癸巳存稿》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":7086,"word":"克传弓冶","pinyin":"kè chuán gōng yě","abbr":"kcgy","explanation":"犹克绍箕裘。比喻能继承父祖的事业。","source":{"text":"卿今克传弓冶，可谓不坠家声。","book":"《旧唐书·赵道兴传》"},"similar":["克绍箕裘","业绍箕裘"],"usage":"作谓语、定语；用于书面语"},{"id":7087,"word":"克俭克勤","pinyin":"kè jiǎn kè qín","abbr":"kjkq","explanation":"克：能够。既能勤劳，又能节俭。","source":{"text":"克勤于邦，克俭于家。","book":"《尚书·大禹漠》"},"example":{"text":"适来这杯酒，乃劝大舅，自今以后，兢兢业业，～，以付岳父泉台之望。","book":"明·冯梦龙《醒世恒言》卷十七"},"similar":["克勤克俭"],"opposite":["挥霍无度","好逸恶劳"],"usage":"作谓语、定语；指勤俭"},{"id":7088,"word":"克勤克俭","pinyin":"kè qín kè jiǎn","abbr":"kqkj","explanation":"克：能够。既能勤劳，又能节俭。","source":{"text":"克勤于邦，克俭于家。","book":"《尚书·大禹漠》"},"example":{"text":"～，无怠无荒。","book":"宋·郭茂倩《乐府诗集·梁太庙乐舞辞·撤豆》"},"similar":["省吃俭用","艰苦朴素","勤俭节约"],"opposite":["无所事事","挥霍无度","好逸恶劳"],"usage":"作谓语、宾语、定语；指勤俭","story":["尧帝时期，黄河经常发洪水，尧帝派鲧治水九年没有成效。舜帝派鲧的儿子禹去治水，禹告别新婚四天的妻子踏上治水的征途，治水13年，曾经3次路过家门而不回，终于取得了成就。舜认为禹能够克勤克俭地为人民服务就让位给他"]},{"id":7089,"word":"克嗣良裘","pinyin":"kè sì liáng qiú","abbr":"kslq","explanation":"比喻能继承父祖的事业。同“克绍箕裘”。","source":{"text":"与兄孝宾俱舍家入道，俗号永禅师。禅师克嗣良裘，精勤此业。","book":"唐·向延之《兰亭始末记》"},"similar":["克绍箕裘"],"usage":"作谓语、定语；用于书面语"},{"id":7090,"word":"克奏肤功","pinyin":"kè zòu fū gōng","abbr":"kzfg","explanation":"克：战胜；奏：臣下向君王陈述事情；肤：伟大；功：功绩。事情已经办成，功劳十分显赫。","source":{"text":"薄伐猃狁，以奏肤功。","book":"《诗经·小雅·六月》"},"example":{"text":"获悉你部占领东固，将士用命，～，实堪嘉奖。奖二万元犒赏官兵，以资鼓励。","book":"王运朝《井冈风云录》第二部《力挽狂澜》三"}},{"id":7091,"word":"克尽厥职","pinyin":"kè jìn jué zhí","abbr":"kjjz","explanation":"厥：他的。能够尽到职责，做好自己的工作。","source":{"text":"此朕嘉惠忠良，务须克尽厥职，勿负朕恩，故敕。","book":"清·无名氏《说呼全传》第四十四回"},"example":{"text":"你别说，这些巨无霸还真～，决不吝惜自己的力量。","book":"季羡林《牛棚杂忆》第九节"},"similar":["忠于职守","克尽职守","鞠躬尽瘁"],"opposite":["玩忽职守"],"usage":"作谓语、定语；指尽责"},{"id":7092,"word":"克己复礼","pinyin":"kè jǐ fù lǐ","abbr":"kjfl","explanation":"克：克制。儒家指约束自己，使每件事都归于“礼”。","source":{"text":"颜渊问仁。子曰：‘克己复礼为仁。一日克己复礼，天下归仁焉！为仁由己，而由人乎哉？’","book":"《论语·颜渊》"},"example":{"text":"小官公谨忠信，～，奉公守法，正直无私。","book":"明·无名氏《紫泥宣》第一折"},"similar":["复礼克己"],"usage":"作谓语、定语；指约束自己","story":["春秋时期，孔子认为仁包括恭、宽、信、敏、惠、智、勇、忠、恕、孝、悌等，实行的方法是“己所不欲，勿施于人”和“己欲立而立人，己欲达而达人”。弟子问怎样才能做到“仁”，孔子说：“克己复礼。”"]},{"id":7093,"word":"克己奉公","pinyin":"kè jǐ fèng gōng","abbr":"kjfg","explanation":"克己：约束自己；奉公：以公事为重。克制自己的私心，一心为公。","source":{"text":"遵为人廉约小心，克己奉公。","book":"《后汉书·祭遵传》"},"example":{"text":"大公无私，积极努力，～，埋头苦干的精神，才是可尊敬的。","book":"毛泽东《中国共产党在民族战争中的地位》"},"similar":["廉政无私","公而忘私","奉公守法"],"opposite":["见利忘义","损人利己","假公济私"],"usage":"作谓语、定语；指一心为公","story":["东汉初期，颖阳读书人祭遵去投奔刘秀，被封为军中执法官，他不徇私情斩了刘秀手下的侍从。刘秀重用他为征虏将军，封颖阳侯。祭遵为人廉洁，为官清正，处事谨慎，克己奉公，生活也十分俭朴，没有多少私产，被刘秀树为典型"]},{"id":7094,"word":"克己慎行","pinyin":"kè jǐ shèn xíng","abbr":"kjsx","explanation":"克己：克制自己；慎：谨慎。约束自己，小心做事。","source":{"text":"故上之人行志择谊，坦乎其无忧于下也；下之人克己慎行，确乎其无惑于上也。","book":"唐·韩愈《送齐皞下第序》"},"usage":"作谓语、定语；用于处事"},{"id":7095,"word":"克恭克顺","pinyin":"kè gōng kè shùn","abbr":"kgks","explanation":"克：能够。能够恭敬而顺从，一点也不执拗。"},{"id":7096,"word":"克敌制胜","pinyin":"kè dí zhì shèng","abbr":"kdzs","explanation":"克：战胜；制胜：取得胜利。制服敌人，取得胜利。","source":{"text":"人皆知我所以胜之形，而莫知吾所以制胜之形。","book":"《孙子·虚实》"},"example":{"text":"只今番～，便见得先生妙法。","book":"明·施耐庵《水浒全传》第二十回"},"similar":["出奇制胜","旗开得胜","直捣黄龙"],"opposite":["一败涂地","损兵折将","弃甲曳兵"],"usage":"作谓语、定语；用于战争等"},{"id":7097,"word":"克爱克威","pinyin":"kè ài kè wēi","abbr":"kakw","explanation":"指恩威得当而使人心悦诚服。","source":{"text":"威克厥爱，允济；爱克厥威，允罔功。","book":"《书·胤征》"},"usage":"作宾语；指人的威德"},{"id":7098,"word":"克绍箕裘","pinyin":"kè shào jī qiú","abbr":"ksjq","explanation":"克：能够；绍：继承；箕：畚箕；裘：皮袄。比喻能继承父祖的事业。","source":{"text":"良冶之子必学为裘，良弓之子必学为箕。","book":"《礼记·学记》"},"example":{"text":"怨将德报，喜双儿～，戒和尚一朝提醒，合门共证前修。","book":"明·陈汝元《金莲记·首引》"},"similar":["光耀门第","扬名显亲","光裕大业"],"opposite":["倾家荡产"],"usage":"作谓语、定语；用于书面语"},{"id":7099,"word":"克肩一心","pinyin":"kè jiān yī xīn","abbr":"kjyx","explanation":"指能一心以事君。","source":{"text":"用布示民必以德义，长任一心以事君。","book":"语出《书·盘庚下》：“式敷民德，永肩一心。”孔传"},"example":{"text":"卿历事三世，～，事效已明，时望攸属。","book":"宋·司马光《赐新除知枢密院事陈升之上第一表辞恩命不允断来章批答》"},"usage":"作谓语、定语；用于书面语"},{"id":7100,"word":"克逮克容","pinyin":"kè dǎi kè róng","abbr":"kdkr","explanation":"指能和顺而宽容。","source":{"text":"即邑姜虽贤，不过如大姒克勤克俭，克逮克容。","book":"清·周亮工《书影》第三卷"},"usage":"作谓语、宾语；用于为人处世"},{"id":7101,"word":"免开尊口","pinyin":"miǎn kāi zūn kǒu","abbr":"mkzk","explanation":"免：不要。不必开口说什么。多表示要求不会得到同意。","source":{"text":"你若果然有成全我的心，卫顾我的话，就请说；要是方才伯父合九公说的那套，我都听见了，也明白了，免开尊口。？","book":"清·文康《儿女英雄传》第二十六回"},"example":{"text":"何况此刻靠着点小生意，还有饭吃，我看娘舅还是～吧。（清·吴沃尧《九命奇冤》第五回）"},"usage":"作谓语；含讽刺意味"},{"id":7102,"word":"免怀之岁","pinyin":"miǎn huái zhī suì","abbr":"mhzs","explanation":"指三岁。","source":{"text":"子生三年，然后免于父母之怀。","book":"《论语·阳货》"},"usage":"作宾语；用于书面语"},{"id":7103,"word":"免战牌","pinyin":"miǎn zhàn pái","abbr":"mzp","explanation":"指挂出的向对方表示不应战的牌子。借指不想做事。","source":{"text":"城上即将‘免战牌’挂起，随你叫骂，总不出战。","book":"清·钱彩《说岳全传》第15回"},"example":{"text":"你的～不起作用。"},"usage":"作宾语、定语；用于口语"},{"id":7104,"word":"兔丝燕麦","pinyin":"tù sī yàn mài","abbr":"tsym","explanation":"兔丝：菟丝子。菟丝不是丝，燕麦不是麦。比喻有名无实。","source":{"text":"今国子虽有学官之名，而无教授之实，何异兔丝燕麦，南箕北斗哉？","book":"《魏书·李崇传》"},"example":{"text":"他当的是～般的官。"},"similar":["有名无实"],"usage":"作宾语；指有名无实","story":["北魏宣武帝时期，高级学官“国子祭酒”邢邵对于朝廷不重视学术却花很大人力、财力去修建寺院十分不满，认为这会误国误民，就会同其他学官联名上书复兴太学，说：“今国子虽有学官之名，而无教授之实，何异兔丝燕麦，南箕北斗哉？”"]},{"id":7105,"word":"兔丝附女萝","pinyin":"tù sī fù nǚ luó","abbr":"tsfnl","explanation":"比喻夫妻互相依附。","source":{"text":"与君为新婚，兔丝附女萝。","book":"《古诗十九首》之八"}},{"id":7106,"word":"兔园册","pinyin":"tù yuán cè","abbr":"tyc","explanation":"本是唐五代时私塾教授学童的课本。因其内容肤浅，故常受一般士大夫的轻视。后指读书不多的人奉为秘本的浅陋书籍。","source":{"text":"道行数反顾，楚问岳：‘道反顾何为？’岳曰：‘遗下《兔园册》尔。’《兔园册》者，乡校俚儒教田夫牧子之所诵也。","book":"《新五代我·刘岳传》"},"example":{"text":"三冬～，牧竖叫语粗。","book":"金·元好问《送高信卿》"}},{"id":7107,"word":"兔园册子","pinyin":"tù yuán cè zi","abbr":"tycz","explanation":"本是唐五代时私塾教授学童的课本。因其内容肤浅，故常受一般士大夫的轻视。后指读书不多的人奉为秘本的浅陋书籍。","source":{"text":"道行数反顾，楚问岳：‘道反顾何为？’岳曰：‘遗下《兔园册》尔。’《兔园册》者，乡校俚儒教田夫牧子之所诵也。","book":"《新五代我·刘岳传》"}},{"id":7108,"word":"兔头獐脑","pinyin":"tù tóu zhāng nǎo","abbr":"ttzn","explanation":"獐：牙獐。形容人的面貌猥琐。","source":{"text":"暴敛横征，野皆狼心狗行之吏，卖官鬻爵，朝尽兔头獐脑之人。","book":"《上海小刀会起事本末》"},"usage":"作宾语、定语；用于坏人"},{"id":7109,"word":"兔头麞脑","pinyin":"tù tóu suō nǎo","abbr":"ttzn","explanation":"形容人面貌猥琐。多形容坏人。"},{"id":7110,"word":"兔子不吃窝边草","pinyin":"tù zǐ bù chī wō biān cǎo","abbr":"tzbcwbc","explanation":"比喻坏人不在当地干坏事。","source":{"text":"你放心，‘兔子不吃窝边草’，要有这个心思，我也不会第一个就来告诉你。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"～，这点你都不明白。"},"opposite":["监守自盗"],"usage":"作宾语、定语；用于教训人"},{"id":7111,"word":"兔尽狗烹","pinyin":"tù jìn gǒu pēng","abbr":"tjgp","explanation":"烹：烧煮。兔子死了，猎狗就被人烹食。比喻给统治者效劳的人事成后被抛弃或杀掉。","source":{"text":"飞鸟尽，良弓藏；狡兔死，走狗烹。","book":"《史记·越王勾践世家》"},"example":{"text":"……将来还不是～，可不是我早就见过？","book":"茅盾《腐蚀》第二部分"},"similar":["兔死狗烹"],"usage":"作谓语、定语；讽刺用语"},{"id":7112,"word":"兔死凫举","pinyin":"tǔ sǐ fú jǔ","abbr":"tsfj","explanation":"象兔敢奔跑，象野鸭急飞。比喻行动迅速。","source":{"text":"知其不可久处，则知所兔起凫举，死 之地矣。","book":"《吕氏春秋·论威》"}},{"id":7113,"word":"兔死犬饥","pinyin":"tù sǐ quǎn jī","abbr":"tsqj","explanation":"比喻敌人灭亡后，功臣不受重用。","source":{"text":"鸟尽弓藏，兔死犬饥，故诸将士多张大贼势者，亦未可尽以为然也。","book":"明·张居正《答两广刘凝斋言贼情军情民情》"},"similar":["兔死狗烹"],"usage":"作宾语、定语；用于比喻句"},{"id":7114,"word":"兔死狐悲","pinyin":"tù sǐ hú bēi","abbr":"tshb","explanation":"兔子死了，狐狸感到悲伤。比喻因同类的死亡而感到悲伤。","source":{"text":"今日油烹蒯彻，正所谓兔死狐悲，芝焚蕙叹。","book":"《宋史·李全传》：“狐死兔泣，李氏灭，夏氏宁独存？”元·无名氏《赚蒯通》第四折"},"example":{"text":"鼋鸣而鳖应，兔死则狐悲。","book":"明·田艺蘅《玉笑零音》"},"similar":["物伤其类"],"opposite":["幸灾乐祸"],"usage":"作定语、宾语；指因同类的死亡而悲伤","story":["南宋时期，山东农民起义军在李全和杨妙真的率领下，奋起反抗金坦白的统治。由于抗金取得很大的影响，南宋劝他们投附，他们就投附朝廷，驻守楚州，1227年被蒙古军逼降。南宋派另一支义军夏全围剿，杨妙真对夏全说：“狐死兔泣。”"]},{"id":7115,"word":"兔死狐悲，物伤其类","pinyin":"tù sǐ hú bēi，wù shāng qí lèi","abbr":"tshbwsql","explanation":"兔子死了，狐狸感到悲伤。比喻因同类的失败或死亡而感到悲伤。","source":{"text":"获曰：‘兔死狐悲，物伤其类’。吾与汝皆是各洞之主，往日无冤，何故害我？","book":"明·罗贯中《三国演义》第89回"},"similar":["兔死狐悲"],"usage":"作宾语、定语；指因同类的死亡而悲伤"},{"id":7116,"word":"兔死狗烹","pinyin":"tù sǐ gǒu pēng","abbr":"tsgp","explanation":"烹：烧煮。兔子死了，猎狗就被人烹食。比喻给统治者效劳的人事成后被抛弃或杀掉。","source":{"text":"飞鸟尽，良弓藏；狡兔死，走狗烹。","book":"《史记·越王勾践世家》"},"example":{"text":"大凡古来有识见的英雄功成名就，便拂袖而去，免使后来有“鸟尽弓藏，～”之祸。","book":"清·陈忱《水浒后传》第九回"},"similar":["卸磨杀驴","鸟尽弓藏"],"opposite":["感恩戴德","始终不渝"],"usage":"作谓语、定语；讽刺用语","story":["春秋末期，楚国的范蠡和文种到越国去做官，辅佐被吴王夫差打败的勾践，他们发奋图强，终于使越国强大，最后灭了吴国。范蠡深知勾践的为人就到齐国隐姓埋名经商，他写信劝文种离开说：“狡兔死，走狗烹”。文种不信后被勾践所杀"]},{"id":7117,"word":"兔犬俱敝","pinyin":"tù qǐ jù bì","abbr":"tqjb","explanation":"敝：疲敝，累垮。比喻两败俱伤，第三者不劳而获。","source":{"text":"韩子卢者，天下之疾犬也；东郭逡者，海内之狡兔也。韩子卢逐东郭逡，环山者三，腾山者五，兔极于前，犬废于后，犬兔俱罢，各死其处。田父见之，无劳倦之苦而擅其功。","book":"《战国策·齐策三》"}},{"id":7118,"word":"兔缺乌沉","pinyin":"tù quē wū chén","abbr":"tqwc","explanation":"犹兔走乌飞。形容光阴迅速流逝。","source":{"text":"却思紫陌觥筹地，兔缺乌沉欲半年。","book":"唐·罗邺《冬日寄献庾员外》诗"},"similar":["兔走乌飞"],"usage":"作宾语；指时光流逝"},{"id":7119,"word":"兔葵燕麦","pinyin":"tù kuí yàn mài","abbr":"tkym","explanation":"形容景象荒凉。","source":{"text":"重游玄都，荡然无复一树，唯有兔葵燕麦动摇于春风耳。","book":"唐·刘禹锡《再游玄都观》序"},"example":{"text":"～，向残阳，欲与人齐。","book":"宋·周邦彦《夜飞鹊》词"},"similar":["燕麦兔葵"],"usage":"作宾语、定语；用于书面语"},{"id":7120,"word":"兔角牛翼","pinyin":"tù jiǎo niú yì","abbr":"tjny","explanation":"兔不生角，牛不长翼，故以之比喻不合情理之事。","source":{"text":"若然，始者果不可知，即万论若兔角牛翼矣。","book":"章炳麟《国故论衡·明见》"},"similar":["乌白马角"],"usage":"作宾语、定语；用于比喻句"},{"id":7121,"word":"兔角龟毛","pinyin":"tù jiǎo guī máo","abbr":"tjgm","explanation":"兔生角，龟长毛。都是没有的事。比喻有名无实。","source":{"text":"如兔角龟毛，亦但有名而无实。","book":"《大智度论》第12卷"},"similar":["龟毛兔角"],"usage":"作宾语、定语；指虚无的东西"},{"id":7122,"word":"兔走乌飞","pinyin":"tù zǒu wū fēi","abbr":"tzwf","explanation":"乌：古代传说日中有三足乌，故称太阳为金乌；兔：古代传说中月中有玉兔，故称月亮为玉兔。形容光阴迅速流逝。","source":{"text":"行人自是心如火，兔走乌飞不觉长。","book":"唐·韦庄《秋日早行》诗"},"example":{"text":"我且花前沉醉，管甚个～，白发蒙头。","book":"明·唐寅《春日花前咏怀》"},"similar":["日月穿梭","兔缺乌沉"],"usage":"作宾语；指时光流逝"},{"id":7123,"word":"兔走鹘落","pinyin":"tù zǒu gǔ luò","abbr":"tzgl","explanation":"比喻动作敏捷。也比喻绘画或写文章迅捷流畅。见“兔起鹘落”。","source":{"text":"行宣政院命长明之瑞云山清凉寺，学徒奔凑，机锋相加，如兔走鹘落，瞬目辄失。","book":"明·宋濂《佛光普照大师塔铭》"},"similar":["兔起鹘落"],"usage":"作宾语、状语；用于书面语"},{"id":7124,"word":"兔起乌沉","pinyin":"tù qǐ wū chén","abbr":"tqwc","explanation":"指月出日落。","source":{"text":"金乌飞，玉兔走，青鬓常青古无有。","book":"唐·韩琮《春愁》"},"usage":"作宾语、定语；用于书面语"},{"id":7125,"word":"兔起凫举","pinyin":"tǔ qǐ fú jǔ","abbr":"tqfj","explanation":"凫：野鸭。象兔敢奔跑，象野鸭急飞。比喻行动迅速。","source":{"text":"知其不可久处，则知所兔起凫举，死惛之地矣。","book":"《吕氏春秋·论威》"},"similar":["兔起鹘落"],"usage":"作状语；用于书面语"},{"id":7126,"word":"兔起鹘落","pinyin":"tù qǐ hú luò","abbr":"tqhl","explanation":"鹘：打猎用的鹰一类的猛禽。兔子刚跳起来，鹘就飞扑下去。比喻动作敏捷。也比喻绘画或写文章迅捷流畅。","source":{"text":"振笔直遂，以追其所见，如兔起鹘落，少纵即逝矣。","book":"宋·苏轼《文与可画云当谷偃竹记》"},"example":{"text":"此事如～，少纵即逝，此媪亦捷疾若神矣。","book":"清·纪昀《阅微草堂笔记》卷十"},"similar":["兔起凫举","兔走鹘落"],"opposite":["拖泥带水","蜗行牛步"],"usage":"作宾语、状语；用于书面语"},{"id":7127,"word":"党同伐异","pinyin":"dǎng tóng fá yì","abbr":"dtfy","explanation":"伐：讨伐，攻击。指结帮分派，偏向同伙，打击不同意见的人。","source":{"text":"自武帝以后，崇尚儒学，怀经协术，所在雾会。至有石渠分争之论，党同伐异之说。","book":"《后汉书·党锢传序》"},"example":{"text":"读者幸勿比例惴测，谓此事为某人写照，此名为某人化身，致生种种～意见。","book":"清·梁启超《新中国未来记·绪言》"},"similar":["结私营党","诛除异己","朋比为奸"],"opposite":["无偏无坦","公正无私","不偏不倚"],"usage":"作谓语、宾语、定语；用于书面语","story":["西汉时期，汉武帝采纳董仲舒的“罢黜百家，独尊儒术”的建议，设置了专门传授儒学的五经博士。到汉宣帝时由萧望之在黄家藏书楼进行一次大规模的儒学讨论。讨论中，儒生们把和自己观点一致的人作为同党去攻击那些观点不一致的人"]},{"id":7128,"word":"党同妒异","pinyin":"dǎng tóng dù yì","abbr":"dtdy","explanation":"犹言党同伐异。指结帮分派，偏向同伙，打击不同意见的人。","source":{"text":"君以律有违经背礼，著《妨难》十九篇，书奏，帝下有司而删定之；官党同妒异，竟寝其议。","book":"唐·张说《府君墓志铭》"},"similar":["党同伐异"],"opposite":["一视同仁"],"usage":"作谓语、定语；用于处事"},{"id":7129,"word":"党坚势盛","pinyin":"dǎng jiān shì shèng","abbr":"djss","explanation":"指团结紧、势力盛大。"},{"id":7130,"word":"党恶佑奸","pinyin":"dǎng è yòu jiān","abbr":"deyj","explanation":"指偏护奸恶。","source":{"text":"党恶佑奸，坏风伤教，千载之下，罪有所归。","book":"元·耶律楚材《辨邪论序》"},"usage":"作谓语、宾语；用于包庇坏人"},{"id":7131,"word":"党恶朋奸","pinyin":"dǎng è péng jiān","abbr":"depj","explanation":"党：袒护，偏袒；朋：朋比，互相勾结。袒护恶人，与坏人相互勾结。","source":{"text":"义师所指，戮在一人，元恶既除，勿有所问。其有党恶朋奸，甘为逆羽，杀无敕。","book":"蔡东藩、许廑父《民国通俗演义》第五十九回"},"similar":["朋比为奸"],"usage":"作谓语、宾语、定语；用于坏人"},{"id":7132,"word":"党豺为虐","pinyin":"dǎng chái wéi nüè","abbr":"dcwn","explanation":"党：结成团伙；豺：一种凶恶的野兽，常比喻凶残的人。虐：残暴。与凶残的人结成团伙做残害人的勾当。","source":{"text":"且鄙人虽愚，独不知夫狼乎？性贪而狠，党豺为虐，君能除之，固当窥左足以效微劳，又肯讳之而不言哉？","book":"明·马中锡《中山狼传》"},"similar":["狼狈为奸","助纣为虐"],"usage":"作谓语；指坏人"},{"id":7133,"word":"党邪丑正","pinyin":"dǎng xié chǒu zhèng","abbr":"dxcz","explanation":"犹言党邪陷正。与坏人结伙，陷害好人。","source":{"text":"崇祯四年征授御史，疏劾周延儒卑污奸险，党邪丑正，祈立斥以清揆路。","book":"《明史·路振飞传》"},"similar":["党邪陷正"],"usage":"作谓语、定语；多用于坏人"},{"id":7134,"word":"党邪陷正","pinyin":"dǎng xié xiàn zhèng","abbr":"dxxz","explanation":"与坏人结伙，陷害好人。","source":{"text":"璟谓曰：‘名义至重，神道难欺，必不可党邪陷正，以求苟免！’","book":"《旧唐书·宋璟传》"},"similar":["党邪丑正"],"usage":"作谓语、定语；多用于坏人"},{"id":7135,"word":"兜头盖脸","pinyin":"dōu tóu gài liǎn","abbr":"dtgl","explanation":"正对着头和脸。","example":{"text":"他拿起木棒对小偷～一顿猛打。"},"similar":["兜头盖脑","兜头扑面"],"usage":"作状语；同“劈头盖脸”"},{"id":7136,"word":"兜肚连肠","pinyin":"dōu dǔ lián cháng","abbr":"ddlc","explanation":"兜：围绕，引申为包括；肚：指动物的胃。包括肚子连同肠子。比喻全部东西一起处理。","source":{"text":"吃了几筷，滑溜溜的不知道是鱼是人，便把他兜肚连肠的吐出。","book":"鲁迅《狂人日记》"},"similar":["翻肠倒肚"],"usage":"作状语；比喻全部东西一起处理"},{"id":7137,"word":"兢兢业业","pinyin":"jīng jīng yè yè","abbr":"jjyy","explanation":"兢兢：形容小心谨慎；业业：畏惧的样子。形容做事谨慎、勤恳。","source":{"text":"兢兢业业，如霆如雷。","book":"《诗经·大雅·云汉》"},"example":{"text":"于是宁府中人才知凤姐厉害，自此俱～，不敢偷安。","book":"清·曹雪芹《红楼梦》第十四回"},"similar":["脚踏实地"],"opposite":["敷衍了事","敷衍塞责"],"usage":"作宾语、状语；指人处世认真","story":["东晋时期荆州官吏陶侃，他勤于政事，处理政务从不拖延，对下属的赌博及贪小便宜的行为严惩不贷。他主张勤俭节约，经常将造船的木屑留作冬天雪地吸潮用，将造船剩下的竹屑、竹枝制成钉子再造船，对待工作真是兢兢业业"]},{"id":7138,"word":"兢兢乾乾","pinyin":"jīng jīng qián qián","abbr":"jjqq","explanation":"指敬慎自强。","source":{"text":"兢兢乾乾，以徼福于上下，必能使天感神应，反妖灾为和气矣。","book":"《新唐书·独孤及传》"},"usage":"作谓语；指人自强"},{"id":7139,"word":"兢兢切切","pinyin":"jīng jīng qiè qiè","abbr":"jjqq","explanation":"兢兢业业，小心翼翼。","source":{"text":"他一向都是～地处事。"},"example":{"text":"他一向都是～地处事"},"similar":["兢兢业业"],"usage":"作定语、状语；用于处事"},{"id":7140,"word":"兢兢干干","pinyin":"jīng jīng gàn gàn","abbr":"jjgg","explanation":"指敬慎自强。"},{"id":7141,"word":"兢兢战战","pinyin":"jīng jīng zhàn zhàn","abbr":"jjzz","explanation":"兢兢：小心谨慎的样子；战战：畏惧的样子。形容害怕而小心谨慎的样子。","source":{"text":"元·无名氏《抱妆盒》第四折：“小储君倒也安安稳稳守着妆盒做护身符，则是我陈琳兢兢战战抱着个天大闷葫芦”。"}},{"id":7142,"word":"兢兢翼翼","pinyin":"jīng jīng yì yì","abbr":"jjyy","explanation":"形容做事谨慎、勤恳。同“兢兢业业”。","source":{"text":"恒劳庶事，兢兢翼翼，亲桑蚕馆。","book":"三国·魏·曹植《卞太后诔》"},"similar":["兢兢业业"],"opposite":["敷衍了事"],"usage":"作宾语、状语；指人处世认真"},{"id":7143,"word":"入不支出","pinyin":"rù bù zhī chū","abbr":"rbzc","explanation":"收入不够支出。","source":{"text":"入少出多，往往例于常赋之外，多收加耗，重折价钱，尚且入不支出，公私俱困。","book":"宋·朱熹《行宫便殿奏札三》"},"similar":["入不敷出","入少出多"],"usage":"作谓语、定语；形容经济困难"},{"id":7144,"word":"入不敷出","pinyin":"rù bù fū chū","abbr":"rbfc","explanation":"敷：够，足。收入不够支出。","source":{"text":"但是家计萧条，入不敷出。","book":"清·曹雪芹《红楼梦》第一百七回"},"example":{"text":"他家人口太多，收入少，常常～。"},"similar":["捉襟见肘","入不支出"],"opposite":["绰绰有余"],"usage":"作谓语、定语、宾语；形容经济困难","story":["贾府被抄家后，贾赦、贾珍被流放，原来与贾府走得近的人纷纷回避。皇上念贾妃的旧情，封贾政世袭旧职，有些人又回到贾政的身边。但此时的贾府家计萧条，入不敷出，一天不如一天。薛府也被薛蟠弄得接近家破人亡"]},{"id":7145,"word":"入主出奴","pinyin":"rù zhǔ chū nú","abbr":"rzcn","explanation":"原意是崇信了一种学说，必然排斥另一种学说；把前者奉为主人，把后者当作奴仆。后比喻学术思想上的宗派主义。","source":{"text":"入于彼，必出于此；入者主之，出者奴之；入者附之，出者污之。","book":"唐·韩愈《原道》"},"example":{"text":"往往持以树门户，～，视他文人未尝显然标三先生为宗主者。","book":"清·平步清《霞外捃屑》卷七"},"usage":"作谓语；指持门户之见"},{"id":7146,"word":"入乡问俗","pinyin":"rù xiāng wèn sú","abbr":"rxws","explanation":"进入一个地方，先要问清那里的习俗，以求适应当地的情况。同“入国问俗”。","source":{"text":"我们要吸收群众的经验，一定要‘入乡问俗’。","book":"《解放日报》1944.4.5"},"similar":["入国问禁"],"usage":"作谓语、宾语、定语；用于处事"},{"id":7147,"word":"入乡随俗","pinyin":"rù xiāng suí sú","abbr":"rxss","explanation":"到一个地方，就顺从当地的习俗。","source":{"text":"入其俗，从其令。","book":"《庄子·山木》"},"example":{"text":"庞贝古城潜藏得过于轰轰烈烈，中国人温文尔雅，连自然力也～，一层层地慢慢来。","book":"余秋雨《文化苦旅·五城记》"},"similar":["入境问俗","因地制宜"],"usage":"作宾语、分句；指顺从当地的习俗"},{"id":7148,"word":"入井望天","pinyin":"rù jǐng wàng tiān","abbr":"rjwt","explanation":"比喻眼光狭小，看到的有限。","source":{"text":"坐井而观天，曰天小者，非天小也。","book":"唐·韩愈《原道》"}},{"id":7149,"word":"入吾彀中","pinyin":"rù wǔ gòu zhōng","abbr":"rwgz","explanation":"彀：张满弓弩；彀中：指箭能射及的范围，比喻牢笼，圈套。进入了我的弓箭射程之内。比喻就范。","source":{"text":"私幸端门，见新进士缀行而出，喜曰：‘天下英雄入吾彀中矣！’","book":"五代·王定保《唐摭言》卷一"},"example":{"text":"兹乃投其所好，荣以正位，亦安有不～哉！","book":"清·淮阴百一居士《壶天录》"},"similar":["尽入彀中"],"usage":"作谓语；比喻就范","story":["唐朝时期，唐太宗李世民特别重视选拔人才，设立御史府，每年都取进士补充国家的人才库。一次李世民私自去视察御史府，看到许多新考取的进士鱼贯而出，便得意地说：“天下英雄入吾彀中矣！”"]},{"id":7150,"word":"入品用荫","pinyin":"rù pǐn yòng yīn","abbr":"rpyy","explanation":"品：指官级；荫：封建官僚的子孙以先代官级而受封。指继承先辈的官爵。","source":{"text":"功过注授，加官差遣，入品用荫，如命官法。","book":"《大宋宣和遗事》前集"}},{"id":7151,"word":"入国问俗","pinyin":"rù guó wèn sú","abbr":"rgws","explanation":"国：原指都城，后多指国家。到别的国家或地方去，先要了解它的风俗习惯。","source":{"text":"入竟而问禁，入国而问俗，入门而问讳。","book":"西汉·戴圣《礼记·曲礼上》"},"example":{"text":"夏酋诘以～之义。","book":"宋·岳珂《悜史·张元吴昊》"},"similar":["入邦问俗","入境问俗"],"usage":"作宾语、定语；指尊重别国的风俗"},{"id":7152,"word":"入国问禁","pinyin":"rù guó wèn jìn","abbr":"rgwj","explanation":"进入别国境界，先了解他们的禁令或禁忌。","example":{"text":"现在～可以在网上进行了。"},"similar":["入境问俗"],"opposite":["毫不忌讳"],"usage":"作主语、宾语、定语；指适应异国文化"},{"id":7153,"word":"入土为安","pinyin":"rù tú wéi ān","abbr":"rtwa","explanation":"旧时土葬，人死后埋入土中，死者方得其所，家属方觉心安。","source":{"text":"亲戚多道：‘从来说入土为安，为何要拘定三年？’","book":"明·冯惟敏《耍孩儿·骷髅诉冤》曲：“自古道盖棺事定，入土为安。”明·凌濛初《二刻拍案惊奇》卷三十一"},"example":{"text":"舍妹已断了气，也该出殡了。在家虽好，但一则火烛当心，二者死者亦可以早些～。","book":"清·吴趼人《糊涂世界》第十二回"},"opposite":["弃尸荒野"],"usage":"作谓语、定语、分句；用于劝慰"},{"id":7154,"word":"入圣超凡","pinyin":"rù shèng chāo fán","abbr":"rscf","explanation":"凡：指凡人，普通人。超越平常人而达到圣贤的境界。形容学识修养达到了高峰。","source":{"text":"举世若能知所寓，超凡入胜弗为难。","book":"唐·吕岩《七言之二》"},"example":{"text":"服肉芝延年益寿，食朱草入圣超凡。","book":"清·李汝珍《镜花缘》第九回"},"similar":["超凡入圣"],"usage":"作谓语、定语；指人的思想或修养"},{"id":7155,"word":"入地无门","pinyin":"rù dì wú mén","abbr":"rdwm","explanation":"形容陷入无路可走的困境。","source":{"text":"进前即触途成滞，退后即噎气填胸，直得上天无路，入地无门。","book":"宋·释普济《五灯会元·法眼宗·西余体柔禅师》"},"example":{"text":"那时节，我真是上天无路，～，不得已，只好只身离家，闯荡江湖。"},"similar":["上天无路"],"usage":"作宾语、定语、分句；与“上天无路”连用"},{"id":7156,"word":"入境问俗","pinyin":"rù jìng wèn sú","abbr":"rjws","explanation":"进入别的国家，先问明有哪些禁止的事及风俗习惯，以免违犯。","source":{"text":"入竟而问禁，入国而问俗，入门而问讳。","book":"西汉·戴圣《礼记·曲礼上》"},"example":{"text":"受命抚躬，已自知于不称；～，又复过于所期。","book":"宋·苏轼《密州谢上表》"},"similar":["入竟问禁","因地制宜"],"usage":"作宾语、分句；指尊重别人的文化"},{"id":7157,"word":"入境问禁","pinyin":"rù jìng wèn jìn","abbr":"rjwj","explanation":"境：国境；禁：禁止，指法令或习俗所不欢物事项。进入一个国家或地区，先要问清楚那里有什么禁令。","source":{"text":"入境而问禁，入国而问俗，入门而问讳。","book":"《礼记·曲礼上》"}},{"id":7158,"word":"入孝出弟","pinyin":"rù xiào chū tì","abbr":"rxct","explanation":"指回家要孝顺父母，出外要敬爱兄长。同“入孝出悌”。","source":{"text":"子曰：‘弟子入则孝，出则悌。’","book":"语出《论语·学而》"},"example":{"text":"小学之方，洒扫应对，～，动罔或悖。行有余力，诵诗读书，咏歌舞蹈。","book":"宋·朱熹《〈小学〉题辞》"},"similar":["入孝出悌"],"usage":"作谓语、定语；用于处世等"},{"id":7159,"word":"入孝出悌","pinyin":"rù xiào chū tì","abbr":"rxct","explanation":"指回家要孝顺父母，出外要敬爱兄长。亦作‘入孝出弟’。","source":{"text":"教之以德，齐之以礼，则民徙义而从善，莫不入孝出悌，夫何奢侈暴慢之有？","book":"语出《论语·学而》：“子曰：‘弟子入则孝，出则悌。’”汉·桓宽《盐铁论·授时》"},"example":{"text":"诸子敬奉教，从进士，贡有司，～，朝经暮史，闾巷之间循循焉。","book":"宋·叶適《孟达甫墓志铭》"},"similar":["入孝出弟"],"usage":"作谓语、定语；用于处世等"},{"id":7160,"word":"入宝山而空回","pinyin":"rù bǎo shān ér kōng huí","abbr":"rbsekh","explanation":"宝山：聚藏宝物的山。进入满藏宝物的山间却空着手而回来。比喻虽遇到了很好的机会，却一无所得。","source":{"text":"在婿固不敢厚望，入宝山而空回，想岳亦不能忘情也。","book":"《先拨志始》卷下"}},{"id":7161,"word":"入宝山而空手回","pinyin":"rù bǎo shān ér kōng shǒu huí","abbr":"rbseksh","explanation":"宝山：聚藏宝物的山。进入满藏宝物的山间却空手回来。比喻虽然遇到了很好的机会，却毫无所得。","source":{"text":"如人无手，虽至宝山，终无所得。","book":"《大乘本生心地观经·离世间品》下卷"},"example":{"text":"在婿固不敢厚望，～，想岳亦不能忘情也。","book":"明·文秉《先拨志始》下卷"},"usage":"作宾语、定语；常用于比喻句"},{"id":7162,"word":"入室升堂","pinyin":"rù shì shēng táng","abbr":"rsst","explanation":"比喻人的学识技艺等方面有高深的造诣。","source":{"text":"卫将军文子问于子贡曰：‘吾闻孔子之施教也，先之以《诗》《书》，而道之以孝悌，说之以仁义，观之以礼乐，然后成之以文德。盖入室升堂者七十余人，其孰为贤？’","book":"《孔子家语·弟子行》"},"example":{"text":"自傅季友以来，始复见于任子。若孔门是用，其～。","book":"《南史·任昉传》"},"similar":["升堂入室","登堂入室"],"usage":"作谓语、定语；用于比喻句"},{"id":7163,"word":"入室弟子","pinyin":"rù shì dì zǐ","abbr":"rsdz","explanation":"入室：到家；弟子：学生，徒弟。指学问技能得师传达到高深境地的学生或门徒。","source":{"text":"由也升堂矣，未入于室也。","book":"春秋·鲁·孔丘《论语·先进》"},"example":{"text":"虽受业门徒，非～，莫得亲言。","book":"《晋书·杨柯传》"},"usage":"作宾语、定语；用于书面语"},{"id":7164,"word":"入室操戈","pinyin":"rù shǐ cāo gē","abbr":"rscg","explanation":"操：拿；戈：古代象矛的武器。到他的屋里去，拿起他的武器攻击他。比喻引用对方的论点反驳对方。","source":{"text":"任城何休好《公羊》学，遂著《公羊墨守》、左氏膏肓》、《谷梁废疾》。玄乃‘发《墨守》、针《膏肓》、起《废疾》’。休见而叹曰：‘康成入吾室，操吾戈以伐我乎？’","book":"《后汉书·郑玄传》"},"example":{"text":"他口若悬河，～，一下就把对方驳得哑口无言。"},"similar":["以子之矛攻子之盾"],"usage":"作谓语、宾语；比喻引用对方的论点反驳他","story":["东汉时期著名的学者郑玄从师于孔融，深受孔融的喜爱，夸他能真正带走他的学问。郑玄征对学者何休的《公羊墨守》、《左氏膏肓》等文章发表自己的意见，击中要害。何休看后感叹地说：“郑玄进了我的屋子操起我的矛来讨伐我！”"]},{"id":7165,"word":"入室昇堂","pinyin":"rù shì shēng táng","abbr":"rsst","explanation":"比喻人的学识技艺等方面有高深的造诣。同“入室升堂”。"},{"id":7166,"word":"入室昻堂","pinyin":"rù shì shēng táng","abbr":"rsst","explanation":"比喻人的学识技艺等方面有高深的造诣。同入室升堂”。"},{"id":7167,"word":"入幕之宾","pinyin":"rù mù zhī bīn","abbr":"rmzb","explanation":"幕：帐幕；宾：客人。比喻关系亲近的人或参与机密的人。","source":{"text":"谢安与王坦之尝诣温论事，温令超帐中卧听之。风动帐开，安笑曰：‘郗生可谓入幕之宾矣。’","book":"《晋书·郗超传》"},"example":{"text":"东坡自此将佛印愈加敬重，遂为～。","book":"明·冯梦龙《醒世恒言》卷十二"},"similar":["入幕宾"],"usage":"作宾语；指幕僚","story":["晋朝时期，大将军桓温因为赫赫战功开始居功自傲，先是废海西公立晋文帝。后来又图谋篡夺皇位。他拉拢郗超等人。在召见敌对派谢安时，让郗超躲在幕后偷听。风把幕帐吹开暴露了郗超。谢安风趣地称他为入幕之宾"]},{"id":7168,"word":"入幕宾","pinyin":"rù mù bīn","abbr":"rmb","explanation":"幕：帐幕；宾：客人。比喻关系亲近的人或参与机密的人。","source":{"text":"远避看书吏，行当入幕宾。","book":"李瑞《送宋校书赴宣州幕》诗"},"similar":["入幕之宾"],"usage":"作宾语；指幕僚"},{"id":7169,"word":"入情入理","pinyin":"rù qíng rù lǐ","abbr":"rqrl","explanation":"入：合乎。合乎常情和道理。","source":{"text":"心斋侧着耳朵，觉得此段议论，入情入理，不禁连连点首。","book":"清·壮者《扫迷帚》第三回"},"example":{"text":"何尝不说得～，但是事实上那里有人听他的呢！（清·陈天华《狮子吼》第五回）"},"similar":["天公地道","天经地义","合情合理"],"opposite":["不近人情","强词夺理"],"usage":"作谓语、定语、补语；指符合情理"},{"id":7170,"word":"入文出武","pinyin":"rù wén chū wǔ","abbr":"rwcw","explanation":"称人兼备文武之才，入朝为文臣，出朝为将帅。","source":{"text":"总军挟郡，入文出武。三十年间，式遏戎虏。","book":"唐·张说《河西节度副大使都督安公碑》"},"usage":"作谓语、定语；用于书面语"},{"id":7171,"word":"入木三分","pinyin":"rù mù sān fēn","abbr":"rmsf","explanation":"相传王羲之在木板上写字，木工刻时，发现字迹透入木板三分深。形容书法极有笔力。现多比喻分析问题很深刻。","source":{"text":"王羲之书祝版，工人削之，笔入木三分。","book":"唐·张怀瓘《书断·王羲之》"},"example":{"text":"我们读这首诗，尤其有一种～、痛快淋漓的感受。","book":"秦牧《手莫伸》"},"similar":["力透纸背","铁画银钩"],"opposite":["略见一斑"],"usage":"作谓语、定语、状语、补语；指深刻","story":["东晋时期著名书法家王羲之7岁时开始练习书法，他练字十分刻苦，经常在水池边练字，池水都染黑了。33岁时写《兰亭集序》，37岁写《黄庭经》，后来因更换写字的木板，工匠发现王羲之笔力强劲，字迹已透入木板三分深"]},{"id":7172,"word":"入死出生","pinyin":"rù sǐ chū shēng","abbr":"rscs","explanation":"形容冒着生命危险。","source":{"text":"某经历海洋五十年，此身在炮弹中入死出生者数数矣！","book":"清·夏燮《中西纪事》卷八"},"similar":["出生入死"],"usage":"作谓语、定语、状语；用于赞扬人英勇"},{"id":7173,"word":"入海算沙","pinyin":"rù hǎi suàn shā","abbr":"rhss","explanation":"①到海底数沙子。比喻白费功夫。②又喻用力精勤。","source":{"text":"教秉固当学，若沉溺不返，如入海算沙，徒自困耳。","book":"明·宋濂《杭州灵隐寺故辅良大师石塔碑铭》"},"example":{"text":"文宪三阅《大藏》，～，有如指掌。","book":"清·钱谦益《宋文宪〈护法录〉序》"},"usage":"作宾语、定语；多用于比喻句"},{"id":7174,"word":"入火赴汤","pinyin":"rù huǒ fù tāng","abbr":"rhft","explanation":"比喻不避艰险。","source":{"text":"入火赴汤，下地上天，灰身没命，愿随大仙。","book":"《四游记·老君教源流》"},"similar":["赴汤蹈火"],"usage":"作谓语、定语；用于比喻句"},{"id":7175,"word":"入理切情","pinyin":"rù lǐ qiē qíng","abbr":"rlqq","explanation":"指合乎道理，切合实情。","source":{"text":"侯君妙才，同携游屐，是以逸情远兴，苍莽而来，而入理切情之言，反不能畅也。","book":"清·恽敬《与秦省吾》"},"usage":"作谓语、定语；用于说法等"},{"id":7176,"word":"入竟问禁","pinyin":"rù jìng wèn jìn","abbr":"rjwj","explanation":"竟：境的古字；禁：禁忌。进入一个国家或地区，先要问清楚那里有什么禁令，以免触犯。","source":{"text":"入竟而问禁者……竟，界首也。禁谓国中政教所忌。凡至竟界，当先访问主国何所禁也。","book":"西汉·戴圣《礼记·曲礼上》：“入竟而问禁，入国而问俗，入门而问讳。”孔颖达疏"},"similar":["入境问俗"],"usage":"作宾语、分句；指尊重别人的文化"},{"id":7177,"word":"入邦问俗","pinyin":"rù bāng wèn sú","abbr":"rbws","explanation":"到别的国家或地方去，先要了解它的风俗习惯。同“入国问俗”。","source":{"text":"‘入邦问俗，古之道也。’主人唱着古人的调子。","book":"叶圣陶《席间》"},"similar":["入国问俗"],"usage":"作宾语、定语；指尊重别国的风俗"},{"id":7178,"word":"入铁主簿","pinyin":"rù tiě zhǔ bù","abbr":"rtzb","explanation":"比喻有才能有经验的官员。","source":{"text":"淳清识敏速，达于从政，任司徒主簿，以能判断，见之时人，号为入铁主簿。","book":"《北齐书·许淳传》"},"usage":"作宾语、定语；用于书面语"},{"id":7179,"word":"入门问讳","pinyin":"rù mén wèn huì","abbr":"rmwh","explanation":"古代去拜访人，先问清楚他父祖的名，以便谈话时避讳。也泛指问清楚有什么忌讳。","source":{"text":"入境而问禁，入国而问俗，入门而问讳。","book":"《礼记·曲礼上》"},"usage":"作宾语、分句；指尊重别人的习俗"},{"id":7180,"word":"入阁登坛","pinyin":"rù gé dēng tán","abbr":"rgdt","explanation":"犹命相拜将。指荣任高官显爵。","source":{"text":"列公，你只看他这点遭际，我觉得比入阁登坛金闺紫诰还胜几分。","book":"《儿女英雄传》第二四回"},"similar":["登坛拜将"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":7181,"word":"入骨相思","pinyin":"rù gǔ xiāng sī","abbr":"rgxs","explanation":"形容思念之深，历久难移。","source":{"text":"井底点灯深烛伊，共郎长行莫围棋。玲珑骰子安红豆，入骨相思知不知？","book":"五代·温庭筠《新添声杨柳枝·二》词"},"usage":"作宾语、定语；用于书面语"},{"id":7182,"word":"入鲍忘臭","pinyin":"rù bào wàng chòu","abbr":"rbwc","explanation":"鲍：咸鱼。进了卖咸鱼的店，时间长了就闻不到腥味了。比喻环境熏染对人的影响极大。","source":{"text":"与恶人居，如入鲍鱼之肆，久而不闻其臭，亦与之化矣。","book":"汉·刘向《说苑·杂言》"},"example":{"text":"故胸驰臆断之侣，好名忘实之类，方分肉于仁兽，逞郤克于邯郸，～，效尤致祸。","book":"《梁书·庾肩吾传》"},"similar":["如入鲍鱼之肆，久而不闻其臭"],"usage":"作宾语、定语；用于书面语"},{"id":7183,"word":"全其首领","pinyin":"quán qí shǒu lǐng","abbr":"qqsl","explanation":"保住脑袋与性命。","source":{"text":"《国语·楚语下》“纵臣二得全其首领以没，惧子孙之以梁之险，而乏臣之祀也。”"},"example":{"text":"所望～者，实赖陛下圣哲钦明，使浸润之谮，不得行焉。","book":"蔡东藩《两晋演义》第五回"},"usage":"作谓语；指保命"},{"id":7184,"word":"全军覆没","pinyin":"quán jūn fù mò","abbr":"qjfm","explanation":"整个军队全部被消灭。比喻事情彻底失败。","source":{"text":"梅山七怪化成人形，与周兵屡战，俱被陆续诛灭，复现原形，大失朝廷体面，全军覆没；臣等只得逃回。","book":"明·许仲琳《封神演义》第九十三回"},"example":{"text":"太监郭敬监军，诸将悉为所制，师无纪律，而宋濂朱冕～矣。","book":"清·顾炎武《日知录》卷九"},"similar":["一败涂地","落花流水","全军覆灭"],"opposite":["得胜回朝","凯旋而归","旗开得胜"],"usage":"作谓语、定语；指彻底失败"},{"id":7185,"word":"全军覆灭","pinyin":"quán jūn fù miè","abbr":"qjfm","explanation":"整个军队全部被消灭。比喻事情彻底失败。","source":{"text":"官军皆为其所败，荆南节度使张伯仪全军覆没。","book":"《旧唐书·李希烈传》"},"example":{"text":"它的前途必然是众叛亲离，～。","book":"毛泽东《蒋介石政府已处在全民的包围中》"},"similar":["全军覆没"],"opposite":["凯旋而归"],"usage":"作谓语、定语、状语；指彻底失败"},{"id":7186,"word":"全力以赴","pinyin":"quán lì yǐ fù","abbr":"qlyf","explanation":"赴：前往。把全部力量都投入进去。","source":{"text":"盖当时荐徵辟，必采名誉，故凡可以得名者，必全力赴之，好为苟难，遂成风俗。","book":"清·越翼《廿二史札记·五·东汉尚名节》"},"example":{"text":"他们缺乏一种主动的积极的高兴的欢迎的～的精神。（毛泽东《〈中国农村的社会主义高潮〉序言》）"},"similar":["竭尽全力","全心全意"],"opposite":["敷衍了事","三心二意"],"usage":"作谓语、定语、状语；指尽全力"},{"id":7187,"word":"全力赴之","pinyin":"quán lì fù zhī","abbr":"qlfz","explanation":"赴：前往。把全部力量都投入进去。","source":{"text":"盖当时荐徵辟，必采名誉，故凡可以得名者，必全力赴之，好为苟难，遂成风俗。","book":"清·赵翼《廿二史札记·五·东汉尚名节》"},"example":{"text":"请朝廷主持，上下一心，以天下～，以赎回辽东半岛为归，否则枝枝节节为之，恐其不能及也。","book":"《清史稿·锡良传》"}},{"id":7188,"word":"全功尽弃","pinyin":"quán gōng jìn qì","abbr":"qgjq","explanation":"功：功效，功绩；弃：丢掉。全部功效都丧失干净。","source":{"text":"公之功甚多，今公又以秦兵出塞，过两周，践韩，而以攻梁，一攻而不得，前功尽灭。","book":"《战国策·西周策》"},"example":{"text":"战争历史中有在连战皆捷之后吃了一个败仗以至～的。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["前功尽弃"],"usage":"作谓语、定语；指白费力气"},{"id":7189,"word":"全受全归","pinyin":"quán shòu quán guī","abbr":"qsqg","explanation":"封建礼教认为人的身体来自父母，应当终身洁身自爱，以没有受过污辱损害的身体回到父母生我时那样。","source":{"text":"父母全而生之，于全而归之，可谓孝矣。","book":"西汉·戴圣《礼记·祭义》"},"example":{"text":"只闻古有孝子曾参，～，发肤无有毁伤者。","book":"太平天国·洪仁玕《英杰归真》"},"usage":"作谓语、分句；用于人"},{"id":7190,"word":"全国一盘棋","pinyin":"quán guó yī pán qí","abbr":"qgypq","explanation":"指全国各部门在中央统一领导下，全面安排，互相协作。","source":{"text":"社会主义同资本主义比较，它的优越性就在于能做到全国一盘棋，集中力量，保证重点。","book":"邓小平《前十年为后十年做好准备》"},"example":{"text":"必须按照～的精神，使目前利益同长远利益结合起来。","book":"陈云《当前基本建设工作中的几个重大问题》"},"similar":["通盘考虑"],"usage":"作宾语、定语；比喻全国要统筹兼顾"},{"id":7191,"word":"全始全终","pinyin":"quán shǐ quán zhōng","abbr":"qsqz","explanation":"全：完备，齐全；终：结束。从头到尾都很完善。形容办事认真，有头有尾。","source":{"text":"为人为彻，一定等那大王来吃了，才是个全始全终；不然，又教他降灾贻害，反为不美。","book":"明·吴承恩《西游记》第四十八回"},"example":{"text":"自今以后，各供其职，务要～，方不致贻国人之笑。","book":"清·陈忱《水浒后传》第三十九回"},"similar":["自始至终"],"opposite":["有头无尾"],"usage":"作谓语，分句；形容追求完美"},{"id":7192,"word":"全家福","pinyin":"quán jiā fú","abbr":"qjf","explanation":"全家人的合影或指荤的杂烩。形容全部聚集。","source":{"text":"我见到一幅徐悲鸿为康有为一家人画的‘全家福’。","book":"章诒和《往事并不如烟·最后的贵族》"},"example":{"text":"她拿出～让我们大家浏览。"},"similar":["合家欢"],"usage":"作宾语、定语；用于口语"},{"id":7193,"word":"全局在胸","pinyin":"quán jú zài xiōng","abbr":"qjzx","explanation":"对于全盘棋的走法心中有数。比喻对整个形势非常了解。","source":{"text":"没有全局在胸，是不会真的投下一着好棋子的。","book":"毛泽东《中国革命战争的战略问题》"},"example":{"text":"我们做事要有～的观念。"},"similar":["纵观全局"],"usage":"作宾语、定语；指全面看问题"},{"id":7194,"word":"全心全意","pinyin":"quán xīn quán yì","abbr":"qxqy","explanation":"投入全部精力，一点没有保留。","source":{"text":"体验生活的时候，就应该全心全意生活，把找题材的心思完全搁起来。","book":"茅盾《鼓吹集》"},"example":{"text":"有了这样的勇气才能够做到～为人民服务。","book":"巴金《作家要有勇气，文艺要有法制》"},"similar":["一心一意","真心实意"],"opposite":["三心二意","朝三暮四"],"usage":"作谓语、状语；指尽全力"},{"id":7195,"word":"全无人性","pinyin":"quán wú rén xìng","abbr":"qwrx","explanation":"指丝毫没有人性。","example":{"text":"敌人～，连小孩都不放过。"},"similar":["毫无人性","猪狗不如"],"usage":"作谓语、定语；指丝毫没有人性","story":["隋朝时期，开国皇帝隋文帝杨坚立皇后独孤氏的儿子杨广为太子，由于杨广一心想当皇帝，根本不把父亲放在眼里，公开调戏父亲的妃子，同时还长期霸占父亲的妃子陈夫人，在朝廷中胡作非为，连隋文帝拿他都没办法"]},{"id":7196,"word":"全无心肝","pinyin":"quán wú xīn gān","abbr":"qwxg","explanation":"比喻不知羞耻。","source":{"text":"叔宝全无心肝。","book":"《南史·陈后主纪》"},"example":{"text":"观其孜孜憨笑，似～者。","book":"清·蒲松龄《聊斋志异·婴宁》"},"similar":["没心没肺"],"opposite":["赤胆忠心"],"usage":"作谓语、定语；指毫无心计","story":["南朝陈后主陈叔宝在亡国后被俘到长安，隋文帝对他比较优待，不在他面前演奏吴地的乐曲，以防止他听到后引发亡国之痛。不料，后来看守陈后主的官员报告隋文帝说，陈后主想得到一个官号，隋文帝便说：“叔宝全无心肝。”"]},{"id":7197,"word":"全无忌惮","pinyin":"quán wú jì dàn","abbr":"qwjd","explanation":"指行为放肆，无任何顾忌和惧怕。","source":{"text":"其人凶暴贪婪，全无忌惮。","book":"宋·朱熹《申尚书省状》"},"example":{"text":"不以社稷为重，残害忠良，～。","book":"明·许仲琳《封神演义》第34回"},"similar":["肆无忌惮"],"usage":"作谓语、定语、状语；指一点没有顾忌"},{"id":7198,"word":"全智全能","pinyin":"quán zhì quán néng","abbr":"qzqn","explanation":"无所不知，无所不能。","source":{"text":"我看要是自称全智全能，像上帝一样，那种思想是不妥当的。","book":"毛泽东《党内团结的辨证方法》"},"example":{"text":"他号称～，其实啥也不懂。"},"similar":["全能全智"],"usage":"作宾语、定语；指无所不知，无所不能"},{"id":7199,"word":"全民皆兵","pinyin":"quán mín jiē bīng","abbr":"qmjb","explanation":"指把能参加战斗的人民全都武装起来，随时准备歼灭入侵之敌。","source":{"text":"我知道这种勾当已发展到五花八门、全民皆兵的程度。","book":"王朔《痴人》"},"example":{"text":"目前～是不必要的。"},"usage":"作主语、宾语、定语；指全民参加作战"},{"id":7200,"word":"全狮搏兔","pinyin":"quán shī bó tù","abbr":"qsbt","explanation":"搏：搏斗。形容发挥巨大威力攻击弱小的目标。","source":{"text":"他既要来螳臂当车，我何妨去全狮搏兔，给他一个下马威。","book":"曾朴《孽海花》第24回"},"usage":"作宾语、定语；多用于比喻句"},{"id":7201,"word":"全璧归赵","pinyin":"quán bì guī zhào","abbr":"qbgz","explanation":"本指蔺相如将和氏璧完好地自秦送回赵国。后比喻把原物完好地归还本人。同“完璧归赵”。","source":{"text":"动一议可以固邦兴国，全璧归赵，飞矢救燕。","book":"南朝·梁·王僧孺《与何炯书》"},"similar":["完璧归赵"],"usage":"作谓语、宾语；指物归原主"},{"id":7202,"word":"全盘托出","pinyin":"quán pán tuō chū","abbr":"qptc","explanation":"连盘子也端出来了。比喻全都讲出来，毫不保留。","source":{"text":"今日特为你起模画样，和盘托出。","book":"元·明本述《天目中峰和尚广录》卷十六"},"example":{"text":"洋人见他们有点肯的意思了，便将芜湖道的说话～。","book":"清·李宝嘉《文明小史》第四十四回"},"similar":["和盘托出"],"usage":"作谓语；指毫不保留"},{"id":7203,"word":"全知全能","pinyin":"quán zhī quán néng","abbr":"qzqn","explanation":"无所不知，无所不能。","source":{"text":"全知全能的主是大公无私的。","book":"郭沫若《郑成功》第四章"},"example":{"text":"要做到～是不容易的。"},"similar":["全智全能"],"usage":"作谓语、定语；指无所不知，无所不能"},{"id":7204,"word":"全神倾注","pinyin":"quán shén qīng zhù","abbr":"qsqz","explanation":"集中全部的精力。","source":{"text":"他全神倾注的只在哇的一声之后那最关紧要的一个报告。","book":"叶圣陶《遗腹子》"},"similar":["全神贯注","全神灌注"],"usage":"作谓语、定语、状语；指注意力集中"},{"id":7205,"word":"全神关注","pinyin":"quán shén guān zhù","abbr":"qsgz","explanation":"指一心注意。","source":{"text":"白知时并不认得他，何况此刻他全神关注的，只是那两个被人众打得鼻塌嘴歪的凶手。","book":"李劼人《天魔舞》第十章"},"similar":["全神贯注","全神倾注"],"usage":"作谓语、定语、状语；指注意力集中"},{"id":7206,"word":"全神灌注","pinyin":"quán shén guàn zhù","abbr":"qsgz","explanation":"形容注意力高度集中。同“全神贯注”。","source":{"text":"丁老师全神灌注地听着，有时候他得插句把嘴。","book":"张天翼《春风》"},"similar":["全神倾注"],"usage":"作谓语、定语、状语；指注意力集中"},{"id":7207,"word":"全神贯注","pinyin":"quán shén guàn zhù","abbr":"qsgz","explanation":"贯注：集中。全部精神集中在一点上。形容注意力高度集中。","source":{"text":"人事太忙，不许我们全神贯注，无间断地专怀念一个人。","book":"钱钟书《围城》"},"example":{"text":"雷参谋此时～在徐曼丽身上。","book":"茅盾《子夜》"},"similar":["专心致志","聚精会神"],"opposite":["漫不经心","心不在焉"],"usage":"作谓语、定语、状语；指注意力集中"},{"id":7208,"word":"全福远祸","pinyin":"quán fú yuǎn huò","abbr":"qfyh","explanation":"远：避开。旧时做官得意时，为免除官场勾心斗角的祸患而及时引退，以保全既得利益。比喻保全已得的幸福，避开祸患。","source":{"text":"今袁氏反此，而刘牧应之，取祸之道也。明府必欲立功明义，全福远祸，不宜与之同也。","book":"《三国志·魏志·桓阶传》"}},{"id":7209,"word":"全科人儿","pinyin":"quán kē rén ér","abbr":"qkre","explanation":"指父母、配偶、子女都健在的人。","example":{"text":"她守着这～生活，觉得十分幸福。"},"similar":["全福人儿","全乎人儿"],"usage":"作宾语、定语；多指妇女"},{"id":7210,"word":"全能全智","pinyin":"quán néng quán zhì","abbr":"qnqz","explanation":"无所不知，无所不能。同“全智全能”。","source":{"text":"它是‘知周乎万物而道济天下’的全能全智。","book":"郭沫若《中国古代社会研究》第一篇第二章第二节"},"example":{"text":"世界上没有～的人。"},"similar":["全智全能"],"usage":"作宾语、定语；指无所不知，无所不能"},{"id":7211,"word":"全身远害","pinyin":"quán shēn yuǎn hài","abbr":"qsyh","explanation":"促使自身，远离祸害。","source":{"text":"君子阳阳，闵周也。君子遭乱，相招为禄仕，全身远害而已。","book":"《诗经·王风·君子阳阳序》"},"example":{"text":"不如弃了这官职，隐迹埋名，～，岂不为美？","book":"清·钱彩《说岳全传》第六十回"},"similar":["远害全身","全身远祸"],"usage":"作谓语、定语、宾语；用于处事"},{"id":7212,"word":"全身远祸","pinyin":"quán shēn yuǎn huò","abbr":"qsyh","explanation":"保全自身，远离祸害。","source":{"text":"君子阳阳，闵周也。君子遭乱，相招为禄仕，全身远害而已。","book":"《诗经·王风·君子阳阳序》"},"example":{"text":"少爷，这只是一个退守之策，～而已。","book":"霍达《补天裂》第十一章"},"similar":["全身远害","远害全身"],"usage":"作谓语、定语、宾语；用于处事"},{"id":7213,"word":"全躯保妻子","pinyin":"quán qū bǎo qī zǐ","abbr":"qqbqz","explanation":"比喻只顾保全自己的身躯和保护家属的平安。","source":{"text":"今举事一不当，而全躯保妻子之臣，随而媒孽其短，仆诚私心痛之。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"适张子布等，又劝主公休动兵，力主降议，此皆～之臣，为自谋之计耳。","book":"明罗贯中《三国演义》第四十三回"}},{"id":7214,"word":"八万四千","pinyin":"bā wàn sì qiān","abbr":"bwsq","explanation":"本为佛教表示事物众多的数字，后用以形容极多。","source":{"text":"若持八万四千法藏，十二部经，为人演说。","book":"《法华经·宝塔品》"},"example":{"text":"～颠倒想，与君同付醉眠中。","book":"宋·陆游《醉歌》"},"similar":["十万八千"],"usage":"作宾语、定语；指很多"},{"id":7215,"word":"八两半斤","pinyin":"bā liǎng bàn jīn","abbr":"blbj","explanation":"八两：即半斤，旧制一斤为十六两。半斤、八两轻重相等。比喻彼此不相上下","source":{"text":"像你两个，一对材料，真是八两半斤。","book":"清·李百川《绿野仙踪》第19回"},"similar":["半斤八两"],"usage":"作宾语、定语；用于比较等"},{"id":7216,"word":"八九不离十","pinyin":"bā jiǔ bù lí shí","abbr":"bjbls","explanation":"指与实际情况很接近。","source":{"text":"可是比较的，我还算是他的熟人，自幼儿的同学。我不敢说是明白他，不过讲猜测的话，我或者能猜个八九不离十。","book":"老舍《柳屯的》"},"example":{"text":"不用你说，我一猜就能猜出个八九不离十。"},"similar":["相差无几"],"opposite":["天差地别"],"usage":"作宾语、定语、分句；用于口语"},{"id":7217,"word":"八仙过海","pinyin":"bā xiān guò hǎi","abbr":"bxgh","explanation":"相传八仙过海时不用舟船，各有一套法术。民间因有“八仙过海，各显神通”的谚语。后以比喻各自拿出本领或办法，互相竞赛。","source":{"text":"则俺这八仙过海神通大，方显这众圣归山道法强，端的万古名扬。","book":"明·无名氏《八仙过海》第二折"},"example":{"text":"说得好，咱们就～吧！","book":"老舍《茶馆》第一幕"},"similar":["各显其能"],"opposite":["黔驴技穷"],"usage":"作谓语、宾语；形容各人使出自己的本事","story":["传说中道家有八大仙人去参加王母娘娘的蟠桃会，他们来到东海边，吕洞宾建议各自渡海，铁拐李站在龙头杖上，韩湘子坐在花蓝里，吕洞宾、蓝采和、张果老、汉钟离、何仙姑、曹国舅乘各自的箫、纸驴、拍板、鼓、竹罩、玉板渡海"]},{"id":7218,"word":"八仙过海，各显其能","pinyin":"bā xiān guò hǎi，gè xiǎn qí néng","abbr":"bxghgxqn","explanation":"八仙：道教传说中的八位神仙。比喻做事各有各的一套办法。也比喻各自拿出本领互相比赛。","source":{"text":"正是八仙同过海，独自显神通。","book":"明·吴承恩《西游记》第八十一回"},"example":{"text":"说得好，咱们就～吧！","book":"老舍《茶馆》第一幕"},"similar":["八仙过海，各显神通"],"usage":"作定语、分句、宾语；比喻个人有自己的本事","story":["传说中道家有八大仙人去参加王母娘娘的蟠桃会，他们来到东海边，吕洞宾建议各自渡海，铁拐李站在龙头杖上，韩湘子坐在花蓝里，吕洞宾、蓝采和、张果老、汉钟离、何仙姑、曹国舅乘各自的箫、纸驴、拍板、鼓、竹罩、玉板渡海"]},{"id":7219,"word":"八仙过海，各显神通","pinyin":"bā xiān guò hǎi，gè xiǎn shén tōng","abbr":"bxghgxst","explanation":"八仙：道教传说中的八位神仙。比喻做事各有各的一套办法。也比喻各自拿出本领互相比赛。","source":{"text":"正是八仙同过海，独自显神通。","book":"明·吴承恩《西游记》第八十一回"},"example":{"text":"我如今与舍弟分开，这弟兄们是～。我叫舍弟看看我的过法。","book":"清·李绿园《歧路灯》第六十八回"},"similar":["八仙过海，各显其能"],"usage":"作分句、宾语；比喻个人有自己的本领","story":["传说中道家有八大仙人去参加王母娘娘的蟠桃会，他们来到东海边，吕洞宾建议各自渡海，铁拐李站在龙头杖上，韩湘子坐在花蓝里，吕洞宾、蓝采和、张果老、汉钟离、何仙姑、曹国舅乘各自的箫、纸驴、拍板、鼓、竹罩、玉板渡海"]},{"id":7220,"word":"八公山上，草木皆兵","pinyin":"bā gōng shān shàng，cǎo mù jiē bīng","abbr":"bgsscmjb","explanation":"八公山：在安徽淮西市西。将八公山上的草木，都当作是士兵。形容极度惊恐，疑神疑鬼。","source":{"text":"坚与苻融登城而望王师，见部阵齐整，将士精锐；又北望八公山上草木皆类人形，顾谓融曰：‘此亦劲敌也，何谓少乎？’怃然有惧色。","book":"《晋书·苻坚载记》"},"example":{"text":"“～”，是错觉的一例。","book":"毛泽东《论持久战》"},"similar":["惊愕失色"],"opposite":["勇者不惧"],"usage":"作主语、定语、分句；形容畏惧惊恐到极点","story":["东晋时期，前秦国王苻坚企图消灭东晋，东晋宰相谢安派谢石为征讨大都督，分兵三路夹击秦军。苻坚登上寿阳城，看见晋君阵容整齐有些畏惧。晋军用计围攻苻坚的秦军，秦军大败，在溃逃的过程中看到八公山上草木的阴影，都以为是追兵"]},{"id":7221,"word":"八公草木","pinyin":"bā gōng cǎo mù","abbr":"bgcm","explanation":"将八公山的草木视为敌人。形容心情极为紧张和恐惧。","source":{"text":"（苻）坚与苻融登城而望王师，见部阵齐整，将士精锐，又北望八公山上草木皆类人形，顾谓融曰：‘此亦劲敌也，何谓少乎？’怃然有惧色。","book":"《晋书·苻坚载记下》"},"example":{"text":"这事让我有～的余悸。"},"similar":["八公山上，草木皆兵"],"usage":"作宾语、定语；指草木皆兵","story":["东晋时期，前秦国王苻坚企图消灭东晋，东晋宰相谢安派谢石为征讨大都督，分兵三路夹击秦军。苻坚登上寿阳城，看见晋君阵容整齐有些畏惧。晋军用计围攻苻坚的秦军，秦军大败，在溃逃的过程中看到八公山上草木的阴影，都以为是追兵"]},{"id":7222,"word":"八字打开","pinyin":"bā zì dǎ kāi","abbr":"bzdk","explanation":"象“八”字那样，撇、捺向两边分开。原意是放着正路不走，却走歪门邪道。也形容门路很宽。","source":{"text":"圣贤已是八字打开了，但人自不领会，却向外狂走耳。","book":"宋·朱熹《与刘子澄书》"},"example":{"text":"这事已～，请大家多提建议。"},"similar":["开门见山","十字打开"],"usage":"作谓语、定语；比喻简单明了"},{"id":7223,"word":"八字没一撇","pinyin":"bā zì méi yī piě","abbr":"bzmyp","explanation":"比喻事情还没有眉目。","source":{"text":"若问是何宗，八字不著一。","book":"宋·释惟白《续传灯录》卷二十九"},"example":{"text":"我们是来保卫延安的，～，延安就能放弃？（杜鹏程《保卫延安》）"},"similar":["八字没见一撇"],"usage":"作宾语、定语；指没有眉目"},{"id":7224,"word":"八字没见一撇","pinyin":"bā zì méi jiàn yī piě","abbr":"bzmjyp","explanation":"比喻事情毫无眉目，未见端绪。","source":{"text":"孙锦标《通俗常言疏证》卷三：“《通俗编》：‘朱子《与刘子澄书》：圣贤已是八字打开了，人不自领会。’按今有‘八字不见两撇’之谚，似又因於此。凡事无端绪者，谓之八字不曾见两撇。”今通常作“八字没见一撇”。"},"example":{"text":"我们是来保卫延安的，～，延安就能放弃？","book":"杜鹏程《保卫延安》"},"similar":["八字没一撇"],"usage":"作谓语、宾语、定语、分句；指事情还没眉目"},{"id":7225,"word":"八府巡按","pinyin":"bā fǔ xún àn","abbr":"bfxa","explanation":"巡按之名，起于明代，非固定职官，临时由朝廷委派监察御史担任，分别巡视各省，考核吏治。“八府巡按”常见于戏曲、小说，民间多视为清廉而有权势的大官。","example":{"text":"你如今是～，为父的乃是个皂班头，诚恐砧辱于你，这也无妨紧要，待我回得衙去，写个辞条，将这个皂班头辞掉也就是了。","book":"名家名剧之《胭脂宝褶》"}},{"id":7226,"word":"八恒河沙","pinyin":"bā héng hé shā","abbr":"bhhs","explanation":"佛家语，聚集八条恒河的沙。形容极多，无法计算。","source":{"text":"若有众生，于八河恒沙等佛所发菩提心，然后乃能于恶世中不谤是法。","book":"《大般涅槃经》六"}},{"id":7227,"word":"八抬大轿","pinyin":"bā tái dà jiào","abbr":"btdj","explanation":"大官坐的由八个人抬着走的大轿子，是身分重要的标志。","source":{"text":"大人这一次出京，坐的八抬大轿，比先前更显荣耀。","book":"清·贪梦道人《彭公案》第44回"},"example":{"text":"她就是用～抬我，我也不去。"},"usage":"作主语、宾语、定语；用于口语"},{"id":7228,"word":"八拜为交","pinyin":"bā bài wéi jiāo","abbr":"bbwj","explanation":"八拜：古代世交子弟谒见长辈的礼节；交：交情，友谊。旧时称异姓结拜兄弟或姐妹的关系。","source":{"text":"在下姓关名铃，曾与岳元帅的公子八拜为交。","book":"清·钱彩《说岳全传》第58回"},"example":{"text":"现在还有～的习惯。"},"similar":["八拜之交"],"usage":"作谓语、定语；指结拜"},{"id":7229,"word":"八拜之交","pinyin":"bā bài zhī jiāo","abbr":"bbzj","explanation":"八拜：原指古代世交子弟谒见长辈的礼节；交：友谊。旧时朋友结为兄弟的关系。","source":{"text":"丰稷谒潞公，公着道出，语之曰：汝父吾客也，只八拜。稷不得已，只拜之。","book":"宋·邵伯温《闻见后录》"},"example":{"text":"今日在圣贤炉前成了～，有福同享，有马同骑。","book":"清·李绿园《歧路灯》第二十回"},"similar":["金兰之好","八拜为交"],"opposite":["一日之雅"],"usage":"作宾语、定语；指结义为兄弟姐妹"},{"id":7230,"word":"八攻八克","pinyin":"bā gōng bā kè","abbr":"bgbk","explanation":"屡次攻击，屡次胜利。","source":{"text":"北敌势方强，娄师德八遇八克；南蛮心未服，诸葛亮七纵七擒。","book":"明·程登吉《幼学琼林》第一卷"},"example":{"text":"他们～，终于进军罗马。"},"similar":["百战百胜","八战八克"],"opposite":["屡战屡败"],"usage":"作谓语、定语；指接连胜利","story":["唐朝时期，文成公主入藏与吐蕃松赞干布联姻。松赞干布死后由年幼的孙子执政，大权由国相禄东赞控制，他大肆进攻吐谷浑。唐军前去征讨，先胜后败。河南原武人娄师德智勇双全，收集散兵游勇与吐蕃军进行激战，八攻八克取得了胜利，从此边境安宁"]},{"id":7231,"word":"八斗之才","pinyin":"bā dǒu zhī cái","abbr":"bdzc","explanation":"才：才华。比喻人极有才华。","source":{"text":"天下才共一石，曹子建独得八斗，我得一斗，自古及今共用一斗。","book":"《南史·谢灵运传》"},"example":{"text":"乃归来及一月，竟溘然长逝，年仅愈弱冠耳。怀～，饮万斛之恨。","book":"清·梁起超《饮冰室诗话·二四》"},"similar":["才高八斗","文江学海"],"opposite":["胸无点墨","绣花枕头"],"usage":"作宾语、定语；赞颂文人富有才学"},{"id":7232,"word":"八方呼应","pinyin":"bā fāng hū yìng","abbr":"bfhy","explanation":"呼应：彼此声气相通。泛指周围、各地。形容各方面互通声气，互相配合。","source":{"text":"我认为，天柱山之所以能给古人一种居家感，一个比较现实的原因是它地处江淮平原，四相钩连，八方呼应，水陆交通畅达，虽幽深而无登高之苦，虽奇丽而无柴米之匮，总而言之，既宁静又方便。","book":"余秋雨《寂寞天柱山》三"},"example":{"text":"中国申办奥运的计划一提出，立即八方呼应，群情激奋。"},"similar":["一呼百应"],"opposite":["孤掌难鸣"],"usage":"作谓语、定语；形容彼此呼应"},{"id":7233,"word":"八方支持","pinyin":"bā fāng zhī chí","abbr":"bfzc","explanation":"形容各方面都支持、援助。","example":{"text":"一方有难，～。"}},{"id":7234,"word":"八方支援","pinyin":"bā fāng zhī yuán","abbr":"bfzy","explanation":"形容各方面都支持、援助。","example":{"text":"一方有难，八方支援"},"opposite":["隔岸观火","袖手旁观"],"usage":"作谓语、定语；形容各方面都支援"},{"id":7235,"word":"八方风雨","pinyin":"bā fāng fēng yǔ","abbr":"bffy","explanation":"四面八方风雨聚会。比喻形势骤然变幻，动荡不安。","source":{"text":"万乘旌旗分一半，八方风雨会中州。","book":"唐·刘禹锡《郡内书情献裴度侍中留守》"},"example":{"text":"～寇氛急，祖国召呼赴战场。","book":"茅盾《丹江行·为碧野兄六十寿作》"},"usage":"作宾语；用于政治局势"},{"id":7236,"word":"八珍玉食","pinyin":"bā zhēn yù shí","abbr":"bzys","explanation":"泛指精美的肴馔。","source":{"text":"八珍玉食邀郎餐，千言万语对生意。","book":"金·董解元《西厢记诸宫调》卷三"},"similar":["山珍海味"],"opposite":["粗茶淡饭"],"usage":"作主语、宾语；形容珍美的食品"},{"id":7237,"word":"八百姻娇","pinyin":"bā bǎi yīn jiāo","abbr":"bbyj","explanation":"姻娇：美女。指美女众多。","source":{"text":"他双瞎，便宜的八百姻娇比并他，也未必强如俺娘娘带破赚丹青画。","book":"元·马致远《汉宫秋》第一折"},"similar":["美女如云"],"usage":"作宾语、定语；指美女众多"},{"id":7238,"word":"八百孤寒","pinyin":"bā bǎi gū hán","abbr":"bbgh","explanation":"八百：形容很多；孤寒：指贫寒的读书人。形容人数众多，处境贫寒的读书人。也比喻贫寒之士失去依靠。","source":{"text":"八百孤寒齐下泪，一时南望李崖州。","book":"五代·王定保《唐摭言·好放孤寒》"},"example":{"text":"小谪陈芳现在身，人间何事敝精神。幔亭仙客休相待，～要此人。","book":"清·黄景仁《两当轩集·十四·岁暮怀人》"},"similar":["白衣秀士"],"opposite":["白衣卿相"],"usage":"作谓语、定语；用于比喻贫寒之士失去依靠","story":["唐朝时期，太尉李德裕爱才如渴，经常提拔那些出身贫寒的读书人让他们入仕。这些贫苦的书生特别爱戴他，在他被贬到南荒之地时，纷纷为之悲痛，并作诗来描述他们的心情：“八百孤寒齐下泪，一时南望李崖州。”"]},{"id":7239,"word":"八砖学士","pinyin":"bā zhuān xué shì","abbr":"bzxs","explanation":"指懒惰的人。","source":{"text":"唐·李肇《翰林志》记载，李程为翰林学士，当时学士入署常以日影为候，冬天以阶前日至五砖为入时。李程性懒，每日过八砖才入，大家称他为八砖学士。"},"usage":"作宾语、定语；指懒人"},{"id":7240,"word":"八窗玲珑","pinyin":"bā chuāng líng lóng","abbr":"bcll","explanation":"①指四壁窗户轩敞，室内通彻明亮。②比喻通达明澈的修养境界。","source":{"text":"四户八窗明，玲珑逼上清。","book":"唐·卢纶《赋得彭祖楼送杨德宗归徐州幕》诗"},"example":{"text":"而今须是要打破那黑底虚静，换做个白底虚静，则～，无不融通。","book":"《朱子语类》卷一百"},"similar":["八面玲珑"],"usage":"作谓语、定语；指为人处世"},{"id":7241,"word":"八竿子打不着","pinyin":"bā gān zi dǎ bù zháo","abbr":"bgzdbz","explanation":"比喻远得不沾边。","source":{"text":"现在有些人，千方百计地寻找在国外八竿子打不着的亲友，想方设法要出去。","book":"母国政《飘飞的大雪》"},"example":{"text":"这是～的事情，怎么能联系上呢？"},"similar":["风马牛不相及"],"opposite":["亲密无间"],"usage":"作谓语、定语；指相距很远，用于口语"},{"id":7242,"word":"八索九丘","pinyin":"bā suǒ jiǔ qiū","abbr":"bsjq","explanation":"古书名。","source":{"text":"八卦之说，谓之八索；索，求其义也。九州之志，谓之九丘；丘，聚也。","book":"汉·孔安国《尚书序》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“三坟五典，乃三皇五帝之书；～，是八泽九州之志。”"},"usage":"作主语、宾语；指古书"},{"id":7243,"word":"八纮同轨","pinyin":"bā hóng tóng guǐ","abbr":"bhtg","explanation":"指天下一统。八纮，指八方极远之地。","source":{"text":"廓清梁、岷、包怀扬、越，八纮同轨，祥瑞屡臻。","book":"《晋书·武帝纪》"},"similar":["天下一统"],"usage":"作谓语、定语；指统一"},{"id":7244,"word":"八花九裂","pinyin":"bā huā jiǔ liè","abbr":"bhjl","explanation":"八处开了花，九处裂了缝。比喻漏洞、缝隙很多。","source":{"text":"僧问慧颙禅师曰：‘如何是无缝塔？’师曰：‘八花九裂。’","book":"宋·释普济《五灯会元》"},"example":{"text":"这事让他搅和得～。"},"similar":["千疮百孔","漏洞百出"],"opposite":["天衣无缝"],"usage":"作谓语、定语；指分裂"},{"id":7245,"word":"八荒之外","pinyin":"bā huāng zhī wài","abbr":"bhzw","explanation":"八面荒远的地方以外。形容极其旷远。","source":{"text":"虽远在八荒之外，近在眉睫之内，来干我者，我必知之。","book":"战国·郑·列御寇《列子·仲尼》"},"example":{"text":"在这～是不会有人来的。"},"opposite":["眉睫之内"],"usage":"作宾语；形容非常旷远"},{"id":7246,"word":"八街九陌","pinyin":"bā jiē jiǔ mò","abbr":"bjjm","explanation":"形容城市的街道纵横，市面繁华。","source":{"text":"长安城中，八街九陌。","book":"《三辅旧事》"},"example":{"text":"这场战争过后，昔日的～已成一片废墟。"},"similar":["大街小巷"],"usage":"作宾语；指城市"},{"id":7247,"word":"八门五花","pinyin":"bā mén wǔ huā","abbr":"bmwh","explanation":"八门：八门阵；五花：五行阵。古代两种战术变化很多的阵势。比喻变化多端或花样繁多。","source":{"text":"群峰乱峙，四布罗引，如平沙万幕，八门五花。","book":"清·张潮《虞初新志》"},"example":{"text":"世事多变，如～一般。"},"similar":["五花八门"],"opposite":["一成不变"],"usage":"作谓语、定语；指种类多"},{"id":7248,"word":"八难三灾","pinyin":"bā nàn sān zāi","abbr":"bnsz","explanation":"比喻小孩生来多病。也形容经常遭遇不幸。","source":{"text":"况且自己又三灾八难的，好容易怀了一个哥儿，到了六七个月还掉了。","book":"清·曹雪芹《红楼梦》第61回"},"example":{"text":"人总免不了～的。"},"similar":["三灾八难","三灾六难"],"opposite":["大富大贵"],"usage":"作宾语、定语；指多灾多难"},{"id":7249,"word":"八面受敌","pinyin":"bā miàn shòu dí","abbr":"bmsd","explanation":"①谓功力深厚，能应付各种情况。②砚名。","source":{"text":"子华（吴融）才力浩大，八面受敌，以八韵著称。","book":"五代·王保定《唐摭言海叙不遇》"},"example":{"text":"……若学成，～，与涉猎者不可同日而语也。","book":"宋苏轼《又答王庠书》"},"usage":"作谓语、定语；指人的处事能力"},{"id":7250,"word":"八面圆通","pinyin":"bā miàn yuán tōng","abbr":"bmyt","explanation":"形容为人处事圆滑，处处应付周全。","source":{"text":"第二要嘴巴会说，见人说人话，见鬼说鬼话，见了官场说官场上的话，见了生意人说生意场中的话，真正要八面圆通，十二分周到，方能当得此任。","book":"清·李宝嘉《官场现形记》第38回"},"example":{"text":"我终于见到他～的一面。"},"similar":["八面莹澈","八面玲珑"],"usage":"作谓语、定语；用于为人处事"},{"id":7251,"word":"八面威风","pinyin":"bā miàn wēi fēng","abbr":"bmwf","explanation":"威风：令人敬畏的气势。各个方面都很威风。形容神气足，声势盛。","source":{"text":"圣天子百灵相助，大将军八面威风。","book":"元·尚仲贤《单鞭夺槊》第四折"},"example":{"text":"年龄不到五十许，体态虽十分端丽，神情却八面威风。","book":"清·曾朴《孽海花》第十二回"},"similar":["威风凛凛","英姿飒爽","气宇轩昂"],"opposite":["无精打采","萎靡不振","卑躬屈膝"],"usage":"作谓语、定语；形容人很有气势，威风十足","story":["元朝末年，朱元璋带兵攻打元顺帝，拿下集庆，取得了决定性的胜利，便与大将徐达着便服渡江，被船夫认出。船夫喊号子：“圣天子六龙护驾，大将军八面威风。”朱元璋建立明朝后，重赏了这个船夫"]},{"id":7252,"word":"八面张罗","pinyin":"bā miàn zhāng luo","abbr":"bmzl","explanation":"形容各方面都应酬得好。","source":{"text":"黄二姐虽则已过中年，却还是个八面张罗人人喜欢的角色。","book":"茅盾《手的故事》"},"example":{"text":"他～，终于办成了此事。"},"similar":["八面玲珑"],"usage":"作谓语、定语；比喻各方面都处理得很好"},{"id":7253,"word":"八面玲珑","pinyin":"bā miàn líng lóng","abbr":"bmll","explanation":"玲珑：精巧细致，指人灵活、敏捷。本指窗户明亮轩敞。后用来形容人处世圆滑，待人接物面面俱到。","source":{"text":"虽是无为清静，依然要八面玲珑。","book":"唐·卢纶《赋得彭祖楼送杨宗德归徐州幕》诗：“四户八窗明，玲珑逼上清。”宋·夏元鼎《满庭芳》词"},"example":{"text":"原来宝廷的为人，是～，却十分落拓。","book":"清·曾朴《孽海花》第七回"},"similar":["八面见光","见风使舵"],"opposite":["刚直不阿","心口如一"],"usage":"作谓语、定语；用于能讨好各种人物"},{"id":7254,"word":"八面莹澈","pinyin":"bā miàn yíng chè","abbr":"bmyc","explanation":"比喻精明练达，洞察一切。","source":{"text":"年三十馀即任封疆，遇事镜烛犀刻，八面莹澈。","book":"清·昭槤《啸亭杂录·尹文端公》"},"example":{"text":"他是一个～的人物。"},"similar":["八面圆通"],"usage":"作谓语、定语；比喻为人很精明"},{"id":7255,"word":"八面见光","pinyin":"bā miàn jiàn guāng","abbr":"bmjg","explanation":"形容人非常世故，各方面都能应付得很周到。","source":{"text":"南国一分春色，东窗八面光风。","book":"宋·李处全《西江月·二月旦待女兄游高斋》"},"example":{"text":"张姑娘这几句话，说得软中带硬，～，包罗万象。","book":"清·文康《儿女英雄传》第十回"},"similar":["八面玲珑"],"usage":"作谓语、定语；形容人际关系处理得很好"},{"id":7256,"word":"八面驶风","pinyin":"bā miàn shǐ fēng","abbr":"bmsf","explanation":"形容善于见风使舵，各方面都兜得传。","source":{"text":"八面驶风，左右逢源，真乃诸葛亮也。","book":"老舍《神拳》第三幕"},"example":{"text":"他～，生意越做越大。"},"similar":["八面玲珑","见风使舵","左右逢源"],"usage":"作谓语、宾语；指人际关系"},{"id":7257,"word":"八音迭奏","pinyin":"bā yīn dié zòu","abbr":"bydz","explanation":"八音：古代对乐器的统称；迭：交互，轮流。八类乐器轮番演奏。表示器乐齐全，演奏场面盛大。","source":{"text":"八音迭奏，雅乐并作。","book":"《晋书·乐志下》"},"example":{"text":"又有谓大八音匣者，与衣厢等。触其机，～，恍如有十数人弹唱焉。","book":"清·淮阴百一居士《壶天录》卷中"},"usage":"作宾语、定语；形容器乐齐全，演奏场面盛大"},{"id":7258,"word":"八音遏密","pinyin":"bā yīn è mì","abbr":"byem","explanation":"遏：阻止；密：寂静。各种乐器停止演奏，乐声寂静。旧指皇帝死后停乐举哀。后也用以形容国家元首之死。","source":{"text":"三载，四海遏密八音。","book":"《尚书·舜曲》"},"example":{"text":"奉梓南归四载迟，～寄哀思。","book":"柳亚子《中山先生奉安大典志哀》"},"similar":["遏密八音"],"usage":"作主语、谓语；指国家元首去世"},{"id":7259,"word":"公不离婆","pinyin":"gōng bù lí pó","abbr":"gblp","explanation":"老公不离开老婆。形容关系密切。","source":{"text":"《合纵记》剧：自古道：‘公不离婆，秤不离砣。’《梦笔生花弦索乐府》：‘水不离波，秤不离砣。’","book":"孙锦标《通俗常言疏证·什物》"},"similar":["秤不离砣"],"usage":"作宾语、定语；用于口语"},{"id":7260,"word":"公之于众","pinyin":"gōng zhī yú zhòng","abbr":"gzyz","explanation":"公：公开；之：代指事物的内容；于：向；众：大众。把事情真相向大家公布。","example":{"text":"请把公司本月的开销及往来～。"},"similar":["公诸于众","公之于世","公之世人"],"usage":"作谓语；用于事情等"},{"id":7261,"word":"公买公卖","pinyin":"gōng mǎi gōng mài","abbr":"gmgm","explanation":"公家向民间购买物品，公平交易，不使百姓吃亏。","source":{"text":"大人做道员时，驿上草料豆子，公买公卖，分毫不亏累农户。","book":"清·李绿园《歧路灯》第一百七回"},"example":{"text":"他们都不抢掠，～。","book":"姚雪垠《李自成》第一卷第十六章"},"similar":["公平交易"],"usage":"作主语、宾语、定语；指公平交易"},{"id":7262,"word":"公事公办","pinyin":"gōng shì gōng bàn","abbr":"gsgb","explanation":"公事按公事的原则办，不讲私人情面。","source":{"text":"自今公事公言，进而明目张胆以陈之论奏，退而同心协虑以见之施行，毋面从而背违也。","book":"宋·魏了翁《奏外寇未静二相不咸旷天工而违明几》"},"example":{"text":"藩台见人家不来打点，他便有心～，先从余荩臣下手。","book":"清·李宝嘉《官场现形记》第三十三回"},"similar":["秉公持正","官事官办"],"opposite":["假公济私","徇私舞弊"],"usage":"作谓语、宾语；表示秉公办理"},{"id":7263,"word":"公侯勋卫","pinyin":"gōng hóu xún wèi","abbr":"ghxw","explanation":"公爵、侯爵、勋臣、宿卫。泛指名门贵族。","source":{"text":"你看这般富丽，都是公侯勋卫之家。","book":"清·孔尚任《桃花扇·闹榭》"}},{"id":7264,"word":"公侯干城","pinyin":"gōng hóu gān chéng","abbr":"ghgc","explanation":"公、侯：古时爵位；干：盾；城：城池；干城：比喻捍卫。指为公侯抵御外侮的武将。","source":{"text":"赳赳武夫，公侯干城。","book":"《诗经·周南·兔罝》"}},{"id":7265,"word":"公修公德，婆修婆德","pinyin":"gōng xiū gōng dé，pó xiū pó dé","abbr":"gxgdpxpd","explanation":"指修德属个人，不得兼代。","source":{"text":"这烧香可是神佛儿的事情，‘公修公德，婆修婆德’，咱‘各人儿洗面儿各人儿光’，你不要，可行不得。","book":"《儿女英雄传》第十三回"},"usage":"作宾语、定语、分句；用于处事"},{"id":7266,"word":"公公婆婆","pinyin":"gōng gōng pó pó","abbr":"ggpp","explanation":"公公与婆婆，丈夫的父亲和母亲。","source":{"text":"咱们九个心里孝顺，只是不象那小蹄子嘴巧，所以公公婆婆老了，只说他好，这委屈向谁诉去？","book":"清·曹雪芹《红楼梦》第54回"},"usage":"作主语、宾语、定语；用于口语"},{"id":7267,"word":"公公道道","pinyin":"gōng gōng dào dào","abbr":"ggdd","explanation":"不偏不倚的、公平合理的事情。","source":{"text":"咱们今儿可要公公道道的贴一炉子烧饼，要有一个充正经的人。","book":"清·曹雪芹《红楼梦》第65回"},"similar":["不偏不倚","公平合理"],"usage":"作定语、状语；指公正"},{"id":7268,"word":"公冶非罪","pinyin":"gōng yě fēi zuì","abbr":"gyfz","explanation":"形容无辜蒙冤或入狱。","source":{"text":"公冶长非罪也。","book":"春秋·鲁·孔丘《论语·公冶长》"},"usage":"作宾语、定语；指无辜蒙冤","story":["春秋时期，公冶长非常聪明，能懂得鸟语，一次他从卫国返回鲁国，听到鸟儿们在招呼前往清溪吃死人肉，就告诉死者的母亲。村官判公冶长有罪就把他关入大牢。60天后，公冶长听麻雀说有车谷子翻了，村官去验证果真如此，证明他是无罪的"]},{"id":7269,"word":"公听并观","pinyin":"gōng tīng bìng guān","abbr":"gtbg","explanation":"多方面听取意见和观察事物。","source":{"text":"臣窃亮陛下潜神默思，公听并观，若事有未见于理而物未周于用，将改曲易调，远与黄唐角功，近昭文武之迹，岂近习而已哉？","book":"《三国志·魏书·蒋济传》"},"example":{"text":"刑平而公，赏重而信，纳用谏官御史，～，而不蔽于偏至之谗。","book":"宋·王安石《本朝百年无事札子》"},"usage":"作谓语、定语；指公正听取并看待事物"},{"id":7270,"word":"公子哥儿","pinyin":"gōng zǐ gē ér","abbr":"gzge","explanation":"指富贵人家只讲吃喝玩乐，不务正业的子弟。","source":{"text":"见安公子那一番举动，早知他是不通世路艰难，人情利害的一个公子哥儿。","book":"清·文康《儿女英雄传》第五回"},"example":{"text":"你这样的～能干什么大事。"},"similar":["纨绔子弟"],"usage":"作主语、宾语、定语；指男性"},{"id":7271,"word":"公子王孙","pinyin":"gōng zǐ wáng sūn","abbr":"gzws","explanation":"旧时贵族、官僚的子弟。","source":{"text":"不知夫公子王孙左挟弹，右摄丸，将加己乎十仞之上，以其类为招。","book":"《战国策·楚策四》"},"example":{"text":"赤日炎炎似火烧，野田禾稻半枯焦。农夫心内如汤煮，～把扇摇。","book":"明·施耐庵《水浒全传》第十六回"},"similar":["王公贵族","纨绔子弟"],"usage":"作主语、宾语；指王公贵族子弟"},{"id":7272,"word":"公尔忘私","pinyin":"gōng ěr wàng sī","abbr":"gews","explanation":"一心为公而忘却私事。","source":{"text":"[晃错]公尔忘私，而其父又唯知日夜伤晃氏之不安矣。","book":"明·李贽《晃错》"},"example":{"text":"若说是为了国法，所以～，然而姓朱的却又明明为着升官发财，才出首的：所以有点看不起这个人。","book":"《二十年目睹之怪现状》第五四回"},"similar":["公而忘私","公耳忘私"],"opposite":["损公肥私"],"usage":"作谓语、宾语；指一心为公"},{"id":7273,"word":"公平交易","pinyin":"gōng píng jiāo yì","abbr":"gpjy","explanation":"公平合理的买卖。","source":{"text":"公平交易，又不化他，又不抢他，何罪之有！","book":"明·吴承恩《西游记》第68回"},"example":{"text":"我们需要市场的～，才能保证市场繁荣。"},"similar":["公平买卖","童叟无欺"],"opposite":["欺行霸市"],"usage":"作主语、宾语；指公平合理的买卖"},{"id":7274,"word":"公平合理","pinyin":"gōng píng hé lǐ","abbr":"gphl","explanation":"指处理事情公正符合情理。","source":{"text":"只要美国政府愿意在公平合理的基础上解决问题，不再如过去那样用种种可耻的方法破坏和阻挠谈判的进行，则朝鲜的停战谈判是可能成功的。","book":"毛泽东《三大运动的伟大胜利》"},"example":{"text":"站好了队，排好了号，分果实分土地就～。","book":"周立波《暴风骤雨》第二部"},"similar":["公道合理"],"usage":"作定语、状语；指公正符合情理"},{"id":7275,"word":"公平无私","pinyin":"gōng píng wú sī","abbr":"gpws","explanation":"办事公平，没有私心。","source":{"text":"商君治秦，法令至行，公平无私。","book":"西汉·刘向《战国策·秦策》"},"example":{"text":"我们办事尽量做到～。"},"similar":["公正无私"],"opposite":["自私自利"],"usage":"作谓语、定语、宾语；指没有私心"},{"id":7276,"word":"公平正直","pinyin":"gōng píng zhèng zhí","abbr":"gpzz","explanation":"公道平等，不偏袒，不营私。","source":{"text":"也只要全大人体面，方才得公平正直万人传。","book":"元·孙仲章《勘头巾》第四折"},"example":{"text":"玉皇说我在阳世为人～……正要补我做个太子太命。","book":"清·西周生《醒世姻缘传》第四十二回"},"similar":["公平无私"],"usage":"作谓语、定语；指为人处世公道"},{"id":7277,"word":"公忠体国","pinyin":"gōng zhōng tǐ guó","abbr":"gztg","explanation":"指尽忠为国。","source":{"text":"办外交的人有私心是不行的，一定要用公忠体国的有才能的人，来办这项国事。","book":"郭沫若《奴隶制时代·〈侈靡篇〉的研究》"},"example":{"text":"鞠躬尽瘁兮，诸葛武侯诚哉武；～兮，出师两表留楷模。","book":"郭沫若《蜀道奇》诗"},"usage":"作谓语、定语；用于书面语"},{"id":7278,"word":"公才公望","pinyin":"gōng cái gōng wàng","abbr":"gcgw","explanation":"才：才识；望：名望。才识名望可称公辅的地位。","source":{"text":"孔愉有公才而无公望；丁潭有公望而无公才，兼之者其在卿乎？","book":"南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"～当黑头，姓名指顾书金瓯。","book":"清·沈曾植《陈庸庵尚书水流云在图册》诗"},"usage":"作宾语、定语；指相当于三公辅相的才识","story":["南朝时期，梁国的王暕年幼时，父亲在齐国作太尉，太尉相当于三公、宰相等位。一次王家宴客时，来的客人见了王暕就对其父亲说：“公才公望在这孩子身上又看到了。”后来，王暕成年时也作了大官"]},{"id":7279,"word":"公报私仇","pinyin":"gōng bào sī chóu","abbr":"gbsc","explanation":"假借公事报私人的仇恨。","source":{"text":"汪知县公报私仇，借家人卢才的假人命，装在我名下，要加小的死罪。","book":"明·冯梦龙《醒世恒言》卷二十九"},"example":{"text":"昏君乱相，为别人～。","book":"清·孔尚任《桃花扇·逮社》"},"similar":["挟私报复","官报私仇"],"opposite":["克己奉公","奉公守法"],"usage":"作谓语、定语；指报复"},{"id":7280,"word":"公报私雠","pinyin":"gōng bào sī chóu","abbr":"gbsc","explanation":"假借公事报私人的仇恨。同“公报私仇”。"},{"id":7281,"word":"公明正大","pinyin":"gōng míng zhèng dà","abbr":"gmzd","explanation":"公正无私，光明磊落。","source":{"text":"若一本于公明正大之心，则岂直如此而已。","book":"清·陈确《翠薄山房帖》"},"example":{"text":"以其磊磊落落之志，出之以～之行为，则其与立宪党之地位，为相对的，而非绝对的。","book":"与之《论中国现在之党派及将来之政党》"},"similar":["光明正大"],"usage":"作谓语、定语；用于处事"},{"id":7282,"word":"公是公非","pinyin":"gōng shì gōng fēi","abbr":"gsgf","explanation":"公认的是非。","source":{"text":"人能胜乎天者，法也。法大行，则是为公是，非为公非，天下之人蹈道必赏，违之必罚。","book":"唐·刘禹锡《天论上》"},"example":{"text":"～订弟兄，徐行疾行携子侄。","book":"清·赵翼《戏为叠字体》"},"usage":"作主语、宾语、定语；指是非"},{"id":7283,"word":"公有公理，婆有婆理","pinyin":"gōng yǒu gōng lǐ，pó yǒu pó lǐ","abbr":"gyglpypl","explanation":"公：称丈夫的父亲。比喻双方争执，各说自己有理。","source":{"text":"议论纷纷，莫衷一是，然又引经据典，公有公理，婆有婆理。","book":"鲁彦《西安印象》"},"similar":["公说公有理，婆说婆有理"],"usage":"作宾语、定语、分句；指双方争执不下"},{"id":7284,"word":"公正不阿","pinyin":"gōng zhèng bù ē","abbr":"gzbe","explanation":"公平正直而不曲意迎合。","source":{"text":"相之本主元祐政事者，然其言公正不阿如此，可谓贤矣。","book":"宋·陆游《老学庵笔记》第九卷"},"example":{"text":"他～的性格值得我们学习。"},"similar":["刚正不阿"],"opposite":["卑躬屈膝"],"usage":"作谓语、定语；指人为人处世"},{"id":7285,"word":"公正严明","pinyin":"gōng zhèng yán míng","abbr":"gzym","explanation":"公平正直，廉洁严明。","source":{"text":"二则象大帅这样公正廉明，做属员的人，只要自己谨慎小心……还愁将来不得差缺吗？","book":"清·李宝嘉《官场现形记》第三十七回"},"example":{"text":"这样～，执法如山，人民怎不信服。","book":"冯玉祥《我的生活》第三十四章"}},{"id":7286,"word":"公正廉明","pinyin":"gōng zhèng lián míng","abbr":"gzlm","explanation":"公平正直，廉洁严明。","source":{"text":"二则象大帅这样公正廉明，做属员的人，只要自己谨慎小心……还愁将来不得差缺吗？","book":"清·李宝嘉《官场现形记》第37回"},"example":{"text":"这样～的官员真是难得。"},"similar":["清正廉明"],"usage":"作谓语、定语；用于统治者"},{"id":7287,"word":"公正廉洁","pinyin":"gōng zhèng lián jié","abbr":"gzlj","explanation":"指廉洁奉公，不循私情。","source":{"text":"劾其贪酷诸款，而后又言其公正廉洁、惜名器、重士节诸语。","book":"清·昭槤《啸亭杂录·金元史》"},"example":{"text":"他一辈子都要求自己～地做官。"},"similar":["清正廉洁"],"usage":"作宾语、定语；用于官员等"},{"id":7288,"word":"公正无私","pinyin":"gōng zhèng wú sī","abbr":"gzws","explanation":"办事公正，没有私心。","source":{"text":"公正无私，反见从横。","book":"战国·赵·荀况《荀子·赋》"},"example":{"text":"在周秦之际的思想倒已经有很周密的一套想法，便是～，不避亲怨，综核名实，信赏必罚。","book":"郭沫若《论曹植》"},"similar":["大公无私","公而忘私","公事公办"],"opposite":["假公济私","贪赃枉法"],"usage":"作宾语、定语、状语；用于为人处世"},{"id":7289,"word":"公生明，偏生暗","pinyin":"gōng shēng míng，piān shēng àn","abbr":"gsmpsa","explanation":"公：公平；明·明亮；偏：不公正；暗：昏暗，不明事理。公正就耳聪目明，偏私就昏暗愚昧。","source":{"text":"公生明，偏生暗，端悫生通，诈伪生塞，诚信生神，夸诞生惑。此六生者，君子慎之，而禹桀所以分也。","book":"《荀子·不苟》"}},{"id":7290,"word":"公私两便","pinyin":"gōng sī liǎng biàn","abbr":"gslb","explanation":"便：便利，方便。对公家和私人都便利。","source":{"text":"若人有所患苦者，有宜损益，使公私两济者，委曲陈之。","book":"《汉书·沟洫志》：“衣食县官，而为之作，乃两便。”颜师古注：“令县官给其衣食，而使修治河水，是为公私两便。”《晋书·阮种传》"},"example":{"text":"议者以为不议其身，止令输赋，则～，可以久行。","book":"宋·刘安世《论役法之弊》"},"similar":["公私兼顾","公私两利"],"opposite":["损公肥私"],"usage":"作谓语、宾语；指对公家私人都便利"},{"id":7291,"word":"公私两利","pinyin":"gōng sī liǎng lì","abbr":"gsll","explanation":"指对公家私人都有好处。同“公私两济”。","source":{"text":"惟有于耍闹坊场之地，听民酝造，纳税之后，从便酤卖，实为公私两利。","book":"《文献通考·征榷四》"},"example":{"text":"全国工商业者必须在～政策之下，自觉地严格遵守各级人民政府的法令，爱护国家财产，消灭旧社会假公济私、损人利己的恶劣作风。","book":"《新华月报》1951年第5期"},"similar":["公私两便","公私两济"],"usage":"作谓语、宾语；指对公家私人都便利"},{"id":7292,"word":"公私两济","pinyin":"gōng sī liǎng jì","abbr":"gslj","explanation":"指对公家私人都有好处。","source":{"text":"若人有所患苦者，有宜损益，使公私两济者，委曲陈之。","book":"《晋书·阮种传》"},"similar":["公私兼顾"],"opposite":["假公济私"],"usage":"作宾语；指对公家私人都有好处"},{"id":7293,"word":"公私交困","pinyin":"gōng sī jiāo kùn","abbr":"gsjk","explanation":"公家私人均陷困境。","source":{"text":"虚糜干没，公私交困焉。","book":"《明史·食货志六》"},"example":{"text":"因为按照我们现在落后农村的生产力，及经常遭受战争摧毁的环境，若果脱离生产的人太多了，便会养不活，便会～。","book":"《解放日报》1942.9.4"},"usage":"作谓语、定语；用于处境等"},{"id":7294,"word":"公私兼济","pinyin":"gōng sī jiān jì","abbr":"gsjj","explanation":"既照顾到公家的利益，也照顾到私人的利益。","source":{"text":"况今征税有常，公私兼济。","book":"唐·白居易《白氏长庆集·判》"}},{"id":7295,"word":"公私兼顾","pinyin":"gōng sī jiān gù","abbr":"gsjg","explanation":"既照顾到公家的利益，也照顾到私人的利益。","source":{"text":"况今征税有常，公私兼济。","book":"唐·白居易《白氏长庆集·判》"},"example":{"text":"实行～、劳资两利、城乡互助，内外交流的政策。","book":"周恩来《人民政协共同纲领草案的特点》"},"similar":["公私两便"],"opposite":["公而忘私"],"usage":"作补语、宾语；指照顾到公家与个人的利益"},{"id":7296,"word":"公私分明","pinyin":"gōng sī fēn míng","abbr":"gsfm","explanation":"公家的与私人的界限十分清楚。","source":{"text":"要敢说真话，反对说假话，不务虚名，多做实事；要公私分明，不拿原则换人情。","book":"邓小平《在中国共产党全国代表会议上的讲话》"},"example":{"text":"真正做到～是不容易的。"},"opposite":["假公济私"],"usage":"作谓语、宾语；用于处事"},{"id":7297,"word":"公私猬集","pinyin":"gōng sī wèi jí","abbr":"gswj","explanation":"猬集：象刺猬的硬刺那样聚在一起，比喻事情繁多。公事和私事繁多。","source":{"text":"华榱猬集而纵横。","book":"明·俞安期《衡岳赋》"}},{"id":7298,"word":"公而忘私","pinyin":"gōng ér wàng sī","abbr":"gews","explanation":"为了公事而不考虑私事，为了集体利益而不考虑个人得失。","source":{"text":"像他这样不折不扣的国而忘家，公而忘私的人，泱泱的中国中，究竟能有几个？","book":"郭沫若《水平线下·到宜兴去》"},"example":{"text":"这两位同学的破釜沉舟，～的勇气，是使我私心佩服的，","book":"郭沫若《革命春秋·创造十年续篇》"},"similar":["大公无私"],"opposite":["私而忘公","损公肥私"],"usage":"作谓语、宾语、定语；指一心为公"},{"id":7299,"word":"公而忘私，国而忘家","pinyin":"gōng ér wàng sī，guó ér wàng jiā","abbr":"gewsgewj","explanation":"为了公事而忘记私事，为了国事而忘记家事。形容一心为公为国。","source":{"text":"但自古道：‘公而忘私，国而忘家。’","book":"清·吴敬梓《儒林外史》第六回"},"example":{"text":"这是～的典型之一。","book":"徐特立《我的一家》序"},"similar":["国而忘家，公而忘私"],"usage":"作谓语、定语；可分开使用"},{"id":7300,"word":"公耳忘私","pinyin":"gōng ěr wàng sī","abbr":"gews","explanation":"一心为公而忘却私事。同“公尔忘私”。","source":{"text":"化成俗定，则为人臣者，主耳忘身，国耳忘家，公耳忘私。利不苟就，害不苟去，唯义所在，上之化也。","book":"汉·贾谊《治安策》"},"similar":["公尔忘私","公而忘私"],"usage":"作谓语、宾语、定语；指一心为公"},{"id":7301,"word":"公耳忘私，国耳忘家","pinyin":"gōng ěr wàng sī，guó ěr wàng jiā","abbr":"gewsgewj","explanation":"为了公事而忘记私事，为了国事而忘记家事。形容一心为公为国。","source":{"text":"则为人臣者主耳忘身，国耳忘家，公耳忘私，利不苟就，害不苟去，唯义所生。","book":"东汉·班固《汉书·贾谊传》"},"similar":["国耳忘家，公耳忘私"],"usage":"作谓语、定语；可分开使用"},{"id":7302,"word":"公行无忌","pinyin":"gōng xíng wú jì","abbr":"gxwj","explanation":"公：公开；行：做；忌：顾忌。公开做坏事，没有顾忌。","source":{"text":"宋人尝谓世有恶少无赖之人，肆凶不逞，小则赌博，大则屠牛马、销铜钱，公行无忌。","book":"明·田艺蘅《留青日札摘抄》卷一"}},{"id":7303,"word":"公规密谏","pinyin":"gōng guī mì jiàn","abbr":"ggmj","explanation":"指多方劝谏。公，公开；密，私下。","source":{"text":"时太子未定，而临菑侯植有宠，阶数陈文帝德优齿长，宜为储副，公规密谏，前后恳至。","book":"《三国志·魏志·桓阶传》"},"usage":"作宾语、定语；用于交往"},{"id":7304,"word":"公说公有理，婆说婆有理","pinyin":"gōng shuō gōng yǒu lǐ，pó shuō pó yǒu lǐ","abbr":"gsgylpspyl","explanation":"公公说的有公公的道理，婆婆说的有婆婆的道理。比喻双方争执，各说自己有理。","source":{"text":"‘公说公有理，婆说婆有理’，这场纠纷，实在难得排解。","book":"艾思奇《大众哲学》"},"example":{"text":"～，我们不能分清他们的是非。"},"similar":["公公有理，婆婆有理","各执己见"],"usage":"作宾语、定语、分句；指双方争执不下"},{"id":7305,"word":"公诸于世","pinyin":"gōng zhū yú shì","abbr":"gzys","explanation":"公：公开；诸：“之于”的合音；世：世上。把事情的内容向世人公开。","source":{"text":"把许多革命青年、爱国志士的遭遇，公诸于世。","book":"《上饶集中营·茅家岭地狱》"},"example":{"text":"我们必须把这段历史～。"},"similar":["公诸于众"],"usage":"作谓语；指向社会上公开"},{"id":7306,"word":"公诸同好","pinyin":"gōng zhū tóng hào","abbr":"gzth","explanation":"公：公开；诸：之于；同好：爱好相同的人。指把自己所收藏的珍爱的东西拿出来，使有相同爱好的人都能欣赏。","source":{"text":"虽未能藏之于名山，将以传之于同好。","book":"三国·魏·曹植《与杨德祖书》"},"example":{"text":"虽经同人研究再三，余心犹耿耿，未敢～。","book":"清·胡凤丹《〈龙川文集〉辨伪考异跋》"},"similar":["公诸世人"],"opposite":["秘而不宣","藏之名山"],"usage":"作谓语；指把自己喜爱的东西向有同爱好的人"},{"id":7307,"word":"公车上书","pinyin":"gōng chē shàng shū","abbr":"gcss","explanation":"公车：汉代官署名，后也代指举人进京应试。原指入京请愿或上书言事，也特指入京会试的人上书言事。","source":{"text":"天子思敞攻效，使使者即家所在召敞。敞……即装随使者诣公车上书。","book":"《史记·东方朔传》：“朔初入长安，至公车上书，凡用三千奏牍。”《汉书·张敞传》"},"example":{"text":"制台原是不得已之举，台民不甘臣日，～反抗，列名的千数百人。","book":"清·曾朴《孽海花》第三十二回"},"usage":"作宾语、定语；用于政事"},{"id":7308,"word":"公道合理","pinyin":"gōng dào hé lǐ","abbr":"gdhl","explanation":"指处理事情公正符合情理。同“公平合理”。","source":{"text":"工要评的公道合理，确实是件不容易的事。","book":"西戎《纠纷》"},"similar":["公平合理"],"usage":"作定语、状语；指公正符合情理"},{"id":7309,"word":"公道大明","pinyin":"gōng dào dà míng","abbr":"gddm","explanation":"公道：公正的原则道理，即正义。公正的道理得到发扬。比喻正义得到伸张。","source":{"text":"郡中缙绅、耆老、邻里，公书公呈，一齐并进，公道大明。","book":"明·天然智叟《石头点·侯官县烈女歼仇》"},"usage":"作谓语、定语、状语；用于做事"},{"id":7310,"word":"公道总在人心","pinyin":"gōng dào zǒng zài rén xīn","abbr":"gdzzrx","explanation":"公道：公正的道理。公正的道理自然存在于众人心里。","source":{"text":"人家听了，也只有再三劝慰；说什么公道总在人心。","book":"蔡东藩《民国通俗演义》第120回"},"similar":["公道自在人心"],"usage":"作宾语、定语；用于口语"},{"id":7311,"word":"公道自在人心","pinyin":"gōng dào zì zài rén xīn","abbr":"gdzzrx","explanation":"公道：公正的道理；自：当然，自然。公正的道理自然存在于众人的心里。指群众对事情的是非曲直知道的清楚明白。","source":{"text":"王大将军下，庾公问：‘闻卿有四友……何者居其右？’王曰：‘自有人。’又问：‘何者是？’王曰：‘噫，其自有公论。’","book":"南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"骑在马上，自言自语道：“～，也不枉我一番必力了。”","book":"清·燕谷老人《续孽海花》第六十回"},"similar":["公道总在人心"],"usage":"作宾语、定语；用于口语"},{"id":7312,"word":"公道难明","pinyin":"gōng dào nán míng","abbr":"gdnm","explanation":"公道：公正的原则道理，即正义。公正的道理难以得到伸张。","source":{"text":"独自得之，心蓄之，衔忍而不出诸口，以公道之难明而世之多嫌也。","book":"唐·柳宗元《贺进士王参元失火书》"}},{"id":7313,"word":"公门有公","pinyin":"gōng mén yǒu gōng","abbr":"gmyg","explanation":"公：公侯。旧时指公侯之家出公侯。","source":{"text":"百辟君子，奕世相生，公门有公，卿门有卿。","book":"《晋书·王沉传》"}},{"id":7314,"word":"公门桃李","pinyin":"gōng mén táo lǐ","abbr":"gmtl","explanation":"公：对人的尊称。尊称某人引进的后辈、栽培的学生。","source":{"text":"或谓仁杰曰：‘天下桃李，悉在公门矣。’","book":"《资治通鉴·唐纪则天顺圣皇后久视元年》"},"usage":"作宾语、定语；用于说话等"},{"id":7315,"word":"六亲不和","pinyin":"liù qīn bù hé","abbr":"lqbh","explanation":"指和亲族、亲戚之间的关系不好。","source":{"text":"六亲不和，有孝慈；国家昏乱，有忠臣。","book":"《老子》第十八章"},"example":{"text":"那王仁自从王子腾死后，王子胜又是无能的人，任他胡为，已闹的～。","book":"清·曹雪芹《红楼梦》第一百十四回"}},{"id":7316,"word":"六亲不认","pinyin":"liù qīn bù rèn","abbr":"lqbr","explanation":"形容不重天伦，不通人情，对亲属都不顾。有时也指对谁都不讲情面。","source":{"text":"那名堂一立，就六亲不认了。","book":"张天翼《万仞约》"},"example":{"text":"我罢了差事，他不唯不帮忙，反倒～了。","book":"冯德英《苦菜花》第二章"},"similar":["寡情绝义","铁面无私"],"opposite":["与人为善","普渡众生"],"usage":"作谓语、定语；指按章办事"},{"id":7317,"word":"六亲同运","pinyin":"liù qīn tóng yùn","abbr":"lqty","explanation":"亲族、亲戚都有共同的命运。指亲族和亲戚们的遭遇相同。","source":{"text":"真真是六亲同运！薛家是这样了，姨太太守著薛蝌过日。","book":"清·曹雪芹《红楼梦》第一百八回"},"example":{"text":"不意府上也因接驾合家离散，真可谓～，能不令人伤感！","book":"清·李汝珍《镜花缘》第五十六回"}},{"id":7318,"word":"六亲无靠","pinyin":"liù qīn wú kào","abbr":"lqwk","explanation":"六亲：父、母、兄、弟、妻、子。形容很孤独，没有亲属可依靠。","source":{"text":"我家现在六亲无靠，故乡举目无亲，除叔叔外，别无可托之人。","book":"清·李汝珍《镜花缘》第21回"},"example":{"text":"他是一个～的孤儿。"},"similar":["无依无靠"],"usage":"作谓语、定语；指形容乐声美妙"},{"id":7319,"word":"六出冰花","pinyin":"liù chū bīng huā","abbr":"lcbh","explanation":"出：花分瓣；六出：六个花瓣。指雪花。","source":{"text":"彤云垂四百之叶，玉雪开六出之花。","book":"南朝·梁·萧统《黄钟十一月启》"},"example":{"text":"若果有一腔怨气喷如火，定要感得～滚似锦，免着我尸骸现；要什么素车白马，断送出古陌荒阡？","book":"元·关汉卿《窦娥冤》第三折"},"usage":"作主语、宾语、定语；用于书面语"},{"id":7320,"word":"六出奇计","pinyin":"liù chū qí jì","abbr":"lcqj","explanation":"原指陈平所出的六条妙计。后泛指出奇制胜的谋略。","source":{"text":"凡六出奇计，辄益邑，凡六益封。","book":"西汉·司马迁《史记·陈丞相世家》"},"example":{"text":"我与你仗苏张六舌，～，好歹设法来院中走走。","book":"明·凌濛初《初刻拍案惊奇》第六卷"},"usage":"作宾语、定语；泛指出奇制胜的谋略","story":["西汉丞相陈平一生给汉高祖刘邦出了六条出奇制胜的谋略，被刘邦采纳统一江山。这六条计谋即：捐金行反间计，离间项羽君臣；以恶草近楚使；夜出子女二千人，解荥阳之围；蹑足请韩信稳定军心；请刘邦伪游云梦擒韩信；解白登之围"]},{"id":7321,"word":"六出纷飞","pinyin":"liù chū fēn fēi","abbr":"lcff","explanation":"六出：雪花六角，因别称“六出”。大雪纷纷。","source":{"text":"凡草木花多五出，雪花独六出。","book":"汉·韩婴《韩诗外传》"},"example":{"text":"尝值元旦日大雪，李昪～，树顶枝头，浑如积玉，阶前砌畔，宛似堆银，身处其间，不啻琼宫见阙。","book":"许慕义《宋代宫闱史》第三十回"},"usage":"作谓语、定语；用于书面语"},{"id":7322,"word":"六合之内","pinyin":"liù hé zhī nèi","abbr":"lhzn","explanation":"六合：天地及东南西北。指天下。","source":{"text":"六合之外，圣人存而不论；六合之内，圣人论而不存。","book":"《庄子·齐物论》"},"example":{"text":"不能扫除寇难，靖匡王室，久使陛下圣教陵迟，～，否而未泰。","book":"明·罗贯中《三国演义》第七十三回"},"usage":"作宾语；指天下"},{"id":7323,"word":"六合之外，存而不论","pinyin":"liù hé zhī wài，cún ér bù lùn","abbr":"lhzwcebl","explanation":"六合：指上下和东西南北，泛指天下；存：保留；论：讨论。指把问题保留下来，暂不讨论。","source":{"text":"六合之外，圣人存而不论。","book":"《庄子·齐物论》"}},{"id":7324,"word":"六合同风","pinyin":"liù hé tóng fēng","abbr":"lhtf","explanation":"六合：指上下和东西南北，泛指天下。古指天下各处的风俗教化完全一样。","source":{"text":"春秋所以大一统者，六合同风，九州共贯也。","book":"《汉书·王吉传》"},"example":{"text":"高祖阐鸿基，景文弘帝业，嗣武受终，要荒率服，～，宇宙齐贯。","book":"《晋书·凉武昭王传》"}},{"id":7325,"word":"六合时邕","pinyin":"liù hé shí yōng","abbr":"lhsy","explanation":"六合：指上下和东西南北，泛指天下；邕：和睦。指天下和睦。","source":{"text":"六合时邕，巍巍荡荡。","book":"晋·张协《七命》"}},{"id":7326,"word":"六宫粉黛","pinyin":"liù gōng fěn dài","abbr":"lgfd","explanation":"六宫：古代皇帝有六个寝宫；粉黛：化妆品，借指美女。指宫内皇后、妃嫔及宫女。","source":{"text":"回眸一笑百媚生，六宫粉黛无颜色。","book":"唐·白居易《长恨歌》"},"example":{"text":"她要进宫，那可真是三千佳丽成粪土、～无颜色了，我就想再见皇上一面儿也难！","book":"二月河《乾隆皇帝》第八章"}},{"id":7327,"word":"六尘不染","pinyin":"liù chén bù rǎn","abbr":"lcbr","explanation":"佛教语，六尘：指色、声、香、味、触、法。指排除物欲，保持心地洁净。","source":{"text":"六尘不染，孤标水上之花。","book":"唐·武三思《孝明皇后碑》"},"example":{"text":"五蕴皆空，～，是谓‘和尚’。","book":"清·蒲松龄《聊斋志异·金和尚》"},"similar":["一尘不染"],"usage":"作谓语、定语；用于人和环境"},{"id":7328,"word":"六尺之孤","pinyin":"liù chǐ zhī gū","abbr":"lczg","explanation":"六尺：古代尺短，“六尺”形容个子未长高；孤：死去父亲的小孩。指没有成年的孤儿。","source":{"text":"可以托六尺之孤，可以寄百里之命，临大节而不可夺也。","book":"《论语·泰伯》"},"example":{"text":"一抔之土未干，～何托？","book":"唐·骆宾王《代李敬业传檄天下文》"},"similar":["六尺之托"],"usage":"作宾语；指没有成年的孤儿"},{"id":7329,"word":"六尺之托","pinyin":"liù chǐ zhī tuō","abbr":"lczt","explanation":"指受嘱托抚育遗孤。","source":{"text":"并可以受六尺之托，临大节而不挠。","book":"《后汉书·明帝纪》"},"usage":"作宾语；指受托"},{"id":7330,"word":"六尺之讬","pinyin":"liù chǐ zhī quàn","abbr":"lczt","explanation":"指受嘱托抚育遗孤。"},{"id":7331,"word":"六月飞霜","pinyin":"liù yuè fēi shuāng","abbr":"lyfs","explanation":"旧时比喻有冤狱。","source":{"text":"匹夫结愤，六月飞霜。","book":"唐·张说《狱箴》"},"example":{"text":"琴言忽然放声大哭，这一哭真有三年不雨之冤，～之惨。","book":"清·陈森《品花宝鉴》第四十四回"},"similar":["飞霜六月"],"usage":"作宾语、定语；比喻有冤狱、冤情","story":["战国时期，燕昭王姬平请齐国的邹衍等贤人来帮助治理国家，燕国的部分人对邹衍不满，在燕王面前进谗言，让邹衍蒙冤入狱，当时正值盛夏六月，天降大风雪。燕王意识到邹衍的冤屈，就释放了他"]},{"id":7332,"word":"六朝脂粉","pinyin":"liù cháo zhī fěn","abbr":"lczf","explanation":"六朝：建都于建康（南京）的三国吴、东晋、宋、齐、梁、陈六个朝代；脂粉：胭脂。形容繁华绮丽。形容六朝时金陵靡丽繁华景象。","source":{"text":"他他他把六朝金粉收拾去，单单单留下写恨几行书。","book":"元·无名氏《醉花阴·秋怀》"},"example":{"text":"且乐平生，尘寰事，几变更，～飞灰冷。","book":"明·胡文焕《群音类选·靺鞨记·赏月遇恶》"},"similar":["六朝金粉"],"usage":"作宾语、定语；形容六朝时金陵繁华景象"},{"id":7333,"word":"六朝金粉","pinyin":"liù cháo jīn fěn","abbr":"lcjf","explanation":"六朝：南朝吴、东晋、宋、齐、梁、陈六个朝代；金粉：旧时妇女妆饰用的铅粉，常用以形容繁华绮丽。亦形容六朝的靡丽繁华景象。","source":{"text":"他他他把六朝金粉收拾去，单单单留下写恨几行书。","book":"元·无名氏《醉花阴·秋怀》"},"example":{"text":"香消了～，清减了三楚精神。","book":"元·王实甫《西厢记》第二本第一折"},"similar":["六朝脂粉"],"usage":"作宾语、定语；形容六朝时金陵繁华景象"},{"id":7334,"word":"六根不净","pinyin":"liù gēn bù jìng","abbr":"lgbj","explanation":"六根：佛家语，指眼、耳、鼻、舌、身、意。比喻心绪不宁，处事偏私","source":{"text":"后来数世，都因六根不净，功败垂成。","book":"清·无垢道人《八仙全传》第16回"},"opposite":["六根清净"],"usage":"作谓语、定语；用于处事"},{"id":7335,"word":"六根清净","pinyin":"liù gēn qīng jìng","abbr":"lgqj","explanation":"六根：佛家语，指眼、耳、鼻、舌、身、意。佛家以达到远离烦恼的境界为六根清静。比喻已没有任何欲念。","source":{"text":"五种法师，俱得六根清净。","book":"隋·隋炀帝《宝台经藏愿文》"},"example":{"text":"寸草不留，～，与汝剃除，免得争竞。","book":"明·施耐庵《水浒传》第四回"},"similar":["六根清静"],"opposite":["六根不净"],"usage":"作谓语、定语；比喻已没有任何欲念"},{"id":7336,"word":"六根清静","pinyin":"liù gēn qīng jìng","abbr":"lgqj","explanation":"六根：佛家语，指眼、耳、鼻、舌、身、意。佛家以达到远离烦恼的境界为六根清静。比喻已没有任何欲念。","source":{"text":"以是功德，庄严六根，皆令清静。","book":"《法华经·法师功德品》"},"example":{"text":"寸草不留，～，与汝剃了，免得争竞。","book":"明·施耐庵《水浒全传》第四回"},"similar":["六根清净"],"usage":"作谓语、定语；比喻已没有任何欲念"},{"id":7337,"word":"六畜不安","pinyin":"liù chù bù ān","abbr":"lcba","explanation":"六畜：牛、马、羊、猪、鸡、狗。牲畜也不得安宁。形容骚扰得很厉害。","source":{"text":"人家结发夫妻过的太太平平和和气气的日子，要我去扰得人家六畜不安，末后连我也把个小命儿送掉了，图着什么呢？","book":"清·刘鹗《老残游记》第四回"},"example":{"text":"她在大人面前还是这样。那在家里是简直闹得～。","book":"鲁迅《彷徨·离婚》"},"similar":["鸡犬不宁","六神无主","鸡飞狗走"],"opposite":["相安无事","天下太平","国泰民安"],"usage":"作谓语、补语；指战乱等"},{"id":7338,"word":"六畜兴旺","pinyin":"liù chù xīng wàng","abbr":"lcxw","explanation":"六畜：牛、马、羊、猪、鸡、狗。指各种牲畜、家禽繁衍兴旺。","source":{"text":"藏于不竭之府者，养桑麻育六畜也。","book":"《管子·牧民》"},"example":{"text":"～猪为首，五谷丰登粮领先。","book":"民间谚语"},"similar":["五谷丰登"],"usage":"作谓语、分句；指社会繁荣"},{"id":7339,"word":"六神不安","pinyin":"liù shén bǔ ān","abbr":"lsba","explanation":"六神：道家认为人的心、肺、肝、肾、脾、胆各有神灵主宰，称为六神。形容惊慌着急，没了主意，不知如何才好。","source":{"text":"凡人卧，头边勿安放火炉，令人六神不安。","book":"宋·张君房《云笈七签》卷三十二"},"example":{"text":"今有蔡顺的母亲，病枕在床，俺家宅～。","book":"元·刘唐卿《降桑椹》第二折。"},"similar":["六神无主"],"opposite":["从容不迫"],"usage":"作谓语、状语；指不知如何才好"},{"id":7340,"word":"六神无主","pinyin":"liù shén wú zhǔ","abbr":"lswz","explanation":"六神：道家认为人的心、肺、肝、肾、脾、胆各有神灵主宰，称为六神。形容惊慌着急，没了主意，不知如何才好。","source":{"text":"吓得知县已是六神无主，不有甚心肠去吃酒。","book":"汉·张衡《髑髅赋》：“五内皆还，六神皆复。” 明·冯梦龙《醒世恒言》卷二十九"},"example":{"text":"那里我这个人～，失张失智的。","book":"朱自清《笑的历史·笑的历史》"},"similar":["惊慌失措","六神不安","心神不定"],"opposite":["泰然处之","若无其事","从容不迫"],"usage":"作谓语、定语、状语；指不知如何才好"},{"id":7341,"word":"六经三史","pinyin":"liù jīng sān shǐ","abbr":"ljss","explanation":"六经：《易》、《书》、《诗》、《礼》、《乐》、《春秋》；三史：《史记》、《汉书》、《后汉书》。泛指古代典籍。","source":{"text":"夫六经三史，诸子百家，非无可观，皆足为治。","book":"宋·苏轼《乞校正陆贽奏议进御札子》"}},{"id":7342,"word":"六经注我","pinyin":"liù jīng zhù wǒ","abbr":"ljzw","explanation":"注：解释；我：自己的观点。牵强地用各种经典著作中的论断来解释和证明自己的观点，为自己的议论服务。","source":{"text":"或问先生：何不著书？对曰：六经注我！我注六经！","book":"宋·陆九渊《语录》"}},{"id":7343,"word":"六耳不同谋","pinyin":"liù ěr bù tóng móu","abbr":"lebtm","explanation":"原意是三个人知道就不能保守秘密。后也比喻轻信传闻的话没有益处。","source":{"text":"六耳不同谋。且去，来日来。","book":"宋·释普济《五灯会元》"},"usage":"作宾语、定语；用于处事"},{"id":7344,"word":"六脉调和","pinyin":"liù mài tiáo hé","abbr":"lmth","explanation":"六脉：凡人左右手各有寸、关、尺三脉，合称六脉。指人身体健康，精神愉快。","source":{"text":"刘理台至此，方才六脉调和。","book":"清·蘧园《负曝闲谈》第二十九回"},"example":{"text":"我看他～，不象有病的，便说你六脉里面，都没有病象，何以说有病呢。","book":"清·吴趼人《二十年目睹之怪现状》第九十六回"}},{"id":7345,"word":"六臂三头","pinyin":"liù bì sān tóu","abbr":"lbst","explanation":"比喻人的本事非凡，神通广大。","source":{"text":"便六臂三头待怎么，料应飞不出这天罗嘑。","book":"明·孟称舜《死里逃生》第一折"},"example":{"text":"～，后先辉映，无怪乎这小木头人，有时候也就真的‘不可一世’了。","book":"郭沫若《洪波曲》第六章"},"similar":["三头六臂","神通广大"],"usage":"作谓语、宾语、定语；比喻人本事大"},{"id":7346,"word":"六艺经传","pinyin":"liù yì jīng zhuàn","abbr":"lyjz","explanation":"六艺：《诗》、《书》、《礼》、《乐》、《易》、《春秋》；传：解释经书的书。泛指古代典籍。","source":{"text":"夫儒者六艺为法，六艺经传以千万数，累世不能通其学，当年不能究其礼。","book":"西汉·司马迁《史记·太史公自序》"},"example":{"text":"～皆通习之。","book":"唐·韩愈《师说》"},"similar":["四书五经"],"usage":"作主语、宾语、定语；用于书面语"},{"id":7347,"word":"六街三市","pinyin":"liù jiē sān shì","abbr":"ljss","explanation":"六街：唐代长安城中的六条大街；市：古代称早晨、中午、傍晚为三时之市。泛指大街小巷。","source":{"text":"《资治通鉴·唐纪睿宗景云元年》：“中书舍人韦元徼巡六街。”《周礼·地官·司市》"},"example":{"text":"果然那厢有座城池，～，万户千门，来来往往，人都在光天化日之下。","book":"明·吴承恩《西游记》第三回"},"similar":["大街小巷","六街三陌"],"usage":"作宾语；指大街小巷"},{"id":7348,"word":"六街三陌","pinyin":"liù jiē sān mò","abbr":"ljsm","explanation":"泛指大街小巷。同“六街三市”。","source":{"text":"恰便似玉琢成六街三陌，恰便似粉妆就殿阁楼台。","book":"元·郑廷玉《看钱奴》第二折"},"similar":["六街三市","大街小巷"],"usage":"作宾语、定语；指大街小巷"},{"id":7349,"word":"六趣轮回","pinyin":"liù qù lún huí","abbr":"lqlh","explanation":"佛教语。指众生轮回的六大去处，即在这六道中轮回生死。同“六道轮回”。","source":{"text":"圣人有以见六趣轮回，是无明网，故决之以定力。","book":"唐·张说《唐陈州龙兴寺碑》"},"similar":["六道轮回"],"usage":"作宾语、定语；迷信说法"},{"id":7350,"word":"六通四辟","pinyin":"liù tōng sì pì","abbr":"ltsp","explanation":"指上下四方和春秋四时。","source":{"text":"明于天，通于圣，六通四辟于帝王之德者，其自为也，昧然无不静者矣。","book":"《庄子·天道》"},"example":{"text":"大小精粗，～，无乎不在。","book":"康有为《〈孔子改制考〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":7351,"word":"六通四达","pinyin":"liù tōng sì dá","abbr":"ltsd","explanation":"犹四通八达。形容交通极便利。也形容通向各方。","source":{"text":"即如美邦新造，四十年前尚无铁路，今通计国中六通四达为路至二十一万里。","book":"清·薛福成《开创中国铁路议》"},"example":{"text":"清·薛福成《开创中国铁路议》：“即如美邦新造，四十年前尚无铁路，今通计国中～为路至二十一万里。”"},"similar":["四通八达"],"usage":"作谓语、定语；指道路等"},{"id":7352,"word":"六道轮回","pinyin":"liù dào lún huí","abbr":"ldlh","explanation":"佛教语，六道：天道、人道、阿修罗道、畜生道、饿鬼道和地狱道。指众生轮回的六大去处，即在这六道中轮回生死。","source":{"text":"圣人有以见六趣轮回，是无明网，故决之以定力。","book":"唐·张说《唐陈州龙兴寺碑》"},"example":{"text":"我着你脱离生死，免却～。","book":"元·李寿卿《度柳翠》第一折"},"similar":["六趣轮回"],"usage":"作宾语、定语；迷信说法"},{"id":7353,"word":"六问三推","pinyin":"liù wèn sān tuī","abbr":"lwst","explanation":"指反复审讯。","source":{"text":"拚守着七贞九烈，怕甚么六问三推，一任地万打千敲。","book":"元·孟汉卿《魔合罗》第三折：“我是个妇女家，怎熬这六问三推。”元·李行道《灰阑记》第二折"},"example":{"text":"至于扳诬冤枉的，却又～，千般锻炼。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["三推六问"],"usage":"作谓语、定语；指反复审讯"},{"id":7354,"word":"六阳会首","pinyin":"liù yáng huì shǒu","abbr":"lyhs","explanation":"中医诊脉，有手三阳、足三阳六脉，六阳脉都集中在头部，故俗称头为“六阳会首”。","source":{"text":"对着众官人每在此，我这一去，若有些儿差失呵，我输我这六阳会首。","book":"元·高文秀《渑池会》第二折"},"example":{"text":"头是～，说成阴是不对的。","book":"王小波《寻找无双》第六章"},"usage":"作宾语、定语；用于比喻句"},{"id":7355,"word":"六韬三略","pinyin":"liù tāo sān lüè","abbr":"ltsl","explanation":"《六韬》、《三略》：都是古代的兵书。后泛指兵书、兵法。","source":{"text":"《三略》，下邳神人撰。","book":"《后汉书·何进传》李贤注：“太公《六韬篇》第一《霸典文论》，第二《文师武论》，第三《龙韬主将》，第四《虎韬偏裨》，第五《豹韬校尉》，…”《隋书·经籍志》"},"example":{"text":"～，淹贯胸中，唯吾所用，何担孙武子十三篇而已哉。","book":"元·郑德辉《王粲登楼》第二折"},"similar":["龙韬豹略"],"usage":"作宾语；指兵书、兵法"},{"id":7356,"word":"六马仰秣","pinyin":"liù mǎ yǎng mò","abbr":"lmym","explanation":"六马：古代天子驾车用六匹马；仰秣：马被琴声吸引，仰头欣赏。形容乐声美妙，连马都抬起头倾听，不吃饲料。","source":{"text":"昔者瓠巴鼓瑟而沉鱼出听，伯牙鼓琴而六马仰秣。","book":"战国·赵·荀况《荀子·劝学》"},"example":{"text":"推此以论，百兽率舞，潭鱼出听，～，不复疑矣。","book":"汉·王充《论衡·率性》"},"usage":"作谓语、宾语；形容乐声美妙"},{"id":7357,"word":"兰友瓜戚","pinyin":"lán yǒu guā qī","abbr":"lygq","explanation":"兰友：意气相投的至友；瓜戚：瓜葛相连的亲戚。形容亲戚、朋友关系亲近。","source":{"text":"吾辈得施为，正好谈心花底；兰友瓜戚，门外不须倒屣。","book":"清·孔尚任《桃花扇·媚坐》"},"usage":"作宾语、定语；用于比喻句"},{"id":7358,"word":"兰因絮果","pinyin":"lán yīn xù guǒ","abbr":"lyxg","explanation":"兰因：比喻美好的结合；絮果：比喻离散的结局。比喻男女婚事初时美满，最终离异。","source":{"text":"初，郑文公有贱妾曰燕姞，梦天使与己兰。","book":"《周易·系辞上》：“二人同心，其利断金；同心之言，其臭如兰。”《左传·宣公三年》"},"example":{"text":"～，现业谁深。","book":"清·张潮《虞初新志·小青传》"},"usage":"作宾语；用于男女婚姻"},{"id":7359,"word":"兰姿蕙质","pinyin":"lán zī huì zhì","abbr":"lzhz","explanation":"姿：容貌，姿态；蕙：香草；蕙质：比喻美质。比喻女子聪慧美丽。","source":{"text":"兰姿蕙质，香肌称罗绮。","book":"元·施君美《幽闺记·少不知愁》"},"similar":["兰情蕙性"],"usage":"作谓语、定语；多用于女性"},{"id":7360,"word":"兰形棘心","pinyin":"lán xíng jí xīn","abbr":"lxjx","explanation":"兰：兰草；棘：荆棘。比喻外表和善，内心险恶。","source":{"text":"若夫丽色妖容，高才美辞，貌足倾城，言以乱国，此乃兰形棘心，玉曜瓦质，在邦必危，在家必亡。","book":"唐·欧阳洵《艺文类聚》卷二十三"}},{"id":7361,"word":"兰心蕙性","pinyin":"lán xīn huì xìng","abbr":"lxhx","explanation":"兰、蕙：均为香草。比喻女子幽闲聪颖的品性。","source":{"text":"愿奶奶，兰心蕙性，枕前言下，表余深意。","book":"宋·柳永《玉女摇仙佩》"},"example":{"text":"况且她虽说是个乡村女子，外面生得一副好姿容，心里藏着一幅～。","book":"清·文康《儿女英雄传》第八回"},"similar":["兰情蕙性"],"usage":"作谓语、定语；形容女子芳洁高雅"},{"id":7362,"word":"兰怨桂亲","pinyin":"lán yuàn guì qīn","abbr":"lygq","explanation":"比喻所在的环境或经历不同，因而遭遇也不同。","source":{"text":"是知兰植中途，必无经时之翠；桂生幽壑，终保弥年之丹。非兰怨而桂亲，岂涂害而壑利？而生灭有殊者，隐显之势异也。","book":"《晋书·陆机陆云传论》"}},{"id":7363,"word":"兰情蕙性","pinyin":"lán qíng huì xìng","abbr":"lqhx","explanation":"兰：兰草；蕙：蕙草；性：比喻美质。比喻女子的人品贤淑娴雅。","source":{"text":"你兰情蕙性，休害得愁眉蹙捉。","book":"明·无名氏《鸣凤记·邹林会试》"},"similar":["兰心蕙性"],"usage":"作谓语、定语；多用于女性"},{"id":7364,"word":"兰摧玉折","pinyin":"lán cuī yù zhé","abbr":"lcyz","explanation":"摧：折断。兰草、美玉都折断了。旧时多用于哀悼人不幸早死。","source":{"text":"毛伯成既负其才气，尝称宁为兰摧玉折，不作萧敷艾荣。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"余虽昆季，义犹友朋，～，实难为情。","book":"明·张岱《祭伯凝八弟文》"},"similar":["香消玉陨"],"usage":"作宾语；多用于哀悼人不幸早死"},{"id":7365,"word":"兰桂腾芳","pinyin":"lán guì téng fāng","abbr":"lgtf","explanation":"兰桂：芝兰和丹桂，儿孙的美称；芳：比喻美名。比喻子孙显贵发达。","source":{"text":"子孙发达，谓之兰桂腾芳。","book":"清·程允升《幼学故事琼林·祖孙父子》"},"similar":["兰桂齐芳"],"usage":"作宾语；比喻子孙显贵发达"},{"id":7366,"word":"兰桂齐芳","pinyin":"lán guì qí fāng","abbr":"lgqf","explanation":"兰桂：对他人儿孙的美称；芳：比喻美德、美声。旧指儿孙同时显贵发达。","source":{"text":"与阶前兰桂齐芳，应堂上椿萱同茂。","book":"明·胡文焕《群音类选·百顺记·王曾祝寿》"},"example":{"text":"现今荣宁两府，善者修缘，恶者悔祸，将来～，家道复初，也是自然的道理。","book":"清·曹雪芹《红楼梦》第一百二十回"},"similar":["兰桂腾芳","椿萱同茂"],"usage":"作宾语；比喻子孙显贵发达"},{"id":7367,"word":"兰梦之征","pinyin":"lán mèng zhī zhēng","abbr":"lmzz","explanation":"兰梦：相传春秋时郑文公妾燕姑梦天使赐兰，生子，取名为兰，因以比喻妇女怀孕。比喻妇人怀孕的征兆。","source":{"text":"言其孕子，如逢兰梦之征。","book":"明·周之翰《为律娶妻判》"}},{"id":7368,"word":"兰熏桂馥","pinyin":"lán xūn guì fù","abbr":"lxgf","explanation":"比喻恩泽长留，历久不衰。","source":{"text":"常山王之玉润金声，博望侯之兰熏桂馥，羽仪百代，掩梁窦以霞搴；钟鼎一时，罩袁杨而岳立。","book":"唐·骆宾王《上齐州张司马启》"}},{"id":7369,"word":"兰艾同焚","pinyin":"lán ài tóng fén","abbr":"latf","explanation":"兰：香草名；艾：臭草；焚：烧。兰花跟艾草一起烧掉。比喻不分好坏，一同消灭。","source":{"text":"兰艾同焚，贤愚所叹。","book":"《晋书·孔坦传》"},"example":{"text":"若前途大事不捷，故自～。","book":"《南史·梁纪上·武帝上》"},"similar":["同归于尽"],"usage":"作宾语；比喻不分好坏，一同消灭"},{"id":7370,"word":"兰艾难分","pinyin":"lán ài nán fēn","abbr":"lanf","explanation":"兰：香草名，比喻贤者；艾：臭草，比喻小人。好人、坏人难于分清。","source":{"text":"交战之日，兰艾难分。土崩倒戈，宜为蚤（早）计。","book":"《宋书·沈攸之传》"},"example":{"text":"如今的社会～，我们处处得提防。"},"usage":"作宾语、定语；指好人坏人难于分清"},{"id":7371,"word":"兰芝常生","pinyin":"lán zhī cháng shēng","abbr":"lzcs","explanation":"兰芝：兰草和灵芝草。比喻高尚的美德长在。","source":{"text":"君乘金而王，其政平，则兰芝常生。","book":"汉·王延寿《鲁灵光殿赋》：“朱桂黝儵于南北，兰芝阿那于东西。”注引：《礼年威仪》"},"usage":"作宾语、定语；用于比喻句"},{"id":7372,"word":"兰芷之室","pinyin":"lán zhǐ zhī shì","abbr":"lzzs","explanation":"兰、芷：两种香草。比喻良好的环境。","source":{"text":"与君子游，苾乎加入兰芷之室，久而不闻，则与之化矣。","book":"《大戴礼记·曾子疾病》"},"usage":"作宾语；指良好的环境"},{"id":7373,"word":"兰芷渐滫","pinyin":"lán zhǐ jiàn xiǔ","abbr":"lzjx","explanation":"兰、芷：香草；渐：浸渍；滫：臭泔水。把兰、芷浸泡在泔水里。比喻受恶环境的影响。","source":{"text":"兰槐之根是为芷，其渐之滫，君子不近，庶人不服。其质非不美也。所渐者然也。","book":"《荀子·劝学》"}},{"id":7374,"word":"兰芷萧艾","pinyin":"lán zhǐ xiāo ài","abbr":"lzxa","explanation":"兰、芷：香草；萧艾：杂草。由香草变为杂草。比喻人的品德由好变坏。","source":{"text":"兰芷变而不芳兮，今直为此萧艾也。","book":"战国·楚·屈原《离骚》"}},{"id":7375,"word":"兰蒸椒浆","pinyin":"lán zhēng jiāo jiāng","abbr":"lzjj","explanation":"兰蒸：以香草蒸肉；椒浆：把椒放在浆里。对祭祀物品的美称。","source":{"text":"可激清颓俗者，皆扫地而祠之。兰蒸椒浆，岁祀罔缺。","book":"唐·李白《溧阳濑水贞义女碑铭》"}},{"id":7376,"word":"兰薰桂馥","pinyin":"lán xūn guì fù","abbr":"lxgf","explanation":"薰、馥：香气。原比喻恩泽长留，历久不衰。后用来称人子肖孙贤。","source":{"text":"常山王之玉润金声，博望侯之兰薰桂馥。","book":"唐·骆宾王《上齐州张司马启》"},"similar":["恩泽后世"],"usage":"作宾语；比喻恩泽长留，历久不衰"},{"id":7377,"word":"兰言断金","pinyin":"lán yán dàn jīn","abbr":"lydj","explanation":"兰言：心意相合的言论；断金：比喻同心。心意相合才会有共同语言。","source":{"text":"挹兰言于断金，交蓬心于匪石。","book":"唐·骆宾王《上齐州张司马启》"}},{"id":7378,"word":"兰质熏心","pinyin":"lán zhì xūn xīn","abbr":"lzxx","explanation":"比喻女子淑美善良的气质。"},{"id":7379,"word":"兰质蕙心","pinyin":"lán zhì huì xīn","abbr":"lzhx","explanation":"蕙、兰：都是香草名。兰花似的本质，蕙草样的心地。比喻女子心地纯洁，性格高雅。","source":{"text":"金声玉韵，蕙心兰质。","book":"南朝·宋·鲍照《芜城赋》：“东都妙姬，南国丽人，蕙心纨质，玉貌绛唇。”唐·王勃《七夕赋》"},"example":{"text":"～何所在？焉知过者是狂夫。","book":"唐·杨虞卿《过小妓英英墓》"},"similar":["蕙心兰质"],"usage":"作谓语、宾语；形容女子美丽而聪明"},{"id":7380,"word":"兰质薰心","pinyin":"lán zhì xūn xīn","abbr":"lzxx","explanation":"比喻女子淑美善良的气质。","source":{"text":"比喻女子淑美善良的气质。"}},{"id":7381,"word":"共为唇齿","pinyin":"gòng wéi chún chǐ","abbr":"gwcc","explanation":"比喻互相辅助。","source":{"text":"蜀有重险之固，吴有三江之阻，合此二长，共为唇齿，进可兼并天下，退可鼎足而立。","book":"晋·陈寿《三国志·蜀志·邓芝传》"},"example":{"text":"这两者是～的关系。"},"similar":["唇齿相依","共相唇齿"],"usage":"作谓语、定语；比喻互相依存"},{"id":7382,"word":"共君一席话，胜读十年书","pinyin":"gòng jūn yī xí huà，shèng dú shí nián shū","abbr":"gjyxhsdsns","explanation":"和您谈一次话，胜过自己读十年书。形容对方学识渊博，见解高超，从谈话中使自己获益非浅。","source":{"text":"所谓共君一席话，胜读十年书，若说到透彻处，何止十年之功也。","book":"宋·朱熹《朱子语类》"}},{"id":7383,"word":"共商国是","pinyin":"gòng shāng guó shì","abbr":"gsgs","explanation":"国是：国家的大政方针。共同商量国家的政策和方针。","source":{"text":"愿相国与诸侯士大夫共商国是。","book":"汉·刘向《新序·杂事二》"}},{"id":7384,"word":"共存共荣","pinyin":"gòng cún gòng róng","abbr":"gcgr","explanation":"共同存在，共同繁荣。一般多指国与国之间的关系。","source":{"text":"通电就职时列举四项方针：（1）停止内战，（2）外交上采取睦邻主义，冀达共存共荣目的，（3）……","book":"陶菊隐《北洋军阀统治时期史话》第80章"},"example":{"text":"我们本着～的原则行事。"},"opposite":["你死我活"],"usage":"作谓语、定语；指国际关系"},{"id":7385,"word":"共挽鹿车","pinyin":"gòng wǎn lù chē","abbr":"gwlc","explanation":"挽：拉；鹿车：古时的一种小车。旧时称赞夫妻同心，安贫乐道。","source":{"text":"妻乃悉归侍御服饰，更著短衣裳，与宣共挽鹿车归乡里。","book":"南朝·宋·范晔《后汉书·鲍宣妻传》"},"example":{"text":"他们夫妻～回到故乡生活。"},"similar":["鹿车共挽"],"usage":"作谓语；用于夫妻"},{"id":7386,"word":"共枝别干","pinyin":"gòng zhī bié gàn","abbr":"gzbg","explanation":"比喻一个教师传授下来的但又各人自成一派。","source":{"text":"他们所注之书，或所见不同，各有所取；或师资相传，共枝别干。","book":"清·李汝珍《镜花缘》第52回"},"example":{"text":"我与他是～的关系。"},"usage":"作谓语、定语；用于师生关系等"},{"id":7387,"word":"共济世业","pinyin":"gòng jì shì yè","abbr":"gjsy","explanation":"济：成；世业：世代相传的事业。共同完成世代相传的事业。泛指国家统一大业。","source":{"text":"今为君计，莫若遣腹心自结于东，以共济世业。","book":"《资治通鉴·汉纪·献帝建安十三年》"}},{"id":7388,"word":"共相唇齿","pinyin":"gòng xiāng chún chǐ","abbr":"gxcc","explanation":"唇齿：比喻关系密切，互相依存。比喻互相依存，有共同的利害关系。","source":{"text":"或南通刘氏，或北约蠕蠕，共相唇齿，谋陵王略。","book":"《魏书·百济传》"},"similar":["共为唇齿"],"usage":"作谓语、定语；比喻互相依存"},{"id":7389,"word":"共相标榜","pinyin":"gòng xiāng biāo bǎng","abbr":"gxbb","explanation":"标榜：夸耀。彼此之间互相吹嘘、颂扬。","source":{"text":"海内希风之流，遂共相标榜。","book":"南朝·宋·范晔《后汉书·党锢传》"},"similar":["互相标榜"],"usage":"作谓语、宾语；指互相吹嘘"},{"id":7390,"word":"共贯同条","pinyin":"gòng guàn tóng tiáo","abbr":"ggtt","explanation":"串在同一钱串上，长在同一枝条上。比喻脉络连贯，事理相通。","source":{"text":"涕笑皆神之所行，逡巡皆气之所应，固可于此得吾兄……共贯同条之精爽。","book":"清·王夫之《石崖先生传略》"},"usage":"作宾语、定语；用于书面语"},{"id":7391,"word":"共饮一江水","pinyin":"gòng yǐn yī jiāng shuǐ","abbr":"gyyjs","explanation":"一起喝一条江河里的水。指彼此在一条江河的哺育下共同成长，有共同的感情。也指邻国之间人民的亲密友谊。","source":{"text":"我住长江头，君住长江尾，日日思君不见君，共饮长江水。","book":"宋·李这仪《卜算子》词"}},{"id":7392,"word":"关东出相，关西出将","pinyin":"guēn dōng chū xiàng，guān xī chū jiàng","abbr":"gdcxgxcj","explanation":"关：函谷关。函谷关以东的地区，民风好文，多出宰相；函谷关以西的地区，民风好武，多出将帅。","source":{"text":"古人有言，关东出相，关西出将，三秦饶儁佚异，汝异多奇士。","book":"《晋书·姚兴载记》"},"example":{"text":"世言～，岂东西喻耶？（唐·李复言《续玄怪录·李卫公靖》）"},"similar":["关西出将，关东出相"],"usage":"作宾语、分句；指两地的民风"},{"id":7393,"word":"关仓遏粜","pinyin":"guēn cāng è tiào","abbr":"gcet","explanation":"遏粜：停止出售粮食。关闭粮仓，不再卖粮食。指囤积居奇，哄抬物价。","source":{"text":"大户人家有米的，却又关仓遏粜。","book":"明·冯梦龙《醒世恒言》卷二十"}},{"id":7394,"word":"关山迢递","pinyin":"guān shān tiáo dì","abbr":"gstd","explanation":"关：关隘；迢递：遥远的样子。指路途遥远。","source":{"text":"贤弟！无限别情，不胜凄怆，关山迢递，后会难期。","book":"明·王世桢《鸣凤记》第八出"},"example":{"text":"只是～，怎得寄个信去。","book":"明·冯梦龙《古今小说·吴保安弃家赎友》"},"usage":"作宾语、定语；指路途遥远"},{"id":7395,"word":"关山阻隔","pinyin":"guān shān zǔ gé","abbr":"gszg","explanation":"关隘山岭阻挡隔绝。形容路途艰难，往来不易。","source":{"text":"不争他回家去呵，路途艰难，关山阴隔，这亲事几时得就。","book":"元·郑德辉《　梅香》第一折"},"usage":"作谓语、宾语；形容路途艰难"},{"id":7396,"word":"关心民瘼","pinyin":"guān xīn mín mò","abbr":"gxmm","explanation":"瘼：疾，疾苦。关心群众的疾苦。","source":{"text":"非得关心民瘼之员，竭力抚循，不足以资补救。","book":"清·李宝嘉《官场现形记》第三十四回"},"example":{"text":"身为政府官员，～当为本职。"},"similar":["吊民问疾"],"usage":"作主语、谓语、定语；指关心群众的疾苦"},{"id":7397,"word":"关怀备至","pinyin":"guān huái bèi zhì","abbr":"ghbz","explanation":"关心得无微不至。","source":{"text":"总理对人总是关怀备至，体贴入微。","book":"刘白羽《海天集·伟大创业者》"},"example":{"text":"他对手下都是～的。"},"similar":["体贴入微"],"opposite":["漠不关心"],"usage":"作谓语、定语；指特别关心"},{"id":7398,"word":"关情脉脉","pinyin":"guān qíng mò mò","abbr":"gqmm","explanation":"关情：关切的情怀；脉脉：情意深长。形容眼神中表露的意味深长的绵绵情怀。","source":{"text":"垂念故人，关情脉脉。","book":"清·简中生《吴门画舫录》外编"},"similar":["温情脉脉"],"usage":"作谓语、定语；用于人的眼神等"},{"id":7399,"word":"关籥蕃篱","pinyin":"guān yuè fán lí","abbr":"gyfl","explanation":"籥：锁钥；蕃篱：指篱笆，屏障。比喻边疆像落了锁的铁壁，坚固异常。","source":{"text":"为之关籥蕃篱，而远备闭之，犹恐其至也。","book":"《国语·楚语下》"}},{"id":7400,"word":"关西出将，关东出相","pinyin":"guān xī chū jiàng，guān dōng chū xiàng","abbr":"gxcjgdcx","explanation":"关：函谷关。函谷关以东的地区，民风好文，多出宰相；函谷关以西的地区，民风好武，多出将帅。","source":{"text":"谚曰：‘关西出将，关东出相。’观其习兵壮勇，实过余州。","book":"南朝·宋·范晔《后汉书·虞诩传》"},"similar":["关东出相，关西出将"],"usage":"作宾语、分句；指两地的民风"},{"id":7401,"word":"关门养虎，虎大伤人","pinyin":"guān mén yǎng hǔ，hǔ dà shāng rén","abbr":"gmyhhdsr","explanation":"比喻纵容助长坏人坏事，到头来自己受害。","source":{"text":"古人说的‘关门养虎，虎大伤人’。这个东西，如何养得熟的。","book":"清·钱彩《说岳全传》第四十回"},"similar":["养虎为患"],"usage":"作宾语、定语；用于劝诫人"},{"id":7402,"word":"关门大吉","pinyin":"guān mén dà jí","abbr":"gmdj","explanation":"指商店倒闭或企业破产停业。","source":{"text":"现在他们维持不下，难免要弄到关门大吉，那也是中国工业的损失。","book":"茅盾《子夜》五"},"example":{"text":"生产不生产，认为和他毫无关系；不生产，～，那才好哩。","book":"周而复《上海的早晨》第三部"},"opposite":["开张大吉"],"usage":"作谓语；指商店倒闭或企业破产停业"},{"id":7403,"word":"关门打狗","pinyin":"guān mén dǎ gǒu","abbr":"gmdg","explanation":"比喻将对方控制在自己势力范围内，然后进行有效打击。","source":{"text":"‘就是这个意思。’赵航宇说，‘诱敌深入，关门打狗。’","book":"王朔《千万别把我当人》"},"example":{"text":"我们采取～的战略。"},"opposite":["放虎归山"],"usage":"作谓语、定语、宾语；用于军事等"},{"id":7404,"word":"关门捉贼","pinyin":"guān mén zhuō zéi","abbr":"gmzz","explanation":"关起门来才能捉住进来的小偷。比喻对小股敌人采取围歼的战术。"},{"id":7405,"word":"关门落闩","pinyin":"guān mén luò shuān","abbr":"gmls","explanation":"比喻没有回旋的余地。也形容到了极点。","source":{"text":"四盏灯笼，值不了五角钱；加上煤炭柴火，顶多到了四十块钱，那是关门落闩的了。","book":"《负曝闲谈》第22回"},"example":{"text":"事情还没有到～的地步。"},"similar":["盖棺论定"],"usage":"作谓语、定语；比喻没有回旋的余地"},{"id":7406,"word":"关门闭户","pinyin":"guēn mén bì hù","abbr":"gmbh","explanation":"门户都关闭起来。形容冷清寥落。","source":{"text":"风起处，惊散了那傲来国君王，三街六市，都慌得关门闭户，无人敢走。","book":"明·吴承恩《西游记》第三回"},"example":{"text":"家家～，镇里镇外死气沉沉。","book":"刘流《烈火金钢》第十四回"},"similar":["闩门闭户","闭户关门"],"opposite":["门户开放"],"usage":"作谓语、宾语、定语；用于冷清的场面"},{"id":7407,"word":"兴不由己","pinyin":"xìng bù yóu jǐ","abbr":"xbyj","explanation":"指正在兴头上，对自己的言行控制不住。","source":{"text":"她姨姨倒不是个媒婆子；不过是兴不由己，有口无心地张嘴搭话。","book":"康濯《春种秋收》"},"example":{"text":"她姨姨倒不是个媒婆子；不过是～，有口无心地张嘴搭话。","book":"康濯《春种秋收》"},"similar":["情不自禁"],"usage":"作谓语、宾语；用于处事"},{"id":7408,"word":"兴丞相叹","pinyin":"xīng chéng xiàng tàn","abbr":"xcxt","explanation":"兴：兴起。两处老鼠的不同境遇使李斯兴起感叹，感叹人的贤与不肖，着急在于自处。","source":{"text":"观仓中鼠，拿积粟，居大庑，不见人犬之居。于是李斯乃叹曰：‘人之贤与不肖，譬如鼠也，在所自处耳。’","book":"《史记·李斯列传》"},"example":{"text":"太仓失陈红，狡穴得余腐。既～，又发廷尉怒。","book":"宋·苏轼《鼠须笔》"},"usage":"作谓语、宾语；用于书面语","story":["战国时期，楚国上蔡人李斯年轻时担任一个郡吏，看到官房茅厕有老鼠在偷食粪便，看到人来了，赶紧逃命。后来他到仓库查访，看到仓库中的老鼠吃着官粮，看到人也不害怕。于是大发感慨：“人之贤不肖，譬如鼠矣，在所自处耳。”"]},{"id":7409,"word":"兴事动众","pinyin":"xīng shì dòng zhòng","abbr":"xsdz","explanation":"指运用大批人力。","source":{"text":"今故兴事动众，以增国城，，其可以移之乎？","book":"《吕氏春秋·季夏纪·制乐》"}},{"id":7410,"word":"兴云作雨","pinyin":"xīng yún zuò yǔ","abbr":"xyzy","explanation":"布：施。兴起云，布下雨。比喻神怪法术高明。","source":{"text":"时天竺僧不空三藏居于静住寺，三藏善以持念召龙兴云雨。","book":"宋·李昉《太平广记》卷四百二十一"},"example":{"text":"天上玉皇可以随意颁雨，河中龙王也能～。","book":"沈从文《一个母亲》第二章"},"similar":["兴云布雨","兴云作雾","兴云致雨"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":7411,"word":"兴云作雾","pinyin":"xīng yún zuò wù","abbr":"xyzw","explanation":"兴起云雾。比喻神道鬼怪法力高强。","source":{"text":"量那道人，有甚么神通，不知展吾兴云作雾之机，涌浪翻波之智，待春雷始震，正值风云庆会之时，就将形山洗去，叫他一般皆休。","book":"明·杨慎《洞天玄记》第三折"},"similar":["兴云吐雾","兴云作雨"],"usage":"作谓语、宾语；用于书面语"},{"id":7412,"word":"兴云吐雾","pinyin":"xīng yún tǔ wù","abbr":"xytw","explanation":"兴起云雾。比喻神道鬼怪法力高强。","source":{"text":"盘龙盘龙，隐于镜中。分野有象，变化无穷。兴云吐雾，行雨生风。上清仙子，来献圣聪。","book":"唐·龙护老人《铸镜歌》"},"example":{"text":"龙能大能小，能升能隐；大则～，小则隐介藏形；升则飞腾于宇宙之间，隐则潜伏于波涛之内。","book":"明·罗贯中《三国演义》第二十一回"},"similar":["兴云作雾","兴云布雨"],"usage":"作谓语、宾语；用于书面语"},{"id":7413,"word":"兴云布雨","pinyin":"xīng yún bù yǔ","abbr":"xyby","explanation":"布：施。兴起云，布下雨。比喻神怪法术高明。","source":{"text":"小圣东海龙神是也，奉上帝敕令，管领着江河淮济，溪洞潭渊，兴云布雨，降福消灾，济渡众生。","book":"明·无名氏《南极登山》第二折"},"similar":["兴云吐雾"],"usage":"作谓语、宾语；用于书面语"},{"id":7414,"word":"兴云致雨","pinyin":"xīng yún zhì yǔ","abbr":"xyzy","explanation":"兴云：布下云彩。致雨：使下雨。神话传说，神龙有布云作雨的能力。借喻乐曲诗文，声势雄壮，不同凡响。","source":{"text":"郡界有名山大川能兴云致雨者，长吏各洁斋祷请，冀蒙嘉澍。","book":"《后汉书·孝明帝纪》"},"example":{"text":"不拘官吏军民人等，如有能～，本县不惜重礼酬谢。","book":"明·凌濛初《初刻拍案惊奇》卷三十九"},"similar":["兴云布雨","兴云作雨"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":7415,"word":"兴亡成败","pinyin":"xīng wáng chéng bài","abbr":"xwcb","explanation":"兴盛、衰亡、成功、失败。泛指世事变迁。","source":{"text":"叹千古、兴亡成败，满乾坤、遗恨有谁知。","book":"宋·王质《八声甘州·怀张安国》"},"example":{"text":"它有贫穷富贵，有尊荣耻辱，有士农工商，有～。","book":"孙犁《乡里旧闻·木匠的女儿》"},"usage":"作宾语、定语；用于书面语"},{"id":7416,"word":"兴亡祸福","pinyin":"xīng wáng huò fú","abbr":"xwhf","explanation":"兴盛和灭亡，灾祸和幸福。泛指一切遭遇。","source":{"text":"这七条弦兴亡祸福都相应，端的个圣贤可对，神鬼堪惊；俗怀顿爽，尘虑皆清。","book":"元·关汉卿《玉镜台》第二折"},"example":{"text":"吾言为公～之计，愿公安意听之。","book":"《清·毕沅《续资治通鉴》卷二百十九"},"usage":"作宾语、定语；用于书面语"},{"id":7417,"word":"兴亡继绝","pinyin":"xīng wáng jì jué","abbr":"xwjj","explanation":"使灭绝的重新振兴起来，延续下去。同“兴灭继绝”。","source":{"text":"《论语·尧曰》： “兴灭国，继绝世。”"},"example":{"text":"唐·刘知畿《史通·模拟》：“齐桓行霸，～。”"},"similar":["兴废继绝","兴灭继绝"],"usage":"作谓语、定语；用于书面语"},{"id":7418,"word":"兴会标举","pinyin":"xìng huì biāo jǔ","abbr":"xhbj","explanation":"兴会：情趣，兴致；标举：高超。形容文章情致高超。","source":{"text":"灵运之兴会标举，延年之体裁明密，并方轨前秀，垂范后昆。","book":"《宋书·谢灵运传论》"},"usage":"作宾语、定语；用于书面语"},{"id":7419,"word":"兴会淋漓","pinyin":"xìng huì lín lí","abbr":"xhll","explanation":"兴会：兴致；淋漓：酣畅，充盛。形容兴致很高，精神舒畅。","source":{"text":"这父子兴会淋漓，已牌未脱稿，午初至未刻誊写干净。","book":"清·李绿园《歧路灯》第九十三回"},"example":{"text":"今我在戎行，曷言艺文事？慷慨每难免，～至。","book":"陈毅《湖海诗社开征引》"},"similar":["痛快淋漓","兴致淋漓"],"usage":"作谓语、状语；用于书面语"},{"id":7420,"word":"兴兴头头","pinyin":"xìng xìng tóu tóu","abbr":"xxtt","explanation":"形容兴头很足。","source":{"text":"忽见张寅同一个朋友兴兴头头的走上亭子来。只因这一来，有分教：君子流不尽芳香，小人献不了遗丑。","book":"明·罗贯中《平山冷燕》第十回"},"example":{"text":"外国人拿了字据，～去见弥轩，说明来意。","book":"清·吴趼人《二十年目睹之怪现状》第一百六回"},"similar":["兴致勃勃"],"opposite":["兴味萧然"],"usage":"作谓语、定语；用于处事等"},{"id":7421,"word":"兴兵动众","pinyin":"xīng bīng dòng zhòng","abbr":"xbdz","explanation":"旧指大规模出兵。现多指动用很多人力做某件事。同“兴师动众”。","source":{"text":"兴兵动众，欲危宗庙，恶不忍闻，罪不容诛。","book":"《吴子·励士》：“夫发号布令，而人乐闻；兴师动众，而人乐战；交兵接刃，而人乐死。”汉·张竦《为刘嘉作奏称莽功德》"},"example":{"text":"那厮见了，不欧个死，也有九分没气。他必然～，拼命而来，当如何对付他，愿闻众位妙策。","book":"清·俞万春《荡寇志》第九十四回"},"similar":["兴师动众","劳师动众","行师动众"],"opposite":["单枪匹马","小打小闹"],"usage":"作谓语、宾语、状语；指大规模行动"},{"id":7422,"word":"兴利剔弊","pinyin":"xīng lì tì bì","abbr":"xltb","explanation":"剔：剔除；弊：弊端，害处。兴办有利的事业，除去各种弊端。","source":{"text":"趁今日清静，大家商议两件兴利剔弊的事，也不枉太太委托一场。","book":"清·曹雪芹《红楼梦》第56回"},"example":{"text":"清·李汝珍《镜花缘》第68回：“我们同心协力，各矢忠诚，或定礼制乐，或～，或除暴安良，或举贤去佞，或敬慎刑名，或留心案牍。”"},"similar":["兴利除弊"],"usage":"作谓语、定语；用于处事"},{"id":7423,"word":"兴利节用","pinyin":"xīng lì jié yòng","abbr":"xljy","explanation":"兴利：开发资源；节用：节约花费。比喻开源节流的经济措施。","source":{"text":"虽是兴利节用为纲，然亦不可太啬。纵再省上二三百银子，失了大体统也不象。","book":"清·曹雪芹《红楼梦》第五十六回"},"usage":"作宾语、定语；用于书面语"},{"id":7424,"word":"兴利除害","pinyin":"xīng lì chú hài","abbr":"xlch","explanation":"兴办对国家人民有益利的事业，除去各种弊端。","source":{"text":"为民兴利除害，正民之德。","book":"春秋·齐·管仲《管子·君臣》"},"example":{"text":"古之明王，所以能～者，非他，盖弃小而取大耳。","book":"唐·白居易《议罢漕运可否》"},"similar":["兴利除弊","除害兴利"],"usage":"作谓语、定语；指人办事的原则"},{"id":7425,"word":"兴利除弊","pinyin":"xīng lì chú bì","abbr":"xlcb","explanation":"弊：害处，坏处。兴办对国家人民有益利的事业，除去各种弊端。","source":{"text":"举先王之政，以兴利除弊，不为生事。","book":"《管子·君臣下》：“为民兴利除害，正民之德。”宋·王安石《答司马谏议书》"},"example":{"text":"康熙七年，授常熟知县，年甫十九，～，勇于为治，老于吏事者勿逮也。","book":"《清史稿·白登明传》"},"similar":["除旧布新","破旧立新"],"opposite":["陈陈相固","故步自封"],"usage":"作谓语、定语；指人办事的原则","story":["北宋神宗时期，王安石担任参知政事，他制定《均输法》和《青苗法》减轻农民负担，增加国家财政收入，《农田水利法》使全国兴修水利，《保甲法》和《保马法》增强国防。司马光攻击是生事扰民，王安石说推行新法是兴利除弊"]},{"id":7426,"word":"兴味索然","pinyin":"xìng wèi suǒ rán","abbr":"xwsr","explanation":"兴味：兴趣、趣味；索然：毫无兴致的样子。一点儿兴趣都没有。","source":{"text":"卓午来游者，络绎不绝。溽暑蒸郁，看花之兴味索然矣。","book":"清·王韬《瀛壖杂志》"},"example":{"text":"这篇文章内容空洞，语言贫乏，读起来使人～。"},"similar":["索然无味","心灰意冷"],"opposite":["兴致勃勃","津津有味"],"usage":"作谓语、补语；指没有兴趣"},{"id":7427,"word":"兴味萧然","pinyin":"xìng wèi xiāo rán","abbr":"xwxr","explanation":"兴味：兴趣；萧然：萧索冷落的样子。没有一点兴趣。","source":{"text":"无花无酒过清明，兴味萧然似野僧。","book":"宋·王禹偁《清明》诗"},"similar":["兴尽意阑"],"opposite":["兴兴头头"],"usage":"作谓语、定语；用于处事等"},{"id":7428,"word":"兴国安邦","pinyin":"xīng guó ān bāng","abbr":"xgab","explanation":"兴：兴盛；邦：国家。国家兴盛安定。","source":{"text":"我不晓得当初为什么管它叫做兴安岭，由今天看来，它的确含有兴国安邦的意义了。","book":"《林海》"},"similar":["安邦兴国"],"usage":"作宾语、定语；用于书面语"},{"id":7429,"word":"兴复不浅","pinyin":"xìng fù bù qiǎn","abbr":"xfbq","explanation":"指兴趣还很高。","source":{"text":"俄而率左右十许人步来，诸贤欲起避之，公徐云：‘诸君少住，老子于此处，兴复不浅。’便据胡床，与诸人咏谑，竟坐甚得任乐。","book":"南朝·宋·刘义庆《世说新语·容止》"},"usage":"作谓语、定语；用于书面语","story":["晋朝时期，庾太尉在武昌经常与一些朋友登南楼赋诗游玩，一次朋友们玩得尽兴，庾公率十来人前来，诸贤士准备回避，庾公慢条斯理说道：“诸君少住，老子于此处兴复不浅。”，于是坐在胡床上与朋友纵情欢乐"]},{"id":7430,"word":"兴如嚼蜡","pinyin":"xìng rú jiáo là","abbr":"xrjl","explanation":"指毫无兴味。","source":{"text":"半百年华，鬓如丝，兴如嚼蜡。","book":"明·康海《粉蝶儿·秋日闲情》套曲"},"usage":"作宾语、定语；用于处事等"},{"id":7431,"word":"兴妖作乱","pinyin":"xīng yāo zuò luàn","abbr":"xyzl","explanation":"比喻坏人破坏捣乱，或坏思想扩大影响。同“兴妖作怪”。","source":{"text":"特别是还有帝国主义、反动派兴妖作乱，时时刻刻都想推翻我们。","book":"魏巍《东方》第三部第五章"},"similar":["兴妖作孽","兴妖作怪","作怪兴妖"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":7432,"word":"兴妖作孽","pinyin":"xīng yāo zuò niè","abbr":"xyzn","explanation":"妖魔鬼怪到处闹事作乱。比喻小人兴风作浪，为非做歹。","source":{"text":"此物在世已久，兴妖作孽，无与为比。","book":"明·瞿佑《剪灯新话·永州野庙记》"},"similar":["兴妖作乱","兴妖作怪","作怪兴妖"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":7433,"word":"兴妖作崇","pinyin":"xīng yāo zuò suì","abbr":"xyzc","explanation":"原指妖魔兴事害人。后比喻坏人破坏捣乱，或坏思想扩大影响。","source":{"text":"你既然还有阳寿，阴曹地府不管，你却这等兴妖作怪。","book":"元·无名氏《碧桃花》第三折"},"example":{"text":"凡～之狐，则不敢近正人；若读书知礼之狐，则乐近正人。","book":"清·纪昀《阅微草堂笔记·槐西杂志三》"}},{"id":7434,"word":"兴妖作怪","pinyin":"xīng yāo zuò guài","abbr":"xyzg","explanation":"比喻坏人破坏捣乱，或坏思想扩大影响。","source":{"text":"巡海夜叉道：’你那里得这几件物事，在此兴妖作怪！","book":"明·周辑《西湖二集·救金鲤海龙王报德》"},"example":{"text":"是这样看起来，完全是张仪那小子在～啦。","book":"郭沫若《屈原》第四幕"},"similar":["兴风作浪","无事生非","惹是生非"],"opposite":["风平浪静","相安无事"],"usage":"作谓语、定语、宾语；同“兴风作浪”"},{"id":7435,"word":"兴家立业","pinyin":"xīng jiā lì yè","abbr":"xjly","explanation":"建设家庭，创立事业。","source":{"text":"纵不能兴家立业，也不至弃田荡产。","book":"清·李绿园《歧路灯》第十二回"},"example":{"text":"营盘里的钱比别处赚的容易，他就此～，手内着实有钱。","book":"清·李宝嘉《官场现形记》第二十八回"},"similar":["成家立业"],"usage":"作谓语、宾语；同“成家立业”"},{"id":7436,"word":"兴尽悲来","pinyin":"xìng jìn bēi lái","abbr":"xjbl","explanation":"高兴到极点，悲哀就来了。指任何事都不能过分。","source":{"text":"天高地迥，觉宇宙之无穷，兴尽悲来，识盈虚之有数。","book":"唐·王勃《滕王阁序》"},"similar":["乐极生悲"],"usage":"作宾语、定语；用于处事等"},{"id":7437,"word":"兴尽意阑","pinyin":"xìng jìn yì lán","abbr":"xjyl","explanation":"阑：残，尽。兴味和情趣都没有了。","source":{"text":"等到兴尽意阑，便各自回去睡觉。","book":"朱自清《“海阔天空”与“古今中外”》"},"example":{"text":"等到～，便各自回去睡觉。","book":"朱自清《“海阔天空”与“古今中外”》"},"opposite":["兴致勃勃"],"usage":"作宾语、定语；用于处事等"},{"id":7438,"word":"兴工动众","pinyin":"xīng gōng dòng zhòng","abbr":"xgdz","explanation":"兴：发动。指运用大批人力。","source":{"text":"臣愚无似，窃以为人工动众，有大不便于今日者。","book":"宋·郑兴裔《请罢建康行宫疏》"},"example":{"text":"～不数旬，而中佛三殿，巍巍乎倏忽改观；移修天王一殿，昭昭乎焕然一新。","book":"清·谷旦《重修勒建寺碑记》"}},{"id":7439,"word":"兴师动众","pinyin":"xīng shī dòng zhòng","abbr":"xsdz","explanation":"兴：发动；众：大队人马。旧指大规模出兵。现多指动用很多人力做某件事。","source":{"text":"夫发号布令，而人乐闻；兴师动众，而人乐战；交兵接刃，而人乐死。","book":"《吴子·励士》"},"example":{"text":"既然怕～，不如不养活这些闲人了！","book":"清·吴敬梓《儒林外史》第四十三回"},"similar":["大动干戈","大张声势","兴兵动众"],"opposite":["小打小闹"],"usage":"作谓语、宾语、状语；指大规模行动","story":["战国时期，魏国西河太守吴起与魏武侯魏击谈论怎样才能做到战无不胜，吴起就用兵经验发表看法，君主要倚仗：将军在战场发号施令军士愿意听从，将军兴师动众作战，士卒愿意出征，到了战场，士兵不怕死，要奖罚分明"]},{"id":7440,"word":"兴师见罪","pinyin":"xīng shī jiàn zuì","abbr":"xsjz","explanation":"发动军队，声讨对方罪过。也指大闹意见，集合一伙人去上门责问。","source":{"text":"阿姹又诉于归义，兴师问罪。","book":"唐·樊绰《蛮书·名类》"},"example":{"text":"今有沛公无礼，他先入关中，封秦府库，改秦苛法。某欲～，沛公尽献秦之宝物，投吾麾下。","book":"元·无名氏《衣锦还乡》头折"},"similar":["兴师问罪"],"usage":"作谓语、定语；指斥责对方的过失"},{"id":7441,"word":"兴师问罪","pinyin":"xīng shī wèn zuì","abbr":"xswz","explanation":"发动军队，声讨对方罪过。也指大闹意见，集合一伙人去上门责问。","source":{"text":"元昊乃改元，制衣冠礼乐，下令国中，悉用蕃书、胡礼，自称大夏。朝廷兴师问罪。","book":"宋·沈括《梦溪笔谈》卷二十五"},"example":{"text":"他们哪里是来拜望我的呵，他们是来～的。","book":"蒋光慈《田野的风》"},"similar":["大张挞伐","兴师见罪"],"opposite":["负荆请罪"],"usage":"作谓语、定语；指斥责对方的过失"},{"id":7442,"word":"兴废存亡","pinyin":"xīng fèi cún wǎng","abbr":"xfcw","explanation":"将废除或消亡的事业再复兴并保存起来。","source":{"text":"问亲邻粉废存亡，叙风烟百万楚哀伤。","book":"明·汤显祖《南柯记·拜郡》"},"usage":"作宾语、定语；用于书面语"},{"id":7443,"word":"兴废继绝","pinyin":"xīng fèi jì jué","abbr":"xfjj","explanation":"使灭绝的重新振兴起来，延续下去。同“兴灭继绝”。","source":{"text":"《论语·尧曰》： “兴灭国，继绝世。”"},"example":{"text":"明·汪道昆《何先生墓碑》：“两家～，其为力难。”"},"similar":["兴亡继绝","兴灭继绝"],"usage":"作谓语、宾语；用于书面语"},{"id":7444,"word":"兴役动众","pinyin":"xīng yì dòng zhòng","abbr":"xydz","explanation":"役：劳役。指运用大批人力。","source":{"text":"比年以来，兴役动众，劳民费财，不精谋虑于厥初，轻信利害之偏说，举事之始，既已仓皇，群议一摇，寻复悔罢。","book":"宋·欧阳修《反对堵口回河疏》"}},{"id":7445,"word":"兴微继绝","pinyin":"xīng wēi jì jué","abbr":"xwjj","explanation":"使衰落了的振兴起来，中断了的延续下去。","source":{"text":"明府谨终追远，兴微继灭绝。","book":"《论语·尧曰》： “兴灭国，继绝世，举逸民，天下之民归心焉。”汉·应劭《风俗通义·过誉》"},"example":{"text":"臣闻～，圣王之高政；贬恶嘉善，《春秋》之美义。","book":"《晋书·张华传》"},"similar":["兴亡继绝","兴灭继绝"],"usage":"作谓语、定语；用于书面语"},{"id":7446,"word":"兴戎动众","pinyin":"xīng róng dòng zhòng","abbr":"xrdz","explanation":"兴：发动；戎：军队；众：大队人马。旧指大规模出兵。现多指动用很多人力做某件事。","source":{"text":"夫发号布令，而人乐闻；兴师动众，而人乐战；交兵接刃，而人乐死。","book":"《吴子·励士》"},"example":{"text":"～，为国大事。王者制以取重，人臣理不得专，故设此法以防之。","book":"唐·孙奭《律音义·擅兴》"}},{"id":7447,"word":"兴文偃武","pinyin":"xīng wén yǎn wǔ","abbr":"xwyw","explanation":"偃：停息。振兴文化经济，停息军事武备。","source":{"text":"清和六合，制数以五。海内安宁，兴文匽武。","book":"《汉书·礼乐志二》"}},{"id":7448,"word":"兴文匽武","pinyin":"xīng wén diào wǔ","abbr":"xwyw","explanation":"崇尚文治，偃息兵戎。","source":{"text":"清和六合，制数以五。海内安宁，兴文匽武。","book":"东汉·班固《汉书·礼乐志》"},"similar":["兴文偃武"],"usage":"作宾语、定语；用于治政等"},{"id":7449,"word":"兴旺发达","pinyin":"xīng wàng fā dá","abbr":"xwfd","explanation":"指事物或事业充分发展、欣欣向荣的景象。","source":{"text":"既不含糊敷衍，又不损害同志，这是我们的党兴旺发达的标志之一。","book":"毛泽东《学习和时局》"},"example":{"text":"青年一代的成长，正是我们事业必定要～的希望所在。","book":"邓小平《在全国科学大会开幕式上的讲话》"},"opposite":["贫穷落后"],"usage":"作谓语、定语；用于事业等"},{"id":7450,"word":"兴波作浪","pinyin":"xīng bō zuò làng","abbr":"xbzl","explanation":"兴、作：引起。原指神话小说中妖魔鬼怪施展法术掀起风浪。后多比喻煽动情绪，挑起事端。","source":{"text":"你是谁，在此兴波作浪？有甚沉冤？实实道来。","book":"明·许仲琳《封神演义》第三十七回"},"example":{"text":"真个是拨开覆地翻天手，要斩～邪。","book":"明·冯梦龙《警世通言》卷四十"},"similar":["兴风作浪"],"usage":"作谓语、定语、宾语；指挑起事端"},{"id":7451,"word":"兴灭举废","pinyin":"xīng miè jǔ fèi","abbr":"xmjf","explanation":"把已经消亡和废除了的重新兴办起来。","source":{"text":"胥教胥诲，以引以翼，以继武王周公兴灭举废之心，可也。","book":"明·刘基《杞子来朝》"},"similar":["兴微继绝","兴废继绝"],"usage":"作谓语、定语；用于书面语"},{"id":7452,"word":"兴灭继绝","pinyin":"xīng miè jì jué","abbr":"xmjj","explanation":"使灭绝的重新振兴起来，延续下去。","source":{"text":"《论语·尧曰》： “兴灭国，继绝世。”"},"example":{"text":"～存三国，大义堂堂五霸魁。","book":"明·冯梦龙《东周列国志》第二十三回"},"similar":["兴亡继绝","兴废继绝"],"usage":"作谓语、定语；用于书面语"},{"id":7453,"word":"兴犹不浅","pinyin":"xìng yóu bù qiǎn","abbr":"xybq","explanation":"指兴趣还很高。多指与人一同游乐的兴致很高。","source":{"text":"俄而率左右十许人步来，诸贤欲起避之，公徐云：‘诸君少住，老子于此处，兴复不浅。’便据胡床，与诸人咏谑，竟坐甚得任乐。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"老子兴来犹不浅，故人病后肯相疏。","book":"元·陆文圭《墙东类稿·偶题》"}},{"id":7454,"word":"兴致勃勃","pinyin":"xìng zhì bó bó","abbr":"xzbb","explanation":"兴致：兴趣；勃勃：旺盛的样子。形容兴头很足。","source":{"text":"到了郡考，众人以为缁氏必不肯去，谁知他还是兴致勃勃道：‘以天朝之大，岂无看文巨眼。’","book":"清·李汝珍《镜花缘》第五十六回"},"example":{"text":"全班同学早就集合好，～地向野游地进发了。"},"similar":["兴高采烈","兴趣盎然"],"opposite":["无精打彩","兴味索然"],"usage":"作谓语、定语、状语；指人的兴头十足"},{"id":7455,"word":"兴致勃发","pinyin":"xìng zhì bó fā","abbr":"xzbf","explanation":"兴致：兴趣；勃发：旺盛的样子。形容兴头很足。","source":{"text":"梨园子弟同宫女们，歌的歌，舞的舞。饮至半酣，兴致勃发。","book":"清·褚人获《隋唐演义》第八十九回"},"example":{"text":"此时他的目光就分外着意，好似一个真正的马师，看到一群良种的骏马。由于～，眼睛烁烁闪光。","book":"冯骥才《爱之上》十八"},"similar":["兴致勃勃"],"usage":"作谓语、定语、状语；指人的兴头十足"},{"id":7456,"word":"兴致淋漓","pinyin":"xìng zhì lín lí","abbr":"xzll","explanation":"犹兴会淋漓。形容兴致很高，精神舒畅。","source":{"text":"这父子兴会淋漓，已牌未脱稿，午初至未刻誊写干净。","book":"清·李绿园《歧路灯》第九十三回"},"example":{"text":"海棠走后，质夫忽觉～起来，接连喝了二三杯酒。","book":"郁达夫《秋柳》"},"similar":["兴会淋漓"],"usage":"作谓语、状语；用于书面语"},{"id":7457,"word":"兴致索然","pinyin":"xìng zhì suǒ rán","abbr":"xzsr","explanation":"一点儿兴趣都没有。","source":{"text":"卓午来游者，络绎不绝。溽暑蒸郁，看花之兴味索然矣。","book":"清·王韬《瀛壖杂志》"},"example":{"text":"这篇文章内容空洞，语言贫乏，读起来使人～。"},"similar":["兴味索然"],"opposite":["津津有味"],"usage":"作谓语、补语；指没有兴趣"},{"id":7458,"word":"兴衰际遇","pinyin":"xīng shuā jì yù","abbr":"xsjy","explanation":"际遇：遭遇。指事物的兴盛、衰亡的遭遇。","source":{"text":"至若离合悲欢，兴衰际遇，则又追踪蹑迹，不敢稍加穿凿，徒为供人之目而反失其真传者。","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"其间离合悲欢，～，俱是按迹寻踪，不敢稍加穿凿，致失其真。","book":"孙犁《论风格》"}},{"id":7459,"word":"兴观群怨","pinyin":"xìng guān qún yuàn","abbr":"xgqy","explanation":"兴：联想；观：观察；群：合群；怨：怨恨。古人认为读《诗经》可以培养人的四种能力。后泛指诗的社会功能。","source":{"text":"诗，可以兴，可以观，可以群，可以怨。","book":"《论语·阳货》"},"example":{"text":"明·顾起元《竹浪斋诗序》：“欲如古之所谓～多识者，杳然不可复得于篇什内矣。”"},"usage":"作宾语、定语；用于书面语"},{"id":7460,"word":"兴言夙驾","pinyin":"xīng yán sù jià","abbr":"xysj","explanation":"言：语助词，无义；夙：早。星夜驾车行驶。","source":{"text":"星言夙驾，说于桑田。","book":"《诗经·鄘风·定之方中》"}},{"id":7461,"word":"兴讹造讪","pinyin":"xīng é zào shàn","abbr":"xezs","explanation":"指造谣毁谤。","source":{"text":"凡此五鬼，为吾五患，饥我寒我，兴讹造讪，能使我迷。","book":"唐·韩愈《送穷文》"},"example":{"text":"犹之欧公及己并二人名称不至泯然，而讪者已人人噤口，足见英伟奇逸者之不可漫灭，～者之不能持久也。","book":"清·林纾《畏庐论文》"},"usage":"作谓语、宾语；用于书面语"},{"id":7462,"word":"兴词告状","pinyin":"xīng cí gào zhuàng","abbr":"xcgz","explanation":"兴词：撰写并呈递状词；告状：打官司。写状词打官司。","source":{"text":"谁想俺小舅子打死两个人的命，那苦主要行词告状。","book":"元·无名氏《延安府》第一折"},"example":{"text":"忘八要～，只问狄希陈要人。","book":"清·西周生《醒世姻缘传》第六十一回"}},{"id":7463,"word":"兴词构讼","pinyin":"xīng cí gòu sòng","abbr":"xcgs","explanation":"兴词：撰写并呈递状词；构讼：打官司。写关词打官司。","source":{"text":"那麒麟村的居民，最好兴词构讼。","book":"清·钱彩《说岳全传》第五回"},"usage":"作宾语、定语；用于书面语"},{"id":7464,"word":"兴趣盎然","pinyin":"xìng qù àng rán","abbr":"xqar","explanation":"形容兴趣浓厚。","example":{"text":"至于创作，就无抄矣，但虽不能抄，却要以套，一套就是一本，比小孩子玩尿泥还～。","book":"柏杨《抄风与套风》"},"usage":"作谓语、定语；用于处事"},{"id":7465,"word":"兴邦立事","pinyin":"xīng bāng lì shì","abbr":"xbls","explanation":"邦：国家。振兴国家，成就事业。","source":{"text":"寻章摘句，世之腐儒也，何能兴邦立事？","book":"明·罗贯中《三国演义》第四十三回"}},{"id":7466,"word":"兴邦立国","pinyin":"xīng bāng lì guó","abbr":"xblg","explanation":"邦：国家。建立并振兴国家。","source":{"text":"安排打凤牢龙计，准备兴邦立国机。","book":"元·无名氏《黄鹤楼》第三折"},"usage":"作宾语、定语；用于书面语"},{"id":7467,"word":"兴风作浪","pinyin":"xīng fēng zuò làng","abbr":"xfzl","explanation":"兴、作：引起。原指神话小说中妖魔鬼怪施展法术掀起风浪。后多比喻煽动情绪，挑起事端。","source":{"text":"嘉州有冷，源二河，河内有一健蛟，兴风作浪，损害人民。","book":"元·无名氏《锁魔镜》第一折"},"example":{"text":"头两天见姊夫同前任不对，他便于中～，挑剔前任的帐房。","book":"清·李宝嘉《官场现形记》第四十一回"},"similar":["无事生非","惹是生非"],"opposite":["风平浪静","相安无事","息事宁人"],"usage":"作谓语、定语、宾语；指挑起事端"},{"id":7468,"word":"兴高彩烈","pinyin":"xìng gāo cǎi liè","abbr":"xgcl","explanation":"兴：兴致；烈：强烈，旺盛。兴致高，精神饱满","source":{"text":"这里的黄脸干儿们，也听得兴高彩烈。","book":"鲁迅《准风月谈·华德焚书异同论》"},"similar":["兴高采烈"],"usage":"作定语、状语；指人高兴"},{"id":7469,"word":"兴高采烈","pinyin":"xìng gāo cǎi liè","abbr":"xgcl","explanation":"兴：原指志趣，后指兴致；采：原指神采，后指精神；烈：旺盛。原指文章志趣高尚，言词犀利。后多形容兴致高，精神饱满。","source":{"text":"步夜俊侠，故兴高而采烈。","book":"南朝梁·刘勰《文心雕龙·体性》"},"example":{"text":"阿二忽然对于曾沧海的威吓全没怕惧，反而～的说起来了。","book":"茅盾《子夜》四"},"similar":["欢天喜地","喜气洋洋"],"opposite":["无精打采","闷闷不乐"],"usage":"作谓语、定语、状语；指人高兴","story":["魏晋时期，“竹林七贤”之一的嵇康风度翩翩，文才超群。他在《养生论》中主张“清虚静泰，少私寡欲。”批判当时的纵欲生活和长寿的贪婪心态。南朝梁著名的文学批判家刘勰在《文心雕龙》评论他“叔夜俊侠，故兴高而采烈。”"]},{"id":7470,"word":"兵上神密","pinyin":"bīng shàng shén mì","abbr":"bssm","explanation":"上：通“尚”，贵。用兵贵在神密。","source":{"text":"兵事上神密，将军何不从此右去，走蓝田，出武关，抵雒阳。","book":"《汉书·周勃传》"}},{"id":7471,"word":"兵不厌权","pinyin":"bīng bù yàn quán","abbr":"bbyq","explanation":"作战时尽可能地用假象迷惑敌人以取得胜利。同“兵不厌诈”。","source":{"text":"今其众新盛，难与争锋，兵不厌权，愿宽假辔策，勿令有所拘阂而已。","book":"《后汉书·虞诩传》"},"similar":["兵不厌诈"],"opposite":["先礼后兵"],"usage":"作主语、宾语；用于采用迷惑敌人的方法作战"},{"id":7472,"word":"兵不厌诈","pinyin":"bīng bù yàn zhà","abbr":"bbyz","explanation":"厌：嫌恶；诈：欺骗。作战时尽可能地用假象迷惑敌人以取得胜利。","source":{"text":"臣闻之，繁礼君子，不厌忠信；战阵之间，不厌诈伪。","book":"《韩非子·难一》"},"example":{"text":"若说～，诸葛亦无如此之阵图，若说幻不厌深，偃师亦无如此之机械。","book":"元·王实甫《西厢记》第三本第二折金圣叹批"},"similar":["兵不厌权"],"opposite":["先礼后兵"],"usage":"作主语、宾语；用于采用迷惑敌人的方法作战","story":["东汉安帝时，羌族在汉边境骚乱，包围武都郡。安帝派虞诩去做武都郡太守，虞诩带精兵去赴任，途中他用增灶、弱弓硬弩的办法，用计打败了羌族的进攻，让武都郡恢复了安定"]},{"id":7473,"word":"兵不接刃","pinyin":"bīng bù jiē rèn","abbr":"bbjr","explanation":"作战时兵器没接触。指战事顺利，未经交锋或激战而取得胜利。","source":{"text":"兵不接刃，而民服若化。","book":"《吕氏春秋·怀宠》"},"similar":["兵不血刃","兵不污刃"],"opposite":["血流成河"],"usage":"作定语、状语；形容未经交战就取得胜利"},{"id":7474,"word":"兵不污刃","pinyin":"bīng bù wū rèn","abbr":"bbwr","explanation":"犹兵不血刃。形容未经战斗就轻易取得了胜利。","source":{"text":"威德所加，兵不污刃，收魏博等六州。","book":"唐·韩愈《论捕贼行赏表》"},"similar":["兵不血刃","兵不接刃"],"opposite":["血流成河"],"usage":"作定语、状语；形容未经交战就取得胜利"},{"id":7475,"word":"兵不由将","pinyin":"bīng bù yóu jiàng","abbr":"bbyj","explanation":"比喻下级不服从上级的指挥。","source":{"text":"燕王战急了，因又挥剑，仰天大叫：‘鬼神助我！’叫声未绝，忽东北风大起，卷得尘埃障天，沙砾满面……燕兵知是天助，乘风大呼纵击。南兵乱慌慌，只觉风声皆兵，哪里还敢恋战。遂兵不由将，将不顾兵，各各奔溃。","book":"明·徐渭《续英烈传》第二十二回"},"example":{"text":"这个单位出现～的混乱局面。"},"usage":"作宾语、定语；用于上下级关系"},{"id":7476,"word":"兵不血刃","pinyin":"bīng bù xuè rèn","abbr":"bbxr","explanation":"兵：武器；刃：刀剑等的锋利部分。兵器上没有沾上血。形容未经战斗就轻易取得了胜利。","source":{"text":"故近者亲其善，远方慕其德，兵不血刃，远迩来服。","book":"《荀子·议兵》"},"example":{"text":"～，就平了广西省多年的乱党。","book":"清·张春帆《宦海》第七回"},"similar":["不战而胜","所向披靡"],"opposite":["血流成河","血流飘杵"],"usage":"作定语、状语；形容未经交战就取得胜利","story":["东晋时期，屯骑校尉郭默英勇善战，但他十分骄横跋扈，为泄私愤杀死平南将军刘胤，伪造诏书诬陷刘胤谋反，宰相王导怕他，升他为州官。陶侃说服王导率兵讨伐，郭默自知理亏，想率军南下，被部将生擒投降，陶侃兵不血刃完成使命"]},{"id":7477,"word":"兵不逼好","pinyin":"bīng bù bī hǎo","abbr":"bbbh","explanation":"兵：指出兵作战；逼：威胁；好：指友好的国家。不出兵威胁友好的国家。","source":{"text":"俘不干盟，兵不逼好。","book":"《孔子家语·相鲁》"},"usage":"作宾语、定语；用于劝谏不要战争"},{"id":7478,"word":"兵不雪刃","pinyin":"bīng bù xuě rèn","abbr":"bbxr","explanation":"兵器上没有沾上血。形容未经战斗就轻易取得了胜利。","source":{"text":"故近者亲其善，远方慕其德，兵不血刃，远迩来服。","book":"《荀子·议兵》"}},{"id":7479,"word":"兵临城下","pinyin":"bīng lín chéng xià","abbr":"blcx","explanation":"敌军已来到自己的城墙下面。比喻情势十分危急。","source":{"text":"齐必举兵伐梁，梁、齐之兵连于城下不能去，王以其间伐韩。","book":"《战国策·齐策二》"},"example":{"text":"若侯～，将至壕边，然后拒敌，事已迟矣。","book":"明·罗贯中《三国演义》第三十一回"},"similar":["十万火急","燃眉之急"],"opposite":["安如泰山","安然无恙","高枕无忧"],"usage":"作谓语、宾语、分句；形容形势十分危险紧要"},{"id":7480,"word":"兵为邦捍","pinyin":"bīng wéi bāng hàn","abbr":"bwbh","explanation":"兵：军队；邦：国家；捍：捍卫。军队是国家的保障。","source":{"text":"兵为邦捍，国家之威望，将吏之用权，民间之保护，皆借于兵。","book":"清·刘亚《将略要论》"}},{"id":7481,"word":"兵以诈立","pinyin":"bīng yǐ zhà lì","abbr":"byzl","explanation":"兵：兵器，指用兵。用兵打仗要用谋略来诱骗敌人而取得成功。","source":{"text":"故兵以诈立，以利动，以分合为变者也。","book":"《孙子·军争篇》"},"similar":["兵不厌诈"],"usage":"作宾语、定语；指用兵策略"},{"id":7482,"word":"兵凶战危","pinyin":"bīng xiōng zhàn wēi","abbr":"bxzw","explanation":"指战事凶险可怕。","source":{"text":"虽然，兵，凶器；战，危事也。故以大为小，以彊为弱，在俛卬之间耳。","book":"汉·晁错《言兵事疏》"},"example":{"text":"当此～之秋，所有受伤军兵，颠卧战线，咻噢呻吟，惨不忍觏。","book":"郭孝成《民国各团体之组织》"},"usage":"作宾语、定语；指战争可怕"},{"id":7483,"word":"兵出无名","pinyin":"bīng chū wú míng","abbr":"bcwm","explanation":"出兵没有正当理由。亦泛指行事无正当理由。同“师出无名”","source":{"text":"兵出无名，事故不成。","book":"《汉书·高帝纪》"},"example":{"text":"昔赤眉、黄巾横逆宇宙，所以一旦败亡者，正以～，聚而为乱。","book":"《晋书·石勒传》"},"similar":["师出无名"],"opposite":["师出有名"],"usage":"作主语、宾语；指出兵"},{"id":7484,"word":"兵刃相接","pinyin":"bīng rèn xiāng jiē","abbr":"brxj","explanation":"刀枪武器互相接触。指白刃战。","source":{"text":"臣所止，惧兵刃相接。","book":"《孟子·梁惠王上》：“填然鼓之，兵刃既接，弃甲曳兵而走。”《三国志·魏志·高贵乡公传》"}},{"id":7485,"word":"兵勇将猛","pinyin":"bīng yǒng jiàng měng","abbr":"byjm","explanation":"士兵勇敢，将帅勇猛。形容战斗力很强。","source":{"text":"诉说宋江等兵勇将猛，折了五将，全军覆没，特来恳告元帅，借兵报仇。","book":"明·施耐庵《水浒传》第106回"},"usage":"作谓语、定语；多用于战争等"},{"id":7486,"word":"兵在其颈","pinyin":"bīng zài qí jǐng","abbr":"bzqj","explanation":"刀架在脖子上。比喻危险已非常逼近。","source":{"text":"兵在其颈，其隙至之谓乎。","book":"《国语·周语中》"},"similar":["兵已在颈"],"usage":"作定语、状语；指危险迫在眉睫"},{"id":7487,"word":"兵在精而不在多","pinyin":"bīng zài jīng ér bù zài duō","abbr":"bzjebzd","explanation":"兵士在于精壮而不在乎众多。也比喻要求质量而不能只讲数量。","source":{"text":"凡兵在乎精，不在乎多。","book":"《五代史平话·周史》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“抚台还跟我谈起，～，又说欲善其事，先利其器。”"},"similar":["将在谋而不在勇"],"usage":"作宾语、分句、定语；指用兵"},{"id":7488,"word":"兵多将广","pinyin":"bīng duō jiàng guǎng","abbr":"bdjg","explanation":"兵将众多。形容军队人员多，兵力强大。","source":{"text":"凭着俺这里兵多将广马壮人强，量吴国姬光到的那里，就怕着他哩？","book":"元·郑廷玉《楚昭公》第一折"},"example":{"text":"小人觑探梁山泊～，武艺高强，不可轻敌小觑。","book":"明·施耐庵《水浒全传》第五十四回"},"similar":["人多势众"],"opposite":["兵微将寡"],"usage":"作宾语、定语；指兵力强大"},{"id":7489,"word":"兵多者败","pinyin":"bīng duō zhě bài","abbr":"bdzb","explanation":"指兵卒过多的军队，常常会吃败仗，因为兵将各有所恃，号令不齐。","source":{"text":"古来用兵，往往兵多者败，盖兵过多则号令不齐，气势不贯，必不能有臂指相使之用。","book":"清·赵翼《陔馀丛考》"},"usage":"作宾语、定语；用于军事"},{"id":7490,"word":"兵已在颈","pinyin":"bīng yǐ zài jǐng","abbr":"byzj","explanation":"颈：颈项。刀已架在脖子上。比喻危险已非常逼近。","source":{"text":"夷吾曰：‘此辈兵已在颈，尚欲累人耶？’","book":"明·冯梦龙《东周列国志》第15回"},"similar":["兵在其颈"],"usage":"作定语、状语；指危险迫在眉睫"},{"id":7491,"word":"兵强则灭","pinyin":"bīng qiáng zé miè","abbr":"bqzm","explanation":"指依恃军队强盛则毁灭。","source":{"text":"老聃曰：‘兵强则灭，木强则折。’”按今本《老子》作“兵强则不胜，木强则兵。","book":"《列子·黄帝》"},"example":{"text":"故～，木强则折。","book":"《淮南子·原道训》"},"usage":"作宾语、定语；指不能用兵"},{"id":7492,"word":"兵强将勇","pinyin":"bīng qiáng àng yǒng","abbr":"bqjy","explanation":"兵力强盛，将领勇猛。形容军力强大。","source":{"text":"宋江等将勇兵强，打破了宛州、山南两座城池。","book":"明·施耐庵《水浒全传》第一百七回"},"example":{"text":"清·钱彩《说岳全传》第13回：“臣李纲启奏陛下，王善～，久蓄异心。”"},"similar":["兵强将猛"],"usage":"作谓语、宾语；用于战争"},{"id":7493,"word":"兵强将猛","pinyin":"bīng qiáng jiàng měng","abbr":"bqjm","explanation":"兵力强盛，将领勇猛。形容军力强大。","source":{"text":"对众商议，一面差人往威胜晋王处，说宋江等兵强将猛，难以抵敌，乞添差良将镇守，庶保无虞。","book":"明·施耐庵《水浒传》第94回"},"similar":["兵强将勇"],"usage":"作谓语、宾语；用于战争"},{"id":7494,"word":"兵强马壮","pinyin":"bīng qiáng mǎ zhuàng","abbr":"bqmz","explanation":"兵力强盛，战马健壮。形容军队实力强，富有战斗力。","source":{"text":"尝谓人曰：‘天子宁有种耶？兵强马壮者为之尔。’","book":"《新五代史·安重荣传》"},"example":{"text":"时孔明～，粮草丰足，所用之物，一切完备，正要出师。","book":"明·罗贯中《三国演义》第九十七回"},"similar":["所向披靡","战无不胜","举世无双"],"opposite":["势单力薄","手无寸铁","赤手空拳"],"usage":"作谓语、定语；形容军队等","story":["安重荣的父亲是后唐振武巡边指挥使，石敬瑭起兵太原，派副将张颖潜入振武，请安重荣举兵协助。安重荣投奔石敬瑭，由于石敬瑭成为契丹的儿皇帝，安重荣得到吐蕃兵强马壮的支持，自立为王，率军进攻汴京，被晋军所杀"]},{"id":7495,"word":"兵微将寡","pinyin":"bīng wēi jiàng guǎ","abbr":"bwjg","explanation":"微、寡：少。兵少将也不多。形容力量薄弱。","source":{"text":"奈备兵微将寡，壕浅城低，有倒悬之急，累卵之危。","book":"《三国志平话·张飞三出小沛》"},"example":{"text":"量王世充～，俺元帅兵多将广，人强马壮。","book":"明·无名氏《四马投唐》楔子"},"similar":["将寡兵微"],"opposite":["兵多将广"],"usage":"作宾语、定语；指力量薄弱"},{"id":7496,"word":"兵慌马乱","pinyin":"bīng huāng mǎ luàn","abbr":"bhml","explanation":"形容战争期间社会混乱不安的景象。","source":{"text":"乱纷纷东逃西窜，闹烘烘兵慌马乱，一路奔回气尚喘。","book":"明·陆华甫《双凤记》第二一折"},"example":{"text":"他的铺伙既没有犯任何的规矩，又赶上这～理应共患难的时候，他凭什么无缘无故的辞退人家呢？","book":"老舍《四世同堂》三八"},"similar":["兵荒马乱"],"opposite":["国泰民安"],"usage":"作谓语、定语、状语；形容战争时期的动荡"},{"id":7497,"word":"兵戈扰攘","pinyin":"bīng gē rǎo rǎng","abbr":"bgrr","explanation":"兵戈：武器，指战争；扰攘：纷乱。形容战争时期社会秩序的动荡混乱。","source":{"text":"遭扰攘之时，值兵革之际。","book":"《后汉书·冯衍传下》"},"example":{"text":"那老母原是～中看见杀儿掠女，掠坏了再苏的。","book":"明·凌濛初《初刻拍案惊奇》卷二十二"},"similar":["兵戈抢攘"],"usage":"作宾语、定语；指社会动荡"},{"id":7498,"word":"兵戈抢攘","pinyin":"bīng gē qiǎng rǎng","abbr":"bgqr","explanation":"兵戈：武器，指战争；抢攘：纷乱。形容战争时期社会动荡混乱。","source":{"text":"时兵戈抢攘，道路不通，奴甲受命，毅然策孤骑。","book":"《金史·粘葛奴甲传》"},"similar":["兵戈扰攘"],"usage":"作宾语、定语；指社会动荡"},{"id":7499,"word":"兵戎相见","pinyin":"bīng róng xiāng jiàn","abbr":"brxj","explanation":"兵戎：武器。以武力相见。指用战争解决问题。","source":{"text":"从至正十六年起，张士诚和朱元璋兵戎相见，大小数百战，互有胜负。","book":"吴晗《朱元璋传》第三章"},"example":{"text":"后来竟以～，大战于百灵庙。","book":"冯玉祥《我的生活》第15章"},"similar":["刀兵相见"],"usage":"作谓语、宾语；形容发生冲突"},{"id":7500,"word":"兵拏祸结","pinyin":"bīng ná huò jié","abbr":"bnhj","explanation":"战争、灾祸连续不断。同“兵连祸结”。","source":{"text":"今遣使乃启衅之端，万一敌骑犯边，则民力困于供输，州郡疲于调发，兵拏祸结，未有息期。","book":"《宋史·陈良祐传》"}}]
