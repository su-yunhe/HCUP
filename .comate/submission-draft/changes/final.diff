+[{"id":12501,"word":"因粮于敌","pinyin":"yīn liáng yú dí","abbr":"ylyd","explanation":"因：凭借。从敌人处取得粮草。","source":{"text":"善用兵者，役不再籍，粮不三载，取用于国，因粮于敌，故军食可足也。","book":"《孙子·作战篇》"},"example":{"text":"三善以二万人破贼十万，有轻敌心，欲～。","book":"《明史·王三善传》"}},{"id":12502,"word":"因缘为市","pinyin":"yīn yuán wéi shì","abbr":"yyws","explanation":"旧指官吏借不公正的判决，收受贿赂。","source":{"text":"奸吏因缘为市，所欲活则傅生议，所欲死则予死比。","book":"东汉·班固《汉书·刑法志》"},"example":{"text":"或一事殊法，同罪异论，奸吏得～。","book":"南朝·宋·范晔《后汉书·桓谭冯衍传》"},"usage":"作谓语；形容官吏贪赃枉法"},{"id":12503,"word":"因袭陈规","pinyin":"yīn xí chén guī","abbr":"yxcg","explanation":"沿用老规章。因袭：继续使用。陈规：过时了的规章制度。","example":{"text":"～的做法行不通了。"},"similar":["墨守成规"],"opposite":["推陈出新"],"usage":"作谓语、定语；指不知变通"},{"id":12504,"word":"因败为成","pinyin":"yīn bài wéi chéng","abbr":"ybwc","explanation":"因：依据。顺着失败来做成功的事情。指在失利的情况下，考虑到于己有利的方面，转败为胜。","source":{"text":"闻因败为成，臂上金疮，得非金印之征也。","book":"《宋书·王玄谟传》"},"example":{"text":"昔曹沫三败而收功于柯盟，冯异垂翅而奋翼于渑池，皆能～，以功补过。","book":"蔡东藩《两晋演义》第二十六回"}},{"id":12505,"word":"因陃就寡","pinyin":"yīn lòu jiù guǎ","abbr":"ybjg","explanation":"因：因袭；陋：简陋；就：将就；寡：少。原意是因循原来的的简陋，不求改进。后指就着原来简陋的条件办事。","source":{"text":"苟因陋就寡，分文析字。烦言碎辞，学者罢老且不能究其一艺。","book":"汉·刘歆《移书让太常博士》"}},{"id":12506,"word":"因陋守旧","pinyin":"yīn lòu shǒu jiù","abbr":"ylsj","explanation":"陋：不合理；守旧：保持旧的。指因袭不合理的老一套而不加改进。","source":{"text":"宋兴且百年，而文章体裁，犹仍五季余习……士因陋守旧，论卑气弱。","book":"《宋史·欧阳修传》"},"usage":"作谓语、定语；指不会变通"},{"id":12507,"word":"因陋就寡","pinyin":"yīn lòu jiù guǎ","abbr":"yljg","explanation":"指满足于简陋苟且，不求改进。","source":{"text":"苟因陋就寡，分文析字。烦言碎辞，学者罢老且不能究其一艺。","book":"汉·刘歆《移书让太常博士》"},"example":{"text":"清·顾炎武《日知录·拟题》：“披庄不过盈尺，～，赴速邀时。”"},"similar":["因陋就简"],"usage":"作谓语、状语、定语；用于处事"},{"id":12508,"word":"因陋就简","pinyin":"yīn lòu jiù jiǎn","abbr":"yljj","explanation":"因：因袭；陋：简陋；就：将就。原意是因循原来的的简陋，不求改进。后指就着原来简陋的条件办事。","source":{"text":"苟因陋就寡，分文析字。烦言碎辞，学者罢老且不能究其一艺。","book":"汉·刘歆《移书让太常博士》"},"example":{"text":"～，由当时之国会制定之。","book":"清·梁启超《专设宪法案起草机关议》"},"similar":["滥竽充数"],"opposite":["富丽堂皇"],"usage":"作谓语、定语、状语、宾语；指将就"},{"id":12509,"word":"因陋就隘","pinyin":"yīn lòu jiù ài","abbr":"ylja","explanation":"因：因袭；陋：简陋；就：将就。原意是因循原来的的简陋，不求改进。后指就着原来简陋的条件办事。","source":{"text":"苟因陋就寡，分文析字。烦言碎辞，学者罢老且不能究其一艺。","book":"汉·刘歆《移书让太常博士》"}},{"id":12510,"word":"因隙间亲","pinyin":"yīn xì jiàn qīn","abbr":"yxjq","explanation":"因：利用；间：离间。利用对方之间的矛盾，离间其亲密关系。","source":{"text":"因隙间亲，因佞间忠，因利间争，因疑间废。","book":"明·西湖逸士《投笔肤谈》"}},{"id":12511,"word":"因难见巧","pinyin":"yīn nán jiàn qiǎo","abbr":"ynjq","explanation":"因：由于；巧：巧妙。由于难而更显出技艺的巧妙。","source":{"text":"得韵窄，则不复旁出，而因难见巧，愈险愈奇。","book":"宋·欧阳修《六一诗话》"},"example":{"text":"而其中得失醇疵，毫不能揜，则又有～者。","book":"清·李保泰《瓯北诗钞序》"},"usage":"作谓语、定语；指人如何出来困难"},{"id":12512,"word":"因风吹火","pinyin":"yīn fēng chuī huǒ","abbr":"yfch","explanation":"因：顺着。顺着风势吹火，比喻乘便行事，并不费力。常用作谦词。","source":{"text":"因风吹火，用力不多。","book":"宋·释道原《景德传灯录》卷十三"},"example":{"text":"十娘钟情所欢，不以贫窭易心，此乃女中豪杰。仆～，谅区区何足挂齿。","book":"明·冯梦龙《警世通言》卷三十二"},"similar":["顺水推舟"],"usage":"作谓语、定语；指趁机行事"},{"id":12513,"word":"团团转","pinyin":"tuán tuán zhuàn","abbr":"ttz","explanation":"回环旋转，形容不知道怎么办好。","source":{"text":"于是我急得在房中团团转：出去呢？不出去呢？换衣服呢？还是不换？","book":"苏青《结婚十年》第四章"},"example":{"text":"王朔《过把瘾就死》：“她头也不抬，用筷子搅着在锅里～的面条。”"},"usage":"作状语；用于口语"},{"id":12514,"word":"团头聚面","pinyin":"tuàn tóu jù miàn","abbr":"ttjm","explanation":"形容非常亲密地相聚在一起。","source":{"text":"合家俱到那园中石凳上坐下……团头聚面的说说笑笑，或是与儿子讲说些读过的书文，或是与女儿说些什么贤孝的古记。","book":"《醒世姻缘传》第二四回"},"usage":"作定语、状语；指团聚"},{"id":12515,"word":"团结一致","pinyin":"tuán jié yī zhì","abbr":"tjyz","explanation":"保持一致，行动起来像一个人，指站在一起并且互相支持。","source":{"text":"因为只有如此，才能根据民族矛盾和国内矛盾在政治比重上的变化而改变国内两个政权敌对的状态，团结一致，共同赴敌。","book":"毛泽东《中国共产党在抗日时期的任务》"},"example":{"text":"我们～、共同进退。"},"similar":["齐心协力"],"opposite":["一盘散沙"],"usage":"作谓语、定语；用于集体"},{"id":12516,"word":"团花簇锦","pinyin":"tuán huā cù jǐn","abbr":"thcj","explanation":"形容五彩缤纷，十分华丽。同“花团锦簇”。","source":{"text":"当时围场三骑马，团花簇锦的斗了四十余合，不分胜负。","book":"清·俞万春《荡寇志》第一百三十回"},"example":{"text":"在圣马克方场的钟楼上看，～似的东一块西一块在绿波里荡漾着。","book":"朱自清《威尼斯》"}},{"id":12517,"word":"囤积居奇","pinyin":"tún jī jū qí","abbr":"tjjq","explanation":"囤、居：积聚；奇：稀少的物品。把稀少的货物储藏起来。指商人囤积大量商品，等待高价出卖，牟取暴利。","source":{"text":"头脑灵敏点的或者更贪心的老爷们还要干点囤积居奇的生意。","book":"巴金《读》"},"example":{"text":"不准高抬物价，不准～。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["奇货可居","投机倒把"],"usage":"作谓语、定语；用于商人等"},{"id":12518,"word":"囫囵半片","pinyin":"hú lún bàn piàn","abbr":"hlbp","explanation":"囫囵：完整的，整个儿的。一个整体中的一部分。指只听懂或理解了其中的大概意思。","source":{"text":"（邢连成）这才囫囵半片地听出点意思。","book":"《千重浪》第十章》"},"usage":"作定语、状语；指印象模糊"},{"id":12519,"word":"囫囵吞枣","pinyin":"hú lún tūn zǎo","abbr":"hltz","explanation":"囫囵：整个儿。把枣整个咽下去，不加咀嚼，不辨滋味。比喻对事物不加分析思考。","source":{"text":"若是知有底人，细嚼来咽；若是不知有底人，一似浑仑吞个枣。","book":"宋·圆悟禅师《碧岩录》卷三"},"example":{"text":"一个高中文科的学生，与其～或走马看花地读十部诗集，不如仔仔细细地背诵三百首诗。","book":"朱自清《论诗学门径》"},"similar":["不求甚解","生吞活剥"],"opposite":["含英咀华","细嚼慢咽","融会贯通"],"usage":"作谓语、宾语、状语；形容读书不认真","story":["从前一个自作聪明的人，听说人们吃梨子对牙好但伤脾，吃枣子却刚好相反。他想了很久终于想出一个两全其美的办法，就是吃梨只嚼不咽，吃枣只吞不嚼，这样就不会伤牙与伤脾了，人家笑他是囫囵吞枣"]},{"id":12520,"word":"困兽犹斗","pinyin":"kùn shòu yóu dòu","abbr":"ksyd","explanation":"被围困的野兽还要作最后挣扎。比喻在绝境中还要挣扎抵抗。","source":{"text":"困兽犹斗，况人呼？","book":"《左传·定公四年》"},"example":{"text":"况～，背城一战，尚有不可测之事乎？","book":"明·冯梦龙《东周列国志》第七十九"},"similar":["铤而走险","狗急跳墙"],"opposite":["放下屠刀","自行灭亡"],"usage":"作谓语、宾语、分句；指在绝境中挣扎","story":["春秋时期，晋国与楚国为了争夺霸主地位经常发动战争，一次晋军大败，大将荀林父回国向晋景公请罪，晋景公同意处死荀林父，大夫士会反对处死他，说当年楚国令尹得臣虽败，但困兽犹斗，晋国没得到利益。如今处死他只会助长楚国士气"]},{"id":12521,"word":"困勉下学","pinyin":"kùn miǎn xià xué","abbr":"kmxx","explanation":"指克服困难才能求得知识。","source":{"text":"虽生知安行之圣，不废困勉下学之功也。","book":"清·郑燮《潍县署中寄舍弟墨第一书》"},"similar":["困知勉行"],"usage":"作谓语、宾语；克服困难中求得知识"},{"id":12522,"word":"困心横虑","pinyin":"kùn xīn héng lǜ","abbr":"kxhl","explanation":"心意困苦，忧虑满胸。表示费尽心力。","source":{"text":"事势穷蹙，以至困于心，横于虑，然后能奋发而兴起。","book":"先秦·孟轲《孟子·告子下》：“困于心，衡于虑，而后作。” 朱熹集注"},"similar":["困心衡虑"],"usage":"作谓语；表示费尽心力"},{"id":12523,"word":"困心衡虑","pinyin":"kùn xīn héng lǜ","abbr":"kxhl","explanation":"困：忧；衡：横。心意困苦，思虑阻塞。表示费尽心力，经过艰苦的思考。","source":{"text":"困于心，衡于虑，而后作。","book":"《孟子·告子下》"},"example":{"text":"有～，仅脱于震凌者矣。","book":"明·宋濂《环翠亭记》"},"similar":["困心横虑"],"usage":"作谓语；表示费尽心力"},{"id":12524,"word":"困知勉行","pinyin":"kùn zhī miǎn xíng","abbr":"kzmx","explanation":"困知：遇困而求知；勉行：尽力实行。在不断克服困难中求得知识，有了知识就勉力实行。","source":{"text":"或生而知之，或学而知之，或困而知之，及其知之一也。或安而行之，或利而行之，或勉强而行之，及其成功一也。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"观其～，厉志克己之功何如？","book":"梁启超《新民说·论自由》"},"similar":["困勉下学"],"usage":"作谓语、宾语；克服困难中求得知识"},{"id":12525,"word":"困而不学","pinyin":"kùn ér bù xué","abbr":"kebx","explanation":"困：困惑，不明白。困惑不明白却不肯学习。","source":{"text":"生而知之者，上也；学而知之者，次也；困而学之，又其次也；困而不学，民斯为下矣。","book":"《论语·季氏》"},"example":{"text":"～，终于不知，斯为下尔。","book":"清·王夫之《读四书大全说》第七卷"},"opposite":["困而学之"],"usage":"作谓语；指遇到困难却不肯学习","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，孔子教育弟子：做君子要坚持学习，困而学之就会成为圣贤，困而不学那就没希望了。重新振奋弟子们的士气"]},{"id":12526,"word":"困而学之","pinyin":"kùn ér xué zhī","abbr":"kexz","explanation":"困：困惑。遇到困惑的时候就学习。","source":{"text":"生而知之者，上也；学而知之者，次也；困而学之，又其次也；困而不学，民斯为下矣。","book":"《论语·季氏》"},"opposite":["困而不学"],"usage":"作谓语、定语；用于学习等","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，孔子教育弟子：做君子要坚持学习，困而学之就会成为圣贤，困而不学那就没希望了。重新振奋弟子们的士气"]},{"id":12527,"word":"围城打援","pinyin":"wéi chéng dǎ yuán","abbr":"wcdy","explanation":"军事术语，进攻的一方以部分兵力包围守城之敌，诱使敌人派兵援救，然后以主力部队歼灭敌人的援军。","source":{"text":"‘围城打援’的办法，不是常使用吗？","book":"杜鹏程《保卫延安》第五章"},"example":{"text":"只有在‘～’的方针下，目的不在打围敌，而在打援敌。","book":"毛泽东《中国革命战争的战略问题》第五章第八节"},"usage":"作谓语、定语；用于军事方面"},{"id":12528,"word":"围点打援","pinyin":"wéi diǎn dǎ yuán","abbr":"wddy","explanation":"一种战术，抽出部分兵力围困据点，然后使用主力部队打击救援据点的援军。","example":{"text":"我们要采取～的策略。"},"similar":["围城打援"],"usage":"作宾语、定语；用于军事"},{"id":12529,"word":"围追堵截","pinyin":"wéi zhuī dǔ jié","abbr":"wzdj","explanation":"把军队分成几路同时进行包围式的追击，将敌人堵截成几块，加以消灭。","source":{"text":"天上每日几十架飞机侦察轰炸，地下几十万大军围追堵截，路上遇着了说不尽的艰难险阻。","book":"毛泽东《论反对日本帝国主义的策略》"},"example":{"text":"红军躲过国民党军队的～进行二万五千里长征。"},"usage":"作宾语、定语；指四种战术"},{"id":12530,"word":"围魏救赵","pinyin":"wéi wèi jiù zhào","abbr":"wwjz","explanation":"原指战国时齐军用围攻魏国的方法，迫使魏国撤回攻赵部队而使赵国得救。后指袭击敌人后方的据点以迫使进攻之敌撤退的战术。","source":{"text":"《史记·孙子吴起列传》"},"example":{"text":"倘用～之计，且不来解此处之危，反去取我梁山大寨，如之奈何！","book":"明·施耐庵《水浒全传》第六十四回"},"similar":["声东击西"],"opposite":["围城打援"],"usage":"作谓语、宾语、定语；用于军事","story":["战国时期，魏惠王派大将庞涓进攻赵国，围住赵都城邯郸。赵成侯知道难以抵挡，就把中山献给齐国。齐王派大将田忌、军师孙膑兴兵救赵。孙膑扬言要进攻魏国襄陵，庞涓中计回兵救襄陵中了孙膑的伏击，解了赵国之危"]},{"id":12531,"word":"囹圄充积","pinyin":"líng yǔ chōng jī","abbr":"lycj","explanation":"囹圄：监狱。形容罪犯很多。","source":{"text":"虽复厉以重劝，肃以严威，适足令囹圄充积，而无救于事实也。","book":"《宋书·王弘传》"}},{"id":12532,"word":"囹圄生草","pinyin":"líng yǔ shēng cǎo","abbr":"lysc","explanation":"囹圄：监狱。监狱里长出野草。形容社会安定，政治清明时，犯罪的人很少。","source":{"text":"故善为政者，田畴垦而国邑实，朝廷闲而官府治，公法行而么曲止，仓廪食而囹圄空。","book":"《管子·五铺》"},"example":{"text":"狱中无系囚，～。","book":"《隋书·刘广传》"}},{"id":12533,"word":"囹圄空虚","pinyin":"líng yǔ kōng xū","abbr":"lykx","explanation":"囹圄：监狱。监狱里没有在押的犯人。形容社会安定，政治清明时，犯罪的人很少。","source":{"text":"故善为政者，田畴垦而国邑实，朝廷闲而官府治，公法行而么曲止，仓廪食而囹圄空。","book":"《管子·五铺》"},"example":{"text":"家给人足，蓄积有余，～。","book":"汉·东方朔《非有先生论》"}},{"id":12534,"word":"固不可彻","pinyin":"gù bù kě chè","abbr":"gbkc","explanation":"固：固执；彻：透彻，明白。非常固执，无法说服。","source":{"text":"汝心之固，固不可彻。","book":"《列子·汤问》"}},{"id":12535,"word":"固壁清野","pinyin":"gù bì qīng yě","abbr":"gbqy","explanation":"固壁，指加固壁垒，使敌不易攻击；清野，指转移人口、物资，使敌无所获取。这是对付优势入侵敌人的一种策略。","source":{"text":"社客（崔社客）宿将多谋，诸葛亮城各自保，固壁清野。","book":"《北齐书·李浑传》"},"similar":["坚壁清野"],"usage":"作谓语、定语、分句；用于军事方面"},{"id":12536,"word":"固守成规","pinyin":"gù shǒu chéng guī","abbr":"gscg","explanation":"成规：现成的规矩、制度。指思想固执保守，守着老规矩不放，不思改革进取。","source":{"text":"我们过去固守成规，关起门来搞建设，搞了好多年，导致的结果不好。","book":"邓小平《社会主义必须摆脱贫穷》"},"similar":["墨守成规"],"usage":"作谓语、定语、宾语；指思想固执保守"},{"id":12537,"word":"固执不通","pinyin":"gù zhí bù tōng","abbr":"gzbt","explanation":"固：顽固；执：坚持。顽固地坚持自己的意见，不肯变通。","source":{"text":"偏偏室里坐的恰又是那个固执不通的吴翘胡子。","book":"李脃人《暴风雨前》第三部分"},"example":{"text":"船夫是一个～的老头。"},"similar":["固执己见"],"usage":"作谓语、定语；指坚持自己的意见"},{"id":12538,"word":"固执己见","pinyin":"gù zhí jǐ jiàn","abbr":"gzjj","explanation":"顽固地坚持自己的意见，不肯改变。","source":{"text":"固执己见，动失人心。","book":"《旧唐书·李纲传》：“时左仆射杨素、苏威当朝，纲每固执所见，不与之同，由是二人深恶之。”《宋史·陈宓传》"},"example":{"text":"冯贵堂听父亲不赞成他的主张，他想到：“人，一上了年纪，就爱～，偏重保守了！”","book":"梁斌《红旗谱》八"},"similar":["一意孤行","自以为是","刚愎自用"],"opposite":["谦虚谨慎","不露圭角","虚怀若谷"],"usage":"作谓语、定语；指坚持自己的意见"},{"id":12539,"word":"固执成见","pinyin":"gù zhí chéng jiàn","abbr":"gzcj","explanation":"顽固地坚持自己的意见，不肯改变。同“固执己见”。","source":{"text":"如果荪甫一定要固执成见，那就拉倒。","book":"茅盾《子夜》九"},"example":{"text":"我们要用发展的眼光看问题，不能～"},"similar":["固执己见"],"usage":"作谓语、宾语、定语；用于处事"},{"id":12540,"word":"固步自封","pinyin":"gù bù zì fēng","abbr":"gbzf","explanation":"比喻守着老一套，不求进步。","source":{"text":"昔有学步于邯郸者，曾未得其仿佛，又复失其故步，遂匍匐而归耳。","book":"《汉书·叙传上》"},"example":{"text":"在成绩面前，我们不能骄傲自满，～。"},"similar":["墨守成规","抱残守缺"],"opposite":["勇往直前","一往无前"],"usage":"作谓语、定语；指人守旧"},{"id":12541,"word":"固若金汤","pinyin":"gù ruò jīn tāng","abbr":"grjt","explanation":"金属造的城，滚水形成的护城河。形容工事无比坚固。","source":{"text":"必将婴城固守，皆为金城汤池，不可攻也。","book":"《汉书·蒯通传》"},"example":{"text":"大沽口的炮台，如能得他允许保护，～。","book":"高阳《胭脂井》"},"similar":["铜墙铁壁","坚如磐石"],"opposite":["一触即溃","不堪一击"],"usage":"作谓语、定语、补语；指非常坚固","story":["秦末陈胜起义军冲击秦王朝的统治，陈胜的部将武臣率军攻打越地范阳，蒯通去拜会并劝说范阳县令徐公，徐公放弃守城。蒯通就去拜会武臣，劝武臣妥善安置徐公，这样别的负隅顽抗的固若金汤的城池的守备也会投降，武臣同意他的意见"]},{"id":12542,"word":"固阴沍寒","pinyin":"gù yīn hù hán","abbr":"gyhh","explanation":"固：牢固；沍：紧闭。形容不见天日，非常阴冷。","source":{"text":"深山穷谷，固阴沍寒。","book":"《左传·昭公四年》"}},{"id":12543,"word":"国不堪贰","pinyin":"guo bu kan er","abbr":"gbke","explanation":"国家受不了两属情况的存在。"},{"id":12544,"word":"国中之国","pinyin":"guó zhōng zhī guó","abbr":"gzzg","explanation":"指一个国家内，国家政府管辖不到的地方。","source":{"text":"接受了这个条件……就使清朝的“小朝廷”成为‘国中之国’。","book":"陶菊隐《北洋军阀统治时期史话》第六章"},"similar":["独立王国"],"usage":"作宾语；用于口语"},{"id":12545,"word":"国之四维","pinyin":"guó zhī sì wéi","abbr":"gzsw","explanation":"指治国的纲纪准则。","source":{"text":"国有四维，一维绝则倾，二维绝则危，三维绝则覆，四维绝则灭。倾可正也，危可安也，覆可起也，灭不可复错也。何谓四维，一曰礼，二曰义，三曰廉，四曰耻。","book":"《管子·牧民》"},"usage":"作主语、宾语；指治国的纲纪"},{"id":12546,"word":"国之存亡，匹夫有责","pinyin":"guó zhī cún wáng，pǐ fū yǒu zé","abbr":"gzcwpfyz","explanation":"匹夫：平民男子。指国家兴亡大事，每个平民都有责任。","example":{"text":"～，我们不能袖手旁观。"},"similar":["国家兴亡，匹夫有责"],"usage":"作宾语、分句；用于号召人"},{"id":12547,"word":"国之将亡，必有妖孽","pinyin":"guó zhī jiāng wáng，bì yǒu yāo niè","abbr":"gzjwbyyn","explanation":"妖孽：妖魔鬼怪。国家将要灭亡必定有某种征兆。","source":{"text":"国家将兴，必有祯祥；国家将亡，必有妖孽。","book":"西汉·戴圣《礼记·中庸》"},"similar":["国家将亡，必有妖孽"],"usage":"作宾语、定语；用于书面语"},{"id":12548,"word":"国之干城","pinyin":"guó zhī gān chéng","abbr":"gzgc","explanation":"干城：批御敌的武器和工具，这里比喻捍卫者。国家主权的捍卫者。","source":{"text":"言以武夫自固，为捍蔽如盾，为防守如城然。","book":"《诗经·周南·兔罝》：“赳赳武夫，公侯干城。”孔颖达疏"},"similar":["干城之将"],"usage":"作宾语；用于书面语"},{"id":12549,"word":"国事多艰","pinyin":"guó shì duō jiān","abbr":"gsdj","explanation":"国家处于危难之中。","source":{"text":"时国步艰难，连帅倔强，率多奏请，欲立家庙于本镇，顷上章论奏，乃止。","book":"《旧五代史·唐书·萧顷传》"},"similar":["国家多故"],"usage":"作宾语、定语；用于局势"},{"id":12550,"word":"国事蜩螗","pinyin":"guó shì tiáo táng","abbr":"gstt","explanation":"蜩：蝉；螗：一种比蝉还小的虫，但和蝉相近；蜩螗：指蝉鸣声，这里指纷扰不宁。形容国事动荡不安。","source":{"text":"如蜩如螗，如沸如羹。","book":"《诗经·大雅·荡》"},"example":{"text":"但现在～，人心震动，外交失败，内政不修，正是岌岌可危的时候。","book":"蔡东藩、许廑父《民国通俗演义》第一百十五回"},"usage":"作谓语、定语；用于局势等"},{"id":12551,"word":"国亡种灭","pinyin":"guó wáng zhǒng miè","abbr":"gwzm","explanation":"国家被瓜分，种族被灭绝。","source":{"text":"彼欧美学者于埃及、巴比伦之字，国亡种灭，久不适于用者，犹不惮搜求破碎，复其旧观。","book":"孙中山《孙文学说》第三章"}},{"id":12552,"word":"国人皆曰可杀","pinyin":"guó rén jiē yuē kě shā","abbr":"grjyks","explanation":"全国人民都认为他该死。形容民愤极大。","source":{"text":"左右皆曰可杀，勿听；国人皆曰可杀，然后察之；见可杀焉，然后杀之。","book":"《孟子·梁惠王下》"},"example":{"text":"查汪逆收集党徒，附敌叛国，订立卖国密约，为虎作伥，固～。","book":"毛泽东《向国民党的十点要求》"},"usage":"作宾语、定语；指该杀","story":["战国时期，孟子与齐宣王谈论关于选拔人才的问题，孟子认为国君选拔人才应该不论地位高低与关系的亲疏，关键在于看重人的才能贤能程度。在对于免职与开除问题，应该征询国人的意见，如果国人认为他确实可杀，就应该杀了他"]},{"id":12553,"word":"国仇家恨","pinyin":"guó chóu jiā hèn","abbr":"gcjh","explanation":"国家被侵略之仇，家园被破坏之恨。","source":{"text":"孩子，想当初你姑爹……也是为了报国仇家恨呀！","book":"陈荫荣《兴唐传·闹花灯》第九回"},"example":{"text":"她忍着～，被迫去应酬他。"},"similar":["国恨家仇"],"usage":"作宾语；指共同的仇恨"},{"id":12554,"word":"国以民为本，民以食为天","pinyin":"guó yǐ mín wéi běn，mín yǐ shí wéi tiān","abbr":"gymwbmyswt","explanation":"本：事物的根源或根基；天：指生存的首要条件。国家以人民为根本，人民以食物为头等大事。","source":{"text":"夫国以民为本，民以食为天，不足食胡以养民？","book":"孙中山《上李鸿章书》"},"example":{"text":"～。况在战争日，粮食更居先。","book":"董必武《挽沈骊英女士》"},"usage":"作宾语、定语；可分开使用"},{"id":12555,"word":"国利民福","pinyin":"guó lì mín fú","abbr":"glmf","explanation":"国家的利益，百姓的幸福。","source":{"text":"如车有辙，如舟有舵，无旁挠，无中阻，以专趋国利民福之一途。","book":"蔡东藩、许廑父《民国通俗演义》第十五回"},"usage":"作宾语、定语；用于书面语"},{"id":12556,"word":"国困民穷","pinyin":"guó kùn mín qióng","abbr":"gkmq","explanation":"国家困难，百姓穷困。","source":{"text":"我想到我国的上层社会，虽然国困民穷，却非外国货不买的情形，不禁使我面红耳赤。","book":"冯玉祥《我的生活》第33章"},"example":{"text":"我想到我国的上层社会，虽然～，却非外国货不买的情形，不禁使我面红耳赤。","book":"冯玉祥《我的生活》第三十三章"},"opposite":["国富民强"],"usage":"作宾语、定语；用于局面等"},{"id":12557,"word":"国士无双","pinyin":"guó shì wú shuāng","abbr":"gsws","explanation":"国士：国中杰出的人物。指一国独一无二的人才。","source":{"text":"诸将易得耳，至如信者，国士无双。","book":"《史记·淮阴侯列传》"},"example":{"text":"似臣呵，常人有数；论此人，～。","book":"元·宫大用《范张鸡黍》第四折"},"similar":["海内无双"],"usage":"作宾语、补语；指国中独一无二的人才","story":["秦朝末年，韩信因得不到项羽的重用，而改投奔刘邦，开始也没有得到重用，因滕公的推荐给萧何，萧何认为他是一个不可多得的人才推荐给刘邦。刘邦敷衍应付，韩信不辞而别，萧何月下追韩信，对刘邦说他是国士无双，刘邦拜他为大将"]},{"id":12558,"word":"国安民泰","pinyin":"guó ān mín tài","abbr":"gamt","explanation":"安：安定；泰：平安。国家太平，人民安乐。","source":{"text":"再拈信香一炷，愿今国安民泰，岁稔年和，三教兴隆，四方宁静。","book":"明·施耐庵《水浒传》第90回"},"similar":["国泰民安"],"opposite":["兵荒马乱","国弱民穷","国破家亡"],"usage":"作谓语、宾语、定语；形容国家太平"},{"id":12559,"word":"国家兴亡，匹夫有责","pinyin":"guó jiā xīng wáng，pǐ fū yǒu zé","abbr":"gjxwpfyz","explanation":"匹夫：平民男子。指国家兴亡大事，每个平民都有责任。","source":{"text":"国家大事，卑人不该开口。但国家兴亡，匹夫有责；今有一言，不知当讲不当讲？","book":"京剧《将相和》第五场"},"example":{"text":"～，我们得奋起直追。"},"similar":["天下兴亡，匹夫有责"],"usage":"作宾语、分句；用于号召人"},{"id":12560,"word":"国家多故","pinyin":"guó jiā duō gù","abbr":"gjdg","explanation":"故：变故，事故。国家总出现重大变故。","source":{"text":"方国家多故，未遑修九伐之征也。","book":"《三国志·魏志·钟会传》"},"example":{"text":"太平天国·赖文光《自述》：“六年秋，值～之际……弃文就武，奉命出师江右。”"},"similar":["国事多艰"],"usage":"作宾语、定语；用于局势"},{"id":12561,"word":"国家多难","pinyin":"guó jiā duō nàn","abbr":"gjdn","explanation":"难：灾难。国家多次遭到灾难。形容国家政局不稳。","source":{"text":"虽然，吾君老矣，子少，国家多难。","book":"西汉·戴圣《礼记·檀弓上》"},"usage":"作宾语、定语；指局势不稳"},{"id":12562,"word":"国家大事","pinyin":"guó jiā dà shì","abbr":"gjds","explanation":"大事：重大事情。与国家利益有关的重大事情。","source":{"text":"是时列侯唯高密、固始、胶东三侯与公卿参议国家大事，恩遇甚厚。","book":"南朝·宋·范晔《后汉书·贾复传》"},"example":{"text":"普通一般学者，只在书斋里打圈子，对于～则不闻不问。","book":"郭沫若《王安石》"},"similar":["国家大计"],"usage":"作主语、宾语；指与国有关的事情"},{"id":12563,"word":"国家大计","pinyin":"guó jiā dà jì","abbr":"gjdj","explanation":"与国家利益有关的重大事情。","source":{"text":"于禁等被水所淹，非战之故；于国家大计，本无所损。","book":"明·罗贯中《三国演义》第75回"},"example":{"text":"那时似乎并不谈什么～。","book":"鲁迅《知难行难》"},"similar":["国家大事"],"usage":"作主语、宾语；指与国有关的事情"},{"id":12564,"word":"国家将亡，必有妖孽","pinyin":"guó jiā jiāng wáng，bì yǒu yāo niè","abbr":"gjjwbyyn","explanation":"妖孽：妖魔鬼怪。国家将要灭亡必定有某种征兆。","source":{"text":"国家将兴，必有祯祥；国家将亡，必有妖孽。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"‘国家将兴，必有祯祥；～。’主公当避凶就吉；今若背反，必丧身矣。","book":"《三国志通俗演义·司马懿破公孙渊》"},"similar":["国之将亡，必有妖孽"],"usage":"作宾语、定语；用于书面语"},{"id":12565,"word":"国家将兴，必有祯祥","pinyin":"guó jiā jiāng xīng，bì yǒu zhēn xiáng","abbr":"gjjxbyzx","explanation":"祯祥：吉兆。国家兴盛必定有某种征兆。","source":{"text":"国家将兴，必有祯祥；国家将亡，必有妖孽。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"‘～；国家将亡，必有妖孽。’主公当避凶就吉；今若背反，必丧身矣。","book":"《三国志通俗演义·司马懿破公孙渊》"},"usage":"作宾语、定语；用于书面语"},{"id":12566,"word":"国家栋梁","pinyin":"guó jiā dòng liáng","abbr":"gjdl","explanation":"栋梁：支撑房架的大梁。这里比喻责任或作用大。肩负国家重任的人。","source":{"text":"真乃国家栋梁。","book":"元·无名氏《冻苏秦》第三折"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":12567,"word":"国家闲暇","pinyin":"guó jiā xián xiá","abbr":"gjxx","explanation":"国家太平无事，既无内乱，也无外患。","source":{"text":"贤者在位，能者在职，国家闲暇，及是时，明其政刑。虽大国，必畏之矣。","book":"《孟子·公孙丑上》"}},{"id":12568,"word":"国富兵强","pinyin":"guó fù bīng qiáng","abbr":"gfbq","explanation":"国家富裕，军队强盛。","source":{"text":"齐放其大臣孟尝君于诸侯，诸侯先迎之者，富而兵强。","book":"《韩非子·定法》：“是以其民用力劳而不休，逐敌危而不却，故其国富而兵强。”《战国策·齐策四》"},"example":{"text":"陛下圣明神武，朝野清晏，～，号令如一。","book":"《晋书·杜预传》"},"similar":["国富民强"],"usage":"作谓语、宾语；指国家强大"},{"id":12569,"word":"国富民丰","pinyin":"guó fù mín fēng","abbr":"gfmf","explanation":"国家富有，民众富裕。","source":{"text":"散乐移风，国富民康。","book":"三国·魏·曹植《七启》"},"example":{"text":"田肥地茂，岁无水旱之忧；～，时有管弦之乐。","book":"明·罗贯中《三国演义》第六十回"},"similar":["国富民强"],"usage":"作谓语、宾语；指国家富强"},{"id":12570,"word":"国富民安","pinyin":"guó fù mín ān","abbr":"gfma","explanation":"国家富强，人民安定。","source":{"text":"至齐桓公任用管仲而国富民安。","book":"《汉书·刑法志》"},"similar":["国泰民安"],"usage":"作宾语、定语；指国家富强"},{"id":12571,"word":"国富民康","pinyin":"guó fù mín kāng","abbr":"gfmk","explanation":"国家富有，民众富裕。","source":{"text":"散乐移风，国富民康。","book":"三国·魏·曹植《七启》"}},{"id":12572,"word":"国富民强","pinyin":"guó fù mín qiáng","abbr":"gfmq","explanation":"国家富足，人民强健。","source":{"text":"民富国强，众安道泰。","book":"汉·赵晔《吴越春秋》"},"similar":["国泰民安","国富兵强"],"opposite":["民困国穷","国贫民弱"],"usage":"作谓语、宾语；指国家富强"},{"id":12573,"word":"国将不国","pinyin":"guó jiāng bù guó","abbr":"gjbg","explanation":"国家将无法维持下去了。指国家的局势很坏，有亡国的危险。","source":{"text":"庄寿香号称名臣，听说在和议开始时，他主张把台湾赠英……国将不国，这才是糊涂到底了呢！","book":"清·曾朴《孽海花》第三十二回"},"example":{"text":"可是“友邦人士”一惊诧，我们的国府就怕了，“长此以往，～”了。","book":"鲁迅《“友邦惊诧”论》"},"usage":"作谓语、分句；指动荡局面"},{"id":12574,"word":"国尔忘家","pinyin":"guó ěr wàng jiā","abbr":"gewj","explanation":"一心为国，不顾家庭。","source":{"text":"则为人臣者主耳忘身，国耳忘家，公耳忘私，利不苟就，害不苟去，唯义所在。","book":"《汉书·贾谊传》"},"example":{"text":"而当时改革的人，个个似乎有匈奴未灭何以家为的一种～，公尔忘私的气概。","book":"鲁迅《两地书》九"},"similar":["为国捐躯","慷慨就义","公而忘私"],"opposite":["损人利己","见利忘义","损公肥私"],"usage":"作谓语、定语；指爱国"},{"id":12575,"word":"国尔忘家，公尔忘私","pinyin":"guó ěr wàng jiā，gōng ěr wàng sī","abbr":"gewjgews","explanation":"为了公事而忘记私事，为了国事而忘记家事。形容一心为公为国。","source":{"text":"而当时改革的人，个个似乎有匈奴未灭何以家为的一种国尔忘家，公尔忘私的气概。","book":"鲁迅《两地书》"},"similar":["国耳忘家，公耳忘私"],"usage":"作谓语、定语；可分开使用"},{"id":12576,"word":"国必自伐，而后人伐之","pinyin":"guó bì zì fá，ér hòu rén fá zhī","abbr":"gbzfehrfz","explanation":"一个国家必先种下了被伐的恶因，然后才会有别人来讨伐的结果。比喻要从自身找事变的原因。","source":{"text":"夫人必自侮，然后人侮之；家必自毁，而后人毁之；国必自伐，而后人伐之。","book":"《孟子·离娄上》"},"example":{"text":"一面看，一面想起四书上面“～”。","book":"李六如《六十年的变迁》第二章"},"usage":"作宾语、定语；用于治国等"},{"id":12577,"word":"国恨家仇","pinyin":"guó hèn jiā chóu","abbr":"ghjc","explanation":"恨：怨恨。国家被侵略和家园被破坏之仇恨。","source":{"text":"我良玉幸而留下残生……诛灭卢贼，以雪国恨家仇。","book":"《二度梅》第四场"},"similar":["国仇家恨"],"usage":"作宾语；指共同的仇恨"},{"id":12578,"word":"国无二君","pinyin":"guó wú èr jūn","abbr":"gwej","explanation":"一个国家不能有两个皇帝。","source":{"text":"天无二日，土无二王，国无二君，家无二尊。","book":"《礼记·丧服四制》"},"similar":["天无二日"],"usage":"作宾语、定语；用于口语"},{"id":12579,"word":"国无宁岁","pinyin":"guó wú níng suì","abbr":"gwns","explanation":"宁：安宁。国家没有太平的日子。","source":{"text":"国无宁岁，民无安时。","book":"蔡东藩《民国通俗演义》第45回"},"similar":["国无宁日"],"opposite":["国泰民安"],"usage":"作谓语、定语；指国家没有太平的日子"},{"id":12580,"word":"国无宁日","pinyin":"guó wú níng rì","abbr":"gwnr","explanation":"宁：安宁。国家动荡而没有太平的时候。","source":{"text":"宋大国也，起倾国兵，盛气而来……吾国无宁日矣。","book":"明·冯梦龙《东周列国志》第十一回"},"example":{"text":"战犯不除，～。","book":"毛泽东《南京政府向何处去？》"},"similar":["国无宁岁"],"opposite":["国泰民安"],"usage":"作谓语、定语；指国家没有太平的日子"},{"id":12581,"word":"国无幸民","pinyin":"guó wú xìng mín","abbr":"gwxm","explanation":"幸民：侥幸偷生的人。国家治理有方，人民勤于职守，安居乐业。","source":{"text":"善人在上，则国无幸民。","book":"《左传·宣公十六年》"}},{"id":12582,"word":"国无捐瘠","pinyin":"guó wú juān jí","abbr":"gwjj","explanation":"瘠：瘦弱；捐瘠：贫弱以至死。国内没有因贫困饥饿而死亡的人。","source":{"text":"故尧禹有九年之水，汤有七年之旱，而国无捐瘠者，以蓄积多而备先具也。","book":"《汉书·食货志》"}},{"id":12583,"word":"国是日非","pinyin":"guó shì rì fēi","abbr":"gsrf","explanation":"国是：国家大事。国家的前景一天不如一天。","source":{"text":"自是朝政反复，国是日非。","book":"明·余继登《典故纪闻》卷十"},"usage":"作谓语、定语；用于局势等"},{"id":12584,"word":"国步多艰","pinyin":"guó bù duō jiān","abbr":"gbdj","explanation":"国步：国家的命运。国家处于危难之中。","source":{"text":"风骚如线不胜悲，国步多艰即此时。","book":"《诗经·大雅·桑柔》：“于乎有哀，国步斯频。”唐·郑谷《读前集二首》其二"},"example":{"text":"今～，中原隔绝，江、淮之地，尚有盗贼，驻跸之地，最为急务。","book":"清·毕沅《续资治通鉴》卷一百一十"},"similar":["国步艰难"],"usage":"作谓语、定语；指国家处于危难的境地"},{"id":12585,"word":"国步方蹇","pinyin":"guó bù fāng jiǎn","abbr":"gbfj","explanation":"国步：国家的命运。国家处于危难的境地。","source":{"text":"王室多故，国步方蹇。","book":"南朝·宋·谢庄《孝武帝哀策文》"},"similar":["国步多艰","国步艰难","国步艰危"],"usage":"作谓语、定语；指国家处于危难的境地"},{"id":12586,"word":"国步艰危","pinyin":"guó bù jiān wēi","abbr":"gbjw","explanation":"国步：国家的命运。国家处于危难的境地。","source":{"text":"国步方艰危，简在卿昆季。","book":"清·顾炎武《赠路舍人泽溥》诗"},"similar":["国步艰难","国步多艰","国步方蹇"],"usage":"作谓语、定语；指国家处于危难的境地"},{"id":12587,"word":"国步艰难","pinyin":"guó bù jiān nán","abbr":"gbjn","explanation":"国步：国家的命运。国家处于危难之中。","source":{"text":"於乎有哀，国步斯频。","book":"《诗经·大雅·桑柔》"},"example":{"text":"际兹～，方当拨乱反正。","book":"清·冯桂芬《复庄卫生书》"},"similar":["国将不国","国如悬罄","国步艰危"],"opposite":["国泰民安","国富民强"],"usage":"作谓语、定语；指国家处于危难的境地"},{"id":12588,"word":"国泰民安","pinyin":"guó tài mín ān","abbr":"gtma","explanation":"泰：平安，安定。国家太平，人民安乐。","source":{"text":"每岁海潮太溢，冲激州城，春秋醮祭，诏命学士院，撰青词以祈国泰民安。","book":"宋·吴自牧《梦梁录·山川神》"},"example":{"text":"有一天，沟不臭，水又清，～享太平。","book":"老舍《龙须沟》第一幕"},"similar":["天下太平","歌舞升平","河清海晏"],"opposite":["兵荒马乱","国弱民穷","国破家亡"],"usage":"作谓语、宾语、定语；形容国家太平"},{"id":12589,"word":"国破家亡","pinyin":"guó pò jiā wáng","abbr":"gpjw","explanation":"国家覆灭、家庭毁灭。","source":{"text":"国破家亡，亲友雕残。","book":"晋·刘琨《答卢谌书》"},"example":{"text":"天荒地老英雄丧，～事业休。","book":"明·赵弼《续宋丞相文文山传》"},"similar":["山河破碎"],"opposite":["国富民强","国泰民安","天下太平"],"usage":"作谓语、定语；指国家覆灭、家人离散"},{"id":12590,"word":"国而忘家","pinyin":"guó ér wàng jiā","abbr":"gewj","explanation":"指为国事而忘其家。","source":{"text":"但自古道：‘公而忘私，国而忘家。’我们科场是朝廷大典，你我为朝廷办事，就是不顾私亲，也还觉得于心无愧。","book":"《儒林外史》第六回"},"example":{"text":"马识途《我们打了一个大胜仗》：“他们公而忘私，～，置个人安危于不顾，充分发挥了人定胜天的无比威力，打了一个大胜仗。”"},"similar":["国耳忘家","国尔忘家"],"usage":"作谓语、定语；指爱国"},{"id":12591,"word":"国耳忘家","pinyin":"guó ěr wàng jiā","abbr":"gewj","explanation":"指为国事而忘其家。同“国而忘家”。","source":{"text":"故化成俗定，则为人臣者主耳忘身，国耳忘家，公耳忘私。","book":"汉·贾谊《陈政事疏》"},"example":{"text":"东汉·班固《汉书·贾谊传》：“则为人臣者主耳忘身，～，公耳忘私，利不苟就，害不苟去，唯义所生。”"},"similar":["国耳忘家，公耳忘私"],"usage":"作谓语、定语；指人爱国"},{"id":12592,"word":"国耳忘家，公尔忘私","pinyin":"guó ěr wàng jiā，gōng ěr wàng sī","abbr":"gewjgews","explanation":"为了国家忘了自己的家，为了公事忘了私事。形容一心为国为公。","source":{"text":"则为人臣者主耳忘身，国耳忘家，公耳忘私，利不苟就，害不苟去，唯义所在。","book":"《汉书·贾谊传》"}},{"id":12593,"word":"国耳忘家，公耳忘私","pinyin":"guó ěr wàng jiā，gōng ěr wàng sī","abbr":"gewjgews","explanation":"为了公事而忘记私事，为了国事而忘记家事。形容一心为公为国。","source":{"text":"则为人臣者主耳忘身，国耳忘家，公耳忘私，利不苟就，害不苟去，唯义所生。","book":"东汉·班固《汉书·贾谊传》"},"similar":["公耳忘私，国耳忘家"],"usage":"作谓语、定语；可分开使用"},{"id":12594,"word":"国脉民命","pinyin":"guó mài mín mìng","abbr":"gmmm","explanation":"国家的动脉，人民的生命。比喻国家、人民赖以生存发展的的根基。","source":{"text":"当此国难深重之秋，苦犹不思变计，则日汪肆扰于外，奸徒破坏于内，国脉民命，岌岌可危矣。","book":"毛泽东《向国民党的十点要求》"},"usage":"作宾语、定语；用于书面语"},{"id":12595,"word":"国色天姿","pinyin":"guó sè tiān zī","abbr":"gstz","explanation":"国色：女子美色冠绝全国；天姿：天生的姿色。旧时形容女子容貌极美。","source":{"text":"修短得中，天姿掩蔼，容颜绝世。","book":"《公羊传·昭公三十一年》：“颜夫人者，妪盈女也，国色也。”《汉武帝内传》"},"example":{"text":"现出女娲圣像，容貌端丽，瑞彩翩跹，～，婉然如生。","book":"明·许仲琳《封神演义》第一回"},"similar":["国色天香"],"usage":"作宾语、定语；形容女性的美丽"},{"id":12596,"word":"国色天香","pinyin":"guó sè tiān xiāng","abbr":"gstx","explanation":"原形容颜色和香气不同于一般花卉的牡丹花。后也形容女子的美丽。","source":{"text":"国色朝酣酒，天香夜染衣。","book":"唐·李浚《摭异记》"},"example":{"text":"于那娉婷妩媚之中，无不带著一团书卷秀气，虽非～，却是斌斌儒雅。","book":"清·李汝珍《镜花缘》第六十六回"},"similar":["沉鱼落雁","羞花闭月"],"opposite":["其貌不扬"],"usage":"作宾语、定语；形容女性的美丽","story":["唐朝时期，唐文宗李昂在程修己的陪同下到御花园里赏花，园内百花齐放，姹紫嫣红，争奇斗艳。文宗十分欣赏牡丹花王，就问程修己都城传唱的牡丹诗。程修己回答说中书舍人李正封的诗：“天香夜染衣，国色朝酣酒。”文宗赞叹不已"]},{"id":12597,"word":"国计民生","pinyin":"guó jì mín shēng","abbr":"gjms","explanation":"国家经济和人民生活。","source":{"text":"民生在勤，勤则不匮。","book":"《荀子·富国》：“如是则上下俱富，交无所藏之，是国计之极也。”《左传·宣公十二年》"},"example":{"text":"这几年她已深切了解，做官的人，对～，或者不甚措意，但于权贵的荣辱得失，十分敏感。","book":"高阳《玉座珠帘》上册"},"similar":["民生国计"],"usage":"作定语、宾语；指关系重大的"},{"id":12598,"word":"国贼禄鬼","pinyin":"guó zéi lù guǐ","abbr":"gzlg","explanation":"国贼：损害国家利益，出卖国家主权的民族败类；禄鬼：指利欲熏心贪求官禄的人。指不顾国家利益，一心钻营名利的人。","source":{"text":"好好的一个清净洁白女子，也学的钓名沽誉，入了国贼禄鬼之流。","book":"清·曹雪芹《红楼梦》第三十六回"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":12599,"word":"国难当头","pinyin":"guó nàn dāng tóu","abbr":"gndt","explanation":"国家正面临着巨大的灾难。","source":{"text":"在国难当头的现在，白天里讲些冠冕堂皇的话……不就正是这些人么？","book":"鲁迅《答徐懋庸并关于抗日统一战线问题》"},"example":{"text":"～，我们应该尽弃前嫌。"},"usage":"作宾语、定语；指国家正面临着巨大的灾难"},{"id":12600,"word":"图为不轨","pinyin":"tú wéi bù guǐ","abbr":"twbg","explanation":"图：企图；轨：常规，法度。谋划进行违犯法纪的活动。","source":{"text":"休未至，綝欲入宫，图为不轨，召百官会议，皆惶怖失色，徒唯唯而已。","book":"《三国地·吴志·虞翻传》裴松之注引《会稽典录》"},"example":{"text":"《晋书·郗鉴传》：“隆文子皆死，顾彦亦被害，诬隆聚合远近，～。”"},"similar":["图作不轨","图谋不轨"],"usage":"作谓语、定语；用于处事"},{"id":12601,"word":"图作不轨","pinyin":"tú zuò bù guǐ","abbr":"tzbg","explanation":"指图谋不轨。","source":{"text":"及宪兄弟图作不轨，众遂首谋诛之，以功迁大长秋。","book":"《东观汉记·郑众传》"},"similar":["图为不轨"],"usage":"作谓语、定语；用于处事"},{"id":12602,"word":"图国忘死","pinyin":"tú guó wàng sǐ","abbr":"tgws","explanation":"图国：谋求报国。谋求国家利益而忘记自己的生死。比喻忠贞报国。","source":{"text":"思难不越官，信也；图国忘死，贞也。","book":"《左传·昭公元年》"}},{"id":12603,"word":"图文并茂","pinyin":"tú wén bìng mào","abbr":"twbm","explanation":"指书刊中的文字流畅，插图丰富精美。","source":{"text":"我始终认为贵刊是国内的一流刊物，图文并茂，趣味高雅，是思想性、知识性、趣味性三性结合的比较突出的好刊物。","book":"王朔《修改后发表》"},"example":{"text":"学生都喜欢～的课本。"},"usage":"作谓语、定语；用于书籍等"},{"id":12604,"word":"图王霸业","pinyin":"tú wáng bà yè","abbr":"twby","explanation":"图：谋求；霸业：称霸。指谋求称王称霸。","source":{"text":"你这厮只是睦州一伙村夫，量你有甚福禄，妄要图王霸业，不如及早投降，免汝一死。","book":"明·施耐庵《水浒传》第113回"},"example":{"text":"～非我愿，孝义堂前集众英。","book":"清·无名氏《说呼全传》第15回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":12605,"word":"图穷匕现","pinyin":"tú qióng bǐ xiàn","abbr":"tqbx","explanation":"图：地图；穷：尽；匕：匕首；现：显露出来。比喻事情发展到最后露出了真相或本来面目。","example":{"text":"不要等到～的时候才明白。"},"similar":["图穷匕见"],"usage":"作谓语、定语；指原形毕露","story":["战国末年，燕国太子丹物色荆轲与秦舞阳去行刺秦王嬴政，他把樊于期的人头及燕国的地图让荆轲他们进献给秦王，秦王十分高兴。荆轲展开燕国地图，露出锋利的匕首，立即抓住匕首行刺秦王，秦王拔剑抵抗，卫兵乘机上前杀了荆轲"]},{"id":12606,"word":"图穷匕见","pinyin":"tú qióng bǐ xiàn","abbr":"tqbx","explanation":"图：地图；穷：尽；见：现。比喻事情发展到最后，真相或本意显露了出来。","source":{"text":"秦王谓轲曰：‘起，取武阳所持图。’轲既取图奉之。发图，图穷而匕首见。","book":"《战国策·燕策三》"},"example":{"text":"不意先生乃蓄别抱，～，爰有斯言。","book":"叶圣陶《一个青年》"},"similar":["东窗事发","原形毕露"],"opposite":["显而易见"],"usage":"作谓语、定语；指原形毕露","story":["战国末年，燕国太子丹物色荆轲与秦舞阳去行刺秦王嬴政，他把樊于期的人头及燕国的地图让荆轲他们进献给秦王，秦王十分高兴。荆轲展开燕国地图，露出锋利的匕首，立即抓住匕首行刺秦王，秦王拔剑抵抗，卫兵乘机上前杀了荆轲"]},{"id":12607,"word":"图穷匕首见","pinyin":"tú qióng bǐ shǒu xiàn","abbr":"tqbsx","explanation":"图：地图；穷：尽；见：现。比喻事情发展到最后，真相或本意显露了出来。","source":{"text":"秦王谓轲曰：‘起，取武阳所持图。’轲既取图奉之。发图，图穷而匕首见。","book":"《战国策·燕策三》"},"example":{"text":"这次谈判双方针锋相对，已到了～的最后阶段了。"},"similar":["图穷匕见"],"usage":"作谓语、定语；指原形毕露","story":["战国末年，燕国太子丹物色荆轲与秦舞阳去行刺秦王嬴政，他把樊于期的人头及燕国的地图让荆轲他们进献给秦王，秦王十分高兴。荆轲展开燕国地图，露出锋利的匕首，立即抓住匕首行刺秦王，秦王拔剑抵抗，卫兵乘机上前杀了荆轲"]},{"id":12608,"word":"图谋不轨","pinyin":"tú móu bù guǐ","abbr":"tmbg","explanation":"不轨：越出常轨，不守法度。谋划越出常规、法度之事。","source":{"text":"兄抗旌犯顺，杀戮忠良，谋图不轨，祸及门户。","book":"《晋书·王彬传》"},"example":{"text":"你们给我们来的公函，说我们～……我们此行纯为爱国而来，绝无越轨行为。","book":"杨沫《青春之歌》第七章"},"similar":["包藏祸心"],"opposite":["安分守己","循规蹈矩"],"usage":"作谓语、定语；指谋反","story":["三国时期，孙权死后，10岁的儿子孙亮继位，朝政由大将军诸葛恪、会稽太守滕胤共同辅政，偏将军孙惏谋害滕胤，势力逐渐增强，开始胡作非为。孙亮想除掉孙惏反而被他赶下台，迎立孙休为皇帝，孙休还未登基，他又想图谋不轨被虞汜制止"]},{"id":12609,"word":"图财害命","pinyin":"tú cái hài mìng","abbr":"tchm","explanation":"图：谋取。为了劫夺财物，害人性命。","source":{"text":"你如今将俺主人摆布死了，故意将这绣鞋揣在怀里，正是你图财致命，便待干罢。","book":"元·曾瑞卿《留鞋记》第二折"},"example":{"text":"他的身上是带着有我们的盘费的，那两名轿夫不会～吗？","book":"郭沫若《革命春秋·北伐途次》"},"similar":["谋财害命","图财致命"],"opposite":["仗义疏财"],"usage":"作谓语、宾语；同“谋财害命”"},{"id":12610,"word":"图财致命","pinyin":"tú cái zhì mìng","abbr":"tczm","explanation":"图：谋取。为了劫夺财物，害人性命。","source":{"text":"你如今将俺主人摆布死了，故意将这绣鞋揣在怀里，正是你图财致命。","book":"元·曾瑞卿《留鞋记》第二折"},"similar":["图财害命"],"usage":"作谓语、宾语；指谋财害命"},{"id":12611,"word":"图身忘国","pinyin":"tú shēn wàng guó","abbr":"tswg","explanation":"只贪图自身的利益，而不顾国家的危亡。","source":{"text":"余读《汉书》列传，见佞顺媕娿，图身忘国，如张禹辈者。","book":"唐·白居易《有木诗八首·序》"},"usage":"作谓语、定语；用于书面语"},{"id":12612,"word":"囿于成见","pinyin":"yòu yú chéng jiàn","abbr":"yycj","explanation":"局限于原有的看法。","example":{"text":"我们不能～，要用于创新。"},"usage":"作主语、宾语、谓语；指固执"},{"id":12613,"word":"囿于见闻","pinyin":"yòu yú jiàn wén","abbr":"yyjw","explanation":"拘泥于所见所闻。","source":{"text":"但是至少需要三人，不然会囿于见闻，不符合真实情况。","book":"毛泽东《反对本本主义》"},"similar":["囿于成见"],"usage":"作谓语、定语；用于处事"},{"id":12614,"word":"圆冠方领","pinyin":"yuán guān fāng lǐng","abbr":"ygfl","explanation":"古代儒者的冠服。代指儒者。","source":{"text":"方领圆冠，金口木舌，谈章句之远旨，构纷纶之雅说。","book":"南朝·梁·简文帝《七召》"},"example":{"text":"将使～，再行邹鲁之风；锐气英声，一变ク渝之俗。","book":"唐·王勃《益州夫子庙碑》"},"usage":"作宾语、定语；用于书面语"},{"id":12615,"word":"圆凿方枘","pinyin":"yuán záo fāng ruì","abbr":"yzfr","explanation":"枘：榫头；凿：榫眼。方榫头，圆榫眼，两下里合不来。比喻格格不入。","source":{"text":"圆凿而方枘兮，吾固知其龃龉而难入。","book":"战国·楚·宋玉《九辩》"},"example":{"text":"盖北辕适楚，～，欲求扶，倾愈疾，其可得乎？（唐·陆长源《上宰相书》）"},"similar":["圆孔方木"],"usage":"作谓语；指不相投合"},{"id":12616,"word":"圆孔方木","pinyin":"yuán kǒng fāng mù","abbr":"ykfm","explanation":"把方木头放到圆孔里去。比喻二者不能投合。","source":{"text":"若将有限心识作无限中用，如将方木逗圆孔。","book":"宋·释道原《景德传灯录》"},"similar":["圆凿方枘"],"usage":"作宾语、定语；指不能投合"},{"id":12617,"word":"圆木警枕","pinyin":"yuán mù jǐng zhěn","abbr":"ymjz","explanation":"用圆木做枕头，睡着时容易惊醒。形容刻苦自勉。","source":{"text":"以圆木为警枕，小睡则枕转而觉，乃起读书。","book":"宋·范祖禹《司马温公布衾铭记》"},"example":{"text":"且夫古人之勤学者，必昕夕天怠，是故苏秦刺股，孙敬闭门，范希文断韲画粥，司马光～。","book":"明·赵弼《疥鬼对》"},"usage":"作谓语、定语；指自我警戒"},{"id":12618,"word":"圆顶方趾","pinyin":"yuán dǐng fāng zhǐ","abbr":"ydfz","explanation":"指人类。同“圆首方足”。","source":{"text":"彼非圆顶方趾、父母所生之民耶？","book":"清·龚自珍《〈升平分类读史雅诗〉自序》"},"example":{"text":"鲁迅《文学的阶级性》：“人是同样的～，要吃饭，要睡觉。”"},"similar":["圆首方足","圆颅方趾"],"usage":"作主语、宾语；指人"},{"id":12619,"word":"圆颅方趾","pinyin":"yuán lú fāng zhǐ","abbr":"ylfz","explanation":"颅：头颅；趾：脚。方脚圆头。指人类。","source":{"text":"方趾圆颅，万不遗一。","book":"《淮南子·精神训》：“故头之圆也象天，足之方也象地。”《南史·陈高祖纪》"},"example":{"text":"夫～一也，而高下之殊至是。","book":"清·章炳麟《平等论》"},"similar":["圆首方足","圆顶方趾"],"usage":"作主语、宾语；指人"},{"id":12620,"word":"圆首方足","pinyin":"yuán shǒu fāng zú","abbr":"ysfz","explanation":"代指人类。","source":{"text":"头之圆也象天，足之方也象地。","book":"《淮南子·精神训》"},"example":{"text":"八极九野，万方四裔，～，罔不乐推。","book":"《隋书·高祖纪上》"},"similar":["圆顶方趾","圆颅方趾"],"usage":"作主语、宾语；指人"},{"id":12621,"word":"圈牢养物","pinyin":"juàn láo yǎng wù","abbr":"jlyw","explanation":"圈牢：养牛马的地方。饲养在圈中的牲畜。比喻任人驱使，毫无自由的人。","source":{"text":"此徒圈牢之养物，非臣之所志也。","book":"三国·魏·曹植《求自试表》"}},{"id":12622,"word":"土偶蒙金","pinyin":"tǔ ǒu méng jīn","abbr":"tomj","explanation":"在泥塑人像外面涂上金粉。比喻因袭模仿，徒有其表。","source":{"text":"宋诗如三家村叟，布袍草履，是一个人。明诗土偶蒙金。","book":"清·吴乔《答万季野诗问》"},"usage":"作宾语、定语；用于比喻句"},{"id":12623,"word":"土八路","pinyin":"tǔ bā lù","abbr":"tbl","explanation":"八路：八路军。指非正规军，引申为土气的人。","source":{"text":"黄原这群‘土八路’几乎变成了一个日本来的贸易代表团。","book":"路遥《平凡的世界》第六卷第29章"},"similar":["土老冒","土包子"],"usage":"作主语、宾语、定语；用于口语"},{"id":12624,"word":"土包子","pinyin":"tǔ bāo zǐ","abbr":"tbz","explanation":"指没有见过大世面的人，如果是说别人，有轻蔑意。如果是说自己，有自谦意。","source":{"text":"有些人轻视本地干部，讥笑本地干部，他们说：‘本地人懂得什么，土包子！’","book":"毛泽东《整顿党的作风》"},"example":{"text":"我就是土生土长的柳村人，～一个。"},"similar":["土老冒","土八路"],"usage":"作宾语；指没有见过大世面的人"},{"id":12625,"word":"土埋半截","pinyin":"tǔ mái bàn jié","abbr":"tmbj","explanation":"比喻活不了多久。","example":{"text":"他们都是～的人了。"},"similar":["入土半截"],"usage":"作定语；用于口语"},{"id":12626,"word":"土壤细流","pinyin":"tǔ rǎng xì liú","abbr":"trxl","explanation":"比喻微不足道的事物。","source":{"text":"是以太山不让土壤，故能成其大；河海不择细流，故能就其深。","book":"西汉·司马迁《史记·李斯列传》"},"example":{"text":"窃比附～之说，为略呈之。","book":"《辛亥革命·民国各团体之组织》"},"usage":"作宾语；比喻细小的事物"},{"id":12627,"word":"土头土脑","pinyin":"tǔ tóu tǔ nǎo","abbr":"tttn","explanation":"指行为、举止、服饰等不合时尚。","source":{"text":"谁知他土头土脑的，信是一句话。","book":"清·吴趼人《二十年目睹之怪现状》第三回"},"example":{"text":"她那～的样子让人看不起。"},"similar":["土里土气"],"opposite":["洋里洋气"],"usage":"作定语；指行为、举止、服饰等不合时尚"},{"id":12628,"word":"土崩瓦解","pinyin":"tǔ bēng wǎ jiě","abbr":"tbwj","explanation":"瓦解：制瓦时先把陶土制成圆筒形，分解为四，即成瓦，比喻事物的分裂。象土崩塌，瓦破碎一样，不可收拾。比喻彻底垮台。","source":{"text":"秦之积衰，天下土崩瓦解。","book":"《鬼谷子·抵山戏》：“君臣相惑，土崩瓦解而相伐射。”《史记·秦始皇本纪》"},"example":{"text":"逊督促诸军四面蹙之，～，死者万数。","book":"清·平步青《霞外捃屑》卷七"},"similar":["分崩离析","四分五裂"],"opposite":["坚如磐石","安如泰山"],"usage":"作谓语、定语、补语；指垮台","story":["商朝末年，商纣王贪恋酒色，荒淫无道，整天花天酒地，寻欢作乐，不理朝政，听信谗言，残害忠良。闹得民不聊生，周武王应时而起，率军攻破商都。商纣王在鹿台上吊自杀，商朝政权的垮台就像瓦片碎裂、泥土崩溃一样迅速"]},{"id":12629,"word":"土崩鱼烂","pinyin":"tǔ bēng yú làn","abbr":"tbyl","explanation":"鱼烂：鱼腐烂从内脏起。比喻国家内部发生动乱。","source":{"text":"若乃距阳平，据石门，摅八陈之列，骋奔牛之权，焉有土崩鱼烂哉。","book":"汉·陈琳《为曹洪与魏文帝书》"},"example":{"text":"清·方苞《书潘允慎家传后》：“是以人主孤立于上，蒸黎糜沸于下，～，一溃而不可收。”"},"usage":"作宾语、定语；用于书面语"},{"id":12630,"word":"土扶成墙","pinyin":"tǔ fú chéng qiáng","abbr":"tfcq","explanation":"比喻人应该互相扶助。","source":{"text":"土相扶为墙，人相扶为王。","book":"《北史·尉景传》"},"usage":"作宾语、定语；用于劝诫人"},{"id":12631,"word":"土木形骸","pinyin":"tǔ mù xíng hái","abbr":"tmxh","explanation":"形骸：指人的形体。形体象土木一样。比喻人的本来面目，不加修饰。","source":{"text":"刘伶身长六尺，貌甚丑悴，而悠悠忽忽，土木形骸。","book":"南朝宋·刘义庆《世说新语·容止》"},"example":{"text":"处俊姿约素，～，然临事敢言。","book":"《新唐书·郝处俊传》"},"similar":["本来面目"],"usage":"作谓语、宾语；比喻不加修饰的本来面","story":["晋朝时期，“竹林七贤”之一的嵇康身高七尺八寸，风度翩翩，善于行文。他的形体如同土木一样自然，不需要刻意修饰。他为人桀骜不逊，善于弹琴，终因与世俗不容而被杀害"]},{"id":12632,"word":"土洋并举","pinyin":"tǔ yáng bìng jǔ","abbr":"tybj","explanation":"本国的土法和外国的洋法都采用。","example":{"text":"我们采取～的办法来解决。"},"similar":["土洋结合"],"opposite":["崇洋媚外"],"usage":"作宾语、定语；指土洋结合"},{"id":12633,"word":"土洋结合","pinyin":"tǔ yáng jié hé","abbr":"tyjh","explanation":"把简单的设备或技术同现代化的设备或技术结合起来。","example":{"text":"他采取土洋结合的办法解决了这个难题。"},"similar":["中西合璧"],"opposite":["一成不变"],"usage":"作谓语、定语；指中外结合"},{"id":12634,"word":"土牛木马","pinyin":"tǔ niú mù mǎ","abbr":"tnmm","explanation":"泥塑的牛，木做的马。比喻没有实用的东西。","source":{"text":"知物之伪者，不必去物，譬如见土牛木马，虽情存牛马之名，而心忘牛马之实。","book":"《关尹子·八筹》"},"example":{"text":"若门资之中而得愚瞽，是则～，形似而用非，不可以涉道也。","book":"《北史·苏绰传》"},"similar":["土鸡瓦犬"],"usage":"作宾语、定语；指没有实用的东西"},{"id":12635,"word":"土牛石田","pinyin":"tǔ niú shí tián","abbr":"tnst","explanation":"石田：不可耕种的田。指无用之物。比喻没有用处。","source":{"text":"土牛耕石田，未有得稻田。","book":"《左传·哀公十一年》：“得志于齐，犹获石田也，无所用之。”唐·寒山《诗三百三首》"}},{"id":12636,"word":"土生土养","pinyin":"tǔ shēng tǔ yǎng","abbr":"tsty","explanation":"土：本地的、本国的。当地成长起来的。","example":{"text":"老舍当然是极优秀的作家，对我影响也是有的，但我自己并不是～的北京人。","book":"刘心武《人面鱼·创作谈》"}},{"id":12637,"word":"土生土长","pinyin":"tǔ shēng tǔ zhǎng","abbr":"tstz","explanation":"当地生长的。","source":{"text":"我们这些干部，大多数是好的，是土生土长，联系群众，经过长期斗争考验的。","book":"毛泽东《在中共八届二中全会上的讲话》"},"example":{"text":"他是当地～人。"},"similar":["根生土长"],"usage":"作谓语、定语；指当地生长的"},{"id":12638,"word":"土瘠民贫","pinyin":"tǔ jí mín pín","abbr":"tjmp","explanation":"土地贫瘠，人民贫穷。","source":{"text":"穷边气寒，土瘠民贫，景略以勤俭帅众，二岁之后，储备完实，雄于北边。","book":"《资治通鉴·唐纪·德宗贞元十二年》"},"example":{"text":"正一村在青州西偏，大小烟户，虽然繁庶，却是～，庶而不富，所以这番饥馑，正一村受灾最重。","book":"清·俞万春《荡寇志》第九十九回"}},{"id":12639,"word":"土皇帝","pinyin":"tǔ huáng dì","abbr":"thd","explanation":"指盘踞一方有势力的人物。","source":{"text":"他一个人在石圪节，当个‘土皇帝’，倒也满足了他的虚荣心。","book":"路遥《平凡的世界》第四卷第46章"},"similar":["土霸王","地头蛇"],"usage":"作宾语、定语；用于口语"},{"id":12640,"word":"土穰细流","pinyin":"tǔ rǎng xì liú","abbr":"trxl","explanation":"土壤：泥土；细流：小河。比喻细小的事物。也指事物虽甚细微，但不断积累，即能发挥巨大作用。","source":{"text":"是以太山不让土穰，故能成其大；河海不择细流，故能就其深。","book":"《史记·李斯列传》"}},{"id":12641,"word":"土豪劣绅","pinyin":"tǔ háo liè shēn","abbr":"thls","explanation":"土豪：乡里的豪强，即仗势欺人的地主。劣绅：地方上的恶霸或退职官僚中的恶劣者。旧社会有钱有势、横行乡里的人。","source":{"text":"只有土豪劣绅看了害怕，革命党决不应该看了害怕。","book":"毛泽东《湖南农民运动考察报告》"},"example":{"text":"小市民痛恨贪官污吏，～。","book":"茅盾《封建的小市民文艺》"},"similar":["为富不仁"],"opposite":["平民百姓"],"usage":"作宾语、定语；指地主、恶霸"},{"id":12642,"word":"土里土气","pinyin":"tǔ lǐ tǔ qì","abbr":"tltq","explanation":"指没有见过世面，具有或表现出各种乡下人特性的样子。","source":{"text":"只有坐在门口烧饼摊子后面那张桌子上，土里土气，贼头贼脑的两个茶客，不但不跟人招呼，而且两双眼睛只盯着过往行人。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"他的打扮真是～。"},"similar":["乡里乡气"],"opposite":["洋里洋气"],"usage":"作谓语、定语；用于口语"},{"id":12643,"word":"土阶茅屋","pinyin":"tǔ jiē máo wū","abbr":"tjmw","explanation":"泥土的台阶，茅草的房屋。比喻住房简陋。","source":{"text":"上栋下宇，土阶茅屋。","book":"《周书·武帝纪下》"},"similar":["土阶茅茨","茅室土阶","茅茨土阶"],"opposite":["高楼大厦","雕梁画栋"],"usage":"作宾语、定语；比喻住房简陋"},{"id":12644,"word":"土阶茅茨","pinyin":"tǔ jiē máo cí","abbr":"tjmc","explanation":"比喻住房简陋。同“土阶茅屋”。","source":{"text":"昔我乃祖，宣其明德，克佐帝尧，誓为典则。土阶茅茨，匪雕匪饰。","book":"汉·张衡《东京赋》：“慕唐虞之茅茨。思夏后之卑室。”汉·扬雄《逐贫赋》"},"example":{"text":"昔尧舜在位，～，禹居卑宫，不以为陋。","book":"明·冯梦龙《东周列国志》第三回"},"similar":["土阶茅屋","茅室土阶","茅茨土阶"],"opposite":["高楼大厦","雕梁画栋"],"usage":"作宾语、定语；比喻住房简陋"},{"id":12645,"word":"土鸡瓦犬","pinyin":"tǔ jī wǎ quǎn","abbr":"tjwq","explanation":"用泥捏的鸡，用瓦做的狗。比喻徒有虚名而无实用的东西。","source":{"text":"关公曰：‘以吾观之，如土鸡瓦犬耳！’","book":"明·罗贯中《三国演义》第25回"},"example":{"text":"一个个手足无措，像～一样蜷伏在路旁。","book":"延波真《五四前后山东人民的爱国斗争》"},"similar":["陶鸡瓦犬","土鸡瓦狗"],"usage":"作宾语、定语；指无实用的东西"},{"id":12646,"word":"土鸡瓦狗","pinyin":"tǔ jī wǎ gǒu","abbr":"tjwg","explanation":"比喻徒有虚名而无实用的东西。同“土鸡瓦犬”。","source":{"text":"凶恶军警呆住了，一个个手足无措，像土鸡瓦狗一样蜷伏在路旁。","book":"延波真《五四前后山东人民的爱国斗争》"},"similar":["土鸡瓦犬"],"usage":"作宾语、定语；指无实用的东西"},{"id":12647,"word":"土龙刍狗","pinyin":"tǔ lóng chú gǒu","abbr":"tlcg","explanation":"泥土捏的龙，稻草扎的狗。比喻名不副实。","source":{"text":"曹丕篡弑，自立为帝，是犹土龙刍狗之有名也。","book":"《三国志·蜀书·杜微传》"},"similar":["陶鸡瓦犬"],"usage":"作宾语、定语；指名不副实"},{"id":12648,"word":"土龙沐猴","pinyin":"tǔ lóng mù hóu","abbr":"tlmh","explanation":"比喻徒有虚名，而无其实。","source":{"text":"时俗方标榜门户，征逐声利，以为土龙沐猴，非所以自树立，视之蔑如也。","book":"清·钱谦益《都察院左都御史赠特进光禄大夫柱国太保吏部尚书谥忠文李公神道碑》"},"similar":["土鸡瓦狗"],"usage":"作宾语、定语；用于比喻句"},{"id":12649,"word":"土龙致雨","pinyin":"tǔ lóng zhì yǔ","abbr":"tlzy","explanation":"旧时迷信的人认为土龙可以引来雨云。比喻无用的东西也有利用的机会或场合。","source":{"text":"磁石上飞，云母水来，土龙致雨，燕雁代飞。","book":"《淮南子·地形训》"}},{"id":12650,"word":"圣主垂衣","pinyin":"shèng zhǔ chuí yī","abbr":"szcy","explanation":"形容天下太平，无为而治。","source":{"text":"黄帝、尧、舜垂衣裳而天下治，盖取诸葛亮乾坤。","book":"语出《易·系辞下》"},"example":{"text":"玉烛调和，～。","book":"元本高明《琵琶记·旌表》"},"usage":"作宾语、定语；用于比喻句"},{"id":12651,"word":"圣之时者","pinyin":"shèng zhī shí zhě","abbr":"szsz","explanation":"圣：圣人。指圣人中能适应时势发展的人。旧时常用来称颂孔子。","source":{"text":"孔子圣之时者也。","book":"《孟子·万章下》"},"example":{"text":"王利发真像个“～也”，不但没使“裕泰”灭亡，而且使它有了新的发展。","book":"老舍《茶馆》第二幕"}},{"id":12652,"word":"圣人忘情","pinyin":"shèng rén wàng qíng","abbr":"srwq","explanation":"圣人：具有崇高道德的人物。指圣人不为感情所动。","source":{"text":"圣人忘情，最下不及情，情之所钟，正在我辈。","book":"南朝·宋·刘义庆《世说新语·伤逝》"},"opposite":["儿女情长"],"usage":"作宾语、定语；指不为感情所动"},{"id":12653,"word":"圣人无常师","pinyin":"shèng rén wú cháng shī","abbr":"srwcs","explanation":"圣人：旧指品德高尚、智慧超群的人；常：永久的。圣人没有固定不变的老师。比喻无论是谁，只要有长处，就向他学习。","source":{"text":"对人无常师，孔子师剡子、苌弘、师襄、老聃。","book":"唐·韩愈《师说》"}},{"id":12654,"word":"圣君贤相","pinyin":"shèng jīng xián xiàng","abbr":"sjxx","explanation":"圣明的君主与贤良的辅佐大臣。有君臣相契意。相，辅弼之臣，后专指宰相。","source":{"text":"若夫兼而覆之，兼而爱之，兼而制之，岁虽凶败水旱，使百姓无冻馁之患，则是圣君贤相之事也。","book":"《荀子·富国》"},"example":{"text":"唐有天下二百年矣。～相踵。","book":"唐韩愈《答刘秀才论史书》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":12655,"word":"圣帝明王","pinyin":"shèng dì míng wáng","abbr":"sdmw","explanation":"本指上古道德智能卓越的君主。后泛称历代英明的帝王。","source":{"text":"汉兴，去圣帝明王遐远，仲尼之道又绝，法度无所因袭。","book":"汉刘歆《移书让太常博士》"},"example":{"text":"自古～、忠臣烈士，各令所在长吏以礼致祭。","book":"唐陆贽《贞元九年冬至大礼赦制》"},"usage":"作主语、宾语、定语；用于皇帝"},{"id":12656,"word":"圣神文武","pinyin":"shèng shén wén wǔ","abbr":"ssww","explanation":"称颂帝王或杰出人物之词。","source":{"text":"帝德广运，乃圣乃神，乃武乃文。","book":"《书·大禹谟》"},"example":{"text":"身女子也，则虽～，不得仁宦。","book":"康有为《大同书》戊部第一章"},"usage":"作宾语、定语；多用于夸奖称赞人"},{"id":12657,"word":"圣经贤传","pinyin":"shèng jīng xián zhuàn","abbr":"sjxz","explanation":"旧指圣人手订的经典和贤人阐释的著作。","source":{"text":"圣经贤传，屏而不省，要妙之义，无自而寻。","book":"唐韩愈《答殷侍御书》"},"example":{"text":"我希望把它当成一部大有神圣意味的～看待——不，这样还说得太菲薄了。","book":"郭沫若《洪波曲》第七章六"},"usage":"作主语、宾语、定语；作经典著作"},{"id":12658,"word":"在人口耳","pinyin":"zài rén kǒu ěr","abbr":"zrke","explanation":"被人们所称道、传颂的。","source":{"text":"相距几千百年，犹昭灼在人口耳。","book":"清·汪琬《答王进士书》"},"example":{"text":"迹君经办地方庶务，无虑数千百件，皆卓卓～，不可悉志，志其大者。（《朝议大夫广西柳州府知府杨君愚墓志铭》）"},"usage":"作谓语、定语；用于书面语"},{"id":12659,"word":"在人屋檐下，不得不低头","pinyin":"zài rén wū yán xià，bù dé bù dī tóu","abbr":"zrwyxbdbdt","explanation":"比喻受制于人，只得顺从","source":{"text":"他劝你留得青山在，不怕没柴烧，在人屋檐下，不得不低头。","book":"《上饶集中营·炼狱杂记》"},"similar":["在他檐下过，不敢不低头"],"usage":"作宾语、定语、分句；用于处事"},{"id":12660,"word":"在人矮檐下，怎敢不低头","pinyin":"zài rén ǎi yán xià，zěn gǎn bù dī tóu","abbr":"zrayxzgbdt","explanation":"比喻受制于人，只得顺从。","source":{"text":"古人道：‘不怕官，只怕管。’‘在人矮檐下，怎敢不低头。’只是小心便是。","book":"明·施耐庵《水浒传》第28回"},"example":{"text":"～，我只好委曲求全。"},"similar":["在人屋檐下，不得不低头"],"usage":"作宾语、分句；指只得顺从"},{"id":12661,"word":"在人耳目","pinyin":"zài rén ěr mù","abbr":"zrem","explanation":"表示为人们所听到看到，都已熟知。","source":{"text":"明·张岱《奇字问·序》：”近取《左（传）》、《国（语）》、《史记》……诸书在人耳目前者，聊摘其一二奇字解释之。”"},"example":{"text":"豫省一灾，官吏以吞赈款兴大狱，昭昭～。","book":"清·章炳麟《满洲总督侵吞赈款书》"},"usage":"作谓语；指都已熟知"},{"id":12662,"word":"在他檐下走，怎敢不低头","pinyin":"zài tā yán xià zǒu，zěn gǎn bù dī tóu","abbr":"ztyxzzgbdt","explanation":"比喻受制于人，只得顺从","source":{"text":"‘在他檐下走，怎敢不低头！’大帅连这句俗语还不知道吗。","book":"清·李宝嘉《官场现形记》第29回"},"similar":["在他檐下过，不敢不低头"],"usage":"作宾语、定语、分句；用于处事"},{"id":12663,"word":"在他檐下过，不敢不低头","pinyin":"zài tā yán xià guò，bù gǎn bù dī tóu","abbr":"ztyxgbgbdt","explanation":"比喻受制于人，只得顺从","source":{"text":"老话头：不怕官，只怕管。在他檐下过，不敢不低头。只得要将铜钱银子出去打点。","book":"清·张南庄《何典》第二回"},"similar":["在他檐下走，怎敢不低头"],"usage":"作宾语、定语、分句；用于处事"},{"id":12664,"word":"在劫难逃","pinyin":"zài jié nán táo","abbr":"zjnt","explanation":"旧时迷信的人认为命里注定要遭受的灾难是无法逃脱的。现有时也用来指某种灾害不可避免。","source":{"text":"那两个是船家将钱觅到，也都在劫数里不能逃。","book":"元·无名氏《冯玉兰夜月泣江舟》"},"example":{"text":"挨一天是一天唄。～，有什么法儿？","book":"姚雪垠《李自成》第一卷第24章"},"similar":["劫数难逃","坐以待毙","在所难免"],"opposite":["洪福齐天","鸿运高照"],"usage":"作谓语、分句；指不可避免"},{"id":12665,"word":"在在皆是","pinyin":"zài zài jiē shì","abbr":"zzjs","explanation":"在在：一个挨一个。到处都是，形容极其常见。","source":{"text":"仆疑足下于诗文之甘苦，尚未深历，故觉与我争名者在在皆是，而独震于考订家琐屑斑驳以为其传校可必耶？","book":"清·袁枚《答友人某论文书》"},"example":{"text":"像我一般的人～，而且未必如我一般，你何不一个个去寻着他们痛骂，却单在这里骂我一人？（清·张春帆《九尾龟》第十六回）"},"similar":["比比皆是"],"usage":"作谓语、定语；用于书面语"},{"id":12666,"word":"在天之灵","pinyin":"zài tiān zhī líng","abbr":"ztzl","explanation":"迷信指人死后升了天的灵魂。尊称死者的精神。","source":{"text":"遗弓故剑，群臣皆当追慕号泣，思所以报在天之灵。","book":"宋·陆游《渭南文集·湖州常照院记》"},"example":{"text":"我并非说，大家都须天天去痛哭流涕，以凭吊先烈的“～”，一年中有一天记住他们就可以了。","book":"鲁迅《而已集·黄花节的杂感》"},"usage":"作主语、宾语、定语；尊称死者的精神"},{"id":12667,"word":"在天愿作比翼鸟","pinyin":"zài tiān yuàn zuò bǐ yì niǎo","abbr":"ztyzbyn","explanation":"比翼鸟：传说中的一种鸟，雌雄总在一起飞，古诗中比喻恩爱夫妻。愿作天上的比翼鸟。比喻夫妻感情深厚。","source":{"text":"在天愿作比翼鸟，在地愿为连理枝。","book":"唐·白居易《长恨歌》"}},{"id":12668,"word":"在官言官","pinyin":"zài guān yán guān","abbr":"zgyg","explanation":"指处在什么样的地位就说什么样的话。","source":{"text":"君命，大夫与士肄，在官言官，在府言府，在库言库，在朝言朝。","book":"《礼记·曲礼下》"},"example":{"text":"～。我们既是私宅相见，何妨脱略些，何必客气。","book":"清·吴趼人《近十年之怪现状》"},"similar":["在官言官，在府言府"],"usage":"作谓语、定语；指处在什么地位就说什么话"},{"id":12669,"word":"在官言官，在府言府","pinyin":"zài guān yán guān，zài fǔ yán fǔ","abbr":"zgygzfyf","explanation":"指处在什么样的地位就说什么样的话。","source":{"text":"君命，大夫与士肄，在官言官，在府言府，在库言库，在朝言朝。","book":"《礼记·曲礼下》"},"similar":["在官言官"],"usage":"作宾语、定语；用于处事"},{"id":12670,"word":"在家出家","pinyin":"zài jiā chū jiā","abbr":"zjcj","explanation":"出家：做僧尼或道士。指不出家当和尚或道士，清心寡欲，在家修行。","source":{"text":"故戒法理旷事深，在家出家，平等而受。","book":"唐·道世《法苑珠林》卷一○七"},"example":{"text":"老身终南山人氏，在此～，盖了一座团标。","book":"元·马致远《黄梁梦》第四折"},"usage":"作谓语；指在家修行"},{"id":12671,"word":"在所不免","pinyin":"zài suǒ bù miǎn","abbr":"zsbm","explanation":"免：避免。指由于某种限制而不能避免。","source":{"text":"即或不致明言取怨，那牵衣咳嗽，暗打机关，种种薄行，在所不免也。","book":"清·吴璿《飞龙全传》第十七回"},"example":{"text":"粮不实腹，衣不覆体，万目肙肙，无所控告，以致道上物故者，～。（清·毕沅《续资治通鉴》卷一百九十七）"},"similar":["在所难免"],"usage":"作谓语、定语；用于口语"},{"id":12672,"word":"在所不惜","pinyin":"zài suǒ bù xī","abbr":"zsbx","explanation":"在：处于。表示处于某种情况，决不吝惜。","source":{"text":"乐极生悲，俗语不诬。妾病不能扶持，生愿不谐，死亦从兄，在所不惜也。","book":"明·无名氏《娇红传》"},"example":{"text":"果能撄城固守，区区民房，原～。","book":"清·金念劬《避兵十日记》"},"similar":["在所不辞"],"usage":"作谓语；形容不吝啬"},{"id":12673,"word":"在所不辞","pinyin":"zài suǒ bù cí","abbr":"zsbc","explanation":"决不推辞（多用在冒险犯难）。","source":{"text":"只须能尽我的微薄的力量，推进或促成这个主张的实现，任何个人的艰险，是在所不辞的。","book":"邹韬奋《经历》"},"example":{"text":"对于你的请求我是～的。"},"similar":["义不容辞"],"usage":"作谓语、宾语；指不推辞"},{"id":12674,"word":"在所自处","pinyin":"zài suǒ zì chǔ","abbr":"zszc","explanation":"处：处理。在于自己如何处世。形容在一定的环境中，要自己选择立足之处。","source":{"text":"斯入仓，观仓中鼠，食积粟，居大庑之下，不见人犬之忧。于是李斯乃叹曰：‘人之贤不肖譬如鼠矣，在所自处耳！’","book":"《史记·李斯列传》"},"usage":"作宾语、定语；用于书面语","story":["秦朝大臣李斯年轻时上厕所见到老鼠争吃蛆吃，见到人来后仓皇逃跑，到官仓时见到老鼠们正在细嚼慢咽，根本不理会人。李斯不由感慨万分，同是老鼠竟有天壤之别，生活的环境不同，爬上去为贤者、君子，沦落下层的就是愚民、小人"]},{"id":12675,"word":"在所难免","pinyin":"zài suǒ nán miǎn","abbr":"zsnm","explanation":"免：避免。指由于某种限制而难于避免。","source":{"text":"或者阳示和好，暗施奸刁的，亦在所难免。","book":"清·李宝嘉《活地狱》第九回"},"example":{"text":"这本书不是方言调查统计，应收未收或不该收而收的词～。","book":"吴宗济《序》"},"similar":["在所无免"],"usage":"作谓语、定语；用于谦词"},{"id":12676,"word":"在此一举","pinyin":"zài cǐ yī jǔ","abbr":"zcyj","explanation":"在：在于，决定于；举：举动，行动。指事情的成败就决定于这一次的行动。","source":{"text":"国家安危，在此一举。","book":"《史记·项羽本纪》"},"example":{"text":"擒拿杨么，～。","book":"清·钱彩《说岳全传》第五十三回"},"similar":["一锤子买卖"],"usage":"作谓语；指关键时刻"},{"id":12677,"word":"在此存照","pinyin":"zài cǐ cún zhào","abbr":"zccz","explanation":"照：查考，察看。写下字据保存进来，以作凭证。","source":{"text":"执凭公文，在此存照。","book":"明·施耐庵《水浒传》第22回"},"similar":["立此存照"],"usage":"作谓语；指写下字据保存进来，以作凭证"},{"id":12678,"word":"在耳历历","pinyin":"zài ěr lì lì","abbr":"zell","explanation":"形容往日听到的声音清清楚楚在耳边回响。","source":{"text":"及从先公游，磨砻乎道义而服膺其家范之懿，至今在耳历历也。","book":"宋·陈亮《祭王文卿父母文》"}},{"id":12679,"word":"在色之戒","pinyin":"zài sè zhī jiè","abbr":"zszj","explanation":"指色欲方面的戒忌。","source":{"text":"少之时，血气未定，戒之在色。","book":"语出《论语·季氏》"}},{"id":12680,"word":"在行嫌行","pinyin":"zài háng yán háng","abbr":"zhxx","explanation":"行：行业；嫌：嫌弃。干哪一行的人就嫌哪一行不好。","example":{"text":"有很多人不爱自己的艺术，～，这是不对的。"}},{"id":12681,"word":"在谷满谷","pinyin":"zài gǔ mǎn gǔ","abbr":"zgmg","explanation":"此指奏乐时声音遍及各处，形容道的无所不在。后形容人物众多。","source":{"text":"吾又奏之以阴阳之和，烛之以日月之明；其声能短能长，能柔能刚；变化齐一，不主故常；在谷满谷，在坑满坑。","book":"《庄子·天运》"},"usage":"作谓语、定语；用于书面语"},{"id":12682,"word":"在谷满谷，在坑满坑","pinyin":"zài gǔ mǎn gǔ，zài kēng mǎn kēng","abbr":"zgmgzkmk","explanation":"在山谷里就充满山谷，在水坑里就充满水坑。形容非常多，到处都是。","source":{"text":"在谷满仓，在坑满坑。","book":"《庄子·天运》"}},{"id":12683,"word":"在陈之厄","pinyin":"zài chén zhī è","abbr":"zcze","explanation":"指饥贫等困境。","source":{"text":"（孔子）在陈绝粮，从者病，莫能兴。子路愠，见曰：‘君子亦有穷乎？’子曰：‘君子固穷，小人穷斯滥矣。’","book":"《论语·卫灵公》"},"example":{"text":"幸亏女大王将衣箱送还；若不送还，只怕还有甚么‘～’哩！","book":"清·李汝珍《镜花缘》第五十一回"},"similar":["陈蔡之厄"],"usage":"作宾语；指旅途困境"},{"id":12684,"word":"圭璋特达","pinyin":"guī zhāng tè dá","abbr":"gztd","explanation":"形容德才卓绝，与众不同。","source":{"text":"圭璋特达，德也。","book":"西汉·戴圣《礼记·聘义》"},"example":{"text":"此子～，机警有锋。","book":"南朝·宋·刘义庆《世说新语》"},"usage":"作谓语、定语；指人的才德"},{"id":12685,"word":"圭端臬正","pinyin":"guī duān niè zhèng","abbr":"gdnz","explanation":"圭：土圭，测日影的仪器；臬：表臬：测广狭的仪器。像圭臬一样的标准。比喻准则、典范。"},{"id":12686,"word":"圭角不露","pinyin":"guī jiǎo bù lù","abbr":"gjbl","explanation":"圭角：圭之锋芒有棱角。指深沉不露锋芒。","source":{"text":"圭角谓圭之锋芒有楞角。言儒者身恒方正，若物有圭角；不欲异众过甚，去其大圭角，言犹有小圭角也。","book":"《礼记·儒行》“毁方而瓦合”汉郑玄注：“去己之大圭角，下与众小人合也。”孔颖达疏"},"example":{"text":"只是元气浑然，～，便是持身涉世一安乐窝也。","book":"明·洪应明《菜根谭·应酬》"}},{"id":12687,"word":"圭角岸然","pinyin":"guī jiǎo àn rán","abbr":"gjar","explanation":"形容风操严峻。"},{"id":12688,"word":"圮上老人","pinyin":"yí shàng lǎo rén","abbr":"pslr","explanation":"圮：桥。桥上的老者。比喻为人所希冀仰慕的人。"},{"id":12689,"word":"地上天官","pinyin":"dì shàng tiān guān","abbr":"dstg","explanation":"比喻社会生活繁华安乐。"},{"id":12690,"word":"地上天宫","pinyin":"dì shàng tiān gōng","abbr":"dstg","explanation":"比喻社会生活繁华安乐。","source":{"text":"汴中呼余杭百事繁庶，地上天宫。","book":"宋·袁褧《枫窗小牍》卷上"},"example":{"text":"富兼华夷，余杭又为甲，百事繁庶，～。","book":"宋·陶谷《清异录·地理》"},"similar":["人间仙境"],"usage":"作宾语；比喻繁荣华美的生活"},{"id":12691,"word":"地下修文","pinyin":"dì xià xiū wén","abbr":"dxxw","explanation":"旧指有才文人早死。","source":{"text":"韶言天上及地下事，亦不能悉知也。颜渊、卜商今见在为修文郎。","book":"《太平御览》卷八八引王隐《晋书》"},"example":{"text":"～著作郎，生前饥处倒空墙。","book":"唐·司空图《狂题》诗"},"similar":["玉楼赴召"],"usage":"作宾语；指有才文人早死"},{"id":12692,"word":"地不爱宝","pinyin":"dì bù ài bǎo","abbr":"dbab","explanation":"爱：吝惜。大地不吝啬它的宝藏。多指地下有文物出土。","source":{"text":"故天不爱其道，地不爱其宝，人不爱其情。","book":"《礼记·礼运》"}},{"id":12693,"word":"地丑力敌","pinyin":"dì chǒu lì dí","abbr":"dcld","explanation":"指土地相似，力量相当。","source":{"text":"故文武可以王，而桓文终于伯；由周兵革缮完，欲兼并之固难也。地丑力敌，不日寻干戈不已。","book":"章炳麟《封建考》"},"usage":"作谓语、定语；用于国土等"},{"id":12694,"word":"地丑德齐","pinyin":"dì chǒu dé qí","abbr":"dcdq","explanation":"丑：同类。地相等，德相同。比喻彼此条件一样。","source":{"text":"今天下地丑德齐，莫能相尚。","book":"《孟子·公孙丑下》"},"example":{"text":"余与谷林定交且二十年，分题刻烛，良亦多矣。妄不自揣，以为当在～之意。","book":"清·全祖望《爱日堂吟稿·序》"},"similar":["不相上下"],"usage":"作谓语；比喻彼此条件一样"},{"id":12695,"word":"地主之仪","pinyin":"dì zhǔ zhī yí","abbr":"dzzy","explanation":"住在本地的人对外地客人的招待义务。同“地主之谊”。","source":{"text":"未修地主之仪，忽叨盛馔，于理不当。茅茨不远，可便下榻。","book":"清·蒲松龄《聊斋志异·三仙》"},"similar":["地主之谊"],"usage":"作宾语；用于接待外地朋友"},{"id":12696,"word":"地主之谊","pinyin":"dì zhǔ zhī yì","abbr":"dzzy","explanation":"地主：当地的主人；谊：义务。住在本地的人对外地客人的招待义务。","source":{"text":"子服景伯谓子财曰：‘夫诸侯之会，事既毕矣，侯伯致礼，地主归饩，以相辞也。’","book":"《左传·哀公十二年》"},"example":{"text":"晚生得蒙青目，一日～也不曾尽得，如何便要去？","book":"清·吴敬梓《儒林外史》第二十二回"},"similar":["东道之谊"],"usage":"作宾语；用于接待外地朋友"},{"id":12697,"word":"地久天长","pinyin":"dì jiǔ tiān cháng","abbr":"djtc","explanation":"时间长，日子久。","source":{"text":"天长地久，天地所以能长且久者，以其不自生，故能长生。","book":"春秋·楚·李耳《老子》"},"example":{"text":"惟愿取恩情美满，～。","book":"清·洪昇《长生殿·定情》"},"similar":["天长日久","旷日持久","长此以往"],"opposite":["昙花一现","弹指之间","稍纵即逝"],"usage":"作谓语、定语；形容两人的关系"},{"id":12698,"word":"地利人和","pinyin":"dì lì rén hé","abbr":"dlrh","explanation":"地利：地理的优势；人和：得人心。表示优越的地理条件和群众基础。","source":{"text":"天时不如地利，地利不如人和。","book":"《孟子·公孙丑下》"},"example":{"text":"虽然犯了一次错误，红军已卷土重来此～之边界，前途希望还是不恶。","book":"毛泽东《井岗山的斗争》"},"similar":["得天独厚","天时地利"],"opposite":["内外交困","逆水行舟","众叛亲离"],"usage":"作主语、宾语、定语；与“天时”连用","story":["战国时期，有人问孟子怎样做才能算圣主明君。孟子说只有用仁政来治理天下，因为天时不如地利，地利不如人和。拿打仗来举例，敌人会利用地势与天气等优势据城抵抗，如果城内居民讨厌暴政，他们会纷纷起来反抗，开门迎接对方"]},{"id":12699,"word":"地动山摇","pinyin":"dì dòng shān yáo","abbr":"ddsy","explanation":"地震发生时大地颤动，山河摇摆。亦形容声势浩大或斗争激烈。","source":{"text":"臣恐地动山摇，从此灾祸自此而始。","book":"宋·欧阳修《欧阳文忠公集·奏议集·一二·论修河第一状》"},"example":{"text":"鼓角大鸣，～。","book":"宋·吴曾《能改斋漫笔》卷二"},"similar":["天塌地陷","天翻地覆","山崩地裂"],"opposite":["风平浪静","纹丝不动"],"usage":"作谓语、定语、补语；指巨大影响"},{"id":12700,"word":"地动山摧","pinyin":"dì dòng shān cuī","abbr":"ddsc","explanation":"地震发生时大地颤动，山河摇摆。亦形容声势浩大或斗争激烈。同“地动山摇”。","source":{"text":"子胥祭了，发声大哭，感得日月无光，江河混沸。忽即云昏雾暗，地动山摧。兵行唅啼，人伦凄怆。","book":"《敦煌变文集·伍子胥变文》"},"similar":["地动山摇"],"usage":"作谓语、定语、补语；指巨大影响"},{"id":12701,"word":"地北天南","pinyin":"dì běi tiān nán","abbr":"dbtn","explanation":"一在地之北，一在天之南。形容地区各不相同。也形容距离极远。","source":{"text":"为天有眼兮何不见我独漂流，为神有灵兮何事处我天南海北头。","book":"汉·蔡琰《胡笳十八拍》"},"example":{"text":"人生聚散，信如浮云，～，会有相见。","book":"元·萨都刺《相逢行赠别旧友治将军序》"},"similar":["天南地北"],"opposite":["近在咫尺"],"usage":"作宾语、定语；指遥远"},{"id":12702,"word":"地地道道","pinyin":"dì dì dào dào","abbr":"dddd","explanation":"真正的，够标准的。","source":{"text":"这位桑庄大队的党支部书记是一位地地道道的农民。","book":"肖兵《太行青松》"},"example":{"text":"她操一口～的美语。"},"similar":["道道地地"],"usage":"作谓语、定语；指非常地道"},{"id":12703,"word":"地坼天崩","pinyin":"dì chè tiān bēng","abbr":"dctb","explanation":"坼：开裂；崩：倒塌。地裂开，天崩塌。原指地震，后多比喻重大变故。","source":{"text":"天崩地坼，天子下席。","book":"西汉·刘向《战国策·赵策三》"},"example":{"text":"自去年以来，灾祸频数，～，高岸为谷。","book":"南朝·宋·范晔《后汉书·翟酺传》"},"similar":["天崩地裂"],"usage":"作宾语、定语；比喻重大变故"},{"id":12704,"word":"地塌天荒","pinyin":"dì tā tiān huāng","abbr":"dtth","explanation":"犹言天塌地陷。形容盛怒。","source":{"text":"喜时节和风甘雨，怒时节地塌天荒。","book":"明·徐复祚《投俊记·魔见》"},"usage":"作谓语、定语；用于人或事物"},{"id":12705,"word":"地大物博","pinyin":"dì dà wù bó","abbr":"ddwb","explanation":"博：丰富。指国家疆土辽阔，资源丰富。","source":{"text":"地大物博，蘖牙其间。","book":"唐·韩愈《平淮西碑》"},"example":{"text":"又因江南～，差使很多，大非别省可比。","book":"清·李宝嘉《官场现形记》第二十九回"},"similar":["地广人稀","幅员辽阔","海阔天空"],"opposite":["弹丸之地","置锥之地","一隅之地"],"usage":"作谓语、定语；形容一个大国"},{"id":12706,"word":"地头蛇","pinyin":"dì tóu shé","abbr":"dts","explanation":"指在当地有势力的欺压人民的恶霸。比喻本地有一定能量的人物。","source":{"text":"大官人休说满话！常言道：恶龙不斗地头蛇。","book":"明·冯梦龙《醒世恒言》第七卷"},"example":{"text":"这可不是在原西，咱们是外来户，怎么敢和这里的～打斗呢？","book":"路遥《平凡的世界》第三卷第26章"},"opposite":["外来户"],"usage":"作主语、宾语、定语；用于口语"},{"id":12707,"word":"地嫌势逼","pinyin":"dì xián shì bī","abbr":"dxsb","explanation":"嫌：嫌疑。处在嫌疑之地，为形势所逼迫。","source":{"text":"然高祖所以有天下，皆太宗之功，隐太子以庸劣居其右，地嫌势逼，必不相容。","book":"《资治通鉴·唐纪·高祖武德九年论》"}},{"id":12708,"word":"地尽其利","pinyin":"dì jìn qí lì","abbr":"djql","explanation":"尽：尽力，充分。使土地、山川、地面上下物质资源充分发挥其作用。","source":{"text":"人能尽其才，地能尽其利，物能尽其用，货能畅其流，此四事者，富强之大经，治国之大本也。","book":"孙中山《上李鸿章书》"},"similar":["地无遗利"],"usage":"作宾语、定语；用于政策等"},{"id":12709,"word":"地崩山摧","pinyin":"dì bēng shān cuī","abbr":"dbsc","explanation":"土地崩裂，山岭倒塌。多形容巨大变故。","source":{"text":"地崩山摧壮士死，然后天梯石栈方钩连。","book":"唐·李白《蜀道难》"},"example":{"text":"这一振动不亚于～。"},"similar":["土崩瓦解","山崩地裂"],"usage":"作谓语、宾语、状语；形容巨大变化"},{"id":12710,"word":"地平天成","pinyin":"dì píng tiān chéng","abbr":"dptc","explanation":"平：治平；成：成功。原指禹治水成功而使天之生物得以有成。后常比喻一切安排妥帖。","source":{"text":"地平天成，六府三事允治，万世永赖，时乃功。","book":"《尚书·大禹谟》"},"example":{"text":"舜臣尧，举八恺，使主后土，以揆百事，莫不时序，～。","book":"春秋·鲁·左丘明《左传·文公十八年》"},"similar":["天成地平"],"usage":"作谓语；比喻上下相称"},{"id":12711,"word":"地广人众","pinyin":"dì guǎng rén zhòng","abbr":"dgrz","explanation":"指土地广阔，人民众多。","source":{"text":"中国虽然是一个伟大的民族国家，虽然是一个地广人众、历史悠久而富于革命传统和优秀遗产的国家。","book":"毛泽东《中国革命和中国共产党》"},"similar":["广土众民"],"usage":"作宾语、定语；指土地广阔，人民众多"},{"id":12712,"word":"地广人希","pinyin":"dì guǎng rén xī","abbr":"dgrx","explanation":"广：宽阔；希：通“稀”，稀少。指土地广大，人烟稀少","source":{"text":"总之，楚越之地，地广人希。","book":"西汉·司马迁《史记·货殖列传》"},"similar":["地广人稀"],"opposite":["地狭人稠"],"usage":"作谓语、定语；指地方大，人烟少"},{"id":12713,"word":"地广人稀","pinyin":"dì guǎng rén xī","abbr":"dgrx","explanation":"地方大，人烟少。","source":{"text":"习俗颇殊，地广民稀。","book":"《汉书·地理志下》"},"example":{"text":"奈缘～，首尾不能救应。","book":"明·施耐庵《水浒全传》第八十三回"},"similar":["人迹罕至","渺无人烟"],"opposite":["地狭人稠"],"usage":"作谓语、定语；指地方大，人烟少"},{"id":12714,"word":"地广民众","pinyin":"dì guǎng mín zhòng","abbr":"dgmz","explanation":"土地广阔，百姓众多。","source":{"text":"地广民众的中国要统一意志与集中力量，必得有为公众的喉舌，打通层层的壁垒。","book":"朱自清《新中国在望中》"},"similar":["地广人众"],"opposite":["地狭人稠"],"usage":"作谓语、定语；用于国情"},{"id":12715,"word":"地广民稀","pinyin":"dì guǎng mín xī","abbr":"dgmx","explanation":"地方大，人烟少。","source":{"text":"习俗颇殊，地广民稀。","book":"《史记·货殖列传》：“楚越之地，地广人希。”《汉书·地理志下》"},"similar":["地广人稀"],"usage":"作谓语、定语；指地方大，人烟少"},{"id":12716,"word":"地无遗利","pinyin":"dì wú yí lì","abbr":"dwyl","explanation":"地面上下的资源全部开发，没有遗漏。","source":{"text":"人无弃材，地无遗利，君民不隔，名实必副。","book":"清·冯桂芬《校邠庐抗议》"},"similar":["地尽其利"],"usage":"作宾语、定语；用于政策等"},{"id":12717,"word":"地旷人稀","pinyin":"dì kuàng rén xī","abbr":"dkrx","explanation":"地方大，人烟少。","source":{"text":"习俗颇殊，地广民稀。","book":"《汉书·地理志下》"},"example":{"text":"离此十五里之地，叫做介山，～，都是绿林中好汉出没之处。","book":"明·冯梦龙《警世通言》卷二十一"},"similar":["地广人稀"],"opposite":["人烟稠密"],"usage":"作谓语、定语；指地多人少"},{"id":12718,"word":"地棘天荆","pinyin":"dì jí tiān jīng","abbr":"djtj","explanation":"指到处布满荆棘。比喻环境恶劣。","source":{"text":"地棘天荆谁管得，此身权寄水云邨。","book":"朱谦良《感怀和病侠》"},"usage":"作宾语、定语；用于处境或局势"},{"id":12719,"word":"地灵人杰","pinyin":"dì líng rén jié","abbr":"dlrj","explanation":"灵：好；杰：杰出。指有杰出的人降生或到过，其地也就成了名胜之区。","source":{"text":"人杰地灵，徐孺下陈蕃之榻。","book":"唐·王勃《滕王阁诗序》"},"example":{"text":"这正是‘～’；老天生人，再不虚赋性情的。","book":"清·曹雪芹《红楼梦》第48回"},"similar":["地灵人杰"],"usage":"作谓语、定语；赞扬别人的家乡","story":["唐朝时“初唐四杰”的王勃因为他的《檄英王鸡》得罪了唐高宗而被放逐，他到交趾探望父亲，路经洪州，恰好是重阳节，洪州都督阎伯屿大宴宾客，吟诗作乐，王勃起兴作诗“物华天宝，龙光射斗牛之墟，人杰地灵，徐孺下陈蕃之榻。”"]},{"id":12720,"word":"地狭人稠","pinyin":"dì xiá rén chóu","abbr":"dxrc","explanation":"稠：密、多。土地狭窄，人口稠密。即地少人多，非常拥挤。","source":{"text":"同进食堂进膳，今夜有舞会，地狭人稠，毫无虚席。","book":"郭沫若《苏联纪行·六月十三日》"},"opposite":["地广人稀"],"usage":"作谓语、定语；用于国情等"},{"id":12721,"word":"地狱变相","pinyin":"dì yù biàn xiàng","abbr":"dybx","explanation":"旧时比喻社会的黑暗残酷。","source":{"text":"吴道子画地狱变相，都人咸观，惧罪修善。","book":"宋·黄休复《益州名画录》"},"usage":"作宾语；指现实生活的残酷"},{"id":12722,"word":"地瘠民贫","pinyin":"dì jí mín pín","abbr":"djmp","explanation":"土地瘠薄，人民贫穷。","source":{"text":"先时地瘠民贫，催科愈烦，而逋负愈积，逋久不偿，视为固然。","book":"清·刘大櫆《送黟令孙君改任凤阳序》"},"example":{"text":"这些业绩表现在以～的边区，居然……能够做到人民无饥寒之虞，向着丰衣足食的生活迈进。","book":"《解放日报》1946.4.28"},"usage":"作谓语、定语；用于国情等"},{"id":12723,"word":"地网天罗","pinyin":"dì wǎng tiān luó","abbr":"dwtl","explanation":"天罗：张在空中捕鸟的网。天空地面，遍张罗网。指上下四方设置的包围圈。比喻对敌人、逃犯等的严密包围。","source":{"text":"天兵下了天罗地网者，休要走了两洞妖魔。","book":"《大宋宣和遣事》亨集：“才离阴府恓惶难，又值天罗地风灾。”元·无名氏《锁魔镜》第三折"},"example":{"text":"惊得宋公明目瞪口呆，罔不知所措，你便有文韬武略，怎逃出～。","book":"明·施耐庵《水浒全传》第四十七回"},"similar":["天罗地网"],"usage":"作主语、宾语；形容法网严密"},{"id":12724,"word":"地老天昏","pinyin":"dì lǎo tiān hūn","abbr":"dlth","explanation":"形容变化剧烈。","source":{"text":"地老天昏，没处把老娘安顿，思量起举目无亲，招魂有尽。","book":"明·汤显祖《牡丹亭·忆女》"},"usage":"作谓语、宾语；多用于比喻句"},{"id":12725,"word":"地老天荒","pinyin":"dì lǎo tiān huāng","abbr":"dlth","explanation":"指经历的时间极久。","source":{"text":"吾闻马周昔作新丰客，天荒地老无人识。","book":"唐·李贺《致酒行》"},"example":{"text":"然而海枯石烂，此恨难消，～，此情不泯！","book":"明·瞿佑《剪灯新话·绿衣人传》"},"similar":["地久天长"],"usage":"作谓语、定语；指经历的时间极久"},{"id":12726,"word":"地裂山崩","pinyin":"dì liè shān bēng","abbr":"dlsb","explanation":"崩：倒塌。山岳崩塌，大地裂开。形容响声巨大或变化剧烈。","source":{"text":"只听半空中一声大震，好似地裂山崩，抬头一看，依旧红日青天。","book":"清·无名氏《说呼全传》第19回"},"example":{"text":"这边万里无云，阳光灿烂；那边就可能风云骤起，～。","book":"路遥《平凡的世界》第四卷第33章"},"similar":["山崩地裂"],"usage":"作谓语、状语、定语；形容声势巨大"},{"id":12727,"word":"地覆天翻","pinyin":"dì fù tiān fān","abbr":"dftf","explanation":"覆：翻过来。形容变化巨大。也形容闹得很凶。","source":{"text":"天翻地覆谁得知？如今正南看北斗。","book":"唐·刘商《胡笳十八拍》六"},"example":{"text":"～，河清海浅，朱颜常驻。","book":"宋·刘克庄《水龙吟·林中书生曰·六月十九日》"},"similar":["天翻地覆"],"usage":"作状语、定语；比喻变化大"},{"id":12728,"word":"地角天涯","pinyin":"dì jiǎo tiān yá","abbr":"djty","explanation":"比喻偏远的地方或相隔很远。","source":{"text":"天涯藐藐，地角悠悠，言面无由，但似情企。","book":"南朝·陈·徐陵《武皇帝作相时与岭南酋豪书》"},"example":{"text":"行处坐处兮思念我乡曲，～兮不见我骨肉。","book":"元·赵鸾鸾《悲笳四拍》"},"similar":["天涯海角"],"opposite":["近在咫尺"],"usage":"作宾语；比喻偏远的地方或相隔很远"},{"id":12729,"word":"地负海涵","pinyin":"dì fù hǎi hán","abbr":"dfhh","explanation":"指大地负载万物，海洋容纳百川。形容包罗万象，含蕴丰富。","source":{"text":"其富若生蓄，万物必具，海含地负，放恣横从，无所统纪。","book":"语出唐·韩愈《南阳樊绍述墓志铭》"},"example":{"text":"先生之学，可谓～，渊渟岳峙矣。","book":"清·江藩《汉学师承记·朱笥河先生》"},"similar":["包罗万象"],"usage":"作谓语、宾语；用于书面语"},{"id":12730,"word":"地远山险","pinyin":"dì yuǎn shān xiǎn","abbr":"dysx","explanation":"地处边远，山势险峻。","source":{"text":"愚有片言，望丞相察之，南蛮恃其地远山险，不服久矣，虽今日破，明日复叛。","book":"明·罗贯中《三国演义》第八十七回"},"usage":"作宾语、定语；用于地理环境等"},{"id":12731,"word":"地阔天长","pinyin":"dì kuò tiān cháng","abbr":"dktz","explanation":"大地辽阔，天空广阔。","source":{"text":"地阔天长，不知归路。","book":"唐·李华《吊古战场文》"},"usage":"作宾语、定语；用于口语"},{"id":12732,"word":"坌鸟先飞","pinyin":"bèn niǎo xiān fēi","abbr":"bnxf","explanation":"比喻能力差的人做事时，怕赶不上别人，抢先动手。多用作谦词。同“笨鸟先飞”。","source":{"text":"[三末云]：二哥，你得了官也。我和你有个比喻，我似那灵禽在后，你这等坌鸟先飞。","book":"元·关汉卿《陈母教子》第一折"},"similar":["笨鸟先飞"],"usage":"作谓语、定语；比喻能力差的人加倍努力"},{"id":12733,"word":"坎井之蛙","pinyin":"kǎn jǐng zhī wā","abbr":"kjzw","explanation":"坎井：坏井，废井。废井里的青蛙。比喻见识不多的人。","source":{"text":"浅不足与测深，愚不足与谋知，坎井之蛙，不可与语东海之乐。","book":"《荀子·正论》"},"example":{"text":"宇栋之内，燕雀不知天地之高也；～，不知江海之大。","book":"汉·桓宽《盐铁论·复古》"},"similar":["井底之蛙"],"usage":"作宾语；比喻见识短浅的人","story":["很久以前，一只生活在废井里从没有跳出井来的青蛙，有吃有喝，觉得很满足。一天他好奇问路过的海龟天有多大。海龟告诉他天是如何如何广阔，青蛙不能理解海龟所描述的，总认为天只不过井口那么大，海龟在骗他开心"]},{"id":12734,"word":"坎坷不平","pinyin":"kǎn kě bù píng","abbr":"kkbp","explanation":"坎坷：道路坑坑洼洼。道路坑坑洼洼不平坦。形容前进道路上有许多困难民，不是一帆风顺的。","source":{"text":"秽南巢之坎坷兮，易幽岐之麦平。","book":"汉·扬雄《河乐赋》"},"example":{"text":"它跑得那么平稳，使骑马的人仿佛觉得它不是在～的路上跑，而是走在极其柔软的地毯上。","book":"姚雪垠《李自成》第一卷第三章"},"similar":["崎岖不平","艰难险阻"],"opposite":["一帆风顺","康庄大道","阳关大道"],"usage":"作谓语、宾语、定语；形容路途的险恶"},{"id":12735,"word":"坎止流行","pinyin":"kǎn zhǐ liú xíng","abbr":"kzlx","explanation":"遇坎而止，乘流则行。比喻依据环境的逆顺确定进退行止。","source":{"text":"孟康曰：‘《易》坎为险，遇险难而止也。’张晏曰：‘谓夷易则仕，险难则隐也。’","book":"语出《汉书·贾谊传》：“寥廓忽荒，与道翱翔。乘流则逝，得坎则止。”颜师古注"},"example":{"text":"～元无定，敢一朝、挨却尘泥迹，且剩把、锦云织。","book":"宋·张榘《金缕曲·次韵拙逸刘直孺见寄言志》词"},"similar":["流行坎止"],"usage":"作宾语、定语；用于因事而变"},{"id":12736,"word":"坏人坏事","pinyin":"huài rén huài shì","abbr":"hrhs","explanation":"有害于社会的人或事。","example":{"text":"我们要同～作坚决斗争。"},"opposite":["好人好事"],"usage":"作主语、宾语、定语；指坏事物"},{"id":12737,"word":"坏人心术","pinyin":"huài rén xīn shù","abbr":"hrxs","explanation":"使人意志消沉、萎靡不振的居心。","source":{"text":"若真能学者，如明镜在悬，凡物之来，妍媸立辨，岂为彼物所移，何能坏人心术？","book":"明·朱之瑜《朱舜水集·答安东守约问八条（其一）》"},"example":{"text":"凡淫词艳曲～，与夫得罪名教之书，悉纳其中而烧之。","book":"清·钱泳《履园丛话·种德》"},"usage":"作谓语、定语；用于书面语"},{"id":12738,"word":"坏植散群","pinyin":"huài zhí sàn qún","abbr":"hzsq","explanation":"①解散朋党。②指离心离德。","source":{"text":"则列土坏植散群，长官者不成德……列土坏植散群，则尚同也。","book":"《庄子·田子方》"},"example":{"text":"经涉人事，忧患渐多，目之所睹，耳之所闻，～，四海皆是。","book":"章炳麟《别录》卷一"},"usage":"作谓语、定语；用于书面语"},{"id":12739,"word":"坏法乱纪","pinyin":"huài fǎ luàn jì","abbr":"hflj","explanation":"破坏法制和纪律。","source":{"text":"故天子适诸侯，必舍其祖庙，而不以礼籍入，是谓天子坏法乱纪。","book":"西汉·戴圣《礼记·礼运》"},"example":{"text":"～自王朝，史书特继春秋笔。","book":"清·张鹏翀《经史法戒诗》"},"similar":["违法乱纪"],"opposite":["遵纪守法"],"usage":"作谓语；指破坏法纪"},{"id":12740,"word":"坏裳为裤","pinyin":"huài shang wéi kù","abbr":"hswk","explanation":"裳，下衣，指老百姓的服装；裤，指军装。后以之代指从军。","source":{"text":"《南史·刘穆之传》载，刘裕召刘穆之为主簿（军吏），穆之“坏布裳为裤”，往见刘裕。"},"example":{"text":"卖剑买牛衰可笑，～老犹能。","book":"宋·陆游《叹息》诗"},"usage":"作谓语、定语；指从军"},{"id":12741,"word":"坏车杀马","pinyin":"huài chē shā mǎ","abbr":"hcsm","explanation":"比喻弃官归隐。","source":{"text":"奉檄迎督邮，即路慨然，耻在厮役，因坏车杀马，毁裂衣冠，乃遁至犍为，从杜抚学。","book":"《后汉书·周燮传》"}},{"id":12742,"word":"坐上琴心","pinyin":"zuò shàng qín xīn","abbr":"zsqx","explanation":"指男子对女子的爱慕之情。","source":{"text":"《史记·司马相如列传》载，汉司马相如宴于临邛富人卓王孙家，时卓王孙有女文君新寡，相如于座上以琴声传意，文君心悦，遂夜奔相如。"},"example":{"text":"～，机中锦字，觉最萦怀抱。","book":"宋·周邦《氐州第一》词"},"usage":"作宾语、定语；用于书面语"},{"id":12743,"word":"坐不垂堂","pinyin":"zuò bù chuí táng","abbr":"zbct","explanation":"垂堂：近屋檐处。不坐在堂边外面，怕掉到台阶下。比喻不在有危险的地方停留。","source":{"text":"家累千金，坐不垂堂。","book":"《史记·司马相如列传》"},"example":{"text":"向在张园，尝以千金之子～，昭示大众。","book":"清·章炳麟《与吴君遂书》"},"similar":["谨小慎微","坐戒垂堂"],"usage":"作谓语、定语；指人自爱"},{"id":12744,"word":"坐不安席","pinyin":"zuò bù ān xí","abbr":"zbax","explanation":"席：坐席。形容心中有事，坐立不安。","source":{"text":"且国兵新破，王坐不安席。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"祭足被囚于军府，甲士周围把守，水泄不通。祭足疑惧，～。","book":"明·冯梦龙《东周列国志》第十回"},"similar":["坐立不安"],"usage":"作谓语、定语；指坐立不安"},{"id":12745,"word":"坐不窥堂","pinyin":"zùo bù kuī táng","abbr":"zbkt","explanation":"端坐不斜视，专心一意。","source":{"text":"张孟卓（邈）东平长者，坐不窥堂。","book":"《三国志·魏郑浑传》"},"example":{"text":"林教授成天在书房中看书，～，啥家务事也不干。"},"similar":["专心一意","目不窥园"],"opposite":["三心二意"],"usage":"作谓语、定语；指人的修养"},{"id":12746,"word":"坐不重席","pinyin":"zuò bù chóng xí","abbr":"zbcx","explanation":"坐不用双层席子。比喻生活节俭。","source":{"text":"门外长荆棘，食不二味，坐不重席。","book":"战国·韩·韩非《韩非子·外储说左下》"},"example":{"text":"现在经济条件好了，也不能忘记以前～的时候。"},"similar":["食不二味"],"opposite":["一掷千金"],"usage":"作谓语、定语；指人生活节俭"},{"id":12747,"word":"坐于涂炭","pinyin":"zuò yú tú tàn","abbr":"zytt","explanation":"涂炭：比喻污浊的地方。坐在泥涂、炭灰上。比喻处于不干净的环境，自身也被玷污。","source":{"text":"立于恶人之朝，与恶人言，如以朝衣朝冠坐于涂炭。","book":"《孟子·公孙丑上》"},"similar":["水深火热"],"usage":"作谓语、定语；指困境"},{"id":12748,"word":"坐井窥天","pinyin":"zuò jǐng kuī tiān","abbr":"zjkt","explanation":"坐在井底看天。比喻眼界狭小，所见有限。","source":{"text":"以此定李杜优劣，诚坐井窥天也。","book":"明·胡应麟《少室山房笔丛·艺林学山一·江陵》"},"similar":["坐井观天"],"usage":"作谓语、宾语、定语；指人见识少"},{"id":12749,"word":"坐井观天","pinyin":"zuò jǐng guān tiān","abbr":"zjgt","explanation":"坐在井底看天。比喻眼界小，见识少。","source":{"text":"坐井而观天，曰天小者，非天小也。","book":"唐·韩愈《原道》"},"example":{"text":"我弟子虚度一生，山门也不曾出去，诚所谓～，樗配之辈。","book":"明·吴承恩《西游记》第十六回"},"similar":["井底之蛙","鼠目寸光","管窥蠡测"],"opposite":["见多识广","包罗万象","无懈可击"],"usage":"作谓语、宾语、定语；指人见识少"},{"id":12750,"word":"坐享其功","pinyin":"zuò xiǎng qí gōng","abbr":"zxqg","explanation":"自己不出力而享受别人的成果。","source":{"text":"鲜卑奉顺威灵，斩获北单于名王已下万计，中国坐享其功，而百姓不知其劳。汉兴功烈，于斯为盛。","book":"晋·袁宏《后汉纪·章帝纪下》"},"similar":["坐享其成"],"usage":"作谓语、宾语；用于处事"},{"id":12751,"word":"坐享其成","pinyin":"zuò xiǎng qí chéng","abbr":"zxqc","explanation":"享：享受；成：成果。自己不出力而享受别人取得的成果。","source":{"text":"欲使他人干事，彼坐享其成，必误公事。","book":"清·叶廷琯《鸥陂渔话·葛苍公传》"},"example":{"text":"人要有勤奋自力，积极向上的精神，不可有～，好逸恶劳的思想。"},"similar":["不劳而获","坐收渔利"],"opposite":["自食其力","自力更生"],"usage":"作谓语、宾语；指享受现成的东西"},{"id":12752,"word":"坐以待亡","pinyin":"zuò yǐ dài wáng","abbr":"zydw","explanation":"待：等待。坐着等死。形容不积极想办法找出路。","source":{"text":"人心风俗其他之病征尚不深患，而惟此坐以待亡之心理最为足患。","book":"梁启超《政闻时言·读宣统二年十月三日上谕感言》"},"example":{"text":"～，他们是太不幸了！","book":"范长江《塞上行·行纪·忆西蒙》"},"similar":["坐以待毙","坐而待弊","坐而待毙"],"usage":"作谓语、宾语、定语；指等死"},{"id":12753,"word":"坐以待旦","pinyin":"zuò yǐ dài dàn","abbr":"zydd","explanation":"旦：天亮。坐着等天亮。比喻办事勤劳。","source":{"text":"仰而思之，夜以继日；幸而得之，坐以待旦。","book":"《尚书·太甲上》：“先王昧爽，丕显，坐以待旦。”《孟子·离娄下》"},"example":{"text":"停了片时，宝玉便昏沉睡去，贾母等才得略略放心，只好～。","book":"清·曹雪芹《红楼梦》第九十七回"},"similar":["夜以继日","枕戈待旦","朝乾夕惕"],"usage":"作谓语、宾语、状语；指坐等"},{"id":12754,"word":"坐以待毙","pinyin":"zuò yǐ dài bì","abbr":"zydb","explanation":"坐着等死。形容在极端困难中，不积极想办法找出路。","source":{"text":"然不伐贼，王业亦亡，惟坐而待亡，孰与伐之。","book":"三国蜀·诸葛亮《后出师表》"},"example":{"text":"哪里有压迫，哪里就有反抗。人民大众不会～。"},"similar":["束手待毙","劫数难逃","在劫难逃"],"opposite":["柳暗花明"],"usage":"作谓语、宾语、定语；指等死"},{"id":12755,"word":"坐冷板凳","pinyin":"zuò lěng bǎn dèng","abbr":"zlbd","explanation":"冷：凉。比喻因不受重视而担任清闲的职务。也比喻长期等候工作或长久地等待接见。","source":{"text":"郭信不胜感激，捧了几百钱，就象获了珍宝一般，紧紧收藏，只去守那冷板凳了。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"example":{"text":"昨天慈圣召见，特别提到，说“只要我一天管事，决不会让李某人～。”（高阳《胭脂井》）"},"similar":["打入冷宫"],"opposite":["如日中升"],"usage":"作谓语、定语；指不受重视"},{"id":12756,"word":"坐卧不宁","pinyin":"zuò wò bù níng","abbr":"zwbn","explanation":"坐着躺着都不安宁。常形容心绪烦乱。","source":{"text":"各事冗杂，亦难尽述，因此忙的凤姐茶饭无心，坐卧不宁。","book":"清·曹雪芹《红楼梦》第十四回"},"example":{"text":"那劣绅不知何日要戴高帽子，每日在家放心不下，～。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["坐卧不安","坐立不安","如坐针毡"],"opposite":["镇定自若","悠然自得","平心静气"],"usage":"作谓语、定语、状语；指人的情绪"},{"id":12757,"word":"坐卧不安","pinyin":"zuò wò bù ān","abbr":"zwba","explanation":"坐着躺着都不安宁。形容因忧愁恐惧而不安的样子。","source":{"text":"自从哥哥吃官事，兄弟坐立不安，又无路可救。","book":"明·施耐庵《水浒全传》第四十回"},"example":{"text":"一连数日，神思恍惚，～。","book":"明·冯梦龙《古今小说》卷六"},"similar":["坐立不安","惶恐不安","忐忑不安"],"opposite":["心安理得","若无其事","满不在乎"],"usage":"作谓语、补语；指人的情绪"},{"id":12758,"word":"坐卧不离","pinyin":"zuò wò bù lí","abbr":"zwbl","explanation":"指时刻相随。","source":{"text":"琼英从小聪明，百伶百俐，料道在此不能脱生，又举目无亲，见倪氏爱他，便对倪氏说，向邬梨讨了叶清的妻安氏进来。因此安氏得与琼英坐卧不离。","book":"明·施耐庵《水浒传》第九十八回"},"example":{"text":"茅盾《子夜》：“除了每年印赠以外，又曾恭楷手抄一部，是他～的。”"},"similar":["形影不离"],"usage":"作谓语、定语；用于人际关系等"},{"id":12759,"word":"坐卧针毡","pinyin":"zuò wò zhēn zhān","abbr":"zwzz","explanation":"犹言如坐针毡。形容很不安宁。","source":{"text":"狄灵庆得命回家，十分侥幸，只是心魂恍惚，坐卧针毡。","book":"明·陈与郊《义犬》第四出"},"similar":["如坐针毡"],"usage":"作谓语、定语、状语；用于处事"},{"id":12760,"word":"坐吃享福","pinyin":"zuò chī xiǎng fú","abbr":"zcxf","explanation":"呆板单调地生活，消极地，被动地生活，光吃和生长，别的什么也不干。","example":{"text":"她就知道～，不会自己干点事情。"},"similar":["不劳而获","饱食终日"],"usage":"作谓语、宾语、定语；指不劳而获"},{"id":12761,"word":"坐吃山崩","pinyin":"zuò chī shān bēng","abbr":"zcsb","explanation":"只坐着吃，山也要空。指光是消费而不从事生产，即使有堆积如山的财富，也要耗尽。","source":{"text":"便好道坐吃山空，立吃地陷。","book":"元·秦简夫《东堂老》第一折"},"example":{"text":"他是个不中用的货，又不会种田，又不会作生意，～，把些田地都弄得精光。","book":"清·吴敬梓《儒林外史》第十二回"},"similar":["坐吃山空","坐耗山空","坐食山空"],"opposite":["聚沙成塔"],"usage":"作谓语、定语、分句；用于劝诫人"},{"id":12762,"word":"坐吃山空","pinyin":"zuò chī shān kōng","abbr":"zcsk","explanation":"只坐着吃，山也要空。指光是消费而不从事生产，即使有堆积如山的财富，也要耗尽。","source":{"text":"便好道坐吃山空，立吃地陷。","book":"元·秦简夫《东堂老》第一折"},"example":{"text":"到京之后，住在店里，已经是当卖度日，～。","book":"清·李宝嘉《官场现形记》第二十八回"},"similar":["坐吃山崩","暴殄天物","立吃地陷"],"opposite":["集腋成裘","积少成多","聚沙成塔"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":12763,"word":"坐地分脏","pinyin":"zuò dì fēn zāng","abbr":"zdfz","explanation":"原指盗贼就地瓜分偷盗来的脏物。现多指匪首窝主自己不动手而坐在家里分取同伙偷盗来的财物。","example":{"text":"附近一带防军，望风生惧，没人敢与接仗，甚且与他勾通，转好～。 ◎《民国演义》第二十五回"}},{"id":12764,"word":"坐地分账","pinyin":"zuò dì fēn zhàng","abbr":"zdfz","explanation":"盗贼就地瓜分赃物","source":{"text":"还有独自无力，四五个合做伙计，一人出名做官，其余坐地分账。","book":"明·冯梦龙《醒世恒言》第36卷"},"similar":["坐地分赃"],"usage":"作谓语、宾语；指瓜分赃物"},{"id":12765,"word":"坐地分赃","pinyin":"zuò dì fēn zāng","abbr":"zdfz","explanation":"原指盗贼就地瓜分偷盗来的脏物。现多指匪首窝主自己不动手而坐在家里分取同伙偷盗来的财物。","source":{"text":"他是坐地分赃，手下有二百余名绿林中人。","book":"清·贪梦道人《彭公案》第32回"},"example":{"text":"附近一带防军，望风生惧，没人敢与接仗，甚且与他勾通，转好～。","book":"《民国演义》第二十五回"},"similar":["坐地分账","坐享其成"],"usage":"作谓语、宾语；指瓜分赃物"},{"id":12766,"word":"坐地自划","pinyin":"zuò dì zì huá","abbr":"zdzh","explanation":"就地不动，自定范围。比喻固执一端，排斥其他。","source":{"text":"凡是文言的作品都一概视为陈腐观念，也是坐地自划。","book":"郭沫若《文艺论集·新旧与文白之争》"},"similar":["画地为牢"],"usage":"作宾语、定语；用于书面语"},{"id":12767,"word":"坐失事机","pinyin":"zuò shī shì jī","abbr":"zssj","explanation":"白白地失掉机会。","source":{"text":"坐失事机，谁执其咎。","book":"王闿运《丁锐义传》"},"similar":["坐失良机","坐失时机"],"usage":"作谓语、宾语；指浪费机会"},{"id":12768,"word":"坐失时机","pinyin":"zuò shī shí jī","abbr":"zssj","explanation":"坐：徒然，白白地。白白地失去好机会","source":{"text":"但他主张向外发展是对的，而我们要他集中待命坐失时机则是错误的。","book":"《星火燎原·闽西三年游击战争》"},"similar":["坐失良机","坐失事机"],"usage":"作谓语、宾语；指浪费机会"},{"id":12769,"word":"坐失机宜","pinyin":"zuò shī jī yí","abbr":"zsjy","explanation":"白白地失掉机会。","source":{"text":"兵家之事，宜于乘锐直进。若不审敌势，坐失机宜，使兵心至于溃败。虽欲振起，不易得也。","book":"清·昭梿《嘨亭杂录·木果木之败》"},"example":{"text":"我看他们实在是～，让敌人多准备了一天一夜。","book":"郭沫若《孔雀胆》第一幕第一场"},"similar":["坐失良机","坐失时机","坐失事机"],"usage":"作谓语、定语、宾语；用于处事"},{"id":12770,"word":"坐失良机","pinyin":"zuò shī liáng jī","abbr":"zslj","explanation":"不主动及时行动而失去好机会。","source":{"text":"若不审敌势，坐失良机，使兵心至于溃败。","book":"清·昭梿《啸亭杂录·木果木之败》"},"example":{"text":"‘左’倾路线却断言中间派别是所谓中国革命最危险的敌人，因而～。","book":"刘伯承《回顾长征》"},"similar":["坐失机宜"],"opposite":["不失时机"],"usage":"作谓语、宾语；指浪费机会"},{"id":12771,"word":"坐客无毡","pinyin":"zuò kè wú zhān","abbr":"zkwz","explanation":"毡：兽毛毡子。客人来人没有毡子可坐。形容清贫的生活","source":{"text":"才名三十年，坐客寒无毡。","book":"唐·杜甫《戏简郑广文兼呈苏司业》"},"example":{"text":"清·朱彝尊《钱教谕忘忧草序》：“月奉既薄，或以之僦舍，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":12772,"word":"坐山看虎斗","pinyin":"zuò shān kàn hǔ dòu","abbr":"zskhd","explanation":"比喻暂不介入双方的斗争中，等到双方都受到损伤，再从中捞取好处","source":{"text":"偏一点儿他们就‘指桑骂槐’的抱怨；‘坐山看虎斗’，‘借刀杀人’……都是全桂子的本事。","book":"清·曹雪芹《红楼梦》第16回"},"similar":["坐山观虎斗"],"usage":"作宾语、分句；指坐观成败"},{"id":12773,"word":"坐山观虎斗","pinyin":"zuò shān guān hǔ dòu","abbr":"zsghd","explanation":"比喻对双方的斗争采取旁观的态度，等到双方都受到损伤，再从中捞取好处。","source":{"text":"两虎方且食牛，食甘必争，斗则大者伤、小者死；从伤而刺之，一举必有双虎之名。","book":"《史记·张仪列传》"},"example":{"text":"同学之间发生争执时，我们要耐心劝解，决不能～。"},"similar":["坐观成败"],"usage":"作宾语、分句；指坐观成败","story":["战国时期，韩国和魏国打了一年多还不分胜负，秦惠王想出兵干涉，楚国使者陈轸给秦惠王讲卞庄子利用两虎相争必有一伤的道理，得到它们两败俱伤时一举打死两只老虎，劝秦惠王采取坐山观虎斗的计策，等待时机再消灭这两国"]},{"id":12774,"word":"坐怀不乱","pinyin":"zuò huái bù luàn","abbr":"zhbl","explanation":"春秋时鲁国的柳下惠将受冻的女子裹于怀中，没有发生非礼行为。形容男子在两性关系方面作风正派。","source":{"text":"子何不若柳下惠然，妪不逮门之女，国人不称其乱。","book":"《诗经·小雅·巷伯》毛亨传"},"example":{"text":"人人都说他无行，其实水秀才原是～的。","book":"明·兰陵笑笑生《金瓶梅词话》第五十六回"},"similar":["不近女色","冰清玉洁"],"opposite":["见色起意"],"usage":"作谓语、定语；用于男女之间","story":["春秋时期，鲁国的贤士柳下惠夜里在城门借宿时，遇到一无家可规的女子，当夜寒风呼啸，大雪纷飞。柳下惠怕她冻伤，让她坐在自己的怀中取暖，用衣服裹住她抱着她坐了一夜，没有发生不正当的淫乱行为"]},{"id":12775,"word":"坐愁行叹","pinyin":"zuò chóu xíng tàn","abbr":"zcxt","explanation":"坐着发愁，走着叹息。形容终日愁苦，郁郁寡欢","source":{"text":"人生亦有命，安能行叹复坐愁！","book":"南朝·宋·鲍照《拟行路难》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":12776,"word":"坐戒垂堂","pinyin":"zuò jǐng chuí táng","abbr":"zjct","explanation":"不坐在屋檐下，恐瓦堕伤身。形容自爱、谨慎。","source":{"text":"时清铸戟，坐戒垂堂。","book":"王闿运《哀江南赋》"},"similar":["坐不垂堂"],"usage":"作谓语、定语；指人自爱"},{"id":12777,"word":"坐拥书城","pinyin":"zuò yōng shū chéng","abbr":"zysc","explanation":"比喻藏书丰富。同“坐拥百城”。","source":{"text":"达夫的书，我们一向知道是多的……但从前住的都是弄堂小房子，没有一间正式的书房，所以未窥全豹。经现在这么陈列一番，真是坐拥书城，洋洋大观了。","book":"孙百刚《郁达夫外传·风雨茅庐》"},"similar":["坐拥百城"],"usage":"作谓语、定语；指书多"},{"id":12778,"word":"坐拥百城","pinyin":"zuò yōng bǎi chéng","abbr":"zybc","explanation":"有一万卷书，胜似管理一百座城的大官。比喻藏书极丰富。","source":{"text":"丈夫拥书万卷，何假南面百城？","book":"北齐·魏收《魏书·李谧传》"},"example":{"text":"茂林间馆，起看仙掌，～，足以忘暑。","book":"清·顾炎武《与熊耐荼书》"},"similar":["坐拥书城"],"usage":"作谓语、定语；指书多"},{"id":12779,"word":"坐收其利","pinyin":"zuò shōu qí lì","abbr":"zsql","explanation":"坐：不动。比喻利用别人的矛盾而从中获利","example":{"text":"他就靠几个铺面～而生活"},"similar":["坐收渔利","不劳而获","坐享其成"],"opposite":["自力更生","自食其力"],"usage":"作谓语、宾语、定语；指人善于抓住机会"},{"id":12780,"word":"坐收渔利","pinyin":"zuò shōu yú lì","abbr":"zsyl","explanation":"比喻利用别人的矛盾而从中获利。","source":{"text":"今者臣来，过易水，蚌方出曝，而鹬啄其肉，蚌合而拑其喙。……两者不肯相舍，渔者得而并禽之。","book":"西汉·刘向《战国策·燕策二》"},"example":{"text":"骑虎难下，正好，让我慢慢来个～。","book":"艾纳《新事旧编》"},"similar":["坐享其成","不劳而获","无功受禄"],"opposite":["自力更生","自食其力"],"usage":"作谓语、宾语、定语；指人善于抓住机会"},{"id":12781,"word":"坐无公车","pinyin":"zuò wú gōng chē","abbr":"zwgc","explanation":"比喻宴会时没有嘉宾。","source":{"text":"又善于赏会，当时每有盛坐而胤不在，皆云：‘无车公不乐。’","book":"《晋书·车胤传》"}},{"id":12782,"word":"坐无虚席","pinyin":"zuò wú xū xí","abbr":"zwxx","explanation":"虚：空；席：座位。座位没有空着的。形容出席的人很多","source":{"text":"从早到晚，长椅上都是坐无虚席。","book":"航鹰《开市大吉》"},"similar":["座无虚席","座无空席"],"usage":"作谓语、宾语、定语、分句；指人多"},{"id":12783,"word":"坐无车公","pinyin":"zuò wú chē gōng","abbr":"zwcg","explanation":"坐：通“座”，坐席；车公：晋人车胤。比喻宴会时没有嘉宾。","source":{"text":"又善于赏会，当时每有盛坐而胤不在，皆云‘无车公不乐’。","book":"《晋书·车胤传》"},"usage":"作宾语、定语；用于书面语","story":["晋代时期，车胤从小就好学不倦，因家贫没钱买灯油供他晚上读书，在夏夜他见室外飞舞着萤火虫，就用白纱布袋把捉来的萤火虫吊在书本上方，借着微弱的光线进行读书。他成名后，善于交际，经常出席各种宴会，席间把众人逗乐，让大家一醉方休"]},{"id":12784,"word":"坐树不言","pinyin":"zuò shù bù yán","abbr":"zsby","explanation":"指功高而不自矜。","source":{"text":"异为人谦退不伐……每所止舍，诸将并坐论功，异常独屏树下，军中号曰‘大树将军’。","book":"《后汉书·冯异传》"},"example":{"text":"第其勋庸，虽～而图功甚大。","book":"唐·元稹《加乌重胤检校司徒制》"},"similar":["坐树无言"],"usage":"作谓语、定语；用于比喻句","story":["西汉末年，人们奋起反抗王莽的暴政，刘秀起兵攻打王莽。郡椽监督冯异与苗萌归降刘秀。刘秀拜冯异为偏将军，封为应侯。冯异为人谦让，从不与别人争功。每当战斗结束时，将领们开始争功，他却躲在大树下，被人称为“大树将军”"]},{"id":12785,"word":"坐树无言","pinyin":"zuò shù wú yán","abbr":"zswy","explanation":"指功高而不自矜。","source":{"text":"异为人谦退不伐……每所止舍，诸将并坐论功，异常独屏树下，军中号曰‘大树将军’。","book":"《后汉书·冯异传》"},"example":{"text":"皇上志其持法无挠，赠大理卿；本其～。","book":"唐·张说《冯公神道碑》"},"similar":["坐树不言"],"usage":"作谓语、定语；用于比喻句","story":["西汉末年，人们奋起反抗王莽的暴政，刘秀起兵攻打王莽。郡椽监督冯异与苗萌归降刘秀。刘秀拜冯异为偏将军，封为应侯。冯异为人谦让，从不与别人争功。每当战斗结束时，将领们开始争功，他却躲在大树下，被人称为“大树将军”"]},{"id":12786,"word":"坐知千里","pinyin":"zuò zhī qiān lǐ","abbr":"zzql","explanation":"坐在屋里而知晓千里之外的事情。形容具有远见卓识。","source":{"text":"光武命将，坐知千里。","book":"南朝·梁·任乧《奏弹曹景宗文》"},"usage":"作谓语、定语；用于人"},{"id":12787,"word":"坐立不安","pinyin":"zuò lì bù ān","abbr":"zlba","explanation":"坐着也不是，站着也不是。形容心情紧张，情绪不安。","source":{"text":"自从哥哥吃官事，兄弟坐立不安，又无路可救。","book":"明·施耐庵《水浒全传》第四十回"},"example":{"text":"萧状元终日在此来往，吾等见了～。","book":"明·凌濛初《初刻拍案惊奇》卷二"},"similar":["坐卧不宁","如坐针毡","忐忑不安"],"opposite":["镇定自若","心平气和","平心静气"],"usage":"作谓语、定语、状语；指人的情绪"},{"id":12788,"word":"坐筹帷幄","pinyin":"zùo chóu wéi wò","abbr":"zcww","explanation":"坐在军帐里出谋划策。","source":{"text":"如用刘琸，须令亲履行阵，指纵四人，不可止坐筹帷幄。","book":"《宋史·赵范传》"},"example":{"text":"作为一个领导者，应该深入基层，亲历亲为，不能老是～，在办公室里发号施令。"},"similar":["运筹帷幄"],"usage":"作谓语、定语；指人善于运筹"},{"id":12789,"word":"坐筹帷幄，决胜千里","pinyin":"zuò chóu wéi wò，jué shèng qiān lǐ","abbr":"zcwwjsql","explanation":"帷幄：军用帐幕；千里：指战场。在小小的军帐之内作出正确的部署，能决定千里之外战场上的胜负","source":{"text":"我想张良坐筹帷幄之中，决胜千里之外，辅佐高祖，定了天下。","book":"元·无名氏《陈州粜米》第二折"},"example":{"text":"作为将军要有～的本事"},"similar":["运筹帷幄之中，决胜千里之外"],"usage":"作宾语、定语；用于处事"},{"id":12790,"word":"坐糜廪粟","pinyin":"zuò mí lǐn sù","abbr":"zmls","explanation":"糜：浪费；廪：米仓；粟：谷子，泛指粮食。坐着消耗国家的粮食，不干实事","source":{"text":"坐糜廪粟而不知耻。","book":"明·刘基《卖柑者言》"},"similar":["坐靡廪饩"],"usage":"作谓语、定语；用于讽刺"},{"id":12791,"word":"坐而待弊","pinyin":"zuò ér dài bì","abbr":"zedb","explanation":"坐着等死。比喻遭遇危难而不采取积极的措施。","source":{"text":"然不伐贼，王业亦亡，惟坐而待亡，孰与伐之。","book":"语出三国·蜀·诸葛亮《后出师表》"},"example":{"text":"然～，曷若伏而俟命。","book":"《新五代史·唐臣传·任圜》"},"similar":["坐而待毙","坐以待毙","坐以待亡"],"usage":"作谓语、宾语、定语；指等死"},{"id":12792,"word":"坐而待旦","pinyin":"zuò ér dài dàn","abbr":"zedd","explanation":"旦：天亮。坐着等天亮。比喻心情迫切。","source":{"text":"仰而思之，夜以继日；幸而得之，坐以待旦。","book":"《尚书·太甲上》：“先王昧爽，丕显，坐以待旦。”《孟子·离娄下》"},"example":{"text":"天下至广，万机至猥，诚不可不矜矜业业，～也。","book":"《三国志·魏志·王基传》"},"similar":["坐以待旦","坐而待曙"],"usage":"作谓语、宾语、状语；指坐等"},{"id":12793,"word":"坐而待曙","pinyin":"zuò ér dài shǔ","abbr":"zeds","explanation":"坐着等待天亮。比喻勤谨。","source":{"text":"坐而待曙，忮及上春。","book":"唐·陆贽《答百寮第二表》"},"similar":["坐而待旦","坐以待旦"],"usage":"作谓语、宾语、状语；指坐等"},{"id":12794,"word":"坐而待毙","pinyin":"zuò ér dài bì","abbr":"zedb","explanation":"坐着等死。比喻遭遇危难而不采取积极的坐着等死措施。","source":{"text":"然不伐贼，王业亦亡，惟坐而待亡，孰与伐之。","book":"语出三国·蜀·诸葛亮《后出师表》"},"example":{"text":"今城守虽有馀，然外无援兵，粮食将尽，岂可～。","book":"《元史·王义传》"},"similar":["坐以待毙","坐以待亡","坐而待弊"],"usage":"作谓语、宾语、定语；指等死"},{"id":12795,"word":"坐而论道","pinyin":"zuò ér lùn dào","abbr":"zeld","explanation":"坐着空谈大道理。指口头说说，不见行动。","source":{"text":"通人扬子云亦以为肉刑宜复也，但废之来久矣，坐而论道者，未以为急耳。","book":"《抱朴子·用刑》"},"example":{"text":"有些人只会～，而不办实事。"},"similar":["纸上谈兵","徒托空言"],"opposite":["身体力行","事必躬亲"],"usage":"作主语、谓语、定语；指空谈","story":["春秋时期，孔子带领弟子周游列国碰壁后，在冉求的帮助下，终于回到了父母之邦鲁国，他与季康子是不相为谋。于是专心著述，编辑整理《诗》《书》《礼》《乐》，用自己观点撰写《春秋》，同时又开坛讲学，与弟子们坐而论道，一时弟子达3000人"]},{"id":12796,"word":"坐耗山空","pinyin":"zuò hào shān kōng","abbr":"zhsk","explanation":"指只消费不生产，堆积如山的财富也要耗尽","source":{"text":"家庭方面，自他调入蒙古之后，又无他人可以生产，坐耗山空，望他多多设法，以济家用。","book":"《塞上行·行纪·百灵庙战后行》"},"similar":["坐吃山空","坐吃山崩","坐食山空"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":12797,"word":"坐薪尝胆","pinyin":"zuò xīn cháng dǎn","abbr":"zxcd","explanation":"指刻苦自励，奋发图强。","source":{"text":"越王勾路反国，乃苦身焦思，置胆于坐，坐卧即仰胆，饮食亦尝胆也。","book":"《史记·越王勾践世家》"},"example":{"text":"愿陛下思夷狄轻侮中原之耻，～，不忘修政。","book":"宋·苏轼《富郑公神道碑》"},"similar":["卧薪尝胆","坐薪悬胆"],"usage":"作谓语、定语；指奋发图强"},{"id":12798,"word":"坐薪悬胆","pinyin":"zuò xīn xuán dǎn","abbr":"zxxd","explanation":"坐卧在柴草上，悬胆尝其味。比喻刻苦自励，奋发图强。","source":{"text":"越王勾路反国，乃苦身焦思，置胆于坐，坐卧即仰胆，饮食亦尝胆也。","book":"《史记·越王勾践世家》"},"example":{"text":"陛下当～之日，奈何以球鞠细物动摇民间？","book":"《金史·术虎筠寿传》"},"similar":["卧薪尝胆","坐薪尝胆"],"opposite":["莺歌燕舞","醉生梦死"],"usage":"作谓语、定语；指奋发图强"},{"id":12799,"word":"坐观垂钓者，徒有羡鱼情","pinyin":"zuò guān chuí diào zhě，tú yǒu xiàn yú qíng","abbr":"zgcdztyxyq","explanation":"徒：空；羡：羡慕。坐着看那些钓鱼的人，空自有羡慕鱼儿的心情。指空想旁观不如实干","source":{"text":"欲济舟楫，端居耻圣明。坐观垂钓者，徒有羡鱼情。","book":"唐·孟浩然《望洞庭湖赠张丞相》诗"},"usage":"作宾语、定语；用于书面语"},{"id":12800,"word":"坐观成败","pinyin":"zuò guān chéng bài","abbr":"zgcb","explanation":"冷眼旁观人家的成功或失败。","source":{"text":"见兵事起，欲坐观成败；见胜者，欲合从之。","book":"《史记·田叔列传》"},"example":{"text":"吾想西伯侯姬昌自在安然，违避旨意，按兵不动，～，真是可恨。","book":"明·许仲琳《封神演义》第二回"},"similar":["作壁上观","隔岸观火","袖手旁观"],"opposite":["蹑足其闷"],"usage":"作谓语、宾语；指不参与","story":["汉武帝晚年怀疑有人要谋害他，派江充去调查。江充借机杀了竞争对手，并把矛头指向太子刘据。刘据忍无可忍杀了江充，汉武帝发兵捉拿刘据。刘据向任安求救，任安假装接受但不出兵，被汉武帝知道后以他坐观成败有二心而治罪"]},{"id":12801,"word":"坐视不救","pinyin":"zuò shī bù jiù","abbr":"zsbj","explanation":"坐视：坐着看。见别人遇到困难或危险，坐在一旁看着不去援救。","source":{"text":"即蜀中危急，孤岂可坐视不救。","book":"明·罗贯中《三国演义》第一百十七回"},"example":{"text":"别人有困难时，我们要热心帮助，决不能～。"},"similar":["见死不救","袖手旁观","作壁上观"],"opposite":["奋不顾身","赴汤蹈火","临危不惧"],"usage":"作谓语、宾语；指见死不救"},{"id":12802,"word":"坐视不理","pinyin":"zuò shì bù lǐ","abbr":"zsbl","explanation":"袖手旁观，不理不睬。","source":{"text":"坐视不理，不游不击，或游而不击的态度，是要不得的。","book":"毛泽东《抗日游击战争的战略问题》"},"example":{"text":"欧阳山《三家巷》：“你们不但～，并且趁火打劫。”"},"similar":["袖手旁观"],"usage":"作谓语、宾语、定语；指不过问"},{"id":12803,"word":"坐视不顾","pinyin":"zuò shì bù gù","abbr":"zsbg","explanation":"坐：不动。见别人遇到困难或危险，坐在一旁观看不去援救","source":{"text":"以有疏财仗义之张大公在，受人之托，必能忠人之事，未有坐视不顾，而致其剪发也。","book":"清·李渔《闲情偶寄·结构第一》"},"similar":["坐视不救","坐视不理"],"usage":"作谓语、宾语；指见死不救"},{"id":12804,"word":"坐视成败","pinyin":"zuò shì chéng bài","abbr":"zscb","explanation":"对别人的成功或失败采取旁观态度。","source":{"text":"臣备位宰辅，与国存亡……岂忍坐视成败，以亏圣美。","book":"《晋书·王敦传》"},"example":{"text":"梁启超《论支那独立之实力与日本东方政策》：“故持与欧洲均势～之论者，诚所谓自撤藩篱，招唇亡齿寒之戚而已。”"},"similar":["坐观成败"],"usage":"作谓语、宾语、定语；用于处事"},{"id":12805,"word":"坐言起行","pinyin":"zuò yán qǐ xíng","abbr":"zyqx","explanation":"坐能言，起能行。原指言论必须切实可行，后比喻说了就做。","source":{"text":"故坐而言之，起而可设，张而可施行。","book":"战国·赵·荀况《荀子·性恶》"},"example":{"text":"你要注意你的～。"},"similar":["言行一致"],"opposite":["心口不一"],"usage":"作宾语；指人言行必须一致"},{"id":12806,"word":"坐贾行商","pinyin":"zuò gǔ xíng shāng","abbr":"zjhs","explanation":"贾：有固定店面的商人。指有固定店面的商人和转运贩卖的行商","source":{"text":"君看坐贾行商辈，谁复从容唱渭城。","book":"宋·范成大《题南塘客舍》"},"similar":["作贾行商"],"usage":"作宾语、定语；用于书面语"},{"id":12807,"word":"坐运筹策","pinyin":"zuò yùn chóu cè","abbr":"zycc","explanation":"指坐在连连帐内策划军事方略。","source":{"text":"夫击轻锐，我不如公；坐运筹策，公不如我。","book":"《汉书·项籍传》"},"example":{"text":"夫被坚执锐，义不如公；～，公不如义。","book":"《资治通鉴·秦二世皇帝二年》"},"usage":"作谓语、宾语；用于处事"},{"id":12808,"word":"坐镇雅俗","pinyin":"zuò zhèn yǎ sú","abbr":"zzys","explanation":"坐镇：安坐而以德威服人；雅俗：文雅和粗俗。安坐而可以威服风雅之士或流俗之人。","source":{"text":"暕坐镇雅俗。弘益已多。","book":"南朝·梁·任乧《为萧扬州荐士表》"},"usage":"作谓语、定语；用于书面语"},{"id":12809,"word":"坐靡廪饩","pinyin":"zuò mí lǐn xì","abbr":"zmlx","explanation":"廪：米仓；饩：粮食。坐着消耗国家的粮食，不干实事","source":{"text":"若乃反复淹绵，坐靡廪饩，臣罪益深，亦非朝廷用人之意矣。","book":"明·归有光《封中宪大夫兴化知府周公行状》"},"similar":["坐糜廪粟"],"usage":"作谓语、定语；用于讽刺"},{"id":12810,"word":"坐食山空","pinyin":"zuò shí shān kōng","abbr":"zssk","explanation":"指光是消费而不从事生产，即使财产堆积如山，也会吃光用尽。","source":{"text":"常言道，坐食山空，宁出一斗，莫进一口。自从你来了，弄得我火尽油干。","book":"明·王玉峰《焚香记·离间》"},"example":{"text":"清·如莲居士《薛刚反唐》第36回：“自胡登亡后，与母文氏孤苦相依，～，不得已将住宅卖了。”"},"similar":["坐吃山空","坐吃山崩","坐耗山空"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":12811,"word":"坑儒焚书","pinyin":"kēng rú fén shū","abbr":"krfs","explanation":"坑：活埋；焚：烧。焚毁书籍，坑杀书生。","source":{"text":"及秦始皇灭先代典籍，焚书坑儒，天下学士逃难解散。","book":"汉·孔安国《〈尚书〉序》"},"similar":["焚书坑儒","焚典坑儒"],"usage":"作谓语、定语、宾语；指文化专制","story":["秦始皇34年，秦始皇采用丞相李斯的意见，把上书分封的淳于越看成私家学诽谤朝政，下令将《秦纪》以外的史书全部上交焚毁，书生卢生等人不满，结果秦始皇下令逮捕了460多名方士和儒生，在咸阳挖坑活埋他们"]},{"id":12812,"word":"坑坑坎坎","pinyin":"kēng kēng kǎn kǎn","abbr":"kkkk","explanation":"形容高低不平。","example":{"text":"这条路路面～，很不好走。"},"similar":["坑坑洼洼"],"opposite":["平平坦坦"],"usage":"作谓语、定语、状语；多指地面高低不平"},{"id":12813,"word":"坑坑洼洼","pinyin":"kēng kēng wā wā","abbr":"kkww","explanation":"形容物体表面凹凸不平，高高低低。","source":{"text":"少平就替她推着车，走过坑坑洼洼的建筑工地，一直把她送到柴油机厂大门口。","book":"路遥《平凡的世界》第四卷第40章"},"example":{"text":"他脸上～的真难看。"},"similar":["平平整整"],"opposite":["坑坑坎坎","坎坷不平"],"usage":"作谓语、定语；形容高低不平"},{"id":12814,"word":"坑家败业","pinyin":"kēng jiā bài yè","abbr":"kjby","explanation":"产业散尽，家道没落。","source":{"text":"为这点子小事，弄得人坑家败业，也不算什么能为。","book":"清·曹雪芹《红楼梦》第四十八回"}},{"id":12815,"word":"坑灰未冷","pinyin":"kēng huī wèi lěng","abbr":"khwl","explanation":"比喻时间极为短暂、匆促。","source":{"text":"坑灰未冷山东乱，刘、项原来不读书。","book":"唐·章碣·《焚书坑》诗"}},{"id":12816,"word":"坑绷拐骗","pinyin":"kēng bēng guǎi piàn","abbr":"kbgp","explanation":"指以欺手段捞取钱财，陷害他人。亦作“坑蒙拐骗”。","source":{"text":"整天价坑绷拐骗，每日里逛逛游游。","book":"魏风等《刘胡兰》"},"example":{"text":"坑蒙拐骗发不了大财，发了小财也长不了！","book":"《文汇报》1986.7.19"},"similar":["坑蒙拐骗"],"usage":"作谓语、定语、宾语；指坏手段"},{"id":12817,"word":"坑蒙拐骗","pinyin":"kēng méng guǎi piàn","abbr":"kmgp","explanation":"指以欺骗手段捞取钱财，陷害他人。","source":{"text":"坑蒙拐骗发不了大财，发了小财也长不了。","book":"《文汇报》1986.7.19"},"example":{"text":"白主任，你怎么竟干～的事呢!","book":"董玉振《精明人的苦恼》"},"similar":["坑绷拐骗"],"usage":"作谓语、定语、宾语；指坏手段"},{"id":12818,"word":"块人独处","pinyin":"kuài rén dú chǔ","abbr":"krdc","explanation":"块然：孤独的样子。指远离尘俗，孤独地生活。也指孤单地住在某地。形容孤寂无聊的生活。","source":{"text":"今世之处士，时虽不用，崛然独立，块然独处。","book":"《淮南子·原道训》：“所谓一者，无匹合于天下者也。卓然独立，块然独处，上通九天，下贯九野。”《史记·滑稽列传》"},"example":{"text":"春色已盛，但～，无与为乐。","book":"宋·苏轼《答杨济甫二首》"}},{"id":12819,"word":"块儿八毛","pinyin":"kuài ér bā máo","abbr":"kebm","explanation":"一元钱或不足一元钱。指小钱。","source":{"text":"看见那要饭的，明知道是骗钱，家里小洋楼都盖起来了，还忍不住给个块儿八毛的。","book":"王朔《你不是一个俗人》"},"example":{"text":"手头宽裕了，谁还在乎那～的。"},"similar":["块儿八角"],"usage":"作主语、宾语、定语；指小钱"},{"id":12820,"word":"块然独处","pinyin":"kuài rán dú chǔ","abbr":"krdc","explanation":"块然：孤独的样子。孤单一个人待着。形容独居无聊。","source":{"text":"今世之处士，时虽不用，崛然独立，块然独处。","book":"西汉·司马迁《史记·滑稽列传》"},"usage":"作谓语、宾语；指独居"},{"id":12821,"word":"坚不可摧","pinyin":"jiān bù kě cuī","abbr":"jbkc","explanation":"坚：坚固；摧：摧毁。非常坚固，摧毁不了。","source":{"text":"惟力大而才能坚，故至坚而不可摧也。","book":"清·叶燮《原诗·内篇上》"},"example":{"text":"二十年闺阁，养成拘墟笃时之见，牢不可破，～。","book":"清·李绿园《歧路灯》第八十二回"},"similar":["牢不可破"],"opposite":["不堪一击","一触即溃"],"usage":"作谓语、宾语、定语；指非常坚固"},{"id":12822,"word":"坚卧烟霞","pinyin":"jiān wò yān xiá","abbr":"jwyx","explanation":"卧：躺；烟霞：山林间的雾气烟云。指隐匿山林，悠闲度日。","source":{"text":"小弟坚卧烟霞，静听好音。","book":"清·吴敬梓《儒林外史》第三十五回"},"usage":"作谓语、定语；用于隐士"},{"id":12823,"word":"坚壁不战","pinyin":"jiān bì bù zhàn","abbr":"jbbz","explanation":"坚守壁垒，不与敌人交战。","source":{"text":"项羽闻汉王在宛，果引兵南，汉坚壁不与战。","book":"《史记·高祖本纪》"},"example":{"text":"故兵所至原野萧条，绝无所资，宋人～，乃无功而归。","book":"《金史·冯璧传"}},{"id":12824,"word":"坚壁清野","pinyin":"jiān bì qīng yiě","abbr":"jbqy","explanation":"坚壁：坚固壁垒；清野：清除郊野。对付强敌入入侵的一种方法。使敌人既攻不下据点，又抢不到物资。","source":{"text":"今东方皆已收麦，必坚壁清野以待将军。","book":"《三国志·魏书·荀彧传》"},"example":{"text":"不许出战，只是～，待这干贼寇粮尽力弛，方可追他。","book":"清·陈忱《水浒后传》第二十一回"},"similar":["空室清野"],"usage":"作谓语、定语、分句；用于军事方面","story":["东汉末年，曹操与吕布在濮阳一带对垒，曹操想先夺取徐州，谋士荀彧劝谏曹操不能贸然从事，因为刘备在徐州修筑防御工事，撤退居民，实行坚壁清野，我们不能马上取胜，吕布就会趁机进攻我们，我们就会失败的。曹操认为言之有理"]},{"id":12825,"word":"坚如盘石","pinyin":"jiān rú pán shí","abbr":"jrps","explanation":"坚：牢固；盘石：大石头。像大石头一样坚固。比喻不可动摇。","source":{"text":"君当作盘石，妾当作蒲苇。蒲苇纫如丝，盘石无转移。","book":"《玉台新咏·古诗为焦仲卿作》"},"similar":["坚如磐石"],"opposite":["摇摇欲坠"],"usage":"作谓语、定语；比喻不可动摇"},{"id":12826,"word":"坚如磐石","pinyin":"jiān rú pán shí","abbr":"jrps","explanation":"坚：坚固，结实；磐：大石头。象大石头一样坚固。比喻不可动摇。","source":{"text":"良无磐石固，虚名复何有？","book":"古乐府《孔雀东南飞》：“磐石方且厚，可以卒千年。”《文选·古诗十九首》"},"example":{"text":"我们伟大的祖国～。"},"similar":["安如泰山","安如磐石","固若金汤"],"opposite":["摇摇欲坠","不堪一击","危如累卵"],"usage":"作谓语、定语；比喻不可动摇"},{"id":12827,"word":"坚守不渝","pinyin":"jiān shǒu bù yú","abbr":"jsby","explanation":"坚守约章或诺言，决不改变。","source":{"text":"安虽受朝寄，然东山之志始末不渝，每形于言色。","book":"《晋书·谢安传》"},"example":{"text":"他对自己的誓言～"},"similar":["坚贞不渝"],"usage":"作谓语、定语；指意志坚定"},{"id":12828,"word":"坚定不移","pinyin":"jiān dìng bù yí","abbr":"jdby","explanation":"移：改变，变动。稳定坚强，毫不动摇。","source":{"text":"推心委任，坚定不移，则天下何忧不理哉！","book":"《资治通鉴·唐记·文宗开成五年》"},"example":{"text":"他们走得很慢，然而是～地向前走。","book":"茹志娟《澄河边上》"},"similar":["坚持不懈"],"opposite":["动摇不定","举棋不定"],"usage":"作谓语、宾语、定语、状语；用于主张、观点"},{"id":12829,"word":"坚强不屈","pinyin":"jiān qiáng bù qū","abbr":"jqbq","explanation":"屈：屈服。坚韧、刚毅，毫不屈服。","source":{"text":"坚强而不屈，义也。","book":"《荀子·法行》"},"example":{"text":"盖刚是～之意，便是卓然有立，不为物欲所累底人。","book":"宋·朱熹《朱子语灯》卷八"},"similar":["坚贞不渝","坚贞不屈","坚刚不屈"],"opposite":["卑躬屈膝"],"usage":"作谓语、定语；坚决不低头"},{"id":12830,"word":"坚心守志","pinyin":"jiān xīn shǒu zhì","abbr":"jxsz","explanation":"坚心：下定决心；守志：恪守节操。坚定地恪守节操。旧指女子丧夫后不再改嫁。","source":{"text":"孔目，你则将息你那病，休胡说，假如有些好歹，我坚心守志。","book":"元·岳伯川《铁拐李》第二折"}},{"id":12831,"word":"坚忍不拔","pinyin":"jiān rèn bù bá","abbr":"jrbb","explanation":"坚：坚定；韧：柔韧。形容意志坚定，不可动摇。","source":{"text":"古之立大事者，不惟有超世之才，亦必有坚忍不拔之志。","book":"宋·苏轼《晁错论》"},"example":{"text":"不管在生活中遇到什么困难，我们要有～、百折不挠的精神。"},"similar":["坚强不屈","坚定不移"],"opposite":["摇摆不定","举棋不定"],"usage":"作谓语、定语；指意志坚定"},{"id":12832,"word":"坚忍质直","pinyin":"jiān rěn zhì zhí","abbr":"jrzz","explanation":"质：品质。坚韧不拔，品格正直。","source":{"text":"御史大夫周昌，其人坚忍质直，且自吕后、太子及大臣皆素敬惮之。","book":"《史记·张丞相列传》"},"usage":"作谓语、定语；用于为人"},{"id":12833,"word":"坚执不从","pinyin":"jiān zhí bù cóng","abbr":"jzbc","explanation":"坚持自己的主张，不听从别人的意见。","source":{"text":"小官劝他且待兵戈稍定，再做商量，争奈元帅坚执不从。","book":"元·无名氏《隔江斗智》第一折"},"example":{"text":"孔明苦劝数次，汉中王～。","book":"明·罗贯中《三国演义》第八十回"},"similar":["固执己见"],"usage":"作谓语、定语；指人固执"},{"id":12834,"word":"坚持不懈","pinyin":"jiān chí bù xiè","abbr":"jcbx","explanation":"懈：松懈。坚持到底，一点不忪懈。","source":{"text":"煦激励兵团，坚持不懈，贼穷蹙乞降，遂复濮州。","book":"《清史稿·刘体重传》"},"example":{"text":"这些都证明我们对于加强统一战线实行革命政策来进行抗日战争的这种方针，是～的。","book":"毛泽东《和英国记者贝特兰的谈话》"},"similar":["锲而不舍","坚持不渝","持之以恒"],"opposite":["半途而废"],"usage":"作谓语、定语、宾语；形容做事持之以恒"},{"id":12835,"word":"坚持不渝","pinyin":"jiān chí bù yú","abbr":"jcby","explanation":"渝：改变。坚守约章或诺言，决不改变。","example":{"text":"我们将～地支持你的正义行动。"},"similar":["坚持不懈"],"opposite":["半途而废"],"usage":"作谓语、状语、定语；指坚守诺言不改变"},{"id":12836,"word":"坚明约束","pinyin":"jiān míng yuē shù","abbr":"jmys","explanation":"坚：坚守；约束：信守诺言。坚守同盟，信守盟约。","source":{"text":"秦自缪公以来二十余君，未尝能坚明约束者也。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"增祺严饬文武官吏～，并告两国主兵者勿得犯中立。","book":"《清史稿·增祺传》"}},{"id":12837,"word":"坚瓠无窍","pinyin":"jiān hú wú qiào","abbr":"jhwq","explanation":"瓠：葫芦。坚硬的葫芦没有一点空隙，不能剖瓠盛物。比喻徒有虚名而无实用的东西。","source":{"text":"夫瓠所贵者，谓其可以盛也。今厚而无窍，则不可以剖以盛物，而任重如坚石，则不可以剖以斟，吾无以瓠为也。","book":"《韩非子·外储说左上》"}},{"id":12838,"word":"坚甲利兵","pinyin":"jiān jiǎ lì bīng","abbr":"jjlb","explanation":"坚固的盔甲，锋利的兵器。形容精锐的部队。","source":{"text":"于此为坚甲利兵，以往攻伐无无罪之国。","book":"《墨子·非攻下》"},"example":{"text":"令尹最好者，～也。","book":"明·冯梦龙《东周列国志》第七十四回"},"similar":["强兵劲旅"],"opposite":["乌合之众","残兵败将"],"usage":"作宾语、定语；指坚强善战的军队","story":["战国时期，梁惠王向孟子请教治国的方略，他说魏国曾是大国，现被秦国吞并了河西700里土地，楚国夺去了8座城池，现在该怎么办？孟子说必须施行仁政，减轻百姓的赋税，这样就可以抵御秦国和楚国的坚甲利兵了"]},{"id":12839,"word":"坚甲利刃","pinyin":"jiān jiǎ lì rèn","abbr":"jjlr","explanation":"形容精锐的部队。同“坚甲利兵”。","source":{"text":"坚甲利刃，长短相杂。","book":"《汉书·晁错传》"},"similar":["坚甲利兵","甲坚兵利"],"usage":"作宾语、定语；指坚强善战的军队"},{"id":12840,"word":"坚甲厉兵","pinyin":"jiān jiǎ lì bīng","abbr":"jjlb","explanation":"加固盔甲，磨砺武器。指作好战斗准备。","source":{"text":"坚甲厉兵以备难，而美荐绅之饰。","book":"《韩非子·五蠹》"},"similar":["坚甲砺兵"],"usage":"作谓语、定语；指作好战斗准备"},{"id":12841,"word":"坚苦卓绝","pinyin":"jiān kǔ zhuó jué","abbr":"jkzj","explanation":"坚苦：坚忍刻苦；卓绝：超过一般。坚忍刻苦的精神超过寻常。","source":{"text":"始为学，即坚苦刻厉，寒不炉，暑不扇，夜不席者数年。","book":"《三国志·魏志·管宁传》：“德行卓绝，海内无偶。”《宋史·邵雍传》"},"example":{"text":"泥土和天才比，当然是不足齿数的，然而不是～者，也怕不容易做。","book":"鲁迅《坟·未有天才之前》"},"similar":["艰苦卓绝"],"opposite":["轻逸无论"],"usage":"作定语、宾语；指坚韧刻苦的精神超过寻常"},{"id":12842,"word":"坚贞不屈","pinyin":"jiān zhēn bù qū","abbr":"jzbq","explanation":"坚：坚定；贞：有节操；屈：屈服、低头。意志坚定，决不屈服。","source":{"text":"王公束修厉节，敦乐爇文，不求苟得，不为苟行，但以坚贞之操，违俗失众，横为谗佞所构毁。","book":"《荀子·法行》：“坚强而不屈，义也。”《后汉书·王龚传》"},"example":{"text":"而那些共产党人的～、为了人民和祖国视死如归的伟大精神更深深使他向往。","book":"杨沫《青春之歌》第二部第四十四章"},"similar":["威武不屈","坚强不屈"],"opposite":["卑躬屈膝","奴颜婢膝"],"usage":"作谓语、状语；指意志坚定","story":["明朝末年，清豫亲王多铎率军攻打扬州，派明朝降将李遇春去扬州劝降史可法，被史可法痛骂而回。豫亲王多次用书信劝降，也被史可法回书痛骂。清兵攻陷扬州，史可法自杀未遂，被清兵俘虏，他坚贞不屈，慷慨就义"]},{"id":12843,"word":"坚贞不渝","pinyin":"jiān zhēn bù yú","abbr":"jzby","explanation":"坚守节操，决不改变。","source":{"text":"她们不屈不挠、坚贞不渝，任何考验不足以动摇她们。","book":"徐迟《牡丹》"},"example":{"text":"他对他们的爱情～。"},"similar":["坚定不移","始终如一"],"usage":"作谓语、定语；指意志坚定"},{"id":12844,"word":"坚韧不拔","pinyin":"jiān rèn bù bá","abbr":"jrbb","explanation":"韧：有韧性；拔：动摇，改变。形容意志坚定，毫不动摇","source":{"text":"需要的是刻苦学习，刻苦钻研，始终不懈，坚韧不拔。","book":"方毅《读》"},"example":{"text":"丁玲《杜晚香·根深叶茂》：“是开天辟地、坚苦卓绝、～，从斗争中取得胜利、从斗争中享受乐趣的北大荒人。”"},"similar":["坚强不屈","坚定不移"],"opposite":["摇摆不定","举棋不定"],"usage":"作谓语、定语；指意志坚定"},{"id":12845,"word":"坚额健舌","pinyin":"jiān é jiàn shé","abbr":"jejs","explanation":"指厚颜利口。","source":{"text":"世俗饰伪诈行，为民巫祝，以取厘谢，坚额健舌，或以成业致富。","book":"汉·桓宽《盐铁论·散不足》"},"usage":"作谓语、定语；用于为人"},{"id":12846,"word":"坛坛罐罐","pinyin":"tán tán guàn guàn","abbr":"ttgg","explanation":"坛：一种口小肚子大的陶器；罐：盛东西用的大口陶瓷器皿。形容旧有的条条框框或规矩等。","source":{"text":"敌人进攻时，对付的办法是‘御敌于国门之外’，‘先发制人’，‘不打烂坛坛罐罐’，‘不丧失寸土’，‘六路分兵’。","book":"毛泽东《中国革命战争的战略问题》"},"example":{"text":"路遥《平凡的世界》第六卷第31章：“大家要丢掉～，洪水已经进城了！快逃命吧！”"},"similar":["条条框框"],"usage":"作主语、宾语、定语；用于口语"},{"id":12847,"word":"坠兔收光","pinyin":"zhuì tù shōu guāng","abbr":"ztsg","explanation":"兔：月亮。落月将光收回去了。指月亮落下。","source":{"text":"逡巡间，坠兔收光，远鸡戒晓。","book":"明·李昌祺《剪灯余话·武平灵怪录》"},"usage":"作宾语、定语；用于书面语"},{"id":12848,"word":"坠屦遗簪","pinyin":"zhuì jù yí zān","abbr":"zjyz","explanation":"坠：掉落；屦：鞋子；遗：遗失。掉落的簪和鞋子，比喻旧物。比喻能勾起人们怀旧之情的故物。","source":{"text":"昔人不弃遗簪坠屦者，恶与之同出，不与同归。吾之操行虽有不逮前烈，然舍旧录新，亦非吾志也。","book":"《北史·韦夐传》"}},{"id":12849,"word":"坠欢可拾","pinyin":"zhuì huān kě shí","abbr":"zhks","explanation":"坠：失掉；拾：捡起。失去的欢乐或宠爱的对象可以重新捡起。比喻重归于好。","source":{"text":"坠欢岂更接，明爱邈故别。","book":"南朝·宋·鲍照《和傅大农与僚故别》"},"example":{"text":"渴慕未忘通媒烦说客，～补过走情邮。","book":"张恨水《金粉世家》第六十回回目"},"usage":"作宾语、定语；用于书面语"},{"id":12850,"word":"坠溷飘茵","pinyin":"zhuì hùn piāo yīn","abbr":"zhpy","explanation":"同“坠茵落溷”。亦作“堕溷飘茵”。比喻人之境遇高下悬殊。茵，垫褥；溷，厕所。","source":{"text":"人之生譬如一树花，同发一枝，俱于茵席之上，自有关篱墙，落于粪溷之侧。","book":"《梁书·儒林传·范缜传》"},"example":{"text":"真阿怜，在磨房，自悲自苦。念人生，无定住，～。贫者贫，富者富，无端分等。","book":"《廿世纪女界文明灯弹词》卷二"},"similar":["堕溷飘茵"],"usage":"作宾语、定语；比喻境遇好坏不同","story":["南朝梁代时期，子良与无神论者范缜在一起谈人生富贵之事，问富贵与因果的关系。范缜回答说：“人生就同一树花，虽然同处于一根树枝上，突然刮起了大风，花瓣有随风飘到富贵人家的座垫上，也有飘到人家厕所里的，因果在起作用。”"]},{"id":12851,"word":"坠茵落溷","pinyin":"zhuì yīn luò hùn","abbr":"zylh","explanation":"茵：茵席；溷：厕所。随风而落，有的飘在茵席上，有的落在粪坑里。比喻境遇好坏不同。","source":{"text":"人之生譬如一树花，同发一枝，俱开一蒂，随风而堕，自有拂帘幌坠于茵席之上，自有关篱墙落于粪溷之侧。","book":"《梁书·儒林传·范缜》"},"example":{"text":"夫姬既薄命为花，后此之～，诚难自主。","book":"清·捧花生《画舫余谭》"},"similar":["坠溷飘茵","坠茵飘溷"],"usage":"作宾语、定语；比喻境遇好坏不同","story":["南朝梁代时期，子良与无神论者范缜在一起谈人生富贵之事，问富贵与因果的关系。范缜回答说：“人生就同一树花，虽然同处于一根树枝上，突然刮起了大风，花瓣有随风飘到富贵人家的座垫上，也有飘到人家厕所里的，因果在起作用。”"]},{"id":12852,"word":"坦然自若","pinyin":"tǎn rán zì ruò","abbr":"trzr","explanation":"态度安详，一如常态。","source":{"text":"宝钗原不妄言轻动，便此时亦是坦然自若。","book":"清·曹雪芹《红楼梦》第二十二回"},"example":{"text":"这时的小锁柱，尽管手中平端着匣子枪，匣枪张着大机头，可是，他的脸上，却是一派～的神色。","book":"郭澄清《大刀记》第七章"},"similar":["镇定自若"],"opposite":["忸忸怩怩"],"usage":"作谓语、定语；指人的神情"},{"id":12853,"word":"坦白从宽，抗拒从严","pinyin":"tǎn bái cóng kuān，kàng jù cóng yán","abbr":"tbckkjcy","explanation":"坦白：无隐瞒。如实交待自己的罪行，抵抗会得到严肃处理。","source":{"text":"当然还是要分别是非轻重，要以事实为根据，以法律为准绳，还是要讲坦白从宽抗拒从严的政策。","book":"邓小平《第三代领导集体的当务之急》"},"example":{"text":"～的政策已经过时了。"},"usage":"作谓语、定语、宾语；用于对犯罪嫌疑人"},{"id":12854,"word":"坦腹东床","pinyin":"tǎn fù dōng chuáng","abbr":"tfdc","explanation":"旧作女婿的美称。","source":{"text":"王家诸郎，亦皆可嘉，闻来觅婿，或自矜持，唯有一郎在东床上，坦腹卧，如不闻。","book":"南朝·宋·刘义庆《世说新语·雅量》"},"example":{"text":"书生愚见，忒不通变，不肯～。","book":"明·高明《琵琶记·金闺愁配》"},"similar":["东床坦腹","乘龙快婿"],"usage":"作谓语、宾语；指女婿","story":["东晋时期，书法家王羲之年轻时很有才华，太尉郗鉴很器重他，想把女儿嫁给他，于是派人向王羲之伯父王导求亲。王导领来人到东厢房去看，只有王羲之独自敞着衣服，露着肚子躺在东床上吃东西。来人回去向郗鉴汇报说东床坦腹的就是"]},{"id":12855,"word":"坦荡如砥","pinyin":"tǎn dàng rú dǐ","abbr":"tdrd","explanation":"坦荡：宽广平坦；砥：磨刀石。平坦得像磨刀石。","source":{"text":"黄与绿主宰着，无边无垠，坦荡如砥。","book":"茅盾《白杨礼赞》"},"usage":"作谓语、定语；用于人或事物等"},{"id":12856,"word":"垂世不朽","pinyin":"chuí shì bù xiǔ","abbr":"csbx","explanation":"垂世：留传后世；不朽：永不磨灭。名传后世，永不磨灭。","source":{"text":"然而歌德所以垂世不朽者，乃五十岁以后忏悔的歌德。","book":"鲁迅《反对“含泪”的批评家》"},"similar":["永垂不朽"],"usage":"作谓语、定语；用于人或功绩等"},{"id":12857,"word":"垂发戴白","pinyin":"chuí fà dài bái","abbr":"cfdb","explanation":"戴白：指白发老人。指幼儿与老人。","source":{"text":"禹所止，辄停车住节，以劳来之，父老童稚，垂发戴白，满其车下，莫不感悦。","book":"《后汉书·邓禹传》"}},{"id":12858,"word":"垂名竹帛","pinyin":"chuí míng zhú bó","abbr":"cmzb","explanation":"竹帛：古代供书写用的竹简和白绢，借指典籍。比喻好名声永远流传。","source":{"text":"声可托于弦管，名可留于竹帛。","book":"《吴越春秋·勾践伐吴外传》"},"example":{"text":"大丈夫先立功业，共扶明主，～。","book":"明·许仲琳《封神演义》第五十七回"},"similar":["名垂青史"],"usage":"作谓语、定语；指载入史册"},{"id":12859,"word":"垂名青史","pinyin":"chuí míng qīng shǐ","abbr":"cmqs","explanation":"青史：书写于竹简或白绢上的典籍、史册。名字被载入史册，流传后世。","source":{"text":"声可托于弦管，名可留于竹帛。","book":"汉·赵晔《吴越春秋·勾践伐吴外传》"}},{"id":12860,"word":"垂堂之戒","pinyin":"chuí táng zhī jiè","abbr":"ctzj","explanation":"垂堂：堂屋檐下。坐在堂屋檐下，屋瓦落下有可能伤人。比喻危险的境地。常指险境或挫折给人带来的教训。","source":{"text":"今不忍小忿，而发雷霆之怒，违垂堂之戒，轻万乘之重。","book":"汉·司马相如《上书谏猎》：“家累千金，坐不垂堂。”《三国志·吴志·陆逊传》"}},{"id":12861,"word":"垂头丧气","pinyin":"chuí tóu sàng qì","abbr":"ctsq","explanation":"垂头：耷拉着脑袋；丧气：神情沮丧。形容因失败或不顺利而情绪低落、萎蘼不振的样子。","source":{"text":"主人于是垂头丧气，上手称谢。","book":"唐·韩愈《送穷文》"},"example":{"text":"李德才一口回绝说情的事，运涛～走出来。","book":"梁斌《红旗谱》十三"},"similar":["灰心丧气","无精打采"],"opposite":["趾高气昂","得意洋洋"],"usage":"作谓语、定语、状语；形容受挫折无精打采","story":["唐朝末年，政治腐败，各地藩镇拥兵自重，北方两大藩镇李茂贞、朱全忠为了控制唐昭宗，宦官韩全诲劫持唐昭宗到凤翔投奔李茂贞。李茂贞无能，竟要把皇帝交给朱全忠。韩全诲见大势已去，垂头丧气，默不做声，昭宗下令诛杀韩全诲"]},{"id":12862,"word":"垂头塌翅","pinyin":"chuí tóu tā chì","abbr":"cttc","explanation":"形容受挫后萎靡不振的样子。","source":{"text":"君臣报国极矣，战力殚矣，尚能垂头塌翅求生于黄门哉！","book":"《新唐书·萧遘传》"},"similar":["垂头铩羽","垂头搨翼"],"usage":"作谓语、定语、状语；用于书面语"},{"id":12863,"word":"垂头塌翼","pinyin":"chuí tóu tā yì","abbr":"ctty","explanation":"塌：下垂。耷拉着脑袋，下垂着翅膀。比喻情绪低落而精神不振的神态。","source":{"text":"方今汉室陵迟，纲维驰绝，圣朝无一介之辅，股肱无折冲之势，方畿之内，简练之臣，皆垂头搨翼，莫所凭恃。","book":"汉·陈琳《为袁绍檄豫州》"}},{"id":12864,"word":"垂头塞耳","pinyin":"chuí tóu sāi ěr","abbr":"ctse","explanation":"指不问不闻，装聋作哑。","source":{"text":"刺史垂头塞耳，阿私下比，‘不畏于天，不愧于人’。","book":"《后汉书·殇帝纪》"},"example":{"text":"谏诤之徒，以正人君之失尔，必在得言之地，当尽匡赞之规，不容苟免偷安，～。","book":"北齐·颜之推《颜氏家训·省事》"},"usage":"作谓语、宾语；用于处事"},{"id":12865,"word":"垂头搨翼","pinyin":"chuí tóu dá yì","abbr":"ctdy","explanation":"形容受挫后萎靡不振的样子。","source":{"text":"方畿之内，简练之臣，皆垂头搨翼，莫所凭持。","book":"汉·陈琳《为袁绍檄豫州文》"},"similar":["垂头塌翅"],"usage":"作谓语、定语、状语；用于书面语"},{"id":12866,"word":"垂头铩羽","pinyin":"chuí tóu shā yǔ","abbr":"ctsy","explanation":"形容受挫后萎靡不振的样子。","source":{"text":"正值宪太太发放那起不中用的家人出来，犹如斗败公鸡，一个个垂头铩羽，打从签押房门外经过。","book":"《冷眼观》第五回"},"similar":["垂头塌翅"],"usage":"作谓语、定语、状语；用于书面语"},{"id":12867,"word":"垂帘听决","pinyin":"chuí lián tīng jué","abbr":"cltj","explanation":"指女后辅幼主临朝听政。","source":{"text":"皇上冲龄，未能亲政，天步方艰，军国事重，暂请皇太后垂帘听决。","book":"清·薛福成《庸庵笔记·史料一·咸丰季年三奸伏诛》"},"similar":["垂帘听政"],"usage":"作谓语、定语；形容女后当朝处理国事"},{"id":12868,"word":"垂帘听政","pinyin":"chuí lián tīng zhèng","abbr":"cltz","explanation":"垂帘：太后或皇后临朝听政，殿上用帘子遮隔。听：治理。指太后临朝管理国家政事。","source":{"text":"时帝风疹不能听朝，政事皆决于天后。自诛上官仪后，上每视朝，天后垂帘于御座后，政事大小皆预闻之，内外称为二圣。","book":"《旧唐书·高宗纪下》"},"example":{"text":"后一～，我等皆受制于人矣，不若先事而起。","book":"《元史·阿沙不花传》"},"similar":["越俎代庖","牝鸡司晨"],"opposite":["包而不办"],"usage":"作谓语、定语；形容女后当朝处理国事","story":["唐朝时期，高宗李治继位，立武则天为皇后。由于高宗体弱多病，在朝不能过久处理政事，就在朝堂御座后挂块帘子，皇后武则天坐在后面，参与高宗与大臣们讨论朝政。高宗死后，武则天就继续在帘后辅佐年幼的皇帝执政"]},{"id":12869,"word":"垂成之功","pinyin":"chuí chéng zhī gōng","abbr":"cczg","explanation":"垂：接近，快要。将要成就的大功业。","example":{"text":"《三国志·吴志·薛综传》：“实欲使卒垂成之功，编于前史之末。”"}},{"id":12870,"word":"垂手侍立","pinyin":"chuí shǒu shì lì","abbr":"cssl","explanation":"两手放下来，在旁边陪着。形容恭敬地站在旁边，准备随时听从吩咐。","source":{"text":"院中许多小厮垂手侍立，伺候烧纸。","book":"清·曹雪芹《红楼梦》第十四回"},"example":{"text":"众管家碰了钉子，一声也不敢言语，一个个鸦雀无声，～。","book":"清·李宝嘉《官场现形记》第三回"},"similar":["垂手恭立"],"usage":"作谓语、定语；用于处事"},{"id":12871,"word":"垂手可得","pinyin":"chuí shǒu kě dé","abbr":"cskd","explanation":"垂：放下。放下双手就能得到。形容得来毫不费力","source":{"text":"只除呼延灼将军赚开城门，垂手可得。","book":"明·施耐庵《水浒传》"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“按照他预定的步骤，不愿往东去占～的常州。”"},"similar":["探囊取物","易如反掌","手到擒来"],"opposite":["谈何容易","海底捞针"],"usage":"作谓语、定语；指不费力就能得到的东西"},{"id":12872,"word":"垂手恭立","pinyin":"chuí shǒu gōng lì","abbr":"csgl","explanation":"垂：低下；垂手：表示恭敬。形容恭敬地站在旁边随时听从吩咐。","source":{"text":"武松从纱帐里望出来，看见施福、施寿还是垂手恭立，便招呼道：‘贵家院为何不去？我没事了。’","book":"《武松演义》第十回"},"similar":["垂手侍立"],"usage":"作谓语、定语；用于处事"},{"id":12873,"word":"垂手而得","pinyin":"chuí shǒu ér dé","abbr":"csed","explanation":"垂：垂下。手不动就能得到。形容毫不费力。","source":{"text":"那个姿性，读不上三二年，功名是可以垂手而得的。","book":"清·李绿园《歧路灯》第三十八回"},"example":{"text":"如果说过去日寇差不多不费一点气力～东四省，现在就非经过血战不能占领中国的土地了。","book":"毛泽东《和英国记者贝特兰的谈话》"},"similar":["触手可及","轻而易举"],"opposite":["海底捞针"],"usage":"作谓语、定语；形容来得轻松"},{"id":12874,"word":"垂拱之化","pinyin":"chuí gǒng zhī huà","abbr":"cgzh","explanation":"垂拱：垂衣拱手，比喻无所事事，不费力气。旧时形容无为而治，天下太平。","source":{"text":"共虞任五臣，致垂拱之化，汉相萧何，兴宁一之誉，故能光降于当时，垂裕于百代。","book":"《尚书·武成》：“垂拱而天下治。”《晋书·刘实传》"}},{"id":12875,"word":"垂拱仰成","pinyin":"chuí gǒng yǎng chéng","abbr":"cgyc","explanation":"垂：衣服下垂；拱：拱手；仰：脸向上。指垂衣、拱手、仰首，等待成功。比喻坐享其成。","source":{"text":"嘉绩多于先王，予小子垂拱仰成。","book":"《尚书·毕命》"}},{"id":12876,"word":"垂拱而治","pinyin":"chuí gǒng ér zhì","abbr":"cgez","explanation":"垂拱：垂衣拱手，形容毫不费力；治：平安。古时比喻统治者不做什么使使天下太平。多用作称颂帝王无为而治。","source":{"text":"惇信明义，崇德报功，垂拱而天下治。","book":"《尚书·武成》"},"example":{"text":"文武并用，～。","book":"唐·魏征《谏太宗十思疏》"},"similar":["拱手垂裳"],"usage":"作谓语、定语；指帝王无为而治"},{"id":12877,"word":"垂暮之年","pinyin":"chuí mù zhī nián","abbr":"cmzn","explanation":"垂：将，快要；暮：晚，老年。快要到老年。","source":{"text":"年华垂暮犹离索。","book":"宋·张元幹《庐川词·醉落魄》"},"example":{"text":"他在～还想干一番大事。"},"similar":["迟暮之年"],"usage":"作宾语；指老年"},{"id":12878,"word":"垂朱拖紫","pinyin":"chuí zhū tuō zǐ","abbr":"cztz","explanation":"垂：挂下；朱：朱绂，官服上的带子；紫：紫色印绶。借指高官显宦。","source":{"text":"自言家代仕梁、陈，垂朱拖紫三十人。","book":"唐·崔颢《江畔老人愁》"},"usage":"作谓语、定语；用于官场等"},{"id":12879,"word":"垂死挣扎","pinyin":"chuí sǐ zhēng zhá","abbr":"cszz","explanation":"垂：将近。临死前的挣扎，妄想延长生命。比喻行将灭亡之时的孤注一掷。","source":{"text":"他这会儿真的熬到了垂死挣扎的时刻。","book":"浩然《艳阳天》第127章"},"example":{"text":"炸成重伤的蒋子金，～地用手里的小剜刀去刺她的腿。","book":"冯德英《迎春花》第17章"},"similar":["负隅顽抗","困兽犹斗"],"opposite":["束手待毙","束手就擒"],"usage":"作谓语、宾语；形容最后的反抗"},{"id":12880,"word":"垂没之命","pinyin":"chuí mò zhī mìng","abbr":"cmzm","explanation":"垂：快要，接近；没：终。接近完结的生命。指人至晚年，快要死去。","source":{"text":"荷栋梁之任，垂没之命，获九棘之位。","book":"《三国志·魏志·管宁传》"}},{"id":12881,"word":"垂涎三尺","pinyin":"chuí xián sān chǐ","abbr":"cxsc","explanation":"涎：口水。口水挂下三尺长。形容极其贪婪的样子。也形容非常眼热。","source":{"text":"临江之人，略得麋麂，畜之。入门，群犬垂涎，扬尾皆来。","book":"唐·柳宗元《三戒》"},"example":{"text":"这个孩子看见人家吃这些东西，总是馋得～。","book":"叶君健《自由》十三"},"similar":["垂涎欲滴","馋涎欲滴"],"opposite":["不屑一顾","视如敝屣"],"usage":"作谓语、定语；形容见了别人东西眼红"},{"id":12882,"word":"垂涎欲滴","pinyin":"chuí xián yù dī","abbr":"cxyd","explanation":"涎：口水。馋得连口水都要滴下来了。形容十分贪婪的样子。","source":{"text":"垂涎闪舌兮，挥霍旁午。","book":"唐·柳宗元《招海贾文》"},"example":{"text":"但是在我这样的一个穷小子看来，确觉得　这是一个不小的数目，而且老实说，确也有些～！","book":"邹韬奋《经历·贫民窟里的报馆》"},"similar":["垂涎三尺"],"opposite":["淡泊寡味"],"usage":"作谓语、定语、状语；指贪婪嘴馋的人"},{"id":12883,"word":"垂涕而道","pinyin":"chuí tì ér dào","abbr":"cted","explanation":"涕：鼻涕，眼泪。流着眼泪说话。比喻十分沉痛地恳切陈词。","source":{"text":"这是宋人的笔记里垂涕而道的，正如现在常见于报章上的流泪文章一样。","book":"鲁迅《“民族主义文学”的任务和命运》"},"usage":"作谓语；用于悲伤时"},{"id":12884,"word":"垂绅正笏","pinyin":"chuí shēn zhèng hù","abbr":"cszh","explanation":"绅：古时士大夫束在衣外的大带；笏：指朝笏，用于记事。垂下大带的末端，双手端正地拿着朝笏。形容朝廷大臣庄重严肃的样子。","source":{"text":"至于临大事，决大议，垂绅正笏，不动声色，而措天下于泰山之安。","book":"宋·欧阳修《相州昼锦堂记》"},"example":{"text":"雍雍乎有～台阁气象焉。","book":"清·汪琬《〈苑西集〉序》"},"usage":"作谓语、定语；用于旧时大臣等"},{"id":12885,"word":"垂翼暴鳞","pinyin":"chuí yù bào lín","abbr":"cybl","explanation":"暴：脱落。飞鸟敛翼下跌，长蛇鳞片脱落。比喻人失势或遭受挫折。","source":{"text":"怪鸟俄垂翼，修蛇竟暴鳞。","book":"唐·杨炯《和刘长吏答十九兄》诗"}},{"id":12886,"word":"垂耳下首","pinyin":"chuí ěr xià shǒu","abbr":"cexs","explanation":"犹俯首帖耳，形容驯服听命。","source":{"text":"故虽驱而用之，而垂耳下首，卒不敢动。","book":"宋·陈亮《酌古论·李愬》"},"example":{"text":"我看不惯他那～的样子。"},"similar":["俯首帖耳"],"usage":"作谓语、定语；指驯服"},{"id":12887,"word":"垂范百世","pinyin":"chuí fàn bǎi shì","abbr":"cfbs","explanation":"垂：流传。范：典范。指光辉榜样或伟大精神永远流传。","source":{"text":"虽徙海表，气不少衰，丁宁训戒之语，皆足垂范百世。","book":"宋·陆游《跋李庄简公家书》"},"example":{"text":"他的功绩可以～。"},"similar":["流芳百世"],"opposite":["臭名远扬"],"usage":"作谓语、定语；指流芳百世"},{"id":12888,"word":"垂裕后昆","pinyin":"chuí yù hòu kūn","abbr":"cyhk","explanation":"裕：富足。后昆：子孙，后代，后嗣。为后世子孙留下功业或财产。","source":{"text":"以义制事，以礼制心，垂裕后昆。","book":"《书·仲虺之诰》"},"example":{"text":"～，流名竹帛，此实生平之志也。","book":"《梁书·侯景传》"},"usage":"作谓语、宾语；用于为后人造福"},{"id":12889,"word":"垂裳而治","pinyin":"chuí cháng ér zhì","abbr":"csez","explanation":"垂衣而能治理天下。用以称颂帝王无为而治。","source":{"text":"黄帝尧舜衣裳而天下治，盖取诸乾坤。","book":"《周易·系辞下》"}},{"id":12890,"word":"垂饵虎口","pinyin":"chuí ěr hǔ kǒu","abbr":"cehk","explanation":"往虎口送食。比喻置身险地。","source":{"text":"垂饵，犹送食也。","book":"《文选·司马迁》：“李陵提步卒不满五千，深践戎马之地，足历王庭，垂饵虎口。”张铣注"},"usage":"作宾语、定语；用于人的处境"},{"id":12891,"word":"垂首丧气","pinyin":"chuí shǒu sàng qì","abbr":"cssq","explanation":"形容因失败或不顺利而情绪低落、萎蘼不振的样子。同“垂头丧气”。","source":{"text":"乔道清生平逞弄神通，今日垂首丧气，正是总教掬尽三江水，难洗今朝一面羞。","book":"《水浒传》第九五回"},"example":{"text":"[舟次]连不得志于有司，～，无以娱其老亲。","book":"清·周亮工《送汪舟次游庐山序》"},"similar":["垂头丧气"],"usage":"作谓语、定语、状语；形容受挫折无精打采"},{"id":12892,"word":"垂首帖耳","pinyin":"chuí shǒu tiē ěr","abbr":"cste","explanation":"垂：低下；帖：顺从，服从。低着头耷拉着耳朵。形容顺从听命的样子。","source":{"text":"稍遇贬抑遽若丧家之狗，垂首帖耳，摇尾乞怜，惟恐人不我恤。","book":"元·陶宗仪《辍耕录》第15卷"},"example":{"text":"他那～的样子让人受不了。"},"similar":["俯首帖耳"],"opposite":["刚正不阿"],"usage":"作谓语、定语；指驯服恭顺"},{"id":12893,"word":"垄亩之臣","pinyin":"lǒng mǔ zhī chén","abbr":"lmzc","explanation":"垄母：田间。在野的臣民。","source":{"text":"疏远垄母之臣，无望高阙之下。","book":"《后汉书·冯衍传》"}},{"id":12894,"word":"垢面蓬头","pinyin":"gòu miàn péng tóu","abbr":"gmpt","explanation":"指面目肮脏，头发凌乱。","source":{"text":"如云鬓发粗粗卷展，蛾眉低偃，也只索垢面蓬头，净洗朱铅。","book":"明·孙仁孺《东郭记·蚤起》"},"example":{"text":"秦桧见那疯僧～，鹑衣百结。","book":"清·钱彩《说岳全传》第70回"},"similar":["蓬头垢面"],"usage":"作宾语、定语；指不好的外表"},{"id":12895,"word":"垫脚石","pinyin":"diàn jiǎo shí","abbr":"djs","explanation":"供步行时踏脚的石头。比喻被别人借以向上爬的人或事物","source":{"text":"总要有人作出牺牲，总要有人成为别人的垫脚石。","book":"王朔《你不是一个俗人》"},"usage":"作宾语、定语；多用于比喻句"},{"id":12896,"word":"埋三怨四","pinyin":"mán sān yuàn sì","abbr":"msys","explanation":"事事埋怨。","example":{"text":"不要老是～的，会有你的机会的。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":12897,"word":"埋名隐姓","pinyin":"mái míng yǐn xìng","abbr":"mmyx","explanation":"隐：隐瞒。隐瞒自己的真实姓名，不让别人知道。","source":{"text":"京城里镖局上请过他几次，他都不肯去，情愿埋名隐姓，做个农夫。","book":"清·刘鹗《老残游记》第七回"},"example":{"text":"清·刘鹗《老残游记》第七回：“京城里镖局上请过他几次，他都不肯去，情愿～，做个农夫。”"},"similar":["隐姓埋名"],"opposite":["抛头露面"],"usage":"作谓语、定语、状语；用于人"},{"id":12898,"word":"埋声晦迹","pinyin":"mái shēng huì jì","abbr":"mshj","explanation":"犹销声匿迹。指隐藏起来，不公开露面。","source":{"text":"修静恭自守，埋声晦迹。","book":"《南史·萧修传》"},"similar":["销声匿迹"],"usage":"作谓语、宾语；用于隐者"},{"id":12899,"word":"埋天怨地","pinyin":"mán tiān yuàn dì","abbr":"mtyd","explanation":"抱怨天，埋怨地。形容对什么都抱怨。","source":{"text":"每日在吾庙里，埋天怨地。","book":"元·郑廷玉《看钱奴》第一折"},"example":{"text":"今日据着他～，正当冻饿，念他一点小孝。","book":"明·凌濛初《初刻拍案惊奇》第35卷"},"similar":["怨天尤人"],"usage":"作谓语、定语；指抱怨"},{"id":12900,"word":"埋头埋脑","pinyin":"mái tóu mái nǎo","abbr":"mtmn","explanation":"没头没脑。比喻毫无头绪。","example":{"text":"跑到厨房里，看见大师傅正在～做饭。","book":"欧阳山《三家巷》五"}},{"id":12901,"word":"埋头苦干","pinyin":"mái tóu kǔ gàn","abbr":"mtkg","explanation":"专心一意地刻苦工作。","source":{"text":"我们从古以来，就有埋头苦干的人，有拼命硬干的人。","book":"鲁迅《且介亭杂文·中国人失掉自信力了吗》"},"example":{"text":"克己奉公，～的精神，才是可尊敬的。","book":"毛泽东《中国共产党在民族战争中的地位》"},"similar":["兢兢业业"],"opposite":["游手好闲"],"usage":"作谓语、定语、状语；指专心干活"},{"id":12902,"word":"埋头财主","pinyin":"mái tóu cái zhǔ","abbr":"mtcz","explanation":"旧指不出名的富翁。","source":{"text":"他是埋头财主，我回哥哥话去。","book":"元·岳伯川《铁拐李》第一折"}},{"id":12903,"word":"埋头顾影","pinyin":"mái tóu gù yǐng","abbr":"mtgy","explanation":"形容矫饰者暗中窥察外界的反应。","source":{"text":"非与世之局琐取容，埋头顾影。","book":"明·李贽《答邓明府》"},"usage":"作谓语、定语；用于人"},{"id":12904,"word":"埋杆竖柱","pinyin":"mái gān shù zhù","abbr":"mgsz","explanation":"埋上杆子，竖起柱子。比喻虚张声势。"},{"id":12905,"word":"埋没人才","pinyin":"mái mò rén cái","abbr":"mmrc","explanation":"不重视有才能的人，让其不能发挥作用。","source":{"text":"若非问明，几乎埋没人才。","book":"清·李汝珍《镜花缘》第65回"},"example":{"text":"我们绝不容许～。"},"similar":["爱才如命"],"usage":"作谓语、定语；指不重视人才"},{"id":12906,"word":"埋轮破柱","pinyin":"mái lún pò zhù","abbr":"mlpz","explanation":"比喻刚正不阿，不畏权贵。","source":{"text":"季代而还，埋轮破柱之徒，绝不复出，朕甚异焉。","book":"唐·元稹《裴注侍御史制》"},"example":{"text":"像张纲这样～的人大有人在。"},"usage":"作定语；指不畏权贵","story":["东汉初期，梁冀专权破坏朝政，光禄大夫张纲奉命去惩治贪官污吏，他出了都城洛阳，就把自己的坐车就地掩埋，回洛阳弹劾梁冀。李膺破柱搜捕张让的弟弟张朔，发誓要维护朝廷纲纪"]},{"id":12907,"word":"埋锅造饭","pinyin":"mái guō zào fàn","abbr":"mgzf","explanation":"造：制作。在平地上挖灶安锅做饭。","source":{"text":"三军休要埋锅造饭，与我披衣擐甲者。","book":"元·无名氏《千里独行》第四折"},"example":{"text":"又见军士捱了一夜，肚中料是饥饿，即令～，然后赶程。","book":"清·黄小配《洪秀全演义》第九回"},"usage":"作谓语、宾语、定语；用于群体行动"},{"id":12908,"word":"城下之盟","pinyin":"chéng xià zhī méng","abbr":"cxzm","explanation":"指在敌方兵临城下时被迫签订的屈服的和约。","source":{"text":"大败之，为城下之盟而还。","book":"《左传·桓公十二年》"},"example":{"text":"国有已困之形，人有不困之志。君民效死，与城俱碎，岂肯为～哉。","book":"明·冯梦龙《东周列国志》第五十五回"},"similar":["身不由己","不由自主"],"opposite":["自食其力","自强自力"],"usage":"作主语、宾语；用于政治与军事方面","story":["春秋时楚国攻打绞国都城，在坚固的城防工事下，楚军并没有得到什么便宜。楚将屈瑕对楚王建议智取绞国。第二天故意派打柴的士兵给绞兵活捉，第三天又是如此，但伏兵早已攻入绞国，绞国无法，只好与楚国订立屈辱盟约"]},{"id":12909,"word":"城下之辱","pinyin":"chéng xià zhī rǔ","abbr":"cxzr","explanation":"指兵临城下屈膝求和的耻辱。","source":{"text":"越惟无耻，故安于城下之辱。","book":"梁启超《知耻学会叙》"},"usage":"作宾语；用于书面语"},{"id":12910,"word":"城中桃李","pinyin":"chéng zhōng táo lǐ","abbr":"cztl","explanation":"城里的桃李花，虽艳丽一时，但很快就凋谢了。比喻小人得志是不会长久的。","source":{"text":"城中桃李须臾尽，争似垂杨无限时。","book":"唐·刘禹锡《杨柳词》"}},{"id":12911,"word":"城北徐公","pinyin":"chéng běi xǘ gōng","abbr":"cbxg","explanation":"原指战国时期齐国姓徐的美男子。后作美男子的代称。","source":{"text":"城北徐公，齐国之美丽者也。","book":"西汉·刘向《战国策·齐策一》"},"example":{"text":"我没有～那么漂亮。"},"usage":"作宾语；指美男子","story":["战国时期，齐国大臣邹忌身高八尺，容貌漂亮，他穿上华丽的衣服问自己的妻子，自己与城北美男徐公谁美？妻子与妾都说他最美。第二天又问家里的来客，客人也是如此说。然而城北徐公来了，邹忌照了照镜子，感到自愧弗如"]},{"id":12912,"word":"城府深沉","pinyin":"chéng fǔ shēn chén","abbr":"cfsc","explanation":"城府：城市和官府，比喻深远用心。形容待人处事的心机深沉，使人难以揣测。","source":{"text":"性深阻若城府，而能宽绰以容纳。","book":"《晋书·愍帝纪论》"},"similar":["胸有城府","城府深密"],"opposite":["胸无城府"],"usage":"作谓语、定语；用于为人"},{"id":12913,"word":"城狐社鼠","pinyin":"chéng hú shè shǔ","abbr":"chss","explanation":"社：土地庙。城墙上的狐狸，社庙里的老鼠。比喻依仗权势作恶，一时难以驱除的小人。","source":{"text":"隗诚始祸，然城狐社鼠也。","book":"《晏子春秋·内篇问上》：“夫社，束木而涂之，鼠因而托焉，薰之则恐烧其木，灌之则恐败其涂。此鼠所以不可得杀者，以社故也。”《晋书·谢鲲传》"},"example":{"text":"以事论，则现在的教育界中实无豺虎，但有些～之流，那是当然不能免的。","book":"鲁迅《华盖集·“公理”的把戏》"},"similar":["狐假虎威"],"opposite":["光明正大"],"usage":"作宾语、定语；比喻仗势作恶的小人","story":["东晋晋武帝的女婿王敦在永嘉初年任扬州刺史，因受武帝宠臣刘隗的排挤，想办法消灭刘隗，请教于谢鲲。谢鲲说：“刘隗是城墙根下的狐狸，宗庙里的老鼠，我们不能用常规的挖掘和水灌的办法来对付。”"]},{"id":12914,"word":"城门失火，殃及池鱼","pinyin":"chéng mén shī huǒ，yāng jí chí yú","abbr":"cmshyjcy","explanation":"城门失火，大家都到护城河取水，水用完了，鱼也死了。比喻因受连累而遭到损失或祸害。","source":{"text":"但恐楚国亡猿，祸延林木，城门失火，殃及池鱼。","book":"北齐·杜弼《檄梁文》"},"example":{"text":"我是个平凡的人，不幸生在不平凡的时代，“～”，无端惹出许多是非。","book":"柯灵《回看血泪相和流》"},"similar":["城门鱼殃"],"usage":"作宾语、定语、分句；比喻无端受牵连而遭祸","story":["春秋时期，宋国的一城门发生火灾，火借着风势越烧越旺，城里的居民纷纷到护城河去取水灭火，大火被扑灭了，但护城河的河水也被舀干了，河里的鱼再也没法生存下去了"]},{"id":12915,"word":"城门鱼殃","pinyin":"chéng mén yú yāng","abbr":"cmyy","explanation":"城门失火，大家都到护城河取水，水用完了，鱼也死了。比喻因受连累而遭到损失或祸害。","source":{"text":"城门鱼殃，昆岗玉碎。","book":"明·李东阳《尹公墓志铭》"},"similar":["城门失火，殃及池鱼"],"usage":"作宾语、定语；用于书面语"},{"id":12916,"word":"埒才角妙","pinyin":"liè cái jué miào","abbr":"lcjm","explanation":"比才艺，争最妙。","source":{"text":"合场递进，按次而俟，埒才角妙，夸容乃理。","book":"汉·傅毅《舞赋》"},"example":{"text":"譬之青裙白发之节妇，乃与靓妆袨服之宫娥，争妍取怜，～，不惟取笑旁观。","book":"明·杨慎《升庵诗话》第11卷"}},{"id":12917,"word":"埒材角妙","pinyin":"liè cái jué miào","abbr":"lcjm","explanation":"比才艺，争美妙。","source":{"text":"合场递进，按次而俟，埒材角妙，夸容乃理。","book":"汉·傅毅《舞赋》"},"example":{"text":"譬之青裙白发之节妇，乃与靓妆袨服之宫娥，争妍取怜，～，不惟取笑旁观。","book":"明·杨慎《升庵诗话》第11卷"},"usage":"作谓语；比才艺，争最妙"},{"id":12918,"word":"埙倡篪和","pinyin":"xūn chàng chí hè","abbr":"xcch","explanation":"埙：土制乐器，形如鸡蛋，有六孔；篪：竹管乐器，像笛子，有八孔。旧时比喻兄弟和睦。","source":{"text":"凡所规画，兄不自谋，必以谘诸弟，弟剂度可否，听兄决之，埙倡篪和，如出一人。","book":"宋·洪咨夔《二锺君墓记》"}},{"id":12919,"word":"埙唱篪应","pinyin":"xūn chàng chí yìng","abbr":"xccy","explanation":"埙：土制乐器，形如鸡蛋，有六孔；篪：竹管乐器，像笛子，有八孔。旧时比喻兄弟和睦。","source":{"text":"公义顺而理和，埙唱篪应，璋判圭合，得于自然。","book":"宋·叶适《国子祭酒赠宝谟阁待制李公墓志铭》"}},{"id":12920,"word":"埙篪相和","pinyin":"xūn chí xiāng hè","abbr":"xcxh","explanation":"旧时比喻兄弟和睦。","source":{"text":"伯氏吹埙，仲氏吹篪。","book":"《诗经·小雅·何人斯》"},"usage":"作宾语、定语；用于兄弟间"},{"id":12921,"word":"埙篪相应","pinyin":"xūn chí xiāng yìng","abbr":"xcxy","explanation":"埙：土制乐器，形如鸡蛋，有六孔；篪：竹管乐器，像笛子，有八孔。旧时比喻兄弟和睦。","source":{"text":"兄弟同朝，埙篪相应，事无异议。","book":"宋·陈瓘《论蔡京》"},"example":{"text":"遥认～，为传珠贯累累。","book":"宋·程大昌《临江仙》词"}},{"id":12922,"word":"埙篪相须","pinyin":"xūn chí xiāng xū","abbr":"xcxx","explanation":"埙：土制乐器，形如鸡蛋，有六孔；篪：竹管乐器，像笛子，有八孔。旧时比喻兄弟和睦。","source":{"text":"感平生之游处，若埙篪之相须；何今日之两绝，若胡越之异区。","book":"汉·祢衡《鹦鹉赋》"}},{"id":12923,"word":"埳井之蛙","pinyin":"kǎn jǐng zhī wā","abbr":"kjzw","explanation":"废井里的青蛙。比喻见识不多的人。同“坎井之蛙”。"},{"id":12924,"word":"堂上一呼，阶下百诺","pinyin":"táng shàng yī hū，jiē xià bǎi nuò","abbr":"tsyhjxbn","explanation":"诺：答应。堂上一声呼唤，阶下齐声答应。多形容旧时豪门权贵威势烜赫，侍从和奉承的人很多。","source":{"text":"宋王大悦，饮酒室中。有呼万岁者，堂上尽应；堂上已应，堂下尽应。门外庭中闻之，莫敢不应。","book":"《吕氏春秋·过理》"},"example":{"text":"～。","book":"元·无名氏《举案齐眉》第二折"},"similar":["一呼百应"],"usage":"作宾语、定语；指一呼百应"},{"id":12925,"word":"堂哉皇哉","pinyin":"táng zāi huáng zāi","abbr":"tzhz","explanation":"犹堂而皇之。形容端正庄严或雄伟有气派。也指表面上庄严正大，堂堂正正，实际却不然。","source":{"text":"他有了这个引子，就格外的打点，格外的应酬，不到半年便放了海关道，堂哉皇哉的带了家眷，出京赴任。","book":"清·吴研人《二十年目睹之怪现状》第七十八回"},"example":{"text":"据说是曾和现代派的‘主将’在‘北京文艺界’上交过战了。好不～。","book":"鲁迅《而已集·革“首领”》"},"similar":["堂而皇之"],"usage":"作谓语、定语；指公然如此"},{"id":12926,"word":"堂堂一表","pinyin":"táng táng yī biǎo","abbr":"ttyb","explanation":"堂堂：形容庄严大方。形容仪表魁伟不凡，庄严大方。","source":{"text":"孔明致玄德之意华，偷眼看孙权，碧眼紫髯，堂堂一表。","book":"明·罗贯中《三国演义》第四十三回"},"example":{"text":"本帅看你～，象个英雄，故不将你解去。","book":"清·钱彩《说岳全传》第四十九回"},"similar":["相貌堂堂"],"usage":"作谓语、定语；用于书面语"},{"id":12927,"word":"堂堂之阵","pinyin":"táng táng zhī zhèn","abbr":"ttzz","explanation":"堂堂：壮盛的样子。形容阵容盛壮整齐。也用来形容光明正大。","source":{"text":"无要正正之旗，勿击堂堂之陈，此治变者也。","book":"《孙子·军争》"},"example":{"text":"尔乃小辈之言，我用～，正正之旗，岂有用暗器伤你之理？","book":"明·许仲琳《封神演义》第八十回"},"usage":"作主语、宾语；用于书面语"},{"id":12928,"word":"堂堂之阵，正正之旗","pinyin":"táng táng zhī zhèn，zhèng zhèng zhī qí","abbr":"ttzzzzzq","explanation":"堂堂：壮盛的样子；正正：整齐的样子。形容阵容盛壮整齐。也用来形容光明正大。","source":{"text":"无要正正之旗，勿击堂堂之陈，此治变者也。","book":"《孙子·军争》"},"example":{"text":"尔乃小辈之言，我用～，岂有用暗器伤你之理？","book":"明·许仲琳《封神演义》第八十回"}},{"id":12929,"word":"堂堂仪表","pinyin":"táng táng yí biǎo","abbr":"ttyb","explanation":"堂堂：形容庄严大方。形容仪表魁伟不凡，庄严大方。","source":{"text":"今尊兄堂堂仪表，名震四海，又与家兄同姓，正合家嫂所言。","book":"五代·王定保《唐摭言·海叙不遇》：“十三郎仪表堂堂，好个军将，何须以科第为资！”明·罗贯中《三国演义》第五十二回"},"example":{"text":"然妾死不足惜，但君～，甘为下贱，不图归计为恨耳！","book":"明·冯梦龙《醒世恒言》卷十九"}},{"id":12930,"word":"堂堂正正","pinyin":"táng táng zhèng zhèng","abbr":"ttzz","explanation":"堂堂：盛大的样子；正正：整齐的样子。原形容强大整齐的样子，现也形容光明正大。也形容身材威武，仪表出众。","source":{"text":"无要正正之旗，勿击堂堂之陈，此治变者也。","book":"《孙子·军争》"},"example":{"text":"就如那妒妇破坏人家，他却也有一番～的道理说出来，可知道家也却被他破了。","book":"清·刘鹗《老残游记》第十一回"},"similar":["正大光明"],"opposite":["歪门邪道"],"usage":"作谓语、定语、状语；指光明正大"},{"id":12931,"word":"堂皇冠冕","pinyin":"táng huáng guàn miǎn","abbr":"thgm","explanation":"形容表面上庄严或正大的样子。","source":{"text":"人言应制、早朝等诗，从无佳作，非也。此等诗竟将堂皇冠冕之字。累成善诵善祷之辞，献谀呈媚，岂有佳作？","book":"清·薛雪《一瓢诗话》四八"},"example":{"text":"将这手段使一个公爵使用，可见也是贵族的东西，～。","book":"鲁迅《三闲集·通信》"},"similar":["冠冕堂皇"],"usage":"作状语、宾语、定语；多用于讥讽"},{"id":12932,"word":"堂皇富丽","pinyin":"táng huáng fù lì","abbr":"thfl","explanation":"堂皇：盛大，雄伟；富丽：华丽。形容房屋宏伟豪华。也形容诗文词藻华丽。","source":{"text":"连忙灯下一看，只见当朝圣人出的是三个富丽堂皇的题目。","book":"清·文康《儿女英雄传》第三十四回"},"example":{"text":"小玉占住的是上首第一间，尤其布置得～，几等王宫。","book":"清·曾朴《孽海花》第三十五回"},"similar":["富丽堂皇"],"usage":"作谓语、定语、状语；用于建筑及文章"},{"id":12933,"word":"堂皇正大","pinyin":"táng huáng zhèng dà","abbr":"thzd","explanation":"形容言行光明公正，不偏不倚。","source":{"text":"宝玉又听宝钗这一番话，半是堂皇正大，半是体贴自己的私心，更觉比先心动神移。","book":"清·曹雪芹《红楼梦》第三十四回"},"similar":["光明正大"],"usage":"作谓语、定语、状语；用于书面语"},{"id":12934,"word":"堂而皇之","pinyin":"táng ér huáng zhī","abbr":"tehz","explanation":"堂皇：官署的大堂，引申为气势盛大的样子。形容端正庄严或雄伟有气派。也指表面上庄严正大，堂堂正正，实际却不然。","source":{"text":"末一句是客气话，赞成施先生的其实并不少，要不然，能堂而皇之的在杂志上发表吗？","book":"鲁迅《花边文学·“莎士比亚”》"},"example":{"text":"现在这时代，劳动做工是～的了。","book":"叶圣陶《四三集·一个练习生》"},"similar":["堂哉皇哉"],"usage":"作谓语、定语；指公然如此"},{"id":12935,"word":"堂高廉远","pinyin":"táng gāo lián yuǎn","abbr":"tgly","explanation":"廉：厅堂的侧边。比喻尊卑有定规。","source":{"text":"人主之尊譬如堂，群臣如陛，众庶如地。故陛九级上，廉远地，则高堂；陛亡级，廉近地，则堂卑。高者难攀，卑者易陵，理执然也。","book":"《汉书·贾谊传》"},"similar":["堂高级远"],"usage":"作宾语、定语；用于书面语"},{"id":12936,"word":"堂高级远","pinyin":"táng gāo jí yuǎn","abbr":"tgjy","explanation":"比喻尊卑有定规。","source":{"text":"人主之尊譬如堂，群臣如陛，众庶如地。故陛九级上，廉远地，则高堂；陛亡级，廉近地，则堂卑。高者难攀，卑者易陵，理执然也。","book":"《汉书·贾谊传》"},"similar":["堂高廉远"],"usage":"作宾语、定语；用于书面语"},{"id":12937,"word":"堆垛死尸","pinyin":"duī duò sǐ shī","abbr":"ddss","explanation":"堆垛：堆积；死尸：死人尸体。比喻文章一味拾取陈腐冷僻的典故，堆砌成文。","source":{"text":"凡作诗若正尔填塞，谓之‘点鬼簿’，亦谓之‘堆垛死尸’。","book":"宋·许凯《彦周诗话》"},"usage":"作宾语、定语；用于文章"},{"id":12938,"word":"堆山积海","pinyin":"duī shān jī hǎi","abbr":"dsjh","explanation":"堆积的如山似海。原形容占有的财富非常多。也比喻东西极多。","source":{"text":"别讲银子成了黄土，凭是世上有的，没有不堆山积海的。","book":"清·曹雪芹《红楼梦》第十六回"},"example":{"text":"若这么样算啊，那宝镜可就得～哪！（康濯《春种秋收·三面宝镜》）"},"similar":["堆积如山"],"opposite":["寥寥无几"],"usage":"作宾语、状语；形容多"},{"id":12939,"word":"堆案盈几","pinyin":"duī àn yíng jī","abbr":"dayj","explanation":"堆：堆积。案：案头。公文、书信、图书等堆积满案头。原指等待处理的文凭大量积压。后也指书籍或文字材料非常多。","source":{"text":"素不便书，又不喜作书，而人间多事，堆案盈机；不相酬答，则犯教伤义，欲自勉强，则不能久。","book":"三国·魏·嵇康《与山巨源绝交书》"},"example":{"text":"史稿～，以夜继日，仅了公家文书。","book":"宋·刘克庄《再宣索文集回奏状》"}},{"id":12940,"word":"堆积如山","pinyin":"duī jī rú shān","abbr":"djrs","explanation":"聚集成堆，如同小山。形容极多。","source":{"text":"每遇冬月，诸乡纳粟秆草，牛车阗塞道路，车尾相衔，数千万辆不绝，场内堆积如山。","book":"宋·孟元老《东京梦华录·外诸司》"},"example":{"text":"福王仓中的粮食～，朽得不能再吃。","book":"姚雪垠《李自成》第二卷第五十一章"},"similar":["堆集如山"],"opposite":["寥寥无几"],"usage":"作谓语、定语；形容极多"},{"id":12941,"word":"堆积成山","pinyin":"duī jī chéng shān","abbr":"djcs","explanation":"东西堆积得像山一样。形容极多。","source":{"text":"在目前的历史转变时期，问题堆积成山，工作百端待举，加强党的领导，端正党的作风，具有决定的意义。","book":"邓小平《坚持四项基本原则》"},"similar":["堆集如山","堆积如山"],"usage":"作谓语、定语；形容极多"},{"id":12942,"word":"堆金叠玉","pinyin":"duī jīn dié yù","abbr":"djdy","explanation":"形容财富极多。","source":{"text":"抽钗脱钏解环佩，堆金叠玉光青荧。","book":"唐·韩愈《华山女》诗"},"example":{"text":"那种～的打扮让人窒息。"},"similar":["堆金积玉"],"usage":"作谓语、定语；形容财富极多"},{"id":12943,"word":"堆金积玉","pinyin":"duī jīn jī yù","abbr":"djjy","explanation":"金玉多得可以堆积起来。形容占有的财富极多。","source":{"text":"堆金积玉夸豪毅。","book":"唐·李贺《昌谷集·嘲少年》诗"},"example":{"text":"怕不是～连城富，眨眼早野草闲花满地愁。","book":"元·钱霖《套数·哨遍》"},"similar":["堆金叠玉","腰缠万贯"],"opposite":["一贫如洗"],"usage":"作谓语、定语；形容财富充裕"},{"id":12944,"word":"堆金迭玉","pinyin":"duī jīn dié yù","abbr":"djdy","explanation":"形容财富极多。","source":{"text":"抽钗脱钏解环佩，堆金迭玉光青荧。","book":"唐·韩愈《华山女》诗"}},{"id":12945,"word":"堆集如山","pinyin":"duī jí rú shān","abbr":"djrs","explanation":"堆集：堆积。东西堆积得像山一样。形容极多。","source":{"text":"每遇冬月，诸乡纳粟秆草，牛车阗塞道路，车尾相衔，数千万辆不绝，场内堆集如山。","book":"宋·孟元老《东京梦华录·外诸司》"},"example":{"text":"收购回来的棉花在仓库都～了。"},"similar":["堆积如山"],"usage":"作谓语、定语；形容极多"},{"id":12946,"word":"堑山堙谷","pinyin":"qiàn shān yīn gǔ","abbr":"qsyg","explanation":"指挖山填谷。亦作“堙谷堑山”。","source":{"text":"三十五年，除道，道九原，抵云阳，，直通之。","book":"《史记·秦始皇本记》"},"example":{"text":"辽西单于蹋顿尤强，为袁氏所厚，故袁尚归之，数入为害，公出卢龙，～五百里。","book":"北魏郦道元《水经注·大辽水》"},"similar":["堙谷堑山"],"usage":"作谓语、宾语；指改造自然"},{"id":12947,"word":"堕云雾中","pinyin":"duò yún wù zhōng","abbr":"dywz","explanation":"堕：落下。落入迷茫的云雾中间。比喻迷惑不解。","source":{"text":"王仲祖刘真长造殷中军谈，谈竟俱载去，刘谓王曰：‘卿故堕其云雾中。’","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"吾观古诗无一字无着落，须细心探讨，方不堕入云雾中，则将来诗道有兴矣。","book":"徐增《而庵诗话》"},"similar":["一头雾水"],"usage":"作谓语、宾语；比喻迷惑不解"},{"id":12948,"word":"堕其术中","pinyin":"duò qí shù zhōng","abbr":"dqsz","explanation":"中了别人的庄重，落入人家布置的圈套。","source":{"text":"今若许澄通好，正是堕其计中。","book":"《梁书·傅岐传》"}},{"id":12949,"word":"堕坑落堑","pinyin":"duò kēng luò qiàn","abbr":"dklq","explanation":"堑：壕沟。掉进泥坑里，跌入壕沟中。比喻陷入错误境地。","source":{"text":"僧问：‘如何是大奄千手眼？’师曰：‘堕坑落堑。’","book":"宋·释惟白《续传灯录·汝州高阳法广禅师》"},"example":{"text":"吾人于此等处，直须见得分明，不然，未有不～者也。","book":"宋·黄干《复李贯之兵部》"}},{"id":12950,"word":"堕指裂肤","pinyin":"duò zhǐ liè fū","abbr":"dzlf","explanation":"手指冻掉了，皮肤冻裂了。形容天气非常寒冷。","source":{"text":"缯纩无温，堕指裂肤。","book":"唐·李华《吊古战场文》"},"usage":"作宾语、定语；用于天气寒冷"},{"id":12951,"word":"堕溷飘茵","pinyin":"duò hùn piāo yīn","abbr":"dhpy","explanation":"同“坠茵落溷”。亦作“坠溷飘茵”。比喻人之境遇高下悬殊。茵，垫褥；溷，厕所。","source":{"text":"人之生譬如一树花，同发一枝，俱于茵席之上，自有关篱墙，落于粪溷之侧。","book":"《梁书·儒林传·范缜传》"},"example":{"text":"夫姬既薄命为花，后此之～，诚难自主。","book":"清·捧花生《画舫馀谭》"},"similar":["坠茵落溷","坠溷飘茵"],"usage":"作宾语、定语；比喻境遇好坏不同","story":["南朝梁代时期，子良与无神论者范缜在一起谈人生富贵之事，问富贵与因果的关系。范缜回答说：“人生就同一树花，虽然同处于一根树枝上，突然刮起了大风，花瓣有随风飘到富贵人家的座垫上，也有飘到人家厕所里的，因果在起作用。”"]},{"id":12952,"word":"堕珥遗簪","pinyin":"duò ěr yí zān","abbr":"deyz","explanation":"珥：珠玉耳饰；簪：插髻的首饰。形容女子在游玩、交际时志气轻狂忘情的景象。","source":{"text":"前有堕珥，后有遗簪，髡窃乐此，饮可八斗而醉二参。","book":"《史记·滑稽列传》"},"example":{"text":"～想无限，华胥犹见梦回人。","book":"宋·苏轼《和苏州太守王规甫侍太夫人观灯之什余时以刘道原见访滞留京口不及赴此会二首》其二"}},{"id":12953,"word":"堕甑不顾","pinyin":"duò zèng bù gù","abbr":"dzbg","explanation":"甑：古代一种瓦制炊器；顾：回头看。甑落地已破，不再看它。比喻既成事实，不再追悔。","source":{"text":"客居太原，荷甑堕地，不顾而去。林宗见而问其意，对曰：‘甑已破矣，视之何益。’","book":"南朝·宋·范晔《后汉书·郭泰传》"},"example":{"text":"已弃不问，曰～。","book":"宋·胡继宗《书言故事大全》第12卷"},"usage":"作谓语、宾语、定语；比喻既成事实","story":["东汉时期，孟敏曾经客居太原，一次他挑着甑，一不小心掉在地上，他头也不回就走了。林宗看见后问他为什么不去检查甑的破损情况，他说甑都破了，再看他有什么用呢？"]},{"id":12954,"word":"堕高堙庳","pinyin":"huī gāo yīn bēi","abbr":"dgyb","explanation":"堕：通“隳”，毁坏；堙：堵塞；庳：低处，指沼泽。削平高丘，填塞洼地。指治理水土。","source":{"text":"昔共工欲壅防百川，堕高堙庳，以害天下。","book":"春秋·鲁·左丘明《国语·周语》"},"usage":"作宾语、定语；用于处事"},{"id":12955,"word":"堙谷堑山","pinyin":"yīn gǔ qiàn shān","abbr":"ygqs","explanation":"指挖山填谷。","source":{"text":"堙谷堑山通缅藏，经天纬地造蓬莱。","book":"郭沫若《宿楚雄》诗"},"similar":["堑山堙谷"],"usage":"作谓语、宾语；指改造自然"},{"id":12956,"word":"堤溃蚁孔","pinyin":"dī kuì yǐ kǒng","abbr":"dkyk","explanation":"堤坝因蚂蚁洞而崩溃。比喻忽视小处会酿成大祸。","source":{"text":"千丈之堤，以蝼蚁之穴溃。","book":"战国·韩·韩非《韩非子·喻老》"},"example":{"text":"臣闻轻者重之端，小者大之源，故～，气泄针芒。","book":"南朝·宋·范晔《后汉书·陈忠传》"},"similar":["堤溃蚁穴"],"usage":"作谓语、定语；指小疏忽会酿大错","story":["战国时期，魏国相国白圭在防洪方面很有成绩，他善于筑堤防洪，并勤查勤补，经常巡视，一发现小洞即使是极小的蚂蚁洞也立即派人填补，不让它漏水，以免小洞逐渐扩大、决口，造成大灾害。白圭任魏相期间，魏国没有闹过水灾"]},{"id":12957,"word":"堤溃蚁穴","pinyin":"dī kuì yǐ xué","abbr":"dkyx","explanation":"小小的蚂蚁窝，能够使堤岸溃决。比喻小事不注意，就会出大乱子。","source":{"text":"细微可不慎，堤溃自蚁穴。","book":"《韩非子·喻老》：“千丈之堤，以蝼蚁之穴溃；百尺之宝，以突隙之烟焚。”三国·魏·应璩《杂诗》"},"similar":["蚁穴溃堤"],"usage":"作宾语、定语；用于劝诫人","story":["战国时期，魏国相国白圭在防洪方面很有成绩，他善于筑堤防洪，并勤查勤补，经常巡视，一发现小洞即使是极小的蚂蚁洞也立即派人填补，不让它漏水，以免小洞逐渐扩大、决口，造成大灾害。白圭任魏相期间，魏国没有闹过水灾"]},{"id":12958,"word":"堪以告慰","pinyin":"kān yǐ gào wèi","abbr":"kygw","explanation":"堪：能，可以。可以感到或给予一些安慰。","example":{"text":"近年来，我对此每每撰文加以表述，并获海内外广大读者的赞同和好评，～。","book":"林默涵、魏巍《我们唾弃那种中国人》第二章"},"similar":["聊以告慰"],"usage":"作谓语、定语；用于书面语"},{"id":12959,"word":"堪托死生","pinyin":"kān tuō sǐ shēng","abbr":"ktss","explanation":"堪：能够，可以。能够将生死大事相托付。比喻完全可以依赖和依靠。","source":{"text":"所向无空阔，真堪托死生。","book":"唐·杜甫《房兵曹胡马》诗"}},{"id":12960,"word":"堵塞漏卮","pinyin":"dǔ sāi lòu zhī","abbr":"dslz","explanation":"漏卮：有漏洞的盛酒器。比喻堵塞住利益外溢的漏洞。","source":{"text":"奏请设立纺织局，谋堵塞漏卮。","book":"范文澜《中国近代史》上册第五章"},"example":{"text":"我们得尽快采取～的措施。"},"usage":"作谓语、定语；指堵漏洞"},{"id":12961,"word":"塌下窟窿","pinyin":"tā xià kū lóng","abbr":"txkl","explanation":"比喻欠下了债。","source":{"text":"今年你娶了媳妇，塌下十块钱窟窿。","book":"阮章竞《赤叶河》"},"usage":"作谓语、定语；用于口语"},{"id":12962,"word":"塍蛇无足而飞","pinyin":"téng shé wú zú ér fēi","abbr":"cswzef","explanation":"比喻用心专一，必然成功。","source":{"text":"塍蛇无足而飞，梧鼠五技而穷。","book":"《荀子·劝学》"}},{"id":12963,"word":"塔尖上功德","pinyin":"tǎ jiān shàng gōng dé","abbr":"tjsgd","explanation":"比喻快要完成的工作。","source":{"text":"这是个权宜之术。贤弟须知，塔尖上功德，休得固辞。","book":"明·冯梦龙《醒世恒言》卷七"}},{"id":12964,"word":"塞上江南","pinyin":"sāi shàng jiāng nán","abbr":"ssjn","explanation":"原指古凉州治内贺兰山一带。后泛指塞外富庶之地。同“塞北江南”。","source":{"text":"我们这一回参观访问，常常听见‘塞上江南’的说法，常常看见‘塞上江南’的字样。","book":"叶圣陶《坝上一天》"},"similar":["塞北江南"],"usage":"作宾语、定语；用于北方的地方"},{"id":12965,"word":"塞井夷灶","pinyin":"sāi jǐng yí zào","abbr":"sjyz","explanation":"填井平灶。谓作好布阵的准备。亦表示决心战斗，义无反顾。","source":{"text":"荀偃令曰：‘鸡鸣而驾，塞井夷灶，唯余马首是瞻！’","book":"《左传·成公十六年》：“楚晨压晋军而陈。军吏患之。范匄趋进，曰：‘塞井夷灶，陈于军中，而疏行首。’”又《襄公十四年》"},"similar":["塞井焚舍"],"usage":"作谓语、定语、宾语；用于军事等"},{"id":12966,"word":"塞井焚舍","pinyin":"sāi jǐng fén shě","abbr":"sjfs","explanation":"填井烧屋，表示决心死战。","source":{"text":"[林子]塞井焚舍，示无全志。率麾下数百人，犯其西北。","book":"《南史·沈约传》"},"similar":["塞井夷灶"],"usage":"作谓语、定语、宾语；用于军事等"},{"id":12967,"word":"塞北江南","pinyin":"sāi běi jiāng nán","abbr":"sbjn","explanation":"原指古凉州治内贺兰山一带。后泛指塞外富庶之地。","source":{"text":"贺兰山下果园成，塞北江南旧有名。","book":"唐·韦蟾《送卢潘沿书之灵武》诗"},"similar":["塞上江南"],"usage":"作宾语、定语；用于北方的地方"},{"id":12968,"word":"塞狗洞","pinyin":"sāi gǒu dòng","abbr":"sgd","explanation":"把银钱花在无用的地方。","source":{"text":"我有三万银子，我大八成的道台都可捐得了。我为什么拿钱塞狗洞！","book":"清·李宝嘉《官场现形记》第35回"},"example":{"text":"你这点钱还不够她～呢。"},"usage":"作谓语、宾语；用于口语"},{"id":12969,"word":"塞翁之马","pinyin":"sài wēng zhī mǎ","abbr":"swzm","explanation":"塞马。比喻得失无常，祸福相倚。","source":{"text":"嗟乎嗟乎！廿年幻梦，如此收场；万里故乡，罔知所适。若论祸福，塞翁之马难知；语到死生，庄子之龟未卜。叹浮生其若梦，为欢几何？抚结局以如斯，前尘已矣。","book":"清·黄小配《廿载繁华梦》序一"}},{"id":12970,"word":"塞翁失马","pinyin":"sài wēng shī mǎ","abbr":"swsm","explanation":"塞：边界险要之处；翁：老头。比喻一时虽然受到损失，也许反而因此能得到好处。也指坏事在一定条件下可变为好事。","source":{"text":"近塞上之人有善术者，马无故亡而入胡。人皆吊之。其父曰：‘此何遽不为福乎？’居数月，其马将胡骏马而归。人皆贺之。…故福之为祸，祸之为福，化不可极，深不可测也。","book":"《淮南子·人间训》"},"example":{"text":"处士有志未遂，甚为可惜，然“～，安知非福”。","book":"清·李汝珍《镜花缘》第七回"},"similar":["失之东隅","因祸得福"],"opposite":["因福得祸"],"usage":"作宾语、定语、分句；用于安慰语","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":12971,"word":"塞翁失马，安知非福","pinyin":"sài wēng shī mǎ，ān zhī fēi fú","abbr":"swsmazff","explanation":"比喻一时虽然受到损失，也许反而因此能得到好处。也指坏事在一定条件下可变为好事。同“塞翁失马”。","source":{"text":"处士有志未遂，甚为可惜，然塞翁失马，安知非福？","book":"《镜花缘》第七回"},"example":{"text":"但真所谓‘塞翁失马安知非福’罢，阿Q不幸而赢了一回，他倒几乎失败了。","book":"鲁迅《呐喊·阿Q正传》"},"similar":["塞翁失马，焉知非福"],"usage":"作宾语、定语、分句；用于安慰语","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":12972,"word":"塞翁失马，焉知非福","pinyin":"sài wēng shī mǎ，yān zhī fēi fú","abbr":"swsmyzff","explanation":"比喻一时虽然受到损失，也许反而因此能得到好处。也指坏事在一定条件下可变为好事。同“塞翁失马，安知非福”。","source":{"text":"塞翁失马，焉知非福，你眼前不信俺的话也罢，到了日后，才觉得俺不是说笑话哩。","book":"孙锦标《通俗常言疏证·祸福》引《病玉缘》剧"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“如果能够调动一个缺，真正是‘～’了。”"},"similar":["塞翁失马，安知非福"],"usage":"作宾语、定语、分句；用于安慰语","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":12973,"word":"塞翁得马","pinyin":"sài wēng dé mǎ","abbr":"swdm","explanation":"比喻得失无常，祸福相倚。","source":{"text":"塞翁得马非为吉，宋子双盲岂是凶。祸福前程如漆暗，但平方寸答天公。","book":"明·冯梦龙《警世通言》十五卷"},"example":{"text":"精神乏，安心要把驴儿跨，又谁知～，塞翁得马。","book":"清·李渔《比目鱼·耳热》"},"similar":["塞翁失马"],"usage":"作宾语、定语；用于比喻句"},{"id":12974,"word":"塞耳偷铃","pinyin":"sāi ěr tōu líng","abbr":"setl","explanation":"比喻自己欺骗自己的愚蠢行为。","source":{"text":"如此见解，即是落空亡底外道，鬼不散底死人，冥冥漠漠，无觉无知，塞耳偷铃，徒自欺诳。","book":"《五灯会元·雪峰存禅师法嗣》"},"example":{"text":"这是～的做法。"},"similar":["掩耳盗铃","塞耳盗钟"],"usage":"作谓语、定语、状语；指自欺欺人"},{"id":12975,"word":"塞耳盗钟","pinyin":"sāi ěr dào zhōng","abbr":"sedz","explanation":"比喻自欺欺人，硬要掩盖掩盖不了的事情。","source":{"text":"百姓有得钟者，欲负而走，则钟大不可负，以椎毁之，钟况然有音，恐人闻之而夺己也，遽揜其耳。","book":"《吕氏春秋·自知》"},"example":{"text":"《魏书·尔朱荣传》：“惟欲指影以行权，假形而弄招，此则掩眼捕雀，～。”"},"similar":["塞耳偷铃","掩耳盗铃"],"usage":"作谓语、定语、宾语；用于处事","story":["从前有个小偷发现人家家门口挂着一口很大的铜钟，他想偷但一个人搬不动，想把他敲碎卖碎铜，担心敲钟时别人听到声音而偷不成，终于想出一个绝妙的主意，就是把自己的耳朵用棉花塞住听不到声音，结果偷窃时被当场逮住"]},{"id":12976,"word":"填坑满谷","pinyin":"tián kēng mǎn gǔ","abbr":"tkmg","explanation":"塞满坑谷。比喻物资丰富充足。","source":{"text":"佗佗籍籍，填坑满谷，掩平弥泽。","book":"汉·司马相如《上林赋》"},"usage":"作谓语、定语；比喻物资丰富充足"},{"id":12977,"word":"填街塞巷","pinyin":"tián jiē sāi xiàng","abbr":"tjsx","explanation":"形容人非常多。","source":{"text":"又生不长发，便谓为道人，填街溢巷，是处皆然。","book":"《南齐书·虞玩之传》"},"usage":"联合式；作谓语、定语；形容人非常多"},{"id":12978,"word":"填街溢巷","pinyin":"tián jiē yì xiàng","abbr":"tjyx","explanation":"形容人非常多。","source":{"text":"又生不长发，便谓为道人，填街溢巷，是处皆然。","book":"《南齐书·虞玩之传》"}},{"id":12979,"word":"墓木已拱","pinyin":"mù mù yǐ gǒng","abbr":"mmyg","explanation":"坟墓上的树木已有两手合抱那么粗了。意思是你快要死了。这是骂人的话。后指人死了很久。","source":{"text":"尔何知？中寿，尔墓之木拱亦。","book":"《左传·僖公三十二年》"},"example":{"text":"同时修书之人～，存者唯仆，尤可感叹。","book":"宋·范祖禹《答刘仙尉书》"},"opposite":["尸骨未寒"],"usage":"作谓语；指人死去多年"},{"id":12980,"word":"墓木拱矣","pinyin":"mù mù gǒng yǐ","abbr":"mmgy","explanation":"坟墓上的树木已有两手合抱那么粗了。意思是你快要死了。这是骂人的话。后指人死了很久。","source":{"text":"尔何知？中寿，尔墓之木拱亦。","book":"《左传·僖公三十二年》"},"example":{"text":"臣若不遭陛下之明，～。","book":"《宋书·张茂度传》"}},{"id":12981,"word":"墙上泥皮","pinyin":"qiáng shàng ní pí","abbr":"qsnp","explanation":"比喻无用之物或微贱的人。","source":{"text":"你可休觑的微贱看的容易，莫把这堂中珍宝，你可休看承做墙上以。","book":"元·无名氏《刘弘嫁婢》第二折"},"example":{"text":"可正是堂上的糟糠，休猜作～。","book":"元·郑廷玉《楚昭公》第四折"},"usage":"作宾语、定语；用于附属物"},{"id":12982,"word":"墙倒众人推","pinyin":"qiáng dǎo zhòng rén tuī","abbr":"qdzrt","explanation":"旧时比喻在一个人受挫折的时候，大家乘机打击他。","source":{"text":"他虽好性儿，你们也该拿出个样儿来，别太过逾了，墙倒众人推。","book":"清·曹雪芹《红楼梦》第六十九回"},"example":{"text":"佣人们也呼唤不灵了，总之“～”了。（朱自清《笑的历史》）"},"similar":["破鼓万人锤","乘人之危","趁火打劫"],"opposite":["扶危济困"],"usage":"作谓语、分句；用于官场","story":["唐明宗时期，董璋在四川叛乱，唐明宗派安重诲亲自去押送粮草，受到凤翔节度使朱弘昭的陷害，被调任河中节度使。唐明宗派翟光业与李从璋去河中观察他的活动，说如果发现有叛乱的迹象就处死安重诲。李从璋借机杀害安重诲一家"]},{"id":12983,"word":"墙外汉","pinyin":"qiáng wài hàn","abbr":"qwh","explanation":"指非局中之人，不属于某专业或不专于某门知识或艺术的人。","source":{"text":"我身分自当，枉杀墙外汉。","book":"南宋·郭茂倩《乐府诗集·慕容垂歌辞》"},"similar":["门外汉"],"usage":"作宾语、定语；指非局中之人"},{"id":12984,"word":"墙头草","pinyin":"qiáng tóu cǎo","abbr":"qtc","explanation":"比喻无主见的人、顺风倒的人。","example":{"text":"她是～——风吹两边倒的人物。"},"usage":"作宾语、定语；用于口语"},{"id":12985,"word":"墙头马上","pinyin":"qiáng tóu mǎ shàng","abbr":"qtms","explanation":"为男女爱慕之典实。","source":{"text":"妾弄青梅凭短墙，君骑白马傍垂杨。墙头马上遥相顾，一见知君即断肠。","book":"唐·白居易《井底引银瓶》诗"},"example":{"text":"今夜里早赴佳期，成就了～。","book":"元·白朴《墙头马上》第一折"},"similar":["马上墙头","花前月下"],"usage":"作宾语、状语；指男女相互爱慕"},{"id":12986,"word":"墙有缝，壁有耳","pinyin":"qiáng yǒu fèng，bì yǒu ěr","abbr":"qyfbye","explanation":"指秘密泄露。","source":{"text":"墙有耳，伏寇在侧。墙有耳者，微谋外泄之谓也。","book":"《管子·君臣下》"},"example":{"text":"你咬人的狗儿不露齿，是言不是语～。","book":"明·兰陵笑笑生《金瓶梅词话》第二十六回"},"similar":["隔墙有耳"],"usage":"作宾语、定语、分句；指小心秘密泄漏"},{"id":12987,"word":"墙有耳","pinyin":"qiáng yǒu ěr","abbr":"qye","explanation":"比喻秘密易于外泄。同“隔墙有耳”。","source":{"text":"古者有二言：墙有耳，伏寇在侧。墙有耳者，微谋外泄之谓也。","book":"语出《诗·小雅·小弁》：“君子无易由言，耳属于垣。”《管子·君臣下》"},"similar":["隔墙有耳"],"usage":"作宾语、定语、分句；指小心秘密泄漏"},{"id":12988,"word":"墙花路柳","pinyin":"qiáng huā lù liǔ","abbr":"qhll","explanation":"墙边的花，路旁的柳。比喻不被人尊重的女子。旧时指妓女。","source":{"text":"风流。恩情怎比，墙花路柳？记待月西厢，和你携素手。","book":"明·高明《二郎神·秋怀》套曲"},"example":{"text":"假如～，偶然适兴，无损于事。","book":"《古今小说·蒋兴哥重会珍珠衫》"},"similar":["路柳墙花","墙花路草"],"usage":"作主语、宾语；比喻行为放荡的女子"},{"id":12989,"word":"墙花路草","pinyin":"qiáng huā lù cǎo","abbr":"qhlc","explanation":"比喻不被人尊重的女子。旧时指妓女。同“墙花路柳”。","source":{"text":"如本是柔枝嫩条，休比做墙花路草。","book":"明·徐复祚《红梨记·诗要》：“非执拗，那壁厢是墙花路草，怎比得日边红杏倚云高？”明·高濂《玉簪记·词媾》"},"example":{"text":"彼～，尚且钟情不舍，到底得合，况贵为妃嫔者乎！","book":"清·褚人获《隋唐演义》第九十七回"},"similar":["墙花路柳"],"usage":"作宾语；比喻行为放荡的女子"},{"id":12990,"word":"墙里开花墙外香","pinyin":"qiáng lǐ kāi huā qiáng wài xiāng","abbr":"qlkhqwx","explanation":"比喻人做出了成绩，内部还不知道，外面人倒先知道了。比喻成绩不受本部门重视，却为其他部门赏识。","example":{"text":"这就是～的状况。"},"usage":"作宾语、定语、分句；指个人的名气"},{"id":12991,"word":"墙面而立","pinyin":"qiáng miàn ér lì","abbr":"qmel","explanation":"指面对墙壁。目无所见。比喻不学无术。亦作“面墙而立”。","source":{"text":"人而不为《周南》《召南》，其犹正墙面而立也与？","book":"《书·周官》：“不学墙面”孔传：“人而不学，其犹正墙面而立。”《论语·阳货》"},"example":{"text":"若使～，沐猴而冠，吾所不取。","book":"南朝·梁·简文帝《诫当阳公大心书》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":12992,"word":"墙风壁耳","pinyin":"qiáng fēng bì ěr","abbr":"qfbe","explanation":"比喻秘密容易泄露，宜多防范。","source":{"text":"公子不可乱步，墙风壁耳，速速请回，奴家得罪了。","book":"明·罗贯中《粉妆楼》第十四回"},"example":{"text":"你想～，万一传了出去，说我窝藏徐锡麟的党羽，叫我如何吃罪得起。","book":"清·毕伟生《开国奇冤·逮捕》"},"similar":["隔墙有耳"],"usage":"作宾语、定语；用于秘密等"},{"id":12993,"word":"墙高基下","pinyin":"qiáng gāo jī xià","abbr":"qgjx","explanation":"比喻名位虽高而才德低下。","source":{"text":"史叔宾者，陈留人也。少有盛名。林宗见而告人曰：‘墙高基下，虽得必失。’后果以论议阿枉败名云。","book":"《后汉书·郭太传》"},"example":{"text":"行不适道，文胜其质，郭林宗所谓～，虽得必丧，此之徒也。","book":"《北史·序传》"},"usage":"作宾语、定语；用于比喻句"},{"id":12994,"word":"增收节支","pinyin":"zēng shōu jié zhī","abbr":"zsjz","explanation":"增加收入，节约开支。","example":{"text":"我们目前的工作重心是～"},"similar":["开源节流"],"usage":"作谓语、宾语、定语；用于处事"},{"id":12995,"word":"增砖添瓦","pinyin":"zēng zhuān tiān wǎ","abbr":"zztw","explanation":"犹添砖加瓦。比喻做一些工作，尽一点力量。","example":{"text":"多挖一锹煤，也是给社会主义建设增砖添瓦嘛！"},"similar":["添砖加瓦"],"usage":"作谓语、定语；指尽力作贡献"},{"id":12996,"word":"墨丈寻常","pinyin":"mò zhàng xún cháng","abbr":"mzxc","explanation":"古代重量单位，1墨＝5尺，1丈＝2墨；1寻＝8尺，1常＝2寻。比喻不太长的距离。","source":{"text":"不过墨丈寻常之间。","book":"春秋·鲁·左丘明《国语·周语下》"},"usage":"作宾语、定语；指短距离"},{"id":12997,"word":"墨债山积","pinyin":"mò zhà shān jī","abbr":"mzsj","explanation":"山积：堆积如山。比喻由于书法好，求写字的人很多，应付不过来而欠下债。"},{"id":12998,"word":"墨子泣丝","pinyin":"mò zǐ qì sī","abbr":"mzqs","explanation":"比喻人变好变坏，环境的影响关系很大。","source":{"text":"墨子见练丝而泣之，为其可以黄可以黑。","book":"《淮南子·说林训》"},"usage":"作宾语、定语；用于书面语"},{"id":12999,"word":"墨守成法","pinyin":"mò shǒu chéng fǎ","abbr":"mscf","explanation":"指思想保守，守着老规矩不肯改变。同“墨守成规”。","source":{"text":"盖用心不专，率皆墨守成法，未能推陈出新耳。","book":"清·王韬《翁牖余谈·犹太古历说》"},"similar":["墨守成法"],"opposite":["推陈出新"],"usage":"作谓语、定语；指思想固执保守"},{"id":13000,"word":"墨守成规","pinyin":"mò shǒu chéng guī","abbr":"mscg","explanation":"墨守：战国时墨翟善于守城；成规：现成的或久已通行的规则、方法。指思想保守，守着老规矩不肯改变。","source":{"text":"如钟嵘之《诗品》，辨体明宗，固未尝墨守一家以为准的也。","book":"明·黄宗羲《钱退山诗文序》"},"example":{"text":"～，不敢勇于创造也决然是和客观事物的发展规律不能相容的。","book":"秦牧《辩证规律在艺术创作上的运用》"},"similar":["因循守旧","故步自封","抱残守缺"],"opposite":["标新立异","推陈出新"],"usage":"作谓语、定语、宾语；指思想固执保守","story":["战国时期，木匠出身的墨翟主张兼爱与非攻，到处推广他的学说。楚国要去攻打宋国，鲁班为楚军设计攻城的云梯。墨子急忙去劝阻这场战争，楚王让墨子与鲁班比试比试攻防演习，墨子善于防守，鲁班败北。楚王只好放弃攻打宋国"]},{"id":13001,"word":"墨客骚人","pinyin":"mò kè sāo rén","abbr":"mksr","explanation":"墨客：文人；骚人：诗人。泛指文人。","source":{"text":"诗人墨客，争讽新篇。","book":"唐·韩愈《祭薛中丞文》"},"example":{"text":"～最喜欢造势了。"},"similar":["文人墨客","骚人墨客"],"opposite":["胸无点墨"],"usage":"作主语、宾语、定语；指文人"},{"id":13002,"word":"墨汁未干","pinyin":"mò zhī wèi gān","abbr":"mzwg","explanation":"写字的墨汁还没有干。比喻协定或盟约刚刚签订不久（多用于指责对方违背诺言）。","source":{"text":"墨迹未干，题笔人何在？","book":"明·冯梦龙《喻世明言·杨思温燕山逢故人》"},"example":{"text":"可是～，将军们即奉命作成消灭边区的军事计划。","book":"毛泽东《评国民党十一中全会和三届二次国民参政会》"},"similar":["墨迹未干"],"usage":"作宾语、定语；用于指责对方违背诺言"},{"id":13003,"word":"墨突不黔","pinyin":"mò tū bù qián","abbr":"mtbq","explanation":"原指墨翟东奔西走，每至一地，烟囱尚未熏黑，又到别处去了。后用其事为典。形容事情繁忙，犹言席不睱暖。","source":{"text":"孔席不暖，墨突不黔。","book":"东汉·班固《答宾戏》"},"example":{"text":"他经常忙得席不暇暖、～。"},"similar":["席不暇暖"],"usage":"作宾语、状语；指十分繁忙","story":["战国时期，大思想家墨翟反对恃强欺弱的战争，呼吁平等互爱，经常奔走各个诸侯国，到处宣传他的“非战”主张。由于他四处奔走，从来没有一个固定长住的住处。汉朝班固评价他为：“孔席不暖，墨突不黔。”"]},{"id":13004,"word":"墨绖从戎","pinyin":"mò dié cóng róng","abbr":"mdcr","explanation":"墨：黑色；绖：古时丧服中围在头上和腰间的散麻绳；从戎：从军。指在守丧期间从军作战。","source":{"text":"晋文公未葬，故襄公称子，以凶服从戎。","book":"《左传·僖公三十三年》：“遂发命，遽兴姜戎，子墨衰绖。”杜预注"},"example":{"text":"假如遇着军事，正在军兴旁午，也只得～，回籍成服。","book":"清·文康《儿女英雄传》第十七回"}},{"id":13005,"word":"墨迹未干","pinyin":"mò jì wèi gān","abbr":"mjwg","explanation":"写字的墨迹还没有干。比喻协定或盟约刚刚签订不久（多用于指责对方违背诺言）。","source":{"text":"墨迹未干，题笔人何在？","book":"明·冯梦龙《喻世明言·杨思温燕山逢故人》"},"example":{"text":"《双十协定》的～，国民党军队就大举进犯我晋冀鲁豫解放区和中原解放区。","book":"童小鹏《毛主席到重庆》"},"similar":["墨汁未干","口血未干"],"usage":"作谓语、宾语、定语；用于指责对方违背诺言"},{"id":13006,"word":"墨鱼自蔽","pinyin":"mò yú zì bì","abbr":"myzb","explanation":"墨鱼体内有似墨的一种汁，遇到危险时就放出墨汁，巧妙地使自己隐蔽起来。比喻自觉地隐蔽自己，不使暴露。"},{"id":13007,"word":"壁上观","pinyin":"bì shàng guāng","abbr":"bsg","explanation":"壁：营垒。比喻坐观胜负而不帮助任何一方。","source":{"text":"及楚击秦，诸将皆从壁上观。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"我只好作～。"},"similar":["坐观成败"],"opposite":["拔刀相助"],"usage":"作宾语、定语；指人袖手旁观"},{"id":13008,"word":"壁垒分明","pinyin":"bì lěi fēn míng","abbr":"blfm","explanation":"壁垒：古时军营的围墙，后泛指防御工事，今常喻指对立的事物和界限。比喻界限非常清楚。"},{"id":13009,"word":"壁垒森严","pinyin":"bì lěi sēn yán","abbr":"blsy","explanation":"壁垒：古代军营四周的围墙；森严：整齐，严肃。原指军事戒备严密。现也用来比喻彼此界限划得很分明。","source":{"text":"《兴州江运记》叙述议论，皆以典奥出之，可谓避垒森严，神采焕发。","book":"清·陈鸿墀《全唐文纪事·卷首》"},"example":{"text":"声威震摄长愉塞，～细柳营。","book":"刘复《代某君寿某将军夫妇》"},"similar":["严阵以待","固若金汤"],"opposite":["不堪一击","一触即溃"],"usage":"作谓语、定语；用于军事防守严密和界限"},{"id":13010,"word":"壁立千仞","pinyin":"bì lì qiān rèn","abbr":"blqr","explanation":"壁立：峭壁陡立。形容岩石高耸。","source":{"text":"其山惟石，壁立千仞，临之目眩。","book":"晋·张载《剑阁铭》：“惟蜀之门，作固作镇，是日剑阁，壁立千仞。”《水经·河水注》"},"example":{"text":"海纳百川，有容乃大。～，无欲则刚。"},"similar":["悬崖绝壁"],"opposite":["一马平川"],"usage":"作定语、状语；指山势陡峭"},{"id":13011,"word":"壁里安柱","pinyin":"bì lǐ ān zhù","abbr":"blaz","explanation":"在墙壁里加安支柱。比喻加强锻炼，以增强体质。","source":{"text":"祖师道：‘若要长生，也似壁里安柱。’","book":"明·吴承恩《西游记》第三回"}},{"id":13012,"word":"壁间蛇影","pinyin":"bì jiān shé yǐng","abbr":"bjsy","explanation":"犹“杯弓蛇影”。形容疑神疑鬼，徒自惊扰。","source":{"text":"据汉应劭《风俗通·怪神》所记：杜宣饮酒，见杯中似有蛇，酒后胸腹作痛，多方医治不愈；后知为壁上所悬赤弩照于杯，形如蛇，病即愈。《晋书·乐广传》也有类似记述。"},"example":{"text":"若于此处稍参不破，则昔人所谓～，足以生疑而致病。","book":"明·唐顺之《答王龙溪郎中书》"},"similar":["杯弓蛇影"],"usage":"作宾语、定语；指人疑心重"},{"id":13013,"word":"士为知己者死","pinyin":"shì wèi zhī jǐ zhě sǐ","abbr":"swzjzs","explanation":"知己者：了解自己，信用自己的人。指甘愿为赏识自己、栽培自己的人献身。","source":{"text":"士为知己者死，女为悦己者容，吾其报知氏之雠矣。","book":"《战国策·赵策一》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第42回：“岂不闻‘～’？又岂不闻‘国士遇我，国士报之’？”"},"similar":["士死知己"],"usage":"作宾语、定语；用于处事"},{"id":13014,"word":"士俗不可医","pinyin":"shì sú bù kě yī","abbr":"ssbky","explanation":"俗：庸俗；医：医治。俗气已深，不可救药。","source":{"text":"无肉令人瘦，无竹令人俗。人瘦尚可肥，士俗不可医。","book":"宋·苏轼《于潜僧绿筠轩》诗"},"example":{"text":"余戏谓此二诗绝妙，“十里莺啼”，俗人添一撇坏了，“草未凋”，俗人减一画坏了，甚矣，～也。","book":"明·杨慎《升庵诗话》卷八"}},{"id":13015,"word":"士农工商","pinyin":"shì nóng gōng shāng","abbr":"sngs","explanation":"古代所谓四民，指读书的、种田的、做工的、经商的。","source":{"text":"是以人不兼官， 官不兼事，士农工商，乡别州异，是故农与农言力，士与士言行，工与工言巧， 商与商言数。","book":"《管子·小匡》：“士农工商四民者，国之石（柱石）民也。”《淮南子·齐俗训》"},"example":{"text":"下面密密层层，有亿万人来来往往，都想争夺此物。细细看去，～，三教九流，无一不有。","book":"清·李汝珍《镜花缘》第九十九回"},"usage":"作宾语、定语；用于书面语"},{"id":13016,"word":"士别三日，刮目相待","pinyin":"shì bié sān rì，guā mù xiāng dài","abbr":"sbsrgmxd","explanation":"指别人已有进步，当另眼相看。","source":{"text":"士别三日，即更刮目相待。","book":"晋·陈寿《三国志·吴志·吕蒙传》：“遂拜蒙母，结友而别”南朝·宋·裴松之注"},"similar":["士别三日，刮目相看"],"usage":"作宾语、分句；用于看待别人的成绩","story":["三国时期，东吴能武不能文的武将吕蒙听了孙权的劝告后，发奋读书。一段时间后，都督鲁肃来视察吕蒙的防地。吕蒙就对蜀防备的事情讲得有条有理，还写份建议书给鲁肃，鲁肃很惊讶。吕蒙说道：“士别三日，就要刮目相看。”"]},{"id":13017,"word":"士别三日，当刮目相待","pinyin":"shì bié sān rì，dāng guā mù xiāng dài","abbr":"sbsrdgmxd","explanation":"指别人已有进步，不能再用老眼光去看他。","source":{"text":"士别三日，即更刮目相待。","book":"《三国志·吴志·吕蒙传》注引《江表传》"},"example":{"text":"（蔡元培）对于鲁迅始终是～的。","book":"郭沫若《鲁迅与王国维》"},"similar":["士别三日，当刮目相看"],"usage":"作宾语、定语、分句；用于劝诫人","story":["三国时期，东吴能武不能文的武将吕蒙听了孙权的劝告后，发奋读书。一段时间后，都督鲁肃来视察吕蒙的防地。吕蒙就对蜀防备的事情讲得有条有理，还写份建议书给鲁肃，鲁肃很惊讶。吕蒙说道：“士别三日，就要刮目相看。”"]},{"id":13018,"word":"士可杀不可辱","pinyin":"shì kě shā bù kě rǔ","abbr":"sksbkr","explanation":"指士子宁可死，也不愿受污辱。","source":{"text":"儒有可亲而不可劫也，可近而不可迫也。可杀而不可辱也。","book":"语出《礼记·儒行》"},"example":{"text":"鏊谓谨曰：‘～。今辱且杀之，吾尚何颜居此。’","book":"《明史·王鏊传》"},"similar":["宁死不屈"],"usage":"作宾语、定语、分句；用于处事"},{"id":13019,"word":"士死知己","pinyin":"shì sǐ zhī jǐ","abbr":"sszj","explanation":"为了报答知己，不惜牺牲生命。","source":{"text":"士为知己者死，女为悦己者容，吾其报知氏之仇矣。","book":"《战国策·赵策一》"},"example":{"text":"～，怀此无忘。","book":"三国·魏·曹操《祀故太尉桥玄文》"},"similar":["士为知己者死"],"usage":"作宾语、定语；用于处事"},{"id":13020,"word":"士穷见节","pinyin":"shì qióng jiàn jié","abbr":"sqjj","explanation":"士：读书人；穷：困窘；节：节操。读书人在困境中才能看出节操来。","source":{"text":"呜呼！士穷乃见节义。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"～义，木槁自芬芳。坐回万物春，赖此一点香。","book":"宋·陆游《梅花》诗"}},{"id":13021,"word":"士穷见节义","pinyin":"shì qióng jiàn jié yì","abbr":"sqjjy","explanation":"士：读书人；穷：困窘；节义：节操，气节。读书人在困境中才能看出节操来。","source":{"text":"呜呼！士穷乃见节义。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"～，木槁自芬芳。坐回万物春，赖此一点香。","book":"宋·陆游《梅花》诗"}},{"id":13022,"word":"士绅名流","pinyin":"shì shēn míng liú","abbr":"ssml","explanation":"指有钱有势的人或杰出的人士。","source":{"text":"特别对于中间分子士绅名流，尤为重要，过去我们同志对进步分子都团结不好，对他们更差了。","book":"邓小平《党与抗日民主政权》"},"usage":"作主语、宾语、定语；指名人等"},{"id":13023,"word":"士饱马腾","pinyin":"shì bǎo mǎ téng","abbr":"sbmt","explanation":"军粮充足，士气旺盛。","source":{"text":"士饱而歌，马腾于槽。","book":"唐·韩愈《平淮西碑》"},"example":{"text":"且两年中～，支应不匮，亦有微劳。","book":"清·冯桂芬《与吉抚部书》"},"similar":["士气高昂"],"opposite":["人困马乏"],"usage":"作谓语、定语；指士气旺盛"},{"id":13024,"word":"士马精强","pinyin":"shì mǎ jīng qiáng","abbr":"smjq","explanation":"军粮充足，士气旺盛。","source":{"text":"此四军者，皆声势雄盛，士马精强。","book":"唐·陆贽《论关中事宜状》"},"example":{"text":"但是他心中清楚，李自成～，颇善于收揽民心，这次攻开封可能是想很快就建号称王。","book":"姚雪垠《李自成》第三卷第二十九章"}},{"id":13025,"word":"壮发冲冠","pinyin":"zhuàng fā chōng guàn","abbr":"zfcg","explanation":"形容气概雄伟豪迈。","source":{"text":"公雄心烈眦，壮发冲冠，按东海之金刀，飞北斗之石箭。","book":"唐·杨炯《遂州长江县先圣孔子庙堂碑》"},"usage":"作谓语、定语、状语；用于处事"},{"id":13026,"word":"壮士断腕","pinyin":"zhuàng shì duàn wàn","abbr":"zsdw","explanation":"指勇士手腕被蝮蛇咬伤，就立即截断，以免毒性扩散全身。比喻作事要当机立断，不可迟疑、姑息。","source":{"text":"君子弃瑕以拔才，壮士断腕以全质。","book":"唐·窦皐《述书赋下》"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“有句话叫做‘～’，我只有自己斩掉一条膀子，人虽残废，性命可保。”"},"similar":["壮士解腕"],"usage":"作谓语、宾语、定语；指做事果断"},{"id":13027,"word":"壮士解腕","pinyin":"zhuàng shì jiě wàn","abbr":"zsjw","explanation":"勇士手腕被蝮蛇咬伤，就立即截断，以免毒性扩散全身。比喻作事要当机立断，不可犹豫不决。","source":{"text":"古人有言：‘蝮蛇螫手，壮士解腕。’","book":"晋·陈寿《三国志·魏志·陈泰传》"},"example":{"text":"必要时我们要有～的精神。"},"similar":["当机立断","壮士断腕"],"opposite":["犹豫不决"],"usage":"作谓语、宾语、定语；指做事果断","story":["三国时期，魏国征西大将军陈泰率军进攻蜀国，蜀将姜维率军还击到魏国边境，准备攻占狄道。陈泰与邓艾汇合，邓艾劝陈泰要像壮士断腕那样放弃狄道以求自保。陈泰说服邓艾，毅然率军进入高城岭，奇迹般地给狄道解围"]},{"id":13028,"word":"壮夫不为","pinyin":"zhuàng fū bù wéi","abbr":"zfbw","explanation":"壮夫：成年人；为：做。成年人不做的事。比喻微不足道的小事。","source":{"text":"或问：‘吾子少而好赋？’曰：‘然。童子雕虫篆刻。’俄而曰：‘壮夫不为也。’","book":"汉·扬雄《法言·吾子》"},"example":{"text":"研摩白首，竟不能逮，乃谤言欺人云：“雕虫之技，～。”","book":"明·王士贞《艺苑卮言》卷二"},"usage":"作宾语、定语；用于书面语"},{"id":13029,"word":"壮心不已","pinyin":"zhuàng xīn bù yǐ","abbr":"zxby","explanation":"壮心：宏大的志向；已：停止。指有抱负的人到了晚年，雄心壮志仍不衰减。","source":{"text":"老骥伏枥，志在千里。烈士暮年，壮心不已。","book":"三国·魏·曹操《步出夏门行·龟虽寿》"},"example":{"text":"南朝·宋·刘义庆《世说新语·豪爽》：“老骥伏枥，志在千里。烈士暮年，～。”"},"similar":["老当益壮"],"opposite":["心灰意冷"],"usage":"作谓语、定语、状语；指老年人"},{"id":13030,"word":"壮志凌云","pinyin":"zhuàng zhì líng yún","abbr":"zzly","explanation":"壮志：宏大的志愿；凌云：直上云霄。形容理想宏伟远大。","source":{"text":"往时武帝好神仙，相如上《大人赋》，欲以风，帝反缥缥有凌云之志。","book":"《汉书·扬雄传下》"},"example":{"text":"这号人，在困难中不是低头叹气，而是奋发图强，～，气吞山河。","book":"姚雪垠《李自成》第二卷第二十八章"},"similar":["豪情壮志","意气风发","斗志昂扬"],"opposite":["垂头丧气","暮气沉沉","无所作为"],"usage":"作谓语、定语；指人的理想"},{"id":13031,"word":"壮志未酬","pinyin":"zhuàng zhì wèi chóu","abbr":"zzwc","explanation":"酬：实现。旧指潦倒的一生，志向没有实现就衰老了。也指抱负没有实现就去世了。","source":{"text":"壮志未酬三尺剑，故乡空隔万重山。","book":"唐·李频《春日思归》"},"example":{"text":"这些感情炽烈的诗篇，抒发了作者～的愤懑之情。"},"similar":["功败垂成","功亏一篑","付之东流"],"opposite":["如愿以偿","称心如意","马到成功"],"usage":"作谓语、定语、分句；形容志向没有实现"},{"id":13032,"word":"壮志难酬","pinyin":"zhuàng zhì nán chóu","abbr":"zznc","explanation":"壮志：伟大的志向；酬：实现。伟大的志愿难以实现。","source":{"text":"壮志世难酬，丹桂红蕖又晚秋。","book":"宋·吴潜《南乡子》词"},"example":{"text":"他端的忠直慷慨，～。","book":"元·无名氏《千里独行》第二折"},"usage":"作宾语、定语；用于书面语"},{"id":13033,"word":"壮气凌云","pinyin":"zhuàng qì líng yún","abbr":"zqly","explanation":"豪壮的气概高入云霄。","source":{"text":"杀场临敌处，冲开万马，扫退千军。更忠肝贯日，壮气凌云。","book":"明·施耐庵《水浒传》第第六十一回"},"usage":"作谓语、定语；用于书面语"},{"id":13034,"word":"壮气吞牛","pinyin":"zhuàng qì tūn niú","abbr":"zqtn","explanation":"形容气势雄壮远大。","source":{"text":"男儿汉壮气吞牛，丈夫志岂困荒丘？","book":"明·孙梅锡《琴心记》第二十出"},"usage":"作谓语、定语；用于书面语"},{"id":13035,"word":"声东击西","pinyin":"shēng dōng jī xī","abbr":"sdjx","explanation":"声：声张。指造成要攻打东边的声势，实际上却攻打西边。是使对方产生错觉以出奇制胜的一种战术。","source":{"text":"声言击东，其实击西。","book":"《淮南子·兵略训》：“故用兵之道，示之以柔而迎之以刚，示之以弱而乘之以强，为之以歙而应之以张，将欲西而示之以东，……”唐·杜佑《通典·兵六》说"},"example":{"text":"蜀人或～，指南攻北，吾兵必须分头守把。","book":"明·罗贯中《三国演义》第一百十一回"},"similar":["出其不意","出奇制胜"],"opposite":["无的放矢"],"usage":"作谓语、宾语、定语；用于军事等","story":["楚汉相争时，刘邦派大将韩信去攻打投靠项羽的魏王豹，魏王豹派柏直为大将率军在黄河东岸蒲坂驻守，封锁渡口。韩信发现蒲坂易守难攻，表面装作调兵遣将强行渡河，暗地将主力部队从夏阳渡河直捣安邑，消灭了魏王豹大部分兵力"]},{"id":13036,"word":"声价倍增","pinyin":"shēng jià bèi zēng","abbr":"sjbz","explanation":"指声誉地位成倍增加，迅速提高。","source":{"text":"品题一出，声价倍增，四学士之名等华岳而俱重，六君子之选与日星而并垂。","book":"宋·洪咨夔《诸庄提举启》"},"similar":["声价十倍"],"usage":"作谓语、定语；用于人或物品等"},{"id":13037,"word":"声价十倍","pinyin":"shēng jià shí bèi","abbr":"sjsb","explanation":"声价：声望和社会地位。比喻名誉地位大大增高。","source":{"text":"一登龙门，则声价十倍。","book":"唐·李白《与韩荆州书》"},"example":{"text":"古人说，“一经品题，～”，原是看品题人是甚么？","book":"章炳麟《论教育的根本要从自国自心发出来》"},"similar":["身价百倍","声价百倍","声誉十倍"],"opposite":["名誉扫地"],"usage":"作谓语、定语；指名誉地位"},{"id":13038,"word":"声价百倍","pinyin":"shēng jià bǎi bèi","abbr":"sjbb","explanation":"比喻名誉地位大大增高。同“声价十倍”。","source":{"text":"碑碣铭志之石，非公笔不重，断楮残煤，声价百倍。","book":"清·姜绍书《无声诗史·董其昌》"},"similar":["声价十倍"],"opposite":["名誉扫地"],"usage":"作谓语、定语；指名誉地位"},{"id":13039,"word":"声偶擿裂","pinyin":"shēng ǒu zhé liè","abbr":"sotl","explanation":"偶：成对；擿：选取。形容文章的句子两两并列，声调平仄相对及选用古人的好句子。","source":{"text":"见时学者，务以言语声偶擿裂，号为时文，以相夸尚。","book":"宋·欧阳修《苏氏文集序》"}},{"id":13040,"word":"声入心通","pinyin":"shēng rù xīn tōng","abbr":"srxt","explanation":"指一闻圣人之言，即能领悟其微旨。","source":{"text":"六十尽人物之性，声入心通。","book":"宋·张载《正蒙·三十》"},"example":{"text":"～，无所违逆，知之之至，不思而得也。","book":"《论语·为政》：“六十而耳顺”宋·朱熹集注"},"usage":"作谓语、定语；用于书面语"},{"id":13041,"word":"声出金石","pinyin":"shēng chū jīn shí","abbr":"scjs","explanation":"金石：指古代的打击乐器。好像是从乐器中发出来的声音。形容歌声悦耳动听。","source":{"text":"原宪乃徐步曳杖，歌《商颂》而反，声满于天地，如出金石。","book":"汉·韩婴《韩诗外传》卷一"},"example":{"text":"三乐者，即九月二十一日所记读书～，一乐也；宏奖人才，诱人日进，二乐也；勤劳而后憩息，三乐也。","book":"清·曾国藩《人德八本》"}},{"id":13042,"word":"声动梁尘","pinyin":"shēng dòng liáng chén","abbr":"sdlc","explanation":"形容歌声嘹亮动人。","source":{"text":"汉兴，鲁人虞公善雅乐，发声尽动梁上尘。","book":"汉·刘向《别录》"},"example":{"text":"此刻，我才真正体味到歌唱家那黄莺出谷、～的神韵。","book":"李存葆《祖槐》三"},"usage":"作谓语、定语；用于比喻句"},{"id":13043,"word":"声势显赫","pinyin":"shēng shì xiǎn hè","abbr":"ssxh","explanation":"显赫：指权势很盛。形容名声很大，气势逼人。","example":{"text":"全治第如王府，门前署着开化府三字，～，且屡嗾俺答入寇，于中取利。","book":"蔡东藩《明史演义》第七十一回"}},{"id":13044,"word":"声势汹汹","pinyin":"shēng shì xiōng xiōng","abbr":"ssxx","explanation":"形容气势盛大的样子。多含贬义。","source":{"text":"次日，果有狐兵大至；或骑或步，或弓或弩，马嘶人沸，声势汹汹。","book":"清·蒲松龄《聊斋志异·胡氏》"},"example":{"text":"文盲们不大懂得他的议论，但看见～，知道一定是反对的意思，也只好作罢了。","book":"鲁迅《故事新编·采薇》"},"similar":["其势汹汹","来势汹汹","气势汹汹"],"usage":"作谓语、定语、状语；用于人"},{"id":13045,"word":"声势浩大","pinyin":"shēng shì hào dà","abbr":"sshd","explanation":"声势：声威和气势；浩：广大。声威和气势非常壮大。","source":{"text":"其实他们空着没有一点事，也不见得怎么为患地方，不过声势浩大罢了。","book":"清·吴趼人《二十年目睹之怪现状》第十六回"},"example":{"text":"～的游行队伍，迈着整齐的步伐向主席台走来。"},"similar":["大张旗鼓","气壮山河"],"opposite":["无声无息","偃旗息鼓"],"usage":"作谓语、定语；指气势宏大"},{"id":13046,"word":"声势烜赫","pinyin":"shēng shì xuǎn hè","abbr":"ssxh","explanation":"形容气势盛大的样子。","source":{"text":"有文觉禅师者出都，声势烜赫，骑从如云，道出袁浦，兖豫二州方面大僚率属郊迎恐后。","book":"清·陈康祺《燕下乡脞录》卷一"},"example":{"text":"海军统领萨镇冰展舲西指，～。","book":"李一《〈荆宜施鹤光复记〉序》"},"similar":["声势赫奕"],"usage":"作谓语、定语；用于书面语"},{"id":13047,"word":"声势熏灼","pinyin":"shēng shì xūn zhuó","abbr":"ssxz","explanation":"指声势气势逼人。","source":{"text":"仁宗亲政，和坤下狱赐死，谕云‘当和珅声势熏灼，举朝无一人敢于纠劾，曹锡宝独能抗辞执奏，不愧诤臣，加恩追赠副都御史，伊子照加赠官衔，给予荫生。’","book":"清·陈康祺《郎潜纪闻》卷四"},"usage":"作谓语、定语；用于书面语","story":["清朝乾隆时期，何珅势力强大，他贪污受贿，收受的钱财足以给清廷开支十年。仁宗亲政后，将何珅下狱赐死，没收其家产，发布告：“当何珅声势熏灼，举朝无一人敢于纠劾，曹锡宝独能抗辞执奏，不愧诤臣，加恩追赠副都御史，伊子照加赠官衔。”"]},{"id":13048,"word":"声势赫奕","pinyin":"shēng shì hè yì","abbr":"sshy","explanation":"声威气势盛大显赫。","source":{"text":"许氏三兄弟，都做了大官，虽然他不以富贵骄人，自然声势赫奕。","book":"《醒世恒言·三孝廉让产立高名》"},"example":{"text":"因为是早已营就三窟，又善于钻谋的，所以不多时，也就依然～，作恶又如先前一样。","book":"鲁迅《坟·论“费厄泼赖”应该缓行》"},"similar":["声势烜赫"],"usage":"作谓语、定语；用于书面语"},{"id":13049,"word":"声华行实","pinyin":"shēng huá xíng shí","abbr":"shxs","explanation":"垢：声誉；华：显耀；行：品行；实：朴实。形容声望很高，品行朴实。","source":{"text":"声华行实，光映儒林。","book":"唐·韩愈《举荐张籍状》"},"usage":"作宾语、定语；用于为人等"},{"id":13050,"word":"声名大噪","pinyin":"shēng míng dà zào","abbr":"smdz","explanation":"由于名声高而引起人们的极大关注。","example":{"text":"由于“非典”的流行，板兰根一时～。"},"similar":["名噪一时"],"opposite":["默默无闻"],"usage":"作谓语；指人的名声"},{"id":13051,"word":"声名烜赫","pinyin":"shēng míng xuǎn hè","abbr":"smxh","explanation":"指名声显赫。","source":{"text":"声名烜赫文章士，金紫雍容富贵身。","book":"唐·韩偓《与吴子华侍郎同年玉堂同直怀恩叙恳因成长句四韵兼呈诸同年》"},"example":{"text":"某伏观自唐至于本朝，贤者在下位，天下想望倾属，期至公相，～，未有如阁下者。","book":"宋·苏舜钦《上范公参政书》"},"similar":["声名煊赫","声名赫奕"],"usage":"作谓语、定语；用于书面语"},{"id":13052,"word":"声名狼籍","pinyin":"shēng míng láng jí","abbr":"smlj","explanation":"形容名望声誉败坏到了极点，不可收拾","source":{"text":"邑之仕宦眷属，闻之成不平，声名狼籍。","book":"清·宣鼎《夜雨秋灯录·珊珊》"},"similar":["声名狼藉"],"usage":"作谓语、定语、宾语、状语；指人的声誉"},{"id":13053,"word":"声名狼藉","pinyin":"shēng míng láng jí","abbr":"smlj","explanation":"声名：名誉；狼藉：杂乱不堪。名声败坏到了极点。","source":{"text":"言其恶声狼藉，布于诸国。","book":"《史记·蒙恬列传》"},"example":{"text":"因汪太史平日～，最不见重于官场，日前新督帅参劾劣绅十七名，实以汪某居首。","book":"清·黄小配《廿载繁华梦》第三十三回"},"similar":["名誉扫地","臭名昭著","身败名裂"],"opposite":["流芳百世","名闻遐迩"],"usage":"作谓语、定语、宾语、状语；指人的声誉","story":["秦始皇死后，中东府令赵高与宰相李斯合谋篡改遗嘱，立胡亥为帝，赐死扶苏，赵高逼大将蒙恬自杀，同时令其兄弟蒙毅自尽。蒙毅说：“从前秦穆公杀死奄息等，秦昭襄王杀白起，楚平王杀武奢，夫差杀伍子胥，他们在诸侯中声名狼藉。”"]},{"id":13054,"word":"声名籍甚","pinyin":"shēng míng jí shèn","abbr":"smjs","explanation":"籍甚：盛大。形容声望很高，声誉显赫。","source":{"text":"公禀山岳之灵，擅风云之气，容止矜庄，声名籍甚。","book":"北周·庾信《周车骑大将军赠小司空宇文显墓志铭》"}},{"id":13055,"word":"声名藉甚","pinyin":"shēng míng jí shèn","abbr":"smjs","explanation":"名声显赫。指人在社会上流传的评价极高。","source":{"text":"公禀山岳之灵，擅风云之气，容止矜庄，声名藉甚。","book":"北周·庚信《周车骑大将军赠小司空宇文显和墓志铭》"},"example":{"text":"李延庚，字少白，西蜀人。工诗词，为人颇具豪气。少好击剑，及长，以为不足学，遂专心于文史，～。","book":"清·王韬《淞滨琐话·李延庚》"},"similar":["声名赫奕","赫赫有名"],"usage":"作谓语、定语；用于书面语"},{"id":13056,"word":"声名赫奕","pinyin":"shēng míng hè yì","abbr":"smhy","explanation":"指名声显赫。","source":{"text":"声名赫奕动天子，家世富贵连椒房。","book":"宋·陆游《送襄阳郑帅唐老》诗"},"example":{"text":"～，昭灼当世；旷视宇宙，奚古奚今。","book":"明·方孝孺《祭胡仲申先生》"},"similar":["赫赫有名","声名藉甚"],"usage":"作谓语、定语；用于书面语"},{"id":13057,"word":"声名鹊起","pinyin":"shēng míng què qǐ","abbr":"smqq","explanation":"形容知名度迅速提高。","source":{"text":"[朱文元]先在徐班，以年未五十，故无所表见，至洪班则声名鹊起，班中人称为戏忠臣。","book":"清·李斗《扬州画舫录·新城北录下》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“鹤龄兄春风得意，～，贺客必多，都归我招呼。”"},"usage":"作谓语、定语；用于书面语"},{"id":13058,"word":"声吞气忍","pinyin":"shēng tūn qì rěn","abbr":"stqr","explanation":"吞：咽下。形容受了气勉强忍耐，不敢出声抗争。","source":{"text":"夫人，非是我声吞气忍，只为你爹行势逼临，怕他知我要归去，将人厮禁。","book":"明·高明《琵琶记·瞷询衷情》"},"similar":["忍气吞声"],"opposite":["忍无可忍"],"usage":"作宾语、定语、状语；指不敢出声抗争"},{"id":13059,"word":"声嘶力竭","pinyin":"shēng sī lì jié","abbr":"sslj","explanation":"嘶：哑；竭：尽。嗓子喊哑，气力用尽。形容竭力呼喊。","source":{"text":"北山大哭，哭得声哑力竭，倒是嫂嫂劝住了。","book":"《晚清文学钞·轰天雷》"},"example":{"text":"因为气愤，话虽然说的不很多，可是有点～的样子。","book":"老舍《四世同堂》"},"similar":["大喊大叫","大声疾呼"],"opposite":["默默无言","心平气和"],"usage":"作谓语、定语、状语、补语；指竭力呼喊"},{"id":13060,"word":"声如洪钟","pinyin":"shēng rú hóng zhōng","abbr":"srhz","explanation":"洪：大。形容说话或歌唱的声音洪亮，如同敲击大钟似的。","source":{"text":"忆胥目如闪电，声如洪钟。","book":"明·冯梦龙《东周列国志》第七十二回"},"example":{"text":"明·冯梦龙《东周列国志》第72回：“忆胥目如闪电，～。”"},"similar":["音声如钟"],"usage":"作谓语、定语；用于人说话等"},{"id":13061,"word":"声威大震","pinyin":"shēng wēi dà zhèn","abbr":"swdz","explanation":"声势和威望急速增长，使人非常震动。","source":{"text":"将军功绩已成，声威大震。","book":"明·罗贯中《三国演义》第一百一十回"},"example":{"text":"我西北人民解放军在此次向南进攻中，旗开得胜，～，改变了西北敌我对比的形势。","book":"毛泽东《评西北人民解放军的新式整军运动》"},"similar":["声震天下","名闻遐迩"],"opposite":["默默无闻"],"usage":"作谓语；指人的名望大增"},{"id":13062,"word":"声威天下","pinyin":"shēng wēi tiān xià","abbr":"swtx","explanation":"声威：声势。声势震动全世界。","source":{"text":"我田忌之人也，吾三战而三胜，声威天下，欲为大事，亦吉否？","book":"《战国策·齐策一》"}},{"id":13063,"word":"声希味淡","pinyin":"shēng xī wèi dàn","abbr":"sxwd","explanation":"指平淡无奇，没有什么名声。有曲高和寡，不为人知之意。","source":{"text":"人间声希味淡半世间，分明唤我返白雪。","book":"清·蒋士铨《空谷香·哄笺》"},"example":{"text":"此十一年间，表面上之克林威尔，其～也若此，而后此轰天裂地之克林威尔又何以称焉。","book":"梁启超《新英国巨人克林威尔传》"},"usage":"作宾语、定语；用于书面语"},{"id":13064,"word":"声应气求","pinyin":"shēng yìng qì qiú","abbr":"syqq","explanation":"应：应和，共鸣；求：寻找。同类的事物相互感应。比喻志趣相投的人自然地结合在一起。","source":{"text":"同声相应，同气相求；水流湿，火就燥；云从龙，风从虎，圣人出而万物睹。","book":"《周易·乾》"},"example":{"text":"朋来四方，～，达之至也。","book":"明·李贽《富莫富于常知足》"},"similar":["意气相投","情投意合","声求气应"],"usage":"作谓语、定语；指彼此投合"},{"id":13065,"word":"声张势厉","pinyin":"shēng zhāng shì lì","abbr":"szsl","explanation":"指声威气势盛大显赫。","source":{"text":"是时和珅柄国，声张势厉，家奴乘高车横行都市无所惮。","book":"清·曾国藩《送谢吉人之官江左序》"},"usage":"作谓语、定语；用于书面语"},{"id":13066,"word":"声情并茂","pinyin":"shēng qíng bìng mào","abbr":"sqbm","explanation":"并：都；茂：草木丰盛的样子，引申为美好。指演唱的音色、唱腔和表达的感情都很动人。","source":{"text":"余于王氏水阁听演《寻亲记·跌包》一出，声情并茂，不亚梨园能手。","book":"清·珠泉居士《续板桥杂记·张玉秀》"},"example":{"text":"她的演唱～，极富艺术感染力。"},"opposite":["枯燥乏味"],"usage":"作谓语、定语；指有声作品等"},{"id":13067,"word":"声振寰宇","pinyin":"shēng zhèn huán yǔ","abbr":"szhy","explanation":"寰宇：天下。形容声威极盛。","source":{"text":"介胄仁义，折冲尊俎，声振寰宇，泽流遐裔。","book":"《南史·梁本纪论》"},"similar":["威震天下"],"opposite":["默默无闻"],"usage":"作谓语；指人的声威"},{"id":13068,"word":"声振屋瓦","pinyin":"shēng zhèn wū wǎ","abbr":"szww","explanation":"声音把房子上的瓦都振动了。形容呼喊的声音很宏大猛烈。","source":{"text":"秦军军武安西，秦军鼓譟勒兵，武安屋瓦尽振。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"先生尺布裹头，伏地而号，官吏士民和者数万，～。","book":"清·黄宗羲《子刘子行状下》"}},{"id":13069,"word":"声振林木","pinyin":"shēng zhèn lín mù","abbr":"szlm","explanation":"声：歌声。歌声振动了林木。形容歌声或乐器声高亢宏亮。","source":{"text":"抚节悲歌，声振林木，响遏行云。","book":"《列子·汤问》"},"example":{"text":"荆元慢慢的和了弦，弹起来，铿铿锵锵，～。","book":"清·吴敬梓《儒林外史》第五十五回"},"similar":["响遏行云"],"opposite":["鸦雀无声"],"usage":"作谓语、宾语；形容歌声或乐器声高亢","story":["战国时期秦国歌手薛潭向歌唱家秦青拜师学艺，经过一段时间的刻苦学习。薛潭的技艺有了很大的提高，就向老师辞行。秦青在郊外设宴送行，席间唱了一曲十分悲壮的歌曲，声振林木，响遏行云，薛潭觉得十分惭愧，于是留下继续学习"]},{"id":13070,"word":"声气相投","pinyin":"shēng qì xiāng tóu","abbr":"sqxt","explanation":"指朋友间思想一致，性情投合。","source":{"text":"这相知有几样名色：恩德相结者，谓之知己；腹心相照者，谓之知心；声气相求者，谓知知音。","book":"明·冯梦龙《警世通言》卷一"},"example":{"text":"兄今因许公而识张公，自然～，定行见用于世，各著功名，可胜欣贺。（清·禇人获《隋唐演义》第八十九回）"},"similar":["声气相通"],"usage":"作谓语、定语；指志同道合"},{"id":13071,"word":"声气相求","pinyin":"shēng qì xiāng qiú","abbr":"sqxq","explanation":"指志同道合，意气相投。","source":{"text":"腹心相照者，谓之知心；声气相求者，谓之知音。","book":"明·冯梦龙《警世通言·俞伯牙摔琴谢知音》"},"similar":["声气相投","意气相投"],"usage":"作谓语、定语；指志同道合"},{"id":13072,"word":"声气相通","pinyin":"shēng qì xiāng tōng","abbr":"sqxt","explanation":"彼此串通，互通消息。","source":{"text":"这相知有几样名色：恩德相结者，谓之知己；腹心相照者，谓之知心；声气相求者，谓知知音。","book":"明·冯梦龙《警世通言》卷一"}},{"id":13073,"word":"声求气应","pinyin":"shēng qiú qì yìng","abbr":"sqqy","explanation":"应：应和，共鸣；求：寻找。同类的事物相互感应。比喻志趣相投的人自然地结合在一起。","source":{"text":"同声相应，同气相求；水流湿，火就燥；云从龙，风从虎，圣人出而万物睹。","book":"《周易·乾》"},"example":{"text":"～，何以教我。","book":"宋·陈亮《送叔祖筠州高安簿序》"},"similar":["声应气求"],"usage":"作谓语、定语；指彼此投合"},{"id":13074,"word":"声泪俱下","pinyin":"shēng lèi jù xià","abbr":"sljx","explanation":"一边说一边哭。形容极其悲恸。","source":{"text":"因勃然数敦曰：‘兄抗旌犯顺，杀戮忠良，谋图不轨，祸及门户。’音辞慷慨，声泪俱下。","book":"《晋书·王彬传》"},"example":{"text":"他讲到激昂时，～。","book":"邹韬奋《经历·高等法院》"},"similar":["痛哭流涕","声泪俱发"],"opposite":["笑容可掬","兴高采烈"],"usage":"作谓语、状语、定语；指十分哀伤"},{"id":13075,"word":"声泪俱发","pinyin":"shēng lèi jù fā","abbr":"sljf","explanation":"形容极其悲恸。同“声泪俱下”。","source":{"text":"每一言一誓，声泪俱发。","book":"唐·裴度《唐故太尉兼中书令西平郡王赠太师李公神道碑铭》"},"similar":["声泪俱下"],"opposite":["兴高采烈"],"usage":"作谓语、状语、定语；指十分哀伤"},{"id":13076,"word":"声生势长","pinyin":"shēng shēng shì zhǎng","abbr":"sssz","explanation":"名声越高，势力越大。","source":{"text":"法成令修，治出张施，声生势长。","book":"唐·韩愈《曹成王碑》"},"usage":"作宾语、定语；用于书面语"},{"id":13077,"word":"声罪致讨","pinyin":"shēng zuì zhì tǎo","abbr":"szzt","explanation":"宣布罪状，并加讨伐。","source":{"text":"是故伐备钟鼓，声其罪也。","book":"春秋·鲁·左丘明《国语·晋语五》"},"example":{"text":"驰檄各郡，～，然后名正言顺。","book":"明·罗贯中《三国演义》第22回"},"usage":"作谓语；指宣布罪状，并加讨伐"},{"id":13078,"word":"声色不动","pinyin":"shēng sè bù dòng","abbr":"ssbd","explanation":"指不动声色。形容态度从容镇静，不随意流露感情。","source":{"text":"众人道是一番天样大、火样急的事，怎知襄敏公看得等闲，声色不动，化做一杯雪水。","book":"《二刻拍案惊奇》卷五"},"example":{"text":"小弟是个腐儒，见了他～，他不笑我也就好了，怎么还肯属意？","book":"清·李渔《慎鸾交·目许》"},"similar":["不动声色"],"opposite":["喜形于色"],"usage":"作谓语、定语、状语；用于紧急情况下"},{"id":13079,"word":"声色俱厉","pinyin":"shēng sè jù lì","abbr":"ssjl","explanation":"声色：说话时的声音和脸色；厉：严厉。说话时声音和脸色都很严厉。","source":{"text":"（王）敦素以帝神武明略，大会百官而问温峤日：‘皇太子何以德称？’声色俱厉，必欲使有言。","book":"《晋书·明帝纪》"},"example":{"text":"达夫更决绝地说了一句，“不停办我是不寄稿的！”说得有点～的程度。","book":"郭沫若《革命春秋·创造十年》"},"similar":["疾言厉色","正言厉色","正颜厉色"],"opposite":["和颜悦色"],"usage":"作谓语、定语、状语；用于说话的语气","story":["唐朝翰林学士韦绶的儿子韦温在父亲死后出来做官，但他始终牢记父亲的遗训不能当翰林学士。唐文宗非常赏识韦温的才干，决定任命他为翰林学士，但韦温拒不接受。唐文宗声色俱厉去问他为什么，他只好承认是父命难违"]},{"id":13080,"word":"声色并厉","pinyin":"shēng sè bìng lì","abbr":"ssbl","explanation":"说话时声音和脸色都很严厉。同“声色俱厉”。","source":{"text":"敦声色并厉，欲以威力使从己。","book":"南朝·宋·刘义庆《世说新语·方正》"},"similar":["声色俱厉"],"opposite":["和颜悦色"],"usage":"作谓语、定语、状语；用于说话的语气"},{"id":13081,"word":"声色犬马","pinyin":"shēng sè quǎn mǎ","abbr":"ssqm","explanation":"声：歌舞；色：女色；犬：养狗；马：骑马。形容剥削阶级荒淫无耻的生活方式。","source":{"text":"小人先之，悦之以声色犬马，纵之以驰骋田猎，侈之以宫室器服，志气已乱。","book":"宋·苏辙《历代论·汉昭帝》"},"example":{"text":"可知那～，奇技淫物，适足以起大盗觊觎之心。","book":"清·褚人获《隋唐演义》第九十三回"},"similar":["声色狗马","身败名裂"],"opposite":["名垂青史","流芳百世"],"usage":"作主语、宾语、定语；指无聊的生活方式","story":["隋炀帝的长子杨昭死后，次子杨湅就成为理所当然的太子，他远不及兄长那样有修养，他平时骄纵恣肆，行为不端，经常沉湎于声色犬马之中，同时好女色，同达奚通的小妾王氏勾搭成奸，又霸占妻子的姐姐元氏，真是无恶不作"]},{"id":13082,"word":"声色狗马","pinyin":"shēng sè gǒu mǎ","abbr":"ssgm","explanation":"声：歌舞；色：女色；狗：养狗；马：骑马。形容剥削阶级荒淫无耻的生活。","source":{"text":"声色狗马，昼夜荒淫，国计民生，罔存念虑。","book":"清·蒲松龄《聊斋志异·续黄梁》"},"example":{"text":"于是童贯朱勔辈复导以～宫室苑囿之乐。","book":"鲁迅《唐宋传奇集·李师师外传》"},"similar":["身败名裂","威信扫地"],"opposite":["名垂青史","流芳百世"],"usage":"作主语、宾语、定语；指低级生活方式"},{"id":13083,"word":"声色货利","pinyin":"shēng sè huò lì","abbr":"sshl","explanation":"货：指钱财；利：指私利。贪恋歌舞、女色、钱财、私利。泛指寻欢作乐和要钱等行径。","source":{"text":"惟王不迩声色，不殖货利。","book":"《书·仲虺之诰》"},"example":{"text":"长官有所不知，那“宝玉”原是灵的，只因为～所迷，故此不灵了。","book":"清·曹雪芹《红楼梦》第二十五回"},"similar":["酒色财气"],"usage":"作主语、宾语、定语；指物质享受"},{"id":13084,"word":"声誉十倍","pinyin":"shēng yù shí bèi","abbr":"sysb","explanation":"比喻名誉地位大大增高。同“声价十倍”。","source":{"text":"岂不以有周公之风，躬吐握之事，使海内豪俊，奔走而归之一，一登龙门，则声誉十倍。","book":"唐·李白《与韩荆州书》"},"similar":["声价十倍"],"opposite":["名誉扫地"],"usage":"作谓语、定语；指名誉地位"},{"id":13085,"word":"声誉大振","pinyin":"shēng yù dà zhèn","abbr":"sydz","explanation":"声望、名誉大大提高。","example":{"text":"经过这件事情，他～。"},"similar":["声威大振","声誉鹊起"],"opposite":["声誉扫地"],"usage":"作谓语；指声望、名誉"},{"id":13086,"word":"声誉鹊起","pinyin":"shēng yù què qǐ","abbr":"syqq","explanation":"比喻声名迅速增高。","source":{"text":"至洪班则声名鹊起。","book":"清·李斗《扬州画舫录·新城北录下》"},"similar":["声名鹊起","声誉大振"],"opposite":["声誉扫地"],"usage":"作谓语、定语；指声望、名誉"},{"id":13087,"word":"声销迹灭","pinyin":"shēng xiāo jì miè","abbr":"sxjm","explanation":"犹销声匿迹。指隐藏形迹。","source":{"text":"其舒也济世成务，其卷也声销迹灭。","book":"《北齐书·魏收传》"},"similar":["销声匿迹","消声灭迹"],"usage":"作谓语、定语；用于处事"},{"id":13088,"word":"声闻九皋","pinyin":"shēng wén jiǔ gāo","abbr":"swjg","explanation":"九皋：深泽。比喻负有盛名，为世人所称誉。","source":{"text":"敬想足下声闻九皋，诗成七步，涵蚌胎于学海，卓尔超群。","book":"南朝·梁·萧统《锦带书十二月启·中吕四月》"}},{"id":13089,"word":"声闻过实","pinyin":"shēng wén guò shí","abbr":"swgs","explanation":"声闻：声望，名声；过：超过；实：实际。名声超过实际情况。指名不副实。","source":{"text":"苟为无本，七八月之间雨集，沟浍皆盈，其涸也，可立而待也，故声闻过情，君子耻之。","book":"《孟子·离娄下》"},"example":{"text":"老夫自笑，正所谓～，君子耻之，皆赖圣人在位，天下太平，颇奈北番虏寇无礼，侵犯边境。","book":"元·无名氏《射柳蕤丸》第一折"},"similar":["声闻过情","名不副实","名实难副"],"opposite":["名副其实"],"usage":"作谓语、定语；指名声超过实际"},{"id":13090,"word":"声闻过情","pinyin":"shēng wén guò qíng","abbr":"swgq","explanation":"名声超过实际。","source":{"text":"故声闻过情，君子耻之。","book":"战国·邹·孟轲《孟子·离娄下》"},"example":{"text":"自顾鄙薄，～，蹶气震怖。","book":"清·钱谦益《答山阴徐伯调书》"},"similar":["名不副实","声闻过实"],"opposite":["名副其实"],"usage":"作谓语、定语；指名声超过实际"},{"id":13091,"word":"声音笑貌","pinyin":"shēng yīn xiào mào","abbr":"syxm","explanation":"指人的言谈、表情等。","source":{"text":"恭俭岂可以声音笑貌为哉。","book":"《孟子·离娄上》"},"example":{"text":"局中诸公，性情心术，～，一一如绘。","book":"清·平步清《霞外捃屑》卷四"},"similar":["音容笑貌"],"usage":"作主语、宾语、定语；指人的言谈、表情等"},{"id":13092,"word":"声驰千里","pinyin":"shēng chí qiān lǐ","abbr":"scql","explanation":"驰：传扬。名声远播。形容声望很高。","source":{"text":"段干木贤者也，不趋势力，怀君子之道，隐处穷巷，声驰千里。","book":"晋·皇甫谧《高士传》"},"usage":"作谓语、定语；指名声很大"},{"id":13093,"word":"壶中天地","pinyin":"hú zhōng tiān dì","abbr":"hztd","explanation":"旧指道家悠闲清静的无为生活。","source":{"text":"壶中日月存心近，岛外烟霞入梦清。","book":"唐·李白《下途归石门旧居》：“何当脱屣谢时去，壶中别有日月天。”唐·李中《赠重安寂道者》"},"example":{"text":"～，目前今古，今日还明日。","book":"元·刘秉忠《永遇乐》词"},"similar":["壶中日月","壶里乾坤"],"usage":"作宾语、定语；指道家生活","story":["成都附近的云台山因为道教正一天师张道陵在此修行而出名，张天师命弟子张申为云台道观主持。张申就是神仙壶公，他有一把酒壶，只要念动咒语，壶中会展现日月星辰，蓝天大地，亭台楼阁等奇景，更令人惊奇的是他晚上钻进壶中睡觉"]},{"id":13094,"word":"壶中日月","pinyin":"hú zhōng rì yuè","abbr":"hzry","explanation":"旧指道家悠闲清静的无为生活。","source":{"text":"壶中日月存心近，岛外烟霞入梦清。","book":"唐·李白《下途归石门旧居》：“何当脱屣谢时去，壶中别有日月天。”唐·李中《赠重安寂道者》"},"example":{"text":"～存心近，岛外烟霞入梦清。","book":"唐·李中《赠重安寂道者》诗"},"similar":["壶天日月","壶里乾坤"],"usage":"作主语、宾语；指道家的神仙生活","story":["成都附近的云台山因为道教正一天师张道陵在此修行而出名，张天师命弟子张申为云台道观主持。张申就是神仙壶公，他有一把酒壶，只要念动咒语，壶中会展现日月星辰，蓝天大地，亭台楼阁等奇景，更令人惊奇的是他晚上钻进壶中睡觉"]},{"id":13095,"word":"壶天日月","pinyin":"hú tiān rì yuè","abbr":"htry","explanation":"指道家的神仙生活。同“壶中日月”。","source":{"text":"返照壶天日月，休言尘世风波。","book":"金·长筌子《西江月》词"},"example":{"text":"一场恶梦风吹觉，依旧～高。","book":"元·张养浩《中吕·喜春来》"},"similar":["壶里乾坤","壶中日月","壶中天地"],"usage":"作主语、宾语；指道家的神仙生活"},{"id":13096,"word":"壶浆塞道","pinyin":"hú jiāng sāi dào","abbr":"hjsd","explanation":"壶浆：以壶盛着酒浆；塞道：挤满道路。形容群众欢迎自己所拥护的军队的场面。","source":{"text":"襄城民庶等喜复见翼，并壶浆塞道。","book":"《周书·于翼传》"},"similar":["壶浆箪食"],"usage":"作宾语、定语；指军民关系","story":["战国时期燕国相国子之暴政，大将子被、太子平率兵讨伐，国内大乱。齐宣王趁机出兵攻打燕国并控制大部分领土，燕国老百姓用箪送吃的，用壶装喝的欢迎齐军，齐宣王想侵吞了燕国咨询孟子，孟子说：“你会让他们生活在水深火热中的。"]},{"id":13097,"word":"壶浆箪食","pinyin":"hú jiāng dān shí","abbr":"hjds","explanation":"浆：汤；箪：古代盛饭的圆形竹器；食：食物。用箪盛饭，用壶盛汤，犒劳军队。形容百姓欢迎军队。","source":{"text":"予方为旅人，不得亲执壶浆箪食，以与侯劝逆四方之来者。","book":"宋·苏轼《新渠诗》序"},"example":{"text":"军队所过地方，真能秋毫无犯，则民必争先恐后～以迎之。","book":"孙中山《军人精神教育》"},"similar":["箪食壶浆"],"usage":"作宾语、状语；常与“迎接”连用"},{"id":13098,"word":"壶里乾坤","pinyin":"hú lǐ qián kūn","abbr":"hlqk","explanation":"旧指道家悠闲清静的无为生活。","source":{"text":"壶中日月存心近，岛外烟霞入梦清。","book":"唐·李白《下途归石门旧居》：“何当脱屣谢时去，壶中别有日月天。”唐·李中《赠重安寂道者》"},"example":{"text":"罗浮道士谁同流，草衣木食轻诸侯。世间甲子管不得，～只自由。","book":"明·朱有燉《神仙会》第一折"},"similar":["壶天日月","壶中日月","壶中天地"],"usage":"作主语、宾语；指道家的神仙生活"},{"id":13099,"word":"壸浆箪食","pinyin":"kǔn jiāng dān shí","abbr":"kjds","explanation":"原指竹篮中盛着饭食，壶中盛着酒浆茶水，以欢迎王者的军队。后多用指百姓欢迎、慰劳自己所拥护的军队。","source":{"text":"箪食壸浆，以迎王师。","book":"语出《孟子·梁惠王下》"}},{"id":13100,"word":"壹倡三叹","pinyin":"yī chàng sān tàn","abbr":"ycst","explanation":"指一人歌唱，三人应和。","source":{"text":"《清庙》之瑟，朱弦而疏越，壹倡而三叹，有遗音者矣。","book":"《礼记·乐记》"},"similar":["一倡三叹"],"usage":"作谓语、宾语、分句；用于书面语"},{"id":13101,"word":"壹败涂地","pinyin":"yī bài tú dì","abbr":"ybtd","explanation":"指彻底失败，不可收拾。","source":{"text":"天下方扰，诸侯并起，今置将不善，壹败涂地。","book":"《史记·高祖本纪》"},"example":{"text":"［越孝成王］置将不善，～。惜哉！","book":"清·周树槐《赵孝成王论》"},"similar":["一败涂地"],"usage":"作谓语、定语、状语；指彻底失败"},{"id":13102,"word":"处之夷然","pinyin":"chǔ zhī yí rán","abbr":"czyr","explanation":"形容对待困难或紧急情况沉着镇定的样子。同“处之泰然”。","source":{"text":"承［王承］每遇艰险，处之夷然。","book":"《晋书·王承传》"},"similar":["处之泰然","处之怡然"],"usage":"作谓语、宾语；用于处事"},{"id":13103,"word":"处之怡然","pinyin":"chǔ zhī yí rán","abbr":"czyr","explanation":"形容对待困难或紧急情况沉着镇定的样子。同“处之泰然”。","source":{"text":"至日，乃往荆州门下书佐家，处之怡然。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"similar":["处之泰然","处之夷然"],"usage":"作谓语、宾语；用于处事"},{"id":13104,"word":"处之晏然","pinyin":"chǔ zhī yàn rán","abbr":"czyr","explanation":"形容对待困难或紧急情况沉着镇定的样子。亦指对某件事情毫不关心。同“处之泰然”。","source":{"text":"事虽交至错出，处之晏然。","book":"宋·秦观《圆通禅师行状》"},"example":{"text":"面对困难他依然～。"},"similar":["处之泰然"],"usage":"作谓语、宾语；用于处事"},{"id":13105,"word":"处之泰然","pinyin":"chǔ zhī tài rán","abbr":"cztr","explanation":"处：处理，对待；泰然：安然，不以为意的样子。若无其事的样子。形容自理事情沉着镇定。也指对待问题毫不在意。","source":{"text":"爰初发迹，遘此颠沛，神情玄定，处之弥泰。","book":"晋·袁宏《三国名臣序赞》"},"example":{"text":"大赤包听出瑞宣的讽刺，而～，她尖声的咯咯的笑了。","book":"老舍《四世同堂》四十八"},"similar":["泰然自若","从容不迫","无动于衷"],"opposite":["惊惶失措","惊慌失措","六神无主"],"usage":"作谓语、宾语；用于处事","story":["春秋时期，孔子在他的学生中最喜欢颜回，他十分尊敬孔子。孔子指出缺点马上就改正，孔子问他为什么不去谋个一官半职。颜回说只要学到老师的道德学问何必去做官。孔子赞叹颜回吃的是一竹筐饭，喝的是一瓢水，处之泰然，自得其乐"]},{"id":13106,"word":"处之绰然","pinyin":"chǔ zhī chuò rán","abbr":"czcr","explanation":"指处于险促的境地而显得宽绰坦然。","source":{"text":"人皆病于拘碍，而先生处之绰然。","book":"宋·程颐《明道先生行状》"},"similar":["处之泰然"],"usage":"作谓语、宾语；用于处事"},{"id":13107,"word":"处堂燕雀","pinyin":"chǔ táng yàn què","abbr":"ctyq","explanation":"比喻生活安定而失去警惕性。也比喻大祸临头而自己不知道。","source":{"text":"燕雀处一屋之下，子母相哺，煦煦然其相乐也，自以为安矣。灶突决，火上，栋宇将焚，燕雀颜色不变，不知祸之将及也。","book":"战国·卫·吕不韦《吕氏春秋》"},"example":{"text":"起陆龙蛇终有日，～欲何为？","book":"柳亚子《寄少华甬上四首即效其体》"},"similar":["处堂燕鹊"],"usage":"作主语、宾语；比喻居安忘危的人","story":["战国后期，秦国攻打赵国，赵国的近邻魏国却见死不救，认为这对魏国有利，魏国相国子顺可不这样认为。他认为秦国势力强大，侵略成性，魏国不能像房梁下的燕雀那样过着安逸的生活，因为房屋发生了火灾，燕雀就没有栖身之处了"]},{"id":13108,"word":"处堂燕鹊","pinyin":"chǔ táng yàn què","abbr":"ctyq","explanation":"比喻居安忘危的人。","source":{"text":"燕雀处一屋之下，子母相哺，煦煦然其相乐也，自以为安矣。灶突决，火上，栋宇将焚，燕雀颜色不变，不知祸将及也。","book":"战国·吕不韦《吕氏春秋》"},"example":{"text":"驯致夷狄处上，中原处下，一时君相犹然～，纳币称臣。","book":"明·李贽《序》"},"similar":["处堂燕雀"],"usage":"作主语、宾语；比喻居安忘危的人"},{"id":13109,"word":"处士横议","pinyin":"chǔ shì héng yì","abbr":"cshy","explanation":"处士：古称有才德而隐居不仕的人，这里指没有做官的读书人；横议：放肆地进行议论。没有做官的读书人纵论时政。","source":{"text":"圣王不作，诸侯放恣，处士横议。","book":"《孟子·滕文公下》"},"example":{"text":"向来论气节的，大概总从东汉末年的党祸起头。那是所谓～的时代。","book":"朱自清《论气节》"},"usage":"作宾语、定语；用于时局等"},{"id":13110,"word":"处安思危","pinyin":"chǔ ān sī wēi","abbr":"casw","explanation":"犹居安思危。处在安乐的环境中，要想到可能会出现困难及危险。指随时有应付意外事件的思想准备。","source":{"text":"居高念下，处安思危，照临有度，纪律无亏。","book":"南宋·郭茂倩《乐府诗集·皇复》"},"example":{"text":"我们得～，要有长远计划。"},"similar":["居安思危"],"opposite":["及时行乐"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":13111,"word":"处实效功","pinyin":"chǔ shí xiào gōng","abbr":"csxg","explanation":"处：办理；效：效验；功：功绩。处理事情从实际出发，讲究功效。","source":{"text":"言之非难，行之为难，故贤者处实而效功，亦非徒陈空文而已。","book":"汉·桓宽《盐铁论·非鞅》"}},{"id":13112,"word":"处尊居显","pinyin":"chǔ zūn jū xiǎn","abbr":"czjx","explanation":"显：显要，显赫。指有声望有地位。形容职位高，权势大的人。","source":{"text":"处尊居显，未必贤，遇也。","book":"汉·王充《论衡·逢遇》"},"usage":"作谓语、定语；指人的地位"},{"id":13113,"word":"处心积虑","pinyin":"chǔ xīn jī lǜ","abbr":"cxjl","explanation":"处心：存心；积虑：经过长时间的考虑。形容蓄谋已久。","source":{"text":"何甚乎郑伯？甚郑伯之处心积虑成于杀也。","book":"《谷梁传·隐公元年》"},"example":{"text":"如此者～，已非一日。","book":"清·李宝嘉《官场现形记》第四十六回"},"similar":["费尽心机","想方设法","设心积虑"],"opposite":["无所用心"],"usage":"作宾语、状语；指费尽心思做坏事"},{"id":13114,"word":"处易备猝","pinyin":"chǔ yì bèi cuì","abbr":"cybc","explanation":"猝：突然，出乎意料。处于顺利的环境要防备突然事变。","source":{"text":"居常虑变，处易备猝。","book":"《投笔肤谈·达权》"}},{"id":13115,"word":"处置失当","pinyin":"chǔ zhì shī dàng","abbr":"czsd","explanation":"处理问题的方式不适合。","example":{"text":"这件事情我～，造成了不良影响。"},"opposite":["处置得当"],"usage":"作谓语、宾语；用于处事"},{"id":13116,"word":"处静息迹","pinyin":"chǔ jìng xī jì","abbr":"cjxj","explanation":"息：停止；迹：足迹。静处不动就不会留下痕迹。引申为要想人不知，除非己莫为。","source":{"text":"不知处阴以休影，处静以息迹，愚亦甚矣。","book":"战国·宋·庄周《庄子·渔父》"},"usage":"作谓语、定语；用于劝诫人"},{"id":13117,"word":"处高临深","pinyin":"chǔ gāo lín shēn","abbr":"cgls","explanation":"处高：处在显贵重要地位。临深：如临深渊。处在显贵之位，好比面临深渊。旧时指官职高了常有危险性。","source":{"text":"处高临深，动常近危。","book":"汉·扬雄《酒箴》"},"example":{"text":"作为高官自然有～之感。"},"usage":"作谓语、定语；指面临危险"},{"id":13118,"word":"备位充数","pinyin":"bèi wèi chōng shù","abbr":"bwcs","explanation":"备位：如同尸位，意即徒在其位，不能尽职；充数：用不够格的人来凑足数额。是自谦不能做事的话。","source":{"text":"吾尝备位将相，年逾六十矣。","book":"东汉·班固《汉书·萧望之传》"},"example":{"text":"我只不过是～罢了。"},"similar":["滥竽充数","尸位素餐"],"usage":"作谓语、宾语、定语；用于自谦"},{"id":13119,"word":"备位将相","pinyin":"bèi wèi jiàng xiàng","abbr":"bwjx","explanation":"备位：如同尸位，意即徒在其位，不能尽职。表示徒在其位，只是凑数而已的自谦语。","source":{"text":"吾尝备位将相，年逾六十矣。","book":"《汉书·萧望之传》"},"similar":["尸位素餐"],"usage":"作宾语、定语；用于自谦"},{"id":13120,"word":"备多力分","pinyin":"bèi duō lì fēn","abbr":"bdlf","explanation":"防备的地方多了，力量就会分散。","source":{"text":"备多力分，扎营太散，呼应不灵，不能战。","book":"高阳《清宫外史》下册"}},{"id":13121,"word":"备尝艰苦","pinyin":"bèi cháng jiān kǔ","abbr":"bcjk","explanation":"备：全、尽；尝：经历。受尽了艰难困苦。","source":{"text":"险阻艰难，备尝之矣。”唐·韩愈《顺宗实录》卷一：上常亲执弓矢，率军后先导卫，备尝辛苦。","book":"《左传·僖公二十八年》"},"example":{"text":"因为只有共产党，才能把这样一个在旧社会～的穷孩子，培养成一个如此优秀的县委书记。","book":"峻青《焦裕录的光辉》"},"similar":["备尝辛苦"],"usage":"作谓语、定语；指受尽了艰难困苦"},{"id":13122,"word":"备尝艰难","pinyin":"bèi cháng jiān nán","abbr":"bcjn","explanation":"备：全、遍；尝：经历。指受尽了艰难困苦。","source":{"text":"尼职居显要，从容而已，虽忧虞不及，而备尝艰难。","book":"《晋书·潘尼传》"},"similar":["备尝艰苦"],"usage":"作谓语、定语；指受尽了艰难困苦"},{"id":13123,"word":"备尝辛苦","pinyin":"bèi cháng xīn kǔ","abbr":"bcxk","explanation":"备：尽、全。尝：经历。受尽了艰难困苦。","source":{"text":"上常亲执弓矢，率军后先导卫，备尝辛苦。","book":"唐·韩愈《顺宗实录》"},"example":{"text":"他一路上～，终于找到要找的人。"},"similar":["备尝艰苦"],"usage":"作谓语、定语；指受尽了艰难困苦"},{"id":13124,"word":"备而不用","pinyin":"bèi ér bù yòng","abbr":"beby","explanation":"准备好了，以备急用，眼下暂存不用。","source":{"text":"虽说备而不用，到得那时候，听凭兵丁造一句谣言，开上几排枪，那人可就死了不少。","book":"清·吴趼人《糊涂世界》"},"example":{"text":"凡是零星物件，本地买不出，一定要用，或是～的，也都齐全。","book":"清·颐琐《黄绣球》第十七回"},"similar":["有备无患","不时之需"],"opposite":["直待雨淋头"],"usage":"作谓语、定语；告诫人们必须做好充分准备"},{"id":13125,"word":"备预不虞","pinyin":"bèi yù bù yú","abbr":"byby","explanation":"不虞：预料不到。对可能发生的意外变故，事前就要有所准备。","source":{"text":"备预不虞，善之大战也。","book":"《左传·成公九年》"}},{"id":13126,"word":"复子明辟","pinyin":"fù zǐ míng bì","abbr":"fzmp","explanation":"指还政或让位。","source":{"text":"周公拜手稽首曰：‘朕复子明辟。’","book":"《尚书·洛诰》"},"example":{"text":"《新唐书·裴炎传》：“今若～，贼不讨而解。”"},"usage":"作谓语、宾语；用于书面语"},{"id":13127,"word":"复旧如初","pinyin":"fù jiù rú chū","abbr":"fjrc","explanation":"复：恢复；如：像，好像。恢复旧的，就像当初一样。","source":{"text":"巴的到祖贯乡闾，我只道认着了伯娘伯父，便欢然复旧如初。","book":"元·无名氏《合同文字》第三折"},"similar":["复旧如新"],"usage":"作谓语；指恢复原来的"},{"id":13128,"word":"复旧如新","pinyin":"fù jiù rú xīn","abbr":"fjrx","explanation":"复：恢复；如：像，好像。恢复旧的，就像当初崭新的一样。","source":{"text":"巴的到祖贯乡闾，我只道认着了伯娘伯父，便欢然复旧如初。","book":"元·无名氏《合同文字》第三折"},"similar":["复旧如初"],"usage":"作谓语、状语；指恢复原来的"},{"id":13129,"word":"复礼克己","pinyin":"fù lǐ kè jǐ","abbr":"flkj","explanation":"克：克制，约束；克己：约束自己。指约束自我，使言行合乎先王之礼。","source":{"text":"室有善言，应在千里，况乎行止，复礼克己。","book":"《晋书·李充传》"},"similar":["克己复礼"],"usage":"作谓语、定语；指约束自己"},{"id":13130,"word":"复蹈其辙","pinyin":"fù dǎo qí zhé","abbr":"fdqz","explanation":"蹈：踏上；辙：车轮辗过的痕迹。比喻不吸取教训，重犯错误。","source":{"text":"今复蹈其辙，譬人畏虎，唁虎以肉，食尽终必食人。","book":"《宋史·子砥传》"},"example":{"text":"孟尝、平原，皆为秦所羁，幸而得免，公子不可～。","book":"明·冯梦龙《东周列国志》第102回"},"similar":["复蹈前辙","重蹈覆辙"],"usage":"作谓语；指不吸取教训，重犯错误"},{"id":13131,"word":"复蹈前辙","pinyin":"fù dǎo qián zhé","abbr":"fdqz","explanation":"蹈：踏上；前辙：先前车轮辗过的痕迹。重新踏上先前车轮辗过的痕迹。比喻不吸取教训，重犯错误。","source":{"text":"今不想前事之失，复循覆车之轨。","book":"《后汉书·窦武传》"},"example":{"text":"文帝阴灵，白日显现，故此炀帝也觉寒心，不敢复蹈前辙。","book":"清·褚人获《隋唐演义》第三十九回"},"similar":["重覆旧辙","复蹈其辙"],"usage":"作谓语；指不吸取教训，重犯错误","story":["东汉光武帝刘秀重用外戚梁冀一家，梁家横行无忌，毒死汉质帝刘瓒。汉桓帝刘志当皇帝后，利用身边的五个宦官除掉了无恶不作的梁家，将这五个宦官封侯，大将军窦武写信给汉桓帝不要重蹈覆辙，结果被宦官杀害"]},{"id":13132,"word":"夏五郭公","pinyin":"xià wǔ guō gōng","abbr":"xwgg","explanation":"《春秋》一书中，“夏五”后缺“月”字，“郭公”下未记事。比喻文字脱漏。","source":{"text":"冬，戎侵曹。曹羁出奔陈。赤归于曹。郭公。","book":"《春秋·桓公十四年》：“十有四年春正月，公会郑伯于曹。无冰。夏五。”《春秋·庄公二十四年》"},"usage":"作宾语、定语；指文字脱漏"},{"id":13133,"word":"夏屋渠渠","pinyin":"xià wū qú qú","abbr":"xwqq","explanation":"夏：通“厦”；渠渠：高大的样子。形容房屋高大而深广。","source":{"text":"于我乎，夏屋渠渠，今也每食无余，于嗟乎，不承权舆！","book":"《诗经·秦风·权舆》"},"example":{"text":"时年三十六，腴田连阡，～矣。","book":"清·蒲松龄《聊斋志异·红玉》"},"usage":"作宾语、定语；用于书面语"},{"id":13134,"word":"夏日可畏","pinyin":"xià rì kě wèi","abbr":"xrkw","explanation":"象夏天酷热的太阳那样使人可怕。比喻为人严厉，令人畏惧。","source":{"text":"冬日可爱，夏日可畏。","book":"《左传·文公七年》：“鄷舒问于贾季曰：‘赵衰、赵盾孰贤？’对曰：‘赵衰，冬日之日也。赵盾，夏日之日也。’”杜预注"},"usage":"作宾语、定语；比喻为人严厉"},{"id":13135,"word":"夏炉冬扇","pinyin":"xià lú dōng shàn","abbr":"xlds","explanation":"夏天生火炉，冬天扇扇子。比喻做事不符合当时的需要，费了力气而得不到好处。","source":{"text":"今则不然，作无益之能，纳无补之说，以夏进炉，以冬奏扇，为所不欲得之事，献所不欲闻之语，其不遇祸，幸矣。","book":"汉·王充《论衡·逢遇》"},"similar":["不合时宜"],"opposite":["雪中送炭"],"usage":"作宾语、定语；指做事不合时宜"},{"id":13136,"word":"夏虫不可以语冰","pinyin":"xià chóng bù kě yǐ yǔ bīng","abbr":"xcbkyyb","explanation":"不能和生长在夏天的虫谈论冰。比喻时间局限人的见识。也比喻人的见识短浅。","source":{"text":"夏虫不可以语于冰者，笃于时也。","book":"《庄子·秋水》"},"example":{"text":"郎如此眼光浅，真是～。","book":"明·凌濛初《二刻拍案惊奇》卷三十七"}},{"id":13137,"word":"夏虫不可言冰","pinyin":"xià chóng bù kě yán bīng","abbr":"xcbkyb","explanation":"不能和生长在夏天的虫谈论冰。比喻时间局限人的见识。也比喻人的见识短浅。","source":{"text":"夏虫不可言冰，蟪蛄不知春秋。","book":"清·名教中人《好逑传》第十回"},"similar":["夏虫不可语冰","夏虫不可语寒"],"usage":"作宾语、定语；指见识短浅的人"},{"id":13138,"word":"夏虫不可语冰","pinyin":"xià chóng bù kě yǔ bīng","abbr":"xcbkyb","explanation":"语：谈论。不能和生长在夏天的虫谈论冰。比喻时间局限人的见识。也比喻人的见识短浅。","source":{"text":"夏虫不可以语于冰者，笃于时也。","book":"战国·宋·庄周《庄子·秋水》"},"example":{"text":"郎如此眼光浅，真是～。","book":"明·凌濛初《二刻拍案惊奇》第37卷"},"similar":["夏虫语冰","夏虫不可言冰"],"usage":"作宾语、定语；指见识短浅的人"},{"id":13139,"word":"夏虫不可语寒","pinyin":"xià chóng bù kě yǔ hán","abbr":"xcbkyh","explanation":"不能和生长在夏天的虫谈论寒冷。比喻时间局限人的见识。也比喻人的见识短浅。","source":{"text":"夫井鱼不可与语大，拘于隘也；夏虫不可与语寒，笃于时也。","book":"《淮南子·原道训》"},"example":{"text":"真是～，说得再多，你也没见过"},"similar":["夏虫不可言冰","夏虫不可语冰"],"usage":"作宾语、定语；指见识短浅的人"},{"id":13140,"word":"夏虫朝菌","pinyin":"xià chóng zhāo jūn","abbr":"xczj","explanation":"意为夏虫活不到冬天，菌类朝生暮死。比喻极短的生命。","source":{"text":"朝菌不知晦朔。","book":"语出《庄子·秋水》：“夏虫不可以语于冰。”又《逍遥游》"},"example":{"text":"谛而念之，亦无以笑彼～也。","book":"晋葛洪《抱朴子·勤求》"},"usage":"作宾语、定语；多用于比喻句"},{"id":13141,"word":"夏虫疑冰","pinyin":"xià chóng yí bīng","abbr":"xcyb","explanation":"比喻人囿于见闻，知识短浅。","source":{"text":"井蛙不可以语于海者，拘于虚也；夏虫不可以语于冰者，笃于时也。","book":"语出《庄子·秋水》"},"example":{"text":"哂夏虫之疑冰，整轻翮而思矫。","book":"《文选·孙绰》"},"similar":["夏虫语冰","夏虫不可语冰"],"usage":"作谓语、宾语；指见识短浅"},{"id":13142,"word":"夏虫语冰","pinyin":"xià chóng yǔ bīng","abbr":"xcyb","explanation":"比喻人囿于见闻，知识短浅。","source":{"text":"井蛙不可以语于海者，拘于虚也；夏虫不可以语于冰者，笃于时也。","book":"语出《庄子·秋水》"},"example":{"text":"不审倚伏之机，不明顺逆之故，是犹醯鸡处瓮，别有一天，～，莫知其候也。","book":"清王韬《六合将混为一》"},"similar":["夏虫疑冰","夏虫不可语冰"],"usage":"作谓语、宾语；指见识短浅"},{"id":13143,"word":"夏雨雨人","pinyin":"xià yǔ yǔ rén","abbr":"xyyr","explanation":"雨：前一个“雨”，名词，雨水；后一个“雨”，动词，下雨。有如夏天的雨落在人身上。比喻及时给人帮助和教育。","source":{"text":"管仲上车曰：‘嗟兹乎，我穷必矣。吾不能以春风风人，吾不能以夏雨雨人，吾穷必矣。’","book":"汉·刘向《说苑·贵德》"},"similar":["春风风人"],"usage":"作谓语、定语；指及时给人以教益或帮助"},{"id":13144,"word":"夏鼎商彝","pinyin":"xià dǐng shāng yí","abbr":"xdsy","explanation":"夏代的鼎，商代的彝器。泛指古董。","source":{"text":"纵然道夏鼎商彝休将做宝贝啶，也不似他情忺。","book":"元汤式《一枝花·赠王马杓》套曲"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第95回：“入到内进，只见一律都是红木家伙，摆设的都是～。”"},"similar":["商彝夏鼎"],"usage":"作主语、宾语、定语；指古董"},{"id":13145,"word":"夔龙礼乐","pinyin":"kuí lóng lǐ yuè","abbr":"klly","explanation":"夔龙：相传为虞舜二臣，夔为乐官，龙为谏官。指可以作为规范的礼乐制度。","source":{"text":"夔龙礼乐承先范，班马文章勘墨铅。","book":"明·王士桢《鸣凤记·邹林游学》"},"usage":"作宾语、定语；指古典礼乐制度"},{"id":13146,"word":"夕寐宵兴","pinyin":"xī mèi xiāo xīng","abbr":"xmxx","explanation":"晚睡早起。形容勤奋不息。同“夙兴夜寐”。","source":{"text":"是故夕寐宵兴，搜奖忠烈；潜构崎岖，遇上履虎；乘机奋发，义不图全。","book":"《南史·宋纪上·武帝》"},"example":{"text":"《南史·宋纪·武帝》：“是故～，搜奖忠烈；潜构崎岖，遇于履虎；乘机奋发，义不图全。”"},"similar":["夙兴夜寐"],"usage":"作谓语、定语、状语；用于书面语"},{"id":13147,"word":"夕惕朝乾","pinyin":"xī tì zhāo qián","abbr":"xtzq","explanation":"指终日勤谨慎，不敢懈怠。","source":{"text":"君子终日乾乾，夕惕若厉，无咎。","book":"《易·乾》"},"example":{"text":"日申月饬，特祖宗已试之规；～，乃臣子本然之分。","book":"明张居正《考满谢手加恩疏》"},"similar":["朝乾夕惕"],"usage":"作定语、状语；用于处事"},{"id":13148,"word":"夕惕若厉","pinyin":"xī tì ruò lì","abbr":"xtrl","explanation":"若：如；厉：危。朝夕戒惧，如临危境，不敢稍懈。","source":{"text":"君子终日乾乾，夕惕若厉，无咎。","book":"《易·乾》"},"example":{"text":"常恐殒越，辜负国恩；寤寐永叹，～。","book":"《三国演义》第七三回"},"usage":"作谓语、定语、状语；用于书面语"},{"id":13149,"word":"夕阳古道","pinyin":"xī yáng gǔ dào","abbr":"xygd","explanation":"傍晚的太阳，古代的大道。比喻凄凉愁苦的景象。","source":{"text":"到晚来闷把西楼倚，见了些夕阳古道，衰柳长堤。","book":"元·王实甫《西厢记》第三本第三折"},"usage":"作宾语、定语；用于书面语"},{"id":13150,"word":"夕阳西下","pinyin":"xī yáng xī xià","abbr":"xyxx","explanation":"指傍晚日落时的景象。也比喻迟暮之年或事物走向衰落。","source":{"text":"夕阳西下，断肠人在天涯。","book":"元·马致远《天净沙·秋思》"},"example":{"text":"～路途行，越岭经峰十里余。","book":"柳亚子《琵琶湖·杂诗》"},"usage":"作宾语、定语；指黄昏"},{"id":13151,"word":"外举不弃仇，内举不失亲","pinyin":"wài jǔ bù qì chóu，nèi jǔ bù shī qīn","abbr":"wjbqcnjbsq","explanation":"举：推荐；弃：丢弃；失：失掉；亲：亲属。推荐人才，即使是仇人也不遗弃，即使是自己的亲属也不遗漏。形容办事公正。","source":{"text":"祁大夫外举不弃仇，内举不失亲，其独遗我乎？","book":"《左传·僖公二十一年》"}},{"id":13152,"word":"外举不避仇，内举不避子","pinyin":"wài jǔ bù bì chóu，nèi jǔ bù bì zǐ","abbr":"wjbbcnjbbz","explanation":"举：推荐；避：避开；失：失掉；亲：亲属。推荐人才，即使是仇人也不遗弃，即使是自己的儿子也不遗漏。形容办事公正。","source":{"text":"外举不避仇，内举不避子，祁黄羊可谓公矣。","book":"《吕氏春秋·去私》"}},{"id":13153,"word":"外举不隐仇，内举不隐子","pinyin":"wài jǔ bù yǐn chóu，nèi jǔ bù yǐn zǐ","abbr":"wjbycnjbyz","explanation":"举：推荐；隐：隐瞒；失：失掉；亲：亲属。推荐人才，即使是仇人也不遗弃，即使是自己的儿子也不遗漏。形容办事公正。","source":{"text":"祁奚可谓不党矣，外举不隐仇，内举不隐子。","book":"《史记·晋世家》"}},{"id":13154,"word":"外交词令","pinyin":"wài jiāo cí lìng","abbr":"wjcl","explanation":"用于交往的空套话。","source":{"text":"辛楣自以为这个英文字嵌得非常妙，不愧外交词令。","book":"钱钟书《围城》"},"similar":["外交辞令"],"usage":"作宾语、定语；用于说话等"},{"id":13155,"word":"外交辞令","pinyin":"wài jiāo cí lìng","abbr":"wjcl","explanation":"辞令：应酬、对答的言词。指外交上应对得体的言词。也指一般场合中得体、中听的敷衍应付性的言语。","source":{"text":"还是挑选几个最会演说，最长于～的人去向他们游说，说动他们的良心。 ★方志敏《可爱的中国》"}},{"id":13156,"word":"外亲内疏","pinyin":"wài qīn nèi shū","abbr":"wqns","explanation":"疏：疏远。外表亲密无间，内心冷若冰霜。形容表里不一。","source":{"text":"孙权刘备，外亲内疏，羽之得意，权所不愿也。","book":"汉·韩婴《韩诗外传》卷二：“曾子曰：‘内疏而外亲。’”《晋书·宣帝纪》"},"example":{"text":"不料此人～，挟诈而取益州，遂并汉中，有霸业兴隆之志。","book":"元·关汉卿《单刀会》第一折"},"similar":["表里不一"],"usage":"作谓语、定语；指表里不一"},{"id":13157,"word":"外内无患","pinyin":"wài nèi wú huàn","abbr":"wnwh","explanation":"患：灾祸，忧患。既无外患，也无内忧。","source":{"text":"唯圣人能外内无患，自非圣人，外宁必有内忧。","book":"《左传·成公十六年》"}},{"id":13158,"word":"外刚内柔","pinyin":"wài gāng nèi róu","abbr":"wgnr","explanation":"外表刚强而内在柔弱。同“内柔外刚”。","source":{"text":"兵戈既起，将帅擅权，武吏功臣，过求姑息。边蕃远郡，得以骄矜，外刚内柔，上陵下替，此为屈辱又非多乎？","book":"宋·吴曾《能改斋漫录·议论》"},"example":{"text":"宋·吴曾《能改斋漫录·太祖推服桑维翰》：“边藩远郡，得以骄矜，～，上陵下潜，此为屈辱又非多乎。”"},"similar":["内柔外刚"],"usage":"作谓语、定语；用于人的个性等"},{"id":13159,"word":"外厉内荏","pinyin":"wài lì nèi rěn","abbr":"wlnr","explanation":"表面强硬而内心虚弱。","source":{"text":"今三公皆令色足恭，外厉内荏，以虚事上，无佐国之实，故清浊而寒温不效也。","book":"南朝·宋·范晔《后汉书·郎剀传》"},"similar":["外强中干","外强中瘠"],"usage":"作谓语、定语；用于为人"},{"id":13160,"word":"外合里差","pinyin":"wài hé lǐ chà","abbr":"whlc","explanation":"比喻口是心非。","source":{"text":"你说你恁行动，两头戳舌献勤，出尖儿，外合里差。","book":"明·兰陵笑笑生《金瓶梅词话》第46回"},"similar":["口是心非"],"opposite":["言行一致"],"usage":"作谓语；指言行不一"},{"id":13161,"word":"外合里应","pinyin":"wài hé lǐ yìng","abbr":"whly","explanation":"外面攻打，里面接应。","source":{"text":"高皇大喜，既便来日准备外合里应，拿捉陈豨。","book":"《前汉书平话》上卷"},"similar":["里应外合","内外勾结"],"usage":"作谓语；指内外勾结"},{"id":13162,"word":"外君子而中小人","pinyin":"wài jūn zǐ ér zhōng xiǎo rén","abbr":"wjzezxr","explanation":"外：表面；中：中间，里边，引申为实际。表面上是高尚的人，而实际是卑鄙的人。","source":{"text":"似你这等人，外君子而中小人，貌人形而心禽兽，即当和你绝交矣。","book":"元·乔孟符《两世姻缘》第三折"}},{"id":13163,"word":"外圆内方","pinyin":"wài yuán nèi fāng","abbr":"wynf","explanation":"圆：圆通；方：方正。比喻人表面随和，内心严正。","source":{"text":"案延资性贪邪，外方内圆，朋党构奸，罔上害人。","book":"南朝·宋·范晔《后汉书·郅恽传》"},"example":{"text":"静女士时常想学慧的老练精干，学王女士的～，又能随和，又有定见。","book":"茅盾《幻灭》"},"similar":["绵里藏针","外柔内刚"],"opposite":["外方内圆"],"usage":"作谓语、宾语；指人的性格"},{"id":13164,"word":"外宽内忌","pinyin":"wài kuān nèi jì","abbr":"wknj","explanation":"指外表上看似宽宏，内心却多忌刻。","source":{"text":"维外宽内忌，意不能堪。军还，有司承旨奏戏，免为庶人。","book":"晋·陈寿《三国志·蜀志·杨戏传》"},"example":{"text":"绍～，所任多亲戚。","book":"明·罗贯中《三国演义》第18回"},"usage":"作谓语、定语；指人的性格"},{"id":13165,"word":"外宽内明","pinyin":"wài kuān nèi míng","abbr":"wknm","explanation":"指外表宽宏而内心明察。","source":{"text":"黄霸为颖川太守，外宽内明，得吏民心。","book":"《汉书·黄霸传》"},"usage":"作谓语、定语；用于处事"},{"id":13166,"word":"外宽内深","pinyin":"wài kuān nèi shēn","abbr":"wkns","explanation":"指外貌宽厚而实则城府很深。","source":{"text":"弘为人意忌，外宽内深。诸尝与弘有卻者，虽详与善，阴报其祸。","book":"西汉·司马迁《史记·平津侯主父列传》"},"usage":"作谓语、定语；形容人深藏不露"},{"id":13167,"word":"外巧内嫉","pinyin":"wài qiǎo nèi jí","abbr":"wqnj","explanation":"外貌乖巧，内心刻忌。犹言口蜜腹剑。","source":{"text":"兄宣静言令色，外巧内嫉之心。","book":"东汉·班固《汉书·翟方进传》"},"similar":["表里不一"],"usage":"作谓语、定语；指表里不一"},{"id":13168,"word":"外弱内强","pinyin":"wài ruò nèi qiáng","abbr":"wrnq","explanation":"外表显得软弱，心里却很刚强。","source":{"text":"公达外愚内智，外怯内勇，外弱内强，不伐善，无施劳，智可及，愚不可及，虽颜子、甯武不能过也。","book":"《三国志·魏志·荀攸传》"}},{"id":13169,"word":"外强中干","pinyin":"wài qiáng zhōng gān","abbr":"wqzg","explanation":"干：枯竭。形容外表强壮，内里空虚。","source":{"text":"今乘异产以从戎事，及惧而变，……外强中干，进退不可，周旋不能，君必悔之。","book":"《左传·僖公十五年》"},"example":{"text":"一切反动派都是～的纸老虎。"},"similar":["外刚内柔","外方内圆"],"opposite":["外柔内刚","外圆内方"],"usage":"作谓语、定语、状语；指空架子","story":["春秋时期，秦国进攻晋国。晋惠公看中一匹郑国产的好马，执意要骑它迎战。大臣庆郑认为这匹马只是外表看上去很强壮，而实际很脆弱，无法驾驭，不能打仗。晋惠公根本不听劝告。结果那匹马战场受惊陷进烂泥坑，晋惠公成为俘虏"]},{"id":13170,"word":"外强中瘠","pinyin":"wài qiáng zhōng jí","abbr":"wqzj","explanation":"外表上好像很强大，实际上很虚弱。","source":{"text":"英夷与俄罗斯两国交恶，俄罗斯方争印度于英夷，积岁构兵，外强中瘠。","book":"清·黄钧宰《金壶浪墨·英国被兵》"},"similar":["外厉内荏","外强中干"],"usage":"作谓语、定语；用于为人"},{"id":13171,"word":"外怯内勇","pinyin":"wài qiè nèi yǒng","abbr":"wqny","explanation":"外表显得怯懦，实际却很勇敢。","source":{"text":"公达外愚内智，外怯内勇，外弱内强，不伐善，无施劳，智可及，愚不可及，虽颜子、宁武不能过也。","book":"《三国志·魏志·荀攸传》"}},{"id":13172,"word":"外愚内智","pinyin":"wài yú nèi zhì","abbr":"wynz","explanation":"外形笨拙憨厚，内心机智聪明。","source":{"text":"太祖每称曰：‘公达外愚内智’。","book":"晋·陈寿《三国志·魏志·荀攸传》"},"similar":["大智若愚"],"usage":"作谓语、定语；指为人","story":["东汉后期，曹操委任荀攸为军师，曹操东征吕布久征不下，荀攸出谋划策，活捉了吕布。后来他又用他的计谋杀了袁绍的大将颜良，荀攸机智聪明，善于谋划，表面上不张扬，严守机密，从不让外人知道。曹操评价他是外愚内智"]},{"id":13173,"word":"外感内伤","pinyin":"wài gǎn nèi shāng","abbr":"wgns","explanation":"①中医指外感风邪，内有郁积而致病。②比喻内外煎迫。","source":{"text":"次日便觉得有些鼻塞声重，胸闷头晕，恹恹的就成了一个外感内伤的病。","book":"清·文康《儿女英雄传》第一回"},"example":{"text":"偶尔的一点～算不了什么。"},"similar":["外感内滞"],"usage":"作宾语、定语；用于医学"},{"id":13174,"word":"外感内滞","pinyin":"wài gǎn nèi zhì","abbr":"wgnz","explanation":"滞：滞留。中医术语，因风寒暑热而得病叫外感，湿热内伏称内滞。比喻内外交攻。","source":{"text":"小姐的病是外感内滞。","book":"清·曹雪芹《红楼梦》第51回"},"example":{"text":"现代医学很容易医治～。"},"similar":["外感内伤"],"usage":"作宾语、定语；用于医学"},{"id":13175,"word":"外慕徙业","pinyin":"wài mù xǐ yè","abbr":"wmxy","explanation":"慕：羡慕；徙：迁移，改变。羡慕分外事物，打算改变职业。","example":{"text":"这样地“～”，什么事也不会定心干下去的！","book":"叶圣陶《倪焕之》十一"}},{"id":13176,"word":"外攘内安","pinyin":"wài rǎng nèi ān","abbr":"wrna","explanation":"攘：排除。原就药的疗效而言。后多指排除外患，安定内部。","source":{"text":"甘草甘平，有安内攘外之能。","book":"汉·张仲景《伤寒论·太阳病上》"}},{"id":13177,"word":"外方内员","pinyin":"wài fāng nèi yuán","abbr":"wfny","explanation":"指外表正直，内心圆滑。","source":{"text":"案延资性贪邪，外方内员，朋党构奸，罔上害人。","book":"南朝·宋·范晔《后汉书·郅恽传》"},"similar":["外方内圆"],"usage":"作谓语、定语；指人的形象"},{"id":13178,"word":"外方内圆","pinyin":"wài fāng nèi yuán","abbr":"wfny","explanation":"外方：外表有棱角，刚直；内圆：内心无棱角，圆滑。指人的外表正直，而内心圆滑。","source":{"text":"案延资性贪邪，外方内员（圆），朋党奸，罔上害人。","book":"《后汉书·致恽传》"},"example":{"text":"她是一个～的人物"},"similar":["外方内员"],"usage":"作谓语、定语；指人的形象"},{"id":13179,"word":"外柔中刚","pinyin":"wài róu zhōng gāng","abbr":"wrzg","explanation":"柔：柔弱；中：内心。外表柔和而内心刚正。","source":{"text":"姚大夫外柔中刚，监军若侵之，必不受。我留，恐及祸。","book":"《新唐书·卢坦传》"},"similar":["外柔内刚"],"usage":"作谓语、定语；用于处世"},{"id":13180,"word":"外柔内刚","pinyin":"wài róu nèi gāng","abbr":"wrng","explanation":"柔：柔弱；内：内心。外表柔和而内心刚正。","source":{"text":"卓外柔内刚，为政简惠。","book":"《晋书·甘卓传》"},"example":{"text":"张季德《一家有一家的事》：“好在他的妻子很贤惠，～，精明强干。”"},"similar":["外柔中刚"],"usage":"作谓语、定语；用于处世"},{"id":13181,"word":"外简内明","pinyin":"wài jiǎn nèi míng","abbr":"wjnm","explanation":"指对人表面上简易，而内心明察。","source":{"text":"绍外宽内忌，所任多亲戚，公外简内明，用人惟才，此度胜也。","book":"明·罗贯中《三国演义》第十八回"},"usage":"作谓语、定语；用于处世"},{"id":13182,"word":"外顺内悖","pinyin":"wài shùn nèi bèi","abbr":"wsnb","explanation":"悖：悖逆，违背。表面上顺从，实际悖逆。","source":{"text":"自天宝以后，政治少懈，文致未优，武克不刚，孽臣奸隶，蠹居綦处，摇毒自防，外顺内悖，父死子代，以祖以孙，如古诸侯，自擅其地，不朝不贡，六七十年。","book":"唐·韩愈《潮州刺史谢上表》"}},{"id":13183,"word":"夙世冤业","pinyin":"sù shì yuān yè","abbr":"ssyy","explanation":"①前世的仇人。形容积怨极深。②昵称所钟爱的人。同“夙世冤家”。","source":{"text":"兜的夙世冤业，却如何一见两情寄牵掣。","book":"明·无名氏《双调夜行船序·重会》套曲"},"similar":["夙世冤家"],"usage":"作宾语、定语；用于书面语"},{"id":13184,"word":"夙世冤家","pinyin":"sù shì yuān jiā","abbr":"ssyj","explanation":"夙世：前世。指有前世仇怨。形容积怨很深。也用为昵称，表示亲爱。","source":{"text":"竦设水陆斋，旁设一位，立碑书曰：‘夙世冤家石介。’","book":"宋·高叟珍《席放谈》"},"similar":["宿世冤家","夙世冤业"],"usage":"作宾语、定语；用于书面语","story":["传说夏竦被罢免宰相位后，因为他看到石介进的《德颂》序中有“追竦白麻，无不喜悦”等话语，于是怀恨在心，想要报复。于是他设立水陆道场，经常在旁边设立一个牌位，上面写着：“夙世冤家石介”，借以泄愤"]},{"id":13185,"word":"夙兴夜处","pinyin":"sù xīng yè chǔ","abbr":"sxyc","explanation":"早起晚睡。形容勤奋。同“夙兴夜寐”。","source":{"text":"曰哀子某哀显相，夙兴夜处不宁。","book":"《仪礼·士虞礼》"},"example":{"text":"南朝·梁·刘勰《文心雕龙·祝盟》：“～，言于袝庙之祝；多福无疆，布于少牢之馈。”"},"similar":["夙兴夜寐"],"usage":"作谓语、定语；用于书面语"},{"id":13186,"word":"夙兴夜寐","pinyin":"sù xīng yè mèi","abbr":"sxym","explanation":"夙：早；兴：起来；寐：睡。早起晚睡。形容勤奋。","source":{"text":"夙兴夜寐，靡有朝矣。","book":"《诗经·魏风·氓》"},"example":{"text":"可怜数载宫闱，克勤克俭，～，何敢轻为妄作，有黍姆训。","book":"明·许仲琳《封神演义》第七回"},"similar":["起早摸黑","夜以继日"],"opposite":["饱食终日","游手好闲"],"usage":"作谓语、定语；用于书面语"},{"id":13187,"word":"夙兴昧旦","pinyin":"sù xīng mèi dàn","abbr":"sxmd","explanation":"黎明即起。形容勤奋。","source":{"text":"朕永鉴四方，求民不瘼，夙兴昧旦，至于忧勤。","book":"《魏书·高祖纪》"},"example":{"text":"南朝·宋·鲍照《河清颂》：“圣上犹～，若有望而未至，宏规远图，如有追而莫及。”"},"similar":["夙兴夜处","夙兴夜寐"],"usage":"作谓语、定语；用于书面语"},{"id":13188,"word":"夙夜不怠","pinyin":"sù yè bù dài","abbr":"sybd","explanation":"夙：早；怠：松懈。从早到晚从不懈怠。形容非常勤奋。","source":{"text":"车骑将军安世事孝武皇帝三十余年，忠信谨厚，勤劳政事，夙夜不怠，与大将军定策，天下受其福，国家重臣也。","book":"《汉书·张安世专》"},"example":{"text":"则虽～，劳神苦思，将求至理，不可得也。","book":"唐·吴兢《贞观政要·择官》"}},{"id":13189,"word":"夙夜不懈","pinyin":"sù yè bù xiè","abbr":"sybx","explanation":"夙夜：早晚，朝夕；懈：懈怠。形容日夜谨慎工作，勤奋不懈。","source":{"text":"武王事之，夙夜不懈，亦不忘王门之辱。","book":"《诗经·大雅·烝民》：“既明且哲，以保其身，夙夜匪解，以事一人。”《吕氏春秋·首时》"},"example":{"text":"戴季陶在报社兢兢业业工作，～，因而得到了天铎报社社长陈屺怀的赞赏。","book":"刘凤舞《民国春秋》第五章"},"similar":["夙夜匪懈","夙夜不解"],"usage":"作谓语、定语；用于书面语"},{"id":13190,"word":"夙夜不解","pinyin":"sù yè bù xiè","abbr":"sybj","explanation":"形容日夜谨慎工作，勤奋不懈。同“夙夜匪懈”。","source":{"text":"此夙夜不解行善之所致也。","book":"《礼记·祭统》：“乃考文叔，兴旧耆欲，作率庆士，躬恤卫国，其勤公家， 夙夜不解，民咸曰休哉！”《汉书·董仲舒传》"},"similar":["夙夜不懈","夙夜匪解"],"usage":"作谓语、定语；用于书面语"},{"id":13191,"word":"夙夜为谋","pinyin":"sù yè wéi móu","abbr":"sywm","explanation":"指日夜谋划。","source":{"text":"今陛下概念国家之耻，励复亿之志，夙夜为谋，相时何隙。","book":"宋·陈亮《论励臣之道》"},"usage":"作谓语、定语；用于书面语"},{"id":13192,"word":"夙夜匪懈","pinyin":"sù yè fěi xiè","abbr":"syfx","explanation":"夙夜：早晚，朝夕；匪：不；懈：懈怠。形容日夜谨慎工作，勤奋不懈。","source":{"text":"熹为卫尉，尽心事上，夙夜匪懈。","book":"晋·司马彪《续汉书》"},"example":{"text":"是以在上不骄，～，或设醴以求贤。","book":"唐·吴兢《贞观政要·教戒太子诸王》"},"similar":["夙夜匪解"],"opposite":["醉生梦死"],"usage":"作谓语、状语；用于书面语"},{"id":13193,"word":"夙夜匪解","pinyin":"sù yè fěi xiè","abbr":"syfj","explanation":"形容日夜谨慎工作，勤奋不懈。解，通“懈”。同“夙夜匪懈”。","source":{"text":"既明且哲，以保其身，夙夜匪解，以事一人。","book":"《诗经·大雅·烝民》"},"similar":["夙夜不解","夙夜匪懈"],"usage":"作谓语、定语；用于书面语"},{"id":13194,"word":"夙夜在公","pinyin":"sù yè zài gōng","abbr":"syzg","explanation":"从早到晚，勤于公务。","source":{"text":"被之僮僮，夙夜在公。","book":"《诗经·召南·采蘩》"},"example":{"text":"毅～，坐而待旦。","book":"《晋书·刘毅传》"},"similar":["废寝忘食"],"usage":"作谓语、定语；指官吏勤于政事"},{"id":13195,"word":"夙夜梦寐","pinyin":"sù yè mèng mèi","abbr":"symm","explanation":"夙夜：早晚。不论早晚或睡眠之中也不敢忘记。","source":{"text":"此诚臣区区之愿，夙夜梦寐，尽心所计。","book":"南朝·宋·范晔《后汉书·郎顗传》"},"usage":"作谓语、定语；用于书面语"},{"id":13196,"word":"夙夜梦寤","pinyin":"sù yè mèng wù","abbr":"symw","explanation":"夙：早；寤：睡醒。指无时无刻不在考虑。形容极力追求。","source":{"text":"此诚臣顗区区之愿，夙夜梦寤，尽心所计。","book":"《后汉书·朗顗传》"}},{"id":13197,"word":"夙心往志","pinyin":"sù xīn wǎng zhì","abbr":"sxwz","explanation":"平素的心愿，以往的志向。","source":{"text":"人生如白驹过隙，死不足恨，但夙心往志，不闻于没世矣。","book":"《魏书·列女传》"},"usage":"作宾语、定语；用于书面语"},{"id":13198,"word":"多一事不如少一事","pinyin":"duō yī shì bù rú shǎo yī shì","abbr":"dysbrsys","explanation":"指不管闲事，事情越少越好。","source":{"text":"现在国家正当多事之秋，那王公大臣只是恐怕耽处分，多一事不如少一事，弄得百事俱废，将来又是怎样个了局？","book":"清·刘鹗《老残游记》第十二回"},"example":{"text":"他生平最怕与洋人交涉，忽然发了一个～的念头，立刻打电报叫陶子尧停办机器。","book":"清·李宝嘉《官场现形记》第九回"},"similar":["得过且过","多一事不如省一事"],"usage":"作宾语、定语、分句；指不想管事"},{"id":13199,"word":"多一事不如省一事","pinyin":"duō yī shì bù rú shěng yī shì","abbr":"dysbrsys","explanation":"指不管闲事，事情越少越好。同“多一事不如少一事”。","source":{"text":"你说的也是，多一事不如省一事。","book":"《红楼梦》第四五回"},"example":{"text":"清·李宝嘉《官场现形记》第九回：“他生平最怕与洋人交涉，忽然发了一个～的念头，立刻就打电报叫陶子尧停办机器，要回银子。”"},"similar":["多一事不如少一事"],"usage":"作宾语、定语、分句；指不想管事"},{"id":13200,"word":"多事之秋","pinyin":"duō shì zhī qiū","abbr":"dszq","explanation":"多事：事故或事变多；秋：时期。事故或事变很多的时期。","source":{"text":"所以多事之秋，灭迹匿端，无为绿林之嚆矢也。","book":"宋·孙光宪《北梦琐言》卷十二"},"example":{"text":"现在国家正当～，那王公大臣只是恐怕耽处分，多一事不如少一事，弄得百事俱废，将来又是怎样个了局？","book":"《老残游记》第十二回"},"similar":["多灾多难","风雨飘摇","内忧外患"],"usage":"作宾语；指容易出事的时期"},{"id":13201,"word":"多事多患","pinyin":"duō shì duō huàn","abbr":"dsdh","explanation":"管的事情多，就容易招祸患。","source":{"text":"无多言，多言多败；无多事，多事多患。","book":"《孔子家语·观周》"}},{"id":13202,"word":"多凶少吉","pinyin":"duō xiōng shǎo jí","abbr":"dxsj","explanation":"凶害多，吉利少。","source":{"text":"你去后多凶少吉，干这般尽忠竭力。","book":"元·无名氏《赚蒯通》第二折"},"example":{"text":"关索道，我不伏（服）水土，惹了灾瘴，病入四时，～，未知如何。","book":"《明成化说唱词话丛刊·花关索贬云南传》"},"similar":["凶多吉少"],"usage":"作谓语、定语；同“凶多吉少”"},{"id":13203,"word":"多劳多得","pinyin":"duō láo duō dé","abbr":"dldd","explanation":"多劳动多受益，不劳动不得食。","example":{"text":"我们要坚持～的分配原则。"},"similar":["按劳分配"],"opposite":["不劳不得"],"usage":"作宾语、定语；指分配"},{"id":13204,"word":"多历年所","pinyin":"duō lì nián suǒ","abbr":"dlns","explanation":"历：经历；年所：年数。经历的年数很多。","source":{"text":"率准兹有陈，保乂有殷。故殷礼陟配天，多历年所。","book":"《尚书·君奭》"},"example":{"text":"每逢皇家受命，～。","book":"唐·刘知己《史通·自叙》"},"similar":["年深日久"],"usage":"作谓语、定语；指历时久远"},{"id":13205,"word":"多历年稔","pinyin":"duō lì nián rěn","abbr":"dlnr","explanation":"指历时久长。","source":{"text":"我自除公宴不食国家之食，多历年稔。","book":"南朝·梁·武帝《责贺琛敕》"},"usage":"作谓语、定语；指历时长久"},{"id":13206,"word":"多口阿师","pinyin":"duō kǒu ā shī","abbr":"dkas","explanation":"指喜欢多话的人。","source":{"text":"钵里饭桶里水，多口阿师难下嘴。","book":"宋·圆悟《碧岩录》卷五"},"opposite":["闷嘴葫芦"],"usage":"作主语、宾语；指喜欢多话的人"},{"id":13207,"word":"多可少怪","pinyin":"duō kě shǎo guài","abbr":"dksg","explanation":"可：许可，允许；怪：责怪。允许的多，责怪的少。指对人比较宽容大度。","source":{"text":"足下傍通，多可而少怪，吾直性狭中，多所不堪，偶与足下相知耳。","book":"三国·魏·嵇康《与山巨源绝交书》"}},{"id":13208,"word":"多吃多占","pinyin":"duō chī duō zhàn","abbr":"dcdz","explanation":"凭权势或用不正当手段侵占国家或集体利益，捞取额外收入。","example":{"text":"她喜欢～。"},"opposite":["你推我让"],"usage":"作谓语、宾语；指贪婪"},{"id":13209,"word":"多嘴多舌","pinyin":"duō zuǐ duō shè","abbr":"dzds","explanation":"很多嘴，很多舌头。形容到处插嘴，搬弄是非。","source":{"text":"你休要多嘴多舌。","book":"元·杨显之《潇湘雨》第三折"},"example":{"text":"须要听两位头领哥哥的言语号令，亦不许你胡言乱语，～。","book":"明·施耐庵《水浒全传》第四十一回"},"similar":["七嘴八舌"],"opposite":["缄口不言"],"usage":"作谓语、宾语；指嘴多"},{"id":13210,"word":"多嘴献浅","pinyin":"duō zuǐ xiàn qiǎn","abbr":"dzxq","explanation":"指胡乱说些没见识、不起好作用的话。","source":{"text":"这一定有多嘴献浅的人，对那强人说我在大门前看他起身，与街坊妇人说话。","book":"《醒世姻缘传》第二回"},"usage":"作宾语、定语；用于说话"},{"id":13211,"word":"多嘴饶舌","pinyin":"duō zuǐ ráo shé","abbr":"dzrs","explanation":"指嘴多，不该说而说或爱管闲事。","source":{"text":"那个多嘴饶舌的、闲在那里不去打瞌睡，却去报新闻，搬起这样是非。","book":"《三遂平妖传》第二回"},"similar":["多嘴多舌"],"usage":"作谓语、宾语；指嘴多"},{"id":13212,"word":"多多少少","pinyin":"duō duō shǎo shǎo","abbr":"ddss","explanation":"或多或少。","source":{"text":"好生趋趋跄跄的，你争我夺，多多少少得些，哄的一声，又到那一边，仍旧募化去了。","book":"明·伏雌教主《醋葫芦》第二回"},"example":{"text":"你～与此事有点牵连。"},"similar":["或多或少"],"usage":"作状语、定语；指或多或少"},{"id":13213,"word":"多多益办","pinyin":"duō duō yì bàn","abbr":"ddyb","explanation":"益：更加。越多越好。同“多多益善”。","source":{"text":"又闻韩信：‘公能将几何？’对曰：‘臣多多益办耳。’","book":"汉·荀悦《汉纪·高祖纪》"},"example":{"text":"韩信用兵，～。此是化工造物之妙，与文同用。","book":"明·王世贞《艺苑卮言》第三卷"},"similar":["多多益善"],"usage":"作谓语、状语、分句；指越多越好"},{"id":13214,"word":"多多益善","pinyin":"duō duō yì shàn","abbr":"ddys","explanation":"益：更加。越多越好。","source":{"text":"臣多多益善耳。","book":"《史记·淮阴侯列传》"},"example":{"text":"这位公子却有钱癖，思量～，要学我这烧争之法。","book":"清·吴敬梓《儒林外史》第十五回"},"similar":["贪多务得","贪得无厌"],"opposite":["清心寡欲","不忮不求"],"usage":"作谓语、状语、分句；指越多越好","story":["西汉初期，韩信最初投奔项羽，没有得到重用，就去投奔刘邦，经丞相萧何极力推荐，才担任汉军的大将军。一次刘邦问韩信能够带多少兵，韩信回答说越多越好，因此得罪了刘邦。后来西汉巩固后，韩信被封为淮阴侯，不久就朝廷所杀"]},{"id":13215,"word":"多如牛毛","pinyin":"duō rú niú máo","abbr":"drnm","explanation":"象牛身上的的毛那样多。形容极多。","source":{"text":"学者如牛毛，成者如麟角。","book":"《北史·文苑列传序》"},"example":{"text":"老百姓痛恨官府催粮催捐，苛捐杂派～，逼得老百姓活不下去。","book":"姚雪垠《李自成》第二卷第二十八章"},"similar":["比比皆是","不计其数","成千上万"],"opposite":["寥寥无几","寥若晨星","凤毛麟角"],"usage":"作谓语、定语；指数量多"},{"id":13216,"word":"多姿多彩","pinyin":"duō zī duō cǎi","abbr":"dzdc","explanation":"颜色形态多样，色彩绚丽。形容事物从形式到内容都很丰富。","similar":["千姿百态"]},{"id":13217,"word":"多心伤感","pinyin":"duō xīn shāng gàn","abbr":"dxsg","explanation":"多心：多疑心。因多疑而引起悲伤。","source":{"text":"你多心伤感，只怕你还伤感不了呢。","book":"清·曹雪芹《红楼梦》第三回"}},{"id":13218,"word":"多快好省","pinyin":"duō kuài hǎo shěng","abbr":"dkhs","explanation":"数量多，速度快，质量好，成本省。","source":{"text":"通过了‘鼓足干劲，力争上游，多快好省地建设社会主义’的总路线。","book":"毛泽东《在扩大的中央工作会议上的讲话》"},"example":{"text":"墙上挂满了“～”的标语。"},"usage":"作状语、定语；指高效"},{"id":13219,"word":"多怀顾望","pinyin":"duō huái gù wàng","abbr":"dhgw","explanation":"顾：转头向后看，指怀疑。很多人怀有顾虑和观望的态度。","source":{"text":"诸将多怀顾望，独公奋然自必，不少屈解。","book":"宋·欧阳修《王彦章画像记》"}},{"id":13220,"word":"多情善感","pinyin":"duō qíng shàn gǎn","abbr":"dqsg","explanation":"感情丰富，容易伤感。","source":{"text":"多情善感自难忘，只有风流共古长。","book":"唐·陆龟蒙《自遣诗》"},"example":{"text":"那还不是一定要引起公园中各式各样的女性，狷介的、忧郁的、～的青年女郎。","book":"茅盾《子夜》"},"similar":["多情多感"],"usage":"作谓语、定语；指感情丰富的人容易伤感"},{"id":13221,"word":"多情多义","pinyin":"duō qíng duō yì","abbr":"dqdy","explanation":"指重情谊。","source":{"text":"聘才已知富三是个热心肠、多情多义的人。","book":"《品花宝鉴》第三回"},"example":{"text":"你们对敌人是那么勇敢坚定，对朋友又是这么～。","book":"魏巍《东方》第六部第四章"},"opposite":["无情无义"],"usage":"作谓语、定语；指重情谊"},{"id":13222,"word":"多情多感","pinyin":"duō qíng duō gǎn","abbr":"dqdg","explanation":"感情丰富，容易伤感。同“多情善感”。","source":{"text":"丁香露泣残枝，算未比、愁肠寸结。自是休文，多情多感，不干风月。","book":"宋·蔡伸《柳梢青》词"},"similar":["多情善感"],"usage":"作谓语、定语；指人的情感"},{"id":13223,"word":"多愁善感","pinyin":"duō chóu shàn gǎn","abbr":"dcsg","explanation":"善：容易。经常发愁和伤感。形容人思想空虚，感情脆弱。","source":{"text":"多情善感自难忘，只有风流共古长。","book":"唐·陆龟蒙《自遣诗三十首》"},"example":{"text":"过去，我～，看什么都没有意思；父母对我不好，引起我对世界上一切都憎恨。","book":"杨沫《青春之歌》第二部第一章"},"similar":["多愁多病","柔情似水"],"opposite":["愁眉苦脸","无情无义","铁石心肠"],"usage":"作谓语、定语；指人感情脆弱"},{"id":13224,"word":"多愁善病","pinyin":"duō chóu shàn bìng","abbr":"dcsb","explanation":"旧时形容才子佳人的娇弱。同“多愁多病”。","source":{"text":"假使天下有这样一个人，又与我同生同死，小弟也不得这样多愁善病！","book":"《儒林外史》第三十回"},"example":{"text":"且～，焉能久活人间？","book":"吴樾《暗杀时代》"},"similar":["多愁多病"],"usage":"作定语、宾语；指体弱多病"},{"id":13225,"word":"多愁多病","pinyin":"duō chóu duō bìng","abbr":"dcdb","explanation":"旧时形容才子佳人的娇弱。","source":{"text":"早是多愁多病，那堪细把旧约前欢重看。","book":"宋·柳永《倾杯词》"},"example":{"text":"我是个“～的身”，你就是那“倾国倾城的貌”。","book":"清·曹雪芹《红楼梦》第二十三回"},"similar":["多愁善感","多愁善病"],"usage":"作定语、补语；指体弱多病"},{"id":13226,"word":"多慢则生乱","pinyin":"duō màn zé shēng luàn","abbr":"dmzsl","explanation":"慢：怠慢。居安忘危，过于怠慢，则容易生出乱事。","source":{"text":"多慢则生乱，思善则生治，理之常也。","book":"《三国志·蜀志·谯周传》"}},{"id":13227,"word":"多手多脚","pinyin":"duō shǒu duō jiǎo","abbr":"dsdj","explanation":"指人手脚忙乱或动手动脚给人添麻烦。","example":{"text":"这个小孩～的，给我增添了不少麻烦。"},"similar":["手忙脚乱"],"usage":"作谓语、定语、状语；多用于小孩"},{"id":13228,"word":"多才为累","pinyin":"duō cái wéi lěi","abbr":"dcwl","explanation":"累：麻烦。因为有才能而给自己带来麻烦或招来祸患。","source":{"text":"多才信为累，叹息此珍禽。","book":"唐·陈子昂《感遇》"}},{"id":13229,"word":"多才多艺","pinyin":"duō cái duō yì","abbr":"dcdy","explanation":"具有多方面的才能和技艺。","source":{"text":"予仁若考，能多才多艺。","book":"《尚书·金滕》"},"example":{"text":"那字刻得细入毫芒，却又波磔分明，不觉叹道：“此公真是～！”","book":"清·吴趼人《二十目睹之怪现状》第四十三回"},"similar":["文武全能","文武双全","全知全能"],"opposite":["一无所长"],"usage":"作谓语、定语；形容才能多方面"},{"id":13230,"word":"多收并畜","pinyin":"duō shōu bìng chù","abbr":"dsbc","explanation":"指一律收罗藏蓄。","source":{"text":"董子称王者以教化为大务，盖天下之人才风俗皆于是关焉，州庠党序多收并畜，不能当百一之选。","book":"明·李东阳《送南京国子祭酒谢公诗序》"},"similar":["兼收并蓄"],"usage":"作谓语、定语、宾语、状语；指兼容性大"},{"id":13231,"word":"多故之秋","pinyin":"duō gù zhī qiū","abbr":"dgzq","explanation":"多故：多变乱多患难；秋：指某个时期。指多事故多患难的时期。","source":{"text":"今多故之秋，人才难得，朕欲除大罪外，徙刑追配有武艺善掌兵者，量才复用。","book":"《金史·宣宗季下》"},"example":{"text":"曩之所以敢飞扬跋扈者，以中国～，未遑兼顾。","book":"清·王韬《弢园文录·宜索归澳门议》"},"similar":["多事之秋"],"usage":"作宾语；指多事故多患难的时期"},{"id":13232,"word":"多文为富","pinyin":"duō wén wéi fù","abbr":"dwwf","explanation":"以多学知识、技能为富有。","source":{"text":"不祈多积，多文以为富。","book":"西汉·戴圣《礼记·儒行》"},"example":{"text":"古人就有“～”的观念。"},"usage":"作定语、宾语；指学问"},{"id":13233,"word":"多文强记","pinyin":"duō wén qiáng jì","abbr":"dwqj","explanation":"闻：见闻。形容知识丰富，记忆力强。","source":{"text":"杭州九曲观音院庆祥禅师，余杭人也，辩才冠众，多闻强记，时天台人推为杰出。","book":"《荀子·解蔽》：“博闻强志，不合王制，君子贱之。”宋·释普济《五灯会元·天台韶国师法嗣》"}},{"id":13234,"word":"多方百计","pinyin":"duō fāng bǎi jì","abbr":"dfbj","explanation":"想尽或用尽种种方法、计谋。","source":{"text":"一言之不入，再哀之不入，或多方百计以求之，总必达目的而后已。","book":"中国近代史资料丛刊《辛亥革命·东京学界告乡人书》"},"example":{"text":"年青人……生出一种反抗心：～思有以满足其性的要求。","book":"郭沫若《文艺论集·〈西厢记〉艺术上的批判》"},"similar":["千方百计"],"usage":"作状语、宾语；指想尽一切办法"},{"id":13235,"word":"多易多难","pinyin":"duō yì duō nán","abbr":"dydn","explanation":"多易：把事情看得太容易；多难：遇到很多困难。如果把事情看得太容易就会遇到很多困难。","source":{"text":"夫轻诺必寡信，多易必多难。","book":"《老子·德经》"}},{"id":13236,"word":"多材多艺","pinyin":"duō cái duō yì","abbr":"dcdy","explanation":"具有多方面的才能和技艺。同“多才多艺”。","source":{"text":"予仁若考，能多材多艺，能事鬼神。乃元孙不若旦多材多艺，不能事鬼神，乃命于帝庭，敷佑四方。","book":"《书·金縢》"},"example":{"text":"郭沫若《反正前后》第一幕：“他～。据我所知，他会做诗，会填词。”"},"similar":["多才多艺","多艺多才"],"usage":"作谓语、定语、宾语；形容才能多方面"},{"id":13237,"word":"多此一举","pinyin":"duō cǐ yī jǔ","abbr":"dcyj","explanation":"举：行动。指多余的，没有必要的举动。","source":{"text":"寅兄盛情，多此一举。","book":"清·李绿园《歧路灯》第四回"},"example":{"text":"问起北京人来，只知道《三侠五义》，而南方人却只见有曲园老人的改本，此老实在可谓～。","book":"《鲁迅书信集·致胡适》"},"similar":["画蛇添足"],"opposite":["必不可少","不可或缺"],"usage":"作谓语、宾语、定语；指多余"},{"id":13238,"word":"多歧亡羊","pinyin":"duō qí wáng yáng","abbr":"dqwy","explanation":"因岔路太多无法追寻而丢失了羊。比喻事物复杂多变，没有正确的方向就会误入歧途。也比喻学习的方面多了就不容易精深。","source":{"text":"大道以多歧亡羊，学者以多方丧生。","book":"《列子·说符》"},"example":{"text":"然尝闻之，大道以～。","book":"明·马中锡《中山狼传》"},"similar":["泛而不专"],"usage":"作谓语；比喻因情况复杂多变而迷失方向","story":["从前杨朱的邻居请他派仆人帮他去找丢失的一只羊，杨子问他为什么要那么多的人去找，邻居说丢失羊的路上有很多岔道，所以要很多人去找。过了很久，派出去找羊的人回来说没有找到，邻居说岔道上又分许多岔道，根本没法找了"]},{"id":13239,"word":"多灾多难","pinyin":"duō zāi duō nàn","abbr":"dzdn","explanation":"指灾难深重。","source":{"text":"他很知道民间的疾苦，看到人民生活的多灾多难，他经常叹息而至于流眼泪。","book":"郭沫若《伟大的爱国诗人——屈原》"},"example":{"text":"他这个人～，值得同情。"},"similar":["灾难深重"],"opposite":["洪福齐天"],"usage":"作谓语、宾语、定语；指灾难深重"},{"id":13240,"word":"多疑少决","pinyin":"duō yí shǎo jué","abbr":"dysj","explanation":"决：决断。遇事疑虑很多，缺少决断力。","source":{"text":"若夫多疑少决，胆劣心狷，内无固守，出不交战。","book":"晋·潘岳《射雉赋》"},"example":{"text":"循～。每欲以万全为虑。","book":"《宋书·武帝纪》"}},{"id":13241,"word":"多病多愁","pinyin":"duō bìng duō chóu","abbr":"dbdc","explanation":"形容人体弱多病，感情脆弱，容易忧愁苦闷。旧时常形容才子佳人的娇弱体态。","source":{"text":"如幻如泡世，多愁多病身，乱来知酒圣，贫去觉钱神。","book":"唐·韦庄《遣兴》"},"example":{"text":"小子～身，怎当他倾国倾城貌。","book":"元·王实甫《西厢记》第一本第四折"}},{"id":13242,"word":"多知为杂","pinyin":"duō zhī wéi zá","abbr":"dzwz","explanation":"杂：杂乱。涉猎过多，难免杂乱。","source":{"text":"或曰：‘淮南太史公者，，其多知与？曷其杂也。’曰：‘杂乎杂，人病以多知为杂，惟圣人为不杂。’","book":"汉·扬雄《法言·问神》"}},{"id":13243,"word":"多种多样","pinyin":"duō zhǒng duō yàng","abbr":"dzdy","explanation":"多方面，各种各样或有变化。","example":{"text":"大海里有～的海洋生物。"},"similar":["五花八门"],"usage":"作谓语、定语；指各种各样"},{"id":13244,"word":"多端寡要","pinyin":"duō duān guǎi yào","abbr":"ddgy","explanation":"端：头绪；要：重要。头绪太多，不得要领。","source":{"text":"袁公徒欲效周公之下士，而未知用人之机。多端寡要，好谋无决。","book":"《三国志·魏书·郭嘉传》"},"usage":"作定语；指头绪太多，不得要领"},{"id":13245,"word":"多管闲事","pinyin":"duō guǎn xián shì","abbr":"dgxs","explanation":"没有必要而插手管别人的事。","source":{"text":"你这人好生无礼。谁叫你多管闲事？","book":"清·石玉昆《三侠五义》第四十四回"},"example":{"text":"他先骂周炳不安分守己，又骂周炳爱～。","book":"欧阳山《苦斗》三二"},"similar":["干卿底事"],"opposite":["漠不关心"],"usage":"作谓语、宾语、定语；指瞎操心","story":["宁国府的贾老爷去世，贾珍父子立即到寺庙里去为老人办理丧事。贾蓉奉父亲贾珍之命回家取银子，刚好尤二姐、尤三姐为他们看家，贾蓉借机调戏尤二姐。尤二姐则担心那些多管闲事的人说三道四，贾蓉则大声说贾琏家中乱伦的丑事"]},{"id":13246,"word":"多能多艺","pinyin":"duō néng duō yì","abbr":"dndy","explanation":"具有多方面的才能和技艺。同“多才多艺”。","source":{"text":"技之巧不过多能艺，使尔多能多艺，则艺成而迹卑。","book":"宋·梅尧臣《乞巧赋》"},"similar":["多才多艺","多材多艺"],"usage":"作谓语、定语、宾语；形容才能多方面"},{"id":13247,"word":"多艺多才","pinyin":"duō yì duō cái","abbr":"dydc","explanation":"具有多方面的才能和技艺。同“多才多艺”。","source":{"text":"高祖固天攸纵，聪明稽古，道亚生知，学为博物，允文允武，多艺多才。","book":"《南史·梁纪下·敬帝》"},"similar":["多才多艺","多能多艺"],"usage":"作谓语、定语、宾语；形容才能多方面"},{"id":13248,"word":"多藏厚亡","pinyin":"duō cáng hòu wáng","abbr":"dchw","explanation":"厚：大；亡：损失。指积聚很多财物而不能周济别人，引起众人的怨恨，最后会损失更大。","source":{"text":"是故甚爱必大费，多藏必厚亡。","book":"《老子》第四十四章"},"example":{"text":"富者得志，贫者失时，甚爱太费，～。","book":"三国·蜀·诸葛亮《便宜十六策·阴察第十六》"},"usage":"作谓语；用于劝诫人"},{"id":13249,"word":"多行不义必自毙","pinyin":"duō xíng bù yì bì zì bì","abbr":"dxbybzb","explanation":"坏事干多了，结果是自己找死。","source":{"text":"多行不义，必自毙，子姑待之。","book":"《左传·隐公元年》"},"example":{"text":"“～”，这是有史以来的天经地义。","book":"郭沫若《武则天》第四幕"},"similar":["作茧自缚","作法自毙","自食其果"],"usage":"作宾语、分句；用于坏人","story":["春秋时期，郑武公去世后，郑庄公即位，他的弟弟共叔段不服，就在自己的封地里招兵买马，准备篡位。祭仲劝郑庄公除掉共叔段，庄公说：“多行不义必自毙！”。共叔段公开谋反时，庄公亲自率军攻打共叔段"]},{"id":13250,"word":"多行无礼必自及","pinyin":"duō xíng wú lǐ bì zì jí","abbr":"dxwlbzj","explanation":"行：做；自及：轮到自己头上。无礼的事做多了，必然会殃及到自己头上。","source":{"text":"君子曰：志所谓多行无礼必自及也，其是之谓乎。","book":"《左传·襄公四年》"}},{"id":13251,"word":"多见广识","pinyin":"duō jiàn guǎng shí","abbr":"djgs","explanation":"见闻多，知识广。","source":{"text":"话说这一篇诗，单道着燕青。他虽是三十六星之末，果然机巧心灵，多见广识，了身达命，都强似那三十五个。","book":"《水浒传》第七四回"},"similar":["博闻广见","见多识广"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；用于人的见识等"},{"id":13252,"word":"多言多语","pinyin":"duō yán duō yǔ","abbr":"dydy","explanation":"指不该说而说。","source":{"text":"卢俊义道：‘你妇人家省得什么！宁可信其有，不可信其无。自古祸出师人口，必主吉凶。我既主意定了，你都不得多言多语。’","book":"《水浒传》第六一回"},"opposite":["沉默寡言"],"usage":"作谓语、宾语、状语；用于人说话"},{"id":13253,"word":"多言多败","pinyin":"duō yán duō bài","abbr":"dydb","explanation":"话说的多，招惹的祸便多。","source":{"text":"无多言，多言多败；无多事，多事多患。","book":"《孔子家语·观周》"}},{"id":13254,"word":"多言或中","pinyin":"duō yán huò zhōng","abbr":"dyhz","explanation":"或：有的。中：正好对上。指多方面讨论之，有的可能中的。","source":{"text":"凡我同志，庶几于此者，要在细求真诀，务以师授，不可以谀闻浅说、多言或中之义，所希企及矣。","book":"《云笈七签》卷七十"},"usage":"作谓语、定语；用于说话"},{"id":13255,"word":"多言数穷","pinyin":"duō yán shuò qióng","abbr":"dysq","explanation":"言多必失，必有理屈之时。","source":{"text":"多言数穷，不如守中。","book":"《老子》"},"usage":"作谓语、定语；用于说话"},{"id":13256,"word":"多言繁称","pinyin":"duō yán fán chēng","abbr":"dyfc","explanation":"讲话或写文章，浮词很多，不必要地大量引述。多指文风浮华不实。","source":{"text":"多言繁称，连类比物，则见以为虚而无用。","book":"《韩非子·难言》"},"usage":"作谓语、定语；用于作文或说话等"},{"id":13257,"word":"多许少与","pinyin":"duō xǔ shǎo yǔ","abbr":"dxsy","explanation":"答应人家的多，给予人家的少。","source":{"text":"行赏吝色者沮，多许少与者怨，既迎而拒者乖。","book":"汉·黄石公《素书·遵义》"},"example":{"text":"他就是有～的毛病。"},"usage":"作谓语、定语；指乱许诺"},{"id":13258,"word":"多识君子","pinyin":"duō shí jūn zǐ","abbr":"dsjz","explanation":"指知识广博的人。","source":{"text":"人之立身，不可以无学，遂良所谓多识君子哉。","book":"《新唐书·褚遂良传》"}},{"id":13259,"word":"多谋善断","pinyin":"duō móu shàn duàn","abbr":"dmsd","explanation":"很有智谋，又善于判断。","source":{"text":"畴咨俊茂，好谋善断。","book":"西晋·陆机《辨亡论》上"},"example":{"text":"你依靠人民，依靠无产阶级，～，领导了上海工人武装起义。","book":"郭小川《痛悼敬爱的周总理》诗"},"similar":["好谋善断","能谋善断"],"opposite":["多谋少断"],"usage":"作谓语、定语；指很有智谋，又善于判断","story":["东汉末年，荆州牧刘表病死，刘表的儿子投降曹操。刘备被迫南撤，孙权派鲁肃去联络刘备，诸葛亮认为可以联吴抗曹。孙权多谋善断，分析曹操犯了用兵之忌，于是与蜀军在赤壁大破曹操号称80万大军，从而形成三足鼎立的局面"]},{"id":13260,"word":"多谋善虑","pinyin":"duō móu shàn lǜ","abbr":"dmsl","explanation":"谋：谋划，策划；虑：思考。富于智谋，又善于思考。","source":{"text":"你是个多谋善虑之人，何不替我筹度一番，行了这个方便也好。","book":"清·李渔《凰求凤·画策》"},"example":{"text":"他是一个～的人。"},"similar":["多谋善断"],"usage":"作谓语、定语；指善于思考"},{"id":13261,"word":"多谋少断","pinyin":"duō móu shǎo duàn","abbr":"dmsd","explanation":"能多方谋划，但缺少决断力。","source":{"text":"同时张石卿制军，其初名位与骆公相埒，而才调发越，则十倍骆公，然有为不能有守，好用权术，多谋少断。","book":"清·薛福成《庸庵笔记·骆文忠公遗爱》"},"usage":"作谓语、定语；用于人"},{"id":13262,"word":"多财善贾","pinyin":"duō cái shàn gǔ","abbr":"dcsg","explanation":"贾：做买卖。原意是本钱多，生意就做得开。后指资本家会做买卖。","source":{"text":"长袖善舞，多钱善贾。","book":"《韩非子·五蠹》"},"example":{"text":"他这次下来是越有越有，以后水大舟高，～，更是无往不利了。","book":"清·吴趼人《糊涂世界》卷十一"},"similar":["长袖善舞","多钱善贾"],"usage":"作谓语、宾语、定语；指资本家会做买卖"},{"id":13263,"word":"多贱寡贵","pinyin":"duō jiàn guǎ guì","abbr":"djgg","explanation":"货物多则价格便宜，货物少则价格昂贵。","source":{"text":"夫物多则贱，寡则贵，散则轻，聚则重，人君知其然，故视国之羡不足而御其财物。","book":"《管子·国蓄》"},"usage":"作宾语、定语；用于商业等"},{"id":13264,"word":"多钱善贾","pinyin":"duō qián shàn gǔ","abbr":"dqsg","explanation":"贾：做生意。本钱多生意就好做。比喻条件充分，事情好办。","source":{"text":"鄙谚曰：‘长袖善舞，多钱善贾。’","book":"战国·韩·韩非《韩非子·五蠹》"},"example":{"text":"谁都明白～的道理。"},"similar":["多财善贾"],"usage":"作谓语、定语；指资本家会做买卖"},{"id":13265,"word":"多闻强记","pinyin":"duō wén qiáng jì","abbr":"dwqj","explanation":"闻：见闻。形容知识丰富，记忆力强。","source":{"text":"杭州九曲观音院庆祥禅师，余杭人也，辩才冠众，多闻强记，时天台人推为杰出。","book":"宋·释普济《五灯会元·天台韶国师法嗣》"},"similar":["博闻强记"],"usage":"作谓语、定语；指记忆力强"},{"id":13266,"word":"多闻阙疑","pinyin":"duō wén quē yí","abbr":"dwqy","explanation":"闻：听；阙疑：有疑问的地方要保留。虽然见多识广，有不懂之处，还应存有疑问。指谦虚谨慎的治学态度。","source":{"text":"多闻阙疑，慎言其余，则寡尤。","book":"春秋·鲁·孔丘《论语·为政》"},"example":{"text":"我们要有～、不耻下问的学习精神。"},"similar":["谦虚谨慎"],"opposite":["骄傲自大","目空一切"],"usage":"作宾语、定语；指学习虚心"},{"id":13267,"word":"多难兴邦","pinyin":"duō nàn xīng bāng","abbr":"dnxb","explanation":"邦：国家。国家多灾多难，在一定条件下可以激励人民奋发图强，战胜困难，使国家强盛起来。","source":{"text":"邻国之难，不可虞也。或多难以固其国，启其疆土；或无难以丧其国，失其守宇。","book":"《左传·昭公四年》"},"example":{"text":"现在这样的局面，我们是有办法对付的，要迎接困难，“～”。","book":"《周恩来选集》下卷"},"usage":"作谓语、定语；指患难能使国家内部团结","story":["春秋时期，楚灵王想称霸于诸侯，就想与诸侯会盟，派椒举前去邀请晋平公参加。晋平公想拒绝，司马侯劝他去，晋平公凭借自己地势险要与战马众多，不怕多灾多难的楚国，司马侯提醒他注意多难兴邦，应该把眼光放远点"]},{"id":13268,"word":"多露之嫌","pinyin":"duō lù zhī xián","abbr":"dlzx","explanation":"露：露水；嫌：厌恶。想早晚行走，又怕露水沾湿衣裳。后用以指男女私会。也比喻行为不检点，受人指责。","source":{"text":"早行多露悔，强进触藩羸。","book":"唐·吕温《同舍弟恭岁暮寄晋州季六协律三十韵》"}},{"id":13269,"word":"多面手","pinyin":"duō miàn shǒu","abbr":"dms","explanation":"指擅长多种技艺的人。","source":{"text":"亚茹：‘你还真是多面手。’","book":"王朔《刘慧芳》"},"example":{"text":"她是单位里的～，事事都能应付。"},"similar":["多才多艺"],"usage":"作主语、宾语、定语；用于夸奖人"},{"id":13270,"word":"多鱼之漏","pinyin":"duō yú zhī lòu","abbr":"dyzl","explanation":"指泄漏军事机密。","source":{"text":"多鱼，地名……《传》言貂於此始擅贵宠，漏洩桓公军事，为齐乱张本。","book":"《左传·僖公二年》：“齐寺人貂始漏师於多鱼。”杜预注"},"example":{"text":"约以晦日同时进袭，而汉奸有～，洋人踞城者皆预为准备。","book":"清·夏燮《中西纪事·海疆殉难》"},"usage":"作主语、宾语；用于军事等"},{"id":13271,"word":"夜不成寐","pinyin":"yè bù chéng mèi","abbr":"ybcm","explanation":"寐：睡着。形容因心中有事，晚上怎么也睡不着觉。","source":{"text":"明日而先公言：‘汝夜何所往？吾闻抱关老卒云，楼故多怪，每夕必出。’予因道昨见者。是日徒于孤独，竟夜不能寐。","book":"宋·洪迈《夷坚志·乙志卷八·虔州城楼》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第95回：“～，闻声则惊，在安庆医了半年，不见有效。”"},"usage":"作谓语、定语；用于处事"},{"id":13272,"word":"夜不闭户","pinyin":"yè bù bì hù","abbr":"ybbh","explanation":"户：门。夜里睡觉不用闩上门。形容社会治安情况良好。","source":{"text":"是故谋闭而不兴，盗窃乱贼而不作，故外户而不闭，是谓大同。","book":"《礼记·礼运》"},"example":{"text":"两川之民，忻乐太平，～，路不拾遗。","book":"明·罗贯中《三国演义》第八十七回"},"similar":["道不拾遗","鸡犬不惊","国泰民安"],"opposite":["乌烟瘴气","污七八糟","豺狼当道"],"usage":"作主语、谓语、宾语、定语；指社会治安好","story":["战国时期，卫国人商鞅因逃难到秦国，主张法制国家，受到秦孝王的重用，他先后制定一系列新法，废除维护贵族特权的旧法，主张在法律面前人人平等，执法严明，不循私情。经过一段时间，秦国社会安定，夜不闭户，道不拾遗，国力强盛"]},{"id":13273,"word":"夜以接日","pinyin":"yè yǐ jiē rì","abbr":"yyjr","explanation":"晚上连着白天。形容加紧工作或学习。","source":{"text":"仰而思之，夜以继日。","book":"《庄子·至乐》：“夫贵者，夜以继日，思虑善否。”《孟子·离娄下》"},"example":{"text":"夫越君，贤主，苦身劳力，～，内饰其政，外事诸侯，必将有报我之心。","book":"《吴越春秋·夫差内传》"},"similar":["夜以继日","以夜继日","夜以继昼"],"usage":"作谓语、定语、状语；用于工作等"},{"id":13274,"word":"夜以继日","pinyin":"yè yǐ jì rì","abbr":"yyjr","explanation":"晚上连着白天。形容加紧工作或学习。","source":{"text":"仰而思之，夜以继日。","book":"《庄子·至乐》：“夫贵者，夜以继日，思虑善否。”《孟子·离娄下》"},"example":{"text":"殷之季君，亦奏斯乐。酒池肉林，～。","book":"三国魏·阮籍《乐论》"},"similar":["通宵达旦","废寝忘食","焚膏继晷"],"opposite":["游手好闲"],"usage":"作谓语、定语、状语；用于工作等","story":["西周时期，周武王灭商不久就去世，他的儿子周成王姬诵继承王位，继位时才13岁，朝中大事全由他的叔父姬旦辅佐处理。周公旦为了西周的政权稳固，夜以继日地工作，打败了自己兄弟与商纣王儿子武庚勾结的叛乱，任劳任怨地辅佐朝政"]},{"id":13275,"word":"夜以继昼","pinyin":"yè yǐ jì zhòu","abbr":"yyjz","explanation":"用夜里的时间接上白天的时间。形容日夜不息地努力。","source":{"text":"昔文王不敢槃游于田，以万人惟忧，而陛下远猎山林，夜以继昼。","book":"南朝·宋·范晔《后汉书·郅恽传》"},"similar":["夜以继日","夜以接日","以夜继日"],"usage":"作谓语、定语、状语；用于工作等"},{"id":13276,"word":"夜以续日","pinyin":"yè yǐ xù rì","abbr":"yyxr","explanation":"晚上连着白天。形容加紧工作或学习。","source":{"text":"其商人通贾，倍道兼行，夜以续日，千里而不远者，利在前也。","book":"《管子·禁藏》"}},{"id":13277,"word":"夜住晓行","pinyin":"yè zhù xiǎo xíng","abbr":"yzxx","explanation":"晓：天明。夜里住宿下来，天刚亮就起来赶路。形容旅途奔波劳苦。","source":{"text":"且说王教头母子二人自离了东京，免不了饥餐渴饮，夜住晓行。","book":"明·施耐庵《水浒全传》第一回"},"example":{"text":"赵旭词毕，作别亲友，起程而行。于路饥餐渴饮，～。","book":"明·冯梦龙《喻世明言》卷十一"},"similar":["夜宿晓行"],"usage":"作谓语、定语、宾语；用于旅途"},{"id":13278,"word":"夜光之璧","pinyin":"ye guang zi bi","abbr":"ygzb","explanation":"珍贵的璧玉，夜间放光。"},{"id":13279,"word":"夜半三更","pinyin":"yè bàn sān gēng","abbr":"ybsg","explanation":"指深夜时光。","source":{"text":"这船上是什么人，半夜三更，大呼小叫的。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"这样大事，～来此看他做甚么？","book":"明·胡文焕《群音类选·十义记·付记婴孩》"},"similar":["三更半夜"],"opposite":["日上三竿"],"usage":"作宾语、定语；指深夜"},{"id":13280,"word":"夜半客","pinyin":"yè bàn kè","abbr":"ybk","explanation":"比喻关系亲密的人。","source":{"text":"王莽为宰衡时，甄丰旦夕入谋议，时人语曰：‘夜半客，甄长伯。’","book":"《后汉书·彭宠传》"}},{"id":13281,"word":"夜半更深","pinyin":"yè bàn gēng shēn","abbr":"ybgs","explanation":"更：古时夜间计时单位，1夜＝5更，1更＝2小时。深夜。","source":{"text":"急忙奔走，夜半更深，不认路途而行，只要保全性命。","book":"明·许仲琳《封神演义》第二回"},"example":{"text":"路遥《平凡的世界》第一卷第十章：“这而今～，兽医站的人别说早已经下了班，现在恐怕都睡得死沉沉的了。”"},"similar":["深更半夜"],"usage":"作宾语、定语；指深夜"},{"id":13282,"word":"夜去明来","pinyin":"yè qù míng lái","abbr":"yqml","explanation":"形容关系密切，往来频繁。","source":{"text":"火宅牵缠，夜去明来，早晚担忧。"},"example":{"text":"那张三和这阎婆惜如胶似漆，～，街坊上人也都知了，却有些风声吹在宋江耳朵里。","book":"明·施耐庵《水浒全传》第二十回"}},{"id":13283,"word":"夜宿晓行","pinyin":"yè sù xiǎo xíng","abbr":"ysxx","explanation":"晓：天明。夜里住宿下来，天刚亮就起来赶路。形容旅途奔波劳苦。","source":{"text":"在路不免饥食渴饮，夜宿晓行。","book":"明·施耐庵《水浒全传》第五十二回"},"example":{"text":"袁时中和慧梅带的全是骑兵，一路上～，第三天黄昏时候，到了陈州境内。","book":"姚雪垠《李自成》第三卷第三十三章"},"similar":["夜住晓行"],"usage":"作谓语、定语、宾语；用于旅途"},{"id":13284,"word":"夜寝夙兴","pinyin":"yè qǐn sù xīng","abbr":"yqsx","explanation":"寝：睡觉；夙：早；兴：起来。早起晚睡。形容勤奋。","source":{"text":"贤者之长官也，夜寝夙兴，收敛关市、山林、泽梁之利，以实官府，是以官府实而财不散。","book":"《诗经·卫风·氓》：“夙兴夜寐，靡有朝矣。”《墨子·尚贤》"}},{"id":13285,"word":"夜寝早起","pinyin":"yè qǐn zǎo qǐ","abbr":"yqzq","explanation":"寝：睡觉。晚睡早起。形容学习或工作勤奋。","source":{"text":"某子之亲，夜寝早起，强力生财以养子孙、臣妾。","book":"《管子·乘马》：“是故夜寝早起，父子兄弟不忘其功，为之不倦，民不惮劳苦。”《韩非子·忠孝》"},"example":{"text":"自微贱至富贵，食不重味，案上不过三杯。～，妻希见其面。","book":"《汉书·朱博传》"}},{"id":13286,"word":"夜月昼星","pinyin":"yè yuè zhòu xīng","abbr":"yyzx","explanation":"夜间如月，白日如星。指明珠。","source":{"text":"错杂宝以饰台榭，县明珠于四垂，昼视之如星，夜望之如月。里语曰：‘洛阳多钱郭氏室，夜日昼星富无比。’","book":"晋·王嘉《拾遗记》卷六"}},{"id":13287,"word":"夜月花朝","pinyin":"yè yuè huā zhāo","abbr":"yyhc","explanation":"美好的时光。多指男女情事。","source":{"text":"成就了洞房中夜月花朝事，受用些绿窗前茶余饭饱时。","book":"元·刘时中《一枝花·罗帕传情》套曲"},"usage":"作宾语、定语；用于书面语"},{"id":13288,"word":"夜深人静","pinyin":"yè shēn rén jìng","abbr":"ysrj","explanation":"深夜没有人声，非常寂静。","source":{"text":"更深夜阑兮，梦汝来期。","book":"汉·蔡琰《胡茄十八折》"},"example":{"text":"听到月高初更后，果然弦索齐鸣。恰喜禁垣，～，琤璁齐应。（清·洪昇《长生殿·偷曲》）"},"similar":["夜阑人静","半夜三更","万籁俱寂"],"opposite":["锣鼓喧天","急管繁弦","沸反盈天"],"usage":"作定语、分句；形容十分安静"},{"id":13289,"word":"夜而忘寐","pinyin":"yè ér wàng mèi","abbr":"yewm","explanation":"寐：睡觉。晚上忘记了睡觉。形容学习或工作十分勤劳辛苦。","source":{"text":"夜而忘寐，饥而忘食。","book":"《史记·赵世家》"},"example":{"text":"自有事中原，兵不暂息，吾每念之，～，奈何轻用其死乎！","book":"《资治通鉴·晋记·孝宗永和十二年》"}},{"id":13290,"word":"夜而忘寝","pinyin":"yè ér wàng qǐn","abbr":"yewq","explanation":"晚上忘记了睡觉。形容学习或工作十分勤劳辛苦。","source":{"text":"夜而忘寐，饥而忘食。","book":"《史记·赵世家》"}},{"id":13291,"word":"夜蛾赴火","pinyin":"yè é fù huǒ","abbr":"yefh","explanation":"象蛾子扑火一样。比喻自找死路、自取灭亡。","source":{"text":"如飞蛾之赴火，岂焚身之可吝。","book":"晋·支昙帝《赴火蛾赋》：“愚人贪财，如蛾投火。”《梁书·到溉传》"},"similar":["飞蛾赴火"],"usage":"作宾语、定语；指自取灭亡"},{"id":13292,"word":"夜行昼伏","pinyin":"yè xíng zhòu fú","abbr":"yxzf","explanation":"伏：躲藏。白天躲藏起来，夜间出来行动。","source":{"text":"是时寇贼兴起，道路隔绝，使驿稀有达者。翊夜行昼伏，乃到长安。","book":"《后汉书·刘翊传》"},"example":{"text":"斜谷若有魏兵守把，汝二人引本部军越山岭，～，速出祈山之左，举火为号。","book":"明·罗贯中《三国演义》第一百回"},"usage":"作谓语、定语、宾语；用于旅途"},{"id":13293,"word":"夜行被绣","pinyin":"yè xíng bèi xiù","abbr":"yxbx","explanation":"指身穿锦绣衣服在黑夜行走。比喻显贵不为人所知。","source":{"text":"语出《史记·项羽本纪》“富贵不归故乡，如衣绣夜行，谁知之者？”"},"similar":["锦衣夜行"],"usage":"作宾语、定语；用于处事"},{"id":13294,"word":"夜郎自大","pinyin":"yè láng zì dà","abbr":"ylzd","explanation":"夜郎：汉代西南地区的一个小国。比喻人无知而又狂妄自大。","source":{"text":"滇王与汉使者言曰：‘汉孰与我大？’及夜郎侯亦然。以道不通，故各以为一州主，不知汉广大。","book":"《史记·西南夷列传》"},"example":{"text":"驾炮车之狂云，遂以～。恃贪之逆气，漫以河伯为尊。","book":"清·蒲松龄《聊斋志异·绛妃》"},"similar":["自高自大","妄自尊大","不可一世"],"opposite":["谦虚谨慎","虚怀若谷","大智若愚"],"usage":"作谓语、定语；指人无知妄自尊大","story":["西汉时期，西南地区有个面积只有汉朝一个州那么大的夜郎国，人口稀少，土地稀薄，国王非常骄傲，自以为夜郎国是天下唯一的大国。西汉朝廷派唐蒙出访夜郎国，夜郎国国王竟不知高低地问：“汉孰与我大？”唐蒙哑然失笑"]},{"id":13295,"word":"夜长梦多","pinyin":"yè cháng mèng duō","abbr":"ycmd","explanation":"比喻时间一拖长，情况可能发生不利的变化。","source":{"text":"荐举事近复纷纭，夜长梦多，巩将来有意外，奈何？","book":"清·吕留良《家训真迹》"},"example":{"text":"这件事要赶紧解决，免得～，再出问题。"},"similar":["朝令夕改","朝秦暮楚","瞬息万变"],"opposite":["一成不变","一定不易","雷打不动"],"usage":"作谓语、定语、宾语；用于口语"},{"id":13296,"word":"夜长梦短","pinyin":"yè cháng mèng duǎn","abbr":"ycmd","explanation":"比喻因有心事而难以入睡。","source":{"text":"夜长嫌梦短，泪少怕愁多。","book":"宋·晁冲之《临江仙》词"},"example":{"text":"她披着那件大氅，躺在炕上，左思右想总得不着一个解决的办法。～，她只睁着眼等天亮。","book":"许地山《归途》"},"usage":"作宾语、定语；用于书面语"},{"id":13297,"word":"夜阑人静","pinyin":"yè lán rén jìng","abbr":"ylrj","explanation":"夜阑：夜将尽。夜深人静的时候。","source":{"text":"更深夜阑兮，梦汝来期。","book":"汉·蔡琰《胡茄十八折》"},"example":{"text":"这早晚玉绳高、银河浅，恰正是～。","book":"元·李文蔚《燕青博鱼》第三折"},"similar":["更深人静","夜静更深"],"opposite":["人声鼎沸","鸡犬不宁"],"usage":"作谓语、定语；形容夜的寂静"},{"id":13298,"word":"夜雨对床","pinyin":"yè yǔ duì chuáng","abbr":"yydc","explanation":"指亲友或兄弟久别重逢，在一起亲切交谈。","source":{"text":"每思闻净话，夜雨对绳床。","book":"唐·郑谷《思图昉上人》"},"example":{"text":"诵韦氏诗‘～’，后勿有违。","book":"宋·苏辙《再祭亡兄端明文》"},"similar":["对床夜雨"],"usage":"作定语；指亲友或兄弟久别重逢在一起"},{"id":13299,"word":"夜静更深","pinyin":"yè jìng gēng shēn","abbr":"yjgs","explanation":"无声无息的深夜。","source":{"text":"现如今是阿谁，忙出去问真实，则见他气丕丕的斜倚着门儿立。","book":"元·无名氏《连环计》第四折"},"example":{"text":"～，你要是听见海浪哗啦哗啦拍着长城脚，据说那是孟姜女又哭了。","book":"杨朔《秋风萧瑟》"},"similar":["夜静更长"],"usage":"作宾语、定语；指深夜"},{"id":13300,"word":"夜静更长","pinyin":"yè jìng gēng cháng","abbr":"yjgz","explanation":"更长：指深夜。形容夜很深，很静。","source":{"text":"更深夜阑兮，梦汝来期。","book":"汉·蔡琰《胡茄十八折》"},"example":{"text":"你从来有些技痒，正～，对月貌花庞，饮玉液琼浆。","book":"元·吴昌龄《东坡梦》第四折"},"similar":["夜静更深"],"usage":"作宾语、定语；指深夜"},{"id":13301,"word":"夜静更阑","pinyin":"yè jìng gēng lán","abbr":"yjgl","explanation":"阑：尽。无声无息的深夜。","source":{"text":"现如今是阿谁，忙出去问真实，则见他气丕丕的斜倚着门儿立。","book":"元·无名氏《连环计》第四折"},"usage":"作宾语、定语；指深夜"},{"id":13302,"word":"夤缘攀附","pinyin":"yín yuán pān fǔ","abbr":"yypf","explanation":"拉拢关系，攀附权贵，以求高升。","source":{"text":"给事中宋琮及御史许斌言直自初为侍郎以至入阁，夤缘攀附，皆取中旨。","book":"《明史·尹直传》"},"similar":["趋炎附势"],"usage":"作谓语、定语；指趋炎附势"},{"id":13303,"word":"夤缘求进","pinyin":"yín yuán qiú jìn","abbr":"yyqj","explanation":"拉拢关系，攀附权贵，以求高升。","source":{"text":"初，俨致仕复夤缘求进，上问左右：‘邓俨可复用乎？’平章政事完颜守贞曰：‘俨有才力，第以谋身为心。’","book":"《金史·邓俨传》"},"example":{"text":"有的新降官员，为着～，递上门生帖子，拜牛金星为座师。","book":"姚雪垠《李自成》第四卷第十七章"}},{"id":13304,"word":"夤缘而上","pinyin":"yín yuán ér shàng","abbr":"yyes","explanation":"拉拢关系，攀附权贵，以求高升。","source":{"text":"给事中宋琮及御史许斌言直自初为侍郎以至入阁，夤缘攀附，皆取中旨。","book":"《明史·尹直传》"}},{"id":13305,"word":"大中至正","pinyin":"dà zhōng zhì zhèng","abbr":"dzzz","explanation":"极为公正，不偏不倚。","source":{"text":"不知先生居夷三载，处困养静，精一之功，固已超入圣城，粹然大中至正之归矣。","book":"明·王守仁《传习录》上卷"},"similar":["大公至正"],"usage":"作谓语、定语；用于为人处世等"},{"id":13306,"word":"大举进攻","pinyin":"dà jǔ jìn gōng","abbr":"djjg","explanation":"大举：重大的行动。大规模出兵，向敌方进攻。","source":{"text":"因吴佩孚此时目光，已从军事移到政治方面，也不大举进攻。","book":"《民国通俗演义》第133回"},"example":{"text":"敌人～，红军奋起反抗。"},"opposite":["小打小闹"],"usage":"作谓语、宾语；指大规模行动"},{"id":13307,"word":"大义凛然","pinyin":"dà yì lǐn rán","abbr":"dylr","explanation":"大义：正义；凛然：严肃、或敬畏的样子。由于胸怀正义而神态庄严，令人敬畏。","source":{"text":"大义凛然，奋裙首倡。","book":"宋·曹辅《唐颜文忠公新庙记》"},"example":{"text":"因想起文丞相和谢先生，一般的～，使宋室虽亡，犹有余荣。","book":"清·吴趼人《痛史》第二十二回"},"similar":["临危不惧","正气浩然"],"opposite":["奴颜婢膝","卑躬屈膝"],"usage":"作谓语、状语；形容勇士与英雄"},{"id":13308,"word":"大义灭亲","pinyin":"dà yì miè qīn","abbr":"dymq","explanation":"大义：正义，正道；亲：亲属。为了维护正义，对犯罪的亲属不循私情，使受到应得的惩罚。","source":{"text":"大义灭亲，其是之谓乎。","book":"《左传·隐公四年》"},"example":{"text":"这是一条汉子，～，死活只有一个党。","book":"丁玲《太阳照在桑干河上》二四"},"similar":["大公无私","不徇私情","六亲不认"],"opposite":["徇情枉法","徇私舞弊"],"usage":"作谓语、宾语、定语；指维护正义","story":["春秋时卫国大夫石碏曾经劝谏卫庄公，希望教育好庄公之子州吁。庄公死，卫桓公即位，州吁与石碏之子石厚密谋杀害桓公篡位，为确保王位坐稳，派石厚去请教石碏。石碏恨儿子大逆不道，设计让陈国陈桓公除掉了州吁与石厚"]},{"id":13309,"word":"大书特书","pinyin":"dà shū tè shū","abbr":"dsts","explanation":"书：写。大写特写。指对意义重大的事情特别郑重地加以记载。","source":{"text":"而足下年尚强，嗣德有继，将大书特书，屡书不一书而已也。","book":"唐·韩愈《答元侍御书》"},"example":{"text":"倘令为林文忠作传，则烧鸦片一事，固当～。","book":"清·吴汝纶《答严几道》"},"similar":["淋漓尽致","长篇大论"],"opposite":["轻描淡写","片言只字"],"usage":"作宾语；与“应该”、“值得”等连用"},{"id":13310,"word":"大事不糊涂","pinyin":"dà shì bù hú tú","abbr":"dsbht","explanation":"指在有关政治的是非问题上能坚持原则，态度鲜明。","source":{"text":"端小事糊涂，大事不糊涂。","book":"《宋史·吕端传》"},"example":{"text":"他一向都是～的。"},"similar":["难得糊涂"],"opposite":["糊里糊涂"],"usage":"作谓语、定语；指头脑清醒","story":["北宋时期，谏议大夫吕端办事公正，是非分明。他为人谦虚谨慎，宋太宗十分信任他，他的名声位于寇准之下。宋太宗不满当时的宰相吕蒙正，想让吕端取代，征询大臣的意见。有人说吕端为人糊涂。宋太宗说吕端是小事糊涂，大事不糊涂"]},{"id":13311,"word":"大事化小","pinyin":"dà shì huà xiǎo","abbr":"dshx","explanation":"化：变。经过妥善处理，将大事化成小事。","source":{"text":"对于反动军阀的叛变，或者采取大事化小的态度，或者置之不闻不问。","book":"陶菊隐《北洋军阀统治时期史话》第76章"},"example":{"text":"陶菊隐《北洋军阀统治时期史话》第76章：“对于反动军阀的叛变，或者采取～的态度，或者置之不闻不问。”"},"similar":["大事化小，小事化无"],"usage":"作宾语、定语；用于处事"},{"id":13312,"word":"大事化小，小事化无","pinyin":"dà shì huà xiǎo，xiǎo shì huà wú","abbr":"dshxxshw","explanation":"化：变。经过妥善处理，将大事化成小事，小事变成没事，息事宁人。","source":{"text":"‘大事化为小事，小事化为无事’，方是兴旺之家。","book":"清·曹雪芹《红楼梦》第62回"},"example":{"text":"他很会说话，遇到住户们打架拌嘴，他能一面挖苦，一面恫吓，而把～。","book":"老舍《四世同堂》"},"similar":["大事化小"],"usage":"作宾语、定语；用于处事"},{"id":13313,"word":"大事去矣","pinyin":"dà shì qù yǐ","abbr":"dsqy","explanation":"去：失去。形容事情无法挽回了。多指政权丧失，国家灭亡等大事。","source":{"text":"诚用此计，大事去矣。","book":"汉·荀悦《汉纪·高祖纪》"},"example":{"text":"～，人之云亡。","book":"北周·庾信《哀江南赋》"},"similar":["大势已去"],"opposite":["欣欣向荣"],"usage":"作谓语、定语；指失败"},{"id":13314,"word":"大事完毕","pinyin":"dà shì wán bì","abbr":"dswb","explanation":"指事情已经完满结局。","example":{"text":"现在还没到～的时候，我们不能松懈。"},"similar":["大功告成"],"opposite":["为时尚早"],"usage":"作宾语、定语；用于口语"},{"id":13315,"word":"大事已然","pinyin":"dà shì yǐ rán","abbr":"dsyr","explanation":"指事情已成定局，不可挽回。","example":{"text":"～，由他去吧。"},"similar":["木已成舟"],"usage":"作谓语、定语、分句；指已成定局"},{"id":13316,"word":"大事铺张","pinyin":"dà shì pū zhāng","abbr":"dspz","explanation":"指对场面特别安排，过于讲究，以显示自己的阔绰。多用于婚丧大事。"},{"id":13317,"word":"大人不曲","pinyin":"dà rén bù qū","abbr":"drbq","explanation":"曲：不公正。旧时指道德高尚的人遵守一定的原则，不偏私，不迎合。","source":{"text":"怵迫之徒兮，或趋东西，大人不曲兮，意变齐同。","book":"汉·贾谊《鹏鸟赋》"}},{"id":13318,"word":"大人不见小人怪","pinyin":"dà rén bù jiàn xiǎo rén guài","abbr":"drbjxrg","explanation":"怪：责备，埋怨。指地位高对地位低的过错不见怪，加以原谅。","source":{"text":"常言道：大人不见小人怪，宰相肚里能行船。一为他们无知，二看卑职面上，您就恕过他们吧。","book":"陈荫荣《兴唐传·闹花灯》第12回"},"similar":["大人不记小人过"],"usage":"作谓语、宾语；用于求情"},{"id":13319,"word":"大人不记小人过","pinyin":"dà rén bù jì xiǎo rén guò","abbr":"drbjxrg","explanation":"指地位高对地位低的过错加以原谅。","source":{"text":"胡老爷，大人不记小人过，我说错了话，真正该打。","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["大人不见小人怪"],"usage":"作谓语、宾语；用于求情"},{"id":13320,"word":"大人先生","pinyin":"dà rén xiān sheng","abbr":"drxs","explanation":"旧时指有身分有地位的人。有时带讽刺意味。","source":{"text":"有大人先生以天地为一朝，万期为须臾，日月为扃牖，八荒为庭衢。","book":"晋·刘伶《酒德颂》"},"example":{"text":"咳！好好一座中国江山，被这班强有力的～闹到四分五裂，不可究结，共和在哪里？","book":"蔡东藩、许廑父《民国通俗演义》第一回"},"similar":["大人君子"],"opposite":["平民百姓"],"usage":"作主语、宾语、定语；多用于讥讽"},{"id":13321,"word":"大人君子","pinyin":"dà rén jūn zǐ","abbr":"drjz","explanation":"大人：古代尊称；君子：指品行好的人。指才德兼备的人。","source":{"text":"庸人视之，如推车于太行之险，大人君子视之，一苇可杭之浅者也。","book":"清·王夫之《读通鉴论·唐中宗》"},"similar":["大人先生"],"usage":"作主语、宾语、定语；指贤人"},{"id":13322,"word":"大人无己","pinyin":"dà rén wú jǐ","abbr":"drwj","explanation":"旧时指道德高尚的人把自己和别人融为一体，不自私。","source":{"text":"至德不得，大人无己。","book":"《庄子·秋水》"}},{"id":13323,"word":"大人虎变","pinyin":"dà rén hǔ biàn","abbr":"drhb","explanation":"虎变：如虎身花纹的变化。比喻居上位者出处行动变化莫测。","source":{"text":"大人虎变，未占有孚。","book":"《周易·革》"},"example":{"text":"我终于明白“～”的含义了。"},"similar":["大贤虎变"],"usage":"作宾语、定语；比喻居高位者行动变化莫测"},{"id":13324,"word":"大仁大义","pinyin":"dà rén dà yì","abbr":"drdy","explanation":"形容为人宽厚，尊崇仁义。","source":{"text":"日行十里，不思进取江陵，甘与同败，此也大仁大义也。","book":"明·罗贯中《三国演义》第34回"},"example":{"text":"尤其是赦免勾践的～的决断，全部刻在碑上，叫它与乾坤同存。","book":"郭沫若《胆剑篇》"},"opposite":["不仁不义"],"usage":"作宾语、定语；指仁义"},{"id":13325,"word":"大仁大勇","pinyin":"dà rén dà yǒng","abbr":"drdy","explanation":"形容为人仁义且勇敢。","source":{"text":"在‘大夜弥天’的年代，他本着大仁大勇的精神，肩住了黑暗的闸门，放他们到宽阔光明的地方去。","book":"曹靖华《采得百花酿蜜后》"}},{"id":13326,"word":"大以成大，小以成小","pinyin":"dà yǐ chéng dà，xiǎo yǐ chéng xiǎo","abbr":"dycdxycx","explanation":"大可以成为大的优点，小可以成为小的优点。比喻各有各的好处。","source":{"text":"仲尼，神明也，小以成小，大以成大，虽山川、丘陵、草木、鸟兽，裕如也。","book":"汉·扬雄《法言义疏》卷八"},"example":{"text":"即人人自有，个个圆成，便能～。","book":"明·王阳明《传习录》卷上"}},{"id":13327,"word":"大信不约","pinyin":"dà xìn bù yuē","abbr":"dxby","explanation":"真正讲信义，不在于订约盟誓。","source":{"text":"大道不器，大信不约。","book":"《礼记·学记》"},"similar":["一诺千金"],"usage":"作宾语、定语；用于处事"},{"id":13328,"word":"大做文章","pinyin":"dà zuò wén zhāng","abbr":"dzwz","explanation":"比喻为达到某种目的，在某些问题上横生枝节，或借题发挥，扩大事态。","source":{"text":"前回的一封信，我见过几次转载，有些人还因此大做文章，或毁或誉。","book":"鲁迅《书信集·致李秉中》"},"example":{"text":"他拿此小事～来对付你们。"},"similar":["借题发挥","小题大作","节外生枝"],"opposite":["光明磊落"],"usage":"作谓语、宾语；指借题发挥"},{"id":13329,"word":"大公无私","pinyin":"dà gōng wú sī","abbr":"dgws","explanation":"指办事公正，没有私心。现多指从集体利益出发，毫无个人打算。","source":{"text":"忠者中也，至公无私。","book":"汉·马融《忠经·天地神明》"},"example":{"text":"要把你的志向拿定，而且要抱着一个光明磊落、～的心怀。","book":"郭沫若《屈原》第一幕"},"similar":["舍己为公","铁面无私"],"opposite":["假公济私","自私自利","利欲熏心"],"usage":"作宾语、定语、状语；用于歌颂人的品德","story":["春秋时期，晋平公问大夫祁黄羊谁担任南阳县令合适，祁黄羊推荐解狐，晋平公问他怎么推荐仇人，他说任人唯贤，解狐不负众望。朝廷缺一个军中尉，祁黄羊推荐儿子祁午，祁午也干得相当出色。孔子说祁黄羊推荐人才真是大公无私"]},{"id":13330,"word":"大公至正","pinyin":"dà gōng zhì zhèng","abbr":"dgzz","explanation":"至：最；正：公正。完全秉公办理，毫不偏心。","source":{"text":"来惩办林、邓，表示自己的‘大公至正’。","book":"范文澜《中国近代史》上册第一章"},"similar":["大公无私","大中至正"],"opposite":["自私自利"],"usage":"作宾语、定语；用于处事等"},{"id":13331,"word":"大兴土木","pinyin":"dà xīng tǔ mù","abbr":"dxtm","explanation":"兴：创办；土木：指建筑工程。大规模地盖房子。","source":{"text":"奸佞之臣，罔真宗以符端，大兴土木之役，以为通宫玉清昭应之建。","book":"宋·洪迈《容斋三笔》卷十一"},"example":{"text":"灵王既归，耻其无功，乃～，欲以物力制度，夸示诸侯。","book":"明·冯梦龙《东周列国志》第六十七回"},"similar":["劳民伤财"],"usage":"作谓语、宾语；指大量盖房"},{"id":13332,"word":"大出风头","pinyin":"dà chū fēng tóu","abbr":"dcft","explanation":"指成为舆论注意的中心，出头露面，显示个人的表现。","example":{"text":"他特别爱～。"},"similar":["出尽风头"],"usage":"作谓语、宾语；指人爱表现"},{"id":13333,"word":"大刀阔斧","pinyin":"dà dāo kuò fǔ","abbr":"ddkf","explanation":"原指使用阔大的刀斧砍杀敌人。后比喻办事果断而有魄力。","source":{"text":"当下催军劫寨，大刀阔斧，杀将进去。","book":"明·施耐庵《水浒全传》第一百十八回"},"example":{"text":"世界上原有两种人：一种是～的人，一种是细针密线的人。","book":"朱自清《山野掇拾》"},"similar":["雷厉风行"],"opposite":["束手无策","缩手缩脚"],"usage":"作状语、谓语、定语；指果断迅速","story":["梁山泊好汉晁盖带领17个头领从法场上救下宋江后到白龙庙聚会，放哨的人跑来报告官军大刀阔斧地杀奔祝家庄来。李逵提起双斧就去迎战。晁盖等率众杀得官军尸横遍野、血流成河，直逼江州城下，好汉们才回梁山泊"]},{"id":13334,"word":"大利不利","pinyin":"dà lì ù lì","abbr":"dlbl","explanation":"利：利益。想求大的利益，不能计较眼前的小利益。","source":{"text":"大勇不勇，大利不利。","book":"《六韬·武韬·发启》"}},{"id":13335,"word":"大功告成","pinyin":"dà gōng gào chéng","abbr":"dggc","explanation":"功：事业；告：宣告。指巨大工程或重要任务宣告完成。","source":{"text":"十万众并集，平作二旬，大功毕成。","book":"《尚书·禹贡》：“讫于四海，禹锡玄圭，告厥成功。”《汉书·王莽传上》"},"example":{"text":"及～，天下已定，而后实行其共和主义之政策，恢复我完全之金瓯。","book":"章炳麟《驳革命驳议》"},"similar":["功成名就","功德圆满","旗开得胜"],"opposite":["功亏一篑","功败垂成"],"usage":"作谓语、宾语、定语；指顺利完成","story":["西汉末年，外戚安汉公王莽专权，他模仿周公建造明堂，设立雍灵台，集中天下学者讲学和著作，先后网络了几千人为之著书立说，为他歌功颂德。他下令10万多人为他写颂诗，花了20天时间才大功告成。他的野心越来越大，后来干脆自己称帝"]},{"id":13336,"word":"大功毕成","pinyin":"dà gōng bì chéng","abbr":"dgbc","explanation":"指大工程或大任务宣告完成。同“大功告成”。","source":{"text":"十万众并集，平作二旬，大功毕成。","book":"东汉·班固《汉书·王莽传上》"},"example":{"text":"我们的任务～，该好好庆贺一下。"},"similar":["大功告成"],"opposite":["功败垂成"],"usage":"作谓语、宾语、定语；指顺利完成","story":["西汉末年，外戚安汉公王莽专权，他模仿周公建造明堂，设立雍灵台，集中天下学者讲学和著作，先后网络了几千人为之著书立说，为他歌功颂德。他下令10万多人为他写颂诗，花了20天时间才大功告成。他的野心越来越大，后来干脆自己称帝"]},{"id":13337,"word":"大动公惯","pinyin":"dà dòng gōng guàn","abbr":"ddgg","explanation":"形容公众愤然而出，主持正义。","example":{"text":"恐怖分子的罪恶行径，使全世界爱好和平人士～，同声谴责。"}},{"id":13338,"word":"大动干戈","pinyin":"dà dòng gān gē","abbr":"ddgg","explanation":"干戈：古代的两种武器。大规模地进行战争。比喻大张声势地行事。","source":{"text":"邦分崩离析，而不能守业；而谋动干戈于邦内。","book":"《论语·季氏》"},"example":{"text":"刚才唐兄说国王必是暂缓吉期，那知全出乎意料之外，并且～，用兵征剿。","book":"清·李汝珍《镜花缘》第三十五回"},"similar":["大打出手","兴师动众","大张旗鼓"],"opposite":["鸣金收兵","偃旗息鼓"],"usage":"作谓语、定语、状语；比喻大张声势地"},{"id":13339,"word":"大动肝火","pinyin":"dà dòng gān huǒ","abbr":"ddgh","explanation":"指大怒。","source":{"text":"毛虎听了，不觉大动肝火。","book":"清·无垢道人《八仙全传》第一回"},"example":{"text":"见到不务正业的他，父亲一定大动肝火。"},"similar":["大发雷霆"],"opposite":["和风细雨","和蔼可亲"],"usage":"作谓语、定语；指发怒"},{"id":13340,"word":"大势已去","pinyin":"dà shì yǐ qù","abbr":"dsyq","explanation":"大势：事情发展的趋势。有利的形势已经丧失，前途已经没有希望。","source":{"text":"程子说天命之改，莫是大势已去。","book":"宋·朱熹《朱子谏类》卷五十一"},"example":{"text":"纣王看见，不觉大惊，知～，非人力可挽。","book":"明·许仲琳《封神演义》第九十七回"},"similar":["强弩之末","落花流水","每况愈下"],"opposite":["方兴未艾","如火如荼","欣欣向荣"],"usage":"作谓语、宾语；指前途已经没有希望"},{"id":13341,"word":"大势所趋","pinyin":"dà shì suǒ qū","abbr":"dssq","explanation":"大势：指整个局势。整个局势发展的趋向。","source":{"text":"天下大势之所趋，非人力之所能移也。","book":"宋·陈亮《上孝宗皇帝第三书》"},"example":{"text":"解放区人民的力量，大后方人民的力量，国际形势，～，使得国民党不得不承认这些东西。","book":"毛泽东《关于重庆谈判》"},"similar":["势在必行","势不可挡","一往无前"],"usage":"作宾语、分句；用于判断语句"},{"id":13342,"word":"大勇若怯","pinyin":"dà yǒng ruò qiè","abbr":"dyrq","explanation":"怯：怯儒。最勇敢的人看外表好像很胆怯的样子。形容真正勇敢的人沉着冷静。","source":{"text":"力辞于未及之年，退托以不能而止，大勇若怯，大智如愚，至贵无轩冕而荣，至仁不导引而寿。","book":"宋·苏轼《贺欧阳少师致仕启》"},"example":{"text":"大智若愚，～，不是要埋冤他，正深爱着他，要他藏锋敛锷，以成大器。","book":"清·夏敬渠《野叟曝言》第十三回"},"similar":["大智若愚"],"usage":"作谓语、宾语、定语；用于为人"},{"id":13343,"word":"大包大揽","pinyin":"dà bāo dà lǎn","abbr":"dbdl","explanation":"把事情全部包下来。也表示有把握，负得起责任。","source":{"text":"樊指导拍拍我的肩，大包大揽地说：‘你就放心吧，保险不会出错。’","book":"王文《樊家窑的石雷阵》"},"example":{"text":"他又在～了。"},"usage":"作谓语、宾语；指全包"},{"id":13344,"word":"大化有四","pinyin":"dà huà yǒu sì","abbr":"dhys","explanation":"化：变化。人生的最大变化有四个，即人生的婴儿、少壮、老年和死亡。","source":{"text":"人生生至终，大化有四：婴孩也，少壮也，老耆也，死亡也。","book":"《列子·无瑞》"}},{"id":13345,"word":"大匠不斫","pinyin":"dà jiàng bù zhuó","abbr":"djbz","explanation":"斫：砍削。高明的匠人不用斧头砍削。比喻居高位者不逞小智，不代下司职。","source":{"text":"处大官者，不欲小察，不欲小智。故曰：‘大匠不斫，大庖不豆，大勇不计，大兵不寇。’","book":"《吕氏春秋·贵公》"},"usage":"作宾语、定语；用于处事"},{"id":13346,"word":"大匠能与人规矩，不能使人巧","pinyin":"dà jiàng néng yǔ rén guī jǔ,bù néng shǐ rén qiǎo","abbr":"djnyrgjbnsrq","explanation":"大匠：指在某方面造诣高的人；巧：灵巧。高明的匠人只能教人规矩，不能使人心灵手巧。指必须要主观努力，不能单依靠客观条件。","source":{"text":"梓匠轮舆能与人规矩，不能使人巧。","book":"战国·邹·孟轲《孟子·尽心》"},"example":{"text":"～也。其所能者，人也；所不能者，天也。","book":"明·王骥德《曲律·杂论》"},"usage":"作宾语、定语；用于劝诫人"},{"id":13347,"word":"大匠运斤","pinyin":"dà jiàng yùn jīn","abbr":"djyj","explanation":"比喻人技艺精湛或文笔娴熟高超。","source":{"text":"郢人垩漫其鼻端，若蝇翼，使匠石斫之，匠石运斤成风，听而斫之，尽垩而鼻不伤，郢人立不失容。","book":"语出《庄子·徐无鬼》"},"example":{"text":"东坡尝曰：‘渊明诗初看若散缓，熟看有奇句……似～，不见斧凿之痕。","book":"宋·惠洪《冷斋夜话》卷一"},"similar":["郢人运斤"],"usage":"作宾语、定语；用于技艺等"},{"id":13348,"word":"大千世界","pinyin":"dà qiān shì jiè","abbr":"dqsj","explanation":"佛教用语，世界的千倍叫小千世界，小千世界的千倍叫中千世界，中千世界的千倍叫大千世界。后指广大无边的人世。","source":{"text":"长老身材勿量大，笠子太小生。师云：‘虽然如此大千世界总在里许。’","book":"宋·释道原《景德传灯录》卷九"},"example":{"text":"～无奇不有，充满了矛盾。"},"similar":["芸芸众生"],"usage":"作主语、定语；指广大无边的世界"},{"id":13349,"word":"大卸八块","pinyin":"dà xiè bā kuài","abbr":"dxbk","explanation":"指把完整的事物分成若干小块。","source":{"text":"连集体的手扶拖拉机都大卸八块，像分猪肉一样，一人一块扛走了。","book":"路遥《平凡的世界》第三卷第11章"},"example":{"text":"路遥《平凡的世界》第三卷第11章：“连集体的手扶拖拉机都～，像分猪肉一样，一人一块扛走了。”"},"similar":["四分五裂"],"usage":"作谓语、定语、状语；用于口语"},{"id":13350,"word":"大厦将倾","pinyin":"dà shà jiāng qīng","abbr":"dsjq","explanation":"高楼大屋，眼看就要倒了。比喻即将来临的崩溃局势。","source":{"text":"大厦将颠，非一木所支也。","book":"《文中子·事君》"},"example":{"text":"其实，这也难怪，～，独木难支，谁又不是这样？","book":"罗广斌、杨益言《红岩》"},"similar":["大厦将颠","危在旦夕"],"opposite":["国运昌盛","稳如泰山","坚不可摧"],"usage":"作宾语、定语；指即将崩溃"},{"id":13351,"word":"大厦将颠","pinyin":"dà shà jiāng diān","abbr":"dsjd","explanation":"比喻情势危急，频临崩溃。","source":{"text":"［文中子］退而谓董常曰：‘大厦将颠，非一木所支也。’","book":"隋·王通《中说·事君》"},"example":{"text":"非我独清缘世浊，此心论证识只天知。万牛回首须公起，～要力持。","book":"明·瞿佑《归田诗话·泸溪送澹庵》"},"similar":["大厦将倾"],"usage":"作宾语、定语；指即将崩溃"},{"id":13352,"word":"大厦栋梁","pinyin":"dà shà dòng liáng","abbr":"dsdl","explanation":"比喻担负国家重任的人才。","source":{"text":"太傅从事中郎庾顗见而叹曰：‘峤森森如千丈松，虽磥砢多节目，施之大厦，有栋梁之用。’","book":"《晋书·和峤传》"},"example":{"text":"他有～之才。"},"similar":["栋梁之材","中流砥柱"],"usage":"作宾语、定语；指重要人物"},{"id":13353,"word":"大发慈悲","pinyin":"dà fā cí bēi","abbr":"dfcb","explanation":"慈悲：慈善和怜悯。比喻起善心，做好事。","source":{"text":"伏望母亲大人，大发慈悲，优容苦志。","book":"明·冯梦龙《喻世明言》卷三十七"},"example":{"text":"他说三天之内，照着祖爷爷的吩咐送过来。请祖爷爷～，代他们打点打点！（清·吴趼人《二十年目睹之怪现状》第九十二回）"},"similar":["慈悲为怀"],"usage":"作谓语、宾语；指有怜悯之心"},{"id":13354,"word":"大发横财","pinyin":"dà fā héng cái","abbr":"dfhc","explanation":"横：意外的。用非法的手段谋取大量钱财。有时也指意外地发了财。","source":{"text":"而后方之达官资本家，于政府无所贡献，且趁火打劫，大发横财，忍心害理，敦甚于此。","book":"邹韬奋《抗战以来·万方感念马寅初先生》"}},{"id":13355,"word":"大发议论","pinyin":"dà fā yì lùn","abbr":"dfyl","explanation":"发：表达，传达。尽情地发表各种意见和评论。","source":{"text":"文琴便扯天扯地的大谈起来，一会儿大发议论，一会儿又竭力恭维。","book":"清·吴趼人《二十年目睹之怪现状》第76回"},"example":{"text":"他总喜欢在别人面前～。"},"similar":["牢骚满腹","大放厥词"],"opposite":["缄口不言"],"usage":"作谓语、宾语；指评论"},{"id":13356,"word":"大发谬论","pinyin":"dà fā miù lùn","abbr":"dfml","explanation":"指空泛不切合实际的言论。","example":{"text":"发表意见之前须对事情的真实情况先有所了解，不可一只半解便～，否则必将遭人耻笑。"}},{"id":13357,"word":"大发雷霆","pinyin":"dà fā léi tíng","abbr":"dflt","explanation":"霆：极响的雷，比喻震怒。比喻大发脾气，大声斥责。","source":{"text":"今不忍小忿而发雷霆之怒。","book":"《三国志·吴书·陆逊传》"},"example":{"text":"不知说了一句甚么话，符老爷登时～起来，把那独脚桌子一掀。(清·吴趼人《二十年目睹之怪现状》第七十四回)"},"similar":["勃然大怒","暴跳如雷","怒形于色"],"opposite":["平心静气","心平气和","和颜悦色"],"usage":"作谓语、定语、状语；指大发脾气，大声斥责","story":["公元229年，孙权称帝，国号吴，建都建业。魏国辽东太守公孙渊想与东吴结成同盟。孙权封他为燕王，没想到公孙渊出尔反尔，杀了吴国派去的使臣。孙权听后大发雷霆，准备出兵渡海讨伐公孙渊，被大将陆逊等劝止"]},{"id":13358,"word":"大受小知","pinyin":"dà shòu xiǎo zhī","abbr":"dsxz","explanation":"大受：委以重任，这里指能承担重任的人；小知：让他办不重要的事。形容大材小用。","source":{"text":"君子不可小知，而可大受也；小人不可大受，而可小知也。","book":"《论语·卫灵公》"}},{"id":13359,"word":"大可不必","pinyin":"dà kě bù bì","abbr":"dkbb","explanation":"完全没有必要。","source":{"text":"如今要再去学那下马冯妇，也就似乎大可不必了。","book":"清·文康《儿女英雄传》第33回"},"example":{"text":"可是你打算特约人来投稿，我以为～。","book":"茅盾《追求》"},"opposite":["势在必行"],"usage":"作谓语、宾语；用于处事观念"},{"id":13360,"word":"大可师法","pinyin":"dà kě shī fǎ","abbr":"dksf","explanation":"师法：学习效法。值得学习和效法。","source":{"text":"这举动虽然难免有些发疯嫌疑，然而在现在是大可师法的办法。","book":"鲁迅《书信集·致孙伏园》"}},{"id":13361,"word":"大吃一惊","pinyin":"dà chī yī jīng","abbr":"dcyj","explanation":"形容对发生的事感到十分意外。","source":{"text":"则一张那员外大吃一惊，回身便走，来到后边，望后倒了。","book":"明·冯梦龙《警世通言》第28卷"},"example":{"text":"那个朋友和他再次见面，不禁～。","book":"巴金《等着盼着》"},"similar":["惊诧万分","大惊失色"],"opposite":["心平气和","和颜悦色"],"usage":"作谓语、宾语；形容非常吃惊"},{"id":13362,"word":"大吃大喝","pinyin":"dà chī dà hē","abbr":"dcdh","explanation":"狼吞虎咽地吃。指没有节制，没有计划地吃喝。指进行大规模、高档次的吃喝活动。","source":{"text":"不耐烦和群众在一块作艰苦的斗争，只希望跑到大城市去大吃大喝。","book":"毛泽东《关于纠正党内的错误思想》"},"example":{"text":"他上馆子，下酒铺，从不敢～，大手大脚，颇为紧吃慢用，细水长流。","book":"古华《芙蓉镇》"},"similar":["海吃海喝","狂饮暴食"],"opposite":["忍饥挨饿"],"usage":"作主语、宾语；指吃喝过量"},{"id":13363,"word":"大吆小喝","pinyin":"dà yāo xiǎo hē","abbr":"dyxh","explanation":"大声喊叫、谩骂。","source":{"text":"来兴儿道：‘别无甚事，叵耐来旺儿，昨日不知那里吃的醉稀稀的，在前边大吆小喝，指猪骂狗，骂了一日。’","book":"明·兰陵笑笑生《金瓶梅词话》第二十五回"},"example":{"text":"何苦自己不尊重，～，失了体统。","book":"清·曹雪芹《红楼梦》第六十回"}},{"id":13364,"word":"大吉大利","pinyin":"dà jí dà lì","abbr":"djdl","explanation":"非常吉祥、顺利。旧时用于占卜和祝福。","source":{"text":"孔明曰：‘来意亮已知道了。适间卜《易》，得一大吉大利之兆。","book":"明·罗贯中《三国演义》第五十四回"},"example":{"text":"批八字的说这门亲事～，所以外婆也赞成了。","book":"巴金《秋》"},"similar":["福星高照"],"opposite":["大灾大难"],"usage":"作谓语、定语、宾语；用于祝福语"},{"id":13365,"word":"大同境域","pinyin":"dà tóng jìng yù","abbr":"dtjy","explanation":"古代儒家宣扬的“人人为公”的理想社会。也指共产主义社会。","source":{"text":"是故谋闭而不兴，盗窃乱贼而不作，故外户而不闭，是谓大同。","book":"西汉·戴圣《礼记·礼运》"},"example":{"text":"使人类进到～。","book":"毛泽东《论人民民主专政》"},"similar":["共产主义"],"usage":"作宾语、定语；用于书面语"},{"id":13366,"word":"大同小异","pinyin":"dà tóng xiǎo yì","abbr":"dtxy","explanation":"大体相同，略有差异。","source":{"text":"大同而与小同异，此之谓小同异；万物毕同毕异，此之谓大同异。","book":"《庄子·天下》"},"example":{"text":"说的是侯统领一个，其实如今做官的人，无非与侯统领～罢了。","book":"清·吴趼人《二十年目睹之怪现状》第八十四回"},"similar":["一模一样","神肖酷似"],"opposite":["迥然不同","大相径庭"],"usage":"作谓语、定语；用于比较"},{"id":13367,"word":"大名难居","pinyin":"dà míng nán jū","abbr":"dmnj","explanation":"指盛名之下不易自处","source":{"text":"句践以霸，而范蠡称上将军。还反国，范蠡以为大名之下，难以久居……乃装其轻宝珠玉，自与其私徒属乘舟浮海以行。","book":"《史记·越王勾践世家》"},"example":{"text":"所谓～，硕果不食。","book":"唐·李白《泽畔令序》"},"usage":"作宾语、定语；用于名人"},{"id":13368,"word":"大名鼎鼎","pinyin":"dà míng dǐng dǐng","abbr":"dmdd","explanation":"鼎鼎：盛大的样子。形容名气很大。","source":{"text":"你一到京打听人家，像他这样大名鼎鼎，还怕有不晓得的。","book":"清·李宝嘉《官场现形记》第二十四回"},"example":{"text":"当时有华灵毡士者，～之学者。","book":"清·梁启超《格致学沿革考略》"},"similar":["赫赫有名","名扬天下","举世闻名"],"opposite":["无名鼠辈","无声无息","默默无闻"],"usage":"作谓语、定语；用于人和事物"},{"id":13369,"word":"大含细入","pinyin":"dà hán xì rù","abbr":"dhxr","explanation":"原指文章的内容，既包涵天地的元气，又概括了极微小的事物。形容文章博大精深。","source":{"text":"大者含元气，细者入无间。","book":"汉·扬雄《解嘲》"},"example":{"text":"夫先生之诗，～，无所不包。","book":"清·俞兆晟《渔洋诗话序》"},"usage":"作谓语、宾语；用于文章等"},{"id":13370,"word":"大吵大闹","pinyin":"dà chǎo dà nào","abbr":"dcdn","explanation":"激烈地争吵。指争论各方并无严重分歧而进行毫无秩序的争吵骚动。","source":{"text":"正吃得香甜时，忽听得门口大吵大闹起来，仓樵脸上忽红忽白。","book":"曾朴《孽海花》第五回"},"example":{"text":"为一点小事，小夫妻就～。"},"similar":["吵吵闹闹"],"opposite":["和平共处"],"usage":"作谓语、宾语；指争吵"},{"id":13371,"word":"大吹大打","pinyin":"dà chuī dà dǎ","abbr":"dcdd","explanation":"指鼓乐齐作。","source":{"text":"文武多官，满城百姓，伏龙寺僧人，大吹大打，送四众出城。","book":"《西游记》第六四回"},"example":{"text":"他媳妇也是个翰林的女儿，万家费了几千两银子娶进来，那日～执事灯笼摆了斗街，好不热闹。","book":"《儒林外史》第二三回"},"similar":["吹吹打打","锣鼓喧天"],"usage":"作谓语、宾语、定语、状语；用于场面"},{"id":13372,"word":"大吹大擂","pinyin":"dà chuī dà léi","abbr":"dcdl","explanation":"许多乐器同时吹打。比喻大肆宣扬。","source":{"text":"赐你黄金千两，香酒百瓶，就在丽春堂大吹大擂，做一个庆喜的筵席。","book":"元·王实甫《丽春堂》第四折"},"example":{"text":"许禇方欲前进，只听得山上～。","book":"明·罗贯中《三国演义》第四十回"},"similar":["自吹自擂","言过其实","夸夸其谈"],"opposite":["脚踏实地","实事求是","言行一致"],"usage":"作谓语、宾语、状语；指吹嘘自己","story":["梁山泊好汉晁盖、公孙胜、阮小二等七人智取生辰纲，并在石碣村活捉了观察何涛，并消灭了他的兵卒，割下他的两只耳朵，放他回去报信。好汉们离开石碣村，来到梁山泊山寨。山寨里宰杀牛羊，大吹大擂地摆筵席以庆功"]},{"id":13373,"word":"大吹法螺","pinyin":"dà chuī fǎ luó","abbr":"dcfl","explanation":"原指佛家讲经说法时要吹法螺。后比喻空口说大话。","source":{"text":"吹大法螺，击大法鼓，燃大法炬，雨胜法雨。","book":"《金光明经·赞叹品》"},"example":{"text":"于是在端王前～，硬说他曾在陈国瑞军营打过前敌。","book":"《庚子事变》"},"similar":["吹大法螺"],"usage":"作谓语、状语；指说大话"},{"id":13374,"word":"大吼大叫","pinyin":"dà hǒu dà jiào","abbr":"dhdj","explanation":"大声喊叫。","example":{"text":"请保持安静，不要～。"},"similar":["大喊大叫"],"opposite":["轻言细语"],"usage":"作谓语、状语；指叫嚷"},{"id":13375,"word":"大呼小叫","pinyin":"dà hū xiǎo jiào","abbr":"dhxj","explanation":"高一声低一声地乱叫乱喊。","source":{"text":"是什么人在门口大呼小叫，我去看咱。","book":"元·无名氏《谢金吾》"},"example":{"text":"擎火把的都是年轻的农民，另一只手提着枪，也有拿镐的，～的嚷嚷着。","book":"杨朔《雪花飘飘》"},"similar":["大喊大叫","大吵大闹"],"opposite":["无声无息","消声匿迹"],"usage":"作谓语、状语、定语；用于不懂礼貌"},{"id":13376,"word":"大呼小喝","pinyin":"dà hū xiǎo hē","abbr":"dhxh","explanation":"高一声低一声地乱叫乱喊。同“大呼小叫”。","source":{"text":"武松答应道：‘老爷在这里，又不走了，大呼小喝做甚么？’","book":"《水浒传》第二八回"},"similar":["大呼小叫"],"opposite":["轻言细语"],"usage":"作谓语、状语、补语；用于不懂礼貌"},{"id":13377,"word":"大命将泛","pinyin":"dà mìng jiāng fěng","abbr":"dmjf","explanation":"大命：国家命运；泛：倾覆，毁灭。形容国家将要灭亡。","source":{"text":"残贼公行，莫之或止；大命将泛，莫之振救。","book":"汉·贾谊《论积贮疏》"},"usage":"作宾语、定语；指将要亡国等"},{"id":13378,"word":"大哄大嗡","pinyin":"dà hōng dà wēng","abbr":"dhdw","explanation":"形容动员众多的人一哄而起去作一件事，实际效果并不好。","example":{"text":"有些人做事喜欢～，但往往办不好事情。"},"similar":["大轰大嗡"],"usage":"作宾语、状语；用于处事"},{"id":13379,"word":"大喊大叫","pinyin":"dà hǎn dà jiào","abbr":"dhdj","explanation":"大声叫嚷，形容大肆宣传，大造舆论。","source":{"text":"吴毓鳞首先大喊大叫，‘内阁不能统一，我们不如及早下台。’","book":"陶菊隐《北洋军阀统治时期史话》第59章"},"example":{"text":"他急得～。"},"similar":["大呼小叫","大喊大吼"],"opposite":["无声无息"],"usage":"作谓语、状语；指叫嚷"},{"id":13380,"word":"大喊大吼","pinyin":"dà hǎn dà hǒu","abbr":"dhdh","explanation":"大声叫嚷，形容大肆宣传，大造舆论。","source":{"text":"不是巩固这几年大喊大吼的东西，而是巩固原来长期积累下来的好经验、好作风、好做法。","book":"邓小平《重要的是做好经常工作》"},"similar":["大喊大叫"],"usage":"作谓语、定语、状语；指叫嚷"},{"id":13381,"word":"大喜若狂","pinyin":"dā xǐ ruò kuáng","abbr":"dxrk","explanation":"高兴得几乎发狂。","example":{"text":"没想到，我竟被全国数一数二的大公司录用，真是～。"}},{"id":13382,"word":"大喜过望","pinyin":"dà xǐ guò wàng","abbr":"dxgw","explanation":"过：超过；望：希望。结果比原来希望的还好，因而感到特别高兴。","source":{"text":"出就舍，张御食饮从官如汉王居，布又大喜过望。","book":"《史记·黥布传》"},"example":{"text":"灿若灯下一看，正是前日相逢之人，不觉～，方才放下了心。","book":"明·凌濛初《初刻拍案惊奇》卷十六"},"similar":["喜出望外","喜从天降"],"opposite":["大失所望","大失人望"],"usage":"作谓语、定语、状语；指特别高兴","story":["楚汉相争时，黥布（英布）被西楚霸王项羽封为九江王，因一次战败被项羽革去爵位，隋何奉刘邦的命令去劝降黥布。黥布反戈一击，被项羽打败，只身投奔刘邦，刘邦在洗脚时接见他，他感到后悔投奔，可回到住处，待遇同刘邦完全相同"]},{"id":13383,"word":"大喝一声","pinyin":"dà hè yī shēng","abbr":"dhys","explanation":"喝：大声喊叫。大叫让对方震惊或猛醒。","source":{"text":"那旗人大喝一声道：‘滚你的吧！这里又没有谁给我借钱，要你来装这些穷话做甚么！’","book":"清·吴趼人《二十年目睹之怪现状》第六回"},"example":{"text":"就是重重地给患病者一个刺激，向他们～，说：‘你有病呀！’使患者为之一惊，出一身汗，然后好好地叫他们治疗","book":"毛泽东《反对党八股》"},"similar":["当头棒喝"],"usage":"作谓语、状语；用于表警告"},{"id":13384,"word":"大器晚成","pinyin":"dà qì wǎn chéng","abbr":"dqwc","explanation":"大器：比喻大才。指能担当重任的人物要经过长期的锻炼，所以成就较晚。也用做对长期不得志的人的安慰话。","source":{"text":"大方无隅，大器晚成。","book":"《老子》四十二章"},"example":{"text":"二位先生高才久屈，将来定是～的。","book":"清·吴敬梓《儒林外史》第四十九回"},"similar":["后生可畏"],"opposite":["不堪造就","冥顽不灵"],"usage":"作谓语、宾语、定语；指年纪大才成才","story":["东汉末年，袁绍的门客崔琰，23岁才开始读《论语》、《韩诗》，学成为袁绍出了不少好主意，袁绍兵败。崔琰投奔曹操，身为尚书，不因亲戚关系而反对立曹植为太子，别人看不起他的堂弟崔林，他认为成大器的人一般要更长的时间磨炼"]},{"id":13385,"word":"大地回春","pinyin":"dà dì huí chūn","abbr":"ddhc","explanation":"指冬去春来，草木萌生，大地上出现一片生机景象。有时亦用比喻形势好转。","source":{"text":"树头雪过梅犹在，地上春回柳未知。","book":"宋·周紫芝《太仓稊米集·岁杪雨雪连日闷题二首》"},"example":{"text":"阴历正月初三日立春，当时有～，万象更新之义，故诹吉于初四日。","book":"蔡东藩、许廑父《民国通俗演义》第六十二回夹注"},"similar":["大地春回"],"usage":"作宾语、定语；比喻形势好转"},{"id":13386,"word":"大地春回","pinyin":"dà dì chūn huí","abbr":"ddch","explanation":"指冬去春来，草木萌生，大地上出现一片生机景象。有时亦用比喻形势好转。","source":{"text":"楼三室的对联，引用了古人的诗句：‘满园春色关不住，一枝红杏出墙头。’横额是：‘大地春回’。","book":"罗广斌、杨益言《红岩》第十六章"},"similar":["大地回春"],"usage":"作宾语、定语；比喻形势好转"},{"id":13387,"word":"大块文章","pinyin":"dà kuài wén zhāng","abbr":"dkwz","explanation":"大块：大地。原指大自然锦绣般美好的景色。后用以称赞别人内容丰富的长篇文章。","source":{"text":"况阳春召我以烟景，大块假我以文章。","book":"唐·李白《春夜宴从弟桃李园序》"},"example":{"text":"眉山苍苍，～，兽纽头，篆鸟迹，中空无物，何止容卿辈数十。","book":"清·黄景仁《砚铭》"},"similar":["长篇大论","鸿篇巨制","洋洋万言"],"opposite":["言简意赅","要言不繁"],"usage":"作宾语；指作文"},{"id":13388,"word":"大块朵颐","pinyin":"dà kuài duǒ yí","abbr":"dkdy","explanation":"朵颐：鼓动腮颊，即大吃大嚼。痛痛快快地大吃一顿。","source":{"text":"观我朵颐，凶。","book":"《周易·颐》"},"example":{"text":"王朔《顽主》：“你以为老外们一天到晚在干吗？不就蹩着到咱们中国来～。”"},"similar":["大吃大喝","穷奢极侈","食前方丈"],"opposite":["节衣缩食","粗茶淡饭","食淡衣粗"],"usage":"作谓语、定语；指吃喝"},{"id":13389,"word":"大坰之惭","pinyin":"dà jiòng zhī cán","abbr":"djzc","explanation":"大坰：地名。相传汤即五位，迁九鼎于亳都，至大坰，终感以臣伐君，而有惭德。后指因篡位改朝而有愧心。","source":{"text":"革宋受天，保生万国。《度邑》静鹿丘之叹，迁鼎息大坰之惭。","book":"坍塌·齐·王融《三月三日曲水诗序》"}},{"id":13390,"word":"大声疾呼","pinyin":"dà shēng jí hū","abbr":"dsjh","explanation":"疾：快。大声呼喊，引起人们注意。","source":{"text":"行且不息，以蹈于穷饿之水火，其既危且亟矣，大其声而疾呼矣。","book":"唐·韩愈《后十九日复上宰相书》"},"example":{"text":"我们可以～，而不要隐晦曲折，使人民大众不易看懂。","book":"毛泽东《在延安文艺座谈会上的讲话》"},"similar":["大喊大叫","摇唇鼓舌"],"opposite":["默不做声"],"usage":"作谓语、定语、状语；指引起人们注意","story":["唐朝时期，著名文学家韩愈25岁中进士，到了28岁还没有官职。他便写信给宰相赵憬，希望能得到任用。等了19天还没有音信，就又写《后十九日复上宰相书》，他在信中大声疾呼朝廷应像救水火之灾那样来援救和任用那些有才学而面临困境的人"]},{"id":13391,"word":"大处着墨","pinyin":"dà chù zhuó mò","abbr":"dczm","explanation":"原指画画或写文章要在主要部分下功夫。比喻做事从大处着眼。","source":{"text":"你老哥也算得会用的了，真正阔手笔！看你不出，倒是个大处落墨的！","book":"清·李宝嘉《官场现形记》第二十回"},"similar":["大处落墨"],"opposite":["舍本逐末"],"usage":"作谓语、宾语、定语；比喻做事先解决关键"},{"id":13392,"word":"大处着眼","pinyin":"dà chù zhuó yǎn","abbr":"dczy","explanation":"从大的方面观察、思考问题，抓住主要矛盾。","source":{"text":"只感念姑娘救了自己的儿子，延了安家的宗祀，大处着眼，便不忍吹求到此。","book":"清·文康《儿女英雄传》第二十五回"},"example":{"text":"嘁嘁嚓嚓，招生是非，搬弄口舌，决不在～。","book":"鲁迅《且介亭杂文末编·答徐懋庸并关于抗日统一战线问题》"},"similar":["大处落墨"],"opposite":["小处着手","斤斤计较"],"usage":"作谓语、定语；常与“小处着手”连用"},{"id":13393,"word":"大处着眼，小处着手","pinyin":"dà chù zhuó yǎn，xiǎo chù zhuó shǒu","abbr":"dczyxczs","explanation":"从大的目标去观察，从小的地方去动手。比喻既要从全局和长远的观点出发去考虑问题，也要在具体事情上一件件地做好。","source":{"text":"只感念姑娘救了自己的儿子，延了安家的宗祀，大处着眼，便不忍吹求到此。","book":"清·文康《儿女英雄传》第二十五回"},"example":{"text":"移风易俗，是一个历史时期的任务，必须～。","book":"李欣《潜移默化》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":13394,"word":"大处落墨","pinyin":"dà chù luò mò","abbr":"dclm","explanation":"落墨：落笔。原指画画或写文章要在主要部分下功夫。比喻做事从大处着眼。","source":{"text":"你老哥也算得会用的了，真正阔手笔！看你不出，倒是个大处落墨的！","book":"清·李宝嘉《官场现形记》第二十回"},"example":{"text":"批评者的眼界是小的，所以他不能在～。","book":"鲁迅《书信集·致徐懋庸》"},"similar":["大处着眼","大处落笔"],"opposite":["轻重倒置","小题大作","舍本逐末"],"usage":"作谓语、宾语、定语；比喻做事先解决关键"},{"id":13395,"word":"大夜弥天","pinyin":"dà yè mí tiān","abbr":"dymt","explanation":"弥天：满天。比喻黑暗势力弥漫长空，统治一切。","source":{"text":"时大夜弥天，璧月澄照，饕蚊遥叹，余在广州。","book":"鲁迅《序例》"},"similar":["暗无天日"],"usage":"作宾语、定语；用于比喻句"},{"id":13396,"word":"大大咧咧","pinyin":"dà dà liē liē","abbr":"ddll","explanation":"形容待人处事随随便便，满不在乎。","source":{"text":"忽见由南往北来了数十头牛，大大咧咧地赶着牛，牛上骑着三个小孩子。","book":"清·石玉昆《小五义》第103回"},"example":{"text":"他就是大大咧咧的性格。"},"similar":["马马虎虎"],"opposite":["认认真真","一丝不苟"],"usage":"作谓语、状语、定语；指人随便"},{"id":13397,"word":"大大小小","pinyin":"dà dà xiǎo xiǎo","abbr":"ddxx","explanation":"指大小人物或事物等。","source":{"text":"党应用最大努力去培养大大小小的群众领袖，要知道群众领袖是最值得珍贵的。","book":"邓小平《根据地建设与群众运动》"},"example":{"text":"邓小平《根据地建设与群众运动》：“党应用最大努力去培养～的群众领袖，要知道群众领袖是最值得珍贵的。”"},"similar":["老老少少"],"usage":"作主语、宾语、定语；用于人或事物等"},{"id":13398,"word":"大大方方","pinyin":"dà dà fāng fāng","abbr":"ddff","explanation":"指人的行为举止自然不俗气。","source":{"text":"所以他们但凡吃物，不肯大大方方，总是贼头贼脑，躲躲藏藏，背人而食。","book":"清·李汝珍《镜花缘》第14回"},"example":{"text":"他渐渐抛弃了这种虚荣或者说自卑，～站在队列中取他的饭。","book":"路遥《平凡的世界》第一卷第25章"},"opposite":["鬼鬼祟祟"],"usage":"作谓语、定语、状语；用于处事"},{"id":13399,"word":"大大法法","pinyin":"dà dà fǎ fǎ","abbr":"ddff","explanation":"高大魁梧的样子。","source":{"text":"那赵杏川大大法法的个身材，紫膛色，有几个麻子，三花黑须，寡言和色。","book":"清·西周生《醒世姻缘传》第六十七回"}},{"id":13400,"word":"大大落落","pinyin":"dà dà luō luō","abbr":"ddll","explanation":"形容态度大方。亦形容随随便便，满不在乎。","source":{"text":"不能大大落落的，一定得认真负责，多向支部汇报，争取帮助。","book":"李准《两代人》三"},"similar":["大大咧咧"],"opposite":["一丝不苟"],"usage":"作谓语、定语、状语；用于处事"},{"id":13401,"word":"大天白日","pinyin":"dà tiān bái rì","abbr":"dtbr","explanation":"白天。强调跟暮夜黑暗对照。","source":{"text":"大天白日人来人往，你就在这里也不方便。","book":"清·曹雪芹《红楼梦》第12回"},"example":{"text":"他居然在～下干坏事。"},"similar":["青天白日"],"opposite":["三更半夜"],"usage":"作主语、宾语；指大白天"},{"id":13402,"word":"大失人望","pinyin":"dà shī rén wàng","abbr":"dsrw","explanation":"指在群众中严重丧失威望，威信扫地。","source":{"text":"秦人大失望。","book":"《史记·高祖本记》"}},{"id":13403,"word":"大失所望","pinyin":"dà shī suǒ wàng","abbr":"dssw","explanation":"表示原来的希望完全落空。","source":{"text":"秦人大失望。","book":"《史记·高祖本记》"},"example":{"text":"瑞虹～，但到此地间，无可奈何。","book":"明·冯梦龙《醒世恒言》卷三十六"},"similar":["大失人望","事与愿违"],"opposite":["大喜过望","喜出望外","如愿以偿"],"usage":"作谓语、定语、状语；用于对人、事、物","story":["五代时期，后晋大将李守贞兵败投降契丹，迫于晋高祖的压力又归顺后晋。他变本加厉，暗中收买权臣，扩充军队，在一个小和尚的鼓动下彻底亮出了反旗，朝廷派白文珂带兵前去讨伐，被收买的那些将领根本不卖李守贞的帐，让他大失所望"]},{"id":13404,"word":"大头小尾","pinyin":"dà tóu xiǎo wěi","abbr":"dtxw","explanation":"犹“虎头蛇尾”。比喻做事前紧后松，有始无终。","source":{"text":"这是中国官场办事一向大头小尾惯的，并不是做书的人先详后略，有始无终也。","book":"清·李宝嘉《官场现形记》第33回"},"example":{"text":"做任何事情都不能～，搞花架子。"},"similar":["虎头蛇尾"],"opposite":["有始有终"],"usage":"作谓语、宾语；指没有结局"},{"id":13405,"word":"大奸似忠","pinyin":"dà jiān sì zhōng","abbr":"djsz","explanation":"内心最奸诈的人，表面最像忠厚的人。","source":{"text":"吕诲之言曰：‘大奸似忠，外似朴野，中藏巧诈。’","book":"宋·邵博《闻见后录》卷二十三"},"example":{"text":"刑余之人，其情幽阴，其虑险谲，～，大诈似信，大巧假愚。","book":"《明史·黄泽传》"},"similar":["大诈似信"],"usage":"作宾语、定语；用于为人"},{"id":13406,"word":"大奸极恶","pinyin":"dà jiān jí è","abbr":"djje","explanation":"指极为奸诈且作恶多端的坏人。","source":{"text":"而大奸极恶之人行事背理，亦不消说得。","book":"清·褚人获《隋唐演义》第79回"},"similar":["大奸大恶"],"usage":"作主语、宾语、定语；指坏人"},{"id":13407,"word":"大好山河","pinyin":"dà hǎo shān hé","abbr":"dhsh","explanation":"山河：指国土。无限美好的祖国国土。","source":{"text":"云山万里，遥望祖国的大好山河，被国民党反动派统治的黑天幕遮得连一丝微光也不透。","book":"曹靖华《安得一饮贡河水，九泉长眠愿亦足！》"},"similar":["大好河山"],"opposite":["残山剩水"],"usage":"作主语、宾语；指国土"},{"id":13408,"word":"大好河山","pinyin":"dà hǎo hé shān","abbr":"dhhs","explanation":"河山：国土。无限美好的祖国大地。","source":{"text":"彼乃举其防家贼、媚异族之手段，送我大好河山。","book":"清·秋瑾《普告同胞檄稿》"},"example":{"text":"长安卿相多权贵，大好河山付博徒。","book":"刘复《窃国》诗"},"similar":["锦绣河山"],"opposite":["残山剩水"],"usage":"作主语、宾语；指国土"},{"id":13409,"word":"大家小户","pinyin":"dà jiā xiǎo hù","abbr":"djxh","explanation":"大家：高门望族；小户：平民百姓。指各种社会地位的人家。","source":{"text":"多有王侯府中送将男女来学棋，以及大家小户少年好戏欲学此道的，尽来拜他门下。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"usage":"作主语、宾语、定语；指各种人"},{"id":13410,"word":"大家闺秀","pinyin":"dà jiā guī xiù","abbr":"djgx","explanation":"旧指世家望族中有才德的女子。也泛指有钱有势人家的女儿。","source":{"text":"顾家妇清心玉映，自是闺房之秀。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"姑娘既是位～，怎生来得到此？","book":"清·文康《儿女英雄传》第八回"},"similar":["千金小姐","金枝玉叶","闺房之秀"],"opposite":["小家碧玉"],"usage":"作主语、宾语、定语；泛指有钱有势人"},{"id":13411,"word":"大家风范","pinyin":"dà jiā fēng fàn","abbr":"djff","explanation":"大家：旧指有声望地位的高门贵族。风范：风度、气派。出自高贵人家特有的气派。","source":{"text":"叙起话来，问答如流，气度从容，真是大家风范。","book":"清·石玉昆《三侠五义》第18回"},"example":{"text":"他很有～。"},"similar":["大将风度"],"opposite":["小家子气"],"usage":"作宾语；指人的气质"},{"id":13412,"word":"大富大贵","pinyin":"dà fù dà guì","abbr":"dfdg","explanation":"指十分富有和高贵。","source":{"text":"若说大富大贵，固主之在于天，就是一命之荣，一钱之获，亦无非天意主之，天者理而已矣。","book":"清·褚人获《隋唐演义》第87回"},"example":{"text":"钱钟书《围城》：“两位将来～，未可限量。”"},"usage":"作谓语、定语、宾语、状语；用于口语"},{"id":13413,"word":"大寒索裘","pinyin":"dà hán suǒ qiú","abbr":"dhsq","explanation":"等到大冷天才去找毛皮衣服。比喻平时没有准备，事到临头十分慌乱。","source":{"text":"大寒而后索认裘，不亦晚乎？","book":"汉·扬雄《法言·寡见》"},"similar":["江心补漏","临渴掘井"],"opposite":["未雨绸缪","有备无患"],"usage":"作宾语、定语；指慌乱"},{"id":13414,"word":"大展宏图","pinyin":"dà zhǎn hóng tú","abbr":"dzht","explanation":"展：把卷画打开，比喻实现；宏图：比喻宏伟远大的谋略与计划。大规模地实施宏伟远大的计划或抱负。","source":{"text":"启中兴之宏图，当太平之昌历。","book":"唐·韩愈《为裴相公让官表》"},"example":{"text":"他想～，可事与愿违。"},"similar":["大展经纶","大有作为"],"opposite":["无所作为","碌碌无为","庸庸碌碌"],"usage":"作谓语、定语；指施展才干"},{"id":13415,"word":"大展经纶","pinyin":"dà zhǎn jīng lún","abbr":"dzjl","explanation":"经纶：整理丝缕，比喻治理国家，也指政治才能。充分施展政治才能。","source":{"text":"先取荆州后取川，大展经纶补天手。","book":"明·罗贯中《三国演义》第三十八回"},"example":{"text":"他有一张善于词令的嘴，从各方面看，他都觉得胜任愉快，而可以～。","book":"老舍《四世同堂》第三十七章"},"similar":["大展宏图"],"usage":"作谓语、定语；指施展才能"},{"id":13416,"word":"大山小山","pinyin":"dà shān xiǎo shān","abbr":"dsxs","explanation":"原指作品分类，后指同时被称誉的兄弟。","source":{"text":"著作篇章，分造辞赋，以类相从，故或称‘小山’，或称‘大山’。","book":"汉·王逸《楚辞章句·招隐士序》"},"usage":"作宾语、定语；用于作品或兄弟等"},{"id":13417,"word":"大山广川","pinyin":"dà shān guǎng chuān","abbr":"dsgc","explanation":"高山大河。","source":{"text":"凡立国都，非于大山广川之上，高毋近水旱而水用足，下毋近水而沟防者。","book":"《管子·乘马》"}},{"id":13418,"word":"大工告成","pinyin":"dà gōng gào chéng","abbr":"dggc","explanation":"指巨大工程或重要任务宣告完成。同“大功告成”。","source":{"text":"计其功费，用银不过二三万，用夫不过三万余名，而大工告成矣。","book":"明·沈德符《万历野获编·贾鲁河故道》"},"similar":["大功毕成","大功告成"],"usage":"作谓语、宾语、定语；指顺利完成"},{"id":13419,"word":"大巧若拙","pinyin":"dà qiǎo ruò zhuō","abbr":"dqrz","explanation":"拙：笨。指真正聪明的人，不显露自己，从表面看，好像笨拙。","source":{"text":"大直若屈，大巧若拙，大辨若讷。","book":"《老子》第四十五章"},"example":{"text":"这是所谓“大智若愚，～”的话啦。","book":"郭沫若《屈原》"},"similar":["大智若愚"],"opposite":["不可一世","愚不可及"],"usage":"作定语、分句；指不暴露自己","story":["春秋时期，著名的哲学家老子说：“最圆满的好似欠缺，可是它的作用永不枯竭。最充实的好似空虚，可是它的作用永无终极。最正直的好似弯曲，最灵巧的好似笨拙，最好的口才好似不会辩说。疾走能战胜寒冷，安静能克服暑热。”"]},{"id":13420,"word":"大干快上","pinyin":"dà gàn kuài shàng","abbr":"dgks","explanation":"用最大的力量干起来，使新的工程尽快上马。"},{"id":13421,"word":"大干物议","pinyin":"dà gān wù yì","abbr":"dgwy","explanation":"物议：众人的议论。引起众人的议论或引起舆论的不满。","source":{"text":"他面子上虽然处处让正钦差在前头，然而正钦差遇事还得同他商量，不敢僭越一点，恐怕他摆出老前辈的架子，那是大干物议的。","book":"清·李宝嘉《官场现形记》第十九回"},"usage":"作谓语、定语；用于处事等"},{"id":13422,"word":"大度兼容","pinyin":"dà dù jiān róng","abbr":"ddjr","explanation":"度：度量；容：容纳。形容气量大，能宽容人。","source":{"text":"小人情伪，在君子岂不知之；若以大度兼容，则万事兼济。","book":"宋·朱嘉《宋名臣言行录·吕蒙正》"}},{"id":13423,"word":"大度包容","pinyin":"dà dù bāo róng","abbr":"ddbr","explanation":"度：度量；包：容纳。形容气量大，能宽容人。","source":{"text":"小人情伪，在君子岂不知之；若以大度兼容，则万事兼济。","book":"宋·朱嘉《宋名臣言行录·吕蒙正》"},"example":{"text":"这事情自以为不办为是。倘若嫂夫人是～的呢，自然没得话说。","book":"清·李宝嘉《官场现形记》第十回"},"similar":["宽容大度","宽宏大量"],"opposite":["小肚鸡肠"],"usage":"作谓语、定语、状语；用于为人"},{"id":13424,"word":"大度汪洋","pinyin":"dà dù wāng yáng","abbr":"ddwy","explanation":"大度：气量大；汪洋：深广。形容人有度量，能容人。","source":{"text":"妹子细观姐姐举止，直是大度汪洋，器宇不凡，将来必有非常奇遇。","book":"清·李汝珍《镜花缘》第43回"},"similar":["大度豁达","大度包容","宽宏大量"],"opposite":["小肚鸡肠","斤斤计较"],"usage":"作谓语、定语、状语；形容人豪爽"},{"id":13425,"word":"大度豁达","pinyin":"dà dù huò dá","abbr":"ddhd","explanation":"大度：气量大；豁达：开朗。形容人宽宏开通，有度量，能容人。","example":{"text":"他是一个～的人。"},"similar":["豁达大度"],"opposite":["小肚鸡肠"],"usage":"作谓语、定语、状语；形容人豪爽"},{"id":13426,"word":"大庭广众","pinyin":"dà tíng guǎng zhòng","abbr":"dtgz","explanation":"大庭：宽大的场地；广众：为数很多的人群。指聚集很多人的公开场合。","source":{"text":"使此人于广庭大众之中，见侮而不敢斗，王将以为臣乎？","book":"《孔丛子·公孙龙》"},"example":{"text":"这是秘密的事，他敢在～之下喧扬起来？","book":"清·吴趼人《二十年目睹之怪现状》第八十六回"},"similar":["光天化日","众目睽睽"],"opposite":["暗室屋漏"],"usage":"作宾语、定语；指公共场合","story":["战国时期，齐国国君齐暋王自称爱结交士人，他对尹文说为什么齐国没有士人。尹文说士人是指讲忠、孝、信、义的人。齐暋王同意他的看法。尹文问这种士人在大庭广众之下受到欺侮而不敢争斗算好的士人吗？齐暋王表示不愿任用这类人"]},{"id":13427,"word":"大廷广众","pinyin":"dà tíng guǎng zhòng","abbr":"dtgz","explanation":"指聚集很多人的公开场合。同“大庭广众”。","source":{"text":"大廷广众，苟且安之，梦觉独居，胸弗谓是。","book":"清·龚自珍《上大学士书》"},"similar":["大庭广众"],"usage":"作宾语、定语；指公共场合"},{"id":13428,"word":"大开大合","pinyin":"dà kāi dà hé","abbr":"dkdh","explanation":"形容文思跌荡，放得开，收得拢。","source":{"text":"今年天作奇文章，大开大合为弛张。","book":"清·赵翼《忧旱》"},"usage":"作宾语；指文章等"},{"id":13429,"word":"大开方便之门","pinyin":"dà kāi fāng biàn zhī mén","abbr":"dkfbzm","explanation":"方便门：佛教指引人入佛的门径。开方便门，指引人入佛。比喻给人以方便。","source":{"text":"方便门：佛教指引人入佛的门径。开方便门，指引人入佛。比喻给人以方便。"},"example":{"text":"谁想巡捕老爷～，放俺还俗，便成配偶，是好快乐也呵。","book":"明·冯惟敏《僧尼共犯》第四折"},"similar":["与人方便"],"usage":"作谓语、宾语；指帮助别人"},{"id":13430,"word":"大开眼界","pinyin":"dà kāi yǎn jiè","abbr":"dkyj","explanation":"开阔视野，增回见识。","source":{"text":"光业马上取笔答之曰：‘大开眼界莫言冤’。","book":"唐·李濬《松窗杂录·楚儿》"},"example":{"text":"这次出国访问真是让我～。"},"similar":["大长见识"],"opposite":["鼠目寸光"],"usage":"作谓语、宾语；形容长了见识"},{"id":13431,"word":"大张其词","pinyin":"dà zhāng qí cí","abbr":"dzqc","explanation":"张：宣扬。大肆宣扬某种说法。"},{"id":13432,"word":"大张声势","pinyin":"dà zhāng shēng shì","abbr":"dzss","explanation":"大造声势，扩大影响。","source":{"text":"今修筑必广发兵，大张声势。","book":"《宋史·李师中传》"},"example":{"text":"直又寄耳目于群小如韦瑛、王英辈，～，蠹众害人。","book":"明·余纪登《典故纪闻》卷十五"},"similar":["大造声势","大张旗鼓"],"opposite":["默默无闻"],"usage":"作谓语、定语、状语；指大造声势"},{"id":13433,"word":"大张挞伐","pinyin":"dà zhāng tà fá","abbr":"dztf","explanation":"张：施展；挞伐：讨伐。比喻大规模地攻击或声讨。","source":{"text":"挞彼殷武，奋伐荆楚。","book":"《诗经·商颂·殷武》"},"example":{"text":"我国若不～，一奋神威，靠着各国的空文劝阻，他那里肯甘心就范呢！","book":"清·曾朴《孽海花》第十四回"},"similar":["口诛笔伐","大力声讨","大动干戈"],"opposite":["和平共处"],"usage":"作谓语；多用于书面语"},{"id":13434,"word":"大张旗鼓","pinyin":"dà zhāng qí gǔ","abbr":"dzqg","explanation":"张：陈设，展示；旗鼓：旗帜和战鼓。形容进攻的声势和规模很大。也形容群众活动声势和规模很大。","source":{"text":"李参戎带著这些人陆续出了镇南关，便大张旗鼓，排齐队伍，浩浩荡荡的向前进发。","book":"清·张春帆《宦海》第九回"},"example":{"text":"至于那一部小说，本来当属于古董之部，若要～，颂为二十世纪的新作品，则小子不敏，实不敢也。","book":"鲁迅《书信集·致胡适》"},"similar":["声势浩大","大张声势","浩浩荡荡"],"opposite":["秘而不宣","不露声色"],"usage":"作谓语、定语、状语；用于集体活动"},{"id":13435,"word":"大彻大悟","pinyin":"dà chè dà wù","abbr":"dcdw","explanation":"彻：明白；悟：领会。形容彻底醒悟。","source":{"text":"盖凡升天之时，先参贫道，授与仙诀，大彻大悟后，方得升九天朝真而观元始。","book":"元·郑德辉《伊尹耕莘》楔子"},"example":{"text":"这一回，得看你是不是～，决心离开下流社会，迈步走进上流社会了。","book":"欧阳山《苦斗》四三"},"similar":["恍然大悟","豁然开朗","茅塞顿开"],"opposite":["鬼迷心窍","执迷不悟"],"usage":"作谓语、定语、状语；指彻底明白"},{"id":13436,"word":"大得人心","pinyin":"dà dé rén xīn","abbr":"ddrx","explanation":"人心：即民心。指受百姓热烈拥护。","source":{"text":"太祖命督屯田于河北，自五原至棝杨塞外，分农稼，大得人心。","book":"《魏书·昭成子孙传》"},"example":{"text":"这项政策真是～。"},"similar":["民心所向"],"opposite":["大失人心"],"usage":"作谓语、定语；指受拥护"},{"id":13437,"word":"大德不酬","pinyin":"dà dé bù chóu","abbr":"ddbc","explanation":"德：恩德；酬：报答。重大的恩惠无法酬谢。表示对别人的大恩铭心刻骨，或对人所施大恩不忘回报。","source":{"text":"谚云：‘大德不酬’。","book":"明·吴麟征《还里人田券书》"},"similar":["施恩不图报"],"opposite":["施恩图报"],"usage":"作宾语、定语；用于书面语"},{"id":13438,"word":"大德必寿","pinyin":"dà dé bì shòu","abbr":"ddbs","explanation":"指高尚品德的人受命于天，必然会享高寿，以造福众人。","source":{"text":"故大德，必得其位，必得其禄，必得其名，必得其寿。","book":"《中庸》"}},{"id":13439,"word":"大快人心","pinyin":"dà kuài rén xīn","abbr":"dkrx","explanation":"快：痛快。指坏人坏事受到惩罚或打击，使大家非常痛快。","source":{"text":"李秦授这厮，今日圣旨杀他，大快人心；兄请正坐了，就决了他，使小弟得以快睹。","book":"明·许三阶《节侠记·诛佞》"},"example":{"text":"“老江，你看多么～呀！”说到这里，她喘了一口气，发觉自己太兴奋了。","book":"杨沫《青春之歌》第二部第三十九章"},"similar":["人心大快","普天同庆"],"opposite":["民怨沸腾","怨声载道"],"usage":"作谓语、宾语、定语；用于表达群众的感情"},{"id":13440,"word":"大恩大德","pinyin":"dà ēn dà dé","abbr":"dedd","explanation":"恩：恩惠；德：恩德，好处。巨大的恩德，形容恩泽深厚。","source":{"text":"若非妹丈救我性命，必作异乡之鬼矣。大恩大德，将何补报！","book":"明·冯梦龙《醒世恒言》第17卷"},"example":{"text":"我一定要报答你的～。"},"similar":["恩重如山","再造之恩"],"usage":"作主语、宾语；指巨大的恩德"},{"id":13441,"word":"大惊失色","pinyin":"dà jīng shī sè","abbr":"djss","explanation":"非常害怕，脸色都变了。","source":{"text":"群臣皆惊愕失色，莫敢发言。","book":"《汉书·霍光传》"},"example":{"text":"金方伯听见不是王慕维，又自称举人，不觉～。","book":"清·张春帆《宦海》第二回"},"similar":["胆战心惊","心惊肉跳","面如土色"],"opposite":["不动声色","若无其事","从容不迫"],"usage":"作谓语、补语；表示下意识的表情"},{"id":13442,"word":"大惊小怪","pinyin":"dà jīng xiǎo guài","abbr":"djxg","explanation":"形容对没有什么了不起的的事情过分惊讶。","source":{"text":"要肱把此事做一平常事看，朴实头做将去，久之自然见效，不必如此大惊小怪，起模画样也。","book":"宋·朱熹《答林择之》"},"example":{"text":"兄弟，休要～的，则他便是杨衙内，是个有权有势的的。","book":"元·李文蔚《燕青博鱼》第一折"},"similar":["少见多怪","蜀犬吠日"],"opposite":["见怪不怪","司空见惯"],"usage":"作谓语、宾语、状语；用于否定句中"},{"id":13443,"word":"大惑不解","pinyin":"dà huò bù jiě","abbr":"dhbj","explanation":"惑，迷惑；解：理解。感到非常迷惑，不能理解。","source":{"text":"大惑者终身不解，大愚者终身不灵。","book":"《庄子·天地》"},"example":{"text":"母疑涉妄，然窥女无他，～。","book":"清·蒲松龄《聊斋志异·土偶》"},"similar":["百思不解","莫名其妙","不知所以"],"opposite":["茅塞顿开","豁然开朗","恍然大悟"],"usage":"作谓语、宾语、定语；用于质问的场合"},{"id":13444,"word":"大愚不灵","pinyin":"dà yú bù líng","abbr":"dybl","explanation":"非常愚笨，不通晓任何事情。","source":{"text":"大惑者终身不解，大愚者终身不灵。","book":"《庄子·天地》"},"usage":"作宾语、定语；用于书面语"},{"id":13445,"word":"大慈大悲","pinyin":"dà cí dà bēi","abbr":"dcdb","explanation":"慈：用爱护心给予众生以安乐；悲：用怜悯心解除众生的痛苦；慈悲：佛家语，救人苦难。形容人心肠慈善。","source":{"text":"大慈大悲，常无懈倦，恒求善事，利益一切。","book":"《妙法莲花经·譬喻品》"},"example":{"text":"万望长老收录，～，看赵某薄面，披剃为僧。","book":"明·施耐庵《水浒全传》第四回"},"similar":["大发慈悲","悲天悯人","与人为善"],"opposite":["惨无人道","铁石心肠","灭绝人性"],"usage":"作谓语、定语；有时用于讽刺"},{"id":13446,"word":"大慝巨奸","pinyin":"dà tè jù jiān","abbr":"dtjj","explanation":"慝：邪恶。指邪恶奸险的人。","source":{"text":"大慝巨奸，或燕处于园亭，或潜藏于京邸，奥援有灵，朝廷无法。","book":"明·文秉《先拨志始》下卷"},"similar":["大奸极恶"],"usage":"作主语、宾语、定语；指坏人"},{"id":13447,"word":"大手大脚","pinyin":"dà shǒu dà jiǎo","abbr":"dsdj","explanation":"原指人手大，脚大。后多用来形容花钱、用东西不节省。","source":{"text":"成年家大手大脚的，替太太不知背地里赔垫了多少东西，真真赔的是说不出来的，那里又和太太算去。","book":"清·曹雪芹《红楼梦》第五十一回"},"example":{"text":"一样的～，好像伦敦的巡警都是一母所生的哥儿们。","book":"老舍《二马》"},"similar":["挥金如土","铺张浪费","挥霍无度"],"opposite":["节衣缩食","精打细算","省吃俭用"],"usage":"作谓语、定语、补语；用于批评场合","story":["大观园的海棠诗社又结社了，因为有王熙凤做“监社御史”，诗社的吃喝问题不愁。众人吟诗作赋完毕，袭人穿着单薄的衣衫来叫宝玉，王熙凤见了忙叫平儿送她棉袄和皮袄。众人说王熙凤大手大脚惯了，出手真大方"]},{"id":13448,"word":"大手笔","pinyin":"dà shǒu bǐ","abbr":"dsb","explanation":"指伟大的著作或大行动。","source":{"text":"此当有大手笔事。","book":"《晋书·王珣传》"},"example":{"text":"他最近写出了一个～。"},"similar":["大笔如椽"],"usage":"作主语、宾语、定语；指作家或作品","story":["东晋文人王珣从小才思敏捷，胆识过人，20岁时担任大司马桓温的主簿。他经常是口若悬河，下笔成文。一天晚上王珣做了一个梦，梦中有人送给他一支像椽子那样大的笔，预感有大手笔的事情要做。第二天果然被叫去为晋孝武帝写祭文"]},{"id":13449,"word":"大才小用","pinyin":"dà cái xiǎo yòng","abbr":"dcxy","explanation":"比喻人才使用不当，不能尽其才","source":{"text":"你如今连个‘名世之数’都不肯出，真正大才小用了。","book":"清·李宝嘉《官场现形记》第17回"},"example":{"text":"茅盾《腐蚀》：“你这样的人，干这种比较机械的工作，未免是～了，可惜！”"},"similar":["大材小用"],"opposite":["人尽其材"],"usage":"作宾语、定语；指人事安排不当"},{"id":13450,"word":"大才榱槃","pinyin":"dà cái cuī pán","abbr":"dccp","explanation":"指有大才干的人。同“大才槃槃”。"},{"id":13451,"word":"大才榱盘","pinyin":"dà cái cuī pán","abbr":"dccp","explanation":"指有大才干的人。同“大才盘盘”。"},{"id":13452,"word":"大才槃槃","pinyin":"dà cái pán pán","abbr":"dcpp","explanation":"槃槃：形容大的样子。指有大才干的人。","source":{"text":"大才槃槃谢家安。","book":"南朝·宋·刘义庆《世说新语·赏誉下》刘孝标注引《续晋阳秋》"},"usage":"作定语；指能人"},{"id":13453,"word":"大才盘盘","pinyin":"dà cái pán pán","abbr":"dcpp","explanation":"盘盘：形容大的样子。指有大才干的人。","source":{"text":"大才盘盘谢家安。","book":"南朝·宋·刘义庆《世说新语·赏誉下》刘孝标注引《续晋阳秋》"}},{"id":13454,"word":"大打出手","pinyin":"dà dǎ chū shǒu","abbr":"ddcs","explanation":"打出手：戏曲中的一种武打技术，一出剧中的主要人物与多个对手相打，形成种种武打场面。比喻逞凶打人或殴斗。","source":{"text":"国民党反动派发现了这一情况，气急败坏地大打出手，警察、宪兵、便衣、特务，纷纷出动。","book":"许涤新《周总理战斗在重庆》"},"example":{"text":"他总是动不动就～。"},"similar":["大动干戈","短兵相接","龙争虎斗"],"opposite":["偃旗息鼓","鸣金收兵","风平浪静"],"usage":"作谓语、定语；指打架"},{"id":13455,"word":"大捞一把","pinyin":"dà lāo yī bǎ","abbr":"dlyb","explanation":"乘机放手攫取利益。","source":{"text":"我们一定要趁热打铁，争取再多搞些活动，大捞一把。","book":"王朔《千万别把我当人》"},"example":{"text":"他想趁“非典”之机～。"},"similar":["大赚一笔"],"usage":"作宾语、定语；指捞好处"},{"id":13456,"word":"大摇大摆","pinyin":"dà yáo dà bǎi","abbr":"dydb","explanation":"走路时身子摇摇摆摆。形容自以为了不起的傲慢神态。","source":{"text":"他们都是一气，不怕有一万个强盗，你们只管大摇大摆的走罢。","book":"清·文康《儿女英雄传》第十回"},"example":{"text":"次日早晨，～出堂，将回子发落了。","book":"清·吴敬梓《儒林外史》第五回"},"similar":["神气十足","威风凛凛","高视阔步"],"opposite":["如履薄冰","缩手缩脚","蹑手蹑脚"],"usage":"作定语、状语；形容人或动物走路"},{"id":13457,"word":"大放光明","pinyin":"dà fàng guāng míng","abbr":"dfgm","explanation":"发出强烈的光，非常明亮。比喻某种科研成果或学说、思想对人类社会进步起的巨大的推动作用。","source":{"text":"自达尔文书出后，则进化之学，一旦豁然开朗，大放光明，而世界思想为之一变。","book":"孙中山《心理健康》第四章"}},{"id":13458,"word":"大放厥词","pinyin":"dà fàng jué cí","abbr":"dfjc","explanation":"厥：其，他的；词：文辞，言辞。原指铺张词藻或畅所欲言。现用来指大发议论。","source":{"text":"玉佩琼琚，大放厥词。","book":"唐·韩愈《祭柳子厚文》"},"example":{"text":"也许他认定我年轻无知，才毫无顾虑地在我面前～。","book":"郭良蕙《焦点》十"},"similar":["大发议论","说长道短"],"opposite":["缄口结舌","默默无言"],"usage":"作主语、谓语；指大发议论","story":["唐朝时期，柳宗元与刘禹锡主张革新，失败后被贬为永州司马，后迁柳州刺史。他在官场上屡屡失意。但文学成就很高。散文说理透彻，山水游记写景状物，多所寄托。他死后，韩愈写《祭柳子厚文》称赞他：“玉佩琼琚，大放厥词。”"]},{"id":13459,"word":"大放厥辞","pinyin":"dà fàng jué cí","abbr":"dfjc","explanation":"指写出大量优美的辞章。","source":{"text":"玉佩琼琚，大放厥辞，富贵无能，磨灭谁纪？","book":"唐·韩愈《祭柳子厚文》"},"example":{"text":"他又在～鼓吹“台独”"},"similar":["大放厥词"],"opposite":["默默无言"],"usage":"作谓语、宾语；指大发议论","story":["唐朝时期，柳宗元与刘禹锡主张革新，失败后被贬为永州司马，后迁柳州刺史。他在官场上屡屡失意。但文学成就很高。散文说理透彻，山水游记写景状物，多所寄托。他死后，韩愈写《祭柳子厚文》称赞他：“玉佩琼琚，大放厥词。”"]},{"id":13460,"word":"大放悲声","pinyin":"dà fàng bēi shēng","abbr":"dfbs","explanation":"放声痛哭。形容非常伤心。","source":{"text":"宝钗走到跟前，见凤姐已经停床，便大放悲声。","book":"清·曹雪芹《红楼梦》第114回"},"example":{"text":"少奶奶掩面大哭道：‘只是我的天唷！’说着～。","book":"清·吴趼人《二十年目睹之怪现状》第89回"},"similar":["放声痛哭"],"opposite":["兴高采烈"],"usage":"作谓语、宾语；指痛哭"},{"id":13461,"word":"大政方针","pinyin":"dà zhèng fāng zhēn","abbr":"dzfz","explanation":"重大的政策与措施，引导事业前进的方向和指针。","source":{"text":"颇欲展施抱负，造成一法制国，所以一经就任，便草就大政方针宣言书，拟向国会宣布。","book":"蔡东藩《民国通俗演义》第38回"},"example":{"text":"我们的～是不会有错的。"},"usage":"作主语、宾语；指重大决策"},{"id":13462,"word":"大敌当前","pinyin":"dà dí dāng qián","abbr":"dddq","explanation":"当：面对。面对着强敌。形容形势严峻。","source":{"text":"大敌当前，全无准备，取败之道，不待智者而决矣。","book":"清·刘鹗《老残游记续集》第一回"},"example":{"text":"～，自然以收揽民心，合力御侮为顶要的事。","book":"高阳《清宫外史》下册"},"similar":["生死攸关","生死存亡"],"opposite":["歌舞升平","高枕无忧"],"usage":"作定语、分句；形容形势严峻"},{"id":13463,"word":"大斗小秤","pinyin":"dà dǒu xiǎo chèng","abbr":"ddxc","explanation":"秤：称重的器皿。使用超出标准的斗收进，小于标准的秤出，进行盘剥克扣。","source":{"text":"大斗小秤、奸盗诈伪、淫邪欺罔之徒，受那些磨烧舂锉之苦。","book":"明·吴承恩《西游记》第11回"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第20卷：“不存公道，～，侵剥百端，以致小民愁怨。”"},"similar":["大秤小斗"],"usage":"作宾语、定语；用于剥削等"},{"id":13464,"word":"大方之家","pinyin":"dà fāng zhī jiā","abbr":"dfzj","explanation":"大方：大道理。原指懂得大道理的人。后泛指见识广博或学有专长的人。","source":{"text":"吾长见笑于大方之家。","book":"《庄子·秋水》"},"example":{"text":"故～，每不屑道焉。","book":"清·梁启超《译印政治小说序》"},"similar":["识途老马","斫轮老手"],"usage":"作宾语；泛指见识广博或学有专长的人"},{"id":13465,"word":"大方无隅","pinyin":"dà fāng wú yú","abbr":"dfwy","explanation":"大方：最大的方形；隅：角落，方角，棱角。指最大的方形没有棱角。比喻空泛的大道理没有锋芒。","source":{"text":"大白若辱，大方无隅。","book":"《老子》第四十一章"}},{"id":13466,"word":"大旱云霓","pinyin":"dà hàn yún ní","abbr":"dhyn","explanation":"云霓：下雨的征兆。好像大旱的时候盼望寸水一样。比喻渴望解除困境。","source":{"text":"民望之，若大旱之望云霓也。","book":"《孟子·梁惠王下》"},"example":{"text":"下泉蓍黍思王泽，～企说霖。","book":"清·沈曾植《和缶翁元日韵》"},"similar":["大旱望云霓"],"usage":"作宾语、定语；形容渴望解除困境","story":["战国时期，齐国出兵讨伐燕国取得胜利后久久不撤军，其他诸侯商议要联合出兵援燕。齐宣王向孟子请教，孟子说：“当年商汤率仁义之师讨伐夏桀，百姓盼望商军就像大旱望云霓一样迫切。选择诸侯担心你将来会像对待燕国那样去对待他们。”"]},{"id":13467,"word":"大旱望云","pinyin":"dà hàn wàng yún","abbr":"dhwy","explanation":"比喻渴望解除困境，如久旱盼望下雨一样。","source":{"text":"民望之，若大旱之望云霓也。","book":"先秦·孟轲《孟子·梁惠王下》"},"example":{"text":"日与吏民延颈企锺，虽～，执热思濯，未喻其急也。","book":"宋·苏轼《上执政乞度牒赈济及修廨宇书》"},"similar":["久旱盼雨"],"usage":"作谓语、补语；形容渴望解除困境","story":["战国时期，齐国出兵讨伐燕国取得胜利后久久不撤军，其他诸侯商议要联合出兵援燕。齐宣王向孟子请教，孟子说：“当年商汤率仁义之师讨伐夏桀，百姓盼望商军就像大旱望云霓一样迫切。选择诸侯担心你将来会像对待燕国那样去对待他们。”"]},{"id":13468,"word":"大旱望云霓","pinyin":"dà hàn wàng yún ní","abbr":"dhwyn","explanation":"云霓：下雨的征兆。好像大旱的时候盼望寸水一样。比喻渴望解除困境。","source":{"text":"民望之，若大旱之望云霓也。","book":"《孟子·梁惠王下》"},"example":{"text":"足足等了一个钟头的光景，而我们如～一样，所等候的兵车始终没有开来。","book":"郭沫若《学生时代·到宜兴去》"},"similar":["大旱望云"],"usage":"作谓语、补语；形容渴望解除困境","story":["战国时期，齐国出兵讨伐燕国取得胜利后久久不撤军，其他诸侯商议要联合出兵援燕。齐宣王向孟子请教，孟子说：“当年商汤率仁义之师讨伐夏桀，百姓盼望商军就像大旱望云霓一样迫切。选择诸侯担心你将来会像对待燕国那样去对待他们。”"]},{"id":13469,"word":"大时不齐","pinyin":"dà shí bù qí","abbr":"dsbq","explanation":"大时：天时。指天时生杀万物不在同一时令。","source":{"text":"君子曰：大德不官，大道不器，大信不约，大时不齐。察于此四者，可以有志于学矣。","book":"《礼记·学记》"}},{"id":13470,"word":"大明法度","pinyin":"dà jíng fǎ dù","abbr":"dmfd","explanation":"明：严明；法度：规矩，制度。大力严明制度、法规。","source":{"text":"盖夫天下之大器也，非大明法度，不足以维持，非众建贤才，不足以保守。","book":"宋·王安石《上时政疏》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":13471,"word":"大是大非","pinyin":"dà shì dà fēi","abbr":"dsdf","explanation":"指带有原则性、根本性的是非问题。","source":{"text":"一页一页的历史写出来了，大是大非，终于有了无私的公论。","book":"徐迟《歌德巴赫猜想》"},"example":{"text":"在这个～面前，他是不会站错队的。"},"similar":["泾渭分明","黑白分明","截然不同"],"opposite":["模棱两可","良莠不分","鸡毛蒜皮"],"usage":"作主语、宾语、定语；指原则性的问题"},{"id":13472,"word":"大显神通","pinyin":"dà xiǎn shén tōng","abbr":"dxst","explanation":"神通：原为佛家语，指无所不能的力量。后指特别高超的本领。形容充分显示出高明的本领。","source":{"text":"他三人辞了师父，在城外大显神通。","book":"明·吴承恩《西游记》第八十九回"},"example":{"text":"惟有召西乃明心见性之人，学佛未成者来，～，将此辈一扫而空之。","book":"清·袁枚《续子不语》卷五"},"similar":["大显身手","大展宏图"],"opposite":["无能为力","一筹莫展"],"usage":"作谓语、宾语；指超常的本领"},{"id":13473,"word":"大显身手","pinyin":"dà xiǎn shēn shǒu","abbr":"dxss","explanation":"显：表露，表现；身手：指本领。充分显示出本领和才能。","source":{"text":"朔方健儿好身手，昔何勇锐今何愚。","book":"唐·杜甫《哀王孙》"},"example":{"text":"爱唱的人，就在舞台上痛痛快快唱吧！爱种棉花的，就在连成片的土地上～吧！（茹志娟《高高的白杨树》）"},"similar":["大显神通","大展经纶","大展宏图"],"opposite":["无能为力","束手无策","一筹莫展"],"usage":"作谓语、定语；指展示自己"},{"id":13474,"word":"大智大勇","pinyin":"dà zhì dà yǒng","abbr":"dzdy","explanation":"指非凡的才智和勇气。","example":{"text":"我们很佩服他在处理此事过程中所展示的大智大勇。"},"similar":["智勇双全"],"opposite":["胆小如鼠","大智若愚"],"usage":"作谓语、定语、状语；用于称赞"},{"id":13475,"word":"大智如愚","pinyin":"dà zhì rú yú","abbr":"dzry","explanation":"指才智极高的人，不炫耀自己，表面上看来好像愚笨。","source":{"text":"大勇若怯，大智如愚。","book":"宋·苏轼《贺欧阳少师致仕启》"},"similar":["大智若愚"],"usage":"作谓语、定语、宾语；指有智慧的人不露锋芒"},{"id":13476,"word":"大智若愚","pinyin":"dà zhì ruò yú","abbr":"dzry","explanation":"某些才智出众的人，看来好像愚笨，不露锋芒。","source":{"text":"大勇若怯，大智如愚。","book":"宋·苏轼《贺欧阳少师致仕启》"},"example":{"text":"执雌守黑，不敢自遂，～，于是乎在。","book":"章炳麟《箴新党论》"},"similar":["大巧若拙","虚怀若谷","不露锋芒"],"opposite":["锋芒毕露","不可一世","愚不可及"],"usage":"作谓语、定语、分句；指有智慧的人不露锋芒"},{"id":13477,"word":"大有人在","pinyin":"dà yǒu rén zài","abbr":"dyrz","explanation":"形容某一种人为数不少。","source":{"text":"帝至东都，顾眄街衢，谓侍臣曰：‘犹大有人在。’意谓向日平杨玄感，杀人尚少故也。","book":"《资治通鉴·隋纪炀帝大业十一年》"},"example":{"text":"出面的虽是章士钊，其实黑幕中～。","book":"《鲁迅书信集·致李秉中》"},"similar":["不乏其人"],"opposite":["寥寥无几","无人问津"],"usage":"作谓语、定语；同“不乏其人”"},{"id":13478,"word":"大有作为","pinyin":"dà yǒu zuò wéi","abbr":"dyzw","explanation":"作为：做出成绩。能够极大地发挥作用，作一番贡献。","source":{"text":"大有为之君，大有作为，非常之君也。","book":"《孟子·公孙丑下》：“故将大有为之君，必有所不召之臣，欲有谋焉则就之。”朱熹集注"},"example":{"text":"民国元年革命后，先生的所志已达，该可以～了，然而还是不得志。","book":"鲁迅《且介亭杂文末编·关于于太炎先生二三事》"},"similar":["大有可为","大展宏图","大显身手"],"opposite":["无所作为","碌碌无为","庸庸碌碌"],"usage":"作谓语、宾语、定语；与“大有可为”相对"},{"id":13479,"word":"大有可为","pinyin":"dà yǒu kě wéi","abbr":"dykw","explanation":"事情有发展前途，很值得做。","source":{"text":"地方虽一千余里，仙民成俗，大有可为。","book":"清·李宝嘉《文明小史》"},"example":{"text":"人民政协作为统一战线组织，任务是十分光荣的，工作是～的。","book":"邓小平《新时期的统一战线和人民政协的任务》"},"similar":["大有作为","前程似锦"],"opposite":["无所作为","不堪造就"],"usage":"作谓语、宾语、定语；与“大有作为”相对"},{"id":13480,"word":"大有可观","pinyin":"dà yǒu kě guān","abbr":"dykg","explanation":"指很值得看，很值得重视。","source":{"text":"邦彦以词行，当时皆称美成词。殊不知美成文笔，大有可观。作《汴都赋》，如笺奏杂者，皆是杰作，可惜以词掩其文也。","book":"宋·无名氏《李师师传》"},"example":{"text":"这个捐款也就～了。","book":"清·李宝嘉《文明小史》第七回"},"similar":["举足轻重","事关全局"],"opposite":["不屑一顾","不足挂齿","不值一提"],"usage":"作谓语、定语；指值得重视"},{"id":13481,"word":"大有希望","pinyin":"dà yǒu xī wàng","abbr":"dyxw","explanation":"指做成某事或实现某种愿望的可能性很大。","source":{"text":"选拔干部，选拔人才，只要选得好，选得准，我们的事业就大有希望。","book":"邓小平《高级干部要带头发扬党的优良传统》"},"example":{"text":"她这次～。"},"similar":["大有前途"],"usage":"作谓语、宾语；指有盼头"},{"id":13482,"word":"大有径庭","pinyin":"dà yǒu jìng tíng","abbr":"dyjt","explanation":"比喻相差很远，大不相同。","source":{"text":"吾惊怖其言，犹河汉而无极也。大有径庭，不近人情焉？","book":"《庄子·逍遥游》"},"example":{"text":"他这次发言和上次比较，内容～。"},"similar":["大相径庭"],"opposite":["相差无几"],"usage":"作谓语；同“大相径庭”"},{"id":13483,"word":"大有文章","pinyin":"dà yǒu wén zhāng","abbr":"dywz","explanation":"指话语、文章、或已表露的现象之中，很有令人难以捉摸的意思或别的情况。","source":{"text":"艾虎听了，暗暗思忖道：‘这话语之中大有文章。’","book":"清·无名氏《三侠五义》"},"example":{"text":"他的话～可做。"},"similar":["弦外有音","话里有话"],"usage":"作谓语、宾语；指有玄机"},{"id":13484,"word":"大有裨益","pinyin":"dà yǒu bì yì","abbr":"dyby","explanation":"裨益：益处、好处。形容益处很大。","source":{"text":"比及武平之末，府藏渐虚，邕度支取金，大有裨益。","book":"《北齐书·唐邕传》"},"example":{"text":"其间卓然自得者，于圣经贤传，～。","book":"明·焦竑《玉堂丛语·文学》"},"usage":"作谓语；用于事物等"},{"id":13485,"word":"大有见地","pinyin":"dà yǒu jiàn dì","abbr":"dyjd","explanation":"很有见解。","example":{"text":"赵先生对民俗学研究多年，他的发言～，且具缜密的逻辑，很有说服力。"},"opposite":["短见浅识"],"usage":"作谓语、定语；用于人的观点等"},{"id":13486,"word":"大有起色","pinyin":"dà yǒu qǐ sè","abbr":"dyqs","explanation":"明显地出现好转的样子（多指焕散的工作或觉重的疾病）。","source":{"text":"皖省惟英、霍有零贼，余亦肃清，南中军务，大有起色。","book":"清·张集馨《道咸宦海见闻录》"},"similar":["大有成效"],"usage":"作谓语、定语；多指工作或疾病等"},{"id":13487,"word":"大有迳庭","pinyin":"dà yǒu jìng tíng","abbr":"dyjt","explanation":"比喻彼此差异很大。","source":{"text":"迳，门外路；庭，堂外地；大有，谓相远之甚。","book":"《庄子·逍遥游》：“大有迳庭，不近人情焉。”王先谦集解引宣颖云"},"example":{"text":"故古人的所谓‘封建’，和我们现在所用的‘封建’，本质上～。","book":"郭沫若《中国古代社会研究》第四篇五"}},{"id":13488,"word":"大本大宗","pinyin":"dà běn dà zōng","abbr":"dbdz","explanation":"本：根本；宗：本，主旨。最根本，最重要的东西。","source":{"text":"夫明白于天地之德者，此之谓大本大宗，与天和者也。","book":"《庄子·天道》"},"usage":"作宾语、定语；指最根本，最重要的东西"},{"id":13489,"word":"大杀风景","pinyin":"dà shā fēng jǐng","abbr":"dsfj","explanation":"意思是损害景物，破坏人的兴致。今泛称败人兴致为大杀风景。","source":{"text":"其一曰杀风景，谓清泉濯足，花上晒禈，背山起楼，烧琴煮鹤，对花啜茶，松下喝道。","book":"《西清诗话》"},"example":{"text":"但亦多粗服乱发之辈，头缠帕子，脚穿草鞋，挑抬负载于同一街上，颇不和谐，～。","book":"何其芳《重庆的市容》"},"similar":["大煞风景"],"opposite":["兴致勃勃"],"usage":"作谓语、定语；指不合时宜","story":["唐朝诗人李商隐很有才华，他的诗揭露和批判当时的黑暗现实及官场腐败。他在《杂纂》中列出大煞风景的事情，如“清泉濯足，花上晒禈，背山起楼，烧琴煮鹤，对花啜茶，松下喝道。”这些都是当时让人扫兴的事情"]},{"id":13490,"word":"大权在握","pinyin":"dà quán zài wò","abbr":"dqzw","explanation":"手中掌握有很大权力。","source":{"text":"比如当县长的同志，切不可大权在握，一切武断独断。","book":"邓小平《党与抗日民主政权》"},"example":{"text":"他～，为所欲为。"},"similar":["大权独揽"],"opposite":["大权旁落"],"usage":"作谓语、定语；指手中掌握着实权"},{"id":13491,"word":"大权旁落","pinyin":"dà quán páng luò","abbr":"dqpl","explanation":"处理重大事情的权力落到旁人手里（多指领导人被架空）。","source":{"text":"借光唬百兽，大权叹旁落。","book":"明·东鲁古狂生《醉醒石》第十一回"},"example":{"text":"现在京里，很有人说亲家的闲话说亲家请了一位洋人做老夫子，～，自己一点事不问。","book":"清·李宝嘉《官场现形记》第五十八回"},"opposite":["大权独揽","大权在握"],"usage":"作谓语、宾语；指权力落到旁人手里"},{"id":13492,"word":"大权独揽","pinyin":"dà quán dú lǎn","abbr":"dqdl","explanation":"揽：把持。一个人把持着权力，独断专行。","source":{"text":"兵士又没感情，他却忘其所以，大权独揽，只弄些小聪明，闹些空意气。","book":"曾朴《孽海花》第六回"},"example":{"text":"军政时代则～于一人。","book":"孙中山《心理建设》第六章"},"similar":["独断专行","大权在握"],"opposite":["大权旁落"],"usage":"作谓语；形容个人独断专行"},{"id":13493,"word":"大材小用","pinyin":"dà cái xiǎo yòng","abbr":"dcxy","explanation":"比喻人才使用不当，不能尽其才。","source":{"text":"你这样的人，干这种比较机械的工作，未免是大才小用了，可惜！","book":"茅盾《腐蚀》"},"example":{"text":"钱钟书《围城》：“～，可惜可惜！方先生在外国学的是什么呀？”"},"similar":["大器小用","明珠弹雀","牛鼎烹鸡"],"opposite":["人尽其材","物尽其用","知人善用"],"usage":"作宾语、定语；指人事安排不当","story":["周瑜病死后，鲁肃向孙权推荐庞统，孙权不用他。鲁肃就推荐庞统去投奔刘备，刘备将他安排到耒阳县当县令，庞统不悦，终日借酒浇愁，张飞来巡视才发现庞统的真实才能，孔明推荐庞统给刘备，刘备任命庞统为副军师中郎将"]},{"id":13494,"word":"大杖则走","pinyin":"dà zhàng zé zǒu","abbr":"dzzz","explanation":"杖：木棍；走：逃跑。舜的父亲用大棍子打他时，他就逃走躲避，免陷父亲于不义。旧时宣扬的封建孝道。","source":{"text":"舜之事父也，索而使之，未尝不在侧；求而杀之，未尝可得。小棰则待，大棰则走，以逃暴怒也。","book":"汉·刘向《说苑·建本》"},"example":{"text":"舜之事父，小杖则受，～，非不孝也。","book":"南朝·宋·范晔《后汉书·崔寔传》"},"opposite":["小杖则受"],"usage":"作谓语、定语；指不挨打","story":["春秋时期，曾参因为种瓜误点被父亲毒打一顿，挨打后不省人事，醒来后还装作很高兴的样子。孔子听说后，非常气愤，甚至不认他这个弟子。孔子说当年舜对待父亲的责罚从来都是小受大走，也不失去对父亲的孝心，曾参则陷父亲于不义的深渊"]},{"id":13495,"word":"大来小往","pinyin":"dà lái xiǎo wǎng","abbr":"dlxw","explanation":"指阴暗面逐渐消失，光明面逐渐增长。也借喻商人以小本牟取暴利。","example":{"text":"～的事情经常发生。"},"similar":["小往大来"],"usage":"作谓语、定语；用于事物"},{"id":13496,"word":"大树将军","pinyin":"dà shù jiāng jūn","abbr":"dsjj","explanation":"原指东汉冯异。后常指不居功自傲的将领。","source":{"text":"诸将军并坐论功，异常独屏树下，军中号曰‘大树将军’。","book":"《后汉书·冯异传》"},"example":{"text":"武帝尝指道根示尚书令沈约，美其口不论勋。约曰：“此陛下之～也。”","book":"《南史·冯道要列传》"},"usage":"作主语、宾语；指将领","story":["西汉末年，政权被王莽窃取。人们奋起反抗王莽的暴政，刘秀起兵攻打王莽。郡椽监督冯异与苗萌归降刘秀。刘秀拜冯异为偏将军，封为应侯。冯异为人谦让，从不与别人争功。每当战斗结束时，将领们开始争功，他却躲在大树下，被人称为“大树将军”"]},{"id":13497,"word":"大树底下好乘凉","pinyin":"dà shù dǐ xià hǎo chéng liàng","abbr":"dsdxhcl","explanation":"比喻有所依托，事情就好办。","source":{"text":"每日则是吃他家的，便好道这大树底下好乘凉。","book":"元·无名氏《刘弘嫁婢》第一折"},"usage":"作宾语、定语；用于口语"},{"id":13498,"word":"大桀小桀","pinyin":"dà jié xiǎo jié","abbr":"djxj","explanation":"桀：夏桀，夏朝末代君主，是个暴君。大桀和小桀。比喻程度不同，本质一样。","source":{"text":"欲轻之于尧舜之道者，大貉小貉也；欲重之于尧舜之道者，大桀小桀也。","book":"《孟子·告子上》"},"example":{"text":"公纵不出，而下江之兵已起，比于政府，其为～尚未知。","book":"清·章炳麟《致黎元洪电》"},"opposite":["大相径庭"],"usage":"作宾语、定语；用于口语"},{"id":13499,"word":"大梦初醒","pinyin":"dà mèng chū xǐng","abbr":"dmcx","explanation":"象做了一场大梦才醒。比喻被错误的东西蒙蔽了许久，开始醒悟过来。","source":{"text":"且有大觉，而后知此其大梦也。","book":"《庄子·齐物论》"},"example":{"text":"从一九年以来，她才仿佛从～似的，又从事于版画了。","book":"鲁迅《且介亭杂文末编·〈凯绥·珂勒惠支版画选集〉序目》"},"similar":["久梦初醒"],"opposite":["执迷不悟"],"usage":"作谓语、定语；指突然觉醒"},{"id":13500,"word":"大梦方醒","pinyin":"dà mèng fāng xǐng","abbr":"dmfx","explanation":"象做了一场大梦才醒。比喻从长期的错误、蒙蔽或迷茫中开始醒悟过来。同“大梦初醒”。","source":{"text":"跪读之下，伏查现在时势既至如此，而活佛指示详明，譬如大梦方醒，群疑尽释，欣感无已。","book":"丁中江《北洋军阀史话·俄侵外蒙、英侵西藏》"}},{"id":13501,"word":"大模大样","pinyin":"dà mú dà yàng","abbr":"dmdy","explanation":"形容态度傲慢，目中无人的样子。","source":{"text":"又见他烈烈轰轰，呼呼喝喝，大模大样，前遮后拥，把那街上闲人尽打开。","book":"明·王世桢《鸣凤记》第二十三出"},"example":{"text":"安禄山，我且问你，这般～是几时起的？","book":"清·洪昇《长生殿》第十三出"},"similar":["趾高气扬","神气活现","旁若无人"],"opposite":["低声下气","自惭形秽","小手小脚"],"usage":"作谓语、状语；用于人与动物"},{"id":13502,"word":"大步流星","pinyin":"dǎ bù liú xīng","abbr":"dblx","explanation":"形容步子跨得大，走得快。","source":{"text":"他在爬犁的近边，大步流星地走着。","book":"周立波《暴风骤雨》第二部六"},"example":{"text":"提着灯笼的生宝在天亮前开始结霜的牛车路上，～地向南走去。","book":"柳青《创业史》第二部第三章"},"similar":["健步如飞","追风逐电","风驰电掣"],"opposite":["慢条斯理","姗姗来迟","老牛破车"],"usage":"作状语；用于走路"},{"id":13503,"word":"大气磅礴","pinyin":"dà qì páng bó","abbr":"dqpb","explanation":"磅礴：广大无边际的样子。形容气势浩大。","source":{"text":"杂能旁魄而无用。","book":"战国·赵·荀况《荀子·性恶》"},"example":{"text":"你的大作，～。","book":"毛泽东《给陈毅同志谈诗的一封信》"},"similar":["声势浩大","波澜壮阔","气吞山河",""],"opposite":["势单力薄","气息奄奄"],"usage":"作谓语、定语、状语；指气势大"},{"id":13504,"word":"大水冲了龙王庙","pinyin":"dà shuǐ chōng le lóng wáng miào","abbr":"dscllwm","explanation":"比喻本是自己人，因不相识而相互发生了冲突争端。","source":{"text":"大水冲了龙王庙，一家人不认识一家人咧！","book":"清·文康《儿女英雄传》七回"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“哪晓得～！如今说不得了，只好我说了话不算！”"},"similar":["大水淹了龙王庙"],"usage":"作宾语、分句；用于口语"},{"id":13505,"word":"大水淹了龙王庙","pinyin":"dà shuǐ yān le lóng wáng miào","abbr":"dsyllwm","explanation":"龙王庙：管水之神的庙宇。比喻本是自己人，因不相识而互相之间发生了争端。","source":{"text":"闯王派我来，也只是同你们见见面，交交朋友，免得日后大水淹了龙王庙，一家人不认识一家人。","book":"姚雪垠《李自成》第一卷第14章"},"similar":["大水冲了龙王庙"],"usage":"作宾语、分句；用于口语"},{"id":13506,"word":"大汗涔涔","pinyin":"dà hàn cén cén","abbr":"dhcc","explanation":"形容因天气炎热或心情紧张而导致浑身汗流如注的样子。","source":{"text":"他本来想立个大功，而眼下却闯了个大祸，他怎不六神无主，大汗涔涔？","book":"叶永烈《张春桥传·附录一》"}},{"id":13507,"word":"大汗淋漓","pinyin":"dà hàn lín lí","abbr":"dhll","explanation":"形容因运动或体力劳动等导致浑身出了很多汗。","example":{"text":"只见明珠身后跟着二十来个大胡子军官，有的黑胡子，有的白胡子，有的花白胡子，个个尘沙被面，～。","book":"金庸《鹿鼎记》第三十七回"}},{"id":13508,"word":"大江东去","pinyin":"dà jiāng dōng qù","abbr":"djdq","explanation":"长江的水往东奔流而去。后借用为词牌名。多表示陈迹消逝，历史向前发展。","source":{"text":"大江东去，浪淘尽，千古风流人物。","book":"宋·苏轼《念奴娇·赤壁怀古》"},"example":{"text":"早被我们伟大的党所领导的中国人民的巨掌击退，如～，永不复返了。","book":"曹靖华《智慧花开烂如锦》"},"usage":"作宾语；比喻历史向前发展"},{"id":13509,"word":"大江南北","pinyin":"dà jiāng nán běi","abbr":"djnb","explanation":"指靠临长江中下游两岸的广大地区。","source":{"text":"而大江南北，以文名天下者，几于昌（猖）狂无理，排溺一世之人，其势力至今未已。","book":"清·恽敬《上曹俪笙侍郎书》"},"example":{"text":"我谈起买如意的事，他说有一支很别致的，只怕～的玉器店，找不出一个来。","book":"清·吴趼人《二十年目睹之怪现状》第二十九回"},"usage":"作主语、宾语、定语；指临长江地区"},{"id":13510,"word":"大法小廉","pinyin":"dà fǎ xiǎo lián","abbr":"dfxl","explanation":"旧时指大臣尽忠，小臣尽职。","source":{"text":"大臣法，小臣廉，官职相序，君臣相正，国之肥也。","book":"《礼记·礼运》"},"example":{"text":"末吏有个知识，便规谏上宪，一堂和气，～。","book":"清·文康《儿女英雄传》第三十三回"},"usage":"作谓语、宾语；指各尽其责"},{"id":13511,"word":"大泽礨空","pinyin":"dà zé lěi kōng","abbr":"dzlk","explanation":"大泽：很大的水面，多指湖泊；礨空：蚁穴。小蚂蚁空居于大泽之中。形容二者相比过于悬殊。","source":{"text":"计四海之在天地之间也，不似礨空之在大泽乎？计中国之在海内，不似乘米之在太仓乎？","book":"《庄子·秋水》"}},{"id":13512,"word":"大浪淘沙","pinyin":"dà làng táo shā","abbr":"dlts","explanation":"淘：用水冲洗。去掉杂质。在大浪中洗净沙石。比喻在激烈的斗争中经受考验、筛选。","source":{"text":"这支队伍经过严峻的锻炼和考验，质量更高了，是大浪淘沙保留下来的精华。","book":"粟裕《激流归大海》"},"example":{"text":"我们要经受～的考验。"},"usage":"作主语、宾语、定语；用于在激烈的斗争中"},{"id":13513,"word":"大海一针","pinyin":"dà hǎi yī zhēn","abbr":"dhyz","explanation":"在大海里捞一根针。比喻无从寻觅。","source":{"text":"这王珣踪迹无方，分明大海一针，何从捞摸。","book":"明·天然痴叟《石点头·王本立天涯求父》"},"similar":["大海捞针","东海捞针"],"usage":"作宾语、定语、状语；用于比喻句中"},{"id":13514,"word":"大海捞针","pinyin":"dà hǎi lāo zhēn","abbr":"dhlz","explanation":"在大海里捞一根针。比喻极难找到。","source":{"text":"儿，此生休想同衾枕，要相逢除非东海捞针。","book":"元·柯丹丘《荆钗记·误讣》"},"example":{"text":"要打听前任巡检太爷家眷的下落，那真是～一般，问了半天，没有人知道的。","book":"清·吴趼人《二十年目睹之怪现状》第一百七回"},"similar":["难如登天","海中捞月"],"opposite":["易如反掌","轻而易举","唾手可得"],"usage":"作宾语、定语、状语；用于比喻句中"},{"id":13515,"word":"大渐弥留","pinyin":"dà jiàn mí liú","abbr":"djml","explanation":"大渐：病危；弥留：本指久病不愈，后指病重将死。表示病危将死。","source":{"text":"景命不永，大渐弥留。","book":"《尚书·顾命》：“疾大渐，惟几，病日臻，既弥留。”南朝·梁·萧统《文选·王俭〈诸渊碑文〉》"},"example":{"text":"既而天机忽爽，～。","book":"唐·王勃《常州刺史平原郡开国公行状》"},"similar":["临终之际"],"usage":"作定语；指病危将死"},{"id":13516,"word":"大澈大悟","pinyin":"dà chè dà wù","abbr":"dcdw","explanation":"彻：明白；悟：领会。形容彻底醒悟。","source":{"text":"盖凡升天之时，先参贫道，授与仙诀，大彻大悟后，方得升九天朝真而观元始。","book":"元·郑德辉《伊尹耕莘》楔子"},"example":{"text":"到这时候，我仿佛～了不是？","book":"清·刘鹗《老残游记续编》第四回"},"similar":["大彻大悟"],"opposite":["执迷不悟"],"usage":"作谓语、定语、状语；指彻底明白"},{"id":13517,"word":"大烹五鼎","pinyin":"dà pēng wǔ dǐng","abbr":"dpwd","explanation":"烹：烧煮。古代祭礼，后用以指吃特别美味的饭食。形容生活奢华。","source":{"text":"若是心里有了一点对那道理不住的地方，就使住的是深居九重，吃的是大烹五鼎，看来似是快乐无比的，却是心窝儿里头常做个天人的战场。","book":"清·岭南羽衣女士《东欧女豪杰》第一回"},"similar":["食前方丈"],"opposite":["食不重味"],"usage":"作宾语、定语；用于生活"},{"id":13518,"word":"大煞风景","pinyin":"dà shā fēng jǐng","abbr":"dsfj","explanation":"损伤美好的景致。比喻败坏兴致。","source":{"text":"唐·李商隐《杂纂》把“花间喝道”、“月下把火”等列为“杀风景”的事情。"},"example":{"text":"安公子高高兴兴的一个酒场，再不想作了这等一个～。","book":"清·文康《儿女英雄传》第三十回"},"similar":["兴致索然","败兴而归"],"opposite":["兴致勃勃"],"usage":"作谓语、定语；用于与好事相对照","story":["唐朝诗人李商隐很有才华，他的诗揭露和批判当时的黑暗现实及官场腐败。他在《杂纂》中列出大煞风景的事情，如“清泉濯足，花上晒裈，背山起楼，烧琴煮鹤，对花啜茶，松下喝道。”这些都是当时让人扫兴的事情"]},{"id":13519,"word":"大煞风趣","pinyin":"dà shà fēng qù","abbr":"dsfq","explanation":"损伤美好的景致。比喻败坏兴致。同“大煞风景”。","source":{"text":"三十未嫁，不近情理，如作为再醮亦无根据，且觉大煞风趣，因此我仍照原似未改。","book":"郭末若《故事补遗二》"},"similar":["大煞风景"],"usage":"作谓语、定语；用于与好事相对照"},{"id":13520,"word":"大王好见，小鬼难当","pinyin":"dà wáng hǎo jiàn，xiǎo guǐ nán dāng","abbr":"dwhjxgnd","explanation":"指头目见面好说话，喽啰们难缠。指走狗借着主人势力敲诈勒索。","source":{"text":"现在的人间也还是‘大王好见，小鬼难当’的处所。","book":"鲁迅《路》"},"similar":["阎王好见，小鬼难当"],"usage":"作宾语、定语；用于口语"},{"id":13521,"word":"大璞不完","pinyin":"tài bú bù wán","abbr":"tpbw","explanation":"指玉既经雕琢，就失去了天然的形态。旧时比喻读书人做了官，丧失了原来的志向。","source":{"text":"夫玉生于山，制则破焉。非弗富贵矣，然大璞不完。","book":"《战国策·齐策四》"},"usage":"作宾语、定语；用于书面语"},{"id":13522,"word":"大瓠之用","pinyin":"dà hù zhī yòng","abbr":"dhzy","explanation":"瓠：葫芦。原指事物不同的使用，会产生不同的效果。后指量材使用。","source":{"text":"今子有五石之瓠，何不虑以为大樽而浮于江湖，而忧其瓠落无所容，则夫子犹有蓬之心也夫。","book":"《庄子·逍遥游》"}},{"id":13523,"word":"大男大女","pinyin":"dà nán dà nǚ","abbr":"dndn","explanation":"指超过正常结婚年龄的未婚男女。","source":{"text":"我须不嫖他大男大女，不肏他亲姐晚妹，干他甚事！","book":"明·伏雌教主《醋葫芦》第13回"},"example":{"text":"现在～不结婚是十分正常的。"},"opposite":["老夫老妻"],"usage":"作主语、宾语、定语；指大龄青年"},{"id":13524,"word":"大男小女","pinyin":"dà nán xiǎo nǚ","abbr":"dnxn","explanation":"指子女。或指男男女女。","source":{"text":"少米无柴休懊恼，大男小女好看成。","book":"元·吕思诚《寄内》"},"example":{"text":"你看那长安城里，行商坐贾，公子王孙，墨客文人，～，无不争着夸奖。","book":"明·吴承恩《西游记》第十二回"},"similar":["一男半女"],"usage":"作主语、宾语、定语；指儿女"},{"id":13525,"word":"大白于天下","pinyin":"dà bái yú tiān xià","abbr":"dbytx","explanation":"大白：彻底明白，完全清楚；天下：旧指全中国。全国的人都知道了事情的真相。","source":{"text":"自此之后，于谦之冤始大白于天下。","book":"明·周楫《西湖二集》卷十八"},"example":{"text":"吾辈救国护法之初衷，将无以～，而佥壬假借，得以自便私图。","book":"蔡东藩、许廑父《民国通俗演义》第一百十九回"},"similar":["真相大白"],"opposite":["不明真相"],"usage":"作谓语、定语；用于事实真相等"},{"id":13526,"word":"大盗窃国","pinyin":"dà dào qiè guó","abbr":"ddqg","explanation":"大盗：指窃国篡位者。指坏人窃取政权，颠覆国家。","source":{"text":"秦以来之为君，正所谓大盗窃国者耳。国谁窃，转相窃之于民而已。","book":"清·严复《辟韩篇》"},"example":{"text":"～，予智自雄，冯借政治上之枢机，戕贼风俗之大本。","book":"李大钊《民彝与政治》"},"usage":"作宾语、定语；用于政事等"},{"id":13527,"word":"大直若屈","pinyin":"dà zhí ruò qū","abbr":"dzrq","explanation":"最正直的人外表反似委曲随和。亦作“大直若诎”。","source":{"text":"及后潜图董氏，几振国命，所谓‘大直若屈，道固逶迤’也。","book":"《后汉书荀淑传论》"},"similar":["大直若屈，大巧若拙"],"usage":"作谓语、定语、宾语；用于为人"},{"id":13528,"word":"大直若屈，大巧若拙","pinyin":"dà zhí ruò qū，dà qiǎo ruò zhuō","abbr":"dzrqdqrz","explanation":"屈：枉屈。极为正直的人，表面上好像枉屈；极为灵巧的人，表面上好像很笨拙。","source":{"text":"大直若屈，大巧若拙，大辨若讷。","book":"《老子》第四十五章"},"similar":["大直若屈"],"usage":"作定语、宾语；用于为人"},{"id":13529,"word":"大直若诎","pinyin":"dà zhí ruò qū","abbr":"dzrq","explanation":"最正直的人外表反似委曲随和。同“大直若屈”。","source":{"text":"大直若诎，大辩若讷。","book":"《韩诗外传》卷九"},"example":{"text":"叔孙通希世度务制礼，进退与时变化，卒为汉家儒宗。‘～，道固委蛇’，盖谓是乎？","book":"《史记·刘敬叔孙通列传论》"},"similar":["大直若屈"],"usage":"作谓语、定语、宾语；用于为人"},{"id":13530,"word":"大相径庭","pinyin":"dà xiāng jìng tíng","abbr":"dxjt","explanation":"径：小路；庭：院子；径庭：悬殊，偏激。比喻相差很远，大不相同。","source":{"text":"吾惊怖其言，犹河汉而无极也。大有径庭，不近人情焉？","book":"《庄子·逍遥游》"},"example":{"text":"虽然结果一样，其“因”却～。","book":"鲁迅《集外集拾遗·田园思想》"},"similar":["迥然不同","泾渭分明","截然不同"],"opposite":["一模一样","如出一辙","大同小异"],"usage":"作谓语、定语；形容事物区别明显","story":["春秋时期，楚国狂士接舆对肩吾说北海有一座姑射仙山，山上的神仙可以让世界五谷丰登。肩吾认为接舆的话大而无当、大有径庭、不近人情，就对连叔说接舆在吹牛。连叔沉思了一会，对肩吾说接舆的话不一定是没有道理的"]},{"id":13531,"word":"大相迳庭","pinyin":"dà xiāng jìng tíng","abbr":"dxjt","explanation":"指彼此相差极远或矛盾很大。","source":{"text":"嗟呼！几何不与吕公论世尚友之旨大相迳庭也哉！","book":"清·厉鹗《跋》"},"example":{"text":"然与鄙见复有～者，其治小学重形体而轻声类。","book":"章炳麟《与人论朴学报书》"}},{"id":13532,"word":"大眼望小眼","pinyin":"dà yǎn wàng xiǎo yǎn","abbr":"dywxy","explanation":"你看我，我看你，不知怎么办好。","source":{"text":"众人大眼望小眼，齐道：‘原来新贵人欢喜疯了。’","book":"清·吴敬梓《儒林外史》第三回"},"example":{"text":"听到这般温柔怪诞的问话，兴奋中的二人愣在当头，～，如坠五里雾中。","book":"和事《处世36计·装傻计》"}},{"id":13533,"word":"大眼瞪小眼","pinyin":"dà yǎn dèng xiǎo yǎn","abbr":"dydxy","explanation":"大眼看着小眼，没有解决的办法。","source":{"text":"兄弟俩大眼瞪小眼。","book":"路遥《平凡的世界》第四卷第41章"},"example":{"text":"他们在一起～，找不到解决的办法。"},"similar":["小眼瞪大眼"],"usage":"作谓语、状语；用于惊讶或没有办法时"},{"id":13534,"word":"大睨高谈","pinyin":"dà nì gāo tán","abbr":"dngt","explanation":"睨：视。眼睛看着上面，在发议论。形容举动言论气慨不凡。","source":{"text":"方将师天老而友地典，与之乎高睨而大谈。","book":"《后汉书·张衡传》"},"example":{"text":"～肯息机？寒蛩四壁一灯微。","book":"柳亚子《寄颖若》"}},{"id":13535,"word":"大破大立","pinyin":"dà pò dà lì","abbr":"dpdl","explanation":"大举击毁旧物，大力建立新事物。","example":{"text":"我们要～，树立新的观念。"},"opposite":["不破不立"],"usage":"作宾语、定语；指全面更新"},{"id":13536,"word":"大祸临头","pinyin":"dà huò lín tóu","abbr":"dhlt","explanation":"临：来到。大灾祸来临。","source":{"text":"总之，仿佛有大祸临头的感觉，很不平静。","book":"欧阳山《苦斗》四十七"},"example":{"text":"他感到～了。"},"similar":["大难临头","大祸临门"],"opposite":["鸿运当头"],"usage":"作宾语、定语；指面临危机"},{"id":13537,"word":"大祸临门","pinyin":"dà huò lín mén","abbr":"dhlm","explanation":"临：光临。即将发生大灾祸。","example":{"text":"在即将～的时候最需要的就是冷静思考。"},"similar":["大祸临头"],"opposite":["鸿运当头"],"usage":"作宾语、定语；指面临危机"},{"id":13538,"word":"大福不再","pinyin":"dà fú bù zài","abbr":"dfbz","explanation":"再：第二次。幸运的事不会第二次来临。指做事不能只图侥幸。","source":{"text":"大福不再，只取辱焉。","book":"《左传·昭公十三年》"},"similar":["福无双至"],"opposite":["祸不单行"],"usage":"作宾语、定语；用于口语"},{"id":13539,"word":"大禹治水","pinyin":"dà yǔ zhì shuǐ","abbr":"dyzs","explanation":"禹：三皇五帝时中原的领袖。大禹治理水患为百姓谋福。","source":{"text":"昔日大禹治水，从岷山导出岷江。","book":"明·冯梦龙《醒世恒言》第26卷"},"example":{"text":"你知道大禹治水的故事吗？"},"similar":["过门不入"],"usage":"作宾语、定语；指为民谋福","story":["舜统治时，中华大地经常发大水，禹上书给舜要求负责治水工作，说：“先父用堰障法治水没有收到成效，我要用疏导法治水，让水流入大海。”舜同意让禹负责治水，禹率能工巧匠开凿河道，疏导水流，治水13年终于消灭水患"]},{"id":13540,"word":"大秤小斗","pinyin":"dà chèng xiǎo dǒu","abbr":"dcxd","explanation":"秤：称重的器皿。使用超出标准的秤进，小于标准的斗出，进行盘剥克扣。","source":{"text":"不用大秤小斗，不违例克剥人财，坑人陷人。","book":"明·冯梦龙《喻世明言》第37卷"},"similar":["短斤少两","大斗小秤"],"opposite":["童叟无欺"],"usage":"作宾语、定语；用于剥削等"},{"id":13541,"word":"大称小斗","pinyin":"dà chēng xiǎo dǒu","abbr":"dcxd","explanation":"指使用超过标准的秤进，小于标准的秤出，进行克扣剥削。","source":{"text":"不用大称小斗，不违例克剥人财，坑人陷人。","book":"明·冯梦龙《古今小说·梁武帝累修归极乐》"}},{"id":13542,"word":"大笔一挥","pinyin":"dà bǐ yī huī","abbr":"dbyh","explanation":"挥：挥写。形容善于写作者运笔神速或任意签字、涂改。","source":{"text":"老贼看了，连说：‘妥当结实，就劳贤契大笔一挥。","book":"清·石玉昆《三侠五义》第43回"},"example":{"text":"钱钟书《围城》：“他们决不会了解，说不定父亲就会～，直接向唐小姐替自己求婚，他会闹这种笑话的。”"},"usage":"作谓语；用于签字等"},{"id":13543,"word":"大笔如椽","pinyin":"dà bǐ rú chuán","abbr":"dbrc","explanation":"椽：放在檩子上架着屋顶的木条。象椽子那样大的笔。形容著名的文章。也指有名的作家。","source":{"text":"珣梦人以大笔如椽与之，既觉，语人曰：‘此当有大手笔事。’","book":"《晋书·王珣传》"},"example":{"text":"～指端揽，贝叶行间才数点。","book":"清·陈恭尹《观唐僧贯休画罗汉歌》"},"similar":["如椽大笔"],"usage":"作谓语；用于夸赞别人的文笔","story":["东晋文人王珣从小才思敏捷，胆识过人，20岁时担任大司马桓温的主簿。他经常是口若悬河，下笔成文。一天晚上王珣做了一个梦，梦中有人送给他一支像椽子那样大的笔，预感有大手笔的事情要做。第二天果然被叫去为晋孝武帝写祭文"]},{"id":13544,"word":"大简车徒","pinyin":"dà jiǎn chē tú","abbr":"djct","explanation":"简：检阅；车：战车；徒：指士兵。大规模地检阅军队。","source":{"text":"大阅者何？简车徒也。","book":"《公羊传·桓公六年》"}},{"id":13545,"word":"大纛高牙","pinyin":"dà dào gāo yá","abbr":"ddgy","explanation":"纛：古代军队里的大旗。指军中的旗帜。比喻声势显赫。","source":{"text":"然则高牙大纛，不足为公荣。","book":"宋·欧阳修《相州昼锦堂记》"},"example":{"text":"腐儒半尺毛锥子，～得似君。","book":"明·袁宏道《送君御宪佥治兵甘州》"}},{"id":13546,"word":"大红大紫","pinyin":"dà hóng dà zǐ","abbr":"dhdz","explanation":"形容显赫、得意。","source":{"text":"我看出来，现在干什么也不能大红大紫，除了作官和唱戏！","book":"老舍《四世同堂》"},"example":{"text":"她现在是～的大明星。"},"similar":["大富大贵"],"opposite":["默默无闻"],"usage":"作谓语、宾语、定语；指人发迹出名"},{"id":13547,"word":"大红大绿","pinyin":"dà hóng dà lǜ","abbr":"dhdl","explanation":"指颜色浓艳。","source":{"text":"各处都是新油饰的，大红大绿，象个乡下的新娘子，尽力打扮而怪难受的。","book":"老舍《新时代的旧悲剧》七"},"example":{"text":"她的衣着大红大绿，很远就能认出来。"},"similar":["大红大紫"],"usage":"作宾语、定语；指颜色浓艳"},{"id":13548,"word":"大经大法","pinyin":"dà jīng dà fǎ","abbr":"djdf","explanation":"根本的原则和法规。","source":{"text":"其大经大法，皆亡灭而不救，坏烂而不收。","book":"唐·韩愈《与孟尚书》"},"example":{"text":"《经》云：‘乾道成男，坤道成女，乾坤定而后地平天成；女大须嫁，男大须婚，男女别后夫义妇顺。’这是大圣大贤的～。","book":"《儿女英雄传》第二五回"},"usage":"作宾语、定语；用于书面语"},{"id":13549,"word":"大缪不然","pinyin":"dà miù bù rán","abbr":"dmbr","explanation":"大错特错，完全不是这样。同“大谬不然”。","source":{"text":"太师心知其事大缪不然，为解说于上，请以百口保其无他。","book":"明·张敬修《文忠公行实》"},"similar":["大谬不然"],"usage":"作谓语、宾语；用于书面语"},{"id":13550,"word":"大者为栋梁","pinyin":"dà zhě wéi dòng liáng","abbr":"dzwdl","explanation":"比喻才能大的人可以担负国家重任，为栋梁之才。","source":{"text":"朕自御极以来，亲择群材，大者为栋梁，小者为榱角。","book":"《宋史·张宏传》"}},{"id":13551,"word":"大而化之","pinyin":"dà ér huà zhī","abbr":"dehz","explanation":"化：改变，转变。原指大行其道，使天下化之。后形容做事情不小心谨慎。","source":{"text":"大而化之之谓圣。","book":"《孟子·尽心下》"},"example":{"text":"这些新的又未免太无边际，～了。","book":"朱自清《文心序》"},"similar":["粗枝大叶","马马虎虎"],"opposite":["认认真真"],"usage":"作谓语、宾语；比喻做事马虎"},{"id":13552,"word":"大而无当","pinyin":"dà ér wú dàng","abbr":"dewd","explanation":"当：底。虽然大，却无底。原指大得无边际。后多用作表示大得不切合实际、不合用。","source":{"text":"肩吾问于连叔曰：‘吾闻言于接舆，大而无当，往而不返，吾惊怖其言，犹河汉而无极也。’","book":"《庄子·逍遥游》"},"example":{"text":"要而言之，《全上古秦汉三国六朝文》实在的是～的书，可供陈列而不适于实用的。","book":"鲁迅《书信集·致章廷谦》"},"similar":["硕大无朋","庞然大物","华而不实"],"opposite":["小巧玲珑","短小精悍","具体而微"],"usage":"作谓语、定语；指不着边际","story":["春秋时期，楚国狂士接舆对肩吾说北海有一座姑射仙山，山上的神仙可以让世界五谷丰登。肩吾认为接舆的话大而无当、不近人情，就对连叔说接舆在吹牛。连叔沉思了一会，对肩吾说接舆的话不一定是没有道理的"]},{"id":13553,"word":"大肆厥辞","pinyin":"dà sì jué cí","abbr":"dsjc","explanation":"大肆：毫无顾忌。厥：其，他的。铺张辞藻，大展文才。","source":{"text":"先生不分至高，极天下之书无不尽读，以其所蕴，大肆厥辞。其气韵沉雄如淮阴出师，百战百胜，志不少慑。","book":"明·刘基《〈宋景濂学士文集〉序》"},"similar":["大放厥词","大发议论","夸夸其谈"],"usage":"作谓语、宾语；指大发议论"},{"id":13554,"word":"大肆咆哮","pinyin":"dà sì páo xiào","abbr":"dspx","explanation":"大肆：毫无顾忌；咆哮：愤怒叫喊。指愤怒地大喊大叫。","source":{"text":"败报传到英国，政府党报纸大肆咆哮，‘一致要求实行充分的报复’。","book":"范文澜《中国近代史》上册第四章"},"usage":"作谓语、定语；用于人的状态"},{"id":13555,"word":"大肆宣传","pinyin":"dà sì xuān chuán","abbr":"dsxc","explanation":"极力宣传使大家知道。","example":{"text":"这件丑闻经过报纸～后，使他声望骤降，因此决定退出选举。"},"similar":["大肆宣扬"],"usage":"作谓语；用于事情等"},{"id":13556,"word":"大肆挥霍","pinyin":"dà sì huī huò","abbr":"dshh","explanation":"大肆：任意，放纵。无节制地大量花钱。","source":{"text":"自己依旧大肆挥霍，三千两银子还一个人情债，简直毫无心肝。","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"我们不能大肆挥霍，要注意勤俭节约。"},"similar":["穷奢极侈","铺张浪费"],"opposite":["勤俭节约"],"usage":"作谓语、定语；指挥霍无度"},{"id":13557,"word":"大肆攻击","pinyin":"dà sì gōng jī","abbr":"dsgj","explanation":"用不实或过分之辞对人大加攻击。","example":{"text":"他～她的时髦论调。"},"similar":["大举进攻"],"usage":"作谓语、定语、宾语；指打击"},{"id":13558,"word":"大肆铺张","pinyin":"dà sì pū zhāng","abbr":"dspz","explanation":"为了形式上的好看，不顾一切地过分讲究排场。","example":{"text":"他有大肆铺张的不良习惯。"},"similar":["铺张浪费","铺张浪费"],"opposite":["勤俭节约"],"usage":"作谓语、定语；指盲目张扬浪费"},{"id":13559,"word":"大胆包身","pinyin":"dà dǎn bāo shēn","abbr":"ddbs","explanation":"指胆量极大。","source":{"text":"关云长雄略盖世，赵子龙大胆包身。","book":"元·无名氏《隔江斗智》第四折"},"similar":["胆大包天"],"opposite":["胆小如鼠","胆小怕事"],"usage":"作谓语、定语、状语；用于处事"},{"id":13560,"word":"大胆海口","pinyin":"dà dǎn hǎi kǒu","abbr":"ddhk","explanation":"海口：夸口，说大话。提大着胆子说大话。","source":{"text":"况孤在此城，今已五代，不是大胆海口，孤也颇有个贤名在外。","book":"明·吴承恩《西游记》第八十九回"},"usage":"作谓语、宾语；用于处世"},{"id":13561,"word":"大腹便便","pinyin":"dà fù pián pián","abbr":"dfpp","explanation":"便便：肥胖的样子。形容肥胖的样子。","source":{"text":"边孝先，腹便便。","book":"《后汉书·边韶传》"},"example":{"text":"室如悬磬待遗秉，～乃空洞。","book":"清·姚鼐《王君病起有诗见和因复次韵赠之》"},"similar":["满脑肥肠","心宽体胖"],"opposite":["骨瘦如柴","面黄肌瘦"],"usage":"作谓语、定语；形容官僚等","story":["东汉时河南读书人边绍，字孝先，学识渊博，天文地理都懂，给学生上课时口若悬河、滔滔不绝，深受学生爱戴。一次在讲《论语》时因疲劳而打瞌睡，学生编顺口溜讥笑他肚皮肥大，他回敬顺口溜说自己肚皮大是因为装满了经书"]},{"id":13562,"word":"大节不可夺","pinyin":"dà jié bù kě duó","abbr":"djbkd","explanation":"大节：临难不苟的节操；夺：强取。指立身处世的节操不能被改变。","source":{"text":"临大节而不可夺也。","book":"春秋·鲁·孔丘《论语·泰伯》"},"similar":["大节不夺"],"usage":"作宾语、定语；用于处世"},{"id":13563,"word":"大节不夺","pinyin":"dà jié bù duó","abbr":"djbd","explanation":"大节：临难不苟的节操；夺：丧失。指面临生死关头，仍不改变其原来志向。","source":{"text":"临大节而不可夺也。","book":"《论语·泰伯》"},"similar":["大节不可夺"],"opposite":["卑躬屈节"],"usage":"作定语；指有气节"},{"id":13564,"word":"大莫与京","pinyin":"dà mò yǔ jīng","abbr":"dmyj","explanation":"莫：没有谁；京：大。指大得无法相比。","source":{"text":"八世之后，莫之与京。","book":"《左传·庄公二十二年》"}},{"id":13565,"word":"大获全胜","pinyin":"dà huò quán shèng","abbr":"dhqs","explanation":"获：擒获俘虏，夺取敌方辎重；全：完全。形容获得完全的胜利。","source":{"text":"玄德大获全胜，引军入樊城，县令刘泌出现。","book":"明·罗贯中《三国演义》第三十六回"},"example":{"text":"请伏兵于河口，乘其将济而击之，必～。","book":"明·冯梦龙《东周列国志》第四十八回"},"similar":["胜利而归"],"opposite":["一败涂地"],"usage":"作谓语；指取得全部胜利"},{"id":13566,"word":"大行不顾细谨","pinyin":"dà xíng bù gù xì jǐn","abbr":"dxbgxj","explanation":"大行：行大事。做大事不顾琐细小节。","source":{"text":"大行不顾细谨，大礼不辞小让。","book":"《史记·项羽本纪》"}},{"id":13567,"word":"大行受大名","pinyin":"dà xíng shòu dà míng","abbr":"dxsdm","explanation":"行：品行，德行。有大的德行，一定有大的名声。"},{"id":13568,"word":"大行大市","pinyin":"dà háng dà shì","abbr":"dhds","explanation":"指商品的一般市场价格。","source":{"text":"贵啥子？大行大市的。","book":"周克芹《许茂和他的女儿们》第五章"},"example":{"text":"周克芹《许茂和他的女儿们》第五章：“贵啥子？～的。”"},"usage":"作宾语、定语；用于口语"},{"id":13569,"word":"大衍之数","pinyin":"dà yǎn zhī shǔ","abbr":"dyzs","explanation":"大：大数；衍：演；大衍：指运用大数来演卦。指五十。","source":{"text":"大衍之数五十。","book":"《周易·系辞》"},"usage":"作宾语；指五十"},{"id":13570,"word":"大街小巷","pinyin":"dà jiē xiǎo xiàng","abbr":"djxx","explanation":"城镇里的街道里弄，概指都市里的各处地方。","source":{"text":"正月十五日，上元佳节，好生晴朗，黄昏月上，六街三市，各处坊隅巷陌，点花放灯，大街小巷，都有社火。","book":"明·施耐庵《水浒全传》第六十六回"},"example":{"text":"吃了早饭，摇个串玲上行走去了，～乱走一气。","book":"清·刘鹗《老残游记》第十九回"},"similar":["街头巷尾","四面八方"],"usage":"作主语、定语、宾语；常与方位连用"},{"id":13571,"word":"大衾长枕","pinyin":"dà qīn cháng zhěn","abbr":"dqzz","explanation":"衾：被子。共倚长枕，同拥大被。形容夫妻恩爱。后比喻兄弟友爱。","source":{"text":"玄宗为太子，尝制大衾长枕，将与诸王共之。","book":"《新唐书·让皇帝宪传》"},"similar":["长枕大衾"],"usage":"作谓语、宾语、定语；比喻兄弟友爱"},{"id":13572,"word":"大言不惭","pinyin":"dà yán bù cán","abbr":"dybc","explanation":"说大话，不感到难为情。","source":{"text":"大言不惭，则无必为之志，而不自度其能否也。欲践其言，其不难哉！","book":"《论语·宪问》：“子曰：‘其言之不怍，则为之也难。’”宋·朱熹注"},"example":{"text":"严知孝听他这个得意的学生～的说着，脸上的愁闷就散开了。","book":"梁斌《红旗谱》四二"},"similar":["大吹大擂","自卖自夸","出言不逊"],"opposite":["不露锋芒","自惭形秽","妄自菲薄"],"usage":"作谓语、定语、状语、宾语；指不害臊"},{"id":13573,"word":"大言欺人","pinyin":"dà yán qī rén","abbr":"dyqr","explanation":"说大话欺骗人。","source":{"text":"军败于当阳，詈穷于夏口，亘亘求救于人而犹言不惧，此真大言欺人也。","book":"明·罗贯中《三国演义》第四十三回"},"example":{"text":"弟向来猖狂自恣，～，中实无有。近始追悔昨非，略思究竟实学。","book":"清·归庄《答梁公狄》"},"opposite":["言而有信"],"usage":"作宾语、定语；指欺骗"},{"id":13574,"word":"大言相骇","pinyin":"dà yán xiāng hài","abbr":"dyxh","explanation":"骇：惊吓，震惊。说大话，吓唬别人。","source":{"text":"他觑俺似婴孩，大言相骇。","book":"明·孙仁孺《东郭记》"},"usage":"作谓语、宾语；用于处世"},{"id":13575,"word":"大计小用","pinyin":"dà jì xiǎo yòng","abbr":"djxy","explanation":"用于大事的计策，结果只用在小事情上。表示计策没有充分发挥作用。","source":{"text":"孔明连夜驱兵，真出祁山前下寨，收住军兵，重赏姜维。维曰：‘某恨不得杀曹真也！’孔明亦曰：‘可惜大计小用矣。’","book":"明·罗贯中《三国演义》第九十七回"},"similar":["大材小用"],"usage":"作宾语；指运用不当"},{"id":13576,"word":"大请大受","pinyin":"dà qǐng dà shòu","abbr":"dqds","explanation":"指优厚的待遇。","source":{"text":"他现在帐下听使唤，大请大受，怎敢恶了太尉？","book":"《水浒传》第七回"},"example":{"text":"我又不是杨老佛、杨奶奶，你有本事到他那里，享用他～，缠我怎的？","book":"《平妖传》第七回"},"usage":"作谓语、宾语；用于待遇等"},{"id":13577,"word":"大谋不谋","pinyin":"dà móu bù móu","abbr":"dmbm","explanation":"具有远大谋略的人，表面上好像看不出谋略。","source":{"text":"大谋不谋，大勇不勇。","book":"《六韬·武韬·发启》"},"similar":["大智若愚"],"usage":"作宾语、定语；用于为人"},{"id":13578,"word":"大谬不然","pinyin":"dà miù bù rán","abbr":"dmbr","explanation":"谬：荒谬，错误；然：如此，这样。大错特错，完全不是这样。","source":{"text":"而事乃有大谬不然者夫。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"从表面看，似乎既称红军，就可以不要党代表了，实在～。","book":"《毛泽东选集·井岗山的斗争》"},"similar":["大错特错","荒谬绝伦","荒诞不经"],"opposite":["不刊之论","千真万确","天经地义"],"usage":"作谓语、宾语；用于书面语","story":["西汉时期，著名的史学家司马迁因汉将李陵攻打匈奴失败被迫投降一事，为李陵说了情，遭到了宫刑并被关入大牢，面对这奇耻大辱，他只好给好友任安写信倾诉他的不幸：“身非木石，独与法吏为伍。”自己的忠心反而受摧残，真是大谬不然"]},{"id":13579,"word":"大贤虎变","pinyin":"dà xián hǔ biàn","abbr":"dxhb","explanation":"虎变：如虎身花纹的变化。比喻居上位者出处行动变化莫测。","source":{"text":"大人虎变，未占有孚。","book":"《周易·革》"},"example":{"text":"～愚不测，当年颇似寻常人。","book":"唐·李白《梁父吟》"},"similar":["大人虎变"],"usage":"作宾语、定语；比喻居高位者行动变化莫测"},{"id":13580,"word":"大败亏轮","pinyin":"dà bài kuī lún","abbr":"dbkl","explanation":"遭到很大的失败和损失。"},{"id":13581,"word":"大败亏输","pinyin":"dà bài kuī shū","abbr":"dbks","explanation":"亏输：遭受损失，输给别人。打了败仗，损失很大。","source":{"text":"某见唐元帅大败亏输，忙差尉迟恭接应唐元帅去了，未知输赢胜败。","book":"元·尚仲贤《单鞭夺槊》第四折"},"example":{"text":"北军～，五千军马杀死大半，其余四散逃窜。","book":"明·施耐庵《水浒全传》第九十九回"},"similar":["损兵折将"],"opposite":["大获全胜"],"usage":"作谓语；指损失很大"},{"id":13582,"word":"大败涂地","pinyin":"dà bài tú dì","abbr":"dbtd","explanation":"一旦失败就肝脑涂地。形容失败到了不可收拾的地步。","source":{"text":"天下方扰，诸侯并起，今置将不善，壹败涂地。吾非敢自爱，恐能薄，不能完父兄子弟，此大事，愿更相推择可者。","book":"《史记·高祖本纪》"},"example":{"text":"执叶、缪之余习，狃而不变，势不至～不止也。","book":"清·蒲松龄《聊斋志异·郭生》"}},{"id":13583,"word":"大败而逃","pinyin":"dà bài ér táo","abbr":"dbet","explanation":"指吃了败仗慌张逃跑。","source":{"text":"那庞集亲自领兵追来，被我姑嫂两个与庞家血战山坡，杀得他兵残将损，大败而逃。","book":"清·无名氏《说呼全传》第11回"},"example":{"text":"敌人被打得～。"},"similar":["落荒而逃"],"opposite":["凯旋而归"],"usage":"作谓语、状语；指败逃"},{"id":13584,"word":"大费周折","pinyin":"dà fèi zhōu zhé","abbr":"dfzz","explanation":"周折：曲折，不顺利。指事情复杂，办起来非常困难。","source":{"text":"惟恐他别生枝叶，那时更难拿获，到要大费周折呢。","book":"清·石玉昆《三侠五义》第三十九回"},"similar":["大费周章"],"opposite":["手到擒来"],"usage":"作谓语、宾语；用于处事"},{"id":13585,"word":"大起大落","pinyin":"dà qǐ dà luò","abbr":"dqdl","explanation":"大幅度地起落。形容变化大。","source":{"text":"她的喜怒哀乐都是大起大落，整出整落的。","book":"老舍《四世同堂》"},"example":{"text":"他的一生多次都是～的。"},"similar":["坎坷不平"],"opposite":["一帆风顺"],"usage":"作主语、宾语、定语；指变化很大"},{"id":13586,"word":"大跌眼镜","pinyin":"dà diē yǎn jìng","abbr":"ddyj","explanation":"指对出乎意料的结果或不可思议的事物感到非常惊讶。"},{"id":13587,"word":"大路椎轮","pinyin":"dà lù zhuī lún","abbr":"dlzl","explanation":"大辂，古代华美的大车。椎轮，无辐条的原始车轮。指大辂由椎轮逐步演变而成，比喻事物的进化，由简到繁，由粗至精。后人亦称始创者为大辂椎轮。","source":{"text":"若夫椎轮为大辂之始，大辂宁有椎轮之质。","book":"南朝·梁·萧统《〈文选〉序》"},"example":{"text":"及国朝徐继畲、魏源氏译述《瀛环志略》、《海国图志》，乃始罗略东西洋欧美诸国，虽有疏阙，然～之功，不可泯也。","book":"清·沈惟贤《〈万国演义〉序》"}},{"id":13588,"word":"大车以载","pinyin":"dà chē yǐ zài","abbr":"dcyz","explanation":"大车材坚，能载重物。比喻人有大材，能够胜重任。","source":{"text":"大车以载，有攸往无咎。","book":"《易经·大有》"},"usage":"作谓语、定语；指人能胜任"},{"id":13589,"word":"大车无輗","pinyin":"dà chē wú ní","abbr":"dcwn","explanation":"輗：大车辕端与衡接的部分。大车无輗，则难以前进。比喻人若无信，则难以立足于社会。","source":{"text":"子曰：‘人而无信不知其可也。大车无輗，小车无軏，其何以行之哉？’","book":"《论语·为政》"},"usage":"作宾语、定语；用于劝诫人"},{"id":13590,"word":"大辂椎轮","pinyin":"dà lù zhuī lún","abbr":"dlzl","explanation":"大辂：古代大车；椎轮：无辐原始车轮。华美的大车是从无辐车轮的原始车开始的。比喻事物的进化，是从简到繁，从粗到精。","source":{"text":"若夫椎轮为大辂之始，大辂宁有椎轮之质？","book":"南朝·梁·萧统《文选序》"},"example":{"text":"然～之功，不可泯也。","book":"清·沈惟贤《万国演义序》"},"similar":["开山鼻祖"],"usage":"作宾语、定语；用于称始创者"},{"id":13591,"word":"大辩不言","pinyin":"dà biàn bù yán","abbr":"dbby","explanation":"大辩：善于辩论。有口才、善于辩论的人，并不多说话以显示自己。","source":{"text":"大辩不言，大仁不仁。","book":"战国·宋·庄周《庄子·齐物论》"},"example":{"text":"他显示出～沉稳的个性。"},"similar":["深藏不露","大辩若讷"],"usage":"作宾语、定语；指人沉稳"},{"id":13592,"word":"大辩若讷","pinyin":"dà biàn ruò nè","abbr":"dbrn","explanation":"讷：语言迟钝，不善于讲话。真正有口才的人表面上好像嘴很笨。表示善辩的人发言持重，不露锋芒。","source":{"text":"大真若屈，大巧若拙，大辩若讷。","book":"春秋·楚·李耳《老子》第45章"},"example":{"text":"～，历官有声。是司出纳，我庾如京。","book":"唐·杨炯《梓州官僚赞》"},"similar":["大辩不言","大智若愚"],"usage":"作宾语、定语；指人沉稳"},{"id":13593,"word":"大逆不道","pinyin":"dà nì bù dào","abbr":"dnbd","explanation":"逆：叛逆；道：指封建道德；不道：违反封建道德。旧时统治阶级对破坏封建秩序的人所加的重大罪名。","source":{"text":"为妖恶言，大逆不道，请逮捕治。","book":"《史记·高祖本纪》：“天下所不容，大逆无道。”《汉书·杨恽传》"},"example":{"text":"汝赖吾玉玺，僭称帝号，背反汉室，～！吾方欲加兵问罪，岂肯反助贼乎！","book":"明·罗贯中《三国演义》第十七回"},"similar":["犯上作乱","罪大恶极","罪孽深重"],"opposite":["忠心耿耿","唯命是从"],"usage":"作谓语、宾语、定语；用于指叛逆","story":["秦朝末年，楚汉相争，楚军与汉军在广武城相遇，项羽想与刘邦单独角斗来结束战事，刘邦死活不肯应战，只是列举项羽十大罪状，说项羽是大逆不道。项羽气得浑身发抖，命令士兵向汉军放箭，刘邦中箭，汉军只好退回皋城防守"]},{"id":13594,"word":"大逆无道","pinyin":"dà nì wú dào","abbr":"dnwd","explanation":"封建时代称犯上作乱等重大罪行。","source":{"text":"今项羽放杀义帝于江南，大逆无道。","book":"《史记·高祖本纪》"},"example":{"text":"昔以革命为～，去之若浼者，至是也稍知动念矣。","book":"孙中山《自传》"},"similar":["大逆不道"],"usage":"作谓语、宾语、定语；用于指叛逆"},{"id":13595,"word":"大酒大肉","pinyin":"dà jiǔ dà ròu","abbr":"djdr","explanation":"指菜肴丰盛，大吃大喝。","source":{"text":"一有钱钞在手，三兄四弟，终日大酒大肉同吃。","book":"明·施耐庵《水浒传》第101回"},"example":{"text":"他每天都是～的吃喝。"},"similar":["大吃大喝"],"opposite":["粗茶淡饭"],"usage":"作宾语、定语；指吃喝"},{"id":13596,"word":"大酺三日","pinyin":"dà pū sān rì","abbr":"dpsr","explanation":"酺：聚饮。封建帝王为表示欢庆，特许民间举行大聚饮三天。后用以表示大规模庆贺。","source":{"text":"赐饶安田租，勃海郡百户牛酒，大酺三日。","book":"《三国志·魏志·文帝纪》：“饶安县言白雉见。”裴松之注引《魏书》"},"example":{"text":"十一月二十八日为始，至三十日为止，举行庆贺协国战胜国大会，居然有古时～的遗意。","book":"蔡东藩、许廑父《民国通俗演义》第一百回"},"usage":"作谓语、宾语；用于犒赏等"},{"id":13597,"word":"大醇小疵","pinyin":"dà chún xiǎo cī","abbr":"dcxc","explanation":"醇：纯正；疵：毛病。大体纯正，而略有缺点。","source":{"text":"荀与扬，大醇而小疵。","book":"唐·韩愈《读〈荀子〉》"},"example":{"text":"知其有醇乎醇者，有大醇而小疵者也。","book":"清·陈澧《与周孟贻书》"},"similar":["白壁微瑕"],"opposite":["白璧无瑕","完美无缺"],"usage":"作谓语、定语；指大体纯正但略有欠缺"},{"id":13598,"word":"大锅饭","pinyin":"dà guō fàn","abbr":"dgf","explanation":"用大锅烧的供很多人吃的饭菜。比喻分配上的极端平均主义。","source":{"text":"像黄原这样的贫困山区，如果不砸烂大锅饭，实行生产责任制，就不可能寻找另外的出路。","book":"路遥《平凡的世界》第三卷第四章"},"usage":"作主语、宾语、定语；用于生活等"},{"id":13599,"word":"大错特错","pinyin":"dà cuò tè cuò","abbr":"dctc","explanation":"强调错误到极点。","source":{"text":"如今想来，真是大错特错！","book":"清·曾朴《孽海花》第25回"},"example":{"text":"现在我们进了牢狱便是‘得仁’，那是～！","book":"邹韬奋《经历》五十"},"similar":["大谬不然"],"opposite":["千真万确"],"usage":"作谓语、定语；指完全错了"},{"id":13600,"word":"大锣大鼓","pinyin":"dà luó dà gǔ","abbr":"dldg","explanation":"形容大肆宣扬。","source":{"text":"我们一方面看着有些人替罗斯福‘复兴计划’大锣大鼓地吹着，一方面再看看所谓‘御用工会’的潜势力。","book":"邹韬奋《萍踪忆语》"},"example":{"text":"他们～闹了这么一场，作用不是很大。"},"similar":["大张旗鼓"],"opposite":["悄无声息"],"usage":"作定语、状语；用于做事"},{"id":13601,"word":"大门不出，二门不迈","pinyin":"dà mén bù chū，èr mén bù mài","abbr":"dmbcembm","explanation":"迈：举步走出。指从来不出家门与外人接触。","source":{"text":"我一个妇道人家，大门不出，二门不迈，哪来的熟人。","book":"陶承《我的一家》九"}},{"id":13602,"word":"大门不出，二门不进","pinyin":"dà mén bù chū，èr mén bù jìn","abbr":"dmbcembj","explanation":"指呆在家里不外出，引申为没见过世面。","example":{"text":"跟她这个～的人说不清。"},"similar":["大门不出，二门不迈"],"usage":"作谓语、宾语、定语；用于口语"},{"id":13603,"word":"大限临头","pinyin":"dà xiàn lín tóu","abbr":"dxlt","explanation":"大限：生命的极限。指死期。用以指寿数已尽，注定死亡的期限落到身上。","source":{"text":"若是你为官称了平生志，有一日大限临头，那时若你个小解元得为官，将你这双老爷娘放心死。","book":"元·无名氏《施仁义刘弘嫁婢》第三折"}},{"id":13604,"word":"大院深宅","pinyin":"dà yuàn shēn zhái","abbr":"dysz","explanation":"深：指由内到外的距离大。房屋众多，庭院深广。多指富贵人家的住宅。","source":{"text":"大院深宅，闲杂人赶离门外。","book":"元·岳伯川《铁拐李》第四折"},"similar":["深宅大院"],"usage":"作主语、宾语、定语；指富贵人家的住宅"},{"id":13605,"word":"大隐朝市","pinyin":"dà yǐn cháo shì","abbr":"dycs","explanation":"朝市：朝廷和市集，泛指人口稠密的热闹之处。指大彻大悟的隐士，不必隐居大山，大闹市也可隐居。","source":{"text":"小隐隐陵薮，大隐隐朝市。伯夷窜首阳，老聃伏柱史。","book":"晋·王康琚《反招隐诗》"},"example":{"text":"～，本无车马之喧，不出户庭，坐得云霄之致。","book":"唐·杨炯《李舍人山亭诗序》"},"usage":"作宾语、定语；指隐居"},{"id":13606,"word":"大难不死","pinyin":"dà nàn bù sǐ","abbr":"dnbs","explanation":"难：灾祸。遇到巨大的灾难而没有死掉。形容幸运地脱险。","source":{"text":"夫人云：皆是先生阴德太重，救我一家之命。因此遇大难不死，必有后程，准定发迹也。","book":"元·关汉卿《裴度还带》第三折"},"example":{"text":"～，必有后禄。","book":"明·冯梦龙《喻世明言》卷二十一"},"similar":["大难不死，必有后福"],"usage":"作谓语；形容幸运地脱险"},{"id":13607,"word":"大难不死，必有后禄","pinyin":"dà nàn bù sǐ，bì yǒu hòu lù","abbr":"dnbsbyhl","explanation":"难：灾祸。遇到巨大的灾难而没有死掉，将来必定有幸福","source":{"text":"所以说：‘贵人无死法。’又说：‘大难不死，必有后禄。’","book":"明·冯梦龙《喻世明言》第21卷"},"similar":["大难不死，必有后福"],"usage":"作宾语、定语、分句；用于安慰人"},{"id":13608,"word":"大难不死，必有后福","pinyin":"dà nàn bù sǐ，bì yǒu hòu fú","abbr":"dnbsbyhf","explanation":"难：灾祸。遇到巨大的灾难而没有死掉，将来必定有幸福。","source":{"text":"常言道，大难不死，必有后福。我想我的后半截该会越来越好了。","book":"余华《活着》"},"similar":["大难不死，必有后禄"],"usage":"作宾语、定语、分句；用于安慰人"},{"id":13609,"word":"大难临头","pinyin":"dà nàn lín tóu","abbr":"dnlt","explanation":"难：灾祸；临：来到。大祸落到头上。","source":{"text":"临大难而不惧者，圣人之勇也。","book":"战国·宋·庄周《庄子·秋水》"},"example":{"text":"他仿佛已经有什么～似的，说话有些口吃了，声音也发着抖。","book":"鲁迅《彷徨·弟兄》"},"similar":["祸从天降","大祸临头"],"opposite":["双喜临门","大喜过望","喜出望外"],"usage":"作谓语、定语；指有灾难发生"},{"id":13610,"word":"大雅之堂","pinyin":"dà yǎ zhī táng","abbr":"dyzt","explanation":"高雅的厅堂。比喻高的要求，完美的境界。","source":{"text":"未登大雅之堂，还望刺史陶冶而成全之。","book":"清·袁枚《与陈刺史虚斋》"},"example":{"text":"他是难登～的。"},"usage":"作宾语；常与“登”连用"},{"id":13611,"word":"大雅君子","pinyin":"dà yǎ jūn zǐ","abbr":"dyjz","explanation":"大雅：对品德高尚，才学优异者的赞词。君子：泛指有才德的人。指有才德的人。","source":{"text":"君子之至于斯也，吾未尝不得见也。","book":"《汉书·景十三王传赞》：“夫唯大雅，卓尔不群，河间献王之矣。”《论语·八佾》"},"example":{"text":"《汉书·景十三王传赞》：“夫唯大雅，卓尔不群，河间献王之矣。”《论语·八佾》：“君子之至于斯也，吾未尝不得见也。”"},"similar":["大雅宏达"],"usage":"作主语、宾语、定语；指贤人"},{"id":13612,"word":"大雅宏达","pinyin":"dà yǎ hóng dá","abbr":"dyhd","explanation":"大雅：宏达雅正；宏达：才识广博通达。指宏达雅正才德高尚的人。","source":{"text":"又有承明金马，著作之庭，大雅宏达，于兹为群。","book":"东汉·班固《西都赋》"},"similar":["大雅君子"],"usage":"作主语、宾语、定语；指贤人"},{"id":13613,"word":"大雅扶轮","pinyin":"dà yǎ úf lún","abbr":"dyfl","explanation":"大雅：《诗经》中的一部分；扶轮：在车轮两翼护持。指维护扶持正统的作品，使其得以推行和发展。","source":{"text":"知公独有千秋意，造土皆成一代才。大雅扶轮归老辈，小山承盖属舆台。","book":"清·黄景仁《两当轩集·寿州赠知州张荪甫先生》"}},{"id":13614,"word":"大雨倾盆","pinyin":"dà yǔ qīng pén","abbr":"dyqp","explanation":"雨大得象盆里的水直往下倒。形容雨大势急。","source":{"text":"白帝城中云出门，白帝城下雨翻盆。","book":"唐·杜甫《白帝》诗"},"example":{"text":"倏忽间四边黑云陡合，～。","book":"明·徐渭《英烈传》第十四回"},"similar":["大雨滂沱","倾盆大雨"],"usage":"作谓语、定语；形容雨下得很大"},{"id":13615,"word":"大雨如注","pinyin":"dà yǔ rú zhù","abbr":"dyrz","explanation":"注：灌入。形容寸下得很大，雨水象往下灌似的。","source":{"text":"偶然风狂浪涌，大雨如注，舟楫不能前进，泊于山崖之下。","book":"明·冯梦龙《警世通言·俞伯牙摔琴谢知音》"},"example":{"text":"又三日，率众诅龙潭，以激神怒，～。","book":"明·朱国桢《涌幢小品·山子道气》"},"similar":["大雨倾盆"],"usage":"作谓语、定语；形容雨下得很大"},{"id":13616,"word":"大雨滂沱","pinyin":"dà yǔ páng tuó","abbr":"dypt","explanation":"滂沱：雨大而多的样子。形容寸下得很大。","source":{"text":"行了数日，忽值大雨滂沱，行装尽湿。","book":"明·罗贯中《三国演义》第28回"},"example":{"text":"及至古北口，～，荣禄振起精神。","book":"王清沅《清宫十三朝》"},"similar":["倾盆大雨"],"usage":"作谓语、定语；形容雨下得很大"},{"id":13617,"word":"大雪纷飞","pinyin":"dà xuě fēn fēi","abbr":"dxff","explanation":"纷：多而杂乱。雪片大量飘落的样子。形容雪下得大。","source":{"text":"在江浙，倘要说出‘大雪纷飞’的意思来……大抵用‘凶’，‘猛’或‘厉害’，来形容这下雪的样子。","book":"鲁迅《“大雪纷飞”》"},"example":{"text":"在这～的天气里，我们最好呆在屋子里。"},"usage":"作谓语、定语；指下大雪"},{"id":13618,"word":"大露头角","pinyin":"dà lù tóu jiǎo","abbr":"dltj","explanation":"头角：指人的气概与才华；露头角：比喻人显露才能。比喻人很好地显露了一回才能。","example":{"text":"你这次可算～，风光了一回。"},"similar":["大显身手"],"usage":"作谓语、定语、宾语；指展示自己"},{"id":13619,"word":"大音希声","pinyin":"dà yīn xī shēng","abbr":"dyxs","explanation":"指最大最美的声音乃无声之音。","source":{"text":"听之不闻名曰希，不可得闻之音也。有声则有分，有分则不宫而商矣。分则不能统众，故有声者非大音也。","book":"《老子》：“大音希声，大象无形。”王弼注"},"usage":"作宾语、定语；用于书面语"},{"id":13620,"word":"大音稀声","pinyin":"dà yīn xī shēng","abbr":"dyxs","explanation":"最大最美的声音乃是无声之音。","source":{"text":"大音稀声，大象无形。","book":"《老子》"}},{"id":13621,"word":"大题小作","pinyin":"dà tí xiǎo zuò","abbr":"dtxz","explanation":"将磊韪写成小文章。比喻把重大问题当作小事情来处理。","source":{"text":"这篇作品不是小题大作，而是大题小作，篇幅不长，而意义很大。","book":"老舍《读〈套不住的手〉》"},"example":{"text":"对这事要审慎考量，切勿大题小作，草率行事！"},"opposite":["小题大做"],"usage":"作谓语、宾语；指故意做作"},{"id":13622,"word":"大题小做","pinyin":"dà tí xiǎo zuò","abbr":"dtxz","explanation":"把大题目作成小文章。比喻把重大的问题当做小事情来处理。","source":{"text":"但是千百年来已非一日，载籍浩如烟海，门外摸索，不得象尾，而且鬼界的问题似乎也多得很，尽够研究院里先生们一生的检讨，我这里只提出一个题目，即上面所说的鬼之生长，姑且大题小做，略陈管见，仁候明教。","book":"周作人《鬼的生长》"},"example":{"text":"这种打算实在是太幼稚，对国事言太近于“～”，对文学言又像太近于“小题大作”了。","book":"《沈从文传》"}},{"id":13623,"word":"大风之歌","pinyin":"dà fēng zhī gē","abbr":"dfzg","explanation":"指汉高祖的《大风歌》。比喻英雄人物的豪情壮志。","source":{"text":"乐思回斜日，歌词继《大风》。","book":"唐·宋之问《奉和长安故城未央宫应制》"},"example":{"text":"他激动地唱起～。"},"usage":"作宾语；用于英雄等","story":["西汉初年，刘邦平定天下后巡视全国，回到家乡沛县，他大摆宴席款待亲朋好友，在酒宴上击筑唱起《大风歌》：“大风起兮云飞扬，威加海内兮归故乡，安得猛士兮守四方！”然后将沛县作为他的汤沐邑，世代不收赋税"]},{"id":13624,"word":"大风大浪","pinyin":"dà fēng dà làng","abbr":"dfdl","explanation":"指巨大的风浪。比喻社会的大动荡、大变化。也比喻尖锐、复杂、激烈、艰苦的斗争。","source":{"text":"叫他看看我每日大风大浪，却还要好过。","book":"清·李绿园《歧路灯》第六十九回"},"example":{"text":"然而她到底是经过无数～的，深知躲避不了的烦恼，只有昂起头来硬顶。","book":"高阳《母子君臣》"},"similar":["狂风巨浪"],"opposite":["风平浪静"],"usage":"作主语、宾语、定语；指斗争激烈"},{"id":13625,"word":"大风有隧","pinyin":"dà fēng yǒu suì","abbr":"dfys","explanation":"隧：道路。在风吹来自有它的来路。比喻好或坏的行为自有其根本。","source":{"text":"大风有隧，有空大谷。","book":"《诗经·大雅·桑柔》"}},{"id":13626,"word":"大饮长歠","pinyin":"dà yǐn cháng chuò","abbr":"dyzc","explanation":"歠：吸，喝。大口大口地喝。","source":{"text":"魏都守曲阜，食饮兼人。每赐食于前，大饮长歠。左右相属，数人益之乃供，太祖壮之。","book":"宋·叶廷珪《海录碎事·帝王》"}},{"id":13627,"word":"大饱眼福","pinyin":"dà bǎo yǎn fú","abbr":"dbyf","explanation":"指有机会充分欣赏珍奇或美好的事物。","opposite":["意犹未尽"]},{"id":13628,"word":"大马金刀","pinyin":"dà mǎ jīn dāo","abbr":"dmjd","explanation":"①形容豪爽，气派大。②形容说话直率锋利，不留情面。","source":{"text":"那姑娘大马金刀的坐在上面，反眉一皱，说：‘你怎么这么俗啊？起来！’","book":"《儿女英雄传》第八回"},"example":{"text":"您再别说甚么野蛮文明，安国堤起这两个字儿，已受了一顿～儿的申斥，不是嘴里会辩，恐怕脑袋儿都靠不住。","book":"清·汉血愁予《崖山哀·汉奸》"},"usage":"作宾语、定语、状语；用于人"},{"id":13629,"word":"大鱼吃小鱼","pinyin":"dà yú chī xiǎo yú","abbr":"dycxy","explanation":"比喻以大欺小，以强凌弱。","source":{"text":"大之伐小，强之伐弱，犹大鱼之吞小鱼也。","book":"汉·刘向《说苑·指武》"},"example":{"text":"看情况，黑虎星一定还害怕咱们在此地住久了，会对他～。","book":"姚雪垠《李自成》第一卷第十四章"},"similar":["弱肉强食"],"usage":"作宾语、定语；用于竞争"},{"id":13630,"word":"大鱼大肉","pinyin":"dà yú dà ròu","abbr":"dydr","explanation":"指美好丰盛的饮食。形容菜肴丰盛。","source":{"text":"大鱼大肉，热酒热饭，只顾搬将出来。","book":"明·冯梦龙《警世通言》第21卷"},"example":{"text":"清·荑荻散人《玉娇梨》第16回：“多卖几亩田，做个财主，～，好不受用。”"},"similar":["大肉大鱼","肥肉厚酒"],"opposite":["家常便饭","粗茶淡饭"],"usage":"作主语、宾语、定语；用于生活"},{"id":13631,"word":"大鸣大放","pinyin":"dà míng dà fàng","abbr":"dmdf","explanation":"鸣：有所发抒；放：发出，开出。指群众在对某些重大问题的看法上可以充分发表自己的意见。"},{"id":13632,"word":"天上人间","pinyin":"tiān shàng rén jiān","abbr":"tsrj","explanation":"一个在天上，一个在人间。多比喻境遇完全不同。","source":{"text":"仙裙玉佩空自知，天上人间不相见。","book":"唐·崔颢《七夕词》"},"example":{"text":"流水落花春去也，～。","book":"南唐·李煜《浪淘沙》词"},"similar":["人间天上"],"opposite":["不相上下"],"usage":"作宾语、定语；用于人的感伤"},{"id":13633,"word":"天上地下，惟我独尊","pinyin":"tiān shàng dì xià，wéi wǒ dú zūn","abbr":"tsdxwwdz","explanation":"惟：只有；尊：尊贵。佛家语。原是推崇释迦尼牟最为崇高伟大的意思。后形容目空一切，极端狂妄自大。","source":{"text":"世尊才生下，乃一手指天，一手指地，周行七步，目顾四方曰：‘天上地下，惟吾独尊。’","book":"宋·释普济《五灯会元》卷一"},"example":{"text":"当其新识骤得，踊跃狂喜，亦有～之势，皆智之为也。","book":"清·康有为《大同书》甲部"},"similar":["天上天下，惟我独尊"],"usage":"作宾语、定语；用于处世等"},{"id":13634,"word":"天上天下，惟我独尊","pinyin":"tiān shàng tiān xià，wéi wǒ dú zūn","abbr":"tstxwwdz","explanation":"惟：只有；尊：地位或辈分高。形容人妄自尊大，目空一切。","source":{"text":"天上天下，惟我独尊。","book":"《敦煌变文集·太子成道经》第一卷"},"example":{"text":"～。","book":"宋·释普济《五灯会元·佛释迦牟尼》"},"similar":["天上地下，惟我独尊"],"usage":"作宾语、定语；用于处世等"},{"id":13635,"word":"天上少有，地下难寻","pinyin":"tiān shàng shǎo yǒu，dì xià nán xún","abbr":"tssydxnx","explanation":"形容极其少有，珍贵。","source":{"text":"上能天文，下察地理，这样先生，天上少有，地下难寻。","book":"清·李绿园《歧路灯》第八回"},"example":{"text":"若据他说，自然是～。不过他说你五妹六妹都见过的，他们而且极是赞成。","book":"张恨水《金粉世家》第四十三回"},"usage":"作谓语、定语；多用于口语"},{"id":13636,"word":"天上无双","pinyin":"tiān shàng wú shuāng","abbr":"tsws","explanation":"天上也没有第二个。","source":{"text":"向来见桂心谈说十娘，天上无双，人间有一。","book":"唐·张文成《游仙窟》"},"example":{"text":"只是这受祭的阴魂虽不知名姓，想来自然是那人间有一、～，极聪明极俊雅的一位姐姐妹妹了。","book":"清·曹雪芹《红楼梦》第四十三回"}},{"id":13637,"word":"天上石麟","pinyin":"tiān shàng shí lín","abbr":"tssl","explanation":"旧时称人有文采的儿子。","source":{"text":"年数岁，家人携以候沙门释宝志，宝志摩其顶曰：‘天上石麒麟也。’","book":"《南史·徐陵传》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“～，夸小儿之迈众；人中骐骥，比君子之超凡。”"},"similar":["天上麒麟"],"usage":"作宾语；用于称赞别人的儿子","story":["南北朝时期，著名文学家徐陵自幼聪明绝顶，8岁就能写漂亮的文章，13岁就精通老子、庄子的学说，被当时人们称为神童，经常受到人们的称赞。几岁时一个叫宝志的客人见到他后连夸他是天上的玉麒麟"]},{"id":13638,"word":"天上麒麟","pinyin":"tiān shàng qí lín","abbr":"tsql","explanation":"麒麟：传说中的神兽。称赞他人之子有文才。","source":{"text":"年数岁，家人携以候沙门释宝志，宝志摩其顶曰：‘天上石麒麟也。’","book":"《南史·徐陵传》"},"example":{"text":"～原有种。","book":"明·世宗《送毛伯温》"},"similar":["天上石麟"],"usage":"作主语、宾语；指称人有文采的儿子"},{"id":13639,"word":"天下一宗","pinyin":"tiān xià yī zōng","abbr":"txyz","explanation":"视天下人为一家，和睦相处。也指全国统一。","source":{"text":"天下一宗，死长安即葬长安，何必来葬！","book":"《汉书·吴王濞传》"}},{"id":13640,"word":"天下一家","pinyin":"tiān xià yī jiā","abbr":"txyj","explanation":"视天下人为一家，和睦相处。也指全国统一。","source":{"text":"故圣人耐以天下为一家，以中国为一人者，非意之也。","book":"《礼记·礼运》"},"example":{"text":"～，共享太平，几何乖漓浇薄之世，其不一旦变而为公平正直之世也。","book":"太平天国·洪秀全《原道醒世训》"},"usage":"作谓语、宾语；指全国统一"},{"id":13641,"word":"天下为一","pinyin":"tiān xià wéi yī","abbr":"txwy","explanation":"指国家统一。","source":{"text":"今天下为一，春秋之义，王者无外，偃修封域中，而辞以出境何也。","book":"汉·荀悦《汉纪·武帝纪》"},"similar":["天下一统"],"usage":"作谓语、定语；用于局面等"},{"id":13642,"word":"天下为公","pinyin":"tiān xià wéi gōng","abbr":"txwg","explanation":"原意是天下是公众的，天子之位，传贤而不传子，后成为一种美好社会的政治理想。","source":{"text":"大道之行也，天下为公。","book":"《礼记·礼运》"},"example":{"text":"万古千秋业，～器。","book":"陈毅《湖海诗社开征引》诗"},"similar":["天下一家"],"opposite":["天下为家"],"usage":"作谓语、定语；用于人"},{"id":13643,"word":"天下为家","pinyin":"tiān xià wéi jiā","abbr":"txwj","explanation":"原指将君位传给儿子，把国家当作一家所私有，后泛指处处可以成家，不固定居住在一个地方。","source":{"text":"今大道既隐，天下为家。","book":"西汉·戴圣《礼记·礼运》"},"example":{"text":"孔子之道，其难在以～而不有其家。","book":"明·李贽《焚书·何心隐论》"},"similar":["四海为家"],"usage":"作谓语、定语；用于人"},{"id":13644,"word":"天下为笼","pinyin":"tiān xià wéi lóng","abbr":"txwl","explanation":"笼：牢笼。旧时比喻为世事所束缚。","source":{"text":"以天下为之笼，则雀无所逃。是故汤以胞人笼伊尹，秦穆公以五羊之皮笼百里奚。是故非以其所好笼之而可得者，无有也。","book":"《庄子·庚桑楚》"},"usage":"作宾语、定语；用于书面语"},{"id":13645,"word":"天下乌鸦一般黑","pinyin":"tiān xià wū yā yī bān hēi","abbr":"txwyybh","explanation":"比喻不管哪个地方的剥削者压迫者都是一样的坏。","source":{"text":"这更奇了，天下乌鸦一般黑，岂有两样的。","book":"清·曹雪芹《红楼梦》第五十七回"},"example":{"text":"前几天也颇有流言，正如去年夏天我在北京一样，哈哈，真是～哉。（鲁迅《书信集·致孙伏园》）"},"usage":"主谓式；作宾语、分句；含贬义"},{"id":13646,"word":"天下兴亡，匹夫有责","pinyin":"tiān xià xīng wáng，pǐ fū yǒu zé","abbr":"txxwpfyz","explanation":"国家的兴盛或衰亡，每个普通人都有一份责任。","source":{"text":"保天下者，匹夫之贱，与有责焉耳矣。","book":"清·顾炎武《日知录·正始》"},"example":{"text":"吾国人知～，则人人当自奋矣。","book":"孙中山《孙文学说——行易知难》第七章"},"usage":"作宾语、定语、分句；指每个人都有责任"},{"id":13647,"word":"天下匈匈","pinyin":"tiān xià xiōng xiōng","abbr":"txxx","explanation":"形容局势动荡不安，群情喧扰。","source":{"text":"天下匈匈数岁，成败未可知。","book":"西汉·司马迁《史记·高祖本纪》"},"similar":["天下汹汹","天下恟恟"],"usage":"作谓语、定语；指局势动荡","story":["楚汉相争时期，项羽派人对刘邦说：“天下汹汹是因我们而起，为了结束这种战争局面，我们两人决一死战分胜负。”刘邦表示愿意斗智而不是斗力。项羽命一壮士前去挑战，汉营的神箭手楼烦出来迎战，壮士失败，项羽亲自上阵击败楼烦"]},{"id":13648,"word":"天下大乱","pinyin":"tiān xià dà luàn","abbr":"txdl","explanation":"天下：指全国。到处都是灾荒战祸。形容国家局势动荡不安。","source":{"text":"前日天下大乱，兵革并起，尤民苦殃。","book":"《汉书·高帝纪》"},"example":{"text":"如今朝廷不明，～，天子昏昧，奸臣弄权，我等归顺宋公明，且居水泊。","book":"明·施耐庵《水浒全传》第六十七回"},"similar":["天下鼎沸","天灾人祸"],"opposite":["天下太平"],"usage":"作谓语、宾语、定语；指时局"},{"id":13649,"word":"天下大事，必作于细","pinyin":"tiān xià dà shì，bì zuò yú xì","abbr":"txdsbzyx","explanation":"细：细微。国家大事，必须由细微之处做起。","source":{"text":"天下难事比作于易，天下大事必作于细。是以圣人终不为大，故能成其大。","book":"《老子》第六十三章"}},{"id":13650,"word":"天下大屈","pinyin":"tiān xià dà jué","abbr":"txdq","explanation":"屈：竭，天下财富耗尽。形容天灾人祸后，民穷财尽的情景。","source":{"text":"兵旱相乘，天下大屈，有勇力者聚徒而衡击，罢夫赢老易子而咬其骨。","book":"汉·贾谊《论积贮疏》"}},{"id":13651,"word":"天下大治","pinyin":"tiān xià dà zhì","abbr":"txdz","explanation":"治：安定。国家政治形势安定。","source":{"text":"星明大润泽，则天下大治；芒角，则祸在中。","book":"《晋书·天文志上》"},"example":{"text":"尧舜时操五弦琴，歌“南风”诗，～。","book":"明·冯梦龙《警世通言》卷一"},"similar":["国泰民安"],"opposite":["天下大乱"],"usage":"作谓语、定语；用于书面语"},{"id":13652,"word":"天下太平","pinyin":"tiān xià tài píng","abbr":"txtp","explanation":"处处平安无事。指大治之世。","source":{"text":"天下太平，万物安宁。","book":"《吕氏春秋·大乐》"},"example":{"text":"人人好公，则～；人人营私，则天下大乱。","book":"清·刘鹗《老残游记》第九回"},"similar":["天下大治","国泰民安","太平盛世"],"opposite":["天下大乱","动荡不安","兵荒马乱"],"usage":"作谓语、定语；指国家"},{"id":13653,"word":"天下奇闻","pinyin":"tiān xià qí wén","abbr":"txqw","explanation":"奇闻：罕见的见闻。天下少有的令人惊奇的事情。","example":{"text":"公鸡下蛋真是～。"},"similar":["海外奇闻"],"usage":"作主语、宾语、定语；指惊人的事物"},{"id":13654,"word":"天下归心","pinyin":"tiān xià guī xīn","abbr":"txgx","explanation":"天下百姓心悦诚服。","source":{"text":"兴灭国，继绝世，举逸民，天下之民归心焉。","book":"春秋·鲁·孔丘《论语·尧曰》"},"example":{"text":"她盼望出现～的局面。"},"similar":["人心所向"],"usage":"作宾语、定语；指政策好"},{"id":13655,"word":"天下恟恟","pinyin":"tiān xià xiōng xiōng","abbr":"txxx","explanation":"形容局势动荡不安，群情喧扰。","source":{"text":"后主残酷无道，征役不息，天下恟恟，思闻拯乱。","book":"《旧唐书·任瑰传》"},"similar":["天下匈匈","天下汹汹"],"usage":"作谓语、定语；指局势动荡"},{"id":13656,"word":"天下承平","pinyin":"tiān xià chéng píng","abbr":"txcp","explanation":"国家持久太平。","source":{"text":"玄宗只道天下承平无事，又尝亲阅库藏，见财货充盈，一发志骄意满，视金帛如粪土，赏赐无限。","book":"清·褚人获《隋唐演义》第81回"},"similar":["太平盛世","四海承平"],"opposite":["天下大乱","天下鼎沸"],"usage":"作谓语、定语；用于局面等"},{"id":13657,"word":"天下文宗","pinyin":"tiān xià wén zōng","abbr":"txwz","explanation":"指受天下众人尊崇的文章大家。","source":{"text":"初为《感遇诗》三十首，京兆司功王适见而惊曰：‘此子必为天下文宗矣。’由是知名。","book":"《旧唐书·陈子昂传》"},"usage":"作宾语、定语；用于文人等"},{"id":13658,"word":"天下无不散之宴席","pinyin":"tiān xià wú bù sàn zhī yàn xí","abbr":"txwbszyx","explanation":"天下没有不解散的聚会。指团聚是相对的，终究要分离的。","example":{"text":"俗话说：～，你不必过于伤感。"}},{"id":13659,"word":"天下无不散的宴席","pinyin":"tiān xià wú bù sàn de yàn xí","abbr":"txwbsdyx","explanation":"事情总会有终结，热闹场面不会持续太久。","source":{"text":"三娘子，天下无不散的宴席。","book":"明·冯梦龙《醒世恒言》卷三十五"}},{"id":13660,"word":"天下无不散筵席","pinyin":"tiān xià wú bù sàn yán xí","abbr":"txwbsyx","explanation":"天下没有不解散的聚会。指团聚是相对的，终究要分离的","source":{"text":"天下无有不散筵席，就合上一千年，少不得有个分开日子。","book":"明·冯梦龙《醒世恒言》第35卷"},"example":{"text":"俗话说：～，你不必过于伤感"},"similar":["天下无不散之宴席"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":13661,"word":"天下无双","pinyin":"tiān xià wú shuāng","abbr":"txws","explanation":"天下找不出第二个。形容出类拔萃，独一无二。","source":{"text":"始吾闻夫人弟公子天下无双。","book":"《史记·信陵君列传》"},"example":{"text":"夜半，有女子可年十五六，姿颜服饰，～。","book":"鲁迅《古小说钩沉·列异传》"},"similar":["独一无二","天下第一","出类拔萃"],"opposite":["数不胜数"],"usage":"作谓语、定语；指独一无二","story":["黄香是古代有名的孝子，他母亲早逝，他知书达理，在炎热的夏天，他用扇子扇凉席子让父亲睡。冬天则先钻进被窝温热被子让父亲睡。他当魏郡太守时当地遭遇洪灾，他拿出自己的俸禄和家产救济灾民。人们称他：“天下无双，江夏黄香。”"]},{"id":13662,"word":"天下无敌","pinyin":"tiān xià wú dí","abbr":"txwd","explanation":"普天之下，没有敌手。形容战无不胜，没有对手。","source":{"text":"夫国君好仁，天下无敌。","book":"《孟子·离娄上》"},"example":{"text":"某闻许都曹操，扫荡中原，吕布、二袁皆为所灭，近又破马超，～矣。","book":"明·罗贯中《三国演义》第六十回"},"similar":["天下莫敌","天下第一"],"opposite":["弱不禁风"],"usage":"作谓语、定语；指普天之下没有对手","story":["战国时期，孟子的弟子问：“孔子说的‘仁不可为众也，夫国君好仁，天下无敌。’是否对？”孟子说：“当然对，仁德的力量是不能以人数多少来计算，一个君主爱好仁德，就会天下无敌。现在的诸侯都不愿意施行仁政，早晚会被施行仁政的君王灭掉的。"]},{"id":13663,"word":"天下无难事","pinyin":"tiān xià wú nán shì","abbr":"txwns","explanation":"只要下定决心去做，天下没有不能达成的事。","source":{"text":"正是：但知天下无难事，不信乾坤有细人。","book":"宋·秦观《李训论》：“天下无难事，得其人则易于反掌。”清·刘璋《斩鬼传》第三回"},"example":{"text":"俗语说的：‘～’。只怕死求白赖，或者竟拦住他也不可知。","book":"清·文康《儿女英雄传》第十六回"},"usage":"作宾语、定语；用于劝诫人"},{"id":13664,"word":"天下无难事，只怕有心人","pinyin":"tiān xià wú nán shì，zhǐ pà yǒu xīn rén","abbr":"txwnszpyxr","explanation":"指只要有志向，有毅力，没有什么办不到的事情。","source":{"text":"天下无难事，只怕有心人。","book":"明·王骥德《韩夫人题红记·花阴私祝》"},"example":{"text":"这首不但好，而且新巧有意趣。可知俗语说：‘～。’","book":"清·曹雪芹《红楼梦》第四十九回"},"similar":["天下无难事"],"usage":"作宾语、分句；用于劝诫人","story":["香菱因薛蟠不在家，就向林黛玉学习作诗。黛玉教他作诗的基本常识，香菱就想出很多好诗来问黛玉，黛玉与宝钗、李纨等姐妹纷纷鼓励她，夸奖她说：“天下无难事，只怕有心人”，香菱从此学诗作诗的劲头更加大了"]},{"id":13665,"word":"天下本无事，庸人自召之","pinyin":"tiān xià běn wú shì，yōng rén zì zhào zhī","abbr":"txbwsyrzzz","explanation":"庸人：平凡的人。指本来没有事，自己瞎着急或自找麻烦。","source":{"text":"姚安公曰：‘天下本无事，庸人自召之’，其此公之谓乎？","book":"清·纪昀《阅微草堂笔记·如是我闻》"},"similar":["天下本无事，庸人自扰之"],"usage":"作分句、宾语；指自找麻烦"},{"id":13666,"word":"天下本无事，庸人自扰之","pinyin":"tiān xià běn wú shì，yōng rén zì rǎo zhī","abbr":"txbwsyrzrz","explanation":"庸人：平庸的人；扰之：自己扰乱自己。指本来没有事，自己瞎着急或自找麻烦。","source":{"text":"天下本无事，庸人扰之为烦耳。","book":"《新唐书·陆象先传》"},"example":{"text":"南村野史曰：～。卓哉斯言也。","book":"明·陶宗仪《辍耕录·松江之变》"},"similar":["天下本无事，庸人自召之"],"usage":"作分句、宾语；指自找麻烦"},{"id":13667,"word":"天下汹汹","pinyin":"tiān xià xiōng xiōng","abbr":"txxx","explanation":"汹汹：喧扰。形容局势动荡，群情喧扰。","source":{"text":"天下匈匈数岁，成败未可知。","book":"西汉·司马迁《史记·高祖本纪》"},"example":{"text":"～，人怀危惧。","book":"晋·陈寿《三国志·魏志·曹爽传》"},"similar":["天下匈匈"],"usage":"作谓语、定语；指局势动荡","story":["楚汉相争时期，项羽派人对刘邦说：“天下汹汹是因我们而起，为了结束这种战争局面，我们两人决一死战分胜负。”刘邦表示愿意斗智而不是斗力。项羽命一壮士前去挑战，汉营的神箭手楼烦出来迎战，壮士失败，项羽亲自上阵击败楼烦"]},{"id":13668,"word":"天下滔滔","pinyin":"tiān xià tāo tāo","abbr":"txtt","explanation":"洪水弥漫，到处都是。比喻社会普遍纷乱。也比喻某种低下的人或不好的风气到处都是。","source":{"text":"滔滔者天下皆是也，而谁以易之？且而与其从辟人之士也，岂若从辟世之士哉！","book":"《论语·微子》"},"example":{"text":"北大如此，别的单位也不会两样。于是～者皆外调人员矣。","book":"季羡林《牛棚生活》二"},"similar":["滔滔者天下皆是"],"usage":"作谓语、定语；用于比喻句"},{"id":13669,"word":"天下独步","pinyin":"tiān xià dú bù","abbr":"txdb","explanation":"独步：独一无二，特别突出。超群出众，无人可比。","source":{"text":"独步天下，谁与为偶！","book":"《后汉书·戴良传》"},"example":{"text":"德清之词，不惟江南，实天下之独步也。","book":"明·无名氏《录鬼簿续编》"},"similar":["独步天下"],"opposite":["比比皆是"],"usage":"作谓语、定语；指无人可比"},{"id":13670,"word":"天下第一","pinyin":"tiān xià dì yī","abbr":"txdy","explanation":"形容没有人能比得上。","source":{"text":"孝文皇帝初立，闻河南守吴治平为天下第一。","book":"西汉·司马迁《史记·屈原贾生列传》"},"example":{"text":"世上最可笑的是那些‘知识里手’，有了道听途说的一知半解，便自封为‘～’，适足见其不自量而已。","book":"毛泽东《实践论》"},"similar":["盖世无双"],"opposite":["比比皆是"],"usage":"作谓语、定语、宾语；指没有人能比得上","story":["东汉时期，太守法雄的儿子法真发现胡广很有学问，人品也不错，是一个难得的人才，就推荐他去京师应试。汉安帝看过胡广的文章，居然高声称赞他的文章是天下第一。胡广被封为尚书郎，后当尚书仆射，逐渐成为皇帝身边的重臣"]},{"id":13671,"word":"天下老鸦一般黑","pinyin":"tiān xià lǎo yā yī bān hēi","abbr":"txlyybh","explanation":"比喻坏人坏事各地都差不多，到处都是一样黑暗。","source":{"text":"前几天也颇有流言，正如去年夏天我在北京一样。哈哈，真是天下老鸦一般黑。","book":"鲁迅《致孙伏园》"},"similar":["天下乌鸦一般黑","天下老鸹一般黑"],"usage":"作宾语、分句；用于感慨"},{"id":13672,"word":"天下老鸹一般黑","pinyin":"tiān xià lǎo guā yī bān hēi","abbr":"txlgybh","explanation":"老鸹：乌鸦。天底下的乌鸦都是一样的黑。比喻不管哪个地方的剥削者压迫者都是一样的坏。","source":{"text":"这更奇了，天下老鸹一般黑，岂有两样的。","book":"清·曹雪芹《红楼梦》第五十七回"},"example":{"text":"～，连京营人马，有皇帝亲信的太监刘元斌率领，纪律比别的官军更坏，有什么办法呢？","book":"姚雪垠《李自成》第三卷第二十二章"},"similar":["天下老鸹一般黑","天下乌鸦一般黑"],"usage":"作宾语、分句；用于感慨"},{"id":13673,"word":"天下莫敌","pinyin":"tiān xià mò dí","abbr":"txmd","explanation":"形容战无不胜，没有对手。同“天下无敌”。","source":{"text":"至是凡五十年，而公破绍，天下莫敌矣。","book":"晋·陈寿《三国志·魏志·武帝纪》"},"similar":["天下无敌"],"usage":"作谓语、定语；指普天之下没有对手"},{"id":13674,"word":"天下鼎沸","pinyin":"tiān xià dǐ fèi","abbr":"txdf","explanation":"鼎：古代烹煮用的器物；鼎沸：鼎水沸腾。比喻局势不安定，民心动荡。","source":{"text":"由是天下鼎沸，奸凶并争。","book":"三国·魏·曹冏《六代论》"},"example":{"text":"他趁～时发国难财。"},"similar":["天下大乱"],"opposite":["天下太平"],"usage":"作谓语、定语；指时局"},{"id":13675,"word":"天不作美","pinyin":"tiān bù zuò měi","abbr":"tbzm","explanation":"天不成全美事。多指要进行的事情因刮风下雨而受到了影响。","source":{"text":"天不作美，忽然飘起雪花来。","book":"孙犁《芸斋琐谈（四）》"},"example":{"text":"不想～，将近黎明时分，又淅淅地下起小雨来。","book":"魏巍《火凤凰》六九"},"similar":["天不做美","天公不作美"],"usage":"作宾语、定语；多用于口语"},{"id":13676,"word":"天不假年","pinyin":"tiān bù jiǎ nián","abbr":"tbjn","explanation":"假：给予。天公不给以寿命。指寿命不长。","source":{"text":"予以先生此考，为一生心力所瘁，成以行世，足为读史者一助，惜天不假年，积四十六年之岁月，仅成全史三分之一。","book":"清·平步青《霞外裙屑》第六卷"},"example":{"text":"然而～，他们却走得最早。","book":"丹晨《追念小钰》"},"usage":"作宾语；指寿命不长"},{"id":13677,"word":"天不做美","pinyin":"tiān bù zuò měi","abbr":"tbzm","explanation":"天不成全美事。多指要进行的事情因刮风下雨而受到了影响","source":{"text":"谁知天不做美，偏偏到了十月间，变雄为雌，又产下一位公主。","book":"蔡东藩《慈禧太后演义》第五回"},"example":{"text":"真是～，我们只好呆在这里"},"similar":["天公不做美"],"opposite":["天从人愿"],"usage":"作宾语；指天气"},{"id":13678,"word":"天不变，道亦不变","pinyin":"tiān bù biàn，dào yì bù biàn","abbr":"tbbdybb","explanation":"道：道理，规律。天是不变的，道也是不变的。","source":{"text":"道之大原出于天，天不变，道亦不变。","book":"《汉书·董仲舒传》"}},{"id":13679,"word":"天不怕，地不怕","pinyin":"tiān bù pà，dì bù pà","abbr":"tbpdbp","explanation":"形容无所畏惧，什么都敢干。","source":{"text":"原来姑娘天不怕，地不怕，就怕膈肢他的膈肢漥。","book":"清·文康《儿女英雄传》"},"example":{"text":"～，就怕老婆打电话。"},"similar":["英勇无畏"],"opposite":["前怕狼，后怕虎","瞻前顾后"],"usage":"作谓语、定语；指人胆大"},{"id":13680,"word":"天不慭遗","pinyin":"tiān bù yìn yí","abbr":"tbyy","explanation":"慭：愿；遗：留。天老爷不愿意留下这个老人。常用作对老人的哀悼之词。","source":{"text":"昊天不吊，不慭遗一老。","book":"《诗经·小雅·十月之交》：“不慭遗一老俾守我王。”《左传·哀公十六年》"},"example":{"text":"徐元杰鸣阳之凤，刘汉弼触邪之豸，～，夺我忠臣。","book":"表·毕沅《续资治通鉴》卷一百七十一"}},{"id":13681,"word":"天不憗遗","pinyin":"tiān bù yìn yí","abbr":"tbyy","explanation":"憗：愿；遗：留。天公不愿意留下这一个老人。","source":{"text":"天不憗遗，奄焉甍逝，朕用震恸于厥心。","book":"《南齐书·褚渊传》"},"similar":["天不憗遗一老"],"usage":"作宾语、定语；用于对老人的悼词"},{"id":13682,"word":"天不憗遗一老","pinyin":"tiān bù yìn yí yī lǎo","abbr":"tbyyyl","explanation":"憗：愿；遗：留。天公不愿意留下这一个老人。","source":{"text":"不憗遗一老，俾守我王。","book":"《诗经·小雅·十月之交》"},"example":{"text":"～，俾屏我王。","book":"汉·蔡邕《陈太丘碑》"},"similar":["天不憗遗"],"usage":"作宾语、定语；用于对老人的悼词"},{"id":13683,"word":"天不盖，地不载","pinyin":"tiān bù gài，dì bù zài","abbr":"tbgdbz","explanation":"形容罪恶极大，为天地所不容。","source":{"text":"师又问：‘天不盖，地不载。此理如何？’牙曰：‘道者合如是。’","book":"宋·释普济《五灯会元》卷十"},"example":{"text":"不知是那个～，该剐的贼，装作我去打了城子。","book":"明·施耐庵《水浒全传》第三十四回"},"similar":["天诛地灭"],"usage":"作定语；用于口语"},{"id":13684,"word":"天不绝人","pinyin":"tiān bù jué rén","abbr":"tbjr","explanation":"天不使人处于绝境。常指绝处逢生或得救。","source":{"text":"不想母亲病故后，正待去报父仇，也是天不绝人，便遇见这义重恩深的伯父伯母和我师傅两人。","book":"清·文康《儿女英雄传》第二十五回"},"example":{"text":"清·文康《儿女英雄传》第25回：“也是～，便遇见这义重恩深的伯父伯母和我师傅父女两人。”"},"similar":["天无绝人之路"],"usage":"作宾语、定语；用于摆脱绝境后的感慨"},{"id":13685,"word":"天不转地转","pinyin":"tiān bù zhuàn dì zhuàn","abbr":"tbzdz","explanation":"指以后总有见面的机会。","example":{"text":"～，我们还会有见面的一天。"},"similar":["山不转水转"],"usage":"作分句；用于人际关系"},{"id":13686,"word":"天与人归","pinyin":"tiān yǔ rén guī","abbr":"tyrg","explanation":"与：赐予。旧指帝王受命于天，并得到人民拥护。后比喻人心所向。","source":{"text":"名正言顺，天与人归。","book":"《孟子·万章上》：“‘然则舜有天下也，孰与之？’曰：‘天与之。’”明·史可法《复清摄政睿亲王书》"},"example":{"text":"当～之时，群臣备法驾大乐，恭诣南内，奏请临朝。","book":"《明史·陈循传》"},"similar":["天下归心"],"usage":"作宾语；指帝王受命于天，人心所向"},{"id":13687,"word":"天之僇民","pinyin":"tiān zhī ruò mín","abbr":"tzlm","explanation":"受天惩罚的人；罪人。同“天之戮民”。","source":{"text":"人们都在其间咀嚼着人我的渺茫的悲苦……各各自称为‘天之僇民’。","book":"鲁迅《野草·淡淡的血痕中》"},"similar":["天之戮民"],"usage":"作主语、宾语；指罪人"},{"id":13688,"word":"天之僯民","pinyin":"tiān zhī ruò mín","abbr":"tzrm","explanation":"受天惩罚的人；罪人。同天之戮民”。"},{"id":13689,"word":"天之戮民","pinyin":"tiān zhī lù mín","abbr":"tzlm","explanation":"受天惩罚的人；罪人。亦作“天之僇民”。","source":{"text":"孔子曰：‘丘，天之戮民也。","book":"《庄子·大宗师》"},"similar":["天之僇民"],"usage":"作主语、宾语；指罪人"},{"id":13690,"word":"天之骄子","pinyin":"tiān zhī jiāo zǐ","abbr":"tzjz","explanation":"骄子：父母溺爱骄纵的儿子。老天爷的宠儿。原指强盛的北方民族胡人，后也指为父母溺爱、放肆不受管束的儿子。","source":{"text":"南有大汉，北有强胡。胡者，天之骄子也。","book":"《汉书·匈奴传上》"},"example":{"text":"有人能增加些美到世上去，这人便是～。","book":"冰心《寄小读者·通讯九》"},"similar":["出类拔萃"],"opposite":["碌碌无为"],"usage":"作主语、兼语、宾语；指有影响的人","story":["汉武帝多次派韩安国、卫青、霍去病等大将率军征讨匈奴，每次都取得了胜利，但是还是不能完全消灭匈奴。公元前90年，匈奴单于狐鹿姑又率军南侵，汉武帝派李广利迎敌，被自称天之骄子的匈奴人活捉。汉武帝只好采用和谈才平息事端"]},{"id":13691,"word":"天人之际","pinyin":"tiān rén zhī jì","abbr":"trzj","explanation":"天：自然规律；人：人事；际：际遇。自然和人事之间的相互关系。","source":{"text":"亦欲以究天人之际，通古今之变，成一家之言。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"是以臣每察～，观祸乱之由，迹帝王之事，念先师之说，昭然著明，信不欺尔。 ◎唐·陈子昂《谏政理书》"}},{"id":13692,"word":"天人共鉴","pinyin":"tiān rén gòng jiàn","abbr":"trgj","explanation":"鉴：审察。天公、众人皆可审察。表示诚实无欺。","source":{"text":"区区之心，唯以地方秩序为主，以人民生命财产为重，始终不渝，天人共鉴。","book":"蔡东藩、许廑父《民国通俗演义》第二十九回"},"usage":"作谓语、定语；用于书面语"},{"id":13693,"word":"天人感应","pinyin":"tiān rén gǎn yìng","abbr":"trgy","explanation":"感应：交感相应，指互相受对方影响而发生相应的变化。指自然现象可以显示人世灾祥。","source":{"text":"天人相感，阴阳相和。","book":"唐·陈子昂《谏政理书》"},"example":{"text":"话说武王为天子，～，民安物阜，天降祥瑞，万民无不悦服。","book":"明·许仲琳《封神演义》第九十八回"},"usage":"作宾语、定语；用于书面语"},{"id":13694,"word":"天人相应","pinyin":"tiān rén xiāng yìng","abbr":"trxy","explanation":"指人体与大自然有相似的方面或相似的变化。","source":{"text":"此人与天地相应者也。","book":"《灵枢·邪客》"},"example":{"text":"这真是～的场面。"},"usage":"作宾语、定语；指人与自然融合"},{"id":13695,"word":"天人相感","pinyin":"tiān rén xiāng gǎn","abbr":"trxg","explanation":"相感：交感相应，指互相受对方影响而发生相应的变化。指自然现象可以显示人世灾祥。","source":{"text":"天人相感，阴阳相和。","book":"唐·陈子昂《谏政理书》"},"example":{"text":"元帝问以地震日食的原因，衡答言～，下作上应。","book":"蔡东藩《前汉演义》第八十九回"}},{"id":13696,"word":"天人胜处","pinyin":"tiān rén shèng chù","abbr":"trsc","explanation":"胜：优越。无论在天上，还是在人间，都处于最好的境遇。","source":{"text":"云奉持之，则生天人胜处，亏犯则坠鬼畜诸苦。又善恶生处，凡有六道焉。","book":"《魏书·释老志》"},"example":{"text":"奉持则生～亏，犯则堕鬼畜诸苦。","book":"元·释念常《佛祖通载》卷七"},"usage":"作宾语、定语；用于书面语"},{"id":13697,"word":"天人路隔","pinyin":"tiān rén lù gé","abbr":"trlg","explanation":"上天和人世，无路相通。比喻亲友被隔绝，无法相会。","source":{"text":"直到得干戈平静，仙客入京来访，不匡刘尚书被人诬陷，家小配入掖庭，从此天人路隔，永无相会之日了。","book":"明·凌濛初《二刻拍案惊奇》卷九"},"similar":["仙凡路隔","仙尘路隔"],"usage":"作谓语、定语；用于比喻句"},{"id":13698,"word":"天从人原","pinyin":"tiān cóng rén yuán","abbr":"tcry","explanation":"指事情的发展恰如所望。"},{"id":13699,"word":"天从人愿","pinyin":"tiān cóng rén yuàn","abbr":"tcry","explanation":"上天顺从人的意愿。指事物的发展正合自己的心愿。","source":{"text":"谁知天从人愿，到得我家，不上三日，添了一个满抱儿小厮。","book":"元·张国宾《合汗衫》第二折"},"example":{"text":"当日小弟闻大人国只能乘云而不能走，每每想起，恨不能立刻见见，今果至其地，真是～。","book":"清·李汝珍《镜花缘》第十三回"},"similar":["天随人愿"],"opposite":["天不作美"],"usage":"作谓语、宾语、分句；指顺心"},{"id":13700,"word":"天付良缘","pinyin":"tiān fù liáng yuán","abbr":"tfly","explanation":"付：给予。上天给予的美好姻缘或缘份。也指难得的好机会。同“天假良缘”。","source":{"text":"到今日天付良缘重聚首。","book":"《群英类选·〈鲛绡记·鲛绡会合〉》"},"similar":["天假良缘","天假因缘"],"usage":"作宾语；指良好机遇或缘分"},{"id":13701,"word":"天伦之乐","pinyin":"tiān lún zhī lè","abbr":"tlzl","explanation":"天伦：旧指父子、兄弟等亲属关系。泛指家庭的乐趣。","source":{"text":"会桃花之芳园，序天伦之乐事。","book":"唐·李白《春夜宴从弟桃花园序》"},"example":{"text":"这时父亲如果能够保持着相当丰裕的收入，家中当然充满一片～。","book":"闻一多《关于儒、道、土匪》"},"similar":["合家欢乐"],"opposite":["孤苦伶仃"],"usage":"作宾语；泛指家庭的乐趣"},{"id":13702,"word":"天伦乐事","pinyin":"tiān lún lè shì","abbr":"tlls","explanation":"天伦：旧指父子、兄弟等亲属关系。泛指家庭的乐趣。","source":{"text":"会桃花之芳园，序天伦之乐事。","book":"唐·李白《春夜宴从弟桃花园序》"},"example":{"text":"他父子才得说一番无限离情，叙一番～。","book":"清·文康《儿女英雄传》第十二回"}},{"id":13703,"word":"天低吴楚，眼空无物","pinyin":"tiān dī wú chǔ，yǎn kōng wú wù","abbr":"tdwcykww","explanation":"吴楚：泛指长江中下游。原指登上南京城，一眼望去，越远越觉得天下垂，除见苍天之外，空无所有。现也比喻一无所见。","source":{"text":"石头城上，望天低吴楚，眼空无物。","book":"元·萨都刺《念奴娇·登石头城》词"},"usage":"作宾语、定语、分句；指一无所见","story":["元朝时期，诗人萨都刺来到南京畅游，他见到这六朝古都，十分高兴，登上城楼看四方，触景生情，感慨万千，即兴填词《念奴娇·登石头城》：“石头城上，望天低吴楚，眼空无物。指点六朝形胜地，惟有青山如壁。”"]},{"id":13704,"word":"天作之合","pinyin":"tiān zuò zhī hé","abbr":"tzzh","explanation":"合：配合。好象是上天给予安排，很完美地配合到一起。祝人婚姻美满的话。","source":{"text":"天监在下，有命既集，文王初载，天作之合。","book":"《诗经·大雅·大明》"},"example":{"text":"年长兄，我同你是“～”，不比寻常同年弟兄。 ◎清·吴敬梓《儒林外史》第七回"},"similar":["美满良缘","终身大事"],"opposite":["仇人相见","狭路相逢"],"usage":"偏正式；作宾语、定语；含褒义，祝人婚姻美满的话"},{"id":13705,"word":"天保九如","pinyin":"tiān bǎo jiǔ rú","abbr":"tbjr","explanation":"天保：《诗经·小雅》中的篇名；九如：该诗中连用了九个“如”字，有祝贺福寿延绵不绝之意。旧时祝寿的话，祝贺福寿绵长。","source":{"text":"天保定尔，以莫不兴。如山如皋，如冈如陵，如川之方至，以莫不增……如月之恒，如日之升，如南山之寿，不骞不崩，如松柏之茂，无不尔或承。","book":"《诗经·小雅·天保》"},"usage":"作谓语；祝寿的话"},{"id":13706,"word":"天值地值","pinyin":"tiān zhí dì zhí","abbr":"tzdz","explanation":"指某种物品价格便宜，完全值得。","example":{"text":"这么好的东西才5元，～。"},"similar":["物有所值"],"usage":"作谓语；用于方言"},{"id":13707,"word":"天假之年","pinyin":"tiān jiǎ zhī nián","abbr":"tjzn","explanation":"上天赐给足够的年寿。指能享其天年。","source":{"text":"天假之年，而除其害。","book":"《左传·僖公二十八年》"},"example":{"text":"夫孔明这殁，其年乃五十有四耳，使～，而得乘司马氏君臣之瑕衅，虽北定中原可也。","book":"清·方苞《蜀汉后主论》"},"similar":["天假其年"],"usage":"作宾语、定语；用于书面语"},{"id":13708,"word":"天假其便","pinyin":"tiān jiǎ qí biàn","abbr":"tjqb","explanation":"假：借。上天给予的缘分。指难得的好机会。","source":{"text":"今嵒脱至此，天假其便，得伸臣心，三五日当及阙朝陛下。","book":"《旧五代史·太祖纪》"},"example":{"text":"兄长如此命蹇！今日～，但请放心。","book":"明·施耐庵《水浒全传》第六回"},"usage":"作宾语、定语；用于书面语"},{"id":13709,"word":"天假其年","pinyin":"tiān jiǎ qí nián","abbr":"tjqn","explanation":"假：给。愿意是天意让他生存下来。后多指天意使其延年益寿。","source":{"text":"天假之年，而除其害。","book":"《左传·僖公二十八年》"},"example":{"text":"～，主优其禄。","book":"晋·傅玄《永宁太仆庞侯诔》"},"similar":["天假之年"],"usage":"作宾语、定语；用于书面语"},{"id":13710,"word":"天假因缘","pinyin":"tiān jiǎ yīn yuán","abbr":"tjyy","explanation":"假：借。上天给予的美好姻缘或缘份。也指难得的好机会。同“天假良缘”。","source":{"text":"然其至非言可传，天假因缘，或在异日。","book":"清·黄宗羲《复秦灯岩书》"},"similar":["天假良缘","天付良缘"],"usage":"作宾语；指良好机遇或缘分"},{"id":13711,"word":"天假良缘","pinyin":"tiān jiǎ liáng yuán","abbr":"tjly","explanation":"假：借。上天给予的美好姻缘或缘份。也指难得的好机会。亦作“天付良缘”、“天假因缘”、“天假其便”。","source":{"text":"况吾辈一室之中，自有千秋之业，天假良缘，安得当面蹉过。","book":"明·高攀龙《答刘念台》"},"example":{"text":"今朝～幸，萍水相逢喜不胜，共赴华筳罄此情。","book":"《群英类选·〈分钗记·春游遇妓〉》"},"similar":["天赐良缘","天付良缘"],"usage":"作宾语；指良好机遇或缘分"},{"id":13712,"word":"天光云影","pinyin":"tiān guān yún yǐng","abbr":"tgyy","explanation":"天上的光亮、云朵映在水中的影子。","source":{"text":"半亩方塘一鉴开，天光云影共徘徊。问渠哪得清如许，谓有源头活水来。","book":"宋·朱熹《观书有感》"},"example":{"text":"定睛一看，草木树石，～，眼前历历可数。","book":"明·凌濛初《二刻拍案惊奇》卷十九"},"usage":"作宾语、定语；用于景物描写等"},{"id":13713,"word":"天公不作美","pinyin":"tiān gōng bù zuò měi","abbr":"tgbzm","explanation":"天公：老天爷；作美：成全。老天爷不成全。形容事情很不顺利。"},{"id":13714,"word":"天公不做美","pinyin":"tiān gōng bù zuò měi","abbr":"tgbzm","explanation":"天不成全美事。多指要进行的事情因刮风下雨而受到了影响。","source":{"text":"偏偏天公不做美，疾风凄雨，彻夜飘零，把这般普天同庆的大喜事，未免减色三分。","book":"蔡东藩《慈禧太后演义》第13回"},"similar":["天不做美"],"usage":"作宾语；指天气"},{"id":13715,"word":"天公地道","pinyin":"tiān gōng dì dào","abbr":"tgdd","explanation":"形容十分公平合理。","source":{"text":"如今人人的脑袋里头既都有了一个社会平等，政治自由，是个天公地道的思想。","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"example":{"text":"这是～的事：打日本每个人都该去，打平了就回来。","book":"沙汀《呼嚎》"},"similar":["一视同仁","大公无私"],"opposite":["贪赃枉法","徇私舞弊"],"usage":"作谓语、定语、状语；指公平合理"},{"id":13716,"word":"天兵天将","pinyin":"tiān bīng tiān jiàng","abbr":"tbtj","explanation":"旧指天上的军队和将领。也比喻本领高强的人们。","source":{"text":"那鲧却生的儿子，神通广大，伏虎降龙，手下天兵天将那等利害。","book":"清·贾凫西《木皮散人鼓词·开场》"},"example":{"text":"以及怎样请了～，捉住兴风作浪的妖怪无支祁。","book":"鲁迅《故事新编·理水》"},"similar":["天神天将"],"opposite":["虾兵蟹将"],"usage":"作主语、宾语、定语；指神奇力量"},{"id":13717,"word":"天兵神将","pinyin":"tiān bīng shén jiàng","abbr":"tbsj","explanation":"比喻英勇善战，行动迅捷的军队。","source":{"text":"北军追赶上来，正在万分危急，猛见宋寨中一道金光射来，把风砂冲散，那些天兵神将，都乱纷纷堕落阵前。","book":"明·施耐庵《水浒传》第95回"},"example":{"text":"清·李百川《绿野仙踪》第69回：“任凭他～，定杀他个片甲不回。”"},"similar":["天兵天将","神兵天将"],"usage":"作宾语、定语；用于军事等"},{"id":13718,"word":"天冠地屦","pinyin":"tiān guān dì jù","abbr":"tgdj","explanation":"比喻双方相差极大。","source":{"text":"夫卜而有不审，不见夺糈；为人主计而不审，身无所处。此相去远矣，犹天冠地屦也。","book":"西汉·司马迁《史记·日者列传》"},"example":{"text":"人之贤不肖，相去何止～乎！","book":"宋·洪迈《容斋五笔·忠义出天资》"},"similar":["天壤之别","天差地别"],"usage":"作谓语、定语；比喻双方相差极大"},{"id":13719,"word":"天凝地闭","pinyin":"tiān níng dì bì","abbr":"tndb","explanation":"形容冬天非常寒冷的情景。","source":{"text":"天凝地闭，风厉霜飞。","book":"《晋书·张协传》"},"usage":"作定语；形容冬天非常寒冷"},{"id":13720,"word":"天华乱坠","pinyin":"tiān huā luàn zhuì","abbr":"thlz","explanation":"形容说话有声有色，极其动听（多指夸张而不符合实际）。同“天花乱坠”。","source":{"text":"聚徒一千二千，说法如云如雨，讲得天华乱坠，只成个邪说争竞是非。","book":"宋·释道原《景德传灯录·令遵禅师》"},"similar":["天花乱坠"],"usage":"作状语、定语；指不着边际"},{"id":13721,"word":"天南地北","pinyin":"tiān nán dì běi","abbr":"tndb","explanation":"一在天之南，一在地之北。形容地区各不相同。也形容距离极远。","source":{"text":"天南地北双飞客，老翅几回寒暑。","book":"金·元好问《迈陂塘》词"},"example":{"text":"咫尺的～，霎时间月缺花飞。","book":"元·关汉卿《沉醉东风》"},"similar":["天涯海角","信口开河"],"opposite":["近在咫尺","要言不烦"],"usage":"作宾语、定语；指在遥远的各地"},{"id":13722,"word":"天南海北","pinyin":"tiān nán hǎi běi","abbr":"tnhb","explanation":"形容距离遥远的不同地区。亦形容（谈话）漫无边际。","source":{"text":"他素来最能关心战士，天南海北，不管怎样调皮捣蛋的人，一经他教育改造，都能脱胎换骨。","book":"杨朔《熔炉》"},"example":{"text":"和他在一起，觉得很自在，很安详，可以～，无拘无束的聊天。","book":"秦牧《漫记端木蕻良》"},"similar":["天南地北"],"opposite":["近在眉睫"],"usage":"作宾语、定语、状语；指相距遥远"},{"id":13723,"word":"天台路迷","pinyin":"tiān tái lù mí","abbr":"ttlm","explanation":"天台：山名，在今浙江省天台县北。原指误入仙境而迷途。后用以形容前途茫茫，无路可走。","source":{"text":"剡县刘晟，阮肇共入天台山取谷皮，迷不得返。","book":"《太平御览》卷九六七引《幽冥录》"},"usage":"作宾语、定语；用于书面语"},{"id":13724,"word":"天各一方","pinyin":"tiān gè yī fāng","abbr":"tgyf","explanation":"指各在天底下的一个地方。形容相隔极远，见面困难。","source":{"text":"良友远离别，各在天一方。","book":"汉·苏武《古诗四首》"},"example":{"text":"先生此去，～，未知相会却在何日。","book":"明·罗贯中《三国演义》第三十六回"},"similar":["千里迢迢","天涯海角"],"opposite":["近在咫尺","难分难解"],"usage":"作谓语、宾语；形容两地相距遥远"},{"id":13725,"word":"天吴紫凤","pinyin":"tiān wú zǐ fèng","abbr":"twzf","explanation":"天吴：古代传说中的水神，虎身人面，八头八足八尾；紫凤：古代传说中的神鸟，人面鸟身，九头。泛指作为应急而用的古旧事物。","source":{"text":"天吴及紫凤，颠倒裋褐也邪？","book":"唐·杜甫《北征》"},"example":{"text":"平章春韭秋菘味，拆补～图。","book":"宋·陆游《自笑》"}},{"id":13726,"word":"天命攸归","pinyin":"tiān mìng yōu guī","abbr":"tmyg","explanation":"天命：上天的意志。攸：所。归：归宿。旧指上天预先安排好的归宿。因常指改朝换代，将有新君主出现。亦作“天命有归”。","source":{"text":"必若隋室倾败，天命有归，吾当断头以付诸君也。","book":"《隋书·尧君素传》"},"example":{"text":"无奈～，一朝擒灭，命也数也，人何尤焉！","book":"清·褚人获《隋唐演义》第五十八回"}},{"id":13727,"word":"天命有归","pinyin":"tiān mìng yǒu guī","abbr":"tmyg","explanation":"天命：上天的意志；归：归宿。上天所安排的归宿。","source":{"text":"三分天下，周土已得二分，可见天命有归，岂是人为。","book":"明·许仲琳《封神演义》第三十三回"},"example":{"text":"他原是妲己的舅公的干女婿，做着祭酒，因为知道～，便带着五十车行李和八百个奴婢，来投明主了。","book":"鲁迅《故事新编·采薇》"},"similar":["听天由命"],"usage":"作谓语、定语；指上天安排"},{"id":13728,"word":"天地不容","pinyin":"tiān dì bù róng","abbr":"tdbr","explanation":"天地：天地之间，人世间。容：宽容。天地所不能容纳。指大逆不道、罪孽深重的人与事。","source":{"text":"子谋父，臣杀主，天地所不容载。","book":"汉·袁康《越绝书·越绝篇叙外传记》"},"example":{"text":"乾坤浩大，日月照鉴分明；宇宙宽洪，～奸党。","book":"明·吴承恩《西游记》第十一回"},"usage":"作谓语、定语；多用于口语"},{"id":13729,"word":"天地剖判","pinyin":"tiān dì pōu pàn","abbr":"tdpp","explanation":"犹言开天辟地。比喻空前的，自古以来没有过的。","source":{"text":"称引天地剖判以来，五德转移，治各有宜。","book":"西汉·司马迁《史记·孟子荀卿列传》"},"example":{"text":"东汉·班固《汉书·陆贾传》：“自～，未始有也。”"},"similar":["开天辟地"],"usage":"作宾语、定语；用于书面语"},{"id":13730,"word":"天地开辟","pinyin":"tiān dì kāi pì","abbr":"tdkp","explanation":"古代神话传说：盘古氏开辟天地，开始有人类历史。后常比喻空前的，自古以来没有过的。","source":{"text":"天地混沌如鸡子，盘古生在其中，万八千岁，天地开辟，阳清为天，阴浊为地，盘古在其中一日九变，神于天，圣于地，天日高一丈，地日厚一丈。","book":"三国·吴·徐整《三五历纪》"},"example":{"text":"自～以来，赖有圣人，原治而不原乱者，天地之心；有治而不能无乱者，天地之数。","book":"《清史稿·许三礼传》"},"similar":["开天辟地"],"usage":"作宾语、定语；用于书面语"},{"id":13731,"word":"天地神明","pinyin":"tiān dì shén míng","abbr":"tdsm","explanation":"指上天和神灵。","source":{"text":"童贯在马上以手加额，顶礼天地神明道：‘惭愧！脱得这场大难！’","book":"明·施耐庵《水浒传》第77回"},"example":{"text":"一生如此，则仰不愧天，俯不怍地，死后可见～。","book":"清·无名氏《说呼全传》第十回"},"usage":"作主语、宾语、定语；用于口语"},{"id":13732,"word":"天地经纬","pinyin":"tiān dì jīng wěi","abbr":"tdjw","explanation":"指天地间理所应当、无可非议的道理。引申为以天地为法度治理天下。","source":{"text":"礼，上下之纪、天地之经纬也。","book":"《左传·昭公二十五年》"},"similar":["天经地纬"],"usage":"作宾语、定语；用于书面语"},{"id":13733,"word":"天地良心","pinyin":"tiān dì liáng xīn","abbr":"tdlx","explanation":"天知地知，自己也问得过良心，确实没有说假话、做坏事。","example":{"text":"我对得起～，没有干任何亏心事。"},"similar":["天地良心"],"usage":"作分句、宾语；表白自己的用语"},{"id":13734,"word":"天地诛戮","pinyin":"tiān dì zhū lù","abbr":"tdzl","explanation":"犹天诛地灭。比喻为天地所不容。同“天地诛灭”。","source":{"text":"若有瞒昧，天地诛戮。","book":"明·施耐庵《水浒传》第80回"},"example":{"text":"如果背叛诺言，就会～"},"similar":["天地诛灭","天诛地灭"],"usage":"作谓语、定语；用于盟誓等"},{"id":13735,"word":"天地诛灭","pinyin":"tiān dì zhū miè","abbr":"tdzm","explanation":"犹天诛地灭。比喻为天地所不容。","source":{"text":"我等六人中，但有私意者，天地诛灭。","book":"明·施耐庵《水浒传》第15回"},"similar":["天诛地灭"],"usage":"作谓语、定语；用于盟誓等"},{"id":13736,"word":"天地长久","pinyin":"tiān dì cháng jiǔ","abbr":"tdcj","explanation":"形容时间悠久。也形容永远不变（多指爱情）。同“天长地久”。","source":{"text":"人生寿促，天地长久。","book":"汉·嵇康《四言赠兄秀才入军诗》其七"},"example":{"text":"此一去不回头，好教我这烦恼越感的～。","book":"元·宫天挺《范张鸡黍》第三折"},"similar":["天长地久"],"usage":"作宾语、状语；形容时间长久"},{"id":13737,"word":"天坍地陷","pinyin":"tiān tān dì xiàn","abbr":"ttdx","explanation":"天坍塌，地下陷。形容剧烈的变动。","example":{"text":"不管～，不看这古怪事情，这都是魔障，阿爷心里想，死人枪炮，白布符号，都是虚假的。","book":"张承志《西省暗杀考》第四"}},{"id":13738,"word":"天坼地裂","pinyin":"tiān chè dì liè","abbr":"tcdl","explanation":"坼：裂开。象天塌下、地裂开那样。比喻重大的事变。也形容巨大的声响。","source":{"text":"语未毕，而大声忽发，天坼地裂，宫殿摆簸，云烟沸涌。","book":"唐·李朝威《柳毅传》"}},{"id":13739,"word":"天堂地狱","pinyin":"tiān táng dì yù","abbr":"ttdy","explanation":"原为佛家语。指善人死后升入天堂，恶人死后堕入地狱。佛家用以劝善惩恶。后常用以比喻幸福和凄苦两种截然相反的生活境遇。","source":{"text":"且要天堂以就善，曷若服义而蹈道；惧地狱以敕身，孰与从理以端心。","book":"《宋书·天竺迦毘黎国传》"},"example":{"text":"～门相对，任君拣取那边好。","book":"元·无名氏《度柳翠》第二折"},"usage":"作主语、宾语、定语；用于比较"},{"id":13740,"word":"天堑长江","pinyin":"tiān qiàn cháng jiāng","abbr":"tqcj","explanation":"堑：壕沟。长江为天然的壕沟。形容长江地势险要，不可逾越。","source":{"text":"天堑长江第几州，十年梦想竟成游。","book":"柳亚子《京口感怀》诗"},"similar":["长江天堑"],"usage":"作主语、宾语；形容长江"},{"id":13741,"word":"天塌压大家","pinyin":"tiān tā yā dà jiā","abbr":"ttydj","explanation":"比喻普遍性的灾祸或压力，人人都得承受一分。","source":{"text":"现在火不顺风，我们只得静候。真正火到咱店里，那时开开后门，咱大家逃命，行李付之一烬，这叫天塌压大家。","book":"清·李绿园《歧路灯》第一百三回"},"example":{"text":"虽然是～，可是咱家无多存粮，又无多钱，经受不住围困。","book":"姚雪垠《李自成》第四卷第四十五章"},"usage":"作宾语、定语；用于口语"},{"id":13742,"word":"天塌地陷","pinyin":"tiān tā dì xiàn","abbr":"ttdx","explanation":"天坍塌，地裂陷。比喻重大灾变。","source":{"text":"我有了这件东西，说到得了天塌地陷也是瞎话，横竖咱们大清国万万年，我邓振彪也万万年了。","book":"清·文康《儿女英雄传》第三十九回"},"example":{"text":"一阵机关枪响之后，紧接着就是～似的几阵大声，门窗震动。","book":"冰心《我的邻居》"},"similar":["天崩地裂"],"usage":"作宾语、定语；比喻重大灾变"},{"id":13743,"word":"天壤之判","pinyin":"tiān rǎng zhī pàn","abbr":"trzp","explanation":"壤：地。天和地，一极在上，一级在下，比喻差别极大。","source":{"text":"趋舍所尚，耳目之欲，其为不同，已有天壤之觉，冰炭之乖矣。","book":"《抱朴子·论仙》"},"example":{"text":"与老张的梦境比起来，俗人们享受的是物质，老张享受的是精神，真是有～了！","book":"老舍《老张的哲学》十四"},"similar":["天壤之别","天壤之隔"],"usage":"作宾语；指事物差别极大"},{"id":13744,"word":"天壤之别","pinyin":"tiān rǎng zhī bié","abbr":"trzb","explanation":"壤：地。天和地，一极在上，一级在下，比喻差别极大。","source":{"text":"趋舍所尚，耳目之欲，其为不同，已有天壤之觉（较），冰炭之乖矣。","book":"《抱朴子·内篇·论仙》"},"example":{"text":"按照一般人的生理机能来说，聪明与不聪明虽有差别，但并不存在～。"},"similar":["天堂地狱","天差地别"],"opposite":["相差无几"],"usage":"作宾语；指事物差别极大"},{"id":13745,"word":"天壤之觉","pinyin":"tiān rǎng zhī jué","abbr":"trzj","explanation":"壤：地。天和地，一在极上，一在极下，比喻差别极大。","source":{"text":"其为不同，已有天壤之觉，冰炭之乘矣。","book":"晋·葛洪《抱朴子·内篇·论仙》"},"similar":["天壤之别"],"usage":"作宾语；指事物差别极大"},{"id":13746,"word":"天壤之隔","pinyin":"tiān rǎng zhī gé","abbr":"trzg","explanation":"天上和地下的间隔，形容差别极大。","source":{"text":"趋舍所尚，耳目之欲，其为不同，已有天壤之觉，冰炭之乖矣。","book":"《抱朴子·论仙》"},"example":{"text":"比之晚唐“乱杀平人不怕天”、“抽旗乱插死人堆”，岂但～。","book":"明·杨慎《升庵诗话》卷六"},"similar":["天壤之别","天壤之判"],"usage":"作宾语；指事物差别极大"},{"id":13747,"word":"天壤悬隔","pinyin":"tiān rǎng xuán gé","abbr":"trxg","explanation":"比喻相差极远或相差极大。","source":{"text":"一人之思，迟带天悬；一家之文，工拙壤隔。","book":"《南齐书·陆厥传》"},"similar":["天壤之别","天壤之隔"],"usage":"作宾语、定语；用于书面语"},{"id":13748,"word":"天壤王郎","pinyin":"tiān rǎng wáng láng","abbr":"trwl","explanation":"天壤：指天地之间，即人世间；王郎：指晋王凝之。天地间竟有这种人。原是谢道蕴轻视其丈夫王凝之的话。后比喻对丈夫不满意。","source":{"text":"一门叔父，则有阿大中郎；群从兄弟，则有封、胡、遏、末，不意天壤之中，乃有王郎。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"道韫文章男不及，偏遇个～冤不冤。","book":"秋瑾《精卫石·四》"},"usage":"作宾语、定语；指对丈夫不满意","story":["晋代时期，有名的女中豪杰谢道韫嫁给王羲之的儿子王凝之，由于她的才学比王凝之高，十分不称心。叔父谢安经常安慰她，希望她不要轻视他，夫妻和睦相处。可谢道韫还是忍不住叹息：“不意天壤之中，乃有王郎。”"]},{"id":13749,"word":"天外有天","pinyin":"tiān wài yǒu tiān","abbr":"twyt","explanation":"指某一境界之外更有无穷无尽的境界。多用来表示人的眼界受客观条件的限制，认识的领域需要不断扩大。也表示美好的境界阅历不尽。亦作“山外有山”、“峰外有峰”","source":{"text":"金河一去路千千，欲到天边更有天。","book":"《敦煌曲·何满子四首》其四"},"example":{"text":"要知道～，不能骄傲自满。"},"similar":["山外有山","人上有人"],"usage":"作宾语、定语；用于劝诫人"},{"id":13750,"word":"天外飞来","pinyin":"tiān wài fēi lái","abbr":"twfl","explanation":"天外：意料不到的地方。后指事情出乎意料地发生，凭空而来。","source":{"text":"神迹诡怪，则理绝人区；感验明显，则事出天外。","book":"《后汉书·西域传论》"},"example":{"text":"秋谷说苏州地方并无相好，这位贵相知难道是～的不成？","book":"清·张春帆《九尾龟》第一回"}},{"id":13751,"word":"天大地大","pinyin":"tiān dà dì dà","abbr":"tddd","explanation":"形容极大。","source":{"text":"天大地大人亦大，故大象人形。","book":"《老子》：“故道大、天大、地大、王亦大。”汉·许慎《说文解字》"},"example":{"text":"你大家道她这仇人是谁，真算得个～，无大不大的大脚色。","book":"清·文康《儿女英雄传》第十六回"},"usage":"作宾语、定语；多用于口语"},{"id":13752,"word":"天大笑话","pinyin":"tiān dà xiào huà","abbr":"tdxh","explanation":"能引人发笑的话题。","example":{"text":"请不要闹出～来。"},"usage":"作主语、宾语、定语；带有轻视人的意味"},{"id":13753,"word":"天夺之年","pinyin":"tiān duó zhī nián","abbr":"tdzn","explanation":"上天褫夺其年寿。指不能享其天年。","source":{"text":"渐有应者，而天夺之年，未口，辄风流云散。","book":"清·顾贞观《栩园词弃稿》序"},"usage":"作宾语；用于书面语"},{"id":13754,"word":"天夺之魄","pinyin":"tiān duó zhī pò","abbr":"tdzp","explanation":"魄：魂魄。天夺去了他的魂魄。比喻人离死不远。","source":{"text":"天夺其魄，死期将至。","book":"《左传·宣公十五年》：“原叔必有大咎，天夺之魄矣。”《晋书·温峤传》"},"example":{"text":"～，自干诛夷。","book":"宋·秦观《进策·边防上》"},"similar":["天夺其魄"],"usage":"作宾语；指临死","story":["公元594年，赤狄酆舒执政，杀了国君潞子的夫人（晋景公的姐姐），晋国出兵灭了赤狄，杀了酆舒。晋国派赵同向周天子进献狄国的俘虏，赵同的态度很傲慢，刘康公看后很不高兴，骂道：“不及十年，原叔必有大咎，天夺之魄矣。”"]},{"id":13755,"word":"天夺其魄","pinyin":"tiān duó qí pò","abbr":"tdqp","explanation":"比喻人离死不远。同“天夺之魄”。","source":{"text":"[古人]谓事大谬而谋拙，曰天夺其魄。","book":"宋·沈作喆《寓简》卷七"},"example":{"text":"段业，窃也；仲堪，叛也；～，以迷于鬼，而死也固宜。","book":"清·王夫之《读通鉴论·晋安帝》"},"similar":["天夺之魄"],"usage":"作宾语、定语；指临死"},{"id":13756,"word":"天奇地怪","pinyin":"tiān qí dì guài","abbr":"tqdg","explanation":"指天地间非常奇怪的事。","source":{"text":"此事前所未闻，是知穷荒绝徼，天奇地怪，亦何所不有。","book":"宋·周密《齐东野语·黄婆》"},"usage":"作宾语、定语；用于书面语"},{"id":13757,"word":"天女散花","pinyin":"tiān nǚ sàn huā","abbr":"tnsh","explanation":"原为佛教故事：天女散花以试菩萨和声闻弟子的道行，花至菩萨身上即落去，至弟子身上便不落。后多形容抛洒东西或大雪纷飞的样子。","source":{"text":"时维摩诘室有一天女，见诸大人闻所说说法，便现其身，即以天华散诸菩萨、大弟子上，华至诸菩萨即皆堕落，至大弟子便著不堕。一切弟子神力去华，不能令去。","book":"《维摩经·观众生品》"},"example":{"text":"～，缀山林之草树。","book":"唐·宋之问《设斋叹佛文》"},"similar":["天花乱坠"],"usage":"作谓语、宾语、定语；指抛洒东西","story":["传说天国里佛祖的大弟子文殊菩萨和普贤菩萨在向众弟子讲佛法，天女见他们在聚精会神地听着，故意摘来很多花瓣从空中撒下去，只有文殊与普贤身上不沾花瓣。维摩居士告诫他们只有六根清净才不会沾上花瓣的，得努力修行"]},{"id":13758,"word":"天姿国色","pinyin":"tiān zī guó sè","abbr":"tzgs","explanation":"天姿：天生的姿色；国色：女子美色冠绝全国。旧时形容女子容貌极美。","source":{"text":"修短得中，天姿掩蔼，容颜绝世。","book":"《公羊传·昭公三十一年》：“颜夫人者，妪盈女也，国色也。”《汉武帝内传》"},"example":{"text":"俺安禄山，前往曲江，恰好遇着三国夫人，一个个～。","book":"清·洪昇《长生殿·褉游》"},"similar":["国色天香"],"usage":"作谓语、宾语；形容女子貌美"},{"id":13759,"word":"天子无戏言","pinyin":"tiān zǐ wú xì yán","abbr":"tzwxy","explanation":"指帝王说话算数。","source":{"text":"天子无戏言。天子言，则史书之，工诵之，士称之。","book":"战国·卫·吕不韦《吕氏春秋·重言》"},"example":{"text":"～”，领导干部要对言行负","book":"俗话说"},"similar":["言出必行"],"usage":"作宾语、定语、分句；指言出必行","story":["周成王与弟弟叔虞闲聊，一时高兴拿起树叶开玩笑要分封给他。叔虞信以为真就去告诉叔叔周公，周公对成王说天子无戏言，说话不慎重，失信于人，将会失去人心。成王只得择日封叔虞于唐，方圆100里地。从此成王更加注重听取别人的意见，慎言慎行"]},{"id":13760,"word":"天子门生","pinyin":"tiān zǐ mén shēng","abbr":"tzms","explanation":"指由皇帝亲自考试录取的或殿试第一名者。","source":{"text":"卿乃朕自擢，秦桧日荐士，曾无一言及卿，以此知卿不附权贵，真天子门生也。","book":"宋·岳珂《桯史·天子门生》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":13761,"word":"天字第一号","pinyin":"tiān zì dì yī hào","abbr":"tzdyh","explanation":"天：天字是《千字文》首句“天地玄黄”的第一个字。指第一或第一类中的第一号。比喻最高的、最大的或最强的。","source":{"text":"那女眷且是生得美貌，打听来是这客人的爱妾，日日雇了天字一号的太湖船，摆了盛酒，吹弹歌唱俱备，携了此妾下湖。","book":"明·凌濛初《初刻拍案惊奇》卷十八"},"example":{"text":"有那梁山泊晁盖送与你的一百两金子，快把来与我，我便饶你这一场～官司，还你这招文袋里的款状。","book":"《水浒全传》第二十一回"},"usage":"作宾语、定语；比喻最高的"},{"id":13762,"word":"天官赐福","pinyin":"tiān guān cì fú","abbr":"tgcf","explanation":"天官：道教奉天、地、水三神，亦叫三官，天官即其中之一。旧时祈福消灾的吉利话。","source":{"text":"又到三官庙叩头，祝赞天官赐福，地官赦罪，水官解厄。","book":"清·西周生《醒世姻缘传》第六十七回"},"example":{"text":"反正得有个天，“天官赐福”，字又太多了。","book":"老舍《牛天赐传》一"},"usage":"作宾语、定语；用于祈祷等"},{"id":13763,"word":"天宝当年","pinyin":"tiān bǎo dāng nián","abbr":"tbdn","explanation":"比喻追忆往昔盛事。天宝：唐玄宗李隆基的年号，是唐王朝极盛之时。","source":{"text":"我只待拨繁弦传幽怨，翻别调写愁烦，慢慢的把天宝当年遗事弹。","book":"清·洪昇《长生殿·弹词》"},"usage":"作宾语；指当年的事情"},{"id":13764,"word":"天宽地窄","pinyin":"tiān kuān dì zhǎi","abbr":"tkdz","explanation":"形容天下难有容身的地方。","source":{"text":"曰：‘作么生是混融一句？还有人道得么？若道得，有参学眼。若道不得，天宽地窄。","book":"宋·释普济《五灯会元》卷九"},"example":{"text":"窥之远，～；染之重，梦断魂劳！","book":"元·郑光祖《倩女离魂》第一折"},"usage":"作宾语、定语；用于人的处境等"},{"id":13765,"word":"天寒地冻","pinyin":"tiān hán dì dòng","abbr":"thdd","explanation":"形容天气极为寒冷。","source":{"text":"莫限春风吹不到，著意挽春回。一任天寒地冻，南枝香动，花傍一阳开。","book":"宋·王十朋《南州春色》"},"example":{"text":"且今～，军马难以久住，权且回山。","book":"明·施耐庵《水浒全传》第六十五回"},"similar":["千里冰封","滴水成冰"],"opposite":["赤日炎炎","骄阳似火"],"usage":"作谓语、定语；形容天气非常寒冷"},{"id":13766,"word":"天崩地坍","pinyin":"tiān bēng dì tān","abbr":"tbdt","explanation":"比喻重大的事变。也形容巨大的声响。同“天崩地坼”。","source":{"text":"立时天崩地坍一阵响，整个大殿倒塌。","book":"茅盾《参孙的复仇》"},"similar":["天崩地解","天崩地坼"],"usage":"作谓语、定语；形容声音巨大"},{"id":13767,"word":"天崩地坼","pinyin":"tiān bēng dì chè","abbr":"tbdc","explanation":"崩：倒塌；坼：裂开。象天塌下、地裂开那样。比喻重大的事变。也形容巨大的声响。","source":{"text":"天崩地坼，天子下席。","book":"《战国策·赵策三》"},"example":{"text":"只听得海外一个大炮如～的一连响了百余响。","book":"清·陈忱《水浒后传》第三十三回"},"similar":["天崩地裂","天崩地塌"],"usage":"作谓语、定语；形容声音巨大","story":["周烈王时期，诸侯势力越来越大，根本不理会朝廷，只有齐威王带头去朝拜，得了“仁义之士”的好名声。周烈王驾崩，齐威王都没有第一个去吊唁，新继位的天子派人到齐国传旨说：“先王去世是天崩地坼的事情，你姗姗来迟该当何罪？”"]},{"id":13768,"word":"天崩地塌","pinyin":"tiān bēng dì tā","abbr":"tbdt","explanation":"天崩塌，地裂陷。多比喻巨大的灾难、重大的事变或强烈的声响。","source":{"text":"鼓角齐鸣，喊声大震，黄忠一马当先，驰下山来，犹如天崩地塌之势。","book":"《三国演义》第七一回"},"example":{"text":"忽听得轰的一声，犹如～一般。","book":"清·吴研人《二十年目睹之怪现状》第十五回"},"similar":["天崩地坼","天崩地坍"],"usage":"作谓语、定语；形容声音巨大"},{"id":13769,"word":"天崩地裂","pinyin":"tiān bēng dì liè","abbr":"tbdl","explanation":"象天塌下、地裂开那样。比喻重大的事变。","source":{"text":"天崩地坼，天子下席。","book":"《战国策·赵策三》"},"example":{"text":"正在这个档口，不提防大吼一声，顿时～一般。","book":"清·李宝嘉《官场现形记》第六十回"},"similar":["天崩地坼","天翻地覆","震天动地"],"opposite":["鸦雀无声","万籁俱寂"],"usage":"作谓语；形容变化巨大"},{"id":13770,"word":"天崩地解","pinyin":"tiān bēng dì jiě","abbr":"tbdj","explanation":"比喻重大的事变。也形容巨大的声响。同“天崩地坼”。","source":{"text":"天崩地坼，天子下席。","book":"《战国策·赵策三》"},"similar":["天崩地坼"],"usage":"作谓语、定语；形容声音巨大"},{"id":13771,"word":"天崩地陷","pinyin":"tiān bēng dì xiàn","abbr":"tbdx","explanation":"比喻重大的事变。也形容巨大的声响。同“天崩地坼”。","source":{"text":"宁知齿豁头童后，更遇天崩地陷时！","book":"宋·陆游《望永阜陵》"},"example":{"text":"石炮落处，～，山倒石裂。","book":"明·施耐庵《水浒传》第五十五回"},"similar":["天崩地坍","天塌地裂"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":13772,"word":"天工人代","pinyin":"tiān gōng rén dài","abbr":"tgrd","explanation":"天的职责由人代替。","source":{"text":"无旷庶官，天工人其代之。","book":"《尚书·皋陶谟》"},"example":{"text":"且选众授能，非才莫举，～，焉可妄加。","book":"唐·吴兢《贞观政要·论择官》"},"similar":["人代天工"],"usage":"作宾语、分句；指天的职责由人代替"},{"id":13773,"word":"天差地远","pinyin":"tiān chā dì yuǎn","abbr":"tcdy","explanation":"比喻两者相差极大。","source":{"text":"我的老人家虽说也是个监司职分，然而比起来，已是天差地远了。","book":"清·李宝嘉《文明小史》第57回"},"example":{"text":"他们是弟兄，所见的又是同一的东西，想到的用法却有这么～。","book":"鲁迅《前记》"},"similar":["天壤之别"],"usage":"作谓语、定语；比喻相差极远"},{"id":13774,"word":"天平地成","pinyin":"tiān píng dì chéng","abbr":"tpdc","explanation":"指万事安排妥当，天下太平。","source":{"text":"《夏书》曰‘地平天成’，称也。","book":"春秋·鲁·左丘明《左传·僖公二十四年》"},"example":{"text":"～，功业也如此。","book":"南朝·陈·徐陵《劝进元帝表》"},"similar":["天成地平"],"opposite":["天下大乱"],"usage":"作谓语；指天下太平"},{"id":13775,"word":"天年不测","pinyin":"tiān nián bù cè","abbr":"tnbc","explanation":"指意外的死亡。","source":{"text":"此后成人婚娶，俱系鲍文卿抚养，立嗣承裆，两无异说。如有天年不测，各听天命。","book":"清·吴敬梓《儒林外史》第二十五回"},"usage":"作宾语、定语；用于口语"},{"id":13776,"word":"天年不遂","pinyin":"tiān nián bù suì","abbr":"tnbs","explanation":"指未享天年。","source":{"text":"天年不遂，早就奄昏。","book":"《后汉书·安帝纪》：“岂意卒然颠沛，天年不遂，悲痛断心。”《乐府诗集·相和歌辞十四·雁门太守行一》"},"example":{"text":"南朝·宋·范晔《后汉书·安帝纪》：“岂然卒然颠沛，～，悲痛断心。”"},"usage":"作谓语、宾语；用于书面语"},{"id":13777,"word":"天年不齐","pinyin":"tiān nián bù qí","abbr":"tnbq","explanation":"指命运和流年不相配合，以致运道不好。","source":{"text":"张教头道：‘贤婿，甚么言语！你是天年不齐，遭了横事，又不是你作将出来的。’","book":"明·施耐庵《水浒传》第八回"},"usage":"作谓语、定语；用于处事"},{"id":13778,"word":"天府之国","pinyin":"tiān fǔ zhī guó","abbr":"tfzg","explanation":"天府：天生的仓库；国：地区。原指土地肥沃、物产丰富的地区。后专指四川。","source":{"text":"田肥美，民殷富，战车万乘，奋击百万，沃野千里，蓄积饶多，地势形便，此所谓天府，天下之雄国也。","book":"《战国策·秦策一》"},"example":{"text":"益州险塞，沃野千里，～，高祖因之以成帝业。","book":"明·罗贯中《三国演义》第三十八回"},"similar":["天府之土"],"opposite":["不毛之地"],"usage":"作宾语；专指四川","story":["战国时期，苏秦到秦国去游说秦惠王实行连横的主张，他对秦惠王说：“大王之国，西有巴蜀汉中之利，北有胡貉代马之用，南有巫山黔中之限，东有肴函之固，田肥美，民殷富，战车万乘，奋击百万，沃野千里，真是天府之国……”秦惠王不为所动"]},{"id":13779,"word":"天府之土","pinyin":"tiān fǔ zhī tǔ","abbr":"tfzt","explanation":"天府：天生的仓库；土：土地，地区。原指土地肥沃、物产丰富的地区。后专指四川。","source":{"text":"田肥美，民殷富，战车万乘，奋击百万，沃野千里，蓄积饶多，地势形便，此所谓天府，天下之雄国也。","book":"《战国策·秦策一》"},"similar":["天府之国"],"usage":"作宾语；专指四川"},{"id":13780,"word":"天开图画","pinyin":"tiān kāi tú huà","abbr":"tkth","explanation":"上天展示出来的图画。形容秀丽的自然景色。","source":{"text":"夕阳尽处望清闲，想见千岩细菊斑。人得交游是风月，天开图画即江山。","book":"宋·黄庭坚《王厚颂二首》其二"},"example":{"text":"楼观数南国，烟雨压东州。溪山雄胜，～肖瀛洲。","book":"宋·李处全《水调歌头·处州烟雨楼落成，欲就中秋，后值雨》"},"usage":"作宾语、定语；用于书面语"},{"id":13781,"word":"天开地辟","pinyin":"tiān kāi dì pì","abbr":"tkdp","explanation":"犹言开天辟地。","source":{"text":"天开地辟由盘古，人物才分下土。","book":"宋·欧阳修《晋祠》诗：“天开地辟真主出，犹须再驾方凯旋。”宋·洪适《奉礼歌》：“斗转参横将旦，天开地辟如春。”元·刘致《端正好·上高监司》套曲"},"example":{"text":"你这泼猴，不知好歹！他那人参果树，乃～的灵根。","book":"明·吴承恩《西游记》第二十六回"},"similar":["开天辟地","天地开辟"],"usage":"作谓语、定语；比喻前所未有的伟大事业"},{"id":13782,"word":"天怒人怨","pinyin":"tiān nù rén yuàn","abbr":"tnry","explanation":"天公震怒，人民怨恨。形容为害作恶非常严重，引起普遍的愤怒。","source":{"text":"自是士林愤痛，人怨天怒，一夫奋臂，举州同声。","book":"《后汉书·袁绍传》"},"example":{"text":"～，祸几日深，非细故也。","book":"《明史·倪岳传》"},"similar":["怨声载道","天怒民怨"],"opposite":["歌功颂德"],"usage":"作谓语、宾语、状语；指引起公愤"},{"id":13783,"word":"天怒民怨","pinyin":"tiān nù mín yuàn","abbr":"tnmy","explanation":"天公震怒，人民怨恨。形容为害作恶非常严重，引起普遍的愤怒。","source":{"text":"自是士林愤痛，人怨天怒，一夫奋臂，举州同声。","book":"《后汉书·袁绍传》"},"example":{"text":"三纲尽绝，五伦有乖，～，自古及今，罪恶昭著未有若此之甚者。","book":"明·许仲琳《封神演义》第九十四回"},"similar":["天怒人怨"],"usage":"作定语、宾语、状语；指引起公愤"},{"id":13784,"word":"天恩祖德","pinyin":"tiān ēn zǔ dé","abbr":"tezd","explanation":"天恩：皇恩；祖德：祖宗的荫德。皇上和祖宗的恩德。","source":{"text":"当此，则自欲将已往所赖天恩祖德，锦衣纨袴之时，饫甘餍肥之日，背父兄教育之恩，负师友规训之德，以至今日一技无成，半生潦倒之罪，编述一集，以告天下人。","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"母亲放心，不妨。总是～，五行有救。","book":"清·文康《儿女英雄传》第十二回"}},{"id":13785,"word":"天悬地隔","pinyin":"tiān xuán dì gé","abbr":"txdg","explanation":"悬、隔：距离远。比喻相差极大。","source":{"text":"《南齐书·陆厥传》： “一人之思，迟速天悬；一家之文，工拙壤隔。”"},"example":{"text":"真真一个娘肚子里跑出这样～的两个人来。","book":"清·曹雪芹《红楼梦》第五十五回"},"similar":["天差地远"],"usage":"作谓语、定语；比喻相差极大"},{"id":13786,"word":"天惊石破","pinyin":"tiān jīng shí pò","abbr":"tjsp","explanation":"原形容箜篌的声音，忽而高亢，忽而低沉，出人意外，有能以形容的奇境。后多比喻文章议论新奇惊人。","source":{"text":"女娲炼石补天处，石破天惊逗秋雨。","book":"唐·李贺诗《李凭箜篌引》"},"example":{"text":"小弟只记得那年畅闻高谕，所谈西周政治艺术，～，推崇备至，私心窃以为过当。","book":"清·曾朴《孽海花》第十八回"},"similar":["石破天惊"],"usage":"作谓语、定语、状语；形容震惊"},{"id":13787,"word":"天愁地惨","pinyin":"tiān chóu dì cǎn","abbr":"tcdc","explanation":"天地都感到愁苦、凄惨。形容极其悲惨（多用作渲染气氛）。","source":{"text":"是夜，天愁地惨，月色无光，孔明奄然归天。","book":"明·罗贯中《三国演义》第104回"},"example":{"text":"见女儿哭的～，候着丈夫过殓，出来拜公婆。","book":"清·吴敬梓《儒林外史》第48回"},"similar":["天昏地惨"],"usage":"作谓语、定语；多用作渲染气氛"},{"id":13788,"word":"天成地平","pinyin":"tiān chéng dì píng","abbr":"tcdp","explanation":"成：成功；平：治平。原指禹治水成功而使天之生物得以有成。后常比喻一切安排妥帖。","source":{"text":"舜臣尧，举八恺，使主后土，以揆百事，莫不时序，地平天成。","book":"《尚书·大禹谟》：“帝曰：‘俞！地平天成，六府三事，允治。万世永赖，时乃工。’”《左传·文公十八年》"},"example":{"text":"陛下功崇德巨，～。","book":"唐·韩愈《圆册尊号表》"},"similar":["天平地成"],"opposite":["天下大乱"],"usage":"作谓语、定语、状语；指天下太平"},{"id":13789,"word":"天打雷击","pinyin":"tiān dǎ léi jī","abbr":"tdlj","explanation":"雷击：雷电杀伤。比喻不得好死。","source":{"text":"小人若是哄老爷，小人叫天打雷击了。","book":"清·李绿园《歧路灯》第65回"},"similar":["天打雷劈"],"usage":"作谓语、宾语；常用作骂人或赌咒"},{"id":13790,"word":"天打雷劈","pinyin":"tiān dǎ léi pī","abbr":"tdlp","explanation":"比喻不得好死。常用作骂人或赌咒的话。","source":{"text":"我在嫂子面前，若有一句谎话，天打雷劈！","book":"清·曹雪芹《红楼梦》第12回"},"example":{"text":"我如果有半句假话就会遭～。"},"similar":["天打雷击","五雷轰顶"],"usage":"作谓语、宾语；常用作骂人或赌咒"},{"id":13791,"word":"天打雷轰","pinyin":"tiān dǎ léi hōng","abbr":"tdlh","explanation":"比喻不得好死。常用作骂人或赌咒的话。","source":{"text":"好婶娘，亲婶娘，以后蓉儿要不真心孝顺您老人家，天打雷劈。","book":"清·曹雪芹《红楼梦》第六十八回"},"example":{"text":"如有违背，甘心承受天罚，遭受天打雷轰。","book":"爱新觉罗·溥仪《我的前半生》九"}},{"id":13792,"word":"天授地设","pinyin":"tiān shòu dì shè","abbr":"tsds","explanation":"指天然形成。","source":{"text":"凡登览而惝恍，俯瞰而峭绝，天授地设，不待人力而巧者，洛阳独有此园尔。","book":"宋·邵博《闻见后录》卷二十五"},"similar":["天造地设","天生地设"],"usage":"作谓语、定语；指事物自然形成"},{"id":13793,"word":"天摇地动","pinyin":"tiān yáo dì dòng","abbr":"tydd","explanation":"形容威力或声势极大。","source":{"text":"这场大战，真个是天摇地动，日色无光。","book":"清·钱彩《说岳全传》第四十三回"},"example":{"text":"刚一迷糊眼儿，半天空里咕隆隆地一声响，从西半天响到东半天，震得～。","book":"梁斌《播火记》二四"},"similar":["天旋地转"],"opposite":["风平浪静"],"usage":"作谓语、定语；形容声势或威力极大"},{"id":13794,"word":"天摧地塌","pinyin":"tiān cuī dì tā","abbr":"tcdt","explanation":"摧：毁坏，犹如天塌地陷。比喻重大事变。亦形容巨大声响。","source":{"text":"你直待白骨中原如卧麻。虽是这战伐，负着个天摧地塌，是必想着俺子母每早来家。","book":"元·关汉卿《拜月亭》楔子"},"example":{"text":"众诸侯听得关外鼓声大振，喊声大举，如～，岳撼山崩，众皆失惊。","book":"明·罗贯中《三国演义》第五回"},"similar":["天塌地陷"],"usage":"作宾语、定语；比喻重大灾变"},{"id":13795,"word":"天文地理","pinyin":"tiān wén dì lǐ","abbr":"twdl","explanation":"泛指知识、学问。","source":{"text":"某乃是中原一秀士，能知天文地理，善会阴阳，识得六甲风云，辨别三光气色，九流三教，无所不通。","book":"明·施耐庵《水浒传》第113回"},"example":{"text":"他懂得很多～知识。"},"usage":"作主语、定语、宾语；泛指知识"},{"id":13796,"word":"天文数字","pinyin":"tiān wén shù zì","abbr":"twsz","explanation":"表示极大的数字。","example":{"text":"这些钱对我来说是一个～。"},"opposite":["凤毛麟角"],"usage":"作宾语、定语；指极大的数字"},{"id":13797,"word":"天方夜谭","pinyin":"tiān fāng yè tán","abbr":"tfyt","explanation":"比喻虚诞、离奇的议论。","source":{"text":"郑子云的话在他看来是书呆子的呓语，咬文嚼字、天方夜谭、理想主义。","book":"张洁《沉重的翅膀》"},"example":{"text":"你不要做～的梦了。"},"similar":["无稽之谈"],"usage":"作宾语、定语；比喻虚诞离奇的议论"},{"id":13798,"word":"天旋地转","pinyin":"tiān xuán dì zhuàn","abbr":"txdz","explanation":"天地转动。比喻重大的变化。也形容眩晕时的感觉或闹得极凶。","source":{"text":"天旋地转回龙驭，到此踌躇不能去。","book":"唐·白居易《长恨歌》"},"example":{"text":"低下头歇了一会，觉得～，忽忽悠悠，再也站不起来。 ◎梁斌《红旗谱》四五"},"similar":["地动山摇","头晕目眩"],"opposite":["安安静静"],"usage":"联合式；作谓语、宾语、分句；形容人眩晕时的感觉"},{"id":13799,"word":"天无二日","pinyin":"tiān wú èr rì","abbr":"twer","explanation":"日：太阳，比喻君王。天上没有两个太阳。旧喻一国不能同时有两个国君。比喻凡事应统于一，不能两大并存。","source":{"text":"天无二日，土无二王，家无二主，尊无二上。","book":"《礼记·曾子问》"},"example":{"text":"～，我岂有二主哉！","book":"清·陈忱《水浒后传》第二十三回"},"similar":["天无二日，民无二主"],"usage":"作宾语；指只能有一个主宰力量","story":["西汉初年，刘邦称帝后仍很尊敬父亲，他每次探望父亲都要行跪拜礼。随行的官员偷偷对他的父亲说：“天无二日，地无二君，他是皇上你是人臣，不能乱纲常。”刘邦父亲认为有理就取消这个礼节，刘邦得知后封父亲为太上皇继续行跪拜礼"]},{"id":13800,"word":"天无二日，土无二王","pinyin":"tiān wú èr rì，tǔ wú èr wáng","abbr":"twertwew","explanation":"日：太阳；土：国土。天上没有两个太阳，一国不能同时有两个国王。","source":{"text":"天无二日，土无二王，家无二主，尊无二上。","book":"西汉·戴圣《礼记·坊记》"},"similar":["天无二日，民无二王"],"usage":"作宾语、定语；用于政治等"},{"id":13801,"word":"天无二日，民无二主","pinyin":"tiān wú èr rì，mín wú èr zhǔ","abbr":"twermwez","explanation":"日：太阳。天上没有两个太阳，一国不能同时有两个国王。","source":{"text":"吾闻东方有称帝者，天无二日，民岂有二主耶？","book":"《元史·太祖本纪》"},"similar":["天无二日，土无二王"],"usage":"作宾语、定语；用于政治等"},{"id":13802,"word":"天无二日，民无二王","pinyin":"tiān wú èr rì，mín wú èr wáng","abbr":"twermwew","explanation":"天上不能同时有两个太阳，老百姓不能同时有两个君主。比喻事物统于一，不能两大并存。常比喻一国不能有两个国君。","source":{"text":"孔子曰：‘天无二日，民无二王。’舜既为天子矣，可帅天下诸侯以为尧三年丧，是二天子矣。","book":"《孟子·万章上》"},"example":{"text":"古人说：～。你为什么定要和我对抗？","book":"郭沫若《女神·天狗》"},"similar":["天无二日，民无二主"],"usage":"作宾语、定语；用于政治等"},{"id":13803,"word":"天无宁日","pinyin":"tiān wú níng rì","abbr":"twnr","explanation":"宁：安宁。国家动荡而没有太平的时候。","source":{"text":"自从孙大炮革起命来，把清朝的江山推到，天无宁日。","book":"梁斌《红旗谱》第一卷"},"example":{"text":"在过去，你老是说孙中山鼓吹革命好，自从孙大炮革起命来，把清朝的江山推倒，～！","book":"梁斌《红旗谱》六"},"usage":"作谓语、定语；用于局面等"},{"id":13804,"word":"天无绝人之路","pinyin":"tiān wú jué rén zhī lù","abbr":"twjrzl","explanation":"天下不会断绝人的出路，把人困死。比喻人虽一时处于绝境，但终归可以找到出路。","source":{"text":"果然天无绝人之路，只是那东北上摇下一只船来。","book":"元·无名氏《货郎担》第四折"},"example":{"text":"又道是～，正在街上卖身，只见一个老妈妈走近前来。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"similar":["天不绝人"],"opposite":["走投无路"],"usage":"作宾语、分句；用于劝诫人"},{"id":13805,"word":"天日不懂","pinyin":"tiān rì bù dǒng","abbr":"trbd","explanation":"比喻没有知识。","source":{"text":"比不得三年前，人事不知天日不懂的，如今也觉明白些了，越想越不是玩的。","book":"清·石玉昆《三侠五义》第八十一回"},"example":{"text":"天下作女孩儿的，除了那班～、麻木不仁的姑娘外，是个女儿，便有个女儿情态。","book":"清·文康《儿女英雄传》第二十七回"}},{"id":13806,"word":"天时地利人和","pinyin":"tiān shí dì lì rén hé","abbr":"tsdlrh","explanation":"指作战时的自然气候条件，地理环境和人心的向背。","source":{"text":"天时、地利、人和，三者不得，虽胜有殃。","book":"《孟子·公孙丑下》：“天时不如地利，地利不如人和。”《孙膑兵法·月战》"},"example":{"text":"咸渊想了一会，道：‘行兵须要天时、地利、人和。为今之计，地利、人和倒用不着了，是要讲天时了。’","book":"清·刘璋《斩鬼传》第八回"},"usage":"作主语、宾语、定语；用于处事"},{"id":13807,"word":"天昏地惨","pinyin":"tiān hūn dì cǎn","abbr":"thdc","explanation":"昏：天黑。天地昏黑无光。形容刮大风时漫天沙土的景象。也比喻政治腐败，社会黑暗。","source":{"text":"天昏地黑蛟龙移，雷惊电激雄雌随。","book":"唐·韩愈《龙移》诗"},"example":{"text":"～无光彩，宇宙浑然黑雾迷。","book":"明·许仲琳《封神演义》第四十七回"},"similar":["天愁地惨"],"usage":"作定语、状语；用于悲惨场合"},{"id":13808,"word":"天昏地暗","pinyin":"tiān hūn dì àn","abbr":"thda","explanation":"昏：天黑。天地昏黑无光。形容刮大风时漫天沙土的景象。也比喻政治腐败，社会黑暗。","source":{"text":"天昏地黑蛟龙移，雷惊电激雄雌随。","book":"唐·韩愈《龙移》诗"},"example":{"text":"只见狂风四起，飞沙走石，～，日月无光。","book":"明·施耐庵《水浒全传》第六十回"},"similar":["昏天黑地","暗无天日"],"opposite":["天朗气清","风和日丽"],"usage":"作谓语、宾语、状语；指天色或社会"},{"id":13809,"word":"天昏地黑","pinyin":"tiān hūn dì hēi","abbr":"thdh","explanation":"天地一片昏黑。常用以形容风霾、雷雨时的自然景象。亦形容异常利害。","source":{"text":"秦氏道：‘天机不可泄漏。只是我与婶子好了一场，临别赠你两句话，须要记着。’","book":"清·曹雪芹《红楼梦》第十三回"},"example":{"text":"清·无名氏《说呼全传》第39回：“那晓忽地里起了大雾，迷得～，连这路儿也看不出来，白白的守了几天。”"},"similar":["天昏地暗"],"usage":"作谓语、宾语、状语；指天色或社会"},{"id":13810,"word":"天有不测风云","pinyin":"tiān yǒu bù cè fēng yún","abbr":"tybcfy","explanation":"比喻灾祸是无法预料的。","source":{"text":"天有不测风云，人有旦夕祸福。","book":"元·无名氏《合同文字》第四折"},"example":{"text":"这实在是叫作‘～’，她的男人是坚实人，谁知道年纪青青，就会断送在伤寒上？","book":"鲁迅《彷徨·祝福》"},"similar":["人有旦夕祸福"],"usage":"作宾语、分句；指意外灾祸","story":["三国时期，曹操屯兵赤壁欲进攻东吴，周瑜与孔明商量用火攻，可此时季节已过没有东南风。周瑜气得生病，孔明去看他，他说：“人有旦夕祸福。”孔明说：“天有不测风云。”并送他“欲破曹公，宜用火攻，万事俱备，只欠东风。”于是刮起了东风"]},{"id":13811,"word":"天有不测风云，人有旦夕祸福","pinyin":"tiān yǒu bù cè fēng yún，dì yǒu dàn xī huò fú","abbr":"tybcfyrydxhf","explanation":"不测：料想不到。比喻有些灾祸的发生，事先是无法预料的。","source":{"text":"天有不测风云，人有旦夕祸福。","book":"宋·无名氏《张协状元·胜花气死》"},"example":{"text":"～，人有旦夕祸福，那厮恰才无病。怎生下在牢里便有病？张千，你再去看来。","book":"元·无名氏《合同文字》第四折"},"similar":["天有不测风云，人有暂时祸福"],"usage":"作宾语、分句；用于劝诫人","story":["三国时期，曹操屯兵赤壁欲进攻东吴，周瑜与孔明商量用火攻，可此时季节已过没有东南风。周瑜气得生病，孔明去看他，他说：“人有旦夕祸福。”孔明说：“天有不测风云。”并送他“欲破曹公，宜用火攻，万事俱备，只欠东风。”于是刮起了东风"]},{"id":13812,"word":"天有不测风云，人有暂时祸福","pinyin":"tiān yǒu bù cè fēng yún,rén yǒu zàn shí huò fú","abbr":"tybcfyryzshf","explanation":"不测：料想不到。比喻有些灾祸的发生，事先是无法预料的。","source":{"text":"李足道‘天有不测风云，人有暂时祸福’，你怎么就保得无事？","book":"明·吴承恩《西游记》第十回"},"similar":["天有不测风云，人有旦夕祸福"],"usage":"作宾语、分句；用于劝诫人"},{"id":13813,"word":"天朗气清","pinyin":"tiān lǎng qì qīng","abbr":"tlqq","explanation":"朗：明朗。形容天空晴朗，空气清新。","source":{"text":"是日也，天朗气清，惠风和畅，仰观宇宙之大，俯察品类之盛。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"其日～，惠风庆云，真是昌期应运，太平景象，自然迥别。","book":"明·许仲琳《封神演义》第九十八回"},"similar":["天高气爽","天清气朗"],"opposite":["乌云密布","风雨交加"],"usage":"作谓语、定语；指天高气爽"},{"id":13814,"word":"天末凉风","pinyin":"tiān mò liáng fēng","abbr":"tmlf","explanation":"天末：天的尽头；凉风：特指初秋的西南风。原指杜甫因秋风起而想到流放在天末的挚友李白。后常比喻触景生情，思念故人。","source":{"text":"凉风起天末，君子意如何？","book":"唐·杜甫《天末怀李白》诗"},"usage":"作宾语、定语；指思念故人"},{"id":13815,"word":"天机不可泄漏","pinyin":"tiān jī bù kě xiè lòu","abbr":"tjbkxl","explanation":"旧时迷信认为世事都由上天安排，而事先却不能泄漏。也指涉及机密的事，不到时候不能预先透露。","source":{"text":"秦氏道：‘天机不可泄漏。只是我与婶子好了一场，临别赠你两句话，须要记着。’","book":"清·曹雪芹《红楼梦》第十三回"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“‘～。’胡雪岩拿手一指嵇鹤龄，‘雪公，……’”"},"similar":["天机不可泄露"],"usage":"作谓语、宾语、定语；用于口语"},{"id":13816,"word":"天机不可泄露","pinyin":"tiān jī bù kě xiè lù","abbr":"tjbkxl","explanation":"旧时迷信认为世事都由上天安排，而事先却不能泄露。也指涉及机密的事，不到时候不能预先透露。同“天机不可泄漏”。","source":{"text":"那时老先生尚不曾高发，天机不可泄露，所以晚生就预先回避了。","book":"清·吴敬梓《儒林外史》第七回"},"example":{"text":"此乃～，你就听天由命吧"},"similar":["天机不可泄漏"],"usage":"作谓语、宾语、定语；用于口语"},{"id":13817,"word":"天机云锦","pinyin":"tiān jī yún jǐn","abbr":"tjyj","explanation":"天上织出的锦绣。比喻诗文华美精妙，浑成自然。","source":{"text":"所以出奇之语，以白石骚雅句法润色之，真天机云锦也。","book":"宋·张炎《词源·杂论》"},"usage":"作宾语、定语；多用于比喻句"},{"id":13818,"word":"天步艰难","pinyin":"tiān bù jiān nán","abbr":"tbjn","explanation":"天步：旧指国运、时运。意指国运艰难。","source":{"text":"天步艰难，之子不犹。","book":"《诗经·小雅·白华》"},"example":{"text":"～也要走下去……不要紧，还是要走下去的……（二月河《乾隆皇帝》三十八）"},"usage":"作宾语、定语；用于书面语"},{"id":13819,"word":"天涯咫尺","pinyin":"tiān yá zhǐ chǐ","abbr":"tyzc","explanation":"咫：古代长度单位，周制八寸，合今市尺六寸二分二厘；咫尺：比喻距离很近。比喻距离虽近，但很难相见，象是远在天边一样。","source":{"text":"门锁帘垂月影斜，翠华咫尺隔天涯。","book":"《左传·僖公九年》：“天威不违颜咫尺。”唐·李中《宫词二首》"},"example":{"text":"衷肠事，无由竭，似水滔滔，相流不绝，对面还愁，～。 ◎明·胡文焕《群音类选·访友记·又赛槐阴分别》"}},{"id":13820,"word":"天涯地角","pinyin":"tiān yá dì jiǎo","abbr":"tydj","explanation":"形容极远的地方，或相隔极远。","source":{"text":"天涯藐藐，地角悠悠了，阴谋诡计　面无由，但以情企。","book":"南朝陈·徐陵《武皇帝作相时与岭南酋豪书》"},"example":{"text":"无穷无尽是离愁，～寻思遍。","book":"宋·晏殊《踏莎行》词"},"similar":["天涯海角"],"usage":"作宾语；形容地方偏远"},{"id":13821,"word":"天涯比邻","pinyin":"tiān yá bǐ lín","abbr":"tybl","explanation":"虽然相隔极远，但近如邻居一样。","source":{"text":"海内存知己，天涯若比邻。","book":"唐·王勃《送杜少府之任蜀州》诗"},"example":{"text":"～，固古人神旷之说。","book":"明·王世贞《与吴明卿书》"},"similar":["天涯若比邻"],"usage":"作宾语、定语；指两者关系很好"},{"id":13822,"word":"天涯海角","pinyin":"tiān yá hǎi jiǎo","abbr":"tyhj","explanation":"形容极远的地方，或相隔极远。","source":{"text":"今之远宦及远服贾者，皆曰天涯海角。","book":"南朝陈·徐陵《武皇帝作相时与岭南酋豪书》：“天涯藐藐，地角悠悠了，阴谋诡计　面无由，但以情企。”宋·张世南《游宦记闻》卷六"},"example":{"text":"我们俱系～之人，今幸得贤主人相邀一聚，也是三生之缘。","book":"清·吴敬梓《儒林外史》第四十六回"},"similar":["天南地北","天各一方"],"opposite":["近在咫尺","一衣带水"],"usage":"作宾语；形容地方偏远","story":["唐朝时期，韩愈从小失去父母，靠兄长韩会一家带大，他勤奋学习终于考取了进士，直到40岁才正式被任命为校书郎，定居长安。他想接嫂子及侄儿十二郎来长安居住，可惜他们中途去世。韩愈作《祭十二郎文》倾诉他们骨肉相隔天涯海角的痛苦之情"]},{"id":13823,"word":"天涯若比邻","pinyin":"tiān yá ruò bǐ lín","abbr":"tyrbl","explanation":"表达对远方友人的情谊。","source":{"text":"海内存知己，天涯若比邻。","book":"唐·王勃《送杜少府之任蜀州》"},"similar":["天涯比邻"],"usage":"作定语、分句；指友情"},{"id":13824,"word":"天清日白","pinyin":"tiān qīng rì bái","abbr":"tqrb","explanation":"犹言光天化日，大白天。","source":{"text":"不然时今日天清日白，在你家里搜出人腿来，人目昭彰，一传出去，不到得轻放过了你。","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"similar":["光天化日","青天白日"],"usage":"作宾语、定语；用于书面语"},{"id":13825,"word":"天清气朗","pinyin":"tiān qīng qì lǎng","abbr":"tqql","explanation":"朗：明朗。形容天空晴朗，空气清新。","source":{"text":"是日也，天朗气清，惠风和畅，仰观宇宙之大，俯察品类之盛。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"今日～，道清，你与我叫门公王安，打扫凉棚下干净，我操琴则个。","book":"明·无名氏《女真观》楔子"}},{"id":13826,"word":"天渊之别","pinyin":"tiān yuān zhī bié","abbr":"tyzb","explanation":"天和地，一极在上，一极在下。比喻差别极大。","source":{"text":"趋舍所尚，耳目之欲，其为不同，已有天壤之觉（较），冰炭之乖矣。","book":"《抱朴子·内篇·论仙》"},"example":{"text":"这华得夫客店，是纽约第一个著明客店，比起日本帝国大客店来，有～了。（清·李宝嘉《文明小史》第五十一回）"},"similar":["天壤之别","天差地别"],"opposite":["千篇一律"],"usage":"作宾语；比喻差别极大"},{"id":13827,"word":"天渊之差","pinyin":"tiān yuān zhī chā","abbr":"tyzc","explanation":"差：判别。天和地，一极在上，一极在下。比喻差别极大。","source":{"text":"趋舍所尚，耳目之欲，其为不同，已有天壤之觉，冰炭之乖矣。","book":"《抱朴子·论仙》"}},{"id":13828,"word":"天渊之隔","pinyin":"tiān yuān zhī gé","abbr":"tyzg","explanation":"渊：深水潭。形容相隔极远，差别很大。","source":{"text":"那徐言、徐召虽也挣起些田产，比着颜氏，尚有天渊之隔，终日眼红颈赤。","book":"明·冯梦龙《醒世恒言》第三十五卷"},"example":{"text":"赵公子闻他有大贵之相，况兼德行皆全，英才日盛，较诸韩公子不啻～。","book":"清·吴璿《飞龙全传》第六十回"},"similar":["天渊之别","天壤之别","天壤之隔"],"usage":"作宾语；比喻差别极大"},{"id":13829,"word":"天渊悬隔","pinyin":"tiān yuān xuán gé","abbr":"tyxg","explanation":"天和地，一极在上，一极在下。比喻差别极大。","source":{"text":"趋舍所尚，耳目之欲，其为不同，已有天壤之觉，冰炭之乖矣。","book":"《抱朴子·论仙》"},"example":{"text":"即此一事，你我比较起来，～。","book":"清·俞万春《荡寇志》第一百三十回"}},{"id":13830,"word":"天潢贵胄","pinyin":"tiān huáng guì zhòu","abbr":"thgz","explanation":"天潢：皇族，宗室；贵胄：地位高贵的后代。旧时泛指皇族宗室子孙。","source":{"text":"其实也可怜得很，他们又不能作买卖，说是说得好听得很，天潢贵胄呢，谁知一点生机都没有，所以就只能靠着那带子上的颜色云行诈了。","book":"清·吴趼人《二十年目睹之怪现状》第二十七回"},"example":{"text":"老舍《老张的哲学》：“北岸上一片绿瓦高阁，清摄政王的府邸，依旧存着～的尊严气象。”"},"usage":"作主语、宾语、定语；用于书面语"},{"id":13831,"word":"天灾人祸","pinyin":"tiān zāi rén huò","abbr":"tzrh","explanation":"天：自然。自然的灾害和人为的祸患。也比喻害人精（骂人的话）。","source":{"text":"屠世雄并无此事，敢是另有个天灾人祸，假称屠世雄的么。","book":"元·无名氏《冯玉兰》第四折"},"example":{"text":"但仆生长危邦，年逾大衍，～，所见多矣。","book":"鲁迅《书信集·致台静农》"},"usage":"作主语、宾语；指自然的灾害和人为的祸患"},{"id":13832,"word":"天灾地变","pinyin":"tiān zāi dì biàn","abbr":"tzdb","explanation":"天地所发生的灾害和变异。古人迷信，认为是上天对统治者的警告。","source":{"text":"比年以来，天灾地变，都在秦凉。","book":"《魏书·崔浩传》"},"similar":["天灾地孽","天灾物怪"],"usage":"作主语、宾语、定语；指灾祸等"},{"id":13833,"word":"天灾地妖","pinyin":"tiān zāi dì yāo","abbr":"tzdy","explanation":"自然界发生的灾害怪异。","source":{"text":"存亡祸福，皆己而已，天灾地妖，不能加也。","book":"《孔子家语·五仪》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":13834,"word":"天灾地孽","pinyin":"tiān zāi dì niè","abbr":"tzdn","explanation":"天地所发生的灾害和变异。古人迷信，认为是上天对统治者的警告。","source":{"text":"天灾地孽，物怪人妖，衣冠钳口，道路以目。","book":"《隋书·高祖纪下》"},"example":{"text":"君子潜逃，小人得志，～，物怪人妖，衣冠钳口，道路以目。","book":"蔡东藩《南北史演义》第八十四回"},"similar":["天灾地变","天灾物怪"],"usage":"作主语、宾语、定语；指灾祸等"},{"id":13835,"word":"天灾物怪","pinyin":"tiān zāi wù guài","abbr":"tzwg","explanation":"天地所发生的灾害和变异。古人迷信，认为是上天对统治者的警告。","source":{"text":"天灾地孽，物怪人妖，衣冠钳口，道路以目。","book":"《隋书·高祖纪下》"},"example":{"text":"～，罔彻宸聪；国计民生，莫关圣虑。","book":"《明史·王家屏传》"},"similar":["天灾地变","天灾地孽"],"usage":"作主语、宾语、定语；指灾祸等"},{"id":13836,"word":"天王下界","pinyin":"tiān wáng xià jiè","abbr":"twxj","explanation":"天王：迷信中的一种天神；下界：从天上来到人间。比喻极其威严的吏役。","source":{"text":"若到乡里愚百姓家，便是天王下界，黑煞神临凡一般。","book":"清·李绿园《歧路灯》第九十一回"},"usage":"作宾语、定语；用于比喻句"},{"id":13837,"word":"天王老子","pinyin":"tiān wáng lǎo zǐ","abbr":"twlz","explanation":"比喻至尊至贵、最有权威的人。","source":{"text":"今天不要说是周乡绅，就是你们请出天王老子来，也不中用了。","book":"洪深《五奎桥》第一幕"},"example":{"text":"～也挡不住改霞到生宝的草棚屋做媳妇去！","book":"柳青《创业史第一部第十五章》"},"similar":["天王老子地王爷"],"usage":"作主语、宾语、定语；指权力极大的人物"},{"id":13838,"word":"天理不容","pinyin":"tiān lǐ bù róng","abbr":"tlbr","explanation":"天理：天道；容：容忍、宽容。旧指做事残忍，灭绝人性，为天理所不容。","source":{"text":"才见得冤冤相报，方信道天理难容。","book":"元·无名氏《朱砂担》第四折"},"example":{"text":"如此冤情，若不诛卫郑，～，人心不服。","book":"明·冯梦龙《东周列国志》第四十二回"},"similar":["天理难容"],"usage":"作谓语、定语；用于感慨"},{"id":13839,"word":"天理人情","pinyin":"tiān lǐ rén qíng","abbr":"tlrq","explanation":"天理：天性。天然的道理和人的常情。泛指情理。","source":{"text":"孔子抱圣人之心，彷徨乎道德之域，逍遥乎无形之乡，倚天理，观人情，明始终，知得失。","book":"汉·韩婴《韩诗外传》卷五"},"example":{"text":"吾岂不爱将军雄杰，但～上，难以相款。","book":"明·徐渭《英烈传》第五十四回"},"usage":"作宾语；泛指情理"},{"id":13840,"word":"天理昭彰","pinyin":"tiān lǐ zhāo zhāng","abbr":"tlzz","explanation":"昭彰：明显。旧称天能主持公道，善恶报应分明。","source":{"text":"这一个天理昭昭，谁想到有今朝。","book":"元·无名氏《冯玉兰》第三折"},"example":{"text":"今司马受戮，～。","book":"明·冯梦龙》东周列国志》第八回"},"similar":["天理昭然","天理昭昭"],"usage":"作谓语、定语；用于劝诫人"},{"id":13841,"word":"天理昭昭","pinyin":"tiān lǐ zhāo zhāo","abbr":"tlzz","explanation":"昭昭：明显。旧称天能主持公道，善恶报应分明。","source":{"text":"伊川有天理昭彰语。","book":"宋·朱熹《朱子语类·论语·吾与回也章》"},"example":{"text":"这一个～，谁想到有今朝。","book":"元·无名氏《冯玉兰》第三折"},"similar":["天理昭彰","天理昭然"],"usage":"作谓语、定语；用于劝诫人"},{"id":13842,"word":"天理昭然","pinyin":"tiān lǐ zhāo rán","abbr":"tlzr","explanation":"昭然：明显。旧称天能主持公道，善恶报应分明。","source":{"text":"伊川有天理昭彰语。","book":"宋·朱熹《论语集注·吾与回也章》"},"example":{"text":"此乃五十三家不该遭在桧贼手中，亦见～也。","book":"明·冯梦龙《喻世明言》卷三十二"},"similar":["天理昭彰","天理昭昭"],"usage":"作谓语、定语；用于劝诫人"},{"id":13843,"word":"天理良心","pinyin":"tiān lǐ liáng xīn","abbr":"tllx","explanation":"天理：天性。指人的天性和善心。多用于发誓，表示凭天性和善心行事。","source":{"text":"一到院里，只听凤姐说道：‘天理良心！我在这屋里熬的越发成了贼了！’","book":"清·曹雪芹《红楼梦》第67回"},"example":{"text":"总要讲点～吧。"},"similar":["天地良心"],"usage":"作宾语、分句；用于感叹或发誓"},{"id":13844,"word":"天理难容","pinyin":"tiān lǐ nán róng","abbr":"tlnr","explanation":"天理：天道；容：容忍、宽容。旧指做事残忍，灭绝人性，为天理所不容。","source":{"text":"才见得冤冤相报，方信道天理难容。","book":"元·无名氏《朱砂担》第四折"},"example":{"text":"虽然也有个大小官爵，只是～也。","book":"明·吴承恩《西游记》第七十回"},"similar":["天理昭彰"],"usage":"作谓语、定语；用于感慨"},{"id":13845,"word":"天生一对","pinyin":"tiān shēng yī duì","abbr":"tsyd","explanation":"指生来就注定为一对。","source":{"text":"明明果是佳人才子，天生一对也，便是嫣素也觉风光。","book":"清·荑荻散人《玉娇梨》第十回"},"example":{"text":"他们是～活宝。"},"similar":["地造一双"],"usage":"作宾语、定语；用于口语","story":["孟良到五台山请杨五郎下山相助破萧天右的怪阵，杨五郎说要木阁寨的降龙木。杨宗保奉命去求降龙木。木阁寨寨主的女儿穆桂英武功高强，见杨宗保要降龙木，大战几十回合并活捉他，顿时爱上这个少年，觉得他们才是真正的天生一对"]},{"id":13846,"word":"天生丽质","pinyin":"tiān shēng lì zhì","abbr":"tslz","explanation":"天生：天然生成。丽质：美丽的姿容。形容女子妩媚艳丽。","source":{"text":"天生丽质难自弃，一朝选在君王侧。","book":"唐·白居易《长恨歌》"},"example":{"text":"蝉鬓拢云，蛾眉扫月，～难描。 ◎明·洪楩《清平山堂话本·风月相思》"}},{"id":13847,"word":"天生地设","pinyin":"tiān shēng dì shè","abbr":"tsds","explanation":"犹天造地设。","source":{"text":"看他二人恰是一对天生地设的夫妻。","book":"清·曹雪芹《红楼梦》第五十七回"},"example":{"text":"从来当局者迷，旁观者清，姐姐细想，这宝砚、雕弓，岂不是～的两桩红定？ ◎清·文康《儿女英雄传》第二十六回"}},{"id":13848,"word":"天生天化","pinyin":"tiān shēng tiān huà","abbr":"tsth","explanation":"指天然生就。","source":{"text":"这条计用着件东西，别人家里都没，天生天化大官人家里却有。","book":"明·施耐庵《水浒传》第25回"},"example":{"text":"马烽《吕梁英雄传》第一回：“硬把桦林山这座～的东西，霸成他自己的家产。”"},"similar":["天生地设"],"usage":"作定语、状语；用于书面语"},{"id":13849,"word":"天生天杀","pinyin":"tiān shàng tiān shā","abbr":"tsts","explanation":"指自生自化，自生自灭。","source":{"text":"天生天杀，道之理也。","book":"汉·张良《阴符经》"},"example":{"text":"《周书·张元传》：“有生之类，莫不重其性命。若～，自然之理。”"},"similar":["自生自灭"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":13850,"word":"天生尤物","pinyin":"tiān shēng yóu wù","abbr":"tsyw","explanation":"尤物：特殊的人物，多指美女。指容貌艳丽的女子。","source":{"text":"夫有尤物，足以移人。","book":"《左传·昭公二十八年》"},"example":{"text":"看他谁是蝉踪，自然治态，正是～，世不虚名。","book":"明·梅鼎祚《玉合记·砥节》"},"usage":"作宾语；指天生容貌艳丽的女子"},{"id":13851,"word":"天相吉人","pinyin":"tiān xiàng jí rén","abbr":"txjr","explanation":"相：帮助，保佑；吉人：善人。迷信的人认为好人会得到天的帮助。多用作对别人的患病或遇到困难、不幸的安慰话。","source":{"text":"晋楚唯天所相，不可与争。","book":"《左传·宣公三年》：“石癸曰：‘吾闻，姬、姞耦，其子孙必蕃。姞，吉人也。’”又《昭公四年》"},"example":{"text":"惟祈～，调治平复，幸勿作衰败之语，徒长悲观。","book":"丁中江《北洋军阀史话》四十七"},"similar":["吉人天相"],"usage":"作宾语、定语；用于祝福或感叹"},{"id":13852,"word":"天真无邪","pinyin":"tiān zhēn wú xié","abbr":"tzwx","explanation":"邪：不正当。心地善良纯洁，没有不正当的想法。","source":{"text":"小青年们听了，都放下碗筷，用潮乎乎的眼睛看着这个天真无邪的孩子。","book":"顾笑言《正月十八吃元宵》"},"example":{"text":"于北蓓～的举动使我对那一夜的真实细节只留下模糊的记忆，却有一个刻骨铭心的温馨印象。","book":"王朔《动物凶猛》"},"usage":"作谓语、定语、状语；多用于女性与儿童"},{"id":13853,"word":"天真烂漫","pinyin":"tiān zhēn làn màn","abbr":"tzlm","explanation":"天真：指心地单纯，没有做作和虚伪；烂漫：坦率自然的样子。形容儿童思想单纯、活泼可爱，没有做作和虚伪。","source":{"text":"此儿此马俱可怜，马方三齿儿未冠。天真烂漫好容仪，楚楚衣裳无不宜。","book":"宋·龚开《高马小儿图》"},"example":{"text":"他的性情又是那样～，笃实敦厚。","book":"邹韬奋《经历·“难兄难弟”的又一个》"},"similar":["天真无邪","活泼可爱","天真烂缦"],"opposite":["老成持重"],"usage":"作谓语、定语、状语；形容儿童等","story":["南宋灭亡后，画家郑思肖隐居在苏州的一家寺庙里，在寓所里挂上“本穴世界”的横匾以表示对大宋的思念。他画一卷长一丈多的墨兰，题上“纯是君子，绝无小人”。人们见了便赞不绝口，一致夸他画得天真烂漫，超出物外"]},{"id":13854,"word":"天真烂熳","pinyin":"tiān zhēn làn màn","abbr":"tzlm","explanation":"形容儿童思想单纯、活泼可爱，没有做作和虚伪。同“天真烂漫”。"},{"id":13855,"word":"天真烂缦","pinyin":"tiān zhēn làn màn","abbr":"tzlm","explanation":"天真：指人心地善良。形容思想单纯、纯真自然、活泼可爱，没有做作和虚伪。","source":{"text":"她那种抢先说话的脾气、顽皮的举动，处处都露出天真烂缦。","book":"茅盾《虹》"},"similar":["天真烂熳","天真烂漫"],"usage":"作谓语、定语、状语；形容儿童等"},{"id":13856,"word":"天知地知","pinyin":"tiān zhī dì zhī","abbr":"tzdz","explanation":"天知道，地知道。指人人都知道。也指只有天知道，地知道，没有别人知道。","source":{"text":"你须知咱名讳，尽忠心天知地知。","book":"元·杨梓《敬德不服老》第三折"},"example":{"text":"到如今怨他谁，这烦恼则除是～。","book":"元·高栻《集贤宾·怨别》曲"},"similar":["天知地知你知我知"],"usage":"作宾语、分句；用于发誓"},{"id":13857,"word":"天神天将","pinyin":"tiān shén tiān jiàng","abbr":"tstj","explanation":"旧指天上的军队和将领。也比喻本领高强的人们。","source":{"text":"如今将天神天将许多人又都装进去了，我待求救于天，奈恐玉帝见怪。","book":"明·吴承恩《西游记》第六十五回"},"example":{"text":"若有人家养活着这佛猫，有多少～都护卫着哩。","book":"清·西周生《醒世姻缘传》第六回"},"similar":["天兵天将"],"usage":"作主语、宾语、定语；指神奇力量"},{"id":13858,"word":"天空海阔","pinyin":"tiān kōng hǎi kuò","abbr":"tkhk","explanation":"①指天地广阔。②常用以形容宏大宽阔。","source":{"text":"墨乡磅礴，天空海阔。","book":"宋·汤恢《满江红》词：“酒醒香销人自瘦，天空海阔春无极。”清·顾炎武《答子德书》：“要希馀光下被，俾暮年迂叟得自遂于天空海阔之间，尤为知己之爱也。”清·高凤翰《砚史》"},"example":{"text":"自己负了才名，又生了一副～的心性，洒脱不羁的胸襟，看得那中举人进士即如在他怀袖里的一般。","book":"清·西周生《醒世姻缘传》第十六回"},"similar":["海阔天空"],"usage":"作宾语、定语；用于比喻句"},{"id":13859,"word":"天粟马角","pinyin":"tiān sù mǎ jiǎo","abbr":"tsmj","explanation":"天雨粟，马生角。谓不可能实现的事。","source":{"text":"世言荆轲，其称太子丹之命，‘天雨粟，马生角’也，太过。","book":"《史记·刺客列传论》"},"example":{"text":"燕太子丹，不过礼士慕侠，而一时燕赵慷慨之徒，不平其事，遂有～之谈。","book":"清·顾炎武《菰中随笔》"},"usage":"作宾语、定语；用于比喻句"},{"id":13860,"word":"天纵多能","pinyin":"tiān zòng duō néng","abbr":"tzdn","explanation":"天纵：天所放任，意思是上天所赋予。旧指上天使之成为杰出的人物。","source":{"text":"大宰问于子贡曰：‘夫子圣者与？何其多能也？’子贡曰：‘固天纵之将圣，又多能也。’","book":"《论语·子罕》"},"example":{"text":"先帝～，克文克武，营迁谋伐，手不释卷。","book":"《魏书·裴延俊传》"}},{"id":13861,"word":"天经地义","pinyin":"tiān jīng dì yì","abbr":"tjdy","explanation":"经：规范，原则；义：正理。天地间历久不变的常道。指绝对正确，不能改变的道理。也指理所当然的事。","source":{"text":"夫礼，天之经也，地之义也，民之行也。","book":"《左传·昭公二十五年》"},"example":{"text":"学好科学文化知识是每个学生～的事。"},"similar":["理所当然","千真万确"],"opposite":["天理难容","岂有此理"],"usage":"作谓语、宾语、主语、定语；指绝对正确","story":["周敬王被太子朝赶出京城，晋顷公认为太子朝大逆不道，就联合宋国、卫国、郑国帮助周敬王打败太子朝重新掌政。晋国赵鞅问郑国大臣大叔吉什么是礼，大叔吉引用子彦的话说：“礼是‘天之经，地之义’，民从行动的依据。”"]},{"id":13862,"word":"天经地纬","pinyin":"tiān jīng dì wěi","abbr":"tjdw","explanation":"①指天地间理所当然、无可非议的道理。②引申为以天地为法度治理天下。","source":{"text":"礼，上下之纪、天地之经纬也。","book":"语出《左传·昭公二十五年》"},"example":{"text":"后主～、义冠人灵。","book":"南朝·陈·徐陵《为贞阳侯与陈司空书》"},"similar":["天地经纬"],"usage":"作宾语、定语；用于书面语"},{"id":13863,"word":"天缘凑合","pinyin":"tiān yuán còu hé","abbr":"tych","explanation":"天缘：自然的机缘。旧时认为男女结成夫妻是天意所配合。也指事属巧合。","source":{"text":"这婚姻是天缘凑合。","book":"元·石子章《竹坞听琴》第四折"},"example":{"text":"我正因他的一件事为难，要请教别人去。如今遇见姐姐，真是～，求姐姐指教。","book":"清·曹雪芹《红楼梦》第六十三回"},"similar":["天缘奇遇"],"usage":"作宾语；指事属巧合"},{"id":13864,"word":"天缘凑巧","pinyin":"tiān yuán còu qiǎo","abbr":"tycq","explanation":"天缘：自然的机缘。旧时认为男女结成夫妻是天意所配合。也指事属巧合。","source":{"text":"这婚姻是天缘凑巧。","book":"元·石子章《竹坞听琴》第四折"}},{"id":13865,"word":"天缘奇遇","pinyin":"tiān yuán qí yù","abbr":"tyqy","explanation":"旧指某些人相遇或男女结为夫妻，是天意所安排。也指事属巧合。","source":{"text":"无意之中，敲门寻宿，偏撞着卞玉京做了这葆真庵主，留俺暂住，这也是天缘奇遇。","book":"清·孔尚任《桃花扇·栖真》"},"example":{"text":"我们真要感谢那次～。"},"similar":["天缘凑合"],"usage":"作宾语；指天然巧合的缘分"},{"id":13866,"word":"天网恢恢","pinyin":"tiān wǎng huī huī","abbr":"twhh","explanation":"天网：天道之网；恢恢：宽广的样子。指天道如大网，坏人是逃不过这个网的，作恶必受到惩罚。","source":{"text":"天网恢恢，疏而不失。","book":"《老子》"},"example":{"text":"～万象疏，一身亲到华山区。","book":"唐·吕岩《哭陈先生》诗"},"similar":["天道恢恢"],"usage":"作宾语、定语；常与“疏而不漏”连用","story":["春秋时期，大哲学家老子认为人世上的一切都是命中注定，命运已经安排好了的东西，人们想改变它是不可能的，只能顺从自然的摆布，不要去争取，这样反而得不到什么好处，说不定还会有害处，这就叫天网恢恢、疏而不漏"]},{"id":13867,"word":"天网恢恢，疏而不失","pinyin":"tiān wǎng huī huī，shū ér bù shī","abbr":"twhhsebs","explanation":"意思是天道公平，作恶就要受惩罚，它看起来似乎很不周密，但最终不会放过一个坏人。比喻作恶的人逃脱不了国法的惩处。","source":{"text":"天网恢恢，疏而不失。","book":"《老子》第七十三章"}},{"id":13868,"word":"天网恢恢，疏而不漏","pinyin":"tiān wǎng huī huī，shū ér bù lòu","abbr":"twhhsebl","explanation":"意思是天道公平，作恶就要受惩罚，它看起来似乎很不周密，但最终不会放过一个坏人。比喻作恶的人逃脱不了国法的惩处。","source":{"text":"天网恢恢，疏而不漏。","book":"《老子》第七十三章：“天网恢恢，疏而不失。”《魏书·任城王传》"},"example":{"text":"你可记得三年前蔡指挥的事么？～。今日有何理说。","book":"明·冯梦龙《醒世恒言》卷三十六"},"similar":["天理昭昭","法网难逃"],"opposite":["逍遥法外"],"usage":"作分句；比喻作恶的人会受惩罚","story":["春秋时期，大哲学家老子认为人世上的一切都是命中注定，命运已经安排好了的东西，人们想改变它是不可能的，只能顺从自然的摆布，不要去争取，这样反而得不到什么好处，说不定还会有害处，这就叫天网恢恢、疏而不漏"]},{"id":13869,"word":"天罗地网","pinyin":"tiān luó dì wǎng","abbr":"tldw","explanation":"天罗：张在空中捕鸟的网。天空地面，遍张罗网。指上下四方设置的包围圈。比喻对敌人、逃犯等的严密包围。","source":{"text":"天兵下了天罗地网者，休要走了两洞妖魔。","book":"《大宋宣和遣事》亨集：“才离阴府恓惶难，又值天罗地风灾。”元·无名氏《锁魔镜》第三折"},"example":{"text":"形成一个使法西斯孙悟空无处逃跑的～，那就是敌人死亡之时了。","book":"毛泽东《论持久战》"},"similar":["天网恢恢，疏而不漏"],"opposite":["逃之夭夭"],"usage":"作主语、宾语；形容法网严密","story":["春秋时期，很会拍马的费无极怂恿楚平王占有太子毕建的新娘，担心太子毕建及他的老师伍奢会造反，设计害死伍奢，并派儿子费得雄去樊城诱骗伍员回京受诛。伍子胥得到太子毕建的消息，就逃出这个天罗地网，到吴国辅佐吴王攻楚"]},{"id":13870,"word":"天翻地覆","pinyin":"tiān fān dì fù","abbr":"tfdf","explanation":"覆：翻过来。形容变化巨大。也形容闹得很凶。","source":{"text":"天翻地覆谁得知？如今正南看北斗。","book":"唐·刘商《胡笳十八拍》六"},"example":{"text":"改革开放以来，我国农村发生了～的变化。"},"similar":["翻天覆地","天崩地裂"],"opposite":["一成不变"],"usage":"作谓语、定语、状语、补语；形容变化大","story":["贾府的赵姨娘和马道婆合谋陷害凤姐与宝玉，马道婆用纸剪了两个纸人，上写凤姐和宝玉的生日，然后作法。宝玉和凤姐顿时生病快没了气息，有人给他们准备了棺材，贾母气得要打做棺材的人，又哭又闹，把贾府闹得天翻地覆"]},{"id":13871,"word":"天老地荒","pinyin":"tiān lǎo dì huāng","abbr":"tldh","explanation":"指经历的时间极久。同“天荒地老”。","source":{"text":"天老地荒，此情无尽穷。","book":"清·孔尚任《桃花扇·栖真》"},"similar":["天荒地老"],"usage":"作宾语、定语、状语；指经历的时间极久远"},{"id":13872,"word":"天良发现","pinyin":"tiān liáng fā xiàn","abbr":"tlfx","explanation":"天良：良心。指触发了善良之心而对自己的言行有所悔悟。","source":{"text":"言人之良心，虽已放矢，然其日夜之间，亦必有所生长，故平旦未与接物，其气清明之际，良心必有所发见也。","book":"宋·朱熹《孟子集注·告子上》"},"opposite":["丧尽天良"],"usage":"作宾语、定语；用于处事"},{"id":13873,"word":"天花乱坠","pinyin":"tiān huā luàn zhuì","abbr":"thlz","explanation":"传说梁武帝时有个和尚讲经，感动了上天，天上纷纷落下花来。形容说话有声有色，极其动听（多指夸张而不符合实际）。","source":{"text":"六欲诸天来供养，天华（花）乱坠遍虚空。","book":"《心地观经·序品》"},"example":{"text":"傅二棒锤索性张大其词，说得～。","book":"清·李宝嘉《官场现形记》第五十六回"},"similar":["不着边际","花言巧语"],"opposite":["平铺直叙","兴味索然","缄口不语"],"usage":"作状语、定语；指不着边际","story":["南朝梁国的开国皇帝梁武帝萧衍特别笃信佛教，他请云光法师宣讲佛法，在讲《涅槃经》时，梁武帝从早到晚认真听讲，没有丝毫倦意。云光法师说得绘声绘色，竟感动了上天，香花从空中纷纷落下。梁武帝从此更加信佛，后来干脆出家"]},{"id":13874,"word":"天若有情天亦老","pinyin":"tiān ruò yǒu qíng tiān yì lǎo","abbr":"tryqtyl","explanation":"天倘若有情意，也会因悲伤而衰老的。常用以形容强烈的伤感情绪。也指自然法则是坞的。","source":{"text":"衰兰送客咸阳道，天若有情天亦老。","book":"唐·李贺《金铜仙人辞汉歌》"},"example":{"text":"毛泽东《七律·人民解放军占领南京》：“～，人间正道是沧桑。”"},"usage":"作宾语、定语；用于感伤时"},{"id":13875,"word":"天荆地棘","pinyin":"tiān jīng dì jí","abbr":"tjdj","explanation":"天地间布满荆棘，比喻世途或处境艰难。","source":{"text":"云漫漫兮白日寒，天荆地棘行路难。","book":"明·刘永锡《行路难》诗"},"example":{"text":"清·李宝嘉《文明小史》第12回：“我们的银钱有限，他们的欲壑难填，必至～，一步难行。”"},"usage":"作宾语、定语；用于比喻句"},{"id":13876,"word":"天荒地老","pinyin":"tiān huāng dì lǎo","abbr":"thdl","explanation":"天荒秽，地衰老。指经历的时间极久。","source":{"text":"吾闻马周昔作新丰客，天荒地老无人识。","book":"唐·李贺《致酒行》"},"example":{"text":"盖谓世间惟有愿得成双的，随你～，此情到底不泯也。","book":"明·凌濛初《二刻拍案惊奇》卷六"},"similar":["地老天荒","天老地荒"],"usage":"作宾语、定语、状语；指经历的时间极久远","story":["唐宪宗时期，诗人李贺到长安应试，因避父亲名讳被取笑参考资格，他在酒店里十分痛苦，借酒消愁。主人给他讲西汉主父偃和唐朝马周的故事，他即兴作《致酒行》：“主父西游困不归，家人折断门前柳。吾闻马周昔作新丰客，天荒地老无人识。”"]},{"id":13877,"word":"天行时气","pinyin":"tiān xíng shí qì","abbr":"txsq","explanation":"行：流行；时：季节，气候；气：疫气，疾病。因气候不正常而引起的流行病。","source":{"text":"凡冬月，忽有大热之时；夏月，忽有大凉之时，皆勿受之，有患天行时气者，皆由犯此也。","book":"《千金方》"},"example":{"text":"又过半年，忽然刘二感～，头疼发热。","book":"明·洪楩《清平山堂话本·合同文字记》"},"usage":"作宾语；用于书面语"},{"id":13878,"word":"天衣无缝","pinyin":"tiān yī wú fèng","abbr":"tywf","explanation":"神话传说，仙女的衣服没有衣缝。比喻事物周密完善，找不出什么毛病。","source":{"text":"徐视其衣并无缝，翰问之，曰：‘天衣本非针线为也。’","book":"前蜀·牛峤《灵怪录·郭翰》"},"example":{"text":"这篇文章立意明确，论述周到、深刻，真可谓～。"},"similar":["完美无缺","浑然一体"],"opposite":["千疮百孔","漏洞百出"],"usage":"作谓语、状语、定语；指周密完善","story":["传说古代太原人郭翰在夏夜里乘凉，见一个仙女从天上下来，她身穿白衣，美丽绝伦。她告诉他她名叫织女。郭翰仔细欣赏织女的衣裳浑然一体，竟看不出一丝线缝，好奇问织女。织女答道：“天衣本非针线为也。”"]},{"id":13879,"word":"天要下雨，娘要嫁人","pinyin":"tiān yào xià yǔ，niáng yào jià rén","abbr":"tyxynyjr","explanation":"比喻事物发展有其客观规律，不以人的意志为转移。","example":{"text":"一点不错，当真是～！","book":"梁羽生《龙凤宝钗缘》第三十一回"}},{"id":13880,"word":"天覆地载","pinyin":"tiān fù dì zǎi","abbr":"tfdz","explanation":"覆：盖；载：承受。象天覆盖万物，地承受一切一样。比喻范围极广大。也比喻恩泽深厚。","source":{"text":"是故圣人若天然，无私覆也；若地然，无私载也。","book":"《礼记·中庸》：“天之所覆，地之所载。”《管子·心术下》"},"example":{"text":"将军必须立下几个大功，方能报陛下～之恩，也不负本督师一片厚望。","book":"姚雪垠《李自成》第二卷第二十一章"},"usage":"作谓语、定语；比喻范围极广大"},{"id":13881,"word":"天视民视，天听民听","pinyin":"tiān shì mín shì，tiān tīng mín tīng","abbr":"tsmsttmt","explanation":"天视、天听：古人认为天有意志和知觉，可以视听。天的视听通过人民的视听来体现。指按人民的意愿和喜好办事。","source":{"text":"天视自我民视，天听自我民听。","book":"《尚书·泰誓中》"},"example":{"text":"文艺虽是小道，一旦出版发行，就也是接受～的对象，应该严肃地从事这一工作，绝不能掉以轻心。","book":"孙犁《孙犁散文·自序》"}},{"id":13882,"word":"天视自我民视，天听自我民听","pinyin":"tiān shì zì wǒ mín shì，tiān tīng zì wǒ mín tīng","abbr":"tszwmsttzwmt","explanation":"天视、天听：古人认为天有意志和知觉，可以视听。天的视听通过人民的视听来体现。指按人民的意愿和喜好办事。","source":{"text":"天视自我民视，天听自我民听。","book":"《尚书·泰誓中》"},"example":{"text":"分明是天理人情的一段公案，～。据此看去，明日的事，只怕竟有个八分成局哩。","book":"清·文康《儿女英雄传》第十六回"}},{"id":13883,"word":"天诛地灭","pinyin":"tiān zhū dì miè","abbr":"tzdm","explanation":"诛：杀死。比喻罪恶深重，为天地所不容。","source":{"text":"我等六人中但有私意者，天地诛灭，神明鉴查。","book":"明·施耐庵《水浒全传》第十五回"},"example":{"text":"“人不为己，～”，是剥削阶级的人生观。"},"similar":["天理难容"],"opposite":["天经地义"],"usage":"联合式；作谓语、定语；含贬义"},{"id":13884,"word":"天诱其衷","pinyin":"tiān yuò qí zhōng","abbr":"tyqz","explanation":"衷：内心。上天开导其心意，使之悔悟。","source":{"text":"天祸卫国，君臣不协，以及此忧也。今天诱其衷，使降心以相从也。","book":"《左传·僖公二十八年》"},"example":{"text":"宋·沈作喆《寓简》第七卷：“古人谓事顺成而计工，曰～。”"},"usage":"作宾语、定语；用于书面语"},{"id":13885,"word":"天资卓越","pinyin":"tiān zī zhuō yuè","abbr":"tzzy","explanation":"非常优秀的天资。","example":{"text":"她是一个～的人。"},"similar":["天资雄厚"],"usage":"作谓语、定语；指天生的能力"},{"id":13886,"word":"天资雄厚","pinyin":"tiān zī xióng hòu","abbr":"tzxh","explanation":"具有想象或发明的天生的能力。","example":{"text":"她～，十分聪明。"},"similar":["天资卓越"],"usage":"作谓语、定语；指天生的能力"},{"id":13887,"word":"天赐之福","pinyin":"tiān cì zhī fú","abbr":"tczf","explanation":"天赐的恩惠或怜悯的仁慈。","example":{"text":"我希望有～。"},"opposite":["飞来横祸"],"usage":"作宾语；指天赐的恩惠"},{"id":13888,"word":"天赐良机","pinyin":"tiān cì liáng jī","abbr":"tclj","explanation":"天给的好机会。","example":{"text":"真是～，我得到了梦寐以求的工作。"},"usage":"作主语、宾语、定语；多用于感慨"},{"id":13889,"word":"天转地转","pinyin":"tiān zhuàn dì zhuàn","abbr":"tzdz","explanation":"天地转动。比喻重大的变化。也形容眩晕时的感觉或闹得极凶。","source":{"text":"天旋地转回龙驭，到此踌躇不能去。","book":"唐·白居易《长恨歌》"},"example":{"text":"他想起来活动活动，可是没想到，刚一抬头眼就发黑，～，直想吐。","book":"刘流《烈火金刚》第四回"}},{"id":13890,"word":"天违人愿","pinyin":"tiān wéi rén yuàn","abbr":"twry","explanation":"天：天意；违：违背。天意和人的愿望相违背。比喻事不遂心。","source":{"text":"但自此月一日以来，霖雨连并，可谓天违人愿。","book":"《魏书·南安王传》"},"example":{"text":"孰知～，致有殷洪、马元抗违，今已授首。","book":"明·许仲琳《封神演义》第六十一回"}},{"id":13891,"word":"天造地设","pinyin":"tiān zào dì shè","abbr":"tzds","explanation":"造：制作；设：安排。指事物自然形成，合乎理想，不必再加人工。","source":{"text":"真天造地设，神谋化力，非人力所能为者。","book":"宋·赵佶（徽宗）《艮岳记》"},"example":{"text":"～，待人而发。","book":"宋·楼钥《扬州平山堂记》"},"similar":["鬼斧神工","天授地设","天生地设"],"opposite":["牵强附会","矫柔造作"],"usage":"作谓语、定语；指事物自然形成"},{"id":13892,"word":"天造草昧","pinyin":"tiān zào cǎo mèi","abbr":"tzcm","explanation":"①指天地之始，万物草创于混沌蒙昧之中。②指草创之时。","source":{"text":"天造草昧，立性命兮。","book":"《易·屯》：“天造草昧。”孔颖达疏：“言天造万物于草创之始，如在冥昧之时也。”汉·班固《幽通赋》"},"example":{"text":"～，壮士乌集，纪律未申，符籍未著。","book":"章炳麟《革命道德说》"},"usage":"作宾语、定语；用于书面语"},{"id":13893,"word":"天遂人愿","pinyin":"tiān suì rén yuàn","abbr":"tsry","explanation":"遂：随，就。上天满足人的愿望。","source":{"text":"喜得今日正遇不将黄道吉期，正是天遂人愿，夙世奇缘也。","book":"清·吴璿《飞龙全传》第五回"},"example":{"text":"真是～，我很满足了。"},"similar":["天从人愿","天随人愿"],"usage":"作宾语、分句、定语；指特别顺心"},{"id":13894,"word":"天道人事","pinyin":"tiān dào rén shì","abbr":"tdrs","explanation":"天道：天理。人事：人力所能做到的事。天道人事不可违背。意谓大势所趋。","source":{"text":"因为书与宋四川统制余玠，谕以天道人事，玠得书愧感自守，不敢复轻动。","book":"《元史·谦希宪传》"},"example":{"text":"嗟呼！不知此正所谓～也。","book":"清·郑板桥《雍正十年杭州韬光庵中寄舍弟墨》"},"usage":"作宾语、定语；用于慨叹等"},{"id":13895,"word":"天道好还","pinyin":"tiān dào hǎo huán","abbr":"tdhh","explanation":"天道：天理；好：常常会；还：回报别人。旧指天可主持公道，善恶终有报应。","source":{"text":"以道佐人主者，不以兵强天下，其事好还。师之所处，荆棘生焉。","book":"《老子》第三十章"},"example":{"text":"～如寄，人心公论难违。","book":"明·王士桢《鸣凤记·献首祭告》"},"similar":["恶有恶报"],"usage":"作谓语、分句；用于劝诫人"},{"id":13896,"word":"天道宁论","pinyin":"tiān dào níng lùn","abbr":"tdnl","explanation":"指天道福善惩恶之说难以凭信。","source":{"text":"试望平原，蔓草萦骨，拱木敛魂，人生到此，天道宁论。","book":"南朝·梁·江淹《恨赋》"},"example":{"text":"予否运所丁，遭家不造，奸邪构乱，朋党横行，大臣冤枉以被诛，少主仓卒而及祸，人自作孽，～。","book":"《旧唐书·太祖纪》"},"usage":"作宾语、定语；用于书面语"},{"id":13897,"word":"天道恢恢","pinyin":"tiān dào huī huī","abbr":"tdhh","explanation":"恢恢：宽广的样子。天道公平，作恶就要受惩罚。","source":{"text":"天道恢恢，法律无情。一切掌善司恶刑使，毋得以私犯公，自投罗网。","book":"《西游补》第八回"},"similar":["天网恢恢"],"usage":"作宾语、定语；用于书面语"},{"id":13898,"word":"天道无亲","pinyin":"tiān dào wú qīn","abbr":"tdwq","explanation":"亲：亲近。公正，不偏不倚。","source":{"text":"天道无亲，常与善人。","book":"《老子》第七十九章"},"example":{"text":"唐·陈子昂《梓州射洪县武东山故居士陈君碑》：“骄奢自咎，～，思我松柏，恭俭是遵。”"},"similar":["天道无私"],"usage":"作宾语、定语；用于慨叹等"},{"id":13899,"word":"天道无私","pinyin":"tiān dào wú sī","abbr":"tdws","explanation":"指上天很公正，不偏不倚。","source":{"text":"天道无亲，常与善人。","book":"《老子》第七十九章"},"example":{"text":"从知～枉，恶报到头不再延。","book":"蔡东藩《两晋演义》第十八回"},"similar":["天道无亲"],"usage":"作宾语、定语；用于慨叹等"},{"id":13900,"word":"天道昭彰","pinyin":"tiān dào zhāo zhāng","abbr":"tdzz","explanation":"天道：天理；昭彰：明显。指老天能主持公道，善恶报应分明。","source":{"text":"如此剧贼，却被小孩子算破了，岂非天道昭彰。","book":"明·凌濛初《二刻拍案惊奇》第五卷"},"example":{"text":"乃恶积贯盈，自行败露，此实～，可为天下盗窃虚名妄肆异议者戒。","book":"《清朝野史大观》第三卷"},"similar":["天理昭彰"],"usage":"作谓语、定语；用于劝诫人"},{"id":13901,"word":"天道酬勤","pinyin":"tiān dào chóu qín","abbr":"tdcq","explanation":"天道：天理；酬：报；勤：勤奋。上天会酬报勤奋的人。指下了苦功夫必然会有成就。","example":{"text":"常常是峰回路转，也往往柳暗花明，既殚精竭虑，也担惊受怕，不过总算～，也真是吉人天相……（刘心武《人面鱼》）"}},{"id":13902,"word":"天遥地远","pinyin":"tiān yáo dì yuǎn","abbr":"tydy","explanation":"比喻相差极大。","source":{"text":"凭寄离恨重重，这双燕，何曾会人言语。天遥地远，万水千山，知他故宫何处。","book":"宋赵佶《燕山亭》词"},"example":{"text":"十年不见柳腰肢，契阔几何时。～，秋悲春恨，只在双眉。","book":"宋·刘学箕《眼儿媚》词"},"similar":["天高地远","天高地迥"],"usage":"作宾语、定语；形容极其高远"},{"id":13903,"word":"天长地久","pinyin":"tiān cháng dì jiǔ","abbr":"tcdj","explanation":"跟天和地存在的时间那样长。形容时间悠久。也形容永远不变（多指爱情）。","source":{"text":"天长地久，天地所以能长且久者，以其不自生，故能长生。","book":"《老子》第七章"},"example":{"text":"～有时尽，此恨绵绵无绝期。","book":"唐·白居易《长恨歌》"},"similar":["日久天长","天长日久"],"opposite":["稍纵即逝"],"usage":"作谓语、状语；形容时间长久"},{"id":13904,"word":"天长地老","pinyin":"tiān cháng dì lǎo","abbr":"tcdl","explanation":"犹天长地久。","source":{"text":"两情浓同下蓝桥，战兢兢欢娱较少，成就了凤友鸾交，休忘却天长地老！","book":"明·高濂《玉簪记·词媾》"},"example":{"text":"呀呀呀辅助的，锦江山一统丰饶，～。","book":"明·无名氏《庆千秋》第二折"},"similar":["天长地久"],"usage":"作谓语、定语；指时间长久"},{"id":13905,"word":"天长地远","pinyin":"tiān cháng dì yuǎn","abbr":"tzdy","explanation":"跟天和地存在的时间那样长。形容时间悠久。","source":{"text":"天长地远魂飞苦，梦魂不到关山难。","book":"唐·李白《长相思》"},"example":{"text":"阳阴否隔却成愆，怎得～。","book":"宋·张伯端《西江月》词"},"similar":["天长地久","地久天长"],"usage":"作谓语、状语；形容时间长久"},{"id":13906,"word":"天长日久","pinyin":"tiān cháng rì jiǔ","abbr":"tcrj","explanation":"时间长，日子久。","source":{"text":"但只是天长日久，尽着这么闹，可叫人怎么过呢。","book":"清·曹雪芹《红楼梦》第二十回"},"example":{"text":"待要隐忍下去只答应着，～，这等几间小屋子，弄一对大石头狮子不时的对吼起来，更不成事。","book":"清·文康《儿女英雄传》第三十回"},"similar":["天长地久"],"opposite":["稍纵即逝"],"usage":"作谓语；形容时间长久"},{"id":13907,"word":"天随人原","pinyin":"tiān suí rén yuán","abbr":"tsry","explanation":"上天顺从人的意愿。形容事态恰如所望。"},{"id":13908,"word":"天随人愿","pinyin":"tiān suí rén yuàn","abbr":"tsry","explanation":"上天顺从人的意愿。指事物的发展正合自己的心愿。","source":{"text":"谁知天从人愿，到得我家，不上三日，添了一个满抱儿小厮。","book":"元·张国宾《合汗衫》第二折"},"example":{"text":"今也，～，获侍巾栉。但愿君子始终如一，则万幸矣！","book":"明·洪楩《清平山堂话本·风月相思》"},"similar":["天从人愿","天遂人愿"],"opposite":["天不作美"],"usage":"作宾语、定语；同“天从人愿”"},{"id":13909,"word":"天震地骇","pinyin":"tiān zhèn dì hài","abbr":"tzdh","explanation":"震：震动。震动了天地。形容声音或声势极大。有时形容事件、场面令人惊骇。","source":{"text":"震：震动。震动了天地。形容声音或声势极大。有时形容事件、场面令人惊骇。"},"similar":["震天动地","震天骇地","震天撼地"],"usage":"作谓语、定语、状语；形容声势极大"},{"id":13910,"word":"天香国色","pinyin":"tiān xiāng guó sè","abbr":"txgs","explanation":"原形容颜色和香气不同于一般花卉的牡丹花，后也形容女子的美丽。","source":{"text":"国色朝酣酒，天香夜染衣。","book":"唐·李浚《摭异记》"},"example":{"text":"他有个亲生的女儿，叫做娟奴，见在南瓦子住，果是～。","book":"明·郑若庸《玉玦记·访友》"},"similar":["国色天香"],"usage":"作宾语、定语；也形容女子的美丽"},{"id":13911,"word":"天马行空","pinyin":"tiān mǎ xíng kōng","abbr":"tmxk","explanation":"天马：神马。天马奔腾神速，象是腾起在空中飞行一样。比喻诗文气势豪放。也比喻人浮躁，不踏实。","source":{"text":"其所以神化而超出于众表者，殆犹天马行空而步骤不凡。","book":"元·刘廷振《萨天锡诗集序》"},"example":{"text":"余于近日交游之诗，其心契者，曾弗人如～，不可羁勒。","book":"清·黄宗羲《谢莘野诗序》"},"similar":["挥洒自如","龙飞凤舞"],"opposite":["束手束脚"],"usage":"作谓语、定语；比喻才思敏捷","story":["西汉时期，西域大宛国出产一种名马可以日行千里，被称为“西极天马”或“天马行空”。汉武帝派使臣带上金银珠宝去换这种千里马，大宛国国王毋寡杀了使臣侵吞财物。汉武帝大怒，派李广利率军讨伐大宛国，取得西极天马3000匹"]},{"id":13912,"word":"天高听下","pinyin":"tiān gāo tīng xià","abbr":"tgtx","explanation":"指天子圣明，虽居朝廷之上而能洞察下情。","source":{"text":"皇鉴烛幽，天高听下，赏片言之或善，矜一物之失时。","book":"《南齐书·王融传》"},"similar":["天高听卑"],"usage":"作定语；用于书面语"},{"id":13913,"word":"天高听卑","pinyin":"tiān gāo tīng bēi","abbr":"tgtb","explanation":"卑：低下。原指上天神明可以洞察人间最卑微的地方。旧时称好的帝王了解民情。","source":{"text":"天高听卑，看肯照微。","book":"《史记·宋微子世家》：“天高听卑。君有君人之言三，荧惑宜有动。”三国·魏·曹植《责躬》诗"},"example":{"text":"皇鉴烛幽，天高地卑，赏片言之或善，矜一物之失时。","book":"《南齐书·王融传》"},"similar":["天高听下"],"usage":"作宾语；称好的帝王了解民情"},{"id":13914,"word":"天高听远","pinyin":"tiān gāo tīng yuǎn","abbr":"tgty","explanation":"指处于远离君王或中央政权的地方，下情无径上达，上面也无从听得下面的呼声。","source":{"text":"效命先驱，毕命轮毂，虽无大益，冀有小补。然天高听远，情不上通，徒独望青云而拊心，仰天高而叹息耳。","book":"《三国志·魏志·陈思王植传》"}},{"id":13915,"word":"天高地下","pinyin":"tiān gāo dì xià","abbr":"tgdx","explanation":"①比喻尊卑有别。②比喻各种情势。","source":{"text":"那西门庆吃了一夜酒的人，倒去头，那顾天高地下，鼾睡如雷。","book":"《礼记·乐记》：“天高地下，万物散殊，而礼制行矣。”孔颖达疏：“以天高地下不同，故人伦尊卑有异。”《金瓶梅词话》第四十回"},"example":{"text":"杨化在草坡上一交，放翻身子，不知一个～， 鼾声如雷。","book":"明·凌濛初《初刻拍案惊奇》卷十四"},"usage":"作宾语、定语；多用于比喻句"},{"id":13916,"word":"天高地厚","pinyin":"tiān gāo dì hòu","abbr":"tgdh","explanation":"原形容天地的广大，后形容恩德极深厚。也比喻事情的艰巨、严重，关系的重大。","source":{"text":"故不登高山，不知天之高也；不临深谿，不知地之厚也。","book":"《诗经·小雅·正月》：“谓天盖高，不敢不局；谓地盖厚，不敢不脊。”《荀子·劝学》"},"example":{"text":"门生受恩师三番知遇，今日小小效劳，止可少答科举而已，～，未酬万一。","book":"明·冯梦龙《警世通言》卷十八"},"similar":["高天厚地"],"usage":"作宾语；比喻事情的艰巨、严重","story":["远古时期，传说天地开辟以前宇宙是混混沌沌的一团气，像鸡蛋一样，盘古把这团气劈开，轻清之气上升成天，重浊之气下沉成地，逐渐形成山川河流等。经过18000年天地仍在增高加厚，但天有多高、地有多厚谁也说不清楚，只能说天高地厚来形容"]},{"id":13917,"word":"天高地远","pinyin":"tiān gāo dì yuǎn","abbr":"tgdy","explanation":"形容相隔极远。同“天高地迥”。","source":{"text":"致知格物。初学工夫参圣域。天高地远无穷极。","book":"宋·沈瀛《醉落魄》词"},"example":{"text":"遮莫你上碧霄下黄泉，赤紧地～。","book":"元·谷子敬《城南柳》第三折"},"similar":["天遥地远","天高地迥"],"usage":"作宾语、定语、状语；形容极其高远"},{"id":13918,"word":"天高地迥","pinyin":"tiān gāo dì jiǒng","abbr":"tgdj","explanation":"迥：远。形容极其高远。","source":{"text":"天高地迥，觉宇宙之无穷。","book":"唐·王勃《秋日登洪府滕王阁饯别序》"},"example":{"text":"穷饿无聊，追购又急，～，号呼靡及。","book":"宋·文天祥《指南录后序》"},"similar":["天遥地远","天高地远"],"usage":"作宾语、定语；形容极其高远"},{"id":13919,"word":"天高日远","pinyin":"tiān gāo rì yuǎn","abbr":"tgry","explanation":"比喻离君王很远。也指偏远的地方。","source":{"text":"臣父独婴罪衅，流寓江海，天高日远，自新无路，臣诚私心痛之。","book":"宋·秦观《代王承事乞回授一官表》"},"example":{"text":"明·邵璨《香囊记·辞婚》：“孤哀自持臣子分，不得当朝亲事君，还思忖，总然是～，怎负君恩！”"},"similar":["天高皇帝远"],"usage":"作宾语、定语；用于书面语"},{"id":13920,"word":"天高气清","pinyin":"tiān gāo qì qīng","abbr":"tgqq","explanation":"形容天空高远，气候清爽。","source":{"text":"泬寥兮天高而气清。","book":"战国·楚·宋玉《九辩》"},"example":{"text":"白芷应节，～。岁功既皋，庶类收成。","book":"《乐府诗集·唐五郊乐章·白帝商音》"},"similar":["天高气爽","秋高气爽"],"usage":"作定语、分句；形容秋天"},{"id":13921,"word":"天高气爽","pinyin":"tiān gāo qì shuǎng","abbr":"tgqs","explanation":"形容秋天天空高远明朗、气候凉爽宜人。","source":{"text":"今日天高气爽，众头目每向沙堤射猎一番。","book":"元·马致远《汉宫秋》楔子"},"example":{"text":"～，正好去秋游。"},"similar":["秋高气爽","天高气清"],"usage":"作定语、分句；形容秋天"},{"id":13922,"word":"天高气轻","pinyin":"tiān gāo qì qīng","abbr":"tgqq","explanation":"形容天空高远，气候清爽。","source":{"text":"泬寥兮天高而气清。","book":"战国·楚·宋玉《九辩》"},"example":{"text":"白芷应节，～。岁功既皋，庶类收成。","book":"《乐府诗集·唐五郊乐章·白帝商音》"}},{"id":13923,"word":"天高皇帝远","pinyin":"tiān gāo huáng dì yuǎn","abbr":"tghdy","explanation":"原指偏僻的地方，中央的权力达不到。现泛指机构离开领导机关远，遇事自作主张，不受约束。","source":{"text":"天高皇帝远，民少相公多。一日三遍打，不反待如何。","book":"明·黄溥《闲中今古录》"},"example":{"text":"要论这个省分，又是～的地方，怕什么呢。","book":"清·吴趼人《糊涂世界》卷二"},"similar":["无法无天"],"usage":"作宾语、分句；指偏僻的地方","story":["北宋末年，浙江台州、温州一带大旱，百姓饿死很多，朝廷因为官多加上奢侈浪费成风，对救灾一事置之不理，反而加重赋税，人们忍无可忍，于是树起了造反的大旗，旗上写道：“天高皇帝远，民少相公多。一日三遍打，不反待如何？”"]},{"id":13924,"word":"天魔外道","pinyin":"tiān mó wài dào","abbr":"tmwd","explanation":"外道：佛家语，指不合佛法的教度。指正统以外的的异端流派。","source":{"text":"天魔外道，相视如父母。","book":"《梵网经》卷十"},"example":{"text":"畜生恶鬼，水陆行空，～，幽冥鬼神，一切杂形，皆悉不受。","book":"唐·释元觉《永嘉集·发愿文》"}},{"id":13925,"word":"太上忘情","pinyin":"tài shàng wàng qíng","abbr":"tswq","explanation":"太上：指圣人。圣人不为情感所动。","source":{"text":"圣人忘情，最下不及情，情之所钟，正在我辈。","book":"南朝宋·刘义庆《世说新语·伤逝》"},"example":{"text":"司马春衫，吾不能学太上之忘情也。","book":"清·林觉民《与妻书》"},"usage":"作宾语、定语；指圣人不为情感所动"},{"id":13926,"word":"太上无情","pinyin":"tài shàng wú qíng","abbr":"tswq","explanation":"太上：指圣人。圣人不为情感所动。","source":{"text":"圣人忘情，最下不及情，情之所钟，正在我辈。","book":"南朝·宋·刘义庆《世说新语·伤逝》"}},{"id":13927,"word":"太上皇","pinyin":"tài shàng huáng","abbr":"tsh","explanation":"皇帝之父。比喻实际上掌握权力、自己不出面而操纵别人进行活动的人。","source":{"text":"自今章奏，俱改称太上皇。军国重事，先请皇帝旨，仍奏闻朕。","book":"清·褚人获《隋唐演义》第92回"},"example":{"text":"路遥《平凡的世界》第二卷第32章：“那位穿黑棉袄的‘～’如入无人之境般挖了一大碗肉片子，又抓了三个白蒸馍。”"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":13928,"word":"太丘道广","pinyin":"tài qiū dào guǎng","abbr":"tqdg","explanation":"太丘：东汉陈寔，曾为太丘长，世称陈太丘。指交游甚广。","source":{"text":"太丘道广，广则难周。","book":"《后汉书·许劭传》"},"example":{"text":"君谓：“亚子～，将谓举世尽贤者。”","book":"柳亚子《燕子龛遗诗序》"},"usage":"作谓语；指交游甚广"},{"id":13929,"word":"太仓一粟","pinyin":"tài cāng yī sù","abbr":"tcys","explanation":"太仓：古代设在京城中的大谷仓。大粮仓里的一粒谷子。比喻极大的数量中一个非常小的数目。","source":{"text":"计中国之在海内，不似稊米之在太仓乎？","book":"《庄子·秋水》"},"example":{"text":"好在古雨山当日有财神之目，去了他七千两，也不过是九牛一毛，～。","book":"清·吴趼人《二十年目睹之怪现状》第六十三回"},"similar":["沧海一粟","九牛一毛"],"usage":"作宾语、分句；比喻极大的数量中一个"},{"id":13930,"word":"太仓稊米","pinyin":"tài cāng tí mǐ","abbr":"tctm","explanation":"太仓：古代设在京城中的大谷仓。比喻非常渺小。","source":{"text":"计中国之在海内，不似稊米之在太仓乎？","book":"《庄子·秋水》"},"example":{"text":"人生百岁内，天地暂寓形。太仓一稊米，大海一浮萍。","book":"唐·白居易《和思归乐》诗"},"similar":["沧海一粟","九牛一毛"],"usage":"作宾语、分句；比喻非常渺小"},{"id":13931,"word":"太公钓鱼，愿者上钩","pinyin":"tài gōng diào yú，yuàn zhě shàng gōu","abbr":"tgdyyzsg","explanation":"太公：指周初的吕尚，即姜子牙。比喻心甘情愿地上当。","source":{"text":"姜尚因命守时，直钩钓：‘负命者上钩来！’","book":"《武王伐纣平话》卷下"},"example":{"text":"这有何妨，～。","book":"清·孔尚任《桃花扇》第二十四出"},"similar":["姜太公钓鱼，愿者上钩"],"usage":"作宾语、分句；比喻心甘情愿地上圈套","story":["商朝末年，姜子牙隐居在渭水边，他在渭水边用笔直的鱼钩，不挂鱼饵，鱼钩离水面还有三尺高开始钓鱼。有人笑他100年也钓不到一条鱼，他则念念有词地说：“不想活的鱼儿自己上钩吧。”结果周文王听说后亲自请他辅助朝政，消灭商朝"]},{"id":13932,"word":"太山北斗","pinyin":"tài shān běi dòu","abbr":"tsbd","explanation":"太山为五岳之首，北斗为众星所拱，故常用以比喻众所崇仰的人。","source":{"text":"欧公在天下如太山北斗，伯修自揣何如，仅更作其序，何不识轻重也。","book":"宋·施德操《北窗炙輠》上卷"},"similar":["泰山北斗"],"usage":"作主语、宾语；指为众人所敬仰的人"},{"id":13933,"word":"太岁头上动土","pinyin":"tài suì tóu shàng dòng tǔ","abbr":"tstsdt","explanation":"旧时迷信，认为太岁每年所在方位为凶方，这一年如在这一方位动土建筑，便要发生祸事。比喻触犯强暴有力的人。","source":{"text":"移徒法日：‘徒抵太岁凶，伏太岁亦凶’。","book":"汉·王充《论衡·难岁篇》"},"example":{"text":"驸马现掌兵权，杀人如同儿戏，庶民无不危惧，谁敢在～。","book":"清·李汝珍《镜花缘》第二十四回"},"usage":"作宾语、分句；用于疑问句"},{"id":13934,"word":"太平无事","pinyin":"tài píng wú shì","abbr":"tpws","explanation":"指时世安宁和平，也指生活清静无忧。","source":{"text":"惟高堂厚禄身享太平无事之日者，见月则乐也。","book":"明·焦竑《玉堂丛语·方正》"},"example":{"text":"钱钟书《围城》：“直到大考，～。”"},"similar":["平安无事"],"usage":"作谓语、定语、状语；指安全"},{"id":13935,"word":"太平无象","pinyin":"tài píng wú xiàng","abbr":"tpwx","explanation":"指太平盛世并无一定标志。后讽刺反动统治者粉饰升平。","source":{"text":"会上御延英，谓宰相曰：‘天下何时当太平，卿等亦有意于此乎？’僧孺对曰：‘太平无象。今四夷不至交侵，百姓不至流散，虽非至理，亦谓小康。陛下若别求太平，非臣等所及。’","book":"《资治通鉴·唐文宗太和六年》"},"usage":"作宾语、定语；多用于讽刺"},{"id":13936,"word":"太平盛世","pinyin":"tài píng shèng shì","abbr":"tpss","explanation":"安定、兴盛的时代。","source":{"text":"余谓太平盛世，元夕张灯，不为过侈。","book":"明·沈德符《万历野获编·章枫山封事》"},"example":{"text":"复古的，避难的，无智愚贤不肖，似乎都已神往于三百年前的～，就是“暂时做稳了奴隶的时代”了。","book":"鲁迅《坟·灯下漫笔》"},"similar":["国泰民安","安居乐业"],"opposite":["狼烟四起","家破人亡"],"usage":"作谓语、宾语；指社会安定"},{"id":13937,"word":"太璞不完","pinyin":"tài pú bù wán","abbr":"tpbw","explanation":"太璞：未治之玉。璞经过加工，就失去了天然的形态。旧时比喻读书人出来作官，就丧失了纯洁。","source":{"text":"夫玉生于山，制则破焉，非弗宝贵矣，然大璞不完。士生乎鄙野，推选则禄焉，非不得尊遂也，然而形神不全。","book":"《战国策·齐策四》"}},{"id":13938,"word":"太阿之柄","pinyin":"tài ē zhī bǐng","abbr":"tezb","explanation":"太阿：宝剑名。比喻权柄。","source":{"text":"昏君无北伐之心，奸相操太阿之柄。","book":"清·觉佛《女英雄》"},"usage":"作宾语；用于比喻句"},{"id":13939,"word":"太阿倒持","pinyin":"tài ē dào chí","abbr":"tedc","explanation":"倒拿着剑，把剑柄给别人。比喻把大权交给别人，自己反受其害。","source":{"text":"自德宗惩北军之变，以左右神策、天威等军分委宦官主之，由是太阿倒持，不复可取。","book":"宋·秦观《李训论》"},"example":{"text":"与臣下相共便是～，结果便会为臣下所劫弑。","book":"郭沫若《十批判书·韩非子的批判》"},"similar":["倒持太阿","授人一柄"],"usage":"作谓语、宾语、定语；指使自己被动"},{"id":13940,"word":"太阿在握","pinyin":"tài ē zài wò","abbr":"tezw","explanation":"太阿：宝剑名。比喻掌握权柄。","source":{"text":"世宗神圣，以至今上，俱太阿在握，可无过虑。","book":"明·沈德符《万历野获编·内臣兼掌印厂》"},"similar":["大权在握"],"usage":"作谓语、定语；用于书面语"},{"id":13941,"word":"夫人裙带","pinyin":"fū rén qún dài","abbr":"frqd","explanation":"指因妻子方面的关系使丈夫得到官职或其他好处。","source":{"text":"蔡拜右相，家宴张乐。伶人扬言曰：‘右丞今日大拜，都是夫人裙带。’","book":"宋·周煇《清波杂志》第三卷"},"example":{"text":"他是靠～关系而当上局长的。"},"similar":["裙带关系"],"usage":"作宾语、定语；指亲属关系"},{"id":13942,"word":"夫倡妇随","pinyin":"fū chàng fù suí","abbr":"fcfs","explanation":"原指封建社会认为妻子必须服从丈夫，后比喻夫妻和好相处。同“夫唱妇随”。","source":{"text":"天下之理，夫者倡，妇者随。","book":"《关尹子·三极》"},"example":{"text":"～的日子让人羡慕。"},"similar":["夫唱妇随"],"usage":"作谓语、定语、宾语；指夫妻和睦"},{"id":13943,"word":"夫唱妇随","pinyin":"fū chàng fù suí","abbr":"fcfs","explanation":"随：附和。原指封建社会认为妻子必须服从丈夫，后比喻夫妻和好相处。","source":{"text":"天下之理，夫者倡，妇者随。","book":"《关尹子·三极》"},"example":{"text":"春郎夫妻也各自默默地祷祝。自此上下和睦，～。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"similar":["男唱女随"],"opposite":["情同陌路"],"usage":"作谓语、状语、分句；指夫妻和睦"},{"id":13944,"word":"夫复何言","pinyin":"fú fù hé yán","abbr":"ffhy","explanation":"夫：语气助词；复：还，再。还能再说什么话呢！表示感慨很深。","source":{"text":"嗟乎子卿，夫复何言。","book":"汉·李陵《答苏武书》"},"example":{"text":"道德太高，任人玩弄，～。","book":"清·章炳麟《致伯中书十二》"},"usage":"作分句；用于感慨"},{"id":13945,"word":"夫妇反目","pinyin":"fū fù fǎn mù","abbr":"fffm","explanation":"反目：翻眼相看，不和睦。指夫妻吵架不和。","source":{"text":"自此谭、巫夫妇反目难以重好。","book":"清·李绿园《歧路灯》第82回"},"similar":["夫妻反目"],"opposite":["恩恩爱爱"],"usage":"作宾语、状语；指夫妻不和睦"},{"id":13946,"word":"夫妻反目","pinyin":"fū qī fǎn mù","abbr":"fqfm","explanation":"反目：翻眼相看，不和睦。指夫妻不和、吵架。","source":{"text":"舆说辐，夫妻反目。","book":"《周易·小畜》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第83回：“言中丞此时失了主意，从此～。”"},"similar":["夫妇反目"],"opposite":["夫唱妇随","相敬如宾"],"usage":"作宾语、状语；指夫妻不和睦"},{"id":13947,"word":"夫妻店","pinyin":"fū qī diàn","abbr":"fqd","explanation":"由夫妇两人经管的小店铺，借指夫妻两人控制某单位，变公为私。","source":{"text":"这是老规矩，也是这个夫妻店所能提供的最好的吃喝了。","book":"路遥《平凡的世界》第四卷第48章"},"example":{"text":"我们单位成为名副其实的～了。"},"usage":"作主语、宾语、定语；用于口语"},{"id":13948,"word":"夫妻无隔夜之仇","pinyin":"fū qī wú gé yè zhī chóu","abbr":"fqwgyzc","explanation":"夫妻之间没有隔夜解不开的仇怨。形容夫妻间的恩怨容易化解。","source":{"text":"常言道，夫妻无隔夜之仇，说不定明朝一早你就回去了。","book":"周立波《山乡巨变》"},"similar":["夫妻无隔宿之仇"],"usage":"作宾语、定语；用于口语"},{"id":13949,"word":"夫妻无隔宿之仇","pinyin":"fū qī wú gé sù zhī chóu","abbr":"fqwgszc","explanation":"宿：夜。夫妻之间没有隔夜解不开的仇怨。形容夫妻间的恩怨容易化解。","source":{"text":"‘夫妻无隔宿之仇’，我怪你怎的？","book":"清·吴敬梓《儒林外史》第29回"},"similar":["夫妻无隔夜之仇"],"usage":"作宾语、定语；用于口语"},{"id":13950,"word":"夫子之墙","pinyin":"fū zǐ zhī qiáng","abbr":"fzzq","explanation":"指学问道德高深莫测。后用以比喻高不可攀，令人向往。","source":{"text":"夫子之墙数仞，不得其门而入，不见宗庙之美，百官之富。","book":"《论语·子张》"}},{"id":13951,"word":"夫子自道","pinyin":"fū zǐ zì dào","abbr":"fzzd","explanation":"指本意是说别人好处，而事实上却正道着了自己。也用在不好的一面，意思是指摘别人，却正指摘了自己。","source":{"text":"子曰：‘君子有道者三，我无能焉；仁者不忧，智者不惑，勇者不惧。’子贡曰：‘夫子自道也。’","book":"《论语·宪问》"},"example":{"text":"就在那一年所做的《湘累》，实际上就是“～”。","book":"郭沫若《学生时代·创造十年》"},"usage":"作谓语、宾语；比喻弄巧成拙"},{"id":13952,"word":"夫尊妻贵","pinyin":"fū zūn qī guì","abbr":"fzqg","explanation":"尊：做高官。指丈夫做了高官，地位提升，妻子也随之尊贵。","source":{"text":"夫尊于朝，妻贵于室矣。","book":"《仪礼·丧服》"}},{"id":13953,"word":"夫己氏","pinyin":"fú jǐ shì","abbr":"fjs","explanation":"指那个人。","source":{"text":"终不曰公，曰夫己氏。","book":"春秋·鲁·左丘明《左传·文公十四年》"},"example":{"text":"廖先生遇害，～实为谋主，吾头可断，此语不可易也！","book":"柳亚子《赋诗遥奠邓择生先烈》"},"usage":"作主语、宾语；指那个人"},{"id":13954,"word":"夫荣妻显","pinyin":"fū róng qī xiǎn","abbr":"frqx","explanation":"荣：草木茂盛，比喻兴盛显达。指丈夫有了荣耀的地位，妻子也随之显贵。","source":{"text":"夫尊于朝，妻贵于室矣。","book":"《仪礼·丧服》"},"example":{"text":"恨当初鸾只凤单，喜今日～。","book":"明·胡文焕《群音类选·玉簪记·合家重会》"},"similar":["夫贵妻荣","夫荣妻贵"],"usage":"作谓语、宾语、定语；用于夫妻之间"},{"id":13955,"word":"夫荣妻贵","pinyin":"fū róng qī guì","abbr":"frqg","explanation":"荣：草木茂盛，比喻兴盛显达。指丈夫光荣，妻子也随之尊贵。","source":{"text":"夫尊于朝，妻贵于室矣。","book":"《仪礼·丧服》"},"example":{"text":"大家道：“吉祥艳丽，预卜状元郎～，该贺该贺。”","book":"清·曾朴《孽海花》第八回"},"similar":["夫贵妻荣"],"usage":"作谓语、宾语、定语、补语；用于夫妻之间"},{"id":13956,"word":"夫负妻戴","pinyin":"fū fù qī dài","abbr":"ffqd","explanation":"指夫妻远徙避世，不慕荣利。","source":{"text":"相传春秋时，楚狂接舆躬耕而食。楚王使人聘之，请为治淮南。接舆笑而不应。其妻以为君命不从非忠，从之又违义。于是夫负釜甑，妻戴纴器，变名易姓而远徙，莫知所之。见汉·刘向《列女传·楚接舆妻》。"},"example":{"text":"于是～，携子以入于海。","book":"《庄子·让王》"},"usage":"作宾语、定语；用于书面语","story":["春秋时期，楚狂接舆躬耕而食。楚王派人请他出任淮南长官，接舆笑而不应。他的妻子认为不遵从君命是不忠，遵从了又违义。于是楚狂接舆背负釜甑，他的妻子头顶织布的器具，变名易姓远走他乡，不知所终"]},{"id":13957,"word":"夫贵妻荣","pinyin":"fū guì qī róng","abbr":"fgqr","explanation":"荣：草木茂盛，比喻兴盛显达。指丈夫作了官，妻子也随之尊贵。","source":{"text":"夫尊于朝，妻贵于室矣。","book":"《仪礼·丧服》"},"example":{"text":"三女明婚鸾谐凤合，一人暗卜～。","book":"清·夏敬渠《野叟曝言》第六十回"},"similar":["夫荣妻贵","夫荣妻显"],"usage":"作谓语、宾语、定语；用于夫妻之间"},{"id":13958,"word":"夭桃秾李","pinyin":"yāo táo nóng lǐ","abbr":"ytnl","explanation":"比喻年少美貌。多用为对人婚娶的颂辞。","source":{"text":"何彼秾矣，华如桃李。","book":"《诗经·周南·桃夭》：“桃之夭夭，灼灼其华。”《诗经·召南·何彼秾矣》"},"example":{"text":"～，宜早合良缘，毋使婚嫁愆期，致令幼女怀春，吉士有摽梅之赋也。","book":"清·彭养鸥《黑籍冤魂》第八回"},"similar":["夭桃襛李"],"usage":"作主语、宾语；多用为对人婚娶的颂辞"},{"id":13959,"word":"夭桃穠李","pinyin":"yāo táo nóng lǐ","abbr":"ytnl","explanation":"比喻年少美貌。多用为对人婚娶的颂辞。同“夭桃秾李”。","source":{"text":"何彼穠矣，华如桃李。","book":"《诗经·周南·桃夭》：“桃之夭夭，灼灼其华。”《诗经·召南·何彼穠矣》"},"example":{"text":"星昴殷冬献吉日，～遥相匹。","book":"唐·张说《安乐郡主花烛行》"}},{"id":13960,"word":"夭桃襛李","pinyin":"yāo táo nóng lǐ","abbr":"ytnl","explanation":"夭：形容草木茂盛；秾：花木繁盛。艳丽盛开的桃李。比喻美貌的年轻人。","source":{"text":"何彼秾矣，华如桃李。","book":"《诗经·周南·桃夭》：“桃之夭夭，灼灼其华。”《诗经·召南·何彼秾矣》"},"example":{"text":"～，宜早合良缘。","book":"清·彭养鸥《黑籍冤魂》第八回"},"similar":["夭桃秾李"],"usage":"作宾语；多用来祝颂婚嫁"},{"id":13961,"word":"夭矫不群","pinyin":"yāo jiǎo bù qún","abbr":"yjbq","explanation":"夭矫：屈曲而有气势。容貌仪态，与众不同。形容人气宇轩昂，风度出众。","source":{"text":"抚凌波而凫跃。吸翠霞而夭矫。","book":"晋·郭璞《江赋》"},"example":{"text":"四面八方，陆续趋集，把一个～的老龙王，逼得死守孤城，好像个瓮中鳖罐里鳅。","book":"蔡东藩、许廑父《民国通俗演义》第六十八回"}},{"id":13962,"word":"夯雀先飞","pinyin":"bèn què xiān fēi","abbr":"hqxf","explanation":"夯：同“笨”，愚钝；雀：山雀，麻雀。比喻天资不好的人做事比别人先动手。","source":{"text":"咱们家没人，俗语说的，‘夯雀儿先飞’，省的临时丢三落四的不齐全，令人笑话。","book":"清·曹雪芹《红楼梦》第67回"},"similar":["笨鸟先飞"],"usage":"作宾语、定语；指人勤奋"},{"id":13963,"word":"失之东隅","pinyin":"shī zhī dōng yú","abbr":"szdy","explanation":"东隅：日出的地方。比喻这个时候遭到损失或失败。","source":{"text":"始虽垂翅回溪，终能奋翼黾池，可谓失之东隅，收之桑榆。","book":"南朝·宋·范晔《后汉书·冯异传》"},"example":{"text":"但是～，还可以收之桑榆，亡羊补牢，还未为晚。","book":"孙中山《党员不可存心做官发财》"},"similar":["有得有失","塞翁失马"],"opposite":["得不偿失"],"usage":"作宾语、定语、分句；常与“收之桑榆”连用","story":["东汉初年，光武帝刘秀派大将冯异与邓禹去围剿赤眉农民起义军，邓禹与义军交战后不幸损兵折将，冯异命令部队加强防御，收拢溃散的散兵，同时派军装成赤眉军打入其内部，结果大获全胜。朝廷下文书表彰他们的战斗是失之东隅，收之桑榆"]},{"id":13964,"word":"失之东隅，收之桑榆","pinyin":"shī zhī dōng yú，shōu zhī sāng yú","abbr":"szdyszsy","explanation":"东隅：东方日出处，指早晨；桑、榆：指日落处，也指日暮。比喻开始在这一方面失败了，最后在另一方面取得胜利。","source":{"text":"始虽垂翅回奚，终能奋翼黾池，可谓失之东隅，收之桑榆。","book":"《后汉书·冯异传》"},"example":{"text":"谷城之变，朕还是不肯治他的罪，仍望他“～”。","book":"姚雪垠《李自成》第二卷第十九章"},"similar":["塞翁失马，焉知非福"],"usage":"作宾语、分句；用于劝诫人","story":["东汉初年，光武帝刘秀派大将冯异与邓禹去围剿赤眉农民起义军，邓禹与义军交战后不幸损兵折将，冯异命令部队加强防御，收拢溃散的散兵，同时派军装成赤眉军打入其内部，结果大获全胜。朝廷下文书表彰他们的战斗是失之东隅，收之桑榆"]},{"id":13965,"word":"失之交臂","pinyin":"shī zhī jiāo bì","abbr":"szjb","explanation":"交臂：胳膊碰胳膊，指擦肩而过。形容当面错过。","source":{"text":"吾终身与汝交一臂而失之，可不哀与？","book":"《庄子·田子方》"},"example":{"text":"用人者不务取其大而专取小知，则卓荦俊伟之材～矣。","book":"清·魏源《默觚下治篇一》"},"similar":["坐失良机","失诸交臂"],"opposite":["机不可失"],"usage":"作谓语、定语；形容当面错过机会"},{"id":13966,"word":"失之千里，差若毫厘","pinyin":"shī zhī qiān lǐ，chà ruò háo lí","abbr":"szqlcrhl","explanation":"指细微的失误，可导致巨大的差错。","source":{"text":"失之千里，差若毫厘，大象一乖，馀何可验！","book":"《隋书·天文志上》"},"similar":["失之毫厘，差之千里"],"usage":"作宾语、分句；用于强调不能有一丝差错"},{"id":13967,"word":"失之毫厘，差之千里","pinyin":"shī zhī háo lí，chà zhī qiān lǐ","abbr":"szhlczql","explanation":"指细微的失误，可导致巨大的差错。","source":{"text":"《易》曰：‘正其本，万物理。失之毫厘，差之千里。’","book":"西汉·戴圣《大戴礼记·保傅》"},"example":{"text":"在开始的时候，就得有个盘算，才不致～。","book":"陶铸《崇高的理想》"},"similar":["失之毫厘，谬以千里"],"usage":"作宾语、分句；指小错误会产生大错误","story":["西汉时期，赵充国奉汉宣帝之命去平定西北地区叛乱，见叛军军心不齐，就采取招抚的办法，使得大部分叛军投诚。可汉宣帝命他出兵，结果出师不利。后来他按皇命收集军粮，造成叛乱，他感慨地说：“真是失之毫厘，差之千里。”"]},{"id":13968,"word":"失之毫厘，差以千里","pinyin":"shī zhī háo lí，chà yǐ qiān lǐ","abbr":"szhlcyql","explanation":"指细微的失误，可导致巨大的差错。","source":{"text":"夫安危之兆，祸福之机，匪独天时，亦由人事。失之毫厘，差以千里。是以明智之士，据重位而不倾，执大节而不失，岂惑于浮辞哉？","book":"《陈书·虞荔传》"},"example":{"text":"～。目的一失，以后之种种遂不可设想矣。","book":"《辛亥革命前十年间时论选集·无政府说》"},"similar":["失之毫厘，差之千里"],"usage":"作宾语、分句；指小错误会产生大错误"},{"id":13969,"word":"失之毫厘，谬以千里","pinyin":"shī zhī háo lí，miù yǐ qiān lǐ","abbr":"szhlmyql","explanation":"毫、厘：两种极小的长度单位。开始稍微有一点差错，结果会造成很大的错误。","source":{"text":"《易》曰：‘君子慎始，差若毫厘，缪以千里。’","book":"《礼记·经解》"},"example":{"text":"孙先生却把它看成先有文人，而后变成弄臣。这一来，真是“～”了！","book":"闻一多《屈原问题》"},"similar":["失之毫厘，差之千里"],"usage":"作宾语、分句；指小错误会产生大错误","story":["西汉时期，赵充国奉汉宣帝之命去平定西北地区叛乱，见叛军军心不齐，就采取招抚的办法，使得大部分叛军投诚。可汉宣帝命他出兵，结果出师不利。后来他按皇命收集军粮，造成叛乱，他感慨地说：“真是失之毫厘，谬以千里。”"]},{"id":13970,"word":"失之穿凿","pinyin":"shī zhī chuān záo","abbr":"szcz","explanation":"穿凿：把讲不通的硬要讲通。把讲不通的或不相干的道理、事情硬扯在一起进行解释。","source":{"text":"用是知好奇者欲穿凿附会固各有说云。","book":"宋·洪迈《容斋续笔·义理之说无穷》卷二"},"example":{"text":"“天阙象纬逼”，当如旧字，作“天窥”、“阅”，咸～。","book":"明·王世贞《艺苑卮言》"}},{"id":13971,"word":"失之若惊","pinyin":"shī zhī ruò jīng","abbr":"szrj","explanation":"形容过多地考虑个人的得失。","source":{"text":"得之若惊，失之若惊，是谓宠辱若惊。","book":"《老子》第十三章"}},{"id":13972,"word":"失光落彩","pinyin":"shī guāng luò cǎi","abbr":"sglc","explanation":"没有了光彩。形容没有面子。","source":{"text":"钱会说话，米会摇摆；无米无钱，换光落彩。","book":"元·无名氏《冻苏秦》楔子"}},{"id":13973,"word":"失口乱言","pinyin":"shī kǒu luàn yán","abbr":"skly","explanation":"失口：说了不该说的话。指不能控制，胡言乱语。","source":{"text":"诸斗争折辨，辄提大名字者，罪之。诸职官因公失口乱言者，笞二十七。","book":"《礼记·表记》：“不失口于人。”《元史·刑法志》"},"example":{"text":"不许擅离方位。不许交头接耳。不许～。不许失惊打怪。如违令者斩！","book":"明·罗贯中《三国演义》第四十九回"}},{"id":13974,"word":"失声痛哭","pinyin":"shī shēng tòng kū","abbr":"sstk","explanation":"因为过度悲痛而痛哭。","source":{"text":"公子想起自己那番苦楚，痛定思痛，也不觉失声痛哭。","book":"清·文康《儿女英雄传》第十二回"},"example":{"text":"众百姓见到此碑，想起他生平的好处，往往～，因此这碑称为“堕泪碑”。","book":"金庸《神雕侠侣》第三十五回"}},{"id":13975,"word":"失张冒势","pinyin":"shī zhāng mào shì","abbr":"szms","explanation":"冒冒失失的样子。","source":{"text":"春梅道：‘怪因，失张冒势，恁唬我一跳。有要没紧，两头回来游魂哩。’","book":"《金瓶梅词话》第三十回"},"similar":["冒冒失失"],"usage":"作谓语、定语、状语；用于人的状态等"},{"id":13976,"word":"失张失志","pinyin":"shī zhāng shī zhì","abbr":"szsz","explanation":"形容举动慌乱，心神不定。","source":{"text":"那婆子听得叫，失张失志，出去迎接来叫的官人。","book":"《清平山堂话本·简贴和尚》"},"example":{"text":"娘见那女孩儿前言不应后语，～，道三不着两，面上忽青忽红。","book":"《警世通言·计押番金鳗产祸》"},"similar":["失张失致","失张失智"],"usage":"作谓语、定语、状语；形容举动慌乱"},{"id":13977,"word":"失张失智","pinyin":"shī zhāng shī zhì","abbr":"szsz","explanation":"举止失措、失神落魄的样子。","source":{"text":"常言'人贫智短'，他恁地贫困，如何怪得他失张失智？","book":"明·冯梦龙《古今小说·陈御史巧勘金钗钿》"},"example":{"text":"那时我这个人六神无主，～的。没有从前唧溜，也没有从前勤快了。","book":"朱自清《笑的历史》"},"similar":["心神不定","失张失志","失张失致"],"usage":"作谓语、定语；形容举动慌乱"},{"id":13978,"word":"失张失致","pinyin":"shī zhāng shī zhì","abbr":"szsz","explanation":"形容举动慌乱，心神不定。","source":{"text":"元茂便向腰间摸了两摸，失张失致的道：‘奇怪！’","book":"《品花宝鉴》第八回"},"similar":["失张失志","失张失智"],"usage":"作谓语、定语、状语；形容举动慌乱"},{"id":13979,"word":"失惊倒怪","pinyin":"shī jīng dǎo guài","abbr":"sjdg","explanation":"犹失惊打怪。惊恐；慌张。","source":{"text":"回家方稀奇事，失惊倒怪落三魂。","book":"《天花雨》第十四回"},"similar":["大惊小怪"],"usage":"作谓语、定语、状语；用于处事"},{"id":13980,"word":"失惊打怪","pinyin":"shī jīng dǎ guài","abbr":"sjdg","explanation":"①形容大惊小怪。②形容神色慌张或动作忙乱。","source":{"text":"……御史论其白衣吃菜，遂赋《鹊桥仙》词云：‘远公莲社，流传图画，千古声名犹在。后人多少继遗踪，到我便失惊打怪。’","book":"宋·洪迈《夷坚三志己善谑诗词》"},"example":{"text":"空着我便耳热眼跳，心神恍忽，～。","book":"元·刘庭信《新水令·春恨》套曲"},"similar":["大惊小怪"],"usage":"作谓语、定语；指大惊小怪"},{"id":13981,"word":"失旦之鸡","pinyin":"shī dàn zhī jī","abbr":"sdzj","explanation":"忘记报晓的雄鸡。比喻失职或犯错误的人。","source":{"text":"失晨之鸡，思补更鸣。","book":"汉·曹操《选举令》"},"example":{"text":"窃惟陛下钦明稽古，隆于兴继，为胤归诉，乞丐余罪，还兵复爵，使～，复得一鸣。","book":"《三国志·吴志·周喻传》"}},{"id":13982,"word":"失时落势","pinyin":"shī shí luò shì","abbr":"ssls","explanation":"指时运不济。","source":{"text":"元·无名氏《朱砂担》第四折；“若不是我失时落势，怎生的便揽祸招危。”"},"usage":"作谓语、定语、状语；用于人的境遇等"},{"id":13983,"word":"失晨之鸡","pinyin":"shī chén zhī jī","abbr":"sczj","explanation":"忘记报晓的雄鸡。比喻失职或犯错误的人。","source":{"text":"失晨之鸡，思补更鸣。","book":"汉·曹操《选举令》"},"example":{"text":"臣闻～，虽不忘于改旦，败驾之马，终取忸於衔镳。","book":"南朝·梁·刘孝仪《安成王让江州表》"}},{"id":13984,"word":"失林之鸟","pinyin":"shī lín zhī niǎo","abbr":"slzn","explanation":"失去树林的鸟儿。比喻无处藏身与生活。","source":{"text":"何乃进不偶用，退不获安，呼吸若穷池之鱼，行止比失林之鸟，忧伤之心，不能亡已！","book":"清·褚人获《隋唐演义》第三回"},"similar":["穷池之鱼"],"usage":"作宾语；用于比喻句"},{"id":13985,"word":"失枝脱节","pinyin":"shī zhī tuō jié","abbr":"sztj","explanation":"比喻因关照呼应不周而造成失误或差错。","source":{"text":"要常践道，践道则精明。一不践道，便不精明，便失枝落节。","book":"宋·陆九渊《语录》"},"example":{"text":"从你去后，我只怕你有些～，或早或晚回来，因此分付这几个男女，但凡拿得行货，只要活的。","book":"明·施耐庵《水浒全传》第三十一回"}},{"id":13986,"word":"失神丧魄","pinyin":"shī shén sàng pò","abbr":"sssp","explanation":"失：丧失；魄：人的精神灵气。形容心神不宁或惊慌之极。","source":{"text":"怎么我近来变了呀！这样失神丧魄，没有一点精密的计算？","book":"茅盾《虹》"},"similar":["失魂丧魄","丧魂落魄"],"usage":"作谓语、定语、状语；指惊恐"},{"id":13987,"word":"失神落魄","pinyin":"shī shén luò pò","abbr":"sslp","explanation":"魄：旧指人身中依附形体而显现的精神为魄。形容惊慌忧虑、心神不定、行动失常的样子。","source":{"text":"饿的我肚里饥失魂丧魄，冻的我身上冷无颜落色。","book":"元·无名氏《看钱奴》第二折"},"example":{"text":"金轮法王见他～，眼中却露出恨恨之意。","book":"金庸《神雕侠侣》第十七回"}},{"id":13988,"word":"失精落彩","pinyin":"shī jīng luò cǎi","abbr":"sjlc","explanation":"指没精打彩。","source":{"text":"许佳期无处追寻，走海上失精落彩。","book":"元·李好古《张生煮海》第四折"},"similar":["没精打采"],"usage":"作谓语、定语、状语；用于的精神状态"},{"id":13989,"word":"失而复得","pinyin":"shī ér fù dé","abbr":"sefd","explanation":"指失去而后又得到。","source":{"text":"是失而复得，废而复举也。","book":"宋·王安石《原过》"},"example":{"text":"陆先生摹拟那～的快感，想象那过度劳作之后得以坐下来透一口气似的乐趣。","book":"叶圣陶《得失》"},"opposite":["得而复失"],"usage":"作谓语、定语；指失去而又得到"},{"id":13990,"word":"失诸交臂","pinyin":"shī zhū jiāo bì","abbr":"szjb","explanation":"指当面错过机会。","source":{"text":"见“失之交臂”。"},"example":{"text":"这些往事，我今天来重提，只是表明我自己的遗憾。我与鲁迅的见面，真真可以说是～。","book":"郭沫若《历史人物·鲁迅与王国维》"},"similar":["失之交臂"],"usage":"作谓语、定语；形容当面错过机会"},{"id":13991,"word":"失败为成功之母","pinyin":"shī bài wéi chéng gōng zhī mǔ","abbr":"sbwcgzm","explanation":"失败往往是成功的先导。指从失败中吸取教训，最后取得胜利。"},{"id":13992,"word":"失败乃成功之母","pinyin":"shī bài nǎi chéng gōng zhī mǔ","abbr":"sbncgzm","explanation":"失败往往是成功的先导。指从失败中吸取教训，最后取得胜利。","example":{"text":"～，一次失败算不了什么。"},"similar":["失败是成功之母","失败者成功之母"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":13993,"word":"失败是成功之母","pinyin":"shī bài shì chéng gōng zhī mǔ","abbr":"sbscgzm","explanation":"母：先导，根源。失败往往是成功的先导。指从失败中吸取教训就能取得胜利。","source":{"text":"经验对于干部是必需的，失败是成功之母。","book":"毛泽东《中国革命战争的战略问题》"},"example":{"text":"～，我们从头再来。"},"similar":["失败乃成功之母","失败者成功之母"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":13994,"word":"失败者成功之母","pinyin":"shī bài zhě chéng gōng zhī mǔ","abbr":"sbzcgzm","explanation":"母：先导，根源。失败往往是成功的先导。指从失败中吸取教训就能取得胜利。","source":{"text":"所谓‘失败者成功之母’，‘吃一堑，长一智’，就是这个道理。","book":"毛泽东《实践论》"},"similar":["失败是成功之母","失败乃成功之母"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":13995,"word":"失足落水","pinyin":"shī zú luò shuǐ","abbr":"szls","explanation":"脚一滑跌入水中。比喻受诱骗而犯下严重错误，以至行为堕落。","source":{"text":"想是那位客官夜间出来小解，失足落水，或是有的。","book":"清·石玉昆《三侠五义》第87回"},"example":{"text":"所以湘军在反攻大胜之后又急速向南撤退，五月一日湘军刘建藩在株州渡河时～溺死。","book":"丁中江《北洋军阀史话》三十七"},"usage":"作谓语、定语；用于处事"},{"id":13996,"word":"失身匪人","pinyin":"shī shēn fěi rén","abbr":"ssfr","explanation":"失身：丧失自身应坚持的节操；匪人：指品行不正的人。指丧失节操而依附于邪恶的人。也指女子失节于品质恶劣的人。","source":{"text":"吾闻公卿择士，士亦择公卿。刘歆、柳宗元失身匪人，为万世笑。今政自韩氏出，吾肯出其门哉？","book":"《宋史·王阮传》"},"example":{"text":"孩儿一时错误，失身匪人，羞见公子之面，自缢身亡，以完贞性。","book":"明·冯梦龙《喻世明言》卷二"}},{"id":13997,"word":"失道寡助","pinyin":"shī dào guǎ zhù","abbr":"sdgz","explanation":"道：道义；寡：少。做事违反正义的人，一定得不到别人的支持和帮助。","source":{"text":"得道者多助，失道者寡助。寡助之至，亲戚畔之。","book":"战国·邹·孟轲《孟子·公孙丑下》"},"example":{"text":"由于中国战争的进步性、正义性而产生出来的国际广大援助，同日本的～又恰恰相反。","book":"毛泽东《论持久战》"},"opposite":["得道多助"],"usage":"作定语、分句；用于劝诫人"},{"id":13998,"word":"失马亡羊","pinyin":"shī mǎ wáng yáng","abbr":"smwy","explanation":"泛指祸福得失。","source":{"text":"耳不闻斩蛇逐鹿，口不言失马亡羊，一任他桑田变海，海变桑田。","book":"明·单本《蕉帕记·揭柬》"},"example":{"text":"～不必太在意。"},"similar":["塞翁失马，亡羊补牢"],"usage":"作主语、宾语、定语；泛指祸福得失"},{"id":13999,"word":"失马塞翁","pinyin":"shī mǎ sài wēng","abbr":"smsw","explanation":"比喻因祸得福的人。","source":{"text":"我家虽不宽余，也还可以勉强温饱，都因我无端的官兴发作，几乎弄得家破人亡；还仗天祖之灵，才幸而作了个‘失马塞翁’。","book":"《儿女英雄传》第三三回"},"similar":["塞翁失马"],"usage":"作宾语、定语；多用于比喻句","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":14000,"word":"失魂丧胆","pinyin":"shī hún sàng dǎn","abbr":"shsd","explanation":"形容极度恐慌。","source":{"text":"他那四方脸、紫红脸膛、宽肩膀、魁梧身材的雄姿和他那吞日月、贯长虹的英雄气概，使得那一群脱离了大队的英国皇家军失魂丧胆。","book":"巴金《生活在英雄们的中间》"},"similar":["失魂丧魄"],"usage":"作谓语、定语；用于惊慌等"},{"id":14001,"word":"失魂丧魄","pinyin":"shī hún sàng pò","abbr":"shsp","explanation":"①形容心烦意乱，精神恍惚。②形容极度惊恐不安。","source":{"text":"您孩儿为母不安，这些时衣不解带，寝食俱发，忧凄不止，行坐之间，犹如失魂丧魄。","book":"元·刘唐卿《降桑》第二折"},"example":{"text":"经过十几分钟猛烈无情的战斗，早已～的残敌，丢枪弃刀，一个个跪倒在地，举手投降。","book":"《人民文学》1977年第10期"},"similar":["失神丧魄","丧魂落魄"],"opposite":["泰然自若"],"usage":"作谓语、定语、状语；指惊恐"},{"id":14002,"word":"失魂荡魄","pinyin":"shī hún dàng pò","abbr":"shdp","explanation":"形容心意烦乱，精神恍惚。","source":{"text":"［严蕊］乃是个绝色的女子。一应琴棋书画，歌舞管弦之类，无所不通……所以人见了的，没一个不失魂荡魄在他身上。","book":"明·凌濛初《二刻拍案惊奇》卷十二"},"similar":["失魂落魄","失魂丧魄"],"usage":"作谓语、定语、状语；用于人"},{"id":14003,"word":"失魂落魄","pinyin":"shī hún luò pò","abbr":"shlp","explanation":"魂、魄：旧指人身中离开形体能存在的精神为魂，依附形体而显现的精神为魄。形容惊慌忧虑、心神不定、行动失常的样子。","source":{"text":"饿的我肚里饥失魂丧魄，冻的我身上冷无颜落色。","book":"元·无名氏《看钱奴》第二折"},"example":{"text":"那知我福气薄，叫神鬼支使的～。","book":"清·曹雪芹《红楼梦》第一百七回"},"similar":["魂不守舍","惊慌失措"],"opposite":["泰然自若","悠然自得"],"usage":"作谓语、定语、状语；用于人"},{"id":14004,"word":"失鹿共逐","pinyin":"shī lù gòng zhú","abbr":"slgz","explanation":"失：失去；鹿：指帝位；逐：追赶。失掉帝位，天下大乱，人人争着追逐。比喻失去政权后，天下大乱，各路英雄争夺帝位。","source":{"text":"秦失其鹿，天下共逐之。","book":"《史记·淮阴侯列传》"},"example":{"text":"唾手可得，俯拾即是，如蚁慕膻，闻风并至，～，抚掌欢呼。","book":"清、康有为《上皇帝第六书》"}},{"id":14005,"word":"头一无二","pinyin":"tóu yī wú èr","abbr":"tywe","explanation":"唯一，只有一个。","source":{"text":"本总理今晚来同诸君讲话，没有别的贡献，头一无二的贡献，就是要诸位同志，以至诚之心，来做宣传一方面的革命工夫。","book":"孙中山《语言文学的奋斗》"},"similar":["独一无二"],"usage":"作定语、状语；用于书面语"},{"id":14006,"word":"头上安头","pinyin":"tóu shàng ān tóu","abbr":"tsat","explanation":"比喻多余和重复。","source":{"text":"何况头上安头，屋下盖屋，毕竟巧者有余，拙者不足。","book":"宋·黄庭坚《拙轩颂》"},"example":{"text":"固不必就上面一截起论，为～之说矣。","book":"清·王夫之《读四书大全说·论语·学而篇六》"},"similar":["床上安床","头上著头"],"usage":"作谓语、宾语；指多此一举"},{"id":14007,"word":"头上末下","pinyin":"tóu shàng mò xià","abbr":"tsmx","explanation":"第一次，初次。也指从上到下，从头到尾。","source":{"text":"恰似俺们把这桩事放在头里一般，头上末下就让不得这一夜儿！","book":"明·兰陵笑笑生《金瓶梅词话》第19回"},"example":{"text":"舅爷～的来，留在咱们这里吃了饭再去罢。","book":"清·曹雪芹《红楼梦》第91回"},"usage":"作谓语、分句；指第一次"},{"id":14008,"word":"头上著头","pinyin":"tóu shàng zhuó tóu","abbr":"tszt","explanation":"犹言头上安头。比喻多余和重复。","source":{"text":"饶你道有什么事，犹是头上著头，雪上加霜。","book":"宋·释道原《景德传灯录》卷十九"},"similar":["头上安头"],"usage":"作谓语、宾语；指多此一举"},{"id":14009,"word":"头会箕敛","pinyin":"tóu kuàn jī liǎn","abbr":"tkjl","explanation":"头会：按人头征税；箕敛：用畚箕装取所征的谷物。形容赋税繁重苛刻。","source":{"text":"头会箕敛，以供军费。","book":"《淮南子·氾论训》：“头会箕赋，输于少府。”《史记·张耳陈余列传》"},"example":{"text":"～者，合从缔交。","book":"北周·庾信《哀江南赋序》"},"similar":["头会箕赋"],"usage":"作宾语、定语；指赋税繁重苛刻"},{"id":14010,"word":"头会箕赋","pinyin":"tóu kuài jī fù","abbr":"tkjf","explanation":"按人数征税，用畚箕装取所征的谷物。指赋税苛刻繁重。同“头会箕敛”。","source":{"text":"头会，随民口数，人责其税；箕赋，似箕然敛民财，多取意也。","book":"《淮南子·氾论训》：“头会箕赋，输于少府。”高诱注"},"similar":["头会箕敛"],"usage":"作宾语、定语；指赋税繁重苛刻"},{"id":14011,"word":"头出头没","pinyin":"tóu chū tóu mò","abbr":"tctm","explanation":"比喻追随世俗。","source":{"text":"问：‘如何是清洁法身。’师曰：‘屎里蛆儿，头出头没。’","book":"宋·释普济《五灯会元·投子同禅师法嗣·濠州思明禅师》"},"example":{"text":"天下之人，～，于是是非非之中，倚枯附朽。","book":"明·袁宏道《广庄·齐物论》"},"similar":["随波逐流"],"usage":"作谓语；比喻追随世俗"},{"id":14012,"word":"头发胡子一把抓","pinyin":"tóu fā hú zǐ yī bǎ zhuā","abbr":"tfhzybz","explanation":"比喻做事不细致，对于不同的问题不能区别对待而是笼统处理。","source":{"text":"头发胡子一把抓，全不分青红皂白。","book":"艾芜《南行记》"},"similar":["眉毛胡子一把抓"],"usage":"作宾语、定语、分句；指主次不分"},{"id":14013,"word":"头头是道","pinyin":"tóu tóu shì dào","abbr":"ttsd","explanation":"本为佛家语，指道无所不在。后多形容说话做事很有条理。","source":{"text":"方知头头皆是道，法法本圆成。","book":"《续传灯录·慧力洞源禅师》"},"example":{"text":"再看他后面讲那汽机的做法用法，～，语语内行。","book":"清·姬文《市声》第十三回"},"similar":["有条有理","井井有条"],"opposite":["语无伦次","杂乱无章"],"usage":"作状语、定语；指人说话"},{"id":14014,"word":"头撞南墙","pinyin":"tóu zhuàng nán qiáng","abbr":"tznq","explanation":"撞：撞击。指认死理。","example":{"text":"你不要在这里～钻牛角尖了。"},"similar":["钻牛角尖"],"usage":"作谓语、定语；指认死理","story":["从前山东淄川县的王生从小相信道术，跑到崂山学道术。道士见他娇生惯养认为不是学道的料，让他先砍柴锻炼。他一心想学道，道士教他穿墙术。他学成立即回家给妻儿表演穿墙术，结果头撞南墙碰了一个大包"]},{"id":14015,"word":"头昏目晕","pinyin":"tóu hūn mù yūn","abbr":"thmy","explanation":"犹言头昏眼花。头脑昏晕，眼睛发花。","source":{"text":"贾政看了，气的头昏目晕。","book":"清·曹雪芹《红楼梦》第93回"},"similar":["头昏目眩","头昏眼花"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":14016,"word":"头昏目眩","pinyin":"tóu hūn mù xuàn","abbr":"thmx","explanation":"头脑昏晕，眼睛发花。同“头昏目晕”。","source":{"text":"满屋里的东西都是耀眼争光，使人头晕目眩。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"这隘口的两边，全是陡壁巨岩，上面挂满了对搂多粗的象鼻般的大冰凌柱，看去～，寒气侵人。","book":"曲波《林海雪原》第三十章"},"similar":["头昏眼花","头昏目晕"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":14017,"word":"头昏眼晕","pinyin":"tóu hūn yǎn yūn","abbr":"thyy","explanation":"头脑晕乱，眼睛昏花。","source":{"text":"李太师被张保背着飞跑，颠得头昏眼晕。","book":"清·钱彩《说岳全传》第二十五回"},"example":{"text":"赵子曰忙的～，夜间连把棉裤脱下来再睡的工夫也没有，早晨起来连漱口的工夫也没有。","book":"老舍《赵子曰》第六节"},"similar":["头昏眼暗","头昏眼花"],"usage":"作谓语、状语；指头脑眩昏，视力模糊"},{"id":14018,"word":"头昏眼暗","pinyin":"tóu hūn yǎn àn","abbr":"thya","explanation":"犹言头昏眼花。头脑昏晕，眼睛发花。","source":{"text":"玉姐正哭得头昏眼暗，全不觉得。","book":"明·冯梦龙《醒世恒言》卷二十"},"example":{"text":"张国乾正跌得～，扒不起来。伍连走上去，当心口一脚，踹得口中鲜血直喷，死于地下。","book":"清·钱彩《说岳全传》第六十九回"},"similar":["头昏眼晕","头昏眼花"],"usage":"作谓语、状语；指头脑眩昏，视力模糊"},{"id":14019,"word":"头昏眼花","pinyin":"tóu hūn yǎn huā","abbr":"thyh","explanation":"头脑昏晕，眼睛发花。","source":{"text":"秦王众将，略略少些，却也泻得头昏眼花，手足疲软。","book":"《说唐》第66回"},"example":{"text":"太阳晒得人～。"},"similar":["头眩眼花","头昏眼暗","头昏眼晕"],"usage":"作谓语、状语；指头脑眩昏，视力模糊"},{"id":14020,"word":"头昏脑眩","pinyin":"tóu hūn nǎo xuàn","abbr":"thnx","explanation":"头部昏晕，脑子发胀。","source":{"text":"其中有一篇，大意仿佛说，中国戏是大敲，大叫，大跳，使看客头昏脑眩，很不适于剧场。","book":"鲁迅《呐喊·社戏》"},"similar":["头昏脑胀"],"usage":"作宾语、状语；形容被困难所扰"},{"id":14021,"word":"头昏脑胀","pinyin":"tóu hūn nǎo zhàng","abbr":"thnz","explanation":"头脑发昏。形容人的繁忙或事物毫无头绪，使人厌烦。","source":{"text":"‘她又不是发烧发得头昏脑胀的’。一个说，‘只是那条腿不能走’。","book":"叶圣陶《友谊》"},"example":{"text":"这段时间我忙得～。"},"similar":["头昏眼花","头昏脑眩"],"opposite":["心明眼亮"],"usage":"作宾语、状语；形容被困难所扰"},{"id":14022,"word":"头昏脑闷","pinyin":"tóu hūn nǎo mèn","abbr":"thnm","explanation":"犹言头昏脑胀。","source":{"text":"困腾腾头昏脑闷。","book":"元·赵明道《斗鹌鹑·题情》套曲"},"example":{"text":"不才往常见人读佛经，什么‘色即是空，空即是色’，这种无理之口头禅，常觉得～。","book":"清·刘鹗《老残游记》第十回"},"similar":["头晕目眩"],"usage":"作谓语、宾语；多用于口语"},{"id":14023,"word":"头晕目眩","pinyin":"tóu yūn mù xuàn","abbr":"tymx","explanation":"头发昏，眼发花，感到一切都在旋转。","source":{"text":"满屋里的东西都是耀眼争光，使人头晕目眩。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"看见这种光怪陆离的政治局面，上海人不能不～，胆战心惊。","book":"欧阳山《苦斗》"},"similar":["头昏眼花"],"usage":"作谓语、定语；指头发昏，眼睛昏花"},{"id":14024,"word":"头晕眼昏","pinyin":"tóu yūn yǎn hūn","abbr":"tyyh","explanation":"头脑晕乱，眼睛昏花。","source":{"text":"却不知这安人生产才得三日，人是虚的；又遭此大难，在水面上团团转转，自然头晕眼昏，故此问而不答。","book":"清·钱彩《说岳全传》第二回"},"example":{"text":"丁推官身虽卧病，心中却记挂着公务，巴不得起来监督河工，怎奈～，那里爬得起？","book":"清·徐述夔《快士传》卷九"},"similar":["头晕眼花","头眩眼花","头眩目昏"],"usage":"作谓语、状语；指头脑眩昏，视力模糊"},{"id":14025,"word":"头晕眼花","pinyin":"tóu yūn yǎn huā","abbr":"tyyh","explanation":"头发昏，眼发花。","source":{"text":"方才外边的人，也都有些头晕眼花，闻了这香气，就清爽了许多。","book":"清·夏敬渠《野叟曝言》第八十七回"},"example":{"text":"清·褚人获《隋唐演义》第44回：“罗士信也吃了几杯，坐不到半个时辰，觉得天旋地转，～，伏倒几上。”"},"similar":["头昏眼花","头眩眼花","头眩目昏"],"usage":"作谓语、状语；指头脑眩昏，视力模糊"},{"id":14026,"word":"头梢自领","pinyin":"tóu shāo zì lǐng","abbr":"tszl","explanation":"自己扯着头发。比喻自讨苦吃，自找麻烦。","source":{"text":"这妮子更敢有四星，把体面妆沉，把头梢自领。","book":"元·关汉卿《调风月》第三折"},"similar":["头稍自领"],"usage":"作宾语、定语；用于书面语"},{"id":14027,"word":"头没杯案","pinyin":"tóu mò bēi àn","abbr":"tmba","explanation":"〖释义〗头伏在酒杯和桌子间。比喻尽情欢乐，不拘形迹。","source":{"text":"每与人谈论，戏弄言诵，尽无所隐，及欢悦大笑，至以头没杯案中，肴膳皆沾污巾帻。","book":"《三国志·魏书·武帝纪》"}},{"id":14028,"word":"头焦额烂","pinyin":"tóu jiāo é làn","abbr":"tjel","explanation":"形容十分狼狈窘迫。","source":{"text":"非苦非甜，人之头焦额烂，脱之无奈丝牵。","book":"明·许仲琳《封神演义》第九十七回：“摘星楼下势如焚，六宫三殿，沿烧得柱倒墙崩；天子命丧在须臾，八妃九嫔牵连得头焦额烂。”《尺牍新抄》卷七"},"example":{"text":"火山随处是，绞索自家拴。岂止是～！","book":"赵朴初《滴水集·刮地风·咏风暴》"},"similar":["焦头烂额"],"usage":"作宾语、状语；用于人的处境"},{"id":14029,"word":"头疼脑热","pinyin":"tóu téng nǎo rè","abbr":"ttnr","explanation":"泛指一般的小病或小灾小难。","source":{"text":"一百日以里，但有头疼脑热，都是你。","book":"元·孙仲章《勘头巾》第一折"},"example":{"text":"北平的灾难恰似一个人免不了有些～，过几天自然会好了的。","book":"老舍《四世同堂》"},"similar":["头痛脑热"],"usage":"作谓语、宾语、状语；泛指一般的小病"},{"id":14030,"word":"头痒搔跟","pinyin":"tóu yǎng sāo gēn","abbr":"tysg","explanation":"头痒搔脚。比喻花了气力而于事无补。","source":{"text":"头痒搔跟，无益于疾。","book":"汉·焦延寿《易林》卷十"},"similar":["头痛医脚"],"usage":"作谓语、定语；比喻花了气力而于事无补"},{"id":14031,"word":"头痛医头，脚痛医脚","pinyin":"tóu tòng yī tóu，jiǎo tòng yī jiǎo","abbr":"ttytjtyj","explanation":"比喻被动应付，对问题不作根本彻底的解决。","source":{"text":"今学者亦多来求病根，某向他说头痛灸头，脚痛灸脚，病在这上，只治这上便了，更别求甚病根也。","book":"宋·朱熹《朱子语类》卷一百一十四"},"example":{"text":"～，都不是办法，你应当朝远处看，看看明天罢！明天有我们的希望。","book":"茅盾《清明前后》第五幕"},"similar":["头痛灸头，脚痛灸脚"],"opposite":["正本清源"],"usage":"作定语、分句；指不从根本上彻底的解决"},{"id":14032,"word":"头痛治头","pinyin":"tóu tòng zhì tóu","abbr":"ttzt","explanation":"指针对疼痛部位医治，不追究病因。比喻做事缺乏通盘计划，被动应付，不从根本上彻底的解决。","source":{"text":"语曰：‘头痛治头，足痛治足’。今虏祸方中于辽，辽以一镇当全虏之势，病在足之时矣。","book":"明·张居正《与张心斋计不许东虏款贡》"},"similar":["头痛灸头，脚痛灸脚"],"usage":"作宾语、定语；用于处事"},{"id":14033,"word":"头痛治头，足痛治足","pinyin":"tóu tòng zhì tóu，zú tòng zhì zú","abbr":"ttztztzz","explanation":"比喻只解决具体问题，不深究产生问题的根源。同“头痛灸头，脚痛灸脚”。","source":{"text":"语曰：‘头痛治头，足痛治足’。今虏祸方中于辽，辽以一镇当全虏之势，病在足之时矣。","book":"明·张居正《与张心斋计不许东虏款贡》"},"similar":["头痛灸头，脚痛灸脚"],"usage":"作宾语、定语；用于处事"},{"id":14034,"word":"头痛灸头，脚痛灸脚","pinyin":"tóu tòng jiǔ tóu，jiǎo tòng jiǔ jiǎo","abbr":"ttjtjtjj","explanation":"指针对疼痛的部位治疗，不追究病根。比喻只解决具体问题，不深究产生问题的根源。","source":{"text":"今学者亦多来求病根，某向他说头痛灸头，脚痛灸脚，病在这上，只治这上便了，更别求甚病根也。","book":"宋·朱熹《朱子语类》第114回"},"similar":["头痛治头，足痛治足"],"usage":"作宾语、定语；用于处事"},{"id":14035,"word":"头痛脑热","pinyin":"tóu tòng nǎo rè","abbr":"ttnr","explanation":"泛指一般的小病或小灾小难。同“头疼脑热”。","source":{"text":"若果有此事，前日大棍打时，也该有些头痛脑热。","book":"清·褚人获《隋唐演义》第32回"},"example":{"text":"杨朔《雪花飘飘·本题》：“人嘛，谁没有个～的。”"},"similar":["头疼脑热","头痛额热"],"usage":"作主语、宾语、定语；多用于口语"},{"id":14036,"word":"头痛额热","pinyin":"tóu tòng é rè","abbr":"tter","explanation":"泛指一般的小病或小灾小难。同“头疼脑热”。","source":{"text":"俺两口儿有些头痛额热，思想你时，见这半个衫儿，便是见您两口儿一般。","book":"元·张国宾《合汗衫》第二折"},"similar":["头痛脑热","头疼脑热"],"usage":"作主语、宾语、定语；多用于口语"},{"id":14037,"word":"头皮发麻","pinyin":"tóu pí fā má","abbr":"tpfm","explanation":"形容极其恐惧的感觉。","source":{"text":"他的头皮发麻，假如荆原真的是来找他算账的，他很难说没有一点儿心虚。","book":"张抗抗《淡淡的晨雾》"},"example":{"text":"这事让我～。"},"usage":"作谓语、宾语、状语；指十分恐惧"},{"id":14038,"word":"头眩目昏","pinyin":"tóu xuàn mù hūn","abbr":"txmh","explanation":"头脑昏晕，眼睛发花。同“头昏眼花”。","source":{"text":"连日头眩目昏，呕血数斗，恐逐不能起，未免以墓文累大笔也。","book":"明·袁宏道《锦帆集·尺牍》"},"similar":["头晕眼花","头晕眼昏"],"usage":"作谓语、状语；指头脑眩昏，视力模糊"},{"id":14039,"word":"头眩眼花","pinyin":"tóu xuàn yǎn huā","abbr":"txyh","explanation":"头发昏，眼发花。","source":{"text":"半晌，方上床。头眩眼花，倒在床上，四肢倦怠，百骨酸疼。","book":"明·冯梦龙《喻世明言》卷三"},"example":{"text":"彩云还是初次乘坐船，虽不颠簸，终觉～，终日的困卧。","book":"清·曾朴《孽海花》第九回"},"similar":["头昏眼花","头晕眼花","头晕眼昏"],"usage":"作谓语、状语；指头脑眩昏，视力模糊"},{"id":14040,"word":"头破流血","pinyin":"tóu pò liú xuè","abbr":"tplx","explanation":"打破了头，血流满面。形容遭受惨败或严重的打击的样子。","source":{"text":"贼欲破棺，撰叩头、数请，头破流血，贼义而释之，由是显名。","book":"宋·刘彦明《敦煌实录》"},"similar":["头破血流","头破血淋","头破血出"],"usage":"作谓语、定语、状语；多指失败"},{"id":14041,"word":"头破血出","pinyin":"tóu pò xuè chū","abbr":"tpxc","explanation":"多用来形容惨败。同“头破血流”。","source":{"text":"那些赶车的但说句话，打的头破血出的。","book":"清·曹雪芹《红楼梦》第九十三回"},"example":{"text":"通使请二人来到王府，进了内室，只见世子睡在床上，两腿俱伤，～，因跌的过重，昏迷不醒。","book":"清·李汝珍《镜花缘》第二十九回"},"similar":["头破血淋","头破血流","头破流血"],"usage":"作谓语、定语、状语；多指失败"},{"id":14042,"word":"头破血流","pinyin":"tóu pò xuè liú","abbr":"tpxl","explanation":"头打破了，血流满面。多用来形容惨败。","source":{"text":"照道士脸上一刮，可怜就打得头破血流身倒地，皮开颈折脑浆倾。","book":"明·吴承恩《西游记》第四十四回"},"example":{"text":"你若在继续顽抗下去，必定会碰得～！。"},"similar":["一败涂地","溃不成军","头破血淋"],"opposite":["马到成功"],"usage":"作谓语、定语、状语；多指失败","story":["唐僧师徒西天取经，见道士押着和尚在干活，悟空对道士说这些和尚是他的亲戚，道士同意让他放一个走，和尚都想逃出道士的控制。悟空要求道士把这500和尚都放了，道士不干。悟空取出金箍棒把道士打得头破血流，把和尚全部放走"]},{"id":14043,"word":"头破血淋","pinyin":"tóu pò xuè lín","abbr":"tpxl","explanation":"头被打破，流出了血。形容受到严重打击或遭到惨败的样子。","source":{"text":"常常打得皮开肉绽，头破血淋，也再无一点退悔之念，一名怨恨之言。","book":"明·冯梦龙《醒世恒言·徐老仆义愤成家》"},"example":{"text":"受降的主顾那么多，又都是世界上的头等恶霸，岂有不互相打得～的道理。","book":"瞿秋白《文艺杂著续辑·和国货年》"},"similar":["头破血流","头破血出","头破流血"],"usage":"作谓语、定语、状语；多指失败"},{"id":14044,"word":"头稍自领","pinyin":"tóu shāo zì lǐng","abbr":"tszl","explanation":"比喻自讨苦吃，自找麻烦。同“头梢自领”。","source":{"text":"老姑娘手把着头稍自领，索什么嘱咐叮咛。","book":"元·关汉卿《玉镜台》第二折"},"similar":["头梢自领"],"usage":"作宾语、定语；用于书面语"},{"id":14045,"word":"头童齿豁","pinyin":"tóu tóng chǐ huò","abbr":"ttch","explanation":"童：原指山无草木，比喻人秃顶；豁：缺口。头顶秃了，牙齿稀了。形容人衰老的状态。","source":{"text":"头童齿豁，竟死何裨？","book":"唐·韩愈《进学解》"},"example":{"text":"一年数病，～；而忽遭母夫人之变，形神益复支离。","book":"清·谢章铤《魏子安墓志铭》"},"similar":["头白齿豁"],"usage":"作谓语、定语；形容人衰老的状态"},{"id":14046,"word":"头脑冷静","pinyin":"tóu nǎo lěng jìng","abbr":"tnlj","explanation":"指气质上的冷静或异常的镇定，指在紧张情况下表现的冷静或镇定。","example":{"text":"她处理问题～。"},"opposite":["头脑发热"],"usage":"作谓语、定语；指遇事沉着"},{"id":14047,"word":"头角峥嵘","pinyin":"tóu jiǎo zhēng róng","abbr":"tjzr","explanation":"头角：比喻青年人显露出来的才华；峥嵘：特出的样子。形容年轻有为，才华出众。","source":{"text":"虽少年，已自成人，能取进士第，崭然露头角。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"那时～际，搅海翻江上九天。","book":"元·无名氏《黄鹤楼》第三折"},"similar":["初生牛犊"],"opposite":["乳臭未干"],"usage":"作谓语；用于年轻人"},{"id":14048,"word":"头角崭然","pinyin":"tóu jiǎo zhǎn rán","abbr":"tjzr","explanation":"头角：比喻青年人显露出来的才华；崭然：特出的样子。形容年轻有为，才华出众。","source":{"text":"虽少年，已自成人，能取进士第，崭然露头角。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"夜间安营，尝有黑物护住营外，～，目光如电，诘旦即云雾四周，不得复见。","book":"蔡东藩《两晋演义》第七十一回"},"usage":"作谓语、定语；用于书面语"},{"id":14049,"word":"头足倒置","pinyin":"tóu zú dào zhì","abbr":"tzdz","explanation":"比喻颠倒事物的主次关系。"},{"id":14050,"word":"头足异处","pinyin":"tóu zú yì chǔ","abbr":"tzyc","explanation":"指被斩。","source":{"text":"汉王借兵而东下，杀成安君泜水之南，头足异处，卒为天下笑。","book":"战国·楚·屈原《楚辞·国殇》：“首身离兮心不惩。”《史记·淮阴侯列传》"},"example":{"text":"传首边庭，～，亦足为临难鲜忠者之戒矣。","book":"《明史·熊廷弼传》"},"similar":["首足异处","身首异处","头足异所"],"usage":"作谓语、定语；指被杀头"},{"id":14051,"word":"头足异所","pinyin":"tóu zú yì suǒ","abbr":"tzys","explanation":"指被斩。同“头足异处”。","source":{"text":"昔者费仲、恶来革、长鼻决耳，崇侯虎顺纣之心，欲以合于意，武王伐纣、四子身死牧之野，头足异所，比干尽忠剖心而死。","book":"汉·刘向《说苑·杂言》"},"similar":["首足异处","身首异处","头足异处"],"usage":"作谓语、定语；指被杀头"},{"id":14052,"word":"头重脚轻","pinyin":"tóu zhòng jiǎo qīng","abbr":"tzjq","explanation":"头脑发胀，脚下无力。形容身体不适。也比喻基础不牢固。","source":{"text":"他的酒量原不济，三瓯落肚，渐觉头重脚轻。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"example":{"text":"墙上芦苇，～要底浅；山间竹笋，嘴尖皮厚腹中空。","book":"毛泽东《改造我们的学习》"},"similar":["虎头蛇尾","有条有理"],"opposite":["根深蒂固"],"usage":"作谓语、定语、状语；指轻重倒置"},{"id":14053,"word":"头重脚轻根底浅","pinyin":"tóu zhòng jiǎo qīng gēn dǐ qiǎn","abbr":"tzjqgdq","explanation":"头比脚重没有基础。比喻根基不扎实。","source":{"text":"有一副对子，是替这种人画像的。那对子说：墙上芦苇，头重脚轻根底浅；山间竹笋，嘴尖皮厚腹中空。","book":"毛泽东《改造我们的学习》"},"similar":["头重脚轻"],"usage":"作宾语、定语；用于事物或观点等"},{"id":14054,"word":"头面人物","pinyin":"tóu miàn rén wù","abbr":"tmrw","explanation":"指在社会上有较大名声或势力而又经常抛头露面的人。","source":{"text":"小小的理发室也反映着人世的沧桑，何况到这里来整容的颇多头面人物。","book":"王蒙《悠悠寸草心》"},"example":{"text":"他是小镇上的～。"},"similar":["首脑人物"],"opposite":["无名小卒"],"usage":"作主语、宾语；指有影响的人"},{"id":14055,"word":"头高头低","pinyin":"tóu gāo tóu dī","abbr":"tgtd","explanation":"形容用秤称东西时，秤杆的一端高一点或低一点，难免稍有出入。","example":{"text":"既不像低级说客那样赤裸裸地进行交易，更不像小商贩那样为～去煞费苦心地拨弄秤砣。","book":"李存葆《高山下的花环》十三"},"usage":"作宾语、定语；用于口语"},{"id":14056,"word":"夷为平地","pinyin":"yí wéi píng dì","abbr":"ywpd","explanation":"夷：拉平，铲平。铲平使成一块平地","example":{"text":"这次强烈地震让唐山城市～"},"usage":"作谓语、定语；用于书面语"},{"id":14057,"word":"夷然不屑","pinyin":"yí rán bù xiè","abbr":"yrbx","explanation":"夷然：泰然；不屑：轻视。心中泰然，毫不在意。","source":{"text":"深公得此义，夷然不屑。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"家产渐以中落，犹～也。","book":"清·汪琬《张府君墓志铭》"},"usage":"作谓语、定语；指毫不在意"},{"id":14058,"word":"夷然自若","pinyin":"yí rán zì ruò","abbr":"yrzr","explanation":"指神态镇定，与平常一样。","source":{"text":"内外惶怖，义僖夷然自若。","book":"《魏书·卢义僖传》"},"example":{"text":"家人进粥曰：“清官亦知有今日耶？”公～也。","book":"清严有禧《漱华随笔·鱼盛二公》"},"similar":["泰然自若","镇定自若"],"usage":"作谓语、状语；用于处事"},{"id":14059,"word":"夷险一致","pinyin":"yí xiǎn yī zhì","abbr":"yxyz","explanation":"夷：平安。不论处于顺境或是逆境，节操均不变如一。","source":{"text":"竭身命以列国，经夷险而一节者，忠臣也。","book":"《抱朴子》"},"example":{"text":"竹节贞，贞以立志，君子见其节，则思砥砺名行，～者。","book":"唐·白居易《养竹记》"}},{"id":14060,"word":"夷险一节","pinyin":"yí xiǎn yī jié","abbr":"yxyj","explanation":"夷：平安；节：节操。不论处于顺境或是逆境，节操均不变如一。","source":{"text":"竭身命以列国，经夷险而一节者，忠臣也。","book":"《抱朴子》"},"example":{"text":"故能出入将相，勤劳王家，而～。","book":"宋·欧阳修《相州昼锦堂记》"},"usage":"作谓语、定语；用于处事"},{"id":14061,"word":"夸功自大","pinyin":"kuā gōng zì dà","abbr":"kgzd","explanation":"夸：夸耀。夸耀功劳，自以为了不起。","source":{"text":"可惜着志小气骄，夸功自大。","book":"《新编五代史评话·唐史》"},"usage":"作谓语、定语；用于人的性格"},{"id":14062,"word":"夸多斗靡","pinyin":"kuā duō dòu mí","abbr":"kddm","explanation":"夸：夸耀；斗：竞争；靡：奢华。原指写文章以篇幅多、辞藻华丽夸耀争胜，后也指比赛生动豪华奢侈。","source":{"text":"读书以为学，缵言以为文，非以夸多而斗靡也。","book":"唐·韩愈《送陈秀才彤序》"},"example":{"text":"宋以后，学者好夸多而斗靡。","book":"清·袁枚《随园诗话》卷五"},"usage":"作谓语、定语；指读书或写文章"},{"id":14063,"word":"夸大其词","pinyin":"kuā dà qí cí","abbr":"kdqc","explanation":"把事情说得超过原有的程度。","source":{"text":"祥瑞之出，则润色而张大其词。","book":"宋·楼钥《攻媿集·论灾异》"},"example":{"text":"蔡京开边，祖道欲乘时徽富贵，诱王江酋，杨晟免等使纳士，～。","book":"《宋史·王祖道传》"},"similar":["哗众取宠","言过其实"],"opposite":["恰如其分"],"usage":"作谓语、定语、状语；指语言夸张"},{"id":14064,"word":"夸大其辞","pinyin":"kuā dà qí cí","abbr":"kdqc","explanation":"把事情说得超过原有的程度。同“夸大其词”。","source":{"text":"我从来不好夸大其辞。我读了几段之后，就为你的艺术的功力，你所反映的民族生活，你所投入的思想情感，你所运用的表现手法吸引了。","book":"孙犁《谈作家的立命修身之道》"},"similar":["夸大其词"],"opposite":["恰如其分"],"usage":"作谓语、定语、状语、宾语；指语言夸张"},{"id":14065,"word":"夸夸其谈","pinyin":"kuā kuā qí tán","abbr":"kkqt","explanation":"形容说话浮夸不切实际。","source":{"text":"进了书房门，听见杨执中在内咶咶而谈，知道是他已来了，进去作揖同，同坐下。","book":"清·吴敬梓《儒林外史》第十一回"},"example":{"text":"这种结论，不是甲乙丙丁的现象罗列，也不是～的滥调文章，而是科学的结论。","book":"毛泽东《改造我们的学习》"},"similar":["娓娓而谈","侃侃而谈","高谈阔论"],"opposite":["守口如瓶","默不做声","噤若寒蝉"],"usage":"作主语、宾语、定语；指说话或写文章"},{"id":14066,"word":"夸夸而谈","pinyin":"kuā kuā ér tán","abbr":"kket","explanation":"形容说话浮夸不切实际。","source":{"text":"进了书房门，听见杨执中在内咶咶而谈，知道是他已来了，进去作揖同，同坐下。","book":"清·吴敬梓《儒林外史》第十一回"},"example":{"text":"吴蒸甫先不发表意见，任听唐云山在那里～。","book":"茅盾《子夜》三"},"similar":["夸夸其谈"],"usage":"作主语、宾语、谓语；指人说话"},{"id":14067,"word":"夸妍斗艳","pinyin":"kuà yán dòu yàn","abbr":"kydy","explanation":"以艳丽相夸耀争胜。","source":{"text":"夸妍斗艳目已偷，天寒酒醺谁尔侜。","book":"宋·梅尧臣《莫登楼》诗"},"usage":"作谓语、宾语；用于书面语"},{"id":14068,"word":"夸州兼郡","pinyin":"kuā zhōu jiān jùn","abbr":"kzjj","explanation":"夸：通“跨”；兼：兼有。指管理的地区范围大，跨州连郡。","source":{"text":"而藩国大者，夸州兼部，连城数十。","book":"《汉书·诸侯王表第二》"},"similar":["跨州连郡","跨州越郡"],"usage":"作谓语、定语；用于地理方位等"},{"id":14069,"word":"夸强说会","pinyin":"kuā qiáng shuō huì","abbr":"kqsh","explanation":"会：能。夸耀自己能力强、本事大。","source":{"text":"休只爱夸强说会，少不得直做的贴骨黏皮。","book":"元·张养浩《朱履曲》曲"},"example":{"text":"你铲地敢伶牙利嘴，～，，使不着你唬鬼瞒神。","book":"明·朱权《冲漠子》第二折"},"similar":["夸强道会"],"usage":"作谓语、定语、宾语；用于为人"},{"id":14070,"word":"夸强道会","pinyin":"kuā qiáng dào huì","abbr":"kqdh","explanation":"会：能。夸耀自己能力强、本事大。亦作“夸强说会”。","source":{"text":"休兄爱夸强说会，少不得直做的贴骨黏皮。","book":"元·张养浩《寄阅世道人侯和卿·朱履曲》"},"example":{"text":"他那里～施英武，着俺那有恩有义的新尊父。","book":"明·无名氏《午时牌》第一折"},"similar":["夸强说会"],"usage":"作谓语、定语、宾语；用于为人"},{"id":14071,"word":"夸毗以求","pinyin":"kuā pí yǐ qiú","abbr":"kpyq","explanation":"夸毗：谄媚。指为求人而低三下四，屈已卑身。","source":{"text":"夫君子非不欲仕也，耻夸毗以求举。","book":"《诗经·大雅·板》：“天之方懠，无为夸毗。”《后汉书·崔骃传》"}},{"id":14072,"word":"夸父追日","pinyin":"kuā fù zhuī rì","abbr":"kfzr","explanation":"古代神话。同“夸父逐日”。","source":{"text":"夸父不量力，欲追日影，逐之于隅谷之际。渴欲得饮，赴饮河渭。河渭不足，将走北饮大泽。未至，道渴而死。","book":"战国·郑·列御寇《列子·汤问》"},"example":{"text":"神话中的许多变化，例如《山海经》中所说的‘～’……","book":"毛泽东《矛盾论》"},"similar":["夸父逐日"],"usage":"作定语、宾语；形容自不量力","story":["相传古代勇士夸父身材魁梧、力大无穷，认为世界上没有做不成的事情，他拿着手杖去追赶太阳，他翻过许多座山，渡过很多江河，累得精疲力尽也没有赶上太阳。他还是不死心，一直坚持找，直到他快到大湖边时，他因劳累过度而死"]},{"id":14073,"word":"夸父逐日","pinyin":"kuā fù zhú rì","abbr":"kfzr","explanation":"夸父：古传说中的人名。夸父拚命追赶太阳。比喻人有大志，也比喻不自量力。","source":{"text":"夸父不量力，欲追日影，逐之于隅谷之际。渴欲 得饮，赴饮河渭。河渭不足，将走北饮大泽。未至，道渴而死。","book":"《列子·汤问》"},"example":{"text":"真谓～，必渴死者也。","book":"南朝·宋·僧愍《戎华论折顾道士夷夏论》"},"similar":["夸父追日","自不量力"],"usage":"作宾语、定语；形容自不量力","story":["相传古代勇士夸父身材魁梧、力大无穷，认为世界上没有做不成的事情，他拿着手杖去追赶太阳，他翻过许多座山，渡过很多江河，累得精疲力尽也没有赶上太阳。他还是不死心，一直坚持找，直到他快到大湖边时，他因劳累过度而死"]},{"id":14074,"word":"夸能斗智","pinyin":"kuā néng dòu zhì","abbr":"kndz","explanation":"以才干、聪明夸耀争胜。","source":{"text":"看你峨冠委佩，羞人沐猴，任你夸能斗智，驱人火牛，沧海无主一着残棋后。","book":"明·梅鼎祚《玉合记·入道》"},"usage":"作谓语、宾语；指人不谦虚"},{"id":14075,"word":"夸诞之语","pinyin":"kuā dàn zhī yǔ","abbr":"kdzy","explanation":"夸诞：荒诞不经。指荒诞不切实际的话。","source":{"text":"自知以必然之事见责于世，则作夸诞之语。","book":"汉·王充《论衡·道虚》"},"similar":["夸诞大言"],"usage":"作主语、宾语；指大话"},{"id":14076,"word":"夸诞大言","pinyin":"kuā dàn dà yán","abbr":"kddy","explanation":"夸诞：荒诞不经；大言：大话。指荒诞不切实际的大话。","source":{"text":"自知以必然之事见责于世，则作夸诞之语。","book":"汉·王充《论衡·道虚》"},"example":{"text":"～，不本人情。","book":"唐·释道宣《广弘明集》卷二"},"similar":["夸诞之语"],"usage":"作主语、宾语；指大话"},{"id":14077,"word":"夸诞生惑","pinyin":"kuā dàn shēng huò","abbr":"kdsh","explanation":"夸诞：虚夸荒唐；惑：疑惑。指言语不实，使人产生疑问或不理解。","source":{"text":"诈伪生塞，诚信生神，夸诞生惑。","book":"《荀子·不苟》"},"usage":"作宾语、定语；用于书面语"},{"id":14078,"word":"夸辩之徒","pinyin":"kuā biàn zhī tú","abbr":"kbzt","explanation":"夸：浮夸；辩：巧辩。指说话做事不实事求是，爱虚夸强辩的人。","source":{"text":"盖国家大计，社稷安危，非比夸辩之徒，虚誉欺人。","book":"明·罗贯中《三国演义》第四十三回"}},{"id":14079,"word":"夹七夹八","pinyin":"jiā qī jiā bā","abbr":"jqjb","explanation":"指说话东拉西扯，混杂不清。","source":{"text":"叫家人们持杖赶逐，仇妈妈只是在旁边夹七夹八的骂。","book":"明·凌濛初《初刻拍案惊奇》卷二十四"},"example":{"text":"一顿～，骂的范进门摸不着。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["东拉西扯"],"opposite":["言简意赅"],"usage":"作状语、定语；指说话东拉西扯"},{"id":14080,"word":"夹击分势","pinyin":"jiā jī fēn shì","abbr":"jjfs","explanation":"夹击：从两面对攻；分：分散；势：势力。从两面夹攻，以分散敌人的力量。","source":{"text":"兵家夹击原分其势耳。","book":"明·周承邦《兵家要经》"}},{"id":14081,"word":"夹板医驼子","pinyin":"jiá bǎn yī tuó zǐ","abbr":"jbytz","explanation":"比喻只顾这一方面，不顾那一方面。","source":{"text":"譬如有人卒患脊偻，诸医疗治。医以酥涂，上下著板，用力痛压，不觉双目一时并出。脊虽得直，命不得存。","book":"清·翟灏《通俗编·艺术》"},"usage":"作宾语、定语；用于处事"},{"id":14082,"word":"夹枪带棍","pinyin":"jiā qiāng dài gùn","abbr":"jqdg","explanation":"形容说话带刺，并牵涉旁人。","source":{"text":"姑娘倒寻上我的晦气！又不像是恼我，又不像是恼二爷，夹枪带棍，终久是个甚么主意？","book":"清·曹雪芹《红楼梦》第31回"},"example":{"text":"教她心气不顺的就是姐妹俩刚才～的话哪。","book":"叶文玲《篱下》"},"similar":["话中有话"],"usage":"作谓语、定语；形容说话带刺"},{"id":14083,"word":"夹枪带棒","pinyin":"jiā qiāng dài bàng","abbr":"jqdb","explanation":"指言语中暗藏讽刺。","source":{"text":"姑娘倒寻上我的晦气。又不像是恼我，又不像是恼二爷，夹枪带棒，终久是个什么主意？","book":"清·曹雪芹《红楼梦》第三十一回"},"example":{"text":"敏之究竟持重一点，她怕太说得明白了，二姨太～一阵乱嚷嚷，就更是不好收拾。因之找了别的几件事来谈着，把这话扯了开去。","book":"张恨水《金粉世家》第一百三回"},"similar":["话中带刺"],"usage":"作宾语、定语、状语；用于口语"},{"id":14084,"word":"夹袋中人物","pinyin":"jiā dài zhōng rén wù","abbr":"jdzrw","explanation":"指当权者的亲信或被收揽作备用的人。","source":{"text":"公夹袋中有册子，每四方人替罢谒见，必问其有何人才。","book":"宋·朱熹《五朝名臣言行录·丞相许国吕文穆公》"},"similar":["夹袋人物"],"usage":"作宾语、定语；指备用的人"},{"id":14085,"word":"夹袋人物","pinyin":"jiā dài rén wù","abbr":"jdrw","explanation":"旧指当权者的亲信或存记备用的人。","source":{"text":"师点惓惓搜访人才，手书置夹袋中。谓蜀去朝廷远，人才难以自见。","book":"《宋史·施师点传》"},"example":{"text":"因周所编的刊物，总是几个夹袋里的人物，私心自用，以致内容糟不可言。","book":"鲁迅《伪自由书·后记》"},"similar":["夹袋中人物"],"usage":"作宾语、定语；指备用的人"},{"id":14086,"word":"夹辅之勋","pinyin":"jiā fǔ zhī xūn","abbr":"jfzx","explanation":"辅：辅佐；勋：功勋。辅佐天子的功勋。","source":{"text":"故叔旦有夹辅之勋，太公有鹰扬之功，并启土宇，并受备物，所以表章元功，殊异贤哲也。","book":"《三国志·吴志·吴主传》"},"example":{"text":"盖亲亲而得以任光宗子协，图～。","book":"宋·沈初《周以宗强赋》"}},{"id":14087,"word":"夹道欢呼","pinyin":"jiā dào huān hū","abbr":"jdhh","explanation":"众人排列在道路两旁呼喊，表示对来宾的欢迎。","source":{"text":"望云仰戴，夹道欢呼。","book":"宋·张守《谢除知福州到任表》"},"example":{"text":"萧滩老农公事毕，～罗酒浆。","book":"宋·王庭珪《送吴叔举主簿，往清江受纳秋苗》"},"similar":["夹道欢迎"],"usage":"作谓语、定语、状语；指热闹的场面"},{"id":14088,"word":"夺人之爱","pinyin":"duó rén zhī ài","abbr":"drza","explanation":"夺：抢夺。剥夺别人所喜爱的人或事物。","source":{"text":"你不是跟她很好么？夺人之爱，我可不来。人弃我取，我更不来。","book":"钱钟书《围城》"},"opposite":["投其所好"],"usage":"作谓语、定语、宾语；用于处事"},{"id":14089,"word":"夺人所好","pinyin":"duó rén suǒ hào","abbr":"drsh","explanation":"强夺别人所喜欢的人或物。","source":{"text":"恁须不夺人所好。","book":"元·王实甫《西厢记》第一本第四折"},"example":{"text":"你这样做不就是～吗？"},"similar":["夺人所爱"],"opposite":["投其所好"],"usage":"作谓语、宾语；抢夺别人的心爱之物"},{"id":14090,"word":"夺其谈经","pinyin":"duó qí tán jīng","abbr":"dqtj","explanation":"比喻在辩论中压倒众人。"},{"id":14091,"word":"夺席谈经","pinyin":"duó xí tán jīng","abbr":"dxtj","explanation":"夺：强取；席：席位。比喻在辩论中压倒众人。","source":{"text":"帝令群臣能说经者更相难诘，义有不通，辄夺其席以益通者，凭遂重坐五十余席。","book":"南朝·宋·范晔《后汉书·戴凭传》"},"usage":"作谓语、定语；比喻在辩论中压倒众人"},{"id":14092,"word":"夺戴凭席","pinyin":"duó dài píng xí","abbr":"ddpx","explanation":"原指讲经辩难时，辩胜者夺取他人的坐席。后指成就超过他人。也比喻在辩论中压倒众人。","source":{"text":"正旦朝贺，百僚毕会，帝令群臣能说经者更相难诘，义有不能，辄夺其席以益通者，凭遂重坐五十余席。故京师为之语曰：‘解经不穷戴侍中。’","book":"《后汉书·戴凭传》"},"example":{"text":"于经尤精小学，每谈文字禅，必高踞最上乘，或谓～，折朱云角，洵无多焉。","book":"清·王韬《淞隐漫录·二十四花史下》"}},{"id":14093,"word":"夺眶而出","pinyin":"duó kuàng ér chū","abbr":"dkec","explanation":"眶：眼眶。眼泪一下子从眼眶中涌出。形容人因极度悲伤或极度欢喜而落泪。","source":{"text":"两粒大泪珠终于夺眶而出，掉在他的手上。","book":"茅盾《子夜》六"},"example":{"text":"拿手背擦擦～的眼泪，接着他就疯子一样冲向李扯火去。","book":"沙汀《催粮》"},"opposite":["热泪盈眶"],"usage":"作谓语；形容人激动"},{"id":14094,"word":"夺胎换骨","pinyin":"duó tāi huàn gǔ","abbr":"dthg","explanation":"本为道家语，指夺人之胎以转生，易去凡骨为仙骨。后比喻学习前人不露痕迹，并能创新。","source":{"text":"然不易其意而造其语，谓之换骨法；窥入其意而形容之，谓之夺胎法。","book":"宋·释惠洪《冷斋夜话》卷一"},"example":{"text":"安知～无金丹，不使此莲此菊此桃万亿化身合为一。","book":"清·黄遵宪《以莲菊桃杂供一瓶作歌》诗"},"similar":["脱胎换骨"],"usage":"作谓语、定语；比喻学习经验不断创新","story":["夺胎换骨原是道家的说法即吃了金丹换去凡骨凡胎后成仙。古代文人借用以前古文的意思用自己的语言去表达，黄庭坚认为这是换骨法，深入研究古文的原意进一步加以刻划形容，这叫夺胎法。也有人说不蹈古人一言一句，用夺胎换骨法可以点铁成金"]},{"id":14095,"word":"夺锦之才","pinyin":"duó jǐn zhī cái","abbr":"djzc","explanation":"夺锦：相传武则天游龙门，命群臣赋诗，先成者赏锦袍。指科举及第或竞赛优胜者。也用以称赞文才出众或被宠赐。","source":{"text":"武后游洛南龙门，诏从臣赋诗，左史东方虬诗先成，后赐锦袍，之问俄顷献，后鉴之嗟赏，更夺袍以赐。","book":"《新唐书·宋之问传》"}},{"id":14096,"word":"夺锦才","pinyin":"duó jǐn cái","abbr":"djc","explanation":"夺锦：夺锦袍。争夺锦袍的才华。形容才华超群，后来居上。","source":{"text":"之问俄倾献，后览之嗟赏，更夺锦袍以赐。","book":"《新唐书·宋之问传》"},"example":{"text":"被泽徒深厚，渐无～。","book":"明·高启《谢赐衣》"},"usage":"作谓语、宾语；用于口语"},{"id":14097,"word":"夺门而出","pinyin":"duó mén ér chū","abbr":"dmec","explanation":"夺门：破门，奋力冲开门。猛然奋力冲开门出去。形容迫不及待。","source":{"text":"轻轻拨去门闩，拏在手中，预备当作兵器，可以夺门而出。","book":"清·李宝嘉《官场现形记》第31回"},"example":{"text":"他不顾大伙的阻拦，～。"},"opposite":["破门而入"],"usage":"作谓语、状语；形容迫不及待"},{"id":14098,"word":"奄奄一息","pinyin":"yǎn yǎn yī xī","abbr":"yyyx","explanation":"奄奄：呼吸微弱的样子。只剩下一口气。形容临近死亡。","source":{"text":"惠王亲往问疾，见痤病势已重，奄奄一息。","book":"明·冯梦龙《东周列国志》第八十七回"},"example":{"text":"他已被打得体无完肤，～了。"},"similar":["气息奄奄","岌岌可危","命在旦夕"],"opposite":["生龙活虎","生气勃勃","朝气勃勃"],"usage":"作谓语、定语、状语；指临近死亡"},{"id":14099,"word":"奄奄待毙","pinyin":"yǎn yǎn dài bì","abbr":"yydb","explanation":"奄奄：呼吸微弱的样子。形容已临近死亡。","source":{"text":"惠王亲往问疾，见痤病势已重，奄奄一息。","book":"明·冯梦龙《东周列国志》第八十七回"},"example":{"text":"放大镜下，那微小的痛苦异常的人儿，停止了抽搐和扭动，倦卧在纸上，～地喘息着。","book":"梁晓声《尾巴》"}},{"id":14100,"word":"奄然而逝","pinyin":"yǎn rán ér shì","abbr":"yres","explanation":"奄然：忽然。忽然死去。","source":{"text":"比日不知何疾，一夕奄然而逝。","book":"宋·陆九渊《与朱元晦书》"},"usage":"作谓语；用于书面语"},{"id":14101,"word":"奇伎淫巧","pinyin":"qí jì yín qiǎo","abbr":"qjyq","explanation":"淫巧：过于奇巧而无益的。指过于奇巧而无益的技艺与制品。","source":{"text":"去奇伎淫巧，损和璧隋珠不见可欲，使心不乱，自然波清四海，尘消九域。","book":"唐·张庭珪《请勤政崇俭约疏》"},"similar":["奇技淫巧"],"usage":"作宾语、定语；指新奇的技艺和作品"},{"id":14102,"word":"奇光异彩","pinyin":"qí guāng yì cǎi","abbr":"qgyc","explanation":"奇妙的光亮和色彩。","source":{"text":"向里一望，只见是个窈窕洞房，满室奇光异彩，也不辨是金是玉，是花是绣，但觉眼光缭乱而已。","book":"曾朴《孽海花》第12回"},"example":{"text":"只是一到荧光灯下，每一块石头都放出多么美妙的～啊！","book":"华山《大戈壁之夜》"},"usage":"作谓语、宾语；指光亮和色彩"},{"id":14103,"word":"奇冤极枉","pinyin":"qí yuān jí wǎng","abbr":"qyjw","explanation":"奇：罕见的。罕见的冤屈。","source":{"text":"小弟此番大概是奇冤大枉了，你回去替我致意高老先生同秦老先生，不知此后，可能再会了。","book":"清·吴敬梓《儒林外史》第五十回"},"example":{"text":"平日之间既不得赛金花的欢心，今天又受了这样的一番～，越想越气，就萌了个短见的心肠。","book":"清·张春帆《九尾龟》第一百七十六回"},"usage":"作主语、宾语、定语；指罕见的冤屈"},{"id":14104,"word":"奇奇怪怪","pinyin":"qí qí guài guài","abbr":"qqgg","explanation":"指事物或行为稀奇特异。","source":{"text":"欧阳公文章为一代宗师，然藏锋敛锷……不如韩文公之奇奇怪怪。","book":"清·刘熙载《艺概·文概》"},"example":{"text":"清·名教中人《好逑传》第14回：“天下事～，最料不定，再不料无心中救侯孝，倒像有心去救水尚书的一般。”"},"similar":["古古怪怪"],"usage":"作谓语、定语、状语；用于事物或行为等"},{"id":14105,"word":"奇山异水","pinyin":"qí shān yì shuǐ","abbr":"qsys","explanation":"不同一般的，奇异的山水。","source":{"text":"又得见《水经注》，所记奇山异水，或令我惊心动魄，或让我游目骋怀。","book":"朱自清《山野掇拾》"},"usage":"作主语、宾语、定语；指奇异瑰丽的山水"},{"id":14106,"word":"奇庞福艾","pinyin":"qí páng fú ài","abbr":"qpfa","explanation":"庞：大。旧时言人相貌奇伟，多福气。","source":{"text":"临事选将，必訾相其奇庞福艾者遣之。","book":"《新唐书·李勣传》"},"example":{"text":"京师摹写富箱箧，～多王公。","book":"元·蒲道原《闲居丛稿·赠传神李肖岩诗》"},"usage":"作宾语、定语；用于书面语"},{"id":14107,"word":"奇形异状","pinyin":"qí xíng yì zhuàng","abbr":"qxyz","explanation":"奇异的形状。亦作“奇形怪状”。","source":{"text":"须臾，见水族覆灭，奇形异状，或乘车马著赤衣者。","book":"唐·房玄龄《晋书·温峤传》"},"similar":["奇形怪状"],"opposite":["端端正正"],"usage":"作谓语、定语；形容物体的外形"},{"id":14108,"word":"奇形怪状","pinyin":"qí xíng guài zhuàng","abbr":"qxgz","explanation":"不同一般的，奇奇怪怪的形状。","source":{"text":"至牛渚矶，水深不可测，世云其下多怪物，峤遂燃犀角而照之，须臾见水族覆火，奇形异状，或乘马车，著赤衣者。","book":"《晋书·温峤传》"},"example":{"text":"铁索千寻取得来，～谁能识？","book":"唐·吴融《太湖石歌》"},"similar":["怪模怪样","非同寻常"],"opposite":["司空见惯"],"usage":"作谓语、定语；形容物体的外形"},{"id":14109,"word":"奇思妙想","pinyin":"qí sī miào xiǎng","abbr":"qsmx","explanation":"奇妙的想法。","source":{"text":"御妻异制奇观，真堪玩赏，非奇思妙想，不能如此。","book":"明·许仲琳《封神演义》第十七回"}},{"id":14110,"word":"奇情异致","pinyin":"qí qíng yì zhì","abbr":"qqyz","explanation":"致：情趣。奇特的感情，与众不同的情趣。形容奇特怪异的情致和风度。","source":{"text":"若是薛蝌在家，他便抹粉施脂，描眉画鬓，奇情异致的打扮收拾起来。","book":"清·曹雪芹《红楼梦》第100回"},"usage":"作宾语、状语；用于情趣"},{"id":14111,"word":"奇想天开","pinyin":"qí xiǎng tiān kāi","abbr":"qxtk","explanation":"形容想法非常奇怪，不切实际。","source":{"text":"宝玉天地灵淑之气，只钟于女子一论，奇想天开。","book":"清·周春《红楼梦约评》"},"example":{"text":"从老到死，却更～，要占尽了少年的道路，吸尽了少年的空气。","book":"鲁迅《热风·随感录49》"},"similar":["异想天开"],"usage":"作状语、谓语、定语；含讽刺意味"},{"id":14112,"word":"奇才异能","pinyin":"qí cái yì néng","abbr":"qcyn","explanation":"奇：少见的；异：特别的。指特殊的才智和能力。","source":{"text":"臣愚岂敢不尽情，但今未见有奇才异能。","book":"唐·吴兢《贞观政要·择要》"},"example":{"text":"竟是一个～之辈，路见不平做出来的。","book":"清·文康《儿女英雄传》第11回"},"usage":"作主语、宾语、定语；指人的才能"},{"id":14113,"word":"奇技淫巧","pinyin":"qí jì yín qiǎo","abbr":"qjyq","explanation":"指新奇的技艺和作品。","source":{"text":"作奇技淫巧，以悦妇人。","book":"《尚书·泰誓下》"},"example":{"text":"哪一个肯化三块半洋钱去买这样～的东西。","book":"洪深《香稻米》第一幕"},"similar":["奇伎淫巧"],"usage":"作宾语、定语；指新奇的技艺和作品"},{"id":14114,"word":"奇文共赏","pinyin":"qí wén gòng shǎng","abbr":"qwgs","explanation":"少见的好文章大家一道欣赏。","source":{"text":"奇文共欣赏，疑义相与析。","book":"晋·陶潜《移居》诗"},"example":{"text":"或时闭门对坐一室，～，疑义与析。","book":"明·唐顺之《祭万古斋文》"},"usage":"作谓语、宾语；指共同研究奇特文章"},{"id":14115,"word":"奇文瑰句","pinyin":"qí wén guī jù","abbr":"qwgj","explanation":"瑰：珍奇。优美的文章。","source":{"text":"卓行危论，奇文瑰句。","book":"《元史·胡长孺传》"},"opposite":["废话连篇"],"usage":"作宾语、定语；指好文章"},{"id":14116,"word":"奇正相生","pinyin":"qí zhèng xiāng shēng","abbr":"qzxs","explanation":"正面作战与奇袭相结合。","source":{"text":"奇正相生，如循环之无端，孰能穷之？","book":"《孙子·势篇》"},"example":{"text":"神宗尝访八阵遗法，对曰：“兵无常形，是特～之一法尔。”因为帝论其详。","book":"《宋史·郭逵传》"},"usage":"作谓语、定语；用于军事等"},{"id":14117,"word":"奇珍异宝","pinyin":"qí zhēn yì bǎo","abbr":"qzyb","explanation":"珍异难得的宝物。","source":{"text":"嗟呼，世不乏奇珍异宝，乏识者耳。","book":"宋·胡仔《苕溪渔隐丛话后集·东坡四》"},"example":{"text":"卿既不受职，朕所有黄金白璧，奇珍异宝，惟卿所好。","book":"明·冯梦龙《警世通言·李谪仙醉草吓蛮书》"},"similar":["无价之宝","和璧隋珠"],"opposite":["无足轻重","竹头木屑","平淡无奇"],"usage":"作主语、定语、宾语；指难得的宝物"},{"id":14118,"word":"奇珍异玩","pinyin":"qí zhēn yì wán","abbr":"qzyw","explanation":"奇异罕见的珍宝。","source":{"text":"边远地方，无不来进贡奇珍异玩，名马美姬，尽将来进献。","book":"清·禇人获《隋唐演义》第二十七回"},"similar":["奇珍异宝","异宝奇珍"],"usage":"作主语、定语、宾语；指难得的宝物"},{"id":14119,"word":"奇离古怪","pinyin":"qí lí gǔ guài","abbr":"qlgg","explanation":"犹言希奇古怪。希罕奇特，古里古怪。指极不一般。"},{"id":14120,"word":"奇耻大辱","pinyin":"qí chǐ dà rǔ","abbr":"qcdr","explanation":"奇：异常。极大的耻辱。","source":{"text":"回忆当年的议和，不止丧权失利，实为独立国的奇耻大辱。","book":"清·程道一《鸦片之战演义》"},"example":{"text":"科学家和文学家都遭到了～，有的因受迫害致死。","book":"艾芜《漫谈科学与文学》"},"similar":["胯下之辱","卑躬屈膝"],"opposite":["丰功伟绩","光宗耀祖"],"usage":"作主语、宾语；指极大的耻辱"},{"id":14121,"word":"奇花名卉","pinyin":"qí huā míng huì","abbr":"qhmh","explanation":"奇异名贵的花草。","source":{"text":"月中丹桂天花香细，熬尽了万紫千红，占断了奇花名卉。","book":"明·冯惟敏《桂枝香·赠人》"},"example":{"text":"殿外特造芳林园，搜罗～，珍禽异兽，中凿陂池，编列画舫，每舫贮佳丽数人，教以楫棹越歌。","book":"蔡东蕃《后汉演义》第九十五回"},"similar":["奇花异草","奇花异卉"],"usage":"作宾语、定语；指稀少的东西"},{"id":14122,"word":"奇花异卉","pinyin":"qí huā yì huì","abbr":"qhyh","explanation":"卉：草的总称。原意是指希奇少见的花草。也比喻美妙的文章作品等。","source":{"text":"奇树异草，靡不具植。","book":"北魏·杨衒之《洛阳伽蓝记·白马寺》：“庭列修竹；檐拂高松，奇花异草，骈阗堦砌。”《西京杂记》卷三"},"example":{"text":"奉命前往洛阳，不问权豪势要之家，选拣～，和买花栽子，趁时栽接。","book":"元·白朴《墙头马上》第一折"},"similar":["奇花异草","奇花名卉","奇葩异卉"],"usage":"作宾语、定语；指稀少的东西"},{"id":14123,"word":"奇花异草","pinyin":"qí huā yì cǎo","abbr":"qhyc","explanation":"原意是指希奇少见的花草。也比喻美妙的文章作品等。","source":{"text":"奇树异草，靡不具植。","book":"《西京杂记》卷三"},"example":{"text":"命岸贾于绛州城内，起一座花园，遍求～，种植其中。","book":"明·冯梦龙《东周列国志》第五十回"},"similar":["奇树异草","奇花异卉"],"opposite":["平淡无奇"],"usage":"作宾语、定语；指稀少的东西"},{"id":14124,"word":"奇葩异卉","pinyin":"qí pā yì hùi","abbr":"qpyh","explanation":"珍奇难得的花草。","source":{"text":"奇树异草，靡不具植。","book":"《西京杂记》卷三"},"example":{"text":"在南美洲的亚马逊河丛林中，有许多～。"},"similar":["奇花异草","奇花名卉","异草奇花"],"usage":"作主语、宾语、定语；指难得的花草"},{"id":14125,"word":"奇装异服","pinyin":"qí zhuāng yì fú","abbr":"qzyf","explanation":"奇：新奇的；异：特别的。比一般人衣着式样特异的服装（多含贬义）。","source":{"text":"余幼好此奇服兮，年既老而不衰。","book":"战国·楚·屈原《涉江》"},"example":{"text":"这真和女子非梳头不可的教育，“～”者要抓进警厅去办罪的政治一样离奇。","book":"鲁迅《坟·从胡须说到牙齿》"},"opposite":["素装常服"],"usage":"作主语、定语；指异状"},{"id":14126,"word":"奇请比它","pinyin":"qí qíng bǐ tā","abbr":"qqbt","explanation":"比喻在法律正文以外，另引条文进行判案。","source":{"text":"律令烦多，百有余万言，奇请比它，日以益滋。","book":"《汉书·刑法志》"}},{"id":14127,"word":"奇谈怪论","pinyin":"qí tán guài lùn","abbr":"qtgl","explanation":"奇怪的不合情理的言论。","source":{"text":"乾隆戊申岁，余往汴梁，遇毕秋帆中丞幕中，两眼若漆，奇谈怪论，咸视为异物，无一人与言者。","book":"清·钱泳《履园丛话·耆旧·仲子教授》"},"example":{"text":"对社会上的一些～，我们要有识别能力。"},"similar":["胡言乱语","胡说八道"],"opposite":["义正言辞","不刊之论"],"usage":"作主语、宾语；指不合情理的言论"},{"id":14128,"word":"奇货可居","pinyin":"qí huò kě jū","abbr":"qhkj","explanation":"指把少有的货物囤积起来，等待高价出售。也比喻拿某种专长或独占的东西作为资本，等待时机，以捞取名利地位。","source":{"text":"吕不韦贾邯郸，见（子楚）而怜之，曰：‘此奇货可居。’","book":"《史记·吕不韦列传》"},"example":{"text":"可是他们把票子当做～，非要足了钱不肯放回。","book":"姚雪垠《李自成》第一卷第二十五章"},"similar":["囤积居奇"],"opposite":["宝货难售"],"usage":"作谓语、宾语、定语；指囤积居奇","story":["战国时期，卫国大商人吕不韦到赵国都城邯郸去做生意，碰到在那里做人质的秦国公子异人。他决定做一次一本万利的政治买卖，就先到秦国讨得华阳夫人的欢心，让她认异人为儿子，帮助异人回国成为秦国国君，从而自己当上秦国的丞相"]},{"id":14129,"word":"奇辞奥旨","pinyin":"qí cí ào zhǐ","abbr":"qcaz","explanation":"奇辞：奇妙的文辞；奥旨：深奥的含义。形容文章语言奇丽，含义深厚。","source":{"text":"于是撮其大要，奇辞奥旨著于篇。","book":"唐·韩愈《读仪礼》"},"usage":"作宾语、定语；用于书面语"},{"id":14130,"word":"奇风异俗","pinyin":"qí fēng yì sú","abbr":"qfys","explanation":"奇特的习惯和风俗。","source":{"text":"街头每见奇风异俗。每有女子头顶一件大罩袍，脸前垂一黑色厚纱幔。","book":"郭沫若《苏联纪行·七月十二日》"},"example":{"text":"见韦小宝在席上不提商议何事，也不出言相询，只是听着韦小宝说些罗刹国的～。","book":"金庸《鹿鼎记》第三十七回"},"usage":"作主语、宾语、定语；用于风土人情"},{"id":14131,"word":"奈上祝下","pinyin":"nài shàng zhù xià","abbr":"nszx","explanation":"指畏首畏尾的很为难的样子。","source":{"text":"刚才都在前厅上栽我，我又有些奈上祝下的，只恐娘嫌我嘴长耳大。","book":"明·吴承恩《西游记》第23回"},"usage":"作谓语；用于书面语"},{"id":14132,"word":"奉三无私","pinyin":"fèng sān wú sī","abbr":"fsws","explanation":"奉：奉行；三无私：天无私覆，地无私载，日月无私照。象天地日月那样无私。旧时比喻帝王以天下为公，不谋一己私利。","source":{"text":"奉三无私，以劳天下。","book":"《礼记·孔子闲居》"}},{"id":14133,"word":"奉为圭璧","pinyin":"fèng wéi guī bì","abbr":"fwgb","explanation":"圭璧：玉器，指非常有价值的东西。尊重有价值的东西。","source":{"text":"余之此言，天下作诗者，当字字奉为圭璧。","book":"清·李慈铭《越缦堂诗话》中卷"},"similar":["奉为珍宝"],"usage":"作谓语；指十分珍重"},{"id":14134,"word":"奉为圭臬","pinyin":"fèng wéi guī niè","abbr":"fwgn","explanation":"奉：信奉；圭：测日影器；臬：射箭的靶子；圭臬：比喻事物的准则。比喻把某些言论或事当成自己的准则。","source":{"text":"此书出，将使海内说经之家奉为圭皋，而因文字音声以求训诂古义之兴有日矣，讵独以存古音布局哉。","book":"清·钱大昕《六书音韵表序》"},"example":{"text":"适应之说，迄今学人犹～。","book":"鲁迅《坟·人之历史》"},"similar":["奉若神明","奉为楷模"],"opposite":["视如草芥","视如敝屣"],"usage":"作谓语；指十分信奉"},{"id":14135,"word":"奉为楷模","pinyin":"fèng wéi kǎi mó","abbr":"fwkm","explanation":"楷：法式；模：模范。把某种事物当作榜样。","source":{"text":"听说刚勇的拳师，决不再打那倒地的敌手，这实足使我们奉为楷模。","book":"鲁迅《坟·论“费厄泼赖”应该缓行》"},"similar":["奉为圭臬"],"opposite":["视如草芥","视如敝屣"],"usage":"作谓语；指把某种事物当作榜样"},{"id":14136,"word":"奉为神明","pinyin":"fèng wéi shén míng","abbr":"fwsm","explanation":"奉：信奉；神明：神灵的总称。像对待神灵那样崇奉。形容对某人或事物极其尊重。","source":{"text":"此是僧尼诱人上门之语，而愚夫愚妇无知，莫不奉为神明。","book":"清·李汝珍《镜花缘》第12回"},"example":{"text":"路遥《平凡的世界》第五卷第25章：“丽丽感到惭愧的是，她现在还把那两个诗人～哩。”"},"similar":["奉如神明","奉若神明"],"usage":"作谓语、定语；指极其尊重"},{"id":14137,"word":"奉为至宝","pinyin":"fèng wéi zhì bǎo","abbr":"fwzb","explanation":"奉：信奉，敬奉；至宝：最珍贵的宝物。敬奉为最珍贵的宝物。","source":{"text":"‘正人君子’也常以这些流言作谈资，扩势力，自造的流言尚且奉为至宝，何况是真出于学校当局者之口的呢。","book":"鲁迅《坟·寡妇主义》"},"similar":["奉为珍宝"],"usage":"作谓语；指敬奉为最珍贵的宝物"},{"id":14138,"word":"奉令唯谨","pinyin":"fèng lìng wéi jǐn","abbr":"flwj","explanation":"奉：敬受；唯：助词，只有；谨：谨慎。指遵守命令，不敢稍有违背。","source":{"text":"有此种种考察，是以小仙奉令唯谨，不敢参差。","book":"清·李汝珍《镜花缘》第一回"},"similar":["奉命唯谨"],"usage":"作谓语、宾语；指小心谨慎服从命令"},{"id":14139,"word":"奉令承教","pinyin":"fèng lìng chéng jiào","abbr":"flcj","explanation":"奉：遵从；承：接受。遵从命令，接受指教。指完全按照别人的命令、意图去办事。","source":{"text":"臣自以为奉令承教，可以免无罪矣，故受命而不辞。","book":"《战国策·燕策二》"},"example":{"text":"至如赵秉钧之妄用佥壬，变生不意，犹不过～者耳。","book":"章炳麟《致袁世凯电》"},"similar":["奉命承教"],"usage":"作谓语；指完全按照别人的命令行事","story":["战国时期，燕昭王重用大将乐毅，让他率军攻占齐国70多座城池，将齐军围困5年之久，由于燕昭王去世，燕惠王中了齐国的反间计，改派大将骑劫代替乐毅。乐毅逃到赵国。兵败后，燕惠王派人去请乐毅，乐毅说他奉令承教已经完成使命而不归"]},{"id":14140,"word":"奉倩神伤","pinyin":"fèng qiàn shén shāng","abbr":"fqss","explanation":"指人丧妻。","source":{"text":"晋·孙盛《晋阳秋》载：荀粲（字奉倩）妻有美色，染病亡，粲不哭神伤，曰：“佳人难再得。”痛悼不已，岁余亦亡。"},"example":{"text":"是秋，中庭桂树忽萎，生妻感病旋殒。生～，安仁抱痛，在内阁中触物生悲，凄然不能成寐。","book":"清·王韬《淞隐漫录》卷十"}},{"id":14141,"word":"奉公不阿","pinyin":"fèng gōng bù ē","abbr":"fgbe","explanation":"汉·刘珍《东观汉记·李恂》：“恂奉公不阿，为宪所奏免。”","source":{"text":"恂奉公不阿，为宪所奏免。","book":"汉·刘珍《东观汉记·李恂》"},"example":{"text":"我喜欢他那～的性格。"},"similar":["刚正不阿","奉公守法"],"opposite":["徇私舞弊"],"usage":"作谓语、定语；指人很刚直"},{"id":14142,"word":"奉公克己","pinyin":"fèng gōng kè jǐ","abbr":"fgkj","explanation":"指严以律己，一心为公。","source":{"text":"[泽]为渑池令，奉公克己。","book":"《东观汉记·周泽传》"},"similar":["克己奉公"],"usage":"作谓语、定语；指一心为公"},{"id":14143,"word":"奉公如法","pinyin":"fèng gōng rú fǎ","abbr":"fgrf","explanation":"奉行公事，遵守法令。","source":{"text":"以君之贵，奉公如法则上下平。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"想俺这为官的，都只要～也啊。","book":"元·无名氏《延安府》第一折"},"similar":["奉公守法"],"usage":"作谓语、定语；指人守法"},{"id":14144,"word":"奉公守法","pinyin":"fèng gōng shǒu fǎ","abbr":"fgsf","explanation":"奉：奉行；公：公务。奉公行事，遵守法令。形容办事守规矩。","source":{"text":"以君之贵，奉公如法则上下平，上下平则国强。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"我们每个人都要～，决不能做违法乱纪的事。"},"similar":["克己奉公","谦洁奉公","安分守己"],"opposite":["贪赃枉法","假公济私","胡作非为"],"usage":"作主语、谓语、定语；指人守法","story":["战国时期，赵国税官赵奢办事公道，执法严明，一次到赵惠文王的弟弟平原君赵胜家去收田税，平原君的管家仗势欺人，带头抗税，被赵奢杀掉。平原君不服，赵奢给他讲法制的重要性，平原君深受感动，就把赵奢推荐给赵惠文王重用"]},{"id":14145,"word":"奉公正己","pinyin":"fèng gōng zhèng jǐ","abbr":"fgzj","explanation":"奉行公事严格地约束自己。","source":{"text":"机方直之心，久而弥厉，奉公正己，为时所称。","book":"《魏书·高道穆传》"},"similar":["奉公克己"],"usage":"作谓语、宾语；指人严格要求自己"},{"id":14146,"word":"奉命唯谨","pinyin":"fèng mìng wéi jǐn","abbr":"fmwj","explanation":"奉命：接受命令；唯：只有；谨：小心谨慎。指服从命令，小心谨慎。","source":{"text":"诸官奉命唯谨。","book":"明·陶宗仪《辍耕录》卷十五"},"similar":["奉令唯谨"],"usage":"作谓语、宾语；指小心谨慎服从命令"},{"id":14147,"word":"奉命惟谨","pinyin":"fèng mìng wéi jǐn","abbr":"fmwj","explanation":"形容严格遵照命令行事，不敢稍有违背。","source":{"text":"东阳皆奉命惟谨。","book":"明·李东阳《先考赠少傅府君诰命碑阴记》"},"example":{"text":"李斯、夏无且及卫士长等均～。","book":"郭沫若《高渐离》第三幕"},"similar":["唯命是从"],"usage":"作谓语；指严格遵守命令行事"},{"id":14148,"word":"奉命承教","pinyin":"fèng mìng chéng jiào","abbr":"fmcj","explanation":"奉：敬受；承教：接受教诲。指奉行命令，接受教诲。","source":{"text":"臣自以为奉命承教，可以幸无罪矣，故受命而不辞。","book":"西汉·刘向《战国策·燕策》"},"example":{"text":"其中有不合于～，一味服从之意者，则任意删节，或曲为解说，以养成其盲从之性。","book":"孙中山《伦敦被难记》"},"similar":["奉令承教"],"usage":"作谓语、宾语；用于口语"},{"id":14149,"word":"奉天承运","pinyin":"fèng tiān chéng yùn","abbr":"ftcy","explanation":"奉：遵照；奉天：遵从天意，指皇帝受命于天；承运：继承新生的气运。指君权神授。封建帝王诏书开头的套语。","source":{"text":"太祖奉天二字，实千古独见，万世不可易。以故神训中云：皇帝所执大圭，上镂‘奉天法祖’四字。……臣下诰敕命中，必首云‘奉天承运皇帝’。","book":"明·沈德符《野获编·更正殿名》"},"example":{"text":"古代皇帝的诏书都是以“～，皇帝诏曰：”开头的。"},"usage":"作分句；用于古代皇帝的诏书开头"},{"id":14150,"word":"奉头鼠窜","pinyin":"fèng tóu shǔ cuàn","abbr":"ftsc","explanation":"奉：捧。抱着头，象老鼠那样惊慌逃跑。形容受到打击后狼狈逃跑。","source":{"text":"始常山王、成安君故相与为刎颈之交，及争张黡、陈释之事，常山王奉头鼠窜，以归汉王。","book":"《汉书·蒯通传》"},"example":{"text":"身为国家重臣，不能以身排患难，但要～，将何原则上见天下士乎？","book":"《大宋宣和遗事·利集》"},"similar":["抱头鼠窜"],"opposite":["趾高气扬"],"usage":"作谓语；指狼狈的样子"},{"id":14151,"word":"奉如圭臬","pinyin":"fèng rú guī niè","abbr":"frgn","explanation":"圭：测日影器；臬：圭上南北两端的标杆。指尊崇信奉某人或事物，并且作为自己的准则。","source":{"text":"我治军向来注重养廉养耻，‘扬善于公厅，归过于私室’的明教奉如圭臬。","book":"冯玉祥《我的生活》第22章"},"similar":["奉为圭臬"],"usage":"作谓语；指十分信奉"},{"id":14152,"word":"奉如神明","pinyin":"fèng rú shén míng","abbr":"frsm","explanation":"象对待神灵那样崇奉。形容对某人或某种事物极其尊重。","source":{"text":"语出《左传·襄公十四年》“敬之如神明”。"},"example":{"text":"这件事荒唐得很！这么一条小蛇，怎么把他～起来？","book":"《二十年目睹之怪现状》第六八回"},"similar":["奉若神明","奉为神明"],"usage":"作谓语、定语；指极其尊重"},{"id":14153,"word":"奉扬仁风","pinyin":"fèng yáng rén fēng","abbr":"fyrf","explanation":"奉扬：颂扬；仁风：施行仁政如同风行。旧时用作颂扬德政。","source":{"text":"时闲皆集，安欲以卒迫试之，临别执其手，顾就左右一扇而授之曰：‘聊以赠行。’宏应声答曰：‘辄当奉扬仁风，慰此黎庶。’","book":"《晋书·袁宏传》"},"usage":"作谓语、宾语；用作颂扬德政"},{"id":14154,"word":"奉申贺敬","pinyin":"fèng shēn hè jìng","abbr":"fshj","explanation":"送礼单上的套语，以表达敬贺之意。","source":{"text":"若不得已，则割三头两省之土地，奉申贺敬，以换我几个衙门。","book":"梁启超《饮冰室合集·文集》"},"usage":"作分句；客套语"},{"id":14155,"word":"奉若神明","pinyin":"fèng ruò shén míng","abbr":"frsm","explanation":"奉：信奉；神明：神。崇拜得象迷信者敬神那样。形容对某些人或事物的盲目尊重。","source":{"text":"敬之如神明。","book":"《左传·襄公十四年》"},"example":{"text":"这件事荒唐得很！这么一条小蛇，怎么把它～起来？","book":"清·吴趼人《二十年目睹之怪现状》第六十八回"},"similar":["奉为圭臬","顶礼膜拜"],"opposite":["视如草芥","视如敝屣"],"usage":"作谓语、定语；指极其尊重","story":["东汉时期，樊英精通《五经》和术数，隐居于壶山南面，很多人去拜他为师，他对官府的征召不予理睬，汉顺帝以礼征召他。他才不得不来京城洛阳，顺帝为他设坛席，对他奉若神明，任他为光禄大夫，可惜他为官并没什么政绩"]},{"id":14156,"word":"奉行故事","pinyin":"fèng xíng gù shì","abbr":"fxgs","explanation":"奉行：遵照办理；故事：老规矩、老章程。按照老规矩办事。","source":{"text":"相明《易经》有师法，好观汉故事及便宜章奏，以为古今异制，方今务在奉行故事而已。","book":"《汉书·魏相传》"},"example":{"text":"这起公事到了警察局，伯珍也不免～，吩咐局里的警兵。","book":"清·李宝嘉《官场现形记》第十回"},"usage":"作谓语；指按照老规矩办事"},{"id":14157,"word":"奉辞伐罪","pinyin":"fèng cí fá zuì","abbr":"fcfz","explanation":"指奉严正之辞而讨有罪。","source":{"text":"《书·大禹谟》；“肆予以尔众士，奉辞伐罪。”伐，一本作“罚”。"},"example":{"text":"我今～，拯溺苏枯。","book":"宋·岳飞《奉诏移伪齐檄》"},"similar":["奉辞罚罪"],"usage":"作谓语；指讨伐有罪的人"},{"id":14158,"word":"奉辞罚罪","pinyin":"fèng cí fá zuì","abbr":"fcfz","explanation":"奉：敬受；罚：处罚，惩罚。遵奉严正之辞讨伐有罪者。","source":{"text":"奉帝之辞，罚苗之罪。","book":"《尚书·大禹谟》：“肆予以尔众士，奉辞伐罪。”蔡沈集传"},"similar":["奉辞伐罪"],"usage":"作谓语；指讨伐有罪的人"},{"id":14159,"word":"奉道斋僧","pinyin":"fèng dào zhāi sēng","abbr":"fdzs","explanation":"奉道：信奉道教，泛指佛道；斋僧：施舍僧人饭食。信仰道教行善事。","source":{"text":"我也曾奉道斋僧，敬老怜贫，念寡恤孤。","book":"明·无名氏《锁白猿》第三折"},"usage":"作谓语、宾语；用于信教"},{"id":14160,"word":"奋不虑身","pinyin":"fèn bù lǜ shēn","abbr":"fbls","explanation":"奋：振作精神，鼓起干劲。指勇往直前，不顾个人安危。","source":{"text":"汝愚独能奋不虑身，定大计于顷刻。","book":"《宋史·赵汝愚传论》"},"similar":["奋不顾身","奋不虑命","奋身不顾"],"usage":"作谓语、定语、状语；指勇往直前"},{"id":14161,"word":"奋不顾命","pinyin":"fèn bù gù mìng","abbr":"fbgm","explanation":"犹奋不顾身。","source":{"text":"或殉节感恩，奋不顾命；或临戎对敌，赴难如归。","book":"《魏书·魏出帝纪》"},"example":{"text":"故司州刺史蔡道恭率励义勇，～。","book":"南朝·梁·任昉《奏弹曹景宗》"},"similar":["奋不顾生","奋不顾身","奋不虑身"],"usage":"作谓语、定语、状语；指勇往直前"},{"id":14162,"word":"奋不顾生","pinyin":"fèn bù gù shēng","abbr":"fbgs","explanation":"奋：振作精神，鼓起干劲。指勇往直前，不顾个人安危。","source":{"text":"常思奋不顾生，以身殉国。","book":"《旧唐书·田弘正传》"},"similar":["奋不顾身","奋不顾命","奋不虑身"],"usage":"作谓语、定语、状语、宾语；指勇往直前"},{"id":14163,"word":"奋不顾身","pinyin":"fèn bù gù shēn","abbr":"fbgs","explanation":"奋勇向前，不考虑个人安危。","source":{"text":"常思奋不顾身以殉国家之急。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"部下弟子，虽不敢谓久经训练，有勇知方，惟大义所在，却是～。","book":"蔡东藩、许廑父《民国通俗演义》第一百十五回"},"similar":["舍生忘死","万死不辞"],"opposite":["畏缩不前","贪生怕死"],"usage":"作谓语、定语、状语；指勇往直前","story":["西汉时期，李陵奉汉武帝之命率兵抗击匈奴，由于寡不敌众，被迫投降匈奴。朝中大臣纷纷指责李陵没有骨气，太史令司马迁认为李陵肯定会奋不顾身为国解难，不到万不得已时不会投降的，司马迁受到酷刑，汉武帝杀了李陵全家"]},{"id":14164,"word":"奋勇争先","pinyin":"fèn yǒng zhēng xiān","abbr":"fyzx","explanation":"奋：振起，发扬。鼓起勇气，冲在最前面。","source":{"text":"时各官兵陆续奔来，奋勇争先，与贼死战。","book":"明·瞿式耜《飞报首功疏》"},"example":{"text":"清·吴璿《飞龙全传》第25回：“一个个摩拳擦掌，～。”"},"similar":["奋勇当先"],"usage":"作谓语、状语；指作表率"},{"id":14165,"word":"奋勇前进","pinyin":"fèn yǒng qián jìn","abbr":"fyqj","explanation":"奋发而努力鼓起勇气朝前方挺进。","source":{"text":"那时军队有一种新气象，官兵之间和军民之间大体上是团结的，奋勇向前的革命精神充满了军队。","book":"毛泽东《和英国记者贝特兰的谈话》"},"example":{"text":"毛泽东《和英国记者贝特兰的谈话》：“那时军队有一种新气象，官兵之间和军民之间大体上是团结的，～的革命精神充满了军队。”"},"similar":["奋勇前进"],"usage":"作谓语、定语；用于处事"},{"id":14166,"word":"奋勇当先","pinyin":"fèn yǒng dāng xiān","abbr":"fydx","explanation":"鼓起勇气，赶在最前面。","source":{"text":"更有俺五百义兵家将，都要的奋勇当先，相持对垒。","book":"《隋书·史祥传》：“公竭诚奋勇，一举克定。”  元·关汉卿《哭存者》第二折"},"example":{"text":"更有俺五百义兵家将，都要的～，相恃对垒。","book":"元·关汉卿《哭存孝》第二折"},"similar":["一马当先","奋勇争先"],"opposite":["畏缩不前"],"usage":"作谓语、状语；指作表率"},{"id":14167,"word":"奋勇直前","pinyin":"fèn yǒng zhí qián","abbr":"fyzq","explanation":"奋：振起。勇气十足地直往前冲。形容在艰巨的任务或困难前不畏缩。","source":{"text":"若有驱使，奋勇直前，水火不避。","book":"明·冯梦龙《醒世恒言》第35卷"},"similar":["奋勇前进"],"usage":"作谓语、状语；用于人处事"},{"id":14168,"word":"奋发向上","pinyin":"fèn fā xiàng shàng","abbr":"ffxs","explanation":"精神振作，情绪高昂。","source":{"text":"在各条战线上形成你追我赶、争当先进、奋发向上的风气。","book":"邓小平《解放思想，实事求是，团结一致向前看》"},"example":{"text":"王朔《玩儿的就是心跳》：“那个导演正在为自己的一部描写～女青年的片子选演员。”"},"usage":"作定语、状语；用于人的精神状况"},{"id":14169,"word":"奋发图强","pinyin":"fèn fā tú qiáng","abbr":"fftq","explanation":"图：谋求。振作精神，以求强盛。","source":{"text":"我祝愿中年一代的科学工作者奋发图强，革命加拼命，勇攀世界科学高峰。","book":"郭沫若《科学的春天》"},"example":{"text":"年青人要～，为祖国的建设出力。"},"similar":["发愤图强","奋发有为"],"opposite":["自暴自弃"],"usage":"作谓语、状语、定语；指人的精神状态","story":["西汉时，司马迁游遍了祖国的文化古迹，积累了许多史料素材，作为太史令，开始编撰《史记》。因李陵案发受牵连入狱，受宫刑。他出狱后，忍受巨大的精神与肉体的折磨，经过不懈的努力，终于完成130篇的巨著《史记》"]},{"id":14170,"word":"奋发有为","pinyin":"fèn fā yǒu wéi","abbr":"ffyw","explanation":"奋发：精神振作。精神振作，有所作为。","source":{"text":"勇气奋发，性自然也。","book":"汉·王充《论衡·初禀篇》"},"example":{"text":"汉·王充《论衡·初禀篇》：“勇气奋发，性自然也。”"},"similar":["发愤图强","奋发图强"],"opposite":["自暴自弃"],"usage":"作谓语、定语；指人的精神"},{"id":14171,"word":"奋发踔厉","pinyin":"fèn fā chuō lì","abbr":"ffcl","explanation":"奋发有为，意气昂扬。","source":{"text":"议论证据今古，出入经史百子，踔厉风发，率常屈其座人。","book":"语出唐·韩愈《柳子厚墓志铭》"},"example":{"text":"既无始皇～之才，而当众叛亲离之日，谓足以全首领而保宗庙，无论谁人，俱不能为扶苏信也。","book":"清·陈天华《中国革命史论》二"},"similar":["奋发蹈厉","蹈厉奋发"],"usage":"作谓语、定语；指人的精神面貌"},{"id":14172,"word":"奋发蹈厉","pinyin":"fèn fā dǎo lì","abbr":"ffdl","explanation":"奋：振作；发：激励；蹈：踩，引申为做，实行；厉：猛烈，迅疾。精神振奋，行动迅猛。","source":{"text":"议论证据今古，出入经史百子，踔厉风发，率常屈其座人。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"且有整千整百的女青年～地走出家庭，奔赴前线，不让男同胞专美。","book":"邹韬奋《抗战以来·自动奋发的千万青年》"},"similar":["蹈厉奋发"],"usage":"作谓语；指人的精神面貌"},{"id":14173,"word":"奋武扬威","pinyin":"fèn wǔ yáng wēi","abbr":"fwyw","explanation":"振奋勇气，施展威风。","source":{"text":"[姜维]奋武扬威，杀入魏军之中，左冲右突，魏兵大乱。","book":"《三国演义》第一一○回"},"example":{"text":"分付大小三军，一齐～，杀上前去。","book":"清·李渔《慎鸾交·穷追》"},"usage":"作谓语、定语；指人的精神"},{"id":14174,"word":"奋矜之容","pinyin":"fèn jīn zhī róng","abbr":"fjzr","explanation":"矜：自以为是；容：态度。自我认为比别人有能力的一种骄傲表现。","source":{"text":"有兼听之明，而无奋矜之容；有兼覆之厚，而无伐德之色。","book":"《荀子·正名》"},"usage":"作宾语；用于人的神情"},{"id":14175,"word":"奋矜伐德","pinyin":"fèn jīn fá dé","abbr":"fjfd","explanation":"奋矜：竞相夸耀；伐德：自夸其德。指骄傲自大，夸耀不实。","source":{"text":"有兼听之明，而无奋矜之容；有兼覆之厚，而无伐德之色。","book":"《荀子·正名》"}},{"id":14176,"word":"奋笔疾书","pinyin":"fèn bǐ jí shū","abbr":"fbjs","explanation":"奋笔：提起笔来。指精神昂扬地挥笔快速书写。","source":{"text":"或隐匿未彰，而奋笔疾书；或一语之乖谬，或一行之谄曲，虽其人之骨已朽，必绳以《春秋》之法，读之使人汗出。","book":"宋·张克庄《题方汝一班师赞后》"},"example":{"text":"世贞昼夜伏案，～，日书一回，不得片刻喘息。","book":"《金瓶梅传奇》第二十七回"},"similar":["秉笔直书"],"usage":"作谓语；指写文章"},{"id":14177,"word":"奋笔直书","pinyin":"fèn bǐ zhí shū","abbr":"fbzs","explanation":"奋笔：提起笔来。指精神昂扬地挥笔快速书写。同“奋笔疾书”。","source":{"text":"贤侄今日，奋笔直书，如行云流水，珠玑错落，俊爽之才，有同健鹰之摩秋汉，真命世杰也，与古人何多让焉，将来正未可量。","book":"清·墨憨斋《醒名花》第十四回"},"example":{"text":"于是那幕友～：“春霆军门雅蜀”，见了的人，无不是想笑不敢笑。","book":"高阳《慈禧全传》十九"}},{"id":14178,"word":"奋翅鼓翼","pinyin":"fèn chì gǔ yì","abbr":"fcgy","explanation":"奋：奋力；鼓：振动。振动羽翼，奋力飞翔。比喻振作有为。","source":{"text":"奋翅鼓翼，翱翔外国。","book":"汉·焦延寿《易林·损》"}},{"id":14179,"word":"奋臂一呼","pinyin":"fèn bì yī hū","abbr":"fbyh","explanation":"奋臂：高举手臂。高举手臂，大声呼喊。","source":{"text":"洞庭、彭蠡，竟非殷固，奋臂一呼，或成汉业。","book":"《魏书·卢玄传》"},"similar":["奋臂大呼"],"usage":"作谓语；指大声呼喊"},{"id":14180,"word":"奋臂大呼","pinyin":"fèn bì dà hū","abbr":"fbdh","explanation":"用力地挥舞手臂，情绪激昂地高声呼喊。","source":{"text":"陈涉以戍卒散乱之众数百，奋臂大呼。","book":"《史记·秦始皇本纪》"},"similar":["奋臂一呼","振臂一呼"],"usage":"作谓语；指大声呼喊","story":["秦朝末年，统治阶级的残暴统治造成民不聊生。陈涉吴广奋臂大呼，其他豪杰蜂拥而起，起义军推翻了秦朝的统治。为了争夺胜利果实，项羽与刘邦进行几年的争斗。项羽刚愎自用，仅靠武力统一天下，被刘邦围困在乌江边自刎而死"]},{"id":14181,"word":"奋袂攘襟","pinyin":"fèn mèi rǎng jīn","abbr":"fmrj","explanation":"奋袂：挥袖；攘襟：撩起衣襟。袖子一挥站起来。形容奋然而起。","source":{"text":"辍食弃餐，奋袂攘祍，抚剑东顾，而心已驰于吴会矣。","book":"三国·魏·曹植《求自试表》"},"example":{"text":"闻吾风声，议其所以，乃～，怒目切齿。","book":"晋·刘伶《酒德颂》"},"usage":"作谓语、状语；用于人很激动"},{"id":14182,"word":"奋袂而起","pinyin":"fèn mèi ér qǐ","abbr":"fmeq","explanation":"奋袂：挥袖。袖子一挥站起来。形容奋然而起。","source":{"text":"辍食弃餐，奋袂攘祍，抚剑东顾，而心已驰于吴会矣。","book":"三国·魏·曹植《求自试表》"},"example":{"text":"庄王方进午膳，闻申舟见杀，投箸于席，～。","book":"明·冯梦龙《东周列国志》第五十五回"},"similar":["投袂而起"],"usage":"作谓语；形容愤怒或激动","story":["春秋时期，楚穆王联合陈、郑、蔡三国进攻宋国。宋昭公只好投降。楚穆王神气活现指使宋昭公干这干那。楚穆王死，楚庄王即位，派大夫申舟不必向宋国借道到齐国去办事，宋国杀了申舟，楚庄王气得浑身发抖，投袂而起集结军队攻打宋国"]},{"id":14183,"word":"奋起直追","pinyin":"fèn qǐ zhí zhuī","abbr":"fqzz","explanation":"振作起来，紧紧赶上去。","source":{"text":"义无反顾，惟有群策群力，奋起直追，迅电华会代表，坚持原案。","book":"蔡东藩《民国通俗演义》第129回"},"example":{"text":"我们要～，决不落后。"},"similar":["急起直追"],"opposite":["踌躇不前","得过且过"],"usage":"作谓语、定语、状语；指赶超"},{"id":14184,"word":"奋身不顾","pinyin":"fèn shēn bù gù","abbr":"fsbg","explanation":"犹奋不顾身。","source":{"text":"愚夫小人，以一言感发，犹能奋身不顾，以遂其言。","book":"宋·苏轼《与章子厚书》"},"example":{"text":"三朝充谏诤之官，～。","book":"宋·秦观《贺孙中丞启》"},"similar":["奋不顾身","奋不顾命","奋不顾生"],"usage":"作谓语、定语、状语；指勇往直前"},{"id":14185,"word":"奋身独步","pinyin":"fèn shēn dú bù","abbr":"fsdb","explanation":"独步：独一无二，无可比拟。指努力去出人头地。","source":{"text":"脱白衣平步上云衢，高尘途奋身独步。","book":"元·郑德辉《伊尹耕萃》第四折"},"usage":"作谓语、定语；多用于人的理想"},{"id":14186,"word":"奋飞横绝","pinyin":"fèn fěi hèng jué","abbr":"ffhj","explanation":"绝：越。鸟儿振翅高飞，横空绝远。比喻人奋发有为，志向远大。","source":{"text":"奋飞横绝，搏空直上。","book":"唐·张说《拨川郡王碑》"}},{"id":14187,"word":"契合金兰","pinyin":"qì hé jīn lán","abbr":"qhjl","explanation":"契合：投合；金兰：指朋友。比喻朋友交情深厚。","source":{"text":"二人同心，其利断金；同心之言，其臭如兰。","book":"《周易·系辞上》"},"example":{"text":"自合与老爷情投胶膝，～。","book":"明·汪廷讷《狮吼记·赏春》"},"similar":["契若金兰"],"usage":"作谓语、定语；比喻交情很深"},{"id":14188,"word":"契船求剑","pinyin":"qì chuán qiú jiàn","abbr":"qcqj","explanation":"比喻拘泥成法，不知变通。后多作“刻舟求剑”。","source":{"text":"楚人有涉江者，其剑自舟中坠于水，遽契其舟，曰：‘是吾剑之所从坠。’舟止，从其所契者入水求之。舟已行矣，而剑不行。求剑若此，不亦惑乎！","book":"语本《吕氏春秋·察今》"},"example":{"text":"世易俗异，事执舛殊，不能通其变，而一度以揆之。斯契船而求剑，守株而伺兔也。","book":"《后汉书·张衡传》"},"similar":["刻舟求剑"],"opposite":["见机行事"],"usage":"作谓语、定语、状语；指头脑不灵活","story":["战国时期，一个楚国人坐船渡长江，船行至江山时他不小心将身上佩带的宝剑掉到水中，但没能及时抓住，于是就在掉剑的地方船舷作了一个记号，船靠岸后就在刚做记号的地方下水去摸他的宝剑，结果一无所获"]},{"id":14189,"word":"契若金兰","pinyin":"qì ruò jīn lán","abbr":"qrjl","explanation":"比喻朋友交情深厚。","source":{"text":"山公与嵇、阮一面，契若金兰。","book":"《周易·系辞上》：“二人同心，其利断金；同心之言，其臭如兰。”南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"世间多少口头交，无情汉，饮酒宴乐，～；患难死生，视同陌路。","book":"明·清溪道人《禅真逸史》第二十二回"},"similar":["契合金兰"],"usage":"作谓语、定语；比喻交情很深"},{"id":14190,"word":"奔播四出","pinyin":"bēn bō sì chū","abbr":"bbsc","explanation":"播：迁徙，流亡。到处奔波转徒。","source":{"text":"往者上国丧乱，莫不奔播四出。","book":"《抱朴子·金丹》"}},{"id":14191,"word":"奔流不息","pinyin":"bēn liú bù xī","abbr":"blbx","explanation":"形容水急速地、不停地流动。也比喻时光等不停地消逝。","similar":["白驹过隙","逝者如斯"]},{"id":14192,"word":"奔竞之士","pinyin":"bēn jìng zhī shì","abbr":"bjzs","explanation":"奔竞：奔走竞争，形容一味追名逐利的人。","source":{"text":"悠悠风尘，皆奔竞之士；列官千百，无让贤之举。","book":"晋·干宝《晋纪·总论》"}},{"id":14193,"word":"奔腾澎湃","pinyin":"bēn téng péng pài","abbr":"btpp","explanation":"奔腾：飞奔疾驰；澎湃：波涛冲击声。形容声势极大。","source":{"text":"中间一道大溜，却仍奔腾澎湃，有声有势。","book":"清·刘鹗《老残游记》第12回"},"similar":["汹涌澎湃"],"opposite":["风平浪静"],"usage":"作谓语、定语；用于水或声势等"},{"id":14194,"word":"奔走之友","pinyin":"bēn zǒu zhī yǒu","abbr":"bzzy","explanation":"指彼此尽力相助的挚友。","source":{"text":"袁绍慕之，私与往来，结为奔走之友。","book":"《后汉书·党锢传·何顒》"},"example":{"text":"炀帝尽欲诛其诸子，君绰忧惧连诛，因与秀才罗巡、罗逖、李万进结为～，共亡命至海州。","book":"唐·牛僧孺《玄怪录·来君绰》"},"usage":"作宾语；指朋友"},{"id":14195,"word":"奔走呼号","pinyin":"bēn zǒu hū háo","abbr":"bzhh","explanation":"奔走：奔跑。呼号：叫喊。一面奔跑，一面呼唤。形容处于困境而求援。","source":{"text":"守土官帅其吏民奔走呼号，维是祈祷告请，亦无不至矣，而犹雨泽未应，旱烈益张。","book":"明·王守仁《王文成公全书·南镇祷雨文》卷二十五"},"example":{"text":"勇敢的国民，一经览到二十一条件，群以为亡国惨兆，就在目前，于是～，力图挽救。","book":"蔡东藩、许廑父《民国通俗演义》第四十二回"},"usage":"作谓语；指引起人们的注意"},{"id":14196,"word":"奔走如市","pinyin":"bēn zǒu rú shì","abbr":"bzrs","explanation":"走：跑。市：集市。形容为某种目的而奔忙、活动的人很多。","source":{"text":"由是不肖之人，奔走如市，科道衙门，皆其心腹牙爪。","book":"《古今小说·沈小霞相会出师表》"},"usage":"作谓语、定语；指人很多"},{"id":14197,"word":"奔走相告","pinyin":"bēn zǒu xiāng gào","abbr":"bzxg","explanation":"指有重大的消息时，人们奔跑着相互转告。","source":{"text":"士有陪乘，告奔走也。","book":"《国语·鲁语下》"},"example":{"text":"于是群情惊疑，～，以为又将重演十年前之惨剧。","book":"毛泽东《向国民党的十点要求》"},"similar":["欣喜若狂","乐不可支"],"opposite":["面如土色","呆若木鸡"],"usage":"作谓语、补语；用于互相转告重要消息","story":["春秋时期，晋、楚等11国派出高级官员到虢国会盟，楚使熊虔的仪仗非常气派，远远超出了当时出巡的标准，天子出巡才有“虎贲”百人，而最低的士人出巡只有“陪乘”一人，任务是“告奔走”。楚使的行为引起了其他国家使臣的反感"]},{"id":14198,"word":"奔走钻营","pinyin":"bēn zǒu zuān yíng","abbr":"bzzy","explanation":"到处奔波，削尖脑袋谋求私利。","source":{"text":"他虽然是奔走钻营的惯家，然而和新式女太太打交道，还是第一次。","book":"茅盾《动摇》"},"example":{"text":"他很会～的。"},"similar":["挨风缉缝"],"usage":"作谓语、定语、宾语；指人会钻营"},{"id":14199,"word":"奔车朽索","pinyin":"bēn chē xiǔ suǒ","abbr":"bcxs","explanation":"奔：奔驰；朽：腐朽。用已腐朽的绳子去拉奔驰的车辆。比喻事情很危险，应十分警惕。","source":{"text":"怨不在大，可畏惟人。载舟覆舟，所宜深慎，奔车朽索，其可忽乎？","book":"《尚书·五子之歌》：“憻乎若朽索之驭六马。”唐·魏征《谏太宗十思疏》"},"similar":["千钧一发"],"usage":"作宾语、定语；指很危险"},{"id":14200,"word":"奔轶绝尘","pinyin":"bēn yì jué chén","abbr":"byjc","explanation":"形容跑得极快，迅速前进。绝尘，脚不沾尘土。","source":{"text":"见“奔逸绝尘”。"},"example":{"text":"章太炎却“自崖而返”，退居于宁静的学者，鲁迅则～，“自此远矣”。","book":"宋云彬《因纪念鲁迅而想到章太炎》"},"similar":["奔逸绝尘"],"usage":"作谓语、定语；形容跑得很快"},{"id":14201,"word":"奔逸绝尘","pinyin":"bēn yì jué chén","abbr":"byjc","explanation":"奔逸：疾驰；绝尘：脚不沾尘土。形容走得极快。也形容人才十分出众，无人企及。","source":{"text":"夫子奔逸绝尘，而回瞠若乎其后矣。","book":"《庄子·田子方》"},"similar":["奔轶绝尘"],"usage":"作谓语、定语；形容跑得很快"},{"id":14202,"word":"奕奕欲生","pinyin":"yì yì yù shēng","abbr":"yyys","explanation":"奕奕：精神焕发的样子。指艺术形象非常逼真，如同活的一样。","source":{"text":"杭州城内外梵宇以百数，为西湖之净慈、灵隐两寺有五百罗汉堂。金姿宝相，奕奕欲生。","book":"清·梁章钜《浪迹续谈·五百罗汉堂》"}},{"id":14203,"word":"奖拔公心","pinyin":"jiǎng bá gōng xīn","abbr":"jbgx","explanation":"奖：劝勉，夸奖；拔：选拔，提升。奖励和提拔出于公心。","source":{"text":"李封州甘为文至精，奖拔公心，亦类数公。","book":"宋·王谠《唐语林·文学》"},"usage":"作谓语、宾语；指用人"},{"id":14204,"word":"奖罚分明","pinyin":"jiǎng fá fēn míng","abbr":"jffm","explanation":"该奖的奖，该罚的罚。形容处理事情清楚明白。","source":{"text":"要有奖有罚，奖罚分明。","book":"邓小平《坚持按劳分配原则》"},"example":{"text":"为人主管者必须公正无私，～，才能树立良好的纪律，使众人信服。"},"similar":["赏罚分明"],"usage":"作谓语、定语；指处理问题界限分明"},{"id":14205,"word":"套头裹脑","pinyin":"tào tóu guǒ nǎo","abbr":"ttgn","explanation":"比喻很多事情纠缠在一起，分辨不清。形容十分周密不露破绽。","source":{"text":"这桩套头裹脑的事，这段含着骨头露着肉的话。","book":"清·文康《儿女英雄传》第23回"},"usage":"作谓语、定语；形容事情"},{"id":14206,"word":"套言不叙","pinyin":"tào yán bù xù","abbr":"tybx","explanation":"套言：客套话。套话不多说了。","source":{"text":"敬启者：彼此至好，套言不叙。","book":"清·文康《儿女英雄传》第38回"},"similar":["套言不陈"],"usage":"作谓语、宾语；用于书信等"},{"id":14207,"word":"套言不陈","pinyin":"tào yán bù chén","abbr":"tybc","explanation":"套言：客套话；陈：陈述。套话不多说了。","source":{"text":"九娃拿了一封书，递于绍闻，书上写道：‘字启谭大哥下入目。兹启者，套言不陈。’","book":"清·李绿园《歧路灯》第24回"},"example":{"text":"我们都是老朋友，～，就此打止吧。"},"similar":["套言不叙"],"usage":"作谓语、宾语；用于书信等"},{"id":14208,"word":"套近乎","pinyin":"tào jìn hū","abbr":"tjh","explanation":"指用言语或送礼拉近关系。","source":{"text":"‘别，别跟我套近乎。’马青皱着脸摇手，盯着于观难过地说，‘哥儿们你太不够意思了。’","book":"王朔《一点正经没有》"},"example":{"text":"你别想跟我～。"},"usage":"作谓语、宾语；用于口语"},{"id":14209,"word":"奢者心常贫","pinyin":"shé zhě xīn chnág pín","abbr":"szxcp","explanation":"好奢侈的人经常感到不满足。","source":{"text":"奢者富不足，俭者贫有余，奢者心常贫，俭者心常富。","book":"南唐·谭峭《谭子化书·俭化》"}},{"id":14210,"word":"奥妙无穷","pinyin":"ào miào wú qióng","abbr":"amwq","explanation":"奥：深奥。指其中不易为人所知而奇妙有趣之处极多。","source":{"text":"化装袭击的运用奥妙无穷……有时化装日军袭击伪军，有时化装伪军袭击日军。","book":"杨成武《层层火阵烧野牛》"},"example":{"text":"事物的变化真是～。"},"similar":["变化莫测"],"opposite":["一成不变","一定之规"],"usage":"作谓语、定语、宾语；形容人或物变化莫测"},{"id":14211,"word":"奥援有灵","pinyin":"ào yuán yǒu líng","abbr":"ayyl","explanation":"奥援：暗中支持的力量；有灵：有神通。多指旧时官场的钻营、勾结，暗通关节，很有神通。","source":{"text":"皆大慝巨奸，或燕处于园亭，或潜藏于京邸，奥援有灵，朝廷无法。","book":"明·文秉《先拨志始》卷下"},"usage":"作谓语；用于事物及人际关系"},{"id":14212,"word":"女中丈夫","pinyin":"nǚ zhōng zhàng fū","abbr":"nzzf","explanation":"指女子中有男子气概的人。","source":{"text":"虽说你是个女中丈夫，是你去毕竟停当。只是万里程途，路上恐怕不便。","book":"明·凌濛初《二刻拍案惊奇》卷十七"},"example":{"text":"世言～，犹知非丈夫也，妇并忘其为巾帼矣。","book":"清·蒲松龄《聊斋志异·农妇》"},"similar":["女中豪杰"],"usage":"作宾语、定语；用于夸奖女性"},{"id":14213,"word":"女中尧舜","pinyin":"nǚ zhōng yáo shùn","abbr":"nzys","explanation":"尧舜：传说中的上古贤明君主。妇女中的贤明人物。古代多称颂执政的女王。","source":{"text":"自是内降遂绝，力行故事，抑绝外家私恩。文思院奉上之物，无问巨细，终身不取其一。人以为女中尧舜。","book":"《宋史·英宗宣仁圣烈高皇后传》"},"example":{"text":"国母真是～，事事达礼。竟从懿旨便了。","book":"清·陈忱《水浒后传》第三十九回"},"similar":["女中丈夫","女中豪杰"],"usage":"作宾语、定语；指执政的女王"},{"id":14214,"word":"女中豪杰","pinyin":"nǚ zhōng háo jié","abbr":"nzhj","explanation":"豪杰：指才能出众的人。女性中的杰出人物。","source":{"text":"十娘钟情所欢，不以贫寠易心，此乃女中豪杰。","book":"明·冯梦龙《警世通言》卷三十二"},"example":{"text":"过学士儿子百般用计求他，他有本事百般拒绝，又是个～，正好与中玉作配。","book":"明·名教中人《好逑传》第十四回"},"similar":["女中丈夫"],"opposite":["女流之辈"],"usage":"作宾语、定语；用于夸奖女性"},{"id":14215,"word":"女大不中留","pinyin":"nǚ dà bù zhòng liú","abbr":"ndbzl","explanation":"指女子成年，须及时出嫁，不宜久留在家。","source":{"text":"休疙皱，常言道：‘女大不中留。’","book":"金·董解元《西厢记诸宫调》卷六"},"example":{"text":"夫人得好休，便好休，这其间何必苦追求？常言道“～”。","book":"元·王实甫《西厢记》第四本第二折"},"similar":["女大难留"],"usage":"作宾语、定语；指女大须嫁"},{"id":14216,"word":"女大十八变","pinyin":"nǚ dà shí bā biàn","abbr":"ndsbb","explanation":"指女子在发育成长过程中，容貌性格有较多的变化。","source":{"text":"龙女有十八变，汝与老僧试一变看。","book":"宋·释道原《景德传灯录·幽州谭空和尚》"},"example":{"text":"～。挺秀气的闺女，变得叫人一见心烦。","book":"林斤澜《春雷》"},"usage":"作宾语、分句；指女孩的成长发育"},{"id":14217,"word":"女大当嫁","pinyin":"nǚ dà dāng jià","abbr":"nddj","explanation":"指女子成年后须及时出嫁。同“女长须嫁”。","source":{"text":"男大当婚，女大当嫁，理之当然。","book":"清·陈忱《水浒后传》第三十九回"},"example":{"text":"英台，为父也何尝舍得你离开膝下，怎奈～。","book":"越剧《梁山泊与祝英台》第七场"},"similar":["女大须嫁"],"opposite":["男大当婚"],"usage":"作宾语、定语；指女子到了出嫁的年龄"},{"id":14218,"word":"女大难留","pinyin":"nǚ dà nán liú","abbr":"ndnl","explanation":"指女子成年后，须及时出嫁，不能留在家里。","source":{"text":"夫人你得休便休，也不索出乖弄丑，自古来女大难留。","book":"元·关汉卿《普天乐·崔张十六事》曲"},"similar":["女大不中留"],"usage":"作宾语、定语；指女大须嫁"},{"id":14219,"word":"女大须嫁","pinyin":"nǚ dà xū jià","abbr":"ndxj","explanation":"指女子成年后须及时出嫁。同“女长须嫁”。","source":{"text":"国太曰：‘男大须婚，女大须嫁，古今常理。’","book":"明·罗贯中《三国演义》第五十四回"},"example":{"text":"明·罗贯中《三国演义》第五十四回：“国太曰：‘男大须婚，女大须嫁，古今常理。’”"},"similar":["女长须嫁","女大当嫁"],"usage":"作定语、分句；指女子成年时"},{"id":14220,"word":"女娲补天","pinyin":"nǚ wā bǔ tiān","abbr":"nwbt","explanation":"神话故事，伏羲的妹妹女娲炼五色石补天。形容改造天地的雄伟气魄和大无畏的斗争精神。","source":{"text":"于是女娲炼五色石以补苍天。","book":"西汉·刘安《淮南子·览冥训》"},"example":{"text":"传说雨花石是～留下的石头。"},"similar":["炼石补天"],"usage":"作主语、定语；形容改造天地的雄伟气魄","story":["传说盘古开天用四根“不周山”大柱子支撑天地，共工与颛顼争夺帝位将不周山撞倒，天地裂了一条大缝，女娲氏在高山上架起神火，炼了36501块五彩石把天的裂缝补了起来，砍大鳌腿支撑天，从此天地就永久牢固了"]},{"id":14221,"word":"女子无才便是德","pinyin":"nǚ zǐ wú cái biàn shì dé","abbr":"nzwcbsd","explanation":"旧道德规范认为妇女无须有才能，只需顺从丈夫就行。","source":{"text":"眉公曰：‘丈夫有德便是才，女子无才便是德。’此语殊为未确。","book":"清·张岱《公祭祁夫人文》"},"example":{"text":"一位女士说女子也应该读书，痛辟～的谬论。","book":"冯玉祥《我的生活》第37章"},"similar":["女子无才便是福"],"usage":"作宾语、定语、分句；用于说教"},{"id":14222,"word":"女子无才便是福","pinyin":"nǚ zǐ wú cái biàn shì fú","abbr":"nzwcbsf","explanation":"旧道德规范认为妇女无须有才能，只需顺从丈夫就行。","source":{"text":"昔人云：‘女子无才便是福。’然今之闺秀，比比是矣！","book":"清·梁绍壬《两般秋雨庵随笔》第三卷"},"similar":["女子无才便是德"],"usage":"作宾语、定语、分句；用于说教"},{"id":14223,"word":"女扮男妆","pinyin":"nǚ bàn nán zhuāng","abbr":"nbnz","explanation":"女子穿上男装，打扮成男子的模样。","source":{"text":"那黄善聪女扮男妆，千古奇事。","book":"明·冯梦龙《古今小说》第28卷"},"example":{"text":"清·石玉昆《小五义》第116回：“你先见的那个是个大姑娘，～，卧虎沟沙大哥的女儿。”"},"similar":["女扮男妆"],"opposite":["男扮女装"],"usage":"作谓语、宾语、定语；指乔装打扮"},{"id":14224,"word":"女扮男装","pinyin":"nǚ bàn nán zhuāng","abbr":"nbnz","explanation":"女子穿上男装，打扮成男子的模样。","source":{"text":"及至此时，才想起他原是女扮男装。","book":"清·李汝珍《镜花缘》第66回"},"example":{"text":"她喜欢～。"},"similar":["乔装打扮","女扮男妆"],"opposite":["男扮女装"],"usage":"作谓语、宾语、定语；指乔装打扮"},{"id":14225,"word":"女流之辈","pinyin":"nǚ liú zhī bèi","abbr":"nlzb","explanation":"女流：妇女。妇女之流，带轻视的说法。","source":{"text":"好在张太太是女流之辈，尽着由他哄骗。","book":"清·李宝嘉《官场现形记》第51回"},"example":{"text":"你们～懂什么。"},"opposite":["巾帼英雄","女中豪杰"],"usage":"作主语、宾语、定语；指妇女，含轻蔑意"},{"id":14226,"word":"女生外向","pinyin":"nǚ shēng wài xiàng","abbr":"nswx","explanation":"原指女子总归要出嫁的。后也用以指女子心向着夫家。","source":{"text":"男生内向，有留家之意；女生外向，有从夫之意。","book":"汉·班固《白虎通·封公侯》"},"example":{"text":"老爷理他呢！他自来是这么～。","book":"清·文康《儿女英雄传》第三十二回"},"usage":"作宾语、定语；用于生活"},{"id":14227,"word":"女织男耕","pinyin":"nǚ zhī nán gēng","abbr":"nzng","explanation":"封建社会中的小农经济，一家一户经营，男的种田，女的织布。指全家分工劳动。","source":{"text":"男耕女织，不夺其时。","book":"宋·罗泌《路史·后纪十二·夏后氏》"},"example":{"text":"～，桑麻满圃。","book":"明·赵弼《青城隐者记》"},"similar":["男耕女织"],"opposite":["男盗女娼"],"usage":"作主语、定语、宾语；形容辛勤劳动"},{"id":14228,"word":"女貌郎才","pinyin":"nǚ mào láng cái","abbr":"nmlc","explanation":"女子美丽，男子有才华。比喻姻缘十分美满。","source":{"text":"却说李衙内和玉楼，两个女貌郎才，如鱼似水。","book":"元·杨暹《西游记》第三本第九出：“俺什么女貌郎才厮撞着，将父母远乡相抛，雁杳鱼沉没下落。”明·兰陵笑笑生《金瓶梅词话》第九十一回"},"example":{"text":"有的讲究个～，不辞非鸦非凤的，就有讲究个穿衣吃饭，只图一马一鞍的。","book":"清·文康《儿女英雄传》第四十回"},"similar":["郎才女貌"],"usage":"作定语、宾语；指青年男女"},{"id":14229,"word":"女长当嫁","pinyin":"nǚ zhǎng dāng jià","abbr":"nzdj","explanation":"犹女大当嫁。指女子成年后须及时出嫁。","source":{"text":"告丞相：男大当婚，女长当嫁。","book":"元本高明《琵琶记·牛相奉旨招婿》"},"similar":["女长须嫁"],"usage":"作定语、分句；指女子成年时"},{"id":14230,"word":"女长须嫁","pinyin":"nǚ zhǎng xū jià","abbr":"nzxj","explanation":"指女子成年后须及时出嫁。","source":{"text":"忽大悟，乃别‘有男不婚，有女不嫁’之偈曰：‘男大须婚，女大须嫁。……’","book":"宋·释普济《五灯会元·侍郎杨杰居士》"},"example":{"text":"自古道：“男大当婚，～。”","book":"明·朱鼎《玉镜台记·议婚》"},"similar":["女大须嫁","女大当嫁"],"usage":"作定语、分句；指女子成年时"},{"id":14231,"word":"奴颜婢睐","pinyin":"nú yán bì lài","abbr":"nybl","explanation":"形容低声下气，谄媚奉承的嘴脸。","source":{"text":"以岳峙独立者，为涩吝疏拙；以奴颜婢睐者，为晓解当世。","book":"晋·葛洪《抱朴子·交际》"},"similar":["奴颜婢色","奴颜婢膝"],"usage":"作谓语、定语；指没有骨气"},{"id":14232,"word":"奴颜婢膝","pinyin":"nú yán bì xī","abbr":"nybx","explanation":"奴颜：奴才的脸，满面谄媚相；婢膝：侍女的膝，常常下跪。指表情和动作奴才相十足。形容对人拍马讨好卑鄙无耻的样子。","source":{"text":"以奴颜婢睐者为晓解当世。","book":"《抱扑子·交际》"},"example":{"text":"～真乞丐，反以正直为狂痴。","book":"唐·陆龟蒙《江湖散人歌》"},"similar":["低三下四","卑躬屈膝","奴颜媚骨"],"opposite":["高风亮节","刚正不阿","威武不屈"],"usage":"作谓语、定语；指没有骨气","story":["南宋时期，北方金国人南侵并包围了鄂州，宋理宗命贾似道带兵去给鄂州解围。贾似道没有打仗，暗中向蒙古侵略者奴颜婢膝地称臣交纳贡品，蒙古军队得了好处就退兵。贾似道回朝称大获全胜，宋理宗封他为右丞相"]},{"id":14233,"word":"奴颜婢色","pinyin":"nú yán bì sè","abbr":"nybs","explanation":"犹言奴颜婢睐。形容低声下气，谄媚奉承的嘴脸。","source":{"text":"与夫谄权媚势，奴颜婢色，因采风谣司漕运者言而得之者远矣。","book":"宋·王禹偁《送柳宜通判全州序》"},"similar":["奴颜婢睐"],"usage":"作谓语、定语；指没有骨气"},{"id":14234,"word":"奴颜媚骨","pinyin":"nú yán mèi gǔ","abbr":"nymg","explanation":"媚骨：谄媚的性格。奴才相，贱骨头。形容卑鄙无耻地奉承别人。","source":{"text":"莲妹，请去传我的话：宋庆龄不愿见到奴颜媚骨之徒。","book":"耿可贵《孙中山与宋庆龄》第七场"},"example":{"text":"他一幅～的汉奸相，让人恶心。"},"similar":["奴颜婢膝"],"opposite":["威武不屈"],"usage":"作谓语、定语；指低三下四"},{"id":14235,"word":"奸不厮欺，俏不厮瞒","pinyin":"jiān bù sī qī，qiào bù sī mán","abbr":"jbsqqbsm","explanation":"厮：相互；欺：欺骗；瞒：隐瞒。同类的人相互之间不欺骗隐瞒。","source":{"text":"奸不厮欺，俏不厮瞒，小人不姓张，俺是东京八十万禁军教头王进的便是。","book":"明·施耐庵《水浒全传》第二回"}},{"id":14236,"word":"奸人之雄","pinyin":"jiān rén zhī xióng","abbr":"jrzx","explanation":"奸人：欺瞒狡诈的人；雄：魁首。原指混淆是非的善辩之人。后多指善弄权术，狡诈欺世的野心家。","source":{"text":"听其言则辞辩而无统，用其身则多诈而无功，上不足以顺明王，下不足以和齐百姓，然而口舌之均，应唯则节，足以为奇伟偃却之属，夫是之谓奸人之雄。","book":"《荀子·非相》"},"example":{"text":"上以侮其君，下以蠹其民，是奸人之雄也，乌足尚哉！","book":"《资治通鉴·周纪二》"},"usage":"作宾语；指坏人"},{"id":14237,"word":"奸同鬼蜮，行若狐鼠","pinyin":"jiān tóng guǐ yù，xíng ruò hú shǔ","abbr":"jtgyxrhs","explanation":"奸诈象鬼蜮，狡猾象狐鼠。比喻人恶劣到极点。"},{"id":14238,"word":"奸回不轨","pinyin":"jiān huí bù guǐ","abbr":"jhbg","explanation":"奸回：邪恶；不轨：不守法规。比喻行为不正，不守法规。","source":{"text":"奸回不轨，祸倍于下民可也。","book":"《左传·襄公二十三年》"},"usage":"作谓语；用于书面语"},{"id":14239,"word":"奸夫淫妇","pinyin":"jiān fū yín fù","abbr":"jfyf","explanation":"指通奸的男人和放荡不羁的女人。指淫乱的男女。","source":{"text":"奸夫淫妇，虽该重罪，已死勿论。其余一干人犯，释放宁家。","book":"明·施耐庵《水浒传》第27回"},"example":{"text":"清·无名氏《刘公案》第84回：“也有那因奸谋害亲夫主，～一个心。”"},"usage":"作主语、宾语、定语；多用于口语"},{"id":14240,"word":"奸官污吏","pinyin":"jiān guān wū lì","abbr":"jgwl","explanation":"奸：邪恶；吏：官吏。贪赃枉法的官吏。","source":{"text":"天灾可以死，盗贼可以死，瓜分之日可以死，奸官污吏虐民可以死。","book":"清·林觉民《绝笔书》"},"example":{"text":"百姓最痛恨这些～。"},"similar":["贪官污吏","赃官污吏"],"usage":"作主语、宾语、定语；指贪赃枉法的官吏"},{"id":14241,"word":"奸掳烧杀","pinyin":"jiān lǔ shāo shā","abbr":"jlss","explanation":"奸淫妇女，抢劫财物，杀人放火。","source":{"text":"老头子说：‘别看他们这样，这叫做假行仁义，收买人心。等他一占了开封，就会奸掳烧杀，无恶不作。’","book":"姚雪垠《李自成》第三卷第四十五章"},"usage":"作谓语、宾语、定语；用于战争等"},{"id":14242,"word":"奸淫抢掠","pinyin":"jiān yín qiǎng lüè","abbr":"jyql","explanation":"奸淫：奸污。奸污妇女，掠夺财物，比喻烧杀抢掠，无恶不作。","source":{"text":"……奸淫抢掠，不要历史，不要文化，……不敬师长，共产公妻，人海战术，总之是一群青面獠牙，十恶不赦的人。","book":"毛泽东《丢掉幻想，准备斗争》"},"similar":["奸淫掳掠"],"usage":"作谓语、宾语、定语；比喻什么坏事都干"},{"id":14243,"word":"奸淫掳掠","pinyin":"jiān yín lǔ lüè","abbr":"jyll","explanation":"奸淫妇女，掠夺财物。","source":{"text":"谁知仍是强赊硬抢，掳掠奸淫，无所不至。","book":"清·吴趼人《痛史》第七回"},"example":{"text":"蒋军所到之处，杀人放火，～实行三光政策，同日本强盗的行为完全一样。","book":"毛泽东《中国人民解放军宣言》"},"similar":["荒淫无耻"],"opposite":["尊老爱幼","扶老携幼"],"usage":"作谓语、宾语；比喻什么坏事都干"},{"id":14244,"word":"奸渠必剪","pinyin":"jiān qú bì jiǎn","abbr":"jqbj","explanation":"奸渠：为非作歹的头目。对为非作歹的头目，必须坚决铲除。","source":{"text":"不待赭汙之奴，而奸渠必剪，无假里端之籍，而晋子咸诛。","book":"南朝·梁·沈约《齐故安陆昭王碑文》"}},{"id":14245,"word":"奸狡诡谲","pinyin":"jiān jiǎo guǐ jué","abbr":"jjgj","explanation":"奸：奸诈；狡：狡猾；诡谲：狡猾。指为人奸诈狡猾。","source":{"text":"却说城中有一人姓张，名委，原是个宦家子弟，为人奸狡诡谲，残忍刻薄。","book":"明·冯梦龙《醒世恒言·灌园叟晚逢仙女》"},"usage":"作谓语、定语；用于为人处世"},{"id":14246,"word":"奸臣当道","pinyin":"jiān chén dāng dào","abbr":"jcdd","explanation":"奸佞的小人控制朝政。指坏人当权。","source":{"text":"此时因纣王失政，妲己残害生灵，奸臣当道，豺狼满朝，故此天心不顺。","book":"明·许仲琳《封神演义》第15回"},"example":{"text":"～，老百姓就没有活路了。"},"similar":["豺狼当道"],"usage":"作谓语、定语；用于政局等"},{"id":14247,"word":"奸诈不级","pinyin":"jiān zhà bù jí","abbr":"jzbj","explanation":"指奸诈无赖。","source":{"text":"家中有几个奸诈不级的人，日逐引诱他，在外飘洒，把家事都失了。","book":"明·兰陵笑笑生《金瓶梅词话》"}},{"id":14248,"word":"好丹非素","pinyin":"hào dān fēi sù","abbr":"hdfs","explanation":"爱好红色，反对白色。比喻对事物有偏见。","source":{"text":"至于世之诸贤，各滞所速，莫不论甘则忌辛，好丹则非素。","book":"南朝梁·江淹《杂体诗序》"},"example":{"text":"岂容以～之微，贻破斧缺戕之痛。","book":"《民国演义》第一百回"},"usage":"作谓语、定语；比喻对事物有偏见"},{"id":14249,"word":"好为事端","pinyin":"hào wéi shì duān","abbr":"hwsd","explanation":"喜欢惹事生非。","source":{"text":"会见利忘义，好为事端，宠过必乱，不可大任。","book":"《晋书·文明王后传》"},"example":{"text":"他～，经常与同事不合。"},"similar":["惹事生非"],"usage":"作谓语、定语；指惹事生非"},{"id":14250,"word":"好为人师","pinyin":"hào wéi rén shī","abbr":"hwrs","explanation":"喜欢当别人的教师。形容不谦虚，自以为是，爱摆老资格。","source":{"text":"《孟子·离娄下》：”人之患在好为人师。“"},"example":{"text":"科学的态度是“实事求是”，“自以为是”和“～”那样狂妄的态度是决不能解决问题的。","book":"毛泽东《新民主主义论》"},"similar":["自以为是","妄自尊大","倚老卖老"],"opposite":["不耻下问","虚怀若谷","大智若愚"],"usage":"作谓语、定语、宾语；指喜欢当别人的老师"},{"id":14251,"word":"好为虚势","pinyin":"hào wéi xū shì","abbr":"hwxs","explanation":"指只图表面上的红红火火，即喜欢虚张声势。","source":{"text":"好为虚势，不知兵要。","book":"《后汉书·袁绍刘表传》"}},{"id":14252,"word":"好乱乐祸","pinyin":"hào luàn lè huò","abbr":"hllh","explanation":"好、乐：喜欢，喜爱。喜欢捣乱和闯祸。","source":{"text":"操赘阉遗丑，本无懿德，漂狡锋协，好乱乐祸。","book":"明·罗贯中《三国演义》第二十二回"},"usage":"作谓语、定语；用于为人"},{"id":14253,"word":"好了疮疤忘了痛","pinyin":"hǎo le chuāng bā wàng le tòng","abbr":"hlcbwlt","explanation":"比喻情况好转后就忘了过去的困难或失败的教训。","example":{"text":"真是～，你没想到靠救济过日子的时候了。"},"similar":["好了伤疤忘了痛"],"usage":"作宾语、定语；用于口语"},{"id":14254,"word":"好事不出门，恶事传千里","pinyin":"hǎo shì bù chū mén，è shì chuán qiān lǐ","abbr":"hsbcmescql","explanation":"指好事不容易被人知道，坏事却传播得极快。","source":{"text":"自古道：‘好事不出门，恶事传千里。’不到半月之间，街坊邻舍，都知得了，只瞒着武大一个不知。","book":"明·施耐庵《水浒传》第24回"},"example":{"text":"清·李宝嘉《官场现形记》第40回：“常言道：‘～。’王柏臣接着电报十几天不报丁忧，这话早已沸沸扬扬。”"},"similar":["好事不出门，恶事行千里"],"usage":"作宾语、定语、分句；指坏事比好事传播快"},{"id":14255,"word":"好事不出门，恶事扬千里","pinyin":"hǎo shì bù chū mén，è shì yáng qiān lǐ","abbr":"hsbcmesyql","explanation":"指好事不容易被人知道，坏事却传播得极快","source":{"text":"自古道：好事不出门，恶事扬千里。","book":"明·冯梦龙《醒世恒言》第九卷"},"similar":["好事不出门，恶事传千里"],"usage":"作宾语、定语、分句；指坏事比好事传播快"},{"id":14256,"word":"好事不出门，恶事行千里","pinyin":"hǎo shì bù chū mén，huài shì xíng qiān lǐ","abbr":"hsbcmesxql","explanation":"指好事不容易被人知道，坏事却传播得极快。","source":{"text":"僧问绍宗：‘如何是西来意？’绍宗曰：‘好事不出门，恶事行千里。’","book":"宋·释道原《景德传灯录》"},"example":{"text":"自古道：“～。”不到半月之间，街坊邻舍都晓得了。","book":"明·兰陵笑笑生《金瓶梅词话》第四回"},"similar":["好事不出门，恶事传千里"],"usage":"作宾语、定语、分句；指坏事比好事传播快"},{"id":14257,"word":"好事之徒","pinyin":"hào shì zhī tú","abbr":"hszt","explanation":"喜欢多事或好管闲事的人。","source":{"text":"好事者为之也。","book":"《孟子·万章上》"},"example":{"text":"可是中国真也还有～，竟有人不怕中暑的跑到真茹的“望岁小农居”这洋楼底下去请教他了。","book":"鲁迅《伪自由书·后记》"},"usage":"作主语、宾语；指喜欢多事的人"},{"id":14258,"word":"好事多妨","pinyin":"hǎo shì duō fáng","abbr":"hsdf","explanation":"妨：阻碍。好事情在实现、成功前常常会经历许多波折。","source":{"text":"惊魂未定，好事多妨，堪伤。","book":"元·吴弘道《梅花引》曲"},"similar":["好事多磨","好事多悭"],"usage":"作宾语、定语、分句；指男女爱情等"},{"id":14259,"word":"好事多悭","pinyin":"hǎo shì duō qiān","abbr":"hsdq","explanation":"犹言好事多磨。","source":{"text":"常言道好事多悭，陡恁的千难万难。","book":"元·贯云石《一枝花·离闷》套曲"},"similar":["好事多磨","好事多妨","好事天悭"],"usage":"作宾语、定语、分句；指男女爱情等"},{"id":14260,"word":"好事多磨","pinyin":"hǎo shì duō mó","abbr":"hsdm","explanation":"磨：阻碍，困难。好事情在实现、成功前，常常会遇到许多波折。","source":{"text":"真所谓佳期难得，好事多磨。","book":"宋·晁补之《安公子》词：“是即是，从来好事多磨难。”金·董解元《西厢》一"},"example":{"text":"哪知～，常常会遇到许多波折。","book":"清·曾朴《孽海花》第十六回"},"similar":["一波三折","节外生枝","好梦难成"],"opposite":["一帆风顺","无往不利"],"usage":"作宾语、定语、分句；指男女爱情等"},{"id":14261,"word":"好事天悭","pinyin":"hǎo shì tiān qiān","abbr":"hstq","explanation":"犹言好事多磨。","source":{"text":"常言道好事天悭。美姻缘他娘间阻，生拆散鸾交凤友。","book":"元·关汉卿《青杏子·离情》曲"},"similar":["好事多磨","好事多妨","好事多悭"],"usage":"作宾语、定语、分句；指男女爱情等"},{"id":14262,"word":"好事成双","pinyin":"hǎo shì chéng shuāng","abbr":"hscs","explanation":"指好事同时到来。","source":{"text":"郁四会心一笑，听他的话，抽足了鸦片，静待好事成双。","book":"高阳《胡雪岩全传·平步青云》中册"},"example":{"text":"我胜利归来，父母告诉我荣升，真是～。"},"similar":["双喜临门"],"usage":"作谓语；指双喜临门"},{"id":14263,"word":"好佚恶劳","pinyin":"hǎo yì wù láo","abbr":"hywl","explanation":"贪图安逸，厌恶劳动。同“好逸恶劳”。","source":{"text":"要而论之，此三类者，均由学士大夫，好佚恶劳，惮著书之苦，复欲博著书之名，故单辞只义，轶事遗闻，咸笔之于书，以冀流传久远。","book":"刘师培《论说部与文学之关系》"},"similar":["好逸恶劳"],"usage":"作谓语、定语；指人贪图安逸"},{"id":14264,"word":"好借好还，再借不难","pinyin":"hǎo jiè hǎo huán，zài jiè bù nán","abbr":"hjhhzjbn","explanation":"借别人的东西及时归还，以后要再借的时候也就不困难了。","source":{"text":"老孙可是那当面骗物之人？这叫做好借好还，再借不难。","book":"明·吴承恩《西游记》第十六回"}},{"id":14265,"word":"好勇斗狠","pinyin":"hào yǒng dòu hěn","abbr":"hydh","explanation":"狠：暴戾，凶恶，残忍。爱逞威风，喜欢斗欧。形容人凶强好斗。","source":{"text":"好勇斗很，以危其父母，一不孝也。","book":"《孟子·离娄下》"},"example":{"text":"两位勇士都是～的，但他们两人生长在一个地方，却从没有见过面。","book":"郭沫若《齐勇士比武》"},"usage":"作谓语、宾语；形容人凶强好斗"},{"id":14266,"word":"好古敏求","pinyin":"hào gǔ mǐn qiú","abbr":"hgmq","explanation":"好：喜爱，喜好。喜好古学而勉力追求。","source":{"text":"我非生而知之者，好古敏以求之者也。","book":"春秋·鲁·孔丘《论语·述而》"},"example":{"text":"做学问要‘～’，要继承过去的遗产，努力钻研。","book":"吴晗《爱国学者顾炎武》"},"usage":"作谓语、宾语；用于做学问等"},{"id":14267,"word":"好吃好喝","pinyin":"hào chī hào hē","abbr":"hchh","explanation":"爱好吃喝的。","source":{"text":"那骗子骗了一年多的好吃好喝，恐怕一旦失了，遂造起谣言来。","book":"清·吴趼人《二十年目睹之怪现状》第80回"},"example":{"text":"他是一位～而又大腹便便的政府官员。"},"similar":["好吃懒做"],"usage":"作谓语、定语；指爱好吃喝的"},{"id":14268,"word":"好吃懒做","pinyin":"hào chī lǎn zuò","abbr":"hclz","explanation":"好：喜欢、贪于。贪于吃喝，懒于做事。","source":{"text":"这样好吃懒做的淫妇，睡到这等日高才起来。","book":"明·凌濛初《初刻拍案惊奇》卷二"},"example":{"text":"且人前人后，又怨他不会过，只一味～。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["好逸恶劳"],"opposite":["克勤克俭","吃苦耐劳"],"usage":"作谓语、定语、宾语；形容嘴馋身懒"},{"id":14269,"word":"好善乐施","pinyin":"hào shàn lè shī","abbr":"hsls","explanation":"好：喜欢；善：亲善，善事；乐：乐意；施：施舍。指喜欢做善事，乐意施舍。","source":{"text":"闻徽音，使人乐善而好施；闻羽音，使人整齐而好礼。","book":"西汉·司马迁《史记·乐书二》"},"example":{"text":"夫妻两口，为了疏财仗义，～。","book":"明·凌濛初《初刻拍案惊奇·张员外又抚螟蛉子》"},"similar":["助人为乐","与人为善","慷慨解囊"],"opposite":["打家劫舍","落井下石","趁火打劫"],"usage":"作谓语、宾语；指做善事"},{"id":14270,"word":"好善嫉恶","pinyin":"hǎo shàn jí è","abbr":"hsje","explanation":"崇尚美善，憎恨丑恶。","source":{"text":"好善嫉恶，赏罚严明，治之材也。","book":"汉·王符《潜夫论·实贡》"},"example":{"text":"尤恶下为朋党相构，～，出于天性。","book":"《旧唐书·李晟传》"},"similar":["嫉恶好善","好善恶恶"],"usage":"作谓语、宾语、定语；用于人的性格","story":["唐朝中期，西域吐蕃很想侵犯中原，由于李晟的顽强抵抗而不能得逞。吐蕃的宰相结赞运用离间计，亲率大军入侵陇州和凤翔，被李晟打败。他假意求和，唐德宗借故罢免李晟的兵权，别人借机为他鸣不平，他天性好善嫉恶，不愿拉帮结派"]},{"id":14271,"word":"好善恶恶","pinyin":"hǎo shàn wù è","abbr":"hswe","explanation":"崇尚美善，憎恨丑恶。","source":{"text":"好善恶恶，人人如此。","book":"《说岳全传》第七三回"},"similar":["好善嫉恶"],"usage":"作谓语、宾语、定语；用于人的性格"},{"id":14272,"word":"好声好气","pinyin":"hǎo shēng hǎo qì","abbr":"hshq","explanation":"形容语调柔和，态度温和。","example":{"text":"我～地跟你说，希望你能听取我们的意见。"},"similar":["好言好语"],"opposite":["恶声恶气"],"usage":"作宾语、状语；指人的语气"},{"id":14273,"word":"好大喜功","pinyin":"hào dà xǐ gōng","abbr":"hdxg","explanation":"指不管条件是否许可，一心想做大事立大功。多用以形容浮夸的作风。","source":{"text":"至其牵于多爱，复立浮屠，好大喜功，勤兵于远，此中材庸主之所常为。","book":"宋·罗泌《路史·前纪》卷四：“昔者汉之武帝，好大而喜功。”《新唐书·太宗纪赞》"},"example":{"text":"你在人前夸大嘴，说我怎样的～。","book":"郭沫若《屈原》第二幕"},"similar":["好高骛远","沽名钓誉"],"opposite":["稳扎稳打","脚踏实地","老成持重"],"usage":"作谓语、定语、分句；指人浮夸","story":["汉武帝时北方的匈奴又向汉室要求和亲，汉武帝采纳王恢的假和亲的意见，就派卫青、李广、霍去病等大将军率军攻打匈奴，又派张骞两次出使西域，开通了“丝绸之路”。汉武帝是一个想做大事、统一天下的人，国家渐渐强大起来"]},{"id":14274,"word":"好天良夜","pinyin":"hǎo tiān liáng yè","abbr":"htly","explanation":"①美好的时节。②好时光，好日子。","source":{"text":"相思不得长相聚，好天良夜，无端惹起千愁成绪。","book":"宋·柳永《女冠子》词"},"example":{"text":"天教你富，莫太奢，没多时～。","book":"元·马致远《夜行船》套曲"},"usage":"作主语、宾语；用于书面语"},{"id":14275,"word":"好奇尚异","pinyin":"hào qí shàng yì","abbr":"hqsy","explanation":"好：喜欢；尚：注重，喜爱。喜欢和注重奇怪特别的事物。","source":{"text":"皆有晚学之徒，好奇尚异，敬欲推崇老子，帮有此说。","book":"晋·葛洪《神仙传》"}},{"id":14276,"word":"好女不穿嫁时衣","pinyin":"hǎo nǚ bù chuān jià shí yī","abbr":"hnbcjsy","explanation":"比喻自食其力，不依靠父母或祖上遗产生活。","source":{"text":"好男不吃分家饭，好女不穿嫁时衣。","book":"旧谚"},"example":{"text":"好男不吃分家饭，～。依孩儿的意思，总是自挣的功名好，靠着父祖，只算做不成器。”（清·吴敬梓《儒林外史》第十一","book":"小姐道"},"similar":["好男不吃分时饭"],"usage":"作宾语、定语；用于口语"},{"id":14277,"word":"好好先生","pinyin":"hǎo hǎo xiān shēng","abbr":"hhxs","explanation":"与人无争，只求相安无事的人。","source":{"text":"南朝·宋·刘义庆《世说新语·言语》“南郡庞士元闻司马德操在颍川”刘孝标注引《司马徽别传》载：司马徽称一切东西皆“佳”，故有“好好先生”之号。"},"example":{"text":"我们没来由今日为他得罪严老大，老虎头上扑苍蝇，怎的？落得做～。","book":"清·吴敬梓《儒林外史》第六回"},"similar":["明哲保身"],"opposite":["混世魔王","凶神恶煞"],"usage":"作主语、宾语；指没有原则的人","story":["东汉末年，刘备投奔荆州牧刘表后，深感要扩大自己的实力，必须要有智谋人士辅佐，他去拜访襄阳地区有名的好好先生司马徽。司马徽善于识别人才，经常装糊涂，从不说人短处，凡事都说好。不过他推荐诸葛亮和庞统是真心说好"]},{"id":14278,"word":"好学不倦","pinyin":"hào xué bù juàn","abbr":"hxbj","explanation":"喜欢学习，不知疲倦。","source":{"text":"昔我文公，狐季姬之了也，有宠于献公，好学不倦　。","book":"《史记·楚世家》"},"example":{"text":"苏颋少不得父意，常与仆夫杂处，而～。","book":"宋·王傥《唐语林·文学》"},"similar":["学而不厌","手不释卷"],"opposite":["一曝十寒"],"usage":"作谓语、定语；指人好学"},{"id":14279,"word":"好学不厌","pinyin":"hào xué bù yàn","abbr":"hxby","explanation":"好：喜爱；厌：厌倦。爱好学习，从不厌倦。","source":{"text":"李荣号散木，钱塘人。少未读书，好学不厌，能诗工书，尤爱六法，俱臻妙境。","book":"清·钱泳《履园丛话·画中人》"},"similar":["好学不倦"],"usage":"作谓语、定语；指人好学"},{"id":14280,"word":"好学深思","pinyin":"hào xué shēn sī","abbr":"hxss","explanation":"喜欢学习，勤于思考。","source":{"text":"书缺有间矣，其轶乃时时见于他说。非好学深思，心知其意，固难为浅见寡闻道也。","book":"《史记·五帝本纪》"},"example":{"text":"质余洵所谓～，多闻博物之君子矣。","book":"清·王鸣盛《〈屈原指掌〉序》"},"usage":"作谓语、定语；指人好学"},{"id":14281,"word":"好学深思，心知其意","pinyin":"hào xué shēn sī，xīn zhī qī yì","abbr":"hxssxzqy","explanation":"喜欢学习，勤于思考，就能集会其中的含义。","source":{"text":"书缺有间矣，其轶乃时时见于他说。非好学深思，心知其意，固难为浅见寡闻道也。","book":"《史记·五帝本纪》"},"example":{"text":"盖诗境甚宽，诗情甚活，总在乎～。","book":"清·袁枚《随园诗话补遗》卷三"},"usage":"作宾语、定语、分句；用于书面语"},{"id":14282,"word":"好尚不同","pinyin":"hào shàng bù tóng","abbr":"hsbt","explanation":"好：情趣和爱好；尚：所推崇的事物。指所喜欢的和所推崇的各不相同。也指各个国家或地区的社会风尚不相同。","source":{"text":"诸葛亮与正，虽好尚不同，以公义相取。","book":"三国·魏·曹植《与杨德祖书》：“人各有好尚。”《三国志·蜀志·法正传》"}},{"id":14283,"word":"好心不得好报","pinyin":"hǎo xīn bù dé hǎo bào","abbr":"hxbdhb","explanation":"好心好意地为他人办事情，却得不到好的报答。","source":{"text":"曰：‘为什么却丧身？’师曰：‘好心无好报。’","book":"宋·释道原《景德传灯录》卷十七"},"example":{"text":"我这样做真是～。"},"similar":["事与愿违","好心得不到好报"],"usage":"作宾语、定语；指好心被人误解"},{"id":14284,"word":"好心做了驴肝肺","pinyin":"hǎo xīn zuò le lǘ gān fèi","abbr":"hxzllgf","explanation":"俗语。指把好心当作坏意。","source":{"text":"你看我好心做了驴肝肺，你倒讪起我来，凭说我去罢。","book":"明·兰陵笑笑生《金瓶梅词话》第二十八回"},"similar":["好心当做驴肝肺"],"usage":"作宾语、定语；用于口语"},{"id":14285,"word":"好心办坏事","pinyin":"hǎo xīn bàn huài shì","abbr":"hxbhs","explanation":"一片好心去为人做事，结果适得其反。","example":{"text":"请不要过分热心，小心～。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":14286,"word":"好心好意","pinyin":"hǎo xīn hǎo yì","abbr":"hxhy","explanation":"指怀着善意。","source":{"text":"我好心好意来告诉你，你可不能卖了我呀！","book":"老舍《茶馆》第三幕"},"example":{"text":"人家是～来安慰我们。"},"similar":["真心实意"],"opposite":["虚情假意"],"usage":"作宾语、状语；指善意"},{"id":14287,"word":"好心好报","pinyin":"hǎo xīn hǎo bào","abbr":"hxhb","explanation":"指好心待人可以得到好的回报。"},{"id":14288,"word":"好心得不到好报","pinyin":"hǎo xīn dé bù dào hǎo bào","abbr":"hxdbdhb","explanation":"一片好心肠却得不到好的报答。","example":{"text":"～，我们还是省点劲吧！"},"similar":["好心没好报"],"usage":"作宾语、定语；用于口语"},{"id":14289,"word":"好心无好报","pinyin":"hǎo xīn wú hǎo bào","abbr":"hxwhb","explanation":"好心好意地为他人办事情，却得不到好的报答。","source":{"text":"曰：‘为什么却丧身？’师曰：‘好心无好报。’","book":"宋·释道原《景德传灯录》卷十七"}},{"id":14290,"word":"好心没好报","pinyin":"hǎo xīn méi hǎo bào","abbr":"hxmhb","explanation":"一片好心肠却得不到好的报答。","source":{"text":"出了好心没有好报，看来为人也很有限。","book":"清·李宝嘉《官场现形记》第17回"},"example":{"text":"真是～，我何必呢？"},"similar":["好心得不到好报"],"usage":"作宾语、定语；用于口语"},{"id":14291,"word":"好恶不同","pinyin":"hào wù bù tóng","abbr":"hebt","explanation":"爱好和憎恶各不相同。形容人的志趣和思想感情各异。","source":{"text":"公卿大夫，好恶不同。","book":"《汉书·袁帝纪》"},"similar":["好恶乖方","好恶殊方"],"opposite":["好恶同之"],"usage":"作谓语、定语；用于为人"},{"id":14292,"word":"好恶不愆","pinyin":"hǎo è bù qián","abbr":"hebq","explanation":"喜事从天上掉下来。比喻突然遇到意想不到的喜事。","source":{"text":"贵脚踏践地，使下官喜从天降。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"张顺见了宋江，～。","book":"明·施耐庵《水浒全传》第四十回"},"opposite":["是非不分"],"usage":"作谓语、定语；指是非分明"},{"id":14293,"word":"好恶乖方","pinyin":"hào wù guāi fāng","abbr":"hwgf","explanation":"好：爱好，喜爱；恶：讨厌；方：方向，趋向。指情趣不同，爱憎各异。","source":{"text":"时君世主，好恶殊方。","book":"《汉书·艺文志》"},"example":{"text":"鄙人向年为吏吴兴，虽跼蹐百里，而志在生民，与俗人～。","book":"明·归有光《与曹按察》"},"similar":["好恶不同","好恶殊方"],"usage":"作谓语、定语；用于为人"},{"id":14294,"word":"好恶同之","pinyin":"hào wù tóng zhī","abbr":"hwtz","explanation":"好：爱好，喜欢；恶：讨厌，憎恨；同之：使其一样。对于某种事物有同样的爱好或憎恨。","source":{"text":"戮力壹心，好恶同之。","book":"《左传·昭公二十五年》"},"opposite":["好恶不同","好恶殊方","好恶乖方"],"usage":"作谓语、定语；用于人的喜好等"},{"id":14295,"word":"好恶殊方","pinyin":"hào wù shū fāng","abbr":"hwsf","explanation":"好：爱好，喜爱；恶：讨厌；殊：不同；方：方向，趋向。指情趣不同，爱憎各异。","source":{"text":"时君世主，好恶殊方。","book":"《汉书·艺文志》"},"similar":["好恶乖方","好恶不同"],"usage":"作谓语、定语；用于为人"},{"id":14296,"word":"好戏连台","pinyin":"hǎo xì lián tái","abbr":"hxlt","explanation":"精彩的节目连续演出或播放。也喻指动人的场面或情景不断出现。","usage":"多用于褒义。"},{"id":14297,"word":"好戴高帽","pinyin":"hào dài gāo mào","abbr":"hdgm","explanation":"比喻喜欢别人吹捧，喜欢听奉承讨好的话。","source":{"text":"宗道晖好著高翅帽，大屐。州将初临，辄服以谒见。","book":"《北史·熊安生传》"},"example":{"text":"他这个人最大的缺点就是～"},"usage":"作谓语、定语；用于为人"},{"id":14298,"word":"好手不敌双拳","pinyin":"hǎo shǒu bù dí shuāng quán","abbr":"hsbdsq","explanation":"虽然有本事，一个人也打不过两个人。比喻寡不敌众。","source":{"text":"好手不敌双拳，双拳不如四手。他那里六条大汉，你这般小小的一个人，怎么敢与他争持？","book":"明·吴承恩《西游记》第十四回"}},{"id":14299,"word":"好整以暇","pinyin":"hào zhěng yǐ xiá","abbr":"hzyx","explanation":"整：严整；暇：不急迫。形容既严整，又从容。也指事情虽多，仍旧从容不迫。","source":{"text":"日臣之使于楚也，子重问晋国之勇，臣对曰：‘好以众整。’曰：‘又何如？’臣对曰：‘好以暇。’","book":"《左传·成公十六年》"},"example":{"text":"在这种人心惶惶的时候，珏斋却～，大有轻裘缓带的气象，只把军队移驻山海关。","book":"清·曾朴《孽海花》第二十五回"},"similar":["从容不迫","镇定自若"],"opposite":["手忙脚乱","局促不安"],"usage":"作谓语、状语；形容既严整有序又从容不迫","story":["春秋时期，晋厉公派栾书率军攻打郑国，楚武王派子反率军去迎战晋军。楚武王的眼睛被晋军射伤。晋军栾鍼对楚军子重说晋军打仗喜欢好整以暇，得先换使者敬酒，而不是仓皇应战。楚军与晋军打了一天一夜还不见分晓"]},{"id":14300,"word":"好施乐善","pinyin":"hào shī lè shàn","abbr":"hsls","explanation":"乐：好，喜欢。喜欢做善事，乐于拿财物接济有困难的人。","source":{"text":"闻徵音，使人乐善而好施；闻羽音，使人整齐而而好礼。","book":"《史记·乐书》"},"example":{"text":"再说施家，自从施济存日，～，囊中已空虚了。","book":"明·冯梦龙《警世通言》卷二十五"},"similar":["乐善好施"],"usage":"作谓语、定语；用于为人心地善良"},{"id":14301,"word":"好施小惠","pinyin":"hào shī xiǎo huì","abbr":"hsxh","explanation":"施：给予；惠：仁慈。喜欢给别人小恩小惠。","source":{"text":"峻贪权利，多机数，好施小惠，喜人附己。","book":"《旧五代史·王峻传》"},"similar":["好行小惠"],"usage":"作谓语、定语；用于为人"},{"id":14302,"word":"好景不常","pinyin":"hǎo jǐng bù cháng","abbr":"hjbc","explanation":"景：光景，时机。美好的光景不能永远存在。多用于对世事变迁的感叹。","source":{"text":"好景难常在，过眼韶华如箭。","book":"唐·王勃《滕王阁序》：“胜地不常，盛筵难再。”宋·晁补之《梁州令叠韵》"},"similar":["好景不长"],"usage":"作谓语，分句；用于对世事变迁的感叹"},{"id":14303,"word":"好景不长","pinyin":"hǎo jǐng bù cháng","abbr":"hjbc","explanation":"景：境况，光景；长：长久。美好的光景不能永远存在。","source":{"text":"可是好景不长！中午时分，老人的病情突然加重了——肚子疼得在一堆破棉絮中滚来滚去！","book":"路遥《平凡的世界》第四卷第41章"},"example":{"text":"他们匆匆结合，总是好景不长的。"},"similar":["好景不常","好事多磨","乐极生悲"],"opposite":["苦尽甜来","否极泰来","时来运转"],"usage":"作谓语，分句；形容好的事物很短暂"},{"id":14304,"word":"好来好去","pinyin":"hǎo lái hǎo qù","abbr":"hlhq","explanation":"善始善终。","example":{"text":"我们希望你们两口～，不要伤和气。"},"similar":["善始善终"],"usage":"作谓语、宾语；用于劝诫人"},{"id":14305,"word":"好梦不长","pinyin":"hǎo mèng bù cháng","abbr":"hmbc","explanation":"指不切实际的幻想是不能实现的，只能存在于梦幻之中。","example":{"text":"这真是～，你还是实际点吧。"},"usage":"作宾语、定语；用于口语"},{"id":14306,"word":"好梦难圆","pinyin":"hǎo mèng nán yuán","abbr":"hmny","explanation":"比喻好事难以实现。","source":{"text":"彩云轻散，好梦难圆。","book":"明·汤显祖《紫钗记·剑合钗圆》"},"example":{"text":"～，你不要白费功夫了。"},"similar":["好梦难成"],"usage":"作宾语；指愿望不能实现"},{"id":14307,"word":"好梦难成","pinyin":"hǎo mèng nán chéng","abbr":"hmnc","explanation":"在睡眠时，要想做个好梦也是不轻而易举的。比喻美好的幻想难以变成现实。","source":{"text":"宋·聂胜琼《鹧鸪天·寄李之问》：“寻好梦，梦难成；有谁知我此时情。枕前泪共帘前雨，隔个窗儿滴到明。"},"example":{"text":"薄设设衾寒枕冷，愁易感～。千愁万恨断肠人，怎当半夜三更莫秋景。","book":"元·无名氏《云窗梦》第三折"},"similar":["好梦难圆"],"usage":"作宾语；指美好的幻想难以实现"},{"id":14308,"word":"好模好样","pinyin":"hǎo mó hǎo yàng","abbr":"hmhy","explanation":"①模样端正。②犹言规规矩矩。","source":{"text":"第一件，要一个人才出众，好模好样的。","book":"《京本通俗小说·志诚张主管》"},"example":{"text":"～成亲事，留你残生过几春。若道三声言不字，眼前叫你见分明。","book":"《天雨花》第五回"},"usage":"作谓语、宾语、定语；指人的模样"},{"id":14309,"word":"好歹不分","pinyin":"hǎo dǎi bù fēn","abbr":"hdbf","explanation":"指不分是非，不识好坏。","source":{"text":"且好歹不分，众何所劝？","book":"《新编五代史平话·周史》卷下"}},{"id":14310,"word":"好死不如恶活","pinyin":"hǎo sǐ bù rú è huó","abbr":"hsbreh","explanation":"指无论如何也要保住性命。","source":{"text":"好死不如恶活。但留我命，凭你教做什么。","book":"明·吴承恩《西游记》第六十三回"}},{"id":14311,"word":"好汉不吃眼前亏","pinyin":"hǎo hàn bù chī yǎn qián kuī","abbr":"hhbcyqk","explanation":"俗语。指聪明人能识时务，暂时躲开不利的处境，免得吃亏受辱。","source":{"text":"好汉不吃眼前亏，且让他一步，再作道理。","book":"清·李宝嘉《官场现形记》第十七回"},"example":{"text":"不必故意的赌气，老先生，～。","book":"老舍《四世同堂》十三"},"similar":["光棍不吃眼前亏"],"usage":"作宾语、定语、分句；用于口语"},{"id":14312,"word":"好汉做事好汉当","pinyin":"hǎo hàn zuò shì hǎo hàn dāng","abbr":"hhzshhd","explanation":"敢做敢当，不推责任。","source":{"text":"但既然已经这样了，那就要好汉做事好汉当！你们先不要管，有什么差错我自己承担！","book":"路遥《平凡的世界》第二卷第53章"},"example":{"text":"～，我不会连累你的。"},"similar":["敢做敢当","一人做事一人当"],"usage":"作宾语、定语、分句；指敢于承担责任"},{"id":14313,"word":"好汉惜好汉","pinyin":"hǎo hàn xī hǎo hàn","abbr":"hhxhh","explanation":"惜：爱惜。指才能品行相同的人互相敬重。","source":{"text":"我与将军以勇力齐名，好汉惜好汉，何忍自相戕贼乎？","book":"明·冯梦龙《东周列国志》第62回"},"example":{"text":"他们是～，互相怜惜。"},"similar":["惺惺惜惺惺"],"usage":"作宾语、定语；用于发现与爱惜人才"},{"id":14314,"word":"好汉英雄","pinyin":"hǎo hàn yīng xióng","abbr":"hhyx","explanation":"非凡出众的人物。指见解、才能超群出众或领袖群众的人。","source":{"text":"随你好汉英雄，怎出高城峻垒？","book":"明·施耐庵《水浒传》第62回"},"similar":["英雄好汉"],"usage":"作主语、宾语、定语；用于口语"},{"id":14315,"word":"好涵高躅","pinyin":"hào hán gāo zhú","abbr":"hhgz","explanation":"喜欢混迹于高人之列。","example":{"text":"～不是坏事，可以学到不少东西。"},"usage":"作主语、宾语、定语；用于为人"},{"id":14316,"word":"好生之德","pinyin":"hào shēng zhī dé","abbr":"hszd","explanation":"好生：爱惜人和动物的生命。指有仁爱之心，爱惜生命，不乱杀戮的美德。","source":{"text":"好生之德，洽于民心。","book":"《尚书·大禹漠》"},"example":{"text":"本当杀坏了你，上天尚有～，且饶过你罪，再不许你再此作戏也。","book":"元·无名氏《猿听经》第二折"},"similar":["救苦救难","大慈大悲","刀下留人"],"opposite":["草菅人命","人面兽心","嗜杀成性"],"usage":"作主语、宾语；指爱惜生灵"},{"id":14317,"word":"好生恶杀","pinyin":"hào shēng wù shā","abbr":"hses","explanation":"好生：爱惜生命。爱惜生命，不好杀戮。","source":{"text":"陛下好生恶杀，此事情不烦出敕，乞容臣出牒处分。","book":"《旧唐书·姚崇传》"},"example":{"text":"必闻其国以～，省欲去奢为事，冀以此可以诱民为善之一端也。","book":"宋·王观国《学林·佛教》"},"usage":"作谓语、定语；用于为人"},{"id":14318,"word":"好男不跟女斗","pinyin":"hǎo nán bù gēn nǚ dǒu","abbr":"hnbgnd","explanation":"旧时认为有出息的男子不和女子一般见识。","example":{"text":"～，不必跟她一般见识。"},"usage":"作宾语、定语、分句；用于口语"},{"id":14319,"word":"好离好散","pinyin":"hǎo lí hǎo sàn","abbr":"hlhs","explanation":"和和气气地分手，不相互责备苛求。","source":{"text":"嫌我们就打发了我们，再挑好的使。好离好散的倒不好。","book":"清·曹雪芹《红楼梦》第三十一回"},"example":{"text":"她决定与他～。"},"similar":["好合好散"],"usage":"作谓语、宾语；指情人、朋友、夫妻等友善地"},{"id":14320,"word":"好管闲事","pinyin":"hào guǎn xián shì","abbr":"hgxs","explanation":"对别人的事表现出不应有的好奇。","example":{"text":"他～，经常自寻烦恼。"},"similar":["爱管闲事"],"usage":"作谓语、定语；指爱管闲事"},{"id":14321,"word":"好肉剜疮","pinyin":"hǎo ròu wān chuāng","abbr":"hrwc","explanation":"比喻无事生非，自寻烦恼。","source":{"text":"说佛说祖，正如好肉剜疮；举古举今，犹若残羹馊饭。","book":"宋·释惟白《续传灯录·慧通心旦》"},"example":{"text":"说迷说悟，犹是～，一切平常，尽落天魔外道。","book":"宋·释悟明《联灯会要·玑禅师》"},"similar":["无事生非"],"usage":"作谓语；比喻无事生非"},{"id":14322,"word":"好自为之","pinyin":"hào zì wéi zhī","abbr":"hzwz","explanation":"劝别人或自勉要好好地活下去或干下去。","source":{"text":"君人者不任能，而好自为之，则智日困而自负其责也。","book":"《淮南子·本经训》"},"example":{"text":"高阳《胡雪岩全传·萧瑟洋场》：“你断弦也有两年了，～。”"},"usage":"作谓语；用于劝诫人"},{"id":14323,"word":"好自矜夸","pinyin":"hào zì jīn kuā","abbr":"hzjk","explanation":"骄傲自满，喜欢夸耀自己。","source":{"text":"好自矜夸，饰非拒谏。","book":"《周书·宣帝纪》"},"usage":"作谓语、定语；用于为人"},{"id":14324,"word":"好船者溺，好骑者堕","pinyin":"hào chuán zhě nì，hào qí zhě duò","abbr":"hcznhqzd","explanation":"好：喜爱；溺：淹没。喜欢乘船的人往往会淹死，善于骑马的人往往会摔伤。比喻擅长某一技能的人，往往容易疏忽大意，反而遭到意外的失败。","source":{"text":"悲哉，夫好船者溺，好骑者堕，君子各以所好为祸。","book":"汉·袁康《越绝书·外传记吴王占梦》"},"similar":["骑者善堕"],"usage":"作宾语、定语；用于劝诫人","story":["春秋时期，吴王夫差灭掉越国之后更加得意忘形，他特别喜欢太宰伯憘拍马屁，大修姑苏台，杀了太师伍子胥，整天玩乐。一次叫术士公孙圣解梦，公孙圣说：“经常骑马的人往往会跌下来，大王不可好战。”夫差不听劝阻，反而杀了他"]},{"id":14325,"word":"好色不淫","pinyin":"hào sè bù yín","abbr":"hsby","explanation":"色：女色；淫：邪恶，过分。喜欢女色，但不过分。原是对《麻经·国风内容》的评价。后也用以泛指人。","source":{"text":"国风好色而不淫，小雅怨诽而不乱，若离骚者，可谓兼之矣。","book":"《史记·屈原贾生列传》"}},{"id":14326,"word":"好色之徒","pinyin":"hào sè zhī tú","abbr":"hszt","explanation":"喜欢女色、玩弄女性之人。","source":{"text":"无知骨子里是个好色之徒，怎敖得住！家里不能做手脚，便在外面寻花问柳。","book":"清·张南庄《何典》第八回"},"example":{"text":"他定是个～，偏偏象那蝶儿恋花一样的跟着我，可笑世间真有这么样的人呢。","book":"清·岭南羽衣女士《东欧女豪杰》第二回"},"similar":["酒色之徒"],"opposite":["不近女色"],"usage":"作主语、宾语；指贪爱女色"},{"id":14327,"word":"好色而恶心","pinyin":"hǎo sè ér ě xīn","abbr":"hseex","explanation":"容貌美丽但狠毒。","source":{"text":"虽好色，必恶心，不可谓好。","book":"《国语·晋语一》"}},{"id":14328,"word":"好行小惠","pinyin":"hào xíng xiǎo huì","abbr":"hxxh","explanation":"好：喜欢；行：施行；惠：仁慈。指喜欢给人小恩小惠。","source":{"text":"群居终日，言不及义，好行小惠，难矣哉。","book":"《论语·魏灵公》"},"example":{"text":"及在州，纲目不举，而～，夷夏颇安附之。","book":"《晋书·殷仲堪传》"},"similar":["好行小慧","好施小惠"],"usage":"作谓语、定语；指喜欢给人小恩小惠","story":["晋朝时期，荆州刺史殷仲堪特别节俭，对人却好行小惠。他在荆州期间遇到洪灾，他每顿只吃五个菜，连掉在桌上的饭粒都吃掉，他还经常告诫子侄们不要忘记自己曾经也贫穷过。由于他禀性直朴，深受百姓的喜爱"]},{"id":14329,"word":"好行小慧","pinyin":"hǎo xíng xiǎo huì","abbr":"hxxh","explanation":"爱耍小聪明。","source":{"text":"《论语·卫灵公》：“子曰：‘群居终日，言不及义，好行小慧，难矣哉！’”何晏集解引郑玄曰：“小慧，谓小小之才知。”慧，一本作“惠”。"},"similar":["好行小惠","好施小惠"],"usage":"作谓语、定语；用于为人"},{"id":14330,"word":"好衣美食","pinyin":"hǎo yī měi shí","abbr":"hyms","explanation":"美：美好。指吃好的，穿好的。","source":{"text":"且帝子何患不富贵，身食大国，封户不少，好衣美食。","book":"唐·马周《请崇节俭及制诸王疏》"},"similar":["锦衣玉食"],"usage":"作主语、宾语、定语；用于生活"},{"id":14331,"word":"好言好语","pinyin":"hǎo yán hǎo yǔ","abbr":"hyhy","explanation":"好：美好，友善。指友善和中听的言语。","source":{"text":"我晓得乡下人是刁恶不过，好言好语不肯听的！","book":"洪深《香稻米》第三幕"},"example":{"text":"我～批评他，挨了一顿骂。","book":"魏巍《老烟筒》"},"similar":["好声好气"],"usage":"作谓语、宾语、状语；指中听的言语"},{"id":14332,"word":"好言甘辞","pinyin":"hǎo yán gān cí","abbr":"hygc","explanation":"好言：甜美动听的语言；甘辞：逢迎讨好的言辞。甜美动听的逢迎之辞。","source":{"text":"数使使于汉，好言甘辞求请和亲。","book":"《史记·匈奴传》"}},{"id":14333,"word":"好言自口，莠言自口","pinyin":"hǎo yán zì kǒu，yǒu yán zì kǒu","abbr":"hyzkyyzk","explanation":"莠：丑，坏；莠言：坏话。好话坏话都出自一人之口。指人说话反复无常。","source":{"text":"不自我先，不自我后。好言自口，莠言自口。忧心愈愈，是以有侮。","book":"《诗经·小雅·正月》"},"usage":"作宾语、定语、分句；用于人说话等"},{"id":14334,"word":"好让不争","pinyin":"hào ràng bù zhēng","abbr":"hrbz","explanation":"乐于谦让，不喜欢与他人争执。","source":{"text":"如此看来，这几个交易光景，岂非好让不争的一幅行乐图么？","book":"清·李汝珍《镜花缘》第十一回"},"usage":"作谓语、定语；用于为人"},{"id":14335,"word":"好语似珠","pinyin":"hǎo yǔ sì zhū","abbr":"hysz","explanation":"指诗文中警句妙语很多。","source":{"text":"好语似珠穿一一，妄心如膜退重重。","book":"宋·苏轼《次韵答子由》"},"similar":["妙语如珠"],"usage":"作谓语、宾语；指诗文中多警语"},{"id":14336,"word":"好语如珠","pinyin":"hǎo yǔ rú zhū","abbr":"hyrz","explanation":"指诗文中警句妙语很多。","source":{"text":"好语如珠串一一，妄心如膜退重重。","book":"宋·苏轼《次韵答子由》诗"},"similar":["妙语如珠"],"usage":"作宾语、定语；用于文章或说话等"},{"id":14337,"word":"好说歹说","pinyin":"hǎo shuō dǎi shuō","abbr":"hsds","explanation":"形容用各种理由或方式请求或劝说。","source":{"text":"掌柜的便同他们好说歹说，说我们都是乡邻，你们也犯不着来害我。","book":"清·李宝嘉《文明小史》第三回"},"example":{"text":"对这种人～都没有用的。"},"usage":"作谓语、定语；指多方劝说"},{"id":14338,"word":"好谀恶直","pinyin":"hào yú wù zhí","abbr":"hyez","explanation":"谀：讨好奉承；直：正直。喜欢讨好奉承，厌恶正直劝谏。","source":{"text":"日事淫乐，好谀恶直，政事不修，群臣解体。","book":"明·冯梦龙《东周列国志》第五十八回"},"example":{"text":"今佞人超迁而群贤获罪，恐海内闻之，谓陛下～。","book":"《明史·王时柯传》"},"usage":"作谓语、定语；用于为人"},{"id":14339,"word":"好谋善断","pinyin":"hào móu shàn duàn","abbr":"hmsd","explanation":"善：擅长；断：决断。形容人能不断思考，并善于判断。","source":{"text":"畴咨俊茂，好谋善断。","book":"晋·陆机《辨亡论》上"},"similar":["多谋善断"],"opposite":["好谋无断"],"usage":"作谓语、定语；形容人勤于思考善于判断","story":["东汉末年，荆州牧刘表病死，刘表的儿子投降曹操。刘备被迫南撤，孙权派鲁肃去联络刘备，诸葛亮认为可以联吴抗曹。孙权多谋善断，分析曹操犯了用兵之忌，于是与蜀军在赤壁大破曹操号称80万大军，从而形成三足鼎立的局面"]},{"id":14340,"word":"好谋少决","pinyin":"hào móu shǎo jué","abbr":"hmsj","explanation":"好：喜爱，善于。善于谋划但缺少决断。","source":{"text":"袁公宽而不断，好谋而少决，不断则无威，少决则失后事，今虽强，终不能成大业。","book":"《三国志·魏志·杨阜传》"}},{"id":14341,"word":"好谋无决","pinyin":"hào móu wú jué","abbr":"hmwj","explanation":"好：喜爱，善于；谋：策划，思考。对问题思考策划得多，但却不能或不善于作出判断或决断。","source":{"text":"多端寡要，好谋无决。","book":"《三国志·魏志·郭嘉传》"}},{"id":14342,"word":"好谋无断","pinyin":"hào móu wú duàn","abbr":"hmwd","explanation":"好：喜爱，喜好；谋：计谋，谋划。爱用计谋，但缺少决断。形容人空有心计而没有胆略。","source":{"text":"袁绍色厉胆薄，好谋无断，干大事而惜身，见小利而忘命，非英雄也。","book":"明·罗贯中《三国演义》第21回"},"opposite":["好谋善断"],"usage":"作谓语、定语；用于为人"},{"id":14343,"word":"好谋而成","pinyin":"hào móu é chéng","abbr":"hmec","explanation":"好：喜欢，喜爱。指勤于思考，遇事能深思熟虑而办好事情。","source":{"text":"必也临事而惧，好谋而成者。","book":"《论语·述而》"},"example":{"text":"古所谓名将者，不必蒙轮拔距之材，拉虎披熊之力，要以义终始，～。","book":"《旧唐书·李光进等传论》"},"usage":"作谓语、定语；用于处事"},{"id":14344,"word":"好逸恶劳","pinyin":"hào yì wù láo","abbr":"hywl","explanation":"逸：安逸；恶：讨厌、憎恨。贪图安逸，厌恶劳动。","source":{"text":"其为疗也，有四难焉：自用意而不任臣，一难也；将身不谨，二难也；骨节不强，不能使药，三难也；好逸恶劳，四难也。","book":"《后汉书·郭玉传》"},"example":{"text":"岂古之人有所异哉？～，亦犹夫人之情也。","book":"清·黄宗羲《原君》"},"similar":["游手好闲","好吃懒做"],"opposite":["不辞辛劳","旰食宵衣"],"usage":"作谓语、定语；指人贪图安逸","story":["东汉时期，太医郭玉医术很高明，经常手到病除，他为人仁义厚道，为穷苦百姓治病尽心尽力，药到病除，为达官贵人治病经常不见效。汉和帝问他为什么会这样？郭玉回答达官贵人自做主张，态度不谦和，好逸恶劳，不愿配合治疗"]},{"id":14345,"word":"好酒贪杯","pinyin":"hào jiǔ tān bēi","abbr":"hjtb","explanation":"指喜欢喝酒。","source":{"text":"再向人间登一直，度脱了你个好酒贪杯的牛员外。","book":"元·无名氏《玩江亭》第二折"},"example":{"text":"保长王大廷只有一宗缺点：有点～。一喝醉了又会变得十足脓包，失掉了他那分坚韧的好性格。","book":"沙汀《酒后》"},"similar":["嗜酒如命"],"opposite":["滴酒不沾"],"usage":"作谓语、宾语；指喜欢喝酒"},{"id":14346,"word":"好问决疑","pinyin":"hào wèn jué yí","abbr":"hwjy","explanation":"喜欢向别人请教，以解决自己的疑问。"},{"id":14347,"word":"好问则裕","pinyin":"hào wèn zé yù","abbr":"hwzy","explanation":"好：喜欢；裕：富裕。遇到疑难就向别人请教，学识就会渊博精深。","source":{"text":"好问则裕，自用则小。","book":"《尚书·汤诰》"},"example":{"text":"《书》曰：～。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作谓语；指勤于别人请教，学识就会渊博"},{"id":14348,"word":"好风好雨","pinyin":"hào fēng hào yǔ","abbr":"hfhy","explanation":"好：喜欢。有人喜欢刮风，有人喜欢下雨。比喻每个人的兴趣和志向各不相同。","source":{"text":"庶民惟星，星有好风，星有好雨。","book":"《尚书·洪范》"}},{"id":14349,"word":"好马不吃回头草","pinyin":"hǎo mǎ bù chī huí tóu cǎo","abbr":"hmbchtc","explanation":"比喻有作为的人不走回头路。","source":{"text":"好马不吃回头草。既然他已经离开了老窝，就决心在外面的世界闯荡下去。","book":"路遥《平凡的世界》第三卷第32章"},"example":{"text":"～，既然选择辞职，就不顾及那么多了。"},"usage":"作宾语、定语；用于口语"},{"id":14350,"word":"好骑者堕","pinyin":"hào qí zhě duò","abbr":"hqzd","explanation":"惯于骑马的人常常会从马上摔下来。比喻善长某一技艺的人，往往因大意而招致失败。","source":{"text":"悲哉，夫好船者溺，好骑者堕，君子各以所好为祸。","book":"汉·袁康《越绝书·外传记吴王占梦》"},"similar":["骑者善堕"],"usage":"作宾语、定语；同“骑者善堕”","story":["春秋时期，吴王夫差灭掉越国之后更加得意忘形了。他特别喜欢听伯喜的拍马屁，大修姑苏台，杀了太师伍子胥，整天玩乐。一次他叫术士公孙圣解梦，公孙圣说：“经常骑马的人往往会跌下马来，大王不可好战。”"]},{"id":14351,"word":"好高骛远","pinyin":"hào gāo wù yuǎn","abbr":"hgwy","explanation":"好：喜欢；骛：追求。比喻不切实际地追求过高过远的目标。","source":{"text":"病学者厌卑近而骛高远，卒无成焉。","book":"《宋史·道学传一·程灏传》"},"example":{"text":"但是～，贪抄捷径的心理，却常常妨碍人们去认识这最普通的道理。","book":"秦牧《画蛋·练功》"},"similar":["好大喜功","急功近利"],"opposite":["实事求是","脚踏实地"],"usage":"作谓语、宾语、状语；指人不切实际"},{"id":14352,"word":"好高鹜远","pinyin":"hǎo gāo wù yuǎn","abbr":"hgwy","explanation":"指不自量力，不愿实际去处理事情。","example":{"text":"做事应脚踏实地，～、不切实际，是会一事无成的。"}},{"id":14353,"word":"如不胜衣","pinyin":"rú bù shèng yī","abbr":"rbsy","explanation":"胜：能承受，能承担。身体不能承受衣服的重量。形容身体瘦弱。也形容谦退的样子。","source":{"text":"叶公子高，微小短瘠，行若将不胜其衣然。","book":"《荀子·非相》"},"example":{"text":"敷形貌眇小，～，胆力劲果，超出时辈。","book":"《南史·周敷传》"},"similar":["弱不禁风","若不胜衣"],"usage":"作谓语、定语；指人衰弱"},{"id":14354,"word":"如丘而止","pinyin":"rú qiū ér zhǐ","abbr":"rqez","explanation":"如：到达；丘：丘陵；止：止步。指遇到困难则停下来，不求上进。","source":{"text":"如垤而进，吾与之；如丘而止，吾已矣。","book":"《荀子·宥坐》"},"similar":["不求上进","知难而退"],"usage":"作谓语、定语；指不求上进"},{"id":14355,"word":"如丧考妣","pinyin":"rú sàng kǎo bǐ","abbr":"rskb","explanation":"丧：死去；考：父亲；妣：母亲。好像死了父母一样地伤心。","source":{"text":"二十有八载，帝乃殂落，百姓如丧考妣。","book":"《尚书·舜典》"},"example":{"text":"上帝啊！教我三魂七魄飞天外。真个是～，昏迷苫块。","book":"赵朴初《某公三哭·哭西尼》"},"similar":["悲痛欲绝","痛不欲生"],"opposite":["喜笑颜开","喜形于色"],"usage":"作谓语、定语、状语；指极度悲伤","story":["战国时期，鲁国人蒙丘向老师孟子请教舜做天子时，他的父亲也面北朝见他，尧也率诸侯朝见他，这是否违背礼法？孟子说事实上尧是在年老后才将帝位让给舜的，尧死时，老百姓如丧考妣，舜率百姓服丧三年，停止娱乐"]},{"id":14356,"word":"如临大敌","pinyin":"rú lín dà dí","abbr":"rldd","explanation":"临：面临。好像面对着强大的敌人。形容把本来不是很紧迫的形势看得十分严重。","source":{"text":"到了抚院，又碰了止辕，衙门里扎了许多兵，如临大敌。","book":"清·吴趼人《二十年目睹之怪现状》第五十八回"},"example":{"text":"他们全副武装地散开，～。"},"similar":["小题大作","如临深渊"],"opposite":["临危不惧","如坐春风"],"usage":"作谓语、定语、状语；形容非常紧张","story":["唐朝末年，黄巢率军起义，攻占了京城长安，唐僖宗仓惶出逃，任命进士出身的郑畋为凤翔节度使，让他坚守凤翔。郑畋到凤翔修造战车、扩充军队、加固城墙，把自己的家产分给士兵，军队日夜都如临大敌，打败尚让率领的5万大军"]},{"id":14357,"word":"如临深渊","pinyin":"rú lín shēn yuān","abbr":"rlsy","explanation":"临：靠近；渊：深水坑。如同处于深渊边缘一般。比喻存有戒心，行事极为谨慎。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗·小雅·小旻》"},"example":{"text":"黄帝居人上，惴惴～。","book":"明·李贽《初潭集·君臣一》"},"similar":["如履薄冰","如临深谷"],"opposite":["如履平地"],"usage":"作谓语、定语、状语；用于人的处境","story":["东汉明帝皇后马氏生性善良，深明大义，她十分喜欢贾妃所生的刘炟。刘炟继位成汉章帝，尊马氏为皇太后，多次提出加封马氏的兄弟，马后拒绝。而她的侄子马豫抱怨没得到更多的恩惠，杨终劝马廖面临深渊，脚踏薄冰，不能放纵儿子"]},{"id":14358,"word":"如临深谷","pinyin":"rú lín shēn gǔ","abbr":"rlsg","explanation":"好像到了深深的山谷边上。比喻行事十分警惕，小心谨慎。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"如潜有所得，专～，战如履薄冰，此得道之门耳。","book":"宋·张君房《云笈七签》九十八"},"similar":["如临深渊"],"usage":"作谓语、定语、状语；用于人的处境"},{"id":14359,"word":"如之奈何","pinyin":"rú zhī nai hé","abbr":"rznh","explanation":"怎么办。","source":{"text":"倘或被眼病手快的拿了送官，如之奈何？","book":"《水浒传》第四三回"},"example":{"text":"但你已许人，我已聘妇，没甚计策挽回，～？","book":"《醒世恒言·乔太守乱点鸳鸯谱》"},"usage":"作谓语、状语；用于书面语"},{"id":14360,"word":"如人饮水，冷暖自知","pinyin":"rú rén yǐn shuǐ，lěng nuǎn zì zhī","abbr":"rryslnzz","explanation":"泛指自己经历的事，自己知道甘苦。","source":{"text":"明于言下忽然默契，便礼拜云：‘如人饮水，冷暖自知，某甲在五祖会中，枉用三十年工夫。’","book":"唐·裴休《黄蘖山断际禅师传心法要》"},"example":{"text":"某甲虽在黄梅随众，实未省自己面目。今蒙指受入处，～，行者即是某甲师也。","book":"宋·释道原《景德传灯录》"},"similar":["如鱼饮水，冷暖自知"],"usage":"作宾语、分句；指直接经历的事自己了解"},{"id":14361,"word":"如兄如弟","pinyin":"rú xiōng rú dì","abbr":"rxrd","explanation":"情如兄弟。比喻彼此感情好，关系密切。","source":{"text":"宴尔新婚，如兄如弟。","book":"《诗经·邶风·谷风》"},"example":{"text":"如此，其为同调相怜，～者益见。","book":"清·无名氏《杜诗言志》卷一"},"similar":["情同手足"],"opposite":["如狼似虎"],"usage":"作谓语、定语；比喻彼此感情好","story":["我国最早的诗歌总集《诗经》中有一首描写丈夫的无情及弃妇的痴情的诗《谷风》，妇人被丈夫抛弃，她迟迟不肯离去，对照自己的新婚之乐，当时丈夫对她的感情很深，如兄如弟一般，现在无情地抛弃，自己只好承受这无限的痛苦"]},{"id":14362,"word":"如入宝山空手回","pinyin":"rú rù bǎo shān kōng shǒu huí","abbr":"rrbsksh","explanation":"宝山：聚集宝物的山。象进入了宝山却没有拿到宝物空手回来一样。比喻本来应有很大收获，却是一无所获而归。","source":{"text":"正是当权若不行方便，如入宝山空手回。","book":"元·杨显之《酷寒亭》楔子"},"example":{"text":"若临歧舌不知韵，～。","book":"清·李汝珍《镜花缘》第二十八回"},"usage":"作谓语、定语；用于处事"},{"id":14363,"word":"如入无人之地","pinyin":"rú rù wú rén zhī dì","abbr":"rrwrzd","explanation":"像到了没有人的地方。形容作战勇敢，无人敢阻挡。","source":{"text":"彼狃于数胜，谓我不能军，往事如入无人之地；出其不意，可以得志。","book":"明·归有光《备倭事略》"},"similar":["如入无人之境"],"usage":"作谓语、定语、分句；形容作战勇敢"},{"id":14364,"word":"如入无人之境","pinyin":"rú rù wú rén zhī jìng","abbr":"rrwrzj","explanation":"境：地方。象到了没有人的地方。比喻打仗节节胜利，没有遇到抵抗。","source":{"text":"及一旦王伦张海等相继而起，入州入县，如入无人之境。","book":"宋·欧阳修《再论置兵御贼札子》"},"example":{"text":"一辆汽车飞驰在又宽又平的高速公路上，真是～。"},"similar":["如入无人之地"],"opposite":["壁垒森严"],"usage":"作谓语、定语、分句；形容作战勇敢"},{"id":14365,"word":"如入芝兰之室，久而不闻其香","pinyin":"rú rù zhī lán zhī shì，jiǔ ér bù wén qí xiāng","abbr":"rrzlzsjebwqx","explanation":"芝：通“芷”，香草；兰：香草。好像进入满是香草的房间，闻久了就不能闻出香味。比喻在某种环境里呆久了，习以为常。","source":{"text":"与善人居，如入芝兰之室，久而不闻其香。","book":"三国·魏·王肃《孔子家语》"},"similar":["如入鲍鱼之肆，久而不闻其臭"],"usage":"作宾语、定语、分句；用于书面语"},{"id":14366,"word":"如入鲍鱼之肆，久而不闻其臭","pinyin":"rú rù bào yú zhī sì，jiǔ ér bù wén qí chòu","abbr":"rrbyzsjebwqc","explanation":"鲍鱼：咸鱼；肆：店铺。如同进入咸鱼店，时间一长就闻不到它的腥臭味。比喻环境对人的熏染和影响。","source":{"text":"与不善人居，如入鲍鱼之肆，久而不闻其臭，亦与之化矣。","book":"三国·魏·王肃《孔子家语·六本》"},"similar":["入鲍忘臭"],"usage":"作宾语、定语、分句；用于书面语"},{"id":14367,"word":"如入鲍鱼之肆，久闻不知其臭","pinyin":"rú rù bào yú zhī sì，jiǔ wén bù zhī qí chòu","abbr":"rrbyzsjwbzqc","explanation":"鲍鱼：咸鱼；肆：店铺。好像进了卖咸鱼的店，时间长了就闻不到腥味了。比喻环境熏染对人的影响极大。","source":{"text":"与恶人居，如入鲍鱼之肆，久而不闻其臭，亦与之化矣。","book":"汉·刘向《说苑·杂言》"}},{"id":14368,"word":"如出一口","pinyin":"rú chū yī kǒu","abbr":"rcyk","explanation":"象从一张嘴里说出来的。形容许多人说法一样。","source":{"text":"州侯相荆，贵而主断，荆王疑之，因问左右，左右对曰‘无有’，如出一口也。","book":"《韩非子·内储说下》"},"example":{"text":"杀伤疾患，十室九空。百姓怨嗟，～。","book":"唐·韩愈《黄家贼事宜状》"},"similar":["众口一词","异口同声"],"opposite":["众说纷纭"],"usage":"作谓语；形容许多人说法一样","story":["传说战国时期，有一个燕国人经常外出，他的妻子与一个士人通奸，正逢他从外边回来，遇到士人离开。丈夫问妻子是那里的客人，妻子掩饰说没有。他去问家里其他下人，下人为了他的脸面也同的妻子一样说没有"]},{"id":14369,"word":"如出一轨","pinyin":"rú chū yī guǐ","abbr":"rcyg","explanation":"轨：车轮碾轧的痕迹。好像出自同一个车轨。比喻两件事情非常相似。","source":{"text":"此四人之过，如出一辙。","book":"宋·洪迈《容斋随笔》卷十一"},"example":{"text":"处温逼魏王以僭号，结宋将以卖国，迹其奸佞，～。","book":"《辽史·李处温传》"}},{"id":14370,"word":"如出一辙","pinyin":"rú chū yī zhé","abbr":"rcyz","explanation":"辙：车轮碾轧的痕迹。好像出自同一个车辙。比喻两件事情非常相似。","source":{"text":"此四人之过，如出一辙。","book":"宋·洪迈《容斋随笔》卷十一"},"example":{"text":"遥远相隔的民族有着这样～的民族传说。","book":"秦牧《宣扬友爱的民族传说》"},"similar":["如同一口","大同小异","一模一样"],"opposite":["背道而驰","大相径庭","迥然不同"],"usage":"作谓语、宾语、定语；用于言论和行动","story":["宋朝时期，学者洪迈在《容斋随笔》中指出：历史上一些名将威震一时，立过盖世之功，由于恃功自傲，骄傲轻敌，最后都以失败而告终，汉将关羽、西魏名将王思政、北齐名将慕容绍宗和南朝名将吴明彻四人所犯错误都如出一辙"]},{"id":14371,"word":"如切如磋","pinyin":"rú qiē rú cuō","abbr":"rqrc","explanation":"比喻互相商讨砥砺。","source":{"text":"瞻彼淇奥，绿竹猗猗。有匪君子，如切如磋，如琢如磨。","book":"《诗·卫风·淇奥》"},"example":{"text":"你们自幼就该互相砥砺，～，才能上进！","book":"端木蕻良《曹雪芹》第二三章"},"similar":["如切如磋，如琢如磨"],"usage":"作宾语、定语；用于书面语"},{"id":14372,"word":"如切如磋，如琢如磨","pinyin":"rú qiē rú cuō，rú zhuó rú mó","abbr":"rqrcrzrm","explanation":"切、磋、琢、磨：将骨、角、玉、石一类磨制成器物。好像把骨角玉石加工成器物那样。比喻共同商讨，互相砥砺。","source":{"text":"有匪君子，如切如磋，如琢如磨。","book":"《诗经·卫风·淇奥》"},"example":{"text":"刘少奇《论共产党员的休养》：“《诗经》上有这样著名的诗句：‘～’。这是说朋友之间要互相帮助，互相批评。”"},"similar":["如切如磋","如琢如磨"],"usage":"作宾语、定语；用于书面语"},{"id":14373,"word":"如原以偿","pinyin":"rú yuán yǐ cháng","abbr":"ryyc","explanation":"指愿望得到实现。"},{"id":14374,"word":"如古涵今","pinyin":"rú gǔ hán jīn","abbr":"rghj","explanation":"包容吞吐古今。形容学识渊博。","source":{"text":"茹古涵今，无有端涯；浑浑灏灏，不可窥校。","book":"唐·皇甫湜《韩文公墓志铭》"}},{"id":14375,"word":"如响之应声","pinyin":"rú xiǎng zhī yìng shēng","abbr":"rxzys","explanation":"比喻对答迅速，反应极快。","source":{"text":"然故下之事上也，如响之应声也；臣之事主也，如影之从形也。","book":"《管子·任法》"},"example":{"text":"块然保真，抱德推诚，天下从之，～，景之像形，其所修者本也。","book":"《淮南子·主术训》"}},{"id":14376,"word":"如响而应","pinyin":"rú xiǎng ér yìng","abbr":"rxey","explanation":"比喻对答迅速，反应极快。","source":{"text":"其动若水，其静若镜，其应若响。","book":"《庄子·天下》"},"example":{"text":"他的报告～，反应强烈"},"similar":["其应若响"],"usage":"作谓语、宾语；指回声很大"},{"id":14377,"word":"如嚼鸡肋","pinyin":"rú jiáo jī lèi","abbr":"rjjl","explanation":"鸡肋：鸡的肋骨。比喻对事情的兴趣不大或少有实惠。","source":{"text":"夫鸡肋，弃之可惜，食之无所得，以比汉中，知王欲还也。","book":"晋·司马彪《九州春秋》"},"example":{"text":"这样做就～一样。"},"similar":["味如鸡肋"],"opposite":["津津有味"],"usage":"作谓语、宾语、定语；指少有实惠","story":["公元217年，夏侯渊被刘备杀死，汉中失守。曹操率大军前去汉中，双方对峙几个月，曹军处境越来越不妙。一天晚上曹操吃饭发现汤中有鸡肋，随口说出“鸡肋”两字，被杨修误以为是退兵的意思。第二天曹操果然下令回师"]},{"id":14378,"word":"如圭如璋","pinyin":"rú guī rú zhāng","abbr":"rgrz","explanation":"圭、璋：古代非常贵重的玉制礼器。象圭和璋一样。比喻人的气质高雅或仪表轩昂。","source":{"text":"颙颙卬卬，如圭如璋。","book":"《诗经·大雅·卷阿》"},"example":{"text":"今见其进止风仪，真所谓～，观其性质，足能抚集本部。","book":"《晋书·刘宣传》"},"similar":["如珪如璋"],"usage":"作谓语、定语；用于比喻句"},{"id":14379,"word":"如坐云雾","pinyin":"rú zuò yún wù","abbr":"rzyw","explanation":"象坐在云里雾里。比喻头脑糊涂，不能辨析事理。","source":{"text":"及有凶吉大事，议论得失，蒙然张口，如坐云雾。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["如堕烟海"],"usage":"作谓语；指糊涂"},{"id":14380,"word":"如坐春风","pinyin":"rú zuò chūn fēng","abbr":"rzcf","explanation":"象坐在春风中间。比喻同品德高尚且有学识的人相处并受到熏陶。","source":{"text":"朱公掞见明道于汝州，逾月而归。语人曰：‘光庭在春风中坐了一月。’","book":"宋·朱熹《伊洛渊源录》卷四"},"example":{"text":"（鲁迅先生）说话时态度镇静，亲切而又从容，使听的人心情舒畅，真个有“～”的感觉。","book":"唐弢《琐忆》"},"similar":["如沐春风","春风化雨"],"opposite":["如坐针毡"],"usage":"作谓语；指遇到良师","story":["宋朝时期，朱光庭是理学大师程颢的弟子，他在汝州听程颢讲学，如痴如狂，听了一个多月才回家，回家逢人便夸老师讲学的精妙，他说：“光庭在春风中坐了一月。”"]},{"id":14381,"word":"如坐针毡","pinyin":"rú zuò zhēn zhān","abbr":"rzzz","explanation":"象坐在插着针的毡子上。形容心神不定，坐立不安。","source":{"text":"累迁太子中舍人。性亮直忠烈，屡谏愍怀太子，言辞恳切，太子患之。后置针着锡常所坐处毡中，刺之流血。","book":"《晋书·杜锡传》"},"example":{"text":"却说三巧儿自丈夫出堂之后，～，一闻得退衙，便迎住问个消息。","book":"明·冯梦龙《古今小说》卷一"},"similar":["坐立不安","手足无措","局促不安"],"opposite":["泰然自若","心安理得","从容不迫"],"usage":"作谓语、宾语、定语；形容心情不安","story":["晋武帝司马炎死后，司马衷即位为晋惠帝，晋惠帝立司马睿为太子。司马睿很不争气，没有政治抱负，爱好经商。他恨经常劝他从政的太子中舍人杜锡，就把针插在杜锡的座垫上，扎得杜锡臀部流血，他觉得很开心"]},{"id":14382,"word":"如坠五里雾中","pinyin":"rú zhuì wǔ lǐ wù zhōng","abbr":"rzwlwz","explanation":"坠：落下。比喻陷入一片混沌糊涂的境地，令人摸不着头脑。","source":{"text":"刘谓王曰：‘渊源真可！’王曰：‘卿故坠其云雾中’。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"今天呼兄唤弟，明天大杀大砍，使人眼花缭乱，～。","book":"陶菊隐《北洋军阀统治时期史话》第70章"},"similar":["如堕云雾"],"usage":"作谓语、定语；用于比喻句"},{"id":14383,"word":"如埙如箎","pinyin":"rú xūn rú chí","abbr":"rxrc","explanation":"埙：古时用土制成的乐器；箎：古时用竹管制成的乐器。象埙、箎的乐音一般和谐。比喻兄弟和睦。","source":{"text":"天之牖民，如埙如箎。","book":"《诗·大雅·板》"}},{"id":14384,"word":"如埙如篪","pinyin":"rú xūn rú chí","abbr":"rxrc","explanation":"埙、篪、乐器名。这两种乐器合奏时，埙唱而篪和，用以比喻两物之响应、应和。","source":{"text":"如埙如篪，言相和也。","book":"《诗·大雅·板》：“天之牖民，如埙如篪。”毛传"},"similar":["如埙如箎"],"usage":"作谓语、定语；用于兄弟间"},{"id":14385,"word":"如堕云雾","pinyin":"rú duò yún wù","abbr":"rdyw","explanation":"堕：落。好像掉在烟雾之中。比喻迷失方向，找不到头绪，不得要领。","source":{"text":"问以经济策，茫如堕烟雾。","book":"唐·李白《嘲鲁儒》诗"}},{"id":14386,"word":"如堕五里雾中","pinyin":"rú duò wǔ lǐ wù zhōng","abbr":"rdwlwz","explanation":"好像掉在一片大雾里。比喻陷入迷离恍惚、莫名其妙的境地。","source":{"text":"性好道术，能作五里雾。","book":"《后汉书·张楷传》"},"example":{"text":"这一连串的问题，使他～，十分疑虑。"},"similar":["如堕烟雾"],"opposite":["清清楚楚"],"usage":"作谓语；比喻陷入迷离恍惚的境地"},{"id":14387,"word":"如堕烟海","pinyin":"rú duò yān hǎi","abbr":"rdyh","explanation":"堕：落。好像掉在茫茫无边的烟雾里。比喻迷失方向，找不到头绪，抓不住要领。","source":{"text":"王仲祖、刘真长造殷中军谈，谈竟俱载去。刘谓王曰：‘渊源真可！’王曰：‘卿故堕其云雾中。’","book":"南朝宋·刘义庆《世说新语·赏誉》"},"example":{"text":"万千的学问家和实行家，不懂得这种方法，结果～，找不到中心，也就找不到解决矛盾的方法。","book":"毛泽东《矛盾论》"},"similar":["雾里看花","如坐云雾"],"opposite":["豁然开朗","显而易见"],"usage":"作谓语、宾语、补语；比喻迷失方向"},{"id":14388,"word":"如堕烟雾","pinyin":"rú duò yān wù","abbr":"rdyw","explanation":"堕：落。好像掉在烟雾之中。比喻迷失方向，找不到头绪，不得要领。","source":{"text":"问以经济策，茫如堕烟雾。","book":"唐·李白《嘲鲁儒》诗"},"example":{"text":"茫茫～，瞪目挢舌不能语。","book":"清·梁启超《读日本目志书后》"},"similar":["如堕烟海"],"opposite":["显而易见"],"usage":"作谓语、宾语、补语；比喻迷失方向"},{"id":14389,"word":"如天之福","pinyin":"rú tiān zhī fú","abbr":"rtzf","explanation":"形容福气特别大。","source":{"text":"把如天之福，没来由选择伊家。","book":"明·叶宪祖《鸾鎞记·挫权》"},"example":{"text":"一版能卖完，已属～也。","book":"鲁迅《书信集·致曹聚仁》"},"similar":["洪福齐天"],"usage":"作宾语；用于书面语"},{"id":14390,"word":"如失左右手","pinyin":"rú shī zuǒ yòu shǒu","abbr":"rszys","explanation":"好像失去了左手和右手一样。比喻失去了得力的助手。","source":{"text":"人有言上曰：‘丞相何亡。’上大怒，如失左右手。","book":"《史记·淮阴侯列传》"},"example":{"text":"备闻公将去，～，虽龙肝凤髓，亦不甘味。","book":"明·罗贯中《三国演义》第三十六回"}},{"id":14391,"word":"如如不动","pinyin":"rú rú bù dòng","abbr":"rrbd","explanation":"如如：佛家语，常在的意思。事物常在，没有什么变化。","source":{"text":"不敢于相，如如不动。","book":"《金刚经》第三十二节"},"example":{"text":"渺渺无为浑太乙，～号初玄。","book":"明·吴承恩《西游记》第七回"}},{"id":14392,"word":"如履如临","pinyin":"rú lǚ rú lín","abbr":"rlrl","explanation":"形容做事极为小心谨慎。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"朕守大器之重，居兆人之上，日慎一日，～。","book":"《旧唐书·僖宗纪》"},"usage":"作谓语、定语；用于处事"},{"id":14393,"word":"如履平地","pinyin":"rú lǚ píng dì","abbr":"rlpd","explanation":"履：踩。像走在平地上一样。比喻从事某项活动十分顺利。","source":{"text":"因夷人卖奴，年十四五，视其貌甚慧黠。言善入水，如履平地。","book":"唐·裴铏《周邯》"},"example":{"text":"一个最勇敢的叫徐骧，生的矮小精悍，膂力过人，跳山越涧，～。","book":"清·曾朴《孽海花》第三十三回"},"usage":"作谓语、定语、状语；用于处事"},{"id":14394,"word":"如履春冰","pinyin":"rú lǚ chūn bīng","abbr":"rlcb","explanation":"履：踩。好像踩着春天薄薄的冰。比喻在危险的境地而提心吊胆。","source":{"text":"退思尘忝，如履春冰。","book":"唐·刘禹锡《让同平章事表》"},"similar":["如履薄冰"],"usage":"作谓语、定语、状语；用于处事"},{"id":14395,"word":"如履薄冰","pinyin":"rú lǚ bó bīng","abbr":"rlbb","explanation":"履：践、踩在上面。象走在薄冰上一样。比喻行事极为谨慎，存有戒心。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"忠恪祗顺，～。","book":"三国·魏·曹操《请爵荀彧表》"},"similar":["如临深渊","胆战心惊","如履春冰"],"opposite":["如履平地"],"usage":"作谓语、定语、状语；用于事情的危机","story":["东汉明帝皇后马氏生性善良，深明大义，她十分喜欢贾妃所生的刘炟。刘炟继位成汉章帝，尊马氏为皇太后，多次提出加封马氏的兄弟，马后拒绝。而她的侄子马豫抱怨没得到更多的恩惠，杨终劝马廖面临深渊，脚踏薄冰，不能放纵儿子"]},{"id":14396,"word":"如山似海","pinyin":"rú shān sì hǎi","abbr":"rssh","explanation":"人多的象山和海一样。形容人聚集得非常多。","source":{"text":"每日有那一般打散，或是戏舞，或是吹弹，或是歌唱，赚得那人山人海价看。","book":"明·施耐庵《水浒全传》第五十一回"},"example":{"text":"九月十六是陈公公母亲的寿日，陈公公新管了东厂，好不声势。来与陈太太做生日的～。","book":"濔·西周生《醒世姻缘传》第七十回"}},{"id":14397,"word":"如山压卵","pinyin":"rú shān yā luǎn","abbr":"rsyl","explanation":"比喻以绝对优势对付劣势。","source":{"text":"刘崇乌合之众，苟遇王师，必如山压卵耳。","book":"《旧五代史·周书·世宗纪》"},"example":{"text":"以义斌蹙全，～。","book":"《宋史·赵范传》"},"usage":"作宾语、定语；用于比喻句"},{"id":14398,"word":"如左右手","pinyin":"rú zuǒ yòu shǒu","abbr":"rzys","explanation":"象自己的左右手一样。比喻极得力的助手。也比喻两者关系极为密切或配合得很好。","source":{"text":"人有言上曰：‘丞相何亡。’上大怒，如失左右手。","book":"《史记·淮阴侯列传》"},"example":{"text":"周访与侃亲姻，～，安有断人左手而右手不应者乎！","book":"《晋书·陶侃传》"},"similar":["情同手足"],"usage":"作谓语；指密切配合","story":["秦朝末年，韩信前去投奔刘邦，被安排当管粮的小官。刘邦拔营准备到汉中封地，很多军官悄悄地逃走，韩信也趁机逃走，萧何得知后来不及告诉刘邦就连夜去追。刘邦不见萧何，他对萧何的感觉如左右手，有些想不通。两天后萧何追回韩信"]},{"id":14399,"word":"如应斯响","pinyin":"rú yìng sī xiǎng","abbr":"rysx","explanation":"形容反响极快。","source":{"text":"那满招损、乖致戾的道理，如应斯响。","book":"清·文康《儿女英雄传》第29回"},"usage":"作谓语；形容反响极快"},{"id":14400,"word":"如开茅塞","pinyin":"rú kāi máo sè","abbr":"rkms","explanation":"象打开被茅草堵塞的道路一样。形容受到别人启发后，由对某件事物迷茫不解，变得立刻就明白了。","example":{"text":"今听麾下谈兵，～，也感到惭愧得很。","book":"姚雪垠《李自成》第二卷第五十二章"}},{"id":14401,"word":"如弃敝屣","pinyin":"rú qì bì xǐ","abbr":"rqbx","explanation":"丢掉无用的东西，一点也不可惜。","source":{"text":"舜视弃天下，犹弃敝蹝也。","book":"《孟子·尽心上》"},"example":{"text":"倘此时有龙凤迎寡人，寡人视弃山河～耳。","book":"明·冯梦龙《东周列国志》第四十七回"},"similar":["弃若敝屣"],"usage":"作谓语、状语；指毫不可惜"},{"id":14402,"word":"如影随形","pinyin":"rú yǐng suí xíng","abbr":"rysx","explanation":"好像影子总是跟着身体一样。比喻两个人关系亲密，常在一起。","source":{"text":"故天之应人，如影之随形，响之效声者也。","book":"《管子·任法》：“然故下之事上也，如响之应声也；臣之事主也，如影之从形也。”汉·刘向《说苑·君道》"},"example":{"text":"善恶昭彰，～。","book":"清·李汝珍《镜花缘》第七十一回"},"similar":["形影不离","亲密无间"],"opposite":["格格不入"],"usage":"作谓语、宾语、定语、分句；形容关系密切"},{"id":14403,"word":"如恐不及","pinyin":"rú kǒng bù jí","abbr":"rkbj","explanation":"及：追上，赶上。就象怕追赶不上。","source":{"text":"载在相位多年，权倾四海，外方珍异，皆集其门，资货不可胜计，故伯和、仲武等得肆其志。轻浮之士，奔其门者，如恐不及。","book":"《旧唐书·元载传》"},"example":{"text":"唯其不同，调处得法反而有个一致性，向理想奔赴～。","book":"沈从文《自传编零·我的学习》"}},{"id":14404,"word":"如意延年","pinyin":"rú yì yán nián","abbr":"ryyn","explanation":"延年：延长寿命。对一切乐观的人，能够健康长寿。","source":{"text":"得众动天，美意延年。","book":"《荀子·致士》"},"example":{"text":"花合欢兮并蒂长春，人合欢兮～。","book":"清·许叔平《里乘·雄黄弹》"}},{"id":14405,"word":"如意算盘","pinyin":"rú yì suàn pán","abbr":"rysp","explanation":"比喻考虑问题时从主观愿望出发，只从好的方面着想打算。","source":{"text":"好便宜！你倒会打如意算盘！十三个半月工钱，只付三个月！你同我了事，我却不同你干休！","book":"清·李宝嘉《官场现形记》第四十四回"},"example":{"text":"振铎常打～，结果似乎不如意的居多。","book":"鲁迅《书信集·致沈雁宾》"},"similar":["一厢情愿"],"opposite":["竹篮打水","南柯一梦"],"usage":"作主语、宾语、定语；指一厢情愿的打算","story":["传说清朝下台官员申守尧家里穷得叮当响，他还摆出一副官老爷的架子到处吹牛，无所事事。一次他家的老妈子当他朋友的面要他脱衣去典当钱买米，他很气愤地要不给钱炒掉她。老妈子说：“你倒会打如意算盘，一个工钱也不能少。”"]},{"id":14406,"word":"如意郎君","pinyin":"rú yì láng jūn","abbr":"rylj","explanation":"如意：符合心意；郎君：妇女对丈夫的称呼。指称心如意的丈夫。","source":{"text":"算计自家这样的女儿，那般的声势，一定要配一个风流熨贴的如意郎君，方不辜负他女儿的才貌。","book":"清·张春帆《九尾龟》第四十九回"},"example":{"text":"她自己嫁得～，就不念别人相思之苦？我这宝贝女儿就只向着丈夫。","book":"金庸《神雕侠侣》第十五回"}},{"id":14407,"word":"如愿以偿","pinyin":"rú yuàn yǐ cháng","abbr":"ryyc","explanation":"偿：实现、满足。按所希望的那样得到满足。指愿望实现。","source":{"text":"况且他家里人既然有心弄死他，等如愿以偿之后，贼人心虚，怕人议论，岂有不尽力推在医生身上之理？","book":"清·吴趼人《二十年目睹之怪现状》第一百一回"},"example":{"text":"他终于～，考上的北京大学。"},"similar":["称心如意","天从人愿"],"opposite":["难偿所愿","事与愿违"],"usage":"作谓语、宾语、状语；指愿望实现","story":["唐代庐陵书生欧明没有门路考取功名，只好与朋友去南海做生意，他们到彭泽，在湖上谈论传说中的青洪君，欧明很敬佩青洪君，忽然湖面出现一条大道，青洪君派使者请欧明下去，把婢女“如愿”嫁给他，从此他们事事如愿过上幸福的日子"]},{"id":14408,"word":"如手如足","pinyin":"rú shǒu rú zú","abbr":"rsrz","explanation":"手足：比喻兄弟。比喻兄弟的感情。","source":{"text":"谁无兄弟，如足如手。","book":"唐·李华《吊古战场文》"}},{"id":14409,"word":"如拾地芥","pinyin":"rú shí dì jiè","abbr":"rsdj","explanation":"地芥：地上的小草。象从地下拾起一根芥菜。比喻非常容易得到（多指官职、名位）。","source":{"text":"士病不明经术，经术苟明，其取青紫，犹俯拾地芥耳。","book":"《汉书·夏侯胜传》"},"example":{"text":"辎軿青紫，～，而惰游废业，十室而九。","book":"南朝·梁·任彦升《天监三年策秀才文》"},"similar":["轻而易举"],"opposite":["难上加难"],"usage":"作谓语、状语；比喻非常容易得到"},{"id":14410,"word":"如持左券","pinyin":"rú chí zuǒ quàn","abbr":"rczq","explanation":"左券：古代契约分左右两片，双方各执其一，左片叫左券，由债权人收藏，作为凭据。好像手里执有左券。比喻把握住了事情的结局。","source":{"text":"公常执左券以责于秦韩。","book":"《史记·田敬仲完世家》"},"example":{"text":"人生为农最可愿，得饱正～。","book":"宋·陆游《禽言打麦作饭》诗"},"similar":["如操左券"],"usage":"作谓语、定语；用于处事"},{"id":14411,"word":"如指诸掌","pinyin":"rú zhǐ zhū zhǎng","abbr":"rzzz","explanation":"比喻事情很容易办到。","source":{"text":"或问禘之说。子曰：‘不知也，知其说者之于天下也，其如示诸斯乎。’指其掌。","book":"《论语·八佾》"},"example":{"text":"寿皇论天下事，～，风生颖脱，有过人者。","book":"宋·杨万里《荐举王自中曾集徐元德政绩同抚司奏状》"},"similar":["了如指掌"],"usage":"作谓语、定语；用于书面语"},{"id":14412,"word":"如振落叶","pinyin":"rú zhèn luò yè","abbr":"rzly","explanation":"形容轻而易举。","source":{"text":"明·崔铣《洹词·记王忠肃公翱三事》"},"example":{"text":"这事对她来说简直是～，不费吹灰之力"},"usage":"作谓语、定语；用于比喻句"},{"id":14413,"word":"如操左券","pinyin":"rú cāo zuǒ quàn","abbr":"rczq","explanation":"比喻很有把握。同“如持左券”。","source":{"text":"督、抚两大人这次用兵，计虑周详，胜利如操左券。","book":"姚雪垠《李自成》第二卷第二章"},"similar":["如持左券"],"usage":"作谓语、定语；用于处事"},{"id":14414,"word":"如数家珍","pinyin":"rú shǔ jiā zhēn","abbr":"rsjz","explanation":"好像数自己家藏的珍宝那样清楚。比喻对所讲的事情十分熟悉。","source":{"text":"地理沿革，官制变置，元史姓氏，有诘之者，从容应答，如数家珍焉。","book":"清·江藩《汉学师承记·七·凌廷堪》"},"example":{"text":"某也贤，某也不肖，一一～。","book":"柳亚子《二十世纪大舞台发刊词》"},"similar":["了如指掌","了然入怀","一五一十"],"opposite":["一无所知"],"usage":"作谓语、状语、补语；指十分熟悉"},{"id":14415,"word":"如斯而已","pinyin":"rú sī ér yǐ","abbr":"rsey","explanation":"如斯：象这样；而已：罢了。就是这样罢了。","source":{"text":"子路问君子，子曰：‘修己以敬。’曰：‘如斯而已乎？’曰：‘修己以安人。’曰：‘如斯而已乎？’曰：‘修己以安百姓。修己以安百姓，尧、舜其犹病诸？！’","book":"《论语·宪问》"},"example":{"text":"幼有异质，七岁入学，授章句，问其师曰：“读书何为？”师曰：“取科第耳！”曰：“～乎？”师大奇之。","book":"《元史·许衡传》"},"similar":["如此而已","如是而已"],"usage":"作状语；用于句尾，作结束语"},{"id":14416,"word":"如无其事","pinyin":"rú wú qí shì","abbr":"rwqs","explanation":"象没有那回事一样。形容遇事沉着镇定或不把事情放在心上。","source":{"text":"统领听不见，庄大老爷也听不见，就作为如无其事，不去提他了。","book":"清·李宝嘉《官场现形记》第十八回"},"similar":["若无其事"],"usage":"作谓语、定语、状语；指人的态度"},{"id":14417,"word":"如日中天","pinyin":"rú rì zhōng tiān","abbr":"rrzt","explanation":"好像太阳正在天顶。比喻事物正发展到十分兴盛的阶段。","source":{"text":"日之方中，在前上处。","book":"《诗经·邶风·简兮》"},"example":{"text":"兹学始盛于欧洲，仅一百五十年以来，今则磅礴烁烁，～。（清·梁启超《生计学学说沿革小史》）"},"similar":["方兴未艾","蓬勃发展"],"opposite":["日薄西山","桑榆暮景"],"usage":"作谓语、定语；指处于鼎盛阶段"},{"id":14418,"word":"如日方中","pinyin":"rú rì fāng zhōng","abbr":"rrfz","explanation":"好像太阳正在天顶。比喻事物正发展到十分兴盛的阶段。","source":{"text":"日之方中，在前上处。","book":"《诗经·邶风·简兮》"},"example":{"text":"他现在正是～的年龄，能干大事。"},"similar":["如日中天"],"opposite":["日薄西山"],"usage":"作谓语、定语；指处于鼎盛阶段"},{"id":14419,"word":"如日方升","pinyin":"rú rì fāng shēng","abbr":"rrfs","explanation":"如：象；方：刚。象太阳刚刚升起来。比喻光明的前程刚刚开始。","source":{"text":"如月之恒，如日之升，如南山之寿，不骞不崩。","book":"《诗经·小雅·天保》"},"example":{"text":"中国是～的国家，这同日本帝国主义的没落状态恰是相反的对照。","book":"毛泽东《论持久战》"},"similar":["日升月恒","旭日东升"],"opposite":["江河日下","日暮途穷"],"usage":"作谓语、定语、状语；用于事物的发展"},{"id":14420,"word":"如是我闻","pinyin":"rú shì wǒ wén","abbr":"rsww","explanation":"如是：指佛经经文内容如此；我闻：阿难自称我闻之于佛。佛教传说，后为佛经开卷语。","source":{"text":"如是我闻者，谓总显己闻，传佛教者言如是事，我昔曾闻如是。","book":"《佛地经论》一"},"example":{"text":"～：一时，佛在舍卫国，祇树给孤独园，与大比丘众，千二百五十人俱。","book":"姚雪垠《李自成》第二卷第三十一章"},"usage":"作宾语、分句；为佛经开卷语"},{"id":14421,"word":"如是而已","pinyin":"rú shì ér yǐ","abbr":"rsey","explanation":"如是：象这样；而已：罢了。就是这样罢了。","source":{"text":"是故弟子不必不如师，师不必贤于弟子，闻道有先后，术业有专攻，如是而已。","book":"《左传·成公五年》：“其如此而已，虽伯宗若之何。”唐·韩愈《师说》"},"example":{"text":"最多不过有几家小饭铺，几家杂货店，一两家布店，一家标明川广云贵地道药材的老药铺，～。","book":"魏巍《地球的红飘带》五十三"},"similar":["如此而已","如斯而已"],"usage":"作状语；用于句尾，作结束语"},{"id":14422,"word":"如月之恒，如日之升","pinyin":"rú yuè zhī héng，rú rì zhī shēng","abbr":"ryzhrrzs","explanation":"月恒：上弦月。好像上弦月逐渐圆满，好像太阳刚刚升起来一样。旧时用来祝颂人的官运亨通。后比喻有强大的生命力和发展前途。","source":{"text":"如月之恒，如日之升。如南山之寿，不骞不崩。如松柏之茂，无不尔或承。","book":"《诗经·小雅·天保》"},"usage":"作定语、分句；用于祝颂人"},{"id":14423,"word":"如有所失","pinyin":"rú yǒu suǒ shī","abbr":"ryss","explanation":"好像丢失了什么似的。形容心神不安的样子。也形容心里感到空虚。","source":{"text":"怅然若有所失。","book":"南朝·宋·刘义庆《世说新语·德行》：“则鄙吝之心已复生矣。”南朝宋·刘孝标注"},"example":{"text":"至暮，家人强挽以归，～，意忽忽不乐。","book":"宋·洪迈《夷坚志甲志·永康倡女》"},"similar":["若有所失"],"opposite":["不动声色"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":14424,"word":"如有隐忧","pinyin":"rú yǒu yǐn yōu","abbr":"ryyy","explanation":"忧：愁苦，忧愁。象心中有说不出的忧愁一样。","source":{"text":"泛彼柏舟，亦泛其流。耿耿不寐，如有隐忧。","book":"《诗经·邶风·柏舟》"},"example":{"text":"席上人人兴高采烈，只有昆布兰国公主双眉紧蹙，～。","book":"梁羽生《冰河洗剑录》第四十九回"},"usage":"作谓语、定语；用于书面语"},{"id":14425,"word":"如梦初觉","pinyin":"rú mèng chū jué","abbr":"rmcj","explanation":"好像刚从梦景中醒来一样。多比喻从糊涂、错误的认识中省悟过来。","source":{"text":"信陵君如梦初觉，再拜称谢。","book":"明·冯梦龙《东周列国志》第一百回"},"example":{"text":"柯陈兄弟～，如醉方醒，才放下心中疙瘩。","book":"明·凌濛初《二刻拍案惊奇》卷二十七"},"similar":["如梦初醒","如梦方醒","似梦初觉"],"usage":"作谓语、定语、状语；形容人突然醒悟"},{"id":14426,"word":"如梦初醒","pinyin":"rú mèng chū xǐng","abbr":"rmcx","explanation":"象刚从梦中醒来。比喻过去一直糊涂，在别人或事实的启发下，刚刚明白过来。","source":{"text":"寡人闻仲之言，如梦初醒。","book":"明·冯梦龙《东周列国志》第十一回"},"example":{"text":"看了这封信，他才～，方知自己上当受骗。"},"similar":["茅塞顿开","豁然开朗","恍然大悟"],"opposite":["如堕雾中"],"usage":"作谓语、定语、状语；形容人突然醒悟"},{"id":14427,"word":"如梦如痴","pinyin":"rú mèng rú chī","abbr":"rmrc","explanation":"形容处于不清醒、糊里糊涂的状态中。","source":{"text":"归来如梦复如痴，何暇备言宫里事。","book":"唐·元稹《连昌宫词》"},"example":{"text":"次友想不到，会在这里见到何桂柱，更想不到，康熙也在这里，惊得他～。","book":"二月河《康熙大帝》三十五"}},{"id":14428,"word":"如梦如醉","pinyin":"rú mèng rú zuì","abbr":"rmrz","explanation":"形容处于不清醒、迷糊状态中。同“如醉如梦”。","source":{"text":"‘我如梦如醉的离开了他。”伊揩着眼泪，继续说。","book":"叶圣陶《母》"},"similar":["如痴如梦","如醉如梦"],"usage":"作谓语、定语、状语；用于处事"},{"id":14429,"word":"如梦方醒","pinyin":"rú mèng fāng xǐng","abbr":"rmfx","explanation":"象刚从梦中醒来。比喻过去一直糊涂，在别人或事实的启发下，刚刚明白过来。","source":{"text":"寡人闻仲之言，如梦初醒。","book":"明·冯梦龙《东周列国志》第十一回"},"example":{"text":"众人听了，～，尽皆喜悦。","book":"清·陈忱《水浒后传》第三十回"},"similar":["如梦初醒","如梦初觉"],"usage":"作谓语、定语、状语；形容人突然醒悟"},{"id":14430,"word":"如椽之笔","pinyin":"rú chuán zhī bǐ","abbr":"rczb","explanation":"像椽子一般粗大的笔。比喻记录大事的手笔，也比喻笔力雄健的文词。","source":{"text":"徇梦人以大笔如椽与之，既觉，语人云：‘此当有大手笔事。’","book":"唐·房玄龄《晋书·王徇传》"},"similar":["如椽大笔"],"usage":"作主语、宾语；比喻记录大事的手笔","story":["东晋文人王珣从小才思敏捷，胆识过人，20岁时担任大司马桓温的主簿。他经常是口若悬河，下笔成文。一天晚上王珣做了一个梦，梦中有人送给他一支像椽子那样大的笔，预感有大手笔的事情要做。第二天果然被叫去为晋孝武帝写祭文"]},{"id":14431,"word":"如椽大笔","pinyin":"rú chuán dà bǐ","abbr":"rcdb","explanation":"像椽子一般粗大的笔。比喻记录大事的手笔，也比喻笔力雄健的文词。","source":{"text":"诗成半醉正陶然，更用如椽大笔抄。","book":"宋·邵雍《大字吟》"},"similar":["笔补造化","才高八斗"],"opposite":["目不识丁"],"usage":"作主语、宾语；比喻记录大事的手笔","story":["东晋文人王珣从小才思敏捷，胆识过人，20岁时担任大司马桓温的主簿。他经常是口若悬河，下笔成文。一天晚上王珣做了一个梦，梦中有人送给他一支像椽子那样大的笔，预感有大手笔的事情要做。第二天果然被叫去为晋孝武帝写祭文"]},{"id":14432,"word":"如此而已","pinyin":"rú cǐ ér yǐ","abbr":"rcey","explanation":"如此：象这样；而已：罢了。就是这样罢了。","source":{"text":"无为其所不为，无欲其所不欲，如此而已矣。","book":"战国·邹·孟轲《孟子·尽心上》"},"example":{"text":"教吾子与汝子，幸其成长，吾女与汝女，待其嫁，～。","book":"唐·韩愈《祭十二郎文》"},"similar":["仅此而已","如是而已"],"usage":"作状语；用于句尾，作结束语"},{"id":14433,"word":"如此这般","pinyin":"rú cǐ zhè bān","abbr":"rczb","explanation":"虚指没有详细说明或不要求详细说明的某种事物。","source":{"text":"苟才便附到他耳边去，如此这般的说了一遍。","book":"清·吴趼人《二十年目睹之怪现状》第88回"},"example":{"text":"她拉我到角落里～地交代如何对付。"},"similar":["这样那样"],"usage":"作状语；用于口语"},{"id":14434,"word":"如水投石","pinyin":"rú shǔ tóu shí","abbr":"rsts","explanation":"就象把水泼向石头，丝毫不入。比喻听而不闻或言无效果。","source":{"text":"迁中书舍人，承颜造膝，知无不言，献替启沃，如水投石。","book":"唐·白居易《唐淮节度史李公家庙碑铭序》"},"example":{"text":"时谢显道亦在。谢为人诚实，但聪悟不及先生。故明道每言杨君聪明，谢君～，然亦未尝不称其善。","book":"宋·杨时《龟山语录》"},"usage":"作谓语、定语；指没有效果"},{"id":14435,"word":"如水赴壑","pinyin":"rú shǔ fù hè","abbr":"rsfh","explanation":"壑：大水坑，山沟。象水流向山涧一样。形容许多人纷纷奔向同一个目的地。","source":{"text":"美声溢海内，佳话满人口，开阁延土，如水赴壑；财无积实，宾至如归。","book":"唐·李观《与处州李使君书》"},"usage":"作谓语、定语；形容许多人奔向同一目的"},{"id":14436,"word":"如汤化雪","pinyin":"rú tāng huà xuě","abbr":"rthx","explanation":"汤：热水。像热水浇在雪上。形容十分容易。","source":{"text":"提刀上马，如汤化雪，谁敢争持？","book":"明·冯梦龙《精忠旗·北朝复地》"},"similar":["如汤浇雪","如汤灌雪","如汤沃雪"],"usage":"作谓语、状语；形容十分容易"},{"id":14437,"word":"如汤沃雪","pinyin":"rú tāng wò xuě","abbr":"rtwx","explanation":"汤：热水；沃：浇。象用热水浇雪一样。比喻事情非常容易解决。","source":{"text":"小饭大歠，如汤沃雪。","book":"汉·枚乘《七发》"},"example":{"text":"我今为汝扫狐疑，～火销冰。","book":"宋·释普济《五灯会元·径山杲禅师法嗣》"},"similar":["轻而易举","如汤灌雪","如汤浇雪"],"usage":"作谓语、状语；形容十分容易","story":["西汉时期，刘邦分封诸王及其子孙骄奢淫逸，纵欲无度。文学家枚乘写《七发》规劝他们。《七发》内容是：春秋楚国一太子得病请来一个医生，医生了解他是纵欲引起的，就用七件事启发他，其中有“小饭大啜，如汤沃雪”，太子很快病愈"]},{"id":14438,"word":"如汤泼蚁","pinyin":"rú tāng pō yǐ","abbr":"rtpy","explanation":"汤：沸水。像用热水去泼蚂蚁，一泼即散，既而又聚。比喻效果不明显。","source":{"text":"各处申达表文求救，累次调兵前去征剿交锋，如汤泼蚁。","book":"明·施耐庵《水浒传》第83回"},"usage":"作谓语、定语；用于比喻句"},{"id":14439,"word":"如汤泼雪","pinyin":"rú tāng pō xuě","abbr":"rtpx","explanation":"比喻事情非常容易解决。同“如汤沃雪”。","source":{"text":"若是拿得此人，觑此城子，如汤泼雪。","book":"《水浒传》第五八回"},"example":{"text":"清·李百川《绿野仙踪》第62回：“二鬼觉得一股热气，～，从顶门直透涌泉。”"},"similar":["如汤浇雪","如汤化雪","如汤灌雪"],"usage":"作谓语、状语；形容十分容易"},{"id":14440,"word":"如汤浇雪","pinyin":"rú tāng jiāo xuě","abbr":"rtjx","explanation":"比喻事情非常容易解决。同“如汤沃雪”。","source":{"text":"丈人一旨，如汤浇雪耳。","book":"《南史·王莹传》"},"example":{"text":"明·无名氏《杨家将演义》第四卷：“这几处乃是可攻之隙，若能依法调兵打之，～，霎时消除矣。”"},"similar":["如汤灌雪","如汤泼雪","如汤化雪"],"usage":"作谓语、状语；形容十分容易"},{"id":14441,"word":"如汤灌雪","pinyin":"rú tāng guàn xuě","abbr":"rtgx","explanation":"比喻事情非常容易解决。同“如汤沃雪”。","source":{"text":"则民之弃恶，如汤之灌雪焉。","book":"《孔子家语·王言》"},"similar":["如汤浇雪","如汤化雪","如汤沃雪"],"usage":"作谓语、状语；形容十分容易"},{"id":14442,"word":"如泉赴壑","pinyin":"rú quán fù hè","abbr":"rqfh","explanation":"壑：大水坑，山沟。象泉水流向山涧一样。形容许多人纷纷奔向同一个目的地。","source":{"text":"美声溢海内，佳话满人口，开阁延土，如水赴壑；财无积实，宾至如归。","book":"唐·李观《与处州李使君书》"}},{"id":14443,"word":"如法泡制","pinyin":"rú fǎ pào zhì","abbr":"rfpz","explanation":"指按照一定的方法制作中药。比喻照着现成的样子做","source":{"text":"两个茶房将第二箱抬到舱面上，他如法泡制，一箱书又变成了一箱半，还撕碎了几个厚纸包。","book":"鲁迅《而已集·再谈香港》"},"similar":["如法炮制"],"opposite":["别出心裁"],"usage":"作谓语、定语、状语；用于事物"},{"id":14444,"word":"如法炮制","pinyin":"rú fǎ pào zhì","abbr":"rfpz","explanation":"本指按照一定的方法制作中药。现比喻照着现成的样子做。同“如法炮制”。","source":{"text":"两个茶房将第二箱抬到舱面上，他如法泡制，一箱书又变成了一箱半，还撕碎了几个厚纸包。","book":"鲁迅《而已集·再谈香港》"},"example":{"text":"朱自清《古文学的欣赏》：“我们不妨～，用白话来尝试。”"},"similar":["依样葫芦","如法泡制"],"opposite":["独树一帜","别出心裁"],"usage":"作谓语、定语、状语；用于事物"},{"id":14445,"word":"如法砲制","pinyin":"rú fǎ pào zhì","abbr":"rfpz","explanation":"依照成法，砲制中药。比喻照样仿做。"},{"id":14446,"word":"如泣如诉","pinyin":"rú qì rú sù","abbr":"rqrs","explanation":"好像在哭泣，又象在诉说。形容声音悲切。","source":{"text":"其声呜呜然，如怨如慕，如泣如诉。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"风声～，墓地凄然悲凉。","book":"冯德英《迎春花》第十九章"},"similar":["扣人心弦","荡气回肠"],"opposite":["慷慨悲歌"],"usage":"作谓语；形容乐声","story":["北宋时期，苏东坡被贬到黄州当团练副使，十分空闲，他潜心研读佛、道家等经典。经常放浪形骸于山水之间，他带上朋友泛舟来到赤壁之下，夜色很美。他听到一阵如泣如诉的箫声，就上前询问，对方在为曹操而惋惜"]},{"id":14447,"word":"如泣草芥","pinyin":"rú qì cǎo jiè","abbr":"rqcj","explanation":"芥：小草。就像仍掉一根小草那样。形容毫不在意。","source":{"text":"子孙视之不甚惜，举以予人，如弃草芥。","book":"宋·苏洵《六国论》"}},{"id":14448,"word":"如渴如饥","pinyin":"rú kě rú jī","abbr":"rkrj","explanation":"形容迫切的心情或要求。同“如饥如渴”。","source":{"text":"思我良朋，如渴如饥，愿言不获，怆矣其悲。","book":"三国·魏·嵇康《兄秀才公穆入军赠诗》之十四"},"example":{"text":"我～地读着各种文学书和理论书，也学了外科医药知识。","book":"吴运铎《把一切献给党·永远前进》"},"similar":["如饥似渴","如饥如渴"],"usage":"作谓语、宾语、定语、状语；指要求强烈"},{"id":14449,"word":"如漆如胶","pinyin":"rú qī rú jiāo","abbr":"rqrj","explanation":"象胶和漆那样黏结。形容感情炽烈，难舍难分。多指夫妻恩爱。","source":{"text":"以胶投漆中，谁能别离此。","book":"《史记·鲁仲连邹阳列传》：“感于心，合于行，亲于胶漆，昆弟不能离，岂惑于众口哉。”《古诗十九首·孟冬寒气至》"},"example":{"text":"究竟如何，无庸深考。但觉与新嫂嫂情投意合，～。","book":"清·李宝嘉《官场现形记》第八回"}},{"id":14450,"word":"如潮涌至","pinyin":"rú cháo yǒng zhì","abbr":"rcyz","explanation":"像潮涌一样，比喻某种事物来势甚猛。","example":{"text":"大批的蝗虫～，吞噬着庄稼。"},"similar":["势如潮涌"],"usage":"作谓语、定语；指来势甚猛"},{"id":14451,"word":"如火如荼","pinyin":"rú huǒ rú tú","abbr":"rhrt","explanation":"荼：茅草的白花。象火那样红，象荼那样白。原比喻军容之盛。现用来形容大规模的行动气势旺盛，气氛热烈。","source":{"text":"万人以为方阵，皆白裳，白旗，素甲，白羽之缯，望之如荼。……左军亦如之，皆赤裳，赤，丹甲，朱羽之缯，望之如火。","book":"《国语·吴语》"},"example":{"text":"过了两年“五四运动”发生了。报纸上的～的记载唤醒了他的被忘却了的青春。","book":"巴金《家》六"},"similar":["方兴未艾","轰轰烈烈"],"opposite":["无声无息"],"usage":"作谓语、定语、状语；指气势","story":["春秋时期，吴国的国力逐渐强盛，吴王夫差想当中原霸主，于公元前482年带领3万大军来到卫国黄池会盟。他让将士穿统一的红、白、黑三色战袍，按颜色分别整齐地排列，让人感觉到如火如荼，如此整齐的军容使他成为军事霸主"]},{"id":14452,"word":"如火燎原","pinyin":"rú huǒ liáo yuán","abbr":"rhly","explanation":"燎：烧；原：原野。如火在原野燃烧。比喻声势很大，难于阻抑。","source":{"text":"若火之燎于原，不可向迩。","book":"《尚书·盘庚上》"},"example":{"text":"到期不能“剿灭”，反而～，他们有些做封疆大吏的，轻则降级、削职，重则下狱、砍头。","book":"姚雪垠《李自成》第二卷第三十六章"},"similar":["星火燎原"],"usage":"作谓语、定语；指声势浩大"},{"id":14453,"word":"如烹小鲜","pinyin":"rú pēng xiǎo xiān","abbr":"rpxx","explanation":"烹：烧煮；鲜：活鱼。像烹煮一条小鱼一样。比喻轻而易举。","source":{"text":"治大国者若烹小鲜。","book":"《老子》第六十章"},"example":{"text":"《陈书·高祖纪》：“戮此大憨，～。”"},"similar":["若烹小鲜"],"usage":"作谓语、定语；用于比喻句"},{"id":14454,"word":"如熟羊胛","pinyin":"rú shú yáng jiǎ","abbr":"rsyj","explanation":"羊胛：羊的肩骨，易熟。象煮熟羊胛一样。形容时间短促。","source":{"text":"又北度海，则昼长夜短。日入烹羊胛，熟，东方已明，盖近日出处也。","book":"《新唐书·回鹘传》"},"example":{"text":"尔来不觉三十年，岁月才～。","book":"宋·欧阳修《谢观文王尚书惠西京牡丹》"}},{"id":14455,"word":"如牛负重","pinyin":"rú niú fù zhòng","abbr":"rnfz","explanation":"象牛背着沉重的东西一样。比喻生活负担极重。","source":{"text":"勿起妄念，如牛负重于深泥中。","book":"《佛说四十二章经·佛言诸沙门行道，当如牛负重行深泥中》"},"example":{"text":"荒时暴月，向亲友乞哀告怜，借得几斗几升，敷衍三日五日，债务丛集，～。","book":"毛泽东《中国社会各阶级的分析》"},"similar":["千辛万苦","人困马乏"],"opposite":["如释重负"],"usage":"作谓语、定语、状语；形容生活困苦"},{"id":14456,"word":"如狼似虎","pinyin":"rú láng sì hǔ","abbr":"rlsh","explanation":"象狼和虎一样凶狠。比喻非常凶暴残忍。","source":{"text":"一人之兵，如狼似虎，如风如雨，如雷如霆，震震冥冥，天下皆惊。","book":"《尉缭子·武议》"},"example":{"text":"只听得高声大语，开门看～。","book":"元·杨显之《潇湘雨》第四折"},"similar":["穷凶极恶","凶神恶煞"],"opposite":["如兄如弟","菩萨心肠"],"usage":"作谓语、定语、状语；指凶狠"},{"id":14457,"word":"如狼如虎","pinyin":"rú láng sì hǔ","abbr":"rlrh","explanation":"形容勇猛、猛烈。","source":{"text":"一人之兵，如狼如虎，如风如雨，如雷如霆，震震冥冥，天下皆惊。","book":"《尉缭子·武议》"},"example":{"text":"文忠凛然端坐，价前～的将官，排列两行，就如追魂夺魄的一般，甚是畏惧。","book":"明·郭勋《英烈传》第五十二回"},"similar":["如狼似虎"],"usage":"作谓语、定语、状语；指凶狠"},{"id":14458,"word":"如狼牧羊","pinyin":"rú láng mù yáng","abbr":"rlmy","explanation":"如同狼放养羊一般。比喻官吏残酷地欺压人民。","source":{"text":"宁成为济南都尉，其治如狼牧羊。","book":"《史记·酷吏列传》"},"usage":"作谓语、宾语；指欺负弱小"},{"id":14459,"word":"如珪如璋","pinyin":"rú guī rú zhāng","abbr":"rgrz","explanation":"珪：玉器；璋：古代贵重的礼器。比喻人品质高尚，气宇轩昂。","source":{"text":"孝成煌煌，临朝有光，威仪之盛，如珪如璋。","book":"东汉·班固《汉书·叙传下·成帝纪述》"},"similar":["如圭如璋"],"usage":"作谓语、定语；用于比喻句"},{"id":14460,"word":"如痴似醉","pinyin":"rú chī sì zuì","abbr":"rcsz","explanation":"①形容因惊恐而发呆。②形容陶醉的精神状态。亦作“如醉如痴”。","source":{"text":"自从西宫阁下，得见了王昭君，使朕如痴似醉，久不临朝。","book":"宋·周密《癸辛杂识续集·石洞雷火》：“其人如痴似醉，莫知所以然。”元·马致远《汉宫秋》第二折"},"example":{"text":"猛可得～，独自个谁温谁热？","book":"明·高濂《玉簪记·叱谢》"},"similar":["如痴如醉","如醉如痴"],"usage":"作谓语、定语、状语；指神态失常"},{"id":14461,"word":"如痴如呆","pinyin":"rú chī rú dāi","abbr":"rcrd","explanation":"如：好像。形容极其迷恋某事。","source":{"text":"他总是站在高高的牛牯垛峰颠，如痴如呆地仰望着头顶的星空。","book":"刘兰生《探索星空奥秘的年轻人》"},"usage":"作谓语、定语、状语；指迷恋"},{"id":14462,"word":"如痴如梦","pinyin":"rú chī rú mèng","abbr":"rcrm","explanation":"形容处于不清醒、迷糊状态中。同“如醉如梦”。","source":{"text":"遇真正儒者，如痴如梦，翻令见疑。","book":"明·李贽《焚书·答周二鲁》"},"similar":["如梦如醉","如醉如梦"],"usage":"作谓语、定语、状语；用于处事"},{"id":14463,"word":"如痴如狂","pinyin":"rú chī rú kuáng","abbr":"rcrk","explanation":"形容神态失常，不能自制。亦指为某人某事所倾倒。同“如醉如狂”。","source":{"text":"倾城士女如痴如狂，一条七里山塘，停满了画船歌舫，真个靓妆藻野，炫服缛川，好不热闹。","book":"《孽海花》第七回"},"example":{"text":"曾朴《孽海花》第七回：“倾城士女～，一条七里山塘，停满了画船歌舫，真个靓妆藻野，炫服缛川，好不热闹。”"},"similar":["如醉如狂"],"usage":"作谓语、定语、状语；用于处事"},{"id":14464,"word":"如痴如醉","pinyin":"rú chī rú zuì","abbr":"rcrz","explanation":"形容神态失常，失去自制。","source":{"text":"得见了王昭君，使朕如痴似醉。","book":"宋·无名氏《张协状元·胜花气死》：“胜花娘子病得利害，服药一似水泼石中，汤浇雪上。似病非病，如醉如痴。”元·马致远《汉宫秋》第二折"},"example":{"text":"子京，你怎么～，做出这个嘴脸，想是青霞事又发作了。","book":"明·谢谠《四喜记·赴试秋闱》"},"similar":["如醉如痴","如痴似醉"],"usage":"作谓语、定语、状语；指自我陶醉"},{"id":14465,"word":"如登春台","pinyin":"rú dé chūn tái","abbr":"rdct","explanation":"春台：美好的旅游、观光的地方，比喻极好的生活环境。好像生活在幸福的太平世界里。","source":{"text":"众人熙熙，如享太牢，如登春台。","book":"《老子》第二十章"},"usage":"作谓语、定语；指生活幸福"},{"id":14466,"word":"如石投水","pinyin":"rú shí tóu shuǐ","abbr":"rsts","explanation":"象石头投入水里就沉没一样。比喻互相合得来。","source":{"text":"及其遭汉祖，其言也，如以石投水，莫之逆也。","book":"《列子·说符》：“白公问曰：‘若以石投水，何如？’孔子曰：‘吴之善没者能取之。’”三国·魏·李萧远《运命论》"},"example":{"text":"是以揣人情，究物理，决胜则若火燎原，发言则～。","book":"唐·高郢《曹刿请从鲁公一战赋》"}},{"id":14467,"word":"如碎如狂","pinyin":"rú zuì rú káng","abbr":"rsrk","explanation":"形容神态失常，不能自制。指为某人某事所倾倒。","source":{"text":"这些人还指望出张续案，放遭告考，把一个长安子弟，弄得如醉如狂的。","book":"明·凌濛初《初刻拍案惊奇》卷二十五"}},{"id":14468,"word":"如箭在弦","pinyin":"rú jiàn zài xián","abbr":"rjzx","explanation":"箭已搭在弦上。比喻势在必行。","source":{"text":"矢在弦上，不可不发。","book":"三国魏·陈琳《为袁绍檄豫州》注引《魏志》"},"example":{"text":"既然补之与汉举二将军已率两万人马进驻叶县与裕州之间，大军继续东进，～。","book":"姚雪垠《李自成》第二卷第三十六章"},"similar":["箭在弦上"],"usage":"作谓语、定语；比喻势在必行"},{"id":14469,"word":"如箭离弦","pinyin":"rú jiàn xián xián","abbr":"rjlx","explanation":"象箭射出离开弓弦一样。形容奔向目标的动作神速。","source":{"text":"亡命心如箭离弦，迷津指引始能前。","book":"明·冯梦龙《喻世明言》卷三十一"},"example":{"text":"他一展开轻功，当真是～，迅捷无伦，但终于迟了一步，赶到崖边，郭襄已向崖下落去。","book":"金庸《神雕侠侣》第三十八回"}},{"id":14470,"word":"如胶似漆","pinyin":"rú jiāo sì qī","abbr":"rjsq","explanation":"象胶和漆那样黏结。形容感情炽烈，难舍难分。多指夫妻恩爱。","source":{"text":"以胶投漆中，谁能别离此。","book":"《史记·鲁仲连邹阳列传》：“感于心，合于行，亲于胶漆，昆弟不能离，岂惑于众口哉。”《古诗十九首·孟冬寒气至》"},"example":{"text":"那张三和这婆惜，～。","book":"明·施耐庵《水浒全传》第二十回"},"similar":["亲密无间","情投意合"],"opposite":["反目成仇","分道扬镳","一刀两断"],"usage":"作谓语、状语、定语；形容关系极为密切","story":["西汉时期，邹阳与枚乘因吴王刘濞不听他们的劝阻，就投靠梁孝王刘武。刘武的大臣公孙诡因为嫉妒他们的才能，就诬陷邹阳，迫使刘武抓邹阳。邹阳在狱中给刘武写了一封信，其中有“感于心，合于行，亲如胶漆。”刘武深受感动释放了他"]},{"id":14471,"word":"如胶如漆","pinyin":"rú jiāo rú qī","abbr":"rjrq","explanation":"象胶和漆那样黏结。形容感情炽烈，难舍难分。多指夫妻恩爱。","source":{"text":"以胶投漆中，谁能别离此。","book":"《史记·鲁仲连邹阳列传》：“感于心，合于行，亲于胶漆，昆弟不能离，岂惑于众口哉。”《古诗十九首·孟冬寒气至》"},"example":{"text":"兼之八个姊妹自从一同赴考，郡县取中之后，真是～，就象粘住一般，再也离不开。","book":"清·李汝珍《镜花缘》第六十四回"},"similar":["亲密无间","情投意合","如胶似漆"],"opposite":["反目成仇","分道扬镳"],"usage":"作谓语、状语、补语；形容关系极为密切"},{"id":14472,"word":"如胶投漆","pinyin":"rú jiāo tóu qī","abbr":"rjtq","explanation":"好像胶和漆那样，粘住就分不开。形容感情深厚，亲密得难舍难分。","source":{"text":"以胶投漆中，谁能别离此。","book":"《古诗十九首·孟冬寒气至》"},"similar":["如胶似漆","如胶如漆"],"usage":"作谓语、状语、定语；形容关系极为密切"},{"id":14473,"word":"如臂使指","pinyin":"rú bì shǐ zhǐ","abbr":"rbsz","explanation":"比喻指挥如意，没有牵制。","source":{"text":"令海内之势如身之使臂，臂之使指，莫不制从。","book":"东汉·班固《汉书·贾谊传》"},"example":{"text":"且训其三军，～。","book":"唐·独孤及《故江陵尹兼御史大夫吕湮谥议》"},"similar":["得心应手","驾轻就熟"],"opposite":["势成骑虎","束手无策"],"usage":"作谓语、定语；指得心应手"},{"id":14474,"word":"如芒刺背","pinyin":"rú máng cì bèi","abbr":"rmcb","explanation":"形容极度不安。同“如芒在背”。","source":{"text":"[黄仲]心下踌躇，坐卧不安，如芒刺背。","book":"《封神演义》第七回"},"example":{"text":"清·石玉昆《小五义》第五回：“叫张祥儿备酒，再亦吞吃不下，如坐针毡，～。”"},"similar":["芒刺在背"],"usage":"作谓语、定语；用于比喻句"},{"id":14475,"word":"如芒在背","pinyin":"rú máng zài bèi","abbr":"rmzb","explanation":"形容极度不安。","source":{"text":"宣帝始立，谒见高庙，大将军光从骖乘。上内严惮之，若有芒刺在背。","book":"《汉书·霍光传》"},"example":{"text":"我听了这两句话，又是～，坐立不安。","book":"清·吴趼人《二十年目睹之怪现状》第八十二回"},"similar":["如芒刺背"],"usage":"作谓语、状语、定语；指极度不安"},{"id":14476,"word":"如花似月","pinyin":"rú huā sì yuè","abbr":"rhsy","explanation":"形容女子姿容出众。同“如花似玉”。","source":{"text":"凤凰山玉环圣母有一女儿，名叫铁扇公主，年方二八，生得如花似月。","book":"《四游记·华光与铁公主成亲》"},"similar":["如花似玉","如花似朵"],"usage":"作谓语、定语、状语；形容女子姿容秀丽"},{"id":14477,"word":"如花似朵","pinyin":"rú huā sì duǒ","abbr":"rhsd","explanation":"犹言如花似玉。形容女子姿容出众。","source":{"text":"轿子里面，如花似朵的一年少女子。","book":"《水浒传》第一○一回"},"example":{"text":"又有那～的佳人，在傍打扇。","book":"《金瓶梅词话》第二七回"},"similar":["如花似月","如花似玉"],"usage":"作谓语、定语、状语；形容女子姿容秀丽"},{"id":14478,"word":"如花似玉","pinyin":"rú huā sì yù","abbr":"rhsy","explanation":"像花和玉那样美好。形容女子姿容出众。","source":{"text":"彼其之子，美如英……彼其之子，美如玉。","book":"《诗·魏风·汾沮洳》"},"example":{"text":"假如不幸我庄周死后，你这般～的年纪，难道捱得过三年五载？","book":"明·冯梦龙《警世通言·庄子休鼓盆成大道》"},"similar":["花容月貌","仪容俊秀"],"opposite":["面目狰狞"],"usage":"作谓语、定语、状语；形容女子姿容秀丽","story":["我国最早的诗歌总集《诗经》中描写一个美丽多情的少女去野外采桑，看到一个长得像鲜花一样美丽、像碧玉一样清秀的青年男子，他虽然衣着朴素大方，举止言行处处很高雅，少女顿时对这个如花似玉的男子从心底产生爱慕之情"]},{"id":14479,"word":"如花似锦","pinyin":"rú huā sì jǐn","abbr":"rhsj","explanation":"锦：有彩色花纹的丝织品。如同花朵、锦缎一般。形容风景绚丽或前程美好。","source":{"text":"那香屏牌价嫁了周庸祐，早卸了孝服，换得浑身如花似锦。","book":"清·黄小配《廿载繁华梦》第三回"},"example":{"text":"节日的广场被打扮得～，绚丽多彩。"},"similar":["如花似玉"],"opposite":["暗淡无光"],"usage":"作谓语、定语、宾语；形容华彩绚丽"},{"id":14480,"word":"如花如锦","pinyin":"rú huā rú jǐn","abbr":"rhrj","explanation":"锦：有彩色花纹的丝织品。如同花朵、锦缎一般。形容风景绚丽或前程美好。","source":{"text":"恰好凑着吉日良时，两对小夫妻，如花如锦，拜堂合卺。","book":"明·冯梦龙《醒世恒言》卷一"},"example":{"text":"～如梦如幻的“爱丽丝”，就好像托在这铃声之上，悬浮在这铃声之上，是由它串起的珠子。","book":"王安忆《长恨歌》第一部"},"similar":["如花似锦"],"usage":"作谓语、定语、宾语；形容华彩绚丽"},{"id":14481,"word":"如花美眷","pinyin":"rú huā měi juàn","abbr":"rhmj","explanation":"象花一样美的眷属。形容姻缘十分美好。","source":{"text":"则为你如花美着，似水流年，是答儿闲寻遍。","book":"明·汤显祖《牡丹亭·惊梦》"},"example":{"text":"因邓九公父女一心向热，定要给公子联姻成就这段～的姻缘。","book":"清·文康《儿女英雄传》第二十五回"},"usage":"作宾语、定语；用于夸奖人"},{"id":14482,"word":"如荼如火","pinyin":"rú tú rú huǒ","abbr":"rtrh","explanation":"荼：茅草的白花。象荼那样白，象火那样红。原比喻军容之盛。现用来形容大规模的行动气势旺盛，气氛热烈。","source":{"text":"万人以为方阵，皆白裳，白旗，素甲，白羽之缯，望之如荼。……左军亦如之，皆赤裳，赤，丹甲，朱羽之缯，望之如火。","book":"《国语·吴语》"},"example":{"text":"霹雳一声，四方响应，正我汉族～之国民，执国旗而跳上舞台之日也。","book":"清·曾朴《孽海花》第二十九回"},"similar":["如火如荼"],"usage":"作谓语、定语、状语；指气势"},{"id":14483,"word":"如获石田","pinyin":"rú huò shí tián","abbr":"rhst","explanation":"石田：指有石头的田地，借指没用的东西。指得到不可耕种的田地。","source":{"text":"大王如获石田。","book":"春秋·鲁·左丘明《左传·哀公十一年》"},"example":{"text":"她一意孤行要这样，结果～。"},"usage":"作谓语、定语；指没用的东西","story":["春秋时期，鲁国与齐国发生了战争，鲁哀公请吴王夫差出兵支援，越王勾践获悉立即到吴国朝拜，送来许多礼物。伍子胥完全明白越王的用心，就向吴王劝谏不能出兵，打败了齐国也只是如获石田，越国才是吴国的心腹之患"]},{"id":14484,"word":"如获至宝","pinyin":"rú huò zhì bǎo","abbr":"rhzb","explanation":"至：极，最。好像得到极珍贵的宝物。形容对所得到的东西非常珍视喜爱。","source":{"text":"忽蜀僧行密至，袖出寂照庵三字，如获至宝。","book":"宋·李光《与胡邦衡书》"},"example":{"text":"行至堂阜，鲍叔牙先在，见夷吾～。","book":"明·冯梦龙《东周列国志》第十六回"},"similar":["大喜过望","喜出望外"],"opposite":["如丧考妣"],"usage":"作谓语、定语、状语；形容非常珍视喜欢"},{"id":14485,"word":"如获至珍","pinyin":"rú huò zhì zhēn","abbr":"rhzz","explanation":"形容对所得到的东西非常珍视喜爱。同“如获至宝”。","source":{"text":"那薛蟠得了宝蟾，如获至珍，一概都置之不顾。","book":"《红楼梦》第八十回"},"example":{"text":"他得到她的承诺～"},"similar":["如获至宝"],"usage":"作谓语、定语、状语；形容非常珍视喜欢"},{"id":14486,"word":"如虎傅翼","pinyin":"rú hǔ fù yì","abbr":"rhfy","explanation":"好像老虎生出翅膀。比喻因增加新助力，强者愈强，恶者愈恶。","source":{"text":"得习吉之才笔，如虎之傅翼也。","book":"宋·孙光宪《北梦琐言》卷十七"},"example":{"text":"及出而武断乡曲，则～，择肉而食。","book":"梁启超《中国积弱溯源论》第二节"},"similar":["如虎得翼","如虎生翼","如虎添翼"],"usage":"作谓语、宾语、分句；指更加得势"},{"id":14487,"word":"如虎得翼","pinyin":"rú hǔ dé yì","abbr":"rhdy","explanation":"比喻因增加新助力，强者愈强，恶者愈恶。同“如虎傅翼”。","source":{"text":"二狐有将相之才，今从重耳，如虎得翼。","book":"《东周列国志》第三五回"},"similar":["如虎傅翼","如虎生翼","如虎添翼"],"usage":"作谓语、宾语、分句；指更加得势"},{"id":14488,"word":"如虎添翼","pinyin":"rú hǔ tiān yì","abbr":"rhty","explanation":"好像老虎长上了翅膀。比喻强有力的人得到帮助变得更加强有力。","source":{"text":"将能执兵之权，操兵之势，而临群下，臂如猛虎加之羽翼，而翱翔四海。","book":"三国·蜀·诸葛亮《心书·兵机》"},"example":{"text":"因为匪徒们深知，这两件东西一掌握在姜青山手里，就～，再多的人也奈何不了他。","book":"曲波《林海雪原》二七"},"similar":["锦上添花"],"opposite":["雪上加霜"],"usage":"作谓语、宾语、分句；指更加得势"},{"id":14489,"word":"如虎生翼","pinyin":"rú hǔ shēng yì","abbr":"rhsy","explanation":"比喻因增加新助力，强者愈强，恶者愈恶。同“如虎傅翼”。","source":{"text":"今玄德得诸葛亮为辅，如虎生翼矣。","book":"《三国演义》第三九回"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“恶人～，势必择人而食；志士如鹰在笼，自是凌霄有志。”"},"similar":["如虎傅翼","如虎添翼","如虎得翼"],"usage":"作谓语、宾语、分句；指更加得势"},{"id":14490,"word":"如蚁慕膻","pinyin":"rú yǐ mù shān","abbr":"ryms","explanation":"膻：羊肉的气味。象蚂蚁趋附羊肉一般。比喻许多臭味相投的人追求不好的事物。也比喻许多人依附有钱有势的人。","source":{"text":"羊肉不慕蚁，蚁慕羊肉，羊肉膻也。","book":"《庄子·徐无鬼》"},"example":{"text":"士趋其门，～。","book":"宋·刘克庄《叶寺丞墓志铭》"},"similar":["如蚁附膻"],"usage":"作谓语、定语；指追逐名利"},{"id":14491,"word":"如蚁附膻","pinyin":"rú yǐ fù shān","abbr":"ryfs","explanation":"附：趋附；膻：羊肉的气味。象蚂蚁趋附羊肉一般。比喻许多臭味相投的人追求不好的事物。也比喻许多人依附有钱有势的人。","source":{"text":"羊肉不慕蚁，蚁慕羊肉，羊肉膻也。","book":"《庄子·徐无鬼》"},"example":{"text":"官之接西官，如鼠遇虎；商之媚西商，～。","book":"清·梁启超《变法通议·论译书》"},"similar":["臭味相投","趋炎附势"],"usage":"作谓语、定语；指追逐名利"},{"id":14492,"word":"如蝇逐臭","pinyin":"rú yíng zhú chòu","abbr":"ryzc","explanation":"象苍蝇跟着有臭味的东西飞。比喻人奉承依附有权势的人或一心追求钱财、女色等。","source":{"text":"那媳妇却倒伶俐，又兼有几分姿色，看着贵儿无能力，便每日家打扮的妖妖调调，两只眼儿水汪汪的，招惹的赖大家人如蝇逐臭，渐渐做出些风流勾当来。","book":"清·曹雪芹《红楼梦》第七十七回"},"example":{"text":"是以一国之人转相仿效，如蚁附膻，～。（清·梁启超《中国积弱溯源论》）"},"similar":["如蚁附膻"],"usage":"作谓语、定语；用于追求女色名利"},{"id":14493,"word":"如见其人","pinyin":"rú jiàn qí rén","abbr":"rjqr","explanation":"像看到他本人一样，形容对人物刻画非常生动逼真。","source":{"text":"濯濯其英，晔晔其光，如闻其声，如见其容。","book":"唐·韩愈《独孤申叔哀辞》"},"example":{"text":"为了让读者看到、听到和感觉到人物，～，如闻其声，而不是仅仅知道他的一个名字……","book":"徐迟《“特写选”序言》"},"similar":["如闻其声"],"usage":"作谓语、定语；用于书面语"},{"id":14494,"word":"如见其人，如闻其声","pinyin":"rú jiàn qí rén，rú wén qí shēng","abbr":"rjqrrwqs","explanation":"象看到某个人，听到他的声音一样。形容刻画、描写人物生动逼真。","source":{"text":"濯濯其英，晔晔其光，如闻其声，如见其容。","book":"唐·韩愈《独孤申叔哀辞》"}},{"id":14495,"word":"如见肺肝","pinyin":"rú jiàn fèi gān","abbr":"rjfg","explanation":"就象看透肺肝一样。比喻心里想些什么，人们看得清清楚楚（含贬义）。","source":{"text":"人之视己，如见其肺肝然，则何益矣？","book":"西汉·戴圣《礼记·大学》"},"example":{"text":"奈余成各视他～，任他说得天花乱坠，总如充耳不闻。","book":"清·黄小配《大马扁》第四回"},"usage":"作谓语、定语；指看得清清楚楚","story":["西汉时期，戴圣在《礼记》中解释诚意的含义，他认为一个人如真有诚意就必须慎独。不慎独的人背后无恶不作，等见到诚意的君子后就想去遮掩自己的罪行劣迹，却不知人家一看他就如见肺肝一样，是万万遮盖不过的"]},{"id":14496,"word":"如解倒悬","pinyin":"rú jiě dào xuán","abbr":"rjdx","explanation":"像解下被倒吊着的人。比喻把人从危难中解救出来。","source":{"text":"当今之时，万乘之国行仁政，民之悦之，犹解倒悬也。","book":"《孟子·公孙丑上》"},"example":{"text":"救邯郸～，怎禁得按兵不遣。","book":"明·胡文焕《群音类选·八义记·托颜传信》"},"similar":["解民倒悬"],"usage":"作谓语、状语；指解困"},{"id":14497,"word":"如诉如泣","pinyin":"rú sù rú qì","abbr":"rsrq","explanation":"像在诉说，又好像在哭泣。形容声音悲切。","source":{"text":"其声呜呜然，如怨如慕，如泣如诉。","book":"宋·苏轼《前赤壁赋》"},"similar":["如泣如诉"],"usage":"作谓语、定语；形容乐声等"},{"id":14498,"word":"如赴汤火","pinyin":"rú fù tāng huǒ","abbr":"rfth","explanation":"好像迈进开水和火中。比喻进入极其危险的境地。","source":{"text":"命入朝廷，如赴汤火。","book":"汉·韩婴《韩诗外传》卷一"}},{"id":14499,"word":"如足如手","pinyin":"rú zú rú shǒu","abbr":"rzrs","explanation":"手足：比喻兄弟。比喻兄弟的感情亲密无间。","source":{"text":"谁无兄弟，如足如手。","book":"唐·李华《吊古战场文》"},"usage":"作谓语、定语；用于比喻句"},{"id":14500,"word":"如蹈水火","pinyin":"rú dǎo shuǐ huǒ","abbr":"rdsh","explanation":"像走入水火之中。比喻处境艰难。","source":{"text":"命入朝廷，如赴汤火。","book":"汉·韩婴《韩诗外传》卷一"},"example":{"text":"若宰民者，头会箕敛以毒天下，使祖宗之民～，为害尤甚。","book":"《元史·张德辉传》"},"similar":["如蹈汤火"],"usage":"作谓语、定语；指处境危险"},{"id":14501,"word":"如蹈汤火","pinyin":"rú dǎo tāng huǒ","abbr":"rdth","explanation":"蹈：踩；汤：滚水。如同在滚水、烈火中行走一样。比喻处境艰险。","source":{"text":"命入朝廷，如赴汤火。","book":"汉·韩婴《韩诗外传》卷一"},"example":{"text":"入入公门，～。","book":"清·蒲松龄《聊斋志异·冤狱》"},"similar":["如蹈水火"],"usage":"作谓语、定语；指处境危险"},{"id":14502,"word":"如运诸掌","pinyin":"rú yùn zhū zhǎng","abbr":"ryzz","explanation":"象放在手心里摆弄一样。形容事情办起来非常容易。","source":{"text":"杨朱见梁王，言治天下如运诸掌。","book":"《列子·杨朱》"},"usage":"作谓语；指十分容易"},{"id":14503,"word":"如醉初醒","pinyin":"rú zuì chū xǐng","abbr":"rzcx","explanation":"象酒醉才醒一般。比喻刚从沉迷中醒悟过来。","source":{"text":"黄歇如梦初觉，如醉初醒。","book":"明·冯梦龙《东周列国志》第一百三回"},"similar":["如醉方醒"],"usage":"作谓语、定语；指刚醒悟"},{"id":14504,"word":"如醉如梦","pinyin":"rú zuì rú mèng","abbr":"rzrm","explanation":"形容处于不清醒、迷糊状态中。","source":{"text":"恭兄文字状子已投之当路，如醉如梦，面前事尚不能管得，何可望以等。","book":"宋·朱熹《答吕子约》"},"similar":["如梦如醉","如痴如梦"],"usage":"作谓语、定语、状语；用于处事"},{"id":14505,"word":"如醉如狂","pinyin":"rú zuì rú kuáng","abbr":"rzrk","explanation":"形容神态失常，不能自制。亦指为某人某事所倾倒。","source":{"text":"这些人还指望出张续案，放遭告考，把一个长安子弟，弄得的如醉如狂。","book":"《初刻白案惊奇》卷二五"},"example":{"text":"曾朴《孽海花》第31回：“一群客人也～，有哗笑的，有打闹的，有拇战的，有耳语的。”"},"similar":["如痴如狂"],"usage":"作谓语、定语、状语；用于处事"},{"id":14506,"word":"如醉如痴","pinyin":"rú zuì rú chī","abbr":"rzrc","explanation":"形容神态失常，失去自制。","source":{"text":"得见了王昭君，使朕如痴似醉。","book":"元·马致远《汉宫秋》第二折"},"example":{"text":"真也弄得个～，眠思梦想。","book":"明·东鲁古狂生《醉醒石》第十三回"},"similar":["神魂颠倒","如梦如醉","自我陶醉"],"opposite":["恍然大悟"],"usage":"作谓语、定语、状语；指神态失常"},{"id":14507,"word":"如醉方醒","pinyin":"rú zuì fāng xǐng","abbr":"rzfx","explanation":"方：刚才。象酒醉才醒一般。比喻刚从沉迷中醒悟过来。","source":{"text":"三藏闻言，如醉方醒，似梦初觉，乐以忘忧，称谢不尽。","book":"明·吴承恩《西游记》第五十四回"},"similar":["如醉初醒"],"usage":"作谓语、定语；指刚醒悟"},{"id":14508,"word":"如释重负","pinyin":"rú shì zhòng fù","abbr":"rszf","explanation":"释：放下；重负：重担子。象放下重担那样轻松。形容紧张心情过去以后的的轻松愉快。","source":{"text":"昭公出奔，民如释重负。","book":"《谷梁传·昭公二十九年》"},"example":{"text":"姐姐～似的松了一口气。","book":"曲波《林海雪原》一"},"similar":["轻装上阵"],"opposite":["如牛负重"],"usage":"作谓语、宾语、状语；指消除紧张的心情","story":["春秋时期，鲁昭公姬稠童心未泯，贪图享受，视国家大事为儿戏，弄得老百姓很不安宁。他因管季平子与昭伯两家斗鸡的事而激怒了叔孙氏，季孙氏、孟孙氏与叔孙氏三家联手把鲁昭公赶出鲁国，史书上写：“昭公出奔，民如释重负。”"]},{"id":14509,"word":"如锥画沙","pinyin":"rú zhuī huà shā","abbr":"rzhs","explanation":"象用锥子在沙上画出来似的。形容书法笔力匀整而不露锋芒。","source":{"text":"用笔……如锥画沙……欲其匀面藏锋。","book":"宋·姜夔《续书谱·用笔》"},"usage":"作谓语；用于书法"},{"id":14510,"word":"如闻其声，如见其人","pinyin":"rú wéi qí shēng，rú jiàn qí rén","abbr":"rwqsrjqr","explanation":"象听到他的声音，象见到他本人一样。形容对人物的刻画和描写非常生动逼真。","source":{"text":"濯濯其英，晔晔其光，如闻其声，如见其容。","book":"唐·韩愈《独孤申叔哀辞》"},"example":{"text":"这部小说的人物描写生动细腻，读来使人～。"},"similar":["栩栩如生"],"usage":"作谓语、分句；形容非常生动"},{"id":14511,"word":"如雷灌耳","pinyin":"rú léi guàn ěr","abbr":"rlge","explanation":"响亮得像雷声传进耳朵里。形容人的名声大","source":{"text":"久闻贤士大名，如雷灌耳。今日幸遇尊颜，实乃小官万幸也。","book":"元·无名氏《渔樵记》第一折"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“现在左宗棠的这十个字，分量之重，～。”"},"similar":["如雷贯耳"],"usage":"作谓语、定语；用于客套话"},{"id":14512,"word":"如雷贯耳","pinyin":"rú léi guàn ěr","abbr":"rlge","explanation":"贯：贯穿，进入。响亮得象雷声传进耳朵里。形容人的名声大。","source":{"text":"久闻先生大名，如雷贯耳。","book":"元·无名氏《冻苏秦》第一折"},"example":{"text":"小可久闻员外大名，～。","book":"明·施耐庵《水浒全传》第六十二回"},"similar":["名满天下","闻名遐尔","如雷灌耳"],"opposite":["无名小卒"],"usage":"作谓语、定语；用于客套话","story":["东汉时期，董卓利用实力把持朝政，图谋篡位，司徒王允和养女貂禅商定要利用吕布杀了董卓。王允先把貂禅许给吕布，然后献给董卓，吕布见貂禅被董卓霸占，心里十分气愤与无奈，貂禅表示吕布名声如雷贯耳，愿意跟他共度一生"]},{"id":14513,"word":"如风过耳","pinyin":"rú fēng guò ěr","abbr":"rfge","explanation":"象风在耳边吹过一样。比喻漠不关心，不相关涉。","source":{"text":"富贵之于我，如秋风之过耳。","book":"汉·赵晔《吴越春秋·吴王寿梦传》"},"example":{"text":"凤孙听了这些话，倒也～，毫不在意。","book":"清·曾朴《孽海花》第二十三回"},"similar":["秋风过耳"],"usage":"作谓语、定语；指不关心"},{"id":14514,"word":"如食哀梨","pinyin":"rú shí āi lí","abbr":"rsal","explanation":"哀梨：传说哀仲家的梨，味道很好。好像吃到哀梨一样。比喻言辞、文章浏爽利。","source":{"text":"桓南郡每见人不快，辄嗔曰：‘君得哀家梨，当复不蒸食不？’","book":"南朝·宋·刘义庆《世说新语·轻诋》"}},{"id":14515,"word":"如饥似渴","pinyin":"rú jī sì kě","abbr":"rjsk","explanation":"形容要求很迫切，好像饿了急着要吃饭，渴了急着要喝水一样。","source":{"text":"迟奉圣颜，如渴如饥。","book":"三国魏·曹植《责躬》计"},"example":{"text":"我～地把那二十几页的长文，一口气读下去。","book":"郭沫若《革命春秋·学生时代》"},"similar":["迫不及待","手不释卷"],"opposite":["不慌不忙","四平八稳"],"usage":"作谓语、宾语、定语、状语；指要求强烈","story":["三国时期，曹操原打算立曹植为太子，引起长子曹丕的妒恨。曹丕即位，多次迫害曹植，三次更换他的封地。223年，曹丕要曹植、曹彰、曹彪三人到京都朝会，曹植因故不能去，就上一道奏章向曹丕请罪说：“迟奉圣颜，如饥似渴。”"]},{"id":14516,"word":"如饥如渴","pinyin":"rú jī rú kě","abbr":"rjrk","explanation":"形容迫切的心情或要求。","source":{"text":"宋江陪笑道：‘怎敢相戏。实慕员外威德，如饥如渴。万望不弃鄙处，为山寨之主，早晚共听严命。’","book":"明·施耐庵《水浒传》第六十二回"},"example":{"text":"吴运铎《把一切献给党·永远前进》：“我～地读着各种文学书和理论书，也学了外科医药知识。”"},"similar":["如饥似渴"],"usage":"作谓语、宾语、定语、状语；指要求强烈"},{"id":14517,"word":"如饮水者，冷热自知","pinyin":"rú yǐn shuǐ zhě，lěng rè zì zhī","abbr":"ryszlrzz","explanation":"指自己直接经历的事，自己最了解。","source":{"text":"如饮水者，冷热自知。","book":"唐·善无畏《大日经疏》第12卷"},"similar":["如人饮水，冷暖自知"],"usage":"作宾语、分句；指直接经历的事自己了解"},{"id":14518,"word":"如饮醍醐","pinyin":"rú yǐn tí hú","abbr":"ryth","explanation":"比喻使人思想上一下就通了。","source":{"text":"少卿妙论，令我闻之如饮醍醐。","book":"清·吴敬梓《儒林外史》第34回"},"similar":["顿开茅塞"],"usage":"作谓语；指顿开茅塞"},{"id":14519,"word":"如鱼似水","pinyin":"rú yú sì shuǐ","abbr":"ryss","explanation":"比喻关系融洽、亲密。","source":{"text":"那田氏比先前二妻，更有姿色。肌肤若冰雪，绰约似神仙。庄生不是好色之徒，却也十分相敬，真个如鱼似水。","book":"明·冯梦龙《警世通言》第二卷"},"example":{"text":"明·冯梦龙《喻世明言》第一卷：“夫妻两个～，寸步难离。”"},"similar":["如胶似漆","似水如鱼"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":14520,"word":"如鱼得水","pinyin":"rú yú dé shuǐ","abbr":"ryds","explanation":"好像鱼得到水一样。比喻有所凭借。也比喻得到跟自己十分投合的人或对自己很合适的环境。","source":{"text":"孤之有孔明，犹鱼之有水也。","book":"《三国志·蜀书·诸葛亮传》"},"example":{"text":"若使他回来了，我们就应该～，欢喜的了不得，那里还有功夫在这里纳闷呢！","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"similar":["如虎添翼","情投意合"],"opposite":["寸步难行"],"usage":"作谓语、宾语、状语；指对自己很合适的环境","story":["东汉末年，刘备从汉献帝刘协那里弄个名正言顺的皇叔身份，没有得到固定的封地，只好投奔同族刘表，刘表送给他新野地区，经过司马徽等推荐，刘备三顾茅庐请出诸葛亮，赤壁之战大胜曹操，刘备骄傲地说得到孔明他就如鱼得水"]},{"id":14521,"word":"如鱼离水","pinyin":"rú yú lí shuǐ","abbr":"ryls","explanation":"离开适当的地位或赖以生存的环境。","example":{"text":"离开故土，他就像～一般难受。"},"similar":["虎落平阳"],"opposite":["如鱼得水"],"usage":"作宾语、定语；指离开生存环境"},{"id":14522,"word":"如鱼饮水，冷暖自知","pinyin":"rú yú yǐn shuǐ，lěng nuǎn zì zhī","abbr":"ryyslnzz","explanation":"泛指自己经历的事，自己知道甘苦。同“如人饮水，冷暖自知”。","source":{"text":"至于有法无法，有相无相，如鱼饮水，冷暖自知。","book":"宋·岳珂《桯史·记龙眠海会图》"},"example":{"text":"况且‘～’，用庸俗的话来说，就是‘自家有病自家知’罢。","book":"鲁迅《〈故事新新编〉序言》"},"similar":["如人饮水，冷暖自知"],"usage":"作宾语、分句；指直接经历的事自己了解"},{"id":14523,"word":"如鲠在喉","pinyin":"rú gěng zài hóu","abbr":"rgzh","explanation":"鱼骨头卡在喉咙里。比喻心里有话没有说出来，非常难受。","source":{"text":"韦曰：‘骨所以鲠，刺人也。’忠言逆耳，如食骨在喉，故云骨鲠之臣。《汉书》以下皆作骨鲠，字从鱼，谓留咽者鱼骨较多也。","book":"汉·许慎《说文解字》：“鲠，食骨留咽中也。”段玉裁注"},"similar":["骨鲠在喉"],"usage":"作谓语、定语；用于人的处境等"},{"id":14524,"word":"如鸟兽散","pinyin":"rú niǎo shòu sàn","abbr":"rnss","explanation":"象一群飞鸟走兽一样逃散。形容溃败逃散。也比喻集团或组织解散后，其成员各奔东西。","source":{"text":"今无兵复战，天明坐受缚矣！各鸟兽散，犹有得脱归报天子者。","book":"《汉书·李陵传》"},"example":{"text":"粤兵素弱，见之即溃，～。","book":"清·采蘅子《虫鸣漫录》"},"similar":["逃之夭夭"],"opposite":["云合雾散"],"usage":"作谓语、定语、状语；指溃败","story":["汉武帝刘彻任命大将李广的孙子李陵为骑都尉，驻守北方边境。一次他率领五千人马从居延杀出，攻打匈奴境内的浚稽山，把三万匈奴兵杀得大败，匈奴单于派八万大军前来包围，汉军孤立无援，李陵只好叫伤残士兵作鸟兽散以免全军覆没"]},{"id":14525,"word":"如鼓琴瑟","pinyin":"rú gǔ qín sè","abbr":"rgqs","explanation":"琴瑟：古代弦乐器。好像弹奏琴瑟一样。比喻夫妻间像弹奏琴瑟那样和谐美好。","source":{"text":"妻子好合，如鼓琴瑟。","book":"《诗经·小雅·常棣》"},"example":{"text":"清依斯论，～。","book":"《闺训千字文》"}},{"id":14526,"word":"如龙似虎","pinyin":"rú lóng sì hǔ","abbr":"rlsh","explanation":"形容勇猛有活力。","source":{"text":"云气变幻无穷，倏忽如龙似虎。人情世态，大率相同。","book":"明·方汝浩《禅真逸史》第三十九回"},"example":{"text":"马上的将官，纵～，马倒了，都倒栽葱跌将下来。","book":"《西湖佳话·岳坟忠迹》"},"similar":["生龙活虎"],"usage":"作谓语、定语；用于书面语"},{"id":14527,"word":"妄下雌黄","pinyin":"wàng xià cí huáng","abbr":"wxch","explanation":"乱改文字，乱发议论。","source":{"text":"校定书籍，亦何容易？自扬雄刘向方称此职耳。观天下书未遍，不得妄下雌黄。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"不是弟～，只怕唐兄印行的《不息斋稿》，虽然风行一时，决不能望《五丁阁稿》的项背哩！","book":"曾朴《孽海花》第三回"},"similar":["信口雌黄","信口开河"],"opposite":["言之成理","言必有据"],"usage":"作谓语、宾语；指乱发议论"},{"id":14528,"word":"妄作胡为","pinyin":"wàng zuò hú wéi","abbr":"wzhw","explanation":"妄：狂妄；胡：乱。不顾法纪或舆论，毫无顾忌地做坏事。","source":{"text":"似恁般妄作胡为，敢欺侮咱浮踪浪迹。","book":"元·王子一《误入桃源》第三折"},"example":{"text":"你既已死了，如何又在人世，～，乱惑生人？","book":"明·凌濛初《初刻拍案惊奇》卷二十三"}},{"id":14529,"word":"妄口巴舌","pinyin":"wàng kǒu bā shé","abbr":"wkbs","explanation":"比喻胡言乱语。有时也指造谣污蔑。","source":{"text":"只要自己拿定主意，必定还要妄口巴舌血淋淋的起这样恶誓么？","book":"清·曹雪芹《红楼梦》第120回"},"similar":["胡言乱语"],"usage":"作谓语、宾语；指造谣污蔑"},{"id":14530,"word":"妄尘而拜","pinyin":"wàng chén ér bài","abbr":"wceb","explanation":"指迎候有权势的人，看见车扬起的尘土就下拜。形容卑躬屈膝的神态。"},{"id":14531,"word":"妄生异议","pinyin":"wàng shēng yì yì","abbr":"wsyy","explanation":"妄：胡乱地；生：发出；异：怪异。乱发怪议论。","source":{"text":"田舍翁多收十斛麦，尚欲易妇；况天子欲立一后，何豫诸人事而妄生异议乎！","book":"《资治通鉴·唐纪·太宗永徽六年》"},"example":{"text":"还京，下刑部治罪，比挟诈欺公、～律，坐斩决。","book":"《清史稿·尹壮图传》"}},{"id":14532,"word":"妄生穿凿","pinyin":"wàng shēng chuān záo","abbr":"wscz","explanation":"妄：胡乱地。指胡乱地去穿凿附会。","source":{"text":"世传不真，妄生穿凿，唯按此行之，乃见其验。","book":"宋·张君房《云笈七签》"},"similar":["望文生义","牵强附会"],"usage":"作谓语、宾语；指望文生义"},{"id":14533,"word":"妄自尊大","pinyin":"wàng zì zūn dà","abbr":"wzzd","explanation":"过高地看待自己。形容狂妄自大，不把别人放眼里。","source":{"text":"子阳井底蛙耳，而妄自尊大，不如专意东方。","book":"《后汉书·马援传》"},"example":{"text":"王冕接过来看，才晓得危素归降之后，～，在太祖面前自称老臣。","book":"清·吴敬梓《儒林外史》第一回"},"similar":["夜郎自大","目空一切","妄自尊崇"],"opposite":["自轻自贱","自暴自弃"],"usage":"作谓语、定语；不把别人放眼里","story":["西汉末年，各地军阀各自为政，公孙述在成都称帝，陇西一霸隗嚣派大将马援去公孙述处打探军情。面对这个同乡，公孙述摆出帝王的威严接待。马援回去对隗嚣说：“公孙述是井底之蛙，妄自尊大。”后来马援去投奔刘秀"]},{"id":14534,"word":"妄自尊崇","pinyin":"wàng zì zūn chóng","abbr":"wzzc","explanation":"妄：过分地；尊：高贵。过高地看待自己。形容狂妄自大。","example":{"text":"对他那种～的人不必太在意。"},"similar":["妄自尊大"],"usage":"作谓语、定语；不把别人放眼里"},{"id":14535,"word":"妄自菲薄","pinyin":"wàng zì fěi bó","abbr":"wzfb","explanation":"妄：胡乱的；菲薄：小看，轻视。过分看轻自己。形容自卑。","source":{"text":"不宜妄自菲薄，引喻失义，以塞忠谏之路也。","book":"三国蜀·诸葛亮《前出师表》"},"example":{"text":"单靠这几个人办不出什么大事。但对于自己，荪甫从来不肯“～”。","book":"茅盾《子夜》三"},"similar":["自惭形秽","自轻自贱"],"opposite":["目中无人","目空一切"],"usage":"作谓语、宾语；指自卑","story":["三国时期，刘备死后，诸葛亮辅佐刘禅复兴汉室，他竭尽全力筹划北伐曹魏，刘禅胸无大志，没有治国才能，诸葛亮深表忧虑，出征前夕写《前出师表》，要他教育好百官不忘先帝恩情，应该发愤图强，不能妄自菲薄"]},{"id":14536,"word":"妄言则乱","pinyin":"wàng yán zé luàn","abbr":"wyzl","explanation":"妄：胡乱地。随意乱说话，往往会造成灾祸。指说话应该谨慎。","source":{"text":"夫目妄视则淫，耳妄听则惑，口妄言则乱，夫三关者，不可不慎守也。","book":"《淮南子·主术训》"},"similar":["言多必失"],"usage":"作谓语、定语；用于处事"},{"id":14537,"word":"妄言妄听","pinyin":"wàng yán wàng tīng","abbr":"wywt","explanation":"妄：不实。说得人随便说，听的人随便听，都不认真看待。","source":{"text":"予尝为女（汝）妄言之，女（汝）妄听之奚。","book":"《庄子·齐物论》"},"example":{"text":"～，记而存之，非有所感也。","book":"鲁迅《中国小说史略·清之拟晋唐小说及其支流》"},"usage":"作谓语、定语；指两方面都不认真看待"},{"id":14538,"word":"妄言妄语","pinyin":"wàng yán wàng yǔ","abbr":"wywy","explanation":"妄：虚妄，不真实。指胡言乱语。","example":{"text":"你不要相信他的～。"},"similar":["胡言乱语"],"usage":"作谓语、宾语、定语；指胡言乱语"},{"id":14539,"word":"妄言轻动","pinyin":"wàng yán qīng dòng","abbr":"wyqd","explanation":"妄言：胡乱说；轻动：轻率地行动。指言行不稳重。","source":{"text":"宝钗原不妄言轻动，便此时亦是坦然自若。","book":"清·曹雪芹《红楼梦》第二十二回"},"example":{"text":"老于世故者，虽也心知有异，但一来慑于玉帅的权威，二来毫无凭据，谁敢～。","book":"聂云岚《玉娇龙》第二十七回"}},{"id":14540,"word":"妄谈祸福","pinyin":"wàng tán huò fú","abbr":"wthf","explanation":"无根据地预言祸福之事。","source":{"text":"像这种当个顽意儿，不必问他真的假的，倒也无伤大雅，至于那一种妄谈祸福的，就要不得。","book":"清·吴趼人《二十年目睹之怪现状》第二十五回"},"usage":"作谓语、定语；用于处事"},{"id":14541,"word":"妆嫫费黛","pinyin":"zhuāng mó fèi dài","abbr":"zmfd","explanation":"比喻帮助人不看对象，白费力气。","source":{"text":"妆嫫徒费黛，磨甋讵成璋？","book":"唐·白居易《五古·渭村退居寄礼部崔侍郎翰林钱舍人诗一百韵》"},"example":{"text":"你这样做无疑是～。"},"usage":"作宾语、定语；指不看对象"},{"id":14542,"word":"妆模作样","pinyin":"zhuāng mó zuò yàng","abbr":"zmzy","explanation":"故意做样子给人看。","source":{"text":"你们两个起先那样爱他，如今走到面前，又这等妆模作样。","book":"清·李渔《蜃中楼·双订》"},"example":{"text":"清·李渔(蜃中楼·双订》：“你们两个起先那样爱他，如今走到面前，又这等～。”"},"similar":["装模作样","装模装样"],"usage":"作谓语、定语、状语；指故做姿态"},{"id":14543,"word":"妆点一新","pinyin":"zhuāng diǎn yī xīn","abbr":"zdyx","explanation":"经过装饰点缀后，焕然一新。","source":{"text":"先期后苑及修内司分任排办，凡诸苑亭榭花木，妆点一新。","book":"宋·周密《武林旧事》卷二"}},{"id":14544,"word":"妆聋做哑","pinyin":"zhuāng lóng zuò yǎ","abbr":"zlzy","explanation":"假装耳聋口哑，故意不理睬。","source":{"text":"一个悄悄冥冥，一个絮絮答答。却早禁住隋何，迸住陆贾，叉手躬身，妆聋做哑。","book":"元·王实甫《西厢记》第三本第三折"},"example":{"text":"你不想中国三十年兵燹，是那个开端？前前后后糟蹋几许生灵，你还～么？","book":"清·魏秀仁《花月痕》第四七回"},"similar":["装聋作哑"],"usage":"作谓语、宾语、状语；指故意当不知道"},{"id":14545,"word":"妇人之仁","pinyin":"fù rén zhī rén","abbr":"frzr","explanation":"仕：仁慈。妇女的软心肠。旧指处事姑息优柔，不识大体。","source":{"text":"项王见人，恭敬慈爱，言语呕呕，人有疾病，涕泣分食饮，至使人有功，当封爵者，印刓弊，忍不能予，此所谓妇人之仁也。","book":"《史记·淮阴侯列传》"},"example":{"text":"吴王有～，而无丈夫之决。","book":"明·冯梦龙《东周列国志》第八十回"},"opposite":["铁石心肠","胸怀大略"],"usage":"作宾语；指不识大体","story":["秦朝末年，韩信与刘邦讨论项羽的为人，韩信认为项羽非常勇猛，他大喝一声可以让百人倒下，就是不会任人唯贤。他的勇猛是匹夫之勇，论仁慈，他有妇人之仁，该行赏的时候特别吝啬，他的仁慈局限在小的方面，所以不能得天下"]},{"id":14546,"word":"妇人之见","pinyin":"fù rén zhī jiàn","abbr":"frzj","explanation":"妇女的见解。由于旧时轻视妇女，故用来比喻平庸的见解。","source":{"text":"皆因奴家妇人之见，一味劝夫慎重，不可在外眠花卧柳，恐惹父母担忧。","book":"清·曹雪芹《红楼梦》第68回"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“马逢时破颜一笑，‘真正～。’”"},"similar":["短见拙识"],"opposite":["真知灼见"],"usage":"作主语、宾语；用于指责等场合"},{"id":14547,"word":"妇人女子","pinyin":"fù rén nǜ zǐ","abbr":"frnz","explanation":"泛指妇女。也常含有轻视妇女柔弱无能的意思。","source":{"text":"妇人女子之德，奉父母舅姑尽恭顺，和于娣姒，于卑幼有慈爱，而能不失其贞者，则贤矣。","book":"唐·李翱《杨烈妇传》"},"example":{"text":"阮大钺趋附权奸，廉耻丧尽，～，无不唾骂。","book":"清·孔尚任《桃花扇》"}},{"id":14548,"word":"妇人孺子","pinyin":"fù rén rú zǐ","abbr":"frrz","explanation":"妇女孩子。","source":{"text":"今者治平之日久，天下之人骄惰脆弱，如妇人孺子不出于闺门。","book":"《教战守策》"}},{"id":14549,"word":"妇人醇酒","pinyin":"fù rén chún jiǔ","abbr":"frcj","explanation":"指沉湎于酒色。","source":{"text":"秦数使反閒……公子（无忌）自知再以毁废，乃谢病不朝，与宾客为长夜饮，饮醇酒，多近妇女，日夜为乐者四岁，竟病酒卒。","book":"语出《史记·魏公子列传》"},"example":{"text":"容易河阳丝两鬓，～未应怜。","book":"宁调元《燕京杂记》之二"},"similar":["醇酒妇人"],"usage":"作主语、宾语、定语；指酒色","story":["战国时期，赵国被秦兵围困，赵相平原君派人向魏国求救，魏王派大将晋鄙率军救赵，迫于秦国的压力，晋鄙不敢行动。魏公子信陵君盗取兵符，杀了晋鄙，亲自率军救赵。他中了秦王的反间计被魏王免职，他只好纵情于醇酒美人之中"]},{"id":14550,"word":"妇姑勃溪","pinyin":"fù gū bó xī","abbr":"fgbx","explanation":"指婆媳间的争吵与不和。比喻因日常鸡毛蒜皮的小事而争吵。","source":{"text":"室无空虚，则妇姑勃溪。","book":"庄周《庄子·外物》"},"example":{"text":"现在我可以大胆地用‘～’这句古典了。","book":"鲁迅《华盖集·碰壁之后》"}},{"id":14551,"word":"妇姑勃谿","pinyin":"fù gū bó xī","abbr":"fgbx","explanation":"妇姑：儿媳和婆婆；勃谿：家庭争吵。原指婆婆和儿媳间的争吵。后也比喻内部争斗。","source":{"text":"室无空虚，则妇姑勃谿。","book":"《庄子·外物》"},"example":{"text":"而往往不过是将败落家族的～，叔嫂斗法的手段，移到文坛上。","book":"鲁迅《且介亭杂文末编·答徐懋庸并关于抗日统一战线问题》"},"similar":["妇姑勃溪"],"usage":"作宾语、定语；比喻内部争斗"},{"id":14552,"word":"妇姑勃豨","pinyin":"fù gū bó xī","abbr":"fgbx","explanation":"妇姑儿媳和婆婆；勃豨家庭争吵。原指婆婆和儿媳间的争吵◇也比喻内部争斗。","source":{"text":"室无空虚，则妇姑勃豨。","book":"《庄子·外物》"},"quote":{"text":"而往往不过是将败落家族的～，叔嫂斗法的手段，移到文坛上。","book":"鲁迅《且介亭杂文末编·答徐懋庸并关于抗日统一战线问题》"}},{"id":14553,"word":"妇孺皆知","pinyin":"fù rú jiē zhī","abbr":"frjz","explanation":"孺：小孩。妇女、小孩全都知道。指众所周知。","source":{"text":"今秦妇人、婴儿皆言商君之法，莫言大王之法。","book":"西汉·刘向《战国策·秦策》"},"example":{"text":"这件事在小镇上已经是～的了。"},"similar":["家喻户晓","尽人皆知"],"opposite":["鲜为人知"],"usage":"作谓语、定语、补语；形容简单明了的事物"},{"id":14554,"word":"妇道人家","pinyin":"fù dào rén jiā","abbr":"fdrj","explanation":"妇道：妇人应遵守的道德规范。指成年女子。","source":{"text":"这件事还得与拙夫商量，妇道人家，不便十分作主。","book":"清·吴趼人《二十年目睹之怪现状》第34回"},"example":{"text":"而且一个～，被拉在外村受这种损躏，众人心里实在不是滋味。","book":"路遥《平凡的世界》第一卷第九章"},"opposite":["巾帼英雄"],"usage":"作主语、宾语、定语；多用于蔑视"},{"id":14555,"word":"妍姿妖艳","pinyin":"yán zī yāo yàn","abbr":"yzyy","explanation":"妍姿：美好的姿容；妖艳：美丽而妩媚。形容女子容貌美丽，妩媚动人。","source":{"text":"乃有毛嫱、西施、 荆姬、秦嬴，妍姿妖艳，一顾倾城。","book":"三国·魏·钟会《菊花赋》"},"similar":["妍姿艳质"],"usage":"作谓语、定语；用于女性"},{"id":14556,"word":"妍姿艳质","pinyin":"yán zī yàn zhì","abbr":"yzyz","explanation":"形容女子的体态容貌很美。","example":{"text":"对面来了一个～的女子。"},"similar":["妍姿妖艳"],"usage":"作谓语、定语；用于女性"},{"id":14557,"word":"妍皮不裹痴骨","pinyin":"yán pí bù guǒ chī gǔ","abbr":"ypbgcg","explanation":"妍：美好；痴：同“媸”，丑陋。美丽的皮肤，不包裹丑陋的骨头。比喻表里如一，秀外慧中。","source":{"text":"召见与语，超深自晦匿，兴大鄙之，谓绍曰：‘谚云妍皮不裹痴骨，妄语耳。’","book":"《晋书·慕容超载记》"},"example":{"text":"清·张岱《石皮妍铭》：“内马肝，外犀革，此谓～。”"},"usage":"作宾语、定语；用于比喻句","story":["晋朝时期，慕容超自以诸父在东，担心被姚氏所用，就假装行乞。前秦人看不起他，只有姚绍认为他是个人才就要姚兴给他官位。姚兴召见他，慕容超故意隐匿自己的才华。姚兴十分鄙视他，对姚绍说：“自古说的‘妍皮不裹痴骨’，此话不真。”"]},{"id":14558,"word":"妍皮痴骨","pinyin":"yán pí chī gǔ","abbr":"ypcg","explanation":"妍：美好。指外表虽美，内心却不聪明。","source":{"text":"召见与语，超深自晦匿，兴大鄙之，谓绍曰：‘谚云妍皮不裹痴骨，妄语耳。’","book":"《晋书·慕容超载记》"},"example":{"text":"行矣置之无足问，谁换～。","book":"宋·陈亮《贺新郎·寄辛幼安和见怀韵》词"},"usage":"作宾语、定语；用于比喻句"},{"id":14559,"word":"妍皮裹痴骨","pinyin":"yán pí guǒ chī gǔ","abbr":"ypgcg","explanation":"妍：美好；痴：同“媸”，丑陋。美丽的皮肤，包裹着丑陋的骨头。比喻外表虽然美好但实质却很鄙陋。","source":{"text":"貌端娟且静，气吐清而圆，妍皮裹痴骨，了不直一钱。","book":"元·王恽《秋涧全集·元日示孙阿建六十韵》"},"example":{"text":"超故为谬语，答非所问，兴顾语绍道：“谚云‘～’，今始知是妄语哩。”","book":"蔡东藩《两晋演义》第九十三回"}},{"id":14560,"word":"妍蚩好恶","pinyin":"yán chī hǎo è","abbr":"yche","explanation":"妍：美丽。蚩：通“媸”，丑陋，丑恶。美丽、丑陋、好与坏。原指写作的得失。","source":{"text":"妍蚩好恶，可得而言。","book":"晋·陆机《文赋序》"},"usage":"作宾语、定语；用于书面语"},{"id":14561,"word":"妒功忌能","pinyin":"dù gōng jì néng","abbr":"dgjn","explanation":"对有功劳或才能的人嫉妒。","source":{"text":"况陈王好信谗言，妒功忌能，将军功高益危。","book":"蔡东藩《前汉演义》第十回"}},{"id":14562,"word":"妒富愧贫","pinyin":"dù fù kuì pín","abbr":"dfkp","explanation":"对别人的富有嫉妒，对自己的贫穷羞愧。","source":{"text":"奈他们有年老的懒于热闹，有家内没有人，又有疾病淹留，要来竟不能来，有一等妒富愧贫不肯来的。","book":"清·曹雪芹《红楼梦》第五十三回"},"example":{"text":"我们不能～，得通过正当途径致富。"},"usage":"作谓语、定语、宾语；用于处世"},{"id":14563,"word":"妒火中烧","pinyin":"dù huǒ zhōng shāo","abbr":"dhzs","explanation":"因忌妒而异常激动，心神错乱或狂乱。","example":{"text":"这事使她～。"},"usage":"作谓语；指忌妒"},{"id":14564,"word":"妒能害贤","pinyin":"dù néng hài xián","abbr":"dnhx","explanation":"贤、能：有德有才的人；害：陷害。嫉妒有才能的人，陷害贤明的人。指容不下才能、品德比自己高的人。","source":{"text":"妒贤嫉能，御下蔽之。","book":"《史记·高祖本纪》：“项羽妒贤嫉能，有功者害之，贤者疑之。”《史记·范雎蔡泽列传》"},"example":{"text":"您听者，李存信～，飞虎将负屈啣冤。","book":"元·关汉卿《哭存孝》第四折"},"similar":["妒贤嫉能"],"opposite":["任贤使能"],"usage":"作谓语、定语、宾语；指妒忌别人"},{"id":14565,"word":"妒贤嫉能","pinyin":"dù xián jí néng","abbr":"dxjn","explanation":"妒、嫉：因别人好而忌恨。对品德、才能比自己强的人心怀怨恨。","source":{"text":"妒贤嫉能，御下蔽之。","book":"《史记·高祖本纪》：“项羽妒贤嫉能，有功者害之，贤者疑之。”《史记·范雎蔡泽列传》"},"example":{"text":"此人只怀～之心，但恐众豪杰势力相压。","book":"明·施耐庵《水浒全传》第十九回"},"similar":["忌贤妒能"],"opposite":["任人唯贤"],"usage":"作谓语、定语；指妒忌"},{"id":14566,"word":"妒贤疾能","pinyin":"dù xián jí néng","abbr":"dxjn","explanation":"对品德、才能比自己强的人心怀怨恨。同“妒贤嫉能”。","source":{"text":"至林甫，[帝]曰：‘是子妒贤疾能，举无比者。’","book":"《新唐书·奸臣传上·李林甫》"},"similar":["妒贤嫉能"],"opposite":["任贤使能"],"usage":"作谓语、定语、宾语；指妒忌"},{"id":14567,"word":"妖不胜德","pinyin":"yāo bù shèng dé","abbr":"ybsd","explanation":"比喻邪不压正。","source":{"text":"臣闻妖不胜德。","book":"西汉·司马迁《史记·殷本纪》"},"example":{"text":"～”，总会有拨云见日的一天","book":"俗话说"},"similar":["邪不压正"],"usage":"作宾语、定语；指邪不压正"},{"id":14568,"word":"妖声怪气","pinyin":"yāo shēng guài qì","abbr":"ysgq","explanation":"说话腔调妖里妖气，姿态怪异而轻佻。","example":{"text":"他那～让人不舒服。"},"similar":["阴阳怪气"],"usage":"作谓语、宾语、定语；指人说话"},{"id":14569,"word":"妖妖娆娆","pinyin":"yāo yāo ráo ráo","abbr":"yyrr","explanation":"指女性娇艳美好或有诱惑感。","source":{"text":"那簇人歇下轿，养娘扶女子出了轿，径望珢岳门内，袅袅娜娜，妖妖娆娆走进去。","book":"明·施耐庵《水浒传》第101回"},"example":{"text":"一个个擦着粉，戴着花，～的，‘钱太爷’、‘王二爷’，叫的应天响。","book":"清·李宝嘉《官场现形记》第45回"},"usage":"作定语、状语；多用于女性"},{"id":14570,"word":"妖孽伏息","pinyin":"yāo niè fú xī","abbr":"ynfx","explanation":"妖孽：比喻邪恶的人或事；伏：制服。杜绝了坏事或制服了邪恶的人。","source":{"text":"奸伪不萌，妖孽伏息，隅辟越远，四貉咸服。","book":"《乐府诗集·西颢》"}},{"id":14571,"word":"妖形怪状","pinyin":"yāo xíng guài zhuàng","abbr":"yxgz","explanation":"装束奇特，举止轻佻。多形容女性。","source":{"text":"他离开了营在路上走时，总看见那些妖形怪状又怪好看的女人。","book":"叶圣陶《金耳环》"},"example":{"text":"那副怪样子我就看不惯，野鸡不像野鸡，～，男人不在家，不三不四的男人一个个的带到家里来。","book":"夏衍《上海屋檐下》第一场"},"usage":"作定语、状语；用于书面语"},{"id":14572,"word":"妖歌曼舞","pinyin":"yāo gē màn wǔ","abbr":"ygmw","explanation":"曼：柔和。音乐轻快，舞姿优美。","source":{"text":"妖歌慢舞烂不收，倒心回肠为青眸。","book":"唐·韩愈《刘生诗》"}},{"id":14573,"word":"妖由人兴","pinyin":"yāo yóu rén xīng","abbr":"yyrx","explanation":"妖物因人而生。指不正常事物是由于人自己不严肃、不正派引起的。","source":{"text":"妖由人兴也。人无衅焉，妖不自作。","book":"《左传·庄公十四年》"},"example":{"text":"近在耳畔而不睹其形，方知为鬼为绐也。～，往往有焉。","book":"清·纪昀《阅微草堂笔记》卷六"},"usage":"作谓语、宾语、分句；用于书面语"},{"id":14574,"word":"妖言惑众","pinyin":"yāo yán huò zhòng","abbr":"yyhz","explanation":"妖言：迷惑人的邪说。用荒谬的鬼话迷惑人。","source":{"text":"妄设妖言惑众，大逆不道。","book":"《汉书·眭弘传》"},"example":{"text":"世上这些～的人，怎么没人治他一下子！","book":"清·曹雪芹《红楼梦》第六十七回"},"similar":["蛊惑人心","妖言惑众","蜚短流长"],"opposite":["发榜安民"],"usage":"作谓语、定语；指用荒谬的鬼话迷惑人"},{"id":14575,"word":"妖里妖气","pinyin":"yāo lǐ yāo qì","abbr":"ylyq","explanation":"形容女人装束奇特、举止轻狂而不正派。","example":{"text":"她穿得～，让人看不顺眼。"},"similar":["妖声怪气"],"opposite":["端庄大方"],"usage":"作谓语、定语；用于女性"},{"id":14576,"word":"妖魔鬼怪","pinyin":"yāo mó guǐ guài","abbr":"ymgg","explanation":"妖怪和魔鬼。比喻各种危害人民利益的邪恶势力。","source":{"text":"我家东人好傻也，安知他不是个妖魔鬼怪，便信着他跟将去了。","book":"元·李好古《张生煮海》第一折"},"example":{"text":"师父，我不是～，亦不是魍魉鬼怪了？","book":"明·吴承恩《西游记》第三十七回"},"similar":["牛鬼蛇神","魑魅魍魉"],"opposite":["救世观音"],"usage":"作主语、宾语、定语；比喻坏人"},{"id":14577,"word":"妙不可言","pinyin":"miào bù kě yán","abbr":"mbky","explanation":"妙：美妙。形容好得难以用文字、语言表达。","source":{"text":"经纪天地，错综人术，妙不可尽之于言，事不可穷之于笔。","book":"晋·郭璞《江赋》"},"example":{"text":"公子侧会其意，一吸而尽，觉甘香快嗓，～。","book":"明·冯梦龙《东周列国志》第五十九回"},"similar":["妙趣横生"],"opposite":["兴味索然"],"usage":"作谓语、定语；指十分美妙"},{"id":14578,"word":"妙喻取譬","pinyin":"miào yù qǔ pì","abbr":"myqp","explanation":"在讲解中用巧妙的比喻来阐述。","source":{"text":"只见颂久在讲坛上步来步去，妙喻取譬地讲得头头是道。","book":"郭沫若《创造十年续篇》"},"usage":"作定语、状语；用于说话或作文等"},{"id":14579,"word":"妙在心手","pinyin":"miào zài xīn shǒu","abbr":"mzxs","explanation":"巧妙在于心和手。指擅长书法，能得心应手。","source":{"text":"善书不择纸笔，妙在心手。","book":"宋·陈师道《后山丛谈》"}},{"id":14580,"word":"妙处不传","pinyin":"miào chù bù chuán","abbr":"mcbc","explanation":"指精微奥妙的地方不是言语和笔墨所能表达的。","source":{"text":"故当是其妙处不传。","book":"汉·桓谭《新论·离事》：“圣贤之材不世，而妙善之技不传。”南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"丹青妙处不可传，轮扁斫轮如此用。","book":"宋·黄庭坚《戏题小雀捕飞虫画扇》诗"},"usage":"作谓语、定语；指十分精妙","story":["晋朝时期，太傅司马道子问车骑将军谢玄说：“惠施的书有五车之多，为什么没有一句话可以进入玄理？”谢玄回答说：“原因应是他的精妙的地方没有传下来。”"]},{"id":14581,"word":"妙想天开","pinyin":"miào xiǎng tiān kāi","abbr":"mxtk","explanation":"形容想法奇特、乖谬。","source":{"text":"现在各处的教育当局却妙想天开，等到这试用期满，纷纷藉口停职。","book":"邹韬奋《萍踪寄语》"},"example":{"text":"他一时～，找些农夫来充当讲师"},"similar":["异想天开"],"usage":"作主语、谓语、定语；含讽刺意味"},{"id":14582,"word":"妙手丹青","pinyin":"miào shǒu dān qīng","abbr":"msdq","explanation":"妙手：技能高超的人；丹青：绘画的颜料，比喻绘画的艺术。指优秀的画家。","source":{"text":"庄濯江寻妙手丹青画了一幅‘登高送别图’，在会诸人，都做了诗。","book":"清·吴敬梓《儒林外史》第46回"},"example":{"text":"他在美术学院拜了几位～为师，干起了画匠职业。","book":"《小说月报》"},"similar":["丹青妙手"],"usage":"作宾语、定语；指技艺高超的画家"},{"id":14583,"word":"妙手偶得","pinyin":"miào shǒu ǒu dé","abbr":"msod","explanation":"技术高超的人，偶然间即可得到。也用来形容文学素养很深的人，出于灵感，即可偶然间得到妙语佳作。","source":{"text":"文章本天成，妙手偶得之。粹然无疵瑕，岂复须人为。","book":"宋·陆游《文章》诗"},"example":{"text":"若不是～，便确是经过锤炼的语言的精华。","book":"茅盾《白杨礼赞》"},"usage":"作宾语、定语；指偶然得到妙语佳作"},{"id":14584,"word":"妙手回春","pinyin":"miào shǒu huí chūn","abbr":"mshc","explanation":"回春：使春天重返，比喻将快死的人救活。指医生医术高明。","source":{"text":"但是药铺门里门外，足足挂着二三十块匾额：什么‘功同良相’，什么‘扁鹊复生’，什么‘妙手回春’……","book":"清·李宝嘉《官场现形记》第二十回"},"example":{"text":"总之我绝不是冲锋陷阵、斩将搴旗的战士，也不是对症下药、～的医生。","book":"巴金《谈〈新生〉》"},"similar":["起死回生"],"opposite":["庸医杀人"],"usage":"作谓语、宾语、定语；指医术高超","story":["春秋时期齐国神医扁鹊经过虢国听说虢太子猝死，就问中庶子太子的症状，认为虢太子只是假死可以救活。就叫弟子子阳磨好针，在太子的穴位上扎了几针，太子就苏醒过来，再经汤药调解，20天后就完全康复，扁鹊赢得妙手回春的称号"]},{"id":14585,"word":"妙手天成","pinyin":"miào shǒu tiān chéng","abbr":"mstc","explanation":"妙手：技艺高超的人；天成：象自然形成一样。指写作技艺高超的人，作品没有雕琢的痕迹。","example":{"text":"还没有一个人像曹禺写出这样一部杰出的多幕剧，在戏剧结构上这样高超，这样～。","book":"田本相《曹禺传》第十二章"}},{"id":14586,"word":"妙手空空","pinyin":"miào shǒu kōng kōng","abbr":"mskk","explanation":"指小偷，也形容手中一无所有。","source":{"text":"后夜当使妙手空空儿继至。空空儿之神术，人莫能窥其用，鬼莫得蹑其踪。","book":"宋·李昉《太平广记》卷一百九十四引裴刑《传奇·聂隐娘》"},"example":{"text":"隔牖窥妆，私语切切；深宵胠箧，～。","book":"清·彭养鸥《黑籍冤魂》第九回"},"similar":["一无所有"],"usage":"作谓语；形容手中一无所有"},{"id":14587,"word":"妙笔生花","pinyin":"miào bǐ shēng huā","abbr":"mbsh","explanation":"生花：长出花朵。比喻杰出的写作才能。","source":{"text":"李太白少梦笔头生花，后天才赡逸，名闻天下。","book":"唐·冯贽《云仙杂记》卷十"},"example":{"text":"她～，顷刻写就一篇好文章。"},"similar":["生花妙笔"],"usage":"作宾语、定语；指人的文笔"},{"id":14588,"word":"妙策如神","pinyin":"miào cè rú shén","abbr":"mcrs","explanation":"妙：神妙。形容计策非常高超。","source":{"text":"智算若神也。","book":"《后汉书·王涣传》：“又能以谲数发擿奸伏，京师称叹，以为涣有神算。”李贤注"},"example":{"text":"陈矫在敌楼上，望见周瑜亲自入城来，暗暗喝采道：“丞相～！","book":"明·罗贯中《三国演义》第五十一回"},"usage":"作谓语、定语；指人的计谋很有用处"},{"id":14589,"word":"妙策神谋","pinyin":"miào cè shén móu","abbr":"mcsm","explanation":"神妙莫测的计策。","source":{"text":"也不索推轮捧毂，筑坛台专仗你那妙策神谋。","book":"元·无名氏《百花亭》第二折"}},{"id":14590,"word":"妙算神机","pinyin":"miào suàn shén jī","abbr":"mssj","explanation":"形容智谋无穷，善于洞察形势，计策得当。","source":{"text":"且看你妙算神机，出人头地。","book":"清·李渔《怜香伴·闻试》"},"example":{"text":"清·李渔《怜香伴·闻试》：“且看你～，出人头地。”"},"similar":["神机妙算"],"usage":"作谓语、宾语、定语；指人的决策等"},{"id":14591,"word":"妙算神谋","pinyin":"miào suàn shén móu","abbr":"mssm","explanation":"妙、神：形容高明；算、谋：指计谋。惊人的机智，巧妙的计谋。形容善于估计复杂的变化的情势，决定策略。","source":{"text":"妙算干戈止，神谋宇宙清。","book":"唐·卢纶《杂曲歌辞·皇帝感词》"}},{"id":14592,"word":"妙绝一时","pinyin":"miào jué yī shí","abbr":"mjys","explanation":"妙：美妙。指佳妙不是同时人所能及的。","source":{"text":"其五言诗之善者，妙绝时人。","book":"三国·魏·曹丕《与吴质书》"},"example":{"text":"笔墨简远，～。","book":"宋·周煇《清波杂志》卷十二"},"similar":["妙绝时人"],"usage":"作谓语、定语；指非常好"},{"id":14593,"word":"妙绝人寰","pinyin":"miào jué rén huán","abbr":"mjrh","explanation":"指作品的精美，不是当时的人所能比。","source":{"text":"其五言诗之善者，妙绝时人。","book":"三国·魏·曹丕《与吴质书》"},"example":{"text":"雨后云成缥缈山，虎儿笔～。","book":"清·盛大士《溪山卧游录》卷二"}},{"id":14594,"word":"妙绝时人","pinyin":"miào jué shí rén","abbr":"mjsr","explanation":"指作品的好，不是当时的人所能比。","source":{"text":"公幹有逸气，但未遒耳，其五言诗之善者，妙绝时人。","book":"三国·魏·曹丕《与吴质书》"},"example":{"text":"玄度五言诗，可谓～。","book":"南朝·宋·刘义庆《世说新语·文学》"},"similar":["妙绝一时"],"usage":"作谓语、定语；指非常好"},{"id":14595,"word":"妙舞清歌","pinyin":"miào wǔ qīng gē","abbr":"mwqg","explanation":"美妙的舞蹈，清越的歌声。","source":{"text":"谁料久参差，愁绪暗萦丝，想应妙舞清歌罢，又还对秋色嗟咨。","book":"宋·秦观《一丛花》"},"example":{"text":"别了浓妆艳裹，拜辞了～。","book":"元·无名氏《嘲风情》"},"similar":["轻歌曼舞"],"usage":"作宾语、定语；用于书面语"},{"id":14596,"word":"妙药灵丹","pinyin":"miào yào líng dān","abbr":"myld","explanation":"妙：指有特殊效力；丹：颗粒状的中药丸；灵丹：灵验。非常灵验能治百病的奇药。比喻能解决一切问题的好办法。","source":{"text":"我卖妙药灵丹无虚假，专治那古怪病症与恶疮。","book":"清·无名氏《刘公案》第21回"},"similar":["灵丹妙药"],"usage":"作主语、宾语；用于书面语"},{"id":14597,"word":"妙言要道","pinyin":"miào yán yào dào","abbr":"myyd","explanation":"妙：神妙，深微；要：重要，中肯。中肯的名言，深微的道理。","source":{"text":"今太子之病，可无药石针刺灸疗而已，可以要言妙道说而去也。","book":"汉·枚乘《七发》"},"example":{"text":"宜听～，以疏神导体。","book":"鲁迅《汉文学史纲要·藩国之文术》"},"similar":["要言妙道"],"usage":"作宾语；指精到的言论，中肯的道理"},{"id":14598,"word":"妙语如珠","pinyin":"miào yǔ rú zhū","abbr":"myrz","explanation":"指诗文中警句妙语很多。","source":{"text":"好语如珠串一一，妄心如膜退重重。","book":"宋·苏轼《次韵答子由》诗"},"example":{"text":"汤沛～，只说了七八句话，却引起三次哄堂大笑。","book":"金庸《飞狐外传》第十七章"}},{"id":14599,"word":"妙语惊人","pinyin":"miào yǔ jīng rén","abbr":"myjr","explanation":"妙语：有深意或动听的语言。绝妙动听的语言令人吃惊。","source":{"text":"扫花坐卧吹，妙语益难忘。","book":"宋·黄庭坚《次韵文潜同游王舍人园诗》"},"example":{"text":"说什么可以不考虑出奇制胜，怎么说却要求～。","book":"老舍《出口成章·话剧的语言》"}},{"id":14600,"word":"妙语解烦","pinyin":"miào yǔ jiě fán","abbr":"myjf","explanation":"有趣的话引人发笑。","source":{"text":"使人笑不能止也。","book":"《汉书·匡衡传》：“匡说《诗》，解人颐。”颜师古注引如淳曰"}},{"id":14601,"word":"妙语解颐","pinyin":"miào yǔ jiě yí","abbr":"myjy","explanation":"解颐：开颜而笑。有趣的话引人发笑。","source":{"text":"使人笑不能止也。","book":"《汉书·匡衡传》：“匡说《诗》，解人颐。”颜师古注引如淳曰"},"example":{"text":"“有莺其羽”四字，～，太太真个聪明，大家各贺一杯。","book":"清·魏秀仁《花月痕》第十二回"},"usage":"作谓语；指有趣的话引人发笑"},{"id":14602,"word":"妙语连珠","pinyin":"miào yǔ lián zhū","abbr":"mylz","explanation":"连珠：串珠。巧妙风趣的话一个接一个。","source":{"text":"他出口成章，妙语连珠，常常使众人大饱耳福。","book":"路遥《平凡的世界》第二卷第54章"},"example":{"text":"他妙语连珠地发言让大家捧腹大笑。"},"similar":["妙语双关"],"opposite":["废话连篇"],"usage":"作谓语、宾语、状语；指人说话风趣"},{"id":14603,"word":"妙趣横生","pinyin":"miào qù héng shēng","abbr":"mqhs","explanation":"横生：层出不穷地表露。洋溢着美妙的意趣（多指语言、文章或美术作品）。","source":{"text":"好些平常的事物，在卓越的作者笔下妙趣横生，他们借助的重要手段之一，就是运用譬喻。","book":"秦牧《艺海拾贝·艺术力量和文笔情趣》"},"example":{"text":"这幅漫画真是～。"},"similar":["妙不可言"],"opposite":["味同嚼蜡"],"usage":"作谓语、定语、补语；指说话及文章"},{"id":14604,"word":"妙龄驰誉","pinyin":"miào líng chí yù","abbr":"mlcy","explanation":"妙龄：美好年龄，指青少年时期；驰誉：驰名。在青少年时期就名声远扬。","source":{"text":"妙龄驰誉百夫雄，晚切忘怀水隐中。","book":"宋·苏轼《苏潜圣挽词》"},"usage":"作谓语、定语；用于夸奖人"},{"id":14605,"word":"妥妥帖帖","pinyin":"tuǒ tuǒ tiē tiē","abbr":"tttt","explanation":"指十分合适或令人满意。","source":{"text":"我都能够照应得他妥妥帖帖，无忧冻馁的了，还有余力，才可以讲究去做外面的好事。","book":"清·吴趼人《二十年目睹之怪现状》第15回"},"example":{"text":"一切公事都办得～，该要回杭州了。","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["妥妥贴贴"],"usage":"作定语、状语；用于口语"},{"id":14606,"word":"妥妥当当","pinyin":"tuǒ tuǒ dàng dàng","abbr":"ttdd","explanation":"稳妥适当。","source":{"text":"内中有袭人，也还是个妥妥当当的孩子。再有个明白人常劝他更好。他又和宝丫头合的来。","book":"清·曹雪芹《红楼梦》第96回"},"example":{"text":"路遥《平凡的世界》第二卷第30章：“他也都热心地为他们办理的～。”"},"similar":["稳稳当当","千妥万当"],"usage":"作定语、状语；用于办事"},{"id":14607,"word":"妥妥贴贴","pinyin":"tuǒ tuǒ tiē tiē","abbr":"tttt","explanation":"指十分合适或令人满意。","source":{"text":"子固也把孙三儿一面安排得妥妥贴贴，所有彩云的东西一概要回，不少一件。","book":"曾朴《孽海花》第32回"},"example":{"text":"他经验丰富，熟人又多，大部分事情很快就被处理得～。","book":"路遥《平凡的世界》第六卷第29章"},"similar":["妥妥帖帖"],"usage":"作定语、状语；用于口语"},{"id":14608,"word":"妥首帖耳","pinyin":"tuǒ shǒu tiē ěr","abbr":"tste","explanation":"犹言俯首帖耳。形容非常驯服恭顺。"},{"id":14609,"word":"妨功害能","pinyin":"fáng gōng hài néng","abbr":"fghn","explanation":"压抑陷害有功有能的人。","source":{"text":"而防功害能之臣尽为万户侯。","book":"汉·李陵《答苏武书》"},"example":{"text":"～，殄民败国，综其暴戾，磬竹难书。","book":"蔡东藩、许廑父《民国通俗演义》第六十二回"},"similar":["妒贤害能"],"opposite":["求贤若渴","爱才如命"],"usage":"作定语；指妒忌伤害能人"},{"id":14610,"word":"妻儿老小","pinyin":"qī ér lǎo xiǎo","abbr":"qelx","explanation":"指父、母、妻、子等全家人。","source":{"text":"你一向远出，可速与妻儿老小相聚。","book":"明·梁辰鱼《浣纱记·见王》"},"example":{"text":"谁都有～的。"},"similar":["妻儿老少"],"usage":"作主语、宾语、定语；用在表示家族负担"},{"id":14611,"word":"妻儿老少","pinyin":"qī ér lǎo shǎo","abbr":"qels","explanation":"指父、母、妻、子等全体家属。同“妻儿老小”。","source":{"text":"引了妻儿老少，和刘青等心腹三十余人，径投望江县天荒湖来。","book":"明·冯梦龙《古今小说·汪信之一死救全家》"},"similar":["妻儿老小"],"usage":"作主语、宾语、定语；用于家庭"},{"id":14612,"word":"妻梅子鹤","pinyin":"qī méi zǐ hè","abbr":"qmzh","explanation":"以梅为妻，以鹤为子，表示清高或隐居。","source":{"text":"林处士妻梅子鹤，可称千古高风矣。","book":"清·徐釚《词苑丛谈》卷三"},"similar":["梅妻鹤子"],"usage":"作宾语、定语；指隐士的生活"},{"id":14613,"word":"妻离子散","pinyin":"qī lí zǐ sàn","abbr":"qlzs","explanation":"一家子被迫分离四散。","source":{"text":"父母冻饿，兄弟妻子离散，","book":"《孟子·梁惠王上》"},"example":{"text":"无辜人民之死伤成千累万，～啼饥号寒者到处皆是。","book":"毛泽东《评国民党对战争责任问题的几种答案》"},"similar":["家破人亡","离乡背井"],"opposite":["破镜重圆","欢聚一堂"],"usage":"作谓语、宾语、定语；指家破"},{"id":14614,"word":"妻荣夫贵","pinyin":"qī róng fū guì","abbr":"qrfg","explanation":"荣：荣耀。贵：显贵。指因妻子的显赫地位夫婿也能得到好处。参见“夫贵妻荣”。","source":{"text":"你与俺崔相国做女婿，妻荣夫贵，但得一个并头莲，煞强如状元及第。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"夫妇俱以功名终身，好算是～，全唐无比了。","book":"蔡东藩《唐史演义》第十五回"}},{"id":14615,"word":"妻贤夫祸少","pinyin":"qī xián fū huò shǎo","abbr":"qxfhs","explanation":"祸：灾难。妻子贤惠丈夫在外灾祸就少。","source":{"text":"自古说‘妻贤夫祸少’，‘表壮不如里壮’，你但凡是个好的，他们怎敢闹出口？","book":"清·曹雪芹《红楼梦》第68回"},"example":{"text":"～，他因妻子犯事而坐牢。"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":14616,"word":"妾妇之道","pinyin":"qiè fù zhī dào","abbr":"qfzd","explanation":"妾妇：指妇女。指对上司或同僚绝对服从的卑劣作风。","source":{"text":"以顺为正者，妾妇之道也。","book":"战国·邹·孟轲《孟子·滕文公下》"},"example":{"text":"这样的一片～，汉以后有不少的太平宰相正靠着这种方术的实践而博得了安富尊荣。","book":"郭沫若《荀子的批判》"},"usage":"作主语、宾语；指服从的卑劣作风"},{"id":14617,"word":"始乱终弃","pinyin":"shǐ luàn zhōng qì","abbr":"slzq","explanation":"乱：淫乱，玩弄。先乱搞，后遗弃。指玩弄女性的恶劣行径。","source":{"text":"始乱之，终弃之，固其宜矣。","book":"唐·元稹《莺莺传》"},"example":{"text":"～，君子所恶，为人言之，不为尔曹言之也。","book":"清·纪昀《阅微草堂笔记·槐西杂志二》"},"opposite":["坚贞不渝"],"usage":"作谓语、定语；指玩弄女性的恶劣行径"},{"id":14618,"word":"始作俑者","pinyin":"shǐ zuò yǒng zhě","abbr":"szyz","explanation":"俑：古代殉葬用的木制或陶制的俑人。开始制作俑的人。比喻首先做某件坏事的人。","source":{"text":"仲尼曰：‘始作俑者，其无后乎。’为其象人而用之也。","book":"《孟子·梁惠王上》"},"example":{"text":"北镇抚司狱廷杖立枷诸制，此秦法所未有，～，罪可胜道哉！","book":"清·张潮《虞初新志·姜贞毅先生传》"},"similar":["罪魁祸首"],"usage":"作宾语；比喻首先做坏事的人","story":["战国时期，孟子对梁惠王说：“你厨房内有肥肉，马厩里有壮马，老百姓却面有饥色，等着饿死，这等于率兽食人，这怎么能做好父母官呢？孔子说过：‘始作俑者，其无后乎！’用像人形的俑来殉葬都不可以，怎么能让活生生的人饿死呢？”"]},{"id":14619,"word":"始如处女，后如脱兔","pinyin":"shǐ rú chǔ nǚ，hòu rú tuō tù","abbr":"srcnhrtt","explanation":"处女：未嫁的女子；脱兔：逃跑的兔子。指军队未行动时象未出嫁的姑娘那样持重；一行动就象飞跑的兔子那样敏捷。","source":{"text":"是故始如处女，敌人开户；后如脱兔，敌不及拒。","book":"《孙子·九地》"}},{"id":14620,"word":"始愿不及此","pinyin":"shǐ yuàn bù jí cǐ","abbr":"sybjc","explanation":"始愿：当初的愿望。指事势的变化发展，并非起初所料想到的。","source":{"text":"孤始愿不及此。虽及此，岂非天乎！","book":"《左传·成公十八年》"},"example":{"text":"这两个老儿也叫作‘～，今及此岂非天乎’了。","book":"清·文康《儿女英雄传》第二十九回"}},{"id":14621,"word":"始料不及","pinyin":"shǐ liào bù jí","abbr":"slbj","explanation":"料：料想，估计。当初没有估计到的。","similar":["意料之外"],"opposite":["不出所料","始料所及"]},{"id":14622,"word":"始料所及","pinyin":"shǐ liào suǒ jí","abbr":"slsj","explanation":"料：料想，估计；及：到。当初已经料想到的。","source":{"text":"人事的变化，往往非始料所及。","book":"《中国的西北角·成兰纪行一》"},"similar":["意料之中"],"opposite":["意想不到"],"usage":"作谓语；用于否定句"},{"id":14623,"word":"始末原由","pinyin":"shǐ mò yuán yóu","abbr":"smyy","explanation":"始末：事情从头到尾的经过。原由：缘由；来由。事情的经过和原因。同“始末缘由”。","source":{"text":"直到午后，史湘云才来，宝玉方放了心，见面时就把始末原由告诉他，又要与他诗看。","book":"清·曹雪芹《红楼梦》第三十七回"},"example":{"text":"智化到了此时，不肯隐瞒，便将～据实说出。","book":"清·石玉昆《三侠五义》第一百十七回"},"similar":["始末缘由"],"usage":"作宾语、定语；多用于事情等"},{"id":14624,"word":"始末根由","pinyin":"shǐ mò gēn yóu","abbr":"smgy","explanation":"指事情开始到结尾的经过和缘由。","source":{"text":"公子遂将初遇杜十娘，如何相好，后来如何要嫁，如何借银讨他，始末根由，备细述了一遍。","book":"明·冯梦龙《警世通言》卷三十二"},"example":{"text":"张金凤这才得明白这姑娘的～，就连安公子也是此时才如梦方醒。","book":"清·文康《儿女英雄传》第八回"}},{"id":14625,"word":"始末缘由","pinyin":"shǐ mò yuán yóu","abbr":"smyy","explanation":"始末：事情从头到尾的经过。缘由：缘故由来。事情的经过和原因。亦作“始末原由”。","source":{"text":"你将始末缘由，细细说来，不可欺隐。","book":"元·马致远《青衫泪》第四折"},"example":{"text":"这媳妇哪里敢隐瞒，只得将～从直说出。","book":"清·陈朗《雪月梅》第九回"},"similar":["始末原由"],"usage":"作宾语、定语；多用于事情等"},{"id":14626,"word":"始终一贯","pinyin":"shǐ zhōng yī guàn","abbr":"szyg","explanation":"自始至终都一样。","source":{"text":"中国不但应当和中国人民的始终一贯的良友苏联相联合，而且应当按照可能，……","book":"毛泽东《中国共产党在抗日时期的任务》"},"similar":["始终如一"],"usage":"作定语、状语；用于做事等"},{"id":14627,"word":"始终不懈","pinyin":"shǐ zhōng bù xiè","abbr":"szbx","explanation":"自始自终一直不松懈。","source":{"text":"同时，我们必须尖锐地指出：'骄傲自满就是勤学苦练、始终不懈的死敌。'","book":"《青年作家应有的修养》"},"example":{"text":"《青年作家应有的修养》：“同时，我们必须尖锐地指出：‘骄傲自满就是勤学苦练、～的死敌。’”"},"similar":["始终如一","持之以恒"],"opposite":["一暴十寒","虎头蛇尾"],"usage":"作谓语、定语、状语；指持之以恒"},{"id":14628,"word":"始终不易","pinyin":"shǐ zhōng bù yì","abbr":"szby","explanation":"易：改变，违背。自始自终一直不变。指守信用。","source":{"text":"臣自惟言辞不如伍被远矣，然始终不易，窃谓过之。","book":"《周书·苏湛传》"},"similar":["始终若一","始终不渝","终始不渝"],"usage":"作谓语、定语、状语；指守信用"},{"id":14629,"word":"始终不渝","pinyin":"shǐ zhōng bù yú","abbr":"szby","explanation":"渝：改变，违背。自始自终一直不变。指守信用。","source":{"text":"安虽受朝寄，然东山之志始末不渝，每形于言色。","book":"《晋书·谢安传》"},"example":{"text":"区区之心，唯以地方秩序为主，以人民生命财产为重，～，天人共鉴。","book":"蔡东藩、许廑父《民国通俗演义》第二十九回"},"similar":["一如既往"],"opposite":["翻云覆雨","见异思迁"],"usage":"作谓语、定语、状语；指守信用","story":["东晋孝武帝时，朝廷处于内忧外患之中，谢安声名远扬，但不愿为官，受扬州刺史庾冰的热情邀请，才勉强为官，在淝水大败前秦军，胜利后他辞官退隐到会稽东山，后来被迫出来做官，但他退隐东山的志向始终不渝，总想保持高洁德行"]},{"id":14630,"word":"始终如一","pinyin":"shǐ zhōng rú yī","abbr":"szry","explanation":"始：开始；终：结束。自始自终一个样子。指能坚持，不间断。","source":{"text":"虑必先事而申之以敬，慎终如始，终始如一，夫是之谓大吉。","book":"《荀子·议兵》"},"example":{"text":"吾观关胜义气凛然，～，军师不必多疑。","book":"明·施耐庵《水浒全传》第六十七回"},"similar":["一如既往","始终不渝"],"opposite":["出尔反尔","反复无常"],"usage":"作谓语、定语；指自始自终一个样子","story":["战国末期，哲学家荀况在楚国做兰陵令时，与楚国将领临武召在赵孝成王面前议论用兵的要领，将领要做到“五权”与“三至”，采取军事行动前要考虑慎之又慎，这种周密的态度一定要始终如一才能取得军事上的胜利"]},{"id":14631,"word":"始终若一","pinyin":"shǐ zhōng ruò yī","abbr":"szry","explanation":"自始自终一个样子。指能坚持，不间断。同“始终如一”。","source":{"text":"［太和二十二年正月］辛末，诏以穰人首归大顺始终若一者，给复三十年。","book":"《北史·魏纪三·孝文帝》"},"similar":["始终如一","终始如一"],"opposite":["变幻莫测","反复无常"],"usage":"作谓语、定语；指自始自终一个样子"},{"id":14632,"word":"姑妄听之","pinyin":"gū wàng tīng zhī","abbr":"gwtz","explanation":"姑：暂且；妄：随便，胡乱。姑且随便听听，不一定就相信。","source":{"text":"《庄子·齐物论》“予尝为女妄言之，女亦以妄听之奚。”"},"example":{"text":"即使是饭后的公评，酒后的宏议，也何尝不可～呢？","book":"鲁迅《华盖集续编·送灶日漫笔》"},"similar":["妄言妄听"],"opposite":["姑妄言之"],"usage":"作谓语、宾语、定语；指姑且随便听听"},{"id":14633,"word":"姑妄言之","pinyin":"gū wàng yán zhī","abbr":"gwyz","explanation":"姑且随便说说，不一定有什么道理。","source":{"text":"予尝为女（汝）妄言之，女（汝）亦以妄听之奚。","book":"《庄子·齐物论》"},"example":{"text":"这不过～罢了，哪一个能办这件事？","book":"《九命奇冤》第二十九回"},"similar":["随便说说"],"opposite":["姑妄听之"],"usage":"作谓语、定语；与“姑妄听之”连用","story":["宋代文学家苏轼早年在杭州做官，因写诗讽刺朝政，得罪了皇帝，被贬到黄州。晚年又再次被贬到海南儋州。苏轼到儋州后，因偏远荒凉，常读书写作，邀请朋友“姑妄言之”讲笑话，晚年写笑话集《艾子》"]},{"id":14634,"word":"姑射神人","pinyin":"gū yè shén rén","abbr":"gysr","explanation":"姑射：山名；神人：得道的人。原指姑叶山的得到真人。后泛指美貌女子。","source":{"text":"藐姑射之山，有神人居焉，肌肤若冰雪，淖（绰）约若处子。","book":"《庄子·逍遥游》"},"example":{"text":"广寒仙子月中出，～雪里来。","book":"明·冯梦龙《警世通言》卷三十五"},"usage":"作宾语；指美貌女子"},{"id":14635,"word":"姑息养奸","pinyin":"gū xī yǎng jiān","abbr":"gxyj","explanation":"姑息：为求苟安，无原则地宽容；养：助长；奸：坏人坏事。无原则地宽容，只会助长坏人作恶。","source":{"text":"细人之爱人也以姑息。","book":"《礼记·檀弓上》"},"example":{"text":"为有勾结匪类，荡轶范围情事，尤为法律所不容，切勿～，致贻隐患。","book":"蔡东藩、许廑父《民国通俗演义》第三十三回"},"similar":["养虎遗患"],"opposite":["斩草除根"],"usage":"作谓语、宾语、定语；指助人为恶","story":["从前永州一个属鼠的人特别喜欢老鼠，不准家人及手下人捕捉老鼠，任其在家胡作非为，咬烂粮仓和衣服，还经常给老鼠投放食物，附近的老鼠成群结队地跑到他家，一时造成鼠满为患，旁边邻居对他这种姑息养奸的行为深恶痛绝"]},{"id":14636,"word":"姑置勿论","pinyin":"gū zhì wù lùn","abbr":"gzwl","explanation":"姑：姑且；置：放在一边。姑且放在一边不去谈论。","source":{"text":"九原不可作，欧、苏姑置勿论；如世所谓六君子者，公将何愧。","book":"宋·陈亮《题喻季直文编》"},"example":{"text":"夫留都自府部科道而下，庸流冗员，～。","book":"明·归有光《上总制书》"}},{"id":14637,"word":"姑置勿问","pinyin":"gū zhì wù wèn","abbr":"gzww","explanation":"权且放过，不去追究责问。指对有过错的人暂时给予宽容。","source":{"text":"吾闻其新娶，若责之，舅姑必以新妇不利，口舌之余，不测系焉。姑置勿问，后或再犯，重加惩治可也。","book":"明·陶宗仪《南村辍耕录》卷十二"}},{"id":14638,"word":"姓甚名谁","pinyin":"xìng shèn míng shuí","abbr":"xsms","explanation":"询问打听人的姓名。","source":{"text":"你既是问老儿买的，那老儿姓甚名谁，那里人氏？","book":"明·冯梦龙《醒世恒言》第26卷"},"example":{"text":"请问你的同学～。"},"similar":["尊姓大名"],"usage":"作谓语；用于疑问句"},{"id":14639,"word":"委决不下","pinyin":"wěi jué bù xià","abbr":"wjbx","explanation":"一再犹豫，不能决定下来。","source":{"text":"心中委决不下。其妻长舌夫人王氏适至，问道：‘相公有何事迟疑？’","book":"明·冯梦龙《喻世明言》第32卷"},"example":{"text":"时至今日，他还～。"},"similar":["犹豫不决"],"usage":"作谓语；指犹豫不决"},{"id":14640,"word":"委国听令","pinyin":"wěi guó tīng lìng","abbr":"wgtl","explanation":"把国家政权交给别人，一切听从别人的命令。","source":{"text":"韩王入朝，魏委国听令。","book":"《史记·秦本纪》"},"example":{"text":"魏王惧，遣使谢罪，亦使太子增为质于秦，～，自此六国，俱宾服于秦。","book":"明·冯梦龙《东周列国志》第一百一回"}},{"id":14641,"word":"委委佗佗","pinyin":"wēi wēi tuó tuó","abbr":"wwtt","explanation":"雍容自得的样子。","source":{"text":"命也奈何，芝生岩阿；既采且歌，委委佗佗。","book":"《诗·墉风·君子偕老》：“委委佗佗，如山如河，象服是宜。”毛传：“委委者，行可委曲踪迹也；佗佗者，德平易也。”朱熹集传：“雍容自得之貌。”明·宋濂《梅府君墓志铭》"},"example":{"text":"～，开颜舒眉。","book":"清·钱谦益《御史族兄汝瞻画像赞》"},"similar":["弯弯曲曲"],"usage":"作定语；用于书面语"},{"id":14642,"word":"委委屈屈","pinyin":"wěi wěi qū qū","abbr":"wwqq","explanation":"受到不公平的待遇，心里十分难过。","source":{"text":"那日已是迎娶吉期，袭人本不是那一种泼辣人，委委屈屈的上轿而去，心里另想到那里再作打算。","book":"清·曹雪芹《红楼梦》第120回"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“芙蓉用～的声音说，‘一见面就说：……’”"},"similar":["委委曲曲"],"usage":"作定语、状语；用于人的心情"},{"id":14643,"word":"委委曲曲","pinyin":"wěi wěi qū qū","abbr":"wwqq","explanation":"指曲调、道路、河流等曲折或人处事屈身折节。","source":{"text":"海北一带，委委曲曲凿了一道长渠，引接外边为活水。","book":"清·褚人获《隋唐演义》第27回"},"usage":"作定语、状语；用于人或事物等"},{"id":14644,"word":"委弃泥涂","pinyin":"wěi qì ní tú","abbr":"wqnt","explanation":"委弃：抛弃；泥涂：泥泞的道路。被抛弃在泥泞的道路上。形容人不受重视，被弃置不用。","source":{"text":"比者不将，委弃泥涂，老死草野。","book":"唐·韩愈《与汝州卢郎中论荐侯喜状》"}},{"id":14645,"word":"委曲从俗","pinyin":"wěi qǔ cóng sú","abbr":"wqcs","explanation":"指曲意迁就，随从世俗。","source":{"text":"凡通经术，固当修行先王之道，何可委曲从俗，苟求富贵乎！","book":"《汉书·儒林传·严彭祖》"}},{"id":14646,"word":"委曲从顺","pinyin":"wěi qǔ cóng shùn","abbr":"wqcs","explanation":"指曲意迁就，随从世俗。","source":{"text":"意岂将军忘湛渐之义，委曲从顺，所执不强，不广用士，尚有好恶之忌，荡荡之德未纯，方与将相大臣乖离之萌也？","book":"《汉书·谷永传》"}},{"id":14647,"word":"委曲周全","pinyin":"wěi qǔ zhōu quán","abbr":"wqzq","explanation":"指使自己受委曲，以求得保全。","source":{"text":"我只要委曲周全你家主一桩大事，并无欺心。","book":"明·冯梦龙《醒世恒言》卷七"},"example":{"text":"吾闻君父有过，为臣子者，必～谏诤之，终引其君父於当道。","book":"明·许仲琳《封神演义》第九十四回"},"similar":["委曲成全"],"usage":"作谓语、定语；用于处事"},{"id":14648,"word":"委曲成全","pinyin":"wěi qǔ chéng quán","abbr":"wqcq","explanation":"指使自己受委屈，来成全别人。亦作“委曲周全”。","source":{"text":"夫自用则不能容物，无用又不能理物，其得尔三载于滇中者，皆我公委曲成全之泽也。","book":"明·李贽《续焚书·答骆副使》"},"similar":["委曲周全"],"usage":"作谓语、定语；用于处事"},{"id":14649,"word":"委曲求全","pinyin":"wěi qǔ qiú quán","abbr":"wqqq","explanation":"委曲：曲意迁就。勉强迁就，以求保全。也指为了顾全大局而让步。","source":{"text":"何可委曲从俗，苟求富贵乎！","book":"《汉书·严彭祖传》"},"example":{"text":"～的苟活决不是真正的生。","book":"郭沫若《战声》诗"},"similar":["低声下气","逆来顺受"],"opposite":["不卑不亢","针锋相对"],"usage":"作谓语、宾语、状语；指顾全大局"},{"id":14650,"word":"委曲详尽","pinyin":"wěi qǔ xiáng jìn","abbr":"wqxj","explanation":"指对事情的开始经过和结尾了解得十分详细而周密。","source":{"text":"母子之间，委曲详尽，有人所难言者，不可缕载也。","book":"宋·杨时《曾昭文公行述》"},"example":{"text":"钱子刚因说起陶、李交好情形，～，葛仲英亦为之感叹。","book":"清·韩邦庆《海上花列传》第三十六回"}},{"id":14651,"word":"委罪于人","pinyin":"wěi zuì yú rén","abbr":"wzyr","explanation":"委：推委。把罪责推卸给别人。","source":{"text":"帝怒曰：‘司马欲委罪于孤耶？’遂引出斩之。","book":"《晋书·王裒传》"}},{"id":14652,"word":"委肉当饿虎之蹊","pinyin":"wěi ròu dāng è hǔ zhī xī","abbr":"wrdehzq","explanation":"委：抛弃；蹊：小路。把肉丢在饿虎经过的路上。比喻处境危险，灾祸即将到来。","source":{"text":"是谓委肉当饿虎之蹊也，祸必不振矣。","book":"《史记·刺客列传》"}},{"id":14653,"word":"委肉虎蹊","pinyin":"wěi ròu hǔ xī","abbr":"wrhx","explanation":"委：抛弃；蹊：小路。把肉丢在饿虎经过的路上。比喻处境危险，灾祸即将到来。","source":{"text":"是以委肉当饿虎之蹊，祸必不振矣。","book":"《战国策·燕策三》"},"usage":"作宾语、定语；指处境危险"},{"id":14654,"word":"委诚求当","pinyin":"wěi chéng qiú dāng","abbr":"wcqd","explanation":"指推诚相待，虚心求教。","source":{"text":"自是委诚求当，不复妄言辞教，郡内称治。","book":"《后汉书·王堂传》"}},{"id":14655,"word":"委过于人","pinyin":"wěi guò yú rén","abbr":"wgyr","explanation":"形容嫁祸给别人。","example":{"text":"自己闯下的祸端应当自己承担，不可～，让别人蒙受不白之冤。"}},{"id":14656,"word":"委重投艰","pinyin":"wěi zhòng tóu jiān","abbr":"wztj","explanation":"委：委托、托付。指委以重任，授予艰难使命。","source":{"text":"则今兹爰立之命，乃所以委重投艰而已，又何辞乎？","book":"宋·周密《齐东野语·表答用先世语》"},"similar":["遗大投艰"],"usage":"作谓语、定语、宾语；用于处事"},{"id":14657,"word":"委随不断","pinyin":"wěi suí bù duàn","abbr":"wsbd","explanation":"委随：柔弱。软弱无力，不善于决断。","source":{"text":"嶷性儒缓，委随不断，终日在坐，昏睡而已。","book":"《魏书·王宪传》"}},{"id":14658,"word":"委靡不振","pinyin":"wěi mǐ bù zhèn","abbr":"wmbz","explanation":"委靡：也作“萎靡”，颓丧。形容精神不振，意志消沉","source":{"text":"若示以怯懦之形，委靡不振，则事去矣。","book":"《宋史·杨时传》"},"example":{"text":"曲波《林海雪原》：“无精打采地喘了一口粗气，然后象个病人一样～地站在那里。”"},"similar":["萎靡不振"],"opposite":["精神抖擞"],"usage":"作谓语、定语、状语；指意志消沉","story":["公元1125年，金军大举南下进攻北宋，燕京守将郭药师投敌，黄河守将梁方平脱逃，直逼北宋都城东京，宋徽宗将帝位传给儿子宋钦宗赵桓，自己逃到镇江。大臣杨时上书说：“大敌当前必须振奋精神抗击金人入侵，如果萎靡不振就只有灭亡。”"]},{"id":14659,"word":"姗姗来迟","pinyin":"shān shān lái chí","abbr":"sslc","explanation":"姗姗：形容走得缓慢从容。慢腾腾地来晚了。","source":{"text":"立而望之，偏何姗姗其来迟。","book":"《汉书·孝武李夫人传》"},"example":{"text":"什么事竟使你～。","book":"姚雪垠《李自成》第二卷第十八章"},"similar":["缓不济急","蜗行牛步"],"opposite":["争先恐后"],"usage":"作谓语、宾语；表示迟到的意思","story":["汉武帝刘彻十分宠爱歌妓出身的李夫人，她能歌善舞，李夫人后来生病去世。汉武帝非常悲痛，厚葬了李夫人。汉武帝十分思念她，就叫方士少翁为李夫人招魂，在帷帐观看到李夫人的身影，就作诗一首说：“我在焦急盼望，你却姗姗来迟”"]},{"id":14660,"word":"姚黄魏品","pinyin":"yáo huáng wèi pǐn","abbr":"yhwp","explanation":"原指宋代洛阳两种名贵的牡丹品种。后泛指名贵的花卉。同“姚黄魏紫”。","source":{"text":"姚黄魏品若尽有，春色定应天下空。","book":"宋·梅尧臣《次答公度》"},"similar":["姚黄魏紫"],"usage":"作主语、宾语；泛指名贵的花卉"},{"id":14661,"word":"姚黄魏紫","pinyin":"yáo huáng wèi zǐ","abbr":"yhwz","explanation":"姚黄：千叶黄花牡丹，出于姚氏民家；魏紫：千叶肉红牡丹，出于魏仁溥家。原指宋代洛阳两种名贵的牡丹品种。后泛指名贵的花卉。","source":{"text":"姚黄魏紫开次第，不觉成恨俱零凋。","book":"宋·欧阳修《绿竹堂独饮》诗"},"example":{"text":"～已称妍，高格还应上降仙。","book":"清·赵翼《檀桥席上赋红牡丹》"},"similar":["姚黄魏品"],"usage":"作主语、宾语；泛指名贵的花卉"},{"id":14662,"word":"姜太公钓鱼，愿者上钩","pinyin":"jiāng tài gōng diào yú，yuàn zhě shàng gōu","abbr":"jtgdyyzsg","explanation":"比喻心甘情愿地上当。","source":{"text":"我是姜太公钓鱼，愿者上钩。贾老爷若是爱厚我，我就不留他，他也不走；若是不爱厚我，我就再留他些，他也不在这里。","book":"清·邗上蒙人《风月梦》第十回"},"example":{"text":"据传说他［姜太公］心肠好人公正，鱼若从水中跳出三尺吞他的饵，那是鱼自己的过错。普通说‘～’便是此意。","book":"林语堂《苏东坡传》第六章"},"similar":["心甘情愿"],"usage":"作宾语、分句；比喻心甘情愿地上当","story":["商纣王残暴统治，百姓十分痛苦。姜尚退隐在渭河边，经常河边钓鱼，他钓鱼的方式很特别，钓杆很短，钓线只有三尺长，钓钩是直的，而且不放鱼饵，人们讥笑他，他说“愿者上钩”。后来姬昌前来请他出山辅佐他推翻商纣王的残暴统治"]},{"id":14663,"word":"姜桂之性","pinyin":"jiāng guì zhī xìng","abbr":"jgzx","explanation":"生姜和肉桂愈久愈辣。比喻年纪越大性格越耿直。","source":{"text":"况吾姜桂之性，到老愈辣。","book":"《宋史·晏敦复传》"},"example":{"text":"曾于桂花楼中张宴，诸味尽为花气所夺，惟姜酱不就味。～，老而愈辣，以喻忠节之气，洵不虚也。","book":"清·沈复《浮生六记》卷四"},"similar":["姜桂之性，到老愈辣"],"usage":"作主语、宾语；指人的性格"},{"id":14664,"word":"姜桂之性，到老愈辣","pinyin":"jiāng guì zhī xìng，dào lǎo yù là","abbr":"jgzxdlyl","explanation":"姜：生姜；桂：肉桂。生姜和肉桂愈久愈辣。比喻年纪越大性格越耿直。","source":{"text":"况吾姜桂之性，到老愈辣。","book":"宋·李昴英《水调歌头·寿参政徐意一》：“松柏苍然长健，姜桂老来愈辣，劲气九秋天。”《宋史·晏敦复传》"},"usage":"作定语、宾语；指人的性格"},{"id":14665,"word":"姜桂余辛","pinyin":"jiāng guì yú xīn","abbr":"jgyx","explanation":"姜：生姜；桂：肉桂；辛：辛辣。生姜和肉桂长成时的辣味。比喻人越老越刚强。","source":{"text":"况吾姜桂之性，到老愈辣。","book":"《宋史·晏敦复传》"}},{"id":14666,"word":"姱容修态","pinyin":"kuā róng xiū tài","abbr":"krxt","explanation":"姱：美好；修：长远；态：志向。美丽的容貌，长远的智慧。","source":{"text":"姱容修态，絙洞房些。","book":"战国·楚·宋玉《招魂》"},"example":{"text":"昔埃及女王克里倭巴士拉生于汉地节元年，为前王多禄某女，～，冠绝古今。","book":"严复、夏曾佑《国闻报馆附印说部缘起》"},"usage":"作谓语、定语；用于女性"},{"id":14667,"word":"姹紫嫣红","pinyin":"chà zǐ yān hóng","abbr":"czyh","explanation":"姹、嫣：娇艳。形容各种花朵娇艳美丽。","source":{"text":"原来姹紫嫣红开遍，似这般都付与断井颓垣。","book":"明·汤显祖《牡丹亭·惊梦》"},"example":{"text":"见垂柳拖丝，拂境清幽；～，迎风弄鸟，别有一种赏心之境。","book":"清·禇人获《隋唐演义》六十九回"},"similar":["百花齐放","万紫千红"],"opposite":["残花败柳"],"usage":"作谓语、定语；形容鲜花的美丽"},{"id":14668,"word":"姿意妄为","pinyin":"zī yì wàng wéi","abbr":"zyww","explanation":"任意胡作非为，常指极端地固执己见和偏爱自己的习惯，常含有一种几乎难以抑制的反复无常的意味。","source":{"text":"察其原因，不外有少数顽固分子，不顾民族国家利益，姿意妄为。","book":"毛泽东《陕甘宁边区政府、第八路军后方留守处布告》"}},{"id":14669,"word":"威仪不类","pinyin":"wēi yí bù lèi","abbr":"wybl","explanation":"威仪：礼仪细节；类：善。礼仪细节不能尽善尽美。","source":{"text":"不吊不祥，威仪不类。","book":"《诗经·大雅·瞻卬》"},"example":{"text":"皇帝在丧，无人子之心，～人君，今废为弘农王，立陈留王协为帝。","book":"《资治通鉴·汉纪·孝皇帝中平六年》"}},{"id":14670,"word":"威仪不肃","pinyin":"wēi yí bù sù","abbr":"wybs","explanation":"威仪：严肃的容貌和庄重的举止；肃：恭敬，严肃。容貌和举止不庄重严肃。","source":{"text":"优游风议，性简傲跌宕，在先主坐席，犹箕踞倾倚，威仪不肃，自纵适；诸葛亮已下则独擅一榻，项枕卧语，无所为屈。","book":"《三国志·蜀志·简雍传》"},"example":{"text":"是时后主怠于国政，耽荒酒色，～，驰骋无度，大发徭役，盛修宫室，后二岁而亡。","book":"《隋书·五行志上》"}},{"id":14671,"word":"威仪孔时","pinyin":"wēi yí kǒng shí","abbr":"wyks","explanation":"孔：甚，很。仪容严肃，举目庄重，甚合时宜。","source":{"text":"威仪孔时，君子的孝子。","book":"《诗经·大雅·既醉》"},"usage":"作宾语、定语；用于书面语"},{"id":14672,"word":"威信扫地","pinyin":"wēi xìn sǎo dì","abbr":"wxsd","explanation":"威信：威望和信誉。威望、信誉全部丧失。比喻威望和信誉完全丧失。","source":{"text":"而且就是他，使得法纪荡然，使得政府的威信扫地，他到底有什么收获？","book":"郭沫若《南京印象》"},"example":{"text":"他现在彻底～了。"},"similar":["名誉扫地"],"usage":"作谓语、宾语；指没有威望和信誉"},{"id":14673,"word":"威凤一羽","pinyin":"wēi fèng yī yǔ","abbr":"wfyy","explanation":"指略见善政一斑之意。","source":{"text":"及弘道下邑，未申善政，而能使民结去思，野多驯雉，此亦威凤一羽，足以验其五德。","book":"《梁书·刘遵传》"},"similar":["威凤片羽"],"usage":"作宾语、定语；指以小见大"},{"id":14674,"word":"威凤片羽","pinyin":"wēi fèng piàn yǔ","abbr":"wfpy","explanation":"由一根凤羽而显示其全貌。比喻卓越的人才所表现出来的某一方面或珍贵难得的事物的零星片断。","source":{"text":"泛然酬应之作，犹是七子遗响，集未必存，威凤片羽，亦不可轻弃也。","book":"清·平步青《霞外捃屑·诗话·费鹿峰诗笺》"},"similar":["威凤一羽"],"usage":"作宾语、定语；指以小见大"},{"id":14675,"word":"威凤祥麟","pinyin":"wēi fèng xiáng lín","abbr":"wfxl","explanation":"麒麟和凤凰，古代传说是吉祥的象征，只有在太平盛世才能见到。后比喻非常难得的人才。","source":{"text":"九年，岚州献祥麟。","book":"《宋书·符瑞志中》：“元康四年，南郡获威风。”《宋史·乐志一》"},"similar":["祥麟威凤","祥麟瑞凤"],"usage":"作宾语、定语；指难得的人才"},{"id":14676,"word":"威刑不肃","pinyin":"wēi xíng bù sù","abbr":"wxbs","explanation":"威：权威；刑：刑律；肃：整肃。权威和法纪都不能整肃。","source":{"text":"刘璋暗弱，自焉已来有累世之恩，文法羁縻，互相承奉，德政不举，威刑不肃。","book":"《三国志·蜀志·诸葛亮传》裴松之注引《蜀记》"},"example":{"text":"今刘璋暗弱，德政不举，～；君臣之道，渐以陵替。","book":"明·罗贯中《三国演义》第六十五回"}},{"id":14677,"word":"威刑肃物","pinyin":"wēi xíng sù wù","abbr":"wxsw","explanation":"以严刑使人恭顺。","source":{"text":"桓公在荆州，全欲以德被江汉，耻以威刑肃物。","book":"南朝·宋·刘义庆《世说新语·政事》"},"usage":"作宾语、定语；用于书面语"},{"id":14678,"word":"威动海内","pinyin":"wēi dòng hǎi nèi","abbr":"wdhn","explanation":"威：威力；动：震动；海内：四海之内，指天下。威力震动天下。形容威力很大。","source":{"text":"威动海内，强殆中国。","book":"《荀子·强国》"},"example":{"text":"大王起于细微，灭乱秦，～。","book":"《汉书·高帝纪》"}},{"id":14679,"word":"威尊命贱","pinyin":"wēi zūn mìng jiàn","abbr":"wzmj","explanation":"威：威力。法令尊严、生命贱微，指军令如山倒，宁可牺牲生命，不得抗令。","source":{"text":"法重心骇，威尊命贱。","book":"唐·李华《吊古战场》"},"usage":"作宾语、定语；用于军事"},{"id":14680,"word":"威德相济","pinyin":"wēi dé xiāng jì","abbr":"wdxj","explanation":"威：威力；德：恩惠；相济：相辅相成。威力和恩德交互施用，相辅相成。","source":{"text":"干闻用武则先威，用文则先德；威德相济，而后王业成。","book":"明·罗贯中《三国演义》第六十六回"}},{"id":14681,"word":"威恩并行","pinyin":"wēi én bìng xíng","abbr":"webx","explanation":"威：威力；恩：恩德；并行：一并施行。威力与恩德一起用。","source":{"text":"鲂在郡十三年卒，赏善罚恶，威恩并行。","book":"《三国志·吴志·周鲂传》"},"example":{"text":"自是道路夷清，～。","book":"《后汉书·李恂传》"}},{"id":14682,"word":"威振天下","pinyin":"wēi zhèn tiān xià","abbr":"wztx","explanation":"威：威名。威力和名望使天下人拜服。","source":{"text":"今延寿汤所诛，威振天下，虽易之折售，诗之雷霆，不能及也。","book":"汉·荀悦《汉纪·元帝纪》"},"similar":["威震天下"],"usage":"作谓语、定语；指人威力和名望"},{"id":14683,"word":"威无所施","pinyin":"wēi wú suǒ shī","abbr":"wwss","explanation":"威：威力；所：处所，地方；施：施展。无处施展威力。即无用武之处。","source":{"text":"意虎之食人必先被之以威，而不惧之人威无所施欤？","book":"宋·苏轼《孟德传题语》"}},{"id":14684,"word":"威望素着","pinyin":"wēi wàng sù zhù","abbr":"wwsz","explanation":"威望：威信，声望；素：一向；着：明显。一向很有威望。","source":{"text":"泽威望素着，既至，首捕诛舍贼者数人。下令曰：'为盗者赃无轻重，并从军法。'由是盗贼屏息，民赖以安。","book":"《宋史·宗泽传》"}},{"id":14685,"word":"威望素著","pinyin":"wēi wàng sù zhù","abbr":"wwsz","explanation":"威望：威信，声望；素：一向；著：明显。一向很有威望。","source":{"text":"泽威望素著，既至，首捕诛舍贼者数人。下令曰：‘为盗者赃无轻重，并从军法。’由是盗贼屏息，民赖以安。","book":"《宋史·宗泽传》"},"usage":"作谓语、定语；用于书面语"},{"id":14686,"word":"威武不屈","pinyin":"wēi wǔ bù qū","abbr":"wwbq","explanation":"威武：权势，武力；屈：屈服。强暴的压力不能使之屈服。表示坚贞顽强。","source":{"text":"富贵不能淫，贫贱不能移，威武不能屈。此之谓大丈夫。","book":"《孟子·滕文公下》"},"example":{"text":"然后国家无杀士之名，草泽有容身之地，真所谓～。","book":"清·顾炎武《答李紫澜书》"},"similar":["坚贞不屈","宁死不屈"],"opposite":["奴颜婢膝","奴颜媚骨"],"usage":"作谓语、宾语；指人坚贞顽强","story":["战国时期孟子与景春讨论大丈夫问题，景春认为公孙衍及张仪是真正大丈夫，因为他们主张连横学说，游说六国归顺秦国。孟子认为：大丈夫得志时要爱护别人，按规律办事，光明磊落；不得志时做到富贵不能淫，威武不能屈"]},{"id":14687,"word":"威武不能屈","pinyin":"wēi wǔ bù néng qū","abbr":"wwbnq","explanation":"威武：武力。不屈从于威势的镇慑之下。形容不畏强暴。","source":{"text":"富贵不能淫，贫贱不能移，威武不能屈，此之谓大丈夫。","book":"战国·邹·孟轲《孟子·滕文公下》"},"similar":["威武不屈"],"usage":"作宾语、定语；用于劝诫人"},{"id":14688,"word":"威武不能屈，贫贱不能移","pinyin":"wēi wǔ bù néng qū，pín jiàn bù néng yí","abbr":"wwbnqpjbny","explanation":"威武：权势，武力；屈：屈服；移：改变。强暴的压力不能使之屈服，生活贫困、社会地位低下不能使之改变志向。形容意志坚定。","source":{"text":"富贵不能淫，贫贱不能移，威武不能屈。此之谓大丈夫。","book":"《孟子·滕文公下》"},"example":{"text":"而且证明了我们中国，却有许多～的说真话的人们。","book":"鲁迅《记苏联版画展览会》"},"similar":["富贵不淫，威武不屈"],"usage":"作宾语、定语；用于劝诫人"},{"id":14689,"word":"威武雄壮","pinyin":"wēi wǔ xióng zhuàng","abbr":"wwxz","explanation":"威力强大，壮盛有气势。","source":{"text":"然而他们凭借这个舞台，却可以导演出许多有声有色、威武雄壮的戏剧来。","book":"毛泽东《论持久战》"},"opposite":["弱不禁风"],"usage":"作谓语、定语、状语；用于人或事物"},{"id":14690,"word":"威福由己","pinyin":"wēi fú yóu jǐ","abbr":"wfyj","explanation":"威福：指赏罚。赏罚由己。指擅作威福。","source":{"text":"曩者强秦弱主，赵高执柄，专制朝命，威福由己，终有望夷之祸，污辱至今。","book":"《三国志·魏志·袁绍传》裴松之注引《魏氏春秋》"},"example":{"text":"自是～，朝廷不能制，遂有天下。","book":"《旧五代史·太祖纪》"},"similar":["威福自己"],"usage":"作谓语、定语；指大权在握，独断专行","story":["唐朝时期，大臣刘炜之因看不惯武则天的专权，一心想帮助唐睿宗。一次被武则天定罪入狱。唐睿宗据理力争，为其开脱。刘炜之说：“太后威福由己，独断专行，皇帝去营救，就是火上加油，我死定了的。”"]},{"id":14691,"word":"威福自己","pinyin":"wēi fú zì jǐ","abbr":"wfzj","explanation":"威福：指赏罚。任赏任罚，自己一人说了算。比喻大权在握，独断专行。","source":{"text":"杨坚以凡庸之才，藉后父之势，挟幼主而令天下，威福自己，赏罚无章，不臣之迹，暴于行路。","book":"《周书·尉迟迥传》"},"example":{"text":"太后～，而帝营救，速吾祸也。","book":"《新唐书·刘玮之传》"},"similar":["威福由己"],"usage":"作谓语、定语；指大权在握，独断专行","story":["南北朝时期，北周宣帝让驸马都尉尉迟迥驻守相州，杨坚辅佐幼主执政，他担心尉迟迥权势过大，于是挟幼主以令天下，威福自己，让魏安公惇去取代尉迟迥。尉迟迥看出杨坚有称帝的野心，于是杀掉派来的使者，举起反杨坚的大旗"]},{"id":14692,"word":"威而不猛","pinyin":"wēi ér bù měng","abbr":"webm","explanation":"有威仪而不凶猛。","source":{"text":"子温而厉，威而不猛，恭而安。","book":"《论语·述而》"},"example":{"text":"老舍《小坡的生日》：“却不如看门的印度人这样～，黑得适可而止。”"},"usage":"作谓语、定语；用于书面语"},{"id":14693,"word":"威胁利诱","pinyin":"wēi xié lì yòu","abbr":"wxly","explanation":"用软硬兼施的手段，企图使人屈服。","source":{"text":"这一番威胁利诱，教王抗上了当，听从穆彰阿更改遗疏，并以暴疾身故奏报。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"我能经受得起你的～。"},"similar":["威迫利诱"],"usage":"作谓语、宾语；指软硬兼施的手段"},{"id":14694,"word":"威迫利诱","pinyin":"wēi pò lì yòu","abbr":"wply","explanation":"用软硬兼施的手段，企图使人屈服。","source":{"text":"利诱威迫拟夺去，仲高誓死君之侧。","book":"宋·王灼《颐堂文集·卷三·李仲高石君堂》诗"},"example":{"text":"第二国际所属的社会民主党，在张伯伦、达拉第的～之下，正在发生分化。","book":"毛泽东《关于国际新形势对新华日报记者的谈话》"},"similar":["软硬兼施","威逼利诱"],"usage":"作谓语、宾语、定语；指软硬兼施的手段"},{"id":14695,"word":"威重令行","pinyin":"wēi zhòng lìng xíng","abbr":"wzlx","explanation":"权势大，有令必行。","source":{"text":"凤姐儿见自己威重令行，心中十分得意。","book":"清·曹雪芹《红楼梦》第十四回"},"example":{"text":"一个黑脸包公坐镇南京暗地缉拿，一个军机大臣兼两江总督～指挥如意。(二月河《乾隆皇帝》二十三"},"usage":"作谓语、定语；用于处事"},{"id":14696,"word":"威震三军","pinyin":"wēi zhèn sān jūn","abbr":"wzsj","explanation":"威：威力，威望；震：震动；三军：指整个军队。威力震撼整个军队。形容在军队中享有极高的威望。","source":{"text":"监统内外，威震三军，若其浸盛，何以制之？","book":"《三国志·魏志·袁绍传》裴松之注引《世语》"},"example":{"text":"翌日，以兵仗围众，至碑堂下斩之，～。","book":"《旧唐书·李光弼传》"}},{"id":14697,"word":"威震天下","pinyin":"wēi zhèn tiān xià","abbr":"wztx","explanation":"威名传于全国，震惊世上。","source":{"text":"蒙恬却胡千里，非无功也，威震天下，非不强也。","book":"汉·桓宽《盐铁论·非鞅》"},"example":{"text":"发金作冶，制为铠甲及剑，造立兵仗刀戟大弩等，～。","book":"宋·张君房《云笈七签》卷一百"},"similar":["威振天下"],"usage":"作谓语、定语；指人威力和名望"},{"id":14698,"word":"威风八面","pinyin":"wēi fēng bā miàn","abbr":"wfbm","explanation":"形容神气十足，声势慑人。","source":{"text":"鄙人面奉御旨，办理‘七七’周年纪念——有人早就这样替我宣传出去了——应该是威风八面的事。","book":"郭沫若《洪波曲》第七章"},"example":{"text":"王朔《动物凶猛》：“谁不仗义，而谁又在斗殴中～，奋勇无敌。”"},"similar":["八面威风"],"usage":"作谓语、定语；形容人很有气势"},{"id":14699,"word":"威风凛凛","pinyin":"wēi fēng lǐn lǐn","abbr":"wfll","explanation":"威风：威严的气概；凛凛：严肃，可敬畏的样子。形容声势或气派使人敬畏。","source":{"text":"亲从对对，衫帽新鲜，士卒威风，凛凛可畏。","book":"宋·吴自牧《梦梁录·州府节制诸军》"},"example":{"text":"看那少年，生得身长八尺，浓眉大眼，阔面重颐，～。","book":"明·罗贯中《三国演义》第七回"},"similar":["英姿勃勃","气势汹汹"],"opposite":["文质彬彬"],"usage":"作谓语、宾语、状语；用于人"},{"id":14700,"word":"威风扫地","pinyin":"wēi fēng sǎo dì","abbr":"wfsd","explanation":"完全丧失了威严和信誉。","source":{"text":"要是完全听他的，以前的威风扫地，以后就再不得为王。","book":"赵树理《三里湾》"},"example":{"text":"他已经彻底～了。"},"similar":["威信扫地"],"opposite":["声价倍增"],"usage":"作谓语、定语；指彻底失去威信"},{"id":14701,"word":"威风祥麟","pinyin":"wēi fēng xiáng lín","abbr":"wfxl","explanation":"麒麟和凤凰，古代传说是吉祥的禽兽，只有在太平盛世才能见到。后比喻非常难得的人才。","source":{"text":"九年，岚州献祥麟。","book":"《宋史·符瑞志中》：“元康四年，南郡获威风。”《宋史·乐志一》"}},{"id":14702,"word":"娇嗔满面","pinyin":"jiāo chēn mǎn miàn","abbr":"jcmm","explanation":"嗔：嗔怪。形容年轻女子嗔怪时脸上流露着撒娇的神色。","source":{"text":"宝玉见他娇嗔满面，情不可禁，便向枕边拿起一根玉簪来，一跌两段，说道：‘我再不听你说，就和这簪子一样。’","book":"清·曹雪芹《红楼梦》第二十一回"}},{"id":14703,"word":"娇声娇气","pinyin":"jiāo shēng jiāo qì","abbr":"jsjq","explanation":"形容说话娇滴滴的声气。","source":{"text":"穷人的孩子蓬头垢面的在街上转，阔人的孩子妖形妖势娇声娇气的在家里转。","book":"鲁迅《热风·随感录二十五》"},"example":{"text":"王凤子一回头见保长来了，就～地叫开了。","book":"高玉宝《高玉宝》第十章"},"similar":["娇里娇气"],"usage":"作谓语、定语；用于女性"},{"id":14704,"word":"娇娇媚媚","pinyin":"jiāo jiāo mèi mèi","abbr":"jjmm","explanation":"指撒娇讨人喜欢的样子或仪容甜美具有魅力。","source":{"text":"众殿脚女都是演习就的，打扮得娇娇媚媚，上了岸，各照派定前后次第而立。","book":"清·褚人获《隋唐演义》第40回"},"usage":"作定语、状语；多用于女性"},{"id":14705,"word":"娇娇滴滴","pinyin":"jiāo jiāo dī dī","abbr":"jjdd","explanation":"娇娇：妩媚可爱；滴滴：充沛欲滴。形容娇媚可爱的样子。","source":{"text":"有甚么心情花儿靥儿，打扮的娇娇滴滴的媚。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"她那～的声音让人难忘。"},"usage":"作谓语、定语；用于女性声音"},{"id":14706,"word":"娇娇痴痴","pinyin":"jiāo jiāo chī chī","abbr":"jjcc","explanation":"幼稚而天真可爱。故作娇痴之态。","example":{"text":"她装出～的样子，想引起他的注意。"},"usage":"作定语、状语；用于处事"},{"id":14707,"word":"娇子如杀子","pinyin":"jiāo zǐ rú shā zǐ","abbr":"jzrsz","explanation":"娇：过分宠爱，娇惯。过分娇惯子女，等于害了他们。"},{"id":14708,"word":"娇小玲珑","pinyin":"jiāo xiǎo líng lóng","abbr":"jxll","explanation":"玲珑：伶俐可爱。形容身材小巧、伶俐可爱的样子。","source":{"text":"忆惜娇小婆，春心亦自持。","book":"唐·李白白《江夏行》"},"example":{"text":"然而我们中国的作家是另有一种称赞的写法的：所谓“～”者就是。","book":"鲁迅《南腔北调集·上海的少女》"},"similar":["小巧玲珑"],"opposite":["彪形大汉","大而无当"],"usage":"作谓语、定语；形容女子的体态"},{"id":14709,"word":"娇揉造作","pinyin":"jiāo róu zào zuò","abbr":"jrzz","explanation":"不自然地装扮或装模作样，故意夸张而造作","example":{"text":"请不要～了，我们不喜欢你这样"},"similar":["矫揉造作"],"usage":"作谓语、定语、宾语、状语；指故意做作"},{"id":14710,"word":"娇生惯养","pinyin":"jiāo shēng guàn yǎng","abbr":"jsgy","explanation":"娇：爱怜过甚；惯：纵容，放任。从小就被溺爱、娇养惯了。","source":{"text":"宝玉冷笑道：‘原是想他自幼娇生惯养的，何尝受过一日委屈。’","book":"清·曹雪芹《红楼梦》第七十七回"},"example":{"text":"她从小～，什么事也不会干。"},"similar":["掌上明珠","养尊处优"],"usage":"作谓语、宾语、定语；指从小就被溺爱"},{"id":14711,"word":"娇皮嫩肉","pinyin":"jiāo pí nèn ròu","abbr":"jpnr","explanation":"指肌肤细嫩。","source":{"text":"可怜这朝奉是花月丛中长大的，近年有了几茎胡子，主人才差他出来押船，娇皮嫩肉，何曾见过这样官刑。","book":"清·吴敬梓《儒林外史》第43回"},"example":{"text":"你这～怎么能经得这样的折腾呢？"},"similar":["细皮嫩肉"],"usage":"作谓语、定语；指肌肤细嫩"},{"id":14712,"word":"娇鸾雏凤","pinyin":"jiāo luán chú fèng","abbr":"jlcf","explanation":"幼小的鸾凤。比喻青春年少的情侣。","source":{"text":"他那里思不穷，我这里意已通，娇鸾雏凤失雌雄。","book":"元·王实甫《西厢记》第二本第五折"},"example":{"text":"元·王实甫《西厢记》第二本第四折：“他那里思不穷，我这里意已通，～失雌雄。”"},"usage":"作主语、宾语；用于比喻句"},{"id":14713,"word":"娉娉袅袅","pinyin":"pīng pīng niǎo niǎo","abbr":"ppnn","explanation":"娉娉：秀美的样子；袅袅：细长柔美的样子。形容女子苗条俊美，体态轻盈。","source":{"text":"娉娉袅袅十三余，豆蔻梢头二月初。","book":"唐·杜牧《赠别二首》"},"similar":["娉婷袅娜"],"usage":"作谓语、定语；用于女性等"},{"id":14714,"word":"娉婷婀娜","pinyin":"pīng tíng ē nà","abbr":"pten","explanation":"①形容女子姿态柔美。②借指美人。"},{"id":14715,"word":"娉婷袅娜","pinyin":"pīng tíng niǎo nuó","abbr":"ptnn","explanation":"形容女子姿态柔美。亦借指美人。","source":{"text":"我府中歌童舞女虽多，端没有这妮子娉婷袅娜。","book":"明·徐复祚《红梨记·豪宴》"},"example":{"text":"只这冷土荒堆树半棵，便是～，落来的好巢窝。","book":"清·洪昇《长生殿·冥追》"},"similar":["娉娉袅袅"],"usage":"作谓语、定语；用于女性等"},{"id":14716,"word":"娓娓不倦","pinyin":"wěi wěi bù juàn","abbr":"wwbj","explanation":"娓娓：谈话连续不倦的样子。连续谈论，不知疲倦。","source":{"text":"或与谈论古今兴废之事，娓娓不倦。","book":"明·冯梦龙《警世通言》卷二十一"},"example":{"text":"托神与河间之叟，与人谈诗文，决休咎，～。","book":"清·蒲松龄《聊斋志异·侯静山》"},"similar":["娓娓不怠"],"usage":"作谓语、定语；指健谈"},{"id":14717,"word":"娓娓不怠","pinyin":"wěi wěi bù dài","abbr":"wwbd","explanation":"娓娓：谈话连续不倦的样子；怠：松懈。连续谈论，不知懈怠。","source":{"text":"或与谈论古今兴废之事，娓娓不倦。","book":"明·冯梦龙《警世通言》卷二十一"},"similar":["娓娓不倦"],"usage":"作谓语、定语；指健谈"},{"id":14718,"word":"娓娓动听","pinyin":"wěi wěi dòng tīng","abbr":"wwdt","explanation":"形容善于讲话，使人喜欢听。","source":{"text":"就把英语来对答，倒也说得清脆悠扬，娓娓动听。","book":"清·曾朴《孽海花》第三十四回"},"example":{"text":"她讲得～，妹仔细听着忽而笑容满面，忽而愁眉双锁。","book":"邹韬奋《我的母亲》"},"similar":["绘声绘色","娓娓而谈"],"opposite":["一言不语"],"usage":"作谓语、状语、定语；指人说话"},{"id":14719,"word":"娓娓可听","pinyin":"wěi wěi kě tīng","abbr":"wwkt","explanation":"娓娓：说话连续不倦的样子。形容善于讲话，使人喜欢听。","source":{"text":"兰哥并不学赶墟恶套，唱那秽语俚歌，款款的念出《关雎》三章，虽系自来之腔，却长短疾徐，自有节奏，娓娓可听。","book":"清·夏敬渠《野叟曝言》第九十三回"},"example":{"text":"说来似属～，一经明眼人瞧着，早已知他饰辞欺人，欲盖弥彰了。","book":"蔡东藩《后汉演义》第八十五回"},"similar":["娓娓动听"],"usage":"作谓语、状语、定语；用于说话"},{"id":14720,"word":"娓娓而谈","pinyin":"wěi wěi ér tán","abbr":"wwet","explanation":"连续不倦地谈论着。","source":{"text":"只如熟人相对，娓娓而谈。","book":"鲁迅《且介亭杂文二集·小说二集序》"},"example":{"text":"他～当年插队的故事，大家都很乐意听。"},"similar":["侃侃而谈"],"usage":"作谓语、宾语；指人健谈"},{"id":14721,"word":"娟好静秀","pinyin":"juān hǎo jìng xiù","abbr":"jhjx","explanation":"形容容貌秀美，性情柔和。","source":{"text":"幼子娟好静秀，瑶环瑜珥，兰茁其芽，称其家儿也。","book":"唐·韩愈《殿中少监马君墓志》"},"similar":["秀丽大方"],"usage":"作谓语、定语；用于女性"},{"id":14722,"word":"娥皇女英","pinyin":"é huáng nǚ yīng","abbr":"ehny","explanation":"传说娥皇、女英为尧的两个女儿，都嫁给了舜。旧时指姐妹侍奉同一个丈夫。","source":{"text":"二女，娥皇、女英也。","book":"《史记·五帝本纪》：“于是尧妻之二女。”张守节正义"},"example":{"text":"此地乃上神神女之所，虽号为潇湘妃子，并不是～之辈，何得与凡人有亲。","book":"清·曹雪芹《红楼梦》第一百十六回"},"usage":"作宾语、定语；用于女性"},{"id":14723,"word":"娱妻弄子","pinyin":"yú qī nòng zǐ","abbr":"yqnz","explanation":"和妻子儿女玩乐。","source":{"text":"如今天下有两样待宰相的，一样是吃饭穿衣，娱妻弄子的臭人……一样是卖国倾朝，谨具平天冠，奉申白玉玺。","book":"《西游补》第九回"},"similar":["含饴弄孙"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":14724,"word":"娱心悦目","pinyin":"yú xīn yuè mù","abbr":"yxym","explanation":"娱、悦：使愉快。使心情愉快，耳目舒畅。","source":{"text":"直取其清淡雅论，剖玄析微，宾主往复，娱心悦耳，非济世成俗之要也。","book":"秦·李斯《谏逐客书》：“所以饰后宫，充下陈，娱心意，说耳目者，必出于秦然后可。”北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"清·吴璿《飞龙全传》第三回：“有的歌唱，有的舞蹈，真是～，好看不过的。”"},"similar":["赏心悦目","娱心悦耳"],"usage":"作谓语、定语；指人的心情"},{"id":14725,"word":"娱心悦耳","pinyin":"yú xīn yuè ěr","abbr":"yxye","explanation":"娱、悦：使愉快。使心情愉快，耳目舒畅。","source":{"text":"直取其清淡雅论，剖玄析微，宾主往复，娱心悦耳，非济世成俗之要也。","book":"秦·李斯《谏逐客书》：“所以饰后宫，充下陈，娱心意，说耳目者，必出于秦然后可。”北齐·颜之推《颜氏家训·勉学》"},"similar":["娱心悦目"],"usage":"作谓语、定语；指人的心情"},{"id":14726,"word":"娱耳悦目","pinyin":"yú ěr yuè mù","abbr":"yeym","explanation":"娱、悦：使愉快。使心情愉快，耳目舒畅。","source":{"text":"所以饰后宫，充下陈，娱心意，说耳目者，必出于秦然后可。","book":"秦·李斯《谏逐客书》"},"example":{"text":"今世俗犹皆以此娱悦耳目，辞赋比～，有仁义风谕鸟兽草木多闻之观，贤于倡优博弈远矣。","book":"唐·欧阳询《艺文类聚》卷五十六"}},{"id":14727,"word":"婀娜多姿","pinyin":"ē nuó duō zī","abbr":"endz","explanation":"形容姿态柔和而美好。","source":{"text":"华容婀娜令我忘餐。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"我忘不了她那～的舞姿。"},"similar":["千娇百媚","仪态万方"],"opposite":["丑态百出","搔首弄姿"],"usage":"作补语、定语；形容女子柔美"},{"id":14728,"word":"婀娜妩媚","pinyin":"ē nuó wǔ mèi","abbr":"enwm","explanation":"婀娜：轻盈柔美；妩媚：姿态美好。轻盈柔美的姿态。","source":{"text":"一串串盛开的藤花，满吊枝头，迎风摇曳，婀娜妩媚。","book":"曹靖华《小跋》"},"usage":"作谓语、定语；用于花卉或女性"},{"id":14729,"word":"婆娑起舞","pinyin":"pó suō qǐ wǔ","abbr":"psqw","explanation":"形容跳起舞来的姿态。","example":{"text":"操场上很多同学在～，坚持晨练。"},"similar":["翩翩起舞"],"usage":"作谓语；指舞姿优美"},{"id":14730,"word":"婆婆妈妈","pinyin":"pó pó mā mā","abbr":"ppmm","explanation":"形容人动作琐细，言语罗唆。也形容人感情脆弱。","source":{"text":"你也太婆婆妈妈的了。这样的话，自私是你读书的人说的？","book":"清·曹雪芹《红楼梦》第七十七回"},"example":{"text":"上海下层社会中也有不少喜欢议论别人的～。","book":"余秋雨《文化苦旅·上海人》"},"similar":["唠唠叨叨"],"opposite":["干干脆脆"],"usage":"作谓语、定语、宾语；形容人感情脆弱","story":["秦钟上学给姐姐秦可卿惹事，害得她大病一场，王熙凤带贾宝玉等前去看望秦可卿。秦可卿说了一些悲观的话，宝玉在那里泪流满面，凤姐骂宝玉太婆婆妈妈了，这样会给病人带来不好的影响。贾蓉立即过来解围，并拉宝玉去会芳园玩"]},{"id":14731,"word":"婉婉有仪","pinyin":"wǎn wǎn yǒu yí","abbr":"wwyy","explanation":"婉婉：温顺的样子。形容温文柔顺而有礼貌。","source":{"text":"夫人本宗氏族之后，率其先猷，令德是茂，爱旧得家，九子一田，婉婉有仪，静以和命。","book":"唐·韩愈《档喃缑氏主簿唐充妻卢氏墓志铭》"}},{"id":14732,"word":"婉言谢绝","pinyin":"wǎn yán xiè jué","abbr":"wyxj","explanation":"婉：婉转。辞语婉转地不答应。","source":{"text":"幸亏英相罗士勃雷婉言谢绝，否则一个女儿受了两家茶，不特破坏垂成的和局，而且丧失大信。","book":"曾朴《孽海花》第32回"},"example":{"text":"我～了他的邀请。"},"usage":"作谓语；指委婉拒绝"},{"id":14733,"word":"婉转悠扬","pinyin":"wǎn zhuǎn yōu yáng","abbr":"wzyy","explanation":"婉转：声调温和曲折；悠扬：声音漫长而和谐。委婉曲折，也指声音悠扬动听。"},{"id":14734,"word":"婢作夫人","pinyin":"bì zuò fū rén","abbr":"bzfr","explanation":"婢：侍女；夫人：主妇。旧时指在文艺方面虽刻意模仿别人，但才力和作品的规模总赶不上。","source":{"text":"羊欣书如大家婢为夫人。虽处其位，而举止羞涩，终不似真。","book":"唐·张彦远《法书要录》引南朝梁袁昂《古今书评》"},"example":{"text":"不过偶尔学着写，正是～，那里及得到大哥什一。","book":"清·吴趼人《二十年目睹之怪现状》第四十一回"},"similar":["婢学夫人"],"usage":"作谓语、定语、宾语；形容刻意模仿而不像"},{"id":14735,"word":"婢学夫人","pinyin":"bì xué fū rén","abbr":"bxfr","explanation":"婢女学作夫人，比喻刻意去学，却总不能像。","source":{"text":"他这日见两奶奶都戴着双翠雁儿，也把那只戴在头上，婢学夫人，十分得意。","book":"清·文康《儿女英雄传》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第41回：“不过偶尔学着写，正是～，那里及得到大哥什一！”"},"similar":["婢作夫人"],"opposite":["栩栩如生"],"usage":"作谓语、定语、宾语；形容刻意模仿而不像"},{"id":14736,"word":"婢膝奴颜","pinyin":"bì xī nú yán","abbr":"bxny","explanation":"形容卑躬屈膝谄媚奉承的奴才相。参见“奴颜婢膝”。","source":{"text":"他日侥幸立朝，则婢膝奴颜，汝必安为之矣。","book":"清·钮琇《觚剩续编·简公雪冤》"},"example":{"text":"弟如畏死，则何难媕阿闒冗，～，以求自身之安乐于名场官海之间。","book":"梁启超《复金山中华会馆书》"},"similar":["奴颜婢膝"],"opposite":["刚正不阿"],"usage":"作谓语、定语；指没有骨气"},{"id":14737,"word":"婴城固守","pinyin":"yīng chéng gù shǒu","abbr":"ycgs","explanation":"婴：围绕；婴城：据城。据守城池牢固设防。","source":{"text":"必将婴城固守。","book":"东汉·班固《蒯通传》"},"example":{"text":"国安焚铜陵，掠南陵，所至人皆～。","book":"清·汪琬《前明兵科右给事中吴公墓志铭》"},"similar":["婴城自守","婴城自保"],"usage":"作谓语、定语；指防御"},{"id":14738,"word":"婴城自保","pinyin":"yīng chéng zì bǎo","abbr":"yczb","explanation":"婴：缠绕，围绕。倚仗城墙可达到保全自身的目的。","source":{"text":"必将婴城固守，皆为金城汤池，不可攻也。","book":"《汉书·蒯通传》"},"similar":["婴城自守","婴城固守"],"usage":"作谓语、定语；指防御"},{"id":14739,"word":"婴城自守","pinyin":"yīng chéng zì shǒu","abbr":"yczs","explanation":"婴：缠绕，围绕。倚仗城墙可达到坚守的目的。","source":{"text":"安都闻大军过淮，婴城自守，要取索虏。","book":"《汉书·蒯通传》：“必将婴城固守，皆为金城汤池，不可攻也。”《宋书·蔡兴宗传》"},"example":{"text":"胤军次仲桥，石生～，飞使向襄国乞援。","book":"蔡东藩《两晋演义》第四十二回"},"similar":["婴城固守","婴城自保"],"usage":"作谓语、定语；指防御"},{"id":14740,"word":"婴鳞获罪","pinyin":"yīng lín huò zuì","abbr":"ylhz","explanation":"婴：触犯；鳞：朝相反方向长的鳞。因朝向反方向长的鳞而获罪。比喻臣子因进谏触犯皇帝而获罪。","source":{"text":"夫龙之为虫也，柔可狎而骑也；然其喉下有逆鳞径尺，若人有婴之者，则必杀人。人主亦有逆鳞，说者能无婴人主之逆鳞，则几矣。","book":"《韩非子·说难》"},"usage":"作谓语、定语；用于书面语"},{"id":14741,"word":"婵娟此豸","pinyin":"chán juān cǐ zhì","abbr":"cjcz","explanation":"婵娟：美好的样子，也指美女；此豸：姿态妖媚。形容美女姿态妩媚妖娆。","source":{"text":"增婵娟以此豸。","book":"汉·张衡《西京赋》"}},{"id":14742,"word":"媒妁之言","pinyin":"méi shuò zhī yán","abbr":"mszy","explanation":"媒妁：说合婚姻的人。媒人的介绍。","source":{"text":"不待父母之命，媒妁之言，钻穴隙相窥。","book":"战国·邹·孟轲《孟子·滕文公下》"},"example":{"text":"凭～而结婚的现象至今还有。"},"usage":"作主语、宾语；指媒人的介绍"},{"id":14743,"word":"媚外求荣","pinyin":"mèi wài qiú róng","abbr":"mwqr","explanation":"媚：谄媚。奉承外国人以谋求个人利益。","source":{"text":"这是媚外求荣的结局，表过不提。","book":"清·吴趼人《痛史》第19回"},"similar":["卖国求荣"],"usage":"作谓语、定语；指人自私"},{"id":14744,"word":"嫁犬逐犬","pinyin":"jià quǎn zhú quǎn","abbr":"jqzq","explanation":"指出嫁女子唯夫是从。","source":{"text":"却不道嫁犬逐犬，切莫要看样画葫芦，又把那别新郎的铺盖卷。","book":"清·李渔《奈何天·逼嫁》"},"example":{"text":"现代女子很少有～的观念了。"},"similar":["嫁鸡随鸡"],"usage":"作谓语、宾语；指女性嫁夫观念"},{"id":14745,"word":"嫁狗逐狗","pinyin":"jià gǒu zhú gǒu","abbr":"jgzg","explanation":"比喻女子只能顺从丈夫。同“嫁狗随狗”。","source":{"text":"嫁狗逐狗鸡逐鸡，耿耿不寐展转思。","book":"宋·庄季裕《鸡肋编》卷下：“杜少陵《新婚别》云：‘鸡狗亦得将’。世谓谚云：‘嫁得鸡逐鸡飞，嫁得狗逐狗走’之语也。”宋·赵汝鐩《古别离》诗"},"similar":["嫁鸡逐鸡","嫁犬逐犬"],"usage":"作谓语、宾语；指女性嫁夫观念"},{"id":14746,"word":"嫁狗随狗","pinyin":"jià gǒu suí gǒu","abbr":"jgsg","explanation":"比喻女子只能顺从丈夫。","source":{"text":"兰摧蕙枯昆玉碎，不如人家嫁狗随狗鸡随鸡。","book":"宋·陈造《题六幺后》"},"example":{"text":"女孩子不能有～的思想。"},"similar":["嫁狗逐狗"],"usage":"作谓语、定语、宾语；用于女性"},{"id":14747,"word":"嫁祸于人","pinyin":"jià huò yú rén","abbr":"jhyr","explanation":"嫁：转移。把自己的祸事推给别人。","source":{"text":"韩氏所以不入于秦者，欲嫁祸于赵也。","book":"《史记·赵世家》"},"example":{"text":"他们这样说，固然也许是因为失败之后，～，或者因为自己变计，须有借口之故。","book":"鲁迅《两地书》一○六"},"similar":["以邻为壑"],"opposite":["助人为乐","与人为善"],"usage":"作谓语、宾语、定语；指转嫁给别人","story":["三国时期，关羽麦城战败被孙权杀害，张昭建议把关羽的首级送给曹操，好让刘备攻打曹操。孙权命人将关羽的首级送给曹操，司马懿识破孙权嫁祸于人的阴谋，于是用重臣的礼仪厚葬关羽，并封关羽为荆王，使孙权的计谋落空"]},{"id":14748,"word":"嫁鸡逐鸡","pinyin":"jià jī zhú jī","abbr":"jjzj","explanation":"比喻女子出嫁后只能顺从丈夫。","source":{"text":"人言嫁鸡逐鸡飞，安知嫁鸠被鸠逐。","book":"宋·欧阳修《代鸠妇言》"},"example":{"text":"虽然不好明说丈夫丑陋，只把～的常话劝诲他一番便了。","book":"清·李渔《奈何天·忧嫁》"},"similar":["嫁狗随狗"],"usage":"作谓语、宾语；指女性嫁夫观念"},{"id":14749,"word":"嫁鸡逐鸡，嫁犬逐犬","pinyin":"jià jī zhú jī，jià quǎn zhú quǎn","abbr":"jjzjjqzq","explanation":"嫁：女子出嫁；逐：追随。比喻女子出嫁后，不论丈夫好坏，都要随从一辈子。","source":{"text":"嫁狗逐狗鸡逐鸡，耿耿不寐展转思。","book":"宋·赵汝鐩《古别离》诗"},"example":{"text":"父王，常言‘～’，女有誓愿在先，结了这球，告奏天地神明。","book":"明·吴承恩《西游记》第93回"},"similar":["嫁鸡随鸡"],"usage":"作定语、主语、分句；用于女性"},{"id":14750,"word":"嫁鸡随鸡，嫁狗随狗","pinyin":"jià jī suí jī，jià gǒu suí gǒu","abbr":"jjsjjgsg","explanation":"封建礼教认为，女子出嫁后，不论丈夫好坏，都要永远跟从。","source":{"text":"嫁狗逐狗鸡逐鸡，耿耿不寐展转思。","book":"宋·欧阳修《代鸠妇言》：“人言嫁鸡逐鸡飞，安知嫁鸠被鸠逐。”宋·赵汝鐩《古别离》诗"},"example":{"text":"你难道没听见人说，“～”，那里个个都象你大姐做娘娘呢？","book":"清·曹雪芹《红楼梦》第八十一回"},"similar":["泼水难收","嫁鸡逐鸡，嫁犬逐犬"],"usage":"作定语、主语、分句；用于女性"},{"id":14751,"word":"嫂溺叔援","pinyin":"sǎo nì shū yuán","abbr":"snsy","explanation":"比喻视实际情况而变通做法。","source":{"text":"男女授受不亲，礼与；嫂溺，援之以手者，权也。","book":"战国·邹·孟轲《孟子·离娄上》"},"example":{"text":"帝曰：‘子坐父立，礼乎？’对曰：‘～，权也。’","book":"明·蒋一葵《长安客话》"},"usage":"作宾语、定语；用于书面语","story":["战国时期，齐国雄辩家淳于髡问孟子男女之间不用手递受物品是礼，那么嫂子掉进水里，小叔子用手去救是礼吗？孟子认为是礼。淳于髡又说天下的人都掉进水里，你为什么不去救？孟子回答说应该用道去救，而不是用手去救"]},{"id":14752,"word":"嫉恶好善","pinyin":"jí è hào shàn","abbr":"jehs","explanation":"嫉：憎恨；好：喜欢。憎恨坏人坏事，鼓励好人好事。","source":{"text":"至如激浊扬清，嫉恶好善，臣于数子，亦有一日之长。","book":"《旧唐书·王珪传》"},"example":{"text":"～是我们的优良传统。"},"similar":["扬善去恶","疾恶好善"],"usage":"作谓语、宾语、定语；用于人的性格","story":["唐朝时期，唐太宗十分赏识敢于直言的王珪，他让王珪评论房玄龄、李靖、魏征等人。王珪回答：在治理国事操劳方面自己不如房玄龄；文武全才、出将入相比不上李靖；谏争方面比不上魏征，但在激浊扬清、嫉恶好善方面他要超过他们四人"]},{"id":14753,"word":"嫉恶如仇","pinyin":"jí è rú chóu","abbr":"jerc","explanation":"指对坏人坏事如同对仇敌一样憎恨。","source":{"text":"嫉恶如仇，有所白眼者，出一语必刺入骨。","book":"清·梁绍壬《两般秋雨庵随笔·蔡木龛》"},"example":{"text":"有万的绝对公正、～、见公共事一马当先，使得生宝感到互助组有这个人。","book":"柳青《创业史》第一部第八章"},"similar":["疾恶如仇"],"opposite":["善恶不分"],"usage":"作谓语、定语；指爱憎分明"},{"id":14754,"word":"嫉恶若仇","pinyin":"jí è ruò chóu","abbr":"jerc","explanation":"指对坏人坏事如同对仇敌一样憎恨。同“嫉恶如仇”。","source":{"text":"公一时忠愤激发，嫉恶若仇，容或偶为此语，揆其心术，仍不失为磊落光明。","book":"清·陈康祺《郎潜纪闻》卷六"},"similar":["嫉恶如仇"],"usage":"作谓语、定语；指爱憎分明"},{"id":14755,"word":"嫉贤傲士","pinyin":"jí xián ào shì","abbr":"jxas","explanation":"嫉妒和轻慢有才德的人。","source":{"text":"独据梁山志可羞，嫉贤傲士少宽柔。","book":"明·施耐庵《水浒传》第十九回"},"usage":"作谓语、定语；指人妒才"},{"id":14756,"word":"嫉贤妒能","pinyin":"jí xián dù néng","abbr":"jxdn","explanation":"对品德、才能比自己强的人心怀嫉妒。","source":{"text":"项羽嫉贤妒能，有功者害之，贤者疑之。","book":"汉·荀悦《汉纪·高祖纪三》"},"example":{"text":"你这～的贼，不杀了，要你何用！","book":"明·施耐庵《水浒传》第19回"},"similar":["妒贤嫉能"],"opposite":["爱才如命"],"usage":"作谓语、定语；指嫉妒"},{"id":14757,"word":"嫉贪如仇","pinyin":"jí tān rú chóu","abbr":"jtrc","explanation":"嫉：憎恨；贪：爱财。憎恨贪污像憎恨仇敌一样。","source":{"text":"吴南溪方伯生平洁介，嫉贪如仇。","book":"清·周亮工《书影》第九卷"},"example":{"text":"他～，适合担任反贪局长。"},"similar":["嫉贪如雠"],"usage":"作谓语、定语、宾语；用于人的性格"},{"id":14758,"word":"嫉贪如雠","pinyin":"jí tān rú chóu","abbr":"jtrc","explanation":"对贪污如同对仇敌一样痛恨。","source":{"text":"吴南溪方伯生平洁介，嫉贪如雠。","book":"清·周亮工《书影》卷九"},"similar":["嫉贪如仇"],"usage":"作谓语、定语、宾语；用于人的性格"},{"id":14759,"word":"嫉闲妒能","pinyin":"jí xián dù néng","abbr":"jxdn","explanation":"嫉、妒：因别人好而忌恨。对品德、才能比自己强的人心怀怨恨。","source":{"text":"妒贤嫉能，御下蔽之。","book":"《史记·高祖本纪》：“项羽妒贤嫉能，有功者害之，贤者疑之。”《史记·范雎蔡泽列传》"}},{"id":14760,"word":"嫌好道恶","pinyin":"xián hǎo dào è","abbr":"xhde","explanation":"说好道坏。指挑剔苛求。","source":{"text":"小弟生性喜欢养几匹马，他就嫌好道恶的，说着蹋了他的院子。","book":"清·吴敬梓《儒林外史》第五十二回"},"similar":["嫌好道歹","嫌好道歉"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":14761,"word":"嫌好道歉","pinyin":"xián hǎo dào qiàn","abbr":"xhdq","explanation":"说好道坏。指挑剔苛求。","source":{"text":"这些杀才，劫掠良家妇女，在此歌曲，还有许多嫌好道歉。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"example":{"text":"明·冯梦龙《醒世恒言》第25卷：“这些杀才，劫掠良家妇女，在此歌曲，还有许多～！”"},"similar":["嫌好道恶"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":14762,"word":"嫌好道歹","pinyin":"xián hǎo dào dǎi","abbr":"xhdd","explanation":"形容嫌恶，挑剔。","source":{"text":"逐日送些茶饭，嫌好道歹，且是得人憎。","book":"明·冯梦龙《古今小说》卷二十四"},"similar":["嫌好道恶"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":14763,"word":"嫌肥挑瘦","pinyin":"xián féi tiāo shòu","abbr":"xfts","explanation":"挑肥拣瘦。","example":{"text":"干工作不能～。"},"similar":["挑肥拣瘦"],"opposite":["任劳任怨"],"usage":"作谓语、定语；指挑肥拣瘦"},{"id":14764,"word":"嫌贫爱富","pinyin":"xián pín ài fù","abbr":"xpaf","explanation":"嫌弃贫穷，喜爱富有。指对人的好恶以其贫富为准。","source":{"text":"有那等嫌贫爱富的儿曹辈，将俺这贫傲慢、把他那富追陪，那个肯恤孤念寡存仁义。","book":"元·关汉卿《裴度还带》第二折"},"example":{"text":"有负义忘恩的强盗，有～的强盗。","book":"清·李汝珍《镜花缘》第五十八回"},"similar":["欺贫爱富"],"opposite":["劫富济贫"],"usage":"作谓语、宾语、定语；指人对贫富的态度"},{"id":14765,"word":"嫌长道短","pinyin":"xián cháng dào duǎn","abbr":"xcdd","explanation":"犹苛求责备。","source":{"text":"一般儿大的人，怎么我的赔送就该那等苟简，姐姐有这些人给办妆奁还嫌长道短？这话怎么讲？","book":"清·文康《儿女英雄传》第二十六回"},"example":{"text":"清·李百川《绿野仙踪》第73回：“每食须二十余桌，还要～，打碗摔盘。”"},"similar":["说长道短"],"usage":"作谓语、定语、宾语；指过分苛求"},{"id":14766,"word":"嫠不恤纬","pinyin":"lí bù xù wěi","abbr":"lbxw","explanation":"嫠：寡妇；恤：忧虑；纬：织布用的纬纱。寡妇不怕织得少，而怕亡国之祸。旧时比喻忧国忘家。","source":{"text":"嫠不恤其纬，而忧宗周之陨，为将及焉。","book":"《左传·昭公二十四年》"},"example":{"text":"嫠不恤其纬，忧天如杞人。","book":"清·龚自珍《乞籴保阳》诗"},"usage":"作宾语；比喻忧国而忘家"},{"id":14767,"word":"嫠纬之忧","pinyin":"lí wěi zhī yōu","abbr":"lwzy","explanation":"嫠：寡妇；纬：织物的横线。指为国忧虑。","source":{"text":"臣何敢追尤往事，上渎圣聪，独方来计，则嫠纬之忧，不能忘情焉。","book":"宋·文天祥《癸亥上皇帝书》"},"example":{"text":"以夫与霖惧怀～。","book":"吴荣《三朝野史》"},"usage":"作宾语；指为国忧虑"},{"id":14768,"word":"嫣然一笑","pinyin":"yān rán yī xiào","abbr":"yryx","explanation":"嫣然：笑得很美的样子（指女性）。形容女子笑得很美。","source":{"text":"嫣然一笑，惑阳城，迷下蔡。","book":"战国楚·宋玉《登徒子好色赋》"},"example":{"text":"都只在～中，偷把幽情送。","book":"元·无名氏《梧桐叶》第四折"},"similar":["付之一笑","嫣然而笑","嫣然含笑"],"usage":"作谓语、定语；用于女性"},{"id":14769,"word":"嫣然含笑","pinyin":"yān rán hán xiào","abbr":"yrhx","explanation":"嫣然：美好的样子。形容女子笑得很美","source":{"text":"斟酌移时，女频来行酒，嫣然含笑，殊不羞涩。","book":"清·蒲松龄《聊斋志异·花姑子》"},"similar":["嫣然一笑","嫣然而笑"],"usage":"作谓语、定语；用于女性"},{"id":14770,"word":"嫣然而笑","pinyin":"yān rán ér xiào","abbr":"yrex","explanation":"嫣然：美好的样子。形容女子笑得很美","source":{"text":"一日，女出门，生注目之，女忽回首，嫣然而笑。","book":"清·蒲松龄《聊斋志异·侠女》"},"similar":["嫣然含笑","嫣然一笑"],"usage":"作谓语、定语；用于女性"},{"id":14771,"word":"嫣红姹紫","pinyin":"yān hóng chà zǐ","abbr":"yhcz","explanation":"指花色娇艳，亦指娇艳的花。","source":{"text":"繁华歇尽何须吊！且由他，嫣红姹紫，一春收了。","book":"廖仲凯《金缕曲·题八大山人松壑图》词"},"example":{"text":"她们因为慰藉我的无聊起见，送了一瓶花来，～，清香扑鼻，不过我心中的难受由此更加几倍。","book":"冯沅君《隔绝》"},"similar":["姹紫嫣红"],"opposite":["残花败柳"],"usage":"作谓语、定语；形容鲜花的美丽"},{"id":14772,"word":"嫦娥奔月","pinyin":"cháng é bēn yuè","abbr":"ceby","explanation":"嫦娥：月宫仙子；奔：投向。嫦娥投向月亮。","source":{"text":"羿请不死之药于西王母，姮娥窃以奔月，怅然有丧。","book":"西汉·刘安《淮南子·览冥训》"},"example":{"text":"～，龙宫探宝。","book":"郭沫若《科学的春天》"},"usage":"作宾语、定语；指飞向月球","story":["传说古代天空中有10个太阳同时出来，大地被烤成焦土，后羿为民除害射掉了9个太阳，西天的王母娘娘奖赏他长生不老的仙药。他的妻子嫦娥趁后羿不注意时偷吃了这些药，突然她就成仙飞向天宫，王母娘娘惩罚她，让她在广寒宫里思过"]},{"id":14773,"word":"嫩草怕霜霜怕日","pinyin":"nèn cǎo pà shuāng shuāng pà rì","abbr":"ncpsspr","explanation":"比喻你欺侮别人，还会被比你更恶的人欺侮。","source":{"text":"如两句俗语说的：‘嫩草怕霜霜怕日，恶人还被恶人磨。’","book":"吴睿《飞龙全传》"},"similar":["恶人还被恶人磨"],"usage":"作宾语、定语；指强中自有强中手","story":["后周末年，赵匡胤的宝马由郑恩放养，被团练教头韩通抢走。韩通霸占刘员外的庄子，手下养了几百号人，经常干一些敲诈勒索的事情，赵匡胤见了韩通挥棒就打，打得韩通跪地求饶，别人袖手旁观，幸灾乐祸，正是“嫩草怕霜霜怕日，恶人还被恶人磨”"]},{"id":14774,"word":"嬉皮笑脸","pinyin":"xī pí xiào liǎn","abbr":"xpxl","explanation":"形容嬉笑不严肃的样子。","source":{"text":"你见我和谁玩过！有和你素日嬉皮笑脸的那些姑娘们，你该问他们去！","book":"清·曹雪芹《红楼梦》第三十回"},"example":{"text":"班长随又～岔了一句。","book":"沙汀《一个秋天晚上》"},"similar":["笑逐颜开","嘻嘻哈哈"],"opposite":["一本正经","正言厉色"],"usage":"作主语、谓语、状语；指态度不严肃"},{"id":14775,"word":"嬉笑怒骂","pinyin":"xī xiào nù mà","abbr":"xxnm","explanation":"嬉：游戏。比喻不论什么题材和形式，都能任意发挥，写出好文章来。","source":{"text":"东坡之酒，赤壁之笛，嬉笑怒骂，皆成文章。","book":"宋·黄庭坚《东坡先生真赞》"},"example":{"text":"设科之～。如白描人物，须眉毕观，引人入胜者，全借乎此。","book":"清·孔尚任《桃花扇·凡例》"},"similar":["冷嘲热讽","讽刺挖苦"],"usage":"作主语、谓语；指人的各种神情","story":["宋朝时期，苏东坡在黄冈赤壁过生日，忽闻江上笛声悠扬，派人一问才知是进士李委在为他祝寿，他感慨万千，立即即兴作《李委吹笛序》。黄庭坚在《东坡先生真赞》称赞他：“东坡之酒，赤壁之笛，嬉笑怒骂，皆成文章。”"]},{"id":14776,"word":"嬉笑怒骂，皆成文章","pinyin":"xī xiào nù mà，jiē chéng wén zhāng","abbr":"xxnmjcwz","explanation":"指不拘题材形式，任意发挥，皆成妙文。","source":{"text":"东坡之酒，赤壁之笛，嬉笑怒骂，皆成文章。","book":"宋·黄庭坚《东坡先生真赞》之一"},"example":{"text":"东坡～；不过一时兴到语，不可以词害意。","book":"清·袁枚《随园诗话》卷七"},"usage":"作宾语、定语、分句；用于书面语"},{"id":14777,"word":"嬴奸买俏","pinyin":"yíng jiān mǎi qiào","abbr":"yjmq","explanation":"犹言狎妓买笑。"},{"id":14778,"word":"孀妻弱子","pinyin":"shuāng qī ruò zǐ","abbr":"sqrz","explanation":"寡妇和年幼的孤儿。","source":{"text":"汝心之固，固不可彻，曾不若孀妻弱子。","book":"《列子·汤问》"},"similar":["孤儿寡母"],"usage":"作主语、宾语、定语；指孤儿寡母"},{"id":14779,"word":"子不语怪","pinyin":"zǐ bù yǔ guài","abbr":"zbyg","explanation":"本指孔子不谈关于怪异、勇力、叛乱、鬼神一类事情。指用以指不谈怪异一类的事情。","source":{"text":"子不语怪、力、乱、神。","book":"《论语·述而》"},"example":{"text":"然虽如此，又道是～，且阁过一边。","book":"明·冯梦龙《醒世恒言》卷四"},"usage":"作宾语、定语；用于书面语"},{"id":14780,"word":"子丑寅卯","pinyin":"zǐ chǒu yín mǎo","abbr":"zcym","explanation":"四个地支。多指事理。","source":{"text":"曰：‘如何是十二时？’师曰：‘子丑寅卯。’僧礼拜。师 示颂曰：‘十二时中那事别，子丑寅卯吾今说。若会唯心万法空，释迦、弥勒从兹决 。’","book":"宋·释普济《五灯会元》卷五"},"example":{"text":"他对此事说不出个子丑寅卯。"},"similar":["甲乙丙丁"],"usage":"作宾语；多指事理"},{"id":14781,"word":"子为父隐","pinyin":"zǐ wéi fù yǐn","abbr":"zwfy","explanation":"儿子为父亲隐瞒劣迹。","source":{"text":"闻子为父隐，父为子隐，未闻父子之相坐也。","book":"《论语·子路》：“孔子曰：‘吾党之直者异于是。父为子隐，子为父隐，直在其中矣。’” 汉·桓宽《盐铁论·周秦》"},"example":{"text":"以前，中国人讲究‘～，父为子隐’，于是隐来隐去，就把真理正义全隐得没有影儿了。","book":"老舍《老舍自传》第六章第三节"},"usage":"作谓语、宾语；指父子间的人情","story":["春秋时期，孔子带领弟子们周游列国，在叶邑停留时，叶公府中的一只羊跑进孔子的住地，被弟子曾点烧了吃。曾点的儿子曾参把这事报告给孔子，孔子知道曾参处于忠孝两难的地步，于是答应同叶公说，孔子感慨：“父为子隐，子为父隐，直在其中矣。”"]},{"id":14782,"word":"子夏悬鹑","pinyin":"zǐ xià xuán chún","abbr":"zxxc","explanation":"鹑：鹑鸟尾秃有如补绽百结。指子夏生活寒苦却不愿做官，衣服破烂打结，披在身上像挂着的鹑鸟尾一样。形容人衣衫褴褛，生活困顿却清高自持，安贫乐道。","source":{"text":"子夏家贫，衣若悬鹑。","book":"《荀子·大略》"}},{"id":14783,"word":"子女玉帛","pinyin":"zǐ nǚ yù bó","abbr":"znyb","explanation":"原指人民与财产。后用以泛指财物、美女。","source":{"text":"子女玉帛，则君有之；羽毛齿革，则君他生焉。","book":"《左传·僖工二十三年》"},"example":{"text":"于时北海完富，兰利其～，与群盗相应，破其本乡城邑。","book":"《旧唐书·薛万彻传》"},"similar":["子女金帛"],"usage":"作宾语、定语；用于书面语"},{"id":14784,"word":"子女金帛","pinyin":"zǐ nǚ jīn bó","abbr":"znjb","explanation":"子女：指年轻的男女奴婢。指人民和财物。也泛指财物、财产","source":{"text":"金贼所爱，惟子女金帛，志已骄惰。","book":"《宋史·岳飞传》"},"similar":["子女玉帛"],"usage":"作宾语、定语；用于书面语"},{"id":14785,"word":"子子孙孙","pinyin":"zǐ zǐ sūn sūn","abbr":"zzss","explanation":"子孙后裔；世世代代的意思。","source":{"text":"欲至于万年惟王，子子孙孙永保民。","book":"《书·梓材》"},"example":{"text":"造下十大功劳，指望～，世享富贵。","book":"明·冯梦龙《喻世明言》第三十一卷"},"similar":["子孙后代","世世代代"],"usage":"作主语、宾语、定语；指子孙后代"},{"id":14786,"word":"子孙后代","pinyin":"zǐ sūn hòu dài","abbr":"zshd","explanation":"一个祖先的直到最远一代的后裔。","source":{"text":"树活皮，人活脸，他金家的子孙后代都成了众人唾骂的对象！","book":"路遥《平凡的世界》第五卷第22章"},"example":{"text":"我们要对～负责。"},"similar":["子子孙孙"],"usage":"作主语、定语、宾语；指子子孙孙"},{"id":14787,"word":"子孙后辈","pinyin":"zǐ sūn hòu bèi","abbr":"zshb","explanation":"一个祖先的直到最远一代的后裔。","source":{"text":"要落实对原工商业者的政策，这也包括他们的子孙后辈。","book":"邓小平《搞建设要利用外资和发挥原工商业者的作用》"},"similar":["子孙后代"],"usage":"作主语、定语、宾语；指子子孙孙"},{"id":14788,"word":"子孝父慈","pinyin":"zǐ xiào fù cí","abbr":"zxfc","explanation":"儿女孝顺，父母慈爱。同“父慈子孝”。","source":{"text":"须是就君仁臣敬、子孝父慈与国人信上推究精微，各有不尽之理。","book":"《左传·隐公三年》：“君义、臣行、父慈、子孝、兄爱、弟敬，所谓六顺也。” 宋·朱熹《朱子语类》卷十六"},"example":{"text":"～，三分天下，二分归西，民乐安康，军心顺悦。","book":"明·陈仲琳《封神演义》第三十五回"}},{"id":14789,"word":"子承父业","pinyin":"zǐ chéng fù yè","abbr":"zcfy","explanation":"儿子继承父亲的事业。","source":{"text":"僧问：不历僧只获法身，请师直指。师云：子承父业。","book":"宋·释道原《景德传灯录·利山和尚》"},"example":{"text":"现代社会～的现象并不普遍。"},"similar":["子继父业"],"usage":"作谓语、宾语、定语；用于父子之间"},{"id":14790,"word":"子曰诗云","pinyin":"zǐ yuè shī yún","abbr":"zysy","explanation":"子：指孔子；诗：指《诗经》；曰、云：说。泛指儒家言论。","source":{"text":"我堪恨那伙老乔民，用这等小猢狲，但学得些妆点皮肤，子曰诗云。","book":"元·宫大用《范张鸡黍》第一折"},"example":{"text":"在我早如幼小时候所读过的‘～’一般，背不上半句了。","book":"鲁迅《呐喊·一件小事》"},"similar":["诗云子曰"],"usage":"作宾语、定语；泛指儒家言论"},{"id":14791,"word":"子母相权","pinyin":"zǐ mǔ xiāng quán","abbr":"zmxq","explanation":"子母：古代称钱币重的为母，轻的为子。比喻轻重并行，维持一定的平衡","source":{"text":"货币之重者、大者为母，轻者、小者为子。币轻物贵，推行重币以市贵物，称母权子；币重物轻，推行轻币以市贱物，亦不废重，称之权母。","book":"春秋·鲁·左丘明《国语·周语》"},"usage":"作宾语、定语；用于书面语"},{"id":14792,"word":"子皆豚犬","pinyin":"zǐ jiē tún quǎn","abbr":"zjtq","explanation":"豚：小猪。对人称自己儿子的谦词","source":{"text":"公见舟船器仗军伍整肃，喟然叹曰：‘生子当如孙仲谋，刘景升儿子若豚犬耳！’","book":"《吴历》"},"usage":"作宾语、定语；用于书面语"},{"id":14793,"word":"子继父业","pinyin":"zǐ jì fù yè","abbr":"zjfy","explanation":"儿子继承父亲的事业。","source":{"text":"使子继父业，弟承家祀，有何不可？","book":"南朝·宋·刘义庆《世说新语·品藻》"},"similar":["子承父业"],"usage":"作谓语、宾语、定语；用于父子之间"},{"id":14794,"word":"子罕辞宝","pinyin":"zǐ hǎn cí bǎo","abbr":"zhcb","explanation":"比喻拒绝接受别人的珍贵物品","source":{"text":"宋人得玉，献诸司城子罕，子罕弗收。献玉者曰：……子罕曰：‘我以不贪为宝，尔以玉为宝，若以与我，皆丧宝也，不若人有其宝。’","book":"春秋·鲁·左丘明《左传·襄公15年》"},"similar":["不贪为宝"],"usage":"作宾语、定语；用于书面语","story":["春秋时期，宋国有人在开凿石料时发现一块宝玉，请人鉴定是宝石，就抬到都城献给大臣子罕，子罕说如果给我，我们都失去了宝，我以不贪为宝。于是命人打磨宝玉到市场上卖掉，把钱交给宋人，派人护送他回家"]},{"id":14795,"word":"子虚乌有","pinyin":"zǐ xū wū yǒu","abbr":"zxwy","explanation":"子虚：并非真实；乌有：哪有。指假设的、不存在的、不真实的事情。","source":{"text":"楚使子虚使于齐，王悉发车骑，与使者出畋。畋罢，子虚过奼乌有先生，亡是公存焉。","book":"汉·司马相如著《子虚赋》"},"example":{"text":"文贵征实，不蕲于振奇，所以愧文士～之习也。","book":"清·沈惟贤《万国演义序》"},"similar":["捕风捉影","荒诞不经","海市蜃楼"],"opposite":["千真万确","铁证如山","勿庸置疑"],"usage":"作谓语、定语；指虚无","story":["西汉时期，司马相如写的《子虚赋》深得汉武帝的喜爱。《子虚赋》讲楚王派子虚去访问齐王。齐王率全国游猎能手陪同子虚外出打猎。子虚竭力向陪同的乌有先生吹嘘楚王的游猎盛况，故意贬低齐王。乌有先生立即替齐王辩驳，向子虚发难"]},{"id":14796,"word":"孑然一身","pinyin":"jié rán yī shēn","abbr":"jrys","explanation":"孑：单独。孤孤单单一个人。","source":{"text":"兼渠孑然一身，无所依倚，处性不能自立。","book":"《三国志·吴书·陆瑁传》：“若实孑然，无所凭赖，其畏怖远迸，或难卒灭。”宋·周煇《清波杂志》卷八"},"example":{"text":"只是公子～，又没盘缠，怎能够装载回去。","book":"明·冯梦龙《醒世恒言》卷二十七"},"similar":["孤苦伶仃"],"opposite":["成群结队"],"usage":"作谓语、宾语；形容孤单无靠"},{"id":14797,"word":"孑然无依","pinyin":"jié rán wú yī","abbr":"jrwy","explanation":"孤独一人，无依无靠。","source":{"text":"妻去来数月，而聘金又尽，左顾右盼，孑然无依，将自卖自身，而苦无主者。","book":"《剪灯新话·姚公子传》"},"example":{"text":"他～、孤苦伶仃。"},"similar":["孑然一身"],"usage":"作谓语、定语；指人很孤独无助"},{"id":14798,"word":"孔壁古文","pinyin":"kǒng bì gǔ wén","abbr":"kbgw","explanation":"相会在孔子住宅墙壁中发现的古文经书。今泛指古字或汉代以前的文字。","source":{"text":"武帝末，鲁共王坏孔子宅，欲以广其宫，而得古文《尚书》及《礼记》、《论语》、《孝经》，凡几十篇，皆古字也。","book":"《汉书·艺文志》"},"example":{"text":"～，汉大儒多见之。","book":"汉·扬雄《法言义疏》七"}},{"id":14799,"word":"孔孟之道","pinyin":"kǒng mèng zhī dào","abbr":"kmzd","explanation":"孔：孔子；孟：孟子。指儒家学说。","source":{"text":"松闻曹丞相文不明孔、孟之道，武不达孙、吴之机，专务强霸而居大位，安能有所教诲，以开发明公耶？","book":"明·罗贯中《三国演义》第60回"},"example":{"text":"～的大部分精华要好好继承与发扬光大。"},"similar":["儒家文化"],"usage":"作主语、宾语；指儒家思想"},{"id":14800,"word":"孔席不暖","pinyin":"kǒng xí bù nuǎn","abbr":"kxbn","explanation":"指孔子急于推行其道，到处奔走，每至一处，坐席未暖，又急急他往，不暇安居。","source":{"text":"是以圣哲之治，栖栖遑遑，孔席不暖，墨突不黔。","book":"东汉·班固《答宾戏》"},"similar":["墨突不黔"],"usage":"作宾语、定语；形容忙于世事","story":["春秋时期，大思想家孔子为了急于推行他的治国之道，经常到处游说。他四处奔走，每到一处经常是席子还未坐暖，又急忙赶往别的国家去，没有一个固定长住的住处。汉朝班固评价他为：“孔席不暖，墨突不黔。”"]},{"id":14801,"word":"孔席不暖，墨突不黔","pinyin":"kǒng xí bù nuǎn，mò tū bù qián","abbr":"kxbnmtbq","explanation":"原意是孔子、墨子四处周游，每到一处，坐席没有坐暖，灶突没有熏黑，又匆匆地到别处去了。形容忙于世事，各处奔走。","source":{"text":"是以圣哲之治，栖栖遑遑，孔席不暖，墨突不黔。","book":"《文子·自然》：“孔子无黔突，墨子无暖席。”汉·班固《答宾戏》"}},{"id":14802,"word":"孔席不适","pinyin":"kǒng xí bù shì","abbr":"kxbs","explanation":"指孔子急于推行其道，到处奔走，每至一处，坐席未暖，又急急他往，不暇安居。同“孔席不暖”。"},{"id":14803,"word":"孔席墨突","pinyin":"kǒng xí mò tū","abbr":"kxmt","explanation":"原意是孔子、墨子四处周游，每到一处，坐席没有坐暖，灶突没有熏黑，又匆匆地到别处去了。形容忙于世事，各处奔走。","source":{"text":"是以圣哲之治，栖栖遑遑，孔席不暖，墨突不黔。","book":"《淮南子·修务训》：“孔子无黔突，墨子无暖席。”汉·班固《答宾戏》"},"similar":["席不暇暖"],"usage":"作宾语、定语；形容忙于世事","story":["春秋战国时期，孔子为了鼓吹他的治国之道，经常到处游说。墨翟反对恃强欺弱的战争，呼吁平等互爱，经常奔走各个诸侯国，到处宣传他的“非战”主张。他四处奔走，从来没有一个固定长住的住处。汉朝班固评价他们为：“孔席不暖，墨突不黔。”"]},{"id":14804,"word":"孔怀之亲","pinyin":"kǒng huái zhī qīn","abbr":"khzq","explanation":"孔：甚、很；怀：思念。指兄弟间的亲情。","source":{"text":"死丧之威，兄弟孔怀。","book":"《诗经·小雅·常棣》"},"example":{"text":"辰不以闇浅，得因～，数与辂有所谘论。","book":"《三国志·魏志·管辂传》裴松之注引管辰叙言"}},{"id":14805,"word":"孔怀之重","pinyin":"kǒng huái zhī zhòng","abbr":"khzz","explanation":"孔：甚、很；怀：思念。指兄弟间的亲情。","source":{"text":"兄弟虽孔怀之重，然比于父子则轻，故生有异室，死有别宗。","book":"《诗经·小雅·常棣》：“死丧之威，兄弟孔怀。”《新唐书·敬播传》"},"example":{"text":"节韵已下，情深一往，不辨是花是人，读之令人增孔怀之重。","book":"清·况周颐《蕙风词话》卷三"}},{"id":14806,"word":"孔思周情","pinyin":"kǒng sī zhōu qíng","abbr":"kszq","explanation":"指儒学的思想、情懆。同“孔情周思”。"},{"id":14807,"word":"孔情周思","pinyin":"kǒng qíng zhōu sī","abbr":"kqzs","explanation":"指儒学的思想、情懆。孔，孔子；周，周公。"},{"id":14808,"word":"孔方兄","pinyin":"kǒng fāng xiōng","abbr":"kfx","explanation":"指钱。旧时铜钱中有方孔，所以这样称呼。","source":{"text":"钱之为体，有乾坤之象，内则其方，外则其圆。……故能长久，为世神宝。亲之如兄，字曰‘孔方’。","book":"晋·鲁褒《钱神论》"},"example":{"text":"管城子无食肉相，～有绝交书。","book":"宋·黄庭坚《戏呈孔毅父》"},"similar":["阿堵物"],"usage":"作主语、宾语、定语；指铜钱"},{"id":14809,"word":"孔武有力","pinyin":"kǒng wǔ yǒu lì","abbr":"kwyl","explanation":"孔：甚，很。形容人很有力气。","source":{"text":"羔裘豹饰，孔武有力，彼其之子，邦之司直。","book":"《诗经·郑风·羔裘》"},"example":{"text":"孜渐长，～，喜田猎，不务生产，乐斗好杀。","book":"清·蒲松龄《聊斋志异·鸦头》"},"similar":["勇猛有力"],"opposite":["软弱无力"],"usage":"作谓语、宾语、定语；形容人勇猛有力"},{"id":14810,"word":"孕大含深","pinyin":"yùn dà hán shēn","abbr":"ydhs","explanation":"孕：包涵。包含着博大精深的道理。","source":{"text":"于是乎孕大含深，贯微洞密，上下通而一气泰。","book":"唐·白居易《与元九书》"},"usage":"作谓语、定语；指文章或事理等"},{"id":14811,"word":"字夹风霜","pinyin":"zì jiā fēng shuāng","abbr":"zjfs","explanation":"夹：夹杂、搀杂。字句里夹杂着风霜。比喻文章森严而有力","source":{"text":"淮南王刘安著《鸿烈》二十一篇，鸿大也，烈明也，言大明礼教，号《淮南子》，一曰《刘安子》。自云：‘字中皆夹风霜。’","book":"晋·葛洪《西京杂记》"},"usage":"作宾语、定语；用于书面语"},{"id":14812,"word":"字字珠玉","pinyin":"zì zì zhū yù","abbr":"zzzy","explanation":"每一个字都像珍珠、宝玉那样珍贵值钱。形容文章作的好，声价高。","source":{"text":"听的黄榜招贤，尽把所赠资金，引动朝贵，则小生之文字字珠玉矣。","book":"明·汤显祖《邯郸记·赠试》"},"similar":["字字珠玑"],"usage":"作谓语、定语；用于书面语"},{"id":14813,"word":"字字珠玑","pinyin":"zì zì zhū jī","abbr":"zzzj","explanation":"珠：圆的珍珠；玑：不圆的珍珠。形容诗文语言精炼，每个字都像珍珠一样珍贵。","source":{"text":"听的黄榜招贤，尽把所赠金资，引动朝贵，则小生之文字字珠玉矣。","book":"明·汤显祖《邯郸记·赠试》"},"example":{"text":"谁知他外貌不足，内才有余，笔动时篇篇锦绣，墨走时～。","book":"清·刘璋《斩鬼传》第一回"},"similar":["一字千金","掷地有声","生花妙笔"],"opposite":["狗屁不通","诘屈聱牙"],"usage":"作谓语、定语、宾语；指说话或文章"},{"id":14814,"word":"字挟风霜","pinyin":"zì xié fēng shuāng","abbr":"zxfs","explanation":"比喻文笔褒贬森严。","example":{"text":"他写作～，十分犀利。"},"usage":"作谓语；指文章"},{"id":14815,"word":"字斟句酌","pinyin":"zì zhēn jù zhuó","abbr":"zzjz","explanation":"斟、酌：反复考虑。指写文章或说话时慎重细致，一字一句地推敲琢磨。","source":{"text":"宋儒积一生精力，字斟句酌，亦断非汉儒所及。","book":"清·纪昀《阅微草堂笔记》卷一"},"example":{"text":"他说话从不随随便便，而是～。"},"similar":["咬文嚼字","精雕细刻","精益求精"],"opposite":["离题万里"],"usage":"作谓语、宾语、状语；指慎重用词"},{"id":14816,"word":"字正腔圆","pinyin":"zì zhèng qiāng yuán","abbr":"zzqy","explanation":"形容吐字准确，唱腔圆熟。","source":{"text":"接着便也说了这一句谚语，字正腔圆，果然是道地的无锡话。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"他的字正腔圆的唱功让人佩服。"},"similar":["一唱三叹","余音绕梁"],"opposite":["南腔北调"],"usage":"作宾语、宾语、定语；指说话"},{"id":14817,"word":"字若涂鸦","pinyin":"zì ruò tú yā","abbr":"zrty","explanation":"涂鸦：比喻书法拙劣或胡乱写作。比喻书法拙劣、幼稚","source":{"text":"忽来案上翻墨汁，涂抹诗书如老鸦。","book":"唐·卢全《示添丁》诗"},"usage":"作宾语、定语；用于书面语"},{"id":14818,"word":"字里行间","pinyin":"zì lǐ háng jiān","abbr":"zlhj","explanation":"指文章的某种思想感情没有直接说出而是通过全篇或全段文字透露出来。","source":{"text":"垂示三首，风云吐于行间，珠玉生于字里。","book":"南朝梁·简文帝《答新渝侯和诗书》"},"example":{"text":"老弟上的条陈，第一要不拘成格，～，略带些古文气息，方能中肯。","book":"清·无名氏《官场维新记》第二回"},"similar":["言外之意","弦外之音","行间字里"],"usage":"作主语、宾语；指字句之间"},{"id":14819,"word":"字顺文从","pinyin":"zì shùn wén cóng","abbr":"zswc","explanation":"用词行文自然妥贴，表达清楚。","source":{"text":"其间独照之匠，若荆川、遵岩、震川，变秦汉为欧曾，易诘屈謷牙为字顺文从。","book":"清·陈田《〈明诗纪事戊签〉序》"},"example":{"text":"我为这篇～的文章而沾沾自喜"},"similar":["文从字顺"],"usage":"作谓语、定语；指文章用词妥贴通顺"},{"id":14820,"word":"存亡危急之秋","pinyin":"cún wáng wēi jí zhī qiū","abbr":"cwwjzq","explanation":"指生存、灭亡、危险、紧急的关键时刻。","source":{"text":"在存亡危急之秋，更不应计较过去的一切，而当与全国国民彻底更始，力谋团结，以保国家之生命与生存。","book":"毛泽东《国共合作成立后的迫切任务》"},"usage":"作宾语；指关键时刻"},{"id":14821,"word":"存亡安危","pinyin":"cún wáng ān wēi","abbr":"cwaw","explanation":"使将要灭亡的保存下来，使极其危险的安定下来。形容在关键时刻起了决定作用。","source":{"text":"功名之所就，存亡安危之所堕，必将于愉殷赤心之所。","book":"《荀子·王制》"},"similar":["生死存亡"],"usage":"作主语、宾语、定语；指在关键时刻起决定作"},{"id":14822,"word":"存亡有分","pinyin":"cún wáng yǒu fèn","abbr":"cwyf","explanation":"存：生存；亡：死亡；分：定分。人的生死、物的存亡各有定分。","source":{"text":"长短有命，存亡有分。","book":"《三国志·魏志·陈群传》"}},{"id":14823,"word":"存亡未卜","pinyin":"cún wáng wèi bǔ","abbr":"cwwb","explanation":"卜：猜测，估计。或是活着，或是死了，不能预测。","source":{"text":"况宗族远离，夫家存亡未卜，随缘快活，亦足了一生矣。","book":"明·冯梦龙《喻世明言》卷十七"},"example":{"text":"吾儿宾王不听贤侄之言，轻举妄动，以致合家离散，孙儿跟在军前，～。","book":"清·李汝珍《镜花缘》第十回"},"similar":["生死未卜"],"usage":"作谓语、定语；指生死未卜"},{"id":14824,"word":"存亡绝续","pinyin":"cún wáng jué xù","abbr":"cwjx","explanation":"绝：完结；续：延续。事物处在生存或灭亡、断绝或延续的关键时刻。形容局势万分危急。","source":{"text":"呜呼，太恭人以一女子，当金氏存亡绝续之交，一心惟鞠子为事。","book":"清·刘大櫆《金节母传》"},"example":{"text":"这六十年中，算是中国～的大关头。","book":"清·梁启超《新中国未来记》第一回"},"similar":["存亡继绝"],"usage":"作谓语、定语；形容局势万分危急"},{"id":14825,"word":"存亡继绝","pinyin":"cún wáng jì jué","abbr":"cwjj","explanation":"存：保存；继：接续。恢复灭亡的国家，延续断绝了的贵族世家。","source":{"text":"桓公尝有继绝存亡之功，故君子为之讳也。","book":"《论语·尧曰》：“兴灭国，继绝世，举逸民，天下之民归心焉。”《公羊传·僖公十七年》"},"example":{"text":"他是要明王道，辨人事，分明是非善恶不肖，～，补敝起废，作后世君臣龟鉴。","book":"朱自清《经典常谈·史记汉书第九》"},"similar":["存亡续绝"],"usage":"作谓语、定语；使濒临灭亡者得以延续"},{"id":14826,"word":"存亡续绝","pinyin":"cún wáng xù jué","abbr":"cwxj","explanation":"存：保存；续：接续。恢复灭亡的国家，延续断绝了的贵族世家。","source":{"text":"天生孔子不后周，不先周也，存亡续绝，俾枢纽也。","book":"清·龚自珍《古史钩沉论二》"},"similar":["存亡绝续"],"usage":"作谓语、定语；形容局势万分危急"},{"id":14827,"word":"存十一于千百","pinyin":"cún shí yī yú qiān bǎi","abbr":"csyyqb","explanation":"指亡多而存少。","source":{"text":"顾旧要于遗存，得十一于千百。","book":"语出晋·陆机《叹逝赋》"},"example":{"text":"而今学者尚知宗孔氏、崇仁义、贵王贱霸而已，其大经大法皆亡灭而不救、坏烂而不收，所谓～，安在其能廓如也！","book":"唐·韩愈《与孟尚书书》"},"similar":["得十一于千百"],"usage":"作宾语、定语；用于书面语"},{"id":14828,"word":"存心不良","pinyin":"cún xīn bù liáng","abbr":"cxbl","explanation":"存心：怀着某种心思或打算。指存着坏心眼。","source":{"text":"他不服查账，非但是有弊病，一定是存心不良的了。","book":"清·吴趼人《二十年目睹之怪现状》第106回"},"example":{"text":"他在这件事上一直～的。"},"similar":["居心叵测","居心不良"],"opposite":["心地善良"],"usage":"作谓语、定语；指人的心眼"},{"id":14829,"word":"存心养性","pinyin":"cún xīn yǎng xìng","abbr":"cxyx","explanation":"保存赤子之心，修养善良之性。旧时儒家宣扬的修养方法。","source":{"text":"存其心，养其性，所以事天也。","book":"《孟子·尽心上》"},"example":{"text":"释氏只令人到知天处休了，更无～事天也。","book":"《二程全书·外书十二》"},"similar":["修心养性"],"usage":"作谓语、定语；指修心养性"},{"id":14830,"word":"存心积虑","pinyin":"cún xīn jī lǜ","abbr":"cxjl","explanation":"指长期、一贯的思想、想法。","source":{"text":"社稷之臣可使死宗庙，郡县之臣可使死封疆，文吏可使死其职，武吏可使死其兵，天下之人，其存心积虑，皆以为当然，是以寇至而不惧，难生而无变。","book":"宋·苏辙《进策五道·臣事下》第三道"},"usage":"作谓语、宾语；用于思想等"},{"id":14831,"word":"存恤耆老","pinyin":"cún xù qí lǎo","abbr":"cxql","explanation":"恤：救济；存恤：慰问救济；耆：古称六十岁为耆；耆老：指年老的人。慰问救济年老的人。","source":{"text":"蒙旦暮使亲近存恤耆老，问所不足，疾病者给医药，饥寒者赐衣粮。","book":"《三国志·魏志·吕蒙传》"}},{"id":14832,"word":"存神索至","pinyin":"cún shén suǒ zhì","abbr":"cssz","explanation":"存神：保养精神；索至：寻找事物深奥的道理。旧指品德高尚的人注重保养精神，以探寻事物深奥的道理。","source":{"text":"圣人存神索至。","book":"汉·扬雄《法言·问神》"}},{"id":14833,"word":"存而不议","pinyin":"cún ér bù yì","abbr":"ceby","explanation":"存：保留；议：讨论。指把问题保留下来，暂不讨论。","source":{"text":"后代揭厉于玄踪者，聆其风而骇之，或谓诙诡不经，存而不议。","book":"唐·独孤及《仙掌铭并序》"},"similar":["存而不论"],"usage":"作谓语、宾语；指暂时不讨论的问题"},{"id":14834,"word":"存而不论","pinyin":"cún ér bù lùn","abbr":"cebl","explanation":"存：保留。指把问题保留下来，暂不讨论。","source":{"text":"六合之外，圣人存而不论。","book":"《庄子·齐物论》"},"example":{"text":"其源虽出于《洪范》，然既为术数之学，则治经者～可矣。","book":"清·陈澧《东塾读书记·尚书》"},"similar":["姑置勿论","避而不谈"],"opposite":["无所不谈"],"usage":"作谓语、宾语；指暂时不讨论的问题"},{"id":14835,"word":"存荣没哀","pinyin":"cún róng mò āi","abbr":"crma","explanation":"存：生存；荣：光耀；哀：悲伤。活着受人尊敬，死后令人哀痛。","source":{"text":"斯可谓存荣没哀，死而不朽者矣。","book":"汉·蔡邕《陈太丘碑文》"},"similar":["生荣死哀","生荣没哀"],"usage":"作宾语、定语；用于生前名望高的人"},{"id":14836,"word":"孙庞斗智","pinyin":"sūn páng dòu zhì","abbr":"spdz","explanation":"孙：孙膑；庞：庞涓。孙膑、庞涓各以智谋争斗。比喻昔日友人今为仇敌，各逞计谋生死搏斗。也比喻双方用计较量高下。","source":{"text":"《史记·孙子吴起列传》"},"example":{"text":"宁学管鲍分金，休仿～。","book":"明·吴承恩《西游记》第八十一回"},"similar":["钩心斗角"],"usage":"作宾语、定语；指钩心斗角","story":["战国时期，兵法大师鬼谷子的弟子庞涓设计让魏王残害他的师弟孙膑。被砍了双腿的孙膑逃到齐国做大将田忌的军师。魏王派庞涓去攻打赵国。田忌采纳孙膑的围魏救赵、减灶计，迫使庞涓撤军并追至马陵道齐军的埋伏圈自杀身亡"]},{"id":14837,"word":"孙康映雪","pinyin":"sūn kāng yìng xuě","abbr":"skyx","explanation":"比喻读书非常刻苦。","source":{"text":"孙康家贫，常映雪读书，清介，交游不杂。","book":"《艺文类聚》卷二"},"similar":["囊萤映雪"],"usage":"作宾语、定语；指勤奋读书","story":["晋代孙康因为家贫没钱买灯油，晚上不能看书，他觉得非常可惜，白白地浪费光阴。一天外面下起了很大的雪，半夜梦醒，见一丝亮光从窗缝里钻进来，原来是大雪映出来的，他起身对着亮光看起书来。经过他刻苦努力终于成为饱学之士"]},{"id":14838,"word":"孚尹旁达","pinyin":"fú yǐn páng dá","abbr":"fypd","explanation":"指玉的色彩晶莹发亮，比喻品德高尚纯洁。","source":{"text":"瑕不掩瑜，瑜不掩瑕，忠也；孚尹旁达，信也。","book":"三国·魏·王肃《孔子家语·问玉》"},"example":{"text":"不可犯干，暗然躬行，～。","book":"清·钱谦益《吴中名贤表扬续议》"},"similar":["孚尹明达"],"usage":"作谓语、分句；指人的品德"},{"id":14839,"word":"孚尹明达","pinyin":"fú yǐn míng dá","abbr":"fymd","explanation":"指玉的色彩晶莹发亮，比喻品德高尚纯洁。同“孚尹旁达”。","source":{"text":"公孚尹明达，既早慧，长益贯研古今，出其英华，皆有新意。","book":"宋·叶適《中奉大夫尚书工部侍郎曾公墓志铭》"},"similar":["孚尹旁达"],"usage":"作谓语、分句；指人的品德"},{"id":14840,"word":"孜孜不倦","pinyin":"zī zī bù juàn","abbr":"zzbj","explanation":"孜孜：勤勉，不懈怠。指工作或学习勤奋不知疲倦。","source":{"text":"乃更潜心典籍，孜孜不倦。","book":"《尚书·君陈》：“惟日孜孜，无敢逸豫。”《后汉书·鲁丕传》：“性沉深好学，孳孳不倦。”《三国志·蜀书·向朗传》"},"example":{"text":"他长年累月～地工作。"},"similar":["废寝忘食","不辞劳苦","摩顶放踵"],"opposite":["游手好闲","饱食终日","无所事事"],"usage":"作谓语、状语；指勤奋","story":["远古时期，洪水滔天，百姓流离失所，禹奉命带人打猎把兽肉分给百姓吃，又带领大家疏通沟渠江河，把大水引入海中。还教导人们播种庄稼，让人们按需要交换物资，使天下太平。禹对舜帝说：“予思日孜孜。”"]},{"id":14841,"word":"孜孜不已","pinyin":"zī zī bù yǐ","abbr":"zzby","explanation":"勤勉从事，努力专一，不肯停歇","source":{"text":"故乱则统其理，危则致其安，祸则引其福，绝则接其继，幼则代其任，夙夜孜孜不已，凡以为天下厚刘氏也。","book":"汉·荀悦《汉纪·平帝纪》"},"example":{"text":"《隋书·杨素传》：“以为阴阳之书，圣人所作，祸福之理，特须审慎。乃遍历川原，亲自占择，纤介不善，即更寻求，志图元吉，～。”"},"similar":["孜孜不辍"],"usage":"作谓语、状语；用于处事"},{"id":14842,"word":"孜孜不怠","pinyin":"zī zī bù dài","abbr":"zzbd","explanation":"勤勉努力，毫不懈怠。","source":{"text":"今圣汉受命而王，继体承业二百余年，孜孜不怠，政令清矣。","book":"《汉书·平当传》"},"example":{"text":"臣事先帝三十年，观其延接疏远，～，下情犹有不通者。","book":"宋·司马光《资治通鉴》卷第二百八十三"},"similar":["孜孜不倦","孜孜不息","孜孜不懈"],"usage":"作谓语、状语；指勤奋"},{"id":14843,"word":"孜孜不息","pinyin":"zī zī bù xī","abbr":"zzbx","explanation":"孜孜：勤勉的样子。指勤奋努力，不知疲倦","source":{"text":"像他这样孜孜不息、力求精进的人，既成者业已大有可砚，将来的成就更是未可限量的。","book":"郭沫若《题画记》"},"similar":["孜孜不倦","孜孜不懈","孜孜不怠"],"usage":"作谓语、定语、状语；指勤奋"},{"id":14844,"word":"孜孜不懈","pinyin":"zī zī bù xiè","abbr":"zzbx","explanation":"勤勉努力，毫不懈怠。","source":{"text":"虽所历必尽精力，夙夜孜孜不懈，然未有赫赫报国之迹，为天下所共闻而称道者。","book":"宋·苏舜钦《上京兆杜公书》"},"example":{"text":"他～地学习，终于取得了博士学位"},"similar":["孜孜不怠","孜孜不息","孜孜不倦"],"usage":"作谓语、状语；指勤奋"},{"id":14845,"word":"孜孜不辍","pinyin":"zī zī bù chuò","abbr":"zzbc","explanation":"勤勉从事，努力专一，不肯停息。","source":{"text":"师事刘述，常在师门，布衣徒行，讲诵孜孜不辍。","book":"《东观汉记·邓弘传》"},"example":{"text":"敦复字德本，事亲孝，为吏廉，种学绩文，～，见书必传，其家所藏，往往皆是手自抄者。","book":"宋·朱弁《曲洧旧闻》卷七"},"similar":["孜孜不已"],"usage":"作谓语、状语；用于处事"},{"id":14846,"word":"孜孜以求","pinyin":"zī zī yǐ qiú","abbr":"zzyq","explanation":"孜孜：勤勉的样子。不知疲倦地探求。","example":{"text":"他对真理有～的精神。"},"usage":"作谓语、宾语；指人学习的态度"},{"id":14847,"word":"孜孜无倦","pinyin":"zī zī wú juàn","abbr":"zzwj","explanation":"勤奋努力，不知疲倦。","source":{"text":"泰博览篇籍，好为文章，爱奖后生，孜孜无倦。","book":"《南史·范泰传》"},"similar":["孜孜不倦","孜孜无怠","孜孜不怠"],"usage":"作谓语、定语、状语；指勤奋"},{"id":14848,"word":"孜孜无怠","pinyin":"zī zī wú dài","abbr":"zzwd","explanation":"勤勉努力，毫不懈怠。","source":{"text":"贵而好礼，怡寄典坟，虽牵以物役，孜孜无怠，乃撰《四部要略》。","book":"南朝·梁·任昉《齐竟陵文宣王行状》"},"example":{"text":"[梁武帝]勤于政务，～。每冬月四更竟，即敕把烛看事，执笔触寒，手为皴裂。","book":"《南史·梁纪中·武帝下》"},"similar":["孜孜不倦","孜孜不怠","孜孜不息"],"usage":"作谓语、定语、状语；指勤奋"},{"id":14849,"word":"孜孜汲汲","pinyin":"zī zī jí jí","abbr":"zzjj","explanation":"心情急切、勤勉不懈的样子。","source":{"text":"陛下可不追鉴往事，惟新令图，循偏废之柄以靖人，复倒持之权以固国！而乃孜孜汲汲，极思劳神，循无已之求，望难必之效。","book":"唐·陆贽《论关中事宜状》"},"similar":["孜孜矻矻","孳孳汲汲"],"usage":"作定语、状语；用于书面语"},{"id":14850,"word":"孜孜矻矻","pinyin":"zī zī kū kū","abbr":"zzkk","explanation":"勤勉不懈的样子。","source":{"text":"自古圣人贤士皆非有求于闻用也，闵其时之不平，人之不乂，得其道，不敢独善其身，而必以廉济天下也，孜孜矻矻，死而后已。","book":"唐·韩愈《争臣论》"},"example":{"text":"其未成书有《读史汇说》若干卷，～，导原植根，推而放之，充如也。","book":"清·魏源《婺源王君墓表》"},"similar":["孜孜汲汲","孳孳矻矻","孳孳汲汲"],"usage":"作定语、状语；用于书面语"},{"id":14851,"word":"孜孜砽砽","pinyin":"zī zī kū kū","abbr":"zzkk","explanation":"勤勉不懈的样子。","source":{"text":"自古圣人贤士皆非有求于闻用也，闵其时之不平，人之不乿，得其道，不敢独善其身，而必以廉济天下也，孜孜砽砽，死而后已。","book":"唐·韩愈《争臣论》"},"quote":{"text":"其未成书有《读史汇说》若干卷，～，导原植根，推而放之，充如也。","book":"清·魏源《婺源王君墓表》"}},{"id":14852,"word":"孝子慈孙","pinyin":"xiào zǐ cí sūn","abbr":"xzcs","explanation":"对祖先孝顺的子孙。","source":{"text":"名之曰‘幽’、‘厉’，虽孝子慈孙，百世不能改也。","book":"战国·邹·孟轲《孟子·离娄上》"},"example":{"text":"祖宗虽没了，然而～，追远起来，便如在其上。","book":"清·吴趼人《二十年目睹之怪现状》第25回"},"similar":["孝子贤孙"],"opposite":["不肖子孙"],"usage":"作主语、宾语；指对父母、祖先孝顺的子孙"},{"id":14853,"word":"孝子爱日","pinyin":"xiào zǐ ài rì","abbr":"xzar","explanation":"指珍惜与父母共处的岁月，能及时行孝。","source":{"text":"事父母自知不足者，其舜乎？不可得而久者，事亲之谓也。孝子爱日。","book":"汉·扬雄《法言·孝至》"},"usage":"作宾语、定语；用于书面语"},{"id":14854,"word":"孝子贤孙","pinyin":"xiào zǐ xián sūn","abbr":"xzxs","explanation":"指孝顺父母的儿子，有德行的孙子。现比喻忠实继承某种主张或旧传统思想的人","source":{"text":"虽孝子慈孙，百世不能改也。","book":"《孟子·离娄上》"},"example":{"text":"我死后别无遗言，惟属后世子孙，千万莫把绿林习气改了，那才是～哩。","book":"清·李汝珍《镜花缘》第五十一回"},"similar":["孝子慈孙"],"opposite":["不孝之子"],"usage":"作主语、宾语；指对父母、祖先孝顺的子孙"},{"id":14855,"word":"孝子顺孙","pinyin":"xiào zǐ shùn sūn","abbr":"xzss","explanation":"指孝顺父母的儿子，有德行的孙子。","source":{"text":"吾欲言死者有知也，恐孝子顺孙妨生以送死也。","book":"西汉·刘向《说苑·辨物》"},"example":{"text":"这又和扫墓救国说相反，很伤～的心了。","book":"鲁迅《花边文学·清明时节》"},"similar":["孝子贤孙"],"opposite":["不肖子孙"],"usage":"作宾语；指对父母、祖先孝顺的子孙"},{"id":14856,"word":"孝思不匮","pinyin":"xiào sī bù kuì","abbr":"xsbk","explanation":"匮：缺乏。指对父母行孝道的心思时刻不忘。","source":{"text":"孝子不匮，永锡尔类。","book":"《诗经·大雅·既醉》"},"example":{"text":"还是你的～，原该如此。但此刻正是沿途大水，车断走不得。","book":"清·文康《儿女英雄传》第三回"},"usage":"作宾语、定语；用于书面语"},{"id":14857,"word":"孝悌力田","pinyin":"xiào tì lì tián","abbr":"xtlt","explanation":"指孝顺父母，尊敬兄长，努力务农。","source":{"text":"其遣谒者劳赐三老、孝者帛人五匹，悌者、力田二匹……以户口率置三老孝悌力田常员。","book":"《汉书·文帝纪》"},"example":{"text":"清·李汝珍《镜花缘》第23回：“门首都竖着金字匾额，也有写着‘贤良方正’的，也有写着‘～’的。”"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":14858,"word":"孝悌忠信","pinyin":"xiào tì zhōng xìn","abbr":"xtzx","explanation":"指孝顺父母，尊敬兄长，忠于君主，取信于朋友的封建社会的应具备的道德标准。","source":{"text":"凡遇人，只劝人以‘孝悌忠信’四字。","book":"明·周楫《西湖二集·祖统制显灵救驾》"},"example":{"text":"人以～是教，家惟礼义廉耻是尚。","book":"清·西周生《醒世姻缘传》第二十三回"},"usage":"作主语、宾语、定语；用于处世等"},{"id":14859,"word":"孝经起序","pinyin":"xiào jīng qǐ xù","abbr":"xjqx","explanation":"《孝经·序》有“具载则文繁，略之则义阙”等文。比喻遇事左右为难，感到棘手。","source":{"text":"泪点儿多如秋夜雨，烦恼如孝经起序。","book":"元·无名氏《寿阳曲》"},"usage":"作宾语；用于比喻句"},{"id":14860,"word":"孟公投辖","pinyin":"mèng gōng tóu xiá","abbr":"mgtx","explanation":"孟公：西汉陈遵的字；辖：安在车轴末端的挡铁。原指陈遵强留客人陪他饮酒。后形容喜酒好客，情真意笃。","source":{"text":"遵嗜酒，每大饮，宾客满堂，辄关门，取客车辖投井中，虽有急，终不得去。","book":"《汉书·游侠传·陈遵》"},"example":{"text":"若见～饮，莫忘冲雪送君时。","book":"宋·苏轼《送赵寺丞寄陈海洲》"}},{"id":14861,"word":"孟嘉落帽","pinyin":"mèng jiā luò mào","abbr":"mjlm","explanation":"孟嘉：东晋时大将军恒温的参军。形容才思敏捷，洒脱有风度。","source":{"text":"有风到至，吹嘉帽堕落，嘉不知觉。温使左右勿言，欲观其举止。嘉良久如厕，温令取还之，命孙盛作文嘲嘉，著嘉坐处。嘉还见，即答之，其文甚美，四坐嗟叹。","book":"《晋书·孟嘉传》"},"example":{"text":"～，前世以为胜绝。","book":"宋·陈师道《后山诗话》"}},{"id":14862,"word":"孟母三迁","pinyin":"mèng mǔ sān qiān","abbr":"mmsq","explanation":"孟轲的母亲为选择良好的环境教育孩子，三次迁居。形容家长教子有方。","source":{"text":"孟子生有淑质，幼被慈母三迁之教。","book":"汉·赵歧《孟子题词》"},"example":{"text":"他背熟的的班姬《四诫》从头学，不要得～把气淘。","book":"明·汤显祖《牡丹亭》第二十出"},"similar":["三迁之教"],"usage":"作宾语、定语；指为了孩子的教育","story":["战国时期，孟子小时候非常聪明，经常模仿送葬人吹喇叭，孟母担心他荒废学业就把家搬到城里，刚好旁边是一个屠宰场，孟子很快就学会了杀猪宰羊，孟母只好搬家到一个学校附近，从此孟子就开始学习孔子的思想而成为一代思想家"]},{"id":14863,"word":"孟诗韩笔","pinyin":"mèng shī hán bǐ","abbr":"mshb","explanation":"孟郊的诗，韩愈的文笔。指诗文佳作。","source":{"text":"韩文公与孟东野友善，韩公文至高，孟子长五言，时号孟诗韩笔。","book":"唐·赵璘《因话录》第三卷"},"usage":"作宾语、定语；用于称赞文章等"},{"id":14864,"word":"季伦锦障","pinyin":"jì lún jǐn zhàng","abbr":"jljz","explanation":"季伦：晋代石崇的字；障：遮蔽风尘或视线的一种屏障。比喻夸耀富有。","source":{"text":"季伦锦障，春申珠履。","book":"《晋书·石崇传》记载：石崇与巨富王恺斗富，王恺“作紫丝步障四十里”，石崇“作锦步障五十里以敌之。”唐·王瀚《蒙求》"}},{"id":14865,"word":"季友伯兄","pinyin":"jì yǒu bó xiōng","abbr":"jybx","explanation":"比喻交情深，义气重。","source":{"text":"交深季作友，义重伯为兄。","book":"唐·宋之问《饯湖州薛司马》诗"}},{"id":14866,"word":"季孙之忧","pinyin":"jì sūn zhī yōu","abbr":"jszy","explanation":"季孙：鲁国大夫；忧：忧患。指内部的忧患。","source":{"text":"吾恐季孙之忧，不在颛臾，而在萧墙之内也。","book":"春秋·鲁·孔丘《论语·季氏》"},"example":{"text":"否则，‘吾恐～，不在颛臾，而在萧墙之内也。’","book":"毛泽东《为皖南事变发表的命令和谈话》"},"similar":["祸起萧墙"],"usage":"作宾语；指内忧","story":["春秋时期，鲁国大夫季康子为巩固自己的统治权力，想攻打附近的颛臾国。但拿不定主意，就找孔子的学生冉有和子路，他们问孔子该如何处理。孔子说：“治理一国不能使百姓安居乐业，国内处于分崩离析的状态，恐怕要祸起萧墙了。”"]},{"id":14867,"word":"季孟之间","pinyin":"jì mèng zhī jiān","abbr":"jmzj","explanation":"这里指春秋时鲁国三家大贵族中势力最大的季氏和势力最弱的孟氏。指在季、孟两者之间，比上不足，比下有余。","source":{"text":"齐景公待孔子曰：‘若季氏，则吾不能；以季孟之间待之。’","book":"《论语·微子》"},"example":{"text":"吾亳州牡丹，年来浸盛，娇容三变，尤在～。","book":"明·夏之臣《评亳州牡丹》"},"similar":["伯仲之间"],"usage":"作宾语；用于比较","story":["春秋时期，鲁国大贵族孟孙、叔孙、季孙三家为鲁国三卿，势力很大。鲁国内乱，鲁昭公逃到齐国，孔子也到齐国去。齐景公对孔子的儒家观点很感兴趣，由于齐大夫晏婴不赞同孔子的观点。在招待孔子的问题上，齐景公让按季孙孟孙之间的待遇"]},{"id":14868,"word":"季布一诺","pinyin":"jì bù yī nuò","abbr":"jbyn","explanation":"季布：人名，很讲信用，从不食言。季布的承诺。比喻极有信用，不食言。","source":{"text":"得黄金百斤，不如得季布一诺。","book":"西汉·司马迁《史记·季布栾布列传》"},"example":{"text":"昔聂政一言而破面自决，～而千金不移。","book":"明·陆采《明珠记·吐衷》"},"similar":["一诺千金"],"usage":"作主语、宾语；指守信重诺","story":["秦末汉初楚国人季布，楚汉战争中做过项羽的大将，后来归顺西汉高祖刘邦，担任河东太守，一生特别讲信用，只要答应办的事情就一定要办到，从没有失信于人。他以侠义闻名，重守诺言，因此人们常说：“得黄金百斤，不如得季布一诺。”"]},{"id":14869,"word":"季常之惧","pinyin":"jì cháng zhī jù","abbr":"jczj","explanation":"指惧内。","source":{"text":"宋陈慥，字季常，其妻柳氏凶悍而好嫉妒，陈慥颇为惧怕。事见宋·洪迈《容斋三笔·陈季常》。"},"example":{"text":"[杨万石]生平有～。妻尹氏，奇悍，少迕之，辄以鞭挞从理……万石惧，长跽床下。","book":"清·蒲松龄《聊斋志异·马介甫》"},"similar":["河东狮吼"],"usage":"作宾语；指怕老婆","story":["苏轼被贬至黄州，常与好友陈季常一起谈论文学。陈季常很好客，经常邀客人到家里，他的妻子是河东郡柳氏经常敲墙赶客，苏轼作诗“龙邱居士亦可怜，谈空说有夜不眠，忽闻河东狮子吼，柱杖落手心茫然。”笑陈季常怕老婆"]},{"id":14870,"word":"季常之癖","pinyin":"jì cháng zhī pǐ","abbr":"jczp","explanation":"宋朝人陈糙，字季常，他的妻子柳氏脾气暴躁，醋性很大，陈很怕她。后称人怕老婆就说有“季常之癖”。","source":{"text":"宋·洪迈《容斋三笔·陈季常》"},"similar":["季常之惧"],"usage":"作宾语；指人怕老婆"},{"id":14871,"word":"季礼挂剑","pinyin":"jì lǐ guà jiàn","abbr":"jlgj","explanation":"季礼：春秋时吴国人，重信义。比喻重信义的美德。","source":{"text":"还至徐，徐君已死。于是乃解其宝剑，系之徐君冢树而去。从者曰：‘徐君已死，尚谁予乎？’季子曰：‘不然。始吾心已许之，岂以死倍吾心哉！’","book":"《史记·吴太伯世家》"}},{"id":14872,"word":"季路一言","pinyin":"jì lù yī yán","abbr":"jlyy","explanation":"比喻信用极好。","source":{"text":"千乘之国，不信其盟，而信子之言，子何辱焉？","book":"《左传·哀公十四年》"},"example":{"text":"此事君亲见之，惟～，无他言也。","book":"清·蒲松龄《聊斋志异·李伯言》"},"similar":["季布一诺","一言九鼎"],"usage":"作宾语、定语；用于为人"},{"id":14873,"word":"孤云野鹤","pinyin":"gū yún yě hè","abbr":"gyyh","explanation":"空中独自飘动的浮云，旷野任意漫游的仙鹤。旧指闲散自在，不求名利的人。","source":{"text":"孤云将野鹤，岂向人间住。","book":"唐·刘长卿《送方外上人》诗"},"example":{"text":"～，栖无定所，别后幸复顽健。","book":"清·蒲松龄《聊斋志异·成仙》"},"usage":"作宾语；比喻不求名利的人"},{"id":14874,"word":"孤俦寡匹","pinyin":"gū chóu guǎ pǐ","abbr":"gcgp","explanation":"指孤独无伴侣。","source":{"text":"恳乞恁途中同情体恤；念背井离乡，孤俦寡匹。","book":"明·沈鲸《双珠记·从军别意》"},"similar":["形单影只"],"usage":"作宾语、定语；用于书面语"},{"id":14875,"word":"孤傲不群","pinyin":"gū ào bù qún","abbr":"gabq","explanation":"孤：孤单；傲：高傲。指高傲孤僻，难与人相处。","example":{"text":"他就是这种～的性格。"},"usage":"作谓语、定语；指人的性格"},{"id":14876,"word":"孤儿寡妇","pinyin":"gū ér guǎ fù","abbr":"gegf","explanation":"死了父亲的孩子，死了丈夫的妇女。泛指失去亲人，无依无靠者。","source":{"text":"孤子寡妇，寒心酸鼻。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"司马仲达父子，欺他～，狐媚以取天下也。","book":"《晋书·石勒载记》"},"similar":["孤儿寡母","孤子寡妇"],"usage":"作宾语、定语；指失去男主人无助的妻子儿女"},{"id":14877,"word":"孤儿寡母","pinyin":"gū ér guǎ mù","abbr":"gegm","explanation":"指男子死后遗留的孩子和妇女。","source":{"text":"大丈夫行事，当磊磊落落，如日月皎然，终不能如曹孟德、司马仲达父子，欺他孤儿寡妇，狐媚以取天下也。","book":"《晋书·石勒载记》"},"example":{"text":"路遥《平凡的世界》第四卷第39章：“对于～来说，没有什么能比得上一个男人的关怀更重要了……”"},"similar":["孤儿寡妇","孤子寡妇"],"usage":"作宾语、定语；指失去男主人无助的妻子儿女"},{"id":14878,"word":"孤军作战","pinyin":"gū jūn zuò zhàn","abbr":"gjzz","explanation":"孤立无援的军队单独奋战。比喻单独办事，没有人支援。","source":{"text":"由是长儒孤军奋战，死者十八九。","book":"《隋书·虞庆则传》"},"example":{"text":"我们已经脱离了过去那种慢慢发展的～的情况。","book":"《毛泽东选集·中国革命战争的战略问题》"},"similar":["孤立无援"],"opposite":["同仇敌忾"],"usage":"作谓语；用于军事上"},{"id":14879,"word":"孤军奋战","pinyin":"gū jūn fèn zhàn","abbr":"gjfz","explanation":"奋战：尽全力地战斗。孤立无助的军队单独对敌作战。也比喻一个人或一个集体无人支援、帮助的情况下努力从事某项斗争。","source":{"text":"由是长儒孤军独战，死者十八九。","book":"《隋书·虞庆则传》"},"example":{"text":"～的艰苦局面带来了重重困难。","book":"罗广斌《红岩》第29章"},"similar":["孤军深入"],"opposite":["同仇敌忾"],"usage":"作谓语、宾语；指单独作战"},{"id":14880,"word":"孤军深入","pinyin":"gū jūn shēn rù","abbr":"gjsr","explanation":"孤立无援的军队深入到敌作战区。","source":{"text":"瑱等以敦孤军深入，规欲取之。","book":"《周书·贺若敦传》"},"example":{"text":"《周书·贺若敦传》：“瑱等以敦孤军深入，规欲取之。”"},"similar":["悬军深入"],"usage":"作谓语、宾语；指孤军作战"},{"id":14881,"word":"孤军独战","pinyin":"gū jūn dú zhàn","abbr":"gjdz","explanation":"孤：单独。孤立无助的军队单独对敌作战。比喻一个人或一个组织在无援的情况下从事某项工作。","source":{"text":"由是长儒孤军独战，死者十八九。","book":"《隋书·虞庆则传》"},"similar":["孤军奋战","孤军作战"],"usage":"作谓语、宾语、定语；指单独作战"},{"id":14882,"word":"孤军薄旅","pinyin":"gū jūn bó lǚ","abbr":"gjbl","explanation":"孤军：单独的一支军队；薄：少。指势力孤弱的军队或其他力量。","example":{"text":"敌人想欺我～，我们不能坐以待毙。"},"usage":"作主语、宾语、定语；用于口语"},{"id":14883,"word":"孤子寡妇","pinyin":"gū zǐ guǎ fù","abbr":"gzgf","explanation":"指男子死后遗留的孩子和妇女。","source":{"text":"孤子寡妇，寒心酸鼻。","book":"战国·楚·宋玉《高堂赋》"},"similar":["孤儿寡妇","孤儿寡母"],"usage":"作宾语、定语；指失去男主人无助的妻子儿女"},{"id":14884,"word":"孤孤单单","pinyin":"gū gū dān dān","abbr":"ggdd","explanation":"单身无靠，感到寂寞。","source":{"text":"想我张广泰也不能归家，也不能与红玉相见，孤孤单单，冷冷清清，不知终身该当如何？","book":"清·姜振名《永庆升平前传》第30回"},"example":{"text":"这里就是他～的一个人。"},"similar":["孤苦伶仃","伶伶仃仃"],"opposite":["人多势众"],"usage":"作谓语、定语；指单一"},{"id":14885,"word":"孤孤恓恓","pinyin":"gū gū xī xī","abbr":"ggxx","explanation":"孤独恓惶。","example":{"text":"他的晚年过得～。"},"similar":["孤独恓惶"],"usage":"作谓语、定语、状语；用于人的境遇"},{"id":14886,"word":"孤孤零零","pinyin":"gū gū líng líng","abbr":"ggll","explanation":"指人或事物孤单无依靠。","source":{"text":"又孤孤零零的四下里走了一回，又呜呜咽咽的倚着栏杆，哭了半晌。","book":"清·褚人获《隋唐演义》第28回"},"example":{"text":"清·无名氏《刘公案》第28回：“原来是～一间小庙，四面并无裙墙。”"},"similar":["孤孤单单"],"usage":"作定语、宾语、状语；用于人或事物"},{"id":14887,"word":"孤学坠绪","pinyin":"gū xué zhuì xù","abbr":"gxzx","explanation":"将要失传的学问典籍。","source":{"text":"是本孔氏继涵刻入《微波榭丛书》中，不为矣孤学坠绪。","book":"清·龚自珍《语录·书戴氏定本〈水经〉》"},"usage":"作宾语、定语；用于学问等"},{"id":14888,"word":"孤家寡人","pinyin":"gū jiā guǎ rén","abbr":"gjgr","explanation":"古代帝王的自称。后指脱离群众，孤立无助的人。","source":{"text":"寡人之于国也，尽心焉耳矣。","book":"《礼记·玉藻》：“凡自称，小国之君曰孤。”《孟子·梁惠王上》"},"example":{"text":"到了今日，云岫竟变了个～了。","book":"清·吴趼人《二十年目睹之怪现状》第六十五回"},"similar":["称孤道寡"],"opposite":["左右逢源"],"usage":"作宾语；指孤立无助的人"},{"id":14889,"word":"孤寡鳏独","pinyin":"gū guǎ guān dú","abbr":"gggd","explanation":"泛指没有劳动能力、无依无靠的人。","source":{"text":"老而无妻曰鳏，老而无夫曰寡，老而无子曰独，幼而无父曰孤。此四者，天下之穷民而无告者。","book":"战国·邹·孟轲《孟子·梁惠王下》"},"example":{"text":"……～或匮于衣食，甚怜憨焉。","book":"东汉·班固《汉书·武帝纪》"},"similar":["鳏寡孤独"],"usage":"作宾语、定语；指无依无靠的人"},{"id":14890,"word":"孤履危行","pinyin":"gū lǚ wēi xíng","abbr":"glwx","explanation":"指行为孤高独特。","source":{"text":"若明仲者，雄谈博辩而人不以为狂，志高远虑而人不以为迂，孤履危行而人不以为异。","book":"明·李东阳《冰玉斋记》"},"usage":"作谓语、定语；用于为人"},{"id":14891,"word":"孤峰突起","pinyin":"gū fēng tū qǐ","abbr":"gftq","explanation":"孤：单独；突起：高耸。单独的一座山峰高高地耸立着。","example":{"text":"桂林的山有一个突出的特点，便多是～。"}},{"id":14892,"word":"孤形单影","pinyin":"gū xíng dān yǐng","abbr":"gxdy","explanation":"孤：单独；单：独。形容孤单一人，无亲无友。","source":{"text":"冷清清孤形单影，静恍恍没一个人来至。","book":"明·胡文焕《群音类选·》"},"similar":["孤身只影","孤形只影","孤形吊影"],"usage":"作谓语、定语；形容孤单无亲"},{"id":14893,"word":"孤形只影","pinyin":"gū xíng zhī yǐng","abbr":"gxzy","explanation":"孤：单独。形容孤单一人，无亲无友。","source":{"text":"你看碧梧翠竹影凄凉，孤形只影空相向。","book":"明·胡文焕《群音类选·》"},"similar":["孤形单影","孤身只影","孤形吊影"],"usage":"作谓语、定语；形容孤单无亲"},{"id":14894,"word":"孤形吊影","pinyin":"gū xíng diào yǐng","abbr":"gxdy","explanation":"孤形：孤零零一个人；吊：悬着。形容孤独无依。","source":{"text":"茕茕孑立，形影相吊。","book":"晋·李密《陈情表》"},"example":{"text":"谁想你如今去了呵，使我～有谁瞅采？死后无人筑墓台。","book":"明·沈受先《三元记·鬻女》"},"similar":["孤形只影","孤形单影","孤身只影"],"usage":"作谓语、定语；形容孤单无亲"},{"id":14895,"word":"孤恩负义","pinyin":"gū ēn fù yì","abbr":"gefy","explanation":"指背弃恩义。","source":{"text":"臣孤恩负义，自陷重刑，情断意讫，无所复望。","book":"《后汉书·张俊传》"},"similar":["孤恩负德","忘恩负义"],"opposite":["以德报怨"],"usage":"作谓语、定语、宾语；用于为人处世"},{"id":14896,"word":"孤恩负德","pinyin":"gū ēn fù dé","abbr":"gefd","explanation":"孤：负。辜负别人的恩德。指忘恩负义。","source":{"text":"陵虽孤恩，汉亦负德。","book":"汉·李陵《答苏武书》"},"similar":["孤恩负义","忘恩负义"],"opposite":["以德报怨"],"usage":"作谓语、定语、宾语；用于为人处世"},{"id":14897,"word":"孤悬客寄","pinyin":"gū xuán kè jì","abbr":"gxkj","explanation":"犹言孤悬浮寄。形容孤立而没有依托。","source":{"text":"彼学政者，孤悬客寄于一行省之中，守土者皆貎敬而神拒之。","book":"清·曾国藩《送江小帆同年视学湖北序》"},"similar":["孤悬浮寄"],"usage":"作谓语、定语；用于人的境遇"},{"id":14898,"word":"孤悬浮寄","pinyin":"gū xuán fú jì","abbr":"gxfj","explanation":"形容孤立而没有依托。","source":{"text":"[上海]势居下游，无险可扼。蕞尔区，孤悬浮寄，数十里外皆贼兵。","book":"清·冯桂芬《公启曾协揆》"},"similar":["孤悬客寄"],"usage":"作谓语、定语；用于人的境遇"},{"id":14899,"word":"孤掌难鸣","pinyin":"gū zhǎng nán míng","abbr":"gznm","explanation":"一个巴掌拍不响。比喻力量孤单，难以成事。","source":{"text":"人主之患在莫之应，故曰：一手独拍，虽疾无声。","book":"《韩非子·功名》"},"example":{"text":"为见解珍、解宝是个好汉，有心要救他，史是单丝不线，～，只报得他一个信。","book":"明·施耐庵《水浒全传》第四十九回"},"similar":["难鸣孤掌","孤家寡人","孤立无援"],"opposite":["众志成城","众擎易举"],"usage":"作谓语、定语；用于势力单薄"},{"id":14900,"word":"孤文只义","pinyin":"gū wén zhī yì","abbr":"gwzy","explanation":"指零碎的文字材料。","source":{"text":"斯时通古今者起，以世运如是其殊科，王与霸如是其殊统；考之孤文只义之仅存，而得之乎出没隐显之间；……竹帛烂，师友断，疑信半；为立德、适道、达权之君子，若此其难也。","book":"清·龚自珍《〈春秋决事比〉自序》"},"similar":["孤文断句"],"usage":"作宾语、定语；用于说话等"},{"id":14901,"word":"孤文断句","pinyin":"gū wén duàn jù","abbr":"gwdj","explanation":"指片断、孤立的文句。","source":{"text":"《庄子》举宋鈃之言，孤文断句，更不能推见其旨。","book":"鲁迅《〈古小说钩沉〉序》"},"similar":["孤文只义"],"usage":"作宾语、定语；用于说话等"},{"id":14902,"word":"孤标傲世","pinyin":"gū biāo ào shì","abbr":"gbas","explanation":"孤：孤单；标：标准高。孤高自赏，傲然一世。原形容菊花傲霜独立的形态。比喻人格的傲然不群和不与俗流。","source":{"text":"孤标傲世偕谁隐，一样花开为底迟。","book":"清·曹雪芹《红楼梦》第三十八回"},"usage":"作谓语、定语、宾语；用于处世"},{"id":14903,"word":"孤标独步","pinyin":"gū biāo dú bù","abbr":"gbdb","explanation":"孤标：独特的标格；独步：超群出众，独一无二。形容品格极其清高。","source":{"text":"尘外孤标，云间独步。","book":"《旧唐书·杜审权传》"},"usage":"作谓语、定语；形容品格极其清高"},{"id":14904,"word":"孤注一掷","pinyin":"gū zhù yī zhì","abbr":"gzyz","explanation":"把所有的钱一次押上去，决一输赢。比喻在危急时用尽所有力量作最后一次冒险。","source":{"text":"刘毅家无担石之储，樗蒲一掷百万。","book":"《宋史·寇准传》：“博者输钱欲尽，乃罄所有出之，谓之孤注。”《晋书·何无忌传》"},"example":{"text":"无如他被全台的公愤逼迫得没有回旋余地，只好挺身而出，作～了。","book":"清·曾朴《孽海花》第三十二回"},"similar":["破釜沉舟","铤而走险","垂死挣扎"],"opposite":["举棋不定","瞻前顾后"],"usage":"作谓语、宾语、定语；指赌博","story":["北宋初年，辽国肖太后亲率大军南下侵宋。宰相寇准坚持抗战，并请宋真宗到澶州督战，宋军士气高昂，连连获胜，逼迫辽宋讲和。王钦若嫉妒寇准，在真宗面前讲皇上亲征是孤注一掷，这样做是太危险了"]},{"id":14905,"word":"孤灯挑尽","pinyin":"gū dēng tiǎo jìn","abbr":"gdtj","explanation":"孤：孤零零；挑尽：灯芯燃完了。灯芯燃完了，灯没也烧干了。指一个人孤零零对灯独处，深夜难眠。也比喻生活艰辛拮据。","source":{"text":"夕殿萤飞思悄然，孤灯挑尽未成眠。","book":"唐·陈鸿《长恨传》"}},{"id":14906,"word":"孤特独立","pinyin":"gū tè dú lì","abbr":"gtdl","explanation":"孤：孤立；特、独：这里指突出不凡。形容志行高洁，不同时俗。","source":{"text":"今将军内不能直谏，外为亡国将，孤特独立而欲常存，岂不哀哉。","book":"《史记·项羽本纪》"}},{"id":14907,"word":"孤特自立","pinyin":"gū tè zì lì","abbr":"gtzl","explanation":"孤：孤立；特：这里指突出不凡。形容志行高洁，不同时俗。","source":{"text":"今将军内不能直谏，外为亡国将，孤特独立而欲常存，岂不哀哉。","book":"《史记·项羽本纪》"},"example":{"text":"尤念人才当自惜，有～，为人挤弃，及言事伤激遭摈者，荐起十余人。","book":"明·焦竑《玉堂丛语·铨选》"}},{"id":14908,"word":"孤犊触乳","pinyin":"gū dú chù rǔ","abbr":"gdcr","explanation":"原意是独生子因溺爱，助长了骄气，父母反受其害。后比喻无依无靠的人请求别人的援助。","source":{"text":"孤独触乳，骄子骂母。","book":"《后汉书·仇览传》注引谢丞《后汉书》"},"usage":"作谓语；比喻无依无靠的人思慕亲人"},{"id":14909,"word":"孤独矜寡","pinyin":"gū dú guān guǎ","abbr":"gdgg","explanation":"泛指无依无靠的人。"},{"id":14910,"word":"孤独鳏寡","pinyin":"gū dú guān guǎ","abbr":"gdgg","explanation":"泛指无依无靠的人。","source":{"text":"老而无妻曰鳏，老而无夫曰寡，老而无子曰独，幼而无父曰孤；此四者，天下之穷民而无告者。","book":"《孟子·梁惠王下》"},"similar":["鳏寡孤独"],"usage":"作主语、宾语、定语；不专指一个"},{"id":14911,"word":"孤男寡女","pinyin":"gū nán guǎ nǚ","abbr":"gngn","explanation":"指单身男女。","source":{"text":"孤男寡女，有无媒而共处一室，以乱婚姻于始。","book":"清·名教中人《好逑传》第17回"},"example":{"text":"但总觉得半夜三更，～在一起，是件‘～’的事。","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["寡女孤男"],"usage":"作主语、宾语、定语；用于口语"},{"id":14912,"word":"孤秦陋宋","pinyin":"gū qín lòu sòng","abbr":"gqls","explanation":"孤：孤立；陋：鄙陋。孤立的秦朝，鄙陋的宋朝。指意在加强中央政权而结果却相反的错误方针。","source":{"text":"行之百年，以意消息，中国可反汉唐之疆，而绝孤秦陋宋之丰祸也。","book":"清·王夫之《黄书·宰制》"},"example":{"text":"自封建之法不行于后世，于是策时事者每以藩镇跋扈为忧，是其言则～之冢嗣也。","book":"章太炎《藩镇论》"},"usage":"作宾语、定语；用于书面语"},{"id":14913,"word":"孤立寡与","pinyin":"gū lì guǎ yǔ","abbr":"glgy","explanation":"指没有人扶持，没有人援助。","source":{"text":"岂有君子蓄用世之志而孤立寡与者哉！","book":"清·侯方域《朋党论下》"},"usage":"作谓语、定语；用于书面语"},{"id":14914,"word":"孤立无助","pinyin":"gū lì wú zhù","abbr":"glwz","explanation":"只有一个人或一方面的力量，得不到外力援助。","source":{"text":"十八年，帝崩，焉耆以中国大丧，遂攻没都护陈睦，超孤立无援。","book":"《后汉书·班超传》"},"example":{"text":"属者椒寝未繁，肖星不耀，～，有识寒心。","book":"宋·周辉《清波杂志》卷一"},"similar":["孤立无援"],"usage":"作状语、定语；用于人"},{"id":14915,"word":"孤立无援","pinyin":"gū lì wú yuán","abbr":"glwy","explanation":"只有一个人或一方面的力量，得不到外力援助。","source":{"text":"十八年，帝崩，焉耆以中国大丧，遂攻没都护陈睦，超孤立无援。","book":"《后汉书·班超传》"},"example":{"text":"庄公既碍姜氏之面，又度公孙滑～，不能有为。","book":"明·冯梦龙《东周列国志》第五回"},"similar":["孤立无助"],"usage":"作状语、定语；用于人"},{"id":14916,"word":"孤臣孽子","pinyin":"gū chén niè zǐ","abbr":"gcnz","explanation":"孤臣：封建朝廷中孤立无援的远臣；孽子：妾所生的庶子。比喻遭遇艰难困苦的人。","source":{"text":"独孤臣孽子，其操心也危，其虑患也深，故达。","book":"《孟子·尽心上》"},"example":{"text":"我一个人留在苏州，真正成了一个～了。","book":"郭沫若《革命春秋·脱离蒋介石以后》"},"usage":"作宾语；指孤立的人"},{"id":14917,"word":"孤舟独桨","pinyin":"gū zhōu dú jiǎng","abbr":"gzdj","explanation":"比喻单独行动，没人帮助。","source":{"text":"怎能够光凭这一家仇恨，个人勇敢、孤舟独桨、匹马单枪？","book":"京剧《红色娘子军》第四场"},"similar":["单枪匹马"],"usage":"作宾语、定语；用于做事"},{"id":14918,"word":"孤芳自赏","pinyin":"gū fāng zì shǎng","abbr":"gfzs","explanation":"孤芳：独秀一时的香花。把自己比做仅有的香花而自我欣赏。比喻自命清高。","source":{"text":"应念岭表经年，孤芳自赏，肝胆皆冰雪。","book":"宋·张孝祥《念奴娇·过洞庭》词"},"example":{"text":"然而忆到这～，别有怀抱的句子，又不禁喜悦的笑了。","book":"冰心《寄小读者·通讯九》"},"similar":["顾影自怜","自命清高"],"opposite":["自惭形秽"],"usage":"作谓语、宾语、定语；指自命清高"},{"id":14919,"word":"孤苦仃俜","pinyin":"gū kǔ dīng pīng","abbr":"gkdp","explanation":"犹言孤苦零丁。","source":{"text":"今生怎生？偏则是红颜薄命，眼见的孤苦仃俜。","book":"明·汤显祖《牡丹亭·诘病》"},"similar":["孤苦零丁","孤苦伶仃"],"usage":"作谓语、定语；指无依无靠"},{"id":14920,"word":"孤苦伶仃","pinyin":"gū kǔ líng dīng","abbr":"gkld","explanation":"伶仃：孤独，没有依靠。孤单困苦，没有依靠。","source":{"text":"臣少多疾病，九岁不行。零丁孤苦，至于成立。","book":"晋·李密《陈情表》"},"example":{"text":"头里有老太太，到底还疼我些；如今也死了，留下我～，如何了局？","book":"清·曹雪芹《红楼梦》第一一二回"},"similar":["无依无靠","举目无亲","形单影只"],"opposite":["儿孙满堂"],"usage":"作谓语、定语；指无依无靠","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母，尊重老人。他想启用西蜀尚书郎李密，就下诏书任命李密为郎中。李密不愿出来做官，就写《陈情表》上书晋武帝，说自己的祖母形影相吊、孤苦伶仃，待伺候祖母后再出来做官"]},{"id":14921,"word":"孤苦零丁","pinyin":"gū kǔ líng dīng","abbr":"gkld","explanation":"形容孤单困苦，无依无靠。","source":{"text":"零丁孤苦，至于成立。","book":"语出晋·李密《陈情表》"},"example":{"text":"他很有些悲伤，似乎也像孝女一样，成了‘无告之民’，～了。","book":"鲁迅《彷徨·肥皂》"},"similar":["孤苦仃俜","孤苦伶仃"],"usage":"作谓语、定语；指无依无靠"},{"id":14922,"word":"孤蓬自振","pinyin":"gū péng zì zhèn","abbr":"gpzz","explanation":"蓬：蓬草。单棵的蓬草，随风飘零，尚要振作。比喻失意的不甘沉沦，奋力振作，欲有所作为。","source":{"text":"白杨早落，塞草前衰，棱棱霜气，簌簌风威，孤蓬自振，惊砂坐飞。","book":"南朝·宋·鲍照《芜城赋》"},"example":{"text":"西河舞剑气凌云，～唯有君。","book":"唐·苏涣《赠零陵僧》"}},{"id":14923,"word":"孤行一意","pinyin":"gū xíng yī yì","abbr":"gxyy","explanation":"一意孤行。不听劝告，全凭自己的意愿行事。","source":{"text":"一意孤行。不听劝告，全凭自己的意愿行事。"},"example":{"text":"～宁论命，盛气谁言未可谋。","book":"柳亚子《哭仲穆》诗"},"similar":["孤行己意","一意孤行"],"usage":"作谓语、定语、宾语；指人固执"},{"id":14924,"word":"孤行己意","pinyin":"gū xíng jǐ yì","abbr":"gxjy","explanation":"不接受别人的意见，固执地照自己的意见行事。","source":{"text":"我想，原来是一个孤行己意，随随便便的青年，怪不得他模样如此傲慢。","book":"鲁迅《集外集·记“杨树大”君的袭来》"},"example":{"text":"我们不能～，要广泛听取群众意见。"},"similar":["孤行己见"],"usage":"作谓语、定语、宾语；指人固执"},{"id":14925,"word":"孤行己见","pinyin":"gū xíng jǐ jiàn","abbr":"gxjj","explanation":"不接受别人的意见，固执地照自己的意见行事。","source":{"text":"过去和现在都有这样的人，企图孤行己见，不尊重我们的意见，但是结果都不通。","book":"毛泽东《论联合政府》"},"example":{"text":"～是行不通的。"},"similar":["一意孤行"],"usage":"作谓语、主语、宾语；指人固执"},{"id":14926,"word":"孤衾独枕","pinyin":"gū qīn dú zhěn","abbr":"gqdz","explanation":"单条棉被与单个枕头。指夜间独自一人。","source":{"text":"虽是夜晚间孤衾独枕，不惯寂寞，奈一心丢了众人，只念柳湘莲早早回来完了终身大事。","book":"清·曹雪芹《红楼梦》第66回"},"similar":["枕冷衾寒"],"usage":"作宾语、定语；指夜间孤独"},{"id":14927,"word":"孤豚腐鼠","pinyin":"gū tún fǔ shǔ","abbr":"gtfs","explanation":"比喻微贱而不值得一说的人或事物。同“孤雏腐鼠”。","source":{"text":"成济，奴隶小人，昭视之，孤豚腐鼠耳。","book":"清·钱谦益《春秋论二》"},"similar":["孤雏腐鼠"],"usage":"作宾语、定语；比喻微贱不足道的人或事物"},{"id":14928,"word":"孤蹄弃骥","pinyin":"gū tí qì jì","abbr":"gtqj","explanation":"孤：单一；骥：骏马。就因为一只蹄子有毛病。而放弃骏马不用。比喻在用人方面求全责备，过于挑剔。","source":{"text":"盖虽天厩四十万匹，亦难得全材耳；今天下以孤蹄弃骥，可胜叹哉。","book":"宋·黄庭坚《题韩干御马图》"}},{"id":14929,"word":"孤身只影","pinyin":"gū shēn zhī yǐng","abbr":"gszy","explanation":"孤零零的一个人。形容孤儿无亲。","source":{"text":"可怜我孤身只影无亲眷，则落的吞声忍气空嗟怨。","book":"元·关汉卿《窦娥冤》第三折"},"example":{"text":"只是～，卧病空楼，冷帐寒衾，无人作伴，好生凄凉。","book":"清·孔尚任《桃花扇·寄扇》"},"similar":["形单影只","孤形单影"],"usage":"作谓语、定语；形容孤单无亲"},{"id":14930,"word":"孤阴不长，独阳不生","pinyin":"gū yīn bù zhǎng，dú yáng bù shēng","abbr":"gybzdybs","explanation":"孤、独：单一的。泛指单凭一方面的因素或条件促成不了事物的生长或出现。","source":{"text":"孤阴则不生，独阳则不长，故天地配以阴阳。","book":"清·程允升《幼学琼林·夫妇》"},"example":{"text":"本来也是道理，～。","book":"李劼人《暴风雨前》第一部分"},"similar":["孤阴则不生，独阳则不长"],"usage":"作宾语、定语；用于书面语"},{"id":14931,"word":"孤阴则不生，独阳则不长","pinyin":"gū yīn zé bù shēng，dú yáng zé bù zhǎng","abbr":"gyzbsdyzbz","explanation":"指单一方面的因素或条件是不能生长出新事物的。","source":{"text":"孤阴则不生，独阳则不长，故天地配以阴阳。","book":"清·程允开《幼学故事琼林·夫妇》"},"similar":["孤阴不长，独阳不生"],"usage":"作宾语、定语；用于书面语"},{"id":14932,"word":"孤陋寡闻","pinyin":"gū lòu guǎ wén","abbr":"glgw","explanation":"陋：浅陋；寡：少。形容学识浅陋，见闻不广。","source":{"text":"独学而无友，则孤陋而寡闻。","book":"《礼记·学记》"},"example":{"text":"某～，不足当公之荐。","book":"明·罗贯中《三国演义》第十回"},"similar":["才疏学浅","浅见寡识","浅尝辄止"],"opposite":["满腹经纶","博学多才","见多识广"],"usage":"作谓语、定语；作谦辞"},{"id":14933,"word":"孤雁出群","pinyin":"gū yàn chū qún","abbr":"gycq","explanation":"出：离开。指单飞不合群的鸟。形容人很特殊，与众不同。","source":{"text":"这一来更使别人看不惯，把我当作了抨击的目标，骂我孤雁出群。不近人情。","book":"冯玉祥《我的生活》第十五章"},"usage":"作宾语、定语；用于比喻句"},{"id":14934,"word":"孤雌寡鹤","pinyin":"gū cí guǎ hè","abbr":"gcgh","explanation":"丧失配偶的禽鸟。后亦用以比喻失偶之人。","source":{"text":"孤雌寡鹤，娱优乎其下兮；春禽群嬉，翱翔乎其颠。","book":"汉·王褒《洞箫赋》"},"similar":["孤鸿寡鹄"],"usage":"作宾语、定语；指失去配偶的男女"},{"id":14935,"word":"孤雏腐鼠","pinyin":"gū chú fǔ shǔ","abbr":"gcfs","explanation":"孤独的鸟雏，腐烂的老鼠。比喻微贱而不值得一说的人或事物。","source":{"text":"国家弃宪，如孤雏腐鼠耳。","book":"《庄子·秋水》：“于是鸱得腐鼠，剜鹐过之，仰而视之，曰：‘吓！’”《后汉书·窦宪传》"},"example":{"text":"女子当以四十以前死，人犹悼惜，青裙白发，作～，吾不愿也。","book":"清·纪昀《阅微草堂笔记》卷十二"},"similar":["孤豚腐鼠"],"usage":"作宾语；比喻微贱不足道的人或事物","story":["汉朝时期，外戚窦宪靠后宫的势力，以贱价夺得沁水公主的田园，汉章帝闻知怒斥窦宪说：“公主的东西你都敢夺，何况别人的呢？你做得太令人吃惊了，须知国家抛弃你，就像抛弃孤独的小鸟和腐烂的老鼠一样。”"]},{"id":14936,"word":"孤高自许","pinyin":"gū gāo zì xǔ","abbr":"ggzx","explanation":"孤：孤僻。指孤僻清高，自命不凡。","source":{"text":"那宝钗却又行为豁达，随分从时，不比黛玉孤高自许，目无下尘，故深得下人之心。","book":"清·曹雪芹《红楼梦》第五回"},"usage":"作谓语、定语、宾语；用于处世"},{"id":14937,"word":"孤魂野鬼","pinyin":"gū hún yě guǐ","abbr":"ghyg","explanation":"比喻没有依靠，处境艰难的人。","source":{"text":"人家哪里有工夫梦见我们这种孤魂野鬼。","book":"钱钟书《围城》"},"example":{"text":"这种人死后就是～。"},"similar":["野鬼孤魂"],"usage":"作宾语、定语；指孤立的人"},{"id":14938,"word":"孤鸾寡鹄","pinyin":"gū luán guǎ hú","abbr":"glgg","explanation":"孤鸾：无偶的友鸾，比喻死去了配偶的男子；寡鹄：比喻寡妇。指失偶的男女。","source":{"text":"孤雌寡鹤，娱优乎其下兮。","book":"汉·王褒《洞箫赋》"},"example":{"text":"～许成双，一段姻缘自主张。","book":"清·钱彩《说岳全传》第六十七回"},"similar":["孤鸿寡鹄"],"usage":"作宾语、定语；指失偶的男女"},{"id":14939,"word":"孤鸾照镜","pinyin":"gū luán zhào jìng","abbr":"glzj","explanation":"比喻无偶或失偶者对命运的伤悼。","source":{"text":"罽宾王结罝峻祁之山，获一鸾鸟。王甚爱之，欲其鸣而不能致也。乃饰以金樊，飨以珍羞，对之愈戚，三年不鸣。其夫人曰：‘尝闻鸟见其类而后鸣，何不悬镜以映之？’王从其言。鸾睹形感契，慨然悲鸣，哀响中霄，一奋而绝。","book":"南朝宋范泰《鸾鸟诗》序"},"example":{"text":"山鸡映水那自得，～不成双。","book":"南朝·陈·徐陵《鸳鸯赋》"},"usage":"作宾语、定语；用于比喻句","story":["古代罽宾王在峻祁山结网捕获一只鸾鸟，特别喜爱它，但就是不能让它鸣叫。于是用金樊笼装饰，用美食喂养，三年后还是不叫。他的夫人听说鸟见了同类肯定会叫的，于是在笼前挂一片大镜子。果然鸾鸟见到镜子中的自己，慨然悲鸣，哀响中霄，一奋而绝"]},{"id":14940,"word":"孤鸾舞镜","pinyin":"gū luán wǔ jìng","abbr":"glwj","explanation":"孤鸾：无偶的雄鸾。失偶的雄鸾对镜悲鸣。比喻失偶的人触物伤情，形影相吊。","source":{"text":"既交颈于千年，亦相随于万里；山鸡映水那相得，孤鸾照镜不成双。","book":"南朝·陈·徐陵《鸳鸯赋》"}},{"id":14941,"word":"孤鸿寡鹄","pinyin":"gū hóng guǎ hú","abbr":"ghgg","explanation":"孤：孤单；鸿：鸿雁；寡：失偶的妇人；鹄：天鹅。孤独失伴的天鹅。比喻失去配偶的男女。","source":{"text":"向日蚕桑动，忽相逢孤鸿寡鹄，无门投控，飞鸟依人情可悯。","book":"明·无名氏《鸣凤记·邹慰夏孤》"},"similar":["孤雌寡鹤"],"usage":"作宾语、定语；指失去配偶的男女"},{"id":14942,"word":"学不可以已","pinyin":"xué bù kě yǐ yǐ","abbr":"xbkyy","explanation":"学：求学。求学不可停止，即学习是没有止境的。","source":{"text":"君子曰：学不可以已。青，取之于蓝而青于蓝；冰，水为之而寒于水。","book":"《荀子·劝学》"}},{"id":14943,"word":"学不沾洽","pinyin":"xué bù zhān qià","abbr":"xbzq","explanation":"沾洽：原指雨水沾足，这里指渊博。指学识不够渊博。","source":{"text":"虽学不沾洽，然卓荦强识。","book":"《三国志·蜀志·许慈传》"},"opposite":["学富五车"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":14944,"word":"学不躐等","pinyin":"xué bù liè děng","abbr":"xbld","explanation":"躐：逾越。学习要由易到难，循序渐进，不能越级而进。","source":{"text":"幼者听而弗问，学不躐等。","book":"《礼记·学记》"},"example":{"text":"鸣呼世谓～，矧吾宗单传心印用以了生死者，其可以躐等乎。","book":"元·释念常《佛祖通载》卷十四"},"usage":"作宾语、定语；用于书面语"},{"id":14945,"word":"学业有成","pinyin":"xué yè yǒu chéng","abbr":"xyyc","explanation":"学业有成就。","source":{"text":"数年以后，上舍生学业有成就者，乃听学官保举，蒙古人若何品级，诸色人若何仕进。","book":"《元史·不忽木传》"},"example":{"text":"虽夫人喜溢于中，不自知其然而然，亦先生～所致与？","book":"明·陶宗仪《南村辍耕录·孝感》"},"usage":"作谓语、定语、宾语；用于学习等"},{"id":14946,"word":"学书不成，学剑不成","pinyin":"xué shū bù chéng，xué jiàn bù chéng","abbr":"xsbcxjbc","explanation":"学习书法没学好，学习剑术也没学到手。指学习一无所成。","source":{"text":"项籍（羽）少，学书不成，去学剑，又不成。","book":"《史记·项羽本纪》"},"similar":["学无所成"],"opposite":["学有所成"],"usage":"作宾语、定语；指学习一无所成"},{"id":14947,"word":"学书学剑","pinyin":"xué shū xué jiàn","abbr":"xsxj","explanation":"学文练武。","source":{"text":"学书不成，去，学剑。","book":"语出《史记·项羽本纪》"},"example":{"text":"柳亚子《次韵分寄康弼大觉》：“～成何济，闲煞屠龙倚马才。”"},"usage":"作宾语、定语；用于学习"},{"id":14948,"word":"学以致用","pinyin":"xué yǐ zhì yòng","abbr":"xyzy","explanation":"为了实际应用而学习。","source":{"text":"要结合实际工作和革命斗争的需要来学，学以致用，并且勤学苦学。","book":"李新《为有源头活水来》"},"example":{"text":"学习科学文化知识要～。"},"similar":["学以实用"],"opposite":["学非所用","用非所学"],"usage":"作谓语、定语；指为了实际应用而学习"},{"id":14949,"word":"学优则仕","pinyin":"xué yōu zé shì","abbr":"xyzs","explanation":"优：有余力，学习了还有余力，就去做官。后指学习成绩优秀然后提拔当官。","source":{"text":"子夏日：‘仕而优则学，学而优则仕。’","book":"《论语·子张》"}},{"id":14950,"word":"学优才赡","pinyin":"xué yōu cái shàn","abbr":"xycs","explanation":"赡：富足。学问好，又有才气。","source":{"text":"素闻仕卿学优才赡，潜德不耀，久欲一见，其勿他辞。","book":"《元史·李冶传》"},"usage":"作谓语、定语；用于书面语"},{"id":14951,"word":"学优而仕","pinyin":"xué yōu ér shì","abbr":"xyes","explanation":"优：有余力，学习了还有余力，就去做官。后指学习成绩优秀然后提拔当官。","source":{"text":"子夏日：‘仕而优则学，学而优则仕。’","book":"《论语·子张》"},"example":{"text":"我有力量释放了你，叫你达到～的愿望！","book":"老舍《四世同堂》三十四"},"similar":["学而优则仕"],"usage":"作谓语、定语；指读书做官"},{"id":14952,"word":"学如不及","pinyin":"xué rú bù jí","abbr":"xrbj","explanation":"学习好像追赶什么，总怕赶不上。形容学习勤奋，进取心强。又形容做其他事情的迫切心情。","source":{"text":"子日：‘学如不及，犹恐失之。’","book":"《论语·秦伯》"},"example":{"text":"恭惟皇帝陛下，即位以来，～。问道八年，寒暑不废。","book":"宋·苏轼《谢除两职守礼部尚书表》之二"}},{"id":14953,"word":"学如不及，犹恐失之","pinyin":"xué rú bù jí，yóu kǒng shī zhī","abbr":"xrbjyksz","explanation":"学习好像追赶什么，总怕赶不上，赶上了又怕被甩掉。形容学习勤奋，进取心强。又形容做其他事情的迫切心情。","source":{"text":"子日：‘学如不及，犹恐失之。’","book":"《论语·秦伯》"},"example":{"text":"秋间又过太湖，游石公、飘渺诸峰……明年将为天台、雁荡之行。～。","book":"清·袁枚《小仓山房尺牍》第一百０六首。"},"usage":"作宾语、分句；指人的迫切心情"},{"id":14954,"word":"学如牛毛，成如麟角","pinyin":"xué rú niú máo，chéng rú lín jiǎo","abbr":"xrnmcrlj","explanation":"牛毛：比喻多；麟角：麒麟的角，比喻少。学的人很多，学成的人极少。形容要学业有成极不容易","source":{"text":"学如牛毛，成如麟角，出蒋之《万机论》。","book":"南宋·王应麟《困学纪闻》第13卷"},"similar":["学者如牛毛，成者如麟角"],"usage":"作宾语、定语；用于书面语"},{"id":14955,"word":"学如登山","pinyin":"xué rú dēng shān","abbr":"xrds","explanation":"学习象登山一样。比喻要努力攀登，逐步提高。","source":{"text":"夫听黄钟声，然后知缶之细，视衮龙之文，然后知被褐之陋，涉庠序之教，然后知不学之困。故学者如登山焉，动而益高。","book":"三国·魏·徐干《中论·上·治学》"},"similar":["学如穿井"],"usage":"作宾语、定语；用于劝诫人"},{"id":14956,"word":"学如穿井","pinyin":"xué rú chuān jǐng","abbr":"xrcj","explanation":"穿：凿通。求学如同凿井。比喻在学习当中，学到的知识越深也就越难，因此为了获得更深的学问，必须要有百折不挠的进取精神。","source":{"text":"学道当如穿井，井愈深，土愈难出。若不坚心正行，岂得见泉源耶？","book":"宋·张君房《云笈七签》卷五"},"similar":["学如登山"],"usage":"作宾语、定语；用于劝诫人"},{"id":14957,"word":"学如逆水行舟","pinyin":"xué rú nì shuǐ xíng zhōu","abbr":"xrnsxz","explanation":"学习就像在逆水中行船一样，不前进就势必后退。","source":{"text":"古谚语：学如逆水行舟，不进则退。"}},{"id":14958,"word":"学富五车","pinyin":"xué fù wǔ chē","abbr":"xfwc","explanation":"五车：指五车书。形容读书多，学识丰富。","source":{"text":"惠施多方，其书五车。","book":"《庄子·天下》"},"example":{"text":"大贤世居大邦，见多识广，而且荣列胶庠，自然才贯二酉，～了。","book":"清·李汝珍《镜花缘》第十六回"},"similar":["博大精深","博学多才","见多识广"],"opposite":["目不识丁","胸无点墨","才疏学浅"],"usage":"作谓语、定语；指学识渊博","story":["春秋战国时期，涌现出一大批思想家，他们各自著书立说宣扬自己的观点，宋国人惠施认为天下无物不变，无时不动，任何东西的性质是相对的，事物之间没有绝对的区别。庄子评价他学富五车，知识非常广博"]},{"id":14959,"word":"学富才高","pinyin":"xué fù cái gāo","abbr":"xfcg","explanation":"学识渊博，才能高强。","source":{"text":"不能作文，虽学富五车，忠如比干，孝如伯奇、曾参，亦冥冥没没而已！","book":"明·朱之瑜《答安东守约问三十四条》"},"similar":["博学多才","才高八斗","满腹经纶"],"opposite":["一无所知","胸无点墨","不学无术"],"usage":"作谓语、定语；指人学识与才能都高"},{"id":14960,"word":"学成文武艺，货与帝王家","pinyin":"xué chéng wén wǔ yì，huò yǔ dì wáng jiā","abbr":"xcwwyhydwj","explanation":"艺：技能；货：本指货物或钱币，引申为卖。旧指学成文武全才，以求被皇帝所重用。","source":{"text":"秀才，这个正是学成文武艺，合当货与帝王家。秀才，你这般人才，如何不去做官，济世安民?","book":"元·高明《琵琶记》第四出"},"example":{"text":"陈辛曰：“我正是～。”不数日，去赴选场，偕众伺候挂榜。旬日之间，金榜题名，已登三甲进士。","book":"明·冯梦龙《喻世明言》卷二十"},"similar":["学成文武艺，货于帝王家"],"usage":"作宾语、定语、分句；用于书面语"},{"id":14961,"word":"学成文武艺，货于帝王家","pinyin":"xué chéng wén wǔ yì，huò yú dì wáng jiā","abbr":"xcwwyhydwj","explanation":"艺：技艺；货：财物。学成文武全才，以求得皇帝的赏识重用","source":{"text":"自古道，学成文武艺，货于帝王家。必然见俺二人学业成就，着俺下山，进取功名。","book":"元·无名氏《马陵道》楔子"},"similar":["学成文武艺，货与帝王家"],"usage":"作宾语、定语、分句；用于书面语"},{"id":14962,"word":"学无师承","pinyin":"xué wú shī chéng","abbr":"xwsc","explanation":"学业没有得到老师的指点传授或未经名师传授。多作自谦之辞。","source":{"text":"我学少师承，坎井可窥底。","book":"宋·黄庭坚《次韵秦觏过陈无己书院观鄙句之作》"},"example":{"text":"真晟～，独得于遗经之中。","book":"《明史·陈真晟传》"},"usage":"作谓语、定语；用于书面语"},{"id":14963,"word":"学无常师","pinyin":"xué wú cháng shī","abbr":"xwcs","explanation":"求学没有固定的老师。指凡有点学问、长处的人都是老师。","source":{"text":"夫子焉不学？而亦何常师之有？","book":"《论语·子张》"},"example":{"text":"三业先通，因博贯五经，兼明图纬，～。","book":"晋·皇甫谧《高士传·申屠蟠》"},"usage":"作宾语、定语；用于劝诫人"},{"id":14964,"word":"学无所遗","pinyin":"xué wú suǒ yí","abbr":"xwsy","explanation":"遗：遗漏。形容学识渊博，无所不晓。","source":{"text":"斯七子弟，于学无所遗，于辞无所假。","book":"三国·魏·曹丕《典论·论文》"},"usage":"作谓语、定语；用于书面语"},{"id":14965,"word":"学无止境","pinyin":"xué wú zhǐ jìng","abbr":"xwzj","explanation":"指学业上是没有尽头的，应奋进不息。","source":{"text":"理无专在，而学无止境也，然则问可少耶？","book":"清·刘开《问说》"},"example":{"text":"～，你不能太骄傲。"},"similar":["学海无涯"],"opposite":["不学无术"],"usage":"作宾语、定语；用于劝诫人"},{"id":14966,"word":"学有专长","pinyin":"xué yǒu zhān cháng","abbr":"xyzc","explanation":"指具有专门的知识、技能。","source":{"text":"难道他们都比你‘学有专长’吗？","book":"谢觉哉《心病还得心药医》"},"example":{"text":"谷主的成就更是高深难测，她的六名从婢，亦都～。","book":"金庸《神雕侠侣》第七回"},"usage":"作谓语、定语、宾语；用于学习等"},{"id":14967,"word":"学步邯郸","pinyin":"xué bù hán dān","abbr":"xbhd","explanation":"学步：学习走路。比喻机械地模仿，不但学不互别人的长处，反而会把自己原有的本事也丢掉。","source":{"text":"且子独不闻夫寿陵余子之学行于邯郸与？未得国能，又失其故行矣，直匍匐而归耳。","book":"《庄子·秋水》"},"example":{"text":"写作文不能照搬例文，那样会像～一样，是写不出好文章来的。"},"similar":["邯郸学步"],"usage":"作谓语、宾语；同“邯郸学步”","story":["战国时期，赵国国都邯郸人走路姿势非常优美与潇洒，外地人很赞赏和羡慕。燕国寿陵一个少年，特别迷恋邯郸人走路的姿态，竟专门到邯郸学习，他非常用心观摩、效仿、练习，过了一段时间，他没学会他们走路的姿态，连自己的也全忘了"]},{"id":14968,"word":"学浅才疏","pinyin":"xué qiǎn cái shū","abbr":"xqcs","explanation":"才能不高，学识不深（多用作自谦的话）。","source":{"text":"你读书思量做状元，我只怕你学疏才浅。","book":"南朝梁·刘勰《文心雕龙·神思》：“若学浅而空迟，才疏而徒速，以斯成器，未之前闻。”明·高明《琵琶记·南浦嘱别》"},"example":{"text":"本人～，只能尽力而为之。"},"similar":["才疏学浅"],"opposite":["学富才高"],"usage":"作谓语、定语；多用作自谦的话"},{"id":14969,"word":"学海无涯","pinyin":"xué hǎi wú yá","abbr":"xhwy","explanation":"学海：知识。学问的海洋无边无际。","source":{"text":"学海无边，书囊无底。世间书怎读得尽。","book":"清·张岱《小序》"},"example":{"text":"何况～，老师也在学习过程中，只有不耻下问，敢于修正错误，才能坚持进步。","book":"李新《教学相长》"},"similar":["学无止境","知也无涯","学海无边"],"opposite":["不学无术"],"usage":"作宾语、分句；用于劝诫人"},{"id":14970,"word":"学海无边","pinyin":"xué hǎi wú biān","abbr":"xhwb","explanation":"学问的海洋没有边际。指对知识的学习和研究，永远没有完结的时候。","source":{"text":"吾生也有涯，而知也无涯。","book":"《庄子·养生主》"},"example":{"text":"～，书囊无底，世间书怎读得尽。","book":"明·张岱《〈廉书〉小序》"},"similar":["学海无涯"],"usage":"作宾语、分句；用于劝诫人"},{"id":14971,"word":"学海波澜","pinyin":"xué hǎi bō lán","abbr":"xhbl","explanation":"比喻学识渊博的人驰骋于文坛。","source":{"text":"词林枝叶三春尽，学海波澜一夜干。","book":"晋·王嘉《拾遗记·何休》：“京师谓康成为‘经神’，何休为‘学海’。”唐·崔珏《哭李商隐二首》其一"},"example":{"text":"胸次天成，口角河倾，席上风生。吞～万顷，战词坛甲胄千兵。","book":"元·钟嗣成《双调·折桂令·西域吉诚甫》"}},{"id":14972,"word":"学然后知不足","pinyin":"xué rán hòu zhī bù zú","abbr":"xrhzbz","explanation":"学习之后，才知道自己的缺点。","source":{"text":"是故学然后知不足。教然后知困，然后能自强也。","book":"《礼记·学记》"},"example":{"text":"诵《学记》言～，则当思缉熙圣学。","book":"《明史·黄凤翔传》"},"similar":["学然后知不足","学而后知不足"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":14973,"word":"学然后知不足，教然后之困","pinyin":"xué rán hòu zhī bù zú，jiāo rán hòu zhī kùn","abbr":"xrhzbzjrhzk","explanation":"学习之后，才知道自己的缺点；教学以后，才知道自己的知识贫乏。","source":{"text":"是故学然后知不足。教然后知困，然后能自强也。","book":"《礼记·学记》"}},{"id":14974,"word":"学然后知不足，教然后知困","pinyin":"xué rán hòu zhī bù zú，jiāo rán hòu zhī kùn","abbr":"xrhzbzjrhzk","explanation":"学习之后，才知道自己的缺点；教学以后，才知道自己的知识贫乏。","source":{"text":"是故学然后知不足。教然后知困，然后能自强也。","book":"《礼记·学记》"},"similar":["学而后知不足"],"usage":"作宾语、分句；用于劝诫人"},{"id":14975,"word":"学疏才浅","pinyin":"xué shū cái qiǎn","abbr":"xscq","explanation":"才能不高，学识不深（多用作自谦的话）。同“学浅才疏”。","source":{"text":"休说小子在幼间学疏才浅，就是那老宿儒，好手段，学富五车，读书万卷，他也无处搜寻，无处招管。","book":"《平山冷燕》第四回：“若说考古做文，我晚生学疏才浅，实实不敢夸口。”清·蒲松龄《逃学传》"},"example":{"text":"老夫～，只怕答对不上啊。","book":"评剧《秦香莲》第四场"},"similar":["才疏学浅"],"usage":"作谓语、定语；用于自谦"},{"id":14976,"word":"学究天人","pinyin":"xué jiū tiān rén","abbr":"xjtr","explanation":"有关天道人事方面的知识都通晓。形容学问渊博。","source":{"text":"亦欲以究天人之际，通古今之变，成一家之言。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"方今皇帝资生知之上才，体沈郁之幽思，文丽日月，～。","book":"《梁书·钟嵘传》"},"similar":["学际天人"],"usage":"作谓语、定语；指学识渊博"},{"id":14977,"word":"学老于年","pinyin":"xué lǎo yú nián","abbr":"xlyn","explanation":"指青年人的博学。","source":{"text":"克幼而翘秀，既长，好学善属文，郡博士胡宪器之，曰：‘子学老于年，他日当以文章显。’","book":"《宋史·文苑传七·熊克》"},"usage":"作谓语、定语；指青年人的博学"},{"id":14978,"word":"学者如牛毛，成者如麟角","pinyin":"xué zhě rú niú máo，chéng zhě rú lín jiǎo","abbr":"xzrnmczrlj","explanation":"牛毛：形容多；麟角：麒麟头上的角，形容少。做学问的人很多，成功的人却极少。形容要取得事业上的成功非常不容易。","source":{"text":"学者如牛毛，成者如麟角。","book":"三国·魏·蒋济《蒋子万济论》"},"example":{"text":"及明皇御历，文雅大盛，～。","book":"《北史·文苑》"},"similar":["学如牛毛，成如麟角"],"usage":"作宾语、定语；用于书面语"},{"id":14979,"word":"学而不厌","pinyin":"xué ér bù yàn","abbr":"xeby","explanation":"厌：满足。学习总感到不满足。形容好学。","source":{"text":"默而识之，学而不厌，诲人不倦，何有于我哉？","book":"《论语·述而》"},"example":{"text":"对自己，“～”，对人家，“诲人不倦”，我们应取这种态度。","book":"毛泽东《中国共产党在民族战争中的地位》"},"similar":["手不释卷","虚心好学"],"opposite":["骄傲自满","好为人师"],"usage":"作谓语、定语；指人好学","story":["春秋时期，孔子在教学上有丰富的经验，常常与学生们一道研讨问题，给学生解决各种疑难问题，他鼓励学生培养很好的品德，深入钻研，提出“学而时习之，温故而知新”，学生赞扬孔子教学的耐心，孔子谦逊地说：“学而不厌，诲人不倦。”"]},{"id":14980,"word":"学而不厌，诲人不倦","pinyin":"xué ér bù yàn，huì rén bù juàn","abbr":"xebyhrbj","explanation":"厌：满足；诲：教导。学习总感到不满足，教导人从不厌倦。","source":{"text":"学而不厌，诲人不倦，何有于我哉？","book":"《论语·述而》"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":14981,"word":"学而不思则罔","pinyin":"xué ér bù sī zé wǎng","abbr":"xebszw","explanation":"罔：蒙蔽。只读书不思考就会上当受骗。","source":{"text":"学而不思则罔，思而不学则殆。","book":"《论语·为政》"},"example":{"text":"谢觉哉《想！》：“把书本当教条，不顾客观条件，生硬地拿现成公式去套，也必然碰大钉子，所谓‘～’。”"},"usage":"作宾语、定语；用于劝诫人"},{"id":14982,"word":"学而优则仕","pinyin":"xué ér yōu zé shì","abbr":"xeyzs","explanation":"优：有余力，学习了还有余力，就去做官。后指学习成绩优秀然后提拔当官。","source":{"text":"子夏日：‘仕而优则学，学而优则仕。’","book":"《论语·子张》"},"example":{"text":"我有力量释放了你，叫你达到～的愿望。","book":"老舍《四世同堂·三十四》"},"similar":["学优而仕"],"usage":"作谓语、定语；指读书做官","story":["春秋时期，孔子带领弟子们周游列国，到处碰壁，在郑国得病停留期间，他们在樊迟种的瓜蓬下谈论从政之事。子夏主张君子应该去当官，学而优则仕，否则留着学问有什么用呢？孔子同意他的观点，可是他们最终没有得到当权者的认同而当上大官"]},{"id":14983,"word":"学而后知不足","pinyin":"xué ér hòu zhī bù zú","abbr":"xehzbz","explanation":"只有经过学习，才会发现自己的不足","source":{"text":"不知，就要学习，学而后知不足。","book":"江泽民《在党外人士迎春座谈会上的讲话》"},"similar":["学然后知不足，教然后知困"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":14984,"word":"学而时习之","pinyin":"xué ér shí xí zhī","abbr":"xesxz","explanation":"学过的内容要经常复习它。","source":{"text":"子曰：‘学而时习之，不亦说乎！","book":"《论语·学而》"},"example":{"text":"～，所以学者将以行之也。","book":"宋《二程全书·外书七》"},"similar":["温故而知新"],"usage":"作谓语、宾语；指学习方法","story":["春秋时期，孔子在教学上有丰富的经验，常常与学生们一道研讨问题，给学生解决各种疑难问题，他鼓励学生培养很好的品德，深入钻研，提出“学而时习之，温故而知新”，学生赞扬孔子教学的耐心，孔子谦逊地说：“学而不厌，诲人不倦。”"]},{"id":14985,"word":"学行修明","pinyin":"xué xíng xiū míng","abbr":"xxxm","explanation":"修明：昌明。学问和品行都很出色。","source":{"text":"崔鉴，字神具，博陵安平人。父绰，少孤，学行修明，有名于世。","book":"《魏书·崔鉴传》"},"example":{"text":"乞自科举外，有～、孝友纯笃者，县荐之州，州延之庠序，以表率多士。","book":"《宋史·黄祖舜传》"},"usage":"作谓语、定语；用于书面语"},{"id":14986,"word":"学识渊博","pinyin":"xué shí yuān bó","abbr":"xsyb","explanation":"指学识深而且广。","example":{"text":"王教授在工程力学界是～的一流专家。"},"similar":["学富五车"],"usage":"作谓语、定语；指人的学识等"},{"id":14987,"word":"学贯中西","pinyin":"xué guàn zhōng xī","abbr":"xgzx","explanation":"形容学问贯通了中国和西方的种种知识。","source":{"text":"本领事久闻这位某观察，是曾经某制军保举过他留心时务、学贯中西的。","book":"清·吴趼人《二十年目睹之怪现状》第八十一回"},"example":{"text":"曹汝霖、章宗祥都是～的人物，但结果却都做卖国害民的事。（冯玉祥《我的生活》第二十八章）"},"similar":["学富五车"],"opposite":["不学无术","目不识丁"],"usage":"作谓语、定语；指博学"},{"id":14988,"word":"学贯古今","pinyin":"xué guàn gǔ jīn","abbr":"xggj","explanation":"贯：通。学识渊博，通晓古今知识。","source":{"text":"道周学贯古今，所至学者云集。","book":"《明史·黄道周传》"},"example":{"text":"时有大学生姓陈名东，是个忠贞之士，～，道师孔孟，遇事慷慨激烈，不避权贵。","book":"清·陈忱《水浒后传》第二十二回"}},{"id":14989,"word":"学贯天人","pinyin":"xué guàn tiān rén","abbr":"xgtr","explanation":"天人：天道与人世，自然与社会。有关天道人事方面的知识都通晓。形容学问渊博。","source":{"text":"亦欲以究天人之际，通古今之变，成一家之言。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"子牙妙算世无伦，～泣鬼神；纵使九公称敌国，蓝桥也自结姻亲。","book":"明·许仲琳《封神演义》第五十六回"},"similar":["学际天人","学究天人"],"usage":"作谓语、定语；用于书面语"},{"id":14990,"word":"学贵有恒","pinyin":"xué guì yǒu héng","abbr":"xgyh","explanation":"学习最珍贵的是要有坚持不懈的恒心。","source":{"text":"善人，吾不得而见之矣；得见有恒者，斯可矣。亡而为有，虚而为盈，约而为泰，难乎有恒矣。","book":"春秋·鲁·孔丘《论语·述而》"},"usage":"作宾语、定语；用于劝诫人"},{"id":14991,"word":"学问思辨","pinyin":"xué wèn sī biàn","abbr":"xwsb","explanation":"指做学问必须广泛的学习、反复地推敲、缜密地思考、明晰地分辨。","source":{"text":"博学之，审问之，慎思之，明辨之，笃行之。","book":"《礼记·中庸》"},"example":{"text":"且如事亲，如何而为温清之节，如何而为奉养之宜，须求个是当，方是至善。所以有～之功。","book":"明·王阳明《传习录》卷上"},"usage":"作宾语、定语；用于书面语"},{"id":14992,"word":"学问无止境","pinyin":"xué wèn wú zhǐ jìng","abbr":"xwwzj","explanation":"止境：尽头。学问是没有尽头的。","example":{"text":"～，我们要活到老，学到老。"},"similar":["学无止境"],"usage":"作宾语、分句；指学问"},{"id":14993,"word":"学际天人","pinyin":"xué jì tiān rén","abbr":"xjtr","explanation":"天人：天道与人世，自然与社会。有关天道人事方面的知识都通晓。形容学问渊博。","source":{"text":"亦欲以究天人之际，通古今之变，成一家之言。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"或位升台鼎，～，润色之文，咸布编集。","book":"《旧唐书·元稹等传论》"},"similar":["学究天人","学贯天人"],"usage":"作谓语、定语；指学识渊博"},{"id":14994,"word":"学非所用","pinyin":"xué fēi suǒ yòng","abbr":"xfsy","explanation":"所学的不是将来用得着的东西。比喻学习与实践相脱节。","source":{"text":"必也学非所用，术有所仰，故临川将济，而舟楫不存焉。","book":"《后汉书·张衡传》"},"example":{"text":"更有一种专门技术家，归国后无所用其长，亦卒至～，不能施展。","book":"冯玉祥《我的生活》第三十三章"},"similar":["用非所学"],"usage":"作宾语、定语；用于书面语"},{"id":14995,"word":"学非所用，用非所学","pinyin":"xué fēi suǒ yòng，yòng fēi suǒ xué","abbr":"xfsyyfsx","explanation":"所学的不是实际工作所用的，有用的又没有学。指学和用脱节背离","source":{"text":"比到京师，而除官多以貌选，所学或非其所用，所用或非其所学。","book":"《明史·叶伯巨传》"},"similar":["学非所用"],"usage":"作宾语、定语；用于书面语"},{"id":14996,"word":"孳孳不倦","pinyin":"zī zī bù juàn","abbr":"zzbj","explanation":"指工作或学习勤奋不知疲倦。","source":{"text":"乃更潜心典籍，孜孜不倦。","book":"《尚书·君陈》：“惟日孜孜，无敢逸豫。”《后汉书·鲁丕传》：“性沉深好学，孳孳不倦。”《三国志·蜀书·向朗传》"},"example":{"text":"我所知道的木刻家中，有罗清桢君，还是～。","book":"《便迅书信集·致李华》"},"similar":["孜孜不倦"],"usage":"作谓语、定语；指学习态度"},{"id":14997,"word":"孳孳不息","pinyin":"zī zī bù xī","abbr":"zzbx","explanation":"孳孳：同“孜孜”，努力不懈的样子。形容工作勤奋，努力不懈","source":{"text":"性沈深好学，孳孳不息。","book":"南朝·宋·范晔《后汉书·鲁丕传》"},"similar":["孜孜不息"],"usage":"作谓语、定语、状语；指勤奋"},{"id":14998,"word":"孳孳汲汲","pinyin":"zī zī jí jí","abbr":"zzjj","explanation":"心情急切、勤勉不懈的样子。","source":{"text":"故孳孳汲汲，不遑自己，仰驰光而兴慕，俯逝水而长怀……将奚为而可哉。","book":"明·刘基《送黄叔旸归金华觐省序》"},"example":{"text":"日本人何其不惮烦，～地造了这许多从汉到唐的假古董。","book":"鲁迅《坟·说胡须》"},"similar":["孜孜汲汲","孳孳矻矻","孜孜矻矻"],"usage":"作定语、状语；用于书面语"},{"id":14999,"word":"孳孳矻矻","pinyin":"zī zī kū kū","abbr":"zzkk","explanation":"孳孳：勤勉的；矻矻：辛勤劳作的样子。勤勉不懈的样子。","source":{"text":"吾生平无他嗜，唯攻文成癖，孳孳矻矻垂四十年。","book":"明·宋濂《故诸暨陈府君墓碣》"},"similar":["孳孳汲汲","孜孜汲汲","孜孜矻矻"],"usage":"作定语、状语；用于书面语"},{"id":15000,"word":"孳孳砽砽","pinyin":"zī zī kū kū","abbr":"zzkk","explanation":"孳孳勤勉的；砽砽辛勤劳作的样子。勤勉不懈的样子。","source":{"text":"吾生平无他嗜，唯攻文成癖，孳孳砽砽垂四十年。","book":"明·宋濂《故诸暨陈府君墓碣》"}}]
