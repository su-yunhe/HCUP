+[{"id":30001,"word":"滴水穿石","pinyin":"dī shuǐ chuān shí","abbr":"dscs","explanation":"水不断下滴，可以闹穿石头。比喻只要有恒心，不断努力，事情一定成功。","source":{"text":"绳锯木断，水滴石穿。","book":"宋·罗大经《鹤林玉露》"},"example":{"text":"同学们在日常学习中，应该有～的精神。"},"similar":["铁杵磨针"],"opposite":["半途而废","浅尝辄止"],"usage":"作谓语、状语；比喻坚持就是胜利","story":["宋朝崇阳县令张乖崖为官清廉，铁面无私。一次见县衙管理铁库的库吏从钱库里偷了一文钱，张乖崖认为数量虽小但性质严重，必须严惩。该官吏不服，张乖崖判他死刑并在判决书上写道：“一日一钱，千日一千；绳锯木断，水滴石穿。”"]},{"id":30002,"word":"滴水难消","pinyin":"dī shuǐ nán xiāo","abbr":"dsnx","explanation":"指虽菲薄之物也不能受用。","source":{"text":"兄弟！滴水难消。休道是兄弟将酒来，你则这般空来，也是你兄弟的情分。","book":"元·无名氏《杀狗劝夫》楔子"},"example":{"text":"只要有钱凭你饮，无钱滴水也难消。","book":"清·洪昇《长生殿·疑谶》敌变我变"},"usage":"作宾语、定语；用于处事"},{"id":30003,"word":"滴滴答答","pinyin":"dī dī dā dā","abbr":"dddd","explanation":"重复的滴滴声或一连串轻快的声音或拍打。","source":{"text":"她一扭一扭地走过来，高跟鞋敲在石板路上，滴滴答答像是在下雨。","book":"余华《活着》"},"example":{"text":"外面传来～的雨声，更加显得夜的宁静。"},"usage":"作定语、状语；用于声音等"},{"id":30004,"word":"滴粉搓酥","pinyin":"dī fěn cuō sū","abbr":"dfcs","explanation":"粉：脂粉；搓：搓摩；酥：润滑柔美。脸上薄施脂粉，用手搓摩润滑。形容女子肌肤柔嫩细腻。","source":{"text":"钱唐幕府乐籍有名姝张足女名浓者，色艺妙天下，君颇顾之，堆云翦水，滴粉搓酥，皆为浓而作。当时都人有‘晓风残月柳三变，滴粉搓酥左与言’之对。","book":"宋·王明清《玉照新志》卷四"},"example":{"text":"愁思乱，酒肠悭，漏将残。玉人今夜，～，应敛眉山。","book":"宋·曾觌《诉衷情·夜直殿庐·晚雪》"}},{"id":30005,"word":"滴酒不沾","pinyin":"dī jiǔ bù zhān","abbr":"djbz","explanation":"一点酒也不喝。","source":{"text":"她知道，这个人过去滴酒不沾，也不吸烟。","book":"路遥《平凡的世界》第四卷第50章"},"example":{"text":"她～，今天可破例了。"},"opposite":["开怀畅饮","好酒贪杯"],"usage":"作谓语、定语；指不喝酒"},{"id":30006,"word":"滴里嘟噜","pinyin":"dī lǐ dū lū","abbr":"dldl","explanation":"形容大大小小的一串东西高低不齐地挂在一起，显得很累赘，不利落。","example":{"text":"他腰带上～地挂着很多钥匙。"},"similar":["嘀里嘟噜"],"usage":"作状语；用于口语"},{"id":30007,"word":"滴里耷拉","pinyin":"dī lǐ dā lā","abbr":"dldl","explanation":"物体下垂的样子。","example":{"text":"他凝视着～的破球网若有所思。"},"usage":"作定语、状语；用于神态等"},{"id":30008,"word":"滴露研朱","pinyin":"dī lù yán zhū","abbr":"dlyz","explanation":"滴水研磨朱砂。指用朱笔评校书籍。","source":{"text":"滴露研朱非草草，从容鉴定庶无尤。","book":"明·叶宪祖《鸾鎞记·品诗》"},"example":{"text":"丫鬟将文字呈上小姐，传达太老爷分付之语。小妹～，从头批点，须臾而毕。","book":"《醒世恒言·苏小妹三难新郎》"},"usage":"作谓语；指批改书籍"},{"id":30009,"word":"滴露研珠","pinyin":"dī lù yán zhū","abbr":"dlyz","explanation":"指滴水磨墨。","source":{"text":"唐·高骈《步虚词》；“洞门深锁碧窗寒，滴露研珠写《周易》。”"},"usage":"作宾语、定语；用于书法与写字等"},{"id":30010,"word":"漂母之恩","pinyin":"piǎo mǔ zhī ēn","abbr":"pmze","explanation":"漂母：在水边漂洗衣服的老妇。指馈食于人的恩惠。","source":{"text":"感子漂母惠，愧我非韩才。","book":"晋·陶潜《乞食》诗"}},{"id":30011,"word":"漂母之惠","pinyin":"piǎo mǔ zhī huì","abbr":"pmzh","explanation":"漂母：在水边漂洗衣服的老妇。指馈食于人的恩惠。","source":{"text":"感子漂母惠，愧我非韩才。","book":"晋·陶潜《乞食》诗"}},{"id":30012,"word":"漂母进饭","pinyin":"piāo mǔ jìn fàn","abbr":"pmjf","explanation":"漂母：在水边漂洗衣服的老妇。指施恩而不望报答。","source":{"text":"信钓于城下，诸母漂，有一母见信饥，饭信，竟漂数十日。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"～，没收千金之恩。","book":"唐·李白《溧阳濑水贞义女碑铭序》"},"usage":"作宾语、定语；指施恩而不望报答","story":["秦朝末年，淮阴孤儿韩信靠在淮水边钓鱼为生，经常是钓不到鱼而要饿肚子，一个漂洗丝絮的老大娘见他可怜，经常把自己的饭分一半给他吃。韩信后来成为淮阴侯，特地找到当年的漂絮大娘，送给她一千金酬谢，可是她却不收他的礼物"]},{"id":30013,"word":"漂泊无定","pinyin":"piāo bó wú dìng","abbr":"pbwd","explanation":"飘泊：随水漂流或停留。随水飘流到哪里就停在哪里，没有一定的方向。比喻为了生活而四处奔走，生活不安定。","source":{"text":"遥怜好兄弟，飘泊雨江村。","book":"宋·范成大《元夜忆群从》"},"example":{"text":"智光和尚四海云游，赵钱孙～，要找这两个人甚是不易。","book":"金庸《天龙八部》第二十章"},"usage":"作谓语、定语；用于生活"},{"id":30014,"word":"漂泊羁旅","pinyin":"piāo bó jī lǚ","abbr":"pbjl","explanation":"飘泊：随水漂流或停泊；羁旅：作客他乡。比喻漂流异乡，没有一个固定的家。","source":{"text":"下亭漂泊，高桥羁旅。","book":"北周·庾信《哀江南赋·序》"}},{"id":30015,"word":"漂浮不定","pinyin":"piāo fú bù dìng","abbr":"pfbd","explanation":"漂浮：停留在流体表面或悬浮在流体中。指人飘泊不定","example":{"text":"我这一生像浮云一样～"},"usage":"作谓语、定语；用于人的生活"},{"id":30016,"word":"漂漂亮亮","pinyin":"piào piào liàng liàng","abbr":"ppll","explanation":"指外形美观，鲜明。","source":{"text":"她平时打扮得漂漂亮亮，队里有轻松活时才出山劳动一天，平时一般不出家门。","book":"路遥《平凡的世界》第一卷第27章"},"example":{"text":"家珍穿着水红的旗袍，手挽一个蓝底白花的包裹，～地回来了。","book":"余华《活着》"},"usage":"作谓语、定语、状语；多用于女性"},{"id":30017,"word":"漂蓬断梗","pinyin":"piāo péng duàn gěng","abbr":"ppdg","explanation":"飘飞的蓬草和随波逐流的植物断茎。比喻生活不安定，到处漂泊。","source":{"text":"春芜可曾有了么？问卿卿，多应是漂蓬断梗浑无定。","book":"明·王錂《春芜记·闺语》"},"example":{"text":"高皇帝在九京，不管亡家破鼎，那知他圣子神孙，反不如～。","book":"清·孔尚任《桃花扇·哭主》"}},{"id":30018,"word":"漂零蓬断","pinyin":"piāo líng péng duàn","abbr":"plpd","explanation":"漂泊零落如蓬草一样随风飞转，转徙无常。","source":{"text":"北海乏孔融之赏鉴，以故漂零蓬断，世业渐雕。","book":"明·杨珽《龙膏记·旅况》"},"similar":["飘泊无定"],"opposite":["安居乐业"],"usage":"作谓语、定语；指生活不安定"},{"id":30019,"word":"漆女忧鲁","pinyin":"qī nǚ yōu lǔ","abbr":"qnyl","explanation":"鲁穆公时国事危急，漆室之女对国家深感忧虑。指不当政的人对国事担忧。","source":{"text":"其邻人妇从之游，谓曰：‘何啸之悲也!子欲嫁耶?吾为子求偶。’漆室女曰：‘嗟乎!吾岂为不嫁不乐而悲哉，吾忧鲁君老，太子幼。’","book":"《列女传·仁智传》"},"example":{"text":"行见贞下起元，物极必反，沙汰之政，当轴必已筹及，毋徒为漆女之忧鲁也。","book":"表·毛祥麟《墨馀录·开例》"},"usage":"作宾语、定语；用于爱国","story":["战国时期，鲁国内部斗争激烈，鲁穆公年老得子，立为太子，身边的权势纷纷垂涎鲁室，国事甚危。一大户人家漆室有一个少女倚柱长叹，希望忠臣们能好好辅佐王室，然事与愿违，她只能是自己忧国忧民罢了"]},{"id":30020,"word":"漆桶底脱","pinyin":"qī tǒng dǐ tuō","abbr":"qtdt","explanation":"漆桶脱了底才能透光亮。比喻彻底明白清楚。","source":{"text":"宋·释普济《五灯会元》卷七德山打一棒曰：‘道甚么！我当时如桶底脱相似。’"},"example":{"text":"吕先生听罢，大彻大悟，如～。","book":"明·冯梦龙《醒世恒言》卷二十二"},"usage":"作宾语、定语；用于比喻句"},{"id":30021,"word":"漆身吞炭","pinyin":"qī shēn tūn tàn","abbr":"qstt","explanation":"漆身：身上涂漆为癞；吞炭：喉咙吞炭使哑。指故意变形改音，使人不能认出自己。","source":{"text":"漆身为厉（癞），吞炭为哑，使形状不可知。","book":"《战国策·赵策一》：“豫让又漆身为厉，灭须去眉，自刑以变其容。……又吞炭为哑，变其音。”《史记·刺客列传》"},"example":{"text":"故豫让以众人报范中行，而～以复赵襄子之仇。","book":"唐·李翱《与本使李中丞论陆巡官状》"},"similar":["豫让吞炭","吞炭漆身"],"usage":"作谓语、定语；用于书面语","story":["春秋末期，晋国内乱，大夫赵襄子杀了大夫智伯。智伯的心腹家将豫让发誓要杀赵襄子，他潜入赵襄子的宅内行刺未遂。赵襄子佩服他的义气把他放了。第二次他把全身漆成癞子，然后吞下烧红的炭使声音变哑，再次去行刺未遂而自杀"]},{"id":30022,"word":"漆黑一团","pinyin":"qī hēi yī tuán","abbr":"qhyt","explanation":"形容一片黑暗，没有一点光明。也形容对事情一无所知。","source":{"text":"青年又少有精通外国文者，有话难开口，弄得漆黑一团。","book":"鲁迅《书信集·致姚克》"},"example":{"text":"不如反到～，虽说不到真善美，也就看不见伪丑恶。","book":"瞿秋白《文艺杂著·猪八戒》"},"similar":["暗无天日","昏天黑地"],"opposite":["光芒万丈","博古通今"],"usage":"作谓语、定语；指黑暗"},{"id":30023,"word":"漏卮难满","pinyin":"lòu zhī nán mǎn","abbr":"lznm","explanation":"卮：励酒器。渗漏的酒器难于盛满。多比喻权利的外溢。","source":{"text":"今夫溜水足以溢壶榼，而江河不能实漏卮。","book":"《淮南子·氾论训》"},"usage":"作宾语、定语；用于比喻句"},{"id":30024,"word":"漏尽更阑","pinyin":"lòu jìn gēng lán","abbr":"ljgl","explanation":"漏：古代滴水计时的仪器。更：夜间计时单位。喻指夜深之时。","source":{"text":"直等的漏尽更阑，街衢静悄。","book":"元·高文秀《襄阳会》第一折"},"similar":["三更半夜"],"usage":"作宾语、状语；指夜深的时候"},{"id":30025,"word":"漏尽钟鸣","pinyin":"lòu jìn zhōng míng","abbr":"ljzm","explanation":"比喻人的生命已到尽头。同“漏尽锺鸣”。","source":{"text":"漏尽钟鸣，箭驰风迫。","book":"《汉魏南北朝墓志集释·马稚暨妻张氏墓志》"},"example":{"text":"老人～，旦夕就木，又安能长为汝伴者。","book":"《孤儿记》第四章"},"usage":"作谓语、定语、宾语；用于比喻句"},{"id":30026,"word":"漏尽锺鸣","pinyin":"lòu jìn zhōng míng","abbr":"ljzm","explanation":"比喻人的生命已到尽头。"},{"id":30027,"word":"漏泄天机","pinyin":"lòu xiè tiān jī","abbr":"lxtj","explanation":"天机：重要的机密。走漏了不宜外泄的机密。","source":{"text":"仙人言称是本州之神，与小人酒食吃了，又将此物出来，叫小人付与州官收受，不许漏泄天机。","book":"《平妖传》第二十五回"},"example":{"text":"官吏称韦义方不合～，合当有罪，急得韦义方叩头告罪。","book":"明·冯梦龙《喻世明言》卷三十三"},"usage":"作谓语、宾语；指泄密"},{"id":30028,"word":"漏泄春光","pinyin":"lòu xiè chūn guāng","abbr":"lxcg","explanation":"原指柳叶首先透露春天到来的信息，后比喻男女私情泄露，或秘密被察觉。","source":{"text":"侵陵雪色还萱草，漏泄春光有柳条。","book":"唐·杜甫《腊日》诗"},"example":{"text":"本待要安排心事传幽客，我则怕～与乃堂。","book":"元·王实甫《西厢记》第一本第二折"},"similar":["春光外泄"],"usage":"作谓语；比喻泄露男女私情"},{"id":30029,"word":"漏洞百出","pinyin":"lòu dòng bǎi chū","abbr":"ldbc","explanation":"百：极言其多。有很多漏洞。形容文章、说话或办事，破绽很多。","source":{"text":"我们从《歧路灯》中感到亲切的部分往往不是道貌岸然的人物，而是各种世俗人物，同时也看出来封建礼教和制度的漏洞百出。","book":"姚雪垠《序》"},"example":{"text":"他的文章～，自相矛盾。"},"similar":["破绽百出","自相矛盾"],"opposite":["滴水不漏","天衣无缝"],"usage":"作宾语、定语、补语；指破绽很多"},{"id":30030,"word":"漏洩春光","pinyin":"lòu xiè chūn guāng","abbr":"lxcg","explanation":"①透露春天的信息。②指密传消息或泄露男女私情。"},{"id":30031,"word":"漏瓮沃焦釜","pinyin":"lòu wēng wò jiāo fǔ","abbr":"lwwjf","explanation":"用漏瓮里的余水倒在烧焦的锅里。比喻情势危急，亟待挽救。","source":{"text":"且救赵之务，宜若奉瓮沃焦釜也。","book":"《史记·田敬仲完世家》"},"usage":"作宾语；比喻情势危急，亟待挽救"},{"id":30032,"word":"漏网之鱼","pinyin":"lòu wǎng zhī yú","abbr":"lwzy","explanation":"逃脱鱼网的鱼。比喻侥幸逃脱的罪犯或敌人。","source":{"text":"网漏于吞舟之鱼。","book":"《史记·酷吏列传序》"},"example":{"text":"他两个忙忙如丧家之狗，急急似漏网之鱼。","book":"元·郑廷玉《后庭花》第二折"},"similar":["丧家之犬","亡命之徒","漏网游鱼"],"opposite":["网中之鱼"],"usage":"作宾语；用于罪犯","story":["春秋时期，晋襄公打败秦国，俘虏秦将孟明视、白乙丙、西乞术。晋襄公听信母后冤仇宜解不宜结的教诲，放了三人。大将先轸及阳处父立刻带兵去追赶。孟明视三人早就跑到了黄河边，跳进打鱼的小船逃走，成为晋国的漏网之鱼"]},{"id":30033,"word":"漏网游鱼","pinyin":"lòu wǎng yóu yú","abbr":"lwyy","explanation":"逃脱鱼网的鱼。比喻侥幸逃脱的罪犯或敌人。同“漏网之鱼”。","source":{"text":"网漏于吞舟之鱼。","book":"《史记·酷吏列传序》"},"example":{"text":"李靖往前飞走，真似失林飞鸟，～，莫知东南西北。","book":"明·许仲琳《封神演义》第十四回"},"similar":["漏网之鱼"],"usage":"作宾语；用于罪犯等"},{"id":30034,"word":"漏脯充饥","pinyin":"lòu fǔ chōng jī","abbr":"lpcj","explanation":"漏脯：挂在檐下风干的肉，因屋漏沾水而有毒。饿了吃腐烂发臭的干肉。比喻只顾眼前，不管后果。","source":{"text":"咀漏脯以充饥，酣鸩酒以止渴也。","book":"晋·葛洪《抱扑子·嘉遯》"},"similar":["饮鸩止渴"],"usage":"作宾语、定语；指只顾眼前，不顾后患"},{"id":30035,"word":"漏虀搭菜","pinyin":"lòu jì dā cài","abbr":"ljdc","explanation":"形容拖泥带水，不爽快。","source":{"text":"是你辱门败户先自歪，做的来漏虀搭菜，把花言巧语本铺排。","book":"元·马致远《黄梁梦》第二折"}},{"id":30036,"word":"漏齑搭菜","pinyin":"lòu jī dā cài","abbr":"ljdc","explanation":"拖泥带水，不爽利。","source":{"text":"是你辱门败户先自歪，做的来漏齑搭菜，把花言巧语枉铺排。","book":"元·马致远《黄粱梦》第二折"},"similar":["拖泥带水"],"usage":"作定语、状语；指不干脆"},{"id":30037,"word":"演古劝今","pinyin":"yǎn gǔ quàn jīn","abbr":"ygqj","explanation":"演：表演。表演古代的故事劝诫今天的人。","source":{"text":"况金元院本，演古劝今，情神刻肖，令人激昂慷慨，欢喜悲号。","book":"清·郑燮《城隍庙碑记》"},"similar":["借古讽今"],"usage":"作谓语、定语；指规劝别人"},{"id":30038,"word":"演武修文","pinyin":"yǎn wǔ xiū wén","abbr":"ywxw","explanation":"指演练武艺，修习文章。","source":{"text":"那其间教训成人，演武修文，重掌三军。","book":"元纪君祥《赵氏孤儿》第一折"},"example":{"text":"圣皇治世掌山川，～将相全。","book":"明无名氏《曹彬下江南》第一折"},"similar":["修文演武"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":30039,"word":"漠不关心","pinyin":"mò bù guān xīn","abbr":"mbgx","explanation":"漠：冷淡。态度冷淡，毫不关心。","source":{"text":"人家竞相传抄，什袭以藏，而子孙漠不关心。","book":"清·李绿园《歧路灯》第九十五回"},"example":{"text":"好比看古代或是异国的故事，～。","book":"叶圣陶《英文教授》"},"similar":["漠然置之"],"opposite":["关怀备至"],"usage":"作谓语、定语、状语；指态度冷淡"},{"id":30040,"word":"漠不关情","pinyin":"mò bù guān qíng","abbr":"mbgq","explanation":"漠：冷淡。对人对事态度冷淡，毫不关心。","source":{"text":"回思未第之先，与多士何异？乃于落卷漠不关情，设身处地，于心何忍？","book":"清·林则徐《请定乡试……诸弊折》"},"similar":["漠不关心"],"usage":"作谓语、定语、状语；指态度冷淡"},{"id":30041,"word":"漠不相关","pinyin":"mò bù xiāng guān","abbr":"mbxg","explanation":"形容彼此毫无关联。","source":{"text":"而洙泗之间，弦歌自若，一若漠不相关也者。","book":"清·严复《有如三保》"},"example":{"text":"我们也～，精神上已一在天之南一在地之北了。","book":"鲁迅《呐喊·社戏》"},"similar":["毫不相干"],"opposite":["密切相关"],"usage":"作谓语、定语；形容彼此毫无关系"},{"id":30042,"word":"漠漠无闻","pinyin":"mò mò wú wén","abbr":"mmww","explanation":"闻：出名。指无声无息，无人知晓。","source":{"text":"漠漠无闻至于百姓忘其姓名还是好的，还有提其名讳而讪骂及之者。","book":"清·李绿园《歧路灯》第55回"},"similar":["昧昧无闻","漠漠无闻","没没无闻"],"opposite":["赫赫有名","鼎鼎有名"],"usage":"作谓语、定语、状语；指无声无息"},{"id":30043,"word":"漠然不动","pinyin":"mò rán bù dòng","abbr":"mrbd","explanation":"漠然：冷淡的样子。形容对人或事不重视，态度冷淡，毫不动心。","source":{"text":"无为者，寂然无声，漠然不动，引之不来，推之不往。","book":"《淮南子·修务训》"},"example":{"text":"这却也难怪你，父子天性，你岂有～的理。","book":"清·文康《儿女英雄传》第十二回"}},{"id":30044,"word":"漠然置之","pinyin":"mò rán zhì zhī","abbr":"mrzz","explanation":"置：放。很冷淡地把它搁在一边。指对人或事态度冷淡，放在一边不理。","source":{"text":"故国家有祀祭之典，官吏有防护之册，而为之子孙者岂忍听其荒废不治而漠然置之耶！","book":"清·钱泳《履园从话·会稽郡王墓》"},"example":{"text":"彼而～，犹可言也；我而～，不可言也。","book":"清·梁启超《少年中国说》"},"similar":["漠不关心","置之不理","不屑一顾"],"opposite":["体贴入微"],"usage":"作谓语、宾语、定语；指态度冷淡"},{"id":30045,"word":"漠然视之","pinyin":"mò rán shì zhī","abbr":"mrsz","explanation":"很冷淡地看待。指对人或事态度冷淡，放在一边不理。","source":{"text":"操江又以向非本属兵，难遥制，亦漠然视之，非委任责成意。","book":"《明史·兵志三》"},"example":{"text":"即或号召名义，彼善于此，国人皆～，所谓春秋无义战也。","book":"蔡东藩、许廑父《民国通俗演义》第一百三十五回"}},{"id":30046,"word":"漫不加意","pinyin":"màn bù jiā yì","abbr":"mbjy","explanation":"犹漫不经心。随随便便，不放在心上。","source":{"text":"俱涂饰草率，皆李永贞贪其侵冒，包工了事，漫不加意之所致也。","book":"明·刘若愚《酌中志·内臣职掌纪略》"},"similar":["漫不经意"],"usage":"作定语、状语；同“漫不经心”"},{"id":30047,"word":"漫不经心","pinyin":"màn bù jīng xīn","abbr":"mbjx","explanation":"漫：随便；经心：在意。随随便便，不放在心上。","source":{"text":"连年修西北二塘，责重塘长而空名应役，漫不经心，以至渐成大患，愈能捍御。","book":"明·任三宅《覆耆老汪源论设塘长书》"},"example":{"text":"当时～，却等事后再去追怀。","book":"闻一多《伟大的事实，不朽的意义》"},"similar":["掉以轻心","漠不关心"],"opposite":["专心致志","聚精会神"],"usage":"作定语、状语；用于工作学习方面"},{"id":30048,"word":"漫不经意","pinyin":"màn bù jīng yì","abbr":"mbjy","explanation":"随随便便，不放在心上。","source":{"text":"有时不能莹然彻底而变化，好像漫不经意地在四处爆发着一个优美的结晶。","book":"郭沫若《文艺论集·》"},"example":{"text":"他～地就走回来了。"},"similar":["漫不经心","漫不加意"],"opposite":["聚精会神"],"usage":"作定语、状语；同“漫不经心”"},{"id":30049,"word":"漫地漫天","pinyin":"màn dì màn tiān","abbr":"mdmt","explanation":"漫：满。充满天地之间。形容数量极多，到处皆是。亦作“漫天漫地”。","source":{"text":"可早漫地漫天，更扑头扑面，雪拥就浪千堆。","book":"元·谷子敬《城南柳》第三折"},"similar":["漫天漫地"],"usage":"作定语、状语；用于书面语"},{"id":30050,"word":"漫天匝地","pinyin":"màn tiān zā dì","abbr":"mtzd","explanation":"指铺天盖地。","source":{"text":"遥想漫天匝地，近听穿幔鸣窗。","book":"宋·范成大《雪复大作六言》"},"example":{"text":"～的白雪，便是预示着他们能够白头到老的好兆头。","book":"郁达夫《山奔》"},"similar":["漫天彻地","漫天遍地","漫天盖地"],"opposite":["寥若晨星"],"usage":"作定语、状语；形容众多而密集"},{"id":30051,"word":"漫天叫价","pinyin":"màn tiān jiào jià","abbr":"mtjj","explanation":"犹漫天要价。形容所提出的条件、要求过高。","source":{"text":"若是旁人呢？我就漫天叫价；是大人吗，就不用你就地还钱，奴家分文不取，权当与大人接风。","book":"川剧《谭记儿》第四场"},"similar":["漫天要价","漫天开价"],"opposite":["童叟无欺"],"usage":"作谓语、宾语；指无限度地乱开价码"},{"id":30052,"word":"漫天塞地","pinyin":"màn tiān sè dì","abbr":"mtsd","explanation":"漫：满；塞：充满。从天上到地下到处都是。","source":{"text":"素臣喊叫如雷，跳跃如虎，人人辟易，便直冲而出，却见漫天塞地，都是民兵。","book":"清·夏敬渠《野叟曝言》第108回"},"similar":["漫天蔽野","漫天掩地"],"usage":"作定语、状语；用于数量多"},{"id":30053,"word":"漫天大谎","pinyin":"màn tiān dà huǎng","abbr":"mtdh","explanation":"弥天大谎，没有边际的假话。","source":{"text":"古之秀才，自以为无所不晓，于是有‘秀才不出门，而知天下事’这自负的漫天大谎，小百姓信以为真，也就渐渐的成了谚语，流行开来。","book":"鲁迅《南腔北调集·谚语》"},"example":{"text":"这～居然还有人信。"},"similar":["弥天大谎","瞒天大谎"],"opposite":["肺腑之言"],"usage":"作宾语；指欺骗"},{"id":30054,"word":"漫天开价","pinyin":"màn tiān kāi jià","abbr":"mtkj","explanation":"无限度地乱开价码。","source":{"text":"城隍庙的定价是靠不住的，他‘漫天开价’，你一定要‘就地还钱’，慢慢的和他们‘推敲’。","book":"阿英《城隍庙的书市》"},"example":{"text":"你不要～，我们难以接受。"},"similar":["漫天要价","瞒天要价"],"opposite":["童叟无欺"],"usage":"作谓语、宾语；指无限度地乱开价码"},{"id":30055,"word":"漫天彻地","pinyin":"màn tiān chè dì","abbr":"mtcd","explanation":"彻：透。弥漫天空，充满地面。形容势头极大。","source":{"text":"隔江炮响，四下火船齐到，但见三江面上，火逐风飞，一派通红，漫天彻地。","book":"明·罗贯中《三国演义》第四十九回"},"example":{"text":"比及石达开兵到时，已是烈焰腾空，～。","book":"清·黄小配《洪秀全演义》第十九回"},"similar":["漫天遍地","漫天匝地"],"opposite":["寥寥无几","寥若晨星"],"usage":"作定语、状语；形容众多而密集"},{"id":30056,"word":"漫天掩地","pinyin":"màn tiān yǎn dì","abbr":"mtyd","explanation":"指铺天盖地。","source":{"text":"苍茫的暮霭，渐渐地漫天掩地的下罩，东方故国送别的情意，涌出一丸冷月安慰我的回望。","book":"瞿秋白《饿乡纪程》"},"similar":["漫天塞地","铺天盖地"],"usage":"作定语、状语；用于数量多"},{"id":30057,"word":"漫天漫地","pinyin":"màn tiān màn dì","abbr":"mtmd","explanation":"漫：满。充满天地之间。形容数量极多，到处都是。","source":{"text":"可早漫地漫天，更扑头扑面，雪拥就浪千堆。","book":"元·谷子敬《城南柳》第三折"},"example":{"text":"南宋末造，蒙古兵势，～盖来，又加以谋勇，如何御得他。","book":"明·朱国桢《涌幢小品·大劫运》"},"similar":["漫地漫天"],"usage":"作定语、状语；用于书面语"},{"id":30058,"word":"漫天盖地","pinyin":"màn tiān gài dì","abbr":"mtgd","explanation":"指遍布天地之间。","source":{"text":"隔江炮响，四下火船齐到，但见三江面上，火逐风飞，一派通红，漫天彻地。","book":"明·罗贯中《三国演义》第四十九回"},"example":{"text":"半山里树顶上，胡先看见岳统制败回，后边～的番兵赶来。","book":"清·钱彩《说岳全传》第二十三回"},"similar":["漫天彻地","漫天遍地","漫天匝地"],"opposite":["零零星星"],"usage":"作定语、状语；形容众多而密集"},{"id":30059,"word":"漫天蔽野","pinyin":"màn tiān bì yě","abbr":"mtby","explanation":"犹铺天盖地。形容盛多。","source":{"text":"倩南枝早报先春，飘绵坠粉，任漫天蔽野休阻闲人。","book":"明·陈大声《普天乐·四景题情》"},"similar":["漫山遍野","漫天塞地"],"usage":"作定语、状语；用于数量多"},{"id":30060,"word":"漫天要价","pinyin":"màn tiān yào jià","abbr":"mtyj","explanation":"无限度地乱要价。形容所提出的条件、要求过高。","source":{"text":"这个计划，也是精打细算搞出来的，并非漫天要价之作。","book":"《人民日报》1981.2.11"},"example":{"text":"你～，工商人员会收拾你的。"},"similar":["漫天开价","漫天叫价"],"opposite":["童叟无欺"],"usage":"作谓语、宾语；指无限度地乱开价码"},{"id":30061,"word":"漫天要价，就地还钱","pinyin":"màn tiān yào jià，jiù dì huán qián","abbr":"mtyjjdhq","explanation":"漫天：比喻非常高；要：索取；地：比喻非常低。指商业上的讨价还价，卖方把售价要得很高，买方则把价钱还得很低。","source":{"text":"漫天要价，就地还钱，原是买物之人向来俗谈。","book":"清·李汝珍《镜花缘》第十一回"}},{"id":30062,"word":"漫天过海","pinyin":"màn tiān guò hǎi","abbr":"mtgh","explanation":"形容没有边际。","source":{"text":"文学的特点之一是夸张，而夸张有时是漫天过海，无止无休的。","book":"孙犁《秀露集·耕堂读书记》"},"similar":["无边无际"],"usage":"作宾语、定语；同“无边无际”"},{"id":30063,"word":"漫天遍地","pinyin":"màn shān biàn dì","abbr":"mtbd","explanation":"满山遍满山遍野，形容数量多、分布广。","source":{"text":"我上高阜处观望辽兵，其势浩大，漫天遍地而来。","book":"明·施耐庵《水浒传》第88回"},"example":{"text":"春天来了，～都是杜鹃花。"},"similar":["满山遍野","漫天匝地"],"opposite":["寥寥无几","零零星星"],"usage":"作定语、状语；形容众多而密集"},{"id":30064,"word":"漫天遍野","pinyin":"màn shān biàn yě","abbr":"mtby","explanation":"满山遍野，形容数量多、分布广。","source":{"text":"这星罗棋布、漫天遍野的一团团火光，会把我们新的万里征途，照耀得多么光明，多么灿烂！","book":"冰心《颂“一团火”》"},"example":{"text":"这儿～都是野菊花。"},"similar":["漫山遍野"],"opposite":["星星点点"],"usage":"作定语、状语；形容多"},{"id":30065,"word":"漫天风雪","pinyin":"màn tiān fēng xuě","abbr":"mtfx","explanation":"漫天：满天。满天的风雪。形容风雪很大，弥漫了天空。","source":{"text":"漫天风雪纷纷闇，到地空花片片明。","book":"宋·洪朋《喜雪》"}},{"id":30066,"word":"漫山塞野","pinyin":"màn shān sāi yě","abbr":"mssy","explanation":"山上和田野里到处都是。形容很多。同“漫山遍野”。","source":{"text":"操大怒曰：‘诸葛村夫，安敢如此！’催动三军，漫山塞野，尽至新野下寨。","book":"明·罗贯中《三国演义》第41回"},"similar":["漫山遍野"],"opposite":["寥寥无几"],"usage":"作谓语、定语、状语；形容人或动植物"},{"id":30067,"word":"漫山遍野","pinyin":"màn shān biàn yě","abbr":"msby","explanation":"漫：满；遍：到处。山上和田野里到处都是。形容很多。","source":{"text":"西凉州前部先锋马岱，引军一万五千，浩浩荡荡漫山遍野而来。","book":"明·罗贯中《三国演义》第五十八回"},"example":{"text":"春天来了，～都披上了绿装。"},"similar":["比比皆是","俯拾即是"],"opposite":["寥寥无几","寥若晨星"],"usage":"作谓语、定语、状语；形容人或动植物"},{"id":30068,"word":"漫无止境","pinyin":"màn wú zhǐ jìng","abbr":"mwzj","explanation":"指永远不会停止或没有边际。","example":{"text":"科学技术的发展是～的。"}},{"id":30069,"word":"漫无边际","pinyin":"màn wú biān jì","abbr":"mwbj","explanation":"形容非常广阔，一眼望不到边。也指谈话或写文章没有中心，离题很远。","source":{"text":"只向黎说了一些海阔天空、漫无边际的话。","book":"陶菊隐《北洋军阀统治时期史话》第24章"},"example":{"text":"我们一望～的大海，感觉自己很渺小。"},"similar":["漫无止境"],"usage":"作定语、状语；用于谈话方面"},{"id":30070,"word":"漫条斯理","pinyin":"màn tiáo sī lǐ","abbr":"mtsl","explanation":"慢条斯理，形容动作缓慢，不慌不忙。","source":{"text":"公子正在那里检点那些考具的东西，听见老爷的话，便过来规规矩矩，漫条斯理的说道：‘这话还得请父亲斟酌。’","book":"清·文康《儿女英雄传》第一回"},"example":{"text":"他那～的性格真让人着急。"},"similar":["慢条斯理"],"opposite":["快马加鞭"],"usage":"作谓语、定语、状语；形容做事缓慢"},{"id":30071,"word":"漫漫长夜","pinyin":"màn màn cháng yè","abbr":"mmcy","explanation":"漫漫：无边际的样子。漫长的黑夜无边无际。多用来比喻社会的黑暗。","source":{"text":"生不逢尧与舜禅，短布单衣才至骭，从昏饭牛薄夜半，长夜漫漫何时旦。","book":"《古诗源·宁戚〈饭牛歌〉》"}},{"id":30072,"word":"漫藏诲盗","pinyin":"màn cáng huì dào","abbr":"mchd","explanation":"指因保管疏忽而招致盗窃。","source":{"text":"慢藏诲盗，冶容诲淫。","book":"《易·系辞上》"}},{"id":30073,"word":"漫诞不稽","pinyin":"màn dàn bù jī","abbr":"mdbj","explanation":"漫：随意；不稽：没有根据。随便乱说，荒诞不实，没有根据。","source":{"text":"其为漫诞不稽，无足疑者。","book":"宋·洪迈《容斋随笔·史记世次》"},"similar":["荒诞不经"],"usage":"作谓语、定语；指没有根据"},{"id":30074,"word":"漱流枕石","pinyin":"shù liú zhěn shí","abbr":"slzs","explanation":"犹言漱石枕流。旧时指隐居生活。","source":{"text":"王曰：‘流可枕，石可漱乎？’孙曰：‘所以枕流，欲洗其耳；所以漱石，欲砺其齿。’","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"文博之～，铲迹销声。","book":"《晋书·儒林传论》"},"similar":["漱石枕流"],"usage":"作谓语、定语；指隐居生活","story":["孙子荆年轻时不想当官，准备过隐居生活，他告诉王武子“当漱石枕流”，实际上应该说“漱流枕石”。王武子乐了，笑他用石头漱口、用泉水作枕头。孙子荆只好辩解说：“用泉水作枕头可以洗耳，用石头漱口可以磨牙。”"]},{"id":30075,"word":"漱石枕流","pinyin":"shù shí zhěn liú","abbr":"sszl","explanation":"旧时指隐居生活。","source":{"text":"王曰：‘流可枕，石可漱乎？’孙曰：‘所以枕流，欲洗其耳；所以漱石，欲砺其齿。’","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"～，放浪形骸之外。","book":"清·张潮《序》"},"similar":["漱流枕石"],"usage":"作谓语、定语；指隐居生活","story":["孙子荆年轻时不想当官，准备过隐居生活，他告诉王武子“当漱石枕流”，实际上应该说“漱流枕石”。王武子乐了，笑他用石头漱口、用泉水作枕头。孙子荆只好辩解说：“用泉水作枕头可以洗耳，用石头漱口可以磨牙。”"]},{"id":30076,"word":"潇洒风流","pinyin":"xiāo sǎ fēng liú","abbr":"xsfl","explanation":"气度超脱，风度大方。亦作“风流潇洒”。","source":{"text":"几年踪迹叹江湖，潇洒风流人怎知。","book":"明·谢谠《四喜记·诗礼趋庭》"},"example":{"text":"臭花娘见他美如冠玉，～的，心里也十分爱慕。","book":"清·张南庄《何典》第七回"},"similar":["风流潇洒"],"usage":"作谓语、定语；指气度洒脱超逸"},{"id":30077,"word":"潇潇洒洒","pinyin":"xiāo xiāo sǎ sǎ","abbr":"xxss","explanation":"指人的举止自然大方，不呆板，不拘束。","source":{"text":"潇潇洒洒，密密沉沉。潇潇洒洒，如天边附落明珠；密密沉沉，似海口倒悬滚浪。","book":"明·许仲琳《封神演义》第64回"},"example":{"text":"高阳《胡雪岩全传·灯火楼台》：“然后挑了个空闲的日子，轻装简从，～地去看罗四姐的母亲。”"},"opposite":["畏畏缩缩"],"usage":"作定语、状语；用于人处事"},{"id":30078,"word":"潘文乐旨","pinyin":"pān wén lè zhǐ","abbr":"pwlz","explanation":"指美好文章的文辞与意旨。","source":{"text":"广善清言而不长于笔，将让尹，请潘岳为表。岳曰：‘当得君意。’广乃作二百句语，述己之志。岳因取次比，便成名笔。时人咸云：‘若广不假岳之笔，岳不取广之旨，无以成斯美也。’","book":"《晋书·乐广传》"},"example":{"text":"雅擅～，妙参羊体嵇心。","book":"清·吴伟业《偶成》诗之八"},"usage":"作宾语、定语；用于书面语","story":["晋朝时期，乐广擅长清言，却不能操笔，在即将离开尹任时，请潘岳作表。潘岳说：“当得君意。”乐广于是口述二百多句话来表述自己的心志。潘岳加以整理，就成名作。当时人评论说：“若广不假岳之笔，岳不取广之旨，无以成斯美也。”"]},{"id":30079,"word":"潘杨之睦","pinyin":"pān yáng zhī mù","abbr":"pyzm","explanation":"潘岳妻杨氏，为杨绥之姑，属于世亲联姻。指有姻亲关系。","source":{"text":"潘杨之睦，有自来矣。","book":"晋·潘岳《杨仲武诔》"},"example":{"text":"～可遵，凤凰之兆斯在。","book":"唐·皇甫枚《王知古》"},"usage":"作主语、宾语；用于书面语"},{"id":30080,"word":"潘江陆海","pinyin":"pān jiāng lù hǎi","abbr":"pjlh","explanation":"形容人诗文方面的才华横溢。","source":{"text":"陆（陆机）才如海，潘（潘岳）才如江。","book":"南朝·梁·锺嵘《诗品》卷上"},"example":{"text":"密纬（钱密纬）肆力于辞赋，～，沾丐一时。","book":"清·钱谦益《〈钱集之遗稿〉序》"},"similar":["陆海潘江"],"usage":"作宾语；比喻有文才的人"},{"id":30081,"word":"潘郎车满","pinyin":"pān láng chē mǎn","abbr":"plcm","explanation":"潘安的车上装满果子。形容美男子受到女性的青睐。","source":{"text":"安仁至美，每行，老妪以果掷之满车。","book":"南朝·宋·刘义庆《世说新语·容止》：“潘岳妙有姿容，好神情。少时挟弹出洛阳道，妇人遇者，莫不连手共萦之。”刘孝标注引《语林》"},"example":{"text":"你不会羡慕～吧。"},"similar":["掷果潘安"],"usage":"作宾语、定语；指美男受青睐","story":["晋朝时期，荥阳中牟人潘岳（人称潘安）长得十分漂亮，文才出众，20岁就进京城洛阳做官。他经常乘坐华丽的车子到郊外去打猎。一路上被许多妇女围观，就连老太婆也争着往他车上投掷果品表达爱慕之情，每次回来都是满载而归"]},{"id":30082,"word":"潘陆江海","pinyin":"pān lù jiāng hǎi","abbr":"pljh","explanation":"陆：晋代诗人陆机；潘：晋代诗人潘岳。比喻有文才的人。","source":{"text":"郁郁闲缛锦之文，飘飘竦陵之气，班贾金玉，未可同年，潘陆江海，宁堪方驾。","book":"唐·陈子良《辨正论序》"},"similar":["陆海潘江"],"usage":"作宾语；比喻有文才的人"},{"id":30083,"word":"潘鬓成霜","pinyin":"pān bìn chéng shuāng","abbr":"pbcs","explanation":"指人到中年鬓发初白。","source":{"text":"余春秋三十有二，始见二毛。……斑鬓髟以承弁兮，素发飒以垂领。","book":"晋·潘岳《秋兴赋并序》"},"example":{"text":"我则待养浩然袁门积雪，久以后空嗟叹得～。","book":"元·无名氏《醉写赤壁赋》第一折"},"similar":["人到中年"],"usage":"作状语、定语；指人到中年"},{"id":30084,"word":"潘鬓沈腰","pinyin":"pān bìn shěn yāo","abbr":"pbsy","explanation":"潘鬓：晋潘岳年始三十二岁，即生白发；沈腰：南朝梁沈约老病，百余日中，腰带数移孔。形容身体消瘦，头发斑白。","source":{"text":"拼得个潘鬓沈腰，摇落悠悠千里。","book":"明·胡文焕《群音类选·清腔类·步步娇》"},"similar":["沈腰潘鬓"],"usage":"作宾语、定语；形容身体过早衰弱"},{"id":30085,"word":"潜休隐德","pinyin":"qián xiū yǐn dé","abbr":"qxyd","explanation":"指隐藏美德。","source":{"text":"而推荣二代，潜休隐德，见称于圣主，而大白于四方。","book":"明·方孝孺《宋氏为善堂记》"},"similar":["潜光隐德"],"usage":"作谓语、宾语、定语；用于处事"},{"id":30086,"word":"潜光匿曜","pinyin":"qián guāng nì yào","abbr":"qgny","explanation":"隐藏光采。常指隐居。同“潜光隐耀”。","source":{"text":"自双树八枝，潜光匿曜；宝城不梓，慧扇方掩。","book":"南朝·梁·王僧孺《忏悔礼佛文》"},"similar":["潜光隐耀"],"usage":"作谓语、宾语、定语；用于处世"},{"id":30087,"word":"潜光隐德","pinyin":"qián guāng yǐn dé","abbr":"qgyd","explanation":"指隐藏德才。","source":{"text":"众经数论，靡不通达，而潜光隐德，世莫之知。","book":"南朝·梁·慧皎《高僧传·道渊》"},"similar":["潜光隐耀"],"usage":"作谓语、宾语、定语；用于处事"},{"id":30088,"word":"潜光隐耀","pinyin":"qián guāng yǐn yào","abbr":"qgyy","explanation":"隐藏光采。常指隐居。","source":{"text":"又南山四皓有园公、夏黄公，潜光隐耀，世嘉其高，皆悉称公。","book":"《后汉书·郑玄传》"},"example":{"text":"～，内修秘密，深诚所诣，远属灵人，可谓感而遂通矣。","book":"《太平广记》卷十五引前蜀杜光庭《神仙感遇传·真白先生》"},"similar":["潜光隐德","潜光匿曜"],"usage":"作谓语、宾语、定语；用于处世"},{"id":30089,"word":"潜台词","pinyin":"qián tái cí","abbr":"qtc","explanation":"戏剧的台词中没有直接说出但观众通过思考都能领悟得出来的言语。比喻不明说的言外之意。","example":{"text":"他的～我们都明白。"},"similar":["言外之意"],"usage":"作宾语、定语；用于口语"},{"id":30090,"word":"潜图问鼎","pinyin":"qián tú wèn dǐng","abbr":"qtwd","explanation":"三代以九鼎为传国宝，楚子向王孙满问鼎，有觊觎周室之意。比喻暗地里企图篡夺。","source":{"text":"假托妖巫，用相震惑，妄设徵祥，潜图问鼎。","book":"《左传·宣公三年》：“楚子伐陆浑之戎，遂至于雒，观兵于周疆。定王使王孙满劳楚子，楚子问鼎之大小轻重焉。”南朝·齐·萧赜《诛张敬儿诏》"},"usage":"作谓语、定语；用于书面语","story":["春秋时期，楚庄王陈兵于洛水，向周王朝示威。周定王派王孙满去犒劳楚子，楚子(楚庄王)问王孙满王室中鼎的大小轻重，显示楚庄王有夺取周朝天下的野心。因为夏商周三代以九鼎为传国之宝，问鼎就是有野心谋位"]},{"id":30091,"word":"潜山隐市","pinyin":"qián shān yǐn shì","abbr":"qsys","explanation":"指潜身于山林，隐迹于市井。","source":{"text":"处士之名，何哉？潜山隐市，皆处士也。","book":"唐·杜牧《送薛处士序》"},"usage":"作定语、宾语；指隐居"},{"id":30092,"word":"潜师袭远","pinyin":"qián shī xí yuǎn","abbr":"qsxy","explanation":"潜师：秘密调动兵力。秘密发兵，袭击远距离的敌人。","source":{"text":"杞子自郑使告于秦，曰：‘郑人使我掌其北门之管，若潜师以来，国可得也。’","book":"《左传·僖公三十二年》"}},{"id":30093,"word":"潜形匿影","pinyin":"qián xíng nì yǐng","abbr":"qxny","explanation":"隐蔽形迹，不露真相。同“潜形匿迹”。","source":{"text":"为民者以寇戎视其吏，潜形匿影，日虞怀壁之为殃。","book":"《文献通考·职役二》"},"example":{"text":"大；略以为千里而袭人必～，乘其不备，而后可以得志。","book":"明·唐顺之《答曾石塘总制书》之三"},"similar":["潜形匿迹","潜形谲迹"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":30094,"word":"潜形匿迹","pinyin":"qián xíng nì jì","abbr":"qxnj","explanation":"潜：隐藏。隐藏形迹，不使人知。","source":{"text":"持法清峻，犯之者无宥，有严张之风也。狡吏奸豪，潜形匿迹。","book":"宋·王谠《唐语林·豪爽》"},"example":{"text":"或会徒于广信鹅湖之寺，或呈身于长沙敬简之堂，～，如鬼如魅。","book":"清·毕沅《续资治通鉴》卷一百五十四"},"similar":["潜形谲迹","潜形匿影"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":30095,"word":"潜形谲迹","pinyin":"qián xíng jué jì","abbr":"qxjj","explanation":"隐蔽形迹，不露真相。同“潜形匿迹”。","source":{"text":"潜形谲迹托梦寐，变幻涕泪成琼瑰。","book":"明·刘基《巫山高》诗"},"similar":["潜形匿迹","潜形匿影"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":30096,"word":"潜德秘行","pinyin":"qián dé mì xíng","abbr":"qdmx","explanation":"指不为人知的德行。同“潜德隐行”。","source":{"text":"其绩用昭著者，易于言；而潜德秘行者，难于形容也。","book":"明·宋濂《陈府君墓志铭》"},"similar":["潜德隐行"],"usage":"作宾语、定语；指人的德行"},{"id":30097,"word":"潜德隐行","pinyin":"qián dé yǐn xíng","abbr":"qdyx","explanation":"指不为人知的德行。","source":{"text":"士之为善者，虽潜德隐行，必有时而发。","book":"宋·欧阳修《右班殿直赠右羽林军将军唐君墓志铭》"},"similar":["潜德秘行"],"usage":"作谓语、宾语、定语；指人的德行"},{"id":30098,"word":"潜心涤虑","pinyin":"qián xīn dí lǜ","abbr":"qxdl","explanation":"指专心致志。","source":{"text":"[达尔文]千百四十二年，遂去伦敦，卜居于京特省附近之一村落，屏绝尘俗，潜心涤虑，将航海五年内所搜之材料，所悟之新说，整齐之，锻炼之。","book":"梁启超《天演学初祖尔文之学说及其略传》"},"similar":["专心致志","聚精会神"],"usage":"作谓语、定语、状语；指聚精会神"},{"id":30099,"word":"潜心笃志","pinyin":"qián xīn dǔ zhì","abbr":"qxdz","explanation":"指专心致志。","source":{"text":"潜心笃志同参佛，努力修身共炼魔。","book":"明·吴承恩《西游记》第77回"},"similar":["专心致志"],"usage":"作谓语、状语；用于人"},{"id":30100,"word":"潜消默化","pinyin":"qián xiāo mò huà","abbr":"qxmh","explanation":"指暗地消除。","source":{"text":"而潜消默化者，又不可以枚举也。","book":"明·吴承恩《赠郡伯古愚邵公报政序》"},"usage":"作谓语、定语；用于事物等"},{"id":30101,"word":"潜深伏隩","pinyin":"qián shēn fú yù","abbr":"qsfa","explanation":"潜：隐匿；隩：河岸弯曲的地方。形容潜藏深处，不出头露面。","source":{"text":"行自念方当远去，潜深伏隩，与时世不相闻。","book":"唐·韩愈《答侯继书》"},"usage":"作谓语、定语；用于书面语"},{"id":30102,"word":"潜滋暗长","pinyin":"qián zī àn zhǎng","abbr":"qzaz","explanation":"潜：暗中，隐藏；滋：生长。暗暗地不知不觉地生长。","source":{"text":"你对当前的‘雄壮’或‘伟大’闭了眼，而另一种的味儿在你心头潜滋暗长了——‘单调’。","book":"茅盾《白杨礼赞》"},"usage":"作谓语、定语；用于事物等"},{"id":30103,"word":"潜濡默化","pinyin":"qián rú mò huà","abbr":"qrmh","explanation":"犹潜移默化。指人的思想或性格不知不觉受到感染、影响而发生了变化。","source":{"text":"今就湘省而论，军学界革命思想，日见发达，市民亦潜濡默化。","book":"刘揆一《黄兴传记》"},"similar":["潜濡默被","潜移默化"],"usage":"作定语、状语；用于人的思想、作风等"},{"id":30104,"word":"潜濡默被","pinyin":"qián rú mò bèi","abbr":"qrmb","explanation":"犹潜移默化。指人的思想或性格不知不觉受到感染、影响而发生了变化。","source":{"text":"惟夫浚德渊微，潜濡默被，出于至诚，而泯于无迹。","book":"明·文征明《王武宁去思颂》"},"similar":["潜移默化","潜濡默化"],"usage":"作定语、状语；用于人的思想、作风等"},{"id":30105,"word":"潜神嘿规","pinyin":"qián shén hēi guī","abbr":"qshg","explanation":"指专心谋划。","source":{"text":"愿陛下抑威任计，暂宁六师，潜神嘿规，以为后图。","book":"宋·司马光《资治通鉴·魏明帝青龙元年》"},"usage":"作谓语、定语；用于书面语"},{"id":30106,"word":"潜神默思","pinyin":"qián shén mò sī","abbr":"qsms","explanation":"指专心致志，认真思索。","source":{"text":"臣窃亮陛下潜神默思，公听并观，若事有未尽于理而物有未周于用，将改曲易调。","book":"《三国志·魏志·蒋济传》"},"usage":"作谓语、定语；用于书面语"},{"id":30107,"word":"潜神默记","pinyin":"qián shén mò jì","abbr":"qsmj","explanation":"指心神专一，默默记诵。","source":{"text":"独摅意乎宇宙之外，锐思于毫芒之内，潜神默记，縆以年岁。","book":"汉·班固《答宾戏》"},"usage":"作谓语、定语；用于书面语"},{"id":30108,"word":"潜移嘿夺","pinyin":"qián yí hēi duó","abbr":"qyhd","explanation":"指不露形迹地改变或取得。同“潜移默夺”。","source":{"text":"今观五季相禅，潜移嘿夺，纵有兵革，不闻争城。","book":"明·李贽《藏书·外臣传·冯道》"},"similar":["潜移默夺","潜移阴夺"],"usage":"作谓语、状语；用于书面语"},{"id":30109,"word":"潜移暗化","pinyin":"qián yí àn huà","abbr":"qyah","explanation":"潜：暗中，不见形迹。指人的思想或性格不知不觉受到感染、影响而发生了变化。","source":{"text":"潜移暗化，自然似之。","book":"北齐·颜之推《颜氏家训·慕贤》"},"similar":["潜移默化"],"usage":"作定语、状语；用于人的思想、作风等"},{"id":30110,"word":"潜移阴夺","pinyin":"qián yí yīn duó","abbr":"qyyd","explanation":"夺：争取。指不露形迹地改变或取得。","source":{"text":"初每事独断，今戚里左右，或潜移阴夺。","book":"《明史·余珊传》"},"similar":["潜移默夺","潜移嘿夺"],"usage":"作谓语、状语；用于书面语"},{"id":30111,"word":"潜移默化","pinyin":"qián yí mò huà","abbr":"qymh","explanation":"潜：暗中同，不见形迹；默：不说话，没有声音。指人的思想或性格不知不觉受到感染、影响而发生了变化。","source":{"text":"潜移暗化，自然似之。","book":"北齐·颜之推《颜氏家训·慕贤》"},"example":{"text":"民众文学当有一种“～”之功，以纯正的博大的趣味，替代旧有读物、戏剧等底不洁的、褊狭的趣味。","book":"朱自清《民众文学的讨论》"},"similar":["耳濡目染","近朱者赤","潜移暗化"],"opposite":["洁身自好","无动于衷"],"usage":"作定语、状语；用于人的思想、作风等"},{"id":30112,"word":"潜移默夺","pinyin":"qián yí mò duó","abbr":"qymd","explanation":"指不露形迹地改变或取得。","source":{"text":"然有养之、厚之、节之、教之、不伤之，所不能及者，故必有潜移默夺于冥冥之中。","book":"明·归有光《〈洪范〉传》"},"example":{"text":"想当时纶扉之地～，华亭因不肯归美于人，先文靖亦不以告人也。","book":"清·严有禧《漱华随笔·先文靖》"},"similar":["潜移嘿夺"],"usage":"作谓语、宾语、状语；用于书面语"},{"id":30113,"word":"潜移默转","pinyin":"qián yí mò zhuǎn","abbr":"qymz","explanation":"不露行迹、自然而然地转移或转变。同“潜移默运”。","source":{"text":"希腊之文明，潜移默转，而入于罗马。","book":"梁启超《亚洲地理大势论》"},"similar":["潜移默运"],"usage":"作谓语、定语；用于书面语"},{"id":30114,"word":"潜移默运","pinyin":"qián yí mò yùn","abbr":"qymy","explanation":"不露行迹、自然而然地转移或转变。","source":{"text":"其潜移默夺，保全善类，天下阴受其庇，而气节之士多非之。","book":"《明史·李东阳传》"},"example":{"text":"盖～，销之于未然，转之于不觉，救人而无救之迹，岂非重袭不露之天明乎？","book":"清·魏源《老子本义注》"},"similar":["潜移默转"],"usage":"作谓语、定语；用于书面语"},{"id":30115,"word":"潜窃阳剽","pinyin":"qián qiè yáng piāo","abbr":"qqyp","explanation":"公开或不公开地剽窃。","source":{"text":"今天下学者靡靡焉，惟习之所同；潜窃阳剽，无所顾忌。","book":"明·方孝孺《答张廷璧书》"},"usage":"作谓语、宾语、定语；用于作品等"},{"id":30116,"word":"潜精研思","pinyin":"qián jīng yán sī","abbr":"qjys","explanation":"指专心钻研。","source":{"text":"固以彪所续前史未详，乃潜精研思，欲就其业。","book":"南朝·宋·范晔《后汉书·班固传》"},"similar":["潜精积思"],"usage":"作谓语、定语、宾语；用于学术等"},{"id":30117,"word":"潜精积思","pinyin":"qián jīng jī sī","abbr":"qjjs","explanation":"指专心钻研。同“潜精研思”。","source":{"text":"潜精积思二十余年，至建初中乃成。","book":"南朝·宋·范晔《后汉书·班固传》"},"similar":["潜精研思"],"usage":"作谓语、定语、宾语；用于学术等"},{"id":30118,"word":"潜蛟困凤","pinyin":"qián jiāo kùn fèng","abbr":"qjkf","explanation":"潜藏在水中的蛟龙，处于困境的凤凰。比喻英才而不见用，不能有所作为。","source":{"text":"有日皇风动，黎民欢颂，那里呵，看潜蛟困凤，终须腾踊。","book":"明·王士桢《鸣凤记·邹慰夏孤》"},"usage":"作宾语、定语；用于比喻句"},{"id":30119,"word":"潜踪匿影","pinyin":"qián zōng nì yǐng","abbr":"qzny","explanation":"隐蔽踪迹。","source":{"text":"潜踪匿影，方暗中扪壁窃行，突火光一掣，朗若月明。","book":"清·纪昀《阅微草堂笔记·姑妄听之》"},"similar":["潜形匿影","潜踪蹑迹"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":30120,"word":"潜踪蹑迹","pinyin":"qián zōng niè jì","abbr":"qznj","explanation":"指藏匿行踪。","source":{"text":"听得谯楼鼓二更，是我潜踪蹑迹，欲刺权臣。","book":"明·徐元《八义记·锄麑触槐》"},"similar":["潜踪隐迹","潜踪匿影"],"usage":"作谓语、宾语；用于隐居"},{"id":30121,"word":"潜踪隐迹","pinyin":"qián zōng yǐn jì","abbr":"qzyj","explanation":"指潜伏躲藏，隐蔽行踪。","source":{"text":"你们因何不耍不顽，一个个都潜踪隐迹？","book":"明·吴承恩《西游记》第二十八回"},"example":{"text":"前日诛仙阵上已见雌雄，只当～，自己修过，以忏往愆，方是掌教之主。","book":"明·许仲琳《封神演义》第八十二回"},"similar":["潜踪蹑迹"],"usage":"作谓语、宾语；用于隐居"},{"id":30122,"word":"潜身缩首","pinyin":"qián shēn suō shǒu","abbr":"qsss","explanation":"潜：深藏；首：头。隐居不出头露面。","source":{"text":"汝既为谄谀之臣，只可潜身缩首，苟图衣食。","book":"明·罗贯中《三国演义》第92回"},"similar":["潜身远迹"],"opposite":["抛头露面"],"usage":"作谓语、宾语；指隐居"},{"id":30123,"word":"潜身远祸","pinyin":"qián shēn yuǎn huò","abbr":"qsyh","explanation":"指隐藏潜伏，远避祸害。","source":{"text":"君子阳阳，闵周也。君子遭乱，相招为禄仕，全身远害而已。","book":"《诗经·王风·君子阳阳序》"},"example":{"text":"再让她就如妙手空空儿一般报了仇，竟有那本领～，她又是个女孩儿家，难道还披发入山不成？","book":"清·文康《儿女英雄传》第十六回"},"usage":"作谓语、宾语、定语；用于逃避"},{"id":30124,"word":"潜身远迹","pinyin":"qián shēn yuǎn jì","abbr":"qsyj","explanation":"指隐居避世，不露踪迹。","source":{"text":"窃见居巢侯刘般嗣子恺，素行孝友，谦让洁清，让封弟宪，潜身远迹，有司不原乐善之心。","book":"汉·贾逵《上书请宥刘恺》"},"similar":["潜身缩首"],"usage":"作谓语、宾语；指隐居"},{"id":30125,"word":"潜遁幽抑","pinyin":"qián dùn yōu yì","abbr":"qdyy","explanation":"潜遁：隐匿、躲藏；幽抑：幽居。逃避世俗，过隐居生活。","source":{"text":"潜遁幽抑之士，其谁不有望于世。","book":"宋·曾巩《寄欧阳舍人书》"}},{"id":30126,"word":"潜骸窜影","pinyin":"qián hái cuàn yǐng","abbr":"qhcy","explanation":"指隐匿躲藏，不敢露面。","source":{"text":"刘昶猜疑惧祸，萧夤亡破之余，并潜骸窜影，委命上国。","book":"《魏书·刘昶等传论》"},"similar":["潜形匿迹"],"usage":"作谓语、定语；用于书面语"},{"id":30127,"word":"潜鳞戢羽","pinyin":"qián lín jí yǔ","abbr":"qljy","explanation":"指隐藏形迹。","source":{"text":"潜鳞戢羽，幸舟逢鄂君。","book":"明·张煌言《曹云霖中丞〈从龙诗集〉序》"},"usage":"作谓语、宾语；用于比喻句"},{"id":30128,"word":"潜龙伏虎","pinyin":"qián lóng fú hǔ","abbr":"qlfh","explanation":"藏在深渊中的蛟龙，伏于丛莽中的猛虎。比喻未被使用的人才。","source":{"text":"今日里笔生香，冠礼闱，似潜龙伏虎际风云会。","book":"明·何文焕《双珠记·西市认母》"},"example":{"text":"我们要充分发掘人才，～都不能放过。"},"usage":"作宾语、定语；比喻未受赏识的人才"},{"id":30129,"word":"潜龙勿用","pinyin":"qián lóng wù yòng","abbr":"qlwy","explanation":"蛟龙隐伏而不为世所知。比喻人才埋没未被重用。","source":{"text":"初九，潜龙勿用。","book":"《周易·乾》"},"example":{"text":"函崤重险，钟鼎沦覆，～，瞻乌在室。","book":"北周·王褒《太傅燕文公于谨碑铭》"},"usage":"作宾语、定语；用于人才不被重用"},{"id":30130,"word":"潢池弄兵","pinyin":"huáng chí nòng bīng","abbr":"hcnb","explanation":"潢池：积水塘；弄兵：玩弄兵器。旧时对人民起义的蔑称。也指发动兵变。","source":{"text":"其民困于饥寒而吏不恤，故使陛下赤子盗弄陛下之兵于潢池中耳。","book":"《汉书·龚遂传》"},"example":{"text":"发难首功者，非无稳健智略之人，何取弄兵潢池之陈其美？","book":"章炳麟《致袁世凯商榷官制电二》"},"similar":["潢池盗弄"],"usage":"作谓语、宾语；指叛乱造反","story":["汉朝时期，龚遂任渤海太守，前任官吏不顾百姓的死活，拼命压榨。当地居民困于饥寒交迫而群起反抗。龚遂向汉宣帝上书，将人民的起义说成：“其民困于饥寒而吏不恤，故使陛下赤子盗弄陛下之兵于潢池中耳。”遂采取安抚措施"]},{"id":30131,"word":"潢池盗弄","pinyin":"huáng shi dào nòng","abbr":"hcdn","explanation":"旧时对人民起义的蔑称。也指发动兵变。同“潢池弄兵”。","source":{"text":"猬锋螗斧，潢池盗弄何为哉！","book":"清·纪昀《阅微草堂笔记·滦阳续录二》"},"example":{"text":"即此残民以逞，窃恐官力愈强，民心愈涣，～，谁为厉阶。","book":"中国近代史资料丛刊《辛亥革命·武昌起义清方档案·清吏条陈》"},"similar":["潢池弄兵"],"usage":"作谓语、宾语；指叛乱造反"},{"id":30132,"word":"潢潦可荐","pinyin":"huáng liáo kě jàn","abbr":"hlkj","explanation":"荐：祭祀。指祭祀在于虔敬，而不在于祭品的厚薄。","source":{"text":"筐筥锜釜之器，潢污行潦之水，可荐于鬼神，可羞于王公。","book":"《左传·隐公三年》"},"usage":"作宾语、定语；用于书面语"},{"id":30133,"word":"潦倒粗疏","pinyin":"liǎo dǎo cū shū","abbr":"ldcs","explanation":"潦倒：颓丧，不得意。形容颓丧，放任散漫。","source":{"text":"足下旧知吾潦倒粗疏，不切事情，自惟亦皆不如今日之贤能也。","book":"三国·魏·嵇康《与山巨源绝交书》"}},{"id":30134,"word":"潦倒龙钟","pinyin":"liǎo dǎo lóng zhōng","abbr":"ldlz","explanation":"潦倒：颓丧，不得意；龙钟：年老体衰，行动不便的样子。形容年老体弱多病，很不得意。","source":{"text":"潦倒龙钟，百病丛体。","book":"唐·李华《卧病舟中相里范二侍御先行赠别序》"}},{"id":30135,"word":"潦原浸天","pinyin":"lǎo yuán jìn tiān","abbr":"lyjt","explanation":"淹没天地。","source":{"text":"以龙宫蛟窟潦原浸天之物，而欲集区区。","book":"清·侯方域《豫省试策四》"},"usage":"作定语；形容水势大"},{"id":30136,"word":"潦潦草草","pinyin":"liáo liáo cǎo cǎo","abbr":"llcc","explanation":"字不工整或态度不认真。","source":{"text":"我昨日写的潦潦草草，这字龙蛇有体，大是怪事。","book":"清·荻岸山人《平山冷燕》第14回"},"example":{"text":"你去了有四五封信罢？他才～来这么一封信，结婚也不通知你。","book":"钱钟书《围城》"},"opposite":["工工整整"],"usage":"作定语、状语；用于口语"},{"id":30137,"word":"潦草塞责","pinyin":"liáo cǎo sè zé","abbr":"lcsz","explanation":"潦草：草率，不精密，不认真；塞：搪塞。形容做事敷衍了事，马马虎虎，不负责任。","source":{"text":"我向来不爱和韵，今日被他逼住，无可如何，只得潦草塞责，诸兄怎还要谬赞起来，岂非违心之论？","book":"清·张春帆《九尾龟》第十一回"},"example":{"text":"限你不准继烛，把三文一诗作完。吃过晚饭再誊正交卷，却不可～。","book":"清·文康《儿女英雄传》第三十四回"},"similar":["敷衍了事"],"opposite":["认认真真"],"usage":"作谓语、定语；指敷衍了事"},{"id":30138,"word":"潮涨潮落","pinyin":"cháo zhǎng cháo luò","abbr":"czcl","explanation":"比喻事情的起伏变化。","example":{"text":"～，总会有机会的。"},"similar":["潮起潮落"],"usage":"作宾语、定语；指事情的起伏"},{"id":30139,"word":"潮鸣电挚","pinyin":"cháo míng diàn chè","abbr":"cmdz","explanation":"极言气势大、速度快。","source":{"text":"惟见如火如荼之敌军先锋队，挟三倍之势，潮鸣电掣以阵于斯巴达军后。","book":"鲁迅《集外集·斯巴达之魂》"}},{"id":30140,"word":"潮鸣电掣","pinyin":"cháo míng diàn chè","abbr":"cmdc","explanation":"极言气势大、速度炔。","source":{"text":"惟见如火如荼之敌军先锋队，挟三倍之势，潮鸣电掣以阵于斯巴达军后。","book":"鲁迅《集外集·斯巴达之魂》"},"similar":["风驰电掣"],"usage":"作状语；形容速度很快"},{"id":30141,"word":"潸然泪下","pinyin":"shān rán lèi xià","abbr":"srlx","explanation":"潸然：流泪的样子。形容眼泪流下来。","source":{"text":"潸焉出涕。","book":"《诗经·小雅·大东》"},"example":{"text":"林冲见说了，～，自此杜绝了心中挂念。","book":"明·施耐庵《水浒全传》第二十回"},"similar":["热泪盈眶","泪如雨下"],"opposite":["捧腹大笑","眉开眼笑","喜笑颜开"],"usage":"作谓语；用于书面语"},{"id":30142,"word":"澄心涤虑","pinyin":"chéng xīn dí lǜ","abbr":"cxdl","explanation":"澄：澄清；涤虑：清除思虑。澄清思绪，清除思虑。","source":{"text":"吾曹，听劝化，休生懈怠，道念坚牢。在澄心涤虑，勿犯天条。","book":"金·王丹桂《满庭芳·示众》"}},{"id":30143,"word":"澄思寂虑","pinyin":"chéng sī jì lǜ","abbr":"csjl","explanation":"专心思索，冷静考虑。","source":{"text":"乾晖常于郊居畜其禽鸟，每澄思寂虑，玩心其间，偶得意即命笔。","book":"《宣和画谱·花鸟叙论》"},"usage":"作谓语、宾语；指考虑问题"},{"id":30144,"word":"澄思渺虑","pinyin":"chéng sī miǎo lǜ","abbr":"csml","explanation":"指深思远虑。","source":{"text":"然而澄思渺虑，顺事婉陈，虽处危急烦扰之地，而所宣不失其和平。","book":"清·宗稷辰《姚适庵怡柯草堂诗赋抄序》"},"example":{"text":"然后～，以吾身入乎其中而涵泳玩索之。","book":"况周颐《蕙风词话》第一卷"},"similar":["深思熟虑"],"usage":"作谓语；指深思远虑"},{"id":30145,"word":"澄江如练","pinyin":"chéng jiāng rú liàn","abbr":"cjrl","explanation":"澄：清澈，明净。练：洁白的熟绢。清澈的江水，像一条白练一样。多指对江景的鸟瞰。","source":{"text":"余霞散成绮，澄江净如练。","book":"晋·谢朓《晚登三山还望景邑》"},"example":{"text":"正是～处，玄晖应喜见诗人。","book":"唐·李商隐《和韦潘前辈七月十二日夜泊池州城下》"},"usage":"作宾语、定语；形容江水"},{"id":30146,"word":"澄沙汰砾","pinyin":"dèng shā tài lì","abbr":"dstl","explanation":"指除去杂质，使之纯洁。","source":{"text":"志合心齐，如金在熔，澄沙汰砾，以精为同。","book":"清·恽敬《祭张皋文文》"},"similar":["去粗取精"],"usage":"作谓语、定语；指提纯"},{"id":30147,"word":"澄清天下","pinyin":"chéng qīng tiān xià","abbr":"cqtx","explanation":"指整肃政治，清楚奸佞，使天下复归太平。","source":{"text":"陈仲举言为士则，行为世范，登车揽辔，有澄清天下之志。","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"大丈夫当以～为己任。"},"opposite":["豺狼当道"],"usage":"作定语、宾语；指肃清恶势力","story":["东汉乐安太守陈蕃字仲举言行举止堪为社会的典范，登车揽辔有澄清天下的志向，在被贬为豫章太守时，豫章有位贤才徐樨很让陈蕃仰慕，豫章家还没有安顿好就去拜访徐樨。表示要学周武王当年席不暇暖一样去求贤人的帮助"]},{"id":30148,"word":"澄源正本","pinyin":"chéng yuán zhèng běn","abbr":"cyzb","explanation":"澄：澄清。清理水的源头，扶正树的根。比喻从根本解决问题。","source":{"text":"而其所以培壅本根，澄源正本，为异时发挥事业之地者，盖光大而高明矣。","book":"宋·陈亮《附朱熹》"},"similar":["清原正本"],"usage":"作宾语、定语；用于书面语"},{"id":30149,"word":"澄神离形","pinyin":"chéng shén lí xíng","abbr":"cslx","explanation":"形容用心太专，如痴如呆。","source":{"text":"吾朝夕拥书于是，俯读仰思，澄神离形，归对妻儿，慹然若非人。","book":"康有为《大同书》绪言"},"usage":"作谓语、定语；指人很专心"},{"id":30150,"word":"澈底澄清","pinyin":"chè dǐ chéng qīng","abbr":"cdcq","explanation":"指完全清楚，毫无遗漏。","source":{"text":"安太太早把这事告诉了他一个澈底澄清。","book":"《儿女英雄传》第十六回：“如今这个人的来历是澈底澄清的明白了。”又第二三回"},"similar":["彻底澄清"],"usage":"作谓语、宾语；指十分清楚"},{"id":30151,"word":"澌灭无闻","pinyin":"sī miè wú wén","abbr":"smww","explanation":"澌灭：消失干净。形容彻底消失，没有人知道。","source":{"text":"给以花再芳、毕全贞者，盖以群芳沦落，几至澌灭无闻，今赖斯而得不朽，非若花之重芳乎？","book":"清·李汝珍《镜花缘》第四十八回"}},{"id":30152,"word":"澎湃汹涌","pinyin":"péng pài xiōng yǒng","abbr":"ppxy","explanation":"澎湃：大浪互相撞击；汹涌：波涛猛烈地向上涌。形容声势浩大。","source":{"text":"我在人民英雄纪念碑的花海中，徘徊，徘徊复徘徊，半生往事，如钱塘怒涛，澎湃汹涌，冲击心头！","book":"曹靖华《飞花集》"},"similar":["汹涌澎湃","奔腾澎湃"],"usage":"作谓语、定语、状语；指声势浩大"},{"id":30153,"word":"澜倒波随","pinyin":"lán dǎo bō suí","abbr":"ldbs","explanation":"犹言随波逐流。比喻言行无标准。","source":{"text":"第近年以来，传者失真，澜倒波随，所趣日下。","book":"明宋濂《序》"},"example":{"text":"当今学者～，一惟卑陋之归，伯清能尊朱子之学而扶导之，岂非朱子之孝子乎。","book":"《序》"},"similar":["随波逐流"],"usage":"作谓语、宾语；指随波逐流"},{"id":30154,"word":"澡垢索疵","pinyin":"zǎo gòu suǒ cī","abbr":"zgsc","explanation":"犹言吹毛求疵。指刻意寻人过错。","source":{"text":"每受制鞫狱，必澡垢索疵，不入死不止，人畏鄙之。","book":"《新唐书·崔元综传》"},"similar":["吹毛求疵"],"usage":"作谓语、定语；用于书面语"},{"id":30155,"word":"澡慰故俗","pinyin":"zǎo wèi gù sú","abbr":"zwgs","explanation":"澡慰：洗净、熨平。比喻改革旧的风俗","source":{"text":"翁之治蜀，开学校以《诗》、《书》教人，澡慰故俗。","book":"宋·宋祁《成都府新建汉文翁祠堂碑》"},"usage":"作谓语、定语；用于书面语"},{"id":30156,"word":"澡熨故俗","pinyin":"zǎo yùn gù sú","abbr":"zygs","explanation":"澡：洗澡；熨：熨平；故俗：旧俗。指改革旧俗。","source":{"text":"翁之治蜀，开学校以《诗》、《书》教人，澡熨故俗。","book":"宋·宋祁《成都府新建汉文翁祠堂碑》"}},{"id":30157,"word":"澡身浴德","pinyin":"zǎo shēn yù dé","abbr":"zsyd","explanation":"修养身心，使纯洁清白。","source":{"text":"儒有澡身而浴德。","book":"《礼记·儒行》"},"example":{"text":"日逝月除，时方已过，～，将以曷为？","book":"《三国志·魏志·管宁传》"},"similar":["修心养性"],"usage":"作谓语、定语；指人修身"},{"id":30158,"word":"澡雪精神","pinyin":"zǎo xuě jīng shén","abbr":"zxjs","explanation":"澡雪：以雪洗身；精神：清净神志。指通过洗涤清净神志。比喻清除意念中庸俗的东西，使神志、思路保持纯正。","source":{"text":"汝齐戒，疏瀹而心，澡雪而精神。","book":"《庄子·知北游》"},"example":{"text":"是以陶钧文思，贵在虚静，疏瀹五藏，～。（南朝·梁·刘勰《文心雕龙·神思》）"}},{"id":30159,"word":"澧兰沅芷","pinyin":"lǐ lán yuán zhǐ","abbr":"llyz","explanation":"沅、澧：都是水名；兰、芷：都是香草。比喻高洁的人品或高尚的事物。","source":{"text":"沅有茞兮澧有兰。","book":"战国·楚·屈原《九歌·湘夫人》"},"example":{"text":"～无穷竟，况复哀时重自伤。","book":"清·黄遵宪《酬曾重伯编修》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":30160,"word":"澹泊寡欲","pinyin":"dàn bó guǎ yù","abbr":"dbgy","explanation":"澹泊：恬淡；寡：少；欲：欲望。形容心情恬淡，不图名利。","source":{"text":"实澹泊而寡欲兮，独怡乐而长吟。","book":"三国·魏·曹植《蝉赋》"},"similar":["恬淡寡欲"],"usage":"作谓语、定语；用于处世"},{"id":30161,"word":"澹泊明志，宁静致远","pinyin":"dàn bó míng zhì，níng jìng zhì yuǎn","abbr":"dpmznjzy","explanation":"澹泊：不追求名利；宁静：心情平静沉着。不追求名利，生活简朴以表现自己高尚的情趣；心情平稳沉着，专心致志，才可有所作为。","source":{"text":"是故非澹漠无以明志，非宁静无以致远。","book":"汉·刘安《淮南子·主术训》"},"example":{"text":"至于宽闲之野，寂寞之滨，每自寓其天怀之乐，而～，未尝不处处流露。","book":"清·无名氏《杜诗言志》卷三"},"usage":"作宾语、定语；用于处世"},{"id":30162,"word":"激将法","pinyin":"jī jiàng fǎ","abbr":"jjf","explanation":"用反话去激人，促使人决心去做的策略。","source":{"text":"一切敌人的‘挑战书’，旁人的‘激将法’，都应束之高阁，置之不理，丝毫也不为其所动。","book":"毛泽东《论持久战》"},"similar":["请将不如激将"],"usage":"作主语、宾语、定语；用于处事"},{"id":30163,"word":"激忿填膺","pinyin":"jī fèn tián yīng","abbr":"jfty","explanation":"膺：胸。强烈的忿怒填满胸中。形容气愤已极。","source":{"text":"顾其母激忿填膺，寸晷是学，不迨于至，以超圣人之域，焕乎贤者之业。","book":"明·陶宗仪《辍耕录》"},"similar":["义愤填膺"],"usage":"作谓语；形容气愤至极"},{"id":30164,"word":"激扬清浊","pinyin":"jī yáng qīng zhuó","abbr":"jyqz","explanation":"冲去污水，让清水上来。比喻清除坏的，发扬好的。同“激浊扬清”。","source":{"text":"仁则涤荡埃氛，义则激扬清浊。","book":"语出《尸子·君治》：“水有四德……扬清激浊，荡去滓秽，义也。”北周·庚信《温汤碑》"},"similar":["激浊扬清"],"usage":"作谓语、宾语、定语；比喻清除坏的"},{"id":30165,"word":"激昂慷慨","pinyin":"jī áng kāng kǎi","abbr":"jakk","explanation":"精神振奋，情绪激昂，充满正气。","source":{"text":"今将慷慨激昂，奋攘布衣，纵谈作者之筵，曳裾名卿之门。","book":"汉·李陵《录别诗》：“悲意何慷慨，清歌正激扬。”唐·柳宗元《上权德舆补阙温卷决进退启》"},"example":{"text":"况金元院本，演古劝今，情神刻肖，令人～，欢喜悲号，其有功于世不少。","book":"清·郑燮《城隍庙碑记》"},"similar":["慷慨激昂"],"usage":"作谓语、定语；指精神振奋，情绪激昂"},{"id":30166,"word":"激昂青云","pinyin":"ji ang qing yun","abbr":"jaqy","explanation":"奋发意气于青云之上，指痛痛快快地做一番事业。"},{"id":30167,"word":"激流勇退","pinyin":"jī liú yǒng tuì","abbr":"jlyt","explanation":"勇：果敢；退：退却，离去。比喻在官场得意时及时引退，以明哲保身。","source":{"text":"田福军一回来，他就激流勇退，也许会给省委造成一种他尊重上级决定，并且已改变对田福军的看法，支持和信任他放手工作的印象。","book":"路遥《平凡的世界》第三卷第五章"},"similar":["急流勇退"],"usage":"作谓语、宾语、定语；指及时引退"},{"id":30168,"word":"激浊扬清","pinyin":"jī zhuó yáng qīng","abbr":"jzyq","explanation":"激：冲去；浊：脏水；清：清水。冲去污水，让清水上来。比喻清除坏的，发扬好的。","source":{"text":"扬清激浊，荡去滓秽，义也。","book":"《尸子·君治》"},"example":{"text":"待制为官，尽忠报国，～。","book":"元·无名氏《陈州粜米》第二折"},"similar":["彰善瘅恶","隐恶扬善"],"opposite":["讳疾忌医"],"usage":"作谓语、宾语、定语；比喻清除坏的","story":["西晋时期司空从事中郎牵秀好说大话，他说如果他居于督察百官的地位，就一定像冲除脏水浮上清水那样除掉恶人奖励好人。他只是说说而已，实际上并没有那样去做。在“八王之乱”中，作为尚书的他见哪个王有势力就投靠哪个"]},{"id":30169,"word":"激薄停浇","pinyin":"jī bó tíng jiāo","abbr":"jbtj","explanation":"形容振作人心，挽回不良的社会风气。","source":{"text":"此言足使还淳反朴，激薄停浇矣。","book":"《梁书·明山宾传》"},"usage":"作谓语；指挽回不良的社会风气"},{"id":30170,"word":"激贪厉俗","pinyin":"jī tān lì sú","abbr":"jtls","explanation":"指抑制贪婪之风，劝勉良好的世俗。","source":{"text":"在于布衣，穷居介然之行，尚可以激贪厉俗，惇此薄夫。","book":"《梁书·萧颖达传》"},"example":{"text":"或节义可称，或操履清洁，所以～，有益风化。","book":"《隋书·炀帝纪上》"},"usage":"作谓语、定语；用于书面语"},{"id":30171,"word":"激起公愤","pinyin":"jī qǐ gōng fèn","abbr":"jqgf","explanation":"激发了公众共同的愤慨。","example":{"text":"日军的暴行～，人们奋起反抗。"},"usage":"作谓语、定语；用于坏的言行等"},{"id":30172,"word":"濆旋倾侧","pinyin":"fèn xuán qīng cè","abbr":"fxqc","explanation":"濆：水波涌起来的地方；倾：倒塌。水势汹涌旋转，冲击岸堤。","source":{"text":"濆旋倾侧，宛转胶戾。","book":"宋·苏洵《仲兄字文甫说》"}},{"id":30173,"word":"濠上之乐","pinyin":"háo shàng zhī lè","abbr":"hszl","explanation":"指悠闲舒适的情趣。","source":{"text":"庄子与惠子游于濠梁之上。庄子曰：‘倏鱼出游从容，是鱼之乐也。’","book":"战国·宋·庄周《庄子·秋水》"},"usage":"作宾语；指悠闲之情趣","story":["战国时期，哲学家庄子与惠子在濠水的桥梁上散步相遇，庄子见桥下碧波荡漾、清澈见底，水中的鱼儿快乐地游来游去，庄子说鱼很快乐，惠子问他不是鱼怎知鱼的快乐？庄子反问惠子怎么知道鱼不快乐呢？惠子无言以对，只有承认鱼儿很快乐"]},{"id":30174,"word":"濠上观鱼","pinyin":"háo shàng guān yǔ","abbr":"hsgy","explanation":"庄子与惠施在濠水边上看鱼，对鱼之乐是否可知进行辩论。比喻悠闲自得和超凡脱俗的情趣和精神境界。","source":{"text":"庄子与惠子游于濠梁之上，庄子曰：‘鲦鱼出游从容，是鱼之乐也。’惠子曰：‘子非鱼，安知鱼之乐？’庄子曰：‘子非我，安知我不知鱼乐？’","book":"《庄子·秋水》"},"example":{"text":"～非至乐，管中窥豹岂全斑。","book":"宋·陆淳《江亭》诗"}},{"id":30175,"word":"濠梁之上","pinyin":"háo liáng zhī shàng","abbr":"hlzs","explanation":"濠梁：濠水上的桥。指别有会心，自得其乐的境地。","source":{"text":"庄子与惠子游于濠梁之上。庄子曰：‘鲦鱼出游从容。是鱼之乐也。’惠子曰：‘子非鱼，安知鱼之乐？’庄子曰：‘子非我，安知我不知鱼之乐？’","book":"《庄子·秋水》"},"usage":"作宾语；用于书面语","story":["战国时期，宋国人惠施为梁惠王的相辅，有人说庄子将会取代惠子为相辅，惠子急了派人在国内搜了三天三夜。庄子与惠子在濠水的桥梁上散步相遇，庄子说水中的鱼儿很快乐，惠子问为什么快乐？庄子说他很快乐，所以看到鱼儿就很快乐"]},{"id":30176,"word":"濠梁观鱼","pinyin":"háo liáng guān yú","abbr":"hlgy","explanation":"濠：水名；梁：桥梁。在濠水的桥梁上观鱼。形容悠然自得，寄情物外。","source":{"text":"庄子与惠子游于濠梁之上。庄子曰：‘倏鱼出游从容，是鱼之乐也。’","book":"战国·宋·庄周《庄子·秋水》"},"usage":"作宾语、定语；指悠闲的生活","story":["战国时期，宋国人惠施为梁惠王的相辅，有人说庄子将会取代惠子为相辅，惠子急了派人在国内搜了三天三夜。庄子与惠子在濠水的桥梁上散步相遇，庄子说水中的鱼儿很快乐，惠子问为什么快乐？庄子说他很快乐，所以看到鱼儿就很快乐"]},{"id":30177,"word":"濠濮间想","pinyin":"háo pú jiān xiǎng","abbr":"hpjx","explanation":"垂钓濮水和在濠水游玩时那种与世无争、悠闲自得的情趣和思想活动。比喻超脱、旷达、闲逸的情致或雅趣。","source":{"text":"会心处不必在远，翳然林水，便自有濠濮间想也。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"小舟荡漾于微波水中，绰有濠濮之想。","book":"清·厉鹗《南宋院画录·刘松年》"},"usage":"作宾语；指情趣"},{"id":30178,"word":"濡沫涸辙","pinyin":"rú mò hé zhé","abbr":"rmhz","explanation":"濡：沾湿。本指泉水干竭，鱼儿相互吐沫湿润。后比喻在困难的处境中以微小的力量竭力互相帮助。","source":{"text":"泉涸，鱼相与处于陆，相呴以湿，相濡以沫。","book":"《庄子·大宗师》"},"example":{"text":"善画鱼龙海水，不为汀泞沮洳之陋，～之游。","book":"宋·赵佶《宣和画谱·龙鱼叙论》"},"similar":["相濡以沫"],"usage":"作定语；指互相帮助"},{"id":30179,"word":"濮上之音","pinyin":"pú shàng zhī yīn","abbr":"pszy","explanation":"濮上：春秋时卫地，青年男女常歌舞幽会于其地。用以指靡靡之音。","source":{"text":"故闻此声必于濮水之上，先闻此声者国削。","book":"西汉·司马迁《史记·乐书》"},"example":{"text":"请不要沉湎于这～。"},"similar":["靡靡之音"],"usage":"作宾语；指不好的音乐","story":["春秋末年，晋平公在城外建造一座豪华的宫殿。卫灵公带涓乐师前去祝贺，席间涓乐师把在濮水边听来的乐曲弹了一遍。晋国的旷乐师马上制止说是商末延乐师为纣王所作的濮上之音，听了会沉湎声色中。3年后，晋平公因贪色而亡"]},{"id":30180,"word":"濮上桑间","pinyin":"pú shàng sāng jiān","abbr":"pssj","explanation":"指男女幽会的场所。","source":{"text":"卫地有桑间濮上之阻，男女亦亟聚会，声色生焉。","book":"《礼记·乐记》：“桑间濮上之音，亡国之音也。”《汉书·地理志下》"},"example":{"text":"圣唐御宇三百祀，～宜禁止。","book":"唐·王毂《玉树曲》"},"similar":["桑间濮上"],"usage":"作宾语、定语；指男女幽会的场所"},{"id":30181,"word":"濯污扬清","pinyin":"zhuó wū yáng qīng","abbr":"zwyq","explanation":"濯：洗。洗去污垢，激扬清澈。比喻扬善除恶。","source":{"text":"臣昔谬得待罪选曹，诚无以濯污扬清。然君子之有智能，犹鵷凤之有文采，俟时而振羽翼。何患不出云霞之上？","book":"《南史·范泰传》"},"usage":"作宾语、定语；用于书面语"},{"id":30182,"word":"濯濯童山","pinyin":"zhuó zhuó tóng shān","abbr":"zzts","explanation":"濯濯：光秃的样子；童：山无草木。没有树木，光秃秃的山","source":{"text":"人见其濯濯也，以为未尝有材焉，此其山之性也。","book":"战国·邹·孟轲《孟子·告子上》"},"similar":["童山濯濯"],"usage":"作宾语、定语；指光秃秃的山"},{"id":30183,"word":"濯缨弹冠","pinyin":"zhuó yīng tán guān","abbr":"zydg","explanation":"濯缨：洗涤帽缨；弹冠：弹去帽子上的灰尘。比喻准备出仕。","source":{"text":"今大道既隐，子生末季，沉溺流俗，眩惑名位，濯缨弹冠，谘诹荣贵。","book":"三国·魏·曹植《释愁文》"},"usage":"作谓语、定语；用于比喻句"},{"id":30184,"word":"濯缨沧浪","pinyin":"zhuó yīng cāng làng","abbr":"zycl","explanation":"在清水中洗涤冠缨。比喻超脱尘俗，操守高洁。","source":{"text":"沧浪之水清兮，可以濯我缨。","book":"《孟子·离娄上》"},"example":{"text":"晋·葛洪《抱朴子·释滞》：“～，不降不辱。”"},"usage":"作谓语、定语；用于书面语"},{"id":30185,"word":"濯缨洗耳","pinyin":"zhuó yīng xǐ ěr","abbr":"zyxe","explanation":"濯缨：洗涤帽缨；洗耳：指不愿与闻世事。比喻避世守志，操行高洁。","source":{"text":"吾常谓濯缨洗耳，有异人之迹，哺糟歠醨，有同物之志。","book":"《魏书·刘献之传》"},"usage":"作宾语、定语；用于书面语"},{"id":30186,"word":"濯缨濯足","pinyin":"zhuó yīng zhuó zú","abbr":"zyzz","explanation":"水清就洗帽带，水浊就洗脚。后比喻人的好坏都是由自己决定。","source":{"text":"有孺子歌曰：‘沧浪之水清兮，可以濯我缨；沧浪之水浊兮，可以濯我足。’孔子曰：‘小子听之。清斯濯缨，浊斯濯足，自取之也。’","book":"战国·邹·孟轲《孟子·离娄上》"},"usage":"作谓语、宾语、定语；指自己决定"},{"id":30187,"word":"濯足濯缨","pinyin":"zhuó zú zhuó yīng","abbr":"zzzy","explanation":"水清就洗帽带，水浊就洗脚。后比喻人的好坏都是由自己决定。","source":{"text":"有孺子歌曰：‘沧浪之水清兮，可以濯我缨；沧浪之水浊兮，可以濯我足。’孔子曰：‘小子听之。清斯濯缨，浊斯濯足矣。自取之也。’","book":"《孟子·离娄上》"}},{"id":30188,"word":"灌夫骂坐","pinyin":"guàn fū mà zuò","abbr":"gfmz","explanation":"用以指人借酒发泄心中的不满。","source":{"text":"《史记·魏其武安侯列传》载：灌夫，西汉人，初以勇武闻名，为人刚直不阿，任侠，好饮酒骂人。与丞相田蚡不和，后因在蚡处使酒骂座，戏侮田蚡，为蚡所劾，以不敬罪族诛。"},"example":{"text":"若师《争座位》三表，则为～，可永绝之。","book":"康有为《广艺舟双楫·行草》"},"similar":["灌夫骂座"],"usage":"作宾语、定语；形容为人刚直敢言","story":["公元前131年，安武侯田蚡娶燕王的女儿，失势的魏其侯窦婴与将军灌夫奉王太后的命令前去祝贺。灌夫给他们敬酒，田蚡及他的手下不理不睬，灌夫大骂他们，田蚡抓了灌夫全家。王太后出面要挟杀了灌夫，窦婴也被流言蜚语所杀"]},{"id":30189,"word":"灌夫骂座","pinyin":"guàn fū mà zuò","abbr":"gfmz","explanation":"灌夫：西汉著名将领。指灌夫酒后骂人泄愤。形容为人刚直敢言。","source":{"text":"武安遂怒，劾灌夫骂座不敬，系居室。","book":"《史记·魏其武安侯列传》"},"example":{"text":"推门看竹，何妨王子乘舆，索酒指瓶，便仿～。","book":"明·陈汝元《金莲记·郊遇》"},"similar":["灌夫骂坐"],"usage":"作宾语、定语；形容为人刚直敢言","story":["公元前131年，安武侯田蚡娶燕王的女儿，失势的魏其侯窦婴与将军灌夫奉王太后的命令前去祝贺。灌夫给他们敬酒，田蚡及他的手下不理不睬，灌夫大骂他们，田蚡抓了灌夫全家。王太后出面要挟杀了灌夫，窦婴也被流言蜚语所杀"]},{"id":30190,"word":"灌瓜之义","pinyin":"guàn guā zhī yì","abbr":"ggzy","explanation":"灌：浇灌；惠：恩惠。比喻以德报怨，不因小事而引起纠纷。","example":{"text":"古人有～，我们也要学会以德报怨。"},"similar":["浇瓜之惠"],"usage":"作宾语；用于处世","story":["传说古代梁国与楚国边境都种了很多瓜，楚人忌妒梁人瓜种得好，乘天黑把梁人的瓜全都毁了。梁人没有报复，在县令宋的带领下，夜间去给楚人浇瓜，楚人的瓜长得一天比一天好。楚王听说后，以重金相谢，并表示以后长期修好"]},{"id":30191,"word":"灌米汤","pinyin":"guàn mǐ tāng","abbr":"gmt","explanation":"比喻用好话恭维与迷惑人。","source":{"text":"连日统领见了他，着实灌米汤；他亦顺水推船，一天到晚，制造了无数的高帽子给统领戴。","book":"清·李宝嘉《官场现形记》第13回"},"example":{"text":"一旦谁万分诚恳地向你～，手一定要捂紧口袋。","book":"王朔《我是你爸爸》"},"usage":"作谓语、宾语、定语；用于交往等"},{"id":30192,"word":"火上加油","pinyin":"huǒ shàng jiā yóu","abbr":"hsjy","explanation":"在一旁助威增加他人的愤怒或助长事态的发展。","source":{"text":"三荷包也不睬他，把他气得越发火上加油了。","book":"清·李宝嘉《官场现形记》第五回"},"example":{"text":"这是一个重要的西洋古典，主上不懂得运用，而公开的说出‘自由民治’的真面目，那就一定要～的更激起匪徒的暴乱的。","book":"瞿秋白《论文学革命及语言文字问题·学阀万岁》"},"similar":["火上浇油","添油炽薪"],"usage":"作谓语、宾语；比喻有意扩大事态"},{"id":30193,"word":"火上弄冰","pinyin":"huǒ shàng nòng bīng","abbr":"hsnb","explanation":"比喻易于败亡，事情很容易办到。","source":{"text":"泼魔苦苦用心拿我，诚所谓水中捞月；老孙若要擒你，就好似火上弄冰。","book":"明·吴承恩《西游记》第35回"},"example":{"text":"～，不禁几日，弄得精光，连饭也没有得吃。","book":"清·西周生《醒世姻缘传》第82回"},"similar":["举手之劳","轻而易举"],"opposite":["水中捞月"],"usage":"作宾语、定语；指事情很容易办到"},{"id":30194,"word":"火上弄冰凌","pinyin":"huǒ shàng nòng bīng líng","abbr":"hsnbl","explanation":"冰凌见火即融。比喻事情很容易办到。","source":{"text":"则教你，楚江山，觑不得火上弄冰凌，汉乾坤也做不得碗内拿蒸饼。","book":"元·无名氏《气英布》"},"similar":["火上弄冰","火上弄雪"],"usage":"作宾语、定语；指事情很容易办到"},{"id":30195,"word":"火上弄雪","pinyin":"huǒ shàng nòng xuě","abbr":"hsnx","explanation":"雪遇火即溶。比喻一下子消失净尽。也比喻非常容易。","source":{"text":"则教你，楚江山，觑不得火上弄冰棱，汉乾坤也做不得碗内拿蒸饼。","book":"元·无名氏《气英布》第二折"},"example":{"text":"谁知钱不由正经路来的，～。不由正经路去的，石沉大海，日减月削，渐渐损之又损，而至于无。","book":"清·李绿园《歧路灯》第七十四回"},"similar":["火上弄冰","火上弄冰凌"],"usage":"作宾语、定语；指事情很容易办到"},{"id":30196,"word":"火上浇油","pinyin":"huǒ shàng jiāo yóu","abbr":"hsjy","explanation":"往火上倒油。比喻使人更加愤怒或使情况更加严重。","source":{"text":"我见了他扑邓邓火上浇油。","book":"元·关汉卿《金线池》第二折"},"example":{"text":"若吃此药，误用人参，犹如～，不出七天，必要命尽无常。","book":"清·石昆玉《三侠五义》第四十一回"},"similar":["推波助澜","如虎添翼"],"opposite":["釜底抽薪"],"usage":"作谓语、宾语；比喻有意扩大事态"},{"id":30197,"word":"火上添油","pinyin":"huǒ shàng tiān yóu","abbr":"hsty","explanation":"比喻使人更加愤怒或使情况更加严重。同“火上浇油”。","source":{"text":"贾臬台见他顶嘴，如火上添油，那气格外来的大。","book":"清·李宝嘉《官场现形记》第二十三回"},"example":{"text":"他放下笔，头疲倦地倒在枕上。炎热增加他的痛苦。喧哗更象在～。","book":"巴金《寒夜》二九"},"similar":["火上浇油","火上加油"],"usage":"作谓语、宾语；比喻有意扩大事态"},{"id":30198,"word":"火中取栗","pinyin":"huǒ zhōng qǔ lì","abbr":"hzql","explanation":"偷取炉中烤熟的栗子。比喻受人利用，冒险出力却一无所得。","source":{"text":"十七世纪法国寓言诗人拉·封丹的寓言《猴子与猫》载：猴子骗猫取火中栗子，栗子让猴子吃了，猫却把脚上的毛烧掉了。"},"example":{"text":"我们目前自顾不暇，郑成功不来就是天主保佑了，我们还好去惹他么。我们不能为别人～。","book":"郭沫若《郑成功》第五章"},"similar":["代人受过","为人作嫁"],"opposite":["坐享其成"],"usage":"作谓语、定语、宾语；指受人利用","story":["从前有一只猴子和一只猫看到农家院中正在炒栗子，猴子馋得口水直流，就问猫喜不喜欢吃栗子。猫表示想吃，猴子叫猫趁主人不在场时去烧着火的锅里拿栗子，猫忍着烫把栗子一个一个拿出来，猴子则在一旁乐呵呵地一个个吃栗子"]},{"id":30199,"word":"火中生莲","pinyin":"huǒ zhōng shēng lián","abbr":"hzsl","explanation":"火里生长出来的莲花。比喻稀有或难得。后指深陷火炕，遭到不幸，但能洁己不毁。","source":{"text":"火中生莲花，是可谓希有，在欲而行禅，希有亦如是。","book":"《维摩诘经·佛道品》"}},{"id":30200,"word":"火伞张","pinyin":"huǒ sǎn zhāng","abbr":"hsz","explanation":"火伞：比喻烈日；张：展开。形容夏天烈日当空，酷热难耐。","source":{"text":"卓午从他火伞张。","book":"宋·杨万里《初秋戏作山居杂兴俳体十二解》"},"similar":["火伞高张"],"usage":"作谓语、定语；形容十分炎热"},{"id":30201,"word":"火伞高张","pinyin":"huǒ sǎn gāo zhāng","abbr":"hsgz","explanation":"火伞：比喻夏天太阳酪烈；张：展开。形容夏天烈日当空，十分炎热。","source":{"text":"光华闪壁见神鬼，赫赫炎官张火伞。","book":"唐·韩愈《游青龙寺赠崔太补阙》诗"},"similar":["火伞张"],"usage":"作谓语、定语；形容十分炎热"},{"id":30202,"word":"火传穷薪","pinyin":"huǒ chuán qióng xīn","abbr":"hcqx","explanation":"薪：柴。柴虽烧尽，火种仍留传。比喻师父传业于弟子，一代代地传下去。","source":{"text":"指穷于为薪，火传也，不知其尽也。","book":"《庄子·养生主》"},"example":{"text":"当日开献书之路，建藏书之策，置写书之官，遣求书之使，收拾余烬，～，辛苦而有之，以遗后人。","book":"清·李慈铭《虚集斋学古文》"}},{"id":30203,"word":"火光冲天","pinyin":"huǒ guāng chōng tiān","abbr":"hgct","explanation":"火光把天都照亮了。形容火势极大。","source":{"text":"火光烛天，海水如沸，此来得见海战，尤奇。","book":"明·张岱《海志》"},"example":{"text":"所以尽管东城外炮声隆隆，～，城内有兵马巡逻，禁止宵行，但深宅大院中仍然过着花天酒地的生活。","book":"姚雪垠《李自成》一卷一章"}},{"id":30204,"word":"火光烛天","pinyin":"huǒ guāng zhú tiān","abbr":"hgzt","explanation":"火光把天都照亮了。形容火势极大（多指火灾）。","source":{"text":"火光烛天，海水如沸，此来得见海战，尤奇。","book":"明·张岱《海志》"},"example":{"text":"城里到处～，枪炮齐响，有钱的人纷纷逃难，穷若的人民水断粮绝。","book":"老舍《吐了一口气》"},"usage":"作谓语、定语；多指火灾"},{"id":30205,"word":"火冒三丈","pinyin":"huǒ mào sān zhàng","abbr":"hmsz","explanation":"冒：往上升。形容愤怒到极点。","source":{"text":"她一句话把他说得跳起来，火冒三丈。","book":"周而复《上海的早晨》第一部"},"example":{"text":"他爱发脾气，动辄～。"},"similar":["怒气冲冲","火冒三尺"],"opposite":["心平气和"],"usage":"作谓语、宾语、状语；形容愤怒到极点"},{"id":30206,"word":"火冒三尺","pinyin":"huǒ mào sān chǐ","abbr":"hmsc","explanation":"形容愤怒到极点。同“火冒三丈”。","source":{"text":"当自成在路上才得到报告时，他不禁火冒三尺，恨恨地骂了一声：‘该死！’","book":"姚雪垠《李自成 》第一卷第十五章"},"example":{"text":"姚雪垠《李自成 》第一卷第十五章：“当自成在路上才得到报告时，他不禁火冒三尺，恨恨地骂了一声：‘该死！’”"},"similar":["火冒三丈"],"usage":"作谓语、宾语、状语；形容愤怒到极点"},{"id":30207,"word":"火列星屯","pinyin":"huǒ liè xīng tún","abbr":"hlxt","explanation":"火列：一列列火堆；星屯：星罗棋布的村庄，指驻扎下来的军队。形容军队阵势强大。","source":{"text":"是故风驰电击者，势也。火列星屯者，形也。","book":"明·无名氏《投笔肤谈》"},"usage":"作定语；用于比喻句"},{"id":30208,"word":"火到猪头烂，钱到公事办","pinyin":"huǒ dào zhū tóu làn，qián dào gōng shì bàn","abbr":"hdztlqdgsb","explanation":"形容钱能通神，不管办什么事，都必须用金钱打点贿赂才能办成。","source":{"text":"自古道好：火到猪头烂，钱到公事办。凭你世间稀奇作怪的东西，有了钱，那一件做不出来。","book":"明·冯梦龙《醒世恒言》卷十三"}},{"id":30209,"word":"火妻灰子","pinyin":"huǒ qī huī zǐ","abbr":"hqhz","explanation":"焚妻灭子。指毁弃家室。","source":{"text":"离，山平人，而焚烧妻子，诈为吴雠，求信于庆忌，反而刺之。","book":"汉·杨雄《法言·渊骞》：“离（要离）也，火妻灰子，以求反于庆忌，实蛛蝥之劘也，焉可谓之义也？”李轨注"},"usage":"作宾语、定语；指毁弃家室"},{"id":30210,"word":"火尽灰冷","pinyin":"huǒ jìn huī lěng","abbr":"hjhl","explanation":"比喻权势消失。","source":{"text":"今时之朝彦，皆是向火乞儿，一日火尽灰冷，暖气何在？当冻尸裂体、弃骨沟睿中，祸不远矣。","book":"五代·王仁裕《开元天宝遗事·向火乞儿》"},"usage":"作谓语、定语；用于比喻句"},{"id":30211,"word":"火尽薪传","pinyin":"huǒ jìn xīn chuán","abbr":"hjxc","explanation":"火虽烧完，柴却留传下来。比喻思想、学术、技艺等世代相传。","source":{"text":"仗猛力精心，斩断牵缠，若不是粉碎虚空，终似那痴拳太软，总火尽薪传也。","book":"明·寓山居士《鱼儿佛》第四出"},"similar":["薪尽火传"],"usage":"作谓语；比喻师父传业于弟子"},{"id":30212,"word":"火居道士","pinyin":"huǒ jū dào shì","abbr":"hjds","explanation":"指有家庭妻儿的道士。","source":{"text":"洪武中僧道不务祖风，及俗人行瑜伽法称火居道士者，俱有严禁。","book":"明·俞汝楫《礼部志稿·僧道禁列》"}},{"id":30213,"word":"火山汤海","pinyin":"huǒ shān tāng hǎi","abbr":"hsth","explanation":"比喻艰难危险。","source":{"text":"虽有火山汤海，无所辞难，岂寒暑之足避哉！","book":"《晋书·张骏传》"},"similar":["刀山火海"],"usage":"作主语、宾语；表示无所畏惧"},{"id":30214,"word":"火急火燎","pinyin":"huǒ jí huǒ liǎo","abbr":"hjhl","explanation":"犹火烧火燎。","source":{"text":"整个发电厂都火急火燎地动员起来。","book":"《人民文学》1977年4期"},"similar":["火烧火燎"],"usage":"作定语、宾语；用于口语"},{"id":30215,"word":"火星乱冒","pinyin":"huǒ xīng luàn mào","abbr":"hxlm","explanation":"形容气愤到了极点。","source":{"text":"多九公听了，晓得道姑语带讥讽，只气得火星乱冒。","book":"清·李汝珍《镜花缘》第四十四回"},"usage":"作定语、状语；用于比喻句"},{"id":30216,"word":"火树星桥","pinyin":"huǒ shù xīng qiáo","abbr":"hsxq","explanation":"形容节日的夜晚灯火辉煌的景色。","source":{"text":"火树银花合，星桥铁锁开。","book":"唐·苏味道《正月十五夜》诗"},"example":{"text":"～，烂煌煌，镫月连宵夜如昼。","book":"《清史稿·乐志五》"}},{"id":30217,"word":"火树琪花","pinyin":"huǒ shù qí huā","abbr":"hsqh","explanation":"比喻灿烂的灯火或焰火。","source":{"text":"于是进入行宫，只见庭燎绕空，香屑布地，火树琪花，金窗玉槛。","book":"清·曹雪芹《红楼梦》第十七回"},"similar":["火树银花","火烛银花"],"usage":"作主语、宾语、定语；形容节日晚上的灯火"},{"id":30218,"word":"火树银花","pinyin":"huǒ shù yín huā","abbr":"hsyh","explanation":"火树：火红的树，指树上挂满灯彩；银花：银白色的花，指灯光雪亮。形容张灯结彩或大放焰火的灿烂夜景。","source":{"text":"火树银花合，尽桥铁锁开。","book":"唐·苏味道《正月十五夜》诗"},"example":{"text":"～不夜天，弟兄姐妹舞翩跹，歌声唱彻月儿圆。","book":"柳亚子《浣溪沙》词"},"similar":["张灯结彩","灯火辉煌"],"opposite":["漆黑一团","黑灯瞎火","昏天黑地"],"usage":"作主语、宾语、定语；形容节日晚上的灯火","story":["唐朝时期，唐睿宗很懂享乐，虽然只当三年皇帝，但是每到佳节他都大肆铺张一番，逢正月十五，一定要扎起20丈高的灯树，点起5万盏灯称“火树”。诗人苏味道描绘《正月十五夜》：“火树银花合，星桥铁锁开。暗尘随马去，明月逐人来。”"]},{"id":30219,"word":"火海刀山","pinyin":"huǒ hǎi dāo shān","abbr":"hhds","explanation":"比喻极其危险和困难的地方。","source":{"text":"愿红旗五洲四海齐招展, 哪怕是火海刀山也扑上前。","book":"京剧《智取威虎山》第五场"},"example":{"text":"火海刀山无所惧，艰难困苦炼英雄。"},"similar":["刀山火海"],"usage":"作主语、宾语、定语；比喻极其危险和艰难的"},{"id":30220,"word":"火灭烟消","pinyin":"huǒ miè yān xiāo","abbr":"hmyx","explanation":"火苗熄灭，烟云消散。比喻事物消失净尽，不留一点痕迹。亦作“烟消火灭”。","source":{"text":"忽然长逝，火灭烟消。","book":"晋·傅玄《四言杂诗》"},"usage":"作谓语、定语；用于比喻句"},{"id":30221,"word":"火烛小心","pinyin":"huǒ zhú xiǎo xīn","abbr":"hzxx","explanation":"火烛：泛指能起火的东西。原指谨防失火。亦泛指处事小心谨慎。","source":{"text":"你点火把送贾老爷回府，你就家去罢。家中门户火烛小心。","book":"清·邗上蒙人《风月梦》第十回"},"example":{"text":"你悄悄跟老张去说，叫他去找‘主顾’，要有钱人家的子弟，肚子里‘～’而急于想中举的；每一个六千银子，另加两成小费。","book":"高阳《清官册·科场大狱》"},"usage":"作宾语、定语；用于防火"},{"id":30222,"word":"火烛银花","pinyin":"huǒ zhú yín huā","abbr":"hzyh","explanation":"犹火树银花。形容张灯结彩或大放焰火的灿烂夜景。","source":{"text":"火烛银花触目红，揭天鼓吹闹东风。","book":"宋·朱淑真《元夜》诗之三"},"similar":["火树银花","火树琪花"],"usage":"作主语、宾语、定语；形容节日晚上的灯火"},{"id":30223,"word":"火烧火燎","pinyin":"huǒ shāo huǒ liǎo","abbr":"hshl","explanation":"燎：烧。被火烧烤。比喻心里非常着急或身上热得难受。","source":{"text":"小嘎子火烧火燎地再也忍耐不住，就钻出磨房来。","book":"魏巍《山雨》"},"example":{"text":"可是红军一开拔，弄得我心里～的，说不出是什么滋味。","book":"王愿坚《党费·粮食的故事》"},"similar":["心如火焚","心急如焚"],"opposite":["心如止水"],"usage":"作定语、宾语；指发热或遇到令人焦急的事情"},{"id":30224,"word":"火烧眉毛","pinyin":"huǒ shāo méi máo","abbr":"hsmm","explanation":"火烧到眉毛。比喻事到眼前，非常急迫。","source":{"text":"问：‘如何是急切一句？’诗曰：‘火烧眉毛。’","book":"宋·释普济《五灯会元》卷十六"},"example":{"text":"～，且顾眼前。","book":"清·李汝珍《镜花缘》第三十五回"},"similar":["千钧一发","迫在眉睫","燃眉之急"],"usage":"作谓语、定语、宾语；用于口语"},{"id":30225,"word":"火烬灰冷","pinyin":"huǒ jìn huī lěng","abbr":"hjhl","explanation":"火苗熄灭了，灰凉了。比喻时过境迁，或境况由兴盛转为衰落。","source":{"text":"此曹皆向火乞儿，一旦火烬灰冷，当冻裂肌肤矣。","book":"五代·王裕仁《开元天宝遗事》下"}},{"id":30226,"word":"火热水深","pinyin":"huǒ rè shuǐ shēn","abbr":"hrss","explanation":"①犹水深火热。比喻十分困苦的处境。②形容严酷；厉害。","source":{"text":"我算什么，明相国不动声色，却出斯民于火热水深，措天下于泰山磐石。","book":"清·魏秀仁《花月痕》第五十回"},"example":{"text":"法兰西革命之时，上自王家，下至贵族僧侣，蹂躏平民，无所弗至，其法之力，可谓～矣。","book":"李大钊《民彝与政治》"},"similar":["水深火热"],"usage":"作宾语、定语；指人民生活"},{"id":30227,"word":"火然泉达","pinyin":"huǒ rán quán dá","abbr":"hrqd","explanation":"比喻形势发展迅猛。","source":{"text":"凡有四端于我者，知皆扩而充之矣，若火之始然，泉之始达。","book":"《孟子·公孙丑上》"},"example":{"text":"盖至是而中国立宪之机，直如～，有不能自已之势焉。","book":"清·梁启超《立宪纪闻》"},"usage":"作谓语、定语；比喻形势发展迅猛"},{"id":30228,"word":"火眼金睛","pinyin":"huǒ yǎn jīn jīng","abbr":"hyjj","explanation":"原指《西游记》中孙悟空能识别妖魔鬼怪的眼睛。后用以形容人的眼光锐利，能够识别真伪。","source":{"text":"这厮瞒神唬鬼，铜筋铁骨，火眼金睛。","book":"元·杨景贤《西游记杂剧》第三本第九出"},"example":{"text":"只是风搅得烟来，把一双眼炒红了，弄做个老害眼病，故唤作～。","book":"明·吴承恩《西游记》第七回"},"usage":"作宾语；指人眼光敏锐，洞察一切"},{"id":30229,"word":"火耕水种","pinyin":"huǒ gēng shuǐ zhòng","abbr":"hgsz","explanation":"耨：除草。古代一种原始耕种方式。","source":{"text":"江南火耕水耨，令饥民得流就食江淮间。","book":"西汉·司马迁《史记·平淮书》"},"example":{"text":"遏长川以为陂，燔茂草以为田，～，不烦人力。","book":"晋·陆云《答车茂安书》"},"similar":["火耕水耨","火耕流种"],"usage":"作谓语、定语；指原始耕种方式"},{"id":30230,"word":"火耕水耨","pinyin":"huǒ gēng shuǐ nòu","abbr":"hgsn","explanation":"耨：除草。用火来耕种，用水来除草。古代一种原始耕种方式。","source":{"text":"江南火耕水耨，令饥民得流就食江淮间，欲留，留处。","book":"《史记·平准书》"},"example":{"text":"诸欲修水田者，皆以～为便。","book":"《晋书·食货志》"},"similar":["刀耕火种","火耕水种"],"usage":"作谓语、定语；指原始耕种方式"},{"id":30231,"word":"火耕流种","pinyin":"huǒ gēng liú zhǒng","abbr":"hglz","explanation":"古代一种原始的耕种方式。先用火烧去杂草，然后引水播种。犹言火耕水耨。","source":{"text":"以火烧所伐林株，引水溉之而布种也。","book":"《后汉书·文苑传上·杜笃》：“田田相如，鐇钁株林，火耕流种，功浅得深。”李贤注"},"similar":["火耕水耨","火耕水种"],"usage":"作谓语、定语；指原始的耕种方法"},{"id":30232,"word":"火耨刀耕","pinyin":"huǒ nòu dāo gēng","abbr":"hndg","explanation":"犹火耕。多指比较原始的耕作方法。","source":{"text":"黄尘初起此留连，火耨刀耕六七年。","book":"唐·罗隱《别池阳所居》诗"},"similar":["刀耕火耨"],"usage":"作定语、宾语；指原始农业"},{"id":30233,"word":"火齐木难","pinyin":"huǒ jì mù nán","abbr":"hqmn","explanation":"火齐：宝石名；木难：宝珠名。比喻珍奇难得之物。多指诗文书画等。","source":{"text":"明珠交玉体，珊瑚间木难。","book":"汉·班固《西都赋》：“翡翠火齐，流耀含英。”三国·魏·曹植《美女篇》"},"example":{"text":"时而～，错落照眼，应接不暇。","book":"清·马位《秋窗随笔》卷四十五"}},{"id":30234,"word":"火龙黼黻","pinyin":"huǒ lóng fǔ fú","abbr":"hlff","explanation":"原指火形和龙形的文彩，后用以比喻作文只知雕章琢句，犹如补缀百家之衣。","source":{"text":"火龙黼黻，昭其文也。","book":"《左传·桓公二年》"},"example":{"text":"文章最忌百家衣，～世不知。","book":"宋·陆游《次韵和杨伯子主簿见赠》"},"usage":"作宾语、定语；用于作文等"},{"id":30235,"word":"灭德立违","pinyin":"miè dé lì wéi","abbr":"mdlw","explanation":"灭：消灭。败坏道德，做违背道德的事。","source":{"text":"今灭德立违，而置其赂器于大庙，以明示百官。","book":"《左传·桓公二年》"},"example":{"text":"君人者昭德塞违，今～，而置其赂器于太庙，百官象之，其又何诛焉？","book":"《旧唐书·褚遂良传》"},"usage":"作谓语、定语；用于人处世"},{"id":30236,"word":"灭景追风","pinyin":"miè yǐng zhuī fēng","abbr":"myzf","explanation":"看不见影子，追得上风。形容马跑得极快。景，同“影”。","source":{"text":"今马之能走者，忌必随其余步哉？顾所以灭景追风者有不在，是故也。","book":"《说郛》卷六四引唐·无名氏《灌畦暇语》"},"usage":"作宾语、定语；用于形容快"},{"id":30237,"word":"灭此朝食","pinyin":"miè cǐ zhāo shí","abbr":"mczs","explanation":"朝食：吃早饭。让我先把敌人消灭掉再吃早饭。形容急于消灭敌人的心情和必胜的信心。","source":{"text":"齐侯曰：‘余姑翦灭此而朝食！’不介马而驰之。","book":"《左传·成公二年》"},"example":{"text":"广东之于桂军，骎有～之势。","book":"章炳麟《联省自治虚置政府议》"},"similar":["破釜沉舟"],"usage":"作谓语、宾语、定语；指意志坚决","story":["公元前589年，齐顷公听信母亲的话嘲笑晋国的大使克。晋国派兵去攻打齐国，齐顷公亲自率军还击，见晋军的军营大门还没打开，就骄傲地说等我们消灭了这些敌军再去吃早饭。顷刻，晋国奋力出击，打败齐军，齐顷公只好溃逃"]},{"id":30238,"word":"灭私奉公","pinyin":"miè sī fèng gōng","abbr":"msfg","explanation":"灭：消灭。消灭私念，一心为公。","source":{"text":"辟名用物者逃无所入，灭私奉公者得以自明。","book":"唐·元稹《崔倰授尚书户部侍郎制》"},"similar":["大公无私"],"opposite":["假公济私"],"usage":"作谓语、宾语、定语；用于为人"},{"id":30239,"word":"灭绝人性","pinyin":"miè jué rén xìng","abbr":"mjrx","explanation":"完全丧失人所具有的理性。形容极端残忍，象野兽一样。","source":{"text":"一个是岳父灭绝人性，买通赃官，置无辜的女婿于死地。","book":"傅抱石《郑板桥文集前言》"},"example":{"text":"日军在南京进行了～的大屠杀。"},"similar":["惨无人道"],"opposite":["心慈面善"],"usage":"作谓语、定语、状语；指极端残忍"},{"id":30240,"word":"灭自己志气，长别人威风","pinyin":"miè zì jǐ zhì qì，zhǎng bié rén wēi fēng","abbr":"mzjzqzbrwf","explanation":"轻视自己方面的力量，助长敌方的声势。","source":{"text":"你怎么灭自己志气，长别人威风＞那尉迟敬德有水靡鞭，我刘无敌也有鞭哩。","book":"元·无名氏《小尉迟》第一折"}},{"id":30241,"word":"灭虢取虞","pinyin":"miè guó qǔ yú","abbr":"mgqy","explanation":"比喻攻击甲国时先稳住乙国，等灭掉甲国后再灭乙国。","source":{"text":"虢、虞：周朝国名。鲁僖公五年（公元前655年）晋献公假道虞国，出师伐虢国。灭虢后，又回师灭掉虞。"},"example":{"text":"今先定西蜀，乘顺流之势，水陆并进，并吞东吴，此“～”之道也。","book":"明·罗贯中《三国演义》第一百一十五回"},"similar":["假道灭虢"],"usage":"作定语、补语；用于战略","story":["春秋时期，鲁僖公五年（公元前655年）晋献公根据大臣荀息的计谋，用玉石和宝马贿赂虞国国君，达到借道虞国出兵攻打虢国的目的。虞王不听大臣宫之奇的忠告，让晋国借道。晋灭虢三年后，又回师灭掉虞国"]},{"id":30242,"word":"灭门之祸","pinyin":"miè mén zhī huò","abbr":"mmzh","explanation":"全家遭受株连以致毁灭的祸害。","source":{"text":"皇太子，国之储副，事有蹉跌，便至灭门之祸。","book":"《周书·王轨传》"},"example":{"text":"他们家险遭～。"},"similar":["满门操斩"],"usage":"作宾语；为古时抄家灭族的极刑"},{"id":30243,"word":"灭门刺史","pinyin":"miè mén cì shǐ","abbr":"mmcs","explanation":"指地方官手中的权力，足以使人破家灭门。","source":{"text":"人有恒言：‘破家县令，灭门刺史。’予谓此言，强宗豪右当常讼之。","book":"明·敖英《东谷赘言》上卷"},"similar":["破家县令"],"usage":"作宾语、定语；指横暴的地方官"},{"id":30244,"word":"灭门绝户","pinyin":"miè mén jué hù","abbr":"mmjh","explanation":"绝户：绝后。全家死尽，无一幸免。","source":{"text":"恨只恨屠岸贾那匹夫，寻根拔树。险送俺一家儿灭门绝户。","book":"元·纪君祥《赵氏孤儿》第四折"},"example":{"text":"谁知你是～之祸根也。","book":"明·许仲琳《封神演义》第十二回"},"similar":["斩尽杀绝"],"usage":"作谓语、定语；指全家人全都被杀尽"},{"id":30245,"word":"灭顶之灾","pinyin":"miè dǐng zhī zāi","abbr":"mdzz","explanation":"灭顶：水漫过头顶。指被水淹死。比喻毁灭性的灾难。","source":{"text":"过渉灭顶，凶。","book":"《周易·大过》"},"example":{"text":"动员了全国的老百姓，就造成了陷敌于～的汪洋大海。","book":"毛泽东《论持久战》"},"similar":["弥天大祸"],"opposite":["洪福齐天"],"usage":"作主语、宾语、定语；比喻毁灭性、致命性的"},{"id":30246,"word":"灯台不自照","pinyin":"dēng tái bù zì zhào","abbr":"dtbzz","explanation":"灯台不能自己照自身。比喻人自己发现不了自己身上的缺点。","source":{"text":"方信道人心未易知，灯台不自照。","book":"元·康进之《李逵负荆》第三折"},"example":{"text":"你乳老鸦笑话猪儿足——原来～。","book":"明·兰陵笑笑生《金瓶梅词话》第六十九回"},"opposite":["自知之明"],"usage":"作宾语、定语；用于口语"},{"id":30247,"word":"灯尽油干","pinyin":"dēng jìn yóu gān","abbr":"djyg","explanation":"灯光尽灭，灯油耗干。比喻人的精力或财力消耗一空。","source":{"text":"总是有田产的人，少不得直弄得灯尽油干。","book":"明·天然智叟《石头点·王本立天涯求父》"},"example":{"text":"兼之日夜焦愁，胸中郁闷，一经睡去，精神涣散，就如～，要想气聚神全，如何能够？","book":"清·李汝珍《镜花缘》第二十七回"},"usage":"作定语、状语；指彻底完毕"},{"id":30248,"word":"灯火万家","pinyin":"dēng huǒ wàn jiā","abbr":"dhwj","explanation":"家家都点上灯。指天黑上灯的时候。亦形容城镇夜晚的景象。","source":{"text":"灯火万家城四畔，星河一道水中央。","book":"唐·白居易《江楼夕望招客》"},"similar":["万家灯火"],"usage":"作宾语、定语；形容一片灿烂的夜景"},{"id":30249,"word":"灯火辉煌","pinyin":"dēng huǒ huī huáng","abbr":"dhhh","explanation":"形容夜晚灯光明亮的繁华景象。","source":{"text":"理宗皇帝游苑，登凤凰山，至夜望见西湖内灯火辉煌，一片光明。","book":"明·冯梦龙《喻世明言》卷二十二"},"example":{"text":"尤氏等送至大厅前，见～，众小厮都在丹墀侍立。","book":"清·曹雪琴《红楼梦》第七回"},"similar":["火树银光","张灯结彩"],"opposite":["黑灯瞎火","昏天黑地"],"usage":"作谓语、定语、补语；用于描写夜景"},{"id":30250,"word":"灯烛辉煌","pinyin":"dēng zhú huī huáng","abbr":"dzhh","explanation":"辉煌：光辉耀眼。形容灯光烛火通明，光辉耀眼。","source":{"text":"军士引阚泽至，只见帐上灯烛辉煌，曹操凭几危坐。","book":"明·罗贯中《三国演义》第四十七回"},"example":{"text":"清·褚人获《隋唐演义》第17回：“叔宝一班别了公子，出打球场，上了蓝桥，只见街坊上～。”"},"similar":["灯火辉煌"],"opposite":["漆黑一团","黑灯瞎火"],"usage":"作谓语、定语、补语；用于描写夜景"},{"id":30251,"word":"灯红酒绿","pinyin":"dēng hóng jiǔ lǜ","abbr":"dhjl","explanation":"灯光酒色，红绿相映，令人目眩神迷。形容奢侈糜烂的生活。","source":{"text":"（玉生）侧着头想了一会道‘灯红酒绿’好吗？","book":"清·吴趼人《二十年目睹之怪现状》第三十三回"},"example":{"text":"少数人过着～，醉生梦死的生活，人民不满。","book":"老舍《鼓书艺人》十九"},"similar":["花天酒地","穷奢极欲","醉生梦死"],"opposite":["艰苦朴素","节衣缩食","克勤克俭"],"usage":"作主语、定语；指生活糜烂"},{"id":30252,"word":"灯蛾扑火","pinyin":"dé é pū huǒ","abbr":"deph","explanation":"比喻自己找死。","source":{"text":"如飞蛾之赴火，岂焚身之可吝。","book":"《梁书·倒溉传》"},"example":{"text":"这贼配军却不是作死，倒来戏弄老娘！正是“～，惹焰烧身”。","book":"明·施耐庵《水浒全传》第二十七回"},"similar":["自投罗网","飞蛾赴火"],"usage":"作宾语；比喻自己找死"},{"id":30253,"word":"灰不喇唧","pinyin":"huī bù lā jī","abbr":"hblj","explanation":"令人生厌的灰颜色。","example":{"text":"我一看那～的东西就恶心。"},"similar":["灰不溜丢"],"usage":"作谓语、定语；用于口语"},{"id":30254,"word":"灰不溜丢","pinyin":"huī bù liū diū","abbr":"hbld","explanation":"灰色，形容因为某种原因而感到难堪，情绪低落。","example":{"text":"他挨了顿批，～地回来了。"},"similar":["灰不喇唧"],"usage":"作定语、状语；指灰色"},{"id":30255,"word":"灰头土脸","pinyin":"huī tóu tǔ liǎn","abbr":"httl","explanation":"满头满脸沾满尘土的样子。也形容懊丧或消沉的神态。","source":{"text":"灰头土面，带水拖泥，唱九作十，指鹿为马，非唯孤负先圣，亦乃埋没己灵。","book":"宋·释普济《五灯会元》卷二十"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“我怕万一搞得～，对你不好交代。”"},"similar":["灰头土面","灰头草面"],"usage":"作宾语、定语、状语；用于人的神态"},{"id":30256,"word":"灰头土面","pinyin":"huī tóu tǔ miàn","abbr":"httm","explanation":"满头满脸沾满尘土的样子。也形容懊丧或消沉的神态。","source":{"text":"灰头土面，带水拖泥，唱九作十，指鹿为马，非唯孤负先圣，亦乃埋没己灵。","book":"宋·释普济《五灯会元》卷二十"},"example":{"text":"晃大舍送了珍奇到监，自己讨了保，～，瘸狼渴疾，走到家中。","book":"《醒世姻缘》第十四回"},"similar":["灰头土脸"],"usage":"作宾语、定语、状语；用于人的神态"},{"id":30257,"word":"灰头草面","pinyin":"huī tóu cǎo miàn","abbr":"htcm","explanation":"佛教语，指菩萨为度化众生而随机应现各种混同凡俗的化身。也指面容污秽或讨了没趣懊丧的样子。","source":{"text":"娘子，灰头草面不打扮，倘或江上遇着相知朋友，怎生厮见。","book":"元·杨景贤《西游记》第一本第一出"},"similar":["灰头土面","灰头土脸"],"usage":"作宾语、定语、状语；用于人的神态"},{"id":30258,"word":"灰容土貌","pinyin":"huī róng tǔ mào","abbr":"hrtm","explanation":"形容面容龌龊丑陋。","source":{"text":"空自胸藏锦绣，口唾珠玑，争奈灰容土貌，缺齿重颏。","book":"元·钟嗣成《一枝花·自序丑斋》"},"example":{"text":"我这～怎么见人？"},"usage":"作谓语、定语、宾语；用于人或动物"},{"id":30259,"word":"灰心丧意","pinyin":"huī xīn sàng yì","abbr":"hxsy","explanation":"犹言灰心丧气。形容因失败或不顺利而失去信心，意志消沉。","source":{"text":"凤姐因方才一段话已经灰心丧意，恨娘家不给争气，又兼昨夜园中受了那一惊，也实在没精神。","book":"清·曹雪芹《红楼梦》第一○一回"},"similar":["灰心短气","灰心丧气"],"usage":"作谓语、定语、状语；指意志消沉"},{"id":30260,"word":"灰心丧气","pinyin":"huī xīn sàng qì","abbr":"hxsq","explanation":"灰心：心如熄灭了的死灰；丧：失去。形容因失败或不顺利而失去信心，意志消沉。","source":{"text":"是以志趋不坚，人言是恤者，辄灰心丧气，竟不卒功。","book":"明·吕坤《呻吟语·下·建功立业》"},"example":{"text":"因为遭受了很大的损失，都有些～了。","book":"吴玉章《论辛亥革命》"},"similar":["垂头丧气","心灰意冷"],"opposite":["意气风发","踌躇满志","信心百倍"],"usage":"作谓语、定语、状语；指意志消沉"},{"id":30261,"word":"灰心槁形","pinyin":"huī xīn gǎo xíng","abbr":"hxgx","explanation":"形容意志消沉，形体枯槁。","source":{"text":"形固可使如槁木，而心固可使如死灰乎？","book":"《庄子·齐物论》"},"example":{"text":"今已退老南部，以患眼不出，～，与世相忘。","book":"宋·苏轼《乞加张方平恩礼札子》"},"usage":"作定语；指意志消沉，形体枯槁"},{"id":30262,"word":"灰心短气","pinyin":"huī xīn duǎn qì","abbr":"hxdq","explanation":"形容因失败或不顺利而失去信心，意志消沉。同“灰心丧气”。","source":{"text":"是诚中国前途之隐忧，而足使倡言革命者灰心短气者也。","book":"寄生《论支那立宪必先以革命》"},"example":{"text":"桀黠无所容其跳梁，则惟有～，随波逐流，仍入于奴隶、妾妇、机器之队中。","book":"梁启超《呵旁观者文》"},"similar":["灰心丧意","灰心丧气"],"usage":"作谓语、定语、状语；指意志消沉"},{"id":30263,"word":"灰灭无余","pinyin":"huī miè wú yú","abbr":"hmwy","explanation":"灰灭：人或事物像灰烬般消灭。比喻人或物已经不复存在。","source":{"text":"或举国掩户，尽种灰灭，孤儿寡妇，号哭空城。","book":"《后汉书·陈龟传》"}},{"id":30264,"word":"灰烟瘴气","pinyin":"huī yān zhàng qì","abbr":"hyzq","explanation":"比喻污浊。","source":{"text":"近处买不到一种北京或上海的新的出版物，所以有时也觉得枯寂一些，但也看不见灰烟瘴气的《现代评论》。","book":"鲁迅《华盖集续编·厦门通信》"},"similar":["乌烟瘴气"],"usage":"作定语、状语；指糟乱"},{"id":30265,"word":"灰身泯智","pinyin":"huī shēn mǐn zhì","abbr":"hsmz","explanation":"佛教语。指断除一切身心烦恼，为小乘阿罗汉果的境界。同“灰身灭智”。","source":{"text":"若灰身泯智，名无余涅盘。","book":"明·智旭《教观纲宗》"},"similar":["灰身灭智"],"usage":"作谓语、定语；用于佛教等"},{"id":30266,"word":"灰身灭智","pinyin":"huī shēn miè zhì","abbr":"hsmz","explanation":"佛教语。指断除一切身心烦恼，为小乘阿罗汉果的境界。","source":{"text":"若灰身灭智，名无余涅槃。","book":"隋·智顗《四教仪》"},"similar":["灰身泯智"],"usage":"作谓语、定语；用于佛教等"},{"id":30267,"word":"灰身粉骨","pinyin":"huī shēn fěn gǔ","abbr":"hsfg","explanation":"身体被毁成灰粉。形容人死得极惨。","source":{"text":"诚宜灰身粉骨以谢父君，复何面目以谈天下之事哉。","book":"唐·王勃《上百里昌言书》"},"similar":["灰躯糜骨","粉身碎骨"],"usage":"作谓语、定语、状语、宾语；用于比喻句"},{"id":30268,"word":"灰躯糜骨","pinyin":"huī qū mí gǔ","abbr":"hqmg","explanation":"身体粉碎而死。比喻为了某种目的或遭到什么危险而丧失生命。","source":{"text":"所以忍垢偷生，克躬自励，期效万一，补过酬恩，灰躯糜骨，以甘心愿。","book":"唐·陈子昂《为张著作谢父官表》"},"similar":["粉身碎骨","灰身粉骨"],"usage":"作谓语、定语、状语、宾语；用于比喻句"},{"id":30269,"word":"灰飞烟灭","pinyin":"huī fēi yān miè","abbr":"hfym","explanation":"比喻事物消失净尽。","source":{"text":"谈笑间，樯橹灰飞烟灭。","book":"宋·苏轼《念奴娇·赤壁怀古》词"},"example":{"text":"岂知转眼之间～，金山化作冰山，极是不难的事。","book":"明·凌濛初《初刻拍案惊奇》卷二十二"},"similar":["冰消瓦解","烟消云散","化为乌有"],"opposite":["东山再起","死灰复燃","卷土重来"],"usage":"作谓语；比喻人亡或事物迅速消失"},{"id":30270,"word":"灵丹圣药","pinyin":"líng dān shèng yào","abbr":"ldsy","explanation":"灵：灵验。非常灵验、能起死回生的奇药。比喻幻想中的某种能解决一切问题的有效方法。","source":{"text":"灵丹妙药都不用，吃的是生姜辣蒜大憨葱。","book":"元·无名氏《玩江亭》第二折"},"example":{"text":"直到现在，还有不少的人，把马克思列宁主义书本上的某些个别字句看作现成的～。","book":"毛泽东《整顿党的作风》"},"similar":["灵丹妙药"],"usage":"作宾语；比喻能解决一切问题的好方法"},{"id":30271,"word":"灵丹妙药","pinyin":"líng dān miào yào","abbr":"ldmy","explanation":"灵：灵验。非常灵验、能起死回生的奇药。比喻幻想中的某种能解决一切问题的有效方法。","source":{"text":"灵丹妙药都不用，吃的是生姜辣蒜大憨葱。","book":"元·无名氏《玩江亭》第二折"},"example":{"text":"望大圣爷爷早发～打救。","book":"清·李绿园《歧路灯》第四十七回"},"similar":["锦囊妙计"],"usage":"作主语、宾语；用于否定句"},{"id":30272,"word":"灵心巧手","pinyin":"líng xīn qiǎo shǒu","abbr":"lxqs","explanation":"心思灵敏，手艺巧妙。","source":{"text":"蓬莱阆苑，不过如此，众妃子灵心巧手，直夺造化，真一大快事也。","book":"清·褚人获《隋唐演义》第二十八回"}},{"id":30273,"word":"灵心慧性","pinyin":"líng xīn huì xìng","abbr":"lxhx","explanation":"指聪慧的天资。","source":{"text":"自己本生得一副月貌花容，一团灵心慧性，那怕丈夫千金买笑，自料断不及我一顾倾城。","book":"清·文康《儿女英雄传》第二十七回"},"example":{"text":"清·名教中人《好逑传》第七回：“这水小姐，～，如凤如鸾，若非铁公子，也无人对得她过。”"},"usage":"作谓语、宾语；多用于女性"},{"id":30274,"word":"灵心慧齿","pinyin":"líng xīn huì chǐ","abbr":"lxhc","explanation":"天资聪慧，口齿伶俐。","source":{"text":"蔡文姬灵心慧性，辱迹穹庐。","book":"清·程羽文《鸳鸯牒》"},"usage":"作谓语、定语；多用于女性"},{"id":30275,"word":"灵机一动","pinyin":"líng jī yī dòng","abbr":"ljyd","explanation":"灵机：灵活的心思。急忙中转了一下念头（多指临时想出了一个办法）。","source":{"text":"俄延了半晌，忽然灵机一动，心中悟将过来。","book":"清·文康《儿女英雄传》第四回"},"example":{"text":"清·文康《儿女英雄传》第四回：“俄延了半晌，忽然灵机一动，心中悟将过来。”"},"similar":["心血来潮","随机应变"],"opposite":["一成不变","呆头呆脑","墨守成规"],"usage":"作谓语；指想出好办法"},{"id":30276,"word":"灵牙利齿","pinyin":"líng yá lì chǐ","abbr":"lylc","explanation":"比喻善于说话的人。","source":{"text":"而这种种心情，竟又使得她这个灵牙利齿忽然笨得再也说不出话来。","book":"康濯《水滴石穿》第三章"},"example":{"text":"我不怕她～，事实胜于神辩。"},"similar":["伶牙俐齿"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；指人口才好"},{"id":30277,"word":"灵蛇之珠","pinyin":"líng shé zhī zhū","abbr":"lszz","explanation":"即隋珠。原比喻无价之宝。后也比喻非凡的才能。","source":{"text":"譬如惰侯之珠，和氏之璧，得之者富，失之者贫。","book":"《淮南子·说览冥训》"},"example":{"text":"当此之时，人人自谓握～，家家自谓抱荆山之玉。","book":"三国·魏·曹植《与汤德祖书》"},"similar":["隋侯之珠"],"usage":"作宾语；指无价之宝"},{"id":30278,"word":"灵蛇之珠，荆山之玉","pinyin":"líng shé zhī zhū，jīng shān zhī yù","abbr":"lszzjszy","explanation":"指世上罕有的珍宝。","source":{"text":"当此之时，人人自谓握灵蛇之珠，家家自谓抱荆山之玉。","book":"三国·魏·曹植《与汤德祖书》"}},{"id":30279,"word":"灶上扫除","pinyin":"zào shàng sǎo chú","abbr":"zssc","explanation":"把灶上打扫干净。比喻极容易做到。","source":{"text":"至五昼夜不卧，未尝有怨言，故能以弱胜强，若从灶上扫除焉。","book":"章炳麟《书十九路军御日本事》"},"similar":["灶上骚除"],"usage":"作宾语；指很容易做到的事"},{"id":30280,"word":"灶上骚除","pinyin":"zào shàng sāo chú","abbr":"zssc","explanation":"骚：通“扫”。把灶上打扫干净。比喻极容易做到。","source":{"text":"夫以秦之强，大王之贤，由灶上骚除。足以灭诸侯，成帝业，为天下一统。","book":"西汉·司马迁《史记·李斯列传》"},"similar":["灶上扫除"],"usage":"作宾语；指很容易做到的事"},{"id":30281,"word":"灸艾分痛","pinyin":"jiù ài fēn tòng","abbr":"jaft","explanation":"比喻兄弟友爱。","source":{"text":"太宗尝病亟，帝往视之，亲为灼艾。太宗觉痛，帝亦取艾自灸。","book":"《宋史·太祖纪三》"},"example":{"text":"同心一意，顿兴～之真情；因病生怜，遂起借花献佛之妄念。","book":"明李贽《代常通病僧告文》"},"usage":"作宾语、定语；用于兄弟"},{"id":30282,"word":"灼背烧顶","pinyin":"zhuó bèi shāo dǐng","abbr":"zbsd","explanation":"指佛教徒燃艾或焚香烧炙头顶背脊。","source":{"text":"用浮屠法灼背烧顶，刺血书佛经。","book":"《宋史·朱寿昌传》"}},{"id":30283,"word":"灼背烧项","pinyin":"zhuó bèi shāo dǐng","abbr":"zbsx","explanation":"灼：烧。指佛教徒燃艾或焚香烧炙头顶背脊","source":{"text":"用浮屠法灼背烧顶，刺血书佛经。","book":"《宋史·朱寿昌传》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":30284,"word":"灼艾分痛","pinyin":"zhuó ài fēn tòng","abbr":"zaft","explanation":"比喻兄弟友爱。","source":{"text":"太宗尝病亟，帝往视之，亲为灼艾。太宗觉痛，帝亦取艾自炙。","book":"《宋史·太祖纪》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“泽及枯骨，西伯之深仁；～，宋祖之友爱。”"},"usage":"作宾语、定语；用于兄弟","story":["北宋时期，宋太祖赵匡胤的弟弟赵匡义得病，十分痛苦。太祖去探望他并亲自为他灼艾治病。赵匡义感到很疼痛，叫了出来。太祖于是将热艾往自己身上灼烧，的确很痛，这样做可以分担弟弟的痛苦，赵匡义感到十分感动"]},{"id":30285,"word":"灼见真知","pinyin":"zhuó jiàn zhēn zhī","abbr":"zjzz","explanation":"指正确透彻的见解。","source":{"text":"平素具有灼见真知，临时乃能因材器使。","book":"郑观应《盛世危言·吏治下》"},"similar":["真知灼见","真知卓见"],"opposite":["一孔之见"],"usage":"作宾语、定语；用于书面语"},{"id":30286,"word":"灾梨祸枣","pinyin":"zāi lí huò zǎo","abbr":"zlhz","explanation":"从前印书用梨木或枣木刻板。形容滥刻无用不好的书。","source":{"text":"至于交通声气，号召生徒，祸枣灾梨，递相神圣，不但有明末造，标榜多诬，即月泉吟社诸人，亦病未离乎客气矣。","book":"清·纪昀《阅微草堂笔记》卷六"},"example":{"text":"其中或者有片言只语可采，敬烦删定。至于会不会有～，非我所能计了。","book":"高阳《胭脂井》"},"usage":"作谓语、宾语、定语；指滥刻无用的书"},{"id":30287,"word":"灾难深重","pinyin":"zāi nán shēn zhòng","abbr":"znsz","explanation":"灾难很多，而且严重。","source":{"text":"封建统治者丧权辱国，勾结帝国主义残酷压榨中国人民。国家日益贫弱，社会战乱不已，尽族灾难深重，人民饥寒交迫。","book":"江泽民《在庆祝中国共产党成立七十周年大会上的讲话》"},"example":{"text":"当年军阀混战时期兵乱不定，加上黄河决堤，虫灾连年，老百姓真是～啊！"},"usage":"作谓语、定语；多用于口语"},{"id":30288,"word":"灿烂夺目","pinyin":"càn làn duó mù","abbr":"cldm","explanation":"五光十色令人眩目。","source":{"text":"梦见天上五色云霞，灿烂夺目。","book":"明·冯梦龙《醒世恒言》第31卷"},"example":{"text":"这件首饰的光泽～。"},"similar":["光芒灿烂"],"opposite":["昏昏暗暗"],"usage":"作谓语、定语；指色彩丰富"},{"id":30289,"word":"灿烂炳焕","pinyin":"càn làn bǐng huàn","abbr":"clbh","explanation":"灿烂：鲜明耀眼；炳焕：光亮。光辉灿烂，鲜明耀眼。形容洁白鲜明的样子。","source":{"text":"瑰异谲诡，灿烂炳焕。","book":"汉·张衡《东京赋》"},"similar":["光辉灿烂"],"usage":"作谓语、定语；指耀眼"},{"id":30290,"word":"灿烂辉煌","pinyin":"càn làn huī huáng","abbr":"clhh","explanation":"灿烂：鲜明耀眼。形容光彩四射，鲜明耀眼。也比喻成绩卓著，十分引人注目。","source":{"text":"只觉金光万道，瑞气千条，灿烂辉煌，华彩夺目。","book":"清·李汝珍《镜花缘》第四十八回"},"example":{"text":"《西江月》：“领导全靠共产党，胜利～。”","book":"刘流《烈火金钢·开头语》"},"similar":["金碧辉煌"],"opposite":["暗淡无光"],"usage":"作谓语、定语；指色彩丰富"},{"id":30291,"word":"灿然一新","pinyin":"càn rán yī xīn","abbr":"cryx","explanation":"灿然：耀眼的光彩。耀眼的光彩，给人一种全新的感觉。","source":{"text":"其所以持盈守成，而熙丰之盛德美意，灿然一新，正夫其有力焉。","book":"《宣和书谱·行书·刘正夫》"},"example":{"text":"我们现今的局面已经～了。"},"similar":["焕然一新"],"usage":"作谓语、定语；指面貌、局面等"},{"id":30292,"word":"灿若繁星","pinyin":"càn ruò fán xīng","abbr":"crfx","explanation":"灿：灿烂。繁：众多。亮晶晶的就像天上众多的星星。比喻才能出从的人很多。","example":{"text":"站在石山顶上看海口夜景，真是～。"},"usage":"作宾语、定语；用于描写景物等"},{"id":30293,"word":"炉火纯青","pinyin":"lú huǒ chún qīng","abbr":"lhcq","explanation":"纯：纯粹。道士炼丹，认为炼到炉里发出纯青色的火焰就算成功了。后用来比喻功夫达到了纯熟完美的境界。","source":{"text":"洪炉烈火，洪焰翕赫；烟示及黔，焰不假碧。","book":"唐·孙思邈《四言诗》"},"example":{"text":"到了现在，可已到了～的气候，正是弟兄们各显身手的时期。","book":"清·曾朴《孽海花》第二十五回"},"similar":["挥洒自如","滚瓜烂熟","出神入化"],"opposite":["半路出家"],"usage":"作谓语、定语、状语；指学问、技术等"},{"id":30294,"word":"炊沙作糜","pinyin":"chuī shā zuò mí","abbr":"cszm","explanation":"煮沙子作饭。比喻徒劳无功，白费气力。","source":{"text":"炊沙作糜终不饱，镂冰文字费工巧。","book":"宋·黄庭坚《送王郎》诗"},"similar":["炊沙镂冰","炊沙作饭"],"usage":"作谓语、定语、宾语；比喻徒劳无功"},{"id":30295,"word":"炊沙作饭","pinyin":"chuī shā zuò fàn","abbr":"cszf","explanation":"煮沙子作饭。比喻徒劳无功，白费气力。","source":{"text":"君不见担雪塞井徒用力，炊沙作饭岂堪吃？","book":"唐·顾况《行路难》诗"},"example":{"text":"他经常干一些“～”之类的愚蠢事情。"},"similar":["徒劳无功","炊砂作饭"],"usage":"作谓语、定语、宾语；比喻徒劳无功"},{"id":30296,"word":"炊沙成饭","pinyin":"chuī shā chéng fàn","abbr":"cscf","explanation":"煮沙子做饭。比喻费力而无用。","source":{"text":"君不见担雪塞井空用力，炊沙作饭岂堪食。","book":"唐·顾况《行路难》诗"}},{"id":30297,"word":"炊沙镂冰","pinyin":"chuī shā lòu bīng","abbr":"cslb","explanation":"炊沙不能成饭，刻冰不能作器。比喻徒劳无功。","source":{"text":"绝编坏简徒自苦，炊沙镂冰初何功？","book":"宋·张淏《云谷杂记》卷首"},"similar":["炊沙作糜"],"usage":"作宾语、定语；用于处事"},{"id":30298,"word":"炊琼爇桂","pinyin":"chuī qióng ruò guì","abbr":"cqrg","explanation":"煮玉烧桂。比喻物价高昂。","source":{"text":"炊琼爇桂帝关居，卖尽寒衣典尽书。","book":"唐·林宽《献同年孔郎中》诗"},"similar":["米珠薪桂"],"usage":"作宾语、定语；用于生活"},{"id":30299,"word":"炊砂作饭","pinyin":"chuī shā zuò fàn","abbr":"cszf","explanation":"砂，同“沙”。煮沙子作饭。比喻徒劳无功，白费气力。","source":{"text":"唐·顾况《行路难》诗：“君不见担雪塞井徒用力，炊沙作饭岂堪吃？”一本作“炊砂作饭”。"},"example":{"text":"～的人不值一笑。"},"similar":["炊沙作饭"],"usage":"作谓语、定语、宾语；比喻徒劳无功"},{"id":30300,"word":"炊粱跨卫","pinyin":"chuī liáng kuà wèi","abbr":"clkw","explanation":"卫，驴的别名。用高粱做饭，骑驴子代步。形容简朴的生活。","source":{"text":"[顾炎武]常言：‘生平最憎者舟舆，而炊粱跨卫，乃此身安处也。’","book":"清·钮琇《觚剩·蒋山佣》"},"usage":"作宾语、定语；用于生活"},{"id":30301,"word":"炊臼之戚","pinyin":"chuī jiù zhī qī","abbr":"cjzq","explanation":"比喻丧妻。","source":{"text":"唐·段成式《酉阳杂俎·梦》：“贾客张瞻将归，梦炊于臼，问王生。生言：‘君归，不见妻矣。臼中炊，固无釜也。’贾客至家，妻果卒已数月。”无釜，谐音“无妇”。"},"example":{"text":"令兄太守公行，不及躬送，闻有～。","book":"明·李东阳《与顾天锡书》"},"similar":["炊臼之痛"],"usage":"作宾语；指丧妻","story":["从前有一个商人张瞻长期外出做买卖，正准备回家的晚上做了一个在舂米的器皿中做饭，觉得奇怪就问王生，王生解梦道：“你回家，没看见妻子就叫臼中炊——无釜（妇），可能你妻子已经过世。”张瞻回到家里，妻子果然死了有几个月了"]},{"id":30302,"word":"炊臼之痛","pinyin":"chuī jiù zhī tòng","abbr":"cjzt","explanation":"比喻丧妻。同“炊臼之戚”。","source":{"text":"辛丑仲春，余遭炊臼之痛，同人和悼亡诗甚多。","book":"清·查为仁《莲坡诗话》卷中"},"similar":["炊臼之戚"],"usage":"作宾语；指丧妻"},{"id":30303,"word":"炊金爨玉","pinyin":"chuī jīn cuàn yù","abbr":"cjcy","explanation":"炊：烧火做饭；爨：烧火做饭。用金玉做饭。比喻饮食珍贵，待客热情","source":{"text":"白饭青刍，待仆马之厚；炊金爨玉，谢款客之隆。","book":"明·程登吉《幼学琼林》第三卷"},"usage":"作谓语、定语；用于感谢款待"},{"id":30304,"word":"炊金馔玉","pinyin":"chuī jīn zhuàn yù","abbr":"cjzy","explanation":"炊：烧火做饭；馔：饮食，吃。形容丰盛的菜肴。","source":{"text":"平台戚里带崇墉，炊金馔玉待鸣钟。","book":"唐·骆宾王《帝京篇》"},"example":{"text":"此邦百万多豪家，～纷如麻。","book":"清·施润章《悲老牛》诗"},"similar":["山珍海味","馔玉炊金"],"opposite":["粗茶淡饭"],"usage":"作谓语、定语；比喻饮食珍贵"},{"id":30305,"word":"炊骨爨骸","pinyin":"chuī gǔ cuàn hái","abbr":"cgch","explanation":"指军队没有粮食，只好拿人马的骨骸来做饭","source":{"text":"鹄形菜色皆穷民饥饿之形；炊骨爨骸谓军中乏粮之惨。","book":"明·程登吉《幼学琼林》第三卷"},"usage":"作宾语、定语；用于书面语"},{"id":30306,"word":"炊鲜漉清","pinyin":"chuī xiān lù qīng","abbr":"cxlq","explanation":"指煮鱼滤酒。","example":{"text":"他们一家人炊鲜漉清，玩得十分开心。"}},{"id":30307,"word":"炎凉世态","pinyin":"yán liáng shì tài","abbr":"ylst","explanation":"炎：指亲热。凉：指冷淡。世态：人情世故。指有的人得势时就巴结奉迎，失势时就十分冷淡。","source":{"text":"炎凉世态，自古而然。","book":"宋·王懋《野客丛书·炎凉世态》"},"example":{"text":"那三夫人是个女流之辈，只晓得～，哪里管甚么大道理？","book":"明·凌濛初《初刻拍案惊奇》第九卷"},"similar":["世态炎凉"],"usage":"作宾语、定语；指社会百态"},{"id":30308,"word":"炎天暑月","pinyin":"yán tiān shǔ yuè","abbr":"ytsy","explanation":"指炎热的夏天。","source":{"text":"这八句诗题着炎天暑月，那公子王孙在凉亭上水阁中浸着浮瓜沉李，调冰雪藉避暑，尚兀自嫌热。","book":"明·施耐庵《水浒传》第16回"},"usage":"作宾语、定语；指夏天"},{"id":30309,"word":"炎黄子孙","pinyin":"yán huáng zǐ sūn","abbr":"yhzs","explanation":"炎黄：炎帝神农氏和黄帝有熊氏，代表中华民族的祖先。炎帝和黄帝的后代。指中华民族的后代。亦作“黄炎子孙”。","source":{"text":"我和她对视一会儿，承认：‘那倒也是，炎黄子孙嘛。’","book":"王朔《浮出海面》"},"example":{"text":"海内外的～都不会同意台独的。"},"usage":"作主语、宾语、定语；指中华儿女"},{"id":30310,"word":"炒买炒卖","pinyin":"chǎo mǎi chǎo mài","abbr":"cmcm","explanation":"指就地迅速转手买卖，从中牟利。","example":{"text":"没有实体的支持，靠～是不长久的。"},"similar":["倒买倒卖"],"usage":"作宾语、定语；用于商业"},{"id":30311,"word":"炒冷饭","pinyin":"chǎo lěng fàn","abbr":"clf","explanation":"比喻说话、做事全是重复过去的，没有新的内容","example":{"text":"这样的方法就是～，没有什么效果的"},"usage":"作谓语、宾语、定语；多用于口语"},{"id":30312,"word":"炒鱿鱼","pinyin":"chǎo yóu yú","abbr":"cyy","explanation":"因鱿鱼一炒就卷起来，比喻卷铺盖。指解雇。","example":{"text":"职员被～是经常的事。"},"similar":["卷铺盖"],"usage":"作谓语、宾语；用于工作或职业等"},{"id":30313,"word":"炙冰使燥","pinyin":"zhì bīng shǐ zào","abbr":"zbsz","explanation":"炙：烤。用火烤冰，想使它干燥。比喻事情办不到。","source":{"text":"欲望萧雍济济，后生有武，是犹炙冰使燥，积灰令炽矣。","book":"《抱朴子·刺骄》"},"similar":["异想天开"],"usage":"作谓语、定语；指处理问题的方式不对"},{"id":30314,"word":"炙凤烹龙","pinyin":"zhì fèng pēng lóng","abbr":"zfpl","explanation":"烹：煮；烹：烧。形容菜肴极为丰盛、珍奇。","source":{"text":"烹龙炮凤玉脂泣，罗屏绣幕围香风。","book":"唐·李贺《将进酒》诗"},"example":{"text":"面对～的酒席，我一点胃口也没有"},"similar":["烹龙炰凤","烹龙炮凤"],"usage":"作谓语、定语；用于菜肴或艺术作品"},{"id":30315,"word":"炙手可热","pinyin":"zhì shǒu kě rè","abbr":"zskr","explanation":"手摸上去感到热得烫人。比喻权势大，气焰盛，使人不敢接近。","source":{"text":"炙手可热势绝伦，慎莫近前丞相嗔。","book":"唐·杜甫《丽人行》"},"example":{"text":"～握大权，待郎充犬吠篱边。","book":"清·陈忱《水浒后传》第一回"},"similar":["烜赫一时","望而生畏","敬而远之"],"opposite":["平易近人","和蔼可亲"],"usage":"作谓语、定语；指人的权势等","story":["唐玄宗宠信杨贵妃，任命他的哥哥杨国忠为宰相，把朝政大事全交他去处理。杨家兄妹过着花天酒地、穷奢极欲的生活，诗人杜甫对杨氏兄妹极为不满，作《丽人行》讽刺他们的荒淫无道：“炙手可热势绝伦，慎莫近前丞相嗔。”"]},{"id":30316,"word":"炙手而热","pinyin":"zhì shǒu ér rè","abbr":"zser","explanation":"炙：烤。手摸上去感到热得烫人。比喻权势大，气焰盛，使人不敢接近。","source":{"text":"炙手可热势绝伦，慎莫近前丞相嗔。","book":"唐·杜甫《丽人行》"},"example":{"text":"嵩久握重权～。（《明史·董传策传》云）"},"similar":["炙手可热"],"usage":"作谓语、定语；指人的权势等"},{"id":30317,"word":"炙肤皲足","pinyin":"zhì fū jūn zú","abbr":"zfjz","explanation":"皮肤晒焦，足部冻裂。形容农民耕作的辛苦。","source":{"text":"耕人有炙肤皲足之烦，农女有将桑行馌之勤。","book":"明·宋濂《阅江楼记》"},"usage":"作定语；用于书面语"},{"id":30318,"word":"炙鸡渍酒","pinyin":"zhì jī zì jiǔ","abbr":"zjzj","explanation":"指以棉絮浸酒，晒干后裹烧鸡，携以吊丧。后遂用为不忘恩的典实。","source":{"text":"穉诸公所辟虽不就，有死丧负笈赴吊。常於家豫炙鸡一只，以一两绵絮渍酒中，暴乾以裹鸡，径到所起冢外，……醊酒毕，留谒则去，不见丧主。","book":"《后汉书·徐穉传》“穉尝为太尉黄琼所辟，不就”李贤注引三国吴谢承《后汉书》"},"example":{"text":"[东汉徐孺子]～，万里赴吊……有忠厚不忘恩之意。","book":"宋·罗大经《鹤林玉露》卷九"},"usage":"作宾语、定语；用于书面语"},{"id":30319,"word":"炙鸡絮酒","pinyin":"zhì jī xù jiǔ","abbr":"zjxj","explanation":"用一只鸡和棉絮渍酒祭奠。指悼念故人，祭品虽薄而情意很深。","source":{"text":"稚尝为太尉黄琼所辟，不就。及琼卒归葬，稚乃负粮徒步到江夏赴之，设鸡酒薄祭，哭毕而去。不告姓名。","book":"南朝·宋·范晔《后汉书·徐稚传》"},"similar":["只鸡絮酒"],"usage":"作宾语、定语；指悼念故人","story":["汉朝时期，徐稚受太尉黄琼所荐而当官，后来离职。黄琼病故归葬故乡，徐稚则在家里烧烤一只鸡，用一两棉絮渍酒后晒干裹住鸡，背上干粮到黄琼的家乡江夏去拜祭。在黄琼的坟前，他用水渍棉出酒，拜祭完毕就回家"]},{"id":30320,"word":"炫奇争胜","pinyin":"xuàn qí zhēng shèng","abbr":"xqzs","explanation":"炫：夸耀。夸耀新奇，竞争胜负。","source":{"text":"火神庙中玉器摊，尤炫奇争胜，贵族妇女及富商外贾多趋之。","book":"清·崇彝《道咸以来朝野杂记》"},"usage":"作谓语、定语；用于处事"},{"id":30321,"word":"炫巧斗妍","pinyin":"xuàn qiǎo dòu yán","abbr":"xqdy","explanation":"指夸奇竞妙。","source":{"text":"视夫专崇末技、炫巧斗妍而无实义者，犹为质胜于文。","book":"清·薛福成《代李伯相重锲序》"},"usage":"作谓语、定语；用于书面语"},{"id":30322,"word":"炫异争奇","pinyin":"xuàn yì zhēng qí","abbr":"xyzq","explanation":"指夸奇斗异。","source":{"text":"泰西制造之精且新者，层见叠出，炫异争奇，日新月异。","book":"清·郑观应《盛世危言·技艺》"},"example":{"text":"郑观应《盛世危言·技艺》：“泰西制造之精且新者，层见叠出，～，日新月异。”"},"usage":"作谓语、定语；用于处事"},{"id":30323,"word":"炫昼缟夜","pinyin":"xuàn zhòu gǎo yè","abbr":"xzgy","explanation":"指李花色白，其光采或照耀于白天，或显现于夜晚。","source":{"text":"积李兮缟夜，崇桃兮炫昼。","book":"宋·王安石《寄蔡氏女子诗》"},"example":{"text":"因晚登碧落堂，望隔江桃皆暗，而李独明，乃悟其妙，盖炫昼缟夜。","book":"宋·杨万里《读退之李花诗序》"},"usage":"作宾语、定语；用于书面语"},{"id":30324,"word":"炫服靓妆","pinyin":"xuàn fú jìng zhāng","abbr":"xfjz","explanation":"炫服：华丽的服装；靓妆：美丽的装饰。形容服饰打扮十分艳丽。也指打扮得十分艳丽的人。","source":{"text":"忽见李氏自帏而出，靓妆炫服，有逾平素。","book":"唐·载浮《广异记·王光本》"},"example":{"text":"铙吹拍拍走烟尘，～千万人。","book":"明·袁宏道《迎春歌和江进之》"}},{"id":30325,"word":"炫玉求售","pinyin":"xuàn yù qiú shòu","abbr":"xyqs","explanation":"自诩有才，以求施展。","source":{"text":"求教于愚人是问道于盲；枉道以干主是炫玉求售。","book":"明·程登吉《幼学琼林》第三卷"},"example":{"text":"～的做法在当今社会是行不通的。"},"usage":"作宾语、定语；用于处事"},{"id":30326,"word":"炫玉贾石","pinyin":"xuàn yù gǔ shí","abbr":"xygs","explanation":"炫：夸耀；贾：卖。拿玉吸引人，卖出的却是石头。比喻说的和做的不相符合。","source":{"text":"是夫炫玉而贾石者也，往必见擒，何贼之攘。","book":"汉·扬雄《法言·问道》：“炫玉而贾石者，其狙诈乎？”《新唐书·柳浑传》"},"similar":["挂羊头，卖狗肉","心口不一"],"opposite":["心口如一"],"usage":"作谓语、定语；指言行不一"},{"id":30327,"word":"炫石为玉","pinyin":"xuàn shí wéi yù","abbr":"xswy","explanation":"炫：夸耀。拿玉吸引人，卖出的却是石头。比喻说的和做的不相符合。","source":{"text":"炫玉而贾石者，其狙诈乎？","book":"汉·扬雄《法言·问道》"},"example":{"text":"苟以霸者之心而求王道成，是～也。","book":"宋·程颢《论王霸之辨》"},"similar":["炫玉贾石","心口不一"],"opposite":["心口如一","言行一致"],"usage":"作谓语、定语；指言行不一"},{"id":30328,"word":"炮凤烹龙","pinyin":"páo fèng pēng lóng","abbr":"pfpl","explanation":"炮：烧；烹：煮。形容菜肴极为丰盛、珍奇。","source":{"text":"烹龙炮凤玉脂泣，罗屏绣幕围香风。","book":"唐·李贺《将进酒》诗"},"example":{"text":"今日个宴赏群公，光禄寺酝江酿海，尚食局～。","book":"元·王实甫《丽春堂》第一折"},"similar":["烹龙炮凤"],"usage":"作宾语、定语；形容豪奢珍奇的菜肴"},{"id":30329,"word":"炮火连天","pinyin":"pào huǒ lián tiān","abbr":"phlt","explanation":"形容炮火非常猛烈。","source":{"text":"他父子并唐僧在城楼上点劄，旌旗蔽日，炮火连天。","book":"明·吴承恩《西游记》第八十九回"},"example":{"text":"这不过演放两三响已经这样了，何况～，亲临大敌呢，自然也要逃走了。","book":"清·吴趼人《二十年目睹之怪现状》第十六回"},"similar":["战火纷飞","烽烟遍地"],"opposite":["国泰民安","河清海晏"],"usage":"作谓语、定语；指炮火袭击猛烈"},{"id":30330,"word":"炮筒子","pinyin":"pào tǒng zǐ","abbr":"ptz","explanation":"比喻心直口快、好发议论的急性人。","example":{"text":"他是典型的～，藏不住话的。"},"similar":["直肠子"],"usage":"作宾语、定语；用于比喻句"},{"id":30331,"word":"炮龙烹凤","pinyin":"pào lóng pēng fèng","abbr":"plpf","explanation":"形容豪奢珍奇的肴馔。","source":{"text":"堂上堂下，皆列位次，大设筵宴，轮番把盏。厅前大吹大擂。虽无炮龙烹凤，端的是肉山酒海。","book":"明·施耐庵《水浒传》第八十二回"},"similar":["烹龙炮凤"],"usage":"作谓语、定语；用于菜肴或艺术作品"},{"id":30332,"word":"炯炯有神","pinyin":"jiǒng jiǒng yǒu shén","abbr":"jjys","explanation":"炯炯：明亮的样子。形容人的眼睛发亮，很有精神。","source":{"text":"先生头颅圆阔，体貌丰隆，海口童颜，轮耳方面，两目炯炯有神，须虽整秀，异不多耳。","book":"明·李开先《闲居集·九·泾野吕亚卿传》"},"example":{"text":"～的眼光，足够表现出他是一个有志的少年。","book":"郑振铎《黄公俊之最后》"},"similar":["目光炯炯","目光如炬"],"opposite":["模糊不清"],"usage":"作宾语、定语、状语；指人的眼睛"},{"id":30333,"word":"炰凤烹龙","pinyin":"páo fèng pēng lóng","abbr":"pfpl","explanation":"烹：煮。形容菜肴极为丰盛、珍奇。比喻作家的艺术技巧高明。","source":{"text":"我听得朱门里奏笙歌，相府内夜排筵宴，炰凤烹龙。","book":"明·无名氏《渔樵闲话》第一折"},"similar":["烹龙炮凤","炮凤烹龙"],"usage":"作谓语、定语；用于菜肴或艺术作品"},{"id":30334,"word":"炰鳖脍鲤","pinyin":"fèng biē kuài lǐ","abbr":"pbkl","explanation":"指珍美的馔食。"},{"id":30335,"word":"炳如日星","pinyin":"bǐng rú rì xīng","abbr":"brrx","explanation":"光明如同日月星辰。","source":{"text":"二帝二皇之书，先圣先师之训，炳如日星。","book":"宋·陆九渊《贵溪重修县学记》"},"similar":["炳若日星"],"usage":"作谓语、定语；用于称颂人"},{"id":30336,"word":"炳如观火","pinyin":"bǐng rú guān huǒ","abbr":"brgh","explanation":"炳：光明、明亮、显著。形容看得清楚明白。","source":{"text":"其词秩然有条，各分大义，炳如观火。","book":"鲁迅《坟·文化偏至论》"},"similar":["炳若观火","一目了然"],"opposite":["朦朦胧胧"],"usage":"作谓语、定语；指人的眼光"},{"id":30337,"word":"炳炳凿凿","pinyin":"bǐng bǐng záo záo","abbr":"bbzz","explanation":"形容所术明确有据。","source":{"text":"丘橓、吕坤虽非瑞匹，而指陈时政，炳炳凿凿，鲠亮有足称者。","book":"《明史·海瑞等传赞》"},"similar":["确确凿凿"],"opposite":["空穴来风","无凭无据"],"usage":"作谓语、定语、状语；用于说话或作文"},{"id":30338,"word":"炳炳烺烺","pinyin":"bǐng bǐng lǎng lǎng","abbr":"bbll","explanation":"光亮鲜明。形容文章辞采声韵之美。","source":{"text":"乃知文者以明道，是固不苟为炳炳烺烺，务采色、夸声音而以为能也。","book":"唐·柳宗元《答韦中立论师道书》"},"example":{"text":"千载而下，仰其风者犹将奋起；况其发之为～之辞，诵之有铿铿锵锵之声音哉。","book":"清·姚莹《复杨君论诗文书》"},"usage":"作谓语、定语；用于诗文等"},{"id":30339,"word":"炳炳焤焤","pinyin":"bǐng bǐng lǎng lǎng","abbr":"bbll","explanation":"光亮鲜明。形容文章辞采声韵之美。","source":{"text":"乃知文者以明道，是固不苟为炳炳焤焤，务采色、夸声音而以为能也。","book":"唐·柳宗元《答韦中立论师道书》"},"quote":{"text":"千载而下，仰其风者犹将奋起；况其发之为～之辞，诵之有铿铿锵锵之声音哉。","book":"清·姚莹《复杨君论诗文书》"}},{"id":30340,"word":"炳炳麟麟","pinyin":"bǐng bǐng lín lín","abbr":"bbll","explanation":"光明显赫的样子。","source":{"text":"帝典阙者已补，王纲弛者已张，炳炳麟麟，岂不懿战。","book":"汉·扬雄《剧秦美新》"},"usage":"作谓语、定语；用于诗文等"},{"id":30341,"word":"炳烛之明","pinyin":"bǐng zhú zhī míng","abbr":"bzzm","explanation":"点燃蜡烛，用以照明。形容人到老年，好学不倦。","source":{"text":"老而好学，如炳烛之明。","book":"汉·刘向《说苑》"},"usage":"作主语、宾语；指短暂的光亮"},{"id":30342,"word":"炳烛夜游","pinyin":"bǐng zhú yè yóu","abbr":"bzyy","explanation":"旧时比喻及时行乐。","source":{"text":"少壮真当努力，年一过往，何可攀援？古人思炳烛夜游，良有以也！","book":"三国·魏·曹丕《又与吴质书》"},"similar":["秉烛夜游"],"usage":"作谓语、宾语、定语；指及时行乐"},{"id":30343,"word":"炳若日星","pinyin":"bǐng ruò rì xīng","abbr":"brrx","explanation":"光明如同日月星辰。同“炳如日星","source":{"text":"仁皇一朝人才之盛，如文正公、文忠公、师鲁，皆第一流人，名书国史，炳若日星，初不假于称赞。","book":"宋·周煇《清波杂志》卷上"},"example":{"text":"清·吴璿《飞龙全传》第19回：“今日见恩兄心事，～，严如霜露，凛不可犯。”"},"similar":["炳如日星"],"usage":"作谓语、定语；用于称颂人"},{"id":30344,"word":"炳若观火","pinyin":"bǐng ruò guān huǒ","abbr":"brgh","explanation":"形容看得清楚明白。","source":{"text":"人民之职业物产之制造，种种殊异之处，则如网在纲，炳若观火。","book":"梁启超《欧洲地埋大势论》"},"similar":["炳如观火"],"opposite":["朦朦胧胧"],"usage":"作谓语、定语；指人的眼光"},{"id":30345,"word":"点头之交","pinyin":"diǎn tóu zhī jiāo","abbr":"dtzj","explanation":"指交情甚浅，见了面只不过点点头而已。","source":{"text":"少说也有百儿八十，点头之交，那就数不清了。","book":"周而复《上海的早晨》第一部"},"example":{"text":"他只能算我的～罢了。"},"similar":["一面之交","一面之缘"],"opposite":["生死之交"],"usage":"作主语、宾语；指一面之缘"},{"id":30346,"word":"点头会意","pinyin":"diǎn tóu huì yì","abbr":"dthy","explanation":"①形容机灵乖觉。②表示允可、赞许。","source":{"text":"柴进唤燕青，附耳低言：‘你与我如此如此。’燕青是个点头会意的人，不必细问，火急下楼。","book":"《水浒传》第七二回"},"example":{"text":"鸳鸯的魂听了～，便跟了秦氏，可卿而去。","book":"《红楼梦》第一一一回"},"usage":"作谓语、定语；用于人"},{"id":30347,"word":"点头咂嘴","pinyin":"diǎn tóu zā zuǐ","abbr":"dtzz","explanation":"表示同意、赞赏。","source":{"text":"张老婆儿一旁看了，也不住的点头咂嘴。","book":"《儿女英雄传》第九回"},"example":{"text":"站在国旗下面听讲的……～的嘟囔着：‘对了！’‘可不是！’","book":"老舍《二马》第一段一"},"usage":"作谓语、状语；指赞同"},{"id":30348,"word":"点头哈腰","pinyin":"diǎn tóu hā yāo","abbr":"dthy","explanation":"比喻虚假的恭敬或过分的客气。","source":{"text":"比他穷的人，知道他既是钱狠子，手脚又厉害，都只向他点头哈腰的敬而远之。","book":"老舍《四世同堂》三四"},"example":{"text":"哦，哦，侄子！‘我刚才听说你走，也赶来送送！’谢清斋满脸是笑，～地说。","book":"魏巍《东方》第一部第十章"},"similar":["打躬作揖"],"opposite":["刚正不阿"],"usage":"作谓语、定语、宾语；指卑微的讨好"},{"id":30349,"word":"点头称善","pinyin":"diǎn tóu chēng shàn","abbr":"dtcs","explanation":"道：说；善：好。表示赞同。","source":{"text":"必先主张，能将湘省收复，使南军稍惮声戚，方可再申和议，冯也点头称善。","book":"蔡东藩《民国通俗演义》第91回"},"example":{"text":"蔡东藩《民国通俗演义》第91回：“必先主张，能将湘省收复，使南军稍惮声戚，方可再申和议，冯也～。”"},"similar":["点头道是","点头称是"],"usage":"作谓语、定语；指赞成"},{"id":30350,"word":"点头称是","pinyin":"diǎn tóu chēng shì","abbr":"dtcs","explanation":"表示赞成或肯定。","source":{"text":"公子自知手中只有五十金，此时费去大半，说道资斧困竭……不觉点头道是。","book":"明·冯梦龙《警世通言·杜十娘怒沉百宝箱》"},"example":{"text":"他们都听得津津有味，～。","book":"邹韬奋《经历·再被羁押》"},"similar":["点头道是","点头称善"],"usage":"作谓语、定语；指赞成"},{"id":30351,"word":"点头道是","pinyin":"diǎn tóu dào shì","abbr":"dtds","explanation":"表示赞成或肯定。","source":{"text":"公子自知手中只有五十金，此时费去大半，说道资斧困竭……不觉点头道是。","book":"明·冯梦龙《警世通言·杜十娘怒沉百宝箱》"},"similar":["点头称善","点头称是"],"usage":"作谓语、定语；指赞成"},{"id":30352,"word":"点屏成蝇","pinyin":"diǎn píng chéng yíng","abbr":"dpcy","explanation":"屏：屏风。把屏风上的污点画成苍蝇。形容绘画技术十分高超。","source":{"text":"曹不兴，吴兴人也。孙权使画屏风，误落笔点素，因就成蝇状。权疑其真，以手弹之。","book":"唐·张彦远《历代名画记》卷四"}},{"id":30353,"word":"点手划脚","pinyin":"diǎn shǒu jí jiǎo","abbr":"dshj","explanation":"形容说话时兼用手势示意。多形容说话放任不拘，或轻率地指点、批评。","source":{"text":"只见知观指点扛棺的，正在那里点手划脚时节，公人就一把擒住了。","book":"《初刻拍案惊奇》卷十七"},"similar":["点指划脚"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":30354,"word":"点手莋脚","pinyin":"diǎn shǒu huá jiǎo","abbr":"dszj","explanation":"形容说话时兼用手势示意。多形容说话放任不拘，或轻率地指点、批评。"},{"id":30355,"word":"点指划脚","pinyin":"diǎn zhǐ jí jiǎo","abbr":"dzhj","explanation":"形容说话时兼用手势示意。多形容说话放任不拘，或轻率地指点、批评。同“点手划脚”。","source":{"text":"[小道人]只见来到肆前，果然一个少年美貌的女子在那里点指划脚教人下棋。","book":"《二刻拍案惊奇》卷二"},"similar":["点手划脚"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":30356,"word":"点指画字","pinyin":"diǎn zhǐ huà zì","abbr":"dzhz","explanation":"指在合同文约或供词上按手印签字画押。","source":{"text":"诸婚娶两家，并用点指画字，写立合同文约，明白具载往回聘礼。","book":"宋·陈元靓《事林广记·家礼·婚礼》"},"example":{"text":"安抚见洪三招状明白，～。二妇人见洪三已招，惊得魂不附体。","book":"《清平山堂话本·错认尸》"},"similar":["点纸画字"],"usage":"作谓语、定语、宾语；用于签约"},{"id":30357,"word":"点指莋脚","pinyin":"diǎn zhǐ cè jiǎo","abbr":"dzzj","explanation":"形容说话时兼用手势示意。多形容说话放任不拘，或轻率地指点、批评。同“点手莋脚”。"},{"id":30358,"word":"点水不漏","pinyin":"diǎn shuǐ bù lòu","abbr":"dsbl","explanation":"形容十分周到、严密，毫无差失漏洞。","source":{"text":"罗成见线娘这枝方天戟，使得神出鬼没，点水不漏。","book":"《隋唐演义》第四九回"},"similar":["滴水不漏"],"usage":"作谓语、状语、补语；指严密"},{"id":30359,"word":"点滴归公","pinyin":"diǎn dī guī gōng","abbr":"ddgg","explanation":"指公家的钱财一点一滴都归还公家，丝毫不浪费或私用。","source":{"text":"真是涓滴归公，一丝一毫不敢乱用。","book":"清·李宝嘉《官场现形记》第三十三回"},"example":{"text":"阳翰升、程步高经手的一件，那要算是数目最大而且最容易舞弊的一件，却是～。","book":"郭沫若《洪波曲》第八章"},"similar":["大公无私"],"opposite":["据为己有"],"usage":"作宾语、定语；指不自私"},{"id":30360,"word":"点点滴滴","pinyin":"diǎn diǎn dī dī","abbr":"dddd","explanation":"一点一滴，形容数量非常少。","source":{"text":"眼光四射，口中流出涎来，点点滴滴，滴在水内。","book":"清·钱彩《说岳全传》第四回"},"example":{"text":"学习要靠～地积累。"},"similar":["一点一滴"],"opposite":["成千上万"],"usage":"作宾语、定语、状语；指数量少"},{"id":30361,"word":"点睛之笔","pinyin":"diǎn jīng zhī bǐ","abbr":"djzb","explanation":"笔：文笔。指文章传神绝妙之处。","source":{"text":"恺之每画人成，或数年不点目睛。人问其故。答曰：‘四体妍蚩，本无阙少于妙处，传神写照，正在阿睹中。’","book":"《晋书·顾恺之传》"},"similar":["画龙点睛"],"usage":"作宾语；用于文章或作品的一部分"},{"id":30362,"word":"点石为金","pinyin":"diǎn shí wéi jīn","abbr":"dswj","explanation":"指用手指一点使石变成金的法术。同“点铁成金”。","source":{"text":"四愿得吕纯阳祖师点石为金这个手指头。","book":"《警世通言·吕大郎还金完骨肉》"}},{"id":30363,"word":"点石成金","pinyin":"diǎn shí chéng jīn","abbr":"dscj","explanation":"比喻修改文章时稍稍改动原来的文字，就使它变得很出色。","source":{"text":"诗句以一字为工，自然颖异不凡，如灵丹一粒，点石成金也。","book":"宋·胡仔《苕溪渔隐丛话后集·孟浩然》"},"example":{"text":"诗，硬是可以～的嘛！改一个字，诗就活了。","book":"郭沫若《关于大规模收集民歌问题》"},"similar":["点铁成金"],"opposite":["点金成铁"],"usage":"作谓语、定语；用于文章等","story":["晋朝初年，南昌人许逊被朝廷任命为旌阳县令，他看到很多老百姓的租税交不了，非常同情他们，用点石成金的法术，免去百姓的租税。他上任不久，看到官场上争权夺利、勾心斗角，顿生厌倦之情，于是辞去官职到各地去游历"]},{"id":30364,"word":"点纸画字","pinyin":"diǎn zhǐ huà zì","abbr":"dzhz","explanation":"指在契约或供词上捺指模和签押。","source":{"text":"诸婚娶两家，并用点纸画字，写立合同文约，明白具载往回聘礼。","book":"宋·陈元靓《事林广记·家礼·婚礼》"},"example":{"text":"安抚见洪三招状明白，～。二妇人见洪三已招，惊得魂不附体。","book":"《清平山堂话本·错认尸》"},"similar":["点指画字"],"usage":"作谓语、定语、宾语；用于签约"},{"id":30365,"word":"点胸洗眼","pinyin":"diǎn xiōng xǐ yǎn","abbr":"dxxy","explanation":"指一洗尘俗，使人豁然明朗。","source":{"text":"《通释》云：‘字原有秦隶汉隶，今当以晋唐书为晋隶唐隶，则自然易晓也。’张绅此言，可为点胸洗眼之语。","book":"明·陈继儒《偃曝谈馀》卷下"},"usage":"作定语；用于指点、观点等"},{"id":30366,"word":"点金乏术","pinyin":"diǎn jīn fá shù","abbr":"djfs","explanation":"术：法术，方法。没有点铁成金的法术。比喻没有最好的方法筹集钱财，解决贫困。","source":{"text":"民困滋深，饷源已竭，点金乏术，忧心如焚。","book":"清·张集馨《道咸宦海见闻录·朋僚函札·王有龄来函之二》"},"example":{"text":"～欲何之，泽被苍生彼一时。","book":"高增《新游仙》诗"},"similar":["点金无术"],"usage":"作谓语、定语；指缺乏筹资能力"},{"id":30367,"word":"点金作铁","pinyin":"diǎn jīn zuò tiě","abbr":"djzt","explanation":"用以比喻把好文章改坏。也比喻把好事办坏。同“点金成铁”。","source":{"text":"尊作遵命僭笔改窜奉上，仍恐点金作铁，贻笑后人耳。","book":"清·朱之瑜《答野传书》之八"},"example":{"text":"分明是画足添蛇，谁承望官司喜悦，不罪我～。","book":"清·李渔《标何天·密筹》"},"similar":["点金成铁"],"usage":"作谓语、定语；用于文章等"},{"id":30368,"word":"点金成铁","pinyin":"diǎn jīn chéng tiě","abbr":"djct","explanation":"用以比喻把好文章改坏。也比喻把好事办坏。","source":{"text":"问：‘还丹一粒，点铁成金；至理一言，点凡成圣。请师一点。’师曰：‘还知齐云点金成铁吗？’曰：‘点金成铁，未之前闻。至理一言，敢希垂示！’","book":"宋·释道原《景德传灯录·真觉大师灵照》"},"example":{"text":"顾本为后人以解字本涂改，往往有～之憾。","book":"清·纽树玉《校刻说文系传跋》"},"similar":["点金作铁"],"opposite":["点铁成金","点石成金"],"usage":"作谓语、定语；用于文章等","story":["宋朝时期，王安石很欣赏南朝梁国诗人王籍的《入若邪溪》诗中“蝉噪林逾静，鸟鸣山更幽”两句，在自己的《钟山绝句》中袭改为“一鸟不鸣山更幽”，并向黄庭坚吹嘘。黄庭坚认为王安石这样一改就是点金成铁之作"]},{"id":30369,"word":"点金无术","pinyin":"diǎn jīn wú shù","abbr":"djws","explanation":"点：点化；术：法术，方法。没有点铁成金的法术。比喻没有方法筹集钱财","source":{"text":"袛今辽左用饷不赀，司农束手，臣又一一求多，实是点金无术。","book":"明·徐光启《恭承新命谨陈急切事宜疏》"},"example":{"text":"清·李汝珍《镜花缘》第13回：“自从父亲获罪，母病又发，～，惟有焦愁。”"},"similar":["点金乏术"],"usage":"作谓语、定语；指缺乏筹资能力"},{"id":30370,"word":"点铁成金","pinyin":"diǎn tiě chéng jīn","abbr":"dtcj","explanation":"原指用手指一点使铁变成金的法术。比喻修改文章时稍稍改动原来的文字，就使它变得很出色。","source":{"text":"古之能为文章者，真能陶冶万物，虽取古人之陈言入于翰墨，如灵丹一粒，点铁成金也。","book":"宋·黄庭坚《答洪驹父书》"},"example":{"text":"真是～，会者不难，只改得二三十个字，便通篇改观了。","book":"清·吴趼人《二十年目睹之怪现状》第四十三回"},"similar":["点石成金"],"opposite":["点金成铁"],"usage":"作谓语、定语；用于文章等"},{"id":30371,"word":"炼之未定","pinyin":"liàn zhī wèi dìng","abbr":"lzwd","explanation":"用心琢磨，反复锤炼，决定不下来。","example":{"text":"我们写作经常在一些关键用词上～。"},"usage":"作谓语、宾语；用于写作"},{"id":30372,"word":"炼石补天","pinyin":"liàn shí bǔ tiān","abbr":"lsbt","explanation":"炼：用加热的方法使物质纯净或坚韧。古神话，相传天缺西北，女娲炼五色石补之。比喻施展才能和手段，弥补国家以及政治上的失误。","source":{"text":"于是女娲炼五色石以补苍天，断鳌足以立四极。","book":"西汉·刘安《淮南子·览冥训》"},"example":{"text":"西汉·刘安《淮南子·览冥训》：“于是女娲炼五色石以补苍天，断鳌足以立四极。”"},"similar":["女娲补天"],"usage":"作谓语、定语；指竭力挽回颓势","story":["传说盘古开天用四根“不周山”大柱子支撑天地，共工与颛顼争夺帝位将不周山撞倒，天地裂了一条大缝，女娲氏在高山上架起神火，炼了36501块五彩石把天的裂缝补了起来，砍大鳌腿支撑天，从此天地就永久牢固了"]},{"id":30373,"word":"烁玉流金","pinyin":"shuò yù liú jīn","abbr":"sylj","explanation":"指温度极高，能将金石熔化。形容酷热。同“烁石流金”。","source":{"text":"投泥泼水愈光明，烁玉流金见精悍。","book":"宋·苏轼《石炭》诗"},"similar":["烁石流金"],"usage":"作谓语、定语；形容天气酷热"},{"id":30374,"word":"烁石流金","pinyin":"shuò shí liú jīn","abbr":"sslj","explanation":"指温度极高，能将金石熔化。形容酷热。烁，通“铄”。","source":{"text":"是时炎旱累月，烁石流金，晴空万里。","book":"唐·康骈《剧谈录·狄惟谦请雨》"},"example":{"text":"任凭他～，遇着时枯泉辙涸。","book":"明·许仲琳《封神演义》第92回"},"similar":["铄石流金","烁玉流金"],"opposite":["折胶堕指"],"usage":"作谓语、定语；形容天气酷热"},{"id":30375,"word":"烂如指掌","pinyin":"làn rú zhǐ zhǎng","abbr":"lrzz","explanation":"犹言了如指掌。形容对情况了解得非常清楚。","source":{"text":"其父成璧，亦异人，少为群盗，未尝读书识之无，乃古今之世代治乱，是非成败，烂如指掌。","book":"清·刘献廷《广阳杂记》卷三"},"similar":["了如指掌","烂若披掌"],"opposite":["一团漆黑"],"usage":"作谓语；指对事物十分了解"},{"id":30376,"word":"烂漫天真","pinyin":"làn màn tiān zhēn","abbr":"lmtz","explanation":"形容心地纯真，不虚伪。","source":{"text":"李太白着宫锦袍醉眠长安市上，纯是烂漫天真，千古岂容第二人装点此蕃举动。","book":"清·陈康祺《郎潜纪闻》第九卷"},"example":{"text":"她还是一个～的孩子。"},"similar":["天真烂漫"],"opposite":["老成持重"],"usage":"作谓语、定语；用于儿童或女性"},{"id":30377,"word":"烂熳天真","pinyin":"làn màn tiān zhēn","abbr":"lmtz","explanation":"形容心地纯真，不虚伪做作。","source":{"text":"醉薰薰，无何乡里好潜身。闲愁心上消磨尽，烂熳天真，贤愚有几人？","book":"元·李伯瞻《殿前欢·省悟》曲"},"example":{"text":"断荤戒酒，佛之似也。～，佛之真也。","book":"清·蒲松龄《聊斋志异·乐仲》"},"similar":["烂漫天真"],"opposite":["老气横秋"],"usage":"作谓语、定语；用于儿童或女性"},{"id":30378,"word":"烂羊头","pinyin":"làn yáng tóu","abbr":"lyt","explanation":"比喻滥授官爵，商人厨师皆得为官。","source":{"text":"灶下养，中郎将，烂羊胃：骑都尉，烂羊头，关内侯。","book":"《后汉书·刘玄传》"},"example":{"text":"可羡当时张许辈，蒲萄宫里～。","book":"元·王冕《秋夜偶成六首》其六"},"usage":"作宾语、定语；用于比喻句","story":["汉朝后期，宫廷内部腐败，外戚与宦官的斗争一直不断，两派为了拉拢自己的势力，对外滥授官职，所授的官职名目繁多，小商人、厨子等纷纷穿绣面官服。百姓怨声载道并编制歌谣：“灶上养，中郎将。烂羊胃，骑都尉。烂羊头，关内侯。”"]},{"id":30379,"word":"烂若披掌","pinyin":"làn ruò pī zhǎng","abbr":"lrpz","explanation":"形容对情况非常熟悉。","source":{"text":"与人言古今成败，烂若披掌，听者忘倦。","book":"清·王晫《今世说·客止》"},"similar":["烂如指掌","烂如指掌"],"usage":"作谓语；指对事物十分了解"},{"id":30380,"word":"烂若披锦","pinyin":"làn ruò pī jǐn","abbr":"lrpj","explanation":"形容文辞华丽。","source":{"text":"渊文烂若披锦，无处不善；陆文若排沙简金，往往见宝。","book":"南朝·宋·刘义庆《世说新语·文学》"},"similar":["烂若舒锦"],"usage":"作谓语；形容文辞华丽","story":["晋朝时期，人们善于清谈，经常评论别人的作品。孙兴公认为潘岳的文采灿烂，如同张挂的锦绣，没有一处不美；陆机的文采如同去掉流沙捡起金子，常常遇到闪光的瑰宝"]},{"id":30381,"word":"烂若舒锦","pinyin":"làn ruò shū jǐn","abbr":"lrsj","explanation":"形容文辞华丽。同“烂若披锦”。","source":{"text":"谢潉云：‘潘诗烂若舒锦，无处不佳。’","book":"南朝·梁·钟嵘《诗品》上卷"},"similar":["烂若披锦"],"usage":"作谓语；形容文辞华丽"},{"id":30382,"word":"烂醉如泥","pinyin":"làn zuì rú ní","abbr":"lzrn","explanation":"醉得瘫成一团，扶都扶不住。形容大醉的样子。","source":{"text":"《汉官仪》此下云：‘一日不斋醉如泥。’","book":"《后汉书·儒林传下·周泽》“一岁三百六十日，三百五十九日斋”唐·李贤注"},"example":{"text":"二人纵饮甚欢，相得恨晚，自辰以迄四漏，计各尽百壶。曾～，沉睡座间。","book":"清·蒲松龄《聊斋志异·黄英》"},"similar":["酩酊大醉"],"usage":"作谓语、状语；形容大醉的样子"},{"id":30383,"word":"烂额焦头","pinyin":"làn é jiāo tóu","abbr":"lejt","explanation":"形容十分狼狈窘迫的样子。","source":{"text":"进不量其浅薄，退遂致于烂额焦头。","book":"宋·李纲《谢移沣州居住表》"},"example":{"text":"人生皆作如是观，～称上客。","book":"清·洪亮吉《为史秀才次星赋焦尾砚》"},"similar":["焦头烂额"],"opposite":["称心如意"],"usage":"作谓语、状语；指窘迫的样子"},{"id":30384,"word":"烈士徇名","pinyin":"liè shì xùn míng","abbr":"lsxm","explanation":"忠贞义烈之士为保全名誉而献出生命。","source":{"text":"贪夫徇财，烈士徇名。","book":"《史记·伯夷列传》"},"example":{"text":"～，不受黄金之赏。","book":"唐·杨炯《唐上骑都尉高君神道碑》"},"usage":"作宾语、定语；指人重名声"},{"id":30385,"word":"烈士暮年，壮心不已","pinyin":"liè shì mù nián，zhuàng xīn bù yǐ","abbr":"lsmnzxby","explanation":"烈士：志向远大的英雄。已：停止，衰减。英雄到了晚年，壮志雄心并不衰减。","source":{"text":"老骥伏枥，志在千里，烈士暮年，壮心不已。","book":"三国·魏·曹操《步出夏门行·龟虽寿》"},"similar":["老骥伏枥，志在千里"],"usage":"作定语、宾语、分句；用于老年人","story":["东汉末年，曹操率军先后消灭董卓、黄巾军、吕布、袁术、袁绍、刘表等地方势力，控制北方领土。袁绍的儿子投奔北方的乌桓，53岁的曹操亲率大军彻底征服20万乌桓人，凯旋后作《步出夏门行》：“老骥伏枥，志在千里。烈士暮年，壮心不已。”"]},{"id":30386,"word":"烈女不嫁二夫","pinyin":"liè nǚ bù jià èr fū","abbr":"lnbjef","explanation":"烈女：刚正有节操的女子。贞烈的妇女不嫁第二个丈夫。","source":{"text":"便好道一马不背双鞍，双轮岂碾四辙，烈女不嫁二夫，我怎肯嫁侍于人。","book":"元·关汉卿《五侯宴》楔子"},"example":{"text":"～的观念应该改一改了。"},"similar":["烈女不更二夫"],"usage":"作宾语、定语；用于女性"},{"id":30387,"word":"烈女不更二夫","pinyin":"liè nǚ bù gēng èr fū","abbr":"lnbgef","explanation":"烈女：刚正有节操的女子。贞烈的妇女不嫁第二个丈夫。","source":{"text":"夫人怒欲悔亲，依旧要将莺莺与郑恒，焉有此理？道不得个‘烈女不更二夫’。","book":"元·王实甫《西厢记》第五本第四折"},"example":{"text":"清·褚人获《隋唐演义》第49回：“忠臣不事二君，～。”"},"similar":["烈女不嫁二夫"],"usage":"作宾语、定语；用于女性"},{"id":30388,"word":"烈火干柴","pinyin":"liè huǒ gān chái","abbr":"lhgc","explanation":"比喻男女欢情很深。","source":{"text":"怎当得他每两下烈火干柴，你贪我爱，各自有心，竟自勾搭上了。","book":"明·凌濛初《二刻拍案惊奇》第11卷"},"example":{"text":"真是一对～，如胶投漆，燕尔新婚，连日那里拆得开。","book":"清·曹雪芹《红楼梦》第69回"},"similar":["干柴烈火"],"usage":"作宾语；指男女关系"},{"id":30389,"word":"烈火烹油","pinyin":"liè huǒ pēng yóu","abbr":"lhpy","explanation":"形容气氛更加热烈。","source":{"text":"眼见不日又有一件非常的喜事，真是烈火烹油、鲜花着锦之盛。","book":"清·曹雪芹《红楼梦》第13回"},"example":{"text":"这下子可不得了啦！真好像～，会场一下子炸了——空前的大爆炸。","book":"《花城》1981年第4期"},"similar":["火上浇油"],"usage":"作宾语；形容气氛更加热烈"},{"id":30390,"word":"烈火烹油，鲜花着锦","pinyin":"liè huǒ pēng yóu，xiān huā zhuó jǐn","abbr":"lhpyxhzj","explanation":"烹：煮；着：附着。用炽烈的大火煮油脂，把鲜花附着在织锦止。比喻好上加好。也形容更加热闹，更有排场。","source":{"text":"眼见不日又有一件非常的喜事，真是烈火烹油，鲜花着锦之盛。","book":"清·曹雪芹《红楼梦》第十三回"}},{"id":30391,"word":"烈火真金","pinyin":"liè huǒ zhēn jīn","abbr":"lhzj","explanation":"烈火：熊熊大火，猛烈的火。真金不惧火炼，在烈火中可以鉴别出真正的黄金。","example":{"text":"疾风知劲草，烈火真金。"},"similar":["疾风知劲草","烈火见真金"],"usage":"作主语、谓语、宾语；用于对人的考验"},{"id":30392,"word":"烈火见真金","pinyin":"liè huǒ jiàn zhēn jīn","abbr":"lhjzj","explanation":"真金是不怕烈火烧的，所以只有在烈火中才能鉴别出是不是真金。比喻在关键时刻最能考验人。","example":{"text":"～，我们等着瞧吧。"},"similar":["真金不怕火炼"],"usage":"作宾语、分句；指关键时刻最能考验人"},{"id":30393,"word":"烈火轰雷","pinyin":"liè huǒ hōng léi","abbr":"lhhl","explanation":"炽烈的火，轰响的雷。比喻性情急躁暴烈。","source":{"text":"性子又烈火轰雷似的，煞是不好说话。","book":"清·文康《儿女英雄传》第14回"},"example":{"text":"他发怒就像～一样激烈。"},"usage":"作谓语、定语；形容性情暴躁，爱发脾气"},{"id":30394,"word":"烈火辨日","pinyin":"liè huǒ biàn rì","abbr":"lhbr","explanation":"在烈火中能辨别玉的好坏。比喻在关键时刻能看出一个人的节操。","source":{"text":"烈火辨玉，疾风知草。","book":"宋·叶廷圭《海录碎事·人事》"}},{"id":30395,"word":"烈火辨玉","pinyin":"liè huǒ biàn yù","abbr":"lhby","explanation":"在烈火中能辨别玉的好坏。比喻在关键时刻能看出一个人的节操。","source":{"text":"烈火辨玉，疾风知草。","book":"宋·叶廷琯《海录碎事·人事·志节》"}},{"id":30396,"word":"烈火金刚","pinyin":"liè huǒ jīn gāng","abbr":"lhjg","explanation":"形容人的意志坚强，经过严峻考验而不改变。"},{"id":30397,"word":"烈烈轰轰","pinyin":"liè liè hōng hōng","abbr":"llhh","explanation":"烈烈：火焰炽盛的样子；轰轰：象声词，形容巨大的声响。形容事业的兴旺。也形容声势浩大，气魄宏伟。","source":{"text":"人生欻翕云亡，好烈烈轰轰做一场。","book":"宋·文天祥《沁园春·至元间留燕山作》词"},"example":{"text":"大武汉的保卫战有时确实～过一阵。","book":"郭沫若《洪波曲》第12章"},"similar":["轰轰烈烈"],"opposite":["无声无息"],"usage":"作状语；同“轰轰烈烈”"},{"id":30398,"word":"烘云托月","pinyin":"hōng yún tuō yuè","abbr":"hyty","explanation":"烘：渲染；托：衬托。原指一种画月亮的传统手法。后比喻从侧面渲染以显示或突出主体。","source":{"text":"而先写张生者，所谓画家烘云托月之秘法。","book":"元·王实甫《西厢记》第一本第一折金圣叹批"},"example":{"text":"这位老画家善于用～的笔法描画山水。"},"similar":["渲染烘托"],"opposite":["开门见山","喧宾夺主"],"usage":"作谓语、定语、状语；用于文学艺术等方面"},{"id":30399,"word":"烘云讬月","pinyin":"hōng yún zhì yuè","abbr":"hyty","explanation":"比喻从侧面渲染以显示或突出主体。同“烘云托月”。"},{"id":30400,"word":"烘堂大笑","pinyin":"hōng táng dà xiào","abbr":"htdx","explanation":"形容满屋的人同时大笑。","source":{"text":"唐代御史有台院、殿院、察院之分，由台院一名年资最高者主杂事，谓之“杂端”；凡公堂会食，都不谈笑，如杂端先笑，则三院之人随之大笑，谓之“烘堂”。见唐赵璘《因话录·征》。"},"similar":["哄堂大笑"],"opposite":["鸦雀无声"],"usage":"作谓语、补语；指大家都笑","story":["五代时期，冯道与和凝同在中书办理事物。和凝见冯道穿新衣与新鞋，就问冯道的新鞋多少钱，冯道举左脚说才900文。和凝马上就训斥下人，说他买鞋贪污他900文，冯道马上举右脚说这也是900文，于是大家哄堂大笑起来"]},{"id":30401,"word":"烘托渲染","pinyin":"hōng tuō xuàn rǎn","abbr":"htxr","explanation":"用衬托和夸张的艺术手法，突出主题。","source":{"text":"自然还须加一番烘托渲染，才完得这一篇造因结果的文章。","book":"清·文康《儿女英雄传》第33回"},"example":{"text":"他写文章时经常采用～的手法。"},"similar":["渲染烘托"],"usage":"作谓语、定语；指衬托和夸张的艺术手法"},{"id":30402,"word":"烛尽光穷","pinyin":"zhú jìn guāng qióng","abbr":"zjgq","explanation":"蜡烛燃尽，烛光消失。比喻人死后意识也消灭。","source":{"text":"神之在人，犹光之在烛，烛尽则光穷，人死则神灭。","book":"《北史·杜弼传》"},"usage":"作宾语、定语；指人死亡"},{"id":30403,"word":"烛照数计","pinyin":"zhú zhào shù jì","abbr":"zzsj","explanation":"用烛照着，按数计算。比喻料事准确。","source":{"text":"若烛照数计而龟卜也。","book":"唐·韩愈《送石处士序》"},"usage":"作宾语、定语；用于料事"},{"id":30404,"word":"烜赫一时","pinyin":"xuǎn hè yī shí","abbr":"xhys","explanation":"烜赫：声势很盛。在一个时期内名声威势很盛。","source":{"text":"虽将相大臣，气势烜赫，上所尊宠……一有罪过，纠诘按治。","book":"宋·王安石《上杜学士书》"},"example":{"text":"然而，七百年前，它却的的确确曾经是欧亚大陆～的中心。","book":"秦牧《访蒙古古都遗迹》"},"similar":["盛极一时","名噪一时","昙花一现"],"opposite":["彪炳千古"],"usage":"作谓语、定语；指一时有名"},{"id":30405,"word":"烟不出火不进","pinyin":"yān bù chū huǒ bù jìn","abbr":"ybchbj","explanation":"形容人慢性子，不爱说话。","source":{"text":"孙七太太是个四十来岁，永远烟不出火不进的，不惹人注意的妇人。","book":"老舍《四世同堂》七九"},"example":{"text":"他这个人～的。"},"similar":["沉默寡言"],"usage":"作谓语、定语；形容人慢性子，用于口语"},{"id":30406,"word":"烟云供养","pinyin":"yān yún gòng yǎng","abbr":"yygy","explanation":"烟云：烟雾和云气。道家认为不吃食物，依靠吞食云雾可致长寿。","source":{"text":"黄大痴九十而貌如童颜，米友仁八十余神明不衰，无疾而逝，盖画中烟云供养也。","book":"明·陈继儒《妮古录》卷三"},"usage":"作宾语、定语；用于书面语"},{"id":30407,"word":"烟云过眼","pinyin":"yān yún guò yǎn","abbr":"yygy","explanation":"象烟云在眼前一晃而过。比喻事物很快就成为过去。也比喻身外之物，不必重视。","source":{"text":"见可喜者，虽时复蓄之，然为人取去，亦不复惜也。譬之烟云之过眼，百鸟之感耳，岂不欣然接之，然去而不复念也。","book":"宋·苏轼《宝绘堂记》"},"example":{"text":"余于器玩不甚留意，后为人取去，～矣。","book":"清·纪昀《阅微草堂笔记》卷十七"},"similar":["过眼烟云"],"usage":"作宾语；比喻事物很快就成为过去"},{"id":30408,"word":"烟尘斗乱","pinyin":"yān chén dǒu luàn","abbr":"ycdl","explanation":"形容烟雾和灰尘弥漫。","example":{"text":"但到傍晚，有一间的地板便常不免要咚咚咚地响得震天，兼以满房～。","book":"鲁迅《藤野先生》"}},{"id":30409,"word":"烟岚云岫","pinyin":"yān lán yún xiù","abbr":"ylyx","explanation":"岚：雾气；岫：峰峦。形容山峦之间云雾之气弥漫缭绕。","source":{"text":"烟岚云岫，洲渚林薄，更相映发，朝莫万态。","book":"宋·陆游《万卷楼记》"}},{"id":30410,"word":"烟幕弹","pinyin":"yān mù dàn","abbr":"ymd","explanation":"能发出带色浓烟的装置。比喻迷惑人的手段。","source":{"text":"日本外交家的漂亮词句，都不过是掩盖其战争准备的烟幕弹。","book":"毛泽东《和英国记者贝特兰的谈话》"},"example":{"text":"请收起你的～，我们不会被迷惑的"},"usage":"作主语、宾语、定语；用于处事"},{"id":30411,"word":"烟断火绝","pinyin":"yān duàn huǒ jué","abbr":"ydhj","explanation":"指人烟灭绝。","source":{"text":"烟断火绝，喻人之死也。","book":"《文选·江淹〈恨赋〉》：“若乃骑叠迹，车屯轨，黄尘匝地，歌吹四起，无不烟断火绝，闭骨泉里。”李善注"},"usage":"作谓语、定语；用于书面语"},{"id":30412,"word":"烟波万顷","pinyin":"yān bō wàn qǐng","abbr":"ybwq","explanation":"形容广阔的水面雾气弥漫，碧波荡漾的景色。","source":{"text":"泪眼送君倾似雨。不折垂杨，只倩愁随去。有底风光留不住，烟波万顷春江橹。","book":"宋·辛弃疾《蝶恋花》词"},"example":{"text":"三个走到水亭上，推窗一看，只见～，山光滴翠。","book":"清·陈忱《水浒后传》第二十八回"}},{"id":30413,"word":"烟波浩淼","pinyin":"yān bō hào miǎo","abbr":"ybhm","explanation":"烟波：雾霭苍茫的水面；浩淼：水面辽阔。形容烟雾笼罩的江湖水面广阔无边。","source":{"text":"烟波浩淼鱼鸟情，东去三千三百里。","book":"唐·刘禹锡《送鸿举游江西》"},"example":{"text":"～，孤舟一叶。海天空阔，月光如水。","book":"霍达《追日者》"}},{"id":30414,"word":"烟波浩渺","pinyin":"yān bō hào miǎo","abbr":"ybhm","explanation":"烟波：雾霭苍茫的水面；浩渺：水面辽阔。形容烟雾笼罩的江湖水面广阔无边。","source":{"text":"目极烟波浩渺间，晓鸟飞处认乡关。","book":"唐·崔致远《将归海东巉山春望》"},"example":{"text":"江面上～，一遍朦胧的景象。"},"similar":["波涛汹涌","白浪连天","烟雾弥漫"],"opposite":["风平浪静"],"usage":"作谓语、定语；形容水面广阔无边"},{"id":30415,"word":"烟波钓徒","pinyin":"yān bō diào tú","abbr":"ybdt","explanation":"烟波：水波渺茫，看远处有如烟雾笼罩；钓：钓鱼。旧指隐逸于渔的人。","source":{"text":"以亲既丧，不复仕，居江湖，自称烟波钓徒。","book":"《新唐书·张志和传》"},"example":{"text":"笠檐蓑袂平生事，臣本烟波一钓徒。”（清·梁绍壬《两般秋雨庵随笔》卷四","book":"查初白先生末句云"},"usage":"作主语、宾语、定语；指隐士"},{"id":30416,"word":"烟消云散","pinyin":"yān xiāo yún sàn","abbr":"yxys","explanation":"象烟云消散一样。比喻事物消失得干干净净。","source":{"text":"使一日之间，云消雾散，尧天舜日，廓然清明。","book":"《朱子全书·治道二·祯异》"},"example":{"text":"他的兴致被突然传来的坏消息吹得～。"},"similar":["烟消火灭","销声匿迹","云消雾散"],"opposite":["烟雾弥漫"],"usage":"作谓语、定语、状语；用于事物或情绪"},{"id":30417,"word":"烟消火灭","pinyin":"yān xiāo huǒ miè","abbr":"yxhm","explanation":"烟云消散，火光熄灭。比喻事物消灭干净。","source":{"text":"忽然长逝，烟消火灭。","book":"晋·傅玄《四言诗》"},"example":{"text":"若是这位武弁老爷，当时认个不是，赔个笑脸，这件事儿也就～的了。","book":"清·张春帆《宦海》第十七回"},"similar":["灰飞烟灭","烟消云散"],"usage":"作谓语、定语；比喻事物消灭干净"},{"id":30418,"word":"烟消雾散","pinyin":"yān xiāo wù sàn","abbr":"yxws","explanation":"比喻事物消失得干干净净。同“烟消云散”。","source":{"text":"我很疲倦，但是我觉得畅快。在流了这么多的眼泪以后，这许多日子来的阴郁的思想都烟消雾散了。","book":"巴金《海的梦》后篇一"},"similar":["烟消云散"],"usage":"作谓语、定语、状语；用于事物或情绪"},{"id":30419,"word":"烟火之警","pinyin":"yān huǒ zhī jǐng","abbr":"yhzj","explanation":"烟火：烽火。边界发一战事，用点燃烽火的办法报警。","source":{"text":"初，北边自宣帝以来，数世不见烟火之警，人民炽盛，牛马布野。","book":"《汉书·匈奴传下》"},"usage":"作宾语；用于书面语"},{"id":30420,"word":"烟火邻居","pinyin":"yān huǒ lín jū","abbr":"yhlj","explanation":"烟火都能相接的邻居。指紧邻。","example":{"text":"湖南湖北是～，更要加强经济合作。"},"usage":"作主语、宾语、定语；指紧邻"},{"id":30421,"word":"烟炎张天","pinyin":"yān yán zhāng tiān","abbr":"yyzt","explanation":"烟火遮满天空。炎：同焰。"},{"id":30422,"word":"烟熏火燎","pinyin":"yān xūn huǒ liǎo","abbr":"yxhl","explanation":"烟和火熏烤，比喻酷热或干燥。","example":{"text":"我感到嗓子～的难受。"},"usage":"作定语、状语；指酷热或干燥的环境"},{"id":30423,"word":"烟聚波属","pinyin":"yān jù bō shǔ","abbr":"yjbs","explanation":"如烟之相聚，波之相接。比喻接连而来，聚集甚多。","source":{"text":"朝士无赖者，亦竞相谄媚，或送婢妾，或进子女，筐筐苞苴，烟聚波属。","book":"隋·卢思道《北齐兴亡论》"},"usage":"作宾语、定语；用于书面语"},{"id":30424,"word":"烟花贱质","pinyin":"yān huā jiàn zhì","abbr":"yhjz","explanation":"旧指妓女。","source":{"text":"若不嫌我烟花贱质，情愿举案齐眉，白头奉侍。","book":"明·冯梦龙《醒世恒言》卷三"},"example":{"text":"妾虽～，零落残姿，虽不敢自荐枕席，若得亲傍江相公丰肤，道得个蒹葭倚玉，则贱妾死且不朽。","book":"清·吴中佩蘅子《吴江雪》十二回"}},{"id":30425,"word":"烟花风月","pinyin":"yān huā fēng yuè","abbr":"yhfy","explanation":"指男女情爱之事。","source":{"text":"烟花妙部，风月名班，生长旧院之中。","book":"清·孔尚任《桃花扇·传歌》"},"example":{"text":"咳！弘光啊！都是些～了你也。","book":"吴梅《风洞山·游湖》"},"usage":"作宾语、定语；指风月场"},{"id":30426,"word":"烟菲露结","pinyin":"yān fēi lù jié","abbr":"yflj","explanation":"菲：飘扬。烟雾飘飞露水凝集的样子。比喻书法","source":{"text":"观其点曳之工，裁成之妙，烟菲露结，状若断而还连，凤翥龙蟠，势如斜而反直。","book":"《晋书·王羲之传论》"},"usage":"作宾语、定语；用于书面语"},{"id":30427,"word":"烟蓑雨笠","pinyin":"yān suō yǔ lì","abbr":"ysyl","explanation":"①指蓑衣斗笠两种雨具。②借指隐者的服装或隐者优游自适的生活。","source":{"text":"烟蓑雨笠长林下，老去而今空见画。","book":"宋·苏轼《书晁说之〈考牧图〉后》诗"},"example":{"text":"扫空紫陌红尘梦，收得～身。","book":"宋·陆游《溪上小雨》诗"},"usage":"作宾语、定语；用于书面语"},{"id":30428,"word":"烟视媚行","pinyin":"yān shì mèi xíng","abbr":"ysmx","explanation":"烟视：微视；媚行：慢行。形容害羞不自然的样子。","source":{"text":"人有新取妇者，妇至，宜安矜，烟视媚行。","book":"《吕氏春秋·不屈》"},"usage":"作谓语、定语；形容旧时的新媳妇"},{"id":30429,"word":"烟销灰灭","pinyin":"yān xiāo huī miè","abbr":"yxhm","explanation":"比喻事物消失，不见踪迹。","source":{"text":"向日二十余年间所见富贵权势之人，一时煊赫如火烈烈者，迨遭丧乱，皆烟销灰灭无余。","book":"元·刘祁《〈归潜志〉序》"},"similar":["烟消云散"],"usage":"作谓语、状语；用于比喻句"},{"id":30430,"word":"烟雾尘天","pinyin":"yān wù chén tiān","abbr":"ywct","explanation":"形容秩序或场面乌烟瘴气，乱七八糟。","example":{"text":"这儿被他们搞得～。"},"similar":["乌烟瘴气","乱七八糟"],"usage":"作宾语、定语、状语；用于口语"},{"id":30431,"word":"烟雾腾天","pinyin":"yān wù téng tiān","abbr":"ywtt","explanation":"像浓烟雾气向上升腾翻滚一样。形容闹腾得十分凶。","source":{"text":"平生绝无嗜好，惟有敬信鬼神，是他独一无二的事，家里头供的甚么齐天大圣、观音菩萨，乱七八糟的，闹了个烟雾腾天。","book":"清·吴趼人《二十年目睹之怪现状》第七十七回"},"example":{"text":"一个捶背，一个揉胸，又有一个拿饭汤，又有一个倒开水，闹得七手八脚，～。","book":"清·李宝嘉《官场现形记》第三十六回"}},{"id":30432,"word":"烟霏雨散","pinyin":"yān fēi yǔ sàn","abbr":"yfys","explanation":"形容众多。","source":{"text":"烟霏雨散，众多也。","book":"《文选·刘孝标〈广绝交论〉》：“络绎纵横，烟霏雨散。”李善注"},"usage":"作宾语、定语；用于书面语"},{"id":30433,"word":"烟霏雾集","pinyin":"yān fēi wù jí","abbr":"yfwj","explanation":"形容众多。","source":{"text":"嘉祥累仍，福应尤盛……烟霏雾集，不可胜纪。","book":"南朝·宋·鲍照《河清颂》序"},"example":{"text":"每当命酒延宾，张灯召客，～，纸醉金迷。","book":"清·吴锡麒《袁简斋前辈八十寿序》"},"usage":"作谓语、定语；用于书面语"},{"id":30434,"word":"烟霏露结","pinyin":"yān fēi lù jié","abbr":"yflj","explanation":"烟雾迷蒙集结的样子。","source":{"text":"观其点曳之工，裁成之妙，烟霏露结，状若灿而还连，凤翥龙蟠，势如斜而反直。","book":"《晋书·王羲之传》"}},{"id":30435,"word":"烟霞成癖","pinyin":"yān xiá chéng pǐ","abbr":"yxcp","explanation":"有游山玩水的癖好。","example":{"text":"他已经～，准备成为一个旅行家。"},"usage":"作谓语、定语；用于人的嗜好等"},{"id":30436,"word":"烟霞沉痼","pinyin":"yān xiá chén gù","abbr":"yxcg","explanation":"烟霞：指山水；痼：久治不愈的病，比喻积久成习，不易改变的嗜好、习惯。指爱好山水成癖。","source":{"text":"臣所谓泉石膏肓，烟霞痼疾，既逢圣代，幸得逍遥。","book":"《旧唐书·田游岩传》"},"example":{"text":"～不须医，此去真同汗漫期。","book":"宋·范成大《初入大峨》"}},{"id":30437,"word":"烟霞痼疾","pinyin":"yān xiá gù jì","abbr":"yxgj","explanation":"烟霞：指山水；痼疾：久治不愈的病，比喻积久成习，不易改变的嗜好、习惯。指爱好山水成癖。","source":{"text":"臣所谓泉石膏肓，烟霞痼疾者。","book":"《新唐书·田游岩传》"},"usage":"作宾语、定语；指爱好山水成癖"},{"id":30438,"word":"烟霞蜩疾","pinyin":"yān xiá tiáo jí","abbr":"yxtj","explanation":"烟霞：指山水；蜩疾：久治不愈的病，比喻积久成习，不易改变的嗜好、习惯。指爱好山水成癖。","source":{"text":"臣所谓泉石膏肓，烟霞痼疾，既逢圣代，幸得逍遥。","book":"《旧唐书·田游岩传》"}},{"id":30439,"word":"烟飞星散","pinyin":"yān fēi xīng sàn","abbr":"yfxs","explanation":"形容离散。","source":{"text":"有一等做举人、秀才的，呼朋引类，把持官府，起灭词讼，每有将良善人家拆得烟飞星散的，难道不是大盗？","book":"《初刻拍案惊奇》卷八"},"usage":"作宾语、状语；用于比喻句"},{"id":30440,"word":"烦天恼地","pinyin":"fán tiān nǎo dì","abbr":"ftnd","explanation":"对天地都有所烦恼。形容心情极其烦闷苦恼。","source":{"text":"哭哭啼啼，烦天恼地。","book":"元·关汉卿《窦娥冤》第一折"},"example":{"text":"怎不叫我痛哭悲哀，～，雨泪如梭。","book":"明·无名氏《薛苞认母》第三折"},"usage":"作谓语、定语；指人的心情"},{"id":30441,"word":"烦心倦目","pinyin":"fán xīn juàn mù","abbr":"fxjm","explanation":"烦恼的心情，倦怠的眼睛。形容颓丧的情绪。","source":{"text":"闲对着绿树青山，消遣我烦心倦目，潜入那水国渔乡，早跳出龙潭虎穴。","book":"元·王实甫《丽春堂》第三折"},"usage":"作宾语、定语、状语；用于人的情绪"},{"id":30442,"word":"烦文缛礼","pinyin":"fán wén rù lǐ","abbr":"fwrl","explanation":"繁琐而不必要的礼节。","source":{"text":"秦之所谓损益，亦见得周末许多烦文缛礼如此，故直要损其太过，益其欠处，只是损益得太甚。","book":"《朱子语类》卷二四"},"example":{"text":"～之疲其形，惕谗畏谴之斗其心。","book":"明·唐顺之《赠宜兴令冯少虚序》"},"similar":["繁文缛礼","繁文缛节"],"usage":"作主语、宾语、分句；比喻烦琐、多余"},{"id":30443,"word":"烦言碎语","pinyin":"fán yán suì yǔ","abbr":"fysy","explanation":"烦：多，繁剧；碎：琐碎。形容文词杂乱、琐碎。","source":{"text":"这些烦言碎语，不必细叼。","book":"清·西周生《醒世姻缘传》第65回"},"similar":["烦言碎辞"],"usage":"作主语、宾语、定语；用于说话或文章"},{"id":30444,"word":"烦言碎辞","pinyin":"fán yán suì yǔ","abbr":"fysc","explanation":"形容文词杂乱、琐碎。","source":{"text":"分文析字，烦言碎辞。","book":"《汉书·刘歆传》"},"example":{"text":"周相公说得话也甚多，写不了这些～，大约与寄姐说的相同。","book":"《醒世姻缘》第九十八回"},"similar":["烦言碎语"],"usage":"作宾语、定语；用于说话或文章"},{"id":30445,"word":"烧桂煮玉","pinyin":"shāo guì zhǔ yù","abbr":"sgzy","explanation":"形容物价昂贵，人民生活极其困难。","source":{"text":"楚国之食贵于玉，薪贵于桂。","book":"《战国策·楚策三》"}},{"id":30446,"word":"烧犀观火","pinyin":"shāo xī guān huǒ","abbr":"sxgh","explanation":"比喻洞察事物。"},{"id":30447,"word":"烧琴煮鹤","pinyin":"shāo qín zhǔ hè","abbr":"sqzh","explanation":"拿琴当柴烧，把鹤煮了吃。比喻糟蹋美好的事物。","source":{"text":"《西清诗话》云：‘《义山杂纂》，品目数十，盖以文滑稽者。其一曰杀风景，谓清泉濯足，花上晒褌，背山起楼，烧琴煮鹤，对花啜茶，松下喝道。’","book":"宋胡仔《苕溪渔隐丛话前集·西昆体》"},"example":{"text":"也须把温语相商，又何用～，躏玉蹂香。","book":"清李渔《凰求凤·酸报》"},"similar":["焚琴煮鹤","煮鹤烧琴"],"usage":"作谓语、宾语、定语；指糟蹋好东西"},{"id":30448,"word":"烧眉之急","pinyin":"shāo méi zhī jí","abbr":"smzj","explanation":"比喻非常迫切。","source":{"text":"既是天教我知了，正是度日如年，烧眉之急。我马也不要，从人也不带一个，连夜自赶回家。","book":"《水浒传》第三五回"},"example":{"text":"望乞员外借贷些须，以救～。","book":"明沈受先《三元记·博施》"},"similar":["燃眉之急"],"usage":"作主语、宾语；指十分紧迫"},{"id":30449,"word":"烧香礼拜","pinyin":"shāo xiāng lǐ bài","abbr":"sxlb","explanation":"敬奉神佛的一种仪式。","source":{"text":"王度疏断，汉人悉不听，诣寺烧香礼拜以遵典礼。","book":"《晋书·佛图澄传》"},"example":{"text":"获其金人，帝以为大神，列于甘泉宫。金人率长文余，不祭祀，但～而已。","book":"《魏书·释老志》"},"similar":["烧香拜佛"],"usage":"作谓语、定语、宾语；指拜佛"},{"id":30450,"word":"烧高香","pinyin":"shāo gāo xiāng","abbr":"sgx","explanation":"向神佛虔诚烧香，比喻真诚地向人致谢。","example":{"text":"你不给我添麻烦，我就～了。"},"usage":"作谓语、定语；用于口语"},{"id":30451,"word":"热中名利","pinyin":"rè zhōng míng lì","abbr":"rzml","explanation":"热中：急切盼望。急切企图获得个人名利。","example":{"text":"我一向不～。"},"similar":["争名逐利","沽名钓誉"],"usage":"作谓语、定语；指人"},{"id":30452,"word":"热可炙手","pinyin":"rè kě zhì shǒu","abbr":"rkzs","explanation":"火热可以灼手。比喻权势显赫。同“炙手可热”。","source":{"text":"安乐公主，上之季妹也。附会韦氏，热可炙手，道路惧焉。","book":"唐·郑棨《开天传信记》"},"similar":["炙手可热"],"usage":"作谓语、定语；指人的权势等"},{"id":30453,"word":"热地蚰蜒","pinyin":"rě dì yóu yán","abbr":"rdyy","explanation":"蚰蜒：与蜈蚣同类的动物，体略小，生活在阴湿的地方。比喻惶急不安。","source":{"text":"唬的我似没头鹅热地上蚰蜒。","book":"元·关汉卿《鲁斋郎》第一折"},"example":{"text":"他则管送春情不住相留恋，引的人意悬悬似～。","book":"元·武汉臣《玉壶春》第一折"}},{"id":30454,"word":"热心快肠","pinyin":"rè xīn kuài cháng","abbr":"rxkc","explanation":"形容热情直爽。","source":{"text":"也许因为是她热心快肠，群众有事爱找她拿主意，帮个忙。","book":"柯岩《奇异的书简·东方的明珠三》"},"usage":"作谓语、定语、宾语；用于为人"},{"id":30455,"word":"热心肠","pinyin":"rè xīn cháng","abbr":"rxc","explanation":"指对人热情、乐于替别人办事。","source":{"text":"就是我热心肠与韦相公说了，韦相公也没本事去问他一声，看他一眼。","book":"清·名教中人《好逑传》第一回"},"example":{"text":"她是一个典型的～。"},"opposite":["冷血动物"],"usage":"作宾语、定语；用于乐于助人的人"},{"id":30456,"word":"热心苦口","pinyin":"rè xīn kǔ kǒu","abbr":"rxkk","explanation":"形容热心恳切地再三劝告。"},{"id":30457,"word":"热情奔放","pinyin":"rè qíng bēn fàng","abbr":"rqbf","explanation":"充满热情的，充满活力、首创精神或应变能力的样子。","example":{"text":"采访记者都是些～的波希米亚人。"},"similar":["热情洋溢"],"usage":"作谓语、定语、状语；指人的状态"},{"id":30458,"word":"热情洋溢","pinyin":"rè qíng yáng yì","abbr":"rqyy","explanation":"热烈的感情充分地流露出来。","source":{"text":"对全世界来说，这些热情洋溢的报导，正是拨云雾而见青天啊！","book":"曹靖华《罗汉岭前吊秋白》"},"example":{"text":"她那～的仪态一直萦绕在我眼前。"},"similar":["满腔热忱"],"opposite":["阴阳怪气","冷言冷语"],"usage":"作宾语、定语、状语；指人的感情"},{"id":30459,"word":"热气腾腾","pinyin":"rè qì téng téng","abbr":"rqtt","explanation":"热气蒸腾的样子。形容气氛热烈或情绪高涨。","source":{"text":"只见小和用一个小托盘托了几碗盖碗茶，热气腾腾的端过来。","book":"清·李宝嘉《中国现在记》第十一回"},"example":{"text":"中国是处在大革命中，全中国～。","book":"毛泽东《丢掉幻想，准备斗争》"},"similar":["蒸蒸日上","热火朝天"],"opposite":["死气沉沉","万马齐喑"],"usage":"作谓语、宾语、定语；指人的情绪等"},{"id":30460,"word":"热汗涔涔","pinyin":"rè hàn cén cén","abbr":"rhcc","explanation":"形容因天气炎热或心情紧张而导致浑身汗流如注的样子。","example":{"text":"轿夫们气喘吁吁，～。","book":"莫言《红高粱》"}},{"id":30461,"word":"热泪盈眶","pinyin":"rè lèi yíng kuàng","abbr":"rlyk","explanation":"盈：充满；眶：眼眶。因感情激动而使眼泪充满了眼眶，形容感动至极或非常悲伤。","source":{"text":"崇祯继续向祖宗祷告，满怀凄怆，热泪盈眶，几乎忍不住要在祖宗前痛哭一场。","book":"姚雪垠《李自成》"},"example":{"text":"他激动得～。"},"similar":["热泪纵横","声泪俱下","百感交集"],"opposite":["眉开眼笑","笑容可掬","无动于衷"],"usage":"作谓语、定语、状语；形容人受感动"},{"id":30462,"word":"热火朝天","pinyin":"rè huǒ cháo tiān","abbr":"rhct","explanation":"形容群众性的活动情绪热烈，气氛高涨，就象炽热的火焰照天燃烧一样。","source":{"text":"从祖国到朝鲜，我看见一面是热火朝天的建设，一面是在炮火连天中奋不顾身的战斗。","book":"魏巍《谁是最可爱的人·前进吧祖国》"},"example":{"text":"学校里已经闹得～了。","book":"罗广斌《红岩》第一章"},"similar":["热气腾腾","万马奔腾"],"opposite":["死气沉沉"],"usage":"作定语、状语；指人的干劲或情绪"},{"id":30463,"word":"热炒热卖","pinyin":"rè chǎo rè mài","abbr":"rcrm","explanation":"比喻用刚刚学到的东西去教人。","example":{"text":"我的基础不行，每天上课都是～。"},"similar":["现炒现卖"],"usage":"作谓语、宾语；同“现炒现卖”"},{"id":30464,"word":"热热乎乎","pinyin":"rè rè hū hū","abbr":"rrhh","explanation":"指事物温温热热或人待人亲切热诚、有同情心的或充满深情的状貌。","source":{"text":"秀莲在烧炕的时候，就煮一些南瓜汤，两个人在睡觉前热热乎乎喝一碗。","book":"路遥《平凡的世界》第二卷第41章"},"example":{"text":"听了她的劝告，我心里～的。"},"usage":"作定语、状语；用于口语"},{"id":30465,"word":"热热闹闹","pinyin":"rè rè nào nào","abbr":"rrnn","explanation":"景象纷繁盛大，气氛活跃。","source":{"text":"后儿宝丫头的生日，我替另拿出银子来，热热闹闹给他做个生日，也叫他喜欢这一天。","book":"清·曹雪芹《红楼梦》第108回"},"example":{"text":"但是我们的群众路线，不是满足于那个～，主要的是要做经常的、细致的工作，做人的工作。","book":"邓小平《提倡深入细致的工作》"},"similar":["热火朝天"],"opposite":["冷冷清清"],"usage":"作定语、状语；用于场面"},{"id":30466,"word":"热熬翻饼","pinyin":"rě áo fān bǐng","abbr":"rafb","explanation":"比喻事情极容易做到。","source":{"text":"取幽蓟如热熬翻饼尔。","book":"《唐宋遗史》"},"example":{"text":"君不见，干柴入烟谶终脸，～语竟空。","book":"清·赵翼《瓯北诗钞·七言古一》"},"usage":"作宾语、定语；用于比喻句"},{"id":30467,"word":"热肠冷面","pinyin":"rè cháng lěng miàn","abbr":"rclm","explanation":"热心肠，冷面孔。形容内心热情，表情却冷漠。","example":{"text":"他是一个～的人。"},"usage":"作谓语、定语；指人"},{"id":30468,"word":"热肠古道","pinyin":"rè cháng gǔ dào","abbr":"rcgd","explanation":"热肠：热心肠；古道：上古时代的风俗习惯，形容厚道。指待人真诚、热情。","source":{"text":"老哥热肠古道，我们是一向钦佩的。","book":"清·吴趼人《糊涂世界》"},"similar":["古道热肠"],"usage":"作谓语、定语；比喻热心肠的人"},{"id":30469,"word":"热血沸腾","pinyin":"rè xuè fèi téng","abbr":"rxft","explanation":"比喻激情高涨。","source":{"text":"她是怎样地受感动，怎样地热血沸腾。","book":"茅盾《子夜》九"},"example":{"text":"游行的人们个个都是～。"},"similar":["心潮澎湃","满腔热情"],"opposite":["平心静气"],"usage":"作谓语、宾语、定语；指人的情绪"},{"id":30470,"word":"热锅上的蚂蚁","pinyin":"rè guō shàng de mǎ yǐ","abbr":"rgsdmy","explanation":"形容心里烦躁、焦急，坐立不安的样子。","source":{"text":"溜进容府，往那夹道中屋子里来等着，热锅上蚂蚁一般。","book":"清·曹雪芹《红楼梦》第十二回"},"example":{"text":"把个赵氏在屏风后急的象～，见众人都不说话，自己隔着屏风请教大爷，数说这些从前已往的话。","book":"清·吴敬梓《儒林外史》第六回"}},{"id":30471,"word":"热锅上蚂蚁","pinyin":"rè guō shàng mǎ yǐ","abbr":"rgsmy","explanation":"比喻处境艰困、惶急不安的人。","source":{"text":"一霎时犹如热锅上蚂蚁一般，茶饭无心，坐立不定，好生难过，一直等到旁黑，跟班的又出去打听，不多一刻，只见垂头丧气而回。","book":"清·李宝嘉《官场现形记》第十一回"},"example":{"text":"女人们还在越在越聚越多，像～，有些跑回了家又跑了出去，在田原里跑着，喃喃着。","book":"丁玲《水》"},"similar":["心急如焚","坐立不安"],"usage":"作主语、宾语、定语；指人急躁等"},{"id":30472,"word":"热锅上蝼蚁","pinyin":"rè guō shàng lóu yǐ","abbr":"rgsly","explanation":"形容心里烦躁、焦急，坐立不安的样子。同“热锅上蚂蚁”。","source":{"text":"这壁厢太子与杨素，是热锅上蝼蚁，盼不到一个消息。","book":"《隋唐演义》第十九回"},"similar":["热锅上蚂蚁"],"usage":"作主语、宾语、定语；指人急躁等"},{"id":30473,"word":"热锅炒菜","pinyin":"rè guō chǎo cài","abbr":"rgcc","explanation":"比喻利用现成的条件办事。","example":{"text":"你这是将就～，太方便了。"},"similar":["趁热打铁"],"usage":"作谓语、宾语；指趁热打铁"},{"id":30474,"word":"热门货","pinyin":"rè mén huò","abbr":"rmh","explanation":"指好销的货。","example":{"text":"卫生防护用品成为现在的～。"},"usage":"作主语、宾语；指好销的货"},{"id":30475,"word":"烹犬藏弓","pinyin":"pēng quǎn cáng gōng","abbr":"pqcg","explanation":"犹烹狗藏弓。比喻事成之后把效劳出力的人抛弃以至杀害。","source":{"text":"狡兔死，良狗烹；高鸟尽，良弓藏；敌国破，谋臣亡。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"岂不劬劳，实兴师旅。～，同归异绪。","book":"《南齐书·垣崇祖张敬儿传赞》"},"similar":["烹狗藏弓"],"usage":"作宾语、定语；用于事后"},{"id":30476,"word":"烹狗藏弓","pinyin":"pēng gǒu cáng gōng","abbr":"pgcg","explanation":"比喻事成之后把效劳出力的人抛弃以至杀害。","source":{"text":"范蠡遂去，自齐遗大夫种（文种）书曰：‘蜚鸟尽，良弓藏，狡兔死，走狗烹。’","book":"语出《史记·越王勾践世家》"},"example":{"text":"～事可哀，看他海蜃结楼台。","book":"周咏《秋怀》诗之六"},"similar":["烹犬藏弓"],"usage":"作宾语、定语；用于事后"},{"id":30477,"word":"烹龙庖凤","pinyin":"pēng lóng páo fèng","abbr":"plpf","explanation":"比喻烹调珍奇菜肴。亦形容菜肴豪奢珍贵。同“烹龙炮凤”。","source":{"text":"东坡以烹龙庖凤之手，而饮木兰之坠露，餐秋菊之落英者也。","book":"宋·杨万里《西溪先生和陶诗序》"},"similar":["烹龙炮凤","烹龙煮凤"],"usage":"作谓语、定语；用于菜肴或艺术作品"},{"id":30478,"word":"烹龙炮凤","pinyin":"pēng lóng páo fèng","abbr":"plpf","explanation":"烹：煮；炮：烧。形容菜肴极为丰盛、珍奇。","source":{"text":"烹龙炮凤玉脂泣，罗屏绣幕围香风。","book":"唐·李贺《将进酒》诗"},"example":{"text":"座上若无油木梳，～总成虚。","book":"元·戴善夫《风光好》第一折"},"similar":["炮凤烹龙","烹龙炰凤","炙凤烹龙"],"usage":"作谓语、定语；用于菜肴或艺术作品"},{"id":30479,"word":"烹龙炰凤","pinyin":"pēng lóng páo fèng","abbr":"plpf","explanation":"烹：煮。形容菜肴极为丰盛、珍奇。比喻作家的艺术技巧高明。","source":{"text":"琉璃钟，琥珀浓，小槽酒滴真珠红。烹龙炮凤玉脂泣，罗帷绣幕围香风。","book":"唐·李贺《将进酒》诗"},"example":{"text":"～的宴席不能多吃。"},"similar":["烹龙炮凤","炮龙烹凤"],"usage":"作谓语、定语；用于菜肴或艺术作品"},{"id":30480,"word":"烹龙煮凤","pinyin":"pēng lóng zhǔ fèng","abbr":"plzf","explanation":"比喻烹调珍奇菜肴。亦形容菜肴豪奢珍贵。","source":{"text":"有《鹧鸪天》词为证：城中酒楼高入天，烹龙煮凤味肥鲜。公孙下马闻香醉，一饮不惜费万钱。","book":"明·冯梦龙《喻世明言》第十一卷"},"similar":["烹龙炮凤","烹龙庖凤"],"usage":"作谓语、定语；用于菜肴或艺术作品"},{"id":30481,"word":"烹龙砲凤","pinyin":"pēng lóng pào fèng","abbr":"plpf","explanation":"①比喻烹调珍奇肴馔。亦形容菜肴豪奢珍贵。②比喻高超的艺术技艺。亦作“烹龙庖凤”。亦作“烹龙煮凤”。"},{"id":30482,"word":"烽火四起","pinyin":"fēng huǒ sì qǐ","abbr":"fhsq","explanation":"战争的火焰从四面八方燃烧起来。形容边防不安宁，四处有敌人进犯。","example":{"text":"在这～的年代，我们最需要的就是和平安宁的环境。"},"similar":["狼烟四起"],"opposite":["国泰民安"],"usage":"作谓语、定语、宾语；形容战争动乱"},{"id":30483,"word":"烽火相连","pinyin":"fēng huǒ xiāng lián","abbr":"fhxl","explanation":"烽火：古代边防报警的烟火。指边防常抓不懈，比喻战火不断。","source":{"text":"部曲相保，堑垒木樵，便兵饰弩，烽火相连。","book":"汉·荀悦《汉纪·宣帝纪三》"},"example":{"text":"临歧分别，一旦恩情成断裂；～，雁帖鱼书谁与传。","book":"元·无名氏《风送梧桐叶》第一折"},"similar":["烽鼓不息"],"usage":"作谓语、定语；指战乱不休"},{"id":30484,"word":"烽火连天","pinyin":"fēng huǒ lián tiān","abbr":"fhlt","explanation":"形容战火遍及各地。","source":{"text":"其时鲜卑连犯云中五原，一月之中烽火不绝，埃尘连天。","book":"汉·蔡邕《蔡中郎集·外纪上·汉书十志疏》"},"example":{"text":"倾城将士，两两相遇，虽然是件韵事，倘使相遇在～之下，便不欢乐了。","book":"清·曾朴《孽海花》第三十二回"},"similar":["狼烟四起","炮火连天"],"opposite":["歌舞升平","国泰民安"],"usage":"作谓语、定语、分句；形容战争"},{"id":30485,"word":"烽火连年","pinyin":"fēng huò lián nián","abbr":"fhln","explanation":"烽火：古时边防报警的烟火。比喻战火或战争。指战火连年不断。","source":{"text":"那堪回首东南地，烽火连年警报闻。","book":"元·戴良《九灵山房集·二四·登大牢山》"},"usage":"作谓语、宾语、定语；用于战争等"},{"id":30486,"word":"烽鼓不息","pinyin":"fēng gǔ bù xī","abbr":"fgbx","explanation":"烽鼓：烽火与战鼓；息：停止。比喻战乱不止。","source":{"text":"晋宋迄今，有切民患；烽鼓相望，岁时不息。","book":"南朝·梁·沈约《齐故安陆昭王碑》"},"similar":["烽火连年"],"usage":"作谓语、宾语；指战乱不止"},{"id":30487,"word":"焕然一新","pinyin":"huàn rán yī xīn","abbr":"hryx","explanation":"焕然：鲜明光亮的样子。改变旧面貌，出现崭新的气象。","source":{"text":"其有晋宋名迹，焕然如新，已历数百年，纸素彩色未甚败。","book":"唐·张彦远《历代名画记·论鉴识收藏购求阅玩》"},"example":{"text":"依中国法度，造作旗帜大纛，～。","book":"清·陈忱《水浒后传》第十一回"},"similar":["耳目一新","焕然如新"],"opposite":["依然如故"],"usage":"作谓语、宾语；指面貌改观"},{"id":30488,"word":"焕然冰释","pinyin":"huàn rán bīng shì","abbr":"hrbs","explanation":"焕然：流散的样子；释：消散、解除。指像冰遇热消融一般。多比喻疑虑、误会、隔阂等很快消除。","source":{"text":"复取《授时历草》观之，乃焕然冰释，骀名异而实同，非徒似之而已。","book":"《清史稿·梅文鼎传》"},"similar":["涣然冰释"],"usage":"作谓语、宾语；比喻相互间的嫌隙等消除"},{"id":30489,"word":"焕然如新","pinyin":"huàn rán rú xīn","abbr":"hrrx","explanation":"改变旧面貌，出现崭新的气象。同“焕然一新”。","source":{"text":"其有晋宋名迹，焕然如新，已历数百年，纸素彩色未甚败。","book":"唐·张彦远《历代名画记·论鉴识收藏购求阅玩》"},"similar":["焕然一新"],"usage":"作谓语、宾语；指面貌改观"},{"id":30490,"word":"焚书坑儒","pinyin":"fén shū kēng rú","abbr":"fskr","explanation":"焚：烧；坑：把人活埋；儒：指书生。焚毁典籍，坑杀书生。","source":{"text":"及秦始皇灭先代典籍，焚书坑儒，天下学士逃难解散。","book":"汉·孔安国《〈尚书〉序》"},"example":{"text":"满清入主中原，～多少次，杀了民族思想的人。","book":"梁斌《红旗谱》四二"},"similar":["焚典坑儒"],"usage":"作主语、谓语、定语、宾语；指文化专制","story":["秦始皇34年，秦始皇采用丞相李斯的意见，把上书分封的淳于越看成私家学诽谤朝政，下令将《秦纪》以外的史书全部上交焚毁，书生卢生等人不满，结果秦始皇下令逮捕了460多名方士和儒生，在咸阳挖坑活埋他们"]},{"id":30491,"word":"焚典坑儒","pinyin":"fén diǎn kēng rú","abbr":"fdkr","explanation":"焚毁典籍，坑杀书生。同“焚书坑儒”。","source":{"text":"秦皇独霸诸侯城，焚典坑儒丧圣文。","book":"《明成化说唱词话丛刊·花关索出身传》"},"similar":["焚书坑儒"],"usage":"作谓语、定语、宾语；指文化专制"},{"id":30492,"word":"焚如之祸","pinyin":"fén rú zhī huò","abbr":"frzh","explanation":"遭受火烧的灾祸。","source":{"text":"人神弗祐，而非罪师丹忠正之谏，用致丁、傅焚如之祸。","book":"《三国志·魏志·明帝纪》"},"example":{"text":"则东京～，关右乱麻之尸，何繇而兴哉。","book":"唐·王勃《三国论》"},"usage":"作宾语；指火灾"},{"id":30493,"word":"焚尸扬灰","pinyin":"fén shī yáng huī","abbr":"fsyh","explanation":"烧掉尸骨，扬弃骨灰。形容非常仇视。","source":{"text":"曝尸于建康市，百姓争取屠脍啖食，焚骨扬灰。","book":"《梁书·侯景传》"},"example":{"text":"籍没其家，妻子同谋，法皆斩首，其母恨礼甚，又诣刑部请照陶和气例，凌迟后～。","book":"清·钱泳《履园丛话·烧坯》"},"similar":["焚骨扬灰"],"usage":"作谓语、宾语；形容非常仇视"},{"id":30494,"word":"焚巢捣穴","pinyin":"fén cháo dǎo xué","abbr":"fcdx","explanation":"比喻彻底摧毁。","source":{"text":"用了第二计，可以焚巢捣穴，削草除根，不留一个余贼。","book":"清·李渔《比目鱼·办贼》"},"similar":["焚巢荡穴"],"usage":"作谓语；指彻底摧毁"},{"id":30495,"word":"焚巢荡穴","pinyin":"fén cháo dàng xué","abbr":"fcdx","explanation":"比喻彻底摧毁。","source":{"text":"各处劲兵前来，焚巢荡穴，不留一人，乃已。","book":"明·唐顺之《牌》"},"similar":["焚巢捣穴"],"usage":"作谓语；指彻底摧毁"},{"id":30496,"word":"焚林之求","pinyin":"fén lín zhī qiú","abbr":"flzq","explanation":"由于隐居在山林，故烧毁森林使他出来。比喻为求贤才而去毁林。","source":{"text":"既允焚林之求，实兼仪形之奇。","book":"南朝·梁·任昉《齐竟陵文宣王行状》"},"usage":"作宾语；用于求才"},{"id":30497,"word":"焚林竭泽","pinyin":"fén lín jié zé","abbr":"fljz","explanation":"焚林而田，竭泽而渔。比喻只图眼前利益。","source":{"text":"焚林而畋，明年无兽；竭泽而渔，明年无鱼。","book":"宋·秦观《李训论》"},"example":{"text":"窃恐～之后，能无鱼惊鸟散之忧？","book":"清·黄宗羲《明司马澹若张公传》"},"similar":["焚林而田；竭泽而渔"],"usage":"作谓语、定语；比喻只图眼前利益"},{"id":30498,"word":"焚林而狩","pinyin":"fén lín ér shòu","abbr":"fles","explanation":"比喻取之不留余地，只顾眼前利益，不顾长远利益。","source":{"text":"是由涸泽而渔，焚林而狩。","book":"南朝·宋·袁淑《防御索虏议》"},"similar":["焚林而田","焚林而畋","焚林而猎"],"usage":"作谓语、定语；比喻只图眼前利益"},{"id":30499,"word":"焚林而猎","pinyin":"fén lín ér liè","abbr":"flel","explanation":"焚烧树木林，猎取禽兽。比喻只图眼前利益，不作长久打算。","source":{"text":"故先王之法……不涸泽而渔，不焚林而猎。","book":"《韩非子·难一》：“焚林而田，偷取多兽，后必无兽。”《淮南子·主术训》"},"similar":["涸池而渔","焚林而田"],"usage":"作谓语、定语；比喻只图眼前利益"},{"id":30500,"word":"焚林而田","pinyin":"fén lín ér tián","abbr":"flet","explanation":"烧毁树林以猎取野兽。比喻取之不留余地，只顾眼前利益，不顾长远利益。","source":{"text":"焚林而田，偷取多兽；以诈遇民，偷取一时，后必无复。","book":"《韩非子·难一》"},"example":{"text":"钻燧取火，构木为台，～，竭泽而渔。","book":"《淮南子·本经训》"},"similar":["焚林而畋","焚林而猎","焚林而狩"],"usage":"作谓语、定语；比喻只图眼前利益"},{"id":30501,"word":"焚林而田，竭泽而渔","pinyin":"fén lín ér tián，jié zé ér yú","abbr":"fletjzey","explanation":"竭：使……干涸；渔：打鱼。烧毁森林捕捉野兽，排干湖水去捕捉鱼。比喻只顾眼前的利益，无止境地索取而不留余地。","source":{"text":"钻燧取火，构木为台，焚林而田，竭泽而渔。","book":"汉·刘安《淮南子·本经训》"},"usage":"作宾语、分句；可分开使用"},{"id":30502,"word":"焚林而畋","pinyin":"fén lín ér tián","abbr":"flet","explanation":"比喻取之不留余地，只顾眼前利益，不顾长远利益。","source":{"text":"焚林而畋，明年无兽；竭泽而鱼，明年无鱼。","book":"宋·秦观《李训论》"},"similar":["焚林而田","焚林而狩"],"usage":"作谓语、定语；比喻只图眼前利益"},{"id":30503,"word":"焚枯食淡","pinyin":"fén kū shí dàn","abbr":"fksd","explanation":"烤干鱼，食薄味。形容生活清苦。","source":{"text":"焚枯食淡，斋厨萧然。","book":"清·钱谦益《和州鲁氏先茔神道碑铭》"},"usage":"作谓语、定语；用于生活"},{"id":30504,"word":"焚琴煮鹤","pinyin":"fén qín zhǔ hè","abbr":"fqzh","explanation":"把琴当柴烧，把鹤煮了吃。比喻糟蹋美好的事物。","source":{"text":"义山《杂纂》，品目数十，盖以文滑稽者。其一曰杀风景，谓清泉濯足，背山起楼，烧琴煮鹤。","book":"宋·胡仔《苕溪渔隐丛前集》引《西清诗话》"},"example":{"text":"～从来有，惜玉怜香几个知。","book":"明·冯梦龙《醒世恒言》卷三"},"similar":["烧琴煮鹤","焚琴鬻鹤"],"usage":"作谓语、定语、宾语；比喻糟蹋美好的事物"},{"id":30505,"word":"焚琴鬻鹤","pinyin":"fén qín yù hè","abbr":"fqyh","explanation":"犹焚琴煮鹤。比喻糟蹋美好的事物。","source":{"text":"焚琴鬻鹤，伧父所为，不图出之改之。","book":"况周颐《蕙风词话》卷二"},"similar":["焚琴煮鹤"],"usage":"作谓语、定语、宾语；比喻糟蹋美好的事物"},{"id":30506,"word":"焚符破玺","pinyin":"fén fú pò xǐ","abbr":"ffpx","explanation":"烧毁信符，打碎印章。"},{"id":30507,"word":"焚膏继晷","pinyin":"fén gāo jì guǐ","abbr":"fgjg","explanation":"膏：油脂，指灯烛；继：继续，接替；晷：日光。点上油灯，接续日光。形容勤奋地工作或读书。","source":{"text":"焚膏油以继晷，恒兀兀以穷年。","book":"唐·韩愈《进学解》"},"example":{"text":"相传文人目多眚，归咎读书，～，以致损明。","book":"清·张潮《虞初新志·三侬赘人广自序》"},"similar":["夜以继日","通宵达旦"],"opposite":["饱食终日","无所事事"],"usage":"作谓语、状语、分句；指人勤奋"},{"id":30508,"word":"焚舟破釜","pinyin":"fén zhōu pò fǔ","abbr":"fzpf","explanation":"釜：古代用的锅。烧掉船只打破锅。比喻坚决不能动摇的决心。","source":{"text":"帅与之深入诸侯之地，而发其机，焚舟破釜。","book":"春秋·齐·孙武《孙子·九地》"},"example":{"text":"支军别统，或～，步自姑熟，或迅楫芜湖，入据云阳。","book":"南朝·宋·颜竣《为世祖檄京邑》"},"similar":["破釜沉舟","破釜焚舟"],"usage":"作谓语；同“破釜沉舟”"},{"id":30509,"word":"焚芝锄蕙","pinyin":"fén zhī chú huì","abbr":"fzch","explanation":"芝、蕙：古人视为瑞草。焚毁灵芝，锄掉蕙草。比喻贤者遭受灾祸。","source":{"text":"斯所由焚芝锄蕙，衔刀若卢者也。","book":"明·袁中道《李温陵传》"},"usage":"作宾语、定语；多用于比喻句"},{"id":30510,"word":"焚薮而田","pinyin":"fén sǒu ér tián","abbr":"fset","explanation":"薮，林薮。比喻取之不留余地，只顾眼前利益，不顾长远利益。","source":{"text":"焚薮而田，岂不获得，而明年无兽。","book":"《吕氏春秋·义赏》"},"similar":["焚林而田"],"usage":"作谓语、定语；比喻只图眼前利益"},{"id":30511,"word":"焚香列鼎","pinyin":"fén xiāng liè dǐng","abbr":"fxld","explanation":"焚：燃烧，点燃；列：排列。点起名贵的香，摆满很多的美味佳肴。形容生活阔气和讲究排场。","source":{"text":"焚香列鼎奉君王，馔玉炊金饱即妨。","book":"明·汤显祖《牡丹亭·劝农》"},"usage":"作定语、状语；用于生活"},{"id":30512,"word":"焚香扫地","pinyin":"fén xiāng sǎo dì","abbr":"fxsd","explanation":"形容清幽的隐居生活。","source":{"text":"韦应物立性高洁，鲜食寡欲，所居焚香扫地而坐。","book":"宋·王谠《唐语林·文学》"},"example":{"text":"河间先生典校秘书廿余年，学问文章名满天下……～，杜门著述而已。","book":"清·盛时彦《〈阅微草堂笔记〉跋》"},"usage":"作谓语、宾语、定语；用于隐居生活"},{"id":30513,"word":"焚香礼拜","pinyin":"fén xiāng lǐ bài","abbr":"fxlb","explanation":"焚香：点燃香火；礼拜：向尊敬的人或神灵行礼跪拜。烧香跪拜，以表尊敬服从之意。","source":{"text":"人生在世长安乐了那，焚香顶礼则个谢皇天呵。","book":"元·无名氏《玩江亭》第一折"},"example":{"text":"却说玄德前军……所到之处，秋毫无犯，百姓扶老携幼，满路瞻观，～。","book":"明·罗贯中《三国演义》第六十回"},"similar":["焚香膜拜"],"usage":"作谓语；表示尊敬服从"},{"id":30514,"word":"焚香膜拜","pinyin":"fén xiāng mó bài","abbr":"fxmb","explanation":"烧香跪拜，以表尊敬服从之意。同“焚香礼拜”。","source":{"text":"兆多疾，每疾作，孺人辄不食饮，焚香膜拜，以祈福祐。","book":"明·归有光《唐孺人墓志铭》"},"similar":["焚香礼拜"],"usage":"作谓语；表示尊敬服从"},{"id":30515,"word":"焚香顶礼","pinyin":"fén xiāng dǐng lǐ","abbr":"fxdl","explanation":"犹焚香礼拜。","source":{"text":"人生在世长安乐了那，焚香顶礼则个谢皇天呵，哙哙。","book":"元·无名氏《望江亭》第一折"},"example":{"text":"那杭州百姓，前番受过他的恩惠，今又听得他来，不胜欢喜，大家都打点～远接。","book":"《西湖佳话·六桥才迹》"},"usage":"作谓语、状语；用于虔诚"},{"id":30516,"word":"焚骨扬灰","pinyin":"fén gǔ yáng huī","abbr":"fgyh","explanation":"烧掉尸骨，扬弃骨灰。形容非常仇视。","source":{"text":"曝尸于建康市，百姓争取屠脍啖食，焚骨扬灰。","book":"《梁书·侯景传》"},"example":{"text":"肃宗克长安日，欲敕诸将发林甫冢，～。","book":"明·李东阳《腹中剑》"},"similar":["焚尸扬灰"],"usage":"作谓语、宾语；形容非常仇视"},{"id":30517,"word":"焦唇干肺","pinyin":"jiāo chún gān fèi","abbr":"jcgf","explanation":"指忧心如焚，肺为之枯干。","source":{"text":"三年苦身劳力，焦唇干肺，内亲群臣，下养百姓，以来其心。","book":"战国·卫·吕不韦《吕氏春秋·顺民》"},"usage":"作谓语、定语、状语；用于比喻句"},{"id":30518,"word":"焦唇干舌","pinyin":"jiāo chún gàn shé","abbr":"jcgs","explanation":"指忧心如焚，唇舌亦为之干枯。","source":{"text":"焦唇干舌，苦身劳力，上事君臣，下养百姓。","book":"汉·赵晔《吴越春秋·夫差内传》"},"example":{"text":"西汉·司马迁《史记·仲尼弟子列传》：“痛入于骨髓，日夜～，徒欲与吴王接踵而死。”"},"similar":["焦唇敝舌"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":30519,"word":"焦唇敝舌","pinyin":"jiāo chún bì shé","abbr":"jcbs","explanation":"指费尽口舌。","source":{"text":"我的爱护中华民国，焦唇敝舌，恐其衰微，大半正为了使我们得有剪辫的自由。","book":"鲁迅《且介亭杂文末编·因太炎先生而想起的二三事》"},"similar":["口干舌燥"],"usage":"作定语、状语；用于说话等"},{"id":30520,"word":"焦头烂额","pinyin":"jiāo tóu làn é","abbr":"jtle","explanation":"烧焦了头，灼伤了额。比喻非常狼狈窘迫。有时也形容忙得不知如何是好，带有夸张的意思。","source":{"text":"曲突徙薪亡恩泽，焦头烂额为上客耶？","book":"《汉书·霍光传》"},"example":{"text":"殡焰飞腾，众水手被火烧得～。","book":"清·李汝珍《镜花缘》第二十六回"},"similar":["头破血流","内外交困","狼狈不堪"],"opposite":["万事亨通","称心如意"],"usage":"作谓语、宾语、补语；比喻非常狼狈窘迫","story":["汉朝时期，汉宣帝重用霍光，不听徐福的限制霍光的劝谏。霍光的子孙图谋造反被宣帝镇压，宣帝奖赏那些有功人员，唯独不赏徐福。于是有人上书讲述曲突徙薪的故事，讲主人款待那些焦头烂额的救火人而忘记提出改正意见的人，宣帝立即重赏徐福"]},{"id":30521,"word":"焦心劳思","pinyin":"jiāo xīn láo sī","abbr":"jxls","explanation":"形容人非常操心、担忧。","source":{"text":"则庙堂之上，焦心劳思，废寝忘食以忧之。","book":"宋·司马光《进五规状·远谋》"},"example":{"text":"～，虽知情不容己，然亦无可如何。","book":"明·李贽《焚书·复邓鼎石》"},"usage":"作谓语、状语；形容心情忧急"},{"id":30522,"word":"焦心如焚","pinyin":"jiāo xīn rú fén","abbr":"jxrf","explanation":"焦：干燥到极点。费尽心思，万分忧虑。","example":{"text":"我被这事弄得～。"},"similar":["心急如焚"],"usage":"作谓语、定语、状语；用于书面语"},{"id":30523,"word":"焦心热中","pinyin":"jiāo xīn rè zhōng","abbr":"jxrz","explanation":"费尽心思，万分忧虑。"},{"id":30524,"word":"焦思苦虑","pinyin":"jiāo sī kǔ lǜ","abbr":"jskl","explanation":"着急忧虑，苦心思考。","source":{"text":"我这时的全部的注意力都集中在绥远的被侵略，每日所焦思苦虑的只是这个问题。","book":"邹韬奋《经历》"},"usage":"作谓语、状语；指苦想"},{"id":30525,"word":"焦沙烂石","pinyin":"jiāo shā shí làn","abbr":"jsls","explanation":"将沙烧焦，石烧烂。形容天气非常酷热。","source":{"text":"为寒则疑冰裂地，为热则焦沙烂石。","book":"汉·董仲舒《春秋繁露·循天之道》"},"similar":["燋金烁石"],"usage":"作定语；形容天气格外炎热"},{"id":30526,"word":"焦熬投石","pinyin":"jiāo áo tóu shí","abbr":"jats","explanation":"焦熬：指在火上久烧变脆的东西。拿非常脆的东西去碰石头。比喻事情一定失败。","source":{"text":"桓文之节制，不可以敌汤武之仁义，有遇之者，若以焦熬投石焉。","book":"战国·赵·荀况《荀子·议兵》"},"example":{"text":"若以～焉。","book":"宋·司马光《资治通鉴·秦昭襄王52年》"},"similar":["以卵击石"],"usage":"作宾语；比喻事情一定失败"},{"id":30527,"word":"焦眉愁眼","pinyin":"jiāo méi chóu yǎn","abbr":"jmcy","explanation":"形容忧虑愁苦的表情。","source":{"text":"野猫子作出焦眉愁眼的样子，一面就摸着她的足，叹气。","book":"艾芜《山峡中》"},"similar":["焦眉苦脸","焦眉皱眼"],"opposite":["喜眉笑脸"],"usage":"作定语、状语；指愁苦的神色"},{"id":30528,"word":"焦眉皱眼","pinyin":"jiāo méi zhòu yǎn","abbr":"jmzy","explanation":"形容忧虑愁苦的表情。同“焦眉愁眼”。","source":{"text":"街上十分冷落，几个站在门口看街的女人，老远就焦眉皱眼，随即退进门槛内面去了。","book":"沙汀《兽道》"},"similar":["焦眉愁眼"],"usage":"作定语、状语；指愁苦的神色"},{"id":30529,"word":"焦眉苦脸","pinyin":"jiāo méi kǔ liǎn","abbr":"jmkl","explanation":"形容焦急愁苦的神色。","source":{"text":"‘为了这一点事，你还不知道，我说了好几箩筐话啊！’田畴焦眉苦脸的说了。","book":"沙汀《困兽记》"},"example":{"text":"你不要～好不？"},"similar":["焦眉愁眼"],"opposite":["喜眉笑脸"],"usage":"作定语、状语；指愁苦的神色"},{"id":30530,"word":"焦躁不安","pinyin":"jiāo zào bù ān","abbr":"jzba","explanation":"焦急烦躁，心神不定。","example":{"text":"大家就无端觉得有些～，脾气愈大了，议论愈纠纷了，章程愈渺茫了。","book":"鲁迅《华盖集续编·送灶日漫笔》"}},{"id":30531,"word":"焦金流石","pinyin":"jiāo jīn liú shí","abbr":"jjls","explanation":"将金属、石头烧焦、熔化。形容天气极度干旱、炎热。","source":{"text":"放勋之世，浩浩襄陵；天乙之时，焦金流石。","book":"南朝·刘孝标《辩命论》"},"similar":["焦金烁石"],"usage":"作定语；形容天气格外炎热"},{"id":30532,"word":"焦金烁石","pinyin":"jiāo jīn shuò shí","abbr":"jjss","explanation":"使金石熔化枯焦。形容天气酷热。","source":{"text":"大热煊赫，焦金烁石。","book":"北齐·刘昼《刘子新论·大质》"}},{"id":30533,"word":"焮天铄地","pinyin":"xìn tiān shuò dì","abbr":"xtsd","explanation":"形容火势炽盛。","source":{"text":"火燎将至，焮天铄地。","book":"唐·王维《京兆尹张公德政碑》"},"usage":"作定语、状语；用于书面语"},{"id":30534,"word":"然然可可","pinyin":"rán rán kě kě","abbr":"rrkk","explanation":"然然：是的；可可：表示准许，可以。对什么都点头称是。比喻处世的态度唯唯诺诺。","source":{"text":"恶乎然？然于然。恶乎不然？不然于不然。物固有所然，物固有所可。无物不然，无物不可。","book":"《庄子·寓言》"},"example":{"text":"卮酒向人时，和气先倾倒。最要～，万事称好。","book":"宋·辛弃疾《千年调》词"}},{"id":30535,"word":"然糠照薪","pinyin":"rán kāng zhào xīn","abbr":"rkzx","explanation":"烧糠照明。比喻勤奋学习。同“然糠自照”。","source":{"text":"明年，丁母忧，因流寓青、齐间，然糠照薪，俾夜作昼，览书数千卷。","book":"《太平广记》卷一七五引《李琪》"},"similar":["然糠自照"],"usage":"作谓语、定语；比喻勤奋学习"},{"id":30536,"word":"然糠自照","pinyin":"rán kāng zì zhào","abbr":"rkzz","explanation":"然：同“燃”，烧；糠：谷壳。烧糠照明。比喻勤奋好学。","source":{"text":"乡中有学舍，欢贫无以受业，于舍壁后倚听，无遗忘者。夕则然松节读书，或然糠自照。","book":"《南史·顾欢传》"},"similar":["然糠照薪"],"usage":"作谓语、定语；比喻勤奋学习"},{"id":30537,"word":"然荻读书","pinyin":"rán dí dú shū","abbr":"rdds","explanation":"然：“燃”的本字，燃烧；荻：芦苇一类的植物。燃荻为灯，发奋读书。形容勤学苦读。","source":{"text":"梁世彭城刘绮，交州刺史勃之孙，早孤家贫，灯烛难办，常买荻尺寸折之，然明夜读。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作宾语、定语；用于书面语"},{"id":30538,"word":"煎水作冰","pinyin":"jiān shuǐ zuò bīng","abbr":"jszb","explanation":"比喻不可能的事。","source":{"text":"以若所为，求若所致，犹缘木求鱼，煎水作冰，其不可得，明矣。","book":"晋·陈寿《三国志·魏志·高堂隆传》"},"example":{"text":"～的做法荒唐可笑。"},"similar":["缘木求鱼"],"usage":"作宾语、定语；用于行为与目的相反"},{"id":30539,"word":"煎盐叠雪","pinyin":"jiān yán dié xuě","abbr":"jydx","explanation":"煎盐：熬制精盐；叠雪：层层相积的白雪。像洁白的细盐和层层叠起的白雪。多用以形容奔腾翻滚的浪花。","source":{"text":"那江里的白头浪茫茫一片，就如煎盐叠雪的一般。","book":"清·吴敬梓《儒林外史》第四十三回"}},{"id":30540,"word":"煎盐迭雪","pinyin":"jiān yán dié xuě","abbr":"jydx","explanation":"煎盐：提炼白色精盐；迭：堆迭；迭雪：堆迭的白雪。像晶莹洁白的精盐和雪一样。","source":{"text":"那江里的白头浪茫茫一片，就如煎盐迭雪的一般。","book":"清·吴敬梓《儒林外史》第43回"},"usage":"作宾语、定语；形容浪花等"},{"id":30541,"word":"煎胶续弦","pinyin":"jiān jiāo xù xián","abbr":"jjxx","explanation":"比喻交情密切或再续旧情。","source":{"text":"麟角凤觜世莫辨，煎胶续弦奇自见。","book":"唐杜甫《病后过王倚饮赠歌》"},"example":{"text":"麟角凤嘴世莫识，会看～时。","book":"程善之《寄洪棣臣金陵》诗"},"usage":"作宾语、定语；用于交情等"},{"id":30542,"word":"煎膏炊骨","pinyin":"jiān gāo chuī gǔ","abbr":"jgcg","explanation":"煎油脂烧骨头。比喻残酷的压榨。","source":{"text":"监司昨日兴常例，煎膏炊骨民无计。","book":"明·王士桢《鸣凤记·鄢赵争宠》"},"similar":["敲骨吸髓"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":30543,"word":"煎豆摘瓜","pinyin":"jiān dòu zhāi guā","abbr":"jdzg","explanation":"比喻亲属相残。","source":{"text":"三摘犹自可，摘绝抱蔓归。","book":"煎豆，语出三国魏曹植《七步诗》：“煮豆燃豆萁……相煎何太急。”摘瓜，语出唐李贤《黄台瓜辞》"},"example":{"text":"或兄弟争国，～，而建文之仁，金川门改为僧。","book":"康有为《大同书》甲部第六章"},"similar":["自残骨肉","骨肉相残"],"usage":"作谓语、宾语、定语；指亲属相残"},{"id":30544,"word":"煞有介事","pinyin":"shà yǒu jiè shì","abbr":"syjs","explanation":"原是江浙一带的方言。指装模作样，活像象真有那么一回事似的。多指大模大样，好像很了不起的样子。","source":{"text":"先生曰：‘某何尝不教人读书，不知此后煞有甚事。’","book":"宋·陆九渊《语录下》"},"example":{"text":"并不走，却抱着东西走向曾霆，‘～’的样子。","book":"曹禺《北京人》第三幕"},"similar":["盛气凌人","矫揉造作"],"opposite":["落落大方","雍容大雅","若无其事"],"usage":"作谓语、定语、状语；指故作姿态"},{"id":30545,"word":"煞费心机","pinyin":"shà fèi xīn jī","abbr":"sfxj","explanation":"指费尽心思。","source":{"text":"这个怕死鬼，还真是煞费心机哪！","book":"魏巍《东方》第三部第十四章"},"example":{"text":"大自然是崇高、卓越而美的。它～，创造世界。","book":"徐迟《黄山记》"},"similar":["煞费苦心"],"usage":"作谓语、宾语；指费尽心思"},{"id":30546,"word":"煞费经营","pinyin":"shà fèi jīng yíng","abbr":"sfjy","explanation":"煞：很，极；经营：计划和组织。费心心思经营。","example":{"text":"这样的长信，又有许多事实，无限深情，要委婉地含蓄在内，在蔼如自是件～的事。","book":"高阳《状元娘子》六"}},{"id":30547,"word":"煞费苦心","pinyin":"shà fèi kǔ xīn","abbr":"sfkx","explanation":"煞：委。形容费尽心思。","source":{"text":"这煎烟方法，我是煞费苦心，三番五次的试验，方才研究得精密。","book":"清·彭养鸥《黑籍冤魂》第三回"},"example":{"text":"他～编造的谎言被人当场揭穿了。"},"similar":["挖空心思","冥思苦想"],"opposite":["无所用心","掉以轻心"],"usage":"作谓语、状语；形容思索之苦"},{"id":30548,"word":"煞风景","pinyin":"shā fēng jǐng","abbr":"sfj","explanation":"比喻在大家高兴的时候，突然出现使人扫兴的事物。同“杀风景”。","source":{"text":"毋庸高牙煞风景，为著佳句增孤妍。","book":"宋·楼钥《次韵沈使君怀浮冈梅花》诗"},"example":{"text":"这也是一张少见的富有诗趣的药方，不过也有～的后面。","book":"鲁迅《花边文学·安贫乐道法》"},"similar":["杀风景"],"usage":"作谓语、定语；指扫兴的事物"},{"id":30549,"word":"煦仁孑义","pinyin":"xù rén jié yì","abbr":"xrjy","explanation":"煦：温和；孑：单独。指小仁小义。","source":{"text":"彼以煦煦为仁，孑孑为义。","book":"唐·韩愈《原道》"},"example":{"text":"修德者未尽乎道，～，如鱼处于陆，相煦以湿，相濡以沫，终不能相忘于江湖。","book":"段正元《圣道发凡·孔教》"}},{"id":30550,"word":"煦伏之恩","pinyin":"xù fú zhī ēn","abbr":"xfze","explanation":"煦伏：鸟卵在趐翼下受孵，比喻养育。比喻抚育之恩。","source":{"text":"吴王孙权，幼竖小子，无尺寸之功，遭遇兵乱，因父兄之绪，少蒙翼卵煦伏之恩，长含鸱枭反逆之性，背弃天施，罪恶积大。","book":"《三国志·吴志·吴主传》"},"usage":"作宾语；用于书面语"},{"id":30551,"word":"煦煦为仁","pinyin":"xù xù wéi rén","abbr":"xxwr","explanation":"煦煦：和悦、惠爱的样子。形容妇人之仁。","source":{"text":"彼以煦煦为仁，孑孑为义。","book":"唐·韩愈《原道》"},"example":{"text":"姚兴迷信释氏，～。关中臣民，颇免刑虐。","book":"蔡东藩《两晋演义》第九十二回"},"usage":"作宾语；用于书面语"},{"id":30552,"word":"煦煦孑孑","pinyin":"xù xù jié jié","abbr":"xxjj","explanation":"指小仁小义。","source":{"text":"煦煦为仁，孑孑为义。","book":"唐·韩愈《原道》"},"example":{"text":"徒善而无法者，～，必不足与校。","book":"章炳麟《菌说》"},"similar":["小恩小惠"],"usage":"作谓语、定语；指小仁小义"},{"id":30553,"word":"煦色韶光","pinyin":"xù sè sháo guāng","abbr":"xssg","explanation":"指晴暖美丽的风光。","source":{"text":"煦色韶光明媚，轻霭低笼芳树。","book":"宋·柳永《斗百花》词"},"usage":"作主语、宾语；用于书面语"},{"id":30554,"word":"照人肝胆","pinyin":"zhào rén gān dǎn","abbr":"zrgd","explanation":"比喻以赤诚相见。","source":{"text":"照人肝胆秦时月，百战风霜劫后旗。","book":"姜可生《送影禅北行》诗"},"example":{"text":"无数的血汗，凝成了～的星辰。","book":"郭小川《中国的秋天》诗"},"usage":"作定语；用于书面语"},{"id":30555,"word":"照功行赏","pinyin":"zhào gōng xíng shǎng","abbr":"zgxs","explanation":"按照功劳大小给予不同奖赏。","source":{"text":"卿等俱宜协力同心，辅成大事，所有富贵，我当照功行赏。","book":"明·郭勋《英烈传》第二十八回"},"similar":["论功行赏"],"usage":"作谓语、定语；用于处事"},{"id":30556,"word":"照单全收","pinyin":"zhào dān quán shōu","abbr":"zdqs","explanation":"指按照礼单的数目全部接受。","example":{"text":"恭敬不如从命，我只好～了。"},"usage":"作谓语；指全部接受","story":["明朝时期，宰相严嵩专权，他贪污受贿是家常便饭，过生日时大操大办，官员们给他送上各地的奇珍异宝，如《清明上河图》等。有些拍马屁的官员担心自己送的礼品白送了，就把礼单递到严嵩的手里。严嵩毫不客气说：“照单全收。”"]},{"id":30557,"word":"照天蜡烛","pinyin":"zhào tiān là zhú","abbr":"ztlz","explanation":"照亮天空的蜡烛。比喻清官明察。","source":{"text":"田元均密谏况，宽厚明辨，其治成都为声。……蜀人谓之‘照天蜡烛’，又谓之‘不错事尚书’。","book":"宋·范缜《东帝纪事》卷四"},"example":{"text":"大叫“活拿童俊做～”，四面合围上来。任你有六臂三头，也难逃天罗地网。（清·吕熊《女仙外史》第五十九回）"},"usage":"作宾语、定语；用于书面语"},{"id":30558,"word":"照妖镜","pinyin":"zhào yāo jìng","abbr":"zyj","explanation":"传说能照出妖魔鬼怪原形的宝镜。比喻借以看穿阴谋诡计的事物。","source":{"text":"我再出个‘照妖镜’，打《老子》一句，如打著，还你扇子。","book":"清·李汝珍《镜花缘》第81回"},"example":{"text":"有了～，我还怕你们这些牛鬼蛇神？"},"usage":"作宾语、定语；用于口语"},{"id":30559,"word":"照本宣科","pinyin":"zhào běn xuān kē","abbr":"zbxk","explanation":"照：按照；本：书本；宣：宣读；科：科条，条文。照着本子念条文。形容讲课、发言等死板地按照课文、讲稿，没有发挥，不生动。","source":{"text":"也不用僧人持咒，道士宣科。","book":"元·关汉卿《西蜀梦》第三折"},"example":{"text":"说法是～，十分单纯的。","book":"郭沫若《少年时代·我的童年》"},"similar":["照猫画虎","照葫芦画瓢"],"opposite":["断章取义","添油加醋"],"usage":"作谓语、定语、状语；指死读"},{"id":30560,"word":"照猫画虎","pinyin":"zhào māo huà hǔ","abbr":"zmhh","explanation":"比喻照着样子模仿。","source":{"text":"这大相公聪明得很，他是照猫画虎，一见即会套的人。","book":"清·李绿园《歧路灯》第11回"},"example":{"text":"至于搞工业，还得～地跟人家学。","book":"张天民《创业·不信没石油》"},"similar":["照葫芦画瓢","照本宣科"],"usage":"作谓语、宾语、定语；指模仿"},{"id":30561,"word":"照章办事","pinyin":"zhào zhāng bàn shì","abbr":"zzbs","explanation":"按照规定办理事情。","source":{"text":"那就更得让她学会照章办事。国有国法，院有院规，不然，还得了？","book":"陈世旭《将军镇》第十章三"},"example":{"text":"法律虽然铁面无私，～，至少没那么不知趣，会去干涉一位大爷的私事。","book":"《警察和赞美诗》"},"similar":["公事公办"],"opposite":["徇私舞弊"],"usage":"作谓语、定语；用于处事"},{"id":30562,"word":"照萤映雪","pinyin":"zhào yíng yìng xuě","abbr":"zyyx","explanation":"利用萤火虫的光和白雪的映照读书，形容刻苦地读书精神","source":{"text":"至乃照萤映雪，编蒲缉柳，先言往行，人物雅俗，甘泉遗仪，南宫故事，画地成图，抵掌可述。","book":"《梁书·王僧孺传》"},"example":{"text":"《梁书·王僧孺传》：“至乃～，编蒲缉柳，先言往行，人物雅俗，甘泉遗仪，南宫故事，画地成图，抵掌可述。”"},"usage":"作宾语、定语；用于书面语"},{"id":30563,"word":"照葫芦画瓢","pinyin":"zhào hú lu huà piáo","abbr":"zhlhp","explanation":"比喻照着样子模仿。","source":{"text":"太祖笑曰：‘颇闻翰林草制，皆检前人旧本，改换词语，此乃俗所谓‘依样画葫芦’耳，何宣力之有？’","book":"宋·魏泰《东轩笔录》第一卷"},"example":{"text":"他最擅长～了。"},"similar":["依样画葫芦","照猫画虎"],"usage":"作谓语、宾语；指模仿","story":["宋朝初年，翰林学士陶谷自以为文笔高超、才能出众，想好好表现一下升职，他劝宋太祖重视文字工作。赵匡胤以为他的工作只是抄写而已，说是依样画葫芦。陶谷的目的没有达到，就在住处墙上题诗：“堪笑翰林陶学士，年年依样画葫芦”"]},{"id":30564,"word":"煨干就湿","pinyin":"wēi gàn jiù shī","abbr":"wgjs","explanation":"极言抚育孩子的辛苦。","source":{"text":"俺两口儿虽不曾十月怀耽，也曾三年乳哺，也曾煨干就湿，咽苦吐甘。","book":"元·李直夫《虎头牌》第三折"},"example":{"text":"不想共乳同胞一体分，～母艰辛。","book":"元·无名氏《杀狗劝夫》第三折"},"similar":["煨干避湿"],"usage":"作谓语、定语；指父母的辛劳"},{"id":30565,"word":"煨干避湿","pinyin":"wēi gàn bì shī","abbr":"wgbs","explanation":"极言抚育孩子的辛苦。同“煨干就湿”","source":{"text":"生下这孩儿，十月怀胎，三年乳哺，咽苦吐甜，煨干避湿，不知受了多少辛苦。","book":"元·李行道《灰阑记》第四折"},"similar":["推燥居湿"],"usage":"作谓语、定语；指父母的辛劳"},{"id":30566,"word":"煮弩为粮","pinyin":"zhǔ nǔ wéi liáng","abbr":"znwl","explanation":"弩：弓弩。煮弩弓作为粮食吃。形容断粮时的艰难困境。","source":{"text":"凿山为井，煮弩为粮，出于万死无一生之望。","book":"《后汉书·耿弇传》"},"usage":"作宾语、定语；用于书面语"},{"id":30567,"word":"煮粥焚须","pinyin":"zhǔ zhōu fén xū","abbr":"zzfx","explanation":"比喻兄弟友爱。","source":{"text":"[勣]性友爱，其姊病，尝自为粥而燎其须。姊戒止。","book":"《新唐书·李勣传》"},"usage":"作谓语、宾语；指手足之情"},{"id":30568,"word":"煮豆燃箕","pinyin":"zhǔ dòu rán qí","abbr":"zdrj","explanation":"比喻兄弟间自相残杀。"},{"id":30569,"word":"煮豆燃萁","pinyin":"zhǔ dòu rán qí","abbr":"zdrq","explanation":"燃：烧；萁：豆茎。用豆萁作燃料煮豆子。比喻兄弟间自相残杀。","source":{"text":"文帝尝令东阿王七步作诗，不成者行大法。应声便为诗曰：‘煮豆持作羹，漉菽以为法，萁在釜下燃，豆在釜中泣，本是同根生，相煎何太急？’帝深有惭色。","book":"南朝宋·刘义庆《世说新语·文学》"},"example":{"text":"～伤往昔，而今团结乐陶陶。","book":"陈毅《过临洮》诗"},"similar":["同室操戈","相煎太急"],"opposite":["情同手足","辅车相依","亲密无间"],"usage":"作主语、谓语、定语；用于兄弟之间","story":["三国时期，魏文帝曹丕很妒忌兄弟曹植的才华，想找一个借口把他杀死，命令他在七步之内作出一首诗，否则处死。曹植作诗：“煮豆持作羹，漉菽以为汁，萁在釜下然，豆在釜中泣。本是同根生，相煎何太急。”曹丕只好贬他去镇守边疆"]},{"id":30570,"word":"煮鹤烧琴","pinyin":"zhǔ hè shāo qín","abbr":"zhsq","explanation":"比喻糟蹋美好事物因而大杀风景之事。","source":{"text":"自从煮鹤烧琴后，背却青山卧月明。","book":"唐·韦鹏翼《戏题盱眙壁》诗"},"example":{"text":"赏心亭上雪初融，～宴钜公。","book":"清·孔尚任《桃花扇·骂筵》"},"similar":["烧琴煮鹤","煮鹤焚琴"],"usage":"作宾语、定语；用于比喻句"},{"id":30571,"word":"煮鹤焚琴","pinyin":"zhǔ hè fén qín","abbr":"zhfq","explanation":"把琴当柴烧，把鹤煮了吃。比喻糟蹋美好的事物。","source":{"text":"义山《杂纂》，品目数十，盖以文滑稽者。其一曰杀风景，谓清泉濯足，花下晒晖，背山起楼，烧琴煮鹤。","book":"宋·胡仔《苕溪渔隐丛篆集》引《西清诗话》"},"example":{"text":"怜香惜玉无情绪，～惹是非。","book":"明·施耐庵《水浒全传》第十八回"},"similar":["暴殄天物","煮鹤烧琴"],"opposite":["怜香惜玉"],"usage":"作谓语、宾语、定语；指糟蹋好东西"},{"id":30572,"word":"煽风点火","pinyin":"shān fēng diǎn huǒ","abbr":"sfdh","explanation":"比喻煽动别人闹事。","source":{"text":"倒不是怕有人煽风点火。","book":"沙汀《青棡坡》"},"example":{"text":"这时节也悄悄把嘴筒子伸了出来，在一些角落里～。","book":"克非《春潮急》"},"similar":["推波助澜","兴风作浪"],"opposite":["排忧解难"],"usage":"作谓语、宾语；指煽动闹事"},{"id":30573,"word":"熊心豹胆","pinyin":"xióng xīn bào dǎn","abbr":"xxbd","explanation":"比喻非常胆大。","source":{"text":"老元帅！我有熊心豹胆，怎敢掩藏着赵氏孤儿。","book":"元·纪君祥《赵氏孤儿》第三折"},"example":{"text":"都是些～能征将，怕甚么虎窟龙潭恶战场。","book":"明·无名氏《五马破曹》第二折"},"similar":["胆大包天"],"opposite":["胆小如鼠"],"usage":"作宾语、定语；比喻非常胆大"},{"id":30574,"word":"熊据虎跱","pinyin":"xióng jù hǔ shēn","abbr":"xjhz","explanation":"比喻群雄割据的形势。","source":{"text":"其间豪杰纵横，熊据虎跱，强如二袁，勇如吕布，跨州连郡，有威有名，十有余辈。","book":"汉·陈琳《檄吴将校部曲文》"},"usage":"作谓语、定语；用于书面语"},{"id":30575,"word":"熊据虎踤","pinyin":"xióng jù hǔ shēn","abbr":"xjhs","explanation":"比喻群雄割据的形势。"},{"id":30576,"word":"熊熊烈火","pinyin":"xióng xióng liè huǒ","abbr":"xxlh","explanation":"熊熊：形容火势旺盛。形容火势旺盛而猛烈。","example":{"text":"李莫愁挺立在～之中，竟是绝不理会。","book":"金庸《神雕侠侣》第三十二回"},"usage":"作主语、宾语、定语；用于书面语"},{"id":30577,"word":"熊经鸟伸","pinyin":"xióng jīng niǎo shēn","abbr":"xjns","explanation":"古代一种导引养生之法。状如熊之攀枝，鸟之伸脚。同“熊经鸟申”。","source":{"text":"不损上药，愈益下田。熊经鸟伸，纳新吐故。","book":"元·辛文房《唐才子传·吕岩》"},"similar":["熊经鸱顾","熊经鸟申","熊经鸟曳"],"usage":"作宾语、定语；用于书面语"},{"id":30578,"word":"熊经鸟引","pinyin":"xióng jīng niǎo yǐn","abbr":"xjny","explanation":"古代一种导引养生之法。状如熊之攀枝，鸟之伸脚。同“熊经鸟申”。","source":{"text":"熊经鸟引聊终老，岩下疏松正好攀。","book":"元·耶律楚材《继武善夫韵》"},"similar":["熊经鸟曳","熊经鸟申","熊经鸟伸"],"usage":"作宾语、定语；用于书面语"},{"id":30579,"word":"熊经鸟曳","pinyin":"xióng jīng niǎo yè","abbr":"xjny","explanation":"古代一种导引养生之法。状如熊之攀枝，鸟之伸脚。同“熊经鸟申”。","source":{"text":"且夫熊经鸟曳，导引吐纳，辍黍稷而御英蕊。","book":"《弘明集·正诬论》"},"similar":["熊经鸟伸","熊经鸟引","熊经鸟申"],"usage":"作宾语、定语；用于书面语"},{"id":30580,"word":"熊经鸟申","pinyin":"xióng jīng niǎo shēn","abbr":"xjns","explanation":"古代一种导引养生之法。状如熊之攀枝，鸟之伸脚。","source":{"text":"吹呴呼吸，吐故纳新，熊经鸟申，为寿而已矣。","book":"《庄子·刻意》"},"example":{"text":"郭沫若《豕蹄·孟夫子出妻》：“那种的工夫，在古时候人是称为～。”"},"similar":["熊经鸟伸","熊经鸱顾"],"usage":"作宾语、定语；用于书面语"},{"id":30581,"word":"熊经鸱顾","pinyin":"xióng jīng chī gù","abbr":"xjcg","explanation":"古代一种导引养生之法。状如熊之攀枝，鸱之回顾。","source":{"text":"是以古之仙者为导引之事，熊经鸱顾。","book":"《后汉书·华佗传》"},"similar":["熊经鸟申"],"usage":"作宾语、定语；用于书面语"},{"id":30582,"word":"熊罴之力","pinyin":"xióng pí zhī lì","abbr":"xpzl","explanation":"熊罴：猛兽。指强大的势力","source":{"text":"秦以熊罴之力，虎狼之心，蚕食诸侯，并吞海内。","book":"东汉·班固《汉书·贾山传》"},"usage":"作主语、宾语；用于书面语"},{"id":30583,"word":"熊罴之士","pinyin":"xióng pí zhī shì","abbr":"xpzs","explanation":"比喻勇士。","source":{"text":"则亦有熊罴之士，不二心之臣。","book":"《尚书·康王之诰》"},"example":{"text":"清·吴璿《飞龙全传》第48回：“虽有～，亿万之兵，安得而用乎？”"},"similar":["熊虎之士"],"usage":"作主语、宾语；用于书面语"},{"id":30584,"word":"熊罴之师","pinyin":"xióng pí zhī shī","abbr":"xpzs","explanation":"熊罴：两种猛兽，比喻勇猛之士；师：军队。比喻勇猛善战的军队。","source":{"text":"乃有熊罴之旅，虓阚之将。","book":"晋·陆云《南征赋》"}},{"id":30585,"word":"熊罴之旅","pinyin":"xióng pí zhī lǚ","abbr":"xpzl","explanation":"熊罴：两种猛兽，比喻勇猛之士；旅：军队。比喻勇猛善战的军队。","source":{"text":"乃有熊罴之旅，虓阚之将。","book":"晋·陆云《南征赋》"},"example":{"text":"高祖光宅土中，业隆卜世，赫雷霆之威，振～，方役南辕，未遑北伐。","book":"《魏书·张伦传》"},"usage":"作主语、宾语；用于书面语"},{"id":30586,"word":"熊罴之祥","pinyin":"xióng pí zhī xiáng","abbr":"xpzx","explanation":"生男孩的吉兆。","source":{"text":"大人占之，维熊维罴，男子之祥；维虺维蛇，女子之祥。","book":"《诗经·小雅·斯干》"},"example":{"text":"陛下聪达，穷理尽性，面顷皇子连多夭折，～又未感应。","book":"《三国志·魏志·高柔传》"},"usage":"作主语、宾语；用于书面语"},{"id":30587,"word":"熊罴入梦","pinyin":"xióng pí rù mèng","abbr":"xprm","explanation":"旧时用于祝人生子。","source":{"text":"维熊维罴，男子之祥。","book":"《诗经·小雅·斯干》"},"example":{"text":"已见～，行看老蚌生珠。","book":"明·赵弼《蓬莱先生传》"},"similar":["熊罴叶梦"],"usage":"作宾语；用于祝贺人生子"},{"id":30588,"word":"熊罴叶梦","pinyin":"xióng pí xié mèng","abbr":"xpym","explanation":"熊罴：猛兽；叶：通“协”；叶梦：符合梦中所见。祝贺人生子","source":{"text":"维熊维罴，男子之祥。","book":"《诗经·小雅·斯干》"},"similar":["熊罴入梦"],"usage":"作宾语；用于祝贺人生子"},{"id":30589,"word":"熊罴百万","pinyin":"xióng pí bǎi wàn","abbr":"xpbw","explanation":"熊罴：两种猛兽，比喻勇猛的武士。勇猛的武士成千上万。形容军队人多将广，英勇善战。","source":{"text":"汝不闻去岁淮甸间，熊罴百万临危堞。","book":"宋·王迈《观猎行》"}},{"id":30590,"word":"熊腰虎背","pinyin":"xióng yāo hǔ bèi","abbr":"xyhb","explanation":"腰粗壮如熊，背宽厚如虎。形容人身体魁梧健壮。","source":{"text":"这厮倒是一条好汉，狗背驴腰的，哦，是虎背熊腰。","book":"元·无名氏《飞刀对箭》"},"example":{"text":"视之，身长九尺，面黑睛黄，～。","book":"明·罗贯中《三国演义》第九十七回"},"similar":["虎背熊腰"],"usage":"作宾语、状语；形容男人"},{"id":30591,"word":"熊虎之任","pinyin":"xióng hǔ zhī rèn","abbr":"xhzr","explanation":"比喻征战的任务。","source":{"text":"勇略之士则受熊虎之任，儒雅之徒则处龙凤之署。","book":"《三国志·吴志·韦矅传》"}},{"id":30592,"word":"熊虎之士","pinyin":"xióng hǔ zhī shì","abbr":"xhzs","explanation":"形容勇猛的人。","source":{"text":"方今二贼未灭，戎车亟驾，此自熊虎之士展力之秋也。","book":"《三国志·魏志·杜畿传》"},"example":{"text":"瑜曰：“吾之军士，颇雄壮否？”干曰：“真～也。”","book":"明·罗贯中《三国演义》第四十五回"},"similar":["熊罴之士"],"usage":"作主语、宾语；用于书面语"},{"id":30593,"word":"熊虎之将","pinyin":"xióng hǔ zhī jiàng","abbr":"xhzj","explanation":"熊、虎：两种猛兽。比喻作战勇猛的将领。","source":{"text":"刘备以枭雄之姿，而有关羽、张飞熊虎之将，必非久屈为人用者。","book":"《三国志·吴志·周瑜传》"},"usage":"作宾语；用于比喻句"},{"id":30594,"word":"熊韬豹略","pinyin":"xióng tāo bào lüè","abbr":"xtbl","explanation":"比喻高妙的用兵谋略。","source":{"text":"几神洞妙，熊韬豹略之权；舞电威棱，越骑燕犀之象。","book":"唐·司空图《复安南碑》"},"usage":"作宾语、定语；用于书面语"},{"id":30595,"word":"熏天赫地","pinyin":"xūn tiān hè dì","abbr":"xthd","explanation":"熏天：气势极盛的样子；赫：显明，盛大。形容气焰炽盛。","source":{"text":"兹邦称贵近，与世尝熏赫。","book":"唐·张九龄《南阳道中》诗"},"example":{"text":"然那等～富贵人，除非是遇了朝廷诛戮，或是生下子孙不肖，方是败落散场。","book":"明·凌蒙初《初刻拍案惊奇》卷二十二"},"usage":"作宾语、定语；形容气焰炽盛"},{"id":30596,"word":"熏腐之余","pinyin":"xūn fǔ zhī yú","abbr":"xfzy","explanation":"熏腐：阉割。腐刑之后。指宦官。","source":{"text":"彼自以为总明人杰也，奴仆熏腐之余何能为。","book":"宋·苏轼《论始皇汉宣李斯》"},"usage":"作宾语；指太监"},{"id":30597,"word":"熏莸不同器","pinyin":"xún yóu bù tóng qì","abbr":"xybtq","explanation":"熏莸：香草和臭草。比喻好和坏不能共处。","source":{"text":"回闻熏莸不同器而藏，尧桀不共国而治，以其异类也。","book":"三国·魏·王肃《孔子家语·致思》"},"example":{"text":"～，清淆本殊源。","book":"明·何景明《咏怀》"}},{"id":30598,"word":"熏莸同器","pinyin":"xún yóu tóng qì","abbr":"xytq","explanation":"熏：香草；莸：臭草。香草与臭草收藏在同一容器内。比喻好人与坏人共处。","source":{"text":"回闻熏莸不同器而藏，尧桀不共国而治，以其异类也。","book":"三国·魏·王肃《孔子家语·致思》"}},{"id":30599,"word":"熏陶成性","pinyin":"xūn táo chéng xìng","abbr":"xtcx","explanation":"熏陶：感化，培养；性：习惯。经常受到某方面的感染而形成的某种习性。","source":{"text":"今夫人民善教其子弟者，亦必延名德之士，使与之处，以熏陶成性。","book":"《宋史·程颐传》"},"usage":"作谓语、宾语；指成为习性"},{"id":30600,"word":"熏风解愠","pinyin":"xūn fēng jiě yùn","abbr":"xfjy","explanation":"熏风：和风；愠：恼怒怨恨。温和的风可以消除心中的烦恼，使人心情舒畅。","source":{"text":"昔日舜弹五弦之琴，造《南风》之诗，其诗曰：‘南风之熏兮，可以解吾民之愠兮。’","book":"三国·魏·王肃《孔子家语·辩乐》"},"example":{"text":"～，昼景清和，新霁时候。","book":"宋·柳永《永遇乐》词"}},{"id":30601,"word":"熏香荀令","pinyin":"xūn xiāng xún lìng","abbr":"xxxl","explanation":"形容官吏美名远扬，为人所敬仰。也形容独具风采，风度优雅的官吏。","source":{"text":"熏香荀令偏怜少，傅粉何郎不解愁。","book":"晋·习凿齿《襄阳记》载：东汉荀彧性喜香，常将衣服薰香，若去他人家坐一下，坐处三日有香气。唐·李端《赠郭驸马》"},"example":{"text":"昏又晓，蝶梦不栖芳草。照映琼林人物好，～小。","book":"元·李俊明《谒金门》词"}},{"id":30602,"word":"熔于一炉","pinyin":"róng yú yī lú","abbr":"ryyl","explanation":"熔化在同一个炉内。比喻多种事物相互间结合紧密，浑然一体，难分难解。","source":{"text":"废名在解放前，特别在抗战前，似曾以他独特的方式，把儒释道熔于一炉。","book":"卞之琳《冯文炳选集·序》"},"similar":["浑然一体","难分难解"],"opposite":["格格不入"],"usage":"作谓语；指关系密切"},{"id":30603,"word":"熔今铸古","pinyin":"róng jīn zhù gǔ","abbr":"rjzg","explanation":"指融会贯通古今知识。","source":{"text":"那曾见熔今铸古五车饶，冰茧花生玉粟娇。","book":"明·陈汝元《金莲记·弹丝》"},"similar":["熔古铸今"],"usage":"作宾语、定语；指融会贯通古今知识"},{"id":30604,"word":"熔古铸今","pinyin":"róng gǔ zhù jīn","abbr":"rgzj","explanation":"指融会贯通古今知识。","source":{"text":"葆真履素，取则先民，熔古铸今，蔚为代宝。","book":"清·王士禛《池北偶谈·谈艺二·沧溟蔡姬》"},"similar":["熔今铸古"],"usage":"作宾语、定语；指融会贯通古今知识"},{"id":30605,"word":"熙来攘往","pinyin":"xī lái rǎng wǎng","abbr":"xlrw","explanation":"形容人来人往，非常热闹拥挤。","source":{"text":"天下熙熙，皆为利来；天下攘攘，皆为利往。","book":"《史记·货殖列传》"},"example":{"text":"人们～地汇集在广场上。"},"similar":["人山人海","车水马龙"],"opposite":["万籁俱寂","渺无人迹"],"usage":"作谓语、定语；形容人多拥挤"},{"id":30606,"word":"熙熙壤壤","pinyin":"xī xī rǎng rǎng","abbr":"xxrr","explanation":"形容人来人往，喧闹纷杂。壤，通“攘”。","source":{"text":"天下熙熙，皆为利来；天下壤壤，皆为利往。","book":"语出《史记·货殖列传》"},"similar":["熙熙攘攘"],"usage":"作谓语、定语；形容人多喧闹"},{"id":30607,"word":"熙熙攘攘","pinyin":"xī xī rǎng rǎng","abbr":"xxrr","explanation":"熙熙：和乐的样子；攘攘：纷乱的样子。形容人来人往，非常热闹拥挤。","source":{"text":"天下熙熙，皆为利来；天下攘攘，皆为利往。","book":"《史记·货殖列传》"},"example":{"text":"共青团员都打扮成去远足的样子，每人提了个提包，有的是挂包，～的会集在厂里的球场上。","book":"茹志娟《新当选的团支书》"},"similar":["人山人海","水泄不通","熙熙壤壤"],"opposite":["门前冷落","门可罗雀"],"usage":"作谓语、定语；形容人多喧闹"},{"id":30608,"word":"熙熙融融","pinyin":"xī xī róng róng","abbr":"xxrr","explanation":"亲爱和睦的样子。","source":{"text":"今值大难已平，回銮已达，满目熙熙融融，又是一番新气象了。","book":"梁启超《劫灰梦·独啸》"},"example":{"text":"院里的人都～地欢喜了一天，现在也沉静了。","book":"郭沫若《落叶》十"},"usage":"作定语、状语；用于书面语"},{"id":30609,"word":"熟人熟事","pinyin":"shú rén shú shì","abbr":"srss","explanation":"指经常打交道。","example":{"text":"这些～经常浮现在我的眼前。"},"usage":"作主语、宾语、定语；指十分熟悉的人和事"},{"id":30610,"word":"熟思审处","pinyin":"shú sī shěn chǔ","abbr":"sssc","explanation":"反复思考，审慎筹划。","source":{"text":"盖芍友遇事必熟思审处，计出万全而后行。","book":"清·梁章钜《浪迹丛谈·许小琴分司》"},"similar":["深思熟虑"],"usage":"作谓语、宾语、定语、状语；用于处事"},{"id":30611,"word":"熟羊胛","pinyin":"shú yáng jiǎ","abbr":"syj","explanation":"羊胛：羊的肩胛。比喻时间过得很快。","source":{"text":"日入亨羊胛，熟，东方已明。","book":"《新唐书·回鹘传》"},"usage":"作宾语、定语；指时间过得快","story":["唐朝时期，北方少数民族铁勒的部族很多，其中一个部族叫骨利干，地处瀚海以北，那里的草多为百合，盛产良马，可以日行千里。骨利干北边临海，离唐朝京都长安很远。那里日长夜短，傍晚开始煮羊的肩胛，等煮熟时，东方竟然天亮了"]},{"id":30612,"word":"熟能生巧","pinyin":"shú néng shēng qiǎo","abbr":"snsq","explanation":"熟练了，就能找到窍门。","source":{"text":"俗话说的熟能生巧，舅兄昨日读了一夜，不但他已嚼出此中意味，并且连寄女也都听会，所以随问随答，毫不费事。","book":"清·李汝珍《镜花缘》第三十一回"},"example":{"text":"会而不难终要学，～岂徒诗。","book":"蔡东藩《慈禧太后演义》第二十一回"},"similar":["得心应手","游刃有余"],"opposite":["半路出家"],"usage":"作主语、宾语、定语；指技艺、学问等","story":["北宋著名射箭能手陈尧咨擅长射箭，他射十支箭可以中八九支，旁人都为之叫好，惟独一个卖油的老翁不以为然，陈尧咨觉得奇怪，老翁拿出一枚铜钱放到葫芦口上，把油从铜钱的钱眼中倒入葫芦，然后说道你射箭也不过如此熟能生巧罢了"]},{"id":30613,"word":"熟视不睹","pinyin":"shú shì bù dǔ","abbr":"ssbd","explanation":"熟视：细看；睹：看见。看惯了就像没看见一样。也指看到某种现象，但不关心，只当没有看见。","source":{"text":"静听不闻雷霆之声，熟视不睹泰山之形。","book":"晋·刘伶《酒德颂》"},"similar":["熟视无睹"],"usage":"作谓语、定语；指习以为常"},{"id":30614,"word":"熟视无睹","pinyin":"shú shì wú dǔ","abbr":"sswd","explanation":"熟视：经常看到，看惯；无睹：没有看见。看惯了就象没看见一样。也指看到某种现象，但不关心，只当没有看见。","source":{"text":"是以有力者遇之，熟视之若无睹也。","book":"晋·刘伶《酒德颂》：“静听不闻雷霆之声，熟视不睹泰山之形。”唐·韩愈《应科目时与人书》"},"example":{"text":"对于损坏公物的现象，我们决不能～。"},"similar":["视而不见","听而不闻"],"opposite":["过目成诵"],"usage":"作谓语、定语；指习以为常"},{"id":30615,"word":"熟读深思","pinyin":"shú dú shēn sī","abbr":"sdss","explanation":"反复地阅读，认真地思考。","source":{"text":"旧书不厌百回读，熟读深思子自知。","book":"宋·苏轼《送安犉秀才失解西归》"},"similar":["熟读精思"],"usage":"作主语、谓语、宾语；用于文章等"},{"id":30616,"word":"熟读玩味","pinyin":"shú dú wán wèi","abbr":"sdww","explanation":"玩味：细细地体会其中的意味。形容反复仔细地阅读。","source":{"text":"学者当熟读玩味，则知景纯之心法矣。","book":"晋·郭璞《葬经·杂篇》"},"example":{"text":"晋·郭璞《葬经·杂篇》：“学者当熟读玩味，则知景纯之心法矣。”"}},{"id":30617,"word":"熟读精思","pinyin":"shú dú jīng sī","abbr":"sdjs","explanation":"精：专一，深入。形容反复地阅读，仔细地思考。","source":{"text":"得瑗所授经，熟读精思，攻苦食淡，夏不扇，冬不炉，夜不安枕者踰年。","book":"《宋史·徐中行传》"},"similar":["熟读深思"],"usage":"作主语、谓语、宾语；用于文章等"},{"id":30618,"word":"熟路轻车","pinyin":"shú lù qīng chē","abbr":"slqc","explanation":"比喻处世有经验，办起事来很容易。同“熟路轻辙”。","source":{"text":"一任恁地网天罗，怎禁俺熟路轻车。","book":"明·许自昌《水浒记·纵绮》"},"similar":["熟路轻辙","轻车熟路"],"usage":"作谓语、宾语、状语；指办事轻而易举"},{"id":30619,"word":"熟路轻辙","pinyin":"shú lù qīng zhé","abbr":"slqz","explanation":"驾轻快的车，走熟悉的路。比喻处世有经验，办起事来很容易。","source":{"text":"君看取，世道羊肠屈折，依然熟路轻辙。","book":"宋·张榘《摸鱼儿·为赵懒窝寿》词"},"similar":["熟路轻车","轻车熟路"],"usage":"作谓语、宾语、状语；指办事轻而易举"},{"id":30620,"word":"熟门熟路","pinyin":"shú mén shú lù","abbr":"smsl","explanation":"熟悉门径，了解情况，很有经验。","source":{"text":"王孝廉是熟门熟路，管门的一向认得，立时请进，并不阻挡。","book":"清·李宝嘉《官场现形记》第二回"},"example":{"text":"我想～，比生手实在好得多。","book":"鲁迅《彷徨·祝福》"},"similar":["轻车熟路"],"opposite":["人地两生"],"usage":"作宾语、定语；指现成的门路"},{"id":30621,"word":"熟魏生张","pinyin":"shú wèi shēng zhāng","abbr":"swsz","explanation":"张、魏：都是姓，这里泛指人。泛指认识的或不认识的人。","source":{"text":"北都有妓女，美色而举止生梗，士人谓之‘生张八’。……野赠之诗曰：‘君为北道生张八，我是西州熟魏三。莫怪尊前无笑语，半生半熟未相谙。’","book":"宋·沈括《梦溪笔谈》卷十六"},"similar":["生张熟魏"],"usage":"作主语、宾语、定语；泛指认识的或不认识的","story":["宋朝时期，寇准镇守北部，收蜀人魏野到门下。当时北部有一个漂亮而举止生硬的妓女，士人叫她生张八，来寇府聚会，寇准即兴要魏野作诗，魏野立即作诗：“君为北道生张八，我是西州熟魏三。莫怪尊前无笑话，半生半熟未相谙。”"]},{"id":30622,"word":"熠熠生辉","pinyin":"yì yì shēng huī","abbr":"yysh","explanation":"熠熠：光耀，鲜明。形容光彩闪耀的样子。","example":{"text":"三个彩绿隶体字，～，成为我书房的壮观一景。","book":"孙犁《我的金石美术图画书》"}},{"id":30623,"word":"熬姜呷醋","pinyin":"áo jiāng xiā cù","abbr":"ajxc","explanation":"比喻生活清苦。","source":{"text":"下官知从选了这个穷教官，坐了这条冷板凳，终日熬姜呷醋，尚不能色问舍求田，哪里再经得进口添人。","book":"清·李渔《怜香伴·毡集》"},"similar":["清茶淡饭"],"opposite":["山珍海味"],"usage":"作谓语、定语；形容生活清苦"},{"id":30624,"word":"熬心费力","pinyin":"áo xīn fèi lì","abbr":"axfl","explanation":"耗费心神和气力。","source":{"text":"我熬心费力办农业，结果给组织上留下这么个印象。","book":"马烽《太阳刚刚出山》"},"similar":["煞费苦心"],"usage":"作谓语；指做某事费尽心力"},{"id":30625,"word":"熬更守夜","pinyin":"áo gēng shǒu yè","abbr":"agsy","explanation":"指熬夜。","source":{"text":"总理经常熬更守夜，废寝忘食地工作。","book":"《人民文学》1977年第1期"},"example":{"text":"他们～的够辛苦的喽！","book":"京剧《平原作战》第四场"},"similar":["夜以继日"],"usage":"作谓语；指彻夜不睡"},{"id":30626,"word":"熬枯受淡","pinyin":"áo kū shòu dàn","abbr":"aksd","explanation":"指忍受清苦的生活。","source":{"text":"这出家无过草衣木食，熬枯受淡。","book":"元·关汉卿《望江亭》第一折"},"example":{"text":"[杜子春]渐渐卖了马骑驴，卖给了驴步走，～，度过日子。","book":"《醒世恒言·杜子春三人长安》"},"similar":["熬清守淡"],"usage":"作谓语、宾语；指忍受清苦生活"},{"id":30627,"word":"熬油费火","pinyin":"áo yóu fèi huǒ","abbr":"ayfh","explanation":"指耗费灯油。多指日夜忙碌。","source":{"text":"此时贾赦、贾政又恐哭坏了贾母，日夜熬油费火，闹得上下不安。","book":"《红楼梦》第二五回"},"usage":"作谓语、定语；指日夜忙碌"},{"id":30628,"word":"熬清受淡","pinyin":"áo qīng shòu dàn","abbr":"aqsd","explanation":"指忍受清苦乏味的生活。","source":{"text":"见“熬清守淡”。"},"example":{"text":"老母尚且～，若为人子者，反在房中与妻享用，真所谓儿彘不如了。","book":"《天雨花》第二九回"},"similar":["熬清守淡"],"usage":"作谓语、定语；指忍受清苦乏味的生活"},{"id":30629,"word":"熬清守淡","pinyin":"áo qīng shǒu dàn","abbr":"aqsd","explanation":"指忍受清苦乏味的生活。","source":{"text":"陈某不肖，将家私荡尽，赖我贤妻熬清守淡。","book":"《初刻拍案惊奇》卷十五"},"similar":["熬清受淡"],"usage":"作谓语、定语；指忍受清苦的生活"},{"id":30630,"word":"熬清守谈","pinyin":"áo qīng shǒu tán","abbr":"aqst","explanation":"忍受清苦乏味的生活。","source":{"text":"陈某不肖，将家么荡尽，赖我贤妻熬清守谈。","book":"《初刻拍案惊奇》卷十五"}},{"id":30631,"word":"熬肠刮肚","pinyin":"áo cháng guā dù","abbr":"acgd","explanation":"指从事饮食方面尽力节俭。","source":{"text":"咱薛家祖上是锅碗一担挑到新河集的，落了户，靠两只手苦，可怜，熬肠刮肚的买了这几亩田。","book":"陈登科《活人塘》三"},"similar":["省吃俭用"],"opposite":["山珍海味"],"usage":"作谓语、定语；指生活节俭"},{"id":30632,"word":"熯天炽地","pinyin":"hàn tiān chì dì","abbr":"htcd","explanation":"形容火势极猛。","source":{"text":"只见那红焰焰大火烧空，把一座火云洞，被那烟火迷漫，真是个熯天炽地。","book":"《西游记》第三五回：“那怪物着实无情，一连搧了七八扇子，熯天炽地，烈火飞腾。”又第四一回"},"usage":"作宾语；指火势等"},{"id":30633,"word":"燃犀温峤","pinyin":"rán xī wēn qiáo","abbr":"rxwj","explanation":"燃：点燃；犀：犀牛的角；温峤：传说中的人物。温峤点燃犀牛和角来照明。比喻能敏锐地洞察事物。","source":{"text":"至中渚矶，水深不可测，世云其下多怪物，峤遂毁犀角而照之。须臾，见水族覆火，奇形异状。","book":"南朝·宋·刘敬叔《异苑》"},"example":{"text":"你莫不是～江心里走，你莫不是鼓瑟湘灵水面上游。","book":"元·范子安《竹叶舟》第三折"}},{"id":30634,"word":"燃眉之急","pinyin":"rán méi zhī jí","abbr":"rmzj","explanation":"燃：烧。火烧眉毛那样紧急。形容事情非常急迫。","source":{"text":"元祐初，温公入相，诸贤并进用，革新法之病民者，如救眉燃，青苗、助役其尤也。","book":"宋·释普济《五灯会元》卷十六：“问：‘如何是急切一句？’师曰：‘火烧眉毛。’”《文献通考·市籴二》"},"example":{"text":"此在目前，实救～。","book":"叶圣陶《前途》"},"similar":["迫在眉睫","迫不及待"],"opposite":["无足轻重","无关大局"],"usage":"作主语、谓语、宾语；形容心情等","story":["东汉末年，曹操想一统天下，接连打败刘表、刘琦，将刘备赶出新野，迫近东吴。孙权心里慌张，派鲁肃请诸葛亮到东吴商议联合抗曹。张昭看不起诸葛亮，说他根本没本事辅佐刘备，弄得现今的燃眉之急。诸葛亮舌战群儒取得胜利"]},{"id":30635,"word":"燃糠自照","pinyin":"rán kāng zì zhào","abbr":"rkzz","explanation":"比喻勤奋好学。","source":{"text":"乡中有学舍，欢贫无以受业，于舍壁后倚听，无遗忘者。夕则燃松节读书，或燃糠自照。","book":"《南史·顾欢传》"}},{"id":30636,"word":"燃膏继晷","pinyin":"rán gāo jì guǐ","abbr":"rgjg","explanation":"燃：点燃；膏：油脂，指灯油；继：接续；晷：日影，日光。点上灯烛，接续日光。形容夜以继日地工作与学习。","source":{"text":"沈约，吴兴武康人也，官至尚书令。少家贫，一意书史，燃膏继晷，昼夜不倦。","book":"《宣和书谱·草书·沈约》"},"similar":["焚膏继晷"],"usage":"作谓语、状语、分句；指人勤奋"},{"id":30637,"word":"燃萁之敏","pinyin":"rán qí zhī mǐn","abbr":"rqzm","explanation":"后因以之喻文思敏捷。","source":{"text":"曾无击钵之音，但愧燃萁之敏。","book":"相传三国魏曹植在其兄曹丕的胁迫下七步成诗，诗中有“萁在釜下燃，豆在釜中泣”语。宋·宁参《白水县斋十咏》序"},"similar":["七步之才"],"usage":"作宾语；指人文思敏捷"},{"id":30638,"word":"燃萁煎豆","pinyin":"rán qí jiān dòu","abbr":"rqjd","explanation":"比喻骨肉相残。同“煮豆燃萁”。","source":{"text":"生死由来一样情，燃萁煎豆并根生。","book":"《二刻拍案惊奇》卷二三"},"similar":["煮豆燃萁"],"opposite":["亲密无间"],"usage":"作主语、定语、宾语；用于兄弟之间"},{"id":30639,"word":"燃萁煮豆","pinyin":"rán qí zhǔ dòu","abbr":"rqzd","explanation":"比喻骨肉相残。同“煮豆燃萁”。","source":{"text":"宛如酿枣分梨日，堪愧人燃萁煮豆。","book":"宋·刘克庄《寄题建阳宋景高友于堂》诗"},"similar":["煮豆燃萁","燃萁煎豆"],"opposite":["亲密无间"],"usage":"作主语、定语、宾语；用于兄弟之间"},{"id":30640,"word":"燋头烂额","pinyin":"jiāo tóu làn é","abbr":"jtle","explanation":"烧焦了头，灼伤了额。比喻非常狼狈窘迫。同“焦头烂额”。"},{"id":30641,"word":"燋金烁石","pinyin":"jiāo jīn shuò shí","abbr":"jjss","explanation":"使金石销熔，形容天很酷热。","source":{"text":"大热煊赫，燋金烁石。","book":"北齐·刘昼《新论·大质》"},"similar":["焦金流石"],"usage":"作定语；形容天气格外炎热"},{"id":30642,"word":"燎原之势","pinyin":"liáo yuán zhī shì","abbr":"lyzs","explanation":"比喻迅猛发展的形势。","example":{"text":"数月之间即占据岭南六省，形成～。","book":"王若东《天下第一廉吏——于成龙传》第五章"}},{"id":30643,"word":"燎原之火","pinyin":"liáo yuán zhī huǒ","abbr":"lyzh","explanation":"好像大火在原野上燃烧，使人无法接近。比喻不断壮大，不可抗拒的革命力量。","source":{"text":"若火之燎于原，不可向迩。","book":"《尚书·盘庚上》"},"example":{"text":"改革开放的洪流，似～，不可阻挡。"},"similar":["星星之火，可以燎原"],"usage":"作主语、宾语；指新生的势力"},{"id":30644,"word":"燎原烈火","pinyin":"liáo yuán liè huǒ","abbr":"lylh","explanation":"好像大火在原野上燃烧，使人无法接近。比喻不断壮大，不可抗拒的革命力量。","source":{"text":"若火之燎于原，不可向迩。","book":"《尚书·盘庚上》"},"example":{"text":"改革开放的洪流，似～，不可阻挡。"},"similar":["冲天大火","火势燎原","燎原之势"],"opposite":["星星之火"],"usage":"作宾语；指大火"},{"id":30645,"word":"燎发摧枯","pinyin":"liǎo fà cuī kū","abbr":"lfck","explanation":"燎发：火烧毛发；摧枯：折断枯木。比喻消灭敌人极容易。","source":{"text":"攻如燎发，战似摧枯。","book":"《隋书·音乐志下》"},"usage":"作宾语、定语；用于比喻句"},{"id":30646,"word":"燎如观火","pinyin":"liǎo rú guān huǒ","abbr":"lrgh","explanation":"指事理清楚明白，如看火一样。","source":{"text":"究竟谁是谁非，谁错谁不错，这是燎如观火的。","book":"郭沫若《文艺论集·反响之反响》"},"example":{"text":"这部作品的观点～，值得一读。"},"similar":["燎若观火"],"usage":"作谓语、补语；指非常明确"},{"id":30647,"word":"燎若观火","pinyin":"liǒo ruò guān huǒ","abbr":"lrgh","explanation":"指事理清楚明白，如看火一般。","source":{"text":"二千一百二十五年之治乱，燎若观火。","book":"清·黄宗羲《朱康流先生墓志铭》"},"similar":["燎如观火"],"usage":"作谓语、补语；指非常明确"},{"id":30648,"word":"燔书坑儒","pinyin":"fán shū kēng rú","abbr":"fskr","explanation":"焚毁典籍，坑杀书生。同“焚书坑儒”。","source":{"text":"并六国，称皇帝，负力怙威，燔书坑儒，自任私智。","book":"东汉·班固《汉书·地理志下》"},"similar":["焚书坑儒"],"usage":"作定语、宾语；指文化专制"},{"id":30649,"word":"燔书阬儒","pinyin":"fán shū gāng rú","abbr":"fskr","explanation":"焚毁典籍，坑杀书生。同“焚书坑儒”。","source":{"text":"昭王曾孙政并六国，称皇帝，负怙威，燔书阬儒，自任私智。","book":"《汉书·地理志下》"}},{"id":30650,"word":"燕侣莺俦","pinyin":"yàn lǚ yīng chóu","abbr":"ylyc","explanation":"比喻年轻的女伴。也比喻相爱的青年男女。","source":{"text":"结凤世鸾交凤友，尽今生燕侣莺俦。","book":"元·徐琰《青楼十咏·小酌》"},"example":{"text":"大媒又借重了过老先生，内里有的是香闺绣阁，何不与舍侄女竟成了～，便完了一件百年的大事？","book":"《好逑传》第一六回"},"similar":["燕俦莺侣"],"usage":"作宾语；比喻相爱的青年男女"},{"id":30651,"word":"燕俦莺侣","pinyin":"yàn chóu yīng lǚ","abbr":"ycyl","explanation":"比喻年轻的女伴。也比喻相爱的青年男女。同“燕侣莺俦”。","source":{"text":"黄梅雨，燕俦莺侣，那解芳心苦。","book":"元·胡祗遹《点绛辰·赠妓》词"},"similar":["燕侣莺俦"],"usage":"作宾语；比喻相爱的青年男女"},{"id":30652,"word":"燕啄皇孙","pinyin":"yàn zhuó huáng sūn","abbr":"yzhs","explanation":"指汉代赵飞燕姊妹阴谋毒害皇孙的典故。后指后妃谋害皇子。","source":{"text":"燕啄皇孙，知汉祚之将尽。","book":"唐·骆宾王《为徐敬业讨武曌檄》"},"example":{"text":"唐·骆宾王《代李敬业以武后临朝移诸郡县檄》：“～，知汉祚之将尽。”"},"usage":"作宾语、定语；用于书面语"},{"id":30653,"word":"燕处危巢","pinyin":"yàn chǔ wēi cháo","abbr":"ycwc","explanation":"燕子处在焚烧着的窝里。比喻处境非常危险。","source":{"text":"怕只怕临安颓厦如燕处危巢。","book":"清·筱波山人《爱国魂·勤王》"},"example":{"text":"傀儡儿一场热闹，依旧的鱼游沸釜，～。","book":"清·南荃外史《叹老》"},"similar":["燕处焚巢"],"usage":"作宾语、定语；用于比喻句"},{"id":30654,"word":"燕处焚巢","pinyin":"yàn chǔ fén cháo","abbr":"ycfc","explanation":"燕子处在焚烧着的窝里。比喻处境非常危险。","source":{"text":"夫鱼游釜底，燕处焚巢，旦夕偷生，不自知其频于外殆，我同胞其何以异是耶？","book":"清·秋瑾《普告同胞檄稿》"},"similar":["燕处危巢"],"usage":"作宾语、定语；用于比喻句"},{"id":30655,"word":"燕妒花惭","pinyin":"yàn dù huā cán","abbr":"ydhc","explanation":"形容女子貌美，使燕子忌妒，使花儿感到羞愧。","source":{"text":"更兼这些人打扮的桃羞杏让，燕妒莺惭，一时也道不尽。","book":"清·曹雪芹《红楼梦》第二十七回"}},{"id":30656,"word":"燕妒莺惭","pinyin":"yàn dù yīng cán","abbr":"ydyc","explanation":"形容女子貌美，燕见之生妒，莺对之自惭。","source":{"text":"满园里秀带飘飘摇，花枝招展，更兼这些人打扮的桃羞杏让，燕妒莺惭，一时也道不尽。","book":"《红楼梦》第二七回"},"similar":["沉鱼落雁"],"usage":"作定语、状语；用于女性"},{"id":30657,"word":"燕婉之欢","pinyin":"yàn wǎn zhī huān","abbr":"ywzh","explanation":"燕婉：和爱。比喻夫妻和谐欢乐。","source":{"text":"秦晋同盟，成两姓绸缪之好；朱陈媲美，缔百年燕婉之欢。","book":"清·钱彩《说岳全传》第五十一回"},"usage":"作宾语；多用于夫妻之情"},{"id":30658,"word":"燕子衔食","pinyin":"yàn zǐ xián shí","abbr":"yzxs","explanation":"比喻育子之艰辛。","source":{"text":"且休说怀耽十月，只从小偎干就湿，儿口气抬举他偌大，恰便似燕子衔食。","book":"元·无名氏《冻苏秦》第二折"},"example":{"text":"～：凡母自言育子之苦，往往有此语。","book":"孙锦标《通俗常言疏证·家族》"},"usage":"作宾语、定语；多用于比喻句"},{"id":30659,"word":"燕安酖毒","pinyin":"yàn ān dān dú","abbr":"yadd","explanation":"指沉溺于安逸享乐，犹如饮毒酒自杀。"},{"id":30660,"word":"燕安醙毒","pinyin":"yàn ān dān dú","abbr":"yadd","explanation":"指沉溺于安逸享乐，犹如饮毒酒自杀。"},{"id":30661,"word":"燕安鸩毒","pinyin":"yàn ān zhèn dú","abbr":"yazd","explanation":"指贪图安逸享乐等于饮毒酒自杀。同“燕安酖毒”。","source":{"text":"今不幸建康则宿弊不可革，人心不可回，王业不可成，且秦桧二十年在临安为燕安鸩毒之计，岂可不舍去之而新是图。","book":"宋·朱熹《少师保信军节度使魏国公张公行状》下"},"example":{"text":"凡土木之劳，声色之好，～之戒，皆宜痛勇改。","book":"《元史·张桢传》"},"similar":["宴安鸩毒"],"usage":"作宾语、定语；用于书面语"},{"id":30662,"word":"燕尔新婚","pinyin":"yàn ěr xīn hūn","abbr":"yexh","explanation":"原为弃妇诉说原夫再娶与新欢作乐，后反其意，用作庆贺新婚之辞。形容新婚时的欢乐。","source":{"text":"状元下马就亲，洞房花烛，燕尔新婚。","book":"元·关汉卿《裴度还带》第四折"},"example":{"text":"只是～，如何舍得。","book":"清·孔尚任《桃花扇·辞院》"},"similar":["新婚燕尔"],"usage":"作谓语、宾语；用作庆贺新婚之辞"},{"id":30663,"word":"燕居深念","pinyin":"yàn jū shēn niàn","abbr":"yjsn","explanation":"燕居：闲居。闲居在家，对往事产生深深的怀念之情。","source":{"text":"右丞相陈平患之，力不能争，恐祸及己，常燕居深念。","book":"《论语·述尔》：“子之燕居，申申如也，夭夭如也。”《史记·郦生陆贾列传》"},"example":{"text":"尝～，陆贾往，直入坐，而陈丞相不见。","book":"《资治通鉴·汉纪·高皇后七年》"}},{"id":30664,"word":"燕岱之石","pinyin":"yān dài zhī shí","abbr":"ydzs","explanation":"比喻庸才下品。","source":{"text":"谬以商丘之木，遂比舟楫之材；燕岱之石，混同瑚琏之器。","book":"隋·江总《让尚书令表》"},"opposite":["瑚琏之器"],"usage":"作宾语；用于比喻句"},{"id":30665,"word":"燕巢于幕","pinyin":"yàn cháo yú mù","abbr":"ycym","explanation":"燕子把窝做在帐幕上。比喻处境非常危险。","source":{"text":"夫子之在此也，犹燕之巢于幕上。","book":"先秦·左丘明《左传·襄公二十九年》"},"example":{"text":"君之计，所谓～，不谋朝夕者也。","book":"清·蒲松龄《聊斋志异·邵女》"},"similar":["燕巢幕上","燕巢飞幕","燕巢危幕"],"usage":"作谓语、宾语；指处境非常危险"},{"id":30666,"word":"燕巢卫幕","pinyin":"yàn cháo wèi mù","abbr":"ycwm","explanation":"比喻处境非常危险。","source":{"text":"卫孙文子得罪于献公，居戚。公卒未葬，文子击钟焉。延陵季子适晋过戚，闻之曰：‘异哉！夫子之在此，犹燕子巢于幕也，惧犹未也，又何乐焉？君又在殡，可乎？’","book":"《孔子家语·正论》"},"example":{"text":"《旧唐书·李密传》：“～，鱼游宋池，殄灭之期，匪朝伊暮。”"},"usage":"作宾语、定语；用于比喻句","story":["春秋时期，卫国孙文子因事得罪于晋献公，他隐居在靠近晋国的戚地。晋献公去世还没下葬，文子就开始敲钟取乐。刚好延陵季子到晋国去奔丧，路过戚地，知道后就说：“异哉！夫子之在此，犹燕子巢于幕也，惧忧未也，又何乐焉？君又在殡，可乎？”"]},{"id":30667,"word":"燕巢危幕","pinyin":"yàn cháo wēi mù","abbr":"ycwm","explanation":"燕子把窝做在帷幕上。比喻处境非常危险。","source":{"text":"夫子之在此也，犹燕之巢于幕上。","book":"《左传·襄公二十九年》"},"example":{"text":"不知怎地我忽而记起了“～”的故事，看到这一大堆人物，不禁为之凄然。","book":"鲁迅《两地书》九五"},"similar":["燕巢飞幕","燕巢于幕","燕巢幕上"],"usage":"作宾语、定语；指处境非常危险"},{"id":30668,"word":"燕巢幕上","pinyin":"yàn cháo mù shàng","abbr":"ycms","explanation":"燕子把窝做在帷幕上。比喻处境非常危险。","source":{"text":"夫子之在此也，犹燕之巢于幕上。","book":"春秋·鲁·左丘明《左传·襄公二十九年》"},"example":{"text":"譬如～，怎能久安？","book":"蔡东藩《唐史演义》第53回"},"similar":["燕巢飞幕","燕巢危幕"],"usage":"作宾语、定语；指处境非常危险"},{"id":30669,"word":"燕巢幙上","pinyin":"yàn cháo yú shàng","abbr":"ycms","explanation":"燕子把窝做在帐幕上。比喻处境非常危险。同“燕巢于幕”。幙，同“幕”。"},{"id":30670,"word":"燕巢飞幕","pinyin":"yàn cháo fēi mù","abbr":"ycfm","explanation":"燕子把窝做在帐幕上。比喻处境非常危险。同“燕巢于幕”。","source":{"text":"鱼游沸鼎，燕巢飞幕，言危之甚。言魏朝夕将破，而将军居之，亦同鱼燕之危。","book":"《文选·丘迟〈与陈伯之收〉》：：“[北虏]方当系颈蛮邸，悬首藁街，而将军鱼游于沸鼎之中，燕巢于飞幕之上，不亦惑乎！”吕延济注"},"similar":["燕巢幕上","燕巢危幕","燕巢于幕"],"usage":"作宾语、定语；指处境非常危险"},{"id":30671,"word":"燕市悲歌","pinyin":"yān shì bēi gē","abbr":"ysbg","explanation":"以之表现朋友间的情谊以及惜别的情怀。","source":{"text":"荆轲既至燕，爱燕之狗屠及善击筑者高渐离。荆轲嗜酒，日与狗屠及高渐离饮于燕市，酒酣以往，高渐离击筑，荆轲和而歌于市中，相乐也，已而相泣，旁若无人者。","book":"《史记·刺客列传》"},"example":{"text":"唐·李涉《送魏简能东游》：“～又送君，目随征雁过寒云。”"},"usage":"作宾语、定语；用于书面语","story":["战国时期，荆轲到了燕国，喜欢燕国的狗屠及善于击筑的高渐离。荆轲喜欢喝酒，经常与狗屠及高渐离在街上喝酒，喝得高兴时，高渐离击筑，荆轲根据音乐而歌唱，十分快乐。有时唱到伤心处，于是大声哭泣，旁若无人"]},{"id":30672,"word":"燕幕自安","pinyin":"yàn mù zì ān","abbr":"ymza","explanation":"比喻处危境而不自知。","source":{"text":"[太平军]特于郡城北门外沿江一带建筑炮台数座，城上排列大炮，尚欲逞螳臂之力，燕幕自安。","book":"清·柯超《辛壬琐记》"},"usage":"作宾语、定语；用于书面语"},{"id":30673,"word":"燕昭好马","pinyin":"yān zhāo hǎo mǎ","abbr":"yzhm","explanation":"燕昭王喜爱骏马。后作求贤之典。","source":{"text":"燕昭好马，则骏马来庭；叶公好龙，则真龙入室。","book":"《旧唐书·薛登传》"},"similar":["燕昭市骏","燕骏千金"],"usage":"作宾语、定语；用于书面语","story":["战国时期，燕昭王即位后为了强国急于招揽人才，郭隗以马为喻，说古代君王悬赏千金买千里马，三年后得一死马，用五百金买下马骨，于是不到一年就得到三匹千里马。借此劝说燕昭王若能真心求贤，贤士就会闻风而至"]},{"id":30674,"word":"燕昭市骏","pinyin":"yān zhāo shì jùn","abbr":"yzsj","explanation":"指战国时郭隗以古代君王悬赏千金买千里马为喻，劝说燕昭王真心求贤的事。","source":{"text":"家僮愕视欲先鞭，枥马惊嘶还屡顾。始知物妙皆可怜，燕昭市骏岂徒然。","book":"唐·高適《同鲜于洛阳于毕员外宅观画马歌》"},"similar":["燕昭好马","燕骏千金"],"usage":"作宾语、定语；用于书面语","story":["战国时期，燕昭王即位后为了强国急于招揽人才，郭隗以马为喻，说古代君王悬赏千金买千里马，三年后得一死马，用五百金买下马骨，于是不到一年就得到三匹千里马。借此劝说燕昭王若能真心求贤，贤士就会闻风而至"]},{"id":30675,"word":"燕歌赵舞","pinyin":"yān gē zhào wǔ","abbr":"ygzw","explanation":"①古燕赵人善歌舞，泛指美妙的歌舞。②用以形容文辞美妙。","source":{"text":"罗襦宝带为君解，燕歌赵舞为君开。","book":"唐·卢照邻《长安古意》诗"},"example":{"text":"开元中，说与徐坚论近世文章，说曰：‘……净朝隐如丽服靓妆，～，观者忘疲，若类之《风》《雅》，则罪人矣。’","book":"《新唐书·文艺传上·骆宾王》"},"usage":"作宾语、定语；多用于比喻句"},{"id":30676,"word":"燕燕于归","pinyin":"yàn yàn yú guī","abbr":"yyyg","explanation":"指女子出嫁。","source":{"text":"燕燕于飞，差池其羽。之子于归，远送于野。","book":"语出《诗·邶风·燕燕》"},"example":{"text":"明·阮大铖《燕子笺·写笺》：“若不是～，怎使没分毫腼腆！”"},"usage":"作宾语、定语；用于书面语"},{"id":30677,"word":"燕燕居息","pinyin":"yàn yàn jū xī","abbr":"yyjx","explanation":"燕燕：通“宴宴”，安息的样子；居息：闲居休息。在家里安然休息，无所事事。","source":{"text":"或燕燕居息，或尽瘁事国。","book":"《麻经·小雅·北山》"}},{"id":30678,"word":"燕燕莺莺","pinyin":"yàn yàn yīng yīng","abbr":"yyyy","explanation":"比喻娇妻美妾或年轻女子。","source":{"text":"海棠一株春一国，燕燕莺莺作寒食。","book":"金·元好问《题商孟卿家明皇合曲图》诗"},"example":{"text":"南方人也可怜北方人太简单了，便送上许多文章……什么‘噫嘻卿卿我我’‘呜呼～’‘呈嗟风风雨雨’。","book":"鲁迅《热风·随感录六十四》"},"usage":"作宾语、定语；用于书面语"},{"id":30679,"word":"燕瘦环肥","pinyin":"yàn shòu huán féi","abbr":"yshf","explanation":"形容女子体态不同，各有各好看的地方。","source":{"text":"杜陵评书贵瘦硬，此论未公吾不凭。短长肥瘦各有态，玉环飞燕谁敢憎。","book":"宋·苏轼《孙莘老求墨妙亭诗》"},"example":{"text":"有的妆台倚镜，有的翠袖凭栏，说不尽～，一一都收在眼睛里去。","book":"清·李宝嘉《文明小史》第四十回"},"similar":["环肥燕瘦","各有所长"],"usage":"作定语；指风格不同"},{"id":30680,"word":"燕石妄珍","pinyin":"yān shí wàng zhēn","abbr":"yswz","explanation":"妄视无用之物为珍宝。","source":{"text":"若愚智毕载，妍媸靡择，此则燕石妄珍，齐竽混吹者矣！","book":"唐·刘知幾《史通·人物》"},"usage":"作宾语、定语；用于处事"},{"id":30681,"word":"燕约莺期","pinyin":"yàn yuē yīng qī","abbr":"yyyq","explanation":"比喻相爱的男女约会的时日。","source":{"text":"等、等、等，则待要喜孜孜赴燕约莺期。","book":"元·昊昌龄《张天师》第二折"},"example":{"text":"明·顾大典《青衫记·访兴不遇》：“恨纵横豺虎如麻，把～勾罢。”"},"usage":"作宾语、定语；用于书面语"},{"id":30682,"word":"燕翼之谋","pinyin":"yàn yì zhī móu","abbr":"yyzm","explanation":"燕：安；翼：敬。原指周武王谋及其孙而安抚其子。后泛指为后代作好打算。","source":{"text":"武王岂不仕，诒厥孙谋，以燕翼子。","book":"《诗经·大雅·文王有声》"},"example":{"text":"协赞龙飞之运，永诒～。","book":"《元史·后妃传》"}},{"id":30683,"word":"燕翼子孙","pinyin":"yàn yì zǐ sūn","abbr":"yyzs","explanation":"燕：安；翼：敬。原指周武王谋及其孙而安抚其子。后泛指为后代作好打算。","source":{"text":"武王岂不仕，诒厥孙谋，以燕翼子。","book":"《诗经·大雅·文王有声》"},"example":{"text":"正襟湛思旧恩泽，～今可取。","book":"季惟斋《游孙仲谋故里》"},"similar":["燕翼诒孙"],"usage":"作谓语、定语；用于书面语"},{"id":30684,"word":"燕翼诒孙","pinyin":"yàn yì yí sūn","abbr":"yyys","explanation":"燕：安；翼：敬；诒：遗留。原指周武王谋及其孙而安抚其子。后泛指为后代作好打算。","source":{"text":"武王岂不仕，诒厥孙谋，以燕翼子。","book":"《诗经·大雅·文王有声》"},"similar":["燕翼子孙"],"usage":"作谓语、定语；用于书面语"},{"id":30685,"word":"燕翼贻孙","pinyin":"yàn yì yí sūn","abbr":"yyys","explanation":"燕：安；翼：敬；贻：遗留。原指周武王谋及其孙而安抚其子。后泛指为后代作好打算。","source":{"text":"武王岂不仕，诒厥孙谋，以燕翼子。","book":"《诗经·大雅·文王有声》"},"example":{"text":"肃肃艺祖，肇基鸿源。权舆光大，～。","book":"《宋史·乐志九》"}},{"id":30686,"word":"燕翼贻谋","pinyin":"yàn yì yí móu","abbr":"yyym","explanation":"燕：安；翼：敬；贻：遗留。原指周武王谋及其孙而安抚其子。后泛指为后嗣作好打算。","source":{"text":"武王岂不仕，诒厥孙谋，以燕翼子。","book":"《诗经·大雅·文王有声》"},"example":{"text":"权舆光大，～。","book":"《宋史·乐志九》"},"usage":"作谓语、定语；用于书面语"},{"id":30687,"word":"燕舞莺啼","pinyin":"yàn wǔ yīng tí","abbr":"ywyt","explanation":"莺：黄鹂。燕子在飞舞，黄莺在鸣叫。形容春光明媚。","source":{"text":"此时正值暮春天气，只见一路上有的是红桃绿柳，燕舞莺啼。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"example":{"text":"明·冯梦龙《醒世恒言》第25卷：“此时正值暮春天气，只见一路上有的是红桃绿柳，～。”"},"similar":["燕舞莺歌","莺歌燕舞"],"usage":"作谓语、定语；形容形势"},{"id":30688,"word":"燕舞莺歌","pinyin":"yàn wǔ yīng gē","abbr":"ywyg","explanation":"燕子在飞舞，黄莺在鸣叫。形容春光明媚。同“燕舞莺啼”。","source":{"text":"燕舞莺歌昼晷永，帘幕无人门宇静。","book":"宋·朱淑真《春日行》"},"similar":["燕舞莺啼","莺歌燕舞"],"usage":"作谓语、定语；形容形势"},{"id":30689,"word":"燕蝠之争","pinyin":"yàn fú zhī zhēng","abbr":"yfzz","explanation":"燕子和蝙蝠争论何为晨昏。比喻无意义的争吵。","source":{"text":"燕以日出为旦，日入为夕。蝙蝠以日入为旦，日出为夕。争之不决。","book":"宋·朋万九《东坡乌台诗案·寄周邠诸诗》载"},"example":{"text":"左右蜗蛮战，晨昏燕蝠争。","book":"宋·薛季宣《游竹陵善权涧》"}},{"id":30690,"word":"燕语莺呼","pinyin":"yàn yǔ yīng hū","abbr":"yyyh","explanation":"莺：黄鹂。燕子的话语，黄鹂的歌声。形容春天里大好的景象。也比喻女子说话声音婉转动听。","source":{"text":"狂蜂浪蝶檐外舞，绿杨堤燕语莺呼。","book":"元·无名氏《浣花溪》第三折"},"similar":["燕语莺啼"],"usage":"作宾语、定语；形容大好春光"},{"id":30691,"word":"燕语莺啼","pinyin":"yàn yǔ yīng tí","abbr":"yyyt","explanation":"莺：黄鹂。燕子的话语，黄鹂的歌声。形容大好春光。","source":{"text":"莺啼燕语报新年，马邑龙堆路几千？","book":"唐·皇甫冉《春思》诗"},"example":{"text":"绿树春深，～声断续，蕙风飘荡入芳从丛。","book":"五代蜀·毛文锡《酒泉子》词"},"similar":["燕语莺呼"],"usage":"作宾语、定语；形容大好春光"},{"id":30692,"word":"燕语莺声","pinyin":"yàn yǔ yīng shēng","abbr":"yyys","explanation":"莺：黄鹂。燕子的话语，黄鹂的歌声。原形容大好春光。后多形容年轻女子说笑的声音。","source":{"text":"袅娜复轻盈，都是宜描上翠屏，语若流莺声似燕，丹青，燕语莺声怎画成？","book":"元·关汉卿《金线池》楔子"},"example":{"text":"乡音入耳，已是关心；更兼那～，勾魂摄魄。","book":"清·彭养鸥《黑籍冤魂》第15回"},"similar":["鸟语花香","燕语莺啼"],"opposite":["龙吟虎啸"],"usage":"作谓语、定语、补语；用于女性"},{"id":30693,"word":"燕足系诗","pinyin":"yàn zú jì shī","abbr":"yzxs","explanation":"系诗于雁足，靠它传递消息。","source":{"text":"五代·王仁裕《开元天宝遗事·传书雁》"},"usage":"作宾语、定语；用于书面语","story":["唐朝时期，任宗远赴湘中经商，长时间没有回家。他妻子郭绍兰看见堂屋前双飞的燕子，就吟诵：“尔海东来，必经湘中……欲凭尔附书，投于我婿。”于是在燕腿上系上一首诗，燕子飞到荆州任宗住所，任宗遂收到妻子的赠诗"]},{"id":30694,"word":"燕跃鹄踊","pinyin":"yàn yuè hú yǒng","abbr":"yyhy","explanation":"形容迅捷威猛。","source":{"text":"[古冶子]左手持鼋头，右手挟左骖，燕跃鹄踊而出。仰天大呼，水为逆流三百步。","book":"晋·干宝《搜神记》卷十一"},"usage":"作定语、状语；用于书面语"},{"id":30695,"word":"燕金募秀","pinyin":"yān jīn mù xiù","abbr":"yjmx","explanation":"相传战国时燕昭王筑黄金台以接待天下贤士。后以之为招纳贤士之典。","source":{"text":"伏遇留守侍郎燕金募秀，蔡屣延才，铎宣百世之文，旌集四方之善。","book":"宋·范仲淹《上张侍郎启》"},"usage":"作宾语、定语；用于处事等"},{"id":30696,"word":"燕雀不知鸿鹄志","pinyin":"yàn què bù zhī hóng hú zhì","abbr":"yqazhhz","explanation":"鸿鹄：指天鹅。燕子与麻雀不知道天鹅的志向。比喻平凡的人不知道英雄人物的志向。","source":{"text":"嗟呼，燕雀安知鸿鹄之志哉？","book":"《史记·陈涉世家》"},"similar":["燕雀安知鸿鹄之志"],"usage":"作宾语、分句；用于劝诫人"},{"id":30697,"word":"燕雀之居","pinyin":"yàn què zhī jū","abbr":"yqzj","explanation":"比喻简陋的庐舍。","source":{"text":"蒙还燕雀之居，当尽犬鹰之力。兹且相别，后或再逢。","book":"明·陈汝元《金莲记·焚券》"},"usage":"作宾语；用于比喻句"},{"id":30698,"word":"燕雀之见","pinyin":"yàn què zhī jiàn","abbr":"yqzj","explanation":"比喻浅薄的见识。","source":{"text":"[翁]乃欲为鸿飞之冥冥，于人世已不复置其一喙，而吾犹呶呶焉为之悲怜其遇，其犹燕雀之见也夫！","book":"清·戴名世《朱翁诗序》"},"usage":"作主语、宾语；用于比喻句"},{"id":30699,"word":"燕雀乌鹊","pinyin":"yàn què wū què","abbr":"yqwq","explanation":"比喻谗佞小人。","source":{"text":"燕雀乌鹊巢堂坛兮。","book":"战国·楚·屈原《楚辞·屈原·涉江》"},"usage":"作主语、宾语、定语；指谗佞小人"},{"id":30700,"word":"燕雀处堂","pinyin":"yàn què chǔ táng","abbr":"yqct","explanation":"处：居住；堂：堂屋。燕雀住在堂上。比喻生活安定而失去警惕性。也比喻大祸临头而自己不知道。","source":{"text":"燕雀处屋，子母安哺，煦煦焉其相乐也，自以为安矣；灶突炎上，栋宇将焚，燕雀颜色不变，不知祸之将及也。","book":"《孔丛子·论势》"},"example":{"text":"瓜分之惨酷，言之者多，而真忧之者少，人情蔽于所不见，～，自以为乐也。","book":"清·梁启超《新中国未来记》第四回"},"similar":["燕雀处屋"],"usage":"作谓语、定语；指不知大祸临头","story":["战国后期，秦国攻打赵国，赵国的近邻魏国却见死不救，认为这对魏国有利，魏国相国子顺可不这样认为。他认为秦国势力强大，侵略成性，魏国不能像房梁下的燕雀那样过着安逸的生活，因为房屋发生了火灾，燕雀就没有栖身之处了"]},{"id":30701,"word":"燕雀处屋","pinyin":"yàn què chǔ wū","abbr":"yqcw","explanation":"比喻生活安定而失去警惕性。也比喻大祸临头而自己不知道。同“燕雀处堂”。","source":{"text":"燕雀处屋，子母相哺，煦煦焉其相乐也，自以为安矣；灶突决上，栋宇将焚，燕雀颜色不变，不知祸之将及己也。","book":"汉·孔鲋《孔丛子·论势》"},"example":{"text":"～的危险应该考虑。"},"similar":["燕雀处堂"],"usage":"作谓语、定语；指不知处境危险","story":["战国后期，秦国攻打赵国，赵国的近邻魏国却见死不救，认为这对魏国有利，魏国相国子顺可不这样认为。他认为秦国势力强大，侵略成性，魏国不能像房梁下的燕雀那样过着安逸的生活，因为房屋发生了火灾，燕雀就没有栖身之处了"]},{"id":30702,"word":"燕雀处帷幄","pinyin":"yàn què chǔ wéi wò","abbr":"yqcww","explanation":"比喻战争的时间很长，军帐上都筑起了鸟巢。","source":{"text":"甲胄生虮虱，燕雀处帷幄。","book":"《韩非子·喻老》"}},{"id":30703,"word":"燕雀安知鸿鹄之志","pinyin":"yàn què ān zhī hóng hú zhī zhì","abbr":"yqazhhzz","explanation":"比喻平凡的人哪里知道英雄人物的志向。","source":{"text":"嗟呼，燕雀安知鸿鹄之志哉？","book":"西汉·司马迁《史记·陈涉世家》"},"example":{"text":"～？汝既拿住我，便当解去请赏，何必多问。","book":"明·罗贯中《三国演义》第四回"},"similar":["燕雀不知鸿鹄志"],"usage":"作宾语、分句；用于劝诫人"},{"id":30704,"word":"燕雀安知鸿鹄志","pinyin":"yàn què ān zhī hóng hú zhì","abbr":"yqazhhz","explanation":"鸿鹄：天鹅。比喻庸俗的人不能理解志向远大者的抱负。","source":{"text":"嗟呼，燕雀安知鸿鹄之志哉！","book":"西汉·司马迁《史记·陈涉世家》"},"example":{"text":"～？汝既拿住我，便当解去请赏，何必多问！","book":"明·罗贯中《三国演义》第四回"},"similar":["燕雀安知鸿鹄之志"],"usage":"作宾语、分句；用于劝诫人"},{"id":30705,"word":"燕雀岂知雕鹗志","pinyin":"yàn què qǐ zhī diāo è zhì","abbr":"yqqzdez","explanation":"比喻平凡的人哪里知道英雄人物的志向。同“燕雀安知鸿鹄志”。","source":{"text":"燕雀岂知雕鹗志，顽童不解老仙机。","book":"元·无名氏《玩江亭》第二折"},"similar":["燕雀安知鸿鹄之志"],"usage":"作宾语、定语；用于书面语"},{"id":30706,"word":"燕雀岂知鸿鹄之志","pinyin":"yàn què qǐ zhī hóng hú zhī zhì","abbr":"yqqzhgzz","explanation":"鸿鹄：指天鹅。燕子与麻雀怎能知道天鹅的志向。比喻平凡的人不知道英雄人物的志向。","source":{"text":"嗟呼，燕雀安知鸿鹄之志哉？","book":"《史记·陈涉世家》"},"example":{"text":"肉眼愚民，不识高贤，正所谓～，无足怪也。","book":"元·无名氏《冻苏秦》第一折"}},{"id":30707,"word":"燕雀相贺","pinyin":"yàn què xiāng hè","abbr":"yqxh","explanation":"燕雀因大厦落成有栖身之所而互相庆贺。后多用作祝贺新屋落成之语。","source":{"text":"汤沐具而虮虱相吊，大厦成而燕雀相贺，忧乐别也。","book":"西汉·刘安《淮南子·说林训》"},"example":{"text":"应声答曰：‘且得～。’","book":"《北齐书·卢询祖传》"},"usage":"作谓语；多用作祝贺新屋落成之语"},{"id":30708,"word":"燕雁代飞","pinyin":"yàn yàn dài fēi","abbr":"yydf","explanation":"燕夏天来温带，冬天归南方；雁冬天来温带，夏天归南方。比喻各自一方，不能相见。","source":{"text":"磁石上飞，云母来水，土龙致雨，燕雁代飞。","book":"西汉·刘安《淮南子·地形训》"},"usage":"作谓语；比喻各自一方，不能相见"},{"id":30709,"word":"燕颔书生","pinyin":"yàn hàn shū shēng","abbr":"yhss","explanation":"有封侯之相的读书人。亦用以称美志在建立军功的士人。同“燕颔儒生”。"},{"id":30710,"word":"燕颔儒生","pinyin":"yàn hàn rú shēng","abbr":"yhrs","explanation":"有封侯之相的读书人。亦用以称美志在建立军功的士人。"},{"id":30711,"word":"燕颔虎头","pinyin":"yàn hàn hǔ tóu","abbr":"yhht","explanation":"形容相貌威武。借指武将、勇士。","source":{"text":"轩轩云霞气色，凛凛霜雪威棱。熊腰虎背势嶙纈，燕颔虎头雄俊。","book":"清·褚人获《隋唐演义》第四回"},"example":{"text":"宋·孙光宪《北梦琐言》第14卷：“遽以褒义博带，令押～，适足以取笑耳。”"},"similar":["燕颔虎颈","虎头燕颔"],"usage":"作谓语、定语；形容相貌威武"},{"id":30712,"word":"燕颔虎须","pinyin":"yàn hàn hǔ xū","abbr":"yhhx","explanation":"形容相貌威武。","source":{"text":"玄德回视其人：身长八尺，豹头环眼，燕颔虎须，声若巨雷，势如奔马。","book":"《三国演义》第一回"},"example":{"text":"那官人生的豹头环眼，～，八尺长短身材，三十四五年纪。","book":"《水浒传》第七回"},"similar":["燕颔虬须"],"usage":"作宾语、状语；用于书面语"},{"id":30713,"word":"燕颔虎颈","pinyin":"yàn hàn hǔ jǐng","abbr":"yhhj","explanation":"颔：下巴颏。旧时形容王侯的贵相或武将相貌的威武。","source":{"text":"超问其状，相者指曰：‘生燕颔虎颈，飞而食肉，此万里侯相也。’","book":"《后汉书·班超传》"},"similar":["燕颔虎头","虎头燕颔"],"usage":"作谓语、定语；形容相貌威武"},{"id":30714,"word":"燕颔虬须","pinyin":"yàn hàn qiú xū","abbr":"yhqx","explanation":"形容相貌威武。借指武将、勇士。同“燕颔虎头”。","source":{"text":"江南别有楼船将，燕颔虬须不姓扬。","book":"唐·白居易《赠李兵马使》诗"},"similar":["燕颔虎须"],"usage":"作宾语、状语；用于书面语"},{"id":30715,"word":"燕额虎头","pinyin":"yàn é hǔ tóu","abbr":"yeht","explanation":"形容相貌威武。借指武将、勇士。同“燕颔虎头”。"},{"id":30716,"word":"燕驾越毂","pinyin":"yān jià yuè gū","abbr":"yjyg","explanation":"燕地的车越地的毂。指把不同的东西混在一起。","source":{"text":"广土众民，君子所欲。老丈得之，其与世俗吏传舍一官者，必有如燕驾越毂，不可同年而语。","book":"明·高攀龙《寄瞿洞观书》之二"},"usage":"作宾语、定语；多用于比喻句"},{"id":30717,"word":"燕骏千金","pinyin":"yān jùn qiān jīn","abbr":"yjqj","explanation":"后以之为招纳贤士之典。","source":{"text":"战国时，燕昭王即位后急于招揽人才。郭隗以马为喻，说古代君王悬赏千金卖千里马，三年后得一死马，用五百金买下马骨，于是不到一年，得到三匹千里马，劝说燕昭王若能真心求贤，贤士将闻风而至。见《战国策·燕策一》。"},"similar":["燕昭好马","燕昭市骏"],"usage":"作宾语、定语；用于书面语","story":["战国时期，燕昭王即位后为了强国急于招揽人才，郭隗以马为喻，说古代君王悬赏千金买千里马，三年后得一死马，用五百金买下马骨，于是不到一年就得到三匹千里马。借此劝说燕昭王若能真心求贤，贤士就会闻风而至"]},{"id":30718,"word":"燕麦兔葵","pinyin":"yàn mài tǔ kuí","abbr":"ymtk","explanation":"形容杂草丛生的荒凉景象。","source":{"text":"重游玄都，荡然无复一树，唯有兔葵燕麦动摇于春风耳。","book":"唐·刘禹锡《再游玄都观》序"},"example":{"text":"～恨，倩谁访、画阑红药。","book":"宋·周密《大酺·春阴怀旧》"},"similar":["兔葵燕麦"],"usage":"作宾语、定语；用于书面语"},{"id":30719,"word":"燥荻枯柴","pinyin":"zào dí kū chái","abbr":"zdkc","explanation":"荻：荻草，似芦苇。干燥的荻草，干枯的柴木。指易燃之物","source":{"text":"乃取蒙冲半舰十艘，载燥荻枯柴，灌油其中，裹以帷幕，上建旌旗，豫备走舸，系于其尾。","book":"宋·司马光《资治通鉴·汉纪·献帝建安13年》"},"usage":"作宾语、定语；用于书面语"},{"id":30720,"word":"燮和之任","pinyin":"xié hé zhī rèn","abbr":"xhzr","explanation":"燮和：调和。比喻宰相之职，以宰相的职责在协调国家上下。","source":{"text":"燮和天下，用答扬文武之光训。","book":"《尚书·顾命》"},"example":{"text":"岂意陛下擢臣于伤残之余，委臣以～。","book":"唐·韩愈《为裴相公让官表》"},"usage":"作宾语；用于书面语"},{"id":30721,"word":"燮和天下","pinyin":"xiè hé tiān xià","abbr":"xhtx","explanation":"燮和：协调，和顺。使国家协调和平。","source":{"text":"燮和天下，用答扬文武之光训。","book":"《尚书·顾命》"},"example":{"text":"其君临晋邦，奉系宗祀，允执其中，～。","book":"《晋书·恭帝纪》"},"similar":["燮和阴阳"],"usage":"作谓语、宾语；用于书面语"},{"id":30722,"word":"燮理阴阳","pinyin":"xiè lǐ yīn yáng","abbr":"xlyy","explanation":"燮：调和；理：治理。指大臣辅佐天子治理国事。","source":{"text":"立太师，太傅，太保。兹惟三公，论道经邦，燮理阴阳。","book":"《尚书·周官》"},"example":{"text":"则道你～，却惜玉怜香。","book":"元·马致远《陈抟高卧》第四折"},"usage":"作谓语；指大臣辅佐天子"},{"id":30723,"word":"爆跳如雷","pinyin":"bào tiào rú léi","abbr":"btrl","explanation":"指盛怒的样子。","source":{"text":"倒塔鬼爆跳如雷道：‘你只长他人志气，灭自己威风。’","book":"《何典》第十回"},"similar":["暴跳如雷"],"usage":"作定语、状语；指人的情绪"},{"id":30724,"word":"爨桂炊玉","pinyin":"cuàn guì chuī yù","abbr":"cgcy","explanation":"爨：炊。柴禾难得如桂木，米价贵得如珠玉。形容物价昂贵，生活艰难。","source":{"text":"月俸不及数万，爨桂炊玉，晦朔不相续。","book":"宋·司马光《答刘蒙书》"},"similar":["米珠薪桂","食玉炊桂"],"usage":"作宾语、定语；指生活昂贵"},{"id":30725,"word":"爪牙之士","pinyin":"zhǎo yá zhī shì","abbr":"zyzs","explanation":"爪牙：比喻辅佐的人。指勇敢的卫士或得力的助手。","source":{"text":"夫虽无四方之忧，然谋臣与爪牙之士，不可不养而择也。","book":"春秋·鲁·左丘明《国语·越语上》"},"example":{"text":"盖所以将腹心之命达于～也。","book":"唐·元稹《宋常春等内仆局令》"},"similar":["爪牙之将"],"usage":"作主语、宾语；指得力助手"},{"id":30726,"word":"爪牙之将","pinyin":"zhǎo yá zhī jiàng","abbr":"zyzj","explanation":"爪牙：比喻辅佐的人。指勇敢的卫士或得力的助手","source":{"text":"爪牙之将，用不拘资。","book":"清·魏源《圣武记》第11卷"},"similar":["爪牙之士"],"usage":"作主语、宾语；指得力助手"},{"id":30727,"word":"爬山涉水","pinyin":"pá shān shè shuǐ","abbr":"psss","explanation":"形容路途艰辛。","source":{"text":"一年多的时间里，周副主席白天和我们一样爬山涉水，栉风沐雨。","book":"范金标《怀念敬爱的周总理》"},"example":{"text":"我们一路～，终于到达了长城。"},"similar":["跋山涉水"],"opposite":["一帆风顺"],"usage":"作谓语、宾语、状语；用于翻山过海走长路"},{"id":30728,"word":"爬山越岭","pinyin":"pá shān yuè lǐng","abbr":"psyl","explanation":"越：过；岭：山岭。爬过高山，越过峻岭。形容野外工作或旅途的辛苦。","source":{"text":"吓得邓艾弃甲丢盔，撇了坐下马，杂在步军之中，爬山越岭而逃。","book":"明·罗贯中《三国演义》第114回"},"example":{"text":"明·罗贯中《三国演义》第114回：“吓得邓艾弃甲丢盔，撇了坐下马，杂在步军之中，爬山越岭而逃。”"},"similar":["翻山越岭"],"usage":"作谓语、定语、状语；形容长途跋涉的辛苦"},{"id":30729,"word":"爬梳剔抉","pinyin":"pá shū tī jué","abbr":"pstj","explanation":"指整理选择。","source":{"text":"建安布衣蔡元定著《律吕新书》，朱熹称其超然远览，奋其独见，爬梳剔抉，参互考寻。","book":"《宋史·律历志》"},"example":{"text":"这固然得费一番～的功夫。","book":"朱自清《语言志辨》序"},"similar":["爬罗剔抉","爬梳洗剔"],"usage":"作谓语、定语；指广泛搜罗、精细选择"},{"id":30730,"word":"爬梳洗剔","pinyin":"pá shū xǐ tī","abbr":"psxt","explanation":"搜罗发掘，挑拣选择。同“爬梳剔抉”。","source":{"text":"怡谷，学人也。宜其视此无难焉。爬梳洗剔，视元本不可以道里计。","book":"清·卢文弨《〈履斋示儿编〉跋》"},"similar":["爬梳剔抉"],"usage":"作谓语；指广泛地搜罗挑选"},{"id":30731,"word":"爬罗剔抉","pinyin":"pá luó tī jué","abbr":"pltj","explanation":"爬罗：搜集；剔抉：筛选。指广泛地搜罗，精细地选择。","source":{"text":"爬罗剔抉，刮垢磨光，盖有幸而获选，孰云多而不扬？","book":"唐·韩愈《进学解》"},"example":{"text":"这固然得费一番～的工夫。","book":"朱自清《诗言南辨·序》"},"similar":["精挑细选","杷罗剔抉"],"usage":"作谓语；指广泛地搜罗，精细地选择"},{"id":30732,"word":"爬耳搔腮","pinyin":"pá ěr sāo sāi","abbr":"pess","explanation":"指急切无奈的样子。","source":{"text":"这一段话，我是和不是东西之流开开玩笑的，要使他爬耳搔腮，热剌剌的觉得他的世界有些灰色。","book":"鲁迅《且介亭杂文二集·徐懋庸作〈打杂集〉序》"},"similar":["抓耳挠腮","扒耳搔腮"],"usage":"作定语、状语；指人的神态"},{"id":30733,"word":"爰亲作亲","pinyin":"yuán qīn zuò qīn","abbr":"yqzq","explanation":"爰：引。指男女双方由于平素两家的关系亲密而结成姻亲。","source":{"text":"他只因那三首诗投其所好，遂爰亲作亲，那里有一毫礼物？","book":"清·天花藏主人《玉支矶》第五回"},"example":{"text":"你我～，我不争你的财礼，你也不争我的装奁，只要做几件布草衣服。","book":"清·吴敬梓《儒林外史》第二十一回"}},{"id":30734,"word":"爱不忍释","pinyin":"ài bù rěn shì","abbr":"abrs","explanation":"释：放下。对所喜欢的物品，爱得拿在手里久久不肯放下。","source":{"text":"余爱嗜其文，不能释手。","book":"南朝·梁·萧统《陶渊明集序》"},"example":{"text":"得见钱唐陈小云司马《香畹楼忆语》钞本一种，～，亟问假归，手录展玩。","book":"清·王维鋆《香畹楼忆语序一》"},"similar":["爱不释手","如获至宝"],"opposite":["弃若敝屣","不屑一顾"],"usage":"作谓语、定语、状语；形容极其喜欢"},{"id":30735,"word":"爱不释手","pinyin":"ài bù shì shǒu","abbr":"abss","explanation":"释：放下。喜爱得舍不得放手。","source":{"text":"余爱嗜其文，不能释手。","book":"南朝·梁·萧统《陶渊明集序》"},"example":{"text":"虽是不合他的路数，可奈文有定评，他看了也知道～。","book":"清·文康《儿女英雄传》第三十五回"},"similar":["手不释卷","爱不忍释"],"opposite":["不屑一顾","弃若敝屣"],"usage":"作谓语、状语、宾语；表达喜欢物件"},{"id":30736,"word":"爱之如宝","pinyin":"ài zhī rú bǎo","abbr":"azrb","explanation":"形容十分喜欢。同“爱如珍宝”。","source":{"text":"夫人亡过，不曾生得子嗣，止遗下一个女儿……这水居一爱之如宝。","book":"清·名教中人《好逑传》第三回"}},{"id":30737,"word":"爱之必以其道","pinyin":"ài zhī bì yǐ qí dào","abbr":"azbyqd","explanation":"爱护人必须讲究方法。多指父母疼爱子女必须注意方法得当。","source":{"text":"余五十二岁始得一子，岂有不爱之理？然爱之必以其道，虽嬉戏玩耍，务令忠厚悱恻，毋为刻急也。","book":"清·郑燮《潍县署中与舍弟墨第二书》"}},{"id":30738,"word":"爱之欲其生","pinyin":"ài zhī yù qí shēng","abbr":"azyqs","explanation":"指喜欢一个人时总想叫他活着。指极度地凭个人爱憎对待人。","source":{"text":"爱之欲其生，恶之欲其死，既欲其生，又欲其死，是惑也。","book":"春秋·孔丘《论语·颜渊》"},"example":{"text":"‘～，恶之欲其死。’卿何不容一宦官耶？","book":"明·罗贯中《三国演义》第115回"},"opposite":["恶之欲其死"],"usage":"作宾语、分句；指人的爱憎"},{"id":30739,"word":"爱之欲其生，恶之欲其死","pinyin":"ài zhī yù qí shēng，wù zhī yù qí sǐ","abbr":"azyqsezyqs","explanation":"喜爱他时，总想叫他活着；讨厌他时，总想叫他死掉。指极度地凭个人爱憎对待人。","source":{"text":"爱之欲其生，恶之欲其死，既欲其生，又欲其死，是惑也。","book":"《论语·颜渊》"},"example":{"text":"“爱之欲其生，恶之欲其死。”卿何不容一宦官耶？","book":"明·罗贯中《三国演义》第一百一十五回"},"similar":["爱则加诸膝，恶则坠诸渊"],"usage":"作宾语、分句；指人的好恶"},{"id":30740,"word":"爱人以德","pinyin":"ài rén yǐ dé","abbr":"aryd","explanation":"爱人：爱护别人；德：德行。按照道德标准去爱护人。泛指对人不偏私偏爱，不姑息迁就。","source":{"text":"君子之爱人也以德，细人之爱人也以姑息。","book":"《礼记·檀弓上》"},"example":{"text":"轼闻琦语，曰：“公可谓～矣。”","book":"《宋史·苏轼传》"},"similar":["以德爱人"],"usage":"作谓语、定语；指以德爱人"},{"id":30741,"word":"爱人利物","pinyin":"ài rén lì wù","abbr":"arlw","explanation":"爱护人民，力求有利于人民。","source":{"text":"爱人利物之谓仁。","book":"《庄子·天地》"},"example":{"text":"而终归于禁暴戢乱、～而不可掩者，其本领宏大开阔故也。","book":"宋·陈亮《又乙巳春书之一（答朱熹）》"},"usage":"作谓语、宾语；指爱护人民"},{"id":30742,"word":"爱人好士","pinyin":"ài rén hào shì","abbr":"arhs","explanation":"爱护、重视人才。","source":{"text":"圣姿硕茂，神武在躬，仁覆积德，爱人好士，是以四方归心焉。","book":"晋·陈寿《三国志·蜀志·先主传》"},"example":{"text":"“战国四公子”之一的信陵君有“～”的美称。"},"similar":["爱才好士"],"usage":"作谓语、宾语、定语；指爱护人才"},{"id":30743,"word":"爱则加诸膝，恶则坠诸渊","pinyin":"ài zé jiā zhū xī，wù zé zhuì zhū yuān","abbr":"azjzxezzzy","explanation":"加诸膝：放在膝盖上；坠诸渊：推进深渊里。意指不讲原则，感情用事，对别人的爱憎态度，全凭自己的好恶来决定。","source":{"text":"今之君子，进人若将加诸膝，退人若将坠诸渊。","book":"西汉·戴圣《礼记·檀弓下》"},"example":{"text":"我们待人接物不能用～的态度。"},"similar":["爱之欲其生，恶之欲其死"],"usage":"作宾语、分句；指人凭自己喜好待人"},{"id":30744,"word":"爱别离苦","pinyin":"ài bié lí kǔ","abbr":"ablk","explanation":"佛家语，指亲爱的人离别的痛苦。","source":{"text":"问：‘如何是至极之谈？’曰：‘爱别离苦。’","book":"《瑜伽师地论》卷六十一：“云何爱别离苦？当知此苦，亦由五相。”宋·释道原《景德传灯录》卷二十三"},"usage":"作宾语、定语；指离别的痛苦"},{"id":30745,"word":"爱势贪财","pinyin":"ài shì tān cái","abbr":"astc","explanation":"爱慕权势，贪图钱财。","source":{"text":"谁知那张家父母如此爱势贪财，却养了一个知义多情的女儿，闻得父母退了前夫，他便一条麻绳悄悄的自缢了。","book":"清·曹雪芹《红楼梦》第16回"},"similar":["贪财慕势"],"usage":"作谓语、定语、宾语；用于为人","story":["王熙凤背着太太她们为守备与张家调停婚约之争，张家父母见贾府派人来调停，自然爱势贪财，就把以前的婚约退掉，没想到他的女儿是个烈女，就自缢身亡。原婚约的男方守备之子听说金哥自缢，也投河而尽，让张李两家人财两空，凤姐坐得3000两银子"]},{"id":30746,"word":"爱博不专","pinyin":"ài bó bù zhuān","abbr":"abbz","explanation":"专：专一，专注。对人或事物的喜爱很广泛，而感情不能专一。","source":{"text":"夫位益尊则贱者日隔，伺候于门墙者日益进，则爱博而情不专。","book":"唐·韩愈《与陈给事书》"}},{"id":30747,"word":"爱博而情不专","pinyin":"ài bó ér qíng bù zhuān","abbr":"abeqbz","explanation":"对人或事物的喜爱很广泛，而感情不能专一。","source":{"text":"夫位益尊则贱者日隔，伺候于门墙者日益进，则爱博而情不专。","book":"唐·韩愈《与陈给事书》"},"example":{"text":"在这三条路里，我将选择那一条呢？我惭愧自己是个‘～’的人；虽者想着只选定一条路，却总丢不下别的。","book":"朱自清《那里走》"},"opposite":["坚贞不逾"],"usage":"作谓语、定语；用于人的爱好等"},{"id":30748,"word":"爱口识羞","pinyin":"ài kǒu shí xiū","abbr":"aksx","explanation":"爱口：即碍口，说不出口。由于怕羞而不肯说话。同“碍口识羞”。","source":{"text":"这事关系你终身，肯与不肯，明白的说出，莫要爱口识羞，两相耽误！","book":"明·天然痴叟《石点头·潘文子契合鸳鸯冢》"},"similar":["碍口识羞"],"usage":"作谓语、补语；指怕羞"},{"id":30749,"word":"爱国一家","pinyin":"ài guó yī jiā","abbr":"agyj","explanation":"凡是热爱祖国的人都不分彼此，看成是一家人。","source":{"text":"都本着‘爱国一家’的原则，采取既往不咎的态度。","book":"《人民日报》1958.10.11"},"usage":"作定语；指人爱国"},{"id":30750,"word":"爱国如家","pinyin":"ài guó rú jiā","abbr":"agrj","explanation":"凡是热爱祖国的人都不分彼此，看成是一家人。","source":{"text":"封建诸侯各世其位，欲使亲民如子、爱国如家。","book":"东汉·荀悦《汉纪·惠帝纪》"},"example":{"text":"臣闻古之圣王～，故皇天亦祐之如子。","book":"《晋书·刘聪传》"},"similar":["爱民如子"],"usage":"作谓语；形容把国当成自己的家"},{"id":30751,"word":"爱如己出","pinyin":"ài rú jǐ chū","abbr":"arjc","explanation":"像对待亲生子女那样地爱护。","source":{"text":"果然方氏爱如己出，抚养成人长大。","book":"明·周辑《西湖二集·假邻女诞生真子》"},"example":{"text":"她出世半岁，就丧了父亲，一岁半时，就随母来到邓家。母亲自然是爱的，后父也～。","book":"沈从文《死水微澜》第二部分"},"similar":["视如己出"],"usage":"作谓语、定语；指十分喜爱"},{"id":30752,"word":"爱如珍宝","pinyin":"ài rú zhēn bǎo","abbr":"arzb","explanation":"形容十分喜欢。","source":{"text":"申屠娘子，已是身怀六甲，到得十月满足……生个儿子，爱如珍宝。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"example":{"text":"尤人都这样说，因而他祖母～。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["掌上明珠"],"opposite":["视若草芥","视若敝屣"],"usage":"作谓语、定语；指十分喜欢"},{"id":30753,"word":"爱富嫌贫","pinyin":"ài fù xián pín","abbr":"afxp","explanation":"嫌弃贫穷，喜爱富有。指对人的好恶以其贫富为准。","source":{"text":"有那等嫌贫爱富的儿曹辈，将俺这贫傲慢、把他那富追陪，那个肯恤孤念寡存仁义。","book":"元·关汉卿《裴度还带》第二折"},"example":{"text":"方信道贫居闹市无人问，富在深山有远亲。如今人～。","book":"明·无名氏《贫富兴衰》第二折"},"similar":["嫌贫爱富"],"opposite":["杀富济贫"],"usage":"作谓语、定语、宾语；指人贪财"},{"id":30754,"word":"爱屋及乌","pinyin":"ài wū jí wū","abbr":"awjw","explanation":"因为爱一个人而连带爱他屋上的乌鸦。比喻爱一个人而连带地关心到与他有关的人或物。","source":{"text":"爱人者，兼其屋上之乌。","book":"《尚书大传·大战》"},"example":{"text":"子存宠上了小老婆，未免“～”，把他也看得同上客一般。","book":"清·吴趼人《二十年目睹之怪现状》第十四回"},"similar":["相濡以沫"],"opposite":["爱莫能助","殃及池鱼"],"usage":"作谓语、定语、宾语；形容过分偏爱","story":["商朝末年，周武王攻克商都，建立周王朝，周武王不知如何处置商朝遗孤大臣，军师姜子牙说：“如果爱一个人，就连带爱他屋上的乌鸦。他们都助纣为虐，应该处死。”大臣周公认为不妥，商纣王的罪过不能由他们承担"]},{"id":30755,"word":"爱惜羽毛","pinyin":"ài xī yǔ máo","abbr":"axym","explanation":"羽毛：比喻人的声望。比喻为珍惜自己的名声，行事十分谨慎。","source":{"text":"夫君子爱口，孔雀爱羽，虎豹爱爪，此皆所以治身法也。","book":"汉·刘向《说苑·杂言》"},"example":{"text":"灰鹤与他都是高傲的，～的，而他与它们的高傲只是一种姿态而已，没有用，没有任何的用。","book":"老舍《四世同堂》五十"},"similar":["自惜羽毛"],"opposite":["臭名远扬"],"usage":"作谓语、定语；比喻珍惜自己的名声"},{"id":30756,"word":"爱憎分明","pinyin":"ài zēng fēn míng","abbr":"azfm","explanation":"憎：恨。爱和恨的立场和态度十分鲜明。","source":{"text":"爱憎分明是本色，疾恶如仇不宽恕。","book":"续范亭《延安五老》诗"},"example":{"text":"他一向是～，疾恶如仇。"},"similar":["泾渭分明","旗帜鲜明"],"opposite":["暧昧不明","爱憎无常"],"usage":"作谓语、定语、状语；指对人和物喜爱"},{"id":30757,"word":"爱憎无常","pinyin":"ài zēng wú cháng","abbr":"azwc","explanation":"爱和恨的感情变化不定，叫人捉摸不透。","source":{"text":"主上狂暴如此，祸乱不久，而一门受其宠任，万物皆谓与之同心。且若人爱憎无常，猜忍特甚，不测之祸，进退难免。今因此众力，图之易于反掌。机会难值，不可失也。","book":"《资治通鉴·太宗明皇帝泰始元年》"}},{"id":30758,"word":"爱才好士","pinyin":"ài cái hào shì","abbr":"achs","explanation":"爱护、看重人才。","source":{"text":"刘毅爱才好士，深相礼接，临当之郡。","book":"《晋书·殷仲文传》"},"example":{"text":"平原君～，门客很多。"},"similar":["爱人好士"],"usage":"作谓语、宾语；指爱护人才"},{"id":30759,"word":"爱才如命","pinyin":"ài cái rú mìng","abbr":"acrm","explanation":"才：贤才，人才。爱慕贤才，急欲求得，就象生命一样重要。","source":{"text":"嫉恶甚严，爱才若渴，此韩愈之面目也。","book":"语出清·叶燮《原诗·外篇上》"},"example":{"text":"本帅～，何必过谦？","book":"《说岳全传》第三一回"},"similar":["广开才路","招贤纳士","爱才若渴"],"opposite":["妒贤嫉能"],"usage":"作谓语、定语；形容十分爱惜人才"},{"id":30760,"word":"爱才如渴","pinyin":"ài cái rú kě","abbr":"acrk","explanation":"才：贤才，人才。爱慕贤才，急欲求得，就象口渴急于喝水一样。","source":{"text":"嫉恶甚严，爱才若渴，此韩愈之面目也。","book":"清·叶燮《原诗·外篇上》"},"example":{"text":"宫保～，兄弟实在钦佩的。","book":"清·刘鹗《老残游记》六回"},"similar":["爱才若渴"],"opposite":["嫉贤妒能"],"usage":"作谓语、定语；形容十分爱惜人才"},{"id":30761,"word":"爱才怜弱","pinyin":"ài cái lián ruò","abbr":"aclr","explanation":"爱护人才，怜惜弱者。","source":{"text":"永乐皇帝决不像一位爱才怜弱的明君。","book":"鲁迅《病后杂谈》"},"example":{"text":"人都有～之心。"},"opposite":["妒才嫉贤"],"usage":"作谓语、定语、宾语；指人有同情心"},{"id":30762,"word":"爱才若渴","pinyin":"ài cái ruò kě","abbr":"acrk","explanation":"才：贤才，人才。爱慕贤才，急欲求得，就象口渴急于喝水一样。","source":{"text":"嫉恶甚严，爱才若渴，此韩愈之面目也。","book":"清·叶燮《原诗·外篇上》"},"example":{"text":"他们发现了佳人并非因为‘～’而做婊子的，佳人只为的是钱。","book":"鲁迅《上海文艺之一瞥》"},"similar":["爱才如渴","爱才如命"],"opposite":["嫉贤妒能"],"usage":"作谓语、定语；形容十分爱惜人才","story":["明末大学士王锡爵的孙子王时敏从师于“江南第一书画家”董其昌，书画方面大有长进，成为清初著名画家之一，他作画风格独特，深受人民的喜爱。他爱才若渴，把自己的书画及藏画经常展览，让四方有名的画家或爱好者来观摩，请他们提出批评意见"]},{"id":30763,"word":"爱日惜力","pinyin":"ài rì xī lì","abbr":"arxl","explanation":"珍惜时间，不虚掷精力。","source":{"text":"且志士爱日惜力 ，君子慕其大者，高山景行，耻非其次。","book":"晋·陈寿《三国志·吴志·孙和传》"},"example":{"text":"朝读百篇，乙夜乃寐，～，寸阴无弃。","book":"《周书·萧圆肃传》"},"opposite":["虚度光阴"],"usage":"作谓语；指珍惜时间"},{"id":30764,"word":"爱毛反裘","pinyin":"ài máo fǎn qiú","abbr":"amfq","explanation":"反裘：反穿皮衣，指皮毛朝里。古时穿皮毛衣服，毛的一面向外。比喻不重视根本，轻重倒置。","source":{"text":"魏文侯出游，见路人反裘而负刍，文侯曰：‘胡为反裘而负刍？’对曰：‘臣爱其毛。’文侯曰：‘若不知其里尽而毛无所恃邪？’","book":"汉·刘向《新序·杂事》"},"example":{"text":"而牧守不思利民之道，期天取办，～，甚无谓也。","book":"《魏书·高祖纪上》"},"similar":["本末倒置"],"usage":"作谓语、宾语、定语；指本末倒置的愚昧人"},{"id":30765,"word":"爱民如子","pinyin":"ài mín rú zǐ","abbr":"amrz","explanation":"旧时称赞某些统治者爱护百姓，就象爱护自己的子女一样。","source":{"text":"良君将赏善而除民患，爱民如子，盖之如天，容之若地。","book":"《礼记·中庸》：“子，庶民也。”汉·刘向《新序·杂事一》"},"example":{"text":"一路地方官员馈送礼物，岳爷始终不受……只是吩咐他们学好做官，须要爱民如子，无负朝廷。","book":"清·钱彩《说岳全传》第四八回"},"similar":["爱国如家"],"usage":"作谓语、定语；用于称赞有仁义道德的官员"},{"id":30766,"word":"爱民恤物","pinyin":"ài mín xù wù","abbr":"amxw","explanation":"恤：怜惜；物：自我以外的人或环境，指众人。爱护和体恤百姓。旧用为对帝王、官吏的赞辞。","source":{"text":"做官爱民恤物，今特佑汝。","book":"明·周楫《西湖二集·愚郡守玉殿生春》"}},{"id":30767,"word":"爱理不理","pinyin":"ài lǐ bù lǐ","abbr":"albl","explanation":"不爱答理。比喻对人冷漠，没礼貌","source":{"text":"黄二麻子爱理不理的，问他什么事。","book":"清·李宝嘉《官场现形记》第59回"},"example":{"text":"钱钟书《围城》：“孙太太～地应了一声。”"},"similar":["爱答不理"],"usage":"作谓语、定语、状语；用于处事"},{"id":30768,"word":"爱生恶死","pinyin":"ài shēng wù sǐ","abbr":"asws","explanation":"恶：厌恶。喜爱生存，厌恶死亡。","source":{"text":"可见爱生恶死，亦是物之恒情。","book":"清·李汝珍《镜花缘》第26回"},"example":{"text":"～是人的本性。"},"similar":["贪生怕死"],"usage":"作主语、谓语、定语；指生存观"},{"id":30769,"word":"爱礼存羊","pinyin":"ài lǐ cún yáng","abbr":"alcy","explanation":"由于爱惜古礼，不忍使它废弛，因而保留古礼所需要的祭羊。比喻为维护根本而保留有关仪节。","source":{"text":"子贡欲去告朔之饩羊，子曰：‘赐也，尔爱其羊，我爱其礼。’","book":"《论语·八佾》"},"example":{"text":"本朝监学之法，虽参以天下之士，而于国子加厚矣。盖～，以有待也。","book":"宋·陈亮《国子》"},"usage":"作宾语、定语；指保持礼节"},{"id":30770,"word":"爱答不理","pinyin":"ài dā bù lǐ","abbr":"adbl","explanation":"不爱答理。喻对人冷漠，没礼貌。","example":{"text":"他对你怎么能～呢？"},"similar":["爱理不理"],"opposite":["满腔热情"],"usage":"作谓语、定语；用于口语"},{"id":30771,"word":"爱素好古","pinyin":"ài sù hào gǔ","abbr":"ashg","explanation":"指爱好朴质，不趋时尚。","source":{"text":"子曰：‘述而不作，信而好古，窃比于我老彭。’","book":"春秋·楚·李耳《老子》：“见素抱朴，少私寡欲。” 春秋·鲁·孔丘《论语·述而》"},"example":{"text":"俾知～，昔有其人。","book":"清·黄丕烈《跋》"},"opposite":["阿世趋俗"],"usage":"作谓语；指不赶时髦"},{"id":30772,"word":"爱老慈幼","pinyin":"ài lǎo cí yòu","abbr":"alcy","explanation":"爱护老人和儿童。","source":{"text":"家中仆从老小想他素日怜贫怜贱，爱老慈幼之恩，莫不悲号痛哭。","book":"清·曹雪芹《红楼梦》第13回"},"example":{"text":"～是人应有的美德之一。"},"similar":["尊老爱幼"],"usage":"作谓语、定语、宾语；指人很有礼貌"},{"id":30773,"word":"爱者如宝","pinyin":"ài zhě rú bǎo","abbr":"azrb","explanation":"喜爱什么，就把什么看成宝贝。","source":{"text":"本不当计较，只是爱者如宝，添些便罢。","book":"明·冯梦龙《古今小说·沈小官一鸟害七命》"},"similar":["爱如珍宝"],"usage":"作宾语、定语；用于人或事物"},{"id":30774,"word":"爱莫之助","pinyin":"ài mò zhī zhù","abbr":"amzz","explanation":"爱：爱惜；莫：不。虽然心中关切同情，却没有力量帮助。","source":{"text":"维仲山甫举之，爱莫助之。","book":"《诗经·大雅·烝民》"},"example":{"text":"晚虽家事不如初，而亲戚故旧之急难，族人子弟之美事，～，每致其倦倦之意，而人人常信之。","book":"宋·陈亮《喻夏卿墓志铭》"},"similar":["爱莫能助"],"opposite":["舍己救人"],"usage":"作谓语；表示想帮助但又无能为力","story":["周宣王时期，齐国发生暴动，杀死齐厉公，焚毁都城。周宣王派仲山甫前去平息暴动，重建城池。仲山甫虽然同情人们的举动，但杀君烧城是大逆不道。他决定快速行动，离开京城时，亲友们都来送行，并作诗颂他的功绩，如“维仲山甫举之，爱莫助之。”"]},{"id":30775,"word":"爱莫能助","pinyin":"ài mò néng zhù","abbr":"amnz","explanation":"爱：爱惜；莫：不。虽然心中关切同情，却没有力量帮助。","source":{"text":"维仲山甫举之，爱莫助之。","book":"《诗经·大雅·烝民》"},"example":{"text":"收到各处的回信，只是写些“～”之类的抱歉话。","book":"叶圣陶《得失》"},"similar":["无能为力","力不从心","鞭长莫及"],"opposite":["鼎力相助","舍己救人","相濡以沫"],"usage":"作谓语、定语；表示力量不足而无法相助","story":["周宣王时期，齐国发生暴动，杀死齐厉公，焚毁都城。周宣王派仲山甫前去平息暴动，重建城池。仲山甫虽然同情人们的举动，但杀君烧城是大逆不道。他决定快速行动，离开京城时，亲友们都来送行，并作诗歌颂他的功绩，如“维仲山甫举之，爱莫助之。"]},{"id":30776,"word":"爱财如命","pinyin":"ài cái rú mìng","abbr":"acrm","explanation":"把钱财看得跟生命一样重要。形容极端吝啬。","source":{"text":"我想近来世界，不管什么英雄，什么豪杰，都是爱财如命，何况吃官司的，少不免要和那些狼官鼠吏交手，这更没钱不行了。","book":"清·岭南羽衣女士《东欧女豪杰》第四回"},"example":{"text":"那个人极端自私，～。"},"similar":["惟利是图","锱铢必较"],"opposite":["仗义疏财","挥金如土"],"usage":"作谓语、定语；形容十分贪婪、吝啬"},{"id":30777,"word":"爱财舍命","pinyin":"ài cái shě mìng","abbr":"acsm","explanation":"指宁愿舍弃自己的生命而追求钱财。","example":{"text":"不能～当守财奴。"},"similar":["爱财如命"],"opposite":["挥金如土"],"usage":"作谓语、定语、宾语；指财迷"},{"id":30778,"word":"爱贤念旧","pinyin":"ài xián niàn jiù","abbr":"axnj","explanation":"旧：旧有的交情。爱慕贤者，思念旧谊。","source":{"text":"侍郎于此讲之熟矣。爱贤念旧之心，不自知其为僭也。","book":"宋·陈亮《与韩子师侍郎》"},"usage":"作谓语、定语；用于书面语"},{"id":30779,"word":"爱钱如命","pinyin":"ài qián rú mìng","abbr":"aqrm","explanation":"某些人贪爱钱财就像吝啬生命一样。形容十分贪婪、刻薄。","source":{"text":"明·谢谠《四喜记·大宋毕姻》“既称月老，又号冰人，爱钱如命，说谎能神，自家高媒婆是也。”"},"example":{"text":"1942年我在成都重见她的时候，她已经成了一个～的可笑的胖女人。","book":"巴金《谈》"},"similar":["爱财如命"],"opposite":["仗义疏财"],"usage":"作谓语、定语；形容十分贪婪、吝啬"},{"id":30780,"word":"爱非其道","pinyin":"ài fēi qí dào","abbr":"afqd","explanation":"对某人很喜爱，但所用的方法不对头。多指父母对子女的溺爱。","source":{"text":"余五十二岁，始得一子，岂有不爱之理？然爱之必以其道。","book":"清·郑燮《潍县署中与舍弟墨第二书》"},"example":{"text":"教育子女要注意～。"},"usage":"作宾语；指溺爱"},{"id":30781,"word":"爱鹤失众","pinyin":"ài hè shī zhòng","abbr":"ahsz","explanation":"比喻因小失大。","source":{"text":"狄人伐卫，卫懿公好鹤，鹤有乘轩者。将战，国人受甲者皆曰：‘使鹤，鹤有禄位。余焉能战？’","book":"春秋·鲁·左丘明《左传·闵公二年》"},"example":{"text":"你听说过“～”的故事吗？"},"similar":["玩物丧志"],"usage":"作宾语、定语；指因小失大","story":["公元前668年，卫惠公的儿子姬赤成为卫懿公后，不思富国强兵之道，整天喜欢养鹤，甚至荒唐到给鹤封官位，享官禄，百姓怨声载道。北方狄国借机出兵攻打卫国，卫国士兵根本不抵抗就逃散，卫懿公被狄兵所杀"]},{"id":30782,"word":"父严子孝","pinyin":"fù yán zǐ xiào","abbr":"fyzx","explanation":"父亲严格管教子女，子女依顺孝敬父亲。","source":{"text":"始见一乡之人，父严子孝，长惠幼敬，见乎词气，发乎颜色。","book":"唐·吕温《广陵陈先生墓表》"},"usage":"作宾语、定语；指父子关系"},{"id":30783,"word":"父为子隐","pinyin":"fù wéi zǐ yǐn","abbr":"fwzy","explanation":"父亲为儿子隐藏劣迹。","source":{"text":"父为子隐，子为父隐，直在其中矣。","book":"《论语·子路》"},"example":{"text":"彼各都忍了也波哥，因此上～，上下家和顺。","book":"元·无名氏《九世同堂》"},"usage":"作谓语、宾语；指父子间的人情","story":["春秋时期，孔子带领弟子们周游列国，在叶邑停留时，叶公府中的一只羊跑进孔子的住地，被弟子曾点烧了吃。曾点的儿子曾参把这事报告给孔子，孔子知道曾参处于忠孝两难的地步，于是答应同叶公说，孔子感慨：“父为子隐，子为父隐，直在其中矣。”"]},{"id":30784,"word":"父债子还","pinyin":"fù zhài zǐ huán","abbr":"fzzh","explanation":"父亲生前的债务，由子女负责偿还。也指父辈的过错累及子女。","source":{"text":"我知道自己出身不好，在娘胎就背上父辈罪恶的包袱。就算是‘父债子还’吧。","book":"祝兴义《此生此夜》"},"example":{"text":"这不能搞～的游戏。"},"usage":"作宾语、定语；指前辈的债务后辈偿还"},{"id":30785,"word":"父子兵","pinyin":"fù zǐ bīng","abbr":"fzb","explanation":"指上下亲如一家的军队。","source":{"text":"与之安，与之危，其众可合而不可离，可用而不可疲，投之所往，天下莫当，名曰父子之兵。","book":"战国·卫·吴起《吴子·治兵》"},"example":{"text":"常言道：‘厮杀无如～。’","book":"元·无名氏《陈州粜米》第一折"},"usage":"作主语、宾语、定语；用于口语等"},{"id":30786,"word":"父子无隔宿之仇","pinyin":"fù zǐ wú gé sù zhī chóu","abbr":"fzwgszc","explanation":"宿：夜。父子间没有隔夜解不开的仇怨。指仇怨容易消除。","source":{"text":"你这个泼怪，岂知‘一日为师，终身为父’，‘父子无隔宿之仇’！你伤害我师父，我怎么不来救他？","book":"明·吴承恩《西游记》第31回"},"usage":"作宾语、定语；用于口语"},{"id":30787,"word":"父慈子孝","pinyin":"fù cí zǐ xiào","abbr":"fczx","explanation":"父：指父母；子：子女。父母对子女慈爱，子女对父母孝顺。","source":{"text":"何谓人义？父慈，子孝，兄良，弟悌，夫义，妇听，长惠，幼顺，君仁，臣忠。","book":"《礼记·礼运》"},"example":{"text":"主圣臣贤，国之福也；～，家之福也。","book":"明·冯梦龙《东周列国志》第一○一回"},"usage":"作宾语、定语；指父子关系"},{"id":30788,"word":"父析子荷","pinyin":"fù xī zǐ hé","abbr":"fxzh","explanation":"父劈柴，子担柴。比喻子孙继承父辈的未竟之业。","source":{"text":"大丈夫贮蓄材术，树置功利，鎡基富贵，焯耀家邦，不当其身，而得于后；父析子荷，相去几何？","book":"唐·白居易《唐故潮州长城县令博陵崔府君神道碑铭》"},"usage":"作宾语、定语；用于做事等"},{"id":30789,"word":"父母之命，媒妁之言","pinyin":"fù mǔ zhī mìng，méi shuò zhī yán","abbr":"fmzmmszy","explanation":"媒妁：婚姻介绍者。旧指儿女婚姻须由父母作主，并经媒人介绍。","source":{"text":"不待父母之命，媒妁之言，钻穴隙相窥，逾墙相从，则父母国人皆贱之。","book":"《孟子·滕文公下》"},"example":{"text":"秀才，可记得古书云：“必待～。”","book":"明·汤显祖《还魂记·婚走》"}},{"id":30790,"word":"父母之国","pinyin":"fù mǔ zhī guó","abbr":"fmzg","explanation":"指祖国。","source":{"text":"枉道而事人，何必去父母之邦。","book":"《论语·微子》"},"similar":["父母之邦","父母国"],"usage":"作宾语；指祖国"},{"id":30791,"word":"父母之邦","pinyin":"fù mǔ zhī bāng","abbr":"fmzb","explanation":"邦：国家。指祖国。","source":{"text":"枉道而事人，何必去父母之邦。","book":"《论语·微子》"},"example":{"text":"邦国如是，奚能淹留？吾见放于～矣。","book":"鲁迅《坟·文化偏至论》"},"similar":["父母之国","父母国"],"usage":"作宾语；指祖国","story":["春秋时期，孔子带领弟子周游列国碰壁后，在冉求的帮助下，终于回到了父母之邦鲁国，主事的季康子嫌他太老，没有重用他。他认为与季康子是“道不同，不相为谋。”于是闲居起来，专心著述，编辑整理《诗》《书》《礼》《乐》《春秋》等"]},{"id":30792,"word":"父母国","pinyin":"fù mǔ guó","abbr":"fmg","explanation":"指祖国。","source":{"text":"去鲁，曰：‘迟迟吾行也，去父母国之道也。’","book":"战国·邹·孟轲《孟子·万章下》"},"example":{"text":"回瞻～，日出东方。","book":"唐·阎朝隐《奉和送金城公主适西蕃应制》"},"similar":["父母之邦","父母之国"],"usage":"作宾语、定语；指祖国"},{"id":30793,"word":"父母官","pinyin":"fù mǔ guān","abbr":"fmg","explanation":"旧时对州县官的称呼。","source":{"text":"彼豪民恃其资，诬去贤使君，袁人失父母。","book":"明·高启《书博鸡者事》"},"example":{"text":"无论怎么说，他总是～！","book":"老舍《神拳》第三幕"},"usage":"作主语、宾语、定语；指当权者"},{"id":30794,"word":"父母恩勤","pinyin":"fù mǔ ēn qín","abbr":"fmeq","explanation":"指父母养育子女的恩惠和辛劳。","source":{"text":"恩斯勤斯，鬻子之闵斯。","book":"《诗经·豳风·鸱鸮》"},"example":{"text":"～，养我身兮。","book":"明·归有光《招张贞女辞》"},"usage":"作宾语；指父母的辛劳"},{"id":30795,"word":"父母遗体","pinyin":"fù mǔ yí tǐ","abbr":"fmyt","explanation":"人是父母所生，指自己的身体。","source":{"text":"身也者，父母之遗体也。","book":"西汉·戴圣《礼记·祭义》"},"example":{"text":"我是个清白好汉，如何肯把～来点污了！","book":"明·施耐庵《水浒传》第三回"},"usage":"作主语、宾语、定语；指自身"},{"id":30796,"word":"父紫儿朱","pinyin":"fù zǐ ér zhū","abbr":"fzez","explanation":"紫、朱：旧时指官服。唐朝，三品以上官员穿紫有，五品以上者着朱服。指父子都做了大官。","source":{"text":"一言之合，荣膺圣眷，父紫儿朱，恩宏为极。","book":"清·蒲松龄《聊斋志异·续黄梁》"},"usage":"作宾语、定语；用于官场等"},{"id":30797,"word":"爷羹娘饭","pinyin":"yé gēng niáng fàn","abbr":"ygnf","explanation":"指在父母的庇荫下生活。同“爷饭娘羹”。","source":{"text":"生下来便落在那爷羹娘饭长生运。","book":"元·宫天挺《范张鸡黍》第一折"},"example":{"text":"那个是欺家的泼面东西，见成吃着～，又要偷家理财物，是也不是？","book":"明·无名氏《渔樵闲话》第三折"},"similar":["爷饭娘羹"],"usage":"作宾语、定语；指在父母的照顾下过日子"},{"id":30798,"word":"爷饭娘羹","pinyin":"yé fàn niáng gēng","abbr":"yfng","explanation":"指在父母的庇荫下生活。","source":{"text":"打的来伤觔动骨，更疼似悬头刺股。他每爷饭娘羹何曾受这般苦！","book":"元·关汉卿《蝴蝶梦》第二折"},"example":{"text":"觑着他狠似豺狼，蠢似猪羊，眼欺缩腮模样，面黄肌瘦形相，～娇养，夫贵妻荣休望。","book":"元·杨梓《霍光鬼谏》第一折"},"similar":["爷羹娘饭"],"usage":"作宾语、定语；指在父母的照顾下过日子"},{"id":30799,"word":"爽心悦目","pinyin":"shuǎng xīn yuè mù","abbr":"sxym","explanation":"悦目：看了舒服。指看到美好的景色而心情愉快。","source":{"text":"长篇短章，不为不多，然半属套语，半属陈言，求一言清新俊逸，赏心悦目者，迥然可得。","book":"明·无名氏《人中画·风流配》一"},"example":{"text":"这千年万代无边的戈壁荒滩已经出现了无数水光闪闪的纵横渠道和水库，已经出现了无数～的绿洲。","book":"碧野《新疆在欢呼》"},"similar":["兴高采烈"],"opposite":["愁肠百结"],"usage":"作宾语、定语；指心情愉快"},{"id":30800,"word":"爽心豁目","pinyin":"shuǎng xīn huō mù","abbr":"sxhm","explanation":"心神爽朗，眼界开阔。","source":{"text":"故梅村诗嫌其使典过繁，翻致腻滞；一遇白描处，即爽心豁目，情余于文。","book":"清·赵翼《瓯北诗话·查初白诗》"},"usage":"作谓语、定语；用于书面语"},{"id":30801,"word":"爽然自失","pinyin":"shuǎng rán zì shī","abbr":"srzs","explanation":"形容茫无主见，无所适从。","source":{"text":"公爽然自失，而悔无及矣。","book":"清·蒲松龄《聊斋志异·小翠》"},"example":{"text":"明·李东阳《寿祭酒罗先生七十诗序》：“诸同年闻之盖～也。”"},"similar":["茫然自失","爽然若失"],"usage":"作谓语、定语；指不知所以的样子"},{"id":30802,"word":"爽然若失","pinyin":"shuǎng rán ruò shī","abbr":"srrs","explanation":"爽然：主意不定的样子；若失：象失去依靠。形容心中无主、空虚怅惘的神态。","source":{"text":"读《鹏鸟赋》，同生死，轻去就，又爽然自失矣。","book":"《史记·屈原贾生列传》"},"example":{"text":"毕业大家自然都盼望的，但一到毕业，却又有些～。","book":"鲁迅《朝花夕拾·琐记》"},"similar":["爽然自失"],"usage":"作谓语、定语；形容心中无主见"},{"id":30803,"word":"爽爽快快","pinyin":"shuǎng shuǎng kuài kuài","abbr":"sskk","explanation":"指处事直截了当。","source":{"text":"小春姐姐把‘爽爽快快’读做‘霜霜快快’，把‘转弯磨角’读做‘转弯磨禄’，满口都是古音。","book":"清·李汝珍《镜花缘》第82回"},"example":{"text":"胡雪岩～的把他心中的疑惑揭破。","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["直截了当"],"usage":"作定语、状语；用于处事"},{"id":30804,"word":"片云遮顶","pinyin":"piàn yún zhē dǐng","abbr":"pyzd","explanation":"比喻得到别人的恩泽。","source":{"text":"小人到前面死了呵，那生那世，做驴做马，填还这债，若不死呵，但得片云遮顶，此恩必当重报也。","book":"元·张国宾《合汗衫》第一折"},"usage":"作宾语、定语；用于受恩等"},{"id":30805,"word":"片光零羽","pinyin":"piàn guāng líng yǔ","abbr":"pgly","explanation":"比喻零星的珍贵品。","source":{"text":"又中山政见，亦仅片光零羽，见于报章。","book":"黄远庸《记者眼中之孙中山》"},"usage":"作宾语、定语；用于比喻句"},{"id":30806,"word":"片口张舌","pinyin":"piàn kǒu zhāng shé","abbr":"pkzs","explanation":"形容卖弄口舌，搬弄是非。 同“骗口张舌”。","source":{"text":"没空生有，说谎吊皮，片口张舌，■（口芻）出来的。","book":"元·无名氏《渔樵记》第三折"},"example":{"text":"上皇无奈，终被奸臣谗佞所惑，～，花言巧语，缓里取事，无不纳受。","book":"明·施耐庵《水浒传》第一百二十回"}},{"id":30807,"word":"片善小才","pinyin":"piàn shàn xiǎo cái","abbr":"psxc","explanation":"片善：微小的优点。指小有才能的人。","source":{"text":"吾识览虽局，未曾以言议假人，至于片善小才，特用嗟赏。","book":"《陈书·陆瑜传》"},"usage":"作宾语、定语；用于书面语"},{"id":30808,"word":"片接寸附","pinyin":"piàn jiē cùn fù","abbr":"pjcf","explanation":"比喻生拼硬凑。","source":{"text":"且才分不同，思绪各异，或制首以通尾，或片接以寸附，然通制者盖寡，接附者甚众。","book":"南朝·梁·刘勰《文心雕龙·附会》"},"example":{"text":"其天资学力，有大过人者，非肤受皮傅，～者所可几及。","book":"清·孙星衍《告茂山人诗录序》"},"similar":["生拼硬凑"],"usage":"作定语、状语；指生拼硬凑"},{"id":30809,"word":"片文只事","pinyin":"piàn wén zhī shì","abbr":"pwzs","explanation":"指零碎不全的佚文轶事。","source":{"text":"司马迁制一家之言，始区别名题，至乎礼仪刑政，有所不尽，乃于纪传之外，创立八书，片文只事，鸿纤备举。","book":"《宋书·志序》"},"usage":"作宾语、定语；用于书面语"},{"id":30810,"word":"片文只字","pinyin":"piàn wén zhī zì","abbr":"pwzz","explanation":"指少数的几句话语。","source":{"text":"孜孜以荐贤为急务，虽州里白丁，片文只字求贡于有司者，莫不尽礼接之。","book":"五代·王定保《唐摭言·争解元》"},"example":{"text":"离家很久了，家乡的～都让人激动不已。"},"similar":["片言只语","片言只字","片言一字"],"opposite":["长篇大论"],"usage":"作主语、宾语；用于写信等"},{"id":30811,"word":"片瓦不存","pinyin":"piàn wǎ bù cún","abbr":"pwbc","explanation":"一块瓦都没有了。形容房屋全部毁坏。","source":{"text":"况城邑焚毁，片瓦不存，所过山林，林木匮乏。城之甚劳，未见其利。","book":"《宋史·钱若水传》"},"example":{"text":"我们在少林寺清修，与世无争，你何以派了赃官，将佛门胜地烧得片瓦不存？","book":"金庸《书剑恩仇录》第二十回"},"similar":["片瓦无存","片瓦不留"],"usage":"作定语、状语；用于战争或灾难等"},{"id":30812,"word":"片瓦不留","pinyin":"piàn wǎ bù liú","abbr":"pwbl","explanation":"形容房屋全部毁坏。同“片瓦无存”。","source":{"text":"况城邑焚毁，片瓦不存，所过山林，林木匮乏。城之甚劳，未见其利。","book":"《宋史·钱若水传》"},"example":{"text":"臣闻武卫军中有大炮，若攻使馆，立即～，臣向他索取几回，荣禄立誓不肯借用。","book":"蔡东蕃《清史演义》第八十九回"},"similar":["片瓦不存","片瓦无存"],"usage":"作定语、状语；用于战争或灾难等"},{"id":30813,"word":"片瓦无存","pinyin":"piàn wǎ wú cún","abbr":"pwwc","explanation":"一块瓦都没有了。形容房屋全部毁坏。","source":{"text":"贵州暴雪，形如土砖，民居片瓦无存者。","book":"《明史·五行志一》"},"example":{"text":"疯僧，你就把相府烧个～，我也要把你解到有司衙门，打你八十竹棍，方出我胸中之气。”","book":"《济公全传》第十九回"},"similar":["片瓦不留","片瓦不存"],"usage":"作补语；形容房屋全部毁坏"},{"id":30814,"word":"片甲不回","pinyin":"piàn jiǎ bù huí","abbr":"pjbh","explanation":"一个士兵也没回来。形容全军覆没。","source":{"text":"贫道祭风，周瑜举火，黄盖诈降，烧曹兵八十三万，片甲不回。","book":"元·无名氏《黄鹤楼》第一折"},"example":{"text":"西岐异人甚多，无怪屡次征伐，俱是～，无能取胜。","book":"明·许仲琳《封神演义》第五十七回"},"similar":["全军覆没","片甲不留","片甲不归"],"opposite":["大获全胜"],"usage":"作定语、补语；形容全军覆没"},{"id":30815,"word":"片甲不存","pinyin":"piàn jiǎ bù cún","abbr":"pjbc","explanation":"一片铠甲都没保存下来。形容全军覆没。","source":{"text":"我夫差收楚服越……昨遣太宰先领一枝军支，与齐战于艾陵之上，杀得他片甲不存。","book":"明·梁辰鱼《浣纱记·死忠》"},"example":{"text":"乘其不备，人衔枚，马摘辔，暗劫营寨，杀彼～，方知我等利害。","book":"明·许仲琳《封神演义》第二回"},"similar":["片甲无存"],"usage":"作宾语、状语；指全军覆没"},{"id":30816,"word":"片甲不归","pinyin":"piàn jiǎ bù guī","abbr":"pjbg","explanation":"片：单，只；甲：铠甲。形容全军覆没。","source":{"text":"不如俺先杀向前去，给他一个措手不及，杀他一个片甲不归，方知俺的厉害。","book":"《平鬼传》第六回"},"example":{"text":"清·姜振名《永庆升平前传》第71回：“我也不是说一句大话，不费吹灰之力，管保把会匪一阵杀退，叫他～。”"},"similar":["片甲不回","片甲不留"],"opposite":["大获全胜","凯旋而归"],"usage":"作补语、状语；形容全军覆没"},{"id":30817,"word":"片甲不留","pinyin":"piàn jiǎ bù liú","abbr":"pjbl","explanation":"一片铠甲都没留下来。形容全军覆没。","source":{"text":"贫道祭风，周瑜举火，黄盖诈降，烧曹兵八十三万，片甲不回。","book":"元·无名氏《黄鹤楼》第一折"},"example":{"text":"我们舍命争先，杀得他～。","book":"清·钱彩《说岳全传》第六十回"},"similar":["片甲不回","全军覆没"],"opposite":["大获全胜"],"usage":"作补语、状语；指全军覆没"},{"id":30818,"word":"片甲不还","pinyin":"piàn jiǎ bù huán","abbr":"pjbh","explanation":"形容全军覆没。同“片甲不回”。","source":{"text":"咱留一支军马守关，以待刘总督后队官军，杀教他片甲不还，方称畅快！","book":"明·方汝浩《禅真后史》第二十七回"},"example":{"text":"我们要转移社会、改善社会，就得迎上前去，同这班东西接战，杀得他们～！","book":"叶圣陶《倪焕之》十二"},"similar":["片甲不回"],"usage":"作定语、补语；形容全军覆没"},{"id":30819,"word":"片甲无存","pinyin":"piàn jiǎ wú cún","abbr":"pjwc","explanation":"一片铠甲都没保存下来。形容全军覆没。同“片甲不存”。","source":{"text":"末将明日使姜尚无备，再杀他个片甲无存，早早奏凯。","book":"明·梁辰鱼《浣纱记·交战》：“杀得他只轮不返，片甲无存，望风而逃，渡江去了。”明·陈仲琳《封神演义》第九十一回"},"example":{"text":"臣闻兀术又犯中原，有岳飞青龙山大战，杀得番兵～。","book":"清·钱彩《说岳全传》第二十四回"},"similar":["片甲不存"],"usage":"作宾语、状语；指全军覆没"},{"id":30820,"word":"片石韩陵","pinyin":"piàn shí hán líng","abbr":"pshl","explanation":"比喻少见的好文章。","source":{"text":"惟有韩陵一片石堪共语；薛道衡、卢思道，少解把笔，其余驴鸣狗吠，聒耳而已。","book":"唐·张鷟《朝野佥载》卷六"},"example":{"text":"～孰比肩，凌云健笔出鲜妍。","book":"陈秉之《恭祝赵朴老九秩大庆欣值朴老九秩大庆，谨奉小诗敬贺》"},"similar":["韩陵片石"],"usage":"作宾语；用于比喻句"},{"id":30821,"word":"片笺片玉","pinyin":"piàn jiān piàn yù","abbr":"pjpy","explanation":"笺：精美的纸张。一片纸如同一片美玉。形容诗文秀美华丽。","source":{"text":"李峤善文，作《少室记》，富赡华美，人谓片笺片玉。","book":"宋·计有功《唐诗纪事》"},"usage":"作宾语、定语；用于书面语"},{"id":30822,"word":"片纸只字","pinyin":"piàn zhǐ yán zì","abbr":"pzzz","explanation":"不多的几句话，极少的几个字。指零碎的文字材料。","source":{"text":"片言只字，不关其间。","book":"晋·陆机《谢平原内史表》"},"example":{"text":"他的信每次总是～，从不多写。"},"similar":["片言之语","三言两语","残篇断简"],"opposite":["连篇累牍","累牍连篇"],"usage":"作主语、宾语；用于写信等"},{"id":30823,"word":"片羽吉光","pinyin":"piàn yǔ jí guāng","abbr":"pyjg","explanation":"片羽：一片毛；吉光：古代神话中的神兽名。比喻残存的珍贵文物。","source":{"text":"武帝时西域献吉光裘，入水不濡。","book":"汉·刘歆《西京杂志》卷一"},"similar":["吉光片羽"],"usage":"作宾语、定语；用于书面语"},{"id":30824,"word":"片言一字","pinyin":"piàn yán yī zì","abbr":"pyyz","explanation":"犹片言只字。少量的文字。","source":{"text":"片言一字，劝善惩恶，诱进后人，启明先觉。","book":"唐·李邕《兖州曲阜县孔子庙碑》"},"similar":["片言只语","片言只字"],"usage":"作主语、宾语；用于讲话、写信等"},{"id":30825,"word":"片言九鼎","pinyin":"piàn yán jiǔ dǐng","abbr":"pyjd","explanation":"九鼎：古代国家的宝器，象征九州。比喻说话力量大，能起很大作用或指人说话十分守信。","source":{"text":"毛遂片言九鼎，人重其言；季布一诺千金，人服其信。","book":"明·程登吉《幼学琼林》第三卷"},"example":{"text":"我是一个～的人。"},"similar":["一言九鼎"],"usage":"作谓语、定语；指重信用","story":["战国时期，秦国进攻赵国，赵国平原君携门客毛遂出使楚国，在楚国朝堂上，毛遂凭自己三寸不烂之舌说服楚国出兵救赵国，楚王派兵救赵。事后平原君赞扬毛遂三寸舌胜百万兵，一番话使赵国重于九鼎"]},{"id":30826,"word":"片言只字","pinyin":"piàn yán zhǐ zì","abbr":"pyzz","explanation":"不多的几句话，极少的几个字。指零碎的文字材料。","source":{"text":"片言只字，不关其间；事踪笔迹，皆可推校。","book":"晋·陆机《谢平原内史表》"},"example":{"text":"君得其～，必手抄之。","book":"清·黄宗羲《五军都督府都事佩于李君墓志铭》"},"similar":["片言之语","三言两语","残篇断简"],"opposite":["连篇累牍","累牍连篇"],"usage":"作主语、宾语；用于写信等"},{"id":30827,"word":"片言只语","pinyin":"piàn yán zhǐ yǔ","abbr":"pyzy","explanation":"零零碎碎的话语。形容语言文字数量极少。","source":{"text":"片言只字，不关其间。","book":"晋·陆机《谢平原内史表》"},"example":{"text":"他的信每次总是～，从不多写。"},"similar":["三言两语","片言只字"],"opposite":["长篇大论","连篇累牍"],"usage":"作宾语、主语；用于讲话、写信等"},{"id":30828,"word":"片言居要","pinyin":"piàn yán jū yào","abbr":"pyjy","explanation":"用一言半语就能说清事情的要点或本质。","source":{"text":"立片言而居要，乃一篇之警策。","book":"晋·陆机《文赋》"},"example":{"text":"横渠学问思辨之功，古今无两，其言物理也，曰：“想孔子也大段辛苦来。”可谓～。","book":"清·王夫之《读四书大全说》卷七"},"usage":"作谓语、宾语、定语；用于写作等"},{"id":30829,"word":"片言折之","pinyin":"piàn yán zhé zhī","abbr":"pyzz","explanation":"折：使人折服；之：代词，指人。用简短的几句知使人折服。形容话虽少，说服力却很强。","source":{"text":"忽阶下一人应声出曰：‘臣请往见鄢陵侯，以片言折之。’","book":"明·罗贯中《三国演义》第七十八回"},"example":{"text":"鄰邑讼不决，亦皆赴诉，～，各心厌去。","book":"《明史·盛颙传》"}},{"id":30830,"word":"片言折狱","pinyin":"piàn yán zhé yù","abbr":"pyzy","explanation":"片言：极少的几句话；折狱：判决诉讼案件。原意是能用简单的几句话判决讼事。后指能用几句话就断定双方争论的是非。","source":{"text":"片言可以折狱者，其由也与？","book":"《论语·颜渊》"},"example":{"text":"所谕西江金沙之异同，真是～。","book":"明·卓人月《答詹曰至书》"},"similar":["片言断狱"],"usage":"作补语、宾语；用于称颂官吏贤明","story":["春秋时期，孔子的学生子路身强力壮，他总是跟随孔子，为他驾车作侍卫。子路性情正直忠贞，十分孝顺他的母亲。他为人十分诚实，坦率公正，答应办到的事一定立即就办，决不拖延。孔子对子路的赞语是：“片言可以折狱者，其由也与？”"]},{"id":30831,"word":"片词只句","pinyin":"piàn cí zhī jù","abbr":"pczj","explanation":"指零碎的文字材料。同“片言只字”。","source":{"text":"噫，后之学者褊浅，片词只句，未能自辨，已侧目相诋訾矣。","book":"唐·司空图《题〈柳柳州集〉序》"},"similar":["片纸只字"],"usage":"作宾语、定语；指少量的文字"},{"id":30832,"word":"片语只词","pinyin":"piàn yǔ zhǐ cí","abbr":"pyzc","explanation":"犹片言只字。少量的文字。","source":{"text":"[明·胡无瑞]尝跋此册及《敬乡录》云：‘遍举郡邑，凡有闻者，缉其制作履历，粲若指掌，下逮畸流逸客，片语只词，亦博采旁证。’","book":"清·厉鹗《〈吴礼部诗话〉跋》"}},{"id":30833,"word":"片语只辞","pinyin":"piàn yán zhǐ cí","abbr":"pyzc","explanation":"犹片言只字。少量的文字。","source":{"text":"酷嗜临川王之书，以彼片语只辞别具炉锤,自甘吻颊,非凡响所能及耳。","book":"易宗夔《〈新世说〉序》"},"similar":["片言只字","片言一字"],"usage":"作主语、宾语；用于书面语"},{"id":30834,"word":"片长末技","pinyin":"piàn cháng mò jì","abbr":"pcmj","explanation":"微小的特长，浅薄的技能。同“片长薄技”。","source":{"text":"乃后世概以工匠轻之，以舆隶概之，以片长薄技鄙数之。","book":"清·郑观应《盛世危言·技艺》"},"example":{"text":"抑知～，以备顾问，以供驱策，未尝不可。","book":"清·沈葆桢《复奏洋务事宜疏》"},"similar":["片长薄技"],"usage":"作主语、宾语；用于自谦"},{"id":30835,"word":"片长薄技","pinyin":"piàn cháng bó jì","abbr":"pcbj","explanation":"微小的特长，浅薄的技能。","source":{"text":"乃后世概以工匠轻之，以舆隶概之，以片长薄技鄙数之。","book":"郑观应《盛世危言·技艺》"},"similar":["片长末技"],"usage":"作主语、宾语；用于自谦"},{"id":30836,"word":"片鳞半爪","pinyin":"piàn lín bàn zhǎo","abbr":"plbz","explanation":"比喻事物的极小部分。","source":{"text":"余观其诗，剽拟字句，了无意味，求杜之片鳞半爪不可得。","book":"清·陈田《明诗纪事·孙宜》"},"example":{"text":"江汉《分析好，大有益》：“如果情况不明了，只凭着～的材料，轻率地做出结论，就会在工作中犯错误。”"},"similar":["一鳞半爪","片鳞碎甲"],"usage":"作宾语、定语；用于比喻句"},{"id":30837,"word":"片鳞只甲","pinyin":"piàn lín zhī jiǎ","abbr":"plzj","explanation":"犹片鳞半爪。比喻事物的极小部分。","source":{"text":"昔惟闻海上诸君子传，传诵其诗，有‘入市无屠狗，骄人让沐猴’之句，深以片鳞只甲为憾。","book":"梁启超《饮冰室诗话》"},"similar":["片鳞残甲","片鳞碎甲"],"usage":"作宾语、定语；用于比喻句"},{"id":30838,"word":"片鳞残甲","pinyin":"piàn lín cán jiǎ","abbr":"plcj","explanation":"比喻事物的极小部分。同“片鳞只甲”。","source":{"text":"时或借外国人之著述，窥其片鳞残甲。","book":"梁启超《新史学·中国之旧史学》"},"similar":["片鳞只甲","片鳞半爪"],"usage":"作宾语、定语；用于比喻句"},{"id":30839,"word":"片鳞碎甲","pinyin":"piàn lín suì jiǎ","abbr":"plsj","explanation":"犹片鳞半爪。比喻事物的极小部分。","source":{"text":"虽然，其前此各著述，片鳞碎甲，发明此主义者，固已不少。","book":"梁启超《近世第一大哲康德之学说》"},"similar":["片鳞半爪"],"usage":"作宾语、定语；用于比喻句"},{"id":30840,"word":"版版六十四","pinyin":"bǎn bǎn liù shí sì","abbr":"bblss","explanation":"版：宋代铸钱的模型。每块铸版都是铸出六十四文钱。形容做事死板，不知变通。","source":{"text":"宋·周遵道《豹隐纪谈》记载：宋代凡铸钱，每版六十四文。"},"example":{"text":"～，铸钱定例也，喻不活。","book":"清·范寅《越谚·数目之谚》"},"similar":["板板六十四"],"usage":"作分句；比喻不会变通"},{"id":30841,"word":"版筑饭牛","pinyin":"bǎn zhù fàn niú","abbr":"bzfn","explanation":"版筑，造土墙；饭牛，喂牛。后以之为贤臣出身微贱之典。","source":{"text":"《书·说命上》载：相传商代贤者傅说筑于傅岩，武丁用以为相。《吕氏春秋·举难》载：春秋时卫国贤者宁戚饭牛车下，扣牛角而歌，桓公异之，拜为上卿。"},"example":{"text":"古今相望，落落然如骑星辰，与夫起～者异矣。","book":"唐·刘禹锡《唐故中书侍郎平章事韦公集纪》"},"usage":"作定语；指贤臣的出身","story":["殷代武丁上台后遭遇连年灾荒，他在梦中受到启发，找到傅岩修筑大墙的傅说，任命他为国相，殷国从此大治。春秋时期，齐桓公为了迎接周天子派来的使臣，在城门遇到正在喂牛的宁戚，觉得他有奇才，于是拜他为相国"]},{"id":30842,"word":"牖中窥日","pinyin":"yǒu zhōng kuī rì","abbr":"yzkr","explanation":"牖：窗户。隔着窗子看太阳。比喻见识不广。","source":{"text":"北人看书，如显处视月，罱人学问，如牖中窥日。","book":"南朝宋·刘义庆《世说新语·文学》"},"similar":["管中窥豹","坐井观天"],"usage":"作谓语、宾语；指人的见识","story":["褚季野对孙安国说：“北方人做学问，渊深广阔而博杂。”孙安国回答道：“南方人做学问，清明通达而简洁扼要。”高僧支道林听后说：“圣贤忘言姑不论。以中等人来说，北方人看书，恰如在明处看月亮，南方人做学问好似在窗口看太阳。”"]},{"id":30843,"word":"牙清口白","pinyin":"yá qīng kǒu bái","abbr":"yqkb","explanation":"牙齿洁白，口齿清楚。比喻说话清楚明白。","source":{"text":"怎当得十三妹定要问他个牙白口清，急得无法。","book":"清·文康《儿女英雄传》第九回"}},{"id":30844,"word":"牙牙学语","pinyin":"yá yá xué yǔ","abbr":"yyxy","explanation":"牙牙：象声词，摹拟婴儿学说话的声音。形容婴儿咿咿呀呀地学大人说话的神情。","source":{"text":"二女则牙牙学语，五男则雁雁成行。","book":"唐·司空图《障车文》"},"example":{"text":"丁亥腊月二十七夜，内子举一男，现才～。","book":"清·梁绍壬《两般秋雨庵随笔》卷三"},"similar":["呀呀学语"],"usage":"作谓语、定语；形容小孩说话的神情"},{"id":30845,"word":"牙生辍弦","pinyin":"yá shēng chuò xián","abbr":"yscx","explanation":"牙：伯牙；辍：中止。伯牙活着的时候不复操琴。表示对亡故的知音朋友的沉痛悼念之情。","source":{"text":"昔匠石废斤于郢人，牙生辍弦于钟子，推己外求，良不虚也。","book":"南朝·宋·刘义庆《世说新语·伤逝》"},"example":{"text":"而与而兄实有～之痛，岂但鸰原之悲也。","book":"清·王士慎《带经堂诗话·家学类》"}},{"id":30846,"word":"牙白口清","pinyin":"yá bái kǒu qīng","abbr":"ybkq","explanation":"比喻说话清楚。","source":{"text":"怎当得十三妹定要问他个牙白口清，急得无法，说道：‘姐姐，这事要爹妈作主，怎生的只管问起妹子来？’","book":"清·文康《儿女英雄传》第九回"},"usage":"作谓语、定语；比喻说话清楚"},{"id":30847,"word":"牙签万轴","pinyin":"yá qiān wàn zhóu","abbr":"yqwz","explanation":"形容藏书非常多。","source":{"text":"牙签万轴裹红綃，王粲书同付火烧。","book":"南唐·李煜《题后》诗"},"example":{"text":"称人书多，～。","book":"宋·胡继宗《书言故事·书史》"},"similar":["汗牛充栋"],"usage":"作谓语、定语；形容藏书非常多"},{"id":30848,"word":"牙签犀轴","pinyin":"yá qiān xī zhóu","abbr":"yqxz","explanation":"卷型古书的标签和卷轴。借指书籍。形容书籍之精美。同“牙签玉轴”。","source":{"text":"湘帙缥囊，数起看何止一万卷；牙签犀轴，乘将来彀有三十车。","book":"明·高明《琵琶记·孝妇题真》"},"similar":["牙签锦轴","牙签玉轴"],"usage":"作宾语、定语；用于书面语"},{"id":30849,"word":"牙签玉轴","pinyin":"yá qiān yù zhóu","abbr":"yqyz","explanation":"卷型古书的标签和卷轴。借指书籍。牙，象牙；玉，美玉。形容书籍之精美。","source":{"text":"绮窗绣帘，牙签玉轴，堆列几案。","book":"《隐居通议·古赋一》引宋·傅幼安《味书阁赋》：“黄帘绿幕之闭，牙签玉轴之藏，出则连车，入则充梁。”清·余杯《板桥杂记·丽品》"},"example":{"text":"青衣引徐槐登阁，只见两旁排列书架，架上叠叠书卷，尽是～。","book":"清·俞万春《荡寇志》第一百三十二回"},"similar":["牙签犀轴","牙签锦轴"],"usage":"作宾语、定语；用于书面语"},{"id":30850,"word":"牙签锦轴","pinyin":"yá qiān jǐn zhóu","abbr":"yqjz","explanation":"卷型古书的标签和卷轴。借指书籍。形容书籍之精美。同“牙签玉轴”。","source":{"text":"牙签锦轴吾良友，明窗净几共夷犹。","book":"明·无名氏《赠书记·秘书赠合》"},"example":{"text":"清·荻岸山人《平山冷燕》第三回：“周围都是书厨书架、～，琳琳琅琅。”"},"similar":["牙签犀轴","牙签玉轴"],"usage":"作宾语、定语；用于书面语"},{"id":30851,"word":"牛不出头","pinyin":"niú bù chū tóu","abbr":"nbct","explanation":"讥讽人不肯出头露面。","source":{"text":"李安义于门上大书‘午’字而去。或问其故，答曰：‘牛不出头耳。’","book":"宋·范正敏《遯斋闲览·谐据》"}},{"id":30852,"word":"牛不喝水强按头","pinyin":"niú bù hē shuǐ qiǎng àn tóu","abbr":"nbhsqat","explanation":"比喻用强迫手段使就范。","source":{"text":"鸳鸯道：‘家生女儿怎么样？“牛不吃水强按头”吗？我不愿意，难道杀我的老子娘不成！’","book":"清·曹雪芹《红楼梦》第四十六回"},"example":{"text":"清·曹雪芹《红楼梦》第四十六回：“鸳鸯道：‘家生女儿怎么样？“牛不吃水强按头”吗？我不愿意，难道杀我的老子娘不成！’”"},"similar":["牛不饮水强按头"],"usage":"作宾语、定语；指强迫"},{"id":30853,"word":"牛不喝水难按角","pinyin":"niú bù hē shuǐ nán àn jiǎo","abbr":"nbhsnaj","explanation":"比喻强迫他人干某一件事。","source":{"text":"牛不喝水难按角，你老人家只拿定主意不赌，他会怎的？","book":"清·李绿园《歧路灯》第57回"},"similar":["牛不喝水强按头"],"usage":"作宾语、定语；指强迫"},{"id":30854,"word":"牛不饮水强按头","pinyin":"niú bù yǐn shuǐ qiáng àn tóu","abbr":"nbysqat","explanation":"比喻强迫他人干某一件事。","source":{"text":"牛不饮水强按头尚且不行，何况是婚姻大事。","book":"姚雪垠《李自成》第二卷第九章"},"similar":["牛不喝水强按头"],"usage":"作宾语、定语；指强迫"},{"id":30855,"word":"牛之一毛","pinyin":"niú zhī yī máo","abbr":"nzym","explanation":"牛身上一根毛。比喻微不足道。亦作“九牛一毛”。","source":{"text":"臣知言出必死，而臣自比于牛之一毛，生既无益，死亦何损？","book":"《魏略》"},"example":{"text":"且犹～，何能损益。","book":"《周书·杜杲传》"},"similar":["九牛一毛"],"usage":"作宾语；指微不足道的东西"},{"id":30856,"word":"牛农对泣","pinyin":"niú nóng duì qì","abbr":"nndq","explanation":"睡在牛衣里，相对哭泣。形容夫妻共同过着穷困的生活。","source":{"text":"初，章为渚生学长安，独与妻居。章疾病，无被，卧牛衣中；与妻决，涕泣。","book":"《汉书·王章传》"},"example":{"text":"翁家乏食，借贷无门，典质已尽，搔首踟蹰，～而已。","book":"清·宣鼎《夜雨秋灯录·义猫》"}},{"id":30857,"word":"牛刀割鸡","pinyin":"niú dāo gē jī","abbr":"ndgj","explanation":"杀只鸡用宰牛的刀。比喻大材小用。","source":{"text":"子之武城，闻弦歌之声。夫子莞尔而笑，曰：‘割鸡焉用牛刀。’","book":"《论语·阳货》"},"example":{"text":"旋运只是劳心之所致，小试参同之万一，当如～也。","book":"宋·朱熹《答蔡季通》"},"similar":["大材小用"],"usage":"作补语；比喻大材小用"},{"id":30858,"word":"牛刀小试","pinyin":"niú dāo xiǎo shì","abbr":"ndxs","explanation":"牛刀：宰牛的刀；小试：稍微用一下，初显身手。比喻有大本领的人，先在小事情上略展才能。也比喻有能力的人刚开始工作就表现出才","source":{"text":"读遍牙签三万轴，欲来小邑试牛刀。","book":"宋·苏轼《送欧阳主簿赴官韦城》诗"},"example":{"text":"～义熙前，一日怀归岂偶然。","book":"金·路铎《题邹公所藏渊明归去来图》"},"similar":["初露锋芒","崭露头角"],"usage":"作谓语、定语；用于书面语"},{"id":30859,"word":"牛口之下","pinyin":"niú kǒu zhī xià","abbr":"nkzx","explanation":"喜事从天上掉下来。比喻突然遇到意想不到的喜事。","source":{"text":"贵脚踏践地，使下官喜从天降。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"张顺见了宋江，～。","book":"明·施耐庵《水浒全传》第四十回"},"usage":"作宾语；用于书面语"},{"id":30860,"word":"牛听弹琴","pinyin":"niú tīng tán qín","abbr":"nttq","explanation":"比喻听不懂。","source":{"text":"现在，‘治于人的小人’，要想在无线电的播音里去听清楚昆曲的平上去入，自然是牛听弹琴，一窍不通了。","book":"瞿秋白《乱弹》"},"similar":["对牛弹琴"],"usage":"作宾语、定语；指听不懂"},{"id":30861,"word":"牛头不对马嘴","pinyin":"niú tóu bù duì mǎ zuǐ","abbr":"ntbdmz","explanation":"比喻答非所问或两下不相合。","source":{"text":"皂隶兜脸打一啐，骂道：‘见鬼，大爷自姓高，是江西人，牛头不对马嘴！’","book":"明·冯梦龙《警世通言》第十一卷"},"example":{"text":"只要人家拿他［鲁老爷］一派臭恭维，就是～，他亦快乐。","book":"清·李宝嘉《官场现形记》第十六回"},"similar":["驴唇不对马嘴","答非所问"],"usage":"作宾语、定语、状语；指对不上号"},{"id":30862,"word":"牛头不对马面","pinyin":"niú tóu bù duì mǎ miàn","abbr":"ntbdmm","explanation":"比喻答非所问或对不上号。","source":{"text":"尽其所有写上，都是牛头不对马面。","book":"清·李宝嘉《文明小史》第二十四回"},"similar":["牛头不对马嘴"],"usage":"作宾语、定语、状语；指对不上号"},{"id":30863,"word":"牛头阿旁","pinyin":"niú tóu ē páng","abbr":"ntap","explanation":"佛教称地狱中长着牛头的鬼卒。","source":{"text":"奢肆不法，俄与韦保衡同当国，二人势动天下，时目其党为‘牛头阿旁’，言如鬼阴恶可畏也。","book":"《新唐书·路岩传》"},"similar":["牛首阿旁"],"usage":"作宾语、定语；用于迷信说法"},{"id":30864,"word":"牛头马面","pinyin":"niú tóu mǎ miàn","abbr":"ntmm","explanation":"迷信传说中的两个鬼卒，一个头象牛，一个头象马。比喻各种丑恶的人。","source":{"text":"释迦是牛头狱卒，祖师是马面阿婆。","book":"宋·释道原《景德传灯录》卷十一"},"example":{"text":"只是近来常常在梦中，或是在将醒未醒之顷，一阵悚然，从前所怕的～，都积压了来，都聚围了来。","book":"冰心《山中杂记—遥寄小朋友》"},"similar":["牛鬼蛇神","妖魔鬼怪"],"usage":"作主语、宾语、定语；指凶恶的人"},{"id":30865,"word":"牛山下涕","pinyin":"niú shā xià tì","abbr":"nsxt","explanation":"牛山：在今山东淄博市东。齐景公登上牛山感到终有一死而悲哀下泪。比喻因事物变迁而引起的悲哀。也指不知满足而自寻烦恼。","source":{"text":"景公游于牛山，北临其国城而流涕曰：‘若何滂滂去此而死乎？’","book":"《晏子春秋·谏上》"},"example":{"text":"～何悲苦，发久光华方出土。","book":"清·顾炎武《齐祭器行》"}},{"id":30866,"word":"牛山之悲","pinyin":"niú shān zhī bēi","abbr":"nszb","explanation":"在牛山上发出的悲叹。讥讽因非份之想而引起的悲哀。","example":{"text":"你不觉得～很可笑吗？"},"usage":"作宾语；指因非份之想而引起的悲哀","story":["春秋时期，齐景公吕杵臼是一个生活奢侈又贪图享受的君主，他带丞相晏婴及大臣国惠子、高昭子去牛山山顶游玩，面对都城临淄，齐景公大发感慨，要是自己长生不老永远统治下去该多好，说罢流起了眼泪，大臣随声附和，晏婴觉得可笑"]},{"id":30867,"word":"牛山濯濯","pinyin":"niú shā zhuó zhuó","abbr":"nszz","explanation":"濯濯：光秃，无草木的样子。牛山上光秃秃的。形容寸草不生的荒山。","source":{"text":"牛山之木尝美矣，以其郊于大国也，斧斤伐之，可以为美乎？是其日夜之所息，雨露之所润，非无萌蘖之生焉，牛羊又从而牧之，是以苦彼濯濯也。","book":"《孟子·告子上》"},"example":{"text":"由黑而黄，而灰，而斑，而耄耄然，而稀稀落落，而～，活像一只秃鹫。","book":"梁实秋《老年》"}},{"id":30868,"word":"牛心古怪","pinyin":"niú xīn gǔ guài","abbr":"nxgg","explanation":"指脾气固执、倔强。","source":{"text":"婆子回复了贾政，众人都笑道：‘天生的牛心古怪。’","book":"清·曹雪芹《红楼梦》第二十二回"},"example":{"text":"人家杨羽裳的男朋友成群结队的，从台湾都排到美国了，她才不见得会看上我这个～的哥哥呢！","book":"琼瑶《海鸥飞处》五"}},{"id":30869,"word":"牛星织女","pinyin":"niú xīng zhī nǚ","abbr":"nxzn","explanation":"即牛郎织女。","source":{"text":"迢迢牵牛星，皎皎河汉女。","book":"汉·无名氏《古诗十九首》诗之十"},"example":{"text":"～年年别，分明不及人间物。","book":"宋·张先《菩萨蛮·七夕》词"},"similar":["牛郎织女"],"usage":"作主语、分句、宾语；指分居两地的夫妻"},{"id":30870,"word":"牛毛细雨","pinyin":"niú máo xì yǔ","abbr":"nmxy","explanation":"指细而密的小雨。","source":{"text":"牛毛细雨送斜阳。","book":"清·梁绍壬《两般秋雨庵随笔》卷五"},"example":{"text":"可是连天～，迷迷蒙蒙，不见一丝阳光。","book":"陶承《我的一家》四"},"similar":["斜风细雨"],"opposite":["倾盆大雨","滂沱大雨"],"usage":"作主语、宾语；用于描写小雨"},{"id":30871,"word":"牛渚泛月","pinyin":"niú zhǔ fàn yuè","abbr":"nzfy","explanation":"牛渚：地名，在今安徽当涂县西北长江边；泛月：月夜划船游玩。指才士相逢，以文会友。","source":{"text":"谢尚时镇牛激动得，秋夜乘月，率尔与左右微服泛江。会宏在舫中讽咏，声既清会，辞又藻拔，遂驻听久之。","book":"《晋书·袁宏传》"},"example":{"text":"～，以文会友；牛角挂书，以耕求学。","book":"魏明伦《盖世金牛赋》"},"usage":"作宾语、定语；用于书面语","story":["东晋时期，豫州刺史谢尚镇守牛渚，在一个秋天的月夜里带领手下一帮人，穿着微服在长江上泛游，江面上一船传来咏诗声，于是停船倾听。正逢袁宏在舫中讽咏，声既清会，辞又藻拔。谢尚于是靠近上船与之相会，两人结为好友"]},{"id":30872,"word":"牛溲马勃","pinyin":"niú sōu mǎ bó","abbr":"nsmb","explanation":"牛溲：牛尿，一说车前草，利小便；马勃：可治疮。比喻一般人认为无用的东西，在懂得其性能的人手里可成为有用的物品。","source":{"text":"玉札丹砂，赤箭青芝，牛溲马勃，败鼓之皮，俱收并蓄，待用无遗者，医师之良也。","book":"唐·韩愈《进学解》"},"example":{"text":"某不佞，闻古有助于人者，～亦不却也。","book":"明·王世贞《与樊侍御书》"},"similar":["无足轻重","鸡毛蒜皮","微不足道"],"opposite":["价值连城","无价之宝","奇货可居"],"usage":"作主语、宾语、定语；指卑贱而有用之材","story":["唐朝文学家韩愈在任国子监祭酒时，经常给太学生讲课，要求他们“业精于勤荒于嬉，行成于思毁于随”，同时要求他们注意社会实践，要兼收并蓄，“牛溲马勃、败鼓之皮”都有它们的用途，鼓励学生加强学习，灵活运用"]},{"id":30873,"word":"牛溲马渤","pinyin":"niú sōu mǎ bó","abbr":"nsmb","explanation":"牛溲，即牛遗，车前草的别名。马勃，一名马牷，一名屎菰，生于湿地及腐木的菌类。均可入药。比喻虽然微贱但是有用的东西。渤，通勃。","source":{"text":"收牛溲马渤入药笼，用之得宜，其价值反在参苓之上。","book":"清·李渔《闲情偶寄·居室·房舍》"},"example":{"text":"清·李渔《闲情偶寄·居室·房舍》：“收～入药笼，用之得宜，其价值反在参苓之上。”"},"similar":["牛溲马勃"],"usage":"作主语、宾语、定语；指卑贱而有用之材"},{"id":30874,"word":"牛皮大王","pinyin":"niú pí dà wáng","abbr":"npdw","explanation":"牛皮：指虚套的话。指会吹嘘而不干实事的人。","example":{"text":"他堪称公司里的～。"},"usage":"作主语、宾语、定语；指会吹嘘的人"},{"id":30875,"word":"牛眠吉地","pinyin":"niú mián jí dì","abbr":"nmjd","explanation":"吉：吉祥。指有助于后代升官发财的坟地。","source":{"text":"遇一老父，谓曰：‘前冈见一牛眠山污中，其地若葬，位极人臣矣。’","book":"《晋书·周光传》"},"example":{"text":"火化了多干净，却定要找～，不劳而获好子孙，能做大官大财。","book":"范文澜《写景文抄·序》"},"similar":["牛眠地","牛眠龙绕"],"usage":"作宾语、定语；用于迷信说法","story":["传说晋代时期，陶侃年轻时死了父亲，将要进行安葬，家中忽然丢失了一头牛，怎么也找不到。他在找牛的途中遇到一个老汉，老汉告诉他：“前冈见一牛眠山污中，其地若葬，位极人臣矣。”陶侃按照老汉所指，葬其父于此，后来果然做了大官"]},{"id":30876,"word":"牛眠地","pinyin":"niú mián dì","abbr":"nmd","explanation":"迷信者指所谓有利于后代升官发财的坟地。","source":{"text":"陶侃微时，丁艰，将葬，家中忽失牛而不知所在。遇一老夫，谓曰：‘前冈见一牛眠山污中，其地若葬，位极人臣矣。’","book":"《晋书·周光传》"},"example":{"text":"《晋书·周光传》：“陶侃微时，丁艰，将葬，家中忽失牛而不知所在。遇一老夫，谓曰：‘前冈见一牛眠山污中，其地若葬，位极人臣矣。’”"},"similar":["牛眠吉地","牛眠龙绕"],"usage":"作宾语、定语；用于迷信说法"},{"id":30877,"word":"牛眠龙绕","pinyin":"niú mián lóng rào","abbr":"nmlr","explanation":"形容坟地风水好。","source":{"text":"那东门外头许多牛眠龙绕的吉地，那富贵人家的茔田多半在这里。","book":"清·蒲松龄《东郭外传》"},"similar":["牛眠地","牛眠吉地"],"usage":"作宾语、定语；用于迷信说法"},{"id":30878,"word":"牛童马走","pinyin":"niú tóng mǎ zǒu","abbr":"ntmz","explanation":"旧时泛指地位卑下的人。牛童，牧童；马走，犹仆役。","source":{"text":"然而二十年间，禁省、观寺、邮候墙壁之上无不书，王公妾妇、牛童马走之口无不道。","book":"唐·元稹《〈白氏长庆集〉序》"},"example":{"text":"其大节岳岳磊磊，在人耳目，虽耕夫贩妇，～，共能称道者。","book":"陈衍《元诗纪事·青城行》"},"usage":"作宾语、定语；用于书面语"},{"id":30879,"word":"牛羊勿践","pinyin":"niú yáng wù jiàn","abbr":"nywj","explanation":"勿使牛羊践踏。比喻爱护。","source":{"text":"草木方茂盛，以其终将为人用，故周之先王为此爱之，况于人乎？","book":"语出《诗·大雅·行苇》：“敦彼行苇，牛羊勿践履，方苞方体，维叶泥泥。”郑玄笺"},"example":{"text":"况于有德有造，成人之材，～，遂物之性，可望其仿佛乎？","book":"宋·曾巩《拟代廷试进士策问二》"},"usage":"作宾语、定语；用于书面语"},{"id":30880,"word":"牛衣夜哭","pinyin":"niú yī yè kū","abbr":"nyyk","explanation":"形容夫妻共同过着穷困的生活。同“牛衣对泣”。","source":{"text":"今则阮路兴悲，商歌结恨；牛衣夜哭，马柱晨吟。","book":"唐·温庭筠《上裴舍人启》"},"similar":["牛衣对泣"],"usage":"作宾语、定语；指贫贱夫妻"},{"id":30881,"word":"牛衣对泣","pinyin":"niú yī duì qì","abbr":"nydq","explanation":"睡在牛衣里，相对哭泣。形容夫妻共同过着穷困的生活。","source":{"text":"初，章为渚生学长安，独与妻居。章疾病，无被，卧牛衣中；与妻决，涕泣。","book":"《汉书·王章传》"},"example":{"text":"翁家乏食，借贷无门，典质已尽，搔首踟蹰，～而已。","book":"清·宣鼎《夜雨秋灯录·义猫》"},"similar":["牛衣夜哭"],"usage":"作宾语、定语；指贫贱夫妻","story":["汉朝书生王章到京城长安读书，学习成绩十分优秀，因为家里很穷，只好与妻子躺在盖牛用的蓑衣里御寒。一天生病，他担心自己会死，与妻子在蓑衣里相对哭泣。后来当官，因看不惯汉成帝的舅舅王凤专权，不听妻子的劝告上书而被赐死"]},{"id":30882,"word":"牛衣岁月","pinyin":"niú yī suì yuè","abbr":"nysy","explanation":"指贫困的生活。","source":{"text":"织屦辟纑终古事，牛衣岁月即羲皇。","book":"清·曾国藩《送妹夫王五归》诗之四"},"usage":"作宾语、定语；用于生活"},{"id":30883,"word":"牛衣病卧","pinyin":"niú yī bìng wò","abbr":"nybw","explanation":"形容贫病交迫。","source":{"text":"便羊裘归去，难留严子；牛衣病卧，肯泣王章？","book":"宋·刘克庄《沁园春·再和林卿韵》词"},"usage":"作宾语、定语；用于人的处境","story":["汉朝书生王章到京城长安读书，学习成绩十分优秀，因为家里很穷，只好与妻子躺在盖牛用的蓑衣里御寒。一天生病，他担心自己会死，与妻子在蓑衣里相对哭泣。后来当官，因看不惯汉成帝的舅舅王凤专权，不听妻子的劝告上书而被赐死"]},{"id":30884,"word":"牛角之歌","pinyin":"niú jiǎo zhī gē","abbr":"njzg","explanation":"后为穷士自求用世的典故。","source":{"text":"春秋时，宁戚很穷，想见齐桓公而出仕，一天，乘桓公出城迎客的机会，在车下喂牛，“扣牛角疾歌”。桓公闻而赞其为“非常人”，命后车载之，拜为上卿。见《吕氏春秋·举难》、《晏子春秋·问下二》。汉·刘向《说苑·尊贤》亦载此事。"},"example":{"text":"夫～，辞鄙而义拙；堂下之言，不书于传记。","book":"唐·韩愈《上兵部李侍郎书》"},"usage":"作宾语；用于书面语","story":["春秋时期，寒士宁戚很穷，渴求见到齐桓公拜求官职。一天，齐桓公出城迎客，宁戚乘机在车下喂牛，敲击牛角唱出自己的心声，齐桓公听到后称赞他为“非常人”，就拜他为上卿。宁戚为齐桓公成就霸业做出了很大的贡献"]},{"id":30885,"word":"牛角书生","pinyin":"niú jiǎo shū shēng","abbr":"njss","explanation":"比喻勤奋读书的人。","source":{"text":"以蒲鞯乘牛，挂《汉书》一帙角上，行且读。","book":"《新唐书·李密传》"},"example":{"text":"～，虬髯豪客，谈笑皆堪折简招。","book":"宋·刘克庄《沁园春·答九华叶贤良》词"},"usage":"作宾语；比喻勤奋读书的人","story":["唐朝时期，李密年轻时听说包恺在缑山，就前去拜他为师，他骑在牛背上，把《汉书》挂在牛角上，边走边读。越国公杨素刚好在路上看到，骑马跟在他的后面问他为什么这样勤奋。李密见是杨素就回答说在看项羽传，因而被叫做牛角书生"]},{"id":30886,"word":"牛角挂书","pinyin":"niú jiǎo guà shū","abbr":"njgs","explanation":"比喻读书勤奋。","source":{"text":"闻包恺在缑山，往从之。以蒲鞯乘牛，挂《汉书》一帙角上，行且读。","book":"《新唐书·李密传》"},"example":{"text":"我们要学习他～的读书精神。"},"usage":"作定语；指勤奋读书","story":["唐朝时期，李密年轻时听说包恺在缑山，就前去拜他为师，他骑在牛背上，把《汉书》挂在牛角上，边走边读。越国公杨素刚好在路上看到，骑马跟在他的后面问他为什么这样勤奋。李密见是杨素就回答说在看项羽传入迷了"]},{"id":30887,"word":"牛蹄中鱼","pinyin":"niú tí zhōng yú","abbr":"ntzy","explanation":"牛蹄：是指牛蹄印里的积水。牛蹄印坑里的鱼。比喻死期迫近。","source":{"text":"诚恐将为牛蹄中鱼，卒鲍氏之肆矣。","book":"三国（魏）·应璩《与韦仲将书》"},"example":{"text":"晋·陈寿《三国志·吴志·吕蒙传》：“今子太以旦夕之命，待不可望之数，犹～，冀赖江汉，其不可恃亦明矣。”"},"similar":["牛蹄之鱼"],"usage":"作主语、宾语、定语；用于比喻句","story":["战国时期，宋国庄周家贫，一次向他的朋友监河侯借粮食时，朋友推说等收了租再借给他。他给朋友讲：路上遇到一条牛蹄印里水快干的鲫鱼向他求助，他答应鲫鱼说到要去吴国越国去给他借水，鲫鱼说等你回来时，我已经挂在鱼肆了"]},{"id":30888,"word":"牛蹄之涔","pinyin":"niú tí zhī cén","abbr":"ntzc","explanation":"涔：雨水。牛蹄印中的积水。形容水量极少。也比喻处在不能有所作为的境地。","source":{"text":"况复一枝倦曲，终危九层之台；一股涔蹄，必伤千里之驾。","book":"《淮南子·汜论训》：“夫牛蹄之涔，不能生鳣鲔。”《淮南子·俶真》：“牛蹄之涔，无尺之鲤。”北周·庾信《为杞公让宗师表》"},"usage":"作宾语；用于比喻句"},{"id":30889,"word":"牛蹄之鱼","pinyin":"niú tí zhī yú","abbr":"ntzy","explanation":"牛蹄印坑里的鱼。比喻死期迫近。同“牛蹄中鱼”。","source":{"text":"且今已乏矣，而方须租人，是犹古人欲决江海以救牛蹄之鱼之类也。","book":"《孔丛子·连丛子下》"},"similar":["牛蹄中鱼"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":30890,"word":"牛郎织女","pinyin":"niú láng zhī nǚ","abbr":"nlzn","explanation":"牛郎织女为神话人物，从牵牛星、织女星的星名衍化而来。比喻分居两地的夫妻。也泛指一对恋人。","source":{"text":"迢迢牵牛星，皎皎河汉女。纤纤擢素手，札札弄机杼。终日不成章，泣涕零如雨。河汉清且浅，相去复几许？盈盈一水间，脉脉不得语。","book":"《古诗十九首》"},"example":{"text":"尝笔唐人《七夕》诗，咏～，皆作会别可怜之语，殊失命名本旨。","book":"清·郑燮《范县署中寄余弟墨粉四书》"},"similar":["牛星织女"],"usage":"作主语、分句、宾语；指分居两地的夫妻","story":["传说古代玉帝的孙女织女擅长织布，每天给天空织彩霞，她讨厌这枯燥的生活，就偷偷下到凡间，私自嫁给河西的牛郎，过上男耕女织的生活，此事惹怒了玉帝，把织女捉回天宫，责令他们分离，只允许他们每年的七月七日在鹊桥上相会一次"]},{"id":30891,"word":"牛饩退敌","pinyin":"niú xì tuì dí","abbr":"nxtd","explanation":"饩：活的牲口。用牛羊击退敌军。","source":{"text":"弦高以牛饩退敌，墨翟以萦带全城。","book":"南朝·宋·范晔《后汉书·张衡传》"},"usage":"作宾语、定语；用于书面语","story":["春秋时期，秦国人杞子在郑国掌握了都城北门的钥匙，派人要秦穆公攻打郑国。秦穆公不听蹇叔的劝告，派大将孟明视等率军出征。郑国商人弦高发现秦军动向，假装送牛羊迎接秦军，背后通风报信，秦军只好退走。晋国乘机出兵打败秦军"]},{"id":30892,"word":"牛首阿旁","pinyin":"niú shǒu ē páng","abbr":"nsap","explanation":"佛教中指地狱牛头、牛脚的鬼卒。","source":{"text":"即有牛首阿旁，执公文至，即以利叉刺入油鼎。","book":"清·蒲松龄《聊斋志异·阎罗梦》"},"example":{"text":"人类于是整顿废弛，先给～以最高的俸草。","book":"鲁迅《野草·失掉的好地狱》"},"similar":["牛头阿旁"],"usage":"作宾语、定语；用于迷信说法"},{"id":30893,"word":"牛马不若","pinyin":"niú mǎ bù ruò","abbr":"nmbr","explanation":"若；如。不如牛和马。形容极其劳苦。","source":{"text":"人生做吏甚苦，而做令尤苦，若做吴令则苦万万倍，直牛马不若矣。","book":"明·袁宏道《袁郎中全集·与沈凤翔书》"},"example":{"text":"中国之萎靡，非自今日始。迨秦政起而实行压制，百姓俯首贴耳，～矣。","book":"吴弱男《问中国如何能独立》"},"usage":"作宾语、定语；指十分劳苦"},{"id":30894,"word":"牛马易头","pinyin":"niú mǎ yì tóu","abbr":"nmyt","explanation":"把牛和马的头互换。旧时形容杂技技巧精妙。","source":{"text":"永宁元年，掸国王雍由调复遣使者诣阙朝贺，献乐及幻人，能变化吐水，自支解，易牛马头。","book":"《后汉书·西南夷传》"}},{"id":30895,"word":"牛马生活","pinyin":"niú mǎ shēng huó","abbr":"nmsh","explanation":"比喻饱受压迫剥削的非人生活。","source":{"text":"我所做的只是捐了一天的薪水所得，救济在日本纱厂里过牛马生活，罢工后饥寒交迫的中国同胞。","book":"邹韬奋《经历·高三分院》"},"usage":"作宾语、定语；指非人生活"},{"id":30896,"word":"牛马襟裾","pinyin":"niú mǎ jīn jú","abbr":"nmjj","explanation":"犹言衣冠禽兽。","source":{"text":"教人道这乔男女，则是些牛马襟裾。","book":"元·石德玉《秋胡戏妻》第三折：“我骂你个沐猴冠冕，牛马襟裾。”元·无名氏《举案齐眉》第一折"},"similar":["衣冠禽兽","沐猴冠冕"],"usage":"作宾语、定语；用于比喻句"},{"id":30897,"word":"牛马走","pinyin":"niú mǎ zǒu","abbr":"nmz","explanation":"本义指在皇帝驾前像牛马一样跑前跑后的人。也泛指供驱使奔走的人。","source":{"text":"太史公牛马走。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"缘大僚位重，这门下的～，官儿们还都要有以知其姓字为通窍的能员，何况大人之本族弟侄？","book":"清·李绿园《歧路灯》第一○七回"},"usage":"作宾语、定语；用于自谦"},{"id":30898,"word":"牛马风尘","pinyin":"niú mǎ fēng chén","abbr":"nmfc","explanation":"牛马被置于风尘里。比喻人正处于不得志的时候。也形容人奔走于道途，非常劳累。","source":{"text":"牛马风尘，暂屈何忧，刀笔吏丞相根由；人笑骂，我不羞。","book":"清·孔尚任《桃花扇·迎驾》"}},{"id":30899,"word":"牛骥共牢","pinyin":"niú jì gòng láo","abbr":"njgl","explanation":"骥：好马。牛跟马同槽。比喻不好的人与贤人共处。","source":{"text":"及其无事也，则牛骥共牢，利钝齐列，而无长涂犀革以决之，此离朱与瞽者同眼之说也。","book":"《晋书·张载传》"},"similar":["牛骥同槽","牛骥同皂"],"usage":"作谓语、定语；指贤愚不分"},{"id":30900,"word":"牛骥同槽","pinyin":"niú jì tóng cáo","abbr":"njtc","explanation":"指牛与千里马同槽而食。比喻贤愚不分。同“牛骥同皂”。","source":{"text":"牛骥同槽，郭氏以亡。","book":"汉·焦赣《易林·升之小畜》"},"similar":["牛骥同皂","牛骥共牢"],"usage":"作谓语、定语；指贤愚不分"},{"id":30901,"word":"牛骥同皁","pinyin":"niú jì tóng wěn","abbr":"njtz","explanation":"指牛与千里马同槽而食。比喻贤愚不分。亦作“牛骥同槽”。"},{"id":30902,"word":"牛骥同皂","pinyin":"niú jì tóng zào","abbr":"njtz","explanation":"皂：牲口槽。牛跟马同槽。比喻不好的人与贤人同处。","source":{"text":"使不羁之士与牛骥同皂，此鲍焦所以忿于世而不留富贵之乐也。","book":"汉·邹阳《狱中上梁王书》"},"similar":["牛骥同槽","牛骥共牢","鱼龙混杂"],"usage":"作谓语；比喻贤愚不分"},{"id":30903,"word":"牛高马大","pinyin":"niú gāo mǎ dà","abbr":"ngmd","explanation":"比喻人长得高大强壮。","source":{"text":"东宁县县委书记刘番成长得浓眉大眼，牛高马大。","book":"《小说月报》1981年第1期"},"example":{"text":"三人中那位五十来岁，～、脸色黧黑的壮年人，抬头看见方爱华的小轿车。","book":"牧夫《相思豆》一"},"similar":["高大威猛"],"usage":"作谓语、定语；用于口语"},{"id":30904,"word":"牛鬼蛇神","pinyin":"niú guǐ shé shén","abbr":"ngss","explanation":"牛头的鬼，蛇身的神。原形容虚幻怪诞。后比喻社会上形形色色的坏人。","source":{"text":"鲸吸鳌掷，牛鬼蛇神，不足为其虚荒诞幻也。","book":"唐·李贺《李贺集序》"},"example":{"text":"更有一种可笑的，肚子里原没有什么，东拉西扯，弄得～，还自以为奥博。","book":"清·曹雪芹《红楼梦》第八十二回"},"similar":["牛头马面","妖魔鬼怪","蛇神牛鬼"],"usage":"作主语、宾语、定语；指坏人","story":["唐朝时期，多才而短命的诗人李贺留下不少著名的诗篇，例如“雄鸡一唱天下白”、“黑云压城城欲摧”等名句，至今被人传诵，诗人杜牧还专门给他写《李贺诗序》，评价他的诗为：“鲸呿鳌掷，牛鬼蛇神，不足为其虚荒诞幻也。”"]},{"id":30905,"word":"牛黄狗宝","pinyin":"niú huáng gǒu bǎo","abbr":"nhgb","explanation":"牛黄，牛胆囊中的结石；狗宝，狗脏器中的凝结物。两者都是内脏病变的产物，因以喻坏透了的心肠。","source":{"text":"绝命丹内只五般，牛黄狗宝一处攒；水片人参为细末，斗大珠子用半边。","book":"明·支部　道人《平鬼传》第三回"},"example":{"text":"我有本事先把你两个的～掏了出来，再和那泼妇拼了这命，也不算是尤三姑奶奶！","book":"清·曹雪芹《红楼梦》第六十五回"},"usage":"作宾语、定语；用于比喻句"},{"id":30906,"word":"牛鼎烹鸡","pinyin":"niú dǐng pēng jī","abbr":"ndpj","explanation":"用煮一头牛的大锅煮一只鸡。比喻大材小用。","source":{"text":"市丘之鼎以烹鸡，多洎之则淡而不可食，少洎则焦而不熟。","book":"《吕氏春秋·应言》"},"example":{"text":"凤衰尺鷃聊栖竹，～只损盐。料粟太仓官琐尾，中流一砖用廉纤。","book":"清·王夫之《读甘蔗生遣兴诗次韵而和之》"},"similar":["大材小用"],"usage":"作宾语、定语；指大材小用","story":["东汉末年，汉灵帝刘宏立何妃为皇后，重用何妃的同父异母的哥哥何进为大将军。何进把名气很大的边让抓去当一名小小的令史，文人蔡邕拜见何进，说边让是难得的奇才，不能用牛鼎烹鸡的方法对待。何进觉得有理，就让边让去做九江太守"]},{"id":30907,"word":"牝咮鸣辰","pinyin":"pìn zhòu míng chén","abbr":"pzmc","explanation":"母鸡报晓。旧时比喻妇女窃权乱政。同“牝鸡司晨”。","source":{"text":"反天之刚，挠阳之明，卒使牝咮鸣辰，胙移后家，可不哀哉！","book":"《新唐书·长孙无忌褚遂良等传赞》"},"similar":["牝鸡司晨"],"usage":"作宾语、定语；指女子掌权当政"},{"id":30908,"word":"牝哹鸣辰","pinyin":"pìn zhòu míng chén","abbr":"pzmc","explanation":"母鸡报晓。旧时比喻妇女窃权乱政。同牝鸡司晨”。"},{"id":30909,"word":"牝牡骊黄","pinyin":"pìn mǔ lí huáng","abbr":"pmlh","explanation":"骊：黑色。原意是观察事物要注重本质，不在乎外表怎样，后比喻事物的表面现象。","source":{"text":"《列子·说符》"},"example":{"text":"亮不肖无状，为天人之所共弃，叔度独略其～而友其人，关其休戚。","book":"宋·陈亮《祭潘叔度文》"},"similar":["骊黄牝牡"],"usage":"作宾语、定语；比喻事物的表面现象","story":["春秋时期，秦穆公让孙阳（伯乐）挑选出很多千里马。伯乐老了，秦穆公问他有没有继承人，他推荐九方皋。九方皋出去找了三个月回来说在沙丘有匹黄色的母马，可派人牵回一匹纯黑的公马是匹好马。伯乐认为九方皋更能相出马的内在素质"]},{"id":30910,"word":"牝鸡之晨，惟家之索","pinyin":"pìn jī zhī chén，wéi jiā zhī suǒ","abbr":"pjzcwjzs","explanation":"牝鸡：母鸡；索：尽。母鸡在早晨打鸣，这个家庭就要败落。比喻妇女篡权乱政。","source":{"text":"牝鸡无晨。牝鸡之晨，惟家之索。","book":"《尚书·牧誓》"},"example":{"text":"～。妾以妇人，岂敢闻政事？","book":"宋·孔平仲《续世说·贤媛》"},"similar":["牝鸡司晨，惟家之索"],"usage":"作宾语、定语；用于书面语"},{"id":30911,"word":"牝鸡司旦","pinyin":"pìn jī sī dàn","abbr":"pjsd","explanation":"母鸡报晓。旧时比喻妇女窃权乱政。同“牝鸡司晨”。","source":{"text":"数年以来，荒悖滋基，牝鸡司旦，昵近奸回。","book":"《隋书·高励传》"},"example":{"text":"争奈～，雄狐作奸，却使太阳回照，虹霓蔽天。","book":"明·屠隆《彩毫记·祖饯都门》"},"similar":["牝鸡司晨"],"usage":"作谓语、宾语、分句；指女子掌权当政"},{"id":30912,"word":"牝鸡司晨","pinyin":"pìn jī sī chén","abbr":"pjsc","explanation":"母鸡报晓。旧时比喻妇女窃权乱政。","source":{"text":"牝鸡无晨。牝鸡之晨，惟家之索。","book":"《尚书·牧誓》"},"example":{"text":"听谗信佞，残杀忠良，驱逐正士，播弃黎老，昵比匪人，惟以妇言是用，此“～，惟家之索。”","book":"明·许仲琳《封神演义》第七回"},"similar":["阴差阳错","牝鸡司旦"],"usage":"作谓语、宾语、分句；指女子掌权当政","story":["商纣王进攻苏国得到美女“妲己”，妲己看到蚂蚁爬上铜火盆被烫死，就告诉商纣王，纣王命人做两根铜柱，把犯人绑在铜柱上，用火烧热铜柱叫“炮烙”。周武王姬发灭掉了商朝后感慨地说老母鸡一旦打鸣，家境就要衰落了"]},{"id":30913,"word":"牝鸡司晨，惟家之索","pinyin":"pìn jī sī chén，wéi jiā zhī suǒ","abbr":"pjscwjzs","explanation":"牝：雌性的；索：尽。母鸡在清晨打鸣，这个家庭就要破败。比喻女性掌权，颠倒阴阳，会导致家破国亡。","source":{"text":"如陛下荒淫酒色，昵比匪人，惟以妇言是用，此牝鸡司晨，惟家之索。","book":"明·许仲琳《封神演义》第七回"},"similar":["牝鸡之晨，惟家之索"],"usage":"作宾语、定语；用于书面语"},{"id":30914,"word":"牝鸡无晨","pinyin":"pìn jī wú chén","abbr":"pjwc","explanation":"母鸡不报晓。比喻妇女不掌朝政。","source":{"text":"牝鸡无晨。牝鸡之晨，惟家之索。","book":"《尚书·牧誓》"},"example":{"text":"后妃之际，阴教规矩，夏德涂山，周赞文母，～，中馈有主。","book":"唐·皮日休《忧赋》"},"usage":"作宾语、定语；用于书面语"},{"id":30915,"word":"牝鸡晨鸣","pinyin":"pìn jī chén míng","abbr":"pjcm","explanation":"牝鸡：母鸡；司晨：报晓。母鸡报晓。旧时比喻妇女窃权乱政。","source":{"text":"至于居丧淫宴之愆，三年载弄之丑，反道违常之衅，牝鸡晨鸣之慝，于事已细，故可得而略也。","book":"《尚书·牧誓》：“牝鸡无晨。牝鸡之晨，惟家之索。”《南齐书·东昏侯本纪》"},"example":{"text":"如有聪明才智，识达古今，正当辅佐君子，助其不足，必无牝鸡晨鸣，以致祸也。","book":"北齐·颜之推《颜氏家训·治家》"},"similar":["牝鸡司晨"],"usage":"作谓语、宾语、分句；指女子掌权当政"},{"id":30916,"word":"牝鸡牡鸣","pinyin":"pìn jī mǔ míng","abbr":"pjmm","explanation":"母鸡报晓。旧时比喻妇女窃权乱政。同“牝鸡司晨”。","source":{"text":"《书》诫牝鸡牡鸣，《诗》刺哲妇丧国。","book":"南朝·宋·范晔《后汉书·杨震传》"},"similar":["牝鸡晨鸣"],"usage":"作宾语、定语；指女子掌权当政"},{"id":30917,"word":"牡丹花好，终须绿叶扶持","pinyin":"mǔ dān huā hǎo，zhōng xū lǜ yè fú chí","abbr":"mdhhzxlyfc","explanation":"比喻人不管有多大能耐，总得有人帮助。","source":{"text":"有了银钱，却又只怕没人，又道是：牡丹花好，终须绿叶扶持。","book":"清·文康《儿女英雄传》第19回"},"similar":["牡丹虽好，也得绿叶扶持"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":30918,"word":"牡丹虽好，也得绿叶扶持","pinyin":"mǔ dān suī hǎo，yě dé lǜ yè fú chí","abbr":"mdshydlyfc","explanation":"比喻人不管有多大能耐，总得有人帮助。","source":{"text":"‘牡丹虽好，也得绿叶扶持’哩。你自家一个，就歪歪到那里去？","book":"清·西周生《醒世姻缘传》第95回"},"similar":["牡丹虽好，全仗绿叶扶持"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":30919,"word":"牡丹虽好，全仗绿叶扶持","pinyin":"mǔ dān suī hǎo，quán zhàng lǜ yè fú chí","abbr":"mdshqzlyfc","explanation":"比喻人不管有多大能耐，总得有人在旁协助。","source":{"text":"俗话说的，‘牡丹虽好，全仗绿叶扶持’，太太们不亏了凤丫头，那些人还帮着吗！","book":"清·曹雪芹《红楼梦》第一一零回"},"example":{"text":"本来中国有句老古话：～。光是一朵牡丹花，并不好看，必待带叶，然后完成了牡丹之美。","book":"《茅盾散文集·杂感随想·花与叶》"},"similar":["牡丹虽好，全凭绿叶扶持"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":30920,"word":"牡丹虽好，全凭绿叶扶持","pinyin":"mǔ dān suī hǎo，quán píng lǜ yè fú chí","abbr":"mdshqplyfc","explanation":"比喻人不管有多大能耐，总得有人在旁协助。","source":{"text":"也不像两个人打，就如一对猛虎争餐，擂台上流做一团。牡丹虽好，全凭绿叶扶持。","book":"清·褚人获《隋唐演义》第十二回"},"example":{"text":"你说有了儿子么？‘～’。","book":"清·西周生《醒世姻缘传》第三十二回"},"similar":["牡丹虽好，全仗绿叶扶持"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":30921,"word":"牡丹虽好，终须绿叶扶持","pinyin":"mǔ dān suī hǎo，zhōng xū lǜ yè fú chí","abbr":"mdshzxlyfc","explanation":"扶持：扶助。比喻再好的事物也要有个帮衬。","source":{"text":"有了银钱，却又只怕没人，又道是‘牡丹花好，终须绿叶扶持’。","book":"清·文康《儿女英雄传》第十九回"}},{"id":30922,"word":"牢不可拔","pinyin":"láo bù kě bá","abbr":"lbkb","explanation":"牢：牢固。异常坚固，不能攻破。形容人的意志坚定或态度固执、不能动摇。","source":{"text":"根深蒂固，牢不可拔。","book":"宋·郑褒《原祭》"},"similar":["牢不可破"],"usage":"作谓语、定语；指非常坚固"},{"id":30923,"word":"牢不可破","pinyin":"láo bù kě pò","abbr":"lbkp","explanation":"牢：牢固。异常坚固，不可摧毁。也用在指人固执己见或保守旧习。","source":{"text":"并为一谈，牢不可破。","book":"唐·韩愈《平淮西碑》"},"example":{"text":"我们的团结和友谊是～的。"},"similar":["稳如泰山","坚不可摧"],"opposite":["溃不成军","一触即溃"],"usage":"作谓语、定语；指非常坚固","story":["东晋时期，北方前秦王苻坚发动入侵东晋的战争，晋朝大将朱序奉命镇守襄阳，前秦军将襄阳围得水泄不通。朱序的母亲韩氏登上城楼察看地形，组织妇女另造一座城内新城，它非常坚固，牢不可破。苻坚对新城无可奈何"]},{"id":30924,"word":"牢什古子","pinyin":"láo shí gǔ zi","abbr":"lsgz","explanation":"指讨厌的东西。","source":{"text":"关在这牢坑里，学这牢什古子。","book":"清·曹雪芹《红楼梦》第36回"},"similar":["牢什子"],"usage":"作宾语；用于方言"},{"id":30925,"word":"牢甲利兵","pinyin":"láo jiǎ lì bīng","abbr":"ljlb","explanation":"犹坚甲利兵。泛指精良的武器。","source":{"text":"当此之时，非有牢甲利兵，劲弩强冲也。","book":"西汉·刘安《淮南子·兵略训》"},"similar":["坚甲厉兵"],"usage":"作宾语、定语；用于战争等"},{"id":30926,"word":"牢落陆离","pinyin":"láo luò lù lí","abbr":"llll","explanation":"牢落：寥落；陆离：参差。形容空旷参差。","source":{"text":"牢落陆离，烂漫远迁。","book":"汉·司马相如《上林赋》"}},{"id":30927,"word":"牢骚满腹","pinyin":"láo sāo mǎn fù","abbr":"lsmf","explanation":"指人的一肚子委曲、不满的情绪。","source":{"text":"自己这一年来，牢骚满腹，一触即发。","book":"钱钟书《围城》"},"example":{"text":"他对上级的分工总是～。"},"similar":["满腹怨气"],"usage":"作谓语、定语；形容人的不满情绪"},{"id":30928,"word":"牧猪奴戏","pinyin":"mù zhòu nú xì","abbr":"mznx","explanation":"对赌博的鄙称。","source":{"text":"樗蒲者，牧猪奴戏耳！","book":"《晋书·陶侃传》"},"example":{"text":"樗蒱为～，奈何得遇主知？","book":"蔡东藩《唐史演义》第四十七回"},"usage":"作宾语、定语；用于书面语"},{"id":30929,"word":"牧竖之焚","pinyin":"mù shù zhī fén","abbr":"mszf","explanation":"牧竖：放牧的小儿；焚：焚烧。原指秦始皇陵墓被放牧的小孩焚烧。后比喻意外的灾难。","source":{"text":"其后牧儿亡羊，羊入其凿，牧者持火照求羊，失火烧其臧槨。自古至今，葬未有盛如始皇也，数年之间，外被项籍之灾，内罹牧竖之祸，岂不哀哉？","book":"《汉书·刘向传》"},"example":{"text":"外罹西楚之祸，内受～。","book":"晋·潘岳《西征赋》"}},{"id":30930,"word":"牧豕听经","pinyin":"mù shǐ tīng jīng","abbr":"mstj","explanation":"一面放猪，一面听讲。比喻求学努力。","source":{"text":"少孤，年八岁为人牧豕。乡里徐子盛者，以《春秋经》授诸生数百人，宫过息庐下，乐其业，因就听经，遂请留门下，为诸生拾薪。","book":"《后汉书·承宫传》"},"usage":"作谓语、定语；指读书勤奋","story":["汉朝时期，承宫很小就成为孤儿，靠给别人放牧猪羊为生。乡里徐子盛老师给数百个学生讲解《春秋经》，8岁的承宫偷偷躲在教室的外面，边放猪边听老师讲解，十分入迷，就想方设法请老师让他进教室听课，作为交换条件是为师生捡柴草"]},{"id":30931,"word":"物不平则鸣","pinyin":"wù bù píng zé míng","abbr":"wbpzm","explanation":"鸣：发出声音，指有所抒发或表示。指受到委曲和压迫就要发出不满和反抗的呼声。","source":{"text":"大凡物不得其平则鸣。","book":"唐·韩愈《送孟东野序》"},"example":{"text":"怨不得芳官。自古说：～。","book":"清·曹雪芹《红楼梦》第五十八回"},"similar":["不平则鸣","不平而鸣"],"usage":"作谓语、定语、分句；用于书面语","story":["唐朝时期，文学家韩愈的学生孟东野熟读经史，很有才能，直到50岁才做溧阳县蔚，因而常抱怨自己怀才不遇。韩愈十分同情，并在孟赴任时写《送孟东野序》赠别：“大凡物不得其平则鸣，草木之无声，风挠之鸣；水之无声，风荡之鸣。”"]},{"id":30932,"word":"物与民胞","pinyin":"wù yǔ mín bāo","abbr":"wymb","explanation":"物为同类，民为同胞。泛指爱人和一切物类。","source":{"text":"天地之帅，吾其性，民吾同胞，物吾与也。","book":"宋·张载《西铭》"},"example":{"text":"掀天揭地前无古，～喜共存。","book":"柳亚子《叶剑英市长来迓，赋成一律》"}},{"id":30933,"word":"物以希为贵","pinyin":"wù yǐ xī wéi guì","abbr":"wyxwg","explanation":"事物因稀少而觉得珍贵。同“物以稀为贵”。","source":{"text":"大概是物以希为贵罢。北京的白菜运往浙江，便用红头绳系住菜根。","book":"鲁迅《朝花夕拾·藤野先生》"},"similar":["物以稀为贵","物稀为贵"],"usage":"作宾语、定语；指物品因稀少而珍贵"},{"id":30934,"word":"物以稀为贵","pinyin":"wù yǐ xī wéi guì","abbr":"wyxwg","explanation":"事物因稀少而觉得珍贵。","source":{"text":"然物以少者为贵，多者为贱。","book":"晋·葛洪《抱朴子·明本》"},"example":{"text":"～，情因老更慈。","book":"唐·白居易《小岁日喜谈氏外孙女孩满月》诗"},"similar":["物以希为贵","物稀为贵"],"opposite":["屡见不鲜"],"usage":"作宾语、定语；指物品因稀少而珍贵"},{"id":30935,"word":"物以类聚","pinyin":"wù yǐ lèi jù","abbr":"wylj","explanation":"同类的东西聚在一起。指坏人彼此臭味相投，勾结在一起。","source":{"text":"方以类聚，物以群分。","book":"《易·系辞上》"},"example":{"text":"自古道：～。过迁性喜游荡，就有一班浮浪子弟引诱打合。","book":"明·冯梦龙《醒世恒言》卷十七"},"similar":["同流合污","臭味相投"],"opposite":["格格不入","水火不容"],"usage":"作宾语、定语；指同类的东西聚合","story":["战国时期，齐宣王要辩士淳于髡推荐贤士，他一天就推荐七个，宣王感到惊讶，问是不是在滥竽充数。淳于髡说：“鸟有鸟类，兽有兽类。只能到山上才能采到柴胡，这就是物各有类，我经常与贤人打交道，因此可以为您推荐更多的贤人。”"]},{"id":30936,"word":"物以群分","pinyin":"wù yǐ qún fēn","abbr":"wyqf","explanation":"同类的东西聚在一起。指坏人彼此臭味相投，勾结在一起。同“物以类聚”。","source":{"text":"方以类聚，物以群分。","book":"《周易·系辞上》"},"example":{"text":"人以类聚，～。侯张两个的素行，这是“右仰知悉”，谁不知道？","book":"清·西周生《醒世姻缘传》第七十三回"},"similar":["物以类聚"],"usage":"作宾语、定语；指同类的东西聚合"},{"id":30937,"word":"物众地大","pinyin":"wù zhòng dì dà","abbr":"wzdd","explanation":"物：物产，资源。物产丰富，土地广大。","source":{"text":"至于玄宗，受报收功，极炽而丰，物众地大，孽牙其间。","book":"唐·韩愈《平淮西碑》"}},{"id":30938,"word":"物伤其类","pinyin":"wù shāng qí lèi","abbr":"wsql","explanation":"指见到同类死亡，联想到自己将来的下场而感到悲伤。比喻见到情况与自己相似的人的遭遇而伤感。","source":{"text":"指见到同类死亡，联想到自己将来的下场而感到悲伤。比喻见到情况与自己相似的人的遭遇而伤感。"},"example":{"text":"黛玉、宝钗、探春等见迎春的乳母如此，也是“～”的意思，遂都起身笑向贾母讨情。","book":"清·曹雪芹《红楼梦》第七十三回"},"similar":["兔死狐悲"],"opposite":["幸灾乐祸"],"usage":"作谓语、宾语、分句；用于人"},{"id":30939,"word":"物力维艰","pinyin":"wù lì wéi jiān","abbr":"wlwj","explanation":"物：物资；力：财力；维：是；艰：困难。指财物来之不易。","source":{"text":"一粥一饭，当思来处不易；半丝半缕，恒念物力维艰。","book":"清·朱柏庐《治家格言》"},"usage":"作宾语、定语；用于劝诫人"},{"id":30940,"word":"物华天宝","pinyin":"wù huá tiān bǎo","abbr":"whtb","explanation":"物华：万物的精华；天宝：天然的宝物。指各种珍美的宝物。","source":{"text":"物华天宝，龙光射牛斗之墟。","book":"唐·王勃《秋日登洪府滕王阁饯别序》"},"example":{"text":"～动和风，一派箫韶仙苑同。","book":"清·陈忱《水浒后传》第四十回"},"usage":"作宾语、定语；指各种珍美的宝物","story":["“初唐四杰”的王勃因为他的《檄英王鸡》得罪了唐高宗而被放逐，他到交趾探望父亲路经洪州，恰逢重阳节，洪州都督阎伯屿大宴宾客，吟诗作乐，王勃即兴作《滕王阁序》：“物华天宝，龙光射斗牛之墟，人杰地灵，徐孺下陈蕃之榻。”"]},{"id":30941,"word":"物各有主","pinyin":"wù gè yǒu zhǔ","abbr":"wgyz","explanation":"主；主人。世间万物各有其所属。","source":{"text":"夫天地之间，物各有主，苟非吾之所有。","book":"宋·苏轼《赤壁赋》"},"example":{"text":"～，我们加以利用就行。"},"usage":"作宾语、定语；指世间万物各有其所属"},{"id":30942,"word":"物在人亡","pinyin":"wù zài rén wáng","abbr":"wzrw","explanation":"人死了，东西还在。指因看见遗物而引起对死者的怀念，或因此而引起的感慨。","source":{"text":"物在人亡空有泪，时殊事变独伤心","book":"唐·张说《拨川郡王神道碑奉敕撰》：“武节方壮，朝露不待，王爵送终，宿恩未改，时来世去，人亡物在，铭勋谥忠，以告四海。”宋·曾会《重登潇湘楼》诗"},"example":{"text":"真是～了。”（清·曹雪芹《红楼梦》第七十八回","book":"秋纹见这条红裤子是晴雯的针线，因叹道"},"similar":["人亡物在","物是人非"],"usage":"作谓语、宾语、分句；指怀念故人"},{"id":30943,"word":"物壮则老","pinyin":"wù zhuàng zé lǎo","abbr":"wzzl","explanation":"壮：壮实，强壮；老：老死。事物壮盛到了极点就会衰朽。指一切事物盛极必衰的自然规律。","source":{"text":"物壮则老，谓之不道，不道早已。","book":"《老子》第五十五章"},"example":{"text":"伏以～，肃役所以成岁功；否终必倾，反复然后知天意。","book":"宋·苏轼《贺正启》"}},{"id":30944,"word":"物外之交","pinyin":"wù wài zhī jiāo","abbr":"wwzj","explanation":"指超越世俗，不以利害结合的友情。","source":{"text":"元和中上龙门香山，与伏牛禅师为物外之交。","book":"宋·释赞宁《宋高僧传·如会传》"},"example":{"text":"就迁军事判官，与隐士陈曙为物外交，淡然不志荣利。","book":"《南唐书·高越传》"}},{"id":30945,"word":"物尽其用","pinyin":"wù jìn qí yòng","abbr":"wjqy","explanation":"各种东西凡有可用之处，都要尽量利用。指充分利用资源，一点不浪费。","source":{"text":"这倒是人尽其才，物尽其用，两全其美。","book":"马烽《典型事例》"},"example":{"text":"做到人尽其才，～，地尽其利，货尽其通。","book":"耿可贵《孙中山和宋庆龄》"},"similar":["人尽其才"],"usage":"作宾语、定语；指充分利用"},{"id":30946,"word":"物归原主","pinyin":"wù guī yuán zhǔ","abbr":"wgyz","explanation":"归：还给。把物品还给原来的主人。","source":{"text":"他不生儿女，就过继着你家儿子，承领了这家私，物归旧主，岂非天意。","book":"明·凌濛初《初刻拍案惊奇》卷三十五"},"example":{"text":"不是没收吧？又～啦？这可是喜事！","book":"老舍《茶馆》第三幕"},"similar":["完璧归赵","物归旧主"],"opposite":["据为己有"],"usage":"作谓语、宾语、定语；指完璧归赵"},{"id":30947,"word":"物归旧主","pinyin":"wù guī jiù zhǔ","abbr":"wgjz","explanation":"归：还给。把物品还给原来的主人。","source":{"text":"他不生儿女，就过继着你家儿子，承领了这家私，物归旧主，岂非天意。","book":"明·凌濛初《初刻拍案惊奇》卷三十五"},"similar":["物归原主","完璧归赵"],"opposite":["据为己有"],"usage":"作谓语、宾语、定语；指完璧归赵"},{"id":30948,"word":"物微志信","pinyin":"wù wēi zhì xìn","abbr":"wwzx","explanation":"微：小；志：心意；信：诚实。生物虽小，主地诚实。本指虫吟鸟鸣，准确及时。比喻人身份不高而内心诚实。","source":{"text":"臣闻布谷鸟鸣于孟夏，蟋蟀吟于始秋，物有微而志信，人有贱而言忠。","book":"《后汉书·襄楷传》"}},{"id":30949,"word":"物必先腐而后虫生之","pinyin":"wù bì xiān fǔ ér hòu chóng shēng zhī","abbr":"wbxfehcsz","explanation":"腐：腐烂。指东西总是自身先腐烂，然后虫子才可了寄生。比喻自己先有弱点而后为外物所侵害。","source":{"text":"物必先腐也而后虫生之，人必先疑也而后谗入之，陈平虽智，安能间无疑之主哉？","book":"《荀子·功学》：“肉腐出虫，鱼枯生蠹。”宋·苏轼《论范增》"}},{"id":30950,"word":"物情离怨","pinyin":"wù qíng lí yuàn","abbr":"wqly","explanation":"物情：众情。指民心离散怨恨。","source":{"text":"今兹二库，珍币所归，不领度支，是行私也。不给经费，非宣利也；物情离怨，不亦宜乎？","book":"唐·陆贽《奏天请罢琼林大盈二库状》"}},{"id":30951,"word":"物换星移","pinyin":"wù huàn xīng yí","abbr":"whxy","explanation":"物换：景物变幻；星移：星辰移位。景物改变了，星辰的位置也移动了。比喻时间的变化。","source":{"text":"闲云潭影日悠悠，物换星移几度秋。","book":"唐·王勃《秋日登洪府滕王阁饯别序》"},"example":{"text":"兔走乌飞，搬不尽古今兴废，急回来～，成就了凤鸾交莺燕侣。","book":"元·王子一《误入桃源》第三折"},"similar":["寒暑易节","年复一年"],"opposite":["一成不变"],"usage":"作谓语、宾语、定语；用于事物、时间变迁"},{"id":30952,"word":"物是人非","pinyin":"wù shì rén fēi","abbr":"wsrf","explanation":"东西还是原来的东西，可是人已不是原来的人了。多用于表达事过境迁。因而怀念故人。","source":{"text":"节同时异，物是人非，我劳如何！","book":"三国·魏·曹丕《与吴质书》"},"example":{"text":"只怕再来时～，云英已赴裴航之梦矣。","book":"《平山冷燕》第18回"},"similar":["事过境迁","人非物是"],"usage":"作谓语、宾语、定语；指怀念故人"},{"id":30953,"word":"物有生死，理有存亡","pinyin":"wù yǒu shēng sǐ，lǐ yǒu cún wáng","abbr":"wysslycw","explanation":"物：万物；理：事物的规律。万物都是有生也有死，有其规律也有它的存在或消亡。指一切事物及其规律都是发展变化着的。","source":{"text":"故定理有存亡，有生死，有盛衰。天物之一存一亡，乍生乍死，初盛而后衰者，不可谓常。","book":"《韩非子·解老》"}},{"id":30954,"word":"物望所归","pinyin":"wù wàng suǒ guī","abbr":"wwsg","explanation":"物：指人，公众；物望：众人的希望。形容众人所期望的。指得到群众的信任。","source":{"text":"郢王杀君害父，篡居大位，宫中荒淫，靡所不至。洛下人情已去，东京物望所归，公若因而成之，则有辅立之功，讨贼之效。","book":"《旧五代史·末帝纪》"},"example":{"text":"魏王泰未死，吴王恪～，洎执生杀之权以诛异己，欺太子之柔，唯其志以逞，何求而不得？","book":"清·王夫之《读通鉴论·唐高祖》"}},{"id":30955,"word":"物极则反","pinyin":"wù jí zé fǎn","abbr":"wjzf","explanation":"事物发展到极限就会向相反的方面转化。","source":{"text":"美恶相饰，命曰复周；物极则反，命曰环流。","book":"《鹖冠子·环流》"},"example":{"text":"明·冯梦龙《醒世恒言》第34卷：“自古道：～，人急计生。”"},"similar":["物极将返","物极必返"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":30956,"word":"物极则衰","pinyin":"wù jí zé shuāi","abbr":"wjzs","explanation":"指事物繁盛以后则将衰萎。","source":{"text":"当今人臣之位无居臣上者，可谓富贵极矣。物极则衰，吾未知所税驾也！","book":"《史记·李斯列传》"},"similar":["物极则反"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":30957,"word":"物极将返","pinyin":"wù jí jiāng fǎn","abbr":"wjjf","explanation":"事物发展到极限就会向相反的方面转化。同“物极则反”。","source":{"text":"子亦知物极将返乎？天生物，命官理之，有所溃，有所郁。","book":"清·龚自珍《乙丙之际箸议第一》"},"similar":["物极则反"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":30958,"word":"物极必反","pinyin":"wù jí bì fǎn","abbr":"wjbf","explanation":"极：顶点；反：向反面转化。事物发展到极点，会向相反方向转化。","source":{"text":"物极则反，命曰环流。","book":"《吕氏春秋·博志》：“全则必缺，极则必反。”《鹖冠子·环流》"},"example":{"text":"“～”，错误成了堆，光明就会到来。","book":"毛泽东《我们党的一些历史经验》"},"similar":["周而复始","乐极生悲","苦尽甘来"],"opposite":["千篇一律"],"usage":"作谓语、定语、分句；用于劝诫人","story":["唐太宗的才人武则天后来成为唐高宗的皇后，高宗死后，中宗年幼，她自己临朝听政。中宗逐渐长大可以处理国家大事，武后不肯放权。大臣苏安桓上一篇奏疏让她归政于中宗，提醒她注意物极必反、器满则盈。武则天没有采纳"]},{"id":30959,"word":"物极必返","pinyin":"wù jí bì fǎn","abbr":"wjbf","explanation":"事物发展到极点，会向相反方向转化。同“物极必反”。","source":{"text":"《复卦》言七日来复，其间之不断续，阳已复生，物极必返，其理须如是。","book":"宋·朱熹《近思录·道体》"},"similar":["物极必反"],"usage":"作谓语、定语、分句；用于劝诫人"},{"id":30960,"word":"物欲横流","pinyin":"wù yù héng liú","abbr":"wyhl","explanation":"形容商品经济发达，人们热烈追求物质利益的社会氛围。"},{"id":30961,"word":"物殷俗阜","pinyin":"wù yīn sú fù","abbr":"wysf","explanation":"物产丰盛，风俗淳厚。","source":{"text":"天下大治，河清海晏，物殷俗阜。","book":"唐·郑启《开天传信记》"},"example":{"text":"宋·王谠《唐语林·规箴》：“天下大理，河清海晏，～，安西诸国，悉平为郡县。”"},"usage":"作谓语、定语；用于局面等"},{"id":30962,"word":"物物交换","pinyin":"wù wù jiāo huàn","abbr":"wwjh","explanation":"进行以货易货交易的行动或实践。","example":{"text":"～的贸易方式也还存在。"},"similar":["以货易货"],"usage":"作主语、宾语、定语；用于贸易"},{"id":30963,"word":"物盛则衰","pinyin":"wù shèng zé shuāi","abbr":"wszs","explanation":"指事物繁盛以后则将衰萎。","source":{"text":"夫月满则亏，物盛则衰，天地之常也。","book":"《史记·田叔列传》"},"example":{"text":"宋·张君房《云笈七签》第83卷：“日中则移，月满则亏，乐极悲来，～。”"},"similar":["物极则衰"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":30964,"word":"物离乡贵","pinyin":"wù lí xiāng guì","abbr":"wlxg","explanation":"物品离产地越远越贵重。","source":{"text":"自古道物离乡贵，人离乡贱；这语话，信非假，到如今转忆家。","book":"明·沈璟《埋剑记·柔远》"},"example":{"text":"这就是俗语说的～，其实可算甚么呢！","book":"清·曹雪芹《红楼梦》第67回"},"usage":"作宾语、定语；指物品离开产地越远越贵"},{"id":30965,"word":"物稀为贵","pinyin":"wù xī wéi guì","abbr":"wxwg","explanation":"事物因稀少而觉得珍贵。同“物以稀为贵”。","source":{"text":"盖物稀为贵，理应然也。","book":"清·袁枚《随园诗话补遗》第一卷"},"similar":["物以稀为贵","物以希为贵"],"usage":"作宾语、定语；指物品因稀少而珍贵"},{"id":30966,"word":"物穆无穷","pinyin":"wù mù wú qióng","abbr":"wmwq","explanation":"物穆：深微。深邃奥妙，不可穷究。","source":{"text":"迫则能应，感则能动，物穆无穷，变无形像。","book":"《淮南子·原道训》"}},{"id":30967,"word":"物竞天择","pinyin":"wù jìn tiān zé","abbr":"wjtz","explanation":"物竞：生物的生存竞争；天择：自然选择。生物相互竞争，能适应者生存下来。原指生物进化的一般规律，后也用于人类社会的发展。","source":{"text":"因为物竞天择的公理，必要顺应著那时势时，才能够生存。","book":"梁启超《新中国未来记》"},"example":{"text":"而始成其《物种来由》一书，以发明～之理。","book":"孙中山《建国方略·心理建设》"},"usage":"作宾语、定语；指自然竞争"},{"id":30968,"word":"物美价廉","pinyin":"jià lián wù měi","abbr":"wmjl","explanation":"廉：便宜。东西价钱便宜，质量又好。","source":{"text":"苏州有个朋友写信来，要印一部书。久仰贵局的价廉物美，所以特来求教。","book":"清·吴趼人《近十年之怪现状》第十回"},"example":{"text":"提倡～，老少无欺，反对粗制滥造，偷工减料。 ◎朱德《要把手工业生产合作社搞好》"}},{"id":30969,"word":"物腐虫生","pinyin":"wù fǔ chóng shēng","abbr":"wfcs","explanation":"东西腐烂了才会生虫。比喻祸患的发生，总有内部的原因。也比喻本身有了弱点，别人才能乘机打击。","source":{"text":"物必先腐也，而后虫生之。","book":"《荀子·劝学》：“肉腐出虫，鱼枯生蠹。”宋·苏轼《范增论》"},"example":{"text":"本县若执“～”之理究治起来，不说你这嫩皮肉受不得这桁杨摧残，追此财赃不怕你少了分文。","book":"清·李绿园《歧路灯》第四十七回"},"usage":"作宾语、分句；比喻祸患的发生必有内","story":["秦朝末年，范增为项羽设计鸿门宴借机杀掉刘邦，项羽没有决心，让刘邦得以逃脱。刘邦造谣中伤范增，挑拨他们的关系，项羽中计疏远范增，结果被刘邦所灭。苏轼在《范增论》说：“物必先腐也，而后虫生之；人必先疑也，而后谗入之”"]},{"id":30970,"word":"物至则反","pinyin":"wù zhì zé fǎn","abbr":"wzzf","explanation":"事物发展到极限就会向相反的方面转化。同“物极则反”。","source":{"text":"臣闻物至则反，冬夏是也；致高则危，累棋是也。","book":"《吕氏春秋·博志》：“全则必缺，极则必反。”《史记·春申君列传》"},"similar":["物极则反"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":30971,"word":"物薄情厚","pinyin":"wù bó qíng hòu","abbr":"wbqh","explanation":"薄：轻；厚：重。礼物虽然很轻薄，而情谊却很深厚。多为馈赠时用词。","source":{"text":"会数而礼勤，物薄而情厚。","book":"宋·司马光《训俭示康》"}},{"id":30972,"word":"物议沸腾","pinyin":"wù yì fèi téng","abbr":"wyft","explanation":"议论纷纷，指舆论强烈。","source":{"text":"降麻之后，物论沸腾，故疾缠其身，灾仍于国。","book":"宋·苏舜钦《诣匦疏·景祐五年》"},"example":{"text":"～，畏堂莫敢与难。","book":"《明史·陈鼎传》"},"similar":["议论纷纷","说长道短"],"opposite":["缄口不言","守口如瓶"],"usage":"作谓语、分句；用于人"},{"id":30973,"word":"物论沸腾","pinyin":"wù lùn fèi téng","abbr":"wlft","explanation":"物论：众人的议论。指舆论强烈。","source":{"text":"播纤邪，物论沸腾，不可以污台司。","book":"《资治通鉴·唐纪·宪宗长庆元年》"},"example":{"text":"今者物论沸腾，怨讟交至，公议所在，亦知之矣。","book":"《宋史·苏轼传》"},"similar":["物议沸腾"],"usage":"作谓语、定语；用于人"},{"id":30974,"word":"物阜民丰","pinyin":"wù fù mín fēng","abbr":"wfmf","explanation":"物产丰富，人民安乐。","example":{"text":"当今的社会由于政治安定，经济繁荣，风调雨顺，因此人们无不过着～的生活。"}},{"id":30975,"word":"物阜民安","pinyin":"wù fǔ mín ān","abbr":"wfma","explanation":"阜：丰富。物产丰富，人民安乐。","source":{"text":"夫欲民殷财阜，要在止役禁夺。","book":"《后汉书·刘陶传》"},"example":{"text":"真个文修武偃，～。","book":"明·冯梦龙《东周列国志》第一回"},"similar":["物阜民康"],"usage":"作谓语、定语；指社会局面"},{"id":30976,"word":"物阜民康","pinyin":"wù fǔ mín kāng","abbr":"wfmk","explanation":"阜：丰富。物产丰富，人民安康。","source":{"text":"夫欲民殷财阜，要在止役禁夺。","book":"《后汉书·刘陶传》"},"example":{"text":"果是山明水秀，～。","book":"清·陈忱《水浒后传》第九回"},"similar":["物阜民熙"],"usage":"作谓语、定语、宾语；用于局面等"},{"id":30977,"word":"物阜民熙","pinyin":"wù fù mín xī","abbr":"wfmx","explanation":"阜：多；熙：安乐。百姓安乐，物资丰富。形容社会安定，百姓安居乐业的景象。","source":{"text":"昔贞观中，民康物阜，盗贼衰熄，人知自爱，而不犯法。","book":"宋·华镇《治论下》"},"example":{"text":"我则待罢刀兵，安社稷。则要的～，则俺这为臣子要当竭力。","book":"元·高文秀《渑池会》第二折"},"similar":["物阜民康"],"usage":"作谓语、定语、宾语；用于局面等"},{"id":30978,"word":"牵一发而动全身","pinyin":"qiān yī fà ér dòng quán shēn","abbr":"qyfedqs","explanation":"牵动一根头发就会涉及整个身体。比喻动极小的部分就会影响全局。","source":{"text":"吾头发不可胜数，而身之毛孔亦不可胜数，牵一发而头为之动，拨一毛而身为之变，然则发皆吾头，而毛孔皆吾身也。","book":"宋·苏轼《成都大悲阁记》"},"example":{"text":"一发不可牵，牵之动全身。","book":"清·龚自珍《自春徂秋偶有所触》"},"similar":["牵一发动全身"],"usage":"作宾语、分句；指动极小的部分就会大动"},{"id":30979,"word":"牵三扯四","pinyin":"qiān sān chě sì","abbr":"qscs","explanation":"牵：牵连；扯：拉。牵扯其他的事情。","source":{"text":"罢，罢，罢。你不能拿了金凤来，不必牵三扯四乱嚷。我也不要那凤了。","book":"清·曹雪芹《红楼梦》第73回"},"usage":"作宾语、定语、状语；指牵扯"},{"id":30980,"word":"牵丝扳藤","pinyin":"qiān sī bān téng","abbr":"qsbt","explanation":"比喻事情相互连结，纠缠不清。","source":{"text":"你到底有啥心事？爽爽快快说。牵丝扳藤，惹得人肚肠根痒。","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"平常看你很爽脆，今天怎么跟小姑娘似地～？","book":"高阳《草莽英雄》第三十五章"},"similar":["牵丝攀藤"],"usage":"作谓语、定语、宾语；用于口语"},{"id":30981,"word":"牵丝攀藤","pinyin":"qiān sī pān téng","abbr":"qspt","explanation":"比喻东拉西扯地攀附。","source":{"text":"出版过有关鲁迅的书籍，而后牵丝攀藤，将自己打扮成独一无二的‘鲁迅专家’。","book":"唐弢《尺素书》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“～这么多日子下来，要想好好摆脱是无论如何办不到的事。”"},"similar":["牵丝扳藤"],"usage":"作谓语、定语；用于口语"},{"id":30982,"word":"牵五挂四","pinyin":"qiān wǔ guà sì","abbr":"qwgs","explanation":"指接连不断。","source":{"text":"于是接二连三，牵五挂四，将一条街烧得如‘火焰山’一般。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["接二连三"],"usage":"作状语；同“接二连三”"},{"id":30983,"word":"牵合傅会","pinyin":"qiān hé fù huì","abbr":"qhfh","explanation":"把本来没有某种意义的事物硬说成有某种意义。也指把不相关联的事物牵拉在一起，混为一谈。同“牵合附会”。","source":{"text":"《吕氏月令》乃牵合傅会之书，柳子厚论之详矣。","book":"明·王廷相《雅述》下篇"},"similar":["牵合附会"],"usage":"作谓语、定语、状语；指乱混为一谈"},{"id":30984,"word":"牵合附会","pinyin":"qiān hé fù huì","abbr":"qhfh","explanation":"犹言牵强附会。把本来没有某种意义的事物硬说成有某种意义。也指把不相关联的事物牵拉在一起，混为一谈。","source":{"text":"但易一书尽欲如此牵合附会，少閒便疏脱。","book":"唐·白居易《序洛诗》：“苦词无一字，忧叹无一声，岂牵强所能致耶？”宋·朱熹《朱子语类·易二》"},"example":{"text":"然其～，眩于名实，苟不辨而绝之，殆将为后世祸矣。","book":"《明史·薛惠传》"},"similar":["牵合傅会","牵强附会"],"usage":"作谓语、定语、状语；指乱混为一谈"},{"id":30985,"word":"牵四挂五","pinyin":"qiān sì guà wǔ","abbr":"qsgw","explanation":"牵：牵扯，连带。指许多人或事互相牵连，关系复杂。"},{"id":30986,"word":"牵引附会","pinyin":"qiān yǐn fù huì","abbr":"qyfh","explanation":"犹言牵强附会。把本来没有某种意义的事物硬说成有某种意义。也指把不相关联的事物牵拉在一起，混为一谈。","source":{"text":"程子以诸葛武侯有儒者气象，即牵引附会认为儒教，不斥其为刑名之学。","book":"凡人《开通学术议》"},"similar":["牵强附会"],"usage":"作谓语、定语、状语；指乱混为一谈"},{"id":30987,"word":"牵强附会","pinyin":"qiān qiáng fù huì","abbr":"qqfh","explanation":"把本来没有某种意义的事物硬说成有某种意义。也指把不相关联的事物牵拉在一起，混为一谈。","source":{"text":"后懦牵强附会，费尽心思，不知都是古今学不分明的缘故。","book":"清·曾朴《孽海花》第十一回"},"example":{"text":"揣古希腊哲人，似不无微知此意者，而厥后则～之说大行。","book":"鲁迅《坟·人之历史》"},"similar":["穿凿附会","生拉硬扯","牵书搭俗"],"opposite":["合情合理","顺理成章"],"usage":"作谓语、定语、状语；指乱混为一谈"},{"id":30988,"word":"牵强附合","pinyin":"qiān qiáng fù hé","abbr":"qqfh","explanation":"犹言牵强附会。把本来没有某种意义的事物硬说成有某种意义。也指把不相关联的事物牵拉在一起，混为一谈。","source":{"text":"后来诸公解，只是以己意牵强附合，终不是圣人意。","book":"宋·朱熹《朱子语类》第67卷"},"example":{"text":"《例言》：“假借谐声，是传奇中应有之义，并非～。”"},"similar":["牵强附会","牵合附会"],"usage":"作谓语、定语、状语；指乱混为一谈"},{"id":30989,"word":"牵心挂肚","pinyin":"qiān xīn guà dù","abbr":"qxgd","explanation":"牵：拉。形容非常挂念，放心不下。","example":{"text":"你真让我～。"},"similar":["牵肠挂肚"],"usage":"作谓语、定语、状语；指放心不下"},{"id":30990,"word":"牵心挂肠","pinyin":"qiān xīn guà cháng","abbr":"qxgc","explanation":"牵肠挂肚。","example":{"text":"她老是～的，怕你出了事。"},"similar":["牵肠挂肚"],"usage":"作谓语、宾语；指牵挂，用于方言"},{"id":30991,"word":"牵牛下井","pinyin":"qiān niú xià jǐng","abbr":"qnxj","explanation":"比喻事情棘手，使不出力。","source":{"text":"至如负贩经商，登山涉水，吃烟人更是牵牛下井。","book":"清·彭养鸥《黑籍冤魂》第15回"},"usage":"作谓语、宾语、定语；比喻使不出劲"},{"id":30992,"word":"牵牛织女","pinyin":"qiān niú zhī nǚ","abbr":"qnzn","explanation":"指牵牛星、织女星。亦指古代神话中的牛郎、织女。"},{"id":30993,"word":"牵物引类","pinyin":"qiān wù yǐn lèi","abbr":"qwyl","explanation":"指援引同类事物作比喻。","source":{"text":"《譬喻经》者，皆是如来，随时方便，四说之辞，敷演弘毅，训诱之要，牵物引类，转相证据。","book":"晋·康法邃《序》"},"usage":"作谓语、定语；用于书面语"},{"id":30994,"word":"牵着鼻子走","pinyin":"qiān zhe bí zǐ zǒu","abbr":"qzbzz","explanation":"牛总是被人牵着鼻子走的。比喻受人支配，盲目地听命于人。","example":{"text":"他总是被她～。"},"usage":"作谓语；指受人支配"},{"id":30995,"word":"牵筋缩脉","pinyin":"qiān jīn suō mài","abbr":"qjsm","explanation":"筋：筋骨；缩：紧缩；脉：血管。形容神经非常紧张。","source":{"text":"柯陈兄弟见汪秀才意思坦然，虽觉放下了些惊恐，也还心绪不安，牵筋缩脉。","book":"明·凌濛初《二刻拍案惊奇》第27卷"},"usage":"作谓语、定语；用于人的神态等"},{"id":30996,"word":"牵经引礼","pinyin":"qiān jīng yǐn lǐ","abbr":"qjyl","explanation":"指援引经典。","source":{"text":"高祖骂之曰：‘眼看人瞋，乃复牵经引礼！’叱令出去。","book":"《北齐书·杜弼传》"},"similar":["引经据典"],"usage":"作谓语、定语、宾语；多用于写作或说话"},{"id":30997,"word":"牵羊担酒","pinyin":"qiān yáng dàn jiǔ","abbr":"qydj","explanation":"牵着羊，挑着酒。表示向人慰劳或庆贺。","source":{"text":"老夫如今牵羊担酒，与孩儿庆喜。","book":"元·无名氏《举案齐眉》第四折"},"example":{"text":"愚有一计：并不劳～，纳士献印。","book":"明·罗贯中《三国演义》第四十四回"},"similar":["担酒牵羊"],"usage":"作谓语、定语；指慰劳或庆贺"},{"id":30998,"word":"牵肠割肚","pinyin":"qiān cháng gē dù","abbr":"qcgd","explanation":"①形容非常想念。②形容内心悲痛如刀割。","source":{"text":"为忆小卿，牵肠割肚，凄惶悄然无底末。","book":"元·白朴《小石调·恼煞人》曲"},"example":{"text":"二哥活受地狱……三哥打得更毒，老身～。","book":"元·关汉卿《蝴蝶梦》第二折"},"similar":["牵肠挂肚","牵肠萦心"],"usage":"作谓语、定语、状语；指放心不下"},{"id":30999,"word":"牵肠挂肚","pinyin":"qiān cháng guà dù","abbr":"qcgd","explanation":"牵：拉。形容十分惦念，放心不下。","source":{"text":"可怎生将俺孩儿一时勾去，害的俺张善友牵肠割肚。","book":"元·无名氏《冤家债主》第三折"},"example":{"text":"人家～的等着，你且高乐去！","book":"清·曹雪芹《红楼梦》第二十六回"},"similar":["春树暮云","儿女情长","朝思暮想"],"opposite":["置于脑后","铁石心肠"],"usage":"作谓语、定语、状语；指放心不下"},{"id":31000,"word":"牵肠萦心","pinyin":"qiān cháng yíng xīn","abbr":"qcyx","explanation":"犹牵肠挂肚。","source":{"text":"叶圣陶《线下·一个青年》接信后竟置之不答，那种牵肠萦心的期待不将把血管都绞破么！”"},"similar":["牵肠割肚"],"usage":"作谓语、定语、状语；指放心不下"},{"id":31001,"word":"牵萝莫补","pinyin":"qiān luó mò bǔ","abbr":"qlmb","explanation":"萝：女萝，植物名。指无法弥补。","source":{"text":"痴珠多情人，既深毁室之伤，复抱坠楼之痛！牵萝莫补，剪纸难招。","book":"《花月痕》第十一回"},"similar":["牵萝补屋"],"usage":"作谓语、定语；用于书面语"},{"id":31002,"word":"牵萝补屋","pinyin":"qiān luó bǔ wū","abbr":"qlbw","explanation":"萝：女萝，植物名。拿藤萝补房屋的漏洞。比喻生活贫困，挪东补西。后多比喻将就凑合。","source":{"text":"侍婢卖珠回，牵萝补茅屋。","book":"唐·杜甫《佳人》诗"},"example":{"text":"荷镵诛茅，～，是以为常。","book":"清·蒲松龄《聊斋志异·红玉》"},"usage":"作谓语、定语；指生活困苦"},{"id":31003,"word":"牵衣投辖","pinyin":"qiān yī tóu xiá","abbr":"qytx","explanation":"指拉住客人衣裳，投其车辖于井。形容殷勤留客。辖，古代车上固定车轮的零件。","source":{"text":"平生自奉甚约，宾客过从，则牵衣投辖，穷日夕不厌。","book":"清·王晫《今世说·德行》"},"similar":["投辖留宾"],"usage":"作谓语、宾语、定语；用于待客"},{"id":31004,"word":"牵衣肘见","pinyin":"qiān yī zhǒu jiàn","abbr":"qyzj","explanation":"指牵动一下衣襟，就露出臂肘。形容衣不蔽体。","source":{"text":"曾子居卫……三日不举火，十年不制衣，正冠而绝缨，捉襟而肘见，纳屦而踵决。","book":"语出《庄子·让王》"},"example":{"text":"～，步雪履穿。","book":"唐·王维《送郑五赴任新都序》"},"similar":["捉襟见肘"],"usage":"作定语、状语；形容贫穷"},{"id":31005,"word":"牵衣顿足","pinyin":"qiān yī dùn zú","abbr":"qydz","explanation":"形容极为悲痛，难以分享的样子。","source":{"text":"牵衣顿足拦道哭，哭声直上干云霄。","book":"唐·杜甫《兵车行》"}},{"id":31006,"word":"牵鬼上剑","pinyin":"qiān guǐ shàng jiàn","abbr":"qgsj","explanation":"比喻非常困难。","source":{"text":"读书牵鬼上剑，饮酒车水灌田。","book":"明·单本《蕉帕记·下湖》"},"usage":"作宾语、定语；用于事情等"},{"id":31007,"word":"牵黄臂苍","pinyin":"qiān huáng bì cāng","abbr":"qhbc","explanation":"牵：领着；黄：指狗；苍：指鹰。牵着狗，带着鹰。比喻不务正业，沉湎于游猎玩乐之中。","source":{"text":"老夫聊发少年狂，左牵黄，右擎苍。锦帽貂裘，千骑卷平冈。","book":"《抱朴子·金丹》：“或飞苍走黄于中原，或留连杯觞以羹沸。”宋·苏轼《江城子·密州出猎》"},"example":{"text":"彼～，驰猎于声利之场者，但见衮衮马头尘，匆匆驹隙影耳。","book":"明·陶宗仪《南村辍耕录·隐趣》"}},{"id":31008,"word":"特立独行","pinyin":"tè lì dú xíng","abbr":"tldx","explanation":"特：独特；立：立身。形容人的志行高洁，不同流俗。","source":{"text":"其特立独行，有如此者。","book":"《礼记·儒行》"},"example":{"text":"士之～，适于义而已。","book":"唐·韩愈《伯夷颂》"},"usage":"作谓语、定语、宾语；指人品行"},{"id":31009,"word":"犀照牛渚","pinyin":"xī zhào niú zhǔ","abbr":"xznz","explanation":"比喻洞察幽微。","source":{"text":"扞温峤呴至牛渚矶，水深不可测，世云其下多怪物，峤遂燬犀角而照之。","book":"《晋书·温峤传》"},"example":{"text":"高攀天根探月窟，～万怪呈。","book":"明·高启《青丘子歌》"},"similar":["犀燃烛照"],"usage":"作宾语、定语；用于比喻句","story":["东晋时期，温峤来到牛渚矶，见水深不可测，传说水中有许多水怪。温峤便点燃犀牛角来照看，看见水下灯火通明，水怪奇形怪状，有乘马车的有穿红衣的。温峤晚上梦见一人恶意责怪不该用犀牛角火照。第二天因牙痛拔牙而中风，回到镇上不到十天就死了"]},{"id":31010,"word":"犀燃烛照","pinyin":"xī rán zhú zhào","abbr":"xrzz","explanation":"犹犀照牛渚。","source":{"text":"使臣行辕宜设译官数员，汇观各处日报而撷取要略，译以华文，寄呈总理衙门；则泰西迩日之情形，正如犀燃烛照，无所遁形。","book":"清·王韬《使才》"},"similar":["犀照牛渚"],"usage":"作宾语、定语；用于书面语"},{"id":31011,"word":"犀牛望月","pinyin":"xī niú wàng yuè","abbr":"xnwy","explanation":"比喻见到的不全面。","source":{"text":"譬如犀牛望月，月形入角，特因识生，始有月形，而彼真月，初不在角。","book":"《关尹子·五鉴》"},"example":{"text":"过望则见，盖～之久，故感其影于角。","book":"明·陈继儒《太平清话》第四卷"},"usage":"作宾语；形容长久盼望"},{"id":31012,"word":"犀舟劲擑","pinyin":"xī zhōu jìn jí","abbr":"xzjj","explanation":"坚固的船和强劲的浆。","source":{"text":"虽有犀舟劲擑，犹人涉卬否，有须者也。","book":"《后汉书·张衡传》"}},{"id":31013,"word":"犀舟径楫","pinyin":"xī zhōu jìng jí","abbr":"xzjj","explanation":"犀：坚固；楫：船桨。坚固的船，坚硬的桨。","source":{"text":"虽有犀舟径楫，犹人涉卬否，有须是也。","book":"南朝·宋·范晔《后汉书·张衡传》"},"usage":"作宾语、定语；用于书面语"},{"id":31014,"word":"犀角烛怪","pinyin":"xī jiǎo zhú guài","abbr":"xjzg","explanation":"借以赞美诗文的深刻。","source":{"text":"峤旋武昌，至牛渚矶，水深不可测，世云其下多怪物，峤遂毁犀角而照之。须臾，见水族覆灭，奇形怪状。","book":"《晋书·温峤传》"},"example":{"text":"鲁迅先生诗歌的深刻，有如～，使社会上的一切“怪物”都现了原形。"},"usage":"作宾语、定语；用于书面语","story":["东晋时期，温峤来到牛渚矶，见水深不可测，传说水中有许多水怪。温峤便点燃犀牛角来照看，看见水下灯火通明，水怪奇形怪状，有乘马车的有穿红衣的。温峤晚上梦见一人恶意责怪不该用犀牛角火照。第二天因牙痛拔牙而中风，回到镇上不到十天就死了"]},{"id":31015,"word":"犀顶龟文","pinyin":"xī dǐng guī wén","abbr":"xdgw","explanation":"头顶骨隆起如犀角，脚掌上有龟背纹。旧时所谓贵人之相。","source":{"text":"固貌状有奇表，鼎角匿犀，足履龟文。","book":"语出《后汉书·李固传》"},"example":{"text":"～何肯相，雷光泡影认眉须。","book":"康有为《自题三十影像》诗"},"usage":"作宾语、定语；用于书面语"},{"id":31016,"word":"犀颅玉颊","pinyin":"xī lú yù jiá","abbr":"xlyj","explanation":"额角骨突出如犀，脸颊洁白如玉。借指相貌不凡的年轻人。","source":{"text":"空使犀颅玉颊，长怀髯舅凄然。","book":"宋·苏轼《仲天贶王元直既行作绝句五首送之》之四"},"usage":"作宾语、定语；用于人的相貌"},{"id":31017,"word":"犁庭扫穴","pinyin":"lí tíng sǎo xué","abbr":"ltsx","explanation":"庭：龙庭，古代匈奴祭祀天神的处所，也是匈奴统治者的军政中心。犁平敌人的大本营，扫荡他的巢穴。比喻彻底摧毁敌方。","source":{"text":"固已犁其庭，扫其闾，郡县而置之。","book":"《汉书·匈奴传下》"},"example":{"text":"雄师百万下江东，辞庙仓皇是蒋凶。丧尽人心终不悔，～事最公。","book":"陈毅《纪念宁沪解放十周年》诗"},"similar":["犁庭扫闾"],"usage":"作谓语、宾语；比喻彻底摧毁敌方"},{"id":31018,"word":"犁庭扫闾","pinyin":"lí tíng sǎo lǚ","abbr":"ltsl","explanation":"犁平他的庭院，扫荡他的村庄。比喻彻底摧毁敌方。庭：庭院。扫：扫荡。闾：里巷的门。","source":{"text":"固已犁其庭，扫其闾，郡县而置之。","book":"《汉书·匈奴传下》"},"example":{"text":"天威既振，戎虏畏詟，虽～，未快初志。","book":"宋·楼钥《攻媿集·孝宗皇帝谥议》"},"similar":["犁庭扫穴"],"usage":"作谓语、宾语；比喻彻底摧毁敌方"},{"id":31019,"word":"犁牛之子","pinyin":"lí niú zhī zǐ","abbr":"lnzz","explanation":"比喻父虽不善却无损于其子的贤明。","source":{"text":"子谓仲弓，曰：‘犁牛之子骍且角，虽欲勿用，山川其舍诸？’","book":"《论语·雍也》"},"usage":"作主语、宾语；用于父子"},{"id":31020,"word":"犁牛骍角","pinyin":"lí niú xīng jiǎo","abbr":"lnxj","explanation":"比喻劣父生贤明的儿女。同“犁生骍角”。","source":{"text":"子谓仲弓，曰：‘犁牛之子骍且角，虽欲勿用，山川其舍诸？’","book":"《论语·雍也》"},"example":{"text":"故孔子有～之喻，以其字为戏耳。","book":"清·俞樾《茶香室续钞·犁牛之子》"},"similar":["犁生骍角"],"usage":"作宾语、定语；用于比喻句"},{"id":31021,"word":"犁牛髐角","pinyin":"lí niú mài jiǎo","abbr":"lnmj","explanation":"比喻劣父生贤明的儿女。同犁生髐角”。"},{"id":31022,"word":"犁生骍角","pinyin":"lí shēng xīng jiǎo","abbr":"lsxj","explanation":"指杂色牛生纯赤色、角周正的小牛。比喻劣父生贤明的儿女。","source":{"text":"杂文曰犁。骍，纯赤色也。角者，角周正也。舍，弃也。诸，之也。仲弓父贱人而行不善，故孔子称谓仲弓，……言仲弓父虽不善，不害于子之美也。","book":"语出《论语·雍也》：“子谓仲弓，曰：‘犁牛之子骍且角，虽欲勿用，山川其舍诸？’”邢昺疏"},"example":{"text":"文君为之女，真可谓～矣。","book":"明·冯梦龙《智囊补·术智·司马相如》"},"similar":["犁牛骍角"],"usage":"作宾语、定语；用于比喻句"},{"id":31023,"word":"犁生髐角","pinyin":"lí shēng yuè jiǎo","abbr":"lsyj","explanation":"指杂色牛生纯赤色、角周正的小牛。比喻劣父生贤明的儿女。","source":{"text":"子谓仲弓，曰‘犁牛之子髐且角，虽欲勿用，山川其舍诸？’邢昺疏杂文曰犁。髐，纯赤色也。角者，角周正也。舍，弃也。诸，之也。仲弓父贱人而行不善，故孔子称谓仲弓，……言仲弓父虽不善，不害于子之美也。","book":"语出《论语·雍也》"},"quote":{"text":"文君为之女，真可谓～矣。","book":"明·冯梦龙《智囊补·术智·司马相如》"}},{"id":31024,"word":"犄角之势","pinyin":"jī jiǎo zhī shì","abbr":"jjzs","explanation":"比喻战争中互相配合、夹击敌人的态势，或分出兵力牵制敌人","source":{"text":"公子元列营于左殿，公子商人列营于朝门，相约为犄角之势。","book":"明·冯梦龙《东周列国志》第32回"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“在九龙江近海澄县地方的海口镇，结扎水营，以为～。”"},"similar":["掎角之势"],"usage":"作宾语；用于战争或局势"},{"id":31025,"word":"犊牧采薪","pinyin":"dú mù cǎi xīn","abbr":"dmcx","explanation":"喻指老而无妻的人。","example":{"text":"～的意思很多人不知道。"},"usage":"作宾语、定语；指老光棍"},{"id":31026,"word":"犒赏三军","pinyin":"kào shǎng sān jūn","abbr":"kssj","explanation":"犒：以财物或食物慰劳、鼓励。三军：春秋时称中军、左军、右宫为三军；后统称军队。现指陆、海、空三军。指奖赏、慰劳军队将士。","source":{"text":"再命户部颁发粮草彩缎，工部发出御酒三百坛，着礼部加封，差出内臣田思忠，解往潭州岳爷军前，犒赏三军。","book":"清·钱彩《说岳全传》第49回"},"example":{"text":"我到中国饭店吃了顿‘杂碎’，作为～。","book":"老舍《我怎样写》"},"similar":["犒劳三军"],"usage":"作谓语、宾语；指奖赏将士"},{"id":31027,"word":"犬不夜吠","pinyin":"quǎn bù yè fèi","abbr":"qbyf","explanation":"吠：狗叫。形容社会治安良好，没有盗贼。","source":{"text":"夫犬不夜吠，故民得安居。","book":"《梁书·硃异传》"},"example":{"text":"朱源做了三年县宰，治得那武昌县道不拾遗，～行取御史，就出差淮扬地方。","book":"明·冯梦龙《醒世恒言》卷三十六"},"usage":"作宾语、定语；用于生活治安等"},{"id":31028,"word":"犬兔之争","pinyin":"quān tù zhī zhēng","abbr":"qtzz","explanation":"比喻毫无意义的争斗。","source":{"text":"韩子卢者，天下之疾犬也；东郭逡者，海内之狡兔也。韩子卢逐东郭逡，环山者三，腾山者五，兔极于前，犬废于后，犬兔俱罢，各死其处。田父见之，无劳倦之苦而擅其功。","book":"《战国策·齐策三》"}},{"id":31029,"word":"犬兔俱毙","pinyin":"quān tù jǜ bì","abbr":"qtjb","explanation":"比喻双方同归于尽。","source":{"text":"韩子卢者，天下之疾犬也；东郭逡者，海内之狡兔也。韩子卢逐东郭逡，环山者三，腾山者五，兔极于前，犬废于后，犬兔俱罢，各死其处。田父见之，无劳倦之苦而擅其功。","book":"《战国策·齐策三》"},"example":{"text":"若玩寇要君，但恐～。","book":"《新五代史·四夷附录一》"},"similar":["同归于尽"],"usage":"作宾语、状语、定语；指同归于尽","story":["战国时期，齐国准备去攻打魏国，大臣淳于髡认为这样会两败俱伤，十分不利，就对齐王进谏：“天下最快的狗韩子卢去追天下最狡猾的兔子东郭逡，兔子在前面拼命跑，狗也拼命在追，经过一段时间，狗没追上兔子，双方都疲劳而死。”"]},{"id":31030,"word":"犬吠之盗","pinyin":"quǎn fèi zhī dào","abbr":"qfzd","explanation":"指小偷。","source":{"text":"尽十二月，郡中毋声，毋敢夜行，野无犬吠之盗。","book":"《史记·酷吏列传》"},"usage":"作宾语；指小偷"},{"id":31031,"word":"犬吠之警","pinyin":"quǎn fèi zhī jǐng","abbr":"qfzj","explanation":"指抢劫、偷窃之类。","source":{"text":"是时边城晏闭，牛马布野，三世无犬吠之警，黎庶亡干戈之役。","book":"东汉·班固《汉书·匈奴传赞》"},"example":{"text":"今晏然无～，而上下数牵，即一旦事起，复遣数四辈乎？","book":"明·陈子龙《问古者天下凡郡县兼城……》"},"usage":"作宾语；比喻小的惊扰"},{"id":31032,"word":"犬牙交错","pinyin":"quǎn yá jiāo cuò","abbr":"qyjc","explanation":"错：交叉，错杂。比喻交界线很曲折，象狗牙那样参差不齐。也比喻情况复杂，双方有多种因素参差交错。","source":{"text":"诸侯王自以骨肉至亲，先帝所以广封连城，犬牙相错者，为盘石宗也。","book":"《汉书·中山靖王传》"},"example":{"text":"这两个国家的边界线～。"},"similar":["犬牙相制","参差不齐"],"opposite":["整整齐齐"],"usage":"作谓语、定语；形容领土等","story":["西汉刘邦分封诸侯，诸侯凭借自己的实力与中央抗衡，汉景帝时就爆发了“七王之乱”，汉景帝并没吸取教训，又给自己13个儿子分封属地。汉武帝想收回他们的领地，诸侯们说先王把封地分得犬牙交错就是让他们力保汉朝江山"]},{"id":31033,"word":"犬牙差互","pinyin":"quǎn yá cī hù","abbr":"qych","explanation":"形容地势像犬牙一样参差不齐。","source":{"text":"其岸势犬牙差互，不可知其源。","book":"唐·柳宗元《小石潭记》"},"similar":["犬牙交错","犬牙相接"],"usage":"作谓语、定语；用于地形等"},{"id":31034,"word":"犬牙盘石","pinyin":"quǎn yá pán shí","abbr":"qyps","explanation":"指分封宗室以巩固统治。","source":{"text":"高帝封王子地，地犬牙相制，此所谓盘石之宗也。","book":"《史记·孝文本纪》"},"example":{"text":"盖所谓宗子维城，～之势。","book":"唐·元稹《论教本书》"},"similar":["盘石犬牙"],"usage":"作宾语、定语；用于比喻句"},{"id":31035,"word":"犬牙相临","pinyin":"quǎn yá xiāng lín","abbr":"qyxl","explanation":"形容地势像犬牙一样参差不齐地相连接。","source":{"text":"汉郡八九十，形错诸侯间，犬牙相临，秉甚厄塞地利。","book":"西汉·司马迁《史记·汉兴以来诸侯年表》"},"similar":["犬牙相接","犬牙交错"],"usage":"作谓语、定语；用于地形等"},{"id":31036,"word":"犬牙相制","pinyin":"quǎn yá xiāng zhì","abbr":"qyxz","explanation":"制：牵制。指地界连接，如犬牙交错，可以互相牵制。","source":{"text":"高帝封王子弟，地犬牙相制。","book":"《史记·孝文帝纪》"},"example":{"text":"唐初府兵最盛，后变为藩镇，虽跋扈不臣，而～，终藉其力。","book":"明·冯梦龙《警世通言》卷二十一"},"similar":["犬牙交错"],"usage":"作谓语、定语；形容领土等"},{"id":31037,"word":"犬牙相接","pinyin":"quǎn yá xiāng jiē","abbr":"qyxj","explanation":"形容地势像犬牙一样参差不齐。","source":{"text":"诸侯王自以骨肉至亲，先帝所以广封连城，犬牙相错者，为盘石宗也。","book":"《汉书·中山靖王传》"},"example":{"text":"若因州县改易，隶地入他境及～者，听依旧受。","book":"《通典·食货典》"},"similar":["犬牙相错","犬牙相临"],"usage":"作谓语、定语；用于地形等"},{"id":31038,"word":"犬牙相错","pinyin":"quǎn yá xiāng cuò","abbr":"qyxc","explanation":"错：交叉，错杂。比喻交界线很曲折，象狗牙那样参差不齐。也比喻情况复杂，双方有多种因素参差交错。","source":{"text":"诸侯王自以骨肉至亲，先帝所以广封连城，犬牙相错者，为盘石宗也。","book":"《汉书·中山靖王传》"},"example":{"text":"地体华离，～。","book":"章炳麟《论亚洲宜自为唇齿》"},"similar":["犬牙交错"],"usage":"作谓语、定语；形容领土等","story":["西汉刘邦分封诸侯，诸侯凭借自己的实力与中央抗衡，汉景帝时就爆发了“七王之乱”，汉景帝并没吸取教训，又给自己13个儿子分封属地。汉武帝想收回他们的领地，诸侯们说先王把封地分得犬牙交错就是让他们力保汉朝江山"]},{"id":31039,"word":"犬牙鹰爪","pinyin":"quǎn yá xīng zhǎo","abbr":"qyyz","explanation":"比喻奴才。","source":{"text":"犬牙鹰爪死不辞，触机折颈吁可悲！","book":"宋·陆游《艾如张》诗"},"example":{"text":"我这生财妙手，从来会抓。岂仗你～，才能做家。","book":"清·李渔《比目鱼·征利》"},"usage":"作宾语、定语；用于口语"},{"id":31040,"word":"犬迹狐踪","pinyin":"quǎn jì hú zōng","abbr":"qjhz","explanation":"比喻低弱的身手。","source":{"text":"他每那祖宗是斑斓的大虫，料想俺将门下无犬迹狐踪。","book":"元·王实甫《丽春堂》第一折"},"usage":"作宾语、定语；用于书面语"},{"id":31041,"word":"犬马之养","pinyin":"quǎn mǎ zhī yǎng","abbr":"qmzy","explanation":"供养父母的谦辞。","source":{"text":"今之孝者，是谓能养。至于犬马，皆能有养；不敬，何以别乎？","book":"《论语·为政》"},"example":{"text":"故辄上书阙下，愿殡先人之丘冢，自托于管库，以终～焉。","book":"宋·王安石《上相府书》"},"usage":"作宾语；指供养父母"},{"id":31042,"word":"犬马之决","pinyin":"quǎn mǎ zhī jué","abbr":"qmzj","explanation":"指臣僚的果敢决断。","source":{"text":"其有犬马之决者，仰药而伏刃。","book":"《汉书·息夫躬传》"},"usage":"作宾语、定语；用于处事"},{"id":31043,"word":"犬马之力","pinyin":"quǎn mǎ zhī lì","abbr":"qmzl","explanation":"愿象犬马那样为君主奔走效力。表示心甘情愿受人驱使，为人效劳。","source":{"text":"不才愿施犬马之力，同共替天行道。","book":"明·施耐庵《水浒传》第67回"},"example":{"text":"尚敢不效～，以报深恩也。","book":"明·许仲琳《封神演义》第68回"},"similar":["犬马之劳"],"usage":"作宾语；用于自谦"},{"id":31044,"word":"犬马之劳","pinyin":"quǎn mǎ zhī láo","abbr":"qmzl","explanation":"愿象犬马那样为君主奔走效力。表示心甘情愿受人驱使，为人效劳。","source":{"text":"臣光智谋浅短，犬马齿臷诚恐一旦颠仆，无以报称。","book":"《汉书·孔光传》"},"example":{"text":"李某不才，食禄多矣，无功报德，愿施～。","book":"明·施耐庵《水浒全传》第六十三回"},"similar":["犬马之报","死心塌地"],"opposite":["强人所难"],"usage":"作宾语；指为人效劳"},{"id":31045,"word":"犬马之命","pinyin":"quǎn mǎ zhī mìng","abbr":"qmzm","explanation":"对自己生命的谦称。","source":{"text":"臣备位宰相，老病日笃，犬马之命将尽。","book":"《三国志·魏志·华歆传》"},"usage":"作主语、宾语；指自命"},{"id":31046,"word":"犬马之年","pinyin":"quǎn mǎ zhī nián","abbr":"qmzn","explanation":"对尊上卑称自己的年龄。","source":{"text":"将以全陛下厚德，究孤犬马之年，此难能也。","book":"三国·魏·曹植《黄初六年令》"},"example":{"text":"老媳妇～七十有五。","book":"《京本通俗小说·西山一窟鬼》"},"similar":["犬马之齿"],"usage":"作宾语；用于自谦"},{"id":31047,"word":"犬马之心","pinyin":"quǎn mǎ zhī xīn","abbr":"qmzx","explanation":"犬马：旧时臣子对君主的自称。指臣子对君主的忠心。","source":{"text":"臣窃不胜犬马心，昧死愿陛下诏有司，因盛夏吉时定皇子位。","book":"《史记·三王世家》"},"example":{"text":"～以劳力，故能有养桑榆之景。","book":"宋·刘攽《知襄州谢上表》"},"similar":["狗马之心"],"usage":"作宾语、主语；用于自谦"},{"id":31048,"word":"犬马之恋","pinyin":"quǎn mǎ zhī liàn","abbr":"qmzl","explanation":"比喻臣子眷恋君上。","source":{"text":"矧匹夫之安土，邈投身于镐京。犹犬马之恋主，窃讬慕于阙庭。","book":"三国·魏·曹植《上责躬应诏诗表》：“瞻望反侧，不胜犬马恋主之情。”晋·潘岳《西征赋》"},"example":{"text":"虽两露之恩，幽遐必被，而～，亲近为荣。","book":"唐·刘禹鍚《苏州刺史谢 上表》"},"similar":["犬马恋主"],"usage":"作宾语；比喻忠诚"},{"id":31049,"word":"犬马之报","pinyin":"quǎn mǎ zhī bào","abbr":"qmzb","explanation":"愿象犬马那样供人驱使，以报恩情。","source":{"text":"吕布至死也不忘大德，当效犬马之报。","book":"元·无名氏《连环计》第二折"},"example":{"text":"异日不死，当效～。","book":"明·施耐庵《水浒传》第11回"},"usage":"作宾语；指报答恩情"},{"id":31050,"word":"犬马之疾","pinyin":"quǎn mǎ zhī jí","abbr":"qmzj","explanation":"谦称自己的疾病。","source":{"text":"值余有犬马之疾，不能究其精详。","book":"汉·张衡《东京赋》"},"example":{"text":"足下书来久矣，有～。","book":"清·姚鼐《复汪进士辉祖书》"},"usage":"作宾语；指有病"},{"id":31051,"word":"犬马之诚","pinyin":"quǎn mǎ zhī chéng","abbr":"qmzc","explanation":"谦称自己的诚意。","source":{"text":"臣伏以为犬马之诚不能动人，譬人之诚不能动天。","book":"《三国志·魏志·陈思王植传》"},"example":{"text":"臣闻皇上之谕，始则惊而骇，继则感而悲，犬马之诚，惟望陛下端拱穆清，恭默思道。","book":"蔡东藩《明史演义》第五十九回"},"usage":"作宾语；用于自谦"},{"id":31052,"word":"犬马之齿","pinyin":"quǎn mǎ zhī chǐ","abbr":"qmzc","explanation":"齿：年轮。自己的年龄。","source":{"text":"臣位至上卿，爵为列侯，犬马之齿七十六，为明诏填沟壑，死骨不朽，亡所顾念。","book":"《汉书·赵充国传》"},"example":{"text":"臣间者犹谓～，尚可小延，欲为陛下西平李雄，北吞石虎。","book":"蔡东藩《两晋演义》第四十三回"},"similar":["犬马之年"],"usage":"作宾语；用于自谦"},{"id":31053,"word":"犬马恋主","pinyin":"quǎn mǎ liàn zhǔ","abbr":"qmlz","explanation":"比喻臣下眷怀君上。","source":{"text":"瞻望反侧，不胜犬马恋主之情。","book":"三国·魏·曹植《上责躬应诏诗表》"},"example":{"text":"如今虽蒙皇太后、皇上详细询问，还觉得未尽所怀，马上又要远赴四川，不知陛见何日。臣实不胜～之情。","book":"高阳《慈禧全传》九十八"},"similar":["犬马之恋"],"usage":"作宾语、定语；比喻忠诚"},{"id":31054,"word":"犬马齿穷","pinyin":"quǎn mǎ chǐ qióng","abbr":"qmcq","explanation":"齿索：牙齿没有了。谦称自己年老体衰。","source":{"text":"迫于岁暮，犬马尺索。","book":"《后汉书·班超传》"},"similar":["犬马齿索"],"usage":"作谓语、定语；用于自谦"},{"id":31055,"word":"犬马齿索","pinyin":"quǎn mǎ chǐ suǒ","abbr":"qmcs","explanation":"齿索：牙齿没有了。谦称自己年老体衰。","source":{"text":"迫于岁暮，犬马尺索。","book":"《后汉书·班超传》"},"similar":["犬马齿穷"],"usage":"作谓语、定语；用于自谦"},{"id":31056,"word":"犯上作乱","pinyin":"fàn shàng zuò luàn","abbr":"fszl","explanation":"犯：干犯。封建统治者指人民的反抗、起义。","source":{"text":"不好犯上，而好作乱者，未之有也。","book":"《论语·学而》"},"example":{"text":"在封建社会的教条之下束缚久了的人，最怕的是“～，不忠不义”的罪名。","book":"郭沫若《少年时代·反正前后》"},"similar":["欺君犯上"],"opposite":["遵纪守法"],"usage":"作谓语、定语；用于反抗或作乱","story":["春秋时期，孔子带领弟子周游列国碰壁后，在冉求的帮助下，终于回到了父母之邦鲁国，他与季康子是不相为谋。于是专心著述，编辑整理《诗》《书》《礼》《乐》，用自己观点撰写《春秋》，他认为乱臣贼子看了此书再也不敢犯上作乱了"]},{"id":31057,"word":"犯关排闼","pinyin":"fàn guān pái tà","abbr":"fgpt","explanation":"犯：冲击，冒犯；关：大门；排：推；闼：小门。冲进大门，又闯进小门。","source":{"text":"乃被衽执辔，犯关排闼。","book":"唐·许尧佐《柳氏传》"}},{"id":31058,"word":"犯天下之不韪","pinyin":"fàn tiān xià zhī bù wéi","abbr":"ftxzbw","explanation":"犯：触犯；不韪：不是，错误。公然做天下都认为最大错误的事情。","source":{"text":"犯五不韪，而以伐人，其丧师也，不亦宜乎？","book":"春秋·鲁·左丘明《左传·隐公十一年》"},"example":{"text":"如山涛者，既为邪说之魁，遂使嵇绍之贤，且～，而不顾夫邪正之说不容两立。","book":"清·顾炎武《日知录·正始》"},"similar":["冒天下之大不韪"],"usage":"作谓语、宾语、定语；指做最大错误的事情"},{"id":31059,"word":"犯而不校","pinyin":"fàn ér bù jiào","abbr":"febj","explanation":"犯：触犯；校：计较。受到别人的触犯或无礼也不计较。","source":{"text":"以能问与不能，以多问于寡；有若无，实若虚，犯而不校。","book":"《论语·泰伯》"},"example":{"text":"惠养民道：“～，何以罚为？”大家微笑，各自散去。","book":"清·李绿园《歧路灯》第五十五回"},"similar":["唾面自干"],"opposite":["针锋相对","以眼还眼"],"usage":"作谓语、宾语、定语；指人大度"},{"id":31060,"word":"犯而勿校","pinyin":"fàn ér wù xiào","abbr":"fewx","explanation":"受到别人的触犯或无礼也不计较。同“犯而不校”。","source":{"text":"只有明明暗暗，吸血吃肉的凶手或其帮闲们，这才赠人以‘犯而勿校’或‘勿念旧恶’的格言。","book":"鲁迅《且介亭杂文末编·女吊》"},"similar":["犯而不校"],"usage":"作谓语、宾语、定语；指人大度"},{"id":31061,"word":"犯言直谏","pinyin":"fàn yán zhǐ jiǎn","abbr":"fyzj","explanation":"敢于冒犯尊长或皇上的威严而直立相劝。","source":{"text":"犯颜极谏，臣不如东郭牙，请立以为谏臣。","book":"韩非《韩非子·外储说左下》"},"similar":["知无不言","言无不尽"],"usage":"作谓语、定语；指直言规劝"},{"id":31062,"word":"犯颜敢谏","pinyin":"fàn yán gǎn jiàn","abbr":"fygj","explanation":"犯颜：冒犯君主或尊长的颜面；谏：以直言规劝。指敢于冒犯君主或尊长的威严而极力规劝。","source":{"text":"臣诚不佞，有匡国致君之术，无位而不得行；有犯颜敢谏之心，无路而不得达。","book":"唐·刘蕡《对贤良方正直言极谏策》"},"example":{"text":"是以～之士，恒于君臣之际，而绝不闻之朋友之间。","book":"明·李贽《焚书·答耿司寇》"},"similar":["犯颜极谏","犯颜苦谏","犯颜进谏"],"usage":"作谓语、定语；指敢于说真话"},{"id":31063,"word":"犯颜极谏","pinyin":"fàn yán jí jiàn","abbr":"fyjj","explanation":"犯颜：冒犯君主或尊长的颜面、威严；极谏：以直言规劝（常用下对上）。敢于冒犯君主或尊长的威严而极力规劝其改正错误。","source":{"text":"犯颜极谏，臣不如东郭牙，请立以为谏臣。","book":"《韩非子·外储说左下》"},"similar":["犯言直谏","犯颜敢谏"],"usage":"作谓语、定语；指敢于说真话"},{"id":31064,"word":"犯颜直谏","pinyin":"fàn yán zhí jiàn","abbr":"fyzj","explanation":"犯颜：冒犯君主或尊长的颜面、威严；直谏：以直言规劝。敢于冒犯君主或尊长的威严而极力规劝其改正错误。","source":{"text":"犯颜极谏，臣不如东郭牙，请立以为谏臣。","book":"《韩非子·外储说左下》"}},{"id":31065,"word":"犯颜苦谏","pinyin":"fàn yán kǔ jiàn","abbr":"fykj","explanation":"犯颜：冒犯君主或尊长的颜面、威严；苦谏：苦苦规劝（常用下对上）。敢于冒犯君主或尊长的威严而极力规劝其改正错误。","source":{"text":"犯颜极谏，臣不如东郭牙，请立以为谏臣。","book":"《韩非子·外储说左下》"},"example":{"text":"我等都是他的部下，不敢～。","book":"明·罗贯中《三国演义》第四十六回"},"similar":["犯颜极谏","犯颜进谏","犯颜敢谏"],"usage":"作谓语、宾语；指敢于直说"},{"id":31066,"word":"犯颜进谏","pinyin":"fàn yán jìn jiàn","abbr":"fyjj","explanation":"犯颜：冒犯君主或尊长的颜面；谏：以直言规劝。指敢于冒犯君主或尊长的威严而极力规劝。","source":{"text":"征状貌不逾中人，而素有胆智，每犯颜进谏，虽逢王赫斯怒，神色不移。","book":"《旧唐书·魏征传》"},"similar":["犯颜极谏","犯颜苦谏","犯颜敢谏"],"usage":"作谓语、定语；指敢于说真话"},{"id":31067,"word":"状貌不及中人","pinyin":"zhuàng mào bù jí zhōng rén","abbr":"zmbjzr","explanation":"壮貌：容貌；中人：一般人。容貌不如普通人","source":{"text":"吾视郭解状貌不及中人，言语不足采者。","book":"西汉·司马迁《史记·游侠列传》"},"usage":"作谓语、定语；用于书面语"},{"id":31068,"word":"犹有童心","pinyin":"yóu yǒu tóng xīn","abbr":"yytx","explanation":"犹：还。年龄虽已不小，但孩童之心不泯。","source":{"text":"于是昭公十九年矣，犹有童心，君子是以知其不能终也。","book":"《左传·襄公三十一年》"},"example":{"text":"大儿今十一，～，况诸幼孤，未亡人心力垂尽。","book":"《清史稿·列女传·陈时夏妻》"},"similar":["童心未泯"],"usage":"作谓语、定语；用于处事"},{"id":31069,"word":"犹解倒悬","pinyin":"yóu jiě dào xuán","abbr":"yjdx","explanation":"解：解救；倒悬：人被倒挂，比喻处境困难。比喻把人从危难中解救出来。","source":{"text":"当今之时，万乘之国行仁政，民之悦之，犹解倒悬也。","book":"《孟子·公孙丑上》"},"usage":"作谓语、定语；用于书面语"},{"id":31070,"word":"犹豫不决","pinyin":"yóu yù bù jué","abbr":"yybj","explanation":"犹豫：迟疑。拿不定主意。","source":{"text":"今乃顿兵不进，犹豫不决。","book":"《战国策·赵策三》：“平原君犹豫未有所决。”《周书·贺拔胜传》"},"example":{"text":"在决定这件事如何处理时，他变得～起来。"},"similar":["畏首畏尾","优柔寡断","举棋不定"],"opposite":["当机立断","斩钉截铁"],"usage":"作谓语、定语；指人处理问题","story":["战国时期，秦军围困赵都邯郸，赵孝成王派人向魏安厉王求援。魏将晋鄙屯兵汤阴，派人见平原君要赵孝成王同意秦王称帝，平原君犹豫不决，齐国谋士鲁仲连请平原君告诉魏国使者辛垣衍不要让秦称帝的理由，必须共同抗秦"]},{"id":31071,"word":"犹豫不定","pinyin":"yóu yù bù dìng","abbr":"yybd","explanation":"犹豫：迟疑。拿不定主意。","source":{"text":"他想趁他在这犹豫不定的时候，说出几句好话，放他走。","book":"刘流《烈火金刚》第八回"},"example":{"text":"他一向作大事抉择面前～。"},"similar":["犹豫不决","犹疑不定"],"opposite":["当机立断"],"usage":"作谓语、定语；指拿不定主意"},{"id":31072,"word":"犹豫未决","pinyin":"yóu yù wèi jué","abbr":"yywj","explanation":"指拿不定主意。","source":{"text":"吴娃死，爱弛，怜故太子，欲两王之，犹豫未决，故乱起，以至父子俱死，为天下笑，岂不痛乎！","book":"《史记·赵世家》"},"example":{"text":"太师若是～，可差一二将，出五关打听西岐消息。","book":"明·许仲琳《封神演义》第三十五回"},"similar":["犹豫不决","犹豫不定"],"opposite":["当机立断","斩钉截铁"],"usage":"作谓语、定语；指人处理问题"},{"id":31073,"word":"犹豫狐疑","pinyin":"yóu yù hú yí","abbr":"yyhy","explanation":"犹豫：迟疑；狐疑：多疑。指生性多疑，拿不定主意。","source":{"text":"心犹豫而狐疑兮，欲自适而不可。","book":"战国·楚·屈原《离骚》"},"similar":["狐疑犹豫"],"usage":"作谓语、定语、状语；用于处事"},{"id":31074,"word":"犹鱼得水","pinyin":"yóu yú dé shuǐ","abbr":"yyds","explanation":"好像鱼得到水一样。比喻有所凭借。也比喻得到跟自己十分投合的人或对自己很合适的环境。","source":{"text":"与亮情好日密，自以为犹鱼得水也。","book":"《三国志·蜀志·诸葛亮传》：“孤之有孔明，犹鱼之有水也。” 晋·常璩《华阳国志·刘先主志》"},"similar":["如鱼得水"],"usage":"作宾语、定语；用于书面语"},{"id":31075,"word":"狂三诈四","pinyin":"kuáng sān zhà sì","abbr":"kszs","explanation":"狂：诓的假借，诓骗。一味欺诈。","source":{"text":"我们老太太最是惜老怜贫的，比不得那个狂三诈四的那些人。","book":"清·曹雪芹《红楼梦》第三十九回"},"usage":"作谓语、定语；用于人不诚实"},{"id":31076,"word":"狂为乱道","pinyin":"kuáng wéi luàn dào","abbr":"kwld","explanation":"狂：狂妄；道：讲。狂妄地做事，胡乱地说话。","source":{"text":"今日你狂为乱道，等说出议论来，方许你作。","book":"清·曹雪芹《红楼梦》第十七回"}},{"id":31077,"word":"狂吟老监","pinyin":"kuáng yín lǎo jiān","abbr":"kylj","explanation":"唐代大诗人贺知章曾担任秘书监，晚年自号“四明狂客”，所以有“狂吟老监”之称。","source":{"text":"为唤狂吟老监，共赋销忧。","book":"宋·周密《一萼红·登蓬莱阁有感》词"},"usage":"作宾语；指诗人"},{"id":31078,"word":"狂吠狴犴","pinyin":"kuáng fèi bì àn","abbr":"kfba","explanation":"吠：狗叫；狴犴：传说中一种野兽名，这里指狂犬。狂犬乱叫。","source":{"text":"王侯之门，狂吠狴犴。臣到百步，喉喘颠汗。","book":"唐·柳宗元《乞巧文》"},"usage":"作谓语；指狂犬乱叫"},{"id":31079,"word":"狂奴故态","pinyin":"kuáng nú gù tài","abbr":"kngt","explanation":"狂奴：对狂士的亲昵称呼；故态：老样子，老脾气。旧称狂士的老脾气。","source":{"text":"霸得书，封奏之。帝笑曰：‘狂奴故态也。’车驾即日幸其馆。","book":"《后汉书·严光传》"},"example":{"text":"仆老矣，三生杜牧，万念俱空；只花月因缘，犹有～。","book":"清·袁枚《随园诗话》卷九"},"usage":"作宾语；称狂放不羁的人的老脾气","story":["汉朝严子陵与刘邦第九代孙子刘秀、长安侯霸三人结为非常要好的朋友。刘秀当上皇帝后，严子陵十分讨厌做官，有时故意刺激光武帝刘秀，但刘秀仍很尊敬他。侯霸当上大司徒以后，专门去请严子陵叙旧，他写信回绝，刘秀骂他是狂奴故态"]},{"id":31080,"word":"狂妄自大","pinyin":"kuáng wàng zì dà","abbr":"kwzd","explanation":"狂妄：极端的自高自大。指极其放肆，自高自大，自中无人。","source":{"text":"执谊，叔文乘时多僻，而欲斡运六合，斟酌万几；……何狂妄之甚也。","book":"《旧唐书·皇甫镈传》"},"example":{"text":"我们要谦虚谨慎，不能～。"},"similar":["骄傲自满","得意忘形"],"opposite":["谦虚谨慎","频频入礼"],"usage":"作谓语、宾语；指人自以为了不起"},{"id":31081,"word":"狂嫖滥赌","pinyin":"kuáng piáo làn dǔ","abbr":"kpld","explanation":"指沉溺于嫖妓赌博。","source":{"text":"跑到上海，狂嫖滥赌抽大烟，生病死去。","book":"《恨悔》第一回"},"example":{"text":"有钱的便～，没钱的便喝几十碗酒。","book":"鲁迅《热风·随感录六十二》"},"similar":["吃喝嫖赌"],"usage":"作谓语；指嫖妓赌博"},{"id":31082,"word":"狂峰浪蝶","pinyin":"kuáng fēng làng dié","abbr":"kfld","explanation":"轻狂的蜂蝶。比喻轻狂的男子。","source":{"text":"惊起娇莺语燕，打开浪蝶狂蜂。","book":"元·高明《琵琶记·牛小姐规劝侍俾》"}},{"id":31083,"word":"狂悖无道","pinyin":"kuáng bèi wú dào","abbr":"kbwd","explanation":"狂悖：狂妄背理。狂妄猖獗，蛮不讲理。","source":{"text":"汉大臣征贺为嗣，即位，狂悖无道。","book":"《汉书·五行志》"},"example":{"text":"昔桓玄篡逆～，已有此论。","book":"唐·释道宣《广弘明集》卷十二"},"usage":"作谓语、定语；指人蛮横"},{"id":31084,"word":"狂朋怪侣","pinyin":"kuáng péng guài lǚ","abbr":"kpgl","explanation":"行为狂放不循常轨的朋友。","source":{"text":"帝里风光好，当年少日，暮宴朝欢。况有狂朋怪侣，遇当歌、对酒竞留连。","book":"宋·柳永《戚氏》词"},"similar":["狂朋怪友"],"usage":"作主语、宾语；用于朋友间"},{"id":31085,"word":"狂朋怪友","pinyin":"kuáng péng guài yǒu","abbr":"kpgy","explanation":"行为狂放不循常轨的朋友。同“狂朋怪侣”。","source":{"text":"见你每朝逐日，伴着那火狂朋怪友，饮酒作乐。","book":"元·杨文奎《儿女团圆》楔子"},"similar":["狂朋怪侣"],"usage":"作主语、宾语；用于朋友间"},{"id":31086,"word":"狂朋恠友","pinyin":"kuáng péng guài yǒu","abbr":"kpgy","explanation":"行为狂放不循常轨的朋友。同“狂朋怪侣”。"},{"id":31087,"word":"狂歌痛饮","pinyin":"kuáng gē tòng yǐn","abbr":"kgty","explanation":"狂：越出常度；痛：痛快，尽情。欢畅饮酒，纵情唱歌。形容喜悦的心情。","source":{"text":"千秋万古，为留待骚人，狂歌痛饮，来访雁丘处。","book":"金·元好问《摸鱼儿》"},"similar":["痛饮狂歌"],"usage":"作谓语、定语、宾语；用于生活"},{"id":31088,"word":"狂涛巨浪","pinyin":"kuáng tāo jù làng","abbr":"ktjl","explanation":"比喻剧烈的社会运动。同“狂涛骇浪”。","source":{"text":"巴金《废园外·长夜》“先前那里面有的是狂涛巨浪，现在却是一阵炙骨熬心的烈火。”"},"example":{"text":"路遥《平凡的世界》第五卷第25章：“为了迎合这种文学的～，有许多文学单位和报刊杂志，纷纷办起了什么‘文学讲座’……”"},"similar":["狂涛骇浪"],"opposite":["风平浪静"],"usage":"作主语、宾语、定语；指大浪"},{"id":31089,"word":"狂涛骇浪","pinyin":"kuáng tāo hài làng","abbr":"kthl","explanation":"比喻剧烈的社会运动。","source":{"text":"其立于城上之罗兰夫人及狄郎的士党，遂不得不为狂涛骇浪之所淘尽矣。","book":"清·梁启超《近代第一女杰罗兰夫人传》"},"example":{"text":"我和诸同志当时也是飘流震荡于这种～之中。","book":"瞿秋白《饿乡纪程》"},"similar":["惊涛骇浪","狂涛巨浪"],"opposite":["风平浪静"],"usage":"作宾语；指社会运动"},{"id":31090,"word":"狂犬吠日","pinyin":"kuáng quǎn fèi rì","abbr":"kqfr","explanation":"疯狗对着太阳乱叫。比喻坏人自不量力地叫嚣。","source":{"text":"屈子赋曰：‘邑犬群吠，吠所怪也。’仆往闻庸、蜀之南，恒雨少日，日出则犬吠。","book":"唐·柳宗元《答韦中立论师道书》"},"similar":["蜀犬吠日"],"usage":"作宾语、定语；指少见多怪"},{"id":31091,"word":"狂瞽之言","pinyin":"kuáng gǔ zhī yán","abbr":"kgzy","explanation":"狂：狂妄。瞽：瞎眼，盲目。指愚妄无知的言论。旧时常用作自谦之辞。亦作“狂瞽之说”。","source":{"text":"伏愿陛下采臣狂瞽之言，参以刍荛之议，冀千虑一得，衮职有补。","book":"唐·魏征《十渐不克终疏》"},"example":{"text":"况兑运一事，所系非浅，是以少效～。","book":"明·归有光《遗王都御史书》"},"similar":["狂瞽之说"],"usage":"作宾语；用于自谦"},{"id":31092,"word":"狂瞽之说","pinyin":"kuáng gǔ zhī shuō","abbr":"kgzs","explanation":"狂：狂妄；瞽：瞎眼。指愚妄无知的言论。旧时常用作自谦之辞。","source":{"text":"使得尽狂瞽之说，披肝胆之诚。","book":"《南史·虞寄传》"},"example":{"text":"此等～，是自求扰乱，与暴徒甘心破坏，结果无殊。","book":"蔡东藩、许廑父《民国通俗演义》第四十五回"},"similar":["狂瞽之言"],"usage":"作宾语；用于自谦"},{"id":31093,"word":"狂花病叶","pinyin":"kuáng huā bìng yè","abbr":"khby","explanation":"狂花：醉酒喧哗；病叶：醉酒闭目入睡。比喻醉酒的人。","source":{"text":"饮流谓睚眦者为狂花，且睡者为病叶。","book":"唐·黄甫松《醉乡日月》"},"usage":"作宾语、定语；用于比喻句"},{"id":31094,"word":"狂蜂浪蝶","pinyin":"kuáng fēng làng dié","abbr":"kfld","explanation":"比喻轻薄放荡的男子。","source":{"text":"惊起娇莺语燕，打开浪蝶狂蜂。","book":"元·高明《琵琶记·牛小姐规劝侍俾》"},"example":{"text":"紫燕黄莺，绿柳丛中寻对偶；～，夭桃队里觅相知。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["浪蝶狂蜂"],"usage":"作宾语、定语；指放荡的男子"},{"id":31095,"word":"狂言瞽说","pinyin":"kuáng yán gǔ shuō","abbr":"kygs","explanation":"狂：狂放任性；瞽：盲目。狂妄无知，信口开河。形容人狂妄愚昧，胡说八道。","source":{"text":"御史劾均狂言瞽说，诬罔祥瑞，请依大不敬论。","book":"《汉书·晁错传》：“臣错愚陋，昧死上狂言。”《汉书·谷永传》：“中尚书宦官，槛塞大异，皆瞽说欺天者也。”《晋书·刘曜传》"},"example":{"text":"廷臣劾均～，诬妄妖瑞，应作大不敬论。","book":"蔡东藩《两晋演义》第四十一回"}},{"id":31096,"word":"狂轰滥炸","pinyin":"kuáng hōng làn zhà","abbr":"khlz","explanation":"指疯狂地轰炸。","source":{"text":"天上飞机狂轰滥炸，地上发动武装大游行。","book":"李若冰《瓦窑堡啊，一盏不灭的灯》"},"usage":"作谓语；指疯狂地轰炸"},{"id":31097,"word":"狂风不终朝，骤雨不终日","pinyin":"kuáng fēng bù zhōng zhāo，zhòu yǔ bù zhōng rì","abbr":"kfbzczybzr","explanation":"大风刮不到一早晨就会过去，硕士下不到一天就会停止。比喻乌云笼罩的日子不会长久，光明终将来临。","source":{"text":"故飘风不终朝，骤雨不终日。","book":"《老子》第二十三章"}},{"id":31098,"word":"狂风大作","pinyin":"kuáng fēng dà zuò","abbr":"kfdz","explanation":"刮大风。","source":{"text":"初时穿林透树，次后走石飞砂，须臾白浪掀天，顷刻黑云覆地，红日无光，狂风大作。","book":"明·施耐庵《水浒传》第79回"},"example":{"text":"四面呼呼乱响，顷刻～，波浪滔天。","book":"清·李汝珍《镜花缘》第38回"},"usage":"作谓语、定语、状语；用于天气等"},{"id":31099,"word":"狂风巨浪","pinyin":"kuáng fēng jù làng","abbr":"kfjl","explanation":"猛烈的风，巨大的浪。指来势迅猛或同时有强劲冲击力的变化。","source":{"text":"异性之间任何微小的情感，都可能在一个少年的内心掀起狂风巨浪！","book":"路遥《平凡的世界》第一卷第二章"},"usage":"作主语、宾语、定语；用于书面语"},{"id":31100,"word":"狂风怒号","pinyin":"kuáng fēng nù háo","abbr":"kfnh","explanation":"怒：愤怒，发怒；号：号叫。大风刮得像发怒一样号叫。","source":{"text":"八月秋高风怒号，卷我屋上三重茅。","book":"唐·杜甫《茅屋为秋风所破歌》"},"example":{"text":"天气变化无常，一会儿是晴空万里，一会儿是～。"},"similar":["狂风暴雨","狂风骤雨"],"opposite":["风平浪静"],"usage":"作谓语、宾语；指大风刮得像发怒一样号叫"},{"id":31101,"word":"狂风怒吼","pinyin":"kuáng fēng nù hǒu","abbr":"kfnh","explanation":"狂：气势猛烈。形容大风呼啸猛烈。","source":{"text":"忽然狂风怒吼，怪浪波翻，其舟在水，飘飘如一叶。","book":"明·冯梦龙《醒世恒言》卷四十"},"example":{"text":"早上九点钟，外滩一带，～。","book":"茅盾《子夜》十一"},"usage":"作谓语、宾语；用于恶劣天气"},{"id":31102,"word":"狂风恶浪","pinyin":"kuáng fēng è làng","abbr":"kfel","explanation":"恶浪：凶猛的浪头。比喻形势或处境非常险恶、危急。","example":{"text":"我们要经得起狂风恶浪的冲击。"},"similar":["狂风暴雨"],"opposite":["风平浪静"],"usage":"作谓语、宾语；比喻形势或处境非常险恶"},{"id":31103,"word":"狂风暴雨","pinyin":"kuáng fēng bào yǔ","abbr":"kfby","explanation":"指大风大雨。亦比喻猛烈的声势或处境险恶。","source":{"text":"故飘风不终朝，骤雨不终日。","book":"《老子》第二十三章"},"example":{"text":"却遇了一阵～。","book":"清·吴趼人《二十年目睹之怪现状》"},"similar":["暴风骤雨","风雨如磐"],"opposite":["和风细雨","风调雨顺"],"usage":"作谓语、宾语；形容天气、处境等"},{"id":31104,"word":"狂风骤雨","pinyin":"kuáng fēng zhòu yǔ","abbr":"kfzy","explanation":"原形容大风大雨。后也比喻处境险恶或声势猛烈。","source":{"text":"故飘风不终朝，骤雨不终日。","book":"《老子》第二十三章"},"example":{"text":"我沉吟罢仔细听来，原来是唤醒人～。","book":"元·杨显之《潇湘雨》第四折"},"similar":["狂风暴雨"],"usage":"作谓语、宾语；比喻处境险恶或声势猛烈"},{"id":31105,"word":"狂饮暴食","pinyin":"kuáng yǐn bào shí","abbr":"kybs","explanation":"狂：纵情任性。大吃大喝。","example":{"text":"放纵的～对人的身体不利。"},"similar":["大吃大喝"],"usage":"作主语、宾语；指大吃大喝"},{"id":31106,"word":"狃于故辙","pinyin":"niǔ yú gù zhé","abbr":"nygz","explanation":"狃：习以为常。习惯于走老路。形容保守、拘泥于旧方法，旧框框，不愿意改变。","source":{"text":"臣愚等以为驭天下之势，当论其轻重强弱，远近先后，不宜胶于一偏，狃于故辙。","book":"《元史·张桢传》"}},{"id":31107,"word":"狎雉驯童","pinyin":"xiá zhì xùn tóng","abbr":"xzxt","explanation":"以之誉人政绩。","source":{"text":"汉鲁恭宰中牟，以德化民。时郡国螟蝗伤稼，独不入其境；有母雉将雏过童子旁，童子仁而不捕。事见《后汉书·鲁恭传》。"},"usage":"作宾语、定语；用于赞誉官员的政绩","story":["汉朝时期，官员鲁恭任中牟地方官，他用德仁来感化人，取得了明显成效。老百姓很自觉地从事公益劳动，当时别的郡县蝗灾很严重，唯独中牟境内没有伤害。有母野鸡带小野鸡在大路上大摇大摆地行走，连小孩都不去捕捉他们"]},{"id":31108,"word":"狐不二雄","pinyin":"hú bù èr xióng","abbr":"hbex","explanation":"比喻两雄不可并存。","source":{"text":"日月不并出，狐不二雄，神友不匹，锰库不群，鸷鸟不双。","book":"《淮南子·说林训》"},"similar":["一山不容二虎"],"usage":"作宾语、定语；用于比喻句"},{"id":31109,"word":"狐假虎威","pinyin":"hú jiǎ hǔ wēi","abbr":"hjhw","explanation":"假：借。狐狸假借老虎的威势。比喻依仗别人的势力欺压人。","source":{"text":"虎求百兽而食之，得狐。……虎以为然，故遂与之行。兽见之皆走，虎不知兽畏己而走也，以为畏狐也。","book":"《战国策·楚策一》"},"example":{"text":"果然府中来借，怎好不借？只怕被别人～的诓的去，这个却保不得他。","book":"明·凌濛初《二刻拍案惊奇》卷二十"},"similar":["仗势欺人","狗仗人势"],"opposite":["独步天下","独擅胜场"],"usage":"作谓语、定语、宾语；指借机欺压别人","story":["很久以前，森林里有只老虎看到一只狐狸就想吃掉它，狐狸大叫：“我是玉帝派来的百兽之王，你如同一起走一走，看看森林里的动物是不是很害怕我。”老虎想也没想就随同前往，果然小动物见了就跑"]},{"id":31110,"word":"狐假鸱张","pinyin":"hú jiǎ chī zhāng","abbr":"hjcz","explanation":"比喻倚仗别人，虚张声势。","source":{"text":"初则狐假鸱张，自谓骁雄莫敌；旋则鸟鱼烂，无非破账而终。","book":"《旧唐书·僖宗纪》"},"similar":["狐假虎威","虚张声势"],"usage":"作谓语、定语；用于处事"},{"id":31111,"word":"狐兔之悲","pinyin":"hú tù zhī bēi","abbr":"htzb","explanation":"狐死则兔悲，兔死则狐亦悲。比喻因同类的死亡而感到痛心悲伤。","source":{"text":"因视国家将倾，诸贤就戮，上之不能如孙登之污埋，次之不能如皇甫规之不与，下之不能兴狐兔之悲，方且沾沾自喜，因同志之死以为名高，是诚何忍哉。","book":"明·朱国桢《涌幢小品·黄叔度二诬辨》"},"example":{"text":"同作亡民，相逢作楚囚之泣，或将兴～矣。","book":"李大钊《厌世心与自觉心》"},"similar":["狐死兔泣"],"usage":"作宾语；比喻因同类的死亡而感到悲伤"},{"id":31112,"word":"狐凭鼠伏","pinyin":"hú píng shǔ fú","abbr":"hpsf","explanation":"象狐狸、老鼠那样潜伏在里面。","source":{"text":"山居草宿，狐潜鼠伏，将略胜孙吴，军势振颇牧。","book":"明·张景《飞丸记·公馆言情》"},"example":{"text":"逆夷务～，潜避两炮台中，不敢出入。","book":"《广东军务记·三元里平夷录》"},"similar":["狐潜鼠伏"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":31113,"word":"狐听之声","pinyin":"hú tīng zhī shēng","abbr":"htzs","explanation":"指冰下水流之声。","source":{"text":"狐之为兽，又多猜疑，故听河冰无流水声，然後敢渡。","book":"《水经注·河水一》引《述征记》：“冰始合，车马不敢过，要须狐行，云此物善听，冰下无水乃过，人见狐行方渡。”北齐颜之推《颜氏家训·书证》"},"example":{"text":"别浦宵凝，～乍绝；回汀晓合，虫疑之质俄生。","book":"唐·林滋《阳冰赋》"},"usage":"作宾语；用于书面语"},{"id":31114,"word":"狐唱枭和","pinyin":"hú chàng xiāo hè","abbr":"hcxh","explanation":"枭：传说中的恶鸟。比喻坏人互相勾结。","source":{"text":"由是世充、建德、黑闼、武周之辈，狐唱枭和，蝟芒而来。","book":"宋·王禹偁《杜伏威传赞序》"},"example":{"text":"奸臣们～，弄得仁宗六神无主"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":31115,"word":"狐埋狐扬","pinyin":"hú mái hú yáng","abbr":"hmhy","explanation":"比喻疑虑过多，不能成事。同“狐埋狐搰”。","source":{"text":"而狐埋狐扬，天下其谓政府何？","book":"梁启超《复古思潮平议》"},"similar":["狐埋狐搰"],"usage":"作谓语、定语；比喻疑虑过多"},{"id":31116,"word":"狐埋狐搰","pinyin":"hú mái hú hú","abbr":"hmhh","explanation":"搰：挖掘。狐性多疑，刚把东西埋下，又把挖出来看看。比喻疑虑过多，不能成事。","source":{"text":"狐埋之，而狐搰之，是以无成功。","book":"《国语·吴语》"},"example":{"text":"回忆辛亥革命，全国人心，方以为推翻清室，永除专制，此后得享共和之幸福，面不意～，迄未有成。","book":"《民国通俗演义自序》"},"similar":["狐埋狐扬"],"usage":"作谓语、定语；比喻疑虑过多"},{"id":31117,"word":"狐奔鼠窜","pinyin":"hú bēn shǔ cuàn","abbr":"hbsc","explanation":"像狐狸和老鼠那样东逃西窜。形容狼狈逃窜的样子。","source":{"text":"或有狐奔鼠窜，逃首北境。","book":"《宋书·索虏传》"},"example":{"text":"诸部士卒，俱各～退去。","book":"明·徐渭《英烈传》第二十一回"},"similar":["狼奔豕突"],"usage":"作谓语、定语；指狼狈样子","story":["南北朝时期，豫州是后魏与宋国的边境，边境百姓深受战争之苦，两边的盗贼趁着战乱窜到对方境内烧杀抢掠无恶不作。魏刺史北井侯库辰树兰责怪宋打击盗贼不力，宋刺史南平王刘铄则认为是宋征讨盗贼，他们才狐奔鼠窜逃到魏方寻求保护的"]},{"id":31118,"word":"狐媚惑主","pinyin":"hú mèi huò zhǔ","abbr":"hmhz","explanation":"传说狐狸能用媚态来迷惑人。比喻做出各种媚态来讨好迷惑主人。","source":{"text":"掩袖工谗，狐媚偏能惑主，践元后于翚翟。","book":"唐·骆宾王《为徐敬业讨武曌檄》"}},{"id":31119,"word":"狐媚猿攀","pinyin":"hú mèi yuán pān","abbr":"hmyp","explanation":"像狐狸那样善于迷惑人，像猿猴那样善于攀高。比喻不择手段地追求名利。","source":{"text":"其间狐媚猿攀，途辙不一；蝇营狗窃，窠臼且多，臣不能悉奉。","book":"明·刘体乾《财用诎乏恳乞圣明节省疏》"},"usage":"作宾语、定语；用于为人"},{"id":31120,"word":"狐媚魇道","pinyin":"hú mèi yǎn dào","abbr":"hmyd","explanation":"指行为妖邪。","source":{"text":"我说那孩子倒不像那狐媚魇道的。","book":"《红楼梦》第二十回：“你总不听我的话。倒叫这些人教的你歪心邪意、狐媚魇道的。”又第四四回"},"usage":"作谓语、定语、宾语；用于为人"},{"id":31121,"word":"狐朋狗党","pinyin":"hú péng gǒu dǎng","abbr":"hpgd","explanation":"泛指一些吃喝玩乐、不务正业的朋友。","source":{"text":"你不识羞，每日伴着些狐朋狗党，那个是好的？","book":"元·高文秀《遇上皇》第一折"},"example":{"text":"他的那些～都只知道吃喝玩乐。"},"similar":["狐朋狗友","狗党狐朋"],"usage":"作主语、宾语；指狐朋狗友"},{"id":31122,"word":"狐朋狗友","pinyin":"hú péng gǒu yǒu","abbr":"hpgy","explanation":"泛指一些吃喝玩乐、不务正业的朋友。","source":{"text":"他那里暗暗的藏，我须索紧紧的防，都是些狐朋狗党。","book":"元·关汉卿《单刀会》第三折"},"example":{"text":"恼的是那～，搬弄是非，调三窝四；气的是为他兄弟不学好，不上心念书。","book":"清·曹雪芹《红楼梦》第十回"},"similar":["狐群狗党","狼狈为奸"],"opposite":["良朋益友","莫逆之交","刎颈之交"],"usage":"作主语、宾语、定语；指不务正业的朋友","story":["贾宝玉与秦可卿的弟弟秦钟去贾家学房里念书，与薛蟠、金荣等发生了矛盾，贾瑞要求金荣向秦钟道歉。金荣的母亲觉得不公平就去贾珍府里找尤氏说理。尤氏说秦可卿恨那帮狐朋狗友搬弄是非，已经气得生病了，金荣的母亲自觉没趣就回去了"]},{"id":31123,"word":"狐死兔泣","pinyin":"hú sǐ tù qì","abbr":"hstq","explanation":"比喻因同类的死亡而感到悲伤。","source":{"text":"狐死兔泣，李氏灭，夏氏宁得独存？","book":"《宋史·李全传》"},"similar":["狐兔之悲"],"usage":"作谓语；比喻因同类的死亡而感到悲伤"},{"id":31124,"word":"狐死首丘","pinyin":"hú sǐ shǒu qiū","abbr":"hssq","explanation":"首丘：头向着狐穴所在的土丘。传说狐狸将死时，头必朝向出生的山丘。比喻不忘本。也比喻暮年思念故乡。","source":{"text":"狐死正丘首，仁也。","book":"战国·楚·屈原《九章·涉江》：“鸟飞反故乡兮，狐死必首丘。”《礼记·檀弓上》"},"example":{"text":"我告诉过你“～”的故事，一个人到死都是怀念自己的乡土的。","book":"郭沫若《蔡文姬》第一幕"},"similar":["归正首丘"],"usage":"作谓语、定语；比喻不忘本或思念故乡","story":["战国时期，屈原因遭人忌妒与陷害，得不到楚王的信任，被放逐到外地，他在被放逐的困苦生活中，写下许多反映人民愿望与现实矛盾的诗篇，代表作有《离骚》、《九歌》、《九章》等，他的《哀郢》诗：“鸟飞反故乡兮，狐死必首丘。”"]},{"id":31125,"word":"狐潜鼠伏","pinyin":"hú qián shǔ fú","abbr":"hqsf","explanation":"像狐狸和老鼠一样潜伏、藏匿。形容胆怯躲藏的样子。","source":{"text":"山居草宿，狐潜鼠伏，将略胜孙吴，军势振颇牧。","book":"明·张景《飞丸记·公馆言情》"},"similar":["狐凭鼠伏"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":31126,"word":"狐狸尾巴","pinyin":"hú li wěi ba","abbr":"hlwb","explanation":"古时传说狐狸能够变成人形来迷惑人，但它的尾巴却始终变不了，成为妖的标志。比喻坏人的本来面目或迷惑人的罪证。","source":{"text":"孙岩娶妻三年，不脱衣而卧。岩私怪之，伺其睡，阴解其衣，有尾长三尺似狐尾。岩惧而出之。","book":"北魏·杨衒之《洛阳伽蓝记·法云寺》"},"example":{"text":"但是他的话未免说的太露骨，已经明明白白把他的～显露出来了。","book":"冯玉祥《我的生活》第十一章"},"usage":"作宾语；指证据"},{"id":31127,"word":"狐狸精","pinyin":"hú lǐ jīng","abbr":"hlj","explanation":"迷信人认为狐狸能修炼成精，变成美女迷惑人。指勾引诱惑男人的女子。","source":{"text":"王夫人道：‘唱戏的女孩子，自然是狐狸精了！’","book":"清·曹雪芹《红楼梦》"},"example":{"text":"清·李宝嘉《官场现形记》第三回：“原来他盟弟姓胡名理，绰号叫做～。”"},"usage":"作主语、宾语、定语；用于女性"},{"id":31128,"word":"狐疑不决","pinyin":"hú yí bù jué","abbr":"hybj","explanation":"传说狐狸多疑，所以称多疑叫狐疑。形容心里疑惑，一时决定不下来。","source":{"text":"表狐疑不断，乃遣嵩诣操，观望虚实。","book":"《后汉书·刘表传》"},"example":{"text":"县官听说，也自～起来，暗想道：这事倒是我认错了？","book":"明·东鲁古狂生《醉醒石》第三回"},"similar":["犹豫不决","忧柔寡断"],"opposite":["当机立断"],"usage":"作谓语、定语、状语；指犹豫不决","story":["黄河的孟津、河津两处渡口河面较窄，冬天河水结成冰，车马可以从冰上渡过。刚结冰时人们不敢过渡，古人想出让狐狸先行通过的办法，因为狐狸多疑，边走边听冰下的水声，遇到狐疑不决时必须提防能否通过，狐狸能过就可以放心通行了"]},{"id":31129,"word":"狐疑不定","pinyin":"hú yí bù dìng","abbr":"hybd","explanation":"狐疑：犹豫，狐性多疑。传说狐狸多疑。形容心里疑惑，一时决定不下来。","source":{"text":"臣为将军决一死战，万死不辞，只恐将军狐疑不定。","book":"明·罗贯中《三国演义》第44回"},"similar":["狐疑不断","狐疑不决","狐疑未决"],"usage":"作谓语、定语、状语；指犹豫不决"},{"id":31130,"word":"狐疑不断","pinyin":"hú yí bù duàn","abbr":"hybd","explanation":"狐疑：犹豫，狐性多疑。传说狐狸多疑。形容心里疑惑，一时决定不下来。","source":{"text":"表狐疑不断，乃遣嵩诣操，观望虚实。","book":"南朝·宋·范晔《后汉书·刘表传》"},"similar":["狐疑不定","狐疑未决","狐疑不决"],"usage":"作谓语、定语、状语；指犹豫不决"},{"id":31131,"word":"狐疑未决","pinyin":"hú yí wèi jué","abbr":"hywj","explanation":"传说狐狸多疑，所以称多疑叫狐疑。形容心里疑惑，一时决定不下来。","source":{"text":"时山东略定，帝谋西收嚣兵，与俱伐蜀。嚣将王元说嚣，故狐疑不决。","book":"《东观汉纪·来歙传》"},"similar":["狐疑不决","狐疑不定","狐疑不断"],"usage":"作谓语、定语、状语；指犹豫不决"},{"id":31132,"word":"狐疑犹豫","pinyin":"hú yí yóu yù","abbr":"hyyy","explanation":"狐疑：多疑；犹豫：迟疑。指生性多疑，拿不定主意。","source":{"text":"夫大行不小谨，盛德不辞让，乡曲各有宜而百官不同功。故顾小而忘大，后必有害；狐疑犹豫，后必有悔。断而敢行，鬼神避之，后有成功。","book":"《史记·李斯列传》"},"example":{"text":"今因其闲也而书之，恒恐后世之知言者用是诟病，～，伏而不出者累月，方示足下。","book":"唐·柳宗元《答吴武陵论非国语书》"},"similar":["犹豫狐疑"],"usage":"作谓语、定语、状语；用于处事"},{"id":31133,"word":"狐绥鸨合","pinyin":"hú suí bǎo hé","abbr":"hsbh","explanation":"绥：独来独往，急于求偶的样子；鸨：比雁略大的一种鸟；合：融洽。比喻男女之间发生不正当的关系。","source":{"text":"邻妇浼卖花媪以重利招之往，狐绥鸨合，丑声藉藉于闾巷间。","book":"《诗经·卫风·有狐》：“有狐绥绥，在彼淇梁。”清·王韬《淞隐漫录·乐仲瞻》"}},{"id":31134,"word":"狐群狗党","pinyin":"hú qún gǒu dǎng","abbr":"hqgd","explanation":"比喻勾结在一起的坏人。","source":{"text":"咱若不是扶刘锄项，逐着那狐群狗党，兀良怎显得咱这黥面当王！","book":"元·无名氏《气英布》第四折"},"example":{"text":"在哥哥这几年在外头相与的都是些什么人！连一个正经的都没有，来一起子，都是些～。","book":"清·曹雪芹《红楼梦》第九十回"},"similar":["一丘之貉","狐朋狗友","沆瀣一气"],"opposite":["群英荟萃"],"usage":"作主语、宾语、定语；比喻勾结一气的人"},{"id":31135,"word":"狐藉虎威","pinyin":"hú jiè hǔ wēi","abbr":"hjhw","explanation":"比喻仰仗别人威势或倚仗别人的势力欺压人。同“狐假虎威”。","source":{"text":"曾不知鼠凭社贵，狐藉虎威，外无逼主之嫌，内有专用之功。","book":"《宋书·恩幸传序》"},"similar":["狐假虎威"],"usage":"作谓语、定语、宾语；指借机欺压别人"},{"id":31136,"word":"狐虎之威","pinyin":"hú hǔ zhī wēi","abbr":"hhzw","explanation":"狐狸与老虎相互勾结而表现出来的威势。比喻权贵当道者与其爪牙串通一气而发出的淫威。","source":{"text":"虎求百兽而食之，得狐。……虎以为然，故遂与之行。兽见之皆走，虎不知兽畏己而走也，以为畏狐也。","book":"《战国策·楚策一》"},"example":{"text":"因为段祺瑞总理和他的帮闲们的迫压，我已经逃到厦门，但北京的～还正是无穷无尽。","book":"鲁迅《且介亭杂文·忆韦素园君》"},"similar":["狐假虎威"],"usage":"作宾语；指狐假虎威"},{"id":31137,"word":"狐裘尨茸","pinyin":"hú qiú méng róng","abbr":"hqmr","explanation":"用以比喻国政混乱。尨茸，蓬乱的样子。同“狐裘蒙戎”。","source":{"text":"狐裘尨茸，一国三公，吾谁适从？","book":"《左传·僖公五年》"},"similar":["狐裘蒙戎","狐裘蒙茸"],"usage":"作宾语、定语；用于比喻句"},{"id":31138,"word":"狐裘羔袖","pinyin":"hú qiú gāo xiù","abbr":"hqgx","explanation":"裘：皮衣；羔：指小羊皮。狐皮衣服，羔皮袖子。比喻整体尚好，略有缺点。","source":{"text":"余不说初矣，余狐裘而羔袖。","book":"《左传·襄公十四年》"},"example":{"text":"必令自家成法，能免～哉。","book":"清·顾复《平生壮观·燕文贵》"},"usage":"作谓语、宾语；比喻大体尚好，略有缺点"},{"id":31139,"word":"狐裘蒙戎","pinyin":"hú qiú méng róng","abbr":"hqmr","explanation":"狐裘的皮毛凌乱。用以比喻国政混乱。蒙茸，蓬乱的样子。","source":{"text":"狐裘蒙戎，匪车不东。叔兮伯兮，靡所与同。","book":"《诗·邶风·旄丘》"},"example":{"text":"或曰，～，指卫大夫，而讥其愦乱之意。","book":"朱熹集传"},"similar":["狐裘蒙茸","狐裘尨茸"],"usage":"作宾语、定语；用于比喻句"},{"id":31140,"word":"狐裘蒙茸","pinyin":"hú qiú méng róng","abbr":"hqmr","explanation":"用以比喻国政混乱。蒙茸，蓬乱的样子。同“狐裘蒙戎”。","source":{"text":"狐裘蒙茸，一国三公，吾谁适从？","book":"《史记·晋世家》"},"example":{"text":"李郎彤管双碧玉，～裼惨绿。","book":"明·陈子龙《立春前三日寄舒章京师》诗"},"similar":["狐裘蒙戎","狐裘尨茸"],"usage":"作宾语、定语；用于比喻句"},{"id":31141,"word":"狐踪兔穴","pinyin":"hú zōng tù xué","abbr":"hztx","explanation":"喻指坟墓。","source":{"text":"投至狐踪与兔穴，多少豪杰。","book":"元·马致远《双调·夜行船·秋思》"}},{"id":31142,"word":"狐鸣枭噪","pinyin":"hú míng xiāo zào","abbr":"hmxz","explanation":"比喻小人气势嚣张。","source":{"text":"狐鸣枭噪争署置，睗跳踉相妩媚。","book":"唐·韩愈《永贞行》"},"usage":"作宾语、定语；用于比喻句"},{"id":31143,"word":"狐鸣狗盗","pinyin":"hú míng gǒu dào","abbr":"hmgd","explanation":"指作恶偷盗之徒。旧时统治者对造反者的贬称。","source":{"text":"畋谬领藩垣，荣兼将相，每枕戈而待旦，常泣血以忘餐，誓与义士忠臣，共剪狐鸣狗盗。","book":"《旧唐书·郑畋传》"},"usage":"作宾语、定语；用于处事"},{"id":31144,"word":"狐鸣篝中","pinyin":"hú míng gōu zhōng","abbr":"hmgz","explanation":"指起事者动员群众的措施。同“狐鸣鱼书”。","source":{"text":"此自秦以来，所以狐鸣篝中，王在掌上，卯金伏诛，魏氏当涂，黠盗奸雄，凯觎神器史，史不绝书。","book":"清·邹容《革命军》第一章"},"similar":["狐鸣篝火","狐鸣鱼出","狐鸣篝书"],"usage":"作宾语、定语；指起事","story":["秦朝末年，陈胜、吴广被抓去当兵，因大雨耽误了行程，只好起来造反。造反前陈胜请算命先生算了一卦，在白绸子写“陈胜王”塞入鱼腹，半夜在古庙用竹笼罩上篝火，学狐狸叫“陈胜王”，为起来造势，第二天就起义，建立张楚政权"]},{"id":31145,"word":"狐鸣篝火","pinyin":"hú míng gōu huǒ","abbr":"hmgh","explanation":"指起事者动员群众的措施。同“狐鸣鱼书”。","source":{"text":"军储潜遣五丁运，狐鸣篝火期相从。","book":"黄葆桢《扬哲商烈士悼歌》"},"similar":["狐鸣篝中","狐鸣鱼出"],"usage":"作宾语、定语；指起事","story":["秦朝末年，陈胜、吴广被抓去当兵，因大雨耽误了行程，只好起来造反。造反前陈胜请算命先生算了一卦，在白绸子写“陈胜王”塞入鱼腹，半夜在古庙用竹笼罩上篝火，学狐狸叫“陈胜王”，为起来造势，第二天就起义，建立张楚政权"]},{"id":31146,"word":"狐鸣鱼书","pinyin":"hú míng yú shū","abbr":"hmys","explanation":"指起事者动员群众的措施。","source":{"text":"乃丹书帛曰‘陈胜王’，置人所罾鱼腹中。卒买鱼烹食，得鱼腹中书，固以怪之矣。又閒令吴广之次所旁丛祠中，夜篝火，狐鸣呼曰‘大楚兴，陈胜王’。","book":"《史记·陈涉世家》"},"example":{"text":"如～之类，至诈为吉兆以动众。","book":"宋·罗大经《鹤林玉露》"},"similar":["狐鸣鱼出","狐鸣篝火","狐鸣篝中"],"usage":"作宾语、定语；指起事","story":["秦朝末年，陈胜、吴广被抓去当兵，因大雨耽误了行程，只好起来造反。造反前陈胜请算命先生算了一卦，在白绸子写“陈胜王”塞入鱼腹，半夜在古庙用竹笼罩上篝火，学狐狸叫“陈胜王”，为起义造势，第二天就起义，建立张楚政权"]},{"id":31147,"word":"狐鸣鱼出","pinyin":"hú míng yú chū","abbr":"hmyc","explanation":"鸣：叫。指动员众人起事。","source":{"text":"乃丹书帛曰：‘陈胜王’，置人所罾鱼腹中……夜篝火，狐鸣曰：‘大楚兴，陈胜王。’","book":"西汉·司马迁《史记·陈涉世家》"},"similar":["狐鸣鱼书","狐鸣篝火","狐鸣篝中"],"usage":"作宾语、定语；指起事","story":["秦朝末年，陈胜、吴广被抓去当兵，因大雨耽误了行程，只好起来造反。造反前陈胜请算命先生算了一卦，在白绸子写“陈胜王”塞入鱼腹，半夜在古庙用竹笼罩上篝火，学狐狸叫“陈胜王”，为起义造势，第二天就起义，建立张楚政权"]},{"id":31148,"word":"狐鼠之徒","pinyin":"hú shǔ zhī tú","abbr":"hszt","explanation":"比喻品质低下的人。","source":{"text":"朝廷之纪纲法律尚在，但可恨这班狐鼠之徒耳。","book":"清·褚人获《隋唐演义》第七十三回"},"usage":"作主语、宾语；用于坏人"},{"id":31149,"word":"狖轭鼯轩","pinyin":"yòu è wú xuān","abbr":"yewx","explanation":"形容极其灵巧的车马。","example":{"text":"就是乘～也赶不上了"},"usage":"作宾语、定语；用于书面语"},{"id":31150,"word":"狗仗人势","pinyin":"gǒu zhàng rén shì","abbr":"gzrs","explanation":"仗：倚仗、仗势。比喻坏人依靠某种势力欺侮人。","source":{"text":"（丑白）他怕怎的？（净白）他怕我狗仗人势。","book":"明·李开元《宝剑记》第五出"},"example":{"text":"你就～，天天作耗，在我们跟前逞脸。","book":"清·曹雪芹《红楼梦》第七十四回"},"similar":["狐假虎威","仗势欺人","狗傍人势"],"opposite":["童叟不欺"],"usage":"作谓语、定语、状语；指仗势欺人"},{"id":31151,"word":"狗仗官势","pinyin":"gǒu zhàng guān shì","abbr":"gzgs","explanation":"仗：倚仗、仗势。比喻倚仗官府势力欺压人。","source":{"text":"（丑白）他怕怎的？（净白）他怕我狗仗人势。","book":"明·李开元《宝剑记》第五出"},"example":{"text":"他们的实力，不过～。","book":"茅盾《子夜》七"},"similar":["狗仗人势"],"usage":"作谓语、定语、状语；指仗势欺人"},{"id":31152,"word":"狗偷鼠窃","pinyin":"gǒu tōu shǔ qiè","abbr":"gtsq","explanation":"像鼠狗那样的盗贼。比喻成不了气候的反叛者。同“狗盗鼠窃”。","source":{"text":"君之门下，无非狗偷鼠窃、无赖之人也。","book":"明·刘基《郁离子·千里马》"},"example":{"text":"今复遣数舟，～。","book":"明·郞瑛《七修类稿·国事二·方国珍始末略》"},"similar":["狗盗鼠窃"],"usage":"作宾语、定语；用于比喻句"},{"id":31153,"word":"狗傍人势","pinyin":"gǒu bàng rén shì","abbr":"gbrs","explanation":"比喻坏人依靠某种势力欺侮人。同“狗仗人势”。","source":{"text":"我把你这狗傍人势的奴才，我是服张天师管的，你那个老头儿，又不是道纪司，我怕他怎的。","book":"清·蒋士铨《一片石·访墓》"},"similar":["狗仗人势"],"usage":"作谓语、定语、状语；指仗势欺人"},{"id":31154,"word":"狗党狐朋","pinyin":"gǒu dǎng hú péng","abbr":"gdhp","explanation":"泛指一些吃喝玩乐、不务正业的朋友。同“狐朋狗党”。","source":{"text":"我是个诗坛酒社文章士，不比那狗党狐朋恶少年。","book":"元·乔吉《金钱记》第一折"},"similar":["狐朋狗党"],"usage":"作主语、宾语；指狐朋狗友"},{"id":31155,"word":"狗党狐群","pinyin":"gǒu dǎng hú qún","abbr":"gdhq","explanation":"比喻勾结在一起的坏人。同“狐群狗党”。","source":{"text":"差杀你狗党狐群，我怎肯丧志污红粉。","book":"明·元心子《金雀记·投崖》"},"example":{"text":"～招集易，呼朋引类便相亲。","book":"《醒世缘弹词》第四回"},"similar":["狐群狗党"],"usage":"作主语、宾语、定语；比喻勾结一气的人"},{"id":31156,"word":"狗口里吐不出象牙","pinyin":"gǒu kǒu lǐ tǔ bù chū xiàng yá","abbr":"gkltbcxy","explanation":"比喻坏人说不出好话。","source":{"text":"父亲和这等东西，有什么好话，讲出什么公理来，狗口里吐不出象牙。","book":"《元曲选·遇上皇》第一折"},"similar":["狗嘴里吐不出象牙"],"usage":"作宾语、分句；用于讥讽与开玩笑"},{"id":31157,"word":"狗口里生不出象牙","pinyin":"gǒu kǒu lǐ shēng bù chū xiàng yá","abbr":"gklsbcxy","explanation":"比喻坏人说不出好话。同“狗口里吐不出象牙”。","source":{"text":"还有些话，牵涉到老弟，咳，反正狗口不出象牙，不说也罢。","book":"茅盾《霜叶红似二月花续稿》第十五章"},"similar":["狗嘴里吐不出象牙"],"usage":"作宾语、分句；用于讥讽与开玩笑"},{"id":31158,"word":"狗吃屎","pinyin":"gǒu chī shǐ","abbr":"gcs","explanation":"身体向前仆倒在地。","source":{"text":"待要走时，早已被叔宝一脚飞起，一个狗吃屎，跌倒在门边。","book":"清·褚人获《隋唐演义》第33回"},"example":{"text":"清·李汝珍《镜花缘》第73回：“众蟾道：‘叫做～。’”"},"usage":"作宾语、定语；多用于比喻句"},{"id":31159,"word":"狗吠不惊","pinyin":"gǒu fèi bù jīng","abbr":"gfbj","explanation":"吠：狗叫声。狗偶尔的叫声不会引起惊慌。形容社会太平安定。","source":{"text":"（熙）迁魏郡太守，……视事二年，舆人歌之曰：‘我有枳棘，岑君伐之；有蟊贼，岑君遏之；狗吠不惊，足下生氂。’","book":"《后汉书·岑熙传》"},"usage":"作定语；用于社会局面"},{"id":31160,"word":"狗吠之惊","pinyin":"gǒu fèi zhī jīng","abbr":"gfzj","explanation":"吠：狗叫；惊：惊吓。比喻小的惊吓。","source":{"text":"今中国无狗吠之惊，而外累于远方之备。","book":"西汉·司马迁《史记·平津侯主父列传》"},"example":{"text":"你不至于被这～所吓倒吧。"},"similar":["狗吠之警"],"usage":"作宾语；比喻小的惊吓"},{"id":31161,"word":"狗吠之警","pinyin":"gǒu fèi zhī jǐng","abbr":"gfzj","explanation":"比喻轻微的惊动或扰乱。","source":{"text":"今方内无狗吠之警，而使陛下甲卒死亡，暴露中原。","book":"东汉·班固《汉书·严助传》"},"example":{"text":"我们得提高警惕，不能放过这～。"},"similar":["狗吠之惊"],"usage":"作宾语；比喻小的惊扰"},{"id":31162,"word":"狗吠非主","pinyin":"gǒu fèi fēi zhǔ","abbr":"gffz","explanation":"比喻臣子各忠于自己的君主。","source":{"text":"跖之狗吠尧，非贵跖而践尧也，狗固吠非其主也。","book":"西汉·刘向《战国策·齐策六》"},"example":{"text":"～，狼虎夜扰。惊我东西，不为家咎。","book":"汉·焦赣《易林·咸之泰》"},"similar":["吠非其主","各为其主"],"usage":"作宾语；比喻臣子各忠于自己的主人"},{"id":31163,"word":"狗咬吕洞宾","pinyin":"gǒu yǎo lǚ dòng bīn","abbr":"gyldb","explanation":"吕洞宾：传说中的八仙之一。狗见了吕洞宾这样做善事的好人也咬，用来骂人不识好歹。","source":{"text":"没良心的，狗咬吕洞宾，不识好人心。","book":"清·曹雪芹《红楼梦》第25回"},"example":{"text":"你这是～，把人家的好心当驴肝肺了。"},"similar":["不识好歹"],"usage":"作宾语、定语、分句；用来骂人不识好歹","story":["王夫人叫贾环抄《金刚咒》，贾环便来到王夫人炕上坐着，令人点了蜡烛，拿腔做势的抄写。丫鬟彩霞叫他安分抄写，贾环则咬定彩霞与宝玉好，对他不好。彩霞则骂他狗咬吕洞宾——不识好人心。这时宝玉、王熙凤进来，贾环只好偷偷地生闷气"]},{"id":31164,"word":"狗咬狗","pinyin":"gǒu yǎo gǒu","abbr":"gyg","explanation":"比喻坏人之间互相攻击。","example":{"text":"我们用了一计，他们就开始～了。"},"usage":"作宾语、定语；用于比喻句"},{"id":31165,"word":"狗嘴里吐不出象牙","pinyin":"gǒu zuǐ lǐ tǔ bù chū xiàng yá","abbr":"gzltbcxy","explanation":"比喻坏人嘴里说不出好话来。","source":{"text":"和这等东西，有什么好话，讲出什么公理来，狗口里吐不出象牙。","book":"元·高文秀《遇上皇》第一折"},"example":{"text":"我替你说出来：～。","book":"巴金《秋》五"},"similar":["狗口里吐不出象牙"],"usage":"作宾语、分句；用于讥讽与开玩笑"},{"id":31166,"word":"狗头军师","pinyin":"gǒu tóu jūn shī","abbr":"gtjs","explanation":"比喻爱给人出主意而主意又不高明的人。也比喻专门出坏主意的人。","source":{"text":"次日，又宣众鬼入朝，论功行赏；便封活死人为蓬头大将，地里鬼为狗头军师。","book":"清·张南庄《何典》第十回"},"example":{"text":"还不是他用～自作主张自讨好，敲锣放炮的硬出头！","book":"洪深《香稻米》第三幕"},"usage":"作主语、宾语；指背后出坏主意的人"},{"id":31167,"word":"狗头生角","pinyin":"gǒu tóu shēng jiǎo","abbr":"gtsj","explanation":"狗的头上长出犄角。比喻不可能出现的事情。","source":{"text":"俗以事不可期者曰俟狗头生角，而此事故尝有之，与期望意却无关也。","book":"清·翟灏《通俗编·兽畜》：“汉文帝二十三年，狗马及人皆生角。”按"}},{"id":31168,"word":"狗头鼠脑","pinyin":"gǒu tóu shǔ nǎo","abbr":"gtsn","explanation":"比喻奴才相。","source":{"text":"要说这林则徐，却不像那些狗头鼠脑的官员，要算我们中国的杰出人物。","book":"《黑籍冤魂》第六回"},"usage":"作宾语、定语；用于比喻句"},{"id":31169,"word":"狗尾续貂","pinyin":"gǒu wěi xù diāo","abbr":"gwxd","explanation":"续：连接。晋代皇帝的侍从官员用作帽子的装饰。指封官太滥。亦比喻拿不好的东西补接在好的东西后面，前后两部分非常不相称。","source":{"text":"奴卒厮役亦加以爵位。每朝会，貂蝉盈坐，时人为之谚曰：‘貂不足，狗尾续。’","book":"《晋书·赵王伦传》"},"example":{"text":"圣叹断定《水浒》只有七十回，而骂罗贯中为～。","book":"胡適《〈水浒传〉考证》四"},"similar":["佛头着粪"],"usage":"作主语、谓语、定语；用于书面语","story":["晋朝赵王司马伦狡猾、阴险、野心极大，勾结孙秀，密谋篡位。为了篡位成功，对属下及属下的家属也封官，当时官员上朝都要戴貂尾帽子，因官太多，貂尾不足，用狗尾代替。齐王冏等发兵讨伐司马伦，帮助惠帝司马衷复位"]},{"id":31170,"word":"狗尾貂续","pinyin":"gǒu wěi diāo xù","abbr":"gwdx","explanation":"比喻拿不好的东西补接在好的东西后面，前后两部分非常不相称。同“狗尾续貂”。","source":{"text":"尚有踊跃于前，懈弛于后，不得已而为狗尾貂续者亦有之。","book":"清·李渔《闲情偶寄·词曲·词采》"},"similar":["狗尾续貂","狗续貂尾"],"usage":"作宾语、定语；用于书面语"},{"id":31171,"word":"狗屁不值","pinyin":"gǒu pì bù zhí","abbr":"gpbz","explanation":"指毫无价值","source":{"text":"像此等脚，他便是真正三寸金莲，实连半个狗屁不值。","book":"清·李百川《绿野仙踪》第23回"},"similar":["一钱不值"],"usage":"作谓语、定语、宾语；用于口语"},{"id":31172,"word":"狗屁不通","pinyin":"gǒu pì bù tōng","abbr":"gpbt","explanation":"指责别人说话或文章极不通顺。","source":{"text":"柳老赖婚狼心推测，冯生联句狗屁不通。","book":"清·石玉昆《三侠五义》第35回"},"example":{"text":"你的文章尽管～，有人争先恐后的请你做广告。","book":"邹韬奋《无所不专的专家》"},"similar":["猫屁不通"],"usage":"作谓语、宾语、定语；用于文章或说话"},{"id":31173,"word":"狗彘不如","pinyin":"gǒu zhì bù rú","abbr":"gzbr","explanation":"彘：猪。形容品行卑劣到连猪狗都不如的程度。同“狗彘不若”。","source":{"text":"君有难，臣当不顾其身而救之，岂言退耶！直狗彘不如也！","book":"清·吴璿《飞龙全传》第四十八回"},"example":{"text":"你这～的万恶败类，你在千秋的青史上是要永远受着万代的唾骂的呵！","book":"郭沫若《南冠草》第五幕"},"similar":["狗彘不若"],"usage":"作谓语、定语；指人的品性"},{"id":31174,"word":"狗彘不若","pinyin":"gǒu zhì bù ruò","abbr":"gzbr","explanation":"彘：猪。连猪狗都不如。形容品行卑劣到连猪狗都不如的程度。","source":{"text":"人也，忧忘其身，内忘其亲，上忘其君，则是人也，而曾狗彘之不若也。","book":"《荀子·荣辱》"},"example":{"text":"你这～的万恶败类。","book":"郭沫若《南冠草》第五幕"},"similar":["狗苟蝇营","寡廉鲜耻"],"usage":"作谓语、定语；指人的品性"},{"id":31175,"word":"狗彘不食","pinyin":"gǒu zhì bù shí","abbr":"gzbs","explanation":"连狗猪都不吃他的肉。形容其人的品行极端恶劣。","source":{"text":"受人孤寄，乘便利时，夺取其国，不复顾恩义。人如此者，狗猪不食其余。","book":"东汉·班固《汉书·元后传》"},"example":{"text":"汪精卫、陈璧君则作了～、遗臭万年的无耻汉奸。","book":"吴玉章《从甲午战争前后到了辛亥革命前后的回忆》"},"similar":["狗猪不食其余"],"usage":"作谓语、定语；指人的品行"},{"id":31176,"word":"狗彘不食其余","pinyin":"gǒu zhì bù shí qí yú","abbr":"gzbsqy","explanation":"狗猪都不吃他剩下的东西。形容人极其卑鄙龌龊。","source":{"text":"既无以报，受人孤寄，乘便利时，夺取其国，不复顾恩义，人如此者，狗猪不食其余，天下岂有而兄弟邪！","book":"《汉书·元后传》"},"example":{"text":"士大夫为官爵所钓，用心至是，可谓～。","book":"宋·王明清《玉照新志》第五卷"},"similar":["狗猪不食其余"],"usage":"作宾语、定语、分句；指人品坏"},{"id":31177,"word":"狗彘不食汝余","pinyin":"gǒu zhì bù shí rǔ yú","abbr":"gzbsry","explanation":"食：吃。狗猪都不吃他剩下的东西。形容人的品行极其卑鄙龌龊。","source":{"text":"汝为大将，不能杀贼，反为贼用，狗彘不食汝余。","book":"《明史·李任传》"},"similar":["狗鼠不食汝余","狗彘不食"],"usage":"作宾语、定语、分句；指人品坏"},{"id":31178,"word":"狗彘之行","pinyin":"gǒu zhì zhī xíng","abbr":"gzzx","explanation":"狗彘：猪狗。形容无耻之人的行为如猪狗一样。","source":{"text":"姐姐，你道妹子果然为此狗彘之行么？将机就机，前去报仇雪怨，岂是真心改嫁耶？","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"example":{"text":"明·郭勋《英烈传》第20回：“你受吴王大恩，不思图报，敌兵一至，便要投降，乃是～！”"},"usage":"作宾语；用于骂人"},{"id":31179,"word":"狗心狗行","pinyin":"gǒu xīn gǒu xíng","abbr":"gxgx","explanation":"比喻歹毒的心肠、行为。","source":{"text":"元·无名氏《杀狗劝夫》第三折：“这等人玩的是狗气狗声，这等人使的是狗心狗行。"},"usage":"作定语、宾语；用于比喻句"},{"id":31180,"word":"狗急跳墙","pinyin":"gǒu jí tiào qiáng","abbr":"gjtq","explanation":"狗急了也能跳过墙去。比喻坏人在走投无路时豁出去，不顾一切地捣乱。","source":{"text":"人急烧香，狗急蓦墙。","book":"《敦煌变文集·燕子赋》"},"example":{"text":"今儿我听了他的短儿，“人急造反，～”，不但生事，而且我还没趣。","book":"清·曹雪芹《红楼梦》第二十二回"},"similar":["困兽犹斗","孤注一掷","铤而走险"],"usage":"作谓语、定语；指走投无路的时候"},{"id":31181,"word":"狗恶酒酸","pinyin":"gǒu è jiǔ suān","abbr":"gejs","explanation":"比喻环境险恶，使人裹足不前。","source":{"text":"人有市酒而甚美者，置表甚长，然至酒酸而不售。问里人其故？里人曰：‘公之狗甚猛，而人有持器而欲往者，狗辄迎而吠之，是以酒酸不售也。’","book":"汉·韩婴《韩诗外传》第七卷"},"example":{"text":"我们要时刻检查自己，避免出现“～”的局面。"},"similar":["狗猛酒酸"],"usage":"作定语；指环境恶劣造成生意萧条","story":["春秋时期，一个宋国酿酒人非常注意自己的信誉，店越开越大，酒越酿越好，他养一条狗看店。可是渐渐地酒卖不动了，越积越多，逐渐变酸。他问杨倩到底为什么？杨倩说：“你家的狗太凶猛了，别人害怕你的狗而不敢来买酒。”"]},{"id":31182,"word":"狗拿耗子","pinyin":"gǒu ná hào zǐ","abbr":"gnhz","explanation":"（歇后语）多管闲事。狗的职责是看守门户，猫是专捉老鼠的，所以狗替猫捉老鼠，就是多管闲事。","source":{"text":"你这孩子，才叫他娘的‘狗拿耗子’呢！你又懂得几篇儿几篇儿。","book":"清·文康《儿女英雄传》第34回"},"example":{"text":"你这是～——多管闲事。"},"similar":["狗逮老鼠"],"opposite":["安分守己"],"usage":"作宾语、定语；指多管闲事"},{"id":31183,"word":"狗捉老鼠","pinyin":"gǒu zhuō lǎo shǔ","abbr":"gzls","explanation":"比喻做外行事或多管闲事。","source":{"text":"叫我看来是狗捉老鼠，多管闲事。","book":"赵树理《传家宝》"},"similar":["狗拿耗子"],"usage":"作宾语、定语；指多管闲事"},{"id":31184,"word":"狗猛酒酸","pinyin":"gǒu měng jiǔ suān","abbr":"gmjs","explanation":"因狗凶猛致使酒酸无人买。比喻环境恶劣，前进困难。也比喻权臣当道，阻塞贤路。","source":{"text":"人有市酒而甚美者，置表甚长，然至酒酸而不售。问里人其故？里人曰：‘公之狗甚猛，而人有持器而欲往者，狗辄迎而吠之，是以酒酸不售也。’","book":"汉·韩婴《韩诗外传》第七卷"},"example":{"text":"我们要从～的典故中吸取教训。"},"similar":["狗恶酒酸"],"usage":"作定语；指环境恶劣造成生意萧条","story":["春秋时期，一个宋国酿酒人非常注意自己的信誉，店越开越大，酒越酿越好，他养一条狗看店。可是渐渐地酒卖不动了，越积越多，逐渐变酸。他问杨倩到底为什么？杨倩说：“你家的狗太凶猛了，别人害怕你的狗而不敢来买酒。”"]},{"id":31185,"word":"狗猪不食其余","pinyin":"gǒu zhū bù shí qí yú","abbr":"gzbsqy","explanation":"食：吃。狗猪都不吃他剩下的东西。形容人的品行极其卑鄙龌龊。","source":{"text":"受人孤寄，乘便利时，夺取其国，不复顾恩义。人如此者，狗猪不食其余。","book":"东汉·班固《汉书·元后传》"},"example":{"text":"他的品性很坏，真是～。"},"similar":["狗彘不食","狗鼠不食汝余"],"usage":"作宾语、定语、分句；指人品坏"},{"id":31186,"word":"狗皮膏药","pinyin":"gǒu pí gāo yào","abbr":"gpgy","explanation":"中医用狗皮膏药消肿止痛。比喻骗人的货色。","source":{"text":"再往下说，那就是信口开河，不如到庙会上卖狗皮膏药去！","book":"刘复《自序》"},"example":{"text":"你经常在电视上～，让人可笑。"},"usage":"作宾语、定语；指骗人的货色"},{"id":31187,"word":"狗盗鸡啼","pinyin":"gǒu dào jī tí","abbr":"gdjt","explanation":"比喻具有微末技能。同“狗盗鸡鸣”。","source":{"text":"函关脱离，又何须狗盗鸡啼？","book":"明·陆采《明珠记·江会》"},"similar":["狗盗鸡鸣","鸡鸣狗盗"],"usage":"作主语、宾语、定语；指小本事"},{"id":31188,"word":"狗盗鸡鸣","pinyin":"gǒu dào jī míng","abbr":"gdjm","explanation":"①比喻具有微末技能。②比喻偷偷摸摸。","source":{"text":"狗盗鸡鸣皆有用，鹤长凫短果如何？","book":"金·元好问《示怀祖》诗"},"example":{"text":"报仇的这桩事，是桩光明磊落、见得天地鬼神的事，何须这等～、遮遮掩掩。","book":"《儿女英雄传》第十七回"},"similar":["鸡鸣狗盗"],"opposite":["光明磊落"],"usage":"作主语、宾语、定语；指小本事"},{"id":31189,"word":"狗盗鼠窃","pinyin":"gǒu dào shǔ qiè","abbr":"gdsq","explanation":"像鼠狗那样的盗贼。比喻成不了气候的反叛者。","source":{"text":"今明主在于上，法令具于下，安得有反贼乎？此真狗盗鼠窃耳！","book":"汉·荀悦《汉纪·惠帝纪》"},"example":{"text":"《周书·萧詧传》：“加以～，蜂虿狐狸。群圉隶而为寇，聚臧获而成师。”"},"similar":["狗偷鼠窃"],"usage":"作宾语、定语；用于比喻句"},{"id":31190,"word":"狗眼看人","pinyin":"gǒu yǎn kàn rén","abbr":"gykr","explanation":"比喻眼光势力。","example":{"text":"你这是～。"},"similar":["狗眼看人低"],"opposite":["一视同仁"],"usage":"作宾语、定语；指人势利眼"},{"id":31191,"word":"狗眼看人低","pinyin":"gǒu yǎn kàn rén dī","abbr":"gykrd","explanation":"看人低：把人看低了。比喻看人眼光势力。","example":{"text":"真是～，有什么了不起的。"},"similar":["狗眼看人"],"usage":"作宾语、定语；指人势利眼"},{"id":31192,"word":"狗窦大开","pinyin":"gǒu dòu dà kāi","abbr":"gddk","explanation":"窦：洞。狗洞大开。用以嘲笑人缺少牙齿。","source":{"text":"张吴兴年八岁，亏齿。……戏之曰：‘君口中何为开狗窦？’张应声答曰：‘正使君辈从此中出入。’","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"笑人齿缺曰～。","book":"清·程允升《幼学琼林·身体》"},"usage":"作宾语、定语；用于比喻句","story":["晋朝时期，张玄字吴兴，八岁时牙齿缺落，有人与他开玩笑说，你这里怎么开了狗窦？张玄毫不迟疑地回答说：“正使君辈从此中出入。”弄得在场的人哄堂大笑"]},{"id":31193,"word":"狗续侯冠","pinyin":"gǒu xù hòu guàn","abbr":"gxhg","explanation":"犹狗续金貂。比喻滥封的官吏。","source":{"text":"琶歌宫布，为后不若为娼；狗续侯冠，畏首还当畏尾。","book":"清·感惺《断头台·党争》"},"similar":["狗续金貂","狗续貂尾","狗尾续貂"],"usage":"作宾语、定语；用于书面语"},{"id":31194,"word":"狗续貂尾","pinyin":"gǒu xù diāo wěi","abbr":"gxdw","explanation":"指封官太滥。亦比喻拿不好的东西补接在好的东西后面，前后两部分非常不相称。同“狗尾续貂”。","source":{"text":"杀人献媚，情甘狗续貂尾。","book":"清·嬴宗季女《六月霜·张罗》"},"similar":["狗尾续貂","狗尾貂续","狗续金貂"],"usage":"作宾语、定语；用于书面语"},{"id":31195,"word":"狗续金貂","pinyin":"gǒu xù jīn diāo","abbr":"gxjd","explanation":"比喻滥封的官吏。","source":{"text":"嗟满座狗续金貂，则索要清海宇谁把狼烟扫？","book":"清·筱波山人《爱国魂·勤王》"},"similar":["狗续貂尾","狗尾续貂","狗续侯冠"],"usage":"作宾语、定语；用于书面语"},{"id":31196,"word":"狗肉上不了筵席","pinyin":"gǒu ròu shàng bù le yán xí","abbr":"grsblyx","explanation":"比喻素质太差，不能扶持上去。","source":{"text":"说她‘狗肉上不了筵席’，让丈夫一人来参加就行了。","book":"路遥《平凡的世界》第二卷第40章"},"similar":["狗肉上不得台盘"],"usage":"作宾语、定语；用于口语"},{"id":31197,"word":"狗肺狼心","pinyin":"gǒu fèi láng xīn","abbr":"gflx","explanation":"形容心肠象狼和狗一样凶恶狠毒。同“狼心狗肺”。","source":{"text":"谋财害命拐女人，狗肺狼心！","book":"昆曲《十五贯》第二场"},"example":{"text":"只为一班卖国格中国人，生成狗肺搭狼心，日日夜夜吃穷人，吃得来头错眼暗发热乎。","book":"瞿秋白《东洋人出兵》之一"},"similar":["狼心狗肺"],"usage":"作谓语、定语、宾语；指人的心肠坏"},{"id":31198,"word":"狗胆包天","pinyin":"gǒu dǎn bāo tiān","abbr":"gdbt","explanation":"狗胆：指坏人的胆子；包天：包住天，形容特大。形容坏人的行为无所顾忌，为所欲为。","source":{"text":"荔枝儿冷冷一笑，咯咯咬得银牙响，着恼说道：‘哪个充你小姐？青天白日，你们狗胆包天，胆敢抢夺民女，不怕朝廷三尺王法？’","book":"郭戈《金瓶梅传奇》第九回"},"example":{"text":"你真是～，竟敢捉弄起我们来了！","book":"《解放日报》1981.5.12"},"similar":["胆大包天"],"opposite":["胆小怕事"],"usage":"作谓语、定语；用于骂人"},{"id":31199,"word":"狗腿子","pinyin":"gǒu tuǐ zǐ","abbr":"gtz","explanation":"走狗，为恶势力效劳帮凶的人。","source":{"text":"有些被杀的所谓狗腿子，十有八九是穷人。","book":"邓小平《跃进中原的胜利形势与今后的政策策略》"},"usage":"作主语、宾语、定语；用于坏人"},{"id":31200,"word":"狗苟蝇营","pinyin":"gǒu gǒu yíng yíng","abbr":"ggyy","explanation":"苟：苟且偷生；营：谋求。比喻为了名利不择手段，象苍蝇一样飞来飞去，象狗一样不知羞耻。","source":{"text":"蝇营狗苟，驱去复返。","book":"唐·韩愈《送穷文》"},"example":{"text":"到底～，依然逃不了圣明烛照，这不是一件极可喜的事吗？（清·曾朴《孽海花》第二十一回）"},"similar":["苟且偷生"],"usage":"作谓语、状语；比喻不顾廉耻"},{"id":31201,"word":"狗血喷头","pinyin":"gǒu xuè pēn tóu","abbr":"gxpt","explanation":"把狗血喷在头上。形容言辞刻毒，大肆辱骂。也形容骂得痛快淋漓。","source":{"text":"一清早晨，吃他骂的狗血喷了头。","book":"明·兰陵笑笑生《金瓶梅词话》第六十四回"},"example":{"text":"范进因没有盘费，走去同丈人商议，被胡屠夫一口啐在脸上，骂了一个～。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["狗血淋头"],"usage":"作宾语、状语；指骂人"},{"id":31202,"word":"狗血淋头","pinyin":"gǒu xuè lín tóu","abbr":"gxlt","explanation":"旧时迷信说法，谓狗血淋在妖人头上，就可使其妖法失灵。后形容骂得很凶，使被骂者如淋了狗血的妖人一样，无言以对，无计可施。","source":{"text":"马知府道：‘必然是个妖人！’教去取些法物来。牢子、节级将李逵捆翻，驱下厅前草地里，一个虞候掇一盆狗血没头一淋。","book":"明·施耐庵《水浒全传》第五十三回"},"example":{"text":"在联合国会议上，在板门店谈判中，被骂得～，一句踊也无法回。","book":"谢常见哉《放毒犯》"},"similar":["狗血喷头"],"usage":"作宾语、状语、补语；指骂人"},{"id":31203,"word":"狗行狼心","pinyin":"gǒu xíng láng xīn","abbr":"gxlx","explanation":"比喻行为凶狠，心肠毒辣。","source":{"text":"恨冯魁，趋恩夺爱，狗行狼心，全然不怕天折挫。","book":"元·白朴《恼煞人》套曲"},"example":{"text":"为你两头白面搬兴废，转背言词说是非。这厮敢狗行狼心，～。","book":"元康进之《李魁负荆》第二折"},"usage":"作宾语、定语；用于比喻句"},{"id":31204,"word":"狗走狐淫","pinyin":"gǒu zǒu hú yín","abbr":"gzhy","explanation":"比喻卑劣淫乱。"},{"id":31205,"word":"狗追耗子","pinyin":"gǒu zhuī hào zǐ","abbr":"gzhz","explanation":"比喻做外行事或多管闲事。同“狗拿耗子”。","source":{"text":"你狗追耗子，管啥闲事？","book":"周立波《暴风雨》第一部九"},"similar":["狗拿耗子","狗逮老鼠","狗捉老鼠"],"usage":"作宾语、定语；指多管闲事"},{"id":31206,"word":"狗逮老鼠","pinyin":"gǒu dǎi lǎo shǔ","abbr":"gdls","explanation":"比喻做外行事或多管闲事。同“狗拿耗子”。","source":{"text":"你狗逮老鼠多管那闲事做啥？","book":"柳青《狠透铁》五"},"similar":["狗捉老鼠","狗拿耗子","狗追耗子"],"usage":"作宾语、定语；指多管闲事"},{"id":31207,"word":"狗颠屁股","pinyin":"gǒu diān pì gu","abbr":"gdpg","explanation":"狗在主人面前摇尾乞怜。形容对人逢迎献媚的丑态。","source":{"text":"春燕说荤的不好，另叫你炒个面筯儿，少搁油才好，你忙着就说自己发昏，赶着洗手炒了，狗颠屁股儿似的，亲自捧了去。","book":"《红楼梦》第六一回"},"example":{"text":"好容易俺家里出了一个好孩子，你们不～的献些殷勤，反倒作践起来。","book":"清·吴趼人《瞎骗奇闻》卷四"},"usage":"作宾语、定语；用于比喻句"},{"id":31208,"word":"狗马之心","pinyin":"gǒu mǎ zhī xīn","abbr":"gmzx","explanation":"像犬马一样对主人忠心。","source":{"text":"臣常有狗马之心。","book":"东汉·班固《汉书·汲黯传》"},"similar":["犬马之心"],"usage":"作宾语、主语；用于自谦"},{"id":31209,"word":"狗马声色","pinyin":"gǒu mǎ shēng sè","abbr":"gmss","explanation":"良犬、骏马、音乐、女色。泛指养狗、骑马、听歌、狎妓等剥削阶级行乐的方式。借指穷奢极侈的享乐。","source":{"text":"谓虽极天下之贵，而退朝燕息，从容娱乐者，独在于是，狗马声色技巧之奉，不皇及也。","book":"宋·张孝祥《宣州新建御书阁记》"},"example":{"text":"为君者日不闻其过，亦自以为四方平治，圣哲若古，而～之欲因以中其心志矣。","book":"清·王韬《臆谭·求言》"},"similar":["声色狗马"],"usage":"作主语、宾语、定语；指低级生活方式"},{"id":31210,"word":"狗鼠不食汝余","pinyin":"gǒu shǔ bù shí rǔ yú","abbr":"gsbsry","explanation":"食：吃。狗猪都不吃他剩下的东西。形容人的品行极其卑鄙龌龊。","source":{"text":"因不复前而叹曰：‘狗鼠不食汝余，死故应尔。’至山陵，亦竟不临。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"similar":["狗猪不食其余","狗彘不食汝余"],"usage":"作宾语、定语、分句；指人品坏","story":["魏武帝驾崩，其子文帝继位，他把武帝的宫人拉在后宫自用，整日荒淫无度。文帝因此得病，卞太后来探望，看见武帝的妃子都在侍侯文帝，觉得有违伦常，骂文帝是“狗鼠不食汝余，死故应尔”。不久，文帝病故，卞太后竟没去送葬"]},{"id":31211,"word":"狞髯张目","pinyin":"níng rán zhāng mù","abbr":"nrzm","explanation":"犹言吹胡瞪眼。形容暴怒。","source":{"text":"曾贼知军门自至，突出欲擒之，狞髯张目，勇气百倍，直呼军门名。","book":"清·王韬《瓮牖馀谈·贼中悍酋记》"},"usage":"作谓语、定语；指人发怒的样子"},{"id":31212,"word":"狠心辣手","pinyin":"hěn xīn là shǒu","abbr":"hxls","explanation":"残忍的心肠，毒辣的手段。","source":{"text":"那小娘子听了，欲待不信，又见十五贯钱堆在面前；欲待信来，他平白与我没半句言语，大娘子又过得好，怎么便下得这等狠心辣手。","book":"明·冯梦龙《醒世恒言》第三十三卷"},"example":{"text":"诡行颇僻之刘宗周，～之黄某，意指此一事也。","book":"清·黄宗羲《南雷文集·辨野史》"},"similar":["心狠手辣"],"usage":"作谓语、宾语、定语；指人的心肠狠毒"},{"id":31213,"word":"狠愎自用","pinyin":"hěn bì zì yòng","abbr":"hbzy","explanation":"愎：执拗，倔强。凶狠倔强，独断专行。","source":{"text":"璁狠愎自用，执拗多私。","book":"《明史·陆粲传》"},"similar":["刚愎自用"],"usage":"作谓语、定语；指人独断专行"},{"id":31214,"word":"狡兔三穴","pinyin":"jiǎo tù sān xué","abbr":"jtsx","explanation":"比喻隐蔽的地方或方法多。同“狡兔三窟”。","source":{"text":"乃是狡兔三穴，自为潜身之计。","book":"《宋史·河渠志》"},"similar":["狡兔三窟"],"usage":"作谓语、宾语、定语；指人狡猾"},{"id":31215,"word":"狡兔三窟","pinyin":"jiǎo tù sān kū","abbr":"jtsk","explanation":"窟：洞穴。狡猾的兔子准备好几个藏身的窝。比喻隐蔽的地方或方法多。","source":{"text":"狡兔有三窟，仅得兔其死耳。","book":"《战国策·齐策四》"},"example":{"text":"见柴曰：“汝～，何归为？”","book":"清·蒲松龄《聊斋志异·邵九娘》"},"similar":["移花接木","掩人耳目"],"opposite":["瓮中之鳖","坐以待毙"],"usage":"作谓语、宾语、定语；指人狡猾","story":["战国时期，齐国相国孟尝君叫门客冯驩去薛地收债并顺便买回家里缺的东西，冯驩假借孟尝君的命令把债契全部烧毁，借债的百姓对孟尝君感激涕零。冯驩回来说：“狡兔有三窟，仅得免其死耳；今君有一窟，未得高枕而卧也。”"]},{"id":31216,"word":"狡兔死，良犬烹","pinyin":"jiǎo tù sǐ，liáng quǎn pēng","abbr":"jtslqp","explanation":"比喻给统治者效劳的人事成后被抛弃或杀掉。同“狡兔死，良狗烹”。","source":{"text":"吾闻‘狡兔死而良犬烹’。敌国如灭，谋臣必亡。","book":"《东周列国志》第八三回"},"similar":["狡兔死，良狗烹","获兔烹狗"],"usage":"作宾语、定语；用于处事"},{"id":31217,"word":"狡兔死，良狗烹","pinyin":"jiǎo tù sǐ，liáng gǒu pēng","abbr":"jtslgp","explanation":"烹：烧煮。兔子死了，猎狗就被人烹食。比喻给统治者效劳的人事成后被抛弃或杀掉。","source":{"text":"狡兔尽则良犬烹，敌国灭则谋臣亡。","book":"战国·韩·韩非《韩非子·内储说下》"},"example":{"text":"飞鸟尽，良弓藏；～。","book":"西汉·司马迁《史记·淮阴侯列传》"},"similar":["兔死狗烹","获兔烹狗"],"usage":"作宾语、定语、分句；指过河拆桥","story":["春秋末期，楚国的范蠡和文种到越国去做官，辅佐被吴王夫差打败的勾践，他们发奋图强，终于使越国强大，最后灭了吴国。范蠡深知勾践的为人就到齐国隐姓埋名经商，他写信劝文种离开说：“狡兔死，走狗烹”。文种不信后被勾践所杀"]},{"id":31218,"word":"狡焉思启","pinyin":"jiǎo yān sī qǐ","abbr":"jysq","explanation":"指怀贪诈之心图谋侵人之国。","source":{"text":"夫狡焉思启封疆以利社稷者，何国蔑有？","book":"《左传·成公八年》"},"similar":["狡焉思逞","狡焉思肆"],"usage":"作谓语、定语；用于书面语"},{"id":31219,"word":"狡焉思肆","pinyin":"jiǎo yān sī sì","abbr":"jyss","explanation":"指怀贪诈之心图谋侵人之国。同“狡焉思启”。","source":{"text":"蠢尔戎狄，狡焉思肆。","book":"晋·潘岳《关中诗》"},"similar":["狡焉思逞","狡焉思启"],"usage":"作谓语、定语；用于书面语"},{"id":31220,"word":"狡焉思逞","pinyin":"jiǎo yān sī chěng","abbr":"jysc","explanation":"指怀贪诈之心图谋侵人之国。同“狡焉思启”。","source":{"text":"诸夷以中国之易欺也，法人将问滇桂，英人将问藏粤，俄人将问新疆，德、奥、意、日、葡、荷皆狡焉思逞。","book":"康有为《上清帝第二书》"},"example":{"text":"中国之在天下，见夫四夷之则效上国，革面来宾者有之；或野心怒发，～者有之。","book":"鲁迅《坟·文化偏至论》"},"similar":["狡焉思启","狡焉思肆"],"usage":"作谓语、定语；用于书面语"},{"id":31221,"word":"狧穅及米","pinyin":"shì kǎn jí mǐ","abbr":"skjm","explanation":"比喻逐步侵蚀渐及全体。"},{"id":31222,"word":"狧糠及米","pinyin":"tà kāng jí mǐ","abbr":"tkjm","explanation":"狧：用舌头舔东西。舔米外的糠，一直舔到里面的米。比喻占据的地方再夺取政权。也比喻由表及里，逐步进逼。","source":{"text":"语有之曰：‘狧糠及米。’吴与胶西，知名诸侯也，一时见察，不得安肆矣。","book":"《汉书·吴王濞传》"},"example":{"text":"清·谭嗣同《报贝元征书》：“苟得我之海口海岸，所谓～，而内地内江又化为海口海岸之形矣。”"},"similar":["舐糠及米"],"usage":"作谓语、宾语；多用于比喻句"},{"id":31223,"word":"狩岳巡方","pinyin":"shòu yuè xún fāng","abbr":"syxf","explanation":"指帝王巡狩方岳。","source":{"text":"观风省俗，哲后弘规；狩岳巡方，明王盛轨。","book":"《梁书·武帝纪中》"},"usage":"作谓语；指帝王视察四方诸侯"},{"id":31224,"word":"独一无二","pinyin":"dú yī wú èr","abbr":"dywe","explanation":"没有相同的或没有可以相比的。","source":{"text":"独一无二，即真解脱。","book":"宋·延寿辑《宗镜录》卷三十一"},"example":{"text":"赢了钱，便大把的赏人；输了钱，无论上千上万，从不兴皱眉头：真要算得～的好赌品了。","book":"清·李宝嘉《官场现形记》第二十一回"},"similar":["盖世无双","绝无仅有","无与伦比"],"opposite":["平淡无奇","不足为奇","屡见不鲜"],"usage":"作谓语、定语；指唯一"},{"id":31225,"word":"独具一格","pinyin":"dú jù yī gé","abbr":"djyg","explanation":"单独有一种特别的风格、格调。","example":{"text":"我们的风格～。"},"similar":["别具一格"],"opposite":["千篇一律"],"usage":"作谓语、定语；同“别具一格”"},{"id":31226,"word":"独具匠心","pinyin":"dú jù jiàng xīn","abbr":"djjx","explanation":"匠心：巧妙的心思。具有独到的灵巧的心思。指在技巧和艺术方面的创造性。","source":{"text":"诗味的浓淡，与比兴之运用关系非常密切。李贺的诗歌在这方面是独具匠心的。","book":"《诗刊》1978年第3期"},"example":{"text":"他的这种设计真是独具匠心。"},"similar":["匠心独运","独树一帜","别开生面"],"opposite":["千篇一律","如出一辙","鹦鹉学舌"],"usage":"作谓语、定语；指独到的构思"},{"id":31227,"word":"独具只眼","pinyin":"dú jù zhī yǎn","abbr":"djzy","explanation":"具有独到的眼光和见解。形容眼光敏锐，能看到别人不易发现的事物。","source":{"text":"近来别具一只眼，要踏唐人最上关。","book":"宋·杨万里《送彭元忠县丞北归》诗"},"example":{"text":"这篇大文，除用戚施先生的话，赞为“～”之外，是不能有第二句的。","book":"鲁迅《准风月谈·后记》"},"similar":["见微知著","明察秋毫"],"opposite":["一无所长","愚昧无知"],"usage":"作谓语、定语、宾语；形容眼光敏锐"},{"id":31228,"word":"独具慧眼","pinyin":"dú jù huì yǎn","abbr":"djhy","explanation":"能看到别人看不到的东西，形容眼光敏锐，见解高超，能作出精细判断。","example":{"text":"她在此问题上～。"},"similar":["别具慧眼"],"usage":"作谓语、定语；指独特的眼光"},{"id":31229,"word":"独出一时","pinyin":"dú chū yī shí","abbr":"dcys","explanation":"超群出众，一代无二。","example":{"text":"她的才能～。"},"similar":["超群出众","盖世无双"],"opposite":["比比皆是"],"usage":"作谓语、定语；指超群出众"},{"id":31230,"word":"独出己见","pinyin":"dú chū jǐ jiàn","abbr":"dcjj","explanation":"见：见解、主张。与别人不同地提出自己的见解和主张。","source":{"text":"且说黑妖狐智化与小诸葛沈仲元二人暗地商议，独出己见，要去王府盗取盟单。","book":"清·无名氏《续小五义》第一回"},"example":{"text":"他～，满座皆惊。"},"similar":["独得之见"],"opposite":["人云亦云"],"usage":"作谓语；指独到的见解"},{"id":31231,"word":"独出心裁","pinyin":"dú chū xīn cái","abbr":"dcxc","explanation":"原指诗文的构思有独到的地方。后泛指想出的办法与众不同。","source":{"text":"今别出心裁，不依旧样，或特标于目外，或叠采于回中。","book":"明·李贽《水浒全书发凡》"},"example":{"text":"王弼注释《周易》，撇了象占旧解，～，畅言义理，于是天下后世，凡言《易》言，莫不宗之。","book":"清·李汝珍《镜花缘》第十八回"},"similar":["别出心裁","独具匠心","独辟蹊径"],"opposite":["千篇一律","如出一辙","步人后尘"],"usage":"作谓语、定语、状语；指与众不同"},{"id":31232,"word":"独出新裁","pinyin":"dú chū xīn cái","abbr":"dcxc","explanation":"原指诗文的构思有独到的地方。后泛指构思、设计或心中的想法独具一格，与众不同","source":{"text":"松江提督张云翼以公侯世职，而《严滩》一首，独出新裁。","book":"清·袁枚《随园诗话补遗》第12卷"},"similar":["独出心裁"],"opposite":["步人后尘"],"usage":"作谓语、定语、状语；指与众不"},{"id":31233,"word":"独出机杼","pinyin":"dú chū jī zhù","abbr":"dcjz","explanation":"独：独特，特别；机杼：织布机和织布梭，引申为织布方法。比喻文章的命题和构思独特新颖，与众不同。","source":{"text":"作文须自出机杼，或一家风骨，何能共人同生活也。","book":"《北史·祖莹传》"}},{"id":31234,"word":"独到之处","pinyin":"dú dào zhī chù","abbr":"ddzc","explanation":"指与众不同的特殊的地方或见解。含褒意。","source":{"text":"往往独到之处，能以中锋达意，以中声赴节。","book":"清·况周颐《蕙风词话》第二卷"},"example":{"text":"他的论文有他的～，是别人始料不及的。"},"similar":["与众不同"],"usage":"作宾语；用于观点等"},{"id":31235,"word":"独力难撑","pinyin":"dú lì nán chēng","abbr":"dlnc","explanation":"独：单独。指个人力量单薄不能维持全局。","example":{"text":"我一个人～，快来帮我吧。"}},{"id":31236,"word":"独力难支","pinyin":"dú lì nán zhī","abbr":"dlnz","explanation":"独：单独。指个人力量单薄不能维持全局","source":{"text":"那吕珍探知援兵已散，思量独力难支，便开门冲阵逃走。","book":"明·郭勋《英烈传》第23回"},"example":{"text":"清·贪梦道人《彭公案》第45回：“张耀宗一人～，只累得气喘吁吁，遍身是汗。”"},"similar":["独木难支"],"usage":"作谓语、定语、宾语；指个人的力量单薄"},{"id":31237,"word":"独占鳌头","pinyin":"dú zhàn áo tóu","abbr":"dzat","explanation":"鳌头：宫殿门前台阶上的鳌鱼浮雕，科举进士发榜时状元站此迎榜。科举时代指点状元。比喻占首位或第一名。","source":{"text":"殿前曾献升平策，独占鳌头第一名。","book":"元·无名氏《陈州粜米》楔子"},"example":{"text":"一战胜群贤，～高选。","book":"明·谢谠《四喜记·乡荐荣欢》"},"similar":["超群绝伦","鹤立鸡群","独一无二"],"opposite":["名落孙山"],"usage":"作谓语、定语；指第一名","story":["宋朝时期，包公奏请宋仁宗加试恩科，湖广武昌府江夏县南安善村的范仲禹得知消息后暗自叹息，同乡得知他的才华，一定会独占鳌头、金榜题名的。刘洪义资助他100两白银与一头黑驴上京。范仲禹果然不出众望得中状元"]},{"id":31238,"word":"独吃自疴","pinyin":"dú chī zì kē","abbr":"dczk","explanation":"疴：即“屙”，拉屎撒尿。比喻顾己不顾人，一人独吞。","example":{"text":"他做事总喜欢一个人～，不让别人沾边。"},"usage":"作谓语、宾语、定语；用于处世"},{"id":31239,"word":"独善一身","pinyin":"dú shàn yī shēn","abbr":"dsys","explanation":"指只顾自己，不管别人。同“独善其身”。","source":{"text":"丈夫贵兼济，岂独善一身？","book":"唐·白居易《新制布裘》诗"},"example":{"text":"吾欲力绍绝业，锓木宣布有可成之资，第未有任其责者耳，～曷若与天下共之。","book":"金·元好问《通真子墓碣铭》"},"similar":["独善吾身","独善其身"],"usage":"作谓语、定语、状语；指个人修养"},{"id":31240,"word":"独善其身","pinyin":"dú shàn qí shēn","abbr":"dsqs","explanation":"独：唯独；善：好，维护。原意是做不上官就修养好自身。现指只顾自己，不管别人。","source":{"text":"穷则独善其身，达则兼善天下。","book":"《孟子·尽心上》"},"example":{"text":"～尽日安，何须千古名不朽。","book":"明·罗贯中《三国演义》第三十七回"},"similar":["自得其乐","洁身自好","自私自利"],"opposite":["助人为乐","舍己为人","见义勇为"],"usage":"作谓语、定语、状语；指个人修养","story":["战国时期，孟子劝宋勾践到别国去游说仁学。宋勾践向孟子请教如何游说。孟子说：“尊崇儒道，乐于仁义。君子为人，穷困时不要失掉仁义，得志时不要失去理智，这样穷困时能独善其身，自得其乐，得志时能兼顾天下的利益。”"]},{"id":31241,"word":"独善吾身","pinyin":"dú shàn wú shēn","abbr":"dsws","explanation":"指只顾自己，不管别人。同“独善其身”。","source":{"text":"我在这高天厚地之中发誓宣明：我只能离群索居，独善吾身！","book":"郭沫若《星空·孤竹君之二子》"},"similar":["独善其身","独善一身"],"usage":"作谓语、定语、状语；指个人修养"},{"id":31242,"word":"独善自养","pinyin":"dú shàn zì yǎng","abbr":"dszy","explanation":"只求自我完善，修身养性。","source":{"text":"山林者，士之所独善自养而不忧天下者，之所以能安也。","book":"唐·韩愈《后廿九日复上书》"}},{"id":31243,"word":"独坐愁城","pinyin":"dú zuò chóu chéng","abbr":"dzcc","explanation":"愁：忧愁。独自坐在忧愁的城中。比喻独自为忧愁所包围。","source":{"text":"身之穷困，独坐愁苦。","book":"汉·李陵《答苏武书》"}},{"id":31244,"word":"独坐穷山，引虎自卫","pinyin":"dú zuò qióng shān，yǐn hǔ zì wèi","abbr":"dzqsyhzw","explanation":"独自坐在没有出路的山里放出老虎来保卫自己。比喻不但不能保护自己，反而招来祸患。","source":{"text":"此所谓独坐穷山，引虎自卫者也。","book":"明·罗贯中《三国演义》第63回"},"similar":["独坐穷山，放虎自卫"],"usage":"作宾语、定语；比喻利用坏人而自招灾祸"},{"id":31245,"word":"独坐穷山，放虎自卫","pinyin":"dú zuò qióng shān,fàng hǔ zì wèi","abbr":"dzqsfhzw","explanation":"穷：没有出路。独自坐在没有出路的深山里，放出老虎来护卫自己。比喻独自为忧愁所包围。","source":{"text":"此所谓独坐穷山，放虎自卫者也。","book":"晋·常璩《华阳国志·公孙述刘二牧志》"},"similar":["独坐穷山，引虎自卫"],"usage":"作宾语、定语；比喻利用坏人而自招灾祸"},{"id":31246,"word":"独夫民贼","pinyin":"dú fū mín zéi","abbr":"dfmz","explanation":"独夫：暴虐无道，众叛亲离的统治者；民贼：残害人民的坏家伙。指对国家人民有严重罪行的、残暴的统治者。","source":{"text":"今之所谓良臣，古之所谓民贼也。","book":"《尚书·泰誓下》：“独夫受，洪惟作威，乃汝世仇。”《孟子·告子下》"},"example":{"text":"～，固其乐三纲之名。","book":"清·谭嗣同《仁学》第二章"},"similar":["民贼独夫"],"usage":"作主语、宾语；指残暴的统治者"},{"id":31247,"word":"独头政治","pinyin":"dú tóu zhèng zhì","abbr":"dtzz","explanation":"指独裁的专制统治。","source":{"text":"君权国者，为君主独治之国家，故亦曰独头政治。","book":"孙中山《军人精神教育·仁》"}},{"id":31248,"word":"独学寡闻","pinyin":"dú xué guǎ wén","abbr":"dxgw","explanation":"独学：指自学而无以指导切磋。独自学习，无人切磋，则孤陋寡闻。形容孤偏鄙陋，见闻不多。","source":{"text":"独学而无友，则孤陋而寡闻。","book":"《礼记·学记》"},"example":{"text":"某～，涉道甚浅。","book":"宋·张孝祥《与池州守周尚书》"},"similar":["寒腹短识"],"opposite":["见多识广"],"usage":"作谓语、宾语；指见识不多"},{"id":31249,"word":"独守空房","pinyin":"dú shǒu kōng fáng","abbr":"dskf","explanation":"妇女没有丈夫陪伴。","source":{"text":"荡子行不归，空床难独守。","book":"《古诗十九首》之二"},"example":{"text":"那玉英姐姐即使逃得过，也不免一生～。","book":"清·李汝珍《镜花缘》第八十一回"},"opposite":["同床共枕"],"usage":"作谓语、定语；用于女性"},{"id":31250,"word":"独异于人","pinyin":"dú yì yú rén","abbr":"dyyr","explanation":"独：独自，单独；异：不同。独自与别人不同的。一般指不同于世俗。","source":{"text":"我欲独异于人，而贵食母。","book":"《老子》第二十章"},"usage":"作谓语；一般指不同于世俗"},{"id":31251,"word":"独弦哀歌","pinyin":"dú xián āi gē","abbr":"dxag","explanation":"独自弹着弦子，唱着悲哀的歌调。指故意不按通常规律办事，以示自己与众不同，从而借此沽名钓誉。","source":{"text":"子非夫博学以拟圣，于于以盖众，独弦哀歌，以卖名声于天下者乎？","book":"《庄子·天地》"},"usage":"作谓语、宾语、定语；指人孤傲"},{"id":31252,"word":"独当一面","pinyin":"dú dāng yī miàn","abbr":"ddym","explanation":"单独负责一个方面的工作。","source":{"text":"而汉王之将，独韩信可属大事，当一面。","book":"《史记·留侯世家》"},"example":{"text":"将来可以～，只嫌功名心重些。","book":"清·曾朴《孽海花》第四回"},"similar":["独立自主","自力更生"],"opposite":["俯仰由人","仰人鼻息"],"usage":"作谓语、定语、状语；指单独负责","story":["西汉初期，谋士张良为刘邦出了不少好主意，睢水一战，刘邦大败，问张良有何高招，张良说：“只有楚国大将彭越和齐王田荣及汉军的韩信可以助你成就大业。”刘邦听了张良的意见，采取以攻为守，联合这三个独当一面的将领打败项羽"]},{"id":31253,"word":"独往独来","pinyin":"dú wǎng dú lái","abbr":"dwdl","explanation":"指行动自由，没有阻碍。又指作文用字独具一格，后指单独往来。","source":{"text":"出入六合，游乎九州，独往独来，是谓独有。","book":"《庄子·在宥》"},"example":{"text":"破八家藩篱，而自成一～文字。","book":"清·平步青《霞外捃屑·顾黄公春秋论》"},"similar":["独来独往"],"opposite":["出双入对"],"usage":"作谓语、定语、补语；指单独往来"},{"id":31254,"word":"独得之见","pinyin":"dú dé zhī jiàn","abbr":"ddzj","explanation":"与众不同的创造性的见解。","source":{"text":"近世一二君子，乃起而争自为说，创为独得之见。","book":"明·归有光《送王子敬之任建宁序》"},"example":{"text":"竟陵钟退谷《史怀》，多～。","book":"清·李慈铭《越缦堂诗话》上卷"},"similar":["独出己见"],"opposite":["人云亦云"],"usage":"作宾语；指与众不同的见解"},{"id":31255,"word":"独拍无声","pinyin":"dú pāi wú shēng","abbr":"dpws","explanation":"一个巴掌拍不响。比喻一个人力量单薄，难成大事。","source":{"text":"人主之患，在莫之应。故曰一手独拍，虽疾无声。","book":"《韩非子·功名》"}},{"id":31256,"word":"独揽大权","pinyin":"dú lǎn dà quán","abbr":"dldq","explanation":"揽：把持。一个人把持着权力，独断专行。","example":{"text":"他总想～，与同事合不来。"},"similar":["独断专行"],"usage":"作谓语、宾语；用于处事"},{"id":31257,"word":"独擅其美","pinyin":"dú shàn qí měi","abbr":"dsqm","explanation":"独擅：独自占有。指对美名或其他美好的东西独自垄断。","source":{"text":"大丈夫若遭二祖，终不令二公独擅美于前矣。","book":"《晋书·刘元海载记》"},"example":{"text":"宋代虽有盘乐之主，绝无渔色之君，所以高、曹、向、孟，闺德～。","book":"明·冯梦龙《警世通言·赵太祖千里送京娘》"},"usage":"作谓语、定语；用于书面语"},{"id":31258,"word":"独擅胜场","pinyin":"dú shàn shèng chǎng","abbr":"dssc","explanation":"擅：独揽；胜场：取胜的场地。形容技艺高超。","source":{"text":"秦政利觜长距，终得胜场。","book":"汉·张衡《东京赋》"},"example":{"text":"金石书画，固是他的生平嗜好，也是他的～。","book":"清·曾朴《孽海花》第二十五回"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":31259,"word":"独断专行","pinyin":"dú duàn zhuān xíng","abbr":"ddzx","explanation":"行事专断，不考虑别人的意见。形容作风不民主。","source":{"text":"她好像完全看不见他的显著的成绩，而成天提醒他不要骄傲，不要独断专行。","book":"草明《乘风破浪》九"},"example":{"text":"他平时不讲民主，做事情常常是～。"},"similar":["独断独行","刚愎自用","专横跋扈"],"opposite":["群策群力","集思广益"],"usage":"作宾语、定语、状语；形容作风不民主"},{"id":31260,"word":"独断独行","pinyin":"dú duàn dú xíng","abbr":"dddx","explanation":"行事专断，不考虑别人的意见。形容作风不民主。","source":{"text":"予已预备随时辞职，以便足下独断独行。","book":"清·容闳《西学东渐记》第十九章"},"example":{"text":"他也不信任母亲，有意见就～。","book":"柔石《二月》五"},"similar":["独断专行","独行其是","一意孤行"],"opposite":["群策群力"],"usage":"作谓语、定语、补语；形容作风不民主"},{"id":31261,"word":"独是独非","pinyin":"dú shì dú fēi","abbr":"dsdf","explanation":"指不采纳众议，是与非自己说了算，独断专行。","source":{"text":"天子置三公，九卿……本欲水火相济，盐梅相成，然后庶绩咸熙，风雨交泰，亦不可独是独非，皆由圣旨。","book":"《旧唐书·忠义传上·王义方》"},"example":{"text":"～的做法不可取。"},"similar":["独断专行"],"usage":"作谓语、宾语、定语；指独断专行"},{"id":31262,"word":"独有千古","pinyin":"dú yǒu qiān gǔ","abbr":"dyqg","explanation":"具有流传久远的价值；具有独特的专长或优点。同“独有千秋”。","source":{"text":"唐之李义山（李商隐）、宋之黄涪翁（黄庭坚），皆杜法也。先生撮在此一首中，真得其精微矣。方翁（陆游）、道园（虞集）皆未尝有此等议论，即使不读遗山诗集，已自可以独有千古矣。","book":"清·翁方纲《石洲诗话》卷七"},"similar":["独有千秋"],"usage":"作谓语、定语；用于事物或事迹等"},{"id":31263,"word":"独有千秋","pinyin":"dú yòu qiān qiū","abbr":"dyqq","explanation":"独具流传久远的价值；具有独特的专长或优点，可以流传千古。","source":{"text":"何穷何通？何得何丧？独有千秋，斯志必抗。","book":"清·张履《学箴示诸生》"},"example":{"text":"这件作品～。"},"similar":["独有千古"],"usage":"作谓语；指流传千古"},{"id":31264,"word":"独木不成林","pinyin":"dú mù bù chéng lín","abbr":"dmbcl","explanation":"一棵树成不了森林。比喻个人力量有限，办不成大事。","source":{"text":"盖高树靡阴，独木不林，随时之宜，道贵从凡。","book":"汉·崔骃《达旨》"},"example":{"text":"这叫做～，单丝不成线。","book":"周立波《山乡巨变》下"},"similar":["独木不林","单丝不成线"],"usage":"作主语、宾语、分句；比喻个人力量有限"},{"id":31265,"word":"独木不林","pinyin":"dú mù bù lín","abbr":"dmbl","explanation":"一棵树成不了森林。比喻个人力量有限，办不成大事。","source":{"text":"盖高树靡阴，独木不林。","book":"汉·崔骃《达旨》"},"example":{"text":"我们都明白～的道理。"},"similar":["独木不成林"],"usage":"作宾语、定语；比喻势力单薄，做不成大事"},{"id":31266,"word":"独木难支","pinyin":"dú mù nán zhī","abbr":"dmnz","explanation":"一根木头支不住高大的房子。比喻一个人的力量单薄，维持不住全局。","source":{"text":"大厦将颠，非一木所支也。","book":"隋·王通《文中子·事君》"},"example":{"text":"屡欲思报此恨，为～，不能向前；今此来特假将军之兵，上为朝廷立功，下以报天伦私怨。","book":"明·许仲琳《封神演义》第九十三回"},"similar":["力不从心","孤掌难鸣","回天乏术"],"opposite":["力挽狂澜","砥柱中流","回天之力"],"usage":"作谓语、定语、分句；比喻个人的力量单薄","story":["传说很久以前崂山李二拜别哥哥嫂子去昆仑山学艺，学成回家见家乡天旱，哥哥饿死，嫂子吃茅屋上的茅草度日，李二就去河边捡华达石来施行道法做饭，用脚点火被嫂子点破，从此就变成独腿瘸子，人们戏称他是独木难支的“铁拐李”"]},{"id":31267,"word":"独来独往","pinyin":"dú lái dú wǎng","abbr":"dldw","explanation":"独身往来，不与人为伍。比喻事事不与人相同。","source":{"text":"公独来独往，自我无前者也。","book":"明·李贽《何心隐论》"},"example":{"text":"古怪，～，爱抬杠，你说东来他偏西。","book":"柳青《狠透铁》"},"similar":["独往独来"],"usage":"作谓语、宾语；指人个性强"},{"id":31268,"word":"独树一帜","pinyin":"dú shù yī zhì","abbr":"dsyz","explanation":"树：立；帜：旗帜。单独树起一面旗帜。比喻独特新奇，自成一家。","source":{"text":"元、白在唐朝所以能独树一帜者，正为其不袭盛唐窠臼也。","book":"清·袁枚《随园诗话》卷三"},"example":{"text":"苏轼也擅长书法，他取法颜真卿，但能～，与蔡襄、黄庭坚、米芾并称宋代四大家。"},"similar":["别具一格","独辟蹊径","标新立异"],"opposite":["如出一辙","蹈常袭故","步人后尘"],"usage":"作谓语、定语；指自成一家"},{"id":31269,"word":"独树不成林","pinyin":"dú shù bù chéng lín","abbr":"dsbcl","explanation":"独：单独。一棵树成不了森林。比喻个人力量有限，做不成大事。","source":{"text":"梁曲曰：独柯不成树，独树不成林。","book":"《古今乐录》"},"similar":["独木不成林"],"usage":"作主语、宾语、分句；比喻个人力量有限"},{"id":31270,"word":"独根孤种","pinyin":"dú gēn gū zhǒng","abbr":"dggz","explanation":"比喻独生子。","example":{"text":"他是他们家的～。"},"similar":["单根独苗"],"usage":"作主语、宾语、定语；多用于比喻句"},{"id":31271,"word":"独此一家，别无分店","pinyin":"dú cǐ yī jiā，bié wú fēn diàn","abbr":"dcyjbwfd","explanation":"原是一些店铺招揽生意的用语，向顾客表明他没分店，只能在他这一家店里买到某种商品。泛指某种事物只有他那儿有，别处都没有。"},{"id":31272,"word":"独步一时","pinyin":"dú bù yī shí","abbr":"dbys","explanation":"形容非常突出，一个时期内没有人能比得上。","source":{"text":"论者谓熙独步一时，虽年老落笔益壮，如随其年貌焉。","book":"《宣和画谱·郭熙》卷十一"},"example":{"text":"就是那一长一技之微，若果能专心致志，亦足以轶类超群，～。","book":"清·禇人获《隋唐演义》第九十五回"},"similar":["独一无二","无与伦比","举世无双"],"opposite":["司空见惯","屡见不鲜","平淡无奇"],"usage":"作谓语、定语；形容非常突出","story":["宋朝时期的《宣和画谱》中记载河南画家郭熙，字淳夫，御画院艺学士，善画山水。他画的山山水水如有云烟出没，峰峦隐显，千姿百态，评论他是功底深厚，独步一时，虽然年纪大了，他画起来更加气势壮伟"]},{"id":31273,"word":"独步天下","pinyin":"dú bù tiān xià","abbr":"dbtx","explanation":"独步：独一无二，特别突出。超群出众，无人可比。","source":{"text":"独步天下，谁与为偶！","book":"《后汉书·戴良传》"},"example":{"text":"我若仲尼长东鲁，大禹出西羌，～，无与为偶。","book":"明·李贽《初潭集·师友七》"},"similar":["独一无二","无与伦比","超群出众"],"opposite":["举目皆是","比比皆是"],"usage":"作谓语、定语；指独一无二"},{"id":31274,"word":"独步当世","pinyin":"dú bù dāng shì","abbr":"dbds","explanation":"形容非常突出，一个时期内没有人能比得上。同“独步当时”。","source":{"text":"自苏子美死后，遂觉笔法中绝；近年君谟独步当世，然谦让不肯主盟。","book":"宋·欧阳修《试笔·苏子美蔡君谟书》"},"similar":["独步当时","独步一时"],"usage":"作谓语、定语；指独一无二"},{"id":31275,"word":"独步当时","pinyin":"dú bù dāng shí","abbr":"dbds","explanation":"形容非常突出，一个时期内没有人能比得上。","source":{"text":"文藻宏丽，独步当时；言论慷慨，冠乎终古。","book":"《晋书·陆喜传》"},"example":{"text":"～，峻节清心，高迈流俗。","book":"五代·王定保《唐摭言·怨怒》"},"similar":["盖世无双","独一无二","独步当世"],"opposite":["比比皆是"],"usage":"作谓语、定语；指独一无二"},{"id":31276,"word":"独清独醒","pinyin":"dú qīng dú xǐng","abbr":"dqdx","explanation":"独自清白，独自觉醒，不与世俗同流合污。","source":{"text":"屈原曰：‘举世皆浊而我独清，众人皆醉而我独醒，是以见放。’","book":"战国·楚·屈原《渔父》"},"usage":"作谓语、定语；用于处世"},{"id":31277,"word":"独游偶影","pinyin":"dú yóu ǒu yǐ","abbr":"dyoy","explanation":"偶：伴侣。以影子为伴，独自游赏。形容孤单无依。","source":{"text":"春服既成，景物斯和。偶影独游，欣慨交心。","book":"晋·陶潜《时运·序》"},"example":{"text":"回驾蓬庐，～。","book":"晋·王胡之《赠庾翼》诗"}},{"id":31278,"word":"独立不群","pinyin":"dú lì bù qún","abbr":"dlbq","explanation":"指人的思想或仪表出众。","source":{"text":"陟自幼风标整峻，独立不群。","book":"《旧唐书·韦陟传》"},"similar":["超群出众"],"usage":"作谓语、定语；用于书面语"},{"id":31279,"word":"独立王国","pinyin":"dú lì wáng guó","abbr":"dlwg","explanation":"指抵制或不服从上级领导的行政区域或单位。","source":{"text":"所谓政治分会与北洋军阀的巡阅使毫没有区别，目的在于割据一方，形成独立王国。","book":"陶菊隐《北洋军阀统治时期史话》第78章"},"example":{"text":"我希望有一个～。"},"usage":"作宾语；指独立的单位"},{"id":31280,"word":"独立自主","pinyin":"dú lì zì zhǔ","abbr":"dlzz","explanation":"多指国家或政党维护主权，不受别人的控制或支配。","source":{"text":"最初是买办，然后是独立自主的老板，然后又是买办。","book":"茅盾《子夜》十六"},"example":{"text":"我们要奉行～的外交政策。"},"similar":["自食其力","自力更生"],"opposite":["仰人鼻息","身不由己","寄人篱下"],"usage":"作谓语、定语、状语；指不依赖别人"},{"id":31281,"word":"独立难支","pinyin":"dú lì nán zhī","abbr":"dlnz","explanation":"独：单独；独立：不依赖外力。比喻个人力量单薄不能维持全局。","source":{"text":"雄信闻言大怒，想众将都已杀尽，独立难支，遂叫一声：‘罢了！’","book":"《说唐》第55回"},"similar":["独木难支"],"opposite":["力挽狂澜"],"usage":"作谓语、定语、分句；用于处事"},{"id":31282,"word":"独竖一帜","pinyin":"dú shù yī zhì","abbr":"dsyz","explanation":"单独树起一面旗帜。比喻独特新奇，自成一家。同“独树一帜”。","source":{"text":"所以能独竖一帜者，正为不袭盛唐窠臼也。","book":"清·袁枚《随园诗话》"},"similar":["独树一帜"],"usage":"作谓语、定语；指自成一家"},{"id":31283,"word":"独胆英雄","pinyin":"dú dǎn yīng xióng","abbr":"ddyx","explanation":"指不畏强敌，英勇奋战，以少胜多的杰出人物。","example":{"text":"他是我们国家有名的～。"},"usage":"作宾语、定语；用于夸奖人"},{"id":31284,"word":"独臂将军","pinyin":"dú bì jiāng jūn","abbr":"dbjj","explanation":"指孤立无援的人。","source":{"text":"从整个革命战争的观点看来，和主力红军是互为左右手，只有主力红军而无人民的游击战争，就像一个独臂将军。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["断臂将军"],"usage":"作宾语、定语；用于比喻句"},{"id":31285,"word":"独自乐乐","pinyin":"dú zì yuè lè","abbr":"dzll","explanation":"乐乐：欣赏音乐。独自一个人欣赏音乐的快乐。比喻自己享乐必然导致脱离群众。","source":{"text":"曰：‘独乐乐，与人乐乐，孰乐？’曰：‘不若与人。’","book":"《孟子·梁惠王下》"}},{"id":31286,"word":"独自茕茕","pinyin":"dú zì qióng qióng","abbr":"dzqq","explanation":"茕茕：形容孤孤单单，无依无靠。独自一人，无依无靠，非常孤独寂寞。","source":{"text":"但他又立刻觉得对孩子有些抱歉了，重复回头，目送着她独自茕茕的出去了。","book":"鲁迅《幸福的家庭》"}},{"id":31287,"word":"独茧抽丝","pinyin":"dú jiǎn chōu sī","abbr":"djcs","explanation":"比喻诗文条理清晰，脉络分明。亦比喻单相思。","source":{"text":"凡作近体，诵要好，听要好，观要好，讲要好。诵之行云流水，听之金声玉振，观之明霞散绮，讲之独茧抽丝。","book":"明·谢榛《四溟诗话》第一卷"},"example":{"text":"一日见某部某郎，不觉倾倒，形输色授，颇难自持。然～无由作合也，因赋无题二章。","book":"清·梁绍壬《两般秋雨庵随笔·无题诗序》"},"usage":"作宾语；指单相思"},{"id":31288,"word":"独行其是","pinyin":"dú xíng qí shì","abbr":"dxqs","explanation":"是：对的。不考虑别人的意见，只照自己认为对的去做。","source":{"text":"得志，与民由之；不得志，独行其道。","book":"《孟子·滕文公下》"},"example":{"text":"杨嗣昌见他往往不受军令，～，也明白他心中不服，决心拿他“开刀”，替别人做个榜样。","book":"姚雪垠《李自成》第二卷第二十二章"},"similar":["独断专行"],"opposite":["民主集中"],"usage":"作谓语、定语、宾语；指只照自己意见去做"},{"id":31289,"word":"独行其道","pinyin":"dú xíng qí dào","abbr":"dxqd","explanation":"道：信念、主张。独自去实现自己的主张。","source":{"text":"得志，与民由之；不得志，独行其道。","book":"战国·邹·孟轲《孟子·滕文公下》"},"example":{"text":"你不要～，远离群众。"},"similar":["独行其是"],"usage":"作谓语、定语；指只照自己认为对的去做"},{"id":31290,"word":"独行君子","pinyin":"dú xíng jūn zǐ","abbr":"dxjz","explanation":"旧指士大夫的独特行为、操守，是一种美称。","source":{"text":"寅初四年诏公卿举独行君子，司徒华歆荐之。文帝以为大中大夫，固辞不受。","book":"《三国志·魏志·管宁传》"}},{"id":31291,"word":"独行独断","pinyin":"dú xíng dú duàn","abbr":"dxdd","explanation":"行事专断，不考虑别人的意见。形容作风不民主。同“独断独行”。","source":{"text":"彦彪令各营于肩章均添‘四标’字样，官长进谒皆称邱大帅，俨然以兵马都督自居，调遣布置，独行独断。","book":"郭希仁《从戎纪略》"},"example":{"text":"只可异她母亲死早了，没有人管教她，任她一个人～，将来不晓得会弄成什么样子。","book":"巴金《家》二五"},"similar":["独断专行"],"usage":"作宾语、定语、谓语；形容作风不民主"},{"id":31292,"word":"独行踽踽","pinyin":"dú xíng jǔ jǔ","abbr":"dxjj","explanation":"孤零零地一个人走路。","source":{"text":"踽踽，无所亲也。","book":"《诗唐·风杕杜》：“独行踽踽，岂无他人，不如我同父。”毛传"},"example":{"text":"正虑～，得卿同行固妙，但无可托词耳。","book":"清·沈复《浮生六记·闺房记乐》"},"similar":["踽踽独行"],"usage":"作谓语、宾语、状语；指人独自走路"},{"id":31293,"word":"独裁专断","pinyin":"dú cái zhuān duàn","abbr":"dczd","explanation":"断：决断，做决定。独自做出决定，自己想怎么样就怎么样。","source":{"text":"封建时代独裁专断的恶习惯深中于群众乃至一般党员的头脑中，一时扫除不净，遇事贪图便利，不喜欢麻烦的民主制度。","book":"毛泽东《井冈山的斗争》"},"similar":["独断专行"],"usage":"作谓语、定语、状语；形容作风不民主"},{"id":31294,"word":"独见之明","pinyin":"dú jiàn zhī míng","abbr":"djzm","explanation":"高明的眼光，独到的见解。","source":{"text":"独闻之耳，独见之明。","book":"《淮南子·汜论训》"}},{"id":31295,"word":"独见之虑","pinyin":"dú jiàn zhī lǜ","abbr":"djzl","explanation":"虑：思考，谋划。超出众人的独到的谋划。","source":{"text":"有独见之虑，见赘于人。","book":"《后汉书·北衍传》"}},{"id":31296,"word":"独辟蹊径","pinyin":"dú pì xī jìng","abbr":"dpxj","explanation":"自己开辟一条路。比喻独创一种风格或新的方法。","source":{"text":"抹倒体裁、声调、气象、格力诸说，独辟蹊径，而栩栩然自是也。","book":"清·叶燮《原诗·外篇上》"},"example":{"text":"雍小源～巧构思，研制成我国首创电液组合泵。","book":"《文汇报》1982.9.24"},"similar":["别出心裁","独具匠心","标新立异"],"opposite":["如出一辙","鹦鹉学舌","步人后尘"],"usage":"作谓语、定语；指独创"},{"id":31297,"word":"独运匠心","pinyin":"dú yùn jiàng xīn","abbr":"dyjx","explanation":"匠心：精巧的心思。形容精美独到的艺术构思。","source":{"text":"他的旁艺，如制缠枝杖，独运匠心，修短适度，且刻铭识，以贻朋友，大有庾子三所谓‘秋藜促节，白藋同心’之致。","book":"郑逸梅《艺坛百影·陈从周与纽约明轩》"}},{"id":31298,"word":"独门独户","pinyin":"dú mén dú hù","abbr":"dmdh","explanation":"单独一家。","example":{"text":"她住在那里～的，十分孤单。"},"similar":["单门独户"],"usage":"作主语、宾语、定语；指单独一家"},{"id":31299,"word":"独霸一方","pinyin":"dú bà yī fāng","abbr":"dbyf","explanation":"霸占一个地方（多指坏人）。","source":{"text":"钱王生于乱世，独霸一方，做了十四州之主。","book":"明·冯梦龙《古今小说·临安里钱婆留发迹》"},"example":{"text":"少年无赖，～。","book":"清·李壬《清忠谱》上"},"similar":["独占鳌头","横行霸道"],"usage":"作谓语、定语；指霸占一个地方"},{"id":31300,"word":"独鹤鸡群","pinyin":"dú hè jī qún","abbr":"dhjq","explanation":"一只鹤站在鸡群中。比喻一个人的才能或仪表超群出众。","source":{"text":"嵇延祖卓卓如野鹤之在鸡群。","book":"晋·戴逵《竹林七贤论》：“嵇绍入洛，或谓王戎曰：‘昨于稠人中始见嵇绍，昂昂然若野鹤之在鸡群。’”南朝梁·刘义庆《世说新语·容止》"},"example":{"text":"～自寡俦，三间老屋日西头。","book":"清·钱谦益《客途有怀吴中故人周吏部景文》"},"similar":["鹤立鸡群"],"usage":"作定语；指才能出众"},{"id":31301,"word":"狭路相逢","pinyin":"xiá lù xiāng féng","abbr":"xlxf","explanation":"在很窄的路上相遇，没有地方可让。后多用来指仇人相见，彼此都不肯轻易放过。","source":{"text":"相逢狭路间，道隘不容车。","book":"汉·乐府诗《相逢行》"},"example":{"text":"～这恶人，如何是好。","book":"明·许仲琳《封神演义》第七十二回"},"similar":["冤家路窄","仇人相见"],"opposite":["康庄大道"],"usage":"作谓语、定语；指对立双方互不相让","story":["古时营丘读书人喜欢无事生非，爱与人胡乱争辩，把无理说成有理。他来到艾子家，问艾子为什么大车与骆驼的脖子上都挂个铃。艾子告诉他为了防止夜里他们狭路相逢，无法避让。营丘人又列举很多古怪的例子，艾子则讽刺他"]},{"id":31302,"word":"狮威胜虎","pinyin":"shī wēi shèng hǔ","abbr":"swsh","explanation":"胜：胜过，超过。狮子的威力超过老虎。比喻妇人十分悍妒。","source":{"text":"狮威胜虎，蛇毒如刃。","book":"清·孔尚任《桃花扇·逢舟》"},"similar":["河东狮吼"],"usage":"作宾语、定语；指人惧内","story":["宋朝时期，苏轼被贬至黄州，常与好友陈季常一起谈论文学。陈季常很好客，经常邀客人到家里，他的妻子是河东郡柳氏经常敲墙赶客，苏轼作诗“龙邱居士亦可怜，谈空说有夜不眠，忽闻河东狮子吼，柱杖落手心茫然。”笑陈季常怕老婆"]},{"id":31303,"word":"狮威胜龙","pinyin":"shī wēi shèng lóng","abbr":"swsl","explanation":"胜：胜过，超过。狮子的威风超过老虎。旧时比喻妇人悍妒过甚。","source":{"text":"狮威胜龙，蛇毒如刃。","book":"清·孔尚任《桃花扇·逢舟》"}},{"id":31304,"word":"狮子吼","pinyin":"shī zi hǒu","abbr":"szh","explanation":"佛教徒比喻佛祖讲经，如雷震天地。","source":{"text":"演法无畏，犹狮子吼。其抽讲说，乃如雷震。","book":"《维摩经·佛国品》"},"example":{"text":"当为～，佛法无南北。","book":"宋·苏轼《闻潮阳吴子野出家》"},"usage":"作宾语、定语；多用于比喻句"},{"id":31305,"word":"狮子大开口","pinyin":"shī zī dà kāi kǒu","abbr":"szdkk","explanation":"比喻要价或所提条件很高。","source":{"text":"且慢！我们先别狮子大开口，做事要十拿九稳。","book":"陆俊超《劳动号油轮》"},"example":{"text":"价格这么高真是～。"},"similar":["漫天要价"],"usage":"作谓语、宾语；指漫天要价"},{"id":31306,"word":"狮子搏兔","pinyin":"shī zǐ bó tù","abbr":"szbt","explanation":"比喻对小事情也非常重视、用出全部力量。","source":{"text":"狮子搏兔，亦用全力——这一句成语，最足以说明艺术巨匠们之无往而不谨严，丝毫不肯随便。","book":"茅盾《谨严第一》"},"example":{"text":"我们要学习她那种～的精神。"},"similar":["狮子搏兔，亦用全力","一丝不苟"],"usage":"作宾语、定语；指用出全部力量"},{"id":31307,"word":"狮子搏兔，亦用全力","pinyin":"shī zǐ bó tù，yì yòng quán lì","abbr":"szbtyyql","explanation":"比喻对小事情也拿出全部力量认真对付。同“狮象搏兔，皆用全力”。","source":{"text":"狮子搏兔，亦用全力——这一句成语，最足以说明艺术巨匠们之无往而不谨严，丝毫不肯随便。","book":"茅盾《谨严第一》"},"similar":["狮象搏兔，皆用全力"],"usage":"作宾语、定语、分句；用于处事"},{"id":31308,"word":"狮子搏象兔，皆用全力","pinyin":"shī zi bó xiàng tù，jiē yòng quán lì","abbr":"szbxtjyql","explanation":"狮子不论与大象或是兔子搏斗，都会用尽全力。形容事情无论大小都认真对待，决不掉以轻心。","source":{"text":"昔亡友叶文敏评余《蜀道集》诗，‘无论长篇短论，每首具有二十分力量，所谓狮子搏象兔，皆用全力。’余深愧其言。","book":"清·王士慎《分甘余话》"}},{"id":31309,"word":"狮虎当道","pinyin":"shī hǔ dāng dào","abbr":"shdd","explanation":"危险的阻障，指作为不采取行动的借口而捏造的或夸大了的危险。","example":{"text":"这里～，艰险重重。"},"similar":["虎狼当道"],"usage":"作谓语；指危险的处境"},{"id":31310,"word":"狮象搏兔，皆用全力","pinyin":"shī xiàng bó tù，jiē yòng quán lì","abbr":"sxbtjyql","explanation":"比喻对小事情也拿出全部力量认真对付。","source":{"text":"沾沾卷石之菁华，一花之开落，与桑经郦注争长黄池，则是狮象搏兔，皆用全力尔。","book":"清·黄宗羲《〈称心寺志〉序》"},"similar":["狮子搏兔，亦用全力"],"usage":"作宾语、定语、分句；用于处事"},{"id":31311,"word":"狰狞可畏","pinyin":"zhēng níng kě wèi","abbr":"znkw","explanation":"狰狞：状貌凶恶。状貌凶恶，让人畏惧。","source":{"text":"郡城东岳庙，在南郭大门左右，神高丈余，俗名鹰虎神，狰狞可畏。","book":"清·蒲松龄《聊斋志异·鹰虎神》"},"example":{"text":"他有一幅～的长相。"},"usage":"作谓语、定语、状语；指面目可怕"},{"id":31312,"word":"狰狞面孔","pinyin":"zhēng níng miàn kǒng","abbr":"znmk","explanation":"狰狞：样子凶恶。形容面貌凶恶可怕。","source":{"text":"如果民族资产阶级是同地主买办一模一样，以卖国贼的狰狞面孔出现，争取领导权的任务就大可取消，至少也可以减轻了。","book":"毛泽东《论反对帝国主义的策略》"},"similar":["狰狞面目"],"usage":"作宾语、状语；用于人的外貌"},{"id":31313,"word":"狰狞面目","pinyin":"zhēng níng miàn mù","abbr":"znmm","explanation":"狰狞：样子凶恶。形容面貌凶恶可怕。","source":{"text":"两个蒙古青年骑快马而来，下马入帐，以狰狞面目，厉声问我要票。","book":"《塞上行·行纪·忆西蒙》"},"example":{"text":"敌人见利诱不成，便露出了他们的～，用枪毙来威胁革命者。"},"similar":["面目狰狞"],"usage":"作宾语、状语；用于人的外貌"},{"id":31314,"word":"狰狞面貌","pinyin":"zhēng níng miàn mào","abbr":"znmm","explanation":"狰狞：样子凶恶。形容面貌凶恶可怕。","source":{"text":"我们一方面要领导群众争取斗争的胜利，一方面必须充分暴露敌人的狰狞面貌。","book":"邓小平《敌占区的组织工作与政策运用》"},"similar":["狰狞面目","狰狞面孔"],"usage":"作宾语、定语；用于人的外貌"},{"id":31315,"word":"狱货非宝","pinyin":"yù huò fēi bǎo","abbr":"yhfb","explanation":"指法官断狱受贿赂，也难逃法网。","source":{"text":"狱货非宝，惟府事功，报以庶尤。","book":"《书·吕刑》"},"usage":"作宾语、定语；用于劝诫人"},{"id":31316,"word":"狷介之士","pinyin":"juàn jiě zhī shì","abbr":"jjzs","explanation":"狷介：孤僻高傲，洁身自好。指孤僻高傲，不肯同流合污之人。","source":{"text":"巢、许狷介之士，不足多慕。","book":"三国·魏·刘劭《人物志上·体别》：“狷介之人，砭清激浊。”南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"见理明而不妄取，无所为而然，上也；尚名节而不苟取，～，其次也。","book":"明·薛瑄《从政录》"},"similar":["正人君子"],"usage":"作主语、宾语；指不肯同流合污之人"},{"id":31317,"word":"狼前虎后","pinyin":"láng qián hǔ hòu","abbr":"lqhh","explanation":"前门赶走狼，后门来了虎。比喻坏人接踵而来。","source":{"text":"早知道狼前虎后，一样愤难消。","book":"清·感惺《断头台·党争》"},"usage":"作宾语、定语；用于比喻句"},{"id":31318,"word":"狼号鬼叫","pinyin":"láng háo guǐ jiào","abbr":"lhgj","explanation":"似鬼哭叫，如狼嚎叫。形容惨凄的哭声或悲凉的场景。","source":{"text":"宝玉才好了些，连我们不敢大声说话，你反打的人狼号鬼叫的。","book":"清·曹雪芹《红楼梦》第58回"},"similar":["鬼哭狼嚎"],"usage":"作定语、状语；用于口语"},{"id":31319,"word":"狼号鬼哭","pinyin":"láng háo guǐ kū","abbr":"lhgk","explanation":"形容大声哭叫，声音凄厉。","source":{"text":"可怎生神嚎鬼哭，雾惨云昏，白日为幽。","book":"元·无名氏《马陵道》第二折"},"example":{"text":"况且宝玉才好了些，连我们也不敢说话，你反打的人～的！（清·曹雪芹《红楼梦》第五十八回）"},"similar":["鬼哭狼嚎"],"usage":"作谓语、定语、状语；指哭声凄惨"},{"id":31320,"word":"狼吃幞头","pinyin":"láng chī fú tóu","abbr":"lcft","explanation":"狼衔去人的幞头，吞不下又吐不出。比喻有苦难言，强自忍耐。","source":{"text":"你便骂我一千场，便拷我三十顿，我则索狼吃幞头，心儿自忍。","book":"元·无名氏《杀狗劝夫》第一折"},"example":{"text":"俺家里也使了他数锭银，不勾二年，银两使尽，剗地赶他出去，他则索～，心儿里自忍。","book":"明·贾仲名《对玉梳》第一折"},"usage":"作宾语、定语；用于比喻句"},{"id":31321,"word":"狼吞虎咽","pinyin":"láng tūn hǔ yàn","abbr":"lthy","explanation":"形容吃东西又猛又急的样子。","source":{"text":"十人自来吃酒……须臾之间，狼飧虎咽，算来吃够有六七十斤肉。","book":"明·凌濛初《初刻拍案惊奇·刘东山夸技顺城门》"},"example":{"text":"走了这半日，肚中饥饿，～吃了一回。","book":"清·陈忱《水浒后传》第五回"},"similar":["大吃大喝","饥不择食","食不甘味"],"opposite":["细嚼慢咽"],"usage":"作谓语、状语、定语；形容吃东西的样子"},{"id":31322,"word":"狼吞虎噬","pinyin":"láng tūn hǔ shì","abbr":"lths","explanation":"像狼虎那样吞食咬嚼。比喻极为贪婪残忍。","source":{"text":"你辟私门，贿赂行，半朝臣，皆从顺。你狼吞虎噬伤残了万民百姓，害得那有功臣百事无成。","book":"明·无名氏《鸣凤记·二相争朝》"},"example":{"text":"自此以入，司牧之官，必能扫除一切苛政……去害马以驯良，泯雀角鼠牙之衅，绝～之端，不惊不扰，民得宽然，各尽地方。《花月痕》第五十回"},"similar":["狼吞虎餐"],"usage":"作定语、状语；用于比喻句"},{"id":31323,"word":"狼吞虎餐","pinyin":"láng tūn hǔ cān","abbr":"lthc","explanation":"形容吃东西又猛又急。","source":{"text":"他们把饭煮熟，菜烧好，聚在一起，就在村前打麦场上，狼吞虎餐的吃。","book":"清·彭养鸥《黑籍冤魂》第23回"},"similar":["狼吞虎噬","狼吞虎咽"],"usage":"作定语、状语；用于比喻句"},{"id":31324,"word":"狼嗥狗叫","pinyin":"láng háo gǒu jiào","abbr":"lhgj","explanation":"形容恶人狂呼乱叫。"},{"id":31325,"word":"狼嗥鬼叫","pinyin":"láng háo guǐ jiào","abbr":"lhgj","explanation":"形容声音凄厉。"},{"id":31326,"word":"狼嚎鬼叫","pinyin":"láng háo guǐ jiào","abbr":"lhgj","explanation":"形容声音凄厉。同“狼嗥鬼叫”。"},{"id":31327,"word":"狼多肉少","pinyin":"láng duō ròu shǎo","abbr":"ldrs","explanation":"供不应求。","example":{"text":"现在我们的东西奇缺，～。"},"similar":["粥少僧多"],"opposite":["供过于求"],"usage":"作谓语、定语；指供不应求"},{"id":31328,"word":"狼奔兔脱","pinyin":"láng bēn tù tuō","abbr":"lbtt","explanation":"形容仓皇逃窜。","source":{"text":"远远听见吆喝之声，由远而近……众人手忙脚乱，将桌上杯盘收拾干净，转眼间，狼奔兔脱，如鸟兽散去。","book":"《冷眼观》第四回"},"similar":["狼奔鼠窜"],"usage":"作宾语、状语、定语；用于比喻句"},{"id":31329,"word":"狼奔豕突","pinyin":"láng bēn shǐ tū","abbr":"lbst","explanation":"豕：猪；突：猛冲。象狼那样奔跑，象猪那样冲撞。形容成群的坏人乱冲乱撞，到处搔扰。","source":{"text":"有几个狼奔豕突的燕和赵，有几个狗屠驴贩的奴和盗。","book":"明·归庄《万古愁》"},"example":{"text":"在中国战场它还～，随心所欲。","book":"矛盾《东条的“神符”》"},"similar":["横冲直撞","抱头鼠窜","群魔乱舞"],"opposite":["有条不紊","井然有序","井井有条"],"usage":"作谓语、宾语、状语；指坏人作恶"},{"id":31330,"word":"狼奔鼠偷","pinyin":"láng bēn shǔ tōu","abbr":"lbst","explanation":"形容坏人到处扰乱。","source":{"text":"公在商州六年，贼出入陕西久，无所掠利，锐欲窥河南甚，狼奔鼠偷，情状捷出。","book":"清·梅曾亮《朝议大夫台湾府盖君墓志铭》"},"usage":"作谓语、宾语；用于比喻句"},{"id":31331,"word":"狼奔鼠窜","pinyin":"láng bēn shǔ cuàn","abbr":"lbsc","explanation":"狼群鼠辈到处流窜。形容人四处奔跑逃窜。","source":{"text":"端不为那逐鸟飞兔走忙，趁狼奔鼠窜慌，只为这些时梁山泊能收人望。","book":"明·许自昌《水浒记·火并》"},"example":{"text":"十室九空，不显乡村城廓，～，那有礼乐衣冠？","book":"明·兰陵笑笑生《金瓶梅词话》第一百回"},"similar":["抱头鼠窜","狼奔兔脱"],"usage":"作宾语、状语、定语；用于比喻句"},{"id":31332,"word":"狼子兽心","pinyin":"láng zǐ shòu xīn","abbr":"lzsx","explanation":"比喻凶暴的人用心残忍，有如野兽。","source":{"text":"然狼子兽心，轻薄易动。","book":"《晋书·虞预传》"},"example":{"text":"我们得提防他的～。"},"similar":["心狠手辣"],"opposite":["心地善良"],"usage":"作主语、宾语；指人的心肠坏"},{"id":31333,"word":"狼子野心","pinyin":"láng zǐ yě xīn","abbr":"lzyx","explanation":"狼子：狼崽子。狼崽子虽幼，却有凶恶的本性。比喻凶暴的人居心狠毒，习性难改。","source":{"text":"谚曰：狼子野心。是乃狼也，其可畜乎？","book":"《左传·宣公四年》"},"example":{"text":"哪晓得这班降兵，本来原是游勇出身，～，哪里肯安安顿顿的守著规矩过日子，便渐渐的放肆起来。","book":"清·张春帆《宦海》第八回"},"similar":["野心勃勃","心狠手辣","狼心狗肺"],"opposite":["赤子之心","耿耿忠心","心地善良"],"usage":"作谓语、宾语；指坏人的心肠","story":["春秋时期，楚国若敖家族子文、子良兄弟均做了官。司马子良生了一个很凶猛的儿子斗越椒，令尹子文不喜欢这个侄子，认为他有狼子野心。后来斗越椒做了司马，他杀死堂兄子扬，继任令尹，暗中扩军反叛，被楚王打败，灭了若敖全族"]},{"id":31334,"word":"狼心狗肺","pinyin":"láng xīn gǒu fèi","abbr":"lxgf","explanation":"形容心肠象狼和狗一样凶恶狠毒。","source":{"text":"那知这贼子恁般狼心狗肺，负恩忘义。","book":"明·冯梦龙《醒世恒言》卷三十"},"example":{"text":"你这个～的烂货，你想把我气死了，你们去过快活日子。","book":"清·李宝嘉《中国现在记》第十二回"},"similar":["狼子野心","居心叵测","人面兽心"],"opposite":["耿耿忠心","赤子之心","碧血丹心"],"usage":"作谓语、定语、宾语；指人的心肠坏"},{"id":31335,"word":"狼心狗行","pinyin":"láng xīn gǒu xíng","abbr":"lxgx","explanation":"心肠似狼，行为如狗。比喻贪婪凶狠，卑鄙无耻。","source":{"text":"鹰头雀脑将身探，狼心狗行潜踪阚，鹅行鸭步怀愚滥。","book":"元·杨景贤《西游记》第四本第十三出"},"example":{"text":"昔日以汝为忠义，推为盟主；今之所为，真～之徒，有何面目立于世间！（明·罗贯中《三国演义》第七回）"},"usage":"作谓语、宾语、定语；指坏人"},{"id":31336,"word":"狼戾不仁","pinyin":"láng lì bù rén","abbr":"llbr","explanation":"狼戾：贪婪、凶狠；不仁：暴虐不人道。形容凶狠残暴，没有人性。","source":{"text":"闽越王狼戾不仁，杀其骨肉。","book":"《汉书·严助传》"},"example":{"text":"董卓欺天罔地，灭国弑君；秽乱宫禁，残害生灵；～，罪恶充积！","book":"明·罗贯中《三国演义》第五回"}},{"id":31337,"word":"狼烟四起","pinyin":"láng yān sì qǐ","abbr":"lysq","explanation":"狼烟：古代边防报警时烧狼粪腾起的烟。四处都是报警的烟火，指边疆不平静。","source":{"text":"狼粪烟直上，烽火用之。","book":"唐·段成式《酉阳杂俎·毛篇》"},"example":{"text":"这火筒节节生枝，能吹得～；实在放他不得。","book":"清·钱彩《说岳全传》第七十回"},"similar":["烽火连天","烽火遍地"],"opposite":["平安无事","国泰民安"],"usage":"作谓语、定语、补语；形容战争动乱"},{"id":31338,"word":"狼烟大话","pinyin":"láng yān dà huà","abbr":"lydh","explanation":"漫无边际的吹牛话。","source":{"text":"他就喜欢听那些狼烟大话，听这些人帮着他摆龙门阵！","book":"管桦《清风店》"},"usage":"作宾语、定语；用于说话"},{"id":31339,"word":"狼狈万状","pinyin":"láng bèi wàn zhuàng","abbr":"lbwz","explanation":"狼狈：窘迫的样子；万状：多种样子。形容极其困顿、窘迫。","source":{"text":"太上因暑热成病，狼狈万状。","book":"《新刊大宋宣和遗事》"},"example":{"text":"碗碟之类撞将上去，一一反弹出来，但汁水淋漓，不免～。","book":"金庸《天龙八部》第六章"},"similar":["狼狈不堪"],"usage":"作谓语、定语；指极其困顿窘迫"},{"id":31340,"word":"狼狈不堪","pinyin":"láng bèi bù kān","abbr":"lbbk","explanation":"狼狈：窘迫的样子。困顿、窘迫得不能忍受。形容非常窘迫的样子。","source":{"text":"宽、衢闭冀城门，超不得入。进退狼狈，乃奔汉中依张鲁。","book":"《三国志·蜀志·马超传》"},"example":{"text":"掌声如翻腾的怒海汹涌的扑向台上去，弄得这些丑类面红耳赤，～。","book":"刘白羽《雷电颂——怀念郭沫若同志》"},"similar":["惊慌失措","手足无措"],"opposite":["镇定自若","从容不迫"],"usage":"作谓语、定语、状语；指人的窘态","story":["东汉末年，曹操骗杀西凉刺史马腾，马腾的儿子马超率军为父报仇，被曹操利用反间计，离间了马超与韩遂。马超杀死凉州刺史韦康自立为“征西将军”，韦康的部下联合曹操进攻马超，让马超腹背受敌，十分狼狈，只好投奔刘备"]},{"id":31341,"word":"狼狈为奸","pinyin":"láng bèi wéi jiān","abbr":"lbwj","explanation":"狼和狈一同出外伤害牲畜，狼用前腿，狈用后腿，既跑得快，又能爬高。比喻互相勾结干坏事。","source":{"text":"故世言事乖者称狼狈。","book":"唐·段成式《酉阳杂俎》十六"},"example":{"text":"帝国主义与封建势力永远是互相勾结，～的。","book":"闻一多《谨防汉奸合法化》"},"similar":["同流合污","气味相投"],"opposite":["志同道合","情投意合","同心协力"],"usage":"作谓语、定语、状语；指互相勾结干坏事","story":["传说从前有一只狼和一只狈一起来到牧民的羊圈外面准备偷羊吃，羊圈很高，它们跳不过去，于是想出一个办法，由狼站在狈的脖子上，狼用前脚去抓羊。这样狼伸出前爪狠狠地抓住一只羊拖出羊圈与狈一起享用美餐一顿"]},{"id":31342,"word":"狼狈周章","pinyin":"láng bèi zhōu zhāng","abbr":"lbzz","explanation":"指仓皇惊恐。","source":{"text":"造成作家们此种忐忑不安、狼狈周章的心情，其直接的原因，不能不说是外来的束缚。","book":"茅盾《对于文坛的一种风气的看法》"},"usage":"作谓语、定语；指仓皇惊恐"},{"id":31343,"word":"狼狈逃窜","pinyin":"láng bèi táo cuàn","abbr":"lbtc","explanation":"狼狈：窘迫的样子。形容逃跑时的丑态。","example":{"text":"与其在群起而攻之中～，倒不如主动辞去军长职务，还有几分体面。","book":"魏巍《地球的红飘带》三十二"}},{"id":31344,"word":"狼猛蜂毒","pinyin":"láng měng fēng dú","abbr":"lmfd","explanation":"比喻人凶狠毒辣。","source":{"text":"夫虏人面兽心，狼猛蜂毒，暴悖天经，亏违地义。","book":"南朝·齐·王融《上疏请给虏书》"},"usage":"作宾语、定语；用于比喻句"},{"id":31345,"word":"狼眼鼠眉","pinyin":"láng yǎn shǔ méi","abbr":"lysm","explanation":"形容人相貌凶恶。","example":{"text":"他生就一幅～的模样。"},"usage":"作宾语、定语；用于人的长相等"},{"id":31346,"word":"狼突豕窜","pinyin":"láng tū shǐ cuàn","abbr":"ltsc","explanation":"象狼那样奔跑，象猪那样冲撞。形容成群的坏人乱冲乱撞，到处搔扰。同“狼奔豕突”。","source":{"text":"狼突豕窜，无一尉一堠能少婕其角距者。此公之言验于事后者也。","book":"清·钱谦益《资政大夫兵部尚书申公神道碑铭》"},"similar":["狼奔豕突"],"usage":"作谓语、宾语、状语；指坏人作恶"},{"id":31347,"word":"狼突鸱张","pinyin":"láng tū chī zhāng","abbr":"ltcz","explanation":"像狼一样奔突，像鹞鹰一样张开翅膀。形容坏人猖狂嚣张到了极点。","source":{"text":"如此狼突鸱张，岂能将就姑容，致贻民害。","book":"清·林则徐《会谕澳同知再行谕饷义律缴土凶稿》"},"similar":["狼顾鸱张"],"usage":"作谓语、定语；用于比喻句"},{"id":31348,"word":"狼窝虎穴","pinyin":"láng wō hǔ xué","abbr":"lwhx","explanation":"虎穴：老虎住的洞穴。比喻险恶的环境或地方。","source":{"text":"我们满以为这样一点儿响动也没有，准能神不知鬼不觉地离开这个～的。 ★吴越《括苍山恩仇记》第六十四回"}},{"id":31349,"word":"狼羊同饲","pinyin":"láng yáng tóng sì","abbr":"lyts","explanation":"比喻把坏人同好人一样对待。","source":{"text":"若但务招徕，不加审别，兰棘并植，狼羊同饲，将复为昔日之罗旁矣。","book":"明·张居正《答两广凌洋山计罗旁善后》"},"usage":"作宾语、定语；用于比喻句"},{"id":31350,"word":"狼艰狈蹶","pinyin":"láng jiān bèi juě","abbr":"ljbj","explanation":"比喻处境困苦窘迫。","source":{"text":"自乾隆末年以来，官吏士民，狼艰狈蹶，不士、不农、不工、不商之人，十将五六。","book":"清·龚自珍《西域置行省议》"},"usage":"作谓语、定语；用于比喻句"},{"id":31351,"word":"狼虫虎豹","pinyin":"láng chóng hǔ bào","abbr":"lchb","explanation":"①泛指凶猛的动物。②比喻恶人歹徒。","source":{"text":"转过这山坡，一簇榆林，黑洞洞的，不知里面藏着什么狼虫虎豹。","book":"明·贾仲名《对玉梳》第三折"},"example":{"text":"县长财主，～。","book":"贺敬之、丁毅等《白毛女》第一幕"},"similar":["虎豹狼虫","虎豹豺狼"],"usage":"作主语、宾语、定语；用于书面语"},{"id":31352,"word":"狼贪虎视","pinyin":"láng tān hǔ shì","abbr":"lths","explanation":"象狼一样贪婪，象老虎一样睁大眼睛盯着。比喻野心很大。","source":{"text":"狼贪虎视威风大，镇渔阳兵雄将多。待长驱直把淆函破，奏凯日齐声唱歌。","book":"清·洪昇《长生殿·陷关》"},"example":{"text":"他对此～，我们不能让他得逞。"},"usage":"作谓语、定语；指人贪婪"},{"id":31353,"word":"狼贪鼠窃","pinyin":"láng tān shǔ qiè","abbr":"ltsq","explanation":"如狼那样贪狠；似鼠那样惯窃。常形容敌人贪狠卑鄙。","source":{"text":"瓦刺穷胡真犬豕，敢向边疆挠赤子。狼贪鼠窃去复来，不解偷生求速死。","book":"明·于谦《出塞》诗"},"example":{"text":"一位如此年轻的女子，怎能看得清这～、乱世人间的奇歌异曲呵！","book":"陈复观《上官云珠》十一"},"usage":"作谓语、定语；指贪婪成性"},{"id":31354,"word":"狼顾狐疑","pinyin":"láng gù hú yí","abbr":"lghy","explanation":"指左顾右昐，存有畏惧和犹豫之心。狼顾，狼走路时常常回头看；狐疑，狐狸本性多疑。","source":{"text":"行事或虎头鼠尾，而存心复狼顾狐疑。","book":"孙中山《布告全国同胞书》"},"similar":["犹豫不决"],"usage":"作谓语、定语；用于处事"},{"id":31355,"word":"狼顾虎视","pinyin":"láng gù hǔ shì","abbr":"lghs","explanation":"如狼虎视物。形容威严而凶狠。","source":{"text":"亮身仗强兵，狼顾虎视，五大不在边，臣常危之。","book":"《三国志·蜀志·杨戏传》“亮南征，留邵为治中从事，是岁卒”裴松之注引晋·常璩《华阳国志》"},"similar":["狼顾鸢视"],"usage":"作谓语、定语；用于书面语"},{"id":31356,"word":"狼顾鸢视","pinyin":"láng gù yuān shì","abbr":"lgys","explanation":"如狼鹰视物。形容凶狠而贪婪。","source":{"text":"六七百年之间，强诸侯狼顾鸢视者莫敢先发陵上之言，必至于周礼尽废而后肆，道之化民也。","book":"明·方孝孺《周官》一"},"similar":["狼顾虎视"],"usage":"作谓语、定语；用于书面语"},{"id":31357,"word":"狼顾鸱张","pinyin":"láng gù chī zhāng","abbr":"lgcz","explanation":"如狼凶视，如鸱张翼。形容凶暴，嚣张。","source":{"text":"故推立长乐王子攸以续绝业……然群飞未宁，横流且及，皆狼顾鸱张，岳立基趾。","book":"北魏·杨衒之《洛阳伽蓝记·平等寺》"},"example":{"text":"蛮夷恃险，～。","book":"北周·庚信《周大将军琅琊庄公司马裔墓志铭》"},"similar":["狼突鸱张"],"usage":"作谓语、定语；用于比喻句"},{"id":31358,"word":"狼顾鸱跱","pinyin":"láng gù chī yín","abbr":"lgcz","explanation":"如狼凶视，如鸱峙立。比喻凶暴者伺机欲动。","source":{"text":"明元承运之初，属廓定之始，于时狼顾鸱跱，犹有窥觎，加以天赐之末，内难尤甚。","book":"《北史·魏纪一论》"},"usage":"作谓语、定语；用于比喻句"},{"id":31359,"word":"狼顾鸱踤","pinyin":"láng gù chī yín","abbr":"lgcy","explanation":"如狼凶视，如鸱峙立。比喻凶暴者伺机欲动。","source":{"text":"明元承运之初，属廓定之始，于时狼顾鸱踤，犹有窥觎，加以天赐之末，内难尤甚。","book":"《北史·魏纪一论》"}},{"id":31360,"word":"狼顾麇惊","pinyin":"láng gù jūn jīng","abbr":"lgjj","explanation":"狼顾：狼行走时常回头后顾，比喻后顾之忧；麇：獐子。比喻惊恐万状。","source":{"text":"大王诚纵兵剽系，恐江岭以南，向化心沮，狼顾麇惊。","book":"《新唐书·岑文本传》"},"usage":"作谓语、状语；用于比喻句"},{"id":31361,"word":"狼顾麕惊","pinyin":"láng gù qiān jīng","abbr":"lgjj","explanation":"比喻惊恐万状。","source":{"text":"文本说孝恭曰：‘自隋无道，四海救死，延项以望真主……大王诚纵兵剽系，恐江岭以南，向化心沮，狼顾麕惊。’","book":"《新唐书·岑文本传》"}},{"id":31362,"word":"狼飡虎咽","pinyin":"láng cān hǔ yān","abbr":"lchy","explanation":"形容吃东西又猛又急。同“狼餐虎咽”。"},{"id":31363,"word":"狼飡虎食","pinyin":"láng cān hǔ shí","abbr":"lchs","explanation":"形容吃东西又猛又急。同“狼餐虎咽”。"},{"id":31364,"word":"狼飧虎咽","pinyin":"láng sūn hǔ yàn","abbr":"lshy","explanation":"飧：熟食，饭食。形容吃东西又猛又急。亦作“狼餐虎咽”。","source":{"text":"十人自来吃酒，主人安排些鸡、豚、牛、羊肉来做下酒。须臾之间，狼飨虎咽，算来吃勾有六七十斤的肉，倾尽了六七坛的酒。","book":"明·凌濛初《初刻拍案惊奇》卷三"},"example":{"text":"见他们一个个蹲在地下，吃了个～，沟满壕平。（清·文康《儿女英雄传》第十四回"}},{"id":31365,"word":"狼餐虎咽","pinyin":"láng cān hǔ yàn","abbr":"lchy","explanation":"形容吃东西又猛又急。","source":{"text":"［行者］迎着里面灯光，仔细观看。只见那大小群妖，一个个狼餐虎咽，正都吃东西哩。","book":"明·吴承恩《西游记》第五十二回"},"example":{"text":"老军道：“忒过分了！”父子二人正在饥馁之时，拿起饭来，～，尽情一饱。","book":"明·冯梦龙《醒世恒言》第十卷"},"similar":["狼餐虎噬"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":31366,"word":"狼餐虎噬","pinyin":"láng cān hǔ shì","abbr":"lchs","explanation":"①形容吃东西又猛又急。同“狼餐虎咽”。②比喻残酷剥削搜括。","source":{"text":"你道因何封我做净盘将军，若有人请我到的酒席上，且不吃酒，将各样好下饭，狼餐虎噬，则一顿都噻了，方才吃酒，以此号为净盘将军。","book":"元·无名氏《小尉迟》第一折"},"example":{"text":"若辈埋头地狱，枵腹垂千百年，今一得志，必至～，生灵无噍类矣！","book":"清·沈起凤《谐铎·森罗殿点鬼》"},"similar":["狼吞虎咽","狼餐虎咽"],"usage":"作宾语、定语、状语；用于比喻句","story":["阎王殿又开始进行例行清点，判官拿起鬼名册进行饿鬼清点，马上一鬼头跑来禀报：“前鬼门关守者，失于防检，诸饿鬼乘机逃去阳世偷生。”阎王问他们在阳世做什么。鬼头禀报说做县令。阎王感慨说：“这些饿鬼今一得志就会狼餐虎噬地残害人们。”"]},{"id":31367,"word":"狼餐虎食","pinyin":"láng cān hǔ shí","abbr":"lchs","explanation":"形容吃东西又猛又急。","source":{"text":"阮家三兄弟让吴用吃了几块，便吃不得了；那三个狼餐虎食，吃了一回。","book":"明·施耐庵《水浒传》第15回"},"similar":["狼吞虎咽"],"usage":"作谓语、定语、状语；用于人的吃相"},{"id":31368,"word":"猕猴骑土牛","pinyin":"mí hóu qí tǔ niú","abbr":"mhqtn","explanation":"比喻职位提升很慢。","source":{"text":"君，名公之子，少有文采，故守吏职；猕猴骑土牛，又何迟也。","book":"南朝·宋·刘义庆《世说新语》"},"example":{"text":"～，羸马夹双辕。","book":"唐·李白《赠宣城赵太守悦》"},"usage":"作宾语、定语；指升级慢"},{"id":31369,"word":"猖獗一时","pinyin":"chāng jué yī shí","abbr":"cjys","explanation":"猖獗：凶猛而放肆。形容坏人或反动势力一时间显得特别凶猛放肆。","source":{"text":"曾经猖獗一时的法西斯党徒及其第五纵队的死期是一天一天逼近了。","book":"周恩来《在延安欢迎会上的演说》"},"example":{"text":"敌人现在也只是～罢了。"},"similar":["嚣张一时"],"opposite":["风平浪静"],"usage":"作谓语、定语；指坏势力"},{"id":31370,"word":"猗欤休哉","pinyin":"yī yú xiū zāi","abbr":"yyxz","explanation":"猗欤：叹词，表示赞美；休：美好。多么美好呀！原为古代赞颂的套话，现多含讽刺意味。","example":{"text":"我真是耳目清静，～，到了产生伟大作品的时代。","book":"鲁迅《花边文学·推己及人》"}},{"id":31371,"word":"猗顿之富","pinyin":"yī dùn zhī fù","abbr":"ydzf","explanation":"猗顿：春秋时鲁国人，家境富裕。像猗顿那样富有。泛指拥有巨额财产。","source":{"text":"虽上有天子诸侯之势尊，而下有猗顿、陶朱、卜祝之富，犹失其民人而亡其财资也。","book":"《韩非子·解老》"},"example":{"text":"材能不及中庸，非有仲尼、墨翟之贤，陶朱、～。","book":"汉·贾谊《过秦论》"}},{"id":31372,"word":"猛士如云","pinyin":"měng shì rú yún","abbr":"msry","explanation":"形容猛将非常多。","source":{"text":"华北收复赖群雄，猛士如云唱大风。","book":"朱德《赠友人》"},"similar":["猛将如云"],"usage":"作宾语、定语；用于战争场面等"},{"id":31373,"word":"猛将如云，谋臣似雨","pinyin":"měng jiàng rú yún，móu chén sì yǔ","abbr":"mjrymcsy","explanation":"形容谋士武将非常多，人才济济。","source":{"text":"当此之时，猛将如云，谋臣如雨，然犹七日不食仅乃得免。","book":"汉·李陵《答苏武书》"},"example":{"text":"然则便因你说的他那～，觉得我动不得他？","book":"清·文康《儿女英雄传》第十八回"},"similar":["猛将如云，谋臣如雨"],"usage":"作谓语、定语；用于书面语"},{"id":31374,"word":"猛将如云，谋臣如雨","pinyin":"měng jiàng rú yún，móu chén rú yǔ","abbr":"mjrymcry","explanation":"指文臣武将很多，势力强大。","source":{"text":"与其坐承大统，兵精粮足，手下猛将如云，谋臣如雨。","book":"清·褚人获《隋唐演义》第51回"},"example":{"text":"他的手上真是～呵！","book":"郭沫若《蔡文姬》第二幕"},"similar":["猛将如云，谋臣似雨"],"usage":"作谓语、定语；用于书面语"},{"id":31375,"word":"猛志常在","pinyin":"měng zhì cháng zài","abbr":"mzcz","explanation":"比喻雄心壮志，至死不变。","source":{"text":"刑天舞于戚，猛志固常在。","book":"晋·陶潜《读山海经》诗"},"example":{"text":"而他们犹有豪情似旧时，出关万里，～！","book":"王蒙《狂欢的季节》一"},"usage":"作宾语、定语；指人有大志","story":["晋朝时期，陶渊明读《山海经》后对其中精卫鸟衔枝填海与刑天至死不屈两个故事特别喜欢，他联想到自己的处境，作诗《读山海经》：“精卫衔微木，将以填沧海；刑天舞干戚，猛志固常在。同物既无虑，化去不复悔。徒设在昔心，良晨讵可待。”"]},{"id":31376,"word":"猛虎下山","pinyin":"měng hǔ xià shān","abbr":"mhxs","explanation":"形容勇猛而迅速。","source":{"text":"大有转身作一个‘猛虎下山’之势，劈面扑来，要想杨福一闪，他好乘势翻个跟斗，到杨福后面去。","book":"清·吴趼人《九命奇冤》第26回"},"similar":["猛虎出山"],"usage":"作宾语、定语；用于迅猛"},{"id":31377,"word":"猛虎出山","pinyin":"měng hǔ chū shān","abbr":"mhcs","explanation":"像凶猛的老虎出山一样。形容动作勇猛又快速。亦作“猛虎下山”、“猛虎离山”。","source":{"text":"花腔鼓擂如雷震，御林军展动；罪纣王摧残渐渐，众门人猛虎出山。","book":"明·许仲琳《封神演义》第九十六回"},"example":{"text":"毁公路老百姓暴风卷土，歼敌人八路军～。","book":"刘流《烈火金刚》第二十九回"},"similar":["猛虎下山"],"usage":"作宾语、定语；用于迅猛"},{"id":31378,"word":"猛虎扑食","pinyin":"měng hǔ pū shí","abbr":"mhps","explanation":"老虎扑向食物。比喻动作猛烈而迅速。","source":{"text":"赵子曰放下酒杯，猛虎扑食似的扑出去。","book":"老舍《赵子曰》"},"example":{"text":"他就象～一样，往前窜了两窜，嚓的一下子，也把榴弹甩了出去。","book":"刘流《烈火金刚》第十二回"},"similar":["饿虎扑食"],"usage":"作宾语、定语；形容动作凶猛的样子"},{"id":31379,"word":"猛虎插翅","pinyin":"měng hǔ chā chì","abbr":"mhcc","explanation":"比喻强有力者又添了某种有利条件。","source":{"text":"若得孔明下山，拜为军师，凭着关张雄虎之将，如猛虎插翅。","book":"元·无名氏《博望烧屯》第一折"},"similar":["猛虎添翼"],"usage":"作宾语、定语；指如虎添翼"},{"id":31380,"word":"猛虎深山","pinyin":"měng hǔ shēn shān","abbr":"mhss","explanation":"比喻勇武而势盛。","source":{"text":"猛虎在深山，百兽震恐。","book":"语出汉·司马迁《报任安书》"},"example":{"text":"人民军队犹如～，势不可挡。"},"usage":"作宾语、定语；用于比喻句"},{"id":31381,"word":"猛虎添翼","pinyin":"měng hǔ tiān yì","abbr":"mhty","explanation":"比喻强大者又添了某种有利条件。","source":{"text":"一旦掌握了文化、科学技术的武器，就像猛虎添翼一般。","book":"《人民日报》1964.1.26"},"similar":["猛虎插翅"],"usage":"作宾语、定语；指如虎添翼"},{"id":31382,"word":"猛虎离山","pinyin":"měng hǔ lí shān","abbr":"mhls","explanation":"形容勇猛而迅速。","source":{"text":"那人使动手中双戟，犹如猛虎离山。","book":"清·钱彩《说岳全传》第75回"},"similar":["猛虎出山","猛虎下山"],"usage":"作宾语、定语；用于迅猛"},{"id":31383,"word":"猛风骤雨","pinyin":"měng fēng zhòu yǔ","abbr":"mfzy","explanation":"骤：急速。来势急速而猛烈的大风大雨。","source":{"text":"忽见乌云陡暗，猛风骤雨，冰雹如阵一般打来，打得那些丁夫，跌跌倒倒，往后退避。","book":"清·褚人获《隋唐演义》第33回"},"similar":["急风骤雨","暴风骤雨","狂风暴雨"],"opposite":["和风细雨"],"usage":"作主语、宾语；形容迅疾而猛烈的风雨"},{"id":31384,"word":"猜三划五","pinyin":"cāi sān huà wǔ","abbr":"cshw","explanation":"喝酒时划拳行酒令。","source":{"text":"差人道：‘今日且吃酒，明日再说。’当夜猜三划五，吃了半夜。","book":"清·吴敬梓《儒林外史》第13回"},"similar":["猜拳行令"],"usage":"作谓语、宾语；指行酒令"},{"id":31385,"word":"猜拳行令","pinyin":"cāi quán xíng lìng","abbr":"cqxl","explanation":"划拳行酒令。形容宴饮欢畅。猜拳：饮酒时两人同时伸出手指并说一数，如数与两人伸出手指的总数相符为胜，输者罚酒。","source":{"text":"汪秀才解带脱衣，尽情欢宴，猜拳行令，不存一毫形迹。","book":"明·凌濛初《二刻拍案惊奇》卷二十七"},"example":{"text":"这里摆酒上席，依次坐了。宾主七八个人，～，大盘大碗，吃了个尽兴。","book":"清·吴敬梓《儒林外史》第五十二回"},"similar":["猜枚行令","猜三划五"],"usage":"作谓语、宾语；指行酒令"},{"id":31386,"word":"猜枚行令","pinyin":"cāi méi xíng lìng","abbr":"cmxl","explanation":"猜枚：一种酒令，原指手中握若干小物件供人猜测单双、数目等。现亦指划拳。行令：行酒令。喝酒时行酒令。","source":{"text":"……某已来了也，有酒拿来我先打三钟，然后猜枚行令耍了。","book":"元·无名氏《射柳捶丸》第三折"},"example":{"text":"众人～，耍笑洪堂。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"similar":["猜拳行令"],"usage":"作谓语、宾语、定语；指行酒令"},{"id":31387,"word":"猝不及防","pinyin":"cù bù jí fáng","abbr":"cbjf","explanation":"猝：突然，出其不意。事情来得突然，来不及防备。","source":{"text":"既不炳烛，又不扬声，猝不及防，突然相遇，是先生犯鬼，非鬼犯先生。","book":"清·纪昀《阅微草堂笔记·姑妄听之一》"},"example":{"text":"人踉跄趋入，竟至程都督前，跪将下去，程都督～。","book":"蔡东藩、许廑父《民国通俗演义》第二十七回"},"similar":["措手不及"],"opposite":["防患未然"],"usage":"作谓语、定语、状语；形容事情发生得很突然"},{"id":31388,"word":"猢狲入布袋","pinyin":"hú sūn rù bù dài","abbr":"hsrbd","explanation":"猢狲：猴子。猴子进了口袋。比喻行动失去约束。","source":{"text":"僧曰：‘恁么即学人归堂去也。’师曰：‘猢狲入布袋。’","book":"宋·释道原《景德传灯录》"},"similar":["胡孙入袋"],"usage":"作宾语；指失去自由"},{"id":31389,"word":"猥结蚊聚","pinyin":"wěi jié wén jù","abbr":"wjwj","explanation":"猥：刺猬；猥结：猬毛结集，比喻众多。比喻人众集结。","source":{"text":"故使猥结蚊聚，水草有依。","book":"南朝·梁·任昉《奏弹曹景宗》"},"example":{"text":"设使犬羊之众，～。","book":"宋·李纲《上道君太上皇帝封事》"}},{"id":31390,"word":"猦穅及米","pinyin":"shì kǎn jí mǐ","abbr":"skjm","explanation":"比喻逐步侵蚀渐及全体。"},{"id":31391,"word":"猪八戒吃人参果，全不知滋味","pinyin":"zhū bā jiè chī rén shēn guǒ，quán bù zhī zī wèi","abbr":"zbjcrsgqbzzw","explanation":"比喻吃东西狼吞虎咽，来不及细尝。也比喻看书做事贪多务得，实则无所收获","source":{"text":"你这奴才，‘猪八戒吃人参果，全不知滋味’！","book":"清·吴敬梓《儒林外史》第六回"},"usage":"作宾语、定语；用于比喻句"},{"id":31392,"word":"猪卑狗险","pinyin":"zhū bēi gǒu liǎn","abbr":"zbgx","explanation":"比喻卑鄙阴险的人。","source":{"text":"彬又目禽兽云：‘羊性淫而狠，猪性卑而率，鹅性顽而傲，狗性险而出，皆指斥贵势。’","book":"《南齐书·卡彬传》"},"usage":"作宾语、定语；指小人"},{"id":31393,"word":"猪朋狗友","pinyin":"zhū péng gǒu yǒu","abbr":"zpgy","explanation":"比喻好吃懒做、不务正业的坏朋友。","source":{"text":"担心的是咱爷儿俩辛辛苦苦积攒下来的一份家业，将来不够他跟那些猪朋狗友天天去吃醋溜纹银子！","book":"欧阳山《苦斗》四十四"},"similar":["狐朋狗友"],"usage":"作宾语、定语；用于书面语"},{"id":31394,"word":"猪狗不如","pinyin":"zhū gǒu bù rú","abbr":"zgbr","explanation":"连猪狗都不如。形容人格低下，品行极坏。","source":{"text":"他须纳住气，向连猪狗不如的人说好话。","book":"老舍《四世同堂》"},"example":{"text":"我从来不与～的人交往。"},"similar":["狗彘不若"],"usage":"作谓语、定语；指不通人性"},{"id":31395,"word":"猪突豨勇","pinyin":"zhū tū xī yǒng","abbr":"ztxy","explanation":"豨：野猪。指拼命向前冲，不怕死的人（含贬义）。","source":{"text":"匈奴侵寇甚，莽大寡天下囚徒人奴，名曰猪突豨勇。","book":"《汉书·食货志下》"},"usage":"作宾语、定语；指不怕死的人"},{"id":31396,"word":"猫儿哭鼠","pinyin":"māo ér kū shǔ","abbr":"meks","explanation":"比喻假慈悲，伪装同情。","source":{"text":"你这些怜惜佃户的话，都是猫儿哭鼠。","book":"吴组缃《一千八百担》"},"similar":["猫哭老鼠","猫哭耗子"],"usage":"作宾语、定语；指假慈悲"},{"id":31397,"word":"猫哭老鼠","pinyin":"māo kū lǎo shǔ","abbr":"mkls","explanation":"比喻假慈悲。","source":{"text":"如今又不知那里杀来，又同牛鼻道人在此‘猫儿哭老鼠’，假慈悲。","book":"《说唐》第62回"},"example":{"text":"唯美主义者高举艺术至上的大旗，人道主义者效～的悲叹。","book":"茅盾《我们这文坛》"},"similar":["猫哭耗子"],"usage":"作宾语、定语；指假慈悲"},{"id":31398,"word":"猫哭耗子","pinyin":"māo kū hào zǐ","abbr":"mkhz","explanation":"比喻假慈悲，伪装同情。","source":{"text":"他愤愤地说：‘别样都还罢了，折尾的声明，不是猫哭耗子？’","book":"高阳《清宫外史》上册"},"example":{"text":"高阳《清宫外史》上册：“他愤愤地说：‘别样都还罢了，折尾的声明，不是～？’”"},"similar":["猫哭老鼠"],"usage":"作宾语、定语；指假慈悲"},{"id":31399,"word":"猫噬鹦鹉","pinyin":"māo shì yīng wǔ","abbr":"msyw","explanation":"比喻排挤好人。","source":{"text":"至今蜀人谈谑，以排根善类者为‘猫噬鹦鹉’。","book":"宋·岳珂《桯史·鹦鹉谕》"},"usage":"作宾语、定语；用于比喻句","story":["传说古代有一个爱猫的人，特地选定一个吉日从邻居家买来一只猫，准备用它来捕鼠。结果，老鼠一个没有抓到，猫先撕破鸟笼子，把主人最喜爱的鹦鹉给吃了"]},{"id":31400,"word":"猫鼠同乳","pinyin":"māo shǔ tóng rǔ","abbr":"mstr","explanation":"比喻官吏失职，包庇下属干坏事。也比喻上下狼狈为奸。同“猫鼠同眠”。","source":{"text":"天宝元年十月，魏郡猫鼠同乳。同乳者，甚于同处。","book":"《新唐书·五行志一》"},"similar":["猫鼠同处"],"usage":"作宾语、定语；比喻上下狼狈为奸"},{"id":31401,"word":"猫鼠同处","pinyin":"māo shǔ tóng chǔ","abbr":"mstc","explanation":"比喻官吏失职，包庇下属干坏事。也比喻上下狼狈为奸。同“猫鼠同眠”。","source":{"text":"龙朔元年十一月，洛州猫鼠同处。鼠隐伏象盗窃，猫职捕啮，而反与鼠同，象司盗者废职容奸。","book":"《新唐书·五行志一》"},"similar":["猫鼠同眠","猫鼠同乳"],"usage":"作宾语、定语；比喻上下狼狈为奸"},{"id":31402,"word":"猫鼠同眠","pinyin":"māo shǔ tóng mián","abbr":"mstm","explanation":"猫同老鼠睡在一起。比喻官吏失职，包庇下属干坏事。也比喻上下狼狈为奸。","source":{"text":"龙朔元年十一月，洛州猫鼠同处。鼠隐伏，象盗窃；猫职捕啮，而反与鼠同，象司盗者废职容奸。","book":"《新唐书·五行志》"},"example":{"text":"都是谗言佞言，一个个～。","book":"明·李开先《林冲宝剑记》第六出"},"similar":["狼狈为奸","沆瀣一气"],"usage":"作宾语、定语；比喻上下狼狈为奸"},{"id":31403,"word":"猬结蚁聚","pinyin":"wèi jié yǐ jù","abbr":"wjyj","explanation":"猬：刺猬；猬结：猬毛结集，比喻众多。比喻人众集结。","source":{"text":"故使猬结蚁聚，水草有依。","book":"南朝·梁·任昉《奏弹曹景宗》"},"example":{"text":"设使犬羊之众，～。","book":"宋·李纲《上道君太上皇帝封事》"},"usage":"作宾语、定语；比喻人多"},{"id":31404,"word":"猬起鸡连","pinyin":"wèi qǐ jī lián","abbr":"wqjl","explanation":"猬：刺猬。猬毛纷纷而起，鸡声相连不断。比喻彼此串连，蠢蠢欲动。","source":{"text":"大和纪元，沧景不虔，子弄父兵，跳跟海适，有邻阴交，猬起鸡连。","book":"唐·刘禹锡《唐故岎宁节度使史公神道碑》"},"usage":"作定语；用于书面语"},{"id":31405,"word":"猬锋螗斧","pinyin":"wèi fēng táng fǔ","abbr":"wftf","explanation":"猬锋：刺猬的毛；螗斧：螳螂的前腿。比喻微弱的力量。","source":{"text":"猬锋螗斧，潢池盗弄，何以哉！","book":"清·纪昀《阅微草堂笔记·滦阳续录》"},"usage":"作宾语、定语；用于比喻句"},{"id":31406,"word":"献可替不","pinyin":"xiàn kě tì fǒu","abbr":"xktb","explanation":"献：进，提出；可：正确的；替：废，更换；不：通“否”，错误的。指劝善归过，提出兴革的建议。","source":{"text":"但今与古殊，时有监抚之务，竟不能绌邪进善，少助国章，献可替不，仰裨圣政。","book":"南朝·梁·简文帝《答徐摛书》"},"similar":["献可替否","献替可否"],"usage":"作谓语、定语；指提出兴革的建议"},{"id":31407,"word":"献可替否","pinyin":"xiàn kě tì fǒu","abbr":"xktf","explanation":"献：进；替：废。指劝善归过，提出兴革的建议。","source":{"text":"君所谓可，而有否焉，臣献其否，以成其可；君所谓否，而有可焉，臣献其可，以去其否。","book":"春秋·鲁·左丘明《左传·昭公二十年》"},"example":{"text":"臣闻君以兼览博照为德，臣以～为忠。","book":"南朝·宋·范晔《后汉书·胡广传》"},"similar":["献可替不"],"usage":"作谓语、定语；指提出兴革的建议"},{"id":31408,"word":"献曝之忱","pinyin":"xiàn pù zhī chén","abbr":"xpzc","explanation":"献：贡献之意；曝：晒太阳。比喻以物品或意见献之于人，所表达的自谦之意。","source":{"text":"负日之暄，人莫知者，以献吾君，将有重赏。","book":"《列子·杨朱篇》"},"example":{"text":"这些浅见，表示我一点“～”，请你参考。"},"similar":["田父献曝"],"usage":"作宾语；用于自谦","story":["战国时期，宋国有一个没有见过世面的农夫，由于家贫终日穿一件粗麻衣，勉强过冬。第二年春天，天气晴朗，他就脱光衣服在太阳下曝晒，觉得十分舒服，由于没有见过漂亮的皮衣和高大的房子，就对妻子说将把这取暖的办法进献给国王"]},{"id":31409,"word":"献替可否","pinyin":"xiàn tì kě fǒu","abbr":"xtkf","explanation":"指劝善归过，提出兴革的建议。同“献可替否”。","source":{"text":"掌献替可否，奉陈规诲。","book":"《明史·职官志》"},"similar":["献可替否","献可替不"],"usage":"作谓语、定语；指提出兴革的建议"},{"id":31410,"word":"献计献策","pinyin":"xiàn jì xiàn cè","abbr":"xjxc","explanation":"主动为别人出谋划策。","source":{"text":"夫子又实在不会说话，无以自辩，只好为季府田赋增税，献计献策，算是弥补过错。","book":"钱宁《圣人》第26章"},"similar":["出谋划策"],"usage":"作谓语、定语、宾语；指为人想办法"},{"id":31411,"word":"献酬交错","pinyin":"xiàn chóu jiāo cuò","abbr":"xcjc","explanation":"献：敬酒；酬：劝酒。形容欢聚宴饮的情景。","source":{"text":"为宾为客，献酬交错。","book":"《诗经·小雅·楚茨》"},"example":{"text":"乐声竞奏，水陆并陈。文官武将轮次把盏，～。","book":"明·罗贯中《三国演义》第五十六回"},"similar":["觥筹交错"],"usage":"作谓语、定语；用于书面语"},{"id":31412,"word":"猱搔虎痒","pinyin":"náo sāo hǔ yǎng","abbr":"nshy","explanation":"猱：猴。猱替老虎搔痒。形容表面曲意奉承，暗箭伤人。","source":{"text":"虎首痒，则使猱爬搔之。不休，成穴，虎殊快不觉也。","book":"《贤弈编》"},"example":{"text":"～之类的小人难以对付。"},"usage":"作宾语、定语；指小人行径","story":["老虎头顶发痒，就叫猱替它搔。猱搔个不停，抓成了一个小洞，老虎感到特别舒服而未觉察。猱便悄悄从洞中汲取老虎的脑浆吃，并把一些分给老虎吃。老虎十分得意猱很忠诚，时间久了，老虎的脑浆快吃空了，疼痛难忍，而猱早爬到很高的树上去了"]},{"id":31413,"word":"猴头猴脑","pinyin":"hóu tóu hóu nǎo","abbr":"hthn","explanation":"像猴子那样好动，形容行动浮躁。","example":{"text":"这孩子一点规矩也不懂，猴头猴脑的。"},"opposite":["虎头虎脑"],"usage":"作定语；用于儿童"},{"id":31414,"word":"猴子搏矢","pinyin":"hóu zǐ bó shǐ","abbr":"hzbs","explanation":"形容喜欢卖弄小聪明的人容易上当。","source":{"text":"王射之，敏给搏捷矢。王命相者趋射，狙执死。","book":"战国·宋·庄周《庄子·徐无鬼》"},"usage":"作宾语、定语；指好表现的人没好下场","story":["吴王乘船到长江沿岸的一座猴山游玩，很多猴子见人来了就害怕地逃跑，惟独一只猴子从容不迫地跳来跳去，在吴王面前表现它的灵巧，吴王拿起弓箭射它，它灵巧接住了箭。吴王命令助手们齐射，那只想表现的猴子最终给射杀了"]},{"id":31415,"word":"猴子救月","pinyin":"hóu zǐ jiù yuè","abbr":"hzjy","explanation":"形容没事找事，结果自己反而受到伤害。","source":{"text":"连猕猴重，树弱枝折，一切猕猴堕井水中。","book":"《法苑珠林·愚赣篇·杂痴部》"},"example":{"text":"～等于杞人忧天。"},"similar":["猴子捞月"],"usage":"作宾语、定语；指自作聪明","story":["古时伽尸国有座波罗奈城，在人迹稀少的树林中生活着500只猕猴。一次猕猴在一棵尼俱律树下，见月影在井里的水面摇晃。他们担心世界夜晚会失去光明，就一只一只倒挂连接在树枝上去井中救月。由于太重，树枝折断，群猴全部落水"]},{"id":31416,"word":"猴年马月","pinyin":"hóu nián mǎ yuè","abbr":"hnmy","explanation":"猴、马：十二生肖之一。泛指未来的岁月。","example":{"text":"你这样下去，猴年马月才能完成。"},"similar":["遥遥无期"],"opposite":["指日可待"],"usage":"作状语；指未来的岁月"},{"id":31417,"word":"猿啼鹤唳","pinyin":"yuán tí hè lì","abbr":"ythl","explanation":"猿和鹤凄厉地啼叫。","source":{"text":"两崖分虎踞龙盘，四面有猿啼鹤唳。","book":"明·施耐庵《水浒传》第五十三回"},"similar":["猿啼鹤怨","猿惊鹤怨","猿悲鹤怨"],"usage":"作宾语、定语；用于书面语"},{"id":31418,"word":"猿啼鹤怨","pinyin":"yuán tí hè yuàn","abbr":"ythy","explanation":"猿和鹤凄厉地啼叫。","source":{"text":"听得猿啼鹤怨，泪湿征袍如汗。","book":"明·汤显祖《牡丹亭·御淮》"},"similar":["猿啼鹤唳","猿惊鹤怨","猿悲鹤怨"],"usage":"作宾语、定语；用于书面语"},{"id":31419,"word":"猿悲鹤怨","pinyin":"yuán bēi hè yuàn","abbr":"ybhy","explanation":"猿和鹤凄厉地啼叫。","source":{"text":"猿悲鹤怨因何事？只恐先生袖手归。","book":"宋·朱熹《送籍溪胡丈赴馆供职》诗之二"},"similar":["猿啼鹤唳","猿啼鹤怨","猿惊鹤怨"],"usage":"作宾语、定语；用于书面语"},{"id":31420,"word":"猿惊鹤怨","pinyin":"yuán jīng hè yuàn","abbr":"yjhy","explanation":"猿和鹤凄厉地啼叫。","source":{"text":"猿惊鹤怨草三尺，楚尾吴头天一方。","book":"宋·王阮《秋日寄舍弟》诗"},"similar":["猿啼鹤唳","猿悲鹤怨","猿啼鹤怨"],"usage":"作宾语、定语；用于书面语"},{"id":31421,"word":"猿猴取月","pinyin":"yuán hóu qǔ yuè","abbr":"yhqy","explanation":"比喻愚昧无知。也比喻白费力气。","source":{"text":"镜里拈花，水中捉月，觑着无由得近伊。","book":"宋·黄庭坚《沁园春》词"},"example":{"text":"～的故事滑稽可笑。"},"usage":"作宾语、定语；指白费力气","story":["传说古代波罗奈城有五百猕猴，有一天五百猕猴游行林中，见树下井中有月亮的倒影，猕猴王就对所有的猕猴说：“今天月亮掉到井里，我们大家得想办法捞出来挂到天上去。”于是这些猴子就在树一只接一只地往井中延伸，结果树枝断，全部落井"]},{"id":31422,"word":"猿穴坏山","pinyin":"yuán xué huài shān","abbr":"yxhs","explanation":"比喻小事不注意，就会造成大灾祸。","source":{"text":"河溃蚁孔端，山坏由猿穴。","book":"汉·孔融《临终》诗"},"example":{"text":"～并不耸人听闻。"},"similar":["蚁穴溃堤"],"usage":"作主语、宾语、定语；用于劝诫人"},{"id":31423,"word":"猿臂之势","pinyin":"yuán bì zhī shì","abbr":"ybzs","explanation":"猿猴的臂长且灵敏，能运用自如。比喻作战形势能攻能守，可进可退。","source":{"text":"若移军河阳，北阻泽潞、三城以抗，胜则擒之，败则自守，表里相应，使贼不敢西侵，此则猿臂之势也。","book":"《旧唐书·李光弼传》"},"usage":"作宾语；用于书面语"},{"id":31424,"word":"猿藏熊缘","pinyin":"yuán cáng xióng yuán","abbr":"ycxy","explanation":"猿藏：猿藏身之处；熊缘：熊不舍离开的地方。指猿和熊的巢穴。","source":{"text":"随樵劫猿藏，隈石觑熊缘。","book":"唐·段成式《隐山书事》"},"usage":"作宾语、定语；用于书面语"},{"id":31425,"word":"猿鹤沙虫","pinyin":"yuán hè shā chóng","abbr":"yhsc","explanation":"指阵亡的将士或死于战乱的人民。","source":{"text":"山徙社移，三军之众，一朝尽化，君子为鹤，小人成沙。","book":"《艺文类聚》卷九十引晋葛洪《抱朴子》：“周穆王南征，一军尽化，君子为猿为鹤，小人为虫为沙。”按，今本《抱朴子·释滞》作"},"example":{"text":"你看山川图画，人物衣冠，生聚年时久，忍下得咸阳一炬里变焦丘，～满地愁。","book":"清·杨潮观《下江南曹彬誓众》"},"similar":["猿鹤虫沙"],"usage":"作主语、宾语；比喻战死的将士"},{"id":31426,"word":"猿鹤虫沙","pinyin":"yuán hè chóng shā","abbr":"yhcs","explanation":"旧时比喻战死的将士。也指死于战乱的人。","source":{"text":"周穆王南征，一军尽化，君子为猿为鹤，小人为虫为沙。","book":"晋·葛洪《抱朴子》"},"example":{"text":"莫嫌歌哭太无端，～幻百般。","book":"刘复《癸丑初闻南北战争感赋》"},"similar":["猿鹤沙虫"],"usage":"作主语、宾语；比喻战死的将士"},{"id":31427,"word":"獐头鼠目","pinyin":"zhāng tóu shǔ mù","abbr":"ztsm","explanation":"像袋象獐子那样又小又尖，眼睛像老鼠那样又小又圆。形容人相貌丑陋，神情狡滑。","source":{"text":"龙章凤姿之士不见用，獐头鼠目之子乃求官。","book":"《旧唐书·李揆传》"},"example":{"text":"见那些童生纷纷进来，也有小的，也有老的，仪表端庄的，～的，衣冠齐楚的，蓝缕破烂的。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["贼眉鼠眼","其貌不扬","面目可憎"],"opposite":["眉清目秀","花容月貌"],"usage":"作谓语、定语；指人的长相"},{"id":31428,"word":"獐麇马鹿","pinyin":"zhāng jūn mǎ lù","abbr":"zjml","explanation":"比喻举动匆忙慌乱的人。","source":{"text":"杭州人言举止仓皇者曰獐麇马鹿，盖四物善骇，见人则跳跃自窜。","book":"《西湖志余》卷二十五"},"usage":"作宾语、定语；指四种动物"},{"id":31429,"word":"玄之又玄","pinyin":"xuán zhī yòu xuán","abbr":"xzyx","explanation":"原为道家语，形容道的微妙无形。后多形容非常奥妙，不易理解。","source":{"text":"玄之又玄，众妙之门。","book":"《老子》第一章"},"example":{"text":"第六客是～的鬼学家。","book":"刘半农《作揖主义》"},"usage":"作谓语、定语；指事理非常奥妙"},{"id":31430,"word":"玄关妙理","pinyin":"xuán guān miào lǐ","abbr":"xgml","explanation":"玄关：佛教称入道之门。指佛门深奥微妙的道理。","source":{"text":"玄关妙理，世人不解其中意。","book":"元·无名氏《南极登仙》第二折"},"usage":"作宾语、定语；用于书面语"},{"id":31431,"word":"玄圃积玉","pinyin":"xuán pǔ jī yù","abbr":"xpjy","explanation":"传说玄圃多美玉。故以之比喻精华荟萃。","source":{"text":"葛洪著书称机文，犹玄圃之积玉，无非夜光焉。","book":"《晋书·陆机传》"},"example":{"text":"南朝·梁·庾肩吾《书品论》后序：“今以九例该此众贤，犹如～，炎洲聚桂。”"},"usage":"作宾语、定语；用于比喻句"},{"id":31432,"word":"玄妙入神","pinyin":"xuán miào rù shén","abbr":"xmrs","explanation":"形容技艺学问已进入高超而神奇的境界。","source":{"text":"名贯京师，凡为调曲，尽声韵，玄妙入神，成一家艺。","book":"元·明善《张淳传》"},"usage":"作谓语、定语；用于书面语"},{"id":31433,"word":"玄妙无穷","pinyin":"xuán miào wú qióng","abbr":"xmwq","explanation":"指神奇奥妙，无法穷尽。","source":{"text":"详观阵图，玄妙无穷，或者三关杨郡马识之，其他将帅，无有能识之者。","book":"明·熊大木《杨家将演义》第二十五回"},"example":{"text":"中医，虽然有人说是～，内科尤为独步，我可总是不相信。","book":"鲁迅《华盖集续编·马上日记》"},"similar":["玄妙莫测"],"usage":"作谓语、定语；用于书面语"},{"id":31434,"word":"玄妙莫测","pinyin":"xuán miào mò cè","abbr":"xmmc","explanation":"测：猜度。神奇奥妙，无法猜度。亦作“玄妙无穷”。","source":{"text":"此人天文地理，六韬三略，无不精通，行兵列阵，玄妙莫测，乃智勇兼全之士。","book":"明·无名氏《杨家将演义》第四回"},"usage":"作谓语、定语；用于书面语"},{"id":31435,"word":"玄机妙算","pinyin":"xuán jī miào suàn","abbr":"xjms","explanation":"玄机：玄秘的机关；妙算：神妙的推算。指神妙莫测的计谋。","source":{"text":"运督军需，智擒法戒。玄机妙算，奇功莫大！","book":"明·许仲琳《封神演义》第七十九回"},"usage":"作宾语、定语；用于书面语"},{"id":31436,"word":"玄衣督邮","pinyin":"xuán yī dū yóu","abbr":"xydy","explanation":"督邮：官名。龟的别称","source":{"text":"龟名玄衣督邮，鳖名河伯从事。","book":"晋·崔豹《古今注·鱼龟》"},"example":{"text":"明·李时珍《本草纲目·介部·水龟》：“（释名）：～。”"},"usage":"作主语、宾语、定语；指龟"},{"id":31437,"word":"玄裳缟衣","pinyin":"xuán cháng gǎo yī","abbr":"xsgy","explanation":"黑色的裙，白色的上衣。用以指鹤。","source":{"text":"翅如车轮，玄裳缟衣，戛然长鸣。","book":"宋·苏轼《后赤壁赋》"},"example":{"text":"红溅了～，那怕你竖飞横飞，耸身追赶肯稽迟。","book":"清·方成培《雷峰塔》第十七出"}},{"id":31438,"word":"玄谋庙算","pinyin":"xuán móu miào suàn","abbr":"xmms","explanation":"玄谋：神妙的计策；庙算：庙堂上的筹划。指朝廷的重大决策和谋略。","source":{"text":"公躬擐甲胄，龚行天罚，玄谋庙算，遵养时晦。","book":"《晋书·文帝纪》"},"usage":"作宾语、定语；用于书面语"},{"id":31439,"word":"玄辞冷语","pinyin":"xuán cí lěng yǔ","abbr":"xcly","explanation":"玄妙冷隽的言辞。","source":{"text":"玄辞冷语，用以博见闻资谈笑而已，奚史哉？","book":"明·文璧《序》"},"usage":"作主语、宾语、定语；指文章或说话"},{"id":31440,"word":"玄酒瓠脯","pinyin":"xuán jiǔ hù fǔ","abbr":"xjhp","explanation":"饮食只有清水和瓠干。比喻生活清苦。","source":{"text":"厥客伊何？许由巢父。厥醴伊何？玄酒瓠脯。","book":"晋·程晓《赠傅休奕》诗"},"usage":"作宾语、定语；指生活清苦"},{"id":31441,"word":"玄香太守","pinyin":"xuán xiāng tài shǒu","abbr":"xxts","explanation":"太守：官名。墨汁的别称","source":{"text":"薛稷为墨封九锡，拜松烟督护，玄香太守，兼亳州诸郡平章事。","book":"《纂异记》"},"usage":"作主语、宾语、定语；指墨汁"},{"id":31442,"word":"玄黄翻覆","pinyin":"xuán huáng fān fù","abbr":"xhff","explanation":"玄黄：天地之色。天翻地覆。形容动乱极大。","source":{"text":"夫玄黄者，天地之杂也，天玄而地黄。","book":"《周易·坤》"},"usage":"作宾语、定语；用于书面语"},{"id":31443,"word":"率以为常","pinyin":"shuài yǐ wéi cháng","abbr":"sywc","explanation":"指成为经常的事。","source":{"text":"骑马囊饭，朝往夕还，率以为常，而山外事一毫不接耳目矣。","book":"《北齐书·司马子如传》：“及其当还, 高祖及武明后俱有赉遗，率以为常。”宋·文天祥《与朱太博埴》"},"example":{"text":"由此蹈隙相会，～。 ◎清·王韬《凇滨琐话·魏月波》"}},{"id":31444,"word":"率兽食人","pinyin":"shuài shòu shí rén","abbr":"sssr","explanation":"率：带领。带着野兽来吃人。比喻统治者虐害人民。","source":{"text":"庖有肥肉，厩有肥马，民有饥色，野有饿莩，是率兽而食人也。","book":"《孟子·梁惠王上》"},"example":{"text":"日易姓改号，谓之亡国；仁义充塞，而至于～，人将相食，谓之亡天下。 ◎章炳麟《革命之道德》"},"usage":"紧缩式；作谓语、定语；比喻统治者虐政害民"},{"id":31445,"word":"率土之滨","pinyin":"shuài tǔ zhī bīn","abbr":"ltzb","explanation":"沿着王土的边涯。犹言普天之下，四海之内。","source":{"text":"臣闻天道无私，所以运行寒暑，圣人有作，所以恭授民时，聿令率土之滨，共乐同文之化。","book":"《诗经·小雅·北山》：“普天之下，莫非王土，率土之滨，莫非王臣。”宋·王禹偁《谢历日表》"},"example":{"text":"纷纷战国尚尊周，五霸争强作列侯，～承治化，威名耿耿壮春秋。 ◎元·郑光祖《智勇定齐》第一折"}},{"id":31446,"word":"率土同庆","pinyin":"shuài tǔ tóng qìng","abbr":"sttq","explanation":"犹言普天同庆。天下的人或全国的人共同庆祝。","source":{"text":"臣某言：伏奉七月十三日制书，大赦天下，跪捧宣布，蹈舞欢呼，自天降休，率土同庆。","book":"唐·白居易《贺上尊号后大赦天下表》"}},{"id":31447,"word":"率土宅心","pinyin":"shuài tǔ zhái xīn","abbr":"stzx","explanation":"率土：四海之內。宅心：归心。指天下归心。","source":{"text":"威惠外宣，德行内敏，群后归美，率土宅心，可立纲为皇太子。","book":"《晋书·后妃传下》：“领司徒蔡谟等上奏曰：‘嗣皇诞哲岐嶷, 继承天统，率土宅心，兆庶蒙赖。’”南朝·梁武帝《立晋安王纲为皇太子诏》"}},{"id":31448,"word":"率土归心","pinyin":"shuài tǔ guī xīn","abbr":"stgx","explanation":"率土：四海之內。指天下归心。同“率土宅心”。","source":{"text":"故百僚师师，朝无秕政，网疏泽洽，率土归心。","book":"《北齐书·文宣帝纪》"},"example":{"text":"且殿下收召才杰，意从人望，子惠黎庶，～。 ◎《元史·廉希宪传》"}},{"id":31449,"word":"率尔成章","pinyin":"shuài ěr chéng zhāng","abbr":"secz","explanation":"率尔：不经思索，随意地。不加思索，下笔成文。形容写文章粗疏草率，不认真。","source":{"text":"诗云：‘书后欲题三百颗，洞庭须待满林霜。’后人多说率尔成章，不知江左尝有人于纸尾寄洞庭霜三百颗。","book":"宋·王谠《唐语林·文学》"},"example":{"text":"［白居易］又有句云：‘回首语秋光，东来应不错。’人谓先生～，予谓先生的然有理。 ◎宋·胡仔《苕溪渔隐丛话后集·醉吟先生》"}},{"id":31450,"word":"率尔操觚","pinyin":"shuài ér cāo gū","abbr":"secg","explanation":"觚：方木，古人用它来书写。率尔：不加思索；操觚：指作文。原形容文思敏捷，后指没有慎重考虑，轻率地写。","source":{"text":"或操觚以率尔，或含毫而邈然。","book":"晋·陆机《文赋》"},"example":{"text":"望谿文最讲义法，而叙事颇沿俗称，不免～，以此为后人弹射。 ◎清·平步清《霞外捃屑》卷七"},"usage":"联合式；作谓语、宾语；形容文思敏捷"},{"id":31451,"word":"率性任意","pinyin":"shuài xìng rèn yì","abbr":"sxry","explanation":"率：随顺。随顺其本性，听任其心意。指任着自己的本性做去而不加约束。","source":{"text":"或食柏叶，饮水自给，不嗜五谷。父母怜之，听其率性任意。","book":"宋·张君房《云笈七签》卷一百十六"},"similar":["顺其自然"],"usage":"作谓语、定语；指顺其自然"},{"id":31452,"word":"率由旧则","pinyin":"shuài yóu jiù zé","abbr":"syjz","explanation":"率：遵循；旧则：老法规。完全依循旧规办事。同“率由旧章”。","source":{"text":"万邦既化，率由旧则。","book":"《三国志·魏书·任城陈萧王传》"},"example":{"text":"高祖稽古，～，斟酌前王，择其令典，朝章国范，焕乎复振。 ◎《魏书·礼志一》"}},{"id":31453,"word":"率由旧章","pinyin":"shuài yóu jiù zhāng","abbr":"syjz","explanation":"率：遵循；旧章：老法规。一切按照老规矩办事。","source":{"text":"不愆不忘，率由旧章。","book":"《诗经·大雅·假乐》"},"example":{"text":"他果然听了姚老先生之言，诸事～，不敢聚行更动。 ◎清·李宝嘉《文明小史》第一回"},"similar":["因循守旧","墨守成规"],"opposite":["除旧布新","推陈出新"],"usage":"动宾式；作谓语；用于没有创新"},{"id":31454,"word":"率马以骥","pinyin":"shuài mǎ yǐ jì","abbr":"smyj","explanation":"用好马带领马群。比喻能者居先。","source":{"text":"或曰：‘治己以仲尼，仲尼奚寡也？’曰：‘率马以骥，不亦可乎？’","book":"汉朝扬雄《法言·修身》"},"usage":"复句式；作谓语；比喻以贤者为众人表率"},{"id":31455,"word":"玉不琢，不成器","pinyin":"yù bù zhuó，bù chéng qì","abbr":"ybzbcq","explanation":"琢：雕。玉石不经雕琢，成不了器物。比喻人不受教育、不学习就不能有成就。","source":{"text":"玉不琢，不成器，人不学，不知道。","book":"《礼记·学记》"},"example":{"text":"但无一个名师点拨，这叫做“～”。","book":"清·钱彩《说岳全传》第四回"},"usage":"作宾语、定语、分句；借指人"},{"id":31456,"word":"玉人吹箫","pinyin":"yù rén chuī xiāo","abbr":"yrcx","explanation":"比喻男女相慕相爱。","source":{"text":"二十四桥明月夜，玉人何处教吹箫。","book":"汉·刘向《列女传》；唐·杜牧《寄扬州韩绰判官》"},"example":{"text":"若作草木凋，则与“青山明月”、“～”不是一套事矣。","book":"明·杨慎《升庵诗话》卷八"}},{"id":31457,"word":"玉佩琼琚","pinyin":"yù pèi qióng jū","abbr":"ypqj","explanation":"玉佩：玉做的佩饰。琼琚：赤玉做的佩饰。①泛指玉制的佩饰。②对诗文作品的美称。","source":{"text":"玉佩琼琚，大放厥词。","book":"唐·韩愈《祭柳子厚文》"},"example":{"text":"有美人兮，～，吾梦见之。","book":"宋·辛弃疾《沁园春》词"}},{"id":31458,"word":"玉兔银蟾","pinyin":"yù tù yín chán","abbr":"ytyc","explanation":"传说月亮中有广寒宫，宫中有玉兔和银蟾。故以此比喻天上的明月。","source":{"text":"照他几许人肠断，玉兔银蟾远不知。","book":"唐·白居易《中秋月》"},"example":{"text":"～休道远，不识愁人情切。","book":"宋·秦观《念奴娇》词"},"usage":"作宾语、定语；用于书面语"},{"id":31459,"word":"玉关人老","pinyin":"yù guān rén lǎo","abbr":"ygrl","explanation":"借指久戍思归之情。","source":{"text":"[挺]在渭久，郁郁不自聊，寓意词曲，有‘玉关人老’之叹。","book":"《后汉书·班超传》载：班超戍守西域，凡三十一年。年老思归，上和帝疏云：“臣不敢望到酒泉郡，但原生入玉门关。”《宋史·蔡挺传》"},"example":{"text":"公守边，内则能固吾圉，外则使裔夷归心，羊陆见称，徒以此耳。但～，不容不丞召归，伏惟与时御宜，促装以俟。","book":"宋·张孝祥《与杨抑之书》"},"usage":"作宾语、定语；用于书面语","story":["西汉时期，大将军班超奉命驻守西域边关，抵御匈奴等入侵，守边关31年，匈奴闻之胆颤心寒，不敢冒然出兵。班超年迈，思念中原的家人，于是上书汉和帝说：“臣不敢望到酒泉郡，但愿生入玉门关。”汉和帝于是下诏召他回乡养老"]},{"id":31460,"word":"玉减香消","pinyin":"yù jiǎn xiāng xiāo","abbr":"yjxx","explanation":"香、玉：旧诗文中美女的代称；消、减：消瘦。比喻美女日渐消瘦。","source":{"text":"唱道是废寝忘飧，玉减香消。","book":"元·商衢《新水令》"},"example":{"text":"旧时容貌，到如今～，无聊。","book":"明·无名氏《南牢记》第二折"},"similar":["玉减香销"],"usage":"作谓语、定语；用于书面语"},{"id":31461,"word":"玉减香销","pinyin":"yù jiǎn xiāng xiāo","abbr":"yjxx","explanation":"比喻美人的消瘦、萎靡。","source":{"text":"玉减香销，被婵娟误我，临镜装慵。","book":"宋·张先《汉宫春》词"},"example":{"text":"暗朱箔，雨寒风峭，试罗衣～。","book":"元·任昱《红绣鞋·春情》曲"},"similar":["玉减香消"],"usage":"作谓语、定语；用于书面语"},{"id":31462,"word":"玉匣珠襦","pinyin":"yù xiá zhū rú","abbr":"yxzr","explanation":"玉匣：汉代皇帝的葬具，即玉衣；珠襦：用珠缀串成的短衣。指古代帝后诸侯王的葬服。","source":{"text":"汉帝送死皆珠襦玉匣，匣形如铠甲，连以金镂，武帝匣上皆镂为蛟龙鸾凤龟龙之象，世谓为蛟龙玉匣。","book":"晋·葛洪《西京杂记》卷一"},"example":{"text":"～连岁事，茂陵应长并头花。","book":"清·吴伟业《读史八首》其二"},"usage":"作主语、宾语；用于书面语"},{"id":31463,"word":"玉卮无当","pinyin":"yù zhī wú dàng","abbr":"yzwd","explanation":"卮：古代盛酒的器皿；当：底。玉杯没有底。后比喻事物华丽而不合实用。","source":{"text":"为人主而漏其君臣之语，譬犹玉卮之无当。","book":"《韩非子·外储说右上》"},"example":{"text":"不涉笔，则通篇之文如～，玉盘缺角。","book":"清·恽敬《答伊扬州书三》"},"usage":"作定语；指中看不中用"},{"id":31464,"word":"玉友金昆","pinyin":"yù yǒu jīn kūn","abbr":"yyjk","explanation":"友、昆：指兄弟。对他人兄弟的美称。","source":{"text":"辛攀，字怀远，陇西狄道人也。兄鉴旷，弟宝迅，皆以才识著名。秦、雍为之谚曰：‘三龙一门，金友玉昆。’","book":"北朝·魏·崔鸿《十六国春秋·前凉录·辛攀》"},"example":{"text":"我来经览浑如昨，～念离索。","book":"宋·刘子翚《观二刘题壁》诗"},"similar":["金友玉昆","玉昆金友"],"usage":"作主语、宾语、定语；称赞别人"},{"id":31465,"word":"玉叶金枝","pinyin":"yù yè jīn zhī","abbr":"yyjz","explanation":"封建时代称皇家后裔。","source":{"text":"胡蝶、胡蝶，飞上金枝玉叶。","book":"晋·崔豹《古今注·舆服》：“与蚩尤战于涿鹿之野，常有五色云气金枝玉叶止于帝上。”唐·王建《宫中调笑》词"},"example":{"text":"若是俺到宫时，和您去对情词，使不着国戚皇亲，～。","book":"元·关汉卿《蝴蝶梦》第一折"},"similar":["金枝玉叶"],"usage":"作宾语、定语；指豪门子女"},{"id":31466,"word":"玉叶金柯","pinyin":"yù yè jīn kē","abbr":"yyjk","explanation":"柯：草木的枝茎。原形容花木美好嫩弱的枝叶。后比喻皇亲国戚以及出身高贵的人。现也比喻出身高贵或娇嫩柔弱的人。","source":{"text":"主簿崔子佺，相门卿族，玉叶金柯，光彩可以射人。","book":"唐·张景毓《大唐朝散大夫行润州句容县令岑君德政碑》"},"similar":["金枝玉叶","玉叶金枝","玉枝金叶"],"usage":"作宾语、定语；指豪门子女"},{"id":31467,"word":"玉圭金臬","pinyin":"yù guī jīn niè","abbr":"ygjn","explanation":"比喻重要的准则或法度。圭，观测日影的仪器；臬，靶子。金玉言其贵重。","source":{"text":"国朝《岭南文钞》张南山《圣谷篇》语云：果中有核，肉中有骨，言中有物。三语括尽要旨，修辞家宜奉为玉圭金臬。","book":"清·梁绍壬《两般秋雨庵随笔·圣谷篇语》"},"usage":"作宾语、定语；用于书面语"},{"id":31468,"word":"玉堂人物","pinyin":"yù táng rén wù","abbr":"ytrw","explanation":"泛指显贵的文士。","source":{"text":"玉堂人物今何在，纸尾题诗一慨然。","book":"金·元好问《息轩秋江捕鱼图》诗之三"},"example":{"text":"至二世兄富丽堂皇，不用说，将来一定是～了！","book":"清·李宝嘉《官场现形记》第五十九回"},"usage":"作主语、宾语；用于书面语"},{"id":31469,"word":"玉堂金门","pinyin":"yù táng jīn mén","abbr":"ytjm","explanation":"玉堂：汉代殿名；金门：汉代宫门名。旧时比喻才学优异而富贵显达。","source":{"text":"玉堂金门至尊之居，阴盛而灭阳，窃有宫室之象，王氏之应。","book":"汉·扬雄《解嘲》：“今子幸得遭明圣之世，处不讳之朝，与群贤同行，历金门，上玉堂有日矣。”汉·荀悦《前汉纪·孝成皇帝纪》"},"similar":["玉堂金马"],"usage":"作宾语、定语；指高官显宦"},{"id":31470,"word":"玉堂金马","pinyin":"yù táng jīn mǎ","abbr":"ytjm","explanation":"玉堂：汉代殿名；金马：汉代宫门名，也称“金门”。旧时比喻才学优异而富贵显达。","source":{"text":"今子幸得遭明圣之世，处不讳之朝，与群贤同行，历金门，上玉堂有日矣。","book":"汉·扬雄《解嘲》"},"example":{"text":"喜君家平步上青云，好好，不枉了～多风韵。","book":"元·吴昌令《东坡梦》第一折"},"similar":["金马玉堂"],"usage":"作宾语、定语；指高官显宦"},{"id":31471,"word":"玉女金童","pinyin":"yù nǚ jīn tóng","abbr":"ynjt","explanation":"道教语，指侍奉仙人的童男童女。后泛指天真活泼的男女儿童。","source":{"text":"左壁厢天丁力士，参随着太乙真君；右势下玉女金童，簇捧定紫微大帝。","book":"明·施耐庵《水浒传》第一回"},"similar":["金童玉女"],"usage":"作主语、宾语；指天真活泼的男女儿童"},{"id":31472,"word":"玉宇琼楼","pinyin":"yù yǔ qióng lóu","abbr":"yyql","explanation":"①神话中仙人居住的宫殿。②形容覆雪的楼宇。","source":{"text":"玉宇琼楼闭早秋，金蟾玉兔啼寒夜。","book":"宋·苏轼《念奴娇·凭高眺远》词：“玉宇琼楼，乘鸾来去，人在清凉国。”明·何景明《嫦娥图》诗"},"example":{"text":"～，珠窗银瓦，疑在广寒仙府。","book":"清·秋瑾《齐天乐·雪》词"},"similar":["琼楼玉宇"],"usage":"作主语、宾语、定语；用于建筑物等"},{"id":31473,"word":"玉尺量才","pinyin":"yù chǐ liáng cái","abbr":"yclc","explanation":"玉尺：玉制的尺，旧时比喻选拔人才和评价诗文的标准。用恰当的标准来衡量人才和诗文。","source":{"text":"仙人持玉尺，度君多少才；玉尺不可尽，君才无时休。","book":"唐·李白《上清宝鼎》诗"},"example":{"text":"从此珊瑚在网，文博士本出宫中，～，女相如岂遗苑外。","book":"清·李汝珍《镜花缘》第四十二回"},"usage":"作宾语、定语；指高标准"},{"id":31474,"word":"玉山倾倒","pinyin":"yù shān qīng dǎo","abbr":"ysqd","explanation":"玉山：比喻品德仪容美好的人。形容酒醉后东倒西歪的样子。","source":{"text":"三月唯残一日春，玉山倾倒白鸥驯。","book":"唐·令狐楚《三月晦日会李员外座中频以老大不醉见讥因有此赠》"},"example":{"text":"重门深闭，忘却山阴道。呼酒嚼琼花，任醉来、～。","book":"宋·何梦桂《蓦山溪·和雪》词"},"similar":["玉山自倒","玉山倾颓","玉山将崩"],"usage":"作宾语、定语；用于比喻句"},{"id":31475,"word":"玉山倾颓","pinyin":"yù shān qīng tuí","abbr":"ysqt","explanation":"玉山：比喻品德仪容美好的人。形容酒醉后东倒西歪的样子。","source":{"text":"嵇叔夜之为人也，岩岩若孤松之独立；其醉也，傀俄若玉山之将崩。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"陆豪饮，一举十觥。朱因竟日饮，遂不觉～，伏几醺睡。","book":"清·蒲松龄《聊斋志异·陆判》"},"similar":["玉山自倒","玉山将崩","玉山倾倒"],"usage":"作宾语、定语；用于比喻句"},{"id":31476,"word":"玉山将崩","pinyin":"yù shān jiāng bēng","abbr":"ysjb","explanation":"玉山：比喻品德仪容美好的人。形容酒醉后东倒西歪的样子。","source":{"text":"嵇叔夜之为人也，岩岩若孤松之独立；其醉也，傀俄若玉山之将崩。","book":"南朝·宋·刘义庆《世说新语·容止》"},"similar":["玉山倾倒","玉山倾颓","玉山自倒"],"usage":"作宾语、定语；用于比喻句"},{"id":31477,"word":"玉山自倒","pinyin":"yù shān zì dǎo","abbr":"yszd","explanation":"玉山：比喻品德仪容美好的人。形容酒醉后东倒西歪的样子。","source":{"text":"清风朗月不用一钱买，玉山自倒非人推。","book":"唐·李白《杂歌谣辞·襄阳歌》"},"example":{"text":"若是花时，无风无雨，一日须来一百回。教人道。看～，不用相推。","book":"宋·刘过《六州歌头》词"},"similar":["玉山倾倒","玉山将崩","玉山倾颓"],"usage":"作宾语、定语；用于比喻句"},{"id":31478,"word":"玉律金科","pinyin":"yù lǜ jīn kē","abbr":"yljk","explanation":"律：规章，法则；科：旧指法律条文。原形容法令条文的尽善尽美。现比喻必须遵守、不能变更的信条。","source":{"text":"懿律嘉量，金科玉条。","book":"汉·扬雄《剧秦美新》"},"example":{"text":"老伯大人的议论，真是我们佐班中的～。","book":"清·李宝嘉《官场现形记》第四十三回"},"similar":["金科玉律"],"usage":"作主语、宾语、定语；同“金科玉律”"},{"id":31479,"word":"玉惨花愁","pinyin":"yù cǎn huā chóu","abbr":"ychc","explanation":"形容女子忧愁的样子。","source":{"text":"玉惨花愁，追思傅粉，巾袖与枕头都是泪痕。","book":"金·董解元《西厢记诸宫调》卷七"},"example":{"text":"～出凤城，莲花楼下柳青青。","book":"元·聂胜琼《鹧鸪天·寄别李生》词"},"usage":"作定语、状语；用于书面语"},{"id":31480,"word":"玉想琼思","pinyin":"yù xiǎng qióng sī","abbr":"yxqs","explanation":"形容思想坚定纯真。","source":{"text":"不须文字传言语，玉想琼思过一生。","book":"清·龚自珍《铁君惠书有玉想琼思之句衍成一诗答之》"}},{"id":31481,"word":"玉成之恩","pinyin":"yù chéng zhī ēn","abbr":"ycze","explanation":"玉成：成全，内含客气的意思。成全某件事情的恩德。多用于对某人的帮助的感激之辞。","source":{"text":"那太师与驿丞对行者作礼道：‘多谢老师玉成之恩！’","book":"明·吴承恩《西游记》第五十四回"},"usage":"作宾语；用于谢辞"},{"id":31482,"word":"玉成其事","pinyin":"yù chéng qí shì","abbr":"ycqs","explanation":"玉成：成全，内含客气的意思。成全那件事情。","source":{"text":"大夫能玉成其事，请以白璧二双，黄金百镒为献。","book":"明·冯梦龙《东周列国志》第八回"},"example":{"text":"只要求冯氏是早晚在员外跟前～。","book":"清·石玉昆《三侠五义》第三十五回"},"similar":["玉成其美"],"usage":"作谓语、宾语；多指男女婚事"},{"id":31483,"word":"玉成其美","pinyin":"yù chéng qí měi","abbr":"ycqm","explanation":"玉成：“玉汝于成”的缩语，帮助你有所成，后用为成全之意。成全某件好事。亦作“玉成其事”。","source":{"text":"［朱世远］读了一遍，叹口气道：‘真烈女也！为父母者，正当玉成其美，岂可以非理强之！’","book":"明·冯梦龙《醒世恒言》第九卷"},"similar":["玉成其事"],"usage":"作谓语、定语；用于书面语"},{"id":31484,"word":"玉振金声","pinyin":"yù zhèn jīn shēng","abbr":"yzjs","explanation":"比喻文章道德之盛。","source":{"text":"至如白雪回光，清风度曲，崔亭伯真龙之气，扬子云吐凤之才，莫不玉振金声，笔有余力。","book":"《梁书·徐勉传》：“网罗经诰，玉振金声，义贯幽微，理入神契。”唐˙杨炯《从弟去溢墓志铭》"},"example":{"text":"～，水增川涌，德兼才贵。","book":"宋·高观国《水龙吟·为放翁寿》词"},"similar":["金声玉振"],"usage":"作定语、状语；指名声"},{"id":31485,"word":"玉昆金友","pinyin":"yù kūn jīn yǒu","abbr":"ykjy","explanation":"友、昆：指兄弟。对他人兄弟的美称。","source":{"text":"辛攀，字怀远，陇西狄道人也。兄鉴旷，弟宝迅，皆以才识著名。秦、雍为之谚曰：‘三龙一门，金友玉昆。’","book":"北朝·魏·崔鸿《十六国春秋·前凉录·辛攀》"},"example":{"text":"我未经览浑如昨，～念离索。","book":"宋·刘子翚《观二刘题壁》"},"similar":["金友玉昆","玉友金昆"],"usage":"作宾语、定语；称赞别人"},{"id":31486,"word":"玉枝金叶","pinyin":"yù zhī jīn yè","abbr":"yzjy","explanation":"原形容花木美好嫩弱的枝叶。后比喻皇亲国戚以及出身高贵的人。现也比喻出身高贵或娇嫩柔弱的人。","source":{"text":"与蚩尤战于涿鹿之野，常有五色云气金枝玉叶止于帝上。","book":"晋·崔豹《古今注·舆服》"},"similar":["金枝玉叶","玉叶金枝","玉叶金柯"],"usage":"作宾语、定语；指豪门子女"},{"id":31487,"word":"玉柱擎天","pinyin":"yù zhù qíng tiān","abbr":"yzqt","explanation":"指栋梁之材可任天下大事。","source":{"text":"乾坤正，看玉柱擎天又何用？","book":"明·高明《琵琶记·新进士宴杏园》"},"similar":["擎天玉柱"],"usage":"作宾语、定语；用于书面语"},{"id":31488,"word":"玉树临风","pinyin":"yù shù lín fēng","abbr":"yslf","explanation":"形容人风度潇洒，秀美多姿。亦作“临风玉树”。","source":{"text":"宗之潇洒美少年，举觞白眼望青天；皎如玉树临风前，苏晋长斋绣佛前。","book":"唐·杜甫《饮中八仙歌》"},"example":{"text":"～宾欲散，黄昏约马嘶庭。","book":"宋·谢逸《临江仙》词"},"usage":"作宾语、定语；用于书面语"},{"id":31489,"word":"玉树琼枝","pinyin":"yù shù qióng zhī","abbr":"ysqz","explanation":"①形容树木华美。②比喻贵家子弟。","source":{"text":"凤阙龙楼连霄汉，玉树琼枝作烟萝，几曾识干戈。","book":"唐·李煜《破阵子》词"},"example":{"text":"愁肠种种，种种难消受。我是～，到做风中飞柳，堪忧。","book":"明·杨珽《龙膏记·砥节》"},"usage":"作宾语、定语；用于书面语"},{"id":31490,"word":"玉树盈阶","pinyin":"yù shù yíng jiē","abbr":"ysyj","explanation":"玉树：用玉做的树。比喻有出息的子弟。","source":{"text":"譬如芝兰玉树，欲使其生于庭阶耳。","book":"《晋书·谢安传》"},"similar":["玉树芝兰"],"usage":"作谓语、定语；用于比喻句"},{"id":31491,"word":"玉树芝兰","pinyin":"yù shù zhī lán","abbr":"yszl","explanation":"玉树：用玉做的树；芝兰：香草。比喻有出息的子弟。","source":{"text":"譬如芝兰玉树，欲使其生于庭阶耳。","book":"《晋书·谢安传》"},"example":{"text":"佳儿恂恂授衣钵，～俱秀发。","book":"宋·楼钥《攻媿集·王侍御寿诗》"},"similar":["芝兰玉树"],"usage":"作宾语、定语；用于人"},{"id":31492,"word":"玉楼受诏","pinyin":"yù lóu shòu zhào","abbr":"ylsz","explanation":"玉楼：传说中仙人居住的楼宇。文人早死的婉词。","source":{"text":"长吉将死时，忽昼见一绯衣人，驾赤虬，持一板书，若太古篆或霹雳石文者……绯衣人笑曰：‘帝成白玉楼，立召君为记。’","book":"唐·李商隐《李贺小传》"},"example":{"text":"不然，才名如李贤贺而～，犹在终贾之年，岂不备极荣休。","book":"清·周亮工《古香学时诗序》"}},{"id":31493,"word":"玉楼赴召","pinyin":"yù lóu fù zhào","abbr":"ylfz","explanation":"文人早死的婉词。","source":{"text":"长吉将死时，忽昼见一绯衣人，驾赤虬，持一板书，若太古篆或霹雳石文者……绯衣人笑曰：‘帝成白玉楼，立召君为记。’","book":"唐·李商隐《李贺小传》"},"example":{"text":"忽听见里面一片哭声沸腾起来，却把个文园病渴的司马相如，竟做了』的李长吉了。","book":"清·曾朴《孽海花》第二十四回"},"similar":["地下修文"],"usage":"作谓语、定语；指死"},{"id":31494,"word":"玉楼金殿","pinyin":"yù lóu jīn diàn","abbr":"yljd","explanation":"美玉砌成的楼房，金子搭成的宫殿。形容楼阁宫室的精致优美或指仙人之居处。","source":{"text":"玉楼巢翡翠，金殿锁鸳鸯。","book":"唐·李白《宫中行乐词》"},"example":{"text":"你看这～，巍巍锦簇雕檐。","book":"明·无名氏《庆千秋》第四折"},"similar":["玉楼金阁"],"usage":"作宾语、定语；用于书面语"},{"id":31495,"word":"玉楼金阁","pinyin":"yù lóu jīn gé","abbr":"yljg","explanation":"美玉砌成的楼房，金子搭成的宫殿。形容楼阁宫室的精致优美或指仙人之居处。","source":{"text":"玉楼巢翡翠，金殿锁鸳鸯。","book":"唐·李白《宫中行乐词》"},"example":{"text":"～号天庭，日月光辉显大明。","book":"元·无名氏《阴山破虏》第三折"},"similar":["玉楼金殿","玉楼金阙"],"usage":"作宾语、定语；用于书面语"},{"id":31496,"word":"玉楼金阙","pinyin":"yù lóu jīn què","abbr":"yljq","explanation":"美玉砌成的楼房，金子搭成的宫殿。形容楼阁宫室的精致优美或指仙人之居处。","source":{"text":"玉楼金阙慵归去，且插梅花醉洛阳。","book":"宋·朱敦儒《鹧鸪天》词"},"example":{"text":"云幕暗干山，肠断～。应是高唐小妇，妒娼娥清绝。","book":"宋·范成大《好事近》词"},"similar":["玉楼金阁","玉楼金殿"],"usage":"作宾语、定语；用于书面语"},{"id":31497,"word":"玉楼银海","pinyin":"yù lóu yín hǎi","abbr":"ylyh","explanation":"道家语。称双肩为玉楼，称眼睛为银海。","source":{"text":"冻合玉楼寒起粟，光摇银海眩生花。","book":"宋·苏轼《雪后书北台壁》"}},{"id":31498,"word":"玉殒香消","pinyin":"yù yǔn xiāng xiāo","abbr":"yyxx","explanation":"殒：坠落，死亡。像玉一样殒落，像花一样凋谢。比喻美丽的女子死亡。","example":{"text":"那一句“玉容寂寞泪阑干，梨花一枝春带雨”却是《长恨歌》中，杨贵妃～，魂魄在了仙山的情景。","book":"王安忆《长恨歌》第二部第一章"}},{"id":31499,"word":"玉殿嫦娥","pinyin":"yù diàn cháng é","abbr":"ydce","explanation":"比喻美丽漂亮的女子。","source":{"text":"似湘陵妃子，斜倚舜庙朱扉；如玉殿嫦娥，微现蟾宫素影。","book":"元·王实甫《西厢记》第一本第三折"}},{"id":31500,"word":"玉毁椟中","pinyin":"yù huǐ dú zhōng","abbr":"yhdz","explanation":"比喻因主管人员失职而造成重大损失。","source":{"text":"虎兕出于柙，玉毁椟中，是谁之过与？","book":"春秋·鲁·孔丘《论语·季氏》"},"example":{"text":"然～，责亦难辞，理应罢黜，更复何言？","book":"明·李东阳《杂记》第九卷"},"usage":"作谓语、宾语；指损失"},{"id":31501,"word":"玉汝于成","pinyin":"yù rǔ yú chéng","abbr":"yryc","explanation":"汝：你。玉汝：像爱惜玉一样爱护、帮助你。爱你如玉，帮助你，使你成功。多用于艰难困苦条件下。","source":{"text":"王欲玉女，是用大谏。","book":"《诗经·大雅·民劳》"},"example":{"text":"不以厚吾生者为荣，而以～于成者为乐。","book":"宋·刘克庄《顺宁舍记》"},"usage":"作谓语；多用于在困难的条件下","story":["北宋时期，著名哲学家张载从小研究兵法，经范仲淹指点改研究《中庸》和《周易》。公元1069年，他辞职回老家横渠镇潜心苦读，经常思考问题而废寝忘食。著作有《正蒙》。他在书房写上《西铭》：“贫贱忧戚，庸玉汝于成也。”"]},{"id":31502,"word":"玉洁冰清","pinyin":"yù jié bīng qīng","abbr":"yjbq","explanation":"象玉那样洁白，象冰那样清净。形容人心地纯洁，品行端正。","source":{"text":"伯夷叔齐，冰清玉洁，以义不为孤竹之嗣，不食周粟，饿死首阳。","book":"汉·桓谭《新论·妄瑕》"},"example":{"text":"若辈一经用了手脚，随你三贞九烈，～，亦不能跳出圈外。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["冰清玉洁","白璧无瑕"],"usage":"作定语；指人品"},{"id":31503,"word":"玉洁松贞","pinyin":"yù jié sōng zhēn","abbr":"yjsz","explanation":"象玉一样洁净，如松一般坚贞。形容品德高尚。","source":{"text":"今日相遇，乃前生姻缘耳。勿谓妾无玉洁松贞之志，放荡如斯。","book":"唐·皇甫枚《飞烟传》"},"usage":"作谓语、定语；指人的品德"},{"id":31504,"word":"玉润冰清","pinyin":"yù rùn bīng qīng","abbr":"yrbq","explanation":"像玉一样润泽，像冰一样清纯。常喻人或物形神之美。","source":{"text":"玉润冰清不受尘，仙衣裁剪绛纱新。","book":"宋·曾巩《荔支》诗之二"},"example":{"text":"暂时想见意冲冲，～迥不回。","book":"《群英类选·金兰记·舟中掷帕》"},"usage":"作谓语、定语；用于书面语"},{"id":31505,"word":"玉润珠圆","pinyin":"yù rùn zhū yuán","abbr":"yrzy","explanation":"润：细腻光滑。象珠子一样圆，象玉石一样光润。比喻歌声宛转优美，或文字流畅明快。","source":{"text":"方流涵玉润，圆折动珠光。","book":"唐·张文琮《咏水诗》"},"similar":["珠圆玉润"],"usage":"作谓语、定语；指文艺作品"},{"id":31506,"word":"玉液琼浆","pinyin":"yù yè qióng jiāng","abbr":"yyqj","explanation":"琼：美玉。用美玉制成的浆液，古代传说饮了它可以成仙。比喻美酒或甘美的浆汁。","source":{"text":"华酌既陈，有琼浆些。","book":"汉·王逸《九思·疾世》：“吮玉液兮止渴，啮芝华兮疗饥。”战国·楚·屈原《招魂》"},"example":{"text":"香桃烂杏，美甘甘似～。","book":"明·吴承恩《西游记》第一回"},"similar":["玉液金波","琼浆玉液"],"usage":"作宾语、定语；比喻美酒"},{"id":31507,"word":"玉液金波","pinyin":"yù yè jīn bō","abbr":"yyjb","explanation":"比喻美酒。","source":{"text":"他其实咽不下玉液金波 。","book":"元·王实甫《西厢记》第二本第四折"},"similar":["玉液琼浆"],"usage":"作宾语、定语；比喻美酒"},{"id":31508,"word":"玉液金浆","pinyin":"yù yè jīn jiāng","abbr":"yyjj","explanation":"比喻美酒。","source":{"text":"太上之药有中华紫蜜、云山朱蜜、玉液金浆。","book":"《汉武故事》"},"example":{"text":"此乃～，你可将去，同玉妃到坟前沃彼原身，即得炼形度地，尸解上升了。","book":"清·洪昇《长生殿·尸解》"},"similar":["琼浆玉液"],"usage":"作宾语、定语；比喻美酒"},{"id":31509,"word":"玉清冰洁","pinyin":"yù qīng bīng jié","abbr":"yqbj","explanation":"犹玉洁冰清。","source":{"text":"碧藓封枝，点寒英、疏疏玉清冰洁。","book":"宋·高观国《花心动·梅意》词"},"similar":["冰清玉洁","玉洁冰清"],"usage":"作谓语、定语；多用于比喻句"},{"id":31510,"word":"玉漏犹滴","pinyin":"yù lòu yóu dī","abbr":"ylyd","explanation":"指夜还未过去。玉漏：计时的漏壶。"},{"id":31511,"word":"玉烛调和","pinyin":"yù zhú tiáo hé","abbr":"yzth","explanation":"指天地四时之气和合调顺。也指夫妻感情融洽。","source":{"text":"铜律应度，玉烛调和。","book":"南朝·梁·萧统《七契》"},"example":{"text":"显文明开盛治，说孝男并义女。～归圣主。","book":"元·高明《琵琶记》第四十二出"}},{"id":31512,"word":"玉燕投怀","pinyin":"yù yàn tóu huái","abbr":"yyth","explanation":"后作贺人生子的颂语。","source":{"text":"张说母梦有一玉燕自东南飞来，投入怀中，而有孕生说，果为宰相，其至贵之祥也。","book":"五代·王仁裕《开元天宝遗事·梦玉燕投怀》"},"example":{"text":"喜今朝老蚌生珠，应～入梦。","book":"《群英类选·〈四德记·贺子满月〉》"},"usage":"作宾语、定语；用于书面语"},{"id":31513,"word":"玉琢成器","pinyin":"yù zhuó chéng qì","abbr":"yzcq","explanation":"琢：雕。玉石只有经过雕琢，才能成器物。比喻人只有接受教育才能有成就。","source":{"text":"玉不琢，不成器，人不学，不知道。","book":"《礼记·学记》"}},{"id":31514,"word":"玉石不分","pinyin":"yù shí bù fēn","abbr":"ysbf","explanation":"比喻好坏不分。","source":{"text":"洎乎近代，厥道寖微；玉石不分，薰莸错杂。","book":"五代·王定保《唐摭言》卷一"},"example":{"text":"只是我亦随军在此，兵败之后，～，岂能免难？","book":"明·罗贯中《三国演义》第四十八回"},"similar":["是非不分","玉石混淆"],"opposite":["是非分明"],"usage":"作谓语、定语；指好坏不分"},{"id":31515,"word":"玉石俱摧","pinyin":"yù shí jù cuī","abbr":"ysjc","explanation":"犹玉石俱焚。","source":{"text":"脱履机不发，必玉石俱摧。","book":"《晋书·索綝传》：“孤恐霜威一震，玉石俱摧，又《慕容德载记》"},"similar":["玉石皆碎","玉石俱碎","玉石俱焚"],"usage":"作谓语、定语、宾语；指同归于尽"},{"id":31516,"word":"玉石俱烬","pinyin":"yù shí jù jìn","abbr":"ysjj","explanation":"俱：全，都；烬：灰烬。美玉和石头一样烧坏。比喻好坏不分，同归于尽。","source":{"text":"火焱昆冈，玉石俱焚。","book":"《尚书·胤征》"},"example":{"text":"昆岳既毁，～。","book":"唐·欧阳询《艺文类聚》卷四十五"},"similar":["玉石俱摧","玉石俱焚","玉石同焚"],"usage":"作谓语、定语、宾语；指同归于尽"},{"id":31517,"word":"玉石俱焚","pinyin":"yù shí jù fén","abbr":"ysjf","explanation":"俱：全，都；焚：烧。美玉和石头一样烧坏。比喻好坏不分，同归于尽。","source":{"text":"火焱昆岗，玉石俱焚。","book":"《尚书·胤征》"},"example":{"text":"内无良将，外无救兵，若然攻破，～。","book":"清·陈忱《水浒后传》第十二回"},"similar":["同归于尽","休戚与共","风雨同舟"],"opposite":["泾渭分明","黑白分明","是非分明"],"usage":"作谓语、定语、宾语；指同归于尽"},{"id":31518,"word":"玉石俱碎","pinyin":"yù shí jù suì","abbr":"ysjs","explanation":"犹玉石俱焚。","source":{"text":"大兵一放，玉石俱碎，虽欲救之，亦无及已。","book":"汉·陈琳《檄吴将校部曲文》"},"similar":["玉石俱摧","玉石俱焚","玉石皆摧"],"usage":"作谓语、定语、宾语；指同归于尽"},{"id":31519,"word":"玉石同沉","pinyin":"yù shí tóng chén","abbr":"ystc","explanation":"比喻善恶一齐受害。","source":{"text":"孟诸焚燎，芝艾俱尽；宣房河决，玉石同沉。","book":"南朝·梁元帝《驰檄告四方》"},"usage":"作宾语、定语；用于比喻句"},{"id":31520,"word":"玉石同烬","pinyin":"yù shí tóng jìn","abbr":"ystj","explanation":"烬：灰烬。美玉和石头一样烧坏。比喻好坏不分，同归于尽。","source":{"text":"火焱昆冈，玉石俱焚。","book":"《尚书·胤征》"},"example":{"text":"火焚昆山，～；阻兵颉颃，臣节遂亏。","book":"唐·赵元一《奉天录》卷三"},"similar":["玉石俱烬","玉石俱焚","玉石同焚"],"usage":"作谓语、定语、宾语；指同归于尽"},{"id":31521,"word":"玉石同焚","pinyin":"yù shí tóng fén","abbr":"ystf","explanation":"焚：烧。美玉和石头一样烧坏。比喻好坏不分，同归于尽。","source":{"text":"火焱昆冈，玉石俱焚。","book":"《尚书·胤征》"},"example":{"text":"时运艰难，宗社危殆，昆岗已燎，～。","book":"《梁书·武帝纪》"},"similar":["玉石俱焚","玉石俱烬","玉石俱摧"],"usage":"作谓语、定语、宾语；指同归于尽"},{"id":31522,"word":"玉石同碎","pinyin":"yù shí tóng suì","abbr":"ysts","explanation":"犹玉石俱焚。","source":{"text":"沧海横流，玉石同碎。","book":"晋·袁宏《三国名臣序赞》"},"similar":["玉石俱焚","玉石俱碎","玉石俱摧"],"usage":"作宾语、定语；用于比喻句"},{"id":31523,"word":"玉石杂糅","pinyin":"yù shí zá róu","abbr":"yszr","explanation":"比喻好坏混杂。","source":{"text":"公侯已下，玉石杂糅；贤士之行，善恶相苞。","book":"汉·王充《论衡·累害》"},"similar":["玉石相揉","玉石混淆"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":31524,"word":"玉石混淆","pinyin":"yù shí hùn xiáo","abbr":"yshx","explanation":"比喻好坏混杂。","source":{"text":"真伪颠倒，玉石混淆。","book":"晋·葛洪《抱朴子·百家》"},"example":{"text":"［庙］两旁皆过客诗句，楹楣户牖，题染无余，往往～，殊不可读。","book":"宋·岳珂《桯史·淮阴庙》"},"similar":["玉石相揉","玉石杂糅"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":31525,"word":"玉石皆碎","pinyin":"yù shí jiē suì","abbr":"ysjs","explanation":"犹玉石俱焚。","source":{"text":"若偷安旦夕，迷而不反，大兵一发，玉石皆碎，虽欲悔之，亦无及已。","book":"三国·魏·锺会《移蜀檄》"},"similar":["玉石俱焚","玉石俱摧"],"usage":"作谓语、定语、宾语；指同归于尽"},{"id":31526,"word":"玉石相揉","pinyin":"yù shí xiāng róu","abbr":"ysxr","explanation":"比喻好坏混杂。","source":{"text":"驽骥同辕，伯乐为之咨嗟；玉石相揉，和氏为之叹息。","book":"《孔丛子·对魏王》"},"similar":["玉石混淆","玉石杂糅"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":31527,"word":"玉石难分","pinyin":"yù shí nán fēn","abbr":"ysnf","explanation":"美玉和石头能以区分。比喻难以辩别好坏。","source":{"text":"兵戈既接，玉石难分。","book":"唐·陆贽《招谕淮西将吏诏》"},"example":{"text":"淄渑杂混，～，用舍去留，得失相半。","book":"《旧唐书·魏玄同传》"},"similar":["玉石不分"],"usage":"作谓语、定语；指好坏不分"},{"id":31528,"word":"玉砌雕阑","pinyin":"yù qì diāo lán","abbr":"yqdl","explanation":"形容富丽的建筑物。","source":{"text":"雕栏玉砌应犹在，只是朱颜改。","book":"南唐·李煜《虞美人》词"},"example":{"text":"沧海尘生秋日暮，～，木叶鸣疏雨。江总头白心更苦，素琴犹写幽兰谱。","book":"元·虞集《蝶恋花》词"},"similar":["雕阑玉砌"],"usage":"作主语、宾语、定语；指建筑物"},{"id":31529,"word":"玉碎珠沉","pinyin":"yù suì zhū chén","abbr":"yszc","explanation":"美玉破碎，珠宝沉没。比喻美女的死亡。","source":{"text":"若他强逼成姻眷，拼一个珠沉玉碎，蚤赴黄泉。","book":"唐·秦贯《唐故荥阳郑府君夫人博陵崔氏合祔墓志铭》：“珠沉玉没兮，人谁靡伤，桂殒兰凋兮，共泣摧香。”明·叶宪祖《鸾鎞记·仗侠》"},"example":{"text":"若非奎璧生谋意，怎么得，～一旦间。（清·陈端生《再生缘》第二十九回）"},"similar":["玉陨香消"],"usage":"作谓语、定语；指美女死亡"},{"id":31530,"word":"玉碎瓦全","pinyin":"yù suì wǎ quán","abbr":"yswq","explanation":"宁做玉器被打碎，不做瓦器而保全。比喻宁愿为正义事业牺牲，不愿丧失气节，苟且偷生。","source":{"text":"岂得弃本宗，逐他姓，大丈夫宁可玉碎，不能瓦全。","book":"《北齐书·元景安传》"},"example":{"text":"夫～，糊涂语也。以张学良之聪明，乃不为之。","book":"林语堂《中国人之聪明》"}},{"id":31531,"word":"玉碎花消","pinyin":"yù suì huā xiāo","abbr":"yshx","explanation":"玉：美女；消：消失。比喻美丽的女子死亡","example":{"text":"一场病下来，林黛玉就～了"},"similar":["玉碎香残","玉碎香消","玉碎香销"],"usage":"作谓语、定语；用于女性死亡等"},{"id":31532,"word":"玉碎花销","pinyin":"yù suì huā xiāo","abbr":"yshx","explanation":"玉、花：旧诗文中美女的代称。比喻美丽的女子死亡。","source":{"text":"金樽玉酒催人老，我只道当时玉碎花销，重临阳世真难料，敢则是仙方相疗。","book":"明·陆采《明珠记》第三十九出"}},{"id":31533,"word":"玉碎香残","pinyin":"yù suì xiāng cán","abbr":"ysxc","explanation":"比喻美貌女子的死亡。","source":{"text":"玉碎香残荒郊卧，云拋雨断重泉墮。","book":"清·洪昇《长生殿》第二十七出"},"example":{"text":"不要等到～时你才珍惜她"},"similar":["玉碎花消","玉碎香销","玉碎香消"],"usage":"作谓语、定语；用于女性死亡等"},{"id":31534,"word":"玉碎香消","pinyin":"yù suì xiāng xiāo","abbr":"ysxx","explanation":"比喻女子死亡。","source":{"text":"玉碎香消镜台荒，绿云缭乱懒梳妆。","book":"明·无名氏《寻亲记》第二十四出"},"example":{"text":"她已经～了，你再悲伤也没用"},"similar":["玉碎香残","玉碎香销","玉碎花消"],"usage":"作谓语、定语；用于女性死亡等"},{"id":31535,"word":"玉碎香销","pinyin":"yù suì xiāng xiāo","abbr":"ysxx","explanation":"比喻女子的死。","source":{"text":"喜今朝玉碎香销，魂游天国路迢迢，此去何须悲悼。","book":"清·湘灵子《轩亭冤》第七出"},"similar":["玉碎珠沉"],"usage":"作谓语、宾语；用于比喻句"},{"id":31536,"word":"玉立亭亭","pinyin":"yù lì tíng tíng","abbr":"yltt","explanation":"玉立：比喻身材颀长美丽；亭亭：高耸直立的样子。形容女子身材修长。也形容花木等形体挺拔。","source":{"text":"仙状秀出，丹青写似，亭亭玉立，峨峨岳峙。","book":"汉·蔡邕《协初赋》：“其既远也，若披云缘汉见织女，立若碧山亭亭竖，动若翡翠奋其羽。”唐·于邵《杨侍郎写真赞》"},"example":{"text":"～树，水澌小小池。园林遍地幻珍奇。战罢奇鳞无数、满天飞。","book":"宋·赵希蓬《南歌子》词"},"similar":["亭亭玉立"],"usage":"作谓语、宾语、定语；用于女性或树木等"},{"id":31537,"word":"玉箫金琯","pinyin":"yù xiāo jīn guǎn","abbr":"yxjg","explanation":"泛指雕饰华美的管乐器。","source":{"text":"一楼初上一阁逢，玉萧金琯东山东。","book":"清·龚自珍《能令公少年行》"},"similar":["玉箫金管"],"usage":"作主语、宾语；指乐器"},{"id":31538,"word":"玉箫金管","pinyin":"yù xiāo jīn guǎn","abbr":"yxjg","explanation":"泛指雕饰华美的管乐器。同“玉箫金琯”。","source":{"text":"木兰之枻沙棠舟，玉箫金管坐两头。”：宋·周邦彦《蓦山溪》词“玉箫金管，不共美人游，因个甚，烟雾底。独爱莼羹美。","book":"唐·李白《江上行》"},"example":{"text":"凤城春好，～姿游盘。","book":"元·段克己《望月婆罗门引》"},"similar":["玉箫金琯"],"usage":"作主语、宾语；指乐器"},{"id":31539,"word":"玉粒桂薪","pinyin":"yù lì guì xīn","abbr":"ylgx","explanation":"米如玉，薪如桂。极言生活费用之高。","source":{"text":"緼袍短褐，玉粒桂薪，堪忧食贫，若为卒岁。","book":"宋·王禹偁《陈情表》：“望云就日，非无恋阙之心；玉粒桂薪，未有住京之计。”《宋史·外国传三·高丽》"},"example":{"text":"《宋史·外国传·高丽》：“～，堪忧食贫，若为卒岁。”"},"similar":["米珠薪桂"],"usage":"作宾语、定语；用于比喻句"},{"id":31540,"word":"玉翼婵娟","pinyin":"yù yì chán juān","abbr":"yycj","explanation":"指美女。","source":{"text":"不误这万年欢娱，翻做了荆湘怨忆。把一个玉翼婵娟，闪在瑶台月底。","book":"元·王仲元《粉蝶儿·集曲名题秋怨》"}},{"id":31541,"word":"玉葬香埋","pinyin":"yù zàng xiāng mái","abbr":"yzxm","explanation":"指美丽的女子死亡。含有惋惜之意。","source":{"text":"车道之北，邽山之阳。深深葬玉，郁郁埋香。","book":"唐·无名氏《王承检掘得墓铭》"},"example":{"text":"察知佳人有主，忿火中烧，万虑俱断矣。未几，闻～，然悲丧，恨不从丽人俱死。","book":"清·蒲松龄《聊斋志异·封三娘》"}},{"id":31542,"word":"玉貌花容","pinyin":"yù mào huā róng","abbr":"ymhr","explanation":"形容长得漂亮，如花似玉。","source":{"text":"闻得哭声，上前看时，虽然蓬头垢面，那玉貌花容，从来无两，如何不认得！","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"天那，寡人不幸，遭此播迁，累他～，驱驰道路。好不痛心也！","book":"清·洪昇《长生殿·惊变》"},"similar":["花容月貌","花容玉貌"],"usage":"作谓语、定语；形容女子貌美"},{"id":31543,"word":"玉质金相","pinyin":"yù zhì jīn xiàng","abbr":"yzjx","explanation":"金、玉：比喻美好；质：本质；相：外貌。比喻文章的形式和内容都完美。也形容人相貌端美。","source":{"text":"所谓金相玉质，百世无匹，名垂罔极，永不刊灭者矣。","book":"汉·王逸《离骚序》"},"example":{"text":"二爱仙人花榜待科，评为～。","book":"清·定鼎《夜雨秋灯录·胡宝玉小传》"},"similar":["金相玉质","金相玉式"],"usage":"作宾语、定语；指人或文章"},{"id":31544,"word":"玉走金飞","pinyin":"yù zǒu jīn fēi","abbr":"yzjf","explanation":"指日月如飞。比喻时光易逝。玉，玉兔，指月亮。金，金乌，指太阳。","source":{"text":"屈指劳生百岁期。荣瘁相随。利牵名惹逡巡过，奈两轮、玉走金飞。红颜成白发，极品何为。","book":"唐·吕岩《寄白龙洞刘道人》诗：“玉走金飞两曜忙，始闻花发又秋霜。”宋·柳永《看花回》词"},"example":{"text":"锦云中翠绕珠围，碧天边～。","book":"元·张可久《寨儿令·春晚次韵》曲"},"similar":["乌飞兔走"],"usage":"作宾语、定语；用于书面语"},{"id":31545,"word":"玉软花柔","pinyin":"yù ruǎn huā róu","abbr":"yrhr","explanation":"形容女子娇嫩柔弱，如花似玉。","source":{"text":"昨宴东楼，玳筵开舞裙歌袖，一团儿玉软花柔。","book":"宋·周紫芝《西江月》词：“罗袖云轻雾薄，醉肌玉软花柔。”元·王仲诚《中吕·粉蝶儿》套曲"},"example":{"text":"我那妃子啊，愁杀你～，要将途路趱。","book":"清·洪昇《长生殿·惊变》"},"usage":"作谓语、定语；用于比喻句"},{"id":31546,"word":"玉软香温","pinyin":"yù ruǎn xiāng wēn","abbr":"yrxw","explanation":"软：柔和；香、玉：女子的代称；温：温和。旧小说形容女子的身体。","source":{"text":"穿着些素淡衣服越风韵，兀的不是天生成玉软香温。","book":"元·李文蔚《燕青搏鱼》第二折"},"example":{"text":"虽阳台春小，巫峡云封，而～，正不知病相如魂销几许。","book":"清·魏子安《花月痕》第十八回"}},{"id":31547,"word":"玉阶彤庭","pinyin":"yù jiē tóng tíng","abbr":"yjtt","explanation":"彤：红色。饰玉的台阶，涂红的门庭。形容建筑物非常豪华。","source":{"text":"于是玄墀扣切，玉阶彤庭，碝磩采致，琳懡青荧，珊瑚碧树，周阿而生。","book":"汉·班固《西都赋》"}},{"id":31548,"word":"玉除彤庭","pinyin":"yù chú tóng tíng","abbr":"yctt","explanation":"除：台阶；彤：红色。饰玉的台阶，涂红的门庭。形容建筑物非常豪华。","source":{"text":"于是玄墀扣切，玉阶彤庭，碝磩采致，琳懡青荧，珊瑚碧树，周阿而生。","book":"汉·班固《西都赋》"},"usage":"作宾语、定语；用于书面语"},{"id":31549,"word":"玉食锦衣","pinyin":"yù shí jǐn yī","abbr":"ysjy","explanation":"锦衣：鲜艳华美的衣服；玉食：珍美的食品。精美的衣食。形容豪华奢侈的生活。","source":{"text":"锦衣玉食，可颐其形。","book":"《魏书·常景传》"},"example":{"text":"天福神皇神后，桓桓群将多筹，等闲握玺御龙楼，～消受。","book":"明·谢谠《四喜记·祸禳左道》"},"similar":["锦衣玉食"],"usage":"作主语、宾语、定语；指精美的衣食"},{"id":31550,"word":"玉马朝周","pinyin":"yù mǎ cháo zhōu","abbr":"ymcz","explanation":"玉马：指商贤臣微子启。纣王昏乱，启数谏不听，启乃去殷而朝周。比喻贤臣另事明主。","source":{"text":"昔日殷王子，玉马遂朝周。","book":"唐·陈子昂《感遇》"},"example":{"text":"～从此辞，园陵寂寞对丰碑。","book":"唐·刘禹锡《后梁宣明二帝碑堂下作》"}},{"id":31551,"word":"玉骨冰姿","pinyin":"yù gǔ bīng zī","abbr":"ygbz","explanation":"像冰一样的肌肤，像玉一样的骨骼。形容女子洁美的体肤","source":{"text":"若将玉骨冰姿比，李蔡为人在下中。","book":"宋·辛弃疾《鹧鸪天·赋梅》"},"similar":["冰肌玉骨","冰肌雪肤"],"usage":"作谓语、定语；用于比喻句"},{"id":31552,"word":"玉骨冰肌","pinyin":"yù gǔ bīng jī","abbr":"ygbj","explanation":"形容女子苗条的身段和洁白光润的肌肤。","source":{"text":"玉骨冰肌，为谁偏好，特地相宜，一段风流。","book":"宋·杨无咎《柳梢青》词"},"example":{"text":"生成～态，长就兰襟蕙质心。","book":"《再生缘》第二回"},"usage":"作宾语、定语；用于书面语"},{"id":31553,"word":"王佐之才","pinyin":"wáng zuǒ zhī cái","abbr":"wzzc","explanation":"佐：辅佐。辅佐帝王成就大业的才干。","source":{"text":"刘向称董仲舒有王佐之材，虽伊、吕亡以回。","book":"《汉书·董仲舒传赞》"},"example":{"text":"当朝一见，许其～，行路相逢，知其美人之赠。","book":"唐·杨炯《益州温江县令任君神道碑》"},"similar":["王佐之材"],"usage":"作宾语；用于书面语"},{"id":31554,"word":"王佐之材","pinyin":"wáng zuǒ zhī cái","abbr":"wzzc","explanation":"佐：辅助。指有辅佐帝王创业治国的才能。","source":{"text":"刘向称董仲舒有王佐之材，虽伊、吕亡以加。","book":"东汉·班固《汉书·董仲舒传赞》"},"similar":["王佐之才"],"usage":"作宾语；用于书面语"},{"id":31555,"word":"王侯将相","pinyin":"wáng hóu jiàng xiàng","abbr":"whjx","explanation":"泛指封建社会中位尊、禄厚、权重、势大的贵族。","source":{"text":"且壮士不死即已，死即举大名耳，王侯将相宁有种乎！","book":"《史记·陈涉世家》"},"example":{"text":"～，岂有种乎。","book":"清·郑燮《雍正十年杭州韬光庵中寄舍弟墨》"},"similar":["王公贵族","达官贵人"],"opposite":["平民百姓"],"usage":"作主语、宾语、定语；指封建贵族","story":["秦朝末年，统治阶级的残暴统治造成民不聊生。为了修筑北方的长城，募集许多劳工。陈涉、吴广等因为大雨延误行程，按律当斩，他们提出“王侯将相宁有种乎”，于是揭竿而起，其他豪杰也蜂拥而起，起义军迅速推翻了秦朝的统治"]},{"id":31556,"word":"王八羔子","pinyin":"wáng bā gāo zǐ","abbr":"wbgz","explanation":"清·刘鹗《老残游记》第19回：“吴二浪子那个王八羔子，我们在牢里的时候，他同贾大妮子天天在一块儿。”","source":{"text":"吴二浪子那个王八羔子，我们在牢里的时候，他同贾大妮子天天在一块儿。","book":"清·刘鹗《老残游记》第19回"},"example":{"text":"怕什么？屁的事也没！看他金家这群～怎放人！你正大光明来窜门子，谁家的龟儿子看见你和我睡觉了？","book":"路遥《平凡的世界》第一卷第50章"},"similar":["龟孙子"],"usage":"作主语、宾语、定语；用于骂人"},{"id":31557,"word":"王公大人","pinyin":"wáng gōng dà rén","abbr":"wgdr","explanation":"国君重臣。后泛指高官贵人。","source":{"text":"王公大人初见其术，惧然顾化，其后不能行之。","book":"《史记·孟子荀卿列传》"},"example":{"text":"清·龚自珍《明良论一》：“富贵者，天所以待～君子。”"},"similar":["达官贵人","王公贵人"],"opposite":["平民百姓"],"usage":"作主语、宾语、定语；用于书面语"},{"id":31558,"word":"王公贵人","pinyin":"wáng gōng guì rén","abbr":"wggr","explanation":"泛指达官贵人。","source":{"text":"王公大人初见其术，惧然顾化，其后不能行之。","book":"《史记·孟子荀卿列传》"},"similar":["王公大人","达官贵人"],"opposite":["平民百姓"],"usage":"作主语、宾语、定语；用于书面语"},{"id":31559,"word":"王公贵戚","pinyin":"wáng gōng guì qī","abbr":"wggq","explanation":"泛指皇亲国戚。","source":{"text":"其后王公贵戚皆驰书致币，恳请者不绝于道，而成漫不省也。","book":"《宣和画谱·李成》"},"similar":["皇亲国戚","王孙贵戚"],"usage":"作主语、宾语、定语；用于书面语"},{"id":31560,"word":"王司敬民","pinyin":"wáng sī jìng mín","abbr":"wsjm","explanation":"王：君主；司：主持。君王主持国家的职责在于尊重老百姓。","source":{"text":"王司敬民，罔非天胤，典祀无丰于昵。","book":"《尚书·高宗肜日》"}},{"id":31561,"word":"王后卢前","pinyin":"wáng hòu lú qián","abbr":"whlq","explanation":"指诗文齐名。","source":{"text":"炯与王勃、卢照邻、骆宾王以文词齐名，海内称为王、杨、卢、骆，亦号为‘四杰’。烱闻之，谓人曰：‘吾愧在卢前，耻居王后。’当时议者，亦以为然。","book":"《旧唐书·文苑传上·杨炯》"},"example":{"text":"郁达夫《闻杨云史先生之讣》诗：“江东渭北萦怀久，～位置难。”"},"usage":"作宾语、定语；用于书面语","story":["唐朝初期，诗歌散文十分活跃，其中代表人物有初唐四杰即：王勃、杨炯、卢照邻及骆宾王，他们的文词在海内外都有名气。当时有人试着给他们排名，杨炯听到后说：“吾愧在卢前，耻居王后。”","人们认为这样的排名比较合理"]},{"id":31562,"word":"王子犯法，与庶民同罪","pinyin":"wáng zǐ fàn fǎ，yǔ shù mín tóng zuì","abbr":"wzffysmtz","explanation":"王子：借指有权势的人；庶民：平民百姓。有权势的人犯法，和老百姓一样处以罪刑。指法律面前人人平等。","source":{"text":"众人都说哪里话，王子犯法，庶民同罪，这是因奸杀命的事，既犯到官，还有活命的吧？","book":"清·夏敬渠《野叟曝言》第六十七回"}},{"id":31563,"word":"王子犯法，庶民同罪","pinyin":"wáng zǐ fàn fǎ，shù mín tóng zuì","abbr":"wzffsmtz","explanation":"王子犯了法，和老百姓一样处以罪刑。指王法对于王子、平民是一样的。","source":{"text":"众人都道说那里话，王子犯法，庶民同罪，这是因奸杀命的事，既犯到官，还有活命的吗。","book":"《野叟曝言》第六七回"},"example":{"text":"老话头，～。他们不过是哺退乡绅，怎敢日清日白便把人打死！","book":"《何典》第九回"},"usage":"作宾语、定语、分句；用于处事"},{"id":31564,"word":"王孙公子","pinyin":"wáng sūn gōng zǐ","abbr":"wsgz","explanation":"旧时贵族、官僚的子弟。","source":{"text":"不知夫公子王孙左挟弹，右摄丸，将加己乎十仞之上，以其类为招。","book":"《战国策·楚策四》"},"example":{"text":"从来仕宦官员，～，要讨美妾的都到广陵郡来拣择聘娶。","book":"明·凌濛初《初刻拍案惊奇》卷十二"},"similar":["纨绔子弟"],"opposite":["平民百姓"],"usage":"作主语、宾语；指贵族、官僚的子弟"},{"id":31565,"word":"王孙贵戚","pinyin":"wáng sūn guì qī","abbr":"wsgq","explanation":"泛指皇亲国戚。同“王公贵戚”。","source":{"text":"觑雕鞍骏马，会王孙贵戚，谩把金尊倒，有时节沉醉花前，把金丸坠落飞鸟。","book":"《群音类选·好事近·游春》"},"similar":["王公贵戚","皇亲国戚"],"usage":"作主语、宾语、定语；用于书面语"},{"id":31566,"word":"王室如毁","pinyin":"wáng shì rú huǐ","abbr":"wsrh","explanation":"王室：指周王朝；毁：焚烧。原指西周王朝遭犬戎之难，如火烧毁。后泛指封建王朝濒于灭亡。","source":{"text":"鲂鱼赪尾，王室如毁。","book":"《诗经·周南·汝坟》"},"example":{"text":"～，生人多殪。","book":"唐·王勃《倬彼我系》"}},{"id":31567,"word":"王室鞅掌","pinyin":"wáng shì yāng zhǎng","abbr":"wsyz","explanation":"鞅：古代用马拉车时安在马脖子上的皮套子；鞅掌：仪容不整，指事多，无瑕整理仪容。旧时比喻公务繁忙。"},{"id":31568,"word":"王杨卢骆","pinyin":"wáng yáng lú luò","abbr":"wyll","explanation":"指初唐四杰：王勃、杨炯、卢照邻、骆宾王，四人擅长诗文，对初唐文学革新有贡献。","source":{"text":"王杨卢骆当时体，轻薄为文哂未休。尔曹身与名俱灭，不废江河万古流。","book":"唐·杜甫《戏为六绝句》之二"},"example":{"text":"等他再谒的时候，把他那刻的诗集要来看看，真真是李杜复生，再休提甚么～。","book":"清·文康《儿女英雄传》第三十五回"}},{"id":31569,"word":"王法无情","pinyin":"wáng fǎ wú qíng","abbr":"wfwq","explanation":"王法：封建时代称国家法律。国家的法律是不讲情面的。","source":{"text":"这两个都不待秋后取决，才见的官府内王法无情。","book":"元·郑廷玉《后庭花》第四折"},"example":{"text":"～，地狱难免，十余年戒行，一旦成灰，徒贻话靶。","book":"明·清溪道人《禅真逸史》第八回"},"similar":["国法无情"],"usage":"作宾语、定语；用于书面语"},{"id":31570,"word":"王祥卧冰","pinyin":"wáng xiáng wò bīng","abbr":"wxwb","explanation":"王祥卧冰求鱼以奉母。比喻子女孝顺父母。","source":{"text":"你孝顺似那～。 ★元·关汉卿《陈母教子》第三折"},"example":{"text":"元·关汉卿《陈母教子》第三折：“你孝顺似那～。”"},"similar":["卧冰求鲤","卧冰求鱼"],"usage":"作宾语、定语；用于孝子","story":["晋朝时期，琅邪临沂人王祥特别孝顺父母。父母生病的时候，他一直都衣不解带地伺候在父母身边，汤药要自己先尝后给父母喝。有一次母亲想吃活鱼，正值冬天，王祥脱衣刨冰，突然河上的冰融化，鲤鱼自己跳上来，他赶紧抓住回家去孝敬父母"]},{"id":31571,"word":"王谢风流","pinyin":"wáng xiè fēng liú","abbr":"wxfl","explanation":"王谢：王导、谢安，六朝时金陵王氏、谢氏为望族；风流：有建树。泛指高门望族中世代出有影响的人物并有功业传世。","source":{"text":"王谢：王导、谢安，六朝时金陵王氏、谢氏为望族；风流：有建树。泛指高门望族中世代出有影响的人物并有功业传世。"},"example":{"text":"王谢：王导、谢安，六朝时金陵王氏、谢氏为望族；风流：有建树。泛指高门望族中世代出有影响的人物并有功业传世。"}},{"id":31572,"word":"王贡弹冠","pinyin":"wáng gòng dàn guàn","abbr":"wgdg","explanation":"王：汉代王吉字子阳。贡：即贡禹。弹冠：拂去冠上的尘埃，喻将出来作官。比喻好朋友进退相随，取舍一致。也指一人得官，同类相庆。亦作“王阳在位，贡公弹冠”。","source":{"text":"吉与贡禹为友，世称‘王阳在位，贡公弹冠’，言取舍同也。","book":"《汉书·王吉传》"},"example":{"text":"萧朱结绶，～。","book":"唐·李翰《蒙求》"},"similar":["弹冠相庆"],"usage":"作宾语、定语；用于书面语","story":["汉宣帝时，琅琊人王吉和贡禹是很好的朋友，贡禹多次被免职，王吉在官场也很不得志。汉元帝时，王吉被召去当谏议大夫，贡禹听到这个消息很高兴，就把自己的官帽取出，弹去灰尘，准备戴用。果然没多久贡禹也被任命为谏议大夫"]},{"id":31573,"word":"王道乐土","pinyin":"wáng dào lè tǔ","abbr":"wdlt","explanation":"王道：统治者治理国家应遵循的道理；乐土：安乐的土地。指施行仁政，把国家治理得很好，百姓安居乐业。","example":{"text":"他竟然大肆宣称：茫茫草原本来是“大东亚共荣圈”内的一片“～”。","book":"冯苓植《雪驹》第十七章"}},{"id":31574,"word":"王阳在位，贡公弹冠","pinyin":"wáng yáng zài wèi，gòng gōng tán guān","abbr":"wyzwggdg","explanation":"王：汉代王吉；贡：贡禹；弹冠：拂去冠上的灰尘。比喻好朋友进退相随，取舍一致。也指一人得官，同类相庆。","source":{"text":"吉与贡禹为友，世称‘王阳在位，贡公弹冠’，言取舍同也。","book":"《汉书·王吉传》"}},{"id":31575,"word":"王顾左右而言他","pinyin":"wáng gù zuǒ yòu ér yán tā","abbr":"wgzyeyt","explanation":"指离开话题，回避难以答复的问题。","source":{"text":"《孟子·梁惠王下》"}},{"id":31576,"word":"玩世不恭","pinyin":"wán shì bù gōng","abbr":"wsbg","explanation":"玩世：以消极、玩弄的态度对待生活；不恭：不严肃。因对现实不满而采取的一种不严肃、不认真的生活态度。","source":{"text":"依隐玩世，诡时不逢。","book":"《汉书·东方朔传赞》"},"example":{"text":"余乡殷生文屏，毕司农之妹夫也，为人～。","book":"清·蒲松龄《聊斋志异·颠道人》"},"similar":["逢场作戏","玩世不羁","放荡不羁"],"opposite":["谨小慎微","兢兢业业"],"usage":"作谓语、定语、状语；指处世态度"},{"id":31577,"word":"玩世不羁","pinyin":"wán shì bù jī","abbr":"wsbj","explanation":"玩世：以消极、玩弄的态度对待生活；羁：束缚。因对现实不满而采取的一种不严肃、不认真的生活态度。","source":{"text":"玩世：以消极、玩弄的态度对待生活；羁：束缚。因对现实不满而采取的一种不严肃、不认真的生活态度。"},"similar":["玩世不恭"],"opposite":["兢兢业业"],"usage":"作谓语、定语、状语；指处世态度"},{"id":31578,"word":"玩于股掌之上","pinyin":"wán yú gǔ zhǎng zhī shàng","abbr":"wygzzs","explanation":"玩：玩弄；股：大腿；掌：手掌。玩弄于大腿和手掌上。指轻易地把人操纵在手里任意摆布。","source":{"text":"大夫种勇而善谋，将还玩吴国于股掌之上，以得其志。","book":"《国语·吴语》"},"example":{"text":"他能把它们～，玩得轻巧离奇，神出鬼没。","book":"高晓声《鱼钓》"}},{"id":31579,"word":"玩人丧德","pinyin":"wán rén shàng dé","abbr":"wrsd","explanation":"戏弄他人，以致失去做人的道德。","source":{"text":"不役耳目，百度惟贞，玩人丧德，玩物丧志。","book":"《尚书·旅獒》"},"example":{"text":"请不要干～的事情。"},"usage":"作定语；指干坏事"},{"id":31580,"word":"玩儿不转","pinyin":"wán ér bù zhuàn","abbr":"webz","explanation":"指挥不开，耍弄不了。","example":{"text":"这年头没钱啥事都～。"},"similar":["玩不转"],"usage":"作谓语；指不能胜任"},{"id":31581,"word":"玩兵黩武","pinyin":"wán bīng dú wǔ","abbr":"wbdw","explanation":"轻率无度地使用武力。","source":{"text":"骄者玩兵黩武，穷泰极侈。","book":"宋·司马光《进五规状·保业》"},"similar":["穷兵黩武"],"usage":"作谓语、定语；用于处事"},{"id":31582,"word":"玩岁愒日","pinyin":"wán suì kài rì","abbr":"wskr","explanation":"愒：荒废。指贪图安逸，虚度岁月。","source":{"text":"赵孟将死矣，主民，玩岁而愒日，其与几何？","book":"《左传·昭公元年》"},"example":{"text":"知陛下之志，必于复仇启土而无～之心，更加激厉，以图事功。","book":"宋·朱熹《壬午应诏封事》"},"similar":["玩时贪日","玩岁愒时","玩岁愒月"],"usage":"作谓语、定语、宾语；用于处事"},{"id":31583,"word":"玩岁愒时","pinyin":"wán suì kài shí","abbr":"wsks","explanation":"指贪图安逸，旷废时日。同“玩岁愒日”。","source":{"text":"今学者旷废隳惰，玩岁愒时而百无所成，皆由于志之未立耳。","book":"元·揭傒斯《刘福墓志铭》：“愚卤鄙陋者，或媮慢忧游得以玩岁愒时，此刘孟介至于呕血而死也。”明·王守仁《教条示龙场诸生》"},"example":{"text":"臣若贪位变禄，～，及此不图，更复何待？","book":"明·李东阳《求退录》十一"},"similar":["玩岁愒日","玩岁愒月","玩日愒月"],"usage":"作谓语、定语、宾语；用于处事"},{"id":31584,"word":"玩岁愒月","pinyin":"wán suì kài yuè","abbr":"wsky","explanation":"指贪图安逸，旷废时日。同“玩岁愒日”。","source":{"text":"乃当事者玩岁愒月，卒不能以实应。即敷奏，徒文具耳。","book":"明·周圣楷《张居正本传》"},"similar":["玩岁愒时","玩岁愒日","玩日愒时"],"usage":"作谓语、定语、宾语；用于处事"},{"id":31585,"word":"玩弄词藻","pinyin":"wán nòng cí zǎo","abbr":"wncz","explanation":"以经常虚伪地使用华丽词语为标志的言语行为。","example":{"text":"他是一个喜欢～的作者。"},"similar":["耍笔杆子"],"usage":"作谓语、定语、宾语；用于说话或作文"},{"id":31586,"word":"玩忽职守","pinyin":"wán hū zhí shǒu","abbr":"whzs","explanation":"不认真、不负责地对待本职工作。","source":{"text":"高松年身为校长，出去吃晚饭，这时候还不回来，影子也找不见，这种玩忽职守，就该死。","book":"钱钟书《围城》"},"example":{"text":"由于他玩忽职守，结果给单位造成巨大的经济损失。"},"similar":["疏忽职守"],"opposite":["忠于职守","兢兢业业"],"usage":"作谓语、宾语；指工作失职"},{"id":31587,"word":"玩故习常","pinyin":"wán gù xí cháng","abbr":"wgxc","explanation":"因循守旧，安于现状。","source":{"text":"岂群臣乐于负陛下哉！特玩故习常，势流于此而不自知也。","book":"宋·陈亮《论励臣之道》"},"usage":"作谓语、定语；用于处世等"},{"id":31588,"word":"玩日愒岁","pinyin":"wán rì kài suì","abbr":"wrks","explanation":"犹言玩时愒日。指贪图安逸，旷废时日。","source":{"text":"无如人之常情，恶劳而好逸，甘食褕衣，玩日愒岁。","book":"清·李文炤《勤训》"}},{"id":31589,"word":"玩日愒时","pinyin":"wán rì kài shí","abbr":"wrks","explanation":"犹言玩时愒日。指贪图安逸，旷废时日。","source":{"text":"其质地不近不能造就，及玩日愒时并无门径，应避贤路，兼重既禀，若是者去；规避不与者，亦即开缺。","book":"清·谭嗣同《兴算学议·浏阳兴算学记》附录《浏阳算学馆增订章程》"},"example":{"text":"往车已折，来轸方遒，独至语以开民智植人才之道，则咸以款项无出，～，而曾不肯舍此一二以就此千万也。","book":"梁启超《续论变法不知本原之害》"},"similar":["玩时愒日","玩日愒月"],"usage":"作谓语、定语、宾语；用于处事"},{"id":31590,"word":"玩日愒月","pinyin":"wán rì kài yuè","abbr":"wrky","explanation":"愒：荒废。贪图安逸，荒废岁月。","source":{"text":"若徒玩日愒月，转瞬之间已成耄耋，可惧也。","book":"清·朱之瑜《与奥村德辉书》"},"similar":["玩日愒时","玩岁愒月","玩时愒日"],"usage":"作谓语、定语、宾语；用于处事"},{"id":31591,"word":"玩时愒日","pinyin":"wán shí kài rì","abbr":"wskr","explanation":"指贪图安逸，旷废时日。亦作“玩时贪日”。","source":{"text":"今汝弃本务末，玩时愒日，措心于无用之地，不唯负尔母之训，而何以慰先人于地下乎？","book":"《合浦珠》第二回"},"example":{"text":"由此类推，无往而非～，即幸而得至百年，无形中以耗其强半。","book":"清·谭嗣同《仁学》一"},"similar":["玩日愒时","玩日愒月","玩时贪日"],"usage":"作谓语、定语、宾语；用于处事"},{"id":31592,"word":"玩时贪日","pinyin":"wán shí tān rì","abbr":"wstr","explanation":"指贪图安逸，旷废时日。同“玩时愒日”。","source":{"text":"濂也以缪悠之资，玩时贪日，不能成一章。","book":"明·宋濂《序》"},"similar":["玩时愒日","玩岁愒日","玩日愒月"],"usage":"作谓语、定语、宾语；用于处事"},{"id":31593,"word":"玩法徇私","pinyin":"wán fǎ xún sī","abbr":"wfxs","explanation":"无视法纪，曲从于私情。指徇情枉法。","source":{"text":"闻知你公正廉能，不肯玩法徇私……你与我把这事情用心问断。","book":"明·冯梦龙《警世通言》卷二十四"},"example":{"text":"对于～的人要坚决惩处"},"similar":["徇私枉法"],"opposite":["秉公执法"],"usage":"作谓语、定语、宾语；用于处事"},{"id":31594,"word":"玩火自焚","pinyin":"wán huǒ zì fén","abbr":"whzf","explanation":"玩：玩弄；焚：烧。玩火的必定会烧了自己。比喻干冒险或害人的勾当，最后受害的还是自己。","source":{"text":"夫兵，犹火也，弗戢，将自焚也。","book":"春秋·鲁·左丘明《左传·隐公四年》"},"example":{"text":"你要小心～。"},"similar":["自作自受","自食恶果"],"opposite":["乐善好施"],"usage":"作谓语、定语；指自作自受","story":["春秋时期，卫国的公子州吁杀兄卫桓公篡位，他拉拢宋、陈、蔡等国一起攻打郑国。鲁隐公问大夫众仲如何看待此事，众仲说如此残忍的人会众叛亲离的，用兵就像用火一样，不知收敛就会烧死自己的。果然不久卫国人借助陈国杀死州吁"]},{"id":31595,"word":"玩物丧志","pinyin":"wán wù sàng zhì","abbr":"wwsz","explanation":"玩：玩赏；丧：丧失；志：志气。指迷恋于所玩赏的事物而消磨了积极进取的志气。","source":{"text":"玩人丧德，玩物丧志。","book":"《书·旅獒》"},"example":{"text":"道学家教人少作诗文，说是“～”，说是“害道”，那么诗文成了废话，这所谓诗文指表情的作品而言。","book":"朱自清《论废话》"},"similar":["不务正业"],"opposite":["业精于勤"],"usage":"作谓语、宾语、定语；指没理想","story":["公元前668年，卫惠公的儿子姬赤成为卫懿公后，不思富国强兵之道，整天喜欢养鹤，甚至荒唐到给鹤封官位，享官禄，百姓怨声载道。北方狄国借机出兵攻打卫国，卫国士兵根本不抵抗就逃散，有人甚至叫鹤去抗狄，最后卫懿公被狄兵所杀"]},{"id":31596,"word":"玩物溺志","pinyin":"wán wù nì zhì","abbr":"wwnz","explanation":"玩：玩赏；物：器物；溺志：埋没志向。玩赏器物，埋没志向。指一心玩赏所喜爱的东西，就会消磨掉进取的意志。","source":{"text":"若求增不已，却恐亦为玩物溺志，不可不察也。","book":"宋·张栻《南轩文集·与曾节夫抚幹》"}},{"id":31597,"word":"环堵之室","pinyin":"huán dǔ zhī shì","abbr":"hdzs","explanation":"环堵：围绕着四堵墙。四周围绕着土墙的房屋。","source":{"text":"儒有一亩之宫，环堵之室。","book":"《礼记·儒行》"},"example":{"text":"～，茨之以生茅。","book":"《淮南子·原道训》"},"usage":"作宾语；指萧条的房子"},{"id":31598,"word":"环堵萧然","pinyin":"huán dǔ xiāo rán","abbr":"hdxr","explanation":"环堵：围绕着四堵墙；萧然：萧条的样子。形容室中空无所有，极为贫困。","source":{"text":"环堵萧然，不蔽风日，短褐穿结，箪瓢屡空，晏如是也。","book":"晋·陶潜《五柳先生传》"},"example":{"text":"杨昌濬尝诣典，～，一如寒素，寓书宗棠共称之。","book":"《清史稿·刘典传》"},"similar":["家徒四壁"],"opposite":["满目青山","金碧辉煌"],"usage":"作谓语、定语；形容室中空无一物"},{"id":31599,"word":"环林璧水","pinyin":"huán lín bì shuǐ","abbr":"hlbs","explanation":"环林：林木环绕，古代借指太学；璧水：指太学。古时用以指代太学。","source":{"text":"故东胶西序，事隆乎三代，环林璧水，业盛于两京。","book":"《陈书·沈不害传》"}},{"id":31600,"word":"环肥燕瘦","pinyin":"huán féi yàn shòu","abbr":"hfys","explanation":"形容女子形态不同，各有各好看的地方。也借喻艺术作品风格不同，而各有所长。","source":{"text":"杜陵评书贵瘦硬，此论未公吾不凭。短长肥瘦各有态，玉环飞燕谁敢憎。","book":"宋·苏轼《孙莘老求墨妙亭诗》"},"example":{"text":"评量粉黛，～之间；品藻冠裳，贾佞江忠之列。","book":"清·梁绍任《两般秋雨庵随笔》卷三"},"similar":["燕瘦环肥"],"usage":"作谓语、定语；用于女性"},{"id":31601,"word":"现世报","pinyin":"xiàn shì bào","abbr":"xsb","explanation":"报：报应。原为佛家语。后指人做了恶事，今生就会得到报应。意指报应很快。也指人自作自受。","source":{"text":"是人现得，恶口恶色，所言虽实，人不信受，众皆憎恶，不喜见之，是名现世，恶业之报。","book":"唐·释道世《法苑珠林·妄语部》卷九十三"},"example":{"text":"单留得我一个～，还在这里，却又无男无女，靠唱道情度日。","book":"明·冯梦龙《醒世恒言》卷三十八"},"similar":["现世现报"],"usage":"作宾语、定语；用于书面语"},{"id":31602,"word":"现世现报","pinyin":"xiàn shì xiàn bòo","abbr":"xsxb","explanation":"报：报应。原为佛家语。后指人做了恶事，今生就会得到报应。意指报应很快。","source":{"text":"是人现得，恶口恶色，所言虽实，人不信受，众皆憎恶，不喜见之，是名现世，恶业之报。","book":"唐·释道世《法苑珠林·妄语部》卷九十三"},"example":{"text":"那世里造的孽，这会子～，叫我那一个眼睛瞧得上。","book":"清·曹雪芹《红楼梦》第三十五回"},"similar":["现世报"],"usage":"作宾语、定语；指因果报应"},{"id":31603,"word":"现买现卖","pinyin":"xiàn mǎi xiàn mài","abbr":"xmxm","explanation":"临时买来再贩卖出去。比喻平素没有积累，临时从这里学，又到别处去传授。","example":{"text":"小兄弟学得了精妙内功，～，待任我行上来，便在他身上使使，教他大吃一惊。","book":"金庸《笑傲江湖》第四十回"}},{"id":31604,"word":"现实主义","pinyin":"xiàn shí zhǔ yì","abbr":"xszy","explanation":"注重事实或现实，反对一切不切实际或空想的性格。","source":{"text":"虽可能有张伯伦一类的迁就所谓‘既成事实’的‘现实主义’的调头出现，但主要的国际势力将变到进一步地援助中国。","book":"毛泽东《论持久战》"},"example":{"text":"路遥《平凡的世界》第五卷第21章：“金俊山抱着～态度说。”"},"opposite":["理想主义"],"usage":"作主语、宾语、定语；用于处事"},{"id":31605,"word":"现成饭","pinyin":"xiàn chéng fàn","abbr":"xcf","explanation":"已经安排好的饭食。比喻没有经过自己的劳动，坐享其成。","source":{"text":"每月可以得他几钱银子，你又有现成饭吃，只在明日就要去了。","book":"清·吴敬梓《儒林外史》第一回"},"example":{"text":"吃～，是最没有意思的事，是最没有出息的人才喜欢的。","book":"清·梁启超《治国学杂话》"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":31606,"word":"现时报","pinyin":"xiàn shí bào","abbr":"xsb","explanation":"现时：今生今世。指今世作恶就在今世遭报应。","source":{"text":"前日这老道前来求亲时，我们只怪他不伦，岂只是个妖魔，今日也现时报了。","book":"明·凌濛初《初刻拍案惊奇》第24卷"},"example":{"text":"到镇上去吃点苦头，这才叫～，老天爷有眼！","book":"茅盾《秋收》"},"similar":["现世报"],"usage":"作宾语、定语；用于书面语"},{"id":31607,"word":"现炒现卖","pinyin":"xiàn chǎo xiàn mài","abbr":"xcxm","explanation":"就地贩卖。","source":{"text":"你看东西真是过目不忘啊，现炒现卖。","book":"王朔《浮出海面》"},"similar":["现贩现卖"],"usage":"作谓语、宾语；指现场处理"},{"id":31608,"word":"现贩现卖","pinyin":"xiàn fàn xiàn mài","abbr":"xfxm","explanation":"就地贩卖。","example":{"text":"我这是～，没有什么深的研究。"},"similar":["现炒现卖"],"usage":"作谓语、宾语；指现场处理"},{"id":31609,"word":"现身说法","pinyin":"xiàn shēn shuō fǎ","abbr":"xssf","explanation":"佛教用语。指佛力广大，能现出种种人相，向人说法。现指以亲身经历和体验为例来说明某种道理。","source":{"text":"亦于十方界中现身说法。","book":"《愣严经》卷六：“我与彼前，皆现其身，而为说法，令其成就。”宋·释道原《景德传灯录》卷一"},"example":{"text":"袁伯珍这一席话，可谓～。","book":"清·无名氏《官场维新记》第十六回"},"similar":["言传身教"],"opposite":["空谈快意"],"usage":"作谓语、定语、宾语；指以亲身经历来说明"},{"id":31610,"word":"现钟不打","pinyin":"xiàn zhōng bù dǎ","abbr":"xzbd","explanation":"比喻有现成的东西却不加利用。"},{"id":31611,"word":"现钟弗打","pinyin":"xiàn zhōng fú dǎ","abbr":"xzfd","explanation":"比喻有现成的东西却不加利用。同“现钟不打”。"},{"id":31612,"word":"玲珑剔透","pinyin":"líng lóng tī tòu","abbr":"lltt","explanation":"玲珑：精巧细致；剔透：孔穴明晰。形容器物精致通明，结构细巧。也比喻人精明灵活。","source":{"text":"那厮爱女娘的心，见的便似驴共狗，卖弄他玲珑剔透。","book":"元·关汉卿《救风尘》第二折"},"example":{"text":"走上冈子一看，有座天 ，直靠在海外，如建康燕子矶一样，～，文采可观。","book":"清·陈忱《水浒后传》第三十六回"},"similar":["聪明伶俐","伶牙俐齿","小巧玲珑"],"opposite":["呆头呆脑","笨手笨脚","硕大无朋"],"usage":"作谓语、定语；形容器物精致通明"},{"id":31613,"word":"玲珑小巧","pinyin":"líng lóng xiǎo qiǎo","abbr":"llxq","explanation":"玲珑：精巧细致；小巧：细小而灵巧。形容东西小而精致。","source":{"text":"莫笑吾家巷壁小，稜层势欲摩空。相知唯有主人翁，有心雄泰华，无意巧玲珑。","book":"宋·辛弃疾《临江仙·戏为山园壁解嘲》词"},"example":{"text":"而这一切，又使草虫显得更加～。","book":"秦牧《粗犷与细腻》"},"similar":["小巧玲珑"],"opposite":["硕大无朋"],"usage":"作谓语、定语、宾语；指东西小而精致"},{"id":31614,"word":"玲珑透漏","pinyin":"líng lóng tòu lòu","abbr":"lltl","explanation":"形容器物精致通明，结构细巧。也比喻人精明灵活。同“玲珑剔透”。","source":{"text":"石在亭前池中，高八尺，阔半之，玲珑透漏不瘦不肥，前后俱无斧凿痕，太湖之绝品也。","book":"明·徐弘祖《徐霞客游记·滇游日记》"},"usage":"作谓语、定语；多用于诗文"},{"id":31615,"word":"珊珊来迟","pinyin":"shān shān lái chí","abbr":"sslc","explanation":"形容来得很晚。同“姗姗来迟”。","source":{"text":"有某者，蜀中大贾也，旅于吴，慕姬名，备蜀锦十端，踵门请见，丽珊珊来迟，贾恨相见晚。","book":"清·宣鼎《夜雨秋灯录三集·记钱姬假途脱籍事》"},"example":{"text":"有二美者，～。","book":"清·周友良《珠江梅柳记》卷二"},"similar":["姗姗来迟"],"opposite":["争先恐后"],"usage":"作谓语、宾语；表示迟到的意思","story":["清朝时期，著名妓女钱姬长得十分漂亮，远近闻名，很多人争相追逐。一个四川商人到此做买卖，因为早听说钱姬十分出门，就带上蜀锦十匹前去求见。钱姬珊珊来迟，该商人两眼放光，顿时有相见恨晚的感觉"]},{"id":31616,"word":"珊瑚在网","pinyin":"shān hú zài wǎng","abbr":"shzw","explanation":"在网：都在网中。比喻有才学的人都被收罗了。","source":{"text":"海中有珊瑚洲，海人乘大舶堕铁网水底。珊瑚初生磐石上，白如菌，一岁而黄，三岁赤，枝格交错，高三四尺，铁发其根，系网舶上，绞而出之。","book":"《新唐书·拂菻国传》"},"example":{"text":"从此～，文博士本出宫中；玉尺量才，女相如岂遗苑外？","book":"清·李汝珍《镜花缘》第四十二回"},"usage":"作谓语；指收罗人才"},{"id":31617,"word":"珊瑚木难","pinyin":"shān hú mù nàn","abbr":"shmn","explanation":"比喻珍贵难得的事物。","source":{"text":"明珠交玉体，珊瑚间木难。","book":"三国·魏·曹植《美女篇》"},"example":{"text":"王元美天分既高，学殖亦富，自～及牛溲马勃，无所不有。","book":"清·沈德潜《说诗晬语》"}},{"id":31618,"word":"珍产淫货","pinyin":"zhēn chǎn yín huò","abbr":"zcyh","explanation":"淫货：诱人欲得的奢侈品。指珍贵的特产和诱人的奇货","source":{"text":"慈溪小邑，无珍产淫货，以来四方游贩之民。","book":"宋·王安石《慈溪县学记》"},"similar":["奇珍异宝"],"usage":"作宾语、定语；用于书面语"},{"id":31619,"word":"珍味佳肴","pinyin":"zhēn wèi jiā yáo","abbr":"zwjy","explanation":"在味觉和嗅觉上极令人喜欢的食物。","example":{"text":"面对这么多的～，我没有丝毫兴趣。"},"similar":["美味佳肴"],"usage":"作主语、宾语、定语；指珍贵的食物"},{"id":31620,"word":"珍楼宝屋","pinyin":"zhēn lóu bǎo wū","abbr":"zlbw","explanation":"珍奇的楼房，富贵的居室。形容建筑物非常豪华。","source":{"text":"于来廷坊建佛祠，兴宁坊立道士祠，珍楼宝屋，国赀所不逮。","book":"《新唐书·宦者传·高力士》"},"example":{"text":"唐高力士于来廷坊建佛寺，～，竭尽国资。（清·张英《渊鉴类函·佛寺》）"},"usage":"作宾语、定语；用于建筑等"},{"id":31621,"word":"珍禽奇兽","pinyin":"zhēn qín qí shòu","abbr":"zqqs","explanation":"珍：贵重的；奇：特殊的。珍奇的飞禽，罕见的走兽。","source":{"text":"犬马非其土性不畜，珍禽奇兽不育于国。","book":"《尚书·旅獒》"},"example":{"text":"清·褚人获《隋唐演义》第20回：“选天下之良材异石，与各种嘉花瑞草、～，充实其中。”"},"similar":["珍禽异兽"],"usage":"作宾语、定语；指贵重奇异的动物"},{"id":31622,"word":"珍禽异兽","pinyin":"zhēn qín yì shòu","abbr":"zqys","explanation":"珍奇的飞禽，罕见的走兽。同“珍禽奇兽”。","source":{"text":"犬马非其土性不畜，珍禽异常，不异于国。","book":"《尚书·旅獒》"},"example":{"text":"灯作伞形，六角间有圆者，镂人物花卉，～。","book":"清·王韬《瀛濡杂志》"},"similar":["珍禽奇兽"],"usage":"作宾语、定语；指贵重奇异的动物"},{"id":31623,"word":"珍羞美味","pinyin":"zhēn xiū měi wèi","abbr":"zxmw","explanation":"珍贵而美味的食物。","source":{"text":"不一时，只见剔犀官桌上，摆上珍羞美味来，只好没有龙肝凤髓罢了，其余般般俱有，便是蔡太师自家受用，也不过如此。","book":"明·兰陵笑笑生《金瓶梅词话》第五十五回"},"example":{"text":"～，统罗缎疋，那一件好东西不拿来供给他？（清·夏敬渠《野叟曝言》第二十七回）"},"similar":["山珍海味","珍馐美馔"],"usage":"作宾语、定语；用于书面语"},{"id":31624,"word":"珍肴异馔","pinyin":"zhēn yáo yì zhuàn","abbr":"zyyz","explanation":"肴：菜肴；异：特别的；馔：饭食。珍贵而奇特的食物。","source":{"text":"当日穆弘叫庄客宰了一头黄牛，杀了十数个猪羊，鸡鹅鱼鸭，珍肴异馔，排下筵席，管待众头领。","book":"明·施耐庵《水浒全传》第四十回"},"similar":["珍羞美味"],"usage":"作宾语、定语；用于书面语"},{"id":31625,"word":"珍藏密敛","pinyin":"zhēn cáng mì liǎn","abbr":"zcml","explanation":"敛：收起。非常珍重并严密地收藏起来。","source":{"text":"咱们比不得那没见世面的人家，得了这个，就珍藏密敛的。","book":"清·曹雪芹《红楼梦》第七十七回"},"usage":"作谓语、定语；用于书面语"},{"id":31626,"word":"珍馐美馔","pinyin":"zhēn xiū měi zhuàn","abbr":"zxmz","explanation":"馐：滋味好的食物，馔：饭食。珍贵而味道好的食物。亦作“珍羞美味”。","example":{"text":"谁都盼望有一顿～"},"similar":["珍羞美味"],"usage":"作宾语、定语；用于饮食等"},{"id":31627,"word":"珞珞如石","pinyin":"luò luò rú shí","abbr":"llrs","explanation":"珞珞：石头坚硬的样子。形容坚如顽石。","source":{"text":"不欲琭琭如玉，珞珞如石。","book":"春秋·楚·李耳《老子》"},"usage":"作宾语、定语；指坚硬"},{"id":31628,"word":"珠光宝气","pinyin":"zhū guāng bǎo qì","abbr":"zgbq","explanation":"珠、宝：指首饰；光、气：形容闪耀着光彩。旧时形容妇女服饰华贵富丽，闪耀着珍宝的光色。","source":{"text":"簪饰虽是不多几件，而珠光宝气，晔晔照人。","book":"清·漱六山房《九尾龟》"},"example":{"text":"这光芒要是只在字和词，那大概像古墓里的贵妇人似的，满身都是～了。","book":"鲁迅《准风月谈·难得糊涂》"},"similar":["珠围翠绕","花枝招展","花团锦簇"],"opposite":["质朴无华","荆钗布裙"],"usage":"作宾语、定语、状语；形容穿戴华丽"},{"id":31629,"word":"珠围翠拥","pinyin":"zhū wéi cuì yōng","abbr":"zwcy","explanation":"指华贵的装璜或装饰。","source":{"text":"烛影摇红，帘幕瑞烟浮动，画堂中珠围翠拥。","book":"元·高明《琵琶记·伯喈牛宅结亲》"},"similar":["珠围翠绕","珠绕翠围"],"usage":"作谓语、定语；形容人很富有"},{"id":31630,"word":"珠围翠绕","pinyin":"zhū wéi cuì rào","abbr":"zwcr","explanation":"珠：珍珠；翠：翡翠。形容妇女妆饰华丽。也形容富贵人家随侍的女子众多。","source":{"text":"依旧有翠绕珠围。","book":"元·王子一《误入桃源》第四折"},"example":{"text":"刘姥姥进去，只见满屋里～，花枝招展的，并不知都系何人。","book":"清·曹雪芹《红楼梦》第三十九回"},"similar":["珠光宝气","金壁辉煌","富丽堂皇"],"opposite":["质朴无华","荆钗布裙"],"usage":"作谓语、定语、补语；形容人很富有"},{"id":31631,"word":"珠圆玉洁","pinyin":"zhū yuán yù jié","abbr":"zyyj","explanation":"比喻诗文圆熟明洁。","source":{"text":"因征其近制数篇读之，皆珠圆玉洁而法度谨严。","book":"明·宋濂《送天渊禅师濬公还四明序》"},"example":{"text":"其文前后开合……如月照影，月过影失；如风扫叶，风止叶尽；～之文也。","book":"《花月痕》第四回"},"usage":"作宾语、定语；用于比喻句"},{"id":31632,"word":"珠圆玉润","pinyin":"zhū yuán yù rùn","abbr":"zyyr","explanation":"润：细腻光滑。象珠子一样圆，象玉石一样光润。比喻歌声宛转优美，或文字流畅明快。","source":{"text":"方流涵玉润，圆折动珠光。","book":"唐·张文琮《咏水诗》"},"example":{"text":"北宋词多就景叙情，故～，四照玲珑。","book":"清·周济《词辨》"},"similar":["飞泉鸣玉","余音绕梁","娓娓动听"],"opposite":["不堪入目","不堪入耳","诘屈聱牙"],"usage":"作谓语、定语、补语；指歌声或文章"},{"id":31633,"word":"珠宫贝阙","pinyin":"zhū gōng bèi què","abbr":"zgbq","explanation":"用珍珠宝贝做的宫殿。形容房屋华丽。","source":{"text":"鱼鳞屋兮龙堂，紫贝阙兮朱宫。","book":"战国楚·屈原《九歌·河伯》"},"example":{"text":"一进门，便是十几架一间的敞厅，厅上陈设的如～一般，处处都夺睛耀目。","book":"清·李宝嘉《文明小史》第五十一回"},"similar":["贝阙珠宫"],"usage":"作主语、宾语、定语；形容房屋华丽"},{"id":31634,"word":"珠履三千","pinyin":"zhū lǚ sān qiān","abbr":"zlsq","explanation":"珠履：缀有珠玉的鞋子。形容贵宾众多。","source":{"text":"不同珠履三千客，别欲论交一片心。","book":"唐·李白《江上赠窦长史》"},"similar":["三千珠履"],"usage":"作宾语、定语；指人很富有"},{"id":31635,"word":"珠投璧抵","pinyin":"zhū tóu bì dǐ","abbr":"ztbd","explanation":"谓以珠玉投掷鸟鹊。比喻人才不被重视。","source":{"text":"珠投璧抵亦何妨，国论惛呶重可伤。","book":"清·钱谦益《送曾霖寰使君左迁还里》诗之二"},"usage":"作宾语、定语；用于比喻句"},{"id":31636,"word":"珠槃玉敦","pinyin":"zhū pán yù dūn","abbr":"zpyd","explanation":"古代诸侯盟誓时用的器具。引申为订立盟约。","source":{"text":"敦，槃类，珠玉以为饰。古者以槃盛血，以敦盛食。合诸侯者必割牛耳，取其血歃之以盟。珠槃以盛牛耳，尸盟者执之。","book":"《周礼·天官·王府》：“合诸侯则供珠槃玉敦。”郑玄注"},"example":{"text":"～行人节，棘地荆天故国墟。","book":"柳亚子《恩来送余返津南村感赋》"},"similar":["珠盘玉敦"],"usage":"作主语、宾语、定语；指礼器"},{"id":31637,"word":"珠歌翠舞","pinyin":"zhū gē cuì wǔ","abbr":"zgcw","explanation":"指声色美妙的歌舞。","source":{"text":"冶叶倡条俱相识，仍惯见珠歌翠舞。","book":"宋·周邦彦《尉迟杯·离恨》词"},"example":{"text":"换羽移宫万里愁，～古梁州。","book":"清·吴伟业《圆圆曲》"},"usage":"作宾语、定语；用于书面语"},{"id":31638,"word":"珠残玉碎","pinyin":"zhū cán yù suì","abbr":"zcys","explanation":"比喻珍贵之物残破损坏。","source":{"text":"于友刘少彝取李杜集合刻之，前此非无合刻者，然苍素溷淆，元黄杂遝，笺注训诂，人自为政，蒙茸猥琐，犹疥厉虮虱，使二先生之作不免珠残玉碎。","book":"唐·王徲登《李翰林分体全集序》"},"similar":["珠残璧碎"],"usage":"作定语、状语；用于书面语"},{"id":31639,"word":"珠残璧碎","pinyin":"zhū cán bì suì","abbr":"zcbs","explanation":"比喻珍贵之物残破损坏","example":{"text":"不要等到～的时候才觉得可惜"},"similar":["珠残玉碎"],"usage":"作定语、状语；用于书面语"},{"id":31640,"word":"珠沉沧海","pinyin":"zhū chén cāng hǎi","abbr":"zcch","explanation":"珍珠沉在大海里。比喻人才被埋没。","source":{"text":"珠沉沧海，玉韫荆山，剑秽黄埃，奇韬远略运灵台，长狐封豕谁无赖。","book":"明·吾邱瑞《运甓记·师阃宾贤》"},"usage":"作宾语、定语；用于书面语"},{"id":31641,"word":"珠沉玉没","pinyin":"zhū chén yù mò","abbr":"zcym","explanation":"美玉破碎，珠宝沉没。比喻美女的死亡。","source":{"text":"珠沉玉没兮，人谁靡伤，桂殒兰凋兮，共泣摧香。","book":"唐·秦贯《唐故荥阳郑府君夫人博陵崔氏合祔墓志铭》"},"similar":["珠沉璧碎","珠沉玉陨","珠沉玉碎"],"usage":"作定语、状语；用于比喻句"},{"id":31642,"word":"珠沉玉碎","pinyin":"zhū chén yù suì","abbr":"zcys","explanation":"美玉破碎，珠宝沉没。比喻美女的死亡。","source":{"text":"若他强逼成姻眷，拼一个珠沉玉碎，蚤赴黄泉。","book":"唐·秦贯《唐故荥阳郑府君夫人博陵崔氏合祔墓志铭》：“珠沉玉没兮，人谁靡伤，桂殒兰凋兮，共泣摧香。”明·叶宪祖《鸾鎞记·仗侠》"},"example":{"text":"把左手向身后一绰，便要提起那把刀来，就想往项下一横，拼这副月貌花容，作一团～。","book":"清·文康《儿女英雄传》第十八回"},"similar":["玉陨香消","珠沉玉陨"],"usage":"作宾语、定语；比喻美女的死亡"},{"id":31643,"word":"珠沉玉磒","pinyin":"zhū chén yù zǐ","abbr":"zcyy","explanation":"比喻美女的死亡。同“珠沉玉碎”。","source":{"text":"及孝武承统，制度滋长，犬马馀菽粟，土木衣绨绣。追陋前规，更造正光、玉烛、紫极诸殿。雕栾绮节，珠窗网户。","book":"唐·李延寿《南史·循吏传序》"}},{"id":31644,"word":"珠沉玉陨","pinyin":"zhū chén yù yǔn","abbr":"zcyy","explanation":"比喻女子丧亡。同“珠沉玉碎”。","source":{"text":"鸳侣成方，鸾俦遽拆。珠沉玉陨，蕙折兰摧。","book":"清·袁枚《续新齐谐·乩仙》"},"similar":["珠沉玉碎","珠沉玉没","珠沉璧碎"],"usage":"作定语、状语；用于比喻句"},{"id":31645,"word":"珠沉璧碎","pinyin":"zhū chén bì suì","abbr":"zcbs","explanation":"比喻女子丧亡。同“珠沉玉碎”。","source":{"text":"生闻女死，讬以省姑，走吊焉；至则珠沉璧碎，玉损花飞，将入木矣。","book":"明·李昌祺《剪灯余话·凤尾草记》"},"example":{"text":"天厌善类，～。","book":"明·兰陵笑笑生《金瓶梅词话》第六十四回"},"similar":["珠沉玉没","珠沉玉碎","珠沉玉陨"],"usage":"作定语、状语；用于比喻句"},{"id":31646,"word":"珠泪偷弹","pinyin":"zhū lèi tōu tán","abbr":"zltd","explanation":"有泪只能在暗中流，形容受到委曲而悲伤的情形。","source":{"text":"调羹平日也还算有涵养，被人赶到这极头田地，便觉也就难受，背地里也不免珠泪偷弹。","book":"清·西周生《醒世姻缘传》第59回"},"example":{"text":"她只好偷偷地～。"},"similar":["向隅而泣"],"usage":"作谓语、宾语；指暗中哭泣"},{"id":31647,"word":"珠流璧转","pinyin":"zhū liú bì zhuǎn","abbr":"zlbz","explanation":"比喻时光之流逝。"},{"id":31648,"word":"珠玉之论","pinyin":"zhū yù zhī lùn","abbr":"zyzl","explanation":"形容精当的言论，卓越的见解。","source":{"text":"不聆珠玉之论。","book":"宋·胡继宗《书言故事·谈论类》"},"usage":"作宾语；用于书面语"},{"id":31649,"word":"珠玉在侧","pinyin":"zhū yù zài cè","abbr":"zyzc","explanation":"侧：旁边。比喻仪态俊秀的人在身边。","source":{"text":"骠骑王武子是卫玠之舅，俊爽有风姿。见玠辄叹曰：‘珠玉在侧，觉我形秽。’","book":"南朝宋·刘义庆《世说新语·容止》"},"similar":["珠玉在傍"],"usage":"作定语、状语；用于书面语"},{"id":31650,"word":"珠玉在傍","pinyin":"zhū yù zài bàng","abbr":"zyzb","explanation":"比喻仪态俊秀的人在身边。","source":{"text":"骠骑王武子是卫玠之舅，俊爽有风姿。见玠辄叹曰：‘珠玉在侧，觉我形秽。’","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"琳琅触目，朗月清风之俊人；～，鸾凤虬龙之君子。（唐·王勃《秋日游莲池序》）"},"similar":["珠玉在侧"],"usage":"作定语、状语；用于书面语"},{"id":31651,"word":"珠玑咳唾","pinyin":"zhū jī ké tuò","abbr":"zjkt","explanation":"珠玑：珠玉。比喻谈吐或文词美如珠玉。","source":{"text":"势家多所宜，咳唾自成珠。","book":"汉·赵壹《刺世疾邪赋》"},"example":{"text":"宋·陈师道《后山诗注·嘲秦观》：“若为借与春风看，无限～中。”"},"similar":["咳唾珠玑","咳唾成珠"],"usage":"作宾语、定语；用于比喻句"},{"id":31652,"word":"珠玑满腹","pinyin":"zhū jī mǎn fù","abbr":"zjmf","explanation":"玑：不圆的珠子；珠玑：比喻优美的文章。形容人很有文才。","source":{"text":"唐·杜牧《樊川文集》三：“一杯宽幕席，五字弄珠玑。”宋·吴处厚《表箱杂记》卷八：“只知外貌之粉泽，谁料满腹填珠玑。"},"example":{"text":"洪内翰～，锦绣盈肠，一只曲儿，有甚难处。","book":"明·冯梦龙《喻世明言》卷十五"}},{"id":31653,"word":"珠璧交辉","pinyin":"zhū bì jiāo huī","abbr":"zbjh","explanation":"比喻美好事物交相辉映。","source":{"text":"珠璧交辉近日边，上清高会敞琼筵。","book":"蔡寅《游上野博览会》诗"},"example":{"text":"他们有几个人称赞我那位朋友有福分，今天已经喝他令郎的喜酒了。有几个满口地说些‘～’‘鸾凤和鸣’的成语。","book":"叶圣陶《一个朋友》"},"usage":"作宾语、定语；指美好事物"},{"id":31654,"word":"珠璧联辉","pinyin":"zhū bì lián huī","abbr":"zblh","explanation":"比喻美好事物交相辉映。","source":{"text":"凤麟呈瑞吾何与，珠璧联辉世岂多。","book":"元·王结《偶感》诗"},"usage":"作宾语、定语；用于书面语"},{"id":31655,"word":"珠盘玉敦","pinyin":"zhū pán yù dūn","abbr":"zpyd","explanation":"古代诸侯盟誓时用的器具。引申为订立盟约。 同“珠槃玉敦”。","source":{"text":"骍毛白马，珠盘玉敦，陈辞乎方明之下，祝告于神明者也。","book":"南朝·梁·刘勰《文心雕龙·祝盟》"},"example":{"text":"忆昔在滃，同盟连翩；～，实惟九贤。","book":"明·张煌言《祭建国郑羽长文》"},"similar":["珠槃玉敦"],"usage":"作主语、宾语、定语；指礼器"},{"id":31656,"word":"珠窗网户","pinyin":"zhū chuāng wǎng hù","abbr":"zcwh","explanation":"饰珠、镂花的门窗。极言宫殿之奢侈华贵。","source":{"text":"及孝武承统，制度滋长，犬马馀菽粟，土木衣绨绣。追陋前规，更造正光、玉烛、紫极诸殿。雕栾绮节，珠窗网户。","book":"唐·李延寿《南史·循吏传序》"},"usage":"作宾语、定语；用于书面语"},{"id":31657,"word":"珠箔银屏","pinyin":"zhū bó yín píng","abbr":"zbyp","explanation":"箔：帘子；屏：屏风。珠缀的帘子，银制的屏风。多形容神仙洞府陈设华美。","source":{"text":"揽衣推枕起徘徊，珠箔银屏迤逦开。","book":"唐·白居易《长恨歌》诗"},"usage":"作主语、宾语、定语；指居室等"},{"id":31658,"word":"珠绕翠围","pinyin":"zhū rào cuì wéi","abbr":"zrcw","explanation":"珠：珍珠；翠：翡翠。形容富家女子的华丽装饰。亦比喻随从侍女众多。","source":{"text":"纷纭，绣幕雕轩，珠绕翠围，争妍夺俊。","book":"清·洪昇《长生殿·禊游》"},"similar":["珠围翠绕","珠围翠拥"],"usage":"作谓语、定语；形容人很富有"},{"id":31659,"word":"珠翠之珍","pinyin":"zhū cuì zhī zhēn","abbr":"zczz","explanation":"指水陆所产的美味食物。","source":{"text":"山鵽斥鷃，珠翠之珍。","book":"三国魏·曹植《七启》"},"similar":["山珍海味"],"usage":"作宾语；指美食"},{"id":31660,"word":"珠翠罗绮","pinyin":"zhū cuì luó qǐ","abbr":"zclq","explanation":"珠翠：珍珠翡翠；罗绮：华丽的丝织品。指妇女华丽的衣饰。也指盛装的妇女。","source":{"text":"江干上下十余里间，珠翠罗绮溢目，车马塞途。","book":"宋·周密《武林旧事·观潮》"},"usage":"作宾语、定语；用于书面语"},{"id":31661,"word":"珠联玉映","pinyin":"zhū lián yù yìng","abbr":"zlyy","explanation":"本指一种天象。同“珠联璧合”。","source":{"text":"右此十四公，皆吾生平宗师追仰所不能及者，留心既久，故闲得而议之。至若古今诗人，自是珠联玉映，则又有不得而知也已。","book":"《苕溪渔隐丛话后集·张芸叟》引宋·蔡絛《西清诗话》"},"example":{"text":"措思削词皆可法，余则～，尤未易编述也。","book":"宋·范晞文《对床夜语》卷三"},"similar":["珠连璧合","珠联璧合"],"usage":"作谓语、宾语；指十分完美"},{"id":31662,"word":"珠联璧合","pinyin":"zhū lián bì hé","abbr":"zlbh","explanation":"璧：平圆形中间有孔的玉。珍珠联串在一起，美玉结合在一块。比喻杰出的人才或美好的事物结合在一起。","source":{"text":"日月如合璧，五星如连珠。","book":"《汉书·律历志上》"},"example":{"text":"便是你两个，当日无心相遇，也想不到今日～，作了同床姐妹。","book":"清·文康《儿女英雄传》第二十八回"},"similar":["相得益彰","相辅相成"],"usage":"作谓语、宾语；指十分完美"},{"id":31663,"word":"珠落玉盘","pinyin":"zhū luò yù pán","abbr":"zlyp","explanation":"珍珠落在宝玉盘子里。比喻声音十分动听。","source":{"text":"嘈嘈切切错杂弹，大珠小珠落玉盘。","book":"唐·白居易《琵琶行》"},"example":{"text":"虽在重伤之余，又学了青城派这些人的四川口音，但一番话说来犹如～，动听之极。（金庸《天龙八部》第十九回）"},"usage":"作宾语、定语；用于比喻句"},{"id":31664,"word":"珠襦玉匣","pinyin":"zhū rú yù xiá","abbr":"zryx","explanation":"珠襦：用珠缀串成的短衣；玉匣：汉代皇帝的葬具，即玉衣。指古代帝后诸侯王的葬服。","source":{"text":"汉帝送死皆珠襦玉匣，匣形如铠甲，连以金镂，武帝匣上皆镂为蛟龙鸾凤龟龙之象，世谓为蛟龙玉匣。","book":"晋·葛洪《西京杂记》卷一"},"example":{"text":"特传旨另备～，改建坟茔，待朕亲临迁葬，因此驻跸马嵬驿中。","book":"清·洪昇《长生殿·改葬》"}},{"id":31665,"word":"珠规玉矩","pinyin":"zhū guī yù jǔ","abbr":"zgyj","explanation":"比喻人的言行纯正合乎规矩。","source":{"text":"某王孙者，家城中，珠规玉矩，不苟言笑。","book":"清·龚自珍《瑶台第一层》词附某侍卫《王孙传》"},"usage":"作宾语、定语；用于书面语"},{"id":31666,"word":"珠辉玉丽","pinyin":"zhū huī yù lì","abbr":"zhyl","explanation":"珠生辉，玉瑰丽。比喻佳丽的肌肤之美。","source":{"text":"妃子，只见尔款解云衣，早现出珠辉玉丽。","book":"清·洪昇《长生殿·窥浴》"},"example":{"text":"她打扮得～。"},"usage":"作谓语、定语、状语；用于女性"},{"id":31667,"word":"珠辉玉映","pinyin":"zhū huī yù yìng","abbr":"zhyy","explanation":"珍珠和宝玉相互辉映。","source":{"text":"斯赋之盛，珠辉玉映。可以发昏蒙，佐明圣。为前古之楷式，作後来之龟镜。非寡人之所知，敢不承天之命。","book":"唐·徐寅《歌赋》"},"example":{"text":"小弟虽年少，浪游江湖，阅人多矣，从不曾见先生～，真乃天上仙班。（清·吴敬梓《儒林外史》第二十九回）"}},{"id":31668,"word":"珠还合浦","pinyin":"zhū huán hé pǔ","abbr":"zhhp","explanation":"合浦：汉代郡名，在今广西合浦县东北。比喻东西失而复得或人去而复回。","source":{"text":"（合浦）郡不产谷实，而海出珠宝，与交阯比境……尝到官，革易前敝，求民病利。曾未逾岁，去珠复还，百姓皆反其业。","book":"《后汉书·循吏传·孟尝》"},"example":{"text":"锦富爱妾，一朝剑折延津，远道孤儿，万里～。","book":"明·凌濛初《二刻拍案惊奇》卷三十二"},"similar":["失而复得","还珠合浦"],"usage":"作宾语、定语；引申为政策好","story":["东汉时期，合浦郡盛产珍珠闻名海外，当地老百姓以采珠为生，贪官污吏趁机盘剥，使得珠民大肆捕捞，珠蚌产量越来越低，饿死不少人。汉顺帝刘保派孟尝当合浦太守，他革除弊端，不准滥捕。不到一年，合浦又盛产珍珠了"]},{"id":31669,"word":"珠连璧合","pinyin":"zhū lián bì hé","abbr":"zlbh","explanation":"指日月、五星同时出现于天的一方。亦泛指日月五星普照天下。","source":{"text":"谓太初上元甲子夜半朔旦冬至时，七曜皆会聚斗、牵牛分度，夜尽如合璧连珠也。","book":"语本《汉书·律历志上》：“日月如合璧，五星如连珠。”颜师古注引孟康曰"},"example":{"text":"诏传四海，仰～之光；书遍万方，钦金玺纶音之盛。","book":"中国近代史资料丛刊《太平天国·诏书盖玺颁行论》"},"similar":["珠联璧合","珠联玉映"],"usage":"作谓语、宾语、定语；指十分完美"},{"id":31670,"word":"珠零玉落","pinyin":"zhū líng yù luò","abbr":"zlyl","explanation":"比喻珍物残破毁坏。","source":{"text":"为铭为诗，赞能颂美，烂然卷轴……逮今盖七十年，珠零玉落，无复存者。","book":"元·同恕《萱堂记》"},"usage":"作谓语、定语；用于书面语"},{"id":31671,"word":"珠零锦粲","pinyin":"zhū líng jǐn càn","abbr":"zljc","explanation":"指如珠玉之铿零，锦绣之灿烂。比喻文词华丽、铿锵。","source":{"text":"口吐琼音，手挥霄翰，弹毫珠零，落纸锦粲。","book":"语本《 魏书·宗钦传》"},"example":{"text":"［诸生］此日驰驱文囿，竞吐～之词；他年黼黻皇猷，伫收秋实春华之用。","book":"清·林则徐《杭嘉湖三郡告示》"},"usage":"作宾语、定语；用于比喻句"},{"id":31672,"word":"珥金拖紫","pinyin":"ěr jīn tuō zǐ","abbr":"ejtz","explanation":"珥：插；拖：下垂。形容官位显赫。","source":{"text":"明祭酒虽出抚大藩，拥旄推轂，珥金拖紫，而恒事屡空。","book":"《梁书·明山宾传》"},"similar":["背紫腰金"],"usage":"作谓语、定语；指地位显赫"},{"id":31673,"word":"珪璋特达","pinyin":"guī zhāng tè dá","abbr":"gztd","explanation":"比喻人资质优异，才德出众。","source":{"text":"行聘之时，唯执圭璋特得通达，不加馀币。言人之有德亦无事不通，不须假他物而成。言圭璋之特达同人之有德，故云德也。","book":"《礼记·聘义》：“圭璋特达，德也。”孔颖达疏"}},{"id":31674,"word":"班功行赏","pinyin":"bān gōng xíng shǎng","abbr":"bgxs","explanation":"按照功劳大小，依次给予赏赐。","source":{"text":"举厝至重，不可不慎。班功行赏，宜应其实。","book":"南朝·宋·范晔《后汉书·李云传》"},"similar":["按功行赏","按劳计酬"],"usage":"作谓语、宾语；指奖励"},{"id":31675,"word":"班师回俯","pinyin":"bān shī huí fǔ","abbr":"bshf","explanation":"指出征的军队胜利返回朝廷。同“班师回朝”。","source":{"text":"我们的球队终于获得了甲A联赛冠军，队员们今天～。"}},{"id":31676,"word":"班师回朝","pinyin":"bān shī huí cháo","abbr":"bshc","explanation":"班：调回。调动出征的军队返回首都，指出征的军队胜利返回朝廷。","source":{"text":"你奉圣旨破吐蕃，定西夏，班师回朝，便当请功受赏。","book":"元·乔孟符《两世姻缘》第三折"},"example":{"text":"后主（刘禅）下诏，宣孔明班师回朝。","book":"明·罗贯中《三国演义》第一百回"},"similar":["凯旋而归"],"usage":"作谓语、宾语；指退兵"},{"id":31677,"word":"班师得胜","pinyin":"bān shī dé shèng","abbr":"bsds","explanation":"班：还。军队出征，得胜而归。","source":{"text":"将颜洞宾活捉拿，把韩延寿首级剽，班师得胜人欢乐，三军踊跃。","book":"明·无名氏《破天阵》三折"},"similar":["得胜回朝"],"usage":"作谓语；指胜利"},{"id":31678,"word":"班师振旅","pinyin":"bān shī zhèn lǚ","abbr":"bszl","explanation":"班：调回；师、旅：指军队；振：整顿。撤回军队，进行整顿。","source":{"text":"禹拜昌言，曰：‘俞。’班师振旅。","book":"《尚书·大禹漠》"},"usage":"作谓语、定语；指休整"},{"id":31679,"word":"班班可考","pinyin":"bān bān kě kǎo","abbr":"bbkk","explanation":"班班：明显的样子。指事情源流始末清清楚楚，可以考证。","source":{"text":"本朝二百年之间，学问文章、政事术业，各有家法，其本末源流，班班可考。","book":"宋·陈亮《与韩无咎尚书》"},"example":{"text":"亦尝有此言，明载简册，～。","book":"清·钱彩《说岳全传》第七十三回"},"similar":["有据可查"],"usage":"作谓语、定语；用于说话或文章等"},{"id":31680,"word":"班荆道故","pinyin":"bān jīng dào gù","abbr":"bjdg","explanation":"班：铺开；道：叙说。用荆铺在地上坐在上面谈说过去的事情。形容老朋友在路上碰到了，坐下来谈谈别后的情况。","source":{"text":"伍举奔郑，将遂奔晋。声子将如晋，遇之于郑郊，班荆相与食，而言复故。","book":"《左传·襄公二十六年》"},"example":{"text":"一次邂逅相逢，一次～，竟使一位艺术殉道者在冥冥里忽闻天籁，于混沌中顿悟禅机。”","book":"李存葆《伏虎草堂主人》"},"similar":["班荆道旧"],"usage":"作谓语；指好友相逢","story":["春秋时期，楚国的伍参与蔡国的子朝是好朋友，他们的儿子伍举与声子也是好朋友。伍举因为岳父王子弁犯罪而逃到郑都城郊外，与声子相见，他们马上拔下路边的荆草铺在地上相对而坐，互相倾诉衷肠。声子后终于为伍举平反"]},{"id":31681,"word":"班荆道旧","pinyin":"bān jīng dào jiù","abbr":"bjdj","explanation":"指朋友相遇于途，铺荆坐地，共叙情怀。后泛指朋友相遇，共叙离情。亦作“班荆道故”。","source":{"text":"班，布也。布荆坐地，共议归楚，事朋友世亲。","book":"典出《左传·襄公二十六年》：“楚伍参与蔡太师子朝友，其子伍举与声子相善……伍举奔郑，将遂奔晋。声子将如晋，遇之於郑郊，班荆相与食，而言复故。”杜预注"},"example":{"text":"鲍叔、管仲，分财无猜；归生、伍举，～。","book":"晋·陶潜《与子俨等疏》"},"similar":["班荆道故"],"usage":"作谓语；指好友相逢","story":["春秋时期，楚国的伍参与蔡国的子朝是好朋友，他们的儿子伍举与声子也是好朋友。伍举因为岳父王子弁犯罪而逃到郑都城郊外，与声子相见，他们马上拔下路边的荆草铺在地上相对而坐，互相倾诉衷肠。声子后终于为伍举平反"]},{"id":31682,"word":"班行秀出","pinyin":"bān háng xiù chū","abbr":"bxxc","explanation":"班行：班次行列，指在朝为官的位次，后也指同列、同辈；秀出：高出，引申为才能出众，优秀。才能优秀，超出同辈。","source":{"text":"秀出班行，乃动帝目。","book":"唐·韩愈《太原王公神道碑铭》"},"example":{"text":"自后代兴有人，而～者，无过倚霞。","book":"清·捧花生《秦淮画舫录·纪丽·王倚霞》"}},{"id":31683,"word":"班衣戏彩","pinyin":"bān yī xì cǎi","abbr":"byxc","explanation":"指身穿彩衣，作婴兒戏耍以娱父母。后以之为老养父母的孝亲典故。","source":{"text":"参见“斑衣戏彩”。"},"example":{"text":"虽无儿，效老莱，～。","book":"清·新广东武生《黄萧养回头》"},"similar":["老莱娱亲"],"usage":"作宾语、定语；指讨父母欢心","story":["春秋时期，楚国隐士老莱子非常孝顺父母，想尽一切办法讨父母的欢心，使他们健康长寿。他70岁时父母还健在，为了不让父母见他有白发而伤感，他做一套五彩斑斓的衣服穿在身上，走路时装成小儿跳舞的样子使父母高兴"]},{"id":31684,"word":"班衣戏采","pinyin":"bān yī xì cǎi","abbr":"byxc","explanation":"相传老莱子七十岁时穿彩衣作儿戏以娱亲。后以之为老养父母的孝亲典故。","source":{"text":"虽无儿，效老莱，班衣戏采。","book":"清·新广东武生《黄萧养回头》"}},{"id":31685,"word":"班门弄斧","pinyin":"bān mén nòng fǔ","abbr":"bmnf","explanation":"在鲁班门前舞弄斧子。比喻在行家面前卖弄本领，不自量力。","source":{"text":"昨在真定，有诗七八首，今录去，班门弄斧，可笑可笑。","book":"唐·柳宗元《王氏伯仲唱和诗序》：“操斧于班、郢之门，斯强颜耳。”宋·欧阳修《与梅圣俞书》"},"example":{"text":"闻得亭亭姐姐学问渊博，妹子何敢～，同他乱谈。","book":"清·李汝珍《镜花缘》第五十二回"},"similar":["布鼓雷门","贻笑大方"],"opposite":["虚怀若谷","自知之明","知人之明"],"usage":"作谓语、定语、状语、宾语；指能力不如人","story":["唐代“诗仙”李白酒醉落江而死，葬在当涂牛渚山上的采石矶。历代文人墨客均在此留诗凭吊，明朝诗人梅之涣有自知之明，题诗“采石江边一坯土，李白诗坛耀千古。来的去的写两行，鲁班门前掉大斧。”"]},{"id":31686,"word":"班门调斧","pinyin":"bān mén diào fǔ","abbr":"bmdf","explanation":"班：鲁班，春秋时期鲁国人，著名的木匠；调：耍弄。在鲁班门前舞弄斧子。比喻在行家面前卖弄本领，不自量力","source":{"text":"庸碌小巫，怎敢在班门调斧，然老先生台命殷殷，又不敢违，却将奈何？","book":"清·荑荻散人《玉娇梨》第八回"},"similar":["班门弄斧"],"usage":"作谓语、定语、状语、宾语；表示能力不如人"},{"id":31687,"word":"班香宋艳","pinyin":"bān xiāng sòng yàn","abbr":"bxsy","explanation":"班固和宋玉均善辞赋，以富丽见称，后以之泛称辞赋之美者。","source":{"text":"早岁清词，吐出班香宋艳；中年浩气，流成苏海韩潮。","book":"清·孔尚任《桃花扇·听稗》"},"usage":"作宾语、定语；指好文章"},{"id":31688,"word":"班马文章","pinyin":"bān mǎ wén zhāng","abbr":"bmwz","explanation":"汉代史学家司马迁与班固的并称。泛指可与班固、司马迁相比美的文章。","source":{"text":"夔龙礼乐承先范，班马文章勘墨铅。","book":"明·无名氏《鸣凤记·邹林游学》"},"example":{"text":"～由夙慧，庾鲍诗句实前缘。","book":"清·刘璋《飞花艳想》第二回"},"usage":"作宾语、定语；指优秀文章"},{"id":31689,"word":"班驳陆离","pinyin":"bān bó lù lí","abbr":"bbll","explanation":"形容色彩杂沓。","source":{"text":"参见“斑驳陆离”。"},"example":{"text":"此铃金质坚炼，制度浑朴，～。","book":"清·韩泰华《无事为福斋随笔》"},"similar":["斑驳陆离"],"usage":"作谓语、定语；形容景物"},{"id":31690,"word":"琅嬛福地","pinyin":"láng huán fú dì","abbr":"lhfd","explanation":"传说中仙人所居多书的洞府。","source":{"text":"其人笑曰：‘君痴矣，此岂可赁地耶？’即命小童送出。华问地名。曰：‘琅嬛福地也。’","book":"元·伊世珍《琅嬛记》上卷"},"example":{"text":"如入～，痴龙护门，人迹罕到。","book":"清·张岱《快园记》"},"similar":["洞天福地"],"usage":"作宾语；指洞天福地","story":["传说古代书生张华路过一高山，山陡如壁，奇峰怪石，恰好路边有一山洞，他好奇地进入，没走几步便有童子上来引路，径直把他引到一书房，那里各种藏书应有尽有。张华十分高兴，想租借此书房一段时间。童子不允，告诉他这是琅嬛福地"]},{"id":31691,"word":"琅琅上口","pinyin":"láng láng shàng kǒu","abbr":"llsk","explanation":"琅琅：玉石相击声，比喻响亮的读书声。指诵读熟练、顺口。也指文辞通俗，便于口诵。","source":{"text":"自幼即喜识字，授以唐诗，琅琅上口。","book":"清·王韬《淞隐漫录·凌波女史》"},"example":{"text":"但在我自己有记忆的二、三岁时，她已经把唐诗绝句教我暗诵，能诵得～。","book":"郭沫若《沸羹集·如何研究诗歌与文艺》"},"similar":["字正腔圆","抑扬顿挫"],"opposite":["诘屈聱牙"],"usage":"作宾语、定语、补语；指读书声"},{"id":31692,"word":"理不忘乱","pinyin":"lǐ bù wàng luàn","abbr":"lbwl","explanation":"国家得以平安治理的时候，不能忘记混乱的日子。","source":{"text":"伏惟陛下安不忘危，理不忘乱，存不忘亡，则克享天心，国家长保矣。","book":"《旧唐书·柳泽传》"},"example":{"text":"然而安不忘危，～，糜不有初，鲜克有终，古圣贤之深旨也。","book":"宋·王禹偁《进端拱箴表》"},"similar":["安不忘危"],"usage":"作宾语、定语；用于处事"},{"id":31693,"word":"理不胜词","pinyin":"lǐ bù shèng cí","abbr":"lbsc","explanation":"说理不能胜过文辞。指文章的用词遣字好，说理则不够畅达。","source":{"text":"说理不能胜过文辞。指文章的用词遣字好，说理则不够畅达。"},"similar":["理不胜辞"],"opposite":["理过其辞"],"usage":"作宾语、定语；用于文章等"},{"id":31694,"word":"理不胜辞","pinyin":"lǐ bù shèng cí","abbr":"lbsc","explanation":"道理不能胜过文辞。指由于不善于推理立论，尽管文辞丰富多彩，道理并不充分。","source":{"text":"孔融体气高妙，有过人者，然不能持论，理不胜辞，至于杂以嘲戏，及其所善，扬、班俦也。","book":"三国·魏·曹丕《曲论·论文》"},"example":{"text":"写议论文并不一定要求强调～"},"similar":["理不胜词"],"usage":"作宾语、定语；用于说话、文章等"},{"id":31695,"word":"理之当然","pinyin":"lǐ zhī dāng rán","abbr":"lzdr","explanation":"理所当然，理应如此。","source":{"text":"此原是君家之物，今日来取，理之当然。","book":"明·凌濛初《二刻拍案惊奇》第36卷"},"example":{"text":"既不得安生，亦是～，奴亦无怨。","book":"清·曹雪芹《红楼梦》第69回"},"similar":["理所当然"],"usage":"作谓语、定语；同“理所当然”"},{"id":31696,"word":"理亏心虚","pinyin":"lǐ kuī xīn xū","abbr":"lkxx","explanation":"因理由不充分而担心。","example":{"text":"他～，就溜之大吉。"},"opposite":["理直气壮"],"usage":"作谓语、宾语；指人心虚"},{"id":31697,"word":"理冤摘伏","pinyin":"lǐ yuān tì fú","abbr":"lyzf","explanation":"伸雪冤屈，揭发奸慝。","source":{"text":"这三起事都问得绝妙，理冤摘伏么可也如神。","book":"明·徐渭《女状元》第四出"}},{"id":31698,"word":"理冤擿伏","pinyin":"lǐ yuān tī fú","abbr":"lytf","explanation":"理：治理；擿伏：揭发隐秘的坏事。伸雪冤屈，揭发隐秘的坏事。","source":{"text":"这三起事都问得绝妙，理冤擿伏么可也如神。","book":"明·徐渭《女状元》第四出"},"similar":["理冤摘伏"],"usage":"作宾语、定语；用于书面语"},{"id":31699,"word":"理冤释滞","pinyin":"lǐ yuān shì zhì","abbr":"lysz","explanation":"滞：滞狱，长期积压难以判决的疑案。辩白冤案，洗雪滞狱。","source":{"text":"以先生之才，宜不出于他人之下，其于理冤释滞，宁有不尽其心者。","book":"明·归有光《杨渐斋寿序》"}},{"id":31700,"word":"理固当然","pinyin":"lǐ gù dāng rán","abbr":"lgdr","explanation":"理：道理；当然：应该这样。按道理应当这样。","source":{"text":"非辩也，理当然耳。","book":"隋·王通《文中子·魏相篇》"},"example":{"text":"詹事张九思曰：“正臣防微，～。”","book":"清·毕沅《续资治通鉴》卷一百八十七"},"similar":["理所当然"],"usage":"作谓语、定语、状语；指理应如此"},{"id":31701,"word":"理屈事穷","pinyin":"lǐ qū shì qióng","abbr":"lqsq","explanation":"没有道理，事情亦已穷尽。","source":{"text":"既被摧摄，二三日甫输帖，，虽理屈事穷，犹闻义耻服。","book":"南朝·宋·何承天《奏劾博士顾雅等》"},"usage":"作宾语、定语；用于处境"},{"id":31702,"word":"理屈词穷","pinyin":"lǐ qū cí qióng","abbr":"lqcq","explanation":"屈：短，亏；穷：尽。由于理亏而无话可说。","source":{"text":"子路之言，非其本意，但理屈词穷，而取辩于口以御人耳。","book":"《论语·先进》：“是故恶夫佞者”宋·朱熹集注"},"example":{"text":"并不等候答复，而正如一般忽然陷于～的专横者一样，他立刻把最后一张牌摆出来了。","book":"沙汀《呼嚎》"},"similar":["张口结舌","无言以对","哑口无言"],"opposite":["义正言辞","理直气壮","振振有词"],"usage":"作谓语、定语、状语；指人理亏"},{"id":31703,"word":"理应如此","pinyin":"lǐ yìng rú cǐ","abbr":"lyrc","explanation":"指按理应该这样。","example":{"text":"～，你不必多说了。"},"similar":["理所当然"],"usage":"作谓语、分句；指应该这样"},{"id":31704,"word":"理所不容","pinyin":"lǐ suǒ bù róng","abbr":"lsbr","explanation":"道理所不能允许。","source":{"text":"且冲与扶风王言，显彰宣帝之短，对子毁父，理所不容。","book":"《三国志·蜀志·诸葛亮传》裴松之注"},"example":{"text":"至于出纳斗斛，亦小大不一，此皆～者，而台官初不问。","book":"《金史·宣宗下》"},"opposite":["合情合理"],"usage":"作谓语、定语；用于无理的事物"},{"id":31705,"word":"理所当然","pinyin":"lǐ suǒ dāng rán","abbr":"lsdr","explanation":"当然：应当如此。按道理应当这样。","source":{"text":"非辩也，理当然耳。","book":"隋·王通《文中子·魏相篇》"},"example":{"text":"善者福而恶者祸，～。","book":"明·赵弼《续东窗事犯传》"},"similar":["天经地义","不容置疑"],"opposite":["不以为然","岂有此理"],"usage":"作谓语、定语、状语；指理应如此"},{"id":31706,"word":"理所必然","pinyin":"lǐ suǒ bì rán","abbr":"lsbr","explanation":"指按道理必定如此。","source":{"text":"若有始也，则不能为终，唯无始也然后始终无穷，此自是理所必然。","book":"南朝·齐·僧佑《弘明集·神不灭论》"},"example":{"text":"这是～的事。"},"similar":["理所当然"],"usage":"作谓语、定语；指一定如此"},{"id":31707,"word":"理枉雪滞","pinyin":"lǐ wǎng xuě zhì","abbr":"lwxz","explanation":"滞：滞狱，长期积压难以判决的疑案。辩白冤案，洗雪滞狱。","source":{"text":"若慎刑狱，重人命，理枉雪滞，尤谆谆焉。","book":"明·吴廷翰《大中丞肖斋龚公迁大理卿序》"}},{"id":31708,"word":"理正词直","pinyin":"lǐ zhèng cí zhí","abbr":"lzcz","explanation":"道理正当，言词朴直。","source":{"text":"心平气和，理正词直，然后为文之体，可以追配古作。","book":"宋·楼钥《答綦君更生论文书》"},"usage":"作定语、状语；用于处事"},{"id":31709,"word":"理直气壮","pinyin":"lǐ zhí qì zhuàng","abbr":"lzqz","explanation":"理直：理由正确、充分；气壮：气势旺盛。理由充分，说话气势就壮。","source":{"text":"便捉我到阎罗殿前，我也理直气壮，不怕甚的。","book":"明·冯梦龙《古今小说》卷三十一"},"example":{"text":"只要我们～，怕他怎的！","book":"清·李宝嘉《官场现形记》第十七回"},"similar":["振振有词","义正言辞"],"opposite":["强词夺理","理屈词穷"],"usage":"作谓语、定语、状语；指在理"},{"id":31710,"word":"理纷解结","pinyin":"lǐ fēn jiě jié","abbr":"lfjj","explanation":"理纷乱，除疙瘩。","source":{"text":"什么纠纷，什么葛藤，到了他手里，都是一刀两断。正眼也不去瞧，不用说靠他理纷解结了！","book":"朱自清《山野掇拾》"},"usage":"作谓语、宾语；用于处事"},{"id":31711,"word":"理胜其辞","pinyin":"lǐ shèng qí cí","abbr":"lsqc","explanation":"道理胜过文辞。指由于善于推理立论，尽管文辞简略质朴，道理却很充分。","source":{"text":"或文过其意，或理胜其辞，以此考彼，殆兼先典。","book":"晋·释惠远《三法度经序》"},"example":{"text":"观中古以来为赋者多矣，相如《子虚》擅名于前，班固《两都》～，张衡《二京》文过其意。","book":"《晋书·左思传》"}},{"id":31712,"word":"理过其辞","pinyin":"lǐ guò qí cí","abbr":"lgqc","explanation":"说理多而文采不足。","source":{"text":"永嘉时，贵黄老，稍尚虚谈，于时篇什，理过其辞，淡乎寡味。","book":"南朝·梁·钟嵘《诗品》卷上"},"opposite":["理不胜词"],"usage":"作宾语、定语；用于文章等"},{"id":31713,"word":"琐尾流离","pinyin":"suǒ wěi liú lí","abbr":"swll","explanation":"琐尾：细小时美好；流离：枭的别名。枭细小时怪可爱，长大后却非常丑恶。比喻处境由顺利转为艰难。","source":{"text":"琐兮尾兮，流离之子。","book":"《诗经·邶风·旄丘》"},"example":{"text":"竿摩辙乱逼西迁，～倏一年。","book":"清·黄遵宪《车驾驻开封府》诗"},"similar":["流离琐尾"],"usage":"作谓语、宾语；指由顺转逆"},{"id":31714,"word":"琐琐屑屑","pinyin":"suǒ suǒ xiè xiè","abbr":"ssxx","explanation":"指烦碎细小。","source":{"text":"小园草地里的小虫琐琐屑屑地在夜谈。","book":"钱钟书《围城》"},"example":{"text":"尽自问着杭州的情形，～，无不关怀。","book":"高阳《胡雪岩全传·红顶商人》"},"similar":["琐琐碎碎"],"usage":"作定语、状语；用于书面语"},{"id":31715,"word":"琐琐碎碎","pinyin":"suǒ suǒ suì suì","abbr":"ssss","explanation":"零碎细小的事物。","source":{"text":"又被镇守装模作样，琐琐碎碎，心下又好恼，又好笑。","book":"清·名教中人《好逑传》第九回"},"example":{"text":"算法是一样的，家用帐～，我的帐只有几样东西，还比家用帐好记。","book":"高阳《胡雪岩全传·平步青云》中册"},"similar":["琐琐屑屑"],"usage":"作宾语、定语、状语；多用于口语"},{"id":31716,"word":"琢玉成器","pinyin":"zhuó yù chéng qì","abbr":"zycq","explanation":"琢：雕琢。比喻经过修磨锻炼，方能成器成才。","source":{"text":"玉不琢，不成器。","book":"西汉·戴圣《礼记·学记》"},"example":{"text":"～，观古知今，历代哲王，莫不崇尚。","book":"《旧唐书·经籍志上》"},"opposite":["玉不琢，不成器"],"usage":"作谓语、定语；指培育人才"},{"id":31717,"word":"琥珀拾芥","pinyin":"hǔ pò shí jiè","abbr":"hpsj","explanation":"芥：小草，引申为轻微纤细的东西。琥珀摩擦后生电，能吸引细小的东西。比喻互相感应。","source":{"text":"顿牟拾芥，磁石引针。","book":"汉·王充《论衡·乱龙》"},"usage":"作宾语；用于事物之间"},{"id":31718,"word":"琨玉秋霜","pinyin":"kūn yù qiū shuāng","abbr":"kyqs","explanation":"比喻坚贞劲烈的品质。","source":{"text":"懔懔焉，皓皓焉，其与琨玉秋霜比质可也。","book":"南朝·宋·范晔《后汉书·孔融传论》"},"usage":"作宾语、定语；指人的品性"},{"id":31719,"word":"琪花玉树","pinyin":"qí huā yù shù","abbr":"qhys","explanation":"古人指仙景中的花木，亦以形容霜雪中的景色。","source":{"text":"风光长如二三月，琪花玉树不识人间秋。","book":"元·杨维桢《梦游沧海歌》"},"example":{"text":"荒草靡靡，山高风冽，草上结霜高寸许，而四山回映，～，玲珑弥望。","book":"明·徐宏祖《徐霞客游记·游天台山日记》"},"usage":"作主语、宾语、定语；用于仙境或雪景"},{"id":31720,"word":"琪花瑶草","pinyin":"qí huā yáo cǎo","abbr":"qhyc","explanation":"琪、瑶：美玉。原为古人想象中仙境的花草。后也形容晶莹美丽的花草。","source":{"text":"前程渐觉风光好，琪花片片粘瑶草。","book":"王轂《梦仙谣》"},"example":{"text":"有座天生石台，直靠在海外，如建康营燕子一样，玲珑剔透，文采可观，遍生～。","book":"清·陈忱《水浒后传》第三十六回"},"similar":["奇花异草","瑶草琪花","异草奇花"],"usage":"作主语、宾语、定语；指奇花异草"},{"id":31721,"word":"琳琅满目","pinyin":"lín láng mǎn mù","abbr":"llmm","explanation":"琳琅：精美的玉石。满眼都是珍贵的东西。形容美好的事物很多。","source":{"text":"今日之行，触目见琳琅珠玉。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"这些寿礼陈列在坤宁宫的东西庑中，～。","book":"姚雪垠《李自成》第二卷第三十一章"},"similar":["金碧辉煌","美不胜收"],"opposite":["疮痍满目"],"usage":"作谓语、定语、状语；指满眼都是珍贵的东西"},{"id":31722,"word":"琳琅触目","pinyin":"lín láng chù mù","abbr":"llcm","explanation":"原指所见皆名流。后指眼前所见都是珍贵的物品或美好的诗文。","source":{"text":"有人诣王太尉，遇安丰、大将军、丞相在坐。往别屋，见季胤、平子。还，语人曰：‘今日之行，触目见琳琅珠玉。’","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"［棉村］次日以所作来示，片纸零书，～。","book":"清·钮琇《觚剩续编·棉村丽句》"},"similar":["琳琅满目"],"usage":"作谓语、定语、状语；指满眼是珍品"},{"id":31723,"word":"琴剑飘零","pinyin":"qín jiàn piāo líng","abbr":"qjpl","explanation":"琴：乐器；剑：兵器；飘：飘泊；零：孤零。指文人潦倒失意，落拓四方。","source":{"text":"琴剑飘零西复东，旧游清兴几时同？","book":"明·钱晔《赠周歧凤》"},"example":{"text":"～千里别，江湖涕泪一身多。","book":"陈巢南《归家杂感》"},"similar":["漂泊不定"],"usage":"作宾语；指文人潦倒失意"},{"id":31724,"word":"琴心剑胆","pinyin":"qín xīn jiàn dǎn","abbr":"qxjd","explanation":"比喻既有情致，又有胆识（旧小说多用来形容能文能武的才子）。","source":{"text":"小榻琴心展，长缨剑胆舒。","book":"元·吴莱《寄董与几》诗"},"example":{"text":"你如莫邪刚，并剪快，哀梨脆，～羞姿媚。","book":"清·嬴宗季女《六月霜》第三出"},"similar":["文武双全"],"usage":"作宾语；指人的情趣与胆识"},{"id":31725,"word":"琴心相挑","pinyin":"qín xīn xiāng tiǎo","abbr":"qxxt","explanation":"以琴声传达心意，表示爱情。","source":{"text":"是时卓王孙有女文君新寡，好音，故相如缪与令相重，而以琴心挑之。","book":"《史记·司马相如列传》"},"example":{"text":"你雄姿秀骨风度好，瞥然见把人魂消，又不是～，一意愿咏桃夭，谐白发附青霄。","book":"明·屠隆《昙花记·超度沉迷》"},"usage":"作宾语、定语；用于情爱","story":["西汉时期，辞赋家司马相如在梁孝王死后回到成都老家，他家十分贫寒，生活十分艰难。他的朋友邻邛县令王吉邀请他去大财主卓王孙家去做客。他看上了卓王孙的寡妇女儿卓文君，两人以琴心相挑，回到他那家徒四壁的家，开始过他们清苦的生活"]},{"id":31726,"word":"琴挑文君","pinyin":"qín tiāo wén jūn","abbr":"qtwj","explanation":"挑：挑逗、挑引。比喻挑动对方的爱慕之情，并表达自己的爱意。亦作“琴心相挑”。","source":{"text":"是时卓王孙有女文君新寡，好音，故相如缪与今相重，而以琴心挑之。","book":"《史记·司马相如列传》"}},{"id":31727,"word":"琴断朱弦","pinyin":"qín duàn zhū xián","abbr":"qdzx","explanation":"比喻妇女死掉丈夫。","source":{"text":"奴家杨氏，幼适裴门，琴断朱弦，不幸文君早寡，香含青琐，肯容韩掾轻偷。","book":"清·洪昇《长生殿·幸恩》"},"usage":"作谓语；指死了丈夫"},{"id":31728,"word":"琴棋书画","pinyin":"qín qí shū huà","abbr":"qqsh","explanation":"弹琴、弈棋、写字、绘画。常以表示个人的文化素养。","source":{"text":"唐高测，彭州人。聪明博识，文翰纵横。至于天文历数，琴棋书画，长笛胡琴，率梁朝朱异之流。","book":"宋·孙光宪《北梦琐言》卷五"},"example":{"text":"不拘描龙绣凤，件件皆精，～，般般都会。","book":"清·张南庄《何典》第七回"},"similar":["文房四艺"],"usage":"作主语、宾语、定语；多用于女性"},{"id":31729,"word":"琴歌酒赋","pinyin":"qín gē jiǔ fù","abbr":"qgjf","explanation":"弹琴、唱歌、饮酒、赋诗。旧皆逸人、高士之事。","source":{"text":"读书肄业，琴歌酒赋，莫不在是。","book":"宋·韩元吉《武夷精舍记》"},"example":{"text":"宋·韩元吉《武夷精舍记》：“读书肄业，～，莫不在是。”"},"usage":"作宾语、定语；用于悠闲生活"},{"id":31730,"word":"琴瑟不调","pinyin":"qín sè bù tiáo","abbr":"qsbt","explanation":"琴瑟：古乐器名，比喻夫妇。①指琴瑟合奏时，声音没有调整得和谐。②比喻夫妻不和。","source":{"text":"辟之琴瑟不调，甚者必解而更张之，乃可鼓也；为政而不行，甚者必变而更化之，乃可理也。","book":"《汉书·礼乐志》"},"example":{"text":"郭暖尝与升平公主～。","book":"唐·赵璘《因话录》卷一"},"similar":["反目成仇","琴瑟失调"],"opposite":["瑟调琴弄"],"usage":"作宾语、定语；多用于夫妻之间"},{"id":31731,"word":"琴瑟之好","pinyin":"qí sè zhī hǎo","abbr":"qszh","explanation":"比喻夫妻间感情和谐。","source":{"text":"妻子好合，如鼓瑟琴。","book":"《诗经·周南·关雎》：“窈窕淑女，琴瑟友之。”《诗经·小雅·常棣》"},"example":{"text":"他们俩海誓山盟，愿永结～。"},"usage":"作宾语；用于夫妻间"},{"id":31732,"word":"琴瑟和同","pinyin":"qín sè hé tóng","abbr":"qsht","explanation":"琴瑟：两种弦乐器名。琴瑟合奏时声音非常和谐。比喻夫妻关系和谐。","source":{"text":"再不趁蝶使蜂媒厮断送，再不信怪友狂朋厮搬弄，但能够鱼水相逢琴瑟和同。","book":"元·乔吉《扬州梦》第二折"},"similar":["琴瑟和谐"],"opposite":["琴瑟不调"],"usage":"作谓语、宾语、定语；多用于夫妻之间"},{"id":31733,"word":"琴瑟和好","pinyin":"qín sè hé hǎo","abbr":"qshh","explanation":"比喻夫妇情深和美。亦作“琴瑟静好”、“琴瑟之好”、“琴瑟之欢”、“琴瑟之乐”、“琴瑟和同”、“琴瑟和调”。","source":{"text":"妻子好合，如鼓琴瑟。","book":"《诗经·小雅·常棣》"},"example":{"text":"孙由是～，生一男两女，十余年从无角口之事。","book":"清·蒲松龄《聊斋志异·孙生》"},"similar":["琴瑟和同"],"opposite":["琴瑟不调"],"usage":"作宾语、定语；多用于夫妻之间"},{"id":31734,"word":"琴瑟和谐","pinyin":"qín sè hé xié","abbr":"qshx","explanation":"琴瑟：两种弦乐器名。琴瑟合奏时声音非常和谐。比喻夫妻关系和谐。","source":{"text":"夫妻和顺从今定，这段姻缘夙世成，琴瑟和谐乐万春。","book":"明·沈受先《三元记·团圆》"},"similar":["琴瑟和好"],"opposite":["琴瑟失调"],"usage":"作宾语、定语；多用于夫妻之间"},{"id":31735,"word":"琴瑟失调","pinyin":"qín sè shī tiáo","abbr":"qsst","explanation":"琴瑟：古乐器名，比喻夫妇。琴瑟演奏的不谐调。比喻政令不当，失去调节。也比喻夫妇不和。","source":{"text":"窃譬之琴瑟不调，甚者必解而更张之。","book":"《汉书·董仲书传》"},"example":{"text":"所可惜者，埙篪和鸣，却又～。","book":"清·李绿园《歧路灯》第九十九回"},"similar":["琴瑟不调"],"opposite":["琴瑟相调"],"usage":"作宾语、定语；多用于夫妻之间"},{"id":31736,"word":"琴瑟相调","pinyin":"qín sè xiāng tiáo","abbr":"qsxd","explanation":"琴瑟同时弹奏，声音和谐。比喻夫妻恩爱。","source":{"text":"妻子好合，如鼓琴瑟。","book":"《诗经·小雅·常棣》"},"example":{"text":"今日也鱼水和谐，燕莺成对，～。","book":"元·王子一《误入桃源》第四折"},"similar":["琴瑟调和","琴瑟和谐"],"opposite":["琴瑟不调"],"usage":"作谓语、宾语；用于夫妻间"},{"id":31737,"word":"琴瑟调和","pinyin":"qín sè tiáo hé","abbr":"qsth","explanation":"琴瑟同时弹奏，声音和谐。比喻夫妻恩爱。","source":{"text":"妻子好合，如鼓琴瑟。","book":"《诗经·小雅·常棣》"},"example":{"text":"少年夫妇，～，女貌郎才，如鱼得水。","book":"清·西周生《醒世姻缘传》第五十二回"},"similar":["琴瑟相调"],"opposite":["琴瑟不调"],"usage":"作谓语、宾语；用于夫妻间"},{"id":31738,"word":"琵琶别弄","pinyin":"pí pá bié nòng","abbr":"ppbn","explanation":"旧时指妇女弃夫改嫁。同“琵琶别抱”。","source":{"text":"命短的，做了离魂倩女；命苦的，做了琵琶别弄。","book":"清·李渔《奈何天·计左》"},"similar":["琵琶别抱"],"usage":"作谓语、宾语；指妇女改嫁"},{"id":31739,"word":"琵琶别抱","pinyin":"pí pá bié bào","abbr":"ppbb","explanation":"旧时指妇女弃夫改嫁。","source":{"text":"千呼万唤始出来，犹抱琵琶半遮面。","book":"唐·白居易《琵琶行》"},"example":{"text":"～，掉首无情，非惟不及此妾，乃并不及此狐。","book":"清·纪昀《阅微草堂笔记》卷四"},"similar":["琵琶别弄"],"usage":"作谓语、宾语；指妇女改嫁"},{"id":31740,"word":"琵琶旧语","pinyin":"pí pá jiù yǔ","abbr":"ppjy","explanation":"表示对外屈辱求和之意。","source":{"text":"傅玄《琵琶赋》曰：‘汉遣乌孙公主嫁昆弥，念其行路思慕，故使工人裁筝、筑，为马上之乐。欲从方俗语，故名曰琵琶。’","book":"《宋书·乐志一》"},"example":{"text":"要斩楼兰三尺剑，遗恨～。","book":"宋·张元幹《贺新郞·寄李伯纪丞相》词"},"similar":["琵琶胡语"],"usage":"作宾语、定语；用于古语"},{"id":31741,"word":"琵琶胡语","pinyin":"pí pá hú yǔ","abbr":"pphy","explanation":"旧时指妇女弃夫改嫁。同“琵琶旧语”。","source":{"text":"千载琵琶作胡语，分明怨恨曲中论。","book":"唐·杜甫《咏怀古迹》之三"},"similar":["琵琶旧语"],"usage":"作宾语、定语；用于古语"},{"id":31742,"word":"琼厨金穴","pinyin":"qióng chú jīn xué","abbr":"qcjx","explanation":"比喻豪富奢侈的人家。","source":{"text":"其宠者皆以玉器盛食，故东京谓郭家琼厨金穴。","book":"晋·王嘉《拾遗记》卷六"},"usage":"作宾语、定语；比喻豪富奢侈的人家"},{"id":31743,"word":"琼台玉宇","pinyin":"qióng tái yù yǔ","abbr":"qtyy","explanation":"琼：美玉；宇：屋檐，引申为楼房。指神话故事中月宫亭台楼阁。形容华丽堂皇的建筑物。","source":{"text":"翟乾祜于江岸玩月，或问：‘此中何有？’翟笑曰：‘可随我观之。’俄见琼楼玉宇烂然。","book":"晋·王嘉《拾遗记》"},"example":{"text":"遥望见宝殿珠楼，～见，凤翥鸾飞又，不比那龙蟠虎踞。","book":"元·无名氏《登瀛洲》第四折"},"similar":["琼台玉阁","玉宇琼楼"],"usage":"作主语、宾语、定语；用于建筑物等"},{"id":31744,"word":"琼台玉阁","pinyin":"qióng tái yù gé","abbr":"qtyg","explanation":"琼：美玉。指神话故事中月宫亭台楼阁。形容华丽堂皇的建筑物。","source":{"text":"翟乾祜于江岸玩月，或问：‘此中何有？’翟笑曰：‘可随我观之。’俄见琼楼玉宇烂然。","book":"晋·王嘉《拾遗记》"},"example":{"text":"你看这椒壁宫墙，～，堪比天宫之处也。","book":"元·无名氏《长生会》第五折"},"similar":["琼楼玉宇","琼台玉宇"],"usage":"作主语、宾语、定语；用于建筑物等"},{"id":31745,"word":"琼堆玉砌","pinyin":"qióng duī yù qì","abbr":"qdyq","explanation":"如白玉堆砌。比喻白玉般的事物聚集一处。","source":{"text":"早望见高台上琼堆玉砌，一片洁白，异香阵阵，扑面而来。","book":"清·禇人获《隋唐演义》第四十七回"},"usage":"作宾语、定语；多用于事物等"},{"id":31746,"word":"琼岛春云","pinyin":"qióng dǎo chūn yún","abbr":"qdcy","explanation":"即琼华岛。明代北京八景之一。亦指北京十景之一。","source":{"text":"明·蒋一葵《长安客话·积水潭》：“海子东浒有琼华岛，亦永乐间赐名。岛之阳为广寒殿，乔松古桧，烟云缭绕。京师八景有‘琼岛春云’，谓此。”明·王洪《北京八咏》有《琼岛春云》诗。明·李东阳《京都十景》诗之一有《琼岛春云》。"}},{"id":31747,"word":"琼府金穴","pinyin":"qióng fǔ jīn xué","abbr":"qfjx","explanation":"原指汉光武皇后的的兄弟巨富郭况的家。现泛指富豪人家。","source":{"text":"赏赐金钱缣帛，丰盛莫比，京师号况家为金穴。","book":"《后汉书·光武郭皇后传》"}},{"id":31748,"word":"琼林玉枝","pinyin":"qióng lín yù zhī","abbr":"qlyz","explanation":"琼：赤色玉。比喻人的资质高洁。","source":{"text":"他小哩怎的便知，根科儿是月窟仙枝，胎胞儿是琼林玉枝，胚团儿是俊才英气。","book":"明·康海《王兰卿》第三折"},"usage":"作宾语、定语；用于比喻句"},{"id":31749,"word":"琼林玉树","pinyin":"qióng lín yù shù","abbr":"qlys","explanation":"琼：美玉。泛指精美华丽的陈设。","source":{"text":"但觉一室之中，若琼林玉树，互相照曜，转盼精彩射人。","book":"唐·蒋防《霍小玉传》"},"example":{"text":"打扮的如～一般，比在家出落，自是不同。？（明·兰陵笑笑生《金瓶梅词话》第七十二回）"},"similar":["琼枝玉树"],"usage":"作宾语、定语；指人的长相或陈设"},{"id":31750,"word":"琼林玉质","pinyin":"qióng lín yù zhì","abbr":"qlyz","explanation":"琼：美玉。比喻资质洁净纯美。","source":{"text":"他小哩怎的便知，根科儿是月窟仙枝，胎胞儿是琼林玉质，胚团儿是俊才英气。","book":"明·康海《王兰卿》第三折"}},{"id":31751,"word":"琼枝玉叶","pinyin":"qióng zhī yù yè","abbr":"qzyy","explanation":"琼：美玉。封建时代称皇家后裔。","source":{"text":"况琼枝挺秀，玉叶资神，允厘监抚，仪形稚颂。","book":"唐·萧颖士《为扬州李长史贺立皇太子表》"},"similar":["金枝玉叶"],"usage":"作宾语、定语；同“金枝玉叶”"},{"id":31752,"word":"琼枝玉树","pinyin":"qióng zhī yù shù","abbr":"qzys","explanation":"指披上冰雪的树木。也比喻品格高洁的人。","source":{"text":"绸缪凤阵鸳被，深深处，琼枝玉树相倚。","book":"宋·柳永《尉迟怀》词"},"example":{"text":"看～，偏将冻蕊争开。","book":"明·沈璟《义侠记·取威》"},"similar":["琼林玉树"],"usage":"作宾语、定语；用于比喻句"},{"id":31753,"word":"琼楼玉宇","pinyin":"qióng lóu yù yǔ","abbr":"qlyy","explanation":"琼：美玉；宇：房屋。指月中宫殿，仙界楼台。也形容富丽堂皇的建筑物。","source":{"text":"翟乾祜于江岸玩月，或问：‘此中何有？’翟笑曰：‘可随我观之。’俄见琼楼玉宇烂然。","book":"晋·王嘉《拾遗记》"},"example":{"text":"我欲乘风归去，又恐～，高处不胜寒。","book":"宋·苏轼《水调歌头》词"},"similar":["亭台楼阁","雕梁画栋"],"opposite":["蓬门荜户"],"usage":"作主语、定语、宾语；指建筑物"},{"id":31754,"word":"琼楼金阙","pinyin":"qióng lóu jīn què","abbr":"qljq","explanation":"犹琼楼玉宇。指月中宫殿，仙界楼台。也形容富丽堂皇的建筑物。","source":{"text":"弟子中两人见月规半天，琼楼金阙满焉。","book":"唐·段成式《酉阳杂俎·壶史》"},"example":{"text":"天凡有限，从此永别。他日～，别当重会。","book":"明·施耐庵《水浒全传》第八十八回"},"similar":["琼楼玉宇"],"usage":"作主语、定语、宾语；指建筑物"},{"id":31755,"word":"琼浆玉液","pinyin":"qióng jiāng yù yè","abbr":"qjyy","explanation":"琼：美玉。用美玉制成的浆液，古代传说饮了它可以成仙。比喻美酒或甘美的浆汁。","source":{"text":"华酌既陈，有琼浆些。","book":"汉·王逸《九思·疾世》：“吮玉液兮止渴，啮芝华兮疗饥。”战国楚·宋玉《招魂》"},"example":{"text":"师父，我这酒赛过～哩。","book":"元·马致远《岳阳楼》第一折"},"similar":["琼浆金液","仙液琼浆"],"usage":"作主语、宾语、定语；比喻仙水、美酒等"},{"id":31756,"word":"琼浆金液","pinyin":"qióng jiāng jīn yè","abbr":"qjjy","explanation":"琼：美玉。用美玉制成的浆液，古代传说饮了它可以成仙。比喻美酒或甘美的浆汁。","source":{"text":"来邀采药之人，饮以琼浆金液，延入璇室。","book":"晋·王嘉《拾遗记·洞庭山》"},"similar":["琼浆玉液"],"usage":"作主语、宾语、定语；比喻仙水、美酒等"},{"id":31757,"word":"瑕不掩玉","pinyin":"xiá bù yǎn yù","abbr":"xbyy","explanation":"瑕：玉上的斑点。比喻缺点掩盖不了优点，缺点是次要的，优点是主要的。","source":{"text":"惜哉仲淹，寿不永乎，非不废是，瑕不掩玉。","book":"宋·邵博《闻见后录》第四卷"},"similar":["瑕不掩瑜"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":31758,"word":"瑕不掩瑜","pinyin":"xiá bù yǎn yú","abbr":"xbyy","explanation":"瑕：玉上面的斑点，比喻缺点；掩：遮盖；瑜：美玉的光泽，比喻优点。比喻缺点掩盖不了优点，缺点是次要的，优点是主要的。","source":{"text":"瑕不掩瑜，瑜不掩瑕，忠也。","book":"《礼记·聘义》"},"example":{"text":"柳之文长于记，特惜～，恶敢与泰山北斗并驾齐驱。","book":"清·陶曾佑《中国文学之概观》"},"similar":["白璧无瑕","大醇小疵","瑕不掩玉"],"opposite":["瑜不掩霞"],"usage":"作谓语、宾语、定语；指看主要观点"},{"id":31759,"word":"瑕不揜瑜","pinyin":"xiá bù yǎn yú","abbr":"xbyy","explanation":"比喻缺点掩盖不了优点，缺点是次要的，优点是主要的。同“瑕不掩瑜”。","source":{"text":"瑕不揜瑜，瑜不揜瑕，忠也。","book":"西汉·戴圣《礼记·聘义》"},"similar":["瑕不掩瑜","瑕不掩玉"],"usage":"作谓语、宾语、定语；指看主要观点"},{"id":31760,"word":"瑕不搑瑜","pinyin":"xiá bù yǎn yú","abbr":"xbyy","explanation":"比喻缺点掩盖不了优点，缺点是次要的，优点是主要的。同瑕不掩瑜”。"},{"id":31761,"word":"瑕瑜互见","pinyin":"xiá yú hù jiàn","abbr":"xyhx","explanation":"比喻有缺点也有优点。","source":{"text":"升庵论文，瑕瑜互见。","book":"清·平步青《霞外捃屑》卷七"},"example":{"text":"瑕瑜相互见，历史有渊源。","book":"徐特立《徐乾三十初度》诗"},"similar":["暇瑜不掩","暇瑜错陈"],"opposite":["白璧无瑕","完美无缺"],"usage":"作谓语、宾语、定语；表示客观的评价"},{"id":31762,"word":"瑚琏之器","pinyin":"hú liǎn zhī qì","abbr":"hlzq","explanation":"瑚琏：古代祭祀时盛黍稷的尊贵器械皿，夏朝叫“瑚”殷朝叫“琏”。比喻人特别有才能，可以担当大任。","source":{"text":"子贡问日：‘赐也何如？’子日：‘女器也’。日：‘何器也？’日：‘瑚瑚也。’","book":"《论语·公冶长》"},"example":{"text":"公以～为郎官，以干将之断宰赤县。","book":"唐·李华《卢郎中斋居记》"},"similar":["栋梁之材"],"opposite":["燕岱之石"],"usage":"作宾语；指人有才","story":["春秋时期，孔子的弟子子贡原是卫国的商人，姓端木名赐，他因为有钱，经常穿华丽的服饰，孔子看不惯他的新潮，说他为君子不器。他沾沾自喜，他问孔子自己是什么器，孔子随意说是瑚琏之器。子贡更加飘飘然，不知孔子在说他内心空虚"]},{"id":31763,"word":"瑚琏之资","pinyin":"hú liǎn zhī zī","abbr":"hlzz","explanation":"瑚琏：古代祭祀时盛黍稷的尊贵器械皿，夏朝叫“瑚”殷朝叫“琏”。比喻人特别有才能，可以担当大任。","source":{"text":"子贡问日：‘赐也何如？’子日：‘女器也’。日：‘何器也？’日：‘瑚琏也。’","book":"《论语·公冶长》"},"example":{"text":"强毅正直，执宪不挠，学业优敏，文才美秀，并为廊庙之用，实乃～。","book":"《隋书·炀帝纪》"}},{"id":31764,"word":"瑜不掩瑕","pinyin":"yú bù yǎn xiá","abbr":"ybyx","explanation":"瑜：玉的光彩，比喻优点；瑕：玉上的斑点，比喻缺点。比喻优点遮盖不了缺点。","source":{"text":"瑕不掩瑜，瑜不掩瑕。","book":"《礼记·聘义》"},"example":{"text":"～，忠也。其有词或不典，将与众评之若何？","book":"五代·王定保《唐摭言》卷一"},"similar":["瑕瑜互见","瑜不揜瑕"],"opposite":["白璧无瑕","瑕不掩瑜","白璧微瑕"],"usage":"作谓语、定语；用于劝诫人"},{"id":31765,"word":"瑜不揜瑕","pinyin":"yú bù yǎn xiá","abbr":"ybyx","explanation":"瑜：玉的光彩，比喻优点；瑕：玉上的斑点，比喻缺点。原指玉之性，美与恶不互相掩盖，后多比喻优点不能掩盖缺点。","source":{"text":"瑕，玉之病也。瑜，其中间美者。","book":"《礼记·聘礼》作“瑜不揜瑕”。郑玄注"},"similar":["瑜不掩瑕"],"usage":"作谓语、定语；用于劝诫人"},{"id":31766,"word":"瑜不搑瑕","pinyin":"yú bù yǎn xiá","abbr":"ybyx","explanation":"瑜玉的光彩，比喻优点；瑕玉上的斑点，比喻缺点。原指玉之性，美与恶不互相掩盖，后多比喻优点不能掩盖缺点。","source":{"text":"作瑜不搑瑕。郑玄注瑕，玉之病也。瑜，其中间美者。","book":"《礼记·聘礼》"}},{"id":31767,"word":"瑜百瑕一","pinyin":"yú bǎi xiá yī","abbr":"ybxy","explanation":"比喻优点多而缺点少。瑜，玉的光采；瑕，玉的毛病。","source":{"text":"观玩全书，瑜百瑕一，津逮来学，诚为有裨。","book":"清·陈康祺《郎潜纪闻》卷五"},"usage":"作谓语、定语；用于书面语"},{"id":31768,"word":"瑞兽珍禽","pinyin":"ruì shòu zhēn qín","abbr":"rszq","explanation":"瑞：吉祥；珍：珍奇。吉祥的兽类，珍贵的飞禽。","source":{"text":"瑞兽藏头角，珍禽惜羽毛。","book":"宋·释惟白《续传灯录》卷十三"},"example":{"text":"这女儿两个字极尊贵极清净的，比那～、奇花异草更觉希罕尊贵呢。","book":"清·曹雪芹《红楼梦》第二回"}},{"id":31769,"word":"瑞应灾异","pinyin":"ruì yìng zāi yì","abbr":"ryzy","explanation":"瑞应：吉祥的征兆；灾异：自然灾祸和奇特的自然现象。指吉祥和灾祸的征兆。","source":{"text":"论者或谓随人善恶之行也，犹瑞应应善而至，灾异随恶而到。","book":"汉·王充《论衡·卜筮》"},"example":{"text":"凡岁将终，奏新年历。凡国祭祀、丧、娶之事，掌奏良日及时节禁忌。凡国有～，掌记之。","book":"《后汉书·百官志二》"}},{"id":31770,"word":"瑞彩祥云","pinyin":"ruì cǎi xiáng yún","abbr":"rcxy","explanation":"瑞：吉祥。天上的云气呈现吉祥的征兆。","source":{"text":"瑶池内瑞彩祥云尽笼罩，总堪描。","book":"明·无名氏《紫微宫》第二折"},"similar":["瑞气祥云"],"usage":"作宾语、定语；指吉祥的征兆"},{"id":31771,"word":"瑞气祥云","pinyin":"ruì qì xiáng yún","abbr":"rqxy","explanation":"瑞：祥瑞。天上云气呈现吉兆。旧因以为喜事降临的征兆。","source":{"text":"今到此山之中，观见瑞气祥云，氤氲于九霄之上。","book":"明·无名氏《度黄龙》第一折"},"similar":["祥云瑞气","瑞彩祥云"],"usage":"作宾语、定语；指吉祥的征兆"},{"id":31772,"word":"瑞雪兆丰年","pinyin":"ruì xuě zhào fēng nián","abbr":"rxzfn","explanation":"瑞：吉利的。适时的冬雪预示着来年是丰收之年。","source":{"text":"俗语说：‘瑞雪兆丰年’，明年的小麦一定收成好。","book":"曲波《桥隆飙》"},"example":{"text":"～，明年肯定会有好年成。"},"usage":"作宾语、定语；指大雪"},{"id":31773,"word":"瑞雪霏霏","pinyin":"ruì xuě fēi fēi","abbr":"rxff","explanation":"指预兆丰年的大雪纷飞。","example":{"text":"在一个～夜晚，我们终于回到了故乡。"},"similar":["大雪纷飞"],"usage":"作谓语、定语；指下大雪"},{"id":31774,"word":"瑟弄琴调","pinyin":"sè nòng qín tiáo","abbr":"snqt","explanation":"比喻夫妇感情融洽。","source":{"text":"妻子好合，如鼓琴瑟。","book":"语出《诗小雅常棣》"},"example":{"text":"～，好合诚堪慰。","book":"明汪廷讷《狮吼记·谈禅》"},"similar":["瑟调琴弄"],"opposite":["琴瑟不调"],"usage":"作谓语、定语；用于夫妻之间"},{"id":31775,"word":"瑟瑟缩缩","pinyin":"sè sè suō suō","abbr":"ssss","explanation":"身体因寒冷、惊恐等而蜷缩、抖动。","source":{"text":"他瑟瑟缩缩地走到任天华面前。","book":"丁玲《太阳照在桑乾河上》"},"example":{"text":"丁玲《太阳照在桑乾河上》：“他～地走到任天华面前。”"},"similar":["抖抖瑟瑟"],"usage":"作定语、状语；用于口语"},{"id":31776,"word":"瑟调琴弄","pinyin":"sè tiáo qín nòng","abbr":"stqn","explanation":"比喻夫妇感情融洽。","source":{"text":"妻子好合，如鼓琴瑟。","book":"语出《诗小雅常棣》"},"example":{"text":"想那日～，叹中途付与东风。","book":"《群音类选·》"},"similar":["瑟弄琴调"],"opposite":["琴瑟不调"],"usage":"作谓语、定语；用于夫妻之间"},{"id":31777,"word":"瑰意奇行","pinyin":"guī yì qí xíng","abbr":"gyqx","explanation":"指高明的思想和不平常的行为。同“瑰意琦行”","source":{"text":"瑰意奇行，超然高举。","book":"刘师培《文说·宗骚》"},"similar":["瑰意琦行"],"usage":"作宾语、定语；指卓越的思想和不平凡的行为"},{"id":31778,"word":"瑰意琦行","pinyin":"guī yì qí xíng","abbr":"gyqx","explanation":"瑰：美石，比喻珍贵；琦：美玉，比喻珍奇，美好。指高明的思想和不平常的行为。","source":{"text":"瑰意琦行，超然独处。","book":"战国·楚·宋玉《对楚王问》"},"example":{"text":"今吾观于～之士，则有二病焉。","book":"章炳麟《变法箴言》"},"similar":["瑰意奇行"],"usage":"作宾语、定语；指卓越的思想和不平凡的行为"},{"id":31779,"word":"瑶台琼室","pinyin":"yáo tái qióng shì","abbr":"ytqs","explanation":"玉砌的楼台宫室。泛指华丽的宫廷建筑物。","source":{"text":"及到末世，以奢失之者，帝王则有瑶台琼室，玉杯象箸，肴膳之珍则熊蹯豹胎，酒池肉林。","book":"《晋书·江统传》"},"example":{"text":"《晋书·江统传》：“及到末世，以奢失之者，帝王则有～，玉杯象箸，肴膳之珍则熊蹯豹胎，酒池肉林。”"},"usage":"作宾语、定语；用于建筑物"},{"id":31780,"word":"瑶台银阙","pinyin":"yáo tái yín què","abbr":"ytyq","explanation":"装饰华丽的楼台宫阙。多指神仙居处。","source":{"text":"丹桂飘香清思爽，人在瑶台银阙。","book":"元本高明《琵琶记·中秋望月》"},"example":{"text":"漫说道，秦宫汉帐，～。","book":"清·钱彩《说岳全传》第四十四回"},"usage":"作宾语、定语；用于建筑物"},{"id":31781,"word":"瑶台阆苑","pinyin":"yáo tái làng yuàn","abbr":"ytly","explanation":"瑶台：传说中西王母所居住的地方；阆苑：传说中神仙所住的宫苑。泛指仙家园林。","source":{"text":"别梦已随流水，泪巾犹裛香泉。相如依旧是臞仙。人在瑶台阆苑。","book":"宋·苏轼《西江月》词"},"example":{"text":"三岛十洲东，青霄上，神工幻成岩窦。～，翠旌羽葆频相就。","book":"宋·史浩《南浦·洞天》词"},"similar":["瑶池阆苑"],"usage":"作宾语、定语；用于书面语"},{"id":31782,"word":"瑶林玉树","pinyin":"yáo lín yù shù","abbr":"ylys","explanation":"形容人容貌智力出众。同“瑶林琼树”。","source":{"text":"瑶林玉树出风尘，不是野花凡草，等闲春。","book":"宋·向子湮《南歌子·郭小娘道装》词"},"similar":["瑶林琼树"],"usage":"作宾语、定语；用于书面语"},{"id":31783,"word":"瑶林琼树","pinyin":"yáo lín qióng shù","abbr":"ylqs","explanation":"瑶、琼：美玉。就像美玉做的树木一样。形容人容貌智力出众。","source":{"text":"王衍神姿高彻，如瑶林琼树。","book":"《晋书·王戎传》"},"example":{"text":"第一流中能几人，～恐无邻。","book":"宋·饶节《倚松老人集·次韵赵承之殿撰》"},"similar":["瑶林玉树"],"usage":"作宾语、定语；用于书面语"},{"id":31784,"word":"瑶池女使","pinyin":"yáo shi nǚ shǐ","abbr":"ycns","explanation":"传说西王母住在瑶池，以青鸟为使者，向汉武帝传递消息。后指传信的使者。","source":{"text":"望咫尺青天，那有个瑶池女使，偷递情笺。","book":"清·孔尚任《桃花扇·题画》"},"usage":"作主语、宾语；用于书面语"},{"id":31785,"word":"瑶池玉液","pinyin":"yáo shi yù yè","abbr":"ycyy","explanation":"瑶池：传说中西王母所住的地方。玉液：指美酒。仙家酿造的美酒。形容酒名贵醇美。","source":{"text":"俺仙家景物奇绝，更有瑶池玉液，紫府琼浆。","book":"明·无名氏《卖蟠桃》第一折"},"similar":["琼浆玉液"],"usage":"作主语、宾语、定语；指美酒"},{"id":31786,"word":"瑶池阆苑","pinyin":"yáo chí liáng yuàn","abbr":"ycly","explanation":"瑶池：传说中西王母所居住的地方；阆苑：传说中神仙所住的宫苑。泛指仙家园林。","source":{"text":"作女仙图，有瑶池阆苑，风景之趣。","book":"宋·赵佶《宣和画谱·人物二·阮郜》"},"similar":["瑶台阆苑"],"usage":"作宾语、定语；用于书面语"},{"id":31787,"word":"瑶环瑜珥","pinyin":"yáo huán yú ěr","abbr":"yhye","explanation":"瑶：美玉；环：玉圈；瑜：美玉；珥：玉制的耳饰。比喻美好如玉的子弟。","source":{"text":"幼子娟好静秀，瑶环瑜珥，兰茁其牙，称其家儿也。","book":"唐·韩愈《殿中少监马君墓志》"},"usage":"作主语、宾语、定语；用于称赞别人"},{"id":31788,"word":"瑶花琪树","pinyin":"yáo huā qí shù","abbr":"yhqs","explanation":"瑶、琪：美玉。就像美玉做的树木一样。形容人容貌智力出众。","source":{"text":"王衍神姿高彻，如瑶林琼树，自然是风尘外物。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"～缘边绕，玉宇琼楼向上安。","book":"明·凌去翰《巢居雪阁》诗"}},{"id":31789,"word":"瑶草奇花","pinyin":"yáo cǎo qí huā","abbr":"ycqh","explanation":"指仙境中的花草。","source":{"text":"瑶草奇花不谢，青松翠柏长春。","book":"明·吴承恩《西游记》第一回"},"similar":["奇花异草"],"usage":"作主语、宾语、定语；指奇特的花草"},{"id":31790,"word":"瑶草琪花","pinyin":"yáo cǎo qí huā","abbr":"ycqh","explanation":"①仙境里的花草。②珍贵奇异的花草。亦作“瑶草琪葩”。","source":{"text":"连那瑶草琪花，也分外披佛有致。","book":"明·吴承恩《西游记》第九十八回：“悬崖下瑶草琪花，曲径旁紫芝香蕙。”清·李汝珍《镜花缘》第一回"},"example":{"text":"茶馆内排列着～，当炉的羽扇常在手中。","book":"清·李绿园《歧路灯》第三回"},"similar":["奇花异草","瑶花琪草","琪花瑶草"],"usage":"作主语、宾语、定语；用于书面语"},{"id":31791,"word":"瑶草琪葩","pinyin":"yáo cǎo qí pā","abbr":"ycqp","explanation":"仙境里的花草。也指珍贵奇异的花草。同“瑶草琪花”。","source":{"text":"瑶草琪葩，露滋芳些；羡门、偓佺，杂■（王怱）珩些。","book":"明·郑真《王叔远先生拟挽辞》"},"similar":["瑶草琪花"],"usage":"作主语、宾语、定语；用于书面语"},{"id":31792,"word":"璀璨夺目","pinyin":"cuǐ càn duó mù","abbr":"ccdm","explanation":"璀璨：美玉发光。光辉灿烂耀人眼睛。","source":{"text":"玉山宝带，尽壁寸珠，璀璨夺目。","book":"宋·周密《武林旧事》第三卷"},"example":{"text":"方志敏同志和无数先烈为之奋斗……，～的革命红旗已经插遍祖国大地。","book":"穆欣《南线巡回·“又照秦淮一叶枫”》"},"similar":["光辉灿烂"],"opposite":["黯淡无光"],"usage":"作谓语、定语；指色彩华丽"},{"id":31793,"word":"璇玑改度","pinyin":"xuán jī gǎi dù","abbr":"xjgd","explanation":"璇玑：指北斗魁第四星。比喻历法改变。","source":{"text":"元正道祚，璇玑改度，伏称万寿。","book":"三国·魏·王肃《贺正仪》"}},{"id":31794,"word":"璇霄丹台","pinyin":"xuán xiāo dān tái","abbr":"xxdt","explanation":"指仙境。同“璇霄丹阙”。","source":{"text":"谪仙之辞，飘飘然游戏璇霄丹台，吹鸾笙而食紫霞，绝去人间尘土。","book":"明·宋濂《序》"},"similar":["璇霄丹阙"],"usage":"作主语、宾语、定语；指仙境"},{"id":31795,"word":"璇霄丹阙","pinyin":"xuán xiāo dān què","abbr":"xxdq","explanation":"指仙境。亦作“璇霄丹台”。","source":{"text":"吾比者夜礼北斗，若有感遇，今神识所游，盖钧天紫府中，至所受用，乃天浆甘露，其去璇霄丹阙不远矣。","book":"宋洪迈《夷坚志补·礼斗僧》"},"example":{"text":"谪仙之辞，飘飘然游戏璇霄丹台，吹鸾笙而食紫霞，绝去人间尘土。","book":"明宋濂《序》"},"similar":["璇霄丹台"],"usage":"作主语、宾语、定语；指仙境"},{"id":31796,"word":"璞玉浑金","pinyin":"pú yù hún jīn","abbr":"pyhj","explanation":"比喻天然美质，未加修饰。多用来形容人的品质淳朴善良。","source":{"text":"王戎目山巨源如璞玉浑金，人皆钦其宝，莫知名其器。","book":"南朝宋·刘义庆《世说新语·赏誉》"},"example":{"text":"灵芝继起殊寻常，浑金璞玉其器良。","book":"清·黄遵宪《别赖云芝同年》诗"},"similar":["璞金浑玉"],"usage":"作宾语；形容人的品质淳朴善良","story":["魏晋时期，在文学上有名气的“竹林七贤”之一的山涛，40岁才当上官，在京城任尚书吏郎，他很敬重有才学的嵇康，因工作调动想推荐嵇康去接替他的位置，可嵇康不愿。后来他为吏部尚书，启用嵇绍。王戎盛赞山涛是没有琢磨的璞玉"]},{"id":31797,"word":"璞金浑玉","pinyin":"pú jīn hún yù","abbr":"pjhy","explanation":"未琢的玉和未炼的金。比喻天然美质，未加修饰。","source":{"text":"王戎目山巨源如璞玉浑金，人皆钦其宝，莫知名其器。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"similar":["璞玉浑金"],"usage":"作宾语；形容人的品质淳朴善良"},{"id":31798,"word":"璧合珠联","pinyin":"bì hé zhū lián","abbr":"bhzl","explanation":"比喻众美毕集，相得益彰。","source":{"text":"见“璧合珠连”。"},"example":{"text":"～今日事，金闺国士羡温恭。","book":"柳亚子《席上赋赠蔡贤初将军罗西欧夫人伉俪》诗"},"similar":["珠联璧合"],"usage":"作谓语、定语、状语；常作贺人新婚的祝词"},{"id":31799,"word":"璧合珠连","pinyin":"bì hé zhū lián","abbr":"bhzl","explanation":"①指日月如合璧，五星如连珠。古人认为是一种显示祥瑞的天象。②比喻众美毕集，相得益彰。","source":{"text":"然则皇王受命，天地兴符，仰观则璧合珠连，俯察则银黄玉紫。","book":"唐·杨炯《公卿以下冕服义》"},"example":{"text":"～琰琬垂，蠡应难测管难窥。","book":"清·查慎行《南书房敬观宸翰恭纪》诗之五"},"similar":["璧合珠联"],"usage":"作定语、状语；同“珠联璧合”"},{"id":31800,"word":"璧坐玑驰","pinyin":"bì zuò jī chí","abbr":"bzjc","explanation":"形容文章的语言精采美妙。"},{"id":31801,"word":"瓜代之期","pinyin":"guā dài zhī qī","abbr":"gdzq","explanation":"代：时期，时代。以瓜熟为期限。指任职期满，派他人接替。","source":{"text":"齐侯使连称，管至父戍葵丘。瓜时而往，曰：‘及瓜而代。’","book":"《左传·庄公八年》"},"usage":"作宾语；指交接的期限","story":["春秋时期，齐襄公会同宋等四国伐卫，鲁庄公出兵援卫，打败了齐襄公。齐襄公派大将连称、管至父去葵丘驻守。他们迫于压力去了，问派人去接替的时间，襄公随口说声及瓜而代。第二年瓜熟时连称派人给襄公送瓜提醒。襄公大怒，逼得他们造反"]},{"id":31802,"word":"瓜分豆剖","pinyin":"guā fēn dòu pōu","abbr":"gfdp","explanation":"瓜被剖开，豆从筴中分裂而出。比喻国土被并吞、分割。","source":{"text":"五代干戈，四海瓜分豆剖，斯文道熄。","book":"宋·胡仔《苕溪渔隐丛话后集·晁无咎》"},"example":{"text":"孙中山《兴中会宣言》：“蚕食鲸吞，已见效于踵接；～，实堪虑于目前。”"},"similar":["瓜剖豆分"],"usage":"作谓语、定语；指瓜分"},{"id":31803,"word":"瓜分鼎峙","pinyin":"guā fēn dǐng zhì","abbr":"gfdz","explanation":"比喻国土分裂，群雄对立。","source":{"text":"隋亡，英雄焱起，号帝王者瓜分鼎峙。","book":"《新唐书·李轨传》"},"example":{"text":"自有唐失御，天步方艰，六纪于兹。～，自为声教，各擅蒸黎，交结四夷，凭陵上国。","book":"《新五代史·南唐世家·李昪》"},"similar":["四分五裂"],"opposite":["天下一统"],"usage":"作谓语、定语；用于局势等"},{"id":31804,"word":"瓜剖棋布","pinyin":"guā pōu qí bù","abbr":"gpqb","explanation":"如瓜剖分，如棋分布。比喻区分布局，职司有序。","source":{"text":"州县之所趁办者，本不过数条，瓜剖棋布，皆以分隶，一州则通判掌之，一路则提点狱督之。","book":"宋·叶適《经总制钱一》"},"usage":"作宾语、定语；用于比喻句"},{"id":31805,"word":"瓜剖豆分","pinyin":"guā pōu dòu fēn","abbr":"gpdf","explanation":"象瓜被剖开，豆从荚里裂出一样。比喻国土被人分割。","source":{"text":"出入三代，五百余载，竟瓜剖而豆分。","book":"南朝·宋·鲍照《芜城赋》"},"example":{"text":"自八纮九野，～，窃帝偷王，连州比郡。","book":"《南史·陈武帝纪》"},"similar":["豆剖瓜分"],"usage":"作谓语、定语；指瓜分"},{"id":31806,"word":"瓜区豆分","pinyin":"guā qū dòu fēn","abbr":"gqdf","explanation":"犹言区分有序。","source":{"text":"各国疆域，瓜区豆分，界画犁然。","book":"清·王韬《地球图跋》"},"usage":"作宾语、定语；用于比喻句"},{"id":31807,"word":"瓜字初分","pinyin":"guā zì chū fēn","abbr":"gzcf","explanation":"旧时文人拆“瓜”字为两个八字以纪年，即十六岁。多用于女子。","source":{"text":"碧玉破瓜时，郎为情颠倒。","book":"南朝·宋·吴声歌曲《碧玉歌》"},"example":{"text":"柱形浅沸梁家黛，～碧玉年。","book":"唐·李群玉《赠冯姬》诗"},"usage":"作定语；指女子16岁"},{"id":31808,"word":"瓜李之嫌","pinyin":"guā lǐ zhī xián","abbr":"glzx","explanation":"瓜李：瓜田李下。比喻处在嫌疑的地位。","source":{"text":"瓜李之嫌，何以户晓？","book":"《旧唐书·柳公权传》"},"example":{"text":"谁知事既不谐，反涉～，今日父母哥嫂亦不能相谅，何况他人。","book":"明·冯梦龙《警世通言》卷二十一"},"similar":["瓜田李下","瓜田之嫌"],"usage":"作宾语；比喻处于嫌疑的境地","story":["北齐时期，学识渊博的袁聿修做了博陵太守，他为官清廉，公私分明，不收取别人的钱物。有一次他去外地考察，路过兖州。老朋友兖州刺史邢邵拿出一匹当地生产的白色丝绸送他，他以考察地方官员注意瓜田李下之嫌婉拒朋友的好意"]},{"id":31809,"word":"瓜熟蒂落","pinyin":"guā shú dì luò","abbr":"gsdl","explanation":"蒂：花或瓜果跟枝茎相连的部分。瓜熟了，瓜蒂自然脱落。指时机一旦成熟，事情自然成功。","source":{"text":"体地法天，负阴抱阳，喻瓜熟蒂落，啐啄同时。","book":"宋·张君房《云笈七签》卷五十六"},"example":{"text":"况吉人天相，自然～，何须过虑。","book":"清·禇人获《隋唐演义》第十一回"},"similar":["水到渠成"],"opposite":["欲速不达"],"usage":"作谓语、宾语；指时机一旦成熟，事情自然成"},{"id":31810,"word":"瓜瓞绵绵","pinyin":"guā dié mián mián","abbr":"gdmm","explanation":"瓞：小瓜；绵绵：延续不断的样子。如同一根连绵不断的藤上结了许多大大小小的瓜一样。引用为祝颂子孙昌盛。","source":{"text":"绵绵瓜瓞，民之初生，自土沮漆。","book":"《诗经·大雅·绵》"},"example":{"text":"一个大红毡，堆～花样的大底烟荷包。","book":"清·文康《儿女英雄传》第四十四回"},"usage":"作宾语、定语；用于祝福等"},{"id":31811,"word":"瓜田不纳履，李下不整冠","pinyin":"guā tián bù nà lǚ，lǐ xià bù zhěng guān","abbr":"gtbnllxbzg","explanation":"走过瓜田，不要弯下身子提鞋；经过李树下面，不要举起手来整理帽子。比喻避嫌疑。","source":{"text":"君子防未然，不处嫌疑间。瓜田不纳履，李下不整冠。","book":"《乐府诗集·君子行》"},"example":{"text":"俗话说：“～”。只要自己行得正，就没有什么可担心的。"},"similar":["瓜田李下"],"usage":"作宾语、分句；比喻避嫌","story":["北齐时期，学识渊博的袁聿修做了博陵太守，他为官清廉，公私分明，不收取别人的钱物。有一次他去外地考察，路过兖州。老朋友兖州刺史邢邵拿出一匹当地生产的白色丝绸送他，他以考察地方官员注意瓜田李下之嫌婉拒朋友的好意"]},{"id":31812,"word":"瓜田不纳履，李下不正冠","pinyin":"guā tián bù nà lǚ，lǐ xià bù zhèng guān","abbr":"gtbnllxbzg","explanation":"比喻避嫌疑。同“瓜田不纳履，李下不整冠”。","source":{"text":"君子防未然，不处嫌疑间；瓜田不纳履，李下不正冠。","book":"《艺文类聚》卷四一引三国·魏·曹植《君子行》"},"similar":["瓜田不纳履，李下不整冠"],"usage":"作宾语、定语；用于避嫌"},{"id":31813,"word":"瓜田之嫌","pinyin":"guā tián zhī xián","abbr":"gtzx","explanation":"犹瓜田李下。比喻容易引起嫌疑的场合。","source":{"text":"明·李贽《与耿克念书》：“我欲来已决，然反而思之，未免有瓜田之嫌。”参见“瓜田不纳履，李下不整冠”。"},"similar":["瓜李之嫌"],"usage":"作宾语；比喻处于嫌疑的境地"},{"id":31814,"word":"瓜田李下","pinyin":"guā tián lǐ xià","abbr":"gtlx","explanation":"比喻容易引起嫌疑的场合。","source":{"text":"瓜田李下，古人所慎。","book":"《北史·袁翻传》"},"example":{"text":"但～，嫌疑难辩，万一已拘者畏法混供，也甚怕堂讯之下，玉石不分。","book":"清·李绿园《歧路灯》第五十一回"},"similar":["瓜李之嫌"],"usage":"作主语、定语；同“瓜李之嫌”","story":["北齐时期，学识渊博的袁聿修做了博陵太守，他为官清廉，公私分明，不收取别人的钱物。有一次他去外地考察，路过兖州。老朋友兖州刺史邢邵拿出一匹当地生产的白色丝绸送他，他以考察地方官员注意瓜田李下之嫌婉拒朋友的好意"]},{"id":31815,"word":"瓜皮搭李树","pinyin":"guā pǐ dā lǐ shù","abbr":"gpdls","explanation":"根本搭不上。指强认亲族。","source":{"text":"盖俗云：以强认亲族者，为瓜皮搭李树云。","book":"宋·韦君安《梅磵诗话》中"},"usage":"作宾语、定语；用于比喻句","story":["宋朝时期，泉南人林洪字龙发，号可山，他自称是“梅妻鹤子”林和靖的七世孙，人们都知道林逋根本就没结过婚。当时就有人作诗嘲讽说：“和靖当年不娶妻，只留一鹤一童儿，可山认作孤山种，正是瓜皮搭李树。”"]},{"id":31816,"word":"瓜皮搭李皮","pinyin":"guā pí dā lǐ pí","abbr":"gpdlp","explanation":"搭：连接上，挂上。瓜皮挂在李子树皮上。比喻和毫无关系的人强认亲族。","source":{"text":"因何七世有孙儿？若非鹤种并梅种，定是瓜皮搭李皮。","book":"宋·无名氏《随隐漫录》"},"example":{"text":"和靖当年不娶妻，只留一鹤一童儿，可山认作孤山种，正是～。","book":"元·韦居安《梅磵诗话》卷中"}},{"id":31817,"word":"瓜葛相连","pinyin":"guā gě xiāng lián","abbr":"ggxl","explanation":"瓜、葛：都是蔓生植物，其藤能攀附在别的物体上。比喻辗转攀连的社会关系。也比喻两件事或两个人相互牵联的关系。","source":{"text":"与君新为婚，瓜葛相结连。","book":"汉·蔡邕《独断》：“四姓小侯，诸侯家妇，凡与先帝先后有瓜葛者……皆会。”三国·魏·曹叡《种瓜篇》"},"similar":["瓜连蔓引"],"usage":"作宾语、定语；用于事物间等"},{"id":31818,"word":"瓜蔓抄","pinyin":"guā wàn chāo","abbr":"gwc","explanation":"形容刑罚过度株连，一人有罪，株连九族。","source":{"text":"藉其乡，转相攀染，谓之瓜蔓抄，村里为墟。","book":"《明史·景清传》"},"example":{"text":"永乐族景清，转相支连九族之姻亲，门生之门生，名～。","book":"清·梁章钜《称谓录》第八卷"},"usage":"作主语、宾语、定语；用于比喻句","story":["明成祖时期，大臣景清藏着凶器入朝，想刺杀明成祖朱棣，为明惠帝朱允炆报仇，事情败露。成祖大怒，下令将景清磔死，并将他的家族全部株连，后来还不解恨，把与他相关的乡亲与邻居全部处死，于是整个村子变为废墟"]},{"id":31819,"word":"瓜连蔓引","pinyin":"guā lián màn yǐn","abbr":"glmy","explanation":"比喻人事上辗转牵连。","source":{"text":"四明藉此挑激圣怒，瓜连蔓引，是以摈李太宰，逮周嘉庆。","book":"明·刘若愚《酌中志·忧危竑议后记》"},"usage":"作宾语、定语；用于比喻句"},{"id":31820,"word":"瓢泼大雨","pinyin":"piáo pō dà yǔ","abbr":"ppdy","explanation":"像用瓢泼水那样的大雨。形容雨下得非常大的样子。","source":{"text":"西北悬天起了乌黑的云朵，不大一会，瓢泼大雨到来了，夹着炸雷和闪电，因为三天两头地下雨，道上黑泥总是不干的，出门的人们都是光着脚丫子，顺着道沿走。","book":"周立波《暴风骤雨》第一部十二"},"example":{"text":"外面～，我们只有呆在宿舍里。"},"similar":["倾盆大雨"],"usage":"作主语、谓语、宾语；指大雨"},{"id":31821,"word":"瓦上霜","pinyin":"wǎ shàng shuāng","abbr":"wss","explanation":"屋瓦上的冰霜。比喻存在的时间极短。","source":{"text":"愿为石中泉，不为瓦上霜。","book":"唐·张籍《赠姚怤》"},"example":{"text":"人生忽如～，勿恃强健轻年光。","book":"宋·陆游《读老子》"}},{"id":31822,"word":"瓦合之卒","pinyin":"wǎ hé zhī zú","abbr":"whzz","explanation":"瓦合：碎瓦相拼合。卒：士兵。像破碎的瓦片凑合在一起一样的士兵。比喻没有组织纪律的军队。","source":{"text":"食其曰：‘足下起瓦合之卒，收散乱之兵，不满万人，欲以径入强秦，此所谓探虎口者也。’","book":"《汉书·郦食其传》"},"similar":["乌合之众"],"usage":"作宾语；指乌合之众"},{"id":31823,"word":"瓦器蚌盘","pinyin":"wǎ qì bàng pán","abbr":"wqbp","explanation":"泛指粗陋的食器。形容生活俭朴。","source":{"text":"以俭素自率，常膳不过数品，私飨曲宴，皆瓦器蚌盘，肴核庶羞，裁令充足而已。","book":"《陈书·高祖纪》"},"example":{"text":"唐·杜光庭《皇帝周天醮词》：“～，敢忘于刻已，雉头虎魄，岂事于娱情。”"},"usage":"作宾语、定语；用于生活"},{"id":31824,"word":"瓦影之鱼","pinyin":"wǎ yǐng huā yú","abbr":"wyzy","explanation":"比喻求庇于人。"},{"id":31825,"word":"瓦影龟鱼","pinyin":"wǎ yǐng guī yú","abbr":"wygy","explanation":"池中的龟和鱼，依靠屋瓦的影子来遮蔽阳光。比喻求庇于人。","source":{"text":"湖上新亭好，公来日出初，水文浮枕蕈，瓦影荫龟鱼。","book":"唐·韩愈《新亭》诗"},"example":{"text":"宋·胡继宗《书言故事·水族》：“求疵于人云～。”"},"similar":["瓦影龟鱼"],"usage":"作宾语、定语；用于书面语"},{"id":31826,"word":"瓦查尿溺","pinyin":"wǎ chá niào nì","abbr":"wcnn","explanation":"碎瓦和小便。指极微贱污秽的东西。","source":{"text":"碎瓦和小便。指极微贱污秽的东西。"},"example":{"text":"明·徐渭《翠乡梦》第二出：“搅长河一搭里酥酩醍醐，论大环跳不出～。”"},"usage":"作宾语、定语；多用于比喻句","story":["战国时期，东郭子问道家代表人庄周，“道”是什么，到底在什么地方。庄子说道在蚂蚁洞里，东郭子不明白，再问，庄子说道存在于野草、砖瓦、碎石甚至在屎尿里。东郭子说怎么道会越来越卑下，庄子说道就在于那些卑微低贱的地方"]},{"id":31827,"word":"瓦棺篆鼎","pinyin":"wǎ guān zhuàn dǐng","abbr":"wgzd","explanation":"瓦棺：古代用陶土制的葬具；篆鼎：铸有篆文的钟鼎。泛指古董、文物。","source":{"text":"风樯阵马，不足为其勇也；瓦棺篆鼎，不足为其古也。","book":"唐·杜牧《〈李贺集〉序》"},"usage":"作主语、宾语、定语；指文物等"},{"id":31828,"word":"瓦玉集糅","pinyin":"wǎ yù jí róu","abbr":"wyjr","explanation":"糅：混杂。瓦和玉混杂在一起。比喻好坏不分。","source":{"text":"今吾不得已也！虚妄显於真，实诚乱於伪，世人不悟，是非不定，紫失杂厕，瓦玉集糅，以情言之，岂吾心所能忍哉！","book":"汉·王充《论衡·对作》"}},{"id":31829,"word":"瓦缶雷鸣","pinyin":"wǎ fǒu léi míng","abbr":"wflm","explanation":"瓦缶：沙锅，比喻庸才。声音低沉的沙锅发出雷鸣般的响声。比喻庸人占据高位，威风一时。","source":{"text":"黄钟毁弃，瓦釜雷鸣。谗人高张，贤士无名。","book":"战国·楚·屈原《卜居》"},"example":{"text":"且洪钟韶击，～；荣辱纠绳，复何定分！","book":"宋·王谠《唐语林·白居易评徐凝张祜诗》"}},{"id":31830,"word":"瓦罐不离井上破","pinyin":"wǎ guàn bù lí jǐng shàng pò","abbr":"wgbljsp","explanation":"汲水的瓦罐免不了在井口打破。比喻担着风险干事难免会失手。","source":{"text":"自古瓦罐不离井上破，将军难免阵中亡，只管做过没天理的勾当，终须不是个好结果。","book":"《京本通俗小说·错斩崔宁》"},"example":{"text":"‘～，将军难免阵前亡’，你见过哪个是在赌上发迹的。","book":"高阳《胡雪岩全传·平步青云》中册"},"similar":["瓦罐不离井口破"],"usage":"作宾语、定语；用于劝诫人"},{"id":31831,"word":"瓦罐不离井口破","pinyin":"wǎ guàn bù lǐ jǐng kǒu pò","abbr":"wgbljkp","explanation":"汲水的瓦罐免不了打破在井台上。比喻长期干某行当的人往往就在某种行当中失败或丧生。也比喻担着风险干事总有失手的时候。","source":{"text":"你两个有这等勾当，道不的瓦罐不离井口破，我去也。","book":"元·无名氏《海门张仲村乐堂》第二折"},"example":{"text":"你呢，～，只要来得回数多。老这么干下去，非出事不行。","book":"张贤亮《河的子孙》第四章"},"similar":["瓦罐不离井上破"],"usage":"作宾语、定语；用于劝诫人"},{"id":31832,"word":"瓦解云散","pinyin":"wǎ jiě yún sàn","abbr":"wjys","explanation":"像瓦片破碎，云彩分散。比喻群体溃散。","source":{"text":"故其见敌则逐利，如鸟之集，其困败，则瓦解用矣。","book":"《史记·匈奴列传》"},"similar":["瓦解星散"],"usage":"作谓语、宾语、状语；用于书面语"},{"id":31833,"word":"瓦解冰泮","pinyin":"wǎ jiě bīng pàn","abbr":"wjbp","explanation":"瓦器破碎，冰块融解。比喻失败、崩溃或消失。","source":{"text":"则七国之军，瓦解冰泮。","book":"汉·陈琳《檄吴将校部曲文》"},"example":{"text":"于时～，凤飞电散，浑然千里。","book":"北周·庾信《哀江南赋》"},"similar":["瓦解冰消"],"usage":"作谓语、宾语；形容很快消失"},{"id":31834,"word":"瓦解冰消","pinyin":"wǎ jiě bīng xiāo","abbr":"wjbx","explanation":"比喻完全消逝或彻底崩溃。","source":{"text":"于是玄气仰散，归云四聚；冰消瓦解，奕奕翩翩。","book":"晋·成公绥《云赋》"},"example":{"text":"你们的一场闹剧，给我一席话，弄得～。","book":"清·吴趼人《二十年目睹之怪现状》第十一回"},"similar":["土崩瓦解","烟消云散","瓦解冰销"],"usage":"作谓语、定语、状语；用于崩溃或消失等"},{"id":31835,"word":"瓦解冰销","pinyin":"wǎ jiě bīng xiāo","abbr":"wjbx","explanation":"比喻失败、崩溃或消失。同“瓦解冰泮”。","source":{"text":"瓦解冰销真可耻，凝艳妖芳安足恃。","book":"唐·刘商《姑苏怀古送秀才下第归江南》"},"example":{"text":"一天大事，～，竟弄成一个虎头蛇尾！","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["瓦解冰消"],"usage":"作谓语、定语、状语；用于崩溃或消失等"},{"id":31836,"word":"瓦解土崩","pinyin":"wǎ jiě tǔ bēng","abbr":"wjtb","explanation":"象土崩塌，瓦破碎一样，不可收拾。比喻彻底垮台。","source":{"text":"使吴失与而无助，跬步独进，瓦解土崩，破败而不救。","book":"东汉·班固《汉书·邹阳传》"},"example":{"text":"或假元世为名，或托香车为号，由是天下～。","book":"《英烈传》第52回"},"similar":["土崩瓦解"],"usage":"作谓语、定语；同“土崩瓦解”"},{"id":31837,"word":"瓦解星散","pinyin":"wǎ jiě xīng sàn","abbr":"wjxs","explanation":"像瓦片破裂，像星星飞散。比喻家人离散，各奔东西。亦作“瓦解星飞”。","source":{"text":"殊不知彼皆队舞聚戏之类，若闻胡寇之来，则瓦解星散不知所之矣。","book":"宋·司马光《义勇第五札子》"},"similar":["瓦解星飞"],"usage":"作谓语、宾语；指人心涣散"},{"id":31838,"word":"瓦解星飞","pinyin":"wǎ jiě xīng fēi","abbr":"wjxf","explanation":"像瓦片那样碎裂，像星星那样飞散。比喻人群离散，各奔东西。","source":{"text":"殊不知彼皆队舞聂戏之类，若闻胡寇之来，则瓦解星散不知所之矣。","book":"宋·司马光《义勇第五札子》"},"example":{"text":"正青春似水，娇儿幼女成家计，无忧虑，少萦系；平地起风波二千尺，一家儿～！","book":"元·关汉卿《鲁斋郎》第二折"},"similar":["瓦解星散"],"usage":"作谓语、宾语、状语；指人心涣散"},{"id":31839,"word":"瓦釜之鸣","pinyin":"wǎ fǔ zhí míng","abbr":"wfzm","explanation":"瓦釜：沙锅，比喻庸才。声音低沉的沙锅发出雷鸣般的响声。比喻庸人占据高位。","source":{"text":"黄钟毁弃，瓦釜雷鸣。谗人高张，贤士无名。","book":"战国·楚·屈原《卜居》"},"similar":["瓦釜雷鸣","雷鸣瓦釜"],"usage":"作主语、宾语、定语；指庸才占高位"},{"id":31840,"word":"瓦釜雷鸣","pinyin":"wǎ fǔ léi míng","abbr":"wflm","explanation":"瓦釜：沙锅，比喻庸才。声音低沉的沙锅发出雷鸣般的响声。比喻无德无才的人占据高位，威风一时。","source":{"text":"黄钟毁弃，瓦釜雷鸣。谗人高张，贤士无名。","book":"战国·楚·屈原《楚辞·卜居》"},"example":{"text":"其结果必然成为～、黄钟毁弃的世界。","book":"郭沫若《沸羹集·为革命的民权而呼吁》"},"similar":["小人得志","庸才显赫","瓦釜之鸣"],"opposite":["黄钟毁弃"],"usage":"作主语、宾语、定语；指庸才占高位"},{"id":31841,"word":"瓦鸡陶犬","pinyin":"wǎ jī táo quǎn","abbr":"wjtq","explanation":"泥土烧制的鸡犬。比喻徒具形式而无实际用途。","source":{"text":"夫陶犬无守夜之警，瓦鸡无司晨之益。","book":"南朝·梁·萧绎《金缕子·立言上》"}},{"id":31842,"word":"瓮中之鳖","pinyin":"wèng zhōng zhī biē","abbr":"wzzb","explanation":"困在瓮中的甲鱼。比喻已在掌握之中，逃跑不了的东西。","source":{"text":"杨八老和一群百姓们，都被倭奴擒了，好似瓮中之鳖，釜中之鱼，没处躲闪，只得随顺以图苟活。","book":"明·冯梦龙《喻世明言》卷十八"},"example":{"text":"这几个小南蛮，只算得个～，不消费得僧家大刀，管教他一个个束手就缚。（清·钱彩《说岳全传》第七十六回）"},"similar":["瓮中捉鳖"],"opposite":["漏网之鱼"],"usage":"作宾语；指已在掌握之中"},{"id":31843,"word":"瓮中捉鳖","pinyin":"wèng zhōng zhuō biē","abbr":"wzzb","explanation":"从大坛子里捉王八。比喻想要捕捉的对象已在掌握之中。形容手到擒来，轻易而有把握。","source":{"text":"这是揉着我山儿的痒处，管教他瓮中捉鳖，手到拿来。","book":"元·康进之《李逵负荆》第四折"},"example":{"text":"我们法术单怕狗血人屎，叫人围住，他在睡梦里，把秽物浑身一淋，他便施展不得。～，手到拿来。","book":"清·陈忱《水浒后传》第六回"},"similar":["十拿九稳","稳操胜券","瓮中之鳖"],"usage":"作谓语、宾语、定语；指轻易而有把握"},{"id":31844,"word":"瓮声瓮气","pinyin":"wèng shēng wèng qì","abbr":"wswq","explanation":"形容声音粗大低沉。","source":{"text":"早听见门里看家的狗，瓮声瓮气如恶豹一般顿着链子咬起来。","book":"清·文康《儿女英雄传》第14回"},"example":{"text":"他～了半天，我们没听出什么来。"},"usage":"作谓语、状语；指人的说话"},{"id":31845,"word":"瓮天之见","pinyin":"wèng tiān zhī jiàn","abbr":"wtzj","explanation":"瓮天：坐在瓮中观天，见天不大。比喻短浅的见识。","source":{"text":"似逢海若谈秋水，始觉醯鸡守瓮天。","book":"宋·黄庭坚《再次韵奉答子由》诗"},"usage":"作宾语；多用于比喻句"},{"id":31846,"word":"瓮天蠡海","pinyin":"wèng tiān lí hǎi","abbr":"wtlh","explanation":"自瓮窥天，以瓢测海。比喻识见短浅。","source":{"text":"辄于占毕之暇，稍为是正，瓮天蠡海，亡当大方。","book":"明·胡应麟《少室山房笔丛·丹铅新录引》"},"usage":"作宾语、定语；用于比喻句"},{"id":31847,"word":"瓮尽杯干","pinyin":"wèng jìn bēi gān","abbr":"wjbg","explanation":"原指酒已喝尽。比喻钱已用完，囊空如洗。","source":{"text":"陈秀才那时已弄得瓮尽杯干，只得收了心，在家读书。","book":"明·凌蒙初《初刻拍案惊奇》第15卷"},"similar":["弹尽粮绝","囊空如洗"],"usage":"作谓语、定语；指囊空如洗"},{"id":31848,"word":"瓮牖桑枢","pinyin":"wèng yǒu sāng shū","abbr":"wyss","explanation":"牖：窗子；枢：门的转轴。破瓮做窗，绳作门轴。比喻贫穷人家。","source":{"text":"然而陈涉，瓮牖绳枢之子，氓隶之人，而迁徒之徒也。","book":"汉·贾谊《过秦论》"},"example":{"text":"既有这上天梯，可怎生不着我这青霄步？我可便望兰堂画阁，刬地亲戚着我～。","book":"元·马致远《荐福碑》第一折"},"similar":["瓮牖绳枢"],"usage":"作宾语、定语；比喻贫穷人家"},{"id":31849,"word":"瓮牖绳枢","pinyin":"wèng yǒu shéng shū","abbr":"wyss","explanation":"牖：窗子；枢：门的转轴。破瓮做窗，绳作门轴。比喻贫穷人家。","source":{"text":"然而陈涉瓮牖绳枢之子，甿隶之人，而迁徙之徒也。","book":"汉·贾谊《过秦论》上"},"example":{"text":"夫先生以～之子，一旦而为天子所知，亦可为荣矣。","book":"清·黄宗羲《陈伯美先生七十寿序》"},"similar":["蓬门荜户","瓮牖桑枢"],"usage":"作宾语、定语；比喻贫穷人家"},{"id":31850,"word":"瓮里醯鸡","pinyin":"wèng lǐ xī jī","abbr":"wlxj","explanation":"醯鸡：即蠓，酒瓮中生的一种小虫。比喻见闻狭隘的人。","source":{"text":"厥昭生乎湿，醯鸡生乎酒。","book":"《列子·天瑞》"},"example":{"text":"怡堂燕雀，不知后灾，～，安有广见。","book":"清·程允升《幼学琼林·鸟兽》"},"similar":["井底之蛙"],"usage":"作宾语；指见闻狭隘的人"},{"id":31851,"word":"瓯饭瓢饮","pinyin":"ōu fàn piáo yǐn","abbr":"ofpy","explanation":"瓯：小盆。用小盆吃饭，用瓢喝水。形容穷苦的生活。","source":{"text":"汝父母皆不知，我岂惜瓯饭瓢饮乎？","book":"清·蒲松龄《聊斋志异·曾友于》"},"similar":["箪食瓢饮"],"usage":"作宾语、定语；指生活清苦"},{"id":31852,"word":"瓶坠簪折","pinyin":"píng zhùi zān zhé","abbr":"pzzz","explanation":"瓶落水底难觅，簪子折断难接。比喻男女分离。","source":{"text":"虽然是一时间花残月缺，休猜做瓶坠簪折。","book":"元王实甫《西厢记》第四本第四折"},"example":{"text":"望蓝桥远似三山，烟水迷茫，道路艰难，～，风酸月苦，雨涩云悭。","book":"明陈铎《新水令·春怨》套曲"},"similar":["瓶沉簪折"],"opposite":["破镜重圆"],"usage":"作宾语、定语；指男女分离"},{"id":31853,"word":"瓶沉簪折","pinyin":"píng chén zān zhé","abbr":"pczz","explanation":"瓶沉水底难觅，簪子折断难接。比喻男女分离。","source":{"text":"井底引银瓶，银瓶欲上丝绳绝；石上磨玉簪，玉簪欲成中央折。瓶沉簪折知奈何，似妾今朝与君别。","book":"唐白居易《井底引银瓶》诗"},"example":{"text":"将谓瓶沉而簪折，岂期璧返而珠还。","book":"《剪灯新话·翠翠传》"},"similar":["瓶坠簪折"],"opposite":["破镜重圆"],"usage":"作宾语、定语；指男女分离"},{"id":31854,"word":"瓶罄罍耻","pinyin":"píng qìng léi chǐ","abbr":"pqlc","explanation":"①比喻关系密切，相互依存，彼此利害一致。②形容物伤其类。","source":{"text":"瓶之罄矣，维罍之耻。","book":"《诗·小雅·蓼莪》"},"example":{"text":"麟亡星落，月死珠伤。～，芝焚蕙叹。北周庚信《思旧铭》"},"usage":"作宾语、定语；用于书面语"},{"id":31855,"word":"甄奇录异","pinyin":"zhēn qí lù yì","abbr":"zqly","explanation":"指选拔录用优秀的人才。","source":{"text":"［李肃］善论议，臧否得中，甄奇录异，荐述后进，题目品藻，曲有条贯，众以此服之。","book":"《三国志·吴志·步骘传》：“骘于是条于时事业在荆州界者，诸葛瑾……李肃、周条、石幹十一人，甄别形状。”裴松之注引三国·吴·韦昭《吴书》"},"usage":"作谓语、定语；用于书面语"},{"id":31856,"word":"甄心动惧","pinyin":"zhēn xīn dòng jù","abbr":"zxdj","explanation":"敬慎而保持警惕。","source":{"text":"甄心动惧日顷。","book":"《逸周书·道法》"},"example":{"text":"《文献通考·经籍五》：“独顷公有赂王请命之事，其谥又为～之名，如汉诸侯王必其尝以罪谪，然后加以此谥，以是意其必有弃贤用佞之失。”"},"usage":"作谓语、定语；用于书面语"},{"id":31857,"word":"甄才品能","pinyin":"zhēn cái pǐn néng","abbr":"zcpn","explanation":"指甄别、品评才能。","source":{"text":"东西二省府国，长屯所积，财单禄寡，良以矜怀。选部可甄才品能，推校年月，邦守邑丞，随宜量处，以贫为先。","book":"《南齐书·郁林王纪》"},"usage":"作谓语、定语；用于书面语"},{"id":31858,"word":"甄烦就简","pinyin":"zhēn fán jiù jiǎn","abbr":"zfjj","explanation":"甄别繁冗的，采用简便的。","source":{"text":"绍量功节用，甄烦就简，凡有赐给，千匹以上，皆别覆奏，然后出之。","book":"《魏书·范绍传》"},"similar":["删繁就简"],"usage":"作谓语、定语；指删繁就简"},{"id":31859,"word":"甄繁就简","pinyin":"zhēn fán jiù jiǎn","abbr":"zfjj","explanation":"甄别繁杂的，采用简便的。","source":{"text":"绍量功节用，甄繁就简，凡有赐给，千匹以上，皆别覆奏，然后出之。","book":"《魏书·范绍传》"}},{"id":31860,"word":"甑尘釜鱼","pinyin":"zēng chén fǔ yú","abbr":"zcfy","explanation":"甑里积了灰尘，锅里生了蠹鱼。形容穷困断炊已久。也比喻官吏清廉自守。","source":{"text":"甑中生尘范史云，釜中生鱼范荚芜。","book":"《后汉书·范冉传》"},"example":{"text":"若如古时范史云，曾官莱芜令，甘自受着～。","book":"明·天然智叟《石头点·贪婪汉六院卖风流"},"similar":["鱼釜尘甑","甑生尘"],"usage":"作定语；指生活贫困","story":["汉朝时期，范冉遭到阉党的禁锢，只好弃官推鹿车载着妻子进行云游，经常是走到哪里无钱住店就在树荫下休息。十多年后终于自己盖了一间茅草屋，经常是断粮，靠吃野菜为生。同乡人嘲笑他说：“甑中生尘范史云，釜中生鱼范莱芜。”"]},{"id":31861,"word":"甑生尘","pinyin":"zèng shēng chén","abbr":"zsc","explanation":"甑：炊具。甑里积了灰尘。形容生活贫困，断炊已久","source":{"text":"先生经旬甑生尘。","book":"宋·陆游《连阴欲雪排闷》"},"similar":["甑尘釜鱼"],"usage":"作定语；指生活贫困"},{"id":31862,"word":"甑釜生尘","pinyin":"zēng fǔ shēng chén","abbr":"zfsc","explanation":"甑：古代蒸食的炊具。甑里积了灰尘，锅里生了蠹鱼。形容穷困断炊已久。也比喻官吏清廉自守。","source":{"text":"甑中生尘范史去，釜中生鱼范荚芜。","book":"《后汉书·范冉传》"},"example":{"text":"自为我家妇，甑釜常生尘。（清·黄景仁《春城》）"}},{"id":31863,"word":"甘为戎首","pinyin":"gān wéi róng shǒu","abbr":"gwrs","explanation":"甘：情愿，甘愿；为：做；戎：军事，征伐；戎首：挑起战争的人。甘愿当战争的主谋。","source":{"text":"毋为戎首，不亦善乎？","book":"《礼记·檀弓下》"},"example":{"text":"曹、吴祸国穷兵，残民以逞，～，举国痛心。","book":"冯玉祥《我所知道的蒋介石》第六十六章"},"usage":"作谓语；用于处事"},{"id":31864,"word":"甘之如荠","pinyin":"gān zhī rú jì","abbr":"gzrj","explanation":"荠：荠菜，其味先苦后甜。象吃了先苦后甜的荠菜一样内心很高兴、愉悦。比喻做愿意的事情，虽然受了苦，心里也很甜美。","source":{"text":"谁谓荼苦，其甘如荠。","book":"《诗经·邶风·谷风》"},"example":{"text":"投袂之日，斯之必死，菹醢之戮，～。","book":"《晋书·刘沈传》"},"similar":["甘心如荠"],"usage":"作谓语、定语、状语；用于处事"},{"id":31865,"word":"甘之如饴","pinyin":"gān zhī rú yí","abbr":"gzry","explanation":"甘：甜；饴：麦芽糖浆。感到象糖那样甜。指为了从事某种工作，甘愿承受艰难、痛苦。","source":{"text":"其所生菜，虽有性苦者，甘如饴也。","book":"《诗经·大雅·绵》：“堇茶如饴。”郑玄笺"},"example":{"text":"背书背不出，“老师”往往大发娇嗔，自然骂得人下不了台，而张曜～。","book":"高阳《清宫外史》上册"},"similar":["甘心情愿","何乐不为"],"opposite":["欲罢不能"],"usage":"作谓语、宾语；指甘愿承受艰难、痛苦","story":["宋朝末年，文天祥率军抗元，不幸被捕，关入元军的土牢，汉奸张弘范劝他投降，他坚决拒绝。他在又矮又窄的地牢里呆了三年，始终不投降，最后被元朝皇帝忽必烈下令杀害，他在狱中写下《正气歌》：“鼎钁甘如饴，求之不可得。”"]},{"id":31866,"word":"甘之若素","pinyin":"gān zhī ruò sù","abbr":"gzrs","explanation":"若素：就像往常一样。虽然遭受不平，但甘愿承受，就像平素一样。","source":{"text":"少奶奶却从来没过半句怨言，甘之若素。","book":"清·吴趼人《二十年目睹之怪现状》第八十九回"},"usage":"作谓语、定语；用于处事"},{"id":31867,"word":"甘之若饴","pinyin":"gān zhī ruò yí","abbr":"gzry","explanation":"甘：以为甘；饴：甜。把它看成像糖那样甜。比喻甘愿承担艰苦的事情和作出牺牲。","source":{"text":"言者踵至，斥逐罪死，甘之若饴，而不能得君心一悟。","book":"《明史·桑乔等传赞》"},"similar":["甘之如饴"],"usage":"作谓语、宾语；指甘愿承受艰难、痛苦"},{"id":31868,"word":"甘井先竭","pinyin":"gān jǐng xiān jié","abbr":"gjxj","explanation":"甜水井的水先枯竭。比喻有才能的人往往早衰。","source":{"text":"直木先伐，甘井先竭。","book":"《庄子·山木》"},"similar":["直木先伐"],"usage":"作宾语、定语；用于开导人"},{"id":31869,"word":"甘冒虎口","pinyin":"gān mào hǔ kǒu","abbr":"gmhk","explanation":"指甘愿冒着生命危险。","source":{"text":"丰知绍将败，败则己必死，甘冒虎口以尽忠规，烈士之于所事，虑不存己。","book":"《三国志·魏志·袁绍传》“吾不用田丰言，果为所笑”裴松之注引晋·孙盛曰"},"usage":"作谓语、状语；用于处事"},{"id":31870,"word":"甘分随时","pinyin":"gān fèn suí shí","abbr":"gfss","explanation":"甘愿顺随时世环境。","source":{"text":"常则是半生忙不遂，我平生志，居陋巷甘分随时。","book":"元·无名氏《谇范叔》楔子"},"usage":"作谓语、宾语；用于处事"},{"id":31871,"word":"甘处下流","pinyin":"gān chǔ xià liú","abbr":"gcxl","explanation":"甘愿处于下流。比喻甘居落后。","source":{"text":"尔为尔之官，我为我之丐，何预尔事邪？不顾而去，此子甘处下流，真别有肺肠者。","book":"清·俞樾《右台仙馆笔记·无锡杨氏女》"},"similar":["甘居下流","甘居人后"],"opposite":["不甘落后"],"usage":"作谓语、宾语、定语；用于处世"},{"id":31872,"word":"甘居下流","pinyin":"gān jū xià liú","abbr":"gjxl","explanation":"甘愿处于河流的下游。比喻甘居落后。","source":{"text":"尔为尔之官，我为我之匄，何预尔事邪？不顾而去，此子甘处下流，真别有肺肠者。","book":"清·俞樾《右台仙馆笔记·无锡杨氏女》"},"similar":["甘处下流","甘居人后"],"opposite":["不甘落后"],"usage":"作谓语、宾语、定语；用于处世"},{"id":31873,"word":"甘居人后","pinyin":"gān jū rén hòu","abbr":"gjrh","explanation":"甘：自愿；居：在（某种位置）。指甘心落在他人之后。","source":{"text":"夺利争名，甘居人后，观场游戏，肯让人先。","book":"明·张岱《自为墓志铭》"},"example":{"text":"她是负有使命的人，都是罄着所有生命之力在奔跑，他也就不愿～了。","book":"老舍《四世同堂》五八"},"similar":["甘拜下风","甘居下流"],"opposite":["力争上游"],"usage":"作谓语、宾语、状语；用于人"},{"id":31874,"word":"甘心为伍","pinyin":"gān xīn wéi wǔ","abbr":"gxww","explanation":"甘心：情愿；伍：同列，同辈。心甘情愿与其同列。","source":{"text":"信出门笑曰：生乃与哙等为伍。","book":"西汉·司马迁《史记·淮阴侯传》"},"opposite":["羞与为伍"],"usage":"作谓语、定语；用于处事"},{"id":31875,"word":"甘心乐意","pinyin":"gān xīn lè yì","abbr":"gxly","explanation":"甘心：心里乐意。心里完全愿意，毫不勉强。","source":{"text":"但是为了钱先生的恢复健康，就是冬天没有皮袍穿，他也甘心乐意。","book":"老舍《四世同堂》"},"example":{"text":"为了让心爱的人幸福，自己累一点也是～的。"},"similar":["甘心情愿"],"usage":"作谓语、定语、状语；用于处事"},{"id":31876,"word":"甘心受罚","pinyin":"gān xīn shòu fá","abbr":"gxsf","explanation":"甘心：情愿。情愿受到处罚。","example":{"text":"他已彻底认输～了。"},"similar":["甘心鈇钺"],"usage":"作谓语、定语；用于处事"},{"id":31877,"word":"甘心如荠","pinyin":"gān xīn rú jì","abbr":"gxrj","explanation":"荠：甜菜。荼菜虽苦，但是和内心的痛苦相比，觉得就像荠菜一样甜美。后比喻人只要心安理得，即使承受再大的痛苦也觉得很甜美。","source":{"text":"谁谓荼苦？其甘如荠。宴尔新昏，如兄如弟。","book":"《诗经·邶风·谷风》"},"example":{"text":"为了国家，即使牺牲生命，也～。"},"similar":["甘之如荠"],"usage":"作谓语、定语、状语；用于处事"},{"id":31878,"word":"甘心屈从","pinyin":"gān xīn qū cóng","abbr":"gxqc","explanation":"甘心：情愿。情愿屈意顺从。","example":{"text":"对于非正义的事情，我不会～的。"},"opposite":["不屈不挠"],"usage":"作谓语、定语；用于处事"},{"id":31879,"word":"甘心忍受","pinyin":"gān xīn rěn shòu","abbr":"gxrs","explanation":"甘心：情愿。情愿忍受痛苦。","source":{"text":"管、召仇也，请受而甘心焉。","book":"春秋·鲁·左丘明《左传·庄公九年》"},"example":{"text":"她～这一切是为了他的儿子能顺利进入大学。"},"usage":"作谓语；用于处事"},{"id":31880,"word":"甘心情原","pinyin":"gān xīn qíng yuán","abbr":"gxqy","explanation":"指完全愿意。"},{"id":31881,"word":"甘心情愿","pinyin":"gān xīn qíng yuàn","abbr":"gxqy","explanation":"心里完全愿意，没有一点勉强。多指自愿作出某种牺牲。","source":{"text":"此事儿甘心情愿也。","book":"宋·王明清《摭青杂说·项四郎》"},"example":{"text":"还必须使全国广大人民群众觉悟，～和我们一起奋斗，去争取胜利。","book":"毛泽东《愚公移山》"},"similar":["何乐不为","甘之如饴"],"opposite":["身不由己","迫不得已"],"usage":"作谓语、状语；形容发自内心"},{"id":31882,"word":"甘心瞑目","pinyin":"gān xīn míng mù","abbr":"gxmm","explanation":"瞑目：闭上眼睛，指死去。心甘情愿，死了也不遗憾。","source":{"text":"吾受厚恩，年迫余日索，常恐不得死国事；今获所愿，甘心瞑目。","book":"《后汉书·马援传》"},"example":{"text":"以此得罪，～。","book":"北齐·颜之推《颜氏家训·省事》"},"similar":["死而无憾"],"opposite":["不甘瞑目","死不瞑目"],"usage":"作谓语；指死而无憾"},{"id":31883,"word":"甘心鈇钺","pinyin":"gān xīn fū yuè","abbr":"gxfy","explanation":"鈇：刑具，铡刀；钺：古兵器，形状象板斧而较大。心甘情愿受惩罚。","source":{"text":"去年有人上书，告禄山逆迹，陛下反赐诛戮。谁肯再甘心鈇钺，来奏君王。","book":"清·洪昇《长生殿·献饭》"},"usage":"作谓语、宾语；用于处事"},{"id":31884,"word":"甘心首疾","pinyin":"gān xīn shǒu jí","abbr":"gxsj","explanation":"甘心：情愿，乐意；首：头；疾：病，引申为痛。想得头痛也心甘情愿。形容男女之间相互思念的痴情。","source":{"text":"愿言思伯，甘心首疾。","book":"《诗经·卫风·伯兮》"},"usage":"作宾语、定语；用于古汉语"},{"id":31885,"word":"甘拜下风","pinyin":"gān bài xià fēng","abbr":"gbxf","explanation":"表示真心佩服，自认不如。","source":{"text":"如此议论，才见读书人自有卓见，真是家学渊源，妹子甘拜下风。","book":"清·李汝珍《镜花缘》"},"example":{"text":"君神人也，吾等～矣。","book":"清·和邦额《夜谭随录·三官保》"},"similar":["心悦诚服","首肯心折","五体投地"],"opposite":["不甘雌伏","不甘示弱"],"usage":"作谓语、宾语；形容自认不如对方","story":["西晋大官僚石苞的儿子石崇没有得到父母的一点遗产，靠自己的功劳晋升为荆州刺史，他不择手段大量搜刮民脂民膏，很快成为西晋头号富翁。晋武帝的亲舅王恺也是一个大富翁，但和石崇比起来真是小巫见大巫，他自己也承认甘拜下风"]},{"id":31886,"word":"甘旨肥浓","pinyin":"gān zhǐ féi nóng","abbr":"gzfn","explanation":"泛指佳肴美味。","source":{"text":"扰之大者，其事有三：一则势利荣名，二则妖妍靡曼，三则甘旨肥浓。","book":"南朝·梁·沈约《述僧中食论》"},"example":{"text":"今欲以～皆充于祭，苟逾旧制，其何极焉。","book":"《新唐书·韦绥传》"},"similar":["美味佳肴","山珍海味"],"usage":"作宾语、定语；指美味"},{"id":31887,"word":"甘棠之惠","pinyin":"gān táng zhī huì","abbr":"gtzh","explanation":"甘棠：木名，即棠梨。指对官吏的爱戴。同“甘棠之爱”。","source":{"text":"函甘棠之惠，挟东征之意。","book":"汉·杨雄《甘泉赋》"},"similar":["甘棠之爱"],"usage":"作宾语；指对官吏的爱戴","story":["周武王时期，大臣召伯奉武王之命巡行南方地区，广施仁政，大大减轻了老百姓的负担，由于政策遭到其他大臣的反对，纷纷攻击与诬陷召伯。召伯为表忠心与清白，死在甘棠树下。召伯死后，民众怀念他，从此不再砍伐甘棠树"]},{"id":31888,"word":"甘棠之爱","pinyin":"gān táng zhī ài","abbr":"gtza","explanation":"甘棠：木名，即棠梨。指对官吏的爱戴。","source":{"text":"蔽芾甘棠，勿剪勿伐，召伯所茇。","book":"《诗经·召南·甘棠》"},"similar":["甘棠之惠"],"usage":"作宾语；指对官吏的爱戴","story":["周武王时期，大臣召伯奉武王之命巡行南方地区，广施仁政，大大减轻了老百姓的负担，由于政策遭到其他大臣的反对，纷纷攻击与诬陷召伯。召伯为表忠心与清白，死在甘棠树下。召伯死后，民众怀念他，从此不再砍伐甘棠树"]},{"id":31889,"word":"甘棠遗爱","pinyin":"gān táng yí ài","abbr":"gtya","explanation":"甘棠：木名，即棠梨；遗：留；爱：恩惠恩泽。旧时颂扬离去的地方官。","source":{"text":"蔽芾甘棠，勿翦勿伐，召伯所茇；蔽芾甘棠，勿剪勿拜，召伯所说。","book":"《诗经·周南·甘棠》"},"example":{"text":"这个异种，大约就是武则天留下的“～”。","book":"清·李汝珍《镜花缘》第五回"},"usage":"作谓语；用于称颂官员的政绩","story":["春秋时期，郑国大夫子产忠君爱民，始终以百胜的利益为重。在他执政期间，曾经进行许多有利于农业生产、有利于民众的政治改革，人们纷纷支持改革。子产死后，大思想家孔子流着眼泪说：“古之遗爱也。”"]},{"id":31890,"word":"甘死如饴","pinyin":"gān sǐ rú yí","abbr":"gsry","explanation":"甘：情愿；饴：饴糖。甘愿去死，就像吃糖一般。形容不怕死，把死作为快事。","source":{"text":"举忠愤激发，甘死如饴，而朕以小丑跳梁，用良臣于危地，思之深恻。","book":"《清史稿·任举传》"},"similar":["视死如归"],"opposite":["贪生怕死"],"usage":"作谓语、宾语；指不怕死"},{"id":31891,"word":"甘泉必竭","pinyin":"gān quán bì jié","abbr":"gqbj","explanation":"甘泉：甜水的泉。竭：尽。甘甜的泉一定会干涸的。比喻有才干的人受累多而往往早衰。同“甘井先竭”。","source":{"text":"肥豕必烹，甘泉必竭，直木必伐。","book":"《逸周书·周祝解》"},"similar":["甘井先竭"],"usage":"作宾语、定语；用于比喻句"},{"id":31892,"word":"甘瓜苦蒂","pinyin":"gān guā kǔ dì","abbr":"ggkd","explanation":"甜瓜的蒂是苦的。比喻没有十全十美的事物。","source":{"text":"甘瓜抱苦蒂，美枣生荆棘。","book":"汉·无名氏《古诗》"},"example":{"text":"～，天下无全美也。","book":"清·翟灏《通俗编·草木》"},"usage":"作宾语；比喻没有十全十美的事物"},{"id":31893,"word":"甘脆肥浓","pinyin":"gān cuì féi nóng","abbr":"gcfn","explanation":"甘脆：指味甜、松脆可口的食物；肥浓：肥美的肉食和浓郁的酒。泛指美好的酒食。","source":{"text":"肥醲甘脆，非不美也，然民有糟糠、菽、粟不接于口者，则明主弗甘也。","book":"《淮南子·主术训》"},"example":{"text":"～，命曰腐肠之药。","book":"汉·枚乘《七发》"}},{"id":31894,"word":"甘脆肥醲","pinyin":"gān cuì féi nóng","abbr":"gcfn","explanation":"甘脆：美味；醲：指酒性浓烈。味美的食物。泛指美好的酒食。","source":{"text":"甘脆肥醲，命曰腐肠之药。","book":"汉·枚乘《七发》"},"example":{"text":"～，命曰腐肠之药；羹藜含糗难语太牢之滋。","book":"清·程允升《幼学故事琼林·饮食》"},"similar":["肥醲甘脆"],"usage":"作谓语、定语；用于生活"},{"id":31895,"word":"甘苦与共","pinyin":"gān kǔ yǔ gòng","abbr":"gkyg","explanation":"甘苦：欢乐和痛苦；与共：共同在一起。共同享受欢乐与幸福，共同承担痛苦与磨难。","source":{"text":"燕王吊死问生，与百姓同其甘苦。","book":"《战国策·燕策一》"},"similar":["同甘共苦"],"usage":"作谓语、定语、状语；指共同进退"},{"id":31896,"word":"甘言厚币","pinyin":"gān yán hòu bì","abbr":"gyhb","explanation":"币：指礼物；厚：重。礼物丰厚，言辞好听。指为了能达到某种目的而用财物诱惑。","source":{"text":"币重而言甘，诱我也。","book":"《左传·僖公十年》"},"example":{"text":"不顾社稷之安危，惟恐么门之不植。～，规灭忠梗。","book":"《梁书·侯景传》"},"similar":["甘言厚礼"],"usage":"作主语、宾语、定语；用于交往"},{"id":31897,"word":"甘言厚礼","pinyin":"gān yán hòu lǐ","abbr":"gyhl","explanation":"甜美的言辞，厚重的礼品。","source":{"text":"臣前遣校尉宿舒、郎中令孙综，甘言厚礼，以诱吴贼。","book":"《三国志·魏志·公孙度传》：“悉斩送弥晏等首。”裴松之注引《魏略》"},"similar":["甘言厚币"],"usage":"作主语、宾语、定语；用于交往"},{"id":31898,"word":"甘言好辞","pinyin":"gān yán hǎo cí","abbr":"gyhc","explanation":"甘言：甜美动听的语言；好辞：逢迎讨好的言辞。甜美动听的逢迎之辞。","source":{"text":"诸侯不料兵之弱，食之寡，而听从人之甘言好辞，比周以相饰也。","book":"《战国策·韩策》"},"example":{"text":"请不能随便相信他们的～"},"similar":["甘言美语","甘言巧辞","甘言蜜语"],"opposite":["污言秽语"],"usage":"作主语、宾语、定语；指阿谀奉承话"},{"id":31899,"word":"甘言媚词","pinyin":"gān yán mèi cí","abbr":"gymc","explanation":"甘言：甜美的语言；媚词：柔美的词句。甜美的语言，柔美的词句。指妇女节对意中人说的体贴温存的话。也指说奉承话，对人献媚。","source":{"text":"则甘言媚词作妇人状。","book":"明·宗臣《报刘一丈书》"},"similar":["甘言好辞","甘言美语","甘言巧辞"],"opposite":["污言秽语"],"usage":"作主语、宾语、定语；指阿谀奉承话"},{"id":31900,"word":"甘言巧辞","pinyin":"gān yán qiǎo cí","abbr":"gyqc","explanation":"甘言：甜美动听的语言；巧辞：逢迎讨好的言辞。甜美动听的逢迎之辞。","source":{"text":"便辟脂事饰其迹，甘言巧辞运其辨。","book":"《战国策·韩策》：“诸侯不料兵之弱，食之寡，而听从人之甘言好辞，比周以相饰也。”唐·王勃《平台秘略论·褒客》"},"similar":["甘言好辞","甘言美语","甘言媚词"],"opposite":["污言秽语"],"usage":"作主语、宾语、定语；指阿谀奉承话"},{"id":31901,"word":"甘言美语","pinyin":"gān yán měi yǔ","abbr":"gymy","explanation":"甜美动听的话。","source":{"text":"诸侯不料兵之弱，食之寡，而听从人之甘言好辞，比周以相饰也。","book":"《战国策·韩策》"},"example":{"text":"你们可密访著船家周四，用～哄他到此，不可说出实情。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["甜言蜜语","甘言好辞"],"usage":"作主语、宾语、定语；指阿谀奉承话"},{"id":31902,"word":"甘言蜜语","pinyin":"gān yán mì yǔ","abbr":"gymy","explanation":"甘：甜，甜言蜜语。指甜美动听的阿谀奉承话。","source":{"text":"你们不该听他们的甘言蜜语……更不该受他们的驱使。","book":"《塞上行·百灵庙战后行》"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“起初对年羹尧～，笼络备至，养成他的骄恣之气。”"},"similar":["甘言美语","甘言巧辞","甘言媚词"],"opposite":["污言秽语"],"usage":"作主语、宾语、定语；指阿谀奉承话"},{"id":31903,"word":"甘败下风","pinyin":"gān bài xià fēng","abbr":"gbxf","explanation":"甘：情愿，乐意；下风：风向的下方。对人自认不如，真心佩服。","source":{"text":"皇天后土实闻君之言，群臣敢在下风。","book":"《庄子·在宥》：“广成子南首而卧，黄帝顺下风膝行而进，再拜稽首而问。”《左传·僖公十五年》"},"example":{"text":"我们全体女民兵向你们男同志挑战，十天过去，那样赶不上你们，我们～，自动解散。","book":"冯德英《迎春花》第二十二章"}},{"id":31904,"word":"甘贫乐道","pinyin":"gān pín lè dào","abbr":"gpld","explanation":"甘贫：情愿受贫困；乐道：乐于守道。甘于受贫，乐于守道。是儒家所倡导的处世态度。","source":{"text":"安贫乐道，恬于进趣，三辅诸儒不仰慕之。","book":"《后汉书·韦彪传》"},"example":{"text":"吾本不求名，既为世所知矣，何用利哉？故～，平生无不足之意。","book":"宋·邵伯温《闻见前录》卷十八"},"similar":["安贫乐道"],"usage":"作谓语、宾语；指儒家思想"},{"id":31905,"word":"甘贫守分","pinyin":"gān pín shǒu fèn","abbr":"gpsf","explanation":"守分：守本分。甘受贫困，守住本分。","source":{"text":"止不过闭户读书，甘贫守分，中心无愧。","book":"明·无名氏《吴起敌秦》第四折"},"similar":["甘贫守节","甘贫守志"],"usage":"作谓语、定语、宾语；用于处世"},{"id":31906,"word":"甘贫守志","pinyin":"gān pín shǒu zhì","abbr":"gpsz","explanation":"甘受贫困，守住志节。","source":{"text":"奉圣人的命，因为你梁鸿甘贫守志，孟光举案齐眉，着小官亲赍此封丹诏，与他加官赐赏。","book":"元·无名氏《举案齐眉》第四折"},"similar":["甘贫守节"],"usage":"作谓语、定语、宾语；用于处世"},{"id":31907,"word":"甘贫守节","pinyin":"gān pín shǒu jié","abbr":"gpsj","explanation":"甘：自愿；贫：穷苦；守：保持。情愿过贫困的生活，也努力保持忠贞的气节。","source":{"text":"甘贫苦节，不愧神明。","book":"唐·韩愈《举张正甫自代状》"},"example":{"text":"今日夫为彭泽令，～乐怡怡。","book":"明·无名氏《东篱赏菊》第一折"},"similar":["甘贫守志"],"usage":"作谓语、定语、宾语；用于处世"},{"id":31908,"word":"甘贫苦节","pinyin":"gān pín kǔ jié","abbr":"gpkj","explanation":"甘：自愿；贫：穷苦；苦：尽力地，有耐心地。情愿过贫困的生活，也努力保持忠贞的气节。","source":{"text":"甘贫苦节，不愧神明。","book":"唐·韩愈《举张正甫自代状》"},"usage":"作谓语、宾语、定语；用于处世"},{"id":31909,"word":"甘酒嗜音","pinyin":"gān jiǔ shì yīn","abbr":"gjsy","explanation":"甘：嗜好。嗜好喝酒和音乐。形容只顾酒色享乐。","source":{"text":"内作色荒，外作禽荒；甘酒嗜音，峻宇雕墙。","book":"《尚书·五子之歌》"},"usage":"作谓语、宾语、定语；用于处世"},{"id":31910,"word":"甘雨随车","pinyin":"gān yǔ suí chē","abbr":"gysc","explanation":"车行到哪里，及时寸就下到哪里。旧时称讼地方官的政治措施的话。","source":{"text":"回赴，雨随车而下。","book":"三国·吴·谢承《后汉书》"},"example":{"text":"～，云低轻重之盖；还珠合浦，波含远近之星。","book":"唐·骆宾王《上兖州启》"},"usage":"作谓语；比喻德政广被"},{"id":31911,"word":"甘露法雨","pinyin":"gān lù fǎ yǔ","abbr":"glfy","explanation":"佛教称如来的教法如降甘露雨水。","source":{"text":"澍甘露法雨，灭除烦恼焰。诤讼经官处，怖畏军阵中。","book":"《妙法莲花经·普门品》"},"example":{"text":"我今身有凋牛良田，除去株杌，唯稀如来～。","book":"《涅槃经》二"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":31912,"word":"甘食好衣","pinyin":"gān shí hǎo yī","abbr":"gshy","explanation":"甘：甜。指吃穿都是好的。形容生活奢华。","source":{"text":"甘其食，美其服，安其居，乐其俗。","book":"春秋·楚·李耳《老子》第80章"},"example":{"text":"民偷～，不事畜藏之产业。","book":"西汉·司马迁《史记·平准书》"},"similar":["锦衣玉食"],"opposite":["粗衣粝食"],"usage":"作主语、宾语、定语；用于生活"},{"id":31913,"word":"甘馨之费","pinyin":"gān xīn zhī fèi","abbr":"gxzf","explanation":"甘：甘甜美味的食物；馨：温馨。指供养双亲的费用。","source":{"text":"养阙甘馨之费，病乏药石之资。","book":"唐·白居易《谢官状》"},"usage":"作主语、宾语；用于书面语"},{"id":31914,"word":"甚嚣尘上","pinyin":"shèn xiāo chén shàng","abbr":"sxcs","explanation":"甚：很；嚣：喧嚷。人声喧嚷，尘土飞扬。原形容军中正忙于准备的状态。后来形容消息普遍淬，议论纷纷。现多指反动言论十分嚣张。","source":{"text":"王曰：‘合谋也，张幕矣。’（伯州犁）曰：‘虔卜於先君也，徹幕矣。’（楚王）曰：‘将发命也。甚嚣，且尘上矣。’","book":"《左传·成公十六年》"},"example":{"text":"虽已电令燮元代理督军，同时苏人争请废督，～。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十二回"},"similar":["满城风雨"],"opposite":["风平浪静"],"usage":"作谓语、宾语、定语；指议论纷纷","story":["春秋时期，晋国袭击郑国，郑国向楚国求援，楚共王亲率大军援郑，楚军趁晋军毫无防备逼近晋军前阵，想迫使晋军投降，晋厉王采纳范文子的儿子的填灶盖井的建议，于是晋军营尘土飞扬，腾地列阵，楚共王轻敌结果被晋军打败"]},{"id":31915,"word":"甜嘴蜜舌","pinyin":"tián zuǐ mì shé","abbr":"tzms","explanation":"象蜜糖一样甜的话。比喻为了骗人而说得动听的话。","source":{"text":"吃吧，吃罢！你不用和我甜嘴蜜舌的了，我都知道啊！","book":"清·曹雪芹《红楼梦》第三十五回"},"example":{"text":"他的～使我信以为真，结果上了当。"},"similar":["甜言蜜语"],"usage":"作主语、宾语；指骗人的动听话"},{"id":31916,"word":"甜蜜动听","pinyin":"tián mì dòng tīng","abbr":"tmdt","explanation":"悦人的甜美。","example":{"text":"我喜欢她那～的歌声。"},"similar":["甜言蜜语"],"usage":"作谓语、定语；指甜言蜜语"},{"id":31917,"word":"甜言媚语","pinyin":"tián yán mèi yǔ","abbr":"tymy","explanation":"甜蜜温柔的话。同“甜言软语”。","source":{"text":"滴珠叹了一口气，缩做一团，被吴大郎甜言媚语，轻轻款款，板将过来。","book":"明·凌濛初《初刻拍案惊奇》卷二"},"example":{"text":"凭着一昧～哄他，从此做了长相交也不见得。","book":"明·凌濛初《初刻拍案惊奇》卷六"},"similar":["甜言蜜语","甜言软语"],"usage":"作主语、宾语；指骗人开心的话"},{"id":31918,"word":"甜言美语","pinyin":"tián yán měi yǔ","abbr":"tymy","explanation":"指说好听的话。也指好言好语。","source":{"text":"别人行甜言美语三冬暖，我根前恶语伤人六月寒。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"太尉到那里，须是陪些和气，用～抚恤他众人，好共歹，只要成全大事。","book":"《水浒传》第七五回"},"similar":["甜言蜜语","甜言媚语","甜语花言"],"usage":"作主语、宾语、定语；指骗人开心的话"},{"id":31919,"word":"甜言蜜语","pinyin":"tián yán mì yǔ","abbr":"tymy","explanation":"象蜜糖一样甜的话。比喻为了骗人而说得动听的话。","source":{"text":"化一盏茶吃，你可是甜言蜜语的，出家人那里不是积福处。","book":"元·马致远《岳阳楼》第二折"},"example":{"text":"卞福坐在旁边，～，劝了一回。","book":"明·冯梦龙《醒世恒言》卷三十六"},"similar":["口蜜腹剑","言不由衷","甜言美语"],"opposite":["恶语中伤","推心置腹"],"usage":"作主语、宾语；指骗人开心的话","story":["唐玄宗时期，宰相李林甫是一个老奸巨猾而又阴险毒辣的人，他表面上装得十分忠厚和善，说话总是甜言蜜语，经常是暗藏毒计，被他陷害的人还认为他够义气。凡是唐玄宗信任的人，他总是去巴结、离间，背后进行打击报复"]},{"id":31920,"word":"甜言软语","pinyin":"tián yán ruǎn yǔ","abbr":"tyry","explanation":"甜蜜温柔的话。","source":{"text":"甜言软语，长记那时，萧娘叮嘱。","book":"宋·赵长卿《柳梢青》词"},"example":{"text":"终日将买酒为由，～，哄动他夫妻二人。","book":"明·凌濛初《二刻拍案惊奇》第28卷"},"similar":["甜言蜜语","甜言媚语"],"usage":"作主语、宾语；指甜蜜的话语"},{"id":31921,"word":"甜语花言","pinyin":"tián yǔ huā yán","abbr":"tyhy","explanation":"甜美谄谀的话。","source":{"text":"季布得知心里怕，甜言美语却安存。","book":"《敦煌变文集·捉季布传文》"},"similar":["甜言蜜语","甜言媚语","甜言美语"],"usage":"作主语、宾语、定语；指骗人开心的话"},{"id":31922,"word":"甜酸苦辣","pinyin":"tián suān kǔ là","abbr":"tskl","explanation":"指种种不同的味道。常用以比喻生活上的种种遭遇和复杂感受。","source":{"text":"阴阳不同气，然其为和同也；酸咸甘苦之味相反，然其为善均也。","book":"《鹖冠子·环流五》"},"example":{"text":"这时听说周伯通已经获释，不禁茫然若失，～诸般滋味，一齐涌上心来。","book":"金庸《射雕英雄传》第三十一回"},"similar":["酸甜苦辣","酸咸苦辣"],"usage":"作主语、宾语；形容人生"},{"id":31923,"word":"生上起下","pinyin":"shēng shàng qǐ xià","abbr":"ssqx","explanation":"犹承上启下。承接上面的，引起下面的。","source":{"text":"谨按《大宗伯》职云：‘若王不与祭祀，则摄位。’注云：‘王有故，代行其祭事。’下文去：‘凡大祭祀，王后不与，则摄而荐豆笾，彻。’……凡者，生上起下之名，不专系于本职。","book":"《旧唐书·褚无量传》"},"similar":["承上启下"],"usage":"作谓语、定语；用于书面语"},{"id":31924,"word":"生不如死","pinyin":"shēng bù rú sǐ","abbr":"sbrs","explanation":"活着还不如死去。指人的处境十分恶劣。","source":{"text":"奈因阳世三间，没有我脚踏之地，是生不如死！","book":"清·石玉昆《小五义》第十回"},"example":{"text":"他们过着～的生活。"},"usage":"作宾语、定语；指人的处境"},{"id":31925,"word":"生不逢场","pinyin":"shēng bù féng cháng","abbr":"sbfc","explanation":"犹生不逢时。旧时指命运不好。","source":{"text":"生不逢场闲则剧，年似龚生犹夭。","book":"宋·刘克庄《贺新郎》词"},"similar":["生不逢时","生不逢辰"],"usage":"作谓语、定语、宾语；指命运不好"},{"id":31926,"word":"生不逢时","pinyin":"shēng bù féng shí","abbr":"sbfs","explanation":"生下来没有遇到好时候。旧时指命运不好。","source":{"text":"我生不辰，逢天僤怒。","book":"《诗经·大雅·桑柔》"},"example":{"text":"昔汉文帝不知魏尚贤而囚之，知李广才而不用，乃叹其～。","book":"《新唐书·魏元忠传》"},"similar":["生不逢辰","时运不济","生不逢场"],"opposite":["吉星高照","吉人天相"],"usage":"作谓语、定语、宾语；指命运不好"},{"id":31927,"word":"生不逢辰","pinyin":"shēng bù féng chén","abbr":"sbfc","explanation":"辰：日子，时光。生下来没有遇到好时候。旧时指命运不好。","source":{"text":"我生不辰，逢天僤怒。","book":"《诗经·大雅·桑柔》"},"example":{"text":"南风不竞死声多，～可若何。","book":"清·黄遵宪《乙丑十一月避乱大埔三河虚》"},"similar":["时运不济","生不逢时"],"opposite":["吉星高照","吉人天相"],"usage":"作谓语、定语；用于感慨"},{"id":31928,"word":"生不遇时","pinyin":"shēng bù yù shí","abbr":"sbys","explanation":"生下来没有遇到好时候。旧时指命运不好。","source":{"text":"吾先得荣后僇者，非智衰也；先遇明后遭险，君之易移也已矣，生不遇时，复何言哉。","book":"《诗经·大雅·桑柔》 ：“我生不辰，逢天僤怒。”汉·袁康《越绝书·越绝德序外传记》"},"example":{"text":"清·褚人获《隋唐演义》第十回：“自叹～，隐居华山，做了道士。”"},"similar":["身不遇时","生不逢时","生不逢辰"],"usage":"作谓语、定语、宾语；指命运不好"},{"id":31929,"word":"生世不谐","pinyin":"shēng shì bù xié","abbr":"ssbx","explanation":"谐：和谐、融洽。形容人命运不好。","source":{"text":"生世不谐，作太常妻，一岁三百六十日，三百五十九日斋。","book":"《后汉书·周泽传》"},"example":{"text":"大丈夫～，而困如是乎。","book":"唐·沈既济《枕中记》"}},{"id":31930,"word":"生之者众，食之者寡","pinyin":"shēng zhī zhě zhòng，shí zhī zhě guǎ","abbr":"szzzszzg","explanation":"众：多；寡：少。生产的多，消费的少。形容财富充足。","source":{"text":"生财有大道，生之者众，食之者寡，为之者疾，用之者舒，则财恒足矣。","book":"《礼记·大学》"},"example":{"text":"我想理财之道，大约总不外乎“～；为之者疾，用之者舒”的这番道理。","book":"清·文康《儿女英雄传》第三十三回"}},{"id":31931,"word":"生事微渺","pinyin":"shēng shì wēi miǎo","abbr":"sswm","explanation":"生事：生计、谋生的路；微渺：渺茫。指生活非常艰难。","source":{"text":"所恨俺自小孤单，生事微渺。","book":"明·汤显祖《牡丹亭·言怀》"},"usage":"作谓语、定语；用于书面语"},{"id":31932,"word":"生事扰民","pinyin":"shēng shì rǎo mín","abbr":"ssrm","explanation":"制造事端，扰乱民众。指故意寻衅闹事，侵害人民。","source":{"text":"那班倚势作威的小人，都要生事扰民。","book":"清·褚人获《隋唐演义》第七十八回"},"example":{"text":"清·褚人获《隋唐演义》第78回：“那班倚势作威的小人，都要～。”"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":31933,"word":"生于忧患而死于安乐","pinyin":"shēng yú yōu huàn ér sǐ yú ān lè","abbr":"syyhesyal","explanation":"忧患：患难。忧患使人勤奋，因而得生；安乐使人怠惰，因而萎靡致死。","source":{"text":"然后知生于忧患而死于安乐而死于安乐也。","book":"战国·邹·孟轲《孟子·告子下》"},"example":{"text":"屯难困顿者，乃所以成君子之美也，故曰～。","book":"宋·陆九渊《与苏宰相书》"},"usage":"作定语、宾语；用于书面语"},{"id":31934,"word":"生于忧患，死于安乐","pinyin":"shēng yú yōu huàn，sǐ yú ān lè","abbr":"syyhsyal","explanation":"指艰难使人奋进，安逸使人沉沦。","source":{"text":"然后知生于忧患而死于安乐也。","book":"《孟子·告子下》"},"example":{"text":"然君每因是以自省察，故缺失由是而知，德业由是而进。屯难困顿者，乃所以成君子之美也，故曰生于忧患而死于安乐。","book":"宋·陆九渊《与苏宰书》"}},{"id":31935,"word":"生人涂炭","pinyin":"shēng rén tú tàn","abbr":"srtt","explanation":"生人：百姓；涂：泥沼；炭：炭火。人民陷在泥塘和火坑里。形容人民处于极端困苦的境地。","source":{"text":"在昔金陵，天下丧乱，王室版荡，生人涂炭，兄弟则五郡分张，父子则三州离散。","book":"北周·庾信《伤心赋》"},"example":{"text":"故割疆土者非一所，称帝王者非一人，书轨不同，～。","book":"《隋书·高祖纪》"},"similar":["生民涂炭","民生涂炭","涂炭生民"],"opposite":["国泰民安","安居乐业"],"usage":"作谓语、宾语；指社会时局"},{"id":31936,"word":"生众食寡","pinyin":"shēng zhòng shí guǎ","abbr":"szsg","explanation":"众：多；寡：少。生产的多，消费的少。形容财富充足。","source":{"text":"生财有大道，生之者众，食之者寡，为之者疾，用之者舒，则财恒足矣。","book":"西汉·戴圣《礼记·大学》"},"example":{"text":"而于古先圣王～、为疾用舒之道，昧焉不讲。","book":"《清史稿·食货志一》"},"usage":"作宾语、定语；指生产与消费"},{"id":31937,"word":"生佛万家","pinyin":"shēng fó wàn jiā","abbr":"sfwj","explanation":"shēng  fó  wàn  jiā","source":{"text":"福星一路之歌谣，生佛万家之香火。","book":"宋·戴翼《贺陈待制启》"},"similar":["万家生佛"],"usage":"作主语、宾语、定语；指地方官"},{"id":31938,"word":"生儿育女","pinyin":"shēng ér yù nǚ","abbr":"seyn","explanation":"指生育子女。同“生男育女”。","source":{"text":"她不曾生儿育女，老太爷是她的靠山，她当然比别人更关心老太爷。","book":"巴金《谈》"},"example":{"text":"我现在很想～。"},"similar":["生男育女"],"usage":"作谓语、宾语、定语；指繁育后代"},{"id":31939,"word":"生公说法","pinyin":"shēng gōng shuō fǎ","abbr":"sgsf","explanation":"生公：晋末高僧竺道生，世称生公。竺道生解说佛法，能使顽石点头。比喻精通者亲自来讲解，必能透彻说理而使人感化。","source":{"text":"竺道生入虎丘山，聚石为徒，讲《涅槃经》，群石皆点头。","book":"《莲社高贤传》"},"example":{"text":"谁谓周郎顾曲之场，非即～之地乎！","book":"清·俞樾《余莲村劝善杂剧序》"},"similar":["生公说法，顽石点头"],"usage":"作宾语、定语；指高人指点","story":["晋末高僧竺道生15岁就登坛讲法，20岁上庐山讲授佛法，成为江南的佛学大师，他潜心研究刚传入中国的《涅槃经》，参悟到其中的奥妙，得出“人人皆可成佛”的理论推断，因此被逐出庐山，他流浪到苏州虎丘山讲法，顽石都为之点头"]},{"id":31940,"word":"生公说法，顽石点头","pinyin":"shēng gōng shuō fǎ，wán shí diǎn tóu","abbr":"sgsfwsdt","explanation":"shēng  gōng  shuō  fǎ，wán  shí  diǎn  tóu","source":{"text":"传说晋朝和尚道生法师对着石头讲经，石头都点头了。比喻精通者亲自来讲解，必能透彻说理而使人感化。"},"similar":["生公说法"],"usage":"作宾语、定语、分句；用于书面语","story":["晋末高僧竺道生15岁就登坛讲法，20岁上庐山讲授佛法，成为江南的佛学大师，他潜心研究刚传入中国的《涅槃经》，参悟到其中的奥妙，得出“人人皆可成佛”的理论推断，因此被逐出庐山，他流浪到苏州虎丘山讲法，顽石都为之点头"]},{"id":31941,"word":"生关死劫","pinyin":"shēng guān sǐ jié","abbr":"sgsj","explanation":"生的关头，死的劫数。泛指生死命运。","source":{"text":"昨贫今富人劳碌，春荣秋谢花折磨。似这般，生关死劫谁能躲？","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"谁能逃过这次～呢？"},"similar":["生死关头"],"usage":"作主语、宾语；指人的生死命运","story":["贾宝玉去宁国府游玩，中午在秦可卿床上歇息，梦中畅游太虚幻境，警幻仙子带领他翻阅了“金陵十二钗副册”，品尝百花美酒，欣赏仙子们的《红楼梦》歌舞，其中《虚花悟》唱道：“昨贫今富人劳碌，春荣秋谢花折磨。似这般，生关死劫谁能躲？”"]},{"id":31942,"word":"生刍一束","pinyin":"shēng chú yī shù","abbr":"scys","explanation":"原意是指新割的青草一捆。后用来表示薄薄的一点儿礼物，寓意极其深厚。也指用一捆青草作为吊丧的礼物。","source":{"text":"皎皎白驹，在彼空谷。生刍一束，其人如玉。毋金玉尔音，而有遐心。","book":"《诗经·小雅·白驹》"},"example":{"text":"杖而后起，出视庐前，见有～，置诸地上，因即问明旁人，才知有人吊丧，置刍自去。","book":"蔡东藩《后汉演义》第五十二回"}},{"id":31943,"word":"生则同衾，死则同穴","pinyin":"shēng zé tóng qīn，sǐ zé tóng xué","abbr":"sztqsztx","explanation":"衾：被子；穴：墓穴。活着同盖一条被子，死了同葬一个墓穴。形容夫妇感情深厚。","source":{"text":"不恋豪杰，不羡骄奢，自愿地生则同衾，死则同穴。","book":"元·王实甫《西厢记》第四本第四折"}},{"id":31944,"word":"生别死离","pinyin":"shēng bié sǐ lí","abbr":"sbsl","explanation":"犹生离死别。指很难再见的离别或永久的离别。","source":{"text":"未亡人衔哀惨凄，念一家生别死离，衷情诉与谁！","book":"明·邵璨《香囊记·寻兄》"},"similar":["生离死别","死别生离","生离死绝"],"usage":"作宾语、主语、定语；指生死永别"},{"id":31945,"word":"生力军","pinyin":"shēng lì jūn","abbr":"slj","explanation":"指新投入战斗的精锐部队。也用来比喻新加入某种工作或某种活动能起积极作用的人员。","source":{"text":"守有城之邑，不如以死人之力与客生力战。其城拔者，死人之力也。","book":"南朝·宋·范晔《商君书·兵守》"},"example":{"text":"背后关兴引～赶来，魏兵自相践踏及落涧身死者，不知其数。","book":"明·罗贯中《三国演义》第九十七回"},"usage":"作主语、宾语、定语；用于书面语"},{"id":31946,"word":"生功止过","pinyin":"shēng gōng zhǐ guò","abbr":"sgzg","explanation":"鼓励立功，防止过失。","source":{"text":"赏有功，罚有罪，而不失其人，方在于明也，非能生功止过者也。","book":"《韩非子·说疑》"},"usage":"作谓语、定语；用于书面语"},{"id":31947,"word":"生动活泼","pinyin":"shēng dòng huó pō","abbr":"sdhp","explanation":"内容和形式的丰富、活跃。","source":{"text":"要是句子短些，章节短些，文章就生动活泼。","book":"郭沫若《关于文风问题》"},"example":{"text":"我喜欢～的孩子。"},"similar":["生龙活虎"],"opposite":["死水一潭"],"usage":"作谓语、定语、状语；指充满活力"},{"id":31948,"word":"生发未燥","pinyin":"shēng fà wèi zào","abbr":"sfwz","explanation":"胎发未干。用以指孩童之时。","source":{"text":"焘大怒，谓奇曰：‘我生头发未燥，便闻河南是我家地。’","book":"《宋书·索虏传》"},"similar":["乳臭未干"],"usage":"作谓语、定语；指小孩"},{"id":31949,"word":"生同衾，死同穴","pinyin":"shēng tóng qīn，sǐ tóng xué","abbr":"stqstx","explanation":"衾：被子；穴：墓穴。活着同盖一条被子，死了同葬一个墓穴。形容夫妇感情深厚。","source":{"text":"不恋豪杰，不羡骄奢，自愿地生则同衾，死则同穴。","book":"元·王实甫《西厢记》第四本第四折"},"example":{"text":"我既委身于你，乐则同乐，忧则同忧，～。","book":"明·洪楩《清平山堂话本·风月瑞仙亭》"},"usage":"作谓语、宾语、定语；多用于夫妻间"},{"id":31950,"word":"生吞活剥","pinyin":"shēng tūn huó bō","abbr":"sthb","explanation":"原指生硬搬用别人诗文的词句。现比喻生硬地接受或机械的搬用经验、理论等。","source":{"text":"有枣强尉张怀庆，好偷名士文章，人为之谚云：‘活剥王昌龄，生吞郭正一。’","book":"唐·刘肃《大唐新语·谱谑》"},"example":{"text":"他们从欧美日本回来，只知～地谈外国。","book":"毛泽东《改造我们的学习》"},"similar":["食古不化","囫囵吞枣","生搬硬套"],"opposite":["融会贯通","举一反三"],"usage":"作谓语、状语、定语；指生拉硬扯","story":["唐高宗时，河北枣强官吏张怀庆不学无术，爱好舞文弄墨，他把李义府的五言诗各行加两字成为自己的七言诗，让人啼笑皆非，别人见他抄袭王昌龄及郭正一的诗，就送他顺口溜：“活剥王昌龄，生吞郭正一”来讥讽他的抄袭行为"]},{"id":31951,"word":"生吞活夺","pinyin":"shēng tūn huó duó","abbr":"sthd","explanation":"形容粗暴地抢夺。","source":{"text":"[日语训练班的工作]原先本打算由三厅直接办理的，梁寒操生吞活夺的抢去，乃超和鹿地便只以顾问的名义留下。","book":"郭沫若《洪波曲》第十六章三"},"usage":"作谓语、定语、状语；用于处事"},{"id":31952,"word":"生夺硬抢","pinyin":"shēng duó yìng qiǎng","abbr":"sdyq","explanation":"指强行夺过来。","source":{"text":"还亏禇一官力大，把个公子生夺硬抢的救护下来。","book":"《儿女英雄传》第二八回"},"usage":"作谓语、定语、状语；指抢夺"},{"id":31953,"word":"生妖作怪","pinyin":"shēng yāo zuò guài","abbr":"syzg","explanation":"原指妖魔鬼怪作崇，危害于人。后比喻坏人暗中活动，进行破坏。","source":{"text":"及至时运衰微，禄命将终之日，不但众散亲离，人心背叛。即魑魅魍魉也都来了，生妖作怪，播弄着你，所谓人衰鬼弄人是也。","book":"清·褚人获《隋唐演义》第八十九回"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":31954,"word":"生子当如孙仲谋","pinyin":"shēng zǐ dāng rú sūn zhòng móu","abbr":"szdrszm","explanation":"孙仲谋：三国时吴主孙权。形容智勇双全的英雄人物。","source":{"text":"生子当如孙仲谋。","book":"晋·陈寿《三国志·吴志·吴主传》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“～，曹操羡孙权之语；生子须如礼亚子，朱温叹存勖之词。”"},"usage":"作谓语、定语；用于感慨","story":["东汉末年，曹操率军进攻东吴，孙权亲率7万军队迎战，曹操打了败仗就屯兵江北不出战，孙权乘船刺探军情，曹操见孙权军纪严明，感慨地说：“生子当如孙仲谋，刘表的儿子不过像猪狗罢了。”双方对峙一月，曹操就撤军"]},{"id":31955,"word":"生子痴，了官事","pinyin":"shēng zǐ chī，liǎo guān shì","abbr":"szclgs","explanation":"生养的儿子痴呆，可以免去官家的差役。比喻虽然是坏事，在一定意义上也是好事。","source":{"text":"生子痴，了官事，官事未易了也。了事正作痴，复为快耳！","book":"《晋书·傅玄传》"},"example":{"text":"～，今日官事恐未易了呢。虑君撄祸，故敢直告。","book":"蔡东藩《两晋演义》第八回"}},{"id":31956,"word":"生寄死归","pinyin":"shēng jì sǐ guī","abbr":"sjsg","explanation":"寄：暂居。生似暂寓，死如归去。指不把生死当作一回事。","source":{"text":"生：寄也；死：归也。","book":"《淮南子·精神训》"},"example":{"text":"吾游遍灵境，颇有所遇，已知～，亦思乘化而游，当更无所墨碍耳。","book":"明·徐宏祖《徐霞客游记·续编》"},"usage":"作宾语、定语；指置生死于度外","story":["传说上古时期，大禹治水有功而成为华夏领袖。一次他去南方省份巡视，与随从坐船到江心，突然一条黄龙把船托到半空，船上的人顿时五色无主。大禹则大笑道：“我受命于天，竭力而劳万民。生，寄也；死，归也。”黄龙见吓不到大禹，于是就仓皇而逃"]},{"id":31957,"word":"生寡食众","pinyin":"shēng guǎ shí zhòng","abbr":"sgsz","explanation":"形容生产的少，消费的多。","source":{"text":"念生寡而食众，则可罢斥惰游。","book":"唐·刘蒉《对贤良方正直言极谏策》"},"example":{"text":"君子以闲散鸣高，遗累于戚友；小人以骗盗煳口，为害于闾阎。～，用急为舒。","book":"陈独秀《今日之教育方针》"}},{"id":31958,"word":"生张熟魏","pinyin":"shēng zhāng shú wèi","abbr":"szsw","explanation":"张、魏：都是姓，这里泛指人。泛指认识的或不认识的人。","source":{"text":"北都有妓女，美色而举止生梗，士人谓之‘生张八’。……野赠之诗曰：‘君为北道生张八，我是西州熟魏三。莫怪尊前无笑语，半生半熟未相谙。’","book":"宋·沈括《梦溪笔谈》卷十六"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“顶着他的姓接纳～，甚至当筵诉说她的嫁后光阴如何如何，或者这家人家的阴私家丑。”"},"similar":["熟魏生张"],"usage":"作主语、宾语、定语；泛指认识的或不认识的","story":["宋朝时期，寇准镇守北部，收蜀人魏野到门下。当时北部有一个漂亮而举止生硬的妓女，士人叫她生张八，来寇府聚会，寇准即兴要魏野作诗，魏野立即作诗：“君为北道生张八，我是西州熟魏三。莫怪尊前无笑话，半生半熟未相谙。”"]},{"id":31959,"word":"生当作人杰，死亦为鬼雄","pinyin":"shēng dāng zuò rén jié，sǐ yì wéi guǐ xióng","abbr":"sdzrjsywgx","explanation":"人杰：人中的豪杰。活着应当做杰出的人物，死了要做鬼中的豪杰。比喻人生在世，要有所作为。","source":{"text":"生当作人杰，死亦为鬼雄。至今思项羽，不肯过江东。","book":"宋·李清照《绝句》"}},{"id":31960,"word":"生息蕃庶","pinyin":"shēng xī fán shù","abbr":"sxfs","explanation":"蕃：繁殖。指生养系列人口。","source":{"text":"其后土、客生息蕃庶，岁屡有秋，关内汉回挟眷承垦，络绎相属。","book":"《清史稿·食货志一》"},"usage":"作谓语、宾语；用于书面语"},{"id":31961,"word":"生情见景","pinyin":"shēng qíng jiàn jǐng","abbr":"sqjj","explanation":"景：景物。看到眼前景物而引起某种联想或感慨，也指随机应变。","source":{"text":"我见他气昂昂威风自逞，雄赳赳施逞些气性，使不着你叫丫丫寻棕见影，你看我两阵前生情见景。","book":"明·无名氏《活拿萧天佑》第三折"},"similar":["见景生情","触景生情"],"usage":"作谓语、宾语；用于处事"},{"id":31962,"word":"生意兴隆","pinyin":"shēng yì xīng lóng","abbr":"syxl","explanation":"生意：商业买卖。买卖兴旺。也比喻业务蒸蒸日上。","source":{"text":"你果放了，以后包你网不虚发，生意兴隆。","book":"清·李汝珍《镜花缘》第十三回"},"example":{"text":"这样一叫，可就～了。","book":"金庸《射雕英雄传》第十九回"}},{"id":31963,"word":"生意盎然","pinyin":"shēng yì àng rán","abbr":"syar","explanation":"形容生命力旺盛的样子。","source":{"text":"雨后的春笋呈现一遍～的景象。"},"example":{"text":"雨后的春笋呈现一遍～的景象"},"similar":["生机盎然"],"opposite":["老气横秋"],"usage":"作谓语、定语；指充满活力"},{"id":31964,"word":"生我劬劳","pinyin":"shēng wǒ qú láo","abbr":"swql","explanation":"指父母生养我们子女非常辛劳。","source":{"text":"蓼蓼者莪，匪莪伊蒿，哀哀父母，生我劬劳。","book":"《诗经·小雅·蓼莪》"},"example":{"text":"念我先君，其艰其勤，～，至于成人。","book":"宋·张孝祥《代焚黄祭文》"},"usage":"作宾语、定语；用于感叹等"},{"id":31965,"word":"生手生脚","pinyin":"shēng shǒu shēng jiǎo","abbr":"sssj","explanation":"形容对所做的某项新工作不熟悉的样子。","source":{"text":"形容对所做的某项新工作不熟悉的样子。"},"opposite":["行家里手"],"usage":"作定语、宾语；指不熟练"},{"id":31966,"word":"生拉活扯","pinyin":"shēng lā huó chě","abbr":"slhc","explanation":"生：生硬。比喻牵强附会。","source":{"text":"张金龙带着人，把小梅生拉活扯的弄回去了。","book":"孔厥《新儿女英雄传》第二回"},"example":{"text":"他～，想把这两件强行联系起来。"},"similar":["牵强附会","生拉硬拽"],"usage":"作谓语、宾语、定语；指牵强附会"},{"id":31967,"word":"生拉硬扯","pinyin":"shēng lā yìng chě","abbr":"slyc","explanation":"比喻牵强附会，生拖死拽。","source":{"text":"福升生拉活扯地将黄省三向外拖。","book":"曹禺《日出》第四幕"},"example":{"text":"王朔《一点正经没有》：“有话好说有话好说，别这么～，拽脱焊了到那儿他也说不出话了。”"},"similar":["牵强附会","生拉活扯","生拖死拽"],"usage":"作谓语、宾语、定语；指牵强附会"},{"id":31968,"word":"生拉硬拽","pinyin":"shēng lā yìng zhuài","abbr":"slyz","explanation":"按主观愿望办事而不管别人的意愿或客观的条件是否允许，比喻牵强附会。","example":{"text":"你这样～是行不通的。"},"similar":["生拉活扯","牵强附会"],"usage":"作谓语、宾语；指牵强附会"},{"id":31969,"word":"生拖死拽","pinyin":"shēng tuō sǐ zhuāi","abbr":"stsz","explanation":"形容强行拖扯。","source":{"text":"遂打了个落花流水，生拖死拽，把个英莲拖去，如今也不知死活。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"靠～是行不通的。"},"similar":["生拉活扯"],"usage":"作谓语、宾语；指强迫"},{"id":31970,"word":"生拼硬凑","pinyin":"shēng pīn yìng còu","abbr":"spyc","explanation":"指勉强拼凑。","source":{"text":"使得人物性格在浓烈的生活气息中向前发展，而没有生拼硬凑违反常情的弊病。","book":"《人民日报》1957.10.29"},"similar":["七拼八凑"],"usage":"作谓语、宾语、定语；指凑合"},{"id":31971,"word":"生拽死拖","pinyin":"shēng zhuài sǐ tuō","abbr":"szst","explanation":"犹生拖死拽。形容用力拉扯。","source":{"text":"老杜高高兴兴地带着信回来了。边团饭也没吃，害得杜大嫂好妈跟在他后面追了好远，生拽死拖，差点儿把他短袄扯破。","book":"克非《春潮急》二八"}},{"id":31972,"word":"生拽活拖","pinyin":"shēng zhuài huó tuō","abbr":"szht","explanation":"拽：拖，硬拉。形容用力拉扯。","source":{"text":"连团年饭也没吃，害得杜大嫂她妈妈跟在他后面追了好远，生拽活拖，差点儿把他短袄扯破。","book":"克非《春潮急》"},"similar":["生拉活拽"],"usage":"作谓语、状语；指强行拉扯"},{"id":31973,"word":"生搬硬套","pinyin":"shēng bān yìng tào","abbr":"sbyt","explanation":"生：生硬。指不顾实际情况，机械地运用别人的经验，照抄别人的办法。","source":{"text":"有人背诵了几篇祭文，背得烂熟，到了考试的时候，题目是祝寿的，他居然生搬硬套地把祭文抄上去，弄得牛头不对马嘴。","book":"马南邨《燕山夜话·不吃羊肉吃菜羹》"},"example":{"text":"学习不是～，生活中的语言也不能原封不动地运用，需要提炼。","book":"老舍《语言、人物、戏剧》"},"similar":["生吞活剥","囫囵吞枣"],"opposite":["融会贯通","随机应变"],"usage":"作谓语、宾语、定语、状语；指照抄"},{"id":31974,"word":"生擒活拿","pinyin":"shēng qín huó ná","abbr":"sqhn","explanation":"指活捉。","source":{"text":"我追赶着一人，往这老君堂来，今在此务要生擒活拿。","book":"元·郑光祖《老君堂》第一折"},"example":{"text":"清·李百川《绿野仙踪》第69回：“臣此去，大要胜有六七，定将步登高～。”"},"similar":["生擒活捉"],"usage":"作谓语、宾语；用于战斗或对抗等"},{"id":31975,"word":"生擒活捉","pinyin":"shēng qín huó zhuō","abbr":"sqhz","explanation":"指活捉。","source":{"text":"生擒活捉蛟龙首，始知匠手不虚传。","book":"唐·吕岩《敲爻歌》"},"example":{"text":"若是汤南蛮转来，须要～，不可伤他生命。","book":"《说岳全传》第五四回"},"similar":["生擒活拿"],"usage":"作谓语、宾语；用于战斗或对抗等"},{"id":31976,"word":"生旦净丑","pinyin":"shēng dàn jìng chǒu","abbr":"sdjc","explanation":"生：小生；旦：花旦；净：花脸；丑：小丑。京剧里的四种人物扮相，借指各种人物。","source":{"text":"这女孩子面生，不是个侍儿，倒象是那十二学戏的女孩子之内的，却辨不出他是生旦净丑那一个角色来。","book":"清·曹雪芹《红楼梦》第30回"},"example":{"text":"现代人很少能分清京剧～的人物。"},"similar":["生旦净末"],"usage":"作主语、宾语、定语；用于戏剧、小说等"},{"id":31977,"word":"生机勃勃","pinyin":"shēng jī bó bó","abbr":"sjbb","explanation":"形容自然界充满生命力，或社会生活活跃。","source":{"text":"油田一片生机勃勃，繁忙兴旺的景象。","book":"张天民《创业》"},"example":{"text":"我国的第三产业～，发展非常迅速。"},"similar":["生气勃勃","生意盎然"],"opposite":["老气横秋","死气沉沉","奄奄一息"],"usage":"作谓语、定语；指充满活力"},{"id":31978,"word":"生机盎然","pinyin":"shēng jī àng rán","abbr":"sjar","explanation":"充满生气和活力的。","source":{"text":"春天来了，到处都是～的景象。"},"example":{"text":"春天来了，到处都是～的景象"},"similar":["生机勃勃"],"opposite":["老气横秋"],"usage":"作谓语、定语；指充满活力"},{"id":31979,"word":"生杀与夺","pinyin":"shēng shā yǔ duó","abbr":"ssyd","explanation":"形容反动统治者掌握生死、赏罚大权。同“生杀予夺”。","source":{"text":"《周官》内史掌王之八柄，爵禄废置，生杀与夺，执国法及国令之贰以考政事。","book":"《通典·职官三》"},"example":{"text":"对于这些种族奴隶，国家是操有～之大权的。","book":"郭沫若《奴隶制时代》"},"similar":["生杀予夺"],"usage":"作定语、宾语；指统治者的大权"},{"id":31980,"word":"生杀之权","pinyin":"shēng shā zhī quán","abbr":"sszq","explanation":"掌握别人死活的权力。","source":{"text":"况郭解之论，以匹夫之细，窃生杀之权，罪已不容于诛矣。","book":"汉·荀悦《汉纪·哀帝纪上》"},"example":{"text":"天生民不能自治，于是乎立之君，付之以～。","book":"明·刘基《蛇蝎》"},"similar":["生杀大权"],"usage":"作主语、宾语；形容权力很大"},{"id":31981,"word":"生杀予夺","pinyin":"shēng shā yù duó","abbr":"ssyd","explanation":"生：让人活；杀：处死；予：给予；夺：剥夺。形容反动统治者掌握生死、赏罚大权。","source":{"text":"故丧祭、朝聘、师旅一也。贵贱、杀生、与夺一也。","book":"《韩非子·三守》：“使杀生之机，予夺之要在大臣，如是者侵。”《荀子·王制》"},"example":{"text":"干这种职务的人大半是带工的亲戚，或者是在地方上有一点势力的流氓，所以在这种地方，他们差不多有～的权利。","book":"夏衍《包身工》"},"similar":["草菅人命","生死予夺","杀生予夺"],"opposite":["壮烈牺牲"],"usage":"作定语、宾语；指统治者的大权"},{"id":31982,"word":"生来死去","pinyin":"shēng lái sǐ qù","abbr":"slsq","explanation":"死接着生，生接着死，轮回不停。形容众生在生死世界循环不已。","source":{"text":"君不见生来死去，似蚁修还，为衣为食，如蚕作茧。","book":"《诸子》卷九十四：“自云智巧，如梦如迷。生来死去，循环万劫。”《敦煌变文集·破魔变文》"},"example":{"text":"无穷今日明朝事，有限～人。","book":"唐·齐己《感时》诗"},"similar":["生死轮回"],"usage":"作宾语、定语；多用于佛教等"},{"id":31983,"word":"生栋覆屋","pinyin":"shēng dòng fù wū","abbr":"sdfw","explanation":"造房子用新伐的木头做屋梁，木头容易变形，房屋容易倒塌。比喻祸由自取。","source":{"text":"生栋覆屋，怨怒不及；弱子下瓦，慈母操垂。","book":"《管子·形势》"},"usage":"作宾语、定语；用于劝诫人"},{"id":31984,"word":"生桑之梦","pinyin":"shēng sāng zhī mèng","abbr":"sszm","explanation":"指三国·蜀·何祗梦见井中生桑，后应梦，四十八岁而卒。后比喻死期将至。“桑”亦写作“桒”。","source":{"text":"[何祇]尝梦井中生桑，以问占梦赵直，直曰：‘桑非井中之物，会当移植；然桑字四十下八，君寿恐不过此。’祇笑言‘得此足矣’。初仕郡，后为督军从事……年四十八卒，如直所言。","book":"裴松之注引晋·陈寿《益部耆旧传·杂记》"},"example":{"text":"元之自黄移蕲州，临终作遗表云：‘知游岱之魂，遂协～。’……元之亦 以四十八而殁也。","book":"宋·王銍《王公四六话》"},"usage":"作宾语；指征兆","story":["晋朝时期，何祗一天晚上梦见他家的井里长出一棵桑树，觉得奇怪，就去找赵真占卜。赵真占后说：“桑树并不是井里生的东西，桑字四十八，君寿恐不过此。”后来何祗在48岁时果然去世"]},{"id":31985,"word":"生死不易","pinyin":"shēng sǐ bù yì","abbr":"ssby","explanation":"形容对理想、信念、友谊、盟约等忠贞不移。同“生死不渝”。","source":{"text":"权曰：‘孤与子瑜，有生死不易之盟。","book":"《三国演义》第八二回"},"example":{"text":"清·褚人获《隋唐演义》第20回：“情之所钟，～。朕与夫人，虽欢娱未久，恩情如同海深。”"},"similar":["生死不渝"],"usage":"作谓语、定语；多用于感情等"},{"id":31986,"word":"生死不渝","pinyin":"shēng sǐ bù yú","abbr":"ssby","explanation":"活着还是死了都不改变。形容对理想、情谊等的忠贞不移。","source":{"text":"然其先必有数十人或数百人，同一心志，生死不渝。","book":"清·严复《论中国之阻力与离心力》"},"example":{"text":"巴金《还魂草》：“这～的深厚的友情不仅使林的孩子眼里绽出泪光，连我们也被感动到许久说不出话。”"},"similar":["生死不易","生死不贰"],"usage":"作谓语、定语；多用于感情等"},{"id":31987,"word":"生死与共","pinyin":"shēng sǐ yǔ gòng","abbr":"ssyg","explanation":"同生共死，相依为命。形容情谊极深重。","source":{"text":"几十年来，周总理与我父亲生死与共，休戚相关。","book":"《深情忆念周伯伯》"},"example":{"text":"让我们在这斗争的风暴中，～呵，走向胜利！","book":"贺敬之《放歌集·胜利和我们在一起》"},"similar":["生死之交","相依为命"],"opposite":["离心离德","同床异梦"],"usage":"作谓语、定语；指共存亡"},{"id":31988,"word":"生死之交","pinyin":"shēng sǐ zhī jiāo","abbr":"sszj","explanation":"同生共死的交谊。","source":{"text":"晋公在枪刀险难之中，我父亲挺身赴战，救他一命，身中六枪，因此上与俺父亲结为生死之交。","book":"元·郑德辉《绉梅香》"},"example":{"text":"对于在老阎和梁建这一对～的老战友之间所发生的严重分歧，深深感到烦恼。","book":"胡采《序》"},"similar":["情同手足","患难之交"],"opposite":["一面之交","誓不两立"],"usage":"作宾语；指共存亡的朋友"},{"id":31989,"word":"生死予夺","pinyin":"shēng sǐ yǔ duó","abbr":"ssyd","explanation":"生：让人活；死：处死；予：给予；夺：剥夺。形容反动统治者掌握生死、赏罚大权。","source":{"text":"故丧祭、朝聘、师旅一也。贵贱、杀生、与夺一也。","book":"《韩非子·三守》：“使杀生之机，予夺之要在大臣，如是者侵。”《荀子·王制》"},"example":{"text":"今王沈等乃处常伯之位，握～于中，势倾海内。","book":"《晋书·刘聪传》"},"similar":["杀生予夺","生杀予夺"],"usage":"作定语、宾语；指统治者的大权"},{"id":31990,"word":"生死关头","pinyin":"shēng sǐ guān tóu","abbr":"ssgt","explanation":"指极其紧要的契机或时刻。","source":{"text":"此一转念，是生死关头，千圣都从此做成。","book":"明·高攀龙《讲义·仁远乎哉章》"},"example":{"text":"现在是总罢工的～，没有时间让你去从容整理！","book":"茅盾《子夜》十五"},"similar":["生关死劫"],"usage":"作宾语；指重要时刻"},{"id":31991,"word":"生死存亡","pinyin":"shēng sǐ cún wáng","abbr":"sscw","explanation":"生存或者死亡。形容局势或斗争的的发展已到最后关头。","source":{"text":"夫礼，死生存亡之体也。","book":"《左传·定公十五年》"},"example":{"text":"亲承懿旨到西宫，～掌握中。","book":"元·无名氏《抱妆盒》第二折"},"similar":["生死攸关","生死关头"],"opposite":["安然无恙","安如泰山"],"usage":"作主语、宾语、定语；指紧急关头","story":["公元前495年，鲁定公隆重欢迎邾隐公，欢迎仪式上，邾隐公仰着脸，把玉器高高举起，态度很傲慢。鲁定公很谦虚地接受，孔子的学生子贡目睹了这场仪式。他认为他们没有按照周朝的礼制去做，他们生死存亡的日子快要到了"]},{"id":31992,"word":"生死搏斗","pinyin":"shēng sǐ bó dòu","abbr":"ssbd","explanation":"指生与死的激烈斗争。","source":{"text":"此刻～，他们三人自然竭尽全力，可见青城派功夫确是已尽于此。 ★金庸《天龙八部》第十三回"}},{"id":31993,"word":"生死攸关","pinyin":"shēng sǐ yōu guān","abbr":"ssyg","explanation":"攸：所。关系到生和死。指生死存亡的关键。","source":{"text":"这是千百名难友生死攸关的大事体啊！","book":"《龙虎风云记》"},"example":{"text":"遵义会议是我党历史上～的转折点。"},"similar":["生死存亡","非同小可"],"opposite":["无关紧要","无关痛痒"],"usage":"作谓语、定语；用于事情的紧急"},{"id":31994,"word":"生死无贰","pinyin":"shēng sǐ wú èr","abbr":"sswe","explanation":"至死无异心。表示坚定。","source":{"text":"自后屡与外人交哄，百举而百不胜，始微有悟于外人之筹饷则输将恐后，陷阵则生死无贰，其所以致胜于我者，殆不尽由船坚炮利之故。","book":"《辛亥革命前十年间时论选集·论立宪与外交之关系》"},"similar":["生死不易"],"usage":"作谓语、定语、状语；用于人的立场等"},{"id":31995,"word":"生死有命","pinyin":"shēng sǐ yǒu mìng","abbr":"ssym","explanation":"迷信指人的死活由天命决定，不可抗拒。","source":{"text":"生死有命，修短素定，非彼药物，所能损益。","book":"晋·葛洪《抱朴子·对俗》"},"example":{"text":"～，富贵在天，也不是人力可强的。","book":"《红楼梦》第四五回"},"similar":["命中注定"],"opposite":["事在人为"],"usage":"作宾语、定语；指宿命论","story":["西汉后期，平庸而贪色的汉成帝整天在后宫享乐，他喜欢班美女，封她为婕妤。班婕妤很有文学才华和修养。汉成帝废许皇后立赵飞燕为皇后。赵飞燕为了消灭对手诬陷班婕妤诅咒皇帝。班婕妤辩解死生有命，世上根本没有鬼神。汉成帝认为言之有理"]},{"id":31996,"word":"生死有命，富贵在天","pinyin":"shēng sǐ yǒu mìng，fù guì zà tiān","abbr":"ssymfgzt","explanation":"旧时迷信指人的生死等一切遭际皆由天命决定。常用作事势所至，人力不可挽回之意。","source":{"text":"生死有命，修短素定，非彼药物，所能损益。","book":"《抱朴子·对俗》"},"example":{"text":"～，也不是人力可强的。","book":"清·曹雪芹《红楼梦》第四十五回"}},{"id":31997,"word":"生死未卜","pinyin":"shēng sǐ wèi bǔ","abbr":"sswb","explanation":"或生或死结果尚难测定。","source":{"text":"急的是母亲生死未卜，深怕见了面不能说话，仍和不见一般，岂不可痛！","book":"清·无垢道人《八仙全传》第25回"},"example":{"text":"他自从离家出走后数年来一直音讯全无，～。"},"similar":["死生未卜"],"usage":"作谓语、定语；用于口语等"},{"id":31998,"word":"生死永别","pinyin":"shēng sǐ yǒng bié","abbr":"ssyb","explanation":"指活人与死人永远分离。","source":{"text":"呜呼公瑾，生死永别。","book":"明·罗贯中《三国演义》第57回"},"usage":"作谓语、定语；指诀别"},{"id":31999,"word":"生死牢关","pinyin":"shēng sǐ láo guān","abbr":"sslg","explanation":"佛家语，指生和死的紧要关口。","source":{"text":"要明已躬大事，透脱生死牢关，先须截断一切圣凡虚妄见解。","book":"《禅关策进·示五壹善讲主》"},"example":{"text":"运灵风扫荡情尘，须勘破、～悬解。","book":"元·姬翼《洞仙歌》词"}},{"id":32000,"word":"生死相依","pinyin":"shēng sǐ xiāng yī","abbr":"ssxy","explanation":"在生死问题上互相依靠。形容同命运，共存亡。","source":{"text":"中朝两国同志要亲如兄弟般地团结在一起，休戚与共，生死相依，为战胜共同敌人而奋斗到底。","book":"毛泽东《中国人民志愿军要爱护朝鲜的一山一水，一草一木》"},"example":{"text":"我们要一辈子～。"},"similar":["生死与共"],"usage":"作谓语、宾语；指共存亡"},{"id":32001,"word":"生死肉骨","pinyin":"shēng sǐ ròu gǔ","abbr":"ssrg","explanation":"生、肉：用作动词。使死人复生，白骨长肉。形容恩惠极大。","source":{"text":"苟使意如得改事君，所谓生死而肉骨也。","book":"《左传·襄公二十二年》：“吾见申叔夫子，所谓生死而肉骨也。”《左传·昭公二十五年》"},"example":{"text":"文致诋欺之法，久矣不行；～之恩，今焉创见。","book":"宋·陈亮《谢郑侍郎启》"},"similar":["生死骨肉"],"usage":"作谓语、定语；指恩情大"},{"id":32002,"word":"生死苦海","pinyin":"shēng sǐ kǔ hǎi","abbr":"sskh","explanation":"佛教语。指众生轮回六道，生生死死，茫无涯际，有如大海。","source":{"text":"汝等终日只求福田，不求出离生死苦海。","book":"《坛经·行由品》"},"usage":"作宾语、定语；用于宗教等"},{"id":32003,"word":"生死荣辱","pinyin":"shēng sǐ róng rǔ","abbr":"ssrr","explanation":"生存与死亡，荣耀和耻辱。","source":{"text":"他忘记了个人的生死荣辱和健康，没有一天停止过自己的工作。","book":"邓小平《庆祝刘伯承同志五十寿辰》"},"example":{"text":"邓小平《庆祝刘伯承同志五十寿辰》：“他忘记了个人的～和健康，没有一天停止过自己的工作。”"},"similar":["死生荣辱"],"usage":"作宾语、定语；指人的处世观"},{"id":32004,"word":"生死轮回","pinyin":"shēng sǐ lún huí","abbr":"sslh","explanation":"佛教以为世俗众生在生死世界里循环不已，犹如车轮回旋不停一般。是一种善恶有报的因果报应论。","source":{"text":"今日到来日修，每日去频发愿，过今年捱到珲年，担阁了修行仙道远，则这生死轮回怎遣。","book":"明·无名氏《李云卿》第四折"},"similar":["生来死去"],"usage":"作宾语、定语；用于迷信等"},{"id":32005,"word":"生死醉梦","pinyin":"shēng sǐ zuì mèng","abbr":"sszm","explanation":"形容非常专心。","source":{"text":"[戴]生死醉梦于绘事，故学精而业著，业著而名远。","book":"明·郎瑛《七修续稿·事物·戴进传》"},"usage":"作定语、状语；用于处事"},{"id":32006,"word":"生死长夜","pinyin":"shēng sǐ cháng yè","abbr":"sscy","explanation":"佛教语。指漫长昏昧的生死轮回。","source":{"text":"原夫大地众生，居生死长夜中。","book":"清·道霈《重刊〈坛经〉缘起》"},"usage":"作宾语、定语；多用于佛教"},{"id":32007,"word":"生死骨肉","pinyin":"shēng sǐ gǔ ròu","abbr":"ssgr","explanation":"使死人复生，白骨长肉。形容恩惠极大。同“生死肉骨”。","source":{"text":"[臣]官阶勋封尽蒙黜削，待罪三年，分从遐弃。属陛下聪明睿哲，嗣圣登庸，恩宥广覃，授臣利州刺史……生死骨肉，受赐已深。","book":"唐·颜真卿《谢户部侍郎表》"},"example":{"text":"清·荑荻散人《玉娇梨》第11回：“今日得蒙老恩师始终覆庇，曲赐成全，真可谓～。”"},"similar":["生死肉骨"],"usage":"作谓语、定语；指恩情大"},{"id":32008,"word":"生民涂炭","pinyin":"shēng mín tú tàn","abbr":"smtt","explanation":"形容人民处于极端困苦的境地。","source":{"text":"今国君无道，天愁民怨，四海分崩，生民涂炭，刀兵不歇，天下无不思叛，正天之欲绝殷商也。","book":"明·许仲琳《封神演义》六十一回"},"example":{"text":"这个艳传，那个步韵，比对于华屋丘墟，～之惨的大事情还起劲。","book":"鲁迅《且介亭杂文·病后杂谈四》"},"similar":["生灵涂炭","民生涂炭","涂炭生灵"],"opposite":["国泰民安"],"usage":"作谓语、宾语、定语、状语；指社会时局"},{"id":32009,"word":"生气勃勃","pinyin":"shēng qì bó bó","abbr":"sqbb","explanation":"勃勃：旺盛的样子。形容人或社会富有朝气，充满活力。","source":{"text":"全国各方面皆生气勃勃，精力弥满。","book":"清·梁启超《中国国会制度私议》"},"example":{"text":"生活中最主要的仍然是那些向上的，～、充满热情和活力的，带有极大想象的东西。","book":"徐迟《特写选·序言》"},"similar":["生机勃勃","朝气蓬勃"],"opposite":["暮气沉沉","死气沉沉"],"usage":"作谓语、定语；指充满活力"},{"id":32010,"word":"生气蓬勃","pinyin":"shēng qì bó bó","abbr":"sqpb","explanation":"蓬勃：旺盛的样子。形容人或社会富有朝气，充满活力。","example":{"text":"生活中最主要的仍然是那些向上的，～、充满热情和活力的，带有极大想象的东西。","book":"徐迟《特写选·序言》"}},{"id":32011,"word":"生灵涂地","pinyin":"shēng líng tú dì","abbr":"sltd","explanation":"生灵：百姓；涂：泥沼。人民陷在泥塘和火坑里。形容人民处于极端困苦的境地。","source":{"text":"自唐季以来数十年间，帝王凡易十姓，兵革不息，生灵涂地。","book":"宋·邵伯温《闻见前录》"},"similar":["生灵涂炭","民生涂炭","涂炭生民"],"opposite":["国泰民安","安居乐业"],"usage":"作谓语、宾语；指社会时局"},{"id":32012,"word":"生灵涂炭","pinyin":"shēng líng tú tàn","abbr":"sltt","explanation":"生灵：百姓；涂：泥沼；炭：炭火。人民陷在泥塘和火坑里。形容人民处于极端困苦的境地。","source":{"text":"先帝晏驾贼庭，京师鞠为戎穴，神州萧条，生灵涂炭。","book":"《晋书·苻丕载记》"},"example":{"text":"谭都督允士民之情，不忍轻动干戈，以致～。","book":"郭孝成《湖南光复纪事》"},"similar":["水深火热","民不聊生","民生涂炭"],"opposite":["国泰民安","安居乐业"],"usage":"作谓语、宾语、定语、状语；指社会时局","story":["公元385年，后燕、后秦进攻前秦，活捉前秦王苻坚。幽州刺史王永拥立苻坚的儿子苻丕为皇帝，苻丕登基后发布通告称：“皇上被害，长安沦陷，国家凋败，生灵涂炭，全民联合起来准备作战。”由于后秦势力强大，394年后秦灭掉前秦"]},{"id":32013,"word":"生炒热卖","pinyin":"shēng chǎo rè mài","abbr":"scrm","explanation":"指急于应付，现做现卖而不暇精制。","source":{"text":"这大部分作家……为了要吃饭，又不得不在顾忌多端的夹缝中作微弱之呼声，不得不在饥寒交迫之生活中匆忙写作，生炒热卖。","book":"茅盾《如何击退颓风》"},"similar":["现炒现卖"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":32014,"word":"生生不已","pinyin":"shēng shēng bù yǐ","abbr":"ssby","explanation":"生生：中国哲学术语，指变化和新生事物的发生；不已：没有终止。形容一切生物新陈代谢，永无停止。","source":{"text":"二气交感，化生万物，万物生生而变化无穷焉。","book":"《周易·系辞上》：“生生之谓易。”宋·周敦颐《太极图说》"}},{"id":32015,"word":"生生不息","pinyin":"shēng shēng bù xī","abbr":"ssbx","explanation":"生生：中国哲学术语，指变化和新生事物的发生；不已：没有终止。不断地生长、繁殖。","source":{"text":"二气交感，化生万物，万物生生而变化无穷焉。","book":"《周易·系辞上》：“生生之谓易。”宋·周敦颐《太极图说》"},"example":{"text":"在天地，则气化流行，～。（清·戴震《孟子字义疏证·道》）"}},{"id":32016,"word":"生生不断","pinyin":"shēng shēng bù duàn","abbr":"ssbd","explanation":"生生：中国哲学术语，指变化和新生事物的发生；不断：没有中断。不断地生长、繁殖。","source":{"text":"念念随灭，生生不断。","book":"《尚书·盘庚中》：“汝万民，乃不生生，暨予一人猷同心。”北齐·颜之推《颜氏家训·归心》"}},{"id":32017,"word":"生生世世","pinyin":"shēng shēng shì shì","abbr":"ssss","explanation":"指今生、来世以至永世。","source":{"text":"唯愿后身生生世世不复天王作因缘。","book":"《南史·王敬则传》"},"example":{"text":"我～忘不了这一刻的感觉。","book":"瞿秋白《赤都心史》"},"similar":["永生永世","世世代代","世世生生"],"usage":"作宾语、状语；指永生永世","story":["南朝宋齐时期，王敬则尽心竭力为齐高帝效劳，他奉齐高帝之命要宋顺帝搬出宫廷，宋顺帝不肯上车，流着眼泪说自己希望生生世世不要与帝王家有关系，万般无奈地离开宫殿而宣布退位。齐高帝就取而代之建立了齐国"]},{"id":32018,"word":"生生死死","pinyin":"shēng shēng sǐ sǐ","abbr":"ssss","explanation":"犹言一辈子。指从生至死。","source":{"text":"宽复洒泣诉其父母生生死死之苦日：‘傥伊父母必欲归，且随其主母起居耳。’","book":"清·周亮工《书影》卷二"},"example":{"text":"清·周亮工《书影》卷二：“宽复洒泣诉其父母生生死死之苦日：‘傥伊父母必欲归，且随其主母起居耳。’”"},"usage":"作主语、宾语、定语；指从生到死"},{"id":32019,"word":"生男育女","pinyin":"shēng nán yù nǚ","abbr":"snyn","explanation":"指生育子女。","source":{"text":"岩头和尚用三文钱索得个妻，只解捞虾摝蚬，而且不解生男育女，直至如今门风断绝。","book":"《五灯会元·百丈惟政禅师》"},"example":{"text":"每日价卧柳眠花，恋着那送旧迎新泼弟子，全不想～旧娇娃。","book":"元·杨显之《酷寒亭》第一折"},"similar":["生儿育女"],"usage":"作谓语、宾语、定语；指繁育后代"},{"id":32020,"word":"生知安行","pinyin":"shēng zhī ān xíng","abbr":"szax","explanation":"“生而知之”、“安而行之”的省语。古以为圣人方能具有的资质。","source":{"text":"或生而知之，或学而知之，或困而知之，及其知之，一也。或安而行之，或利而行之，或勉强而行之，及其成功，一也。","book":"《礼记·中庸》"},"example":{"text":"东王具～之资……功烈迈乎前人，恩威超乎后世。","book":"中国近代史资料丛刊《太平天国·行军总要》"},"usage":"作宾语、定语；用于书面语"},{"id":32021,"word":"生离死别","pinyin":"shēng lí sǐ bié","abbr":"slsb","explanation":"分离好像和死者永别一样。指很难再见的离别或永久的离别。","source":{"text":"盖闻死别长城，生离函谷。","book":"汉·无名氏《为焦仲卿妻作》诗：“生人作死别，恨恨那可论。”北周·庾信《拟连珠》"},"example":{"text":"他们已有那样的情感，又遇着那些～的事。","book":"闻一多《冬夜评论》"},"similar":["生死永别","悲欢离合","生别死离"],"opposite":["破镜重圆"],"usage":"作主语、宾语、定语；表现对分别的悲伤","story":["南朝时期，梁武帝接纳西魏降将侯景，被侯景攻陷京城，侯景想把京城的人连同梁武帝活活饿死。文人徐陵的父亲也在城内。徐陵非常着急，就给仆射杨遵彦写信，希望能放他父亲出来，他在信中把亲人之间的生离死别的悲切伤痛刻画得淋漓尽致"]},{"id":32022,"word":"生离死绝","pinyin":"shēng lí sǐ jué","abbr":"slsj","explanation":"分离好像和死者永别一样。指很难再见的离别或永久的离别。","source":{"text":"而一旦幽絷，生离死绝，求之于情，可伤之甚。","book":"《晋书·殷仲堪传》"},"similar":["生离死别","死别生离","生别死离"],"usage":"作主语、宾语、定语；表现对分别的悲伤"},{"id":32023,"word":"生米作成熟饭","pinyin":"shēng mǐ zuò chéng shú fàn","abbr":"smzcsf","explanation":"比喻事情已经做成了，不能再改变。","source":{"text":"这个当儿，珍姑娘的头是磕了，脸是开了，生米是作成熟饭了。","book":"清·文康《儿女英雄传》第40回"},"similar":["生米做成熟饭","生米煮成熟饭"],"usage":"作宾语、定语、分句；指既成事实"},{"id":32024,"word":"生米做成熟饭","pinyin":"shēng mǐ zuò chéng shú fàn","abbr":"smzcsf","explanation":"比喻事情已经做成了，不能再改变。","source":{"text":"小姐，如今生米做成熟饭了，又何必如此推阻。","book":"明·沈受先《三元记·遣妾》"},"example":{"text":"就是婶娘见～，也只得罢了。","book":"清·曹雪芹《红楼梦》第六十四回"},"similar":["生米作成熟饭","生米煮成熟饭"],"usage":"作宾语、定语、分句；指既成事实"},{"id":32025,"word":"生米煮成熟饭","pinyin":"shēng mǐ zhǔ chéng shú fàn","abbr":"smzcsf","explanation":"比喻事情已经做成了，不能再改变。","source":{"text":"小姐，如今生米做成熟饭了，又何必如此推阻。","book":"明·沈受先《三元记·遣妾》"},"example":{"text":"现在自己没有见识，娶了过来，是～，便没得说了。（清·吴趼人《糊涂世界》卷三）"},"similar":["既成事实","生米做成熟饭"],"usage":"作宾语、定语、分句；指既成事实"},{"id":32026,"word":"生老病死","pinyin":"shēng lǎo bìng sǐ","abbr":"slbs","explanation":"佛教指人的四苦，即出生、衰老、生病、死亡。今泛指生活中生育、养老、医疗、殡葬。","source":{"text":"生老病死，事与愿违。","book":"南朝宋·刘义庆《世说新语·雅量》：“鸡猪鱼蒜，逢著便；生老病死，时至则行。”《仁王经·无常偈》"},"example":{"text":"只是在家受不得那爱欲牵缠，～，世态炎凉，人情险恶。","book":"清·陈忱《水浒后传》第三十一回"},"similar":["衣食住行"],"usage":"作主语、宾语、定语；用于人"},{"id":32027,"word":"生而知之","pinyin":"shēng ér zhī zhī","abbr":"sezz","explanation":"生下来就懂得知识和道理。这是唯心主义者的观点。","source":{"text":"子曰：‘我非生而知之者，好古敏以求之者也。’","book":"《论语·述而》"},"example":{"text":"人非～者，孰能无惑。","book":"唐·韩愈《师说》"},"opposite":["学而知之"],"usage":"作谓语、定语；指人的本能","story":["春秋时期，大思想家孔子被人们认为天生的聪明，自从娘胎里出来就能对天下万事万物无所不知、无所不晓。学生把这种说法告诉孔子。孔子说世上没有生而知之的人，只有孜孜不倦地学习与研究才会懂得那么多的道理的"]},{"id":32028,"word":"生聚教养","pinyin":"shēng jù jiào yǎng","abbr":"sjjy","explanation":"指军民同心同德，积聚力量，发愤图强，以洗刷耻辱。同“生聚教训”。","source":{"text":"万众欢呼精神旺，老帅从容入将台。生聚教养七年苦，战士概属党培栽。","book":"续范亭《八一南阳府市场开幕大会朱总司令亲临训话吴老归来口述大概因志之以当庆祝》诗"},"similar":["生聚教训"],"usage":"作谓语、宾语；指军民同心同德"},{"id":32029,"word":"生聚教训","pinyin":"shēng jù jiào xùn","abbr":"sjjx","explanation":"生聚：繁殖人口，聚积物力；教训：教育，训练。指军民同心同德，积聚力量，发愤图强，以洗刷耻辱。","source":{"text":"越十年生聚，而十年教训，二十年之外，吴其为沼乎！","book":"《左传·哀公元年》"},"example":{"text":"就是那当道诸公，也应激发天良，力图振刷，郊那范蠡、文种的故事，～，徐图兴复。","book":"蔡东藩、许廑父《民国通俗演义》第四十五回"},"similar":["生聚教养","十年生聚，十年教训"],"usage":"作谓语、宾语；指军民同心同德","story":["春秋时期，吴越两国交战，吴王夫差活捉了越王勾践，让勾践到吴国为奴，勾践给吴王进贡美女西施。自己则卧薪尝胆，采用文种的“十年生聚，十年教训”的策略，增加人口，聚积财物，同时勾践还积极发展农业与军事，一举攻占吴国"]},{"id":32030,"word":"生肉枯骨","pinyin":"shēng ròu kū gǔ","abbr":"srkg","explanation":"犹生死肉骨。使枯骨长肉。形容恩惠极大。","source":{"text":"至义畅于三代之际，遗风播乎百世之后，生肉枯骨，惠侔造化。","book":"《晋书·刑法志》"},"similar":["枯骨生肉","起死回生"],"usage":"作宾语、定语；用于比喻句"},{"id":32031,"word":"生花之笔","pinyin":"shēng huā zhī bǐ","abbr":"shzb","explanation":"比喻杰出的写作才能。","source":{"text":"李太白少时，梦所用之笔头上生花后天才赡逸，名闻天下。","book":"五代·王仁裕《开元天宝遗事·梦笔头生花》"},"usage":"作宾语；多用于比喻句"},{"id":32032,"word":"生花妙笔","pinyin":"shēng huā miào bǐ","abbr":"shmb","explanation":"比喻杰出的写作才能。","source":{"text":"李太白少时，梦所用之笔头上生花，后天才赡逸，名闻天下。","book":"五代·王仁裕《开元天宝遗事·梦笔头生花》"},"example":{"text":"感谢画家的～呵，把我又带回毛主席身边。","book":"韩静霆《小八路的怀念》诗"},"similar":["妙笔生花"],"opposite":["平淡无奇"],"usage":"作宾语、定语；指人的文笔","story":["唐代大诗人李白少年时曾经做过一个奇特的梦，他梦见自己使用的笔尖头开出了鲜艳的花朵，一张张白纸自动飞到他眼前，他高兴极了，就抓起妙笔飞快地写了起来，落在纸上的却是一朵朵盛开的鲜花，他的许多著名的诗篇流传至今"]},{"id":32033,"word":"生花妙语","pinyin":"shēng huā miào yǔ","abbr":"shmy","explanation":"指动听的言语文章。","source":{"text":"东方国家的理论家们再编出无论多少生花妙语，说到底也是这两个问题。","book":"《花城》1981年第5期"},"usage":"作宾语、定语；用于言辞或文章等"},{"id":32034,"word":"生荣亡哀","pinyin":"shēng róng wáng āi","abbr":"srwa","explanation":"用以赞誉受人崇敬的死者。同“生荣死哀”。","source":{"text":"生荣亡哀，厥声载路。","book":"《隶释·汉刘宽后碑》"},"similar":["生荣死哀","生荣没哀"],"usage":"作谓语、定语；用以赞誉受人崇敬的死者"},{"id":32035,"word":"生荣死哀","pinyin":"shēng róng sǐ āi","abbr":"srsa","explanation":"活着受人尊敬，死了使人哀痛。用以赞誉受人崇敬的死者。","source":{"text":"人谁不没，达士徇名，生荣死哀，亦孔之荣，呜呼哀哉。","book":"语出《论语·子张》：“其生也荣，其死也哀。”三国魏·曹植《王仲宣诔》"},"example":{"text":"夫人开国分齐魏，～送天地。","book":"宋·文天祥《哭母大祥》诗"},"similar":["生荣亡哀","生荣没哀"],"usage":"作谓语、定语；用以赞誉受人崇敬的死者","story":["春秋时期，陈子禽故意贬低孔子说子贡超过孔子。子贡说孔夫子言谈得当，无人可以比拟，夫子的道德用到治国方面就得引导百姓，绥安百姓。所以夫子活在世上没有一个人不感到荣耀，夫子死了，没有一个人不为他哀痛"]},{"id":32036,"word":"生荣死衰","pinyin":"shēng róng sǐ shuāi","abbr":"srss","explanation":"用以赞誉受人崇敬的死者。同“生荣死哀”。","source":{"text":"诸子服阕，皆进一官，生荣死衰，可称达于极点了。","book":"许慕羲《宋代宫闱史》第四十六回"}},{"id":32037,"word":"生荣殁哀","pinyin":"shēng róng mò āi","abbr":"srma","explanation":"荣：荣誉；哀：哀悼。活着受人尊敬，死了使人哀痛。用以赞誉受人崇敬的死者。","source":{"text":"其生也荣，其死也哀，如之何其可及也？","book":"《论语·子张》"},"example":{"text":"《论语·子张》：“其生也荣，其死也哀，如之何其可及也？”"}},{"id":32038,"word":"生荣没哀","pinyin":"shēng róng mò āi","abbr":"srma","explanation":"用以赞誉受人崇敬的死者。同“生荣死哀”。","source":{"text":"生荣没哀，身沉誉在。","book":"唐·申堂构《唐故内常侍孙府君墓志铭》"},"similar":["生荣死哀","生荣亡哀"],"usage":"作谓语、定语；用以赞誉受人崇敬的死者"},{"id":32039,"word":"生财之路","pinyin":"shēng cái zhī lù","abbr":"sczl","explanation":"发财的门路。","source":{"text":"生财有大道：生之者众，食之者寡，为之者疾，用之者舒，则财恒足矣。","book":"《礼记·大学》"}},{"id":32040,"word":"生财之道","pinyin":"shēng cái zhī dào","abbr":"sczd","explanation":"发财的门路。","source":{"text":"生财有大道：生之者众，食之者寡，为之者疾，用之者舒，则财恒足矣。","book":"《礼记·大学》"},"example":{"text":"只是我一个女孩儿家，除了针绣女工，哪是我的～。（清·文康《儿女英雄传》第八回）"},"similar":["生财有道"],"opposite":["求救无门","投机倒把"],"usage":"作主语、宾语；形容挣钱的门道"},{"id":32041,"word":"生财有道","pinyin":"shēng cái yǒu dào","abbr":"scyd","explanation":"道：途径，方法。原指生财有个大原则，后指搞钱很有办法。","source":{"text":"生财有大道：生之者众，食之者寡，为之者疾，用之者舒，则财恒足矣。","book":"《礼记·大学》"},"example":{"text":"乾生受，～，受用无由。","book":"元·钱霖《哨遍》"},"usage":"作谓语、宾语；指开发财源有办法"},{"id":32042,"word":"生辰八字","pinyin":"shēng chén bā zì","abbr":"scbz","explanation":"生辰：生日；八字：指出生年、月、日、时所值干支，每项用两个字代替，共八字。指人的出生年、月、日、时。","source":{"text":"既要小人回背，用柳木一块，刻两个男女人形，书着娘子与夫主生辰八字，用七七四十九根红线扎在一处。","book":"明·兰陵笑笑生《金瓶梅词话》第十二回"},"example":{"text":"你今日赶快差人去寿宁宫问明费珍娥的～，再将罗虎的～，都告宋军师。","book":"姚雪垠《李自成》第四卷第二十一章"},"usage":"作宾语、定语；用于迷信活动等"},{"id":32043,"word":"生非作歹","pinyin":"shēng fēi zuò dǎi","abbr":"sfzd","explanation":"非：不对；歹：坏。做种种坏事。","source":{"text":"没揣的大惊小怪，便待要生非作歹。","book":"元·杨文奎《儿女团圆》第二折"},"similar":["为非作歹","为非作恶"],"usage":"作谓语、定语；指做种种坏事"},{"id":32044,"word":"生风作浪","pinyin":"shēng fēng zuò làng","abbr":"sfzl","explanation":"生、作：引起。原指神话小说中妖魔鬼怪施展法术掀起风浪。后多比喻煽动情绪，挑起事端。","source":{"text":"乃风行涛作，水势浪奔壮。","book":"南朝·宋·谢灵运《山居赋》"},"example":{"text":"这班混帐东西，又来～了。","book":"清·李宝嘉《活地狱》第三十五回"}},{"id":32045,"word":"生香活色","pinyin":"shēng xiāng huó sè","abbr":"sxhs","explanation":"书面上呈现活生生的景象，而且散发出香味。形容诗画所描绘的景物生动逼真。","source":{"text":"尽堪活色生香里，拥顾双栖过一春。","book":"元·王恽《繁杏锦鸠图》"}},{"id":32046,"word":"生齿日繁","pinyin":"shēng chǐ rì fán","abbr":"scrf","explanation":"生齿：指人口；繁：多。人口一天天多起来。","source":{"text":"今则荡然无法。富者跨州县而莫之止，贫者流离饿殍而莫之恤，幸民虽多而衣食不足者，盖无纪极，生齿日益繁而不为之制。","book":"宋·程颐《论十事札子》"},"example":{"text":"况丛林绀宇，分养无告之民。～，岂可泥腐儒之陈言哉！","book":"清·阮葵生《茶余客话》卷十四"},"usage":"作谓语、定语；指人口增加"},{"id":32047,"word":"生龙活现","pinyin":"shēng lóng huó xiàn","abbr":"slhx","explanation":"犹言活龙活现。形容神情逼真，使人感到好像亲眼看到一般。","source":{"text":"呈辞上说得生龙活现，不由你不核准。","book":"方志敏《可爱的中国·狱中纪实七》"},"similar":["活龙活现"],"usage":"作定语、状语；指逼真"},{"id":32048,"word":"生龙活虎","pinyin":"shēng lóng huó hǔ","abbr":"slhh","explanation":"有生气的龙和有活力的虎。形容活泼矫健，富有生气。","source":{"text":"不然，只见得他如生龙活虎相似，更把捉不得。","book":"宋·朱熹《朱子全书》卷四十五"},"example":{"text":"城外元兵虽多，却被张世杰一马在前，宗仁、宗义在后，如～一般，杀入阵去。","book":"清·吴趼人《痛史》第五回"},"similar":["生气勃勃","龙腾虎跃"],"opposite":["老气横秋","死气沉沉"],"usage":"作定语、状语、补语；指充满活力"},{"id":32049,"word":"用一当十","pinyin":"yòng yī dāng shí","abbr":"yyds","explanation":"比喻以寡敌众。","source":{"text":"君以孤城，用一当十，何以能守？","book":"宋·陈善《扪虱新活·张巡杀爱妾刘昌斩孤甥》"},"similar":["以一当十"],"usage":"作谓语、状语；用于处事"},{"id":32050,"word":"用之不竭","pinyin":"yòng zhī bù jié","abbr":"yzbj","explanation":"竭：尽。无限取用而不会使用完。","source":{"text":"江山风月，耳目声色。取之不尽，用之不竭。","book":"宋·徐经孙《哨遍》"},"example":{"text":"天中空气到处皆有，取之不尽，～，一天吃到晚，都不用工夫。","book":"孙中山《民权主义》"},"similar":["取之不尽"],"usage":"作谓语、定语；指数量多"},{"id":32051,"word":"用之则行，舍之则藏","pinyin":"yòng zhī zé xíng，shě zhī zé cáng","abbr":"yzzxszzc","explanation":"任用就出来做事，不得任用就退隐。这是早时世大夫的处世态度。","source":{"text":"用之则行，舍之则藏，唯我与尔有是夫。","book":"《论语·述而》"},"similar":["用行舍藏","用舍行藏"],"usage":"作定语；用于处事"},{"id":32052,"word":"用人不疑，疑人不用","pinyin":"yòng rén bù yí，yí rén bù yòng","abbr":"yrbyyrby","explanation":"疑：怀疑。既然已经任用的人，就应当充分信任；有怀疑信不过的人，就不要用。","source":{"text":"疑人勿使，使人勿疑。自今本国及诸色人，量才通用之。","book":"《旧唐书·陆贽传》：“夫如是，则疑者不使，使者不疑。”《金史·熙宗本纪》"},"example":{"text":"茅盾《子夜》：“急冲冲地跑到厂里来，便是对于部下的办事人还没有绝对信任的意思，那就不合于‘～’的原则。”"},"usage":"作宾语、定语；用于用人"},{"id":32053,"word":"用人惟才","pinyin":"yòng rén wéi cái","abbr":"yrwc","explanation":"用：任用；惟：只有。任用人时只依据其才能。指量才任用。","source":{"text":"夫用人惟才，不遗疏远单贱，天下便化矣。","book":"《晋书·山涛传》"},"example":{"text":"绍外宽内忌，所任多亲戚，公外简内明，～，此度胜也。","book":"明·罗贯中《三国演义》第十八回"}},{"id":32054,"word":"用兵之道，以计为首","pinyin":"yòng bīng zhī dào，yǐ jì wéi shǒu","abbr":"ybzdyjws","explanation":"首：第一。指挥军队作战的法则，应把研究各种情况，制定谋略作为首先加以考虑的事情。","source":{"text":"凡用兵之道，以计为首。未战之时，先料将之贤愚，敌之强弱，兵之众寡，地之险易，粮之虚实。计料已审，然后出兵，无有不胜。","book":"明·刘伯温《百战奇略·计战》"}},{"id":32055,"word":"用兵如神","pinyin":"yòng bīng rú shén","abbr":"ybrs","explanation":"调兵遣将如同神人。形容善于指挥作战。","source":{"text":"为头一个先生，姓樊，名瑞，绰号混世魔王，能呼风唤雨，用兵如神。","book":"明·施耐庵《水浒全传》第五十九回"},"example":{"text":"三国时期的诸葛亮神机妙算，～。"},"similar":["神机妙算","料事如神"],"usage":"作谓语；指善于用兵","story":["东汉时期，刘备派诸葛亮留守荆州，自己带兵进攻益州。诸葛亮深知益州守将张任胆略过人，不能轻敌。于是亲自带兵前去诱敌，张任见诸葛亮带一支队伍不整的军队来袭，心想他用兵如神只不过是传言，于是中计成为诸葛亮的瓮中之鳖"]},{"id":32056,"word":"用其所欲，行其所能","pinyin":"yòng qí suǒ yù，yòng qí suǒ néng","abbr":"yqsyxqsn","explanation":"欲：长处。根据人的专长加以使用，根据人的能力分担任务。","source":{"text":"凡战，智也；斗，勇也；阵，巧也。用其所欲，行其所能，废其不欲不能；于敌反是。","book":"《司马法·定爵》"}},{"id":32057,"word":"用其所长","pinyin":"yòng qí suǒ cháng","abbr":"yqsc","explanation":"使用人的专长。","source":{"text":"凡人材性不一，各有长短，用其所长，事无不举；强其所短，政必不逮。","book":"宋·胡仔《苕溪渔隐丛话后集·六一居士》"},"example":{"text":"明·余继登《典故纪闻》第二卷：“在廷之臣各令言朝廷得失，庶上有所据而～。”"},"opposite":["用违所长"],"usage":"作谓语、定语；用于处事"},{"id":32058,"word":"用夏变夷","pinyin":"yòng xià biàn yí","abbr":"yxby","explanation":"夏，诸夏，古代中原地区周王朝所分封的各诸侯国；夷，指中原地区以外的各族。以诸夏文化影响中原地区以外的僻远部族。","source":{"text":"吾闻用夏变夷者，未闻变于夷者。","book":"战国·邹·孟轲《孟子·滕文公上》"},"example":{"text":"平时守着～的古训，把新政、新学批驳得一钱不值。","book":"蔡东藩《慈禧太后演义》第13回"},"opposite":["全盘西化"],"usage":"作谓语、宾语、定语；指中华文化同化少数民"},{"id":32059,"word":"用天因地","pinyin":"yòng tiān yīn dì","abbr":"ytyd","explanation":"利用天时，顺应地利。","source":{"text":"蜀地沃野千里，土壤膏腴……所谓用天因地，成功之资也。","book":"《东观汉记·公孙术传》"},"usage":"作宾语、定语；用于书面语"},{"id":32060,"word":"用尽心机","pinyin":"yòng jìn xīn jī","abbr":"yjxj","explanation":"心机：心思。用尽了心思。","source":{"text":"若不投其所好，怎得重用？因此费尽心机，访得今日是他生日，预差人浇成一对寿烛。","book":"明·王世贞《鸣凤记》第四出"},"example":{"text":"这是纵使徐懋庸之流～，也无法抹杀的。","book":"鲁迅《且介亭杂文末编·答徐懋庸并关于抗日统一战线问题》"},"similar":["机关算尽","费尽心机"],"usage":"作谓语；指费劲心思"},{"id":32061,"word":"用尽机关","pinyin":"yòng jìn jī guān","abbr":"yjjg","explanation":"挖空心思，想尽办法。","source":{"text":"昨夜因看蜀志。笑曹操、孙权、刘备。用尽机关，徒劳心力，只得三分天地。","book":"宋·范仲淹《剔银灯·与欧阳公席上分题》词"},"example":{"text":"闹里偷声，日中逃影，～无少留。","book":"宋·廖行之《沁园春·和苏宣教韵》词"},"similar":["机关用尽"],"opposite":["束手无策"],"usage":"作谓语、宾语、定语；指费尽心机"},{"id":32062,"word":"用心措意","pinyin":"yòng xīn cuò yì","abbr":"yxcy","explanation":"指存心留意。","source":{"text":"用心措意，何其不平也。","book":"汉·王充《论衡·间时》"}},{"id":32063,"word":"用心用意","pinyin":"yòng xīn yòng yì","abbr":"yxyy","explanation":"犹言专心致志。形容一心一意，聚精会神。","source":{"text":"其实他并不想晓得正文中讲些什么，他只在聚精会神地，用心用意地，向密密的方块字群中寻找他所要寻找的一个字。","book":"姚雪垠《长夜》九"},"similar":["专心致志"],"usage":"作定语、状语；用于书面语"},{"id":32064,"word":"用心竭力","pinyin":"yòng xīn jié lì","abbr":"yxjl","explanation":"用尽心计和力量。","source":{"text":"如今圣人招贤纳士，豁达大度，正用你股肱之臣，则要你用心竭力也。","book":"明·无名氏《破天阵》第二折"},"usage":"作谓语、状语；用于处事"},{"id":32065,"word":"用心良苦","pinyin":"yòng xīn liáng kǔ","abbr":"yxlk","explanation":"用心：认真思考；良：很。很费心思地反复思考。","source":{"text":"尝读时髦所撰，惜其惨淡经营，用心良苦。","book":"清·李渔《闲情偶寄·结构第一》"},"example":{"text":"不能不说他们的‘～’，然而事实告诉我们，这样枝枝节节，一手一足的办法，何时才能有成效！","book":"王统照《青纱帐》"},"usage":"作谓语、宾语、定语；指别有用心"},{"id":32066,"word":"用志不分","pinyin":"yòng zhì bù fēn","abbr":"yzbf","explanation":"志：心思；分：分散。用心志一，不分散注意力。指一心不二用。","source":{"text":"用志不分，乃凝于神。其佝偻丈人之谓乎！","book":"《庄子·达生》"}},{"id":32067,"word":"用智铺谋","pinyin":"yòng zhì pù móu","abbr":"yzpm","explanation":"运用智力，设谋略。亦作“用计铺谋”。","source":{"text":"韩元帅率领军卒，驱将校用智铺谋。","book":"明·无名氏《暗度陈仓》第二折"},"similar":["用计铺谋"],"usage":"作谓语、定语；用于处事"},{"id":32068,"word":"用武之地","pinyin":"yòng wǔ zhī dì","abbr":"ywzd","explanation":"形容地形险要，利于作战的地方。比喻可以施展自己才能的地方或机会。","source":{"text":"洛阳虽小，山河四塞，亦是用武之地。","book":"《晋书·姚襄载记》"},"example":{"text":"你自己先把根基弄坏了，将来就有～，也不能做个大英雄，岂不是自暴自弃？","book":"冰心《两个家庭》"},"usage":"作宾语；指施展才能的地方","story":["公元208年，曹操率大军南征荆州，刘琮投降曹操，刘备不忍心拿下荆州就只好去东吴联合孙权。诸葛亮在柴桑劝说孙权，说刘备考虑同刘表的关系才落得英雄无用武之地。他希望孙权能够与联合起来共同对付曹操"]},{"id":32069,"word":"用管窥天","pinyin":"yòng guǎn kuī tiān","abbr":"ygkt","explanation":"从管子里看天。比喻眼光狭窄，见识短浅。","source":{"text":"譬犹以管窥天，讵知天之阔狭。","book":"《庄子·秋水》：“是直用管窥天，用锥指地也，不亦小乎！”成玄英疏"},"similar":["管见所及"],"usage":"作宾语、定语；用于比喻句"},{"id":32070,"word":"用舍行藏","pinyin":"yòng shě xíng cáng","abbr":"ysxc","explanation":"用：任用；舍：不用；行：做事；藏：隐退。任用就出来做事，不得任用就退隐。这是早时世大夫的处世态度。","source":{"text":"用之则行，舍之则藏，唯我与尔有是夫。","book":"《论语·述而》"},"example":{"text":"～要及时，制成团扇寄相思。","book":"清·钱泳《履园丛话·谭诗·纪存》四"},"similar":["用行舍藏"],"usage":"作谓语、定语；指士大夫的处世态度"},{"id":32071,"word":"用行舍藏","pinyin":"yòng xíng cáng shě","abbr":"yxsc","explanation":"任用就出来做事，不得任用就退隐。这是早时世大夫的处世态度。","source":{"text":"用之则行，舍之则藏，唯我与尔有是夫。","book":"《论语·述而》"},"example":{"text":"其为道也，～，进退可度。","book":"汉·蔡邕《陈太丘碑》"},"similar":["用舍行藏"],"usage":"作谓语、定语；指士大夫的处世态度"},{"id":32072,"word":"用计铺谋","pinyin":"yòng jì pū móu","abbr":"yjpm","explanation":"用计策，设谋略。","source":{"text":"这壁厢，爷受苦，那壁厢儿啼哭，哥也你可怜见同衙府，你休要运计铺谋。","book":"元·郑庭玉《后庭花》第二折"},"example":{"text":"俺行兵处尽按管乐～，相持时尽按孙吴安营下寨。","book":"明·黄元吉《流星马》第二折"},"similar":["用智铺谋"],"usage":"作谓语、定语；用于处事"},{"id":32073,"word":"用贤任能","pinyin":"yòng xián rèn néng","abbr":"yxrn","explanation":"任用贤良且有能力的人。","source":{"text":"陛下益养民爱力，用贤任能，疏远奸谀，进用忠鲠，天下悦服，边备日充。","book":"宋·邵伯温《闻见前录》"},"example":{"text":"清·钱彩《说岳全传》第31回：“是以我主上神佑，泥马渡江，正位金陵，～，中兴指日可待。”"},"similar":["任贤使能"],"opposite":["妒贤嫉能","任人唯亲"],"usage":"作谓语、宾语；指启用贤人"},{"id":32074,"word":"用违其长","pinyin":"yòng wéi suǒ cháng","abbr":"ywqz","explanation":"违：违背。用人没有使用其特长。","source":{"text":"逵料葛怀敏之败，如烛照龟卜，一时最为知兵。虽南征无功，用违其长，又何尤焉。","book":"《宋史·曹利用等传论》"},"example":{"text":"吴主却令他分将父兵，真所谓～了。","book":"蔡东藩《两晋演义》第四回"}},{"id":32075,"word":"用违所长","pinyin":"yòng wéi suǒ cháng","abbr":"ywsz","explanation":"违：违背。用人没有使用他的专长","source":{"text":"逵料葛怀敏之败，如烛照龟卜，一时最为知兵。虽南征无功，用违其长，又何尤焉。","book":"《宋史·郭逵传论》"},"example":{"text":"清·文康《儿女英雄传》第35回：“只看世上那班分明造极登峰的，也会变生不测，任是争强好胜的，偏逢～。”"},"opposite":["用其所长"],"usage":"作谓语、定语；用于书面语"},{"id":32076,"word":"用逸待劳","pinyin":"yòng yì dài láo","abbr":"yydl","explanation":"以逸待劳。谓作战时采取守势，养精蓄锐，待敌军奔走疲惫之后，乘机出击以取胜。","source":{"text":"御以长辔，用逸待劳，比及数年，兴复可骥。","book":"《晋书·庚翼传》"},"similar":["以逸待劳"],"usage":"作谓语、宾语、状语；用于处事等"},{"id":32077,"word":"用钱因地","pinyin":"yòng qián yīn dì","abbr":"yqyd","explanation":"利用天时，顺应地利。指善于依据客观条件办事。","source":{"text":"所谓用天因地，成功之资也。","book":"汉·班固《东观汉纪·公孙述载记》"}},{"id":32078,"word":"用钱如水","pinyin":"yòng qián rú shuǐ","abbr":"yqrs","explanation":"花钱如同流水一般，没有节制。形容挥霍无度，不爱惜钱财。","source":{"text":"用钱如水赠舞儿，却入上苑看斗鸡。","book":"宋·梅尧臣《观拽龙舟怀裴宋韩李》诗"},"similar":["挥金如土"],"usage":"作谓语、定语；用于处事"},{"id":32079,"word":"用非其人","pinyin":"yòng fēi qí rén","abbr":"yfqr","explanation":"任用了不适当的人才。指用人不当。","source":{"text":"三公具赡所归，不可用非其人。昔魏文帝用贾诩为三公，孙权笑之。","book":"《魏略》"},"usage":"作宾语、定语；用于处事"},{"id":32080,"word":"用非所学","pinyin":"yòng fēi suǒ xué","abbr":"yfsx","explanation":"所用的不是所学的。指学用不一致。","source":{"text":"比到京师，而除官多以貌选，所学或非其所用，所用或非其所学。","book":"《明史·叶伯巨传》"},"example":{"text":"无奈兄弟三个，因为所～，就有点瞧先生不起。","book":"清·李宝嘉《文明小史》第十四回"},"opposite":["学以致用"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":32081,"word":"用非所长","pinyin":"yòng fēi suǒ cháng","abbr":"yfsz","explanation":"使用的不是他的特长。","example":{"text":"张作霖本是一个老粗，虽然他粗中有细，智慧特高，可是由他扮演“和事佬”，究竟是～。","book":"丁中江《北洋军阀史话》一六七"}},{"id":32082,"word":"田夫野叟","pinyin":"tián fū yě sǒu","abbr":"tfys","explanation":"泛指民间百姓。同“田夫野老”。","source":{"text":"其尤殊不知绝者，则抑于下土，使田夫野叟往往属厌，而大官不得献之于陛下。","book":"宋·曾巩《福州拟贡荔枝状》"},"similar":["田父野叟","田夫野老"],"opposite":["达官贵人"],"usage":"作主语、宾语；指农民"},{"id":32083,"word":"田夫野老","pinyin":"tián fū yě lǎo","abbr":"tfyl","explanation":"乡间农夫，山野父老。泛指民间百姓。","source":{"text":"当时田夫野老，知与不知，莫不为之觑欷流泣。","book":"《北齐书·王琳传》"},"example":{"text":"鲁迅《中国小说史略》：“至谓作者搜采异闻，乃设烟茗于门前，邀～，强之谈说以为粉本，则不过委巷之谈而已。”"},"similar":["田夫野叟","田畯野老","田父野老"],"usage":"作主语、宾语；指农民"},{"id":32084,"word":"田月桑时","pinyin":"tián yuè sāng shí","abbr":"tyss","explanation":"泛指农忙季节。","source":{"text":"且田月向登，桑时告至。","book":"南朝齐·萧子良《谏射雉启》"},"usage":"作宾语、定语；用于书面语"},{"id":32085,"word":"田横笑人","pinyin":"tián héng xiào rén","abbr":"thxr","explanation":"田横：战国时齐国人，韩信破齐后，逃亡海岛，刘邦称帝后遣使招降，，横羞为汉臣，自杀而死。形容宁死不屈。","source":{"text":"人皆有死，此不足俱，吾若逃亡，非惟孤晋安之眷，亦恐田横客笑人。","book":"《南史·齐晋安王传》"}},{"id":32086,"word":"田父之功","pinyin":"tián fǔ zhī gōng","abbr":"tfzg","explanation":"比喻两者相争，第三者得利。","source":{"text":"田父见之，无劳倦之苦而擅其功。","book":"《战国策·齐策三》"},"similar":["田父之获"],"usage":"作宾语；比喻两者相争，第三者得利","story":["战国时期，齐国准备讨伐魏国，淳于髡对齐王说：“天下第一快狗韩子卢去追天下第一狡兔东郭浚，追了一山又一山，双方筋疲力尽，都被累死。一个老农刚好路过，捡到快死的狗和兔子。现在齐国和魏国相持下去，别国就会有田父之功。”"]},{"id":32087,"word":"田父之获","pinyin":"tián fù zhī huò","abbr":"tfzh","explanation":"比喻两者相争，第三者得利。同“田父之功”。","source":{"text":"此韩庐、东郭自困于前而遗田父之获者也。","book":"《三国志·魏志·袁绍传》“太祖乃还救谭”裴松之注引晋·孙盛《魏氏春秋》"},"example":{"text":"明·罗贯中《三国演义》第33回：“若迷而不返，则是韩卢、东郭自困于前，而遗～也。”"},"similar":["渔翁之利","田父之功"],"usage":"作宾语；用于书面语","story":["传说古代天下跑得最快的狗是韩子卢，而跑得最快而且狡猾的兔子是东郭逡。一天一只韩子卢追逐东郭逡，围绕三座山跑了五圈，韩子卢还是没有追上东郭逡，结果两者都累死了。一个农夫刚好路过，轻易地捉住韩子卢和东郭逡"]},{"id":32088,"word":"田父献曝","pinyin":"tián fǔ xiàn pù","abbr":"tfxp","explanation":"田父：老农；曝：晒。老农将晒太阳取暖的方法献给国君。常作向人献物或献计的谦词。","source":{"text":"宋国有田夫，常衣缊黂，仅以过冬。暨春东作，自曝于日，不知天下之有广厦隩室，緜纩狐狢。顾谓其妻曰：‘负日之暄，人莫知者，以献吾君，将有重赏。’","book":"《列子·杨朱篇》"},"similar":["野人献曝"],"usage":"作宾语、定语；指自作聪明","story":["战国时期，宋国有一个没有见过世面的农夫，由于家贫终日穿一件粗麻衣，勉强过冬。第二年春天，天气晴朗，他就脱光衣服在太阳下曝晒，觉得十分舒服，由于没有见过漂亮的皮衣和高大的房子，就对妻子说将把这取暖的办法进献给国王"]},{"id":32089,"word":"田父野叟","pinyin":"tián fù yě sǒu","abbr":"tfys","explanation":"泛指民间百姓。同“田夫野老”。","source":{"text":"方春劝耕，遭田父野叟于途，慰以农里之言，而勉之孝弟之训。","book":"金·元好问《登封令薛侯去思颂》"},"similar":["田夫野叟","田父野老"],"usage":"作主语、宾语；指农民"},{"id":32090,"word":"田父野老","pinyin":"tián fù yě lǎo","abbr":"tfyl","explanation":"泛指民间百姓。同“田夫野老”。","source":{"text":"轼与田父野老，相从溪山间，筑室于东坡，自号‘’。","book":"《宋史·苏轼传》"},"similar":["田夫野老","田父野叟"],"opposite":["达官贵人"],"usage":"作主语、宾语；指农民"},{"id":32091,"word":"田畯野老","pinyin":"tián jùn yě lǎo","abbr":"tjyl","explanation":"泛指民间百姓。同“田夫野老”。","source":{"text":"其或蹲林卧石，籍卉班荆，不过田畯野老，渔父樵客。","book":"南朝·梁·王僧孺《答江琰书》"},"similar":["田夫野老","田父野老","田父野叟"],"opposite":["公子王孙"],"usage":"作主语、宾语；指农民"},{"id":32092,"word":"田连仟伯","pinyin":"tián lián qiān mò","abbr":"tlqb","explanation":"田间小路接连不断。形容田地广阔。同“田连阡陌”。","source":{"text":"富者田连仟伯，贫者亡立锥之地。","book":"《汉书·食货志上》"}},{"id":32093,"word":"田连仟佰","pinyin":"tián lián qiān mò","abbr":"tlqb","explanation":"仟佰：通“阡陌”。指田地广袤，接连不断。","source":{"text":"富者田连仟佰，贫者亡立锥之地。","book":"汉·荀悦《汉书·食货志》"},"similar":["田连阡陌"],"usage":"作谓语、定语；指人富有"},{"id":32094,"word":"田连阡陌","pinyin":"tián lián qiān mò","abbr":"tlqm","explanation":"阡陌：田间小路。形容田地方袤，接连不断。","source":{"text":"富者田连阡陌，贫者无立锥之地。","book":"汉·荀悦《汉纪·武帝纪四》"},"example":{"text":"明·冯梦龙《喻世明言》第22卷：“如今大户～，小民无立锥之地，有田者不耕，欲耕者无田。”"},"similar":["田连仟佰"],"usage":"作谓语、定语；指人富有"},{"id":32095,"word":"田野自甘","pinyin":"tián yě zì gān","abbr":"tyzg","explanation":"乐于不追求名利的田野生活。","source":{"text":"乞城内及城边好田，尽所赐百年力者，臣虽生自至尊，然心甘田野，性至稼穑。","book":"三国·魏·曹植《乞田表》"}},{"id":32096,"word":"由中之言","pinyin":"yóu zhōng zhī yán","abbr":"yzzy","explanation":"出自内心的话。","source":{"text":"曹操之令，皆由中之言也。","book":"清·恽敬《辨微论》"},"similar":["由衷之言"],"usage":"作宾语；指出自内心的话"},{"id":32097,"word":"由博返约","pinyin":"yóu bó fǎn yuē","abbr":"ybfy","explanation":"指做学问人广博出发，继而务精深，最终达到简约。","source":{"text":"博学而详说之，将以反说约也。","book":"《孟子·离娄下》"},"example":{"text":"这首诗体现了老诗人～的创作轨迹。"},"usage":"作谓语、定语；用于学习"},{"id":32098,"word":"由小见大","pinyin":"yóu xiǎo jiàn dà","abbr":"yxjd","explanation":"从小部分看出大局面；从小事看出大道理。","source":{"text":"作自我教育的‘村史’，这却是破天荒的创造。联想所及，由小见大。","book":"李欣《老生常谈·编村史》"},"similar":["以小见大"],"usage":"作谓语、宾语、定语；用于看问题等"},{"id":32099,"word":"由来已久","pinyin":"yóu lái yǐ jiǔ","abbr":"ylyj","explanation":"由来：从发生到现在。事情从发生到现在已经过了很长时间了。","source":{"text":"王子敬病笃，道家上章应首过，问子敬由来有何异同得失。","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“法国觊觎越南，～。”"},"usage":"作谓语、定语；用于事情等"},{"id":32100,"word":"由此及彼","pinyin":"yóu cǐ jí bǐ","abbr":"ycjb","explanation":"此：这个；彼：那个。由这一现象联系到那一现象。","source":{"text":"遇着通晓之人，就虚心请问，由此及彼，铢积寸累，自然日有进益。","book":"清·夏敬渠《野叟曝言》第66回"},"example":{"text":"将侦察得来的敌方情况的各种材料加以去粗取精、去伪存真、～、由表及里的思索。","book":"毛泽东《中国革命战争的战略问题》"},"usage":"作状语；指相互关联"},{"id":32101,"word":"由浅入深","pinyin":"yóu qiǎn rù shēn","abbr":"yqrs","explanation":"从浅到深。","source":{"text":"夫诗之章法起句，必切本题，且由纲及目，由浅入深。","book":"清·无名氏《杜诗言志》第四卷"},"example":{"text":"对于社会方面，也都是一步又一步地由低级向高级发展，即～，由片面到更多的方面。","book":"毛泽东《实践论》"},"similar":["深入浅出"],"usage":"作谓语、状语；指逐渐深入"},{"id":32102,"word":"由窦尚书","pinyin":"yóu dòu shàng shū","abbr":"ydss","explanation":"比喻没有真才实学，专靠奉承往上爬的人。","source":{"text":"居亡何，同知枢密院事。当时有‘由窦尚书、屈膝执政’之语，传以为笑。","book":"《宋史·许及之传》"},"usage":"作宾语、定语；用于比喻句","story":["宋朝时期，许及之极力谄事佗胄，真是无所不至。一次佗胄生日，许多官员去祝寿，及之后来才到，宦官把门关了，他只好从墙洞里钻入。他担任尚书两年没有得到升迁，于是在佗胄面前诉苦，佗胄恻隐安慰他，后来才升他官。当时人笑他为由窦尚书"]},{"id":32103,"word":"由表及里","pinyin":"yóu biǎo jí lǐ","abbr":"ybjl","explanation":"表：表面；里：本质。从表面现象看到本质。","source":{"text":"将丰富的感觉材料加以去粗取精、去伪存真、由此及彼、由表及里的改造制作功夫。","book":"毛泽东《实践论》"},"example":{"text":"看问题要由表及里。"},"similar":["由浅入深","循序渐进"],"usage":"作状语；指从表面现象看到本质"},{"id":32104,"word":"由衷之言","pinyin":"yóu zhōng zhī yán","abbr":"yzzy","explanation":"衷：内心。出自内心的话。","source":{"text":"随其人之性情学问境地，莫不有由衷之言。","book":"清·周济《介存斋论词杂著》"},"example":{"text":"这番话是我的～。"},"similar":["真心实话","心直口快"],"opposite":["言不由衷"],"usage":"作宾语；指出自内心的话"},{"id":32105,"word":"由近及远","pinyin":"yóu jìn jí yuǎn","abbr":"yjjy","explanation":"从近处到远处。比喻事物的影响逐渐推广，思想认识不断深入。"},{"id":32106,"word":"甲乙丙丁","pinyin":"jiá yǐ bǐng dīng","abbr":"jybd","explanation":"古代天干排序的前一到四位。指事物的顺序或事物大概轮廓。","source":{"text":"或作讲演，则甲乙丙丁、一二三四的一大串；或作文章，则夸夸其谈的一大篇。","book":"毛泽东《改造我们的学习》"},"similar":["子丑寅卯"],"usage":"作宾语、定语；用于顺序"},{"id":32107,"word":"甲兵在胸","pinyin":"jiǎ bīng zài xiōng","abbr":"jbzx","explanation":"甲兵：铠甲和兵器，泛指武器。比喻胸中富有韬略。","source":{"text":"汝曹视此人尪纤懦弱，手不能弯弓持矛，其胸中所怀乃逾于甲兵。","book":"《魏书·崔浩传》"}},{"id":32108,"word":"甲冠天下","pinyin":"jiǎ guàn tiān xià","abbr":"jgtx","explanation":"甲冠：第一。称雄天下。形容人或事物十分突出，无与伦比。","example":{"text":"桂林山水～。"},"similar":["天下第一"],"usage":"作谓语、定语；用于书面语"},{"id":32109,"word":"甲坚兵利","pinyin":"jiá jiān bīng lì","abbr":"jjbl","explanation":"甲：盔甲；坚：坚固；兵：兵器；利：锋利。坚固的盔甲，锋利的兵器。比喻精锐部队。","source":{"text":"受敌者不得相以为固，甲坚兵利不得以为强。","book":"战国·齐·孙膑《孙膑兵法·客主人分》"},"similar":["坚甲利兵","坚甲利刃"],"usage":"作宾语、定语；指坚强善战的军队"},{"id":32110,"word":"甲第星罗","pinyin":"jiǎ dì xīng luó","abbr":"jdxl","explanation":"甲第：富豪显贵的高级宅第；星罗：象繁星一样排列着。形容富贵人家的宅第极多。","source":{"text":"甲第：富豪显贵的高级宅第；星罗：象繁星一样排列着。形容富贵人家的宅第极多。"},"similar":["甲第连天"],"usage":"作谓语、定语；用于书面语"},{"id":32111,"word":"甲第连云","pinyin":"jiǎ dì lián yún","abbr":"jdly","explanation":"甲第：富豪显贵的宅第。形容富豪显贵的住宅非常之多。","source":{"text":"长安甲第高入云，谁家居住霍将军。","book":"唐·崔颢《长安道》"},"example":{"text":"做善事的时候，不过是个穷光蛋，不多几年，就有好几个～起来了。","book":"清·吴趼人《二十年目睹之怪现状》第十五回"},"similar":["甲第星落","甲第连天"],"usage":"作谓语、定语；形容荣华富贵"},{"id":32112,"word":"甲第连天","pinyin":"jiǎ dì lián tiān","abbr":"jdlt","explanation":"甲第：富豪显贵的宅第。形容富豪显贵的住宅非常之多。","source":{"text":"长安甲第高入云，谁家居住霍将军。","book":"唐·崔颢《长安道》"},"example":{"text":"门外车轮流水，城中～，琼楼酬月十二层，锦障藏春五十里。","book":"明·高则诚《琵琶行·牛氏规奴》"},"similar":["甲第星罗","甲第连云"],"usage":"作谓语、定语；用于书面语"},{"id":32113,"word":"甲胄生虮虱","pinyin":"jiǎ xhòu shēng jī shī","abbr":"jzsjs","explanation":"甲、胄：古代士兵作战时所穿戴的铠甲和头盔。铠甲和头盔上都长满了虮虱。形容战争持续时间很长。","source":{"text":"天下无道，攻击不休，相守数年不已，甲胄生虮虱，燕雀处帷幄，而兵不归。","book":"《韩非子·喻老》"},"example":{"text":"自陛下十五年起义图霸，为雪家仇国耻，甲胄生虮虱，黎人困输挽。","book":"《旧五代史·郭崇韬传》"}},{"id":32114,"word":"申冤吐气","pinyin":"shēn yuān tǔ qì","abbr":"sytq","explanation":"洗雪冤屈，发泄怨恨。"},{"id":32115,"word":"申旦达夕","pinyin":"shēn dàn dá xī","abbr":"sddx","explanation":"自夜至晨，自晨到夜。形容日夜不止。","source":{"text":"简宪之为人也，不事王侯，负才任气，见余则申旦达夕，不能已已。","book":"《梁书·张缵传》"},"similar":["夜以继日"],"usage":"作谓语、状语；指日夜不停"},{"id":32116,"word":"申祸无良","pinyin":"shēn huò wú liáng","abbr":"shwl","explanation":"申：重复。申祸：第二次遭祸事。无良：形容自己没有道德。重遭祸事，是因为自己没有道德而造成的。","source":{"text":"今勾践申祸无良，草鄙之人，敢忘天王之大德，而思边陲之小怨。","book":"《国语·诸稽郢行成于吴》"}},{"id":32117,"word":"申诉无门","pinyin":"shēn sù wú mén","abbr":"sswm","explanation":"形容没有地方申诉自己的痛苦和冤屈。","example":{"text":"真是呼天天不应，唤地地无言，控告无路，～，只有听人宰割的份儿。","book":"吴越《括苍山记恩仇》第三十五回"}},{"id":32118,"word":"电光朝露","pinyin":"diàn guāng zhāo lù","abbr":"dgzl","explanation":"一闪而过的电光，日出以前的露水。比喻存在不久的事物。","source":{"text":"一切有为法，如梦幻泡影，如露亦如电，应作如是观。","book":"《金刚经》"},"similar":["电光石火"],"usage":"作宾语、定语；多用于比喻句"},{"id":32119,"word":"电光石火","pinyin":"diàn guāng shí huǒ","abbr":"dgsh","explanation":"闪电的光，燧石的火。原为佛家语，比喻事物瞬息即逝。现多形容事物象闪电和石火一样一瞬间就消逝。","source":{"text":"此事如击石火，似闪电光。","book":"宋·释普济《五灯会元》"},"example":{"text":"但看还没有十分看明，又如～一样飞也似地过去了。","book":"郭沫若《学生时代·孤山的梅花》"},"similar":["昙花一现","弹指之间","电光朝霞"],"opposite":["地久天长","旷日持久"],"usage":"作宾语、定语；用于比喻句"},{"id":32120,"word":"电卷星飞","pinyin":"diàn juǎn xīng fēi","abbr":"djxf","explanation":"卷：收起。形容像流星和闪电那样迅速。","source":{"text":"叫了店家拉过那驴儿骑上，说了声：‘公子保重，请了！’一阵电卷星飞，霎时不见踪影。","book":"清·文康《儿女英雄传》第五回"},"similar":["电卷风驰"],"usage":"作宾语、定语、状语；用于速度等"},{"id":32121,"word":"电卷风驰","pinyin":"diàn juǎn fēng chí","abbr":"djfc","explanation":"卷：收起；驰：急行。形容像刮风和闪电那样迅速。","source":{"text":"飞电马，追风马，跨上时电卷风驰。","book":"清·文康《儿女英雄传》缘起首回"},"similar":["电卷星飞","风驰电掣"],"usage":"作宾语、定语、状语；用于速度等"},{"id":32122,"word":"电掣星驰","pinyin":"diàn chè xīng chí","abbr":"dcxc","explanation":"如闪电和流星似的掠过。比喻迅疾。","source":{"text":"[十三妹]回头向大家说声请了，霎时间电掣星驰，不见踪影。","book":"《儿女英雄传》第十回"},"similar":["电掣风驰"],"usage":"作谓语、定语、状语；用于书面语"},{"id":32123,"word":"电掣风驰","pinyin":"diàn chè fēng chí","abbr":"dcfc","explanation":"形容像闪电刮风一样迅速。","source":{"text":"龙腾虎啸，不足比其雄；电掣风驰，不足喻其疾。","book":"清·百一居士《壶天录》卷下"},"example":{"text":"这里……没有什么～、左冲右撞的一切车子。","book":"郑振铎《黄昏的观前街》"},"similar":["风驰电掣"],"opposite":["蜗行牛步"],"usage":"作谓语、定语、状语；用于书面语"},{"id":32124,"word":"电流星散","pinyin":"diàn liú xīng sàn","abbr":"dlxs","explanation":"比喻迅速消散。","source":{"text":"鹯曰：‘君善捕鱼，我善捕雀，而雀之见我者，往往晓音骇翼，电流星散，以至十不获一。’","book":"清·沈起凤《谐铎·獭祭》"},"usage":"作谓语、宾语、定语；用于速度快等"},{"id":32125,"word":"电火行空","pinyin":"diàn huǒ xíng kōng","abbr":"dhxk","explanation":"闪电的火光在天空中划过。形容速度极快。","source":{"text":"我对于周公向来是心悦诚服的，他思考事物的周密有如水银泻地，处理问题的敏捷有如电火行空。","book":"郭沫若《洪波曲》第十五章"},"usage":"作宾语、定语；用于速度等"},{"id":32126,"word":"电照风行","pinyin":"diàn zhào fēng xíng","abbr":"dzfx","explanation":"如电光之照耀，如风之流动。比喻影响甚大。","source":{"text":"电照风行，声驰海外。","book":"南朝·梁·刘孝标《辩命论》"},"usage":"作宾语、定语；用于影响等"},{"id":32127,"word":"电闪雷鸣","pinyin":"diàn shǎn léi míng","abbr":"dslm","explanation":"闪电飞光，雷声轰鸣。比喻快速有力。也比喻轰轰烈烈。","source":{"text":"是英明的主意，这主意通过电话就电闪雷鸣一样传遍工地。","book":"杜鹏程《在和平的日子里》第五章"},"example":{"text":"我们的总理，回答得最为铿锵有力；不用语言，而用～般的一生的经历。","book":"郭小川《痛悼敬爱的周总理》诗"},"opposite":["晴空万里"],"usage":"作谓语，状语；比喻快速有力"},{"id":32128,"word":"男不与女斗","pinyin":"nán bù yǔ nǚ dòu","abbr":"nbynd","explanation":"男的不与女的争斗。","source":{"text":"常言道：‘男不与女斗。’我这般一个汉子，打杀这几个丫头，着实不济。","book":"明·吴承恩《西游记》第72回"},"example":{"text":"～是尊重女性的表现。"},"similar":["好男不与女斗","男不与妇敌"],"usage":"作主语、宾语、定语；用于口语"},{"id":32129,"word":"男不与妇敌","pinyin":"nán bù yǔ fù dí","abbr":"nbyfd","explanation":"指男人不和女人争斗。","source":{"text":"得罪了边氏，使他发起性来，男不与女敌，莫说被他咒骂不好应声，就是挥上几拳，打上几掌，也只好忍痛受苦。","book":"清·李渔《十二楼·夺锦楼》"},"similar":["男不与女斗","男不对女敌"],"usage":"作主语、宾语、定语；用于口语"},{"id":32130,"word":"男不对女敌","pinyin":"nán bù duì nǚ dí","abbr":"nbdnd","explanation":"男的不与女的争斗。","source":{"text":"岂知狼子野心，不惟不奉男不对女敌之古训，反欲打杀老婆。","book":"清·张南庄《何典》第五回缠夹二先生评"},"similar":["男不与女斗","男不与妇敌"],"usage":"作主语、宾语、定语；用于口语"},{"id":32131,"word":"男倡女随","pinyin":"nán chāng nǚ suí","abbr":"ncns","explanation":"倡：倡导。指女方必须附和男方。形容夫妻和睦","source":{"text":"十五许嫁而后从夫，是阳动而阴应，男唱而女随之义也。","book":"《孔丛子·嘉言》"},"similar":["男唱女随"],"usage":"作宾语；指夫妻和睦"},{"id":32132,"word":"男儿两膝有黄金","pinyin":"nán ér liǎng xī yǒu huáng jīn","abbr":"nelxyhj","explanation":"指男子汉不可轻易向人下跪。","source":{"text":"行者微露不忍之态，用手扶起道：‘常言道：男儿两膝有黄金。你今后不可乱跪！’","book":"《西游补》第六回"},"similar":["男儿膝下有黄金"],"usage":"作宾语、定语；用于男性不屈服"},{"id":32133,"word":"男儿有泪不轻弹","pinyin":"nán ér yǒu lèi bù qīng tán","abbr":"neylbqt","explanation":"弹：用手弹洒。指男子汉不轻易落泪。","source":{"text":"他们是男儿有泪不轻弹，只因未到评级时，这个风也要整一下吧。","book":"毛泽东《坚持艰苦奋斗，密切联系群众》"},"example":{"text":"～，只因未到伤心处。"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":32134,"word":"男儿膝下有黄金","pinyin":"nán ér xī xià yǒu huáng jīn","abbr":"nexxyhj","explanation":"指男子汉不可轻易向人下跪。","source":{"text":"林上舍道：‘男儿膝下有黄金，如何拜人？’","book":"明·凌濛初《初刻拍案惊奇》卷二十一"},"example":{"text":"韦小宝笑道：“好，磕头就磕头。男儿膝下有黄金，最好天天跪女人！”","book":"金庸《鹿鼎记》第二十二回"},"similar":["男儿两膝有黄金"],"usage":"作宾语、定语；用于男性不屈服"},{"id":32135,"word":"男唱女随","pinyin":"nán chàng nǚ suí","abbr":"ncns","explanation":"指女方必须附和男方。形容夫妻和睦。","source":{"text":"十五许嫁而后从夫，是阳动而阴应，男唱而女随之义也。","book":"《孔丛子·嘉言》"},"similar":["夫唱妇随"],"usage":"作宾语；指夫妻和睦"},{"id":32136,"word":"男大当娶","pinyin":"nán dà dāng qǔ","abbr":"nddq","explanation":"指男子成年后要娶亲成家。","source":{"text":"男大当娶，女大当聘，你六十九了，白活！","book":"老舍《骆驼祥子》"},"example":{"text":"～，你该结婚了。"},"similar":["男大当婚"],"opposite":["女大须嫁"],"usage":"作定语、分句；指男子到娶亲时"},{"id":32137,"word":"男大当娶，女大当聘","pinyin":"nán dà dāng qǔ，nǚ dà dāng pìn","abbr":"nddqnddp","explanation":"指男女长大成年当须婚嫁。","source":{"text":"我这才是头一回……男大当娶，女大当聘。","book":"老舍《骆驼祥子》"},"similar":["男大须婚，女大必嫁"],"usage":"作宾语、定语、分句；用于口语"},{"id":32138,"word":"男大当婚","pinyin":"nán dà dāng hūn","abbr":"nddh","explanation":"指男子万年后必须娶妻。","source":{"text":"自古道：男大当婚，女长须嫁。","book":"明·朱鼎《玉镜台记·议婚》"},"example":{"text":"他已经到了～的年龄。"},"similar":["男大须婚"],"opposite":["女大须嫁"],"usage":"作定语、分句；指男子到娶亲时"},{"id":32139,"word":"男大当婚，女大须嫁","pinyin":"nán dà dāng hūn，nǚ dà xū jià","abbr":"nddhndxj","explanation":"婚：指男子娶妻。指男女长大成年当须婚嫁。","source":{"text":"古语说得好，男大当婚，女大须嫁……只因他屡屡来求，难于拒绝，故我劝侄女嫁他。","book":"清·名教中人《好逑传》第八回"},"similar":["男大须婚，女大须嫁"],"usage":"作宾语、定语、分句；用于口语"},{"id":32140,"word":"男大须婚","pinyin":"nán dà xū hūn","abbr":"ndxh","explanation":"男子长大成年后总要娶亲成家。","source":{"text":"……忽大悟，乃别‘有男不婚，有女不嫁’之偈曰：‘男大须婚，女长须嫁。讨甚闲工夫，更说无生话。’书以寄衣，衣称善。","book":"宋·释普济《五灯会元·天衣怀禅师法嗣·侍郎杨杰居士》"},"example":{"text":"～，女大须嫁，这是人生大礼。","book":"清·文康《儿女英雄传》第二十三回"},"similar":["男大当婚"],"usage":"作定语、分句；指男子到娶亲时"},{"id":32141,"word":"男大须婚，女大必嫁","pinyin":"nán dà xū hūn，nǚ dà bì jià","abbr":"ndxhndbj","explanation":"指男女长大成年当须婚嫁。","source":{"text":"男大须婚，女大必嫁，这是人伦大事，五常之礼，何故烦恼？","book":"明·施耐庵《水浒传》第五回"},"similar":["男大须婚，女大须嫁"],"usage":"作宾语、定语、分句；用于口语"},{"id":32142,"word":"男大须婚，女大须嫁","pinyin":"nán dà xū hūn，nǚ dà xū jià","abbr":"ndxhndxj","explanation":"婚：指男子娶妻。指男女长大成年当须婚嫁。","source":{"text":"国太曰：‘男大须婚，女大须嫁，古今常理。’","book":"明·罗贯中《三国演义》第54回"},"example":{"text":"我便说：‘～，这是人生大理。’","book":"清·文康《儿女英雄传》第23回"},"similar":["男大当娶，女大当聘"],"usage":"作宾语、定语、分句；用于口语"},{"id":32143,"word":"男女别途","pinyin":"nán nǚ bié tú","abbr":"nnbt","explanation":"男子与女子应有所区别。","source":{"text":"男子与女子应有所区别。"},"example":{"text":"夜不闭户，道不拾遗，～，举选上德。","book":"太平天国·洪秀全《原道醒世训》"},"similar":["男女有别"],"usage":"作宾语；指男女之间有所分别"},{"id":32144,"word":"男女平权","pinyin":"nán nǚ píng quán","abbr":"nnpq","explanation":"男女在政治、经济和社会上的平。","source":{"text":"男女平权天赋就，岂甘居牛后？","book":"清·秋瑾《勉女权歌》"},"similar":["男女平等"],"usage":"作主语、宾语、定语；指男女地位"},{"id":32145,"word":"男女平等","pinyin":"nán nǚ píng děng","abbr":"nnpd","explanation":"男女在政治、经济和社会上的平。","source":{"text":"男女平权天赋就，岂甘居牛后？","book":"清·秋瑾《勉女权歌》"},"example":{"text":"实现婚姻自由，～，使青年和儿童得到有益的学习。","book":"毛泽东《论联合政府》"},"similar":["男女平权"],"usage":"作主语、宾语、定语；指男女的地位"},{"id":32146,"word":"男女授受不亲","pinyin":"nán nǚ shòu shòu bù qīn","abbr":"nnssbq","explanation":"授：给予；受：接受；亲：亲自接触。封建礼教规定男女之间不能直接接触、言谈或授受物件，限制男女交往。","source":{"text":"男女授受不亲，礼也。","book":"战国·邹·孟轲《孟子·离娄上》"},"example":{"text":"你我～，你可记得我在能仁寺救你的残生，那样性命呼吸之间，我尚且守这大礼，把那弓梢儿扶你。","book":"清·文康《儿女英雄传》"},"opposite":["男欢女爱"],"usage":"作谓语、宾语、定语；指封建思想"},{"id":32147,"word":"男女有别","pinyin":"nán nǚ yǒu bié","abbr":"nnyb","explanation":"男女之间有严格区别。旧时用以强调应严守封建礼教。","source":{"text":"犹男婚女嫁。指儿女成家。"},"example":{"text":"你我萍水相逢，况且～，你与我无干，我管你不着。","book":"清·文康《儿女英雄传》第五回"},"similar":["男女别途"],"opposite":["亲密无间"],"usage":"作宾语、定语；指男女之间有所分别"},{"id":32148,"word":"男女老小","pinyin":"nán nǚ lǎo xiǎo","abbr":"nnlx","explanation":"泛指所有的人。","source":{"text":"你到底是帮助救活了桥东几十家的男女老小呢！让我们拆桥吧！","book":"洪深《五奎桥》"},"similar":["男女老少","男女老幼"],"usage":"作主语、宾语；泛指所有的人"},{"id":32149,"word":"男女老少","pinyin":"nán nǚ lǎo shào","abbr":"nnls","explanation":"泛指所有的人。","source":{"text":"麦苗肥，稻花香，男女老少喜洋洋。","book":"光未然《黄河大合唱·黄水谣》"},"example":{"text":"你要通知到村里的～。"},"similar":["男女老幼"],"usage":"作主语、宾语；泛指所有的人"},{"id":32150,"word":"男女老幼","pinyin":"nán nǚ lǎo yòu","abbr":"nnly","explanation":"泛指所有的人。","source":{"text":"男女老幼，大临街衢，接响传声。","book":"南朝·梁·沈约《齐故安陆昭王碑文》"},"example":{"text":"不论～，都要和和气气组织起来。","book":"巴金《火》第二部"},"similar":["男女老少"],"usage":"作主语、宾语；泛指所有的人"},{"id":32151,"word":"男婚女嫁","pinyin":"nán hūn nǚ jià","abbr":"nhnj","explanation":"指儿女成家。","source":{"text":"空怀济世安人略，不见男婚女嫁时。","book":"语出《后汉书·逸民传·向长》：“建武中，男女聚嫁既毕，[长]敕断家事勿相关，当如我死也。”唐·刘禹锡《哭吕衡州时予方谪居》诗"},"example":{"text":"～，大事都完了。","book":"冰心《南归》"},"similar":["男大当婚，女大当嫁","男婚女聘"],"usage":"作宾语、定语；指儿女成家"},{"id":32152,"word":"男婚女聘","pinyin":"nán hūn nǚ pìn","abbr":"nhnp","explanation":"指儿女成家。","source":{"text":"没来由强风情，刚可喜男婚女聘。","book":"元·关汉卿《金线池》第三折"},"example":{"text":"～，古之礼也。你既娶妇，何不领归？","book":"明·冯梦龙《喻世明言》卷三十四"},"similar":["男婚女嫁","男室女家"],"usage":"作宾语、定语；指儿女成家"},{"id":32153,"word":"男媒女妁","pinyin":"nán méi nǚ shuò","abbr":"nmns","explanation":"妁：媒人。指男女媒人。","source":{"text":"除非他女儿不要嫁人便罢休，不然少不得男媒女妁。","book":"明·冯梦龙《醒世恒言》卷七"},"usage":"作主语、宾语、定语；指媒人"},{"id":32154,"word":"男子汉大丈夫","pinyin":"nán zǐ hàn dà zhàng fū","abbr":"nzhdzf","explanation":"指志向高远有所作为的男人。","source":{"text":"男子汉大丈夫，休说那三绺梳头、两截穿衣、戴鬄髻的话头。","book":"清·李绿园《歧路灯》第66回"},"example":{"text":"～，能屈能伸，这又算得什么。"},"usage":"作主语、宾语、定语；指男人"},{"id":32155,"word":"男室女家","pinyin":"nán shì nǚ jiā","abbr":"nsnj","explanation":"指儿女成家","source":{"text":"男室女家，大伦攸系，天长地久，乐意相关。","book":"明·汪廷讷《狮吼记·赠妾》"},"similar":["男婚女聘","男婚女嫁"],"usage":"作宾语、定语；指儿女成家"},{"id":32156,"word":"男尊女卑","pinyin":"nán zūn nǚ bēi","abbr":"nznb","explanation":"尊：地位高；卑：低下。在封建社会里男子地位高，女子地位卑下。这是重男轻女的不平等封建礼教。","source":{"text":"男女之别，男尊女卑，故以男为贵。","book":"《列子·天瑞》"},"example":{"text":"虽不曾夫贵妻荣，我只知是～。","book":"元·无名氏《举案齐眉》第三折"},"similar":["重男轻女"],"opposite":["阴盛阳衰"],"usage":"作定语、补语；指男女地位"},{"id":32157,"word":"男才女貌","pinyin":"nán cái nǚ mào","abbr":"ncnm","explanation":"男人有才能，女人相貌美，是理想的一对。","example":{"text":"你们真是～的一对。"},"similar":["郎才女貌"],"usage":"作宾语、定语；用于赞美新婚"},{"id":32158,"word":"男扮女妆","pinyin":"nán bàn nǚ zhuāng","abbr":"nbnz","explanation":"男人打扮成女人。","source":{"text":"乔太守见说男扮为女，甚以为奇，乃道：‘男扮女妆，自然有异。难道你认他不出？’","book":"明·冯梦龙《醒世恒言》卷八"},"example":{"text":"那态度神情，也不像什么～，竟是逼真的一个大家闺秀！","book":"清·张春帆《九尾龟》第一百四十七回"},"similar":["男扮女装"],"opposite":["女扮男装"],"usage":"作谓语、宾语、定语；指乔装打扮"},{"id":32159,"word":"男扮女装","pinyin":"nán bàn nǚ zhuāng","abbr":"nbnz","explanation":"男人打扮成女人。","source":{"text":"缺盐少米的穷苦人，独子也要抓丁。男扮女装也没得用呵。","book":"金敬迈《欧阳海之歌》第一章"},"example":{"text":"金敬迈《欧阳海之歌》第一章：“缺盐少米的穷苦人，独子也要抓丁。～也没得用呵。”"},"similar":["男扮女妆"],"opposite":["女扮男装"],"usage":"作谓语、宾语、定语；指乔装打扮"},{"id":32160,"word":"男来女往","pinyin":"nán lái nǚ wǎng","abbr":"nlnw","explanation":"指男女双方交往密切。也形容热闹场所人来人往。","source":{"text":"突厥与宇文，男来女往，必当以影响。","book":"《北齐书·王纮传》"}},{"id":32161,"word":"男欢女爱","pinyin":"nán huān nǚ ài","abbr":"nhna","explanation":"男女亲昵欢爱之词。","source":{"text":"男懽智倾愚，女爱衰避妍。","book":"晋·陆机《塘上行》"},"example":{"text":"这般会合，那些个～，是偶然一念之差。","book":"明·冯梦龙《警世通言》卷三十五"},"similar":["柔情蜜意","情意绵绵"],"opposite":["争风吃醋"],"usage":"作宾语、定语；指男女性爱"},{"id":32162,"word":"男男女女","pinyin":"nán nán nǚ nǚ","abbr":"nnnn","explanation":"男女混杂的一群人。","source":{"text":"这日月台丹樨仪门外，若大若小，男男女女，挨肩擦背，屁都挤将出来。","book":"清·褚人获《隋唐演义》第四回"},"example":{"text":"电影院里早已挤满许多～。"},"usage":"作宾语、定语；指很多人"},{"id":32163,"word":"男盗女娼","pinyin":"nán dào nǚ chāng","abbr":"ndnc","explanation":"男做盗贼，女为娼妓。形容男女都做坏事或思想极其腐朽卑劣。","source":{"text":"男盗女娼，灭门绝户，日后之报。","book":"明·谢谠《四喜记·天佑阴功》"},"example":{"text":"口上仁义礼智，心里～。","book":"鲁迅《坟·论“他妈的！”》"},"similar":["狗彘不知","行同狗彘"],"opposite":["正人君子"],"usage":"作谓语、宾语、定语；指坏人"},{"id":32164,"word":"男耕女织","pinyin":"nán gēng nǚ zhī","abbr":"ngnz","explanation":"封建社会中的小农经济，一家一户经营，男的种田，女的织布。指全家分工劳动。","source":{"text":"女织男耕，桑麻满圃。","book":"明·赵弼《青城隐者记》"},"example":{"text":"蓟州郝氏，七世同居，食指千计，～，家法严整，士子读书应考，入学中举人，不赴礼部试，恐入仕也。","book":"清·陈康褀《郎潜纪闻》"},"similar":["勤劳致富","安居乐业","怡然自得"],"opposite":["男盗女娼","无所事事"],"usage":"作主语、定语、宾语；形容辛勤劳动"},{"id":32165,"word":"男耕妇织","pinyin":"nán gēng fù zhī","abbr":"ngfz","explanation":"男的耕田，女的织布。形容辛勤劳动或自给自足的小农家庭生活。","example":{"text":"她幻想回到～的原始生活。"},"similar":["男耕女织"],"usage":"作宾语、定语；形容辛勤劳动"},{"id":32166,"word":"画一之法","pinyin":"huà yī zhī fǎ","abbr":"hyzf","explanation":"指全体遵行、无一例外的法令政策。","source":{"text":"太叔致猛政之褒，国子流遗爱之娣，宣孟改冬日之和，平阳循画一之法。","book":"《后汉书·王充王符等传论》"},"example":{"text":"苟且之令行，～废，月增日长，雄唱雌和。","book":"唐·杜牧《为中书门下请追尊号表》"},"usage":"作宾语；用于处事"},{"id":32167,"word":"画中有诗","pinyin":"huà zhōng yǒu shī","abbr":"hzys","explanation":"指画里富有诗意。","source":{"text":"味摩诘之诗，诗中有画；观摩诘之画，画中有诗。","book":"宋·苏轼《书摩诘〈蓝田烟雨图〉》"},"example":{"text":"昔日谓诗中有画、～者，盖画手能状，而诗人能言之。","book":"宋·胡仔《苕溪渔隐丛话前集·六一居士》"},"similar":["诗情画意"],"opposite":["诗中有画"],"usage":"作主语、宾语；用于绘画等"},{"id":32168,"word":"画卵雕薪","pinyin":"huà luǎn diāo xīn","abbr":"hldx","explanation":"在鸡蛋、薪木上雕画图形。是古代富豪生活穷奢极侈的一种表现。","source":{"text":"在鸡蛋、薪木上雕画图形。是古代富豪生活穷奢极侈的一种表现。"},"example":{"text":"北魏·杨衒之《洛阳伽蓝记·法云寺》：“晋室石崇乃是庶姓，犹能雉头狐腋，画卵雕薪，况我大魏天王，不为华侈？”"},"usage":"作谓语、定语、宾语；用于生活等"},{"id":32169,"word":"画土分疆","pinyin":"huà tǔ fēn jiāng","abbr":"htfj","explanation":"指划分疆域而治。","source":{"text":"高光崛起，李赵彷徨，魏晋盗窃，秦隋强梁，偏安割据，画土分疆，无所拘滞，安所纷扰哉。","book":"清·鲁一同《正统论》"},"similar":["画野分疆"],"usage":"作宾语、定语；用于书面语"},{"id":32170,"word":"画地为牢","pinyin":"huà dì wéi láo","abbr":"hdwl","explanation":"在地上画一个圈当做监狱。比喻只许在指定的范围内活动。","source":{"text":"故士有画地为牢，势不可入，削木为吏，议不可对，定计于鲜也。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"这一封号，虽是几根柳森片门户，一张红纸的封条，法令所在，也同～，再没人敢任意行动。","book":"清·文康《儿女英雄传》第三十四回"},"similar":["作茧自缚","画地为狱"],"opposite":["任其驰骋","豪放不羁"],"usage":"作谓语、宾语；比喻只许在指定的范围内活动","story":["西汉时期，李陵战败投降了匈奴，汉武帝十分生气。司马迁则认为李陵曾经杀得匈奴人连救死扶伤都来不及，被迫投降是情有可原。汉武帝对司马迁施行“腐刑”。司马迁虽然画地为牢，身陷囹圄，但他艰苦顽强地完成《史记》这部巨著"]},{"id":32171,"word":"画地为牢，议不入","pinyin":"huà dì wéi láo，yì bù rù","abbr":"hdwlybr","explanation":"议：议论。在地上画个圆圈当作牢狱，人们议论着不敢进入。形容狱吏的凶残暴虐。","source":{"text":"故士有画地为牢，势不可入；削木为吏，议不可对，定计于鲜也。","book":"西汉·司马迁《报任少卿书》"},"similar":["画地为狱，势不入"],"usage":"作宾语、定语；用于酷吏"},{"id":32172,"word":"画地为狱","pinyin":"huà dì wéi yù","abbr":"hdwy","explanation":"比喻只许在指定的范围内活动。同“画地为牢”。","source":{"text":"故俗语曰：‘画地为狱，议不入；刻木为吏，期不对。’此皆疾吏之风，悲痛之辞也。","book":"《汉书·路温舒传》"},"example":{"text":"关于题材问题，一时曾相当狭隘，而且至今也还有人抱着之样的见解，以为必须直接采自抗战的现实，这可以说是～。","book":"郭沫若《沸羹集·抗点球以来的文艺思潮》"},"similar":["画地为牢","划地为牢","画地成牢"],"usage":"作谓语、宾语；用于处事"},{"id":32173,"word":"画地为狱，势不入","pinyin":"huà dì wéi yù，shì bù rù","abbr":"hdwysbr","explanation":"势：情势。在地上画个圆圈当作牢狱，人们议论着不敢进入。形容狱吏的凶残暴虐。","source":{"text":"故俗语曰：‘画地为狱，议不入；刻木为吏，期不对。’","book":"东汉·班固《汉书·路温舒传》"},"similar":["画地为牢，议不入"],"usage":"作宾语、定语；用于酷吏"},{"id":32174,"word":"画地作狱","pinyin":"huà dì zuò yù","abbr":"hdzy","explanation":"比喻只许在指定的范围内活动。同“画地为牢”。","source":{"text":"汉·刘向《说苑·贵德》：“俗语云：‘画地作狱，议不可入；刻木为吏，期不对。’此皆疾吏之风，悲痛之辞也。”《汉书·路温舒传》引作“画地为狱”。"},"similar":["画地为狱","画地为牢"],"usage":"作谓语、宾语；用于处事"},{"id":32175,"word":"画地刻木","pinyin":"huà dì kè mù","abbr":"hdkm","explanation":"比喻进监狱，受审讯。","source":{"text":"盖画地刻木，昔人所恶。丛棘既累，于何可闻？","book":"《梁书·王僧儒传》"},"similar":["画地为牢，刻木为吏"],"usage":"作谓语；指十分嫉恨狱吏"},{"id":32176,"word":"画地成图","pinyin":"huà dì chéng tú","abbr":"hdct","explanation":"在地上画出地图，来说明山川河流等地理形势。形容信手拈来，才能出众。","source":{"text":"还谒大将军光，问千秋战斗方略，山川形势。千秋口对兵事，画地成图，无所忘失。","book":"《汉书·张安世传》"},"example":{"text":"武帝尝问汉宫室制度及建章千门万户，华应对如流，听者忘倦，～，左右瞩目。","book":"《晋书·张华传》"},"usage":"作谓语、宾语；指胸有成竹","story":["西汉时期，敬侯张安世的长子张千秋和大将军霍光的儿子霍禹都担任中郎将，一起领兵跟随度辽将军范明友攻打乌桓国得胜回朝。霍光询问千秋战况如何？千秋用树枝在地上画出交战的地形及驻军分布情况，霍光十分佩服"]},{"id":32177,"word":"画地成牢","pinyin":"huà dì chéng láo","abbr":"hdcl","explanation":"比喻只许在限定的范围内活动。同“画地为牢”。","source":{"text":"诗之有皎然、虞伯生，经义之有茅鹿门、汤宾尹、袁了凡，皆画地成牢以陷人者，有死法也。","book":"清·王夫之《薑斋诗话》卷二"},"usage":"作谓语、宾语；用于处事"},{"id":32178,"word":"画地而趋","pinyin":"huà dì ér qū","abbr":"hdeq","explanation":"趋：疾走。只在规定的范围内行动。比喻不知变通。","source":{"text":"殆乎！殆乎！画地而趋。","book":"《庄子·人世间》"},"similar":["画地为牢"],"usage":"作谓语、定语；比喻不知变通"},{"id":32179,"word":"画地自限","pinyin":"huà dì zì xiàn","abbr":"hdzx","explanation":"比喻自己束缚自己。"},{"id":32180,"word":"画影图形","pinyin":"huà yǐ tú xíng","abbr":"hytx","explanation":"摹绘人的形象。古代悬赏通辑逃犯，画其面影，张贴各处已便捕捉。","source":{"text":"奉上司明文，遍张文榜，画影图形，十家为甲，排门粉壁，各自挨捕。","book":"元·施惠《幽闺记·图形追捕》"},"example":{"text":"天平悉从其计，～，访拿伍员，各关隘十分紧急。","book":"明·冯梦龙《东周列国志》第七十二回"},"similar":["图形画影"],"usage":"作宾语、定语；古时用于悬赏缉捕逃犯","story":["春秋时期，楚平王听信费无忌的谗言，霸占太子建的妻子孟赢，把太子建发配到边疆，拘捕太子建的师父伍奢，同时诱捕伍奢的两个儿子，伍尚被抓，伍员则趁机逃走。为了斩草除根，费无忌叫画师画出伍子胥的头像在国内通缉"]},{"id":32181,"word":"画意诗情","pinyin":"huà yì shī qíng","abbr":"hysq","explanation":"像诗画里所描摩的能给人以美感的意境。","source":{"text":"诗情画意，只在阑杆外，雨露天低生爽气，一片吴山越水。","book":"宋·周密《清平乐·横玉亭秋倚》词"},"example":{"text":"杭州是历史上的名都，西湖更为古今中外所称道；～，差不多俯拾即是。","book":"朱自清《燕知草序》"},"similar":["诗情画意"],"usage":"作主语、宾语、定语；用于文章等"},{"id":32182,"word":"画栋朱帘","pinyin":"huà dòng zhū lián","abbr":"hdzl","explanation":"彩色的屋梁，红色的朱帘。形容雍荣华贵的建筑物。","source":{"text":"画栋朝飞南浦云，朱帘暮卷西山雨。","book":"唐·王勃《滕王阁序》"}},{"id":32183,"word":"画栋雕梁","pinyin":"huà dòng diāo liáng","abbr":"hddl","explanation":"指有彩绘装饰的十分华丽的房屋。","source":{"text":"光闪闪贝阙珠宫，齐臻臻碧瓦朱甍，宽绰绰罗帏绣成栊，郁巍巍画梁雕栋。","book":"元·王子一《误入桃源》第二折"},"example":{"text":"各处尽是～，珠帘绮户，那派艳丽光景，竟是别有洞天。","book":"清·李汝珍《镜花缘》第九十八回"},"similar":["雕梁画栋","画梁雕栋"],"usage":"作宾语；形容建筑物富丽堂皇"},{"id":32184,"word":"画栋飞甍","pinyin":"huà dòng fēi méng","abbr":"hdfm","explanation":"有彩绘装饰的屋梁，高耸的屋脊。形容建筑物富丽堂皇。","source":{"text":"汪大尹看这子孙堂，也是三间大殿，雕梁绣柱，画栋飞甍，金碧耀目。","book":"《醒世恒言·汪大尹火焚宝莲寺》"},"similar":["画梁雕栋"],"usage":"作定语；用于建筑"},{"id":32185,"word":"画梁雕栋","pinyin":"huà liáng diāo dòng","abbr":"hldd","explanation":"指有彩绘装饰的十分华丽的房屋。","source":{"text":"光闪闪贝阙珠宫，齐臻臻碧瓦朱甍，宽绰绰罗帏绣成栊，郁巍巍画梁雕栋。","book":"元·王子一《误入桃源》第二折"},"example":{"text":"清·褚人获《隋唐演义》第三回：“～，珠帘翠箔。堂中罗列，无一非眩目的奇珍。”"},"similar":["雕梁画栋"],"usage":"作谓语、定语；指建筑物"},{"id":32186,"word":"画水镂冰","pinyin":"huà shuǐ lòu bīng","abbr":"hslb","explanation":"在水上作画，在冰上雕刻。比喻劳而无功。","source":{"text":"画水镂冰，与时消释。","book":"汉·桓谭《新论》"},"similar":["画脂镂冰"],"usage":"作宾语、定语；用于处事"},{"id":32187,"word":"画沙印泥","pinyin":"huà shā yìn ní","abbr":"hsyn","explanation":"书法家比喻用笔的方法。","source":{"text":"用笔当如锥画沙，如沙印泥。","book":"唐·褚遂良《论书》"},"usage":"作宾语、定语；用于书画笔法"},{"id":32188,"word":"画沙聚米","pinyin":"huà shā jù mǐ","abbr":"hsjm","explanation":"在沙上画地图，聚米为山谷，指画军事形势，运筹决策。","source":{"text":"[余]与之规舆图，讲战守，画沙聚米，方略井然。","book":"清·钱谦益《李秀东六十寿序》"},"example":{"text":"一旦有事，则举国之人，胸有成竹，不难驾轻就熟，乘胜长驱，道里关山，～。","book":"郑观应《盛世危言·游历》"},"usage":"作宾语、定语；用于军事等"},{"id":32189,"word":"画瓦书符","pinyin":"huà wǎ shū fú","abbr":"hwsf","explanation":"旧时迷信，在瓦上画图像，在黄表纸上画符箓，所说可以驱鬼避邪。泛指各种迷信活动。","source":{"text":"旧时迷信，在瓦上画图像，在黄表纸上画符箓，所说可以驱鬼避邪。泛指各种迷信活动。"}},{"id":32190,"word":"画瓶盛粪","pinyin":"huà píng chéng fèn","abbr":"hpsf","explanation":"佛教用语，比喻人身是幻相，是诸多苦难的集合。","source":{"text":"九苦为关键，如画瓶盛粪。","book":"《菩萨处胎经》卷一"}},{"id":32191,"word":"画疆墨守","pinyin":"huà jiāng mò shǒu","abbr":"hjms","explanation":"比喻树立门户或固守门户之见。","source":{"text":"唐初比偶……继以李杜代兴，杯酒论文，雅称同调，而李不袭杜，杜不谋李，未尝党同伐异，画疆墨守。","book":"清·王夫之《姜斋诗话》卷二"},"similar":["画疆自守"],"usage":"作谓语、定语、宾语；用于处事"},{"id":32192,"word":"画疆自守","pinyin":"huà jiāng zì shǒu","abbr":"hjzs","explanation":"画：划分；疆：区域。在划定的管辖区域内自行驻守。","source":{"text":"在统一未成之前，四派各画疆自守。","book":"孙中山《和平统一之通电》"},"similar":["画疆墨守"],"usage":"作谓语、定语、宾语；用于处事"},{"id":32193,"word":"画眉举案","pinyin":"huà méi jǔ àn","abbr":"hmja","explanation":"画眉：指汉张敞为妻画眉毛的故事；举案：指汉朝孟光为夫送饭的故事。比喻夫妻互敬互爱。","source":{"text":"（敞）又为妇画眉，长安中传张京兆眉怃。有司以奏敞。上问之，对曰：‘臣闻闺房之内，夫妇之私，有过于画眉者。’","book":"《汉书·张敞传》"},"example":{"text":"奏晋交欢，喜兰闺芳质，玉堂名彦，看瑟调琴弄，～。","book":"明·杨珽《龙膏记·错媾》"},"usage":"作宾语、定语；用于夫妻间","story":["汉朝时张敞身为高官仍坚持每天为妻子画眉毛。东汉书生梁鸿与孟光结婚，婚后他们抛弃孟家的富裕生活，到霸陵山区隐居，后来帮皋伯通打短工。每次孟光给梁鸿送饭时把托盘举得跟眉毛一样高，眉来眼去，夫妻十分恩爱"]},{"id":32194,"word":"画眉张敞","pinyin":"huà méi zhāng chǎng","abbr":"hmzc","explanation":"泛指对妻子多情的男子。","source":{"text":"（敞）又为妇画眉，长安中传张京兆眉怃。有司以奏敞。上问之，对曰：‘臣闻闺房之内，夫妇之私，有过于画眉者。’","book":"《汉书·张敞传》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第16回：“两个是傅粉何郎，两个是～。”"},"similar":["张敞画眉"],"usage":"作宾语、定语；指夫妻恩爱"},{"id":32195,"word":"画符念咒","pinyin":"huà fú niàn zhòu","abbr":"hfnz","explanation":"道士画符箓、念咒语。比喻写字、念书今人难以索解。","source":{"text":"两千多年中国道士的画符念咒，保持象形文字，垄断着知识，这是‘民可使由之，不可使知之’的绝妙工具。","book":"瞿秋白《乱弹·哑巴文学》"},"example":{"text":"医生的处方字都像～一般难懂。"},"usage":"作谓语、定语、宾语；指迷信活动"},{"id":32196,"word":"画策设谋","pinyin":"huà cè shè móu","abbr":"hcsm","explanation":"筹划办法，图谋计策。","source":{"text":"凤姨见有功效，一发贴心贴意，替他画策设谋。","book":"清·夏敬渠《野叟曝言》第二十六回"},"similar":["出谋划策"],"usage":"作谓语、宾语；用于书面语"},{"id":32197,"word":"画脂镂冰","pinyin":"huà zhī lòu bīng","abbr":"hzlb","explanation":"镂：雕刻。在油脂上绘画，在冰上雕刻。比喻劳而无功。","source":{"text":"故内无其质，而外学其文，虽有贤师良友，若画脂镂冰，费日损功。","book":"汉·桓宽《盐铁论·殊路》"},"example":{"text":"非若前世一偏一曲之士，～，角无用之空文，徒为耳目之观者也。","book":"宋·孙觌《鸿庆居士集·樵居集序》"},"similar":["徒劳无功"],"usage":"作谓语；比喻徒劳无功"},{"id":32198,"word":"画苑冠冕","pinyin":"huà yàun guān miǎn","abbr":"hygm","explanation":"苑：会聚的地方，多指学术、艺术的集中处；冠冕：皇冠帝冕，比喻第一。在美术界占据第一流的地位。"},{"id":32199,"word":"画若鸿沟","pinyin":"huà ruò hóng gōu","abbr":"hrhg","explanation":"画：划分；鸿沟：古汴水支流。比喻界限分明。","source":{"text":"汉王复使侯公往说项王，项王乃与汉约，中分天下，割鸿沟以西为汉，鸿沟而东者为楚。","book":"《史记·项羽本纪》"},"example":{"text":"一旦有事，则举国之人，胸有成竹，不难驾轻就熟，乘胜长驱，道里关山，～。","book":"郑观应《盛世危言·游历》"}},{"id":32200,"word":"画荻丸熊","pinyin":"huà dí wán xióng","abbr":"hdwx","explanation":"用以称赞母亲教子有方。","source":{"text":"抑思善相夫者，何必尽识鹿车鸿案？善教子者，岂皆熟记画荻和丸？","book":"宋·欧阳修幼时，母郑氏以荻画地教子读书。唐·柳仲郢幼嗜学，母韩氏用熊胆和制丸子，使郢夜咀咽以提神醒脑。清·章学诚《文史通义·古文十弊》"},"similar":["画荻和丸"],"usage":"作宾语、定语；指称赞母亲教子有方","story":["宋代文学家欧阳修年幼时，因家里十分贫穷不能上学读书，他的母亲用芦苇杆在沙地上写写画画，教他认字读书。唐朝柳仲郢年幼时刻苦读书，他的母亲用熊胆制成丸子，让柳仲郢夜间含在嘴里以提神醒脑，努力读书，终于学有所成"]},{"id":32201,"word":"画荻和丸","pinyin":"huà dí huò wán","abbr":"hdhw","explanation":"用以称赞母亲教子有方。同“画荻丸熊”。","source":{"text":"但要写母爱，在儿女小的时候容易表现，如推干就湿、画荻和丸之类，都是儿女小时的事。","book":"宋·欧阳修幼时，母郑氏以荻画地教子读书。唐·柳仲郢幼嗜学，母韩氏用熊胆和制丸子，使郢夜咀咽以提神醒脑。郭沫若《虎符》附录《写作缘起》"},"similar":["画荻丸熊"],"usage":"作宾语、定语；指称赞母亲教子有方"},{"id":32202,"word":"画荻教子","pinyin":"huà dí jiào zǐ","abbr":"hdjz","explanation":"荻：芦苇。用芦苇在地上书画教育儿子读书。用以称赞母亲教子有方。","source":{"text":"家贫，至以荻画地学书。","book":"元·脱脱《宋史·欧阳修传》"},"example":{"text":"欧阳修母亲～的故事让人深受感动。"},"usage":"作谓语、定语；指教子有方","story":["北宋时期，欧阳修4岁时就没有了父亲，全靠母亲一人维持生计。因为家贫买不起文具，他母亲就在家里挖了一个大坑铺满沙子，把沙铺平，用一根荻草代替笔在沙上写字，然后叫欧阳修识字，手把手地叫他如何写字"]},{"id":32203,"word":"画虎不成","pinyin":"huà hǔ bù chéng","abbr":"hhbc","explanation":"比喻好高骛远，一无所成，反贻笑柄。","source":{"text":"所谓刻鹄不成尚类鹜者；效杜季良而不成，陷为天下轻薄子，所谓画虎不成反类狗也。","book":"东汉·班固《东观汉记》"},"example":{"text":"有临摹而妙者，若合符节也。有临摹而拙者，～也。","book":"清·陆时化《书画说铃》"},"similar":["不伦不类","弄巧成拙","一事无成"],"opposite":["惟妙惟肖"],"usage":"作谓语、定语；指眼高手低","story":["东汉初年伏波将军马援对子侄后辈教育十分严格，希望他们成为有用的人才。他不喜欢侄子马严和马敦在别人后面说长道短，他写信《诫兄子严敦书》告诫他们，让他们学杜季良、龙伯高。如果学不成就像画不成老虎反而画得像一头狗一样"]},{"id":32204,"word":"画虎不成反类犬","pinyin":"huà hǔ bù chéng fǎn lèi quǎn","abbr":"hhbcflq","explanation":"比喻模仿不到家，反而不伦不类。同“画虎不成反类狗”。","source":{"text":"如君懋《隋书》，虽欲祖述商周，宪章虞夏，观其所述乃似《孔子家语》、临川《世说》，可谓画虎不成反类犬也。","book":"唐·刘知幾《史通·六家》"},"similar":["画虎不成反类狗"],"usage":"作谓语、定语、宾语；比喻好高骛远，眼高手"},{"id":32205,"word":"画虎不成反类狗","pinyin":"huà hǔ bù chéng fǎn lèi gǒu","abbr":"hhbcflg","explanation":"类：象。画老虎不成，却象狗。比喻模仿不到家，反而不伦不类。","source":{"text":"效季良不得，陷为天下轻薄子，所谓画虎不成反类狗也。","book":"《后汉书·马援传》"},"example":{"text":"教便也容易，只是你等无力量，使不得我们的兵器，恐学之不精，如“～”也。","book":"明·吴承恩《西游记》第八十八回"},"similar":["画虎类犬","画虎类狗","画虎刻鹄"],"opposite":["神肖酷似"],"usage":"作谓语、定语；比喻好高骛远，眼高手低","story":["东汉初年伏波将军马援对子侄后辈教育十分严格，希望他们成为有用的人才。他不喜欢侄子马严和马敦在别人后面说长道短，他写信《诫兄子严敦书》告诫他们，让他们学杜季良、龙伯高。如果学不成就像画不成老虎反而画得像一头狗一样"]},{"id":32206,"word":"画虎刻鹄","pinyin":"huà hǔ kè hú","abbr":"hhkg","explanation":"①比喻好高鹜远，终无成就。②比喻好事做不成，反变了坏事。","source":{"text":"与兄子严敦书曰：‘学龙伯高不就，犹为谨饬之士，所谓刻鹄不成尚类鹜者。效杜季良而不成，陷为天下轻薄子，所谓画虎不成反类狗也。’","book":"《东观汉记·马援传》"},"example":{"text":"那怪既神通广大，变得与你相同……我徒弟有手段，决不敢轻动干戈。倘被多官拿住，说我们欺邦灭国，问一款大逆之罪，困陷城中，却不是～也？","book":"《西游记》第三七回"},"similar":["画龙刻鹄"],"usage":"作宾语、定语；用于处事"},{"id":32207,"word":"画虎成狗","pinyin":"huà hǔ chéng gǒu","abbr":"hhcg","explanation":"画老虎不成，却成了狗。比喻模仿不到家，反而不伦不类。","source":{"text":"效季良不得，陷为天下轻薄子，所谓画虎不成反类狗也。","book":"《后汉书·马援传》"},"example":{"text":"身已许君，复何吝惜，但恐～，致贻污谤。","book":"清·蒲松龄《聊斋志异·胭脂》"},"similar":["画虎不成反类狗"],"usage":"作宾语、定语；指模仿不到家","story":["东汉初年伏波将军马援对子侄后辈教育十分严格，希望他们成为有用的人才。他不喜欢侄子马严和马敦在别人后面说长道短，他写信《诫兄子严敦书》告诫他们，让他们学杜季良、龙伯高。如果学不成就像画不成老虎反而画得像一头狗一样"]},{"id":32208,"word":"画虎画皮难画骨","pinyin":"huà hǔ huà pí nán huà gǔ","abbr":"hhhpnhg","explanation":"比喻认识一个人容易，了解一个人的内心却难。","source":{"text":"今日薛婆本是个不善之人，一般甜言软语，三巧儿遂与他成了至交，时刻少他不得。正是：画虎画皮难画骨，知人知面不知心。","book":"明·冯梦龙《喻世明言》第一卷"},"example":{"text":"俗语说得好：～，知人知面不知心。","book":"清·张春帆《九尾龟》第一百八十六回"},"similar":["知人知面不知心"],"usage":"作宾语、定语；用于口语"},{"id":32209,"word":"画虎类犬","pinyin":"huà hǔ lèi quǎn","abbr":"hhlq","explanation":"类：象。画老虎不成，却象狗。比喻模仿不到家，反而不伦不类。","source":{"text":"效季良不得，陷为天下轻薄子，所谓画虎不成反类狗也。","book":"《后汉书·马援传》"},"example":{"text":"端福不甚聪明，恐～。","book":"清·李绿园《歧路灯》第十一回"},"similar":["东施效颦","不伦不类","画虎不成"],"opposite":["神肖酷似"],"usage":"作谓语、定语；指模仿不到家","story":["东汉初年伏波将军马援对子侄后辈教育十分严格，希望他们成为有用的人才。他不喜欢侄子马严和马敦在别人后面说长道短，他写信《诫兄子严敦书》告诫他们，让他们学杜季良、龙伯高。如果学不成就像画不成老虎反而画得像一头狗一样"]},{"id":32210,"word":"画虎类狗","pinyin":"huà hǔ lèi gǒu","abbr":"hhlg","explanation":"类：象。画老虎不成，却象狗。比喻模仿不到家，反而不伦不类。","source":{"text":"效季良不得，陷为天下轻薄子，所谓画虎不成反类狗也。","book":"《后汉书·马援传》"},"example":{"text":"抄袭别人的东西，容易文不对题，会闹出～的笑话。"},"similar":["画虎不成反类狗","画虎类犬"],"usage":"作谓语、定语；指模仿不到家","story":["东汉初年伏波将军马援对子侄后辈教育十分严格，希望他们成为有用的人才。他不喜欢侄子马严和马敦在别人后面说长道短，他写信《诫兄子严敦书》告诫他们，让他们学杜季良、龙伯高。如果学不成就像画不成老虎反而画得像一头狗一样"]},{"id":32211,"word":"画蚓涂鸦","pinyin":"huà yǐn tú yā","abbr":"hyty","explanation":"形容书法或文字拙劣。多用作谦词。","source":{"text":"顾余不敏，操无用之学，徒以空文出应时须，画蚓涂鸦，日不暇给。","book":"明·宋濂《赠会稽韩伯时序》"},"example":{"text":"清·韩邦庆《海上花列传》第49回：“一张收据，上面写的～，不成字体。”"},"usage":"作宾语、定语；用于作品或自谦"},{"id":32212,"word":"画蛇添足","pinyin":"huà shé tiān zú","abbr":"hstz","explanation":"画蛇时给蛇添上脚。比喻做了多余的事，非但无益，反而不合适。也比喻虚构事实，无中生有。","source":{"text":"《战国策·齐策二》：“蛇固无足，子安能为之足？” 明·施耐庵《水浒全传》第一百十回：“将军功绩已成，威声大震，可以止矣。今若前进，倘不如意，正如‘画蛇添足’也。”。"},"example":{"text":"这也是一则事实，并非做书的人～，为此奇谈。","book":"《花月痕》第五一回"},"similar":["徒劳无功","多此一举","弄巧成拙"],"opposite":["画龙点睛","恰到好处","恰如其分"],"usage":"作宾语、定语；指多余的事","story":["楚国有个专管祭祀的官员，春祭以后倒一杯酒给手下人，因人多酒少不够分，就想出谁先画好蛇就喝酒的办法，有一个人第一个把蛇画好了，见其他人还没有画完，就在已画好的蛇上加了两只脚，让人啼笑皆非"]},{"id":32213,"word":"画蛇著足","pinyin":"huà shé zhuó zú","abbr":"hszz","explanation":"比喻做了多余的事，非但无益，反而不合适。同“画蛇添足”。","source":{"text":"画蛇著足无处用，两鬓雪白趋埃尘。","book":"唐·韩愈《感春》诗之四"},"similar":["画蛇添足"],"usage":"作宾语、定语；指多余的事"},{"id":32214,"word":"画角描头","pinyin":"huà jiǎo miáo tóu","abbr":"hjmt","explanation":"刻意描绘，使轮廓或形象分明。多指绘画或写作刻意模仿，毫无新意。","source":{"text":"阮亭之意，必欲其描头画角若明七子，而后谓之窥盛唐乎？","book":"清·袁枚《随园诗话》卷三"},"example":{"text":"绝无～态，自有回肠荡气文。","book":"清·王韬《淞滨琐话·瑶台小咏上》"}},{"id":32215,"word":"画里真真","pinyin":"huà lǐ zhēn zhēn","abbr":"hlzz","explanation":"真真：女子名。比喻不切实际的空想或根本实现不了的幻想。","source":{"text":"唐·杜荀鹤《松窗杂记》载"}},{"id":32216,"word":"画野分疆","pinyin":"huà yě fēn jiāng","abbr":"hyfj","explanation":"指划分疆域而治。","source":{"text":"仍请画野分疆，永敦邻好。","book":"《周书·杜杲传》"},"example":{"text":"愚以为当今之要，莫如量其远近，分置王国，均其产邑，强弱相济，～，不得过大。","book":"《通典·职官十三》"},"similar":["画土分疆"],"usage":"作宾语、定语；用于书面语"},{"id":32217,"word":"画阁朱楼","pinyin":"huà gé zhū lóu","abbr":"hgzl","explanation":"彩绘装饰的楼阁。形容精巧豪华的建筑。","source":{"text":"我和你意相投，便住在草团中也胜似画阁朱楼。","book":"明·康海《王兰卿》第一折"},"usage":"作宾语、定语；用于建筑物"},{"id":32218,"word":"画饼充饥","pinyin":"huà bǐng chōng jī","abbr":"hbcj","explanation":"画个饼来解除饥饿。比喻用空想来安慰自己。","source":{"text":"选举莫取有名，名如画地作饼，不可啖也。","book":"《三国志·魏志·卢毓传》"},"example":{"text":"小生待～，小姐似望梅止渴。","book":"明·汤显祖《牡丹亭》第十六出"},"similar":["望梅止渴","无济于事"],"opposite":["名副其实"],"usage":"作主语、谓语、宾语；指用空想来安慰","story":["曹操的孙子曹睿当上皇帝后急于找一个“中书郎”，让大臣卢毓推荐一个真有本事的人，并告诫他推荐人才不能只看名声，名声就像画在地上的一张饼，饥饿时不能吃。卢毓经过仔细挑选为曹睿选中中书郎"]},{"id":32219,"word":"画鬼容易画人难","pinyin":"huà guǐ róng yì huà rén nán","abbr":"hgryhrn","explanation":"比喻凭空瞎说很容易，但是要想有真才实学却需下一番功夫才能获得。","source":{"text":"画鬼容易画人难。","book":"战国·韩·韩非《韩非子·外储说左上》"},"example":{"text":"俗话说：～，人是很难刻画的。"},"usage":"作宾语、定语；指人难刻画","story":["战国时期，齐王想找一个人替自己画一张像，先后找了很多画工都不满意。后来找到齐国最有名的画工画像。画工说他画不好人，只会画别人没有见过的鬼怪。齐王让他画了一张，一会儿他就画出一个面目狰狞的鬼相，齐王感慨画鬼容易画人难"]},{"id":32220,"word":"画龙不成反为狗","pinyin":"huà lóng bù chéng fǎn wéi gǒu","abbr":"hlbcfwg","explanation":"比喻模仿不到家，反而不伦不类。同“画虎不成反类狗”。","source":{"text":"[僖与崔駰]同游太学，习《春秋》。因读吴王夫差时事，僖废书叹曰：‘若是，所谓画龙不成反为狗者。’","book":"《后汉书·儒林传上·孔僖》"},"similar":["画虎不成反类狗"],"usage":"作谓语、定语、宾语；比喻好高骛远，眼高手"},{"id":32221,"word":"画龙刻鹄","pinyin":"huà lóng kè hú","abbr":"hlkg","explanation":"比喻好高鹜远，终无成就。同“画虎刻鹄”。","source":{"text":"东箭南金谁国士，画龙刻鹄半虚名。","book":"清·唐孙华《送吴振西北游》诗"},"similar":["画虎刻鹄"],"usage":"作宾语、定语；用于处事"},{"id":32222,"word":"画龙点晴","pinyin":"huà lóng diǎn jīng","abbr":"hldq","explanation":"比喻写文章或讲话时，在关键处用几句话点明实质，使内容生动有力。","source":{"text":"金陵安乐寺四白龙不点眼睛，每云：‘点睛即飞去。’人以为妄诞，固请点之。须臾，雷电破壁，两龙乘云腾去上天，二龙未点眼者见在。","book":"唐·张彦远《历代名画记·张僧繇》"},"example":{"text":"这～的一笔，有力地表明了主题。"}},{"id":32223,"word":"画龙点睛","pinyin":"huà lóng diǎn jīng","abbr":"hldj","explanation":"原形容梁代画家张僧繇作画的神妙。后多比喻写文章或讲话时，在关键处用几句话点明实质，使内容生动有力。","source":{"text":"金陵安乐寺四白龙不点眼睛，每云：‘点睛即飞去。’人以为妄诞，固请点之。须臾，雷电破壁，两龙乘云腾去上天，二龙未点眼者见在。","book":"唐·张彦远《历代名画记·张僧繇》"},"example":{"text":"这然而一个好题目，却常常对作品有～之妙，激发人们阅读的兴趣。","book":"秦牧《车窗文学欣赏》"},"similar":["锦上添花","点石成金"],"opposite":["弄巧成拙","画蛇添足","点金成铁"],"usage":"作主语、谓语、定语、状语；用于写文章等","story":["南朝梁代著名书画家张僧繇特别擅长画龙，梁武帝在金陵建安乐寺，让张僧繇在墙上画龙，他画了四条龙栩栩如生，但都没有点眼睛。众人不解，怂恿他点上龙眼，他刚刚点了两条龙的眼睛，顿时闪电四起，两条龙腾空而去"]},{"id":32224,"word":"甿隶之人","pinyin":"méng lì zhī rén","abbr":"mlzr","explanation":"甿：农民。种田耕地的人。旧时也指身份低下的人。","source":{"text":"陈涉，瓮牖绳枢之子，甿隶之人，而迁徙之徒也。","book":"《史记·秦始皇本纪》"}},{"id":32225,"word":"畅叙幽情","pinyin":"chàng xù yōu qíng","abbr":"cxyq","explanation":"尽情地叙谈，把内心深处的感情都表达出来。","source":{"text":"一觞一咏，亦足以畅叙幽情。","book":"晋·五羲之《兰亭集序》"},"similar":["畅叙衷肠"],"opposite":["有苦难言"],"usage":"作谓语；用于交往"},{"id":32226,"word":"畅叫扬疾","pinyin":"chàng jiào yáng jí","abbr":"cjyj","explanation":"指大吵大闹。“暢叫”即“唱叫”，吵闹之意。“扬疾”犹嚷唧，亦吵闹之意。","source":{"text":"可笑愚痴，不辨个高低，畅叫扬疾。","book":"元·杨暹《刘行首》第四折"},"example":{"text":"我可也不和你～，谁共你磕牙抖嘴。","book":"元·关汉卿《陈母教子》第三折"},"similar":["大吵大闹"],"usage":"作谓语、宾语；指大吵大闹"},{"id":32227,"word":"畅所欲为","pinyin":"chàng suǒ yù wéi","abbr":"csyw","explanation":"痛痛快快地做想做的事。","source":{"text":"使之生于贵族，早历宦途，畅所欲为，更不知作何竖立。","book":"清·李渔《奈何天·总评》"},"example":{"text":"郡守贵福并赠瑾对联一，联曰：‘竞争世界，雄冠地球。’瑾于是益得～。","book":"陶成章《浙案纪略·秋瑾传》"},"similar":["畅所欲言"],"usage":"作谓语、宾语；指痛快做事"},{"id":32228,"word":"畅所欲言","pinyin":"chàng suǒ yù yán","abbr":"csyy","explanation":"畅：尽情，痛快。畅快地把要说的话都说出来。","source":{"text":"畅：尽情，痛快。畅快地把要说的话都说出来。"},"example":{"text":"还有一种坏处，是一做教员，未免有顾忌；教授有教授的架子，不能～。","book":"鲁迅《而已集·读书杂谈》"},"similar":["言无不尽","和盘托出"],"opposite":["言不尽意","隐约其辞","吞吞吐吐"],"usage":"作谓语、定语；用于会议上的发言"},{"id":32229,"word":"畅行无碍","pinyin":"chàng xíng wú ài","abbr":"cxwa","explanation":"毫无阻碍地通行或流通。多指事情能顺利地进行。","source":{"text":"即百姓持此钱以完钱粮，亦一例收之，然后免其疑贰，可以畅行而无碍矣。","book":"清·梁章钜《浪迹丛谈·三谈·收铜器议》"}},{"id":32230,"word":"畅行无阻","pinyin":"chàng xíng wú zǔ","abbr":"cxwz","explanation":"毫无阻碍地通行或通过。","source":{"text":"铲除这两方面的祸根，才能使党在团结全党同志和团结全国人民的伟大事业中畅行无阻。","book":"毛泽东《整顿党的作风》"},"example":{"text":"走这条道路可以～。"},"similar":["畅通无阻"],"usage":"作谓语、定语、补语；形容没有阻碍"},{"id":32231,"word":"畅通无阻","pinyin":"chàng tōng wú zǔ","abbr":"ctwz","explanation":"毫无阻碍地通行或通过。","source":{"text":"打通了安合公路，使北路的进军畅通无阻。","book":"郭沫若《洪波曲》第九章"},"example":{"text":"取消路卡收费，路面交通～。"},"similar":["畅行无碍"],"opposite":["寸步难行"],"usage":"作谓语、定语、状语；形容没有阻碍"},{"id":32232,"word":"畎亩下才","pinyin":"quǎn mǔ xià cái","abbr":"qmxc","explanation":"畎亩：田野。比喻平庸之才。","source":{"text":"臣畎亩下才，谬当委任。","book":"《旧唐书·杨收传》"},"example":{"text":"请听取我这～的建议。"},"similar":["无能之辈"],"usage":"作主语、宾语、定语；指无能之辈"},{"id":32233,"word":"畎亩之中","pinyin":"quǎn mǔ zhī zhōng","abbr":"qmzz","explanation":"畎亩：田野。泛指民间。","source":{"text":"后之为人也，居于畎亩之中，而游尧之门。","book":"战国·宋·庄周《庄子·让壬》"},"example":{"text":"他生于～，从小有雄才大略。"},"usage":"作宾语、定语；指乡下"},{"id":32234,"word":"畎亩之忠","pinyin":"quǎn mǔ zhī zhōng","abbr":"qmzz","explanation":"畎亩：田野，借指民间。旧时指百姓对君主所尽的忠诚。","source":{"text":"东迁北陌，尚难忘畎亩之忠，生复何为，死而后已。","book":"宋·朱熹《致仕谢表》"}},{"id":32235,"word":"畏之如虎","pinyin":"wèi zhī rú hǔ","abbr":"wzrh","explanation":"像怕老虎那样畏惧。形容非常害怕。","source":{"text":"有在仕途者，稍拂其意，则以违上命文致其罪，浙人畏之如虎。","book":"宋·龚明之《中吴纪闻·朱氏盛衰》"},"example":{"text":"张飞过于凶狠，部下对他～"},"opposite":["和蔼可亲"],"usage":"作谓语、定语；用于人或事物等"},{"id":32236,"word":"畏刀避剑","pinyin":"wèi dāo bì jiàn","abbr":"wdbj","explanation":"指贪生怕死。","source":{"text":"都是些畏刀避剑的，恁不去出力。","book":"元·马致远《汉宫秋》第二折"},"example":{"text":"姜尚有元帅之名，无元帅之行，～，岂是丈夫所为！","book":"明·许仲琳《封神演义》第七十回"}},{"id":32237,"word":"畏刀避箭","pinyin":"wèi dāo bì jiàn","abbr":"wdbj","explanation":"畏：害怕，畏惧。比喻遇战事退缩不前。","source":{"text":"我养军千日，用军一时。空有满朝文武，那一个与我退的番兵？都是些畏刀避箭的。","book":"元·马致远《汉宫秋》第二折"},"example":{"text":"清·无名氏《刘公案》第76回：“丈夫做事要留名，～非男子。”"},"similar":["隈刀避箭"],"usage":"作谓语、定语；用于书面语"},{"id":32238,"word":"畏口慎事","pinyin":"wèi kǒu shèn shì","abbr":"wkss","explanation":"慎：谨慎。说话谨慎，做事小心。","source":{"text":"近日始畏口慎事，虽已迟，犹胜不悛也。","book":"宋·苏轼《答吴子野书》"},"usage":"作谓语、定语；用于处事"},{"id":32239,"word":"畏天恤民","pinyin":"wèi tiān xù mín","abbr":"wtxm","explanation":"天：上天；恤：救济。敬畏上天，救济下民。古代维护封建统治的伦理观念。","source":{"text":"畏天恤民，本朕躬平日之志，避殿损膳，抑祖宗故事之常。","book":"宋·苏辙《栾城集·第四表许允批答二首》"},"similar":["畏天爱民"],"usage":"作谓语、定语；用于书面语"},{"id":32240,"word":"畏天悯人","pinyin":"wèi tiān mǐn rén","abbr":"wtmr","explanation":"畏：敬畏。敬畏天命，怜悯世人的困苦。","source":{"text":"易之忧患，业业焉，孜孜焉，其畏天悯人，思及时而动乎？","book":"隋·王通《中说·周公》"},"usage":"作谓语、定语；用于书面语"},{"id":32241,"word":"畏天爱民","pinyin":"wèi tiān ài mín","abbr":"wtam","explanation":"天：上天。敬畏上天，爱怜下民。古代维护封建统治的伦理观念。","source":{"text":"天：上天。敬畏上天，爱怜下民。古代维护封建统治的伦理观念。"},"similar":["畏天恤民"],"usage":"作谓语、定语；用于书面语"},{"id":32242,"word":"畏天知命","pinyin":"wèi tiān zhī mìng","abbr":"wtzm","explanation":"畏：敬服；天：上天；命：命运。指顺从天意，按照命运的安排行事。","source":{"text":"彼皆畏天知命，睹存亡之符，见废兴之事。","book":"南朝·宋·范晔《后汉书·冯异传》"},"example":{"text":"夏、殷、周不以谦让者，～也。","book":"《晋书·宣帝纪》"},"similar":["听天由命"],"usage":"作谓语、定语；指人循规蹈矩","story":["新朝末年，冯异投靠刘秀，他十分谦恭，被称为“大树将军”。后任孟津将军，率军与30万大军的舞阳王李轶对峙，他给李轶写信，希望他畏天知命，离开更始帝而投奔刘秀，这样可以转危为安。李轶放弃了抵抗，刘秀称冯异一纸抵万兵"]},{"id":32243,"word":"畏头畏尾","pinyin":"wèi tóu wèi wěi","abbr":"wtww","explanation":"畏：畏惧，害怕。比喻做事胆子小，顾虑多。","source":{"text":"除了朝廷治罪，没有砍头的，你不必畏头畏尾。","book":"清·曹雪芹《红楼梦》第75回"},"similar":["畏首畏尾","瞻前顾后"],"opposite":["无所畏惧","当机立断"],"usage":"作谓语、定语；指人胆子小"},{"id":32244,"word":"畏威怀德","pinyin":"wèi wēi huái dé","abbr":"wwhd","explanation":"怀：思念。畏惧声威，感念德惠。","source":{"text":"民畏其威，而怀其德，莫能勿从。","book":"《国语·晋语八》"},"example":{"text":"虽奉天子明诏来讨不廷，只要～，不是贪取土地，致害生灵。","book":"清·陈忱《水浒后传》第十二回"},"usage":"作谓语、定语；指对人敬而远之"},{"id":32245,"word":"畏强凌弱","pinyin":"wèi qiáng líng ruò","abbr":"wqlr","explanation":"畏：害怕；凌：欺侮。形容欺软怕硬。","source":{"text":"今中外士大夫见惠卿独得不诛，皆谓言事之官有畏强凌弱之心，执政大臣有吐刚茹柔之意。","book":"宋·苏辙《再乞罪吕惠卿状》"},"example":{"text":"苏秦佩六国相印，张仪两次相秦，皆有匡扶人国之谋，非比～，惧刀避剑之人也。","book":"明·罗贯中《三国演义》第四十三回"}},{"id":32246,"word":"畏强欺弱","pinyin":"wèi qiáng qī ruò","abbr":"wqqr","explanation":"害怕强大的，欺负弱小的","source":{"text":"你自己想想，这等畏强欺弱的勾当，便给你报了仇，泄了恨，又有什么体面呢？","book":"清·无垢道人《八仙全传》第11回"},"similar":["欺软怕硬"],"opposite":["不畏强暴"],"usage":"作谓语、定语、宾语；用于处事"},{"id":32247,"word":"畏影恶迹","pinyin":"wèi yǐng è jì","abbr":"wyej","explanation":"比喻为人愚蠢，不明事理。","source":{"text":"人有畏影恶迹而去之走者，举足愈数而迹愈多，走愈疾而影不离身。","book":"《庄子·渔父》"},"similar":["畏影避迹"],"usage":"作谓语、定语；指不明事理"},{"id":32248,"word":"畏影而走","pinyin":"wèi yǐng ér zǒu","abbr":"wyez","explanation":"比喻庸人自扰。亦作“畏影恶迹”。","source":{"text":"人有畏影恶迹而去之走者，举足愈数而迹愈多，走愈疾而影不离身，自以为尚迟，疾走不休，绝力而死，不知处阴以休影，处静以息迹，墨亦甚矣。","book":"《庄子·渔父》"},"similar":["畏影避迹"],"usage":"作谓语、定语；指不明事理"},{"id":32249,"word":"畏影避迹","pinyin":"wèi yǐng bì jì","abbr":"wybj","explanation":"比喻庸人自扰，不明事理。","source":{"text":"人有畏影恶迹而去之走者，举足愈数而迹愈多，走愈疾而影不离身。","book":"先秦·庄周《庄子·渔父》"},"example":{"text":"庄周所谓～，吾弗为也。","book":"《陈书·萧允传》"},"similar":["畏影而走"],"usage":"作谓语、定语；指不明事理"},{"id":32250,"word":"畏敌如虎","pinyin":"wèi dí rú hǔ","abbr":"wdrh","explanation":"害怕敌人如同怕虎一般。","source":{"text":"公畏蜀如虎，奈天下笑何。","book":"《三国志·蜀志·诸葛亮传》裴松之注引《汉晋春秋》卷三十五"},"example":{"text":"领导者们～，处处设防，节节抵御。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["畏之如虎"],"usage":"作谓语、宾语、定语；指怯战"},{"id":32251,"word":"畏死贪生","pinyin":"wèi sǐ tān shēng","abbr":"wsts","explanation":"贪：舍不得。贪恋生存，畏惧死亡。指对敌作战畏缩不前。","source":{"text":"今立自知贼杀中郎曹将，冬月迫促，贪生畏死，即诈僵仆阳（佯）病，徼幸得逾于须臾。","book":"《汉书·文三王传》"},"example":{"text":"似此～，实出臣等意料之外，亦伤圣上知人之明。","book":"二月河《乾隆皇帝》二十五"},"similar":["贪生怕死"],"usage":"作谓语、定语、宾语；指人没有骨气"},{"id":32252,"word":"畏缩不前","pinyin":"wèi suō bù qián","abbr":"wsbq","explanation":"畏惧退缩，不敢前进。","source":{"text":"唐介始弹张尧佐，谏官皆上疏，及弹文彦博，则吴奎畏缩不前，当时谓拽动阵脚。","book":"宋·魏泰《东轩笔录》"},"example":{"text":"尤其是她自己，起先虽然颇有～的心情，此时却已鼓起勇士临阵似的气慨了。","book":"叶圣陶《平常的故事》"},"similar":["望而却步","畏葸不前"],"opposite":["奋勇向前"],"usage":"作谓语、定语；指胆小"},{"id":32253,"word":"畏缩逡巡","pinyin":"wèi suō qūn xún","abbr":"wsqx","explanation":"逡巡：想走又不走，犹豫不决的样子。指因为害怕而不敢向前。","source":{"text":"或鬼持世，乃是逡巡畏缩之象，欲行不行，必怀疑贰。","book":"明·刘基《黄金策·出行》"}},{"id":32254,"word":"畏罪潜逃","pinyin":"wèi zuì qián táo","abbr":"wzqt","explanation":"犯罪后害怕定罪而逃走。","source":{"text":"方士侯生、卢生等骗了始皇几年，畏罪潜逃。","book":"郭沫若《吕不韦与秦王政的批判》"},"example":{"text":"方士侯生、卢生等骗了始皇几年，～。","book":"郭沫若《吕布韦与秦王政的批判》"},"usage":"作谓语、定语；用于处事"},{"id":32255,"word":"畏而爱之","pinyin":"wèi ér ài zhī","abbr":"weaz","explanation":"畏：惧怕。指又怕又爱。","source":{"text":"贤者狎而敬之，畏而爱之。","book":"《左传·襄公三十一年》：“君有君之威仪，其臣畏而爱之，则而象之，故能有其国家，令闻长世。”《礼记·曲礼上》"},"example":{"text":"威惠兼举，宽猛相资，故能～，不严斯治。","book":"《隋书·樊子盖传》"}},{"id":32256,"word":"畏葸不前","pinyin":"wèi xǐ bù qián","abbr":"wxbq","explanation":"畏惧退缩，不敢前进。","source":{"text":"唐介始弹张尧佐，谏官皆上疏，及弹文彦博，则吴奎畏葸不前，当时谓拽动阵前。","book":"宋·魏泰《东轩笔录》"},"example":{"text":"在困难面前～，不是我们的作风。"},"similar":["胆战心惊","望而却步"],"opposite":["无所畏惧","勇往直前"],"usage":"作谓语、宾语、定语；指停滞不前"},{"id":32257,"word":"畏葸退缩","pinyin":"wèi xǐ tuì suō","abbr":"wxts","explanation":"葸：害怕。因为胆怯而后退。","source":{"text":"唐介始弹张尧佐，谏官皆上疏，及弹文彦博，则吴奎畏葸不前，当时谓拽动阵前。","book":"宋·魏泰《东轩笔录》"},"example":{"text":"其二，是终日给以冷遇或呵斥，甚而至于打扑，使他～，仿佛一个奴才，一个傀儡。","book":"鲁迅《南腔北调集·祝〈涛声〉》"}},{"id":32258,"word":"畏难苟安","pinyin":"wèi nán gǒu ān","abbr":"wnga","explanation":"害怕困难，苟且偷安。","source":{"text":"大学士倭仁疏陈黑地升科，州县畏难苟安，请申明赏罚。","book":"《清史稿·食货志二》"},"example":{"text":"郭沫若《反正前后》第一篇：“图大事，成大业者不可～。”"},"usage":"作谓语、定语；用于处事"},{"id":32259,"word":"畏首畏尾","pinyin":"wèi shǒ wèi wěi","abbr":"wsww","explanation":"畏：怕，惧。前也怕，后也怕。比喻做事胆子小，顾虑多。","source":{"text":"畏首畏尾，身其余几？","book":"《左传·文公十七年》"},"example":{"text":"妹子平日但凡遇见吃酒行令，最是高兴，从不～。","book":"清·李汝珍《镜花缘》第八十四回"},"similar":["瞻前顾后","左顾右盼"],"opposite":["无所畏惧","当机立断"],"usage":"作谓语、定语；指人胆子小","story":["春秋时期，郑国出于晋国与楚国之间，晋楚争霸经常打击与拉拢郑国。一次晋灵公召集小国开会，郑穆公没有去，晋灵公想出兵威胁，郑公子归生知道后给晋灵公写信劝止，说：“畏首畏尾，身其余几”，如果被逼无奈就投降楚国，两国和谈"]},{"id":32260,"word":"畔道离经","pinyin":"pàn dào lí jīng","abbr":"pdlj","explanation":"畔：通“叛”，违背。违背道德，脱离经典。指背离常规的思想或行为。","source":{"text":"开人心狙诈之端，启风俗陵傲之习，不至于畔道离经不止。","book":"清·洪深《》序"},"example":{"text":"居恒欲手刃其人，以为～者戒。","book":"陈独秀《孔子之道与现代生活》"},"similar":["离经叛道"],"opposite":["循规蹈矩"],"usage":"作谓语、定语；指违反传统思想和道德规范"},{"id":32261,"word":"留一手","pinyin":"liú yī shǒu","abbr":"lys","explanation":"保留一些本领技能不拿出来。","example":{"text":"请把技术全部传授给我们，不要～。"},"usage":"作谓语、定语、宾语；用于处事"},{"id":32262,"word":"留中不下","pinyin":"liú zhōng bù xià","abbr":"lzbx","explanation":"皇帝把臣下的奏章留在宫禁中，不交议也不批答。","source":{"text":"四月癸未，奏未央宫，留中不下。","book":"《史记·三王世家》"},"example":{"text":"既有言及辅臣之章，亦尽～。","book":"《明史·钱一本传》"},"similar":["留中不发"],"usage":"作谓语、宾语；用于封建文书等"},{"id":32263,"word":"留中不出","pinyin":"liú zhōng bù chū","abbr":"lzbc","explanation":"皇帝把臣下的奏章留在宫禁中，不交议也不批答。","source":{"text":"四月癸未，奏未央宫，留中不下。","book":"《史记·三王世家》"},"example":{"text":"～之请，益发其阴私，公论不容之辞，实生于朋党。","book":"唐·元稹《唐穆宗文惠皇帝戒励风俗德音文》"},"similar":["留中不发","留中不下"],"usage":"作谓语、宾语、定语；用于封建文书等"},{"id":32264,"word":"留中不发","pinyin":"liú zhōng bù fā","abbr":"lzbf","explanation":"皇帝把臣下的奏章留在宫禁中，不交议也不批答。","source":{"text":"四月癸未，奏未央宫，留中不下。","book":"《史记·三王世家》"},"example":{"text":"昔英庙易储，某实有疏谏，～，君他日幸物色之。","book":"清·吴骞《拜经楼诗话》卷三"},"similar":["留中不下","留中不出"],"usage":"作谓语、宾语；用于封建文书等"},{"id":32265,"word":"留余地","pinyin":"liú yú dì","abbr":"lyd","explanation":"不把话说死或不把事办绝，留下进退回旋的地步。","source":{"text":"办事～是他一贯的做法。"},"example":{"text":"办事～是他一贯的做法"},"similar":["留有余地"],"opposite":["不留余地"],"usage":"作谓语、宾语、定语；用于说话与做事"},{"id":32266,"word":"留取丹心照汗青","pinyin":"liú qǔ dān xīn zhào hàn qīng","abbr":"lqdxzhq","explanation":"丹心：赤红的心，比喻忠心；汗青：指历史书册。留取这颗赤胆忠心，永远在史册中放光。","source":{"text":"人生自古谁无死，留取丹心照汗青。","book":"宋·文天祥《过零丁洋》"},"usage":"作宾语、定语；用于为人"},{"id":32267,"word":"留后路","pinyin":"liú hòu lù","abbr":"lhl","explanation":"比喻办事时为防失败而预留退路。","example":{"text":"办事不～是很危险的。"},"similar":["留有余地"],"usage":"作谓语、宾语、定语；用于处事"},{"id":32268,"word":"留尾巴","pinyin":"liú wěi bā","abbr":"lwb","explanation":"比喻事情没有干完，还有问题。","example":{"text":"他做事总是～让别人来收拾。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":32269,"word":"留得青山在不怕没柴烧","pinyin":"liú dé qīng shān zài bù pà méi chái shāo","abbr":"ldqszbpmcs","explanation":"比喻只要还有生命，就有将来和希望。","example":{"text":"虽然这场大火使他的一切都付之一炬，但他相信只要～，他很快就能站起来。"}},{"id":32270,"word":"留得青山在，不怕没柴烧","pinyin":"liú dé qīng shān zài，bù pà méi chái shāo","abbr":"ldqszbpmcs","explanation":"比喻只要还有生命，就有将来和希望。","source":{"text":"留得青山在，不怕没柴烧。虽是遭此大祸，儿子官职还在，只要到得任所，便好了。","book":"明·凌蒙初《初刻拍案惊奇》卷二十二"},"example":{"text":"虽然这场大火使他的一切都付之一炬，但他相信只要～，他很快就能站起来。"},"similar":["留得青山在，不愁没柴烧"],"usage":"作分句；用于劝诫人"},{"id":32271,"word":"留得青山在，不愁没柴烧","pinyin":"liú dé qīng shān zài，bù chóu méi chái shāo","abbr":"ldqszbcmcs","explanation":"比喻只要基础或根本还存在，暂时遭受损失或挫折无伤大体。","source":{"text":"我则道留下青山怕没柴。","book":"元·无名氏《看钱奴》第二折"},"example":{"text":"只得劝母亲道：“～。”","book":"明·凌濛初《初刻拍案惊奇》卷二十二回"},"similar":["留得青山在，不怕没柴烧"],"usage":"作分句；用于劝诫人"},{"id":32272,"word":"留得青山在，依旧有柴烧","pinyin":"liú dé qīng shān zài，yī jiù yǒu chái shāo","abbr":"ldqszyjycs","explanation":"比喻能保留最根本的条件，其他问题就可得到解决。同“留得青山在，不怕没柴烧”。","source":{"text":"身子是根本，俗话说的：‘留得青山在，依旧有柴烧。’","book":"清·曹雪芹《红楼梦》第82回"},"example":{"text":"～，身体是革命的本钱。"},"similar":["留得青山在，不怕没柴烧"],"usage":"作分句；用于劝诫人","story":["林黛玉听薛宝钗的下人说薛家正张罗宝琴的事，心中特别敏感，和衣而睡。在梦中见到南京派人来接她回去结婚，宝玉也催她回去，惊梦醒来就吐鲜血，心里凉了半截。紫鹃在旁边劝她保重身体，留得青山在，依旧有柴烧。黛玉又昏昏躺下做梦"]},{"id":32273,"word":"留恋不舍","pinyin":"liú liàn bù shě","abbr":"llbs","explanation":"依恋着不愿去。形容依依惜别的情貌。","source":{"text":"杨大郎见他爱这粉头，留恋不舍，在旁花言说合，就要娶他家去。","book":"明·兰陵笑笑生《金瓶梅词话》第92回"},"example":{"text":"大家似乎还有点～，但同时又怕撞见了别的男人，只得匆忙地走进公馆去。","book":"巴金《家》"},"similar":["恋恋不舍"],"opposite":["毫不留恋"],"usage":"作谓语、定语、宾语；指依恋"},{"id":32274,"word":"留有余地","pinyin":"liú yǒu yú dì","abbr":"lyyd","explanation":"比喻说话办事留下可以回旋的地方。","source":{"text":"终见乘桴去沧海，好留余地许相依。","book":"宋·王令《寄介甫》"},"example":{"text":"他们显然具有“化大事为小事”的用心，为下一步“打退堂鼓”～。","book":"陶菊隐《北洋军阀统治时期史话》第六十八章"},"similar":["留余地"],"opposite":["不留余地"],"usage":"作谓语、宾语、定语；用于说话与做事"},{"id":32275,"word":"留犊淮南","pinyin":"liú dú huái nán","abbr":"ldhn","explanation":"原指寿春令时苗离开淮南时，将来时带来的黄牛所生的一牛犊留在淮南。后比喻为官清廉。","source":{"text":"居官岁余，牛生一犊。及其去，留其犊，谓主簿曰：‘令来时本无此犊，犊是淮南所生有也。’","book":"《三国志·魏志·常林传》裴松之注引《魏略》"}},{"id":32276,"word":"留芳千古","pinyin":"liú fāng qiān gǔ","abbr":"lfqg","explanation":"一个人在历史上享有声望或给后人留下美好的印象。","source":{"text":"要做几件别古绝今之事，也好留芳千古。","book":"清·贪梦道人《彭公案》第62回"},"example":{"text":"周总理的英名～。"},"similar":["流芳千古","留芳百世"],"usage":"作谓语、定语；用于人的名声及功绩等"},{"id":32277,"word":"留芳百世","pinyin":"liú fāng bǎi shì","abbr":"lfbs","explanation":"美好形象永不磨灭，不会被忘却","example":{"text":"要做到～也不是很难"},"similar":["流芳百世"],"usage":"作谓语、定语、宾语；用于人的名声及功绩等"},{"id":32278,"word":"留落不遇","pinyin":"liú luò bù yù","abbr":"llby","explanation":"遇：碰到。旧指际遇不好，很久得不到提拔。","source":{"text":"然而诸宿将常坐留落不遇。","book":"《史记·卫将军骠骑列传》"}},{"id":32279,"word":"留连不舍","pinyin":"liú lián bù shě","abbr":"llbs","explanation":"依恋着不愿去。形容依依惜别的情貌。同“留恋不舍”。","source":{"text":"杨大郎见他爱这粉头，留连不舍。","book":"明·兰陵笑笑生《金瓶梅词话》第九十二回"}},{"id":32280,"word":"留连忘返","pinyin":"liú lián wàng fǎn","abbr":"llwf","explanation":"形容留恋景物，舍不得回去。","source":{"text":"每游山泽，辄留连忘返。","book":"《南史·刘訏传》"},"example":{"text":"‘吾将向冥王乞请，必遍历所谓刀山剑树，以广见闻’……其妻哂曰：‘虽十八层地狱，尽当奉屈一游，所虑～，不得再见天日，为妻子忧耳。’","book":"和邦额《夜谭随录·新安富人》"},"similar":["流连忘返"],"usage":"作谓语、定语；指十分留恋"},{"id":32281,"word":"留风遗韵","pinyin":"liú fēng yí yùn","abbr":"lfyy","explanation":"韵：风度，气派。前代流传给后世的风雅韵事。","source":{"text":"至于流风余韵，蔼然被于江汉之间者。","book":"宋·欧阳修《岘山亭记》"},"example":{"text":"屈原正是在吴起、商鞅等实行变法的～中长大的。","book":"郭沫若《伟大的爱国诗人——屈原》"}},{"id":32282,"word":"畜妻养子","pinyin":"xù qī yǎng zǐ","abbr":"xqyz","explanation":"畜：养育。旧指维持妻子和儿女的生活。","source":{"text":"必使仰足以事父母，俯足以畜妻子。","book":"《孟子·梁惠王上》"},"example":{"text":"当日纯阳吕祖虑他五百年后不愿质，误了后人，原不曾说道与你置田买产，～，帮做人家的。","book":"明·凌濛初《初刻拍案惊奇》卷十八"},"usage":"作谓语、定语；指承担家庭重担"},{"id":32283,"word":"畜我不卒","pinyin":"xù wǒ bù zú","abbr":"cwbz","explanation":"畜：养育；卒：终。指父母对自己的养育之责没有完成","source":{"text":"日居月诸，东方自出。父兮母兮，畜我不卒。","book":"《诗经·邶风·日月》"},"usage":"作谓语、定语；用于书面语"},{"id":32284,"word":"略不世出","pinyin":"lüè bù shì chū","abbr":"lbsc","explanation":"略：计划，谋略；世：时代。谋略高明，世间少有。","source":{"text":"此所谓功无二于天下，而略不世出者也。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"伏惟圣武英挺，～，科敌制变。","book":"南朝·梁·任昉《奏弹曹景宗》"},"usage":"作谓语、定语；用于夸奖人等"},{"id":32285,"word":"略地侵城","pinyin":"lüè dì qīn chéng","abbr":"ldqc","explanation":"略：侵夺，强取。夺取地盘，攻战城池。指向敌方进攻。","source":{"text":"夫四夷不守境，不过于略地侵城，是有败无亡也。","book":"唐·牛僧孺《守在四夷沦》"},"similar":["略地攻城"],"usage":"作谓语、宾语；指向敌方进攻"},{"id":32286,"word":"略地攻城","pinyin":"lüè dì gōng chéng","abbr":"ldgc","explanation":"略：侵夺，强取。夺取地盘，攻战城池。指向敌方进攻。","source":{"text":"十万伍雄兵飞将，皆能略地攻城。","book":"明·陈汝元《金莲记·焚卷》"},"example":{"text":"明·无名氏《杨家将演义》第四卷：“或有搴旗斩将之勇，或有～之能。”"},"similar":["掠地攻城","略地侵城"],"usage":"作谓语、宾语；指向敌方进攻"},{"id":32287,"word":"略施小计","pinyin":"lüè shī xiǎo jì","abbr":"lsxj","explanation":"略：稍微，粗略。稍微运用小小计谋。","source":{"text":"略施小计鬼神惊，字称吴学究，人号智多星。","book":"明·施耐庵《水浒传》第14回"},"example":{"text":"曾朴《孽海花》第35回：“又利用那班揩鼻子的嫖客们力不胜鸡，胆小如鼠，只要～，无不如愿大来。”"},"usage":"作谓语、宾语；用于处事"},{"id":32288,"word":"略无忌惮","pinyin":"lüè wú jì dàn","abbr":"lwjd","explanation":"毫无畏惧。形容非常放肆。","source":{"text":"小人而无忌惮也。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"出入宫廷，～。","book":"明·罗贯中《三国演义》第三回"},"similar":["肆无忌惮"],"usage":"作谓语、定语、状语；指一点没有顾忌"},{"id":32289,"word":"略知一二","pinyin":"lüè zhī yī èr","abbr":"lzye","explanation":"一二：形容为数不多。略微知道一点。","source":{"text":"我同骆府虽非本家，向有亲谊，他家之事，也略知一二。","book":"清·李汝珍《镜花缘》第55回"},"example":{"text":"黑李是我的好朋友；因为常到他家去，所以对白李的事儿我也～。","book":"老舍《黑白李》"},"similar":["略知皮毛"],"usage":"作谓语；指稍微知道一些"},{"id":32290,"word":"略知皮毛","pinyin":"lüè zhī pí máo","abbr":"lzpm","explanation":"比喻稍知表面的情况或稍有肤浅的知识。","source":{"text":"才女才说学士大夫论及反切尚切瞠目无语，何况我们不过略知皮毛，岂敢乱谈，贻笑大方！","book":"清·李汝珍《镜花缘》第17回"},"example":{"text":"此事我们只～，不能擅下结论。"},"similar":["略知一二","略识之无"],"usage":"作谓语、定语；指了解不多"},{"id":32291,"word":"略窥一斑","pinyin":"lüè kuī yī bān","abbr":"lkyb","explanation":"比喻大致看到一些情况，但不够全面。同“略见一斑”。","source":{"text":"孤虽不肖，其于人之贤否，略窥一斑，内不敢任爱憎之私，外不轻信誉之说。","book":"明·张居正《答南列卿陈我度》"},"similar":["略见一斑"],"opposite":["一览无遗"],"usage":"作谓语、宾语；指大致地看到事物某部分"},{"id":32292,"word":"略胜一筹","pinyin":"lüè shèng yī chóu","abbr":"lsyc","explanation":"筹：筹码，古代用以计数的工具，多用竹子制成。比较起来，稍微好一些。","source":{"text":"小生所以忝出君上者，以起处数语，略高一筹耳。","book":"清·蒲松龄《聊斋志异·辛十四娘》"},"example":{"text":"这时，只要不是下等签，他就会感到一些满足，何况这比“中下”还～。","book":"姚雪垠《李自成》第二卷第十九章"},"similar":["后来居上","棋高一着","青出于蓝"],"opposite":["相形设色","略逊一筹","相形见绌"],"usage":"作谓语、宾语、定语；指比较好一点"},{"id":32293,"word":"略见一斑","pinyin":"lüè jiàn yī bān","abbr":"ljyb","explanation":"略：大致；斑：斑点或斑纹。比喻大致看到一些情况，但不够全面。","source":{"text":"此郎亦管中窥豹，时见一斑。","book":"南朝·宋·刘义庆《世说新语·方正》"},"example":{"text":"诸如此类，虽未得其皮毛，也就～了。","book":"清·李汝珍《镜花缘》第五十八回"},"similar":["管中窥豹"],"opposite":["一览无遗"],"usage":"作谓语、宾语；指大致地看到事物的某一部分"},{"id":32294,"word":"略识之无","pinyin":"lüè shí zhī wú","abbr":"lszw","explanation":"之、无：指最简单的字。形容识字不多。","source":{"text":"仆始生六七月时，乳母抱弄于书屏下。有指‘无’字、‘之’字示仆者，仆虽口未能言，心已默识。后有问此二字者，虽百十其试，而指之不差。","book":"唐·白居易《与元九书》"},"example":{"text":"还有一班市侩，不过～，因为艳羡那些斗方名士，要跟着他学。","book":"清·吴趼人《二十年目睹之怪现状》第九回"},"similar":["略知皮毛","略知一二","仅识之无"],"opposite":["学富五车"],"usage":"作谓语、定语；形容识字不多"},{"id":32295,"word":"略迹原心","pinyin":"lüè jì yuán xīn","abbr":"ljyx","explanation":"撇开表面的事实，而从其用心上加以原谅。","source":{"text":"英君察相，尚能略其迹而原其心；感其诚而哀其遇。","book":"明·张煌言《答赵安抚书》"},"example":{"text":"我们如今，也只好～，倘若求全责备起来，天底下那里还有甚么好人呢？","book":"《文明小史》第十七回"},"similar":["略迹原情"],"usage":"作谓语、宾语；用于书面语"},{"id":32296,"word":"略迹原情","pinyin":"lüè jì yuán qíng","abbr":"ljyq","explanation":"撇开事实不谈，从情理上原谅。","source":{"text":"英君察相，尚能略其迹而原其心；感其诚而哀其遇。","book":"明·张煌言《答赵安抚书》"},"example":{"text":"万一幸而遇着宽厚的道德家，有时也可以～，许他一个烈字。","book":"鲁迅《坟·我的节烈观》"},"similar":["略迹原心"],"usage":"作谓语；撇开事实不谈，从情理上加以原谅"},{"id":32297,"word":"略迹论心","pinyin":"lüè jì lùn xīn","abbr":"ljlx","explanation":"撇开表面的事实而评论其用心。","source":{"text":"以于立玉、于元荐为乱天下者，亦岂遂为定论乎？略迹而论心，二臣皆皎然不欺其志，有国士之风。","book":"清·黄宗羲《子刘子行状上》"},"example":{"text":"我们看待一个人的为人要～，不要光看表面现象"},"usage":"作谓语、宾语；用于书面语"},{"id":32298,"word":"略逊一筹","pinyin":"lüè xùn yī chóu","abbr":"lxyc","explanation":"逊：次、差；筹：算筹。比较起来，稍微差一点。","source":{"text":"我建议选比我略逊一筹的刘顺明接替白度工作。","book":"王朔《千万别把我当人》"},"example":{"text":"可是慕容冲胜在年轻力壮，气足神健，虽然～，也还抵御得住。","book":"梁羽生《白发魔女传》第二十四回"},"similar":["稍逊一筹"],"usage":"作谓语、定语；用于口语"},{"id":32299,"word":"略高一筹","pinyin":"lüè gāo yī chóu","abbr":"lgyc","explanation":"筹：筹码，记数用具。略微超过一个码。形容双方比较，稍强一些。","source":{"text":"小生所以忝出君上者，以起处数语，略高一筹耳。","book":"清·蒲松龄《聊斋志异·辛十四娘》"},"example":{"text":"他的技艺比我～。"},"similar":["略胜一筹","稍胜一筹"],"opposite":["相形见绌"],"usage":"作谓语、宾语、定语；指比较好一点"},{"id":32300,"word":"番天覆地","pinyin":"fān tiān fù dì","abbr":"ftfd","explanation":"番：通“翻”；覆：翻过来。形容变化巨大而彻底，也形容事情闹得很凶。","source":{"text":"快送二圣皇帝出来，万事全休，不然交你番天覆地，社稷荡为丘墟，生灵涂作魑魅。","book":"明·无名氏《精忠记·胜敌》"},"similar":["翻天覆地"],"usage":"作定语、宾语、状语；形容社会变化很大"},{"id":32301,"word":"番来复去","pinyin":"fān lái fù qù","abbr":"flfq","explanation":"番：通“翻”。形容多次重复。也形容不断地翻动身体。","source":{"text":"却说皮氏这一夜等赵昂不来，小段名回后，老公又睡了。番来复去，一夜不曾合眼。","book":"明·冯梦龙《警世通言》第24卷"},"similar":["番来覆去","翻来覆去","翻来复去"],"usage":"作谓语、状语；指人的动作与思维反复"},{"id":32302,"word":"番来覆去","pinyin":"fān lái fù qù","abbr":"flfq","explanation":"①指不断翻身。②指反复多次。参见“翻来覆去”。","source":{"text":"自成了人后，夜里和李郎絮叨叨到四五更鼓，番来覆去，那里睡来？","book":"明汤显祖《紫箫记·胜游》"},"example":{"text":"亦作“番来复去”。一来一往无胜败，番来复去没输赢。","book":"《明成化说唱词话丛刊·花关索下西川传（续集）》"},"similar":["翻来覆去"],"usage":"作状语；指人的动作与思维反复"},{"id":32303,"word":"番窠倒臼","pinyin":"fān kē dǎo jiù","abbr":"fkdj","explanation":"形容打破现成的格式。","source":{"text":"世间茅葛议论已自充塞，更无一片寸草不生地步，王老于其间又番窠倒臼，又撰出一种驭气摄灵一息一息等语，又是一场孽怪。","book":"明唐顺之《书王龙溪致知议略》"},"usage":"作谓语；指打破常规"},{"id":32304,"word":"畴咨之忧","pinyin":"chóu zī zhī yōu","abbr":"czzy","explanation":"畴咨：访问、访求。指人才难求的忧虑。","source":{"text":"帝曰：‘畴咨若时登庸。’","book":"《尚书·尧典》"},"example":{"text":"人有昏垫之厄，主有～。","book":"南朝·宋·范晔《后汉书·崔駰传》"},"usage":"作宾语；指人才难求的忧虑"},{"id":32305,"word":"畸人侔天","pinyin":"jī rén mó tiān","abbr":"jrmt","explanation":"畸：奇；侔：相等。形容为人清高，不流于俗。","source":{"text":"畸人者，畸于人而侔于天。","book":"《庄子·大宗师》"}},{"id":32306,"word":"畸形发展","pinyin":"jī xíng fā zhān","abbr":"jxfz","explanation":"畸：奇，不正常。按照不正常的轨迹发展。"},{"id":32307,"word":"畸流洽客","pinyin":"jī liú qià kè","abbr":"jlqk","explanation":"高行脱俗、广见博闻之士。","source":{"text":"又如畸流洽客，领异拔新，时出一编，人所未睹。","book":"明·胡应麟《少室山房笔丛·经籍会通四》"},"usage":"作宾语；指有学问的人"},{"id":32308,"word":"畸流逸客","pinyin":"jī liú yì kè","abbr":"jlyk","explanation":"指高行脱俗的隐逸之士。","source":{"text":"[明·胡无瑞]尝跋此册及《敬乡录》云：‘遍举郡邑，凡有闻者，缉其制作履历，粲若指掌，下逮畸流逸客，片语只词，亦博采旁证。’","book":"清·厉鹗《〈吴礼部诗话〉跋》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":32309,"word":"畸轻畸重","pinyin":"jī qīng jī zhòng","abbr":"jqjz","explanation":"畸：偏。有时偏轻，有时偏重。形容事物发展不均衡，或对待事物的态度不公正。","source":{"text":"丁与粮无畸轻畸重之弊。","book":"宋·黄六鸿《福惠全书》"},"example":{"text":"于行政立法两方权力，～，未剂于平，致滋口实。","book":"蔡东藩、许廑父《民国通俗演义》第八十四回"},"similar":["畸重畸轻"],"usage":"作谓语、定语；形容事物发展不均衡"},{"id":32310,"word":"畸重畸轻","pinyin":"jī zhòng jī qīng","abbr":"jzjq","explanation":"形容事物发展不均衡，或对待事物的态度不公正。同“畸轻畸重”。","source":{"text":"丁与粮，无畸重畸轻之弊。","book":"清·黄六鸿《福惠全书·编审·编审余论》"},"example":{"text":"而一一权其～之度，寻一至当之境而止。","book":"李大钊《民彝与政治》"},"similar":["畸轻畸重"],"usage":"作谓语、定语；形容事物发展不均衡"},{"id":32311,"word":"疏不谋亲","pinyin":"shū bù móu qīn","abbr":"sbmq","explanation":"疏：疏远；谋：图谋，营求。关系疏远者不会去离间关系亲近的。","source":{"text":"臣闻之，贱不谋贵，外不谋内，疏不谋亲。","book":"汉·刘向《说苑·臣术》"},"similar":["疏不间亲","远不间亲"],"usage":"作宾语、定语；指人际关系"},{"id":32312,"word":"疏不间亲","pinyin":"shū bù jiàn qīn","abbr":"sbjq","explanation":"间：离间。关系疏远者不参与关系亲近者的事。","source":{"text":"夫然，则不下倍（背叛）上，臣不杀君，贱不逾贵，少不凌长，远不间亲，新不间旧，小不加大，淫不破义。凡此八者，礼之经也。","book":"《管子·五辅》"},"example":{"text":"～，还是莫说罢。","book":"明·冯梦龙《警世通言》卷三十二"},"similar":["远不间亲","疏不谋亲"],"usage":"作宾语、定语；指人际关系","story":["战国时期，魏文侯想选拔合适的相国，召占卜师李克进宫听取是选翟黄还是选魏成子，请他为他占卜并请他提意见。李克看出其中的用意，就避而不谈说：“臣闻之卑不谋尊，疏不间亲。我一个外人不好去评论此事。”"]},{"id":32313,"word":"疏亲慢友","pinyin":"shū qīn màn yǒu","abbr":"sqmy","explanation":"疏：疏远；慢：怠慢。疏远亲族，怠慢朋友。","source":{"text":"远富近贫以礼相交天下有，疏亲慢友因财绝义世间多。","book":"清·鄂比赠曹雪芹联"},"example":{"text":"不独～，种种骄傲，并将糟糠之情，也置度外。","book":"清·李汝珍《镜花缘》第五十一回"},"usage":"作谓语、定语、宾语；用于为人处世"},{"id":32314,"word":"疏宕不拘","pinyin":"shū dàng bù jū","abbr":"sdbj","explanation":"放荡不羁。","source":{"text":"憕早丧父，家贫，躬耕以养祖母，有暇则览文籍，疏宕不羁，时人未之奇也。","book":"《北史·薛憕传》"},"usage":"作谓语、定语；用于为人"},{"id":32315,"word":"疏密有致","pinyin":"shū mì yǒu zhì","abbr":"smyz","explanation":"疏：稀疏；密：茂密；致：情趣。指园林的布置或绘画的布局有稀疏浅淡处，也有茂密浓重处，很有情趣。","example":{"text":"只见舫上全是真树真花，枝干横斜，花叶～，淡雅天然，真如一幅名家水墨山水一般。","book":"金庸《书剑恩仇录》第十回"}},{"id":32316,"word":"疏庸愚钝","pinyin":"shū yōng yú dùn","abbr":"syyd","explanation":"疏庸：懒散。懒散愚笨。","source":{"text":"休休休，枉笑杀凌烟阁上人，有这般疏庸愚钝，孤陋寡闻。","book":"元·马致远《陈抟高卧》第二折"}},{"id":32317,"word":"疏影暗香","pinyin":"shū yǐng àn xiāng","abbr":"syax","explanation":"疏影：稀疏的枝影；暗香：清幽的香气。原形容梅花的香味和姿态，后被用为梅花的代称。","source":{"text":"疏影横斜水清浅，暗香浮动月黄昏。","book":"宋·林逋《山园小梅》诗"},"example":{"text":"疏影暗香，和靖孤山梅蕊放；轻阴清昼，渊明旧宅柳条舒。","book":"清·李渔《笠翁对韵》卷上"}},{"id":32318,"word":"疏忽大意","pinyin":"shū hū dà yì","abbr":"shdy","explanation":"经常不集中注意力，粗心。","example":{"text":"你可千万不能～。"},"similar":["麻痹大意"],"opposite":["认认真真"],"usage":"作谓语、定语、宾语；指粗心大意"},{"id":32319,"word":"疏忽职守","pinyin":"shū hū zhí shǒu","abbr":"shzs","explanation":"不尽责，失职。","example":{"text":"他～，造成重大损失。"},"similar":["玩忽职守"],"opposite":["忠于职守"],"usage":"作谓语、定语；指不尽责"},{"id":32320,"word":"疏慵愚钝","pinyin":"shū yōng yú dùn","abbr":"syyd","explanation":"疏慵：懒散。懒散愚笨。","source":{"text":"休休休，枉笑杀凌烟阁上人，有这般疏慵愚钝，孤陋寡闻。","book":"元·马致远《陈抟高卧》第二折"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":32321,"word":"疏水箪瓢","pinyin":"shū shuǐ dān piáo","abbr":"ssdp","explanation":"疏水：粗糙的饮食；箪瓢：简陋的食具。比喻安贫乐道。","source":{"text":"一箪食，一瓢饮，在陋巷，人不堪其忧，回也不改其乐。","book":"《论语·雍也》"},"example":{"text":"皮即老氏无为、庄氏齐物之说，而于孔、颜～之义亦无碍焉。","book":"清·冯桂芬《似山居图序》"},"usage":"作宾语、定语；用于生活"},{"id":32322,"word":"疏疏朗朗","pinyin":"shū shū lǎng lǎng","abbr":"ssll","explanation":"稀疏。","source":{"text":"乡下人为了明天的工作，熬不得夜，早都睡觉去了，疏疏朗朗的站着的不过是几十个本村和邻村闲汉。","book":"鲁迅《社戏》"},"similar":["稀稀拉拉"],"opposite":["密密麻麻"],"usage":"作定语、状语；指稀疏"},{"id":32323,"word":"疏而不漏","pinyin":"shū ér bù lòu","abbr":"sebl","explanation":"意思是天道公平，作恶就要受惩罚，它看起来似乎很不周密，但最终不会放过一个坏人。比喻作恶的人逃脱不了国法的惩处。","source":{"text":"天网恢恢，疏而不漏。","book":"《老子》：“天网恢恢，疏而不失。”《魏书·任城王传》"},"example":{"text":"你可记得三年前蔡指挥的事么？天网恢恢，～。今日有何理说。","book":"明·冯梦龙《醒世恒言》卷三十六"},"usage":"作谓语、定语；用于劝诫人"},{"id":32324,"word":"疏谋少略","pinyin":"shū móu shǎo lüè","abbr":"smsl","explanation":"计谋、策略很少。形容不善谋划。","source":{"text":"那武将要是疏谋少略的，他自己无能，白送了性命，这难道也是不得已么？","book":"清曹雪芹《红楼梦》第三十六回"},"opposite":["足智多谋"],"usage":"作谓语、定语；用于为人处事"},{"id":32325,"word":"疏财仗义","pinyin":"shū cái zhàng yì","abbr":"sczy","explanation":"疏财：以财物分人。讲义气，轻视钱财。多指出钱帮助遭难的人。","source":{"text":"则为我救困扶危，疏财仗义，都做了注福消愆。","book":"元·无名氏《来生债》第四折"},"example":{"text":"《水浒》中描述了众多杀富济贫、～的英雄豪杰的形象。"},"similar":["仗义疏财"],"opposite":["见利忘义"],"usage":"作谓语、定语；指出钱帮助人"},{"id":32326,"word":"疏财尚气","pinyin":"shū cái shàng qì","abbr":"scsq","explanation":"气：义气。讲义气，轻视钱财。多指出钱帮助遭难的人。","source":{"text":"四明戴献可者，疏财尚气，喜从贤士大夫游处，而家世雄于财。","book":"宋·沈俶《谐史·戴献可仆》"},"similar":["疏财重义","仗义疏财"],"usage":"作谓语、定语；用于为人"},{"id":32327,"word":"疏财重义","pinyin":"shū cái zhòng yì","abbr":"sczy","explanation":"疏财：以财物分人。讲义气，轻视钱财。多指出钱帮助遭难的人。","source":{"text":"而好接待四方之士，疏财重义，有难必救。","book":"五代·王仁裕《开元天宝遗事·结棚避暑》"},"example":{"text":"我很喜欢～的朋友。"},"similar":["疏财仗义"],"opposite":["见财起意"],"usage":"作谓语、定语；指慷慨解囊"},{"id":32328,"word":"疏食饮水","pinyin":"shū shí yǐ shuǐ","abbr":"ssys","explanation":"指粗饭淡汤，饮食简单。","source":{"text":"饭疏食饮水，曲肱而枕之，乐亦在其中矣。","book":"《论语·述而》"},"example":{"text":"梈持身廉正，居官不可干　以私，～，泊如也。","book":"《元史·范梈传》"},"similar":["粗茶淡饭"],"opposite":["山珍海味","美味佳肴"],"usage":"作宾语、定语；用于生活"},{"id":32329,"word":"疐后跋前","pinyin":"zhì hòu bá qián","abbr":"zhbq","explanation":"疐：同“踬”，颠踬；跋：踏，踩。比喻进退两难","source":{"text":"两造交哄，势极汹汹，我政府疐后跋前，莫知所适。","book":"梁启超《中国国债史》"},"similar":["跋前疐后"],"usage":"作谓语、定语；指进退维谷"},{"id":32330,"word":"疑三惑四","pinyin":"yí sān huò sì","abbr":"yshs","explanation":"怀疑这个怀疑那个。指人多疑。","example":{"text":"她就是～的性格。"},"similar":["疑神疑鬼"],"usage":"作谓语、定语、状语；指人多疑"},{"id":32331,"word":"疑事无功","pinyin":"yí shì wú gōng","abbr":"yswg","explanation":"工作信心不足，就不会有效果。","source":{"text":"韂鞅曰：‘疑行无名，疑事无功。且夫有高人之行者，固见非于世；有独知之虑者，必见敖于民。’","book":"汉·司马迁《史记·商君列传》"},"example":{"text":"诸将多曰：“善！”张卬拔剑击地曰：“～，今日之议，不得有二！”","book":"宋·司马光《资治通鉴·淮阳王更始元年》"},"similar":["疑行无成"],"usage":"作宾语、定语；用于劝诫人"},{"id":32332,"word":"疑事无功，疑行无名","pinyin":"yí shì wú gōng，yí xíng wú míng","abbr":"yswgyxwm","explanation":"疑：疑虑。行动有疑虑就不会成功，做事有疑虑就没有效果","source":{"text":"臣闻之：疑事无功，疑行无名。","book":"西汉·刘向《战国策·赵策》"},"similar":["疑行无成，疑事无功"],"usage":"作宾语、定语；用于劝诫人"},{"id":32333,"word":"疑云满腹","pinyin":"yí yún mǎn fù","abbr":"yymf","explanation":"心中充满了疑惑。","source":{"text":"那时我就怀疑：晚上行军，怎么可以打灯笼呢？自己疑云满腹，莫测玄奥。","book":"冯玉祥《我的生活》第五章"},"similar":["满腹狐疑"],"usage":"作谓语；指怀疑"},{"id":32334,"word":"疑人勿用，用人勿疑","pinyin":"yí rén wù yòng，yòng rén wù yí","abbr":"yrwyyrwy","explanation":"怀疑的人就不要使用他，使用的人就不要怀疑他。指用人应充分信任。","source":{"text":"疑人勿使，使人勿疑。自今本国及诸色人，量才通用之。","book":"《旧唐书·陆贽传》：“夫如是，则疑者不使，使者不疑。”《金史·熙宗本纪》"},"similar":["疑人不用，用人不疑"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":32335,"word":"疑人疑鬼","pinyin":"yí rén yí guǐ","abbr":"yryg","explanation":"怀疑这个，怀疑那个。形容非常多疑。","source":{"text":"无奈各房的人都是疑人疑鬼的不安静，也添了人坐更，于是更加了好些食用。","book":"清·曹雪芹《红楼梦》第102回"},"similar":["疑神疑鬼","疑神见鬼","疑鬼疑神"],"opposite":["深信不疑"],"usage":"作谓语、定语、状语；指人多疑"},{"id":32336,"word":"疑今察古","pinyin":"yí jīn chá gǔ","abbr":"yjcg","explanation":"疑：疑问；察：考察。对于当世有所怀疑的事，通过考察历史来寻求解决。","source":{"text":"疑今者，察之古。","book":"《管子·形势》"}},{"id":32337,"word":"疑似之迹，不可不察","pinyin":"yí sì zhī jì，bù kě bù chá","abbr":"yszjbkbc","explanation":"疑似：既象又不象。不分明而想像的迹象，不能不仔细考察。指不被事物相似的表面现象所迷惑。","source":{"text":"夫惑于似事者，而失于真士。此藜丘丈人之智也。疑似之迹，不可不察。","book":"《吕氏春秋·疑事》"}},{"id":32338,"word":"疑似之间","pinyin":"yí sì zhī jiān","abbr":"yszj","explanation":"疑似：既像又不像。指有所怀疑，不敢肯定的事。","source":{"text":"断速则寡恕于人，而疑似之间不容辩也。","book":"唐·陆贽《论叙迁幸之由状》"},"example":{"text":"宋·王谠《唐语林·方正》：“今我得魏谟，于～，必极匡谏，虽不敢望贞观之政，庶几处无过之地。”"},"usage":"作宾语、状语；用于书面语"},{"id":32339,"word":"疑信参半","pinyin":"yí xìn cān bàn","abbr":"yxcb","explanation":"指半信半疑。","source":{"text":"少之时，有言人之簠簋不饰者，辄咎其诬人；迨稍涉世，疑信参半，今则信其有是人也。","book":"宋·魏了翁《江陵别安抚书》"},"example":{"text":"眼睛是睁得更其圆大了，那里是～的。","book":"钟理和《故乡之三·阿煌叔》"},"similar":["半信半疑","似信非信"],"opposite":["信以为真","疑神疑鬼","深信不疑"],"usage":"作谓语、定语；同“将信将疑”"},{"id":32340,"word":"疑团满腹","pinyin":"yí tuán mǎn fù","abbr":"ytmf","explanation":"疑团：许多弄不清的问题。形容心里充满了疑问。","source":{"text":"弄得宝玉满肚疑团，没精打采地，归至怡红院中。","book":"清·曹雪芹《红楼梦》第八十七回"},"similar":["满腹疑团"],"opposite":["深信不疑"],"usage":"作谓语、定语、状语；指疑问多"},{"id":32341,"word":"疑团莫释","pinyin":"yí tuán mò shì","abbr":"ytms","explanation":"心里有很多疑问，没有解开。","source":{"text":"所不可解的是，赵文华所能动用的队伍虽然不多，但倭寇海盗，经此行击，战力大损，惧他何来？何以不捡个现成的便宜？疑团莫释，而两彭已连袂到达。","book":"高阳《草莽英雄》第十章"},"example":{"text":"我一时～，难以入睡。"},"usage":"作谓语、定语、状语；指疑问得不到解答"},{"id":32342,"word":"疑心杀子","pinyin":"yí xīn shā zǐ","abbr":"yxsz","explanation":"因怀疑而杀死亲生儿子。比喻对既象又不象的现象不做调查，只凭主观怀疑着手处理，酿成大错。","source":{"text":"丈人望其真子，拨剑而刺之。丈人智惑于似其子者，而杀其真子。","book":"《吕氏春秋·慎行论·疑似》"},"example":{"text":"见怪不怪，我正即能辟邪；怕鬼有鬼，疑心适以杀子。","book":"清·练塘老渔《聊斋志异跋》"}},{"id":32343,"word":"疑心生暗鬼","pinyin":"yí xīn shēng àn guǐ","abbr":"yxsag","explanation":"指因为多疑而产生各种幻觉和错误判断。","source":{"text":"尝闻人说鬼怪者，以为必无此理，以为疑心生暗鬼，最是切要议论。","book":"宋·吕本中《师友杂志》"},"example":{"text":"你看他奔上大路，～，步步只疑是行者变化了跟住他。","book":"明·吴承恩《西游记》第三十二回"},"similar":["疑神疑鬼"],"usage":"作谓语、宾语、定语；指乱猜疑","story":["从前生性愚笨、胆子很小的涓蜀梁在一个月色很好的夜晚从外面往家赶，途中他发现一个黑影老是跟随他前后，而且时大时小的，他以为是鬼在跟踪他，吓得撒腿往家跑，没想到他自己在月光下的影子把自己竟给吓死了"]},{"id":32344,"word":"疑心生鬼","pinyin":"yí xīn shēng guǐ","abbr":"yxsg","explanation":"指无中生有地乱猜疑，导致自己吓唬自己。","source":{"text":"尝闻人说鬼怪者，以为必无此理，以为疑心生暗鬼，最是切要议论。","book":"宋·吕本中《师友杂志》"},"example":{"text":"吾只恐读是编者～，或入街鬼窠路云。","book":"清·张南庄《何典》太平客人序"},"similar":["疑心生暗鬼"],"opposite":["深信不疑"],"usage":"作谓语、宾语、定语；形容人多疑","story":["从前生性愚笨、胆子很小的涓蜀梁在一个月色很好的夜晚从外面往家赶，途中他发现一个黑影老是跟随他前后，而且时大时小的，他以为是鬼在跟踪他，吓得撒腿往家跑，没想到他自己在月光下的影子把自己竟给吓死了"]},{"id":32345,"word":"疑惑不解","pinyin":"yí huò bù jiě","abbr":"yhbj","explanation":"疑惑：怀疑。指对某一事物怀疑迷惑，认识不清。","source":{"text":"他疑惑不解。陈毅同志告诉他，这是准备给俘虏吃的。","book":"顾寄南《黄桥烧饼》"},"example":{"text":"四爷胤祯谋事细密，他～地瞧着邬思明。","book":"二月河《康熙大帝》十四"},"similar":["迷惑不解"],"usage":"作谓语、定语、状语；用于处事"},{"id":32346,"word":"疑疑惑惑","pinyin":"yí yí huò huò","abbr":"yyhh","explanation":"怀疑别人，疑虑不安，犹豫不定。","source":{"text":"自从昨夜见鬼，心中总是疑疑惑惑的，如今听了大了这些话，不觉把素日的心性改了一半，已有三分信意。","book":"清·曹雪芹《红楼梦》第101回"},"example":{"text":"清·荻岸山人《平山冷燕》第二回：“若是内里写出来的，咱终有些～。”"},"similar":["半信半疑"],"usage":"作定语、状语；指人的心情"},{"id":32347,"word":"疑神疑鬼","pinyin":"yí shén yí guǐ","abbr":"ysyg","explanation":"这也怀疑，那也怀疑。形容非常多疑。","source":{"text":"谵者非梦非幻，疑鬼疑神，若图谶，若镜听，若童谣，人所奉为蓍蔡，以卜休咎，是名曰谵。","book":"明·张岱《瑯嬛文集·萧丘〈谵述〉小序》"},"example":{"text":"然而这么一来，却又使一些看文字不用视觉，专靠嗅觉的“文学家”～。","book":"鲁迅《准风月谈·前记》"},"similar":["狐埋狐搰"],"opposite":["深信不疑","言听计从"],"usage":"作谓语、定语、状语；指人多疑"},{"id":32348,"word":"疑神见鬼","pinyin":"yí shén jiàn guǐ","abbr":"ysjg","explanation":"形容非常多疑。同“疑神疑鬼”。","source":{"text":"少见多怪，一点点儿眉毛大的事儿，就疑神见鬼似地！","book":"茅盾《霜叶红似二月花》五"},"similar":["疑鬼疑神","疑神疑鬼","疑人疑鬼"],"usage":"作谓语、定语、状语；指人多疑"},{"id":32349,"word":"疑行无名，疑事无功","pinyin":"yí xíng wú míng，yí shì wú gōng","abbr":"yxwmyswg","explanation":"疑：疑虑。行动有疑虑就不会成功，做事有疑虑就没有效果","source":{"text":"卫鞅曰：疑行无名，疑事无功。","book":"西汉·司马迁《史记·商君列传》"},"similar":["疑行无成，疑事无功"],"usage":"作宾语、定语；用于劝诫人"},{"id":32350,"word":"疑行无成","pinyin":"yí xíng wú chéng","abbr":"yxwc","explanation":"疑：怀疑，犹豫。行动犹豫疑虑，就不能成功。","source":{"text":"臣闻之，疑行无成，疑事无功。","book":"《商君书·更法》"},"similar":["疑事无功"],"usage":"作宾语、定语；用于劝诫人"},{"id":32351,"word":"疑行无成，疑事无功","pinyin":"yí xíng wú chéng，yí shì wú gōng","abbr":"yxwcyswg","explanation":"疑：怀疑，犹豫；成：成功。行动犹豫疑虑，就不能成功，做事疑虑重重就不会有效果。","source":{"text":"臣闻之，疑行无成，疑事无功。","book":"《商君书·更法》"},"similar":["疑行无名，疑事无功"],"usage":"作宾语、定语；用于劝诫人"},{"id":32352,"word":"疑误天下","pinyin":"yí wù tiān xià","abbr":"ywtx","explanation":"疑：怀疑。令天下迷惑不解。"},{"id":32353,"word":"疑贰之见","pinyin":"yí èr zhī jiàn","abbr":"yezj","explanation":"疑贰：疑惑，拿不定主意。指犹豫拿不定主意。","source":{"text":"将军外托服从之名，内怀疑贰之见，事急而不断，祸至无日矣。","book":"明·罗贯中《三国演义》第四十三回"}},{"id":32354,"word":"疑邻盗斧","pinyin":"yí lín dào fǔ","abbr":"yldf","explanation":"疑：怀疑；斧：斧头。怀疑邻居偷他的斧头。指不注重事实根据，对人对事胡乱猜疑。","source":{"text":"人有亡斧者，意其邻之子。视其行步，窃斧也；颜色，窃斧也；言语，窃斧也；动作态度，无为而不窃斧也。","book":"战国·郑·列御寇《列子·说符》"},"similar":["疑神疑鬼"],"usage":"作谓语、宾语、定语；指疑心重","story":["从前有个乡下人丢了一把斧子，他认为是他邻居家的儿子偷去，就处处观察他的一言一行，觉得那人就是像偷了他的斧子一样。后来他在山谷里找到了遗忘的斧子。又碰到邻居的儿子，再留心他的一举一动，再也感觉不像偷斧子的人了"]},{"id":32355,"word":"疑难杂症","pinyin":"yí nán zá zhèng","abbr":"ynzz","explanation":"难辨或难治的各种病症。比喻难以理解或解决的问题。","source":{"text":"然而那下面的一个名词，却不写尚可，一写倒成了疑难杂症。","book":"鲁迅《二心集·风马牛》"},"example":{"text":"他是一个专攻～的大夫"},"usage":"作主语、宾语、定语；用于医学等"},{"id":32356,"word":"疑鬼疑神","pinyin":"yí guǐ yí shén","abbr":"ygys","explanation":"怀疑这个，又怀疑那个。形容神经过敏，无中生有，胡乱猜疑。","source":{"text":"如今安公子正在个疑鬼疑神的时候，遇见了这等一个神出鬼没的脚色。","book":"清·文康《儿女英雄传》第五回"},"similar":["疑神疑鬼","疑人疑鬼","疑神见鬼"],"usage":"作谓语、定语、状语；指人多疑"},{"id":32357,"word":"疗疮剜肉","pinyin":"liáo chuāng wān ròu","abbr":"lcwr","explanation":"挖身上的肉来医治伤口。比喻只顾眼前，不考虑后果。","source":{"text":"若虑迷信一破，道德堕落，必以保存为得计，此又何异欲止渴而饮鸩，欲疗疮而剜肉。","book":"清·壮者《扫迷帚》第24回"},"example":{"text":"～的做法太愚昧。"},"similar":["剜肉补疮"],"usage":"作宾语、定语；指只顾眼前，不考虑后果"},{"id":32358,"word":"疙疙瘩瘩","pinyin":"gē gē dā dā","abbr":"ggdd","explanation":"不平滑很粗糙。比喻办事遇到一些麻烦。","source":{"text":"生造词语，乱用术语疙里疙瘩，词不达意。","book":"《谈修改文章》"},"example":{"text":"他皮肤上～地长了些痱子。"},"similar":["疙里疙瘩"],"usage":"作宾语、定语；指不顺畅"},{"id":32359,"word":"疙里疙瘩","pinyin":"gē lǐ gē dā","abbr":"glgd","explanation":"文字不通畅，物体不平滑很粗糙。","source":{"text":"生造词语，乱用术语疙里疙瘩，词不达意。","book":"《谈修改文章》"},"example":{"text":"《谈修改文章》：“生造词语，乱用术语～，词不达意。”"},"similar":["疙疙瘩瘩"],"usage":"作宾语、定语；指不顺畅"},{"id":32360,"word":"疚心疾首","pinyin":"jiù xīn jí shòu","abbr":"jxjs","explanation":"疚：久病，忧虑。因歉疚而内心不安。心中不安，头痛脑胀。形容十分悲痛忧愁或不安。","source":{"text":"以嗣子奉命鸡林，三岁然复，疚心疾首，亦时礼念，冥期佑助。","book":"唐·崔锷《内寺伯朱夫人赵氏合袝志》"},"example":{"text":"所以夙夜愁痛，～而不敢息者，以此也。","book":"宋·王安石《答韶州张殿丞书》"},"similar":["痛心疾首"],"usage":"作谓语；指痛心"},{"id":32361,"word":"疢如疾首","pinyin":"chèn rú jí shǒu","abbr":"crjs","explanation":"疢：热病。内心烦热的头昏脑胀。形容忧伤成疾。","source":{"text":"心之忧矣，疢如疾首。","book":"《诗经·小雅·小弁》"},"example":{"text":"曹操父子，世载其罪，朕用惨怛，～。","book":"《三国志·蜀志·马超传》"},"usage":"作谓语、定语、状语；指人的心情"},{"id":32362,"word":"疥癞之患","pinyin":"jiè lài zhī huàn","abbr":"jlzh","explanation":"疥癞：疥疮与癞痢，两种皮肤病。比喻危害尚轻的祸患或无关紧要的问题。","source":{"text":"今王兴十万之师，行粮千里，以争疥癞之患，而忘大毒之在腹心，臣恐齐未必胜，而越祸已至也。","book":"明·冯梦龙《东周列国志》第82回"},"similar":["疥癞之疾","疥癣之病"],"usage":"作主语、宾语；指无关紧要的东西"},{"id":32363,"word":"疥癞之疾","pinyin":"jiè lài zhī jí","abbr":"jlzj","explanation":"疥癞：疥疮与癞痢，两种皮肤病。比喻危害尚轻的祸患或无关紧要的问题。","source":{"text":"疥癞之疾，何足挂意！","book":"明·施耐庵《水浒传》第63回"},"similar":["疥癞之患","疥癣之疾","癣疥之疾"],"usage":"作主语、宾语；指无关紧要的东西"},{"id":32364,"word":"疥癣之疾","pinyin":"jiè xuǎn zhī jí","abbr":"jxzj","explanation":"比喻为害不大，无足轻重的小毛病。","source":{"text":"夫齐之于吴也，疥癣之病也。","book":"《吕氏春秋·直谏》"},"example":{"text":"我虽在人闾阎之下，眉睫之间，又不比斗筲之器，～。","book":"元·关汉卿《裴度还带》第二折"},"similar":["疥癣之病","疥癞之患","疥癞之疾"],"usage":"作主语、宾语；指无关紧要的东西"},{"id":32365,"word":"疥癣之病","pinyin":"jiè xuǎn zhī bìng","abbr":"jxzb","explanation":"疥癣：一种皮肤病。比喻危害尚轻的祸患或无关紧要的问题。","source":{"text":"大夫之于吴也，疥癣之病也。","book":"战国·卫·吕不韦《吕氏春秋·直谏》"},"similar":["疥癣之疾","疥癞之患","疥癞之疾"],"usage":"作主语、宾语；指无关紧要的东西"},{"id":32366,"word":"疮好忘痛","pinyin":"chuāng hǎo wàng tòng","abbr":"chwt","explanation":"疮疤好了就忘了疼痛。比喻情况见好以后就忘记了从前的痛苦经历和教训。","source":{"text":"你今日了毕官司出来，两脚踏住平川地，得命思财，疮好忘痛。","book":"明·兰陵笑笑生《金瓶梅词话》第十四回"}},{"id":32367,"word":"疮疥之疾","pinyin":"chuāng jiè zhī jí","abbr":"cjzj","explanation":"比喻轻微的祸患。","source":{"text":"齐不过疮疥之疾，幸而胜之，不过小喜。","book":"明·梁辰鱼《浣沙记·死忠》"},"example":{"text":"前辈且请放心。以晚辈愚见，他天险庄～，还不至成甚气候。","book":"《康熙下通州》第十一回"},"opposite":["不治之症"],"usage":"作主语、宾语；指小毛病"},{"id":32368,"word":"疮痍弥目","pinyin":"chuāng yí mí mù","abbr":"cymm","explanation":"疮痍：创伤。满眼创伤。形容遭到严重破坏或灾害后的景象。同“疮痍满目”。","source":{"text":"复丁干戈大乱之后，满地兵燹，疮痍弥目，民生凋敝，亦云极矣。","book":"李大钊《大哀篇》"},"similar":["疮痍满目"],"usage":"作谓语、定语；用于战后或灾后"},{"id":32369,"word":"疮痍满目","pinyin":"chuāng yí mǎn mù","abbr":"cymm","explanation":"疮痍：创伤。满眼创伤。比喻眼前看到的都是灾祸的景象。","source":{"text":"乾坤含疮痍，忧虞何时毕？","book":"唐·杜甫《北征》诗"},"example":{"text":"征鼙聒耳乡音杳，～亲人少。","book":"清·李渔《风筝误·和鹤》"},"similar":["千疮百孔","断垣残壁"],"opposite":["琳琅满目","锦绣河山"],"usage":"作谓语、定语；形容战后或灾后破坏的景象"},{"id":32370,"word":"疯疯癫癫","pinyin":"fēng fēng diān diān","abbr":"ffdd","explanation":"精神失常的样子。形容人言语行动轻狂或超出常态。","source":{"text":"成天家疯疯癫癫的，说的话人也不懂，干的事人也不知。","book":"清·曹雪芹《红楼梦》第66回"},"example":{"text":"我不喜欢～的女孩。"},"similar":["神志不清"],"opposite":["神志清醒"],"usage":"作谓语、定语、状语；指人神智不清","story":["贾琏经贾珍贾蓉父子的撮合，私自在外娶了贾珍的二姨妹尤二姐为二奶，过起了夫妻生活。有时贾琏不能自己去，就派家人去送东西。尤二姐向小童兴儿打听贾府宝玉的情况，兴儿说宝玉从不去上学，成天在家疯疯癫癫的与女孩子混在一起"]},{"id":32371,"word":"疲乏不堪","pinyin":"pí fá bù kān","abbr":"pfbk","explanation":"不堪：不能忍受。形容非常疲乏。","source":{"text":"犯人一上梃棍，坐卧不得，只是局局促促地挤做一团，弄得疲惫不堪。","book":"刘操南《武松演义》第十回"},"example":{"text":"我已经～了"},"similar":["疲惫不堪"],"opposite":["生龙活虎"],"usage":"作谓语、定语、状语；指非常疲乏"},{"id":32372,"word":"疲于供命","pinyin":"pí yú gōng mìng","abbr":"pygm","explanation":"疲：疲乏，劳累。指忙于奔走应付，弄得非常疲乏。","source":{"text":"邑人疲于供命，聚薪其下，因野火焚之。","book":"宋·赵彦卫《云麓漫钞》第三卷"},"similar":["疲于奔命"],"usage":"作谓语、补语；指非常疲乏"},{"id":32373,"word":"疲于奔命","pinyin":"pí yú bēn mìng","abbr":"pybm","explanation":"原指因受命奔走而搞得很累。后也指忙于奔走应付，弄得非常疲乏。","source":{"text":"余必使尔罢于奔命以死。","book":"《左传·成公七年》"},"example":{"text":"彼方支吾未暇，而吾率步兵乘高而进，声东击西，形此而出彼，乘卒初锐而用之，彼亦～矣。","book":"宋·陈亮《酌古论·先主》"},"similar":["四处奔波","马不停蹄","席不暇暖"],"opposite":["优游自在","悠闲自得"],"usage":"作谓语、状语；指非常疲乏","story":["春秋时期，申公巫臣子灵为了得到此郑王室嫁到陈国的美若天仙的夏姬，先后阻止楚庄王及子反娶她，但也轮不上他。过了五年他终于把夏姬骗回了郑国，后改道晋国，楚国子反、子重反对，子灵扬言要使他们疲于奔命而死"]},{"id":32374,"word":"疲心竭虑","pinyin":"pí xīn jié lǜ","abbr":"pxjl","explanation":"竭：尽。指费尽心思。","source":{"text":"选五百人，而日限又迫，使考试之官殆废寝食，疲心竭虑，因劳致昏。","book":"宋·欧阳修《论更改贡举事件札子》"},"usage":"作谓语、定语、状语；指费尽心思"},{"id":32375,"word":"疲惫不堪","pinyin":"pí bèi bù kān","abbr":"pbbk","explanation":"疲惫：极度疲乏；不堪：不能忍受。形容非常疲乏。","source":{"text":"犯人一上梃棍，坐卧不得，只是局局促促地挤做一团，弄得疲惫不堪。","book":"刘操南《武松演义》第十回"},"example":{"text":"这一趟出差弄得～。"},"similar":["筋疲力尽","精疲力竭"],"opposite":["精神抖擞","生龙活虎","生气勃勃"],"usage":"作谓语、定语、补语；指非常疲乏"},{"id":32376,"word":"疲癃残疾","pinyin":"pí lóng cán jí","abbr":"plcj","explanation":"疲癃：年老多病。老弱病残。","source":{"text":"凡天下疲癃残疾，茕独鳏寡，皆吾兄弟之颠连而无告者也。","book":"宋·张载《西铭》"},"example":{"text":"又有那真正～的人，他却那里有一日十二个钱来买谷？","book":"清·西周生《醒世姻缘传》第三十二回"},"similar":["老弱病残"],"usage":"作宾语、定语；同“老弱病残”"},{"id":32377,"word":"疲精竭力","pinyin":"pí jīng jié lì","abbr":"pjjl","explanation":"疲：疲倦；竭：尽。精神、力气消耗已尽。形容非常疲劳。","source":{"text":"非文公疲精竭力，更千百年终至漏晦。","book":"元·刘壎《隐居通议·理学》"},"similar":["精疲力竭","筋疲力尽"],"usage":"作状语；指体力消耗已尽"},{"id":32378,"word":"疼心泣血","pinyin":"téng xīn qì xuè","abbr":"txqx","explanation":"泣血：十分哀痛。痛煞心田，哭出血泪。","source":{"text":"奋身而战，力尽神疲，疼心泣血，哀号请救。","book":"清·褚人获《隋唐演义》第94回"},"similar":["痛心泣血"],"usage":"作谓语、定语；指十分悲痛"},{"id":32379,"word":"疾不可为","pinyin":"jí bù kě wéi","abbr":"jbkw","explanation":"疾：病；为：治。病已不可医治。比喻已到了绝境。","source":{"text":"疾不可为也。在肓之上，膏之下，攻之不可，达之不及，药不至焉，不可为也。","book":"《左传·成公十年》"},"example":{"text":"巧娘曰：“～，魂已离舍。”","book":"清·蒲松龄《聊斋志异·巧娘》"},"similar":["病入膏肓","不可救药"],"opposite":["药到病除"],"usage":"作宾语、分句；指已陷入绝境"},{"id":32380,"word":"疾之如仇","pinyin":"jí zhī rú chóu","abbr":"jzrc","explanation":"疾：同“嫉”，嫉恨，痛恨。嫉恨他人如同仇敌。","source":{"text":"秀性忌谗佞，疾之如仇。","book":"《晋书·秦秀传》"},"similar":["疾之若仇","疾恶如仇"],"usage":"作谓语、定语；指人的个性"},{"id":32381,"word":"疾之若仇","pinyin":"jí zhī ruò chóu","abbr":"jzrc","explanation":"疾：同“嫉”，嫉恨，痛恨。嫉恨他人如同仇敌。","source":{"text":"由是礼法之士疾之若仇，而帝每保护之。","book":"《晋书·阮籍传》"},"similar":["疾之如仇","疾恶如仇"],"usage":"作谓语、定语；指人的个性"},{"id":32382,"word":"疾味生疾","pinyin":"jí wèi shēng jí","abbr":"jwsj","explanation":"疾味：能导致疾病的食物。吃了能导致疾病的食物必然得病。比喻恶有恶报。","source":{"text":"吾闻国家将败，必用奸人而嗜其疾味。","book":"《国语·楚语下》"}},{"id":32383,"word":"疾声厉色","pinyin":"jí shēng lì sè","abbr":"jsls","explanation":"疾：急速。说话急躁，脸色严厉。形容对人发怒说话时的神情。","source":{"text":"虽在仓卒，未尝疾言遽色。","book":"《后汉书·刘宽传》"},"example":{"text":"惟～，以违制相胁下。","book":"清·梁启超《收回干线铁路问题》"},"similar":["疾言厉色","疾言怒色"],"usage":"作谓语、宾语；指很严厉"},{"id":32384,"word":"疾声大呼","pinyin":"jí shēng dà hū","abbr":"jsdh","explanation":"疾：急速。急促而大声的呼喊，以引起注意。","source":{"text":"咸淳间史馆校勘谢坊得过弃疾墓旁僧舍，有疾声大呼于堂上，若呼其不平。","book":"《宋史·辛弃疾传》"},"example":{"text":"不怕死的，跟我上！","book":"他～"},"usage":"作谓语；指大叫"},{"id":32385,"word":"疾如旋踵","pinyin":"jí rú xuán zhǒng","abbr":"jrxz","explanation":"旋踵：转动脚跟。快得就像转动一下脚跟。形容变化很快。","source":{"text":"一得一失，易于反掌，一兴一亡，疾如旋踵，为国家者可不务乎？","book":"唐·冯用之《机论上》"},"usage":"作谓语、状语；形容事情变化很快"},{"id":32386,"word":"疾如雷电","pinyin":"jí rú léi diàn","abbr":"jrld","explanation":"快提就像雷鸣闪电。形容形势发展很迅速。","source":{"text":"项羽用兵疾如雷电。","book":"汉·荀悦《汉纪·高祖纪》"},"usage":"作谓语、状语；形容事情发展很迅速"},{"id":32387,"word":"疾如风，徐如林","pinyin":"jí rú fēng，xú rú lín","abbr":"jrfxrl","explanation":"疾：迅速；徐：舒缓，缓慢。行动迅速时像风一样快，行动减慢时像树林一样齐整。多用以形容军队步调一致，行动统一。","example":{"text":"《孙子·军争》：“故其疾如风，其徐如林，侵掠如火，不动如山，难知如阴，动如雷震。”"}},{"id":32388,"word":"疾恶好善","pinyin":"jí è hào shàn","abbr":"jehs","explanation":"痛恨邪恶，喜悦善良。形容爱憎分明。","source":{"text":"至激浊扬清，疾恶好善，臣于数子有一日之长。","book":"《新唐书·王珪传》"},"example":{"text":"他就是～的性格。"},"similar":["疾恶向善"],"usage":"作谓语、定语；指人爱憎分明","story":["唐朝时期，唐太宗十分赏识敢于直言的王珪，他让王珪评论房玄龄、李靖、魏征等人。王珪回答：在治理国事操劳方面自己不如房玄龄；文武全才、出将入相比不上李靖；谏争方面比不上魏征，但在激浊扬清、嫉恶好善方面他要超过他们四人"]},{"id":32389,"word":"疾恶如仇","pinyin":"jí è rú chóu","abbr":"jerc","explanation":"疾：憎恨；恶：指坏人坏事。憎恨坏人坏事就象憎恨仇人一样。","source":{"text":"见善若惊，疾恶若仇。","book":"汉·孔融《荐祢衡表》"},"example":{"text":"他对军阀、政客，～。","book":"梁斌《红旗谱》二十二"},"similar":["义不容辞","见义勇为"],"opposite":["从善如流","同流合污"],"usage":"作谓语、定语；指人的个性","story":["西晋时期，御史中丞司录校尉傅咸为人正直无私，为官也是疾恶如仇。有一年因发生自然灾害而闹饥荒，百姓流落失所，饿死冻死无数，晋惠帝竟责怪他们为什么不吃肉粥。傅咸说明道理，力谏处理朝中奢侈浪费，救济灾民"]},{"id":32390,"word":"疾恶如雠","pinyin":"jí è rú chóu","abbr":"jerc","explanation":"憎恨坏人坏事就象憎恨仇人一样。同“疾恶如仇”。","source":{"text":"顺昌为人刚方贞介，疾恶如雠。","book":"《明史·周顺昌传》"},"similar":["疾恶如仇","疾恶若雠"],"usage":"作谓语、定语；指人的个性"},{"id":32391,"word":"疾恶如风","pinyin":"jí è rú fēng","abbr":"jerf","explanation":"痛恨坏人坏事就像狂风猛扫一样。","source":{"text":"震（朱震）字伯厚，初为州从事，奏济阴太守单匡臧罪，并连匡兄中常侍车骑将军超。桓帝收匡下廷尉，以谴超，超诣狱谢。三府谚曰：‘车如鸡栖马如狗，疾恶如风朱伯厚。’","book":"《后汉书·陈蕃传》"},"example":{"text":"～最不平，天涯何处有荆卿。","book":"明·陈子龙《哭张天如先生》诗"},"usage":"作谓语、定语；指人的个性","story":["汉朝时期，朱震字伯厚，为人正直，在担任州从事时，他上奏朝廷说济阴太守单匡贪赃枉法，并牵连单匡的兄长中常侍车骑将军单超。汉桓帝收单匡下廷尉，以警告单超，单超亲自请求入狱以谢罪。人们评论说：“车如鸡栖马如狗，疾恶如风朱伯厚。”"]},{"id":32392,"word":"疾恶若仇","pinyin":"jí è ruò chóu","abbr":"jerc","explanation":"疾：憎恨；恶：坏人坏事。憎恨坏人坏事就像憎恨仇人一样。","source":{"text":"忠果正直，志怀霜月，见善若惊，疾恶若仇。","book":"汉·孔融《荐祢衡表》"},"example":{"text":"纬方雅，～。","book":"《新唐书·孔纬传》"},"similar":["疾恶如仇"],"opposite":["同流合污"],"usage":"作谓语、定语；指人的个性"},{"id":32393,"word":"疾恶若雠","pinyin":"jí è ruò chóu","abbr":"jerc","explanation":"憎恨坏人坏事就象憎恨仇人一样。同“疾恶如仇”。","source":{"text":"见善若惊，疾恶若雠。","book":"汉·孔融《荐祢衡表》"},"similar":["疾恶如雠","疾恶如仇"],"usage":"作谓语、定语；指人的个性"},{"id":32394,"word":"疾电之光","pinyin":"jí diàn zhī guāng","abbr":"jdzg","explanation":"疾：疾速，快速；电：闪电。像迅急的闪电射出的光。形容变化急速。","source":{"text":"或如迸豆之急，或如惊马之驰，或如疾电之光。","book":"清·曹雪芹《红楼梦》第五十四回"}},{"id":32395,"word":"疾病相扶","pinyin":"jí bìng xiāng fú","abbr":"jbxf","explanation":"有病的互相扶助。指患难时互相关心帮助。","source":{"text":"死徙无出乡，乡田同井，出入相友，守望相助，疾病相扶持，则百姓亲睦。","book":"先秦·孟轲《孟子·滕文公上》"},"example":{"text":"邻家邻舍的，总要守望相助，～。","book":"马烽《吕梁英雄传》第五回"},"similar":["同病相怜"],"usage":"作宾语；指患难时互相帮助"},{"id":32396,"word":"疾痛惨怛","pinyin":"jí tòng cǎn dá","abbr":"jtcd","explanation":"惨怛：忧伤，悲苦。因病痛而感到忧伤，悲苦。","source":{"text":"人穷则反本，故劳苦倦极，未尝不呼天地也；疾痛惨怛，未尝不呼父母也。","book":"《史记·屈原贾生列传》"},"usage":"作谓语、定语；指痛苦的情怀"},{"id":32397,"word":"疾裘妒枕","pinyin":"jí qiú dù zhěn","abbr":"jqdz","explanation":"夫妻间对双方有外遇的嫉妒。","example":{"text":"夫妻间都会有～的现象。"},"usage":"作宾语、定语；用于口语"},{"id":32398,"word":"疾言倨色","pinyin":"jí yán jù sè","abbr":"jyjs","explanation":"形容对人发怒时说话的神情。同“疾言遽色”。","source":{"text":"[二弟]稍不率教，辄跪于家庙之前，痛自督责，说自已德行不足，不能化诲……直待兄弟号泣请罪，方才起身。并不以疾言倨色相加也。","book":"《醒世恒言·三孝廉让产立高名》"},"similar":["疾言遽色"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":32399,"word":"疾言厉气","pinyin":"jí yán lì qì","abbr":"jylq","explanation":"形容对人发怒说话时的神情。同“疾言厉色”。","source":{"text":"接人和而有礼，寡言峻行，未尝有矜大之色，虽家人不见其疾言厉气。","book":"明·宋濂《元故秘书少监揭君墓碑》"},"similar":["疾言厉色"],"usage":"作谓语、宾语；指人发怒"},{"id":32400,"word":"疾言厉色","pinyin":"jí yán lì sè","abbr":"jyls","explanation":"疾：急速。说话急躁，脸色严厉。形容对人发怒说话时的神情。","source":{"text":"虽在仓卒，未尝疾言遽色。","book":"《后汉书·刘宽传》"},"example":{"text":"对于这种学生，我易于～，似乎予人以难堪，事后往往后悔。","book":"邹韬奋《经历·一种有趣的工作》"},"similar":["声色俱厉"],"opposite":["巧言令色","和颜悦色"],"usage":"作谓语、宾语；指人发怒"},{"id":32401,"word":"疾言怒色","pinyin":"jí yán nù sè","abbr":"jyns","explanation":"形容对人发怒说话时的神情。同“疾言厉色”。","source":{"text":"为人宽厚和平，平生未尝有疾言怒色，有犯者皆不与校。","book":"清·戴名世《张验封传》"},"similar":["疾言厉色","疾声厉色"],"usage":"作谓语、宾语；指人发怒"},{"id":32402,"word":"疾言遽色","pinyin":"jí yán jù sè","abbr":"jyjs","explanation":"疾：快，急速；遽：仓猝，急。言语神色粗暴急躁。形容对人发怒时说话的神情。","source":{"text":"虽在仓卒，未尝疾言遽色。","book":"《后汉书·刘宽传》"},"example":{"text":"襄公把个盟主捏在掌中，临时变卦，如何不恼。包着一肚子气，不免～。","book":"明·冯梦龙《东周列国志》第三十三回"},"similar":["疾言倨色"],"opposite":["和颜悦色"],"usage":"作定语、状语；形容对人发怒时说话的神情"},{"id":32403,"word":"疾走先得","pinyin":"jí zǒu xiān dé","abbr":"jzxd","explanation":"比喻行动迅速的人首先达到目的。同“疾足先得”。","source":{"text":"秦失其鹿，疾走先得。","book":"汉·焦赣《易林·损之井》"},"similar":["疾足先得"],"usage":"作谓语、定语、宾语；用于处事"},{"id":32404,"word":"疾足先得","pinyin":"jí zú xiān dé","abbr":"jzxd","explanation":"比喻行动迅速的人首先达到目的。","source":{"text":"秦失其鹿，天下共逐之，于是高材疾足者先得焉。","book":"《史记·淮阴侯列传》"},"similar":["捷足先登","疾走先得"],"usage":"作谓语、定语；比喻行动迅速的人先达到目的"},{"id":32405,"word":"疾雨暴风","pinyin":"jí yǔ bào fēng","abbr":"jybf","explanation":"指来势急遽而猛烈的风雨。同“暴风疾雨”。","source":{"text":"是日果有疾雨暴风，从太公邑外而过。","book":"晋·干宝《搜神记》卷四"},"similar":["疾风暴雨","暴风骤雨"],"opposite":["和风细雨"],"usage":"作主语、宾语、定语；比喻迅猛激烈的斗争"},{"id":32406,"word":"疾雷不及塞耳","pinyin":"jí léi bù jí sāi ěr","abbr":"jlbjse","explanation":"比喻事情或动作来得突然，使人来不及防备。同“疾雷不及掩耳”。","source":{"text":"故善用兵者，见敌之虚，乘而勿假也，追而勿舍也，迫而勿去也，击其犹犹，陵其与与，疾雷不及塞耳，疾霆不暇掩目。","book":"《淮南子·兵略训》"},"similar":["疾雷不及掩耳","疾雷不暇掩耳"],"usage":"作宾语、定语、分句；比喻事情来得突然"},{"id":32407,"word":"疾雷不及掩耳","pinyin":"jí léi bù jí yǎn ěr","abbr":"jlbjye","explanation":"突然响起雷声，使人来不及掩耳。比喻事情或动作来得突然，使人来不及防备。","source":{"text":"疾雷不及掩耳，迅电不及瞑目。","book":"《六韬·龙韬·军势》"},"example":{"text":"他们或者未必起身，给他们个疾雷不及掩耳，拿了就走，必不使一名漏网。","book":"清·李宝嘉《文明小史》第七回"},"similar":["迅雷不及掩耳"],"usage":"作宾语、定语、分句；比喻事情来得突然","story":["东汉末年，曹操进攻黄河流域的马超和韩遂，把马超打败。马超要求割地求和，曹操不答应，占领渭口后修筑工事后，表面答应议和，暗中养精蓄锐，接着以疾雷不及掩耳之势向马超突然袭击，将丝毫没有防范的马超打得大败而逃"]},{"id":32408,"word":"疾雷不暇掩耳","pinyin":"jí léi bù xiá yǎn ěr","abbr":"jlbxye","explanation":"比喻事情或动作来得突然，使人来不及防备。同“疾雷不及掩耳”。","source":{"text":"我欲战而彼不欲战者，我鼓而进之若山崩河溢，当其冲者摧，值其锋者破，所谓疾雷不暇掩耳，则又谁御之。","book":"晋·傅玄《傅子·阙题》"},"similar":["疾雷不及塞耳"],"usage":"作宾语、定语、分句；比喻事情来得突然"},{"id":32409,"word":"疾雷迅电","pinyin":"jí léi xùn diàn","abbr":"jlxd","explanation":"疾、迅：快速，迅急。突然暴发的雷声和出现的闪电。形容来势迅猛，来不及防备。","source":{"text":"他来的快，去得也快。一来一去，其势有若疾雷迅电。","book":"萧逸《马鸣风萧萧》二十二"}},{"id":32410,"word":"疾霆不暇掩目","pinyin":"jí tíng bù xiá yǎn mù","abbr":"jtbxym","explanation":"比喻事情或动作来得突然，使人来不及防备。同“疾雷不及掩耳”。","source":{"text":"故善用兵者，见敌之虚，乘而勿假也，追而勿舍也，迫而勿去也，击其犹犹，陵其与与，疾雷不及塞耳，疾霆不暇掩目。","book":"《淮南子·兵略训》"},"similar":["疾雷不及塞耳","疾雷不及掩耳"],"usage":"作宾语、定语、分句；比喻事情来得突然"},{"id":32411,"word":"疾风劲草","pinyin":"jí fēng jìn cǎo","abbr":"jfjc","explanation":"在猛烈的大风中，只有坚韧的草才不会被吹倒。比喻只有经过严峻的考验，才知道谁真正坚强。","source":{"text":"颍川从我者皆逝，而子独留，始验疾风知劲草。","book":"《东观汉记·王霸传》"},"example":{"text":"被坚执锐，或有其人，～，岁寒方验。","book":"《周书·裴宽传》"},"similar":["疾风知劲草"],"usage":"作宾语、定语；比喻立场坚定，忠贞可靠","story":["新朝末年，全国爆发了农民大起义，皇族刘秀与刘演联合起兵，王霸前来投奔刘秀。更始帝刘玄借故杀了刘演，刘秀只好带兵进军河北，一路十分艰难，只有王霸始终如一跟随他。刘秀感慨地说：“只有在迅猛的风中才看出坚韧的草。”"]},{"id":32412,"word":"疾风彰劲草","pinyin":"jí fēng zhāng jìn cǎo","abbr":"jfzjc","explanation":"比喻只有经过严峻的考验，才知道谁真正坚强。同“疾风知劲草”。","source":{"text":"洎高贵薨殂，则枕尸流恸；陈留就国，则拜辞陨涕。语曰‘疾风彰劲草’，献王其有焉。","book":"《晋书·宗室传论》"},"similar":["疾风知劲草"],"usage":"作宾语、定语、分句；指人的节操坚定"},{"id":32413,"word":"疾风扫秋叶","pinyin":"jí fēng sǎo qiū yè","abbr":"jfsqy","explanation":"疾：猛烈。比喻力量强大、行动迅速，象暴风扫除落叶一样。","source":{"text":"以吾出晋，校其强弱之势，犹疾风之扫秋叶。","book":"宋·司马光《资治通鉴·晋孝武帝太元七年》"},"example":{"text":"才能表现我们真正革命的精神，所以就有这样快——如～——的胜利。","book":"廖仲恺《对黄埔军校第三期入伍生训话》"},"similar":["疾风扫落叶"],"usage":"作宾语；比喻力量强大，进展迅速，所向无阻","story":["前秦皇帝苻坚实行严厉统治，加强前秦的军事实力，先后消灭了前燕、前凉、代国，统一北方黄河流域，并占领东晋的部分土地。383年，他不顾文武百官的反对，认为打东晋是疾风扫落叶一般，亲率90万大军进攻东晋，结果惨败身"]},{"id":32414,"word":"疾风扫落叶","pinyin":"jí fēng sǎo luò yè","abbr":"jfsly","explanation":"疾：猛烈。比喻力量强大、行动迅速，象暴风扫除落叶一样。","source":{"text":"以明公之威，应困穷之敌，击疲弊之寇，无异迅风之振秋叶矣。","book":"《三国志·魏志·辛毗传》"},"similar":["疾风劲草","疾风扫秋叶"],"usage":"作宾语；比喻力量强大，进展迅速","story":["前秦皇帝苻坚实行严厉统治，加强前秦的军事实力，先后消灭了前燕、前凉、代国，统一北方黄河流域，并占领东晋的部分土地。383年，他不顾文武百官的反对，认为打东晋是疾风扫落叶一般，亲率90万大军进攻东晋，结果惨败身亡"]},{"id":32415,"word":"疾风暴雨","pinyin":"jí fēng bào yǔ","abbr":"jfby","explanation":"疾：又快又猛；暴：突然而猛烈。形容风雨来势猛。比喻迅猛激烈的斗争。","source":{"text":"何谓隐之天？大寒甚暑，疾风暴雨，大雾冥晦，因此而为变者也。","book":"《淮南子·兵略训》"},"example":{"text":"斧照伯当上三路，如飘泼盆倾，～，砍剁下来。","book":"清·禇人获《隋唐演义》第二十二回"},"similar":["暴风骤雨","疾雨暴风"],"opposite":["和风细雨"],"usage":"作主语、宾语、定语；比喻迅猛激烈的斗争"},{"id":32416,"word":"疾风横雨","pinyin":"jí fēng héng yǔ","abbr":"jfhy","explanation":"疾：急速猛烈。形容声势浩大，来势迅猛。","source":{"text":"华叶蓊郁，而必归于槁亡，遇疾风横雨，则摧落更速焉。","book":"梁启超《新民说》第八节"},"similar":["疾风暴雨","迅风暴雨","疾风骤雨"],"opposite":["和风细雨"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":32417,"word":"疾风甚雨","pinyin":"jí fēng shèn yǔ","abbr":"jfsy","explanation":"指大风急雨。","source":{"text":"君子之居恒当户，寝恒东首，若有疾风、迅雷、甚雨，则必变，虽夜必兴，衣服冠而坐。","book":"语出《礼记·玉藻》"},"example":{"text":"去冬节一百五日，即有～，谓之寒食。","book":"南朝·梁·宗懔《荆梦岁时记》"},"similar":["疾风暴雨","暴风骤雨"],"usage":"作宾语、定语；用于自然现象"},{"id":32418,"word":"疾风知劲草","pinyin":"jí fēng zhī jìn cǎo","abbr":"jfzjc","explanation":"在猛烈的大风中，只有坚韧的草才不会被吹倒。比喻只有经过严峻的考验，才知道谁真正坚强。","source":{"text":"颍川从我者皆逝，而子独留，始验疾风知劲草。","book":"《东观汉记·王霸传》"},"example":{"text":"俗语说：“～。”经过这一段不平凡的日子，人们对于前进的道路是看得更加清楚了，信心也更加坚定了。","book":"峻青《瑞雪图》"},"similar":["烈火真金","路遥知马力"],"usage":"作宾语、定语、分句；指人的节操坚定","story":["新朝末年，全国爆发了农民大起义，皇族刘秀与刘演联合起兵，王霸前来投奔刘秀。更始帝刘玄借故杀了刘演，刘秀只好带兵进军河北，一路十分艰难，只有王霸始终如一跟随他。刘秀感慨地说：“只有在迅猛的风中才看出坚韧的草。”"]},{"id":32419,"word":"疾风迅雷","pinyin":"jí fēng xùn léi","abbr":"jfxl","explanation":"形容事情的发生和发展，象暴风急雷那样猛烈而迅速。","source":{"text":"君子之居恒当户，寝恒东首，若有疾风、迅雷、甚雨，则必变，虽夜必兴，衣服冠而坐。","book":"西汉·戴圣《礼记·玉藻》"},"example":{"text":"～，清阴暖日，就是平平常常一时一节的心绪，也有几多自然现象的反映。","book":"瞿秋白《饿乡纪程》二"},"usage":"作宾语、定语；形容事情的迅速发生和发展"},{"id":32420,"word":"疾风骤雨","pinyin":"jí fēng zhòu yǔ","abbr":"jfzy","explanation":"疾：又快又猛；骤：突然而猛烈。形容风雨来势猛。比喻迅猛激烈的斗争。","source":{"text":"何谓隐之天？大寒甚暑，疾风暴雨，大雾冥晦，因此而为变者也。","book":"《淮南子·兵略训》"},"example":{"text":"十来个妇人，一个个粗脚大手，祼臂揎拳，如～而来。","book":"明·冯梦龙《醒世恒言》卷三十四"},"similar":["疾风暴雨","疾风横雨"],"opposite":["和风细雨"],"usage":"作主语、宾语、定语；形容风雨来势猛"},{"id":32421,"word":"疾首痛心","pinyin":"jí shǒu tòng xīn","abbr":"jstx","explanation":"①伤心到时极点。②痛恨到极点。","source":{"text":"不意将军惑于邪说，翻然异计，寄所以疾首痛心，泣尽继之以血，万全之策，窃为将军惜之。","book":"《汉魏南北朝墓志集释·曹海凝墓志》：“民嗟邑主，疾首痛心。”《南史·虞寄传》"},"example":{"text":"天下愚夫愚妇莫不～，愿得伸锄奋挺以致死于敌。","book":"宋·岳飞《奏乞本军进计刘豫札子》"},"similar":["痛心疾首"],"usage":"作谓语、状语、补语；指对某事的痛恨"},{"id":32422,"word":"疾首蹙頞","pinyin":"jí shǒu cù é","abbr":"jsce","explanation":"疾首：头痛；蹙：皱。形容厌恶、痛恨的样子。","source":{"text":"举疾首蹙額而相告曰：‘吾王之好鼓乐，夫何使我至于此极也，父子不相见，兄弟妻子离散。","book":"战国·邹·孟轲《孟子·梁惠王下》"},"example":{"text":"驰骋宴乐，岂知小民～赴诉之无路。","book":"《明史·陆昆传》"},"similar":["疾首蹙额"],"usage":"作谓语、宾语、定语；形容厌恶痛恨的样子"},{"id":32423,"word":"疾首蹙额","pinyin":"jí shǒu cù é","abbr":"jsce","explanation":"疾首：头痛；蹙眉：皱眉。形容厌恶痛恨的样子。","source":{"text":"举疾首蹙额而相告曰：‘吾王之好鼓乐，夫何使我至于此极也？父子不相见，兄弟妻子离散。","book":"《孟子·梁惠王下》"},"example":{"text":"一听到劝捐二字，百姓就一个个～，避之惟恐不遑，此中缘故，就在有信、无信两个分别。","book":"清·李宝嘉《文明小史》第四十八回"},"similar":["咬牙切齿","深恶痛绝","痛心疾首"],"opposite":["笑逐颜开","眉飞色舞"],"usage":"作谓语、宾语、定语；形容厌恶痛恨的样子"},{"id":32424,"word":"痀偻承蜩","pinyin":"jū lóu chéng tiáo","abbr":"jlct","explanation":"痀偻：曲背；承：粘；蜩：蝉。驼背老人粘蝉。比喻做事专心才能成功。","source":{"text":"仲尼适楚，出于林中，见痀偻承蜩，犹掇之也。","book":"《庄子·达生》"}},{"id":32425,"word":"病从口入","pinyin":"bìng cóng kǒu rù","abbr":"bckr","explanation":"疾病多是由食物传染。比喻应该注意饮食卫生。","source":{"text":"病从口入，祸从口出。","book":"晋·傅玄《口铭》"},"example":{"text":"我们要讲究饮食卫生，防止～。"},"similar":["病由口入"],"usage":"作分句、宾语、定语；比喻应该注意饮食卫生"},{"id":32426,"word":"病从口入，祸从口出","pinyin":"bìng cóng kǒu rù，huò cóng kǒu chū","abbr":"bckrhckc","explanation":"疾病常因饮食不慎而发生，祸患常因说话不慎而造成。","source":{"text":"病从口入，祸从口出。","book":"晋·傅玄《口铭》"},"example":{"text":"～，见庄绰《鸡肋编》，谓当时谚语。","book":"清·赵翼《陔余丛考·成语》"}},{"id":32427,"word":"病僧劝患僧","pinyin":"bìng sēng quàn huàn sēng","abbr":"bsqhs","explanation":"形容同病相怜，互相慰藉。","source":{"text":"也不是我病僧劝患僧，有一日押向云阳市上行，只等的叫开刀和那声。","book":"元·无名氏《燕青捕鱼》第三折"}},{"id":32428,"word":"病入膏肓","pinyin":"bìng rù gāo huāng","abbr":"brgh","explanation":"膏肓：古人把心尖脂肪叫“膏”，心脏与膈膜之间叫“肓”。形容病情十分严重，无法医治。比喻事情到了无法挽救的地步。","source":{"text":"疾不可为也，在肓之上，膏之下，攻之不可，达之不及，药不至焉，不可为也。","book":"《左传·成公十年》"},"example":{"text":"吾观刘琦过于酒色，～，今见面黄羸瘦，气喘呕血，不过半年，其人必死。","book":"明·罗贯中《三国演义》第五十二回"},"similar":["人命危浅","行将就木","不可救药"],"opposite":["妙手回春","手到病除"],"usage":"作谓语、定语；用于事物或人","story":["春秋时期，晋国国君晋景公得了重病，秦国国王秦桓公派名医缓前去为其治病。缓来到晋国，见到晋景公，把好脉后摇头叹息说：“大王的病已经到了肓上面，膏下面，药力是无法到达的。”果然，没过多久，晋景公就病死了"]},{"id":32429,"word":"病入骨隨","pinyin":"bìng rù gǔ suǐ","abbr":"brgs","explanation":"骨隨：骨髓。病到骨头里。形容病势严重无法医治或事态严重无法挽救。","source":{"text":"疾在腠理，汤熨之所及也；在肌肤，鍼石之所及也；在肠胃，火齐之所及也；在骨隨，司命之所属，无奈何也。今在骨隨，臣是以无请也。","book":"先秦·韩非《韩非子·喻老》"}},{"id":32430,"word":"病入骨雜","pinyin":"bìng rù gǔ suǐ","abbr":"brgs","explanation":"骨雜骨髓。病到骨头里。形容病势严重无法医治或事态严重无法挽救。","source":{"text":"疾在腠理，汤熨之所及也；在肌肤，鎝石之所及也；在肠胃，火齐之所及也；在骨雜，司命之所属，无奈何也。今在骨雜，臣是以无请也。","book":"先秦·韩非《韩非子·喻老》"}},{"id":32431,"word":"病入骨髓","pinyin":"bìng rù gǔ suǐ","abbr":"brgs","explanation":"病到骨头里。形容病势严重，无法医治。也比喻事态严重，无法挽救。","source":{"text":"疾在腠理，汤熨之所及也；在肌肤，鍼石之所及也；在肠胃，火齐之所及也；在骨髓，司命之所属，无奈何也。今在骨髓，臣是以无请也。","book":"《韩非子·喻老》"},"similar":["病入膏肓"],"opposite":["手到病除"],"usage":"作谓语、定语；用于事物或人"},{"id":32432,"word":"病势尪羸","pinyin":"bìng shì wāng léi","abbr":"bswl","explanation":"尪羸：瘦弱。病势严重，身体瘦弱。","source":{"text":"此正如病势尪羸已极之时也。","book":"明·罗贯中《三国演义》第43回"},"usage":"作谓语、定语；指人生病"},{"id":32433,"word":"病去如抽丝","pinyin":"bìng qù rù chōu sī","abbr":"bqrcs","explanation":"形容病愈很快而且彻底。","example":{"text":"病来如山倒，～”是有一定道理","book":"俗话说"},"opposite":["病来如山倒"],"usage":"作宾语、分句；形容病愈"},{"id":32434,"word":"病国殃民","pinyin":"bìng guó yāng mín","abbr":"bgym","explanation":"使国家受害，人民遭受苦难。","source":{"text":"只为李林甫、杨国忠相继为相，妒贤嫉能，病国殃民，屈在下僚，不能施展其才。","book":"明·冯梦龙《醒世恒言》第30卷"},"example":{"text":"你们的结果必弄得～。"},"similar":["祸国殃民"],"opposite":["利国福民"],"usage":"作状语、定语；同“祸国殃民”"},{"id":32435,"word":"病在膏肓","pinyin":"bìng zài gāo huāng","abbr":"bzgh","explanation":"比喻事情到了无法挽救的地步。同“病入膏肓”。","source":{"text":"今天下之病在膏肓者久，夫人而能知之，夫人而欲言之，顾以不当其任，虽欲一效其伎而无所施耳。","book":"宋·朱熹《与台端书》"},"example":{"text":"便遇秦和医国手，只恐他～怎救？","book":"明邵璨《香囊记·问卜》"},"similar":["病染膏肓","病入膏肓"],"opposite":["妙手回春"],"usage":"作谓语、定语；用于事物或人"},{"id":32436,"word":"病急乱投医","pinyin":"bìng jí luàn tóu yī","abbr":"bjlty","explanation":"病势沉重，到处乱请医生。比喻事情到了紧急的时候，到处求人或乱想办法。","source":{"text":"紫鹃笑道：‘你也念起佛来，真是新闻！’宝玉笑道：‘所谓病急乱投医了。’","book":"清·曹雪芹《红楼梦》第57回"},"example":{"text":"先生身上也产生了对前一阶段我们革命方略的怀疑，有一种～的情绪。","book":"鲁彦周《廖仲恺》"},"similar":["病笃乱投医","病急乱求医"],"usage":"作宾语、定语、分句；形容时势危急盲目求援"},{"id":32437,"word":"病急乱求医","pinyin":"bìng jí luàn qiú yī","abbr":"bjlqy","explanation":"病情危急不审医术好坏就去就诊。比喻事势危急盲目求援。","source":{"text":"他真是病急乱求医！","book":"路遥《平凡的世界》第四卷第47章"},"similar":["病急乱投医"],"usage":"作宾语、定语、分句；形容时势危急盲目求援"},{"id":32438,"word":"病来如山倒","pinyin":"bìng lái rú shān dǎo","abbr":"blrsd","explanation":"形容疾病发作得快。","source":{"text":"俗语说：‘病来如山倒，病去如抽丝。’不是老君的仙丹，那有这么灵药？","book":"清·曹雪芹《红楼梦》第五十二回"}},{"id":32439,"word":"病染膏肓","pinyin":"bìng rǎn gāo huāng","abbr":"brgh","explanation":"比喻事情到了无法挽救的地步。同“病入膏肓”。","source":{"text":"真个崔张不让，命该凋丧，险些病染膏肓，此言非妄。","book":"元·范居中《金殿喜重重·秋思》"},"example":{"text":"她已经～，不久于人世了。"},"similar":["病入膏肓","病在膏肓"],"opposite":["手到病除"],"usage":"作谓语、定语；用于事物或人"},{"id":32440,"word":"病民害国","pinyin":"bìng mín hài guó","abbr":"bmhg","explanation":"病：损坏，祸害。害人民、害国家。","source":{"text":"从未问津，致一是云为，自亏自损，病民害国，暗不自知。","book":"清·严复《救亡决论》"},"similar":["病民蛊国"],"usage":"作谓语、宾语、定语；指坏人害国"},{"id":32441,"word":"病民蛊国","pinyin":"bìng mín gǔ guó","abbr":"bmgg","explanation":"病：损坏，祸害；蛊：相传为人工培养的毒虫，引伸为毒害。害人民、害国家。","source":{"text":"昔刘晏桑弘羊，利尽缁铢，而未尝病国病民，后世犹说其聚敛。","book":"明·天然痴叟《石点头·贪婪汉六院卖风流》"},"example":{"text":"吾辈～不能仇，现在之执法者也。","book":"清·纪昀《阅微草堂笔记》卷五"},"similar":["病国殃民"],"usage":"作宾语、定语；指祸害"},{"id":32442,"word":"病狂丧心","pinyin":"bìng kuáng sàng xīn","abbr":"bksx","explanation":"狂：疯狂；丧：丧失。丧失理智，像发了疯一样。形容言行昏乱而荒谬。","source":{"text":"用微言自周、程、朱、陆、杨、陈、王、罗之说渐染斯民之耳目，而后圣学失传，可不为病狂丧心之言与？","book":"清·黄宗羲《与友人论学书》"},"example":{"text":"清·黄宗羲《与友人论学书》：“用微言自周、程、朱、陆、杨、陈、王、罗之说渐染斯民之耳目，而后圣学失传，可不为～之言与？”"},"similar":["丧心病狂"],"opposite":["心平气和"],"usage":"作谓语、定语；指人发昏"},{"id":32443,"word":"病由口入","pinyin":"bìng yóu kǒu rù","abbr":"bykr","explanation":"疾病多是由食物传染。比喻应该注意饮食卫生。同“病从口入”。","source":{"text":"病由口入，节宣方也；生劳败静，养道性也。","book":"《云笈七签》卷三五"},"similar":["病从口入"],"usage":"作宾语、定语；劝诫注意饮食卫生"},{"id":32444,"word":"病病歪歪","pinyin":"bìng bìng wāi wāi","abbr":"bbww","explanation":"形容病体衰弱无力的样子。","source":{"text":"你教大爷歇歇吧，他病病歪歪！","book":"老舍《龙须沟》第一幕"},"example":{"text":"你这副～的样子让人不舒服。"},"similar":["病病殃殃"],"usage":"作谓语、定语；指人或动植物"},{"id":32445,"word":"病病殃殃","pinyin":"bìng bìng yāng yāng","abbr":"bbyy","explanation":"形容病了很久，身体虚弱委靡不振的样子。","example":{"text":"我不喜欢你～的样子。"},"similar":["病病歪歪"],"usage":"作谓语、状语、定语；用于人或动植物"},{"id":32446,"word":"病笃乱投医","pinyin":"bìng dǔ luàn tóu yī","abbr":"bdlty","explanation":"病势沉重，到处乱请医生。比喻事情到了紧急的时候，到处求人或乱想办法。同“病急乱投医”。","source":{"text":"做牢靠的时候是‘偃武修文’，粉饰粉饰；做倒霉的时候是又以为他们真有‘治国平天下’的大道，再问问看，要说得直白一点，就是见于《红楼梦》上的所谓‘病笃乱投医’了。","book":"鲁迅《二心集·知难行难》"},"similar":["病急乱投医"],"usage":"作定语、分句；形容时势危急盲目求援"},{"id":32447,"word":"病风丧心","pinyin":"bìng fēng sàng xīn","abbr":"bfsx","explanation":"犹病狂丧心。","source":{"text":"任之情非病风丧心，未有避赏而就刑者。","book":"宋·苏洵《谏论》"},"similar":["丧心病狂"],"opposite":["平心静气"],"usage":"作谓语、定语；指人发昏"},{"id":32448,"word":"病骨支离","pinyin":"bìng gǔ zhī lí","abbr":"bgzl","explanation":"支离：残缺不全，引伸为憔悴、衰残瘦弱的样子。形容病中体瘦骨露，衰弱无力。","source":{"text":"病骨支离纱帽宽。","book":"宋·陆游《病起书怀》诗"},"similar":["骨瘦如柴"],"opposite":["膘肥体壮"],"usage":"作谓语、定语；指人很衰弱"},{"id":32449,"word":"病魔缠身","pinyin":"bìng mó chán shēn","abbr":"bmcs","explanation":"指长期患病。","source":{"text":"（病魔）谓疾病缠身。","book":"《辞海·词语分册下》"},"example":{"text":"他一直～，至今还没有康复。"},"similar":["疾病缠身"],"usage":"作谓语、定语；指不健康"},{"id":32450,"word":"症结所在","pinyin":"zhēng jié suǒ zài","abbr":"zjsz","explanation":"症结：肚子里结块的病。比喻事情或问题的关键所在。","source":{"text":"沈潜二十余年，乃尽得其症结所在。","book":"清·江藩《汉学师承记·阎若璩》"},"usage":"作宾语；指问题所在"},{"id":32451,"word":"痌瘝在抱","pinyin":"tōng guān zào bào","abbr":"tgzb","explanation":"痌瘝：病痛，比喻疾苦；在抱：在胸怀中。把人民的疾苦放在心里。","source":{"text":"恫瘝乃身。","book":"《尚书·康诰》"},"example":{"text":"前回一个大善士，专诚到扬州动劝捐，做得那种～，愁眉苦目的样子。","book":"清·吴趼人《二十年目睹之怪现状》第六十回"},"similar":["恫瘝在身"],"usage":"作定语；用于统治者"},{"id":32452,"word":"痒磨树者","pinyin":"yang mo shu zhe","abbr":"ymsz","explanation":"因为痒而在树上磨蹭的。"},{"id":32453,"word":"痛下针砭","pinyin":"tòng xià zhēn biān","abbr":"txzb","explanation":"针砭：古代以砭石为针的治病方法。比喻痛彻尖锐地批评错误，以便改正。","source":{"text":"时时苦语见针砭，邂逅天涯得三益。","book":"宋·范成大《晞真阁留别方道士宾实》诗"},"example":{"text":"《慎疾刍言》，为溺于邪说俗见者～。","book":"《清史稿·艺术传·徐大椿》"},"usage":"作谓语、定语；用于书面语"},{"id":32454,"word":"痛不可忍","pinyin":"tòng bù kě rěn","abbr":"tbkr","explanation":"痛苦得不能忍受。","source":{"text":"稍久左右噬食，痛不可忍，凡月余而死。","book":"宋·洪迈《夷坚甲志·人生鳖》"},"example":{"text":"她到了～的地步才哭泣。"},"similar":["痛不堪忍"],"usage":"作谓语、定语；指十分痛苦"},{"id":32455,"word":"痛不堪忍","pinyin":"tòng bù kān rěn","abbr":"tbkr","explanation":"痛苦得不能忍受。","source":{"text":"某是某朝官，葬堂阶西树下。体魄为树根所穿，楚痛不堪忍。","book":"唐·载浮《广异记·狄仁杰》"},"similar":["痛不可忍"],"usage":"作谓语、定语；指十分痛苦"},{"id":32456,"word":"痛不欲生","pinyin":"tòng bù yù shēng","abbr":"tbys","explanation":"悲痛得不想活下去。形容悲痛到极点。","source":{"text":"其恻怛之心、痛疾之意不欲生。","book":"宋·吕大钧《吊说》"},"example":{"text":"先兄晴湖言：有王震升者，暮年丧爱子，～。","book":"清·纪昀《阅微草堂笔记》卷十一"},"similar":["悲痛欲绝","痛哭流涕"],"opposite":["欣喜若狂"],"usage":"作谓语、定语、状语；指十分悲痛"},{"id":32457,"word":"痛之入骨","pinyin":"tòng zhī rù gǔ","abbr":"tzrg","explanation":"伤痛入骨髓。形容伤心到了极点。","source":{"text":"齐为无道，以害先王，寡人统位，痛之入骨。","book":"《全相平话·七国春秋》"},"similar":["痛切心骨","痛心刻骨","痛心入骨"],"usage":"作谓语、定语；形容伤心到了极点"},{"id":32458,"word":"痛入心脾","pinyin":"tòng rù xīn pí","abbr":"trxp","explanation":"形容悲痛到了极点。","source":{"text":"[女儿]饿到六天上，不能起床，母亲看着，伤心惨目，痛入心脾，也就病倒了。","book":"《儒林外史》第四八回"},"similar":["痛入心骨","痛之入骨","痛心刻骨"],"usage":"作谓语、定语；形容伤心到了极点"},{"id":32459,"word":"痛入骨髓","pinyin":"tòng rù gǔ suǐ","abbr":"trgs","explanation":"痛到骨头里。比喻痛恨或悲伤之极。","source":{"text":"樊将军仰天太息流涕曰：‘吾每念常痛于骨髓，顾计不知所出耳！’","book":"《战国策·燕策三》"},"example":{"text":"宋襄公志欲求伯，被楚人捉弄一场，反受大辱，怨恨之情，～，但恨力不能报。","book":"明·冯梦龙《东周列国志》第三十四回"},"similar":["痛心入骨","痛彻骨髓"],"usage":"作谓语、宾语；指十分悲痛"},{"id":32460,"word":"痛切心骨","pinyin":"tòng qiè xīn gǔ","abbr":"tqxg","explanation":"伤心悲痛已到了骨髓内。形容伤心到了极点。","source":{"text":"又今相州败散，东都陷没，先帝由此忧勤，至于损寿，臣每思之，痛切心骨。","book":"《旧唐书·颜真卿传》"},"example":{"text":"义士仁人，～，岂陛下之圣明智勇而能忍之乎？","book":"清·毕沅《续资治通鉴》卷一百五十一"},"similar":["痛心入骨","痛心刻骨","痛之入骨"],"usage":"作谓语、定语；形容伤心到了极点"},{"id":32461,"word":"痛剿穷迫","pinyin":"tòng jiǎo qióng pò","abbr":"tjqp","explanation":"竭尽全力剿灭追杀。","source":{"text":"一鼓而歼之，乃西窜慈野，痛剿穷迫。斩获无数。","book":"清·王韬《瓮牑余谈·贼中悍酋记》"}},{"id":32462,"word":"痛剿穷追","pinyin":"tòng jiǎo qióng zhuī","abbr":"tjqz","explanation":"剿：征剿。竭尽全力剿灭追杀。","source":{"text":"鼓歼之，乃西窜慈野，痛剿穷追。","book":"清·王韬《瓮牖余谈·贼中悍酋记》"},"similar":["痛剿穷迫"],"usage":"作谓语、宾语；用于战斗等"},{"id":32463,"word":"痛可言邪","pinyin":"tong ke yan ye","abbr":"tkyx","explanation":"这种悲痛怎么能说得出呢？"},{"id":32464,"word":"痛哭流涕","pinyin":"tòng kū liú tì","abbr":"tklt","explanation":"涕：眼泪。形容伤心到极点。","source":{"text":"而此膝一屈不可复伸，国势陵夷不可复振，可为痛哭流涕长太息矣。","book":"《汉书·贾谊传》：“臣窃惟事势，可为痛哭者一，可为流涕者二，可为长太息者六。”《宋史·胡铨传》"},"example":{"text":"我怎能忍心告诉他，使这个老人～呢？","book":"冯德英《迎春花》第六章"},"similar":["声泪俱下","痛不欲生"],"opposite":["喜笑颜开","喜出望外"],"usage":"作谓语、定语；形容十分伤心"},{"id":32465,"word":"痛定思痛","pinyin":"tòng dìng sī tòng","abbr":"tdst","explanation":"指悲痛的心情平静以后，再追想当时所受的痛苦。常含有警惕未来之意。","source":{"text":"今而思之，如痛定之人，思当痛之时，不知何能自处也。","book":"唐·韩愈《与李翱书》"},"example":{"text":"境界危恶，层见错出，非人世所堪。～，痛何如哉！","book":"宋·文天祥《指南录后序》"},"similar":["痛不欲生","悲痛欲绝"],"opposite":["悠然自得"],"usage":"作谓语、定语、状语；用于受挫折后","story":["1275年，元军逼近南宋都城临安，文天祥率军抵抗失败，他得知赵昰在福州称帝，就前去投奔。他一路与敌兵周旋，在路上写出《指南录》一书，他总结宋朝失败的原因，痛定思痛，要把握时机，才能振兴宋朝"]},{"id":32466,"word":"痛彻心腑","pinyin":"tòng chè xīn fǔ","abbr":"tcxf","explanation":"痛到心坎里。形容痛楚非常。","source":{"text":"两骒夹击，痛彻心腑。","book":"清·蒲松龄《聊斋志异·三生》"},"example":{"text":"这些事情让她～。"},"similar":["悲痛欲绝"],"usage":"作谓语、定语；指受到极大的伤害"},{"id":32467,"word":"痛彻骨髓","pinyin":"tòng chè gǔ suǐ","abbr":"tcgs","explanation":"痛到骨头里。比喻痛恨或悲伤之极。","source":{"text":"秦父兄怨此三人，痛入骨髓。","book":"《史记·淮阴侯列传》"},"example":{"text":"哪哪吒用手连抓几把，抓下四五十片鳞甲，鲜血淋漓，～。","book":"明·许仲琳《封神演义》第十三回"},"similar":["痛入骨髓"],"usage":"作谓语、宾语；指十分悲痛"},{"id":32468,"word":"痛心伤臆","pinyin":"tòng xīn shāng yì","abbr":"txsy","explanation":"形容悲痛到极点。","source":{"text":"积敝之后，易致中兴，诚当沛然思惟善道；而论者犹云，方今之事，复同于前。臣伏从山草，痛心伤臆。","book":"《后汉书·李固传》"},"similar":["痛心切骨"],"usage":"作谓语、定语；用于书面语"},{"id":32469,"word":"痛心入骨","pinyin":"tòng xīn rù gǔ","abbr":"txrg","explanation":"形容伤心到了极点。","source":{"text":"是以智达之士莫不痛心入骨。","book":"《后汉书·袁绍传》"},"example":{"text":"每与刘左将军、孙公祐共论此事，未尝不～，相为悲伤也。","book":"《三国志·蜀志·孙乾传》"},"similar":["悲痛欲绝","痛心切骨"],"usage":"作谓语、定语；形容伤心到了极点"},{"id":32470,"word":"痛心切骨","pinyin":"tòng xīn qiè gǔ","abbr":"txqg","explanation":"伤痛透到骨头里。形容悲愤之至。亦形容痛苦的程度极深。","source":{"text":"子负心太甚，即王魁、李益，有不逮焉……思之痛心切骨，街非一朝一夕矣。","book":"清·和邦额《夜谭随录·白萍》"},"example":{"text":"只有那疏疏密密的枯枝，时时战颤，忍着百般～的苦恼，静待远遥远未来的春意呢。","book":"瞿秋白《饿乡纪程》十三"},"similar":["痛心绝气"],"usage":"作谓语、宾语；用于书面语"},{"id":32471,"word":"痛心切齿","pinyin":"tòng xīn qiè chǐ","abbr":"txqc","explanation":"切齿：咬紧牙齿。形容愤恨到极点。","source":{"text":"此愚臣之所痛心切齿于既往，是以不忍复躬行于当世也。","book":"唐·陆贽《论两河及淮西利害状》"},"example":{"text":"我们关宁将士忠于大明，从来为我国关外屏障，矢忠不二。一提到流贼攻破北京，逼死帝后，～。","book":"姚雪垠《李自成》第四卷第十九章"}},{"id":32472,"word":"痛心刻骨","pinyin":"tòng xīn kè gǔ","abbr":"txkg","explanation":"伤心悲痛已刻入到了骨髓内。形容伤心到了极点。","source":{"text":"信奸人之口，为叛贼泄愤报仇，此本职之所为痛心刻骨，日夜冤愤不能自已者也。","book":"明·王守仁《咨六部伸理冀元亨》"},"example":{"text":"臣等遭逢先帝，临终顾命，惓惓以陛下为托，～，誓以死报。","book":"《明史·刘健传》"},"similar":["痛切心骨","痛之入骨","痛心入骨"],"usage":"作谓语、定语；形容伤心到了极点"},{"id":32473,"word":"痛心拔脑","pinyin":"tòng xīn bá nǎo","abbr":"txbn","explanation":"形容伤心到极点。","source":{"text":"陆机与长沙顾母书，述从祖弟士横死。乃言，痛心拔脑，有如孔怀。","book":"北齐·颜之推《颜氏家训·文章》"},"usage":"作谓语、状语；指十分伤心"},{"id":32474,"word":"痛心泣血","pinyin":"tòng xīn qì xuè","abbr":"txqx","explanation":"泣血：哀伤极深而抽泣得如同出血。痛入心田，哭出血泪。形容极其悲痛。","source":{"text":"若夫石显可以痛心泣血矣，岂不疾之哉。","book":"汉·荀悦《汉纪·元帝纪下》"},"example":{"text":"宋·司马光《乞开言路状》：“臣尝～，思救其失。”"},"usage":"作谓语、定语、状语；用于悲伤、痛苦等"},{"id":32475,"word":"痛心疾首","pinyin":"tòng xīn jí shǒu","abbr":"txjs","explanation":"疾首：头痛。形容痛恨到了极点。","source":{"text":"诸侯备闻此言，斯是用痛心疾首，匿就寡人。","book":"《左传·成公十三年》"},"example":{"text":"瞿耐庵自从到任至今也有半年了。治下的百姓因他听断糊涂，一个个～。","book":"清·李宝嘉《官场现形记》第四十二回"},"similar":["深恶痛绝","捶胸顿足"],"opposite":["感恩戴德"],"usage":"作谓语、状语、补语；指对某事的痛恨","story":["春秋时期，秦桓公邀晋厉公一起攻打白狄小国，暗中派人劝白狄归顺秦国，而去对付晋国。晋厉公知道后派吕相去和秦国绝交，说秦桓公是唯利是图、背信弃义，晋国对此痛心疾首。如果秦国能遵守先前的盟约的话，可以避免战争"]},{"id":32476,"word":"痛心病首","pinyin":"tòng xīn bìng shǒu","abbr":"txbs","explanation":"犹痛心疾首。形容极其悲愤。","source":{"text":"帝谓群臣曰：‘往国家初定，太上皇以百姓故，奉突厥，诡而臣之，联常痛心病首，思一刷耻于天下。","book":"《新唐书·突厥传上》"},"usage":"作谓语、定语；用于书面语"},{"id":32477,"word":"痛心绝气","pinyin":"tòng xīn jué qì","abbr":"txjq","explanation":"形容悲愤到极点。","source":{"text":"今寇贼冰消，大事垂定……而横议妄生，成此贝锦，使垂灭之贼复获苏息，所以痛心绝气，悲慨弥深。","book":"《晋书·桓温传》"},"similar":["痛心切骨"],"usage":"作谓语、宾语；用于书面语"},{"id":32478,"word":"痛快一时","pinyin":"tòng kuài yī shí","abbr":"tkys","explanation":"痛快：尽兴。指只顾当时任性尽兴而为，不管后果。","source":{"text":"这个工作绝不是痛快一时，乱打一顿，所能奏效的。","book":"毛泽东《整顿党的作风》"},"example":{"text":"水不能永远溷下去，就怕的你们这些年轻人～，后悔一世！","book":"姚雪垠《长夜》二十八"},"usage":"作宾语、定语；用于处事"},{"id":32479,"word":"痛快淋漓","pinyin":"tòng kuài lín lí","abbr":"tkll","explanation":"淋漓：心情舒畅。形容非常痛快。","source":{"text":"买了一票砖，害得人家一个痛快淋漓。","book":"清·吴趼人《二十年目睹之怪现状》第63回"},"example":{"text":"我们像乘快船下三峡似的，有～之感。","book":"秦牧《艺海拾贝·“上味”》"},"similar":["大快人心"],"opposite":["灰心丧气"],"usage":"作谓语、定语、状语；用于说话、作文等"},{"id":32480,"word":"痛悔前非","pinyin":"tòng huǐ qián fēi","abbr":"thqf","explanation":"彻底悔恨以前所犯的错误。","source":{"text":"这位青年做了多年的苦工，受了无限的虐待，已经弄得来三分不像人，四分不像鬼了，自己深深的在痛悔前非。","book":"郭沫若《我的童年》第一篇五"},"similar":["痛涤前非"],"opposite":["死不改悔","顽固不化"],"usage":"作谓语、定语；用于处事"},{"id":32481,"word":"痛抱丧明","pinyin":"tòng bào sàng míng","abbr":"tbsm","explanation":"原指指孔子弟子子夏在西河丧子而哭瞎眼睛的事。后泛指死了儿子而极其头痛。同“痛抱西河”。","source":{"text":"余非痛死者，痛生者耳。六旬衰老，痛抱丧明，仅此遗嫠，尚不能承欢终老。孙未成人女未嫁，哀哀茕独，极人世之惨境矣。","book":"徐枕亚《玉梨魂》第二章：“西河贤者，痛抱丧明；东野达人，诗传失子。”又第二十八章"}},{"id":32482,"word":"痛抱西河","pinyin":"tòng bào xī hé","abbr":"tbxh","explanation":"比喻丧子之痛。","source":{"text":"子夏居西河教授，为魏文侯师。其子死，哭之失明。","book":"《史记·仲尼弟子列传》"},"similar":["丧明之痛"],"usage":"作宾语、定语；用于书面语"},{"id":32483,"word":"痛改前非","pinyin":"tòng gǎi qián fēi","abbr":"tgqf","explanation":"痛：彻底；非：错误。彻底改正以前所犯的错误。","source":{"text":"你痛改前非，我把这所房子与你夫妻两个住下。","book":"明·凌濛初《二刻拍案惊奇· 痴公子很使噪脾钱》"},"example":{"text":"在政策的感召下，他决心～，重新做人。"},"similar":["悔过自新","改过自新"],"opposite":["不思悔改","死不改悔"],"usage":"作谓语、定语；指醒悟"},{"id":32484,"word":"痛楚彻骨","pinyin":"tòng chǔ chè gǔ","abbr":"tccg","explanation":"形容痛苦万分。","source":{"text":"庖人挥刀误伤指，血落食中，恍惚之际，手若为人所掣，入镬内，痛楚彻骨，号呼欲死。","book":"宋·洪迈《夷坚甲志·神告方》"}},{"id":32485,"word":"痛毁极诋","pinyin":"tòng huǐ jí dǐ","abbr":"thjd","explanation":"尽力地揭发暴露。也指极力毁谤辱骂。","source":{"text":"若先暴白其过恶，痛毁极诋，使无所容。","book":"明·王守仁《教条示龙场诸生》"},"usage":"作谓语、宾语；用于处事"},{"id":32486,"word":"痛涤前非","pinyin":"tòng dí qián fēi","abbr":"tdqf","explanation":"痛：彻底；非：错误。彻底涤除以前所犯的错误。","source":{"text":"陛下倘信微臣之言，痛改前非，则如宣王因庭燎之箴而勤政，汉武悔轮台之失而罢兵，宗社之幸也。","book":"宋·无名氏《大宋宣和遗事》亨集"},"example":{"text":"今允榹居马兰峪，欲其瞻仰景陵，痛涤前非。","book":"《清史稿·诸王传》"},"similar":["痛改前非","痛悔前非"],"opposite":["死不改悔","顽固不化"],"usage":"作谓语、定语；指醒悟"},{"id":32487,"word":"痛深恶绝","pinyin":"tòng shēn wù jué","abbr":"tswj","explanation":"极端痛恨、厌恶。","source":{"text":"他似乎已痛深恶绝了大哥，因为大哥竟敢公然与冠家为敌，帮着钱默吟和金三爷到冠家叫闹，打架。","book":"老舍《四世同堂》二二"},"similar":["深恶痛绝"],"usage":"作谓语、定语；用于书面语"},{"id":32488,"word":"痛湔宿垢","pinyin":"tòng jiān sù gòu","abbr":"tjsg","explanation":"犹痛改前非。彻底改正以前所犯的错误。湔，洗。","source":{"text":"朕方嘉与臣民会皇极之路，尔诸臣亦宜痛湔宿垢，共襄王道之成。","book":"明·张居正《请戒谕群臣疏》"},"similar":["痛改前非"],"usage":"作谓语、定语；用于书面语"},{"id":32489,"word":"痛痒相关","pinyin":"tòng yǎng xiāng guān","abbr":"tyxg","explanation":"形容彼此关系密切。","source":{"text":"外而督托，内而各部，无一刻不痛痒相关，凡奏疏所不能及者，竿牍往来，罔非至计。","book":"明·杨士聪《玉堂荟记》"},"example":{"text":"想起稷如远别半载，荷生出师关外，客边～的人，目前竟无一个。（清·魏秀仁《花月痕》第三十八回）"},"similar":["息息相关"],"opposite":["无关痛痒"],"usage":"作谓语、定语；形容彼此关系密切"},{"id":32490,"word":"痛痛快快","pinyin":"tòng tòng kuài kuài","abbr":"ttkk","explanation":"马上，毫不犹豫。尽情。","source":{"text":"依我看来，泰山是五岳之一，既然来到此地，索兴痛痛快快的逛一下子。","book":"清·刘鹗《老残游记续集遗稿》第一回"},"example":{"text":"我们要～地过这个周末。"},"similar":["尽情尽兴"],"usage":"作定语、状语；指人的个性"},{"id":32491,"word":"痛自创艾","pinyin":"tòng zì chuāng yì","abbr":"tzcy","explanation":"指彻底地改正自己的过错，重新做人。","source":{"text":"里中少年有殴母者，公欲与其父直诸有司，置之重典，少年惧，叩头流血请教，公乃许之，而其人亦痛自创艾，卒为善士，为乡里所重如此。","book":"明·张居正《素庵戴公墓志铭》"},"similar":["改头换面"],"opposite":["死不改悔","顽固不化"],"usage":"作谓语、定语；用于书面语","story":["明朝时期，戴公见乡里有一个年轻人殴打母亲，想同他的父亲一起把他官办，让法律来惩罚他。那年轻人害怕了，向戴公叩头谢罪并表示愿意改正。戴公给他改正的机会，那人从此洗心革面、痛自创艾，终于成为一个乡里敬重的大善人"]},{"id":32492,"word":"痛诬丑诋","pinyin":"tòng wū chǒu dǐ","abbr":"twcd","explanation":"尽情诬蔑，用很难听的话毁谤。","source":{"text":"[汪堃所著《盾鼻随闻录》对]何氏自文安公凌汉以下，并逮其家妇孺，无不痛诬丑诋，至令人不忍观。","book":"清·薛福成《庸庵笔记·轶闻·〈盾鼻随闻录〉当毁》"},"usage":"作谓语、定语；用于处事"},{"id":32493,"word":"痛贯心膂","pinyin":"tòng guàn xīn lǚ","abbr":"tgxl","explanation":"形容悲痛到极点。","source":{"text":"岩肖之先君光禄，靖康间为京城守御司属官，尝以守御策献之朝，而议者沮之。京城失守，督将士与虏战，遂以身殉国。及归葬日，公为挽诗……岩肖每一读之，痛贯心膂。","book":"宋·陈岩肖《庚溪诗话》卷下"},"usage":"作谓语、定语；用于书面语"},{"id":32494,"word":"痛饮狂歌","pinyin":"tòng yǐn kuáng gē","abbr":"tykg","explanation":"痛：痛快，尽情；狂：超出常度。欢畅地饮酒，纵情地歌唱。","source":{"text":"痛饮狂歌空度日，飞扬跋扈为谁雄。","book":"唐·杜甫《赠李白》"},"example":{"text":"但且恁、～，欲把恨怀开解，转更销魂。","book":"宋·朱敦儒《风流子》词"},"similar":["狂歌痛饮"],"usage":"作谓语、定语、宾语；用于生活"},{"id":32495,"word":"痛饮黄龙","pinyin":"tòng yǐn huáng lóng","abbr":"tyhl","explanation":"黄龙：即黄龙府，辖地在今吉林一带，为金人的腹了。原指攻克敌京，置酒高会以祝捷。后泛指为打垮敌人而开怀暢饮。","source":{"text":"金将军韩常欲以五万众内附。飞大喜，语其下曰：‘直抵黄龙府，与诸君痛饮尔！’","book":"《宋史·岳飞传》"},"example":{"text":"内忧外患澄清日，～定约君。","book":"朱德《和郭沫若同志〈登尔雅台怀人〉》诗"},"similar":["黄龙痛饮"],"usage":"作谓语、定语；指为打垮敌人而开怀畅饮","story":["北宋末年，北方女真族建立金国大举进攻北宋，消灭了北宋。宋钦宗的弟弟宋高宗建立南宋，南宋朝廷软弱无能，步步退让。岳飞指挥岳家军英勇抗金，金国士兵闻风丧胆，岳飞乘胜追击，他对将士们说：“我一定要直捣黄龙和你们痛饮。”"]},{"id":32496,"word":"痛饮黄龙府","pinyin":"tòng yǐn huáng lóng fǔ","abbr":"tyhlf","explanation":"痛饮：尽情地喝酒；黄龙：府名，金国的都城，在吉林农安县。指攻克敌京，置酒高会以祝捷。后泛指为打垮敌人而开怀畅饮。","source":{"text":"何当痛饮黄龙府，高筑神州风雨楼。","book":"李大钊《口占一绝》诗"},"similar":["痛饮黄龙"],"usage":"作谓语、定语；指为打垮敌人而开怀畅饮"},{"id":32497,"word":"痰迷心窍","pinyin":"tán mí xīn qiào","abbr":"tmxq","explanation":"指中风昏迷。也形容一心贪图某一事物而失去理智。","source":{"text":"刚才只因多饮几杯，痰迷心窍，酒后失言，只求夫人饶恕。","book":"清·李汝珍《镜花缘》第五十回"},"example":{"text":"大众听了，都说他是～。","book":"清·李宝嘉《官场现形记》第二十九回"},"similar":["鬼迷心窍"],"usage":"作谓语、宾语；指人糊涂"},{"id":32498,"word":"痴云腻雨","pinyin":"chī yún nì yǔ","abbr":"cyny","explanation":"痴：入迷。形容男女痴迷于情爱。","source":{"text":"抹月批风随过遣，痴云腻雨无留恋。","book":"清·洪昇《长生殿·重圆》"},"similar":["痴云騃雨"],"usage":"作主语、宾语；用于书面语"},{"id":32499,"word":"痴云騃雨","pinyin":"chī yún ái yǔ","abbr":"cyay","explanation":"痴：入迷；騃：通“呆”，迟钝。形容男女痴迷于情爱。","source":{"text":"痴云騃雨自年年，不管人间有离别。","book":"元·萨都刺《洞房曲》"},"similar":["痴云腻雨"],"usage":"作主语、宾语；用于书面语"},{"id":32500,"word":"痴人说梦","pinyin":"chī rén shuō mèng","abbr":"crsm","explanation":"痴：傻。原指对痴人说梦话而痴人信以为真。比喻凭借荒唐的想象胡言乱语。","source":{"text":"此正所谓对痴人说梦也。","book":"宋·释惠洪《冷斋夜话》卷九"},"example":{"text":"子牙笑曰：“邓将军，你这篇言词，真如～。”","book":"明·许仲琳《封神演义》第五十三回"},"similar":["白日做梦","痴心妄想","荒诞不经"],"opposite":["切中事理","循规蹈矩"],"usage":"作宾语、定语；用于讥讽人","story":["从前一个外国和尚到一座中国庙里烧香，庙里的小和尚问他何姓及来自何国，外国和尚不懂他的话，跟着说何姓何国人。小和尚向住持报告外面来了何国一个姓何的和尚。众和尚纷纷出来看热闹，搞得大家啼笑皆非"]}]
