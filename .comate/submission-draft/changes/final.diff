@@ -0,0 +1 @@
+[{"id":1,"word":"一丁不识","pinyin":"yī dīng bù shí","abbr":"ydbs","explanation":"形容一个字也不认识。","source":{"text":"天下无事，汝辈挽得两石弓，不如识一丁字。","book":"《旧唐书·张弘靖传》"},"quote":{"text":"而云古无类书，此真～之无知妄作也矣。","book":"清·平步青《霞外捃屑》卷七"}},{"id":2,"word":"一丁点儿","pinyin":"yī dīng diǎn ér","abbr":"ydde","explanation":"形容极少或极小。","source":{"text":"他就一直没有过哪怕是一丁点儿小鸟依人的惹人疼样儿。","book":"王朔《我是你爸爸》"},"example":{"text":"只要她能给我～爱，我就心满意足了。"},"similar":["微乎其微"],"opposite":["数不胜数","硕大无朋"],"usage":"作宾语、定语；用于口语"},{"id":3,"word":"一丁至微","pinyin":"yī dīng zhì wēi","abbr":"ydzw","explanation":"一丁：一个钉子；至微：极其微小。一个极其微小的钉子。比喻极微小的东西。","source":{"text":"一丁至微，未必能螯大木，自其性相制耳。","book":"宋·沈括《梦溪笔谈》卷四"}},{"id":4,"word":"一不作，二不休","pinyin":"yī bù zuò，èr bù xiū","abbr":"ybzebx","explanation":"要么不做，做了就索兴做到底。指事情既然做了开头，就索兴做到底","source":{"text":"索性让我一不作，二不休，见一个杀一个，见两个杀一双，杀个爽快。","book":"清·文康《儿女英雄传》第六回"},"example":{"text":"老舍《神拳》第二幕：“好吧！～！说吧，叫我干什么？”"},"similar":["一不做，二不休"],"usage":"作谓语、状语、分句；用于城市"},{"id":5,"word":"一不做，二不休","pinyin":"yī bū zuò，èr bù xiū","abbr":"ybzebx","explanation":"原意是要么不做，做了就索兴做到底。指事情既然做了开头，就索兴做到底。","source":{"text":"光晟临死言曰：‘传语后人，第一莫作，第二莫休。’","book":"唐·赵元一《奉天录》卷四"},"example":{"text":"到这地步，～，我是打算拼一拼了。","book":"茅盾《子夜》七"},"similar":["破釜沉舟"],"opposite":["犹豫不决"],"usage":"作谓语、状语、分句；形容下最后的决心","story":["唐德宗时期，安禄山起兵反叛，卢龙节度使朱泚及部将张光晟也起兵反叛。李晟奉命征讨叛军，活捉了张光晟。张光晟表示愿意重新归顺唐王朝，德宗身边大臣坚决反对，只好处死他。张光晟感慨地说：“第一不要做，第二做就要做到底。”"]},{"id":6,"word":"一不压众，百不随一","pinyin":"yī bù yā zhòng，bǎi bù suí yī","abbr":"ybyzbbsy","explanation":"少数敌不过多数。","source":{"text":"本来你胡闹吗！十个人当差，偏你要独出己见么？俗语说：‘一不扭众，百不随一’，谁叫你胡说白道，出这宗甑儿糕呢。","book":"清·冷佛《春阿氏谋夫案》第五回"}},{"id":7,"word":"一不扭众","pinyin":"yī bù niǔ zhòng","abbr":"ybnz","explanation":"一个人难违反众人的意见。","source":{"text":"细想了想，这事不但无法，而且有理；料是'一不扭众'，只得点头依允。","book":"清·文康《儿女英雄传》第23回"},"similar":["四不拗六"],"usage":"作宾语；指一个人难违反众人的意见"},{"id":8,"word":"一不拗众","pinyin":"yī bù niù zhòng","abbr":"ybaz","explanation":"一个人难违反众人的意见。","source":{"text":"玉凤姑娘此时被大家你一句我一句说的心里乱舞莺花，笑也顾不及了，细想了想，这事不但无法，而且有理，料是一不扭众，只得点头依允。","book":"清·文康《儿女英雄传》第二十三回"}},{"id":9,"word":"一世两清","pinyin":"yī shì liǎng qīng","abbr":"yslq","explanation":"旧指兄弟两人都是清明廉正的官吏。"},{"id":10,"word":"一世之利","pinyin":"yī shì zhī lì","abbr":"yszl","explanation":"天下的利益。","source":{"text":"不拘一世之利以为己私分，不以王天下为己处显。","book":"《庄子·天地》"}},{"id":11,"word":"一世之雄","pinyin":"yī shì zhī xióng","abbr":"yszx","explanation":"雄：英雄豪杰。一个时代的英雄人物。","source":{"text":"固一世之雄也，而今安在哉！","book":"宋·苏轼《赤壁赋》"},"example":{"text":"有许多感想，真不知从哪里说起——先从‘～’的‘大英帝国’说起吧！","book":"冰心《再寄小读者》"},"similar":["一世枭雄"],"usage":"作宾语；指英雄人物"},{"id":12,"word":"一世师表","pinyin":"yī shì shī biǎo","abbr":"yssb","explanation":"师表：学习的榜样。足以供一代人效法，起表率作用的人。","source":{"text":"二程先生，一世师表。","book":"宋·曾几《永州倅厅拙堂民》"}},{"id":13,"word":"一世龙门","pinyin":"yī shì lóng mén","abbr":"yslm","explanation":"一世：一代；龙门：后汉时李膺有重名，后起的文人有登门拜访的，称之登龙门。称文人所崇仰的人物。","source":{"text":"李元礼风格秀整，高自标持，欲以天下名教是非为己任，后进之士，有升其堂者，皆以为登龙门。","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"朝野翕然，谓之‘～’矣。","book":"《晋书·王衍传》"},"usage":"作宾语、定语；称一时春风得意的人物"},{"id":14,"word":"一丘一壑","pinyin":"yī qiū yī hè","abbr":"yqyh","explanation":"丘：土山；壑：山沟。原指隐者所居之地。后多用以指寄情山水。","source":{"text":"端委庙堂，使百官准则，臣不如亮；一丘一壑，自谓过之。","book":"《汉书·叙传上》：“渔钓于一壑，则万物不奸其志；栖迟于一丘，则天下不易其乐。”南朝宋·刘义庆《世说新语·品藻》"},"example":{"text":"兄以～过之，且筑圹于侧，与山缔生死盟。","book":"明·徐宏祖《题小香山梅花堂诗序》"},"usage":"作宾语、定语；指寄情山水"},{"id":15,"word":"一丘之貉","pinyin":"yī qiū zhī hè","abbr":"yqzh","explanation":"丘：土山；貉：一种形似狐狸的野兽。一个土山里的貉。比喻彼此同是丑类，没有什么差别。","source":{"text":"若秦时但任小臣，诛杀忠良，竟以灭亡，令亲任大臣，即至今耳，古与今如一丘之貉。","book":"《汉书·杨恽传》"},"example":{"text":"否塞晦盲，真若～。","book":"严复《救亡决论》"},"similar":["一路货色","泾渭不分","半斤八两"],"opposite":["黑白分明","是非分明","泾渭分明"],"usage":"作宾语；指蔑视对方","story":["西汉时期司马迁的外孙杨恽因为告发霍光谋反有功，被汉宣帝封为平通侯。他居功自傲，不把汉宣帝看在眼里，太仆戴长乐事发入狱，向汉宣帝揭发杨恽认为秦二世胡亥与汉宣帝为一丘之貉。杨恽被罢官回乡，他给孙会宗回信不满而被杀"]},{"id":16,"word":"一丘壑","pinyin":"yī qiū hè","abbr":"yqh","explanation":"丘：土山；壑：山沟。原指隐者所居之地。后多用以指寄情山水。","source":{"text":"端委庙堂，使百官准则，臣不如亮；一丘一壑，自谓过之。","book":"《汉书·叙传上》：“渔钓于一壑，则万物不奸其志；栖迟于一丘，则天下不易其乐。”南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"～。老子风流占却。茅檐上、松月桂云，脉脉石泉逗山脚。","book":"宋·辛弃疾《兰阮王》词"}},{"id":17,"word":"一丘貉","pinyin":"yī qiū hé","abbr":"yqh","explanation":"丘：土山；貉：一种形似狐狸的野兽。一个土山里的貉。比喻彼此同是丑类，没有什么差别。","source":{"text":"若秦时但任小臣，诛杀忠良，竟以灭亡，令亲任大臣，即至今耳，古与今如一丘之貉。","book":"《汉书·杨恽传》"},"example":{"text":"丈夫不徒死，可作～？","book":"宋·陆游《舒悲》"}},{"id":18,"word":"一东一西","pinyin":"yī dōng yī xī","abbr":"ydyx","explanation":"一个在东，一个在西。指各在遥远的一方。也比喻背道而驰。","source":{"text":"一东一西如别鹤，一南一北似浮云。","book":"唐·戎昱《送李参军》"},"example":{"text":"～垄头水，一聚一散天边霞。","book":"唐·王建《古谣》"}},{"id":19,"word":"一丝一毫","pinyin":"yī sī yī háo","abbr":"ysyh","explanation":"丝、毫：十丝为一毫，十毫为一厘。一点点儿，极小或极少。","source":{"text":"任凭尊意应济多少，一丝一毫尽算是尊赐罢了。","book":"明·凌濛初《二刻拍案惊奇》卷二十四"},"example":{"text":"对于精密零件的加工，不允许有～的误差。"},"similar":["一针一线","一星半点","微乎其微"],"opposite":["成千上万","成千累万"],"usage":"作定语、宾语；形容十分精密"},{"id":20,"word":"一丝不乱","pinyin":"yī sī bù luàn","abbr":"ysbl","explanation":"一点也不紊乱。形容布置或收拾得非常整齐。","example":{"text":"他把这个家收拾得～。"},"similar":["井然有序"],"opposite":["杂乱无章"],"usage":"作谓语、定语、状语；指整齐有序"},{"id":21,"word":"一丝不挂","pinyin":"yī sī bù guà","abbr":"ysbg","explanation":"原是佛教用来比喻人没有一丝牵挂。后指人裸体。","source":{"text":"一丝不挂，竿木随身。","book":"《楞严经》"},"example":{"text":"放闸老兵殊耐冷，～下冰滩。","book":"宋·杨万里《清晓洪泽放闸》诗"},"similar":["赤身裸体"],"opposite":["衣冠楚楚"],"usage":"作谓语、定语；指人裸体"},{"id":22,"word":"一丝不紊","pinyin":"yī sī bù wěn","abbr":"ysbw","explanation":"一点儿也不乱。形容极有条理。","example":{"text":"我服了，万没想到你会这么细心，井井有条，～。（老舍《神拳》第二幕）"},"similar":["井井有条"],"usage":"作定语、状语；用于书面语"},{"id":23,"word":"一丝不线，单木不林","pinyin":"yī sī bù xiàn，dān mù bù lín","abbr":"ysbxdmbl","explanation":"单丝不能成线，一棵树不能构成森林。比喻一个人的力量单薄，办不成事。","source":{"text":"这福儿一丝不线，单木不林，也觉读的慢懈。","book":"清·李绿园《歧路灯》第八回"},"similar":["单丝不成线"],"usage":"作宾语、定语；用于书面语"},{"id":24,"word":"一丝不苟","pinyin":"yī sī bù gǒu","abbr":"ysbg","explanation":"苟：苟且，马虎。指做事认真细致，一点儿不马虎。","source":{"text":"上司访知，见世叔一丝不苟，升迁就在指日。","book":"清·吴敬梓《儒林外史》第四回"},"example":{"text":"我们在学习上，应有～的精神。"},"similar":["小心谨慎","小心翼翼","不苟言笑"],"opposite":["粗枝大叶","马马虎虎"],"usage":"作谓语、定语、补语；指做事认真","story":["明朝时期，朝廷下令禁杀耕牛，乡绅张静斋与举人范进去拜访高要县汤奉知县，席间有老者送来50斤牛肉。汤奉问张静斋如何处置。张静斋要他把送牛肉的老者抓起来。如果上司知道这样办案一丝不苟，那么升官发财就指日可待了"]},{"id":25,"word":"一丝不走","pinyin":"yī sī bù zǒu","abbr":"ysbz","explanation":"丝：蚕丝，引申为微小。一点也不走样。形容十分精确，与原样完全相合。","source":{"text":"原板初印，福气一丝不走，其非翻刻赝本，盖可知也。","book":"清·梁绍壬《两般秋雨庵随笔》卷三"},"example":{"text":"安老爷看了看，倒底确是“本客自制，货真价实，原板初印，～”的两个孩子。","book":"清·文康《儿女英雄传》第三十九回"}},{"id":26,"word":"一丝两气","pinyin":"yī sī liǎng qì","abbr":"yslq","explanation":"指如同一根丝一般十分疲软，上气不接下气。也可形容人呼吸微弱，将要断气的样子。","source":{"text":"我才离了三朝五日，儿也这其间哭的你一丝两气。","book":"元·岳伯川《铁拐李》第三折"},"example":{"text":"那妇人被鞭的～。","book":"洪深《赵阎王》第六幕"},"similar":["气息奄奄"],"usage":"作宾语、定语；指将要断气的样子"},{"id":27,"word":"一丝半粟","pinyin":"yī sī bàn sù","abbr":"ysbs","explanation":"比喻极微小的东西。","source":{"text":"儿子不能挣得一丝半粟孝敬父亲，到要破费了父亲的产业，实在不可自比于人。","book":"清·吴敬梓《儒林外史》第四十回"},"example":{"text":"他为官清廉，不沾群众的～"},"usage":"作主语、宾语；用于书面语"},{"id":28,"word":"一丝半缕","pinyin":"yī sī bàn lǚ","abbr":"ysbl","explanation":"丝：蚕丝；缕：线。一条丝，半条线。形容非常细微。","source":{"text":"偶因风荡，或被云催，略有摇动感发之意，一丝半缕误而泄出者，偶值灵秀之气适过，正不容邪，邪复妒正，两不相下，亦如风水雷电，地中既遇。","book":"清·曹雪芹《红楼梦》第二回"},"example":{"text":"你把全身衣裳脱个干净，只要剩下～，我立时送你丈夫归天。","book":"金庸《射雕英雄传》第二十五回"}},{"id":29,"word":"一丝没两气","pinyin":"yī sī méi liǎng qì","abbr":"ysmlq","explanation":"指如同一根丝一般十分疲软，上气不接下气。也可形容人呼吸微弱，将要断气的样子。","source":{"text":"那妇人却踅将归来，到楼上看武大时，一丝没两气，看看待死。","book":"明·施耐庵《水浒全传》第二十五回"},"example":{"text":"春兰在这板箱里睡着，～，一直睡了一天一夜。","book":"梁斌《红旗谱》十六"}},{"id":30,"word":"一个半个","pinyin":"yī gè bàn gè","abbr":"ygbg","explanation":"指为数甚少。","source":{"text":"吾辈粗根浮器，不曾见得一个半个智识，可轻易谈佛法哉？","book":"宋·陈亮《水调歌头》词：“尧之都，舜之壤，禹之封；于中应有，一个半个耻臣戎。”明·袁宏道《西湖杂记》"},"example":{"text":"你往常嫖客给的花钱，何曾分～给我？","book":"清·吴敬梓《儒林外史》第五十四回"},"usage":"作宾语、定语；用于口语"},{"id":31,"word":"一个巴掌拍不响","pinyin":"yī gè bā zhǎng pāi bù xiǎng","abbr":"ygbzpbx","explanation":"比喻事情不会是单方面引起的。","source":{"text":"‘一个巴掌拍不响’，老的也太不公些，小的也太可恶些。","book":"清·曹雪芹《红楼梦》第58回"},"example":{"text":"～，两个巴掌就拍得响。","book":"姚雪垠《李自成》第一卷第18章"},"usage":"作宾语、定语、分句；指双方都有责任"},{"id":32,"word":"一个心眼","pinyin":"yī gè xīn yǎn","abbr":"ygxy","explanation":"指专心一意。比喻很固执已见，不知变通。也比喻同某人思想很一致。","example":{"text":"铺主知道是遇见了～的人，看看钱，看看祥子，叹了口气。","book":"老舍《骆驼祥子》一"}},{"id":33,"word":"一个萝卜一个坑","pinyin":"yī gè luó bo yī gè kēng","abbr":"yglbygk","explanation":"比喻一个人有一个位置，没有多余。也形容做事踏实。","source":{"text":"从此不再空劳动，一个萝卜一个坑。管叫那，劳动用在生产上，财源茂盛，五谷丰登，人民乐太平。","book":"《说说唱唱》1950年第2期"},"example":{"text":"他是～儿的人，不至于有什么闪失。"},"similar":["各尽其责"],"usage":"作宾语、定语、分句；指各就各位"},{"id":34,"word":"一串骊珠","pinyin":"yī chuàn lí zhū","abbr":"yclz","explanation":"骊珠：一种珍贵的珠，传说出自骊龙颔下。比喻歌声宛转就象成串的骊珠一样。","source":{"text":"有字多声少，有声少字多，所谓一串骊珠也。","book":"唐·白居易《寄明州于驸马使君》：“何郎小妓歌喉好，严老呼为一串珠。”明·陶宗仪《辍耕录》"},"example":{"text":"～声和韵闲，恰便似莺与燕弄关关。","book":"清·洪昇《长生殿·弹词》"},"usage":"作宾语、定语；指歌声等"},{"id":35,"word":"一丸可封","pinyin":"yī wán kě fēng","abbr":"ywkf","explanation":"一丸：一团小泥丸；封：封闭。用一小团小泥丸就可把函谷关封闭住。比喻地形险要，用少量兵力即可固守。","source":{"text":"元请以一丸泥为大王东封函谷关，此万世一时也。","book":"《后汉书·隗嚣传》"}},{"id":36,"word":"一丸泥封函谷关","pinyin":"yī wán ní fēng hán gǔ guān","abbr":"ywnfhgg","explanation":"一丸：一团小泥丸；封：封闭。用一小团小泥丸就可把函谷关封闭住。比喻地形险要，用少量兵力即可固守。","source":{"text":"元请以一丸泥为大王东封函谷关，此万世一时也。","book":"《后汉书·隗嚣传》"},"similar":["丸泥封关"],"usage":"作定语；形容地势险要"},{"id":37,"word":"一举一动","pinyin":"yī jǔ yī dòng","abbr":"yjyd","explanation":"指人的每一个动作。","source":{"text":"可见古人一举一动，莫不令人归于正道，就是游戏之中，也都寓著劝世之意。","book":"清·李汝珍《镜花缘》第七十四回"},"example":{"text":"她的～都象个多年的媳妇，麻利，老到，还带着点自得的劲儿。","book":"老舍《骆驼祥子》十五"},"similar":["一言一行","一颦一笑"],"usage":"作主语、宾语；指人的言行"},{"id":38,"word":"一举万里","pinyin":"yī jǔ wàn lǐ","abbr":"yjwl","explanation":"比喻前程远大。同“一举千里”。","source":{"text":"当如鸿鹄高飞，一举万里，不可坐待罟网。","book":"《晋书·慕容盛载记》"},"similar":["一举千里"],"usage":"作谓语、定语；指人的前程远大"},{"id":39,"word":"一举三反","pinyin":"yī jǔ sān fǎn","abbr":"yjsf","explanation":"指善于推理，能由此及彼。","source":{"text":"举一隅不以三隅反，则不复也。","book":"《论语·述而》"},"example":{"text":"清·藤谷古香《轰天雷》第14回：“私者公之析言，公者私之积名，要之～，可以战夫索西谛矣。”"},"similar":["举一反三"],"usage":"作谓语、宾语、定语；用于处事"},{"id":40,"word":"一举两便","pinyin":"yī jǔ liǎng biàn","abbr":"yjlb","explanation":"举：举动、动作。做一件事得到两方面的好处。","source":{"text":"吾得临淄，即西安孤，必覆亡矣。所谓一举而两得者也。","book":"《东观汉记·耿弇传》"},"example":{"text":"清·李汝珍《镜花缘》第35回：“又安众民之心，倘河近成功，也除通国大患，真是～。”"},"similar":["一举两得"],"usage":"作谓语、定语；指收获大"},{"id":41,"word":"一举两全","pinyin":"yī jǔ liǎng quán","abbr":"yjlq","explanation":"指一举措而能顾全两面。","source":{"text":"兵不远西，而胡交自离，此一举两全之策也。","book":"《三国志·魏志·郭淮传》"},"example":{"text":"这叫做假亲脱网之计，岂非～之美也？","book":"明·吴承恩《西游记》第五十四回"},"similar":["一举两得"],"usage":"作定语、宾语；用于处事"},{"id":42,"word":"一举两利","pinyin":"yī jǔ liǎng lì","abbr":"yjll","explanation":"举：举动、动作。做一件事得到两方面的好处。","source":{"text":"吾得临淄，即西安孤，必覆亡矣。所谓一举而两得者也。","book":"《东观汉记·耿弇传》"},"example":{"text":"老先生若肯重价买了，献与山相公，上可解前番之结，下可泄晚生之愤，诚～之道。","book":"明·罗贯中《平山冷燕》第七回"}},{"id":43,"word":"一举两失","pinyin":"yī jǔ liǎng shī","abbr":"yjls","explanation":"举：举动。指一件事带来两方面的损失。形容十分错误的举动。","source":{"text":"朝廷一举而两失。纵不能复后，宜还仲淹、道辅。","book":"《纲鉴抄略》"},"example":{"text":"他干了一件～的事。"},"similar":["得不偿失"],"opposite":["一举两得"],"usage":"作宾语、定语；指错误的举动","story":["宋朝时期，宋仁宗因郭皇后与宠妃之间的矛盾就要废了郭皇后，宰相吕夷简积极鼓动仁宗废后。御史中丞孔道辅、右司谏范仲淹坚决反对废后，仁宗大发雷霆降他们两人的职，河阳判官富弼上书：“朝廷一举而两失。纵不能复后，宜还仲淹、道辅。”"]},{"id":44,"word":"一举两得","pinyin":"yī jǔ liǎng dé","abbr":"yjld","explanation":"做一件事得到两方面的好处。","source":{"text":"赐其十年炎复，以慰重迁之情，一举两得，外实内宽。","book":"《晋书·束皙传》"},"example":{"text":"一则免楚之患，二则激晋之来，岂非～？","book":"明·冯梦龙《东周列国志》第六十一回"},"similar":["一箭双雕","事半功倍"],"opposite":["事倍功半","得不偿失"],"usage":"作谓语、定语；指收获大","story":["春秋时期鲁国勇士卞庄子敢于只身同老虎搏斗，他听说山上有两只老虎就想去打，朋友劝说等两只老虎争食时再下手可以一举两得。他耐心等到大老虎为了吃到黄牛而咬死小老虎，觉得这时时机已成熟，轻易地打死那只大老虎"]},{"id":45,"word":"一举千里","pinyin":"yī jǔ qiān lǐ","abbr":"yjql","explanation":"一飞就是一千里。比喻前程远大。","source":{"text":"鸿鹄高飞，一举千里。","book":"西汉·司马迁《史记·留侯世家》"},"example":{"text":"犹复不能飞轩绝迹，～也。","book":"三国·魏·曹植《与杨德祖书》"},"similar":["一举万里"],"usage":"作谓语、定语；指人的前程远大","story":["西汉时期，刘邦当上皇帝后立吕后的儿子刘盈为太子，因为宠幸戚夫人而想改立刘如意为太子。吕后听从张良的主意，让太子刘盈请出商山四位贤士。刘邦看到太子有商山四贤辅佐，羽翼已成，对戚夫人唱道：“鸿鹄高飞，一举千里。羽挧已就，横绝四海。"]},{"id":46,"word":"一举成名","pinyin":"yī jǔ chéng míng","abbr":"yjcm","explanation":"原指一旦中了科举就扬名天下。后指一下子就出了名。","source":{"text":"公一举成名而东，遇其党必曰：‘非我之才，维吾舅之私。’”。","book":"《战国策·秦策》：“然则是一举而伯王之名可成也。” 唐·韩愈《唐故国子司业窦公墓志铭》"},"example":{"text":"十年窗下无人问，～天下知。","book":"金·刘祁《归潜志》卷七"},"similar":["一鸣惊人"],"opposite":["徒劳无功","名落孙山","榜上无名"],"usage":"作谓语、定语；指一下子就出了名"},{"id":47,"word":"一举成名天下知","pinyin":"yī jǔ chéng míng tiān xià zhī","abbr":"yjcmtxz","explanation":"举：举动、行动。原指一旦中了科举就扬名天下。后指一下子就出了名，天下皆知。","source":{"text":"然则是一举而伯王之名可成也。","book":"《战国策·秦策一》"},"example":{"text":"马前喝道状元归，雁塔挥毫题姓字，～。","book":"元·高明《琵琶记》第八出"}},{"id":48,"word":"一举成名天下闻","pinyin":"yī jǔ chéng míng tiān xià wén","abbr":"yjcmtxw","explanation":"举：举动、行动。原指一旦中了科举就扬名天下。后指一下子就出了名，天下闻名。","source":{"text":"然则是一举而伯王之名可成也。","book":"《战国策·秦策一》"},"example":{"text":"十年受尽窗前苦,～。","book":"明·冯梦龙《警世通言》卷二十四"}},{"id":49,"word":"一举手之劳","pinyin":"yī jǔ shǒu zhī láo","abbr":"yjszl","explanation":"比喻不费力，只是一抬手那样。","source":{"text":"如有力者，哀其穷而运转之，盖一举手一投足之劳也。","book":"唐·韩愈《应科目时与人书》"},"example":{"text":"他们一不高兴，就可以不说理由，只须～，致出版事业的死命。（鲁迅《书信集·致黄源》）"},"similar":["举手之劳"],"usage":"作宾语；同“举手之劳”"},{"id":50,"word":"一举手力","pinyin":"yī jǔ shǒu lì","abbr":"yjsl","explanation":"比喻不费力，只是一抬手那样。","source":{"text":"如有力者，哀其穷而运转之，盖一举手一投足之劳也。","book":"唐·韩愈《应科目时与人书》"}},{"id":51,"word":"一之为甚","pinyin":"yī zhī wéi shèn","abbr":"yzws","explanation":"做了一次，已经过分。比喻错误不能重犯。同“一之谓甚”。","source":{"text":"一之为甚其能再，二者何由可得兼。","book":"元·侯克中《归兴》诗"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第35回：“我笑道：‘～，其可再乎？’”"},"similar":["一之谓甚","一之已甚"],"usage":"作谓语、定语；用于书面语"},{"id":52,"word":"一之已甚","pinyin":"yī zhī yǐ shèn","abbr":"yzys","explanation":"做了一次，已经过分。比喻错误不能重犯。同“一之谓甚”。","source":{"text":"酒至白面少年，复请歌。张妻曰：‘一之已甚，其可再乎？’","book":"唐·任蕃《梦游录·张生》"},"example":{"text":"清·名教中人《好逑传》第八回：“～，岂可再乎？莫说老长兄赦过高谊，我学生感铭不尽，就是水小姐良言劝勉，也不敢忘。”"},"similar":["一之为甚","一之谓甚"],"usage":"作谓语；比喻错误不能重犯"},{"id":53,"word":"一之谓甚","pinyin":"yī zhī wèi shèn","abbr":"yzws","explanation":"甚：过分。做了一次，已经过分。比喻错误不能重犯。","source":{"text":"晋不可启，寇不可玩。一之谓甚，其可再乎？","book":"《左传·僖公五年》"},"similar":["一之已甚"],"usage":"作谓语；比喻错误不能重犯","story":["春秋时期，晋献公向虞国借道去打虢国，虞国大夫宫之奇劝虞公不要借道，虞公不听，虢国的都城下阳被攻占。三年后晋侯又向虞国借道，宫之奇劝虞王道：“虢，虞之表也。虢亡虞必从之。晋不可启，寇不可玩。一之谓甚，其可再乎？”虞王不听被消灭"]},{"id":54,"word":"一乱涂地","pinyin":"yī luàn tú dì","abbr":"yltd","explanation":"形容乱到不可收拾。","source":{"text":"桓公之薨也，一乱涂地，无惑也。彼独恃一管仲，而仲则死矣。","book":"宋·苏洵《管仲论》"},"usage":"作谓语、定语、状语；用于局面等"},{"id":55,"word":"一了千明","pinyin":"yī liǎo qiān míng","abbr":"ylqm","explanation":"主要的问题了解以后，其余的问题也就清楚明白了。","source":{"text":"一了千明，一迷万惑。","book":"宋·释普济《五灯会元》卷十"},"usage":"作宾语、定语；用于书面语"},{"id":56,"word":"一了百了","pinyin":"yī liǎo bǎi liǎo","abbr":"ylbl","explanation":"了：了结，解决。把一件主要的事情了结以后，其余有关的事情也跟着了结。","source":{"text":"有资质甚高者，一了一切了，即不须节节用工也。","book":"《朱子语类》卷八"},"example":{"text":"非但扣押，依我之见，立刻把他杀了，～。","book":"曹禺《王昭君》第三幕"},"similar":["一笔勾销","寿终正寝","功德圆满"],"opposite":["依然如故"],"usage":"作谓语、定语；用于消极方面"},{"id":57,"word":"一了百当","pinyin":"yī liǎo bǎi dàng","abbr":"ylbd","explanation":"了：完成；当：适宜，恰当。指办事妥当、彻底。","source":{"text":"清丈事实百年旷举，宜及仆在位，务为一了百当，若但草草了事，可惜此时，徒为虚文耳。","book":"明·张居正《答山东巡抚何来山》"},"example":{"text":"晁老虽算得科考的日子还早，恃了有这个“～”的儿子，也可以不用那个刑皋门。","book":"清·西周生《醒世姻缘传》第十六回"},"similar":["一了百了"],"opposite":["依然如故"],"usage":"作谓语、定语；用于消极方面"},{"id":58,"word":"一予一夺","pinyin":"yī yǔ yī duó","abbr":"yyyd","explanation":"一回儿给了，一回儿又拿回去。","source":{"text":"一喜一怒，一予一夺，一文一武，一徐一疾者，所以调和三军，制一臣下也。","book":"《左传·成公八年》：“七年之中，一予一夺，二三孰甚焉。”《六韬·龙韬·奇兵篇》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":59,"word":"一事不知","pinyin":"yī shì bù zhī","abbr":"ysbz","explanation":"比喻知识尚有欠缺。同“一物不知”。","source":{"text":"读书万余卷，一事不知，以为深耻。","book":"《南史·隐逸传·陶弘景》"},"similar":["一物不知"],"usage":"作谓语、定语；指知识不完备"},{"id":60,"word":"一事无成","pinyin":"yī shì wú chéng","abbr":"yswc","explanation":"连一样事情也没有做成。指什么事情都做不成。形容毫无成就。","source":{"text":"鬓毛不觉白毵毵，一事无成百不堪。","book":"唐·白居易《除夜寄微之》诗"},"example":{"text":"员乃投镜于地，痛哭曰：“～，双鬓已斑，天乎，天乎！”","book":"明·冯梦龙《东周列国志》第七十二回"},"similar":["一无所成","一窍不通","劳而无功"],"opposite":["功成名就","劳苦功高","一技之长"],"usage":"作谓语、定语、状语；指毫无成就","story":["唐朝时期，一省郎官官运不佳，事事都不顺心，只好借故去游玩京国寺散心，他在寺中做了一个梦，梦见老和尚说他第一世是唐玄宗时代的剑南安抚巡官，第二世是唐宪宗的西蜀书记，他仿佛记起三世所做的官都是庸庸碌碌，一事无成。于是就离开宦海出家"]},{"id":61,"word":"一事未成","pinyin":"yī shì wèi chéng","abbr":"yswc","explanation":"连一样事情也没有做成。指什么事情都做不成。形容毫无成就。","source":{"text":"十年期是梦，一事未成身。","book":"唐·刘得仁《寄无可上人》"},"example":{"text":"官吏立即报莽，莽立即下令族诛，共死六十四人。～，便至倾家，也觉可怜。","book":"蔡东藩《后汉演义》第四回"}},{"id":62,"word":"一二其详","pinyin":"yī èr qí xiáng","abbr":"yeqx","explanation":"详：详尽。逐条地说清楚。","source":{"text":"仆尝倦谈，不能一二其详，请略举其凡，而客自觉其切焉。","book":"汉·扬雄《长杨赋》"}},{"id":63,"word":"一五一十","pinyin":"yī wú yī shí","abbr":"ywys","explanation":"五、十：计数单位。五个十个地将数目点清。比喻叙述从头到尾，源源本本，没有遗漏。也形容查点数目。","source":{"text":"这妇人听了这话，也不回言，却踅过来，一五一十，都对王婆和西门庆说了。","book":"明·施耐庵《水浒全传》第二十五回"},"example":{"text":"他把事情发生的经过～地向大家讲了一遍。"},"similar":["原原本本","一清二楚","滴水不漏"],"opposite":["含糊不清","一塌糊涂","有始无终"],"usage":"作状语、补语；形容查点数目"},{"id":64,"word":"一些半些","pinyin":"yī xiē bàn xiē","abbr":"yxbx","explanation":"形容极少。","source":{"text":"老实一句，‘打开板壁讲亮话’，这事一些半些，几十两银子的话，横竖做不来。","book":"清·吴敬梓《儒林外史》第十四回"},"usage":"作谓语、定语；用于口语"},{"id":65,"word":"一人不敌众人智","pinyin":"yī rén bù dí zhòng rén zhì","abbr":"yrbdzrz","explanation":"敌：抵。一个人的智慧比不上集体的智慧。"},{"id":66,"word":"一人之下，万人之上","pinyin":"yī rén zhī xià，wàn rén zhī shàng","abbr":"yrzxwrzs","explanation":"多指地位崇高权势显赫的大臣。","source":{"text":"屈一人下，伸万人上，惟圣人能行之。","book":"《六韬》"},"example":{"text":"老公在～，沧海似的大量哩，就合小的这们东西一般见识？","book":"清·西周生《醒世姻缘传》第70回"},"usage":"作定语、分句；多指地位崇高权势显赫的大臣"},{"id":67,"word":"一人之交","pinyin":"yī rén zhī jiāo","abbr":"yrzj","explanation":"亲密得象一个人。形容交情深。","source":{"text":"那时我家先父就和娄氏弟兄是一人之交。","book":"清·吴敬梓《儒林外史》第五十四回"},"example":{"text":"我闻老孙与有权～，结为兄弟。（《天雨花》第十一回）"},"similar":["情同手足"],"opposite":["视同陌路"],"usage":"作宾语；形容交情深"},{"id":68,"word":"一人之心，千万人之心也","pinyin":"yī rén zhī xīn,qiān wàn rén zhī xīn yě","abbr":"yrzxqwrzxy","explanation":"指人同此心，心同此理。","example":{"text":"～，我们都能理解。"},"similar":["人同此心，心同此理"],"usage":"作宾语、分句；用于书面语"},{"id":69,"word":"一人传十，十人传百","pinyin":"yī rén chuán shí，shí rén chuán bǎi","abbr":"yrcssrcb","explanation":"指消息由一个人迅速传递开去。","source":{"text":"由是一人传十，十人传百，都说大观园中有了妖怪。","book":"清·曹雪芹《红楼梦》第102回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第87回：“谁知同寅当中，～，已经有许多人知道他遭了丧明之痛。”"},"similar":["一传十，十传百"],"usage":"作宾语、定语、分句；用于消息等"},{"id":70,"word":"一人传虚，万人传实","pinyin":"yī rén chuán xū，shí rén chuán shí","abbr":"yrcxwrcs","explanation":"虚：不确实，指无中生有的事。本来没有的事，传的人多了，就信以为真。","source":{"text":"一犬吠形，百犬吠声；一人传虚，万人传实。","book":"汉·王符《潜夫论·贤难》"},"example":{"text":"问：“如何是东禅家风？”师曰：“～。”","book":"宋·释道原《景德传灯录》卷二十一"},"similar":["众口铄金","道听途说"],"opposite":["百炼成钢"],"usage":"作谓语、分句；用于口语或否定句"},{"id":71,"word":"一人做事一人当","pinyin":"yī rén zuò shì yī rén dāng","abbr":"yrzsyrd","explanation":"当：承担。自己出的漏子，自己一个人承担。","source":{"text":"我如今往乾元山上，问我师尊，必有主意。常言道：‘一人做事一人当。’岂敢连累父母？","book":"明·许仲琳《封神演义》第十二回"},"example":{"text":"那谢逊与俺有杀兄之仇，大丈夫～，请少林众高僧将他牵将出来，老夫一刀将他杀了。","book":"金庸《倚天屠龙记》第三十七回"},"similar":["敢作敢为","好汉做事好汉当"],"usage":"作谓语、定语；多用于口语"},{"id":72,"word":"一人元良","pinyin":"yī rén yuán liáng","abbr":"yryl","explanation":"元良：天子。指天子一人。","source":{"text":"一人元良，万邦以贞。","book":"《尚书·大甲下》"},"example":{"text":"～，万邦以定。为副君者，非此而谁？","book":"《旧唐书·玄宗纪》"}},{"id":73,"word":"一人吃斋，十人念佛","pinyin":"yī rén chī zhāi，shí rén niàn fó","abbr":"yrczsrnf","explanation":"吃斋：相信佛教的人吃素；念佛：念佛经。一个人吃素会带动许多人念佛经。比喻一个人做某种事情，带动好多人也去做。","source":{"text":"常言道：一人吃斋，十人念佛。因这场巡检夫妻好道，连这老门公也信心的。","book":"明·罗贯中《平妖传》第七回"}},{"id":74,"word":"一人向隅","pinyin":"yī rén xiàng yú","abbr":"yrxy","explanation":"隅：角落。一个人朝着屋角创造性落泪。形容在公共聚会中因一个人的不悦影响了整个气氛。","source":{"text":"古人有言：满堂而饮酒，有一人乡隅而悲泣，则一堂皆为之不乐。","book":"《汉书·刑法志》"},"example":{"text":"大家都有相好，如何老前辈～！","book":"清·曾朴《孽海花》第七回"}},{"id":75,"word":"一人向隅，一堂不欢","pinyin":"yī rén xiàng yú，yī táng bù huān","abbr":"yrxyytbh","explanation":"隅：角落。一个人朝着屋角创造性落泪，屋里的人都不高兴。形容在公共聚会中因一个人的不悦影响了整个气氛。","source":{"text":"古人有言：满堂而饮酒，有一人乡隅而悲泣，则一堂皆为之不乐。","book":"《汉书·刑法志》"}},{"id":76,"word":"一人向隅，满坐不乐","pinyin":"yī rén xiàng yú，mǎn zuò bù lè","abbr":"yrxymzbl","explanation":"指满堂之上，一人不乐，众皆为之不欢。","source":{"text":"故圣人之于天下也，譬犹一堂之上也。今有满堂饮酒者，有一人独索然向隅而泣，则一堂之人皆不乐矣。","book":"汉·刘向《说苑·贵德》"},"example":{"text":"方见一少年，举杯瞻之曰：‘～，小人窃不自量，愿闻金玉之声。’","book":"《太平广记》卷二八一引唐·薛渔思《河东记·独孤遐叔》"},"usage":"作宾语、定语；用于书面语"},{"id":77,"word":"一人向隅，满堂不乐","pinyin":"yī rén xiàng yú，mǎn táng bù lè","abbr":"yrxymtbl","explanation":"隅：角落。一个人朝着屋角创造性落泪，屋里的人都不高兴。形容在公共聚会中因一个人的不悦影响了整个气氛。","source":{"text":"古人有言：满堂而饮酒，有一人乡隅而悲泣，则一堂皆为之不乐。","book":"《汉书·刑法志》"},"example":{"text":"且～；一物失所，纳隍增虑。","book":"《旧唐书·严挺之传》"}},{"id":78,"word":"一人善射，百夫决拾","pinyin":"yī rén shàn shè，bǎi fū jué shí","abbr":"yrssbfjs","explanation":"古谚语，意思是为将者善战，其士卒亦必勇敢无前。亦比喻凡事为首者倡导于前，则其众必起而效之。","source":{"text":"决，勾弦。拾，捍。言申胥、华登善用兵众必化之；犹一人善射，而百夫竞著决拾而效之。","book":"《国语·吴语》：“夫申胥、华登简服吴国志士于甲兵，而未尝有所挫也。夫一人善射，百夫决拾，胜未可成也。”韦昭注"},"example":{"text":"夫～，众人好施，则风俗随之。","book":"康有为《大同书》辛部第十二章"},"similar":["名师出高徒"],"usage":"作宾语、分句；用于评论一个集体"},{"id":79,"word":"一人当百","pinyin":"yī rén dāng bǎi","abbr":"yrdb","explanation":"一个人可以抵挡百人。形容力大而勇猛。","source":{"text":"以韩卒之勇，被坚甲，蹠劲弩，带利剑，一人当百，不足言也。","book":"《史记·苏秦列传》"},"example":{"text":"天下之强弓劲弩，皆从韩出，韩卒之勇，～。","book":"宋·洪迈《容斋续笔》卷二"}},{"id":80,"word":"一人得道，九族升天","pinyin":"yī rén dé dào，jiǔ zú shēng tiān","abbr":"yrddjzst","explanation":"一个人得道成仙，全家族都随之升天。比喻一个人做了官，和他有关系的人也都跟着得势。","source":{"text":"淮南王学道，招会天下有道之人，倾一国之尊，下道术之士，是以道术之士并会淮南，奇方异术，莫不争出。王遂得道，举家升天，畜产皆仙，犬吠于天上，鸡鸣于云中。","book":"汉·王充《论衡·道虚》"}},{"id":81,"word":"一人得道，鸡犬升天","pinyin":"yī rén dé dào，jī quǎn shēng tiān","abbr":"yrddjqst","explanation":"一个人得道面仙，全家连鸡、狗也都随之升天。比喻一个人做了官，和他有关系的人也都跟着得势。","source":{"text":"招会天下有道之人，倾一国之尊，下道术之士，是以道术之士并会淮南，奇方异术，莫不争出。王遂得道，举家升天，畜产皆仙，犬吠于天上，鸡鸣于云中。","book":"汉·王充《论衡·道虚》"},"example":{"text":"‘～’的道理不仅自古有之，现实生活当中也并不少见。","book":"尚久骖《糖为什么这么甜》"},"similar":["一人飞升，鸡犬升天"],"usage":"作宾语、分句；用于人事关系","story":["汉武帝时，淮南王刘安笃信修道炼丹，一次遇到八个鹤发童颜的老翁，拜他们为师，学习修道炼丹，丹药炼成后，汉武帝派人来抓他，他情急下喝了丹药，成仙升天。他的亲友也赶紧喝药成仙。刘家的鸡狗因吃了炼丹锅里的丹药也成仙了"]},{"id":82,"word":"一人得道，鸡犬飞升","pinyin":"yī rén dé dào，jī quǎn fēi shēng","abbr":"yrddjqfs","explanation":"一个人得道成仙，全家连鸡、狗也都随之升天。比喻一个人做了官，和他有关系的人也都跟着得势。","source":{"text":"淮南王学道，招会天下有道之人，倾一国之尊，下道术之士，是以道术之士并会淮南，奇方异术，莫不争出。王遂得道，举家升天，畜产皆仙，犬吠于天上，鸡鸣于云中。","book":"汉·王充《论衡·道虚》"},"example":{"text":"这事一办成，你就一步登天，你们一家人的日子也马上苦尽甜来。古话说得好：～。","book":"姚雪垠《李自成》第二卷第二章"},"similar":["一人得道，鸡犬升天"],"usage":"作宾语、分句；用于人事关系"},{"id":83,"word":"一人拼命，万夫莫当","pinyin":"yī rén pīn mìng，wàn fū mò dāng","abbr":"yrpmwfmd","explanation":"夫：成年男子。一个人拼着性命干，谁也阻挡不住。","source":{"text":"自古道：‘一人拼命，万夫难当。’倘若你们打出事来，岂不是人财两空、依了我，莫打的好！","book":"明·罗贯中《粉妆楼》第二十二回"},"example":{"text":"地下的人虽多，那里挡得住，自古说的：～。","book":"清·曹雪芹《红楼梦》第一百三回"}},{"id":84,"word":"一人拼命，万夫难当","pinyin":"yī rén pīn mìng，wàn fū nán dāng","abbr":"yrpmwfnd","explanation":"夫：成年男子。一个人拼着性命干，谁也阻挡不住。","source":{"text":"自古道：‘一人拼命，万夫难当。’倘若你们打出事来，岂不是人财两空、依了我，莫打的好！","book":"明·罗贯中《粉妆楼》第二十二回"}},{"id":85,"word":"一人敌","pinyin":"yī rén dí","abbr":"yrd","explanation":"指匹夫之勇，止足以敌一人。","source":{"text":"夫抚 剑疾视，曰：‘彼恶敢当我哉！’此匹夫之勇，敌一人者也。","book":"语出《孟子·梁惠王下》"},"example":{"text":"剑，～，不足学；学万人敌。","book":"《史记·项羽本纪》"},"similar":["匹夫之勇"],"usage":"作宾语、定语；用于书面语"},{"id":86,"word":"一人有庆","pinyin":"yī rén yǒu qìng","abbr":"yryq","explanation":"常用为歌颂帝王德政之词。","source":{"text":"一人有庆，兆民赖之，其宁惟永。","book":"《尚书·吕刑》"},"example":{"text":"明·冯梦龙《警世通言》第32卷：“～民安乐，四海无虞国太平。”"},"usage":"作宾语、定语；用于书面语"},{"id":87,"word":"一人有福，带挈一屋","pinyin":"yī rén yǒu fú，dài qiè yī wū","abbr":"yryfdqyw","explanation":"带挈：带领。一个人得到了好处，周围的人连带受益。","source":{"text":"常言道，一人有福，带挈一屋。我们在此合药，俱是有功之人，只管受用去，再休多话。","book":"明·吴承恩《西游记》第六十九回"}},{"id":88,"word":"一人有福，拖带满屋","pinyin":"yī rén yǒu fú，tuō dài mǎn wū","abbr":"yryftdmw","explanation":"带挈：带领。一个人得到了好处，周围的人连带受益。","source":{"text":"常言道，一人有福，带挈一屋。我们在此合药，俱是有功之人，只管受用去，再休多话。","book":"明·吴承恩《西游记》第六十九回"},"example":{"text":"正是“～”。若不是晁夫人是善知识，怎能够把将绝的衰门从新又延了宗祀？","book":"清·西周生《醒世姻缘传》第二十一回"}},{"id":89,"word":"一人有罪","pinyin":"yī rén yǒu zuì","abbr":"yryz","explanation":"旧指天子的过失。","source":{"text":"在《汤誓》曰，余一人有罪，无以万夫；万夫有罪，在余一身。","book":"《国语·周语上》"},"example":{"text":"我说过的，～，三人连坐。今日为你待出去行香，不曾数到你身上，你到替别人说起话来！","book":"清·西周生《醒世姻缘传》第九十一回"}},{"id":90,"word":"一人毁誉","pinyin":"yī rén huǐ yù","abbr":"yrhy","explanation":"毁：毁谤；誉：夸赞。一个人的毁谤或赞扬。指只凭少数人的好恶来决定人事。","source":{"text":"夫陛下以一人之誉而召臣，一人之毁而去臣，臣恐天下有识闻之有以闚陛下也。","book":"《史记·季布栾布列传》"}},{"id":91,"word":"一人私言","pinyin":"yī rén sī yán","abbr":"yrsy","explanation":"个人私下的言论、见解，而不是公认的见解。","source":{"text":"老子之所谓道德云者，去仁与义言之也，一人之私言也。","book":"唐·韩愈《原道》"}},{"id":92,"word":"一人立志，万夫莫夺","pinyin":"yī rén lì zhì，wàn fū mò duó","abbr":"yrlzwfmd","explanation":"形容志向坚定，别人很难改变。","source":{"text":"正是‘一人立志，万夫莫夺’。","book":"明·冯梦龙《醒世恒言·大树坡义虎送亲》"},"example":{"text":"～，我不会改变主意的。"},"similar":["矢志不移"],"usage":"作宾语、定语、分句；指矢志不移","story":["唐朝天宝年间，福州人勤自励与定同县林潮音二人青梅竹马，两小无猜。勤自励因武艺过人而参加安南平叛军，一去十年没有音信。林潮音不顾父母改嫁的命令，她有‘一人立志，万夫莫夺’的决心，坚决不从，在被骗婚的途中被老虎救走，从而夫妻团聚"]},{"id":93,"word":"一人耳目","pinyin":"yī rén ěr mù","abbr":"yrem","explanation":"一：统一。统一人们的视听，便于指挥。","source":{"text":"言不相闻，故为金鼓；视不相见，故为旌旗。夫金鼓旌旗者，所以一人之耳目也。","book":"《孙子·军争》"},"example":{"text":"灵帝遂不敢登台，阉党益肆行无忌，但教瞒过～，还怕甚么百官万民？","book":"蔡东藩《后汉演义》第六十四回"}},{"id":94,"word":"一人飞升，仙及鸡犬","pinyin":"yī rén fēi shēng，xiān jí jī quǎn","abbr":"yrfsxjjq","explanation":"用以比喻一人得势，与其有关者亦皆随之发迹。多含讽刺意。同“一人得道，鸡犬升天”。","source":{"text":"一人飞升，仙及鸡犬。","book":"《神异记·刘安》"},"example":{"text":"闻之：‘～’信夫！","book":"清·蒲松龄《聊斋志异·促织》"},"similar":["一人得道，鸡犬升天"],"usage":"作宾语、分句；用于社会的裙带关系","story":["汉武帝时，淮南王刘安笃信修道炼丹，一次遇到八个鹤发童颜的老翁，拜他们为师，学习修道炼丹，丹药炼成后，汉武帝派人来抓他，他情急下喝了丹药，成仙升天。他的亲友也赶紧喝药成仙。刘家的鸡狗因吃了炼丹锅里的丹药也成仙了"]},{"id":95,"word":"一人高升，众人得济","pinyin":"yī rén gāo shēng，zhòng rén dé jì","abbr":"yrgszrdj","explanation":"比喻一个人做了大官，和他有关系的人也都跟着得势。","source":{"text":"一人高升，众人得济。你一个人挣钱，一大家子人不受急窄了。","book":"梁斌《红旗谱》第一卷"},"example":{"text":"忠大伯用手巾擦了茶碗，给冯大狗斟上茶，说：“～。你一个人挣钱，一大家子人不受急窄了。”","book":"梁斌《红旗谱》十三"},"similar":["一夫得道，九族升天"],"usage":"作宾语、分句；用于人事关系"},{"id":96,"word":"一介不取","pinyin":"yī jiè bù qǔ","abbr":"yjbq","explanation":"一介：一粒芥菜子，形容微小。一点儿小东西也不拿。形容廉洁、守法，不是自己应该得到的一点都不要。","source":{"text":"其非义也，非其道也，一介不以与人，一介不以取诸人。","book":"《孟子·万章上》"},"example":{"text":"丈夫心地光明，～。","book":"明·东鲁古狂生《醉醒石》第十一回"},"similar":["两袖清风","一介不苟"],"opposite":["贪污腐化"],"usage":"作谓语、定语；指为人清廉"},{"id":97,"word":"一介不苟","pinyin":"yī jiè bù gǒu","abbr":"yjbg","explanation":"形容廉洁、守法，不是自己应该得到的一点都不要。同“一介不取”。","source":{"text":"我平生于银钱一道，一介不苟。","book":"清·文康《儿女英雄传》第十二回"},"similar":["一介不取"],"usage":"作谓语、定语；指为人清廉"},{"id":98,"word":"一介之善","pinyin":"yī jiè zhī shàn","abbr":"yjzs","explanation":"微小的善行。","source":{"text":"其有一介之善、一方文艺，居接士之馆。","book":"《西京杂记》卷四"},"example":{"text":"虽闾巷～，甚或辈行绝数等，未尝不委曲外比，售其声名。","book":"宋·叶適《郑景元墓志铭》"},"usage":"作主语、宾语；用于书面语"},{"id":99,"word":"一介之士","pinyin":"yī jiè zhī shì","abbr":"yjzs","explanation":"一个微末的士人。指忠心正直的人。","source":{"text":"彼越王者一节之人，范蠡一介之士。","book":"汉·赵晔《吴越春秋·勾践入臣外传》"},"example":{"text":"自湖南军兴，～，长官倒屣。","book":"清·王闿运《长沙攸县庆都龙君行状》"},"usage":"作宾语；指忠心正直的人"},{"id":100,"word":"一介之夫","pinyin":"yī jiè zhī fū","abbr":"yjzf","explanation":"介：耿介。一个正直的人。","source":{"text":"中世偏行一介之夫，能成名立方者，盖亦乐也。","book":"《后汉书·独行传序》"}},{"id":101,"word":"一介之才","pinyin":"yī jiè zhī cái","abbr":"yjzc","explanation":"指微小的才能。","source":{"text":"一介，谓小才也。","book":"《后汉书·杜诗传》：“臣诗伏自惟忖，本以史吏一介之才，遭陛下创制大业，贤俊在外，空乏之间，超受大恩。”《文选·陆倕〈石阙铭序〉》：“兴建庠序，启设郊丘，一介之才必记，天文之典咸秩。”吕向注"},"example":{"text":"南朝·梁·陆倕《石阙铭序》：“兴建痒序，启设郊丘，～必记，无文之典咸秩。”"},"usage":"作主语、宾语；用于自谦"},{"id":102,"word":"一介之辅","pinyin":"yī jiè zhī fǔ","abbr":"yjzf","explanation":"一介：一个；辅：辅佐。具有一片忠心辅佐君王的臣子。","source":{"text":"圣朝无一介之辅，股肱无折冲之势。","book":"三国·魏·陈琳《为袁绍檄豫州》"}},{"id":103,"word":"一介书生","pinyin":"yī jiè shū shēng","abbr":"yjss","explanation":"一介：一个。旧时读书人的自称或对普通读书人的雅称。","source":{"text":"勃三尺微命，一介书生。","book":"唐·王勃《秋日登洪州滕王阁饯别序》"},"example":{"text":"读书人又称书生。这固然是个可以骄傲的名字，如说“～”、“书生本色”，都含有清高的意思。","book":"朱自清《论书生的酸气》"},"similar":["一介儒生"],"usage":"作宾语、定语；用作谦词"},{"id":104,"word":"一介儒生","pinyin":"yī jiè rú shēng","abbr":"yjrs","explanation":"一介：一个。旧时读书人的自称或对普通读书人的雅称。","source":{"text":"勃三尺微命，一介书生。","book":"唐·王勃《秋日登洪州滕王阁饯别序》"},"example":{"text":"生员乃～，何敢妄干国政。","book":"清·石玉昆《三侠五义》第四十七回"},"similar":["一介书生"],"usage":"作宾语、定语；用作谦词"},{"id":105,"word":"一介武夫","pinyin":"yī jiè wǔ fū","abbr":"yjwf","explanation":"一介：一个；武夫：军人。一个军人。学中用作自谦之词。","source":{"text":"某乃败军之将，一介武夫，诸将军智勇足备，何下问于小将也。","book":"明·清溪道人《禅真逸史》第三十一回"},"example":{"text":"吾～，由行伍擢至总镇。今幸东南底定，百战馀生，荷天宠锡，已叨非分，又何求焉？","book":"《清史稿·朱洪章传》"}},{"id":106,"word":"一介野生","pinyin":"yī jiè yě shēng","abbr":"yjys","explanation":"一介：一个。一个鄙野的书生。常用作自谦之词。","source":{"text":"既至，自陈一介野生，无国国之用，归诚求去。","book":"《三国志·魏志·管宁传》"}},{"id":107,"word":"一仍旧贯","pinyin":"yī réng jiù guàn","abbr":"yrjg","explanation":"一：都，全；仍：因袭，依照；贯：习惯的办法。执照老规矩办事，没有丝毫改变。","source":{"text":"鲁人为长府，闵子骞曰：‘仍旧贯，如之何？何必改作？’","book":"《论语·先进》"},"example":{"text":"其谱～，并未变动。","book":"鲁迅《且介亭杂文·不知肉味和不知水味》"},"similar":["墨守成规"],"opposite":["推陈出新"],"usage":"作谓语、定语；指不知变通","story":["春秋时期，鲁国为了扩充军备，增加在诸侯国之间的竞争实力，开始在国内大建粮仓，在征求大臣的意见时，大夫闵子骞则说：“还是按以前老规矩建吧，怎么样？何必去改呢？”其他大夫认为他墨守成规"]},{"id":108,"word":"一代不如一代","pinyin":"yī dài bù rú yī dài","abbr":"ydbryd","explanation":"代：父子相继为一代。一代比一代差。","source":{"text":"谷视之，笑谓忠懿曰：‘此谓一代不如一代也。’","book":"宋·王君玉《国老谈苑》第二卷"},"example":{"text":"九斤老太虽然高寿，耳朵却还不很聋，但也没有听到孩子的话，仍旧自己说：‘这真是～’！","book":"鲁迅《风波》"},"similar":["每况愈下"],"opposite":["后浪推前浪"],"usage":"作宾语、定语；指越来越差","story":["古代一个有钱人家养了很多鸟，一个朋友来拜访，见白鹤就问养鸟人是什么鸟。养鸟人骗他是尖嘴老鸦，再问淘河，养鸟人说是尖嘴老鸦的儿子，又问白鹭，养鸟人骗他这是尖嘴老鸦的孙子。这人自我感慨地说：“真是一代不如一代。”"]},{"id":109,"word":"一代儒宗","pinyin":"yī dài rú zōng","abbr":"ydrz","explanation":"儒宗：儒家学者的宗师。指一个时代的城学大师。","source":{"text":"故能驰声海内，为一代儒宗。虽前世徐广、何承天之俦，不足过也。","book":"《周书·儒林传》"},"example":{"text":"先生～，今日即位颁诏，烦先生起草，幸勿再辞！","book":"蔡东藩《明史演义》第二十六回"}},{"id":110,"word":"一代国色","pinyin":"yī dài guó sè","abbr":"ydgs","explanation":"国色：美丽超群的女子。为一代人当中长得最美的女子。","source":{"text":"乔家二女双芙蓉，一代国色江之东。","book":"元·杨维桢《题二乔观书图》"}},{"id":111,"word":"一代宗匠","pinyin":"yī dài zōng jiàng","abbr":"ydzj","explanation":"形容一个时代的人们所尊崇、敬仰的著名文学家。","source":{"text":"自有陈创业，文檄军书及禅授诏书，皆陵所制，而《九锡》尤美，为一代文宗，亦不以此矜物，未尝诋诃作者。","book":"《陈书·除陵传》"},"example":{"text":"好之者推为～，亦多受世抉摘云。","book":"《明史·李攀龙传》"}},{"id":112,"word":"一代宗工","pinyin":"yī dài zōng gōng","abbr":"ydzg","explanation":"指在学问、技艺等方面一个时代为众所推崇的巨匠。","source":{"text":"兵后，故老皆尽，好问蔚为一代宗工，四方碑板铭志，尽趋其门。","book":"《金史·元好问传》"},"example":{"text":"基、濂学术醇深，文章古茂，同为～。","book":"《明史·刘基等传赞》"}},{"id":113,"word":"一代宗臣","pinyin":"yī dài zōng chén","abbr":"ydzc","explanation":"一个时代中大家所景仰的大臣。","source":{"text":"淮阴黥布等已灭，唯何参擅功名，位冠群臣，声施后世，为一代之宗臣。","book":"《汉书·萧何曹参传赞》"},"similar":["一代鼎臣"],"usage":"作宾语、定语；用于书面语"},{"id":114,"word":"一代文宗","pinyin":"yī dài wén zōng","abbr":"ydwz","explanation":"宗：宗师。一个时代为众人所宗仰的文学家。亦作“当世辞宗”、“一代宗匠”、“一代辞宗”。","source":{"text":"自有陈创业，文檄军书及禅授诏书，皆陵所制，而《九锡》尤美，为一代文宗，亦不以此矜物，未尝诋诃作者。","book":"《陈书·除陵传》"},"example":{"text":"清·李宝嘉《官场现形记》第二回：“他本是～，不觉肃然起敬。”"},"usage":"作宾语、定语；用于文人"},{"id":115,"word":"一代文豪","pinyin":"yī dài wén háo","abbr":"ydwh","explanation":"豪：才能杰出的人。一个时代杰出的文学家。","source":{"text":"宋杨大年，作文顷刻数千言，真一代之文豪。","book":"宋·欧阳修《归田录》"}},{"id":116,"word":"一代楷模","pinyin":"yī dài kǎi mó","abbr":"ydkm","explanation":"一个时代的模范人物。","source":{"text":"朕今非直成公雅志，欲以公为一代楷模。","book":"《旧唐书·李靖传》"},"example":{"text":"周总理是现代社会的～。"},"usage":"作宾语、定语；指一个时代的模范人物","story":["唐朝开国皇帝李渊起兵打天下，李靖率兵跟随南征北战，屡立战功。唐太宗对他十分信任，封他为尚书右仆射。李靖有自知之明，应该激流勇退，解甲归田，就上书唐太宗请辞。唐太宗成全他的志向，把他树为一代楷模"]},{"id":117,"word":"一代谈宗","pinyin":"yī dài tán zōng","abbr":"ydtz","explanation":"谈宗：善于言谈，为世人所尊崇。指当代清谈大师。","source":{"text":"君天才过人，恨不学耳！若学，必为一代谈宗。","book":"《晋书·潘京传》"},"usage":"作宾语；指清谈大师"},{"id":118,"word":"一代辞宗","pinyin":"yī dài cí zōng","abbr":"ydcz","explanation":"辞宗：辞赋作者中的宗师。指一个时代为人所尊崇的文学家。","source":{"text":"昉起草即成，不加点窜。沈约一代辞宗，深所推挹。","book":"《南史·任昉传》"},"example":{"text":"张九龄～，为中书令，引陟为中书舍人，与孙逖、梁涉对掌文诰，时人以为美谈。","book":"《旧唐书·韦陟传》"}},{"id":119,"word":"一代风流","pinyin":"yī dài fēng liú","abbr":"ydfl","explanation":"指创立风尚、为当时景仰的人物。","source":{"text":"一代风流尽，修文地下深，斯人不重见，将老失知音。","book":"唐·杜甫《哭李常侍铎》"},"example":{"text":"～尽，三师礼数崇。","book":"宋·陈师道《后山集·丞相温公挽词》"},"similar":["万古流芳","一代天骄","一代辞字"],"opposite":["遗臭万年","一代奸雄"],"usage":"作宾语、定语；指时尚的东西"},{"id":120,"word":"一代风骚主","pinyin":"yī dài fēng sāo zhǔ","abbr":"ydfsz","explanation":"风骚：原指《诗经》中的《国风》和《楚辞》中的《离骚》，泛指文学。一个时代的文坛领袖人物。","source":{"text":"司空叹息抚背曰：‘当为一代风骚主。’","book":"宋·龙袤《全唐诗话》卷五"},"usage":"作宾语、定语；用于书面语"},{"id":121,"word":"一代鼎臣","pinyin":"yī dài dǐng chén","abbr":"yddc","explanation":"一个时代中大家所景仰的大臣。同“一代宗臣”。","source":{"text":"公为一代鼎臣，不可复为覆餗sù。","book":"《南史·丘灵鞠传》"},"similar":["一代宗臣"],"usage":"作宾语、定语；用于书面语"},{"id":122,"word":"一以当十","pinyin":"yī yǐ dāng shí","abbr":"yyds","explanation":"当：相当。一个人抵挡十个人。形容军队英勇善战。","source":{"text":"楚战士无不一以当十，楚兵呼声动天，诸侯军无不人人惴恐。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"弓强兵锐，所向无前，士气轰腾，无不～。","book":"明·邵璨《香囊记·拾囊》"},"similar":["以一当十","一以当百"],"usage":"作谓语、定语；同“以一当十”","story":["秦朝末年，秦国大将章邯打败赵国大将张耳，赵王歇只好向楚怀王求救，怀王派宋义项羽去救赵，宋义故意拖延时间，项羽杀宋义自立为主帅，命令士兵破釜沉舟，轻装上阵的楚军个个奋不顾身，没有一个不是一以当十的，大败秦军"]},{"id":123,"word":"一以当千","pinyin":"yī yǐ dāng qiān","abbr":"yydq","explanation":"当：相当。一个人抵挡一千个人。形容军队英勇善战。","source":{"text":"疲兵再战，一以当千，然犹扶乘创痛，决命争首，死伤积野，馀不满百，而皆扶病，不任干戈。","book":"汉·李陵《答苏武书》"},"example":{"text":"然后受命装日本人，玮玮装中国军队，一阵机关枪把～的日本兵打得落花流水。","book":"宗璞《南渡记》第三章"}},{"id":124,"word":"一以当百","pinyin":"yī yǐ dāng bǎi","abbr":"yydb","explanation":"一人抵过百人。极言勇猛。","source":{"text":"楚玉也自领全军杀将前去。及至两不相对，真个人强马壮，一以当百。杀得那些山贼，抱头而窜。","book":"清·李渔《比目鱼》第十四回"},"example":{"text":"清·夏燮《中西纪事·海疆殉难记》：“夷兵再却再进，我军无不～，自辰至申，饥不得食，渴不得饮，誓死格斗。”"},"similar":["一以当十"],"usage":"作谓语、定语；用于书面语"},{"id":125,"word":"一以贯之","pinyin":"yī yǐ guàn zhī","abbr":"yygz","explanation":"贯：贯穿。用一个根本性的事理贯通事情的始末或全部的道理。","source":{"text":"子曰：‘参乎！吾道一以贯之’曾子曰：‘唯。’子出，门人问曰：‘何谓也？’曾子曰：‘夫子之道，忠恕而已矣。’","book":"《论语·里仁》"},"example":{"text":"据谷超豪等人回忆，凡遇应当参加的讨论会，苏先生向来是风雨无阻，几十年间～。","book":"刘征泰《苏步青》"},"similar":["始终如一","有始有终","善始善终"],"opposite":["虎头蛇尾","有始无终"],"usage":"作谓语、状语、宾语；指自始至终"},{"id":126,"word":"一传十，十传百","pinyin":"yī chuán shí，shí chuán bǎi","abbr":"ycsscb","explanation":"原指疾病传染，后形容消息传播极快。","source":{"text":"一传十，十传百，展转无穷，故号义闰。","book":"宋·陶彀《清异录·丧葬》"},"example":{"text":"自从加克娶了姑娘，人人都道彩凤随鸦，不免纷纷议论，～，就传到了鲁翠、波儿麻等一班党人耳中。","book":"清·曾朴《孽海花》第十六回"},"similar":["一人传十，十人传百"],"usage":"作谓语、分句；形容消息传播极快"},{"id":127,"word":"一体同心","pinyin":"yī tǐ tóng xīn","abbr":"yttx","explanation":"一体：一个整体；同心：齐心。比喻关系密切，共同一心。","source":{"text":"二人凡心，其利断金；同心之言，其臭如兰。","book":"《仪礼·丧服》：“父子一体也，夫妻一体也，昆弟一体也。”《周易·系辞上》"},"usage":"作谓语、定语；用于兄弟、夫妻、父子等"},{"id":128,"word":"一体知悉","pinyin":"yī tǐ zhī xī","abbr":"ytzx","explanation":"一体：一律。一律通知照办。旧时公文用语。","source":{"text":"自此以后，只称我为齐天大圣，不许再称大王。亦可传与各洞妖王，一体知悉。","book":"明·吴承恩《西游记》第四回"},"example":{"text":"大元帅的这番钧谕，末将一定牢记心中，也要晓谕手下的文武们～。","book":"姚雪垠《李自成》第三卷第三十六章"},"similar":["一体知照"],"usage":"作谓语、分句；用于公文等"},{"id":129,"word":"一体知照","pinyin":"yī tǐ zhī zhào","abbr":"ytzz","explanation":"一体：一律。一律通知照办。旧时公文用语。","source":{"text":"自此以后，只称我为齐天大圣，不许再称大王。亦可传与各洞妖王，一体知悉。","book":"明·吴承恩《西游记》第四回"},"example":{"text":"合行布告，仰各学院各附校负生～，届时照常上课为要。此布。","book":"胡适《说儒·南游杂忆》"},"similar":["一体知悉"],"usage":"作谓语、分句；用于公文等"},{"id":130,"word":"一何至此","pinyin":"yī hé zhì cǐ","abbr":"yhzc","explanation":"意思是竟然到了如此的地步。","source":{"text":"陛下六宫万数，而妾唯驸马一人。事不均平，一何至此！","book":"《史记·商君列传》：“嗟乎，为法之敝一至此哉！”《宋书·前废帝纪》"},"example":{"text":"乱离方始，生死谁知。人主爱人，～！","book":"明·冯梦龙《醒世恒言》卷二十四"}},{"id":131,"word":"一佛出世","pinyin":"yī fó chū shì","abbr":"yfcs","explanation":"犹一佛出世，二佛生天。","source":{"text":"［差拨］把林冲骂得一佛出世，那里敢抬头应答。","book":"明·施耐庵《水浒传》第九回"},"example":{"text":"遂把李三上起刑法来，打得～，二佛生天，只不肯招。","book":"明·凌濛初《二刻拍案惊奇》卷三十八"},"usage":"作定语、状语；用于书面语"},{"id":132,"word":"一佛出世，二佛升天","pinyin":"yī fó chū shì，èr fó shēng tiān","abbr":"yfcsefst","explanation":"死去活来之意。出世，生；生天，死。","source":{"text":"［李清］直等到一佛出世，二佛升天，方才有个青衣童子开门出来。","book":"明·冯梦龙《醒世恒言》第三十八卷"},"example":{"text":"陈月波、马剑郎只好把气出在那两个卫兵的身上，骂得他们～。","book":"侯枫《海陆丰农民运动的领导者彭湃》"},"similar":["一佛出世，二佛生天"],"usage":"作状语；用于书面语"},{"id":133,"word":"一佛出世，二佛涅槃","pinyin":"yī fó chū shì，èr fó niè pán","abbr":"yfcsefnp","explanation":"佛家称生为“出世”，死为“涅槃”。指死去活来。","source":{"text":"打得宋江一佛出世，二佛涅槃，皮开肉绽，鲜血淋漓。","book":"明·施耐庵《水浒全传》第三十九回"},"example":{"text":"一弯腰，坐在地下，放声大哭起来，一面哭，一面诉，这一哭，直是哭得～。","book":"清·吴趼人《二十年目睹之怪现状》第八十九回"},"similar":["一佛出世，二佛生天","死去活来"],"usage":"作状语；指死去活来","story":["梁山泊好汉宋江到江州浔阳楼饮酒，借着酒兴在墙上作了一首《西江月》的词，并署上自己的大名，被奸佞之徒黄文炳以反诗的名义报告给蔡九知府。蔡九立即派人捉拿宋江，并把他打得一佛出世，二佛涅槃，皮开肉绽，鲜血淋漓后才投入大牢"]},{"id":134,"word":"一佛出世，二佛涅盘","pinyin":"yī fó chū shì，èr fó niè pán","abbr":"yfcsefnp","explanation":"佛家称生为出世，死为涅盘。指死去活来。","source":{"text":"打得宋江一佛出世，二佛涅盘，皮开肉绽，鲜血淋漓。","book":"明·施耐庵《水浒全传》第三十九回"}},{"id":135,"word":"一佛出世，二佛生天","pinyin":"yī fó chū shì，èr fó shēng tiān","abbr":"yfcsefst","explanation":"死去活来之意。出世，生；生天，死。","source":{"text":"合家见防御说得伤心，一齐号哭起来。直哭得一佛出世，二佛生天，连崔生也不知陪下了多少眼泪。","book":"明·凌濛初《二刻拍案惊奇》卷二十三"},"similar":["一佛出世，二佛升天"],"usage":"作状语；用于书面语"},{"id":136,"word":"一佛升天，二佛出世","pinyin":"yī fó shēng tiān，èr fó chū shì","abbr":"yfstefcs","explanation":"升天：死亡；出世：生。佛出生又死去。指活过来又死去","source":{"text":"那拉懿嫔回忆旧日慈眷，格外悲戚，哭得一佛升天，二佛出世，几乎有痛不欲生的形状。","book":"《慈禧太后演义》第六回"},"similar":["一佛出世，二佛生天"],"usage":"作状语；用于书面语"},{"id":137,"word":"一依旧式","pinyin":"yī yī jiù shì","abbr":"yyjs","explanation":"一切按照原来的规格或方式进行。","source":{"text":"隋国置丞相以下，一依旧式。","book":"《隋书·高祖纪上》"},"usage":"作谓语、定语；用于书面语"},{"id":138,"word":"一倡一和","pinyin":"yī chàng yī hé","abbr":"ycyh","explanation":"①指一个先唱，一个和声，形容两人感情相通。后多比喻两人相互配合，彼此呼应。倡，亦作“唱”。②指鸣声相呼应。","source":{"text":"叔兮伯兮，倡予和女。","book":"《诗·郑风·萚兮》"},"example":{"text":"自此～，渐渐情熟，往来不绝。","book":"《警世通言·王娇鸾百年长恨》"},"similar":["一唱一和"],"usage":"作谓语、定语、状语；指互相呼应"},{"id":139,"word":"一倡三叹","pinyin":"yī chàng sān tàn","abbr":"ycst","explanation":"指一人歌唱，三人相和。后多用以形容音乐、诗文优美，富有余味，令人赞赏不己。倡，亦作“唱”。","source":{"text":"清庙之歌，一倡而三叹也。","book":"《荀子·礼论》"},"example":{"text":"《乐府诗集·周宗庙乐舞辞》：“～，朱弦之声。”"},"similar":["一唱三叹"],"usage":"作谓语、宾语、分句；用于音乐或诗歌"},{"id":140,"word":"一倡百和","pinyin":"yī chàng bǎi hè","abbr":"ycbh","explanation":"和：呼应，附和。一人首倡，百人附和。形容附和的人极多。","source":{"text":"郢书燕说，一倡百和。","book":"清·江藩《汉学师承记·惠周惕》"},"example":{"text":"有年老者，以为财神变相，亟以香烛净茶祝而送之，～，比户皆然，喧闹半时。","book":"清·淮阴百一居士《壶天录》"},"similar":["一呼百应"],"usage":"作谓语；指附和的人极多"},{"id":141,"word":"一假手之劳","pinyin":"yī jiǎ shǒu zhī láo","abbr":"yjszl","explanation":"比喻不费力，只是一抬手那样。","source":{"text":"如有力者，哀其穷而运转之，盖一举手一投足之劳也。","book":"唐·韩愈《应科目时与人书》"}},{"id":142,"word":"一偏之见","pinyin":"yī piān zhī jiàn","abbr":"ypzj","explanation":"偏于一面的见解。","source":{"text":"安石任一偏之见，改立新议，以害天下大公。","book":"《宋史·刘述传》"},"example":{"text":"一定要说杜甫不曾酒后失言，一定要说严武决不会动欲杀之念，看来，都不免是～。","book":"郭沫若《李白与杜甫·杜甫与严武》"},"usage":"作宾语；用于处事"},{"id":143,"word":"一偏之言","pinyin":"yī piān zhī yán","abbr":"ypzy","explanation":"争执的双方中一方所说的话。指单方面的话，片面的看法。","source":{"text":"元帅所说，乃一偏之言，岂至公之语！","book":"明·许仲琳《封神演义》第九十四回"}},{"id":144,"word":"一偏之论","pinyin":"yī piān zhī lùn","abbr":"ypzl","explanation":"偏于一面的议论。","source":{"text":"前日务为学而不观书，此固一偏之论。","book":"宋·朱熹《答沈叔晦书》"},"example":{"text":"陛下厉志复仇，足以对天命；笃于仁爱，足以结民心；而又仁明，足以照临群臣～：此百代之英主也。","book":"《宋史·儒林传六·陈亮》"},"usage":"作主语、宾语；用于书面语"},{"id":145,"word":"一傅众咻","pinyin":"yī fù zhòng xiū","abbr":"yfzx","explanation":"傅：教导；咻：喧闹。一个人教导，众人吵闹干扰。比喻不能有什么成就。","source":{"text":"一齐人傅之，众楚人咻之，虽日挞而求齐也，不可得矣。","book":"《孟子·滕文公下》"},"example":{"text":"古人有言，～，终归无效。","book":"蔡东藩、许廑父《民国通俗演义》第九十八回"},"usage":"作定语；指环境条件差","story":["战国时期宋国大臣戴不胜向孟子请教如何使宋国国君学好为国家多办一些好事。孟子打比方说如果让楚国大夫学齐国话就应该请齐国的老师，而且把他置身于齐国的环境中去，不能给他一个一傅众咻的环境，那样就是想学也学不好"]},{"id":146,"word":"一元复始","pinyin":"yī yuán fù shǐ","abbr":"yyfs","explanation":"指新的一年的开始。并常以下句“万象更新”合成春联。","source":{"text":"元者何？君之始年也。春者何？岁之始也。","book":"《公羊传·隐公元年》"},"example":{"text":"～，万象更新。"},"usage":"作分句；并常以下句“万象更新”合成春联"},{"id":147,"word":"一元大武","pinyin":"yī yuán dà wǔ","abbr":"yydw","explanation":"指古时祭祀用的牛。","source":{"text":"凡祭宗庙之礼，牛曰一元大武。","book":"西汉·戴圣《礼记·曲礼下》"},"example":{"text":"谨以～，柔毛刚鬎。","book":"唐·陆贽《告谢肃宗庙文》"},"usage":"作宾语；指祭祀用的牛"},{"id":148,"word":"一再则宥，三则不赦","pinyin":"yī zài zé yòu，sān zé bù shè","abbr":"yzzyszbs","explanation":"一再：第一、二次；宥：宽容。第一、第二次可以宽容，再三违犯就不能赦免了。","source":{"text":"一再则宥，三则不赦。","book":"《管子·立政》"}},{"id":149,"word":"一决胜负","pinyin":"yī jué shèng fù","abbr":"yjsf","explanation":"进行最后的较量以决定高下。","source":{"text":"介甫之意，必欲力战天下之人，与之一决胜负，不复顾义理之是非，生民之忧乐，国家之安危。","book":"宋·司马光《与王介甫书》"},"example":{"text":"明·无名氏《杨家将演义》第五卷：“当此～之际，退逊不去，诸将解体，陛下大事去矣。”"},"similar":["一决雌雄"],"usage":"作谓语、定语；指比高低"},{"id":150,"word":"一决雌雄","pinyin":"yī jué cí xióng","abbr":"yjcx","explanation":"雌雄：比喻胜负、高下。决一胜负，比个高下。","source":{"text":"愿与汉王挑战，决雌雄。","book":"《史记·项羽本纪》"},"example":{"text":"吾自历战数十场，不意今日狼狈至此！此天丧吾也！汝等各回本州，誓与曹贼～。","book":"明·罗贯中《三国演义》第三十一回"},"similar":["决一死战","背水一战","群雄角逐"],"opposite":["握手言欢","和平共处","和睦相处"],"usage":"作谓语、定语；指比高低"},{"id":151,"word":"一击即溃","pinyin":"yī jī jí kuì","abbr":"yjjk","explanation":"溃：溃败。刚一交战就立即溃败。指军队缺乏战斗力。","example":{"text":"陈长捷急派总预备队保安师增援，被解放军～，败下阵来。","book":"刘凤舞《民国春秋》第三十四章"}},{"id":152,"word":"一刀两断","pinyin":"yī dāo liǎng duàn","abbr":"ydld","explanation":"一刀斩为两段。比喻坚决断绝关系。","source":{"text":"观此可见克己者是从根源上一刀两断，便斩绝了，更不复萌。","book":"宋·释普济《五灯会元》卷十二：“一刀两段，未称宗师。”《朱子语类》卷四十四"},"example":{"text":"文先生真是快人，贱性也是～的。","book":"清·夏敬渠《野叟曝言》第十四回"},"similar":["当机立断"],"opposite":["藕断丝连","拖泥带水"],"usage":"作谓语、定语、宾语；比喻坚决断绝关系","story":["西汉初年，韩信被封为齐王之后，丞相萧何担心韩信兵权太大威胁刘家天下，就找樊哙共商计策。樊哙自鸣得意，连夸自己是如何斗败项羽而保主公刘邦的，面对这淮阴一饿夫且手无缚鸡之力的韩信，只须叫一两个人就可以把他一刀两断"]},{"id":153,"word":"一刀两段","pinyin":"yī dāo liǎng duàn","abbr":"ydld","explanation":"①一刀斩为两段。比喻坚决断绝关系。同“一刀两断”。②指斩首，被杀。","source":{"text":"只索便一刀两段，倒大来迭快。","book":"宋·释普济《五灯会元》卷十二：“一刀两段，未称宗师。”《朱子全书·论语十六》：“直是一刀两段，千了百当。”元·无名氏《争报恩》第二折"},"example":{"text":"因此上有～归了地府。","book":"元·无名氏《替杀妻》第二折"},"similar":["一刀两断"],"opposite":["粘皮带骨"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":154,"word":"一刀切","pinyin":"yī dāo qiē","abbr":"ydq","explanation":"比喻用划一的办法处理情况或性质不同的事物。","example":{"text":"要实行科学种田，因地制宜，不要搞～。"},"usage":"作宾语、定语；指不加区别对待"},{"id":155,"word":"一分一厘","pinyin":"yī fēn yī lí","abbr":"yfyl","explanation":"分、厘：金钱单位，1元＝10角，1角＝10分，1＝10厘。形容很少的数量。","source":{"text":"但是一切善良的愿望改变了他们的阶级本性的一分一厘一丝一毫没有呢？","book":"毛泽东《将革命进行到底》"},"similar":["一分一毫"],"usage":"作宾语、定语、状语；形容很少的数量"},{"id":156,"word":"一分一毫","pinyin":"yī fēn yī háo","abbr":"yfyh","explanation":"形容很少的数量。","source":{"text":"那里有一分一毫想着你自己。","book":"朱自清《给亡妇》"},"example":{"text":"我们不能拿群众的～。"},"similar":["一丝一毫"],"usage":"作宾语、定语、状语；形容很少的数量"},{"id":157,"word":"一分为二","pinyin":"yī fēn wéi èr","abbr":"yfwe","explanation":"哲学用语，指事物作为矛盾的统一体，都包含着相互矛盾对立的两个方面。通常指全面看待人或事物，看到积极方面，也看到消极方面。","source":{"text":"是故一分为二，二分为四。","book":"宋·邵雍《皇极经世绪言》第七卷"},"example":{"text":"我们看问题要～，客观公正。"},"similar":["不偏不倚"],"usage":"作谓语、定语、状语；指客观看待问题"},{"id":158,"word":"一分耕耘，一分收获","pinyin":"yī fēn gēng yún，yī fēn shōu huò","abbr":"yfgyyfsh","explanation":"付出一份劳力就得一分收益。","example":{"text":"～，你多做一些事，只有更多收益，绝不会吃亏的。"},"usage":"作宾语、定语、分句；用于书面语"},{"id":159,"word":"一切万物","pinyin":"yī qiē wàn wù","abbr":"yqww","explanation":"宇宙间所有的事物。","source":{"text":"设我得佛，自地上以至于虚空，宫殿楼观池流华树，国土所有一切万物，皆以无量杂宝百千种香而共合成，严饰奇妙，超诸人天。","book":"《无量寿经》卷上"},"example":{"text":"自家有这仁义礼智，便知得他也有仁义礼智。十人万人，～，无不是这道理。","book":"《朱子语类》卷一百一十六"},"usage":"作主语、宾语、定语；用于书面语"},{"id":160,"word":"一切之权","pinyin":"yī qiè zhī quán","abbr":"yqzq","explanation":"一切：一时；权：权宜。指一时的权宜之计。","source":{"text":"故其谋扶急持倾，为一切之权，虽不可以临教化，兵革救急之势也。","book":"《战国策·序》"},"example":{"text":"此铁路建造工程，以及管理～，全归中国国家。","book":"《清史稿·邦交志二》"}},{"id":161,"word":"一切众生","pinyin":"yī qiè zhòng shēng","abbr":"yqzs","explanation":"佛教指人类和一切生物。","source":{"text":"如佛所说，无足二足四足多足，有色无色有想无想非有想非无想等，一切众生中佛最第一。","book":"《大智度论》第27卷"},"example":{"text":"誓欲剿除天下妖邪鬼怪，救度～。","book":"元·无名氏《碧桃花》第三折"},"similar":["一切万物"],"usage":"作主语、宾语；指一切生物"},{"id":162,"word":"一切有情","pinyin":"yī qiè yǒu qíng","abbr":"yqyq","explanation":"佛教指一切众生。","source":{"text":"一切有情无所有，故甚深般若波罗蜜多亦无所有。","book":"《大般若经》卷五百七十八"},"example":{"text":"父母女间的相互的情爱都是天生的。不但人类如此，～莫不皆然。","book":"梁实秋《雅舍散文二集·父母的爱》"}},{"id":163,"word":"一则一，二则二","pinyin":"yī zé yī，èr zé èr","abbr":"yzyeze","explanation":"形容说话老老实实，毫不含糊。同“一是一，二是二”。","source":{"text":"则要你一则一，二则二。","book":"元·无名氏《抱妆盒》第三折"},"example":{"text":"赵氏当初合计家问官司时见过刑厅夹那伍圣道、邵强仁的利害，恐怕当真夹起来，就便～，说得真真切切的。","book":"清·西周生《醒世姻缘传》第二十回"},"usage":"作谓语、状语；用于书面语"},{"id":164,"word":"一则以喜，一则以惧","pinyin":"yī zé yǐ xǐ，yī zé yǐ jù","abbr":"yzyxyzyj","explanation":"一方面高兴，一方面又害怕。","source":{"text":"子曰：‘父母之年，不可不知也，一则以喜，一则以惧。’","book":"《论语·里仁》"},"example":{"text":"幸利爹妈年满八旬，孩儿～。","book":"明·高则诚《琵琶记·高堂称寿》"},"usage":"作分句；指喜忧参半"},{"id":165,"word":"一别如雨","pinyin":"yī bié rú yǔ","abbr":"ybry","explanation":"像雨落下以后不能再返回到云里一样。形容离别以后再难相见。","source":{"text":"风流云散，一别如雨。","book":"三国·魏·王粲《赠蔡子笃》"}},{"id":166,"word":"一刹那","pinyin":"yī chà nà","abbr":"ycn","explanation":"刹那：梵文ksana的音译。指十分短促的时间。","source":{"text":"未尝有一刹那倾断续之相。","book":"宋·释道原《景德传灯录·僧那禅师》"},"similar":["一念之间","一刹那间","转瞬之间"],"usage":"作宾语、定语；用于时间"},{"id":167,"word":"一刹那间","pinyin":"yī chà nà jiān","abbr":"ycnj","explanation":"刹那：梵文ksana的音译。指十分短促的时间。","source":{"text":"就是在他们临牺牲的一刹那间，他们想的不是自己，而是人民和祖国甚至全世界的将来。","book":"陶铸《松树的风格》"},"example":{"text":"田福堂在看见润叶和少安亮红晌午坐在河滩里的～，心里就什么都清楚了。","book":"路遥《平凡的世界》第一卷第21章"},"similar":["一刹那","转瞬之间"],"usage":"作宾语、定语；用于时间"},{"id":168,"word":"一刻千金","pinyin":"yī kè qiān jīn","abbr":"ykqj","explanation":"一刻时光，价值千金。形容时间非常宝贵。","source":{"text":"春宵一刻值千金，花有清香月有阴。","book":"宋·苏轼《春夜》诗"},"example":{"text":"他连鼻烟也不嗅了，看一看钟，六点还差十多分，他不能延误～的光阴。","book":"茅盾《子夜》十"},"similar":["分秒必争"],"opposite":["度日如年"],"usage":"作谓语、宾语、定语；指时间宝贵"},{"id":169,"word":"一剑之任","pinyin":"yī jiàn zhī rèn","abbr":"yjzr","explanation":"指以一人一剑之力。指作战的士兵，犹言一人之勇。亦指独力担任艰巨的任务。","source":{"text":"齐桓公有天下，朝诸侯，曹子以一剑之任，劫桓公于坛位之上。","book":"《尉缭子·武议》：“临难决疑，挥兵指刃，此将事也；一剑之任，非将事也。”《战国策·齐策六》"},"example":{"text":"秦贪我赂，而信我辞，则～，可当百万之师。","book":"《燕丹子》卷上"},"usage":"作宾语；用于书面语"},{"id":170,"word":"一副急泪","pinyin":"yī fù jí lèi","abbr":"yfjl","explanation":"指为了对付应急需要而骤然挤出来的一串眼泪。","source":{"text":"又令医术人羊志哭殷氏，志亦呜咽。他日有问志：‘卿那得此副急泪？’志时新丧爱姬，答曰：‘我尔日自哭亡妾耳。’","book":"《宋书·刘德愿传》"},"example":{"text":"天幸来得～，好见得自己爱贤之心。","book":"清·黄小配《大马扁》第七回"}},{"id":171,"word":"一力吹嘘","pinyin":"yī lì chuī xū","abbr":"ylcx","explanation":"一力：极力；吹嘘：为人说好话。尽全力替别人美言。","source":{"text":"我只道保奏的是当朝邓禹，却原来是马武一力吹嘘。","book":"元·秦简夫《赵礼让肥》第四折"}},{"id":172,"word":"一力当先","pinyin":"yī lì dāng xiān","abbr":"yldx","explanation":"一力：竭力。尽全力走在前面或做在别人前面。","source":{"text":"三藏恐他们闯祸，一力当先。","book":"明·吴承恩《西游记》第八十七回"}},{"id":173,"word":"一力承当","pinyin":"yī lì chéng dāng","abbr":"ylcd","explanation":"一力：独力。一个人独自负责。","source":{"text":"开棺之罪，我一力当之，不致相累。","book":"明·凌濛初《初刻拍案惊奇》卷九"},"example":{"text":"你再去说，如果他肯归降，但有山高水低，我～。（清·俞万春《荡寇志》第十七回）"},"similar":["一力承担"],"usage":"作谓语；指独自负责"},{"id":174,"word":"一力承担","pinyin":"yī lì chéng dān","abbr":"ylcd","explanation":"一力：独力。一个人独自负责。","source":{"text":"开棺之罪，我一力当之，不致相累。","book":"明·凌濛初《初刻拍案惊奇》卷九"},"example":{"text":"这时丐帮广撒英雄帖招集天下英雄，陆冠英夫妇～，将英雄宴设在陆家庄中。","book":"金庸《神雕侠侣》第十一回"}},{"id":175,"word":"一力担当","pinyin":"yī lì dān dāng","abbr":"yldd","explanation":"一力：尽全力。尽全力承担责任。","source":{"text":"到了北京，冯主事先去拜了通政司邹参议，将沈炼父子冤情说了，然后将沈襄讼冤本稿送与他看。邹应龙一力担当。","book":"明·冯梦龙《喻世明言》卷四十"},"example":{"text":"望元帅～，不可迟延，有负众人之心。","book":"明·许仲琳《封神演义》第九十八回"}},{"id":176,"word":"一力拒守","pinyin":"yī lì jù shǒu","abbr":"yljs","explanation":"一力：尽全力。竭力抵御敌人，固守阵地。","source":{"text":"昼夜攻打甚急，存审一力拒守。","book":"宋·无名氏《新编五代史平话·唐史平话》"}},{"id":177,"word":"一力撺掇","pinyin":"yī lì cuān duō","abbr":"ylcd","explanation":"一力：极力；撺掇：怂恿、劝诱别人做事。指竭力怂恿别人去做某件事情，或竭力促成某件事情。","source":{"text":"且说王婆一力撺掇那婆娘当夜伴灵。第二日，请四僧念些经文。第三日早，众火家自来扛抬棺材，也有几家邻舍街坊相送。","book":"明·施耐庵《水浒全传》第二十五回"},"example":{"text":"当日姐姐执意不肯应试，若非众人～，姐姐那肯同来？","book":"清·李汝珍《镜花缘》第五十九回"}},{"id":178,"word":"一力降十会","pinyin":"yī lì xiáng shí huì","abbr":"yljsh","explanation":"一力：力气大的一个人；降：制服；会：会家，懂武艺的人。一个力气大的人，可以战胜十个会武艺的人。","source":{"text":"韩爷技艺虽强，吃亏了力软；雷洪的本领不济，便宜力大，所谓‘一力降十会’。","book":"清·石玉昆《三侠五义》第五十回"},"example":{"text":"原就是想藉他的铁牌，来克凌未风的宝剑，想以“～”，使凌未风难于兼顾。","book":"梁羽生《七剑下天山》第十七回"}},{"id":179,"word":"一动不动","pinyin":"yī dòng bù dòng","abbr":"ydbd","explanation":"指静止不动或懒得活动。","source":{"text":"我继续一动不动地凝视他们，这对可怜的情人实在无法保持冷静，松开嘴，忿忿地起身走了。","book":"王朔《浮出海面》"},"opposite":["变幻莫测"],"usage":"作谓语、定语、状语；多用于人的状态"},{"id":180,"word":"一动不如一静","pinyin":"yī dòng bù rú yī jìng","abbr":"ydbryj","explanation":"没有把握或无益的事，还是不做为好。比喻多一事不如少一事。","source":{"text":"孝守幸天竺及灵隐，有僧辉相随。见飞来峰，问辉曰：‘既是飞来，如何不飞去？’对曰：‘一动不如一静。’","book":"宋·张端义《贵耳集》卷上"},"example":{"text":"～，我们这里就算好人家，别的都容易，最难得的是从小儿一处长大，脾气情性都彼此知道的了。","book":"清·曹雪芹《红楼梦》第五十七回"},"similar":["以静制动"],"usage":"作谓语、分句；指静观事态","story":["南宋时期，宋孝宗到西湖游玩看到飞来峰就问随他游玩的和尚僧端其由来，僧端把当年印度僧人验证飞来峰原本是西天灵鹫山的典故说了一遍。孝宗问为什么不再飞走呢？僧端非常巧妙地回答道：“谚语不是有‘一动不如一静’吗？”孝宗认为言之有理"]},{"id":181,"word":"一劳久逸","pinyin":"yī láo jiǔ yì","abbr":"yljy","explanation":"辛苦一次，把事情办好，以后就可以不再费力了。同“一劳永逸”。","source":{"text":"兹可谓一劳而久逸，暂费而永无宁者也。","book":"汉·班固《封燕然山铭》"},"example":{"text":"机会～，暂赏而永宁。","book":"宋·岳珂《桯史·大散论赏书》"},"similar":["一劳永逸"],"usage":"作谓语、定语、宾语；用于处事"},{"id":182,"word":"一劳永逸","pinyin":"yī láo yǒng yì","abbr":"ylyy","explanation":"逸：安逸。辛苦一次，把事情办好，以后就可以不再费力了。","source":{"text":"兹可谓一劳而久逸，暂费而永无宁者也。","book":"汉·班固《封燕然山铭》"},"example":{"text":"“～”的话，有是有的，而“～”的事却极少。","book":"鲁迅《花边文学·再论重译》"},"similar":["一了百了","一了百当"],"opposite":["劳而无功","徒劳无功","事倍功半"],"usage":"作谓语、宾语、定语；指一次解决问题"},{"id":183,"word":"一勇之夫","pinyin":"yī yǒng zhī fū","abbr":"yyzf","explanation":"指只凭勇气而不会使用计谋的人。","source":{"text":"我两个无过是一勇之夫，但有出力去处，自当效命，生死不辞。","book":"元·无名氏《连环计》第四折"},"example":{"text":"清·李百川《绿野仙踪》第69回：“刻下诸将中没有他的对手，究系～。”"},"usage":"作宾语；用于书面语"},{"id":184,"word":"一化齐俗","pinyin":"yī huā qí sú","abbr":"yhqs","explanation":"统一教化，整齐风俗。","source":{"text":"成王大悟，周公显复，一化齐俗，义以断恩。","book":"三国·魏·嵇康《管蔡论》"}},{"id":185,"word":"一匡九合","pinyin":"yī kuāng jiǔ hé","abbr":"ykjh","explanation":"春秋时管仲辅助齐桓公“一匡天下，九合诸侯”，建立霸业。后亦指立国大事。","source":{"text":"臣始仕从戎，爰承指顾，禀三令五申之戒，预一匡九合之谋。","book":"《旧唐书·郑畋传》"},"example":{"text":"管仲～，攘外安内，其功甚大。","book":"清·夏敬渠《野叟曝言》卷七十二"},"usage":"作宾语、定语；用于书面语"},{"id":186,"word":"一匡天下","pinyin":"yī kuāng tiān xià","abbr":"yktx","explanation":"匡：纠正；天下：原指周天子统治所及的地方，即整个中国。纠正混乱局势，使天下安定下来。","source":{"text":"管仲相桓公，霸诸侯，一匡天下，民到于今受其赐。微管仲，吾其被发左祍矣。","book":"《论语·宪问》"},"example":{"text":"先生自比管、乐——管仲相桓公，霸诸侯，～。","book":"明·罗贯中《三国演义》第四十三回"},"usage":"作谓语、定语；指统一天下","story":["春秋时期，齐桓公不计前嫌，任用有一箭之仇的管仲为宰相，齐国越来越强大。管仲辅佐他成为春秋霸主地位。孔子与弟子子路、子贡分析管仲这个人，子路与子贡都认为管仲没有仁德，孔子耐心地开导他们：管仲辅佐齐桓公一匡天下，使百姓受益"]},{"id":187,"word":"一十八层地狱","pinyin":"yī shí bā céng dì yù","abbr":"ysbcdy","explanation":"佛教指极恶众生死后赴受苦之所，包括刀山、火汤、寒冰等十八种。比喻灾难极其深重的境地。也比喻最低的等级。","source":{"text":"判官道:‘此是阴山背后一十八层地狱。’","book":"明·吴承恩《西游记》第十一回"},"example":{"text":"皇帝的尊严真的要“升到三十三天堂，为玉皇大帝盖瓦”，臣民的自卑，也真的要“死到～，替阎王老爷挖煤。","book":"柏杨《暗夜慧灯·没有伦理观念》"},"similar":["十八层地狱"],"usage":"作宾语、定语；指最坏的处境"},{"id":188,"word":"一十八般兵器","pinyin":"yī shí bā bān bīng qì","abbr":"ysbbbq","explanation":"泛指各种兵器。","source":{"text":"你放下一十八般兵器，你抡不动那鞭、简、挝、锤。","book":"元·关汉卿《哭存孝》第一折"},"similar":["十八般兵器"],"usage":"作主语、宾语；指兵器"},{"id":189,"word":"一十八般武艺","pinyin":"yī shí bā bān wǔ yì","abbr":"ysbbwy","explanation":"泛指各种武术技艺。","source":{"text":"臣左右开弓，一十八般武艺，无有不会。","book":"元·白朴《梧桐雨》楔子"},"example":{"text":"清·无名氏《说呼全传》第11回：“恰遇了一个救星，姓梁名玉，山西人氏，善用～，大郎和妻妹一同拜他为师。”"},"similar":["十八般武艺"],"usage":"作主语、宾语；指各种技能"},{"id":190,"word":"一卒之令","pinyin":"yī zú zhī lìng","abbr":"yzzl","explanation":"卒：死。只有一条死罪的法令。","source":{"text":"高皇帝时，天下初定，发德音，行一卒之令，权也。","book":"汉·桓宽《盐铁论·诏圣》"}},{"id":191,"word":"一卒之田","pinyin":"yī zú zhī tián","abbr":"yzzt","explanation":"百顷田地。","source":{"text":"无一卒之田。","book":"春秋·鲁·左丘明《国语·晋语》"},"usage":"作宾语；指百顷田地"},{"id":192,"word":"一卧不起","pinyin":"yī wò bù qǐ","abbr":"ywbq","explanation":"指一生病就没有好转。","source":{"text":"自从倩女孩儿在折柳亭与王秀才送路，辞别回家，得其疾病，一卧不起。","book":"元·郑光祖《倩女离魂》第二折"},"example":{"text":"他回来后就～，不久命赴黄泉了。"},"similar":["一病不起"],"usage":"作谓语、定语；指生病"},{"id":193,"word":"一厘一毫","pinyin":"yī lí yī háo","abbr":"ylyh","explanation":"形容极少的数量。","source":{"text":"常山、开化系灾伤极重去处，而常山所放仅及一分六厘有奇；而开化又止一厘一毫而已。","book":"宋·朱熹《奏巡历婺衢救荒事件状》"},"usage":"作宾语、定语；用于书面语"},{"id":194,"word":"一厢情原","pinyin":"yī xiāng qíng yuán","abbr":"yxqy","explanation":"指单方面的愿望或不考虑客观实际情况的主观意愿。同“一相情原”。"},{"id":195,"word":"一厢情愿","pinyin":"yī xiāng qíng yuàn","abbr":"yxqy","explanation":"指单方面的愿望或不考虑客观实际情况的主观意愿。同“一相情愿”。","source":{"text":"晏殊以为柳胜韩，李淑又谓刘胜柳，所谓‘一厢情愿’。","book":"金·王若虚《滹南遗老集》"},"example":{"text":"有人说：‘你这是～，石敢同意去吗？’","book":"蒋子龙《乔厂长上任记》"},"similar":["一相情愿","一意孤行"],"opposite":["两相情愿"],"usage":"作定语、状语；指单方面的事情","story":["古印度农家青年去京城玩，见到美貌非凡的公主，就一厢情愿地想入非非，回家之后就得了相思病，日益消瘦下去，亲友们知道后就假装派人去京城跟国王提亲，他信以为真，病倒慢慢好了起来。过几天亲友回来说公主不肯答应，他表示再去见公主一面"]},{"id":196,"word":"一去不复返","pinyin":"yī qù bù fù fǎn","abbr":"yqbff","explanation":"一去就不再回来了。","source":{"text":"风萧萧兮易水寒，壮士一去兮不复还。","book":"《史记·刺客列传》"},"example":{"text":"黄鹤～，白云千载空悠悠。","book":"唐·崔颢《黄鹤楼》诗"},"similar":["人去楼空","一去不返"],"opposite":["反复无常"],"usage":"作谓语；形容事物已成过去","story":["公元前227年，秦国打败赵国，迫近燕国。燕国太子丹请勇士荆轲去刺杀秦王。荆轲带上秦王的仇人樊于期的人头及督亢地地图。太子丹把他送到易水河边，高渐离为荆轲奏乐，荆轲高唱：“风萧萧兮易水寒，壮士一去兮不复还。”"]},{"id":197,"word":"一去不复还","pinyin":"yī qù bù fù huán","abbr":"yqbfh","explanation":"复：再；还：回来。一去就不再回来了。比喻事情已成为过去，再不能重现。","source":{"text":"风萧萧兮易水寒，壮士一去兮不复还。","book":"《史记·刺客列传》"},"example":{"text":"叹衰草，络纬声切切。良人～，今夕坐愁鬓如雪。","book":"唐·张生妻《梦中歌》"}},{"id":198,"word":"一去不返","pinyin":"yī qù bù fǎn","abbr":"yqbf","explanation":"返：回来。一去就不再回来了。比喻事情已成为过去，再不能重现。","source":{"text":"风萧萧兮易水寒，壮士一去兮不复还。","book":"《史记·刺客列传》"},"example":{"text":"不想过了几天，金寓做了黄鹤，～。","book":"清·无名氏《官场维新记》第四回"},"similar":["一去不复返"],"usage":"作谓语、定语；形容事物已成过去"},{"id":199,"word":"一去不还","pinyin":"yī qù bù huán","abbr":"yqbh","explanation":"还：回来。一去就不再回来了。比喻事情已成为过去，再不能重现。","source":{"text":"风萧萧兮易水寒，壮士一去兮不复还。","book":"《史记·刺客列传》"},"example":{"text":"西流之水东流河，～奈子何。","book":"《晋书·刘曜载记》"}},{"id":200,"word":"一双两好","pinyin":"yī shuāng liǎng hǎo","abbr":"yslh","explanation":"比喻夫妇十分般配。","source":{"text":"一床两好世间无，好女如何得好夫？高卷珠帘明点烛，试教菩萨看麻胡。","book":"宋·曾糙《高斋漫录》记载：夫成郎中相貌丑陋，岳母很厌恶他。新婚之夜，成写了一首诗"},"example":{"text":"今日有缘，遇见这位姐姐，少不得要寻个才貌兼全的少年公子，替他撮合，做个～的夫妻。","book":"清·夏敬渠《野叟曝言》第二十七回"},"similar":["才子佳人","一床两好"],"usage":"作宾语、定语；比喻夫妇美好相称"},{"id":201,"word":"一双两美","pinyin":"yī shuāng liǎng měi","abbr":"yslm","explanation":"比喻夫妇十分般配。","source":{"text":"真奇异一双两美，排宴饮双双效于飞。","book":"元·萧德祥《小孙屠》第八出"},"example":{"text":"话说徐君宝与金淑贞两个成亲捉对，好生一双两美，日日的吟诗作赋，你唱我和。","book":"明·周楫《西湖二集·徐君宝节义双圆》"}},{"id":202,"word":"一反其道","pinyin":"yī fǎn qí dào","abbr":"yfqd","explanation":"一：整个，完全；反：相反；其：他的；道：轨道。完全与以前的轨道相反。","example":{"text":"他总是喜欢一反其道而行之。"},"similar":["一改故辙","一反常态","改弦易辙"],"opposite":["一如既往","一成不变","因循守旧"],"usage":"作谓语、定语、状语；指完全改变"},{"id":203,"word":"一反常态","pinyin":"yī fǎn cháng tài","abbr":"yfct","explanation":"完全改变了平时的态度。","source":{"text":"可是而今，他却一反常态，神采飞扬地高谈阔论起来。","book":"郭澄清《大刀记》第十六章"},"example":{"text":"他平时总是有说有笑，今天却～，默不作声。"},"similar":["一改故辙","急转直下","改弦易辙"],"opposite":["一如既往","一成不变","持之以恒"],"usage":"作谓语、状语；指完全改变了平时的态度"},{"id":204,"word":"一反既往","pinyin":"yī fǎn jì wǎng","abbr":"yfjw","explanation":"一：完全；既往：从前。完全与以前相反。","example":{"text":"从今以后，他要一反既往。"},"similar":["一反其道","一反常态","改弦易辙"],"opposite":["一如既往","一成不变","持之以恒"],"usage":"作谓语、宾语、定语；同“一反常态”"},{"id":205,"word":"一发不可收拾","pinyin":"yī fā ér bù shōu shí","abbr":"yfbkss","explanation":"事情一旦发生便不可收拾。形容对发生的情况难以控制。","source":{"text":"他们在文七爷船上做的事，及文七爷醉后之言，又全被统领听在耳朵里，所以又是气，又是醋，并在一处，一发而不可收拾。","book":"清·李宝嘉《官场现形记》第十二回"},"example":{"text":"此人纵情率性，多半会～，身受剧烈内伤，他日华山二次论剑，倒又少了一个大敌。","book":"金庸《射雕英雄传》第二十二回"}},{"id":206,"word":"一发千钧","pinyin":"yī fà qiān jūn","abbr":"yfqj","explanation":"发：头发；钧：古代的重量单位，合三十斤。危险得好像千钧重量吊在一根头发上。比喻情况万分危急。","source":{"text":"其危如一发引千钧。","book":"《汉书·枚乘传》：“夫以一缕之任，系千钧之重，上悬无极之高，下垂不测之渊，虽甚愚之人，犹知哀其将绝也。”唐·韩愈《与孟尚书书》"},"example":{"text":"际兹～，全国国民宜各立所志，各尽所能，各抒己见。","book":"鲁迅《二心集·沉滓的泛起》"},"similar":["危如累卵","危在旦夕","燃眉之急"],"opposite":["稳如泰山"],"usage":"作谓语、定语；比喻情况万分危急","story":["西汉时期著名文学家枚乘，他擅长辞赋，他在吴王刘濞手下作郎中，刘濞想反叛朝廷，枚乘劝阻他说：“用一缕头发系上千钧重的东西，上面悬在没有尽头的高处，下边是无底的深渊，这种情景就是再愚蠢的人都知道是极其危险的。”"]},{"id":207,"word":"一发双贯","pinyin":"yī fā shuāng guàn","abbr":"yfsg","explanation":"原指射箭技术高超，一箭射中两只雕。后比喻做一件事达到两个目的。","source":{"text":"尝有二雕飞而争肉，因以箭两只与晟，请射取之。晟驰往，遇雕相攫，遂一发双贯焉。","book":"《北史·长孙晟传》"}},{"id":208,"word":"一发破的","pinyin":"yī fā pò dì","abbr":"yfpd","explanation":"发：射出；的：箭靶的中心。一箭就射中箭靶中心。比喻一下子就击中目标或一句话就击中要害。","source":{"text":"恺亦自恃其能，令济先射，一发破的。","book":"《晋书·王济传》"},"similar":["一语道破"],"usage":"作谓语、定语；指一句话就击中要害","story":["东晋时期，豪门贵族王恺和王济经常在一块打赌比赛，王恺有一头快牛叫“八百里蛟”，他们射箭比赛拿它作为赌注。王济一箭射中目标并赢得此牛，又将此牛杀死，取牛心而食，让王恺十分沮丧，自叹倒霉"]},{"id":209,"word":"一发而不可收","pinyin":"yī fā ér bù kě shōu","abbr":"yfebks","explanation":"事情一经发生便不能收住","source":{"text":"乱败之及，一发而不可收也。","book":"清·王夫之《读通鉴论·隋文帝》"},"example":{"text":"鲁迅《呐喊·自序》：“从此以后，便～，每写些小说模样的文章，以敷衍朋友们的嘱托，积久就有了十余篇。”"},"similar":["一发而不可收拾"],"usage":"作谓语、定语；用于事情等"},{"id":210,"word":"一发而不可收拾","pinyin":"yī fā ér bù kě shōu shí","abbr":"yfebkss","explanation":"事情一旦发生便不可收拾。形容对发生的情况难以控制。","source":{"text":"他们在文七爷船上做的事，及文七爷醉后之言，又全被统领听在耳朵里，所以又是气，又是醋，并在一处，一发而不可收拾。","book":"清·李宝嘉《官场现形记》第十二回"},"example":{"text":"他心中恶念越积越重，终有一日堤防溃决，～，只有盼他善念滋长，恶念渐消，方能入于证道之境。","book":"金庸《神雕侠侣》第三十回"},"similar":["一发而不可收"],"usage":"作谓语、定语；用于事情等"},{"id":211,"word":"一叠连声","pinyin":"yī dié lián shēng","abbr":"ydls","explanation":"一声紧接着一声。","source":{"text":"左右一迭连声道：‘带妇人，带妇人！’那妇人却动也不动。","book":"清·石玉昆《三侠五义》第二十六回"},"example":{"text":"便～，叫快拿笔砚来写请客票头，一面又叫先摆台面。","book":"清·张春帆《九尾龟》第三十六回"}},{"id":212,"word":"一口一声","pinyin":"yī kǒu yī shēng","abbr":"ykys","explanation":"犹口口声声。","source":{"text":"西门庆那里肯，一口一声只叫‘姑娘请受礼。’","book":"《金瓶梅词话》第七回"},"example":{"text":"每到一处先替他向人报告，说这位就是唐观察；有些扯顺风旗的，亦就～的观察。","book":"清·李宝嘉《官场现形记》第三十五回"},"similar":["口口声声"],"usage":"作定语、状语；用于书面语"},{"id":213,"word":"一口三舌","pinyin":"yī kǒu sān shé","abbr":"ykss","explanation":"比喻唠叨、话多。","source":{"text":"一口三舌，相妨无益。","book":"汉·焦延寿《易林》卷十"},"similar":["唠唠叨叨"],"usage":"作谓语、定语；指话多"},{"id":214,"word":"一口不能著两匙","pinyin":"yī kǒu bù néng zhuó liǎng chí","abbr":"ykbnzls","explanation":"匙：汤匙。一张嘴同时要吃两把汤匙里的食物。比喻贪多","source":{"text":"一口不能著两匙。","book":"宋·范成大《丙午新正书怀》诗：“口不两匙休足榖，身能几屐莫言钱。”自注：吴谚云"},"similar":["一口两匙"],"usage":"作宾语、定语；指贪多"},{"id":215,"word":"一口两匙","pinyin":"yī kǒu liǎng chí","abbr":"yklc","explanation":"比喻贪多。","source":{"text":"口不两匙休足谷，身能几屐莫言钱。","book":"宋·范成大《丙午新正书怀》诗"},"similar":["一口不能著两匙"],"usage":"作宾语、定语；指贪多"},{"id":216,"word":"一口吃个胖子","pinyin":"yī kǒu chī gè pàng zi","abbr":"ykcgpz","explanation":"吃一口饭长成一个胖子。比喻急于求成。","source":{"text":"可是人家说的：胖子也不是一口儿吃的。","book":"清·曹雪芹《红楼梦》第八十四回"},"example":{"text":"学习要脚踏实地，一步一个脚印，不要期望～。"}},{"id":217,"word":"一口同声","pinyin":"yī kǒu tóng shēng","abbr":"ykts","explanation":"犹一口同音。","source":{"text":"因天时尚早，复到街上访问本府政绩，竟是一口同声说好。","book":"清·刘鹗《老残游记》第六回"},"similar":["一口同音","异口同声"],"opposite":["人多口杂","众说纷纭"],"usage":"作谓语、定语；用于说话等"},{"id":218,"word":"一口同音","pinyin":"yī kǒu tóng yīn","abbr":"ykty","explanation":"犹言众口一词。","source":{"text":"所以听得周三说了一句，大家就一口同音说，以义气为重。","book":"清·文康《儿女英雄传》第二十一回"},"example":{"text":"这时又围上许多战士，～说：‘谁说不是？我们永远忘不了你。’","book":"杨朔《锦绣山河》上篇七"},"similar":["一口同声","异口同声"],"opposite":["人多口杂","众说纷纭"],"usage":"作谓语、定语、状语；用于说话等"},{"id":219,"word":"一口吸尽西江水","pinyin":"yī kǒu xī jìn xī jiāng shuǐ","abbr":"ykxjxjs","explanation":"原是一气呵成、贯通万法的意思。后比喻过于性急，想一下子就达到目的。","source":{"text":"待汝一口吸尽西江水，即向汝道。","book":"宋·释道原《景德传灯录》"},"similar":["一气呵成"],"usage":"作谓语、宾语、定语；指人操之过急"},{"id":220,"word":"一口咬定","pinyin":"yī kǒu yǎo dìng","abbr":"ykyd","explanation":"一口咬住不放。比喻坚持一个廉洁，再不改口。","source":{"text":"先把住持僧慧修，严行审讯，问他将李国斌藏在何处，慧修一口咬定不认得李国斌。","book":"清·无名氏《官场维新记》第十回"},"example":{"text":"老山东摇摇头，～：“不用看，我心里有数！我家的秤老辈用的，十四两顶新秤一斤，错不了。”","book":"冯德英《迎春花》第十一章"},"opposite":["不置可否"],"usage":"作谓语、状语；指肯定","story":["王夫人因发现男女性爱图腾手袋后，对大观园内所有丫鬟进行搜查，赶走了迎春的丫鬟司棋，觉得还不解恨，因宝玉已经成熟，就把漂亮丫鬟晴雯赶出大观园。宝玉偷偷摸摸去晴雯家探望她，晴雯觉得很委屈，只因为长得漂亮就被一口咬定为狐狸精"]},{"id":221,"word":"一口所敌","pinyin":"yī kǒu suǒ dí","abbr":"yksd","explanation":"一口：一席话。一席话就阻止了敌方的进攻。","source":{"text":"四海齐锋，一口所敌，张仪、张禄亦足云也。","book":"晋·左思《魏都赋》"}},{"id":222,"word":"一口道破","pinyin":"yī kǒu dào pò","abbr":"ykdp","explanation":"道：说；破：揭穿。一句话就说穿了。","source":{"text":"一言明说破，起初下手，先炼三三。","book":"元·李道纯《满庭芳·寂寞山居》词"},"example":{"text":"问来问去，不等他说，我便～。","book":"清·文康《儿女英雄传》第十六回"}},{"id":223,"word":"一口颂歌","pinyin":"yī kǒu sòng gē","abbr":"yksg","explanation":"一口：异口同声。众口一词，同唱颂歌。","source":{"text":"陛下向平东都，曾观广殿，皆撤毁之，天下翕然，一口颂歌。","book":"《新唐书·张玄素传》"}},{"id":224,"word":"一古脑儿","pinyin":"yī gǔ nǎo er","abbr":"ygne","explanation":"全部，通通。也形容不顾一切地做某件事。","source":{"text":"心中不知道是盐是醋是糖是姜，一古脑儿都倒翻了。","book":"清·曾朴《孽海花》第十六回"},"example":{"text":"把别人家典的东西，拣贵重些的金玉珠宝，～都暗暗的搬回家去。","book":"清·张春帆《九尾龟》第一百八十九回"}},{"id":225,"word":"一句撞倒墙","pinyin":"yī jù zhuàng dǎo qiáng","abbr":"yjzdq","explanation":"一句话可以把墙壁撞倒。比喻言语生硬、莽撞。","source":{"text":"立朝刚劲，须推老兄，然一语撞倒墙，亦是老兄。","book":"宋·胡程《苍梧集》"}},{"id":226,"word":"一台二妙","pinyin":"yī tái èr miào","abbr":"ytem","explanation":"台：古代官署名。同一官署中有名气的两个人。","source":{"text":"瓘学问渊博、明习文艺，与尚书郎敦煌索靖俱善草书，时人号为‘一台二妙’。","book":"《晋书·卫瓘传》"},"usage":"作宾语、定语；指有名的同僚","story":["晋代河东安邑人卫瓘知书达理，学识渊博。他曾经随大将邓艾、钟会率军攻打蜀国，深受晋武帝司马炎的器重，被封为尚书令。他才艺出众，与同署的尚书郎索靖都擅长草书，被当时人们称为“一台二妙”"]},{"id":227,"word":"一叶两豆","pinyin":"yī yè liǎng dòu","abbr":"yyld","explanation":"比喻为局部现象所迷惑，看不到全局或整体。","source":{"text":"一叶蔽目，不见太山；两豆塞耳，不闻雷霆。","book":"《鹖冠子·天则》"},"example":{"text":"元洪老矣，～，或蔽聪明，深渊薄冰，常怀惕惧，耳提面命，深所欢迎。","book":"《黎元洪痛斥军阀干政电》"}},{"id":228,"word":"一叶扁舟","pinyin":"yī yè piān zhōu","abbr":"yypz","explanation":"扁舟：小船。象一片小树叶那样的小船。形容船小而轻。","source":{"text":"驾一叶之扁舟，举匏樽以相属。","book":"唐·黄光溥《题黄居寀秋山图》：“暮烟幂幂锁村坞，一叶扁舟横野渡。”宋·苏轼《前赤壁赋》"},"example":{"text":"～，浮家来向江边住。这回归去，作个渔樵侣。","book":"宋·吕胜己《点绛唇》词"},"usage":"作宾语、定语；用于书面语"},{"id":229,"word":"一叶报秋","pinyin":"yī yè bào qiū","abbr":"yybq","explanation":"比喻通过个别的细微的迹象，可以看到整个形势的发展趋向与结果。同“一叶知秋”。","source":{"text":"一叶随风忽报秋，纵使君来岂堪折。","book":"唐·鲍溶《始见二毛》诗：“百川赴海返潮易，一叶报秋归树难。”唐·柳氏《杨柳枝》词"},"similar":["一叶知秋"],"usage":"作主语、宾语、定语；指秋天来临"},{"id":230,"word":"一叶知秋","pinyin":"yī yè zhī qiū","abbr":"yyzq","explanation":"从一片树叶的凋落，知道秋天的到来。比喻通过个别的细微的迹象，可以看到整个形势的发展趋向与结果。","source":{"text":"山僧不解数甲子，一叶落知天下秋。","book":"《淮南子·说山训》：“见一叶落而知岁之将暮。”宋·唐庚《文录》引唐人诗"},"example":{"text":"～，虽古有此说，然安能应声飞落？（清·俞樾《茶香室丛钞·梧叶报秋》）"},"similar":["见微知著","落叶知秋"],"usage":"作定语；指从局部推知未来"},{"id":231,"word":"一叶落知天下秋","pinyin":"yī yè luò zhī tiān xià qiū","abbr":"yylztxq","explanation":"从一片树叶的凋落，知道秋天的到来。比喻通过个别的细微的迹象，可以看到整个形势的发展趋向与结果。","source":{"text":"山僧不解数甲子，一叶落知天下秋。","book":"《淮南子·说山训》：“见一叶落而知岁之将暮。”宋·唐庚《文录》引唐人诗"},"similar":["一叶知秋"],"usage":"作宾语、定语；指从局部推知未来"},{"id":232,"word":"一叶蔽目，不见泰山","pinyin":"yī yè bì mù，bù jiàn tài shān","abbr":"yybmbjts","explanation":"蔽：遮。一片树叶挡住了眼睛，连面前高大的泰山都看不见。比喻为局部现象所迷惑，看不到全局或整体。","source":{"text":"一叶蔽目，不见太山；两豆塞耳，不闻雷霆。","book":"《鹖冠子·天则》"},"example":{"text":"可是由于多年积习，内地汉人总是将满洲部落看成辽东夷狄之邦，非腹心之患。正所谓～。","book":"姚雪垠《李自成》第五卷第四章"},"similar":["一叶障目，不见泰山"],"usage":"作宾语、定语；指头脑简单"},{"id":233,"word":"一叶迷山","pinyin":"yī yè mí shān","abbr":"yyms","explanation":"意指一叶蔽目，不见泰山。","source":{"text":"世上这般双瞳如豆、一叶迷山的，以至糊涂下人，又有几个深明大义的呢！","book":"清·文康《儿女英雄传》第二十五回"},"similar":["一叶蔽目，不见泰山"],"usage":"作宾语、定语；指头脑简单"},{"id":234,"word":"一叶障目","pinyin":"yī yè zhàng mù","abbr":"yyzm","explanation":"眼睛被一片树叶挡住，指看不到事物的全貌。","source":{"text":"一叶障目，不见泰山，而自以为是。","book":"毛泽东《论持久战》"},"example":{"text":"我们不能～看不见森林。"},"similar":["一叶障目，不见泰山"],"usage":"作宾语、定语；用于劝诫人","story":["有个书呆子从古书上读到“蝉翳叶”的故事，信以为真，就四处寻找，把蝉躲藏处的树叶全部摘下，拿回家遮脸作试验，问妻子能不能看见他。妻子气愤说看不见。他就拿这片树叶去街上行窃，被抓后说：“我一叶障目，你们能看见吗？”"]},{"id":235,"word":"一叶障目，不见泰山","pinyin":"yī yè zhàng mù，bù jiàn tài shān","abbr":"yyzmbjts","explanation":"蔽：遮。一片树叶挡住了眼睛，连面前高大的泰山都看不见。比喻为局部现象所迷惑，看不到全局或整体。","source":{"text":"一叶蔽目，不见太山；两豆塞耳，不闻雷霆。","book":"《鹖冠子·天则》"},"example":{"text":"你们不能～，仅仅因为一些小的失误就全盘否定我们所取得的成就。"},"similar":["一叶障目，不见森林"],"usage":"作宾语、定语；指头脑简单"},{"id":236,"word":"一吐为快","pinyin":"yī tǔ wéi kuài","abbr":"ytwk","explanation":"指尽情说出要说的话而感到畅快。","source":{"text":"仿佛全是他积郁在胸中多时的由衷之言，今日终于得以一吐为快。","book":"谌容《真真假假》"},"example":{"text":"我说出这个秘密后，真是～。"},"similar":["不吐不快"],"usage":"作谓语、宾语、定语；指尽情倾吐"},{"id":237,"word":"一吟一咏","pinyin":"yī yīn yī yǒng","abbr":"yyyy","explanation":"指吟诗作赋。","source":{"text":"高情远致，弟子早已伏膺；然一吟一咏，许将北面矣。","book":"《晋书·孙绰传》"},"usage":"作主语、宾语、定语；指文人生活","story":["晋朝时期，在文学方面很有名气的孙绰、许询一同去寺庙游玩，和尚支遁热情接待他们，并同他们谈起了文学，他问孙绰与许询谁更胜一筹。孙绰回答道：“高情远致，弟子早已伏膺；然一吟一咏，许将北面矣。”三人开怀大笑"]},{"id":238,"word":"一吠百声","pinyin":"yī fèi bǎi shēng","abbr":"yfbs","explanation":"即一犬吠形，百犬吠声。","source":{"text":"群猜共怒，一吠百声，持辩风起，发言雷同矣。","book":"明·何景明《上杨邃庵书》"},"usage":"作宾语、定语；用于书面语"},{"id":239,"word":"一吹一唱","pinyin":"yī chuī yī chàng","abbr":"ycyc","explanation":"吹：吹嘘。唱：唱和。两个人说话，互相帮衬。","source":{"text":"二人一吹一唱，说得颜氏心中哑口无言，心下也生疑惑，委决不下，把一天欢喜，又变为万般愁闷。","book":"明·冯梦龙《醒世恒言》第三十五卷"},"similar":["你吹我捧"],"usage":"作谓语、定语、宾语；用于处事"},{"id":240,"word":"一呵而就","pinyin":"yī hē ér jiù","abbr":"yhej","explanation":"一口气完成。","source":{"text":"感兴不来，也不能勉强去酝酿。当它来的时候，酝酿成熟，故能提起锐笔，一呵而就。","book":"郭绍虞《中国文学批评史》十四"},"similar":["一气呵成"],"usage":"作谓语、状语；用于书面语"},{"id":241,"word":"一呼三颠","pinyin":"yī hū sān diān","abbr":"yhsd","explanation":"比喻动摇、不稳定。","source":{"text":"鸟鸣既端，一呼三颠。动摇东西，危栗不安，疾病无患。","book":"汉·焦延寿《易林·需之节》"}},{"id":242,"word":"一呼再喏","pinyin":"yī hū zài nuò","abbr":"yhzn","explanation":"听到一声呼唤即连声应答。表示恭顺。","source":{"text":"据法守职而不敢为非者，人吏也；当前决意，一呼再喏者，人隶也。","book":"《韩诗外传》卷五"}},{"id":243,"word":"一呼即集","pinyin":"yī hū jí jí","abbr":"yhjj","explanation":"呼：呼唤；集：聚集。呼唤一声，人们就聚集到一起。","source":{"text":"盖五代以前，兵寓于农，素习战斗，一呼即集。","book":"宋·罗大经《鹤林玉露·甲编·民兵》"},"example":{"text":"恰好安排，～，非“河下佣”而何？","book":"清·王夫之《姜斋诗话》卷下"}},{"id":244,"word":"一呼百和","pinyin":"yī hū bǎi hè","abbr":"yhbh","explanation":"一人呼唤，百人响应。形容响应的人很多。","source":{"text":"当前快意，一呼再诺者，人隶也。","book":"汉·韩婴《韩诗外传》卷五"}},{"id":245,"word":"一呼百应","pinyin":"yī hū bǎi yìng","abbr":"yhby","explanation":"一个人呼喊，马上有很多人响应。","source":{"text":"当前快意，一呼再诺者，人隶也。","book":"汉·韩婴《韩诗外传》第五卷"},"example":{"text":"农会会员漫山遍野，梭镖短棍～，土匪无处藏踪。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["一呼百诺","应者云集","响应风从"],"opposite":["孤立无援","孤家寡人","孤掌难鸣"],"usage":"作谓语、定语；指响应的人多"},{"id":246,"word":"一呼百诺","pinyin":"yī hū bǎi nuò","abbr":"yhbn","explanation":"一人呼唤，百人应答。形容有钱有势，仆从很多。","source":{"text":"当前快意，一呼再诺者，人隶也。","book":"汉·韩婴《韩诗外传》第五卷"},"example":{"text":"罗公独坐当中，～，掌着生杀之权。","book":"清·孔尚任《桃花扇·哭主》第十三回"},"similar":["一呼百应"],"opposite":["孤立无援","孤掌难鸣"],"usage":"作谓语、定语；同“一呼百应”"},{"id":247,"word":"一呼而集","pinyin":"yī hū ér jí","abbr":"yhej","explanation":"呼：呼唤；集：聚集。呼唤一声，人们就聚集到一起。","source":{"text":"盖五代以前，兵寓于农，素习战斗，一呼即集。","book":"宋·罗大经《鹤林玉露·甲编·民兵》"},"example":{"text":"只有冶坊中大半是无赖之徒，～，约有三百余人。","book":"明·冯梦龙《喻世明言》卷三十九"}},{"id":248,"word":"一命之荣","pinyin":"yī mìng zhī róng","abbr":"ymzr","explanation":"指受任一官的荣耀。","source":{"text":"后人不叨一命之荣。滁阳之祭，亦仅有司岁终一举而已。","book":"明·沈德符《野获编·礼部二·滁阳王奉祀官》"},"example":{"text":"这等看来，功名一道，岂惟科甲，便是～，苟非福德兼全，也就难望立得事业起！","book":"清·文康《儿女英雄传》第三十五回"},"usage":"作宾语；用于书面语"},{"id":249,"word":"一命呜呼","pinyin":"yī mìng wū hū","abbr":"ymwh","explanation":"呜呼：叹词，古代祭文末多有此词，后即以此为死亡的代称。指人死亡。","source":{"text":"谁想乐极生悲，过了六年，刘后所生之子，竟至得病，一命呜呼。","book":"清·石玉昆《三侠五义》第一回"},"example":{"text":"杀两个叫花子开张！这两个叫花子就是这样～了。 ★毛泽东《湖南农民运动考察报告》","book":"汤峻岩"},"similar":["与世长辞","命赴黄泉","葬玉埋香"],"opposite":["长命百岁"],"usage":"作谓语；指人死亡"},{"id":250,"word":"一命归西","pinyin":"yī mìng guī xī","abbr":"ymgx","explanation":"指死亡。","source":{"text":"不留神？好，噗哧一下儿，我不就一命归西了吗！","book":"老舍《四世同堂》"},"example":{"text":"他回到家里就～了。"},"similar":["一命呜呼"],"opposite":["长命百岁"],"usage":"作谓语；指死亡"},{"id":251,"word":"一命归阴","pinyin":"yī mìng guī yīn","abbr":"ymgy","explanation":"指死亡。","source":{"text":"兰生一铜人横扫过去，打着穆春腰肋，一命归阴。","book":"清·俞万春《荡寇志》第99回"},"similar":["一命呜呼","一命归西"],"opposite":["长命百岁"],"usage":"作谓语；指死亡"},{"id":252,"word":"一命鸣呼","pinyin":"yī mìng míng hū","abbr":"ymmh","explanation":"指死亡。常含幽默诙谐意味。","source":{"text":"又过半年，忽然刘二感天行时气，头疼发热。正是：‘福无双至从来有，祸不单行自古闻。’害了六七日，一命呜呼，已归泉下。","book":"明·洪楩《清平山堂话本·合同文字记》"},"example":{"text":"谁想乐极生悲，过了六年，刘后所生之子，竟至得病，～。","book":"清·石玉昆《三侠五义》第一回"}},{"id":253,"word":"一咏一觞","pinyin":"yī yǒng yī shāng","abbr":"yyys","explanation":"咏：吟诗；觞：古代盛酒器，借指饮酒。旧指文人喝酒吟诗的聚会。","source":{"text":"一觞一咏，亦足以畅叙幽情。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"谪仙标韵胜琼枝。～、常是得追随。","book":"宋·王千秋《虞美人·寄李公定》词"},"similar":["一觞一咏"],"usage":"作宾语、定语；用于文人的交往"},{"id":254,"word":"一咏三叹","pinyin":"yī yǒng sān tàn","abbr":"yyst","explanation":"一个人领头唱，三个人和着唱。原指音乐和歌唱简单而质朴。后转用来形容诗婉转而含义深刻。","source":{"text":"清庙之歌，一倡而三叹也。","book":"《荀子·礼论》"}},{"id":255,"word":"一品白衫","pinyin":"yī pǐn bái shān","abbr":"ypbs","explanation":"唐人推重进士，称应进士科者为“一品白衫”。意指他日可以官登一品，但今日则犹着白衫。"},{"id":256,"word":"一哄而上","pinyin":"yī hǒng ér shàng","abbr":"yhes","explanation":"没有经过认真准备和严密组织，一下子行动起来。同“一哄而起”。","source":{"text":"在发展新‘三大件’那样，一见有利可图，便一哄而上。","book":"《人民日报》1983.10.31"},"example":{"text":"做项目不能～。"},"similar":["一哄而起"],"usage":"作谓语、宾语、定语；用于人"},{"id":257,"word":"一哄而散","pinyin":"yī hōng ér sàn","abbr":"yhes","explanation":"哄：吵闹。形容聚在一起的人一下子吵吵嚷嚷地走散了。","source":{"text":"御笔硃书四大字，曰：‘今年且罢。’于是一哄而散。","book":"明·沈德符《万历野获编·壬戌科罢选吉士》第十卷"},"example":{"text":"白凤、阿男早收拾好钱文，向众人道谢，看的就～了。","book":"清·吴趼人《情变》第六回"},"similar":["作鸟兽散","一轰而散"],"opposite":["一哄而起","源源而来","接踵而至"],"usage":"作谓语、定语；指吵吵嚷嚷地走散了","story":["清朝时杭州府仁和县财主袁凤宾的儿子袁绍芬是一个饭来张口、衣来伸手的公子哥儿，他生性好赌，与赌家沈七欠下272银圆，沈七去袁家讨债未果反挨痛打，于是在袁府门口服毒自尽，围观的人群纷纷冲进去哄抢贵重物品，等袁凤宾回家时早已一哄而散了"]},{"id":258,"word":"一哄而起","pinyin":"yī hōng ér qǐ","abbr":"yheq","explanation":"没有经过认真准备和严密组织，一下子行动起来。","source":{"text":"地方上百姓动了公愤，一哄而起。","book":"清·李宝嘉《官场现形记》"},"example":{"text":"然而也有并不～的人，当时好像落后，但因为也不一哄而散，后来成为中坚。","book":"鲁迅《且介亭杂文末编》"},"similar":["一应而起"],"opposite":["一哄而散"],"usage":"作谓语、宾语、定语；用于人"},{"id":259,"word":"一哄而集","pinyin":"yī hòng ér jí","abbr":"yhej","explanation":"哄：喧闹。一阵喧闹，人们都起来了。形容自发地行动起来。","example":{"text":"～的群众会，不能讨论问题，不能使群众得到政治训练，又最便于知识分子或投机分子的操纵。","book":"毛泽东《井冈山的斗争》"}},{"id":260,"word":"一响百应","pinyin":"yī xiǎng bǎi yìng","abbr":"yxby","explanation":"应：响应。一有响声，马上有很多人响应。","example":{"text":"除夕晚上的烟火真是～。"},"similar":["一呼百应"],"usage":"作谓语、定语；指响应的人多"},{"id":261,"word":"一唱一和","pinyin":"yī chàng yī hè","abbr":"ycyh","explanation":"一个先唱，一个随声应和。原形容两人感情相通。现也比喻二人互相配合，互相呼应。","source":{"text":"叔兮伯兮，倡予和女。","book":"《诗经·郑风·萚兮》"},"example":{"text":"自此～，渐渐情熟，往来不绝。","book":"明·冯梦龙《警世通言》卷三十四"},"similar":["遥相呼应","亦步亦趋","一拍即合"],"opposite":["各自为政","各行其是","各持己见"],"usage":"作谓语、定语；指互相呼应"},{"id":262,"word":"一唱三叹","pinyin":"yī chàng sān tàn","abbr":"ycst","explanation":"一个人领头唱，三个人和着唱。原指音乐和歌唱简单而质朴。后转用来形容诗婉转而含义深刻。","source":{"text":"清庙之歌，一倡而三叹也。","book":"《礼记·乐记》：“清庙之瑟，朱弦而疏越。一唱而三叹，有遗音者矣。”《荀子·礼论》"},"example":{"text":"长篇小字远相寄，～神凄楚。","book":"宋·苏轼《和蔡景繁海州石室》诗"},"similar":["字正腔圆","余音绕梁","绕梁三日"],"opposite":["驴鸣狗吠"],"usage":"作谓语、宾语、分句；用于音乐或诗歌"},{"id":263,"word":"一唱众和","pinyin":"yī chàng zhòng hè","abbr":"yczh","explanation":"和：呼应，附和。一人念头唱，众人附和。形容附和的人极多。","source":{"text":"人罢极而主不恤，国内溃而上不知，是以一夫倡而天下和。","book":"汉·桓宽《盐铁论·结和》"},"similar":["一唱百和","一倡百和"],"usage":"作谓语；指附和的人极多"},{"id":264,"word":"一唱百和","pinyin":"yī chàng bǎi hé","abbr":"ycbh","explanation":"形容附和的人极多。","source":{"text":"哪一个不是宋诗呢？那也是承了乾嘉极盛之后，不得不另辟蹊径，一唱百和，自然的成了一时风气了。","book":"清·曾朴《孽海花》第三十五回"},"example":{"text":"项挂百八念珠，手执九龙锡杖，～，宣卷谭空，铙钹钟鼓，声喧若沸。","book":"清·夏敬渠《野叟曝言》第五十二回"},"similar":["一倡百和","一唱众和"],"usage":"作谓语；指附和的人极多"},{"id":265,"word":"一唱雄鸡天下白","pinyin":"yī chàng xióng jī tiān xià bái","abbr":"ycxjtxb","explanation":"公鸡一叫，天就亮了。形容东方破晓，长夜宣告结束。指真相大白","source":{"text":"我有迷魂招不得，雄鸡一声天下白。少年心事当拿云，谁念幽寒坐鸣呃。","book":"唐·李贺《致酒行》"},"example":{"text":"毛泽东《浣溪沙·和柳亚子先生》：“～，万方乐奏有于阗，诗人兴会更无前。”"},"usage":"作宾语、定语；用于书面语"},{"id":266,"word":"一喜一悲","pinyin":"yī xǐ yī bēi","abbr":"yxyb","explanation":"既有让人高兴的事，也有令人悲伤的事。","source":{"text":"梦中执手兮一喜一悲，觉后痛吾心兮无休歇时。","book":"汉·蔡琰《胡笳十八拍》"},"example":{"text":"前日我侄初到，心中～，又兼辛苦了些儿，生出病来。","book":"明·凌濛初《二刻拍案惊奇》卷三"}},{"id":267,"word":"一喷一醒","pinyin":"yī pēn yī xǐng","abbr":"ypyx","explanation":"原指斗鸡要用水喷，使之清醒后再斗。后比喻推动督促。","source":{"text":"一喷一醒然，再接再厉乃。","book":"唐·韩愈《斗鸡联句》"},"example":{"text":"又未几而改命臣等九人，分道而出，～，而终不能保其后之不瘘痹也。","book":"明·张楝《陈边事》"},"usage":"作谓语、宾语；比喻推动督促"},{"id":268,"word":"一噎止餐","pinyin":"yī yē zhǐ cān","abbr":"yyzc","explanation":"犹因噎废食。比喻要做的事情由于出了点小毛病或怕出问题就索性不去干。","source":{"text":"夫有以饐死者，欲禁天下之食，悖。","book":"语出《吕氏春秋·荡兵》"},"similar":["因噎废食"],"usage":"作谓语、宾语、定语；用于处事"},{"id":269,"word":"一嚬一笑","pinyin":"yī pín yī xiào","abbr":"ypyx","explanation":"指不高兴或喜悦的表情。嚬，皱眉。"},{"id":270,"word":"一团和气","pinyin":"yī tuán hé qì","abbr":"ythq","explanation":"本指态度和霭可亲。现也指互相之间只讲和气，不讲原则。","source":{"text":"明道终日坐，如泥塑人，然接人浑是一团和气。","book":"宋·朱熹《伊洛渊源录》卷三引《上蔡语录》"},"example":{"text":"王头领待人接物，～，如何心地倒恁窄狭？","book":"明·施耐庵《水浒全传》第十九回"},"similar":["和蔼可亲","和颜悦色","平易近人"],"opposite":["凶神恶煞","凶相毕露"],"usage":"作谓语、宾语、状语；指不讲原则","story":["宋代洛阳理学家程颢倡导“主敬存诚”的观念，表面上宣扬孔孟之道，实际上兼采佛老之学，他死后，文彦博给他题墓碑“明道先生之墓”，他的信徒谢显通描写程颢的形象是：“明道终日坐着，好像泥塑的人，但他接待客人时却是一团和气。”"]},{"id":271,"word":"一团漆黑","pinyin":"yī tuán qī hēi","abbr":"ytqh","explanation":"形容一片黑暗，没有一点光明。也形容对事情一无所知。","source":{"text":"这时候，突然狂风大作，一片乌云飞也似地扑来，把月亮吞没了，山冲里顿时一团漆黑。","book":"陈登科《破壁记》"},"example":{"text":"窗外～，什么也看不清。"},"similar":["一无是处","一无可取","暗无天日"],"opposite":["光彩夺目","光辉灿烂","光天化日"],"usage":"作谓语、定语、状语；用于天气、政治局面等"},{"id":272,"word":"一团糟","pinyin":"yī tuán zāo","abbr":"ytz","explanation":"非常混乱、不整齐、肮脏。","source":{"text":"我知道你不会去告我。这些人就是胡说八道！咱们国家现在叫这些人弄得一团糟！","book":"路遥《平凡的世界》第一卷第25章"},"example":{"text":"单位让他搞得～。"},"similar":["一团乱麻"],"usage":"作谓语、状语、定语；指混乱局面"},{"id":273,"word":"一国三公","pinyin":"yī guó sān gōng","abbr":"ygsg","explanation":"公：古代诸侯国君的通称。一个国家有三个主持政事的人。比喻事权不统一，使人不知道听谁的话好。","source":{"text":"一国三公，吾谁适从？","book":"《左传·僖公五年》"},"example":{"text":"武夫当道势汹汹，～谁适从。","book":"蔡东藩、许廑父《民国通俗演义》第七十四回"},"similar":["政出多门"],"usage":"作宾语、定语；指政出多门","story":["春秋时期，晋献公宠幸骊姬，欲废太子申生改立奚齐为太子。骊姬设法把申生、重耳、夷吾送到边疆镇守，派土伪为他们建城堡，土伪十分为难，只好草草了事，说一个国家有三个君主，不知道听谁的好。不久晋献公杀申生，重耳与夷吾外逃"]},{"id":274,"word":"一国两制","pinyin":"yī guó liǎng zhì","abbr":"yglz","explanation":"“一个国家，两种制度”的简称。是中国共产党在十一届三中全会后提出的完成祖国统一的基本方针。其基本内容是在祖国统一的前提下，国家的主体坚持社会主义制度，同时在台湾、香港、澳门保持原有的资本主义制度和生活方式长期不变。"},{"id":275,"word":"一场春梦","pinyin":"yī chǎng chūn mèng","abbr":"yccm","explanation":"比喻过去的一切转眼成空。也比喻不切实际的想法落了空。","source":{"text":"有老妇年七十，谓坡曰：‘内翰昔日富贵，一场春梦。’","book":"五代前蜀·韦縠《才调集·张泌〈寄人〉诗》：“倚柱寻思倍惆怅，一场春梦不分明。”宋·赵令持《侯鲭录》卷七"},"example":{"text":"当日来时是何等样精力强壮，那知如今老迈龙钟，如同～。","book":"清·李汝珍《镜花缘》第九十九回"},"similar":["过眼烟云"],"usage":"作宾语；指幻想泡汤","story":["宋朝时期，大文豪苏东坡被贬到海南昌化，他背着一个大瓢在田野间步行，不时哼着曲调，遇到一个70多岁的老婆婆，她知道苏东坡的坎坷经历，现在亲眼目睹他的现状，十分感慨地说：“昔日内翰的荣华富贵只不过像一场春梦而已。”"]},{"id":276,"word":"一场欢喜忽悲辛","pinyin":"yī chǎng guān xǐ hū bēi xīn","abbr":"ychxhbx","explanation":"忽：突然。一场欢喜之事忽然变为悲痛之事。比喻人生悲喜不定，难以预料。","source":{"text":"忽喇喇似大厦倾，昏惨惨似灯将尽。呀！一场欢喜忽悲辛。叹人世，终难定！","book":"清·曹雪芹《红楼梦》第五回"}},{"id":277,"word":"一场空","pinyin":"yī chǎng kōng","abbr":"yck","explanation":"努力和希望完全落空。","source":{"text":"枉费心机空费力，雪消春水一场空。","book":"明·许仲琳《封神演义》第40回"},"example":{"text":"无论他怎样努力，其结局还是～。"},"usage":"作宾语、定语；用于事情的结局"},{"id":278,"word":"一场误会","pinyin":"yī chǎng wù huì","abbr":"ycwh","explanation":"指一次错怪别人。","source":{"text":"单立人和曲强开始意识到，这可能是一场误会，但也得问下去。","book":"王朔《人莫予毒》"},"example":{"text":"这原来是～。"},"usage":"作宾语；用于人对人或事物的看法","story":["东汉末年，关羽过五关斩六将奔向汝南，路过一座古城，见到张飞。张飞以为他投降了曹操举刀便砍。关羽怎样解释都没用，刘备的两位夫人作证也不行。刚好曹操的追兵蔡阳率军赶到，关羽杀了蔡阳。张飞才消除一场误会，他们和好如初"]},{"id":279,"word":"一坐一起","pinyin":"yī zuò yī qǐ","abbr":"yzyq","explanation":"犹言一举一动。指人的每一个动作。","source":{"text":"观敌之来，一坐一起，其政以理，其追北佯为不及，其见利佯为不知，如此将者，名为智将。","book":"《吴子·论将》"},"example":{"text":"东宫虽燕居内殿，～，恒向西南面台。","book":"《南史·梁昭明太子统传》"},"similar":["一举一动"],"usage":"作宾语、定语；用于书面语"},{"id":280,"word":"一坐之间","pinyin":"yī zuò zhī jiān","abbr":"yzzj","explanation":"一坐：刚一坐下；间：间隙。刚一坐下的短暂时刻。形容时间很短。","source":{"text":"因吟啸良久，随而下笔。一坐之间，诔以之成。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"端性耿介言无茍且，～不谈世论，唯以佛法为己务。","book":"宋·释赞宁《宋高僧传》卷七"}},{"id":281,"word":"一坐之顷","pinyin":"yī zuò zhī qīng","abbr":"yzzq","explanation":"一坐：刚一坐下；顷：顷刻。刚一坐下的短暂时刻。形容时间很短。","source":{"text":"因吟啸良久，随而下笔。一坐之间，诔以之成。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"且如今～，便有许多语话，岂不是动。","book":"宋·朱熹《朱子语类》卷十八"}},{"id":282,"word":"一坐尽倾","pinyin":"yī zuò jìn qīng","abbr":"yzjq","explanation":"指满座倾慕。","source":{"text":"皆倾慕其风采也。","book":"《史记·司马相如列传》：“临邛令不敢尝食，自往迎相加。相如不得已，强往，一坐尽倾。”按，《汉书》本传颜师古注"}},{"id":283,"word":"一坐尽惊","pinyin":"yī zuò jìn jīng","abbr":"yzjj","explanation":"指满座皆惊服。","source":{"text":"粲至，年既幼弱，容状短小，一坐尽惊。","book":"《三国志·魏志·王粲传》"},"similar":["一坐皆惊"],"usage":"作谓语、状语；用于书面语"},{"id":284,"word":"一坐皆惊","pinyin":"yī zuò jiē jīng","abbr":"yzjj","explanation":"指满座皆惊服。同“一坐尽惊”。","source":{"text":"张欲自发无端。顷之，长史诸贤来清言，客主有不通处，张乃遥于末坐判之，言约旨远，足畅彼我之怀，一坐皆惊。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"吕陶，字元钧，成都人。蒋堂守蜀，延多士入学，亲程其文，尝得陶论，集诸生诵之，曰：“此贾谊之文也。”陶时年十三，～。","book":"《宋史·吕陶传》"},"similar":["一坐尽惊"],"usage":"作谓语、状语；用于书面语","story":["宋朝时期，蒋堂担任蜀郡守备，亲自招收很多学士教诲，要求他们作文评论时政，当他看到吕陶的文章时，激动得招集所有的学生来听，并夸奖吕陶的文章可以与贾谊的文章媲美。那时的吕陶才13岁，使得在座的人为之惊讶"]},{"id":285,"word":"一块石头落了地","pinyin":"yī kuài shí tou luò le dì","abbr":"ykstlld","explanation":"比喻放下了心。","source":{"text":"余二先生一块石头落了地，写信约哥回来。","book":"清·吴敬梓《儒林外史》第45回"},"example":{"text":"我心中的～。"},"usage":"作谓语、宾语；比喻放了心"},{"id":286,"word":"一块石头落地","pinyin":"yī kuài shí tóu luò dì","abbr":"ykstld","explanation":"比喻放了心，再没有顾虑。","source":{"text":"赵温听说大人不见，如同一块石头落地，把心放下，赶忙到承差屋里，将亲供恭恭敬敬的填好，交代明白。","book":"清·李宝嘉《官场现形记》第二回"}},{"id":287,"word":"一堂和气","pinyin":"yī táng hé qì","abbr":"ythq","explanation":"本指态度和霭可亲。现也指互相之间只讲和气，不讲原则。","source":{"text":"好是一堂和气，胜十分春色。","book":"宋·管鉴《好事近》词"},"example":{"text":"酿成～，来荐老人觞。","book":"元·王恽《水调歌头》词"}},{"id":288,"word":"一塌刮子","pinyin":"yī tā guā zi","abbr":"ytgz","explanation":"总共加在一起。","source":{"text":"倪当仔耐啥格事体实梗格发极，一塌刮子少仔几百洋钱，也用勿着实梗样式啘。","book":"清·张春帆《九尾龟》第六十四回"},"example":{"text":"尽管你昨天朝人家磕头跪拜求过，——拉过交情，得过好处，今天轮到人来求你了，就要把昨天的事情忘记得～精光！","book":"茅盾《多角关系》五"},"similar":["一塌括仔"],"usage":"作分句、状语；指一共"},{"id":289,"word":"一塌括仔","pinyin":"yī tā kuò zǐ","abbr":"ytkz","explanation":"通通或全部加在一起。","source":{"text":"故歇齐大人要办，容易得势，我就立刻喊齐仔人，一塌括仔去捉得来，阿好？","book":"清·韩邦庆《海上花列传》第五十六回"},"similar":["一塌刮子"],"usage":"作分句、状语；指一共"},{"id":290,"word":"一塌糊涂","pinyin":"yī tā hú tú","abbr":"ytht","explanation":"糊涂：混乱。形容混乱或败坏到了不可收拾的程度。","source":{"text":"与其顾惜场面，硬充好汉，到临了弄的一塌糊涂，还不如一老一实，揭破真情，自寻生路。","book":"清·曾朴《孽海花》第三十回"},"example":{"text":"新开设的中学，更是～，笑话百出。","book":"郭沫若《革命春秋·学生时代》"},"similar":["乱七八糟","一团漆黑"],"opposite":["条理井然","井然有序"],"usage":"作谓语、定语、宾语、状语；指混乱局面"},{"id":291,"word":"一塌胡涂","pinyin":"yī tā hú tú","abbr":"ytht","explanation":"形容混乱或败坏到了不可收拾的程度。同“一塌糊涂”。","source":{"text":"我的运气不好，处处倒楣，碰钉子，事业一到我手里就莫名其妙地弄得一塌胡涂。","book":"曹禺《北京人》第二幕"},"similar":["一塌糊涂","一榻胡涂"],"usage":"作谓语、定语、宾语、状语；指混乱局面"},{"id":292,"word":"一壑一丘","pinyin":"yī hè yī qiū","abbr":"yhyq","explanation":"壑：山沟；丘：土山。原指隐者所居之地。后多用以指寄情山水。","source":{"text":"端委庙堂，使百官准则，臣不如亮；一丘一壑，自谓过之。","book":"《汉书·叙传上》：“渔钓于一壑，则万物不奸其志；栖迟于一丘，则天下不易其乐。”南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"～，轻衫短帽，白发多时故人少。","book":"宋·辛弃疾《感皇恩》词"}},{"id":293,"word":"一士之智","pinyin":"yī shì zhī zhì","abbr":"yszz","explanation":"智：智慧。一个人的智慧。形容有限的才智。","source":{"text":"千金之裘，非一狐之腋也；台榭之榱，非一木之枝也；三代之际，非一士之智也。","book":"《史记·刘敬叔孙通列传》"}},{"id":294,"word":"一声不吭","pinyin":"yī shēng bù kēng","abbr":"ysbk","explanation":"一句话也不说。","source":{"text":"玉厚还是一声不吭。他现在已经懒得再说他女婿的长长短短，他心里只是为他的女儿和两个外孙难受。","book":"路遥《平凡的世界》第一卷第八章"},"example":{"text":"方方～地从人群中挤上来，用手里的砖朝这孩子的颅顶使劲一拍。","book":"王朔《动物凶猛》"},"similar":["一声不响","一言不发"],"opposite":["喋喋不休"],"usage":"作谓语、定语；用于处事"},{"id":295,"word":"一声不响","pinyin":"yī shēng bù xiǎng","abbr":"ysbx","explanation":"指不发出一点声音。","source":{"text":"仿佛菊笑一声不响的闪了进来，像猫儿戏蝶一般，擒擒纵纵地把自己搏弄。","book":"曾朴《孽海花》第31回"},"example":{"text":"他坐在那里～。"},"similar":["鸦雀无声"],"opposite":["沸反盈天"],"usage":"作谓语、状语；指没有声音"},{"id":296,"word":"一壶中流","pinyin":"yī hú zhōng liú","abbr":"yhzl","explanation":"壶：通“瓠”，瓠瓜，中空，能浮在水面。比喻东西虽然轻微，用得到的时候便十分珍贵。","source":{"text":"中河失船，一壶千金，贵贱无常，时使物然。","book":"《鹖冠子·学问》"}},{"id":297,"word":"一壶千金","pinyin":"yī hú qiān jīn","abbr":"yhqj","explanation":"壶：通“瓠”，瓠瓜，中空，能浮在水面。比喻东西虽然轻微，用得到的时候便十分珍贵。","source":{"text":"中河失船，一壶千金。贵贱无常，时物使然。","book":"《鹖冠子·学问》"},"example":{"text":"韩子惜之，则中流失船，～。","book":"清·黄式三《读》"},"similar":["中河失船，一壶千金"],"usage":"作宾语、定语；用于小物件","story":["战国时期，鹖冠子隐居山中，不愿出来做官，他的学问很高深，而且非常有哲理，后人写一部书托他的名为《鹖冠子》，该书共3卷19篇，其中《学问》中有一段话：“中河失船，一壶千金。贵贱无常，时物使然。”短短几字，寓意深刻"]},{"id":298,"word":"一壸千金","pinyin":"yī kuì qiān jīn","abbr":"ykqj","explanation":"比喻物虽微贱，关键时得其所用，便十分宝贵。"},{"id":299,"word":"一夔一契","pinyin":"yī kuí yī qì","abbr":"ykyq","explanation":"夔契都是舜时贤臣，后因以之喻良辅。","source":{"text":"一夔一契付公等，某水某丘如我何。","book":"宋·石介《庆历圣德颂》诗：“惟仲淹弼，一夔一契，天实赉予，予其敢忽。”宋·方岳《竹下》诗"},"usage":"作宾语；用于书面语"},{"id":300,"word":"一夔已足","pinyin":"yī kuí yǐ zú","abbr":"ykyz","explanation":"夔：古贤臣名，为舜时的典乐官。夔一人已足制乐。指只要是真正的人才，有一个就足够了。","source":{"text":"夫乐，天地之精也，得失之节也，故唯圣人为能和，乐之本也。楚能和之，以平天下，若夔者一而足矣！","book":"《韩非子·外储说左下》：“不也，夔非一足也，……一而足也。”《吕氏春秋·察传》"},"example":{"text":"昔尧作《大章》，～。","book":"《后汉书·曹褒传》"},"opposite":["多多益善"],"usage":"作谓语；指只要是真正的人才，一个足够了","story":["古代部落首领舜继承尧的位子后，为百姓做了很多好事，他从部落中挑选优秀人才来协助他管理天下。百姓过上富足的生活，他想请一个精通音律的人来提高人们的道德修养，终于找到一个叫夔的人来推广音乐，并感慨说有夔一个就足够了"]},{"id":301,"word":"一夔自足","pinyin":"yī kuí zì zú","abbr":"ykzz","explanation":"夔：古贤臣名，为舜时的典乐官。夔一人已足制乐。指只要是真正的人才，有一个就足够了。","source":{"text":"夫乐，天地之精也，得失之节也，故唯圣人为能和，乐之本也。楚能和之，以平天下，若夔者一而足矣！","book":"《韩非子·外储说左下》：“不也，夔非一足也，……一而足也。”《吕氏春秋·察传》"}},{"id":302,"word":"一夕一朝","pinyin":"yī xī yī zhāo","abbr":"yxyz","explanation":"一个晚上或一个早晨。形容很短的时间。同“一朝一夕”。","source":{"text":"所以圣人垂戎谓：臣弑父，非一夕一朝之故，其所由来者渐矣。","book":"《朱子语类》卷十三"},"example":{"text":"这项复杂的工程不是～所能完成的"},"similar":["一朝一夕"],"usage":"作宾语、定语、状语；用于否定句"},{"id":303,"word":"一夕三叹","pinyin":"yī xī sān tàn","abbr":"yxst","explanation":"夕：晚上；三：多次。一夜之间反复叹息。","source":{"text":"吟彼乔木诗，一夕常三叹。","book":"唐·常建《赠三侍御》"}},{"id":304,"word":"一夕三迁","pinyin":"yī xī sān qiān","abbr":"yxsq","explanation":"一夜之间三次迁移。形容居住的地方极不安全，令人提心吊胆，不得安宁。","source":{"text":"吴子闻之，一夕三迁。","book":"《左传·哀公八年》"}},{"id":305,"word":"一夕九升","pinyin":"yī xī jiǔ shēng","abbr":"yxjs","explanation":"九：比喻次数多；夕：晚上；兴：升起。一夜之间心绪多次起伏波动。形容心绪很不安宁。","source":{"text":"意恍惚以迁越兮，神一夕而九升。","book":"晋·潘岳《寡妇赋》"}},{"id":306,"word":"一夕九徙","pinyin":"yī xī jiǔ xǐ","abbr":"yxjx","explanation":"九：多次；徙：迁移。一夜之间迁移好几次。形容居住的地方极不安全。","source":{"text":"暠大惊惧，乃布棘于室，以板籍地，一夕九徙，虽家人莫知其处。","book":"《后汉书·苏木韦传》"}},{"id":307,"word":"一夕五制","pinyin":"yī xī wǔ zhì","abbr":"yxwz","explanation":"一夜的工夫写出五种体制。形容文思敏捷，文章写得很快。","source":{"text":"宋晁宗悫字世良，真宗时为翰林学士，一夕草除将相五制。","book":"明·彭大翼《山堂肆考·臣职》"}},{"id":308,"word":"一夕千念","pinyin":"yī xī qiān niàn","abbr":"yxqn","explanation":"一夜之间有千头思绪涌上心头。形容思绪纷乱。","source":{"text":"一夕盈千念，方知别者劳。","book":"唐·钱起《秋夜寄袁中丞王员外》"}},{"id":309,"word":"一夕白发","pinyin":"yī xī bái fà","abbr":"yxbf","explanation":"形容非常焦虑、着急，一夜的工夫头发都急白了。"},{"id":310,"word":"一夜十起","pinyin":"yī yè shí qǐ","abbr":"yysq","explanation":"心里惦挂事情，一晚上起来十次，不得安睡。","example":{"text":"他工作认真负责，经常是～，仔细检查。"},"usage":"作宾语、定语；指夜不能寐","story":["东汉初期，有名清官会稽太守第五伦为官十分清廉，他甚至亲自铡草喂马，别人问他是否有私心，他毫不掩饰地说有，举例说侄儿生病时，他一夜十起去看望，每次都能安然入睡，而自己的儿子生病时，他一夜十起，心中有所牵挂就通夜难眠"]},{"id":311,"word":"一夜夫妻百夜恩","pinyin":"yī yè fū qī bǎi yè ēn","abbr":"yyfqbye","explanation":"一旦结为夫妻，就会产生深厚的感情。","source":{"text":"可不道一夜夫妻百夜恩，你可便息怒停嗔。","book":"元·关汉卿《救风尘》第三折"},"example":{"text":"白娘子陪着笑面道：‘丈夫，～，和你说来事长。","book":"明·冯梦龙《警世通言》第28卷"},"similar":["一日夫妻百日恩"],"usage":"作宾语、定语、分句；用于夫妻间","story":["永平府名士张鸿渐因知府赵某打死范秀才而打抱不平上告，被诬陷入狱，他中途逃脱至风翔府，遇到狐仙施舜华，两人相爱并同居三年。张鸿渐想念昔日的妻子，就对施舜华解释道：“一日夫妻，百日恩义”。施舜华理解他的心情就送他回家"]},{"id":312,"word":"一夜夫妻百日恩","pinyin":"yī yè fū qī bǎi rì ēn","abbr":"yyfqbre","explanation":"一旦建立了夫妻关系，深厚的感情历久不衰。","source":{"text":"可不道一夜夫妻百夜恩，便可便息怒停嗔。","book":"元·关汉卿《救风尘》第三折"},"example":{"text":"丈夫，“～”和你说来事长。","book":"明·冯梦龙《警世通言》卷二十八"},"similar":["一夜夫妻百夜恩"],"usage":"作宾语、定语、分句；用于夫妻间"},{"id":313,"word":"一夜被蛇咬，十日怕麻绳","pinyin":"yī yè bèi shé yǎo，shí rì pà má shéng","abbr":"yybsysrpms","explanation":"一次被蛇咬了，看见井边断了的绳子也害怕。比喻在某事上吃了苦头，以后碰到类似的情况也会害怕","source":{"text":"真真‘一夜被蛇咬，十日怕麻绳’光景。","book":"清·李绿园《歧路灯》第73回"},"similar":["一朝被蛇咬，三年怕井绳"],"usage":"作宾语、定语、分句；用于处事"},{"id":314,"word":"一天一地","pinyin":"yī tiān yī dì","abbr":"ytyd","explanation":"满天满地。形容到处都是。","source":{"text":"又兼狄家的觅汉伙伴不曾分得银钱的，心里气他不过，到处去彰扬，不止他本村扬说的一天一地，就是邻庄外县，都当了一件异事传说。","book":"清·西周生《醒世姻缘传》第三十四回"},"usage":"作定语、状语；用于书面语"},{"id":315,"word":"一天好事","pinyin":"yī tiān hǎo shì","abbr":"yths","explanation":"形容非常好的事情。","source":{"text":"一天好事从今定，一首诗分明照证；再不向表琐闼梦儿中寻，则去那碧桃花树儿下等。","book":"元·王实甫《西厢记》第一本第三折"},"example":{"text":"～投奔我，我来日就富贵了。","book":"明·冯梦龙《醒世恒言》卷十六"}},{"id":316,"word":"一天星斗","pinyin":"yī tiān xīng dǒu","abbr":"ytxd","explanation":"原指满天的星星。后比喻事情多而杂乱。也可形容文章词藻华丽。","source":{"text":"半夜风雷过，一天星斗寒。","book":"唐·李中《江行夜泊》诗"},"example":{"text":"约莫二更前后，方才风静云开，～。","book":"明·施耐庵《水浒全传》第八十六回"},"similar":["满天星斗"],"usage":"作宾语、定语、状语；形容文章华美"},{"id":317,"word":"一夫之勇","pinyin":"yī fū zhī yǒng","abbr":"yfzy","explanation":"犹言匹夫之勇。指不用智谋单凭个人的勇力。","source":{"text":"颜良、文丑，一夫之勇耳，可一战而禽也。","book":"《三国志·魏志·荀彧传》"},"example":{"text":"郤谷悦礼乐，敦《诗》《书》，为晋元帅；杜预射不穿札，建平吴之勋。是知中权制谋，不取～。","book":"《资治通鉴·唐中宗景龙元年》"},"similar":["匹夫之勇"],"usage":"作宾语；指个人的勇气"},{"id":318,"word":"一夫之用","pinyin":"yī fū zhī yòng","abbr":"yfzy","explanation":"指仅能当一人之用，而无兼人之能。","source":{"text":"异一夫之用，不足为强弱。","book":"《后汉书·冯异传》"},"example":{"text":"夫将帅者，御众之名；士卒者，～。","book":"《宋书·张畅传论》"},"usage":"作宾语；用于书面语"},{"id":319,"word":"一夫可守","pinyin":"yī fū kě shǒu","abbr":"yfks","explanation":"一夫：一个人；守：把守。一个人就能把守住。形容地势险要，易于防守。","source":{"text":"《志》云：在小剑山顶，四际断崖，前临巨壑，孤门控据，一夫可守。宋置戍于此。","book":"清·顾祖禹《读史方舆纪要》"},"example":{"text":"皆鸟道崎岖，～。","book":"清·嘉庆重修《一统志·江西省·广昌县》"}},{"id":320,"word":"一夫当关","pinyin":"yī fū dāng guān","abbr":"yfdg","explanation":"形容地势十分险要，易守难攻。","source":{"text":"忠州左右乌、竹两岭，羊肠绕曲，有‘一夫当关’之险。","book":"《明史·外国传一·朝鲜》"},"example":{"text":"《明史·外国传·朝鲜》：“忠州左右乌、竹二岭，羊肠绕曲，有‘～’之险。”"},"similar":["一夫当关，万夫莫开"],"usage":"作定语；用于书面语"},{"id":321,"word":"一夫当关，万夫莫开","pinyin":"yī fū dāng guān，wàn fū mò kāi","abbr":"yfdgwfmk","explanation":"意思是山势又高又险，一个人把着关口，一万个人也打不进来。形容地势十分险要。","source":{"text":"一人守隘，万夫莫向。","book":"《淮南子·兵略训》：“一人守隘，而千人弗敢过也。”晋·左思《蜀都赋》"},"example":{"text":"剑阁峥嵘而崔嵬，～。","book":"唐·李白《蜀道难》诗"},"similar":["一夫当关，万夫莫摧"],"usage":"作宾语、定语、分句；形容地势十分险","story":["唐玄宗天宝年间，李白看到朝政腐败，奸臣当道，预感到潜伏变乱的危机，他借送朋友入蜀之机写下《蜀道难》这诗揭示现状：“剑阁峥嵘而崔嵬，一夫当关，万夫莫开。所守或匪亲，化为狼与豺。朝避猛虎，夕避长蛇，磨牙吮血，杀人如麻。”"]},{"id":322,"word":"一夫当关，万夫莫摧","pinyin":"yī fū dāng guān，wàn fū mò cuī","abbr":"yfdgwfmc","explanation":"当：遮挡，阻挡。山势又高又险，一个人把着关口，一万个人也打不进来。形容地势十分险要，易守难攻","source":{"text":"天门口是个要隘，非造门栅不可。一夫当关，万夫莫摧。","book":"张天翼《儿女们》"},"similar":["一夫当关，万夫莫开"],"usage":"作宾语、定语、分句；形容地势十分险"},{"id":323,"word":"一夫当关，万夫莫敌","pinyin":"yī fū dāng guān，wàn fū mò dí","abbr":"yfdgwfmd","explanation":"当：遮挡，阻挡。山势又高又险，一个人把着关口，一万个人也打不进来。形容地势十分险要，易守难攻","source":{"text":"东路北伐先锋队将迫近一夫当关，万夫莫敌的仙霞岭下的时候，1926年的余日剩已无多。","book":"郁达夫《出奔》"},"similar":["一夫当关，万夫莫摧"],"usage":"作宾语、定语、分句；形容地势十分险"},{"id":324,"word":"一夫得情，千室鸣弦","pinyin":"yī fū dé qíng，qiān shì míng xián","abbr":"yfdqqsmx","explanation":"一夫：一个当权者；得情：赢得民心；千室：千家万户；鸣弦：响起弦乐。指一个执政者能体恤民心，老百姓就能生活安乐。","source":{"text":"一人得情，千室鸣弦；怀我夙爱，永戴遗贤。","book":"《后汉书·童恢传赞》"}},{"id":325,"word":"一夫得道，九族升天","pinyin":"yī fū dé dào，jiǔ zú shēng tiān","abbr":"yfddjzst","explanation":"一个人得道成仙，全家族都随之升天。比喻一个人做了官，和他有关系的人也都跟着得势。","source":{"text":"淮南王学道，招会天下有道之人，倾一国之尊，下道术之士，是以道术之士并会淮南，奇方异术，莫不争出。王遂得道，举家升天，畜产皆仙，犬吠于天上，鸡鸣于云中。","book":"汉·王充《论衡·道虚》"},"example":{"text":"～。我不在你九族内吗？那时连我爹妈都要见面哩！","book":"清·刘鹗《老残游记续集》第九回"},"similar":["一人高升，众人得济"],"usage":"作宾语、分句；用于人事关系"},{"id":326,"word":"一夫舍死，万夫莫当","pinyin":"yī fū shě sǐ，wàn fū mò dāng","abbr":"yfsswfmd","explanation":"一夫：一人；舍死：即舍命，不要性命。当：通“挡“，抵挡。一个人拼着性命，谁也阻挡不住。","source":{"text":"从古说得好：一人拼命，万夫莫当。","book":"明·徐渭《英烈传》第二十八回"}},{"id":327,"word":"一夫荷戈，万夫莫前","pinyin":"yī fū hè gē，wàn fū mò qián","abbr":"yfhgwfmq","explanation":"荷：背，负；戈：古代兵器。一个人背着戈把守关隘，一万人也无法前进。比喻地势险要。","source":{"text":"一人荷戟，万夫趑趄。形胜之地，匪亲勿居。","book":"宋·张载《剑阁铭》"},"example":{"text":"剑门天险，古称～，诸君宜各陈进取之策。","book":"《宋史·王全斌传》"}},{"id":328,"word":"一夫荷戟，千人莫当","pinyin":"yī fū hè jǐ，qiān rén mò dāng","abbr":"yfhjqrmd","explanation":"荷：扛；戟：古兵器。一个人把着关口，一千个人也打不进来。形容地势十分险要，易守难攻","source":{"text":"蜀之为国，非不险也，高山寻云霓，深谷肆无景，数马悬车，然后得济，皆言‘一夫荷戟，千人莫当’。","book":"《晋书·羊祜传》"},"similar":["一夫当关，万夫莫敌"],"usage":"作宾语、定语、分句；形容地势十分险"},{"id":329,"word":"一夫荷戟，尤夫趦趄","pinyin":"yī fū hè jǐ，wàn fū zī jū","abbr":"yfhjyfzj","explanation":"荷：背，负；戟：古代兵器。一个人背着戟把守关隘，一万人也无法前进。比喻地势险要。","source":{"text":"一人荷戟，万夫趑趄。形胜之地，匪亲勿居。","book":"宋·张载《剑阁铭》"}},{"id":330,"word":"一失足成千古恨","pinyin":"yī shī zú chéng qiān gǔ hèn","abbr":"yszcqgh","explanation":"比喻一旦犯下严重错误或堕落，就成为终身的憾事。","source":{"text":"唐解元寅既废弃，诗云：‘一失足成千古笑，再回头是百年人。’","book":"明·杨仪《明良记》"},"example":{"text":"我深知这局棋关系重大，绝不能到最后出问题，～啊！","book":"陈祖德《超越自我》"},"opposite":["悬崖勒马"],"usage":"作谓语、分句；用于劝诫人"},{"id":331,"word":"一头雾水","pinyin":"yī tóu wù shuǐ","abbr":"ytws","explanation":"形容情况不明，让人摸不着头脑。"},{"id":332,"word":"一如既往","pinyin":"yī rú jì wǎng","abbr":"yrjw","explanation":"一：完全；既往：从前，已往。指态度没有变化，完全象从前一样。","source":{"text":"清末以来，到海外求学的中国人何止千百，在学业上有成就的也大有人在，可是，中国又穷又弱的现状一如既往，丝毫无所改变。","book":"苏叔阳《第二次握手》"},"example":{"text":"它～，是一片蓬勃的繁忙景象。","book":"浩然《艳阳天》第124章"},"similar":["始终如一","自始至终","一如曩昔"],"opposite":["一反常态","一改故辙","改头换面"],"usage":"作谓语、定语、状语；指没有改变"},{"id":333,"word":"一如曩昔","pinyin":"yī rú nǎng xī","abbr":"yrnx","explanation":"曩昔：从前。完全跟从前一样。","source":{"text":"凡乌头日用所需，辄同妪启户出粟，为之营辨；己锱铢无所沾染，抱子食贫，一如曩昔。","book":"清·蒲松龄《聊斋志异·乔女》"},"example":{"text":"自此次觐见后，国际情形～。","book":"蔡东藩《慈禧太后演义》第三十二回"},"similar":["一如既往"],"usage":"作谓语、定语、状语；指没有改变"},{"id":334,"word":"一子出家，七祖升天","pinyin":"yī zǐ chū jiā，qī zǔ shēng tiān","abbr":"yzcjqzst","explanation":"借喻一人得势，全家沾光。同“一子出家，九祖升天”。","source":{"text":"我说的不是功名么？你们不知道‘一子出家，七祖升天呢’？","book":"清·曹雪芹《红楼梦》第一一七回"},"similar":["一子出家，九祖升天"],"usage":"作宾语、定语；用于书面语"},{"id":335,"word":"一子出家，七祖昇天","pinyin":"yī zǐ chū jiā，qī zǔ shēng tiān","abbr":"yzcjqzst","explanation":"借喻一人得势，全家沾光。同“一子出家，九祖升天”。"},{"id":336,"word":"一子出家，七祖昻天","pinyin":"yī zǐ chū jiā，qī zǔ shēng tiān","abbr":"yzcjzst","explanation":"借喻一人得势，全家沾光。同一子出家，九祖升天”。"},{"id":337,"word":"一子出家，九祖升天","pinyin":"yī zǐ chū jiā，jiǔ zǔ shēng tiān","abbr":"yzcjjzst","explanation":"指子孙中有一人出家，祖宗都能升天。常用以借喻一人得势，全家沾光。","source":{"text":"常言：‘一子出家，九祖升天’，你那夫主冤愆解释，亦得超生去了。","book":"明·兰陵笑笑生《金瓶梅词话》第一百回"},"similar":["一子出家，七祖升天"],"usage":"作宾语、定语；用于书面语"},{"id":338,"word":"一子失着，满盘皆输","pinyin":"yī zǐ shī zhāo，mǎn pán jiē shū","abbr":"yzszmpjs","explanation":"着：下棋落子。指下棋时关键的一步棋走得不当，整盘棋就输了。比喻关键性问题处理不当，结果导致整个失败","source":{"text":"一子失着，满盘皆输，这是有的。","book":"李欣《老生常谈·熟视无睹，充耳不闻》"},"similar":["一着不慎，满盘皆输"],"usage":"作宾语、分句；指要慎重其事"},{"id":339,"word":"一子悟道，九族升天","pinyin":"yī zǐ wù dào，jiǔ zú shēng tiān","abbr":"yzwdjzst","explanation":"九族：本人的父、祖父、曾祖、高祖和子、孙、曾孙、重孙。一个孩子领悟天道，整个家族都能升到天堂去","source":{"text":"常言道：‘一子悟道，九族升天’，不要错过了。","book":"元·马致远《黄粱梦》第一折"},"similar":["一子出家，七祖升天"],"usage":"作宾语、定语；用于书面语"},{"id":340,"word":"一子悟道，九族生天","pinyin":"yī zǐ wù dào，jiǔ zú shēng tiān","abbr":"yzwdjzst","explanation":"犹言一子出家，九祖升天。借喻一人得势，全家沾光。","source":{"text":"你自不知，你不是个做官的，天生下这等道貌，是个神仙中人。常言道：‘一子悟道，九族生天’，不要错过了。","book":"元·马致远《黄粱梦》第一折"}},{"id":341,"word":"一孔不达","pinyin":"yī kǒng bù dá","abbr":"ykbd","explanation":"指一窍不通。"},{"id":342,"word":"一孔之见","pinyin":"yī kǒng zhī jiàn","abbr":"ykzj","explanation":"从一个小窟窿里所看到的。比喻狭隘片面的见解。","source":{"text":"持规而非矩，执准而非绳，通一孔，晓一理，而不知权衡。","book":"汉·桓宽《盐铁论·相刺》"},"example":{"text":"以上所说是我个人的～，仅供大家参考。"},"similar":["一得之见","坐井观天","管见所及"],"opposite":["高瞻远瞩"],"usage":"作宾语；指片面的见解","story":["从前有一个人看到别人布网捕鸟，发现被捕的鸟每只鸟头才钻一个网眼，心想既然如此，何必结网呢？他回家便剪断长绳做成一个个圈圈，别人问他作什么用，他笑而不答并庆幸自己一孔之见，就找了一个没人的地方安好这些小圈圈，结果一只鸟儿也没捕上"]},{"id":343,"word":"一字一句","pinyin":"yī zì yī jù","abbr":"yzyj","explanation":"形容人说话清楚从容。","source":{"text":"三婶子一点一点撕着那发了黑的棉花，一字一句地说：‘老三那孩子言不出语不进的，写不上，算不上，工作团咋派上他这个老实疙瘩。’","book":"林兰《红棉袄》"},"example":{"text":"他～地交代工作。"},"similar":["一字一板"],"usage":"作定语、状语；形容人说话清楚从容"},{"id":344,"word":"一字一板","pinyin":"yī zì yī bǎn","abbr":"yzyb","explanation":"形容说话从容清楚，吐字清晰，也指严肃认真，毫不苟且或正正经经，合乎规矩。","source":{"text":"温都太太把房钱，吃饭的时间，晚上锁门的时候，和一切的规矩，都当着伊牧师一字一板的交待明白了。","book":"老舍《二马》"},"example":{"text":"王朔《橡皮人》：“我盯着老头的眼睛～地说：‘就在刚才我在路上随便问了个小贩，他出的价……’”"},"similar":["一字一句"],"usage":"作定语、状语；形容说话从容清楚"},{"id":345,"word":"一字一泪","pinyin":"yī zì yī lèi","abbr":"yzyl","explanation":"一个字就仿佛是一滴眼泪。形容文字写得凄楚感人。亦作“一言一泪”。","source":{"text":"写至此，一字一泪，不知当向何人道，当与何人读，想当照旧剃发归山去矣！","book":"明·李贽《焚书·书答·与焦漪园》"},"example":{"text":"真是绝唱，～，一泪一血！这也不枉秋痕的数点泪渍在上头。","book":"清·魏秀仁《花月痕》第十四回"},"usage":"作宾语、状语；指内心凄苦"},{"id":346,"word":"一字一珠","pinyin":"yī zì yī zhū","abbr":"yzyz","explanation":"一个字就象一颗珍珠。形容歌声婉转圆润。也比喻文章优美，辞藻华丽。","source":{"text":"一字新声一颗珠，啭喉疑是击珊瑚。","book":"唐·薛能《赠歌者》诗"},"example":{"text":"这样文字，连我看一两遍也不能解，直至三遍之后，才晓得是天地间之至文，真乃～。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["一字千金"],"usage":"作定语、宾语；指文字精妙"},{"id":347,"word":"一字不差","pinyin":"yī zì bù chā","abbr":"yzbc","explanation":"一个字也没有更改，与原文雷同。","source":{"text":"鹦鹉在旁谛听，便都记得明白，朗朗的念将出来，一字不差。","book":"清·褚人获《隋唐演义》第87回"},"example":{"text":"清·荻岸山人《平山冷燕》第13回：“刚转得一转身，不知谁人就和了一首在上面，就是此诗，～。”"},"similar":["一字不易","一字不爽"],"usage":"作定语、状语；多用于背诵、抄袭等"},{"id":348,"word":"一字不易","pinyin":"yī zì bù yì","abbr":"yzby","explanation":"文字精醇，一个字也不能更改。也用于指抄袭者一字不改地照抄别人的文章。","source":{"text":"而逖尤精密，张九龄视其草，欲易一字，卒不能也。","book":"《新唐书·文艺传中·孙逖》"},"example":{"text":"他～地抄袭我的文章。"},"similar":["一字未改","一字不差"],"usage":"作定语、状语；指不改变一字"},{"id":349,"word":"一字不爽","pinyin":"yī zì bù shuǎng","abbr":"yzbs","explanation":"一个字也不错。指交待的话与原话一致或与事实符合。","source":{"text":"绍定元年，有言举人程文雷同，或一字不差。","book":"《宋史·选举志二》"},"example":{"text":"所责之事，皆系平日私语，～，料必不能挽回的。","book":"清·曹雪芹《红楼梦》第七十七回"},"similar":["一字不差"],"usage":"作谓语、定语；用于书面语"},{"id":350,"word":"一字不苟","pinyin":"yī zì bù gǒu","abbr":"yzbg","explanation":"苟：马虎，随便。形容写文章不随便下笔，每一个字都要斟酌。","source":{"text":"杜子美改罢长吟，一字不苟。","book":"宋·罗大经《鹤林玉露》第16卷"},"example":{"text":"～，前人所难。","book":"明·陈子龙《明诗选》"},"similar":["字斟句酌"],"usage":"作谓语、定语；指作文每一个字都要斟酌","story":["唐代两浙观察使高适过杭州清风岭题诗：“绝岭秋风已自凉，鹤翻松露湿衣裳。前村月落一江水，僧在翠微开竹房。”后来过清风岭时想把“一”字改为“半”字，和尚告诉他义乌骆宾王已早帮他把“一”字改为“半”字"]},{"id":351,"word":"一字不落","pinyin":"yī zì bù là","abbr":"yzbl","explanation":"落：丢下。指整篇文章都仔细逐字逐句地阅读或背诵。","source":{"text":"偶然两句吹到耳内，明明白白，一字不落，唱道是：‘原来姹紫嫣红开遍，似这般都付与断井颓垣。’","book":"清·曹雪芹《红楼梦》第23回"},"similar":["一字不差"],"usage":"作定语、状语；用于读书等"},{"id":352,"word":"一字不识","pinyin":"yī zì bù shí","abbr":"yzbs","explanation":"一个字也不认识。","source":{"text":"原来那字迹与他来书无异，一字不识，传与众官看了，无不骇然。","book":"清·褚人获《隋唐演义》第82回"},"example":{"text":"后来看看那书，装潢得极为盛丽，翻出来却～。","book":"曾朴《孽海花》第14回"},"similar":["目不识丁"],"opposite":["学富五车"],"usage":"作谓语、定语；指文盲"},{"id":353,"word":"一字之师","pinyin":"yī zì zhī shī","abbr":"yzzs","explanation":"改正一个字的老师。有些好诗文，经旁人改换一个字后更为完美，往往称改字的人为“一字师”或“一字之师”。","source":{"text":"郑谷改僧齐己《早梅》诗：‘数枝开’作‘一枝开’。齐己下拜，人以谷为一字师。","book":"宋·计有功《唐诗纪事》"},"similar":["一字师"],"usage":"作宾语；指改正一个字的老师","story":["唐朝江陵龙兴寺齐己和尚作《早梅》诗：“万木冻欲折，孤根暖独回。前村深雪里，昨夜数枝开。”他请袁州郑谷修改。郑谷建议为体现早春将“数枝”改为“一枝”，齐己觉得十分在理，就称郑谷为自己的“一字之师”"]},{"id":354,"word":"一字值千金","pinyin":"yī zì zhí qiān jīn","abbr":"yzzqj","explanation":"增损一字，赏予千金。称赞文辞精妙，不可更改。","source":{"text":"布咸阳市门，悬千金其上，延诸侯游士宾客有能增损一字者予千金。","book":"《史记·吕不韦列传》"},"example":{"text":"古人说～，我却值不上七两。","book":"清·魏子安《花月痕》第二十九回"},"similar":["一字千金"],"usage":"作定语、宾语；指文章或字写得好"},{"id":355,"word":"一字入公门","pinyin":"yī zì rù gōng mén","abbr":"yzrgm","explanation":"事情一旦告到官府，有案为凭，就无法挽回。告诫人们诉讼应慎重。","source":{"text":"一字入公门，九牛曳不出。","book":"宋·释普济《五灯会元》卷十七"},"example":{"text":"只这他自己的状上好些别脚，“～，九牛拔不出”哩。","book":"清·西周生《醒世姻缘传》第四十六回"}},{"id":356,"word":"一字兼金","pinyin":"yī zì jiān jīn","abbr":"yzjj","explanation":"形容文字极其珍贵。兼金，价值倍常的好金。","source":{"text":"苏、黄遗墨流传至今者，一字兼金。","book":"清·王士禛《香祖笔记》卷四"},"similar":["一字千金"],"usage":"作谓语、定语；用于书面语"},{"id":357,"word":"一字千秋","pinyin":"yī zì qiān qiū","abbr":"yzqq","explanation":"指文字警辟，足垂久远。","source":{"text":"夫诗以一字千秋者也，史以千秋一字者也。","book":"明·胡应麟《少室山房笔丛·史书佔毕一》"},"usage":"作宾语、定语；用于书面语"},{"id":358,"word":"一字千金","pinyin":"yī zì qiān jīn","abbr":"yzqj","explanation":"增损一字，赏予千金。称赞文辞精妙，不可更改。","source":{"text":"布咸阳市门，悬千金其上，延诸侯游士宾客有能增损一字者予千金。","book":"《史记·吕不韦列传》"},"example":{"text":"文温以丽，意悲而远，惊心动魄，可谓几乎～","book":"南朝梁·钟嵘《诗品》卷上"},"similar":["一字千钧","一字一珠","字字珠玑"],"opposite":["一文不值"],"usage":"作定语、宾语；指文章或字写得好","story":["战国时期，秦王嬴政年幼继位，由相国吕不韦辅政，为了笼络人心，增强实力，吕不韦组织人编写《吕氏春秋》，并把这一部10多万字的书挂在咸阳的门市上，宣布谁能指出书中不足，增加或删除其中一字者，赏给千金"]},{"id":359,"word":"一字千钧","pinyin":"yī zì qiān jūn","abbr":"yzqj","explanation":"钧：古代重量单位，1钧＝30斤。形容文字有份量。","source":{"text":"文温以丽，意悲而远，惊心动魄，可谓几乎一字千金。","book":"南朝·梁·钟嵘《诗品·古诗》"},"example":{"text":"不要小看文字的威力，往往～，价值连城。"},"similar":["一字千金","字字千钧"],"usage":"作宾语、定语、分句；指文字有分量"},{"id":360,"word":"一字师","pinyin":"yī zì shī","abbr":"yzs","explanation":"指订正一字之误读，即可为师。亦指更换诗文中一、二字的老师。","source":{"text":"五代·王定宝《唐摭言·切磋》载李相读《春秋》，叔孙婼之“婼”应读“敕略切”，李误为“敕晷切”，小吏言之，公大惭愧，“命小吏受北面之礼，号曰‘一字师’”。"},"example":{"text":"姐姐真是‘～’了！从此只叫你师傅，再不叫姐姐了。","book":"清·曹雪芹《红楼梦》第十八回"},"similar":["一字之师"],"usage":"作宾语；指改正一个字的老师","story":["元朝时期，萨天锡送濬天渊入朝，有“地湿厌闻天竺雨，月明来听景阳钟”之句，很多人都夸好，只有山东一个老叟认为应将“闻”改为“看”，萨天锡问为什么要这样改，老叟说：“唐人有林下老僧来看雨。”萨天锡俯首拜他为“一字师”"]},{"id":361,"word":"一字百炼","pinyin":"yī zì bǎi liàn","abbr":"yzbl","explanation":"百炼：上百次的锤炼。形容写作时在文字上反复推敲。","source":{"text":"百锻为字，千炼成句。","book":"唐·皮日休《刘枣强碑》"},"example":{"text":"玄晖含英咀华，～乃出，如秋山清晓，霏蓝翕黛之中，时有爽气。","book":"清·田雯《古欢堂杂著》卷二"}},{"id":362,"word":"一字百金","pinyin":"yī zì bǎi jīn","abbr":"yzbj","explanation":"增损一字，赏予百金。称赞文辞精妙，不可更改。","source":{"text":"布咸阳市门，悬千金其上，延诸侯游士宾客有能增损一字者予千金。","book":"《史记·吕不韦列传》"}},{"id":363,"word":"一字褒贬","pinyin":"yī zì bāo biǎn","abbr":"yzbb","explanation":"褒：赞扬，夸奖；贬：给予不好的评价。一个字的褒扬或贬斥。泛指记事论人，用字措辞严谨有分寸。","source":{"text":"春秋虽以一字为褒贬，然皆须数句以成言。","book":"晋·杜预《春秋经传集解·序》"},"example":{"text":"又不得效薄技于前，以希一字之褒贬。","book":"唐·柳宗元《上扬州李吉甫相公献所著文启》"},"usage":"作宾语、定语；指作文用字措辞严谨有分寸","story":["春秋时期，孔子根据鲁史编撰编年体史书《春秋》，起于鲁隐公元年，止于鲁哀公14年共242年。《春秋》用笔严谨，褒则称字，贬则称名，其引文用笔，常用一字寓意褒贬。晋代杜预《春秋经传集解序》：“《春秋》虽以一字为褒贬，然皆须数句以成言。"]},{"id":364,"word":"一字见心","pinyin":"yī zì jiàn xīn","abbr":"yzjx","explanation":"看到一个字就能看到人的思想。形容书法艺术能体现出人的个性。","source":{"text":"文则数言乃成其意，书则一字已见其心。","book":"唐·张怀瓘《文字论》"}},{"id":365,"word":"一字连城","pinyin":"yī zì lián chéng","abbr":"yzlc","explanation":"极言文辞的精妙。","source":{"text":"黄门侍郎崔光读暮春群臣应诏诗。至勰诗，高祖仍为之改一字……勰曰：‘臣闻《诗》三百，一言可蔽。今陛下赐刊一字，足以价等连城。’","book":"《魏书·彭城王勰传》"},"similar":["一字千金"],"usage":"作谓语、定语；极言文辞的精妙"},{"id":366,"word":"一字长城","pinyin":"yī zì cháng chéng","abbr":"yzcc","explanation":"排列成一长条的阵势。也指一言奏效，可比长城。","source":{"text":"仗恩台一字长城，借寒儒八面威风。","book":"明·汤显祖《牡丹亭·折寇》"},"usage":"作宾语；指一言奏效"},{"id":367,"word":"一字长蛇阵","pinyin":"yī zì cháng shé zhèn","abbr":"yzcsz","explanation":"排列成一长条的阵势。形容排列成一长条的人或物。","source":{"text":"张飞云：‘哥哥，是个什么阵？’关羽云：‘兄弟，唤作一字长蛇阵。’","book":"元·无名氏《千里独行》楔子"},"example":{"text":"老舍《神拳》：“拿东交民巷来说，官兵～拉开，密密层层，占满了长安街。”"},"usage":"作宾语、定语、状语；指排列的人或物"},{"id":368,"word":"一官半职","pinyin":"yī guān bàn zhí","abbr":"ygbz","explanation":"泛指官职。","source":{"text":"都则为一官半职，阻隔千山万水。","book":"元·王实甫《西厢记》第四本第四折"},"example":{"text":"我看令侄人材出众，兵法甚熟，意欲提拔他做～。","book":"清·无名氏《说唐》第四本第四折"},"similar":["大官小吏","有职有权"],"opposite":["黎民百姓","父老兄弟"],"usage":"作宾语、定语；泛指官职"},{"id":369,"word":"一定不易","pinyin":"yī dìng bù yì","abbr":"ydby","explanation":"易：改变。原指一定下来就不变更，后形容事理正确，不可改变。","source":{"text":"今夫权衡规矩，一定而不易，不为秦楚变节，不为胡越改容。","book":"《淮南子·主术训》"},"example":{"text":"然究竟半个明的，半个暗的，是～的道理。","book":"清·刘鹗《老残游记》第十回"},"similar":["一成不变","一定不移"],"usage":"作谓语、定语；指不可改变"},{"id":370,"word":"一定不移","pinyin":"yī dìng bù yí","abbr":"ydby","explanation":"原指一定下来就不变更，后形容事理正确，不可改变。同“一定不易”。","source":{"text":"至于填词一道，则句之长短，字之多寡，声之平、上、去、入，韵之清浊阴阳，皆有一定不移之格。","book":"清·李渔《闲情偶寄·词曲·音律》"},"example":{"text":"然究竟半个明的，半个暗的，是～的道理。","book":"清·刘鹗《老残游记》第十回"},"similar":["一定不易"],"usage":"作谓语、定语；指不可改变"},{"id":371,"word":"一定之法","pinyin":"yī dìng zhī fǎ","abbr":"ydzf","explanation":"一定：固定不变。一经确定下来就不再改变的法规。","source":{"text":"何况乎君数易世，国数易君，人以其位达其好憎，以其威势供嗜欲，而欲以一行之礼，一定之法，应时偶变，其所不能中权亦明矣。","book":"《淮南子·氾论训》"},"example":{"text":"如轻重可以就喜怒之情，则例不得为～。","book":"《明史·吕坤传》"}},{"id":372,"word":"一定之规","pinyin":"yī dìng zhī guī","abbr":"ydzg","explanation":"一定的规律或规则。比喻已打定的主意。","source":{"text":"古今一定之规，孰敢毫厘之谮。","book":"明·赵弼《繁邑古祠对》"},"example":{"text":"历史的发展，有它新陈代谢的～。","book":"郭小川《新路歌》"},"usage":"作宾语；指一定的规律或规则"},{"id":373,"word":"一定之计","pinyin":"yī dìng zhī jì","abbr":"ydzj","explanation":"计：主意，打算。已经拿定的主意。","source":{"text":"于始见之计，图事揆策，必有一定之计，据以为决。","book":"宋·洪迈《容斋续笔》卷三"}},{"id":374,"word":"一定之论","pinyin":"yī dìng zhī lùn","abbr":"ydzl","explanation":"已经确定下来不可更改的论断。","source":{"text":"士有一定之论，女有不易之行。","book":"《淮南子·原道训》"},"example":{"text":"比来议事之臣，鲜有～，盖以内无所守，故临事而惑，致有中失，朕将何赖？","book":"《金史·夹谷衡传》"}},{"id":375,"word":"一客不烦两家","pinyin":"yī kè bù fán liǎng jiā","abbr":"ykbflj","explanation":"一位客人不用劳烦两家接待。比喻一件事情由一个人全部承担，不用找别人帮忙。","source":{"text":"一鹤不栖双木，一客不烦两家。","book":"宋·释惟白《续传灯录》卷二十八"},"similar":["一客不烦二主","一客不犯二主"],"usage":"作宾语、定语；指由一个人全部承担"},{"id":376,"word":"一客不烦二主","pinyin":"yī kè bù fán èr zhǔ","abbr":"ykbfez","explanation":"一位客人不用劳烦两位主人接待。比喻一件事情由一个人全部承担，不用找别人帮忙。","source":{"text":"一鹤不栖双木，一客不烦两家。","book":"宋·释惟白《续传灯录·堂远禅师》"},"example":{"text":"事要恰好，话要凑巧，冰梅也腹痛起来。这宋婆生意发财，～。（清·李绿园《歧路灯》第二十七回）"},"similar":["一客不烦两家","一客不犯二主"],"usage":"作谓语、宾语、分句；指由一个人全部承担","story":["传说孙悟空到东海龙宫里找武器，龙王送他很多兵器，他都没看上，偏偏看中13500斤的定海神针。他把它变成绣花针塞入耳朵内，有了这如意金箍棒后没有盔甲，就说一客不烦二主，硬逼老龙王把其他三位龙王叫来，把他们的宝贝拿来做盔甲"]},{"id":377,"word":"一客不犯二主","pinyin":"yī kè bù fàn èr zhǔ","abbr":"ykbfez","explanation":"比喻一件事情由一个人全部承担，不用麻烦第二人。","source":{"text":"一鹤不栖双木，一客不烦两家。","book":"宋·释惟白《续传灯录》卷二十八"},"example":{"text":"悟空道：“～。若没有，我也定不出此门。”","book":"明·吴承恩《西游记》第三回"},"similar":["一客不烦两家","一客不烦二主"],"usage":"作宾语、定语；指由一个人全部承担"},{"id":378,"word":"一室生春","pinyin":"yī shì shēng chūn","abbr":"yssc","explanation":"整个房间里充满了愉快欢乐的气氛。","example":{"text":"我们的会议室真是～、欢歌笑语。"},"similar":["蓬荜生辉"],"usage":"作谓语、宾语；用于谦虚"},{"id":379,"word":"一家一火","pinyin":"yī jiā yī huǒ","abbr":"yjyh","explanation":"指所有家当什物。","source":{"text":"王媪嫁了马周，把自己一家一火，都搬到马家来了。","book":"明·冯梦龙《古今小说》第五卷"},"usage":"作宾语、定语；用于书面语"},{"id":380,"word":"一家一计","pinyin":"yī jiā yī jì","abbr":"yjyj","explanation":"指一夫一妻的家庭生活或财产。亦引申为一家人。","source":{"text":"别人怎生替得，寿数非于今世。相守三朝五夕，说甚一家一计。","book":"元·关汉卿《窦娥冤》第二折"},"example":{"text":"将来把你嫂子也从京里接到南京来，和兄弟～的过日子。","book":"《儒林外史》第二七回"},"similar":["一夫一妻"],"usage":"作宾语、定语；指一夫一妻的家庭"},{"id":381,"word":"一家之主","pinyin":"yī jiā zhī zhǔ","abbr":"yjzz","explanation":"家庭的当家人。","source":{"text":"秦重道：‘妈妈是一家之主，有甚烦难？’","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"我就是～。"},"similar":["一家之长"],"usage":"作主语、宾语、定语；指家庭的当家人"},{"id":382,"word":"一家之作","pinyin":"yī jiā zhī zuò","abbr":"yjzz","explanation":"自成一家的著作。","source":{"text":"不得志，乃删众家《后汉书》为一家之作。","book":"《宋书·范晔传》"},"usage":"作宾语；指独特的著作"},{"id":383,"word":"一家之学","pinyin":"yī jiā zhī xué","abbr":"yjzx","explanation":"自成一家的学派。","source":{"text":"司马迁著书成一家之言。","book":"汉·司马迁《报任少卿书》：“亦欲以究天人之际，通古今之变，成一家之言。”汉·班固《典引》"},"example":{"text":"自梁以来，始以其当时所行傅于《周官》五礼之名，各立～。","book":"《新唐书·礼乐志一》卷十一"},"usage":"作宾语；用于书面语"},{"id":384,"word":"一家之言","pinyin":"yī jiā zhī yán","abbr":"yjzy","explanation":"指有独特见解自成体系的论著。","source":{"text":"欲以究天人之际，通古今之变，成一家之言。","book":"西汉·司马迁《报任少卿书》"},"example":{"text":"皆当补译，以成～。","book":"梁启超《论译书》"},"similar":["一家之辞","一家之论","一家之说"],"usage":"作宾语；指有独特见解","story":["西汉时期，史学家司马迁走南闯北，收集各种史学资料，用近20年时间撰写出52万余字的《史记》。他始终保持严谨的态度，按事实撰写历史，以自己的独特的见解评价历史人物，他对好友任安说：“欲以究天人之际，通古今之变，成一家之言。”"]},{"id":385,"word":"一家之计","pinyin":"yī jiā zhī jì","abbr":"yjzj","explanation":"指一夫一妻的家庭。","source":{"text":"人命关天地，别人怎生替得？寿数非于今世，相守三朝五夕，说甚一家一计。","book":"元·关汉卿《窦娥冤》第二折"}},{"id":386,"word":"一家之论","pinyin":"yī jiā zhī lùn","abbr":"yjzl","explanation":"指有独特见解自成体系的论著。","source":{"text":"亦欲以究天人之际，通古今之变，成一家之言。","book":"汉·司马迁《报任少卿书》"},"similar":["一家之辞","一家之说","一家之言"],"usage":"作宾语；指有独特见解"},{"id":387,"word":"一家之说","pinyin":"yī jiā zhī shuō","abbr":"yjzs","explanation":"指有独特见解自成体系的论著。","source":{"text":"亦欲以究天人之际，通古今之变，成一家之言。","book":"汉·司马迁《报任少卿书》"},"similar":["一家之论","一家之言","一家之辞"],"usage":"作宾语；指有独特见解"},{"id":388,"word":"一家之辞","pinyin":"yī jiā zhī cí","abbr":"yjzc","explanation":"指有独特见解自成体系的论著。同“一家之言”。","source":{"text":"观《老子》之书，虽博有所经，而云‘有生于无’，以虚为主，偏立一家之辞，岂有以而然哉！","book":"《晋书·裴頠传》"},"similar":["一家之言","一家之论","一家之说"],"usage":"作宾语；指有独特见解"},{"id":389,"word":"一家之长","pinyin":"yī jiā zhī zhǎng","abbr":"yjzz","explanation":"家庭的当家人。","example":{"text":"我们不可轻看～的威力。"},"similar":["一家之主"],"usage":"作宾语、定语；指家庭的当家人"},{"id":390,"word":"一家无二","pinyin":"yī jiā wú èr","abbr":"yjwe","explanation":"指一家之人没有两样。","source":{"text":"这个女孩儿，也是有缘，我认了做义女，她自到我家来，倒也亲热，一家无二。","book":"元·杨显之《潇湘雨》第一折"},"similar":["亲密无间"],"usage":"作定语、状语；用于书面语"},{"id":391,"word":"一家眷属","pinyin":"yī jiā juàn shǔ","abbr":"yjjs","explanation":"眷属：家属，亲属。比喻出于同一流派。","source":{"text":"《孔庙》、《曹全》是一家眷属，皆以风神逸宕胜。","book":"清·康有为《广艺双楫·本汉》"},"usage":"作宾语、定语；比喻出于同一流派"},{"id":392,"word":"一家老小","pinyin":"yī jiā lǎo xiǎo","abbr":"yjlx","explanation":"指全家人。","source":{"text":"你若无事退回，我自养你一家老小，如要原钱还府，也是我出。","book":"明·罗贯中《三国演义》第十回：“当日接了书信，便与弟曹德及一家老小四十余人，带从者百余人，车百余辆，径望兖州而来。”明·冯梦龙《警世通言》第七卷"},"example":{"text":"你问我借盘缠，我一天杀一个猪，还赚不到钱把银子，都给你去丢在水里，叫我～喝西北风？","book":"清·吴敬梓《儒林外史》第三回"}},{"id":393,"word":"一寒如此","pinyin":"yī hán rú cǐ","abbr":"yhrc","explanation":"一：竟然；寒：贫寒。竟然穷困到这样的地步。形容贫困潦倒到极点。","source":{"text":"须贾意哀之，留与坐饮食，曰：‘范叔一寒如此哉！’乃取一绨袍以赐之。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"赖是同乡复同味，～遽春还。","book":"元·方回《次韵许大初见赠》诗"},"similar":["贫困潦倒"],"usage":"作谓语；指人贫寒","story":["范雎随魏国中大夫须贾出使齐国，须贾怀疑他通齐，回国后报告魏相。范雎含冤被打伤，改名张禄逃到秦国当上宰相。须贾出使秦国，范雎扮作穷人去见他。须贾见他一寒如此送他绨袍，待发现他是秦相时吓得一再谢罪。范雎没有杀他"]},{"id":394,"word":"一寸丹心","pinyin":"yī cùn dān xīn","abbr":"ycdx","explanation":"丹心：赤心，忠贞的心。一片赤诚的心。","source":{"text":"白发千茎雪，丹心一寸灰。","book":"唐·杜甫《郑附马池台喜遇郑广文同饮》诗"},"example":{"text":"向来百炼今绕指，～白日明。","book":"宋·杨万里《新徐广东常平之节感恩书怀》诗"},"similar":["赤子之心","赤胆忠心"],"opposite":["奴颜媚骨","狼心狗肺"],"usage":"作定语、宾语；指一片赤诚的心"},{"id":395,"word":"一寸光阴一寸金","pinyin":"yī cùn guāng yīn yī cùn jīn","abbr":"ycgyycj","explanation":"一寸光阴和一寸长的黄金一样昂贵。比喻时间十分宝贵。","source":{"text":"读书不觉已春深，一寸光阴一寸金。","book":"《淮南子·原道训》：“故圣人不贵尺之璧而重寸之阴，时难得而易失也。”唐·王贞白《白鹿洞二首》"},"example":{"text":"～，持将此物寄知音。（元·史樟《庄周梦》第二折）"},"similar":["一刻千金"],"opposite":["蹉跎岁月","光阴似箭"],"usage":"作主语、宾语、分句；形容时间宝贵"},{"id":396,"word":"一寸同心缕","pinyin":"yī cùn tóng xīn lǚ","abbr":"yctxl","explanation":"指结线袋子。比喻夫妻和谐。","source":{"text":"交丝结龙凤，镂彩结云霞。一寸同心缕，千年长命花。","book":"北周·庾信《题结线袋子》"}},{"id":397,"word":"一寸山河一寸金","pinyin":"yī cùn shān hé yī cùn jīn","abbr":"ycshycj","explanation":"面积一寸的国土跟寸金的价值一样昂贵。形容领土极其宝贵。","source":{"text":"君王莫听捐燕议，一寸山河一寸金。","book":"《金史·左企弓传》"},"example":{"text":"只因这时辽相左企弓以诗献金主，其末句云：“君王莫听捐燕议，～。”金主细思，忿然作色。","book":"清·陈忱《水浒后传》第十五回"}},{"id":398,"word":"一寸赤心","pinyin":"yī cùn chì xīn","abbr":"yccx","explanation":"一片赤诚的心。同“一寸丹心”。","source":{"text":"飞霜掠面寒压指，一存赤心惟报国。","book":"宋·陆游《江北庄取米到作饭香甚有感》诗"},"similar":["一寸丹心"],"usage":"作主语、定语、宾语；用于书面语"},{"id":399,"word":"一射之地","pinyin":"yī shè zhī dì","abbr":"yszd","explanation":"一箭所能达到的距离，约当一百二十至一百五十步。","source":{"text":"将军若要做女婿呵，可按甲束兵，退一射之地。","book":"元·王实甫《西厢记》第二本第二折"},"example":{"text":"谁知自娶了他令夫人之后，倒上下无一人不称颂他夫人的，琏爷倒退了～。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["一箭之遥","一箭之地"],"usage":"作宾语；用于书面语"},{"id":400,"word":"一将功成万骨枯","pinyin":"yī jiàng gōng chéng wàn gǔ kū","abbr":"yjgcwgk","explanation":"一个将帅的成功是靠牺牲成千上万人的生命换来的。","source":{"text":"泽国江山入战图，生民何计乐樵苏。凭君莫话封侯事，一将功成万骨枯。","book":"唐·曹松《己亥岁二首》其一"},"example":{"text":"自古道：“～。”诚有此言也。","book":"明·施耐庵《水浒全传》第五十五回"},"similar":["一将成功万骨枯"],"usage":"作宾语、定语；用于书面语"},{"id":401,"word":"一将成功万骨枯","pinyin":"yī jiàng chéng gōng wàn gǔ kū","abbr":"yjcgwgk","explanation":"指一个将帅功成名就要以上万人的死亡为代价","source":{"text":"一将成功万骨枯，手提髑髅血模糊。","book":"洪楝园《后南柯·甲阵》"},"similar":["一将功成万骨枯"],"usage":"作宾语、定语；用于书面语"},{"id":402,"word":"一小撮","pinyin":"yī xiǎo cuō","abbr":"yxc","explanation":"撮：容量单位，1升＝1000撮。很少的数量。","source":{"text":"一小撮死硬派不要几天就会从宝塔尖上跌下去，一个人民的中国就要出现了。","book":"毛泽东《国民党反动派由“呼吁和平”变为呼吁战争》"},"example":{"text":"我们必须揪出那～坏人。"},"usage":"作宾语、定语；指少量"},{"id":403,"word":"一尘不倒","pinyin":"yī chén bù dǎo","abbr":"ycbd","explanation":"原指佛教徒修行时，排除物欲，保持心地洁净。现泛指丝毫不受坏习惯，坏风气的影响。也用来形容非常清洁、干净。","source":{"text":"一尘不染香到骨，姑射仙人风露身。","book":"唐·田颖《揽云台记》：“花朝月夕，独自爽怀，一尘不染，万念胥空。”宋·张耒《腊月小雪后圃梅开》"}},{"id":404,"word":"一尘不到","pinyin":"yī chén bù dào","abbr":"ycbd","explanation":"形容清净纯洁。","source":{"text":"一尘不到心源净，万有俱空眼界清。","book":"唐·唐彦谦《游清凉寺》诗"},"example":{"text":"其夏色也，南薰解箨，丹凤来仪……若～之际，万事脱羁之辰。","book":"明·方孝孺《友筠轩赋》"},"similar":["一尘不染"],"usage":"作宾语、定语；用于书面语"},{"id":405,"word":"一尘不受","pinyin":"yī chén bù shòu","abbr":"ycbs","explanation":"原指佛教徒修行时，排除物欲，保持心地洁净。现泛指丝毫不受坏习惯，坏风气的影响。也用来形容非常清洁、干净。","source":{"text":"花朝月夕，独自爽怀，一尘不染，万念胥空。","book":"唐·田颖《揽云台记》"}},{"id":406,"word":"一尘不染","pinyin":"yī chén bù rǎn","abbr":"ycbr","explanation":"原指佛教徒修行时，排除物欲，保持心地洁净。现泛指丝毫不受坏习惯，坏风气的影响。也用来形容非常清洁、干净。","source":{"text":"一尘不染香到骨，姑射仙人风露身。","book":"唐·释道世《法苑珠林》：“若菩萨在乾土山中经行，土不著足，随岚风来，吹破土山，令散为尘，乃至一尘不著佛身。”宋·张耒《腊月小雪后圃梅开》"},"example":{"text":"特别是夏季，绿树红楼，～。","book":"臧克家《老舍永在》"},"similar":["一干二净","冰清玉洁"],"opposite":["贪得无厌","欲壑难填"],"usage":"作谓语、定语；用于人和环境","story":["佛教中有六尘即色、声、香、味、触、法。色即女色；声即歌舞；香即男女彼此契合；味即美味佳肴；触即顶撞；法即规范。佛门修道者必须要排除嗜欲，保持心地洁净，不被六尘所污染叫一尘不染"]},{"id":407,"word":"一尘不涉","pinyin":"yī chén bù shè","abbr":"ycbs","explanation":"原指佛教徒修行时，排除物欲，保持心地洁净。现泛指丝毫不受坏习惯，坏风气的影响。也用来形容非常清洁、干净。","source":{"text":"花朝月夕，独自爽怀，一尘不染，万念胥空。","book":"唐·田颖《揽云台记》"}},{"id":408,"word":"一尘不缁","pinyin":"yī chén bù zī","abbr":"ycbz","explanation":"犹一尘不染。泛指丝毫不受坏习惯，坏风气的影响。也用来形容非常清洁、干净。","source":{"text":"堂下种梅花数树，当霜雪严沍之际，众芳摇落，而是花独翘然，散而为春妍冰玉，其葩一尘不缁。","book":"明·宋濂《贞白堂记》"},"similar":["一尘不染"],"usage":"作宾语、定语；用于书面语"},{"id":409,"word":"一就手儿","pinyin":"yī jiù shǒu er","abbr":"yjse","explanation":"一就：顺便。指趁做某事之时捎带着做另一件事。","source":{"text":"索性劳你的驾，连灰带麻刀，一就手儿给买了来。","book":"清·文康《儿女英雄传》第三十二回"}},{"id":410,"word":"一尺之笔","pinyin":"yī chǐ zhī bǐ","abbr":"yczb","explanation":"借指文章。","source":{"text":"智能满胸之人，宜在王阙，须三寸之舌，一尺之笔，然后自动。","book":"汉·王充《论衡·效力》"}},{"id":411,"word":"一尺寒光","pinyin":"yī chǐ hán guāng","abbr":"ychg","explanation":"形容刀剑的光芒。","source":{"text":"轻冰薄玉状不分，一尺寒光堪决云。","book":"唐·卢纶《难绾刀子歌》"}},{"id":412,"word":"一尺水十丈波","pinyin":"yī chǐ shuǐ shí zhàng bō","abbr":"ycsszb","explanation":"一尺深的水掀起十丈高的波浪。比喻说话夸张，不真实。","source":{"text":"须知一尺水，日夜增高波。","book":"唐·孟郊《君子勿郁郁士有谤毁者作诗以赠之》之一"},"example":{"text":"可又来，到底还是媒人嘴，～的。","book":"明·兰陵笑笑生《金瓶梅词话》第八十九回"},"similar":["一尺水翻腾做百丈波"],"usage":"作定语、宾语、分句；指夸张"},{"id":413,"word":"一尺水翻腾做一丈波","pinyin":"yī chǐ shuǐ fān téng zuò yī zhàng bō","abbr":"ycsftzyzb","explanation":"比喻说话夸大之极。","source":{"text":"那妮子一尺水翻腾做一丈波，怎当他只留支剌信口开合。","book":"元·无名氏《争报恩》第三折"},"similar":["一尺水翻腾做百丈波"],"usage":"作定语、宾语、分句；指夸张"},{"id":414,"word":"一尺水翻腾做百丈波","pinyin":"yī chǐ shuǐ fān téng zuò bǎi zhàng bō","abbr":"ycsftzbzb","explanation":"比喻说话夸大之极。同“一尺水翻腾做一丈波”。","source":{"text":"你将那半句话搬调做十分事，一尺水翻腾做百丈波。","book":"元·王晔《桃花女》第二折"},"similar":["一尺水十丈波","一尺水翻腾做一丈"],"usage":"作定语、宾语、分句；指夸张"},{"id":415,"word":"一尺水，一丈波","pinyin":"yī chǐ shuǐ，yī zhàng bō","abbr":"ycsyzb","explanation":"一尺深的水掀起一丈高的波浪。比喻说话夸张，不真实。","source":{"text":"须知一尺水，日夜增高波。","book":"唐·孟郊《君子勿郁郁士有谤毁者作诗以赠之》之一"},"example":{"text":"一度兴一度废，～。","book":"元·朱庭玉《后庭花煞》"}},{"id":416,"word":"一尺水，百丈波","pinyin":"yī chǐ shuǐ，bǎi zhàng bō","abbr":"ycsbzb","explanation":"一尺深的水掀起百丈高的波浪。比喻说话夸张，不真实。","source":{"text":"须知一尺水，日夜增高波。","book":"唐·孟郊《君子勿郁郁士有谤毁者作诗以赠之》之一"},"example":{"text":"你将那半句话搬调做十分事，一尺水翻腾做百丈波，则你那口似悬河。","book":"元·王晔《桃花女破法嫁周公》第二折"}},{"id":417,"word":"一山不藏二虎","pinyin":"yī shān bù cáng èr hǔ","abbr":"ysbceh","explanation":"比喻两人不能相容。","source":{"text":"他跟展公有点一山不藏二虎的味道，这是他太狂妄。","book":"欧阳山《三家巷》"},"similar":["一山不容二虎"],"opposite":["和平共处"],"usage":"作定语、宾语；指不能相容"},{"id":418,"word":"一岁三迁","pinyin":"yī suì sān qiān","abbr":"yssq","explanation":"比喻官职升得极快。","source":{"text":"怀其旧德，至是一岁三迁。","book":"《南史·到儰传》"},"similar":["连升三级","一岁九迁"],"usage":"作谓语、定语；指升迁极速"},{"id":419,"word":"一岁九迁","pinyin":"yī suì jiǔ qiān","abbr":"ysjq","explanation":"岁：年；迁：官职升迁。一年之内升迁九次。比喻官职升得极快。","source":{"text":"虽日受千金之赐，一岁九迁其官，感恩则有之矣；将以称于天下曰知己，知己则未也。","book":"《南史·到撝传》：“上又数游撝家，怀其旧德，至是一岁三迁。”唐·韩愈《上张仆射书》"},"similar":["一日九迁"],"usage":"作宾语、定语；指升官很快"},{"id":420,"word":"一岁再赦","pinyin":"yī suì zài shè","abbr":"yszs","explanation":"一年之中再次赦罪。指赦免过滥。同“一岁载赦”。","source":{"text":"一岁再赦，善人喑哑。","book":"宋·范祖禹《唐鉴》卷三"},"example":{"text":"～，好人喑哑。","book":"《旧唐书·太宗纪上》"},"similar":["一岁载赦"],"usage":"作宾语、定语；用于书面语"},{"id":421,"word":"一岁载赦","pinyin":"yī suì zài shè","abbr":"yszs","explanation":"一年之中再次赦罪。指赦免过滥。亦作“一岁再赦”。","source":{"text":"谚曰：‘一岁载赦，奴儿噫嗟。’","book":"汉·王符《潜夫论·述赦》"},"similar":["一岁再赦"],"usage":"作宾语、定语；用于书面语"},{"id":422,"word":"一川风月","pinyin":"yī chuān fēng yuè","abbr":"ycfy","explanation":"川：山间平地。一片风景优美的天地。","source":{"text":"一川风月，满堤杨柳，今夜酒醒何处。调疏呵，双栖正稳，慢摇去橹。","book":"宋·杨无咎《永遇乐》词"},"example":{"text":"留取幽人卧空谷，～要人看。","book":"宋·朱熹《寄胡丈及刘恭父》"}},{"id":423,"word":"一差两讹","pinyin":"yī chà liǎng é","abbr":"ycle","explanation":"可能发生的意外或差错。同“一差二错”。","source":{"text":"如若不听我言语，逼迫女儿一差两讹，与你干休不得！","book":"明·冯梦龙《醒世恒言》第二十卷"},"similar":["一差二错","一差二误"],"usage":"作谓语、宾语；指可能发生的意外"},{"id":424,"word":"一差两误","pinyin":"yī chā liǎng wù","abbr":"yclw","explanation":"可能发生的意外或差错。","source":{"text":"若留在此，又恐一差两误，这尸首无处出脱，被地方晓得，弄出事来，性命不保。","book":"明·冯梦龙《醒世恒言》卷十五"}},{"id":425,"word":"一差二悮","pinyin":"yī chà èr wù","abbr":"ycew","explanation":"指意外的差错和失误。同“一差二误”。"},{"id":426,"word":"一差二误","pinyin":"yī chà èr wù","abbr":"ycew","explanation":"指意外的差错和失误。","source":{"text":"罢，罢，我两口也老了，管你不得，只怕有些一差二误，被人耻笑。","book":"《京本通俗小说·快嘴李翠莲记》"},"example":{"text":"一个脾气大，一个不懂事，若是有了～，没把我这老婆子骂死了哩！","book":"沙汀《兽道》"},"similar":["一差二错","一差二讹"],"usage":"作宾语；指可能发生的意外"},{"id":427,"word":"一差二错","pinyin":"yī chà èr cuò","abbr":"ycec","explanation":"可能发生的意外或差错。","source":{"text":"孩子也大了，倘或你父亲有个一差二错，又耽搁住了，或者有个门当户对的来说亲。","book":"清·曹雪芹《红楼梦》第117回"},"example":{"text":"只怕～，对不起在外抗日的儿子。","book":"孙犁《白洋淀纪事·嘱咐》"},"similar":["阴差阳错","一差二讹","一差二误"],"usage":"作宾语；指可能发生的意外"},{"id":428,"word":"一差半错","pinyin":"yī chà bàn cuò","abbr":"ycbc","explanation":"指变故，差错。","source":{"text":"就是桂姐有些一差半错，不干小的事。","book":"明·兰陵笑笑生《金瓶梅词话》第七十二回"},"similar":["一差二误","一差二错"],"usage":"作宾语；指可能发生的意外"},{"id":429,"word":"一差百错","pinyin":"yī chā bǎi cuò","abbr":"ycbc","explanation":"可能发生的意外或差错。","source":{"text":"你实说便罢，不然，有一差二错，就在你这两个囚棍子身上。","book":"明·兰陵笑笑生《金瓶梅词话》第八十回"}},{"id":430,"word":"一己之私","pinyin":"yī jǐ zhī sī","abbr":"yjzs","explanation":"指个人的私心、私利。","source":{"text":"放乎一己之私，自为之而忘天下之治，忽欲退享此得乎？","book":"宋·李格非《书洛阳名园记后》"},"example":{"text":"上则扰乱政治，下则摇惑民心，皆由腐败官僚有意编造，以快～。","book":"章炳麟《致报界俱进会书》"},"similar":["一己之见"],"usage":"作宾语；指个人的看法"},{"id":431,"word":"一己之见","pinyin":"yī jǐ zhī jiàn","abbr":"yjzj","explanation":"指一个人的意见。","source":{"text":"近时曾公端伯亦编皇宋百家诗选，去取任一己之见。","book":"宋·周煇《清波杂志》卷八"},"example":{"text":"永乐间，儒臣奉敕纂修考订，悉取其不悖本旨者，录之天下。习学已久，洪谟乃以～纷更，不许行。","book":"明·沈德符《野获编·科场·减场解元》"},"similar":["一己之私"],"usage":"作宾语；指个人的看法"},{"id":432,"word":"一帆顺风","pinyin":"yī fān shùn fēng","abbr":"yfsf","explanation":"比喻非常顺利，没有任何阻碍。同“一帆风顺”。","source":{"text":"三只大船载了许多人马头领，却投穆太公庄上行，一帆顺风，早到岸边埠头。","book":"明·施耐庵《水浒传》第四十一回"},"similar":["一帆风顺"],"usage":"作谓语、定语、状语；用于书面语"},{"id":433,"word":"一帆风顺","pinyin":"yī fán fēng shùn","abbr":"yffs","explanation":"船挂着满帆顺风行驶。比喻非常顺利，没有任何阻碍。","source":{"text":"定知一日帆，使得千里风。","book":"唐·孟郊《送崔爽之湖南》"},"example":{"text":"栉霜沐露多劳顿，喜借得～。","book":"清·李渔《怜香伴·蹴居》"},"similar":["无往不利","一往无前","一路顺风"],"opposite":["一波三折","暴风骤雨","凶涛恶浪"],"usage":"作谓语、定语、宾语；指非常顺利"},{"id":434,"word":"一席之地","pinyin":"yī xí zhī dì","abbr":"yxzd","explanation":"放一个席位的地方。比喻应有的一个位置。","source":{"text":"妇人智识不远，有忤盛情，然贵妃久承恩顾，何惜宫中一席之地，使其京戮，安忍取辱于外哉！","book":"《旧唐书·后妃传上》"},"example":{"text":"那占着玻璃柜～的彩塑泥人，却比什么都吸引我。","book":"邓炬云《漫步南京路》"},"similar":["一隅之地","弹丸之地","立锥之地"],"opposite":["无边无际","海阔天空","漫无边际"],"usage":"作宾语；比喻应有的一个位置"},{"id":435,"word":"一干一方","pinyin":"yī gān yī fāng","abbr":"ygyf","explanation":"“干”与“千”、“方”与“万”字形相似，一干一方即一千一万的隐语。这是明代官场行贿的黑话。","source":{"text":"凡有干谒者，云馈一干，即一千之谓；云一方，即一万之谓。后渐增至几干几方。","book":"明·陈洪漠《继世纪闻》卷二"},"usage":"作宾语、定语；用于书面语"},{"id":436,"word":"一干二净","pinyin":"yī gān èr jìng","abbr":"ygej","explanation":"形容十分彻底，一点儿也不剩。","source":{"text":"他是‘一毛不拔’，我们是‘无毛不拔’，把他拔的一干二净，看他如何。","book":"清·李汝珍《镜花缘》第十回"},"example":{"text":"从前学过的一点天文学知识，长期不用，早忘得～。"},"similar":["一尘不染","窗明几净"],"opposite":["邋里邋遢","肮肮脏脏","乌烟瘴气"],"usage":"作定语、状语；形容十分彻底"},{"id":437,"word":"一干人犯","pinyin":"yī gān rén fàn","abbr":"ygrf","explanation":"指罪犯和有关的人。","source":{"text":"差两员相官带了仵作行人，监押杨志并众邻舍一干人犯，都来天汉州桥边登场检验了，迭成文案，众邻舍都出了供状，保放，随衙听候，当厅发落，将杨志于死囚牢里监守。","book":"明·施耐庵《水浒传》第十二回"},"example":{"text":"次早拘齐了～犯，投了文，随出了牌，第一起就是犯人晁源等一干人等，打了二梆，俱到了县前伺候。","book":"清·西周生《醒世姻缘传》第十回"},"usage":"作主语、宾语、定语；指罪犯和有关的人"},{"id":438,"word":"一年一回","pinyin":"yī nián yī huí","abbr":"ynyh","explanation":"指一年一次。","example":{"text":"这～的规矩不能破坏。"},"similar":["一年一度"],"usage":"作主语、状语；指一年一次"},{"id":439,"word":"一年一度","pinyin":"yī nián yī dù","abbr":"ynyd","explanation":"度：次。每年一次的意思。","source":{"text":"所嗟不及牛女星，一年一度得相见。","book":"唐·施肩吾《古别离二首》"},"example":{"text":"昔日繁华人羡我，～易蹉跎。","book":"明·凌濛初《二刻拍案惊奇·痴公子狠使噪脾钱》"},"similar":["一年一回"],"usage":"作主语、状语；指一年一次"},{"id":440,"word":"一年之计在于春","pinyin":"yī nián zhī jì zài yú chūn","abbr":"ynzjzyc","explanation":"要在一年（或一天）开始时多做并做好工作，为全年（或全天）的工作打好基础。","source":{"text":"一年之计在于春，一日之计在于晨。","book":"南朝·梁·萧统《纂要》"},"example":{"text":"俗话说：～，早作安排迎春耕。","book":"陈登科《风雷》第一部第31章"},"similar":["一日之计在于晨"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":441,"word":"一年到头","pinyin":"yī nián dào tóu","abbr":"yndt","explanation":"整年，从头到尾经过。","source":{"text":"我两个又是养家经纪人，一年到头，没几时住在家里。","book":"明·凌濛初《初刻拍案惊奇》第20卷"},"example":{"text":"她～都不回家。"},"similar":["一年四季"],"usage":"作宾语、状语；指整年"},{"id":442,"word":"一年半载","pinyin":"yī nián bàn zǎi","abbr":"ynbz","explanation":"一年半年。泛指一段时间。","source":{"text":"将军你且耐心到那里，不过一年半载，俺众将每必然保奏将军回来。","book":"元·杨梓《敬德不服老》"},"example":{"text":"若小弟侥幸，这回去就得个肥美地方，到任一年半载，那时带几百银子来帮衬他，倒不值甚么。","book":"清·吴敬梓《儒林外史》第二十回"},"similar":["三年五载"],"opposite":["千秋万代","万古千秋"],"usage":"作状语、宾语、定语；用于时间"},{"id":443,"word":"一年被蛇咬，三年怕草索","pinyin":"yī nián bèi shé yǎo，sān nián pà cǎo suǒ","abbr":"ynbsysnpcs","explanation":"比喻遭过一次挫折以后就变得胆小怕事。同“一年被蛇咬，十年怕井绳”。","source":{"text":"文若虚道：‘一年被蛇咬，三年怕草索。说到货物，我就没胆气了。只是守了这些银钱回去罢。’","book":"明·凌濛初《初刻拍案惊奇》卷一"},"similar":["一夜被蛇咬，十日怕麻绳"],"usage":"作宾语、定语、分句；用于处事"},{"id":444,"word":"一年被蛇咬，三年怕草绳","pinyin":"yī nián bèi shé yǎo，sān nián pà jǐng shéng","abbr":"ynbsysnpcs","explanation":"比喻在某件事情上吃过苦头，以后一碰到类似的事情就害怕。","source":{"text":"一年被蛇咬，三年怕草绳，说到货物，我就没有胆气了。","book":"明·凌濛初《初刻拍案惊奇·转运汉巧遇洞庭红》"},"example":{"text":"日出三竿，方敢出店。真是‘～’光景。","book":"清·李绿园《歧路灯》第73回"},"similar":["一年被蛇咬，十年怕草绳"],"usage":"作宾语、定语、分句；指心有余悸","story":["明成化年间，苏州倒运汉文若虚拿朋友送的一两银子买了几篓太湖橘子随商船航海，到了国外他一篓橘子卖了百两银子，朋友劝他买一些货物回去倒卖，他运气特别差惯了，就说：“一年被蛇咬，三年怕草绳，说到货物，我就没有胆气了。”"]},{"id":445,"word":"一年被蛇咬，十年怕井绳","pinyin":"yī nián bèi shé yǎo，shí nián pà jǐng shéng","abbr":"ynbsysnpjs","explanation":"比喻在某件事情上吃过苦头，以后一碰到类似的事情就害怕。","source":{"text":"一年被蛇咬，三年怕草绳，说到货物，我就没有胆气了。","book":"明·凌濛初《初刻拍案惊奇·转运汉巧遇洞庭红》"},"example":{"text":"～，他现在还心有余悸。"},"similar":["一朝被蛇咬，十年怕井绳"],"usage":"作宾语、定语、分句；指心有余悸","story":["明成化年间，苏州倒运汉文若虚拿朋友送的一两银子买了几篓太湖橘子随商船航海，到了国外他一篓橘子卖了百两银子，朋友劝他买一些货物回去倒卖，他运气特别差惯了，就说：“一年被蛇咬，三年怕草绳，说到货物，我就没有胆气了。”"]},{"id":446,"word":"一床两好","pinyin":"yī chuáng liǎng hǎo","abbr":"yclh","explanation":"比喻夫妇两人情投意合。","source":{"text":"毗陵有成郎中，宣和中为省官，貌不扬而多髭。再娶之夕岳母陋之，曰：‘我女菩萨乃嫁一麻胡！’命成作诗。成乃操笔大书云：‘一床两好世间无，好女如何得好夫，高卷珠帘明点烛，试教菩萨看麻胡。’","book":"宋·曾慥《高斋漫录》"},"similar":["一双两好"],"usage":"作主语、宾语、定语；指夫妻","story":["古代毗陵有一个成郎中，宣和中为省官，他其貌不扬而脸上有许多胡须。准备再娶时，岳母看不起他，嘻笑他说：“我女菩萨乃嫁一麻胡！”要他作诗，成郎中立即写道：“一床两好世间无，好女如何得好夫，高卷珠帘明点烛，试教菩萨看麻胡。”"]},{"id":447,"word":"一床锦被遮盖","pinyin":"yī chuáng jǐn bèi zhē gài","abbr":"ycjbzg","explanation":"比喻请求别人通融、庇护。","source":{"text":"寻常伏事太尉不周，今日乞做一床锦被遮盖。","book":"宋·周密《齐东野语·淮西之变》"},"example":{"text":"凡百事周全，～则个，别无多言。","book":"明·施耐庵《水浒传》第25回"},"usage":"作谓语；用于书面语"},{"id":448,"word":"一应俱全","pinyin":"yī yīng jù quán","abbr":"yyjq","explanation":"一应：一切；俱：都。一切齐全，应有尽有。","source":{"text":"笼屉里又盖着一屉馒头；那案子上调和作料一应俱全。","book":"清·文康《儿女英雄传》第九回"},"example":{"text":"临街三间是老张的杂货铺，上自鸦片，下至葱蒜，～。","book":"老舍《老张的哲学》一"},"similar":["面面俱到","应有尽有","包罗万象"],"opposite":["一无所有","一鳞半爪","空空如也"],"usage":"作谓语；用于书面语"},{"id":449,"word":"一度著蛇咬，怕见断井索","pinyin":"yī dù zhāo shé yǎo，pà jiàn duàn jǐng suǒ","abbr":"ydzsypjdjs","explanation":"一次被蛇咬了，看见井边断了的绳子也害怕。比喻在某事上吃了苦头，以后碰到类似的情况也会害怕","source":{"text":"赵州道：‘无意者如何？’师曰：‘一度著蛇咬，怕见断井索。’","book":"宋·释普济《五灯会元·龙门远禅师法嗣》"},"similar":["一朝被蛇咬，三年怕井绳"],"usage":"作宾语、定语、分句；用于处事"},{"id":450,"word":"一座尽倾","pinyin":"yī zuò jìn qīng","abbr":"yzjq","explanation":"座：在座的人。在座的人都很倾慕","source":{"text":"临邛令不敢尝食，自往迎相如。相如不得已，强住，一座尽倾。","book":"西汉·司马迁《史记·司马相如列传》"},"similar":["一坐尽倾"],"usage":"作谓语、状语；用于书面语"},{"id":451,"word":"一座尽惊","pinyin":"yī zuò jìn jīng","abbr":"yzjj","explanation":"座：指在座的人。在座的人都感到惊奇","source":{"text":"少君及言与人大夫游猎处，老人为儿时识其家处，一座尽惊。","book":"汉·荀悦《汉纪·武帝纪》"},"similar":["一座皆惊","一坐尽惊"],"usage":"作谓语、状语；指在座的人都感到惊奇"},{"id":452,"word":"一座皆惊","pinyin":"yī zuò jiē jīng","abbr":"yzjj","explanation":"在座的人都感到惊奇。","source":{"text":"粲至，年既幼弱，容状短小，一坐尽惊。","book":"《三国志·魏志·王粲传》"},"example":{"text":"顷之，长史诸贤来清言，客主有不通处，张乃遥于末坐判之，言约旨远，足畅彼我之怀，～。","book":"明·李贽《初潭集·君臣六》"},"similar":["满座皆惊","一座尽惊"],"usage":"作谓语、状语；指在座的人都感到惊奇"},{"id":453,"word":"一廉如水","pinyin":"yī lián rú shuǐ","abbr":"ylrs","explanation":"为官廉洁，如流水一样清洁。","source":{"text":"老爷自到任以来，一廉如水。百姓今喜高升，小老人具礼远送。","book":"元·柯丹丘《荆钗记·民戴》"},"example":{"text":"清·褚人获《隋唐演义》第25回：“倒是刘刺史先说起自己在齐州～，只吃得一口水。”"},"usage":"作谓语、定语；用于为人处事"},{"id":454,"word":"一式一样","pinyin":"yī shì yī yàng","abbr":"ysyy","explanation":"完全是一个式样。形容完全相同。","source":{"text":"佘道台见了这副神气，更觉得同花小红一式一样，毫无二致。","book":"清·李宝嘉《官场现形记》第二十九回"},"example":{"text":"因为探究和好奇，去年曾经去问上海的银楼，终于买了两面来，和我的几乎～，不过缀着的小东西有些增减。","book":"鲁迅《且介亭杂文末编我的第一个师父》"},"similar":["一模一样","毫无二致"],"opposite":["天差地别"],"usage":"作谓语、定语；指完全一样"},{"id":455,"word":"一弛一张","pinyin":"yī chí yī zhāng","abbr":"ycyz","explanation":"弛：放松弓弦。张：拉紧弓弦。古时常以比喻施政宽严相济；现多比喻生活、工作要合理安排，有松有紧，劳逸结合。同“一张一弛”。","source":{"text":"故张而不弛，文王不为。弛而不张，文王不行。一弛一张，文王以为当。","book":"汉·王充《论衡·儒增》"},"similar":["一张一弛"],"usage":"作宾语、定语；指治国或工作、学习等的技巧"},{"id":456,"word":"一张一弛","pinyin":"yī zhāng yī chí","abbr":"yzyc","explanation":"意思是宽严相结合，是文王武王治理国家的方法。现用来比喻生活的松紧和工作的劳逸要合理安排。","source":{"text":"张而不弛，文武弗能也；弛而不张，文武弗为也。一张一弛，文武之道也。","book":"《礼记·杂记下》"},"example":{"text":"学习和工作应该有节奏，～，有劳有逸，这样才能提高效率。"},"similar":["以逸待劳","休养生息"],"opposite":["严阵以待"],"usage":"作宾语、定语；指治国或工作、学习等的技巧","story":["周朝时期，民间有一个祭祀百神的“蜡”节日，孔子带弟子子贡去看热闹。子贡担心百姓只顾玩乐而会有危险。孔子给子贡解释道：“百姓成年累月在田间劳作，让他们放松一下，有张有驰，这是周文王与武王定下的规矩，这样便于更好地生产。”"]},{"id":457,"word":"一弹指间","pinyin":"yī tán zhǐ jiān","abbr":"ydzj","explanation":"原为佛教用语，佛教有“一弹指顷六十年刹那”之说。手指一弹的时间。比喻时间极短暂。","source":{"text":"若复有人于一弹指顷，能修行是般若波罗蜜多者，其所得福，倍胜于前。","book":"《般若波罗蜜经》卷二十一"},"example":{"text":"他没想到～便轻轻易易的杀毙三犬，对这九阳神功的威力不由得暗自心惊。","book":"金庸《倚天屠龙记》第十六回"}},{"id":458,"word":"一弹指顷","pinyin":"yī tán zhǐ qǐng","abbr":"ytzq","explanation":"顷：顷刻。原为佛教用语，佛教有“一弹指顷六十年刹那”之说。手指一弹的时间。比喻时间极短暂。","source":{"text":"何异浮生临老日，一弹指顷报恩仇。","book":"唐·白居易《禽虫十二章》诗"},"example":{"text":"奋然鼓楫，横冲白浪而行。～，已抵东岸。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录三》"},"similar":["转瞬之间"],"usage":"作定语；比喻时间极短暂"},{"id":459,"word":"一当两便","pinyin":"yī dāng liǎng biàn","abbr":"ydlb","explanation":"指一种适当的举动会带来两方面的好处或便当。","source":{"text":"你这趟来本来想要结交结交的，如今一当两便，岂不省事。","book":"清·李宝嘉《官场现形记》第二十五回"},"example":{"text":"况且我自从到任至今，也没有请过他们，今儿这局，岂不一当两便。","book":"清·李宝嘉《官场现形记》第四十五回"}},{"id":460,"word":"一彻万融","pinyin":"yī chè wàn róng","abbr":"ycwr","explanation":"犹言一通百通。一个主要的弄通了，其他的自然也都会弄通。","source":{"text":"人能得此常理，设使为医，则必能究性命之源；为巫，则必能极鬼神之情状，一彻万融，所谓因源而得委也。","book":"明·唐顺之《与裘剡溪推官书》"},"usage":"作谓语、定语；用于书面语"},{"id":461,"word":"一彼一此","pinyin":"yī bǐ yī cǐ","abbr":"ybyc","explanation":"一时那样，一时这样。指局势或情况等随时间变化而变化。","source":{"text":"疆场之邑，一彼一此，何常之有？","book":"《左传·昭公元年》"},"example":{"text":"魏兴之初，与蜀分隔，疆场之戎，～。","book":"蔡东藩《两晋演义》第十回"}},{"id":462,"word":"一往情深","pinyin":"yī wǎng qíng shēn","abbr":"ywqs","explanation":"指对人或对事物顷注了很深的感情，向往而不能克制。","source":{"text":"桓子野每闻清歌。辄唤奈何！谢公闻之曰：‘子野可谓一往有深情。’","book":"南朝宋·刘义庆《世说新语·任诞》"},"example":{"text":"～深几许？深山夕照深秋雨。","book":"清·纳兰性德《蝶恋花·出塞》词"},"similar":["深情厚意","情深意重","情意绵绵"],"opposite":["朝三暮四","朝秦暮楚"],"usage":"作谓语、宾语、定语、状语；指人对人或物","story":["东晋时期，永修县侯桓伊将军不仅善于用兵，对音乐也十分精通，他经常吹蔡邕的柯亭笛，十分动听。他听到别人唱歌时按捺不住自己的激动，喊道：“怎么办啊！”宰相谢安夸奖道：“子野可谓一往有深情。”"]},{"id":463,"word":"一往无前","pinyin":"yī wǎng wú qián","abbr":"ywwq","explanation":"一往：一直向前；无前：前面什么也挡不住。一直往前，无所阻挡。形容勇猛无畏地前进。","source":{"text":"曹变蛟遵臣指画，与北兵转战冲突，臣之步兵莫不一往无前。","book":"明·孙传庭《官兵苦战斩获疏》"},"example":{"text":"这个军队具有～的精神，它要压倒一切敌人，而决不被敌人所屈服。","book":"毛泽东《论联合政府》"},"similar":["勇往直前","所向披靡","所向无敌"],"opposite":["畏葸不前","裹足不前","畏首畏尾"],"usage":"作谓语、定语；指大无畏"},{"id":464,"word":"一往深情","pinyin":"yī wǎng shēn qíng","abbr":"ywsq","explanation":"一往：一直，始终。指寄情深远。","source":{"text":"桓子野每闻清歌。辄唤奈何！谢公闻之曰：‘子野可谓一往有深情。’","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"如果你真能了解了我对你的～，那我死了也心平气静。","book":"路遥《平凡的世界》第三部第四十八章"}},{"id":465,"word":"一往直前","pinyin":"yī wǎng zhí qián","abbr":"ywzq","explanation":"形容勇猛无畏地前进。同“一往无前”。","source":{"text":"其行事也，常鼓一往直前之气，而不虑其他。","book":"陶成章《浙案纪略》第四章第二节"},"example":{"text":"他们把互相的爱悦和义无返顾、～的心情发挥到了淋漓尽致的程度。","book":"欧阳山《三家巷》十三"},"similar":["一往无前"],"usage":"作谓语、定语；指大无畏"},{"id":466,"word":"一往而深","pinyin":"yī wǎng ér shēn","abbr":"ywes","explanation":"指对人或对事物顷注了很深的感情，向往而不能克制。同“一往情深”。","source":{"text":"情不知所起，一往而深，生者可以死，死者可以生。","book":"明·汤显祖《〈牡丹亭记〉题词》"},"example":{"text":"与知己交，绸缪缱绻，～，不以贫富易其念。","book":"清·珠泉居士《雪鸿小记·补遗》"},"similar":["一往情深"],"usage":"作谓语、定语、状语；指人对人或物"},{"id":467,"word":"一律千篇","pinyin":"yī lǜ qiān piān","abbr":"ylqp","explanation":"一律：同样的。一千篇文章都一个样。指文章、题材、写法公式化。泛指事物形式陈旧呆板。","source":{"text":"用事非诗正体，然景物有限，格调易穷，一律千篇，只供厌饫，欲观人笔力才诣，全在阿堵中。","book":"明·费经虞《雅论》"},"similar":["千篇一律"],"usage":"作谓语、宾语、状语；指一个模式"},{"id":468,"word":"一得两便","pinyin":"yī dé liǎng biàn","abbr":"ydlb","explanation":"指一种适当的举动会带来两方面的好处或便当。","source":{"text":"一则结了此案，二则捉住大伙强盗，又可官上加官，岂非一得而两便。","book":"清·张南庄《何典》第九回"},"example":{"text":"如今一得两便，他们又有了出路，自然再好没有了。","book":"清·李宝嘉《官场现形记》第四十九回"}},{"id":469,"word":"一得之功","pinyin":"yī dé zhī gōng","abbr":"ydzg","explanation":"一得：一点心得，一点收获；功：成绩。一点微小的成绩。","source":{"text":"广武君曰：‘臣闻智者千虑，必有一失；愚者千虑，必有一得。’","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"没有远大的前途，沾沾自喜于～和一孔之见。","book":"毛泽东《实践论》"},"similar":["一得之见","一得之愚","一孔之见"],"opposite":["丰功伟绩"],"usage":"作主语、宾语；用于自谦"},{"id":470,"word":"一得之愚","pinyin":"yī dé zhī yú","abbr":"ydzy","explanation":"指自己对某件事的一点看法。","source":{"text":"广武君曰：‘臣闻智者千虑，必有一失；愚者千虑，必有一得。’","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"倘不尽～，殆自放于国民之外。","book":"鲁迅《集外集拾遗·出世辞》"},"similar":["一得之功","一孔之见"],"usage":"作宾语；用于自谦","story":["楚汉相争时期，韩信活捉赵王歇后，同时活捉他的参谋李左车。韩信十分谦虚地向李左车求取燕齐之道。李左车建议他暂时休整，同时加强伐燕的舆论攻势，可以不战而胜。他说：“智者千虑，必有一失；愚者千虑，必有一得。这些仅供参考。”"]},{"id":471,"word":"一得之见","pinyin":"yī dé zhī jiàn","abbr":"ydzj","explanation":"见：见解。谦虚的说法，指自己对某个问题的见解。","source":{"text":"臣闻智者千虑，必有一失；愚者千虑，必有一得。","book":"《史记·淮阴侯列传》"},"example":{"text":"本书所谈的，不过是自己在学习和写作过程中的～，不一定很正确。","book":"秦牧《艺海拾贝·新版前记》"},"similar":["一孔之见","千虑一得","一得之功"],"opposite":["博学多才"],"usage":"作宾语；用于书面语"},{"id":472,"word":"一微尘","pinyin":"yī wēi chén","abbr":"ywc","explanation":"一小粒尘土。比喻极其微小的数量。","source":{"text":"应似诸天观下界，一微尘内斗英雄。","book":"唐·白居易《禽虫十二章》"},"example":{"text":"嗟得失，～。莫教冰炭损精神。北扉西禁须分等，金榜当年第一人。宋·张耒《鹧鸪天》词）"}},{"id":473,"word":"一德一心","pinyin":"yī dé yī xīn","abbr":"ydyx","explanation":"德：心意。大家一条心，为一个共同目标而努力。","source":{"text":"乃一德一心，立定厥功，惟克永世。","book":"《尚书·泰誓中》"},"example":{"text":"总要我们平民～，这却什么事情做不来！","book":"清·岭南羽衣女士《东欧女豪杰》第二回"},"similar":["同心同德"],"opposite":["离心离德"],"usage":"作谓语、定语；指同心同德","story":["商朝末年，纣王荒淫无道、暴虐成性。手下的官员都是离心离德，军心涣散。周武王联合西部的八个诸侯，集结4万兵力，亲自率军征讨纣王。在出发前的誓师会上，他发表演讲，表示上下要一心一德，不消灭纣王誓不罢休，不久商朝灭亡"]},{"id":474,"word":"一心一力","pinyin":"yī xīn yī lì","abbr":"yxyl","explanation":"犹同心协力。团结一致，共同努力。","source":{"text":"自阖营将弁，以及士卒，无不一心一力。","book":"清·魏源《圣武记》卷九"},"similar":["同心协力"],"usage":"作谓语、定语、状语；用于处事"},{"id":475,"word":"一心一德","pinyin":"yī xīn yī dé","abbr":"yxyd","explanation":"大家一条心，为一个共同目标而努力。","source":{"text":"乃一德一心，立定厥功，惟克永世。","book":"《尚书·泰誓中》"},"example":{"text":"共产党人～，忠实执行自己的宣言。","book":"毛泽东《反对日本进攻的方针、办法和前途》"},"similar":["同心同德"],"opposite":["离心离德"],"usage":"作定语、状语；同“同心同德”","story":["商朝末年，纣王荒淫无道、暴虐成性。手下的官员都是离心离德，军心涣散。周武王联合西部的八个诸侯，集结4万兵力，亲自率军渡过黄河征讨纣王。在出发前的誓师会上，他发表演讲《泰誓》，表示“乃一德一心，立定厥功，惟克永世。”"]},{"id":476,"word":"一心一意","pinyin":"yī xīn yī yì","abbr":"yxyy","explanation":"只有一个心眼儿，没有别的考虑。","source":{"text":"故推一心，任一意，直而行之耳。","book":"《三国志·魏志·杜恕传》：“免为庶人，徙章武郡，是岁嘉平元年。”裴松之注引《杜氏新书》"},"example":{"text":"所以彭官保便～的料理防守事宜，庄制军便～料理军需器械。","book":"清·张春帆《宦海》第四回"},"similar":["全心全意","真心实意","一心一意"],"opposite":["三心二意","心猿意马"],"usage":"作定语、状语；指专注某事"},{"id":477,"word":"一心一腹","pinyin":"yī xīn yī fù","abbr":"yxyf","explanation":"指一条心。","source":{"text":"你们那家里不论什么时候都是一心一腹的——也不论公公、婆婆、弟兄们、小姑子，忙起来大家忙，吃起来大家吃，穿起来大家穿，谁也不偏这个不为那个。","book":"赵树理《三里湾》十六"},"usage":"作定语、状语；用于书面语"},{"id":478,"word":"一心一计","pinyin":"yī xīn yī jì","abbr":"yxyj","explanation":"一个心眼，一样的想法。指与对方的想法尽量一致。","source":{"text":"故推一心，任一意，直而行之耳。","book":"《三国志·魏志·杜恕传》：“免为庶人，徙章武郡，是岁嘉平元年。”裴松之注引《杜氏新书》"},"example":{"text":"如今女婿接了养活，岂不愿望。遂～，帮着女儿女婿过活。","book":"清·曹雪芹《红楼梦》第六回"},"similar":["一心一意"],"opposite":["三心二意"],"usage":"作定语、状语；指十分专心"},{"id":479,"word":"一心一路","pinyin":"yī xīn yī lù","abbr":"yxyl","explanation":"犹一心一意。只有一个心眼儿，没有别的考虑。","source":{"text":"初相交，指望你一心一路；到如今，眼面上做工夫。","book":"明·冯梦龙《挂枝儿·多心》"},"similar":["一心一意"],"usage":"作谓语、定语、状语；用于书面语"},{"id":480,"word":"一心两用","pinyin":"yī xīn liǎng yòng","abbr":"yxly","explanation":"把注意力同时集中在两件事上。指思想不专一。","source":{"text":"若曰一面充扩，一面体认，则是一心而两用之，亦不胜其面且扰矣。","book":"宋·朱熹《答人》"}},{"id":481,"word":"一心为公","pinyin":"yī xīn wéi gōng","abbr":"yxwg","explanation":"一心：专心，全心全意。专心一意为公益着想。","example":{"text":"我～，却换得如此结局。"},"similar":["大公无私"],"opposite":["自私自利"],"usage":"作谓语、定语；指大公无私"},{"id":482,"word":"一心同体","pinyin":"yī xīn tóng tǐ","abbr":"yxtt","explanation":"犹言同心同德。指思想统一，信念一致。","source":{"text":"话说唐僧复得了孙行者，师徒们一心同体，共诣西方。","book":"明·吴承恩《西游记》第三十二回"},"similar":["同心同德"],"usage":"作谓语、状语；用于书面语"},{"id":483,"word":"一心同功","pinyin":"yī xīn tóng gōng","abbr":"yxtg","explanation":"同心协力，共赴事功。","source":{"text":"当此之时，秦中士卒，以军中为家，将帅为父母，不约而亲，不谋而信，一心同功，死不旋踵。","book":"《战国策·中山策》"},"similar":["一心同归"],"usage":"作谓语、定语、状语；用于书面语"},{"id":484,"word":"一心同归","pinyin":"yī xīn tóng guī","abbr":"yxtg","explanation":"齐心趋向同一目的。","source":{"text":"上唱而民和，上动而下随，四海之内，一心同归。","book":"《淮南子·泰族训》"},"similar":["一心同功"],"usage":"作谓语、定语、状语；用于书面语"},{"id":485,"word":"一心挂两头","pinyin":"yī xīn guà liǎng tóu","abbr":"yxglt","explanation":"对两方面都惦念着。","source":{"text":"媒婆，我去也不妨，只是一心挂两头，如何是好。","book":"明·高明《琵琶记·再报佳期》"},"similar":["心挂两头"],"usage":"作谓语、宾语、定语、状语；用于处事"},{"id":486,"word":"一心无二","pinyin":"yī xīn wú èr","abbr":"yxwe","explanation":"指一心一意地做某种事情，没有杂念。","source":{"text":"诸公为国家戮力守城，一心无二，经年乏食，忠义不衰。","book":"《旧唐书·张巡传》"},"example":{"text":"既～，偷功夫应付些了。","book":"元·无名氏《醉中天·咏鞋》"},"similar":["一心一意"],"usage":"作谓语、状语；用于处事"},{"id":487,"word":"一心百君","pinyin":"yī xīn bǎi jūn","abbr":"yxbj","explanation":"忠臣虽经历几个君主还是始终如一。","source":{"text":"一心可以事百君，三心不可以事一君。","book":"《晏子春秋·内篇·问下》"}},{"id":488,"word":"一念之差","pinyin":"yī niàn zhī chā","abbr":"ynzc","explanation":"念：念头、主意；差：错误。一个念头的差错（造成严重后果）。","source":{"text":"一念之误，乃至于此。","book":"宋·曾慥《类说》卷四十七引《遁斋闲览》"},"example":{"text":"世间孽子、孤臣、义夫、节妇，其贤不肖往往只在～。","book":"清·李汝珍《镜花缘》第九十回"},"similar":["一差二错","阴差阳错","差之毫厘"],"opposite":["千差万别"],"usage":"作主语、谓语、定语；指一个念头的差错"},{"id":489,"word":"一念之私","pinyin":"yī niàn zhī sī","abbr":"ynzs","explanation":"一个念头的私心。","source":{"text":"若未发之前，只一念之私，便不是仁。","book":"宋·朱熹《论语集注·雍也》"},"example":{"text":"阴曹不与人世等，～不可容。急消他念则火自熄。","book":"清·蒲松龄《聊斋志异·李伯言》"},"similar":["一念之差","一念之错","一念之误"],"usage":"作主语、宾语、定语；用于处事"},{"id":490,"word":"一念之误","pinyin":"yī niàn zhī wù","abbr":"ynzw","explanation":"一个念头的差错。同“一念之差”。","source":{"text":"此人前身为尼，诵《法华经》二十年，一念之误，乃至于此。","book":"宋·曾慥《类说》卷四十七引《遁斋闲览·口中芙蕖花香》"},"example":{"text":"但此～，而遂造出十九年之历史，与百二十回之事实，与茫茫大士、渺渺真人何与？","book":"王国维《红楼梦评论》第二章"},"similar":["一念之错","一念之差","一念之私"],"usage":"作主语、宾语、定语；用于处事"},{"id":491,"word":"一念之错","pinyin":"yī niàn zhī cuò","abbr":"ynzc","explanation":"念：念头、主意；错：错误。一个念头的差错。常指因此造成严重的后果。","source":{"text":"我亦诵经五千文，一念之差堕世纷。","book":"宋·曾慥《类说》卷四十七引《遁斋闲览》：“一念之误，乃至于此。”宋·陆游《丈人观》"},"example":{"text":"守其在我，听其在天，是或一道。所怕者，磨易磷，涅易缁，～，终身之悔耳！","book":"清·夏敬渠《野叟曝言》第四十八回"},"similar":["一念之差","一念之私","一念之误"],"usage":"作主语、宾语、定语；指一个念头的差错"},{"id":492,"word":"一念通天","pinyin":"yī niàn tōng tiān","abbr":"yntt","explanation":"只要一心一意去做，就可以通向最高的境界。","source":{"text":"勤精不退，一念通天。","book":"汉·魏伯阳《参同契》注"},"example":{"text":"混合百神归一，～彻地，方始了无为。","book":"宋·张继先《水调歌头》词"},"usage":"作宾语、定语；用于书面语"},{"id":493,"word":"一怀愁绪","pinyin":"yī huái chóu xù","abbr":"yhcx","explanation":"一怀：满怀，满腔。心里充满愁苦的情绪。","source":{"text":"东风恶，欢情薄。一怀愁绪，几年离索。","book":"宋·陆游《钗头凤》词"}},{"id":494,"word":"一息万变","pinyin":"yī xī wàn biàn","abbr":"yxwb","explanation":"息：呼吸。在极短的时间内就有很多变化。形容变化很多很快。","source":{"text":"清·李宝嘉《官场现形记》第十二回：“而且军情一息万变，不是可以捱时捱刻的事。"},"similar":["瞬息万变"],"usage":"作谓语、定语；用于书面语"},{"id":495,"word":"一息千里","pinyin":"yī xī qiān lǐ","abbr":"yxql","explanation":"一息：一口气儿，喘一口气的工夫。喘一口气的工夫就一千里路。形容速度极快。","source":{"text":"峡船一息且千里，五两竿头见旛尾。","book":"宋·范成大《韩无咎检详出示所赋……次韵和呈，以资抚掌》"}},{"id":496,"word":"一息奄奄","pinyin":"yī xī yǎn yǎn","abbr":"yxyy","explanation":"只有微弱的一口气。形容垂死之状。","source":{"text":"紫鹃等看去，只有一息奄奄，明知劝不过来， 惟有守着流泪。","book":"清·曹雪芹《红楼梦》第九七回"},"example":{"text":"久之黧黑耸两肩，眼垂泪，鼻出涕，～死相继。","book":"清·梁绍壬《两般秋雨庵随笔·潮州乐府》"},"similar":["奄奄一息"],"usage":"作谓语、定语、状语；指临近死亡"},{"id":497,"word":"一息尚在","pinyin":"yī xī shàng zài","abbr":"yxsz","explanation":"息：呼吸，气息；尚：还。还有一口气。指生命的最后阶段。","source":{"text":"一息尚存，此志不容少懈，可谓远矣。","book":"《论语·泰伯》：“死而后已，不亦远乎！”朱熹注"},"example":{"text":"老夫一息尚在，无不为区处。","book":"清·蒲松龄《聊斋志异·小梅》"}},{"id":498,"word":"一息尚存","pinyin":"yī xī shàng cún","abbr":"yxsc","explanation":"息：呼吸，气息；尚：还。还有一口气。指生命的最后阶段。","source":{"text":"一息尚存，此志不容少懈，可谓远矣。","book":"《论语·泰伯》：“死而后已，不亦远乎！”朱熹注"},"example":{"text":"我下定决心，象陈毅同志病中表现的那样，～，努力不懈！","book":"张茜《陈毅诗词选集·序言》"},"similar":["奄奄一息","气息奄奄"],"opposite":["寿终正寝"],"usage":"作谓语、定语；指还活着"},{"id":499,"word":"一恸几绝","pinyin":"yī tòng jī jué","abbr":"ytjj","explanation":"恸：极悲哀；几：几乎。一声痛哭，差一点闭过气骈。形容悲痛到了极点。","source":{"text":"郗嘉宾丧，左右白郗公：‘郎丧。’既闻不悲，因语左右：‘殡时可道。’公往临殡，一恸几绝。","book":"南朝·宋·刘义庆《世说新语·伤逝》"},"example":{"text":"姑娘问知老爷病中光景，～，教小的快回。","book":"清·魏子安《花月痕》第四十一回"}},{"id":500,"word":"一恸欲绝","pinyin":"yī tòng yù jué","abbr":"ytyj","explanation":"恸：极悲哀。一声痛哭，差一点闭过气骈。形容悲痛到了极点。","source":{"text":"郗嘉宾丧，左右白郗公：‘郎丧。’既闻不悲，因语左右：‘殡时可道。’公往临殡，一恸几绝。","book":"南朝·宋·刘义庆《世说新语·伤逝》"}},{"id":501,"word":"一悲一喜","pinyin":"yī bēi yī xǐ","abbr":"ybyx","explanation":"既悲伤又高兴。","source":{"text":"表公单单一身，不胜凄惨，且喜有了性命，又得了两件至宝，正所谓一悲一喜。","book":"《平妖传》二回"},"usage":"作宾语；用于书面语"},{"id":502,"word":"一惊非小","pinyin":"yī jīng fēi xiǎo","abbr":"yjfx","explanation":"惊：惊慌，惊恐；非：不。突然发生意外的严重情况，感到十分吃惊。","source":{"text":"他进城买豆子，听得这个消息，一惊非小，忙忙急急跑回家来告诉女儿一遍。","book":"明·罗贯中《粉妆楼》第九回"},"example":{"text":"灯笼灭了，包袱也不见了，这～。","book":"清·石玉昆《三侠五义》第五十六回"},"usage":"作谓语、状语；用于书面语"},{"id":503,"word":"一意孤行","pinyin":"yī yì gū xíng","abbr":"yygx","explanation":"指不接受别人的劝告，顽固地按照自己的主观想法去做。","source":{"text":"公卿相造请禹，禹终不报谢，务在绝知友宾客之请，孤立行一意而已。","book":"《史记·酷吏列传》"},"example":{"text":"皇上和杨文弱、高起潜虽有意与虏议和，但迫于臣民清议，尚不敢公然～，与虏订城下之盟。","book":"姚雪垠《李自成》第一卷第三章"},"similar":["自以为是","固执己见","死心塌地"],"opposite":["博采众长","虚怀若谷"],"usage":"作谓语、定语；形容顽固派","story":["西汉时期，汉武帝重用御史赵禹为太中大夫，与张汤共同制定国家法律，为了严格约束官吏，他制订“知罪不举发”和“官吏犯罪上下连坐”等法律。官员们纷纷带上厚礼去赵禹要求更改法律，赵禹则一意孤行把他们的礼物一一退回"]},{"id":504,"word":"一成一旅","pinyin":"yī chéng yī lǚ","abbr":"ycyl","explanation":"成：古时以方圆十里为一成；旅：古时以兵士五百人为一旅。形容地窄人少，力量单薄。","source":{"text":"有田一成，有众一旅，能布其德，而兆其谋，以收夏众，抚其官职。","book":"《左传·哀公元年》"},"example":{"text":"同川之甚，千钧系发，复得诸弟与松岑诸君，尽力持护，～，芽蘖在兹。","book":"章炳麟《致柳亚庐书》"},"usage":"作谓语、定语；指力量单薄","story":["春秋末期吴王夫差为给父亲报仇，出兵攻打越国，一直攻打到会稽。越王勾践无奈只好派大夫文种向吴王求和，夫差答应议和。但伍子胥坚决反对，说夏后相的遗腹子少康靠虞部拥有一成一旅，逐渐壮大，先后灭掉过国等，恢复了禹的霸业"]},{"id":505,"word":"一成不变","pinyin":"yī chéng bù biàn","abbr":"ycbb","explanation":"成：制定，形成。一经形成，不再改变。","source":{"text":"一成而不可变，故君子尽心焉。","book":"《礼记·王制》"},"example":{"text":"事物都是在发展的，世界上没有～的东西。"},"similar":["原封不动","一成不易"],"opposite":["千变万化","瞬息万变","变化莫测"],"usage":"作谓语、定语；指人守旧"},{"id":506,"word":"一成不易","pinyin":"yī chéng bù yì","abbr":"ycby","explanation":"一经形成，不再改变。同“一成不变”。","source":{"text":"夫天之行度多端，而人之智力有限……惟合古今人之心思，踵事增修，庶几符合。故不能为一成不易之法也。","book":"《明史·历志一》"},"example":{"text":"至于讲到丝的工业，从前发明的生产和制造方法都是很好的，但是～，总不知道改良。","book":"孙中山《民生主义》第四讲"},"similar":["一成不变"],"usage":"作谓语、定语；指人守旧"},{"id":507,"word":"一手一脚","pinyin":"yī shǒu yī jiǎo","abbr":"ysyj","explanation":"一个人的手足。指单薄的力量。同“一手一足”。","source":{"text":"我们的父亲死得很早，是我们的母亲把我们姐弟两人一手一脚抚养成人。","book":"郭沫若《棠棣之华》第五幕"},"similar":["一手一足"],"usage":"作宾语、定语、状语；指单薄的力量"},{"id":508,"word":"一手一足","pinyin":"yī shǒu yī zú","abbr":"ysyz","explanation":"一个人的手足。比喻力量单薄。","source":{"text":"后稷天下之为烈也，岂一手一足哉？","book":"《礼记·表记》"},"example":{"text":"其得此思想也，非一朝一夕所骤至，非～所幸成，或自外界刺激之，或自内界启牖之。","book":"清·梁启超《国家思想变迁异同论》"},"similar":["一手一脚","单枪匹马"],"opposite":["人多势众"],"usage":"作宾语、定语；指单薄的力量"},{"id":509,"word":"一手包办","pinyin":"yī shǒu bāo bàn","abbr":"ysbb","explanation":"一手：指一个人；包办：总揽一切，独自办理。指一人独揽，不让别人插手。","source":{"text":"你一手包揽，我只晴我的手头钱。","book":"清·李绿园《歧路灯》"},"example":{"text":"我既在教育部，即等于全由我～似的。","book":"鲁迅《华盖集续编·不是信》"},"similar":["大权独揽","一手遮天"],"opposite":["群策群力","集思广益"],"usage":"作谓语、定语；用于口头语"},{"id":510,"word":"一手包揽","pinyin":"yī shǒu bāo lǎn","abbr":"ysbl","explanation":"一个人办理全部事情，不容许别人插手。","source":{"text":"你一手包揽，我只赊我的头钱。","book":"清·李绿园《歧路灯》第43回"},"example":{"text":"请不要～，得给他留一个机会。"},"similar":["包办代替"],"usage":"作谓语、宾语；指独揽"},{"id":511,"word":"一手托天","pinyin":"yī shǒu tuō tiān","abbr":"ystt","explanation":"比喻无法办到的事。","example":{"text":"你想～，太可笑了"},"usage":"作宾语、定语；用于比喻句"},{"id":512,"word":"一手擎天","pinyin":"yī shǒu qíng tiān","abbr":"ysqt","explanation":"用一支手托住天。比喻无法办到的事。","source":{"text":"西南计臣授鈇钺，独以一手擎半天。","book":"宋·魏了翁《王总领生日》"}},{"id":513,"word":"一手独拍","pinyin":"yī shǒu dú pāi","abbr":"ysdp","explanation":"一只手单独地拍巴掌。比喻一个人或单方面的力量难以办事。","source":{"text":"人主之患在莫之应，故曰：一手独拍，虽疾无声。","book":"《韩非子·功名》"}},{"id":514,"word":"一手独拍，虽疾无声","pinyin":"yī shǒu dú pāi，suī jí wú shēng","abbr":"ysdpsjws","explanation":"疾：急速，猛烈。比喻一个人或单方面的力量难以办事。","source":{"text":"人主之患在莫之应，故曰：一手独拍，虽疾无声。","book":"《韩非子·功名》"},"usage":"作宾语、定语；用于书面语"},{"id":515,"word":"一手运承","pinyin":"yī shǒu yùn chéng","abbr":"ysyc","explanation":"一个人独立处理。"},{"id":516,"word":"一手遮天","pinyin":"yī shǒu zhē tiān","abbr":"yszt","explanation":"一只手把天遮住。形容依仗权势，玩弄手段，蒙蔽群众。","source":{"text":"难将一人手，掩得天下目。","book":"唐·曹邺《读李斯传》诗"},"example":{"text":"弘光好酒喜内，日导以荒淫，毫不省外事，而士英～，靡所不为矣。","book":"明·张岱《石匮书·马士英阮大钺传》"},"similar":["欺君罔世","欺上瞒下","横行霸道"],"opposite":["和平共处"],"usage":"作宾语、定语；用于反动头目"},{"id":517,"word":"一手障天","pinyin":"yī shǒu zhàng tiān","abbr":"yszt","explanation":"一只手把天遮住。形容依仗权势，玩弄手段，蒙蔽群众。","source":{"text":"难将一人手，掩得天下目。","book":"唐·曹邺《读李斯传》诗"}},{"id":518,"word":"一扫无遗","pinyin":"yī sǎo wú yí","abbr":"yswy","explanation":"一下子便扫除干净。比喻彻底清除干净。","source":{"text":"至二十一日，水忽泛溢，新旧三堤一时咸决，明日外堤复坏，急率民闭塞，而湍流迅猛，有蛇时出没于中，所下桩土，一扫无遗。","book":"《元史·河渠志二》"},"example":{"text":"练武厅上庄严肃穆的气象，霎时间～。","book":"金庸《天龙八部》第一回"}},{"id":519,"word":"一扫而光","pinyin":"yī sǎo ér guāng","abbr":"yseg","explanation":"一下子就扫除干净。","source":{"text":"出林飞鸟一扫空。","book":"宋·苏轼《题王逸少帖》诗"},"example":{"text":"吴荪甫微笑地回答，脸上的阴沉气色又～了。","book":"茅盾《子夜》"},"similar":["一扫而空"],"opposite":["堆积如山"],"usage":"作谓语；用于人的精神或事物"},{"id":520,"word":"一扫而尽","pinyin":"yī sǎo ér jìn","abbr":"ysej","explanation":"一下子便扫除干净。比喻彻底清除干净。","source":{"text":"出林飞鸟一扫空。","book":"唐·吕从庆《丰溪存稿·观野烧：“烈烈西风里，蓬芜一扫空。”宋·苏轼《题王逸少帖》"},"example":{"text":"今日这场飞来的横祸，把他的面子～尽，身上疼痛又不敢埋怨，只好一步一瘸回到御茶房自己原来的住处。","book":"二月河《康熙大帝》二十"}},{"id":521,"word":"一扫而空","pinyin":"yī sǎo ér kōng","abbr":"ysek","explanation":"一下子便扫除干净。比喻彻底清除。","source":{"text":"出林飞鸟一扫空。","book":"宋·苏轼《题王逸少帖》"},"example":{"text":"你们所设想的美国的仁义首选，已被艾奇逊～。","book":"毛泽东《别了，司徒雷登》"},"similar":["一网打尽","扫地以尽","斩草除根"],"opposite":["一介不取","岿然独存","硕果仅存"],"usage":"作谓语；指彻底清除"},{"id":522,"word":"一技之善","pinyin":"yī jì zhī shàn","abbr":"yjzs","explanation":"技：技能，本领。指有某种技能或特长。","source":{"text":"愚兄平生漫骂无礼，然人有一才一技之长，一行一言之美，未尝不啧啧称道。","book":"清·郑燮《郑板桥集·家书·淮安舟中寄舍弟墨》"},"similar":["一技之长"],"usage":"作宾语、定语；指有某种技能或特长"},{"id":523,"word":"一技之微","pinyin":"yī jì zhī wēi","abbr":"yjzw","explanation":"技：技能，本领。指有某种技能或特长。","source":{"text":"就是那一长一技之微，若果能专心致志，亦足以轶类超群，独步一时。","book":"清·褚人获《隋唐演义》第九十五回"},"example":{"text":"窃谓劬颜苦学，士夫所难，食力固穷，君子之操，成～，积结身之瘁焉。","book":"俞平伯《人生不过如此·为何经海募款启》"}},{"id":524,"word":"一技之长","pinyin":"yī jì zhī cháng","abbr":"yjzc","explanation":"技：技能，本领；长：擅长、长处。指有某种技能或特长。","source":{"text":"愚兄平生漫骂无礼，然人有一才一技之长，一行一言之美，未尝不啧啧称道。","book":"清·郑燮《郑板桥集·家书·淮安舟中寄舍弟墨》"},"example":{"text":"风琴棋书画，医卜星相，如有～者，前来进谒，莫不优礼以待。","book":"清·李汝珍《镜花缘》第六十四回"},"similar":["才有所长","一技之善"],"opposite":["一无所长"],"usage":"作宾语、定语；指有某种技能或特长"},{"id":525,"word":"一技无成","pinyin":"yī jì wú chéng","abbr":"yjwc","explanation":"技：技能，本领。什么本领也没学成。","source":{"text":"以至今日一技无成，半生潦倒之罪，编述一集，以告天下人。","book":"清·曹雪芹《红楼梦》第回"},"example":{"text":"前情旧事想了一遍，觉得自己流浪四五年，～，重归故里，“我拿什么脸，见那劝阻我的人啊？”","book":"白羽《偷拳》二十一"}},{"id":526,"word":"一把手","pinyin":"yī bǎ shǒu","abbr":"ybs","explanation":"在某一方面才干出众的人或单位或组织的主要负责人。","source":{"text":"在许多问题的看法上，福军和一把手冯世宽有分歧，登云明显地支持世宽。","book":"路遥《平凡的世界》第一卷第13章"},"example":{"text":"他是我们厂的～。"},"similar":["头面人物"],"usage":"作主语、宾语、定语；指首要人物"},{"id":527,"word":"一把死拿","pinyin":"yī bǎ sǐ ná","abbr":"ybsn","explanation":"比喻因循守旧，不肯变通。","source":{"text":"祥子没说什么，等高妈走了，对自己点了点头，似乎是承认自己的一把死拿值得佩服，心中怪高兴的。","book":"老舍《骆驼祥子》八"},"usage":"作宾语；方言"},{"id":528,"word":"一把钥匙开一把锁","pinyin":"yī bǎ yào shi kāi yī bǎ suǒ","abbr":"ybyskybs","explanation":"用一把钥匙只能开一把锁。比喻用不同的方法解决不同的问题。"},{"id":529,"word":"一抔之土","pinyin":"yī póu zhī tǔ","abbr":"ypzt","explanation":"一抔：一捧。一捧黄土。借指坟墓。","source":{"text":"假令愚民取长陵一抔土，陛下何以加其法乎？","book":"《史记·张释之列传》"},"example":{"text":"～未干，六尺之孤何托？","book":"唐·骆宾王《为徐敬业讨武曌檄》"}},{"id":530,"word":"一抔土","pinyin":"yī póu tǔ","abbr":"ypt","explanation":"一抔：一捧。一捧黄土。借指坟墓。","source":{"text":"假令愚民取长陵一抔土，陛下何以加其法乎？","book":"《史记·张释之列传》"},"example":{"text":"半棵树是薄命碑碣，～是断肠墓穴。","book":"清·洪昇《长生殿·弹词》"},"similar":["一抔黄土"],"usage":"作宾语；指坟墓"},{"id":531,"word":"一抔黄土","pinyin":"yī póu huáng tǔ","abbr":"ypht","explanation":"一抔：一捧。一捧黄土。借指坟墓。现多比喻不多的土地或没落、渺小的反动势力。","source":{"text":"假令愚民取长陵一抔土，陛下何以加其法乎？","book":"《史记·张释之列传》"},"example":{"text":"痛伤情，～，高冢卧麒麟。","book":"明·吾邱瑞《运甓记·蒋山致奠》"},"similar":["一抔土"],"usage":"作宾语；指坟墓","story":["汉文帝时，廷尉张释之在处理盗窃汉高祖庙里玉环的案件上同汉文帝发生分歧，他不同意汉文帝的灭门九族的惩罚，就只处死小偷一个人。他说：“偷一只玉环就灭门九族，那么偷走陵墓的一抔黄土该如何判决？”"]},{"id":532,"word":"一报还一报","pinyin":"yī bào huán yī bào","abbr":"ybhyb","explanation":"指做一件坏事后必受一次报复。也指以其人之道还治其人之身。","source":{"text":"做冤仇能做毒，少不的一报还一报。","book":"元·纪君祥《赵氏孤儿》第四折"},"example":{"text":"明儿大伙一人带一根大棒子，用大棒子来审韩大棒子，这叫～。","book":"周立波《暴风骤雨》第一部十七"},"similar":["一还一报"],"usage":"作宾语、定语；用于劝诫人"},{"id":533,"word":"一抹黑","pinyin":"yī mā hēi","abbr":"ymh","explanation":"对周围情况一无所知。","source":{"text":"两眼一抹黑两耳不闻窗外事就在文学本体上倒腾先谓语后主语光动词没名词一百多句不点标点看晕一个算一个！","book":"王朔《一点正经没有》"},"example":{"text":"刚到这里，我有～的感觉。"},"similar":["两眼一抹黑"],"usage":"作谓语、定语；用于口语"},{"id":534,"word":"一拉一唱","pinyin":"yī lā yī chàng","abbr":"ylyc","explanation":"唱：唱和。一个人拉琴，另一个人唱和。比喻两人互相配合，一个下面说话，另一个在旁帮腔。","source":{"text":"你两个一吹一唱，同谋同伙，硬要人的钱钞，好没来由。","book":"明·罗贯中《平妖传》第十八回"}},{"id":535,"word":"一拍一吻缝","pinyin":"yī pāi yī wěn fèng","abbr":"ypywf","explanation":"比喻因情意相投或有利害关系，一下子就说到一起或结合在一起。","source":{"text":"忽有个精胖小伙子来做他口里食，真是矮子爬楼梯，巴弗能彀的，自然一拍一吻缝。","book":"清·张南庄《何典》第六回"}},{"id":536,"word":"一拍即合","pinyin":"yī pāi jí hé","abbr":"ypjh","explanation":"拍：乐曲的段落，也称打拍子。一打拍子就合于乐曲的节奏。比喻困情意相投或有利害关系，一下子就说到一起或结合在一起。","source":{"text":"古人云：‘君子之交，定而后求；小人之交，一拍即合。’","book":"清·李绿园《歧路灯》第十八回"},"example":{"text":"既然我们～，所见略同，我也不瞒你。","book":"陈登科《赤龙与丹凤》第一部十八"},"similar":["一见倾心","情投意合","心心相印"],"opposite":["方枘圆凿","格格不入"],"usage":"作谓语、定语、补语；指投合"},{"id":537,"word":"一拥而上","pinyin":"yī yōng ér shàng","abbr":"yyes","explanation":"一下子全都围上去。形容周围的人同时向一个目标猛挤过去。","source":{"text":"吕蒙亲自擂鼓，士卒皆一拥而上，乱刀砍死朱光。","book":"明·罗贯中《三国演义》第六十七回"},"example":{"text":"众人～，把小偷团团围住揪送派出所"},"similar":["一哄而上"],"usage":"作谓语；用于口语"},{"id":538,"word":"一拥而入","pinyin":"yī yōng ér rù","abbr":"yyer","explanation":"拥：拥挤。一下子全都拥了进去，挤了进去。","source":{"text":"众人一拥而入，迎头就把了缘拿住，押进里面搜捉，不曾走了一个。","book":"明·冯梦龙《醒世恒言》第15卷"},"example":{"text":"众人～，快把小寺庙挤破了。"},"similar":["一哄而上"],"usage":"作谓语；指杂乱进入"},{"id":539,"word":"一指禅","pinyin":"yī zhǐ chán","abbr":"yzc","explanation":"佛教用以比喻万法归一。","source":{"text":"吾得天龙一指头禅，一生用不尽。","book":"宋·释道原《景德传灯录》卷十一"},"example":{"text":"有身且睡三竿日，无物应看～。","book":"宋·黄裳《赠致政王朝奉》"}},{"id":540,"word":"一指蔽目","pinyin":"yī zhǐ bì mù","abbr":"yzbm","explanation":"蔽：遮挡。一个指头遮住自己的眼睛，就什么也看不见了。比喻拒绝接受别人的意见。","source":{"text":"王珪欲使卿条具，朕尝谓不应沮格人言，以自壅障。今以一指蔽目，虽泰、华在前弗之见，近习蔽其君，何以异此，卿当益自信。","book":"《宋史·王安礼传》"}},{"id":541,"word":"一指蔽目，不见泰山","pinyin":"yī zhǐ bì mù，bù jiàn tài shān","abbr":"yzbmbjts","explanation":"蔽：遮盖；泰山：山名。一根手指挡住了眼睛，连面前高大的泰山都看不见。比喻为局部现象所迷惑，看不到全局或整体","source":{"text":"至于全体的事，不管好处多大，总是‘一指蔽目，不见泰山’。","book":"谢觉哉《关于独立思考》"},"similar":["一叶蔽目，不见泰山"],"usage":"作宾语、定语；指头脑简单"},{"id":542,"word":"一挥九制","pinyin":"yī huī jiǔ zhì","abbr":"yhjz","explanation":"一提笔就能写出九道制书。指文思敏捷。","source":{"text":"尝直紫微阁，一日追封皇子公主九人，公方将下直，为之立马却坐，一挥九制数千言，文辞典雅，各得具体。","book":"宋·欧阳修《集贤院学士刘公墓志铭》"},"example":{"text":"刘敝临出局，倚马～，皆见书于史策。","book":"宋·洪迈《容斋三笔·外制之难》"},"usage":"作谓语、定语；用于书面语"},{"id":543,"word":"一挥千金","pinyin":"yī huī qiān jīn","abbr":"yhqj","explanation":"指用钱满不在乎，一花就是一大笔。","source":{"text":"一掷千金浑是胆，家无四壁不知贫。","book":"唐·吴象之《少年行》"}},{"id":544,"word":"一挥立就","pinyin":"yī huī lì jiù","abbr":"yhlj","explanation":"挥：挥笔；就：成功。一动笔就写成了。形容写字、写文章、画画快。","source":{"text":"一昔召公独草六制，宰相吴敏因是以危公，公解衣据案，一挥而就。","book":"宋·孙觌《鸿庆居士文集·翰林莫公内外制序》卷三十"},"example":{"text":"质即应命，提笔作诰文，～。","book":"蔡东藩《五代史演义》第四十六回"}},{"id":545,"word":"一挥而就","pinyin":"yī huī ér jiù","abbr":"yhej","explanation":"挥：挥笔；就：成功。一动笔就写成了。形容写字、写文章、画画快。","source":{"text":"一昔召公独草六制，宰相吴敏因是以危公，公解衣据案，一挥而就。","book":"宋·孙觌《鸿庆居士文集·翰林莫公内外制序》第三十卷"},"example":{"text":"度尚令邯郸淳作文镌碑以记其事。时邯郸淳年方十三岁，文不加点，～，立石墓侧，时人奇之。","book":"明·罗贯中《三国演义》第七十一回"},"similar":["一气呵成","一蹴而就","轻而易举"],"opposite":["一笔勾销","一笔抹煞","千锤百炼"],"usage":"作谓语、定语；指文思敏捷","story":["公元1256年，20岁的文天祥到临安参加进士考试，题目是评论当时的政治问题，文天祥作文时连草稿也不打，一动笔就写，洋洋洒洒，一口气就写完，监考官王应璘见了，大吃一惊，当即向宋理宗推荐这个人才，被宋理宗钦定为状元"]},{"id":546,"word":"一挥而成","pinyin":"yī huī ér chéng","abbr":"yhec","explanation":"挥：挥笔；成：成功。一动笔就写成了。形容写字、写文章、画画快。","source":{"text":"公乃徐徐调笔而操之，顾谓客子：‘欲何字耶？’恶客即拱而答：‘某愿作龟山字尔。’公乃大笑，因一挥而成。","book":"宋·蔡□《铁围山丛谈》"},"example":{"text":"时理宗在位久，政理浸怠，天祥以法天不息为对，其言万余，不为稿，～。帝亲拔为第一。","book":"《宋史·文天祥传》"},"similar":["一挥而就"],"opposite":["千锤百炼"],"usage":"作谓语、定语；指写文章、画画等"},{"id":547,"word":"一损俱损，一荣俱荣","pinyin":"yī sǔn jù sǔn，yī róng jù róng","abbr":"ysjsyrjr","explanation":"损：丧失；俱：全，都；荣：荣耀。一家衰败各家都衰败，一家兴盛各家都兴盛。形容相互之间利害一致。","source":{"text":"四家皆连络有亲，一损俱损，一荣俱荣。","book":"清·曹雪芹《红楼梦》第四回"}},{"id":548,"word":"一掊土","pinyin":"yī póu tǔ","abbr":"ypt","explanation":"抔：用手捧东西。一捧黄土。指坟墓。现多比喻不多的土地或没落、渺小的反动势力。","source":{"text":"假令愚民取长陵一抔土，陛下何以加其法乎？","book":"《史记·张释之列传》"},"example":{"text":"顾自民国肇造，变乱纷乘，黄花冈上～，犹湮没于荒烟蔓草间。","book":"孙文《〈黄花冈七十二烈士事略〉序》"}},{"id":549,"word":"一掌堙江","pinyin":"yī zhǎng yīn jiāng","abbr":"yzyj","explanation":"堙：堵塞。用一只手要堵住大江河水的泛滥。比喻自不量力。","source":{"text":"然俭以区区一掌，而欲独堙江河，终婴疾甚之乱，多见其不知量也。","book":"《后汉书·张俭传》"}},{"id":550,"word":"一掌遮天","pinyin":"yī zhǎng zhē tiān","abbr":"yzzt","explanation":"用一只手掌把天遮住。形容依仗权势，玩弄手段，蒙蔽群众。","source":{"text":"难将一人手，掩得天下目。","book":"唐·曹邺《读李斯传》诗"},"example":{"text":"国民党想要永远～，已经困难了……","book":"马辂《国共和谈演义》第三十五回"},"similar":["一手遮天"],"usage":"作谓语、宾语、定语；用于处事"},{"id":551,"word":"一接如旧","pinyin":"yī jiē rú jiù","abbr":"yjrj","explanation":"犹言一见如故。初次见面就象老朋友一样合得来。","source":{"text":"余走尘土时，公一接如旧，以道义淡交者有年矣。","book":"宋·范仲淹《天章阁待制王公墓志铭》"},"similar":["一见如故"],"usage":"作谓语、定语、状语；指情投意合"},{"id":552,"word":"一推两搡","pinyin":"yī tuī liǎng sǎng","abbr":"ytls","explanation":"形容一再推托。","example":{"text":"经过他的～，责任跟他好像没有一点关系了。"},"usage":"作谓语、宾语、定语；指不愿承担责任"},{"id":553,"word":"一推六二五","pinyin":"yī tuī liù èr wǔ","abbr":"ytlew","explanation":"原是珠算斤两法口诀。比喻推卸干净。","example":{"text":"你～，那些钱我找谁要去。"},"similar":["一退六二五"],"usage":"作谓语、宾语；指推卸责任，用于口语"},{"id":554,"word":"一掴一掌血","pinyin":"yī guó yī zhǎng xuè","abbr":"ygyzx","explanation":"掴：用巴掌打。打一掌出现血印。比喻做事有效用，立竿见影","source":{"text":"大概圣人做事，如所谓一棒一条痕，一掴一掌血，直是恁地。","book":"宋·朱熹《朱子语类·论语》"},"example":{"text":"清·吴敬梓《儒林外史》第11回：“要诗得诗，要赋得赋，都是一鞭一条痕，～。”"},"similar":["一棒一条痕"],"usage":"作宾语、定语；比喻做事扎实"},{"id":555,"word":"一掷乾坤","pinyin":"yī zhì qián kūn","abbr":"yzqk","explanation":"指以天下为孤注之一掷。乾坤，天下。","source":{"text":"谁助君王回马首，真成一掷赌乾坤。","book":"唐·韩愈《过鸿沟》"},"example":{"text":"青衣梦破满林烟，～亦偶然。僧屋翠微看月上，江山犹似永和年。","book":"宋·林景熙《宋武帝居今为寿邱寺》"},"usage":"作宾语、定语；用于书面语"},{"id":556,"word":"一掷千金","pinyin":"yī zhì qiān jīn","abbr":"yzqj","explanation":"指用钱满不在乎，一花就是一大笔。","source":{"text":"一掷千金浑是胆，家无四壁不知贫。","book":"唐·吴象之《少年行》"},"example":{"text":"他仅用几句话，就把那种奢侈豪华，～的情景描绘出来了。"},"similar":["挥金如土","挥霍无度","穷奢极侈"],"opposite":["节衣缩食","省吃俭用","量入为出"],"usage":"作谓语、定语；指花钱大手大脚"},{"id":557,"word":"一掷巨万","pinyin":"yī zhì jù wàn","abbr":"yzjw","explanation":"指用钱满不在乎，一花就是一大笔。形容赌徒下注极大。","source":{"text":"刘毅家无担石之储，樗蒱一掷百万。","book":"《宋书·武帝纪上》"},"example":{"text":"到得那有钱时节，挥金买笑，～。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"similar":["一掷千金","一掷百万"],"usage":"作谓语、定语；指花钱大手大脚"},{"id":558,"word":"一掷百万","pinyin":"yī zhì bǎi wàn","abbr":"yzbw","explanation":"指用钱满不在乎，一花就是一大笔。","source":{"text":"刘毅家无儋石之储，樗蒱一掷百万。","book":"《晋书·何无忌传》"},"example":{"text":"到那赌，刘毅～，是顷刻间可以破家的。","book":"明·东鲁古狂生《醉醒石》第七回"},"similar":["一掷千金","一掷巨万"],"usage":"作谓语、定语；指大手大脚"},{"id":559,"word":"一揽包收","pinyin":"yī lǎn bāo shōu","abbr":"ylbs","explanation":"指总揽一切。","source":{"text":"指台抹凳，担汤担水，一揽包收，多是他上前替力。","book":"明·凌濛初《初刻拍案惊奇》卷十六"},"example":{"text":"幸得夫人贾氏才智超群，不但家务内政～，即张继在署演试兵将，惟仗帘内夫人照悉一切。","book":"清·俞万春《荡寇志》第三十二回"},"similar":["大包大揽"],"usage":"作谓语、定语；用于处事"},{"id":560,"word":"一搭一档","pinyin":"yī dā yī dàng","abbr":"ydyd","explanation":"指互相配合，彼此协作。有时含贬意。","source":{"text":"两个朋友一搭一档的，说了许多挖苦这首歌的话，实际上是挖苦因为这首歌而惹起了伤感的人们。","book":"周立波《夏天的晚上》"},"example":{"text":"他们俩在任何场合都是这么一唱一和，～，配合默契。","book":"蒋子龙《一个女工程师的自述》"},"usage":"作定语、状语；用于书面语"},{"id":561,"word":"一搭两用","pinyin":"yī dā liǎng yòng","abbr":"ydly","explanation":"一样东西当两样用。","example":{"text":"你的大衣白天穿，晚上盖，～。"},"usage":"作宾语、定语；指一物二用"},{"id":562,"word":"一攫千金","pinyin":"yī jué qiān jīn","abbr":"yjqj","explanation":"攫：抓取。指用冒险的手段一下子发大财。"},{"id":563,"word":"一支半节","pinyin":"yī zhī bàn jié","abbr":"yzbj","explanation":"指一小部分。","source":{"text":"人民之望仁政以得一支半节之权利者，实含有亡国民之根性，明也。","book":"梁启超《新民说》第八节"},"similar":["一肢半节","一肢一节"],"usage":"作宾语、定语；用于书面语"},{"id":564,"word":"一改故辙","pinyin":"yī gǎi gù zhé","abbr":"yggz","explanation":"彻底改变走惯了的老路。指坚决走上新路。","example":{"text":"他～像变了一个人似的。"},"similar":["一反常态"],"usage":"作谓语、状语；指完全改变了平时的态"},{"id":565,"word":"一文不值","pinyin":"yī wén bù zhí","abbr":"ywbz","explanation":"指毫无价值。","source":{"text":"最可悲年少科名，弄得一文不值。","book":"明·毕魏《三报恩·骂佞》"},"example":{"text":"有时说自己的作文的根柢全是同情，有时将校对者骂得～。","book":"鲁迅《而已集·读书杂谈》"},"similar":["一钱不值"],"opposite":["价值连城"],"usage":"作谓语、定语、状语；指无用的东西"},{"id":566,"word":"一文不名","pinyin":"yī wén bù míng","abbr":"ywbm","explanation":"名：占有。一个钱都没有。形容非常贫困。","source":{"text":"竟不得名一钱，寄死人家。","book":"西汉·司马迁《史记·佞幸列传》"},"example":{"text":"如果他有钱给那些人行点贿送包'烟钱'，也就过去了；可是他身上～。","book":"杨沫《青春之歌》第二部第21章"},"similar":["一无所有","一贫如洗","囊空如洗"],"opposite":["万贯家财","富埒王侯","腰缠万贯"],"usage":"作谓语、定语；指贫寒"},{"id":567,"word":"一文如命","pinyin":"yī wén rú mìng","abbr":"ywrm","explanation":"把一文钱看得象性命那样重。比喻极端吝啬。同“一钱如命”。","source":{"text":"此人有个毛病，啬细非常，一文如命。","book":"清·吴敬梓《儒林外史》第五十二回"},"similar":["一钱如命"],"usage":"作谓语、定语；用于处事"},{"id":568,"word":"一文莫名","pinyin":"yī wén mò míng","abbr":"ywmm","explanation":"名：占有。一个钱都没有。","source":{"text":"不过我虽然一文莫名靠稿费生活，却不能不说自己不是小资产阶级知识分子，所以我会由五叔的死想出了一个杨老三的故事。","book":"巴金《谈》"},"example":{"text":"你的十万两银子，我分送给吴大人帐下几位得力的将军。我现在倒～。","book":"二月河《康熙大帝》四十六"},"similar":["一文不名","一文不值","不名一钱"],"opposite":["万贯家财","富埒王侯","腰缠万贯"],"usage":"作谓语、定语；指贫寒"},{"id":569,"word":"一文钱逼死英雄汉","pinyin":"yī wén qián bī sǐ yīng xióng hàn","abbr":"ywqbsyxh","explanation":"一文钱可以把英雄豪杰逼死。比喻一个很小的困难却使一个很大的事情无法进行，无法完成。","source":{"text":"相公年幼，休要枉费了。有时，看这东西不难，没有时，便一文钱逼死英雄汉。","book":"清·李绿园《歧路灯》第二十三回"},"example":{"text":"清·李绿园《歧路灯》第二十三回：“相公年幼，休要枉费了。有时，看这东西不难，没有时，便一文钱逼死英雄汉。”"},"similar":["一文钱难倒英雄汉"],"usage":"作宾语、定语、分句；用于口语"},{"id":570,"word":"一文钱难倒英雄汉","pinyin":"yī wén qián nán dǎo yīng xióng hàn","abbr":"ywqndyxh","explanation":"比喻一个很小的困难却使一个很大的事情无法进行，无法完成。也指一个很有本事的人，面对一个小问题而束手无策。","source":{"text":"天下事只怕没得银钱，便是俗语说得好：‘一文钱难倒英雄汉’。","book":"清·文康《儿女英雄传》第19回"},"example":{"text":"天下事只怕没得银钱，便是俗语说得好：～。","book":"清·文康《儿女英雄传》第十九回"},"similar":["一文钱逼死英雄汉"],"usage":"作宾语、定语、分句；用于口语"},{"id":571,"word":"一斑半点","pinyin":"yī bān bàn diǎn","abbr":"ybbd","explanation":"比喻极小部分。","source":{"text":"今人只是知得一斑半点，见得这些，所以不到极处也。","book":"宋·胡宏《胡子知言·复义》：“天命之谓性，流行发见于日用之间，患在学道者未见全体，窥见一斑半点，而执认己意，以为至诚之道。”《朱子语类》卷六七"},"example":{"text":"那巫氏是个泼悍浪妇，挟制老公，又好做～的事，钱歪嘴管他不得。","book":"清·陈忱《水浒后传》第二十九回"},"usage":"作宾语、定语；用于书面语"},{"id":572,"word":"一斑窥豹","pinyin":"yī bān kuī bào","abbr":"ybkb","explanation":"从竹管的小孔里看豹，只看到豹身上的一块斑纹。比喻只看到事物的一部分，指所见不全面或略有所得。","source":{"text":"此郎亦管中窥豹，时见一斑。","book":"南朝宋·刘义庆《世说新语·方正》"}},{"id":573,"word":"一斗米养个恩人，一石米养个仇人","pinyin":"yī dǒu mǐ yǎng gè ēn rén，yī dàn mǐ yǎng gè chóu rén","abbr":"ydmygerysmygcr","explanation":"送一斗米救人，人会怀感恩。送一石米给人会使人贪得无厌而反目成仇。指对人帮助要看时机与对象","source":{"text":"郭先生，自古‘一斗米养个恩人，一石米养个仇人’，这是我们养他的不是了！","book":"清·吴敬梓《儒林外史》第22回"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":574,"word":"一斛凉州","pinyin":"yī hú liáng zhōu","abbr":"yhlz","explanation":"斛：古代量器，1斛＝5斗，1石＝2斛。用一斛酒换了个凉州刺史。形容以贿赂手段求取官职。","example":{"text":"他花50万买了县长当，简直就是～。"},"usage":"作宾语、定语；指贿赂买官","story":["东汉灵帝时期，宦官常侍张让独揽朝政，孟他求官不成，就以全部财产贿赂张让家里的监奴。监奴问他有什么要求，孟他要他当众人面拜他，结果来求张让的人认为孟他与张让关系好，纷纷去求孟他，孟他借花献佛转送珍稀礼物再加一斛美酒换了个凉州刺史"]},{"id":575,"word":"一斥不复","pinyin":"yī chì bù fù","abbr":"ycbf","explanation":"斥：贬斥。一遭贬斥，终身不再为官。","source":{"text":"一斥不复，群飞刺天。","book":"唐·韩愈《祭柳子厚文》"},"example":{"text":"而建言诸臣，～。大臣被弹，率连章诋讦。","book":"《明史·王元翰传》"}},{"id":576,"word":"一新耳目","pinyin":"yī xīn ěr mù","abbr":"yxem","explanation":"耳目：指见闻。听到的、看到的跟以前完全不同，使人感到新鲜。","source":{"text":"关塞之气色，龙潭之景象，香山之泉石，石楼之风月，与往来者耳目一时而新。","book":"唐·白居易《修香山寺记》"},"example":{"text":"姑娘若是跟着我去，包你～，教你得知武学中别有天地。","book":"金庸《倚天屠龙记》第十三回"}},{"id":577,"word":"一新面目","pinyin":"yī xīn miàn mù","abbr":"yxmm","explanation":"一新：完全是新的；面目：面貌。样子完全改变，有了崭新的面貌。","source":{"text":"子毋以康梁二人，招摇海外，借题棍骗，于马扁界中，别开一新面目，而遂为康梁罪也。","book":"清·卢信《大马扁·序》"},"example":{"text":"应该将旧有部员，酌量参换，方足～，动人观听。","book":"蔡东藩、许廑父《民国通俗演义》第七十六回"}},{"id":578,"word":"一方之任","pinyin":"yī fāng zhī rèn","abbr":"yfzr","explanation":"负一方面责任的职务。","source":{"text":"不足以亢一方之任，窃不胜愤懑。","book":"《汉书·终军传》"},"usage":"作宾语；指一方的长官"},{"id":579,"word":"一方之寄","pinyin":"yī fāng zhī jì","abbr":"yfzj","explanation":"负一方面责任的职务。","source":{"text":"不足以亢一方之任，窃不胜愤懑。","book":"《汉书·终军传》"},"example":{"text":"以卿大才，岂不堪任～？朕今赐卿衣紫，说与皇帝，封卿大官，卿意若何？","book":"明·冯梦龙《警世通言》卷六"}},{"id":580,"word":"一方之艺","pinyin":"yī fāng zhī yì","abbr":"yfzy","explanation":"有某一方面技艺。指有一技之长。","source":{"text":"其有一介之善，一方之艺，居接士之馆而躬自菲薄，所得俸禄以奉侍之。","book":"晋·葛洪《西京杂记》卷四"}},{"id":581,"word":"一无可取","pinyin":"yī wú kě qǔ","abbr":"ywkq","explanation":"没有一点儿可以肯定的地方。","source":{"text":"心中大怒道：‘原来这俗物，一无可取，都只管来缠帐，几乎错认了。","book":"明·冯梦龙《醒世恒言·卢太学诗酒傲王侯》"},"example":{"text":"他虽然有许多缺点，但并不是～，他也有许多长处值得大家学习。"},"similar":["一无是处","一塌糊涂","不堪设想"],"opposite":["十全十美","完美无缺","白璧无瑕"],"usage":"作谓语、定语；指没用的东西"},{"id":582,"word":"一无忌惮","pinyin":"yī wú jì dàn","abbr":"ywjd","explanation":"任意妄为，没有一点顾忌。","source":{"text":"纣王心甚欢悦，又见闻太师远征，放心恣乐，一无忌惮。","book":"明·许仲琳《封神演义》第二十八回"},"similar":["肆无忌惮"],"opposite":["瞻前顾后"],"usage":"作谓语、定语、状语；用于处事"},{"id":583,"word":"一无所取","pinyin":"yī wú suǒ qǔ","abbr":"ywsq","explanation":"原指一点都没拿。后也形容什么都未得到。","source":{"text":"会前后赐钱帛数百万计，悉送供公家之用，一无所取。","book":"《三国志·魏志·钟会传》裴松之注"},"example":{"text":"可笑一班小人，奉承权贵，费千金盛设，十分丑态，～，徒传笑柄。","book":"清·孔尚任《桃花扇》第二十四出"},"similar":["一无所得"],"opposite":["不劳而获"],"usage":"作谓语、定语；指没有可取的东西"},{"id":584,"word":"一无所失","pinyin":"yī wú suǒ shī","abbr":"ywss","explanation":"什么损失也没有。","source":{"text":"至四考满，一无所失，选授卫令，除卫州司马。入为郎中，位至中书舍人。","book":"唐·张鷟《朝野佥载》卷一"},"example":{"text":"城虽不坏，而人皆乏食，则为发廪以振于内，方舟以馌于外，水不及女墙者三板，旬有五日乃退，公私～亡。","book":"《宋史·陶弼传》"}},{"id":585,"word":"一无所好","pinyin":"yī wú suǒ hào","abbr":"ywsh","explanation":"好：喜爱。指没有一种爱好。","source":{"text":"这些茶树都是家父自幼种的。家父一生一无所好，就只喜茶。","book":"清·李汝珍《镜花缘》第61回"},"example":{"text":"他是一个～的人。"},"usage":"作谓语、定语；指没有爱好"},{"id":586,"word":"一无所得","pinyin":"yī wú suǒ dé","abbr":"ywsd","explanation":"什么也没有得到。形容毫无收获。","source":{"text":"然日势既暮，寿儿且寄院中止宿，颢亦怀疑，因命寿儿怀袖，一无所得，颢不得已遂躬自操觚。","book":"五代·王定保《唐摭言》卷八"},"example":{"text":"但现在寻起来，～，想必是十七那夜统统烧掉了，那里我还没有知道被捕的也有白莽。","book":"鲁迅《南腔北调集·为了忘却的记念》"},"similar":["一无所取","一无所有","功亏一篑"],"opposite":["无功受禄","不劳而获"],"usage":"作谓语、定语；指没有收效"},{"id":587,"word":"一无所成","pinyin":"yī wú suǒ chéng","abbr":"ywsc","explanation":"一点没有成就。","source":{"text":"读先兄病笃之书，谓平生怀抱，一无所成，惟近古体诗能自立耳。","book":"清·黄遵楷《跋》"},"example":{"text":"而又在外游荡着，～，将如何的伤了祖母、母亲、岳父以及一切亲友的心呢。","book":"郑振铎《离别》"},"similar":["一无所能","徒劳无益","一无所得"],"opposite":["精益求精","事半功倍"],"usage":"作谓语、宾语、补语；指人"},{"id":588,"word":"一无所有","pinyin":"yī wú suǒ yǒu","abbr":"ywsy","explanation":"什么也没有。指钱财，也指成绩、知识。","source":{"text":"如水中之月，空里之风，万法皆无，一无所有。","book":"《敦煌变文集·庐山远公话》"},"example":{"text":"如今凤姐儿～，贾琏外头债务满身。","book":"清·曹雪芹《红楼梦》第一百六回"},"similar":["空空如也","身无长物","两手空空"],"opposite":["无所不有","比比皆是","包罗万象"],"usage":"作谓语、定语；指钱财、成绩、知识等方面"},{"id":589,"word":"一无所求","pinyin":"yī wú suǒ qiú","abbr":"ywsq","explanation":"指没有什么要求或需要。","source":{"text":"要我给她遮掩个门户；此外一无所求。","book":"清·文康《儿女英雄传》第16回"},"example":{"text":"我对你～。"},"similar":["别无所求"],"usage":"作谓语；指没有什么要求或需要"},{"id":590,"word":"一无所知","pinyin":"yī wú suǒ zhī","abbr":"ywsz","explanation":"什么也不知道。","source":{"text":"小学生望后便倒，扶起，良久方醒。问之一无所知。","book":"明·冯梦龙《警世通言》卷十五"},"example":{"text":"对于世界历史，他～。"},"similar":["一概不知","一窍不通","目不识丁"],"opposite":["无所不知","博古通今","见多识广"],"usage":"作谓语、定语、宾语；指人见识少"},{"id":591,"word":"一无所能","pinyin":"yī wú suǒ néng","abbr":"ywsn","explanation":"什么能耐也没有。","source":{"text":"又苏州叶某者，性迂拙，一无所能，其父死，既无产业，且有逋负。","book":"清·钱泳《履园丛话·杂记上·定数》"},"example":{"text":"在那里面的都是坏种或低能儿，他们除任意摧残外，～，其实文章也看不懂。（鲁迅《书信集·致萧军、萧红》）"},"similar":["一无所好","一无所长","一无可取"],"opposite":["精明强干","神通广大","多才多艺"],"usage":"作谓语、定语；讽刺人"},{"id":592,"word":"一无所获","pinyin":"yī wú suǒ huò","abbr":"ywsh","explanation":"一无：全无。什么东西都没有获得。","source":{"text":"然日势既暮，寿儿且寄院中止宿，颢亦怀疑，因命搜寿儿怀袖，一无所得，颢不得已遂躬自操觚。","book":"五代·王定保《唐摭言》"},"example":{"text":"他最终还是～。"},"similar":["一无所有","两手空空","化为乌有"],"opposite":["满载而归","捷足先登","唾手可得"],"usage":"作谓语、定语；指没有收获"},{"id":593,"word":"一无所见","pinyin":"yī wú suǒ jiàn","abbr":"ywsj","explanation":"一：全，都。什么也没有看见。","source":{"text":"客有寝其下者，夜常闻有犬吠，声甚微。以独视之，则一无所见。","book":"唐·张鷟《朝野佥载》卷三：“太子自封署房门，须臾开视，器物一无所见。”唐·张读《宣室志·东莱客》"},"example":{"text":"谁知至今～，倒与这些女子有缘，每每歧路相逢，却也奇怪。","book":"清·李汝珍《镜花缘》第二十一回"},"usage":"作谓语、定语；用于处事"},{"id":594,"word":"一无所长","pinyin":"yī wú suǒ cháng","abbr":"ywsc","explanation":"没有一点儿专长。","source":{"text":"今先生处胜门下三年，胜未有所闻，是先生于文武一无所长也。","book":"明·冯梦龙《东周列国志》第九十九回"},"example":{"text":"便说他年轻而纨裤习气太重，除应酬外，乃～，又性根未定，喜怒无常云云。","book":"清·吴趼人《二十年目睹之怪现状》第八十九回"},"similar":["一无可取","一无是处","志大才疏"],"opposite":["一技之长","精明强干","无所不能"],"usage":"作谓语、宾语、定语；指人"},{"id":595,"word":"一无所闻","pinyin":"yī wú suǒ wén","abbr":"ywsw","explanation":"一点也没有听说，丝毫也不知道。","example":{"text":"但此处却～，我看这事情大约已经过去了。","book":"鲁迅《致章廷谦》"}},{"id":596,"word":"一无是处","pinyin":"yī wú shì chù","abbr":"ywsc","explanation":"是：对，正确。没有一点儿对的或好的地方。","source":{"text":"是犹三家村子，使之治山珍海错，烹饪燔炙，一无是处。明眼观之，只发一粲。","book":"明·张岱《与胡季望》"},"example":{"text":"我们看问题要全面、要一分为二，不要因为人家有缺点，就认为人家～。"},"similar":["一团漆黑","一无可取","百无一是"],"opposite":["十全十美","白璧无瑕","勿庸置疑"],"usage":"作谓语、补语、宾语；指没有一点好的地方"},{"id":597,"word":"一无牵挂","pinyin":"yī wú qiān guà","abbr":"ywqg","explanation":"指没有任何挂念的人和事。","source":{"text":"他横竖是单枪独马，一无牵挂，当下由杭赴苏，寻着了那位帮带。","book":"清·夏敬渠《野叟曝言》第二回"},"example":{"text":"我～，说走就走。"},"similar":["无牵无挂"],"opposite":["牵肠挂肚"],"usage":"作谓语、定语；指没有任何牵挂","story":["鲁提辖为救金老父女打抱不平，打死了镇关西，为此遭到官府的通缉。他只好离开渭州逃到代州雁门县，恰好遇到金老父女。金老将他安排住到女婿赵员外的农庄，但还是担心官府追查，就让一无牵挂的鲁智深去五台山剃度为和尚"]},{"id":598,"word":"一无长物","pinyin":"yī wú cháng wù","abbr":"ywcw","explanation":"一无：全无；长物：多余的东西。除一身之外再没有多余的东西。原指生活俭朴。现形容贫穷。","source":{"text":"吾平生无长物。","book":"《晋书·王恭传》"},"example":{"text":"吾倒替筱亭做了一句“绿毛乌龟玛瑙泉”。倒是自己～怎好？","book":"清·曾朴《孽海花》第二十回"},"similar":["别无长物","家徒四壁"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；形容贫困"},{"id":599,"word":"一日万几","pinyin":"yī rì wàn jǐ","abbr":"yrwj","explanation":"形容帝王每天处理政事极为繁忙。","source":{"text":"几，微也。言当戒惧万事之微。","book":"《尚书·皋陶漠》：“兢兢业业，一日二日万几。”孔传"},"example":{"text":"～，崇高益危，早朝晏罢，业业兢兢。","book":"康有为《大同书》甲部第三章"},"similar":["一日万机"],"usage":"作谓语、定语；用在领导人"},{"id":600,"word":"一日万机","pinyin":"yī rì wàn jī","abbr":"yrwj","explanation":"一天要处理成千上万件公务。形容公务繁忙，每天要处理很多事情。","source":{"text":"兢兢业业，一日二日万几。","book":"《尚书·皋陶漠》"},"example":{"text":"～，也无并应底道理，须还他逐一件理会。","book":"宋·朱熹《朱子语类·程子之书二》"},"similar":["日理万机","一日万几"],"opposite":["无所事事"],"usage":"作谓语、定语；用在国家领导人"},{"id":601,"word":"一日万里","pinyin":"yī rì wàn lǐ","abbr":"yrwl","explanation":"比喻行动非常迅速。","source":{"text":"且安天下用将帅，如造大舟以越沧海，其功则多，其成则大，一日万里，无所不屈。","book":"唐·苏鹗《杜阳杂编》中卷"},"example":{"text":"章君曰：‘人言一日千里，汝殆～也。’","book":"黄焯《记先从父季刚先生师事余杭仪征两先生事》"},"similar":["一日千里"],"usage":"作谓语、定语、状语；指进展极快"},{"id":602,"word":"一日三复","pinyin":"yī rì sān fù","abbr":"yrsf","explanation":"指在一天之内多次反复玩味。","source":{"text":"沈约亦爱其文，尝谓逊曰：‘吾每读卿诗，一日三复，犹不能已。’","book":"《梁书·何逊传》"},"similar":["一日三覆"],"usage":"作谓语、宾语；用于书面语"},{"id":603,"word":"一日三岁","pinyin":"yī rì sān suì","abbr":"yrss","explanation":"形容对人思念殷切。","source":{"text":"彼采艾兮，一日不见，如三岁兮。","book":"《诗·王风·采葛》"},"example":{"text":"《北史·王肃传》：“不见君子，中心如醉，～，我劳如何。”"},"similar":["一日三秋","一日三月"],"usage":"作定语、宾语；形容思念殷切"},{"id":604,"word":"一日三月","pinyin":"yī rì sān yuè","abbr":"yrsy","explanation":"形容对人思念殷切。","source":{"text":"彼采葛兮，一日不见，如三月兮。","book":"《诗·王风·采葛》"},"example":{"text":"宋·章援《致苏轼书》：“伏念某远离墙门，于今九年，～，何可数计。”"},"similar":["一日三秋"],"usage":"作定语、宾语；形容思念殷切"},{"id":605,"word":"一日三省","pinyin":"yī rì sān xǐng","abbr":"yrsx","explanation":"每天多次地自我反省。","source":{"text":"曾子曰：‘吾日三省吾身。’","book":"春秋·鲁·孔丘《论语·学而》"},"example":{"text":"曾子～，则随事用力。","book":"宋·朱熹《朱子语类》第40卷"},"similar":["三省吾身"],"usage":"作谓语、定语；指自我反省","story":["春秋时期，孔子的学生曾参勤奋好学，深得孔子的喜爱，同学问他为什么进步那么快。曾参说：“我每天都要多次问自己：替别人办事是否尽力？与朋友交往有没有不诚实的地方？先生教的学生是否学好？如果发现做得不妥就立即改正。”"]},{"id":606,"word":"一日三秋","pinyin":"yī rì sān qiū","abbr":"yrsq","explanation":"三秋：三个季度。意思是一天不见面，就象过了三个季度。比喻分别时间虽短，却觉得很长。形容思念殷切。","source":{"text":"彼采葛兮，一日不见，如三月兮；彼采萧兮，一日不见，如三秋兮；彼采艾兮，一日不见，如三岁兮。","book":"《诗经·王风·采葛》"},"example":{"text":"～，寸肠千结。","book":"金·李俊明《感皇恩·出京门有感》"},"similar":["寸阴若岁","一日三岁"],"opposite":["一刻千金"],"usage":"作定语、宾语；形容思念殷切","story":["传说古代有一个热恋的多情人，他与情人即使分离短暂的时间，都觉得是很长一段时间。他想象自己的恋人正在采葛、萧、艾，虽然离开才一天，他觉得上是三年，就像诗中描写的那样：“彼采萧兮。一日不见，如三秋兮！”"]},{"id":607,"word":"一日三覆","pinyin":"yī rì sān fù","abbr":"yrsf","explanation":"指在一天之内多次反复玩味。","source":{"text":"《孔子家语·弟子行》：“独居思仁，公言仁义。其于诗也，则一日三覆，白圭之玷，是宫绦之行也。”按，《论语·先进》：“南容三复白圭，孔子以其兄之子妻之。”《家语》本此。"},"similar":["一日三复"],"usage":"作谓语、宾语；用于书面语"},{"id":608,"word":"一日不见，如隔三秋","pinyin":"yī rì bù jiàn，rú gé sān qiū","abbr":"yrbjrgsq","explanation":"一天不见，就好像过了三年。形容思念的心情非常迫切。","source":{"text":"一日不见，如三秋兮。","book":"《诗经·王风·采葛》：“彼采葛兮，一日不见，如三月兮；彼采萧兮，一日不见，如三秋兮；彼采艾兮，一日不见，如三岁兮。” 《诗经·王风·采葛》"},"example":{"text":"真是“～”，满眼是凄凉和空空洞洞，不但器具所余无几了，连书籍……没有人会要的几本洋装书。","book":"鲁迅《彷徨·孤独者三》"},"similar":["一日三秋"],"usage":"作宾语、定语、分句；形容思念的心情非常迫"},{"id":609,"word":"一日为师，终身为父","pinyin":"yī rì wéi shī，zhōng shēn wéi fù","abbr":"yrwszswf","explanation":"哪怕只教过自己一天的老师，也要一辈子当做父亲看待。比喻十分尊重老师。","source":{"text":"你这个泼怪，岂知一日为师，终身为父，父子无隔宿之仇！你伤害我师父，我怎么不来救他？","book":"明·吴承恩《西游记》第三十一回"},"example":{"text":"“～”，可见这师弟的情分也不是可以薄得的。","book":"清·西周生《醒世姻缘传》第三十五回"},"usage":"作宾语、定语、分句；用于书面语"},{"id":610,"word":"一日之冬","pinyin":"yī rì zhī dōng","abbr":"yrzd","explanation":"指夜间。","source":{"text":"胡冬为四时之夜，而夜乃一日之冬。","book":"宋·真德秀《夜气箴》"}},{"id":611,"word":"一日之谊","pinyin":"yī rì zhī yì","abbr":"yrzy","explanation":"指短暂的交往。指交情不深。","source":{"text":"永奏书谢凤曰：‘永斗筲之材，质薄学朽，无一日之雅，左右之介。’","book":"《汉书·谷永传》"}},{"id":612,"word":"一日之长","pinyin":"yī rì zhī cháng","abbr":"yrzc","explanation":"长：长处。表示判断或处理事情有稍强于他人的能力。","source":{"text":"论王霸之余策，览倚仗之要害，吾似有一日之长。","book":"南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"这《孩儿塔》的出世并非要和现在一般的诗人争～，是有别一种意义在。","book":"鲁迅《且介亭杂文末编·白莽作〈孩儿塔序〉》"},"usage":"作宾语；表示判断或处理事情有相当能力","story":["春秋时期，孔子带学生出游，子路、曾皙、冉有、公西有陪孔子坐着闲聊。孔子感慨地对他们说：“因为我比你们年龄稍大一些，不会有人用我了，你们平常总爱说：‘没有人了解我呀！’现在如果有人很了解你们并请你们做事，那么你们该怎么办呢？”"]},{"id":613,"word":"一日之雅","pinyin":"yī rì zhī yǎ","abbr":"yrzy","explanation":"雅：交往。指短暂的交往。指交情不深。","source":{"text":"永奏书谢凤曰：‘永斗筲之材，质薄学朽，无一日之雅，左右之介。’","book":"《汉书·谷永传》"},"example":{"text":"吾与竞雄既有～，复能道其平生，爰为之小传。","book":"清·嬴宗季《六月霜·追悼》"},"similar":["一面之交"],"usage":"作宾语；指交情不深"},{"id":614,"word":"一日九回","pinyin":"yī rì jiǔ huí","abbr":"yrjh","explanation":"形容心里不安。","source":{"text":"虽累百世，垢弥甚耳！是以肠一日九回，居则忽忽若有所亡，出则不知所如往。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"君知否？星桥别后，～肠。","book":"明·洪楩《清平山堂话本·风月相思》"}},{"id":615,"word":"一日九迁","pinyin":"yī rì jiǔ qiān","abbr":"yrjq","explanation":"九：形容多次；迁：升职。一日之内多次升迁。比喻官职升得极快。","source":{"text":"汉车千秋一日九迁其官。","book":"汉·焦延寿《易林·履·节》"},"example":{"text":"虽千秋之～，荀爽之十旬远至，方之微臣，未为速达。","book":"南朝·梁·任昉《为范云让散骑常侍吏部尚书表》"},"similar":["一日三迁"],"usage":"作谓语、宾语；有讽刺意味"},{"id":616,"word":"一日千丈","pinyin":"yī rì qiān zhàng","abbr":"yrqz","explanation":"形容形势发展极为迅速。","source":{"text":"不期年而加盟者逾万人，支部则亦先后成立于各省。从此革命风潮一日千丈，其进步之速，有出人意表者矣。","book":"孙中山《革命原起》"},"example":{"text":"扬州真像有些人说的，不折不扣是个有名的地方……可是现在衰落了，经济上是～的衰落了。","book":"朱自清《我是扬州人》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":617,"word":"一日千里","pinyin":"yī rì qiān lǐ","abbr":"yrql","explanation":"原形容马跑得很快。后比喻进展极快。","source":{"text":"臣闻骐骥盛壮之时，—日而驰千里；至其衰老；驾马先之。","book":"《庄子·秋水》：“骐、骥、骅、骝，一日而驰千里。”《史记·刺客列传》"},"example":{"text":"由于负责干部的艰苦奋斗，业务更～，异常发达，不到一年，全国分店已达五十余处。","book":"邹韬奋《患难余生记·进步文化的遭难》"},"similar":["日新月异","风驰电掣","逐日追风"],"opposite":["停滞不前","慢条斯理","每况愈下"],"usage":"作谓语、定语、状语；指进展极快","story":["战国时期，同在赵国做人质的燕太子丹与秦国嬴政相处很好。嬴政后为秦王，对来秦国做人质的燕太子丹百般刁难。太子丹逃回燕国找田光商量对策，田光说他已经不是一日千里的骏马了，但能推荐荆轲去刺杀秦王嬴政"]},{"id":618,"word":"一日夫妻百日恩","pinyin":"yī rì fū qī bǎi rì ēn","abbr":"yrfqbre","explanation":"一旦结为夫妻，就有经久不衰的深厚恩情。","source":{"text":"常言一日夫妻百日恩，相随百步也有徘徊之意，一个热突突人儿，指头儿似的少了一个，如何不想不疼不思念的！","book":"明·兰陵笑笑生《金瓶梅词话》第73回"},"example":{"text":"林海音《婚姻的故事》：“因为‘～’呀，但是偏偏又在那新旧交替的时代。”"},"similar":["一夜夫妻百日恩"],"usage":"作宾语、定语、分句；用于夫妻间","story":["永平府名士张鸿渐因知府赵某打死范秀才而打抱不平上告，被诬陷入狱，他中途逃脱至风翔府，遇到狐仙施舜华，两人相爱并同居三年。张鸿渐想念昔日的妻子，就对施舜华解释道：“一日夫妻，百日恩义”。施舜华理解他的心情就送他回家"]},{"id":619,"word":"一日并命","pinyin":"yī rì bìng mìng","abbr":"yrbm","explanation":"形容极受恩宠，一天之内并拜升迁之命。","source":{"text":"时父骅迁秘书少监，德宗欲宠其门，使一日并命。","book":"《新唐书·赵宗儒传》"},"example":{"text":"朝廷增用谏臣，修、靖、素～，朝野相庆。","book":"《宋史·蔡襄传》"}},{"id":620,"word":"一日纵敌，万世之患","pinyin":"yī rì zòng dí，wàn shì zhī huàn","abbr":"yrzdwszh","explanation":"纵：放；万世：长期；患：祸害。一天放过敌人，会留下长期的祸害。","source":{"text":"秦不哀吾丧而伐吾同姓，秦则无礼，何施之为？吾闻之，一日纵敌，数世之患也。谋及子孙，可谓死君乎？","book":"《左传·僖公三十碱年》"},"example":{"text":"丞相纵不杀备，亦不当使之去。古人云：～。望丞相察之。","book":"明·罗贯中《三国演义》第二十一回"}},{"id":621,"word":"一日纵敌，数世之患","pinyin":"yī rì zòng dí，shù shì zhī huàn","abbr":"yrzdsszh","explanation":"纵：放；数世：几世，长期；患：祸害。一天放过敌人，会留下长期的祸害。","source":{"text":"秦不哀吾丧而伐吾同姓，秦则无礼，何施之为？吾闻之，一日纵敌，数世之患也。谋及子孙，可谓死君乎？","book":"《左传·僖公三十碱年》"},"example":{"text":"～，今若舒迟，民心固矣。","book":"《魏书·郦范传》"}},{"id":622,"word":"一日而白","pinyin":"yī rì ér bái","abbr":"yreb","explanation":"形容一下子名声大震。","source":{"text":"如是，则夫名声之部发于天地之间也，岂不如日月雷霆然矣哉！故曰：以国齐义，一日而白，汤武是也。","book":"《荀子·王霸》"}},{"id":623,"word":"一日身死","pinyin":"yī rì shēn sǐ","abbr":"yrss","explanation":"一旦自己死亡。","source":{"text":"今之县令，一日身死，子孙累世絮驾，故人重之。","book":"战国·韩·韩非《韩非子·五蠹》"},"usage":"作谓语；指一旦自己死亡"},{"id":624,"word":"一日难再晨","pinyin":"yī rì nán zài chén","abbr":"yrnzc","explanation":"一天之内不会有第二个早晨。比喻光阴宝贵，失不再来。","source":{"text":"盛年不重来，一日难再晨。及时当勉励，岁月不待人。","book":"晋·陶渊明《杂诗》"}},{"id":625,"word":"一旦一夕","pinyin":"yī dàn yī xī","abbr":"ydyx","explanation":"形容很短的时间。同“一朝一夕”。","source":{"text":"臣弑君，子弑父，非一旦一夕之故也，其渐久矣。","book":"《史记·太史公自序》"},"example":{"text":"故魏之亡，亡于孟德偏爱植而植思夺嫡之日。兄弟相猜，拱手以授之他人，非～之故矣。","book":"清·王夫之《读通鉴论·三国》"},"similar":["一朝一夕"],"usage":"作定语、宾语；用于书面语"},{"id":626,"word":"一旦之忿","pinyin":"yī dàn zhī fèn","abbr":"ydzf","explanation":"忿：气忿。一时的气忿。","source":{"text":"彦饶与晋初无衅隙，以一旦之忿，不能驭其军，杀奉进已非其本意，以反见诛，非其罪也！","book":"《论语·颜渊》：“一朝之忿，忘其身，以及其亲，非惑与？”《新五代史·符存审传》"},"example":{"text":"母守寡养孤，苦身投老，奈何以～，弃历年之勤乎！","book":"《资治通鉴·汉纪·孝桓延熹七年》"}},{"id":627,"word":"一时一刻","pinyin":"yī shí yī kè","abbr":"ysyk","explanation":"指非常短暂的时间。","source":{"text":"可怜今日我无钱，一时一刻如长年。","book":"明·凌濛初《二刻拍案惊奇》第22卷"},"example":{"text":"不要浪费这～。"},"similar":["一时半刻"],"opposite":["长年累月"],"usage":"作主语、宾语；指短暂的时间"},{"id":628,"word":"一时三刻","pinyin":"yī shí sān kè","abbr":"yssk","explanation":"指很短的时间。","source":{"text":"机缘凑，把愁肠暂丢，便难成，也一时三刻展眉头。","book":"清·李渔《凰求凤·夥媒》"},"example":{"text":"你出来不出来？～就把你烧成黑炭了！","book":"孔厥《新儿女英雄传》第四回"},"similar":["一时半刻"],"usage":"作状语；指很短的时间"},{"id":629,"word":"一时之冠","pinyin":"yī shí zhī guàn","abbr":"yszg","explanation":"冠：位居第一。一个时期里的首领。","source":{"text":"少有盛名，而高迈不羁，虽闲居终日，容止不怠，风流为一时之冠。","book":"《晋书·王献之传》"},"example":{"text":"诗文工丽，蔚为～，不自标榜。","book":"《清史稿·文苑传·吴伟业》"},"similar":["一时之标"],"usage":"作宾语；用于书面语"},{"id":630,"word":"一时之权","pinyin":"yī shí zhī quán","abbr":"yszq","explanation":"暂时的权宜。","source":{"text":"文公曰：‘咎犯之言，一时之权也；雍季之言，万世之利也，吾岂可以先一时之权而后万世之利哉！’","book":"《韩非子·难一》：“文公之霸也宜哉！既知一时之权，又知万世之利。”《淮南子·人间训》"},"example":{"text":"西汉·刘安《淮南子·人间训》：“咎犯之言，～也。”"},"similar":["一时权宜"],"usage":"作宾语；用于书面语"},{"id":631,"word":"一时之标","pinyin":"yī shí zhī biāo","abbr":"yszb","explanation":"标：出色。一个时期最出众的人物。","source":{"text":"亡叔是一时之标，公是千载之英。","book":"南朝·宋·刘义庆《世说新语·品藻》"},"similar":["一时之冠"],"usage":"作宾语；用于书面语"},{"id":632,"word":"一时之秀","pinyin":"yī shí zhī xiù","abbr":"yszx","explanation":"一个时期的优秀人物。亦作“一时之选”。","source":{"text":"后主问帝：‘萧妃何如此人？’帝曰：‘春兰秋菊，各一时之秀也。’","book":"《周书·唐瑾传》：“时六尚书皆一时之秀，周文自谓得人，号为六俊。”明·冯梦龙《醒世恒言》第二十四卷"},"example":{"text":"既是～，陛下的诗句，何轻薄丽华之甚？","book":"清·褚人获《隋唐演义》第三十九回"},"usage":"作宾语；指一个时期的优秀人物","story":["南北朝时期，北周的唐瑾很有学问，被爱才的杨坚发觉，出仕为官，立下大功。他为官时十分清廉，乐善好施，赢得朝廷上下的一致称赞，德高望重的燕公于谨向文帝请示与唐瑾结为兄弟，文帝封唐瑾为吏部尚书，与在朝五位尚书都是一时之秀"]},{"id":633,"word":"一时之选","pinyin":"yī shí zhī xuǎn","abbr":"yszx","explanation":"指某一时期的优秀人才。","source":{"text":"其所引拔以言为职者，如公，皆一时之选。","book":"《新唐书·韦抗传》：“它所辟举，如王维、王缙、崔殷等，皆一时选云。”宋·曾巩《〈范宽之奏议集〉序》"},"example":{"text":"馀如兴平师夔……蓝田张德直、叶县刘从益皆清慎才敏，极～。","book":"《金史·循吏传论》"},"usage":"作宾语；用于书面语"},{"id":634,"word":"一时伯仲","pinyin":"yī shí bó zhòng","abbr":"ysbz","explanation":"指两人水准才能难分高下。伯仲，指兄弟。","source":{"text":"看这怡蕉客所作诸诗，可的是一时伯仲呢！","book":"清·吴兰馨《绛蘅秋·秋社》"},"usage":"作谓语、定语；用于书面语"},{"id":635,"word":"一时千载","pinyin":"yī shí qiān zǎi","abbr":"ysqz","explanation":"一千年才遇到一次。极言机会难得。","source":{"text":"恭维某官望重本朝，才高当世，一时千载，韦平之遇已稀；四世五公，袁杨之兴未艾。","book":"宋·秦观《代回吕吏部启》"},"similar":["千载一时","千年一遇"],"usage":"作定语；用于书面语"},{"id":636,"word":"一时半刻","pinyin":"yī shí bàn kè","abbr":"ysbk","explanation":"指很短的时间。","source":{"text":"吾今用你坛前仗剑等待，休错吾一时半刻。","book":"元·吴昌龄《张天师》"},"example":{"text":"你这么个明白人，怎么～的就不会体应该人。（清·曹雪芹《红楼梦》第三十二回）"},"similar":["一时半霎","一时半晌"],"opposite":["天长地久"],"usage":"作宾语；指很短的时间"},{"id":637,"word":"一时半晌","pinyin":"yī shí bàn shǎng","abbr":"ysbs","explanation":"指很短的时间。","source":{"text":"人生死则在一时半晌。你叫我断了金波绿酿，却不等闲的虚度时光。","book":"元·高文秀《遇上皇》第一折"},"example":{"text":"他盼望这份统计表，绝不是～的了。","book":"管桦《清风店》"},"similar":["一时半刻","一时半霎"],"usage":"作宾语；指很短的时间"},{"id":638,"word":"一时半霎","pinyin":"yī shí bàn shà","abbr":"ysbs","explanation":"指很短的时间。","source":{"text":"我觑这万水千山，都只在一时半霎。","book":"元·郑光祖《倩女离魂》第二折"},"similar":["一时半刻"],"opposite":["地久天长"],"usage":"作宾语；指很短的时间"},{"id":639,"word":"一时口惠","pinyin":"yī shí kǒu huì","abbr":"yskh","explanation":"口惠：口头上许给别人以好处。口头上一时空言给人恩惠，事实上并没有兑现。","source":{"text":"口惠而实不至，怨菑及其身。","book":"《礼记·表记》"}},{"id":640,"word":"一时戏言","pinyin":"yī shí xì yán","abbr":"ysxy","explanation":"偶然开玩笑的话。","source":{"text":"这话虽然有的，止不过一时戏言，难道奴家终身之事，只在两局棋上结果了不成！","book":"明·凌濛初《二刻拍案惊奇》第二卷"},"example":{"text":"此亦～，何足为典要。","book":"清·袁枚《答蕺园论诗书》"},"usage":"作主语、宾语、定语；指玩笑话"},{"id":641,"word":"一时无两","pinyin":"yī shí wú liǎng","abbr":"yswl","explanation":"一个时期内最突出，没有可与相比的。","source":{"text":"惟晚与璁、萼异，为所轧，不获以恩礼终。然其才一时无两，或比之姚崇云。","book":"《明史·杨一清传》"},"example":{"text":"那诗是八首五律，做得深情如水，宛转关生，旖旎风光，～。","book":"清·张春帆《九尾龟》第七十回"},"similar":["独步一时"],"usage":"作谓语、定语；用于书面语"},{"id":642,"word":"一时权宜","pinyin":"yī shí quán yí","abbr":"ysqy","explanation":"权宜：因时因事变通处理。暂时变通处理","source":{"text":"不穿孝这桩事自己也知是一时权宜，其实去报仇，所以才不穿孝。","book":"清·文康《儿女英雄传》第18回"},"example":{"text":"梁启超《生计学学说沿革小史》第六章：“重商主义，既不过～之说。”"},"similar":["一时之权"],"usage":"作宾语、定语；用于书面语"},{"id":643,"word":"一时独步","pinyin":"yī shí dú bù","abbr":"ysdb","explanation":"形容非常突出，一个时期内没有人能比得上。","source":{"text":"论者谓熙独步一时，虽年老落笔益壮，如随其年貌焉。","book":"《晋书·陆喜传》：“文藻宏丽，独步当时；言论慷慨，冠乎终古。”《宣和画谱》卷十一"},"example":{"text":"北宋晏小山工于言情，出元献、文忠之右，然不免思涉于邪，有失风人之旨。而措词婉妙，则～。","book":"清·陈廷焯《白雨斋词话》"}},{"id":644,"word":"一时缓急","pinyin":"yī shí huǎn jí","abbr":"yshj","explanation":"缓急：危急之事。暂时有了困难，急需帮助。","source":{"text":"孝文且崩时，诫太子曰：‘即有缓急，周亚夫真可任将兵。’文帝崩，拜亚夫为车骑将军。","book":"《史记·绛侯周勃世家》"},"example":{"text":"有零碎银子且与几两，只怕～要用。","book":"清·西周生《醒世姻缘传》第十五回"}},{"id":645,"word":"一时虚誉","pinyin":"yī shí xū yù","abbr":"ysxy","explanation":"虚：表面的、不实在的；誉：声誉。暂时的、表面的荣誉。","source":{"text":"遑遑尔竞一时之虚誉，规死后之余荣。","book":"《列子·杨朱》"}},{"id":646,"word":"一昔之期","pinyin":"yī xī zhī qī","abbr":"yxzq","explanation":"一昔：即一夕。一夜的时间。","source":{"text":"为一昔之期，袭梁及霍。","book":"《左传·哀公四年》"}},{"id":647,"word":"一星半点","pinyin":"yī xīng bàn diǎn","abbr":"yxbd","explanation":"星：细碎的。形容极少。","source":{"text":"可怎生无半点儿尘丝，一星儿土渍。","book":"元·孙仲章《勘头巾》"},"example":{"text":"她是个干净利索的人，家里让她收拾得连～的灰尘都没有。"},"similar":["寥若晨星","屈指可数"],"opposite":["数不胜数"],"usage":"作定语；形容点点滴滴，为数极少"},{"id":648,"word":"一是一，二是二","pinyin":"yī shì yī，èr shì èr","abbr":"ysyese","explanation":"形容说话老老实实，毫不含糊。","source":{"text":"遂把那杨腾蛟怎样写亲供，刘二怎样勒掯，小人等不依他，又恐怕被他连累，一是一，二是二的都说了。","book":"清·俞万春《荡寇志》第80回"},"example":{"text":"～，我问出口，你就得说，别犹豫。","book":"曹禺《原野》"},"similar":["老老实实"],"usage":"作谓语、定语、分句；指人的性格"},{"id":649,"word":"一晦一明","pinyin":"yī huì yī míng","abbr":"yhym","explanation":"一暗一明。常指昼夜循环。","source":{"text":"一晦一明，孰知其端绪。","book":"《庄子·田子方》：“消息满虚，一晦一明，日改月化。”《淮南子·兵略训》"},"example":{"text":"西汉·刘安《淮南子·兵略训》：“～，孰知其端绪。”"},"usage":"作宾语、定语；用于书面语"},{"id":650,"word":"一暝不视","pinyin":"yī míng bù shì","abbr":"ymbs","explanation":"闭上眼睛，不再睁开。指死亡。","source":{"text":"有断脰绝腹，一暝而万世不视，不知所益，以忧社稷者。","book":"西汉·刘向《战国策·楚策一》"},"example":{"text":"天上人间，会当相见，定非～者矣。","book":"清·纪昀《阅微草堂笔记》"}},{"id":651,"word":"一暴十寒","pinyin":"yī pù shí hán","abbr":"ypsh","explanation":"虽然是最容易生长的植物，晒一天，冻十天，也不可能生长。比喻学习或工作一时勤奋，一时又懒散，没有恒心。","source":{"text":"虽有天下易生之物也，一日暴之，十日寒之，未有能生者也。","book":"先秦·孟轲《孟子·告子上》"},"example":{"text":"而～，终归无益。","book":"清·宣鼎《夜雨秋灯录·珠妓情殉》"},"similar":["三心二意","有始无终","为德不终"],"opposite":["持之以恒","有始有终","有头有尾"],"usage":"作谓语、定语、宾语；指没有恒心","story":["战国时期，齐宣王昏庸无能，常被朝中的奸人利用。孟子游历到齐国时，对齐宣王也无能为力。他认为齐宣王并不是不聪明，而是没有受到好的方面的熏陶，他说：“虽有天下易生之物也，一日暴之，十日寒之，未有能生者也。”"]},{"id":652,"word":"一曝十寒","pinyin":"yī pù shí hán","abbr":"ypsh","explanation":"曝：晒。原意是说，虽然是最容易生长的植物，晒一天，冻十天，也不可能生长。比喻学习或工作一时勤奋，一时又懒散，没有恒心。","source":{"text":"虽有天下易生之物也，一日曝之，十日寒之，未有能生者也。","book":"《孟子·告子上》"},"example":{"text":"他们跑出英文教室，说的听的依然是中国话。这只是‘～’的办法罢了，对于理解的功夫完全抛荒。","book":"叶圣陶《英文教授》"},"similar":["三心二意","有始无终","为德不终"],"opposite":["持之以恒","有始有终","有头有尾"],"usage":"作主语、定语、宾语；指没有恒心","story":["战国时期，齐宣王昏庸无能，常被朝中的奸人利用。孟子游历到齐国时，对齐宣王也无能为力。他认为齐宣王并不是不聪明，而是没有受到好的方面的熏陶，他说：“虽有天下易生之物也，一日暴之，十日寒之，未有能生者也。”"]},{"id":653,"word":"一曲之士","pinyin":"yī qǔ zhī shì","abbr":"yqzs","explanation":"仅会一首歌曲的人。比喻只精通一种技艺的人。也指孤陋寡闻的人。","source":{"text":"虽然，不该不遍，一曲之士也。","book":"《庄子·天下》"},"example":{"text":"各得一察而不符于大道，此～也。","book":"《叔苴子·内篇》卷二"}},{"id":654,"word":"一曲阳关","pinyin":"yī qǔ yáng guān","abbr":"yqyg","explanation":"阳关：古曲调名，古人在送别时唱。比喻别离。","source":{"text":"渭城朝雨浥清尘，客舍青青柳色新。劝君更尽一杯酒，西出阳关无故人。","book":"唐·王维《渭城曲》诗"},"example":{"text":"三杯别酒肝肠断，～离恨添。","book":"元·无名氏《端正好》曲"},"usage":"作宾语；用于书面语"},{"id":655,"word":"一替一句","pinyin":"yī tì yī ù","abbr":"ytyj","explanation":"双方彼此你一言我一语地交替谈话，互相应答。","source":{"text":"那知这张李二公，又亲自到厢房里来道谢，一替一句，又奉承了半日。","book":"清·刘鹗《老残游记》第四回"},"example":{"text":"两个人～地说着，都想听听动静。","book":"李晓明、韩安庆《平原枪声》第二十六章"},"usage":"作定语、状语；用于书面语"},{"id":656,"word":"一月三舟","pinyin":"yī yuè sān zhōu","abbr":"yysz","explanation":"佛家语，同是一个月亮，三只船上的人看的角度各不一样。比喻佛家的道规只有一个，而因人理解不同而异。","source":{"text":"譬犹朗月，流影遍应，且澄江一月，三舟共观。","book":"《华严经疏钞》卷十六"}},{"id":657,"word":"一望无垠","pinyin":"yī wàng wú yín","abbr":"ywwy","explanation":"辽远广阔，看不到边际。","source":{"text":"四周已不见人头，只有此伏彼起的蓝色波涛，一望无垠的汹涌海面。","book":"王朔《浮出海面》"},"example":{"text":"～的蓝色大海，令人心旷神怡。"},"similar":["一望无际","一望无涯","一望无边"],"usage":"作谓语、定语；形容地域辽阔"},{"id":658,"word":"一望无涯","pinyin":"yī wàng wú yá","abbr":"ywwy","explanation":"涯：边际。一眼望不到边。形容非常辽阔。","source":{"text":"这是六月的时候，白天间太阳光照射在一望无涯的洪水上面，澹澹地腾上了一些轻烟。","book":"洪灵菲《在洪流中》"},"similar":["一望无际"],"usage":"作谓语、定语；指无边无际"},{"id":659,"word":"一望无边","pinyin":"yī wàng wú biān","abbr":"ywwb","explanation":"一眼看不到边际，形容地域十分辽阔。","source":{"text":"在鄱阳湖旁边的一座大山上，太阳刚刚出来，把一望无边的湖水照得金光闪闪。","book":"周而复《上海的早晨》第四部"},"example":{"text":"～的大草原是多么的辽阔。"},"similar":["一望无际"],"opposite":["一衣带水"],"usage":"作谓语、定语；形容地域辽阔"},{"id":660,"word":"一望无际","pinyin":"yī wàng wú jì","abbr":"ywwj","explanation":"际：边。一眼望不到边。形容非常辽阔。","source":{"text":"舟泊浔阳城下住，杳霭昏鸦，点点云边树。九派江分从此去，烟波一望空无际。","book":"宋·秦观《蝶恋花》词"},"example":{"text":"～，似有千里之遥。","book":"明·吴承恩《西游记》第六十四回"},"similar":["一马平川","无边无际","漫无边际"],"opposite":["咫尺之间","近在眉睫","一衣带水"],"usage":"作谓语、定语；形容地域辽阔"},{"id":661,"word":"一望而知","pinyin":"yī wàng ér zhī","abbr":"ywez","explanation":"一看就明白。","source":{"text":"又说了一回话，大约言语甜俗，意味粗浅，中藏早是一望而知的。","book":"清·李绿园《歧路灯》"},"example":{"text":"而且～情商也没用，因为客堂里都搭起床铺。","book":"叶圣陶《潘先生在难中》"},"similar":["一目了然","一览无遗","洞若观火"],"opposite":["隐隐约约","模棱两可","雾里看花"],"usage":"作谓语、定语；指事物或事理很明显"},{"id":662,"word":"一朝一夕","pinyin":"yī zhāo yī xī","abbr":"yzyx","explanation":"朝：早晨；夕：晚上。一个早晨或一个晚上。形容很短的时间。","source":{"text":"臣弑其君，子弑其父，非一朝一夕之故，其所由来者渐矣。","book":"《周易·坤》"},"example":{"text":"即如今日中倭之构难，究所由来，夫岂～之故也哉！","book":"清·严复《论世变之亟》"},"similar":["一时半刻","弹指之间","转眼之间"],"opposite":["千秋万代","万古长存","地久天长"],"usage":"作定语、状语；用于否定句","story":["战国时期季梁得重病，他儿子请来矫、俞、卢三位医生。矫说病因在冷暖失调；俞医生认为病不是一朝一夕的事，而是渐变而来；卢医生说病因在于心理原因造成的。季梁认为卢医生的诊断很准，不久病就自然而愈了"]},{"id":663,"word":"一朝之忿","pinyin":"yī zhāo zhī fèn","abbr":"yzzf","explanation":"朝：早晨；忿：气忿。一时的气忿。","source":{"text":"一朝之忿，忘其身，以及其亲，非惑与？","book":"《论语·颜渊》"},"example":{"text":"小人～，曾身之不遑恤，非其性之尽也。","book":"《二程全书·粹言二》"},"usage":"作宾语；指一时的气忿"},{"id":664,"word":"一朝之患","pinyin":"yī zhāo zhī huàn","abbr":"yzzh","explanation":"突然发生的祸患。","source":{"text":"楚国苦之，群臣皆怨，咸言费无忌谗杀伍奢、白州犁而吴侵境不绝于寇，楚国群臣有一朝之患。","book":"《礼记·檀弓上》：“故君子有终身之忧，而无一朝之患，故忌日不乐。”汉·赵晔《吴越春秋·阖闾内传》"},"usage":"作宾语；用于书面语"},{"id":665,"word":"一朝千里","pinyin":"yī zhāo qiān lǐ","abbr":"yzql","explanation":"犹一日千里。原形容马跑得很快。后比喻进展极快。","source":{"text":"一朝千里心犹在，争肯潜忘秣饲恩。","book":"唐·曹唐《病马五首呈郑校书章三吴十五先辈》诗之三"},"similar":["一日千里"],"usage":"作谓语、定语；用于书面语"},{"id":666,"word":"一朝天子一朝臣","pinyin":"yī cháo tiān zǐ yī cháo chén","abbr":"yctzycc","explanation":"指一个人上台，下面的工作人员就另外换一批。","source":{"text":"咱王是一朝天子一朝臣。","book":"元·金仁杰《追韩信》第三折"},"example":{"text":"万里江山万里尘，～。","book":"明·汤显祖《牡丹亭》第十五出"},"usage":"作宾语、分句；指当权者变动下属也变动"},{"id":667,"word":"一朝权入手，看取令行时","pinyin":"yī zhāo quán rù shǒu，kàn qǔ lìng xíng shí","abbr":"yzqrskqlxs","explanation":"一朝：一旦。一旦掌了权，就发号施令，指手画脚，作威作福","source":{"text":"一朝权入手，看取令行时。","book":"唐·高武仲《中兴间气集》"},"similar":["一朝权在手，便把令来行"],"usage":"作宾语、定语、分句；指人掌权后"},{"id":668,"word":"一朝权在手，便把令来行","pinyin":"yī zhāo quán zài shǒu，biàn bǎ lìng lái xíng","abbr":"yzqzsbbllx","explanation":"一旦掌了权，就发号施令，指手画脚。","source":{"text":"一朝权入手，看取令行时。","book":"唐·高仲武《中兴闲气集》卷上"},"example":{"text":"～ ，大小三军，听吾命令。","book":"明·顾大典《青衫记·承璀受阃》"},"similar":["一朝权入手，看取令行时"],"usage":"作宾语、定语、分句；指人掌权后"},{"id":669,"word":"一朝被蛇咬，三年怕井绳","pinyin":"yī zhāo bèi shé yǎo，sān nián pà jǐng shéng","abbr":"yzbsysnpjs","explanation":"一次被蛇咬了，看见井边断了的绳子也害怕。比喻在某事上吃了苦头，以后碰到类似的情况也会害怕","source":{"text":"南星摸着头上的大包，颇有点‘一朝被蛇咬，三年怕井绳’的神气。","book":"老舍《小坡的生日》"},"similar":["一年被蛇咬，三年怕草索"],"usage":"作宾语、定语、分句；用于处事"},{"id":670,"word":"一木破天","pinyin":"yī mù pò tiān","abbr":"ympt","explanation":"指时机尚未成熟。比喻谋逆未成。","example":{"text":"他计划倒好，不料～，前功尽弃。"},"usage":"作宾语、定语；用于叛逆","story":["东晋时期，大臣王敦久怀叛逆之心，一天他梦见一木刺破青天，以为时机成熟，就问吴猛现在称帝是否可行，吴猛回答道：“木上一横是未字，表示木上破天，你还不能轻举妄动，因为晋的天下还未衰亡。”后来王敦谋逆果然未成，死在军中"]},{"id":671,"word":"一木难扶","pinyin":"yī mù nán fú","abbr":"ymnf","explanation":"大楼将要倒塌，不是一根木头能够支撑得住的。比喻一个人的力量单薄，维持不住全局。","source":{"text":"大厦将颠，非一木所支也。","book":"南朝·宋·刘义庆《世说新语·任诞》：“元裒如北夏门，拉攞自欲坏，非一木所能支。”隋·王通《文中子·事君》"},"example":{"text":"天地反覆兮，火欲殂；大厦将崩兮，～。","book":"明·罗贯中《三国演义》第三十五回"},"similar":["一木难支","一柱难支"],"usage":"作宾语、定语；指个人能力有限"},{"id":672,"word":"一木难支","pinyin":"yī mù nán zhī","abbr":"ymnz","explanation":"大楼将要倒塌，不是一根木头能够支撑得住的。比喻一个人的力量单薄，维持不住全局。","source":{"text":"大厦将颠，非一木所支也。","book":"隋·王通《文中子·事君》"},"example":{"text":"他觉得自己在朝中孤掌难鸣，真是“～大厦之将倾”。","book":"姚雪垠《李自成》第一卷第三章"},"similar":["孤木难支","一柱难支","一木难扶"],"usage":"作宾语、定语；指个人能力有限","story":["南朝宋顺帝时，权臣萧道成把持政权残害忠良，横行恣肆，大臣袁粲和刘东准备暗杀萧道成，褚渊向萧道成告密。萧道成派戴僧静率军去攻打袁粲。袁粲的儿子袁最说：“我知道大厦将倾，一木难支，但我们必须死守到底。”"]},{"id":673,"word":"一本万利","pinyin":"yī běn wàn lì","abbr":"ybwl","explanation":"本钱小，利润大。","source":{"text":"这回破釜沉舟，远行一趟，却指望收它个一本万利哩。","book":"清·姬文《市声》第二十六回"},"example":{"text":"旧时代的商人有一句生意经：“～”。就是说，出最小的资本，追求最大的利润。","book":"郭小川《一本万利》"},"similar":["事半功倍","渔人之利"],"opposite":["事倍功半","徒劳无功"],"usage":"作宾语、定语；指本小利大","story":["战国时期，卫国大商人吕不韦到赵国都城邯郸去做生意，碰到在那里做人质的秦国公子异人。他决定做一次一本万利的政治买卖，就先到秦国讨得华阳夫人的欢心，让她认异人为儿子，帮助异人回国成为秦国国君，从而自己当上秦国的丞相"]},{"id":674,"word":"一本万殊","pinyin":"yī běn wàn shū","abbr":"ybws","explanation":"本：根源；万：许多；殊：不同。事物虽然千差万别，其实本源同一。比喻事物万变不离其宗。","source":{"text":"到这里只见得一本万殊，不见其他。","book":"宋·朱熹《朱子语类》卷二十七"},"example":{"text":"理散在事物，于是冥心求理，谓～。","book":"清·戴震《孟子字义疏证》卷下"}},{"id":675,"word":"一本十利","pinyin":"yī běn shí lì","abbr":"ybsl","explanation":"本：本钱；利：利润。本钱小，利润大。也比喻下的力量极小，得益却极大。","source":{"text":"这回破釜沉舟，远行一趟，却指望收它个一本万利哩。","book":"清·姬文《市声》第二十六回"},"example":{"text":"杀一个够本，杀两个有利，我今日非赚个～不可！","book":"梁羽生《萍踪侠影录》第二十回"}},{"id":676,"word":"一本正经","pinyin":"yī běn zhèng jīng","abbr":"ybzj","explanation":"原指一部合乎道德规范的经典。后用以形容态度庄重严肃，郑重其事。有时含讽刺意味。","source":{"text":"正经为道义之渊海，子书为增深之川流。","book":"晋·葛洪《抱朴子·百家》"},"example":{"text":"他说话从来都是～，不苟言笑。"},"similar":["道貌岸然","不苟言笑"],"opposite":["油嘴滑舌","油头滑脑","嬉皮笑脸"],"usage":"作谓语、定语、状语；形容人对事的态度"},{"id":677,"word":"一杖一条痕","pinyin":"yī zhàng yī tiáo hén","abbr":"yzyth","explanation":"打一棒子留下一条痕迹。比喻做事扎实，效果明显。","source":{"text":"大概圣人做事，如所谓一棒一条痕，一掴一掌血，直是恁地。","book":"《朱子语类》卷三十四"}},{"id":678,"word":"一条线儿拴两蚂蚱","pinyin":"yī tiáo xiàn er shuān liǎng mà zha","abbr":"ytxeslmz","explanation":"比喻二者命运相连，谁也不能单独走开","source":{"text":"因为咱们俩是一条线儿拴两蚂蚱，飞不了我，蹦不了你的。","book":"清·文康《儿女英雄传》第四回"},"usage":"作宾语、定语；用于口语"},{"id":679,"word":"一条藤儿","pinyin":"yī tiáo téng er","abbr":"ytte","explanation":"一条藤上长出来的枝条。比喻串通一气，站在同一立场上的人。","source":{"text":"可霎作怪！只见地下生出一条藤儿来，渐渐的长大，便生枝叶，然后开花，便见花谢，结一个小葫芦儿。","book":"明·罗贯中《平妖传》第十一回"},"example":{"text":"看这光景，两个人是～，这一个搬了，那一个有个不跟着走的吗？","book":"清·文康《儿女英雄传》第三十回"}},{"id":680,"word":"一条龙","pinyin":"yī tiáo lóng","abbr":"ytl","explanation":"比喻事物首尾相连，排成一条连续不断的线。也比喻生产程序或工作环节上的相关联的连续。","example":{"text":"我们提供～服务。"},"usage":"作定语；用于口语"},{"id":681,"word":"一来一往","pinyin":"yī lái yī wǎng","abbr":"ylyw","explanation":"形容动作的反复或交替。","source":{"text":"行者暗笑道：‘好是耳聋口哑！不要走！看棍！’那怪更不怕，乱舞枪遮拦。在那半空中，一来一往，一上一下，斗到三更时分，未见胜败。","book":"明·吴承恩《西游记》第六十七回"},"example":{"text":"到天色晚了，每船两盏明角灯，～，映著河里，上下明亮。","book":"清·吴敬梓《儒林外史》第四十一回"},"usage":"作宾语、定语；用于处事等"},{"id":682,"word":"一来二去","pinyin":"yī lái èr qù","abbr":"yleq","explanation":"指一回又一回，经过一段时间。表示逐渐的意思。","source":{"text":"一来二去，两个人就装糊涂了，倒象真的一样儿。","book":"清·曹雪芹《红楼梦》第五十八回"},"example":{"text":"后来～，渐渐的熟识。（清·石玉昆《三侠五义》第二十一回）"},"similar":["久而久之"],"opposite":["不相往来"],"usage":"作状语；表示逐渐","story":["贾母与李纨母子在一起聊天，贾宝玉提着蝈蝈笼进来，贾母指责他怎么不学习，同时夸奖贾兰有出息，将来肯定会顶门壮户。李纨想起贾珠来不住地流泪，见宝玉在就说要经常夸奖孩子，这样一来二去，孩子就会有长进"]},{"id":683,"word":"一来二往","pinyin":"yī lái èr wǎng","abbr":"ylew","explanation":"来来往往次数多。","example":{"text":"～，他们渐渐地成为好朋友。"},"similar":["你来我往","来来往往"],"usage":"作状语、分句；用于口语"},{"id":684,"word":"一杯羹","pinyin":"yī bēi gēng","abbr":"ybg","explanation":"一杯肉汁。多指可分享的部分利益。","source":{"text":"吾与项羽俱北面受命怀王，曰：约为兄弟。吾翁即若翁，必欲烹而翁，即幸分我一杯羹。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"战争刚结束，各派都来分～。"},"usage":"作宾语、定语；多用于“分”后","story":["楚汉相争时期，项羽担心长期对峙下去对他不利，于是抓了刘邦的父亲，扬言刘邦不投降就杀了他父亲炖成肉羹吃，刘邦听说后说我们两人是结拜兄弟，我的父亲也是你的父亲，如果杀了的话就分一杯羹给他。项羽听从项伯的劝告没有动手杀人"]},{"id":685,"word":"一板一眼","pinyin":"yī bǎn yīn yǎn","abbr":"ybyy","explanation":"比喻言语、行动有条理或合规矩。有时也比喻做事死板，不懂得灵活掌握。","source":{"text":"望着季交恕，一板一眼地说。","book":"李六如《六十年的变迁》第二卷第九章"},"example":{"text":"冷静，～打！","book":"鲁光《中国姑娘》"},"similar":["一板三眼"],"opposite":["乱七八糟","杂乱无章"],"usage":"作谓语、状语；用于为人处世"},{"id":686,"word":"一板三眼","pinyin":"yī bǎn sān yǎn","abbr":"ybsy","explanation":"板、眼：戏曲音乐的节拍。比喻言语、行动有条理或合规矩。有时也比喻做事死板，不懂得灵活掌握。","source":{"text":"老弟你看，如今的时势，就是孔圣人活过来，一板三眼的去做，也不过是个书呆子罢了。","book":"清·吴趼人《糊涂世界》卷六"},"example":{"text":"他说起话来总是慢条斯理，～，十分清楚。"},"similar":["一板一眼"],"usage":"作谓语、状语；用于为人处事","story":["清朝时期，著名作家吴趼人不满社会现状，对一板一眼的科举取士制度极为不满。他在《糊涂世界》中就有这样一段话：“老弟你看，如今的时势，就是孔圣人活过来，一板三眼的去做，也不过是个书呆子罢了。”"]},{"id":687,"word":"一板正经","pinyin":"yī bǎn zhèng jīng","abbr":"ybzj","explanation":"正经：端庄正派。原指一部合乎道德规范的经典。后用以形容态度庄重严肃，郑重其事。有时含讽刺意味。","source":{"text":"正经为道义之渊海，子书为增深之川流。","book":"晋·葛洪《抱朴子·百家》"},"example":{"text":"可是～地对先生说：“我这个破题做得很恰切，没有做错。”","book":"姚雪垠《李自成》第一卷第二十六章"},"similar":["一本正经"],"usage":"作谓语、定语、状语；形容人对事的态度"},{"id":688,"word":"一枕南柯","pinyin":"yī zhěn nán kē","abbr":"yznk","explanation":"指一场梦幻。","source":{"text":"唐·李公佐《南柯太守传》载，淳于棼梦到槐安国，娶了公主，任南柯太守，享尽富贵荣华。醒后才知道是一场大梦，原来槐安国就是庭前槐树下的蚁穴。"},"example":{"text":"明·张景《飞丸记·怜儒脱难》：“他黑甜～，门密扣，口轻哦。”"},"similar":["一枕槐安"],"usage":"作宾语、定语；指做梦","story":["传说古代淳于棼在古槐树下酒醉入梦，梦见一城楼上写着大槐安国，槐安国王招其为驸马，任南柯太守三十年，享尽荣华富贵。醒后发现槐树下有蚂蚁穴和树穴，这就是梦中的槐安国和南柯郡"]},{"id":689,"word":"一枕日红","pinyin":"yī zhěn rì hóng","abbr":"yzrh","explanation":"一觉睡到次日太阳升起。比喻因酣睡而起床晚。","source":{"text":"万井夜雨歇，一枕春日红。","book":"元·张端《次杨孟载对花诗》"}},{"id":690,"word":"一枕槐安","pinyin":"yī zhěn huái ān","abbr":"yzha","explanation":"槐安：指槐安梦，也称南柯梦。泛指梦境。也比喻一场空欢喜。","source":{"text":"卢生欠伸而寤，见方偃于邸中，顾吕翁在旁，主人蒸黄梁尚未熟，触类如故，蹶然而兴曰：岂其梦寐耶？","book":"唐·李泌《枕中记》"},"example":{"text":"分明是～，怎么的倒做了两下离愁。","book":"元·范子安《竹叶舟》第二折"},"similar":["黄粱美梦","一枕南柯"],"usage":"作宾语、定语；指做梦","story":["唐·李公佐《南柯太守传》小说中的故事，淳于棼在古槐树下酒醉入梦，梦见一城楼上写着大槐安国，槐安国王招其为驸马，任南柯太守三十年，享尽荣华富贵。醒后发现槐树下有蚂蚁穴和树穴，这就是梦中的槐安国和南柯郡"]},{"id":691,"word":"一枕邯郸","pinyin":"yī zhěn hán dān","abbr":"yzhd","explanation":"比喻虚幻的梦想。同“一枕黄粱”。","source":{"text":"唐·沉既济《枕中记》载，卢生在邯郸旅店中昼寝入梦，历尽富贵荣华，一觉醒来，主人黄粱尚未熟。"},"example":{"text":"李将军得遇高皇，万里名扬，万户勋偿。～，总是荒唐。","book":"清·厉鹗《折桂令·赋得客帐梦封侯》词"},"similar":["一枕黄粱"],"usage":"作宾语、定语；指做梦","story":["从前有一个穷困潦倒的书生卢生，在邯郸一个客店遇见道士吕翁。吕翁送他一个枕头，这时店主正开始做黄粱饭，卢生小睡一会，在梦中他中进士做宰相娶美妻，儿孙满堂，生活美满。梦醒后，主人的黄粱饭都还没做熟"]},{"id":692,"word":"一枕黄梁","pinyin":"yī zhěn huáng liáng","abbr":"yzhl","explanation":"原比喻人生虚幻。后比喻不能实现的梦想。","source":{"text":"卢生欠伸而寤，见方偃于邸中，顾吕翁在旁，主人蒸黄梁尚未熟，触类如故，蹶然而兴曰：岂其梦寐耶？","book":"唐·李泌《枕中记》"},"example":{"text":"他规划的远景不过是～罢了。"},"similar":["黄粱美梦","南柯一梦","痴心妄想"],"opposite":["如愿以偿","称心如意","春风得意"],"usage":"紧缩式；作宾语；含贬义"},{"id":693,"word":"一枕黄粱","pinyin":"yī zhěn huáng liáng","abbr":"yzhl","explanation":"原比喻人生虚幻。后比喻不能实现的梦想。","source":{"text":"卢生欠伸而寤，见方偃于邸中，顾吕翁在旁，主人蒸黄梁尚未熟，触类如故，蹶然而兴曰：岂其梦寐耶？","book":"唐·李泌《枕中记》"},"example":{"text":"他规划的远景不过是～罢了。"},"similar":["黄粱美梦","南柯一梦","痴心妄想"],"opposite":["如愿以偿","称心如意","春风得意"],"usage":"作宾语、定语；指做梦","story":["从前有一个穷困潦倒的书生卢生，在邯郸一个客店遇见道士吕翁。吕翁送他一个枕头，这时店主正开始做黄粱饭，卢生小睡一会，在梦中他中进士做宰相娶美妻，儿孙满堂，生活美满。梦醒后，主人的黄粱饭都还没做熟"]},{"id":694,"word":"一枕黑甜","pinyin":"yī zhěn hēi tián","abbr":"yzht","explanation":"形容酣畅地睡了一大觉。","source":{"text":"三杯软饱后,一枕黑甜余。","book":"宋·苏轼《发广州》"},"example":{"text":"只说方子衡把刘贵留在上海，住在兰芬院中，一天到晚没有一些事情，正是两餐老米饭，～乡。","book":"清·张春帆《九尾龟》第四十六回"}},{"id":695,"word":"一林二虎","pinyin":"yī lín èr hǔ","abbr":"yleh","explanation":"两只凶猛的老虎同处于一个森林。形容两个强有力的人或集团同处一地，势不两立。","source":{"text":"俗云：‘一林不藏二虎’，汝宜另寻他处，任汝附物骇人。","book":"清·魏文忠《绣云阁》第五十五回"}},{"id":696,"word":"一枝一叶总关情","pinyin":"yī zhī yī yè zǒng guān qíng","abbr":"yzyyzgq","explanation":"关情：关心，动情。对一枝一叶都细心关注。比喻对人民的疾苦细致入微的关怀。","source":{"text":"衙斋卧听萧萧竹, 疑是人间疾苦声。 些小吾曹州县吏, 一枝一叶总关情。","book":"清·郑燮《潍县署中画竹呈年伯包大中丞括》"}},{"id":697,"word":"一枝一栖","pinyin":"yī zhī yī qī","abbr":"yzyq","explanation":"比喻找到一份职业或栖身之所。","example":{"text":"希望黄老先生能鼎力介绍，俾得～。"}},{"id":698,"word":"一枝一节","pinyin":"yī zhī yī jié","abbr":"yzyj","explanation":"①本指树木的枝节。②比喻事物之细小部分。","source":{"text":"画树之窍，只在多曲，虽一枝一节，无有可直者。","book":"明·莫是龙《画说》"},"example":{"text":"文章以沉着痛快为最……间有一二不尽之言，言外之意，以少少许胜多多许者，是他～的好处，非六君子本色。","book":"清·郑燮《潍县署中与舍弟第五书》"},"similar":["一支半节","一肢一节"],"usage":"作宾语、定语；用于书面语"},{"id":699,"word":"一枝之栖","pinyin":"yī zhī zhī qī","abbr":"yzzq","explanation":"栖：鸟停留在树上。泛指一个工作位置。","source":{"text":"鹪鹩巢于深林，不过一枝。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"他只图～而已。"},"similar":["一席之地"],"usage":"作宾语；指容身之地"},{"id":700,"word":"一枝春","pinyin":"yī zhī chūn","abbr":"yzc","explanation":"用作梅花的别名或别后相思之意。","source":{"text":"折花逢驿使，寄与陇头人。江南无所有，聊赠一枝春。","book":"晋·陆凯《赠范晔诗》"},"example":{"text":"万乘靴袍御紫宸。挥毫敷丽藻，尽经纶。第名天陛首平津。东堂桂，重占～。","book":"宋·张先《感皇恩·中吕宫》词"}},{"id":701,"word":"一枝春信","pinyin":"yī zhī chūn xìn","abbr":"yzcx","explanation":"指梅花开放。","source":{"text":"恨眉羞敛，往事休重问。人去小庭空，有梅梢、一枝春信。檀心未展，谁为探芳丛，消瘦尽，洗妆匀，应更添风韵。","book":"宋·周邦彦《蓦山溪》词"},"example":{"text":"毕竟天涯同咫尺，～为君传。","book":"清·魏子安《花月痕》第三十一回"}},{"id":702,"word":"一枝独秀","pinyin":"yī zhī dú xiù","abbr":"yzdx","explanation":"指独自保持好的发展势头。","usage":"多用于褒义。"},{"id":703,"word":"一枝自足","pinyin":"yī zhī zì zú","abbr":"yzzz","explanation":"一枝：一根枝杈；足：满足。有一根枝杈也就满足了。比喻能得到维持生活的一席之地出就知足了。","source":{"text":"鹪鹩巢于深林，不过一枝。","book":"《庄子·逍遥游》"}},{"id":704,"word":"一柱承天","pinyin":"yī zhù chéng tiān","abbr":"yzct","explanation":"一根柱托住天。比喻人能担当天下重任。","source":{"text":"卿五山镇地，一柱擎天；气压乾坤，量含宇宙。","book":"唐·张固《独秀山》诗：“会得乾坤融结意，擎天一柱在南州。”《唐·大诏令集·赐陈敬瑄铁券文》"},"example":{"text":"西山古渊人莫测，～万牛力。","book":"元·袁桷《李士弘枯木风竹图》"},"similar":["一柱擎天"],"usage":"作定语；形容人的能力"},{"id":705,"word":"一柱擎天","pinyin":"yī zhù qíng tiān","abbr":"yzqt","explanation":"擎：托起。一根柱托住天。比喻人能担当天下重任。","source":{"text":"卿五山镇地，一柱擎天；气压乾坤，量含宇宙。","book":"唐·张固《独秀山》诗：“会得乾坤融结意，擎天一柱在南州。”《唐·大诏令集·赐陈敬瑄铁券文》"},"similar":["一柱承天","安危所系"],"usage":"作定语；形容人的能力","story":["远古时期，部落首领共工与颛顼争夺帝位，共工盛怒之下用头触碰了不周山，一下子把支撑天的东南方一根柱子和拴地的大绳子撞断了，天失去了支撑，向西北方向倾斜，天下的日月星辰向西北方向运转，大地上江河泥沙都向东南方向流去"]},{"id":706,"word":"一柱难支","pinyin":"yī zhù nán zhī","abbr":"yznz","explanation":"一根柱子难于支撑。比喻一个人的力量难以维持艰危的局势；艰巨的事业非一人之力所能胜任。","source":{"text":"木秀遭风折，兰芳同霰萎。千钧势易压，一柱力难支。","book":"唐·白居易《代书诗百韵寄微之》"},"similar":["一木难支","一木难扶"],"usage":"作宾语、定语；指个人能力有限"},{"id":707,"word":"一树百获","pinyin":"yī shù bǎi huò","abbr":"ysbh","explanation":"树：种植。种一次收获一百次。比喻培植人才能长期获益。","source":{"text":"一年之计，莫如树谷；十年之计，莫如树木；终身之计，莫如树人。一树一获者，谷也；一树十获者，木也；一树百获者，人也。","book":"《管子·权修》"},"usage":"作定语；指培育人才的效益"},{"id":708,"word":"一栖不两雄","pinyin":"yī qī bù liǎng xióng","abbr":"yqblx","explanation":"栖：禽鸟歇处。一个架上不能栖两只雄鸡。比喻两强对峙，势不两立。","source":{"text":"且两雄不俱立，楚汉久相持不决，百姓骚动，海内摇荡，农夫释耒，工女下机，天下之心未有所定也。","book":"《史记·郦生陆贾列传》"},"example":{"text":"～，妾原疑将军误信李公。","book":"蔡东藩《后汉演义》第七十二回"}},{"id":709,"word":"一栖两雄","pinyin":"yī qī liǎng xióng","abbr":"yqlx","explanation":"比喻两雄对峙，势不并存。","source":{"text":"毋弛而弓，一栖两雄。一栖两雄，其斗（喭页）（喭页）。","book":"《韩非子·扬权》"},"usage":"作宾语、定语；用于比喻句"},{"id":710,"word":"一根一板","pinyin":"yī gēn yī bǎn","abbr":"ygyb","explanation":"方言。原原本本，一五一十。"},{"id":711,"word":"一梦华胥","pinyin":"yī mèng huá xū","abbr":"ymhx","explanation":"后因称一场幻梦为“一梦华胥”。","source":{"text":"［黄帝］昼寝而梦，游于华胥氏之国。华胥氏之国在弇州之西，台州之北，不知斯齐国几千万里；盖非舟车足力之所及，神游而已。","book":"《列子·黄帝》"},"example":{"text":"暂离真境，来混尘俗，觑百年浮世，似～。","book":"元·谷子敬《城南柳》第一折"},"usage":"作宾语、定语；用于书面语"},{"id":712,"word":"一棍子打死","pinyin":"yī gùn zi dǎ sǐ","abbr":"ygzds","explanation":"比喻认为没有丝毫可取之处而全盘否定。","source":{"text":"不许人家发表错误的意见，发表了就‘一棍子打死’，这不是解决矛盾的办法。","book":"毛泽东《在中国共产党全国宣传工作会议上的讲话》"},"example":{"text":"你不能这样武断地～。"},"similar":["一棒子打死"],"usage":"作谓语、定语；指全盘否定"},{"id":713,"word":"一棍打一船","pinyin":"yī gùn dǎ yī chuán","abbr":"ygdyc","explanation":"比喻认为没有丝毫可取之处而全盘否定。","source":{"text":"哥哥的话虽是不错，但俗语说的，树大有枯枝，一国之大，自然是有好的有坏的，何必一棍打一船呢？","book":"梁启超《新中国未来记》第三回"},"example":{"text":"他说的话有理，一国之大，自然有好有坏的，又何必～呢？"},"usage":"作宾语、定语；用于处事"},{"id":714,"word":"一棒一条痕","pinyin":"yī bàng yī tiáo hén","abbr":"ybyth","explanation":"本为佛教禅宗习用语。后比喻做事着着落实或说话切中要害。","source":{"text":"须是一棒一条痕，一掴一掌血。","book":"宋·朱熹《朱子语类》第十卷"},"example":{"text":"时时刻刻须是～，一掴一掌血。","book":"明·王守仁《传习录》下卷"},"similar":["一棒一条痕，一掴一掌血"],"usage":"作宾语、分句；比喻做事扎实"},{"id":715,"word":"一棒一条痕，一掴一掌血","pinyin":"yī bàng yī tiáo hén，yī guó yī zhǎng xuè","abbr":"ybythygyzx","explanation":"掴：用巴掌要。打一棒子留下一条痕迹，打一巴掌手掌留下血迹。比喻做事扎实，效果明显。","source":{"text":"大概圣人做事，如所谓一棒一条痕，一掴一掌血，直是恁地。","book":"《朱子语类》卷三十四"},"example":{"text":"诸公在此，务要立个必为圣人之心，时时刻刻，须是～，方能听吾说话句句得力。","book":"明·王阳明《传习录》卷下"},"similar":["一鞭一条痕，一掴一掌血"],"usage":"作宾语、分句；比喻做事扎实"},{"id":716,"word":"一概抹杀","pinyin":"yī gài mǒ shā","abbr":"ygms","explanation":"抹杀：抹掉，勾销。画一笔，全部抹掉。比喻轻率地把成绩、优点全部否定。","source":{"text":"是时席元山虽狠愎，亦未敢遽执其事，尚请覆核，而世宗独断，直谓议礼新贵所昭雪，即跖蹻亦必曾史。遂将前后爰书，一笔抹杀。","book":"明·沈德符《万历野获编·嘉靖大狱张本》"},"example":{"text":"此乃做书人持平之论；若是～，便不成为恕道了。","book":"清·李宝嘉《官场现形记》第三十四回"}},{"id":717,"word":"一概抹煞","pinyin":"yī gài mǒ shā","abbr":"ygms","explanation":"抹煞：抹掉，勾销。画一笔，全部抹掉。比喻轻率地把成绩、优点全部否定。","source":{"text":"是时席元山虽狠愎，亦未敢遽执其事，尚请覆核，而世宗独断，直谓议礼新贵所昭雪，即跖蹻亦必曾史。遂将前后爰书，一笔抹杀。","book":"明·沈德符《万历野获编·嘉靖大狱张本》"},"example":{"text":"这两件东西当然流毒无穷，可是也不能～。","book":"钱钟书《围城》第二章"}},{"id":718,"word":"一概而言","pinyin":"yī gài ér yán","abbr":"ygey","explanation":"一概：同一标准，一律。指处理事情或问题不分性质，不加区别，用同一标准来对待或处理。","source":{"text":"同糅玉石兮，一而相量。","book":"战国·楚·屈原《怀沙》"},"similar":["一概而论"],"usage":"作谓语、宾语；用于否定句"},{"id":719,"word":"一概而论","pinyin":"yī gài ér lùn","abbr":"ygel","explanation":"一概：同一标准，一律。指处理事情或问题不分性质，不加区别，用同一标准来对待或处理。","source":{"text":"而作者安可以方古，一概而论得失？","book":"《楚辞·九章·怀沙》：“同糅玉石兮，一而相量。”唐·刘知几《史通·叙事》"},"example":{"text":"我们对具体问题要做具体分析，决不能～。"},"similar":["相提并论","同日而语","等量齐观"],"opposite":["天壤之别","明辨是非"],"usage":"作主语、谓语、宾语；用于否定句"},{"id":720,"word":"一榜尽赐","pinyin":"yī bǎng jìn cì","abbr":"ybjc","explanation":"指考生全部被录取。","source":{"text":"有旨一榜尽除京官通判。","book":"宋·邵伯温《闻见前录》卷七"},"example":{"text":"太宗不悦，特开创例，令～京官，齐贤乃得出仕。","book":"蔡东藩《宋史演义》第十五回"}},{"id":721,"word":"一榻横陈","pinyin":"yī tà héng chén","abbr":"ythc","explanation":"形容人在床上横躺着。","source":{"text":"小莲玉体横陈夜，已报周师入晋阳。","book":"唐·李商隐《北齐》诗之一"},"example":{"text":"一日之中，除去干事游玩的时候，无法～。","book":"清·彭养鸥《黑籍冤魂》第16回"},"usage":"作谓语、定语；指睡觉"},{"id":722,"word":"一榻胡涂","pinyin":"yī tà hú tú","abbr":"ytht","explanation":"形容混乱或败坏到了不可收拾的程度。同“一塌糊涂”。","source":{"text":"《铁流》在北平有翻版了，坏纸错字，弄得一榻胡涂。","book":"鲁迅《书信集·致曹靖华》"},"similar":["一塌胡涂","一塌糊涂"],"opposite":["井井有条"],"usage":"作谓语、定语、宾语、状语；指混乱局面"},{"id":723,"word":"一槌定音","pinyin":"yī chuí dìng yīn","abbr":"ycdy","explanation":"借指凭一句话作出最后决定。同“一锤定音”。","source":{"text":"一张张笑脸，圆的、长的、苦的、甜的，都来请示，都来要求指点迷津。真神，一槌定音，无处不响。","book":"朱可 若丁《深深的绿巷》"},"similar":["一锤定音"],"usage":"作谓语、宾语、定语、分句；用于处事"},{"id":724,"word":"一模一样","pinyin":"yī mó yī yàng","abbr":"ymyy","explanation":"样子完全相同。","source":{"text":"今日抬头一看，却见他黄着脸、秃着头，就和前日梦里揪他的师姑一模一样，不觉就懊恼起来。","book":"清·吴敬梓《儒林外史》第五十四回"},"example":{"text":"这两件衣服从颜色到款式虽然～，但质量却有很大差别。"},"similar":["毫无二致","毫发不爽","如出一辙"],"opposite":["截然不同","天差地别","大相径庭"],"usage":"作谓语、定语；形容人或物"},{"id":725,"word":"一模二样","pinyin":"yī mó èr yàng","abbr":"ymey","explanation":"犹言一模一样。样子完全相同。","source":{"text":"又或有将金银珠宝首饰来解的，他看得金子有十分成数，便一模二样，暗地里打造来换了。","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"example":{"text":"适才礼物里边，有一件压钗的东西，也是一个玉蟾蜍，与前日凤官人与姐姐的～。","book":"明·凌濛初《二刻拍案惊奇》卷九"},"similar":["一模一样"],"usage":"作谓语、定语、状语；用于书面语"},{"id":726,"word":"一步一个脚印","pinyin":"yī bù yī gè jiǎo yìn","abbr":"ybygjy","explanation":"比喻做事踏实。","source":{"text":"只有正正堂堂，一步一个脚印的妇人才能负此重任。","book":"老舍《正红旗下》"},"example":{"text":"我们要做到～。"},"similar":["脚踏实地"],"usage":"作宾语、分句；用于口语"},{"id":727,"word":"一步一计","pinyin":"yī bù yī jì","abbr":"ybyj","explanation":"指人善于使用计谋，诡计多端。","example":{"text":"诸葛亮～，周瑜拿他没辙。"},"similar":["足智多谋"],"usage":"作谓语、定语；指足智多谋的人","story":["五代时期，后唐君王李克用在魏博地区与梁军作战，他察看地形发现敌城墙上的旗帜飘来飘去，他知道梁朝的刘鄩一步一计，就派人前去侦察，发现刘鄩的军队早已撤离，只是用驴驮着旗帜在城墙边来回行走罢了"]},{"id":728,"word":"一步一趋","pinyin":"yī bù yī qū","abbr":"ybyq","explanation":"步：行走；趋：快走。别人走一步，他也走一步。形容事事模仿或追随别人","source":{"text":"只好叠著精神，稳著步儿，探著腰儿，挺著胸儿，直著颈儿，一步一趋，望前而行。","book":"清·李汝珍《镜花缘》第19回"},"example":{"text":"李劼人《大波》第一部第一章：“老顽固们还更骂我是维新派，是～在学周孝怀、周观察。”"},"similar":["亦步亦趋"],"usage":"作谓语、定语、状语；指没主见"},{"id":729,"word":"一步一鬼","pinyin":"yī bù yī guǐ","abbr":"ybyg","explanation":"走一步路就好像碰到一个鬼。形容遇事多疑。","source":{"text":"人病则忧惧，忧惧见鬼出……昼日则鬼见，暮卧则梦闻。","book":"汉·王充《论衡·订鬼》"},"example":{"text":"俗有～之语，却本之《论衡》","book":"清·王应奎《柳南随笔·俗语有本》"},"similar":["疑心生暗鬼"],"usage":"作宾语、定语；指遇事多疑"},{"id":730,"word":"一步三摇","pinyin":"yī bù sān yáo","abbr":"ybsy","explanation":"指人走路摇晃或者悠闲自得的样子","source":{"text":"嘱咐家丁看门户，他这才一步三摇来到大门。","book":"清·无名氏《刘公案》第29回"},"usage":"作谓语、状语；用于口语"},{"id":731,"word":"一步到位","pinyin":"yī bù dào wèi","abbr":"ybdw","explanation":"只经过一个步骤就把事情办完办好。"},{"id":732,"word":"一步登天","pinyin":"yī bù dēng tiān","abbr":"ybdt","explanation":"登：上。一步跨上青天。比喻一下子就达到很高的境界或程度。有时也用来比喻人突然得志，爬上高位。","source":{"text":"巡检作巡抚，一步登天，监生当监临，斯文扫地。","book":"清·徐珂《清稗类钞·三十四》"},"example":{"text":"知识要通过学习逐渐积累，想～是不可能的。"},"similar":["一鸣惊人","飞黄腾达","平步青云"],"opposite":["一落千丈","一蹶不振"],"usage":"作谓语、宾语；指人突然得志","story":["宋朝东京开封破落户高俅从狱中出来后，来到临淮州投奔开赌坊的柳大郎。柳大郎将他介绍到东京城里开药铺的董将士，董将士将他送到小苏学士家。苏学士送进小王都太尉府当差，被端王爷看中留在府中。端王爷成为宋徽宗，高俅当上太尉"]},{"id":733,"word":"一死一生","pinyin":"yī sǐ yī shēng","abbr":"ysys","explanation":"指有关生死的关键时刻。","source":{"text":"太史公曰：始翟公为廷尉，宾客阗门；及废，门外可设雀罗。翟公复为廷尉，宾客欲往，翟公乃大署其门曰：‘一死一生，乃知交情。’","book":"《史记·汲郑列传》"},"example":{"text":"情知白日不可私，～何足算。","book":"唐·王翰《相和歌辞·蛾眉怨》"},"usage":"作宾语、定语；指两极变化","story":["西汉时期，廷尉翟公为人豪爽，喜欢结交天下有识之士，因此家中宾客很多，因而有人嫉妒进谗言，汉武帝罢免了他的官职。平时门上的常客不上门了，而且绕道而行。后来翟公官复原职，那些人又回来，翟公在门上写道：“一死一生，乃知交情。”"]},{"id":734,"word":"一毛不拔","pinyin":"yī máo bù bá","abbr":"ymbb","explanation":"一根汗毛也不肯拔。原指杨朱的极端为我主义。后形容为人非常吝啬自私。","source":{"text":"杨子取为我，拔一毛而利天下，不为也。","book":"《孟子·尽心上》"},"example":{"text":"沈姑娘，你也太拿老了！叫我们管山吃山，管水吃水，都象你这～，我们喝西北风。","book":"清·吴敬梓《儒林外史》第四十一回"},"similar":["斤斤计较","锱铢必较","爱财如命"],"opposite":["一掷千金","挥金如土"],"usage":"作谓语、定语；指吝啬鬼","story":["战国时期，百家争鸣，墨家学派代表墨翟主张“兼爱”、“非攻”，反对自私自利和无原则的仇杀，对立派杨朱则主张一切从自我的利益出发，即“为我”。墨翟的学生禽滑厘问杨朱：“你愿意拔你身上的一毛而利天下吗？”杨朱不允"]},{"id":735,"word":"一毛吞海","pinyin":"yī máo tūn hǎi","abbr":"ymth","explanation":"毛：同“蚝”，蛤蜊。一只蛤蜊吞吸海水。比喻无损于事。","source":{"text":"一毛吞海，海性无亏。纤芥投锋，锋利不动。学与无学唯我知焉。","book":"宋·释道原《景德传灯录》卷十五"}},{"id":736,"word":"一毛片甲","pinyin":"yī máo piàn jiǎ","abbr":"ympj","explanation":"比喻零星片段的事物。","source":{"text":"三年中作变律诗九首，上广州李帅，其文意长于讽刺，亦有陈拾遗一鳞半甲。","book":"唐·高仲武《中兴闲气集·苏涣》"}},{"id":737,"word":"一毫不取","pinyin":"yī háo bù qǔ","abbr":"yhbq","explanation":"一毫：一根毫毛，比喻极其微小的东西。连一根毫毛那样微不足道的小东西也不拿人家的。形容为人廉洁，不占他人或公家的便宜。","source":{"text":"且夫天地之间，物各有主；苟非吾之所有，虽一毫而莫取。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"利物是小事，他若肯让奴赢了，奴～，私下仍旧还他。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"usage":"作谓语、定语、状语；用于处事"},{"id":738,"word":"一毫不差","pinyin":"yī háo bù chā","abbr":"yhbc","explanation":"指完全相同，没有一点差异。","source":{"text":"纵然是一个模子铸的，好道打磨不到，也有多个瘢儿，少个蒂儿，却怎么这等一毫不差。","book":"明·吴承恩《西游记》第71回"},"example":{"text":"我曾经拿了他的译文与先生的对照，觉得与先生所译的～。","book":"鲁迅《集外集拾遗·关于》附王铸《给鲁迅先生的一封信》"},"similar":["丝毫不差"],"opposite":["天差地别"],"usage":"作谓语、宾语；指完全相同"},{"id":739,"word":"一毫不拔","pinyin":"yī háo bù bá","abbr":"yhbb","explanation":"一根毫毛也不肯拔。原指杨朱的极端为我主义。后形容为人非常吝啬自私。","source":{"text":"杨子取为我，拔一毛而利天下，不为也。","book":"《孟子·尽心上》"}},{"id":740,"word":"一毫不染","pinyin":"yī háo bù rǎn","abbr":"yhbr","explanation":"指一尘不染。","source":{"text":"即其可名状者言之，则本之一毫不染之真，而加之百折不移之守。","book":"明·吴承恩《赠郡伯古愚邵公报政序》"},"similar":["一尘不染","一干二净"],"opposite":["贪得无厌"],"usage":"作谓语、定语；指一尘不染"},{"id":741,"word":"一毫不苟","pinyin":"yī háo bù gǒu","abbr":"yhbg","explanation":"指十分认真，一丝不苟。","source":{"text":"断断是再来人，一毫不苟，一丝不挂，诚然而来，诚然而往。","book":"清·冒襄《影梅庵忆语》"},"example":{"text":"清·冒襄《影梅庵忆语》：“断断是再来人，～，一丝不挂，诚然而来，诚然而往。”"},"similar":["一丝不苟","小心谨慎"],"opposite":["粗枝大叶","马马虎虎"],"usage":"作谓语、定语、状语；同“一丝不苟”"},{"id":742,"word":"一毫千里","pinyin":"yī háo qiān lǐ","abbr":"yhql","explanation":"指差错虽微，造成的危害甚大。","source":{"text":"据《易说》言也。","book":"语出《礼记·经解》：“《易》曰‘君子慎始；差若豪（毫）牦，缪以千里’。”《大戴礼记·保傅》：“《易》曰‘正其本，万物理；失之毫厘，差之千里’，故君子慎始也。”卢辩注"},"example":{"text":"清·空石长者《五星捉脉·论穴星葬法》：“所谓～，一指万山也。”"},"usage":"作宾语、定语；用于比喻句"},{"id":743,"word":"一毫莫取","pinyin":"yī háo mò qǔ","abbr":"yhmq","explanation":"一毫：一根毫毛，比喻极其微小的东西。连一根毫毛那样微不足道的小东西也不拿人家的。形容为人廉洁，不占他人或公家的便宜。","source":{"text":"且夫天地之间，物各有主；苟非吾之所有，虽一毫而莫取。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"劝人生、且随缘分，分外～。","book":"宋·汪晫《贺新郎》词"}},{"id":744,"word":"一民同俗","pinyin":"yī mín tóng sú","abbr":"ymts","explanation":"指使人民的思想风俗齐同。","source":{"text":"古者百里而异习，千里而殊俗。故明王修道，一民同俗。","book":"语出《晏子春秋·问上十八》"},"usage":"作谓语、定语；用于书面语"},{"id":745,"word":"一气呵成","pinyin":"yī qì hē chéng","abbr":"yqhc","explanation":"一口气做成。形容文章结构紧凑，文气连贯。也比喻做一件事安排紧凑，迅速不间断地完成。","source":{"text":"若‘风急天高’，则一篇之中句句皆律，一句之中字字皆律，而实一意贯串，一气呵成。","book":"明·胡应麟《诗薮·近体中》"},"example":{"text":"北曲之介白者每折不过数言，即抹去宾白而止阅填词，亦皆～，无有断续。","book":"清·李渔《闲情偶寄·宾白第四》"},"similar":["一鼓作气","势如破竹","一挥而就"],"opposite":["一波三折","老牛破车"],"usage":"作谓语、定语、状语；用于文章等"},{"id":746,"word":"一气浑成","pinyin":"yī qì hún chéng","abbr":"yqhc","explanation":"形容诗文首尾贯通，完满自然，不见雕凿。","source":{"text":"以诗志别，分韵得‘秋’字，援笔立就，一气浑成。","book":"明·谢榛《四溟诗话》卷四"},"example":{"text":"诗有有篇无句者，通首清老，～，恰无佳句令人传诵。","book":"清·袁枚《随园诗话》卷五"},"similar":["一气呵成"],"usage":"作谓语、状语；用于写作等"},{"id":747,"word":"一水之隔","pinyin":"yī shuǐ zhī gé","abbr":"yszg","explanation":"受一条河水的阻隔。比喻双方因受水路交通不便而很少会面。","source":{"text":"山中苦寒，法体清康。一水之隔，无缘躬诣道场，少闻謦欬。","book":"《古诗十九首》其一：“河汉清且浅，相去复几许，盈盈一水间，眽眽不得语。”宋·苏轼《与佛印禅师》"}},{"id":748,"word":"一水隔","pinyin":"yī shuǐ gé","abbr":"ysg","explanation":"受一条河水的阻隔。比喻双方因受水路交通不便而很少会面。","source":{"text":"渺然一水隔，何由税归鞅？","book":"《古诗十九首》其一：“河汉清且浅，相去复几许，盈盈一水间，眽眽不得语。”唐·李白《酬裴侍御对雨感时见赠》"},"example":{"text":"我住浙江西，君去浙江东。勿言～，便与千里同。富贵无人劝君酒，今宵为我尽杯中。","book":"唐·白居易《席上答微之》"}},{"id":749,"word":"一沐三捉发","pinyin":"yī mù sān zhuō fà","abbr":"ymszf","explanation":"比喻求贤心切。","source":{"text":"我一沐三捉发，一饭三吐哺，起以待士，犹恐失天下之贤人。","book":"《史记·鲁周公世家》"},"similar":["一沐三渥发","一沐三握发"],"usage":"作宾语、定语；用于书面语","story":["西周时期，周成王继承父亲的遗志，分封诸侯，他封伯禽为鲁侯，周公向兄弟伯禽祝贺，说：“你以前是鲁国的有名能士，你到任后不要忘记你是周文王的儿子，周武王的弟弟，现今成王的叔叔。你要一沐三握发，一饭三吐哺，爱惜人才。”"]},{"id":750,"word":"一沐三捉发，一饭三吐哺","pinyin":"yī mù sān zhuō fà，yī fàn sān tǔ bǔ","abbr":"ymszfyfstb","explanation":"沐：洗头；捉：用手攥住；哺：口中含的食物。洗一次头与吃一顿饭要停顿三次。形容渴求贤才，谦恭下士。形容为延揽贤才而忙碌","source":{"text":"然我一沐三捉发，一饭三吐哺，起以待士，犹恐失天下之贤人。","book":"西汉·司马迁《史记·鲁周公世家》"},"similar":["一沐三捉发","一饭三吐哺"],"usage":"作宾语、定语；可分开使用","story":["西周时期，周成王继承父亲的遗志，分封诸侯，他封伯禽为鲁侯，周公向兄弟伯禽祝贺，说：“你以前是鲁国的有名能士，你到任后不要忘记你是周文王的儿子，周武王的弟弟，现今成王的叔叔。你要一沐三握发，一饭三吐哺，爱惜人才。”"]},{"id":751,"word":"一沐三握发","pinyin":"yī mù sān wò fà","abbr":"ymswf","explanation":"沐：洗头；握：用手攥住。洗一次头发中间要停下来三次。比喻求贤心切。","source":{"text":"吾文王之子，武王之弟，成王之叔父也，又相天下，吾於天下亦不轻矣，然一沐三握发，一饭三吐哺，犹恐失天下之士。’","book":"汉·韩婴《韩诗外传》卷三"},"example":{"text":"而文王日昃不暇食，周公～，何哉？","book":"《晋书·顾荣传》"},"similar":["一沐三渥发","一沐三捉发"],"usage":"作宾语、定语；用于书面语"},{"id":752,"word":"一沐三渥发","pinyin":"yī mù sān wò fà","abbr":"ymswf","explanation":"沐：洗头。洗一次头要停顿三次。形容渴求贤才，谦恭下士","example":{"text":"古人～的故事值得现代人学习"},"similar":["一沐三握发","一沐三捉发"],"usage":"作宾语、定语；用于书面语"},{"id":753,"word":"一治一乱","pinyin":"yī zhì yī luàn","abbr":"yzyl","explanation":"治：太平盛世。在社会发展的历史进程中，太平盛世与乱世相间隔。","source":{"text":"天下之生久矣，一治一乱。","book":"《孟子·滕文公下》"},"example":{"text":"余常疑孟子～之言，何三代而下之有乱无治也？","book":"清·黄宗羲《明夷待访录》"},"usage":"作宾语、定语；用于书面语"},{"id":754,"word":"一泓清水","pinyin":"yī hóng qīng shuǐ","abbr":"yhqs","explanation":"泓：水清的样子。一片明净清澈的水。比喻心地纯洁。","source":{"text":"譬如一泓清水，有少许砂土便见。","book":"宋·朱熹《朱子语类》卷一百十三"},"example":{"text":"真是～，荡浆轻摇，过了几个湾，转到断崖村。","book":"清·褚人获《隋唐演义》第六十七回"}},{"id":755,"word":"一波万波","pinyin":"yī bō wàn bō","abbr":"ybwb","explanation":"比喻事情开端后的不断发展变化。同“一波才动万波随”。","source":{"text":"冷暖旧雨今雨，是非一波万波。","book":"宋·范成大《题请息斋》诗之八"},"similar":["一波才动万波随"],"usage":"作宾语、定语；用于书面语"},{"id":756,"word":"一波三折","pinyin":"yī bō sān zhé","abbr":"ybsz","explanation":"波：指书法中的捺；折：指写字时转笔锋。原指写字的笔法曲折多变。现比喻文章的结构起伏曲折。也比喻事情进行中意外的变化很多。","source":{"text":"然其一波三折笔之势，亦自不苟。","book":"晋·王羲之《题卫夫人笔阵图》：“每作一波，常三过折笔。”《宣和书谱·太上内景神经》卷五"},"example":{"text":"词既凄清，声亦缠绵跌宕，有～之致。","book":"清·王韬《淞隐漫录·严萼仙》"},"similar":["曲曲折折"],"opposite":["一帆风顺"],"usage":"作谓语、宾语；比喻事情进行中意外的变化"},{"id":757,"word":"一波才动万波随","pinyin":"yī bō cái dòng wàn bō suí","abbr":"ybcdwbs","explanation":"指一波方动，万波随之而起。比喻事情开端后的不断发展变化。","source":{"text":"千尺丝纶直下垂，一波才动万波随。","book":"宋·惠洪《冷斋夜话·船子和尚偶》"},"example":{"text":"奇外无奇更出奇，～。只知诗到苏黄尽，沧海横流却是谁？","book":"金·元好问《论诗》诗之二二"},"similar":["一波万波"],"usage":"作宾语、定语；用于书面语"},{"id":758,"word":"一波未平，一波又起","pinyin":"yī bō wèi píng，yī bō yòu qǐ","abbr":"ybwpybyq","explanation":"一个浪头尚未平复，另一个浪头又掀起了。比喻事情进行波折很多，一个问题还没有解决，另一个问题又发生了。","source":{"text":"波澜开阖，如在江湖中，一波未平，一波已作。","book":"唐·刘禹锡《浪淘沙》词：“流水淘沙不暂停，前波未灭后波生。”宋·姜夔《白石道人诗说》"},"example":{"text":"这个故事的情节曲折生动，真是～，层层推进，引人入胜。"},"similar":["一波三折"],"opposite":["风平浪静"],"usage":"作宾语、分句；比喻事情波折很多"},{"id":759,"word":"一波未成，一波已作","pinyin":"yī bō wèi chéng，yī bō yǐ zuò","abbr":"ybwcybyz","explanation":"一个波浪还没形成，另一个波浪又起来了","source":{"text":"波澜开阖，如在江湖中，一波未成，一波已作。","book":"宋·姜夔《白石道人诗说》"},"similar":["一波未平，一波又起"],"usage":"作宾语、分句；比喻事情波折很多"},{"id":760,"word":"一泻万里","pinyin":"yī xiè wàn lǐ","abbr":"yxwl","explanation":"形容江河水势奔流直下，流得又快又远。同“一泻千里”。","source":{"text":"这一条浩浩荡荡的民族革命运动史的洪流，时而显现，时而潜伏，时而迂回旋绕，蓄势不前，时而急转直下，一泻万里。","book":"李大钊《孙中山先生在中国民族革命史上之位置》"},"similar":["一泻百里","一泻千里"],"usage":"作谓语、定语、宾语；指速度快"},{"id":761,"word":"一泻千里","pinyin":"yī xiè qiān lǐ","abbr":"yxql","explanation":"泻：水往下直注。形容江河奔流直下，流得又快又远。也比喻文笔或乐曲气势奔放。也形容价格猛跌不止。","source":{"text":"大江在河，一泻千里。","book":"唐·李白《赠从弟宣州长史昭》诗：“长川豁中流，千里泻吴会。”宋·陈亮《与辛幼安殿撰书》"},"example":{"text":"方希直如奔流滔滔，～，而潆洄滉瀁之状颇少。","book":"明·王世贞《文评》"},"similar":["一日千里","一落千丈","一蹶不振"],"opposite":["迂回曲折","斗折蛇行"],"usage":"作谓语、定语、宾语；指速度快"},{"id":762,"word":"一泻汪洋","pinyin":"yī xiè wāng yáng","abbr":"yxwy","explanation":"形容水流迅速，水势浩大。","source":{"text":"一泻汪洋。","book":"梁启超《谭嗣同传》"},"usage":"作谓语；形容水流迅速"},{"id":763,"word":"一泻百里","pinyin":"yī xiè bǎi lǐ","abbr":"yxbl","explanation":"形容江河水势奔流直下，流得又快又远。同“一泻千里”。","source":{"text":"悬流轰轰射水府，一泻百里翻云涛。","book":"唐·韩愈《贞女峡》诗"},"similar":["一泻万里","一泻千里"],"usage":"作谓语、定语、宾语；指速度快"},{"id":764,"word":"一洗空","pinyin":"yī xǐ kōng","abbr":"yxk","explanation":"洗：洗刷，清洗。清洗得一干二净。","source":{"text":"青山万里静散地，白雨一洗空垂萝。","book":"唐·杜甫《寄柏学士林居》"},"example":{"text":"万山秀色浑钟尽，六月炎光～。","book":"宋·范成大《鹧鸪天》词"}},{"id":765,"word":"一洗而空","pinyin":"yī xǐ ér kōng","abbr":"yxek","explanation":"洗：洗刷，清洗。清洗得一干二净。","source":{"text":"易世之怨，一洗而空。","book":"宋·陈亮《谢同知启》"},"example":{"text":"“西施”二字为句绝，然后～之。","book":"元·胡存善《类聚名贤乐府群玉》卷一"}},{"id":766,"word":"一洞之网","pinyin":"yī dòng zhī wǎng","abbr":"ydzw","explanation":"只有一个洞的网。","source":{"text":"有鸟将来，张罗而待之，得鸟者罗之一目也。今为一目之罗，则无时得鸟矣。","book":"西汉·刘安《淮南子·说山训》"},"example":{"text":"做买卖得有几手，否则就像～，什么也捞不到。"},"similar":["一目之罗"],"usage":"作宾语；指自作聪明的人","story":["从前有一个人看到别人布网捕鸟，发现被捕的鸟每只鸟头才钻一个网眼，心想既然如此，何必结网呢？他回家便剪断长绳做成一个个圈圈，别人问他作什么用，他笑而不答并庆幸自己一孔之见，就找了一个没人的地方安好这一洞之网，结果一只鸟儿也没捕上"]},{"id":767,"word":"一洼死水","pinyin":"yī wā sǐ shuǐ","abbr":"ywss","explanation":"洼：水坑。一池子死水。比喻停滞不前的沉闷局面。","source":{"text":"一洼死水全无浪，也有春风摆动时。","book":"明·兰陵笑笑生《金瓶梅词话》第十七回"}},{"id":768,"word":"一派胡言","pinyin":"yī pài hú yán","abbr":"yphy","explanation":"指不切实际的言语。","source":{"text":"这畜生说什么乘人不备逃出来，那全是他一派胡言罢了。","book":"清·无垢道人《八仙全传》第12回"},"example":{"text":"我不相信你的～。"},"similar":["胡说八道"],"usage":"作宾语、定语；用于口语"},{"id":769,"word":"一浆十饼","pinyin":"yī jiāng shí bǐng","abbr":"yjsb","explanation":"一碗浆，十个饼。比喻小恩小惠。","source":{"text":"公初不示诸将腹心，而今委以兵，此皆嗜利者，朝廷以一浆十饼诱之，去矣。","book":"《新唐书·李正己传》"},"similar":["小恩小惠"],"usage":"作宾语、定语；指小恩小惠"},{"id":770,"word":"一清二楚","pinyin":"yī qīng èr chǔ","abbr":"yqec","explanation":"十分清楚、明白。","source":{"text":"小顺儿样样事情都要闹个一清二楚，不然怎么能当好妈妈的保镖呢。","book":"老舍《四世同堂》"},"example":{"text":"事情已经～了，你再争辩也没有用。"},"similar":["黑白分明","一目了然","一清二白"],"opposite":["含糊其词","模糊不清","若明若暗"],"usage":"作谓语、补语、状语；指十分清楚"},{"id":771,"word":"一清二白","pinyin":"yī qīng èr bái","abbr":"yqeb","explanation":"比喻十分清白。亦比喻非常清楚。","source":{"text":"我姓韩的桥是桥，路是路，一清二白的，怕谁来歪我不成。","book":"茅盾《劫后拾遗》四：“你还不相信我吗？我在这里混了这半年，素来一清二白。”周立波《暴风骤雨》第一部七"},"example":{"text":"我们的一善一恶，只以为天老爷每天在头上记得～；想不到，给咱记善恶薄的竟是这帮穷爷，报应真快呀！"},"similar":["一尘不染","一清二楚","黑白分明"],"opposite":["一团漆黑","一塌糊涂","雾里看花"],"usage":"作谓语、定语、补语；指非常清白"},{"id":772,"word":"一清如水","pinyin":"yī qīng rú shuǐ","abbr":"yqrs","explanation":"清·清澈。像流水一样清澈。形容为官廉洁，不贪污、不受贿。也形容十分清洁。","source":{"text":"你在衙门中一清如水，朝廷知你是个个廉吏，异日定来聘你为官。","book":"明·周楫《西湖二集·祖统制显灵救驾》"},"example":{"text":"老哥，你别拿人开心。谁不知戴二爷一向是～。（清·李宝嘉《官场现形记》第三回）"},"similar":["清正廉洁"],"opposite":["贪污受贿"],"usage":"作谓语、定语；指为人处世等"},{"id":773,"word":"一渊不两蛟","pinyin":"yī yuān bù liǎng jiāo","abbr":"yyblj","explanation":"比喻两雄不能并立。","source":{"text":"一渊不两蛟，水定则清正。","book":"《文子·上德》：“一渊不两蛟，一雌不二雄，一即定，两即争。”《淮南子·说山训》"},"example":{"text":"西汉·刘安《淮南子·说山训》：“～，水定则清正。”"},"usage":"作宾语、定语；用于比喻句"},{"id":774,"word":"一游一豫","pinyin":"yī yóu yī yù","abbr":"yyyy","explanation":"豫：游乐。常指帝王的游乐生活。","source":{"text":"吾王不游，吾何以休？吾王不豫，吾何以助？一游一豫，为诸侯度。","book":"《孟子·梁惠王下》"},"example":{"text":"共庆天田成礼后，圣主～。","book":"《清史稿·乐志五》"},"similar":["一豫一游"],"usage":"作谓语、定语；用于书面语"},{"id":775,"word":"一湾死水","pinyin":"yī wān sǐ shuǐ","abbr":"ywss","explanation":"一池子死水。比喻停滞不前的沉闷局面。","source":{"text":"一洼死水全无浪，也有春风摆动时。","book":"明·兰陵笑笑生《金瓶梅词话》第十七回"}},{"id":776,"word":"一溃千里","pinyin":"yī kuì qiān lǐ","abbr":"ykql","explanation":"溃：溃败，溃逃。形容败得不可收拾。"},{"id":777,"word":"一溜烟","pinyin":"yī liú yān","abbr":"yly","explanation":"形容跑得很快。","source":{"text":"说罢了这一句，便一溜烟外面去了。","book":"清·曹雪芹《红楼梦》第一百五回：“那些亲友听见，就一溜烟如飞的出去了。”清·李宝嘉《官场现形记》第五回"},"example":{"text":"那捉他的巡捕见问官和他认得，便～走了。","book":"清·吴研人《二十年目睹之怪现状》第二十八回"},"similar":["一转眼"],"usage":"作状语、定语；指很快"},{"id":778,"word":"一溜风","pinyin":"yī liù fēng","abbr":"ylf","explanation":"形容跑得很快。","source":{"text":"心下大喜，将书藏在柏中，复翻身爬出窗外，将窗扇依旧闭上，一溜风走到方丈里坐定，悄悄开书，默诵那词咒。","book":"明·清溪道人《禅真逸史》第二十一回"},"example":{"text":"童奶奶连忙收拾了身上，雇了个驴，～回到娘家。","book":"清·西周生《醒世姻缘传》第八十四回"}},{"id":779,"word":"一潭死水","pinyin":"yī tán sǐ shuǐ","abbr":"ytss","explanation":"潭：深水坑。一池子死水。比喻停滞不前的沉闷局面。","source":{"text":"我正忒坎坷，自怨咨，九重天忽有君恩至，正是一湾死水全无浪，也有春风摆动时。","book":"元·戴善夫《陶学士醉写风光好》"},"example":{"text":"他们所在的这个偏僻的农场，是像～似的地方。","book":"张贤亮《灵与肉》"},"similar":["一成不变","故步自封","因循守旧"],"opposite":["一泻千里","万马奔腾","龙腾虎跃"],"usage":"作主语、宾语；指沉闷局面"},{"id":780,"word":"一灯如豆","pinyin":"yī dēng rú dòu","abbr":"ydrd","explanation":"一盏只有豆粒那样大光线的灯。形容灯光暗弱。","source":{"text":"秋痕这一日，愤气填胸，一点泪也没有，和衣睡到三更后，一灯如豆，炉火不温，好像窗外梅树下悉索有声，又像人叹气。","book":"清·魏子安《花月痕》第二十七回"},"example":{"text":"这时他察觉处身于一间斗室之中，桌上～，发出淡淡黄光，自己睡在榻上，身上盖了棉被。","book":"金庸《笑傲江湖》第十八回"},"usage":"作谓语、定语；用于书面语"},{"id":781,"word":"一炊之梦","pinyin":"yī chuī zhī mèng","abbr":"yczm","explanation":"饭尚未蒸熟，一场好梦已经做醒。原比喻人生虚幻。后比喻不能实现的梦想。","source":{"text":"卢生欠伸而寤，见方偃于邸中，顾吕翁在旁，主人蒸黄梁尚未熟，触类如故，蹶然而兴曰：岂其梦寐耶？","book":"唐·李泌《枕中记》"}},{"id":782,"word":"一炮打响","pinyin":"yī pào dǎ xiǎng","abbr":"ypdx","explanation":"做成一件事就出了名。"},{"id":783,"word":"一炷心香","pinyin":"yī zhù xīn xiāng","abbr":"yzxx","explanation":"心香：旧时称中心虔诚，就能感通佛道，同焚香一样。比喻十分真诚的心意。多用来表示对老师的崇敬之情。","source":{"text":"一炷心香洞府开，偃松皱涩半莓苔。","book":"唐·韩偓《仙山》诗"},"example":{"text":"覆焦隍、空争骇鹿，多岐路、谩逐亡羊。自徊徨。白云深处，～。","book":"元·姬翼《玉蝴蝶》词"}},{"id":784,"word":"一点一滴","pinyin":"yī diǎn yī dī","abbr":"ydyd","explanation":"形容微小零星。","source":{"text":"为革命而筹集的金钱，是一点一滴的用之于革命事业。","book":"方志敏《可爱的中国·清贫》"},"example":{"text":"我们要从～的小事做起。"},"similar":["点点滴滴"],"usage":"作定语；形容微小零星"},{"id":785,"word":"一点半点","pinyin":"yī diǎn bàn diǎn","abbr":"ydbd","explanation":"指微小而不定的数量。","source":{"text":"倘或不防，前后错了一点半点，不论真假。","book":"清·曹雪芹《红楼梦》第34回"},"example":{"text":"沉寂的寒夜，静悄悄已没～风意。","book":"瞿秋白《饿乡纪程》"},"similar":["一星半点"],"usage":"作宾语、定语；指微小而不定的数量"},{"id":786,"word":"一点灵犀","pinyin":"yī diǎn líng xī","abbr":"ydlx","explanation":"①指犀角上有纹，两头感应通灵，故比喻心心相印。②指聪敏。","source":{"text":"身无彩凤双飞翼，心有灵犀一点通。","book":"唐·李商隐《无题》诗"},"example":{"text":"跨百尺长鲸，逐双飞彩凤，通～。","book":"元·汪元亨《折桂令·归隐》"},"usage":"作宾语、定语；用于书面语"},{"id":787,"word":"一点犀通","pinyin":"yī diǎn xī tōng","abbr":"ydxt","explanation":"比喻恋爱着的男女双方心心相印。","source":{"text":"身无彩凤双飞翼，心有灵犀一点通。","book":"唐·李商隐《无题》诗"},"example":{"text":"正～，遽别恨何已。","book":"宋·董颖《薄媚》词"}},{"id":788,"word":"一熏一莸","pinyin":"yī xūn yī yóu","abbr":"yxyy","explanation":"熏：香草；莸：臭草。比喻善常被恶所掩盖。","source":{"text":"一熏一莸，十年尚犹有臭。","book":"先秦·左丘明《左传·僖公四年》"},"example":{"text":"～，善齐不能同其器。","book":"唐·权德舆《陆宣公翰苑集序》"}},{"id":789,"word":"一片丹心","pinyin":"yī piàn dān xīn","abbr":"ypdx","explanation":"一片红心。指忠诚之心。","source":{"text":"一片丹心天日下，数行清泪岭云南。","book":"宋·苏轼《过岭寄子由》"},"example":{"text":"三九严寒何所惧，～向阳开。","book":"《红梅赞》歌词"},"similar":["赤子之心","忠心耿耿","肝胆相照"],"opposite":["心狠手辣","丧心病狂","丧尽天良"],"usage":"作主语、宾语；指忠诚之心","story":["南宋时期，著名词人陆游坚持出兵北征，收复失地，却一再遭到贬官。他始终不灰心，多次向宋高宗赵构上奏要求亲贤能远小人的主张，终究没得到采纳。他始终不懈到光复国土充满信心，在《金错刀行》中他写道：“千年史策耻无名，一片丹心报天子。”"]},{"id":790,"word":"一片冰心","pinyin":"yī piàn bīng xīn","abbr":"ypbx","explanation":"冰心：清洁的心。形容性情淡泊，不求名利。","source":{"text":"洛阳亲友如相问，一片冰心在玉壶。","book":"唐·王昌龄《芙蓉楼送辛渐》诗"},"example":{"text":"且请息怒。岂不知大人～，但行李往来，用犒从者，亦属交际常情。","book":"清·杨潮观《吟风阁杂剧·东莱郡暮夜却金》"},"opposite":["利欲熏心","利令智昏"],"usage":"作主语、宾语；指心地纯洁","story":["唐朝时期，诗人王昌龄官场屡屡失意，触犯了权贵豪门，一再被贬，但他仍以心地透明纯洁而自慰，决心不与那些人同流合污，他在《芙蓉楼送辛渐》诗中流露出这样的情感：“寒雨连江夜入吴，平明送客楚山孤。洛阳亲友如相问，一片冰心在玉壶。”"]},{"id":791,"word":"一片宫商","pinyin":"yī piàn gōng shāng","abbr":"ypgs","explanation":"宫、商：都是古代五音之一。一片和谐的音乐声。形容文辞如乐声一样优美、悦耳。","source":{"text":"韦八座岫谓朝贤曰：‘此赋乃一片宫商也。’","book":"宋·孙光宪《北梦琐言》卷七"},"usage":"作宾语；指音乐"},{"id":792,"word":"一片志诚","pinyin":"yī piàn zhì chéng","abbr":"ypzc","explanation":"志诚：心意诚恳。一片诚意","source":{"text":"将一片志诚心写入了冰绡峥，这一篇相思令，寄与多情，道是人憔悴不似丹青。","book":"元·乔孟符《两世姻缘》第二折"},"similar":["一片至诚"],"usage":"作宾语、定语；用于书面语"},{"id":793,"word":"一片散沙","pinyin":"yī piàn sàn shā","abbr":"ypss","explanation":"比喻力量分散，没有组织起来。同“一盘散沙”。","source":{"text":"但是中国的人，只有家族和宗族的团体，没有民族的精神，所以虽有四万万人结合成一个中国，实在是一片散沙。","book":"孙中山《民族主义》第一讲"},"similar":["一盘散沙"],"usage":"作谓语、宾语、定语；指散乱"},{"id":794,"word":"一片汪洋","pinyin":"yī piàn wāng yáng","abbr":"ypwy","explanation":"形容水面辽阔，水势浩大。","source":{"text":"郑州底下黄河开了口子，漫延十余州县，一片汪洋，尽成泽国。","book":"清·李宝嘉《官场现形记》第22回"},"example":{"text":"～都不见，知向谁边？","book":"毛泽东《浪淘沙·北戴河》"},"usage":"作宾语、定语；形容水面辽阔"},{"id":795,"word":"一片漆黑","pinyin":"yī piàn qī hēi","abbr":"ypqh","explanation":"形容非常黑暗。也形容对事情一无所知。","example":{"text":"外面～，请备好光源。"},"similar":["一团漆黑"],"usage":"作谓语、定语、补语；用于天气、局面等"},{"id":796,"word":"一片焦土","pinyin":"yī piàn jiāo tǔ","abbr":"ypjt","explanation":"形容遭遇火灾（或战火），房屋全部被衩焚毁的景象。","example":{"text":"火灾之后，昔日繁华的集市成为～。"},"usage":"作宾语；指被焚毁的景象"},{"id":797,"word":"一片至诚","pinyin":"yī piàn zhì chéng","abbr":"ypzc","explanation":"形容十分真挚诚恳。","source":{"text":"圣人望下一看，见他正是服官从政的年纪，脸上一团正气，胸中自然是一片至诚。","book":"清·文康《儿女英雄传》第一回"},"usage":"作宾语、状语；用于处事"},{"id":798,"word":"一片赤心","pinyin":"yī piàn chì xīn","abbr":"ypcx","explanation":"一片赤诚的心。","source":{"text":"一片丹心合万灵，应时甘雨带龙腥。","book":"唐·贯休《贺雨上王使君二首》其一"},"example":{"text":"一日圣上见了，笑问此中何有？俺就对说，惟有～。","book":"清·洪昇《长生殿·禊游》"},"similar":["一片丹心"],"usage":"作主语、宾语；指忠诚之心"},{"id":799,"word":"一牛九锁","pinyin":"yī niú jiǔ suǒ","abbr":"ynjs","explanation":"比喻无法解脱。","source":{"text":"一牛九锁，更相牵挛，案明如市，不得东西，请谳得报，日中被刑。","book":"汉·焦延寿《易林》卷十"},"usage":"作谓语、定语；指束缚很多"},{"id":800,"word":"一牛吼地","pinyin":"yī niú hǒu dì","abbr":"ynhd","explanation":"指牛鸣声可及之地。比喻距离较近。","source":{"text":"拘卢舍，此云五百弓，亦云一牛吼地，谓大牛鸣声所极闻。或云一鼓声。《俱舍》云二里，《杂宝藏》云五里。","book":"《翻译名义集·数量》"},"example":{"text":"五马渡江开国处，～作庵人。","book":"宋·王安石《答张奉议》诗"},"similar":["一牛鸣地","一牛鸣"],"usage":"作宾语、定语；用于书面语"},{"id":801,"word":"一牛鸣","pinyin":"yī niú míng","abbr":"ynm","explanation":"指牛鸣声可及之地。比喻距离较近。同“一牛吼地”。","source":{"text":"回看双凤阙，相去一牛鸣。","book":"唐·王维《与苏卢二员外游方丈寺》诗"},"example":{"text":"四壁晚钟齐接应，分明不隔～。","book":"清·黄遵宪《不忍池晚游诗》"},"similar":["一牛吼地","一牛鸣地"],"usage":"作宾语、定语；用于书面语"},{"id":802,"word":"一牛鸣地","pinyin":"yī niú míng dì","abbr":"ynmd","explanation":"指牛鸣声可及之地。比喻距离较近。同“一牛吼地”。","source":{"text":"其旁有锦峰书院，去山庄一牛鸣地。","book":"清·钱谦益《山庄八景诗·锦峰晴晓》序"},"example":{"text":"～时相见，双树影堂还结缘。","book":"清·金农《僦居玉溪赠无闷讲师精蓝》诗"},"similar":["一牛吼地"],"usage":"作宾语、定语；用于书面语"},{"id":803,"word":"一牢永定","pinyin":"yī láo yǒng dìng","abbr":"ylyd","explanation":"牢：牢固。一下弄得结结实实。形容事情一成不变。","source":{"text":"又道是一牢永定宁，死后如何交我改嫁人？","book":"元·刘唐卿《白兔记》第十三出"},"example":{"text":"我为绝宗派，结婚姻，指望～。","book":"元·柯丹邱《荆钗记》第二十八出"}},{"id":804,"word":"一物一主","pinyin":"yī wù yī zhǔ","abbr":"ywyz","explanation":"比喻每一事物必有所属。","source":{"text":"这披挂一物一主，看有甚么人来？","book":"元·无名氏《衣袄车》第一折"},"example":{"text":"怪不的～，那里有哥这等大福，偏有这样巧价儿来寻你的。","book":"明·兰陵笑笑生《金瓶梅词话》第四十五回"},"usage":"作宾语、定语；用于书面语"},{"id":805,"word":"一物一偏","pinyin":"yī wù yī piān","abbr":"ywyp","explanation":"一物：万种中的一种；一偏：全面中的一面。指一知半解，不全面。","source":{"text":"万物为道一偏，一物为万物之偏，愚者为一物之偏，而自以为知道，无知也。","book":"《荀子·天论》"}},{"id":806,"word":"一物一制","pinyin":"yī wù yī zhì","abbr":"ywyz","explanation":"指有一种事物，就会有另一种事物来制服它。","source":{"text":"此一时，彼一时，大不同也。常言道‘一物降一物’哩！","book":"明·吴承恩《西游记》"},"example":{"text":"说也奇怪，真是～，自从花翠琴嫁来后，竟把他这百炼钢化为绕指柔了。","book":"清·曾朴《孽海花》第三十五回"},"similar":["一物克一物","一物降一物"],"usage":"作宾语、定语、分句；指自然界的天敌"},{"id":807,"word":"一物不成，两物见在","pinyin":"yī wù bù chéng，liǎng wù xiàn zài","abbr":"ywbclwjz","explanation":"见：通“现”。交易不成，货物和钱却在，两无损碍。","source":{"text":"一物不成，两物见在。没来由杀你做甚么！","book":"明·施耐庵《水浒全传》第十二回"},"example":{"text":"只恁地肯卖便收去了。不肯时，勉强不得。正是～。","book":"明·冯梦龙《醒世恒言》卷十三"},"usage":"作宾语、定语、分句；用于书面语"},{"id":808,"word":"一物不知","pinyin":"yī wù bù zhī","abbr":"ywbz","explanation":"对某一事物有所不知。比喻知识尚有欠缺。","source":{"text":"圣人之于天下，耻一物之不知。","book":"汉·扬雄《法言·君子》"},"example":{"text":"论起“～，儒者之耻”的道理，这是正当办法。","book":"清·曾朴《孽海花》第二回"},"similar":["一事不知"],"opposite":["无所不知"],"usage":"作谓语、定语；指知识不完备"},{"id":809,"word":"一物克一物","pinyin":"yī wù kè yī wù","abbr":"ywkyw","explanation":"指有一种事物，就会有另一种事物来克制它。","source":{"text":"此一时，彼一时，大不同也。常言道‘一物降一物’哩！","book":"明·吴承恩《西游记》"},"similar":["一物降一物","一物一制"],"usage":"作宾语、定语、分句；指自然界的天敌"},{"id":810,"word":"一物降一物","pinyin":"yī wù xiáng yī wù","abbr":"ywxyw","explanation":"指有一种事物，就会有另一种事物来制服它。","source":{"text":"此一时，彼一时，大不同也。常言道‘一物降一物’哩！","book":"明·吴承恩《西游记》"},"example":{"text":"世界上的事情，总是～，有一个东西进攻，也有一个东西降他。","book":"毛泽东《在中国共产党全国代表大会上的讲话》"},"similar":["一物克一物","一物一制"],"opposite":["天下无敌"],"usage":"作宾语、分句；指自然界的天敌"},{"id":811,"word":"一犁雨","pinyin":"yī lí yǔ","abbr":"yly","explanation":"下了一犁深的春雨。指及时又适量的春雨。","source":{"text":"山边夜半一犁雨，田父高歌待收获。","book":"宋·苏舜钦《田家词》"},"example":{"text":"雾霏霏，云漠漠，新绿涨幽浦。梦里家山，春透～。","book":"宋·吴潜《祝英台近》词"}},{"id":812,"word":"一犬吠形，百犬吠声","pinyin":"yī quǎn fèi xíng，bǎi quǎn fèi shēng","abbr":"yqfxbqfs","explanation":"吠：狗叫；形：影子。一只狗看到影子叫起来，很多狗也跟着乱叫。比喻不了解事情真相，随声附和。","source":{"text":"一犬吠形，万犬吠声；一人传虚，百人传实。","book":"汉·王符《潜夫论·贤难》"},"example":{"text":"～。草随风偃，人随大流。","book":"李英儒《还我河山》第27章"},"similar":["随声附和","人云亦云"],"opposite":["固执己见"],"usage":"作定语、分句；影射人没主见"},{"id":813,"word":"一犬吠形，群犬吠声","pinyin":"yī quǎn fèi xíng，qún quǎn fèi shēng","abbr":"yqfxqqfs","explanation":"吠：狗叫。比喻随声附和，没有主见，凑热闹","source":{"text":"一犬吠形，群犬吠声，惧于群犬，遂至叵听也。","book":"《晋书·傅咸传》"},"similar":["一犬吠形，百犬吠声"],"usage":"作定语、分句；影射人没主见"},{"id":814,"word":"一犬吠影，百犬吠声","pinyin":"yī quǎn fèi yǐng，bǎi quǎn fèi shēng","abbr":"yqfybqfs","explanation":"吠：狗叫。比喻随声附和，没有主见，凑热闹","source":{"text":"谚曰：‘一犬吠影，百犬吠声’，悲哉！","book":"梁启超《新民说》第九节"},"similar":["一犬吠形，群犬吠声"],"usage":"作定语、分句；影射人没主见"},{"id":815,"word":"一狐之掖","pinyin":"yī hú zhī yè","abbr":"yhzy","explanation":"比喻珍贵的东西。同“一狐之腋”。","source":{"text":"千羊之皮，不如一狐之掖；千人之诺诺，不如一士之谔谔。","book":"《史记·商君列传》"},"similar":["一狐之腋"],"usage":"作宾语；比喻少量而珍贵的东西"},{"id":816,"word":"一狐之腋","pinyin":"yī hú zhī yè","abbr":"yhzy","explanation":"腋：指狐狸腋下的皮毛。一只狐狸腋下的皮毛。比喻珍贵的东西。","source":{"text":"吾闻千羊之皮，不如一狐之腋。","book":"《史记·赵世家》"},"example":{"text":"百羊之皮，不如～。","book":"清·李汝珍《镜花缘》第十三回"},"similar":["一狐之掖"],"usage":"作宾语；比喻少量而珍贵的东西","story":["春秋末期，晋国卿士赵国奠基人赵简子十分喜欢周舍直言不讳。周舍曾经立于赵简子门下三日三夜，说自己愿意效犬马之劳。周舍死后，赵简子每天只能听到一遍颂扬与赞美之词，他非常失望，认为众多平庸之人不如周舍，就像千羊之皮不如一狐之腋一样"]},{"id":817,"word":"一狠二狠","pinyin":"yī hěn èr hěn","abbr":"yheh","explanation":"犹言索性，干脆。多指下极大的决心。","source":{"text":"你既要干这营生，不如一狠二狠，把奴才结果了。","book":"明·兰陵笑笑生《金瓶梅词话》第二十六回"},"example":{"text":"不给丈夫置个妾，觉得在人面上挂不住，没奈何，～，给他作成了，却是三面说不到家，一生不得合式。","book":"清·文康《儿女英雄传》第二十七回"}},{"id":818,"word":"一狠百狠","pinyin":"yī hěn bǎi hěn","abbr":"yhbh","explanation":"狠：狠心。指既然狠下心来，索性就狠心到底。比喻小处已经下狠心做了，大处也就无所顾忌。"},{"id":819,"word":"一献三售","pinyin":"yī xiàn sān shòu","abbr":"yxss","explanation":"指人臣过蒙宠幸。同“一献三酬”。","source":{"text":"楚臣《天问》不酬，今臣过幸，一献三售。","book":"唐·刘禹锡《问大钧赋》"},"similar":["一献三酬"],"usage":"作宾语、定语；用于书面语"},{"id":820,"word":"一献三酬","pinyin":"yī xiàn sān chóu","abbr":"yxsc","explanation":"指人臣过蒙宠幸。亦作“一献三售”。","source":{"text":"梓人为饮器，勺一升，爵一升，觚三升，献以爵而酬以觚，一献而三酬。","book":"《周礼·考工记·梓人》"},"similar":["一献三售"],"usage":"作宾语、定语；用于书面语"},{"id":821,"word":"一王之法","pinyin":"yī wáng zhī fǎ","abbr":"ywzf","explanation":"一王：一代王朝；法：标准。一个时代的规范。","source":{"text":"孔子之时，上无明君，下不得任用，故作春秋，垂空文以断礼义，当一王之法。","book":"《史记·太史公自序》"}},{"id":822,"word":"一现昙华","pinyin":"yī xiàn tán huā","abbr":"yxth","explanation":"比喻事物或人物一出现就很快消失。华，同“花”。","source":{"text":"翻成薄命红颜女，一现昙华惹世疑。","book":"景定成《稚伶刘箴俗哀词》之三"},"similar":["昙花一现"],"usage":"作定语；用于书面语"},{"id":823,"word":"一班一级","pinyin":"yī bān yī jí","abbr":"ybyj","explanation":"犹言一官半职。泛指官职。","source":{"text":"爵禄譬滋味也，人皆欲之，吾年五十，拭镜剪白，冒游少年间，取一班一级，不见其味也。","book":"《旧唐书·武帝纪》：“寒士纵有出人之才，登第之后，始得一班一级，固不能熟习也。”《新唐书·韦表微传》"},"example":{"text":"《新唐书·韦表微传》：“吾年五十，拭境剪白，冒游少年间，取～，不见其味也。”"},"usage":"作宾语；用于书面语"},{"id":824,"word":"一班一辈","pinyin":"yī bān yī bèi","abbr":"ybyb","explanation":"指同等，不相上下。","source":{"text":"当日你这厮诽谤朝廷，潜地奔逃，我这一班一辈的人，为你不知受过多少限责，你却躲在卖酒的李秀家里快活。","book":"明·方汝浩《禅真逸史》第十一回"},"example":{"text":"咱别要扳大头子，还是～的人家，咱好展瓜。","book":"清·西周生《醒世姻缘传》第七十二回"},"usage":"作定语；一样书面语"},{"id":825,"word":"一班半点","pinyin":"yī bān bàn diǎn","abbr":"ybbd","explanation":"犹言一点半点，常暗指男女关系。班，通“斑”。","source":{"text":"近日来与小生有一班半点之事，争奈撇不下此妇人。","book":"宋·黄庭坚《望远行》词：“且与一班半点，只怕你没丁香核。”宋·无名氏《错立身》戏文第二出"},"example":{"text":"明·冯梦龙《警世通言》第30卷：“只道楼儿便是床上，火急做了～儿事。”"},"usage":"作宾语、定语；指很少"},{"id":826,"word":"一理贯之","pinyin":"yī lǐ guàn zhī","abbr":"ylgz","explanation":"贯：贯穿。用一个根本性的事理贯通事情的始末或全部的道理。","source":{"text":"子曰：‘参乎！吾道一以贯之’曾子曰：‘唯。’子出，门人问曰：‘何谓也？’曾子曰：‘夫子之道，忠恕而已矣。’","book":"《论语·里仁》"},"example":{"text":"又云以～故具观心义，其如妙玄十法，岂不以～。","book":"《四明十义书》卷下"}},{"id":827,"word":"一琴一鹤","pinyin":"yī qín yī hè","abbr":"yqyh","explanation":"原指宋朝赵抃去四川做官，随身携带的东西仅有一张琴和一只鹤。形容行装简少，也比喻为官清廉。","source":{"text":"帝曰：‘闻卿匹马入蜀，以一琴一鹤自随；为政简易，亦称是乎！’","book":"宋·沈括《梦溪笔谈》卷九：“赵阅道为成都转运史，出行部内，唯携一琴一鹤，坐则看鹤鼓琴。”《宋史·赵抃传》"},"example":{"text":"你把那行装整顿，无过是～紧随身。","book":"元·无名氏《冯玉兰夜月泣江舟》第一折"},"similar":["两袖清风"],"usage":"作宾语、定语；指为官清廉","story":["北宋时期，地方官赵抃去蜀地成都赴任，随身行李就是布袋中的古琴与竹篓里的白鹤，分别驮在一匹马上，其他就是两袖清风。宋神宗听说赵抃的行李就只有一琴一鹤，十分赞赏他的为人，希望他到任后精兵简政，廉洁奉公。赵抃的政绩也被广为传诵"]},{"id":828,"word":"一瓜共食","pinyin":"yī guā gòng shí","abbr":"yggs","explanation":"与将士同吃一个瓜。指与将士同甘共苦。","source":{"text":"为将，躬勤细事，每得甘美，虽一瓜数果，必与将士共之。","book":"《北史·齐宗室传》"}},{"id":829,"word":"一瓣之香","pinyin":"yī bàn zhī xiāng","abbr":"ybzx","explanation":"一瓣：即一炷香。用点燃的一炷香表达心中的虔诚。多用来表示对老师的崇敬之情。","source":{"text":"向来一瓣香，敬为曾南丰。","book":"唐·韩偓《仙山》诗：“一炷心香洞府开，偃松皱涩半莓苔。”宋·陈师道《观兗文忠公家六一堂图书》诗"}},{"id":830,"word":"一瓣心香","pinyin":"yī bàn xīn xiāng","abbr":"ybxx","explanation":"心香：旧时称中心虔诚，就能感通佛道，同焚香一样。比喻十分真诚的心意（用在祝愿）。","source":{"text":"一柱一香洞府开，偃松皱涩半莓苔。","book":"唐·韩偓《仙山》诗"},"example":{"text":"编者谨掬～，吁请海内文豪，从兹多谈风月，少发牢骚，庶作者编者，两蒙其休。","book":"鲁迅《伪自由书·后记》引《申报》副刊《自由谈》"},"similar":["心香一瓣"],"usage":"作宾语；用在祝愿"},{"id":831,"word":"一瓣香","pinyin":"yī bàn xiāng","abbr":"ybx","explanation":"一瓣：即一炷香。用点燃的一炷香表达心中的虔诚。多用来表示对老师的崇敬之情。","source":{"text":"向来一瓣香，敬为曾南丰。","book":"宋·陈师道《观兗文忠公家六一堂图书》诗"},"example":{"text":"晨兴～，痛如螫在头。","book":"宋·文天祥《先两国初忌》"}},{"id":832,"word":"一瓶一钵","pinyin":"yī píng yī bō","abbr":"ypyb","explanation":"瓶、钵：和尚盛饮食的器具。指和尚云游时携带的最简单的食器。也比喻家境贫穷，生活简朴。","source":{"text":"一瓶一钵垂垂老，千水千山得得来。","book":"唐·贯休《陈情献蜀皇帝》"},"example":{"text":"再见江山，依旧～。","book":"宋·李清照《投翰林学士綦審礼启》"},"similar":["一钵一瓶"],"usage":"作宾语、定语；用于书面语"},{"id":833,"word":"一瓶不响，半瓶晃荡","pinyin":"yī píng bù xiǎng，bàn píng huàng dàng","abbr":"ypbxbphd","explanation":"瓶中装满水晃不响，装半瓶水时一晃就响。比喻充实的人谦虚寡言，而浅薄的人偏偏爱显示夸耀自己。","source":{"text":"你这瓶子本自洁净，却被这些恶水在里面，又不满，只管向，要得不响，须是依前倾出飏却荡洗了，却满着一瓶好水便不响，因甚不响？盖谓满了。","book":"宋·宗杲录《大慧普禅师宗门武库·湛堂和尚》"}},{"id":834,"word":"一生一世","pinyin":"yī shēng yī shì","abbr":"ysys","explanation":"一辈子。","source":{"text":"这样一撞，就撞着了，才使得。不然一生一世也只是这样嘴巴骨。","book":"明·阮大铖《燕子笺·试窘》"},"example":{"text":"要是有了生活做，我～也忘不了你的恩。","book":"周而复《上海的早晨》第一部"},"similar":["一生一代"],"usage":"作宾语、定语；指一辈子"},{"id":835,"word":"一生一代","pinyin":"yī shēng yī dài","abbr":"ysyd","explanation":"指一辈子。同“一生一世”。","source":{"text":"相怜相念倍相亲，一生一代一双人。","book":"唐·骆宾王《代女道士王灵妃赠道士李荣》诗"},"example":{"text":"～一双人，争教两处消魂；相思相望不相亲，天为谁春？","book":"清·纳兰性德《画堂春》词"},"similar":["一生一世"],"usage":"作宾语、状语；用于书面语"},{"id":836,"word":"一生一死，乃见交情","pinyin":"yī shēng yī sǐ，nǎi jiàn jiāo qíng","abbr":"ysysnjjq","explanation":"只有一起共过患难，才能显示出交情的深浅。","source":{"text":"一死一生，乃知交情；一贫一富，乃见交态；一贵一贱，交情乃见。","book":"《汉书·郑当时传》"}},{"id":837,"word":"一生九死","pinyin":"yī shēng jiǔ sǐ","abbr":"ysjs","explanation":"指经历多次生命危险而幸存。","source":{"text":"畴昔干戈里，飘零剩此身；一生九死客，两代六朝人。","book":"明·刘道开《畴昔》诗"},"similar":["九死一生"],"usage":"作谓语、定语；表示人的经历"},{"id":838,"word":"一生愧辱","pinyin":"yī shēng kuì rǔ","abbr":"yskr","explanation":"一生：一辈子；愧：惭愧；辱：耻辱。终生都感到惭愧和耻辱。","source":{"text":"何惜数年勤学，长受一生愧辱或！","book":"北齐·颜之推《颜氏家训·勉学》"}},{"id":839,"word":"一男半女","pinyin":"yī nán bàn nǚ","abbr":"ynbn","explanation":"指一个儿子或女儿。","source":{"text":"员外何不取房娘子，生得一男半女，也不绝了香火。","book":"《京本通俗小说·志诚张主管》"},"example":{"text":"要是令爱进去，生下～，就是现成的局长太太。","book":"茅盾《林家铺子》"},"similar":["寸男尺女"],"usage":"作宾语；指一个子女"},{"id":840,"word":"一画开天","pinyin":"yī huà kāi tiān","abbr":"yhkt","explanation":"相传伏羲画八卦，始于干卦三之第一画，干为天，故指“一画开天”。"},{"id":841,"word":"一病不起","pinyin":"yī bìng bù qǐ","abbr":"ybbq","explanation":"得病后就再也起不了床。比喻得病后病情一天天恶化，终至死亡。","source":{"text":"蒋安礼为光禄丞，斋宿寺舍，因喷嚏，鼻涕堕桌上，皆成小木人，雕刻之工极精，揽取之则已失矣，顷之复尔。凡堕木人千百，蒋一病不起。","book":"宋·洪迈《夷坚乙志·光禄寺》"},"example":{"text":"大崽又得个伤寒，～。（周立波《山乡巨变》）"},"similar":["一命呜呼"],"usage":"作谓语、定语；指生病"},{"id":842,"word":"一痴一醒","pinyin":"yī chī yī xǐng","abbr":"ycyx","explanation":"痴：傻。时而痴迷，时而清醒。","source":{"text":"其为结僮之时，一痴一醒，时人尽以为狂。","book":"汉·袁康《越绝书·外传纪策考》"},"usage":"作谓语、定语；用于书面语"},{"id":843,"word":"一登龙门","pinyin":"yī dēng lóng mén","abbr":"ydlm","explanation":"龙门：传说鲤鱼跃过龙门就变成龙。指一时间飞黄腾达。","source":{"text":"膺独持风裁，以声名自高。士有被其容接者，名为登龙门。","book":"南朝·宋·范晔《后汉书·李膺传》"},"example":{"text":"～，则声誉十倍。","book":"唐·李白《与韩荆州书》"},"similar":["鲤鱼跳龙门"],"usage":"作宾语、定语；指人飞黄腾达","story":["唐朝诗人李白从25岁开始游学各地，写下不少脍炙人口诗篇。但30多岁还没有入仕，他听说荆州长史韩朝宗特别喜欢举荐人才，就写《与韩荆州书》：“我听人说‘生不用封万户侯，但愿一识韩荆州’，一旦被你引荐，那么就会像鲤鱼一登龙门身价十倍。”"]},{"id":844,"word":"一登龙门，身价十倍","pinyin":"yī dēng lóng mén，shēn jià shí bèi","abbr":"ydlmsjsb","explanation":"忽然得到荣耀，从而身价倍增。","source":{"text":"一登龙门，则声誉十倍。","book":"唐·李白《与韩荆州书》"},"example":{"text":"他考上了博士后，就～。"},"similar":["一登龙门"],"usage":"作谓语、分句；指人一朝得志","story":["唐朝诗人李白从25岁开始游学各地，写下不少脍炙人口诗篇。但30多岁还没有入仕，他听说荆州长史韩朝宗特别喜欢举荐人才，就写《与韩荆州书》：“我听人说‘生不用封万户侯，但愿一识韩荆州’，一旦被你引荐，那么就会像鲤鱼一登龙门身价十倍。”"]},{"id":845,"word":"一百二十行","pinyin":"yī bǎi èr shí háng","abbr":"ybesh","explanation":"犹三百六十行。指各种行业。","source":{"text":"[微宗等]无日歌欢作乐，遂于宫中内列为市肆，令其宫女卖茶卖酒及一百二十行经纪买卖皆全。","book":"《宣和遗事》前集"},"example":{"text":"我想这～，门门都好着衣吃饭，偏俺这一门却是谁人制下的? 这一质问可以说是对於妓门制度的控诉与否定。","book":"元·关汉卿《金线池》一折"},"similar":["各行各业","三百六十行"],"usage":"作宾语、定语；指各行各业"},{"id":846,"word":"一百五日","pinyin":"yī bǎi wǔ rì","abbr":"ybwr","explanation":"冬至后的第一百零五天。指寒食日。","source":{"text":"去冬节一百五日，即有疾风甚雨，谓之寒食，禁火三日。","book":"南朝·梁·宗懔《荆楚岁时记》"},"example":{"text":"～春郊行，三十六溪春水生。千秋观里逢急雨，射的峰前看晚晴。","book":"宋·陆游《春游绝句》"}},{"id":847,"word":"一盘散沙","pinyin":"yī pán sǎn shā","abbr":"ypss","explanation":"比喻力量分散，没有组织起来。","source":{"text":"然终不免一盘散沙之诮者，则以无合群之德故也。","book":"清·梁启超《十种德性相反相成论》"},"example":{"text":"因为我们说着古代的话，说着大家不明白，不听见的话，已经弄得像～，痛痒不相关了。","book":"鲁迅《无声的中国》"},"similar":["七零八落","乌合之众"],"opposite":["万众一心","众志成城"],"usage":"作谓语、宾语、定语；指散乱"},{"id":848,"word":"一盘棋","pinyin":"yī pán qí","abbr":"ypq","explanation":"一个回合的对弈。整个棋盘的势态，比喻各局部之间互相协调，服从全局。","source":{"text":"西门庆还把他强死强活拉到李瓶儿房内，下了一盘棋，吃了一回酒。","book":"明·兰陵笑笑生《金瓶梅词话》第38回"},"example":{"text":"全国要有“～”的观念，要有整体意识。"},"usage":"作宾语、定语；用于口语"},{"id":849,"word":"一目之士","pinyin":"yī mù zhī shì","abbr":"ymzs","explanation":"指见解片面，不能看到事物整体的人。","source":{"text":"此书成于元代，道学之风甚盛，而能为是言，此是非之公也。近世一目之士，动以诋斥宋儒为莫逭之罪，亦愚甚矣。","book":"清·李慈铭《越缦堂读书记·志雅堂杂抄》"},"usage":"作主语、宾语；用于书面语"},{"id":850,"word":"一目之罗","pinyin":"yī mù zhī luó","abbr":"ymzl","explanation":"目：网眼。只有一个网眼的罗网。比喻只看到一点，而忽视全局。","source":{"text":"有鸟将来，张罗而待之，得鸟者罗之一目也。今为一目之罗，则无时得鸟矣。","book":"《淮南子·说山训》"},"example":{"text":"～不能得鸟，得鸟者，罗之一目耳。","book":"南怀瑾《宗镜录略讲》第二十"}},{"id":851,"word":"一目了然","pinyin":"yī mù liǎo rán","abbr":"ymlr","explanation":"目：看；了然：清楚，明白。一眼就看得很清楚。","source":{"text":"可见按图索籍，三溪道路，一目了然。","book":"明·张岱《皇华考序》"},"example":{"text":"却说这中堂正对着那个围场，四扇大窗洞开，场上的事，～。","book":"清·曾朴《孽海花》第十九回"},"similar":["一望而知","了如指掌","不言而喻"],"opposite":["雾里看花","管中窥豹","目不暇接"],"usage":"作谓语、定语；指一眼就看得很清楚"},{"id":852,"word":"一目五行","pinyin":"yī mù wǔ háng","abbr":"ymwh","explanation":"犹一目十行。形容看书非常快。","source":{"text":"天下之事，丛于枢府，簿书填委。遵勖一目五行俱下，判决如流。","book":"《辽史·杨遵勖传》"},"example":{"text":"幼颖悟，读书～，尝阅衡州《净居院碑》，文近千言，一览背诵无遗。","book":"《元史·许有壬传》"},"similar":["一目数行","一目十行"],"usage":"作谓语、状语；指看书非常快"},{"id":853,"word":"一目十行","pinyin":"yī mù shí háng","abbr":"ymsh","explanation":"看书时同时可以看十行。形容看书非常快。","source":{"text":"五更三点待漏，一目十行读书。","book":"《梁书·简文帝纪》：“读书十行俱下。”宋·刘克庄《杂记六言五首》诗"},"example":{"text":"那三官双名景隆，字顺卿，年方一十七岁，生得眉目清新，丰姿俊雅，读书～，举笔即便成文。","book":"明·冯梦龙《警世通言》卷二十四"},"similar":["十行俱下","一挥而就","不假思索"],"opposite":["慢条斯理","老牛破车","蜗行牛步"],"usage":"作谓语、状语；指看书非常快","story":["南朝梁武帝萧衍的第三个儿子萧纲从小聪明伶俐，记忆力很强。他读书的速度相当快，能够十行同时阅读下去，而且能够做到过目不忘。11岁时就博览群书，写诗赋文章得心应手。因此被任命为宣惠将军，丹阳尹"]},{"id":854,"word":"一目即了","pinyin":"yī mù jí liǎo","abbr":"ymjl","explanation":"目：看。一眼就看得很清楚。","source":{"text":"见得道理透后，从高视下，一目了然。","book":"宋·朱熹《朱子语类》卷一百三十七"}},{"id":855,"word":"一目尽天涯","pinyin":"yī mù jìn tiān yá","abbr":"ymjty","explanation":"一目：一眼望去。一眼能看到天边。","source":{"text":"孤亭一目尽天涯，俯瞰烟村八九家。","book":"宋·朱熹《再用韵题翠壁诗》"},"example":{"text":"焕烂莲灯高下，参差梅影横斜。凭栏～，雪月交辉清夜。","book":"宋·曾觌《西江月》词"}},{"id":856,"word":"一目数行","pinyin":"yī mù shù háng","abbr":"ymsh","explanation":"犹一目十行。形容看书非常快。","source":{"text":"熊公廷弼当督学江南时，试卷皆亲自批阅。阅则连长几于中堂，鳞摊诸卷于上，左右置酒一坛，剑一口，手操不律，一目数行。","book":"清·钮琇《觚剩续编·英豪举动》"},"example":{"text":"清·无垢道人《八仙全传》第11回：“仙赐是天赐聪明，不消说是～、闻一知十的了。”"},"similar":["一目十行","一目五行"],"usage":"作谓语、状语；指看书非常快"},{"id":857,"word":"一相情原","pinyin":"yī xiāng qíng yuán","abbr":"yxqy","explanation":"指单方面的愿望或不考虑客观实际情况的主观意愿。亦作“一厢情原”。"},{"id":858,"word":"一相情愿","pinyin":"yī xiāng qíng yuàn","abbr":"yxqy","explanation":"一相：也作“一厢”，一方面。指只是单方面的愿望，没有考虑对方是否同意，或客观条件是否具备。","source":{"text":"晏殊以为柳胜韩，李淑又谓刘胜柳，所谓‘一厢情愿’。","book":"金·王若虚《滹南遗老集》"},"example":{"text":"一则保了这没过门女婿的性命；二则全了这～媒人的脸面。","book":"清·文康《儿女英雄传》第十回"},"similar":["一己之见","一厢情愿"],"opposite":["两相情愿"],"usage":"作定语、状语；指单方面的事情","story":["古印度农家青年去京城玩，见到美貌非凡的公主，就一厢情愿地想入非非，回家之后就得了相思病，日益消瘦下去，亲友们知道后就假装派人去京城跟国王提亲，他信以为真，病倒慢慢好了起来。过几天亲友回来说公主不肯答应，他表示再去见公主一面"]},{"id":859,"word":"一眨巴眼","pinyin":"yī zhǎ bā yǎn","abbr":"yzby","explanation":"方言。一眨眼。","source":{"text":"可惜新年也和别的日子一样，一眨巴眼儿就过去了。","book":"老舍《小坡的生日》四"},"example":{"text":"可是这个匪徒突然～，大哭起来，狠狠照着自己的脸上打了响响的两个耳光子。","book":"曲波《林海雪源》第二十章"}},{"id":860,"word":"一着不慎，满盘皆输","pinyin":"yī zhāo bù shèn，mǎn pán jiē shū","abbr":"yzbsmpjs","explanation":"原指下棋时关键的一步棋走得不当，整盘棋就输了。比喻某一个对全局具有决定意义的问题处理不当，结果导致整个失败。","source":{"text":"说‘一着不慎，满盘皆输’，乃是说的带全局性的，即对全局有决定意义的一着。","book":"毛泽东《中国革命战争的战略问题》"},"example":{"text":"这真是～，我们怎样挽回呢？"},"similar":["一子失着，满盘皆输"],"usage":"作宾语、分句；指要慎重其事"},{"id":861,"word":"一着权在手，看取令行时","pinyin":"yī zhāo quán zài shǒu，kàn qù lìng xíng shí","abbr":"yzqzskqlxs","explanation":"一旦掌了权，就发号施令，指手画脚。","source":{"text":"一朝权入手，看取令行时。","book":"唐·高仲武《中兴闲气集》卷上"}},{"id":862,"word":"一着被蛇咬，三年怕井绳","pinyin":"yī zhāo bèi shé yǎo，sān nián pà jǐng shéng","abbr":"yzbsysnpjs","explanation":"比喻在某件事情上吃过苦头，以后一碰到类似的事情就害怕。","source":{"text":"问：‘狗子还有佛性也无。’赵州道：‘无意者如何？’师曰：‘一度著蛇咬，怕风了断井索。’","book":"宋·释普济《五灯会元·龙门远禅师法嗣》"},"example":{"text":"南星摸着头上的大包，颇有点“～”的神气。","book":"老舍《小坡的生日·上学》"}},{"id":863,"word":"一瞑不视","pinyin":"yī míng bù shì","abbr":"ymbs","explanation":"瞑：闭眼。闭上眼睛，不再睁开。指死亡。也指逃避现实。也可形容不怕牺牲。","source":{"text":"有断头绝腹，一瞑而万世不视，不知所益，以忧社稷者。","book":"《战国策·楚策一》"},"example":{"text":"～，亦已矣。","book":"章炳麟《马良请速开国会》"},"similar":["一命呜呼","一命归西"],"usage":"作谓语；指死亡"},{"id":864,"word":"一瞬千里","pinyin":"yī shùn qiān lǐ","abbr":"ysql","explanation":"瞬：指极短的时间。一眨眼的时间就一千里路。比喻人进步或事业进展迅速。也形容速度很快。","source":{"text":"追飙抹电，一瞬千里。","book":"宋·卫宗武《酹江月·和友人催雪》：“瘗马发祥，妖麋应祷，终解从人意。腊前三白，瑶光一瞬千里。”宋·林景熙《鞍山斋记》"},"example":{"text":"但见车轮滚滚，尘雾簸扬，真如星烁梭光，～的光景。","book":"清·吴璿《飞龙全传》第十二回"}},{"id":865,"word":"一矢双穿","pinyin":"yī shǐ shuāng chuān","abbr":"yssc","explanation":"犹一箭双雕。比喻做一件事达到两个目的。","source":{"text":"清·陈天华《狮子吼》楔子：“是英雄自有英雄面，怕什么代越庖俎，还他个一矢双穿。”按，此指抗洋倒清二者并进，一举两得。"},"similar":["一箭双雕"],"usage":"作宾语、定语；用于书面语"},{"id":866,"word":"一知半见","pinyin":"yī zhī bàn jiàn","abbr":"yzbj","explanation":"指不成熟的一点见解。","source":{"text":"讵知后世之门庭张网者，偶窃一知半见，谓人悟门，便住门限上，登曲录床，此生不可复下。","book":"清·方以智《东西均·道艺》"},"example":{"text":"今任其～，指为妙悟，如照萤光，如窥隙日，以为诗之妙解尽在是。","book":"清·周亮工《书影》卷六"},"similar":["一知半解","一知片解"],"usage":"作谓语、宾语、定语；用于否定句"},{"id":867,"word":"一知半解","pinyin":"yī zhī bàn jiě","abbr":"yzbj","explanation":"知道得不全面，理解得也不透彻。","source":{"text":"有透彻之悟，有但得一知半解之悟。","book":"宋·严羽《沧浪诗话·诗辨》"},"example":{"text":"我也只得～，不懂什么。","book":"清·颐琐《黄绣球》第八回"},"similar":["一孔之见","浮光掠影","囫囵吞枣"],"opposite":["真知灼见","真才实学","博古通今"],"usage":"作谓语、宾语、定语；用于否定句","story":["宋朝诗人陈师道认为苏东坡的诗风格初学刘禹锡，后学李白。清朝时期的《诗醇》却有不同的观点：“洵乎独立千古，非一代一人之诗也：而陈师道顾谓其初学刘禹锡，晚学李太白，毋乃一知半解。”"]},{"id":868,"word":"一知片解","pinyin":"yī zhī piàn jiě","abbr":"yzpj","explanation":"犹一知半见。指不成熟的一点见解。","source":{"text":"某闲居寖久，兀兀一经，今已穷年，粗有一知片解，更不复为言语词章。","book":"宋·吴泳《答赵茂实书》"},"similar":["一知半解","一知半见"],"usage":"作宾语、定语；用于处事"},{"id":869,"word":"一石二鸟","pinyin":"yī shí èr niǎo","abbr":"ysen","explanation":"扔一颗石子打到两只鸟。比喻做一件事情得到两种好处。","source":{"text":"这是个一石二鸟的好办法。","book":"路遥《平凡的世界》第三卷第24章"},"example":{"text":"他的～计划得到大家的认可。"},"similar":["一箭双雕","一举两得"],"opposite":["得不偿失","劳而不获","徒劳无功"],"usage":"作宾语、定语；形容一举两得"},{"id":870,"word":"一石激起千层浪","pinyin":"yī shí jī qǐ qiān céng làng","abbr":"ysjqqcl","explanation":"扔一块石头到水中掀起千层浪花。比喻一句话或某一细小行动，会引起强烈的反响。","example":{"text":"～，惊动五洲四大洋。","book":"马辂《国共和谈演义》第二十五回"}},{"id":871,"word":"一码归一码","pinyin":"yī mǎ guī yī mǎ","abbr":"ymgym","explanation":"一件事归一件事，不能混为一谈。","example":{"text":"咱们～，不要乱牵连。"},"similar":["一是一，二是二"],"opposite":["混为一谈"],"usage":"作谓语、定语、宾语；用于口语"},{"id":872,"word":"一碗水往平处端","pinyin":"yī wǎn shuǐ wǎng píng chú duān","abbr":"ywswpcd","explanation":"比喻办事公正不偏袒。","example":{"text":"我们处理问题不要偏袒，要～。"},"usage":"作宾语、定语；用于处事"},{"id":873,"word":"一碗水端平","pinyin":"yī wǎn shuǐ duān píng","abbr":"ywsdp","explanation":"比喻处理事情公正，不偏袒任何一方。","source":{"text":"我一碗水往平处端。论情理，人家可也真委屈些儿。","book":"清·文康《儿女英雄传》第26回"},"example":{"text":"作为老师对学生要～，不能偏爱。"},"similar":["不偏不倚"],"usage":"作宾语、定语；指两者取舍"},{"id":874,"word":"一碧万顷","pinyin":"yī bì wàn qǐng","abbr":"ybwq","explanation":"形容青绿无际。","source":{"text":"春和景明，波澜不惊；上下天光，一碧万顷。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"时候已经将近中秋，晴空是～。","book":"成仿吾《牧夫》"},"usage":"作宾语、定语；用于书面语"},{"id":875,"word":"一碧千里","pinyin":"yī bì qiān lǐ","abbr":"ybql","explanation":"形容澄碧的天空、水面、草原等的一望无边。","similar":["一碧万顷"]},{"id":876,"word":"一碧无际","pinyin":"yī bì wú jì","abbr":"ybwj","explanation":"形容水面或天空一片碧绿或碧蓝，广阔无际。","source":{"text":"东坡公昔与客游金山，适中秋夕，天宇四垂，一碧无际，加江流澒涌，俄月色如画，遂共登金山山顶之妙高峰，命绹歌其水调歌头","book":"宋·蔡绦《铁围山丛谈》卷三"},"example":{"text":"虽有几批残叶，尚是～，西北角上，芭蕉丛里，有个方池，不过二丈见方，就是金线泉了。","book":"清·刘鹗《老残游记》第三回"}},{"id":877,"word":"一秉大公","pinyin":"yī bǐng dà gōng","abbr":"ybdg","explanation":"指言论行事全秉公心。","source":{"text":"仆近来用人处事，一秉大公。","book":"明·张居正《答工部郎中刘公伯燮言用人毁誉》"},"example":{"text":"那里有好人？本县为官，上不欺君，下不虐民，自到任二年之久，我～办事。","book":"坑余生《续济公传》第二回"},"similar":["一秉至公"],"usage":"作谓语、定语；指大公无私"},{"id":878,"word":"一秉至公","pinyin":"yī bǐng zhì gōng","abbr":"ybzg","explanation":"秉：掌握、主持；至：极、最。办事一切都出于公心。形容大公无私。","source":{"text":"然而平中丞却不以此为轻重，委差委缺，仍旧是一秉至公。","book":"清·李宝嘉《文明小史》第六十回"},"similar":["一秉大公"],"usage":"作谓语、定语；指大公无私"},{"id":879,"word":"一秉虔诚","pinyin":"yī bǐng qián chéng","abbr":"ybqc","explanation":"指诚心诚意。","source":{"text":"那凤姐儿也无心瞻仰圣像， 一秉虔诚，磕了头，举起签筒默默的将那见鬼之事并身体不安等故祝告了一回。","book":"清·曹雪芹《红楼梦》第一零一回"},"example":{"text":"先是安老爷带了安公子，次后便是安太太带了张姑娘，各各～，焚香膜拜。","book":"清·文康《儿女英雄传》第十三回"},"usage":"作谓语、状语；用于处事"},{"id":880,"word":"一称心力","pinyin":"yī chèn xīn lì","abbr":"ycxl","explanation":"一：全；称：相符合；必力：运用心思的能力。所有都跟自己所设想的心思相合。","source":{"text":"三间两柱，二室四牖，广袤丰杀，一称心力。","book":"唐·白居易《庐山草堂记》"}},{"id":881,"word":"一穷二白","pinyin":"yī qióng èr bái","abbr":"yqeb","explanation":"穷：指物质基础差；白：指文化和科学落后。比喻基础差，底子薄。","source":{"text":"我曾经说过，我们一为‘穷’，二为‘白’。‘穷’就是没有多少工业，农业也不发达。‘白’就是一张白纸，文化水平、科学水平都不高。","book":"毛泽东《论十大关系》十"},"example":{"text":"在他们的意念中，一切都是为了迅速改变‘～’的面貌。","book":"陶铸《松树的风格》"},"similar":["一贫如洗","一无所有","一文不名"],"opposite":["人给家足","丰衣足食"],"usage":"作谓语、定语、宾语；用于国家及个人的状况"},{"id":882,"word":"一空依傍","pinyin":"yī kōng yī bàng","abbr":"ykyb","explanation":"指在艺术、学术等方面独创而全不摹仿。","source":{"text":"关汉卿一空依傍，自铸伟词，而其言曲尽人情，字字本色，故当为元人第一。","book":"王国维《宋元戏曲考》第十二章"},"example":{"text":"毛主席的词，一面尽量利用词调的格律以保存词体的节奏美，同时又～，挥洒自如。","book":"赵朴初《古为今用的光辉典范》"},"usage":"作谓语、定语；用于书面语"},{"id":883,"word":"一窍不通","pinyin":"yī qiào bù tōng","abbr":"yqbt","explanation":"窍：洞，指心窍。没有一窍是贯通的。比喻一点儿也不懂。","source":{"text":"纣性不仁，心不通，安于为恶，杀比干，故孔子言其一窍通则比干不见杀也。","book":"《吕氏春秋·过理》：“杀比干而视其心，不适也。孔子闻之曰：‘其窍通，则比干不死矣。’”高诱注"},"example":{"text":"虽然他是～的浑虫，可是双桥镇上并无“镇长”之流的官儿，他也还明白。","book":"茅盾《子夜》六"},"similar":["一无所知","目不识丁"],"opposite":["无所不知","全知全能"],"usage":"作谓语、定语；指什么都不懂","story":["商纣王昏庸无道，沉湎于酒色，轻信宠妃妲己的谗言，杀害忠臣梅伯，大臣比干极力劝谏商纣王不要错杀无辜。商纣王却把比干杀了，挖出他的心看有几窍。孔子评说如果商纣王心窍通一窍，则就不会错杀忠臣了"]},{"id":884,"word":"一窍通，百窍通","pinyin":"yī qiào tōng，bǎi qiào tōng","abbr":"yqtbqt","explanation":"窍：孔。关键的一窍通了，百窍都通。形容关键的一点明白了，所有的也随之而明白","source":{"text":"这猴王也是他一窍通时百窍通，当时习了口诀，自修自炼。","book":"明·吴承恩《西游记》第二回"},"example":{"text":"清·文康《儿女英雄传》第18回：“他～，会得更觉容易。”"},"usage":"作谓语、宾语、定语；用于处事"},{"id":885,"word":"一窝端","pinyin":"yī wō duān","abbr":"ywd","explanation":"比喻完全除灭或尽数挪走。","source":{"text":"这就对了，就得这样，谁问咱都告不知道，要没这种精神，咱早就让人一窝端了。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"我们把这个赌博窝点～了。"},"similar":["连锅端"],"usage":"作谓语；指全部消灭"},{"id":886,"word":"一窝蜂","pinyin":"yī wō fēng","abbr":"ywf","explanation":"一个蜂巢里的蜂一下子都飞出来了。形容许多人乱哄哄地同时说话或行动。","source":{"text":"那些小妖，就是一窝蜂，齐齐拥上。","book":"明·吴承恩《西游记》第28回"},"example":{"text":"他们～地赶忙拥向饭堂。"},"similar":["一窝风"],"usage":"作定语、状语；指混乱不堪"},{"id":887,"word":"一窝风","pinyin":"yī wō fēng","abbr":"ywf","explanation":"一个蜂巢里的蜂倾巢出动。形容人多声杂，乱哄哄地一拥而上","source":{"text":"长枪短铳，和着铁镖弩箭，一窝风的向日兵聚集处杀去。","book":"曾朴《孽海花》第33回"},"example":{"text":"叶圣陶《丁祭》：“‘当然灵验’，大家～地给他批准。”"},"similar":["一窝蜂"],"usage":"作定语、状语；指混乱不堪"},{"id":888,"word":"一竹竿打到底","pinyin":"yī zhú gān dǎ dào dǐ","abbr":"yzgddd","explanation":"指一次就做成功。","source":{"text":"我爷娘当初把我嫁给王押司，只指望一竹竿打到底，不想半路相抛。","book":"明·施耐庵《水浒传》第45回"},"similar":["一竿子捅到底"],"usage":"作宾语、定语；指一次成功"},{"id":889,"word":"一竿子捅到底","pinyin":"yī gān zǐ tǒng dào dǐ","abbr":"ygztdd","explanation":"指一步到位。","source":{"text":"这篇文章好就好在一竿子捅到底，骂到了皇帝头上。","book":"姚雪垠《李自成》第一卷第29章"},"example":{"text":"他做事的风格就是喜欢～。"},"similar":["一竹竿打到底"],"usage":"作宾语、定语；指一次成功"},{"id":890,"word":"一竿风月","pinyin":"yī gān fēng yuè","abbr":"ygfy","explanation":"风月：清风明月，指美好的景色。比喻忘却世事，在清风明月的美景下行乐。","source":{"text":"一竿风月，一蓑烟雨，家在钓台西住。","book":"宋·陆游《鹊桥仙》词"},"example":{"text":"回首壮游真昨梦，～老南湖。","book":"宋·陆游《感旧》"}},{"id":891,"word":"一笑一颦","pinyin":"yī xiào yī pín","abbr":"yxyp","explanation":"指脸上的表情。同“一颦一笑”。","source":{"text":"大客厅上有几个人，都屏息侧立，在伺察吴荪甫的一笑一颦。","book":"茅盾《子夜》十"},"example":{"text":"我始终忘不了她那动人的～"},"similar":["一颦一笑"],"usage":"作主语、宾语、定语；指人的表情"},{"id":892,"word":"一笑了之","pinyin":"yī xiào liǎo zhī","abbr":"yxlz","explanation":"笑一笑就算了事，指不予重视。","source":{"text":"那显然是幺长子对白酱丹的毒辣的讽刺；纵然他本人仅仅一笑了之。","book":"沙汀《淘金记》"},"example":{"text":"这样的事情我们～，不必太在意。"},"similar":["一笑了事","一笑置之"],"usage":"作谓语、宾语；指不予重视"},{"id":893,"word":"一笑了事","pinyin":"yī xiào le shì","abbr":"yxls","explanation":"笑一笑就算了事，指不予重视。同“一笑了之”。","source":{"text":"抚台听了，先还摸不着头脑，还以为某人办事不诚实，所以钦差才加了他这个考语；后来别位司、道说起，晓得是为带着表，方才付之一笑了事。","book":"清·李宝嘉《官场现形记》第四十六回"},"example":{"text":"幸好这位所长深知旗人的劣根性，没把它当成政治案件，只是淡淡地～。","book":"赵大年《公主的女儿》七"},"similar":["一笑置之","一笑了之"],"usage":"作谓语、定语；用于处事"},{"id":894,"word":"一笑倾城","pinyin":"yī xiào qīng chéng","abbr":"yxqc","explanation":"形容女子的绝色。","source":{"text":"北方有佳人，绝世而独立，一顾倾人城，再顾倾人国。","book":"《汉书·外戚传上·孝武李夫人》"},"example":{"text":"唐·李白《古风》：“眉目艳皎月，～欢。”"},"similar":["倾国倾城"],"usage":"作谓语、定语；多用于女性"},{"id":895,"word":"一笑千金","pinyin":"yī xiào qiān jīn","abbr":"yxqj","explanation":"美女一笑，价值千金。形容美人一笑很难得。","source":{"text":"回顾百万，一笑千金。","book":"汉·崔骃《七依》"},"example":{"text":"借得山东烟水寨，来买凤城春色。翠袖围香，绛绡笼雪，～值。","book":"明·施耐庵《水浒全传》第七十二回"},"similar":["千金一笑"],"usage":"作谓语、宾语、定语；用于美人等"},{"id":896,"word":"一笑百媚","pinyin":"yī xiào bǎi mèi","abbr":"yxbm","explanation":"形容美人的笑态。","source":{"text":"回眸一笑百媚生，六宫粉黛无颜色。","book":"唐·白居易《长恨歌》"},"example":{"text":"妺喜蛊惑，～而色厉。","book":"宋·罗泌《路史·后纪十三下·帝履癸》"},"usage":"作宾语、定语；用于女性"},{"id":897,"word":"一笑置之","pinyin":"yī xiào zhì zhī","abbr":"yxzz","explanation":"笑一笑，就把它放在一边了。表示不当回事。","source":{"text":"一笑俱置之，浮生故多难。","book":"宋·杨万里《观水叹》诗：“出处未可必，一笑姑置之。” 宋·陆游《书梦》诗"},"example":{"text":"漕台见他如此说法，晓得他牛性发作，也只好～。","book":"清·李宝嘉《官场现形记》第四十六回"},"similar":["付之一笑","付诸一笑","置之不理"],"opposite":["拭目以待","斤斤计较","锱铢必较"],"usage":"作谓语、定语；用于处事"},{"id":898,"word":"一笔不苟","pinyin":"yī bǐ bù gǒu","abbr":"ybbg","explanation":"不苟：不苟且。连一笔都不马虎。","source":{"text":"前后一笔不苟，功力如此，洵神技也。","book":"清·沈初《西清笔记·纪名迹》"},"example":{"text":"我的创作态度多么严肃，我真是～。","book":"茅盾《无题》"},"similar":["一字千金","谨小慎微","郑重其事"],"opposite":["马虎了事","草率从事","粗心大意"],"usage":"作谓语、定语、状语；形容十分认真"},{"id":899,"word":"一笔勾倒","pinyin":"yī bǐ gōu dǎo","abbr":"ybgd","explanation":"把账一笔抹掉。比喻把一切全部取消。","source":{"text":"公取班簿，视不才监司，每见一人姓名，一笔勾之。","book":"宋·朱熹《五朝名臣言行录》卷七"},"example":{"text":"乃命鲍二等人不许提三说二的，直以奶奶称之，自己也称奶奶，竟将凤姐～。","book":"清·曹雪芹《红楼梦》第六十五回"}},{"id":900,"word":"一笔勾断","pinyin":"yī bǐ gōu duàn","abbr":"ybgd","explanation":"全部取消之意。同“一笔勾消”。","source":{"text":"此事今已一笔勾断云云。","book":"宋·陈亮《与吴益恭书》"},"example":{"text":"倘我人朝，曹公仁德，则～；倘若不仁，就死于帝都。","book":"《三国志平话》卷下"},"usage":"作谓语、定语；用于处事"},{"id":901,"word":"一笔勾消","pinyin":"yī bǐ gōu xiāo","abbr":"ybgx","explanation":"全部取消之意。亦作“一笔勾销”。","source":{"text":"我们不少的是银子，匡得将来买上买下。再央一个乡官在太守处说了人情，婚约一纸，只须一笔勾消。","book":"明·凌濛初《初刻拍案惊奇》卷十"},"example":{"text":"可见你们男人的心是狠的，一翻了脸，就把前情～。","book":"清·魏秀仁《花月痕》第二十九回"},"similar":["一笔勾销"],"usage":"作谓语、宾语；指帐务等"},{"id":902,"word":"一笔勾绝","pinyin":"yī bǐ gōu jué","abbr":"ybgj","explanation":"把账一笔抹掉。比喻把一切全部取消。","source":{"text":"公取班簿，视不才监司，每见一人姓名，一笔勾之。","book":"宋·朱熹《五朝名臣言行录》卷七"},"example":{"text":"咱两个再相逢似水底捞明月，弟兄情～。","book":"元·宫大用《范张鸡黍》第二折"}},{"id":903,"word":"一笔勾销","pinyin":"yī bǐ gōu xiāo","abbr":"ybgx","explanation":"把账一笔抹掉。比喻把一切全部取消。","source":{"text":"公取班簿，视不才监司，每见一人姓名，一笔勾之。","book":"宋·朱熹《五朝名臣言行录》卷七"},"example":{"text":"如有班部监司，不才官吏，～，永不叙用。","book":"元·无名氏《延安府》第二折"},"similar":["一笔勾消"],"opposite":["债台高筑"],"usage":"作谓语、宾语；指帐务等","story":["北宋时期著名文学家、政治家范仲淹，对官场存在的腐败现象深恶痛绝，担任参政时，他在查考地方官吏政绩时，将那些不称职的官吏名字一笔勾之。大臣富弼去劝说他不要如此断送别人的前程，范仲淹说：“他哭比百姓哭要好吧！”"]},{"id":904,"word":"一笔抹倒","pinyin":"yī bǐ mǒ dǎo","abbr":"ybmd","explanation":"画一笔，全部抹掉。比喻轻率地把成绩、优点全部否定。","source":{"text":"是时席元山虽狠愎，亦未敢遽执其事，尚请覆核，而世宗独断，直谓议礼新贵所昭雪，即跖蹻亦必曾史。遂将前后爰书，一笔抹杀。","book":"明·沈德符《万历野获编·嘉靖大狱张本》"},"example":{"text":"杨国忠见卷面上有李白姓名，便不管好歹，～。","book":"清·褚人获《隋唐演义》第八十回"},"similar":["一笔抹杀","一笔抹煞"],"usage":"作谓语、宾语；指全盘否定"},{"id":905,"word":"一笔抹摋","pinyin":"yī bǐ mò sà","abbr":"ybms","explanation":"比喻轻率地把成绩、优点全部否定。同“一笔抹煞”。"},{"id":906,"word":"一笔抹杀","pinyin":"yī bǐ mǒ shā","abbr":"ybms","explanation":"比喻轻率地把成绩、优点全部否定。","source":{"text":"遂将前后爱书，一笔抹杀。","book":"明·沈德符《野获编》"},"example":{"text":"然而新的批评家不开口，类似批评家之流便趁势～。","book":"鲁迅《二心集·我们要批评家》"},"similar":["一笔抹煞","一笔勾销"],"usage":"作谓语；指全盘否定"},{"id":907,"word":"一笔抹煞","pinyin":"yī bǐ mǒ shā","abbr":"ybms","explanation":"抹煞：勾销。画一笔，全部抹掉。比喻轻率地把成绩、优点全部否定。","source":{"text":"所以天降奇灾，北拳南革，要将历代圣贤一笔抹煞，此也是自然之理，不足为奇的事。","book":"清·刘鹗《老残游记》第十一回"},"example":{"text":"我们对每一个人都应该一分为二，不能因为他犯了错误，就～他的优点。"},"similar":["一概而论"],"opposite":["生吞活剥"],"usage":"作谓语；指全盘否定"},{"id":908,"word":"一筹不吐","pinyin":"yī chóu bù tǔ","abbr":"ycbt","explanation":"筹：筹划、计谋。一点计策也施展不出，一点办法也想不出来。","source":{"text":"其极至于九重深拱而群臣尽废，多士盈庭而一筹不吐。","book":"《宋史·蔡幼学传》"}},{"id":909,"word":"一筹不画","pinyin":"yī chóu bù huà","abbr":"ycbh","explanation":"筹：筹划、计谋。一点计策也施展不出，一点办法也想不出来。","source":{"text":"平居终日，如含瓦石，临事一筹不画，此俗人也。","book":"宋·黄庭坚《书增卷后》"},"example":{"text":"厮守许多时价，谁信～。相送到矾园，赢得泪珠如泻。挥洒，挥洒，将底江州司马。","book":"宋·向滈《如梦令》词"}},{"id":910,"word":"一筹莫展","pinyin":"yī chóu mò zhǎn","abbr":"ycmz","explanation":"筹：筹划、计谋；展：施展。一点计策也施展不出，一点办法也想不出来。","source":{"text":"其极至于九重深拱而群臣尽废，多士盈庭而一筹不吐。","book":"《宋史·蔡幼学传》"},"example":{"text":"平时学习不认真，不求甚解，到用时就会感到知识贫乏，～。"},"similar":["束手无策","束手待毙"],"opposite":["神通广大","大显身手","大显神通"],"usage":"作谓语、定语、补语；指无计可施","story":["南宋校书郎蔡幼学是一个饱学而敢说实话的人。宋宁宗即位后要求大臣纳谏，蔡幼学认为要孝敬父母、任人唯贤、宽厚待人才能当好皇帝，他反对“多士盈庭而一筹莫吐”的局面，主张广兴学校，罗致人才，重用天下的仁人志士"]},{"id":911,"word":"一箪一瓢","pinyin":"yī dān yī piáo","abbr":"ydyp","explanation":"一箪食物，一瓢饮料。形容读书人安于贫穷的清高生活。","source":{"text":"一箪食，一瓢饮，在陋巷，人不堪其忧，回也不改其乐。","book":"《论语·雍也》"},"similar":["箪瓢陋巷"],"usage":"作定语、状语；形容生活清贫","story":["春秋时期，孔子特别喜欢他的学生鲁国的颜回，他出身贫寒的家庭，过着“一箪食，一瓢饮”的俭朴生活，但他十分谦虚，知过必改，从不犯第二次同样的错误，待人十分热情。孔子自豪地说：“自吾有回，门人益亲。”可惜他只活了32年"]},{"id":912,"word":"一箭上垛","pinyin":"yī jiàn shàng duò","abbr":"yjsd","explanation":"垛：土筑的箭靶。第一箭就射中了箭垛子。比喻说话做事一次就成功。","source":{"text":"这个不打紧，我如今就去，一箭上垛。","book":"元·无名氏《符金锭》第二折"},"example":{"text":"大官人若见了，管情～。","book":"明·兰陵笑笑生《金瓶梅词话》第七回"},"similar":["一箭中的"],"usage":"作谓语、定语；指一次就成功"},{"id":913,"word":"一箭之地","pinyin":"yī jiàn zhī dì","abbr":"yjzd","explanation":"古人用箭射出的长度做度量，每箭的距离约为一百三十步左右。相当于一箭射程的距离。比喻相距不远。","source":{"text":"放我一箭之地，埋锅造饭去。","book":"元·无名氏《诸葛亮博望烧屯》第三折"},"example":{"text":"宋江上得马来，前行的众头领，已去了～，见宋江和贯忠说话，都勒马伺候。","book":"明·施耐庵《水浒全传》第九十回"},"similar":["咫尺之隔","近在眼前"],"opposite":["远在天边","天涯海角","遥遥相望"],"usage":"作主语、宾语；比喻不很远的距离"},{"id":914,"word":"一箭之遥","pinyin":"yī jiàn zhī yáo","abbr":"yjzy","explanation":"相当于一箭射程的距离。比喻相距不远。","source":{"text":"宋江上得马来，前行的众头领，已去了一箭之地，见宋江和贯忠说话，都勒马伺候。","book":"明·施耐庵《水浒全传》第九十回"}},{"id":915,"word":"一箭双雕","pinyin":"yī jiàn shuāng diāo","abbr":"yjsd","explanation":"原指射箭技术高超，一箭射中两只雕。后比喻做一件事达到两个目的。","source":{"text":"尝有二雕飞而争肉，因以箭两只与晟，请射取之。晟驰往，遇雕相攫，遂一发双贯焉。","book":"《北史·长孙晟传》"},"example":{"text":"因为凤珠也是十六岁的人了，胡统领早存了个得陇望蜀的心思，想慢慢施展他～的手段。","book":"清·李宝嘉《官场现形记》第十二回"},"similar":["一石两鸟","一举两得","事半功倍"],"opposite":["事倍功半"],"usage":"作谓语、定语；指做一件事达到两个目的","story":["北周武将长孙晟足智多谋，奉宣帝之命协助宇文神庆护送公主赴突厥完婚。突厥国王摄图留长孙晟住一年，他们经常一起去打猎，一次发现空中有两只雕在争一块肉，长孙晟纵马前奔，拉弓搭箭射去，一箭正好射中两只大雕的胸脯"]},{"id":916,"word":"一箭射两垛","pinyin":"yī jiàn shè liǎng duò","abbr":"yjsld","explanation":"垛：土筑的箭靶。一支箭要射中两个靶子。比喻希望一举两得。","source":{"text":"张郎在贪生，一箭射两垛。","book":"唐·张文成《游仙窟 》"}},{"id":917,"word":"一篑之功","pinyin":"yī kuì zhī gōng","abbr":"ykzg","explanation":"篑：盛土的筐。指成功前的最后一筐土。比喻成功前的最后一份努力。","source":{"text":"务收一篑之功，勿为九仞之弃。","book":"《王守仁全集》卷一"},"example":{"text":"我舒坦其外紧张其里的生活已久，此千钧一发之际，不可亏～。","book":"丁中江《北洋军阀史话·曹锟变成阶下囚》"}},{"id":918,"word":"一篑之衅","pinyin":"yī kuì zhī xìn","abbr":"ykzx","explanation":"衅：事端，征兆。比喻极小的事端。","source":{"text":"一篑之衅，积成山岳。","book":"晋·陆机《豪士赋序》"}},{"id":919,"word":"一篑障江河","pinyin":"yī kuì zhàng jiāng hé","abbr":"ykzjh","explanation":"篑：盛土的筐。用一筐土去堵塞长江大河的泛滥。比喻所用力量微薄，无济于事。","source":{"text":"何武、王嘉，区区以一篑障江河，用没其身。","book":"《汉书·何武等传赞》"},"example":{"text":"而臣欲以～之流，可谓不自量已。","book":"宋·高登《上渊圣皇帝》"}},{"id":920,"word":"一篙到底","pinyin":"yī gāo dào dǐ","abbr":"ygdd","explanation":"比喻一辈子在一起，不半路上相抛。多指夫妻相守一直到老。","source":{"text":"我爹娘当初把我嫁王押司，只指望一竹竿打到底，谁想半路相抛。","book":"明·施耐庵《水浒全传》第四十五回"}},{"id":921,"word":"一簧两舌","pinyin":"yī huáng liǎng shé","abbr":"yhls","explanation":"比喻胡言乱语。","source":{"text":"一簧两舌，妄言谄语。","book":"汉·焦延寿《易林》卷十三"},"similar":["胡言乱语"],"usage":"作谓语、定语；指胡言乱语"},{"id":922,"word":"一粥一饭，当思来处不易","pinyin":"yī zhōu yī fàn，dāng sī lái chù bù yì","abbr":"yzyfdslcby","explanation":"一口粥，一口饭，都应当想到来得不容易。劝告人们要尊重劳动，爱惜粮食。","source":{"text":"一粥一饭，当思来处不易；半丝半缕，恒念物力维艰。","book":"清·朱柏庐《治家格言》"},"example":{"text":"古语说：‘～；半丝半缕，恒念物力维艰’哪！","book":"梁斌《红旗谱》第一卷"},"usage":"作宾语、分句；用于劝诫人"},{"id":923,"word":"一系相承","pinyin":"yī xì xiāng chéng","abbr":"yxxc","explanation":"一系：一个血统；相承：继承。从同一血统、派别世代相承流传下来。批某种思想、行为或学说之间有继承关系。","source":{"text":"是故言必称尧舜，而非尧舜之道则不敢陈于王前，一脉相承，如薪传火，无他道也。","book":"宋·钱时《两汉笔记》卷十一"},"example":{"text":"但他要驳斥激变论，就得强调各种生物先后代的～，结果把质变一面放在一边了。","book":"周建人《达尔文主义》"}},{"id":924,"word":"一索得男","pinyin":"yī suǒ dé nán","abbr":"ysdn","explanation":"旧时指头胎生子。","source":{"text":"震，一索而得男，故谓之长男。","book":"《周易·说卦》"},"example":{"text":"居然～，现在还未满月哩！","book":"清·吴趼人《糊涂世界》第八卷"},"similar":["一索成男"],"usage":"作谓语；指头胎生子"},{"id":925,"word":"一索成男","pinyin":"yī suǒ chéng nán","abbr":"yscn","explanation":"旧时指头胎生子。同“一索得男”。","source":{"text":"十为良月阳将长，一索成男喜可知。","book":"宋·王迈《贺陈讲书谋仲诹璋庆》诗"},"similar":["一索得男"],"usage":"作谓语、定语；用于书面语"},{"id":926,"word":"一紫盖十红","pinyin":"yī zǐ gài shí hóng","abbr":"yzgsh","explanation":"比喻上行下效。","source":{"text":"《管子》齐桓好服紫，齐人尚之，五秦易一紫。今变之为，一紫盖十红。","book":"清·翟颢《通俗编·识余》"}},{"id":927,"word":"一纸千金","pinyin":"yī zhǐ qiān jīn","abbr":"yzqj","explanation":"一纸价值千金。极言诗文价值之高。","source":{"text":"滕王蛱蝶江都马，一纸千金不当价。","book":"宋·陈师道《题明发高轩过图》诗"},"opposite":["一纸空文"],"usage":"作宾语、定语；用于书面语"},{"id":928,"word":"一纸空文","pinyin":"yī zhǐ kōng wén","abbr":"yzkw","explanation":"只是写在纸上没有兑现或不能兑现的东西。","source":{"text":"近来又有了什么外销名目，说是筹了款项，只能办理本省之事；将来不过一纸空文咨部塞责。","book":"清·李宝嘉《官场现形记》第46回"},"example":{"text":"徒凭袁总统～，岂即肯拱手听命，就此安静么？","book":"蔡东藩《民国通俗演义》第十回"},"similar":["空头支票","纸上谈兵","虚无飘渺"],"opposite":["有凭有据","有案可稽","货真价实"],"usage":"作主语、宾语；指无用的文书"},{"id":929,"word":"一纸糊涂帐","pinyin":"yī zhǐ hú tú zhàng","abbr":"yzhtz","explanation":"内容混乱，根本无法算清楚的帐目。比喻无法弄清楚的事情。","source":{"text":"诸葛大名非用墨，清高二字肃千秋。如今一纸糊涂帐，满面松烟不识羞。","book":"明·朱国桢《涌幢小品·大名》"},"example":{"text":"可怜斛律金，竟不成屋字，～，笑我亦不已。","book":"清·赵翼《右手忽患疯痹，食指中指不能把笔，将成痼疾矣》"}},{"id":930,"word":"一线不乱","pinyin":"yī sī bù luàn","abbr":"yxbl","explanation":"形容布置或收拾得非常整齐，一点也不紊乱。","source":{"text":"人生原是傀儡，只要把柄在手，一线不乱，卷舒自由，行止在我，一毫不受他人捉掇，便超此场中矣。","book":"明·洪应明《菜根谭·闲适》"}},{"id":931,"word":"一线之路","pinyin":"yī xiàn zhī lù","abbr":"yxzl","explanation":"指一条活路。","source":{"text":"若权奸之去，则正当洗肠涤胃。若借温太真之事，为小人开一线之路；借范尧夫之言，为君子忧后来之祸，则失之矣。","book":"宋·罗大经《鹤林玉露》卷十六"},"example":{"text":"只见贼夫贼妇俱备跪下，说道：‘只求爷爷开～，饶我二人性命。’","book":"清·石玉昆《三侠五义》第七十四回"},"usage":"作宾语；用于书面语"},{"id":932,"word":"一线希望","pinyin":"yī xiàn xī wàng","abbr":"yxxw","explanation":"还有一点微弱的希望。","source":{"text":"我心理还有一线希望，以为它偶然跑到远处去，也许会认得归途的。","book":"郑振铎《猫》"},"example":{"text":"只要有～，我是绝对不会放弃的。"},"similar":["一线生机"],"opposite":["穷途末路"],"usage":"作宾语、定语；用于期盼"},{"id":933,"word":"一线生机","pinyin":"yī xiàn shēng jī","abbr":"yxsj","explanation":"线：微小；生机：生存的机会。还有一点儿生存的希望。","source":{"text":"若借温太真之事，为小人开一线生路，借范尧夫之言，为君子忧后来之祸，则失之矣。","book":"宋·罗大经《鹤林玉露》"},"example":{"text":"眼前分明有～。","book":"茅盾《林家铺子》"},"similar":["一线希望","一息尚存"],"opposite":["一潭死水","一杯黄土","死气沉沉"],"usage":"作主语、定语、宾语；指希望"},{"id":934,"word":"一线生路","pinyin":"yī xiàn shēng lù","abbr":"yxsl","explanation":"生路：维持生活或自下而上的途径。仅仅能生存的路子。","source":{"text":"黄门犯法，理当正罪，原无可辞；但有一事，情在可矜之列，望总兵法外施仁，开此一线生路，则愚父子虽死九泉，感德无涯矣。","book":"明·许仲琳《封神演义》第三十四回"},"example":{"text":"嗣又知武帝未曾批准，还有～，乃复饮食如常。","book":"蔡东藩《前汉演义》第六十四回"}},{"id":935,"word":"一统天下","pinyin":"yī tǒng tiān xià","abbr":"yttx","explanation":"天下：指全国。原指统一的国家，现多指某一地区或某一机构不贯彻上级意图而形成的独立王国。也泛指为少数人所霸占的某一领域。","source":{"text":"何言乎王正月，大一统也。","book":"《公羊传·成公十五年》：“王者欲一乎天下。”又，《隐公元年》"},"example":{"text":"汉朝自高祖斩白蛇而起义，～。","book":"明·罗贯中《三国演义》第一回"},"similar":["独立王国"],"opposite":["四分五裂","一盘散沙"],"usage":"作谓语、定语、宾语；指统一国家","story":["我国历史上第二个一统天下的朝代是汉朝，秦朝统一后，由于暴政造成各地起义此起彼伏，汉高祖刘邦趁机斩白蛇而举义旗，一统天下，他也犯了分封诸侯的错误，造成内部诸侯争权夺利，战争不断，到了汉献帝时候，国家又分为三国"]},{"id":936,"word":"一缕不挂","pinyin":"yī lǚ bù guà","abbr":"ylbg","explanation":"原是佛教用来比喻人没有一丝牵挂。后指人赤身裸体。","source":{"text":"潭上有一兔，在水中央。唐谓必致之，乃脱衣泅水，无何为泛波漂没而卒，所谓一缕不挂也。","book":"《楞严经》：“一丝不挂，竿木随身。”宋·孙光宪《北梦琐言·彭钉筋》"}},{"id":937,"word":"一缘一会","pinyin":"yī yuán yī huì","abbr":"yyyh","explanation":"指有缘相合。","source":{"text":"吴山道：‘拜问娘子青春？’小妇人道：‘与官人一缘一会，奴家也是二十四岁。’","book":"明·冯梦龙《古今小说·新桥市韩五卖春情》"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第一卷：“此番造化，～，都是上天作成的。”"},"similar":["天缘凑合"],"usage":"作谓语、状语；用于书面语"},{"id":938,"word":"一缺十求","pinyin":"yī quē shí qiú","abbr":"yqsq","explanation":"旧指一个职位空缺，谋求这个职位的人很多。","source":{"text":"每一官缺，求者十辈，蕴无所是非。","book":"《晋书·王蕴传》"}},{"id":939,"word":"一网尽扫","pinyin":"yī wǎng jìn sǎo","abbr":"ywjs","explanation":"犹一网打尽。比喻一个不漏地全部抓住或彻底肃清。"},{"id":940,"word":"一网打尽","pinyin":"yī wǎng dǎ jìn","abbr":"ywdj","explanation":"比喻一个不漏地全部抓住或彻底肃清。","source":{"text":"聊为相公一网打尽。","book":"宋·魏泰《东轩笔录》卷四"},"example":{"text":"人民也会想到：使汉奸合法化的，自己就是汉奸，人民的决心是要～的。","book":"闻一多《谨防汉奸合法化》"},"similar":["斩草除根","全军覆没","一扫而光"],"opposite":["一介不取"],"usage":"作谓语、定语；用于坏人或鱼","story":["北宋时期，著名诗人苏舜钦追随改革派范仲淹，屡次上书宋仁宗攻击宰相吕夷简。有一次苏舜钦在赛神会命人把旧公文封套卖掉变钱喝酒，被御史刘元瑜知道报告宋仁宗。宋仁宗撤去苏舜钦的官职。刘元瑜得意洋洋说一网打尽苏舜钦"]},{"id":941,"word":"一网无遗","pinyin":"yī wǎng wú yí","abbr":"ywwy","explanation":"用一个网把鸟全部抓住。比喻一个不漏地全部抓住或彻底肃清。","source":{"text":"汤见祝网者，置四面，其祝曰：‘从天坠者，从地出者，从四方来者，皆离吾网。’汤曰：‘嘻！尽之矣。非桀其孰为此也﹖’汤收其三面，置其一面。","book":"《吕氏春秋·异用》"},"example":{"text":"华甫荆生既被执，下之狱，将～矣。","book":"清·钱咏《席氏多贤》"}},{"id":942,"word":"一羽示风向，一草示水流","pinyin":"yī yǔ shì fēng xiàng，yī cǎo shì shuǐ liú","abbr":"yysfxycssl","explanation":"谚语。比喻细微的迹象可以预示事物发展的趋势。"},{"id":943,"word":"一而二，二而一","pinyin":"yī ér èr，èr ér yī","abbr":"yeeeey","explanation":"两件事看似不同，实际上却相同。","source":{"text":"天子神仙，一而二，二而一，岂有三茅祖师之印，陛下用不得之理？","book":"明·罗懋登《三宝太监西洋记通俗演义》第九回"},"example":{"text":"纸，钱也，即古之所为寓钱也；以寓钱喻制钱， ～者也。","book":"清·文康《儿女英雄传》第四回"},"similar":["二而一"],"usage":"作宾语、定语；用于事物"},{"id":944,"word":"一而二，二而三","pinyin":"yī ér èr，èr ér sān","abbr":"yeeees","explanation":"由一至二，由二至三。指由此及彼联想开去。","source":{"text":"因此一而二，二而三，反复推求了去，真不知此时此际，欲为何等蠢物，杳无所知，逃大造，出尘网，便可解释这段悲伤。","book":"清·曹雪芹《红楼梦》第二十八回"},"usage":"作宾语、定语；用于书面语"},{"id":945,"word":"一而光","pinyin":"yī ér guāng","abbr":"yeg","explanation":"比喻彻底清除。同“一扫而空”。"},{"id":946,"word":"一而再，再而三","pinyin":"yī ér zài，zài ér sān","abbr":"yezzes","explanation":"再：第二次。一次又一次。","source":{"text":"那厮必然再用此法，一而再，再而三，我其危矣。","book":"《尚书·多方》：“至于再，至于三。”《荡寇志》一○九回"},"example":{"text":"我之所以生气，是因为你～地犯同样的错误。"},"similar":["屡次三番"],"usage":"作定语、分句；指多次"},{"id":947,"word":"一聚枯骨","pinyin":"yī jù kū gǔ","abbr":"yjkg","explanation":"一聚：一堆。一堆枯朽的骨头。指人死已久。","source":{"text":"乃使甲张口向地，其太玄真符，立出于地，丹书文字如新，甲成一聚枯骨矣。","book":"晋·葛洪《神仙传·老子》"},"example":{"text":"宋·陆游《老学庵笔记》第八卷：“某人汲汲求少艾，求而得之，自谓得计，今成～。”"},"usage":"作宾语、定语；用于书面语"},{"id":948,"word":"一肚子坏水","pinyin":"yī dǔ zǐ huài shuǐ","abbr":"ydzhs","explanation":"指人心肠很坏。","source":{"text":"但此人一肚子坏水儿，吃人不吐骨头，成事不足，败事有余，只能拉拢，不能得罪。","book":"端木蕻良《曹雪芹》第27章"},"example":{"text":"他这个人～，不值得相信。"},"similar":["蛇蝎心肠"],"usage":"作谓语、宾语、定语；指人的心肠坏"},{"id":949,"word":"一股脑儿","pinyin":"yī gǔ nǎo er","abbr":"ygne","explanation":"通通。","source":{"text":"心中不知道是盐是醋是糖是姜，一股脑儿都倒翻了。","book":"曾朴《孽海花》第16回"},"example":{"text":"我就～告诉了父亲。","book":"茅盾《昙》"},"usage":"作状语；指全部"},{"id":950,"word":"一股脑子","pinyin":"yī gǔ nǎo zi","abbr":"ygnz","explanation":"全部，通通。也形容不顾一切地做某件事。","source":{"text":"无奈他此时又盼事成，又怕事不成，把害怕、为难、畅快、欢喜，一股脑子搅成一团，一时抓不着话头儿。","book":"清·文康《儿女英雄传》第十二回"},"example":{"text":"久而久之，不论尊卑长幼远近亲疏，～把称谓搁起来，都叫别号，尤其怪。","book":"清·文康《儿女英雄传》第二十九回"}},{"id":951,"word":"一肢一节","pinyin":"yī zhī yī jié","abbr":"yzyj","explanation":"比喻事物的一小部分。同“一肢半节”。","source":{"text":"但也因为所指的是一群，所以被触着的当然也不会少，即使不是整个，也是那里的一肢一节。","book":"鲁迅《准风月谈·感旧以后（上）》"},"similar":["一支半节","一肢半节"],"usage":"作宾语、定语；用于书面语"},{"id":952,"word":"一肢半节","pinyin":"yī zhī bàn jié","abbr":"yzbj","explanation":"比喻事物的一小部分。","source":{"text":"三代而下，市鲜中行，得乡愿之一肢半节，皆足以成世。","book":"明·袁宗道《读孟子》"},"similar":["一支半节","一肢一节"],"usage":"作宾语、定语；用于书面语"},{"id":953,"word":"一脉亲承","pinyin":"yī mài qīn chéng","abbr":"ymqc","explanation":"一脉：一个血统；承：继承。从同一血统、派别世代相承流传下来。批某种思想、行为或学说之间有继承关系。","source":{"text":"是故言必称尧舜，而非尧舜之道则不敢陈于王前，一脉相承，如薪传火，无他道也。","book":"宋·钱时《两汉笔记》卷十一"}},{"id":954,"word":"一脉同气","pinyin":"yī mài tóng qì","abbr":"ymtq","explanation":"指出于同源。指同胞兄弟姐妹的亲密关系。","source":{"text":"兄弟本是合爹共娘生的，不过分了个先后，原是一脉同气的。","book":"《醒世姻缘传》引起"},"usage":"作谓语、定语；用于书面语"},{"id":955,"word":"一脉相传","pinyin":"yī mài xiāng chuán","abbr":"ymxc","explanation":"一脉：一个血统。从同一血统、派别世代相承流传下来。批某种思想、行为或学说之间有继承关系。","source":{"text":"是故言必称尧舜，而非尧舜之道则不敢陈于王前，一脉相承，如薪传火，无他道也。","book":"宋·钱时《两汉笔记》卷十一"},"example":{"text":"北京的流言报，是从袁世凯称帝，张勋复辟，章士钊“整顿学风”以还，～，历来如此的。","book":"鲁迅《华盖集续编·无花的蔷薇之三》"},"similar":["一脉相承"],"usage":"作谓语、定语、宾语；指文化、思想等"},{"id":956,"word":"一脉相承","pinyin":"yī mài xiāng chéng","abbr":"ymxc","explanation":"一脉：一个血统；相承：继承。从同一血统、派别世代相承流传下来。批某种思想、行为或学说之间有继承关系。","source":{"text":"是故言必称尧舜，而非尧舜之道则不敢陈于王前，一脉相承，如薪传火，无他道也。","book":"宋·钱时《两汉笔记》卷十一"},"example":{"text":"如果我们再知道他们是好到如之问《祭杨盈川文》所说的那程度，我们便更能了然于王、杨与沈、宋所以是～之故。","book":"闻一多《四杰》"},"similar":["一脉相通"],"opposite":["中西合璧"],"usage":"作谓语、定语、宾语；指文化、思想等"},{"id":957,"word":"一脉相通","pinyin":"yī mài xiāng tōng","abbr":"ymxt","explanation":"指事物之间相互关联，犹如一条脉络贯穿下来可以互通。","source":{"text":"倘说：中国画和印象主义有一脉相通，那倒还说得下去的。","book":"鲁迅《花边文学·谁在没落》"},"example":{"text":"人们对《飞天》的喜爱和上面提到的那个鲁班故事所包含的美学思想，实际上有其～之处。","book":"秦牧《艺海拾贝·鲁班的妙手》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":958,"word":"一脉香烟","pinyin":"yī mài xiāng yān","abbr":"ymxy","explanation":"指延续家世的后代。人死，后嗣须常上香祭扫，故云。","source":{"text":"正因为姐姐你在黑风岗能仁寺救了他儿子性命，保了他安家一脉香烟，因此我公婆以德报德，也想续你何家一脉香烟。","book":"清·文康《儿女英雄传》第二十六回"},"usage":"作宾语、定语；用于书面语"},{"id":959,"word":"一脚不移","pinyin":"yī jiǎo bù yí","abbr":"yjby","explanation":"借喻坚定不移。"},{"id":960,"word":"一腔热血","pinyin":"yī qiāng rè xuè","abbr":"yqrx","explanation":"满腔为正义事业而献身的热情。","source":{"text":"胡骑猖狂，中原无主，一腔热血，无以自效。","book":"明·吾邱瑞《运甓记·问卜决疑》"},"example":{"text":"梁启超《新罗马·楔子》：“老夫生当数百年前，抱此～，楚囚对泣。”"},"usage":"作宾语、定语；用于书面语"},{"id":961,"word":"一膀之力","pinyin":"yī bǎng zhī lì","abbr":"ybzl","explanation":"膀：臂膀。指一部分力量或不大的力量。表示从旁帮一点忙。","source":{"text":"不爱斧斤而斫之，期于成器，捐一臂之力，使小人有黄钟大吕之重。","book":"宋·黄庭坚《代人求知人书》"},"example":{"text":"诸位上仙，助我们～吧！","book":"老舍《神拳》第四幕"}},{"id":962,"word":"一臂之力","pinyin":"yī bì zhī lì","abbr":"ybzl","explanation":"臂：胳膊。指一部分力量或不大的力量。表示从旁帮一点忙。","source":{"text":"若得此人助我一臂之力，愁甚冤仇不报。","book":"元·李寿卿《伍员吹箫》第三折"},"example":{"text":"望孔明助～，同破曹贼。","book":"明·罗贯中《三国演义》第四十四回"},"similar":["助人为乐"],"opposite":["落井下石"],"usage":"作宾语；常用在“助”后"},{"id":963,"word":"一臧一否","pinyin":"yī zāng yī pǐ","abbr":"yzyf","explanation":"臧：善，好。一吉一凶。","source":{"text":"国之守龟，其何事不卜，一臧一否，其谁能常之。","book":"《左传·昭公五年》"},"example":{"text":"贤良文学，辩论甚详，然处升平之代，是古则理高；居多务之时，非今则事阙。～，故悉存焉。","book":"唐·杜佑《通典》卷四"}},{"id":964,"word":"一至于斯","pinyin":"yī zhì yú sī","abbr":"yzys","explanation":"竟到如此地步。同“一至于此”。","source":{"text":"家国之事，一至于斯。非臣之尤，谁任其咎！","book":"南朝·梁·任昉《为齐明帝让宣城郡公表》"},"example":{"text":"何神佑助，～，愿垂一语，以保余年。","book":"《景德传灯录·菩提达磨》"},"similar":["一至于此"],"usage":"作谓语、状语；指意想不到"},{"id":965,"word":"一至于此","pinyin":"yī zhì yú cǐ","abbr":"yzyc","explanation":"竟到如此地步。","source":{"text":"笔札无情，任其摇礕。甚矣哉！文之横流，一至于此！","book":"南朝·梁·简文帝《与湘东王书》"},"example":{"text":"我们的祖宗是很富强的，为什么现在贫弱～呢？","book":"孙中山《学生要立志做大事不可做大官》"},"similar":["一至于斯"],"usage":"作谓语、状语；指意想不到"},{"id":966,"word":"一至此","pinyin":"yī zhì cǐ","abbr":"yzc","explanation":"意思是竟然到了如此的地步。","source":{"text":"客人不知其是商君也，曰：‘商君之法，舍人无验者坐之。’商君喟然叹曰：‘嗟乎，为法之敝一至此哉！’","book":"《史记·商君列传》"},"example":{"text":"伤哉！纣天子何无仁心～也！","book":"明·许仲琳《封神演义》第九十八回"}},{"id":967,"word":"一致百虑","pinyin":"yī zhì bǎi lǜ","abbr":"yzbl","explanation":"一致：趋向相同；百虑：各种考虑。趋向虽然相同，却有各种考虑。儒家指虑虽种种，理归于一。","source":{"text":"天下同归而殊途，一致而百虑。","book":"《周易·系辞下》"},"example":{"text":"却说同归殊途，～。","book":"宋·朱熹《朱子语类》第76卷"},"similar":["殊途同归"],"usage":"作谓语、宾语；指有各种不同的考虑"},{"id":968,"word":"一般无二","pinyin":"yī bān wú èr","abbr":"ybwe","explanation":"完全一样，没有不同的地方。","source":{"text":"纵是一根藤上结的，也有个大小不同，偏正不一，却怎么一般无二？","book":"明·吴承恩《西游记》第三十五回"},"example":{"text":"跷蹊！跷蹊！他的铃儿怎么与我的铃儿就～！","book":"明·吴承恩《西游记》第七十一回"},"similar":["一模一样","毫无二致"],"opposite":["天壤之别"],"usage":"作谓语、定语；指完全一样"},{"id":969,"word":"一般见识","pinyin":"yī bān jiàn shí","abbr":"ybjs","explanation":"平常的见识。表示不要跟知识低、修养差的人争论，说“不要跟他一般见识。”","source":{"text":"若知是我，怎么敢骂，我不和你一般见识。","book":"元·关汉卿《鲁斋郎》第一折"},"example":{"text":"小人也知那厮胡为，不与他～。（明·施耐庵《水浒全传》第十四回）"},"usage":"作谓语、宾语；用于口语"},{"id":970,"word":"一艺之长","pinyin":"yī yì zhī cháng","abbr":"yyzz","explanation":"艺：技艺，本领；长：擅长、长处。指有某种技能或特长。","source":{"text":"愚兄平生漫骂无礼，然人有一才一技之长，一行一言之美，未尝不啧啧称道。","book":"清·郑燮《郑板桥集·家书·淮安舟中寄舍弟墨》"},"example":{"text":"旋有学士阿理瑚奏请从祀文庙，礼臣复奏，以为创造国书，～，不当从祀，未经议准。","book":"《清史稿·伊克坦传》"}},{"id":971,"word":"一艺微长","pinyin":"yī yì wēi cháng","abbr":"yywz","explanation":"艺：技艺，本领；长：擅长、长处。指有某种技能或特长。","source":{"text":"诸君到此何为，岂徒学问文章，擅一艺微长？便算读书种子，在我所求亦恕。","book":"清·金兰生先生《格言联璧·学问类》"},"example":{"text":"有技为才以德做人诸君到此何为，岂徒学问文章，擅～，便算读书种子。","book":"清·金缨《金玉良言大全·学问篇》"}},{"id":972,"word":"一节一行","pinyin":"yī jié yī xíng","abbr":"yjyx","explanation":"谨守一种德行。常指丢弃大义而史注重小节德行。","source":{"text":"今卷卷然守一节，推一行，虽以毁碎灭沈，犹且弗易者，此察于小好而塞于大道也。","book":"《淮南子·人间训》"}},{"id":973,"word":"一花五叶","pinyin":"yī huā wǔ yè","abbr":"yhwy","explanation":"一花：佛教传入我国后，禅宗以达摩为祖，称“一花”；五叶：佛教发展演变的五个流派。指佛教的宗派。","source":{"text":"一花开五叶，结果自然成。","book":"宋·释道原《景德传灯录》卷二十八"},"example":{"text":"面壁九年看二祖，～亲分付。","book":"宋·黄庭坚《渔家傲》词"}},{"id":974,"word":"一花独放","pinyin":"yī huā dú fàng","abbr":"yhdf","explanation":"一种花独自开放。与“百花齐放”相对，常比喻缺少各种不同形式、风格的艺术作品。","source":{"text":"人民的审美要求多种多样，只有一个画种，那么就没有万紫千红，只有一花独放了。","book":"姚荣铨《无边秋色入画图》"},"example":{"text":"～红一点，百花盛开春满园。","book":"京剧《龙江颂》"},"opposite":["万紫千红"],"usage":"作宾语、定语；用于书面语"},{"id":975,"word":"一芹之微","pinyin":"yī qín zhī wēi","abbr":"yqzw","explanation":"一棵芹菜那样微小的东西。常自谦礼物微薄之词。","source":{"text":"一芹之微，聊中鄙忱，并祈哂纳。","book":"清·陆陇其《与郑堂邑书》"},"usage":"作主语、宾语、定语；用于谦词"},{"id":976,"word":"一苇可航","pinyin":"yī wěi kě háng","abbr":"ywkh","explanation":"一苇：一捆芦苇。用一捆芦苇作成一只小船就可以通行过去。①比喻水面相隔很近，不难渡过。亦作“航一苇”。②比喻用微薄之力就可以把事情解决。","source":{"text":"长江之限，不可久恃，苟我不守，一苇可航也。","book":"《三国志·吴书·贺邵传》"},"example":{"text":"河广不七十步，～，非有惊涛怒浪之险，不足恃者一。","book":"清·张廷玉《明史·方震孺传》"}},{"id":977,"word":"一草一木","pinyin":"yī cǎo yī mù","abbr":"ycym","explanation":"比喻极微小的东西。","source":{"text":"春一草枯则为灾，秋一木华亦为异。","book":"《后汉书·应劭传》"},"example":{"text":"不许惊动，如有犯僖氏～者斩首！","book":"明·冯梦龙《东周列国志》第三十九回"},"similar":["一针一线"],"usage":"作谓语、定语；指细小平常的东西"},{"id":978,"word":"一落千丈","pinyin":"yī luò qiān zhàng","abbr":"ylqz","explanation":"原指琴声陡然降落。后用来形容声誉、地位或经济状况急剧下降。","source":{"text":"跻攀分寸不可上，失势一落千丈强。","book":"唐·韩愈《听颖师弹琴》诗"},"example":{"text":"所以喜奎一嫁，转瞬坤伶声势，～，伶界牛耳，又让男伶夺去。","book":"蔡东藩、许廑父《民国通俗演义》第一二六回"},"similar":["一泻千里","每况愈下","江河日下"],"opposite":["一步登天","一往无前","突飞猛进"],"usage":"作谓语、定语；指声誉、地位或经济状况等"},{"id":979,"word":"一蒂儿到底","pinyin":"yī dì er dào dǐ","abbr":"ydedd","explanation":"比喻一辈子在一起，不半路上相抛。多指夫妻相守一直到老。","source":{"text":"我们随著员外，指望一蒂儿到底，谁想酒席中间，一言两语，竟把我們们与別人。","book":"明·兰陵笑笑生《金瓶梅词话》第五十五回"}},{"id":980,"word":"一薰一莸","pinyin":"yī xūn yī yóu","abbr":"yxyy","explanation":"薰：香草，比喻善类；莸：臭草，比喻恶物。薰莸混在一起，只闻到臭闻不到香。比喻善常被恶所掩盖。","source":{"text":"一薰一莸，十年尚犹有臭。","book":"《左传·僖公四年》"},"example":{"text":"～，十年尚犹有臭。今天好算的香臭会花粪宴了。","book":"清·姬文《市声》第十七回"},"usage":"作宾语、定语；指两者比较","story":["春秋时期，晋献公娶了六个妻子，她们钩心斗角都想当正式夫人立自己所生的儿子为太子。晋献公听信骊姬的花言巧语，要立她为夫人，特地算卦求签，得“一薰一莸，十年尚犹有臭。”","结果他逼死申生，逼走重耳、夷吾，闹得国内大乱"]},{"id":981,"word":"一虎不河","pinyin":"yī hǔ bù hé","abbr":"yhbh","explanation":"原指空手搏虎，徒步渡河，比喻有勇无谋，冒险行事。后在元剧中比喻不顾一切。","source":{"text":"暴虎冯河，死而无悔者，吾不与也。必也临事而惧，好谋而成者也。","book":"《诗·小雅·小旻》：“不敢暴虎，不敢冯河。”《论语·述而》"}},{"id":982,"word":"一虎难敌众犬","pinyin":"yī hǔ nán dí zhòng quǎn","abbr":"yhndzq","explanation":"一只凶猛的老虎也战胜不了众多只狗。比喻弱者只要团结起来就能战胜强者。","example":{"text":"所谓～，我们还是忍一忍吧"},"similar":["寡不敌众"],"usage":"作宾语、定语；用于比喻句"},{"id":983,"word":"一蛇两头","pinyin":"yī shé liǎng tóu","abbr":"yslt","explanation":"比喻阴险凶恶的人。","source":{"text":"一蛇两头见未曾，怪鸟鸣唤令人憎。","book":"唐·韩愈《永贞行》诗"},"usage":"作宾语、定语；指少见的事物"},{"id":984,"word":"一蛇二首","pinyin":"yī shé èr shǒu","abbr":"yses","explanation":"首：头。一条蛇长了两个脑袋。比喻朝廷两个人掌权，政令不一，权力分散。也比喻阴险凶恶的人。","source":{"text":"江氛岭祲昏若凝，一蛇两头见未曾。","book":"唐·韩愈《永贞行》诗"},"example":{"text":"古称一蛇九尾，首动尾随；～，不能寸进。今台纲不张，有～之患。","book":"《元史·姚天福传》"}},{"id":985,"word":"一蛇吞象","pinyin":"yī shé tūn xiàng","abbr":"ystx","explanation":"一条蛇想吞吃一条大象。比喻人心不足，贪得无厌。","source":{"text":"一蛇吞象，厥大何如？","book":"战国·楚·屈原《天问》"},"example":{"text":"对于那些想～的人应该制止。"},"similar":["人心不足蛇吞象"],"opposite":["知足常乐"],"usage":"作宾语、定语；指人贪心不足","story":["传说古代有个穷苦的猎人阿象，他在森林里打猎时救了一条饿昏的小蛇，带回家精心饲养。小蛇慢慢长大成青蛇并通人性，经常从外面给他带回一些值钱的东西来报答。阿象一再向青蛇索取，盼望成为富翁，愤怒的青蛇便将这个贪得无厌的家伙一口吞下"]},{"id":986,"word":"一蟹不如一蟹","pinyin":"yī xiè bù rú yī xiè","abbr":"yxbryx","explanation":"比喻一个不如一个，越来越差。","source":{"text":"艾子行于海上，初见蝤蛑，继见螃蟹及彭越，形皆相似而体愈小，因叹曰：‘何一蟹不如一蟹也？’","book":"宋·苏轼《艾子杂说》"},"example":{"text":"以其嗜蟹，自蝤蛑至蟛蚏，凡罗列十余种。谷笑曰：“真所谓～也。”","book":"清·翟灏《通俗编·禽鱼》引《圣宋掇遗》"},"similar":["一代不如一代"],"usage":"作宾语、定语；指越来越差","story":["传说古代艾子到海边见到一只圆而扁且多腿的动物，就问附近的居民是什么东西，人家告诉他是螃蟹。过了一会，他又看见另一品种不同颜色的类似动物问旁边人，人家回答说是另一种螃蟹，艾子仔细比较，感慨地说：“何一蟹不如一蟹也”"]},{"id":987,"word":"一行作吏","pinyin":"yī xíng zuò lì","abbr":"yxzl","explanation":"一经做了官。","source":{"text":"游山泽，观鱼鸟，心甚乐之。一行作吏，此事便废。","book":"三国魏·嵇康《与山巨源绝交书》"},"example":{"text":"夫人犹诃遣之。耿曰：“今～，何得复尔？”","book":"清·蒲松龄《聊斋志异·云梦公主》"},"usage":"作谓语；指做了官的话就会怎么样"},{"id":988,"word":"一衣带水","pinyin":"yī yī dài shuǐ","abbr":"yyds","explanation":"一条衣带那样狭窄的水。指虽有江河湖海相隔，但距离不远，不足以成为交往的阻碍。","source":{"text":"我为百姓父母，岂可一衣带水不拯之乎？","book":"《南史·陈后主纪》"},"example":{"text":"香港地方，同中国大陆相离，仅仅隔～。","book":"鲁迅《而已集·略谈香港》"},"similar":["一水之隔","近在咫尺","近在眉睫"],"opposite":["天各一方","天涯海角","万水千山"],"usage":"作谓语、定语、宾语；指距离近","story":["公元581年，杨坚取代北周称帝，建立了隋朝，称隋文帝，统一北方后，面对长江以南的陈朝就想统一全国，他经常对手下人说：“我是老百姓的父母，难道因为像衣带似的长江就能挡住我去拯救那里的老百姓吗？”于是出兵渡江灭掉陈朝"]},{"id":989,"word":"一表人才","pinyin":"yī biǎo rén cái","abbr":"ybrc","explanation":"表：指外貌。形容人容貌俊秀端正。","source":{"text":"夫人，放着你这一表人物，怕没有中意的丈夫？","book":"元·关汉卿《望江亭》第一折"},"example":{"text":"太子波前妃生子名夫差，年已二十六岁矣，生得昂藏英伟，～。","book":"明·冯梦龙《东周列国志》第七十九回"},"similar":["一表非凡","仪表堂堂","飒爽英姿"],"opposite":["呆头呆脑","其貌不扬","獐头鼠目"],"usage":"作谓语、定语、宾语；用于口语"},{"id":990,"word":"一表人材","pinyin":"yī biǎo rén cái","abbr":"ybrc","explanation":"形容容貌英俊。表，仪表。","source":{"text":"友梅生得一表人材，美如冠玉，又且颖悟过人，做的文章，便篇篇锦绣，字字珠玑，十五岁上，就领了钱塘县学批首。","book":"明·刘璋《飞花艳想》第一回"},"example":{"text":"他生的～，浓眉大眼，眉眼里甚至有些俊俏。","book":"曹禺《王昭君》第二幕"},"similar":["一表人物","一表人才"],"usage":"作谓语、定语、宾语；用于口语"},{"id":991,"word":"一表人物","pinyin":"yī biǎo rén wù","abbr":"ybrw","explanation":"形容容貌英俊。表，仪表。","source":{"text":"夫人，放着你这一表人物，怕没有中意的丈夫？","book":"元·郑光祖《倩女离魂》第一折：“（梅香云）姐姐，那王秀才生的一表人物，聪明浪子，论姐姐这个模样，正和王秀才是一对儿。”元·关汉卿《望江亭》第一折"},"example":{"text":"这娘子今年不上二十五六岁，生的长挑身材，～，打扮起来就是个灯人儿。","book":"明·兰陵笑笑生《金瓶梅词话》第七回"},"similar":["一表人才","一表人材"],"usage":"作谓语、定语、宾语；用于口语"},{"id":992,"word":"一表堂堂","pinyin":"yī biǎo táng táng","abbr":"ybtt","explanation":"形容仪表堂皇。","source":{"text":"是说曹丞相魁梧奇伟，一表堂堂。","book":"郭沫若《南冠草》第二幕：“智含是死了，端哥小弟是结了婚的人，像你这样一表堂堂的大和尚，谁个不高兴你呢？”又《蔡文姬》第二幕"},"usage":"作谓语、定语、状语；用于人的外表"},{"id":993,"word":"一表非俗","pinyin":"yī biǎo fēi sú","abbr":"ybfs","explanation":"形容人的仪表非比寻常。","source":{"text":"天生的一表非俗，匹配得你过。","book":"元·秦简夫《东堂老》第三折：“他生在无忧愁太平时务，空生得貌堂堂一表非俗。”元·无名氏《鸳鸯被》第一折"},"example":{"text":"李蒙见仲翔～；又且当朝宰相之侄，亲口嘱托，怎敢推委。（明·冯梦龙《喻世明言》第八卷）"},"similar":["一表非凡"],"opposite":["其貌不扬","獐头鼠目"],"usage":"作谓语、定语、宾语；比喻人很潇洒"},{"id":994,"word":"一表非凡","pinyin":"yī biǎo fēi fán","abbr":"ybff","explanation":"表：外貌；凡：平凡。形容人容貌俊秀又有精神。","source":{"text":"天生的一表非俗，匹配得你过。","book":"元·无名氏《鸳鸯被》第一折"},"example":{"text":"适才有东土大唐差来拜佛取经的一个和尚，倒换关文，却～。","book":"明·吴承恩《西游记》第八十八回"},"similar":["一表人才","仪表堂堂","飒爽英姿"],"opposite":["其貌不扬","獐头鼠目","形销骨立"],"usage":"作谓语、定语、宾语；比喻人很潇洒"},{"id":995,"word":"一褱而论","pinyin":"yī huái ér lùn","abbr":"yhel","explanation":"指处理事情或问题不分性质，不加区别，用同一标准来对待或处理。同“一概而论”。"},{"id":996,"word":"一见了然","pinyin":"yī jiàn le rán","abbr":"yjlr","explanation":"犹一目了然。一眼就看得很清楚。","source":{"text":"程泰之《禹贡图》，不惬人意，不能使人一见了然。","book":"元·陈栎《勤有堂随录》"},"example":{"text":"考其同异多寡，为古歌西歌以著之，使览者～。","book":"清·戴名世《中西经星同异考序》"},"similar":["一目了然"],"usage":"作谓语、定语；用于书面语"},{"id":997,"word":"一见倾倒","pinyin":"yī jiàn qīng dǎo","abbr":"yjqd","explanation":"倾倒：佩服，心折。一见面就十分佩服或爱慕。","source":{"text":"一见倾倒，若符若契。","book":"宋·王伯《鲁斋集·祭赵星渚文》"},"example":{"text":"载漪跟他是第二次见面，但～，已很熟悉，所以相见并无客套，开口便谈大事。","book":"高阳《慈禧全传》八十一"},"similar":["一见倾心"],"usage":"作谓语、定语、宾语；指一见钟情"},{"id":998,"word":"一见倾心","pinyin":"yī jiàn qīng xīn","abbr":"yjqx","explanation":"倾心：爱慕。初次见面就十分爱幕。","source":{"text":"主上与将军风殊类别，一见倾心，亲如宗戚。","book":"《资治通鉴·晋孝武帝太元九年》"},"example":{"text":"袁小姐对于我们的太太是～，说我们的太太浑身都是曲线，是他眼中的第一美人。（冰心《我们太太的客厅》）"},"similar":["一见钟情","一见如故","一往情深"],"opposite":["一刀两断","三心二意","无动于衷"],"usage":"作谓语、定语、宾语；指一见钟情"},{"id":999,"word":"一见如故","pinyin":"yī jiàn rú gù","abbr":"yjrg","explanation":"故：老朋友。初次见面就象老朋友一样合得来。","source":{"text":"李邺侯（泌）为相日，吴人顾况西游长安，邺侯一见如故。","book":"《左传·襄公二十九年》：“见子产，如旧相识。”宋·张洎《贾氏谭录》"},"example":{"text":"他们俩～，谈得很投机。"},"similar":["一见钟情","一见倾心","一拍即合"],"opposite":["行同陌路","视同路人"],"usage":"作谓语、定语、状语；指情投意合","story":["隋朝末年，羽骑尉房玄龄看不惯隋王朝的所作所为，毅然抛弃官职去投奔举义旗的秦王李世民。李世民对房玄龄早有耳闻，两人一见如故，都有相见恨晚之感。房玄龄跟随李世民走南闯北，九死一生，为李世民收罗有用的人才，唐朝建立后成为尚书令"]},{"id":1000,"word":"一见如旧","pinyin":"yī jiàn rú jiù","abbr":"yjrj","explanation":"初次见面就情投意合，如同老朋友一样。","source":{"text":"太宗以敦煌公徇渭北，策杖上谒军门，一见如旧。","book":"《新唐书·房玄龄传》"},"example":{"text":"我与他虽从未谋面，但我们～，无话不谈。"},"similar":["一见如故"],"opposite":["行同陌路"],"usage":"作谓语、定语、状语；指很投合"},{"id":1001,"word":"一见钟情","pinyin":"yī jiàn zhōng qíng","abbr":"yjzq","explanation":"钟：集中；钟情：爱情专注。旧指男女之间一见面就产生爱情。也指对事物一见就产生了感情。","source":{"text":"乃蒙郎君一见钟情，故贱妾有感于心。","book":"清·古吴墨浪子《西湖佳话·西泠韵迹》"},"example":{"text":"祁连山俘虏了我的心，青海湖我～。（徐迟《三峡记·远游》）"},"similar":["一见倾心","一见如故","一拍即合"],"opposite":["无动于衷","行同陌路","视同路人"],"usage":"作谓语、定语、宾语；用于男女之间","story":["西汉辞赋家司马相如生活十分艰难，他的朋友邻邛县令王吉邀请他去大财主卓王孙家去做客。他看上了卓王孙的寡妇女儿卓文君，两人一见钟情，用琴声相互倾诉并私订终身，不顾卓王孙的反对，他们自己开店卖酒，开始过他们清苦的生活"]},{"id":1002,"word":"一视之仁","pinyin":"yī shì zhī rén","abbr":"yszr","explanation":"原指圣人对百姓一样看待，同施仁爱。后多表示对人同样看待，不分厚薄。","source":{"text":"是故圣人一视同仁，笃近而举远。","book":"唐·韩愈《原人》卷十一"},"example":{"text":"凡在幅员之内，咸推～。","book":"《明史·西域传》"}},{"id":1003,"word":"一视同仁","pinyin":"yī shì tóng rén","abbr":"ystr","explanation":"原指圣人对百姓一样看待，同施仁爱。后多表示对人同样看待，不分厚薄。","source":{"text":"是故圣人一视同仁，笃近而举远。","book":"唐·韩愈《原人》"},"example":{"text":"警察却不怕自行车，更不怕洋车和三轮儿。他们对洋车和三轮儿倒是～，一个不顺眼就拳脚一齐来。","book":"朱自清《回来杂记》"},"similar":["天公地道","等量齐观","相提并论"],"opposite":["另眼相看","厚此薄彼"],"usage":"作谓语、宾语、定语、状语；形容平等对待"},{"id":1004,"word":"一览了然","pinyin":"yī lǎn liǎo rán","abbr":"yllr","explanation":"了然：清楚，明白。一眼就看得很清楚。","source":{"text":"见得道理透后，从高视下，一目了然。","book":"宋·朱熹《朱子语类》卷一百三十七"},"example":{"text":"东坡看了两三遍，一时念将不出，只是沉吟。小妹取过，～。","book":"明·冯梦龙《醒世恒言》卷十一"}},{"id":1005,"word":"一览全收","pinyin":"yī lǎi quán shōu","abbr":"ylqs","explanation":"览：看。一眼看去，所有的景物全看见了。形容建筑物的结构没有曲折变化，或诗文内容平淡，没有回味。","source":{"text":"江左地促，不如中国，若使阡陌条畅，则一览而尽，故纡余委曲，若不可测。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"然其处上平下嵌，俯瞰莫可见，不若点头峰之突耸而出，可以～也。","book":"明·徐宏祖《徐霞客游记·滇游日记》"}},{"id":1006,"word":"一览无余","pinyin":"yī lǎi wú yú","abbr":"ylwy","explanation":"览：看；余：剩余。一眼看去，所有的景物全看见了。形容建筑物的结构没有曲折变化，或诗文内容平淡，没有回味。","source":{"text":"江左地促，不如中国，若使阡陌条畅，则一览而尽，故纡余委曲，若不可测。","book":"南朝宋·刘义庆《世说新语·言语》"},"example":{"text":"水中岸上都光光的；亏得湖里有五个洲子点缀着，不然便～了。","book":"朱自清《南京》"},"similar":["一目了然","一览而尽","尽收眼底"],"opposite":["一鳞半爪","目不暇接","管中窥豹"],"usage":"作谓语、状语；形容视野开阔"},{"id":1007,"word":"一览无遗","pinyin":"yī lǎi wú yí","abbr":"ylwy","explanation":"览：看；遗：遗留。一眼看去，所有的景物全看见了。形容建筑物的结构没有曲折变化，或诗文内容平淡，没有回味。","source":{"text":"江左地促，不如中国，若使阡陌条畅，则一览而尽，故纡余委曲，若不可测。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"又况此地平漫高亢，贼若据此俯视本关城内虚实强弱，～，为兵家所忌。","book":"明·丛兰《预防边患事》"},"similar":["一览无余"],"usage":"作谓语、状语；形容视野开阔"},{"id":1008,"word":"一览而尽","pinyin":"yī lǎn ér jìn","abbr":"ylej","explanation":"览：看。一眼望去，事物就都收入眼底。","source":{"text":"此丞相乃所以为巧，江左地促，不如中国，若使阡陌条畅，则一览而尽，故纡余委曲，若不可测。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"赵辛楣和鸿渐拉拉手，傲兀地把他从头到脚看一下，好像鸿渐是页～的大字幼稚园读本。","book":"钱钟书《围城》第三章"},"similar":["一览无遗","一览无余"],"usage":"作谓语、定语；用于书面语"},{"id":1009,"word":"一觉扬州梦","pinyin":"yī jiào yáng zhōu mèng","abbr":"yjyzm","explanation":"比喻追忆昔日的繁华逍遥如在梦中刚刚醒悟。","source":{"text":"十年一觉扬州梦，赢得青楼薄幸名。","book":"唐·杜牧《遣怀》"},"example":{"text":"十年～，为报时人洗眼看。","book":"宋·黄庭坚《鹧鸪天》词"}},{"id":1010,"word":"一觞一咏","pinyin":"yī shāng yī yǒng","abbr":"ysyy","explanation":"觞：古代盛酒器，借指饮酒；咏：吟诗。旧指文人喝酒吟诗的聚会。","source":{"text":"一觞一咏，亦足以畅叙幽情。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"陈君时时与樵夫渔父野老相狎，～，悠然自得。","book":"清·戴名世《陈某诗序》"},"similar":["一咏一觞"],"usage":"作宾语、定语；用于文人的交往"},{"id":1011,"word":"一解不如一解","pinyin":"yī xiè bù rú yī xiè","abbr":"yjbryj","explanation":"解：通“蟹”。比喻一个不如一个，越来越差","source":{"text":"至近日，宗门诸名下，争以坛坫自高，相驳相嘲，以至相妒相詈，真一解不如一解矣。","book":"明·沈德符《野获编·释道·禅林诸名宿》"},"similar":["一蟹不如一蟹"],"usage":"作宾语、定语；指越来越差"},{"id":1012,"word":"一触即发","pinyin":"yī chù jí fā","abbr":"ycjf","explanation":"触：碰；即：就。原指把箭扣在弦上，拉开弓等着射出去。比喻事态发展到了十分紧张的阶段，稍一触动就立即会爆发。","source":{"text":"积数千年民族之精髓，递相遗传，递相扩充，其机固有磅礴郁积，一触即发之势。","book":"清·梁启超《论中国学术思想变迁之大势》三"},"example":{"text":"共产党主张成立联合政府，就为罅内战。现在蒋介石拒绝了这个主张，致使内战有～之势。","book":"毛泽东《评蒋介石发言人的谈话》"},"similar":["箭在弦上","剑拔弩张","千钧一发"],"opposite":["引而不发"],"usage":"作谓语、宾语、定语；比喻十分紧张"},{"id":1013,"word":"一触即溃","pinyin":"yī chù jí kuì","abbr":"ycjk","explanation":"指军队士气涣散，跟敌人一接触就崩溃。","source":{"text":"奕山与奕经同样，经过轻举妄动，一触即溃、丧胆、乞降三个程序，结束了浙江军事。","book":"范文澜《中国近代史》上册第一章"},"example":{"text":"胡宗南派到河南的几个师，也是～。","book":"毛泽东《学习和时局》"},"similar":["不堪一击","外强中干"],"opposite":["坚不可摧","稳如泰山","牢不可破"],"usage":"作谓语、宾语、定语；指军队士气涣散"},{"id":1014,"word":"一言一动","pinyin":"yī yán yī dòng","abbr":"yyyd","explanation":"一句话和一个行动。也指每句话和每一个行动","source":{"text":"他们于一言一动之征，一沙一石之细，都不轻轻放过。","book":"朱自清《山野掇拾》"},"similar":["一言一行","一举一动"],"usage":"作主语、宾语；指言行"},{"id":1015,"word":"一言一泪","pinyin":"yī yán yī lèi","abbr":"yyyl","explanation":"形容文字写得凄楚感人。","source":{"text":"写至此，一字一泪，不知当向何人道，当与何人读，想当照旧剃发归山去矣。","book":"明·李贽《焚书·与焦漪园》"},"example":{"text":"吟诗写恨，～，直达宸聪。","book":"清·褚人获《隋唐演义》第九十三回"}},{"id":1016,"word":"一言一行","pinyin":"yī yán yī xíng","abbr":"yyyx","explanation":"每句话，每个行动。","source":{"text":"凡有一言一行，取于人者，皆显称之，不可窃人之美，以为己力。","book":"北齐·颜之推《颜氏家训·幕贤》"},"example":{"text":"则夫～，传其人之神，何以异是。","book":"清·冯景《今世说序》"},"similar":["一举一动","一言一动"],"usage":"作主语、宾语；指言行"},{"id":1017,"word":"一言不再","pinyin":"yī yán bù zài","abbr":"yybz","explanation":"话出口以后，不再反悔。形容言而有信。","source":{"text":"吾闻君子一言不再，今已行矣，王勉之。","book":"《吴越春秋·勾践入臣外传》"}},{"id":1018,"word":"一言不发","pinyin":"yī yán bù fā","abbr":"yybf","explanation":"一句话也不说。","source":{"text":"三巧儿听说丈夫把她休了，一言不发，啼哭起来。","book":"明·冯梦龙《喻世明言》卷一"},"example":{"text":"只见她～，回手拔出那把刀来。","book":"清·文康《儿女英雄传》第七回"},"similar":["一声不响"],"opposite":["侃侃而谈","絮絮叨叨","喋喋不休"],"usage":"作谓语、状语；指默不做声"},{"id":1019,"word":"一言不合","pinyin":"yī yán bù hé","abbr":"yybh","explanation":"一句话说得不投合。","source":{"text":"抗辞请刃诛部曲，作色论兵犯二帅。一言不合龙頟侯，击剑拂衣从此弃。","book":"唐·李颀《别梁锽》"},"example":{"text":"我们现在是要好的，万一将来～，翻转面来，何苦为好成仇，弄到一场没趣？","book":"清·张春帆《九尾龟》第三回"}},{"id":1020,"word":"一言两语","pinyin":"yī yán liǎng yǔ","abbr":"yyly","explanation":"为数不多的几句话。","source":{"text":"倒只愁儿子无真实之才，恐怕一言两语露出马脚。","book":"《玉娇梨》第二回"},"example":{"text":"珠儿的父亲是好是坏，决不是～可以断定。","book":"茅盾《书信·致陈友荀》"},"similar":["三言两语"],"usage":"作宾语、定语；用于说话等"},{"id":1021,"word":"一言丧邦","pinyin":"yī yán sàng bāng","abbr":"yysb","explanation":"指一句话可以亡国。","source":{"text":"周，隋之季，忠臣结舌，一言丧邦，谅足深诫。","book":"《论语·子路》：“一言而丧邦，有诸？”《旧唐书·孙伏伽传》"},"example":{"text":"圣人说话，磨棱合缝，盛水不漏，如云～，以直报怨，自是细密。","book":"《朱子语类》卷十九"},"opposite":["一言兴邦"],"usage":"作宾语、定语；指关键人物的言语","story":["春秋时期，鲁定公问孔子：“一句话可使国家昌盛吗？”孔子说：“君主爱护臣子，关心他们，上下一心，国家可以兴旺。”鲁定公又问：“一句话可以使国家灭亡吗？”孔子说：“不全对，君主一句话下边不提反对意见，久而久之就会走向灭亡。”"]},{"id":1022,"word":"一言中的","pinyin":"yī yán zhōng dì","abbr":"yyzd","explanation":"的：箭靶的中心。一句话正好射中箭靶。比喻一句话就说到关键的地方。","source":{"text":"你做折子须要在此等地方着想，保管你一言中的，上头不能不准。","book":"《中国现在记》第一回"},"similar":["一语破的"],"usage":"作谓语、定语、状语；用于说话"},{"id":1023,"word":"一言为定","pinyin":"yī yán wéi dìng","abbr":"yywd","explanation":"一句话说定了，不再更改。比喻说话算数，决不翻悔。","source":{"text":"程婴，我一言已定，你再不必多疑了。","book":"元·纪君祥《赵氏孤儿》第二折"},"example":{"text":"你我～。只是我信不过二弟，你是萍踪浪迹，倘然去了不来，岂不误了人家一辈子的大事？","book":"清·曹雪芹《红楼梦》第六十六回"},"similar":["一诺千金","说一不二","言而有信"],"opposite":["背信弃义","自食其言","言而无信"],"usage":"作谓语、分句；指说话算数","story":["贾琏听从尤二姐的主张及尤三姐的意见，在外出公干的路上，遇到薛蟠与柳湘莲。贾琏极力向柳湘莲推荐尤三姐，薛蟠也主张亲上加亲。柳湘莲同意这门亲事，贾琏说要一言为定并要拿出定情礼物。柳湘莲把自己祖传的宝剑托贾琏带回"]},{"id":1024,"word":"一言为重，百金为轻","pinyin":"yī yán wéi zhòng，bǎi jīn wéi qīng","abbr":"yywzbjwq","explanation":"金：古代货币单位。严守自己诺言比百两黄金还珍重。指信守诺言可贵。","source":{"text":"自古驱民在信诚，一言为重百金轻。今人未可非商鞅，商鞅能令政必行。","book":"宋·王安石《商鞅》"},"similar":["一言千金","言出必行"],"usage":"作定语、分句；指言出必行","story":["战国时期，商鞅在秦孝公的支持下进行变法，新法公布以后，为使人们相信新法一定要执行，商鞅命人在国都南门处立了一根三丈多高的木柱，声明谁搬动到北门就赏五十金。有一个胆大而力大的人果然得到五十金，人们认为商鞅言出必行就按新法行事"]},{"id":1025,"word":"一言之信","pinyin":"yī yán zhī xìn","abbr":"yyzx","explanation":"信：信用。对自己说的话都很讲信用。","source":{"text":"贤哉楚王！轻千乘之国，而重一言之信，匪申叔之信，不能达其义，匪庄王之贤，不能受其训。","book":"《孔子家语·好生》"}},{"id":1026,"word":"一言九鼎","pinyin":"yī yán jiǔ dǐng","abbr":"yyjd","explanation":"九鼎：古代国家的宝器，相传为夏禹所铸。一句话抵得上九鼎重。比喻说话力量大，能起很大作用。","source":{"text":"毛先生一至楚而使赵重于九鼎大吕。毛先生以三寸之舌，强于百万之师。胜不敢复相士。","book":"《史记·平原君列传》"},"example":{"text":"你若是专家或者要人，～，那自当别论。","book":"朱自清《很好》"},"similar":["一字千钧","一言为定","金口玉言"],"opposite":["人微言轻"],"usage":"作主语、谓语、定语；指重信用","story":["公元前290年，秦兵围攻赵国的都城邯郸，赵王派平原君出使楚国求援，楚王犹豫不决，平原君的食客毛遂执剑上殿，为楚王分析时局，楚王这才派兵救赵。事后平原君称赞毛遂道：毛先生一至楚，而使赵重于九鼎大吕。毛先生三寸之舌，强于百万之师。"]},{"id":1027,"word":"一言以蔽","pinyin":"yī yán yǐ bì","abbr":"yyyb","explanation":"蔽：遮，引申为概括。用一句话来概括。","source":{"text":"《诗》三百，一言以蔽之，曰：‘思无邪。’","book":"《论语·为政》"},"example":{"text":"宋·洪迈《容斋续笔》第12卷：“诗著靡他之誓，百代可知；礼垂不嫁之文，～。”"},"similar":["一言以蔽之","一言蔽之"],"usage":"作谓语、分句；指用一句话来概括"},{"id":1028,"word":"一言以蔽之","pinyin":"yī yán yǐ bì zhī","abbr":"yyybz","explanation":"蔽：遮，引伸为概括。用一句话来概括。","source":{"text":"《诗》三百，一言以蔽之，曰：‘思无邪。’","book":"《论语·为政》"},"example":{"text":"老师讲的这些话，～，就是让我们端正学习态度，刻苦学习。"},"similar":["总而言之","一言蔽之","一言以蔽"],"usage":"作谓语、分句；指用一句话来概括","story":["我国最早的诗歌总集《诗经》共计305篇，成书于春秋时期，分为《风》《雅》《颂》三大类，一直受到很高评价。孔子曾经编撰《诗经》时评论说：“《诗经》三百多篇，用一句话来概括它，就是作者的思想是完全纯正的，没有邪恶的东西。”"]},{"id":1029,"word":"一言便定","pinyin":"yī yán biàn dìng","abbr":"yybd","explanation":"一句话说定了，不再更改。比喻说话算数，决不翻悔。","source":{"text":"与人交易，一言便定，岂可以利动心也。","book":"《魏书·赵柔传》"}},{"id":1030,"word":"一言偾事","pinyin":"yī yán fèn shì","abbr":"yyfs","explanation":"偾：跌倒，败坏。一句话说得不好，会把事情搞坏。","source":{"text":"一家仁，一国兴仁；一家让，一国兴让；一家贪戾，一国作乱。其机如此，此谓一言偾事，一人定国。","book":"《礼记·大学》"},"example":{"text":"家骧念典学方新，讲求上理，万一言利之臣随声附和，～，关系匪轻，乃力陈三弊阻止之。","book":"《清史稿·张家骧传》"}},{"id":1031,"word":"一言兴邦","pinyin":"yī yán xīng bāng","abbr":"yyxb","explanation":"指一句话可以兴国。","source":{"text":"古所谓一言兴邦者，信哉！","book":"《论语·子路》：“一言而可以兴邦，有诸？”唐·刘禹鍚《唐故相国李公集纪》"},"example":{"text":"元礼首议太真、国忠辈，近乎～，宜得此语。","book":"宋·许顗《许彦周诗话》"},"opposite":["一言丧邦"],"usage":"作宾语、定语；指关键人物的言语","story":["春秋时期，鲁定公问孔子：“一句话可使国家昌盛吗？”孔子说：“君主爱护臣子，关心他们，上下一心，国家可以兴旺。”鲁定公又问：“一句话可以使国家灭亡吗？”孔子说：“不全对，君主一句话下边不提反对意见，久而久之就会走向灭亡。”"]},{"id":1032,"word":"一言兴邦，一言丧邦","pinyin":"yī yán xīng bāng，yī yán sàng bāng","abbr":"yyxbyysb","explanation":"邦：国家。指关键时刻一句话可以关系到国家的兴或亡。","source":{"text":"一言而兴邦，有诸？……一言而丧邦，有诸？","book":"春秋·鲁·孔丘《论语·子路》"},"usage":"作宾语、定语、分句；指关键人物的言语","story":["春秋时期，鲁定公问孔子：“一句话可使国家昌盛吗？”孔子说：“君主爱护臣子，关心他们，上下一心，国家可以兴旺。”鲁定公又问：“一句话可以使国家灭亡吗？”孔子说：“不全对，君主一句话下边不提反对意见，久而久之就会走向灭亡。”"]},{"id":1033,"word":"一言出口，驷马难追","pinyin":"yī yán chū kǒu，sì mǎ nán zhuī","abbr":"yycksmnz","explanation":"一句话说出了口，就是套上四匹马拉的车也难追上。指话说出口，就不能再收回，一定要算数。","source":{"text":"一言而非，驷马不能追；一言而急，驷马不能及。","book":"《论语·颜渊》：“夫子之说君子也，驷不及舌。” 《邓析子·转辞》"},"example":{"text":"自古伴君如伴虎，何况是这样人心多疑的时候！须知～，那时后悔就迟了。","book":"姚雪垠《李自成》第五卷第十三章"},"similar":["一言既出，驷马难追","一言已出"],"usage":"作谓语、分句；指说话算数"},{"id":1034,"word":"一言千金","pinyin":"yī yán qiān jīn","abbr":"yyqj","explanation":"一句话价值千金。常用以形容所言之富有价值。","source":{"text":"故无往不复，何德不报，渔者一言千金归焉。","book":"汉·袁康《越绝书·外传纪策考》"},"example":{"text":"翁笑，促子离席，使拜媪曰：‘一言千金矣！’","book":"清·蒲松龄《聊斋志异·嫦娥》"},"similar":["一诺千金"],"usage":"作谓语、定语；用于处事等"},{"id":1035,"word":"一言半句","pinyin":"yī yán bàn jù","abbr":"yybj","explanation":"指很少的一两句话。同“一言半语”。","source":{"text":"近来学者有一种则舍去册子，却欲于一言半句上便要见道理。","book":"《朱子语类》卷十一"},"example":{"text":"清·韩邦庆《海上花列传》第53回：“独朱淑人一呆，朘巡近案，从侧里偷觑那封信，仅得～，已被其兄蔼人收藏。”"},"similar":["一言半辞","一言半语","一言半字"],"usage":"作主语、宾语、定语；指极少的语言"},{"id":1036,"word":"一言半字","pinyin":"yī yán bàn zì","abbr":"yybz","explanation":"指很少的一两句话。","source":{"text":"今吾且死而侯生曾无一言半辞送我。","book":"《史记·魏公子列传》"},"example":{"text":"张千、李万欲向众人分剖时，未说得～。","book":"明·冯梦龙《喻世明言》卷四十"},"similar":["一言半句","一言半辞","一言半语"],"usage":"作主语、宾语、定语；指极少的语言"},{"id":1037,"word":"一言半语","pinyin":"yī yán bàn yǔ","abbr":"yyby","explanation":"指很少的一两句话。","source":{"text":"今吾且死而侯生曾无一言半辞送我。","book":"《史记·魏公子列传》"},"example":{"text":"为～，受千辛万苦。","book":"元·尚仲贤《柳毅传书》第一折"},"similar":["只言片语","一言半辞"],"opposite":["千言万语"],"usage":"作主语、宾语、定语；指极少的语言"},{"id":1038,"word":"一言半辞","pinyin":"yī yán bàn cí","abbr":"yybc","explanation":"指很少的一两句话。同“一言半语”。","source":{"text":"吾所以待侯生者备矣，天下莫不闻。今吾且死而侯生曾无一言半辞送我，我岂有所失哉！","book":"《史记·魏公子列传》"},"similar":["一言半语","一言半句","一言半字"],"opposite":["千言万语","长篇大论"],"usage":"作主语、宾语、定语；指极少的语言"},{"id":1039,"word":"一言可分","pinyin":"yī yán kě fēn","abbr":"yykf","explanation":"一句话就可以辨别、区分。","source":{"text":"吐论冠时，舒华轶群；百氏之奥，一言可分。","book":"唐·橁宗元《为李京兆祭杨凝郎中文》"}},{"id":1040,"word":"一言可辟","pinyin":"yī yán kě bì","abbr":"yykp","explanation":"辟：征召。因一句话被赏识就可以得到征召而做官。","source":{"text":"太尉善其言，辟之为掾。世谓‘三语掾’。卫玠嘲之曰：‘一言可辟，何假于三！’","book":"南朝·宋·刘义庆《世说新语·文学》"}},{"id":1041,"word":"一言堂","pinyin":"yī yán táng","abbr":"yyt","explanation":"旧时商店表示不二价的匾。现比喻领导缺乏民主作风，独断专行，一个人说了算。","source":{"text":"党和国家的民主生活逐渐不正常，一言堂、个人决定重大问题、个人崇拜、个人凌驾于组织之上一类家长制现象，不断滋长。","book":"邓小平《党和国家领导制度的改革》"},"example":{"text":"要设法制止‘～’，‘个人说了算’的不民主现象。","book":"艾芜《漫谈科学和文学》"},"similar":["独断专行"],"opposite":["群言堂"],"usage":"作宾语、定语；指独断专行"},{"id":1042,"word":"一言定交","pinyin":"yī yán dìng jiāo","abbr":"yydj","explanation":"形容双方意气相投，刚一交谈，就成了至交。","source":{"text":"一言定交，死生以之，趋人之急，唯恐不及。","book":"唐·权德舆《唐丞相太保致仕岐国公社公墓志铭序》"},"similar":["一言订交"],"usage":"作谓语、定语；用于交往等"},{"id":1043,"word":"一言寿国","pinyin":"yī yán shòu guó","abbr":"yysg","explanation":"以极少的言语可使国家的寿命延长。","source":{"text":"夫一言而寿国，不听而亡国。若此者大圣之言也。","book":"《管子·霸言》"}},{"id":1044,"word":"一言已出，驷马难追","pinyin":"yī yán yǐ chū，sì mǎ nán zhuī","abbr":"yyycsmnz","explanation":"指话说出口，就不能再收回，一定要算数","source":{"text":"大丈夫做事，一言已出，驷马难追。","book":"明·冯梦龙《醒世恒言》第35卷"},"similar":["一言出口，驷马难追"],"usage":"作谓语、定语；指说话算数"},{"id":1045,"word":"一言已定","pinyin":"yī yán yǐ dìng","abbr":"yyyd","explanation":"一句话说定了，不再更改。比喻说话算数，决不翻悔。","source":{"text":"程婴，我一言已定，你再不必多疑了。","book":"元·纪君祥《赵氏孤儿》第二折"},"example":{"text":"多蒙相许，～。夜晚之间，不敢亲送，有烦店主嬷嬷伴送过去罢。","book":"明·凌濛初《二刻拍案惊奇》卷八"}},{"id":1046,"word":"一言抄百总","pinyin":"yī yán chāo bǎi zǒng","abbr":"yycbz","explanation":"一句话说出口，再也不改变。形容已拿定了主意。","source":{"text":"旁人只说是慢慢的劝着就劝转来了，那知他早打了个九牛拉不转的主意，一言抄百总，任是谁说，算是去定了。","book":"清·文康《儿女英雄传》第三回"},"usage":"作宾语、状语；用于书面语"},{"id":1047,"word":"一言既出，如白染皂","pinyin":"yī yán jì chū，rú bái rǎn zào","abbr":"yyjcrbrz","explanation":"皂：黑色。话一出口，如同白底染上黑色。比喻话一出口，就不能更改收回","source":{"text":"何出此言，大将军一言既出，如白染皂。","book":"明·吴承恩《西游记》第85回"},"example":{"text":"清·石玉昆《小五义》第119回：“咱们可是君子～。”"},"similar":["一言既出，驷马难追"],"usage":"作谓语、定语、分句；指说话算数"},{"id":1048,"word":"一言既出，金玉不移","pinyin":"yī yán jì chū，jīn yù bù yí","abbr":"yyjcjyby","explanation":"移：改变。话说出了口，就是用黄金白玉也不能更改。指话说出口，就不能再收回，一定要算数。","source":{"text":"我家小姐贞心定识不减古媛，今日一言既出，金玉不移。","book":"清·荑荻散人《玉娇梨》第十回"},"similar":["一言既出，驷马难追"],"usage":"作谓语、定语、分句；指说话算数"},{"id":1049,"word":"一言既出，驷马难追","pinyin":"yī yán jì chū，sì mǎ nán zhuī","abbr":"yyjcsmnz","explanation":"一句话说出了口，就是套上四匹马拉的车也难追上。指话说出口，就不能再收回，一定要算数。","source":{"text":"一言而非，驷马不能追；一言而急，驷马不能及。","book":"《论语·颜渊》：“夫子之说君子也，驷不及舌。” 《邓析子·转辞》"},"example":{"text":"大丈夫～，岂有翻悔之理！","book":"元·李寿卿《伍员吹箫》第三折"},"similar":["言而有信","一言既出，金玉不移"],"opposite":["言而无信"],"usage":"作谓语、分句；指说话算数"},{"id":1050,"word":"一言穷理","pinyin":"yī yán qióng lǐ","abbr":"yyql","explanation":"一言：一个字。用一个字就把事物的性状全表现出来。比喻以精炼的文字概括复杂的情状。也比喻论证精辟。","source":{"text":"皎日嘒星，一言穷理。","book":"南朝·梁·刘勰《文心雕龙·物色》"}},{"id":1051,"word":"一言立信","pinyin":"yī yán lì xìn","abbr":"yylx","explanation":"信：信誉。以一句话树立了信誉。","source":{"text":"庄王但为争强而发怒，公子以一言而立信。","book":"《后汉书·朱浮传》"}},{"id":1052,"word":"一言而喻","pinyin":"yī yán ér yù","abbr":"yyey","explanation":"喻：明白。一句话就使人了解或说明白。","source":{"text":"曰仁既明知行合一之说，此可一言而喻。","book":"宋·朱熹《朱子语类·语录》"},"example":{"text":"故教者，所以亲父子，正君臣，定名分，和上下，安富尊荣，定倾除乱，其效未可～也。","book":"明·朱之瑜《元旦贺源光国书八首》"}},{"id":1053,"word":"一言而定","pinyin":"yī yán ér dìng","abbr":"yyed","explanation":"一句话说定了，不再更改。比喻说话算数，决不翻悔。","source":{"text":"定人之谓礼，楚一言而定三国，我一言而亡之。我则无礼，何以战乎？","book":"《左传·僖公二十八年》"},"example":{"text":"从前，太宗爷主持朝政，有事就问范章京，听范章京～。","book":"姚雪垠《李自成》第四卷第四章"},"similar":["一言为定"],"usage":"作谓语、分句；指说话算数"},{"id":1054,"word":"一言蔽之","pinyin":"yī yán bì zhī","abbr":"yybz","explanation":"蔽：遮，引申为概括。用一句话来概括。","source":{"text":"《诗》三百，一言以蔽之，曰：‘思无邪。’","book":"《论语·为政》"},"example":{"text":"清·方苞《书淮阴列传后》：“其击楚破代，亦约举其成功，至定三秦则以～，而其事反散见于他传。”"},"similar":["一言以蔽之"],"usage":"作谓语、分句；指用一句话来概括"},{"id":1055,"word":"一言订交","pinyin":"yī yán dìng jiāo","abbr":"yydj","explanation":"形容双方意气相投，刚一交谈，就成了至交。","source":{"text":"一言定交，死生以之，趋人之急，唯恐不及。","book":"唐·权德舆《唐丞相太保致仕岐国公社公墓志铭序》"},"example":{"text":"不望天缘凑巧，倒在此地相会，又得彼此情同针芥，～，真是难得的一番奇遇！","book":"清·文康《儿女英雄传》第十五回"},"similar":["一言定交"],"usage":"作谓语、定语；用于交往等"},{"id":1056,"word":"一言陷人","pinyin":"yī yán xiàn rén","abbr":"yyxr","explanation":"陷：陷害。进谗言去陷害人。","source":{"text":"自古奸臣佞妾以一言陷人者众矣。","book":"北齐·颜之推《颜氏家训·后娶》"}},{"id":1057,"word":"一言难尽","pinyin":"yī yán nán jìn","abbr":"yynj","explanation":"形容事情曲折复杂，不是一句话能说清楚的（用在不好的事）。","source":{"text":"我一言难尽，来探望你这歹孩儿索是远路风尘。","book":"元·李直夫《虎头牌》第一折"},"example":{"text":"说起这件事，真是～，等有时间我们再详谈。"},"similar":["说来话长"],"opposite":["一言为定","一言九鼎","一言千金"],"usage":"作谓语、定语；用于不愉快的事"},{"id":1058,"word":"一言难磬","pinyin":"yī yán nán qìng","abbr":"yynq","explanation":"罄：用尽。形容事情曲折复杂，不是一句话能说清楚的。","source":{"text":"我一言难尽，来探望你这歹孩儿索是远路风尘。","book":"元·李直夫《虎头牌》第一折"},"example":{"text":"十年吃尽苦共辛，～。","book":"清·玩花主人《缀白裘·双官诰·荣归》"}},{"id":1059,"word":"一言难罄","pinyin":"yī yán nán qìng","abbr":"yynq","explanation":"罄：用尽。形容事情曲折复杂，不是一句话能说清楚的。","source":{"text":"我一言难尽，来探望你这歹孩儿索是远路风尘。","book":"元·李直夫《虎头牌》第一折"},"example":{"text":"十年吃尽苦共辛，～。（清·玩花主人《缀白裘·双官诰·荣归》）"},"similar":["一言难尽"],"usage":"作谓语、定语；多用于不愉快的事"},{"id":1060,"word":"一计不成，又生一计","pinyin":"yī jì bù chéng，yòu shēng yī jì","abbr":"yjbcysyj","explanation":"计：计谋，策略。指一个办法或策略失败后，又拿出另一个办法或策略。","example":{"text":"于是～，竟把随身携带的毒药冒充七宝灵丹，交给了婉儿。","book":"梁羽生《女帝奇英传》第三十一回"}},{"id":1061,"word":"一诎一信","pinyin":"yī qū yī shēn","abbr":"yqyx","explanation":"诎：通“屈”，弯曲；信：通“伸”，伸展。一屈一伸。","source":{"text":"用其升少阳，一诎一信，展羽云间。","book":"汉·韩婴《韩诗外传》卷九"}},{"id":1062,"word":"一语中人","pinyin":"yī yǔ zhōng rén","abbr":"yyzr","explanation":"中：中伤。以一句话中伤人。","source":{"text":"盖好谑人者，但知取快一时，不知一语中人，其酷甚于毒刃。","book":"宋·李昌令《乐善录·刘贡父》"},"usage":"作宾语、定语；用于处事"},{"id":1063,"word":"一语中的","pinyin":"yī yǔ zhōng dì","abbr":"yyzd","explanation":"一句话就说中要害。同“一语破的”。","source":{"text":"这是把虚心看做交友待客的根本态度，真可谓一语中的，抓住了要害。","book":"马南邨《燕山夜话·交友待客之道》"},"example":{"text":"王朔《你不是一个俗人》：“‘还得属冯先生，～。’丁小鲁笑问美萍：‘还走的动道么？’”"},"similar":["一语破的"],"usage":"作谓语、定语；指说话中肯"},{"id":1064,"word":"一语为重","pinyin":"yī yǔ wéi zhòng","abbr":"yywz","explanation":"表示言而有信，说到做到。","source":{"text":"自古驱民在信诚，一语为重百金轻。今人未可非商鞅，商鞅能令政必行。","book":"宋·王安石《商鞅》"}},{"id":1065,"word":"一语九鼎","pinyin":"yī yǔ jiǔ dǐng","abbr":"yyjd","explanation":"九鼎：古代国家的宝器，相传为夏禹所铸。一句话抵得上九鼎重。比喻说话力量大，能起很大作用。","source":{"text":"毛先生一至楚而使赵重于九鼎大吕。毛先生以三寸之舌，强于百万之师。胜不敢复相士。","book":"《史记·平原君列传》"}},{"id":1066,"word":"一语双关","pinyin":"yī yǔ shuāng guān","abbr":"yysg","explanation":"一句话包含两个意思。","source":{"text":"又转脸看看弯弯绕这伙子人，一语双关地说：‘我再宣布一声，谁想浑水摸鱼，挑拨是非，那是办不到。’","book":"浩然《艳阳天》第86章"},"example":{"text":"你体会到他～的用意。"},"similar":["一箭双雕","指桑骂槐","指鸡骂狗"],"opposite":["单刀直入","快人快语","心直口快"],"usage":"作谓语、定语、状语；指一句话包含两个意思"},{"id":1067,"word":"一语撞倒墙","pinyin":"yī yǔ zhuàng dǎo qiáng","abbr":"yyzdq","explanation":"一句话可以把墙壁撞倒。比喻言语生硬、莽撞。","source":{"text":"一句话可以把墙壁撞倒。比喻言语生硬、莽撞。"},"example":{"text":"立朝纲劲，须推老兄；然～，亦是老兄。","book":"清·赵翼《陔余丛考·成语》"}},{"id":1068,"word":"一语破的","pinyin":"yī yǔ pò dì","abbr":"yypd","explanation":"的：箭靶的中心。一句话就说中要害。","source":{"text":"此跋论东坡，语语破的。","book":"清·王士禛《带经堂诗话·品藻类》"},"example":{"text":"倒是“忠孝不能两全”真正～了。","book":"闻一多《家庭主义与民族主义》"},"similar":["一语道破","一针见血","正中要害"],"opposite":["言不及义","言之无物","轻描淡写"],"usage":"作谓语、定语；指说话中肯"},{"id":1069,"word":"一语道破","pinyin":"yī yǔ dào pò","abbr":"yydp","explanation":"道：说；破：揭穿。一句话就说穿了。","source":{"text":"自唐虞至战国二千余年，圣人相传心法，一语道破。","book":"清·戏确《与张考夫书》"},"example":{"text":"而发之又必若隐若见，欲露不露，反复缠绵，终不许～。（清·陈廷棹《白寸斋词话》卷一）"},"similar":["一针见血","入木三分","切中要害"],"opposite":["言不及义","轻描淡写","言之无物"],"usage":"作谓语、宾语；指一句话说穿"},{"id":1070,"word":"一误再误","pinyin":"yī wù zài wù","abbr":"ywzw","explanation":"一次又一次的失误。形容屡被耽误或屡犯错误。","source":{"text":"太宗尝以传国之意访之赵普。普曰：‘太祖已误，陛下岂容再误邪？’","book":"《宋史·魏王廷美传》"},"example":{"text":"徒以误解民治真精神，且过恃自己之武力，～，而卒自陷于穷途。","book":"蔡东藩、许廑父《民国通俗演义》第一二五回"},"similar":["知错不改"],"opposite":["知错改错"],"usage":"作谓语、定语；用于劝诫人","story":["北宋时期，宋太祖赵匡胤遵守母命传位给三弟赵光义，即宋太宗。魏王赵廷美则是下一个接位的人选。他显得有些急不可待，宋太宗问宰相赵普如何处理。赵普说如果传位不传子而传弟就是一误再误了。宋太宗接机把赵廷美流放"]},{"id":1071,"word":"一诺千金","pinyin":"yī nuò qiān jīn","abbr":"ynqj","explanation":"诺：许诺。许下的一个诺言有千金的价值。比喻说话算数，极有信用。","source":{"text":"得黄金百斤，不如得季布一诺。","book":"《史记·季布栾布列传》"},"example":{"text":"夫人而诚～，更无食言也者。","book":"元·王实甫《西厢记》第二本第二折金圣叹批"},"similar":["言而有信"],"opposite":["言而无信"],"usage":"作谓语；常与“出言不苟”连用","story":["楚汉相争时期，项羽手下的季布十分仗义，凡答应的事情一定办到。西汉建立后，刘邦对季布十分痛恨，下令捉拿未成功，经汝阴侯夏侯婴劝解，刘邦启用季布为官。势力小人曹邱生恭维季布说：“得黄金百，不如得季布一诺。”"]},{"id":1072,"word":"一诺无辞","pinyin":"yī nuò wú cí","abbr":"ynwc","explanation":"一口答应，没有二话。","source":{"text":"再没有再荐便宜的了，如何不肯？一诺无辞，就同六事鬼去拣了一个黄道好日。","book":"清·张南庄《何典》第四回"},"example":{"text":"‘我想女人的心肠软，请孙小姐去走一躺，也许有点门路，这当然是不得已的下策。’孙小姐～道：‘我这时候就去。’","book":"钱仲书《围城》五"},"usage":"作谓语、定语、状语；用于处事"},{"id":1073,"word":"一谦四益","pinyin":"yī qiān sì yì","abbr":"yqsy","explanation":"谦虚能使人得到好些益处。","source":{"text":"一谦而四益，此其所长也。","book":"《周易·谦》：“天道亏盈而益谦，地道变盈而流谦，鬼神害盈而福谦，人道恶盈而好谦。”《汉书·艺文志》"},"example":{"text":"卿深惧盈满，过形抑畏，～，当克永年。","book":"宋·苏轼《赐皇叔改封徐王颢上表辞免册礼许诏》"},"usage":"作宾语、定语；指谦虚能使人得到很多"},{"id":1074,"word":"一谷不升","pinyin":"yī gǔ bù shēng","abbr":"ygbs","explanation":"指歉收。","source":{"text":"一谷不升谓之嗛，二谷不升谓之饥，三谷不升谓之馑，四谷不升谓之康，五谷不升谓之大侵。","book":"《榖梁传·襄公二十四年》"},"similar":["一谷不登"],"usage":"作谓语、定语；用于书面语"},{"id":1075,"word":"一谷不登","pinyin":"yī gǔ bù dēng","abbr":"ygbd","explanation":"指歉收。同“一谷不升”。","source":{"text":"一谷不登，减一谷，谷之法什倍。","book":"《管子·揆度》"},"example":{"text":"［伏湛］谓妻子曰：“夫～，国君彻膳，今民皆饥，奈何独饱？”","book":"《后汉书·伏湛传》"},"similar":["一谷不升"],"usage":"作谓语、定语；用于书面语"},{"id":1076,"word":"一豫一游","pinyin":"yī yù yī yóu","abbr":"yyyy","explanation":"豫：游乐。常指帝王的游乐生活。","source":{"text":"由是声教所暨，罔间朔南；存神穆清，与道同体。虽～，亦思为天下后世法。 ★明·宋濂《阅江楼记》"},"similar":["一游一豫"],"usage":"作谓语、定语；用于书面语"},{"id":1077,"word":"一貌倾城","pinyin":"yī mào qīng chéng","abbr":"ymqc","explanation":"全城的人都为她的美貌所倾倒。形容女子容貌艳丽。","source":{"text":"北方有佳人，绝世而独立，一顾倾人城，再顾倾人国。","book":"《汉书·外戚传》"},"example":{"text":"此邻人徐氏之女丹桂小娘子。果然生得～，目中罕见。","book":"明·凌濛初《二刻拍案惊奇》卷三"},"similar":["一顾倾城","一顾倾人"],"usage":"作定语、状语；用于女性"},{"id":1078,"word":"一貌堂堂","pinyin":"yī mào táng táng","abbr":"ymtt","explanation":"堂堂：庄重大方。指一表人才。","source":{"text":"我见他一貌堂堂，必然高贵。","book":"明·王世贞《鸣凤记·陆姑救易》"},"example":{"text":"清·褚人获《隋唐演义》第13回：“当下李白见他～，便勒住马问是何人。”"},"similar":["相貌堂堂"],"usage":"作谓语、定语、状语；用于书面语"},{"id":1079,"word":"一败如水","pinyin":"yī bài rú shuǐ","abbr":"ybrs","explanation":"形容军队打了大败仗，像水泼到地上那样不可收拾。","source":{"text":"当第一时期，富农耳里听得的是所谓江西一败如水，蒋介石打伤了脚，坐飞机回广东去了。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["一败涂地","丢盔弃甲","溃不成军"],"opposite":["出奇制胜","旗开得胜","捷报频传"],"usage":"作谓语、定语、宾语；指一败涂地"},{"id":1080,"word":"一败涂地","pinyin":"yī bài tú dì","abbr":"ybtd","explanation":"一旦失败就肝脑涂地。形容失败到了不可收拾的地步。","source":{"text":"天下方扰，诸侯并起，今置将不善，壹败涂地。吾非敢自爱，恐能薄，不能完父兄子弟，此大事，愿更相推择可者。","book":"《史记·高祖本纪》"},"example":{"text":"不料我们～如此。","book":"清·曹雪芹《红楼梦》第一○五回"},"similar":["一蹶不振","望风披靡","落花流水"],"opposite":["旗开得胜","不败之地","东山再起"],"usage":"作谓语、定语、状语；指彻底失败","story":["秦朝末年，各地纷纷爆发反秦起义，当时沛县县令请刘邦来商议对策，见刘邦带来100多人就关闭城门不让进。刘邦用箭将告百姓书射入城中策反，城里人杀了县令来请刘邦做沛县县令，刘邦推辞说：“今置将不善，则一败涂地。”"]},{"id":1081,"word":"一贫一富，乃见交态","pinyin":"yī pín yī fù，nǎi jiàn jiāo tài","abbr":"ypyfnjjt","explanation":"交态：人情世态。人经历过贫穷和高中两种地位，才能认清人情世态。","source":{"text":"一死一生，乃知交情；一贫一富，乃见交态；一贵一贱，交情乃见。","book":"《汉书·郑当时传》"}},{"id":1082,"word":"一贫似水","pinyin":"yī pín sì shuǐ","abbr":"ypss","explanation":"穷得象用水洗过似的，什么都没有。形容十分贫穷。","source":{"text":"小生一贫如洗，流落在这楚州居住。","book":"元·关汉卿《窦娥冤》楔子"}},{"id":1083,"word":"一贫如洗","pinyin":"yī pín rú xǐ","abbr":"yprx","explanation":"穷得象用水洗过似的，什么都没有。形容十分贫穷。","source":{"text":"小生一贫如洗，流落在这楚州居住。","book":"元·关汉卿《窦娥冤》楔子"},"example":{"text":"当时父亲赤手空拳出来做官，家里～。","book":"邹韬奋《我的母亲》"},"similar":["一无所有","一寒如此","家徒四壁"],"opposite":["荣华富贵","丰衣足食","腰缠万贯"],"usage":"作谓语、定语、状语；形容极其贫穷"},{"id":1084,"word":"一贯万机","pinyin":"yī guàn wàn jī","abbr":"ygwj","explanation":"贯：贯穿。把一种道理贯穿于万事万物之中。","source":{"text":"亲履艰难者知下情，备惊险易者达物伪，故能一贯万机，靡所疑惑，百揆允当，庶绩咸熙。","book":"《后汉书·张衡传》"}},{"id":1085,"word":"一资半级","pinyin":"yī zī bàn jí","abbr":"yzbj","explanation":"犹一官半职。泛指官职。","source":{"text":"裴晋公度为门下侍郎，过吏部选人官，谓同过给事中曰：‘吾徒侥幸，至于此辈，优与一资半级，何足问也？’","book":"唐·无名氏《玉泉子·裴晋公度》"},"similar":["一官半职"],"usage":"作宾语、定语；用于书面语"},{"id":1086,"word":"一资半职","pinyin":"yī zī bàn zhí","abbr":"yzbz","explanation":"指非常低微的官职。","source":{"text":"或因家世余绪，得一阶半级，便自为足，全忘修学。","book":"北齐·颜之推《颜氏家训·勉学》"}},{"id":1087,"word":"一走了之","pinyin":"yī zǒu liǎo zhī","abbr":"yzlz","explanation":"指不顾而去。","source":{"text":"我亦尚在看看人间世，不过总有一天，是终于要‘一走了之’的，现在是这样的世界。","book":"鲁迅《书信集·致郑振铎》"},"example":{"text":"你不能～，留下这个烂摊子给别人来收拾。"},"similar":["绝尘而去","溜之大吉"],"usage":"作谓语、宾语；指不负责任"},{"id":1088,"word":"一趋一步","pinyin":"yī qū yī bù","abbr":"yqyb","explanation":"趋：快走；步：慢走。形容紧跟着人家走。也比喻模仿或追随别人。","source":{"text":"舍亲易瑞之一趋一步，自是孔门卓尔。","book":"明·汤显祖《复俞淳初侍御书》"},"example":{"text":"随伴舞蹈群傀儡，～真奇特。","book":"陈毅《崖县看京剧，有小丑表演绝佳》"}},{"id":1089,"word":"一跌不振","pinyin":"yī diē bù zhèn","abbr":"ydbz","explanation":"比喻遭受一次挫折以后就再也振作不起来。同“一蹶不振”。","source":{"text":"房次律为宰相，当中原始乱时，虽无大功，亦无甚显过，罢黜盖非其罪。一跌不振，遂至于死。","book":"宋·叶梦得《避暑录话》卷下"},"example":{"text":"明·宋征璧《皇明经世文·凡例》：“士人遇合，或富贵自有，才位相符；又或偾辕负乘，～。”"},"similar":["一蹶不振"],"usage":"作谓语、定语、状语；指遭遇失败"},{"id":1090,"word":"一路之哭","pinyin":"yī lù zhī kū","abbr":"ylzk","explanation":"路：宋代的行政区域名。在一个地区内，到处是老百姓的哭声。比喻一个地区的百姓因遭受灾难而痛苦。","source":{"text":"富弼曰：‘十二丈则是一笔，焉知一家哭耶！’仲淹曰：‘一家哭，何如一路哭耶！’","book":"宋·朱熹《五朝名臣言行录·参政范文正公》"},"example":{"text":"今之当道曾不念此，其人进士也，则容养不问，使肆于民上，不惜一路之哭而惜～。","book":"明·陆粲《去积弊以振作人材疏》"}},{"id":1091,"word":"一路哭","pinyin":"yī lù kū","abbr":"ylk","explanation":"路：宋代的行政区域名。在一个地区内，到处是老百姓的哭声。比喻一个地区的百姓因遭受灾难而痛苦。","source":{"text":"富弼曰：‘十二丈则是一笔，焉知一家哭耶！’仲淹曰：‘一家哭，何如一路哭耶！’","book":"宋·朱熹《五朝名臣言行录·参政范文正公》"},"example":{"text":"轻风罕见，直挺挺不动五方旗；点雨无征，苦哀哀只闻～。","book":"明·凌濛初《初刻拍案惊奇》卷三十九"}},{"id":1092,"word":"一路哭声","pinyin":"yī lù kū shēng","abbr":"ylks","explanation":"路：宋代的行政区域名。在一个地区内，到处是老百姓的哭声。比喻一个地区的百姓因遭受灾难而痛苦。","source":{"text":"富弼曰：‘十二丈则是一笔，焉知一家哭耶！’仲淹曰：‘一家哭，何如一路哭耶！’","book":"宋·朱熹《五朝名臣言行录·参政范文正公》"},"example":{"text":"戎马掀天动地来，荆襄～哀。","book":"明·冯梦龙《喻世明言》卷二十二"}},{"id":1093,"word":"一路平安","pinyin":"yī lù píng ān","abbr":"ylpa","explanation":"指旅途中没出任何事故。也用作对出门人的祝福语。","source":{"text":"一路平安，行了一月有余，来到旧日泊船之处。","book":"明·冯梦龙《古今小说》卷十九"},"example":{"text":"办的好！好！姑娘，～！（老舍《老张的哲学》四十四）"},"similar":["一路顺风","安然无恙","安如泰山"],"opposite":["艰难险阻","风尘仆仆","饱经风霜"],"usage":"作谓语、宾语；用于祝颂"},{"id":1094,"word":"一路神祇","pinyin":"yī lù shén qí","abbr":"ylsq","explanation":"指同伙的人。意含讥讽。","source":{"text":"［祝日念］因指着应伯爵、谢希大说道：‘这两个天杀的，和他都是一路神祇。’","book":"明·兰陵笑笑生《金瓶梅词话》第十五回"},"usage":"作宾语；用于书面语"},{"id":1095,"word":"一路福星","pinyin":"yī lù fú xīng","abbr":"ylfx","explanation":"路：本为宋代的行政区域名，后指道路；福星：岁星。原指一个行政区域为民谋福的好长官。后用作祝人旅途平安的客套话。","source":{"text":"福星一路之歌谣，生佛万家之灯火。","book":"宋·秦观《鲜于子骏行状》：“福星往矣，安得百子骏布在天下乎！”宋·戴翼《贺陈待制启》"},"example":{"text":"《四友斋从说》：“宋鲜于侁，人谓之～。”","book":"清·翟灏《通俗编·祝诵一路福星》"},"similar":["一路顺风","福星高照"],"usage":"作谓语；用于祝颂","story":["宋朝时期，宋鲜于子骏被任命为京东路转运使，临行前，司马光说：“福星去了，如能有一百个子骏在各地就好了。”于是人们就说他是“一路福星”，称赞他的诗句有：“福星一路之歌谣，生佛万家之香火。”"]},{"id":1096,"word":"一路货色","pinyin":"yī lù huò sè","abbr":"ylhs","explanation":"一路：同一类；货色：货物。比喻同一类丑货。","source":{"text":"叫我看，一进了他们这个大染缸，就全变成一路货色了。","book":"郭澄清《大刀记》第七章"},"example":{"text":"他们两人是～。"},"similar":["物以类聚","一丘之貉"],"opposite":["截然不同"],"usage":"作谓语、宾语、定语；指同一类东西"},{"id":1097,"word":"一路顺风","pinyin":"yī lù shùn fēng","abbr":"ylsf","explanation":"旅途平安（多用于祝人）。","source":{"text":"且喜连冬过春，徐槐一边久无消息，更喜云陈两处亦无动静，一路顺风无些毫打叉之事，以是吴用渐渐向愈。","book":"清·文康《儿女英雄传》第十九回：“忽然，一路顺风里说到想要告休归里。”清·俞万春《荡寇志》第一二二回"},"example":{"text":"我们这次出门旅行真是～，沿途一点儿也没有耽误。"},"similar":["一路平安","一帆风顺"],"usage":"作谓语、宾语；用于祝颂"},{"id":1098,"word":"一路风尘","pinyin":"yī lù fēng chén","abbr":"ylfc","explanation":"形容旅途辛苦。","source":{"text":"国舅老爷大喜！国舅老爷一路风尘辛苦。小的听见昨日的头起报马来报，说今日大驾归府，略预备了一杯水酒掸尘，不知赐光谬领否？","book":"清·曹雪芹《红楼梦》第十六回"},"example":{"text":"［安老爷］见舅太太在廊下候着，便忙着上前彼此问过好，谈了两句～的话。","book":"清·文康《儿女英雄传》第四十回"},"usage":"作宾语、定语；用于旅途"},{"id":1099,"word":"一路风清","pinyin":"yī lù fēng qīng","abbr":"ylfq","explanation":"形容安定升平的景象。","source":{"text":"沈里孝清直名臣，使其建牙内地，将见一路风清，乃使作陕西巡抚，助讨宁夏。","book":"明·沈德符《野获编·吏部·用违其才》"},"usage":"作宾语、定语；用于书面语"},{"id":1100,"word":"一蹴即至","pinyin":"yī cù jí zhì","abbr":"ycjz","explanation":"蹴：踏；至：达到。踏一步就成功。比喻事情轻而易举，一下子就成功。","source":{"text":"因文山而获见倭艮峰先生，得读所著为学大旨，始知圣人之道如日用饮食之不可一日或离，而从事之久，则趣益深，理益明，又不容以一蹴而至也。","book":"宋·张载《李慎同治九年本张子全书序》"},"example":{"text":"除非插翼能飞，否则即使绝世轻功，也绝不能～。","book":"梁羽生《狂侠天娇魔女》第四十三回"}},{"id":1101,"word":"一蹴可几","pinyin":"yī cù kě jǐ","abbr":"yckj","explanation":"比喻事情轻而易举，一下子就成功。几，近，及。同“一蹴而就”。","source":{"text":"天下事非一蹴可几者。","book":"梁启超《中国学术思想变迁之大势》第四章第二节"},"example":{"text":"我们必须向着改善现实的动向努力，但是我们同时也须明了这并不是～。","book":"邹韬奋《对人对境和对己的态度》"},"similar":["一蹴而成","一蹴而就","一蹴而得"],"usage":"作谓语、宾语、定语；指一下子就成功"},{"id":1102,"word":"一蹴可就","pinyin":"yī cù kě jiù","abbr":"yckj","explanation":"蹴：踏；就：成功。踏一步就可以成功。比喻事情轻而易举，一下子就成功。","source":{"text":"天下之学者，孰不欲一蹴而造圣人之域。","book":"宋·苏洵《上田枢密书》"},"similar":["一蹴而就","一蹴而成","一蹴而得"],"usage":"作谓语、宾语、定语；指一下子就成功"},{"id":1103,"word":"一蹴而几","pinyin":"yī cù ér jī","abbr":"ycej","explanation":"蹴：踏。踏一步就成功。比喻事情轻而易举，一下子就成功。","source":{"text":"天下之学者，孰不欲一蹴而造圣人之域。","book":"宋·苏洵《上田枢密书》"}},{"id":1104,"word":"一蹴而就","pinyin":"yī cù ér jiù","abbr":"ycej","explanation":"蹴：踏；就：成功。踏一步就成功。比喻事情轻而易举，一下子就成功。","source":{"text":"天下之学者，孰不欲一蹴而造圣人之域。","book":"宋·苏洵《上田枢密书》"},"example":{"text":"从前所受，皆为大略，～于繁赜，毋乃不可！","book":"清·吴趼人《痛史·原叙》"},"similar":["一蹴即至","一举成功","迎刃而解"],"opposite":["一事无成","一蹶不振","欲速不达"],"usage":"作谓语、宾语、定语；指一下子就成功"},{"id":1105,"word":"一蹴而得","pinyin":"yī cù ér dé","abbr":"yced","explanation":"比喻事情轻而易举，一下子就成功。同“一蹴而就”。","source":{"text":"现在，他们认为胜利不能一蹴而得，必须用持久战。","book":"茅盾《路》十二"},"example":{"text":"做事情不可能都是～的"},"similar":["一蹴而就","一蹴可就","一蹴而成"],"usage":"作谓语、宾语、定语；指一下子就成功"},{"id":1106,"word":"一蹴而成","pinyin":"yī cù ér chéng","abbr":"ycec","explanation":"比喻事情轻而易举，一下子就成功。同“一蹴而就”。","source":{"text":"赖奥维一九○三年的飞机也还不是一蹴而成的。","book":"邹韬奋《什么事不可能》"},"similar":["一蹴而就","一蹴而得","一蹴可就"],"usage":"作谓语、宾语、定语；指一下子就成功"},{"id":1107,"word":"一蹴而至","pinyin":"yī cù ér zhì","abbr":"ycez","explanation":"蹴：踏；至：达到。踏一步就成功。比喻事情轻而易举，一下子就成功。","source":{"text":"因文山而获见倭艮峰先生，得读所著为学大旨，始知圣人之道如日用饮食之不可一日或离，而从事之久，则趣益深，理益明，又不容以一蹴而至也。","book":"宋·张载《李慎同治九年本张子全书序》"},"example":{"text":"少林派累积千年，方得达成这等绝技，决非～，就算是绝顶聪明之人，也无法自创。","book":"金庸《倚天屠龙记》第三回"}},{"id":1108,"word":"一蹶不兴","pinyin":"yī juě bù xīng","abbr":"yjbx","explanation":"比喻遭受一次挫折以后就再也振作不起来。同“一蹶不振”。","source":{"text":"乃以庸奴误国，涂毒苍生，一蹶不兴，如斯之极。","book":"孙中山《兴中会章程》"},"similar":["一蹶不振"],"usage":"作谓语、定语、状语；指遭遇失败"},{"id":1109,"word":"一蹶不振","pinyin":"yī jué bù zhèn","abbr":"yjbz","explanation":"蹶：栽跟头；振：振作。一跌倒就再也爬不起来。比喻遭受一次挫折以后就再也振作不起来。","source":{"text":"一噎之故，绝谷不食，一蹶之故，却足不行。","book":"汉·刘向《说苑·说丛》"},"example":{"text":"可惜，到了这二十世纪的中叶，说什么也～了。","book":"梁斌《红旗谱》四十二"},"similar":["一败涂地","一败如水","萎靡不振"],"opposite":["东山再起","死灰复燃","方兴未艾"],"usage":"作谓语、定语、状语；指遭遇失败"},{"id":1110,"word":"一身三手","pinyin":"yī shēn sān shǒu","abbr":"ysss","explanation":"一个人身上长三只手。比喻虽多无用。","source":{"text":"一身三手，无益于辅。两足共节，不能克敏。","book":"汉·焦延寿《易林·睽之节》"}},{"id":1111,"word":"一身两任","pinyin":"yī shēn liǎng rèn","abbr":"yslr","explanation":"指一个人担任两个职务。","source":{"text":"一身而二任焉，虽圣者不可为也。","book":"唐·韩愈《圬者王承福传》"},"similar":["一身而二任"],"usage":"作谓语、定语；指身兼两职","story":["唐朝时期，官宦子弟王承福随军效力，立下不小的军功，受到唐玄宗的接见。唐玄宗要给他封官，他坚决不受，回到家乡干起泥瓦匠的工作，别人不理解，他解释道各种都要人去干，如果去当官，还要娶妻生子，一身两任，即使是圣人也都难以胜任"]},{"id":1112,"word":"一身两头","pinyin":"yī shēn liǎng tóu","abbr":"yslt","explanation":"一个人同时有两个主张。比喻无所适从。","source":{"text":"一身两头，近适二家，乱不可治。","book":"汉·焦延寿《易林》卷八"},"usage":"作谓语、定语；指人犹豫不决"},{"id":1113,"word":"一身两役","pinyin":"yī shēn liǎng yì","abbr":"ysly","explanation":"一个人做两件事。","source":{"text":"一身两役，无乃劳乎？","book":"《梁书·张充传》"},"example":{"text":"他～，整天忙得不亦乐乎。"},"similar":["一身而二任"],"usage":"作谓语、定语；指一个人兼做两件事","story":["南朝梁代大臣张绪看到儿子张充整天与纨绔子弟混在一起，张充左手托鹰右手牵狗，就教训儿子“一身两役，无乃劳乎？”经过这次教训后，张充居然认真读书，学问大增，就去考取功名。后来官至散骑常侍、国子监祭酒，也算是一身两役大有出息了"]},{"id":1114,"word":"一身二任","pinyin":"yī shēn èr rèn","abbr":"yser","explanation":"任：职务，责任。一个人承担两种职务。","source":{"text":"诸侯骨肉莫亲大王，大王于属则子也，于位则臣也，一身而二任之责加焉。","book":"《汉书·王吉传》"},"example":{"text":"况于微臣愚陋无比，～，力所不堪。","book":"宋·司马光《辞知制诰第一状》"}},{"id":1115,"word":"一身五世","pinyin":"yī shēn wǔ shì","abbr":"ysws","explanation":"一人亲身经历了五个朝代。比喻人寿命长。","source":{"text":"劳生九十漫随缘，老病支离幸自全。百岁几人登耄耄，一身五世见曾玄。只将去日占来日，谁谓增年是减年？次第梅花春满目，可容愁到酒樽前。","book":"明·文征明《己未元旦》"}},{"id":1116,"word":"一身五心","pinyin":"yī shēn wǔ xīn","abbr":"yswx","explanation":"比喻杂念很多。","source":{"text":"三人异趋，反复迷惑。一身五心，乱无所得。","book":"汉·焦延寿《易林》卷一"},"usage":"作谓语、定语；用于比喻句"},{"id":1117,"word":"一身作事一身当","pinyin":"yī shēn zuò shì yī shēn dāng","abbr":"yszsysd","explanation":"一个人自己做的事情自己要敢于承担责任。","source":{"text":"我恨他为什么这样胆小，一身作事一身当，为什么要逃。就是他一辈子不来了，我也一辈子不嫁人的。","book":"清·曹雪芹《红楼梦》第92回"},"similar":["敢作敢为","一人做事一人当"],"usage":"作谓语、宾语、分句；用于口语"},{"id":1118,"word":"一身做事一身当","pinyin":"yī shēn zuò shì yī shēn dāng","abbr":"yszsysd","explanation":"当：承担。自己干的事情由自己一个人承担。","source":{"text":"列位不必埋怨，体要吃惊。我一身做事一身当，既有本事打了这强徒，那里等得他去调兵？","book":"清·吴璿《飞龙全传》第二十四回"},"example":{"text":"～，怎么代得？但你今已到了阴司，怎能再回阳世？","book":"清·钱彩《说岳全传》第七十一回"},"similar":["一身作事一身当"],"usage":"作谓语、宾语、分句；用于口语"},{"id":1119,"word":"一身无累","pinyin":"yī shēn wú lěi","abbr":"yswl","explanation":"累：累赘，牵扯。孑然一身，全无牵挂。形容无事一身轻。","source":{"text":"三谏不从为逐客，一身无累似虚舟。","book":"唐·徐铉《贬官泰州出城作》"}},{"id":1120,"word":"一身是胆","pinyin":"yī shēn shì dǎn","abbr":"yssd","explanation":"形容胆量大，无所畏惧。","source":{"text":"先主明旦自来，至云营围视昨战处，曰：‘子龙一身都是胆也！’","book":"晋·陈寿《三国志·蜀志·赵云传》：“以云为翊军将军”裴松之注引《赵云别传》"},"example":{"text":"他作战勇敢，～，是一员难得的虎将。","book":"姚雪垠《李自成》第二卷第50章"},"similar":["浑身是胆"],"opposite":["胆小如鼠"],"usage":"作谓语、定语；用于英雄","story":["三国时期，魏国与蜀国为争夺汉中而发生激战。刘备与诸葛亮派老将黄忠去迎战曹兵被打败，赵云率军援救。曹操亲率大军追赶。赵云命士兵打开城门，偃旗息鼓，独自立在营前，曹操败退，刘备封赵云为一身是胆的虎威将军"]},{"id":1121,"word":"一身百为","pinyin":"yī shēn bǎi wéi","abbr":"ysbw","explanation":"为：作为。一个人能干百样事。形容人有能力，能做各种事情。","source":{"text":"凡生理尽夜寒暑所须者，一身百为，不知其难。","book":"《宋史·苏过传》"}},{"id":1122,"word":"一身而二任","pinyin":"yī shēn ér èr rèn","abbr":"yseer","explanation":"一个人承担两种任务。","source":{"text":"诸侯骨肉莫亲大王，大王于属则子也，于位则臣也，一身而二任之责加焉。","book":"《汉书·王吉传》"},"example":{"text":"～焉，虽圣者不可得也。","book":"唐·韩愈《圬者王承福传》"},"similar":["身兼数职"],"usage":"作谓语、定语；指一个人承担两种任务"},{"id":1123,"word":"一身都是胆","pinyin":"yī shēn dōu shì dǎn","abbr":"ysdsd","explanation":"极言胆大勇敢。","source":{"text":"子龙一身都是胆也。","book":"《三国志·蜀志·赵云传》裴松之注引《云别传》"},"example":{"text":"曾在当阳长坂，与曹操大战三日三夜，百万军中抱得后主回还。曹操称我子龙～，信不虚也。","book":"元·无名氏《隔江斗智》第二折"},"similar":["一身是胆"],"usage":"作谓语、定语；用于处事"},{"id":1124,"word":"一轨同风","pinyin":"yī guǐ tóng fēng","abbr":"ygtf","explanation":"车轨相同，风俗一致。比喻国家统一。","source":{"text":"一轨九州，同风天下。","book":"《晋书·苻坚载记上》"},"similar":["车同轨，书同文"],"usage":"作定语、宾语；比喻国家统一"},{"id":1125,"word":"一轰而散","pinyin":"yī hōng ér sàn","abbr":"yhes","explanation":"形容聚在一起的人一下子吵吵嚷嚷地走散了。","source":{"text":"御笔硃书四大字，曰：‘今年且罢。’于是一哄而散。","book":"明·沈德符《万历野获编·壬戌科罢选吉士》第十卷"},"example":{"text":"众人一听，说：“那可来不得！”大家才嘻嘻哈哈～，跑出去了。","book":"清·文康《儿女英雄传》第二十八回"},"similar":["一哄而散"],"usage":"作谓语、定语；指吵吵嚷嚷地走散了"},{"id":1126,"word":"一轰而起","pinyin":"yī hōng ér qǐ","abbr":"yheq","explanation":"没有经过认真准备和严密组织，一下子行动起来","source":{"text":"一轰而起，一轰而散，他逮不住领头人儿，看他有什么法子？","book":"梁斌《红旗谱》第二卷"},"similar":["一哄而起"],"usage":"作谓语、宾语、定语；用于人或事物等"},{"id":1127,"word":"一辞同轨","pinyin":"yī cí tóng guǐ","abbr":"yctg","explanation":"犹众口一词。所有的人都说同样的话。","source":{"text":"今群臣无不一辞同轨乎季孙者，举鲁国尽化为一，君虽问境内之人，犹不免于乱也。","book":"《韩非子·八奸》：“此皆俱进俱退，皆应皆对，一辞同轨以移主心者也。”又《内储说上》"},"similar":["众口一词"],"usage":"作谓语、定语；用于书面语"},{"id":1128,"word":"一辞莫赞","pinyin":"yī cí mò zàn","abbr":"ycmz","explanation":"赞：赞美。没有一句妥贴的赞美话能表达。形容诗文写得极好。","source":{"text":"至于为《春秋》，笔则笔，削则削，子夏之徒不能赞一辞。","book":"《史记·孔子世家》"}},{"id":1129,"word":"一迎一合","pinyin":"yī yíng yī hé","abbr":"yyyh","explanation":"迎：逢迎。迎合他人","source":{"text":"也是你不合去杀人处，一迎一合。","book":"元·无名氏《盆儿鬼》第二折"},"similar":["一迎一和"],"usage":"作谓语、宾语；用于书面语"},{"id":1130,"word":"一迎一和","pinyin":"yī yíng yī hé","abbr":"yyyh","explanation":"指一味迎合。","source":{"text":"也是你不合去杀人处，一迎一合。","book":"元·无名氏《盆儿鬼》第二折"}},{"id":1131,"word":"一还一报","pinyin":"yī huán yī bào","abbr":"yhyb","explanation":"指做一件坏事后必受一次报复。","source":{"text":"不是我千错万错，大刚来一还一报。","book":"元·岳伯川《铁拐李》第一折"},"example":{"text":"黛玉听了笑道：“阿弥陀佛。到底是我的好姐姐。你一般也遇见对子了。可知～，不爽不错的。","book":"清·曹雪芹《红楼梦》第十九回"},"similar":["一报还一报"],"usage":"作宾语、定语；用于劝诫人"},{"id":1132,"word":"一迭连声","pinyin":"yī dié lián shēng","abbr":"ydls","explanation":"一声紧接着一声。","source":{"text":"左右一迭连声道：‘带妇人，带妇人！’那妇人却动也不动。","book":"清·石玉昆《三侠五义》第二十六回"},"example":{"text":"难道我做了几天的梦吗？茶馆、仙闼、锦被、美人，都是梦吗？急得～喊人来。","book":"清·曾朴《孽海花》第四回"},"usage":"作定语、状语；用于说话"},{"id":1133,"word":"一退六二五","pinyin":"yī tuī liù èr wǔ","abbr":"ytlew","explanation":"原是珠算斤两法口诀。比喻推卸干净。","source":{"text":"陈家的老的、小的，只是个一退六二五，说他们做买卖的人素来不结交官府，推得干干净净！","book":"欧阳山《三家巷》二七"},"example":{"text":"你就别～了"},"similar":["一推六二五"],"usage":"作谓语、宾语；指推卸责任，用于口语"},{"id":1134,"word":"一递一口","pinyin":"yī dì yī kǒu","abbr":"ydyk","explanation":"彼此你一言我一语地交替谈话，互相应答。","source":{"text":"于是西门庆把桂姐搂在怀中陪笑，一递一口儿饮酒。","book":"明·兰陵笑笑生《金瓶梅词话》第十二回"},"example":{"text":"窗外大道上一片皮靰鞡磨擦冰雪地面的刷刷声。他俩～地抽着一根烟。","book":"刘白羽《第二个太阳》第四章"}},{"id":1135,"word":"一递一句","pinyin":"yī dì yī jù","abbr":"ydyj","explanation":"彼此你一言我一语地交替谈话，互相应答。","source":{"text":"西门庆和这婆子一递一句，说了一回。","book":"明·施耐庵《水浒全传》第二十三回"},"example":{"text":"两个～，说得梳妆事毕。贵哥便走到厅上，分付当直的去叫女待诏来。","book":"明·冯梦龙《醒世恒言》卷二十三"}},{"id":1136,"word":"一递一声","pinyin":"yī dì yī shēng","abbr":"ydys","explanation":"彼此你一言我一语地交替谈话，互相应答。","source":{"text":"一个这壁，一个那壁，一递一声长吁气。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"这里又没有个吹打的，只得四个戴红黑帽子的，～，在黑天井里喝道，喝个不了。","book":"清·吴敬梓《儒林外史》第六回"}},{"id":1137,"word":"一递一答","pinyin":"yī dì yī dá","abbr":"ydyd","explanation":"彼此你一言我一语地交替谈话，互相应答。","source":{"text":"众人通不肯信，齐至遮堂后张看，果然两下一递一答说话。","book":"明·冯梦龙《醒世恒言》卷二十"},"example":{"text":"满房静悄悄地，只有帐中的微叹声和帐外小丫头的呼吸声，～。","book":"清·曾朴《孽海花》第二十一回"}},{"id":1138,"word":"一通百通","pinyin":"yī tōng bǎi tōng","abbr":"ytbt","explanation":"通：通晓。一个主要的弄通了，其他的自然也都会弄通。","source":{"text":"这猴王也是他一窍通时百窍通，当时习了口诀，自习自练，将七十二般变化，都学成了。","book":"明·吴承恩《西游记》"},"example":{"text":"猴王～，时常习了口诀。","book":"清·佚名《后西游》第三回"},"similar":["畅通无阻"],"opposite":["一窍不通","一筹莫展","一事无成"],"usage":"作谓语、宾语；用于知识、技巧等"},{"id":1139,"word":"一邱之貉","pinyin":"yī qiū zhī hè","abbr":"yqzh","explanation":"邱，同“丘”。比喻彼此同是丑类，没有什么差别。同“一丘之貉”。"},{"id":1140,"word":"一部二十四史无从说起","pinyin":"yī bù èr shí sì shǐ wú cóng shuō qǐ","abbr":"ybessswcsq","explanation":"二十四史：清乾隆时刻《史记》等24部史书。比喻情况复杂，头绪繁多，不知从哪里说起才好","source":{"text":"她这两句话，问得沈国英很感到一部二十四史无从说起。","book":"张恨水《啼笑姻缘》续集第八回"},"similar":["一部二十四史，不知从何说起"],"usage":"作宾语、定语、分句；用于书面语"},{"id":1141,"word":"一部二十四史，不知从何说起","pinyin":"yī bù èr shí sì shǐ,bù zhī cóng hé shuō qǐ","abbr":"ybesssbzchsq","explanation":"二十四史：清乾隆时刻《史记》等24部史书。比喻情况复杂，头绪繁多，不知从哪里说起才好","source":{"text":"觉世间变幻之态，无有过于中国官场者……尝苦一部二十四史，不知从何处说起。","book":"清·李宝嘉《官场现形记》序"},"example":{"text":"张恨水《啼笑姻缘》第八回：“这会子让我介绍一样给人，真是～了。”"},"similar":["一部二十四史无从说起"],"usage":"作宾语、定语、分句；用于书面语"},{"id":1142,"word":"一酬一酢","pinyin":"yī chóu yī zuò","abbr":"ycyc","explanation":"酬：向客人人敬酒；酢：向主人敬酒。一来一往地互相敬酒。","source":{"text":"说着便用那合欢杯，斟了满满的一钟，他夫妻果然一酬一酢的饮干。","book":"清·文康《儿女英雄传》第三十七回"},"usage":"作定语、状语；用于交往等"},{"id":1143,"word":"一里挠椎","pinyin":"yī lǐ náo chuí","abbr":"ylnc","explanation":"比喻众口一词可以混淆是非。","source":{"text":"三人成市虎，一里能挠椎。","book":"《淮同子·说山训》"}},{"id":1144,"word":"一重一掩","pinyin":"yī chóng yī yǎn","abbr":"ycyy","explanation":"指山峦重迭稠密。","source":{"text":"一重一掩吾肺腑，山鸟山花吾友于。","book":"唐·杜甫《岳麓山道林二寺行》诗"}},{"id":1145,"word":"一金之俸","pinyin":"yī jīn zhī fèng","abbr":"yjzf","explanation":"一：比喻很少；金：金钱；俸：俸禄。很少的一点薪俸。比喻微薄的待遇。","source":{"text":"一金之俸，必偏亲伦，仲庚之秩，散之故旧。","book":"南朝·梁·任昉《与沈约书》"}},{"id":1146,"word":"一针一线","pinyin":"yī zhēn yī xiàn","abbr":"yzyx","explanation":"比喻极微小的东西。","source":{"text":"一针一线，他们也没得收藏。","book":"清·曹雪芹《红楼梦》第74回"},"example":{"text":"人民解放军纪律严明，公买公卖，不许妄取民间～。","book":"毛泽东《中国人民解放军布告》"},"similar":["一草一木"],"opposite":["斗牛车薪"],"usage":"作宾语、定语；比喻极微小的东西"},{"id":1147,"word":"一针一缐","pinyin":"yī zhēn yī yú","abbr":"yzyx","explanation":"比喻细微的东西。缐，亦作“线”。"},{"id":1148,"word":"一针见血","pinyin":"yī zhēn jiàn xiě","abbr":"yzjx","explanation":"一针就见血。比喻说话直截了当，切中要害。","source":{"text":"一针即瘥。","book":"《后汉书·郭玉传》"},"example":{"text":"这不是把我们的毛病讲得～么？不错，党八股中中国有，外国也有，可见是通病。","book":"毛泽东《反对党八股》"},"similar":["一语道破","一语破的","言必有中"],"opposite":["言不及义","言之无物","空洞无物"],"usage":"作谓语、定语、状语；用于说话或看问题"},{"id":1149,"word":"一钱不值","pinyin":"yī qián bù zhí","abbr":"yqbz","explanation":"一个铜钱都不值。比喻毫无价值。","source":{"text":"夫无所发怒，乃骂临汝侯曰：‘生平毁程不识不直一钱，今日长者为寿，乃效女儿咕嗫耳语。","book":"《史记·魏其武安侯列传》"},"example":{"text":"其中更生出无数谣言，添了无数假话，竟把个瞿耐庵说得～，恨不得早叫这个瘟官离任才好。","book":"清·李宝嘉《官场现形记》第四十回"},"similar":["一文不值"],"opposite":["价值连城"],"usage":"作谓语、宾语、定语；指毫无价值","story":["西汉时期，丞相田蚡结婚，灌夫前去祝贺，在酒宴上，灌夫多喝了几杯，就向田蚡敬酒，田蚡拒绝了他。他不痛快，就走到临汝侯灌贤面前，见灌贤与程不识在耳语。灌夫大骂程不识一钱不值，骂灌贤为妇人一样咬耳根子"]},{"id":1150,"word":"一钱不名","pinyin":"yī qián bù míng","abbr":"yqbm","explanation":"指身无分文。常以形容囊橐一空或甚为贫穷。","source":{"text":"岑其身道：‘我也本来打算早办，只是大嫂同舍妹要在家多停几日。又兼我是一钱不名，还要张罗几文才能办事，因此耽搁下来。’","book":"清·吴趼人《糊涂世界》第十二回"},"example":{"text":"但在～的穷措大如我辈者，这种设计恐终于只是‘过屠门而大嚼’而已。","book":"朱自清《“海阔天空”与“古今中外”》"},"similar":["不名一钱"],"usage":"作谓语、定语；用于书面语"},{"id":1151,"word":"一钱不直","pinyin":"yī qián bù zhí","abbr":"yqbz","explanation":"指毫无价值","source":{"text":"多病所须惟药物，一钱不直是儒冠。","book":"金·元好问《晨起》诗"},"similar":["一钱不值","一文不值"],"usage":"作谓语、宾语、定语；指毫无价值"},{"id":1152,"word":"一钱不落虚空地","pinyin":"yī qián bù luò xū kōng dì","abbr":"yqblxkd","explanation":"比喻丝毫不浪费。","source":{"text":"但有一件毛病，乃先天带了来，一世也不会改的，是把铜钱看的太重，除掉送给女人之外，一钱不落虚空地。","book":"清·李宝嘉《官场现形记》第十二回"},"example":{"text":"乞丐追在后面叫：“先生！太太！太太！您修子修孙，～……”她当时听了非常窘，回想起来却不免微笑着。","book":"张爱玲《多少恨》"},"similar":["精打细算"],"opposite":["铺张浪费"],"usage":"作宾语、分句、定语；指精打细算"},{"id":1153,"word":"一钱太守","pinyin":"yī qián tài shǒu","abbr":"yqts","explanation":"比喻值得称赞的廉洁的官吏。或讥讽那些贪官污吏贪财。","example":{"text":"他为官清廉，被人们称赞为～。"},"usage":"作主语、宾语、定语；指清官","story":["汉代清官会稽太守刘宠十分关心百姓疾苦，将政令及刑罚尽量简化，免除很多苛捐杂税，让老百姓深受感动。他离任时，山阴县很多老人来为他送行，并坚持要送他100个大钱，刘宠在万般无奈下只好接受他们的一个大钱，留下了一钱太守的美名"]},{"id":1154,"word":"一钱如命","pinyin":"yī qián rú mìng","abbr":"yqrm","explanation":"把一文钱看得象性命那样重。比喻极端吝啬。","source":{"text":"谁知这些穷酸，一钱如命，总要贪图便宜，不肯十分出价。","book":"清·李汝珍《镜花缘》第二十三回"},"example":{"text":"这班买办平日都是～的。（清·吴趼人《二十年目睹之怪现状》第二十四回）"},"similar":["爱财如命"],"opposite":["挥金如土"],"usage":"作谓语、定语；形容人守财"},{"id":1155,"word":"一钵一瓶","pinyin":"yī bō yī píng","abbr":"ybyp","explanation":"钵、瓶：和尚的饮食器具。指和尚云游时的简单食具。形容家境贫寒","source":{"text":"一葛一裘经岁，一钵一瓶终日，老子旧家风。","book":"宋·辛弃疾《水调歌头·题永丰杨少游提点一枝堂》"},"similar":["一瓶一钵"],"usage":"作宾语、定语；用于书面语"},{"id":1156,"word":"一锅煮","pinyin":"yī guō zhǔ","abbr":"ygz","explanation":"比喻不分彼此，一样看待或处理。","example":{"text":"具体问题具体对待，不能搞～。"},"similar":["一锅烩"],"usage":"作谓语、宾语、定语；用于处事"},{"id":1157,"word":"一锅端","pinyin":"yī guō duān","abbr":"ygd","explanation":"比喻一下子全拿出来，没有剩余或比喻一下子全部消灭。","example":{"text":"武装警察将这个赌场来了一个～。"},"usage":"作宾语、定语；用于口语"},{"id":1158,"word":"一锅粥","pinyin":"yī guō zhōu","abbr":"ygz","explanation":"形容一团糟。","example":{"text":"他们班乱得像～。"},"usage":"作宾语、定语；用于比喻句"},{"id":1159,"word":"一锅面","pinyin":"yī guō miàn","abbr":"ygm","explanation":"比喻办事糊涂。","source":{"text":"若欲百物贱，直待真直院。吃了西湖水，打作一锅面。","book":"宋·周密《癸辛杂识·前集·真西山入朝诗》"}},{"id":1160,"word":"一错再错","pinyin":"yī cuò zài cuò","abbr":"yczc","explanation":"一次又一次地犯错误。","example":{"text":"当时定是悲痛悔恨已极，再也想不到其余，以致～。","book":"金庸《雪山飞狐》第五回"}},{"id":1161,"word":"一错百错","pinyin":"yī cuò bǎi cuò","abbr":"ycbc","explanation":"指在关键问题上错了，其它有关的事情也无一不错。","source":{"text":"累及后代儿孙，往往从而错传，一错百错，滥觞不止。","book":"宋·无名氏《西岩和尚语录·庆元府太白名山天童景德禅寺》"},"example":{"text":"此处不论善念恶念，更无虚假。一是百是，～。","book":"明·王阳明《传习录》卷上"}},{"id":1162,"word":"一锤子买卖","pinyin":"yī chuí zi mǎi mài","abbr":"yczmm","explanation":"只做一次生意。","source":{"text":"咱们哪，砂锅砸蒜，一锤子的买卖，我永远不再到这儿来！","book":"老舍《女店员》第二幕"},"example":{"text":"你不能只做～。"},"usage":"作宾语；指短期行为"},{"id":1163,"word":"一锤定音","pinyin":"yī chuí dìng yīn","abbr":"ycdy","explanation":"制造铜锣时最后一锤决定锣的音色。借指凭一句话作出最后决定。","source":{"text":"他不声不响，却是一家之主；女儿中意，老伴点头，也还得听他一锤定音。","book":"刘绍棠《小荷才露尖尖角》"},"example":{"text":"我们等他来～。"},"similar":["一槌定音"],"opposite":["犹豫不决","犹犹豫豫"],"usage":"作谓语、分句；比喻做事干脆，说了算"},{"id":1164,"word":"一镬之味","pinyin":"yī huò zhī wèi","abbr":"yhzw","explanation":"镬：无足的鼎，古代烹煮用的器物。尝一点就知道全鼎食物的味道。比喻从已知的一部分，可以推知全部。","source":{"text":"尝一脟肉，而知一镬之味，一鼎之调。","book":"《吕氏春秋·察今》"}},{"id":1165,"word":"一长一短","pinyin":"yī cháng yī duǎn","abbr":"ycyd","explanation":"形容说话絮叨，琐谈不休。","source":{"text":"王夫人便一长一短问他今日是那几位堂客，戏文好歹，酒席如何。","book":"清·曹雪芹《红楼梦》第25回"},"similar":["唠唠叨叨"],"usage":"作谓语、定语；指说话絮叨"},{"id":1166,"word":"一长两短","pinyin":"yī cháng liǎng duǎn","abbr":"ycld","explanation":"指意外的灾祸或事故。","source":{"text":"倘或聚众人多了，外国人有个一长两短，岂不是于国际上又添了一重交涉么？","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["一长二短","三长两短"],"usage":"作宾语；指意外的灾祸或事故"},{"id":1167,"word":"一长二短","pinyin":"yī cháng èr duǎn","abbr":"yced","explanation":"指意外的灾祸或事故。","source":{"text":"若有一长二短，叫我怎生舍得。","book":"清·李渔《凰求凤·假病》"},"example":{"text":"如果遇上～，你也不要害怕，要沉住气应付他们。","book":"梁斌《播火记》"},"similar":["三长两短","一长两短","一长半短"],"usage":"作宾语；指意外的灾祸或事故"},{"id":1168,"word":"一长半短","pinyin":"yī cháng bàn duǎn","abbr":"ycbd","explanation":"指意外的灾祸或事故。同“一长二短”。","source":{"text":"倘有一长半短，岂不于我的风水也有关碍？","book":"清·李宝嘉《文明小史》第二回"},"similar":["一长二短","三长两短","一长两短"],"usage":"作宾语；指意外的灾祸或事故"},{"id":1169,"word":"一门千指","pinyin":"yī mén qiān zhǐ","abbr":"ymqz","explanation":"门：家门；千：许多人。指大家庭人口众多。","source":{"text":"诩少孤，兄弟数人，事继母以孝闻，一门千指，家法严肃，男女异序，少长辑睦，匜架无主，厨馔不异。","book":"《宋史·颜诩传》"}},{"id":1170,"word":"一门同气","pinyin":"yī mén tóng qì","abbr":"ymtq","explanation":"指同门兄弟。","source":{"text":"他是我一门同气，我怎么不与他出力辨明冤枉。","book":"明·吴承恩《西游记》第六十三回"},"usage":"作宾语、定语；用于书面语"},{"id":1171,"word":"一门心思","pinyin":"yī mén xīn sī","abbr":"ymxs","explanation":"指一心一意。","source":{"text":"他自己又到图书馆借来关于数控的书，什么也不顾了，一门心思钻研起来。","book":"孙华炳《重赏之下》"},"example":{"text":"他～搞技术革新。"},"similar":["一心一意"],"opposite":["三心二意"],"usage":"作状语；指一心一意"},{"id":1172,"word":"一门百指","pinyin":"yī mén bǎi zhǐ","abbr":"ymbz","explanation":"指一家有十口人。","source":{"text":"五刑之属三千，小过大过，一门之聚百指，家人同人。","book":"宋·周密《齐东野语》卷十七"},"example":{"text":"～论胥尽，唯有丹衷天地知。","book":"宋·陈文龙《元兵浮至合沙，诗寄仲子》"}},{"id":1173,"word":"一门百笏","pinyin":"yī mén bǎi hù","abbr":"ymbh","explanation":"笏：古时大臣上朝时拿着的手板，用玉、象牙或竹片制成，可以记事。一家里有许多手拿笏板的大臣。形容旧时豪门贵族的兴盛状况。","source":{"text":"于是穆子孙虽在襁褓，悉拜仪同，其一门执象笏者百余人，穆之贵盛，当时无比。","book":"《隋书·李穆传》"}},{"id":1174,"word":"一问三不知","pinyin":"yī wèn sān bù zhī","abbr":"ywsbz","explanation":"原意是对某一事情的开始、发展、结果都不知道，现在用来表示对实际情况一点也不知道。","source":{"text":"君子之谋也，始、衷、终皆举之，而后入焉。今我三不知而入之，不亦难乎!","book":"《左传·哀公二十七年》"},"example":{"text":"一连问了几个问题，他都答不出，老师对他这种～的学习态度很生气。"},"similar":["装疯卖傻","一无所知"],"opposite":["无所不知"],"usage":"作谓语、定语、宾语、分句；指不清楚","story":["公元前468年，晋国大夫荀瑶率大军讨伐郑国，郑国君派大夫公子般去齐国求救。齐平公派大夫陈成子率军去救援。荀瑶派使者与陈成子讲和。陈成子的部将荀寅自作聪明地说自己对此事的开始、发展、结果三方面都不知道，怪不得到处碰壁"]},{"id":1175,"word":"一闻千悟","pinyin":"yī wén qiān wù","abbr":"ywqw","explanation":"形容悟性极高。指略一指点，即完全了悟。","source":{"text":"得大总持，一闻千悟。","book":"《景德传灯录·汾州大达无业国师》"},"example":{"text":"上上根人，～。","book":"宋·杨杰《宗镜录》卷二"},"usage":"作谓语、定语；用于书面语"},{"id":1176,"word":"一阳复始","pinyin":"yī yáng fù shǐ","abbr":"yyfs","explanation":"古人认为天地之间有阴阳二气，每年到冬至日，阴气尽，阳气又开始发生。指春天又到来了。","source":{"text":"转眼又是一阳复始，家家户户庆贺新年，独有那公子母子寂寥过岁。","book":"清·李雨堂《万花楼》第三回"},"example":{"text":"黄蓉曾说这庄子布置虽奇，那及桃花岛～、乾坤倒置之妙。","book":"金庸《射雕英雄传》第三十四回"}},{"id":1177,"word":"一阳来复","pinyin":"yī yáng lái fù","abbr":"yylf","explanation":"古人认为天地之间有阴阳二气，每年到冬至日，阴气尽，阳气又开始发生。指春天又到来了。","source":{"text":"恁是一阳来复后，梅花柳眼先春发。","book":"宋·王炎《满江红·至日和黄伯威》词"},"example":{"text":"七解寒云沍，四序垓，～天心泰。","book":"《清史稿·乐志五》"}},{"id":1178,"word":"一阴一阳之谓道","pinyin":"yī yīn yī yáng zhī wèi dào","abbr":"yyyyzwd","explanation":"阴、阳：指事物矛盾的两个对立面；道：事物发展的规律。既有阴，又有阳，这就是道，即事物发展的规律。","source":{"text":"一阴一阳之谓道，继之者善也，成之者性也。仁者见之谓之仁，知者见之谓之知，百姓日用而不知，故君子之道鲜矣。","book":"《周易·系辞上》"}},{"id":1179,"word":"一阶半级","pinyin":"yī jiē bàn jí","abbr":"yjbj","explanation":"阶、级：是封建时代的等级品位。指非常低微的官职。","source":{"text":"或因家世余绪，得一阶半级，便自为足，全忘修学。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"宋·罗大经《鹤林玉露》第四卷：“自后世贪荣竞进，争～，至于杀人，于是始以退一步行为安乐法矣。”"},"similar":["一阶半职"],"usage":"作宾语、定语；用于书面语"},{"id":1180,"word":"一阶半职","pinyin":"yī jiē bàn zhí","abbr":"yjbz","explanation":"指非常低微的官职。同“一阶半级”。","source":{"text":"便博得一介半职，何足算，不堪题。","book":"元·马致远《陈抟高卧》第三折"},"similar":["一阶半级"],"usage":"作宾语、定语；用于书面语"},{"id":1181,"word":"一隅三反","pinyin":"yī yú sān fǎn","abbr":"yysf","explanation":"隅：角落；一隅：一个方面。从一件事物的情况、道理类推而知道许多事物的情况、道理。","source":{"text":"举一隅不以三隅反，则不复也。","book":"《论语·述而》"},"example":{"text":"乾初括磨旧习，～。","book":"清·黄宗羲《陈乾初墓志铭》"},"similar":["举一反三"],"usage":"作谓语、宾语；指善于类推"},{"id":1182,"word":"一隅之地","pinyin":"yī yú zhī dì","abbr":"yyzd","explanation":"隅：角落。形容地域狭小。","source":{"text":"晋自中原沸腾，介居江左，以一隅之地，抗衡上国。","book":"《南史·王弘传论》"},"example":{"text":"陛下一统中原，幽州～取之何难。","book":"明·无名氏《杨家将演义》第二十四回"},"similar":["一席之地"],"usage":"作宾语；指小地方"},{"id":1183,"word":"一隅之见","pinyin":"yī yú zhī jiàn","abbr":"yyzj","explanation":"见：见解。偏于一方面的见解。","source":{"text":"举一隅不以三隅反，则不复也。","book":"《论语·述尔》"},"example":{"text":"人但各以其～ ，认定以为道止如此。","book":"明·王守仁《语录一》"},"similar":["一孔之见","管见所及","以偏概全"],"opposite":["真知灼见","远见卓识"],"usage":"作宾语；用于自谦"},{"id":1184,"word":"一隅之说","pinyin":"yī yú zhī shuō","abbr":"yyzs","explanation":"片面的说法；偏见。","source":{"text":"一隅谓一方偏见也。","book":"《后汉书·王充等传论》：“数子之言当世失得皆究矣，然多谬通方之训，好申一隅之说。”李贤注"},"example":{"text":"或曰：‘赏所以使人，不先赏，人不为我用。’是皆～也，非通论也。","book":"宋·苏洵《衡论上·御将》"},"usage":"作宾语；指偏见"},{"id":1185,"word":"一隙不通","pinyin":"yī xì bù tōng","abbr":"yxbt","explanation":"隙：空隙，孔。一孔不通。比喻一点都不懂。","source":{"text":"而书旨、文字一隙不通者，百人之中，不下三十人。","book":"明·宋应星《野议·学政议》"}},{"id":1186,"word":"一雕双兔","pinyin":"yī diāo shuāng tù","abbr":"ydst","explanation":"指三人并列显位，一人势盛而两人受其挟制。","source":{"text":"唐李林甫、张九龄、裴耀卿并为相，李抑扬张、裴自得，张裴二人罄折卑逊，时人窃言“一雕挟两兔”。见唐郑处诲《明皇杂录》卷下及《新唐书·李林甫传》。"}},{"id":1187,"word":"一雷二闪","pinyin":"yī léi èr shǎn","abbr":"yles","explanation":"形容躲避迅速。"},{"id":1188,"word":"一面之交","pinyin":"yī miàn zhī jiāo","abbr":"ymzj","explanation":"只见过一面的交情。比喻交情很浅。","source":{"text":"且观世人之相论也，徒以一面之交，定臧否之决。","book":"汉·崔寔《本论》"},"example":{"text":"咱们总算有～，在兵营里你伺候过我；再说咱们又都是街面上的人，所以我担着好大的处分来给你送个信。","book":"老舍《骆驼祥子》十一"},"similar":["萍水相逢"],"opposite":["莫逆之交","情深谊厚","一见钟情"],"usage":"作宾语；比喻交情很浅"},{"id":1189,"word":"一面之旧","pinyin":"yī miàn zhī jiù","abbr":"ymzj","explanation":"只见过一面的交情。比喻交情很浅。","source":{"text":"且观世人之相论也，徒以一面之交，定臧否之决。","book":"汉·崔寔《本论》"},"example":{"text":"凡与有～者，尽易已之门状。","book":"宋·吕居仁《轩渠录》"}},{"id":1190,"word":"一面之款","pinyin":"yī miàn zhī kuǎn","abbr":"ymzk","explanation":"谓只见过一面，了解不深。同“一面之交”。","source":{"text":"还至都，凡诸旧及有一面之款，无不厚加赠遗。","book":"《宋书·诸叔度传》"},"similar":["一面之雅","一面之交","一面之识"],"usage":"作宾语；比喻交情很浅"},{"id":1191,"word":"一面之缘","pinyin":"yī miàn zhī yuán","abbr":"ymzy","explanation":"见一面的缘分。","source":{"text":"若问此物，倒有一面之缘。","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"尽管他与那位郭小姐只～，然而她的形象却像用刀刻下来似的。","book":"叶永烈《并蒂莲》"},"similar":["一面之交","点头之交"],"opposite":["生死之交","患难之交","刎颈之交"],"usage":"作主语、宾语；用于人"},{"id":1192,"word":"一面之荣","pinyin":"yī miàn zhī róng","abbr":"ymzr","explanation":"面：见面；荣：荣幸。很荣幸地见过一面或看到过一眼。","source":{"text":"一盼之荣，郑璞逾于周宝。","book":"南朝·梁·任昉《王文宪集·序》"}},{"id":1193,"word":"一面之识","pinyin":"yī miàn zhī shí","abbr":"ymzs","explanation":"指只见过一面，略有认识。","source":{"text":"范纯仁，得一面识足矣。","book":"《宋史·范纯仁传》"},"example":{"text":"余幄奇，我无～。","book":"郭沫若《洪波曲》第一章"},"similar":["一面之交","萍水相逢"],"opposite":["莫逆之交"],"usage":"作宾语；指一面之交"},{"id":1194,"word":"一面之词","pinyin":"yī miàn zhī cí","abbr":"ymzc","explanation":"争执的双方中一方所说的话。","source":{"text":"今日若听此一面之词，杨仪等必投魏矣。","book":"明·罗贯中《三国演义》第一百五回"},"example":{"text":"在这件事情上，我们不能只听～，必须全面了解情况，然后再做处理。"},"similar":["偏听偏信","一面之辞"],"opposite":["兼听则明"],"usage":"作宾语；用于否定句"},{"id":1195,"word":"一面之说","pinyin":"yī miàn zhī shuō","abbr":"ymzs","explanation":"只见过一面的交情。比喻交情很浅。","source":{"text":"且观世人之相论也，徒以一面之交，定臧否之决。","book":"汉·崔寔《本论》"},"example":{"text":"承曰：“丞相何故听逃奴～？”操曰：“王子服等吾已擒下，皆招证明白，汝尚抵赖乎？”","book":"明·罗贯中《三国演义》第二十三回"}},{"id":1196,"word":"一面之辞","pinyin":"yī miàn zhī cí","abbr":"ymzc","explanation":"争执的双方中一方所说的话。指单方面的话，版面的看法。","source":{"text":"今日若听此一面之词，杨仪等必投魏矣。","book":"明·罗贯中《三国演义》第一百五回"},"example":{"text":"据媒人～，所以派人相看。","book":"清·曹雪芹《红楼梦》第一百一十九回"},"similar":["一面之词"],"usage":"作主语、宾语；用于说话"},{"id":1197,"word":"一面之雅","pinyin":"yī miàn zhī yǎ","abbr":"ymzy","explanation":"只见过一面的交情。比喻交情很浅。同“一面之交”。","source":{"text":"女的我不认识，跟这关汉卿倒有一面之雅。","book":"田汉《关汉卿》第七场"},"similar":["一面之款","一面之交","一面之识"],"usage":"作宾语；比喻交情很浅"},{"id":1198,"word":"一面儿理","pinyin":"yī miàn ér lǐ","abbr":"ymel","explanation":"一方面的理由，片面的道理。","example":{"text":"我们不能听信～。"},"similar":["一面之词"],"usage":"作宾语；指一面之词"},{"id":1199,"word":"一面如旧","pinyin":"yī miàn rú jiù","abbr":"ymrj","explanation":"初次见面就象老朋友一样。","source":{"text":"见华一面如旧，钦华德范，如师资之礼焉。","book":"《晋书·张华传》"},"similar":["一见如故"],"usage":"作谓语、定语；同“一见如故”"},{"id":1200,"word":"一面虚词","pinyin":"yī miàn xū cí","abbr":"ymxc","explanation":"单方面所说的假话。","source":{"text":"明公休听外人一面虚词，欲杀某也。","book":"明·罗贯中《三国演义》第一百十五回"},"example":{"text":"老师那知道，倒把他～，当做真话，被他欺诳过了。","book":"明·许仲琳《封神演义》第七十三回"},"similar":["一面之词"],"usage":"作主语、宾语；用于说话等"},{"id":1201,"word":"一面驱禽","pinyin":"yī miàn qū qín","abbr":"ymqq","explanation":"把捕禽的网撒开三面，留下可以逃生的出路。比喻给罪犯留下一条改过自新的出路。","source":{"text":"连珠两起，合玉双沉，穀为祥树，桑成乐林，三方落网，一面驱禽，德以行政，仁乎用心。","book":"北周·庾信《自古圣帝名贤赞汤解祝网》"}},{"id":1202,"word":"一鞍一马","pinyin":"yī ān yī mǎ","abbr":"yaym","explanation":"比喻一夫一妻。","source":{"text":"我们妇道家一鞍一马，到是站得脚头定的。","book":"明·冯梦龙《警世通言》卷二"},"example":{"text":"我们少爷真是癞虾蟆想吃天鹅肉，好好的～也就罢了。","book":"清·李宝嘉《文明小史》第四十回"}},{"id":1203,"word":"一鞭一条痕","pinyin":"yī biān yī tiáo hén","abbr":"ybyth","explanation":"比喻做事着着落实或说话切中要害。同“一棒一条痕”","source":{"text":"八股文章若做的好，随你做甚么东西，要诗就诗，要赋就赋，都是一鞭一条痕，一掴一掌血。","book":"清·吴敬梓《儒林外史》第十一回"},"example":{"text":"吾兄这几句话，真是～的几句好文章！","book":"清·文康《儿女英雄传》第三十五回"},"similar":["一棒一条痕，一掴一掌血"],"usage":"作宾语、定语；比喻做事扎实"},{"id":1204,"word":"一鞭一条痕，一掴一掌血","pinyin":"yī biān yī tiáo hén，yī guó yī zhǎng xuè","abbr":"ybythygyzx","explanation":"掴：用巴掌打。抽一鞭出现一条血痕，打一掌出现血印。比喻做事有效用，立竿见影","source":{"text":"八股文章若做的好，随你做甚么东西——要诗就诗，要赋就赋，都是一鞭一条痕，一掴一掌血。","book":"清·吴敬梓《儒林外史》第11回"},"similar":["一棒一条痕，一掴一掌血"],"usage":"作宾语、分句；比喻做事扎实"},{"id":1205,"word":"一鞭先著","pinyin":"yī biān xiān zhuó","abbr":"ybxz","explanation":"后以为争先的典实。亦泛指先行。","source":{"text":"晋刘琨少负志气，与祖逖为友，共以收复中原为志，曾与亲故书曰：“吾枕戈待旦，志枭逆虏，常恐祖生先吾著鞭。”见《晋书·刘琨传》。"},"example":{"text":"得脱穹庐似脱围，～喜公归。","book":"清·林则徐《送嶰筠赐环东归》诗"},"similar":["先吾著鞭"],"usage":"作宾语、定语；用于书面语","story":["晋朝时期，年轻有为的刘琨胸怀大志，想为国家出力，好友祖逖被选拔为官。他发誓要像祖逖那样为国分忧。后来他当官从司隶一直做到尚书郎。他曾经对亲友写信说：“吾枕戈待旦，志枭逆虏，常恐祖生先吾著鞭。”"]},{"id":1206,"word":"一顾之价","pinyin":"yī gù zhī jià","abbr":"ygzj","explanation":"顾：看。古之善于相马者伯乐看了马一眼，良马的身价就值千金。比喻得到贤人推荐而使人或事物身价倍增。","source":{"text":"数蒙伯乐一顾之价，而苍蝇之飞，不过数步，即托骥尾，得以绝髃。","book":"《后汉书·隗嚣传》"}},{"id":1207,"word":"一顾之荣","pinyin":"yī gù zhī róng","abbr":"ygzr","explanation":"顾：看。指被有才学的人看一下就立即抬高了身价。","example":{"text":"他被选拔进专家组，有了这～，身价立即上升。"},"usage":"作宾语；指受赏识","story":["春秋时期，著名相马专家伯乐路过虞坂见一匹良骥拉盐车，他觉得很可惜就买下，经饲养后来成为有名的千里马。一次有人牵马到集市三次没卖掉，遇到伯乐光顾并夸了一下这匹马，结果该马的售价立即升了10倍"]},{"id":1208,"word":"一顾倾人","pinyin":"yī gù qīng rén","abbr":"ygqr","explanation":"形容女子容貌艳丽。","source":{"text":"北方有佳人，绝世而独立，一顾倾人城，再顾倾人国。","book":"《汉书·外戚传》"},"example":{"text":"明·汤显祖《南柯记·偶见》：“他三回自语，～。”"},"similar":["一顾倾城","一貌倾城","倾国倾城"],"usage":"作定语、状语；用于女性","story":["汉朝时期，中山李氏兄妹三人到京城长安发展，李延年进入皇宫乐府，他向汉武帝推荐他妹妹是绝世佳人，一见倾城，再顾倾国。汉武帝十分高兴就召见李延年的妹妹并封她为夫人，生下昌邑王刘贺，汉武帝十分宠爱这个绝色夫人"]},{"id":1209,"word":"一顾倾城","pinyin":"yī gù qīng chéng","abbr":"ygqc","explanation":"形容美女的眼波，也比喻女子的美貌。","source":{"text":"北方有佳人，绝世而独立，一顾倾人城，再顾倾人国。","book":"《汉书·外戚传》"},"example":{"text":"自己本生得一副月貌花容，一团灵心慧性。那怕丈夫千金买笑，自料断不及我～。","book":"清·文康《儿女英雄传》第二十七回"},"similar":["一顾倾人","一貌倾城"],"usage":"作定语、状语；用于女性","story":["汉朝时期，中山李氏兄妹三人到京城长安发展，李延年进入皇宫乐府，他向汉武帝推荐他妹妹是绝世佳人，一见倾城，再顾倾国。汉武帝十分高兴就召见李延年的妹妹并封她为夫人，生下昌邑王刘贺，汉武帝十分宠爱这个绝色夫人"]},{"id":1210,"word":"一顾千金","pinyin":"yī gù qiān jīn","abbr":"ygqj","explanation":"顾：看。古之善于相马者伯乐看了马一眼，良马的身价便值千金。比喻得到贤者的推荐而使人或事物身价倍增。","source":{"text":"一顾千金重，何必珠玉钱？","book":"三国·魏·曹植《失題（有美一人）》诗"}},{"id":1211,"word":"一颦一笑","pinyin":"yī pín yī xiào","abbr":"ypyx","explanation":"颦：皱眉。指忧和喜的表情。","source":{"text":"吾闻明主之爱，一颦一笑，颦有为颦，而笑有为笑。","book":"《韩非子·内储说左上》"},"example":{"text":"金门玉堂临水居，～千万余。","book":"南朝梁·萧统《龙笛曲》"},"similar":["一笑一颦"],"usage":"作主语、宾语、定语；指人的表情"},{"id":1212,"word":"一风吹","pinyin":"yī fēng chuī","abbr":"yfc","explanation":"比喻完全勾销（多指决定、结论等）。","source":{"text":"后世不论官宦和平民人家，只要是有产业的，兄弟叔侄争产，势同仇人，平日所讲的仁义忠信，兄友弟恭，全都一风吹了。","book":"姚雪垠《李自成》第一卷第十七章"},"similar":["一笔勾销"],"usage":"作谓语；多指决定、结论等"},{"id":1213,"word":"一飞冲天","pinyin":"yī fēi chōng tiān","abbr":"yfct","explanation":"鸟儿展翅一飞，直冲云霄。比喻平时没有特殊表现，一下做出了惊人的成绩。","source":{"text":"此鸟不飞则已，一飞冲天；不鸣则已，一鸣惊人。","book":"《韩非子·喻老》：“虽无飞，飞必冲天；虽无鸣，鸣必惊人。”《史记·滑稽列传》"},"example":{"text":"白常欲一鸣惊人，～。","book":"明·杨慎《李白墓志》"},"similar":["一鸣惊人"],"usage":"作谓语、定语；比喻有惊人之举"},{"id":1214,"word":"一食万钱","pinyin":"yī shí wàn qián","abbr":"yswq","explanation":"一顿饭要花掉很多钱。形容生活奢侈。","source":{"text":"初，何劭以公子奢侈，每食必尽四方珍馔，恺乃逾之，一食万钱，犹云无可下箸处。","book":"《晋书·何曾传》"},"example":{"text":"惟阿附贾充，无所建白，自奉甚厚，～，尚谓无下箸处。","book":"蔡东藩《两晋演义》第四回"}},{"id":1215,"word":"一食三起","pinyin":"yī shí sān qǐ","abbr":"yssq","explanation":"原指周公旦勤于接待来客，吃饭时，三次吐出食物急于迎客。形容殷勤待士。","source":{"text":"我一沐三捉发，一饭三吐哺，起以待士，犹恐失天下之贤人。","book":"《史记·鲁周公世家》"},"example":{"text":"又纳礼贤人，一沐三握发，～，尧美其绩，乃赐姓姒氏，封为夏伯。","book":"唐·欧阳询《艺文类聚》卷十一"}},{"id":1216,"word":"一飧之德","pinyin":"yī sūn zhī dé","abbr":"yszd","explanation":"飧：简单的饮食。一顿饭的恩德。比喻微小的恩惠。","source":{"text":"法正外统都畿，内为谋主，一飧之德、睚眦之怨，无不报复，擅杀毁伤己者数人。","book":"《三国志·蜀志·法正传》"}},{"id":1217,"word":"一饥两饱","pinyin":"yī jī liǎng bǎo","abbr":"yjlb","explanation":"犹言每天不能饱食。形容生活贫困。","source":{"text":"钱兴日逐做些小经纪供给家主，每每不敷，一饥两饱。","book":"明·冯梦龙《醒世恒言》第七卷"},"opposite":["丰衣足食"],"usage":"作谓语、定语；用于生活"},{"id":1218,"word":"一饭三吐哺","pinyin":"yī fàn sān tǔ bǔ","abbr":"yfstb","explanation":"指一顿饭之间，三次停食，以接待宾客。比喻求贤殷切。","source":{"text":"我文王之子，武王之弟，成王之叔父，我于天下亦不贱矣。然我一沐三握发，一饭三吐哺，起以待士，犹恐失天下之贤人。子之鲁，慎勿以国骄人。","book":"《史记·鲁周公世家》"},"example":{"text":"干王恩高量广，不以初交见嫌，不以触犯见罪，虽与周之姬旦，～， 一沐三握发，无以过也。","book":"太平天国·洪仁玕《英杰归真》"},"similar":["握发吐哺"],"usage":"作宾语、定语；用于书面语","story":["西周时期，周成王继承父亲的遗志，分封诸侯，他封伯禽为鲁侯，周公向兄弟伯禽祝贺，说：“你以前是鲁国的有名能士，你到任后不要忘记你是周文王的儿子，周武王的弟弟，现今成王的叔叔。你要一沐三握发，一饭三吐哺，爱惜人才。”"]},{"id":1219,"word":"一饭三遗矢","pinyin":"yī fàn sān yí shǐ","abbr":"yfsys","explanation":"矢：通“屎”，粪便。一顿饭的功夫上了三次厕所。形容年老体弱或年老无用。","example":{"text":"他现在发出“廉颇老矣，～”的慨叹。"},"opposite":["老当益壮"],"usage":"作谓语、定语；指人老了","story":["战国时期，赵悼襄王听信大夫郭开的谗言，派乐乘取代廉颇为将，廉颇逃到魏国。9年后，秦军进攻赵国，赵军连连败北。赵王想请廉颇回来，郭开担心廉颇报复，派唐玖去魏国探望廉颇。廉颇表示愿意为国分忧，唐玖回来诬陷廉颇一饭三遗矢老而无用"]},{"id":1220,"word":"一饭之先","pinyin":"yī fàn zhī xiān","abbr":"yfzx","explanation":"比别人早出生一顿饭的时间。指年龄比别人稍长。","source":{"text":"寡人礼先壹饭矣。","book":"《国语·越语上》"},"example":{"text":"仆于今世有一日之长，～焉。","book":"清·章炳麟《致山田饮江书》"},"usage":"作宾语；用于书面语"},{"id":1221,"word":"一饭之德","pinyin":"yī fàn zhī dé","abbr":"yfzd","explanation":"比喻微小的恩德。","source":{"text":"范雎于是散家财物，尽以报所尝困厄者。一饭之德必偿，睚眦之怨必报。","book":"西汉·司马迁《史记·范雎蔡泽列传》"},"example":{"text":"世相传余初有～，葛如方布衣野走。","book":"清·俞樾《茶香室续钞·陆晋》"},"similar":["滴水之恩"],"opposite":["大恩大德"],"usage":"作宾语；比喻微小的恩德","story":["秦朝末年，淮阴孤儿韩信靠在淮水边钓鱼为生，经常是钓不到鱼而要饿肚子，一个漂洗丝絮的老大娘见他可怜，经常把自己的饭分一半给他吃。韩信后来成为淮阴侯，特地找到当年的漂絮大娘，送给她一千金酬谢"]},{"id":1222,"word":"一饭之恩","pinyin":"yī fàn zhī ēn","abbr":"yfze","explanation":"一餐饭的恩德。指小恩。","source":{"text":"我曾受过他的～，岂有不报之理？"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“总听过韩信的故事，～，千金以报，没有哪个说漂母不应该收。”"},"similar":["一饭之德"],"opposite":["大恩大德"],"usage":"作主语、宾语；指小恩","story":["春秋时期，昏庸残暴的晋灵公想杀掉劝谏的国相赵盾，就请赵盾喝酒，被赵盾卫士提弘明发觉就提前借故离开，晋灵公派卫士前去追剿，提弘明壮烈牺牲，突然一名武士灵辙出来为赵盾解围，他就是几年前被赵盾救下的饿汉，这次来报他的一饭之恩"]},{"id":1223,"word":"一饭千金","pinyin":"yī fàn qiān jīn","abbr":"yfqj","explanation":"比喻厚厚地报答对自己有恩的人。","source":{"text":"信至国，如所从食漂母，赐千金。","book":"《史记·淮阴侯列传》：“信钓于城下，诸漂母漂，有一母见信饥，饭信，竟漂数十日。”又"},"example":{"text":"马周道：“壁上诗句犹在，～岂可忘也。”","book":"明·凌濛初《二刻拍案惊奇》卷五"},"similar":["一饭之恩"],"usage":"作谓语、定语；指不忘恩","story":["秦朝末年，淮阴孤儿韩信靠在淮水边钓鱼为生，经常是钓不到鱼而要饿肚子，一个漂洗丝絮的老大娘见他可怜，经常把自己的饭分一半给他吃。韩信后来成为淮阴侯，特地找到当年的漂絮大娘，送给她一千金酬谢"]},{"id":1224,"word":"一饮一啄","pinyin":"yī yǐn yī zhuó","abbr":"yyyz","explanation":"饮：喝水；啄：鸟类吃食。原指鸟类要吃就吃，想喝就喝，生活自由自在。后也指人的饮食。","source":{"text":"泽雉十步一啄，百步一饮，不蕲畜乎樊中，神虽王，不善也。","book":"《庄子·养生主》"},"example":{"text":"是臣不负前期，变作妖魔，占了名山，掇他到洞府，与他配了一十三年夫妻。～，莫非前定。","book":"明·吴承恩《西游记》第三十一回"},"usage":"作宾语；指人的饮食"},{"id":1225,"word":"一饮而尽","pinyin":"yī yǐn ér jìn","abbr":"yyej","explanation":"饮：喝。一口气就喝完了。形容喝得非常爽快。","source":{"text":"鸨儿只道他敬客，却自家一饮而尽。","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"他像一个英雄人物一样昂着头，敞开衣襟，端起酒杯，～。","book":"欧阳山《苦斗》"},"similar":["一干而尽"],"usage":"作谓语、状语；指喝酒"},{"id":1226,"word":"一饱眼福","pinyin":"yī bǎo yǎn fú","abbr":"ybyf","explanation":"眼福：看到珍奇或美好事物的福份。形容看到了不易见到的美好事物。"},{"id":1227,"word":"一馈十起","pinyin":"yī kuì shí qǐ","abbr":"yksq","explanation":"馈：以食物送人，这里指吃饭。吃一顿饭要起来十次。形容事务繁忙。","source":{"text":"当此之时，一馈而十起，一沐而三捉发，以劳天下之民。","book":"《淮南子·氾论训》"},"example":{"text":"古人～，辄沐挥洗，良有以也。","book":"晋·常璩《华阳国志·公孙述刘二牧志》"},"similar":["日理万机"],"usage":"作谓语、定语；指事务繁忙","story":["大禹因为治水有功而成为夏朝的第一个君主，他告诉百姓要找他办事得敲五种不同的声音，即钟声、鼓声、磬声、召声和绎声。百姓纷纷去找他，他经常是“一馈而十起，一沐而三捉发，以劳天下之民。”热情地听取群众意见"]},{"id":1228,"word":"一马一鞍","pinyin":"yī mǎ yī ān","abbr":"ymya","explanation":"比喻一夫一妻，白头偕老。","source":{"text":"人各有志，不可相强。便是妇人女子的志向，也有个不同：有的讲究个女貌郎才，不辞非鸦非凤的，就有讲究个穿衣吃饭，只图一马一鞍的。","book":"清·文康《儿女英雄传》第四十回"},"example":{"text":"清·文康《儿女英雄传》第40回：“有的讲究个女貌郎才，不辞非鸦非凤的，就有讲究穿衣吃饭，只图～的。”"},"usage":"作宾语、定语；多用于比喻句"},{"id":1229,"word":"一马不跨两鞍","pinyin":"yī mǎ bù kuà liǎng ān","abbr":"ymbkla","explanation":"一匹马不能套两个马鞍。比喻一女不嫁二夫。","source":{"text":"我一马不跨两鞍。想男儿在日，曾两年匹配，却叫我改嫁别人，其实做不得。","book":"元·关汉卿《窦娥冤》第二折"},"example":{"text":"～的思想应该改一改了。"},"similar":["从一而终"],"usage":"作谓语、定语、分句；用于女性","story":["元朝时期，家贫如洗的书生孟志刚死后，妻子衣氏没有生育，叫木匠把棺木做大一些。她把家里的物品都送给邻居，祭奠完丈夫后，就向邻居表示一马不跨两鞍，死也要与他同棺共穴。第二天人们发现衣氏已经死在丈夫的棺木里"]},{"id":1230,"word":"一马不跨双鞍","pinyin":"yī mǎ bù kuà shuāng ān","abbr":"ymbksa","explanation":"一匹马不套两个辔，只套一个。比喻一女不嫁二夫，即从一而终。","source":{"text":"一马不鞁两鞍，单牛岂有双车并驾？","book":"《敦煌变文集·秋胡变文》"},"example":{"text":"道不得“～”，可怎生父在时曾许了我，父丧之后，母倒悔亲？","book":"元·王实甫《西厢记》第五本第三折"}},{"id":1231,"word":"一马不鞁两鞍","pinyin":"yī mǎ bù bèi liǎng ān","abbr":"ymbbla","explanation":"鞁：通“鞴”，把鞍辔等套在马上。一匹马不套两个辔，只套一个。比喻一女不嫁二夫，即从一而终。","source":{"text":"一马不鞁两鞍，单牛岂有双车并驾？","book":"《敦煌变文集·秋胡变文》"},"example":{"text":"我一车骨头半车肉，我～，双轮不辗四辙，守着福童孩儿，直到老死也不嫁人。","book":"元·岳伯川《铁拐李》第二折"}},{"id":1232,"word":"一马不鞴两鞍","pinyin":"yī mǎ bù bèi liǎng ān","abbr":"ymbbla","explanation":"鞴：把鞍辔等套在马上。一匹马不套两个辔，只套一个。比喻一女不嫁二夫，即从一而终。","source":{"text":"一马不鞁两鞍，单牛岂有双车并驾？","book":"《敦煌变文集·秋胡变文》"}},{"id":1233,"word":"一马不鞴双鞍","pinyin":"yī mǎ bù bèi shuāng ān","abbr":"ymbbsa","explanation":"鞴：把鞍辔等套在马上。一匹马不套两个辔，只套一个。比喻一女不嫁二夫，即从一而终。","source":{"text":"一马不鞁两鞍，单牛岂有双车并驾？","book":"《敦煌变文集·秋胡变文》"}},{"id":1234,"word":"一马平川","pinyin":"yī mǎ píng chuān","abbr":"ympc","explanation":"平川：地势平坦的地方。能够纵马疾驰的一片广阔平地。指广阔的平原。","source":{"text":"敌人围得甚紧，村外又是一马平川，敌人展开重火力，我们几次冲锋都被敌人压回来了。","book":"冯德英《苦菜花》第十章"},"example":{"text":"这里～，连座小山也没有。"},"similar":["一望无际","无边无际","漫无边际"],"opposite":["羊肠小道","崎岖不平","坑坑洼洼"],"usage":"作定语、宾语；指广阔的平原"},{"id":1235,"word":"一马当先","pinyin":"yī mǎ dāng xiān","abbr":"ymdx","explanation":"原指作战时策马冲锋在前。形容领先。也比喻工作走在群众前面，积极带头。","source":{"text":"即便勒兵列阵，一马当先，驰下山来，犹如天崩地塌之势。","book":"明·施耐庵《水浒传》第九十六回"},"example":{"text":"李自成看见敌人增加了援军，士气复振，就赶快把人马整顿一下，由他～，继续猛冲猛攻。","book":"姚雪垠《李自成》"},"similar":["遥遥领先","争先恐后"],"opposite":["后来居上","后起之秀","慢条斯理"],"usage":"作谓语、宾语、状语；指带头"},{"id":1236,"word":"一高二低","pinyin":"yī gāo èr dī","abbr":"yged","explanation":"①高低强弱或胜负输赢。②指意外的变故。","source":{"text":"他决心要在精神上，要在社会的面前，和高明楼他们比个一高二低！","book":"路遥《人生》上篇第二章"},"example":{"text":"你该想想，你有个～，你这些娃娃咋个办嘛？","book":"艾芜《石青嫂子》"},"usage":"作宾语、定语；用于书面语"},{"id":1237,"word":"一鳞一爪","pinyin":"yī lín yī zhǎo","abbr":"ylyz","explanation":"原指龙在云中，东露一鳞，西露半爪，看不到它的全貌。比喻零星片段的事物。","source":{"text":"三年中作变律诗九首，上广州李帅，其文意长于讽刺，亦有陈拾遗一鳞半甲。","book":"唐·高仲武《中兴闲气集·苏涣》"},"example":{"text":"批评陶诗，用的正是现在的语言，～，虽然不是全韵，表现着陶诗给予现代的我们的影像。","book":"朱自清《日常生活的诗》"},"similar":["一鳞半爪"],"usage":"作宾语、定语；指残缺不全"},{"id":1238,"word":"一鳞半爪","pinyin":"yī lín bàn zhǎo","abbr":"ylbz","explanation":"原指龙在云中，东露一鳞，西露半爪，看不到它的全貌。比喻零星片段的事物。","source":{"text":"三年中作变律诗九首，上广州李帅，其文意长于讽刺，亦有陈拾遗一鳞半甲。","book":"唐·高仲武《中兴闲气集·苏涣》"},"example":{"text":"身后著作，年久多散佚，余遍为蒐罗，仅得诗三帙，丛残不具首尾，于诸集殆不过～耳。","book":"清·叶廷琯《鸥波渔话·莪洲公诗》"},"similar":["支离破碎","残缺不全"],"opposite":["完美无缺","十全十美"],"usage":"作宾语、定语；指残缺不全","story":["唐朝时期，白居易请诗人元稹、刘禹锡、韦楚到家里做客，建议赋诗饮酒，以《金陵怀古》为题作诗。刘禹锡因官场不得志就作一首《西寒山怀古》，怀古叹今，意味深长。白居易赞叹道：“我们四人下海探宝，你得龙珠，我们只得一鳞半爪而已。”"]},{"id":1239,"word":"一鳞半甲","pinyin":"yī lín bàn jiǎ","abbr":"ylbj","explanation":"原指龙在云中，东露一鳞，西露半爪，看不到它的全貌。比喻零星片段的事物。","source":{"text":"三年中作变律诗九首，上广州李帅，其文意长于讽刺，亦有陈拾遗一鳞半甲。","book":"唐·高仲武《中兴闲气集·苏涣》"},"example":{"text":"唐人以为长于讽刺，得陈拾遗～。","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵》"},"similar":["一鳞半爪","一鳞片爪","一鳞片甲"],"usage":"作宾语、定语；指片面的东西"},{"id":1240,"word":"一鳞只爪","pinyin":"yī lín zhī zhǎo","abbr":"ylzz","explanation":"原指龙在云中，东露一鳞，西露半爪，看不到它的全貌。比喻零星片段的事物。","source":{"text":"三年中作变律诗九首，上广州李帅，其文意长于讽刺，亦有陈拾遗一鳞半甲。","book":"唐·高仲武《中兴闲气集·苏涣》"}},{"id":1241,"word":"一鳞片爪","pinyin":"yī lín piàn zhǎo","abbr":"ylpz","explanation":"比喻零星片段的事物。同“一鳞一爪”。","source":{"text":"现在重读自己这一鳞片爪时，就愈益感觉到，对那个暴风雨前的黑暗时代，我们实在太需要宏伟的史诗了。","book":"《〈王西彦小说选〉自序》"},"similar":["一鳞片甲","一鳞半甲"],"usage":"作宾语、定语；指片面的东西"},{"id":1242,"word":"一鳞片甲","pinyin":"yī lín piàn jiǎ","abbr":"ylpj","explanation":"比喻零星片段的事物。同“一鳞半甲”。","source":{"text":"呜呼公已骑箕去，故纸残零亦何有。一鳞片甲乃幸存，其字其诗遂不朽。","book":"清·赵翼《题黄陶庵手书诗册》诗"},"similar":["一鳞半甲","一鳞片爪"],"usage":"作宾语、定语；指片面的东西"},{"id":1243,"word":"一鸟入林，百鸟压音","pinyin":"yī niǎo rù lín，bǎi niǎo yā yīn","abbr":"ynrlbnyy","explanation":"比喻威势压倒众人。","example":{"text":"我那公爹咱家老爷子，真是心有天地宽，眼看千里远，早就替你相中了我这个～的好媳妇。","book":"刘绍棠《水边人的哀乐故事》十"}},{"id":1244,"word":"一鸣惊人","pinyin":"yī míng jīng rén","abbr":"ymjr","explanation":"鸣：鸟叫。一叫就使人震惊。比喻平时没有突出的表现，一下子做出惊人的成绩。","source":{"text":"此鸟不飞则已，一飞冲天；不鸣则已，一鸣惊人。","book":"《韩非子·喻老》：“虽无飞，飞必冲天；虽无鸣，鸣必惊人。”《史记·滑稽列传》"},"example":{"text":"～，实在是出乎意外。","book":"郭沫若《革命春秋·创造十年续篇》"},"similar":["一举成名","一步登天","名满天下"],"opposite":["身败名裂","臭名远扬","丢人现眼"],"usage":"作谓语、宾语、定语；用于人的表现","story":["齐威王沉湎酒色，三年不理朝政，国内混乱不堪。才子淳于髡知道齐威王爱猜谜语，就觐见说王宫里住着一只三年不飞不鸣的鸟。齐威王说：“此鸟不飞则已，一飞冲天；不鸣则已，一鸣惊人。”从此齐威王勤于朝政，励精图治，国威大振"]},{"id":1245,"word":"一麾出守","pinyin":"yī huī chū shǒu","abbr":"yhcs","explanation":"原指阮咸受排挤，而出为始平太守。后指京官出任地方官。","source":{"text":"屡荐不入官，一麾乃出守。","book":"南朝·宋·颜延之《五君咏》"},"example":{"text":"五载司刑，～。","book":"清·钱谦益《河南按察司副使岳骏声授中宪大夫制》"},"usage":"作谓语；指京官出任地方官"},{"id":1246,"word":"一鼓一板","pinyin":"yī gǔ yī bǎn","abbr":"ygyb","explanation":"鼓、板都是演唱时用以调和节奏的，两者不可分离，因以喻互相帮衬。","source":{"text":"公子身边最讲得话、像心称意的，有两个门客……大小事多要串通得这两个，方才弄得成。这两个一鼓一板，只要公子出脱得些，大家有味。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"usage":"作谓语、状语；用于书面语"},{"id":1247,"word":"一鼓作气","pinyin":"yī gǔ zuò qì","abbr":"ygzq","explanation":"一鼓：第一次击鼓；作：振作；气：勇气。第一次击鼓时士气振奋。比喻趁劲头大的时候鼓起干劲，一口气把工作做完。","source":{"text":"夫战，勇气也。一鼓作气，再而衰，三而竭。","book":"《左传·庄公十年》"},"example":{"text":"初听这话，还是～的。","book":"清·李宝嘉《官场现形记》第四十八回"},"similar":["一气呵成","趁热打铁"],"opposite":["一败如水","一败涂地","偃旗息鼓"],"usage":"作谓语、定语；指一往直前","story":["春秋时期齐国恃强凌弱攻打鲁国，鲁庄公率军迎敌，两军相遇，齐军擂起战鼓，而鲁军在曹刿的带领下没有擂鼓。齐军第三次擂鼓时士气已经低落，鲁军才第一次擂鼓。鲁军靠的就是一鼓作气的士气以少胜多，打败了齐军"]},{"id":1248,"word":"一鼓而下","pinyin":"yī gǔ ér xià","abbr":"ygex","explanation":"趁形势有利或士气高昂时，一举打跨敌人或攻占城市。","source":{"text":"杨景凭手下将士，马到成功，觑贼兵一鼓而下也。","book":"明·无名氏《活拿萧天佐》第一折"},"example":{"text":"清·贪梦道人《彭公案》第64回：“须先派一人到巡抚衙门去调兵，就在这七夕之日，可以～。”"},"usage":"作谓语、状语；用于处事或军事"},{"id":1249,"word":"一鼓而擒","pinyin":"yī gǔ ér qín","abbr":"ygeq","explanation":"鼓：擂战鼓；擒：擒住。作战开始时，擂第一通战鼓就把敌人擒获了。比喻速战速决。","source":{"text":"今夜曹仁必来劫寨。吾却于四下埋伏以应之，则曹仁可一鼓而擒也。","book":"明·罗贯中《三国演义》第五十一回"},"example":{"text":"我已算在这里了，天来兄弟，难得同时在家，倘使冒冒失失的去了，不能～，岂不是可惜！","book":"清·吴趼人《九命奇冤》第十五回"}},{"id":1250,"word":"一鼻子灰","pinyin":"yī bí zǐ huī","abbr":"ybzh","explanation":"比喻碰壁或受斥责。","source":{"text":"幸而平姐姐在这里，没得臊一鼻子灰，趁早知会他们去。","book":"《红楼梦》五五回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第106回：“帐房先生碰了～，只得回去告诉龙光。”"},"usage":"作宾语；常用在“碰了”之后"},{"id":1251,"word":"一鼻孔出气","pinyin":"yī bí kǒng chū qì","abbr":"ybkcq","explanation":"同一个鼻孔出气。比喻立场、观点、主张完全一致。","source":{"text":"那晁住媳妇就是合珍哥一个鼻孔出气，也没有这等心意相投。","book":"清·西周生《醒世姻缘传》第六回"},"example":{"text":"新月博士常发议论，都和官僚～，南方已无人信之。（鲁迅《书信集·致曹靖华》）"},"similar":["一路货色"],"usage":"作谓语；指主张完全一致"},{"id":1252,"word":"一鼻孔通气","pinyin":"yī bí kǒng tōng qì","abbr":"ybktq","explanation":"同一个鼻孔出气。比喻立场、观点、主张完全一致。","source":{"text":"你六娘当时和他一个鼻子眼儿里出气，什么事儿来家不告诉我。","book":"明·兰陵笑笑生《金瓶梅词话》第二十三回"}},{"id":1253,"word":"一齐二整","pinyin":"yī qí èr zhěng","abbr":"yqez","explanation":"形容穿戴整齐的样子。","source":{"text":"作速走，不必一齐二整。","book":"清·李绿园《歧路灯》第一百三回"},"similar":["齐齐整整"],"usage":"作定语、状语；用于书面语"},{"id":1254,"word":"一齐众咻","pinyin":"yī qí zhòng xiū","abbr":"yqzx","explanation":"咻：喧闹。一个人教导，众人吵闹干扰。比喻学习的环境不好，干扰很大。","source":{"text":"一齐人傅之，众楚人咻之，虽日挞而求齐也，不可得矣。","book":"《孟子·滕文公下》"}},{"id":1255,"word":"一齐众楚","pinyin":"yī qí zhòng chǔ","abbr":"yqzc","explanation":"犹一傅众咻。比喻不能有什么成就。","source":{"text":"绝学之馀，求道者少，一齐众楚，最易摇夺。","book":"明·王守仁《与辰中诸生书》"},"example":{"text":"明·王守仁《与辰中诸生书》：“绝学之余，求道者少，～，最易摇夺。”"},"similar":["一傅众咻"],"usage":"作宾语、定语；用于比喻句","story":["战国时期宋国大臣戴不胜向孟子请教如何使宋国国君学好为国家多办一些好事。孟子打比方说如果让楚国大夫学齐国话就应该请齐国的老师，而且把他置身于齐国的环境中去，不能给他一个一傅众咻的环境，那样就是想学也学不好"]},{"id":1256,"word":"一齐天下","pinyin":"yī qí tiān xià","abbr":"yqtx","explanation":"齐：治理；天下：指全国。指统一全国。","source":{"text":"今陛下临制海内，一齐天下，口虽未言，声疾雷电，令虽未发，行化如神。","book":"汉·荀悦《汉纪·武帝纪三》"},"example":{"text":"棰笞暴国，～，莫之能倾，是大儒之勋。","book":"汉·韩婴《韩诗外传》卷五"},"similar":["一统天下"],"usage":"作谓语、定语、宾语；指统一国家"},{"id":1257,"word":"一龙一猪","pinyin":"yī lóng yī zhū","abbr":"ylyz","explanation":"一是龙，一是猪。比喻同时的两个人，高下判别极大。","source":{"text":"两家各生子，提孩巧相如。少长聚嬉戏，不殊同队鱼。三十骨骼成，乃一龙一猪。","book":"唐·韩愈《符读书城南》诗"},"similar":["天壤之别"],"usage":"作宾语、定语；指悬殊太大","story":["唐代文学家韩愈给儿子韩符写了一首诗勉励他用功读书，诗中写道：有两户人家各生了一个儿子，长相十分相似，经常在一块儿玩耍，到了12岁左右，渐渐发现他们有了差异，30岁时一个有了成就像呼风唤雨的龙，一个却像蠢笨无能的猪，简直是天壤之别"]},{"id":1258,"word":"一龙一蛇","pinyin":"yī lóng yī shé","abbr":"ylys","explanation":"忽而像龙的出现，忽而像蛇的蜇伏变化多端。比喻人的处藏或出或处，或显或隐，随着情况的不同而变更。","source":{"text":"一龙一蛇，一日五化之谓周。","book":"《庄子·山木》：“无誉无訾，一龙一蛇，与时俱化。”《管子·枢言》"},"example":{"text":"～，与道翱翔，与时变化，夫岂守一节哉？（《后汉书·冯衍传》）"},"similar":["或隐或显"],"usage":"作宾语、定语；指变化莫测"},{"id":1259,"word":"一龙九种","pinyin":"yī lóng jiǔ zhǒng","abbr":"yljz","explanation":"比喻各人的品质、爱好都不相同。","source":{"text":"俗语说的好，‘一龙九种，种种各别’，未免人多了就有龙蛇混杂。","book":"清·曹雪芹《红楼梦》第九回"},"example":{"text":"俗语说的好：“～，种种各别”，未免人多了就有龙蛇混杂，下流人物在内。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["龙生九子"],"usage":"作宾语、定语；用于书面语"},{"id":1260,"word":"一龙九种，种种有别","pinyin":"yī lóng jiǔ zhǒng，zhǒng zhǒng yǒu bié","abbr":"yljzzzyb","explanation":"传说龙生九子不成龙，各有各的爱好。比喻各人的品质、爱好都不相同。","source":{"text":"俗传龙生九子，不成龙，各有所好。","book":"明·杨慎《升庵外集》"}},{"id":1261,"word":"一龟一鹤","pinyin":"yī guī yī hè","abbr":"ygyh","explanation":"用以比喻长寿。","source":{"text":"公衮沙堤，归来无恙，有西湖花柳。更借当年，一龟一鹤，伴千秋寿。","book":"宋·李曾伯《醉蓬莱·乙酉寿蜀帅》词"}},{"id":1262,"word":"丁一卯二","pinyin":"dīng yī mǎo èr","abbr":"dyme","explanation":"丁：通“钉”，这里指榫头；卯：器物上接榫头的孔眼。丁卯合位，一丝不差。形容确实、牢靠。","source":{"text":"要说个丁一卯二，不许你差三错四。","book":"元·无名氏《抱妆盒》第三折"},"example":{"text":"相公说的～的道：有姓王的施主，舍在寺中，以后来取，你把假的还了他，真的自藏了。","book":"明·凌濛初《二刻拍案惊奇》卷三十六"},"similar":["丁是丁，卯是卯"],"opposite":["藕断丝连"],"usage":"作定语、状语、宾语；指确实"},{"id":1263,"word":"丁一确二","pinyin":"dīng yī què èr","abbr":"dyqe","explanation":"明明白白，确确实实。","source":{"text":"修辞便立诚，如今人持择言语，丁一确二，一字是一字，一句是一句，便是立诚。","book":"《朱子语类·易三》"},"example":{"text":"知县见他～说着，有些信将起来道：“果有这等事！不要冤屈了平人。”","book":"明·凌濛初《二刻拍案惊奇》卷二十五"},"similar":["丁一卯二"],"usage":"作谓语、定语；指明明白白，确确实实"},{"id":1264,"word":"丁丁列列","pinyin":"dīng dīng liè liè","abbr":"ddll","explanation":"形容说话吞吞吐吐。","source":{"text":"俺丁丁列列，吐出在丁香舌。","book":"明·汤显祖《牡丹亭·冥誓》"}},{"id":1265,"word":"丁丁当当","pinyin":"dīng dīng dāng dāng","abbr":"dddd","explanation":"象声词。也形容性格刚强。","source":{"text":"我是个拳头上站的人，胳膊上走的马，不带头巾男子汉，丁丁当当的老婆。","book":"元·李文蔚《燕青捕鱼》第三折"},"example":{"text":"这姑娘便立起身来，左手取了梨花简，夹在指头缝里，～的敲。","book":"清·刘鹗《老残游记》第二回"}},{"id":1266,"word":"丁公凿井","pinyin":"dīng gōng záo jǐng","abbr":"dgzj","explanation":"比喻传来传去而失真。","source":{"text":"俗传言曰，丁公凿井，得一人于井中。夫人生于人，非生于土也。","book":"汉·王充《论衡·书虚》"},"example":{"text":"～的成语典故也就是穿井得人的典故。"},"similar":["穿井得人"],"usage":"作宾语、定语；比喻语言传来传去而失真","story":["春秋时期，宋国人丁某在自家院子里开凿一口水井，由于他本人参与凿井加上采用新的方法，从而节省一个劳动力，他事后对别人说：“吾穿井得一人”，别人没有明白他的意思，传来传去，都以为他从井中挖出一人"]},{"id":1267,"word":"丁娘十索","pinyin":"dīng niáng shí suǒ","abbr":"dnss","explanation":"丁娘：隋朝歌妓；索：索取。原指隋代乐妓丁六娘所作的乐府诗，每首末句有“从郎索花烛”等语，本十首。后用以指妓女的需索。","source":{"text":"七香遥望阡连陌，十索愁看料共脂。","book":"清·孙枝蔚《无题次彭骏孙王贻上韵》"}},{"id":1268,"word":"丁子有尾","pinyin":"dīng zǐ yǒu wěi","abbr":"dzyw","explanation":"丁子：蝌蚪。指青蛙或蟾蜍幼时还有尾巴。古代名家诡辩之词。","source":{"text":"马有卵，丁子有尾，火不热。","book":"《庄子·天下》"}},{"id":1269,"word":"丁宁告戒","pinyin":"dīng níng gào jiè","abbr":"dngj","explanation":"丁宁；再三嘱咐。指一再嘱咐必须引起警觉注意。","source":{"text":"吾累次丁宁告戒：街亭是吾根本。汝以全家之命，领此重任。","book":"明·罗贯中《三国演义》第96回"},"usage":"作谓语、宾语；用于说话"},{"id":1270,"word":"丁宁周至","pinyin":"dīng níng zhōu zhì","abbr":"dnzz","explanation":"丁宁：嘱咐，告诫；周至：周到，细致。再三细致地嘱咐。形容办事谨慎周到。","source":{"text":"论者或怪亮文彩不艳，而过于丁宁周至。","book":"《三国志·蜀志·诸葛亮传》"},"usage":"作谓语、定语；用于处事"},{"id":1271,"word":"丁是丁，卯是卯","pinyin":"dīng shì dīng，mǎo shì mǎo","abbr":"dsdmsm","explanation":"某个钉子一定要安在相应的铆处，不能有差错。形容对事认真，毫不含糊。","source":{"text":"我看你利害，明儿有了事，我也‘丁是丁，卯是卯’的，你也别抱怨。","book":"清·曹雪芹《红楼梦》第四十三回"},"example":{"text":"银钱大事，再比小侄年轻的人，他也会～的。","book":"清·李宝嘉《官场现形记》第四十三回"},"similar":["丁一卯二"],"opposite":["藕断丝连"],"usage":"作分句；指办事认真","story":["贾母疼爱王熙凤，说她管家辛苦了，让大家凑银子为她过生日以示感谢。于是全家上下纷纷凑钱交到王熙凤处。尤氏把银子交给王熙凤，王熙凤见少了李纨的，就开玩笑地对尤氏说要丁是丁卯是卯地办事，王熙凤也借机免了平儿的银子"]},{"id":1272,"word":"丁真楷草","pinyin":"dīng zhēn kǎi cǎo","abbr":"dzkc","explanation":"丁：丁觇；楷：智楷。丁觇的隶书，智楷的草书。赞美人的书法好。","source":{"text":"智永章草，草书入妙，隶入能。兄智楷亦工草，丁觇亦善隶书，时人云：‘丁真楷草’。","book":"唐·张彦远《法书要录》第八卷引张怀蠸《书断·中·妙品》"},"usage":"作宾语、定语；用于书法"},{"id":1273,"word":"丁真永草","pinyin":"dīng zhēn yǒng cǎo","abbr":"dzyc","explanation":"南朝梁丁觇善隶书，陈智永善草书，当时人称“丁真永草”。后用以赞人书法之工妙。","source":{"text":"智永章草及草书入妙……丁觇亦善隶书，时人云：丁真永草。","book":"唐·张怀瓘《书断》"}},{"id":1274,"word":"七七八八","pinyin":"qī qī bā bā","abbr":"qqbb","explanation":"①犹言差不多。②犹言零零碎碎，各式各样。","source":{"text":"他于是就七七八八给润叶说了老半天，除过关于将来生育方面的困难外，他主要阐述了这门亲事的好处。","book":"路遥《平凡的世界》第二卷第39章"},"example":{"text":"请把这些～收拾整齐。"},"usage":"作主语、宾语、定语；用于口语"},{"id":1275,"word":"七上八下","pinyin":"qī shàng bā xià","abbr":"qsbx","explanation":"形容心里慌乱不安。","source":{"text":"那胡正卿心头十五个吊桶打水，七上八下。","book":"明·施耐庵《水浒全传》第二十六回"},"example":{"text":"他就感觉得～，心里老不自在。","book":"沙汀《烦恼》"},"similar":["忐忑不安","心神不定"],"opposite":["心安理得","若无其事"],"usage":"作谓语、定语、状语；形容心里慌乱不安","story":["潘金莲与西门庆通奸，毒死了武大郎，武松向官府告状，官府置之不理。武松决定请街坊邻居作证亲审潘金莲。吏员出身的胡正卿在应邀之列，武松不许他中途离开，胡正卿心里十五个吊桶打水，七上八下的。武松审问完毕，亲手血刃了潘金莲"]},{"id":1276,"word":"七上八落","pinyin":"qī shàng bā luò","abbr":"qsbl","explanation":"形容心神不定或慌乱不安。","source":{"text":"洪太尉倒在树根底下，唬的三十六个牙齿捉对儿厮打，那心头一似十五个吊桶，七上八落的响，浑身却如重风麻木，两腿一似斗败公鸡，口里连声叫苦。","book":"明·施耐庵《水浒传》第一回"},"example":{"text":"那心儿里就是十五六个吊桶打水，～的跳一个不止。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"similar":["七上八下"],"usage":"作谓语、状语、定语；指心神不定"},{"id":1277,"word":"七了八当","pinyin":"qī le bā dāng","abbr":"qlbd","explanation":"形容十分妥帖。","source":{"text":"将昨夜剩下的米煮的早饭，拂拭净了桌椅。忙忙碌碌做了一朝，七了八当。","book":"明·凌濛初《初刻拍案惊奇》第16卷"},"similar":["千了百当"],"usage":"作定语、状语；用于口语"},{"id":1278,"word":"七事八事","pinyin":"qī shì bā shì","abbr":"qsbs","explanation":"形容事情多而杂乱。","source":{"text":"刚打发出去，家中正七事八事，听见薛嫂儿来说此话，唬的慌了手脚，连忙雇轿子，打发大姐家去。","book":"明·兰陵笑笑生《金瓶梅词话》第九十一回"},"example":{"text":"先帝爷在时，宫里三天两头丢砖打瓦～，夜里闹鬼不安静。","book":"二月河《乾隆皇帝》二十六"},"usage":"作宾语；指事情多而杂乱"},{"id":1279,"word":"七倒八歪","pinyin":"qī dǎo bā wāi","abbr":"qdbw","explanation":"指十分凌乱不整齐。","example":{"text":"这些树被台风吹得～的。"},"similar":["东歪西倒","七歪八倒"],"opposite":["整整齐齐"],"usage":"作谓语、定语、状语；指凌乱"},{"id":1280,"word":"七停八当","pinyin":"qī tíng bā dàng","abbr":"qtbd","explanation":"形容各个方面都照顾得很周到，料理得很妥当。","source":{"text":"次日清早，又是那婆娘先起身来，烧热了汤，将昨夜剩下米煮了早饭，拂拭净了椅桌。力力碌碌，做了一朝，七了八当。","book":"明·凌濛初《初刻拍案惊奇》卷十六"},"example":{"text":"活鬼随同众鬼，，将许多家什物，忙忙的搬回家去，幸亏人多手杂，一霎时都已～。","book":"清·张南庄《何典》第二回"}},{"id":1281,"word":"七十二变","pinyin":"qī shí èr biàn","abbr":"qseb","explanation":"变化多端的策略、手法和方法。","source":{"text":"神话中的许多变化，例如《山海经》中所说的‘夸父追日’，《淮南子》中所说的‘羿射九日’，《西游记》中所说的孙悟空七十二变……","book":"毛泽东《矛盾论》"},"example":{"text":"孙悟空有～的本领，你比他更厉害。"},"similar":["变化多端"],"opposite":["一成不变"],"usage":"作宾语、定语；指变化多端"},{"id":1282,"word":"七十二变，本相难变","pinyin":"qī shí èr biàn，běn xiàng bán biàn","abbr":"qsebbxnb","explanation":"即使有七十二个变化，但其原来的面目却难以改变。比喻事物虽然千变万化，但其本质却难以改变。","source":{"text":"明·吴承恩《西游记》载：孙司空会七十二变，只有尾巴变不了。"}},{"id":1283,"word":"七十二行","pinyin":"qī shí èr háng","abbr":"qseh","explanation":"泛指各行各业。","source":{"text":"有个学校真奇怪，小孩自动教小孩。七十二行皆先生，先生不在学如在。","book":"陶行知《自动学校贺诗》"},"example":{"text":"～，行行出状元。"},"similar":["各行各业","三十六行"],"usage":"作主语、宾语、定语；指各行各业"},{"id":1284,"word":"七口八嘴","pinyin":"qī kǒu bā zuǐ","abbr":"qkbz","explanation":"形容人多口杂。同“七嘴八舌”。","source":{"text":"既不羞自己怯弱无能，也不提暴徒如何惩办，只是七口八嘴，议论他死了没有，受污没有，死了如何好，活着如何不好。","book":"鲁迅《坟·我之节烈观》"},"similar":["七嘴八舌"],"opposite":["鸦雀无声"],"usage":"作宾语、状语；形容人"},{"id":1285,"word":"七嘴八张","pinyin":"qī zuǐ bā zhāng","abbr":"qzbz","explanation":"形容人多语杂。","source":{"text":"众官员一拥而前，七嘴八张的，都问道：‘世子何在？’","book":"《东周列国志》第三二回"},"similar":["七张八嘴","人多嘴杂"],"usage":"作谓语、定语、状语；用于书面语"},{"id":1286,"word":"七嘴八舌","pinyin":"qī zuǐ bā shé","abbr":"qzbs","explanation":"形容人多口杂。","source":{"text":"众人正跑得有兴头上，忽然铁公子拦住，便七嘴八舌地乱嚷。","book":"明·名教中人《好俅传》第五回"},"example":{"text":"故晋大夫～，冷讥热嘲，皆由于心之大公也。","book":"清·袁枚《牍外余言》"},"similar":["七言八语","沸沸扬扬","众说纷纭"],"opposite":["沉默寡言","鸦雀无声"],"usage":"作宾语、状语；形容人"},{"id":1287,"word":"七夕乞巧","pinyin":"qī xī qǐ qiǎo","abbr":"qxqq","explanation":"乞：求；巧：技艺。七月七日夜，妇女向织女星乞求技巧。","source":{"text":"七月七日为牵牛织女聚会之夜。是夕，人家妇女结彩缕，穿七孔针，或以金银鍮石为针，陈瓜果于庭中以乞巧。","book":"南朝·梁·宗懔《荆楚岁时记》"}},{"id":1288,"word":"七大八小","pinyin":"qī dà bā xiǎo","abbr":"qdbx","explanation":"①大小不一。②零落的样子。③妻妾众多。","source":{"text":"这十二钗说是金陵的，怎么家里这些人如今七大八小的就剩了这几个。","book":"清·刘鹗《老残游记》第十回：“有几张树根的坐具，却是七大八小的不匀。”清·曹雪芹《红楼梦》第一百八回"},"example":{"text":"狄亲家房中又没有～，膝下又没有三窩两块。","book":"清·西周生《醒世姻缘传》第四十四回"},"similar":["参差不齐"],"opposite":["如出一辙"],"usage":"作定语；指大小不一"},{"id":1289,"word":"七子八婿","pinyin":"qī zǐ bā xù","abbr":"qzbx","explanation":"形容子、婿众多。","source":{"text":"《旧唐书·郭子仪传》载：唐郭子仪有子八人，婿七人，皆朝廷重官。"},"example":{"text":"我家中又没有～，只有一个孩儿，如何去得？","book":"明·高明《琵琶记·蔡公逼试》"},"similar":["七男八婿"],"usage":"作宾语、定语；指子女"},{"id":1290,"word":"七孔八洞","pinyin":"qī kǒng bā dòng","abbr":"qkbd","explanation":"孔：小洞。窟窿很多，十分破烂的样子。","example":{"text":"他的衣服经常是～的。"},"usage":"作定语、状语；指破烂的样子"},{"id":1291,"word":"七孔生烟","pinyin":"qī kǒng shēng yān","abbr":"qksy","explanation":"形容气愤到极点。同“七窍生烟”。","source":{"text":"袁太守竟教训起他来，气得七孔生烟，双眉倒竖。","book":"清·张春帆《宦海》第八回"},"example":{"text":"她气得～，把报纸撕了粉碎"},"similar":["七窍生烟"],"usage":"作谓语、状语；形容气愤或焦急"},{"id":1292,"word":"七尺之躯","pinyin":"qī chǐ zhī qū","abbr":"qczq","explanation":"躯：身体。成年男子的身躯。","source":{"text":"口耳之间，则四寸耳，偈足以美七尺之躯哉？","book":"战国·赵·荀况《荀子·劝学》"},"example":{"text":"丈夫～，其所学者，独立手哉？","book":"明·宋濂《文原》"},"similar":["五尺男儿"],"usage":"作主语、宾语；用于书面语","story":["战国时期赵国大思想家荀子特别注重学习，他对学习有独到看法，他认为学习必须及时消化，然后才能得其精华，他举例说如果刚听到别人的一些谈话，不加思考与分析，就立即夸夸其谈说出去，就不能用学问来修养这七尺之躯"]},{"id":1293,"word":"七平八稳","pinyin":"qī píng bā wěn","abbr":"qpbw","explanation":"十分稳定，物体处于平衡状态。","example":{"text":"这件物品处于～的状态。"},"similar":["四平八稳"],"usage":"作谓语、定语；指处于平衡状态"},{"id":1294,"word":"七年之病，求三年之艾","pinyin":"qī nián zhī bìng，qiú sān nián zhī ài","abbr":"qnzbqsnza","explanation":"病久了才去寻找治这种病的干艾叶。比喻凡事要平时准备，事到临头再想办法就来不及。","source":{"text":"今之欲王者，犹七年之病，求三年之艾也。","book":"战国·邹·孟轲《孟子·离娄上》"},"example":{"text":"你这样做等于～。"},"similar":["平时不烧香，急时抱佛脚"],"usage":"作宾语、定语、分句；指事到临头再想办法","story":["战国时期，孟子就夏桀和殷纣的灭亡有如下看法：桀与纣失天下就是因为他们丧失了百姓的拥护，如果有君主推行仁政就能统一天下，现今有人想一统天下就像得了7年的病去求蓄积3年以上的艾草灸治一样，不立志施行仁政，那么一辈子也不能统一"]},{"id":1295,"word":"七开八得","pinyin":"qī kāi bā dé","abbr":"qkbd","explanation":"形容反反复复，十分周备。","source":{"text":"我找二嘎子去啦，找了七开八得，也找不着他！","book":"老舍《龙须沟》第三幕"},"example":{"text":"他颠算了～，也觉得她的话有理"},"usage":"作宾语、定语；用于口语"},{"id":1296,"word":"七张八嘴","pinyin":"qī zhāng bā zuǐ","abbr":"qzbz","explanation":"形容人多语杂。同“七嘴八张”。","source":{"text":"岳大爷见兄弟们七张八嘴，心中暗想：‘我若不去，众兄弟把我看轻了，只道我没有胆量了。’","book":"清·钱彩《说岳全传》第六回"},"example":{"text":"几个小孩从路的一端奔回来，～地喊着。","book":"夏衍《秋瑾传》"},"similar":["七嘴八张","人多嘴杂","七嘴八舌"],"usage":"作谓语、定语、状语；用于书面语"},{"id":1297,"word":"七弯八拐","pinyin":"qī wān bā guǎi","abbr":"qwbg","explanation":"多处弯曲，不断转变方向。也形容做事不直截了当。同“七湾八拐”。","source":{"text":"过了一岗又一岗，一坡又一坡，上上下下，七弯八拐，又走了十多里才真正到了狼牙山脚下、我们要住下的村子。","book":"《十月》1981年第1期"},"similar":["七湾八拐","七弯八曲"],"usage":"作谓语、定语；指曲折不直"},{"id":1298,"word":"七情六欲","pinyin":"qī qíng liù yù","abbr":"qqly","explanation":"泛指人的喜、怒、哀、乐和嗜欲等。","source":{"text":"七情：喜怒哀惧爱恶欲。六欲：生死耳目口鼻。","book":"《礼记·礼运》"},"example":{"text":"捐去三纲五常，绝去～，费其半菽，如失金珠，拔其一毛，有关痛痒。","book":"清·钱泳《履园丛话·臆论·五福》"},"similar":["五情六欲"],"opposite":["四大皆空"],"usage":"作主语、宾语；形容人的感情","story":["七情按《礼记》的观点指喜、怒、哀、惧、爱、恶、欲；而按佛教的说法则是喜、怒、忧、惧、爱、憎、欲。六欲按《吕氏春秋》指由生、死、耳、目、口、鼻所生的欲望；佛教认为是色欲、形貌欲、威仪姿态欲、言语声音欲、细滑欲、人想欲"]},{"id":1299,"word":"七慌八乱","pinyin":"qī huāng bā luàn","abbr":"qhbl","explanation":"形容非常慌张混乱。","source":{"text":"虽然养娘奶子伏侍，到底像小鸡失了母鸡，七慌八乱，啼啼哭哭。","book":"明·冯梦龙《醒世恒言》第27章"},"usage":"作谓语、定语、状语；用于处事"},{"id":1300,"word":"七手八脚","pinyin":"qī shǒu bā jiǎo","abbr":"qsbj","explanation":"形容人多手杂，动作纷乱。","source":{"text":"上堂七手八脚，三头两面，耳听不闻，眼觑不见，苦乐逆顺，打成一片。","book":"宋·释普济《五灯会元》卷二十"},"example":{"text":"众人～将他扛抬了出来。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["手忙脚乱","手足无措"],"opposite":["有条不紊","从容不迫"],"usage":"作状语；形容人多手杂，动作纷乱"},{"id":1301,"word":"七扭八拗","pinyin":"qī niǔ bā ào","abbr":"qnba","explanation":"拗：拗口。形容十分别扭不通顺。","source":{"text":"拿起读了两遍，虽不深知其味，念来却十分顺口，不似自家的七扭八拗。","book":"清·荑荻散人《玉娇梨》第六回"},"usage":"作定语、状语；用于口语"},{"id":1302,"word":"七扭八歪","pinyin":"qī niǔ bā wāi","abbr":"qnbw","explanation":"形容不端正。","example":{"text":"潘大年站在那里，两只手不知该放在哪里才好。一种发窘的受宠若惊的笑把五官扯得～。","book":"冯骥才《斗寒图》二"},"usage":"作谓语、定语、状语；用于口语"},{"id":1303,"word":"七折八扣","pinyin":"qī zhé bā kòu","abbr":"qzbk","explanation":"比喻折扣很大，减掉了很多。","source":{"text":"这里的客店钱，就拿两块洋钱出来，由得他七折八扣的勉强用了。","book":"清·吴趼人《二十年目睹之怪现状》第108回"},"example":{"text":"其他各部，都是～，还经年累月的，不得发放。","book":"蔡东藩《民国通俗演义》第127回"},"similar":["东折西扣"],"opposite":["不折不扣"],"usage":"作状语；指折扣多"},{"id":1304,"word":"七担八挪","pinyin":"qī dān bā nuó","abbr":"qdbn","explanation":"指一再耽搁拖延。","source":{"text":"因与众人在吴道官房里算帐，七担八挪缠到这咱晚。","book":"明·兰陵笑笑生《金瓶梅词话》第14回"},"usage":"作定语、状语；用于处事"},{"id":1305,"word":"七拉八扯","pinyin":"qī lā bā chě","abbr":"qlbc","explanation":"①指漫无边际地闲谈。②指乱拉来一大堆人。","source":{"text":"我便和他七拉八扯的先谈起来，喜得他谈锋极好，和他谈谈，倒大可以解闷。","book":"清·吴趼人《二十年目睹之怪现状》第八二回"},"example":{"text":"此刻七拉八扯的，我这里怎么住得下。","book":"《二十年目睹之怪现状》第二十三回"},"similar":["东拉西扯"],"usage":"作谓语、状语；指随便闲扯"},{"id":1306,"word":"七拱八翘","pinyin":"qī gǒng bā qiào","abbr":"qgbq","explanation":"形容关系不和谐或心情不舒畅。","source":{"text":"么大爷又不依了！说：‘要乱来我们大家乱来！’就这样七拱八翘。","book":"沙汀《选灾》"},"example":{"text":"铁公鸡肚皮里是忍不住～的。"},"usage":"作宾语、定语；指关系不融洽"},{"id":1307,"word":"七拼八凑","pinyin":"qī pīn bā còu","abbr":"qpbc","explanation":"指把零碎的东西拼凑起来。引申为胡乱凑合。","source":{"text":"他也打了半天的算盘，说七拼八凑，还勉强凑得上来。","book":"清·吴趼人《二十年目睹之怪现状》第九十二回"},"example":{"text":"白报纸成问题，印刷费成问题，就是同人们的伙食费都是～地勉强敷衍的，薪水更是说不上了。","book":"郭沫若《洪波曲》第四章"},"similar":["东拼西凑","东拉西扯"],"opposite":["浑然一体","无懈可击"],"usage":"作谓语、定语、状语；指胡乱凑合"},{"id":1308,"word":"七捞八攘","pinyin":"qī lāo bā rǎng","abbr":"qlbr","explanation":"到处捞摸扰攘。形容思绪纷乱不宁。","source":{"text":"若存得此心，则气常时清……睡梦里亦七捞八攘，如井水不打便清，只管去打便浊了。","book":"宋·朱熹《朱子语类》第59卷"},"usage":"作谓语、定语；用于书面语"},{"id":1309,"word":"七损八伤","pinyin":"qī sǔn bā shāng","abbr":"qsbs","explanation":"形容损伤惨重。","source":{"text":"秀童的爹娘和姐夫李大都到了，见秀童躺在板门上，七损八伤，一丝两气，大哭一场，奔到县前喊冤。","book":"明·冯梦龙《警世通言》第15卷"},"example":{"text":"这件作品被折腾得～了。"},"usage":"作谓语、状语；用于伤势"},{"id":1310,"word":"七损八益","pinyin":"qī sǔn bā yì","abbr":"qsby","explanation":"指女子月事宜以时下，男子精气宜于充盈。中医述人生长发育过程，女子以七为纪，男子以八为纪，故七指女，八指男。"},{"id":1311,"word":"七推八阻","pinyin":"qī tuī bā zǔ","abbr":"qtbz","explanation":"比喻有意为难。","source":{"text":"〔外怒介〕畜生，我教你去赴选，也只是要改换门闾，光显祖宗，你却七推八阻，有许多说话。","book":"元·高明《琵琶记》第四出"},"usage":"作谓语、定语；比喻有意为难"},{"id":1312,"word":"七搭八扯","pinyin":"qī dā bā chě","abbr":"qdbc","explanation":"形容说话漫无边际，没有中心。纠缠；乱搭腔。同“七搭八搭”。"},{"id":1313,"word":"七搭八搭","pinyin":"qī cháng bā dā","abbr":"qdbd","explanation":"形容说话漫无边际，没有中心。纠缠；乱搭腔。","source":{"text":"这里人瑞欲躺到烟坑上去去烧烟，嘴里七搭八搭的同老残说话。","book":"清·刘鹗《老残游记》第17回"},"example":{"text":"眼前这厂方有权力的屠维岳向来就喜欢找机会和她～，那么现在这举动也许就是吊她的膀子。","book":"茅盾《子夜》"},"usage":"作谓语、状语；用于说话"},{"id":1314,"word":"七擒七纵","pinyin":"qī qín qī zòng","abbr":"qqqz","explanation":"三国时，诸葛亮出兵南方，将当地酋长孟获捉住七次，放了七次，使他真正服输，不再为敌。比喻运用策略，使对方心服。","source":{"text":"亮笑，纵使更战，七纵七擒，而亮犹遣获。","book":"《三国志·蜀志·诸葛亮传》：“亮率众南征，其秋悉平。”裴松之注引《汉晋春秋》"},"example":{"text":"那敬德鞭无虚举，举无不中。你便要一冲一撞，登时间早将你～。","book":"元·无名氏《小尉迟》第一折"},"similar":["七纵七擒"],"usage":"作谓语、宾语、状语；用于处事","story":["三国时期，蜀国丞相诸葛亮为巩固后方，率领军队南征，正当大功告成撤军时，南方彝族首领孟获纠集残兵余勇来袭击蜀军。双方一交锋就活捉孟获。诸葛亮从大局出发放他回家。孟获先后七次被捉住，最终真心归顺蜀国"]},{"id":1315,"word":"七支八搭","pinyin":"qī zhī bā dā","abbr":"qzbd","explanation":"①随意瞎扯。②指不团结。"},{"id":1316,"word":"七断八续","pinyin":"qī duàn bā sù","abbr":"qdbx","explanation":"①形容散乱，不相照应。②断接之处甚多。形容十分破烂。","source":{"text":"应荣圣刀头引举三军喊杀，秦兵败走，东砍西伐，七断八续。","book":"《秦并六国平话》卷中"},"example":{"text":"穿一顶千补百衲藏形袄，系一条七～勒身绦。","book":"《北宫词纪·醉太平叹子弟》"},"usage":"作定语、状语；用于书面语"},{"id":1317,"word":"七日来复","pinyin":"qī rì lái fù","abbr":"qrlf","explanation":"《周易》复卦，主十一月。复卦六爻，第一爻为阳，其他五爻为阴，表示阴气剥尽阳气复生，称为“来复”。现常指一星期。","source":{"text":"反复其道，七日来复。","book":"《易·复》"},"example":{"text":"今微论西洋教宗如何，然而～，必有人焉聚其民而耳提面命之，……","book":"严复《原强》"},"usage":"作宾语；指一星期"},{"id":1318,"word":"七月流火","pinyin":"qī yuè liú huǒ","abbr":"qylh","explanation":"火：星座名，即心宿，每年夏历六月出现于正南方，位置最高，七月后逐渐偏西下沉，故称“流火”。指夏去秋来，寒天将至。","source":{"text":"七月流火，九月授衣。","book":"《诗经·豳风·七月》"}},{"id":1319,"word":"七棱八瓣","pinyin":"qī léng bā bàn","abbr":"qlbb","explanation":"比喻四分五裂。","example":{"text":"这个玻璃花瓶摔成～的了。"},"similar":["四分五裂"],"usage":"作定语、状语；指四分五裂"},{"id":1320,"word":"七横八竖","pinyin":"qī héng bā shù","abbr":"qhbs","explanation":"有的横，有的竖，杂乱无章。形容纵横杂乱。","source":{"text":"一片瓦砾场上，横七竖八，杀死的男子妇人，不计其数。","book":"明·施耐庵《水浒全传》第三十四回"},"example":{"text":"满架图书，却堆得～，桌上列着无数的商彝周鼎，古色斑斓。","book":"清·曾朴《孽海花》第十一回"},"similar":["横七竖八"],"opposite":["整整齐齐"],"usage":"作定语、状语；指杂乱无章"},{"id":1321,"word":"七次量衣一次裁","pinyin":"qī cì liáng yī yī cì cái","abbr":"qclyycc","explanation":"比喻事先的调查研究工作做得十分充足。","example":{"text":"～，我们事半功倍。"},"usage":"作宾语、分句；指事先准备"},{"id":1322,"word":"七步之才","pinyin":"qī bù zhī cái","abbr":"qbzc","explanation":"形容才思敏捷。","source":{"text":"文帝尝令东阿王七步中作诗，不成者行大法；应声便为诗曰：‘煮豆持作羹，漉菽以为汁；萁在釜下燃，豆在釜中泣；本自同根生，相煎何太急！’帝深有惭色。","book":"南朝宋·刘义庆《世说新语·文学》"},"example":{"text":"真个～，也不过如此。","book":"明·凌濛初《初刻拍案惊奇》卷九"},"similar":["文不加点","倚马可待"],"opposite":["呆头呆脑"],"usage":"作宾语；比喻人才思敏捷","story":["三国时期，曹操的小儿子曹植才思敏捷，文笔隽美，深受曹操的喜欢。他的哥哥曹丕废掉汉献帝建立魏朝做了皇帝，命曹植在七步之内作诗，曹植作诗：“煮豆持作羹，漉菽以为汁；萁在釜下燃，豆在釜中泣；本自同根生，相煎何太急！”"]},{"id":1323,"word":"七步八叉","pinyin":"qī bù bā chā","abbr":"qbbc","explanation":"相传曹植七步成诗，温庭筠凡八叉手而赋成八韵，后因以“七步八叉”形容才思敏捷。","source":{"text":"七步八叉，具有成例；古人击钵催诗，我要击钵了。","book":"清·文康《儿女英雄传》第37回"},"usage":"作宾语、定语；用于人的才思"},{"id":1324,"word":"七步奇才","pinyin":"qī bù qí cái","abbr":"qbqc","explanation":"有七步成诗的才能。比喻人有才气，文思敏捷。","source":{"text":"七步奇才，羡天才之敏捷。","book":"清·程允升《幼学故事琼林·文事》"},"similar":["七步之才","七步成章","七步成诗"],"usage":"作宾语；比喻人才思敏捷"},{"id":1325,"word":"七步成章","pinyin":"qī bù chéng zhāng","abbr":"qbcz","explanation":"称人才思敏捷。同“七步成诗”。","source":{"text":"丕又曰：‘七步成章，吾犹以为迟。汝能应声而作诗一首否？’","book":"明·罗贯中《三国演义》第七十九回"},"example":{"text":"休道是～。","book":"明·高明《琵琶记·杏园春宴》"},"similar":["七步成诗","七步奇才","七步之才"],"usage":"作宾语、定语；指才思敏捷","story":["三国时期，曹操的小儿子曹植才思敏捷，哥哥曹丕废掉汉献帝建立魏朝做了皇帝，命曹植在七步之内作诗，曹植作诗：“煮豆持作羹，漉菽以为汁；萁在釜下燃，豆在釜中泣；本自同根生，相煎何太急！”曹丕还嫌七步成章太慢，又要求应声作诗"]},{"id":1326,"word":"七步成诗","pinyin":"qī bù chéng shī","abbr":"qbcs","explanation":"称人才思敏捷。","source":{"text":"文帝尝令东阿王七步中作诗，不成者行大法；应声便为诗曰：‘煮豆持作羹，漉菽以为汁；萁在釜下燃，豆在釜中泣；本自同根生，相煎何太急！’帝深有惭色。","book":"南朝宋·刘义庆《世说新语·文学》"},"example":{"text":"冷绛雪道：‘子建～，千秋佳话，哪有改期姑待之理。’","book":"明·罗贯中《平山冷燕》第六回"},"similar":["七步之才","七步成章"],"usage":"作宾语、定语；指才思敏捷","story":["三国时期，曹操的小儿子曹植才思敏捷，文笔隽美，深受曹操的喜欢。他的哥哥曹丕废掉汉献帝建立魏朝做了皇帝，命曹植在七步之内作诗，曹植作诗：“煮豆持作羹，漉菽以为汁；萁在釜下燃，豆在釜中泣；本自同根生，相煎何太急！”"]},{"id":1327,"word":"七歪八扭","pinyin":"qī wāi bā niǔ","abbr":"qwbn","explanation":"形容歪斜不正。","source":{"text":"一路冲浸之处，不可胜数，慢说房屋四分五落，连树木也是七歪八扭。","book":"清·石玉昆《三侠五义》第八十四回"},"example":{"text":"老残笑说道：‘你真会乱！’也就站上炕去，将笔在砚台上蘸好了墨，呵了一呵，就在墙上～的写起来了。","book":"清·刘鹗《老残游记》第十二回"},"usage":"作谓语、定语、状语；指不整齐"},{"id":1328,"word":"七死七生","pinyin":"qī sǐ qī shēng","abbr":"qsqs","explanation":"佛数谓小乘初果者，尚须往返天上人间，受七度生死，才能证得阿罗汉果。亦作“七生七死”。"},{"id":1329,"word":"七死八活","pinyin":"qī sǐ bā huó","abbr":"qsbh","explanation":"如同多次死去活来一般。形容受尽痛苦。","source":{"text":"今日弄的我一个身子，七死八活。仙子，你那里是报恩，分明害杀小生也。","book":"元·吴昌龄《张天师》楔子"},"example":{"text":"若不得人情时，这一百棒打得七死八活。","book":"明·施耐庵《水浒全传》第九回"},"similar":["死去活来"],"usage":"作定语、状语；形容痛苦不堪或濒临死境"},{"id":1330,"word":"七洞八孔","pinyin":"qī dòng bā kǒng","abbr":"qdbk","explanation":"形容特别破烂的样子。"},{"id":1331,"word":"七湾八扭","pinyin":"qī wān bā niǔ","abbr":"qwbn","explanation":"多处弯曲，不断转变方向。也形容做事不直截了当。同“七湾八拐”。"},{"id":1332,"word":"七湾八拐","pinyin":"qī wān bā guǎi","abbr":"qwbg","explanation":"①多处弯曲，不断转变方向。②形容做事不直截了当。亦作“七弯八拐”。","source":{"text":"好啦，好啦，不要太自负了，被你七湾八拐的几下子，连我都拿不定主意来了。","book":"郭沫若《孔雀胆》第四幕第一场"},"similar":["七弯八拐"],"usage":"作谓语、定语；指曲折不直"},{"id":1333,"word":"七满八平","pinyin":"qī mǎn bā píng","abbr":"qmbp","explanation":"形容没有空馀的地方。","source":{"text":"刺瑞刻猴地几多，七满八平何处可施巧？","book":"清·赵翼《锦州刺史刘荫萱驻藏回蜀远寄藏佛一尊赋谢》诗"},"usage":"作宾语、定语；形容很满"},{"id":1334,"word":"七生七死","pinyin":"qī shēng qī sǐ","abbr":"qsqs","explanation":"佛数谓小乘初果者，尚须往返天上人间，受七度生死，才能证得阿罗汉果。同“七死七生”。"},{"id":1335,"word":"七男八婿","pinyin":"qī nán bā xù","abbr":"qnbx","explanation":"形容子、婿众多。同“七子八婿”。","example":{"text":"一个家庭有～，计划生育工作怎么做？"},"similar":["七子八婿"],"usage":"作宾语、定语；指子女"},{"id":1336,"word":"七疮八孔","pinyin":"qī chuāng bā kǒng","abbr":"qcbk","explanation":"窟窿多。比喻经济上负债累累。","source":{"text":"俗话说‘好账不如无。’在我身上一天，就在我心里一天，恨不得一剪剪齐，争乃近日手窘，七疮八孔的，难以骤完。","book":"清·李绿园《歧路灯》第66回"},"similar":["负债累累"],"usage":"作定语；指负债累累"},{"id":1337,"word":"七病八倒","pinyin":"qī bìng bā dǎo","abbr":"qbbd","explanation":"形容体弱多病。"},{"id":1338,"word":"七病八痛","pinyin":"qī bìng bā tòng","abbr":"qbbt","explanation":"泛指各种各样的病痛。","source":{"text":"就是在雯青家里，一年到头，上下多少人，七病八痛，都是他包圆儿的。","book":"清·曾朴《孽海花》第24回"},"example":{"text":"那时我老二还不到六岁，我娘经常～。","book":"马烽《太阳刚刚出山》"},"similar":["三病两痛","三病四痛"],"usage":"作宾语、定语；指疾病"},{"id":1339,"word":"七相五公","pinyin":"qī xiāng wǔ gōng","abbr":"qxwg","explanation":"所举皆汉代公卿，后泛指众多的文武大臣。","source":{"text":"七相：谓车千秋、黄霸、王商、王嘉、韦贤、平当、魏相。五公：张汤、萧望之、冯奉世、史丹、张安世。公侯、御史大夫、将军，通称为公。","book":"语出《文选·班固〈西都赋〉》：“冠盖如云，七相五公。”吕向注"},"example":{"text":"齐诸田，楚屈、景，皆右姓也。其后进拔豪英，论而禄之，盖～之所由兴也。","book":"《新唐书·儒学传中·柳沖》"},"usage":"作宾语、定语；用于书面语"},{"id":1340,"word":"七破八补","pinyin":"qī pò bā bǔ","abbr":"qpbb","explanation":"形容衣物非常破旧。","source":{"text":"外面来了一个白须老头子，穿了一件七破八补的棉袍，形状十分瑟缩。","book":"清·吴趼人《二十年目睹之怪现状》第73回"},"similar":["破旧不堪"],"opposite":["暂暂新新"],"usage":"作定语、状语；用于口语"},{"id":1341,"word":"七穿八洞","pinyin":"qī chuān bā dòng","abbr":"qcbd","explanation":"形容破旧不堪。"},{"id":1342,"word":"七穿八烂","pinyin":"qī chuān bā làn","abbr":"qcbl","explanation":"形容破烂不堪。"},{"id":1343,"word":"七穿八穴","pinyin":"qī chuān bā xué","abbr":"qcbx","explanation":"穿：洞，孔；穴：窟窿。形容窟窿很多。","source":{"text":"有时十字街头七穿八穴。","book":"宋·释普济《五灯会元》第45卷"},"similar":["千疮百孔"],"usage":"作谓语、定语、状语；用于书面语"},{"id":1344,"word":"七窍冒火","pinyin":"qī qiào mào huǒ","abbr":"qqmh","explanation":"形容气愤到极点。同“七窍生烟”。","source":{"text":"一天两天还好受，等到第三天，真受不得了！怎么还没有信呢？俗语说的好，真是七窍冒火，五脏里生烟。","book":"《老残游记续集遗稿》第三回"},"example":{"text":"见此情不由我～，你这般对付我却待如何？","book":"欧阳予情《渔夫恨》第五场"},"similar":["七窍生烟"],"usage":"作谓语、状语；形容气愤或焦急"},{"id":1345,"word":"七窍流血","pinyin":"qī qiào liú xuè","abbr":"qqlx","explanation":"七窍：指人头上的七个孔，即两眼、两耳、两鼻孔和口。口鼻等处往外流血。","source":{"text":"李大到的家中，七窍流血死了也。","book":"元·孟汉卿《魔合罗》第二折"},"example":{"text":"忽有声震如雷，已而烟灭，见术士～死矣。","book":"清·蒲松龄《聊斋志异·甄后》"},"usage":"作谓语、状语；用于中毒或死后"},{"id":1346,"word":"七窍玲珑","pinyin":"qī qiào líng lóng","abbr":"qqll","explanation":"形容聪明灵巧。相传心有七窍，故称。","source":{"text":"鹰鼻、狗眼、猪嘴，加上一颗鲜红多血、七窍玲珑的人心，才完成了一个万物之灵的人。","book":"老舍《赵子曰》"},"usage":"作定语；用于书面语"},{"id":1347,"word":"七窍生烟","pinyin":"qī qiào shēng yān","abbr":"qqsy","explanation":"七窍：口和两眼、两耳、两鼻孔。气愤得好像耳目口鼻都要冒出火来。形容气愤到极点。","source":{"text":"七窍：口和两眼、两耳、两鼻孔。气愤得好像耳目口鼻都要冒出火来。形容气愤到极点。"},"example":{"text":"三尸神炸，～，忙传军令，叫把京城十三门尽行关闭，挨户查拿。","book":"清·俞万春《荡寇志》第七十五回"},"similar":["愤然作色","怒形于色"],"opposite":["心平气和"],"usage":"作谓语、状语；形容气愤或焦急"},{"id":1348,"word":"七窝八代","pinyin":"qī wō bā dài","abbr":"qwbd","explanation":"詈词。指全部眷属家族。","source":{"text":"却只怕那水里有甚么眷族老小，七窝八代的都来，我就弄他不过。","book":"明·吴承恩《西游记》"},"usage":"作宾语、定语、状语；用于集体"},{"id":1349,"word":"七纵七擒","pinyin":"qī zòng qī qín","abbr":"qzqq","explanation":"三国时，诸葛亮出兵南方，将当地酋长孟获捉住七次，放了七次，使他真正服输，不再为敌。比喻运用策略，使对方心服。","source":{"text":"亮笑，纵使更战，七纵七擒，而亮犹遣获。","book":"《三国志·蜀志·诸葛亮传》：“亮率众南征，其秋悉平。”裴松之注引《汉晋春秋》"},"example":{"text":"～何处在，茅花枥叶盖神坛。","book":"唐·章孝标《诸葛武侯庙》"},"similar":["七擒七纵"],"usage":"作谓语、宾语、状语；用于处事","story":["三国时期，蜀国丞相诸葛亮为巩固后方，率领军队南征，正当大功告成撤军时，南方彝族首领孟获纠集残兵余勇来袭击蜀军。双方一交锋就活捉孟获。诸葛亮从大局出发放他回家。孟获先后七次被捉住，最终真心归顺蜀国"]},{"id":1350,"word":"七纵七禽","pinyin":"qī zòng qī qín","abbr":"qzqq","explanation":"比喻善于运用策略，使对方心服。亦作“七纵七擒”。","source":{"text":"相传三国时诸葛亮出兵南方，曾七次生擒酋长孟获，又七次释放，终于使孟获心悦诚服。事见《三国志·蜀志·诸葛亮传》“亮率众南征，其秋悉平”裴松之注引《汉晋春秋》。"},"similar":["七纵七擒"],"usage":"作谓语、宾语、状语；用于处事","story":["三国时期，蜀国丞相诸葛亮为巩固后方，率领军队南征，正当大功告成撤军时，南方彝族首领孟获纠集残兵余勇来袭击蜀军。双方一交锋就活捉孟获。诸葛亮从大局出发放他回家。孟获先后七次被捉住，最终真心归顺蜀国"]},{"id":1351,"word":"七纵八横","pinyin":"qī zòng bā héng","abbr":"qzbh","explanation":"形容奔放自如。","source":{"text":"及其透彻，则七纵八横，信手拈来，头头是道矣。","book":"宋·严羽《沧浪诗话·诗法》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第104回：“把新太太脸上也～的，抽了好几条血路。”"},"usage":"作谓语、状语；用于人的性格"},{"id":1352,"word":"七老八倒","pinyin":"qī lǎo bā dǎo","abbr":"qlbd","explanation":"形容年老体衰。","source":{"text":"到得那七老八倒，腰驼背曲时候，富的也死，贫的也死。","book":"明·寓山居士《鱼儿佛》第一出"},"similar":["老态龙钟"],"usage":"作谓语、定语；用于口语"},{"id":1353,"word":"七老八十","pinyin":"qī lǎo bā shí","abbr":"qlbs","explanation":"七八十岁。形容人年纪大。","source":{"text":"赶得那七老八十的都起身嫁人去了。","book":"明·凌濛初《初刻拍案惊奇》第十卷"},"example":{"text":"他都～的人了，还是眼不花、耳不聋。"},"usage":"作谓语、定语；用于口语"},{"id":1354,"word":"七老八小","pinyin":"qī lǎo bā xiǎo","abbr":"qlbx","explanation":"指老人与小孩。老老少少。","source":{"text":"咱家七老八小，就看咱两个撑扶这光景哩。","book":"路遥《平凡的世界》第一卷第23章"},"similar":["老老少少"],"usage":"作主语、宾语、定语；用于口语"},{"id":1355,"word":"七脚八手","pinyin":"qī jiǎo bā shǒu","abbr":"qjbs","explanation":"形容动作忙乱，许多人一齐动手。亦作“七足八手”。","source":{"text":"我们正七脚八手处理文件，收拾东西，警察已到院内。","book":"李昌《回忆民先队》"},"similar":["七手八脚","七足八手"],"opposite":["有条不紊"],"usage":"作状语；形容人多手杂，动作纷乱"},{"id":1356,"word":"七舌八嘴","pinyin":"qī shé bā zuǐ","abbr":"qsbz","explanation":"形容人多口杂。同“七嘴八舌”。","source":{"text":"茶馆里又围了许多人，都把他们当做谈话的中心，七舌八嘴，然而没有一句话可以暂时使他们宽心一下。","book":"丁玲《奔》"},"similar":["七嘴八舌"],"usage":"作宾语、状语；形容人"},{"id":1357,"word":"七行俱下","pinyin":"qī háng jù xià","abbr":"qhjx","explanation":"读书，同时读七行。比喻非常聪明。","source":{"text":"少机颖，神明爽发，读书七行俱下，才藻美甚。","book":"《南史·宋孝武帝纪》"},"example":{"text":"既冠不茹荤，日唯一食，持法华经，～，才六旬，悉能诵之，感群羊跪听。","book":"宋·释普济《五灯会元》卷十"},"similar":["十行俱下"],"usage":"作谓语；用于看书"},{"id":1358,"word":"七言八语","pinyin":"qī yán bā yǔ","abbr":"qyby","explanation":"形容人多语杂。","source":{"text":"当下众人七言八语，有说送祟的，有说跳神的，有荐玉皇阁张道士捉怪的，整闹了半日，祈求祷告，百般医治，并不见好。","book":"清·曹雪芹《红楼梦》第二十五回"},"example":{"text":"他们又说了一遍，同时别的亲将也～，劝他率军逃往陈州，不可耽误。","book":"姚雪垠《李自成》第三卷第十九章"},"similar":["人多嘴杂"],"usage":"作谓语、定语、状语；指人多嘴杂"},{"id":1359,"word":"七贞九烈","pinyin":"qī zhēn jiǔ liè","abbr":"qzjl","explanation":"旧时形容妇女无比贞节刚烈，宁死不失身。","source":{"text":"拼守着七贞九烈，怕甚么六问三推，一任他万打千敲。","book":"元·李行道《灰阑记》"},"example":{"text":"当初讨我的时候，就没有指望我甚么三从四德～。","book":"曾朴《孽海花》第21回"},"usage":"作宾语、定语；多用于女性"},{"id":1360,"word":"七足八手","pinyin":"qī zú bā shǒu","abbr":"qzbs","explanation":"形容慌张乱闯。同“七脚八手”。","source":{"text":"这时候，那个可怜的盐客，已经在七足八手下打扮好了。","book":"沙汀《替身》"},"similar":["七脚八手"],"opposite":["有条不紊"],"usage":"作状语；形容人多手杂，动作纷乱"},{"id":1361,"word":"七返丹","pinyin":"qī fǎn dān","abbr":"qfd","explanation":"传说中的一种丹药，有增功保健的功效。","source":{"text":"‘七返丹’功参造化，练气之士，得此一粒，可抵二十年勤修之功，即普通人服之，亦可明目轻身，得享遐龄。","book":"东方玉《七步惊龙》第四章"}},{"id":1362,"word":"七返灵砂","pinyin":"qī fǎn líng shā","abbr":"qfls","explanation":"道家所谓能起死回生的灵丹妙药。形容可以挽救危险和死亡的办法。","source":{"text":"炉中炼药，乃七返灵砂也。","book":"宋·康骈《居谈录·说方士》"}},{"id":1363,"word":"七返还丹","pinyin":"qī fǎn huán dān","abbr":"qfhd","explanation":"传说中气功修练的一种方法。","source":{"text":"三车者，三件河车也。第一件运气，即小周天子午运火也；第二件运精，即玉液河车，运水温养也；第三件精气兼运，即大周天运先天金汞，七返还丹，九还大丹也。……人能知三车秘谛，则精气神三品圆全，天地人三仙成就。","book":"李涵虚《三车秘旨》"}},{"id":1364,"word":"七郤八手","pinyin":"qī xì bā shǒu","abbr":"qxbs","explanation":"亦作“七足八手”。形容动作忙乱，许多人一齐动手。"},{"id":1365,"word":"七鄐八手","pinyin":"qī xì bā shǒu","abbr":"qxbs","explanation":"亦作七足八手”。形容动作忙乱，许多人一齐动手。"},{"id":1366,"word":"七长八短","pinyin":"qī cháng bā duǎn","abbr":"qcbd","explanation":"形容高矮、长短不齐。也指不幸的事。","source":{"text":"又见那七长八短、七肥八瘦的大大小小妖精，都是些牛头鬼怪，各执枪棒。","book":"明·吴承恩《西游记》第九十一回"},"example":{"text":"那官人慌了，脱得身子，顾不得什么～，急从后门逃了出去。","book":"明·凌濛初《二刻拍案惊奇》卷十四"},"similar":["参差不齐"],"opposite":["整整齐齐"],"usage":"作宾语、定语；形容高矮、长短不齐"},{"id":1367,"word":"七零八乱","pinyin":"qī líng bā luàn","abbr":"qlbl","explanation":"形容非常零乱不堪。","source":{"text":"在金俊文被搬迁的七零八乱的家里，俊文和他的一家人都在哭鼻子。","book":"路遥《平凡的世界》第一卷第51章"},"similar":["七零八落"],"usage":"作定语、状语；用于口语"},{"id":1368,"word":"七零八碎","pinyin":"qī líng bā suì","abbr":"qlbs","explanation":"①形容残破不堪。②零星琐碎。③指零星的物品。","source":{"text":"你弄得我一个国家七零八碎，送得我一个身子七上八落，如今怎么好？","book":"明·梁辰鱼《浣纱记》"},"example":{"text":"它到东方来，把东方固定了几千年金瓯无缺的封建社会弄得～。","book":"郭沫若《反正前后》"},"similar":["零零碎碎"],"usage":"作谓语、定语、状语；指零碎"},{"id":1369,"word":"七零八落","pinyin":"qī líng bā luò","abbr":"qlbl","explanation":"形容零散稀疏的样子。特指原来又多又整齐的东西现在零散了。","source":{"text":"无味之谈，七零八落。","book":"宋·惟白《建中靖国续灯录》卷六"},"example":{"text":"一个小小家当，弄得～。","book":"明·冯梦龙《醒世恒言》卷十六"},"similar":["零七八碎","支离破碎"],"opposite":["井井有条","浑然一体"],"usage":"作谓语、状语、补语；指零散"},{"id":1370,"word":"七青八黄","pinyin":"qī qīng bā huáng","abbr":"qqbh","explanation":"指钱财。","source":{"text":"量着穷秀才人情只是纸半张，又没甚七青八黄。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"他是个穷秀才的人情，没什么～的。","book":"清·李清《踌杵闲评》第34回"},"usage":"作宾语、定语；指钱财"},{"id":1371,"word":"七颠八倒","pinyin":"qī diān bā dǎo","abbr":"qdbd","explanation":"形容十分凌乱。","source":{"text":"问如何是佛法大师，师曰：‘七颠八倒。’","book":"宋·释道原《景德传灯录》卷二十一"},"example":{"text":"如今不幸他殁了，已得三年，家里的事，都～。","book":"明·施耐庵《水浒全传》第二十四回"},"similar":["颠三倒四"],"usage":"作谓语、定语；形容十分凌乱"},{"id":1372,"word":"七首八脚","pinyin":"qī shǒu bā jiǎo","abbr":"qsbj","explanation":"形容慌张乱闯。","source":{"text":"他本来不会走城里的路，这时着了急，七首八脚的乱跑，眼睛又不看着前面，跑了一箭多路，一头撞到一顶轿子上。","book":"清·吴敬梓《儒林外史》第十二回"},"usage":"作定语、状语；用于书面语"},{"id":1373,"word":"七高八低","pinyin":"qī gāo bā dī","abbr":"qgbd","explanation":"形容道路不平坦。","source":{"text":"只见行者撞进来了。真个生得丑陋：七高八低孤拐脸，两只黄眼睛，一个磕额头。","book":"明·吴承恩《西游记》第三十六回"},"example":{"text":"独自一个，在这～的小路上，一脚绊一脚的望前走去。","book":"清·曾朴《孽海花》第二十三回"},"similar":["崎岖不平","坎坷不平"],"usage":"作定语、状语；指路不平"},{"id":1374,"word":"七魄悠悠","pinyin":"qī pò yōu yōu","abbr":"qpyy","explanation":"形容因惊恐过度而失神。","source":{"text":"惊得太尉三魂荡荡，七魄悠悠。","book":"明·施耐庵《水浒全传》第一回"},"example":{"text":"那众强人那容分说，赶上前，把寇员外撩阴一脚踢翻在地，可怜三魂渺渺归阴府，～别世人！","book":"明·吴承恩《西游记》第九十七回"}},{"id":1375,"word":"万万千千","pinyin":"wàn wàn qiān qiān","abbr":"wwqq","explanation":"形容数量极多。","source":{"text":"天地安得万万千千手，并为物万万千千乎？","book":"汉·王充《论衡·自然》"},"example":{"text":"他们预备散到各地去，把～的心团结成一颗心呀。","book":"叶圣陶《寒假的一天》"},"similar":["千千万万"],"usage":"作谓语、定语；形容很多"},{"id":1376,"word":"万丈光芒","pinyin":"wàn zhàng guāng máng","abbr":"wzgm","explanation":"形容光辉灿烂，照耀到远方。","source":{"text":"骑龙凤，自九霄飞至，万丈光芒。","book":"宋·姚勉《沁园春·七月朔寿卢守》"},"similar":["光芒万丈"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":1377,"word":"万丈深渊","pinyin":"wàn zhàng shēn yuān","abbr":"wzsy","explanation":"渊：深潭。很深的水潭。比喻十分不利的处境。","source":{"text":"我忽然摔了下来，好像落进万丈深渊，浑身疼痛。","book":"《劳动的开端》"},"example":{"text":"我突然有跌进～的凄凉感觉。"},"similar":["不测之渊"],"usage":"作宾语、定语；指十分不利的处境"},{"id":1378,"word":"万丈高楼从地起","pinyin":"wàn zhàng gāo lóu cóng dì qǐ","abbr":"wzglcdq","explanation":"比喻凡事要从打基础做起。","example":{"text":"～，我们必须要打牢基础。"},"similar":["万丈高楼平地起"],"usage":"作定语、分句；用于劝诫人"},{"id":1379,"word":"万丈高楼平地起","pinyin":"wàn zhàng gāo lóu píng dì qǐ","abbr":"wzglpdq","explanation":"比喻事物从无到有。","example":{"text":"我国飞机制造业、造船工业、汽车工业都是～，一步一步建设起来的。"},"similar":["万丈高楼从地起"],"usage":"作定语、分句；用于劝诫人"},{"id":1380,"word":"万不一失","pinyin":"wàn bù yī shī","abbr":"wbys","explanation":"失：差错，失误。一万次也不失误一次。形容很有把握，绝对不会出差错。","source":{"text":"贵贱在于骨法，忧喜在于容色，成败在于决断，以此参之，万不失一。","book":"《史记·淮阴侯列传》"},"similar":["万不失一","万无一失"],"usage":"作谓语、定语、状语；形容有绝对把握"},{"id":1381,"word":"万不失一","pinyin":"wàn bù shī yī","abbr":"wbsy","explanation":"形容绝对不会出差错。同“万无一失”。","source":{"text":"韩信曰：‘先生相人何如？’对曰：‘贵贱在于骨法，忧喜在于容色，成败在于决断，以此参之，万不失一。’","book":"《韩非子·解老》：“治乡治邦莅天下者，各以此科适观息耗则万不失一。”《史记·淮阴侯列传》"},"example":{"text":"舵工素以海习，虽卒遇飓母浮椒，亦～云。","book":"清·龚翔麟《珠江奉使记》"},"similar":["百无失一","万无一失"],"opposite":["挂一漏万"],"usage":"作谓语、定语、状语；形容有绝对把握","story":["公元前203年，汉将韩信灭了齐国，被刘邦封为齐王，韩信的谋士蒯通分析天下形势后认为韩信是举足轻重的人物，劝他不要跟随刘邦自立为王，可以与楚汉三分天下，跟随刘邦最多也只能封为诸侯，成败在于决断，现在行动可以万无一失。韩信没听蒯通的"]},{"id":1382,"word":"万不得已","pinyin":"wàn bù dé yǐ","abbr":"wbdy","explanation":"表示无可奈何，不得不如此。","source":{"text":"娘子不须挂怀，三载夫妻，恩情不浅，此去也是万不得已，一年半载，便得相逢也。","book":"明·冯梦龙《喻世明言》第十八卷"},"example":{"text":"今门之事，出于～，并非有意为之。","book":"清·李渔《比目鱼》第十五回"},"similar":["无可奈何","迫不得已"],"opposite":["心甘情愿"],"usage":"作谓语、定语；指不得不如此"},{"id":1383,"word":"万不耐一","pinyin":"wàn bù néng yī","abbr":"wbny","explanation":"耐：通“能”。一万个人里也找不到一个。形容人才极其难得。","source":{"text":"好学勤力，博闻强识，世间多有；著书表文，论说古今，万不耐一。","book":"汉·王充《论衡·超奇》"}},{"id":1384,"word":"万世一时","pinyin":"wàn shì yī shí","abbr":"wsys","explanation":"万世才有这么一个机会。形容机会难得。","source":{"text":"慧星出，蝗虫数起，此万世一时，而愁劳圣人之所起也。","book":"《史记·吴王濞列传》"},"example":{"text":"今陛下春秋鼎盛，天锡勇智，此～也。","book":"宋·苏轼《拟进士对御试策》"},"similar":["万代一时"],"usage":"作宾语、定语；多指机会等"},{"id":1385,"word":"万世不刊","pinyin":"wàn shì bù kān","abbr":"wsbk","explanation":"汉·扬雄《郦商铭》：“金紫褒表，万世不刊。”","source":{"text":"金紫褒表，万世不刊。","book":"汉·扬雄《郦商铭》"},"example":{"text":"宜称曰“皇考兴献王”，此～之典。","book":"《明史·席书传》"}},{"id":1386,"word":"万世不拔","pinyin":"wàn shì bù bá","abbr":"wsbb","explanation":"拔：动摇。永远不动摇。","source":{"text":"刘豫臣事丑虏，南面称王，自以为子孙帝王万世不拔之业。","book":"宋·胡铨《上高宗封事》"},"example":{"text":"使他待时而动，辅佐兴王，成就这～之基，得见淳古太平之象。","book":"清·吴璿《飞龙全传》第一回"}},{"id":1387,"word":"万世不易","pinyin":"wàn shì bù yì","abbr":"wsby","explanation":"易：改变。永远不改变。亦作“万代不易”。","source":{"text":"士大夫以道，百姓以为俗，万世不能易也。","book":"《六韬·龙韬·五音》：“宫商角徵羽，此真正声也，万代不易。”《荀子·正论》"},"example":{"text":"自真宗至钦宗，圣圣相传，庙制一定，～。","book":"清·毕沅《续资治通鉴》卷一百五十一"}},{"id":1388,"word":"万世不朽","pinyin":"wàn shì bù xiǔ","abbr":"wsbx","explanation":"朽：磨灭。永远不可磨灭。用于对生者的赞颂。","source":{"text":"二将军拔大驾来东，有元功于国，当书勋竹帛，万世不朽。","book":"晋·司马彪《九州春秋·吕布》"},"example":{"text":"明公手握重权，令郎阴蓄士马，何不举义兵伐夏救民，建～之业？","book":"清·褚人获《隋唐演义》第四十六回"},"similar":["万古不朽","永垂不朽"],"usage":"作谓语、定语；多用于功名事业等"},{"id":1389,"word":"万世不革","pinyin":"wàn shì bù gé","abbr":"wsbg","explanation":"革：改，改变。永远不改变。"},{"id":1390,"word":"万世之业","pinyin":"wàn shì zhī yè","abbr":"wszy","explanation":"指传之万世不朽的大业。","source":{"text":"天下已定，始皇之心，自以为关中之固，金城千里，子孙帝王万世之业也。","book":"汉·贾谊《过秦论》"},"example":{"text":"高帝蒙霜露，冒风雨，赴矢石，野战攻城，身被疮痍，以为子孙成～，艰难危苦甚矣。","book":"蔡东藩《前汉演义》第四十九回"},"similar":["万代之业"],"usage":"作宾语；指功业等"},{"id":1391,"word":"万世之功","pinyin":"wàn shì zhī gōng","abbr":"wszg","explanation":"万世不朽的功劳。","source":{"text":"今陛下创大业，建万世之功，固非愚儒所知。","book":"《史记·秦始皇本纪》"},"example":{"text":"而独使保吉桀黠，志在决战，能无败乎！破而擒之，此～也。","book":"清·毕沅《续资治通鉴》卷二十一"}},{"id":1392,"word":"万世之名","pinyin":"wàn shì zhī míng","abbr":"wszm","explanation":"永远不可磨灭的名声。","source":{"text":"生无一日之欢，死有万世之名。","book":"《列子·杨朱》"},"example":{"text":"非但时人，天地鬼神知臣得正，可以益国家～，过于三皇、五帝矣。","book":"《北史·崔浩传》"}},{"id":1393,"word":"万世之后","pinyin":"wàn shì zhī hòu","abbr":"wszh","explanation":"特指皇帝死后。","source":{"text":"陛下遇我厚，吾能忍之；万世之后，吾宁能北面臣事竖子乎！","book":"《史记·淮南衡山列传》"},"example":{"text":"近年废弛，恐～，一代成功无从稽考，请复旧制。","book":"清·毕沅《续资治通鉴》卷二百九十"}},{"id":1394,"word":"万世之安","pinyin":"wàn shì zhī ān","abbr":"wsza","explanation":"永久的安定、稳固。","source":{"text":"然而刘敬脱輓辂一说，建万世之安，智岂可专邪！","book":"《史记·刘敬叔孙通列传》"},"example":{"text":"朕断不用金玉，庶先帝神灵有～。","book":"《宋史·张焘传》"}},{"id":1395,"word":"万世之患","pinyin":"wàn shì zhī huàn","abbr":"wszh","explanation":"永久性的忧患。","source":{"text":"夫不忍一世之伤，而骜万世之患，抑固窭邪，亡其略弗及邪？","book":"《庄子·外物》"},"example":{"text":"丞相纵不杀备，亦不当使之去。古人云：一日纵敌，～。望丞相察之。","book":"明·罗贯中《三国演义》第二十一回"}},{"id":1396,"word":"万世之计","pinyin":"wàn shì zhī jì","abbr":"wszj","explanation":"极长久的计划。","source":{"text":"不如急发重使之赵、梁，约复为兄弟，使山东皆以锐师戍韩、梁之西边，非为此也，山东无以救亡，此万世之计也。","book":"《战国策·韩策三》"},"example":{"text":"臣不才备位，乞豫建太子者，为宗庙～也。","book":"《宋史·包拯传》"}},{"id":1397,"word":"万世公论","pinyin":"wàn shì gōng lùn","abbr":"wsgl","explanation":"指历代的公正之论。","source":{"text":"人言御史台任重，朕谓国史院尤重；御史台是一时公论，国史院实万世公论。","book":"《元史·仁宗纪》"},"example":{"text":"则如宋蒋之奇尝诬奏欧阳修矣，胡纮辈尝诬奏朱熹矣，未闻以一人私情废～也。","book":"《明史·何乔新传》"}},{"id":1398,"word":"万世师表","pinyin":"wàn shì shī biǎo","abbr":"wssb","explanation":"万世：很多世代，非常久远；师表：表率。值得永远学习的榜样。","source":{"text":"昔仲尼大圣之才，怀帝王之器，……可谓命世之大圣，亿载之师表者也。","book":"《三国志·魏志·文帝纪》"},"similar":["一代楷模"],"usage":"作宾语、定语；指学习的榜样"},{"id":1399,"word":"万世无疆","pinyin":"wàn shì wú jiāng","abbr":"wswj","explanation":"《书·太甲中》：“皇天眷佑有商，俾嗣王克终厥德，实万世无疆之休。”","source":{"text":"臣闻天所眷命，生而神灵，唯三代受命之符，箤于兹日，实～之福。 ★宋·苏轼《兴龙节集英殿宴教坊词·教坊致语》"},"example":{"text":"臣闻天所眷命，生而神灵，唯三代受命之符，箤于兹日，实～之福。","book":"宋·苏轼《兴龙节集英殿宴教坊词·教坊致语》"},"similar":["万年无疆"],"usage":"作谓语、定语；用于书面语"},{"id":1400,"word":"万世流芳","pinyin":"wàn shì liú fāng","abbr":"wslf","explanation":"好名声永远流传。","source":{"text":"子欲为名高也，则当如许由、子威、卞随、务光，洗耳逃禄，千载流芳。","book":"南朝·宋·刘义庆《世说新语·排调》：“头责秦子羽云。”刘孝标注引张敏《头责子羽文》"}},{"id":1401,"word":"万世长策","pinyin":"wàn shì cháng cè","abbr":"wscc","explanation":"指长远的的策略或极好的计谋。","source":{"text":"信让行乎蛮貉，福祚流于亡穷，万世之长策也。","book":"《汉书·萧望之传》"},"example":{"text":"渐徙内郡杂胡于边地，峻四夷出入之防，明先王荒服之制。此～也。","book":"明·冯梦龙《智囊全集·远犹·郭钦》"}},{"id":1402,"word":"万乘之主","pinyin":"wàn shèng zhī zhǔ","abbr":"wczz","explanation":"乘：四匹马拉的车。指大国的国君。","source":{"text":"重为轻根，静为躁君。是以君子终日行不离轻重，虽有荣观燕处超然，奈何万乘之主而以身轻天下，轻则失根，躁则失君。","book":"《老子》第二十六章"},"example":{"text":"众将已会于此，有屈难伸，特令戴宗屈～，亲临水泊，恳告平日衷曲。","book":"明·施耐庵《水浒全传》第一百二十回"}},{"id":1403,"word":"万乘之君","pinyin":"wàn shèng zhī jūn","abbr":"wczj","explanation":"乘：四匹马拉的车。指大国的国君。","source":{"text":"不受于褐宽之博，亦不受于万乘之君。","book":"《孟子·公孙丑上》"},"example":{"text":"陛下作中华之主，为～，城池数千余，封疆百万里，犹有不足之心，常起灭绝之意。","book":"《明史·外国传·日本》"}},{"id":1404,"word":"万乘之国","pinyin":"wàn shèng zhī guó","abbr":"wczg","explanation":"乘：四匹马拉的车。指大国。一般指周朝。","source":{"text":"万乘之国，弑其君者，必千乘之家；千乘之国，弑其君者，必百乘之家。","book":"《孟子·梁惠王上》"},"example":{"text":"臣何惜一朝之命，而不安～哉！","book":"《旧唐书·苏安恒传》"}},{"id":1405,"word":"万乘之尊","pinyin":"wàn shèng zhī zūn","abbr":"wczz","explanation":"乘：四匹马拉的车；尊：尊贵。旧指帝王的尊贵。","source":{"text":"陛下以万乘之尊，履布衣之礼，服粗席藁，水饮疏食，殷忧内盈，毁悴外表，而躬勤万机，坐而待旦，降心接下，仄不遑食，所以劳力者如斯之甚。","book":"《宋书·礼志二》"},"example":{"text":"娘娘乃～，臣妾乃一介之妇，岂有彩凤配山鸡之理？","book":"明·许仲琳《封神演义》第三十回"}},{"id":1406,"word":"万乘公相","pinyin":"wàn shèng gōng xiàng","abbr":"wcgx","explanation":"乘：四匹马拉的车；万乘：指帝王。指辅佐帝王的公卿宰相。","source":{"text":"虽万乘之公相，吾不以一日辍汝而就也。","book":"唐·韩愈《祭十二郎文》"}},{"id":1407,"word":"万事不求人","pinyin":"wàn shì bù qiú rén","abbr":"wsbqr","explanation":"指做事只靠自己的努力，不依赖别人。","example":{"text":"他就是～的性格。"},"similar":["自力更生"],"usage":"作宾语、定语；指自力更生"},{"id":1408,"word":"万事亨通","pinyin":"wàn shì hēng tōng","abbr":"wsht","explanation":"亨通：通达顺利。一切事情都很顺利。","source":{"text":"那孔方兄运出万事亨通的本领，先治了关格之症。","book":"清·李绿园《歧路灯》第六十五回"},"example":{"text":"不敢说～，反正比您这万事不通强得多。(老舍《离婚》）"},"similar":["万事大吉","万事如意"],"opposite":["荆棘载途","艰难曲折"],"usage":"作谓语、宾语；指办事顺利"},{"id":1409,"word":"万事俱休","pinyin":"wàn shì jù xiū","abbr":"wsjx","explanation":"一切事情都罢休。","source":{"text":"朱温未听得万事俱休，才听得后，怒从心上起，恶向胆边生。","book":"《五代史平话》"},"example":{"text":"我到那里，三言两句，肯写休书，～。","book":"元·关汉卿《救风尘》第二折"},"similar":["万事皆休"],"usage":"作谓语、定语；指完结"},{"id":1410,"word":"万事俱备，只欠东风","pinyin":"wàn shì jù bèi，zhǐ qiàn dōng fēng","abbr":"wsjbzqdf","explanation":"一切都准备好了，只差东风没有刮起来，不能放火。比喻什么都已准备好了，只差最后一个重要条件了。","source":{"text":"孔明索纸笔，屏退左右，密书十六字曰：欲破曹公，宜用火攻；万事俱备，只欠东风。","book":"明·罗贯中《三国演义》第四十九回"},"example":{"text":"我们现在是～，只要机器一来，马上就可以安装了。"},"usage":"作宾语、分句；指等待时机","story":["东汉末，曹操亲率大军南下屯驻赤壁，企图消灭刘备与孙权。诸葛亮出使东吴结成孙刘联盟。周瑜主张用火攻曹，双方派黄盖、庞统降曹作内应，曹操将战船连在一块。诸葛亮给周瑜写封信：“欲破曹公，宜用火攻；万事俱备，只欠东风”"]},{"id":1411,"word":"万事全休","pinyin":"wàn shì quán xiū","abbr":"wsqx","explanation":"休：完结。指一切事情全都完结了。形容悲观失望，不想再有所作为。也表示什么事端都没有。","source":{"text":"若今夜真个死，万事全休；若不死，明日和你县里理会！","book":"明·冯梦龙《警世通言》卷十三"},"example":{"text":"你们要是懂事的，快快的给我出去，～；如若不然，哼哼，那时却莫怪我们粗鲁。","book":"清·张春帆《九尾龟》第八十九回"}},{"id":1412,"word":"万事大吉","pinyin":"wàn shì dà jí","abbr":"wsdj","explanation":"吉：吉利，顺利。什么事都很圆满顺利。也指一切事情都已办好。","source":{"text":"盐官教谕黄谦之题桃符板，句云：‘宜人新年怎生呵？百事大吉那般者。’","book":"宋·周密《癸辛杂志》"},"example":{"text":"宋·周密《癸辛杂志》：“盐官教谕黄谦之题桃符板，句云：‘宜人新年怎生呵？百事大吉那般者。’”"},"similar":["万事亨通","大功告成"],"opposite":["艰难曲折","节外生枝"],"usage":"作谓语、宾语、分句；带讽刺"},{"id":1413,"word":"万事如意","pinyin":"wàn shì rú yì","abbr":"wsry","explanation":"如意：符合心意。一切都符合心意，很顺利。","source":{"text":"在组织和领导人民生产的事业上，我们也并非万事如意的。","book":"邓小平《太行区的经济建设》"},"example":{"text":"祝你～。"},"similar":["一帆风顺"],"usage":"作谓语；用于祝辞"},{"id":1414,"word":"万事开头难","pinyin":"wàn shì kāi tóu nán","abbr":"wsktn","explanation":"一切事情开始时头绪多，很难着手处理。"},{"id":1415,"word":"万事皆休","pinyin":"wàn shì jiē xiū","abbr":"wsjx","explanation":"皆：都；休：完结。指一切事情全都完结了。形容悲观失望，不想再有所作为。也表示什么事端都没有。","source":{"text":"宋江兵若不来，万事皆休。若是那夥蛮子来时，小将自出去与他相敌；若不活拿他几个，这厮们那里肯退？","book":"明·施耐庵《水浒全传》第八十四回"},"example":{"text":"快早送我师父出来，～！牙迸半个不字，你只看看手中钯，决不饶你！","book":"明·吴承恩《西游记》第四十九回"},"usage":"作谓语、定语；用于口语"},{"id":1416,"word":"万事起头难","pinyin":"wàn shì qǐ tóu nán","abbr":"wsqtn","explanation":"一切事情开始时头绪多，很难着手处理。","source":{"text":"俗语说万事起头难。","book":"清·黄小配《大马扁》第七回"},"example":{"text":"这几步棋我也想得出来。～，便是第一着怪棋，无论如何想不出。","book":"金庸《天龙八部》第三十一回"}},{"id":1417,"word":"万人一心","pinyin":"wàn rén yī xīn","abbr":"wryx","explanation":"一万人一条心。比喻众人团结一致。","source":{"text":"今率不习之人，越大陇之阻，将十举十危，而贼闻大军将至，必万人一心。","book":"《后汉书·傅燮传》"},"example":{"text":"～，尚不可当，况城中有数万死命之人乎？","book":"明·罗贯中《三国演义》第二回"}},{"id":1418,"word":"万人之敌","pinyin":"wàn rén zhī dí","abbr":"wrzd","explanation":"敌：对抗。指武艺高强可敌强敌。也指善于统帅军队以抵御强敌。亦作“万人敌”。","source":{"text":"关羽、张飞，皆称万人之敌，为世虎臣。","book":"晋·陈寿《三国志·蜀志·关羽等传评》"},"example":{"text":"智勇多能，学剑学书俱未成，待学～。","book":"明·沈采《千金记·励兵》"},"similar":["万人莫敌"],"usage":"作宾语；指勇武善战","story":["秦朝末年，项羽年少时对学问与剑道都没有什么大的兴趣，叔父项梁问他到底要学什么。项羽说要学可以敌万人的学问。项梁就教他兵法，他十分喜欢。秦始皇巡视到会稽时，项羽偷偷地说他可以取代他。不久他们就举起了义旗"]},{"id":1419,"word":"万人异心","pinyin":"wàn rén yì xīn","abbr":"wryx","explanation":"异：不同。指人多而不能一条心。","source":{"text":"千人同心，则得千人力；万人异心，则无一人之用。","book":"《淮南子·兵略训》"}},{"id":1420,"word":"万人敌","pinyin":"wàn rén dí","abbr":"wrd","explanation":"指武艺高强，善于领兵以抵御万人。","source":{"text":"剑一人敌，不足学，学万人敌。","book":"《史记·项羽本纪》"},"example":{"text":"只大寿有一兄弟名叫大弼，曾官副总兵，有万夫不当之勇，军中称为～。","book":"蔡东藩《清史演义》第八回"}},{"id":1421,"word":"万人空巷","pinyin":"wàn rén kōng xiàng","abbr":"wrkx","explanation":"空巷：街道里弄里的人全部走空。指家家户户的人都从巷里出来了。多形容庆祝、欢迎等盛况。","source":{"text":"赖有明朝看潮在，万人空巷斗新妆。","book":"宋·苏轼《八月十七复登望海楼》诗"},"example":{"text":"此时路旁看的，几于～，大马路虽宽，却也几乎有人满之患。","book":"清·吴趼人《二十年目睹之怪现状》第七十八回"},"similar":["万头攒动"],"opposite":["穷乡僻壤"],"usage":"作谓语、定语、分句；形容、欢迎等盛"},{"id":1422,"word":"万代一时","pinyin":"wàn dài yī shí","abbr":"wdys","explanation":"很多世代才有这么一个时机。极言机会难得。","source":{"text":"云行雨洽，天临地持。茫茫区宇，万代一时。","book":"《后汉书·隗嚣传》：“元请以一丸泥为大王东封函谷关，此万世一时也。”《乐府诗集·文舞阶步辞》"},"example":{"text":"台家府库空竭，复无器仗，三仓无米，东境饥流，此～也，机不可失。","book":"《梁书·陈伯之传》"},"similar":["万世一时","千载难逢"],"usage":"作定语；多指机会等"},{"id":1423,"word":"万代不易","pinyin":"wàn dài bù yì","abbr":"wdby","explanation":"易：改变。永远不改变。","source":{"text":"宫商角徵羽，此真正声也，万代不易。","book":"《六韬·龙韬·五音》"},"example":{"text":"与其认贼作父，为后世唾骂，何不奋发鹰扬，建立～之基？","book":"金庸《书剑恩仇录》第十一回"}},{"id":1424,"word":"万代之业","pinyin":"wàn dài zhī yè","abbr":"wdzy","explanation":"指传之万世不朽的大业。","source":{"text":"天下已定，始皇之心，自以为关中之固，金城千里，子孙帝王万世之业也。","book":"汉·贾谊《过秦论》"},"example":{"text":"张浚以陛下～，邀自己一时之功，知臣与朱温深仇，私相连结。","book":"蔡东藩《唐史演义》第九十六回"},"similar":["万世之业"],"usage":"作宾语；指功业等"},{"id":1425,"word":"万代千秋","pinyin":"wàn dài qiān qiū","abbr":"wdqq","explanation":"指经历年代极久远。亦作“万古千秋”、“万载千秋”。","source":{"text":"今巫祝之祝人曰：‘使若千秋万岁。’千秋万岁之声恬耳，而一日之寿无征于人，此人所以简巫祝也。","book":"《韩非子·显学》"},"example":{"text":"书方易折，家揭难留，镌兹幽石，～。","book":"晋·无名氏《平西将军周处碑》"},"similar":["世世代代","千秋万代"],"usage":"作宾语、定语；指时间久长"},{"id":1426,"word":"万众一心","pinyin":"wàn zhòng yī xīn","abbr":"wzyx","explanation":"千万人一条心。形容团结一致。","source":{"text":"万人一心，犹不可当，况十万乎！","book":"《后汉书·朱擕传》"},"example":{"text":"～，同声呼吁，力抗汉奸，唤醒政府。","book":"蔡东藩、许廑父《民国通俗演义》第一０八回"},"similar":["同心同德"],"opposite":["挂一漏万","各自为政"],"usage":"作谓语、定语；指团结一致","story":["东汉末年爆发了黄巾大起义，汉灵帝派朱隽率军去镇压，朱隽在城外堆了一个比城墙还高的山丘，对城内的情况了如指掌，用计攻下外城。义军将领韩忠和谈。朱隽不同意和谈，同时也不急于攻城，害怕城内的军民万众一心不好对付"]},{"id":1427,"word":"万众叶心","pinyin":"wàn zhòng yè xīn","abbr":"wzyx","explanation":"叶：和洽，相合。千万人一条心。","source":{"text":"仗大义而万众叶心，体至公而千里同契。","book":"唐·陆贽《授王武俊李抱真官封并招谕朱滔诏》"}},{"id":1428,"word":"万众睢睢","pinyin":"wàn zhòng suī suī","abbr":"wzss","explanation":"睢睢：仰视。所有人的眼睛都看着上面。形容人们共同期待或感到惊奇的神情。","source":{"text":"今雉以博士行礼之日大众聚会，飞集于庭，历阶登堂，万众睢睢，惊怪连日。","book":"《汉书·五行志中》"}},{"id":1429,"word":"万全之策","pinyin":"wàn quán zhī cè","abbr":"wqzc","explanation":"策：计策、办法。极其周到的计谋、办法。","source":{"text":"而道法万全，智能多失。夫悬衡而知平，设规而知圆，万全之道也。","book":"《韩非子·饰邪》"},"example":{"text":"必思一～，方可无虞。","book":"明·冯梦龙《东周列国志》第七十二回"},"similar":["锦囊妙计","万全之计"],"usage":"作主语、宾语；指最好的解决办法","story":["东汉末年，曹操和袁绍在官渡进行激战，袁绍派人去寻求刘表的支持。刘表与部将韩嵩、刘先商量。他们纷纷表示要支持曹操，认为袁绍没有实力。目前采取坐山观虎斗的策略，静观形势的发展。韩嵩则认为归附曹操可以荣华富贵，是一个万全之策"]},{"id":1430,"word":"万全之计","pinyin":"wàn quán zhī jì","abbr":"wqzj","explanation":"极其周到的计谋、办法。同“万全之策”。","source":{"text":"此诚出于险涂，非万全之计也。","book":"《三国志·蜀志·庞统传》“亲待亚于诸葛亮”裴松之注引《江表传》"},"example":{"text":"凡此者，皆因弱成强而～也。","book":"宋·陈亮《酌古论·封常青》"},"similar":["万全之策"],"opposite":["权宜之计"],"usage":"作主语、宾语；指最好的解决办法"},{"id":1431,"word":"万别千差","pinyin":"wàn bié qiān chā","abbr":"wbqc","explanation":"形容种类多，差别大。","source":{"text":"万别千差无觅处，得来元在鼻尖头。","book":"《大唐善导和尚集·证集序》：“说一切诸法，千差万别，如来观音，历历了然。”宋·释普济《五灯会元》卷二十"},"similar":["千差万别"],"usage":"作谓语、定语、宾语；形容有很多的不同"},{"id":1432,"word":"万剐千刀","pinyin":"wàn guǎ qiān dāo","abbr":"wgqd","explanation":"剐：割肉离骨。一刀一刀将罪犯身上的肉割下处死。形容罪恶重大，死也不能抵罪。","source":{"text":"即日押赴市曹，将他万剐千刀，凌迟处死。","book":"元·无名氏《盆儿鬼》第四折"},"example":{"text":"这如山似海的冤仇，如何不报？我誓必拿住这贼，～，方消我恨！","book":"清·吴璿《飞龙全传》第十回"},"similar":["千刀万剐"],"usage":"作谓语、宾语、定语；常用咒骂语"},{"id":1433,"word":"万劫不复","pinyin":"wàn jié bù fù","abbr":"wjbf","explanation":"佛教称世界从生成到毁灭的一个过程为一劫，万劫就是万世的意思。指永远不能恢复。","source":{"text":"莫将等闲空过时光，一失人身，万劫不复，不是小事。","book":"宋·释道原《景德传灯录》卷十九"},"example":{"text":"倘使连这一点反抗心都没有，岂不就成为～的奴才了？","book":"鲁迅这《华盖集续编·学界的三魂》"},"similar":["日暮途穷","山穷水尽"],"opposite":["百废俱兴"],"usage":"作谓语、定语；指永远不能恢复"},{"id":1434,"word":"万劫不朽","pinyin":"wàn jié bù xiǔ","abbr":"wjbx","explanation":"万劫：佛教称世界从生成到毁灭的一个过程为一劫，万劫就是万世的意思；朽：衰老，衰落。永远也不会衰落。","source":{"text":"故一善染心，万劫不朽，百灯旷照，千里通明。","book":"南朝·梁·萧纲《唱导文》"},"example":{"text":"一句染神，～。","book":"宋·释普济《五灯会元》卷十"}},{"id":1435,"word":"万变不离其宗","pinyin":"wàn biàn bù lí qí zōng","abbr":"wbblqz","explanation":"宗：宗旨、目的。尽管形式上变化多端，其本质或目的不变。","source":{"text":"不离于宗，谓之天人。","book":"《荀子·儒效》：“千举万变，其道一也。”《庄子·天下》"},"example":{"text":"求夫辞有体要，万变而不离其宗。","book":"清·谭献《明诗》"},"opposite":["变幻莫测"],"usage":"作宾语、分句；指形式上变化本质不变"},{"id":1436,"word":"万口一词","pinyin":"wàn kǒu yī cí","abbr":"wkyc","explanation":"比喻意见一致。同“万口一辞”。","source":{"text":"现在万口一词，愿立永康王，不可更改。","book":"范文澜、蔡美彪等《中国通史》第四编第三章第一节"},"similar":["万口一辞","众口一词","异口同声"],"usage":"作谓语、定语；比喻意见一致"},{"id":1437,"word":"万口一谈","pinyin":"wàn kǒu yī tán","abbr":"wkyt","explanation":"千千万万人说同样的话。比喻意见一致。","source":{"text":"今内而百官，外而军民，万口一谈，皆欲食伦之肉。","book":"《宋史·胡铨传》"},"similar":["万口一辞"],"usage":"作谓语、定语；比喻意见一致"},{"id":1438,"word":"万口一辞","pinyin":"wàn kǒu yī cí","abbr":"wkyc","explanation":"千千万万人说同样的话。比喻意见一致。","source":{"text":"群疑胶牢，万口一辞。","book":"唐·孙樵《武皇遗剑录》"},"example":{"text":"～，不可破也。","book":"明·李贽《题孔子像于芝佛院》"},"similar":["众口一词","异口同声"],"usage":"作谓语、定语；比喻意见一致"},{"id":1439,"word":"万古不变","pinyin":"wàn gǔ bù biàn","abbr":"wgbb","explanation":"万世不改变。","source":{"text":"他们一心向往的，就是从先生那里学来的据说是万古不变的教条。","book":"毛泽东《改造我们的学习》"},"similar":["千古不变","一成不变"],"opposite":["千变万化"],"usage":"作谓语、定语；用于事物等"},{"id":1440,"word":"万古不朽","pinyin":"wàn gǔ bù xiǔ","abbr":"wgbx","explanation":"朽：腐烂。千秋万代永垂不朽。","example":{"text":"大丈夫当建～之功业。"},"similar":["万世不朽"],"usage":"作谓语、定语；多用于功名事业等"},{"id":1441,"word":"万古不磨","pinyin":"wàn gǔ bù mó","abbr":"wgbm","explanation":"万古：永远；磨：磨灭，消失。永远不会消失。","source":{"text":"千里之差，兴自毫端，失得之源，百世不磨矣。","book":"《后汉书·南匈奴传》"},"example":{"text":"便是文章，也未必独有～的典则。","book":"鲁迅《华盖集续编·古书与白话》"},"similar":["千古不磨"],"usage":"作谓语、定语；用于功绩等"},{"id":1442,"word":"万古千秋","pinyin":"wàn gǔ qiān qiū","abbr":"wgqq","explanation":"形容延续的时间极久。","source":{"text":"齐心楼上望浮云，万古千秋空姓名。","book":"唐·周朴《望中怀古》"},"example":{"text":"～业，天下为公器。","book":"陈毅《湖海诗社开征引》"},"similar":["千秋万代","万古长存"],"usage":"作谓语、定语；指时间长久"},{"id":1443,"word":"万古常新","pinyin":"wàn gǔ cháng xīn","abbr":"wgcx","explanation":"万古：千年万代。千秋万代都像松柏一样永远苍翠。比喻崇高的精神或深厚的友谊永远不会消失。","source":{"text":"你是一座革命的丰碑，屹立于宇宙间，万古常新！","book":"徐迟《井冈山记》"},"similar":["万古长青","万古长春"],"usage":"作谓语、定语；指精神或友谊等"},{"id":1444,"word":"万古流芳","pinyin":"wàn gǔ liú fāng","abbr":"wglf","explanation":"芳：香，指美名。好名声永远流传。","source":{"text":"子欲为名高也，则当如许由、子威、卞随、务光，洗耳逃禄，千载流芳。","book":"南朝宋·刘义庆《世说新语·排调》：“头责秦子羽云。”刘孝标注引张敏《头责子羽文》"},"example":{"text":"汉廷黯忠，唐室魏征良，见如今千载明扬，～。","book":"元·无名氏《延安府》第三折"},"similar":["名垂青史","万古留芳"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指好名声永远流传"},{"id":1445,"word":"万古留芳","pinyin":"wàn gǔ liú fāng","abbr":"wglf","explanation":"万古：千年万代；芳：香，好名声。好名声永远流传","source":{"text":"老宰辅，你若存的赵氏孤儿，当名垂青史，万古留芳。","book":"元·纪君祥《赵氏孤儿》第二折"},"similar":["万古流芳"],"usage":"作谓语、定语；指好名声永远流传"},{"id":1446,"word":"万古长存","pinyin":"wàn gǔ cháng cún","abbr":"wgcc","explanation":"万古：千秋万代。指某种好的精神或品德永远存在。","source":{"text":"公归廊庙谁得挽，此石万古当长存。","book":"宋·晁补之《次韵苏门下寄题雪浪石》"},"example":{"text":"他的丰功伟绩～。"},"similar":["万古长青","千秋万代"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指好的精神或品德"},{"id":1447,"word":"万古长新","pinyin":"wàn gǔ cháng xīn","abbr":"wgzx","explanation":"万古：千秋万代，永远。永远是新的。指某种好的精神或品德永远存在。"},{"id":1448,"word":"万古长春","pinyin":"wàn gǔ cháng chūn","abbr":"wgcc","explanation":"万古：千年万代，永远。永远像春天一样，草木翠绿，生机勃勃。比喻人的精神永远像春天一样毫不衰退或祝愿好事长存。亦作“万古长青”、“万古常青”、“万古常新","source":{"text":"长国姑除邪去害，保忠良重镇关津。也论功增封食邑，共皇家万古长春。","book":"元·无名氏《谢金吾》第四折"},"example":{"text":"杨朔《三千里江山》：“开遍整个江山的也不再是旧日王朝的无穷花，而是人类历史上～的英雄花。”"},"similar":["万古长青","万古常新"],"usage":"作谓语、定语；指精神或友谊等"},{"id":1449,"word":"万古长青","pinyin":"wàn gǔ cháng qīng","abbr":"wgcq","explanation":"万古：千秋万代。千秋万代都象松柏一样永远苍翠。比喻崇高的精神或深厚的友谊永远不会消失。","source":{"text":"也论功增封食邑，共皇家万古长春。","book":"元·无名氏《谢金梧》第四折"},"example":{"text":"不信请看看我们～的祖国吧，那一天不在开着各色各样的奇花？","book":"杨朔《迎春词》"},"similar":["万古长存","欣欣向荣"],"opposite":["每况愈下"],"usage":"作谓语、定语；指精神或友谊等"},{"id":1450,"word":"万国来朝","pinyin":"wàn guó lái cháo","abbr":"wglc","explanation":"万：概数，多；朝：朝贡，朝拜。很多国家来朝拜。","source":{"text":"太平年万国来朝，雍熙世八仙庆寿。","book":"明·施耐庵《水浒传》第82回"},"example":{"text":"清·无名氏《刘公案》第一回：“～纳进奉，朝出贤臣刘墉：出口成章合圣明，这才亚似孔孟。”"},"usage":"作谓语、定语；用于太平盛世"},{"id":1451,"word":"万壑争流","pinyin":"wàn hè zhēng liú","abbr":"whzl","explanation":"壑：深沟，借指溪流。许多溪水竞相奔流。形容山中胜景。","source":{"text":"顾长康从会稽还，人问山川之美，顾云：‘千岩竞秀，万壑争流，草木蒙笼其上，若云兴霞蔚。’","book":"南朝宋·刘义庆《世说新语·言语》"},"example":{"text":"～，千岩竞秀。鸟啼人不见，花落树犹香。","book":"明·吴承恩《西游记》第十七回"},"similar":["千岩竞秀"],"usage":"作宾语、定语；形容山中胜景"},{"id":1452,"word":"万壑千岩","pinyin":"wàn hè qiān yán","abbr":"whqy","explanation":"形容峰峦、山谷极多。","source":{"text":"顾长康从会稽还，人问山川之美，顾云：‘千岩竞秀，万壑争流。’","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"渡～，越溪深处。","book":"宋·柳永《夜半乐》词"},"similar":["千山万壑","层峦叠嶂"],"opposite":["一马平川"],"usage":"作定语、宾语；形容峰峦、山谷极多"},{"id":1453,"word":"万夫不当","pinyin":"wàn fū bù dāng","abbr":"wfbd","explanation":"夫：人。当：抵挡。上万个人也抵挡不住。形容人非常勇猛。亦作“万夫莫当”。","source":{"text":"此子六韬三略皆能，有万夫不当之勇。","book":"元·无名氏《衣袄车》第一折：“自幼学成十八般武艺，寸铁在手，有万夫不当之勇。”元·施君美《幽闺记·罔害璠良》"},"example":{"text":"俺左良玉立功边寨，～，也是天下一个好健儿。","book":"清·孔尚任《桃花扇·哭主》"},"similar":["万夫莫当"],"usage":"作谓语、定语；指人勇力超群"},{"id":1454,"word":"万夫不当之勇","pinyin":"wàn fū bù dāng zhī yǒng","abbr":"wfbdzy","explanation":"当：抵挡。一万个人也抵挡不住。形容非常勇敢。","source":{"text":"想关云长但上阵处，凭着他坐下马、手中刀、鞍上将，有万夫不当之勇。","book":"元·关汉卿《单刀会》第一折"},"example":{"text":"你的～，就这样被一两个阴险的奸贼葬送了！","book":"郭沫若《孔雀胆》第四幕"},"similar":["万夫不当"],"usage":"作宾语；比喻非常勇敢"},{"id":1455,"word":"万夫之勇","pinyin":"wàn fū zhī yǒng","abbr":"wfzy","explanation":"形容非常勇敢。","source":{"text":"吾有万夫之勇，岂惧他人哉！今夜乘着月色，正好使粮车行走。","book":"明·罗贯中《三国演义》第七十二回"},"example":{"text":"他还有二个兄弟，有～；一个妹子，有妖法之能；手下有许多徒弟，五千喽兵。","book":"清·吴璿《飞龙全传》第二十回"},"similar":["万夫不当之勇"],"usage":"作宾语；比喻非常勇敢"},{"id":1456,"word":"万夫之长","pinyin":"wàn fū zhī zhǎng","abbr":"wfzz","explanation":"夫：人长：首领。万人中的首领。","source":{"text":"万夫之长，可以生谋。","book":"《尚书·咸有一德》"},"example":{"text":"能以万夫耕者，授以万夫之田，为～，千夫、百夫亦如之，察其惰者而易之。","book":"清·毕沅《续资治通鉴》卷二百十三"}},{"id":1457,"word":"万夫莫当","pinyin":"wàn fū mò dāng","abbr":"wfmd","explanation":"形容非常勇敢。同“万夫不当之勇”。","source":{"text":"吾闻公子庆忌，筋骨如铁，万夫莫当。","book":"《东周列国志》第七三回"},"similar":["万夫不当","万夫莫敌"],"usage":"作谓语、定语；指作战非常勇猛"},{"id":1458,"word":"万夫莫敌","pinyin":"wàn fū mò dí","abbr":"wfmd","explanation":"敌：匹敌。一万个人也抵挡不住。形容非常勇敢。","source":{"text":"传授道术，神鬼皆惊，胸藏韬略，万夫莫敌，你如何轻视此人？","book":"明·许仲琳《封神演义》第三回"},"example":{"text":"那高行周排兵布阵，引诱埋伏，件件皆精；况其子高怀德勇冠三军，～。","book":"清·吴璿《飞龙全传》第四十三回"},"similar":["万夫莫当","万夫不当"],"usage":"作谓语、定语；指作战非常勇猛"},{"id":1459,"word":"万头攒动","pinyin":"wàn tóu cuán dòng","abbr":"wtcd","explanation":"头：指人；攒：聚在一起。形容许多人聚集在一起。","source":{"text":"到了云栖山门口，早就挤得人山人海，但见万头攒动，和啧啧称羡的声音。","book":"《雪岩外传》第十一回"},"example":{"text":"时候虽早，那看榜的人，却也～。（清·吴趼人《二十年目睹之怪现状》第四十三回）"},"usage":"作谓语、定语；形容人多"},{"id":1460,"word":"万室之国","pinyin":"wàn shì zhī guó","abbr":"wszg","explanation":"万室：万户。有万户居民的国家。多指古代小诸侯国。","source":{"text":"上地方八十里，万室之国一，千室之都四。","book":"《孟子·告子下》：“子之道，貉道也。万室之国，一人陶，则可乎？”《管子·乘马》"}},{"id":1461,"word":"万室之邑","pinyin":"wàn shì zhī yì","abbr":"wszy","explanation":"万室：万户；邑：城镇，指封地。有万户居民的城镇。","source":{"text":"四战之国，不能以万室之邑，舍巨万之军者，国危。","book":"《商君书·兵守》"},"example":{"text":"古者平准之法，使～，必有万钟之藏，千室之邑，必有千钟之藏。","book":"《旧唐书·食货志下》"}},{"id":1462,"word":"万家之侯","pinyin":"wàn jiā zhī hóu","abbr":"wjzh","explanation":"指诸侯，周王朝分封的诸侯有大小，根据每个诸侯统治的家庭而决定。","source":{"text":"万家之侯。","book":"西汉·司马迁《史记·货殖列传》"},"similar":["万户侯"],"usage":"作主语、宾语、定语；指诸侯"},{"id":1463,"word":"万家灯火","pinyin":"wàn jiā dēng huǒ","abbr":"wjdh","explanation":"家家点上了灯。指天黑上灯的时候。也形容城市夜晚的景象。","source":{"text":"万家灯火吹箫路，五夜星辰赌酒天。","book":"清·曾朴《孽海花》第八回"},"example":{"text":"签后当日送出，我回家时已经～了。","book":"邹韬奋《抗战以来·临行的一封信》"},"similar":["灯火辉煌"],"opposite":["灯火阑珊"],"usage":"作谓语、宾语、定语；形容城市夜晚"},{"id":1464,"word":"万家生佛","pinyin":"wàn jiā shēng fó","abbr":"wjsf","explanation":"旧时指受百姓爱戴的地方官。","source":{"text":"福星一路之歌谣，生佛万家之香火。","book":"宋·戴翼《贺陈待制启》"},"example":{"text":"海文南归留不住，～把香烧。","book":"吴晗《海瑞罢官·罢官》"},"similar":["生佛万家"],"usage":"作主语、宾语、定语；指受百姓爱戴的地方官","story":["宋朝时期，著名的儒学家、历史学家、政治家司马光被封为温国公，他以关心国事、清廉正直著称，被人赞为“万家生佛”，宋人称赞他的诗句有：“福星一路之歌谣，生佛万家之香火。”"]},{"id":1465,"word":"万寿无疆","pinyin":"wàn shòu wú jiāng","abbr":"wswj","explanation":"疆：界限。万年长寿，永远生存。用于祝人长寿。","source":{"text":"君曰卜尔，万寿无疆。","book":"《诗经·小雅·天保》"},"example":{"text":"陛下已过大难，定然～。","book":"清·陈忱《水浒后传》第三十七回"},"similar":["寿比南山","极寿无疆"],"usage":"作谓语、定语；用于祝人长寿","story":["我国最早的诗集《诗经》中有描写农奴的生活图景，农奴们一年忙到头，过着吃不饱穿不暖的生活，而他们的主人们每天都是过着莺歌燕舞的生活。他们每年都要搞年终宴会，杀猪宰羊，登上父夜堂，端起酒杯互相祝福“万寿无疆”"]},{"id":1466,"word":"万岁千秋","pinyin":"wàn suì qiān qiū","abbr":"wsqq","explanation":"犹言千秋万代，形容岁月长久。亦作“千秋万岁”。","source":{"text":"于是楚王游于云梦……仰天而笑曰：‘乐矣，今日之游也。寡人万岁千秋之后，谁与此乐矣？’","book":"《战国策·楚策一》"},"example":{"text":"九洲四海常无事，～乐未央。","book":"唐·卢照邻《登封大酺歌》"},"similar":["千秋万岁"],"usage":"作谓语、宾语、状语；形容岁月长久"},{"id":1467,"word":"万年之后","pinyin":"wàn nián zhī hòu","abbr":"wnzh","explanation":"指死亡以后。","source":{"text":"苟身亡事，畜乱宿祸，孰视而不定，万年之后，传之老母弱子，将使不宁，不可谓仁。","book":"《汉书·贾谊传》"},"example":{"text":"俾～，庙号世宗，子孙百世不迁，顾不伟欤？","book":"《明史·王准传》"}},{"id":1468,"word":"万年之日","pinyin":"wàn nián zhī rì","abbr":"wnzr","explanation":"指死亡的日子。","source":{"text":"太后闻之曰：‘万年之日长恨矣。’","book":"《后汉书·马皇后纪》"}},{"id":1469,"word":"万年之计","pinyin":"wàn nián zhī jì","abbr":"wnzj","explanation":"极长久的计划。","source":{"text":"今将军规万年之计，建不世之略，绝僭逆之虏，顺天人之肃，济成洪业，功无与比，齐鲁之事，奚足言哉！","book":"《三国志·吴志·吴主传》裴松之注引《江表传》"},"example":{"text":"南北讨论之时，唐绍仪因一时之感动，未察国家～，主持共和，不可谓非失策矣。","book":"丁中江《北洋军阀史话》七十二"}},{"id":1470,"word":"万年无疆","pinyin":"wàn nián wú jiāng","abbr":"wnwj","explanation":"形容年代久远。同“万世无疆”。","source":{"text":"庶邦有众，愿效忠臣之心，万年无疆，请祝圣人之寿。","book":"宋·陈师道《代贺兴龙节表》"},"example":{"text":"是希望～的与宇宙共悠久的全中国的历史，每一页都充满着‘五四’运动的精神。","book":"郭沫若《羽书集·青年化永远青年化》"},"similar":["万世无疆"],"usage":"作谓语、定语；用于书面语"},{"id":1471,"word":"万年遗臭","pinyin":"wàn nián yí chòu","abbr":"wnyc","explanation":"遗臭：死后留下的恶名。死后恶名一直流传，永远被人唾骂。","source":{"text":"既不能流芳后世，亦不足复遗臭万载耶！","book":"南朝·宋·刘义庆《世说新语·尤悔》"},"example":{"text":"将军乃将门之后，武艺超群，为何失身于绿林？岂不有拈祖宗，～！","book":"清·钱彩《说岳全传》第四十七回"}},{"id":1472,"word":"万年长存","pinyin":"wàn nián cháng cún","abbr":"wncc","explanation":"万年：久远。指精神或品德永世长存。","source":{"text":"刻着以红星、松柏和旗帜组成的装饰花纹，象征着先烈们的革命精神万年长存，永远照耀着后代。","book":"周定舫《人民英雄永垂不朽》"},"similar":["永世长存"],"usage":"作谓语、定语；用于事业或精神等"},{"id":1473,"word":"万应灵丹","pinyin":"wàn yìng líng dān","abbr":"wyld","explanation":"能治各种病的灵药。比喻一种能解决各种疑难问题的办法。","example":{"text":"世界上没有～的。"},"similar":["万应灵药"],"usage":"作主语、宾语；同“灵丹妙药”"},{"id":1474,"word":"万应灵药","pinyin":"wàn yìng líng yào","abbr":"wyly","explanation":"能治各种病的灵药。比喻能解决任何问题的好办法。","source":{"text":"不过我们中国人是聪明的，有些人早已发明了一种万应灵药，就是‘今天天气……哈哈哈！'","book":"鲁迅《花边文学·看书琐记（二）》"},"example":{"text":"只能说比较好，要说完全正确，我看办不到，～我们不可能找到，还要看以后的实践。","book":"邓小平《关于经济工作的几点意见》"},"similar":["灵丹妙药"],"usage":"作主语、宾语；同“灵丹妙药”"},{"id":1475,"word":"万念俱寂","pinyin":"wàn niàn jù jì","abbr":"wnjj","explanation":"俱：全部。所有的欲望、打算都消失了。","source":{"text":"脑子同时开着小差，胡思乱想，甚至万念俱寂，视一切于无睹。","book":"王朔《浮出海面》"},"example":{"text":"他现在是万念俱寂，什么也不想了。"},"similar":["万念俱灰"],"opposite":["生气勃勃","雄心壮志"],"usage":"作谓语、定语、分句；用于人"},{"id":1476,"word":"万念俱灰","pinyin":"wàn niàn jù huī","abbr":"wnjh","explanation":"所有的想法和打算都破灭了。形容极端灰心失望的心情。","source":{"text":"官场上的人情，最是势利不过的。大家见抚台不理，谁还来理我呢，想到这里，万念俱灰。","book":"清·李宝嘉《中国现在记》第三回"},"example":{"text":"我明白自己会活不到多久了，霎时间～，稍微感觉到死底恐怖。","book":"巴金《新生·三月二十三日》"},"similar":["灰心丧气","大失所望"],"opposite":["雄心勃勃","意气风发"],"usage":"作宾语、定语；指失望"},{"id":1477,"word":"万恨千愁","pinyin":"wàn hèn qiān chóu","abbr":"whqc","explanation":"千、万：形容多。指忧愁怨恨很多。","source":{"text":"钟送黄昏鸡报晓，昏晓相摧，世事何时了。万恨千愁人自老，春来依旧生芳草。","book":"宋·王诜《蝶恋花》"}},{"id":1478,"word":"万恶之源","pinyin":"wàn è zhī yuán","abbr":"wezy","explanation":"一切坏事的根源所在。","example":{"text":"有段时间，他内心痛苦，打起方枪枪来好像他是～。","book":"王朔《看上去很美》第九章"}},{"id":1479,"word":"万户千门","pinyin":"wàn hù qiān mén","abbr":"whqm","explanation":"指众多人家。也形容屋宇深广。","source":{"text":"万户千门皆寂寂，月中清露点朝衣。","book":"唐·李德裕《长安秋夜》诗"},"example":{"text":"转过墙屋，导至一外，叠阁重楼，万椽相接，曲折而行，觉～，迥非人世。","book":"清·蒲松龄《聊斋志异·莲花公主》"},"similar":["千门万户"],"usage":"作定语、宾语；形容房屋广大或住户众多"},{"id":1480,"word":"万折必东","pinyin":"wàn zhé bì dōng","abbr":"wzbd","explanation":"河流不论有多少曲折，最后都东流入海。比喻事物不管有什么曲折，总要按着应有的规律发展。","source":{"text":"以出以入，以就鲜絜，似善化。其万折也必东，似志。是故君子见大水必观焉。","book":"《荀子·宥坐》"},"example":{"text":"言鸿之往来有候，居处有常，犹水之流必循理，～，以喻君子之仕非其道不由，非其位不处也。","book":"汉·扬雄《法言义疏·学行》"}},{"id":1481,"word":"万斛泉源","pinyin":"wàn hú quán yuán","abbr":"whqy","explanation":"斛：十斗。本指泉源丰富。后比喻文思敏捷。","source":{"text":"吾文如万斛泉源，不择地而出。","book":"宋·苏轼《文说》"}},{"id":1482,"word":"万方多难","pinyin":"wàn fāng duō nàn","abbr":"wfdn","explanation":"万方：全国各地，也指全国人民。形容国家和人民饱受灾难。","source":{"text":"花近高楼伤客心，万方多难此登临。","book":"唐·杜甫《登楼》"},"example":{"text":"今日何年？共诸君几许头颅，来此一堂痛饮；～，与四海同胞手足，竞雄廿纪新元。","book":"蔡东藩《清史演义》第九十四回"}},{"id":1483,"word":"万无一失","pinyin":"wàn wú yī shī","abbr":"wwys","explanation":"失：差错。指非常有把握，绝对不会出差错。","source":{"text":"孔老览观，孟子持筹而算之，万不失一。","book":"《史记·淮队侯列传》：“以此参之，万不失一。”汉·枚乘《七发》"},"example":{"text":"郑成功安慰她，只要仙霞岭守得住，延平～！","book":"华而实《汉衣冠》二"},"similar":["十拿九稳","稳操胜券"],"opposite":["挂一漏万"],"usage":"作谓语、定语、状语；形容有绝对把握","story":["公元前203年，汉将韩信灭了齐国，被刘邦封为齐王，韩信的谋士蒯通分析天下形势后认为韩信是举足轻重的人物，劝他不要跟随刘邦自立为王，可以与楚汉三分天下，跟随刘邦最多也只能封为诸侯，成败在于决断，现在行动可以万无一失。韩信没听蒯通的"]},{"id":1484,"word":"万无失一","pinyin":"wàn wú shī yī","abbr":"wwsy","explanation":"失：差错。指非常有把握，绝对不会出差错。","source":{"text":"孔老览观，孟子持筹而算之，万不失一。","book":"《史记·淮阴侯列传》：“贵贱在于骨法，忧喜在于容色，成败在于决断，以此参之，万不失一。” 汉·枚乘《七发》"},"example":{"text":"子诚能如是，心无异缘，六根自静，默然而究，～也。","book":"宋·释普济《五灯会元》卷十七"},"similar":["万无一失","万不失一"],"usage":"作谓语、定语、状语；形容有绝对把握"},{"id":1485,"word":"万无此理","pinyin":"wàn wú cǐ lǐ","abbr":"wwcl","explanation":"万：绝对，完全。绝对没有这个道理。","source":{"text":"假如释氏能与人为祸崇，非守道君子之所惧也，况万万无此理。","book":"唐·韩愈《与孟尚书书》"},"example":{"text":"进退台谏，权在人主；若由学校，～。","book":"清·毕沅《续资治通鉴》卷一百七十四"}},{"id":1486,"word":"万有不齐","pinyin":"wàn yǒu bù qí","abbr":"wybq","explanation":"指世上一切事物并不整齐划一而是各有各的特殊情况。","example":{"text":"横转各有五子，而～之声摄于此矣。","book":"《清史稿·刘献廷传》"}},{"id":1487,"word":"万条寒玉","pinyin":"wàn tóu hán yù","abbr":"wthy","explanation":"寒玉：竹的别称。指万株绿竹。","source":{"text":"门外商晴秋色老，万条寒玉一溪烟。","book":"唐·雍陶《韦处士郊居》"}},{"id":1488,"word":"万死一生","pinyin":"wàn sǐ yī shēng","abbr":"wsys","explanation":"死的可能极大，活的希望极小。比喻冒生命危险。","source":{"text":"身游万死一生地，路入千峰百嶂中。","book":"汉·司马迁《报任少卿书》：“夫人臣出万死不顾一生之计，赴公家之难，斯已奇矣。”宋·陆游《晚泊》诗"},"example":{"text":"有当时一个遗民，于～之中，逃出性命，做了一本《扬州十日记》，叙述杀戮之惨。","book":"清·陈天华《狮子吼》第二回"},"similar":["九死一生"],"usage":"作谓语；同“九死一生”","story":["隋朝末年，李渊奉命到山西镇压起义军，受到隋炀帝的监视。李世民劝李渊起兵反隋。李渊在太原起兵，立国号唐。李世民率领尉迟敬德、秦叔宝、张亮等出生入死，经过无数次战役才平定天下，李世民自我感慨万死一生才取得政权"]},{"id":1489,"word":"万死不辞","pinyin":"wàn sǐ bù cí","abbr":"wsbc","explanation":"万死：死一万次，形容冒生命危险。万一万次也不推辞。表示愿意拼死效劳。","source":{"text":"但有使令，万死不辞！","book":"明·罗贯中《三国演义》第八回"},"example":{"text":"什么时候用到我，随叫随到，～！","book":"檀林《旧都遗梦》"},"similar":["视死如归","出生入死","在所不辞"],"opposite":["贪生怕死","畏首畏尾"],"usage":"作谓语；表示愿意拼死效劳","story":["东汉末年，董卓掌握朝中大权，骄横跋扈，为自己修筑宫殿，准备篡位。忠臣王允担心汉室江山，他问自家歌妓貂禅能否帮他的忙。貂禅说她为大人做事万死不辞，于是王允将貂禅许配给吕布后，又进献给董卓，借吕布的手杀了董卓"]},{"id":1490,"word":"万死犹轻","pinyin":"wàn sǐ yóu qīng","abbr":"wsyq","explanation":"处死万次，还嫌惩罚太轻。极言罪大。","source":{"text":"臣以狂妄戆愚，不识礼度，上表陈佛骨事，言涉不敬，正名定罪，万死犹轻。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"云喘息而言曰：“赵云之罪，～。”","book":"明·罗贯中《三国演义》第四十二回"},"similar":["罪该万死"],"usage":"作谓语；指罪该万死"},{"id":1491,"word":"万殊一辙","pinyin":"wàn shū yī zhé","abbr":"wsyz","explanation":"殊：不同、差异；辙：车轮在路上轧出的痕迹。指一切事物都有差别，但道理都是一样。","source":{"text":"爰造异论，肝胆楚越，惟同大观，万殊一辙。","book":"晋·卢谌《赠刘琨》"}},{"id":1492,"word":"万殊之妙","pinyin":"wàn shòu zhī miào","abbr":"wszm","explanation":"殊：不同，差异。各种事物间千差万别的奥妙。","source":{"text":"挟情适事，不观万殊之妙。","book":"晋·陆机《演连珠》"}},{"id":1493,"word":"万民涂炭","pinyin":"wàn mín tú tàn","abbr":"wmtt","explanation":"涂：泥淖；炭：炭火。万民如同陷入泥淖坠入火海一般。形容广大百姓陷入极端困苦的境地。","source":{"text":"有夏昏德，民坠涂炭。","book":"《尚书·仲虺之诰》"},"example":{"text":"其时四野萧条，～。","book":"清·陈忱《水浒后传》第二十四回"},"similar":["生灵涂炭"],"usage":"作谓语、宾语；指民不聊生"},{"id":1494,"word":"万水千山","pinyin":"wàn shuǐ qiān shān","abbr":"wsqs","explanation":"万道河，千重山。形容路途艰难遥远。","source":{"text":"离别河边绾柳条，千山万水玉人遥。","book":"唐·张乔《寄维阳故人》诗"},"example":{"text":"～路，孤舟几月程。","book":"唐·贾岛《送耿处士》诗"},"similar":["千山万水"],"usage":"作主语、宾语；形容路途艰难遥远"},{"id":1495,"word":"万流景仰","pinyin":"wàn liú jǐng yǎng","abbr":"wljy","explanation":"为各方面的人所敬仰。","example":{"text":"历代圣贤或立功、或立言、或立德，而永为～。"}},{"id":1496,"word":"万涂一辙","pinyin":"wàn tú yī zhé","abbr":"wtyz","explanation":"涂：通“途”；辙：车轮在路上轧出的痕迹。指一切事物都有差别，但道理都是一样。","source":{"text":"爰造异论，肝胆楚越，惟同大观，万殊一辙。","book":"晋·卢谌《赠刘琨》"}},{"id":1497,"word":"万物一府","pinyin":"wàn wù yī fǔ","abbr":"wwyf","explanation":"府：收藏财物的地方。所有的财物收藏在一起。指事物一体，无所分别。","source":{"text":"若然者，藏金于山，藏珠于渊；不利货财，不近贵富；不乐寿，不哀夭；不荣通，不丑穷；不拘一世之利以为己私分，不以王天下为己处显。显则明，万物一府，死生同状。","book":"《庄子·天地》"}},{"id":1498,"word":"万物一马","pinyin":"wàn wù yī mǎ","abbr":"wwym","explanation":"事物虽复杂，但用一匹马的道理就可以概括。指剖析一件事物就可以了解其它事物的道理。","source":{"text":"天地一指也，万物一马也。","book":"《庄子·齐物论》"},"example":{"text":"天地一指，绝诤竞之心。～，无是非之论。","book":"宋·释普济《五灯会元》卷十七"}},{"id":1499,"word":"万物不能移","pinyin":"wàn wù bù néng yí","abbr":"wwbny","explanation":"万物都不能改变其本性。","source":{"text":"山公举阮咸为吏部郎，目曰：‘清真寡欲，万物不能移也。’","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"阮咸贞素寡欲，深识清浊，～，若在官人之职，必绝于时。","book":"《晋书·阮咸传》"}},{"id":1500,"word":"万物之宜","pinyin":"wàn wù zhī yí","abbr":"wwzy","explanation":"宜：应该，应当。指万物的事理。","source":{"text":"万物之宜，非柔则刚。","book":"《列子·天瑞》"},"example":{"text":"宰相上理阴阳，下遂～，外镇抚四夷，内亲附百生。","book":"清·毕沅《续资治通鉴》卷一百八十九"}},{"id":1501,"word":"万物之情","pinyin":"wàn wù zhī qíng","abbr":"wwzq","explanation":"所有事物的情状。","source":{"text":"盖师是而无非，师治而无乱乎？是未明天地之理，万物之情也。","book":"《庄子·秋水》"},"example":{"text":"必先处晦而观明，处静而观动，则～毕陈于前。","book":"清·毕沅《续资治通鉴》卷八十三"}},{"id":1502,"word":"万物之灵","pinyin":"wàn wù zhī líng","abbr":"wwzl","explanation":"万物：泛指天地间的所有生物；灵：聪明、灵巧。世上一切物种中最有灵性的。指人而言。","source":{"text":"惟天地万物父母，惟人万物之灵。","book":"《尚书·泰誓上》"},"example":{"text":"心正，手足正；心不正，则手足不正。心乃～苗，四象变化之根本。","book":"明·许仲琳《封神演义》第二十六回"}},{"id":1503,"word":"万物之祖","pinyin":"wàn wù zhī zǔ","abbr":"wwzz","explanation":"祖：始，开始。一切事物的开始。","source":{"text":"一上一下，以和为量，浮游乎万物之祖。","book":"《庄子·山木》"},"example":{"text":"道体为一，天地之元，～也。","book":"《宋史·律历志四》"}},{"id":1504,"word":"万物唯人为贵","pinyin":"wàn wù wéi rén wéi guì","abbr":"wwwrwg","explanation":"在万物之中人是最可贵的。","source":{"text":"天生万物唯人为贵，吾既已得为人，是一乐也。","book":"汉·刘向《说苑·杂言》"}},{"id":1505,"word":"万物并作","pinyin":"wàn wù bìng zuò","abbr":"wwbz","explanation":"一切事物一齐生长、发展。","source":{"text":"致虚极，守静笃，万物并作，吾以观复。","book":"《老子》第十六章"}},{"id":1506,"word":"万物无全用","pinyin":"wàn wù wú quán yòng","abbr":"wwwqy","explanation":"世间万物都各有其用，不能求其全能。","source":{"text":"天地无全功，圣人无全能，万物无全用。","book":"《列子·天瑞》"}},{"id":1507,"word":"万物更新","pinyin":"wàn wù gēng xīn","abbr":"wwgx","explanation":"更：变更。事物或景象改换了样子，出现了一番新气象。","source":{"text":"如今正是初春时节，万物更新，正该鼓舞另立起来才好。","book":"清·曹雪芹《红楼梦》第七十回"}},{"id":1508,"word":"万物殷富","pinyin":"wàn wù yīn fù","abbr":"wwyf","explanation":"国家富庶殷实。","source":{"text":"讨暴秦，诛彊楚，为天下兴利除害，继五帝三王之业，统理中国。中国之人以亿计，地方万里，居天下之膏腴，人众车轝，万物殷富，政由一家，自天地剖泮未始有也。","book":"《史记·郦生陆贾列传》"}},{"id":1509,"word":"万物皆备于我","pinyin":"wàn wù jiē bèi yú wǒ","abbr":"wwjbyw","explanation":"于：表示被动。万事万物都为我所具备。指世上的一切完全为我所有。","source":{"text":"万物皆备于我矣。反身而诚，乐莫大焉；强恕而行，求仁莫近焉。","book":"《孟子·尽心上》"}},{"id":1510,"word":"万物自化","pinyin":"wàn wù zì huà","abbr":"wwzh","explanation":"自化：自然变化。一切事物都按照本身的规律而自然变化。","source":{"text":"侯王若能守之，万物将自化。","book":"《老子》第三十七章"}},{"id":1511,"word":"万目睚眦","pinyin":"wàn mù yá zì","abbr":"wmyz","explanation":"睚：眼角；眦：眼框；睚眦：瞪眼睛。众人瞪目表示愤怒。","source":{"text":"百口嘲谤，万目睚眦。","book":"清·曹雪芹《红楼梦》第五回"},"usage":"作谓语、定语；用于书面语"},{"id":1512,"word":"万目睽睽","pinyin":"wàn mù kuí kuí","abbr":"wmkk","explanation":"睽睽：张目注视的样子。在众人的注视、监督下。","source":{"text":"公私扫地赤立，新旧不相保持，万目睽睽，公于此时能安以治之。","book":"唐·韩愈《郓州溪堂诗并序》"},"example":{"text":"党与人民在监督，～难逃脱。","book":"陈毅《手莫伸》诗"},"similar":["众目睽睽"],"usage":"作宾语；指在众人的注视下"},{"id":1513,"word":"万签插架","pinyin":"wàn qiān chā jià","abbr":"wqcj","explanation":"形容书籍极多。","source":{"text":"邺侯家多书，插架三万轴。一一悬牙签，新若手未触。","book":"唐·韩愈《送诸葛觉往随州读书》诗"},"example":{"text":"～号东庄，多稼连云亦何有。","book":"宋·陆游《寄题徐载叔秀才东庄》"},"usage":"作宾语、定语；形容书籍极多"},{"id":1514,"word":"万箭攒心","pinyin":"wàn jiàn cuán xīn","abbr":"wjcx","explanation":"攒：聚集。象万枝箭聚在心上。形容万分伤痛。","source":{"text":"琼英知了这个消息，如万箭攒心，日夜吞声饮泣，珠泪偷弹，思报父母之仇，时刻不忘。","book":"明·施耐庵《水浒全传》第九十八回"},"example":{"text":"听得秦氏说了这些话，如～，那眼泪不觉流了下来。","book":"清·曹雪芹《红楼梦》第十一回"},"similar":["五内俱焚","心如刀割"],"opposite":["兴高采烈"],"usage":"作宾语；用于人"},{"id":1515,"word":"万箭穿心","pinyin":"wàn jiàn chuān xīn","abbr":"wjcx","explanation":"犹万箭攒心。形容万分伤痛。","source":{"text":"再听到哥子末后一段说话，真如万箭穿心，竟放心大哭起来。","book":"清·夏敬渠《野叟曝言》第七回"},"example":{"text":"听到这个消息，他觉得～般的疼痛。"},"similar":["万箭攒心"],"usage":"作宾语；指痛心"},{"id":1516,"word":"万箭钻心","pinyin":"wàn jiàn zuān xīn","abbr":"wjzx","explanation":"像万支箭钻入心头。形容极度伤痛的心情","source":{"text":"那安卿说到此处，好如万箭钻心，长号数声而绝。","book":"明·凌濛初《初刻拍案惊奇》第20卷"},"similar":["万箭穿心","万箭攒心"],"usage":"作宾语、定语；用于书面语"},{"id":1517,"word":"万籁俱寂","pinyin":"wàn lài jù jì","abbr":"wljj","explanation":"籁：从孔穴中发出的声音；万籁：自然界中万物发出的各种声响；寂：静。形容周围环境非常安静，一点儿声响都没有。","source":{"text":"万赖此俱寂，唯闻钟磬音。","book":"唐·常建《题破山寺后禅院》诗"},"example":{"text":"这时～，只听到滴搭的钟声和可以微闻得到的母亲的呼吸。","book":"邹韬奋《我的母亲》"},"similar":["万籁无声","鸦雀无声","鸦默雀静"],"opposite":["人声鼎沸","沸沸扬扬"],"usage":"作谓语、定语；形容非常安静","story":["唐朝诗人常建中了进士后，仕途一直不得志，40岁才做县尉。他一生游览了许多山川名胜，写了不少田园诗，代表作有《题破山寺后禅院》“清晨入古寺，初日照高林。曲径通幽处，禅房花木深。山光悦鸟性，潭影空人心。万赖此俱寂，但余钟磬音。”"]},{"id":1518,"word":"万籁俱静","pinyin":"wàn lài jù jìng","abbr":"wljj","explanation":"籁：古代的一种箫，泛指声音；万籁：自然界的各种声音；静：安静。形容周围环境非常安静，一点儿声响都没有。","source":{"text":"意尽投笔之时，夜已深沉，万籁俱静。","book":"顾笑言《李宗仁归来》第七章"},"similar":["万籁俱寂"],"opposite":["沸沸扬扬"],"usage":"作谓语、定语；形容非常安静"},{"id":1519,"word":"万籁无声","pinyin":"wàn lài wú shēng","abbr":"wlws","explanation":"形容周围环境非常安静，一点儿声响都没有。","source":{"text":"万赖此俱寂，唯闻钟磬音。","book":"唐·常建《题破山寺后禅院》诗"},"example":{"text":"一更之后，～。","book":"元·王实甫《西厢记》第一本第三折"},"similar":["鸦雀无声","万籁俱寂"],"opposite":["人声鼎沸"],"usage":"作谓语、定语；形容非常安静与冷清"},{"id":1520,"word":"万类不齐","pinyin":"wàn lèi bù qí","abbr":"wlbq","explanation":"万类：指一切东西。指世上一切事物并不整齐划一而是各有各的特殊情况。","source":{"text":"不然，七十二猴，纵说万类不齐，那礼家记事者，何以就敢毅然断为雀入大水为蛤哉。","book":"清·文康《儿女英雄传》第三十七回"}},{"id":1521,"word":"万紫千红","pinyin":"wàn zǐ qiān hóng","abbr":"wzqh","explanation":"形容百花齐放，色彩艳丽。也比喻事物丰富多彩。","source":{"text":"等闲识得东风面，万紫千红总是春。","book":"宋·朱熹《春日》诗"},"example":{"text":"整个文坛出现了前所未有的百花齐放、～的大好局面。"},"similar":["花团锦簇","万红千紫","千红万紫"],"opposite":["流水落花","枯木朽株"],"usage":"作谓语、定语；指事物丰富多彩","story":["南宋时期，著名理学家朱熹广注典籍，精通经、史、诗、文。在一个风和日丽的春日，他信步走到泗水边，见百花盛开即兴作《春日》诗：“胜日寻芳泗水滨，无边光景一时新。等闲识得东风面，万紫千红总是春。”"]},{"id":1522,"word":"万红千紫","pinyin":"wàn hóng qiān zǐ","abbr":"whqz","explanation":"形容百花齐放，色彩艳丽。也比喻事物丰富多彩。","source":{"text":"破寒滴滴娇如醉，不比春饶睡。万红千紫莫嫌迟，看取满城花送、衮衣归。","book":"宋·韩元吉《虞美人》词"},"example":{"text":"任是～，无力与春争。","book":"宋·刘将孙《八声甘州·和人春雪词》"},"similar":["万紫千红","千红万紫","百紫千红"],"usage":"作谓语、定语；指事物丰富多彩"},{"id":1523,"word":"万绪千头","pinyin":"wàn xù qiān tóu","abbr":"wxqt","explanation":"绪：丝头。比喻事情的开端，头绪非常多。也形容事情复杂纷乱。","source":{"text":"机等吹毛求疵，千端万绪，然终无可言者。","book":"三国·魏·曹植《自诫令》"},"example":{"text":"心中～，在牲口上闷闷不语。","book":"清·文康《儿女英雄传》第十一回"},"similar":["千头万绪","万绪千端"],"usage":"作谓语、宾语；用于事物"},{"id":1524,"word":"万绪千端","pinyin":"wàn xù qiān duān","abbr":"wxqd","explanation":"绪：丝头。比喻事情的开端，头绪非常多。也形容事情复杂纷乱。","source":{"text":"机等吹毛求疵，千端万绪，然终无可言者。","book":"三国·魏·曹植《自诫令》"},"example":{"text":"如何不寄一行书，有～别后。","book":"宋·刘光祖《鹊桥仙·留别》词"},"similar":["千头万绪","万绪千头"],"usage":"作谓语、宾语；用于事物"},{"id":1525,"word":"万绿丛中一点红","pinyin":"wàn lǜ cóng zhōng yī diǎn hóng","abbr":"wlczydh","explanation":"大片绿叶丛中有一朵红花非常醒目。比喻在众多事物中突出最精采的一点，足以引起人们的注意。","source":{"text":"万绿丛中一点红，动人春色不须多。","book":"宋·王安石《石榴》诗"}},{"id":1526,"word":"万缕千丝","pinyin":"wàn lǚ qiān sī","abbr":"wlqs","explanation":"千条丝，万条线。原形容一根又一根，数也数不清。现多形容相互之间种种密切而复杂的联系。","source":{"text":"道旁杨柳依依，千丝万缕，拧不住一分愁绪。","book":"宋·戴石屏《怜薄命》词"},"example":{"text":"会少离多看两鬓，～，何况新来病。","book":"宋·辛弃疾《蝶恋花·送佑之弟》词"},"similar":["千丝万缕"],"usage":"作谓语、定语、状语；用于人或事物之间"},{"id":1527,"word":"万缘俱净","pinyin":"wàn yuán jù jìng","abbr":"wyjj","explanation":"万缘：佛家语，一切事物皆由缘而生；俱：都；净：干净，没有剩余。指什么念头都没有了。","source":{"text":"闻《光明经》能解厄，持一卷浼人教诵。初犹烦躁，久渐自安。旦晚无事，惟趺坐捻珠。持之一年，万缘俱净。","book":"清·蒲松龄《聊斋志异·瞳人语》"}},{"id":1528,"word":"万能钥匙","pinyin":"wàn néng yào shì","abbr":"wnys","explanation":"指能打开所有锁的钥匙。比喻解决一切困难的办法。","source":{"text":"有些钥匙可以开不少的锁，如果加上耐心和灵巧甚至可以开无穷的锁——比如‘万能钥匙’。","book":"王朔《动物凶猛》"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":1529,"word":"万般无奈","pinyin":"wàn bān wú nài","abbr":"wbwn","explanation":"万般：极其、非常；无奈：无可奈何。不得已，实在没办法。","source":{"text":"耘轩万般无奈，只得写‘怀水候叙’帖儿，把娄、程二位请到家中。","book":"清·李绿园《歧路灯》第二十回"},"example":{"text":"～，韩太太向命运屈服了，到底走了那条过去连想都没想到的路。","book":"霍达《穆斯林的葬礼》第十三章"},"similar":["无可奈何","万不得已"],"usage":"作谓语、定语、宾语；用于处境"},{"id":1530,"word":"万花齐放","pinyin":"wàn huā qí fàng","abbr":"whqf","explanation":"万花：泛指各种花卉；齐：同时。千百种花同时开放，争奇斗艳。","source":{"text":"妾见木兰庭上，万花齐放，故差奴婢们迎请陛下一赏。","book":"清·褚人获《隋唐演义》第30回"},"similar":["百花齐放"],"usage":"作谓语、定语；用于春天"},{"id":1531,"word":"万苦千辛","pinyin":"wàn kǔ qiān xīn","abbr":"wkqx","explanation":"各种各样的艰难困苦。","source":{"text":"我受了些热血相喷，万苦千辛，恰便似翻滚滚的雪浪里逃生。","book":"元·无名氏《飞刀对箭》第四折"},"example":{"text":"邹鲁《洪宪之役》：“成败利钝，与共休戚，～，舍命不渝。”"},"similar":["千辛万苦"],"usage":"作状语、宾语；指经历艰苦"},{"id":1532,"word":"万草千花","pinyin":"wàn cǎo qiān huā","abbr":"wcqh","explanation":"无数种小草和鲜花。指花草种类繁多，不计其数。","source":{"text":"象床玉手乱殷红，万草千花动凝碧。","book":"唐·杜甫《白丝行》"},"example":{"text":"土膏欲动雨频催，～一饷开。","book":"宋·范成大《四时田园杂兴·春日》"}},{"id":1533,"word":"万虑千愁","pinyin":"wàn lǜ qiān chóu","abbr":"wlqc","explanation":"千、万：形容多。指忧愁思虑非常多。","source":{"text":"万虑千愁人自老，春来依旧生芳草。","book":"明·清溪道人《禅真逸史》第十七回"},"example":{"text":"兼之县前街也在开吊，痴珠～，这十数天也疲极了。","book":"清·魏子安《花月痕》第三十八回"}},{"id":1534,"word":"万语千言","pinyin":"wàn yǔ qiān yán","abbr":"wyqy","explanation":"许许多多的话语。","source":{"text":"千言万语无人会，又逐流莺过短墙。","book":"唐·郑谷《燕》诗"},"example":{"text":"～句句该，都出在道德阴符外。","book":"明·无名氏《李云卿》第三折"},"similar":["千言万语"],"usage":"作主语、宾语、定语；形容话很多"},{"id":1535,"word":"万象包罗","pinyin":"wàn xiàng bāo luó","abbr":"wxbl","explanation":"万象：宇宙间的一切景象，指各种事物；包罗：包括。形容内容丰富，应有尽有。","source":{"text":"所以包罗万象，举一千从，运变无形而能化物，大矣哉，阴阳之理也。","book":"《黄帝宅经》卷上"},"example":{"text":"～为一平，方知截教有鸿潆。","book":"明·许仲琳《封神演义》第四十四回"},"similar":["包罗万象"],"usage":"作谓语、定语；形容内容丰富"},{"id":1536,"word":"万象回春","pinyin":"wàn xiàng huí chūn","abbr":"wxhc","explanation":"万象：一切景象。指各种事物都出现了生机。","source":{"text":"迨一元方兆，万象回春，道发散于天地人物之间，而无从窥测，修士欲明道体，请于天地将开未开，未开忽开而揣度之，则得道之原，而下手不患无基矣。","book":"宋·朱熹《道德经注释》第四章"},"example":{"text":"卿有甚么神术，能使～？","book":"蔡东藩《南北史演义》第九十四回"}},{"id":1537,"word":"万象更新","pinyin":"wàn xiàng gēng xīn","abbr":"wxgx","explanation":"万象：宇宙间一切景象；更：变更。事物或景象改换了样子，出现了一番新气象。","source":{"text":"如今正是初春时节，万物更新，正该鼓舞另立起来才好。","book":"清·曹雪芹《红楼梦》第七十回"},"example":{"text":"春回大地，～，农民又开始耕种了。"},"similar":["面目一新","耳目一新"],"opposite":["万古不变","依然如故"],"usage":"作谓语、宾语、定语；指彻底改变面貌"},{"id":1538,"word":"万象森罗","pinyin":"wàn xiàng sēn luó","abbr":"wxsl","explanation":"指天地间纷纷罗列的各种各样的景象。","source":{"text":"夫万象森罗，不离两仪所育。","book":"南朝·梁·陶弘景《茅山长沙馆碑》"},"example":{"text":"六月一日前，～替说禅；六月一日后，八角磨盘空里走。","book":"明·杨慎《升庵诗话》第一卷"},"usage":"作谓语、宾语；指天地间纷纷罗列的事物和现"},{"id":1539,"word":"万象澄澈","pinyin":"wàn xiàng chéng chè","abbr":"wxcc","explanation":"澄、澈：水清。万物都澄静清澈。形容月夜所有的景物澄静而清澈。","source":{"text":"望明月上东南最高峰，与波溶漾，湖碧天青，万象澄澈。","book":"清·邵长蘅《夜游孤山记》"}},{"id":1540,"word":"万贯家私","pinyin":"wàn guàn ji sī","abbr":"wgjs","explanation":"万贯：上万贯铜钱。贯：古时穿钱的绳子，既钱穿，也指一串钱，一千文为一串，称一贯。形容家产很多，非常富有。","source":{"text":"老爹爹纵有万贯家私，自有嫡子嫡孙，干你野种屁事！","book":"明·冯梦龙《喻世明言》第十卷"},"example":{"text":"就是有～也经不起你这样挥霍"},"similar":["万贯家财"],"opposite":["一贫如洗","一无所有"],"usage":"作宾语、定语；指十分富有"},{"id":1541,"word":"万贯家财","pinyin":"wàn guàn jiā cái","abbr":"wgjc","explanation":"形容家产极丰。","source":{"text":"牛璘有万贯家财，在赵江梅家作赘。","book":"元·无名氏《玩江亭》第一折"},"example":{"text":"张大户有～，百间房屋。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"similar":["腰缠万贯","万贯家私"],"opposite":["家徒四壁"],"usage":"作宾语、定语；指十分富有"},{"id":1542,"word":"万贯赀财","pinyin":"wàn guàn zī cái","abbr":"wgzc","explanation":"贯：中国古代的铜钱用绳穿成串，每一千个叫一贯，万贯是指钱财极多；赀：数量很多。形容家产极丰。","source":{"text":"认奋母为其守藏婢，云盗白珠十斛、紫金千斤以叛，遂收考奋兄弟死于狱中，悉没赀财亿七千余万。","book":"晋·张华《轻薄篇》：“志意既放逸，赀财亦丰奢。”《资治通鉴·汉纪·孝质帝和平元年》"}},{"id":1543,"word":"万赖俱寂","pinyin":"wàn lài jù jì","abbr":"wljj","explanation":"形容周围环境非常安静，一点儿声响都没有。","source":{"text":"万赖此俱寂，唯闻钟磬音。","book":"唐朝常建《题破山寺后禅院》诗"}},{"id":1544,"word":"万赖无声","pinyin":"wàn lài wú shēng","abbr":"wlws","explanation":"形容周围环境非常安静，一点儿声响都没有。","source":{"text":"万赖此俱寂，唯闻钟磬音。","book":"唐朝常建《题破山寺后禅院》诗"}},{"id":1545,"word":"万载千秋","pinyin":"wàn zài qiān qiū","abbr":"wzqq","explanation":"指经历年代极久远。同“万代千秋”。","source":{"text":"当今圣主存仁孝，万载千秋亨太平。","book":"明·无名氏《贺元宵》第三折"},"similar":["万代千秋","千秋万古"],"usage":"作宾语、定语；指时间久长"},{"id":1546,"word":"万选万中","pinyin":"wàn xuǎn wàn zhòng","abbr":"wxwz","explanation":"每次都被选中。指文章文辞美妙，立意新奇，每次都能被选中。","source":{"text":"员外郎员半千数为公卿称‘鷟文辞犹青铜钱，万选万中’，时号鷟‘青钱学士’。","book":"《新唐书·张荐传》"}},{"id":1547,"word":"万选青钱","pinyin":"wàn xuǎn qīng qián","abbr":"wxqq","explanation":"比喻文章出众。","source":{"text":"员外郎员半千数为公卿称鷟文辞犹青铜钱，‘万选万中’。时号鷟‘青钱学士’。","book":"《新唐书·张荐传》"},"example":{"text":"清·荻岸山人《平山冷燕》第19回：“二人到了三场，场中做的文字，犹如～，无人不赏。”"},"similar":["青钱万选"],"usage":"作宾语、定语；指文章出众","story":["唐朝工部侍郎张荐的爷爷张文成在唐高宗李治时考中进士，被任命为歧王李范府里的参军，因为他不善于巴结，官运一直不好。他想通过科举考试去解决官职问题，他一连考了八次，每次都是“甲科”均没有安排，人称他是“青钱学士”"]},{"id":1548,"word":"万里一息","pinyin":"wàn lǐ yī xī","abbr":"wlyx","explanation":"万里远的路程一口气就到了。形容极其迅速。","source":{"text":"追奔电，逐遗风，周流八极，万里一息。何其辽哉！","book":"《汉书·王褒传》"}},{"id":1549,"word":"万里之任","pinyin":"wàn lǐ zhī rèn","abbr":"wlzr","explanation":"指到很远的地方任职。多指藩臣之任。","source":{"text":"授之以万里之任，任之以一言之事。","book":"三国·魏·曹丕《赐关内侯诏》"}},{"id":1550,"word":"万里之望","pinyin":"wàn lǐ zhī wàng","abbr":"wlzw","explanation":"飞翔万里的期望。指有显达富贵的愿望。","source":{"text":"王肃以宿德显授，何曾以后进见拔，皆鹰扬虎视，有万里之望。","book":"三国·魏·应璩《与侍郎曹长思书》"}},{"id":1551,"word":"万里同风","pinyin":"wàn lǐ tóng fēng","abbr":"wltf","explanation":"风：教化。比喻天下统一。","source":{"text":"今天下为一，万里同风。","book":"《汉书·终军传》"},"example":{"text":"～教，逆命称妾臣。","book":"《乐府诗集·惟庸蜀》"}},{"id":1552,"word":"万里无云","pinyin":"wàn lǐ wú yún","abbr":"wlwy","explanation":"湛湛蓝天，没有一丝云彩。形容天气晴朗。","source":{"text":"碧天万里无云，空劳倦客身心。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"～贺六龙，千林不放鸟飞空。地燃石裂江湖沸，不见南来一点风。","book":"明·冯梦龙《喻世明言》第三十三卷"}},{"id":1553,"word":"万里未归人","pinyin":"wàn lǐ wèi guī rén","abbr":"wlwgr","explanation":"指远行在外的人还没有回来。","source":{"text":"一年将夜尽，万里未归人。","book":"唐·戴叔伦《除夜宿石头驿》诗"}},{"id":1554,"word":"万里比邻","pinyin":"wàn lǐ bǐ lín","abbr":"wlbl","explanation":"相距虽然很远，但关系却很密切。","source":{"text":"心悲动我神，弃置莫复陈。丈夫志四海，万里犹比邻。","book":"三国·魏·曹植《赠白马王彪》"},"example":{"text":"大海飘萍，离合无定。～，两心相印。","book":"清·魏子安《花月痕》第二回"}},{"id":1555,"word":"万里江山","pinyin":"wàn lǐ jiāng shān","abbr":"wljs","explanation":"江山：祖国领土。形容国家领土幅员广阔。","source":{"text":"平生塞北江南，归来华发苍颜。布被秋宵梦觉，眼前万里江山。","book":"宋·辛弃疾《清平乐独宿博山王氏庵》"},"example":{"text":"～知何处？回首对床夜语。","book":"宋·张元干《贺新郎·送胡邦衡待制》"}},{"id":1556,"word":"万里河山","pinyin":"wàn lǐ hé shān","abbr":"wlhs","explanation":"河山：祖国领土。形容国家领土幅员广阔。","source":{"text":"平生塞北江南，归来华发苍颜。布被秋宵梦觉，眼前万里江山。","book":"宋·辛弃疾《清平乐独宿博山王氏庵》"},"example":{"text":"守成继统当兢业，～拱大唐。","book":"元·白朴《梧桐雨》楔子"}},{"id":1557,"word":"万里犹比邻","pinyin":"wàn lǐ yóu bǐ lín","abbr":"wlybl","explanation":"相隔万里，却好像邻居。比喻关系密切。","source":{"text":"心悲动我神，弃置莫复陈。丈夫志四海，万里犹比邻。","book":"三国·魏·曹植《赠白马王彪》"}},{"id":1558,"word":"万里迢迢","pinyin":"wàn lǐ tiáo tiáo","abbr":"wltt","explanation":"形容路程很遥远。","source":{"text":"女家贫，人口众，万里迢迢，何以当此。","book":"清·刘献廷《广阳杂记》卷四"},"example":{"text":"中国的茶籽，便带着一片翠绿的梦，～到非洲。","book":"李瑛《茶》诗"},"similar":["千里迢迢"],"usage":"作定语、状语；用于书面语"},{"id":1559,"word":"万里长城","pinyin":"wàn lǐ cháng chéng","abbr":"wlcc","explanation":"指我国长城。也比喻国家所依赖的大将。现也比喻人民的军队。","source":{"text":"道济见收，愤怒气盛，目光如炬，俄尔间引饮一斛，乃脱帻投地，曰：‘乃坏汝万里长城！’","book":"《南史·檀道济传》"},"example":{"text":"吞珪既丧，坏了～，国中精锐已尽，如何是好？","book":"清·陈忱《水浒后传》第十二回"},"similar":["长城万里"],"usage":"作主语、宾语、定语；指长城"},{"id":1560,"word":"万里长征","pinyin":"wàn lǐ cháng zhēng","abbr":"wlcz","explanation":"征：远行。上万里路的远行。形容极摇远的征程。","source":{"text":"秦时明月汉时关，万里长征人未还。","book":"唐·王昌龄《出塞》诗"},"example":{"text":"夺取全国胜利，这只是～走完了第一步。","book":"毛泽东《在中国共产党第七届中央委员会第二次全体会议上的报告》"},"similar":["千山万水"],"usage":"作谓语、宾语；形容非常遥远的征程","story":["唐朝时期，诗人王昌龄漫游河西一带，亲眼目睹北方契丹人南下骚扰边疆，弄得民不聊生。他写《出塞》表达自己的不满：“秦时明月汉时关，万里长征人未还。但使龙城飞将在，不教胡马度阴山。”希望朝廷派得力干将镇守边关"]},{"id":1561,"word":"万里鹏程","pinyin":"wàn lǐ péng chéng","abbr":"wlpc","explanation":"比喻前程远大。","source":{"text":"拼着你万里鹏程，撇下俺一腔春恨。","book":"明·冯惟敏《桂枝香·春怨》曲"},"example":{"text":"见他人～，叹老儒，叹老儒功名无份。","book":"《戏曲选·祭头巾》"},"similar":["鹏程万里"],"usage":"作谓语、宾语；比喻前程远大","story":["战国时期道家代表庄周在《庄子·逍遥游》中记载：北方大海里有种很大的鱼叫“鲲”，时间长了就变成很大的鸟叫“鹏”，它的翅膀像天上的云彩那么大，一飞起来就是九万里高，后来飞到南海里去了"]},{"id":1562,"word":"万里鹏翼","pinyin":"wàn lǐ péng yì","abbr":"wlpy","explanation":"比喻前程远大。","source":{"text":"鹏翼张风欺万里，马头无角已三年。","book":"唐·元稹《送友封》诗"},"similar":["万里鹏程"],"usage":"作谓语、宾语；用于祝辞"},{"id":1563,"word":"万金不换","pinyin":"wàn jīn bù huàn","abbr":"wjbh","explanation":"形容非常珍贵。","source":{"text":"万金不换囊中术，上医元自能医国。软语到更阑，绨袍范叔寒。","book":"宋·辛弃疾《菩萨蛮·赠张医道服为别，且令餽河豚》"},"example":{"text":"那把扇子出自皇上手笔，～的奇宝，汤玛法怕是一点不懂哩。","book":"凌力《少年天子》第五章"}},{"id":1564,"word":"万金油","pinyin":"wàn jīn yóu","abbr":"wjy","explanation":"清凉油。比喻什么都不精通，但什么都懂一点，什么都能应付一气的人。","source":{"text":"谁有万金油？慎明，你随身带药的，有没有万金油？","book":"钱钟书《围城》"},"example":{"text":"我们不需要～干部，要真正懂专业的干部。"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":1565,"word":"万金良药","pinyin":"wàn jīn liáng yào","abbr":"wjly","explanation":"价值非常昂贵的好药。","source":{"text":"夫身中大创十余，适有万金良药，故得无死。","book":"《史记·魏其武安侯列传》"},"example":{"text":"此乃至宝之丹，～也。","book":"明·凌濛初《二刻拍案惊奇》卷十八"}},{"id":1566,"word":"万钟之藏","pinyin":"wàn zhōng zhī cáng","abbr":"wzzc","explanation":"钟：量器，六石四斗为一钟。形容储藏财物非常多。","source":{"text":"故守之以准平，使万使之都，必有万钟之藏。","book":"《管子·国蓄》"},"example":{"text":"古者平准之法，使万室之邑，必有～，千室之邑，必有千钟之藏。","book":"《旧唐书·食货志下》"}},{"id":1567,"word":"万钱无下箸","pinyin":"wàn qián wú xià zhù","abbr":"wqwxz","explanation":"《晋书·何曾传》：“日食万钱，犹曰无下箸处。”","source":{"text":"日食万钱，犹曰无下箸处。","book":"《晋书·何曾传》"},"example":{"text":"有时候胃口不好也流露一些“日食～处”的神情，闻一闻就望望然去之，这时候对付他的方法就是饿他一天。","book":"梁实秋《白猫王子七岁"}},{"id":1568,"word":"万门千户","pinyin":"wàn mén qiān hù","abbr":"wmqh","explanation":"原指多而密集的门窗。后多形容房屋广大或住户极多。","source":{"text":"于是作建章宫，度为千门万户。","book":"《史记·孝武本纪》"},"example":{"text":"李业兴硕学通儒，博闻多识，～，所宜询访。","book":"《北史·李业兴传》"}},{"id":1569,"word":"万险千艰","pinyin":"wàn xiǎn qiān jiān","abbr":"wxqj","explanation":"形容困难危险极多。","source":{"text":"万险千艰六出身，如今也得避嚣尘。须知从此寒原上，有个行歌拾穗人。","book":"宋·郑侠《西塘文集·出御史台》"},"example":{"text":"～历历更，是非他日仗谁明。","book":"元·方回《桐江续集·次韵仁近见和怀归五首》"}},{"id":1570,"word":"万顷之陂","pinyin":"wàn qǐng zhī bēi","abbr":"wqzb","explanation":"陂：池塘。非常广阔的池塘。比喻人的度量宽广。","source":{"text":"叔度汪汪如万顷之陂，澄之不清，扰之不浊，其器深广，难测量也。","book":"南朝·宋·刘义庆《世说新语·德行》"}},{"id":1571,"word":"万顷平波","pinyin":"wàn qǐng píng bō","abbr":"wqpb","explanation":"万顷：一百万亩；平波：水面平静。指广阔的水面仅有微波荡漾。","source":{"text":"去掉过酒洞庭湖，万顷平波铺练雪。","book":"清·查慎行《同人中秋集陈寄斋宅》"}},{"id":1572,"word":"万顷烟波","pinyin":"wàn qǐng yān bō","abbr":"wqyb","explanation":"形容广阔的水面雾气弥漫，碧波荡漾的景色。","source":{"text":"客间供给能消底，万顷烟波一白鸥。","book":"宋·杨万里《潮阳海岸望海》"},"example":{"text":"淮山隐隐，千里云峰千里恨。淮水悠悠，～万顷愁。","book":"宋·淮上女《减字木兰花》词"}},{"id":1573,"word":"万顷琉璃","pinyin":"wàn qǐng liú lí","abbr":"wqll","explanation":"琉璃：一种矿石质的有色半透明材料，也指涂釉的瓦。形容广阔的水面碧波闪烁。也形容都市建筑富丽堂皇的景色。","source":{"text":"天地暗惨忽异色，碧波万顷堆琉璃。","book":"唐·杜甫《渼陂行》"},"example":{"text":"其时，日影下照，如～。","book":"明·凌濛初《初刻拍案惊奇》卷二十八"}},{"id":1574,"word":"万顷碧波","pinyin":"wàn qǐng bì bō","abbr":"wqbb","explanation":"万顷：一百万亩。形容水面或天空一片碧绿或碧蓝，广阔无际。","source":{"text":"北望可见长江一碧万顷，涵虚天涯。","book":"唐·田颖《玉山堂文集·浩然台诗序》"},"example":{"text":"吴儿勇健，平分白浪弄洪波；渔父轻便，出没江心夸好手。果然是～随地滚，千寻雪浪接云奔。","book":"明·冯梦《警世通言》卷二十三"}},{"id":1575,"word":"万马争先，骅骝落后","pinyin":"wàn mǎ zhēng xiān，huá liú luò hòu","abbr":"wmzxhllh","explanation":"骝：赤色的骏马。在万马争先恐后的奔驰中，偏偏是骏马落在后面。指很有才智者反而落榜。","source":{"text":"万马争先，偏骅骝落后。","book":"明·汤显祖《牡丹亭·耽试》"}},{"id":1576,"word":"万马千军","pinyin":"wàn mǎ qiān jūn","abbr":"wmqj","explanation":"形容雄壮的队伍或浩大的声势。","source":{"text":"见今万马千军厮杀之地，你如何走得到这里？","book":"《南史·陈庆之传》：“名军大将莫自牢，千兵万马避白袍。”明·施耐庵《水浒全传》第一百十八回"},"example":{"text":"不用你使，你只把他背在身上。一路虽然抵不得～，大约也算得一个开路的先锋，保镖的壮士。","book":"清·文康《儿女英雄传》第十回"},"similar":["千军万马"],"usage":"作主语、宾语；指声势浩大"},{"id":1577,"word":"万马奔腾","pinyin":"wàn mǎ bēn téng","abbr":"wmbt","explanation":"成千上万匹刀在奔跑腾跃。形容群众性的活动声势浩大或场面热烈。","source":{"text":"空中如万马奔腾，树杪似千军拥沓。","book":"明·凌濛初《初刻拍案惊奇·钱多处白丁横带》"},"example":{"text":"外面的～似的爆竹声送进他的耳朵里来。他在房里坐不住，便信步走出来。","book":"巴金《家》十三"},"similar":["气势磅礴","声势浩大"],"opposite":["万马齐喑"],"usage":"作宾语、定语；指场面宏大"},{"id":1578,"word":"万马皆喑","pinyin":"wàn mǎ jiē yīn","abbr":"wmjy","explanation":"喑：哑，失音。形容人民沉默不语。也比喻死气沉沉的局面。","source":{"text":"喑：哑，失音。形容人民沉默不语。也比喻死气沉沉的局面。"},"similar":["万马齐喑"],"usage":"作谓语、定语；指死气沉沉的局面"},{"id":1579,"word":"万马齐喑","pinyin":"wàn mǎ qí yīn","abbr":"wmqy","explanation":"喑：哑。所有的马都沉寂无声。旧时形容人民不敢讲话。现也比喻沉闷的政治局面。","source":{"text":"九州风气恃风雷，万马齐喑究可哀。","book":"宋·苏轼《三马图赞》序：“时西域贡马……振鬣长鸣，万马皆瘖。”清·龚自珍《己亥杂诗》"},"example":{"text":"他的发言把会场上～的沉闷空气打破了。"},"similar":["万籁俱寂","死气沉沉"],"opposite":["万马奔腾","龙腾虎跃"],"usage":"作谓语、定语；指死气沉沉的局面","story":["清朝思想家龚自珍面对腐败的清政府，主张改革，提倡禁烟，得不到朝廷重用。48岁毅然辞官归隐，在路过镇江时看到当地人在祭拜天神，他作诗一首：“九州生气恃风雷，万马齐喑究可哀；我劝天公重抖擞，不拘一格降人才。”"]},{"id":1580,"word":"丈二和尚","pinyin":"zhàng èr hé shàng","abbr":"zehs","explanation":"（歇后语）摸不着头脑。指弄不清是怎么回事。","source":{"text":"诸方地保瞧见，恰似丈二和尚，摸不着头脑，不觉腿关节软了下来，扑通扑通跪成一片。","book":"《金瓶梅传奇》第六回"},"example":{"text":"周天虹有点～摸不着头脑，忙问: ‘怎么，阵地不要了？’","book":"魏巍《火凤凰》一○七"},"usage":"作宾语、定语；用于口语"},{"id":1581,"word":"丈人行","pinyin":"zhàng rén háng","abbr":"zrx","explanation":"丈人：古时对老年男子的尊称；行：行辈。指长辈。","source":{"text":"单于初立，恐汉袭之，乃自谓：‘我儿子，安敢望汉天子！汉天子，我丈人行也。’","book":"《史记·匈奴列传》"},"example":{"text":"岂如吾甥不流宕，丞相中郎～。（唐·杜甫《李潮八分小篆歌》）"},"usage":"作宾语、定语；用于书面语"},{"id":1582,"word":"丈夫双泪不轻弹","pinyin":"zhàng fū shuāng lèi bù qīng tán","abbr":"zfslbqd","explanation":"丈夫：大丈夫；弹：用手弹洒。指男子汉大丈夫不轻易掉眼泪。","source":{"text":"丈夫双泪不轻弹，都付酒杯间。","book":"元·李泂《双调夜行船·送友归吴》"},"similar":["丈夫有泪不轻弹"],"usage":"作宾语、分句；指男人很坚强"},{"id":1583,"word":"丈夫有泪不轻弹","pinyin":"zhàng fū yǒu lèi bù qīng tán","abbr":"zfylbqd","explanation":"丈夫：男子汉；弹：用手挥洒。大丈夫不轻易流泪。","source":{"text":"回首西山日又斜，天涯孤客真难度；丈夫有泪不轻弹，只因未到伤心处。","book":"明·李开先《宝剑记》第37出"},"similar":["丈夫双泪不轻弹"],"usage":"作宾语、分句；指男人很坚强"},{"id":1584,"word":"丈尺权衡","pinyin":"zhàng chǐ quán héng","abbr":"zcqh","explanation":"衡量事物的轻重长短。","source":{"text":"《论》、《孟》如丈尺权衡相似，以此去量度事物，自然见得长短重轻。","book":"宋·朱熹《近思录》卷三"}},{"id":1585,"word":"三三两两","pinyin":"sān sān liǎng liǎng","abbr":"ssll","explanation":"三个两个地在一起。形容人数不多。","source":{"text":"袖手旁观初未说，两两三三而已。","book":"宋·郭茂倩《乐府诗集》卷四十七引晋人《娇女》诗：“鱼行不独自，三三两两俱。”宋·辛弃疾《念奴娇·双陆》词"},"example":{"text":"时文林街一带已有歪戴呢帽的人～散在街上。","book":"《闻一多全集·年谱》"},"similar":["稀稀拉拉"],"opposite":["密密麻麻"],"usage":"作定语、状语；形容数目不多"},{"id":1586,"word":"三三五五","pinyin":"sān sān wǔ wǔ","abbr":"ssww","explanation":"三个一群，五个一伙。","source":{"text":"岸上谁家游冶郎，三三五五映垂杨。","book":"唐·李白《采莲曲》"},"example":{"text":"却有那恶薄同袍，轻浮年少，～，去看苏秀才前妻。","book":"明·东鲁古狂生《醉醒石》第十四回"},"similar":["三五成群"],"usage":"作主语、宾语、定语；指三五成群"},{"id":1587,"word":"三三四四","pinyin":"sān sān sì sì","abbr":"ssss","explanation":"犹三三两两。形容人数不多。","source":{"text":"尔乃三三四四，相随踉■（足旁）而历僻。","book":"汉·王延寿《梦赋》"},"similar":["三三五五","三三两两"],"usage":"作状语；用于口语"},{"id":1588,"word":"三下两下","pinyin":"sān xià liǎng xià","abbr":"sxlx","explanation":"形容动作迅速利落。","example":{"text":"她像一阵风似的，～把床铺好。","book":"王宗元《惠嫂》"}},{"id":1589,"word":"三下五除二","pinyin":"sān xià wǔ chú èr","abbr":"sxwce","explanation":"珠算口诀。形容做事及动作干脆利索。","source":{"text":"他一鼓作气的坐起来，三下五除二的穿上衣服。","book":"老舍《赵子曰》第三"},"example":{"text":"他～地解决了问题。"},"similar":["三下两下"],"usage":"作状语、分句；指人做事"},{"id":1590,"word":"三不开","pinyin":"sān bù kāi","abbr":"sbk","explanation":"旧时讽刺那些懦弱糊涂，不敢有所作为的官僚。","source":{"text":"不开口以论议，不开印以行事，不开门以延士大夫。","book":"《五代史·马胤孙传》"},"example":{"text":"胤孙性谨儒，中书事多凝滞，又罕接宾客，时人目为“～”，谓口、印、门也。","book":"《资治通鉴·后晋纪一·高祖天福元年》"}},{"id":1591,"word":"三不惑","pinyin":"sān bù huò","abbr":"sbh","explanation":"三不：不饮酒，不近女色，不贪财；惑：迷惑。指在酒、色、财方面对自己要求严格。","source":{"text":"秉性不饮酒，又早丧夫人，遂不复娶，所在以淳白称。尝从容言曰：‘我有三不惑：酒，色，财也。’","book":"《后汉书·杨秉传》"},"example":{"text":"居官以清白见称，绰有父风，尝自谓我有～，酒、色与财，及病殁时，年已七十有四。","book":"蔡东藩《后汉演义》第五十二回"}},{"id":1592,"word":"三不拗六","pinyin":"sān bù niù liù","abbr":"sbnl","explanation":"指少数人拗不过多数人。","source":{"text":"自古道三不拗六，他每都是城狐社鼠，俺也革不了他的积弊。","book":"明·冯惟敏《僧尼共犯》第二折"},"usage":"作宾语、定语；用于书面语"},{"id":1593,"word":"三不朽","pinyin":"sān bù xiǔ","abbr":"sbx","explanation":"不朽：永不磨灭立。立德、立功、立言，这三件是永不磨灭的功德伟业。","source":{"text":"大上有立德，其次有立功，其次有立言。虽久不废，此之谓不朽。","book":"《左传·襄公二十年》"},"example":{"text":"少年意气慕千秋，拟作人间第一流。岂意壮怀～，终成老物四宜休。","book":"清·赵翼《瓯北诗钞·七十自述》"}},{"id":1594,"word":"三不知","pinyin":"sān bù zhī","abbr":"sbz","explanation":"原意是对事情的开头、经过和结局不清楚。后指装糊涂。也引申为意料不到或很突然。","source":{"text":"君子之谋也，始、衷、终皆举之，而后入焉；今我三不知而入之，不亦难乎？","book":"《左传·哀公二十七年》"},"example":{"text":"桂娘一定在里头，只作～，冯将进去，见他时再作道理。","book":"明·凌濛初《二刻拍案惊奇》卷三"},"usage":"作宾语、定语；用于口语"},{"id":1595,"word":"三个臭皮匠，合成一个诸葛亮","pinyin":"sān gè chòu pí jiàng，hé chéng yī gè zhū gě liàng","abbr":"sgcpjhcygzgl","explanation":"诸葛亮：三国时蜀国刘备的军师。比喻人多智广。","source":{"text":"三个臭皮匠，合成一个诸葛亮，这就是说，群众有伟大的创造力。","book":"毛泽东《组织起来》"},"example":{"text":"谁都知道～的道理。"},"similar":["三个臭皮匠，赛过诸葛亮"],"usage":"作宾语、定语、分句；指人多智广"},{"id":1596,"word":"三个臭皮匠，赛过诸葛亮","pinyin":"sān gè chòu pí jiàng，sài guò zhū gě liàng","abbr":"sgcpjsgzgl","explanation":"比喻人多智慧多，有事请经过大家商量，就能商量出一个好办法来。","source":{"text":"‘三个臭皮匠，合成一个诸葛亮’，这就是说，群众有伟大的创造力。","book":"毛泽东《组织起来》"},"example":{"text":"～，我们不要过分担心。"},"similar":["三个臭皮匠，顶个诸葛亮"],"usage":"作宾语、定语、分句；指人多智广"},{"id":1597,"word":"三九之位","pinyin":"sān jiǔ zhī wèi","abbr":"sjzw","explanation":"三：三公；九：九卿。指官位很高的人。","source":{"text":"陛下践祚以来，勤心众政，而三九之位未见其人。","book":"《后汉书·郎顗传》"},"example":{"text":"彧出自谿谷，羊质虎皮，虚受光赫之宠，跨越～，犬马犹能识养，将何以报厚施乎。","book":"《三国志·吴志·王蕃传》裴松之注引《江表传"}},{"id":1598,"word":"三五成群","pinyin":"sān wǔ chéng qún","abbr":"swcq","explanation":"几个人、几个人在一起。","source":{"text":"三五成群，高谈嬉笑。","book":"明·余继登《典故纪闻》卷十二"},"example":{"text":"一般也有轻薄少年及儿童之辈，见他又挑柴，又读书，～，把他嘲笑戏侮。","book":"明·冯梦龙《古今小说》卷二十七"},"similar":["成群结队"],"opposite":["风流云散","形单影只","人山人海"],"usage":"作谓语、状语；用于人群的分散"},{"id":1599,"word":"三亲六故","pinyin":"sān qīn liù gù","abbr":"sqlg","explanation":"亲戚故旧的总称。","source":{"text":"春兰娘在屋子里说：‘谁家没个三亲六故，谁家没个青黄不接的时侯？’","book":"梁斌《播火记》二"},"example":{"text":"我们逃到那里去，又没有～。","book":"骆宾基《胶东的“暴民”》四"},"similar":["亲朋好友","三亲六眷"],"usage":"作主语、宾语、定语；泛指各种亲友"},{"id":1600,"word":"三亲六眷","pinyin":"sān qīn liù juàn","abbr":"sqlj","explanation":"三亲：父母、兄弟、夫妇；眷：家属、亲戚。泛指众亲戚。","source":{"text":"那里管三亲六眷尽埋冤，逼的人卖了银头面我戴着金头面。","book":"元·关汉卿《鲁斋郎》第一折"},"example":{"text":"他靠的就是～的裙带关系上去做官的。"},"similar":["三亲四眷","三亲六故"],"usage":"作主语、宾语、定语；泛指众亲戚"},{"id":1601,"word":"三亲四眷","pinyin":"sān qīn sì juàn","abbr":"sqsj","explanation":"泛指众亲戚。同“三亲六眷”。","source":{"text":"次日真个到三亲四眷家去了一巡。","book":"《警世通言·赵春儿重旺曹家庄》"},"similar":["三亲六眷"],"usage":"作主语、宾语、定语；泛指众亲戚"},{"id":1602,"word":"三人为众","pinyin":"sān rén wèi zhòng","abbr":"srwz","explanation":"数目达到三人即可称为众人，已不算少数。","source":{"text":"三人为众，虽难尽继，宜从尤功。","book":"东汉·班固《汉书·高惠高后文功臣表序》"},"example":{"text":"三人同行，必有我师，～，必有一长。","book":"《辛亥革命前十年间时论选集》"},"similar":["三人成众"],"usage":"作宾语、定语；指人多"},{"id":1603,"word":"三人六样话","pinyin":"sān rén liù yàng huà","abbr":"srlyh","explanation":"形容说法不一。","example":{"text":"有人说解到公安局了，有人说还关在厂里，～！","book":"茅盾《子夜》十六"}},{"id":1604,"word":"三人成众","pinyin":"sān rén chéng zhòng","abbr":"srcz","explanation":"数目达到三人即可称为众人，已不算少数。","source":{"text":"三人同行，必有我师，三人成众，必有一长。","book":"《辛亥革命前十年间时论选集》"},"similar":["三人为众"],"usage":"作宾语、定语；指人多"},{"id":1605,"word":"三人成市虎","pinyin":"sān rén chéng shì hǔ","abbr":"srcsh","explanation":"比喻说的人多了，就能使人们把谣言当事实。同“三人成虎”。","source":{"text":"众议成林，无翼而飞，三人成市虎，一里能挠椎。","book":"《淮南子·说山训》"},"example":{"text":"‘～’，这事竟很像是真的了。","book":"胡適《这一周》三六"},"similar":["三夫成市虎"],"usage":"作宾语、定语、分句；指谣言"},{"id":1606,"word":"三人成虎","pinyin":"sān rén chéng hǔ","abbr":"srch","explanation":"三个人谎报城市里有老虎，听的人就信以为真。比喻说的人多了，就能使人们把谣言当事实。","source":{"text":"夫市之无虎明矣，然而三人言而成虎。","book":"《战国策·魏策二》"},"example":{"text":"正是积毁成山，～。到开皇二十年十月，隋主御武德殿，宣诏废勇为庶人。","book":"清·褚人获《隋唐演义》第二回"},"similar":["众口铄金","道听途说","三人成市虎"],"opposite":["眼见为实"],"usage":"作宾语、定语、分句；指谣言","story":["战国时，魏国大臣庞葱伴随太子去赵国作人质，临行前对魏王说：“如果三个人都对你说城市里有一只老虎正在伤人，你相信吗？”魏王说他不会听信谗言的。庞葱到赵国后，不少毁谤庞葱的谣言传到魏王的耳朵，魏王还是信以为真"]},{"id":1607,"word":"三人行，必有我师","pinyin":"sān rén xíng，bì yǒu wǒ shī","abbr":"srxbyws","explanation":"三个人一起走路，其中必定有人可以作为我的老师。指应该不耻下问，虚心向别人学习。","source":{"text":"三人行，必有吾师焉。择其善者而从之，其不善者而改之。","book":"《论语·述而》"},"example":{"text":"岂不闻～焉，则要你择其善者为亲友。","book":"明·无名氏《东篱赏菊》第一折"},"usage":"作宾语、分句；指应善于向人学习"},{"id":1608,"word":"三从四德","pinyin":"sān cóng sì dé","abbr":"scsd","explanation":"封建礼教束缚妇女的道德标准之一。","source":{"text":"九嫔掌妇学之法，以九教御：妇德、妇言、妇容、妇功。","book":"《仪礼·丧服·子夏传》：“妇人有三从之义，无专用之道。故未嫁从父，既嫁从夫，夫死从子。”《周礼·天官》"},"example":{"text":"从来不出闺门里，羞答答怎便将男儿细窥，则我这～幼闲习，既嫁鸡须逐他鸡。","book":"元·无名氏《隔江斗智》第三折"},"similar":["逆来顺受","百依百顺"],"opposite":["倒行逆施","大逆不道"],"usage":"作主语、宾语、定语；指封建礼教"},{"id":1609,"word":"三仕三已","pinyin":"sān shì sān yǐ","abbr":"sssy","explanation":"仕：作官；已：指被罢免。三次作官，又三次被罢免。形容心胸开阔，对作官和罢官都不在乎。","source":{"text":"令尹子文三仕为令尹，无喜色；三已之，无愠色。","book":"《论语·公冶长》"},"example":{"text":"世间喜愠更何其，笑先生～。","book":"宋·辛弃疾《哨遍》词"}},{"id":1610,"word":"三令五申","pinyin":"sān lìng wǔ shēn","abbr":"slws","explanation":"令：命令；申：表达，说明。多次命令和告诫。","source":{"text":"三令五申，示戮斩牲。","book":"《史记·孙子吴起列传》：“约束既布，乃设铁钺，即三令五申之。”汉·张衡《东京赋》"},"example":{"text":"昨已～，命汝等各处坚守，俱不遵吾命，何也？（明·罗贯中《三国演义》第八十三回）"},"similar":["发号施令","千叮万嘱"],"opposite":["敷衍了事"],"usage":"作谓语、宾语、定语；指命令和告诫等","story":["春秋时期，吴王阖闾请孙武到宫中讲解《孙子兵法》，并要亲自操练，孙武让吴王在宫中挑选180名女子组成两队，分别由吴王的两名宠妃担任队长，可宫女们根本不听他的指挥，孙武就将她们两人斩首，理由是不听主将的三令五申"]},{"id":1611,"word":"三位一体","pinyin":"sān wèi yī tǐ","abbr":"swyt","explanation":"比喻三个人、三件事或三个方面联成的一个整体。","source":{"text":"毛泽东《为争取千百万群众进入抗日民族统一战线而斗争》：“为什么提出'巩固和平'、'争取民主'、'实现抗战'这样三位一体的口号？  张"},"example":{"text":"我俩没儿没女，洁琼常来，可以说是～，宛如一家","book":"扬《第二次握手》"},"similar":["亲密无间","水乳交融"],"opposite":["格格不入","势不两立"],"usage":"作宾语、定语；指一个整体"},{"id":1612,"word":"三余读书","pinyin":"sān yú dú shū","abbr":"syds","explanation":"充分利用一切空余时间读书。","source":{"text":"从学者云：‘苦渴无日。’遇言：‘当以三余。’或问三余之意，遇言：‘冬者岁之余，夜者日之余，阴雨者时之余也。’","book":"《三国志·魏志·王肃传》裴松之注引《魏略》"},"example":{"text":"余尝以～，讲习之暇，读其文。","book":"晋·陶潜《感士不遇赋序》"},"usage":"作宾语、定语；指读书刻苦","story":["东汉末年，汉献帝的侍讲官董遇很有学问，被称为“儒宗”，很多书生想拜董遇为师，跟他研究学问，董遇不肯收徒，认为书本是最好的老师。“读书百遍，其义自现”，书生说没有时间，董遇教他们利用冬天、夜晚及阴雨天这三余时间读书"]},{"id":1613,"word":"三元及第","pinyin":"sān yuán jí dì","abbr":"syjd","explanation":"三元：科举时代乡试、会试、殿试都是第一名；及第：科举应试中选。从乡试到殿试都考中第一名。","source":{"text":"三元及第才千顷，一品当朝禄万钟。","book":"清·李渔《笠翁对韵》"}},{"id":1614,"word":"三公九卿","pinyin":"sān gōng jiǔ qīng","abbr":"sgjq","explanation":"三公：古时辅助国君的最高官员；九卿：古时中央政府的九个高级官员。指官位很高的人。","source":{"text":"吾闻古之圣人，不居朝廷，必在卜医之中。今吾已见三公九卿朝士大夫，皆可知矣。试之卜数中以观采。","book":"《史记·日者列传》"},"example":{"text":"可是当今朝廷之事，～，为皇上辅粥者多是满人，而汉人仅居十之二三。","book":"二月河《康熙大帝》三十四"}},{"id":1615,"word":"三六九等","pinyin":"sān liù jiǔ děng","abbr":"sljd","explanation":"指等级和类别多，有种种差别。","source":{"text":"只不过我这一会子输了几两银子，你们就三六九等了。","book":"清·曹雪芹《红楼梦》第75回"},"example":{"text":"同是拉车的，为什么有～呢？","book":"老舍《骆驼祥子》"},"usage":"作宾语、定语；指许多等级和类别"},{"id":1616,"word":"三兽渡河","pinyin":"sān shòu dù hé","abbr":"ssdh","explanation":"佛教以兔、马、象三兽渡河入水之深浅，喻小、中、大三乘证道之高下。后泛指修行。","source":{"text":"善男子，如恒河三兽俱渡：兔、马、香象。兔不至底，浮水而过；马或至底，或不至底；象则尽底。恒河水者，即是十二因缘河也。声闻渡时，犹如彼兔；缘觉渡时，犹如彼马；如来渡时，犹如香象，是故如来得名为佛。","book":"《优婆塞戒经·三种菩提品》"}},{"id":1617,"word":"三写成乌","pinyin":"sān xiě chéng wū","abbr":"sxcw","explanation":"指古书传写易致差错。同“三写易字”。","source":{"text":"去今五十年，耳目相接，其大者已牴悟如此。向后欲凭纸上之语，三写成乌，岂复有实事哉。","book":"清·黄宗羲《辩野史》"},"example":{"text":"若两《会仙记》，邑中尚少副本，故未免传讹，何怪此事之～。","book":"清·任安上《与吴拜经书》"},"similar":["三写易字"],"usage":"作宾语、定语；用于文字等"},{"id":1618,"word":"三写易字","pinyin":"sān xiě yì zì","abbr":"sxyz","explanation":"指古书传写易致差错。","source":{"text":"故谚曰：‘书三写，鱼成鲁，虚成虎。’","book":"晋·葛洪《抱朴子·遐览》"},"example":{"text":"南朝·梁·刘勰《文心雕龙·练字》：“至于经典隐暖，方册纷纶，简蠹帛裂，～。”"},"similar":["三写成乌"],"usage":"作宾语、定语；用于文字等"},{"id":1619,"word":"三军可夺帅，匹夫不可夺志","pinyin":"sān jūn kě duó shuài，pǐ fū bù kě duó zhì","abbr":"sjkdspfbkdz","explanation":"三军之勇，可以劫取首领，而普通的人，却不可夺其志气。形容一个人志气的重要。","source":{"text":"三军可夺帅也，匹夫不可夺志也。","book":"《论语·子罕》"}},{"id":1620,"word":"三军可夺气，将军可夺心","pinyin":"sān jūn kě duó qì，jiāng jūn kě duó xīn","abbr":"sjkdqjjkdx","explanation":"三军：指军队；夺：指打击；气：士气；心：决心。用兵作战首先要设法削弱敌人的士气，扰乱和动摇敌将的决心。","source":{"text":"故三军可夺气，将军可夺心。是故朝气锐，昼气惰，暮气归。故善用兵者，避其锐气，击其惰归，此治气者也。","book":"《孙子·军争》"}},{"id":1621,"word":"三军易得，一将难求","pinyin":"sān jūn yì dé，yī jiàng nán qiú","abbr":"sjydyjnq","explanation":"征集成千的兵士很容易，担找一个好的将领却很难。形容良才难得。","source":{"text":"陡恁的千军易得，一将难求。","book":"元·马致远《汉宫秋》第二折"},"example":{"text":"～。张郃虽然有罪，乃魏王所深爱者也，不可便诛。","book":"明·罗贯中《三国演义》第七十回"}},{"id":1622,"word":"三军暴骨","pinyin":"sān jūn pù gǔ","abbr":"sjbg","explanation":"三军：指所有军队；暴：晒。三军的尸骨暴露于战场。形容战败，使军士尸横战场。","source":{"text":"今日之事，幸而集，晋国赖之；不集，三军暴骨。","book":"《左传·襄公二十六年》"},"example":{"text":"方庚午以前，～，万姓流离，城郭丘墟，刍粮耗竭，边臣首领不保，朝廷为旰食。","book":"《明史·李棠传》"}},{"id":1623,"word":"三冬二夏","pinyin":"sān dōng èr xià","abbr":"sdex","explanation":"犹言三两年。"},{"id":1624,"word":"三分似人，七分似鬼","pinyin":"sān fēn sì rén，qī fēn sì guǐ","abbr":"sfsrqfsg","explanation":"詈词。骂人长相难看。","source":{"text":"你看我家那身不满尺的丁树，三分似人，七分似鬼。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"example":{"text":"［琏哥］牵了个驴子沿了城墙放驴，作践的～，打骂的肚里有了积气。","book":"清·西周生《醒世姻缘传》第五十回"},"similar":["三分像人，七分似鬼"],"usage":"作谓语、定语、状语；用于人的外貌"},{"id":1625,"word":"三分像人，七分似鬼","pinyin":"sān fēn xiàng rén，qī fēn sì guǐ","abbr":"sfxrqfsg","explanation":"骂人的话。骂人长相难看。","source":{"text":"我嫁得这等一个，也不枉了为人一世！你看我那三寸丁谷树皮，三分像人，七分似鬼，我直恁地晦气！","book":"明·施耐庵《水浒传》第二十三回"},"example":{"text":"忠贤道‘你这老乞婆，～，有甚奇方，可以疗病？’","book":"清·佚名《明珠缘》第三十八回"},"similar":["三分像人，七分像鬼"],"usage":"作谓语、定语、状语；用于人的外貌"},{"id":1626,"word":"三分像人，七分像鬼","pinyin":"sān fēn xiàng rén，qī fēn xiàng guǐ","abbr":"sfxrqfxg","explanation":"形容人长相丑陋，也指人遭疾病或其折磨后不成人样子。","source":{"text":"我嫁你！看牛骨自不中，三分像人，七分像鬼。","book":"宋·无名氏《张协状元·大公资助张协》"},"example":{"text":"朱世远见女婿～，好生不悦。《醒世恒言》卷九"},"similar":["三分像人，七分似鬼"],"usage":"作谓语、定语、状语；用于人的外貌"},{"id":1627,"word":"三分天下有其二","pinyin":"sān fēn tiān xià yǒu qí èr","abbr":"sftxyqe","explanation":"泛指势力强大。","source":{"text":"殷纣淫乱，文王为西伯而有圣德，天下归周者三分有二。","book":"语出《论语·泰伯》：“三分天下有其二，以服事殷。”何晏集解引包咸曰"},"example":{"text":"小流氓太多了：～，不打还行？","book":"张天翼《春风》"},"usage":"作宾语、定语；用于书面语"},{"id":1628,"word":"三分钟热度","pinyin":"sān fēn zhōng rè dù","abbr":"sfzrd","explanation":"比喻短暂的热情。","example":{"text":"办什么事，得看天时、地利、人和，不能凭三分钟的热度，胡干，傻干。","book":"浩然《艳阳天》"}},{"id":1629,"word":"三分鼎立","pinyin":"sān fēn dǐng lì","abbr":"sfdl","explanation":"比喻三方分立，互相抗衡。同“三分鼎足”。","source":{"text":"论土不出江汉，语地仅接褒斜，而谓握皇符，乘帝籍，三分鼎立，比踪王者。","book":"《魏书·匈奴刘聪等传序》"},"similar":["三分鼎足"],"usage":"作谓语、定语；指三足鼎立"},{"id":1630,"word":"三分鼎足","pinyin":"sān fēn dǐng zú","abbr":"sfdz","explanation":"鼎：古代炊具，三足两耳。比喻三方分立，互相抗衡。","source":{"text":"诚能听臣之计，莫若两利而俱存之，三分天下，鼎足而居，其势莫敢先动。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"～浑是梦，踪迹空留在人间。","book":"明·罗贯中《三国演义》第34回"},"similar":["三分鼎立"],"usage":"作谓语、定语；指三足鼎立","story":["公元前203年，汉将韩信灭了齐国，被刘邦封为齐王，韩信的谋士蒯通分析天下形势后认为韩信是一个举足轻重的人物，劝他不要跟随刘邦自立为王，可以与楚汉三分天下，跟随刘邦最多也只能封为诸侯。韩信不听蒯通的意见，最后被吕后诱杀"]},{"id":1631,"word":"三十三天","pinyin":"sān shí sān tiān","abbr":"ssst","explanation":"佛教称欲界第六天为三十三天，即忉利天。后形容最高的地方。","source":{"text":"此言三十三天者，中国言悉怛梨余恶卫陵，此中唯取怛梨二字为忉利天也。怛梨，忉利，彼国音不同耳。","book":"《胜鬘宝窟》卷下"},"example":{"text":"～，离恨天最高。","book":"元·石子章《竹坞听琴》"},"usage":"作宾语、定语；用于佛教等"},{"id":1632,"word":"三十六着，走为上着","pinyin":"sān shí liù zhāo，zǒu wéi shàng zhāo","abbr":"sslzzwsz","explanation":"指事情已经到了无可奈何的地步，没有别的好办法，只能出走。","source":{"text":"娘道：‘我儿，三十六着，走为上着，只恐没处走。’","book":"《水浒传》第二回"},"example":{"text":"没有法子。‘～’，最没有弊病的是莫如不沾手。","book":"《且介亭杂文二集·“题未定”草一》"},"similar":["三十六计，走为上计"],"usage":"作谓语、宾语、分句；用于劝说词"},{"id":1633,"word":"三十六策，走为上策","pinyin":"sān shí liù cè，zǒu wéi shàng cè","abbr":"sslczwsc","explanation":"指事情已经到了无可奈何的地步，没有别的好办法，只能出走。","source":{"text":"檀公三十六策，走是上计，汝父子唯应急走耳。","book":"《南齐书·王敬则传》"},"example":{"text":"～。官打的现在。赌博场中闹出事，只有个闻风远扬是高着。","book":"清·李绿园《歧路灯》第65回"},"similar":["三十六计，走为上计"],"opposite":["坐以待毙"],"usage":"作谓语、分句；用于劝说词","story":["南北朝时期，齐明帝暴病而死，王敬则仓卒在东面起义，朝廷十分震惊。东昏侯在东宫召集手下密议反叛，派人登楼观察，看到征虏亭发生火灾，说王敬则来了，假装要走。有人告诉王敬则，王敬则讥笑檀道济父子逃走不负责任"]},{"id":1634,"word":"三十六策，走为上计","pinyin":"sān shí liù cè，zǒu wéi shàng jì","abbr":"sslczwsj","explanation":"原指无力抵抗敌人，以逃走为上策。后指事情已经到了无可奈何的地步，没有别的好办法，只能出走。","source":{"text":"敬则曰：‘檀公三十六策，走是上计。汝父子唯应急走耳。’","book":"《南齐书·王敬则传》"}},{"id":1635,"word":"三十六策，走是上计","pinyin":"sān shí liù cè，zǒu shì shàng jì","abbr":"sslczssj","explanation":"指事情已经到了无可奈何的地步，没有别的好办法，只能出走了事。","source":{"text":"檀公三十六策，走是上计，汝父子唯应急走耳。","book":"《南齐书·王敬则传》"},"similar":["三十六计，走为上计"],"usage":"作谓语、宾语、分句；用于劝说词","story":["南北朝时期，齐明帝暴病而死，王敬则仓卒在东面起义，朝廷十分震惊。东昏侯在东宫召集手下密议反叛，派人登楼观察，看到征虏亭发生火灾，说王敬则来了，假装要走。有人告诉王敬则，王敬则讥笑檀道济父子逃走不负责任"]},{"id":1636,"word":"三十六行","pinyin":"sān shí liù háng","abbr":"sslh","explanation":"旧时对各行各业的通称。","source":{"text":"三十六行，行行相妒。","book":"清·李渔《玉搔头》"},"example":{"text":"～者，种种职业也。","book":"徐珂《清稗类钞·农商类》"},"similar":["七十二行"],"usage":"作主语、宾语、定语；指各行各业"},{"id":1637,"word":"三十六行，行行出状元","pinyin":"sān shí liù háng，háng háng chū zhuàng yuán","abbr":"sslhhhczy","explanation":"各行各业都有专家、能手。"},{"id":1638,"word":"三十六计，走为上计","pinyin":"sān shí liù jì，zǒu wéi shàng jì","abbr":"ssljzwsj","explanation":"指事情已经到了无可奈何的地步，没有别的好办法，只能出走。","source":{"text":"渊材曰：‘三十六计，走为上计。’","book":"宋·惠洪《冷斋夜话》卷九"},"example":{"text":"女婿比较机灵，一看形势不妙，～，溜之大吉。","book":"余易木《初恋的回声》七"},"similar":["三十六策，走为上策","溜之大吉"],"opposite":["坐以待毙"],"usage":"作谓语、宾语、分句；用于劝说词","story":["南北朝时期，齐明帝暴病而死，王敬则仓卒在东面起义，朝廷十分震惊。东昏侯在东宫召集手下密议反叛，派人登楼观察，看到征虏亭发生火灾，说王敬则来了，假装要走。有人告诉王敬则，王敬则讥笑檀道济父子逃走不负责任"]},{"id":1639,"word":"三十六雨","pinyin":"sān shí liù yǔ","abbr":"ssly","explanation":"指天下太平，五谷丰登。","source":{"text":"十日一雨，岁凡三十六雨，以为时若之应。","book":"《京房易候》"}},{"id":1640,"word":"三十年河东，三十年河西","pinyin":"sān shí nián hé dōng，sān shí nián hé xī","abbr":"ssnhdssnhx","explanation":"三十年前风水在河的东面，而三十年后却在河的西面。比喻世事变化，盛衰无常。","source":{"text":"大先生，‘三十年河东，三十年河西’！就像三十年前，你二位府上何等优势，我是亲眼看见的。","book":"清·吴敬梓《儒林外史》第四十六回"},"example":{"text":"路遥《平凡的世界》第一卷第八章：“真可谓～。”"},"similar":["三十河东，三十河西"],"usage":"作谓语、宾语、定语；用于口语"},{"id":1641,"word":"三十而立","pinyin":"sān shí ér lì","abbr":"ssel","explanation":"指人在三十岁前后有所成就。","source":{"text":"吾十有五而志于学，三十而立。","book":"春秋·鲁·孔丘《论语·为政》"},"example":{"text":"他们都是在二十几岁作出贡献，三十开外就荣获诺贝尔奖金，真可谓～。","book":"陆继宗《三十而立》"},"similar":["而立之年"],"usage":"作宾语、分句；指三十岁","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，孔子与弟子们谈起自己的经历，说他从30岁开始立志弘道，到现在快七十岁没能推销出仁政，感慨万千……宰予立即过来安慰孔子"]},{"id":1642,"word":"三千世界","pinyin":"sān qiān shì jiè","abbr":"sqsj","explanation":"佛教用语，指包括“三”种“千”数的大千世界。后泛指处处，即全世界的意思。","source":{"text":"欲尽出寻那可得，三千世界本无穷。","book":"唐·武元衡《人题龙门香山寺》"},"example":{"text":"十里沙河人最闹，～月方中。","book":"宋·杨万里《和陈蹇叔郎中乙巳上元晴和》"}},{"id":1643,"word":"三千珠履","pinyin":"sān qiān zhū lǔ","abbr":"sqzl","explanation":"珠履：鞋上以珠为装饰，富贵之人用之。形容贵宾众多且豪华奢侈。","source":{"text":"春申君客三千余人，其上客皆蹑珠履。","book":"《史记·春申君列传》"},"example":{"text":"堂上～客，瓮中右斛金陵春。","book":"唐·李白《寄韦南陵冰》诗"},"similar":["珠履三千"],"usage":"作宾语、定语；指人很富有","story":["战国时期，著名的四大公子之一楚国的春申君黄歇协助在秦国当人质的太子完回国执政，功劳很大。手下的门客很多，春申君给他们的待遇都很高，赵国的平原君手下的门客想在他们面前示富，看到他们都穿三千珠履而自惭形秽"]},{"id":1644,"word":"三占从二","pinyin":"sān zhān cóng èr","abbr":"szce","explanation":"三个人一同算卦，听从其中两个人的意见。比喻听从多数人的意见。","source":{"text":"三人占，从二人之言。","book":"《尚书·洪范》"},"example":{"text":"皆令会议于太和门，～，下部施行。","book":"清·康有为《上清帝第二书》"},"usage":"作宾语、分句；比喻少数服从多数"},{"id":1645,"word":"三反四覆","pinyin":"sān fǎn sì fù","abbr":"sfsf","explanation":"指反复无常。","source":{"text":"阿呀！这厮三反四覆，可恼，可恼。","book":"清·蒋士铨《空谷香·杀舱》"},"usage":"作定语、状语；用于书面语"},{"id":1646,"word":"三叠阳关","pinyin":"sān dié yáng guān","abbr":"sdyg","explanation":"即《阳关三叠》。琴曲。琴谱以唐王维《送元二使安西》诗为主要歌词，并引申诗意，增添词句，抒写离别之情。因全曲分三段，原诗反复三次，故称“三叠”。后泛指送","source":{"text":"《三叠阳关》声渐杳。断雨残云，只怕巫山晓。","book":"宋·周邦彥《苏幕遮》词"},"example":{"text":"肺腑，恨怎舒，《～》愁万缕。","book":"元·宋方壶《斗鹌鹑·送别》套曲"},"similar":["阳关三叠"],"usage":"作宾语、定语；比喻离别","story":["唐朝时期，太子宾客刘禹锡每天上朝时路过一个平房，听到一个卖烧饼的男子哀叹地唱王维的《渭城曲》（即《阳关三叠》）：“渭城朝雨邑清尘，客舍青青柳色新。劝君更尽一杯酒，西出阳关无故人。”他给他一万钱扩大买卖，从此再也听不到他唱此曲了"]},{"id":1647,"word":"三句不离本行","pinyin":"sān jù bù lí běn háng","abbr":"sjblbh","explanation":"本行：个人从事的行业。形容一说话总要讲到自己从事的行业。","source":{"text":"我是业医的，你们不要笑我三句不离本行。","book":"清·李宝嘉《官场现形记》第三十四回：“每到一处，开口三句话不离本行，立刻从怀里掏出捐冊来送给人看。”清·颐琐《黄绣球》第十回"},"example":{"text":"你们～，教育，教育，把我门外汉冷落了。","book":"叶圣陶《倪焕之》第四章"},"similar":["三句话不离本行"],"usage":"作谓语、宾语，分句；指谈论职业内的事"},{"id":1648,"word":"三句话不离本行","pinyin":"sān jù huà bù lí běn háng","abbr":"sjhblbh","explanation":"行：行当，职业。指人的言语离不开他所从事的职业范围。","source":{"text":"每到一处，开口三句话不离本行，立刻从怀里掏出捐册来送给人看。","book":"清·李宝嘉《官场现形记》第34回"},"example":{"text":"他～，谈的都是股经。"},"similar":["曲不离口"],"usage":"作谓语、宾语，分句；指谈论职业内的事"},{"id":1649,"word":"三只手","pinyin":"sān zhī shǒu","abbr":"szs","explanation":"扒手，小偷。","source":{"text":"庙会期间上布施的人不断头，得有个人来监视‘三只手’。","book":"路遥《平凡的世界》第四卷第38章"},"example":{"text":"人流拥挤的车站经常有～出现。"},"similar":["梁上君子"],"usage":"作宾语、定语；用于方言"},{"id":1650,"word":"三台五马","pinyin":"sān tái wǔ mǎ","abbr":"stwm","explanation":"三台：原指星名，这里指尚书、御史、谒者；五马：用五匹马驾车，指太守。原指居三台或太守之位。后比喻达官显宦。","source":{"text":"使君从南来，五马立踟蹰。","book":"《晋书·天文志上》：“在人曰三公，在天曰三台。”《玉台新咏·陌上桑》"},"example":{"text":"足下～，宦成之后，亟宜白首同归，早践结邻之约。","book":"清·袁枚《小仓山房尺牍》第二十二首"},"similar":["三台八座","达官显宦"],"usage":"作宾语、定语；用于比喻句"},{"id":1651,"word":"三台八座","pinyin":"sān tái bā zuò","abbr":"stbz","explanation":"泛指高官重臣。","source":{"text":"这叫做‘狮象捍门’，三台八座都是有分的。","book":"《岐路灯》第六十回"},"similar":["三台五马"],"usage":"作宾语、定语；用于比喻句"},{"id":1652,"word":"三吐三握","pinyin":"sān tǔ sān wò","abbr":"stsw","explanation":"以之为求贤殷切之典。","source":{"text":"周公戒伯禽曰：‘我文王之子，武王之弟，成王之叔父。我于天下亦不贱矣，然我一沐三握发，一饭三吐哺，起以待士。’","book":"《史记·鲁世家》"}},{"id":1653,"word":"三告投杼","pinyin":"sān gào tóu zhù","abbr":"sgtz","explanation":"比喻流言数传能使人信而转疑。","source":{"text":"《战国策·秦策二》：“昔者曾子处费，费人有与曾子同名族者而杀人，人告曾子母曰：‘曾参杀人。’曾子之母曰：‘吾子不杀人。’织自若。有顷焉，人又曰：‘曾参杀人。’其母尚织自若也。顷之，一人又告之曰：‘曾参杀人。’其母惧，投杼逾墙而走。"},"example":{"text":"鲁迅《书信集·致李康中》：“然而～，贤母生疑。千夫所指，无疾而死。”"},"usage":"作宾语、定语；用于书面语","story":["春秋时期，费地有一个与曾参同名的人在外杀了人，有好事者跑到曾参的母亲那里说：“曾参杀了人。”曾母回答说：“我儿不会杀人。”照常织布。没多久又有两人跑来误传曾参杀了人，这时曾母害怕，就投杼逾墙而走"]},{"id":1654,"word":"三命而俯","pinyin":"sān mìng ér fǔ","abbr":"smef","explanation":"旧是指官职步步上升，态度也愈加谦虚。","source":{"text":"一命而偻，再命而伛，三命而俯。","book":"《左传·昭公七年》"},"usage":"作谓语；用于书面语"},{"id":1655,"word":"三回九转","pinyin":"sān huí jiǔ zhuǎn","abbr":"shjz","explanation":"①形容曲折回荡。②犹三番五次。指多次。","source":{"text":"诵真经三回九转，敲钟磬动地惊天。","book":"《奈何天·逃禅》"},"example":{"text":"就为了这点事，他～地来找我，真是奇怪！"},"similar":["三番五次"],"usage":"作谓语、状语；用于书面语"},{"id":1656,"word":"三回五次","pinyin":"sān huí wǔ cì","abbr":"shwc","explanation":"指多次。","source":{"text":"小官平日目不视邪色，耳不听淫声，太守故三回五次，侮弄下官。","book":"元·戴善夫《风光好》第一折"},"example":{"text":"赵云～请夫人上马，夫人只不肯上马。","book":"《三国演义》第四一回"},"similar":["三番五次"],"usage":"作状语；形容次数很多"},{"id":1657,"word":"三坟五典","pinyin":"sān fén wǔ diǎn","abbr":"sfwd","explanation":"三坟：指伏羲、神农、黄帝的书；五典：指少昊、颛顼、高辛、唐、虞的书。相传为我国最早的古籍。","source":{"text":"是能读《三坟》、《五典》、《八索》、《九丘》。","book":"《左传·昭公十二年》"},"example":{"text":"无论是古是今，是人是鬼，是～，百宋千元，天球河图，金人玉佛，祖传丸散，秘制膏丹，全都踏倒他。","book":"鲁迅《忽然想到》六"},"usage":"作主语、宾语、定语；指最早的古籍"},{"id":1658,"word":"三复斯言","pinyin":"sān fù sī yán","abbr":"sfsy","explanation":"三复：多次反复；斯言：这句话。反复朗读并体会这句话。形容对它极为重视。","source":{"text":"《诗经·大雅·抑》之篇曰：‘白圭之玷，尚可磨也；斯言之玷，不可为也。’南容一日三复此言。","book":"《论语·先进》：“南容三复《白圭》。”朱熹注"},"example":{"text":"愿天下有心人～而早为之所焉可耳。","book":"严复《原强》"},"usage":"作谓语；形容对它极为重视"},{"id":1659,"word":"三复白圭","pinyin":"sān fù bái guī","abbr":"sfbg","explanation":"指慎于言行。","source":{"text":"《诗》云：‘白圭之玷，尚可磨也；斯言之玷，不可为也。’南容读诗至此，三反复之，是其心慎言也。","book":"《论语·先进》：“南容三复白圭，孔子以其兄之子妻之。”何晏集解引孔安国曰"}},{"id":1660,"word":"三天两头","pinyin":"sān tiān liǎng tóu","abbr":"stlt","explanation":"隔一天，或几乎每天。形容经常、频繁。","source":{"text":"西北悬天起了乌黑的云朵，不大一会，瓢泼大雨到来了，夹着炸雷和闪电，因为三天两头地下雨，道上黑泥总是不干的，出门的人们都是光着脚丫子，顺着道沿走。","book":"周立波《暴风骤雨》第一部十二"},"example":{"text":"你不要～往我这儿跑。"},"similar":["隔三差五"],"usage":"作状语；指经常"},{"id":1661,"word":"三天打鱼，两天晒网","pinyin":"sān tiān dǎ yú，liǎng tiān shài wǎng","abbr":"stdyltsw","explanation":"比喻对学习、工作没有恒心，经常中断，不能长期坚持。","source":{"text":"因此也假说来上学，不过是三日打鱼，两日晒网，白送些束修礼物与贾代儒。","book":"清·曹雪芹《红楼梦》第九回"},"example":{"text":"体育锻炼要每天坚持，不要～。"},"similar":["一曝十寒"],"opposite":["坚持不懈","锲而不舍"],"usage":"作宾语、状语、分句；指没有恒心"},{"id":1662,"word":"三夫之对","pinyin":"sān fū zhī duì","abbr":"sfzd","explanation":"泛指经过多人传播的流言。同“三夫之言”。","source":{"text":"今臣之信行，未若曾参之著；而谗构沸腾，非徒三夫之对，外内扇助，为二五之应。","book":"《晋书·王濬传》"},"similar":["三夫之言"],"usage":"作宾语、主语；指流言"},{"id":1663,"word":"三夫之言","pinyin":"sān fū zhī yán","abbr":"sfzy","explanation":"泛指经过多人传播的流言。","source":{"text":"昔者曾子处费，费人有与曾子同名族者而杀人，人告曾子母曰：‘曾参杀人。’曾子母曰：‘吾子不杀人。’织自若。有顷焉，人又曰：‘曾参杀人。’其母尚织自若。顷之，一人又告之曰：‘曾参杀人。’其母惧……","book":"《战国策·秦策二》"},"example":{"text":"海内不知其过，众庶未闻其毁，卒遇～，横被诬罔之谗，家属杜门，葬不归墓，怨隙并兴，宗亲怖栗。","book":"《后汉书·马援传》"},"similar":["三夫之对"],"usage":"作宾语、主语；指流言","story":["春秋时期，费地有一个与曾参同名的人在外杀了人，有好事者跑到曾参的母亲那里说：“曾参杀了人。”曾母回答说：“我儿不会杀人。”照常织布。没多久又有两人跑来误传曾参杀了人，这时曾母害怕，就投杼逾墙而走"]},{"id":1664,"word":"三夫成市虎","pinyin":"sān fū chéng shì hǔ","abbr":"sfcsh","explanation":"比喻说的人多了，就能使人们把谣言当事实。同“三人成虎”。","source":{"text":"三夫成市虎，慈母投杼趋。","book":"《宋书·乐志三》"},"example":{"text":"《宋书·乐志》：“～，慈母投杼趋。”"},"similar":["三人市虎","三人成市虎"],"usage":"作宾语、定语；用于书面语"},{"id":1665,"word":"三头两日","pinyin":"sān tóu liǎng rì","abbr":"stlr","explanation":"三二天。形容时间相隔很近。","source":{"text":"一切日用盘费，三头两日俱是通州差人送来。","book":"清·西周生《醒世姻缘传》第六回"},"usage":"作定语、状语；用于口语"},{"id":1666,"word":"三头两绪","pinyin":"sān tóu liǎng xù","abbr":"stlx","explanation":"形容事务繁杂，不易弄清头绪。","source":{"text":"不知以敬为主，而欲存心，则不免将一个心把捉一个心，外面未有一事时，里面已是三头两绪矣。","book":"宋·朱熹《答张敬夫书》"},"similar":["千头万绪","两头三绪"],"usage":"作谓语、定语；形容事务繁杂"},{"id":1667,"word":"三头两面","pinyin":"sān tóu liǎng miàn","abbr":"stlm","explanation":"看对方的脸色而改变态度。比善于迎和奉承和玩弄两面手法。","source":{"text":"三头两面趋奉人。","book":"唐·李商隐《杂篡·愚昧》"},"example":{"text":"上堂七手八脚，～，耳听不闻，眼觑不见，苦乐逆顺，打成一片。","book":"宋·释普济《五灯会元》卷二十"},"similar":["两面三刀","三头二面"],"usage":"作宾语、定语；指玩弄两面手法"},{"id":1668,"word":"三头二面","pinyin":"sān tóu èr miàn","abbr":"stem","explanation":"看对方的脸色而改变态度。比善于迎和奉承和玩弄两面手法。","source":{"text":"三头二面趋奉人。","book":"唐·李商隐《杂篡·愚昧》"},"similar":["三头两面"],"usage":"作宾语、定语；指玩弄两面手法"},{"id":1669,"word":"三头八臂","pinyin":"sān tóu bā bì","abbr":"stbb","explanation":"神道的形状。后比喻神通广大，本领出众。同“三头六臂”。","source":{"text":"［修罗道者］体貌粗鄙，每怀瞋毒，棱层可畏，拥耸惊人，并出三头，重安八臂，跨山蹋海，把日擎云。","book":"《法苑珠林》卷九"},"example":{"text":"未及数合，哪吒现了～，登起风火轮，先在潼关城上。","book":"明·许仲琳《封神演义》第八十二回"},"similar":["三头六臂"],"usage":"作谓语、宾语、定语；指神通广大"},{"id":1670,"word":"三头六臂","pinyin":"sān tóu liù bì","abbr":"stlb","explanation":"三个脑袋，六条胳臂。原为佛家语，指佛的法相。后比喻神奇的本领。","source":{"text":"三头六臂擎天地，忿怒那吒扑帝钟。","book":"宋·释道原《景德传灯录》卷十三"},"example":{"text":"吕岳在金眼驼上，现出～，大显神通。","book":"明·许仲琳《封神演义》第五十九回"},"similar":["神通广大","三首六臂"],"opposite":["黔驴技穷","一无所长"],"usage":"作谓语、宾语、定语；指神通广大"},{"id":1671,"word":"三头六证","pinyin":"sān tóu liù zhèng","abbr":"stlz","explanation":"指众多的人证。","source":{"text":"[李春山]心想，横竖抵死不认帐，只你徐元菊一个人，缺少三头六证，未见得就给我说死了。","book":"克非《春潮急》二八"},"usage":"作宾语、定语；用于口语"},{"id":1672,"word":"三头六面","pinyin":"sān tóu liù miàn","abbr":"stlm","explanation":"指当着众人或有关各方之面。","source":{"text":"究竟不得明白，方才在这边三头六面，认将出来，方才晓得是这本新戏。","book":"清·李渔《风筝误·释释》"},"usage":"作宾语、定语；用于书面语"},{"id":1673,"word":"三头对案","pinyin":"sān tóu duì àn","abbr":"stda","explanation":"指有关双方在证人或中间人在场时一起对质，讲清楚事情真相。","source":{"text":"白氏三兄弟‘三头对案’，现场监督，明唱明记核查账簿，那情景很是庄重。","book":"郭宝昌《大宅门》第二十八章"},"example":{"text":"这件事情我们～，一次弄清，从此毫无瓜葛。"},"similar":["三曹对案"],"usage":"作谓语、宾语；指审问案件当场对质"},{"id":1674,"word":"三好两歉","pinyin":"sān hǎo liǎng qiàn","abbr":"shlq","explanation":"指时好时病。形容体弱。","source":{"text":"那女儿年方一十二岁，一貌如花，且是聪明，单只从小的三好两歉，有些小病。","book":"明·凌濛初《初刻拍案惊奇》卷三十四"},"example":{"text":"文虚自奚囊落水，常是～，只可在家照看门户。","book":"清·夏敬渠《野叟曝言》第十三回"},"similar":["三好两歹"],"usage":"作宾语、定语；用于口语"},{"id":1675,"word":"三好两歹","pinyin":"sān hǎo liǎng dǎi","abbr":"shld","explanation":"身体三天好，两天不好。指时好时病。形容体弱。","source":{"text":"虔婆道：‘也常时三好两歹的，亏的太平府陈四老爷照顾他。’","book":"清·吴敬梓《儒林外史》第五十四回"},"similar":["三好两歉"],"usage":"作宾语、定语；用于口语"},{"id":1676,"word":"三好二怯","pinyin":"sān hǎo èr qiè","abbr":"sheq","explanation":"指时好时病。形容体弱。同“三好两歹”。","source":{"text":"娘子与冯官人相见之后，至今三好二怯。","book":"明·洪楩《清平山堂话本·风月相思》"},"similar":["三好两歹"],"usage":"作谓语、宾语；用于书面语"},{"id":1677,"word":"三妻四妾","pinyin":"sān qī sì qiè","abbr":"sqsq","explanation":"妻妾众多的意思。","source":{"text":"你做状元的人，三妻四妾，任凭再娶。","book":"明·兰陵笑笑生《金瓶梅词话》第一回：“至如三妻四妾，买笑追欢的，又当别论。”清·李渔《风筝误·逼婚》"},"example":{"text":"褚氏道：“原来你是个呆子。那皇帝家有三宫六院，富贵家有～。日后正宫虽然没分，我女儿偏宫是一定有的，你怎么说出这呆话？”","book":"清·吴璿《飞龙全传》第四十五回"},"similar":["妻妾成群"],"usage":"作主语、宾语、定语；指妻妾众多"},{"id":1678,"word":"三姑六婆","pinyin":"sān gū liù pó","abbr":"sglp","explanation":"比喻不务正业的妇女。","source":{"text":"三姑者，尼姑、道姑、卦姑也；六婆者，牙婆、媒婆、师婆、虔婆、药婆、稳婆也。","book":"元·陶宗仪《辍耕录》卷十三"},"example":{"text":"吾闻贵地有～，一经招引入门，妇女无知，往往为其所害，或哄骗银钱，或拐带衣物。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["三教九流"],"opposite":["良家妇女"],"usage":"作主语、宾语、定语；指女性"},{"id":1679,"word":"三婆两嫂","pinyin":"sān pó liǎng sǎo","abbr":"spls","explanation":"犹言三妻四妾。","source":{"text":"吏勋封考，三婆两嫂。","book":"宋·陆游《老学庵笔记》六"}},{"id":1680,"word":"三媒六证","pinyin":"sān méi liù zhèng","abbr":"smlz","explanation":"旧时婚姻，由父母包办，还必须有媒人介绍。表示郑重其事。","source":{"text":"我大茶小礼，三媒六证，亲自娶了个夫人。","book":"元·武汉臣《生金阁》第二折"},"example":{"text":"媒人原来只是小旦一个人，刘家因为想合乎～那句古话，又拼凑了两个人。","book":"赵树理《邪不压正》"},"similar":["明媒正娶"],"usage":"作主语、宾语、定语；表示婚约郑重其事"},{"id":1681,"word":"三字狱","pinyin":"sān zì yù","abbr":"szy","explanation":"狱：指官司，罪案。指宋朝名将岳飞的冤狱。后也泛指冤狱。","source":{"text":"‘莫须有’三字，何以服天下？","book":"《宋史·岳飞传》"},"example":{"text":"谁将～，堕此一长城。","book":"明·蔡汝南《岳王墓》诗"}},{"id":1682,"word":"三宫六院","pinyin":"sān gōng liù yuàn","abbr":"sgly","explanation":"泛指帝王的妃嫔。","source":{"text":"兀那三宫六院，妃嫔彩女听者：明日圣驾亲到御园，打一金弹，金弹落处，有拾得者。","book":"元·无名氏《抱妆盒》楔子"},"example":{"text":"天子封我掌国邦，～皆钦付。","book":"弹词《英烈春秋》"},"similar":["三妻四妾"],"usage":"作宾语；泛指帝王的妃嫔"},{"id":1683,"word":"三家村","pinyin":"sān jiā cūn","abbr":"sjc","explanation":"指偏僻的小乡村。","source":{"text":"永谢十年旧，老死三家村。","book":"宋·苏轼《用旧韵送鲁远翰知洛州》"},"usage":"作宾语、定语；指小地方"},{"id":1684,"word":"三寸不烂之舌","pinyin":"sān cùn bù làn zhī shé","abbr":"scblzs","explanation":"比喻能说会辩的口才。","source":{"text":"毛先生以三寸不烂之舌，强于百万之师。","book":"《史记·平原君虞卿列传》"},"example":{"text":"小生必须自去那里，凭～，说他们入伙。","book":"明·施耐庵《水浒全传》第十五回"},"similar":["三寸之舌"],"usage":"作宾语；比喻能说会道，善于应付的嘴","story":["汉高祖刘邦的得力谋士张良，精通兵法，很有谋略，能言善辩。他出谋划策、运筹帷幄，帮助刘邦建立西汉政权。刘邦称帝之后，想封张良为“留侯”，张良想出家当道士说：“我凭着自己的三寸舌，报了秦国灭韩国之仇，我心满意足了”"]},{"id":1685,"word":"三寸之舌","pinyin":"sān cùn zhī shé","abbr":"sczs","explanation":"比喻能说会辩的口才。","source":{"text":"毛先生以三寸不烂之舌，强于百万之师。","book":"《史记·平原君虞卿列传》"},"example":{"text":"他凭着～，使许多人听信了他的谎言。"},"similar":["三寸不烂之舌"],"usage":"作宾语；比喻能说会辩的口才","story":["汉高祖刘邦的得力谋士张良，精通兵法，很有谋略，能言善辩。他出谋划策、运筹帷幄，帮助刘邦建立西汉政权。刘邦称帝之后，想封张良为“留侯”，张良想出家当道士说：“我凭着自己的三寸舌，报了秦国灭韩国之仇，我心满意足了”"]},{"id":1686,"word":"三寸之辖","pinyin":"sān cùn zhī xiá","abbr":"sczx","explanation":"辖：车轴头上穿的小铁棍，管住轮子使其不脱落。指车辖。比喻事物的关键。","source":{"text":"车之所以能转千里者，以其要在三寸之辖。","book":"《淮南子·人间训》"}},{"id":1687,"word":"三寸金莲","pinyin":"sān cùn jīn lián","abbr":"scjl","explanation":"金莲：旧指女子缠过的小脚。封建时代美誉妇女小脚的用语。","source":{"text":"凿金为莲花以帖地，令潘妃行春上，曰：‘此步步生莲花也。’","book":"《南史·齐东昏侯纪》"},"example":{"text":"面貌虽黑，但弯弯两道朱眉，盈盈一双秀目，再衬着万缕青丝，樱桃小口，底下露著～，倒也不俗。","book":"清·李汝珍《镜花缘》第十六回"},"usage":"作宾语、定语；用于比喻句"},{"id":1688,"word":"三寸鸟，七寸嘴","pinyin":"sān cùn niǎo，qī cùn zuǐ","abbr":"scnqcz","explanation":"比喻能说会道（多用于讽刺）。","example":{"text":"～多用来骂人。"},"usage":"作宾语、定语；多用于讽刺"},{"id":1689,"word":"三对六面","pinyin":"sān duì liù miàn","abbr":"sdlm","explanation":"人 指会同当事双方及中间人或见证人。","source":{"text":"回头我自会请三先生来，大家三对六面讲个明白。","book":"茅盾《子夜》"},"example":{"text":"张孔既然来这里检查工作，就只听一面之辞？走，咱们去～谈谈。","book":"杜鹏程《在和平的日子里》第六章"},"similar":["三曹对案"],"usage":"作宾语、定语、状语；指会同当事双方及中间"},{"id":1690,"word":"三尸乱爆，七窍生烟","pinyin":"sān shī luàn bào，qī qiào shēng yān","abbr":"sslbqqsy","explanation":"三尸：道家认为人体内有作崇的神，叫“三尸”或“三尸神”；七窍：指两眼、两耳、两鼻孔和嘴。形容人气愤到极点。","source":{"text":"太师闻报，破了两阵，只急得三尸神暴跳，七窍内生烟。","book":"明·许仲琳《封神演义》第四十八回"},"example":{"text":"这时一些官员，面面相觑，没奈他何，制台是气的～。","book":"清·吴趼人《二十年目睹之怪现状》第四十七回"}},{"id":1691,"word":"三尸五鬼","pinyin":"sān shī wǔ guǐ","abbr":"sswg","explanation":"比喻奸佞之臣。"},{"id":1692,"word":"三尸暴跳","pinyin":"sān shī bào tiào","abbr":"ssbt","explanation":"形容人气愤到极点。","source":{"text":"太师闻报，破了两阵，只急得三尸神暴跳，七窍内生烟。","book":"明·许仲琳《封神演义》第四十八回"},"example":{"text":"岳钟麒上表谢罪，说要请求在吐鲁番屯垦，以为久战之计。雍正气得～。","book":"二月河《雍正皇帝》一百三十九"}},{"id":1693,"word":"三尸暴跳，七窍生烟","pinyin":"sān shī bào tiào，qī qiào shēng yān","abbr":"ssbtqqsy","explanation":"三尸：道家认为人体内有作崇的神，叫“三尸”或“三尸神”；七窍：指两眼、两耳、两鼻孔和嘴。形容人气愤到极点。","source":{"text":"太师闻报，破了两阵，只急得三尸神暴跳，七窍内生烟。","book":"明·许仲琳《封神演义》第四十八回"},"example":{"text":"骆青相真气得～。老大气喘了一回，方才同段承恩商议，要报这个仇的话。","book":"清·吴趼人《糊涂世界》第十一回"}},{"id":1694,"word":"三尸神暴跳，七窍内生烟","pinyin":"sān shī shén bào tiào，qī qiào nèi shēng yān","abbr":"sssbtqqnsy","explanation":"三尸：道家认为人体内有作崇的神，叫“三尸”或“三尸神”；七窍：指两眼、两耳、两鼻孔和嘴。形容人气愤到极点。","source":{"text":"太师闻报，破了两阵，只急得三尸神暴跳，七窍内生烟。","book":"明·许仲琳《封神演义》第四十八回"}},{"id":1695,"word":"三尺童儿","pinyin":"sān chǐ tóng ér","abbr":"scte","explanation":"指年幼还不太懂事的儿童。","source":{"text":"时清不及英豪人，三尺童儿重廉蔺。","book":"唐·李白《醉后赠从甥高镇》"}},{"id":1696,"word":"三尺童子","pinyin":"sān chǐ tóng zǐ","abbr":"sctz","explanation":"指年幼不懂事的儿童。","source":{"text":"夫三尺童子至无识也，指犬豕而使之拜，则怫然怒。","book":"《宋史·胡铨传》"},"example":{"text":"请不要相信这～的胡言。"},"similar":["三岁小孩"],"usage":"作主语、宾语、定语；指小孩","story":["公元1138年，金国派使者到南宋朝廷“议和”，希望南宋朝廷俯首称臣。秦桧积极鼓吹接受金人的条件。抚州军事判官胡铨上书言事，据理力争，反对投降，他说：“即使是三尺童子让他对猪狗跪拜，他也会勃然大怒的。”秦桧给他妄加罪名降职处理"]},{"id":1697,"word":"三尺童蒙","pinyin":"sān chǐ tóng méng","abbr":"sctm","explanation":"指年幼还不太懂事的儿童。","source":{"text":"时清不及英豪人，三尺童儿重廉蔺。","book":"唐·李白《醉后赠从甥高镇》"},"example":{"text":"今得先生，人皆仰望。虽～，亦谓彪虎生翼，将见汉室复兴，曹氏即灭矣。","book":"明·罗贯中《三国演义》第四十三回"}},{"id":1698,"word":"三尺门里","pinyin":"sān chǐ mén lǐ","abbr":"scml","explanation":"东北方言，指家庭之内的事。","example":{"text":"我管不着三尺门外，还管得着～。","book":"董玉振《精明人的苦恼》"}},{"id":1699,"word":"三山二水","pinyin":"sān shān èr shuǐ","abbr":"sses","explanation":"三山：护国山，位于南京西南，以有三峰得名；二水：白鹭洲，位于长江之中，分江面为二。泛指南京的山水。","source":{"text":"三山半落青天外，二水中分白鹭洲。","book":"唐·李白《登金陵凤凰台》"}},{"id":1700,"word":"三山五岳","pinyin":"sān shān wǔ yuè","abbr":"sswy","explanation":"五岳：泰山、华山、衡山、嵩山、恒山。泛指名山或各地。","source":{"text":"三山五岳渺何许？云烟汗漫空竛竮。","book":"清·曹寅《舟中望惠山举酒调培山》"},"example":{"text":"～的好汉们各引着同宗同派，摆开了阵势，拚一个你死我活。","book":"茅盾《我们这文坛》"},"similar":["名山大川","天南地北"],"opposite":["不毛之地"],"usage":"作主语、宾语、定语；形容范围大"},{"id":1701,"word":"三差两错","pinyin":"sān chā liǎng cuò","abbr":"sclc","explanation":"泛指差错。比喻偶然的差错。","source":{"text":"你要出了三差两错，叫小堆八在前方知道了，我们可怎么对得起他！","book":"魏巍《东方》第四部第七章"},"example":{"text":"要是有～，我唯你是问。"},"similar":["三差五错"],"usage":"作宾语；指差错"},{"id":1702,"word":"三差五错","pinyin":"sān chā wǔ cuò","abbr":"scwc","explanation":"泛指差错。常指意外的事故。","source":{"text":"要有什么三差五错，那事情就难说了！","book":"曾朴《孽海花》第22回"},"example":{"text":"谁都避免不了有～。"},"similar":["阴差阳错"],"usage":"作宾语；指差错"},{"id":1703,"word":"三平二满","pinyin":"sān píng èr mǎn","abbr":"spem","explanation":"平、满：平日、满日。旧时占卜认为平日、满日主生，为种谷佳日。比喻生活过得去，很满足。","source":{"text":"粗茶淡饭，饱即休，被破遮寒，暖即休；三平二满，过即休，不贪不妨，老即休。","book":"宋·黄庭坚《四休居士诗序》"},"example":{"text":"百年雨打风吹草却，万事～休。","book":"宋·辛弃疾《鹧鸪天·登一丘一壑偶成》"},"similar":["四平八稳"],"usage":"作谓语、定语、状语；比喻生活过得去","story":["宋朝时期，太医孙居昉，字景初，为士大夫免费发药，而且不要别人的感谢。他自号四休居士。山谷问他原因，四休大笑说：“粗茶淡饭饱即休，被破遮寒暖即休；三平二满过即休，不贪不妒老即休。”"]},{"id":1704,"word":"三年不目月","pinyin":"sān nián bù mù yuè","abbr":"snbmy","explanation":"三年不见日月，精神不振，眼睛朦胧。比喻懒于修养，不求进取。","source":{"text":"日有光，月有明。三年不目日，视必盲；三年不目月，精必荧。","book":"汉·扬雄《法言·修身》"}},{"id":1705,"word":"三年不窥园","pinyin":"sān nián bù kuī yuán","abbr":"snbky","explanation":"指专心苦学。","source":{"text":"虽有园圃，不窥视之，言专学也。","book":"《汉书·董仲舒传》：“少治《春秋》，孝景时为博士。下帷讲诵，弟子传以久次相授业，或莫见其面。盖三年不窥园，其精如此。”颜师古注"},"example":{"text":"生专心笃学，～。","book":"苏曼殊《焚剑记》"},"similar":["目不窥园"],"usage":"作宾语、定语；用于处事","story":["西汉时期，广汉学者董仲舒年少时读书非常刻苦，经常是夜以继日地读书，他的书房紧靠着姹紫嫣红的花园，他三年没有进过花园，甚至连一眼都没瞧过。后来他被征为博士，公开聚众讲学，弟子遍布四方"]},{"id":1706,"word":"三年不蜚","pinyin":"sān nián bù fēi","abbr":"snbf","explanation":"蜚：飞。比喻长期退隐，无所作为。","source":{"text":"三年不蜚，蜚将冲天，三年不鸣，鸣将惊人。","book":"《韩非子·喻老》：“虽无飞，飞必冲天；虽无鸣，鸣必惊人。”《史记·楚世家》"}},{"id":1707,"word":"三年之艾","pinyin":"sān nián zhī ài","abbr":"snza","explanation":"病久了才去寻找治这种病的干艾叶。比喻凡事要平时准备，事到临头再想办法就来不及。","source":{"text":"今之欲王者，犹七年之病，求三年之艾也。","book":"《孟子·离娄上》"},"usage":"作宾语；用于劝诫人"},{"id":1708,"word":"三年五载","pinyin":"sān nián wǔ zài","abbr":"snwz","explanation":"三、五：表示大概数量；载：年。指多年。","source":{"text":"也须知俺这三年五载，看看衰迈，还有甚精金响钞，暗暗藏埋。","book":"元·杨文奎《儿女团圆》第二折"},"example":{"text":"要一一介绍出来，恐怕～也说不完。","book":"马烽《吕梁英雄传·起头的话》"},"similar":["年复一年"],"opposite":["一年半载"],"usage":"作谓语、状语；用于时间很长"},{"id":1709,"word":"三年化碧","pinyin":"sān nián huà bì","abbr":"snhb","explanation":"指忠心不泯。","source":{"text":"苌弘死于蜀，藏其血，三年而化为碧。","book":"战国·宋·庄周《庄子·外物》"},"example":{"text":"～心难灭，九转成丹目已穿。","book":"黄忏华《亡友周仲穆哀辞》"},"similar":["苌弘化碧"],"usage":"作谓语；指忠心不泯","story":["周朝时期，刘文公的大夫苌弘一生忠于朝廷，不卑不亢，有浩然正气。他因为正直而得罪了朝中权贵，蒙冤被周人杀害，传说他被杀的当时，有人慕名收集他的血液藏在家里，三年后这些干血块全都化为碧玉"]},{"id":1710,"word":"三征七辟","pinyin":"sān zhēng qī bì","abbr":"szqp","explanation":"三、七：泛指多次；征、辟：征召，指朝廷召举布衣之士授以官职。形容朝廷多次征召选拔。","source":{"text":"于是隐居教授，三征七辟皆不就。","book":"《晋书·王裒传》"},"usage":"作宾语、定语；用于书面语"},{"id":1711,"word":"三径之资","pinyin":"sān jìng zhī zī","abbr":"sjzz","explanation":"三径：所说汉代隐士蒋诩在房前曾开三条小径，后人因以三径代称住宅庭院。比喻筹集隐居住所的费用。","source":{"text":"聊欲弦歌，以为三径之资可乎？","book":"《宋书·陶潜传》"}},{"id":1712,"word":"三徙成国","pinyin":"sān xǐ chéng guó","abbr":"sxcg","explanation":"形容圣人到处都受到百姓的拥戴。同“三徙成都”。","source":{"text":"舜一徙成邑，再徙成都，三徙成国。","book":"《吕氏春秋·贵因》"},"similar":["三徙成都"],"usage":"作宾语、定语；用于书面语","story":["相传尧舜禹时期，舜在没有成为首领前，一心为公，受到百姓的爱戴。他第一次搬迁时，跟随他走的人有一个邑，第二次搬迁时，跟随他走的人有一个都城那么多，到第三次搬迁时，足有一个国家那么多。后来他被尧推举为继承人"]},{"id":1713,"word":"三徙成都","pinyin":"sān xǐ chéng dōu","abbr":"sxcd","explanation":"相传舜三度迁移，百姓慕德而从，所至处自成都邑。形容圣人到处都受到百姓的拥戴。","source":{"text":"舜避丹朱，又不愿众聚，故三度逃走，移徙避之。百姓慕德，从者十万，所居之处，自成都邑。","book":"《庄子·徐无鬼》：“舜有膻行，百姓悦之，故三徙成都，至邓之虚，而有十万家。”成玄英疏"},"example":{"text":"且凡圣人，有损己为世，表行显功，使天下慕之，～者。","book":"三国·魏·嵇康《答难养生论》"},"similar":["三徙成国"],"usage":"作宾语、定语；用于书面语","story":["相传尧舜禹时期，舜在没有成为首领前，一心为公，受到百姓的爱戴。他第一次搬迁时，跟随他走的人有一个邑，第二次搬迁时，跟随他走的人有一个都城那么多，到第三次搬迁时，足有一个国家那么多。后来他被尧推举为继承人"]},{"id":1714,"word":"三心两意","pinyin":"sān xīn liǎng yì","abbr":"sxly","explanation":"常指不安心，不专一。同“三心二意”。","source":{"text":"我的主意已定了，你们都别要三心两意，七嘴八舌的乱了我的主意。","book":"《醒世姻缘传》第二七回"},"example":{"text":"你不要～。早点歇息，明天又要行军了。","book":"欧阳予情《忠王李秀成》第一幕"},"similar":["三心二意","二意三心"],"opposite":["专心致志"],"usage":"作谓语、宾语、状语；指不专心"},{"id":1715,"word":"三心二意","pinyin":"sān xīn èr yì","abbr":"sxey","explanation":"又想这样又想那样，犹豫不定。常指不安心，不专一。","source":{"text":"争奈是匪妓，都三心二意。","book":"元·关汉卿《救风尘》第一折"},"example":{"text":"可是眼下大敌当前，后有追兵，你可千万不要～，迟疑不决，误了大事。","book":"姚雪垠《李自成》第一卷第四章"},"similar":["见异思迁","朝三暮四","二意三心"],"opposite":["一心一意","专心致志"],"usage":"作谓语、宾语、状语；指不专心"},{"id":1716,"word":"三思而后行","pinyin":"sān sī ér hòu xíng","abbr":"ssehx","explanation":"三：再三，表示多次。指经过反复考虑，然后再去做。","source":{"text":"季文子三思而后行。","book":"《南齐书·公冶度》"},"example":{"text":"他非常细心，办事总是～。"},"similar":["三思而行"],"usage":"作宾语、分句；指思考后才行动","story":["春秋时期，孔子带领他的弟子周游列国推销他的仁政，在鲁国碰壁后，他在离开卫国的途中总结在鲁国的经验时，对他的女婿公冶长及子贡等人说：“鲁国执政的人中只有季文子处事不冲动，三思而后行。”弟子们赶紧把他的言语进行记录"]},{"id":1717,"word":"三思而行","pinyin":"sān sī ér xíng","abbr":"ssex","explanation":"三：再三，表示多次。指经过反复考虑，然后再去做。","source":{"text":"季文子三思而后行。","book":"《南齐书·公冶度》"},"example":{"text":"终身大事也应该～。","book":"欧阳山《三家巷》三０"},"similar":["深思熟虑","郑重其事"],"opposite":["不假思索","轻举妄动"],"usage":"作谓语、宾语；指经过反复考虑后再做","story":["春秋时期，鲁国大夫季文子为人谨慎，凡事都要“三思而行”，即多次考虑以后才决定做与不做。孔子都不赞同他的观点，认为只要再思就行，如果三思就会患得患失，疑惑不定了。不过看问题应该是一分为二，客观地分析问题"]},{"id":1718,"word":"三怨成府","pinyin":"sān yuàn chéng fǔ","abbr":"sycf","explanation":"言与三人结怨则仇恨集身，难以免祸。"},{"id":1719,"word":"三战三北","pinyin":"sān zhān sān běi","abbr":"szsb","explanation":"北：败逃。打三仗，败三次。形容屡战屡败。","source":{"text":"吴师大北。越之左军右军，乃遂涉而从之，又大败天没。又郊败之。三战三北，乃至于吴。","book":"《国语·吴语》"},"example":{"text":"待彼～余，试我七纵七擒计。","book":"清·黄遵宪《度辽将军歌》"},"similar":["屡战屡败"],"usage":"作谓语、定语；指屡战屡败"},{"id":1720,"word":"三户亡秦","pinyin":"sān hù wáng qín","abbr":"shwq","explanation":"三户：几户人家；亡：灭。虽只几户人家，也能灭掉秦国。比喻正义而暂时弱小的力量，有消灭暴力的必胜信心。","source":{"text":"故楚南公曰：‘楚虽三户，亡秦必楚’也。","book":"《史记·项羽本纪》"},"example":{"text":"诸侯由是不直秦，未及百年，～之语遂验。","book":"宋·洪迈《容斋四笔·魏冉罪大》"},"similar":["亡秦三户"],"usage":"作宾语、定语；比喻虽小，决心大也能成功","story":["秦朝末期，陈胜吴广起义，各路义军纷纷配合，项梁率军攻秦。范增去拜见项梁说：“秦灭六国，楚国最冤，楚南公说过楚国即使只剩下三户人家都会报仇雪恨消灭秦国的。”于是项梁立楚怀王的孙子米心为楚怀王，得到楚人的拥护而迅速壮大实力"]},{"id":1721,"word":"三折之肱","pinyin":"sān zhé zhī gōng","abbr":"szzg","explanation":"几次断臂，就能知道医治断臂的方法。后比喻对某事阅历多，富有经验，成为内行。也指高明的医道。","source":{"text":"三折肱，知为良医。","book":"《左传·定公十三年》"},"example":{"text":"因过你国倒换关文，见你君臣出榜招医，是我大施～，把他相思之病治好了。","book":"明·吴承恩《西游记》第七十回"},"similar":["三折肱为良医"],"usage":"作宾语；用于书面语"},{"id":1722,"word":"三折其肱","pinyin":"sān zhé qí gōng","abbr":"szqg","explanation":"肱：手臂。几次断臂，就能懂得医治断臂的方法。后比喻对某事阅历多，自能造诣精深。","source":{"text":"三折肱知为良医。","book":"春秋·鲁·左丘明《左传·定公十三年》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“口尚乳臭，谓世人年少无知；～，谓医士老成谙练。”"},"similar":["三折肱为良医"],"usage":"作宾语、定语；指久病成良医","story":["春秋时期，晋国内部范氏和中行氏两个集团准备起兵攻打晋定公，很多人认为晋定公又要失败，有人认为范氏起兵属于反叛行为，民众不会支持的，再说晋定公已经屡战屡败，只要好好总结经验，就像三折肱为良医一样，不会失败的"]},{"id":1723,"word":"三折股为良医","pinyin":"sān zhé gǔ wéi liáng yī","abbr":"szgwly","explanation":"比喻对某事阅历多，富有经验，自能造诣精深。","source":{"text":"三折股为良医。予五升词场，四遭掎摭，是以窃知乎文则。","book":"唐·欧阳詹《送洪孺卿赴举序》"},"similar":["三折肱为良医"],"usage":"作宾语、定语、分句；指经历多成专家"},{"id":1724,"word":"三折肱为良医","pinyin":"sān zhé gōng wéi liáng yī","abbr":"szgwly","explanation":"几次断臂，就能懂得医治断臂的方法。后比喻对某事阅历多，富有经验，自能造诣精深。","source":{"text":"三折肱知为良医。","book":"先秦·左丘明《左传·定公十三年》"},"example":{"text":"必不敢薄视公以后之史而以为不足学；～，而喟然三叹也。","book":"清·钱谦益《汲古阁毛氏新刻十七史序》"},"similar":["三折股为良医"],"usage":"作宾语、定语、分句；指经历多成专家","story":["春秋时期，晋国内部范氏和中行氏两个集团准备起兵攻打晋定公，很多人认为晋定公又要失败，有人认为范氏起兵属于反叛行为，民众不会支持的，再说晋定公已经屡战屡败，只要好好总结经验，就像三折肱为良医一样，不会失败的"]},{"id":1725,"word":"三折肱，为良医","pinyin":"sān zhé gōng，wéi liáng yī","abbr":"szgwly","explanation":"几次断臂，就能知道医治断臂的方法。后比喻对某事阅历多，富有经验，成为内行。也指高明的医道。","source":{"text":"三折肱，知为良医。","book":"《左传·定公十三年》"}},{"id":1726,"word":"三拜九叩","pinyin":"sān bài jiǔ kòu","abbr":"sbjk","explanation":"指封建社会进见帝王及祭拜祖先的大礼。","source":{"text":"晋大夫三拜稽首曰：‘君履后土而戴皇天，皇天后土实闻君之言，群臣敢在下风。’","book":"《左传·僖公十五年》"},"example":{"text":"净鞭一响，肃然无声，只听鸿胪寺的鸣赞高声赞礼，群臣趋跄跪拜，也是～的最敬礼。","book":"高阳《慈禧全传》四"}},{"id":1727,"word":"三拳不敌四手","pinyin":"sān quán bù dí sì shǒu","abbr":"sqbdss","explanation":"比喻人少的敌不过人多的。","example":{"text":"真是～，我们还是增加人吧。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":1728,"word":"三拳两脚","pinyin":"sān quán liǎng jiǎo","abbr":"sqlj","explanation":"形容不多几下拳打脚踢。","source":{"text":"三拳两脚，和大虫敌斗，把大虫登时打死了。","book":"《金瓶梅词话》第一回"},"example":{"text":"也就经不起～，一样跌倒地下，想《拳经》不起来了。","book":"《何典》第二回"},"usage":"作宾语、状语；指动作迅速"},{"id":1729,"word":"三推六问","pinyin":"sān tuī liù wèn","abbr":"stlw","explanation":"推：推究；问：审问。旧时指反复审训。","source":{"text":"有他娘子将小人告到官中，三推六问，吊拷绷扒，打的小人受不过，只得屈招了。","book":"元·孙仲章《勘头巾》第三折"},"example":{"text":"他将你孩儿拖到官中，受尽～，吊拷绷扒。","book":"元·关汉卿《窦娥冤》第四折"},"similar":["六问三推"],"usage":"作谓语、定语；指反复审讯"},{"id":1730,"word":"三教一体","pinyin":"sān jiào yī tǐ","abbr":"sjyt","explanation":"三教：指儒教、道教、佛教；一体：一家。旧时认为三教形式不同，但同是一个本源。","source":{"text":"金丹舍利同仁义，三教元来是一家。","book":"明·许仲琳《封神演义》第六十五回"}},{"id":1731,"word":"三教九流","pinyin":"sān jiào jiǔ liú","abbr":"sjjl","explanation":"旧指宗教或学术上的各种流派。也指社会上各行各业的人。","source":{"text":"（梁武）帝问三教九流及汉朝旧事，了如目前。","book":"宋·赵彦卫《云麓漫钞》卷六"},"example":{"text":"他是个社会活动家，朋友遍及～。"},"similar":["三姑六婆","五行八作"],"opposite":["正人君子"],"usage":"作主语、宾语、定语；指各种人"},{"id":1732,"word":"三无坐处","pinyin":"sān wú zuò chù","abbr":"swzc","explanation":"坐处：坐位。本指宰相、御史、员外官员太多，没有办公的地方可坐。后泛指官员太多，人浮于事。","source":{"text":"故时人谓之三无坐处，谓宰相、御史及员外官也。","book":"唐·杜佑《通典·职官典一》：“逮乎景龙，官纪大紊，复有斜封无坐处之诵兴焉。”注"},"example":{"text":"自此小人各援引其党类，滥官日多，朝堂充溢，时人以为～。","book":"清·褚人获《隋唐演义》第七十七回"}},{"id":1733,"word":"三日不弹，手生荆棘","pinyin":"sān rì bù tán，shǒu shēng jīng jí","abbr":"srbdssjj","explanation":"三天不弹琴，手就象长了荆棘那样不灵活。比喻一停止练习，技艺就会生疏。","source":{"text":"这果真是三日不弹，手生荆棘。","book":"清·曹雪芹《红楼梦》第八十六回"},"usage":"作宾语、定语；用于比喻句"},{"id":1734,"word":"三日两头","pinyin":"sān rì liǎng tóu","abbr":"srlt","explanation":"隔一天，或几乎每天。形容经常、频繁。","source":{"text":"还亏是我呢，要是别的，死皮赖脸的三日两头儿来缠舅舅，要升三升米二升豆子，舅舅也就没法儿呢。","book":"清·曹雪芹《红楼梦》第二十四回"},"example":{"text":"却说晁大舍自从与典史相知了，～，自己到监里去看望珍哥。","book":"清·西周生《醒世姻缘传》第十四回"}},{"id":1735,"word":"三日仆射","pinyin":"sān rì pú yì","abbr":"srps","explanation":"仆射：古代官名。旧指沉缅于饮酒的人。","source":{"text":"过江积年，恒大饮酒，常经三日不醒。时人谓之三日仆射。","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":1736,"word":"三日入厨","pinyin":"sān rì rù chú","abbr":"srrc","explanation":"古代风俗，新娘结婚三日后到厨房做饭。借指初入社会或刚任职。","source":{"text":"三日入厨下，洗手作羹汤。未谙姑食性，先遣小姑尝。","book":"唐·王建《新嫁娘》"}},{"id":1737,"word":"三日打鱼，两日晒网","pinyin":"sān rì dǎ yú，liǎng rì shài wǎng","abbr":"srdylrsw","explanation":"比喻对学习、工作没有恒心，经常中断，不能长期坚持。","source":{"text":"因此也假说来上学，不过是三日打鱼，两日晒网，白送些束修礼物与贾代儒。","book":"清·曹雪芹《红楼梦》第九回"},"example":{"text":"体育锻炼要每天坚持，不要～。"},"similar":["三天打鱼，两天晒网"],"opposite":["持之以恒"],"usage":"作宾语、状语、分句；指没有恒心","story":["薛蟠从老家来到大观园住下后，打听到贾府有一所家学，学校里有许多年轻人，就动了龙阳之兴，假装去上学，不过是三日打鱼，两日晒网而已。学校里有些学生图薛蟠的钱财就被上了他的贼船。秦钟与贾宝玉来上学，薛蟠立刻就打他们的主意"]},{"id":1738,"word":"三日新妇","pinyin":"sān rì xīn fù","abbr":"srxf","explanation":"旧时过门三日之新妇，举止不得自专。因以喻行动备受拘束者。","source":{"text":"景宗谓所亲曰：‘今来扬州作贵人，动转不得，路行开车幔，小人辄言不可。闭置车中，如三日新妇。遭此邑邑，使人无气。","book":"《梁书·曹景宗传》"},"example":{"text":"香光俊骨逸韵，有足多者，然局束如辕下驹，骞怯如～。","book":"康有为《广艺舟双楫·体变》"},"usage":"作宾语、定语；用于比喻句"},{"id":1739,"word":"三日耳聋","pinyin":"sān rì ěr lóng","abbr":"srel","explanation":"形容受到强烈的震动。","source":{"text":"佛法不是小事，老僧昔在蒙马大师一喝，直得三日耳聋眼黑。","book":"宋·释道原《景德传灯录》卷六"}},{"id":1740,"word":"三旨相公","pinyin":"sān zhǐ xiàng gōng","abbr":"szxg","explanation":"用来讽刺庸禄低能的大官。","source":{"text":"以其上殿进呈，曰取圣旨；上可否讫，云领圣旨；退谕禀事者，曰已得圣旨也。","book":"《宋史·王圭传》"},"usage":"作宾语、定语；指低能的大官"},{"id":1741,"word":"三旬九食","pinyin":"sān xún jiǔ shí","abbr":"sxjs","explanation":"旬：十天叫一旬。三十天中只能吃九顿饭。形容家境贫困。","source":{"text":"三旬九遇食，十年著一冠。","book":"汉·刘向《说苑·立节》：“子思居于卫，缊袍无表，二旬而九食。”晋·陶潜《拟古》诗"},"usage":"作定语；指贫困"},{"id":1742,"word":"三星在天","pinyin":"sān xīng zài tiān","abbr":"sxzt","explanation":"指新婚。","source":{"text":"绸缪束薪，三星在天。","book":"《诗经·唐风·绸缪》"},"similar":["三星在户"],"usage":"作宾语、定语；用于书面语"},{"id":1743,"word":"三星在户","pinyin":"sān xīng zài hù","abbr":"sxzh","explanation":"表示新婚之喜。","source":{"text":"绸缪束楚，三星在户。","book":"《诗经·唐风·绸缪》"},"similar":["三星在天"],"usage":"作宾语、定语；用于书面语"},{"id":1744,"word":"三星高照","pinyin":"sān xīng gāo zhào","abbr":"sxgz","explanation":"三星：原指明亮而接近的三颗星，也指福星、禄星、寿星三个神仙。指有福、禄、有寿，命运好。","source":{"text":"绸缪束薪，三星在天。","book":"《诗经·唐风·绸缪》"}},{"id":1745,"word":"三智五猜","pinyin":"sān zhì wǔ cāi","abbr":"szwc","explanation":"比喻用尽心思，多方猜测。","source":{"text":"老娘也不消得三智五猜，只一智便猜个十分。","book":"明·施耐庵《水浒传》第24回"},"usage":"作谓语、宾语；指多方猜测"},{"id":1746,"word":"三更半夜","pinyin":"sān gēng bàn yè","abbr":"sgby","explanation":"一夜分为五更，三更是午夜十二时。指深夜。","source":{"text":"四人者（陈象舆、胡旦、董俨、梁灝）日夕会昌言第。京师为之语曰：‘陈三更，董半夜’。","book":"《宋史·赵昌言传》"},"example":{"text":"他常常工作到～。"},"similar":["半夜三更","夜半三更"],"usage":"作宾语、定语；指深夜"},{"id":1747,"word":"三曹对案","pinyin":"sān cáo duì àn","abbr":"scda","explanation":"指审问对质。","source":{"text":"第一殿秦广大王即差鬼使催请陛下，要三曹对案。","book":"明·吴承恩《西游记》第11回"},"example":{"text":"一个偷情，一个寻拿，拿住了～，我也无回话。","book":"清·曹雪芹《红楼梦》第28回"},"similar":["当面对质"],"usage":"作谓语、宾语；指审问案件当场对质"},{"id":1748,"word":"三月不知肉味","pinyin":"sān yuè bù zhī ròu wèi","abbr":"sybzrw","explanation":"三个月之内吃肉不觉得有味道。比喻集中注意力于某一事物而忘记了其它事情。也借用来形容几个月不吃肉。","source":{"text":"子在齐闻《韶》，三月不知肉味。","book":"《论语·述而》"},"usage":"作宾语、定语、分句；用于生活或比喻句等","story":["春秋时期，年轻的孔丘在季府赶车，曾偷偷去季府乐师师襄子那里去学琴，也能练几曲。后来师襄子得罪了季武子被赶出季府，在外沿街乞讨与卖艺。孔子在街头遇到落魄的琴师，诉说他当年在齐国听到《韶乐》三月不知肉味的感觉"]},{"id":1749,"word":"三朋四友","pinyin":"sān péng sì yǒu","abbr":"spsy","explanation":"泛指各种朋友。","source":{"text":"常言‘同声相应，同气相求’，自有一班无赖子弟，三朋四友，和他擎鹰放鹞，驾犬驰马，射猎打生为乐。","book":"明·冯梦龙《醒世恒言》卷五"},"example":{"text":"大学毕业，年届三十，婚姻难就，累得～八方搭线，但一次一次介绍终未能成就。","book":"贾平凹《笑口常开》"},"similar":["狐朋狗友"],"usage":"作主语、宾语、定语；指各种朋友"},{"id":1750,"word":"三朝五日","pinyin":"sān zhāo wǔ rì","abbr":"scwr","explanation":"指三、五天。"},{"id":1751,"word":"三朝元老","pinyin":"sān cháo yuán lǎo","abbr":"scyl","explanation":"元老：资格最老，声望最高的老臣。原指受三世皇帝重用的臣子。现在用来指在一个机构里长期工作过的资格老的人。","source":{"text":"行太尉事节乡侯熹三世在位，为国元老。","book":"《后汉书·章帝纪》"},"example":{"text":"享堂落成，数人直宿其中，天明见堂上一匾云：“～”。","book":"清·蒲松龄《聊斋志异·三朝元老》"},"usage":"作主语、宾语；指老资格"},{"id":1752,"word":"三期贤佞","pinyin":"sān qī xián nìng","abbr":"sqxn","explanation":"以之为不辨是非黑白的典实。","source":{"text":"汉王尊任京兆尹，凡三岁，除恶安良，治绩显着，后为御史大夫所诬，免官。湖县三老上书为之辩白：“一尊之身，三期之间，乍贤乍佞，岂不甚哉！”见《汉书·王尊传》。"}},{"id":1753,"word":"三杀三宥","pinyin":"sān shā sān yòu","abbr":"sssy","explanation":"宥：赦罪。形容断案慎重。","source":{"text":"当尧之时，皋陶为士。将杀人，皋陶曰：‘杀之三。’尧曰：‘宥之三。’故天下畏皋陶执法之坚，而乐尧用刑之宽。","book":"宋·苏轼《省试刑赏忠厚之至论》"}},{"id":1754,"word":"三杯两盏","pinyin":"sān bēi liǎng zhǎn","abbr":"sblz","explanation":"形容饮用少量的酒。","source":{"text":"三杯两盏淡酒，怎敌他、晚来风急。","book":"宋·李清照《声声慢》词"},"example":{"text":"俺与你浅斟低唱互更番，～，遣兴消闲。","book":"清·洪昇《长生殿·惊变》"}},{"id":1755,"word":"三杯和万事","pinyin":"sān bēi hé wàn shì","abbr":"sbhws","explanation":"和：缓和。指饮酒可以解脱愁闷消除烦恼。","source":{"text":"可不道‘三杯和万事，一醉解千愁。’","book":"元·武汉臣《生金阁》第三折"},"example":{"text":"申屠娘子又笑道：‘妈妈，常言～，再奉一瓯。’","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"similar":["一醉解千愁"],"usage":"作宾语、定语；用于生活"},{"id":1756,"word":"三杯和万事，一醉解千愁","pinyin":"sān bēi hé wàn shì，yī zuì jiě qiān chóu","abbr":"sbhwsyzjqc","explanation":"指饮酒可以消除烦恼，解脱愁闷。","source":{"text":"张千，可不道：‘三杯和万事，一醉解千愁。’孩儿，我且不吃，一发等你吃了这钟，凑个三杯，可不好那 。","book":"元·武汉臣《生金阁》第三折"},"example":{"text":"三杯能和万事，一醉善解千愁，阴阳和颀喜相求，孤寡须知绝后。","book":"明·冯梦龙《警世通言》卷十一"}},{"id":1757,"word":"三杯通大道","pinyin":"sān bēi tōng dà dào","abbr":"sbtdd","explanation":"三杯：指饮了三杯酒；大道：宽广的道路。三杯酒下肚，可达理想境界。形容旧时文人因政治上不得意，靠饮酒来安慰自己，自我陶醉。","source":{"text":"三杯通大道，一斗合自然。","book":"唐·李白《月下独酌》"},"example":{"text":"～，一醉解千愁。","book":"《增广贤文》"}},{"id":1758,"word":"三榜定案","pinyin":"sān bǎng dìng àn","abbr":"sbda","explanation":"三次张榜，广求意见，再作最后决定。极言行事慎重。"},{"id":1759,"word":"三槐九棘","pinyin":"sān huái jiǔ jí","abbr":"shjj","explanation":"中国周代朝廷种三槐九棘，公卿大夫分坐其下，后因以“槐棘”指三公或三公之位。","source":{"text":"朝士掌建邦外朝之法。左九棘，孤卿大夫位焉，群士在其后；右九棘，公侯伯子男位焉，群吏在其后；面三槐，三公位焉，州长众庶在其后。","book":"《周礼·秋官·朝士》"},"example":{"text":"黄卷青灯一腐儒，～位中居。世人只说文章贵，何事男儿不读书。","book":"元·郑光祖《倩女离魂》楔子"},"similar":["三公九卿"],"usage":"作宾语、定语；用于书面语"},{"id":1760,"word":"三步两脚","pinyin":"sān bù liǎng jiǎo","abbr":"sblj","explanation":"快速行走的样子。","source":{"text":"她靸着鞋子，三步两脚赶到侧铺的跟前。","book":"周立波《民兵》"},"usage":"作定语、状语；用于口语"},{"id":1761,"word":"三步并做二步","pinyin":"sān bù bìng zuò èr bù","abbr":"sbbzeb","explanation":"形容快步前进的样子。","source":{"text":"那巡捕得了这句话，立刻三步并做二步，急忙跑了出来。","book":"清·李宝嘉《官场现形记》第五十三回"}},{"id":1762,"word":"三毛七孔","pinyin":"sān máo qī kǒng","abbr":"smqk","explanation":"指心思，心机。","source":{"text":"心重十二两，中有七孔，三毛，盛精汁三合，主藏神。","book":"《史记·扁鹊仓公列传》唐张守节正义"},"example":{"text":"及至第二日见着十三妹，费尽～，万语千言，更不是容易，一桩桩，一件件，都把他说答应了。","book":"清·文康《儿女英雄传》第二十三回"},"usage":"作宾语、定语；用于书面语"},{"id":1763,"word":"三求四告","pinyin":"sān qiú sì gào","abbr":"sqsg","explanation":"指再三求告。","source":{"text":"嫌我不好，谁叫你们瞎了眼，三求四告的，跑了我们家做甚么去了？","book":"《红楼梦》第八十回"},"usage":"作定语、状语；用于处事"},{"id":1764,"word":"三江七泽","pinyin":"sān jiāng qī zé","abbr":"sjqz","explanation":"泛指江河湖泽。","source":{"text":"洞庭潇湘意渺绵，三江七泽情洄沿。","book":"唐·李白《当涂赵炎少府粉图山水歌》"},"example":{"text":"未驾青鸾返帝乡，～路茫茫。","book":"宋·陆游《书怀绝句》"},"similar":["三江五湖"],"usage":"作主语、宾语；用于书面语"},{"id":1765,"word":"三江五湖","pinyin":"sān jiāng wǔ hú","abbr":"sjwh","explanation":"①指东南方的三条江与太湖流域一带的湖泊。②江河湖泊的泛称。","source":{"text":"取玉甚难，越三江五湖，至昆仑之山，千人往，百人反；百人往，十人反。","book":"《尸子》卷下"},"example":{"text":"如响一面铜鼓，撼千峰万岭，震～。","book":"《诗刊》1997年第9期"},"similar":["三江七泽"],"usage":"作主语、宾语；用于书面语"},{"id":1766,"word":"三汤两割","pinyin":"sān tāng liǎng gē","abbr":"stlg","explanation":"泛指烹饪之事。也指各种肴馔。","source":{"text":"烧卖匾食有何难，三汤两割我也会。","book":"《清平山堂话本·快嘴李翠莲记》"},"similar":["三汤五割"],"usage":"作宾语、定语；用于生活"},{"id":1767,"word":"三汤五割","pinyin":"sān tāng wǔ gē","abbr":"stwg","explanation":"泛指烹饪之事。也指各种肴馔。同“三汤两割”。","source":{"text":"众人祭毕，陈敬济下来还礼，请去卷棚内三汤五割管待出门。","book":"《金瓶梅词话》第八十回"},"similar":["三汤两割"],"usage":"作宾语、定语；用于书面语"},{"id":1768,"word":"三沐三熏","pinyin":"sān mù sān xūn","abbr":"smsx","explanation":"再三沐浴熏香。表示郑重或虔敬。亦作“三沐三熏”。","source":{"text":"一重一掩藏山坞，三沐三熏屏世尘。","book":"宋·程俱《偶作》诗之二"},"similar":["三熏三沐","三衅三浴","三浴三熏"],"opposite":["敷衍了事"],"usage":"作宾语、定语；用于处事"},{"id":1769,"word":"三沐三薰","pinyin":"sān mù sān xūn","abbr":"smsx","explanation":"再三沐浴熏香。表示郑重或虔敬。亦作“三沐三熏”。","source":{"text":"重归畎亩，更须三沐三薰。","book":"宋·李清照《投翰林学士綦崈礼启》"},"example":{"text":"～知有待，一鸣一息定谁先？","book":"金·元好问《怀叔能》诗"},"similar":["三沐三熏"],"usage":"作宾语、定语；用于处事"},{"id":1770,"word":"三波六折","pinyin":"sān bō liù zhé","abbr":"sblz","explanation":"指各种波折。","example":{"text":"谁一辈子没有个～。","book":"崔巍《爱与恨》"}},{"id":1771,"word":"三浴三熏","pinyin":"sān yù sān xūn","abbr":"sysx","explanation":"浴：沐浴。再三薰香、沐浴。表示以礼待人，对人尊重。也表示郑重其事。","source":{"text":"方将坐足下，三浴而三熏之，听仆之所为，少安无躁。","book":"唐·韩愈《答吕瞖山人书》"},"similar":["三衅三浴","三熏三沐","三沐三熏"],"opposite":["敷衍了事"],"usage":"作谓语、定语；指郑重其事"},{"id":1772,"word":"三浴三薰","pinyin":"sān yù sān xūn","abbr":"sysx","explanation":"多次沐浴并用香料涂身。这是我国古代对人极为尊重的一种礼遇。同“三衅三浴”。","source":{"text":"方将坐足下，三浴而三薰之，听仆之所为，少安无躁。","book":"唐·韩愈《答吕毉山人书》"}},{"id":1773,"word":"三浴三衅","pinyin":"sān yù sān xìn","abbr":"sysx","explanation":"衅：以香涂身。多次沐浴并用香料涂身。这是我国古代对人极为尊重的一种礼遇。","source":{"text":"比至，三衅三浴之，桓公亲逆之于郊，而与之坐而问焉。","book":"《国语·齐语》"}},{"id":1774,"word":"三清四白","pinyin":"sān qīng sì bái","abbr":"sqsb","explanation":"指非常清白。"},{"id":1775,"word":"三灾八难","pinyin":"sān zāi bā nàn","abbr":"szbn","explanation":"比喻小孩生来多病。也形容经常遭遇不幸。","source":{"text":"但有些八难三灾，一心斋戒。","book":"元·无名氏《小张屠》第三折"},"example":{"text":"况且他也～的，既说了给他作生日，这会子又给人去装裹，岂不忌讳。","book":"清·曹雪芹《红楼梦》第三十二回"},"similar":["多灾多难","三灾六难"],"usage":"作宾语、定语；指多灾多难"},{"id":1776,"word":"三灾六难","pinyin":"sān zāi liù nán","abbr":"szln","explanation":"比喻小孩生来多病。也形容经常遭遇不幸。同“三灾八难”。","source":{"text":"谁家也有三灾六难哩！互相帮助嘛！","book":"马烽、西戎《吕梁英雄传》第二四回"},"example":{"text":"路遥《平凡的世界》第一卷第23章：“一辈子～总是免不了的。”"},"similar":["三灾八难","八难三灾"],"usage":"作宾语、定语；指多灾多难"},{"id":1777,"word":"三熏三沐","pinyin":"sān xūn sān mù","abbr":"sxsm","explanation":"①多次沐浴并用香料涂身。这是我国古代对人极为尊重的一种礼遇。同“三衅三浴”。②表示虔敬。③比喻栽培，提携。","source":{"text":"比至，三衅三沐之，桓公亲逆之于郊，而与之坐而问焉。","book":"《国语·齐语》"},"example":{"text":"一琴一龟，预想铃斋之静；～，尚陪药市之游。","book":"宋·陆游《与李远使启》"},"similar":["三沐三熏","三浴三熏","三衅三浴"],"opposite":["敷衍了事"],"usage":"作谓语、定语；指郑重其事"},{"id":1778,"word":"三牲五鼎","pinyin":"sān shēng wǔ dǐng","abbr":"sswd","explanation":"原形容祭品丰盛。现形容食物丰富美好。","source":{"text":"三牲五鼎供朝夕，须胜似啜菽并饮水。","book":"元·高明《琵琶记·蔡公逼伯喈赴试》"},"example":{"text":"纸灰起归何处？摆列着～，止不住短叹长吁。","book":"明·冯惟敏《端正好·涞邑初度自述》套曲"},"usage":"作谓语、定语；形容食物美好"},{"id":1779,"word":"三环五扣","pinyin":"sān huán wǔ kòu","abbr":"shwk","explanation":"形容捆绑结实。","source":{"text":"四爷赶上一步，就势按倒，解他腰带，三环五扣的捆了一回。","book":"《三侠五义》第五一回"},"usage":"作定语、状语；用于书面语"},{"id":1780,"word":"三班六房","pinyin":"sān bān liù fáng","abbr":"sblf","explanation":"三班：指皂、壮、快班，均为差役；六房：指吏、户、礼、兵、刑、工房，均为书办胥吏。明、清时州县衙门中吏役的总称。","source":{"text":"想这新年大节，老爷衙门里，三班六房，那一位不送帖子来？","book":"清·吴敬梓《儒林外史》第二回"},"example":{"text":"你能直接同两县衙门里～的朋友，或各街坐卡子的老总们，打堆顽耍。","book":"李劼人《死水微澜》第五部"},"usage":"作主语、宾语、定语；借指衙门的办事机构"},{"id":1781,"word":"三瓜两枣","pinyin":"sān guā liǎng zǎo","abbr":"sglz","explanation":"北方口语，比喻微不足道的一点东西，或指有限的一点钱。"},{"id":1782,"word":"三瓦两巷","pinyin":"sān wǎ liǎng xiàng","abbr":"swlx","explanation":"旧指富家子弟寻欢作乐的地方。同“三瓦两舍”。","source":{"text":"平昔在三瓦两巷行走耍子，捣子都认的。","book":"《金瓶梅词话》第十九回"},"similar":["三瓦两舍","三瓦四舍"],"usage":"作宾语、定语；指娱乐场所"},{"id":1783,"word":"三瓦两舍","pinyin":"sān wǎ liǎng shě","abbr":"swls","explanation":"瓦、舍：宋、元时指妓院及各种娱乐场所。旧指富家子弟寻欢作乐的地方。","source":{"text":"因帮了一个生铁王员外儿子使钱，每日三瓦两舍，风花雪月，被他父亲开封府告了一纸文状。","book":"明·施耐庵《水浒传》第二回"},"example":{"text":"那戴春生得风流花荡，～，大小赌场无不扬名。","book":"清·俞万春《荡寇志》第95回"},"similar":["三瓦两巷","三瓦四舍"],"usage":"作宾语、定语；指娱乐场所"},{"id":1784,"word":"三瓦四舍","pinyin":"sān wǎ sì shě","abbr":"swss","explanation":"宋代对妓院、茶楼、酒肆及其他娱乐场所的总称。","source":{"text":"衙内你不晓得，他是清白人家女儿，那肯同那三瓦四舍的奉迎。","book":"清·俞万春《荡寇志》第73回"},"similar":["三瓦两舍","三瓦两巷"],"usage":"作宾语、定语；指娱乐场所"},{"id":1785,"word":"三生有幸","pinyin":"sān shēng yǒu xìng","abbr":"ssyx","explanation":"三生：佛家指前生、今生、来生；幸：幸运。三世都很幸运。比喻非常幸运。","source":{"text":"久闻老师父大名，今日得睹尊颜，三生有幸。","book":"元·吴昌龄《东坡梦》第一折"},"example":{"text":"贱妾蒲柳之姿，幸蒙太太见爱，今日登宝地，真是～。","book":"清·曾朴《孽海花》第十二回"},"similar":["吉星高照","洪福齐天","福星高照"],"opposite":["天不作美","生不逢时"],"usage":"作谓语；用于感谢、交际","story":["唐朝圆泽和尚与好友李源游览长江三峡，见一孕妇汲水，圆泽说他三天后就投胎到她家，相约12年后中秋夜在杭州天竺寺相会。12年后，李源赴约见12岁的牧童唱：“三生石上旧精魂，赏月吟风不要论，惭愧情人远相访，此身虽异性常存。”"]},{"id":1786,"word":"三生石上","pinyin":"sān shēng shí shàng","abbr":"ssss","explanation":"佛教故事，唐代李源与高僧圆泽禅师相约来世相见的故事。借指前世姻缘，来世重新缔结。","source":{"text":"三生石上旧精魂，赏月吟风不要论。惭愧情人往相访，此生虽异性长存。","book":"唐·袁郊《甘泽谣》"},"example":{"text":"如何却说心头事，再结～缘。","book":"元·虞堪《悼坚上人》"}},{"id":1787,"word":"三田分荆","pinyin":"sān tián fēn jīng","abbr":"stfj","explanation":"比喻兄弟之间重新和好。","source":{"text":"三荆欢同株，四鸟悲异林。","book":"晋·南机《豫章行》"}},{"id":1788,"word":"三男两女","pinyin":"sān nán liǎng nǚ","abbr":"snln","explanation":"生有三个儿子，两个女儿。指人儿女两全。","source":{"text":"三男两女，孙息盈前，何为坐自殚竭？","book":"《后汉书·方术传》"}},{"id":1789,"word":"三男四女","pinyin":"sān nán sì nǚ","abbr":"snsn","explanation":"泛指子女众多。","source":{"text":"德武已于岭表娶尔硃氏为妻，及遇赦得还，至襄州，闻裴守节，乃出其后妻，重与裴合。生三男四女。","book":"《旧唐书·李协武妻裴氏传》"},"example":{"text":"孙小馃子被赢家带走，又生了～，日子过得很紧。","book":"刘绍棠《刘家锅伙》"},"usage":"作宾语、定语；指子女"},{"id":1790,"word":"三番两次","pinyin":"sān fān liǎng cì","abbr":"sflc","explanation":"指屡次，多次。","source":{"text":"一言半语恩情，三番两次丁宁。","book":"元·张可久《天净沙·春情》曲"},"example":{"text":"以前赤塔市面好得多呢，～的打仗，闹得不成样子。","book":"瞿秋白《饿乡纪程》十"},"similar":["二次三番","两次三番","三番五次"],"usage":"作状语；形容反复多次"},{"id":1791,"word":"三番五次","pinyin":"sān fān wǔ cì","abbr":"sfwc","explanation":"番：遍数。一再，多次。","source":{"text":"你将书呈三番两次调发小生到此，萧条旅馆，个月期程，不蒙放参。","book":"元·郑德辉《王粲登楼》第一折"},"example":{"text":"～，缠的老和尚急了，说道：‘你是何处光棍，敢来闹我们！快出去！我要关山门。’","book":"清·吴敬梓《儒林外史》第三十八回"},"similar":["屡次三番","再三再四","接二连三"],"opposite":["绝无仅有","百年不遇"],"usage":"作状语；形容次数很多"},{"id":1792,"word":"三番四复","pinyin":"sān fān sì fù","abbr":"sfsf","explanation":"三、四：指次数之多；番、复：反复。变化无常或反复多次。","source":{"text":"或事到眼前，可以顺应，却乃畏首畏尾，三番四复，犹豫不决。","book":"清·敖英《彩雪亭杂言·邝子元》"},"example":{"text":"因此革命的文学者，就不但应该留心迎面的敌人，还必须防备自己一面的～的暗探了。","book":"鲁迅《二心集·上海文艺之一瞥》"}},{"id":1793,"word":"三番四覆","pinyin":"sān fān sì fù","abbr":"sfsf","explanation":"三、四：指次数之多；番、覆：反复，翻悔。形容变化无常，反复多次。","source":{"text":"先帝焦于求治，刻于理财，渴于用人，骤于行法，以致十七年之天下，三番四覆，夕改朝更。","book":"明·张岱《石匮书后集·烈帝本纪》"},"example":{"text":"鲁迅《书信集·致阮善先》：“其实杨在上海，最早不能用真姓名发表文章的了，因为大抵知道他为人～，不要看他的文章。”"},"similar":["三反四覆"],"usage":"作定语、状语；用于书面语"},{"id":1794,"word":"三病四痛","pinyin":"sān bìng sì tòng","abbr":"sbst","explanation":"指病痛很多。","source":{"text":"到老没个儿女，设或三病四痛，没个贴体亲人，那时要茶无茶，要饭没饭，便是活受地狱，何须定要变得牛马！","book":"明·伏雌教主《醋葫芦》第二回"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第13卷：“又怕他～，日夜焦劳。”"},"similar":["七病八痛"],"usage":"作宾语、定语；指疾病"},{"id":1795,"word":"三百六十行","pinyin":"sān bǎi liù shí háng","abbr":"sblsh","explanation":"旧时对各行各业的通称。","source":{"text":"三百六十行中人，尽有狼心狗行，狠似強盜之人。","book":"明·无名氏《白兔记·投军》：“左右的，与我扯起招军旗，叫街坊上民庶，三百六十行做买卖的，愿投军者，旗下报名。”明·凌濛初《初刻拍案惊奇》卷八"},"example":{"text":"其实名利双收，～生意，再没有强如做官的了。","book":"清·彭养鸥《黑籍冤魂》第六回"},"similar":["各行各业"],"usage":"作主语、宾语；对各行各业的通称"},{"id":1796,"word":"三百瓮齏","pinyin":"sān bǎi wèng jī","abbr":"sbwj","explanation":"指长期以咸菜度日，生活清贫。齏，咸菜。三百瓮，极言其多，一时吃不完。","source":{"text":"旧传一贫士死，见阴吏，为言‘当再生，汝有三百瓮齏禄未尽。’陆放翁《病愈》绝句云：‘镜中无复旧朱颜，一笑衰翁乃尔顽。三百瓮齏消未尽，不知更著几年还？’戏用此事。","book":"宋·赵与虤《娱书堂诗话》卷上"}},{"id":1797,"word":"三百瓮齑","pinyin":"sān bǎi wèng jī","abbr":"sbwj","explanation":"瓮：陶制的盛器；齑：咸菜。指长期以咸菜度日，生活清贫。","source":{"text":"旧传一贫士死，见阴更，为言‘当年生，汝有三百瓮齑禄未尽。’","book":"宋·赵与颜《娱书堂诗话》上卷"},"example":{"text":"镜中无复旧朱颜，一笑衷翁乃尔顽。～消未尽，不知更著几年还？","book":"陆放翁《病愈》"},"usage":"作宾语、定语；用于生活"},{"id":1798,"word":"三皇五帝","pinyin":"sān huáng wǔ dì","abbr":"shwd","explanation":"三皇：伏羲、神农、黄帝；五帝：少昊、颛顼、帝喾、尧、舜。原为传说中我国远古的部落酋长。后借指远古时代。","source":{"text":"掌三皇五帝之书。","book":"《周礼·春官·外史》"},"example":{"text":"自从盘古开天地，～到于今，历史上曾经有过我们这样的长征吗？","book":"毛泽东《论反对日本帝国主义的策略》"},"similar":["不祧之祖"],"usage":"作主语、定语；指遥远的古代"},{"id":1799,"word":"三盈三虚","pinyin":"sān yíng sān xū","abbr":"sysx","explanation":"盈：满。虚：空。指孔子的满门弟子，被少正卯讲学所吸引，多次离开孔子之门。形容讲学效果好，影响大。","source":{"text":"少正卯在鲁，与孔子并，孔子之门三盈三虚，唯颜渊不去。","book":"汉·王充《论衡·讲瑞》"},"example":{"text":"其毋乃以～之故，变公敌而为私仇。","book":"清·梁启超《中国古代思潮》第三章"},"usage":"作谓语、定语；用于书面语"},{"id":1800,"word":"三省吾身","pinyin":"sān xǐng wú shēn","abbr":"sxws","explanation":"省：检查、反省；身：自身。原指每日从三个方面检查自己，后指多次自觉地检查自己。","source":{"text":"曾子曰：‘吾日三省吾身，为人谋而不忠乎？’","book":"《论语·学而》"},"example":{"text":"～，谓予无愆。","book":"宋·洪迈《容斋续笔·十五·逐贫赋》"},"similar":["吾日三省"],"usage":"作谓语、定语；指自我反省","story":["春秋时期，孔子的学生曾参勤奋好学，深得孔子的喜爱，同学问他为什么进步那么快。曾参说：“我每天都要多次问自己：替别人办事是否尽力？与朋友交往有没有不诚实的地方？先生教的学生是否学好？如果发现做得不妥就立即改正。”"]},{"id":1801,"word":"三真六草","pinyin":"sān zhēn liù cǎo","abbr":"szlc","explanation":"真：正楷；草：草体。泛指各种书体。","source":{"text":"彬字思文，好文章，习篆隶，与志齐名。时人为之语曰：‘三真六草，为天下宝。’","book":"《南史·王彬传》"},"example":{"text":"～谁子，君莫明珠暗投。","book":"钱钟书《槐聚诗存》"}},{"id":1802,"word":"三眼一板","pinyin":"sān yǎn yī bǎn","abbr":"syyb","explanation":"眼，板：戏曲音乐的节拍。比喻言语、行动有条理或合规矩。有时也比喻做事死板，不懂得灵活掌握。","source":{"text":"以指尖节候拍，即今之三眼一板也。","book":"清·江顺诒《词学集成》卷三"},"example":{"text":"有几位不开口的，他们在那里默听，微笑，吐痰，吸烟，支颐，遐想，指头轻敲桌子，默唱～的雅曲。","book":"叶圣陶《生活》"}},{"id":1803,"word":"三窝两块","pinyin":"sān wō liǎng kuài","abbr":"swlk","explanation":"①指有多房妻妾。②指众多的子女。","source":{"text":"常言道说得好，三窝两块，大妇小妻，一个碗内两张匙，不是汤着就抹着，如何没些气儿。","book":"《金瓶梅词话》第七六回"},"example":{"text":"膝下又没有～，只有一男一女。","book":"《醒世姻缘传》第四四回"},"usage":"作宾语、定语；用于书面语"},{"id":1804,"word":"三等九格","pinyin":"sān děng jiǔ gé","abbr":"sdjg","explanation":"犹三六九等。指等级和类别多，有种种差别。","source":{"text":"《金瓶梅词话》第六二回：“孟玉楼道：‘娘，不是这等说，李大姐倒也罢了，没甚么倒吃了他爹恁三等九格的。’”按，《汉书·古今人表》将人分为上上、上中、上下、中上、中中、中下、下上、下中、下下九等。“三等九格”之说本此。"},"similar":["三等九般","三六九等"],"usage":"作宾语、定语；指许多等级和类别"},{"id":1805,"word":"三等九般","pinyin":"sān děng jiǔ bān","abbr":"sdjb","explanation":"指等级和类别多，有种种差别。同“三等九格”。","source":{"text":"金莲道：‘若是这等的也罢了，我说又是没廉耻的货，三等儿九般使了接去。’","book":"《金瓶梅词话》第三五回"},"similar":["三等九格","三六九等"],"usage":"作宾语、定语；指许多等级和类别"},{"id":1806,"word":"三纲五常","pinyin":"sān gāng wǔ cháng","abbr":"sgwc","explanation":"三纲：指君为臣纲，父为子纲，夫为妻纲；五常：指仁、义、礼、智、信。封建礼教提倡的人与人之间的道德规范。","source":{"text":"五常之道，仁、义、智、信也。","book":"《白虎通·三纲六纪》：“三纲者，何谓也？谓君臣、父子、夫妇也。”汉·王充《论衡·问孔》"},"example":{"text":"先生九经皆通，无书不读，岂不晓～之理？","book":"元·贾仲名《萧淑兰》第二折"},"similar":["清规戒律","三从四德"],"opposite":["大逆不道","离经叛道"],"usage":"作主语、宾语；指封建的道德规范","story":["春秋时期，孔子带领弟子周游列国碰壁后，在冉求的帮助下回到了鲁国，他与季康子是不相为谋。于是专心著述，编辑整理《诗》《书》《礼》《乐》《春秋》，同时又开坛讲学，与弟子们坐而论道，正式总结出三纲五常等社会规范"]},{"id":1807,"word":"三纸无驴","pinyin":"sān zhǐ wú lǘ","abbr":"szwl","explanation":"形容写文章废话连篇，不得要领。","source":{"text":"邺下谚曰：‘博士买驴，书券三纸，未有驴字。’","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["废话连篇"],"usage":"作宾语、定语；指废话连篇","story":["从前有一个自以为是的文人被人戏称为博士，他上街买了一头驴子，按当时的习惯，买家要给卖家写一份合同。博士铺开白纸，下笔千言，足足写了三大张跟驴无关的废话。卖驴人等得不耐烦就催他快点，他忙说不急还没写到“驴”字"]},{"id":1808,"word":"三绝韦编","pinyin":"sān jué wéi biān","abbr":"sjwb","explanation":"韦：熟牛皮。编连竹简的皮绳断了三次。比喻读书勤奋刻苦。","source":{"text":"送朝昏雪案萤灯，三绝韦编。","book":"元·鲜于必仁《折桂令·书》曲"},"similar":["韦编三绝"],"usage":"作定语、宾语；指人读书勤奋"},{"id":1809,"word":"三缄其口","pinyin":"sān jiān qí kǒu","abbr":"sjqk","explanation":"缄：封。在他嘴上贴了三张封条。形容说话谨慎。现在也用来形容不肯或不敢开口。","source":{"text":"孔子之周，观于太庙，右阶之前，有金人焉。三缄其口，而铭其背曰：‘古之慎言人也，戒之哉，戒之哉！无多言，多言多败。’","book":"汉·刘向《说苑·敬慎》"},"example":{"text":"危行言逊，祸免生肘；金人示诫，～。","book":"清·陈忱《水浒后传》第十三回"},"similar":["缄口不言","守口如瓶","默不做声"],"opposite":["口若悬河","夸夸其谈"],"usage":"作谓语、宾语；用于对事保密程度","story":["春秋时期，孔子到周朝的首都去参观周王的祖庙，祖庙在当时是很神圣的地方，一般参观者必须保持沉默。孔子看到庙堂大殿右边的台阶前有一个铜人，铜人的嘴上封了三道封条，在背上还刻着字：“这是古时说话最小心谨慎的人。”"]},{"id":1810,"word":"三翻四复","pinyin":"sān fān sì fù","abbr":"sfsf","explanation":"变化无常或反复多次。","source":{"text":"因此革命的文学者，就不但应该留心迎面的敌人，还必须防备自己一面的三翻四复的暗探了。","book":"鲁迅《二心集·上海文艺之一瞥》"}},{"id":1811,"word":"三翻四覆","pinyin":"sān fān sì fù","abbr":"sfsf","explanation":"翻：转。反复无常。","source":{"text":"先帝焦于治，以致十七年之天下，三翻四覆，夕改朝更。","book":"明·张岱《石匮书后集·烈帝本纪》"},"example":{"text":"因此革命的文学者，就不但应该留心迎面的当然，还必须防备自己一面的～的暗探了。","book":"鲁迅《二心集·上海文艺之一瞥》"},"similar":["朝三暮四","变化多端"],"opposite":["一如既往","始终如一"],"usage":"作谓语、状语；用于做事无常"},{"id":1812,"word":"三老五更","pinyin":"sān lǎo wǔ gēng","abbr":"slwg","explanation":"相传古代统治者设三老五更，以尊养老人。","source":{"text":"食三老五更于大学。","book":"《礼记·文王世子》：“遂设三老五更，群老之席位焉。”《乐记》"},"usage":"作宾语、定语；用于书面语"},{"id":1813,"word":"三老四少","pinyin":"sān lǎo sì shǎo","abbr":"slss","explanation":"①老少众人。②方言。称参加青帮的人。犹言老少爷们或兄弟爷们。"},{"id":1814,"word":"三耳秀才","pinyin":"sān ěr xiù cái","abbr":"sexc","explanation":"指很聪明的人。也比喻人狡猾。","source":{"text":"兖州张审通为泰山府君所召，额上安一耳，既醒，额痒，果生一耳，尤聪俊，时号‘三耳秀才’。","book":"晋·陶潜《续搜神记》"},"example":{"text":"天上有九头鸟，人间有～。","book":"宋·张君房《脞说》"}},{"id":1815,"word":"三脚两步","pinyin":"sān jiǎo liǎng bù","abbr":"sjlb","explanation":"①形容走得快。②指走不多远。","source":{"text":"太太三脚两步，走进房间。表老爷周大权，押着行李也就来了。还有跟来的丫头，忙着替太太找梳头家伙，又找盆打洗脸水。","book":"清·李宝嘉《官场现形记》第十回"},"example":{"text":"路又不远，～，就是一个来回。","book":"王汶石《大木匠》"},"usage":"作定语、状语；用于口语"},{"id":1816,"word":"三脚猫","pinyin":"sān jiǎo māo","abbr":"sjm","explanation":"比喻虚有其名而无真本事的人。","source":{"text":"一知半解叫做‘三脚猫’，年轻好胜的人，最讨厌这句话。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"她也就那么点～的本事。"},"similar":["半桶水"],"usage":"作宾语、定语；用于比喻句"},{"id":1817,"word":"三臡八菹","pinyin":"sān ní bā zū","abbr":"snbz","explanation":"泛指精美的肴馔。亦借喻精美的诗文。"},{"id":1818,"word":"三至之谗","pinyin":"sān zhì zhī chán","abbr":"szzc","explanation":"谗：谗言，坏话。形容经反复传播，影响恶劣的诽谤性言语。","source":{"text":"身非曾参而有三至之谗，恐见疑于当时矣。","book":"《后汉书·班超传》"}},{"id":1819,"word":"三致志","pinyin":"sān zhì zhì","abbr":"szz","explanation":"致：向对方表示（情意、礼节等）。志：意向。再三表达某种意愿。","source":{"text":"其存君兴国而欲反复之，一篇之中三致志焉。","book":"《史记·屈原贾生列传》"}},{"id":1820,"word":"三舖八菹","pinyin":"sān ní bā zū","abbr":"snbz","explanation":"泛指精美的肴馔。亦借喻精美的诗文。"},{"id":1821,"word":"三般两样","pinyin":"sān bān liǎng yàng","abbr":"sbly","explanation":"指多个，也指耍手段，弄花样。","source":{"text":"天下只是一个道理，更无三般两样。","book":"宋·朱熹《朱子语类》第67卷"},"example":{"text":"唱戏的小粉头们都～，掂人的分量。","book":"清·曹雪芹《红楼梦》第60回"},"similar":["两面三刀"],"usage":"作谓语、宾语；指耍手段"},{"id":1822,"word":"三节两寿","pinyin":"sān jié liǎng shòu","abbr":"sjls","explanation":"旧俗对于塾师，逢端午节、中秋节、年节及孔子诞辰，塾师生日，均各加送束脩一月，称为三节两寿。亦用以泛指节日和生辰。","source":{"text":"三节两寿，孝敬上司的钱，虽不敢任情减少，然而总是照着前任移交过来的簿子送的。","book":"清·李宝嘉《官场现形记》第四十二回"}},{"id":1823,"word":"三茶六礼","pinyin":"sān chá liù lǐ","abbr":"scll","explanation":"犹言明媒正娶。旧指正式婚姻。","source":{"text":"我国旧时习俗，娶妻多用茶为聘礼，所以女子受聘称为受茶。六礼，即婚姻据以成立的纳采、问名、纳吉、纳征、请期、亲迎六种仪式。参阅明陈耀文《天中记》卷四四、《仪礼·士昏礼》。"},"example":{"text":"鲁迅《彷徨·离婚》：“他就是着了那滥婊子的迷，要赶我出去。我是～定来的，花轿抬来的呵！”"},"similar":["明媒正娶"],"usage":"作宾语、定语；用于婚姻等"},{"id":1824,"word":"三茶六饭","pinyin":"sān chá liù fàn","abbr":"sclf","explanation":"比喻招待客人非常周到。","source":{"text":"你却要好生服侍我师父，逐日家三茶六饭，不可欠缺。","book":"明·吴承恩《西游记》第二十六回"},"example":{"text":"你妹妹，我也亲身接了来家，生怕老太太，太太生气，也不敢回，现在～，金奴银婢的住在园里。（清·曹雪芹《红楼梦》第六十八回）"},"usage":"作主语、宾语；指茶饭周全"},{"id":1825,"word":"三荆同株","pinyin":"sān jīng tóng zhū","abbr":"sjtz","explanation":"荆树虽三杈而同一株干。比喻同胞兄弟。也指兄弟分而复合。","source":{"text":"三荆欢同株，四鸟悲异林。","book":"晋·南机《豫章行》"},"example":{"text":"古有兄弟，忽欲分异，出门见～，接叶连阴。叹曰：“木犹欣然聚，况我而殊哉”，遂还为雍和。","book":"唐·欧阳询《艺文类聚》卷八十九"}},{"id":1826,"word":"三荤五厌","pinyin":"sān hūn wǔ yàn","abbr":"shwy","explanation":"泛指荤腥食物。"},{"id":1827,"word":"三薰三沐","pinyin":"sān xūn sān mù","abbr":"sxsm","explanation":"①多次沐浴并用香料涂身。这是我国古代对人极为尊重的一种礼遇。同“三衅三浴”。②表示虔敬。③比喻栽培，提携。","source":{"text":"吾当草此论之始，吾不得不三薰三沐，仰天百拜，谢其生我于此至美之国而为此伟大国民之一分子也。","book":"清·龚自珍《己亥杂诗》之一百：“坐我三薰三沐之，悬崖撒手别卿时，不留后约将人误，笑指河阳镜里丝。”梁启超《中国学术思想变迁之大势》第一章"},"example":{"text":"收回成命，使羲得修身俟死，此即老公祖之～也。","book":"清·黄宗羲《与李郡侯书》"},"similar":["三熏三沐"],"usage":"作谓语、定语；指郑重其事"},{"id":1828,"word":"三蛇七鼠","pinyin":"sān shé qī shǔ","abbr":"ssqs","explanation":"比喻为害的东西多。","source":{"text":"一亩之地，三蛇七鼠。","book":"清·翟灏《通俗编·禽鱼》"},"usage":"作主语、宾语、定语；指害人的东西"},{"id":1829,"word":"三蛇九鼠","pinyin":"sān shé jiǔ shǔ","abbr":"ssjs","explanation":"比喻为害庄稼的东西很多。","source":{"text":"尽大地撮来如粟米粒大，抛向面前。漆桶不会，打鼓普请看。”未审此意如何？’师曰：‘一亩之地，三蛇九鼠。’","book":"宋·释普济《五灯会元》卷十九：“问：‘雪峰道"}},{"id":1830,"word":"三衅三沐","pinyin":"sān xìn sān mù","abbr":"sxsm","explanation":"衅：以香涂身。多次沐浴并用香料涂身。这是我国古代对人极为尊重的一种礼遇。","source":{"text":"比至，三衅三沐之，桓公亲逆之于郊，而与之坐而问焉。","book":"《国语·齐语》"}},{"id":1831,"word":"三衅三浴","pinyin":"sān xìn sān yù","abbr":"sxsy","explanation":"衅：以香涂身。多次沐浴并用香料涂身。这是我国古代对人极为尊重的一种礼遇。","source":{"text":"比至，三衅三浴之。桓公亲迎之于郊。","book":"春秋·鲁·左丘明《国语·齐语》"},"example":{"text":"自智而敖不能则不达，故～之，而字之曰：‘不伐。’","book":"宋·黄庭坚《元勋字序》"},"similar":["三衅三沐","郑重其事"],"opposite":["敷衍了事"],"usage":"作谓语、定语；指郑重其事","story":["春秋时期，齐国发生内乱，公子小白与公子纠纷纷到国外避难。后来公子小白回国继位成为齐桓公，鲍叔牙建议齐桓公不计前嫌，任命管仲为相国，齐桓公想成就霸业，就用三衅三浴的礼节亲自到郊外去迎接管仲。管仲辅佐他成为春秋五霸之首"]},{"id":1832,"word":"三街两市","pinyin":"sān jiē liǎng shì","abbr":"sjls","explanation":"泛称各街市。","source":{"text":"终日只是三街两市，和着酒肉朋友串哄。","book":"明·凌濛初《二刻拍案惊奇》卷二十四"},"similar":["三街六市","三街六巷"],"usage":"作宾语、定语；用于书面语"},{"id":1833,"word":"三街六巷","pinyin":"sān jiē liù xiàng","abbr":"sjlx","explanation":"泛指大街小巷。","source":{"text":"这三街六巷，凭他是谁，若得罪了我醉金刚倪二的街坊，管叫他人离家散。","book":"清·曹雪芹《红楼梦》第24回"},"example":{"text":"他对这儿的～十分熟悉。"},"similar":["街头巷尾","大街小巷"],"usage":"作主语、宾语、定语；泛指大街小巷"},{"id":1834,"word":"三街六市","pinyin":"sān jiē liù shì","abbr":"sjls","explanation":"泛称各街市。","source":{"text":"虽有三街六市，出门便被纱兜儿厮蒙着脸，真是讨厌。","book":"《荡寇志》第七十五回"},"similar":["三街两市","三街六巷"],"usage":"作宾语、定语；用于书面语"},{"id":1835,"word":"三角恋爱","pinyin":"sān jiǎo liàn ài","abbr":"sjla","explanation":"指一个人和两个异性同时恋爱的不正常的关系。","source":{"text":"‘我不愿意听你们的三角恋爱故事！’少平叫道。","book":"路遥《平凡的世界》第四卷第52章"},"example":{"text":"～是不道德的。"},"usage":"作主语、宾语、定语；用于男女关系"},{"id":1836,"word":"三角猫","pinyin":"sān jiǎo māo","abbr":"sjm","explanation":"比喻憋脚的、不中用的人或事物。","source":{"text":"物不中谓之三角猫。","book":"宋·无名氏《百宝总珍集·解卖》"},"example":{"text":"凭这点～功夫就想打抱不平吗？","book":"金庸《射雕英雄传》第七回"}},{"id":1837,"word":"三言两句","pinyin":"sān yán liǎng jù","abbr":"sylj","explanation":"几句话。形容话很少。同“三言两语”。","source":{"text":"哥哥你放心者，老身到那里，不消三言两句，管教他随顺哥哥便了。","book":"元·关汉卿《救风尘》第二折：“我到那里，三言两句，肯写休书，万事俱休。”元·武汉臣《生金阁》第二折"},"example":{"text":"半月前有媒婆来曾说亲，不拟～便说成。","book":"元·无名氏《小孙屠》第八出"},"similar":["三言两语","三言二语","三言五语"],"opposite":["长篇大论"],"usage":"作主语、宾语、状语；用于说话简明"},{"id":1838,"word":"三言两语","pinyin":"sān yán liǎng yǔ","abbr":"syly","explanation":"几句话。形容话很少。","source":{"text":"我到那里，三言两句，肯写休书，万事俱休。","book":"元·关汉卿《救风尘》第二折"},"example":{"text":"若不是我这老手～拿他降伏住，还不晓得闹点什么事情出来哩。","book":"清·李宝嘉《官场现形记》第五十三回"},"similar":["只言片语","简明扼要","三言两句"],"opposite":["长篇大论","喋喋不休"],"usage":"作主语、宾语、状语；形容说话简明扼要"},{"id":1839,"word":"三言二语","pinyin":"sān yán èr yǔ","abbr":"syey","explanation":"三两句话。形容言语十分简短。","source":{"text":"或者三言二语，或者长篇大套。","book":"朱自清《论朗诵诗》"},"similar":["三言两语","三言两句","三言五句"],"opposite":["长篇大论"],"usage":"作主语、宾语、状语；形容说话简明扼要"},{"id":1840,"word":"三言五语","pinyin":"sān yán wǔ yǔ","abbr":"sywy","explanation":"三两句话。形容言语十分简短。","source":{"text":"那知一想，才觉长篇累牍，不合体裁，三言五语，包括不住，一时竟大为起难来。","book":"清·文康《儿女英雄传》第37回"},"similar":["三言二语","三言两语","三言两句"],"opposite":["长篇大论"],"usage":"作主语、宾语、状语；形容说话简明扼要"},{"id":1841,"word":"三言讹虎","pinyin":"sān yán é hǔ","abbr":"syeh","explanation":"犹三人成虎。比喻说的人多了，就能使人们把谣言当事实。","source":{"text":"况三言讹虎，众口铄金；因积毁销骨，致他方糊口。","book":"清·秋瑾《致琴文书》"},"example":{"text":"清·秋瑾《致琴文书》：“况～，虎口铄金，因积毁销骨，致他方糊口。”"},"similar":["三人成市虎"],"usage":"作宾语、定语；用于传言等"},{"id":1842,"word":"三语掾","pinyin":"sān yǔ yuàn","abbr":"syy","explanation":"掾：古代官署属员的通称。因三个字而任命的官员。后用以对幕府官员的赞美。","source":{"text":"阮宣子有令闻。太尉王夷甫见而问曰：‘老庄与圣教同异？’对曰：‘将无同？’太尉善其言，辟之为掾。世谓‘三语掾’。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"欲知妙湛与总持，更问江东～。","book":"宋·苏轼《虔州景德寺荣师湛然堂》"}},{"id":1843,"word":"三谏之义","pinyin":"sān jiàn zhī yì","abbr":"sjzy","explanation":"指事君之正道。","source":{"text":"所谓大臣者以道事君，不可则止，此之谓也。","book":"《公羊传·庄公二十四年》：“戎将侵曹，曹羁谏曰：‘戎众以无义，君请勿自敌也。’曹伯曰：‘不可。’三谏不从，遂去之，故君子以为得君臣之义也。”何休注引孔子曰"},"example":{"text":"东汉·王充《论衡·程材》：“案世间能建蹇蹇之节，成～，令将检身自敕，不敢邪曲者，率多儒生。”"},"usage":"作宾语、定语；用于书面语","story":["春秋时期，北方的戎国将要侵略曹国，曹伯想亲自去迎敌。曹羁进谏说：“戎国人最不讲道义，国王您不能亲自去迎战。”曹伯说不行。曹羁进谏三次之后，尽到做臣子的道义之后就离开。后来曹军被戎狄打败"]},{"id":1844,"word":"三豕涉河","pinyin":"sān shǐ shè hé","abbr":"sssh","explanation":"比喻文字传写或刊印讹误。","source":{"text":"过卫，有读史记者曰：‘晋师三豕涉河。’子夏曰：‘非也，是己亥也。夫己与三相近，豕与亥相似。’至于晋而问之，则曰晋师己亥涉河。","book":"战国·卫·吕不韦《吕氏春秋·察传》"},"example":{"text":"请不要犯～的错误。"},"similar":["三豕渡河"],"usage":"作宾语、定语；指文字刊印讹误","story":["春秋时期，孔子的学生子夏到晋国去，路经卫国时，听到一个人正在读史书：“晋国的军队三豕涉河。”子夏就去纠正他：“你读错了，不是三豕是已亥，因为已与三、亥与豕字形相象。”后来那人到晋国核对，晋国军队果然是已亥年过的河"]},{"id":1845,"word":"三豕渡河","pinyin":"sān shǐ dù hé","abbr":"ssdh","explanation":"比喻文字传写或刊印讹误。三豕：应为“己亥”。同“三豕涉河”。","source":{"text":"《吕氏春秋·察传》：“子夏之晋，过卫，有读史记者曰：‘晋师三豕涉河。’子夏曰：‘非也，是己亥也。夫己与三相近，豕与亥相似。’至于晋而问之，则曰晋师己亥涉河也。”《孔子家语·七十二弟子解》作“三豕渡河”。"},"example":{"text":"书有转误，～之类也。","book":"汉·蔡邕《月令问答》"},"similar":["三豕涉河"],"usage":"作宾语、定语；指文字刊印讹误"},{"id":1846,"word":"三豕金根","pinyin":"sān shǐ jīn gēn","abbr":"ssjg","explanation":"“三豕”本作“己亥”，“金根”，史传有金根车，后误作“金银”。指字讹误。","source":{"text":"史传有金根车，韩昶以为误，改根为银。","book":"《吕氏春秋·察传》：“有读史记者曰：‘晋师三豕涉河。’子夏曰：‘非也，是己亥也。夫己与三相近，豕与亥相似。’”《尚书故实》"}},{"id":1847,"word":"三贞九烈","pinyin":"sān zhēn jiǔ liè","abbr":"szjl","explanation":"贞：贞操；烈：节烈。封建社会用来赞誉妇女的贞烈。","source":{"text":"他元来是九烈三贞贤达妇，兀的个老人家尚然道出嫁从夫。","book":"元·无名氏《合同文字》第三折"},"example":{"text":"若辈一经用了手脚，随你～，玉洁冰清，亦不能跳出圈外。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["三贞五烈"],"usage":"作宾语、定语；指封建社会赞誉妇女的贞烈"},{"id":1848,"word":"三贞五烈","pinyin":"sān zhēn wǔ liè","abbr":"szwl","explanation":"封建社会用来赞誉妇女的贞烈。同“三贞九烈”。","source":{"text":"你要他三贞五烈，这不是太……","book":"夏衍《上海屋檐下》第一幕"},"similar":["三贞九烈"],"usage":"作宾语、定语；指封建社会赞誉妇女的贞烈"},{"id":1849,"word":"三足鼎立","pinyin":"sān zú dǐng lì","abbr":"szdl","explanation":"象鼎的三只脚一样，各立一方。比喻三方面对立的局势。","source":{"text":"莫若两利而俱存之，叁分天下，鼎足而居。","book":"《史记·淮阴侯列传》"},"example":{"text":"近者流之衰末，～。","book":"晋·陈寿《三国志·吴志·陆凯传》"},"similar":["鼎足之势","鼎足三分"],"opposite":["不打自败"],"usage":"作谓语、宾语、定语；比喻三方对立","story":["东汉末年，荆州牧刘表病死，刘表的儿子投降曹操。刘备被迫南撤，孙权派鲁肃去联络刘备，诸葛亮认为可以联吴抗曹。孙权多谋善断，分析曹操犯了用兵之忌，于是与蜀军在赤壁大破曹操号称80万大军，从而形成三足鼎立的局面"]},{"id":1850,"word":"三跨两步","pinyin":"sān kuà liǎng bù","abbr":"sklb","explanation":"形容快步前进的样子。","source":{"text":"贾瑞如得了命，三步两步从后门跑到家里。","book":"清·曹雪芹《红楼梦》第十二回"}},{"id":1851,"word":"三跪九叩","pinyin":"sān guì jiǔ kòu","abbr":"sgjk","explanation":"叩：磕头。最敬重的礼节。","source":{"text":"福晋父率阖族谢恩，行三跪九叩礼。","book":"清·昭槤《啸亭杂录·内务府定制》"},"example":{"text":"于是，三支高香，一盅酒，二尺红布挂枝头，俞文芊～，拜了大柳树做干娘。","book":"刘绍棠《小荷才露尖尖角》"},"similar":["顶礼膜拜","打躬作揖"],"usage":"作谓语、状语；指最敬重的礼节"},{"id":1852,"word":"三迁之教","pinyin":"sān qiān zhī jiào","abbr":"sqzj","explanation":"比喻选择居住合适的环境以利于教育子女。","source":{"text":"汉·刘向《列女传》载：孟母带着年幼的孟子，起初住在公墓附近，孟子就模仿哭丧；后迁居集市，又跟着学商人自吹自夸；孟母迁居学堂附近，孟子从此学习礼节，要求上学。"},"example":{"text":"他采取～，把孩子送到重点大学学习。"},"similar":["孟母三迁"],"usage":"作宾语、定语；指教育后代","story":["战国时期，孟子小时候非常聪明，经常模仿送葬人吹喇叭，孟母担心他荒废学业就把家搬到城里，刚好旁边是一个屠宰场，孟子很快就学会了杀猪宰羊，孟母只好搬家到一个学校附近，从此孟子就开始学习孔子的思想而成为一代思想家"]},{"id":1853,"word":"三过其门而不入","pinyin":"sān guò qí mén ér bù rù","abbr":"sgqmebr","explanation":"原是夏禹治水的故事，后比喻热心工作，因公忘私。","source":{"text":"禹，稷当平世，三过其门而不入，孔子贤之。","book":"战国·邹·孟轲《孟子·离娄下》"},"example":{"text":"昔大禹～，你此日在家耽搁。","book":"清·夏敬渠《野叟曝言》第97回"},"similar":["三过家门而不入"],"usage":"作谓语、定语；指大公无私","story":["舜统治时中华大地经常发大水，禹上书给舜要求治水说：“先父用堰障法治水没有收到成效，我要用疏导法让水流入大海。”舜同意让禹负责治水，禹率能工巧匠开凿河道，疏导水流，治水13年多次经过家门而不能回家，终于消灭水患"]},{"id":1854,"word":"三过家门而不入","pinyin":"sān guò jiā mén ér bù rù","abbr":"sgjmebr","explanation":"指夏禹治水的故事，比喻热心工作，因公忘私。","source":{"text":"如众所周知的，夏禹在治水十三年中，三过家门而不入……","book":"陶铸《崇高的理想》"},"similar":["三过其门而不入"],"usage":"作谓语、定语、宾语；指大公无私"},{"id":1855,"word":"三迭阳关","pinyin":"sān dié yáng guān","abbr":"sdyg","explanation":"三迭：反复歌唱某一句；阳关：古关名，在今甘肃敦煌县西南。原指古代送别的曲调。后也比喻离别。","source":{"text":"渭城朝雨浥清尘，客舍青青柳色新。劝君更尽一杯酒，西出阳关无故人。","book":"唐·王维《渭城曲》诗"},"example":{"text":"我做甚～愁不听，也只为一段伤心画怎成。","book":"元·王子一《误入桃源》楔子"},"similar":["三叠阳关"],"usage":"作宾语、定语；比喻离别"},{"id":1856,"word":"三邻四舍","pinyin":"sān lín sì shè","abbr":"slss","explanation":"泛指邻居。","source":{"text":"王三老闻知此事，率了三邻四舍，提壶挚盒，都来庆贺，吃了好几日喜酒。","book":"明·冯梦龙《醒世恒言》第九卷"},"similar":["左邻右舍"],"usage":"作主语、宾语、定语；用于书面语"},{"id":1857,"word":"三钱之府","pinyin":"sān qián zhī fǔ","abbr":"sqzf","explanation":"古代的钱库。","source":{"text":"王乃使者封三钱之府。","book":"《史记·越王勾践世家》"}},{"id":1858,"word":"三锤两棒","pinyin":"sān chuí liǎng bàng","abbr":"sclb","explanation":"形容处事简单明快。","source":{"text":"他本来也没准备耽搁这么长时间，心想行不行三锤两棒就完了，他转几天就回来了。","book":"路遥《平凡的世界》第二卷第29章"},"usage":"作宾语、定语、状语；用于比喻句"},{"id":1859,"word":"三长两短","pinyin":"sān cháng liǎng duǎn","abbr":"scld","explanation":"指意外的灾祸或事故。特指人的死亡。","source":{"text":"我还怕薄情郎折倒我的女儿，须一路寻上去，万一有三长两短，定要讨个明白。","book":"明·范文若《鸳鸯棒·恚剔》"},"example":{"text":"要是万一李嫂子有～，真是可惜！","book":"姚雪垠《李自成》第一卷第十七章"},"similar":["山高水低","一差二错"],"opposite":["安然无恙"],"usage":"作宾语、定语；借指人的死亡"},{"id":1860,"word":"三长四短","pinyin":"sān cháng sì duǎn","abbr":"scsd","explanation":"①特指人的死亡。同“三长两短”。②犹闲话，坏话。","source":{"text":"小心呵，今年的天气还不晓得如何呢？要是秧苗有个三长四短的，都死在你手里。","book":"周立波《山乡世变》下四"},"example":{"text":"要是背地里讲了他什么～，你还不一五一十的告诉了他才怪。","book":"端木蕻良《早春》"},"similar":["三长两短"],"usage":"作宾语、定语；借指人的死亡"},{"id":1861,"word":"三阳交泰","pinyin":"sān yáng jiāo tai","abbr":"syjt","explanation":"常用以称颂岁首或寓意吉祥。同“三阳开泰”。","source":{"text":"三阳交泰，日新惟良。","book":"《宋史·乐志》"},"example":{"text":"～产群生，仙石胞含日月精。","book":"明·吴承恩《西游记》第一回"}},{"id":1862,"word":"三阳开泰","pinyin":"sān yáng kāi tài","abbr":"sykt","explanation":"《周易》称爻连的为阳卦，断的为阴爻，正月为泰卦，三阳生于下；冬去春来，阴消阳长，有吉亨之象。常用以称颂岁首或寓意吉祥。","source":{"text":"三阳交泰，日新惟良。","book":"《易·泰》：“泰，小往大来，吉亨。”《宋史·乐志》"},"example":{"text":"设此三羊，以应开泰之言，唤做“～”，破解你师之否塞也。","book":"明·吴承恩《西游记》第九十一回"},"usage":"作宾语、定语；指称颂岁首的吉祥话"},{"id":1863,"word":"三顾茅庐","pinyin":"sān gù máo lú","abbr":"sgml","explanation":"顾：拜访；茅庐：草屋。原为汉末刘备访聘诸葛亮的故事。比喻真心诚意，一再邀请。","source":{"text":"先帝不以臣卑鄙，猥自枉屈，三顾臣于草庐之中。","book":"三国蜀·诸葛亮《出师表》"},"example":{"text":"我住着半间儿草舍，再谁承望～。","book":"元·马致远《荐福碑》第一折"},"similar":["礼贤下士"],"opposite":["拒人千里","妄自尊大"],"usage":"作谓语、宾语；指真心诚意邀请","story":["东汉末年，天下大乱，诸葛亮在隆中茅草房，自耕自食，但很有学问，人称“卧龙先生”。徐庶给刘备推荐诸葛亮，刘备和关羽、张飞亲自到卧龙冈拜见诸葛亮，前两次都没见到，第三次终于见到诸葛亮，诚心请诸葛亮出山"]},{"id":1864,"word":"三顾草庐","pinyin":"sān gù cǎo lú","abbr":"sgcl","explanation":"刘备为请诸葛亮，三次到草庐中去拜访他。后用此典故表示帝王对臣下的知遇之恩。也比喻诚心诚意地邀请或过访。同“草庐三顾”。","source":{"text":"先帝不以臣卑鄙，猥自枉屈，三顾臣于草庐之中。","book":"三国蜀·诸葛亮《出师表》"},"similar":["三顾茅庐"],"usage":"作谓语、宾语、定语；指真心诚意邀请","story":["东汉末年，天下大乱，诸葛亮在隆中茅草房，自耕自食，但很有学问，人称“卧龙先生”。徐庶给刘备推荐诸葛亮，刘备和关羽、张飞亲自到卧龙冈拜见诸葛亮，前两次都没见到，第三次终于见到诸葛亮，诚心请诸葛亮出山"]},{"id":1865,"word":"三风五气","pinyin":"sān fēng wǔ qì","abbr":"sfwq","explanation":"三风：官僚主义、宗派主义、主观主义作风；五气：官气、暮气、阔气、傲气、娇气。指一些工作人员的作风和习气。","example":{"text":"进入社会主义，一要破除老爷态度，～；一要保留工资差别。","book":"毛泽东《读斯大林〈苏联社会主义经济问题〉谈话记录》"}},{"id":1866,"word":"三风十愆","pinyin":"sān fēng shí qiān","abbr":"sfsq","explanation":"三种恶劣风气，所滋生的十种罪愆。指巫风二：舞、歌；淫风四：货、色、游、畋；乱风四：侮圣言、逆忠直、远耆德、比顽童，合而为十愆。","source":{"text":"惟兹三风十愆，卿士有一于身，家必丧；邦君有一于身，国必亡。","book":"《尚书·伊训》"},"example":{"text":"～古所戒，不必骊山可亡国。","book":"宋·苏轼《骊山》诗"}},{"id":1867,"word":"三饥两饱","pinyin":"sān jī liǎng bǎo","abbr":"sjlb","explanation":"犹言饥一顿，饱一顿。形容生活艰难。","source":{"text":"刘野夫留南京，久未入都，渊材以书督之，野夫答书曰：‘跛子一生别无路，展手教，化三饥两饱。回视云汉，聊以自诳元神。’","book":"宋·惠洪《冷斋夜话·野夫长短句》"},"usage":"作定语、状语；用于生活"},{"id":1868,"word":"三首六臂","pinyin":"sān shǒu liù bì","abbr":"sslb","explanation":"神道的形状。后比喻神通广大，本领出众。同“三头六臂”。","source":{"text":"子牙见对营门一人，三首六臂，青面獠牙。","book":"明·许仲琳《封神演义》第六十三回"},"example":{"text":"猓猓奉土主之神甚谨。其像～，项挂髑髅。","book":"清·刘献廷《广阳杂记》卷一"},"similar":["三头六臂"],"opposite":["一无所长"],"usage":"作谓语、宾语、定语；指神通广大"},{"id":1869,"word":"三马同槽","pinyin":"sān mǎ tóng cáo","abbr":"smtc","explanation":"隐指司马懿父子三人将篡夺魏的政权。也泛指阴谋篡权。","source":{"text":"三国魏正始后，司马懿与其子师昭执军政大权，屏除异己，时有‘三马同槽’之目。三马，隐指懿父子三人。","book":"《晋书·宣帝纪》"},"example":{"text":"孤向日曾梦～，疑是马腾父子为祸；今腾已死，昨宵复梦～，主何吉凶？","book":"明·罗贯中《三国演义》第七十八回"},"usage":"作宾语、定语；泛指阴谋篡权"},{"id":1870,"word":"三魂七魄","pinyin":"sān hún qī pò","abbr":"shqp","explanation":"魂：旧指能离开人体而存在的精神；魄：旧指依附形体而显现的精神。道家语，称人身有“三魂七魄”。","source":{"text":"欲得通神，宜水火水形分，形分则自见其身中之三魂七魄。","book":"《抱朴子·地真》"},"example":{"text":"但凡精血成胎者，有～，被桂芳叫一声，魂魄不居一体，散在各方，自然落马。","book":"明·许仲琳《封神演义》第三十七回"},"usage":"作宾语、定语；指人的魂魄"},{"id":1871,"word":"三魂出窍","pinyin":"sān hún chū qiào","abbr":"shcq","explanation":"形容害怕得不知所措。"},{"id":1872,"word":"三鹿郡公","pinyin":"sān lù jùn gōng","abbr":"sljg","explanation":"三鹿：合起来是“麤”（粗）字。形容人的粗心大意。","source":{"text":"袁利见为性顽犷，方棠谓袁生已封三鹿郡公，盖讥其太粗疏也。","book":"唐·冯贽《云仙杂记·三鹿郡公》引《幽燕记》"}},{"id":1873,"word":"三鼓气竭","pinyin":"sān gǔ qì jié","abbr":"sgqj","explanation":"竭：尽。指力量一再消耗，已经衰减耗尽。","source":{"text":"夫战，勇气也。一鼓作气，再而衰，三而竭。","book":"《左传·庄公十年》"},"example":{"text":"一鼓气盛，二鼓气衰，～。"}},{"id":1874,"word":"上上下下","pinyin":"shàng shàng xià xià","abbr":"ssxx","explanation":"往上往下，上级和下级，泛指单位的整体。","source":{"text":"如今里里外外上上下下背着我嚼说我的不少，就差你来说了，可知没家亲引不出外鬼来。","book":"清·曹雪芹《红楼梦》第72回"},"example":{"text":"你们从下面上来，左邻右舍，～，接触广泛，了解的人多。","book":"邓小平《总结经验，使用人才》"},"similar":["里里外外"],"usage":"作宾语、定语、状语；指上下关系"},{"id":1875,"word":"上下一心","pinyin":"shàng xià yī xīn","abbr":"sxyx","explanation":"上上下下一条心。","source":{"text":"上下一心，三军同力，与之远举极战，则不可。","book":"战国·赵·荀况《荀子·富国》"},"example":{"text":"我们应切勿骄躁，兢兢业业，～，达成每一个具体任务。","book":"邓小平《创建巩固的大别山根据地》"},"similar":["万众一心"],"opposite":["一盘散沙"],"usage":"作谓语、定语；指思想一致"},{"id":1876,"word":"上下为难","pinyin":"shàng xià wéi nán","abbr":"sxwn","explanation":"上面下面都难以应付。","example":{"text":"这事让我～。"},"similar":["左右为难","进退两难"],"usage":"作谓语、定语；指不好取舍"},{"id":1877,"word":"上下交困","pinyin":"shàng xià jiāo kùn","abbr":"sxjk","explanation":"指国家和百姓都处于困难的境地。","source":{"text":"以中国所有财产抵借外债，积数十年不能清偿。摊派加捐，上下交困。","book":"《清史稿·食货志一》"},"usage":"作谓语、定语；指处于困境"},{"id":1878,"word":"上下交征","pinyin":"shàng xià jiāo zhēng","abbr":"sxjz","explanation":"交：互相；征：求取。上上下下互相争夺私利。","source":{"text":"上下交征利，而国危矣。","book":"《孟子·梁惠王上》"},"example":{"text":"署中酷吏，无异豺狼，利己殃民，剥闾阎以充囊橐，卖官鬻爵，进谄佞而抑贤才；以致～，生民涂炭。","book":"蔡东藩《清史演义》五十八回"}},{"id":1879,"word":"上下其手","pinyin":"shàng xià qí shǒu","abbr":"sxqs","explanation":"比喻玩弄手法，串通做弊。","source":{"text":"此子可为穿封戍，方城外之县尹也，谁获子？","book":"《左传·襄公二十六年》记载：伯州犁有意偏袒公子围，叫皇颉作证，并向皇颉暗示，举起手说：“夫子为王子围，寡君之贵介弟也。”把手放下说"},"example":{"text":"亏得尚有“巧妙不同”一句注脚，还可～一番。","book":"朱自靖《“海阔天空”与“古今中外”》"},"similar":["营私舞弊","徇私舞弊"],"opposite":["光明磊落","问心无愧"],"usage":"作谓语、宾语；指玩弄手法","story":["公元前547年，楚国出兵攻打郑国，穿封戍和公子合围郑国大夫皇颉，穿封戍俘获了他。在战后，公子围争功，穿封戍不服，请太宰伯州犁裁决。伯州犁有意把手抬高对皇颉介绍公子围，把手降低介绍穿封戍。皇颉会意说是公子围俘获他的"]},{"id":1880,"word":"上下同心","pinyin":"shàng xià tóng xīn","abbr":"sxtx","explanation":"上下一心。","source":{"text":"自成虽然新遭大败，但此人百折不挠，锐意进取，加之重要将领均在，上下同心，亲密无向，又善于整饬军纪，救民之急，所以只要他喘息一下，重振旗鼓不难。","book":"姚雪垠《李自成》第一卷第十七章"},"example":{"text":"南朝·宋·范晔《后汉书·和帝纪》：“咎罚既至，复令灾及小民。若～，庶或有廫。”"},"similar":["上下同欲","齐心协力"],"usage":"作谓语、定语；用于处事"},{"id":1881,"word":"上下同欲","pinyin":"shàng xià tóng yù","abbr":"sxty","explanation":"上下有共同的愿望，指众心齐一。","source":{"text":"故知胜有五：知可以战与不可以战者胜；识众寡之用者胜；上下同欲者胜；以虞待不虞者胜；将能而君不御者胜。","book":"《孙子·谋攻》"},"similar":["上下同心","万众一心"],"usage":"作谓语、定语；用于处事等"},{"id":1882,"word":"上下同门","pinyin":"shàng xià tóng mén","abbr":"sxtm","explanation":"上下：指上一辈与下一辈。姑婿与侄婿的互称。","source":{"text":"代有姑之婿与侄之婿，谓之上下同门。","book":"唐·赵璘《因话录》卷三：“杨仆射於陵在考功时，与李师稷及第。至其子相国嗣复知举，门生集候仆射，而李公在坐，时人谓之杨家上下门生。”自注"},"usage":"作宾语、定语；用于书面语"},{"id":1883,"word":"上下天光","pinyin":"shàng xià tiān guāng","abbr":"sxtg","explanation":"上空与水中碧光一色。形容水中倒影使天水连成一片。","source":{"text":"上下天光，一碧万顷。","book":"宋·范仲淹《岳阳楼记》"},"similar":["水天一色"],"usage":"作谓语、定语；用于书面语"},{"id":1884,"word":"上下床","pinyin":"shàng xià chuáng","abbr":"sxc","explanation":"比喻人或事高下悬殊。","source":{"text":"如小人欲卧百尺楼上，卧君于地，何但上下床之间邪？","book":"《三国志·魏志·陈登传》"},"example":{"text":"人物真高绝，何徒～。","book":"元·方回《追和艮轩俞同年题程一甫诗卷》"}},{"id":1885,"word":"上下打量","pinyin":"shàng xià dǎ liàng","abbr":"sxdl","explanation":"对某人估量揣度。","example":{"text":"他竟第一次～我。"},"usage":"作谓语、宾语；指观察人"},{"id":1886,"word":"上下无常","pinyin":"shàng xià wú cháng","abbr":"sxwc","explanation":"旧指官位的上升与下降没有一定的规律。","source":{"text":"子曰；‘上下无常，非为邪也。’","book":"《周易·乾》"},"example":{"text":"愿得远度以自娱，～穷六区。","book":"《后汉书·张衡传》"}},{"id":1887,"word":"上下有服","pinyin":"shàng xià yǒu fú","abbr":"sxyf","explanation":"指旧时等级，上下级服装有严格区别。","source":{"text":"子产使都鄙有章，上下有服，田有封洫，庐井有伍。","book":"《左传·襄公三十年》"}},{"id":1888,"word":"上下有等","pinyin":"shàng xià yǒu děng","abbr":"sxyd","explanation":"指等级区别。","source":{"text":"贵贱有仪，上下有等。","book":"《庄子·天下》"}},{"id":1889,"word":"上下有节","pinyin":"shàng xià yǒu jié","abbr":"sxyj","explanation":"节：节度。不论职位高低都有法度约束。","source":{"text":"吾今威之以法，法行则知恩，限之以爵，爵加则知荣；荣恩并济，上下有节。为治之要，于斯而著。","book":"《三国志·蜀志·诸葛亮传》裴松之注引《蜀记》"}},{"id":1890,"word":"上下浮动","pinyin":"shàng xià fú dòng","abbr":"sxfd","explanation":"短促而反复地由下而上或由上而下地移动。","example":{"text":"个人的工资待遇应该随效益的高低～。"},"opposite":["静止不动"],"usage":"作谓语、定语；指不平稳"},{"id":1891,"word":"上下相安","pinyin":"shàng xià xiāng ān","abbr":"sxxa","explanation":"地位高的和地位低的相安无事。","source":{"text":"今大晋煕，六合宁静……主无骄肆之怒，臣无氂缨之请，上下相安，率礼从道。","book":"《晋书·束晳传》"},"example":{"text":"过了半载，倒也～，除睡觉吃饭之外，其余一无事事。","book":"《文明小史》第一回"},"usage":"作谓语、定语；用于局面等"},{"id":1892,"word":"上下翻腾","pinyin":"shàng xià fān téng","abbr":"sxft","explanation":"使上升又落下。","example":{"text":"我的心情～，久久不能平静。"},"similar":["上下翻滚"],"usage":"作谓语；指不平静"},{"id":1893,"word":"上不上，下不下","pinyin":"shàng bù shàng，xià bù xià","abbr":"sbsxbx","explanation":"形容进退两难。","source":{"text":"鉴前之败，必不越魏诛赵；校罪轻重，必不先赵后魏。是上不上，下不下，当魏而来也。","book":"《新唐书·季安传》"},"example":{"text":"娘子早是对我说，不然进入他家，如飞蛾投火一般，坑你～，那时悔之晚矣。","book":"明·兰陵笑笑生《金瓶梅词话》第十七回"}},{"id":1894,"word":"上不在天，下不着地","pinyin":"shàng bù zài tiān，xià bù zháo dì","abbr":"sbztxbzd","explanation":"上不在天，指非星辰之类；下不着地，指非草木之类。形容偏僻闭塞的地方。","source":{"text":"[人]上不属天，而下不著地，以肠胃为根本，不食则不能活。","book":"《韩非子·解老》"},"example":{"text":"只叫他在这上不在天下不着地的地方，给我结了几间茅屋，我同老母居住。《儿女英雄传》第八回"},"similar":["上不属天，下不着地"],"usage":"作谓语、定语、状语；多用于比喻句"},{"id":1895,"word":"上不属天，下不着地","pinyin":"shàng bù shǔ tiān，xià bù zháo dì","abbr":"sbstxbzd","explanation":"属：接连。指不着边际，没有着落。","source":{"text":"上不属天，下不着地。","book":"战国·韩·韩非《韩非子·解老》"},"similar":["上不沾天，下不着地"],"usage":"作谓语、定语、状语；多用于比喻句"},{"id":1896,"word":"上不得台盘","pinyin":"shàng bù dé tái pán","abbr":"sbdtp","explanation":"比喻因寒酸丑陋等见不得人。","source":{"text":"这老三还是这么‘毛脚鸡’似的。我说你上不得台盘！赵姨娘平时也该教导教导他！","book":"清·曹雪芹《红楼梦》第二十五回"},"example":{"text":"苏麻喇姑虽好，读的书究竟有限，她又是个女孩子，～。","book":"二月河《康熙大帝》十三"},"similar":["上不得台面"],"usage":"作谓语、定语；用于比喻句"},{"id":1897,"word":"上不沾天，下不着地","pinyin":"shàng bù zhān tiān，xià bù zháo dì","abbr":"sbztxbzd","explanation":"指不着边际，没有着落。","source":{"text":"住在一个上不沾天，下不着地的所在。","book":"《八十一梦·第72梦》"},"similar":["上不属天，下不着地"],"usage":"作谓语、定语、状语；多用于比喻句"},{"id":1898,"word":"上不着天，下不着地","pinyin":"shàng bù zháo tiān，xià bù zháo dì","abbr":"sbztxbzd","explanation":"比喻两头没有着落。","source":{"text":"[人]上不属天，而下不著地，以肠胃为根本，不食则不能活。","book":"《韩非子·解老》"},"example":{"text":"唐可林上不着天下有着地地又说一句，弄得大家莫名其妙。","book":"郑义《迷雾》八"},"similar":["前不着村，后不着店"],"usage":"作定语、分句；指不上不下"},{"id":1899,"word":"上之所好，下必从之","pinyin":"shàng zhī suǒ hào，xià bì cóng zhī","abbr":"szshxbcz","explanation":"在上的人喜欢什么，在下的人就一定会跟着做。","source":{"text":"上有好者，下必有甚焉者矣。","book":"语出《孟子·滕文公上》"},"example":{"text":"夫～。故越王好勇而士多轻死，楚王好瘠而国有饥人。","book":"《北史·李彪传》"},"usage":"作宾语、定语；用于书面语"},{"id":1900,"word":"上之所好，下必甚焉","pinyin":"shàng zhī suǒ hào，xià bì shèn yān","abbr":"szshxbsy","explanation":"上：居上位的人；好：爱好；甚：更厉害。居上位的人有哪一种爱好，在下面的人必定爱好得更厉害。指上行下效，影响深重。","source":{"text":"上有好者，下必有甚焉者矣。","book":"《孟子·滕文公上》"},"example":{"text":"改政移风，必有其本，～。","book":"《后汉书》载《城中谣》"}},{"id":1901,"word":"上书言事","pinyin":"shàng shū yán shì","abbr":"ssys","explanation":"指向朝廷书面提出对国家大事的看法或建议。现多指向上级写信提建议或意见。","source":{"text":"临菑人主父偃、严安，无终人徐乐，皆上书言事。","book":"《资治通鉴·汉纪十》"},"example":{"text":"天下幕职、州县官～，凡民俗利害，政令否臧，并许于本州附传置以闻。","book":"清·毕沅《续资治通鉴》卷十二"}},{"id":1902,"word":"上了贼船","pinyin":"shàng lé zéi chuán","abbr":"slzc","explanation":"比喻已入歧途，难以抽身。","source":{"text":"别哭啦，哭也没用。这一回，我算上了贼船，走到江心了！","book":"浩然《艳阳天》"},"similar":["误入歧途"],"usage":"作谓语；用于被动的局面"},{"id":1903,"word":"上交不谄","pinyin":"shàng jiāo bù chǎn","abbr":"sjbc","explanation":"谄：巴结、奉承。与据高位的人交往，不拍马奉承。","source":{"text":"君子上交不谄，下交不渎。","book":"《易·系辞下》"},"usage":"作谓语、定语；用于为人处世等"},{"id":1904,"word":"上兵伐谋","pinyin":"shàng bīng fá móu","abbr":"sbfm","explanation":"上：上等，引申为最好的。兵：指战争，引申为用兵。伐：讨伐，攻打。伐谋：用计谋粉碎敌人的计策。用兵的上策，是以谋略取胜。","source":{"text":"故上兵伐谋，其次伐交，其次伐兵，下政攻城。","book":"《孙子·谋攻》"}},{"id":1905,"word":"上勤下顺","pinyin":"shàng qín xià shùn","abbr":"sqxs","explanation":"勤：勤奋。顺：顺从，服从。作领导的勤奋工作，下面的人就会顺从他的领导。","source":{"text":"惟所令之不亦顺乎，上勤下顺遂济登兹，不亦休乎。","book":"唐·韩愈《郓州谿堂诗》"},"usage":"作宾语、定语；用于局面等"},{"id":1906,"word":"上医医国","pinyin":"shàng yī yī guó","abbr":"syyg","explanation":"上医：高明的医生，比喻高贤；医国：指为国家除患祛弊。高贤能治理好国家。","source":{"text":"文子曰：‘医及国家乎？’对曰：‘上医医国，其次疾人，固医官也。’","book":"《国语·晋语八》"},"usage":"作宾语、定语；用于书面语"},{"id":1907,"word":"上南落北","pinyin":"shàng nán luò běi","abbr":"snlb","explanation":"漫言各处去向，犹言走南闯北。","source":{"text":"他又不和我一搭儿做买卖，我怎知他上南落北。","book":"元·无名氏《朱砂担》第一折"},"example":{"text":"如今的年青人，心都野了，总不肯守在家里，欢喜往处跑……可是等我闭了眼睛，那时～，都由他去罢。","book":"茅盾《霜叶红似二月花》一"},"similar":["走南闯北"],"usage":"作谓语、宾语、定语；用于口语"},{"id":1908,"word":"上厅行首","pinyin":"shàng tīng háng shǒu","abbr":"stxs","explanation":"上厅：旧指官府。元明时官妓承应官府，参拜或歌舞，以姿艺最出色的排在行列最前面。后成为名妓的通称。","source":{"text":"自家姓李，夫主姓杜，所生一个女儿，是上厅行首杜蕊娘。","book":"元·关汉卿《金线池》第一折"},"example":{"text":"微臣燕青曾于宣和二年上元之夜～李师师家，得观太上道君皇帝，蒙赐御笔，赦臣万死。","book":"清·陈忱《水浒后传》第三十七回"}},{"id":1909,"word":"上吐下泻","pinyin":"shàng tǔ xià xiè","abbr":"stxx","explanation":"呕吐与腹泻。指人患病。","source":{"text":"化及见军士焦头烂额，后忽然又上吐下泻，一齐病倒，便放声大哭。","book":"清·褚人获《隋唐演义》第50回"},"example":{"text":"清·李宝嘉《官场现形记》第47回：“～的病，只要吃两口鸦片烟就好了。”"},"usage":"作谓语、定语、宾语；用于疾病等"},{"id":1910,"word":"上和下睦","pinyin":"shàng hé xià mù","abbr":"shxm","explanation":"指长幼之间或上下级之间相处得很好。","source":{"text":"常则是户静门清，上和下睦，立计成家，众口流传。","book":"元·岳伯川《铁拐李》第三折"},"example":{"text":"他不多几年，已巴到极顶的份儿，也只为识时达务，能够～罢了。","book":"《红楼梦》第九回"},"usage":"作谓语、定语；多用于家庭等"},{"id":1911,"word":"上善若水","pinyin":"shàng shàn ruò shuǐ","abbr":"ssrs","explanation":"上善：至善，最完美；水：这里喻指与世无争的圣人。达到尽善尽美的境界，就和圣人差不多了。","source":{"text":"上善若水，水善利万物而不争。","book":"《老子》第八章"}},{"id":1912,"word":"上天下地","pinyin":"shàng tiān xià dì","abbr":"stxd","explanation":"上面至于天，下而至于地。形容范围广阔，没有限制。多用以形容说话、写文章内容非常空阔广泛。","source":{"text":"上天下地如轮转，跨海飞山第一能。","book":"明·吴承恩《西游记》第二十七回"},"example":{"text":"其实，谢月亭这个小孩子虽然可爱，却也不是什么～有一无二的美男子。","book":"清·张春帆《九尾龟》第一百六十二回"}},{"id":1913,"word":"上天不负苦心人","pinyin":"shàng tiān bù fù kǔ xīn rén","abbr":"stbfkxr","explanation":"指埋头苦干的人，终能获得成功。","source":{"text":"虽然多辛苦了几次，如今却高高的中了个第三，可谓上天不负苦心人，文章自有定论。","book":"《儿女英雄传》第一回"},"example":{"text":"不过我当初想，～，苦干也能补救我这个缺点。","book":"曹禺《日出》第二幕"},"similar":["皇天不负苦心人"],"usage":"作宾语、定语；用于口语"},{"id":1914,"word":"上天入地","pinyin":"shàng tiān rù dì","abbr":"strd","explanation":"升上天空，钻入地下。形容神通广大。也比喻为实现某种目的而四处奔走。","source":{"text":"吾已得炼形之术也，其术自无形成而炼成三尺之形，则上天入地，乘云驾鹤，千变万化，无不可也。","book":"唐·李复言《续玄怪录·卢仆射从史》"},"example":{"text":"待贫道就在坛中，飞出元神，不论～，好歹寻著娘娘。","book":"清·洪昇《长生殿》第四十六出"},"similar":["神通广大"],"usage":"作谓语、定语；形容无所畏惧"},{"id":1915,"word":"上天无路，入地无门","pinyin":"shàng tiān wú lù，rù dì wú mén","abbr":"stwlrdwm","explanation":"形容无路可走的窘迫处境。","source":{"text":"进前则触途成滞，退后即噎气填胸，直得上天无路，入地无门。","book":"宋·释悟明《联灯会要》卷二十八"},"example":{"text":"大家的心境都已经达到绝望的程度了，真个是～，对着那浩浩的赣江，竟想喊出两声蹩脚的秦腔了。","book":"郭沫若《南昌之一夜》"},"similar":["进退两难","走投无路"],"opposite":["前程似锦"],"usage":"作定语、分句；指陷入绝境"},{"id":1916,"word":"上天要价，落地还钱","pinyin":"shàng tiān yào jià，luò dì huán qián","abbr":"styjldhq","explanation":"指商业上的讨价还价，卖方把售价要得很高，买方则把价钱还得很低。","source":{"text":"漫天要价，就地还钱，原是买物之人向来俗谈。","book":"清·李汝珍《镜花缘》第十一回"}},{"id":1917,"word":"上好下甚","pinyin":"shàng hǎo xià shèn","abbr":"shxs","explanation":"上面的喜爱什么，下面的人就会对此爱好的更加利害。","source":{"text":"上有好者，下必有甚焉者矣。","book":"《孟子·滕文公上》"},"similar":["上行下效"],"usage":"作谓语、宾语；指上行下效"},{"id":1918,"word":"上嫚下暴","pinyin":"shàng màn xià bào","abbr":"smxb","explanation":"指君上骄慢，下民强暴。同“上慢下暴”。","source":{"text":"上嫚下暴，惟盗是伐，胜、广熛起，梁、籍扇烈。","book":"《汉书·叙传下》"}},{"id":1919,"word":"上山捉虎，下海擒龙","pinyin":"shàng shān zhuō hǔ，xià hǎi qín lóng","abbr":"sszhxhql","explanation":"比喻冒死去做艰巨危险的事情。","source":{"text":"姑娘，你有甚么为难的事，只管说！慢讲‘上山捉虎，下海擒龙’，就便‘赴汤蹈火，碎骨粉身’，我安龙媒此时都敢替你去作！","book":"清·文康《儿女英雄传》第九回"}},{"id":1920,"word":"上当受骗","pinyin":"shàng dàng shòu piàn","abbr":"sdsp","explanation":"因信假为真而被欺骗、吃亏。","example":{"text":"年轻人很容易～。"},"similar":["受骗上当"],"usage":"作谓语、宾语；指受欺骗"},{"id":1921,"word":"上当学乖","pinyin":"shàng dāng xué guāi","abbr":"sdxg","explanation":"吃过亏下次就不会上当。","source":{"text":"上当学乖，言吃亏处，即是长见识处也。","book":"《泾谚汇录》"},"example":{"text":"做生意讲究诚信，否则顾客～，以后就不再上门来了。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":1922,"word":"上得天时，下得地利","pinyin":"shàng dé tiān shí，xià dé dì lì","abbr":"sdtsxddl","explanation":"指作战既有适宜的气候条件，又有优越的地理形势作依托。也形容办事所具备的客观条件极为有利。","source":{"text":"上得天时，下得地利，观敌之变动，后之发，先之至，此用兵之要术也。","book":"《荀子·议兵》"}},{"id":1923,"word":"上德不德","pinyin":"shàng dé bù dé","abbr":"sdbd","explanation":"形容很有德行的人，不自夸其德。","source":{"text":"上德不德，是以有德；下德不失德，是以无德。","book":"《老子》第三十八章"},"example":{"text":"可道非道，常道无名。～，至德无盈。","book":"《隋书·徐则传》"}},{"id":1924,"word":"上德若谷","pinyin":"shàng dé ruò gǔ","abbr":"sdrg","explanation":"上德：最高的道德；谷：溪谷。形容具有崇高道德的人胸怀如同山谷一样深广，可以容纳一切。","source":{"text":"夷道若颣，上德若谷。","book":"《老子》第四十一章"},"example":{"text":"袁复黎书：来牍阅悉，成功不居，～，事符往籍，益叹渊衷。","book":"丁中江《北洋军阀史话》五十八"}},{"id":1925,"word":"上情下达","pinyin":"shàng qíng xià dá","abbr":"sqxd","explanation":"下面的情况或意见能够通达于上。","source":{"text":"下情不上通，谓之塞。","book":"《管子·明法》"},"similar":["下情上达","政通人和"],"opposite":["下塞上聋"],"usage":"作宾语、定语；指上下沟通"},{"id":1926,"word":"上慢下暴","pinyin":"shàng màn xià bào","abbr":"smxb","explanation":"指君上骄慢，下民强暴。","source":{"text":"国家如君上骄惰，下民强暴，则盗寇思伐之矣。","book":"《易·系辞上》：“小人而乘君子之器，盗思夺之矣。上慢下暴，盗思伐之矣。”高亨注"},"example":{"text":"夫民疲劳则骚扰之兆生，～则瓦解之形起。","book":"《三国志·蜀志·谯周传》"},"usage":"作谓语、定语；用于局面等"},{"id":1927,"word":"上挂下联","pinyin":"shàng guà xià lián","abbr":"sgxl","explanation":"挂：悬挂。上面挂着，下面联着。比喻向上下追查，扩大牵涉面。","example":{"text":"～，审查面越来越宽，打击面越来越大。","book":"叶永烈《张春桥传·附录一》"}},{"id":1928,"word":"上推下卸","pinyin":"shàng tuī xià xiè","abbr":"stxx","explanation":"把责任推给上级，卸给下级，自己却不负责任。","example":{"text":"他～，自己没一点责任。"},"usage":"作谓语、定语；指自己不负责"},{"id":1929,"word":"上援下推","pinyin":"shàng yuán xià tuī","abbr":"syxt","explanation":"上面牵引下面推。比喻推荐引进。","source":{"text":"適弗逢世，上弗援，下弗推，谗谄之民，有比党而危之者。","book":"《礼记·儒行》"},"usage":"作宾语、定语；用于书面语"},{"id":1930,"word":"上方不足，下比有余","pinyin":"shàng fāng bù zú，xià bǐ yǒu yú","abbr":"sfbzxbyy","explanation":"比上不足，比下有余。","source":{"text":"湛上方山涛不足，下比魏舒有余。","book":"《晋书·王湛传》"},"similar":["比上不足，比下有余"],"usage":"作宾语、分句；指处于中间位置"},{"id":1931,"word":"上方宝剑","pinyin":"shàng fāng bǎo jiàn","abbr":"sfbj","explanation":"尚方署特制的皇帝御用的宝剑。古代天子派大臣处理重大案件时，常赐以上方宝剑，表示授于全权，可以先斩后奏。现用以比喻来自上级的口头指示或书面文件。","source":{"text":"秦越终于拿到了一把上方宝剑了。","book":"达理《路障》"},"example":{"text":"秦越终于拿到一把～了。他指示市委印刷厂印了几千份，分发给各有关单位。","book":"达理《路障》六"},"similar":["尚方宝剑"],"usage":"作宾语、定语；比喻极大的权力"},{"id":1932,"word":"上无片瓦遮身，下无立锥之地","pinyin":"shàng wú piàn wǎ zhē shēn，xià wú lì zhuī zhī dì","abbr":"swpwzsxwlzzd","explanation":"形容一无所有，贫困到了极点。","source":{"text":"原来刘打鬼收成结果了雌鬼，把活鬼的古老宅基也卖来喂了指头，弄得上无片瓦遮身，下无立锥之地，只得仍缩在娘身边。","book":"清·张南庄《何典》第九回"},"similar":["上无片瓦，下无立锥之地"],"opposite":["腰缠万贯"],"usage":"作定语、状语、分句；指非常贫困"},{"id":1933,"word":"上无片瓦，下无卓锥","pinyin":"shàng wú piàn wǎ，xià wú zhuō zhuī","abbr":"swpwxwzz","explanation":"形容一无所有，贫困到无立足之地。","source":{"text":"上无片瓦，下无卓锥，学人向什么处立？","book":"宋·释道原《景德传灯录·丰化和尚》"},"similar":["上无片瓦，下无立锥之地"],"usage":"作定语、分句；指非常贫困"},{"id":1934,"word":"上无片瓦，下无卓锥之地","pinyin":"shàng wú piàn wǎ，xià wú zhuó zhuī zhī dì","abbr":"swpwxwzzzd","explanation":"卓：直立。形容一无所有，贫困到了极点。","source":{"text":"问：‘上无片瓦，下无卓锥时如何？’师曰：‘莫飘露么。’","book":"宋·释普济《五灯会元·云居膺禅师法嗣》"},"similar":["上无片瓦，下无卓锥"],"usage":"作定语、分句；指非常贫困"},{"id":1935,"word":"上无片瓦，下无插针之地","pinyin":"shàng wú piàn wǎ，xià wú chā zhēn zhī dì","abbr":"swpwxwczzd","explanation":"头顶上没有一片瓦，肢底下没有插针的地方。形容一无所有，贫困到了极点。","source":{"text":"上无片瓦，下无卓锥，学人向什么处立？","book":"宋·释道原《景德传灯录》卷二十"},"example":{"text":"贫农们不怕失掉什么。他们中间有很多人，确实是“～”，他们有什么不进农会？","book":"毛泽东《湖南农民运动考察报告》"},"similar":["上无片瓦，下无立锥之地"],"usage":"作宾语、定语；用于人的处境"},{"id":1936,"word":"上无片瓦，下无立锥","pinyin":"shàng wú piàn wǎ，xià wú lì zhuī","abbr":"swpwxwlz","explanation":"形容一无所有，贫困到了极点。","source":{"text":"上无片瓦，下无卓锥，学人向什么处立？","book":"宋·释道原《景德传灯录·丰化和尚》"},"example":{"text":"我～，丈夫又不要我，又无亲戚投奔，不死更待何时。","book":"明·冯梦龙《喻世明言》第35卷"},"similar":["上无片瓦，下无卓锥"],"usage":"作定语、分句；指非常贫困"},{"id":1937,"word":"上无片瓦，下无立锥之地","pinyin":"shàng wú piàn wǎ，xià wú lì zhuī zhī dì","abbr":"swpwxwlzzd","explanation":"形容一无所有，贫困到了极点。","source":{"text":"上无片瓦，下无卓锥，学人向什么处立？","book":"宋·释道原《景德传灯录》卷二十"},"similar":["上无片瓦，下无卓锥之地"],"usage":"作定语、分句；指非常贫困"},{"id":1938,"word":"上智下愚","pinyin":"shàng zhì xià yú","abbr":"szxy","explanation":"智：聪明；愚：笨。最聪明的人和最愚笨的人。孔子认为他们都是先天决定，不可改变。","source":{"text":"子曰：‘唯上知与下愚不移。’","book":"《论语·阳货》"},"usage":"作宾语、定语；用于书面语"},{"id":1939,"word":"上替下陵","pinyin":"shàng tì xià líng","abbr":"stxl","explanation":"指上下失序，纲纪废坠。陵，通“凌”。同“下陵上替”。","source":{"text":"若君亡君之威，臣亡臣之仪，上替下陵，此谓大乱。","book":"《后汉书·礼仪志上》"},"similar":["上陵下替"],"usage":"作谓语、定语；用于书面语"},{"id":1940,"word":"上有天堂，下有苏杭","pinyin":"shàng yǒu tiān táng，xià yǒu sū háng","abbr":"syttxysh","explanation":"形容苏州、杭州的繁荣、富庶。","source":{"text":"谚曰：‘天上天堂，地下苏杭。’","book":"宋·范成大《吴郡志》"},"example":{"text":"春暖花香，岁稔时康。真乃～。","book":"《双调蟾宫曲·咏西湖》"},"usage":"作宾语、定语；用于书面语"},{"id":1941,"word":"上有所好，下必甚焉","pinyin":"shàng yǒu suǒ hào，xià bì shèn yān","abbr":"syshxbsy","explanation":"上：居上位的人；好：爱好；甚：更厉害。居上位的人有哪一种爱好，在下面的人必定爱好得更厉害。指上行下效，影响深重。","source":{"text":"上有好者，下必有甚焉者矣。","book":"《孟子·滕文公上》"},"example":{"text":"人之慕名，如水趋下，～。","book":"《资治通鉴·唐纪·高宗上元二年》"}},{"id":1942,"word":"上树拔梯","pinyin":"shàng shù bá tī","abbr":"ssbt","explanation":"拔：抽掉。诱人上树，抽掉梯子。比喻引诱人上前而断绝他的退路。","source":{"text":"此事黄龙兴化亦当作助道之缘，共出一臂，莫送人上树拔却梯也。","book":"宋·晓莹《罗湖野录》第一卷引宋·黄庭坚与兴化海老手帖"},"example":{"text":"你不要老干那种～的坏事。"},"similar":["过河拆桥","落井下石"],"usage":"作谓语、定语；指落井下石"},{"id":1943,"word":"上根大器","pinyin":"shàng gēn dà qì","abbr":"sgdq","explanation":"佛家语。具上等根器者。亦泛指天资、才能极高的人。","source":{"text":"所谓自心作佛，自心是佛，自心见佛。上根大器，一念直超。","book":"宋·江公望《念佛方便文》"},"example":{"text":"此事非～、莫能荷担。","book":"《禅林僧宝传·永明智觉禅师》"}},{"id":1944,"word":"上梁不正","pinyin":"shàng liáng bù zhèng","abbr":"slbz","explanation":"上梁：指上级或长辈。比喻在上的人行为不正，不能以身作则。","source":{"text":"上不正，下参差。","book":"晋·杨泉《物理论》"},"example":{"text":"月馆风亭，则为这虔婆～，这些时消疏了燕燕莺莺。","book":"元·石君宝《曲江池》第三折"},"similar":["上梁不正下梁歪"],"usage":"作宾语、定语、分句；指上下级关系"},{"id":1945,"word":"上梁不正下梁歪","pinyin":"shàng liáng bù zhèng xià liáng wāi","abbr":"slbzxlw","explanation":"上梁：指上级或长辈。比喻在上的人行为不正，下面的人也跟着做坏事。","source":{"text":"上不正，下参差。","book":"晋·杨泉《物理论》"},"example":{"text":"不要怪他们，这叫做～。","book":"清·玩花主人《缀白裘·〈铁冠图·夜乐〉》"},"similar":["上梁不正","上好下甚"],"usage":"作宾语、定语、分句；指上下级关系","story":["宋朝时，陈州接连发生自然灾害，朝廷派贪官刘得中和杨金吾开仓卖粮，他们假公济私抬高粮价，还在粮食里掺沙，分量还不够。老百姓对他们的这种行为极为愤慨，但也没办法，只有叹息：“上梁不正下梁歪”"]},{"id":1946,"word":"上楼去梯","pinyin":"shàng lóu qù tī","abbr":"slqt","explanation":"比喻进行极其秘密的谋划。也比喻诱人上当。","source":{"text":"琦乃将亮游观后园，共上高楼，饮宴之间，令人去梯，因谓亮曰：‘今日上不至天，下不至地，言出子口，入于吾耳，可以言示？’","book":"晋·陈寿《三国志·蜀志·诸葛亮传》"},"example":{"text":"他尽干些～之类的坏事。"},"similar":["上树拔梯"],"usage":"作谓语、定语；指过河拆桥","story":["东汉末年，刘表把新野送给刘备，让刘备抵御曹操。同时准备让次子刘琮继承自己的位置，这让长子刘琦感到处境比较危险。刘琦请诸葛亮到自家后花园高楼上吃饭，命人把楼梯撤去，虚心向诸葛亮求救，诸葛亮要刘琦去当江夏太守脱险"]},{"id":1947,"word":"上气不接下气","pinyin":"shàng qì bù jiē xià qì","abbr":"sqbjxq","explanation":"形容因为劳累或焦急而气喘得很厉害。","source":{"text":"她上气不接下气地往山村跑去。","book":"李娴娟《血染的爱》"},"example":{"text":"他累得～。"},"similar":["气喘吁吁"],"opposite":["镇定自若"],"usage":"作状语、定语；形容劳累的样子","story":["春秋时期，孔子带领弟子们周游列国，在卫、陈、蔡等国碰壁后，受到了楚国的邀请，孔子立即赴楚，陈国串通蔡国放出囚犯围堵孔子。孔子师徒被围困很多天，他们断了粮，腹中空空，还有同囚犯作战，累得上气不接下气，最后被楚军解围"]},{"id":1948,"word":"上水船","pinyin":"shàng shuǐ chuán","abbr":"ssc","explanation":"逆水而上的船。比喻文思迟钝。","source":{"text":"一声何处送书雁，百丈谁家上水船。","book":"唐·杜甫《十二月一日三首》"},"example":{"text":"这可是～偏遇着顶头风。","book":"姚雪垠《李自成》第二卷第二十六章"}},{"id":1949,"word":"上求下告","pinyin":"shàng qiú xià gào","abbr":"sqxg","explanation":"指到处求问。","source":{"text":"不自反躬穷究，只管上求下告，问他讨禅，被他恣意相薄。","book":"宋·朱熹《朱子语类辑略》卷七"},"usage":"作谓语、定语；用于处事"},{"id":1950,"word":"上求材，臣残木","pinyin":"shàng qiú cái，chén cán mù","abbr":"sqcccm","explanation":"指只要上级有所要求，下边的人就竭意奉承。","source":{"text":"上求材臣残木，上求鱼臣干谷，上求楫而下致船。","book":"《淮南子·说山训》"}},{"id":1951,"word":"上清童子","pinyin":"shàng qīng tóng zǐ","abbr":"sqtz","explanation":"钱的别名。","source":{"text":"贞观中岑文本于山顶避暑，有叩门云：上清童子。岑问曰：衣服皆轻细，何土所出？答云：此上清五铢服。","book":"唐·郑还古《博异志》"}},{"id":1952,"word":"上溢下漏","pinyin":"shàng yì xià lòu","abbr":"syxl","explanation":"指上富下贫。","source":{"text":"上溢而下漏，即是上富而下贫。","book":"《旬子·王制》：“筐箧已富，府库已实，而百姓贫，夫是之谓上溢而下漏。”王先谦解引王引之曰"},"example":{"text":"天下财赋多为禁中私财，～，而民重困。","book":"《宋史·食货志下一》"},"usage":"作谓语、定语；用于书面语"},{"id":1953,"word":"上漏下湿","pinyin":"shàng lòu xià shī","abbr":"slxs","explanation":"上：指屋顶；下：指地面。形容房屋破旧，不能蔽风雨。","source":{"text":"上漏下湿，匡坐而弦。","book":"战国·宋·庄周《庄子·让王》"},"example":{"text":"他们原来的破茅房一下雨就～。"},"usage":"作谓语、定语；指房屋破旧"},{"id":1954,"word":"上烝下报","pinyin":"shàng zhēng xià bào","abbr":"szxb","explanation":"烝：晚辈男子和长辈女子通奸；报：长辈男子与晚辈女子通奸。泛指男女乱伦。","source":{"text":"文公报郑子之妃，曰陈妫，生子华、子臧。","book":"《左传；、　桓公十六年》：“卫宣公烝于夷姜，生急子，属诸右公子。”《左传·宣公三年》"},"example":{"text":"至如～，同人道于禽兽。","book":"明·冯梦龙《醒世恒言》卷十五"},"similar":["上蒸下报"],"usage":"作主语、宾语、定语；用于书面语"},{"id":1955,"word":"上焌下报","pinyin":"shàng zhēng xià bào","abbr":"szxb","explanation":"焌晚辈男子和长辈女子通奸；报长辈男子与晚辈女子通奸。泛指男女乱伦。"},{"id":1956,"word":"上用目，则下饰观","pinyin":"shàng yòng mù，zé xià shì guān","abbr":"symzxsg","explanation":"在上边的能够明察，下边的伪装行为就会被发现。","source":{"text":"上用目，则下饰观；上用耳，则下饰声。","book":"《韩非子·有度》"}},{"id":1957,"word":"上知天文，下知地理","pinyin":"shàng zhī tiān wén，xià zhī dì lǐ","abbr":"sztwxzdl","explanation":"形容学问广博，无所不知。","source":{"text":"吴国贤臣杵子胥，上知天文，下知地理，文经武律，以立其身。","book":"《敦煌变文章·伍子胥变文》"},"usage":"作谓语、定语；用于人的学识等"},{"id":1958,"word":"上穷碧落下黄泉","pinyin":"shàng qióng bì luò xià huáng quán","abbr":"sqblxhq","explanation":"碧落：天上，此指天宫；黄泉：地下泉水，此指阴间。比喻上天入地，到处都找遍了。","source":{"text":"排空驭气奔如电，升天入地求之遍。上穷碧落下黄泉，两处茫茫皆不见。","book":"唐·白居易《长恨歌》"},"example":{"text":"文皇初，以逊国伏戎为虑，以故轺车四出，几于～矣。","book":"明·沈德符《万历野获编·使西域之赏》"}},{"id":1959,"word":"上窜下跳","pinyin":"shàng cuàn xià tiào","abbr":"scxt","explanation":"比喻四处奔走，多方串连，策划活动。","source":{"text":"上窜下跳，根据需要打出各种不同的旗号，把厂长的事情办成。","book":"蒋子龙《一个工厂秘书的日记》"},"example":{"text":"他～终于将儿子安排到重要的岗位。"},"similar":["窜上窜下"],"usage":"作谓语、定语；指四处奔走"},{"id":1960,"word":"上竿掇梯","pinyin":"shàng gān duō tī","abbr":"sgdt","explanation":"犹上树拔梯。比喻引诱人上前而断绝他的退路。","source":{"text":"怕人家调犯，‘早共晚夫人见些破绽，你我何安。’问甚么他遭危难？撺断得上竿，掇了梯儿看。","book":"元·王实甫《西厢记》第三本第二折"}},{"id":1961,"word":"上篇上论","pinyin":"shàng piān shàng lùn","abbr":"spsl","explanation":"指说话引经据典，有根据。","source":{"text":"老祖宗说句话儿都是上篇上论的，怎么怨得有这么大福气呢？","book":"清·曹雪芹《红楼梦》第八十五回"}},{"id":1962,"word":"上蒸下报","pinyin":"shàng zhēng xià bào","abbr":"szxb","explanation":"泛指乱伦的性行为。","source":{"text":"至如上蒸下报，同人道于禽兽；钻穴逾墙，役心机于鬼蜮。","book":"明·冯梦龙《醒世恒言》第15卷"},"example":{"text":"～扰乱正常的生活秩序。"},"similar":["上烝下报"],"usage":"作主语、宾语、定语；用于书面语"},{"id":1963,"word":"上行下效","pinyin":"shàng xíng xià xiào","abbr":"sxxx","explanation":"效：仿效，跟着学。上面的人怎么做，下面的人就跟着怎么干。","source":{"text":"上行下效，淫俗将成。","book":"汉·班固《白虎通·三教》：“教者，效也，上为之，下效之。”《旧唐书·贾曾传》"},"example":{"text":"殊途同归，皆得其垂衣而治；～，终闻乎比屋可封。","book":"宋·范仲淹《尧舜率天下以仁赋》"},"similar":["如法炮制","鹦鹉学舌"],"opposite":["源清流洁"],"usage":"作主语、谓语、宾语；指上下级关系","story":["春秋事情，丞相晏婴死后，没人敢在齐王面前讲实话，到处都是奉承声，齐王觉得很奇怪，就找臣子弦章谈论此事。弦章说：“凡事都是上行下效，臣子都是按君王的喜好办事，您喜欢被奉承，他们就奉承您。”齐王觉得很有道理"]},{"id":1964,"word":"上谄下渎","pinyin":"shàng chǎn xià dú","abbr":"scxd","explanation":"谄：奉承；渎：轻慢，亵渎。奉承上级，轻慢下属。","source":{"text":"君子上交不谄，下交不渎。","book":"《易·系辞下》"},"usage":"作谓语、定语、状语；用于处世等"},{"id":1965,"word":"上谄下骄","pinyin":"shàng chǎn xià jiāo","abbr":"scxj","explanation":"谄：谄媚。对上级谄媚，对下级骄傲。","source":{"text":"君子上交不谄，下交不渎。","book":"《周易·系辞下》"},"example":{"text":"达兴本是个绔袴官僚，全靠着祖功宗德，唾手得了这尊荣的地位，除了～之外，只晓得提倡声技。","book":"清·曾朴《孽海花》第六回"}},{"id":1966,"word":"上蹿下跳","pinyin":"shàng cuàn xià tiào","abbr":"scxt","explanation":"比喻人上下奔走，四处活动。","example":{"text":"一有机会，他就～，煽风点火。"},"similar":["上窜下跳"],"usage":"作谓语；指四处活动"},{"id":1967,"word":"上门买卖","pinyin":"shàng mén mǎi mài","abbr":"smmm","explanation":"比喻主动找上门来，事情容易做成。","source":{"text":"近来星辰得利，上门买卖何多，尽得金银钞贯，广受段匹纱罗。","book":"明·邵璨《香囊记·媾媒》"},"example":{"text":"小人想，这是～，又不是诈他的，取之无碍。","book":"清·不睡居士《枕上晨钟》第六回"}},{"id":1968,"word":"上闻下达","pinyin":"shàng wén xià dá","abbr":"swxd","explanation":"闻：听见；达：通晓，明白。使上级知道，下级的人明白。","source":{"text":"布衣韦带之士，谈道义者多乎。以仆遑遑于其中，能上闻而下达乎？","book":"唐·韩愈《与李翱书》"}},{"id":1969,"word":"上陵下替","pinyin":"shàng líng xià tì","abbr":"slxt","explanation":"指上下失序，纲纪废坠。陵，通“凌”。同“下陵上替”。","source":{"text":"上陵下替，纲维靡立。","book":"《隋书·炀帝纪上》"},"similar":["上替下陵"],"usage":"作谓语、定语；用于书面语"},{"id":1970,"word":"上雨旁风","pinyin":"shàng yǔ páng fēng","abbr":"sypf","explanation":"形容家里贫穷，房屋破旧。","source":{"text":"上雨旁风，无所盖障。","book":"唐·韩愈《面海神庙碑》"},"similar":["上漏下湿"],"usage":"作定语；指房屋破旧"},{"id":1971,"word":"上驷之才","pinyin":"shàng sì zhī cái","abbr":"sszc","explanation":"驷：原指古代同驾一辆车的四匹马，泛指良马。比喻非常优秀的人才。","source":{"text":"今以君下之驷，与彼上驷；取君上驷，与彼中驷。","book":"《史记·孙子传》"},"example":{"text":"至于李兴锐的出处，却又与锡良有关。他是蒙古人，两榜出身，廉惠勤朴，在旗人中是～。","book":"高阳《慈禧全传》九十三"}},{"id":1972,"word":"下不为例","pinyin":"xià bù wéi lì","abbr":"xbwl","explanation":"下次不可以再这样做。表示只通融这一次。","source":{"text":"至丁未年而栋卒，其母赵氏为孙乞恩承袭，上命栋子明辅袭祖伯爵。时署部少宰杨时乔力谏不从，上但云后不为例而已。","book":"明·沈德符《万历野获编·中宫外家恩泽》"},"example":{"text":"既然如此，只此一次，～如何？（清·张春帆《宦海》第十八回）"},"similar":["适可而止"],"opposite":["不厌其烦"],"usage":"作谓语、分句；用于违规等"},{"id":1973,"word":"下不了台","pinyin":"xià bù le tái","abbr":"xblt","explanation":"指在人前受窘。","source":{"text":"但要是这家人死缠硬磨，她二妈又从旁劝说，她到时又可能没勇气和这一群县上的头面人物破开脸皮，让他们当场下不了台。","book":"路遥《平凡的世界》第二卷第36章"},"example":{"text":"我一时～，只好自我解嘲了。"},"similar":["下不来台"],"usage":"作谓语、状语；用于口语"},{"id":1974,"word":"下不来台","pinyin":"xià bù lái tái","abbr":"xblt","explanation":"指在人前受窘。","source":{"text":"若说外头好看，里头空虚，是我早知道的了，只是‘居移气，养移体’，一时下不来台就是了。","book":"清·曹雪芹《红楼梦》第107回"},"example":{"text":"我被你整得～。"},"similar":["下不了台"],"usage":"作谓语、状语；用于口语"},{"id":1975,"word":"下临无地","pinyin":"xià lín wú dì","abbr":"xlwd","explanation":"临：从高处往低处看。向下望去深得不见地底。形容极其高峻陡峭。","source":{"text":"层台耸翠，上出重霄；飞阁流丹，下临无地。","book":"唐才子传》·胡曾下井投石王勃《滕王阁序》"},"example":{"text":"螭头高拱，上逼层霄；鸱吻分张，～。","book":"明·冯梦龙《醒世恒言》卷二十一"},"similar":["下临无际"],"usage":"作谓语、定语；用于书面语"},{"id":1976,"word":"下临无际","pinyin":"xià lín wú jì","abbr":"xlwj","explanation":"临：居高处朝向低处。从高往下看，望不见底。形容地势极其陡峭。","example":{"text":"站在尖峰岭顶上看，～的热带雨林格外壮观。"},"similar":["下临无地"],"usage":"作谓语、定语；用于书面语"},{"id":1977,"word":"下乔入幽","pinyin":"xià qiáo rù yōu","abbr":"xqry","explanation":"从高树上下来，钻进幽深的坑谷里。比喻弃明从暗，或从良好的处境转入恶劣的处境。","source":{"text":"吾闻出于幽谷，迁于乔木者，未闻下乔木而入幽谷者。","book":"《孟子·滕文公上》"},"example":{"text":"舍高就卑，曰～。","book":"宋·胡继宗《书信故事·评论类》"},"similar":["弃明从暗","下乔迁谷"],"usage":"作谓语；指从良好的处境转入恶劣的处境"},{"id":1978,"word":"下乔木入幽谷","pinyin":"xià qiáo mù rù yōu gǔ","abbr":"xqmryg","explanation":"从高树上下来，钻进幽深的坑谷里。比喻弃明从暗，或从良好的处境转入恶劣的处境。","source":{"text":"吾闻出于幽谷，迁于乔木者，未闻下乔木而入幽谷者。","book":"《孟子·滕文公上》"}},{"id":1979,"word":"下乔迁谷","pinyin":"xià qiáo qiān gǔ","abbr":"xqqg","explanation":"用来比喻人从光明走向黑暗，或者从良好的处境而进入劣境。。","source":{"text":"参见“下乔入幽”。"},"example":{"text":"部院庶僚亦自以～为耻。","book":"清·陈康祺《郎潜纪闻》卷一"},"similar":["下乔入幽"],"usage":"作宾语、定语；用于处事等"},{"id":1980,"word":"下乘之才","pinyin":"xià shèng zhī cái","abbr":"xszc","explanation":"下乘：下等的马。比喻庸劣的人。","source":{"text":"亵之者，固以为园囿之凡鸟，外厩之下乘也。","book":"三国·魏·陈琳《国曹洪与曹文帝书》"}},{"id":1981,"word":"下井投石","pinyin":"xià jǐng tóu shí","abbr":"xjts","explanation":"见人掉进井里，不但不搭救，反而向井里仍石头。","source":{"text":"他一见完眷比从前差了许多，晓得其中一定有人下井投石，说他坏话。","book":"清·李宝嘉《官场现形记》第12回"},"example":{"text":"不肯～即带有费厄泼赖之意。","book":"林语堂《插论语丝的文体——稳健、骂人及费厄泼赖》"},"similar":["落井投石"],"usage":"作谓语、定语；指陷害人"},{"id":1982,"word":"下交不渎","pinyin":"xià jiāo bù dú","abbr":"xjbd","explanation":"渎：轻慢，不敬。与下交往，不轻慢下属。","source":{"text":"君子上交下谄，下交不渎，其知几乎。","book":"《周易·系辞下》"},"example":{"text":"遨历四方，马迹穷岁月，所在必公卿馆谷。上交不谄，～，奇士也。","book":"元·辛文房《唐才子传·胡曾》"}},{"id":1983,"word":"下回分解","pinyin":"xià huí fēn jiě","abbr":"xhfj","explanation":"章回小说于每回之末所用的套语。现多用以喻事件发展的结果。"},{"id":1984,"word":"下坂走丸","pinyin":"xià bǎn zǒu wán","abbr":"xbzw","explanation":"从山坡上滚下弹丸。比喻顺势无阻，敏捷而无停滞。","source":{"text":"君计莫若以黄屋朱轮以迎范阳令，使驰骛乎燕赵之郊，则边城皆喜，相率而降，此由（犹）以下坂而走丸也。","book":"汉·荀悦《汉纪·高祖纪一》"},"example":{"text":"张九龄善谈论，每与宾客谘论经旨，滔滔不竭，如～也。","book":"五代·王仁裕《开元天宝遗事·走丸之辩》"},"similar":["下阪走丸"],"opposite":["逆阪走丸"],"usage":"作宾语、定语；比喻说话敏捷","story":["唐朝时期，中书侍郎张九龄负责吏部选拔人才，他主张不循资格用人，设十道采访使，受到皇帝的赞许。他不但能很好地协助皇帝处理政务，而且是有才的诗人。他能言善辩，每当谈论经书时总是滔滔不绝，像下阪走丸一样毫无阻碍"]},{"id":1985,"word":"下塞上聋","pinyin":"xià sāi shàng lóng","abbr":"xssl","explanation":"塞：堵塞不通。聋：耳朵的听觉失灵。下边堵塞不通，上边听觉失灵。比喻真实情况不能上传下达。","source":{"text":"川不可防，言不可弭，下塞上聋，邦其倾矣。","book":"唐·韩愈《子产不毁乡效颂》"},"opposite":["上情下达","下情上达"],"usage":"作宾语、定语；用于政务等"},{"id":1986,"word":"下学上达","pinyin":"xià xué shàng dá","abbr":"xxsd","explanation":"指学习人情事理，进而认识自然的法则。","source":{"text":"子曰：不怨天，不尤人，下学而上达。","book":"《论语·宪问》"},"example":{"text":"有闲余者曰：盖闻前哲首务，务于～，佐国理民，有云为也。","book":"《后汉书·张衡传》"},"usage":"作宾语、定语；用于书面语"},{"id":1987,"word":"下官不职","pinyin":"xià guān bù zhí","abbr":"xgbz","explanation":"对下属官吏不胜任的委婉说法。","source":{"text":"坐罢软不胜任者，不谓罢软，曰下官不职，故贵大臣定有其罪矣，犹未斥然正以呼之也，尚迁就而为之讳也。","book":"汉·贾谊《新书·阶级》"},"example":{"text":"～，灾祸自当，怎忍贻累于百姓！","book":"明·凌濛初《初刻拍案惊奇》卷三十九"}},{"id":1988,"word":"下寨安营","pinyin":"xià zhài ān yíng","abbr":"xzay","explanation":"寨：军营四周的栅栏。指军队驻扎下来。","source":{"text":"下寨安营依三略，赤心敢勇保皇朝。","book":"元·无名氏《黄鹤楼》第二折"},"example":{"text":"此子颇习韬略遁甲之书，学成管乐之谋，～，亦有孙吴之智。","book":"元·李文蔚《破苻坚蒋神灵应》第二折"},"similar":["安营扎寨","安营下寨"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":1989,"word":"下帷攻读","pinyin":"xià wéi gōng dú","abbr":"xwgd","explanation":"下帷：放在室内悬挂的帷幕，表示与外界隔绝。比喻专心读书。","source":{"text":"下帷讲诵，弟子传以久次相授业，或莫见其面。","book":"《汉书·董仲舒传》"},"example":{"text":"但请～，勿问盈歉，或当不殍饿死。","book":"清·蒲松龄《聊斋志异·红玉》"},"usage":"作谓语、定语；用于读书"},{"id":1990,"word":"下情上达","pinyin":"xià qíng shàng dá","abbr":"xqsd","explanation":"谓下面的情况或意见能够通达于上。","source":{"text":"下情不上通，谓之塞。","book":"语出《管子·明法》"},"example":{"text":"可是唐代中叶以后，这个尺度似乎已经暗地里独立运用，这已经不是上德化下的尺度，而是～的尺度了。","book":"朱自清《文学的标准与尺度》"},"similar":["上情下达","政通人和"],"opposite":["下塞上聋"],"usage":"作宾语、定语；用于政务等"},{"id":1991,"word":"下情上通","pinyin":"xià qíng shàng tōng","abbr":"xqst","explanation":"使上面知道下面的情况或意见。","source":{"text":"下情求不上通，谓之寒；下情上而道止，谓之侵。","book":"《管子·明法》"},"example":{"text":"三则自外来者，可询其所以为政与民情风俗之所安，而～，不至壅蔽。","book":"清·毕沅《续资治通鉴》卷一百十一"}},{"id":1992,"word":"下愚不移","pinyin":"xià yú bù yí","abbr":"xyby","explanation":"移：改变。下等的愚人，决不可能有所改变。旧时儒家轻视劳动人民的观点。也指不求上进，不想学好。","source":{"text":"唯上知与下愚不移。","book":"《论语·阳货》"},"example":{"text":"无奈那～的心性，连自己竟忘记了那秀才是别人与他挣的，居之不疑。","book":"清·西周生《醒世姻缘传》第五十回"},"usage":"作谓语、定语；用于书面语"},{"id":1993,"word":"下榻留宾","pinyin":"xià tà liú bīn","abbr":"xtlb","explanation":"下榻：住宿。泛指留下宾客住宿。","source":{"text":"宾至下尘榻，忧来命绿樽。","book":"南朝·梁·沈约《和谢宣城》"},"example":{"text":"诗歌求友，易载同人；知己亲谊重，理合恤患难，～。","book":"清·李百川《绿野仙踪》第十五回"},"similar":["悬榻留宾"],"usage":"作宾语、定语；用于交往等","story":["东汉时期，陈蕃担任豫章太守，他不喜欢留造访的客人过夜，唯独名士徐稚除外。他的公馆内特为徐稚设了一个床，徐稚来访时放下床就可以用，走后就将床吊起来，可见他们的友谊有多深"]},{"id":1994,"word":"下比有余","pinyin":"xià bǐ yǒu yú","abbr":"xbyy","explanation":"下：下等，不足。同不足的相比还绰绰有余。","source":{"text":"将以上方不足，而下比有余。","book":"晋·张华《鹪鹩赋》"}},{"id":1995,"word":"下气怡声","pinyin":"xià qì yí shēng","abbr":"xqys","explanation":"下气：态度恭顺：怡声：声音和悦。形容声音柔和，态度恭顺。","source":{"text":"及所，下气怡声，问衣燠寒。","book":"《礼记·内则》"},"example":{"text":"我走上前去，～提出我的要求，说明我的情况，恳求他们帮忙，能带一带我。","book":"韦君宜《似水流年·乘公路汔车旅行记》"},"similar":["下气怡色"],"usage":"作谓语、定语；形容声音柔和"},{"id":1996,"word":"下气怡色","pinyin":"xià qì yí sè","abbr":"xqys","explanation":"形容气色和悦，态度恭顺。同“下气怡声”。","source":{"text":"父母有过，下气怡色，柔声以谏。","book":"《礼记·内则》"},"example":{"text":"且如孝子事亲，须是～，起敬起孝。","book":"《朱子语类》卷七四"},"similar":["下气怡声"],"usage":"作宾语、状语；用于处事"},{"id":1997,"word":"下水船","pinyin":"xià shuǐ chuán","abbr":"xsc","explanation":"船顺流向下航行。比喻文思敏捷的人。","source":{"text":"裴廷裕，乾宁中在内庭，文书敏捷，号为下水船。","book":"唐·孟郊《留弟郢不得送之江南》：“刚有下水船，白日留不得。”五代·王定保《唐摭言·敏捷》"},"example":{"text":"及第思乡马，张帆～。旋里不落地，弩箭乍离弦。","book":"清·褚人获《隋唐演义》第十五回"}},{"id":1998,"word":"下眼相看","pinyin":"xià yǎn xiāng kàn","abbr":"xyxk","explanation":"指瞧不起人。","source":{"text":"手下人那知言谈好歹，见是樵夫，下眼相看。","book":"明·冯梦龙《警世通言》第一卷"},"similar":["冷眼相看"],"usage":"作谓语、定语；用于处事"},{"id":1999,"word":"下笔不休","pinyin":"xià bǐ bù xiū","abbr":"xbbx","explanation":"原形容动笔写文章思路顺着行文漫延无边，不能紧扣主题适可而止。后多形容文思充沛而敏捷。","source":{"text":"武仲以能属文，为兰台史令，下笔不能自休。","book":"汉·班固《与弟超书》"},"example":{"text":"维唐二臣，一唱一酬；节物感怀，～。","book":"宋·岳珂《宝真斋法书赞》卷二"}},{"id":2000,"word":"下笔便就","pinyin":"xià bǐ biàn jiù","abbr":"xbbj","explanation":"一挥动笔就写成文章。形容写文思敏捷。","source":{"text":"知礼为文赡速，每占授军书，下笔便就，率皆称旨。","book":"《陈书·赵知礼传》"},"example":{"text":"他文思敏捷，～，不立稿草。","book":"孙犁《买〈魏书〉、〈北齐书〉记》"},"similar":["下笔成篇","走笔成文","走笔成章"],"opposite":["江郎才尽"],"usage":"作谓语、定语；用于作文等"},{"id":2001,"word":"下笔千言","pinyin":"xià bǐ qiān yán","abbr":"xbqy","explanation":"千言：长篇大论。形容文思敏捷，写作迅速。","source":{"text":"读书一见若经诵，下笔千言能立成。","book":"宋·曾巩《送丰稷》"},"example":{"text":"你这傻小子如果同女朋友写情书，大概～，倚马可待啦！","book":"唐人《一个万能情报员的经历》"},"similar":["一气呵成","一挥而就"],"opposite":["江郎才尽","才竭智疲"],"usage":"作谓语、定语；形容才思敏捷"},{"id":2002,"word":"下笔千言，离题万里","pinyin":"xià bǐ qiān yán，lí tí wàn lǐ","abbr":"xbqyltwl","explanation":"写了一大篇文章，但没有接触到主题。","source":{"text":"其结果，往往是‘下笔千言，离题万里’，仿佛像个才子，实则到处害人。","book":"毛泽东《反对党八股》"},"example":{"text":"你这是～。"},"similar":["博士买驴"],"usage":"作谓语、宾语、定语；指没有接触到主题"},{"id":2003,"word":"下笔如有神","pinyin":"xià bǐ rú yǒu shén","abbr":"xbrys","explanation":"指写起文章来，文思奔涌，如有神力。形容文思敏捷，善于写文章或文章写得很好。","source":{"text":"读书破万卷，下笔如有神。","book":"唐·杜甫《奉赠韦左丞丈二十二韵》"},"example":{"text":"茅盾《风景谈》：“那又是洋洋洒洒～的，但现在一律都被锄锹的木柄磨起了老茧了。”"},"similar":["下笔如神","下笔有神"],"usage":"作谓语、定语；用于作文等"},{"id":2004,"word":"下笔如神","pinyin":"xià bǐ rú shén","abbr":"xbrs","explanation":"指写起文章来，文思奔涌，如有神力。形容文思敏捷，善于写文章或文章写得很好。","source":{"text":"其于议论应对，明练理体，敷陈剖判，下笔如神，当时名流，无不推挹。","book":"《旧唐书·陆贽传》"},"example":{"text":"清·荻岸山人《平山冷燕》第18回：“见二人～，无不精警，看了十分欢喜。”"},"similar":["下笔有神","下笔如有神"],"usage":"作谓语、定语；用于作文等"},{"id":2005,"word":"下笔成文","pinyin":"xià bǐ chéng wén","abbr":"xbcw","explanation":"一下笔就很快写成文章。形容文思敏捷，才华横溢。","source":{"text":"文若春华，思若涌泉；发言可咏，下笔成篇。","book":"三国·魏·曹植《王仲宣诔》"},"example":{"text":"他文思敏捷，～。"},"similar":["下笔成篇","文思敏捷","出口成章"],"usage":"作谓语；指人才华横溢","story":["三国时期，曹操的小儿子曹植非常聪明，他读过很多书，做文章是又快又好。曹操故意考他，曹操说自己能言出为论、下笔成文，可以当场作文。他们游览完毕铜雀台，曹植很快就写出《铜雀台赋》受到曹操的夸奖"]},{"id":2006,"word":"下笔成章","pinyin":"xià bǐ chéng zhāng","abbr":"xbcz","explanation":"一挥动笔就写成文章。形容写文思敏捷。","source":{"text":"言出为论，下笔成章。","book":"三国魏·曹植《王仲宣诔》：“发言可咏，下笔成篇。”《三国志·魏书·陈思王植传》"},"example":{"text":"这学生天资聪颖，文思敏捷，～，将来未可限量。"},"similar":["出口成章","下笔成篇"],"opposite":["江郎才尽"],"usage":"作谓语、宾语；指人才华横溢","story":["三国时期，曹操的小儿子曹植非常聪明，他读过很多书，做文章是又快又好。曹操故意考他，曹操说自己能言出为论、下笔成章，可以当场作文。他们游览完毕铜雀台，曹植很快就写出《铜雀台赋》，受到曹操及同行的夸奖"]},{"id":2007,"word":"下笔成篇","pinyin":"xià bǐ chéng piān","abbr":"xbcp","explanation":"形容文思敏捷。同“下笔成章”。","source":{"text":"发言可咏，下笔成篇。","book":"三国·魏·曹植《王仲宣谏》"},"example":{"text":"默识若记，～。","book":"晋·左思《悼离赠妹》诗之二"},"similar":["下笔便就","下笔成章","走笔成文"],"opposite":["江郎才尽","搜索枯肠"],"usage":"作谓语、定语；用于作文等"},{"id":2008,"word":"下笔有神","pinyin":"xià bǐ yǒu shén","abbr":"xbys","explanation":"指写起文章来，文思奔涌，如有神力。形容文思敏捷，善于写文章或文章写得很好。","source":{"text":"五际飞文，想群众之不让；一言留赠，知下笔之有神。","book":"唐·王勃《绵州北亭公宴序》"},"example":{"text":"明·范受益《寻亲记·应试》：“劝君此行赴南宫，文场战敌，～，顷刻赋日华五色。”"},"similar":["下笔如有神","下笔如神"],"usage":"作谓语、定语；用于作文等"},{"id":2009,"word":"下笔风雷","pinyin":"xià bǐ fēng léi","abbr":"xbfl","explanation":"形容书法或绘画运笔迅速，气势浩大。","source":{"text":"当其下笔风雷快，笔所未到气已吞。","book":"宋·苏轼《王维吴道子画》"},"example":{"text":"草法入篆法，～掣。一纵而一横，十荡更十决。","book":"清·魏锡曾《奚冈铁生》"}},{"id":2010,"word":"下落不明","pinyin":"xià luò bù míng","abbr":"xlbm","explanation":"下落：着落，去处。指不知道要寻找的人或物在什么地方。","source":{"text":"兵荒马乱，九死一生，想到下落不明的亲人，孤立无援的杭州，以及困在绝境，……","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"他至今～。"},"similar":["不知所终"],"usage":"作谓语、宾语、定语；指失去消息"},{"id":2011,"word":"下车之初","pinyin":"xià chē zī chū","abbr":"xczc","explanation":"下车：旧时指新官到任。旧指新官刚到任。现比喻带着工作任务刚到一个地方。","source":{"text":"武王克殷，反商，未及下车而封黄帝之后于蓟。","book":"《礼记·乐记》"},"example":{"text":"～，未问民事，先令所属知县均认财赋，且多为之数，督责峻急。","book":"清·毕沅《续资治通鉴》卷一百四十五"}},{"id":2012,"word":"下车之始","pinyin":"xià chē zhī shǐ","abbr":"xczs","explanation":"指官吏刚到任所。同“下车伊始”。","source":{"text":"然臣下车之始，与其为约。","book":"《隋书·刘行本传》"},"example":{"text":"学政～，则牒各县令。","book":"清·曾国藩《送江小帆同年视学湖北序》"},"similar":["初来乍到","下车伊始"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":2013,"word":"下车伊始","pinyin":"xià chē yī shǐ","abbr":"xcys","explanation":"伊：文言助词；始：开始。旧指新官刚到任。现比喻带着工作任务刚到一个地方。","source":{"text":"武王克殷，反商，未及下车而封黄帝之后于蓟。","book":"《礼记·乐记》"},"example":{"text":"有许多人～，就这也批评，那也指责，这是很不合适的。"},"similar":["新官上任","新来乍到","下车之始"],"opposite":["久居此地"],"usage":"作谓语、状语；指新官刚到任","story":["商朝末年，周武王姬昌率军攻打商军，占领商朝的首都朝歌，灭了商朝。周武王在进城的车上迅速分封诸侯，封黄帝后代于蓟，封舜帝后代于陈，封夏禹的后代于杞，有利于社会的稳定，被封的官员都是坐驿车去上任，于是文告中用下车伊始指刚上任"]},{"id":2014,"word":"下车作威","pinyin":"xià chē zuò wēi","abbr":"xczw","explanation":"原指封建时代官吏一到任，就显示威风，严办下属。后泛指一开头就向对方显示一点厉害。","source":{"text":"定襄闻伯素贵，年少，自请治剧，畏其下车作威，吏民竦息。","book":"《汉书·序传》"},"similar":["下马威"],"usage":"作谓语；指下马威"},{"id":2015,"word":"下车冯妇","pinyin":"xià chē féng fù","abbr":"xcff","explanation":"冯妇下车来，重新干捉虎的事。比喻重操旧业的人。","source":{"text":"晋人有冯者，善搏虎，卒为善士。则之野，有从逐虎。虎负嵎，莫之敢撄。望见冯妇，趋而迎之。冯妇攘而下车，众皆悦之，其为士者笑之。","book":"《孟子·尽心下》"},"example":{"text":"还仗天祖之灵，才幸而作了个失马塞翁，如今要再去学那～，也就似乎大可不必了。","book":"清·文康《儿女英雄传》第三十三回"}},{"id":2016,"word":"下车未几","pinyin":"xià chē wèi jǐ","abbr":"xcwj","explanation":"下车：旧时指新官到任。旧指新官刚到任。现比喻带着工作任务刚到一个地方。","source":{"text":"武王克殷，反商，未及下车而封黄帝之后于蓟。","book":"《礼记·乐记》"},"example":{"text":"俨～，令行禁止，称为良牧。","book":"《旧唐书·蒋俨传》"}},{"id":2017,"word":"下车泣罪","pinyin":"xià chē qì zuì","abbr":"xcqz","explanation":"罪：指罪犯。下车向遇见的罪犯流泪。旧时称君主对人民表示关切。","source":{"text":"禹出见罪人，下车问而泣之。","book":"汉·刘向《说苑·君道》"},"example":{"text":"幸圣主留善贷之德，纡好生之施，解网祝禽，～。","book":"《梁书·王僧孺传》"},"usage":"作谓语、定语；用于统治者","story":["传说禹统治时期，禹乘车出外巡视，见到有犯人被押走过，禹下车问他犯了什么罪，对方说偷了人家的稻谷。禹听了流下眼泪。随从不解，禹说老百姓不能与他同心同德，做出损人利己的事来，是他的责任。命人刻“百姓有罪，在予一人”石"]},{"id":2018,"word":"下逐客令","pinyin":"xià zhú kè lìng","abbr":"xzkl","explanation":"秦始皇曾下过逐客令，要驱逐从各国来的客卿。泛指主人赶走不受欢迎的客人。","source":{"text":"马老先生看出伊牧师是已下逐客令，心里十二分不高兴的站起来。","book":"老舍《二马》"},"example":{"text":"我只好～了。"},"opposite":["投辖留宾"],"usage":"作谓语、宾语；指把客人赶走"},{"id":2019,"word":"下里巴人","pinyin":"xià lǐ bā rén","abbr":"xlbr","explanation":"原指战国时代楚国民间流行的一种歌曲。比喻通俗的文学艺术。","source":{"text":"客有歌于郢中者，其始曰：‘下里巴人’，国中属而和者数千人。","book":"战国·楚·宋玉《对楚王问》"},"example":{"text":"及见了戏，却也有些意外开豁。谭、娄纯正儒者，那得动意于～。","book":"清·李绿园《歧路灯》第十回"},"similar":["通俗易懂","下里巴音","巴人下里"],"opposite":["阳春白雪"],"usage":"作主语、宾语、定语；指通俗艺术"},{"id":2020,"word":"下里巴音","pinyin":"xià lǐ bā yīn","abbr":"xlby","explanation":"下里：乡里；巴：古国名，在今川东一带。原指战国时代楚国民间流行的一种歌曲。比喻通俗的文学艺术。","example":{"text":"～的说法很少见。"},"similar":["下里巴人","巴人下里"],"usage":"作主语、宾语、定语；指通俗艺术"},{"id":2021,"word":"下阪走丸","pinyin":"xià bǎn zǒu wán","abbr":"xbzw","explanation":"阪：斜坡；丸：弹丸。在斜坡上往下滚弹丸。比喻说话敏捷流利。","source":{"text":"张九龄善谈论，每与宾客议论经旨，滔滔不竭，如下阪走丸也。","book":"五代·王仁裕《开元天宝遗事·走丸之辩》"}},{"id":2022,"word":"下陵上替","pinyin":"xià líng shàng tì","abbr":"xlst","explanation":"在下者凌驾于上，在上者废弛无所作为。谓上下失序，纲纪废坠。陵，通“凌”。","source":{"text":"于是乎下陵上替，能无乱乎？","book":"《左传·昭公十八年》"},"example":{"text":"～，虽令不从，此其效也。","book":"明·刘基《春秋明经·城费叔弓帅师围费》"},"usage":"作谓语、定语；用于书面语"},{"id":2023,"word":"下马作威","pinyin":"xià mǎ zuò wēi","abbr":"xmzw","explanation":"指官吏到任故意用严法处理下属树立威风。泛指先给对方一点厉害。","source":{"text":"定襄闻伯素贵，年少，自请治郡，畏其下马作威，吏民竦息。","book":"东汉·班固《汉书·叙传》"},"example":{"text":"他习惯～，先烧三把火。"},"similar":["下马威"],"usage":"作谓语、定语、宾语；指新官上任","story":["西汉时期，豪门贵族少年班伯主动请缨到混乱的定襄去做太守。他刚到任，当地的豪绅大姓把以前的犯事的人全都藏匿起来。而班伯一上任就大肆宴请豪绅大姓，与他们交朋友，待了解犯事的人藏身之处后立即下令捕杀，定襄很快就安定了"]},{"id":2024,"word":"下马冯妇","pinyin":"xià mǎ féng fù","abbr":"xmff","explanation":"以之比喻重操旧业的人。","source":{"text":"晋人有冯妇者，善搏虎，卒为善士；则之野，有众逐虎，虎负禺，莫之敢攖；望见冯妇，趋而迎之，冯妇攘臂下车，众皆悦之，其为士者笑之。","book":"《孟子·尽心上》"},"example":{"text":"还仗天祖之灵，才幸而作了个“失马塞公”，如今要再去学那“～”，也就似乎大可不必了！","book":"《儿女英雄传》第三三回"},"similar":["再作冯妇"],"usage":"作宾语、定语；用于书面语","story":["战国时期，晋国勇士冯妇敢赤手空拳打老虎，后来他宣布再也不打老虎从此专心读书。一天他与朋友去郊外玩，看见很多人在围攻一只老虎，但不敢上前。冯妇走上前去抓住老虎一摔就把老虎摔死了，他的朋友说：“你又重操旧业了。”"]},{"id":2025,"word":"下马威","pinyin":"xià mǎ wēi","abbr":"xmw","explanation":"原指官吏初到任时对下属显示的威风，后泛指一开始就向对方显示自己的威力。","source":{"text":"畏其下车作威，吏民竦息。","book":"《汉书·叙传》"},"example":{"text":"取家法过来，待我赏他个～。","book":"清·李渔《蜃中楼·抗姻》"},"similar":["下马作威","下车作威"],"usage":"作宾语；指灭人威风","story":["西汉时期，豪门贵族少年班伯主动请缨到混乱的定襄去做太守。他刚到任，当地的豪绅大姓把以前的犯事的人全都藏匿起来。而班伯一上任就大肆宴请豪绅大姓，与他们交朋友，待了解犯事的人藏身之处后立即下令捕杀，定襄很快就安定了"]},{"id":2026,"word":"下马看花","pinyin":"xià mǎ kàn huā","abbr":"xmkh","explanation":"比喻停下来，深入实际，认真调查研究。","source":{"text":"春风得意马蹄疾，一日看尽长安花。","book":"唐·孟郊《登科后》"},"example":{"text":"另外一些人可以在工厂农村里住几个月，在那里作调查，交朋友，这叫‘～’。","book":"毛泽东《在中国共产党全国宣传工作会议上的讲话》"},"similar":["脚踏实地"],"opposite":["走马观花","蜻蜓点水"],"usage":"作谓语、宾语、定语；形容工作认真"},{"id":2027,"word":"不一其人","pinyin":"bù yī qí rén","abbr":"byqr","explanation":"那样的人不止一个。","source":{"text":"古英雄不得志，辄以醇酒妇人为结局者，不一其人。","book":"清·钱泳《履园丛话》卷八"}},{"id":2028,"word":"不一而足","pinyin":"bù yī ér zú","abbr":"byez","explanation":"足：充足。指同类的事物不只一个而是很多，无法列举齐全。","source":{"text":"始有大夫，则何以不氏？许夷狄者，不一而足也。","book":"《公羊传·文公九年》"},"example":{"text":"两边摆地摊，售卖农家器具及乡下日用物件的，～。","book":"清·刘鹗《老残游记》第十一回"},"similar":["层出不穷","不壹而足"],"opposite":["屈指可数","寥寥无几"],"usage":"作谓语、分句；用于句尾","story":["元朝时期，乐善好施的施济资助桂富五300两银子，让他赎回妻子与孩子，同时给他十亩田地。桂富五在地里挖出1500两银子偷偷到绍兴过好日子。施济去世后家道衰落。好友支德要施还母子去找那个不一而足的桂富五。可他对过去的恩人后代置之不理"]},{"id":2029,"word":"不三不四","pinyin":"bù sān bù sì","abbr":"bsbs","explanation":"指不正派，也指不象样子。","source":{"text":"这伙人不三不四，又不肯近前来，莫不要攧洒家。","book":"明·施耐庵《水浒全传》第七回"},"example":{"text":"也该撒泡尿自己照照！～，就想天鹅屁吃！","book":"清·吴敬梓《儒林外史》第三回"},"similar":["不伦不类","非僧非俗"],"opposite":["一本正经","正襟危坐","堂堂正正"],"usage":"作谓语、定语、状语；形容人的品行不好","story":["梁山泊好汉鲁智深因救卖唱父女而拳打镇关西命案，被迫削发为僧，他到大相国寺去管理被地痞流氓霸占的菜园。这帮不三不四的人想方设法给鲁智深一个下马威，逼他离开，正设计围攻他，没想到鲁智深把他们全打入粪坑里求饶"]},{"id":2030,"word":"不上不下","pinyin":"bù shàng bù xià","abbr":"bsbx","explanation":"上不去，下不来。形容进退两难。","source":{"text":"上而不下，则使人善怒；下而不上，则使人善忘；不上不下，中身当心，则为病。","book":"《庄子·达生》"},"example":{"text":"我却总是既不安乐，也不灭亡地～地生活下来，都不能副任何一面的期望。","book":"鲁迅《死后》"},"similar":["进退两难","进退维谷"],"opposite":["登峰造极"],"usage":"作谓语、定语、补语；形容不好不坏"},{"id":2031,"word":"不上不落","pinyin":"bù shàng bù luò","abbr":"bsbl","explanation":"形容事情无着落，处境为难。","source":{"text":"姐姐……何苦把这个书生哄得他不上不落的，呆呆地百事皆废了。","book":"《二刻拍案惊奇》卷九"},"similar":["不上不下","进退两难"],"usage":"作谓语、定语、状语；用于事情"},{"id":2032,"word":"不世","pinyin":"bu shi","abbr":"bs","explanation":"一世所无，意即极不平凡、非常了不起。"},{"id":2033,"word":"不世之业","pinyin":"bù shì zhī yè","abbr":"bszy","explanation":"不世：非常、非凡。稀世罕有的功业。","source":{"text":"宗兄威行海外，文武忠良成救驾之功，建不世之业。","book":"明·陈忱《水浒后传》第四十回"},"example":{"text":"若变起，足下以一军敌彼二军，保护圣主，复大权，清君侧，肃宫廷，指挥若定，～也。","book":"梁启超《戊戌政变记·谭嗣同传》"},"similar":["不世之功"],"usage":"作宾语；指极大的业绩"},{"id":2034,"word":"不世之仇","pinyin":"bù shì zhī chóu","abbr":"bszc","explanation":"不世：非凡。指极大的仇恨","source":{"text":"这武三思贼子，他杀我一门家口，乃不世之仇，今日狭路相逢，岂可轻轻放过！","book":"清·如莲居士《薛刚反唐》第70回"},"similar":["血海深仇","不共戴天"],"usage":"作宾语；指极大的仇恨"},{"id":2035,"word":"不世之功","pinyin":"bù shì zhī gōng","abbr":"bszg","explanation":"不世：不是每代都有的，即非常、非凡。形容功劳极大。","source":{"text":"足下将建伊吕之业，弘不世之功。","book":"《后汉书·隗嚣传》"},"example":{"text":"大丈夫生于乱世，当带三尺剑立～。","book":"明·罗贯中《三国演义》第五十三回"},"similar":["盖世之功"],"usage":"作宾语；指极大的功劳"},{"id":2036,"word":"不世之材","pinyin":"bù shì zhī cái","abbr":"bszc","explanation":"不世：少有的，非常的。当世少有的人才。","source":{"text":"于公身居方伯之尊，蓄不世之材，而能与卑鄙庸陋相应答如影响。","book":"唐·韩愈《送许郢州序》"}},{"id":2037,"word":"不世之略","pinyin":"bù shì zhī lüè","abbr":"bszl","explanation":"不世：不是每代都有的，即非常、非凡；略：谋略。人间不常有的谋略。","source":{"text":"今天子蒙尘，将军诚因此时首倡义兵，奉天子以从众望，不世之略也。","book":"明·罗贯中《三国演义》第十四回"},"usage":"作宾语；用于夸奖等"},{"id":2038,"word":"不丧匕鬯","pinyin":"bù sàng bǐ chàng","abbr":"bsbc","explanation":"匕、鬯，祭祀宗庙用物，借指宗庙祭祀。古代形容军纪严明，百姓安堵，不废宗庙祭祀。","source":{"text":"雷发声，闻于百里，古者诸侯之象。诸侯之教令，能警戒其国内，则守其宗庙社稷，为之祭主，不亡匕与鬯也。","book":"《易·震》：“震惊百里，不丧匕鬯。”孙星衍集解引郑玄曰"},"example":{"text":"袁公之威望，与其旧部将士之忠义，方清摄政王解职，及清帝退位，至危逼之时期，尚能镇摄全京，～。","book":"中国近代史资料丛刊《辛亥革命·蔡专使元培代表布告全国文》"},"similar":["秋毫无犯"],"usage":"作谓语；用于纪律等"},{"id":2039,"word":"不丰不俭","pinyin":"bù fēng bù jiǎn","abbr":"bfbj","explanation":"指不奢不俭，多少合宜。","source":{"text":"见“不丰不杀”。"},"example":{"text":"（老爷）然后过这边来看了看，办得～，一切合宜，老爷颇为欢喜。","book":"《儿女英雄传》第二三回"},"similar":["不丰不杀"],"opposite":["铺张浪费"],"usage":"作谓语、定语、状语；指刚好合适"},{"id":2040,"word":"不丰不杀","pinyin":"bù fēng bù shā","abbr":"bfbs","explanation":"丰：厚；杀：减少。不奢侈也不啬俭。不增加也不减少。","source":{"text":"礼不同，不丰不杀。","book":"《礼记·礼器》"},"example":{"text":"“宫门费”～，按股匀分，倒也相安无事。","book":"高阳《胭脂井》"},"similar":["不多不少"],"usage":"作谓语；形容不多不少正合适"},{"id":2041,"word":"不为五斗米折腰","pinyin":"bù wèi wǔ dǒu mǐ zhé yāo","abbr":"bwwdmzy","explanation":"五斗米：晋代县令的俸禄，后指微薄的俸禄；折腰：弯腰行礼，指屈身于人。比喻为人清高，有骨气，不为利禄所动。","source":{"text":"吾不能为五斗米折腰，拳拳事乡里小人邪。","book":"《晋书·陶潜传》"},"example":{"text":"古人～，这个助教官儿，也不是我终身养老之事。","book":"明·冯梦龙《喻世明言》卷五"},"similar":["不为斗米折腰"],"opposite":["趋炎附势"],"usage":"作谓语、定语；形容人有骨气","story":["晋朝时陶潜（字渊明）先后做过几次官，因当时吏治非常腐败，他不愿同流合污，更不愿为五斗米官俸而自取屈辱，就辞官归隐。他隐居山涧，穿粗麻布衣，自己劳作，晚年贫病交加，江州刺史檀道济请他去做官，他婉言拒绝"]},{"id":2042,"word":"不为已甚","pinyin":"bù wéi yǐ shèn","abbr":"bwys","explanation":"已甚：过分。不做得太过分。多指对人的责备或处罚适可而止。","source":{"text":"仲尼不为已甚者。","book":"《孟子·离娄下》"},"example":{"text":"那家人听了，倒道南令本～，不过大吏过严罢了。","book":"清·黄小配《廿载繁华梦》第三十六回"},"similar":["适可而止"],"usage":"作谓语；比喻不要太过分"},{"id":2043,"word":"不为戎首","pinyin":"bù wéi róng shǒu","abbr":"bwrs","explanation":"戎首：率兵攻打别人的带头者。不做攻打别人的带头人。","source":{"text":"毋为戎首，不亦善首。","book":"《礼记·檀弓》"}},{"id":2044,"word":"不为福先，不为祸始","pinyin":"bù wéi fú xiān，bù wéi huò shǐ","abbr":"bwfxbwhs","explanation":"先：先驱者，带头人；始：创始者。不做为人民造福的先驱者，也不做祸害人类的创始人。","source":{"text":"不为福先，不为祸始，感而后应，迫而后动，不得已而后起。","book":"《庄了·刻意》"}},{"id":2045,"word":"不主故常","pinyin":"bù zhǔ gù cháng","abbr":"bzgc","explanation":"故常：旧的常规、习惯。不拘于老的一套。","source":{"text":"其声能短能长，能柔能刚，变化齐一，不主故常。","book":"《庄子·天运》"},"example":{"text":"而其盘盘之气，熊熊之光，浏漓顿挫，～。","book":"清·莫友芝《巢经巢诗钞序》"},"opposite":["墨守成规"],"usage":"作谓语；形容不墨守成规"},{"id":2046,"word":"不义之财","pinyin":"bù yì zhī cái","abbr":"byzc","explanation":"不义：不正当，不合理。不应该得到的或以不正当的手段获得的钱财。","source":{"text":"不义之财，非吾有也，不孝之子，非吾子也。","book":"汉·刘向《列女传·齐田稷母传》"},"example":{"text":"这～，犬豕不顾，谁人要你的！","book":"明·冯梦龙《古今小说》第二十二卷"},"similar":["民脂民膏","坐地分赃","不劳而获"],"opposite":["劳动致富","不谋私利"],"usage":"作主语、宾语；指来源不正当的钱财","story":["古代齐国宰相田稷子把下官送给他的一些黄金孝敬给母亲，母亲觉得奇观问他做了三年宰相就有这么多俸禄，难道就没有开销了？田稷子只好如实回答，其母告诫他作为士大夫应该修身养性，不能贪这些不义之财。田稷子立即把黄金一一退回"]},{"id":2047,"word":"不乏先例","pinyin":"bù fá xiān lì","abbr":"bfxl","explanation":"有不少从前的事可以作为例子。","source":{"text":"明末起义首领中一向重视养子，而且以养子继承皇位的事在五代不乏先例。","book":"姚雪垠《李自成》第四卷第十四章"},"example":{"text":"这样的事情在古代已经～了。"},"similar":["司空见惯"],"opposite":["空前绝后"],"usage":"作谓语；用于口语"},{"id":2048,"word":"不乏其人","pinyin":"bù fá qí rén","abbr":"bfqr","explanation":"乏：缺少；其：那，那些。那样的人并不少。","source":{"text":"然则如今之篯侯，远近不乏其人。","book":"清·吕留良《与陈执斋书》"},"example":{"text":"但这种意见，恐怕是怀抱者～，而且由来已久的，不过大抵不敢毅然删改，笔之于书。","book":"鲁迅《朝花夕拾·后记》"},"similar":["触目皆是","比比皆是","大有人在"],"opposite":["屈指可数","寥寥无几"],"usage":"作谓语；与“大有人在”同义"},{"id":2049,"word":"不习地土","pinyin":"bù xí dì tǔ","abbr":"bxdt","explanation":"对于一个地方的气候条件或饮食习惯不能适应。","source":{"text":"宋弁曰：‘当是不习地土。’","book":"《南史·王融传》"},"similar":["不习水土"],"usage":"作谓语、定语；同“不服水土”"},{"id":2050,"word":"不习水土","pinyin":"bù xí shuǐ tǔ","abbr":"bxst","explanation":"对于一个地方的气候条件或饮食习惯不能适应。","source":{"text":"驱中国士众远涉江湖之间，不习水土，必生疾病。","book":"晋·陈寿《三国志·吴志·周瑜传》"},"example":{"text":"他来到南方，有些～。"},"similar":["不服水土","不习地土"],"usage":"作谓语；同“不服水土”"},{"id":2051,"word":"不了不当","pinyin":"bù liǎo bù dàng","abbr":"blbd","explanation":"犹言拖泥带水，没有了结。","source":{"text":"这老人忒没正经……知道五年十年在世，却去干这样不了不当的事！","book":"《古今小说·滕大尹鬼断家私》"},"similar":["拖泥带水"],"usage":"作谓语、定语；用于处事"},{"id":2052,"word":"不了了之","pinyin":"bù liǎo liǎo zhī","abbr":"bllz","explanation":"了：了结，结束。用不了结的办法去了结。指把事情放在一边不管，就算完事。","source":{"text":"唐人言冬烘是不了了之语，故有‘主司头脑太冬烘，错认颜标是鲁公’之言。人以为戏谈。","book":"宋·叶少蕴《避暑录话》卷上"},"example":{"text":"刚才的争论就这样～。","book":"叶圣陶《小病》"},"similar":["束之高阁","置之不理"],"opposite":["一了百了"],"usage":"作谓语、定语；用于处理问题拖拉"},{"id":2053,"word":"不了而了","pinyin":"bù liǎo ér liǎo","abbr":"blel","explanation":"犹不了了之。","source":{"text":"我们这次赌赛，就此不了而了。","book":"茅盾《子夜》二"},"similar":["不了了之"],"usage":"作谓语、定语；用于处事"},{"id":2054,"word":"不事城府","pinyin":"bù shì chéng fǔ","abbr":"bscf","explanation":"城府：城市和官署，指难以揣度的心机。比喻胸怀坦荡，无所隐藏。","source":{"text":"与人则倾肺肝，不事城府，损财则等泥沙。","book":"宋·袁甫《跋慈湖先生广君赋》"}},{"id":2055,"word":"不事边幅","pinyin":"bù shì biān fú","abbr":"bsbf","explanation":"指不修边幅。","source":{"text":"罴性俭率，不事边幅。","book":"《北史·王罴传》"},"example":{"text":"先生明睿天授，然和乐坦易，～。","book":"明·徐爱《序》"},"similar":["不修边幅","不事修饰"],"usage":"作谓语、定语；用于人的性格等"},{"id":2056,"word":"不二之老","pinyin":"bù èr zhī lǎo","abbr":"bezl","explanation":"不二：不生二心，一心一意；老：老人。指一心一意，忠心耿耿的老人或元老。","source":{"text":"朝寡纯德之士，乡乏不二之老。","book":"晋·干宝《晋纪总论》"}},{"id":2057,"word":"不二法门","pinyin":"bù èr fǎ mén","abbr":"befm","explanation":"不二：指不是两极端；法门：佧行入道的门径。原为佛家语，意为直接入道，不可言传的法门。后比喻最好的或独一无二的方法。","source":{"text":"如我意者，于一切法无言无说，无示无识，离诸问答，是为入不二法门。","book":"《维摩诘经·入不二法门品》"},"example":{"text":"历观战史，水战用火攻，是颠扑不破的～。","book":"高阳《清宫外史》下册"},"similar":["必由之路","独一无二"],"opposite":["歪门邪道","左道旁门"],"usage":"作主语、宾语；形容独一无二的方法"},{"id":2058,"word":"不二门","pinyin":"bù èr mén","abbr":"bem","explanation":"指平等而无差异之至道或独一无二的门径、方法。","source":{"text":"是法修行遍，方栖不二门。","book":"姚合《寄不疑上人》"},"similar":["不二法门"],"usage":"作宾语；用于书面语"},{"id":2059,"word":"不亡何待","pinyin":"bù wáng hé dài","abbr":"bwhd","explanation":"不灭亡还能等待什么。即必然灭亡。","source":{"text":"民弃其上，不亡何待？","book":"《左传·昭公二十三年》"},"example":{"text":"病入膏肓，而不可救，～哉。","book":"《明史·流贼传序》"}},{"id":2060,"word":"不亢不卑","pinyin":"bù kàng bù bēi","abbr":"bkbb","explanation":"亢：高傲；卑：低、自卑。指对人有恰当的分寸，既不低声下气，也不傲慢自大。","source":{"text":"圣贤自有中正之道，不亢不卑，不骄不诌，何得如此也！","book":"明·朱之瑜《答小宅生顺书十九首》"},"example":{"text":"他这远愁近虑，～，他们奶奶就不是和咱们好，听他这一番话，也必要自愧的变好了。","book":"清·曹雪芹《红楼梦》第五十六回"},"similar":["不骄不躁","不卑不亢"],"opposite":["骄傲自大"],"usage":"作谓语、定语；形容为人处事有分寸","story":["春秋末年齐国宰相晏婴奉命出使楚国，楚王百般刁难他，先是让他从小门进城，然后说他是矮子，用最差的饭菜招待他，最后用两个齐国囚犯来羞辱他，均被他的不卑不亢的态度及高超的外交才能所折服，结果楚王自取其辱"]},{"id":2061,"word":"不亦乐乎","pinyin":"bù yì lè hū","abbr":"bylh","explanation":"乎：文言中用为疑问或反问的语气助词，这里相当于“吗”。用来表示极度、非常、淋漓尽致地意思。","source":{"text":"有朋自远方来，不亦乐乎？","book":"《论语·学而》"},"example":{"text":"哎，那骂得可真也是～。","book":"郭沫若《屈原》第五幕"},"similar":["不可开交","淋漓尽致"],"usage":"作谓语、状语；形容动作、状态到了极端地步"},{"id":2062,"word":"不亦善夫","pinyin":"bù yi shàn fū","abbr":"bysf","explanation":"不也很好吗！","source":{"text":"问者嘻曰:‘不亦善夫！吾问养树，得养人术。’传其事以为官戒也。","book":"唐·柳宗元《种树郭橐驼传》"}},{"id":2063,"word":"不仁不义","pinyin":"bù rén bù yì","abbr":"brby","explanation":"仁：仁爱；义：道义。不讲仁德，不讲道义。形容品性卑劣、残忍。","source":{"text":"害人与穿窬，因为不仁不义。","book":"宋·朱熹《朱子语类·大学三》"},"example":{"text":"窥若辈之倒行逆施，是直欲陷吾元首于～之中。","book":"蔡东藩、许廑父《民国通俗演义》第四十五回"},"similar":["无情无义"],"opposite":["仁至义尽"],"usage":"作谓语、宾语、定语；指不讲仁德"},{"id":2064,"word":"不仁之器","pinyin":"bù rén zhī qì","abbr":"brzq","explanation":"不仁：残暴，残忍；器：兵器。指用以杀人的武器。","source":{"text":"援之以不仁之器。","book":"宋·苏洵《上韩枢密书》"}},{"id":2065,"word":"不仁起富","pinyin":"bù rén qǐ fù","abbr":"brqf","explanation":"怀着坏心肠创立富业。指心狠手辣，不择手段地图谋发家致富。","source":{"text":"邢大将者，保州人，居近塞，以不仁起富。","book":"宋·洪迈《夷坚志·乙志·邢大将》"}},{"id":2066,"word":"不今不古","pinyin":"bù jīn bù gǔ","abbr":"bjbg","explanation":"指事物不正常，古代现代都不曾有过。原讥讽人学无所得却故作诡异。后常比喻折衷。","source":{"text":"童牛角马，不今不古。","book":"汉·扬雄《太玄经·更》"},"example":{"text":"又刻一诏，更寥寥数语，～。","book":"明·沈德符《万历野获编·考官争席》"},"similar":["不伦不类"],"usage":"作谓语、定语；形容古今都找不到的人或物"},{"id":2067,"word":"不令而信","pinyin":"bù lìng ér xìn","abbr":"blex","explanation":"令：命令；信：信服。不用三令五申能使之遵守服从。","source":{"text":"不约而亲，不令而信。","book":"春秋·齐·孙武《孙子·九地》"},"usage":"作谓语、定语；用于政策等"},{"id":2068,"word":"不以一眚掩大德","pinyin":"bù yǐ yī shěng yǎn dà dé","abbr":"byysydd","explanation":"以：因；眚：过失，错误；掩：遮蔽，遮盖；德：德行。不因为一个人有个别的错误而抹杀他的大功绩。","source":{"text":"且吾不以一眚掩大德。","book":"《左传·僖公三十年》"},"usage":"作谓语；指客观看待一个人","story":["春秋时期，秦穆公不听蹇叔的劝告，派孟明视等三位大夫带兵进攻郑国，由于计划败露只好改进攻滑国，路上遭到晋军的袭击，全军覆没。晋襄公答应母后的请求，放三位大夫回国。秦穆公身着丧服，他不以一眚掩大德，亲自到边境去迎接他们"]},{"id":2069,"word":"不以为奇","pinyin":"bù yǐ wéi qí","abbr":"bywq","explanation":"并不觉得奇怪。表示这是见惯了的。","source":{"text":"而且老太太时常提问案件，大家亦都见惯，不以为奇。","book":"清·李宝嘉《官场现形记》第23回"},"example":{"text":"吴少奶奶是看惯她妹子的憨态的，也就～，兀自捧着一杯茶在那里出神。","book":"茅盾《子夜》十八"},"similar":["司空见惯","不足为奇","习以为常"],"opposite":["稀奇古怪"],"usage":"作谓语；指不认为是奇特的事物"},{"id":2070,"word":"不以为意","pinyin":"bù yǐ wéi yì","abbr":"bywy","explanation":"不把它放在心上。表示对人、对事抱轻视态度。","source":{"text":"临淄官徒有在京邑，闻怀砖慕势，咸共耻之，唯崔孝忠一人不以为意。","book":"《三国志·吴书·陆凯传》：“定大恨凯，思中伤之，凯终不以为意，乃心公家，义形于色，表疏皆指事不饰，忠恳内发。”北魏·杨衒之《洛阳伽蓝记·秦太上君寺》"},"example":{"text":"管亥望见救军来到，亲自引兵迎敌；因见玄德兵少，～。","book":"明·罗贯中《三国演义》第十一回"},"similar":["漠不关心"],"usage":"作谓语；形容不在意"},{"id":2071,"word":"不以为然","pinyin":"bù yǐ wéi rán","abbr":"bywr","explanation":"然：是，对。不认为是对的。表示不同意或否定。","source":{"text":"右臣先曾奏论前衙一役，只当招募，不当定差，执政不以为然。","book":"宋·苏轼《再乞罢详定役法状》"},"example":{"text":"听他说洋人不是，口虽不言，心下却老大～。","book":"清·李宝嘉《官场现形记》"},"similar":["嗤之以鼻","不敢苟同","满不在乎"],"opposite":["五体投地","仰承鼻息"],"usage":"作谓语、定语、状语；含轻蔑意味"},{"id":2072,"word":"不以为耻","pinyin":"bù yǐ wéi chǐ","abbr":"bywc","explanation":"不认为是可耻的。指不知羞耻。","source":{"text":"今墨劓不以为耻，斯民所以乱多治少也。","book":"《邓析子·转辞》"},"example":{"text":"对于自己的历史一点不懂，或懂得甚少，～，反以为荣。","book":"毛泽东《改造我们的学习》"},"similar":["恬不知耻","厚颜无耻","寡廉鲜耻"],"opposite":["襟怀坦白","光明正大","光明磊落"],"usage":"作谓语、定语；形容不以为羞耻"},{"id":2073,"word":"不以为耻，反以为荣","pinyin":"bù yǐ wéi chǐ，fǎn yǐ wéi róng","abbr":"bywcfywr","explanation":"不认为是耻辱，反而以为是光荣的。","source":{"text":"毛泽东《改造我们的学习》：“对于自己的历史一点不懂，或懂得甚少，不以为耻，反以为荣。 ”。"},"similar":["不以为耻"],"usage":"作谓语、定语；用于处事"},{"id":2074,"word":"不以人废言","pinyin":"bù yǐ rén fèi yán","abbr":"byrfy","explanation":"废：废弃。不因为这个人有不足的地方而不采纳他的正确意见。","source":{"text":"君子不以言举人，不以人废言。","book":"春秋·鲁·孔丘《论语·卫灵公》"},"example":{"text":"观者～可也。","book":"清·黄子云《野鸿诗的·90》"},"usage":"作谓语；指客观看待问题"},{"id":2075,"word":"不以介怀","pinyin":"bù yǐ jiè huái","abbr":"byjh","explanation":"介：留存，搁置；介怀：放在心上。对不愉快或不满意的事，一点也不放在心上。","source":{"text":"于是生资皆尽，不以介怀。","book":"《南史·张盾传》"}},{"id":2076,"word":"不以成败论英雄","pinyin":"bù yǐ chéng bài lùn yīng xióng","abbr":"bycblyx","explanation":"不能因事业的成功功失败来判断是不是英雄。"},{"id":2077,"word":"不以规矩，不成方圆","pinyin":"bù yǐ guī jǔ，bù chéng fāng yuán","abbr":"bygjbcfy","explanation":"规：圆规；矩：曲尺。比喻做事要遵循一定的法则。","source":{"text":"离娄之明，公输子之巧，不以规矩，不成方圆。","book":"战国·邹·孟轲《孟子·离娄上》"},"usage":"作谓语、分句；比喻做事要遵循一定的法则"},{"id":2078,"word":"不以规矩，不能成方圆","pinyin":"bù yǐ guī jǔ，bù néng chéng fāng yuán","abbr":"bygjbncfy","explanation":"比喻做事要遵循一定的法则。","source":{"text":"离娄之明，公输子之巧，不以规矩，不能成方圆。","book":"《孟子·离娄上》"}},{"id":2079,"word":"不以词害意","pinyin":"bù yǐ cí hài yì","abbr":"bychy","explanation":"不因为只顾文辞而损害了对内容的理解。指写文章不要只追求修辞而忽略文章的立意。","source":{"text":"词句究竟还是末事，第一是立意要紧，若意趣真了，连词句不用修饰，自是好的；这叫做‘不以词害意’。","book":"清·曹雪芹《红楼梦》第48回"},"similar":["不以辞害志"],"usage":"作谓语、宾语；用于文章"},{"id":2080,"word":"不以辞害志","pinyin":"bù yǐ cí hài zhì","abbr":"bychz","explanation":"辞：文辞；志：作品的思想内容。原意是不因为只顾文辞而损害了对内容的理解。后也指写文章不要只追求修辞而忽略文章的立意。","source":{"text":"故说《诗》者不以文害辞，不以辞害志。","book":"《孟子·万章上》"},"similar":["不以词害志"],"usage":"作谓语；用于文章"},{"id":2081,"word":"不伏水土","pinyin":"bù fú shuǐ tǔ","abbr":"bfst","explanation":"不能适应移居地方的气候和饮食习惯。同“不服水土”。","source":{"text":"比者所发诸道南讨兵马，例皆不谙山川、不伏水土，远乡羁旅，疾疫杀伤。","book":"唐·韩愈《黄家贼事宜状》"},"example":{"text":"明·施耐庵《水浒传》第78回：“明日只奏道天气暑热，军士～，权且罢战退兵。”"},"similar":["不服水土"],"usage":"作谓语、定语；指不适应异地气候与饮食等"},{"id":2082,"word":"不伏烧埋","pinyin":"bù fú shāo mái","abbr":"bfsm","explanation":"伏：屈服；烧埋：烧埋银钱，旧时官府向杀人犯追缴赔给死者家属的埋葬费。比喻不伏罪或不听劝解。","source":{"text":"休道你兄弟不伏烧埋，由你便直打到梨花月上来。","book":"元·康进之《地逵负棘》第四折"},"example":{"text":"我又不敢当厅抵赖，恰待分说，又道咱家～。","book":"《元曲选·争报恩》二"},"similar":["自以为是"],"usage":"作谓语；形容自以为是与自高自大的样子"},{"id":2083,"word":"不伤脾胃","pinyin":"bù shāng pí wèi","abbr":"bspw","explanation":"比喻无关痛痒。","source":{"text":"骂几句不伤脾胃。","book":"茅盾《子夜》十六"},"example":{"text":"茅盾《子夜》：“骂几句～。”"},"similar":["不伤大体"],"opposite":["至关重要"],"usage":"作谓语、定语；指无关紧要"},{"id":2084,"word":"不伦不类","pinyin":"bù lún bù lèi","abbr":"blbl","explanation":"不伦：不同类。既非这一类，又非那一类，形容成样子或没有道理。","source":{"text":"眼中人不伦不类，阱中人不伶不俐。","book":"明·吴炳《疗炉羹·絮影》"},"example":{"text":"王夫人听了，早知道来意了。又见他说的～，也不便不理他。","book":"清·曹雪芹《红楼梦》第六十七回"},"similar":["不三不四","非僧非俗","非驴非马"],"opposite":["一本正经","正襟危坐"],"usage":"作谓语、定语、状语；比喻不规范与不成样子","story":["薛蟠从江南带回两大箱东西送给薛姨妈及薛宝钗，宝钗把其中的绫罗绸缎及洋货等分别送给贾府的上上下下。赵姨娘也得一份，为了讨好王夫人就到王夫人那里去夸宝钗贬林黛玉，但话说得不伦不类，被王夫人白眼送回"]},{"id":2085,"word":"不伶不俐","pinyin":"bù líng bù lì","abbr":"blbl","explanation":"形容不尴不尬，不清不白。","source":{"text":"眼中人不伦不类，阱中人不伶不俐。","book":"明·吴炳《疗妒羹·絮影》"}},{"id":2086,"word":"不依不饶","pinyin":"bù yī bù ráo","abbr":"bybr","explanation":"形容要求不遂就纠缠个没烷完。","source":{"text":"李氏和柳大洪慌忙来到前厅，为银环求情。柳刚不依不饶。李氏急了，说：‘你要杀银环，我就撞头！’","book":"郝艳霞 王润生《三请薛仁贵》第三回"},"example":{"text":"她对别人总是～的。"},"opposite":["宽宏大量"],"usage":"作谓语、定语；用于对人的态度"},{"id":2087,"word":"不依本分","pinyin":"bù yī běn fèn","abbr":"bybf","explanation":"依：安装；本分：本身应尽守的职责和规矩。形容不务正业，不守规矩。","source":{"text":"黄文炳道：‘那厮也是个不依本分的人。’","book":"明·施耐庵《水浒传》第39回"},"similar":["不安本分","不守本分"],"opposite":["安分守己","遵纪守法"],"usage":"作谓语、定语；指人不守规矩"},{"id":2088,"word":"不便之处","pinyin":"bù biàn zhī chù","abbr":"bbzc","explanation":"指不方便的地方。","source":{"text":"阿珠要自己去劝，毕竟有好些不便之处，亦不敢上楼。","book":"清·韩邦庆《海上花列传》第54回"},"example":{"text":"由此带来的～，敬请谅解。"},"similar":["为难之处"],"usage":"作主语、宾语；用于口语"},{"id":2089,"word":"不便水土","pinyin":"bù biàn shuǐ tǔ","abbr":"bbst","explanation":"不能适应移居地方的气候和饮食习惯。同“不服水土”。","source":{"text":"乌桓不便水土，惧久屯不休，数求谒去。","book":"汉·王符《潜夫论·实边》：“且夫人重迁，恋慕坟墓，贤不肖之所同也。……诸亡失财货，夺土远移，不习风俗，不便水土，类多灭门，少能还者。”南朝·宋·范晔《后汉书·乌桓传》"},"example":{"text":"今留兵守旧都，分家南徙，不能满诸州之地，参居郡县，情见事露，恐四方皆有轻侮之心；且百姓～，疾疫死伤者必多。","book":"宋·司马光《资治通鉴》卷第一百一十七"}},{"id":2090,"word":"不修小节","pinyin":"bù xiū xiǎo jié","abbr":"bxxj","explanation":"不注意生活上的小事。形容处世潇洒旷达。","source":{"text":"性佚，不修小节，当世以此讥焉，故不至大官。","book":"晋·袁宏《后汉纪·章帝纪》"},"example":{"text":"慷慨有大志，姿貌魁伟，雄杰不群，任侠放荡，～。","book":"《晋书·冯素弗载记》"},"similar":["不拘小节"],"usage":"作谓语、定语；指不注意生活小节"},{"id":2091,"word":"不修边幅","pinyin":"bù xiū biān fú","abbr":"bxbf","explanation":"边幅：布帛的边缘，比喻人的衣着、仪表。原形容随随便便，不拘小节。后形容不注意衣着或容貌的整洁。","source":{"text":"好饮酒，多任纵，不修边幅。","book":"《后汉书·马援传》：“公孙不吐哺走迎国士，与图成败，反修饰边幅，如偶人形。此子何足久稽天下士乎？”《北齐书·颜之推传》"},"example":{"text":"他又～，穿着一件稀烂的直裰，靸着一双破不过的蒲鞋。","book":"清·吴敬梓《儒林外史》第五十五回"},"similar":["不衫不履","不拘小节"],"opposite":["衣冠楚楚"],"usage":"作谓语、定语；形容人不注意仪容、衣着","story":["西汉末年，隗嚣派马援去四川联合公孙述共同对付刘秀。马援与公孙述是同乡要好，而公孙述嫌马援不修边幅，派官员送去官服，装出皇帝的架子，马援十分不悦就去投奔刘秀，见刘秀有雄才大略，就去洛阳投奔他，后来他屡立战功，被封为伏波将军"]},{"id":2092,"word":"不倒翁","pinyin":"bù dǎo wēng","abbr":"bdw","explanation":"形似老人的玩具，上轻下重，扳倒后自己能竖立起来。现多用于讽刺巧于保持自己地位的人。","source":{"text":"儿童嬉戏有不倒翁，糊纸作醉汉状，虚其中而实其底，虽按捺旋转不倒也。","book":"清·赵翼《陔余丛考》第三十三卷"},"example":{"text":"三十四年～，朝秦暮楚一时雄。","book":"柳亚子《咏史四首》"},"usage":"作宾语、定语；用于为人处世"},{"id":2093,"word":"不值一哂","pinyin":"bù zhí yī shěn","abbr":"bzys","explanation":"哂：微笑。不值得一笑。比喻毫无价值。也表示对某种事物或行为的轻蔑和讥笑。","source":{"text":"凡大队的革命军，必须一切战士的意识都十分正确、分明，这才是真正的革命军，否则不值一哂。","book":"鲁迅《二心集·非革命的急进革命论者》"},"similar":["不值一笑"],"usage":"作谓语；比喻毫无意义"},{"id":2094,"word":"不值一笑","pinyin":"bù zhí yī xiào","abbr":"bzyx","explanation":"不值得一笑。比喻毫无价值。也表示对某种事物或行为的轻蔑和讥笑。同“不值一哂”。","source":{"text":"触斗蛮争，由造物主观之，不值一笑。","book":"清·王韬《笑强弱论》"},"example":{"text":"又接得匿名信件，约有数通，多半措辞荒谬，～。","book":"蔡东藩《民国通俗演义》第21回"},"similar":["不值一哂"],"usage":"作谓语、定语；用于对事物的嘲讽和轻蔑"},{"id":2095,"word":"不值一谈","pinyin":"bù zhí yī tán","abbr":"bzyt","explanation":"不值得谈论。","source":{"text":"但对胡雪岩来说，这数目太小了，不值一谈，所以乌先生佯作不知，默然无语。","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"这点小事～。"},"similar":["不值一提"],"usage":"作谓语、定语；用于不屑的事情"},{"id":2096,"word":"不值一钱","pinyin":"bù zhí yī qián","abbr":"bzyq","explanation":"比喻毫无价值。","source":{"text":"生平毁程不识不直一钱。","book":"《史记·魏其安侯列传》"},"example":{"text":"此两公俱以直臣起家致大位，晚途遭诟，～，宪体至是扫地矣。","book":"明·沈德符《万历野获编·御史大夫被论》"},"similar":["不名一文"],"opposite":["价值连城"],"usage":"作谓语、定语；指没有价值"},{"id":2097,"word":"不值一顾","pinyin":"bù zhí yī gù","abbr":"bzyg","explanation":"顾：看。不值得一看。形容瞧不起某事物。","source":{"text":"夫禄之以天下而系马千驷，常人思以其身易之而不可得，而伊尹不屑一顾视焉。","book":"明·方孝儒《送龚彦佐序》"},"example":{"text":"明·方孝儒《送龚彦佐序》：“夫禄之以天下而系马千驷，常人思以其身易之而不可得，而伊尹不屑一顾视焉。”"},"similar":["不屑一顾"],"usage":"作谓语；用于处事"},{"id":2098,"word":"不值一驳","pinyin":"bù zhí yī bó","abbr":"bzyb","explanation":"不值得批驳。","example":{"text":"对于他所提有关修改方案的提议，完全没有事实根据，～。"},"similar":["站不住脚"],"opposite":["千真万确"],"usage":"作谓语、定语；用于观点等"},{"id":2099,"word":"不倾之地","pinyin":"bù qīng zhī dì","abbr":"bqzd","explanation":"倾：倾覆。不臻倾覆的境地。即不败之地。","source":{"text":"圣人之处国者，必于不倾之地。","book":"《管子·度地》"}},{"id":2100,"word":"不假思索","pinyin":"bù jiā sī suǒ","abbr":"bjss","explanation":"形容做事答话敏捷、熟练，用不着考虑。","source":{"text":"戒惧谨独，不待勉强，不假思索，只是一念之间，此意便在。","book":"宋·黄榦《黄勉斋文集》卷四"},"example":{"text":"“这讨厌的东西，我倒想把他剪掉。”淑英～地答道。","book":"巴金《春》二"},"similar":["一挥而就","脱口而出","一目十行"],"opposite":["慢条斯理","深思熟虑","搜索枯肠"],"usage":"作谓语、定语、状语；指懒于思考，不负责任"},{"id":2101,"word":"不假雕琢","pinyin":"bù jiǎ diāo zhuó","abbr":"bjdz","explanation":"不必借助精雕细琢。指器物天然即具有上好的质地。也比喻艺术品精美而无雕琢的痕迹。","source":{"text":"南海中，有大文贝，质白而文紫，天资自然，不假雕琢。","book":"《艺文类聚》卷八十四引《南州异物志》"},"example":{"text":"古诗短体如《十九首》，长篇如《孔雀东南飞》，皆～，工极自然。","book":"明·胡应麟《诗薮·内编二》"}},{"id":2102,"word":"不偏不倚","pinyin":"bù piān bù yǐ","abbr":"bpby","explanation":"倚：偏。不偏向任何一方。表示中立或公正。","source":{"text":"中者，不偏不倚，无过不及之名。","book":"宋·朱熹《中庸章句》题注"},"example":{"text":"只要办理得人，～，合乎中庸，一以国粹为归宿，那是决无流弊的。","book":"鲁迅《彷徨·高老夫子》"},"similar":["公正无私","一视同仁","中庸之道"],"opposite":["畸轻畸重","厚此薄彼","偏听偏信"],"usage":"作谓语、定语、状语；用于表示公正、中立"},{"id":2103,"word":"不偏不党","pinyin":"bù piān bù dǎng","abbr":"bpbd","explanation":"不偏向任何一方。","source":{"text":"《周诗》曰：王道荡荡，不偏不党。","book":"战国·宋·墨翟《墨子·兼爱下》"},"example":{"text":"夫惭德之主，忍诟之臣，犹能赏善不须贷财，罚恶不任私情，必将修绳履墨，～。","book":"晋·葛洪《抱朴子·道意》"},"similar":["不偏不倚"],"usage":"作谓语、定语；形容公正"},{"id":2104,"word":"不做不休","pinyin":"bù zuò bù xiū","abbr":"bzbx","explanation":"指事情既然开了头，就索性干到底。","source":{"text":"俺如今拚的个不做不休，这就是至诚心为人为彻。","book":"元·无名氏《马陵道》第四折"},"similar":["一不做，二不休"],"usage":"作谓语、状语；形容下最后的决心"},{"id":2105,"word":"不偢不倸","pinyin":"bù chǒu bù cǎi","abbr":"bcbc","explanation":"①犹不理不睬。②指一切事情都不注意。","source":{"text":"妇婿功名不遂回来，一家不偢不倸。","book":"明·苏复之《金印记·周氏回家》"},"example":{"text":"兴哥上路，心中只想着浑家，整日的～。","book":"《古今小说·蒋兴哥重会珍珠衫》"},"similar":["不理不睬"],"opposite":["热情和蔼"],"usage":"作谓语、定语；形容人态度高傲"},{"id":2106,"word":"不僧不俗","pinyin":"bù sēng bù sú","abbr":"bsbs","explanation":"犹言不三不四，不伦不类。","source":{"text":"倘一时没眼色，配着个不僧不俗如醉如痴蠢物，岂不添了终身？","book":"《醒世恒言·张廷秀逃生救父》"},"similar":["不伦不类","不三不四"],"usage":"作谓语、定语；指不伦不类"},{"id":2107,"word":"不入兽穴，不得兽子","pinyin":"bù rù shòu xué，bù dé shòu zǐ","abbr":"brsxbdsz","explanation":"不进野兽窝，不能捉到小野兽。比喻不冒险进入险境就不能取得成果。","source":{"text":"古人称不入兽穴，不得兽子。安危之事未可预量。","book":"《北史·韦佑传》"},"similar":["不入兽穴，安得兽子"],"usage":"作宾语、分句；指只有经历艰难才能成功"},{"id":2108,"word":"不入兽穴，安得兽子","pinyin":"bù rù shòu xué，ān dé shòu zǐ","abbr":"brsxadsz","explanation":"不进野兽窝，怎能捉到小野兽。比喻不冒险进入险境就不能取得成果。","source":{"text":"古人有言：‘不入兽穴，安得兽子。’若以奇兵出其不意，事或可济。","book":"《周书·李远传》"},"similar":["不入虎穴，焉得虎子"],"usage":"作宾语、分句；指只有经历艰难才能成功"},{"id":2109,"word":"不入时宜","pinyin":"bù rù shí yí","abbr":"brsy","explanation":"时宜：当时的需要和潮流。不适合时代形势的需要。也指不合世俗习尚。","source":{"text":"皆违经背古，不合时宜。","book":"《汉书·袁帝纪》"},"example":{"text":"朝云乃曰：“学士一肚皮，～。”","book":"宋·费衮《梁溪漫志》卷四"},"similar":["不合时宜"],"usage":"作谓语、宾语；指过时"},{"id":2110,"word":"不入虎穴，不得虎子","pinyin":"bù rù hǔ xué，bù dé hǔ zǐ","abbr":"brhxbdhz","explanation":"不进老虎洞，就不能捉到小老虎。比喻不担风险就不可能取得成果。","source":{"text":"超曰：‘不入虎穴，不得虎子。当今之计，独有因夜以火攻虏，使彼不知我多少，必大震怖，可殄尽也。’","book":"南朝·宋·范晔《后汉书·班超传》"},"example":{"text":"～，我们还得亲自去一趟。"},"similar":["不入虎穴，焉得虎子"],"opposite":["胆小怕事"],"usage":"作主语、分句；指只有经历艰难才能成功","story":["东汉时，汉明帝派班超出使西域和鄯善王交好，鄯善王对他们也很友好，表示愿意与汉修好，匈奴国的使者从中挑拨离间。班固对随从说：“不进入虎穴，怎么能抓到虎子。”连夜攻击并全歼灭匈奴使者，与鄯善王重归于好"]},{"id":2111,"word":"不入虎穴，焉得虎子","pinyin":"bù rù hǔ xué，yān dé hǔ zǐ","abbr":"brhxydhz","explanation":"焉：怎么。不进老虎窝，怎能捉到小老虎。比喻不亲历险境就不能获得成功。","source":{"text":"不入虎穴，焉得虎子。","book":"《后汉书·班超传》"},"example":{"text":"中国人有一句老话：“～。”这句话对人们的实践是真理，对于认识论也是真理。","book":"毛泽东《实践论》"},"similar":["亲临其境"],"opposite":["胆小如鼠"],"usage":"作主语、分句；指只有经历艰难才能成功","story":["东汉时，汉明帝派班超出使西域和鄯善王交好，鄯善王对他们也很友好，表示愿意与汉修好，匈奴国的使者从中挑拨离间。班固对随从说：“不进入虎穴，怎么能抓到虎子。”连夜攻击并全歼灭匈奴使者，与鄯善王重归于好"]},{"id":2112,"word":"不公不法","pinyin":"bù gōng bù fǎ","abbr":"bgbf","explanation":"不公平待人，不遵守法律。形容为非作歹，仗势欺人的行为。","source":{"text":"不可恃赖我势，作不公不法，搅扰官法。","book":"宋·司马光《与姪贴》"},"example":{"text":"平昔见稍有～之事，便执法处分，不少假借。","book":"明·许仲琳《封神演义》第二回"}},{"id":2113,"word":"不共戴天","pinyin":"bù gòng dài tiān","abbr":"bgdt","explanation":"戴：加在头上或用头顶着。不愿和仇敌在一个天底下并存。形容仇恨极深。","source":{"text":"父之仇，弗与共戴天。","book":"《礼记·曲礼上》"},"example":{"text":"这亘古未有的壮举，像一柄锋利的匕首，直刺～的死敌。”","book":"齐怀《刑场上的婚礼》"},"similar":["深仇大恨","势不两立","刻骨仇恨"],"opposite":["相依为命","唇齿相依"],"usage":"作谓语、定语；形容有深仇大恨","story":["公元1138年，金国派使者要挟南宋皇帝递降书顺表，宋高宗、秦桧贪生怕死，准备降金。大臣胡铨写《戊午上高宗封事》表示反对：“誓与秦桧等人不共戴天，希望斩下他的人头悬挂城门示众，然后诛杀金国使者。否则自己将蹈东海而死。”"]},{"id":2114,"word":"不关宏旨","pinyin":"bù guān hóng zhǐ","abbr":"bghz","explanation":"宏：大；旨：意义，目的。和主要意思没有关系。指意义不大或关系不大。","source":{"text":"宋儒所争，只今文古文字句，亦无关宏旨，均姑置弗议。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录一》"},"example":{"text":"《大乘缘起说》者，无过考证之文，～。","book":"清·章炳麟《答梦庵》"}},{"id":2115,"word":"不关痛痒","pinyin":"bù guān tòng yǎng","abbr":"bgty","explanation":"痛痒：比喻疾苦或紧要的事。比喻切身相关的事。指与自身利害没有关系。","source":{"text":"那不关痛痒底是不仁。","book":"《朱子语类》卷一０一"},"example":{"text":"这里虽还有两三个老婆子，都是～的，见李妈走了，也都悄悄的自寻方便去了。","book":"清·曹雪芹《红楼梦》第八回"},"similar":["了不相涉","漠不关心"],"opposite":["息息相关","唇齿相依"],"usage":"作谓语、定语；比喻不关心与己无关的事","story":["贾宝玉听说薛姨妈及宝钗来京城并住在他们家，就立即前去拜访，把自己的通灵宝玉拿出给宝钗看，宝钗也把自己的金锁让宝玉观赏，林黛玉见到他们两个高兴的样子，心中酸溜溜的，故意闪到一边，只留下几个不关痛痒的老婆子伺候"]},{"id":2116,"word":"不关紧要","pinyin":"bù guān jǐn yào","abbr":"bgjy","explanation":"紧要：急切的，重要的。不重要，不会影响大局。","source":{"text":"此事也不关紧要，因而吩咐祁知府从宽办结。","book":"清·吴敬梓《儒林外史》第51回"},"example":{"text":"牛马同是哺乳动物，为了要‘顺’，固然混用一回也～。","book":"鲁迅《二心集·风马牛》"},"similar":["无关紧要"],"opposite":["至关重要"],"usage":"作谓语、定语；指不影响大局"},{"id":2117,"word":"不冷不热","pinyin":"bù lěng bù rè","abbr":"blbr","explanation":"指温度不高不低，冷热适中。亦比喻对人态度一般。","source":{"text":"这一天是这个山城里少有的不冷不热的好天。","book":"清·文康《儿女英雄传》第三十五回：“便见他一只手高高儿的举了一碗熬得透、得到不冷不热、温凉适中、可口儿的普洱茶来。”巴金《寒夜》三"},"example":{"text":"他采取～的态度，和她保持若即若离的关系。","book":"周而复《上海的早晨》第三部二七"},"similar":["不温不火"],"usage":"作谓语、定语、状语；指人的态度"},{"id":2118,"word":"不凉不酸","pinyin":"bù liáng bù suān","abbr":"blbs","explanation":"方言。形容态度冷漠。"},{"id":2119,"word":"不出户，知天下","pinyin":"bù chū hù，zhī tiān xià","abbr":"bchztx","explanation":"旧时认为有知识的人即使待在家里，也能知道外面发生的事情。","source":{"text":"不出户，知天下。","book":"《老子》第四十七章"}},{"id":2120,"word":"不出所料","pinyin":"bù chū suǒ liào","abbr":"bcsl","explanation":"事由变化，在预料之中。形容原先预料的准确。","source":{"text":"见你不在，我就猜着到这里来了，所以一直赶来，果然不出所料。","book":"清·曾朴《孽海花》第十回"},"example":{"text":"“果然～，”这样的一念闪过校长先生的心头。(叶圣陶《一篇宣言》)"},"similar":["料事如神"],"opposite":["出其不意","出人意表"],"usage":"作谓语；用于人对事物的推测"},{"id":2121,"word":"不分上下","pinyin":"bù fēn shàng xià","abbr":"bfsx","explanation":"不管上级和下级或指分不出高低胜负。","source":{"text":"一天到晚，粘股糖似的，不分上下，搅在一块儿坐马车、看夜戏、游花园。","book":"曾朴《孽海花》第14回"},"example":{"text":"在法律面前～，一律人人平等。"},"similar":["不分胜负","不分高下"],"usage":"作谓语、定语、状语；用于人或事物"},{"id":2122,"word":"不分主次","pinyin":"bù fēn zhǔ cì","abbr":"bfzc","explanation":"指人办事不能分辨主要的和次要的。","source":{"text":"虽然这三种说法不分主次，都有同样有力的证人和很难杜撰栩栩如生的细节，我还是一下就相信了最后一种说法。","book":"王朔《动物凶猛》"},"example":{"text":"他一向办事～。"},"similar":["主次不分"],"opposite":["主次分明"],"usage":"作谓语、定语；用于人处事"},{"id":2123,"word":"不分伯仲","pinyin":"bù fēn bó zhòng","abbr":"bfbz","explanation":"分不出第一第二。","example":{"text":"两位追求者的才学、家世都一样优秀，～，让她不知如何抉择。"},"similar":["不相上下"],"opposite":["天差地别"],"usage":"作谓语、定语、补语；用于人与事物"},{"id":2124,"word":"不分彼此","pinyin":"bù fēn bǐ cǐ","abbr":"bfbc","explanation":"彼：那，对方；此：这，我方。不分这个和那个。形容关系密切，交情深厚。","source":{"text":"一切以大体弥缝之，号令无所变更，而任用不乏其人。","book":"宋·陈亮《谢安比王导论》"},"example":{"text":"他就是我，我就是他，我俩原是～的。","book":"蔡东藩、许廑父《民国通俗演义》第一百三十回"},"similar":["情同手足"],"opposite":["行同陌路"],"usage":"作谓语、定语；形容是自己人，不必见外"},{"id":2125,"word":"不分玉石","pinyin":"bù fēn yù shí","abbr":"bfys","explanation":"指无有区别，同归于尽。参见“玉石俱焚”。","source":{"text":"向非君侯来，合郡士民当不分玉石矣。","book":"清·刘献廷《广阳杂记》卷二"},"similar":["玉石俱焚","好坏不分"],"usage":"作谓语；指没有区别"},{"id":2126,"word":"不分畛域","pinyin":"bù fēn zhěn yù","abbr":"bfzy","explanation":"畛域：范围，界限。不分界限、范围。也比喻不分彼此。","source":{"text":"泛泛乎其若四方之无穷，其无所畛域。","book":"《庄子·秋水》"},"example":{"text":"我们善堂是～的，往时各省有了灾荒，没一处不去赈济。","book":"清·黄小配《廿载繁华梦》第二十八回"},"similar":["不分彼此"],"opposite":["泾渭分明"],"usage":"作谓语；形容不分界限"},{"id":2127,"word":"不分皂白","pinyin":"bù fēn zào bái","abbr":"bfzb","explanation":"皂：黑色。不分黑白，不分是非。","source":{"text":"胡之言何也，贤者见此事之是非，非不能分别皂白言之于王也。","book":"《诗经·大雅·桑柔》：“匪言不能，胡斯畏忌。”汉·郑玄笺"},"example":{"text":"我们被他哄了，不拿得他，却被这里人～，混打这番，把同伴人惊散。","book":"明·凌濛初《二刻拍案惊奇》卷三十九"},"similar":["混淆黑白","是非不分","混为一谈"],"opposite":["是非分明","黑白分明"],"usage":"作谓语、定语、状语；比喻不弄清缘由"},{"id":2128,"word":"不分胜负","pinyin":"bù fēn shèng fù","abbr":"bfsf","explanation":"分不出谁胜谁负。形容竞赛双方水平、技术相当。","source":{"text":"孙悟空金箍棒，变作万万千千。半空中似雨点流星，不分胜负。","book":"明·吴承恩《西游记》第四回"},"example":{"text":"他们一战～。"},"similar":["势均力敌"],"usage":"作谓语、状语、定语；指势均力敌","story":["三国时期，张飞听说马超要来攻打葭萌关，就立即率兵迎战，没想到迎战的只是马岱而矣。张飞不悦，将马岱打回敌营。马超出营迎战，刘备也前来观战，双方大战几百回合也没有分出胜败来。夜间又大战20多回合还是不分胜负"]},{"id":2129,"word":"不分胜败","pinyin":"bù fēn shèng bài","abbr":"bfsb","explanation":"指双方势均力敌，分不出高低。","source":{"text":"两个在战场上斗到五十余合，不分胜败。","book":"明·施耐庵《水浒传》第69回"},"example":{"text":"他们两人在班上的成绩～。"},"similar":["不分胜负"],"usage":"作谓语；指势均力敌","story":["三国时期，张飞听说马超要来攻打葭萌关，就立即率兵迎战，没想到迎战的只是马岱而矣。张飞不悦，将马岱打回敌营。马超出营迎战，刘备也前来观战，双方大战几百回合也没有分出胜败来。夜间又大战20多回合还是不分胜负"]},{"id":2130,"word":"不分轩轾","pinyin":"bù fēn xuān zhì","abbr":"bfxz","explanation":"不分高下、轻重。比喻对待二者的态度或看法差不多。","source":{"text":"居前不能令人轾，居后不能令人轩……臣所耻也。","book":"《后汉书·马援传》"},"example":{"text":"但先入之言，容易见听，如果有两个人在慈禧太后心目中～，那时想起溥伦的话，关系出入就太大了。","book":"高阳《胭脂井》"},"similar":["不分高低"],"usage":"作谓语；形容不分高低与胜负"},{"id":2131,"word":"不分轻重","pinyin":"bù fēn qīng zhòng","abbr":"bfqz","explanation":"指人办事盲目，不分主次。","source":{"text":"上级机关也不要不分轻重缓急地没有中心地同时指定下级机关做很多项工作。","book":"毛泽东《关于领导方法的若干问题》"},"example":{"text":"他一向办事～，眉毛胡子一把抓。"},"similar":["不分主次"],"usage":"作谓语、定语；用于人处事"},{"id":2132,"word":"不分青白","pinyin":"bù fēn qīng béi","abbr":"bfqb","explanation":"指不分黑白，不辨是非。","source":{"text":"见“不分皂白”。"},"example":{"text":"我是拥护斗地主，拥护分土地的，可就怕有些年轻小子～，不是地主也斗。","book":"陈残云《山谷风烟》第十七章"},"similar":["不分皂白"],"opposite":["是非分明"],"usage":"作谓语、定语、状语；比喻不弄清缘由"},{"id":2133,"word":"不分青红皂白","pinyin":"bù fēn qīng hóng zào bái","abbr":"bfqhzb","explanation":"皂：黑色。不分黑白，不分是非。","source":{"text":"胡之言何也，贤者见此事之是非，非不能分别皂白言之于王也。","book":"《诗经·大雅·桑柔》：“匪言不能，胡斯畏忌。”汉·郑玄笺"},"example":{"text":"文采觉得这末～就不太好。","book":"丁玲《太阳照在桑干河上》三十六"},"similar":["混淆黑白","是非不分","混为一谈"],"opposite":["是非分明","黑白分明"],"usage":"作谓语、状语；形容是非不分，办事武断"},{"id":2134,"word":"不分高下","pinyin":"bù fēn gāo xià","abbr":"bfgx","explanation":"指分不出高低胜负。","example":{"text":"他们两人的技术精湛，真是～。"},"similar":["不分胜负"],"usage":"作谓语、定语、状语；用于比较"},{"id":2135,"word":"不切实际","pinyin":"bù qiē shí jì","abbr":"bqsj","explanation":"指不符合实际。","source":{"text":"若是徒有虚名，不切实际，那就成事不足，败事有余了！","book":"丁寅生《孔子演义》第98回"},"example":{"text":"必须一切从实际出发，不能把目标定得～，也不能把时间定得太短。","book":"邓小平《社会主义必须摆脱贫穷》"},"similar":["不合实际"],"opposite":["切合实际"],"usage":"作谓语、定语；用于虚幻的想法"},{"id":2136,"word":"不刊之书","pinyin":"bù kān zhī shū","abbr":"bkzs","explanation":"指不能更改或磨灭的有关帝王的记载、钦定典制。","source":{"text":"是悬诸日月不刊之书也。","book":"汉·扬雄《答刘歆书》"},"example":{"text":"《礼记》，～也。","book":"宋·欧阳修《食货志论》"},"similar":["不刊之典"],"usage":"作宾语；指典籍等"},{"id":2137,"word":"不刊之典","pinyin":"bù kān zhī diǎn","abbr":"bkzd","explanation":"指不能更改或磨灭的有关帝王的记载、钦定典制。","source":{"text":"伏以圣旨所定乐论钟律纬绪，文思深微，命世一出，方悬日月，不刊之典，礼乐之孝，致治所成。","book":"《梁书·萧子云传》"},"example":{"text":"以一字称褒贬之意，为千载～。","book":"五代·牛希济《褒贬论》"},"similar":["不刊之书"],"usage":"作宾语；指典籍等"},{"id":2138,"word":"不刊之论","pinyin":"bù kān zhī lùn","abbr":"bkzl","explanation":"刊：削除，古代把字写在竹简上，有错误就削去。指正确的、不可修改的言论。","source":{"text":"宋·吴曾《能改斋漫录·议论》：“故中兴难于创业，是谓不刊之说”。"},"example":{"text":"这可以说是～，我有同感。","book":"孙犁《万国儒小引》"},"similar":["天经地义","不易之论"],"opposite":["不经之谈","无稽之谈"],"usage":"作宾语；形容不能改变的言论"},{"id":2139,"word":"不刊之说","pinyin":"bù kān zhī shuō","abbr":"bkzs","explanation":"指正确的、不可修改的言论。","source":{"text":"宋·吴曾《能改斋漫录·议论》：“故中兴难于创业，是谓不刊之说”。"},"similar":["不刊之论"],"opposite":["无稽之谈"],"usage":"作宾语；形容不能改变的言论"},{"id":2140,"word":"不到乌江不尽头","pinyin":"bù dào wū jiāng bù jìn tóu","abbr":"bdwjbjt","explanation":"犹不到黄河心不死。比喻不到实在无路可走的的境地不肯死心。","source":{"text":"世局千腾万变，转盻皆空，政如下棋的较胜争强，眼红喉急，分明似孙庞斗智，赌个你死我活，又如刘项争天下，不到乌江不尽头。","book":"明·冯梦龙《醒世恒言》第九卷"},"similar":["不到黄河心不死"],"opposite":["半途而废","知难而退"],"usage":"作定语、分句；表示不达目的不罢休"},{"id":2141,"word":"不到乌江不肯休","pinyin":"bù dào wū jiāng bù kěn xiū","abbr":"bdwjbkx","explanation":"犹不到黄河心不死。同“不到乌江不尽头”。","source":{"text":"世上死生皆为利，不到乌江不肯休。","book":"明·冯梦龙《醒世恒言》第二十六卷"},"similar":["不到乌江不尽头"],"opposite":["知难而退"],"usage":"作定语、分句；表示不达目的不罢休"},{"id":2142,"word":"不到乌江心不死","pinyin":"bù dào wū jiāng xīn bù sǐ","abbr":"bdwjxbs","explanation":"犹不到黄河心不死。同“不到乌江不尽头”。","source":{"text":"我道：‘你不到乌江心不死，今已到了乌江，这心原也该死了。’","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"similar":["不到黄河心不死"],"opposite":["知难而退"],"usage":"作定语、分句；表示不达目的不罢休"},{"id":2143,"word":"不到长城非好汉","pinyin":"bù dào cháng chéng fēi hǎo hàn","abbr":"bdccfhh","explanation":"比喻不能克服困难，达到目的，就不是英雄豪杰。","example":{"text":"我们要～的决心。"},"similar":["不到黄河心不甘"],"usage":"作宾语、定语、分句；指人的志向"},{"id":2144,"word":"不到黄河心不死","pinyin":"bù dào huáng hé xīn bù sǐ","abbr":"bdhhxbs","explanation":"比喻不达目的不罢休。也比喻不到实在无路可走的的境地不肯死心。","source":{"text":"这种人不到黄河心不死。现在我们横竖总不落好，索性给他一个一不做二不休。","book":"清·李宝嘉《官场现形记》第十七回"},"example":{"text":"他自己心里何尝不明白呢？～罢哩！","book":"茅盾《清明前后》第四幕"},"similar":["矢志不移","不到乌江不尽头"],"usage":"作定语、分句；表示不达目的不罢休"},{"id":2145,"word":"不加思索","pinyin":"bù jiā sī suǒ","abbr":"bjss","explanation":"思索：思考探求。用不着想。形容说话办事敏捷迅速","source":{"text":"包公将轿内随行纸墨笔砚，叫包兴递与妇人另写一张，只见不加思索，援笔立就，呈上。","book":"清·石玉昆《三侠五义》第95回"},"example":{"text":"巴金《春》：“‘这讨厌的东西，我倒想把他剪掉。’淑英～地答道。”"},"similar":["不假思索"],"opposite":["冥思苦想"],"usage":"作谓语、状语；指欠考虑"},{"id":2146,"word":"不务正业","pinyin":"bù wù zhèng yè","abbr":"bwzy","explanation":"务：从事。指丢下本职工作不做，去搞其他的事情。","source":{"text":"这人不甚读书，终日闲游浪荡，一自父母亡后，分外不务正业。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"example":{"text":"在那时候他们是被骂为～的青年，但没人知道当时的社会已无青年们可务的正业。","book":"郭沫若《少年时代·我的童年》"},"similar":["好逸恶劳","游手好闲","不求上进"],"opposite":["埋头苦干","奋发有为"],"usage":"作谓语、定语；指游手好闲、贪图安逸"},{"id":2147,"word":"不务空名","pinyin":"bù wù kōng míng","abbr":"bwkm","explanation":"务：追求。切实地工作，不追求虚名。","source":{"text":"工人中间应该教育出大批的干部，他们应该有知识，有能力，不务空名，会干实事。","book":"毛泽东《发刊词》"},"example":{"text":"干工作要～，脚踏实地。"},"similar":["埋头苦干","实事求是","脚踏实地"],"opposite":["追名逐利","名不副实","徒有虚名"],"usage":"作谓语、定语；用于务实肯干的人"},{"id":2148,"word":"不劣方头","pinyin":"bù liè fāng tóu","abbr":"blft","explanation":"劣：不好；方头：俗指不通时宜为方头。不以不通时宜为不好。形容人性格倔强、顽固。","source":{"text":"俺这里有个裴炎，好生方头不劣。","book":"元·关汉卿《钱大尹智勘绯衣梦》第四折"},"example":{"text":"我从来～，恰便似火上浇油。","book":"《元曲选·陈州粜米》"},"similar":["倔强不驯"],"usage":"作谓语、定语、补语；形容人倔强不驯"},{"id":2149,"word":"不动声色","pinyin":"bù dòng shēng sè","abbr":"bdss","explanation":"声：言谈；色：脸色。在紧急情况下，说话、神态仍跟平时一样没有变化。形容非常镇静。","source":{"text":"垂绅正笏，不动声色，而措天下于泰山之安。","book":"宋·欧阳修《相州昼锦堂记》"},"example":{"text":"他也～，勤勤慎慎办他的公事。","book":"清·李宝嘉《官场现形记》第十二回"},"similar":["不露声色","无动于衷","泰然自若"],"opposite":["不知所措","失魂落魄","手足无措"],"usage":"作谓语、定语、状语；用于紧急情况下"},{"id":2150,"word":"不劳而成","pinyin":"bù láo ér chéng","abbr":"blec","explanation":"不须劳苦就能有成就。","source":{"text":"因事之理则不劳而成，故兹郑之踞辕而歌以上高梁也。","book":"《韩非子·外储说右下》"},"example":{"text":"任骨鲠正直，与之修复故事，以兴大化，可以～也。","book":"《新唐书·李翱传》"},"similar":["不劳而获"],"usage":"作谓语、定语、宾语；用于人"},{"id":2151,"word":"不劳而获","pinyin":"bù láo ér huò","abbr":"bleh","explanation":"获：获取，得到。自己不劳动却占有别人的劳动成果。","source":{"text":"所求于迩，故不劳而得也。","book":"《孔子家语·入官》"},"example":{"text":"我的目标是不满于杨，而因此而是为的举动，却也许被第三者收渔人之利，～。","book":"鲁迅《两地书》三十"},"similar":["坐享其成","不劳而食"],"opposite":["自食其力"],"usage":"作谓语、定语、状语；比喻不劳动而得"},{"id":2152,"word":"不劳而食","pinyin":"bù láo ér shí","abbr":"bles","explanation":"食：吃。自己不劳动而占有别人的劳动成果。","source":{"text":"第一品是性善的，即不劳而食的地主阶级统治集团的本性。","book":"吕振羽《简明中国通史》第九章"},"similar":["不劳而获"],"opposite":["自食其力"],"usage":"作谓语、定语、状语；比喻不劳动而得"},{"id":2153,"word":"不勤而获","pinyin":"bù qín ér huò","abbr":"bqeh","explanation":"指不劳而获。","source":{"text":"吾闻不勤而获犹谓之灾，士君子所慎者非常之得之。","book":"宋·王谠《唐语林·补遗三》"},"similar":["不劳而获"],"usage":"作谓语、定语、状语；比喻不劳动而得"},{"id":2154,"word":"不卑不亢","pinyin":"bù bēi bù kàng","abbr":"bbbk","explanation":"卑：低、自卑；亢：高傲。指对人有恰当的分寸，既不低声下气，也不傲慢自大。","source":{"text":"卑：低、自卑；亢：高傲。指对人有恰当的分寸，既不低声下气，也不傲慢自大。"},"example":{"text":"老张虽着急，可是龙树古～的支应，使老张无可发作。","book":"老舍《老张的哲学》"},"similar":["不骄不躁","不矜不伐"],"opposite":["俯首听命","俯首贴耳"],"usage":"作谓语、定语；指对人的态度彬彬有礼","story":["春秋末年齐国宰相晏婴奉命出使楚国，楚王百般刁难他，先是让他从小门进城，然后说他是矮子，用最差的饭菜招待他，最后用两个齐国囚犯来羞辱他，均被他的不卑不亢的态度及高超的外交才能所折服，结果楚王自取其辱"]},{"id":2155,"word":"不卜可知","pinyin":"bù bǔ kě zhī","abbr":"bbkz","explanation":"卜：占卜，预料。不用占卜就能知道。指不必预测就能知道。","source":{"text":"武王将伐纣，召太公望而问之曰：‘吾欲不战而知胜，不卜而知吉，使非其人，为之有道乎？’","book":"汉·刘向《说苑·指武》"}},{"id":2156,"word":"不即不离","pinyin":"bù jí bù lí","abbr":"bjbl","explanation":"即：接近，靠近；离：疏远，离开。指对人既不接近，也不疏远。多指对人似亲非亲、似疏非疏的关系。","source":{"text":"不即不离，无缚无脱","book":"唐·罽宾《圆觉经》卷上"},"example":{"text":"刘本人打着保境安民的旗号，隐隐地以湖北的政治中心自命，对于南北两方都采取着～的态度。","book":"郭沫若《革命春秋·北伐途次》"},"similar":["若即若离"],"opposite":["亲密无间"],"usage":"作谓语、定语、状语；用于形容对人的态度"},{"id":2157,"word":"不厌其烦","pinyin":"bù yàn qí fán","abbr":"byqf","explanation":"厌：嫌。不嫌麻烦。","source":{"text":"每阅数年，必综叙素臣生子生孙，娶妇嫁女，中科发甲。而读者不厌其烦，甚至一回之中，先后数见，绝无沓冗繁复之病。","book":"清·夏敬渠《野叟曝言》第一百三十八回评"},"example":{"text":"今之史学则异是，必致谨于闾阎日用之细，起居笑貌之琐，～，不嫌其鄙。","book":"清·严复《道学外传》"},"similar":["诲人不倦","苦口婆心"],"opposite":["不胜其烦"],"usage":"作谓语、状语；形容很有耐心"},{"id":2158,"word":"不厌其繁","pinyin":"bù yàn qí fán","abbr":"byqf","explanation":"厌：嫌。不嫌繁杂；不嫌麻烦。","source":{"text":"明·吕坤《呻吟语》：[天]极精细，色色象象，条分缕析而不厌其繁。”"},"similar":["不厌其烦"],"usage":"作谓语、状语；形容很有耐心"},{"id":2159,"word":"不厌其详","pinyin":"bù yàn qí xiáng","abbr":"byqx","explanation":"不嫌详细。指越详细越好。","source":{"text":"讲学不厌其详，凡天下事物之理，方册圣贤之言，皆须子细反覆究竟。","book":"宋·朱熹《答刘公度》"},"example":{"text":"我那时确实从心底里关心这个孤苦的小女孩，就～的问黎凤关于小英的事。","book":"茹志娟《在果树园里》"},"similar":["细大不捐","纤悉不遗","不厌求详"],"opposite":["语焉不详","简明扼要"],"usage":"作谓语、状语；形容不嫌详细"},{"id":2160,"word":"不厌求详","pinyin":"bù yàn qiú xiáng","abbr":"byqx","explanation":"不嫌详细。指越详细越好。同“不厌其详”。","source":{"text":"徐子材不厌求详地询问史循自杀的感觉，几次把龙飞的已经到了嘴唇边的话打了回去。","book":"茅盾《蚀·追求》七"},"similar":["不厌其详"],"usage":"作谓语、状语；形容不嫌详细"},{"id":2161,"word":"不厌糟糠","pinyin":"bù yàn zāo kāng","abbr":"byzk","explanation":"厌：满足；糟糠：用以充饥的酒糟糠皮等粗劣的食物。就连酒糟、米糠这样粗劣的食物也吃不饱。形容生活极其困苦。","source":{"text":"韩地险恶，山居，五谷所生，非麦而豆；民之所食，大抵豆饭藿羹；一岁不收，民不厌糟糠；不满九百里，无二岁之所食。","book":"《战国策·韩策一》"},"example":{"text":"至于西洋，则其贫者之～，无立锥之地，与中国差相若，而连阡陌，弃粱肉，固未足以尽其富也。（严复《原强》）"}},{"id":2162,"word":"不及之法","pinyin":"bù jí zhī fǎ","abbr":"bjzf","explanation":"指不适用的法规。","source":{"text":"使天下簧鼓，以奉不及之法，非乎？","book":"《庄子·拼拇》"},"example":{"text":"某些不合理的特殊待遇，是应当取消的～。"}},{"id":2163,"word":"不变之法","pinyin":"bù biàn zhī fǎ","abbr":"bbzf","explanation":"不可改变的法则。","source":{"text":"不变之法，君臣上下是也。","book":"《尹文子·大道上》"}},{"id":2164,"word":"不古不今","pinyin":"bù gǔ bù jīn","abbr":"bgbj","explanation":"指事物不正常，古代现代都不曾有过。原讥讽人学无所得却故作诡异。后常比喻折衷。","source":{"text":"童牛角马，不今不古。","book":"汉·扬雄《太玄经·更》"},"example":{"text":"遥见双炬，疑为虎目，至前则官役数人，衣冠～。","book":"清·纪昀《阅微草堂笔记》卷十八"},"similar":["空前绝后","独一无二"],"usage":"作谓语、定语；用于书面语"},{"id":2165,"word":"不可一世","pinyin":"bù kě yī shì","abbr":"bkys","explanation":"一世：一时。认为当代的人都不行。形容目空一切、狂妄自大到了极点。","source":{"text":"荆公少年，不可一世。","book":"宋·罗大经《鹤林玉露补遗》卷十五"},"example":{"text":"盖兴会飙举，～矣。","book":"柳亚子《燕子龛遗诗序》"},"similar":["目空一切","惟我独尊","旁若无人"],"opposite":["虚怀若谷","谦虚谨慎","妄自菲薄"],"usage":"作谓语、定语、补语；形容狂妄自大"},{"id":2166,"word":"不可乡迩","pinyin":"bù kě xiāng ěr","abbr":"bkxe","explanation":"不可接近。同“不可向迩”。","source":{"text":"君子曰：‘《商书》所谓“恶之易也，如火之燎于原，不可乡迩，其犹可扑灭”者，其如蔡哀侯乎。’","book":"《左传·庄公十四年》"}},{"id":2167,"word":"不可以道里计","pinyin":"bù kě yǐ dào lǐ jì","abbr":"bkydlj","explanation":"计：计算。不能用里程来计算。形容程度相差很大。","source":{"text":"最有学问的人，就是周秦诸子，比那日本的物茂卿、太宰纯辈，就相去不可以道里计了。","book":"章炳麟《东京留学生欢迎会演说辞》"},"example":{"text":"比平津及沿江沿海一带，肥瘦之差，直～。","book":"范长江《中国的西北角》"},"usage":"作谓语、定语；用于比较等"},{"id":2168,"word":"不可企及","pinyin":"bù kě qǐ jí","abbr":"bkqj","explanation":"企：希望；及：达到。没有希望达到。形容远远赶不上。","source":{"text":"不可企而及之者性也。","book":"唐·柳冕《答衢州郑使君》"},"example":{"text":"他的成绩并非～，我们只要奋发努力，一定能赶上他。"},"similar":["相形见绌","望尘莫及"],"opposite":["青出于蓝","后来居上","指日可待"],"usage":"作谓语；用于人与物"},{"id":2169,"word":"不可估量","pinyin":"bù kě gū liáng","abbr":"bkgl","explanation":"估量：估计。不可以估计。形容数量大或程度重。","source":{"text":"改善我们的国际环境，提高我国的国际威望，起了不可估量的作用。","book":"邓小平《坚持四项基本原则》"},"example":{"text":"她给公司造成～的损失。"},"similar":["难以估量"],"usage":"作定语；指难以估计"},{"id":2170,"word":"不可侵犯","pinyin":"bù kě qīn fàn","abbr":"bkqf","explanation":"不能侵凌触犯。","source":{"text":"德国愿意停止反苏，愿意放弃所谓《防共协定》，承认了苏联边疆的不可侵犯。","book":"毛泽东《关于国际新形势对新华日报记者的谈话》"},"usage":"作谓语、定语、状语；用于利益等"},{"id":2171,"word":"不可偏废","pinyin":"bù kě piān fèi","abbr":"bkpf","explanation":"偏废：侧重一方，忽略另一方。指两方面都应同样重视，不能片面地强调一个方面，而忽视另一个方面。","source":{"text":"读《庄子》，令人意宽思大，敢作；读《左传》，便使人入法度，不敢容易。二书不可偏废也。","book":"宋·胡仔《苕溪渔隐丛话前集·山谷下》"},"example":{"text":"能读书，才必博；能养气，量必宏，二者～。","book":"清·汇阴百一居士《壶天录》"},"similar":["不偏不倚","统筹兼顾"],"opposite":["本末倒置","顾此失彼","轻重倒置"],"usage":"作谓语；指对双方同等看待"},{"id":2172,"word":"不可分割","pinyin":"bù kě fēn gē","abbr":"bkfg","explanation":"不容许割裂、拆开。","source":{"text":"政协各项决议，是各党派的临时大宪章，是一个整体而不可分割的。","book":"周恩来《对国民党召开“国大”的严正声明》"},"example":{"text":"这是一个～的整体。"},"opposite":["四分五裂"],"usage":"作谓语、定语；指一个整体"},{"id":2173,"word":"不可动摇","pinyin":"bù kě dòng yáo","abbr":"bkdy","explanation":"形容极其坚定、牢固。","source":{"text":"不可动摇"},"example":{"text":"这是中国人民从五四运动到现在六十年来的切身体验中得出的～的历史结论。","book":"邓小平《坚持四项基本原则》"},"opposite":["风雨飘摇","见异思迁"],"usage":"作谓语、定语；用于地位、观念等"},{"id":2174,"word":"不可同年而语","pinyin":"bù kě tóng nián ér yǔ","abbr":"bktney","explanation":"不能放在同一时间谈论。形容不能相提并论，不能相比。同“不可同日而语”。","source":{"text":"试使山东之国与陈涉度长絜大，比权量力，则不可同年而语矣。","book":"汉·贾谊《过秦论》"},"example":{"text":"故摘果于未熟，视已熟～。","book":"清·魏源《默觚下·治篇十五》"},"similar":["不可同日而语"],"opposite":["相提并论"],"usage":"作谓语、定语；形容不能相比"},{"id":2175,"word":"不可同日而语","pinyin":"bù kě tóng rì ér yǔ","abbr":"bktrey","explanation":"不能放在同一时间谈论。形容不能相提并论，不能相比。","source":{"text":"夫破人之与破于人也，臣人之与臣于人也，岂可同日而言之哉？","book":"《战国策·赵策二》"},"example":{"text":"我们现在的生活和改革开放前相比，真是～。"},"similar":["不可比拟","不可同年而语"],"opposite":["相提并论"],"usage":"作谓语、定语；形容不能相比","story":["战国时期，秦想吞并六国，洛阳人苏秦便到赵国劝说赵王联合其他五国齐心抗秦，可以打败秦国的野心，还说：“夫破人之与破于人也，岂可同日而言之哉。”赵王接受苏秦的建议，封他为武安君，到各国去游说共同抗秦"]},{"id":2176,"word":"不可名状","pinyin":"bù kě míng zhuàng","abbr":"bkmz","explanation":"名：用言语说出；状：描绘，形容。无法用语言来形容。","source":{"text":"衣有文采，又非锦绮，光彩耀目，不可名状。","book":"《老子》第十四章：“绳绳不可名，复归于无物，是谓无状之状，无物之象。”晋·葛洪《神仙记·王远》"},"example":{"text":"拜住不敢十分抬头，已自看得较切，不比前日墙外影响，心中喜不～。","book":"明·凌濛初《初刻拍案惊奇》卷九"},"similar":["不可言宣","不可思议","不可胜言"],"opposite":["一语破的"],"usage":"作谓语、定语；指声音、色彩、感觉等"},{"id":2177,"word":"不可名貌","pinyin":"bù kě míng mào","abbr":"bkmm","explanation":"名：说出。没法用言辞来形容。","source":{"text":"穿幽透深，不可名貌。","book":"宋·周密《武林旧事》第五卷"},"similar":["不可名状"],"opposite":["一语破的"],"usage":"作谓语、定语；指声音、色彩、感觉等"},{"id":2178,"word":"不可向迩","pinyin":"bù kě xiàng ěr","abbr":"bkxe","explanation":"迩：近。不可接近。","source":{"text":"若火之燎于原，不可向迩，其犹可扑灭。","book":"《尚书·盘庚上》"},"example":{"text":"我起个大早，破晓就到车站去找车子，但见仓皇、拥挤、混乱之状，～，废然而返。”","book":"丰子恺《艺术的逃难》"},"similar":["不可接近"],"opposite":["平易近人"],"usage":"作谓语；形容人或事物让人难以接近","story":["商朝时期，盘庚上台后迁都到殷，王公大臣强烈反对，并在私下议论，盘庚十分生气，就召集他们当面训斥，说他们互相勾结，用没有根据的胡言乱语来吓唬和煽动民众：“若火之燎于原，不可向迩，其犹可扑灭。”"]},{"id":2179,"word":"不可告人","pinyin":"bù kě gào rén","abbr":"bkgr","explanation":"不能告诉别人。指见不得人。","source":{"text":"贾戏于落卷中，集其阘茸泛滥，不可告人之句，连缀成文示之。","book":"清·蒲松龄《聊斋志异·贾奉雉》"},"example":{"text":"著诸书者，其人皆深极哀苦，有～之隐，乃以委曲譬喻出之。","book":"清·王无生《论小说与改变社会之关系》"},"similar":["心怀叵测","讳莫如深","别有用心"],"opposite":["襟怀坦白","光明正大","推心置腹"],"usage":"作定语；形容居心叵测不敢告诉别人的事物"},{"id":2180,"word":"不可多得","pinyin":"bù kě duō dé","abbr":"bkdd","explanation":"形容非常稀少，很难得到（多指人才或稀有物品）。","source":{"text":"譬珠玉不可多得，以其珍也。","book":"汉·王充《论衡·超奇篇》"},"example":{"text":"盖北宋以睢漆擅名，今已～。","book":"明·沈德符《万历野获编·时玩》"},"similar":["屈指可数","寥寥无几"],"opposite":["比比皆是","多如牛毛","车载斗量"],"usage":"作谓语、定语；用于人才或稀有物品","story":["东汉末年孔融将文学奇才祢衡进献给汉献帝，祢衡看不起曹操，被曹操派去劝降刘表。刘表将其奉为上宾，安排他到江夏太守黄祖手下做文书。祢衡过目不忘、恃才自傲、目中无人，黄祖迫不得已才将这个不可多得的文学奇才处死"]},{"id":2181,"word":"不可奈何","pinyin":"bù kě mài hé","abbr":"bknh","explanation":"犹无可奈何。表示没有办法。","source":{"text":"上哭甚悲，谓袁盎曰：‘吾不听公言，卒亡淮南王。’盎曰：‘不可奈何，愿陛下自宽。’","book":"《史记·淮南衡山列传》"},"example":{"text":"没有比步枪更厉害的武器，这种碉堡式的住房当真有点～。","book":"茅盾《东江乡村》"},"similar":["无可奈何","无如奈何"],"opposite":["足智多谋"],"usage":"作谓语、定语；指无能为力"},{"id":2182,"word":"不可开交","pinyin":"bù kě kāi jiāo","abbr":"bkkj","explanation":"开：打开，解开；交：相错，纠缠。形容没法解开或摆脱。","source":{"text":"两口子正在吵得不可开交。","book":"清·姬文《市声》第二十四回"},"example":{"text":"倘一加人为，一“办”，那就舆论沸腾，～了。","book":"鲁迅《而已集·谈所谓“大内档案”》"},"similar":["不亦乐乎"],"opposite":["分崩离析"],"usage":"作状语；形容无法了结，不能摆脱"},{"id":2183,"word":"不可思议","pinyin":"bù kě sī yì","abbr":"bksy","explanation":"原有神秘奥妙的意思。现多指无法想象，难以理解。","source":{"text":"诸佛菩萨有解脱名不可思议。","book":"《维摩诘所说经·不思议品》"},"example":{"text":"一片澄澈的蔚蓝色的天宇，高深得～。","book":"郭沫若《少年时代·黑猫》"},"similar":["不可捉摸","神乎其神","玄而又玄"],"opposite":["一目了然","洞若观火","通俗易懂"],"usage":"作谓语、定语、补语；用于人或物"},{"id":2184,"word":"不可抗拒","pinyin":"bù kě kàng jù","abbr":"bkkj","explanation":"抗拒：抵御。无法抵御。","source":{"text":"百万红军进入中国的东北，这个力量是不可抗拒的。","book":"毛泽东《抗日战争胜利后的时局和我们的方针》"},"example":{"text":"王朔《动物凶猛》：“在格斗中表现勇猛和对异性有～的感召力。”"},"usage":"作谓语、定语；用于事物或力量等"},{"id":2185,"word":"不可捉摸","pinyin":"bù kě zhuō mō","abbr":"bkzm","explanation":"捉摸：揣测，预料。指对人或事物无法猜测和估量。","source":{"text":"及一厕足，不能自返，而故为不可摸捉之言以掩之。","book":"明·谢肇淛《五杂俎·人部四》"},"example":{"text":"可是，这个夹肉片和那的嚼饭，都似含着一些～的秘密。","book":"老舍《赵子曰》第十八卷"},"similar":["不可思议","莫名其妙","不堪设想"],"opposite":["一目了然","料事如神"],"usage":"作谓语、定语；用于人的性情及对事物的揣测"},{"id":2186,"word":"不可揆度","pinyin":"bù kě kuí duó","abbr":"bkkd","explanation":"揆：音‘葵’度：音‘夺’揆度：估量，揣测。指无法推测。","source":{"text":"能治五官之事者，不可揆度者也。","book":"《淮南子·兵略训》"},"similar":["莫测高深","深不可测"],"usage":"作谓语、定语；指无法推测"},{"id":2187,"word":"不可摸捉","pinyin":"bù kě mō zhuō","abbr":"bkmz","explanation":"摸捉：揣测，预料。指对人或事物无法猜测和估量。","source":{"text":"及一厕足，不能自返，而故为不可摸捉之言以掩之。","book":"明·谢肇淛《五杂俎·人部四》"},"similar":["不可捉摸"],"opposite":["一目了然"],"usage":"作谓语、定语；用于人的性情及对事物的揣测"},{"id":2188,"word":"不可收拾","pinyin":"bù kě shōu shí","abbr":"bkss","explanation":"收拾：整顿、整理。指事物败坏到无法整顿或不可救药的地步。","source":{"text":"泊与淡相遭，颓堕委靡，溃败不可收拾。","book":"唐·韩愈《送高闲上人序》"},"example":{"text":"蒲殿俊辈登台之后，因为纵容兵士的结果，弄到了一个～的地步。","book":"郭沫若《少年时代·反正前后》"},"similar":["不可救药","土崩瓦解"],"opposite":["旭日东升","蒸蒸日上"],"usage":"作谓语、定语、状语；形容事物破坏得很惨"},{"id":2189,"word":"不可救疗","pinyin":"bù kě jiù liáo","abbr":"bkjl","explanation":"病已重到无法治疗的程度。比喻已经到了无法挽救的地步。","source":{"text":"今楚多淫刑，其大夫逃于四方，而为之谋主，以害楚国，不可救疗。","book":"《左传·襄公二十六年》"},"example":{"text":"希侃忽遘异疾，～。","book":"清·葆光子《物妖志·柳》"},"similar":["不可救药"],"usage":"作谓语、定语、状语；比喻事态严重"},{"id":2190,"word":"不可救药","pinyin":"bù kě jiù yào","abbr":"bkjy","explanation":"药：治疗。病已重到无法用药医治的程度。比喻已经到了无法挽救的地步。","source":{"text":"匪我言耄，尔用忧谑。多将熇熇，不可救药。","book":"《诗经·大雅·板》"},"example":{"text":"怀疑与猜忌，难道就竟已成了他们～的根性了吗？","book":"郑振铎《桂公塘》十四"},"similar":["病入膏肓","气息奄奄","无可救药"],"opposite":["妙手回春","手到病除","旭日东升"],"usage":"作谓语、定语、状语；比喻事态严重","story":["西周时期，周厉王继位后贪财好利，实行残暴统治。老臣凡伯极力劝谏周厉王，他写一首长诗，其中有“多将熇熇，不可救药。”，周厉王不听他的劝谏，继续一意孤行，终于在公元前842年被平民暴动赶下台，西周衰败"]},{"id":2191,"word":"不可教训","pinyin":"bù kě jiào xùn","abbr":"bkjx","explanation":"教训：教育，教诲。对某人无法进行教育。","source":{"text":"颛顼氏有不才子，不可教训，不知话言，告之则顽，舍之则嚣，傲很明德，以乱天常，天下之民谓之‘梼杌’。","book":"《左传·文公十八年》"},"example":{"text":"最下之人，野蛮如虎儿，～。","book":"清·严复、夏曾佑《国闻报馆附印说部缘起》"},"similar":["不可理喻"],"usage":"作谓语、定语；用于人"},{"id":2192,"word":"不可方物","pinyin":"bù kě fāng wù","abbr":"bkfw","explanation":"方物：识别。不能识别，无法分辨。也指无可比拟。","source":{"text":"民神杂糅，不可方物。","book":"《国语·楚语下》"},"example":{"text":"昌黎之后，放翁之前，东坡自成一家，～。","book":"清·赵翼《瓯北诗话·芝东坡诗》"}},{"id":2193,"word":"不可无一，不可有二","pinyin":"bù kě wú yī，bù kě yǒu èr","abbr":"bkwybkye","explanation":"不可以一个没有，也不可以有第二个。指独一无二。","source":{"text":"（太祖）见（张）融常笑曰：‘此人不可无一，不可有二。’","book":"《南齐书·张融传》"},"example":{"text":"如此异才，求之天下，真～也。","book":"明·张岱《琅嬛文集·周宛委墓志铭》"},"similar":["不可无一，不能有二"],"usage":"作谓语、定语；指唯一的"},{"id":2194,"word":"不可无一，不能有二","pinyin":"bù kě wú yī，bù néng yǒu èr","abbr":"bkwybnye","explanation":"形容独一无二或唯一的。","source":{"text":"如此异才，求之天下，真不可无一，不能有二也。","book":"清·张岱《周宛委墓志铭》"},"similar":["不可无一，不可有二"],"usage":"作谓语、定语；指唯一的"},{"id":2195,"word":"不可枚举","pinyin":"bù kě méi jǔ","abbr":"bkmj","explanation":"枚：个。不能够一个个地列举。形容数量、种类极多。","source":{"text":"似此等语，不可枚举。","book":"宋·王楙《野客丛书·俗语有所自》"},"example":{"text":"待罪一年有余，职之罪状殆～。","book":"明·袁宏道《去吴七牍·乞归稿一》"},"similar":["不可胜数","举不胜举"],"opposite":["屈指可数","寥寥无几"],"usage":"作谓语、宾语；形容数量多"},{"id":2196,"word":"不可理喻","pinyin":"bù kě lǐ yù","abbr":"bkly","explanation":"喻：开导，晓喻。没法跟他讲道理。形容蛮横或固执。","source":{"text":"此辈不可理喻，亦不足深诘也。","book":"明·沈德符《万历野获编·褐盖》"},"example":{"text":"他们简直～，一定要进去，终于被我们的人赶出来了。","book":"巴金《家》八"},"similar":["固执己见","一意孤行","顽固不化"],"opposite":["通情达理","入情入理","合情合理"],"usage":"作谓语、定语；形容态度蛮横不讲道理"},{"id":2197,"word":"不可磨灭","pinyin":"bù kě mó miè","abbr":"bkmm","explanation":"磨灭：消失。永远消失不了。指事迹言论等将始终保留在人们的记忆中。","source":{"text":"韩氏之文，没而不见者二百年，而后大施于今，此又非特好恶之所上下，盖其久而愈明，不可磨灭，虽蔽于暂而终耀于无穷者，其道当然也。","book":"宋·欧阳修《记旧本韩文后》"},"example":{"text":"但是我又不知道这是～的事实。","book":"巴金《春雨》八"},"similar":["永垂不朽","流芳百世"],"opposite":["过眼烟云","昙花一现"],"usage":"作谓语、定语；形容业绩等永远流传"},{"id":2198,"word":"不可移易","pinyin":"bù kě yí yì","abbr":"bkyy","explanation":"易：变换。不能动摇、改变。","source":{"text":"有所定，则知其理之确然如是，一定则不可移易，任是千动万动，也动摇他不得。","book":"宋·朱熹《朱子语类》卷十四"},"example":{"text":"不过，他们就得准备实行这样的决议，这是～的。","book":"毛泽东《新民主主义的宪政》"},"similar":["不可动摇"],"usage":"作谓语；形容不可动摇"},{"id":2199,"word":"不可究诘","pinyin":"bù kě jiū jié","abbr":"bkjj","explanation":"究：追查；诘：追问。无法追问到底。","source":{"text":"好好一座中国江山，被这班强有力的大人先生，闹的四分五裂，不可究诘，共和在那里？","book":"蔡东藩、许廑父《民国通俗演义》第一回"},"usage":"作谓语、定语；用于事情"},{"id":2200,"word":"不可端倪","pinyin":"bù kě duān ní","abbr":"bkdn","explanation":"端倪：头绪。找不着头绪。形容变化莫测。","source":{"text":"天地事物之变，可喜可愕，一寓于书。故旭之书，变动犹鬼神，不可端倪。","book":"《庄子·大宗师》：“忘其肝胆，遗其耳目，反复始终，不知端倪。”唐·韩愈《送高闲上人序》"},"example":{"text":"日向午，犹不肯成一字，同人来相敦迫，方始振笔直书，涛怒云舒，～。","book":"清·王晫《今世说·文学》"},"usage":"作谓语；形容变化莫测"},{"id":2201,"word":"不可终日","pinyin":"bù kě zhōng rì","abbr":"bkzr","explanation":"终日：从早到晚，一天。一天都过不下去。形容局势危急或心中极其恐慌不安。","source":{"text":"《礼记·表记》：“君子不以一日使其躬儳焉，如不终日。"},"example":{"text":"就知道中国是处在怎样一种皇皇～的局面之下，处在怎样一种混乱状态之下。","book":"毛泽东《星星之火，可以燎原》"},"similar":["寝食不安","忐忑不安"],"opposite":["安如泰山","处之泰然"],"usage":"作谓语、定语；形容心中惶恐不安"},{"id":2202,"word":"不可缺少","pinyin":"bù kě quē shǎo","abbr":"bkqs","explanation":"必不可少的。","source":{"text":"所有这些，造成了和造成着为中国最后胜利不可缺少的重要的条件。","book":"毛泽东《论持久战》"},"example":{"text":"私人工商业是新民主主义经济～的一部分，我们要扶助它发展。","book":"邓小平《跃进中原的胜利形势与今后的政策策略》"},"similar":["必不可少"],"usage":"作谓语、定语；用于人或事物等"},{"id":2203,"word":"不可胜举","pinyin":"bù kě shèng jù","abbr":"bksj","explanation":"指无法一一枚举，极言其多。","source":{"text":"古之传世者虽不可胜举。而其大较皆豪杰之士，道德充溢于中，事功见于当时。","book":"明·方孝孺《答俞景文》"},"example":{"text":"于卒后书致仕者，～。","book":"清·俞樾《茶香室续钞·身后请致仕》"},"similar":["不可枚举"],"opposite":["屈指可数"],"usage":"作谓语、宾语；形容数量多"},{"id":2204,"word":"不可胜书","pinyin":"bù kě shèng shū","abbr":"bkss","explanation":"不是文字所能写完的。形容要写的事情很多。","source":{"text":"其他推毂荐士为汉廷臣，成天下重名硕望者，不可胜书。","book":"唐·权德舆《齐成公神道碑铭序》"},"example":{"text":"诸署、诸局、诸库等官至掾吏之属，其目甚多，～。然其俸数之多寡，亦皆以品级之高下为则。","book":"《元史·食货志四》"},"similar":["不可胜纪"],"usage":"作谓语、定语；用于计数等"},{"id":2205,"word":"不可胜数","pinyin":"bù kě shèng shǔ","abbr":"bkss","explanation":"胜：尽。数也数不过来。形容数量极多。","source":{"text":"百姓之道疾病而死者，不可胜数。","book":"《墨子·非攻中》"},"example":{"text":"一时乱将起来，舳舻簸荡，乍分乍合，溺死者～。","book":"明·冯梦龙《喻世明言》卷二十二"},"similar":["不胜枚举","多如牛毛","不计其数"],"opposite":["寥寥无几","屈指可数"],"usage":"作谓语、定语、状语；用于人与物","story":["西汉时期，淮南王刘安想起兵造反，多次找郎中伍被商量如何起兵。伍被认为汉高祖之所以得天下是因为秦王暴政，修筑长城死者不可胜数，民众怨声载道，此时起兵将难以成功。伍被另给刘安想了一条起兵之计但最终失败"]},{"id":2206,"word":"不可胜算","pinyin":"bù kě shèng suàn","abbr":"bkss","explanation":"胜：尽。数量多得不可计算。形容数量极多。","source":{"text":"太原吏民苦转运，所经三百八十九隘，前后溺死者不可胜算。","book":"《东观汉记·邓训传》"},"similar":["不可胜数"],"opposite":["屈指可数"],"usage":"作谓语、定语；用于计数等"},{"id":2207,"word":"不可胜纪","pinyin":"bù kě shèng jì","abbr":"bksj","explanation":"不能逐一记述。极言其多。","source":{"text":"汉之得人，于兹为盛，儒雅则公孙弘、董仲舒、兒宽……受遗则霍光、金日磾，其余不可胜纪。","book":"《汉书·公孙弘卜式等传赞》"},"example":{"text":"推衍而析其类，则名目繁多，至～。","book":"马其昶《序》"},"similar":["不可胜记","不可胜计"],"usage":"作谓语、定语；用于计数等"},{"id":2208,"word":"不可胜言","pinyin":"bù kě shèng yán","abbr":"bksy","explanation":"说不尽。形容非常多或到达极点。","source":{"text":"骞曰：‘为汉使月氏，而为匈奴所闭道。今亡，唯王使人导送我。诚得至，反汉，汉之赂遗王财物不可胜言。’","book":"《史记·大宛列传》"},"example":{"text":"姚君一到衙门，快活～，即唤本衙门书吏，把察院的说话，一一对他说了。","book":"明·东鲁古狂生《醉醒石》第一回"},"similar":["不可胜道","不可胜数"],"opposite":["屈指可数"],"usage":"作谓语、定语；形容数量多"},{"id":2209,"word":"不可胜计","pinyin":"bù kě shèng jì","abbr":"bksj","explanation":"胜：尽；计：计算。不能全部计算完。形容数量极多。","source":{"text":"且三秦王为秦将，将秦子弟数岁矣，所杀亡不可胜计。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"作品更为充栋汗牛，～。","book":"郑振铎《插图本中国文学史》第58章"},"similar":["不可胜数"],"opposite":["微乎其微","屈指可数"],"usage":"作谓语、定语；形容数量很多"},{"id":2210,"word":"不可胜记","pinyin":"bù kě shèng jì","abbr":"bksj","explanation":"不能逐一记述。极言其多。","source":{"text":"功隐于视听，不可胜记。","book":"南朝·宋·傅亮《为宋公求加赠刘前军表》"},"similar":["不可胜纪"],"usage":"作谓语、定语；用于计数等"},{"id":2211,"word":"不可胜道","pinyin":"bù kě shèng dào","abbr":"bksd","explanation":"无法尽说。极言其多。","source":{"text":"海外殊俗，重译款塞，请来献见者，不可胜道。","book":"《史记·太史公自序》"},"example":{"text":"自余倡率楚师，转战荆、扬二州之城，其间相从死事者～。","book":"清·曾国藩《林君殉难碑记》"},"similar":["不可胜数"],"opposite":["寥寥无几"],"usage":"作谓语、定语；用于人与物"},{"id":2212,"word":"不可言传","pinyin":"bù kě yán chuán","abbr":"bkyc","explanation":"言：言语。指对某些事理只能揣摩领悟，不能用言语来表达。","source":{"text":"妙契不可以意到，真证不可以言传。","book":"宋·释道原《景德传灯录》卷二十五：“诸法寂灭相，不可以宣言，和尚如何为人？” 明·圆极居顶《续传灯录》卷二十四"},"example":{"text":"医者，意也，脉之深趣，～。","book":"宋·曾慥《类说》卷十五引《谈宾录》"},"opposite":["言传身教"],"usage":"作谓语、定语；用于事理等"},{"id":2213,"word":"不可言喻","pinyin":"bù kě yán yù","abbr":"bkyy","explanation":"喻：说明，告知。不能用言语来说明。","source":{"text":"其术可以心得，不可言喻。","book":"宋·沈括《梦溪笔谈·象数一》"},"example":{"text":"希白见女子容颜秀丽，词气清扬，喜悦之心，～。","book":"明·冯梦龙《警世通言》卷十"},"similar":["不堪言状"],"usage":"作谓语、定语；形容不能用语言来表达"},{"id":2214,"word":"不可言宣","pinyin":"bù kě yán xuān","abbr":"bkyx","explanation":"言：言语；宣：发表，表达。指不是言语所能表达的（用在说事物的奥妙、味道）。","source":{"text":"诸法寂灭相，不可以宣言，和尚如何为人？","book":"宋·释道原《景德传灯录》卷二十五"},"similar":["不可言传"],"usage":"作谓语；用在说事物的奥妙等"},{"id":2215,"word":"不可言状","pinyin":"bù kě yán zhuàng","abbr":"bkyz","explanation":"言：说；状：描绘。无法用言语形容。","source":{"text":"衣有文采，又非锦绮，光彩耀目，不可名状。","book":"晋·葛洪《神仙记·王远》"},"example":{"text":"当时我真悲哀到～。","book":"蒋光慈《少年飘泊者》八"},"similar":["不堪言状","不可名状"],"opposite":["绘声绘色"],"usage":"作谓语、状语；不能用语言来表达"},{"id":2216,"word":"不可轻视","pinyin":"bù kě qīng shì","abbr":"bkqs","explanation":"不能够小看。","source":{"text":"这些发展的政治意义是丝毫不可轻视的。","book":"邓小平《根据地建设与群众运动》"},"similar":["不可忽视"],"usage":"作谓语、定语；用于人或事物等"},{"id":2217,"word":"不可辩驳","pinyin":"bù kě biàn bó","abbr":"bkbb","explanation":"辩驳：提出论据，进行辩论，以反驳对方的论点。指理论精辟，证据确凿，使人无法辩驳。"},{"id":2218,"word":"不可造次","pinyin":"bù kě zào cì","abbr":"bkzc","explanation":"造次：急遽，匆忙。不能匆匆忙忙地进行。意为要慎重。","source":{"text":"此事当深虑远议，不可造次。","book":"明·罗贯中《三国演义》第一百五回"},"example":{"text":"曾朴《孽海花》第16回：“凡奇突的事倒～，还是等你好一点，晚上偷偷儿去探一回。”"},"opposite":["草率从事"],"usage":"作谓语；指要慎重"},{"id":2219,"word":"不可逾越","pinyin":"bù kě yú yuè","abbr":"bkyy","explanation":"逾：越过。不可能超过或不可能越过。","source":{"text":"门不容车，而不可逾越。","book":"《左传·襄公三十一年》"},"example":{"text":"在他看来，上海的学生娃和山寨的青年之间，是有着一道～的鸿沟的。","book":"叶辛《蹉跎岁月》"},"similar":["不可企及","望尘莫及"],"opposite":["后来居上"],"usage":"作谓语、定语；用于自然界或思想意识等"},{"id":2220,"word":"不可避免","pinyin":"bù kě bì miǎn","abbr":"bkbm","explanation":"指不能使不发生的事情。","source":{"text":"而这些矛盾如何不可避免地会在各种不同的阶级社会中，引出各种不同的社会革命。","book":"毛泽东《矛盾论》"},"example":{"text":"路遥《平凡的世界》第一卷第16章：“男女之间就～会出现这种心心思思的现象。”"},"similar":["不可回避"],"usage":"作谓语、定语、状语；用于事情等"},{"id":2221,"word":"不可限量","pinyin":"bù kě xiàn liàng","abbr":"bkxl","explanation":"限量：限定止境、数量。形容前程远大。","source":{"text":"鲍文卿向知府着实赞这季少爷将来不可限量。","book":"清·吴敬梓《儒林外史》第26回"},"example":{"text":"这个年青人的前途～。"},"similar":["前途无量"],"usage":"作谓语；指没有止境"},{"id":2222,"word":"不可须臾离","pinyin":"bù kě xū yú lí","abbr":"bkxyl","explanation":"须臾：片刻。片刻也不能离开。形容非常重要。","source":{"text":"道也者，不可须臾离者也，可离非道也。","book":"《礼记·中庸》"},"example":{"text":"道之～，吾既闻命矣。乃曰‘兴亡何代无之’，竟视亡国为应有之事，真是全无心肝。","book":"清·吴趼人《新笑史·视亡国为应有之事》"},"similar":["息息相关"],"usage":"作谓语、定语；指不可缺少"},{"id":2223,"word":"不可饶恕","pinyin":"bù kě ráo shù","abbr":"bkrs","explanation":"饶恕：原谅过错、冒犯或失礼之处。指不能原谅。","source":{"text":"特别是那时，这种发现都会被认为是不可饶恕的背叛。","book":"王朔《我是“狼”》"},"usage":"作谓语、定语；用于处事"},{"id":2224,"word":"不吃烟火食","pinyin":"bù chī yān huǒ shí","abbr":"bcyhs","explanation":"烟火食：熟食。道教以为仙人可以不吃熟食。旧时用来称赞诗文立意高超，言词清丽，不同一般。","source":{"text":"文潜先与李公择辈来予家作长句。后再同东坡来，坡读其诗，叹息云：‘此不是吃烟火食人道底言语。’","book":"宋·阮阅《诗话总龟前集》卷九引《直方诗话》"},"example":{"text":"我看你每每宁神养性，不食烟火，虽然有些道理；但这上面事迹，你何能晓得，却要观看。","book":"清·李汝珍《镜花缘》第七十回"},"similar":["不食人间烟火"],"usage":"作谓语、定语；指不同凡俗","story":["宋朝时期，王九13岁得了重病，父亲把他抱到青华观，许愿让他做道士。王九梦中见到一个姓阴的鬓发斑白的道士叫他不吃五谷熟食的方法，并给他吃柏树枝。王九醒来后不再吃五谷，神清气爽，只吃生果饮清泉。宋太宗赐他名字赵自然"]},{"id":2225,"word":"不吃羊肉空惹一身膻","pinyin":"bù chī yáng ròu kōng rě yī shēn shān","abbr":"bcyrkryss","explanation":"羊肉没吃上，反倒沾了一身羊膻气。比喻干了某事没捞到好处，反坏了名声惹来了麻烦。","source":{"text":"弄得不吃羊肉空惹一身膻，那是要坏名气的。","book":"清·李宝嘉《官场现形记》第十七回"}},{"id":2226,"word":"不合实际","pinyin":"bù hé shí jì","abbr":"bhsj","explanation":"指想法、计划等不现实。","example":{"text":"请把～的计划修改一下。"},"similar":["不切实际"],"opposite":["切合实际"],"usage":"作谓语、定语；用于虚幻的想法"},{"id":2227,"word":"不合时宜","pinyin":"bù hé shí yí","abbr":"bhsy","explanation":"时宜：当时的需要和潮流。不适合时代形势的需要。也指不合世俗习尚。","source":{"text":"皆违经背古，不合时宜。","book":"《汉书·袁帝纪》"},"example":{"text":"闻得他因～，权势不容，竟投到这里来。","book":"清·曹雪芹《红楼梦》第六十三回"},"similar":["不合时尚","陈词滥调"],"opposite":["因时制宜"],"usage":"作谓语、定语、状语；指过时的或超前的","story":["汉哀帝是汉成帝的养子，20岁继位后经常生病，大臣夏贺良向哀帝建议改元及大赦天下。哀帝立即应允，改了年号后还是经常生病，于是就废除以前改元的诏书，只保留大赦，说夏贺良所做的是违经背道，不合时宜，就杀了他"]},{"id":2228,"word":"不同凡响","pinyin":"bù tóng fán xiǎng","abbr":"btfx","explanation":"凡响：平凡的音乐。形容事物不平凡，很出色。","source":{"text":"他那双炯炯的摄人魂魄的眼睛，聪明的人一定会看出这是个不同凡响的人物。","book":"高云览《小城春秋》第四章"},"example":{"text":"好！士绅之家，～，不是保南世家，还有谁闹得起这么大的排场！","book":"梁斌《播火记》四九"},"similar":["与众不同","卓尔不群","出类拔萃"],"opposite":["平淡无奇","不过尔尔"],"usage":"作谓语、定语；用于表示才能出众"},{"id":2229,"word":"不同戴天","pinyin":"bù tóng dài tiān","abbr":"btdt","explanation":"戴：加在头上或用头顶着。不愿和仇敌在一个天底下并存。形容仇恨极深。","source":{"text":"《礼》，父母之仇，不同戴天。","book":"《公羊传·庄公四年》“讳与仇狩也”汉何休注"},"similar":["不共戴天"],"usage":"作谓语、定语；形容有深仇大恨"},{"id":2230,"word":"不同流俗","pinyin":"bù tóng liú sú","abbr":"btls","explanation":"流俗：流行的习俗。与世俗习气不同。形容品德高尚。","source":{"text":"不从流俗。","book":"《礼记·射义》"},"example":{"text":"庄绍光见萧昊轩气宇轩昂，～，也就着实亲近。","book":"清·吴敬梓《儒林外史》第三十四回"},"usage":"作谓语、定语；用于人或事物等"},{"id":2231,"word":"不名一文","pinyin":"bù míng yī wén","abbr":"bmyw","explanation":"名：占有。一个钱也没有。形容极其贫穷。","source":{"text":"老兄明白，弟半生书剑飘零，寄食江湖，囊中不名一文。","book":"姚雪垠《李自成》第二卷第16章"},"example":{"text":"他生活困难到了～的地步。"},"similar":["不名一钱"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；指非常贫困"},{"id":2232,"word":"不名一格","pinyin":"bù míng yī gé","abbr":"bmyg","explanation":"指不局限于一种规格或一个格局。","source":{"text":"有元一代画家，全讲气韵，不名一格，实能超出唐、宋人刻画之习。","book":"清钱泳《履园丛话·收藏·元》"},"similar":["不拘一格"],"usage":"作宾语、定语、状语；比喻打破常规"},{"id":2233,"word":"不名一钱","pinyin":"bù míng yī qián","abbr":"bmyq","explanation":"名：占有。一个钱也没有。形容极其贫穷。","source":{"text":"通有盗铸钱之罪，景帝考验，通亡，寄死人家，不名一钱。","book":"《史记·佞幸列传》：“竟不得名一钱，寄死人家。”汉·王充《论衡·骨相》"},"example":{"text":"他自己是～的，如何去得，惟有向亲朋借贷。","book":"清·黄小配《大马扁》第一回"},"similar":["囊空如洗","家徒四壁"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；形容很贫穷","story":["汉文帝刘恒的宠臣邓通，很会溜须拍马，甚至用嘴去吮吸文帝的脓疮，深得文帝的信任。文帝赏赐一座铜山给邓通，允许他随意铸钱。汉景帝刘启即位后，十分讨厌邓通的为人，没收了他的一切，使他成为一个真正的乞丐"]},{"id":2234,"word":"不吐不快","pinyin":"bù tǔ bù kuài","abbr":"btbk","explanation":"吐：倾诉；快：痛快。不说出来就不痛快。","example":{"text":"我就是～的性格。"},"similar":["一吐为快","口无遮拦"],"opposite":["胸有城府"],"usage":"作谓语、定语；指一吐为快"},{"id":2235,"word":"不吐不茹","pinyin":"bù tǔ bù rú","abbr":"btbr","explanation":"形容人正直不阿，不欺软怕硬。","source":{"text":"人亦有言，柔则茹之，刚则吐之。维仲山甫，柔亦不茹，刚亦不吐，不侮矜寡，不畏强御。","book":"《诗经·大雅·烝民》"},"example":{"text":"其人达于事理，～，萧规曹植，必获同心之济。","book":"明·张居正《答宣大王巡抚言蓟边要务》"},"similar":["刚正不阿"],"opposite":["欺软怕硬"],"usage":"作谓语、定语；形容人刚正不阿"},{"id":2236,"word":"不吝指教","pinyin":"bù lìn zhǐ jiào","abbr":"blzj","explanation":"不要舍不得指点教导。","source":{"text":"大则以訏谟排祸难，小则以谠正匡过失，内不虑身计，外不恤人言，古人所难也。","book":"《旧唐书·裴度传》"},"example":{"text":"各位以为如何？兄弟说的不对的地方，还请～。","book":"周而复《上海的早晨》第二部四三"},"similar":["不吝珠玉","不吝赐教"],"opposite":["骄傲自满"],"usage":"作谓语、宾语；用于谦虚求教"},{"id":2237,"word":"不吝珠玉","pinyin":"bù lìn zhū yù","abbr":"blzy","explanation":"吝：舍不得。不要舍不得好的东西。恳切希望别人给予指教的谦词。","source":{"text":"恰好听到树上黄莺巧啭，就对拜住道：‘老夫再欲求教，将《满江红》调赋“莺”一首，望不吝珠玉，意下如何？’","book":"明·凌濛初《初刻拍案惊奇》卷九"},"example":{"text":"又幸会司马兄，少年美才。惝～，赐教一律，以志不朽。","book":"明·无名氏《人中画·风流配》"},"similar":["不吝赐教","不吝金玉"],"opposite":["骄傲自满","夜郎自大"],"usage":"作谓语；指恳切希望别人给予指教的客套话"},{"id":2238,"word":"不吝赐教","pinyin":"bù lìn cì jiào","abbr":"blcj","explanation":"吝：吝惜；赐：赏予；教：教导，教诲。不吝惜自己的意见，希望给予指导。请人指教的客气话。","source":{"text":"但我相信倘有请益的时候，先生是一定不吝赐教的。","book":"鲁迅《两地书》五"},"example":{"text":"我在这个问题上没有明白过来，请～。"},"similar":["不吝指教"],"opposite":["骄傲自满"],"usage":"作谓语、宾语；用于谦虚求教"},{"id":2239,"word":"不吝金玉","pinyin":"bù lìn jīn yù","abbr":"bljy","explanation":"吝：吝惜。不吝惜宝贵美好的东西。","source":{"text":"兄如不吝金玉，即求小小做一套，待小弟步韵和将去，便无差失了。","book":"清·荑荻散人《玉娇梨》第八回"},"similar":["不吝珠玉"],"usage":"作谓语；指恳切希望别人给予指教的客套话"},{"id":2240,"word":"不咎既往","pinyin":"bù jiù jì wǎng","abbr":"bjjw","explanation":"咎：责怪。对以往的错误或罪责不再追究。","source":{"text":"成事不说，遂事不谏，既往不咎。","book":"《论语·八佾》"},"example":{"text":"既然他已经承认了错误，我们就可以～了。"},"similar":["既往不咎"],"opposite":["赏罚分明","信赏必罚"],"usage":"作谓语；形容不计较过去的事情"},{"id":2241,"word":"不咸不淡","pinyin":"bù xián bù dàn","abbr":"bxbd","explanation":"①平平淡淡；普普通通。②指冷言嘲笑。","source":{"text":"老婆也辛酸，陪着掉了若干的泪，饶着说上些不咸不淡的话。","book":"王朔《修改后发表》"},"example":{"text":"他一直都是～的态度。"},"similar":["不温不火"],"opposite":["和蔼可亲"],"usage":"作定语、状语；用于人的态度"},{"id":2242,"word":"不哑不聋","pinyin":"bù yǎ bù lóng","abbr":"bybl","explanation":"本指公卿的度量，后常与“不成姑公”等连用，谓不故作痴呆，不装聋作哑，就不能当好阿婆阿公。意指长辈要宽宏大量。同“不痴不聋”。","source":{"text":"绍兴二十八年：‘敢问大众，因甚不觉？岂不见道，不哑不聋，不做大家公。’","book":"《古尊宿语录·大慧普觉禅师》"},"similar":["不痴不聋"],"usage":"作谓语、定语；用于为人"},{"id":2243,"word":"不哼不哈","pinyin":"bù hēng bù hā","abbr":"bhbh","explanation":"不言语，该说而不说。","source":{"text":"算啦，大家不哼不哈，就当没有这码事，回去吧！","book":"冯志《敌后武工队》第十三章一"},"example":{"text":"这下轮到乾隆惊讶了，想不到这个低等嫔妃整日～，竟如此达观知命，这样洞悉人情！","book":"二月河《乾隆皇帝》第四卷二六"},"similar":["不声不响"],"usage":"作谓语、状语；用于蔑视的说法"},{"id":2244,"word":"不啻云泥","pinyin":"bù chì yún ní","abbr":"bcyn","explanation":"不啻：无异于。无异于从云天之上到地上的泥土的距离。比喻差别极大","source":{"text":"然此书与《宝箓天章》，不啻云泥之别。","book":"清·李百川《绿野仙踪》第45回"},"similar":["不啻天渊"],"opposite":["不相上下"],"usage":"作谓语；比喻差别极大"},{"id":2245,"word":"不啻天地","pinyin":"bù chì tiān dì","abbr":"bctd","explanation":"不啻：无异于。无异于天地之别。比喻差别极大。","source":{"text":"贱妾水冰心，多蒙公子云天高谊，从虎口救出，其洪恩大德，不啻天地父母。","book":"明·名教中人《好逑传》第七回"}},{"id":2246,"word":"不啻天渊","pinyin":"bù chì tiān yuān","abbr":"bcty","explanation":"不啻：无异于。渊：深潭。无异于从云天之上到深潭之底。比喻差别极大。","source":{"text":"吴有吴音，越有越语，相去不啻天渊。","book":"清·李渔《闲情偶寄·宾白第四》"},"example":{"text":"比那辛亥革命，直～远隔呢。","book":"蔡东藩、许廑父《民国通俗演义》第二十八回"},"similar":["天壤之别","不啻云泥"],"opposite":["不相上下"],"usage":"作谓语；比喻差别极大"},{"id":2247,"word":"不喑不聋，不成姑公","pinyin":"bù yīn bù lóng，bù chéng gū gōng","abbr":"byblbcgg","explanation":"姑公：婆婆，公公。指作为一家之主，对下辈的过失要能装糊涂。","source":{"text":"不喑不聋，不成姑公。","book":"《释名·释首饰》"},"similar":["不痴不聋，不成姑公"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":2248,"word":"不器之器","pinyin":"bù qì zhī qì","abbr":"bqzq","explanation":"不器：不象器物那样只有某一方面的作用，即不同于一般的才能。指具有全才的人。","source":{"text":"抱不器之器，成乎有用之用。","book":"唐·白居易《君子不器赋》"}},{"id":2249,"word":"不因一事，不长一智","pinyin":"bù yīn yī shì，bù zhǎng yī zhì","abbr":"byysbzyz","explanation":"智：智慧，见识。不经历一件事情，就不能增长对那件事情的见识。同“不经一事，不长一智”。","source":{"text":"老赵州十八上便解破家散宅，徒为戏论，虽然如是，不因一事，不长一智。","book":"宋·悟明禅师《联灯会要·道本禅师》"},"similar":["不经一事，不长一智"],"usage":"作宾语、定语、分句；用于处事"},{"id":2250,"word":"不因不由","pinyin":"bù yīn bù yóu","abbr":"byby","explanation":"犹言无意之中。","source":{"text":"西门庆不因不由，信步走入里面观看。","book":"《金瓶梅词话》第四九回"},"example":{"text":"不说能把他们哄动，他们敬信了，～的，便连上等人也跟着他敬信了。","book":"《二十年目睹之怪现状》第六一回"},"similar":["不知不觉"],"usage":"作状语；用于无意识的行动"},{"id":2251,"word":"不因人热","pinyin":"bù yīn rén rè","abbr":"byrr","explanation":"因：依靠。汉时梁鸿不趁他人热灶烧火煮饭。比喻为人孤僻高傲。也比喻不依赖别人。","source":{"text":"比舍先炊已，呼鸿及热釜炊。鸿曰：‘童子鸿不因人热者也。’灭灶更燃火。","book":"《东观汉记·梁鸿传》"},"example":{"text":"皆能独来独往，～。","book":"清·谭嗣同《论艺》"},"similar":["自力更生"],"opposite":["攀龙附凤"],"usage":"作谓语；比喻人独立，不依靠别人","story":["东汉时期读书人梁鸿因父亲去世，家道衰落，为此他人穷志不穷，逐渐养成孤傲的脾气，不把有钱人看在眼里。他在大学期间自己烧饭，同窗邀请他用他的热炊具，他不同意，坚持在自己的冷灶上生火煮饭，大学毕业后穷困不堪"]},{"id":2252,"word":"不在其位，不谋其政","pinyin":"bù zài qí wèi，bù móu qí zhèng","abbr":"bzqwbmqz","explanation":"不担任这个职务，就不去过问这个职务范围内的事情。","source":{"text":"子曰：不在其位，不谋其政。","book":"《论语·泰伯》"},"example":{"text":"卑职早就打算一个主意，想去回藩台去，又因为是“～”，这种事搁在心上已有多年了。","book":"《晚清文学丛钞·中国现在记》第六回"},"usage":"作谓语、分句；指不过问别人的事情"},{"id":2253,"word":"不在话下","pinyin":"bù zài huà xià","abbr":"bzhx","explanation":"指事物轻微，或者理所当然，不值得一提。","source":{"text":"以下各随次第加官赐赏，这且不在话下。","book":"元·秦简夫《赵礼让肥》四折"},"example":{"text":"太史之类，不过傀儡，其实是～的。","book":"《鲁迅书信集·致章廷谦》"},"similar":["不言而喻","不足齿数"],"opposite":["大书特书"],"usage":"作谓语；用于人与事物"},{"id":2254,"word":"不堪一击","pinyin":"bù kān yī jī","abbr":"bkyj","explanation":"不堪：经不起。形容力量薄弱，经不起一击。也形容论点不严密，经不起反驳。","source":{"text":"这个政府又是一个十分无能的政府，一百五十万以上的大军，不堪一击，仅仅在两个星期的时间中，就葬送了自己的国家。","book":"毛泽东《苏联利益和人民利益的一致》"},"example":{"text":"这篇文章论点不严密，不堪一击。"},"similar":["势单力薄","一触即溃"],"opposite":["坚不可摧","无懈可击","固若金汤"],"usage":"作谓语、定语、补语；形容力量薄弱"},{"id":2255,"word":"不堪入目","pinyin":"bù kān rù mù","abbr":"bkrm","explanation":"指形象丑恶，使人看不下去。","source":{"text":"此数肴也，以先生视之，固不堪入目矣。","book":"清·李汝珍《镜花缘》第二十三回"},"example":{"text":"说着，早一屁股坐下，那种气极败坏的样子，实是～。","book":"《晚清文学丛钞·瞎编奇闻》第三回"},"similar":["行同狗彘","卑鄙龌龊"],"opposite":["赏心悦目"],"usage":"作谓语、定语；形容低级下流的景象"},{"id":2256,"word":"不堪入耳","pinyin":"bù kān rù ěr","abbr":"bkre","explanation":"堪：可，能；入耳：听。指说的话使人听不进去（多指脏话）。","source":{"text":"二词哗于市井，虽儿女子初学言者，亦知歌之，但淫艳亵狎，不堪入耳。","book":"明·李开先《市井艳词序》"},"example":{"text":"姚老夫子见他们所说的都是一派污秽之言，～。","book":"清·李宝嘉《文明小史》第十六回"},"similar":["污言秽语","俗不可耐"],"opposite":["珠圆玉润","娓娓动听"],"usage":"作谓语、宾语；形容脏话难听"},{"id":2257,"word":"不堪其忧","pinyin":"bù kān qí yōu","abbr":"bkqy","explanation":"忧：愁苦。不能忍受那样的愁苦。","source":{"text":"一箪食，一瓢饮，在陋巷，人不堪其忧，回也不改其乐。","book":"春秋·鲁·孔丘《论语·雍也》"},"example":{"text":"这儿环境太嘈杂，居民～。"},"usage":"作谓语、定语；指不能忍受愁苦","story":["春秋时期，孔子的学生颜回生活困难，可他的志向远大，勤奋好学，深得孔子的喜爱。孔子称赞颜回是一个贤德的人，他过着箪食瓢饮的俭朴生活，身处陋巷，别人不堪其忧，他却视此为真正的快乐，只有他能担当大任"]},{"id":2258,"word":"不堪卒读","pinyin":"bù kān zú dú","abbr":"bkzd","explanation":"不堪：不能；卒：完毕，结束。形容文章写得凄惨悲苦，令人心酸，不忍读完。也指文章粗劣，使人不肯读下去。","source":{"text":"柳曰：‘月香姊情词俱哀，令人不堪卒读。’竹曰：‘月香之志亦大可悲已。’雪香闭目不语，泪落衫袖。","book":"清·曹梧冈《梅兰佳话》第九段"},"example":{"text":"余乃憬然悟，喟然叹曰：“噫，筠倩真死矣，此非其病中之日记耶？”此日记语意酸楚，～。","book":"徐枕亚《玉梨魂》第二十九章"}},{"id":2259,"word":"不堪回首","pinyin":"bù kān huí shǒu","abbr":"bkhs","explanation":"堪：可以忍受；回首：回顾，回忆。指对过去的事情想起来就会感到痛苦，因而不忍去回忆。","source":{"text":"最是不堪回首处，九泉烟冷树苍苍。","book":"唐·戴叔伦《哭朱放》"},"example":{"text":"诚有令人～者，则我今日之临眺于此，虽百年之久，曾不能以一瞬尔。","book":"清·无名氏《杜诗言志》"},"similar":["创巨痛深","痛定思痛"],"opposite":["喜出望外","大喜过望"],"usage":"作谓语、定语；用于感慨的语句","story":["公元960年，赵匡胤陈桥兵变建立宋朝，大举进攻与消灭了南平、后蜀、南汉等国。南唐后主李煜不问朝政，只会吟诗作词，被宋朝打败，投降后被封为违命侯。李煜作词：“小楼昨夜又东风，故国不堪回首月明中。”被宋太宗杀害"]},{"id":2260,"word":"不堪收拾","pinyin":"bù kān shōu shí","abbr":"bkss","explanation":"堪：可；收拾：整理，整顿。无法整顿。","source":{"text":"这时的乌云已经弹尽粮绝，几小时以前乌合起来的兵马，现在是丧魂失魄，溃不成军，大有不堪收拾之状了。","book":"孙荪《云赋》"},"similar":["不可收拾"],"usage":"作谓语、定语；指难以收拾"},{"id":2261,"word":"不堪视听","pinyin":"bù kān shì tīng","abbr":"bkst","explanation":"堪：可，能。言辞污秽，行为卑劣，不能看与听。","source":{"text":"其菲薄揶揄，不堪视听。","book":"严复《论中国之阻力与离心力》"},"similar":["不堪入目","不堪入耳"],"usage":"作谓语、定语；指人的言行等"},{"id":2262,"word":"不堪言状","pinyin":"bù kān yán zhuàng","abbr":"bkyz","explanation":"指无法用语言来形容。","source":{"text":"然而我在南京住了几时，官场上面的举动，也见了许多，竟有不堪言状的。","book":"清·吴趼人《二十年目睹之怪现状》第22回"},"example":{"text":"唐山地震真是～。"},"similar":["不可名状"],"usage":"作谓语、补语；用于不好的状况等"},{"id":2263,"word":"不堪设想","pinyin":"bù kān shè xiǎng","abbr":"bksx","explanation":"未来情况不能想象。指预料事情会发展到很坏的地步。","source":{"text":"纵使十次速灭，而设一次迁延，则桑梓之患，不堪设想。","book":"清·曾国藩《复吴南屏书》"},"example":{"text":"倘使没有这个人来阻拦一下，那天的情形恐将～的了。","book":"巴金《旅途通讯·桂林的受难》"},"similar":["不可思议","危如累卵","凶多吉少"],"opposite":["相安无事","安然无恙"],"usage":"作谓语、定语、补语；用于指消极方面的事"},{"id":2264,"word":"不堪造就","pinyin":"bù kān zào jiù","abbr":"bkzj","explanation":"指没有培养前途。","source":{"text":"第三是学生们既然做不出文章，便是不堪造就，应当淘汰出去——这是清校。","book":"茅盾《蚀·追求》八"},"example":{"text":"他不能相信她的本质就是～的。","book":"老舍《四世同堂》五"},"similar":["不宜深造","不成气候","不务正业"],"opposite":["孺子可教","前途无量","鹏程万里"],"usage":"作谓语、宾语、定语；形容没有造就"},{"id":2265,"word":"不塞下流，不止不行","pinyin":"bù sè xià liú，bù zhǐ bù xíng","abbr":"bsxlbzbx","explanation":"指对佛教、道教如不阻塞，儒家学说就不能推行。现比喻不破除旧的、坏的东西，新的、好的东西就建立不起来。","source":{"text":"然则如之何而可也？曰：不塞不流，不止不行。","book":"唐·韩愈《原道》"},"example":{"text":"不把这种东西打倒，什么新文化都是建立不起来的。不破不立，～。","book":"毛泽东《新民主主义论》"}},{"id":2266,"word":"不塞不流，不止不行","pinyin":"bù sāi bù liú，bù zhǐ bù xíng","abbr":"bsblbzbx","explanation":"比喻只有破除旧的、错误的东西，才能建立新的、正确的东西。","source":{"text":"然则如之何而可也？曰：不塞不流，不止不行，人其人，火其书，庐其居。","book":"唐·韩愈《原道》"},"example":{"text":"不把这种东西打倒，什么新文化都是建立不起来的。不破不立，～，它们之间的斗争是生死斗争。","book":"毛泽东《新民主主义论》十一"},"similar":["不破不立"],"usage":"作谓语、分句；形容不破不立"},{"id":2267,"word":"不声不吭","pinyin":"bù shēng bù kēng","abbr":"bsbk","explanation":"指不说话；不出声。","source":{"text":"还在半个月前，张腊月隐隐听说，南二社有个吴淑兰的妇女队长，在不声不吭地跟她暗赛。","book":"王汶石《新结识的伙伴》"},"example":{"text":"等到人们七嘴八舌把话都说光倒净以后，他～，唿豁开人，带着一股风直向工程队队部走去。","book":"杜鹏程《在和平的日子里》第一章二"},"similar":["不声不响","默不做声"],"opposite":["大喊大叫","大吵大闹"],"usage":"作谓语、定语；指默不做声"},{"id":2268,"word":"不声不响","pinyin":"bù shēng bù xiǎng","abbr":"bsbx","explanation":"指不说话；不出声。","source":{"text":"偶或有独自低着头不声不响的，那一定是失败者。","book":"茅盾《子夜》十一"},"example":{"text":"这是试探咱，要是咱～，以后开会就不再咱啰。","book":"柳青《狠透铁》三"},"similar":["无声无息","不声不气"],"opposite":["大喊大叫","大吵大闹"],"usage":"作谓语、定语、状语；形容没有声音"},{"id":2269,"word":"不声不气","pinyin":"bù shēng bù qì","abbr":"bsbq","explanation":"指不说话；不出声。","source":{"text":"你们只想自己的爱人像旧式妇女一样，百依百顺，不声不气，来服侍你们。","book":"周立波《山乡巨变》上一"},"similar":["不声不响"],"usage":"作谓语、定语、状语；形容没有声音"},{"id":2270,"word":"不壹而三","pinyin":"bù yī ér sān","abbr":"byes","explanation":"指再三；多次。","source":{"text":"子贡既与卫将军文子言。适鲁，见孔子曰：‘卫将军文子问二三子之于赐，不壹而三焉。赐也辞，不获命；以所见者对矣。’","book":"《孔子家语·弟子行》"},"similar":["几次三番"],"usage":"作谓语、状语；用于多次"},{"id":2271,"word":"不壹而足","pinyin":"bù yī ér zú","abbr":"byez","explanation":"足：充足。指同类的事物不只一个而是很多，无法列举齐全。同“不一而足”。","source":{"text":"言节制之，不皆称其所求也。","book":"《汉书·陈汤传》：“御使大夫财禹、博士匡衡以为《春秋》之义‘许夷狄者，不壹而足’，今郅支单于乡化未醇，所在绝远，宜令使者送其子至塞而还。”颜师古注"},"similar":["不一而足"],"usage":"作谓语、分句；用于句尾"},{"id":2272,"word":"不复堪命","pinyin":"bù fù kān mìng","abbr":"bfkm","explanation":"指无法再活下去。","source":{"text":"重之以大军，疲之以远戍……田畴不得垦辟，禾稼不得收入，搏手因穷，无望来秋。百姓力屈，不复堪命。","book":"《后汉书·庞参传》"},"example":{"text":"评米责钱，凡诸求利皆悉如此，百姓嗷然，～。","book":"《宋书·晋平王休祐传》"},"usage":"作谓语、定语；指陷入绝境"},{"id":2273,"word":"不大对头","pinyin":"bù dà duì tóu","abbr":"bddt","explanation":"有了问题，出了毛病，指有失调的迹象。","source":{"text":"我觉得马锐这孩子近来有些表现不大对头，出现了一些很不好的苗头。","book":"王朔《我是你爸爸》"},"example":{"text":"他感到胃开始～了。"},"similar":["不大对劲"],"usage":"作谓语、宾语；指不对劲，用于口语"},{"id":2274,"word":"不失圭撮","pinyin":"bù shī guī cuō","abbr":"bsgc","explanation":"圭撮：容量词，六栗为一圭，十圭为一撮。形容数量准确。","source":{"text":"量多少者不失圭撮。","book":"《汉书·律历志上》"},"similar":["丝毫不差"],"opposite":["天差地别"],"usage":"作谓语；形容数量准确"},{"id":2275,"word":"不失旧物","pinyin":"bù shī jiù wù","abbr":"bsjw","explanation":"旧物：指原有的事业或原有的山河。比喻恢复了原有的的事业或原有的山河。","source":{"text":"祀夏配天，不失旧物。","book":"春秋·鲁·左丘明《左传·哀公元年》"},"example":{"text":"齐人归郓、灌之田，～。","book":"宋·杨万里《诚斋诗话》引洪景伯《贺表》"},"similar":["完璧归赵","物归原主"],"usage":"作谓语；指完全恢复"},{"id":2276,"word":"不失时机","pinyin":"bù shī shí jī","abbr":"bssj","explanation":"失：耽误，错过。时机：具有时间性的机会。不错过当前的机会。指办事要抓住适宜的时间和有利的机会。","source":{"text":"这时离国共分裂还有两个月，如果……努力去做，还不失时机。","book":"周恩来《关于党的“六大”的研究》"},"example":{"text":"用兵贵在～。"},"similar":["机不可失"],"opposite":["坐失良机"],"usage":"作谓语、宾语；指抓住机会"},{"id":2277,"word":"不失毫厘","pinyin":"bù shī háo lí","abbr":"bshl","explanation":"失：差。毫厘：很小的重量或长度的单位。不差一毫一厘米。","source":{"text":"圣人也者，本仁义，当是非，齐言行，不失豪（毫）厘，无它道焉，已乎行之矣。","book":"《荀子·儒效》"},"similar":["不差毫厘","毫厘不差"],"opposite":["天差地别"],"usage":"作谓语、定语；指十分精确"},{"id":2278,"word":"不失黍絫","pinyin":"bù shī shǔ lěi","abbr":"bssl","explanation":"犹言丝毫不差。絫、黍，微小的重量。","source":{"text":"十黍为絫，十絫为一铢。","book":"《汉书·律历志上》：“权轻重不失黍絫。”颜师古注引应劭曰"},"similar":["不爽累黍"],"opposite":["千差万别"],"usage":"作谓语、宾语；形容一点不差"},{"id":2279,"word":"不夷不惠","pinyin":"bù yí bù huì","abbr":"bybh","explanation":"夷：指伯夷；惠：指柳下惠。不做伯夷也不学柳下惠。比喻折衷而不偏激。","source":{"text":"不夷不惠，可否之间也。","book":"汉·扬雄《法言·渊骞》"},"example":{"text":"～行中论。","book":"清·魏源《廖含虚先生墓志铭》"},"similar":["中庸之道"],"usage":"作谓语、定语；形容中庸温和","story":["西汉时期，学识渊博的李宏曾经被任命为一个外地的县令，他本心就不想去，乡亲们设宴送行，他借机与他们畅饮，拖了一个多月还不去，刺史派人教他上任，他就到外地游玩就是不去赴任。扬雄说他不做伯夷也不做柳下惠"]},{"id":2280,"word":"不夺农时","pinyin":"bù duó nóng shí","abbr":"bdns","explanation":"不耽误农作物的耕种时节。同“不违农时”。","source":{"text":"是以轻徭薄赋，不夺农时，宁积于人无藏于府。","book":"《旧唐书·李密传》"},"example":{"text":"我们要～，尽快发展农业生产。"},"similar":["不违农时"],"usage":"作谓语；指不要错过播种季节"},{"id":2281,"word":"不奈之何","pinyin":"bù nai zhī hé","abbr":"bnzh","explanation":"指无可奈何，无法可想。","source":{"text":"相国老夫人听得悲泣，不奈之何，故谒微生，愿求脱命计。","book":"金董解元《西厢记诸宫调》卷八"},"similar":["无可奈何"],"usage":"作谓语、定语；指无法"},{"id":2282,"word":"不好不坏","pinyin":"bù hǎo bù huài","abbr":"bhbh","explanation":"既不值得称赞，也不值得责备的。过得去的，中等的。","example":{"text":"他的工作做得～。"},"opposite":["出类拔萃"],"usage":"作谓语、定语、状语；指中等的"},{"id":2283,"word":"不好意思","pinyin":"bù hǎo yì sī","abbr":"bhys","explanation":"①表示碍于情面而只能怎样或不便怎样。②害羞；难为情。","source":{"text":"去年因打了薛呆子，他不好意思见我们的，不知那里去了一向。","book":"清·曹雪芹《红楼梦》第66回"},"example":{"text":"她被人夸得～了。"},"similar":["难以为情"],"usage":"作谓语、状语；用于口语"},{"id":2284,"word":"不如归去","pinyin":"bù rú guī qù","abbr":"brgq","explanation":"杜鹃鸟的叫声很象“不如归去”。旧时常用以作思归或催人归去之辞。也表示消极求退。","source":{"text":"不如归去语，亦自古来传。","book":"宋·梅尧臣《杜鹃》诗"},"example":{"text":"杜鹃，其鸣若曰～。","book":"明·李时珍《本草纲目·禽部》"},"usage":"作谓语、宾语；指催人归家"},{"id":2285,"word":"不如意事常八九","pinyin":"bù rú yì shì cháng bā jiǔ","abbr":"bryscbj","explanation":"指不合心意的事情是经常发生的。","source":{"text":"会秦、凉屡败，祜复表曰：‘吴平，则胡自定，但当速济大功耳。’而议者多不同。祜叹曰：‘天下不如意，恒十居七八，故有当断不断。’","book":"语出《晋书·羊祜传》"},"example":{"text":"～，可语人言无二三。","book":"《白雪遗音·南词·十二时》"},"usage":"作宾语、定语；用于感慨等"},{"id":2286,"word":"不媿下学","pinyin":"bù kuì xià xué","abbr":"bkxx","explanation":"犹言不耻下问。","source":{"text":"是以君王无羞亟问，不媿下学。","book":"《战国策·齐策四》"}},{"id":2287,"word":"不存不济","pinyin":"bù cún bù jì","abbr":"bcbj","explanation":"指支持不住，受不住。","source":{"text":"不存不济，香肌瘦损，教俺萦方寸。","book":"金·董解元《西厢记诸宫调》卷七"},"example":{"text":"闪的个老业人～，则俺这养家儿千死千休。","book":"元·无名氏《冤家债主》第二折"},"similar":["半死不活"],"usage":"作谓语、定语；表示吃不消"},{"id":2288,"word":"不存之地","pinyin":"bù cún zhī dì","abbr":"bczd","explanation":"非常危险的境地。","source":{"text":"今陛下好凌岨险，射猛兽，卒然遇轶才之兽，骇不存之地。","book":"汉·司马相如《上书谏猎》"}},{"id":2289,"word":"不存芥蒂","pinyin":"bù cún jiè dì","abbr":"bcjd","explanation":"芥蒂：本作“蒂芥”，细小的梗塞物，比喻积在心里的怨恨或不快。心里不积存怨恨和不快。形容人心地宽，气量大。","source":{"text":"吞若云梦者八九于其胸中，曾不蒂芥。","book":"汉·司马相如《子虚赋》"},"example":{"text":"他一向是心里～的。"},"similar":["宽宏大量"],"opposite":["心存芥蒂"],"usage":"作谓语、定语；指心里不积存怨恨和不快"},{"id":2290,"word":"不孝之子","pinyin":"bù xiào zhī zǐ","abbr":"bxzz","explanation":"不孝顺的子孙。","source":{"text":"不孝之子宋江，自小忤逆，不肯本分生理，要去做吏，百般说他不从。","book":"明·施耐庵《水浒传》第22回"},"example":{"text":"请原谅我这个～吧。"},"similar":["不肖子孙"],"opposite":["孝子贤孙"],"usage":"作主语、宾语；多用于自谦"},{"id":2291,"word":"不学无术","pinyin":"bù xué wú shù","abbr":"bxws","explanation":"学：学问；术：技能。原指没有学问因而没有办法。现指没有学问，没有本领。","source":{"text":"然光不学亡术，暗于大理。","book":"《汉书·霍光传赞》"},"example":{"text":"都说他的人是个好的，只可惜了一件，是犯了“～”四个字的毛病。","book":"清·李宝嘉《官场现形记》第五十六回"},"similar":["目不识丁","胸无点墨"],"opposite":["博古通今","博学多才"],"usage":"作谓语、定语；指人无学术、没本事","story":["宋朝宰相寇准是一代名相，他的朋友张咏认为其学术不足，寇准向张咏请教，张咏给他讲汉朝大将霍光的故事，因为班固称霍光不爱读书为“不学无术”，寇准听后立即认识到自己的缺点与不足"]},{"id":2292,"word":"不学无识","pinyin":"bù xué wú shí","abbr":"bxws","explanation":"指没有学问，缺乏见识。","source":{"text":"大理少卿朱斐对上，指大理寺为诏狱。公论‘斐不自知职业何事，不学无识’，竟罢斐。","book":"宋·叶適《故枢密参政汪公墓志铭》"},"example":{"text":"世皇《下江南檄》枚举贾似道无君之罪，宋国臣民其不诚服者与。其文曰：‘……～，舞术弄权。’","book":"明·陶宗仪《辍耕录·檄》"},"similar":["不学无术"],"opposite":["博学多才"],"usage":"作谓语、定语；指人无学术、没本事"},{"id":2293,"word":"不学面墙","pinyin":"bù xué miàn qiáng","abbr":"bxmq","explanation":"指不学无知。","source":{"text":"人而不学如面向墙，无所睹见。","book":"《书·周官》：“不学墙面，莅事惟烦。”孔传：“人而不学其犹正墙面而立。”孔颖达疏"},"example":{"text":"［汉成帝］之精《诗》《书》观古文者，何以贤于～者乎！","book":"清·钱谦益《向言》之一"},"similar":["不学无术"],"usage":"作定语；用于劝诫人"},{"id":2294,"word":"不宁唯是","pinyin":"bù níng wéi shì","abbr":"bnws","explanation":"宁：语助词，无义；唯：只是；是：这样。不只是这样。即不仅如此。","source":{"text":"不宁唯是，又使围蒙先君。","book":"《左传·昭公元年》"},"example":{"text":"无一幅自制之精密地质图(并文土性等图)，非文明国，～；必殆将化为僵石，供后人摩挲叹息。","book":"鲁迅《集外集拾遗·中国地质略论》"},"similar":["不仅如此"],"usage":"作分句；指不仅如此","story":["春秋时期，楚国将军公子围与郑国的丰氏订立婚约，他想借迎亲的机会偷袭郑国，就带兵到郑国来，郑人识破他的诡计，坚持不让他不让他进城，公子围游说这样做会让他得到君主的重用，除此之外还会让天下人耻笑。郑人坚决不允，他只好独自进城完婚"]},{"id":2295,"word":"不安于位","pinyin":"bù ān yú wèi","abbr":"bayw","explanation":"指不喜欢自己的职业，不安心工作。","source":{"text":"不安其位，宜不能久。","book":"《左传·成公六年》"},"example":{"text":"此公在厦门趋奉校长，颜膝可怜，适异己去后，而校长又薄其为人，终于～，殊可笑也。","book":"鲁迅《书信集·致郑振铎》"},"opposite":["忠于职守"],"usage":"作谓语；形容不安心工作"},{"id":2296,"word":"不安于室","pinyin":"bù ān yú shì","abbr":"bays","explanation":"指已婚妇女又乱搞男女关系。","source":{"text":"不安其室，欲去嫁也。","book":"《诗经·邺风·凯风序》：“卫之淫风流行，虽有七子之母，犹不能安其室。”郑玄注"},"example":{"text":"她成了寡妇后就开始～。"},"similar":["红杏出墙"],"usage":"作谓语、定语；形容已婚女子思外遇"},{"id":2297,"word":"不安其室","pinyin":"bù ān qí shì","abbr":"baqs","explanation":"指已婚妇女又乱搞男女关系。","source":{"text":"卫之淫风流行，虽有七子之母，犹不能安其室。","book":"《诗经·邺风·凯风·序》"},"example":{"text":"所谓“～”者，不过因衣服饮食不称心，在家吵闹，七子所以自认不是。","book":"清·吴敬梓《儒林外史》第三十四回"},"similar":["不安于室"],"usage":"作谓语、定语；形容已婚女子思外遇"},{"id":2298,"word":"不安小成","pinyin":"bù ān xiǎo chéng","abbr":"baxc","explanation":"成：成就。不满足于自己已有的成就或职位。","source":{"text":"据他之才，已自可仕，只是他不伏如此，又欲求进。……便是不安于小成也。","book":"宋·朱熹《朱子全书·论语四》"}},{"id":2299,"word":"不安本分","pinyin":"bù ān běn fèn","abbr":"babf","explanation":"本分：本身应尽的的职责和应守的规矩。指不甘于所处的地位和受到的待遇，思想言行越出正轨。","source":{"text":"但宗宗匪案，都有此有脚踪，定然是个不安本分……的后生。","book":"清·李绿园《歧路灯》第六十四回"},"example":{"text":"如有～，出外滋事者，除将本犯照例治罪外，定将该管太监一并惩办。","book":"蔡东藩《慈禧太后演义》第十二回"},"similar":["不守本分","不依本分"],"opposite":["安分守己"],"usage":"作谓语、定语；指人不守规矩","story":["贾宝玉自从有了秦钟作伴上学后，整天与秦钟混在一起，他本是一个不安本分的人，现在更加随心所欲了。贾政只当他上学，也不怎么管他。宝玉与秦钟忘记了辈分，竟称兄道弟起来，宝玉有时直接叫秦钟的表字，秦钟也习以为常"]},{"id":2300,"word":"不实之词","pinyin":"bù shí zhī cí","abbr":"bszc","explanation":"浮夸的言辞。","example":{"text":"他的那一段话并非是空洞浮夸～。"},"similar":["一面之词"],"usage":"作宾语；指虚假的话"},{"id":2301,"word":"不宣而战","pinyin":"bù xuān ér zhàn","abbr":"bxez","explanation":"指不宣布开战，就突然发起进攻。","example":{"text":"美国对伊拉克～。"},"opposite":["先礼后兵"],"usage":"作谓语；指突然发起进攻"},{"id":2302,"word":"不容争辩","pinyin":"bù róng zhēng biàn","abbr":"brzb","explanation":"由不得他人争论。表示事实或道理已十分清楚，无须再说什么。","similar":["不容置辩"],"opposite":["洗耳恭听"]},{"id":2303,"word":"不容分说","pinyin":"bù róng fēn shuō","abbr":"brfs","explanation":"分说：辩白，解说。不容人分辩解释。","source":{"text":"怎么不由分说，便将我飞拳走踢只是打。","book":"元·武汉臣《生金阁》三折"},"example":{"text":"宝钗～，笑灌了湘云一杯。","book":"清·曹雪芹《红楼梦》第六十二回"},"similar":["无庸置辩"],"usage":"作分句、状语；指不允许分辩陈说"},{"id":2304,"word":"不容置喙","pinyin":"bù róng zhì huì","abbr":"brzh","explanation":"不容许插嘴。","example":{"text":"他的文章没读过三遍～。"},"similar":["不许插嘴","不容置辩"],"usage":"作谓语；形容没有说话的机会"},{"id":2305,"word":"不容置疑","pinyin":"bù róng zhì yí","abbr":"brzy","explanation":"不允许有什么怀疑。表示论证严密，无可怀疑。","source":{"text":"盖其灵响暴著，亦有不容置疑者矣。","book":"宋·陆游《严州乌龙广济庙碑》"},"example":{"text":"报告的内容与群众反映的情况一致，～。"},"similar":["千真万确","无可置疑"],"opposite":["荒诞不经","无稽之谈"],"usage":"作谓语、定语、状语；形容真实正确可靠"},{"id":2306,"word":"不容置辩","pinyin":"bù róng zhì biàn","abbr":"brzb","explanation":"置：安放。不容许别人进行辩解。指没有辩护的余地。","source":{"text":"吾合休矣。既而俘者尽释，惟某后至，不容置辩，立斩之。","book":"清·蒲松龄《聊斋志异·三生》"},"example":{"text":"不，这都是事实，～的事实！","book":"艾立国《人生能有几次搏》"},"similar":["不容分说"],"usage":"作谓语、定语、状语；指不允许分辩陈说"},{"id":2307,"word":"不宾之士","pinyin":"bù bīn zhī shì","abbr":"bbzs","explanation":"宾：客人。不以客人自居的人士。形容以主人翁的面目出现的人，敢于提意见，提建议。现多指实事求是，不客气、不虚伪的正直人士。","source":{"text":"天子以示公卿，诏曰：‘自古明王圣主，必有不宾之士。’","book":"《后汉书·周党传》"},"usage":"作宾语；指敢于提意见的人"},{"id":2308,"word":"不寒而栗","pinyin":"bù hán ér lì","abbr":"bhel","explanation":"栗：畏惧，发抖。不冷而发抖。形容非常恐惧。","source":{"text":"是日皆报杀四百余人，其后郡中不寒而栗，滑民佐吏为治。","book":"《史记·酷吏列传》"},"example":{"text":"岂果脂粉之气，不势而威？胡乃肮脏之身，～。","book":"清·蒲松龄《聊斋志异·马介甫》"},"similar":["毛骨悚然","提心吊胆","胆战心惊"],"opposite":["无所畏惧","临危不惧"],"usage":"作谓语、定语、状语；用于恐怖的场合","story":["西汉汉武帝时酷吏义纵，在任定襄太守时，将狱中重刑犯120多人全部判死刑，罪犯家属买通狱卒探监，结果也都全被判死刑，一天就处死400多人，一时引起很大的震动，人们纷纷感到非常恐怖寒栗，担心有一天会被义纵杀掉"]},{"id":2309,"word":"不少概见","pinyin":"bù shǎo gài jiàn","abbr":"bsgj","explanation":"概：梗概，大略。所能见到的只是一个梗概。指很难真正见到。","source":{"text":"余以所闻由、光义至高，其文辞不少概见，何哉？","book":"《史记·伯夷列传》"},"opposite":["司空见惯"],"usage":"作谓语、定语；用于事物"},{"id":2310,"word":"不尴不尬","pinyin":"bù gān bù gà","abbr":"bgbg","explanation":"比喻左右为难，不好处理。也形容样子别扭。","source":{"text":"圣人全体极至，没那不间不界底事。","book":"宋·吴泳《赋半斋送张清分教嘉定》：“道如大路皆可遵，不尴不尬难为人。”《朱子语类》卷三四"},"example":{"text":"外甥女少不得的是我们养着，牛姑爷也该做出一个主意来，只管～住着，也不是事。","book":"清·吴敬梓《儒林外史》第二十二回"},"similar":["骑虎难下","左右为难","进退两难"],"opposite":["泰然自若","左右逢源"],"usage":"作状语、定语；形容处境窘迫","story":["薛蟠外出做生意时与酒保发生冲突，失手打死了酒保被捕入狱。家人筹集银子派薛蝌前去营救，结果被判过失杀人，但事情还没了结。薛蝌回家后，薛蟠的妻子金桂与小妾宝蟾借送酒慰劳之机勾引薛蝌。薛蝌讨厌这种鬼鬼祟祟不尴不尬的事情，置之不理"]},{"id":2311,"word":"不屈不挠","pinyin":"bù qū bù náo","abbr":"bqbn","explanation":"屈：屈服；挠：弯曲。比喻在压力和面前不屈服，表现十分顽强。","source":{"text":"乐昌笃实，不桡不诎。","book":"《汉书·叙传下》"},"example":{"text":"教皇捉了他回，他在堂上～，定归开出信教自由的理数。","book":"清·颐琐《黄绣球》第二十九回"},"similar":["坚忍不拔","百折不挠","视死如归"],"opposite":["卑躬屈膝","奴颜婢膝"],"usage":"作谓语、定语、状语；形容人顽强","story":["汉成帝时期，丞相王商为人正直，敢于同恶势力在不屈不挠的斗争，他力劝汉成帝不要听信大将军王凤的谣言带头去避难，受到汉成帝的表彰。他不惜自己的官位也要将玩忽职守的琅玡太守杨彤罢免，因此得罪了他的亲戚王凤，因此被陷害"]},{"id":2312,"word":"不屑一顾","pinyin":"bù xiè yī gù","abbr":"bxyg","explanation":"不屑：不值得，不愿意；顾：看。认为不值得一看。形容极端轻视。","source":{"text":"夫禄之以天下而系马千驷，常人思以其身易之而不可得，而伊尹不屑一顾视焉。","book":"明·方孝儒《送龚彦佐序》"},"example":{"text":"我的眼光是一直线，只看前面的，两旁和后方，悍都然～了。","book":"清·曾朴《孽海花》第二十八回"},"similar":["不足挂齿","嗤之以鼻"],"opposite":["刮目相看","举足轻重"],"usage":"作谓语、定语；形容蔑视、轻视"},{"id":2313,"word":"不屑教诲","pinyin":"bù xiè jiào huì","abbr":"bxjh","explanation":"认为不值得教训。","example":{"text":"虽受过多年的感化教育，他仍然不改偷窃的恶习，这样的人已是让人～的了。"}},{"id":2314,"word":"不屑毁誉","pinyin":"bù xiè huǐ yù","abbr":"bxhy","explanation":"不屑：不值得，表示轻视态度；毁誉：毁谤和赞誉。指不值得理睬别人的毁谤或赞誉。","source":{"text":"尽心纳忠，不屑毁誉。","book":"《后汉书·马廖传》"},"usage":"作谓语、定语；用于处事"},{"id":2315,"word":"不屑置辩","pinyin":"bù xiè zhì biàn","abbr":"bxzb","explanation":"屑：认为值得；置辩：辩论，申辩。认为不值得分辩。","source":{"text":"孔乙己看着问他的人，显出不屑置辩的神气。","book":"鲁迅《孔乙己》"},"example":{"text":"我对此事都～。"},"similar":["不屑置言"],"usage":"作谓语、定语；指不愿辩解"},{"id":2316,"word":"不左右袒","pinyin":"bù zuǒ yòu tǎn","abbr":"bzyt","explanation":"左右袒：裸露出左右臂。露左臂表示支持某一方面，露右臂表示支持另一方面。指不偏向任何一方。","source":{"text":"为吕氏右袒，为刘氏左袒。","book":"《史记·吕后本纪》"},"example":{"text":"王成又懦，不敢为左右袒。","book":"清·蒲松龄《聊斋志异·珊瑚》"},"similar":["不偏不倚"],"opposite":["偏私护短"],"usage":"作谓语；用于为人"},{"id":2317,"word":"不差上下","pinyin":"bù chā shàng xià","abbr":"bcsx","explanation":"不分高下，差不多。","source":{"text":"一般是鲜花嫩柳，与众姊妹不差上下。","book":"清·曹雪芹《红楼梦》第80回"},"example":{"text":"这个一向坚实乐观的汉子第一次遭到烦扰的袭击了，简直就同一个处在这种境况的平常人～：一点抓拿没有。","book":"沙汀《在其香居茶馆里》"},"similar":["不相上下"],"opposite":["天差地别"],"usage":"作谓语、定语；形容基本上一致"},{"id":2318,"word":"不差毫厘","pinyin":"bù chā háo lí","abbr":"bchl","explanation":"不差一毫一厘。","source":{"text":"显晦之事，不差毫厘矣。","book":"宋·李昉《太平广记》第158卷引《玉堂闲话·许生》"},"example":{"text":"这两件作品真是～。"},"similar":["毫厘不差","丝毫不差"],"opposite":["差之千里"],"usage":"作谓语、宾语；指丝毫不差"},{"id":2319,"word":"不差毫发","pinyin":"bù chā háo fà","abbr":"bchf","explanation":"毫、发：都是古代的长度名，十毫为发，十发为厘，形容细微。形容一点儿也不差。","source":{"text":"令仪半在地上，半在地下，晦朔弦望，不差毫发。","book":"唐·张说《进浑仪表》"},"example":{"text":"自慊，正与自欺相对，～。","book":"《朱子语类》卷十六"},"similar":["毫厘不差","不差毫厘","丝毫不差"],"opposite":["差之千里"],"usage":"作谓语、定语；指丝毫不差"},{"id":2320,"word":"不差累黍","pinyin":"bù chā lěi shǔ","abbr":"bcls","explanation":"累黍：是古代两种很小的重量单位，形容数量极小。形容丝毫不差。","source":{"text":"权经重者不失黍累。","book":"《汉书·律历志上》"},"example":{"text":"并行而上，～。","book":"清·淮阴百一居士《壶天录》卷上"},"similar":["准确无误","丝毫不差"],"opposite":["天壤之别"],"usage":"作谓语、定语；形容丝毫不差"},{"id":2321,"word":"不干不净","pinyin":"bù gān bù jìng","abbr":"bgbj","explanation":"指不洁净，肮脏。也指因忌讳而感觉不洁净。也可形容语言不文明。","source":{"text":"不干不净，也不知道毛病儿，买了来三日两日，又弄鬼掉猴的。","book":"清·曹雪芹《红楼梦》第四十六回"},"example":{"text":"那时节，弄得顷刻烟销，我依然一个穷鬼，还落得～。","book":"清·杨潮观《吟风阁杂剧·穷阮藉醉骂财神》"},"similar":["偷鸡摸狗"],"opposite":["光明正大"],"usage":"作谓语、定语；指事物或人的行为","story":["大观园里贾宝玉一人上学觉得孤单寂寞，见到秦可卿的弟弟秦钟后，就请贾母批准他们一起上学，秦钟出身贫寒，刚到学校就被薛蟠一班狐朋狗友戏弄。秦钟回去把他们的那些不干不净的话告诉秦可卿。秦可卿叫他不必理会他们"]},{"id":2322,"word":"不干好事","pinyin":"bù gàn hǎo shì","abbr":"bghs","explanation":"不做有益的事情。","example":{"text":"他一来准～。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":2323,"word":"不平则鸣","pinyin":"bù píng zé míng","abbr":"bpzm","explanation":"鸣：发出声音，指有所抒发或表示。指受到委曲和压迫就要发出不满和反抗的呼声。","source":{"text":"大凡物不得其平则鸣。","book":"唐·韩愈《送孟东野序》"},"example":{"text":"“～”，看看现时的情况，难怪学生们厉声疾呼——革命、救国。","book":"杨沫《青春之歌》第二部第二十七章"},"similar":["不平之鸣","鸣冤叫屈"],"opposite":["忍气吞声","心平气和","称心如意"],"usage":"作谓语、定语、分句；用于遇到不平的事时","story":["唐朝时期，文学家韩愈的学生孟东野熟读经史，很有才能，直到50岁才做溧阳县蔚，因而常抱怨自己怀才不遇。韩愈十分同情，并在孟赴任时写《送孟东野序》赠别：“大凡物不得其平则鸣，草木之无声，风挠之鸣；水之无声，风荡之鸣。”"]},{"id":2324,"word":"不平而鸣","pinyin":"bù píng ér míng","abbr":"bpem","explanation":"平：公平；鸣：发出声音。指人或事物遇到不公正的待遇，就要发出不满的呼声。","source":{"text":"偶以不平而鸣，遽获多言之咎。","book":"明·瞿佑《剪灯新话·令狐生冥梦录》"},"similar":["不平则鸣","物不平则鸣"],"usage":"作谓语、定语、分句；用于处事"},{"id":2325,"word":"不幸中之大幸","pinyin":"bù xìng zhōng zhī dà xìng","abbr":"bxzzdx","explanation":"包含在灾祸或不幸之中可使人宽慰、庆幸的成分。","source":{"text":"生而不用，没而有传，不幸之幸也。","book":"宋·杨万里《江西续派二僧居士诗集序》"}},{"id":2326,"word":"不幸之幸","pinyin":"bù xìng zhī xìng","abbr":"bxzx","explanation":"包含在灾祸或不幸之中可使人宽慰、庆幸的成分。","source":{"text":"生而不用，没而有传，不幸之幸也。","book":"宋·杨万里《江西续派二僧居士诗集序》"}},{"id":2327,"word":"不幸而言中","pinyin":"bù xìng ér yán zhòng","abbr":"bxeyz","explanation":"不希望发生的事情却被说准真的发生了。","source":{"text":"赐不幸而言中，是赐多言。","book":"《孔子家语·辨物》"}},{"id":2328,"word":"不废江河","pinyin":"bù fèi jiāng hé","abbr":"bfjh","explanation":"赞扬作家或其著作流传不朽。","source":{"text":"王杨卢骆当时体，轻薄为文哂未休。尔曹身与名俱灭，不废江河万古流。","book":"唐·杜甫《戏为六绝句》之二"},"example":{"text":"至以仆为‘～’之喻，则不敢当；此自足下阿其所好耳，然得无为他人笑耶？","book":"清·姚莹《复杨君论诗文书》"},"usage":"作谓语；形容好作品流传广，多用于书面语"},{"id":2329,"word":"不度德，不量力","pinyin":"bù dù dé，bù liàng lì","abbr":"bddbll","explanation":"度：衡量。不衡量自己的德行能否服人，不估计自己的能力是否胜任。","source":{"text":"不度德，不量力，不亲亲，不征辞，不察有罪。","book":"《左传·隐公十一年》"},"example":{"text":"他以为与其不度德不量力地好高骛远……远不如把理想放得极低，却孜孜不倦地追求着，非到实现不止。","book":"茅盾《追求·二》"}},{"id":2330,"word":"不弃故旧","pinyin":"bù qì gù jiù","abbr":"bqgj","explanation":"弃：抛弃；故旧：旧交。不轻易抛弃老朋友。","source":{"text":"故旧无大故，则不弃也；不求备于一人。","book":"春秋·鲁·孔丘《论语·微子》"},"similar":["不忘故旧"],"usage":"作谓语；用于处世"},{"id":2331,"word":"不弃草昧","pinyin":"bù qì cǎo mèi","abbr":"bqcm","explanation":"草昧：原始，未开化。不嫌弃蒙昧无知的人。用作谦词。","source":{"text":"天造草昧，宜建侯而不宁。","book":"《周易·屯》"}},{"id":2332,"word":"不当不正","pinyin":"bù dāng bù zhèng","abbr":"bdbz","explanation":"不：语助词，没有实际意思。表示端端正正。","source":{"text":"老汉也分开人丛，不当不正，站在那相公马前。","book":"元·无名氏《渔樵记》第三折"},"example":{"text":"打扮的粉妆玉琢，望上～道了万福。","book":"明·兰陵笑笑生《金瓶梅词话》第15回"},"similar":["端端正正"],"usage":"作谓语、定语；形容端正，整齐"},{"id":2333,"word":"不当人子","pinyin":"bù dāng rén zǐ","abbr":"bdrz","explanation":"表示歉意或感谢的话，意思是罪过，不敢当。","source":{"text":"多谢厚情，只是无功受禄，不当人子，老汉转来，定当奉酬。","book":"明·冯梦龙《醒世恒言》卷十"},"example":{"text":"我们都是烟火邻居，遇着这样大事，理该效劳。却又还破费老师父，～。","book":"清·吴敬梓《儒林外史》第二十回"},"usage":"作谓语；用于骂人","story":["孙悟空大闹天宫后被天兵天将捉住，太上老君把他送入八卦炉炼了49天，可没有半点损伤，他拿出金箍棒杀到玉帝面前。玉帝立即请如来佛来。孙悟空要玉帝搬出天宫，否则就永无宁日，如来冷笑：“你那个初世为人的畜生，为何出此大言！不当人子！”"]},{"id":2334,"word":"不待蓍蔡","pinyin":"bù dài shī cài","abbr":"bdsc","explanation":"蓍蔡：同“蓍龟”，指卜筮。不用占卜就能知道吉凶。比喻事理极明显。","source":{"text":"公达潜朗，思同筮蔡。","book":"晋·袁宏《三国名臣序赞》"},"similar":["不待蓍龟"],"usage":"作谓语；比喻事情是明摆着的"},{"id":2335,"word":"不待蓍龟","pinyin":"bù dài shī guī","abbr":"bdsg","explanation":"蓍龟：古时卜筮，用蓍草和龟甲，以卜吉凶。不用占卜就能决定。比喻事情是明摆着的，非常清楚。","source":{"text":"探赜索隐，钩深致远，以定天下之吉凶，成天下之亹亹者，莫大乎蓍龟。","book":"《周易·系辞上》"},"similar":["不待蓍蔡"],"usage":"作谓语；比喻事情是明摆着的"},{"id":2336,"word":"不徇私情","pinyin":"bù xún sī qíng","abbr":"bxsq","explanation":"徇：曲从。不曲从私人交情。指为人公正，秉公处事。","source":{"text":"我们是好朋友，可是你能不徇私情，这才说明你是真正爱护我。","book":"王朔《你不是一个俗人》"},"example":{"text":"共产党员处理问题时应坚持～的原则。"},"similar":["公正无私"],"opposite":["徇私作弊"],"usage":"作谓语、定语；用于处事"},{"id":2337,"word":"不徇颜面","pinyin":"bù xún yán miàn","abbr":"bxym","explanation":"徇：曲从，偏私；颜面：面容，脸色。不曲从于别人的脸色。指不看别人的脸色行事。","source":{"text":"闻所在官司，犹自多有颜面。","book":"《唐书·长孙无忌传》"},"example":{"text":"朕知卿～。","book":"《元史·相威传》"}},{"id":2338,"word":"不徐不疾","pinyin":"bù xú bù jí","abbr":"bxbj","explanation":"徐：慢。疾：快。不快不慢，从容自然。","source":{"text":"不徐不疾，得之于手，而应于心。","book":"《庄子·天道》"},"example":{"text":"起初犹乍翱乍翔，～，后来乐声促奏，她便盘旋不已。","book":"清·褚人获《隋唐演义》第三十九回"},"similar":["不疾不徐"],"opposite":["慢慢腾腾"],"usage":"作谓语、定语、状语；指处事掌握适度"},{"id":2339,"word":"不得不尔","pinyin":"bù dé bù ěr","abbr":"bdbe","explanation":"尔：如此。不得不这样。表示为环境所迫或有难言之隐而无可奈何。","source":{"text":"今诸典农，各言‘留者为行者宗田计，课其力，势不得不尔。’","book":"《三国志·魏志·司马芝传》"},"example":{"text":"这是事势相逼，～。","book":"清·吴敬梓《儒林外史》第四十六回"},"similar":["无可奈何"],"usage":"作谓语、分句；指无奈"},{"id":2340,"word":"不得人心","pinyin":"bù dé rén xīn","abbr":"bdrx","explanation":"心：心愿，愿望。得不到群众的支持拥护；得不到众人的好评。","source":{"text":"先是，翰数奏禄山虽窃河朔，而不得人心，请持重以弊之，彼自离心，因而翦灭之，可不伤兵擒兹寇矣。","book":"《旧唐书·哥舒翰传》"},"example":{"text":"只恨那婆子～，劈手夺了他宝贝去。","book":"清·曾朴《孽海花》第七回"},"similar":["众叛亲离"],"opposite":["口碑载道","深得人心"],"usage":"作谓语、宾语、定语；形容得不到拥护","story":["唐玄宗时期，范阳节度使安禄山谋反，朝廷派出封常清等率军前去征讨失败，只好让在家养病的河西节度使哥舒翰带兵迎敌。哥舒翰认为安禄山名义上是除奸臣杨国忠，实际上是谋大唐江山，不得人心，应采取分化战术，可唐玄宗急于用兵而惨遭失败"]},{"id":2341,"word":"不得其所","pinyin":"bù dé qí suǒ","abbr":"bdqs","explanation":"原指未得善终，后指没有得到适当的安顿。也指不能达到目的。","source":{"text":"男女有不得其所者，因而相与歌咏，各言其情。","book":"汉·荀悦《汉纪·文帝纪论》"},"example":{"text":"如果这些阶级的人们～，如果这些阶级的人们没有说话的权利，要想把国事弄好是不可能的。","book":"毛泽东《在陕甘宁边区参议会的演说》"},"opposite":["各得其所"],"usage":"作谓语、定语；表示得不到满足"},{"id":2342,"word":"不得其死","pinyin":"bù dé qí sǐ","abbr":"bdqs","explanation":"指人不得好死。也表示对恶人的诅咒。","source":{"text":"若由也，不得其死然。","book":"春秋·鲁·孔丘《论语·先进》"},"example":{"text":"附三思之徒，斥五王之族，以吾熟察，终～然。","book":"唐·张鷟《朝野佥载》第四卷"},"similar":["不得好死","不得善终"],"opposite":["寿终正寝"],"usage":"作谓语、定语；表示对别人的诅咒","story":["春秋时期，孔子生病，他的学生们前去看望他。孔子仔细地看着他们，他认为闵子骞性格外和内刚，冉有和子贡和顺不足、刚直有余，他们均能自保，唯独子路刚直不阿，日后不能善终，就深情地叮嘱他以后遇事要冷静，千万不能鲁莽"]},{"id":2343,"word":"不得其门而入","pinyin":"bù dé qí mén ér rù","abbr":"bdqmer","explanation":"找不到大门走不进去。比喻没有找到合适的途径。","source":{"text":"夫子之墙数仞，不得其门而入，不见宗庙之美，百官之富。","book":"《论语·子张》"}},{"id":2344,"word":"不得命","pinyin":"bu de ming","abbr":"bdm","explanation":"未获允许，即推辞不掉。"},{"id":2345,"word":"不得善终","pinyin":"bù dé shàn zhōng","abbr":"bdsz","explanation":"善终：正常死亡。指人不得好死。常指恶人应有的坏下场。","source":{"text":"汝家虽出二帝，可惜不得善终！","book":"《新编五代史平话·梁史·上卷》"},"example":{"text":"他这样的人是～的。"},"similar":["不得好死","不得其死"],"opposite":["寿终正寝"],"usage":"作谓语；表示对别人的诅咒"},{"id":2346,"word":"不得已而为之","pinyin":"bù dé yǐ ér wéi zhī","abbr":"bdyewz","explanation":"没有办法，只能这样做。","source":{"text":"兵者不祥之器，非君子之器，不得已而用之。","book":"《老子》第三十一章"},"example":{"text":"岁币郊祀之费，是～者。","book":"宋·辛弃疾《九议》"},"similar":["迫不得已"],"usage":"作谓语；用于被迫"},{"id":2347,"word":"不得已而求其次","pinyin":"bù dé yǐ ér qiú qí cì","abbr":"bdyeqqc","explanation":"不得已：无奈何；求：寻求；次：稍差的。在无可奈何的情况下，只得以差一等的将就。","source":{"text":"凡事往往不得已而求其次，‘鸿沟’上没有‘桥梁’，只好‘绕道东京’了。","book":"曹靖华《叹往昔，独木桥头徘徊无终期》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“仁厚宽大，体恤部属，～，倒宁愿在黄抚台手下。”"},"usage":"作谓语、宾语；指只好凑合"},{"id":2348,"word":"不得已而用之","pinyin":"bù dé yǐ ér yòng zhī","abbr":"bdyeyz","explanation":"用：使用。没有办法，只好采用这个办法。","source":{"text":"圣王号兵为凶器，不得已而用之。","book":"《六韬·文韬·兵道》"},"example":{"text":"且兵者凶器，～。","book":"宋·孔平仲《续世说·直谏》"},"similar":["不得已而为之"],"usage":"作谓语、宾语；指没有选择的余地"},{"id":2349,"word":"不得开交","pinyin":"bù dé kāi jiāo","abbr":"bdkj","explanation":"交：相错，纠缠。形容没法解开或摆脱。","source":{"text":"侯登听了这些话，句句骂得扦心，那里受得下去，又恼又羞，跳起身来说道：‘罢了，罢了！我同他不得开交了！’","book":"明·罗贯中《粉妆楼》第三十一回"},"example":{"text":"我已经忙得～了。"},"similar":["不可开交"],"usage":"作状语；形容无法了结，不能摆脱"},{"id":2350,"word":"不得而知","pinyin":"bù dé ér zhī","abbr":"bdez","explanation":"得：能够。没有办法知道。","source":{"text":"故虽谏且议，使人不得而知焉。","book":"《后汉书·桓谭传》：“盖天道性命，圣人所难言也。自子贡以下，不得而闻。”唐·韩愈《争臣论》"},"example":{"text":"《后汉书·桓谭传》：“盖天道性命，圣人所难言也。自子贡以下，不得而闻。”唐·韩愈《争臣论》：“故虽谏且议，使人不得而知焉。”"},"similar":["一无所知","不知所以"],"opposite":["洞若观火","了如指掌"],"usage":"作谓语；用于不知道某事"},{"id":2351,"word":"不得要领","pinyin":"bù dé yào lǐng","abbr":"bdyl","explanation":"要：古“腰”字；领：衣领。要领：比喻关键。抓不住要领或关键。","source":{"text":"骞从月氏至大夏，竟不能得月氏要领。","book":"《史记·大宛列传》"},"example":{"text":"我又无拳无勇，真没办法，在手头的只有笔墨，能写这封信一类的～的东西而已。","book":"鲁迅《两地书》八"},"similar":["茫然不解","雾里看花","不知所为"],"opposite":["一目了然","了如指掌","提纲挈领"],"usage":"作谓语、定语、状语；形容抓不住要点","story":["汉武帝派大臣张骞出使月氏国，经过匈奴时被扣留，关押了十多年，还被配了妻室。张骞与随从趁匈奴放松监视之机逃出匈奴，来到大宛国，经康居国到达月氏国的所在地大夏国，月氏人不想报匈奴的杀君之仇，张骞只好无功而返"]},{"id":2352,"word":"不得违误","pinyin":"bù dé wéi wù","abbr":"bdww","explanation":"公文用语，不得违反命令，耽误公事。","example":{"text":"军情紧急，现派你们出发侦察，三小时后必须回来，～。"}},{"id":2353,"word":"不德而功","pinyin":"bù dé ér gōng","abbr":"bdeg","explanation":"不：无；德：德行，才能。没有才能却受到奖赏。","source":{"text":"不德而有功。","book":"《左传·襄公二十三年》"}},{"id":2354,"word":"不忍卒读","pinyin":"bù rěn zú dú","abbr":"brzd","explanation":"卒：尽，完。不忍心读完。常用以形容文章内容悲惨动人。","source":{"text":"闽督何公小宋，挽其夫人一联，一字一泪，如泣如诉，令人不忍卒读。","book":"清·百一居士《壶天录》上卷"},"example":{"text":"这篇文章悲调真是令人～。"},"usage":"作谓语；用于文章"},{"id":2355,"word":"不忍释卷","pinyin":"bù rěn shì juàn","abbr":"brsj","explanation":"释：放开；卷：书本。书本不离手。形容勤奋好学。","source":{"text":"予初阅时不忍释卷，及考其声韵，则一无定轨。","book":"清·李渔《闲情偶寄·音律》"},"similar":["手不释卷","手不辍卷"],"usage":"作谓语、宾语；指勤奋好学"},{"id":2356,"word":"不忍释手","pinyin":"bù rěn shì shǒu","abbr":"brss","explanation":"舍不得放手。形容十分喜爱，","source":{"text":"余爱嗜其文，不能释手。","book":"南朝·梁·萧统《陶渊明集序》"},"example":{"text":"九妈见了这锭大银，已自～。","book":"明·冯梦龙《醒世恒言》卷三"}},{"id":2357,"word":"不忘久要","pinyin":"bù wàng jiǔ yào","abbr":"bwjy","explanation":"久要：旧约，旧交。不忘记旧友情。","source":{"text":"久要不忘平生之言，亦可以为成人矣。","book":"春秋·鲁·孔丘《论语·宪问》"},"example":{"text":"君～。","book":"宋·司马光《资治通鉴·元帝太兴三年》"},"similar":["不忘故旧"],"usage":"作谓语；用于处世"},{"id":2358,"word":"不忘故旧","pinyin":"bù wàng gù jiù","abbr":"bwgj","explanation":"故旧：旧交、旧友。不忘记老朋友。","source":{"text":"多谢大王不忘故旧。","book":"元·马致远《陈抟高卧》第四折"},"example":{"text":"明·冯梦龙《警世通言》第30卷：“奴去也，还乡之日，千万到奴家荒坟一顾，也表员外～之情。”"},"similar":["不弃故旧","不忘久要"],"usage":"作谓语；用于处世"},{"id":2359,"word":"不忘母训","pinyin":"bù wàng mǔ xùn","abbr":"bwmx","explanation":"指不忘记母亲的教诲。","example":{"text":"寇准～的事迹真是感人。"},"usage":"作谓语、定语；指牢记母亲的教诲","story":["北宋有名的宰相寇准出身贫寒，爱民如子。手下大臣为他操办寿辰，送来很多寿礼，摆满了整个客厅。老奴拿出他母亲临终时作的“寒窗课子图”，寇准泪如雨下，想起自己母亲的教诲，就立刻命令仆人将所有寿礼全部退回"]},{"id":2360,"word":"不忘沟壑","pinyin":"bù wàng gōu hè","abbr":"bwgh","explanation":"沟壑：山沟。念念不忘为正义而死，弃尸山沟。形容有为正义献身的思想准备。也比喻人发迹之后不忘过去贫贱的日子。","source":{"text":"志士不忘在沟壑，勇士不忘丧其元。","book":"《孟子·万章下》"},"example":{"text":"尝曰：“士求自立，当自～。”","book":"清·陈康祺《燕下乡脞录》"},"usage":"作谓语、定语；形容人守信义","story":["战国时期，孟子到各国游说以仁政治理天下，一般要诸侯邀请他才去，学生陈代想不通，孟子开导他：“齐景公打猎用旌旗去唤守猎场的人，那些人不忘沟壑，宁愿牺牲自己也不上前，这证明他们有骨气。我如果不被邀请就去成何体统？”"]},{"id":2361,"word":"不忙不暴","pinyin":"bù máng bù bào","abbr":"bmbb","explanation":"态度纵容，不忙乱，不急躁。","source":{"text":"不紧不慌，不惊不怕，不忙不暴。","book":"《董西厢》卷二"}},{"id":2362,"word":"不忮不求","pinyin":"bù zhì bù qiú","abbr":"bzbq","explanation":"忮：嫉妒；求：贪求。指不妒忌，不贪得无厌。","source":{"text":"百尔君子，不知德行。不忮不求，何用不臧。","book":"《诗经·邶风·雄雉》"},"example":{"text":"处理了这些事务，便是长篇大论的“遗训”，教子孙～，克勤克俭。","book":"高阳《玉座珠帘》下册"},"usage":"作谓语、定语；表示不嫉妒，不贪求"},{"id":2363,"word":"不念僧面念佛面","pinyin":"bù niàn sēng miàn niàn fó miàn","abbr":"bnsmnfm","explanation":"不看僧面看佛面。","source":{"text":"你不念僧面念佛面啊，人家老大娘都把你想坏啦。","book":"草明《乘风破浪》十七"},"similar":["不看僧面看佛面"],"usage":"作谓语，分句；形容宽容某人或某事"},{"id":2364,"word":"不念旧恶","pinyin":"bù niàn jiù è","abbr":"bnje","explanation":"念：记在心上。不计较过去的怨仇。","source":{"text":"伯夷、叔齐不念旧恶，怨是用希。","book":"《论语·公冶长》"},"example":{"text":"谁叫咱们有～的泱泱大国之风。”","book":"俞平伯《我生的那一年》"},"similar":["以德报怨","隐恶扬善","豁达大度"],"opposite":["不仁不义","斤斤计较"],"usage":"作谓语、宾语；用于胸怀宽广的人","story":["东汉末年，曹操为了大业，不计私怨，不念旧恶，受到众将的拥护。例如董卓的部将张绣背叛曹操并杀死曹操的长子曹昂，去投降刘表。三年后张绣投降曹操，曹操并没杀他，而给他封了侯。像这样的例子有魏钟、臧霸、孙观、吴敬等人"]},{"id":2365,"word":"不念旧情","pinyin":"bù niàn jiù qíng","abbr":"bnjq","explanation":"指人原则性强，不记挂过去的情义。","source":{"text":"否则我上台后可不念旧情，就算你们跪下来求我，我起码也得把你们送进集中营。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"诸葛亮～，挥泪斩马谡。"},"similar":["铁面无私"],"opposite":["徇情枉法"],"usage":"作谓语、定语；指人很有原则"},{"id":2366,"word":"不怀好意","pinyin":"bù huái hào yì","abbr":"bhhy","explanation":"怀：包藏。没安好心。","source":{"text":"武松听了这话，自家肚里寻思道：‘这妇人不怀好意了。你看我且先耍他。’","book":"明·施耐庵《水浒传》第二十七回"},"example":{"text":"他一向对弱小者都～。"},"similar":["居心不良","居心叵测"],"opposite":["与人为善","诚心诚意"],"usage":"作谓语、定语；指动机不纯","story":["武松自杀了潘金莲与西门庆这对奸夫淫妇后，被官府判望流放，套上枷锁，由两个差官押送，经过十字坡酒店遇到母夜叉孙二娘，孙二娘不怀好意，用蒙汗药来对付武松。武松装作药性发作，在孙二娘要扒皮时抓住她，吓得孙二娘赶快求饶"]},{"id":2367,"word":"不怕官，只怕管","pinyin":"bù pà guān，zhǐ pà guǎn","abbr":"bpgzpg","explanation":"指直接管的人要比官更有权威。也指在人管辖之下，一切只能听命于他。","source":{"text":"好汉！休说这话！古人道：‘不怕官，只怕管。’，‘在人矮檐下，怎敢不低头。’只是小心便好。","book":"明·施耐庵《水浒传》第28回"},"example":{"text":"俗谚有云：‘～。’岂是我管你不着，一些儿不怕我？","book":"明·冯梦龙《醒世恒言·薛录事鱼服证仙》"},"similar":["现官不如现管"],"usage":"作宾语、分句；形容服从管辖自己的人","story":["宋朝时期，东京80万禁军拳棒教头王进的父亲王升曾经棒打小流氓高俅。10年后王升去世，高俅爱踢球受到宋徽宗的赏识，官至殿帅府太尉，直接管辖王进。高俅为报一棒之仇命人把王进抓来打一顿。王进不怕官、只怕管，于是连夜携全家逃走"]},{"id":2368,"word":"不急之务","pinyin":"bù jí zhī wù","abbr":"bjzw","explanation":"急：急迫，要紧；务：事情。无关紧要的或不急于做的事情。","source":{"text":"诚能绝无益之欲，以奉德义之涂，弃不急之务，以修功业之基，其于名行，岂不善哉。","book":"《三国志·吴书·孙和传》"},"example":{"text":"长吏迫于崔科，视学舍为～。","book":"清·朱彝尊《衢州府西安县重修学记》"},"similar":["细枝末节"],"opposite":["当务之急","燃眉之急"],"usage":"作主语、宾语；表示无关紧要的事情","story":["三国时期，吴国太子孙和自幼聪敏过人，爱好文学，善于骑射，深受孙权的喜爱。当时一些官僚热衷下围棋，常因谈论下棋而耽误公事，孙和对他们说：“下棋只是消遣娱乐而矣，人应该杜绝那些无益的欲望，舍去那些不急之务。”"]},{"id":2369,"word":"不恤人言","pinyin":"bù xù rén yán","abbr":"bxry","explanation":"不管别人的议论。表示不管别人怎么说，还是按照自己的意思去做。","source":{"text":"大则以訏谟排祸难，小则以谠正匡过失，内不虑身计，外不恤人言，古人所难也。","book":"《旧唐书·裴度传》"},"example":{"text":"～谁则敢？可怜薄幸我何曾！","book":"清·魏秀仁《花月痕》第四十五回"}},{"id":2370,"word":"不恶而严","pinyin":"bù è ér yán","abbr":"beey","explanation":"并不恶声恶气，但很威严，使人知敬畏。","source":{"text":"君子以远小人，不恶而严。","book":"《周易·遁》"},"opposite":["和蔼可亲","平易近人"],"usage":"作谓语、定语；用于长辈"},{"id":2371,"word":"不患寡而患不均","pinyin":"bù huàn guǎ ér huàn bù jūn","abbr":"bhgehbj","explanation":"患：忧虑；寡：少，贫穷；均：平均。不忧虑贫穷而忧患不平均。","source":{"text":"丘也闻有国有家者，不患寡而患不均，不患贫而患不安。","book":"《论语·季氏》"}},{"id":2372,"word":"不悱不发","pinyin":"bù fěi bù fā","abbr":"bfbf","explanation":"悱：心里想说而说不出来。发：启发。指不到学生想说而说不出来时，不去启发他。这是孔子的教学方法。","source":{"text":"不愤不启，不悱不发。","book":"《论语·述而》"},"usage":"作谓语、定语；用于教学等"},{"id":2373,"word":"不情之誉","pinyin":"bù qíng zhī yù","abbr":"bqzy","explanation":"不合情理的赞誉。","source":{"text":"今世立碑之滥极矣……其词不过乡绅不情之誉。","book":"明·沈德符《万历野获编·立碑》"}},{"id":2374,"word":"不情之请","pinyin":"bù qíng zhī qǐng","abbr":"bqzq","explanation":"情：情理。不合情理的请求（称自己提出请求时的客气话）。","source":{"text":"不情之请，惟君图之。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录二》"},"example":{"text":"我想这是大年夜，他在暖暖融融的屋里，说说笑笑正热闹，叫他冲黑冒寒送我，是～。","book":"杨绛《冒险记幸》"},"usage":"作分句、宾语；形容不合情理的要求，客套语"},{"id":2375,"word":"不惑之年","pinyin":"bù huò zhī nián","abbr":"bhzn","explanation":"不惑：遇到事情能明辨不疑。以此作为40岁的代称。","source":{"text":"《论语·为政》有“四十而不惑”的说法。"},"example":{"text":"他大学毕业年仅20，而光阴飞转，很快已近～了。"},"similar":["人到中年"],"opposite":["豆蔻年华"],"usage":"作主语、定语；形容人到四十岁能明辨事理","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，面对困窘的生活，孔子与弟子们谈起自己的经历，说他从30岁开始立志弘道，经历不惑之年以致现在，感慨万千……宰予立即过来安慰孔子"]},{"id":2376,"word":"不惜一切","pinyin":"bù xī yī qiè","abbr":"bxyq","explanation":"为了达到目的不吝惜所花费的代价。","source":{"text":"我们曾共同面对种种危险。为了我，他不惜一切。","book":"王朔《空中小姐》"},"example":{"text":"我～也要治好你的病。"},"similar":["不惜代价"],"usage":"作谓语、定语、宾语；用于处事"},{"id":2377,"word":"不惜代价","pinyin":"bù xī dài jià","abbr":"bxdj","explanation":"为得到某种东西或实现某个目标而不吝惜付出钱物、精力等。","example":{"text":"他～，为的是巴结领导讨个官做。"},"similar":["不惜一切","不惜血本"],"usage":"作谓语、定语、宾语；用于处事"},{"id":2378,"word":"不惜工本","pinyin":"bù xī gōng běn","abbr":"bxgb","explanation":"惜：吝惜。指舍得出本钱。","source":{"text":"姓方的瞧着眼热，有几家该钱的，也就不惜工本，公开一个学堂。","book":"清·李宝嘉《官场现形记》第一回"},"example":{"text":"万源祥、大利、老福兴几家的店伙特别卖力，～叫着‘乡亲’。","book":"叶圣陶《多收了三五斗》"},"similar":["不惜代价"],"opposite":["斤斤计较"],"usage":"作谓语、定语、状语；指不惜一切代价"},{"id":2379,"word":"不惜本钱","pinyin":"bù xī běn qián","abbr":"bxbq","explanation":"为了达到目的不吝惜所花费的代价。","source":{"text":"但在建立时应不惜本钱抽调干部及若干部队以作骨干。","book":"邓小平《关于今后进入新区的几点意见》"},"similar":["不惜血本","不惜代价"],"usage":"作谓语、定语、宾语；用于处事"},{"id":2380,"word":"不惜血本","pinyin":"bù xī xuè běn","abbr":"bxxb","explanation":"为了达到目的不吝惜所花费的代价。","source":{"text":"为了不让顾客恐惧，我们是不惜血本。","book":"王朔《谁比谁傻多少》"},"example":{"text":"为了成功往上爬，有些人往往是～的。"},"similar":["不计成本","不惜一切","不惜工本"],"usage":"作谓语、定语、宾语；用于处事"},{"id":2381,"word":"不惭屋漏","pinyin":"bù cán wū lòu","abbr":"bcwl","explanation":"屋漏：古代室内西北角安放死者用帐幕遮盖处。独处于室时慎守善德，无愧于心。形容心地光明，在暗中也不做坏事，不起邪念。","source":{"text":"门惊如市，不惭屋漏；心抱如水，无欺暗室。","book":"隋·江总《让尚书仆射表》"},"similar":["不愧屋漏","不欺屋漏"],"opposite":["暗室欺心"],"usage":"作谓语；形容为人正直"},{"id":2382,"word":"不惮强御","pinyin":"bù dàn qiáng yù","abbr":"bdqy","explanation":"不怕豪强有势力的人。同“不畏强御”。","source":{"text":"当官理务，不惮强御，常以天下为己任，高祖深委信之。","book":"《梁书·孔休源传》"},"similar":["不避强御","不畏强御"],"opposite":["胆小怕事"],"usage":"作谓语、定语；指人刚正"},{"id":2383,"word":"不愤不启","pinyin":"bù fèn bù qǐ","abbr":"bfbq","explanation":"愤：心里想弄明白而还不明白。启：启发。指不到学生们想弄明白而还没有弄明白时，不去启发他。这是孔子的教学方法。","source":{"text":"不愤不启，不悱不发。","book":"《论语·述而》"},"example":{"text":"这时，我真正感受到了“～”“不作不发”这八个字的含义。","book":"许国庆《仍是“不宁静”》"}},{"id":2384,"word":"不愧下学","pinyin":"bù kuì xià xué","abbr":"bkxx","explanation":"不耻下问，虚心向地位低的人学习。","source":{"text":"是以君王无羞亟问，不愧下学。","book":"西汉·刘向《战国策·齐策四》"},"similar":["不耻下问"],"usage":"作主语、谓语、宾语；形容虚心求教"},{"id":2385,"word":"不愧不作","pinyin":"bù kuì bù zuò","abbr":"bkbz","explanation":"愧、怍：惭愧。光明正大，问心无愧。","source":{"text":"仰不愧于天，俯不怍于人，二乐也。","book":"《孟子·尽心上》"}},{"id":2386,"word":"不愧不怍","pinyin":"bù kuì bù zuò","abbr":"bkbz","explanation":"愧、怍：惭愧。形容光明正大，问心无愧。","source":{"text":"仰不愧于天，俯不怍于人，二乐也。","book":"战国·邹·孟轲《孟子·尽心上》"},"example":{"text":"说起那误会，方罗兰自信～。","book":"《动摇》"},"similar":["光明磊落"],"opposite":["问心有愧"],"usage":"作谓语、宾语、定语；指人的品性"},{"id":2387,"word":"不愧屋漏","pinyin":"bù kuì wū lòu","abbr":"bkwl","explanation":"愧：惭愧；屋漏：古代室内西北角安放小帐的地方。原意是虽在宗庙里，但无愧畏之心。后比喻即使在暗中也不做坏事，不起坏念头。","source":{"text":"相在尔室，尚不愧于屋漏。","book":"《诗经·大雅·抑》"},"example":{"text":"知化则善述其事，穷神则善继其志，～不无忝，存心养性为匪懈。","book":"《宋史·张载传》"},"similar":["光明磊落","不惭屋漏"],"opposite":["暗室欺心"],"usage":"作谓语；形容为人正直"},{"id":2388,"word":"不慌不忙","pinyin":"bù huāng bù máng","abbr":"bhbm","explanation":"不慌张，不忙乱。形容态度镇定，或办事稳重、踏实。","source":{"text":"轮起刀来望我脖子砍，不慌不忙缩了头。","book":"元·高文秀《襄阳会》第三折"},"example":{"text":"公路在山上盘旋，车子～地打着圈子。","book":"巴金《旅途杂记·成渝路上》"},"similar":["从容不迫"],"opposite":["惊惶失措","张皇失措"],"usage":"作谓语、定语、状语；形容说话或行动从容"},{"id":2389,"word":"不懂人事","pinyin":"bù dǒng rén shì","abbr":"bdrs","explanation":"不懂得为人处世。","example":{"text":"请原谅这个～的小子。"},"similar":["不明事理","不懂世故"],"usage":"作谓语、定语；用于为人"},{"id":2390,"word":"不懂装懂","pinyin":"bù dǒng zhuāng dǒng","abbr":"bdzd","explanation":"自己不懂却装作很精通的样子。","source":{"text":"我妈也比他强呵，起码不像她不懂装懂。我最恨不懂装懂像她那样的老师。","book":"王朔《我是你爸爸》"},"example":{"text":"他总喜欢不懂装懂，瞎指挥。"},"similar":["强不知以为知"],"usage":"作谓语、宾语；指充内行","story":["三国时期，蜀国军师诸葛亮用计气死魏国大将曹真，魏国大将司马懿奉命统领大军向祁山开来，诸葛亮派兵布好八卦阵，司马懿不懂破阵之法，硬着头皮派张虎、戴陵攻阵，全部被俘。蜀将关兴与姜维三面夹击，司马懿大败而归"]},{"id":2391,"word":"不成一事","pinyin":"bù chéng yī shì","abbr":"bcys","explanation":"连一样事情也没有做成。指什么事情都做不成。形容毫无成就。","source":{"text":"若有精灵应笑我，不成一事谪江州。","book":"唐·白居易《题四皓庙》诗"},"example":{"text":"堪笑硁硁真小谅，～枉嗟咨。","book":"明·冯梦龙《醒世恒言》卷三十六"}},{"id":2392,"word":"不成三瓦","pinyin":"bù chéng sān wǎ","abbr":"bcsw","explanation":"比喻不能要求齐全。","source":{"text":"物安可全乎？天尚不全。故室为屋，不成三瓦而陈之。","book":"《史记·龟策列传》"}},{"id":2393,"word":"不成体统","pinyin":"bù chéng tǐ tǒng","abbr":"bctt","explanation":"体统：格局，规矩。指言行没有规矩，不成样子。","source":{"text":"刻印不及，以锥画之，全不成体统。","book":"明·罗贯中《三国演义》第十三回"},"example":{"text":"此时官厅上乱烘烘的，闹了个～。","book":"清·吴趼人《二十年目睹之怪现状》第二十七回"},"similar":["不拘小节"],"opposite":["规行矩步","循规蹈矩"],"usage":"作谓语、补语、分句；表示人言行放肆"},{"id":2394,"word":"不成器","pinyin":"bù chéng qì","abbr":"bcq","explanation":"器：指人的度量、才干。不能成为有用的器物。多用以指人气质平庸，不能有所成就，没有什么出息。有时也指不学好，自甘堕落。","source":{"text":"玉不琢，不成器。","book":"《礼记·学记》"},"example":{"text":"这厮～，如何却在这里。","book":"明·施耐庵《水浒全传》第十四回"},"similar":["无能之辈"],"usage":"作谓语、宾语、定语；指人没有用处"},{"id":2395,"word":"不成方圆","pinyin":"bù chéng fāng yuán","abbr":"bcfy","explanation":"方圆：借指规矩。形容言语行动没有规矩，不成样子。","source":{"text":"离娄之明，公输子之巧，不以规矩，不成方圆。","book":"战国·邹·孟轲《孟子·离娄上》"},"example":{"text":"这样做有～的感觉。"},"similar":["不成体统"],"opposite":["规规矩矩"],"usage":"作谓语、定语；用于规则等"},{"id":2396,"word":"不成气候","pinyin":"bù chéng qì hòu","abbr":"bcqh","explanation":"比喻没有成就或没有发展前途。","source":{"text":"洪稚存经术湛深，而诗多魔道；词稍胜于诗，然亦不成气候。","book":"清·陈廷焯《白雨斋词话》五"},"example":{"text":"你们这样做是～的。"},"usage":"作谓语、定语；用于单个或孤立事物"},{"id":2397,"word":"不战而溃","pinyin":"bù zhàn ér kuì","abbr":"bzek","explanation":"溃：溃败。没有开战就自行崩溃。形容毫无战斗力。","source":{"text":"敌人不过几个师团，国民党几十万军队不战而溃，只有杂牌军还能打一下。","book":"毛泽东《学习和时局》"},"similar":["望风披靡"],"opposite":["战无不胜"],"usage":"作谓语、定语；用于毫无战斗力"},{"id":2398,"word":"不才之事","pinyin":"bù cái zhī shì","abbr":"bczs","explanation":"不才：不成材。指不正经的事情。","source":{"text":"如此看来，倒怕将来难免不才之事，令人可惊可畏。","book":"清·曹雪芹《红楼梦》第三十二回"}},{"id":2399,"word":"不打不成器","pinyin":"bù dǎ bù chéng qì","abbr":"bdbcq","explanation":"打：打磨，打造。不打造就不能成为有用的器物。比喻不教育就不成材，没出息。","example":{"text":"～的教育方式关键在于好好引导。"},"similar":["玉不琢，不成器"],"usage":"作宾语、定语；多用于口语，教训晚辈"},{"id":2400,"word":"不打不成相识","pinyin":"bù dǎ bù chéng xiāng shí","abbr":"bdbcxs","explanation":"指经过交手，彼此了解，结交起来就更投合。","source":{"text":"你两个今番却做个至交的弟兄。常言道：‘不打不成相识。’","book":"明·施耐庵《水浒传》第38回"},"example":{"text":"这真是～，他们很快成为好友。"},"similar":["不打不相识"],"opposite":["不共戴天"],"usage":"作宾语、分句；用于朋友交往","story":["宋江因犯案被发配到江州，遇到江湖上的戴宗与李逵，三人到江边的琵琶亭酒馆喝酒，宋江要喝鲜鱼汤。李逵到江边渔船上去取，渔船主人张顺与李逵发生争执就打了起来，戴宗前去劝架，三人去见宋江，宋江立即团结他们使他们成为朋友"]},{"id":2401,"word":"不打不相识","pinyin":"bù dǎ bù xiāng shí","abbr":"bdbxs","explanation":"指经过交手，相互了解，能更好地结交、相处。","source":{"text":"戴宗道：‘你两个今番却做个至交的弟兄。常言道：不打不成相识。’","book":"明·施耐庵《水浒传》第38回"},"example":{"text":"上次闹了点误会，还记在心里？～嘛。来，里面坐。","book":"陆文夫《不平者》"},"similar":["不打不成相识"],"opposite":["不共戴天"],"usage":"作分句；形容经过交手而结交","story":["宋江因犯案被发配到江州，遇到江湖上的戴宗与李逵，三人到江边的琵琶亭酒馆喝酒，宋江要喝鲜鱼汤。李逵到江边渔船上去取，渔船主人张顺与李逵发生争执就打了起来，戴宗前去劝架，三人去见宋江，宋江立即团结他们使他们成为朋友"]},{"id":2402,"word":"不打自招","pinyin":"bù dǎ zì zhāo","abbr":"bdzz","explanation":"招：招供。旧指没有用刑就招供。比喻做了坏事或有坏的意图自我暴露出来。","source":{"text":"也是个不打自招的怪物，他忽然说出道：后日是他母难之日，邀请诸邪来作生日。","book":"明·吴承恩《西游记》第十七回"},"example":{"text":"但是我还要说重庆发言人是个蠢猪，他～，向人国人民泄露了日本帝国主义的计划。","book":"毛泽东《为皖南事变发表的命令和谈话》"},"similar":["欲盖弥彰","图穷匕见","供认不讳"],"opposite":["屈打成招","居心叵测"],"usage":"作谓语、宾语；比喻不自觉暴露自己的过失","story":["唐僧师徒四人西天取经来到一座寺庙借宿，孙悟空向僧人展示袈裟，寺内老僧贪财夜晚放火烧寺，偷走了袈裟。他在芳草坡前被黑风山上的妖怪捉住，他便不打自招地交出唐僧的袈裟。孙悟空知道后立即赶将过来消灭妖怪夺回袈裟"]},{"id":2403,"word":"不抗不卑","pinyin":"bù kàng bù bēi","abbr":"bkbb","explanation":"抗：高傲；卑：低、自卑。指对人有恰当的分寸，既不低声下气，也不傲慢自大。","source":{"text":"他这远愁近虑，不抗不卑，他们奶奶就不是和咱们好，听他这一番话，也必要自愧的变好了。","book":"《红楼梦》第五六回"},"similar":["不亢不卑"],"opposite":["骄傲自大"],"usage":"作谓语、定语；形容为人处事有分寸"},{"id":2404,"word":"不折不扣","pinyin":"bù zhé bù kòu","abbr":"bzbk","explanation":"折、扣：出售商品时，按定价减去的成数。没有折扣，表示完全、十足的意思。","source":{"text":"他那二十多年足不窥户的生活简直是不折不扣的坟墓生活！","book":"茅盾《子夜》"},"example":{"text":"如今的妇人跟男人～一样尊贵！","book":"老舍《女店员》第二幕"},"similar":["原原本本","实事求是","彻头彻尾"],"opposite":["添枝加叶","添油加醋","画蛇添足"],"usage":"作定语、状语；表示毫不打折扣"},{"id":2405,"word":"不护细行","pinyin":"bù hù xì xíng","abbr":"bhxx","explanation":"指不注意小节。","source":{"text":"观古今文人，类不护细行，鲜能以名节自主。","book":"语出《书·旅獒》：“不矜细行，终累大德。”  三国·魏·曹丕《与吴质书》"},"example":{"text":"诸子皆轻侠，中子充，少时又～。","book":"《南史·张绪传》"},"similar":["不拘小节","不修边幅"],"opposite":["谨小慎微"],"usage":"作谓语、定语；指不拘小节"},{"id":2406,"word":"不拔一毛","pinyin":"bù bá yì máo","abbr":"bbym","explanation":"比喻非常吝啬。同“一毛不拔”。","source":{"text":"为己者至于不拔一毛，兼爱者至于摩顶放踵。","book":"宋·秦观《浩气传》"},"example":{"text":"墨子之学术贵俭，虽天下以我为～不恤也。","book":"明·李贽《孔明为后主写申韩管子六韬》"},"similar":["一毛不拔"],"usage":"作谓语、补语；形容过分看重钱财"},{"id":2407,"word":"不拔之志","pinyin":"bù bá zhī zhì","abbr":"bbzz","explanation":"比喻意志坚决，不可动摇。","source":{"text":"执不拔之志，高卧东南。","book":"《南史·沈约传》"},"usage":"作宾语；指人的意志"},{"id":2408,"word":"不拔之柱","pinyin":"bù bá zhī zhù","abbr":"bbzz","explanation":"不拔：牢固不可拔除，即不可动摇。拔不动的柱子。比喻有坚固的根基。","source":{"text":"圣人倚不拔之柱。","book":"《淮南子·精神训》"}},{"id":2409,"word":"不拔之策","pinyin":"bù bá zhī cè","abbr":"bbzc","explanation":"不拔：牢固不可拔除，即不可动摇；策：计策。稳妥可靠的计策。","source":{"text":"天下已定，金革已平，都于洛阳；娄敬委辂脱輓，掉三寸之舌，建不拔之策，举中国徒之长安，适也。","book":"汉·扬雄《解嘲》"}},{"id":2410,"word":"不拘一格","pinyin":"bù jū yī gé","abbr":"bjyg","explanation":"拘：限制；格：规格，方式。不局限于一种规格或一个格局。","source":{"text":"我劝天公重抖擞，不拘一格降人才。","book":"清·龚自珍《己亥杂诗》"},"example":{"text":"不但体裁，风格，题材，表现手法可以鼓励勇于创新，甚至连主题，也可以是～的。","book":"秦牧《“果王”的美号》"},"similar":["形形色色","五花八门"],"opposite":["如出一辙","千篇一律"],"usage":"作宾语、定语、状语；比喻打破常规","story":["清朝思想家龚自珍面对腐败的清政府，主张改革，提倡禁烟，得不到朝廷重用。48岁毅然辞官归隐，在路过镇江时看到当地人在祭拜天神，他作诗一首：“九州生气恃风雷，万马齐喑究可哀；我劝天公重抖擞，不拘一格降人才。”"]},{"id":2411,"word":"不拘于时","pinyin":"bu ju yu shi","abbr":"bjys","explanation":"不受耻于从师的时俗限制。"},{"id":2412,"word":"不拘小节","pinyin":"bù jū xiǎo jié","abbr":"bjxj","explanation":"拘：拘泥。不为小事所约束。多指不注意生活小事。","source":{"text":"性敦朴，不拘小节。","book":"《后汉书·虞延传》"},"example":{"text":"此人廓达之才，～。","book":"明·冯梦龙《东周列国志》第十八回"},"similar":["不拘形迹","洒脱不拘"],"opposite":["缩手缩脚","谨小慎微"],"usage":"作谓语、定语；指不注意生活小节","story":["西汉末年东昏亭长虞延不注重生活小节，但敢于主持公道，将王莽的宠妾魏氏恶霸亲戚送入大牢。东汉时在富宗市长手下为官，因劝谏贪官富宗深得皇帝赏识，后为官洛阳，因其敢于执法而得罪皇帝亲戚阴氏而被迫自杀身亡"]},{"id":2413,"word":"不拘常次","pinyin":"bù jū cháng cì","abbr":"bjcc","explanation":"不拘泥于寻常的次序、等级。指破格提拔，越级使用。","source":{"text":"不拘常次，言超擢也。","book":"《汉书·车旗日传》注"}},{"id":2414,"word":"不拘形迹","pinyin":"bù jū xíng jī","abbr":"bjxj","explanation":"形容言谈举止无拘无束，自由自在。","source":{"text":"曾沧海回头一看，认得是土贩李四；在某一点上，他这李四是不拘形迹的密友。","book":"茅盾《子夜》四"},"example":{"text":"同他做了朋友，时常约他吃酒，～地畅谈。","book":"姚雪垠《李自成》第一卷第十六章"},"similar":["放浪不羁"],"usage":"作谓语、定语；指人放浪不羁"},{"id":2415,"word":"不拘文法","pinyin":"bù jū wén fǎ","abbr":"bjwf","explanation":"拘：拘泥。不拘守成文法令。指处理政务等不受条文限制，关于掌握纲领。","source":{"text":"为征南功曹，止举大纲而已，不拘文法。简益器之，转为记室参军。","book":"晋·习凿齿《襄阳者旧记》"},"example":{"text":"方明深达治体，～，阔略苛细，务存纲领。","book":"《宋书·谢方明传》"}},{"id":2416,"word":"不拘禁忌","pinyin":"bù jū jìn jì","abbr":"bjjj","explanation":"拘：拘泥，拘束；禁忌：忌讳。不拘泥于忌讳。指不受约束。","source":{"text":"及拘者为之，则牵于禁忌，泥于小数，舍人事而任鬼神。","book":"《汉书·艺文志·阴阳家》"}},{"id":2417,"word":"不拘细节","pinyin":"bù jū xì jié","abbr":"bjxj","explanation":"犹不拘小节。","source":{"text":"万顷属文敏速，然性疏旷，不拘细节，无儒者之风。","book":"《旧唐书·文苑传中·元万顷》"},"similar":["不拘小节","不拘细行"],"opposite":["谨小慎微"],"usage":"作谓语、定语；指不注意生活小节"},{"id":2418,"word":"不拘细行","pinyin":"bù jū xì xíng","abbr":"bjxx","explanation":"犹不拘小节。","source":{"text":"峤有俊朗之目而不拘细行。","book":"南朝·宋·刘义庆《世说新语·任诞》“庚即送直，然后得还，经此数四”刘孝标注引《中兴书》"},"example":{"text":"有一个河朔李生，从少时膂力过人，恃气好侠，～。","book":"《初刻拍案惊奇》"},"similar":["不矜细行","不拘小节"],"opposite":["谨小慎微"],"usage":"作谓语、定语；指不拘小节"},{"id":2419,"word":"不拘绳墨","pinyin":"bù jū shéng mò","abbr":"bjsm","explanation":"绳墨：木工用以画直线的工具，借喻法度、规矩。形容人的行为或艺术风格洒脱、豪放，超逸不羁。","source":{"text":"有侄儿郭仲翔，才兼文武，一生豪侠尚气，不拘绳墨。","book":"明·冯梦龙《喻世明言》卷八"}},{"id":2420,"word":"不择手段","pinyin":"bù zé shǒu duàn","abbr":"bzsd","explanation":"择：选择。指为了达到目的，什么手段都使得出来。","source":{"text":"为目的而不择手段，虽目的甚正，犹且不可。","book":"梁启超《袁世凯之解剖》"},"example":{"text":"要谋生，谋生之道，则～。","book":"鲁迅《三闲集·通信》"},"similar":["弄虚作假","巧立名目"],"opposite":["无所用心"],"usage":"作谓语、定语、状语；指为达到目的"},{"id":2421,"word":"不择生冷","pinyin":"bù zé shēng lěng","abbr":"bzsl","explanation":"犹言不择手段。","source":{"text":"我们这场上的事情，你晓得的，有些人一点不择生冷！一天就想方设法，拖人下水。","book":"沙汀《淘金记》九"},"similar":["不择手段"],"usage":"作谓语、定语；同“不择手段”"},{"id":2422,"word":"不按君臣","pinyin":"bù àn jūn chén","abbr":"bajc","explanation":"中医处方，以君臣相配为原则。君是主药，臣是辅药。不按君臣，就是违反药理，胡乱用药。引申为使用毒药的隐语。","source":{"text":"解宝身边取出不按君臣的药头，张人眼慢，放在酒壶里。","book":"《水浒传》第一一一回"},"example":{"text":"宋四公怀中取出酸馅，着些个～作怪的药，入在里面。","book":"《古今小说·宋四公大闹禁魂张》"},"usage":"作谓语、定语；指使用毒药"},{"id":2423,"word":"不挑之祖","pinyin":"bù tiāo zhī zǔ","abbr":"btzz","explanation":"比喻创立某种事业而受到尊崇的人。","source":{"text":"高适达夫七古，与岑一骨，骈语之中，独能顿宕，启后人无限法门，当为七言不挑之祖。","book":"清·宋育人《三堂诗品》"}},{"id":2424,"word":"不挠不屈","pinyin":"bù náo bù qū","abbr":"bnbq","explanation":"比喻在压力和面前不屈服，表现十分顽强。","source":{"text":"吾民族以不挠不屈之气概，与外族战，与土番战，与寒暑战，卒能斩荆披棘。","book":"清·陈天华《论中国宜改创民主政体》"},"example":{"text":"～，为真理斗到尽头！","book":"郭沫若《屈原》第一幕"},"similar":["不挠不折"],"usage":"作谓语、定语、状语；用于人的意志等"},{"id":2425,"word":"不挠不折","pinyin":"bù náo bù zhé","abbr":"bnbz","explanation":"不弯曲，不屈服。形容节操刚正，意志坚强。","source":{"text":"夫观钱塘江潮，犹猛士之肝胆决裂，义士之怒发冲冠。观仙都天柱，犹直臣之气，不挠不折，社稷之佐，拓地擎天。","book":"宋·刘炎《迩言》"},"example":{"text":"慎哉栗乎！尔毋厉外而懦中也，必也挺拔特立如雪霜之松柏，～以固其节乎！","book":"明·方孝孺《王温子栗字说》"},"similar":["不折不挠","不挠不屈"],"usage":"作谓语、定语、状语；用于人的意志等"},{"id":2426,"word":"不探虎穴，不得虎子","pinyin":"bù tàn hǔ xué，bù dé hǔ zǐ","abbr":"bthxbdhz","explanation":"不进老虎洞，就捉不到小老虎。比喻不冒险进入危险境地，就不能取得必须的成果。同“不入虎穴，焉得虎子”。","source":{"text":"超悉会其吏士三十六人，酒酣激怒曰：‘不探虎穴，不得虎子 。’","book":"《东观汉记·班超传》"},"similar":["不探虎穴，安得虎子"],"usage":"作宾语、分句；指只有经历艰难才能成功"},{"id":2427,"word":"不探虎穴，安得虎子","pinyin":"bù tàn hǔ xué，ān dé hǔ zǐ","abbr":"bthxadhz","explanation":"不进老虎洞，就捉不到小老虎。比喻不冒险进入危险境地，就不能取得必须的成果。同“不探虎穴，不得虎子”。","source":{"text":"贫贱难可居，脱误有功，富贵可致。且不探虎穴，安得虎子？","book":"《三国志·吴志·吕蒙传》"},"example":{"text":"胜败在人而不在险，唯险而后可以见人之能否也。且～！冒大险而后能立奇功。","book":"宋·陈亮《酌古论·马援》"},"similar":["不入虎穴，焉得虎子"],"usage":"作宾语、分句；指只有经历艰难才能成功","story":["三国时期，吴国大将吕蒙15岁时，偷偷地跟随吕当随军打仗。吕当看见后立即大声呵叱他要他回家，吕蒙就是不听。战后吕当回家告诉吕蒙的母亲。吕母十分生气要惩罚他，吕蒙说：“家里贫穷十分艰难，如果打仗立功就能得富贵，不探虎穴，安得虎子？”"]},{"id":2428,"word":"不揣冒昧","pinyin":"bù chuǎi mào mèi","abbr":"bcmm","explanation":"揣：估量，考虑。用于没有慎重考虑就轻率行事的客气话。","source":{"text":"璞不揆梼昧，少而勿焉。","book":"晋·郭璞《〈尔雅〉序》"},"example":{"text":"又看到日本学界也每每用汉文出书，我真是～，竟想把我的论著也拿去尝试。","book":"郭沫若《海涛集·我是中国人》"},"usage":"作谓语；用于谦虚的说法"},{"id":2429,"word":"不揪不採","pinyin":"bù jiū bù cǎi","abbr":"bjbc","explanation":"指不理睬。"},{"id":2430,"word":"不揪不睬","pinyin":"bù chǒu bù cǎi","abbr":"bjbc","explanation":"指不理睬。","source":{"text":"金莲道：‘贼囚根子，他不揪不睬，也是你爹的婊子，许你骂他！’","book":"《金瓶梅词话》第二一回"}},{"id":2431,"word":"不揪不采","pinyin":"bù jiū bù cǎi","abbr":"bjbc","explanation":"指不理睬。","source":{"text":"那妇人只顾饶舌，又见常二不揪不采，自家也有几分惭愧，禁不得掉下泪来。","book":"《金瓶梅词话》第五十六回"}},{"id":2432,"word":"不擒二毛","pinyin":"bù qín èr máo","abbr":"bqem","explanation":"擒：捉拿，捕获。二毛：指头发斑白，引申为上年纪的人。不捕获年长的人。","source":{"text":"宋襄公曰：‘君子不受伤，不擒二毛。’","book":"《左传·僖公二十三年》"}},{"id":2433,"word":"不改其乐","pinyin":"bù gǎi qí lè","abbr":"bgql","explanation":"不改变自有的快乐。指处于困苦的境况仍然很快乐。","source":{"text":"一箪食，一飘饮，在陋巷，人不堪其扰，回出不改其乐。","book":"《论语·雍也》"},"example":{"text":"（孔子）称赞颜回吃喝不够，‘～’。","book":"朱自清《论吃饭》"},"usage":"作谓语；指为人处世"},{"id":2434,"word":"不攻自拔","pinyin":"bù gōng zì bá","abbr":"bgzb","explanation":"拔：攻破。不用攻击就自动破灭。形容情节、论点虚谬，经不起反驳。","source":{"text":"粮食既足，士众稍多，围守两城，不攻自拔，天下之事，卧取之耳。","book":"《梁书·武帝纪》"},"similar":["不攻自破"],"opposite":["无懈可击"],"usage":"作谓语、定语；形容漏洞太多，不堪一击"},{"id":2435,"word":"不攻自破","pinyin":"bù gōng zì pò","abbr":"bgzp","explanation":"无须攻击，自己就会破灭。形容论点站不住脚，经不起反驳或攻击。","source":{"text":"是有都立庙之言，不攻而自破也。","book":"晋·干宝《晋记》：“是故不攻而自败也。”唐·顾德章《上中书门下及礼院详议东都太庙修废状》"},"example":{"text":"郢都无主，～。","book":"明·冯梦龙《东周列国志》第七十六回"},"similar":["理屈词穷","莫名其妙","岂有此理"],"opposite":["无懈可击","久攻不下","坚如磐石"],"usage":"作谓语、定语；形容漏洞太多，不堪一击"},{"id":2436,"word":"不教之教","pinyin":"bù jiào zhī jiào","abbr":"bjzj","explanation":"不以直接的教育方式而进行的教育。指在日常言行中很自然地进行的薰陶。","source":{"text":"不教之教，无言之诏。","book":"《吕氏春秋·君守》"},"example":{"text":"这位身经百战的将军，虽身居高位，却保持着朴素的传统，这对我们是～。"},"usage":"作宾语；指自然的教育"},{"id":2437,"word":"不教而杀","pinyin":"bù jiào ér shā","abbr":"bjes","explanation":"教：教育；杀：处罚，杀死。不警告就处死。指事先不教育人，一犯错误就加以惩罚。","source":{"text":"不教而杀谓之虐。","book":"《论语·尧曰》"},"example":{"text":"对待犯错误的人应当采取治病救人的方针，而不应该～。"},"similar":["不教而诛"],"opposite":["谆谆教诲"],"usage":"作谓语、宾语、定语；用于书面语","story":["春秋时期，56岁的孔子担任鲁国的大司寇，他上任时颁布了三大法令，实行实价买卖，男女分道而行，款待外国人。当时少正卯出来反对被抓，手下问孔子杀不杀，孔子一向推行“仁政”，主张教育，认为“不教而杀谓之虐。”","就把他抓入牢中"]},{"id":2438,"word":"不教而诛","pinyin":"bù jiào ér zhū","abbr":"bjez","explanation":"教：教育；诛：处罚，杀死。不警告就处死。指事先不教育人，一犯错误就加以惩罚。","source":{"text":"故不教而诛，则刑繁而邪不胜；教而不诛，则奸民不惩。","book":"《荀子·富国》"},"example":{"text":"大人限他们三个月叫他们戒烟，宽之以期限，动之以厉害，不忍～。","book":"清·李宝嘉《官场现形记》第二十回"},"similar":["不教而杀"],"opposite":["仁至义尽","谆谆教诲"],"usage":"作谓语、宾语、定语；用于书面语","story":["孔子的学生子张问孔子怎样才能治理好一个国家，孔子答道只须尊奉“五种美德”，除掉“四种恶政”就可以。其中“四恶政”之首就是平时不给人教育，到时候却怪别人而去杀人，这就是虐。其次上暴、贼及小家子气"]},{"id":2439,"word":"不敢后人","pinyin":"bù gǎn hòu rén","abbr":"bghr","explanation":"不愿意落在别人后面。表示不敢懈怠，奋力前进。","source":{"text":"凡遇党政当局对抗战建国积极方面有所号召，亦无不竭诚响应，不敢后人。","book":"邹韬奋《抗战以来》"},"example":{"text":"邹韬奋《抗战以来》：“凡遇党政当局对抗战建国积极方面有所号召，亦无不竭诚响应，不敢后人。”"},"similar":["不甘落后"],"usage":"作谓语、定语；指人要求上进"},{"id":2440,"word":"不敢告劳","pinyin":"bù gǎn gào láo","abbr":"bggl","explanation":"努力做事，不诉说自己的劳苦。比喻勤勤恳恳，不辞辛劳（多用在自己表示谦虚）。","source":{"text":"黾勉从事，不敢告劳。","book":"《诗经·小雅·十月之交》"},"example":{"text":"凡所实施，光明正大。艰苦奋斗，～。","book":"《毛泽东选集·陕甘宁边区政府、第八路军后方留守处布告》"},"similar":["勤勤恳恳","任劳任怨"],"opposite":["居功自傲"],"usage":"作谓语；比喻勤恳做事，不辞劳苦，用于谦辞"},{"id":2441,"word":"不敢掠美","pinyin":"bù gǎn lüè měi","abbr":"bglm","explanation":"掠：掠夺。不敢掠夺旁人之美。","source":{"text":"站在摊旁，匆匆的看了一过，我不由得生起气来！这几篇不知是谁写的。文字不是我的，思想更不是我的，让我掠美了！我生平不敢掠美，也更不愿意人家随便借用我的名字。","book":"冰心《我的文学生活》"},"example":{"text":"说徐义德是‘养活了’工人的‘实业家’，不是小说和作者，而是丁学雷的发明和创造，强加在小说和作者头上，～，理应奉璧。","book":"周而复《上海的早晨》序三"},"opposite":["攘为己有"],"usage":"作谓语；用于处事"},{"id":2442,"word":"不敢旁骛","pinyin":"bù gǎn páng wù","abbr":"bgpw","explanation":"形容全力做一件事，不敢分心到别的事里面去。","source":{"text":"希特勒在西线胜利以前，他似乎是谨慎的。攻波兰，攻挪威，攻荷、比、法，攻巴尔干，都是注全力于一处，不敢旁骛。","book":"毛泽东《第二次世界大战的转折点》"},"example":{"text":"我一接到任务后一直～。"},"similar":["一心一意"],"opposite":["三心二意"],"usage":"作谓语、定语；用于处事"},{"id":2443,"word":"不敢自专","pinyin":"bù gǎn zì zhuān","abbr":"bgzz","explanation":"自专：擅自专断。不敢自作主张，独自行事。有自谦的意思。","source":{"text":"凡在拟议，不敢自专。","book":"唐·韩愈《褅袷议》"},"example":{"text":"令此辈好汉建功进用，于国实有便益。微臣～，乞请圣鉴。","book":"明·施耐庵《水浒传》第八十三回"},"opposite":["独断专行"],"usage":"作谓语；用于自谦"},{"id":2444,"word":"不敢苟同","pinyin":"bù gǎn gǒu tóng","abbr":"bggt","explanation":"苟：苟且。不敢随便地同意。指对人对事抱慎重态度。","source":{"text":"蔺相如完璧归赵，人人都称赞他。但我不敢苟同这一看法。","book":"明·王世贞《蔺相如完璧归赵论》"},"example":{"text":"对于你的观点，我～。"},"similar":["未敢苟同"],"opposite":["随声附和","人云亦云"],"usage":"作谓语；用于处事"},{"id":2445,"word":"不敢越雷池一步","pinyin":"bù gǎn yuè léi chí yī bù","abbr":"bgylcyb","explanation":"越：跨过；雷池：湖名，在安徽省望江县南。原指不要越过雷池。后比喻不敢超越一定的范围和界限。","source":{"text":"吾忧西陲，过于历阳，足下无过雷池一步也。","book":"晋·庾亮《报温峤书》"},"example":{"text":"是用来批评那些已经学习了很多却“～”、在艺术手法上陈陈相因的人们的。","book":"秦牧《独创一格》"},"similar":["原地踏步","故步自封","谨小慎微"],"opposite":["大刀阔斧","大步流星"],"usage":"作谓语、状语、分句；形容人保守拘谨不敢为","story":["东晋明帝时，国舅庾亮派温峤去驻守江州。温峤忠于职守，听到苏峻和祖约起兵反叛，就向庾亮申请回去保卫京城。庾亮回信说：“你一定要全力固守江州，千万不要超过雷池来京城。”"]},{"id":2446,"word":"不敢造次","pinyin":"bù gǎn zào cì","abbr":"bgzc","explanation":"造次：仓促、莽撞。指不敢匆忙地或鲁莽地从事。","source":{"text":"恁么即某甲不敢造次。","book":"宋·释道原《景德传灯录》卷十九"},"example":{"text":"原来上月贾芸进来种树之时，便拣了一块罗帕，知是这园内的人失落的，但不知是那一个人的，故～。","book":"曹雪芹《红楼梦》第二十六回"},"similar":["慎重其事"],"opposite":["轻率鲁莽"],"usage":"作谓语；指慎重办事"},{"id":2447,"word":"不敢问津","pinyin":"bù gǎn wèn jīn","abbr":"bgwj","explanation":"问津：询问渡口，问路。指高贵的、深奥的事物不敢过问或尝试。","source":{"text":"几个月的工夫，除了那些大部头的理论著作我～外，这个小图书馆所有的文艺书籍，我差不多都借阅了。 ★叶文玲《我的“长生果”》"},"example":{"text":"几个月的工夫，除了那些大部头的理论著作我～外，这个小图书馆所有的文艺书籍，我差不多都借阅了。","book":"叶文玲《我的“长生果”》"},"similar":["无人问津"],"usage":"作谓语、状语；指不敢过问"},{"id":2448,"word":"不敢高攀","pinyin":"bù gǎn gāo pān","abbr":"bggp","explanation":"不敢跟社会地位比自己高的人交朋友或结亲戚。","source":{"text":"碧玉小家女，不敢贵德攀。感郎意气重，遂得结金兰。","book":"南宋·郭茂倩《乐府诗集·清商曲辞二·碧玉歌》"},"example":{"text":"他那种人我们是～的。"},"similar":["高攀不上"],"opposite":["巴高望上","攀龙附凤"],"usage":"作谓语、定语；形容不主动与他人结交"},{"id":2449,"word":"不文不武","pinyin":"bù wén bù wǔ","abbr":"bwbw","explanation":"既不能文，又不能武。","source":{"text":"不知官在朝，有益国家不？得无虱其间，不文亦不武。","book":"唐·韩愈《泷吏》诗"},"example":{"text":"他是一个～的庸才。"},"opposite":["能文能武"],"usage":"作谓语、定语；指人无能"},{"id":2450,"word":"不断如带","pinyin":"bù duàn rú dài","abbr":"bdrd","explanation":"犹不绝如缕。多形容局面危急或声音、气息等低沉微弱、时断时续。","source":{"text":"自晋汔隋，老佛显行，圣道不断如带。","book":"《新唐书·韩愈传赞》"},"similar":["不绝如缕"],"usage":"作谓语、定语；用于事物或情绪等"},{"id":2451,"word":"不旋踵","pinyin":"bù xuán zhǒng","abbr":"bxz","explanation":"来不及转身。比喻时间极短。也指不退却。","source":{"text":"柳残阳《阎王梭》十七：“先是有开门声，不旋踵间，茅屋门被人拍的‘嘭嘭’响……”。"}},{"id":2452,"word":"不无小补","pinyin":"bù wú xiǎo bǔ","abbr":"bwxb","explanation":"补：补助，补益。多少有一点益处或多少有一点帮助。","source":{"text":"诸家虽或浅近，要亦不无小补，但在详择之耳。","book":"宋·朱熹《〈尚书〉一·纲领》"},"example":{"text":"穷得当卖全无，虽只区区四金，倒也～。","book":"清·李宝嘉《官场现形记》第二十八回"},"usage":"作谓语；比喻有一点帮助"},{"id":2453,"word":"不日不月","pinyin":"bù rì bù yuè","abbr":"brby","explanation":"指不计日月，没有期限。","source":{"text":"行役反无日月。","book":"《诗经·王风·君子于役》：“君子于役，不日不月。”郑玄注"},"example":{"text":"～，而事以从；不卜不筮，而谨知吉凶。","book":"春秋·齐·管仲《管子·白心》"},"similar":["没日没夜"],"usage":"作谓语；形容没有期限"},{"id":2454,"word":"不时之需","pinyin":"bù shí zhī xū","abbr":"bszx","explanation":"不时：不是预定的时间。说不定什么时候会出现的需要。","source":{"text":"我有斗酒，藏之久矣，以待子不时之需。","book":"宋·苏轼《后赤壁赋》"},"example":{"text":"粮食要有充分的储备，以应～。"},"similar":["不时之须"],"opposite":["一定之规"],"usage":"作宾语；表示说不定什么时候会需要","story":["宋朝时期，密州知府苏轼因为写诗被诬陷入狱，后来被贬到黄州团副使。他在黄州期间，遇到两位好朋友。朋友弄到一条新鲜鲈鱼，苏轼问夫人要酒，夫人王闰之早就给他准备酒以备他不时之需，他们乘船去游赤壁，一直玩到尽兴而归"]},{"id":2455,"word":"不时之须","pinyin":"bù shí zhī xū","abbr":"bszx","explanation":"不时之需。指随时的、不是预定时间的需要。","source":{"text":"我有斗酒，藏之久矣，以待子不时之须。","book":"宋·苏轼《后赤壁赋》"},"example":{"text":"平时所以为民虑者甚周，缓争～，亦为民计而已矣。","book":"宋·陈亮《送徐子才赴富阳序》"},"similar":["不时之需"],"usage":"作宾语；表示说不定什么时候会需要","story":["宋朝时期，密州知府苏轼因为写诗被诬陷入狱，后来被贬到黄州团副使。他在黄州期间，遇到两位好朋友。朋友弄到一条新鲜鲈鱼，苏轼问夫人要酒，夫人王闰之早就给他准备酒以备他不时之需，他们乘船去游赤壁，一直玩到尽兴而归"]},{"id":2456,"word":"不明不暗","pinyin":"bù míng bù àn","abbr":"bmba","explanation":"指事实真相被歪曲而不清楚。也指既不公开，也不秘密。","source":{"text":"不明不暗，负屈衔冤。","book":"元·关汉卿《窦娥冤》第三折"},"example":{"text":"那罗吉虽然只有十六岁年纪，不但攀不上什么八字脚儿，却还跟公安局的什么侦缉～地有些牵扯。","book":"欧阳山《苦斗》"},"usage":"作谓语、状语；用于事情等"},{"id":2457,"word":"不明不白","pinyin":"bù míng bù bái","abbr":"bmbb","explanation":"指说话含含糊糊，很不清楚。也形容行为暧昧。","source":{"text":"怎么不明不白，着他父子每胡厮闹了一夜。","book":"元·无名氏《连环计》第四折"},"example":{"text":"薛婆当时满脸堆下笑来，便道：“大官人休得错怪。老身一生不曾要别人一厘一毫～的钱财。”","book":"明·冯梦龙《古今小说》卷一"},"similar":["模糊不清","无缘无故"],"opposite":["一清二楚"],"usage":"作谓语、定语、状语；形容说话含糊不清"},{"id":2458,"word":"不明事理","pinyin":"bù míng shì lǐ","abbr":"bmsl","explanation":"明：明白，懂得。不懂得事物的道理。"},{"id":2459,"word":"不明底蕴","pinyin":"bù míng dǐ yùn","abbr":"bmdy","explanation":"蕴：含着。不明白事情的底细、原委。指只知表面，不知另有因由。"},{"id":2460,"word":"不明真相","pinyin":"bù míng zhēn xiàng","abbr":"bmzx","explanation":"明：明白；真相：事情的实际情况。不明白事情的实际情况。","source":{"text":"不过他们可以装作懂得的样子，来胡说八道，欺骗不明真相的人。","book":"鲁迅《且介亭杂文·关于新文字》"},"example":{"text":"请尽快公布事情的真相，让那些～的群众回到各自岗位上去。"},"similar":["不明真象"],"opposite":["真相大白"],"usage":"作谓语、定语；指受迷惑"},{"id":2461,"word":"不易一字","pinyin":"bù yì yī zì","abbr":"byyz","explanation":"不更动一个字。形容文章写得又快又好。","source":{"text":"及寤援笔成篇，不易一字。","book":"《新唐书·王勃传》"},"example":{"text":"他～地抄袭我的作品。"},"similar":["一字不易"],"usage":"作谓语、状语；指不改动一个字"},{"id":2462,"word":"不易之典","pinyin":"bù yì zhī diǎn","abbr":"byzd","explanation":"不变的法则。","source":{"text":"教敬不易之典，训人必书之举。","book":"宋·颜延之《赭白马赋》"},"usage":"作宾语；指不变的法则"},{"id":2463,"word":"不易之分","pinyin":"bù yì zhī fèn","abbr":"byzf","explanation":"易：变；分：节操。忠贞不二的节操。","source":{"text":"宾戏主人曰：‘盖闻圣人有壹定之论，列士有不易之分，亦云名而已矣。","book":"汉·班固《答宾戏》"}},{"id":2464,"word":"不易之地","pinyin":"bù yì zhī dì","abbr":"byzd","explanation":"每年可以耕种的肥沃的土地。","source":{"text":"不易之地家百晦。一易之地家二百晦。再易之地家三百晦。","book":"《周礼·地官·大司徒》"}},{"id":2465,"word":"不易之论","pinyin":"bù yì zhī lùn","abbr":"byzl","explanation":"易：改变。不可更改的言论。形容论断或意见非常正确。","source":{"text":"成周三代之际，圣人多生儒中，两汉以下圣人多生佛中，此不易之论也。","book":"宋·惠洪《冷斋夜话》卷一○"},"example":{"text":"人民群众是历史的创造者，这确是～。"},"similar":["不刊之论","不易之典","天经地义"],"opposite":["不经之谈","无稽之谈"],"usage":"作宾语；用于指论点或意见正确"},{"id":2466,"word":"不易之道","pinyin":"bù yì zhī dào","abbr":"byzd","explanation":"易：变。永久不变的规律。","source":{"text":"上必无为而用天下，下必有为为天下用。此不易之道也。","book":"《庄子·天道》"}},{"id":2467,"word":"不易乎世","pinyin":"bù yì hū shì","abbr":"byhs","explanation":"易：变。不因世道的改变而改变操守。","source":{"text":"龙德而隐者也，不易乎世。","book":"《周易·乾》"}},{"id":2468,"word":"不是冤家不碰头","pinyin":"bù shì yuān jiā bù pèng tóu","abbr":"bsyjbpt","explanation":"指仇人或不愿意相见的人偏偏相逢，无可回避。","source":{"text":"还是开春后第一回上坡里做活，就说巧不巧地闹了个‘不是冤家不碰头’啊！","book":"康濯《春种秋收》"},"similar":["不是冤家不聚头"],"usage":"作宾语、定语、分句；用于口语"},{"id":2469,"word":"不是冤家不聚头","pinyin":"bù shì yuān jiā bù jù tóu","abbr":"bsyjbjt","explanation":"冤家：仇人；聚头：聚会。不是前世结下的冤孽，今世就不会聚在一起。","source":{"text":"你每做的来不周，结下了父兄仇，抵多少不是冤家不聚头，今日在杀场上面争驰骤。","book":"元·郑廷玉《楚昭公》第二折"},"example":{"text":"偏偏的遇见了这么两个不懂事的小冤家儿，没有一天不叫我操心，真真的是俗话说的，～了。","book":"清·曹雪芹《红楼梦》第二十九回"},"similar":["冤家路窄","不是冤家不碰头"],"usage":"作宾语、定语、分句；用于口语"},{"id":2470,"word":"不晓世务","pinyin":"bù xiǎo shì wù","abbr":"bxsw","explanation":"不知晓当前重要的事态和时代的潮流。现也指待人接物不知趣。","source":{"text":"拜参知政事，上谓曰：‘人皆不能知卿，以为卿但知经术，不晓世务。’","book":"《宋史·王安石传》"},"similar":["不识时务","不识局面"],"usage":"作谓语、定语；形容人不明事理"},{"id":2471,"word":"不暇应接","pinyin":"bù xiá yìng jiē","abbr":"bxyj","explanation":"暇：空闲。原形容景物繁多，来不及观赏。后多形容来人或事情太多，应付不过来。","source":{"text":"镜湖澄澈，清流泻注；山川之美，使人应接不暇。","book":"晋·王献之《镜湖贴》"},"example":{"text":"旧地重游，以前所惯识的各种景物争把过去的事情告诉我，使我耳目～，心情不胜感慨。","book":"《丰子恺游记·旧地重游》"}},{"id":2472,"word":"不曾序过","pinyin":"bu ceng xu guo","abbr":"bcxg","explanation":"意思是没有宗族关系。序，指按宗族的谱系排辈分。"},{"id":2473,"word":"不服水土","pinyin":"bù fú shuǐ tǔ","abbr":"bfst","explanation":"不能适应移居地方的气候和饮食习惯。","source":{"text":"道理来远，或不服水土，药自可疗。","book":"《三国志·吴志·周瑜传》：“不习水土，必生疾病。”《宋书·索虏传》"},"example":{"text":"吾兵久劳于外，～，必生疾病。宜召军还，再作后图。","book":"明·罗贯中《三国演义》第一二０回"},"similar":["水土不服"],"usage":"作谓语、定语；指不适应外地的气候与饮食"},{"id":2474,"word":"不期修古","pinyin":"bù qī xiū gǔ","abbr":"bqxg","explanation":"期：希望；修：遵循。不要照搬老办法。指应根据实际情况实行变革。","source":{"text":"是以圣人不期修古，不法常可。","book":"《韩非子·五蠹》"},"opposite":["墨守成规"],"usage":"作谓语、宾语；指应根据实际情况实行变革"},{"id":2475,"word":"不期然而然","pinyin":"bù qī rán ér rán","abbr":"bqrer","explanation":"没有想到是这样而竟然是这样。","source":{"text":"盖磁石取铁，以气相合，固有不期然而然者。","book":"宋·郑樵《与景韦兄投宇文枢密书》"},"example":{"text":"大家有了这样的一个安心，所以～的便全部响应了。"},"similar":["不期而然"],"usage":"作谓语、状语；形容不希望如此竟然如此"},{"id":2476,"word":"不期而会","pinyin":"bù qī ér huì","abbr":"bqeh","explanation":"①未经约定而意外地遇见。②未经约定而自动聚集。","source":{"text":"不期而会曰遇。","book":"语出《榖梁传·隐公八年》"},"example":{"text":"晚上九点钟光景，吴公馆里～的来了些至亲好友，慰问吴荪甫在厂所受的惊吓。","book":"茅盾《子夜》十四"},"similar":["不期而遇"],"usage":"作谓语；指意外会见"},{"id":2477,"word":"不期而同","pinyin":"bù qī ér tóng","abbr":"bqet","explanation":"指不约而同。","source":{"text":"仿吾教人要注重科学，他的论调与吴稚晖的虽若不期而同，但是吴稚晖所注眼的是功利问题。","book":"郭沫若《文艺论集整理国故的评价》"},"similar":["不约而同"],"usage":"作谓语；同“不约而同”"},{"id":2478,"word":"不期而然","pinyin":"bù qī ér rán","abbr":"bqer","explanation":"期：希望；然：如此。不希望这样，而竟然这样。表示出乎意外。","source":{"text":"盖磁石取铁，以气相合，固有不期然而然者。","book":"宋·郑樵《与景韦兄投宇文枢密书》"},"example":{"text":"名山大川之间，赤县神州之外，无远勿届，不期而然。","book":"清·吴研人《糊涂世界·序》"},"similar":["出乎意料"],"opposite":["意料之中"],"usage":"作谓语、状语；形容意想不到的事"},{"id":2479,"word":"不期而遇","pinyin":"bù qī ér yù","abbr":"bqey","explanation":"期：约定时间。没有约定而遇见。指意外碰见。","source":{"text":"不期而会曰遇。","book":"《谷梁传·隐公八年》"},"example":{"text":"前在公主府内，也是我们姐妹三十三个先会面；今日～，又是如此。","book":"清·李汝珍《镜花缘》第六十九回"},"similar":["不约而同","萍水相逢","不谋而合"],"opposite":["失之交臂"],"usage":"作谓语、定语、状语；形容意外相遇"},{"id":2480,"word":"不朽之功","pinyin":"bù xiǔ zhī gōng","abbr":"bxzg","explanation":"不配：永不磨灭；功：功业。永远不能磨灭的功业。比喻功勋卓著。"},{"id":2481,"word":"不朽之勋","pinyin":"bù xiǔ zhī xūn","abbr":"bxzx","explanation":"不朽：永不磨灭；勋：功勋。永不磨灭的功勋。","source":{"text":"彰诸侯不朽之勋，广元后无为之化。","book":"唐·郑亚《李文饶集序》"}},{"id":2482,"word":"不朽之盛事","pinyin":"bù xiǔ zhī shèng shì","abbr":"bxzss","explanation":"不朽：永不磨灭。永不磨灭的事业。","source":{"text":"盖文章经国之大业，不朽之盛事。","book":"三国·魏·曹丕《典论·论文》"}},{"id":2483,"word":"不朽之芳","pinyin":"bù xiǔ zhī fāng","abbr":"bxzf","explanation":"朽：腐朽；芳：花草。永远不腐朽的花草。比喻美好的名声万古流芳。","source":{"text":"身受进贤之赏，名有不朽之芳。","book":"汉·桓谭《新论·荐贤》"}},{"id":2484,"word":"不染一尘","pinyin":"bù rǎn yī chén","abbr":"bryc","explanation":"形容清高廉洁。同“一尘不染”。","source":{"text":"胸中不染一尘，惟澄观天下之得失是非，自抒伟论。","book":"郑观应《盛世危言·日报》"},"similar":["一尘不染"],"opposite":["同流合污"],"usage":"作谓语、定语、宾语；用于人的言行等"},{"id":2485,"word":"不栉进士","pinyin":"bù zhì jìn shì","abbr":"bzjs","explanation":"栉：梳头。不绾髻插簪的进士。旧指有文采的女人。","source":{"text":"关图有妹能文，每语人曰：‘有一进士，所恨不栉耳。’","book":"唐·刘讷言《谐喙录·不栉进士》"},"usage":"作主语、宾语；用于女性"},{"id":2486,"word":"不根之论","pinyin":"bù gēn zhī lùn","abbr":"bgzl","explanation":"根：根据；论：言论。没有根据的言论。","source":{"text":"朔、皋不根持论，上颇俳优畜之。","book":"《汉书·严助传》"},"example":{"text":"苟足以移科举骫骳之文，～，是某等之心，而识者岂必以是而尽求公哉。","book":"宋·陈亮《郑景望杂著序》"},"similar":["不根之谈"],"opposite":["真凭实据"],"usage":"作宾语；用于说话或文章"},{"id":2487,"word":"不根之谈","pinyin":"bù gān zhī tán","abbr":"bgzt","explanation":"指没有根据的话。","source":{"text":"扬州有喜姓，俗言先本姓史，嫌与死同音，乃改为喜。此不根之谈也。","book":"清·沈涛《交翠轩笔记》卷四"},"example":{"text":"清初刻《西游记》小说者，又取虞集撰《长春真人西游记》之序文冠其首，而～乃愈不可拔也。","book":"鲁迅《中国小说史略》第十七篇"},"similar":["无稽之谈"],"opposite":["真凭实据"],"usage":"作宾语；用于说话或文章"},{"id":2488,"word":"不根持论","pinyin":"bù gēn chí lùn","abbr":"bgcl","explanation":"根：根据；持论：提出自己的论点或主张。指毫无根据地提出个人的论点或主张。","source":{"text":"朔、皋不根持论，上颇俳优畜之。","book":"《汉书·严助传》"}},{"id":2489,"word":"不次不宠","pinyin":"bù cì zhī chǒng","abbr":"bcbc","explanation":"不次：不按寻常的次序。超越常规的恩宠。指特殊的恩宠。","source":{"text":"今圣天子选用贤良，一新时政，虽前日隐晦之人亦将出而仕矣，况因平昔非隐晦者邪？况加以不次之宠，处之以优崇之地邪？","book":"元·刘因《上宰相书》"}},{"id":2490,"word":"不次之位","pinyin":"bù cì zhī wèi","abbr":"bczw","explanation":"次：顺序，等第。旧指对于有才干的人不拘等级授予重要职位。","source":{"text":"武帝初即位，征天下举方正贤良文学材力之士，待以不次之位。","book":"东汉·班固《汉书·东方朔传》"},"example":{"text":"我也希望有～。"},"similar":["不次之迁"],"usage":"作宾语；指破格提拔"},{"id":2491,"word":"不次之图","pinyin":"bù cì zhī tú","abbr":"bczt","explanation":"此：这，这个；图：图谋，打算。不打算做这件事或不考虑这个问题。","source":{"text":"以明公之威，击疲惫之众，如迅风之扫秋叶也。不此之图，而伐荆州；荆州丰乐之地，国和民顺，未可动摇。","book":"明·罗贯中《三国演义》第三十二回"}},{"id":2492,"word":"不次之迁","pinyin":"bù cì zhī qiān","abbr":"bczq","explanation":"次：顺序，等第；迁：官位升迁。比喻超出常规的提升官级。","source":{"text":"武帝初即位，征天下举方正贤良文学材力之士，待以不次之位。","book":"《汉书·东方朔传》"},"example":{"text":"果能使地方安静，虽无～，要亦不至于冻馁。","book":"清·刘鹗《老残游记》第七回"},"similar":["不次之位","连升三级","破格提拔"],"usage":"作宾语；指破格提拔"},{"id":2493,"word":"不欢而散","pinyin":"bù huān ér sàn","abbr":"bhes","explanation":"散：离开，分手。很不愉快地分手。","source":{"text":"众客咸不欢而散。","book":"明·冯梦龙《醒世通言·黄秀才徼灵玉马坠》"},"example":{"text":"公子大惭，～。","book":"清·蒲松龄《聊斋志异·辛十四娘》"},"similar":["妻离子散","一哄而散"],"opposite":["济济一堂","欢聚一堂"],"usage":"作谓语、状语；用于意见不合，感情破裂"},{"id":2494,"word":"不欺地下","pinyin":"bù qī dì xià","abbr":"bqdx","explanation":"地下：黄泉之下。指人刚正不阿，坚持原则。","example":{"text":"我们要～，不能乱给死人栽赃。"},"similar":["不欺暗室"],"opposite":["死无对证"],"usage":"作谓语、定语；指人刚正","story":["唐朝时期，史官吴竞与刘知畿十分忠实历史事实，撰写《武后实录》，对张昌宗引诱张说诬陷魏元忠作了合乎事实的记载。后来宰相张说要求吴竞修改。吴竞说：“刘知畿虽然故去，我不能让他在九泉之下受到诬陷，我不能徇私舞弊去篡改历史。”"]},{"id":2495,"word":"不欺室漏","pinyin":"bù qī shì lòu","abbr":"bqsl","explanation":"屋漏：古代室内西北角。原指独处于室时慎守善德，无愧于心。后转义为心地光明，在暗中也不做坏事，不起邪念。","source":{"text":"自是大臣守正，不欺室漏。","book":"清·名教中人《好逑传》第13回"},"similar":["不惭屋漏","不欺屋漏"],"opposite":["暗室欺心"],"usage":"作谓语、定语；形容为人正直"},{"id":2496,"word":"不欺屋漏","pinyin":"bù qī wū lòu","abbr":"bqwl","explanation":"比喻即使在暗中也不做坏事，不起坏念头。","source":{"text":"台兄乃不欺屋漏之君子，不胜愧悔。","book":"《好逑传》第八回"},"similar":["不愧屋漏","无愧屋漏"],"opposite":["暗室欺心"],"usage":"作谓语；形容为人正直"},{"id":2497,"word":"不欺暗室","pinyin":"bù qī àn shì","abbr":"bqas","explanation":"欺：欺骗自己；暗室：人家看不见的地方。在没有人看见的地方，也不做见不得人的事。","source":{"text":"类君子之有道，入暗室而不欺。","book":"唐·骆宾王《萤火赋》"},"example":{"text":"知县生平～，既读孔、孟之书，怎敢行盗跖之事？","book":"明·冯梦龙《醒世恒言》卷十三"},"similar":["光明磊落"],"opposite":["暗室欺心"],"usage":"作谓语、定语；形容不做亏心事","story":["春秋时期，卫国国君卫灵公一天夜里听到一阵马车的声音由远而近，过一会悄无声息，后来又由近而远，卫灵公感到奇怪便问夫人。夫人说是贤臣蘧伯玉，只有他始终如一坚持朝中礼制，卫灵公派人去调查，果然是蘧伯玉"]},{"id":2498,"word":"不欺闇室","pinyin":"bù qī àn shì","abbr":"bqas","explanation":"闇àn室：遮去光线的房间。同“不欺暗室”。"},{"id":2499,"word":"不正之风","pinyin":"bù zhèng zhī fēng","abbr":"bzzf","explanation":"不正当的社会风气。","source":{"text":"移不正之风，易流遁之俗。","book":"晋·葛洪《抱朴子·辩问》"},"example":{"text":"自觉地遵守有关规定，坚决反对特殊化，纠正一切～。","book":"邓小平《高级干部要带头发扬党的优良传统》"},"similar":["歪风邪气"],"opposite":["浩然正气"],"usage":"作主语、宾语；指社会风气"},{"id":2500,"word":"不此之图","pinyin":"bù cǐ zhī tú","abbr":"bczt","explanation":"此：这个；图：图谋，计划。不打算做此事或不考虑这个问题。","source":{"text":"不此之图，而伐荆州，荆州丰乐之地，国和民顺，未可动摇。","book":"明·罗贯中《三国演义》第32回"},"usage":"作宾语、分句；指不考虑此事"}]
