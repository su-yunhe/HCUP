index 0000000000000000000000000000000000000000..5642a147c02c7e52da01cc6a32e8ea40d265beb5
--- /dev/null
+++ b/hypium_tests/cmu_helpers.py
@@ -0,0 +1,191 @@
+"""cmu-spec1 自测公共辅助：应用导航、在线服务表单操作、服务端请求观测。"""
+from __future__ import annotations
+
+import base64
+import threading
+import time
+import urllib.request
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+from hypium import BY
+
+from harness.driver import HarnessTestCase
+
+BUNDLE = "cc.chenlvin.cloudmusic"
+# 模拟器访问宿主机
+HOST = "10.0.2.2"
+# 本机 docker 容器 netease_cloud_music_api（真实兼容服务）
+API_PORT = "3000"
+UPSTREAM = "http://127.0.0.1:3000"
+# 测试内置的记录代理端口：记录每个请求的路径与 Authorization 头，再转发给真实服务
+PROXY_PORT = 3901
+# 无服务监听的端口（连接被拒绝，检查立即失败）
+DEAD_PORT = "3999"
+
+T7 = "配置已保存，正在检查服务是否可用…"
+T9 = "如需连接在线内容，请设置在线服务"
+T10 = "设置在线服务"
+T12 = "本地文件列表为空\n右上方入口支持上传本地音频"
+
+FIELDS = ("api_host_input", "api_port_input", "api_path_input", "api_user_input", "api_password_input")
+
+
+# ---------------- 服务端观测 ----------------
+# 真实服务带 2 分钟响应缓存，命中缓存的请求不写日志，所以请求计数统一经本代理观测。
+
+class RecordingProxy:
+    """记录请求的转发代理；/inner/version 可人为延迟，用于构造“检查在途”。
+
+    delay_prefix 非空时只延迟以该前缀开头的 /inner/version（如配置路径 /slow），其余照常返回。
+    """
+
+    def __init__(self, port: int = PROXY_PORT, upstream: str = UPSTREAM):
+        self.requests: list[tuple[str, str | None]] = []
+        self.delay = 0.0
+        self.delay_prefix: str | None = None
+        proxy = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_GET(self):  # noqa: N802
+                proxy.requests.append((self.path, self.headers.get("Authorization")))
+                if "/inner/version" in self.path and proxy.delay and (
+                        not proxy.delay_prefix or self.path.startswith(proxy.delay_prefix)):
+                    time.sleep(proxy.delay)
+                try:
+                    with urllib.request.urlopen(upstream + self.path, timeout=10) as resp:
+                        body = resp.read()
+                except Exception:  # noqa: BLE001
+                    body = b'{"code":500}'
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, *args):
+                pass
+
+        self.httpd = ThreadingHTTPServer(("0.0.0.0", port), Handler)
+        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
+
+    def __enter__(self):
+        self.thread.start()
+        return self
+
+    def __exit__(self, *exc):
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+    def clear(self) -> None:
+        self.requests.clear()
+
+    def paths(self, prefix: str) -> list[str]:
+        """以 prefix 开头（忽略查询串）的请求路径。"""
+        return [p for p, _ in self.requests if p.split("?", 1)[0].endswith(prefix)]
+
+    def auth_of(self, prefix: str) -> list[str | None]:
+        return [a for p, a in self.requests if p.split("?", 1)[0].endswith(prefix)]
+
+
+def basic_auth(user: str, password: str) -> str:
+    return "Basic " + base64.b64encode(f"{user}:{password}".encode()).decode()
+
+
+# ---------------- 应用导航与表单 ----------------
+
+class CmuTestCase(HarnessTestCase):
+    """本题测试基类：冷启动、进入在线服务配置页、填写并保存表单。"""
+
+    def restart(self, wait: float = 3) -> None:
+        self.driver.stop_app(BUNDLE)
+        self.driver.wait(1)
+        self.driver.start_app(BUNDLE)
+        self.require_component(BY.key("__NavigationField__Text__MainTitle__"), "应用未能冷启动", timeout=20)
+        self.driver.wait(wait)
+
+    def click_text(self, text: str, timeout: float = 15) -> None:
+        comp = self.require_text(text, f"未找到文案 {text!r}", timeout=timeout)
+        comp.click()
+        self.driver.wait(0.8)
+
+    def click_key(self, key: str, timeout: float = 15) -> None:
+        comp = self.require_component(BY.key(key), f"未找到组件 id={key!r}", timeout=timeout)
+        comp.click()
+        self.driver.wait(0.8)
+
+    def open_api_page(self) -> None:
+        """我的 → 应用设置 → 在线服务 → 在线服务配置页（已在配置页则不动）。"""
+        if self.exists(BY.key("api_host_input")) and self.exists(BY.key("api_set_page")):
+            return
+        self.close_settings()
+        self.click_text("我的")
+        self.click_text("应用设置")
+        self.click_text("在线服务")
+        self.require_text("在线服务配置", "未进入在线服务配置页")
+        self.require_component(BY.key("api_host_input"), "配置页缺少主机输入框")
+
+    def close_settings(self) -> None:
+        """返回直到配置页与设置面板都关闭（第一次返回可能只是收起软键盘）。"""
+        for _ in range(4):
+            if not self.exists(BY.key("api_host_input")) and not self.exists(BY.key("settings_online_service")):
+                return
+            self.driver.press_back()
+            self.driver.wait(1)
+
+    def input_value(self, key: str) -> str:
+        comp = self.require_component(BY.key(key), f"未找到输入框 {key}")
+        return comp.getText() or ""
+
+    def fill(self, key: str, value: str) -> None:
+        comp = self.require_component(BY.key(key), f"未找到输入框 {key}")
+        comp.clearText()
+        if value:
+            comp.inputText(value)
+        self.driver.wait(0.3)
+
+    def fill_form(self, host: str = "", port: str = "", protocol: str = "HTTP", path: str = "",
+                  user: str = "", password: str = "") -> None:
+        for key, value in zip(FIELDS, (host, port, path, user, password)):
+            self.fill(key, value)
+        self.click_key("api_protocol_https" if protocol == "HTTPS" else "api_protocol_http")
+
+    def save(self) -> str | None:
+        """点击“保存配置”，返回捕获到的 Toast 文本。"""
+        self.driver.start_listen_toast()
+        self.click_key("api_save_button")
+        return self.driver.get_latest_toast(timeout=5)
+
+    def status(self) -> str:
+        return self.require_component(BY.key("api_status"), "未找到连通性状态").getText()
+
+    def wait_status(self, expected: str, timeout: float = 20) -> str:
+        deadline = time.monotonic() + timeout
+        value = self.status()
+        while value != expected and time.monotonic() < deadline:
+            self.driver.wait(0.5)
+            value = self.status()
+        return value
+
+    def configure(self, host: str, port: str = "", **kwargs) -> None:
+        """冷启动并经设置页保存一份配置，结束后回到发现页。"""
+        self.restart()
+        self.open_api_page()
+        self.fill_form(host=host, port=port, **kwargs)
+        self.save()
+        self.driver.wait(2)
+        self.close_settings()
+        self.click_text("发现")
+
+    def wait_until(self, predicate, timeout: float = 20, interval: float = 0.5) -> bool:
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            if predicate():
+                return True
+            self.driver.wait(interval)
+        return predicate()
+
+    def wait_gone(self, by, timeout: float = 10) -> bool:
+        return self.wait_until(lambda: self.driver.find_component(by) is None, timeout=timeout)
+
+    def exists(self, by) -> bool:
+        return self.driver.find_component(by) is not None
diff --git a/hypium_tests/test_s1_api_config.py b/hypium_tests/test_s1_api_config.py
new file mode 100644
index 0000000000000000000000000000000000000000..0aa416828aec313083eeda7a476c75ab90dbdf6c
--- /dev/null
+++ b/hypium_tests/test_s1_api_config.py
@@ -0,0 +1,166 @@
+"""场景一：设置 → 在线服务 → 在线服务配置（结构化表单、保存提示、连通性检查）。"""
+from __future__ import annotations
+
+from hypium import BY
+
+from hypium_tests.cmu_helpers import (DEAD_PORT, HOST, PROXY_PORT, T7, CmuTestCase, RecordingProxy,
+                                      basic_auth)
+
+PORT = str(PROXY_PORT)
+
+
+class TestS1ApiConfig(CmuTestCase):
+    proxy: RecordingProxy
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        super().setUpClass()
+        cls.proxy = RecordingProxy().__enter__()
+
+    @classmethod
+    def tearDownClass(cls) -> None:
+        cls.proxy.__exit__(None, None, None)
+
+    def setUp(self) -> None:
+        self.proxy.delay = 0.0
+        self.proxy.delay_prefix = None
+
+    def checks(self) -> int:
+        return len(self.proxy.paths("/inner/version"))
+
+    # A1-A9：入口、标题、六项输入、协议选项、状态、保存按钮
+    def test_01_form_structure(self):
+        self.restart()
+        self.open_api_page()
+        for label in ("主机", "端口", "请求", "路径", "用户", "密码", "HTTP", "HTTPS", "保存配置"):
+            self.require_text(label, f"配置页缺少 {label!r}", timeout=3)
+        for key in ("api_host_input", "api_port_input", "api_path_input", "api_user_input",
+                    "api_password_input", "api_protocol_http", "api_protocol_https", "api_save_button"):
+            self.require_component(BY.key(key), f"缺少组件 {key}", timeout=3)
+        self.assertIn(self.status(), ("正常", "不可用"))
+        self.assertIsNotNone(self.find_or_none(BY.text("正常"), 1) or self.find_or_none(BY.text("不可用"), 1),
+                             "状态值不是独立的 正常/不可用 文本")
+        self.assertIsNone(self.find_or_none(BY.text("在线服务"), 1), "配置页内不应出现与选项同名的文本")
+        self.assertTrue(self.require_component(BY.key("api_save_button"), "").isClickable())
+
+    # A11-A14：保存提示 + 真实检查请求 + 状态自动刷新（不可用 → 正常）
+    def test_02_save_toast_and_check(self):
+        self.restart()
+        self.open_api_page()
+        self.fill_form(host=HOST, port=DEAD_PORT)
+        self.assertEqual(self.save(), T7)
+        self.assertEqual(self.wait_status("不可用"), "不可用")
+
+        self.proxy.clear()
+        self.fill_form(host=HOST, port=PORT)
+        self.assertEqual(self.save(), T7)
+        self.assertEqual(self.wait_status("正常"), "正常", "检查通过后状态未自动变为 正常")
+        self.assertEqual(self.checks(), 1, f"保存一次应恰好发 1 次检查请求: {self.proxy.requests}")
+        self.assertIsNone(self.proxy.auth_of("/inner/version")[0], "未配置用户/密码时不应带认证头")
+
+    # A17：返回重进、冷启动后回显；冷启动自动检查
+    def test_03_persist_after_reenter_and_restart(self):
+        self.close_settings()
+        self.open_api_page()
+        self.assertEqual(self.input_value("api_host_input"), HOST)
+        self.assertEqual(self.input_value("api_port_input"), PORT)
+        self.proxy.clear()
+        self.restart()
+        self.assertTrue(self.wait_until(lambda: self.checks() >= 1, 10), "冷启动未检查服务")
+        self.open_api_page()
+        self.assertEqual(self.input_value("api_host_input"), HOST)
+        self.assertEqual(self.input_value("api_port_input"), PORT)
+        self.assertTrue(self.require_component(BY.key("api_protocol_http"), "").isChecked())
+        self.assertEqual(self.wait_status("正常"), "正常")
+        self.assertEqual(self.checks(), 1, "进入配置页不应额外发检查请求")
+
+    # A20：检查在途时连点保存，同一配置只发 1 次
+    def test_04_rapid_save_no_duplicate_request(self):
+        self.open_api_page()
+        self.proxy.clear()
+        self.proxy.delay = 3.0
+        save_btn = self.require_component(BY.key("api_save_button"), "缺少保存按钮")
+        for _ in range(3):
+            save_btn.click()
+            self.driver.wait(0.3)
+        self.driver.wait(4)
+        self.assertEqual(self.checks(), 1, f"连点产生了重复请求: {self.proxy.paths('/inner/version')}")
+        self.assertEqual(self.wait_status("正常"), "正常")
+
+    # A20：慢的旧检查（失败）晚返回，不得覆盖新配置的结果
+    def test_05_stale_result_ignored(self):
+        self.open_api_page()
+        self.proxy.clear()
+        self.proxy.delay = 5.0
+        self.proxy.delay_prefix = "/slow"
+        self.fill_form(host=HOST, port=PORT, path="slow")  # /slow/inner/version → 上游 404 → 不可用
+        self.save()
+        self.fill_form(host=HOST, port=PORT, path="")
+        self.save()
+        self.assertEqual(self.wait_status("正常"), "正常")
+        self.driver.wait(6)
+        self.assertEqual(self.proxy.paths("/inner/version")[0].split("?")[0], "/slow/inner/version")
+        self.assertEqual(self.status(), "正常", "旧请求晚返回覆盖了新结果")
+
+    # A16：用户/密码 → HTTP Basic 认证；清空后不再带
+    def test_06_basic_auth(self):
+        self.open_api_page()
+        self.proxy.clear()
+        self.fill_form(host=HOST, port=PORT, user="tester", password="p@ss")
+        self.save()
+        self.assertTrue(self.wait_until(lambda: self.checks() >= 1, 10))
+        self.assertEqual(self.proxy.auth_of("/inner/version")[-1], basic_auth("tester", "p@ss"))
+        self.proxy.clear()
+        self.fill_form(host=HOST, port=PORT)
+        self.save()
+        self.assertTrue(self.wait_until(lambda: self.checks() >= 1, 10))
+        self.assertIsNone(self.proxy.auth_of("/inner/version")[-1])
+        self.assertEqual(self.wait_status("正常"), "正常")
+
+    # A5/A15/A6：HTTPS 选择、路径规范化、非法端口
+    def test_07_protocol_path_port_normalization(self):
+        self.open_api_page()
+        self.fill_form(host=" http://" + HOST + "/ ", port="70000", protocol="HTTPS", path=" /api/ ")
+        self.save()
+        self.assertEqual(self.wait_status("不可用"), "不可用")
+        self.close_settings()
+        self.open_api_page()
+        self.assertEqual(self.input_value("api_host_input"), HOST)
+        self.assertEqual(self.input_value("api_port_input"), "")
+        self.assertEqual(self.input_value("api_path_input"), "/api")
+        self.assertTrue(self.require_component(BY.key("api_protocol_https"), "").isChecked())
+        self.assertFalse(self.require_component(BY.key("api_protocol_http"), "").isChecked())
+        # 点击选项文字也能切换
+        self.click_text("HTTPS")
+        self.find_or_none(BY.text("HTTP"), 2).click()
+        self.driver.wait(0.5)
+        self.assertTrue(self.require_component(BY.key("api_protocol_http"), "").isChecked())
+
+    # A22：修改未保存即返回 → 不持久化、不发请求
+    def test_08_unsaved_changes_discarded(self):
+        self.open_api_page()
+        self.fill_form(host=HOST, port=PORT)
+        self.save()
+        self.assertEqual(self.wait_status("正常"), "正常")
+        self.proxy.clear()
+        self.fill("api_host_input", "example.invalid")
+        self.close_settings()
+        self.open_api_page()
+        self.assertEqual(self.input_value("api_host_input"), HOST)
+        self.assertEqual(self.checks(), 0)
+        self.assertEqual(self.status(), "正常")
+
+    # A19：纯空格主机 → 允许保存（清除配置），提示 T7，不发请求，状态不可用
+    def test_09_blank_host_clears_config(self):
+        self.open_api_page()
+        self.proxy.clear()
+        self.fill_form(host="   ", port=PORT)
+        self.assertEqual(self.save(), T7)
+        self.assertEqual(self.wait_status("不可用", 5), "不可用")
+        self.driver.wait(1)
+        self.assertEqual(self.checks(), 0, "主机为空时不应发检查请求")
+        self.restart()
+        self.open_api_page()
+        self.assertEqual(self.input_value("api_host_input"), "")
+        self.assertEqual(self.status(), "不可用")
+        self.close_settings()
