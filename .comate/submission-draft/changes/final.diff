+[{"id":42501,"word":"跌跌跄跄","pinyin":"diē diē qiàng qiàng","abbr":"ddqq","explanation":"行走不稳的样子。","example":{"text":"她摔伤以后，走路～的样子让人发笑。"},"similar":["跌跌撞撞"],"usage":"作定语、状语；指行走不稳的样子"},{"id":42502,"word":"跑了和尚跑不了寺","pinyin":"pǎo le hé shàng pǎo bù le sì","abbr":"plhspbls","explanation":"指纵然一时躲掉，但由于其他无法摆脱的牵累，最后还是无法脱身。同“跑了和尚跑不了庙”。","example":{"text":"～，他是逃避不了责任的。"},"similar":["跑了和尚跑不了庙"],"usage":"作宾语、定语；用于口语"},{"id":42503,"word":"跑了和尚跑不了庙","pinyin":"pǎo le hé shàng pǎo bù le miào","abbr":"plhspblm","explanation":"指纵然一时躲掉，但由于其他无法摆脱的牵累，最后还是无法脱身。","example":{"text":"你这是～，何必呢？"},"similar":["跑了和尚跑不了寺"],"usage":"作宾语、定语；用于口语"},{"id":42504,"word":"跑单帮","pinyin":"pǎo dān bāng","abbr":"pdb","explanation":"指以经商为职业的个人往来各地贩卖货物牟利或指个人全权处事。","example":{"text":"他辞去公职后，开始～。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":42505,"word":"跑江湖","pinyin":"pǎo jiāng hú","abbr":"pjh","explanation":"指旧时以卖艺、算卦、相面、卖药等为职业，来往各地谋求生活。","example":{"text":"他从小就开始～。"},"similar":["闯江湖"],"usage":"作谓语、宾语、定语；指来往各地谋求生活"},{"id":42506,"word":"跑肚拉稀","pinyin":"pǎo dù lā xī","abbr":"pdlx","explanation":"泻肚，拉肚子。","example":{"text":"初到南方就开始～。"},"similar":["河鱼腹疾"],"usage":"作谓语、宾语、定语；用于口语"},{"id":42507,"word":"跑跑跳跳","pinyin":"pǎo pǎo tiào tiào","abbr":"pptt","explanation":"形容连跑带跳，很活泼的样子。","example":{"text":"她走路～的，两只羊角辫在空中飞舞。"},"similar":["连跑带跳"],"usage":"作状语；形容很活泼"},{"id":42508,"word":"跑跑颠颠","pinyin":"pǎo pǎo diān diān","abbr":"ppdd","explanation":"忙碌奔走，一点也不闲着。形容非常忙碌。","example":{"text":"他在车站～的，为路人扛行李。"},"usage":"作状语；形容非常忙碌"},{"id":42509,"word":"跑马卖解","pinyin":"pǎo mǎ mài jiè","abbr":"pmmx","explanation":"指在马上表演各种技艺，以此赚钱谋生。","source":{"text":"宁陵县中有父子几人，姓蒋名自兴，原是跑马卖解人家。","book":"清·李百川《绿野仙踪》第三十回"},"example":{"text":"那一群逃跑的人分明是～的。你看，走在前边的那个老头子还牵着一只猴子。","book":"姚雪垠《李自成》第一卷第二十一章"},"similar":["跑马解"],"usage":"作谓语、宾语；指江湖谋生"},{"id":42510,"word":"跑马观花","pinyin":"pǎo mǎ guān huā","abbr":"pmgh","explanation":"比喻大略地观看一下。","source":{"text":"春风得意马蹄疾，一日看尽长安花。","book":"语出唐·孟郊《登科后》诗"},"example":{"text":"他～地把这部诗剧读了一遍，已经是傍晚时分了。","book":"郭沫若《万引》"},"similar":["走马观花"],"usage":"作宾语、状语；指粗略看一下"},{"id":42511,"word":"跑龙套","pinyin":"pǎo lóng tào","abbr":"plt","explanation":"原指戏曲中拿着旗子做兵卒的角色，后比喻在人手下做无关紧要的事。","source":{"text":"跑龙套在戏台上象是个无固定任务角色，姓名通常不上海报，虽然每一出戏文中大将或寨主出场，他都得前台露面打几个转，而且要严肃认真，不言不笑，凡事照规矩行动，随后才必恭必敬的分站两旁。","book":"沈从文《跑龙套》"},"example":{"text":"你记得吧，在文工团里时，一唱平戏就叫我～。","book":"邓友梅《追赶队伍的女兵们》三"},"usage":"作谓语、定语；指在人手下打杂"},{"id":42512,"word":"跖犬吠尧","pinyin":"zhí quán fèi yáo","abbr":"zqfy","explanation":"桀的犬向尧狂吠。比喻各为其主。","source":{"text":"跖之狗吠尧，非贵跖而贱尧也，狗固吠非其它也。","book":"《战国策·齐策》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“～，吠非其主；鸠居鹊巢，安享其成。”"},"similar":["跖狗吠尧"],"usage":"作宾语；比喻各为其主","story":["战国时期，齐国大臣田单不计较骂他的貂勃，备酒宴向貂勃请教错在哪里？貂勃回答说跖犬吠尧并不是尧不圣明而是各为其主。田单把他推荐给齐王，齐王派他出使楚国，引起齐王9个宠臣的不满而攻击田单，貂勃慷慨陈词救了相国田单"]},{"id":42513,"word":"跖犬噬尧","pinyin":"zhí quǎn shì yáo","abbr":"zqsy","explanation":"原指人臣各为其主。后用以比喻嫉妒贤才。","source":{"text":"貂勃曰：‘跖之狗吠尧，非贵跖而贱尧也，狗固吠非其主也。’","book":"《战国策·齐策六》"},"similar":["跖犬吠尧","跖狗吠尧"],"usage":"作宾语、定语；比喻各为其主"},{"id":42514,"word":"跖狗吠尧","pinyin":"zhí gǒu fèi yáo","abbr":"zgfy","explanation":"比喻各为其主。","source":{"text":"跖之狗吠尧，非贵跖而贱尧也，狗固吠非其主也。","book":"西汉·刘向《战国策·齐策》"},"example":{"text":"且～，吠非其主。","book":"《新唐书·孙伏加传》"},"similar":["跖犬噬尧","各为其主"],"usage":"作宾语；比喻各为其主","story":["战国时期，齐国大臣田单不计较骂他的貂勃，备酒宴向貂勃请教错在哪里？貂勃回答说跖犬吠尧并不是尧不圣明而是各为其主。田单把他推荐给齐王，齐王派他出使楚国，引起齐王9个宠臣的不满而攻击田单，貂勃慷慨陈词救了相国田单"]},{"id":42515,"word":"跗萼联芳","pinyin":"fū è lián fāng","abbr":"felf","explanation":"比喻兄弟均贵显荣耀。","example":{"text":"他们兄弟在这个领域里大有名气，可谓～。"},"similar":["跗萼连晖"],"usage":"作谓语、定语；用于书面语"},{"id":42516,"word":"跗萼载韡","pinyin":"fū è zǎi wěi","abbr":"fezw","explanation":"比喻兄弟均贵显荣耀。","source":{"text":"言兄弟和睦实强盛而有光晖也……言兄弟相亲则致荣显也。","book":"《诗·小雅·常棣》：“常棣之华，鄂不韡韡。”郑玄笺：“鄂足得华之光明，则韡韡然盛兴者，喻弟以敬事兄，兄以荣覆弟，恩义之显亦韡韡然。”孔颖达疏"}},{"id":42517,"word":"跗萼连晖","pinyin":"fū è lián huī","abbr":"felh","explanation":"比喻兄弟均贵显荣耀。"},{"id":42518,"word":"跛行千里","pinyin":"bǒ xíng qiān lǐ","abbr":"bxql","explanation":"比喻只要努力不懈，即时条件很差，也能取得成就。","example":{"text":"天资较差的小张抱着～的精神学习，终于考上了大学。"}},{"id":42519,"word":"跛鳖千里","pinyin":"bǒ biē qiān lǐ","abbr":"bbql","explanation":"跛脚的鳖只要半步也不停留，也能走千里。比喻只要坚持不懈，即使条件很差，也能成功。","source":{"text":"故跬步不休，跛鳖千里。","book":"战国·赵·荀况《荀子·修身》"},"example":{"text":"络首縻足兮，骥不能逾跬；前无所阻兮，～。","book":"唐·刘禹锡《何卜赋》"},"usage":"作谓语、定语；指只要坚持不懈就能取得成就"},{"id":42520,"word":"距人千里","pinyin":"jù rén qiān lǐ","abbr":"jrql","explanation":"形容傲气极大，不愿与人接近或毫无商量的余地。距，通“拒”。","source":{"text":"訑訑之声音颜色距人于千里之外。","book":"语出《孟子·告子下》"},"example":{"text":"褒衣大袖，尧行舜趋，訑訑声颜，～。","book":"严复《救亡决论》"},"similar":["拒人千里"],"usage":"作谓语、定语；指人的态度","story":["战国时期，鲁平公准备任用孟子的学生乐正子主持国政，孟子喜出望外，公孙丑问孟子乐正子真的很有本事吗？孟子说他论本事、见闻与知识等都不如你，他的长处是对人很好，他不会拒人于千里之外，很多人聚集在他身边，能治理好国家"]},{"id":42521,"word":"距跃三百","pinyin":"jū yuè sān bǎi","abbr":"jysb","explanation":"指欢欣之极。","source":{"text":"《左传·僖公二十八年》：魏伤于胸。公欲杀之，而爱其材。使问，且视之。病，将杀之。魏束胸见使者，曰：‘以君之灵，不有宁也！’距跃三百，曲踊三百。乃舍之。”"},"example":{"text":"吾闻海上诸君子，发大愿合大力，既赓续此报，复求所以改良者，吾未尝不为之～，喜而不寐也。","book":"王某《论小说与改良社会之关系》"},"usage":"作谓语；指十分高兴"},{"id":42522,"word":"跟踪追击","pinyin":"gēn zōng zhuī jī","abbr":"gzzj","explanation":"指跟寻踪迹进行打击。","example":{"text":"我们～，一定能消灭他们。"},"usage":"作谓语；指跟寻踪迹进行打击"},{"id":42523,"word":"跣足科头","pinyin":"xiǎn zú kē tóu","abbr":"xzkt","explanation":"科头：不戴帽子；跣足：光脚。光着头赤着脚。","source":{"text":"彦章为人骁勇有力，能跣足履棘行百步。","book":"《史记·张仪列传》：“虎贲之士跿跔科头。”《新五代史·王彦章传》"},"example":{"text":"卢柟饮了数杯，又讨出大碗，一连吃上十数多碗，吃得性起，把巾服都脱去了，～，踞坐于椅上。","book":"明·冯梦龙《喻世明言》卷二十九"},"similar":["科头跣足","科头赤足"],"usage":"作谓语、定语；指形象不整"},{"id":42524,"word":"跨凤乘鸾","pinyin":"kuà fèng chéng luán","abbr":"kfcl","explanation":"凤：凤凰；鸾：传中凤凰一类的鸟。夫妻骑着凤，乘着鸾。比喻飞黄腾达，意得志满。","source":{"text":"暂时间且略别，三日后向城西传取长生块，管着你跨凤乘鸾。","book":"元·杨景贤《刘行首》第三折"},"example":{"text":"我如今博得个～客，到晚来卧看牵牛织女星。","book":"明·崔时佩《西厢记·东阁邀赏》"},"similar":["跨凤乘龙"],"usage":"作谓语；比喻飞黄腾达"},{"id":42525,"word":"跨凤乘龙","pinyin":"kuà fèng chéng lóng","abbr":"kfcl","explanation":"比喻结成夫妻或成仙。","source":{"text":"暂时间且略别，三日后向城西传取长生块，管着你跨凤乘鸾。","book":"元·杨景贤《刘行首》第三折"},"example":{"text":"喜融融，好似萧郎秦女，～。","book":"明·单本《蕉帕记·备聘》"},"similar":["跨凤乘鸾"],"usage":"作谓语；指结婚"},{"id":42526,"word":"跨山压海","pinyin":"kuà shān yā hǎi","abbr":"ksyh","explanation":"跨过高山，接近大海。喻势力扩展。","source":{"text":"党与既成，则连衡同恶，跨山压海，东逾梁宋，南穷高广。","book":"南唐·刘崇远《金华子杂编》卷下"},"usage":"作谓语、宾语；指扩大势力"},{"id":42527,"word":"跨州越郡","pinyin":"kuà zhōu yuè jùn","abbr":"kzyj","explanation":"跨越州郡。形容涉足的路远、地方大。","source":{"text":"体力克壮志方刚，跨州越郡还帝乡。","book":"晋·陆机《百年歌》之四"},"similar":["跨州连郡","夸州兼郡"],"usage":"作谓语、定语；用于地理方位等"},{"id":42528,"word":"跨州连郡","pinyin":"kuà zhōu lián jùn","abbr":"kzlj","explanation":"跨越州郡。形容涉足的路远、地方大。同“跨州越郡”。","source":{"text":"自董卓已来，豪杰并起，跨州连郡者不可胜数。。","book":"《三国志·蜀志·诸葛亮传》"},"example":{"text":"而山东、河南、河北到处土寇蜂起，小者占据山寨，大者～。","book":"姚雪垠《李自成》第二卷第二十九章"},"similar":["跨州越郡","夸州兼郡"],"usage":"作谓语、定语；用于地理方位等"},{"id":42529,"word":"跨者不行","pinyin":"kuà zhě bù xíng","abbr":"kzbx","explanation":"跨：跨步前进。跨步前进的人不能走长路。比喻急于求成的人，难以持之以恒。","source":{"text":"企者不立，跨者不行。","book":"春秋·楚·李耳《老子》第24章"},"usage":"作宾语、定语；用于劝诫人"},{"id":42530,"word":"跫响空谷","pinyin":"qióng xiǎng kōng gǔ","abbr":"qxkg","explanation":"空谷中的行人之声。常比喻难得的音信、言论等。","source":{"text":"夫逃虚空者，藜藋柱乎鼪鼬之径，踉位其空，闻人足音跫然而喜矣。","book":"战国·宋·庄周《庄子·徐无鬼》"},"example":{"text":"僻在林里，谈艺之侣，屦绝于户，独辽殿下，好名重士，时以文翰相与于～，遂忘其阒寂焉。","book":"明·张居正《序》"},"similar":["跫然足音"],"usage":"作宾语、定语；比喻难得的东西"},{"id":42531,"word":"跫然足音","pinyin":"qióng rán zú yīn","abbr":"qrzy","explanation":"跫：脚步声。原指长期住在荒凉寂寞的地方，对别人的突然来访感到欣悦。后常比喻难得的来客。","source":{"text":"夫逃虚空者，藜藋柱乎鼪鼬之径，踉位其空，闻人足音跫然而喜矣。","book":"《庄子·徐无鬼》"},"example":{"text":"忽闻空中有人言曰：“劳君枉驾，可谓～矣。”","book":"清·蒲松龄《聊斋志异·胡相公》"},"similar":["跫响足音"],"usage":"作宾语；比喻难得的东西"},{"id":42532,"word":"跬步不离","pinyin":"kuǐ bù bù lí","abbr":"kbbl","explanation":"跬步：半步，跨一脚。指半步也不离开。形容跟得紧或关系密切。","source":{"text":"因责子侍养跬步不离，僧无由至。","book":"《宋史·包恢传》"},"example":{"text":"三宝四宝又甚相爱，稍长即～，小家不知别嫌疑。","book":"清·纪昀《阅微草堂笔记·姑妄听之》"},"similar":["寸步不离"],"opposite":["若即若离"],"usage":"作谓语、定语；指紧密相连"},{"id":42533,"word":"跬步千里","pinyin":"kuǐ bù qiān lǐ","abbr":"kbql","explanation":"跬步：半步。走一千里路，是半步半步积累起来的。比喻学习应该持之有恒，不要半途而废。","source":{"text":"不积跬步，无以致千里；不积小流，无以成江海。","book":"《荀子·劝学》"},"example":{"text":"以尺寸水欲行数百斛舟，人牛力尽，～，虽监司使命，有数日不能出郭者。","book":"宋·苏轼《申三省起请开湖六条状》"},"usage":"作宾语、定语；指积少成多"},{"id":42534,"word":"路不拾遗","pinyin":"lù bù shí yí","abbr":"lbsy","explanation":"遗：失物。路上没有人把别人丢失的东西捡走。形容社会风气好。","source":{"text":"国无盗贼，道不拾遗。","book":"《韩非子·外储说左上》"},"example":{"text":"夜不闭户，～，四方瞻仰，称为西方圣人。","book":"明·许仲琳《封神演义》第十一回"},"similar":["夜不闭户","路无拾遗"],"opposite":["世风日下"],"usage":"作宾语、定语；形容社会风气好","story":["传说很久以前一个妇人把给母亲治病的钱装进包袱，急匆匆回娘家看望母亲。过武阳镇时稍微歇息，不小心将包袱留在路边。过了很久才想起自己的包袱掉了，急得直哭，人们告诉她武阳镇的人是路不拾遗的，她赶忙回去找到了她的包袱"]},{"id":42535,"word":"路人皆知","pinyin":"lù rén jiē zhī","abbr":"lrjz","explanation":"比喻人所共知的野心。","source":{"text":"司马昭之心，路人皆知。","book":"《三国志·魏书·高贵乡公传》注引《汉晋春秋》"},"example":{"text":"尾大末强，～，不敢声扬，公独奋笔。","book":"清·黄宗羲《御史余公墓志铭》"},"similar":["家喻户晓"],"usage":"作宾语、定语；比喻人所共知的野心","story":["三国时，魏文帝曹丕死后，由司马懿和曹爽辅佐曹睿执政。曹睿死，司马懿杀了曹爽，司马懿的儿子司马师立曹髦为皇帝。司马师的弟弟司马昭不把曹髦看在眼里，威胁要封晋公。曹髦气愤不过，说：“司马昭的心，路人所知也。”"]},{"id":42536,"word":"路人睚眦","pinyin":"lù rén yá zì","abbr":"lryz","explanation":"路人：过路的人；睚眦：怒目而视。连过路的人都怒目而视。形容使人非常愤恨。"},{"id":42537,"word":"路叟之忧","pinyin":"lù sǒu zhī yōu","abbr":"lszy","explanation":"指百姓的疾苦。","source":{"text":"汉·刘向《说苑·敬慎》：“孔子行游，中路闻哭者声，其音甚悲……见之，丘吾子也，拥镰带索而哭。孔子辟车而下问曰：‘夫子非有丧也，何哭之悲也？’丘吾子对曰：‘吾有三失。’孔子曰：‘原闻三失。’"},"example":{"text":"丘吾子曰：‘吾少好学问，周遍天下，还后，吾亲亡，一失也；事君奢骄，谏不遂，是二失也；厚交友而后绝，是三失也。树欲静乎风不定，子欲养乎亲不待。’”"}},{"id":42538,"word":"路在人走，事在人为","pinyin":"lù zài rén zou，shì zài rén wéi","abbr":"lzrzszrw","explanation":"路是人走出来的事情成功是人做出来的。指在一定条件下，事情的好或坏在于人的主观努力。"},{"id":42539,"word":"路断人稀","pinyin":"lù duàn rén xī","abbr":"ldrx","explanation":"路被隔断，行人稀少。形容某种灾害严重，以致路无行人。","source":{"text":"一向恁么去，路绝人稀。","book":"宋·释普济《五灯会元》卷十九"},"example":{"text":"譬之猛虎当道，吃的～，必有食肉寝皮之日。","book":"清·李绿园《歧路灯》第十回"},"similar":["路绝人稀"],"usage":"作定语、状语；指人迹罕至的地方"},{"id":42540,"word":"路无拾遗","pinyin":"lù wú shí yí","abbr":"lwsy","explanation":"指东西掉在路上，人们不会捡起据为己有。形容社会风尚好。","source":{"text":"孔子初仕为中都宰，中都鲁邑制为养生送死之节，长幼异食、如礼年五十异食也强弱异任、任谓力作之事各从所任不用弱也男女别涂、路无拾遗、器不雕伪，……","book":"《孔子家语·相鲁》"},"similar":["路不拾遗"],"usage":"作宾语、定语；形容社会风气好"},{"id":42541,"word":"路柳墙花","pinyin":"lù liǔ qiáng huā","abbr":"llqh","explanation":"路边的柳，墙旁的花。比喻不被尊重的女子，指妓女。","source":{"text":"从来道水性难拿，从他赸过，由他演撒，终只是个路柳墙花。","book":"元·王晔《水仙子·答》曲"},"example":{"text":"先生差矣，妾等乃巫山洛水之俦，非～之比。","book":"明·冯梦龙《警世通言》"},"similar":["墙花路柳"],"usage":"作宾语；比喻行为放荡的女子"},{"id":42542,"word":"路绝人稀","pinyin":"lù jué rén xī","abbr":"ljrx","explanation":"路被隔绝，行人稀少。形容某种灾害严重，以致路无行人。","source":{"text":"一向恁么去，路绝人稀。","book":"宋·释普济《五灯会元》卷十九"},"example":{"text":"眼见的～，不由俺唬的魄散魂飞。","book":"元·无名氏《盆儿鬼》第三折"},"similar":["路断人稀"],"usage":"作定语、状语；指人迹罕至的地方"},{"id":42543,"word":"路见不平","pinyin":"lù jiàn bù píng","abbr":"ljbp","explanation":"指见到不平的事。","source":{"text":"俺却路见不平，直送他到沧州，救了他一命。","book":"明·施耐庵《水浒传》第十七回"},"example":{"text":"他赶快转过口又说道：‘我不过～，说几句气话罢哩！’","book":"茅盾《霜叶红似二月花》十"},"usage":"作宾语；指见到不平的事"},{"id":42544,"word":"路见不平，拔刀相助","pinyin":"lù jiàn bù píng，bá dāo xiāng zhù","abbr":"ljbpbdxz","explanation":"在路上遇见欺负人的事情，就挺身而出帮助受害的一方。旧时为人们所称道的一种侠义行为。","source":{"text":"师曰：‘路见不平，所以按剑。’","book":"宋·释道元《景德传灯录》卷二十二"},"example":{"text":"这个是～，则是误伤人命。","book":"元·杨显之《酷寒亭》楔子"},"similar":["见义勇为","路见不平，拔刀相救"],"opposite":["冷眼旁观","袖手旁观","坐山观虎斗"],"usage":"作主语、谓语、分句；指见义勇为","story":["蒋门神依仗张团练的势力霸占施恩的酒店，施恩向武松报告此事，求武松去帮忙讨回酒店。武松一向是路见不平，拔刀相助，就随施恩一起去快活林，他的武功非同小可，把蒋门神收拾得服服贴贴，乖乖将酒店退回给施恩"]},{"id":42545,"word":"路见不平，拔刀相救","pinyin":"lù jiàn bù píng，bá dāo xiāng jiù","abbr":"ljbpbdxj","explanation":"在路上遇见不平的事，就挺身而出干涉，为受欺的一方打抱不平。形容人见义勇为。","source":{"text":"路见不平，拔刀相救。佛菩萨赏其义侠，故远导幻影以生之。","book":"清·宣鼎《夜雨秋灯录续集·金竹寺》"},"similar":["路见不平，拔剑相助"],"usage":"作主语、谓语、分句；指见义勇为"},{"id":42546,"word":"路见不平，拔剑相为","pinyin":"lù jiàn bù píng，bá jiàn xiāng wéi","abbr":"ljbpbjxw","explanation":"在路上遇见不平的事，就挺身而出干涉，为受欺的一方打抱不平。形容人见义勇为","source":{"text":"育王被人推倒了，也还有路见不平，拔剑相为底么。","book":"宋·释普济《五灯会元·天宁卓禅师法嗣》"},"similar":["路见不平，拔剑相助"],"usage":"作定语、宾语、分句；指见义勇为"},{"id":42547,"word":"路见不平，拔剑相助","pinyin":"lù jiàn bù píng，bá jiàn xiāng zhù","abbr":"ljbpbjxz","explanation":"在路上遇见不平的事，就挺身而出干涉，为受欺的一方打抱不平。形容人见义勇为。","source":{"text":"今见将军，乃是我恩人，却在此被劫，自当效力相助！路见不平，拔剑相助。","book":"明·洪楩《杨温拦路虎传》"},"example":{"text":"～，这是很正常的事。"},"similar":["路见不平，拔刀相助"],"usage":"作主语、谓语、分句；指见义勇为"},{"id":42548,"word":"路转峰回","pinyin":"lù zhuǎn fēng huí","abbr":"lzfh","explanation":"峰峦重叠环绕，山路蜿蜒曲折。形容山水名胜路径曲折复杂。","source":{"text":"峰回路转，有亭翼然临于泉上者，醉翁亭也。","book":"唐·陈子昂《入东阳峡与李明府舟前后不相及》：“风烟犹可望，歌笑浩难闻。路转青山合，峰回百日曛。”宋·欧阳修《醉翁亭记》"},"example":{"text":"～出画塘，一山枫叶背残阳，看来浑不似春光。","book":"王国维《浣溪沙》词"}},{"id":42549,"word":"路远迢迢","pinyin":"lù yuǎn tiáo tiáo","abbr":"lytt","explanation":"形容路途遥远。","source":{"text":"形容路途遥远。"},"similar":["千里迢迢"],"opposite":["近在咫尺"],"usage":"作状语；形容路途遥远"},{"id":42550,"word":"路逢窄道","pinyin":"lù féng zhǎi dào","abbr":"lfzd","explanation":"在很窄的路上相遇，没有地方可让。后多用来指仇人相见，彼此都不肯轻易放过。","source":{"text":"相逢狭路间，道隘不容车。","book":"汉·乐府诗《相逢行》"},"example":{"text":"我不曾惹你，你今来害我，则怕你～难回避。","book":"明·许仲琳《封神演义》第二十八回"}},{"id":42551,"word":"路遥知马力，事久见人心","pinyin":"lù yáo zhī mǎ lì，shì jiǔ jiàn rén xīn","abbr":"lyzmlsjjrx","explanation":"路途遥远，才可以知道马的力气的大小；经历的事情多了，时间长了，才可识别人心的善恶好歹。","source":{"text":"路遥知马力，事久见人心。","book":"宋·陈元靓《事林广记·结交警句》"},"example":{"text":"中国的成语说：～，我们的友谊是经得起时间考验的。","book":"周恩来《在缅甸总理吴努举行的国宴会上的讲话》"},"similar":["路遥知马力，日久见人心"],"usage":"作主语、宾语、分句；指时间可以检验一切"},{"id":42552,"word":"路遥知马力，日久见人心","pinyin":"lù yáo zhī mǎ lì，rì jiǔ jiàn rén xīn","abbr":"lyzmlrjjrx","explanation":"路途遥远才能知道马的力气大小，日子长了才能看出人心的好坏。","source":{"text":"路遥知马力，事久见人心。","book":"宋·陈元靓《事林广记》卷九"},"example":{"text":"但是“～”，在长期和残酷的战争中，游击战争将表现其很大的威力，实在是非同小可的事业。","book":"毛泽东《论持久战》"},"similar":["功到自然成"],"usage":"作主语、宾语；指时间可以检验一切","story":["浙江淳安县锦沙树徐家三兄弟，老三早亡留下妻子颜氏和五个小孩。老大、老二就三分家产，把老仆阿寄分给颜氏。阿寄决心做生意赚钱，一年下来，他赚了2000两金，颜氏用1500两金购良田与大宅。真是路遥知马力，日久见人心。颜氏将家产分给阿寄"]},{"id":42553,"word":"路长日暮","pinyin":"lù cháng rì mù","abbr":"lzrm","explanation":"路途遥远而天色已晚。比喻理想难以实现。","source":{"text":"我报路长嗟日暮，学诗漫有惊人句。","book":"宋·李清照《渔家傲》词"}},{"id":42554,"word":"跳丸日月","pinyin":"tiào wán rì yuè","abbr":"twry","explanation":"跳丸：跳动的弹丸。形容时间过得极快。","source":{"text":"一笑五云溪上舟，跳丸日月十经秋。","book":"唐·韩愈《秋怀》诗：“忧愁费晷景，日月如跳丸。”唐·杜牧《寄浙东韩乂评事》诗"},"example":{"text":"唐·杜牧《寄浙东韩八评事》诗：“一笑五云溪上舟，～十经秋。”"},"usage":"作宾语、定语；用于比喻句"},{"id":42555,"word":"跳出圈子","pinyin":"tiào chū quān zi","abbr":"tcqz","explanation":"比喻摆脱积久而形成的公式化的格式、体裁等。也比喻摆脱习惯势力、陈腐观念民加于人的无形枷锁。","source":{"text":"两个斗不到三合，李逵托地跳出圈子外来，转过身，望林子里便走。","book":"明·施耐庵《水浒全传》第六十一回"},"example":{"text":"兰生回头一看，史进乘空～，辖喇喇一马跑回本阵去了。","book":"清·俞万春《荡寇志》第一百二十七回"}},{"id":42556,"word":"跳到黄河也洗不清","pinyin":"tiào dào huáng hé yě xǐ bù qīng","abbr":"tdhhyxbq","explanation":"比喻无法摆脱嫌疑。","source":{"text":"真要是在这一夜里丢了东西，自己跳到黄河也洗不清。","book":"老舍《骆驼祥子》"}},{"id":42557,"word":"跳到黄河洗不清","pinyin":"tiào dào huáng hé xǐ bù qīng","abbr":"tdhhxbq","explanation":"比喻无法摆脱嫌疑。","source":{"text":"大约说破了嘴也没人信，跳在黄河里也洗不清。","book":"清·文康《儿女英雄传》第22回"},"example":{"text":"我真是～，再说也没用。"},"similar":["跳进黄河洗不清"],"usage":"作谓语、宾语；用于人的处境等"},{"id":42558,"word":"跳在黄河也洗不清","pinyin":"tiào zài huáng hé yě xǐ bù qīng","abbr":"tzhhyxbq","explanation":"比喻无法摆脱嫌疑。","source":{"text":"我何玉凤这个心迹，大约说破了嘴也没人信，跳在黄河也洗不清。","book":"清·文康《儿女英雄传》第22回"},"similar":["跳到黄河也洗不清"],"usage":"作谓语、宾语；用于人的处境等"},{"id":42559,"word":"跳在黄河洗不清","pinyin":"tiào zài huáng hé xǐ bù qīng","abbr":"tzhhxbq","explanation":"比喻很难摆脱干系，避免嫌疑。","source":{"text":"我何玉凤这个心迹，大约说破了嘴也没人信，跳在黄河也洗不清，可就完了我何玉凤的身分了！","book":"清·文康《儿女英雄传》第二十二回"},"example":{"text":"我真是～，再说也没用"},"similar":["跳到黄河也洗不清"],"usage":"作谓语、分句；指有口难辩"},{"id":42560,"word":"跳梁小丑","pinyin":"tiào liáng xiǎo chǒu","abbr":"tlxc","explanation":"跳梁：腾跃跳动；小丑：对人的卑称。比喻猖狂捣乱而成不了大气候的坏人。","source":{"text":"王犹不堪，况尔小丑乎？","book":"《庄子·逍遥游》：“子独不见狸牲乎，卑身而伏，以候敖者，东西跳梁，不辟高下。”《国语·周语上》"},"example":{"text":"这些～，真正是何足道哉！","book":"陈白尘、贾霁《宋景诗》第三章"},"similar":["害群之马","势利小人"],"opposite":["正人君子","志士仁人"],"usage":"作主语、宾语；指小人","story":["宋朝时期，户部副史张景宪为人正直，疾恶如仇，他不畏权势坚持将为非作歹的郑昉流放。元丰初年，他成为河阳地区最高长官。西南地区少数民族入侵，张景宪向皇帝进言：“那些骚扰边关的人都是些跳梁小丑，占据有利地形，易守难攻。”"]},{"id":42561,"word":"跳跃纸上","pinyin":"tiào yuè zhǐ shàng","abbr":"tyzs","explanation":"生动形象地呈现在纸上。形容文学作品叙述描写真实生动。","source":{"text":"如此体会，则诗神诗旨，跃然纸上。","book":"清·薛雪《一瓢诗话》卷三十三"},"similar":["跃然纸上","跃跃纸上"],"usage":"作谓语、定语；用于写作等"},{"id":42562,"word":"跳进黄河洗不清","pinyin":"tiào jìn huáng hé xǐ bù qīng","abbr":"tjhhxbq","explanation":"比喻很难摆脱干系，避免嫌疑。同“跳在黄河洗不清”。","source":{"text":"我不是担心他被留在贼营，倒是担心他带着李瞎子和你妹妹给我的两封书信，说不定还有什么贵重礼物，回来时被丁、杨二营的游骑抓去，使我跳进黄河洗不清，岂不受冤枉的窝囊气？","book":"姚雪垠《李自成》第三卷第四十二章"},"example":{"text":"我这下可是～，快帮我想办法吧"},"similar":["跳到黄河也洗不清"],"usage":"作谓语、分句；指有口难辩"},{"id":42563,"word":"践冰履炭","pinyin":"jiàn bīng lǚ tàn","abbr":"jblt","explanation":"踩冰踏炭。比喻历经各种艰险。","source":{"text":"今臣与陛下践冰履炭，登山浮涧，寒温燥湿，高下共之，岂得离陛下哉？","book":"《三国志·魏志·陈思王植传》"},"usage":"作谓语、宾语；指关系密切"},{"id":42564,"word":"践土食毛","pinyin":"jiàn tǔ shí máo","abbr":"jtsm","explanation":"指蒙受君恩；亦泛指起居生活。毛，泛指土地上生长的粮食蔬菜等植物。","source":{"text":"封略之内，何非君土？食土之毛，谁非君臣？","book":"语出《左传昭公七年》"},"example":{"text":"诸君～，义亦可死；但未食禄，亦可以无死。","book":"清梁章钜《归田琐记·黄忠端公》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":42565,"word":"践墨随敌","pinyin":"jiàn mò suí dí","abbr":"jmsd","explanation":"践：履行，实行；墨：绳墨，指计划；随：顺应。根据敌情的变化，来实施计划。","source":{"text":"践墨随敌，以决战争。","book":"《孙子·九地》"},"usage":"作宾语、定语；用于军事或处事"},{"id":42566,"word":"践律蹈礼","pinyin":"jiàn lǜ dǎo lǐ","abbr":"jldl","explanation":"指遵循礼法。","source":{"text":"以王践律蹈礼，轨物苍生。","book":"《北齐书·文宣帝纪》"},"similar":["遵纪守法"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42567,"word":"践规踏矩","pinyin":"jiàn gūi tà jǔ","abbr":"jgtj","explanation":"犹循规蹈矩。","source":{"text":"若金、许、薛、胡、陆稼书、张念芝之俦，伦乎其德则暗然，讽乎其言则犁然而当理，考乎其从游之徒，则践规踏矩，仪型乡国。","book":"清曾国藩《送唐先生南归序》"},"similar":["循规蹈矩"],"usage":"作谓语；指循规蹈矩"},{"id":42568,"word":"跷足抗手","pinyin":"qiāo zú kàng shǒu","abbr":"qzks","explanation":"手舞足蹈的样子。","source":{"text":"今天子基命宥密，孰与成王贤，其委任公不在周公下，薄海内外皆跷足抗手，歌颂盛德。","book":"明·张居正《门生为师相中玄高公六十寿序》"},"similar":["手舞足蹈"],"usage":"作谓语、定语、状语；用于书面语"},{"id":42569,"word":"跷足抗首","pinyin":"qiāo zú kàng shǒu","abbr":"qzks","explanation":"踮起脚跟，仰起头。形容热切期望的样子。","source":{"text":"自上仁所不化，茂德所不绥，莫不跷足抗首，请献厥珍。","book":"汉·扬雄《长杨赋》"},"usage":"作谓语、状语；用于期望"},{"id":42570,"word":"跷足而待","pinyin":"qiāo zú ér dài","abbr":"qzed","explanation":"踮起脚跟等待。形容短时间内便能见到事情的结果。","source":{"text":"则事可定，贼可死，功可跷足而待矣。","book":"三国·蜀·诸葛亮《劝将士勤功己阙教》"},"example":{"text":"我们～，即将有捷报传来。"},"similar":["翘首以待"],"usage":"作谓语；指预言不久将发生的事"},{"id":42571,"word":"跷蹊作怪","pinyin":"qiāo qī zuò guài","abbr":"qqzg","explanation":"跷蹊：奇怪，可疑。指怪异多变，","source":{"text":"不曾见这般跷蹊作怪的事，方才一个裹破头巾，身穿破布衫，手里拿着法环。","book":"明·罗贯中《三遂平妖传》第九回"},"example":{"text":"只因这封简帖儿，变出一本～底小说来。","book":"明·洪楩《清平山堂话本·简帖和尚》"},"usage":"作谓语、定语；用于稀奇的事物"},{"id":42572,"word":"跻峰造极","pinyin":"jī fēng zào jí","abbr":"jfzj","explanation":"指登上山峰绝顶。","source":{"text":"登龟、蒙、凫、绎峰者，即跻峰造极，龟、蒙、凫、绎已耳。","book":"明·胡应麟《诗薮外编·六朝》"},"similar":["登峰造极"],"usage":"作宾语、定语；指登上山峰绝顶"},{"id":42573,"word":"跼地籥天","pinyin":"jú dì yuè tiān","abbr":"jdyt","explanation":"指惶恐不安的样子。籥，古同“钥”，锁钥。"},{"id":42574,"word":"跼天促地","pinyin":"jú tiān cù dì","abbr":"jtcd","explanation":"指窘迫无路。"},{"id":42575,"word":"跼天蹐地","pinyin":"jú tiān jí dì","abbr":"jtjd","explanation":"跼：弯腰；蹐：前脚接后脚地小步走。天虽高，却不得不弯着腰；地虽厚，却不得不小步走。形容处境困窘，戒慎、恐惧之至。","source":{"text":"谓天盖高，不敢不局；谓地盖厚，不敢不蹐。","book":"《诗经·小雅·正月》"},"example":{"text":"～，若无所容。","book":"晋·陆机《谢平原内史表》"},"usage":"作谓语、定语；形容惶恐不安的样子"},{"id":42576,"word":"跼蹐不安","pinyin":"jú jí bù ān","abbr":"jjba","explanation":"形容恐惧不安。","source":{"text":"徐信闻言，甚跼蹐不安，将自己虞城失妻，到睢阳村店遇见此妇始末，细细述了。","book":"《京本通俗小说·冯玉梅团圆》"},"example":{"text":"华甫弄得～，只得拉了定辉去咬耳朵。","book":"清·李宝嘉《文明小史》第23回"},"similar":["局促不安"],"opposite":["神态自若"],"usage":"作谓语、定语、状语；指恐惧不安"},{"id":42577,"word":"跼高天，蹐厚地","pinyin":"jú gāo tiān，jí hòu dì","abbr":"jgtjhd","explanation":"本指蜷曲不敢伸展。后常指小心谨慎，惶惧不安。","source":{"text":"局本又作跼。","book":"语出《诗·小雅·正月》：“谓天盖高，不敢不局；谓地盖厚，不敢不蹐。”陆德明释文"},"example":{"text":"当君子困贱之时，～，犹恐有镇压之祸也。","book":"《后汉书·仲长统传》"}},{"id":42578,"word":"跼高蹐厚","pinyin":"jú gāo jí hòu","abbr":"jgjh","explanation":"本指蜷曲不敢伸展。后常指小心谨慎，惶惧不安。同“局高天，蹐厚地”。","source":{"text":"或倡高算而受晁错之祸，或竭心力而遭吴起之害；故有跼高蹐厚，犹不免焉。","book":"晋·葛洪《抱朴子·知止》"},"similar":["局高蹐厚"],"usage":"作宾语、定语；用于书面语"},{"id":42579,"word":"踉踉跄跄","pinyin":"liàng liàng qiàng qiàng","abbr":"llqq","explanation":"踉跄：走路不稳。走路歪歪斜斜的样子。","source":{"text":"头重脚轻，对明月眼红面赤；前合后仰，趁清风东倒西歪。踉踉跄跄上山来，似当风之鹤；摆摆摇摇回寺去，如出水之龟。","book":"明·施耐庵《水浒传》第四回"},"example":{"text":"你看他走路～的。"},"similar":["步履蹒跚"],"opposite":["健步如飞"],"usage":"作定语、状语；形容走路的样子"},{"id":42580,"word":"踊贵屦贱","pinyin":"yǒng guì jù jiàn","abbr":"ygjj","explanation":"踊：古代为受过刖刑的人制作的鞋；屦：用麻、草制成的鞋。受刖刑者穿的鞋价钱比普通人穿的鞋还要贵。比喻社会现象不正常。","source":{"text":"国之诸市，屦贱踊贵，民人痛疾。","book":"《左传·昭公三年》"},"example":{"text":"受刑者转广，而为非者日多，～，有鼻者丑也。","book":"《晋书·刑法志》"}},{"id":42581,"word":"踊跃争先","pinyin":"yǒng yuè zhēng xiān","abbr":"yyzx","explanation":"踊跃：欢欣奋起的样子。积极争着赶在前头，不甘落后。","source":{"text":"遇见善事，莫不踊跃争先，毫无小人习气，因而邻邦都以‘大人国’呼之。","book":"清·李汝珍《镜花缘》第14回"},"example":{"text":"这本来应该是士气昂扬、～的一个场面。","book":"高阳《胡雪岩全传·萧瑟洋场》"},"similar":["争先恐后","奋勇争先"],"opposite":["甘为人后"],"usage":"作谓语、定语、状语；用于处事"},{"id":42582,"word":"踊跃输将","pinyin":"yǒng yuè shū jiāng","abbr":"yysj","explanation":"输将：捐献，缴纳。群众纷纷捐献东西以表支持。","source":{"text":"文镜奏今年河南被水州县，收成虽不等，实未成灾，士民踊跃输将，特恩蠲免钱粮，请仍照额完兑。","book":"《清史稿·田文镜传》"},"example":{"text":"这本来应该是士气昂扬、～的一个场面。","book":"高阳《胡雪岩全传·萧瑟洋场》"}},{"id":42583,"word":"踌躇不决","pinyin":"chóu chú bù jué","abbr":"ccbj","explanation":"踌躇：犹豫，迟疑。形容犹犹疑疑地拿不定主意。","source":{"text":"四人争论未定，绍踌躇不决。","book":"明·罗贯中《三国演义》第二十二回"},"example":{"text":"景公口虽不唯唯，终以田陈同族为嫌，～。","book":"明·冯梦龙《东周列国志》第八十三回"},"similar":["犹豫不决","踌躇未决"],"opposite":["当机立断"],"usage":"作谓语、定语；指犹豫不决"},{"id":42584,"word":"踌躇不前","pinyin":"chóu chú bù qián","abbr":"ccbq","explanation":"踌躇：迟疑不决的样子。犹豫不决，不敢前进。","source":{"text":"哀裴回以踌躇。","book":"东汉·班固《汉书·孝武李夫人传》"},"example":{"text":"干事情不能～，坐失良机。"},"similar":["裹足不前","停滞不前"],"opposite":["当机立断","毅然决断"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":42585,"word":"踌躇不定","pinyin":"chóu chú bù dìng","abbr":"ccbd","explanation":"犹豫不决。","source":{"text":"操欲立后嗣，踌躇不定。","book":"明·罗贯中《三国演义》"},"similar":["犹豫不决"],"opposite":["斩钉截铁"],"usage":"作谓语、定语；指犹豫不决"},{"id":42586,"word":"踌躇未决","pinyin":"chóu chú wèi jué","abbr":"ccwj","explanation":"踌躇：犹豫，迟疑。形容犹犹疑疑地拿不定主意。","source":{"text":"但恐贵妃与虢国夫人不舍他，因此踌躇未决。","book":"清·褚人获《隋唐演义》第83回"},"example":{"text":"清·褚人获《隋唐演义》第83回：“但恐贵妃与虢国夫人不舍他，因此～。”"},"similar":["踌躇不决"],"opposite":["斩钉截铁"],"usage":"作谓语、定语、状语；指犹豫不决"},{"id":42587,"word":"踌躇满志","pinyin":"chóu chú mǎn zhì","abbr":"ccmz","explanation":"踌躇：从容自得的样子；满：满足；志：志愿。形容对自己取得的成就非常得意。","source":{"text":"提刀而立，为之四顾，为之踌躇满志。","book":"《庄子·养生主》"},"example":{"text":"这在胡景伊自然是～，而在尹昌衡则会义愤填膺了。","book":"郭沫若《少年时代·黑猫》"},"similar":["称心如意","心满意足"],"opposite":["垂头丧气","灰心丧气"],"usage":"作谓语、定语、状语；形容谋事成功得意的样","story":["战国时期，梁惠王问善于宰牛的厨师为什么他的一把刀能用二十年还跟新的一样，厨师说当年学宰牛时踌躇满志，不知如何下手，经过慢慢摸索逐渐了解了牛的身体结构，知道筋脉、肌肉等具体位置，将刀顺着骨缝插进去，用力不多而且不废刀"]},{"id":42588,"word":"踏床啮鼻","pinyin":"tà chuáng niè bí","abbr":"tcnb","explanation":"啮：咬。踏上床去咬自己的鼻子。形容强词夺理，力图狡辩。","source":{"text":"甲曰：‘他踏床子就啮之。","book":"《笑林》"},"usage":"作宾语、定语；指强词夺理","story":["甲与乙打架斗殴，甲咬下乙的鼻子，双方告到官府，官吏询问事情经过。甲说是乙自己咬下自己的鼻子的。官吏认为这是不可能的事情，问他是怎么咬掉自己的鼻子的，甲回答说乙站到床上去就能咬到自己的鼻子了"]},{"id":42589,"word":"踏故习常","pinyin":"tà gù xí cháng","abbr":"tgxc","explanation":"指因袭守旧，安于现状。","source":{"text":"而吾民族思想之固执，终以沿承因袭，踏故习常，不识不知，安之若命。","book":"李大钊《民彝与政治》"},"usage":"作谓语、宾语；用于处事"},{"id":42590,"word":"踏步不前","pinyin":"tà bù bù qián","abbr":"tbbq","explanation":"在原地踏步，没有前进。比喻事情没有进展。","example":{"text":"我们不能总是这样～。"},"similar":["原地踏步"],"opposite":["突飞猛进"],"usage":"作谓语、定语、宾语；指没有进展"},{"id":42591,"word":"踏破芒鞋没觅处，得来全不费工夫","pinyin":"tà pò máng xié méi mì chù，dé lái quán bù fèi gōng fū","abbr":"tpmxmmcdlqbfgf","explanation":"到处寻找都没找到，却由偶然的机会轻易得到了。","source":{"text":"往上一瞧，正是那日晚上地藏庵遇着的一群俊俏后生，心中欢喜不尽，暗说道：‘踏破芒鞋没觅处，得来全不费工夫。’","book":"清·李绿园《歧路灯》第18回"},"similar":["踏破铁鞋无觅处，得来全不费工夫"],"usage":"作宾语、定语、分句；用于口语"},{"id":42592,"word":"踏破铁鞋","pinyin":"tà pò tiě xié","abbr":"tptx","explanation":"比喻为找某种东西历尽困难，花费极大的力气。","source":{"text":"正是：踏破铁鞋无觅处，得来全不费工夫！","book":"明·冯梦龙《警世通言》"},"example":{"text":"各种工具书，宁可备而不用，比临时手忙脚乱、～，得不到恰当解决。","book":"曹靖华《飞花集·叹往昔·独木桥头徘徊无终期》"},"similar":["踏破铁鞋无觅处"],"usage":"作谓语、宾语；指花费极大的力气"},{"id":42593,"word":"踏破铁鞋无觅处","pinyin":"tà pò tiě xié wú mì chù","abbr":"tptxwmc","explanation":"觅：寻找。比喻急需的东西费了很大的力气找不到，却在无意中得到了。","source":{"text":"金满将大门闭了，两个促膝细谈。正是：踏破铁鞋无觅处，得来全不费工夫！","book":"明·冯梦龙《警世通言·金令史美婢酬秀童》"},"example":{"text":"恨小非君子，无毒不丈夫。正是：～。","book":"明·冯梦龙《警世通言》第28卷"},"similar":["踏破铁鞋无觅处，得来全不费工夫"],"usage":"作宾语、定语；常与“得来全不费工夫”连用"},{"id":42594,"word":"踏破铁鞋无觅处，得来全不费功夫","pinyin":"tà pò tiě xié wú mì chù，dé lái quán bù fèi gōng fù","abbr":"tptxwmcdlqbfgf","explanation":"比喻急需的东西费了很大的力气找不到，却在无意中得到了。","source":{"text":"金满将大门闭了，两个促膝细谈。正是：踏破铁鞋无觅处，得来全不费工夫！","book":"明·冯梦龙《警世通言·金令史美婢酬秀童》"}},{"id":42595,"word":"踏破铁鞋无觅处，得来全不费工夫","pinyin":"tà pò tiě xié wú mì chù，dé lái quán bù fèi gōng fù","abbr":"tptxwmcdlqbfgf","explanation":"比喻急需的东西费了很大的力气找不到，却在无意中得到了。","source":{"text":"金满将大门闭了，两个促膝细谈。正是：踏破铁鞋无觅处，得来全不费工夫！","book":"明·冯梦龙《警世通言·金令史美婢酬秀童》"},"example":{"text":"恨小非君子，无毒不丈夫。正是：～。","book":"明·冯梦龙《警世通言》卷二八"},"similar":["踏破芒鞋没觅处，得来全不费工夫"],"usage":"作宾语、定语、分句；用于口语"},{"id":42596,"word":"踏踏实实","pinyin":"tā tā shí shí","abbr":"ttss","explanation":"非常实际，一点也不浮躁。指不做出某种炫耀的显示的行为。","source":{"text":"这个问题不是说一句话就可以解决的，要做许多踏踏实实的工作。","book":"邓小平《关于国防工业企业的整顿》"},"example":{"text":"他办事一向都很～。"},"similar":["认认真真"],"opposite":["敷衍了事"],"usage":"作谓语、定语、状语；指很实际"},{"id":42597,"word":"踔厉奋发","pinyin":"chuō lì fèn fā","abbr":"clff","explanation":"形容精神振奋，斗志昂扬。","source":{"text":"其慷慨助饷，多为华侨；热心宣传，多为学界；冲锋破敌，则在军队与会党，踔厉奋发，各尽所能，有此成功。","book":"孙中山《中国革命史·革命之运动》"},"example":{"text":"华人因鉴于国家之危险，而～，一变其冷瘼罔觉之态度。","book":"《“五四”爱国运动资料·学界风潮·大陆报论对内尤急于对外》"},"similar":["踔厉风发","踔厉骏发"],"usage":"作谓语、定语；形容精神振作"},{"id":42598,"word":"踔厉风发","pinyin":"chuō lì fēng fā","abbr":"clff","explanation":"踔厉：精神振奋，言论纵横；风发：象刮风一样迅猛。形容精神振作，意气奋发。","source":{"text":"议论证据今古，出入经史百子，中踔厉风发，常率屈其座人。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"逐渐的做一点，总不肯休，不至于比“～”无效的。","book":"鲁迅《两地书·一二》"},"similar":["踔厉奋发"],"usage":"作谓语、定语；形容精神振作，意气奋发"},{"id":42599,"word":"踔厉骏发","pinyin":"chuō lì jùn fā","abbr":"cljf","explanation":"形容雄辩恣肆；议论纵横。","source":{"text":"试读其所与国王书，后先援据故事，踔厉骏发，烂然明析。","book":"清·汪琬《序》"},"similar":["踔厉奋发"],"usage":"作谓语、定语；形容口才好"},{"id":42600,"word":"踔绝之能","pinyin":"chuō jué zhī néng","abbr":"cjzn","explanation":"踔绝：高超。高超的本领、才能。","source":{"text":"非有踔绝之能，不相逾越。","book":"《汉书·孔光传》"},"usage":"作主语、宾语；指人的才能"},{"id":42601,"word":"踞炉炭上","pinyin":"jù lú tàn shàng","abbr":"jlts","explanation":"踞：蹲、坐。蹲在炉子的炭火之上。形容处境险恶，不堪忍受。","source":{"text":"军还，权遣使乞降，上表称臣，陈说天命。魏武帝曰：‘此儿欲踞吾著炉炭上邪！’","book":"《晋书·宣帝纪》"},"usage":"作宾语、定语；用于人的处境等"},{"id":42602,"word":"踞虎盘龙","pinyin":"jù hǔ pán lóng","abbr":"jhpl","explanation":"形容地势雄伟壮丽。","source":{"text":"三尺台包藏着屯莺聚燕闲人窟，十字街控带着踞虎盘龙旧帝基。","book":"元·汤式《哨遍·新建构栏教坊求赞》"},"similar":["龙蟠虎踞"],"usage":"作宾语、定语；指地势等"},{"id":42603,"word":"踟蹰不前","pinyin":"chí chú bù qián","abbr":"ccbq","explanation":"迟疑不决，不敢前进。","source":{"text":"使君从南业，五马立踟蹰。","book":"宋·郭茂倩《乐府诗集·陌上桑古辞》"}},{"id":42604,"word":"踟躇不前","pinyin":"chí chú bù qián","abbr":"ccbq","explanation":"迟疑不决，不敢前进","source":{"text":"使君从南业，五马立踟蹰。","book":"南宋·郭茂倩《乐府诗集·陌上桑古辞》"},"similar":["徘徊不前"],"usage":"作谓语、状语；用于处事"},{"id":42605,"word":"踢天弄井","pinyin":"tī tiān nòng jǐng","abbr":"ttnj","explanation":"能上天，能入地。比喻本领极大。也形容顽皮到极点。。","source":{"text":"你道有左慈术踢天弄井，项羽力拔山也那举鼎。","book":"元·秦简夫《东堂老》第二折"},"example":{"text":"咱们城里的孩子，个个～，鬼聪明倒是有的。","book":"清·曹雪芹《红楼梦》第81回"},"similar":["上天入地"],"usage":"作谓语、定语；用于小孩"},{"id":42606,"word":"踢断门槛","pinyin":"tī duàn mén kǎn","abbr":"tdmk","explanation":"由于跑得太勤、太快，把人家的门槛都踢断。讽刺那些溜须拍马的走狗们。","example":{"text":"邀请外出传经送宝的人都快～了。"},"usage":"作谓语；有讽刺意"},{"id":42607,"word":"踣不复振","pinyin":"bó bù fù zhèn","abbr":"bbfz","explanation":"振：振作。一跌倒就再也爬不起来。比喻遭受一次挫折以后就再也振作不起来。","source":{"text":"一噎之故，绝谷不食，一蹶之故，却足不行。","book":"汉·刘向《说苑·谈丛》"}},{"id":42608,"word":"踣地呼天","pinyin":"bó dì hū tiān","abbr":"bdht","explanation":"犹言呼天抢地。形容极度悲伤。","source":{"text":"[童子]踣地呼天，声竭泣血，观者如堵，无不陨涕。","book":"清·周亮工《书影》卷四"},"similar":["呼天抢地"],"opposite":["欢天喜地"],"usage":"作谓语、状语；指人很悲伤"},{"id":42609,"word":"踧踖不安","pinyin":"cù jí bù ān","abbr":"cjba","explanation":"恭敬而不安。意谓恭敬而不自然的样子。","source":{"text":"宝玉因贾政在坐，早已踧踖不安。","book":"清·曹雪芹《红楼梦》第七十五回"},"example":{"text":"烁烁的灯光迫得我们皱起了眉头，我们的风尘色全给它托出来了，这使我～了。","book":"朱自清《桨声灯影里的秦淮河》"},"similar":["坐立不安","忐忑不安"],"opposite":["处之泰然","怡然自得","等闲视之"],"usage":"作谓语、定语；形容坐立不安"},{"id":42610,"word":"踨地籥天","pinyin":"jú dì yuè tiān","abbr":"jdyt","explanation":"指惶恐不安的样子。籥，古同钥”，锁钥。"},{"id":42611,"word":"踨天促地","pinyin":"jú tiān cù dì","abbr":"jtcd","explanation":"指窘迫无路。"},{"id":42612,"word":"踨天蹐地","pinyin":"jú tiān jí dì","abbr":"jtjd","explanation":"踨弯腰；蹐前脚接后脚地小步走。天虽高，却不得不弯着腰；地虽厚，却不得不小步走。形容处境困窘，戒慎、恐惧之至。","source":{"text":"谓天盖高，不敢不局；谓地盖厚，不敢不蹐。","book":"《诗经·小雅·正月》"},"quote":{"text":"～，若无所容。","book":"晋·陆机《谢平原内史表》"}},{"id":42613,"word":"踨蹐不安","pinyin":"jú jí bù ān","abbr":"jjba","explanation":"形容恐惧不安。","source":{"text":"徐信闻言，甚踨蹐不安，将自己虞城失妻，到睢阳村店遇见此妇始末，细细述了。","book":"《京本通俗小说·冯玉梅团圆》"},"quote":{"text":"华甫弄得～，只得拉了定辉去咬耳朵。","book":"清·李宝嘉《文明小史》第23回"}},{"id":42614,"word":"踨高天，蹐厚地","pinyin":"jú gāo tiān，jí hòu dì","abbr":"jgthd","explanation":"本指蜷曲不敢伸展◇常指小心谨慎，惶惧不安。","source":{"text":"谓天盖高，不敢不局；谓地盖厚，不敢不蹐。陆德明释文局本又作踨。","book":"语出《诗·小雅·正月》"},"quote":{"text":"当君子困贱之时，～，犹恐有镇压之祸也。","book":"《后汉书·仲长统传》"}},{"id":42615,"word":"踨高蹐厚","pinyin":"jú gāo jí hòu","abbr":"jgjh","explanation":"本指蜷曲不敢伸展◇常指小心谨慎，惶惧不安。同局高天，蹐厚地”。"},{"id":42616,"word":"踪迹诡秘","pinyin":"zōng jì guǐ mì","abbr":"zjgm","explanation":"行踪隐秘难测。","source":{"text":"率轻狂而自若，踪迹诡秘，贿赂公行。","book":"《剪灯余话·泰山御史传》"},"example":{"text":"他～，很难找到的。"},"similar":["行踪不定"],"usage":"作谓语、定语；指行踪不定"},{"id":42617,"word":"踵事增华","pinyin":"zhǒng shì zēng huá","abbr":"zszh","explanation":"踵：追随，继续。继续前人的事业，并使更加完善美好。","source":{"text":"盖踵其事而增华，变其本而加厉。物既有之，文亦宜然。","book":"南朝梁·萧统《文选序》"},"example":{"text":"以至头门墙上及各墙壁，另行雕刻花草人物，正是～，穷奢极侈。","book":"清·黄小配《廿载繁华梦》第二十七回"},"usage":"作谓语、宾语；指发扬前人事业"},{"id":42618,"word":"踵决肘见","pinyin":"zhǒng jué zhǒu jiàn","abbr":"zjzj","explanation":"踵：脚后跟，伢指鞋后跟；决：裂开。整一整衣襟，胳臂肘露了出来，拔一拔鞋，脚后跟露了出来。形容非常贫穷。","source":{"text":"三日不举火，十年不制衣，正冠而缨绝，捉衿而肘见，纳屦而踵决。","book":"《庄子·让王》"},"similar":["捉襟见肘"],"usage":"作谓语、定语；指非常贫穷"},{"id":42619,"word":"踵接肩摩","pinyin":"zhǒng jiē jiān mó","abbr":"zjjm","explanation":"摩肩接踵。肩挨肩，脚碰脚。形容人多，拥挤不堪。","source":{"text":"忽金鼓喧阗，仪卫甚盛，观者踵接肩摩。","book":"清·金捧阊《守一斋笔记·芦花会》"},"similar":["摩肩接踵","肩摩踵接"],"usage":"作谓语、定语、状语；用于人多时"},{"id":42620,"word":"踵武前贤","pinyin":"zhǒng wǔ qián xián","abbr":"zwqx","explanation":"踵：脚跟。武：足迹。跟随着前人的脚步走。比喻效法前人。","source":{"text":"忽奔走以先后兮，及前王之踵武。","book":"战国·楚·屈原《离骚》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":42621,"word":"踵武相接","pinyin":"zhǒng wǔ xiāng jiē","abbr":"zwxj","explanation":"谓脚迹相连。形容人数众多，接连不断。同“踵趾相接”。","source":{"text":"诸公巨人踵武相接，天下毫发丝粟之才，皆得以牵连成就，况且伯强之卓然能自见者乎！","book":"宋·陈亮《跋焦伯强帖》"},"usage":"作谓语、定语；用于书面语"},{"id":42622,"word":"踵足相接","pinyin":"zhǒng zú xiāng jiē","abbr":"zzxj","explanation":"谓脚迹相连。形容人数众多，接连不断。同“踵趾相接”。","source":{"text":"今之士大夫，冠缨相摩，踵足相接，一时号为交游者，盖不少矣。","book":"明·张居正《答列卿毛介川书》"},"similar":["踵迹相接","踵趾相接"],"usage":"作谓语、定语；指人多"},{"id":42623,"word":"踵趾相接","pinyin":"zhǒng zhǐ xiāng jiē","abbr":"zzxj","explanation":"谓脚迹相连。形容人数众多，接连不断。","source":{"text":"黄遵宪盛赞他们‘前仆后起，踵趾相接，视死如归’的大无畏精神。","book":"杨天石《黄遵宪》"},"example":{"text":"缅想当年景象：那种～的商旅队，商旅队中各种语言的交响。","book":"韩北屏《非洲夜会·橘林茶香》"},"similar":["踵迹相接","踵足相接"],"usage":"作谓语、定语；指人多"},{"id":42624,"word":"踵迹相接","pinyin":"zhǒng jì xiāng jiē","abbr":"zjxj","explanation":"谓脚迹相连。形容人数众多，接连不断。同“踵趾相接”。","source":{"text":"自丛岚叠嶂间以刀掘路，士卒各怀一铁钉，踵迹相接，攀钉而上。","book":"清·昭梿《啸亭杂录·梁提督》"},"similar":["踵趾相接"],"usage":"作谓语、定语；指人多"},{"id":42625,"word":"踽踽凉凉","pinyin":"jǔ jǔ liáng liáng","abbr":"jjll","explanation":"踽踽：孤独的样子；凉凉：冷冷清清的样子。形容孤傲寡合。","source":{"text":"行何为踽踽凉凉？生斯世也，为斯世也，善斯可矣。","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"当田畴～从她面前走过的时候，她还充满恨意的叹口气，回避开脸。","book":"沙汀《困兽记》"},"usage":"作谓语、宾语、状语；用于孤独的状态"},{"id":42626,"word":"踽踽独行","pinyin":"jǔ jǔ dú xíng","abbr":"jjdx","explanation":"踽踽：孤零的样子。孤零零地独自走着。形容非常孤独。","source":{"text":"独行踽踽，岂无他人，不如我同父。","book":"《诗经·唐风·杕杜》"},"example":{"text":"他成了一个～，形单影只，自言自语，孤苦伶仃的畸形人。长空里，一只孤雁。","book":"徐迟《歌德巴赫猜想》"},"similar":["举目无亲","孑然一身"],"opposite":["成群结队"],"usage":"作谓语、宾语、状语；指人独自走路"},{"id":42627,"word":"蹀躞不下","pinyin":"dié xiè bù xià","abbr":"dxbx","explanation":"指心里忐忑不安，不能放心。","source":{"text":"这女儿自因阿巧死后，心中好生不快活。自思量道：‘皆由我之过，送了他青春一命。’日逐蹀躞不下。","book":"《警世通言·蒋淑真刎颈鸳鸯会》"},"example":{"text":"当时恰有两个同与李吉到海宁郡来做买卖的客人，～。","book":"《古今小说·沈小官一鸟害七命》"},"similar":["忐忑不安"],"usage":"作谓语；用于人的心情"},{"id":42628,"word":"蹄閒三寻","pinyin":"tí jiàn sān xún","abbr":"tjsx","explanation":"指马奔走时，前后蹄间一跃而过三寻。形容马奔跑得快。同“蹄间三寻”。"},{"id":42629,"word":"蹄闲三寻","pinyin":"tí xián sān xún","abbr":"txsx","explanation":"指马奔走时，前后蹄间一跃而过三寻。形容马奔跑得快。同“蹄间三寻”。"},{"id":42630,"word":"蹄间三寻","pinyin":"tí jìan sān xún","abbr":"tjsx","explanation":"指马奔走时，前后蹄间一跃而过三寻。形容马奔跑得快。","source":{"text":"秦马之良，戎兵之众，探前趹后，蹄间三寻者，不可称数也。","book":"《战国策·韩策一》"},"example":{"text":"七尺曰寻。言马走之疾，前后蹄间一掷过三寻也。","book":"《史记·张仪列传》引此文，司马贞索隐"},"usage":"作谓语、定语；形容马跑得快"},{"id":42631,"word":"蹇之匪躬","pinyin":"jiǎn zhī fěi gōng","abbr":"jzfg","explanation":"指为君国而忠直谏诤。同“蹇蹇匪躬”。","source":{"text":"客有唁予者曰：‘《蹇》之六二曰：王臣蹇蹇，匪躬之故。安知上不以蹇之匪躬勖子乎？’","book":"清·钱谦益《匪斋记》"},"similar":["蹇蹇匪躬"],"usage":"作谓语、定语；用于书面语"},{"id":42632,"word":"蹇人上天","pinyin":"jiǎn rén shàng tiān","abbr":"jrst","explanation":"比喻不可能之事。亦作“蹇人升天”。","source":{"text":"王莽末，天水童谣曰：‘出吴门，望缇群。见一蹇人，言欲上天；令天可上，地上安得民！’时隗初起兵于天水，后意稍广，欲为天子，遂破灭。器少病蹇。","book":"典出《后汉书·五行志一》"},"example":{"text":"始安欲为赵伦，形迹已见，～，信无此理。","book":"《梁书·武帝纪上》"},"similar":["蹇人升天"],"usage":"作宾语、定语；用于比喻句","story":["王莽末年，天下大乱，隗嚣少年时生病脚跛，他的野心不小，在天水起兵反王莽，后来屯据陕甘一带，他想称帝，被东汉光武帝刘秀率军歼灭。在他称帝前，天水一带流传童谣：“出吴门，望缇群。见一蹇人，言欲上天；令天可上，地上安得民！”"]},{"id":42633,"word":"蹇人升天","pinyin":"jiǎn rén shēng tiān","abbr":"jrst","explanation":"比喻不可能之事。同“蹇人上天”。","source":{"text":"我为拯救生灵，不惜这条老命，卖油翁，岂学蹇人升天而贪荣利者乎？","book":"清·蒋士铨《临川梦·遣跛》"},"similar":["蹇人上天"],"usage":"作宾语、定语；用于比喻句"},{"id":42634,"word":"蹇视高步","pinyin":"jiǎn shì gāo bù","abbr":"jsgb","explanation":"犹言昂首阔步。","source":{"text":"夫中国之立于亚洲也，文明先进，四邻莫之与伦，蹇视高步，因益为特别之发达；及今日虽凋苓，而犹与西欧对立，此其幸也。","book":"鲁迅《坟·摩罗诗力说》"},"similar":["昂首阔步"],"usage":"作谓语、定语；指昂首阔步"},{"id":42635,"word":"蹇谔之风","pinyin":"jiǎn è zhī fēng","abbr":"jezf","explanation":"正直敢言的作风。","source":{"text":"矫然太当，尽其蹇谔之风。","book":"晋·陈寿《三国志·蜀志·庞统传》裴松之注引《习凿齿》"},"example":{"text":"爱在中兴，玄风滋扇，溺王纲于拱默，挠国步于清虚，骨鲠～盖亦维矣。","book":"《晋书·王雅传论》"},"similar":["謇谔之风"],"usage":"作主语、宾语；指敢直言的风气"},{"id":42636,"word":"蹇谔匪躬","pinyin":"jiǎn è fěi gōng","abbr":"jefg","explanation":"指为君国而忠直谏诤。同“蹇蹇匪躬”。","source":{"text":"张九龄在相位，有蹇谔匪躬之诚，元宗既在位年深，稍怠庶政，每见帝无不极言得失。","book":"唐·郑处诲《明皇杂录》"},"similar":["蹇蹇匪躬"],"usage":"作谓语、定语；用于敢说话的人"},{"id":42637,"word":"蹇蹇匪躬","pinyin":"jiǎn jiǎn fěi gōng","abbr":"jjfg","explanation":"蹇，通“謇”。指为君国而忠直谏诤。亦作“蹇谔匪躬”。","source":{"text":"六二，王臣蹇蹇，匪躬之故。","book":"《易·蹇》"},"example":{"text":"违令犯颜，～者，安上之民翰也。","book":"晋葛洪《抱朴子·臣节》"},"similar":["蹇谔匪躬","蹇之匪躬"],"usage":"作谓语、定语；用于敢说话的人"},{"id":42638,"word":"蹈人旧辙","pinyin":"dǎo rén jiù zhé","abbr":"drjz","explanation":"辙：车迹，指道路。走别人走过的路。指因循旧说，无主见地人云亦云。","source":{"text":"秉笔之士所用故实，有淹贯所不究者，有蹈前人旧辙而不讨论所从来者，譬侏儒观戏，人笑亦笑。","book":"宋·朱弁《曲洧旧闻》第七卷"},"example":{"text":"～的人是蠢蛋。"},"similar":["重蹈覆辙"],"usage":"作谓语、宾语；同“重蹈覆辙”"},{"id":42639,"word":"蹈仁履义","pinyin":"dǎo rén lǚ yì","abbr":"drly","explanation":"遵循仁义之道。","source":{"text":"论安老爷这个人蹈仁履义，折矩周规，不得不谓之醇儒。","book":"《儿女英雄传》第三六回"},"usage":"作谓语、定语；用于处世"},{"id":42640,"word":"蹈其覆辙","pinyin":"dǎo qì fù zhé","abbr":"dqfz","explanation":"蹈：踩；覆：颠倒；辙：车迹，指道路。重走别人翻车的路。比喻不接受教训，重犯别人犯过的错误。","source":{"text":"前车覆，后车诫。","book":"《汉书·贾谊传》"},"example":{"text":"实因鉴于自己看了翻版之《芥子园》而恨及创始之王氏兄弟，不俗自～也。","book":"鲁迅《书信·致郑正铎》"},"similar":["重蹈覆辙"],"usage":"作谓语、宾语；指犯同样的错误"},{"id":42641,"word":"蹈刃不旋","pinyin":"dǎo rèn bù xuán","abbr":"drbx","explanation":"蹈：踩；刃：刀刃；旋：回旋。面临危险而不返回。","source":{"text":"故民见进而不见退，蹈白刃而不旋踵。","book":"《孙膑兵法·善者》"},"usage":"作谓语、定语；用于处事"},{"id":42642,"word":"蹈厉之志","pinyin":"dǎo lì zhī zhì","abbr":"dlzz","explanation":"蹈厉：踏地猛烈。本形容舞蹈的动作威武有力。比喻奋发向上的志向。","source":{"text":"发扬蹈厉之志，以成从简尚功之俗。","book":"明·刘基《齐侯袭莒》"},"example":{"text":"他从小就有～。"},"usage":"作宾语；指人的志向"},{"id":42643,"word":"蹈厉发扬","pinyin":"dǎo lì fā yáng","abbr":"dlfy","explanation":"蹈厉：踏地猛厉；发扬：奋发。比喻奋勇直前。","source":{"text":"发扬蹈厉，大公之志也。","book":"西汉·戴圣《礼记·乐记》"},"example":{"text":"梅圣俞，苏子美起而矫之，尽翻科臼，～，才力体制，非不高于前人。","book":"清·沈德潜《说诗晬语》下卷"},"similar":["蹈厉奋发"],"usage":"作谓语；指人的行动"},{"id":42644,"word":"蹈厉奋发","pinyin":"dǎo lì fèn fā","abbr":"dlff","explanation":"蹈：踩，引伸为做，实行；厉：猛烈，迅疾；奋：振作；发：激励。精神振奋，行动迅猛。","source":{"text":"吾父老子弟，尤当蹈厉奋发，为民前躯。","book":"蔡东藩《民国通俗演义》第159回"},"example":{"text":"我们要～，刻苦学习。"},"similar":["蹈厉发扬"],"usage":"作谓语；指人的行动"},{"id":42645,"word":"蹈常习故","pinyin":"dǎo cháng xí gù","abbr":"dcxg","explanation":"指按照老规矩和老办法办事。","source":{"text":"后之君子，蹈常而习故，惴惴焉惧不免于天下。","book":"宋·苏轼《伊尹论》"},"example":{"text":"而旧有的文学则～，始终不脱古人的窠臼。","book":"郭绍虞《中国文学批评史》二"},"similar":["蹈常袭故","蹈故习常"],"usage":"作谓语、宾语、定语；指守旧"},{"id":42646,"word":"蹈常袭故","pinyin":"dǎo cháng xí gù","abbr":"dcxg","explanation":"蹈：踩，引伸为遵循；常：常规，老规矩；袭：沿袭；故：老办法。因循守旧，照老规矩办事。","source":{"text":"学者蹈常袭故，漫不复有所寻者。","book":"明·焦竑《焦氏笔乘·叙录》"},"example":{"text":"即唐诗亦非无～，充其肤廓，而神理蔑如者。","book":"清·黄宗羲《张心友诗序》"},"similar":["墨守成规","因循守旧","故步自封"],"opposite":["除旧布新","革故鼎新","独辟蹊径"],"usage":"作谓语、宾语、定语；指守旧"},{"id":42647,"word":"蹈故习常","pinyin":"dǎo gù xí cháng","abbr":"dgxc","explanation":"指按照老规矩和老办法办事。同“蹈常习故”。","source":{"text":"生死存亡，近在眉睫，岂可蹈故习常，依违容忍？","book":"蔡东藩、许廑父《民国通俗演义》第一○八回"},"similar":["蹈常习故"],"usage":"作谓语、宾语、定语；指守旧"},{"id":42648,"word":"蹈机握杼","pinyin":"dǎo jī wò zhù","abbr":"djwz","explanation":"脚踩布机，手握筘梭。比喻掌握着事物发展变化的枢键。","source":{"text":"位也者，立德之机也；势也者，行义之杼也。圣人蹈机握杼，织成天地之化，使万物顺焉。","book":"汉·徐幹《中论·爵禄》"},"usage":"作谓语、定语；用于处事"},{"id":42649,"word":"蹈汤赴火","pinyin":"dǎo tāng fù huǒ","abbr":"dtfh","explanation":"比喻不避艰险。","source":{"text":"且须散金帛，犒师旅，使闻鼓而蹈汤赴火，闻金而星布云合。","book":"唐·赵元一《奉天录》卷三"},"example":{"text":"他张迪，官家的这条忠实走狗，～，也要去竭力办到。","book":"徐兴业《金瓯缺》第一部第三章"},"similar":["蹈赴汤火","蹈火赴汤"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42650,"word":"蹈火探汤","pinyin":"dǎo huǒ tàn tāng","abbr":"dhtt","explanation":"比喻不避艰险。同“蹈汤赴火”。"},{"id":42651,"word":"蹈火赴汤","pinyin":"dǎo huǒ fù tāng","abbr":"dhft","explanation":"比喻不避艰险。","source":{"text":"五里远的山路，真正似蹈火赴汤。","book":"李瑛《深夜里发生的故事》诗"},"similar":["蹈赴汤火"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42652,"word":"蹈矩循彟","pinyin":"dǎo jǔ xún yuē","abbr":"djxy","explanation":"指遵守规矩。同“蹈矩循规”。","source":{"text":"七岁即就外傅，诸书经目辄成诵，出入蹈矩循彟，有若成人。","book":"明·宋濂《佛慧圆明无边广照普利大禅师塔铭》"},"similar":["蹈矩循规","蹈规循矩"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42653,"word":"蹈矩循规","pinyin":"dǎo jǔ xún guī","abbr":"djxg","explanation":"指遵守规矩。","source":{"text":"积善存仁，蹈矩循规太古民。","book":"明·沈受先《三元记·格天》"},"similar":["蹈规循矩"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42654,"word":"蹈矩践墨","pinyin":"dǎo jǔ jiàn mò","abbr":"djjm","explanation":"指遵守规矩。同“蹈矩循规”。","source":{"text":"其如某最迂阔樗散，徒有蹈矩践墨之小节，本无经时理物之长才。","book":"明·唐顺之《与严介溪相公书》"},"similar":["蹈矩循规","蹈规循矩"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42655,"word":"蹈节死义","pinyin":"dǎo jié sǐ yì","abbr":"djsy","explanation":"蹈：履行，实行。坚守节操，以身殉义。","source":{"text":"惟有蹈节死义，以雪天下之耻，庶赎斧钺之诛。","book":"《晋书·元帝纪》"},"usage":"作谓语、定语；指有节操"},{"id":42656,"word":"蹈袭前人","pinyin":"dǎo xí qián rén","abbr":"dxqr","explanation":"蹈袭：因袭，沿用。因袭前人，缺乏创新。","source":{"text":"芾为文奇险，不蹈袭前人轨辙。","book":"《宋史·米芾传》"},"example":{"text":"作诗极刻苦，喜出奇语，不～。","book":"《金史·李经传》"},"similar":["因循守旧","袭蹈前人"],"opposite":["革故鼎新","推陈出新"],"usage":"作谓语、定语；指作品等"},{"id":42657,"word":"蹈袭覆辙","pinyin":"dǎo xí fù zhé","abbr":"dxfz","explanation":"重新走上翻过车的老路。比喻不吸取教训，再走失败的老路。","source":{"text":"芾为文奇险，不蹈袭前人轧辙。","book":"《宋史·米芾传》"}},{"id":42658,"word":"蹈规循矩","pinyin":"dǎo guī xún jǔ","abbr":"dgxj","explanation":"指遵守规矩。同“蹈矩循规”。","source":{"text":"空穷读数行书，蹈规循矩没是非。","book":"明·徐霖《绣襦记·伪儒乐聘》"},"similar":["蹈矩循规","循规蹈矩","循规矩蹈"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42659,"word":"蹈赴汤火","pinyin":"dǎo fù tāng huǒ","abbr":"dfth","explanation":"比喻不避艰险。同“蹈汤赴火”。","source":{"text":"君子杀身以成仁，殉其毅烈，蹈赴汤火，旁雪不平，乃宝之志也。","book":"唐·孙揆《灵应传》"},"example":{"text":"犬马之报，惟力是视，虽～所不辞。","book":"清·王韬《代上广府冯太守书》"},"similar":["蹈汤赴火"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42660,"word":"蹈锋饮血","pinyin":"dǎo fēng yǐn xuè","abbr":"dfyx","explanation":"形容勇敢，不怕牺牲。","source":{"text":"公骤起乡闾，捐家室，誓徒旅，蹈锋饮血，其军最为雄健矣。","book":"清·吴敏树《唐子方方伯梦砚斋铭》"},"usage":"作谓语、定语；指人很勇敢"},{"id":42661,"word":"蹉跎仕路","pinyin":"cuō tuó shì lù","abbr":"ctsl","explanation":"蹉跎：时间白白过去。指仕途不得志。","source":{"text":"今置身青云，渠尚蹉跎仕路，何不一引乎？","book":"清·蒲松龄《聊斋志异·续黄粱》"},"example":{"text":"他～，只好退隐。"},"opposite":["平步青云"],"usage":"作谓语；指仕途不得志"},{"id":42662,"word":"蹉跎岁月","pinyin":"cuō tuó suì yuè","abbr":"ctsy","explanation":"蹉跎：时光白白过去。把时光白白地耽误过去。指虚度光阴。","source":{"text":"娱乐未终极，白日忽蹉跎。","book":"晋·阮籍《咏怀》诗"},"example":{"text":"倘我不能报复而死，埋没了龙家的豹韬，枉～一死鸿毛。","book":"明·张凤翼《灌园记·君后授衣》"},"similar":["虚度年华","马齿徒增"],"opposite":["分秒必争","夜以继日"],"usage":"作谓语、宾语；形容虚度光阴","story":["唐朝时期，诗人李颀40岁中进士，任新乡县令，后官场不得志就辞官归隐，专门从事诗歌创作，朋友魏万去京城应试求取功名，他作赠别诗《送魏万之京》：“关城曙色催寒近，御苑砧声向晚多。莫见长安行乐处，空另岁月易蹉跎。”"]},{"id":42663,"word":"蹉跎日月","pinyin":"cuō tuó rì yuè","abbr":"ctry","explanation":"蹉跎：时光白白过去。把时光白白地耽误过去。指虚度光阴。","source":{"text":"娱乐未终极，白日忽蹉跎。","book":"晋·阮籍《咏怀》诗"},"example":{"text":"徒使度外之士，摈弃而不得骋，～而老将至矣。","book":"宋·陈亮《上孝宗皇帝书》"},"similar":["蹉跎时日"],"usage":"作谓语、宾语；形容虚度光阴"},{"id":42664,"word":"蹉跎时日","pinyin":"cuō tuó shí rì","abbr":"ctsr","explanation":"蹉跎：时光白白过去。把时光白白地耽误过去。指虚度光阴。","source":{"text":"郎君奉尊堂之命，远来游学，不可蹉跎时日。","book":"明·周楫《西湖二集·洒雪堂巧结良缘》"},"example":{"text":"事势多歧，筑室道谋，～。","book":"蔡东藩《民国通俗演义》第108回"},"similar":["蹉跎岁月"],"opposite":["分秒必争"],"usage":"作谓语、宾语；形容虚度光阴"},{"id":42665,"word":"蹉跎自误","pinyin":"cuō tuó zì wù","abbr":"ctzw","explanation":"蹉跎：时间白白地消耗掉。人生虚度年华，耽误了自己的前程。","source":{"text":"长兄年力鼎盛，万不可蹉跎自误。","book":"清·吴敬梓《儒林外史》第39回"},"example":{"text":"你不可～，害了自己。"},"similar":["蹉跎岁月"],"usage":"作谓语、宾语；指自误前程"},{"id":42666,"word":"蹊田夺牛","pinyin":"xī tián duó niú","abbr":"qtdn","explanation":"蹊：践踏；夺：强取。因牛践踏了田，抢走人家的牛。比喻罪轻罚重。","source":{"text":"‘牵牛以蹊人之田，而夺之牛。’牵牛以蹊者，信有罪矣；而夺之牛，罚已重矣。","book":"《左传·宣公十一年》"},"example":{"text":"宏不去，则有持禄保位之诮，璁、萼不去，亦冒～之嫌。","book":"《明史·解一贯传》"},"similar":["罪轻罚重"],"usage":"作宾语、定语；指处罚失当","story":["春秋时期，陈灵公荒淫无道，被大夫夏征舒杀了。楚庄王为伸张正义发兵攻打陈国，杀了夏征舒，准备把陈国吞并。大夫申叔认为楚庄王是过分行动，就像有人牵牛踩了别人的田地，别人把他的牛给没收一样没有道理"]},{"id":42667,"word":"蹐地局天","pinyin":"jí dì jú tiān","abbr":"jdjt","explanation":"形容戒慎小心。","source":{"text":"谓天盖高，不敢不局，谓地盖厚，不敢不蹐。","book":"语出《诗·小雅·正月》"},"example":{"text":"～，不胜大愿。","book":"唐·白居易《为宰相请上尊号第二表》"}},{"id":42668,"word":"蹐地跼天","pinyin":"jí dì jú tiān","abbr":"jdjt","explanation":"形容戒慎小心。","source":{"text":"谓天盖高，不敢不局，谓地盖厚，不敢不蹐。","book":"《诗经·小雅·正月》"},"example":{"text":"～，不胜大愿。","book":"唐·白居易《为宰相请上尊号第二表》"},"similar":["小心谨慎"],"usage":"作谓语；指戒慎小心"},{"id":42669,"word":"蹐地踨天","pinyin":"jí dì jú tiān","abbr":"jdjt","explanation":"形容戒慎小心。","source":{"text":"谓天盖高，不敢不局，谓地盖厚，不敢不蹐。","book":"《诗经·小雅·正月》"},"quote":{"text":"～，不胜大愿。","book":"唐·白居易《为宰相请上尊号第二表》"}},{"id":42670,"word":"蹑屩担簦","pinyin":"niè juē dān dēng","abbr":"njdd","explanation":"指远行、跋涉。亦指身分、地位低下。同“蹑蹻檐簦”。","source":{"text":"公皆蹑屩担簦，往拜其坐下。","book":"明·宋濂《太上清正一万寿宫住持提点张公碑铭序》"},"example":{"text":"而向且未即前者，自分～之贱，渎及左右。","book":"清·谈迁《北游录·纪文·上太仆曹秋壑书》"},"similar":["蹑蹻担簦"],"usage":"作谓语、定语；用于书面语"},{"id":42671,"word":"蹑屩檐簦","pinyin":"niè juàn yán dēng","abbr":"njyd","explanation":"指远行、跋涉。同“蹑蹻檐簦”。"},{"id":42672,"word":"蹑影潜踪","pinyin":"niè yǐng qián zōng","abbr":"nyqz","explanation":"指行动诡秘，不露形迹。同“蹑影藏形”。","source":{"text":"蹑影潜踪，追来不放松，敛锐锋藏，还愁遇夹攻。谋臣计也空，武臣力也穷。","book":"清·李渔《比目鱼·奏捷》"},"similar":["蹑影藏形"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":42673,"word":"蹑影藏形","pinyin":"niè yǐng cáng xíng","abbr":"nycx","explanation":"指行动诡秘，不露形迹。","source":{"text":"昼即途中寻鬼路，蹑影藏形恒夜游。","book":"《敦煌变文集·伍子胥变文》"},"similar":["蹑影潜踪"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":42674,"word":"蹑影追风","pinyin":"niè yǐng zhuī fēng","abbr":"nyzf","explanation":"形容速度极快。","source":{"text":"风驰电逝，蹑景追风。","book":"三国·魏·阮籍《赠兄秀才入军》诗"},"example":{"text":"虎班龙文之逸，兰池蒲梢之驵，嘘天陆野，～，振旅南辕，长驱讨蹙。","book":"《魏书·岛夷萧衍传》"},"similar":["蹑景追飞"],"usage":"作宾语、状语；用于书面语"},{"id":42675,"word":"蹑手蹑脚","pinyin":"niè shǒu niè jiǎo","abbr":"nsnj","explanation":"形容放轻脚步走的样子。也形容偷偷摸摸、鬼鬼祟祟的样子。","source":{"text":"于是大家蹑手蹑脚，潜踪进镜壁去一看。","book":"清·曹雪芹《红楼梦》第五十四回"},"example":{"text":"为了不影响别人，同学们在阅览室里走路都是～的。"},"similar":["轻手轻脚","鬼鬼祟祟"],"opposite":["正大光明","大大方方"],"usage":"作谓语、状语；形容放轻脚步走的样子"},{"id":42676,"word":"蹑手蹑足","pinyin":"niè shǒu niè zú","abbr":"nsnz","explanation":"形容放轻脚步走的样子。也形容偷偷摸摸、鬼鬼祟祟的样子。同“蹑手蹑脚”。","source":{"text":"小丫鬟等更蹑手蹑足的在外间收拾那粉盒妆盝，不敢大声说一句话，倒弄得内外静悄悄的。","book":"清·魏秀仁《花月痕》第十三回"},"example":{"text":"为着我到她家去替她看小孩，她走了，和猫一样～的下楼去了。","book":"萧红《桥·烦扰的一日》"},"similar":["蹑手蹑脚","蹑足而行"],"usage":"作谓语、状语；形容放轻脚步走的样子"},{"id":42677,"word":"蹑景追风","pinyin":"niè yǐng zhuī fēng","abbr":"njzf","explanation":"景：通“影”；蹑影：追赶太阳影子。赶上太阳的影子，追逐上风。形容速度极快。也比喻进步极快。","source":{"text":"风驰电逝，蹑景追风。","book":"三国·魏·阮籍《赠兄秀才入军》诗"}},{"id":42678,"word":"蹑景追飞","pinyin":"niè yǐng zhuī fēi","abbr":"njzf","explanation":"蹑：追踪。形容速度飞快。","source":{"text":"风驰电逝，蹑景追飞。","book":"三国·魏·阮籍《赠秀才入军》"},"similar":["蹑影追风"],"usage":"作宾语、状语；用于书面语"},{"id":42679,"word":"蹑脚蹑手","pinyin":"niè jiǎo niè shǒu","abbr":"njns","explanation":"形容放轻脚步走的样子。也形容偷偷摸摸、鬼鬼祟祟的样子。同“蹑手蹑脚”。","source":{"text":"于是贝胡子蹑脚蹑手到窗子跟前，打冷布角里张一张院子里——空空的。","book":"张天翼《春风·贝胡子》"},"example":{"text":"他们～地走到门口，把眼睛贴着门缝，看见有十几个青年农民挤在小屋中。","book":"姚雪垠《长夜》三五"},"similar":["蹑手蹑脚","蹑手蹑足"],"usage":"作谓语、状语；形容放轻脚步走的样子"},{"id":42680,"word":"蹑足其间","pinyin":"niè zú qí jiān","abbr":"nzqj","explanation":"蹑：插进。脚踩在里头。比喻参加进去。","source":{"text":"非有仲尼墨翟之贤，陶朱猗顿之富，蹑足行伍之间而崛起阡陌之中。","book":"《史记·秦始皇本纪》"},"example":{"text":"他已经～，难以抽身了"},"similar":["厕足其间"],"usage":"作谓语；比喻参与了某事"},{"id":42681,"word":"蹑足屏息","pinyin":"niè zú bǐng xī","abbr":"nzbx","explanation":"蹑足：放轻脚步；屏息：忍住呼吸。指放轻脚步，隐蔽行踪。形容行动小心隐秘。","source":{"text":"赵子曰似乎昏昏的睡去，他蹑足屏息的想往外走。","book":"老舍《赵子曰》"},"similar":["蹑足潜踪"],"usage":"作谓语、定语；用于人的行动等"},{"id":42682,"word":"蹑足潜踪","pinyin":"niè zú qián zōng","abbr":"nzqz","explanation":"蹑足：脚步很轻的样子；潜：隐藏；踪：踪迹。指放轻脚步，隐住身体。形容小心隐秘的样子。","source":{"text":"我这里蹑足潜踪，悄地听咱。一个羞惭，一个怒发。","book":"元·王实甫《西厢记》第三本第三折"},"example":{"text":"叔宝～，进了老母卧房来，只见两个丫头，三年内都已长大。（清·禇人获《隋唐演义》第十五回）"},"similar":["蹑足屏息"],"usage":"作谓语、定语；指人的行动"},{"id":42683,"word":"蹑足附耳","pinyin":"niè zú fù ěr","abbr":"nzfe","explanation":"踩人足以示意，附耳说悄悄话。","source":{"text":"汉王大怒，骂曰：吾困于此，旦暮望若来佐我，乃欲自立为王！张良、陈平蹑汉王足，因附耳语曰：汉方不利，宁能禁信之王乎？不如因而立，善遇之，使自为守。不然，变生。","book":"《史记·淮阴侯传》"}},{"id":42684,"word":"蹑蹻担簦","pinyin":"niè juē dān dēng","abbr":"njdd","explanation":"蹻：草鞋；簦：长柄笠。脚穿草鞋，身背竹笠。指长途跋涉。同“蹑蹻檐簦”。","source":{"text":"迄延平王兵衄于金陵城下，余提孤军走英霍山。徐子蹑蹻担簦，章皇山泽中。","book":"明·张煌言《徐允岩诗序》"},"example":{"text":"余生江淮之间，菰芦之内，见闻寡陋，学殖荒落，垂三十年，而始～游学于四方，求天下之士而交之，以辅其所不逮。","book":"清·戴名世《赠张天间先生八十寿序》"},"similar":["蹑屩担簦"],"usage":"作谓语、定语；用于书面语"},{"id":42685,"word":"蹑蹻檐簦","pinyin":"niè juē dàn dēng","abbr":"njyd","explanation":"穿着草鞋，背着斗笠。指远行、跋涉。","source":{"text":"蹻，草履也。簦，长柄笠，音登。笠有柄者谓之簦。","book":"《史记·平原君虞卿列传》：“虞卿者，游说之士也。蹑蹻檐簦，说赵孝成王。”裴骃集解引徐广曰"},"similar":["蹑蹻担簦"],"usage":"作谓语、定语；用于书面语"},{"id":42686,"word":"蹑躥担簦","pinyin":"niè juē dān dēng","abbr":"njdd","explanation":"?焙草鞋；簦长柄笠。脚穿草鞋，身背竹笠。指长途跋涉。同蹑躥檐簦”。","source":{"text":"迄延平王兵衄于金陵城下，余提孤军走英霍山。徐子蹑躥担簦，章皇山泽中。","book":"明·张煌言《徐允岩诗序》"},"quote":{"text":"余生江淮之间，菰芦之内，见闻寡陋，学殖荒落，垂三十年，而始～游学于四方，求天下之士而交之，以辅其所不逮。","book":"清·戴名世《赠张天间先生八十寿序》"}},{"id":42687,"word":"蹑躥檐簦","pinyin":"niè juē dàn dēng","abbr":"njdd","explanation":"穿着草鞋，背着斗笠。指远行、跋涉。","source":{"text":"虞卿者，游说之士也。蹑躥檐簦，说赵孝成王。裴髎集解引徐广曰躥，草履也。簦，长柄笠，音登。笠有柄者谓之簦。","book":"《史记·平原君虞卿列传》"}},{"id":42688,"word":"蹙国丧师","pinyin":"cù guó sàng shī","abbr":"cgss","explanation":"蹙：收缩，指丧失国土。国土沦丧，军队失利。","source":{"text":"及其入处国钧，未有嘉谋善政，出总戎律，唯闻蹙国丧师，是知风流异贞固之才，谈论非奇正之要。","book":"《晋书·陆晔何充等传论》"},"usage":"作谓语、定语；用于战争等"},{"id":42689,"word":"蹙国百里","pinyin":"cù guó bǎi lǐ","abbr":"cgbl","explanation":"蹙：收缩；百里：形容很多。丧失大片国土。","source":{"text":"昔先王受命，有如召公，日辟国百里，也日蹙国百里。","book":"《诗经·大雅·召旻》"},"usage":"作谓语；用于战争等"},{"id":42690,"word":"蹙蹙靡骋","pinyin":"cù cù mǐ chěng","abbr":"ccmc","explanation":"指局促，无法舒展。","source":{"text":"我瞻四方，蹙蹙靡所骋。","book":"《诗经·小雅·节南山》"},"example":{"text":"我民岁增二千余万之负担，汲汲顾影，～矣！","book":"清·梁启超《中国国债史》"},"usage":"作谓语、定语；指不能舒展"},{"id":42691,"word":"蹙金结绣","pinyin":"cù jīn jié xiù","abbr":"cjjx","explanation":"形容文章精美，结构严密。","source":{"text":"赵牧不知何人。大中、咸通中，斅李长吉为短歌，可谓蹙金结绣，而无痕迹。","book":"五代·王定保《唐摭言海叙不遇》"},"usage":"作谓语、定语；用于作文等"},{"id":42692,"word":"蹠犬噬尧","pinyin":"zhí quǎn shì yáo","abbr":"zqsy","explanation":"原指人臣各为其主。后用以比喻嫉妒贤才。","source":{"text":"貂勃曰：‘跖之狗吠尧，非贵跖而贱尧也，狗固吠非其主也。’","book":"《战国策·齐策六》"},"example":{"text":"咎繇不作谁与平兮，～理则然兮。","book":"明·刘基《吊泰不华元帅赋》"}},{"id":42693,"word":"蹠狗吠尧","pinyin":"zhí gǒu fèi yáo","abbr":"zgfy","explanation":"意指各为其主。"},{"id":42694,"word":"蹦蹦跳跳","pinyin":"bèng bèng tiào tiào","abbr":"bbtt","explanation":"精力充沛的充满活力的样子。","source":{"text":"我眉开眼笑，近乎蹦蹦跳跳地飞跑过去。","book":"王朔《动物凶猛》"},"example":{"text":"她带来一个～的女孩。"},"similar":["连蹦带跳"],"usage":"作谓语、状语、定语；多用于小孩等"},{"id":42695,"word":"蹶角受化","pinyin":"juè jiǎo shòu huà","abbr":"jjsh","explanation":"蹶角：叩头；受化：接受文化。原指四方夷族和外国人来中国朝贡，接受教化。形容声威极大。","source":{"text":"当今皇帝盛明，天下安乐，白环西献，楛矢东来，夜郎、滇池，解辫请职，朝鲜、昌海，蹶角受化。","book":"南朝·梁·丘迟《与陈伯之书》"}},{"id":42696,"word":"蹿房越脊","pinyin":"cuān fáng yuè jí","abbr":"cfyj","explanation":"旧小说多用来形容侠客、盗贼等跳上房顶，在上面飞快地行走。","source":{"text":"翻身上房，蹿房越脊，过了几重院子，跳在就地。","book":"清·贪梦道人《彭公案》第29回"},"example":{"text":"侠客一般都有～的本事。"},"similar":["飞檐走壁"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":42697,"word":"躁言丑句","pinyin":"zào yán chǒu jù","abbr":"zycj","explanation":"丑恶的言辞。躁，通“臊”。","source":{"text":"若能辟礼门以悬规，标义路以植矩，然后逾垣者折肱，捷径者灭趾，何必躁言丑句，诟病为切哉！","book":"南朝梁·刘勰《文心雕龙·奏启》"}},{"id":42698,"word":"身不由主","pinyin":"shēn bù yóu zhǔ","abbr":"sbyz","explanation":"身体不由自己作主。","source":{"text":"张协本意无心娶你，在穷途身自不由己。况天寒举目又无亲，乱与伊家相娶。","book":"宋·无名氏《张协状元·张协贫女团圆》"},"example":{"text":"今既到此间，～，拼着这条命吧。（清·钱彩《说岳全传》第六十六回）"},"similar":["身不由己"],"opposite":["应付自如"],"usage":"作谓语、状语；指不能自主"},{"id":42699,"word":"身不由己","pinyin":"shēn bù yóu jǐ","abbr":"sbyj","explanation":"由：听从。身体不由自己作主。","source":{"text":"张协本意无心娶你，在穷途身自不由己。况天寒举目又无亲，乱与伊家相娶。","book":"宋·无名氏《张协状元·张协贫女团圆》"},"example":{"text":"上命差遣，～。望君侯怜悯，誓以死报。","book":"明·罗贯中《三国演义》第七十四回"},"similar":["不由自主","情不自禁"],"opposite":["得心应手","应付自如","独立自主"],"usage":"作谓语、状语；指行为不能由自己支配"},{"id":42700,"word":"身不遇时","pinyin":"shēn bù yù shí","abbr":"sbys","explanation":"指没有遇到好的时机。","source":{"text":"官人，身不遇时，且自宁奈。","book":"明·沈采《千金记·宵征》"},"similar":["生不逢时"],"usage":"作谓语、定语；多用于感叹"},{"id":42701,"word":"身临其境","pinyin":"shēn lín qí jìng","abbr":"slqj","explanation":"临：到；境：境界，地方。亲自到了那个境地。","source":{"text":"而曹公已临其境。","book":"《三国志·吴志·吴主传》"},"example":{"text":"及至～，只落得“原来如此”四个大字。","book":"清·石玉昆《三侠五义》第六十五回"},"similar":["设身处地","推己及人","身历其境"],"opposite":["隔靴搔痒","道听途说"],"usage":"作谓语、宾语、定语；指亲自面对"},{"id":42702,"word":"身为粪土","pinyin":"shēn wéi fèn tǔ","abbr":"swft","explanation":"死后只能化为粪土。形容身死被弃。","source":{"text":"今子无母于中，外托于不可知之国，一日倍约，身为粪土。","book":"《战国策·秦策五》"}},{"id":42703,"word":"身亡命殒","pinyin":"shēn wáng mìng yǔn","abbr":"swmy","explanation":"身、命：生命；亡、殒：死亡。指人死亡。","source":{"text":"宝玉素日虽是口角伶俐，只是此时一心总为金钏儿感伤，恨不得此时也身亡命殒，跟了金钏儿去。","book":"清·曹雪芹《红楼梦》第大理石十回"}},{"id":42704,"word":"身价倍增","pinyin":"shēn jià bèi zēng","abbr":"sjbz","explanation":"建立或增进个人的权威、影响或声望。","example":{"text":"经过演出这部电视剧后，他～。"},"similar":["声誉大振"],"opposite":["名声扫地"],"usage":"作谓语、定语；指个人的权威、影响或声望"},{"id":42705,"word":"身价百倍","pinyin":"shēn jià bǎi bèi","abbr":"sjbb","explanation":"身价：指社会地位。指名誉地位一下子大提高。","source":{"text":"碑碣铭志之石，非公笔不重；断楮残煤，声价百倍。","book":"明·娄绍书《无声诗史》"},"example":{"text":"他唱歌出名后就～。"},"similar":["声誉鹤起","高人一筹"],"opposite":["名声扫地","身败名裂"],"usage":"作谓语；形容人地位提高"},{"id":42706,"word":"身体力行","pinyin":"shēn tǐ lì xíng","abbr":"stlx","explanation":"身：亲身；体：体验。亲身体验，努力实行。","source":{"text":"圣人以身体之。”《礼记·中庸》： “力行近乎仁。","book":"《淮南子·氾论训》"},"example":{"text":"先生以致知格物为基阯（址），以～为堂奥。","book":"清·张惠言《承拙斋空传》"},"usage":"作谓语、定语；指亲身体验"},{"id":42707,"word":"身体发肤","pinyin":"shēn tǐ fà fū","abbr":"stff","explanation":"本指身躯、四肢、须发、皮肤，后亦泛指自己身体的全部，自身。","source":{"text":"身体发肤，受之父母，不敢毁伤，孝之始也。","book":"《孝经·开宗明义》"},"example":{"text":"夫～，不敢毁伤，圣人之训也。","book":"清·侯方域《万孝子割股议》"},"usage":"作主语、宾语；指自身"},{"id":42708,"word":"身做身当","pinyin":"shēn zuò shēn dāng","abbr":"szsd","explanation":"指自己做事自己承当。","source":{"text":"哥哥，小人身做身当，岂敢带累你也。","book":"元·刘唐卿《降桑椹》第一折"},"example":{"text":"这场事本是我惹下的……我如今～，杀出阵去，向曹操求救军，来和吕布相持。","book":"明·无名氏《三出小沛》第二折"},"similar":["一人做事一人当"],"usage":"作谓语、定语；用于处事"},{"id":42709,"word":"身先士众","pinyin":"shēn xiān shì zhòng","abbr":"sxsz","explanation":"作战时将领亲自带头，冲在士兵前面。现在也用来比喻领导带头，走在群众前面。同“身先士卒”。","source":{"text":"公当身先士众，早定关中，乃欲急自尊崇，何示人不广也！","book":"《旧唐书·李密传》"},"similar":["身先士卒"],"usage":"作谓语、定语；指带头"},{"id":42710,"word":"身先士卒","pinyin":"shēn xiān shì zú","abbr":"sxsz","explanation":"作战时将领亲自带头，冲在士兵前面。现在也用来比喻领导带头，走在群众前面。","source":{"text":"玄感每战，身先士卒，所向摧陷。","book":"《史记·淮南衡山列传》：“当敌勇敢，常为士卒先。”《资治通鉴·隋纪炀帝大业九年》"},"example":{"text":"披坚执锐，临难不顾，～。","book":"明·罗贯中《三国演义》第七十二回"},"similar":["以身作则","一马当先"],"opposite":["瞠乎其后"],"usage":"作谓语、定语；指带头","story":["1883年，法军从越南边境进攻中国，老将冯子材奉命率军驻守镇南关，面对装备精良的法军，冯子材一点也不畏惧，积极备战，誓与镇南关共存亡，将士们深受感动，个个英勇作战。冯子材更是身先士卒，与法军进行肉博战，打败了法军"]},{"id":42711,"word":"身先朝露","pinyin":"shēn xiān zhāo lù","abbr":"sxcl","explanation":"指身体比早晨露水消失还快。比喻很快死亡。","source":{"text":"恐一旦身先朝露，必至累人，遂遣人于容城先人墓侧，修宫一舍，傥病势不退，当居处其中以待尽。","book":"《元史·刘因传》"},"usage":"作谓语、宾语；用于书面语"},{"id":42712,"word":"身入其境","pinyin":"shēn rù qí jìng","abbr":"srqj","explanation":"入：到，进入；境：境界，地方。亲自到了那个境地。","source":{"text":"而曹公已临其境。","book":"《三国志·吴志·吴主传》"},"example":{"text":"一时故乡清明赛会、扫墓、踏青、种树之景，以及绸衫、小帽、酒旗、戏鼓之状，憬然在目，恍如～。","book":"丰子恺《静观人生》九"},"similar":["身当其境","身历其境","身临其境"],"usage":"作谓语、宾语、定语；指亲自面对"},{"id":42713,"word":"身其余几","pinyin":"shēn qí yú jǐ","abbr":"sqyj","explanation":"指身子留在世间没有多久的时间了。","source":{"text":"古人有言：畏首畏尾，身其余几。","book":"《左传·文公十七年》"},"example":{"text":"因为童贯上回一番发作，又立了这样章程，弄得进进出出十分碍手，真所谓畏首畏尾，～。","book":"清·俞万春《荡寇志》第一百二十三回"}},{"id":42714,"word":"身分不明","pinyin":"shēn fèn bù míng","abbr":"sfbm","explanation":"来历不详。","source":{"text":"对于那些～的电子邮件千万不能随便开启。"},"example":{"text":"对于那些～的电子邮件千万不能随便开启"},"similar":["来路不明"],"usage":"作谓语、定语；指来历不详"},{"id":42715,"word":"身单力薄","pinyin":"shēn dān lì bó","abbr":"sdlb","explanation":"人少力量不大。","source":{"text":"嗳，年轻人，你们怎么瞎挤？夏平站在后面护他，身单力薄，也护不住。","book":"柯云路《衰与荣》"},"similar":["形单影只","势单力薄"],"opposite":["人多势众","身强力壮"],"usage":"作谓语、定语；形容人单势孤"},{"id":42716,"word":"身历其境","pinyin":"shēn lì qí jìng","abbr":"slqj","explanation":"历：经历；境：境界，地方。亲自到了那个境地。","source":{"text":"而曹公已临其境。","book":"《三国志·吴志·吴主传》"},"example":{"text":"“晓风残月”、“大江东云”，体制虽殊，读之皆若～，惝怳迷离，不能自主，文之至也。","book":"清·沈谦《填词杂说》"},"similar":["身当其境","身临其境","身入其境"],"opposite":["道听途说"],"usage":"作谓语、宾语、定语；指亲自面对"},{"id":42717,"word":"身名两泰","pinyin":"shēn míng liǎng tai","abbr":"smlt","explanation":"名誉、地位都安稳。形容生活舒泰。同“身名俱泰”。","source":{"text":"吾荷朝恩，得安丘壑，身名两泰，夫复奚言。","book":"南明·陈·周弘让《与徐陵书荐方圆》"},"similar":["身名俱泰"],"usage":"作谓语、定语；用于生活等"},{"id":42718,"word":"身名俱泰","pinyin":"shēn míng jù tai","abbr":"smjt","explanation":"名誉、地位都安稳。形容生活舒泰。","source":{"text":"崇（石崇）正色曰：‘士当身名俱泰，何至瓮牗哉！’","book":"《晋书·石崇传》"},"example":{"text":"清·褚人获《隋唐演义》第88回：“则上下猜疑尽释，谗口无可置喙，～，爵位永保，岂不善哉！”"},"similar":["身名两泰"],"usage":"作谓语、定语；用于生活等"},{"id":42719,"word":"身名俱灭","pinyin":"shēn míng jù miè","abbr":"smjm","explanation":"指身躯与名声一齐毁灭。","source":{"text":"孰若翻然改图，唯理是宅，保其富贵，全其勋业，则身与金石等固，名与天壤俱穷，孰与头足异处，身名俱灭，为天下笑哉。","book":"晋·桓玄《与刘牢之书》"},"example":{"text":"这些“轻薄为文”者，生前虽哗众取宠，死后必默默无闻，～。"},"similar":["身败名裂"],"opposite":["身名俱泰"],"usage":"作谓语、状语；指身败名裂"},{"id":42720,"word":"身名俱裂","pinyin":"shēn míng jù liè","abbr":"smjl","explanation":"身躯和声誉一齐毁灭。","source":{"text":"孰若翻然改图，保其富贵，则身与金石等固，名与天壤无穷，孰与头足异处，身名俱灭，为天下笑哉。","book":"晋·桓玄《与刘牢之书》"},"example":{"text":"当时壎颜屈节，侥幸以偷生者，多被刑掠以死，～，贻诟无穷。","book":"《明史·范景文等传赞》"}},{"id":42721,"word":"身名俱败","pinyin":"shēn míng jù bài","abbr":"smjb","explanation":"犹言身名俱灭。指身躯与名声一齐毁灭。","source":{"text":"今日为公孙枝所诱，死于王城，身名俱败，岂不哀哉！","book":"《东周列国志》第三六回"},"example":{"text":"就因这两个字上误事，几乎弄得～，骨肉沦亡。","book":"《儿女英雄传》第十三回"},"similar":["身名俱灭"],"opposite":["身名俱泰"],"usage":"作谓语、状语；指身败名裂"},{"id":42722,"word":"身后萧条","pinyin":"shēn hòu xiāo tiáo","abbr":"shxt","explanation":"形容死后家境冷落、贫困。","source":{"text":"我的父母一生都是这样傻，以致身后萧条，子女窘迫。","book":"鲁迅《两地书》"},"example":{"text":"鲁迅《两地书》：“我的父母一生都是这样傻，以致～，子女窘迫。”"},"usage":"作谓语、宾语、定语；指家境冷落"},{"id":42723,"word":"身后识方干","pinyin":"shēn hòu shí fāng gān","abbr":"shsfg","explanation":"比喻一个人才，生前无人赏识，死后才被重视。","source":{"text":"放眼古今多少恨，可怜识后识方干。","book":"清·袁枚《随园诗话》"},"usage":"作宾语、定语；用于处事"},{"id":42724,"word":"身在曹营心在汉","pinyin":"shēn zài cáo yíng xīn zài hàn","abbr":"szcyxzh","explanation":"汉：汉朝。原指关羽身在曹营，心想刘备。比喻身子虽然在对立的一方，但心里想着自己原来所在的一方。","source":{"text":"《三国演义》第二五回至十二七回"},"example":{"text":"～，他就是上马金，下马银，也别想把我买动。","book":"刘波泳《秦川儿女》第一部第二章"},"similar":["人在心不在","心猿意马"],"opposite":["同心协力"],"usage":"作谓语、分句；指人忠心","story":["东汉末年，刘备被曹操打败。关羽为了保护刘备的夫人被迫投降曹操。曹操对关羽关怀备至，送他宅院、美女、战袍及宝马，关羽还是无动于衷，一心想打听刘备的下落。张辽问他为什么身在曹营心在汉，关羽说他与刘备有过生死誓言"]},{"id":42725,"word":"身在林泉，心怀魏阙","pinyin":"shēn zài lín quán，xīn huái wèi què","abbr":"szlqxhwq","explanation":"旧指解除官职的人，仍惦记着进朝廷的事。后常用以讽刺迷恋功名宝贵的假隐士。同“身在江湖，心存魏阙”。","source":{"text":"我老臣虽是身在林泉，心怀魏阙，岂知平地风波，生此异事。","book":"《封神演义》第八回"},"similar":["身在江海，心驰魏阙"],"usage":"作谓语、宾语、分句；用于书面语"},{"id":42726,"word":"身在江海，心驰魏阙","pinyin":"shēn zài jiāng hǎi，xīn chí wèi què","abbr":"szjhxcwq","explanation":"魏阙：古代宫门外高大的建筑，用作朝廷的代称。旧指解除官职的人，仍惦记着进朝廷的事。后常用以讽刺迷恋功名宝贵的假隐士。","source":{"text":"身在江海之上，心居乎魏阙之下。","book":"《庄子·让王》"},"example":{"text":"余独坐一隅，孤愤五蠹，虽身在江海，而心驰魏阙。","book":"唐·陈子昂《夏日晖上人房别李参军崇嗣》"},"similar":["身在江湖，心悬魏阙"],"usage":"作谓语、定语、分句；用于书面语"},{"id":42727,"word":"身在江湖，心存魏阙","pinyin":"shēn zài jiāng hú，xīn cún wèi què","abbr":"szjhxcwq","explanation":"魏阙：古代宫门外高大的建筑，用作朝廷的代称。旧指解除官职的人，仍惦记着进朝廷的事。后常用以讽刺迷恋功名宝贵的假隐士。","source":{"text":"身在江海之上，心居乎魏阙之下。","book":"《庄子·让王》"},"example":{"text":"他此时虽然是已经罣误，然而一言一动，仍不失他“～”的思想。","book":"清·李宝嘉《中国现在记》第一回"},"similar":["身在江海，心驰魏阙"],"usage":"作谓语、宾语、分句；指退休后关心国家"},{"id":42728,"word":"身在江湖，心悬魏阙","pinyin":"shēn zài jiāng hú，xīn xuán wèi què","abbr":"szjhxxwq","explanation":"魏阙：古代宫门外高大的建筑，用作朝廷的代称。旧指解除官职的人，仍惦记着进朝廷的事。后常用以讽刺迷恋功名宝贵的假隐士。","source":{"text":"身在江海之上，心居乎魏阙之下。","book":"《庄子·让王》"},"example":{"text":"总是老先生～，故尔忧愁抑郁，现出此症。","book":"清·吴敬梓《儒林外史》第十一回"},"similar":["身在江湖，心存魏阙"],"usage":"作谓语、宾语、分句；用于书面语"},{"id":42729,"word":"身在福中不知福","pinyin":"shēn zài fú zhōng bù zhī fú","abbr":"szfzbzf","explanation":"生活在幸福之中，并不感到幸福。也形容对优裕的生活不满足。","example":{"text":"真是～，这么好的孩子，还要罚！要是没有他，你又不知道该怎么样了。","book":"老舍《四世同堂》九十三"}},{"id":42730,"word":"身外之物","pinyin":"shēn wài zhī wù","abbr":"swzw","explanation":"指财物等身体以外的东西，表示无足轻重的意思。","source":{"text":"贞观初，太宗谓侍臣曰：‘明珠是身外之物，尚不可弹雀，何况生命之重，乃以博财物耶？’","book":"唐·吴兢《贞观政要·贪鄙》"},"example":{"text":"但功名到底是～，德行是要紧的。","book":"清·吴敬梓《儒林外史》第十七回"},"usage":"作主语、宾语；指名誉、地位、财产等"},{"id":42731,"word":"身大力不亏","pinyin":"shēn dà lì bù kuī","abbr":"sdlbk","explanation":"形容人身材高大，强壮有力。","example":{"text":"瞧他这样，～的，还和小孩一样呢，倒是真着急！","book":"老舍《骆驼祥子》七"}},{"id":42732,"word":"身家性命","pinyin":"shēn jiā xìng mìngv","abbr":"sjxm","explanation":"身家：本人和家庭。本人和全家人的生命。","source":{"text":"倘举事一有不当，那些全躯保妻子的，随而媒孽其短，身家性命，都在权奸掌握之中。","book":"明·施耐庵《水浒全传》第一○八回"},"example":{"text":"我若没有还他，这件事就要破！～关系，我所以和老哥商议。（清·吴敬梓《儒林外史》第三十二回）"},"usage":"作主语、宾语、定语；指全家人的生命"},{"id":42733,"word":"身寄虎吻","pinyin":"shēn jì hǔ wěn","abbr":"sjhw","explanation":"指把身子置于老虎嘴边。比喻处境极其危险。","source":{"text":"凶命屡招，奸威仍逼，身寄虎吻，危同朝露，而能抗节玉立，誓不降辱。","book":"晋·桓彝《荐谯元彥表》"},"usage":"作宾语、定语；用于比喻句"},{"id":42734,"word":"身将就木","pinyin":"shēn jiāng jiù mù","abbr":"sjjm","explanation":"将：快要；就：趋，进；木；棺材。指人寿命已经不长，快要进棺材了。","source":{"text":"管甚么民脂民膏，竟忘了礼义廉耻，直至身将就木，还遗命叫儿子薄殡殓，勿治丧，勿礼忏。","book":"清·褚人获《隋唐演义》第32回"},"similar":["行将就木","气息奄奄"],"opposite":["蒸蒸日上"],"usage":"作谓语、定语；指快要死亡"},{"id":42735,"word":"身居言路","pinyin":"shēn jū yán lù","abbr":"sjyl","explanation":"言路：进言之路。旧指身居谏官之职。","source":{"text":"身居言路，则思纳约自牖，以靖朝纲，启沃献者，以重国脉。","book":"《参同经》卷上"},"example":{"text":"乾、嘉以后，那些～的士大夫们，就专在淫词小说上做文章。","book":"唐弢《雨夜杂写》四"}},{"id":42736,"word":"身废名裂","pinyin":"shēn fèi míng liè","abbr":"sfml","explanation":"指做坏事而遭到彻底失败。同“身败名裂”。","source":{"text":"他觉得自己已经身废名裂，要发抒意中的郁结，只有这一条通路。","book":"朱自清《经典常谈·〈史记〉〈汉书〉》"},"similar":["身败名裂","身败名隳"],"usage":"作谓语、定语、状语；指彻底失败"},{"id":42737,"word":"身强力壮","pinyin":"shēn qiáng lì zhuàng","abbr":"sqlz","explanation":"形容身体强壮有力。","source":{"text":"全凭着手疾眼快，必须要身强力壮。","book":"明·吴承恩《西游记》第二十一回"},"example":{"text":"那时，忠大伯还～，墩实个子，红脸庞，短胡子黑里带黄。","book":"梁斌《红旗谱》十"},"similar":["力壮身强","年富力强"],"opposite":["骨瘦如柴","弱不禁风"],"usage":"作谓语、定语；形容男士"},{"id":42738,"word":"身当其境","pinyin":"shēn dāng qí jìng","abbr":"sdqj","explanation":"临：到；境：境界，地方。亲自到了那个境地。同“身临其境”。","source":{"text":"可惜这些资料，我在目前不能得到，我不能写出些更具体的事实来，使未身当其境的朋友们也同样感泣一下。","book":"郭沫若《洪波曲》第七章六"},"example":{"text":"这种不忍想像的灾难，～的农民该是多么惨痛！","book":"范文澜《中国近代史》第八章"},"similar":["身历其境","身临其境","身入其境"],"usage":"作谓语、宾语、定语；指亲自面对"},{"id":42739,"word":"身当矢石","pinyin":"shēn dāng shǐ shí","abbr":"sdss","explanation":"形容亲自抵挡敌人进攻。","source":{"text":"《晋书·王鉴传》；“昔汉高、光武二帝，征无远近，敌无大小，必手振金鼓，身当矢石，栉风沐雨，壶浆不赡，驰骛四方。”"},"example":{"text":"世祖激厉将士，～，相持数旬，泰（杜泰）乃通走。","book":"《陈书·世祖纪》"},"similar":["亲当矢石"],"usage":"作谓语、定语；指人很勇敢"},{"id":42740,"word":"身微力薄","pinyin":"shēn wēi lì báo","abbr":"swlb","explanation":"指地位低下，财力不足。","source":{"text":"自惜身微力薄，不能拔之风尘，所以怜而与游。","book":"《二刻拍案惊奇》卷七"},"usage":"作谓语、定语；用于人的境遇等"},{"id":42741,"word":"身微命贱","pinyin":"shēn wēi mìng jiàn","abbr":"swmj","explanation":"身：身份；微：低微；贱：卑贱。身份低微，命也不值钱。","source":{"text":"又蒙赦其罪累，授以方州，德至恩弘，身微命贱，无阶答谢。","book":"唐·韩愈《袁州刺史谢上表》"}},{"id":42742,"word":"身微言轻","pinyin":"shēn wēi yán qīng","abbr":"swyq","explanation":"微：卑微。地位低，说话不受人重视。","source":{"text":"臣前后七表言，故合浦太守孟尝，而身轻言微，终不蒙察。","book":"《后汉书·孟尝传》"}},{"id":42743,"word":"身心交病","pinyin":"shēn xīng jiāo bìng","abbr":"sxjb","explanation":"交：一齐，同时；病：困乏。身体和精神都很困乏。","source":{"text":"我再斗下去，也许会‘身心交病’。","book":"鲁迅《而已集·答有恒先生》"},"similar":["心力交瘁","精疲力竭"],"opposite":["身强力壮","年富力强"],"usage":"作主语、谓语、宾语；形容人疲惫的样子"},{"id":42744,"word":"身心交瘁","pinyin":"shēn xīn jiāo cuì","abbr":"sxjc","explanation":"身体衰弱，精神不振。","source":{"text":"因为身心交瘁的谭鑫培自此便一病不起，匝月之间，与世长辞。","book":"石三友《金陵野史·谭鑫培的绝唱》"},"example":{"text":"王朔《动物凶猛》：“这种～的想入非非搞得我～，常常睡了一夜起来仍没精打采。”"},"similar":["身心交病"],"opposite":["身心健康"],"usage":"作谓语、定语；指身体和精神都过度疲劳"},{"id":42745,"word":"身心健康","pinyin":"shēn xīn jiàn kāng","abbr":"sxjk","explanation":"健康的身体和愉快正常的心态。","example":{"text":"教育要注意到孩子们的～。"},"opposite":["身心交瘁"],"usage":"作谓语、宾语、定语；用于口语"},{"id":42746,"word":"身怀六甲","pinyin":"shēn huái liù jiǎ","abbr":"shlj","explanation":"六甲：传说为上帝造物的日子。指妇女怀孕。","source":{"text":"《隋书·经籍志三》载有《六甲贯胎书》"},"example":{"text":"偏偏媳妇～，好容易逃至海外，生下红蕖孙女，就在此处敷衍度日。","book":"清·李汝珍《镜花缘》第十回"},"usage":"作谓语；指妇女怀孕"},{"id":42747,"word":"身操井臼","pinyin":"shēn cāo jǐng jiù","abbr":"scjj","explanation":"指亲自操持家务。","source":{"text":"衍娶北地任氏女为妻，悍忌，不得畜媵妾，儿女常自操井臼。","book":"语出《后汉书·冯衍传下》"},"example":{"text":"《梁书·文学传·刘峻》：“敬通有忌室，至于～；余有悍室，亦令家道轗轲。”"},"similar":["躬操井臼"],"usage":"作谓语、定语、宾语；指亲为"},{"id":42748,"word":"身教重于言教","pinyin":"shēn jiào zhòng yú yán jiào","abbr":"sjzyyj","explanation":"以身作则比口头上的教育更为重要。"},{"id":42749,"word":"身无分文","pinyin":"shēn wú fēn wén","abbr":"swfw","explanation":"形容非常贫穷。","source":{"text":"像往常那样，从黄原东关的汽车站出来后，他几乎又是身无分文了。","book":"路遥《平凡的世界》第四卷第32章"},"example":{"text":"他北上求职，却遭到扒手扒窃，～，求告无门。"},"similar":["囊中羞涩","不名一文"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；指穷光蛋"},{"id":42750,"word":"身无完肤","pinyin":"shēn wú wán fū","abbr":"swwf","explanation":"①指被打得遍体鳞伤。②比喻遭到攻击或破坏后难以自存的局面。","source":{"text":"师纂亦与艾俱死……死之日体无完皮。","book":"《三国志·魏书·邓艾传》“子忠与艾俱死”裴松之注引《世语》"},"example":{"text":"吴（吴时来）自姜（姜士昌）疏出，攻击叠至，～，旋卒于伍，寻至夺谥。","book":"明·沈德符《野获编·台省·御史大夫被论》"},"similar":["体无完肤"],"opposite":["完好无损"],"usage":"作谓语、定语、状语；用于被打或驳斥等"},{"id":42751,"word":"身无寸缕","pinyin":"shēn wú cùn lǚ","abbr":"swcl","explanation":"指身上没有一寸线。形容极其穷困。","source":{"text":"大雪下身无寸缕，投古庙泪珠涟涟。","book":"宋·无名氏《张协状元》戏文第四三出"},"similar":["一贫如洗","身贫如洗"],"opposite":["腰缠万贯"],"usage":"作谓语、定语、状语；用于人的境遇"},{"id":42752,"word":"身无寸铁","pinyin":"shēn wú cùn tiě","abbr":"swct","explanation":"身边没有武器。指赤手空拳。","source":{"text":"庑下预伏壮士，突然杀出，将二人砍为数段。虽有从人，身无寸铁，一时毕命。","book":"《东周列国志》第十五回"},"example":{"text":"曾朴《孽海花》第33回：“当时照例搜检了一通，真的～。”"},"similar":["赤手空拳","手无寸铁"],"usage":"作谓语、定语、状语；用于人的境遇"},{"id":42753,"word":"身无择行","pinyin":"shēn wú zé xíng","abbr":"swzx","explanation":"指一身行为遵循法则而无其它选择。","source":{"text":"是故非法不言，非道不行，口无择言，身无择行。","book":"《孝经·卿大夫》"},"usage":"作谓语、定语；用于书面语"},{"id":42754,"word":"身无立锥","pinyin":"shēn wú lì zhuī","abbr":"swlz","explanation":"形容没有容身之地。","source":{"text":"备之命窘，累及诸君。今日身无立锥，诚恐有误诸君。君等何不弃备而投明主，以取功名乎？","book":"《三国演义》第三一回"},"usage":"作谓语、定语；指没有寸土可以容身"},{"id":42755,"word":"身无长处","pinyin":"shēn wú cháng chù","abbr":"swcc","explanation":"除一身之外再没有多余的东西。原指生活俭朴。现形容贫穷。","source":{"text":"（王恭）对曰：‘ 丈人不悉恭，恭作人无长物。’","book":"南朝宋·刘义庆《世说新语·德行》"}},{"id":42756,"word":"身无长物","pinyin":"shēn wú zhàng wù","abbr":"swcw","explanation":"除自身外再没有多余的东西。形容贫穷。","source":{"text":"对曰：‘ 丈人不悉恭，恭作人无长物。’","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"这些逃难人虽则～，因为一到惠阳就逢到数十年来从未有过的冷。","book":"茅盾《归途杂拾·韩江船》"},"similar":["别无长物","一无长物"],"opposite":["绰有余裕","丰衣足食"],"usage":"作谓语；形容贫寒","story":["东晋时期，王恭生活俭朴，他随父亲从会稽来到都城建康，朋友王忱去看望他，两人相谈甚欢，王忱觉得身下的竹席很好，王恭就转手相送，自己改用草席。王忱得知后过意不去，王恭说：“丈人不悉恭，恭作人无长物。”"]},{"id":42757,"word":"身显名扬","pinyin":"shēn xiǎn míng yáng","abbr":"sxmy","explanation":"身世显赫，声名远扬。","source":{"text":"兄弟，所喜者志得意满，身显名扬；所悲者，家园荡废，琴瑟凄凉。","book":"元·施惠《幽闺记·推就红丝》"},"example":{"text":"地煞与天罡，一个个英豪爽朗，几年间逆天啸聚，甚时～。","book":"明·沈璟《义侠记·振旅》"},"usage":"作谓语、定语；用于书面语"},{"id":42758,"word":"身死名辱","pinyin":"shēn sǐ míng rǔ","abbr":"ssmr","explanation":"人死了还受到羞辱。","source":{"text":"但当以郑忽标题，专写三折，而末折证以鲁桓之求援，而反致身死名辱。","book":"清·夏敬渠《野叟曝言》第七十六回"},"usage":"作谓语、定语；用于人的境遇"},{"id":42759,"word":"身经百战","pinyin":"shēn jīng bǎi zhàn","abbr":"sjbz","explanation":"亲身经历过很多次战斗。比喻况历多，经验丰富。","source":{"text":"且群臣或从陛下岁久，身经百战，所得不过一州。","book":"《资志通鉴·后唐纪·庄宗同光三年》"},"example":{"text":"方才要说的，正是梁朝中一员虎将，姓葛名周，生来胸襟海阔，志量山高；力敌万夫，～。","book":"明·冯梦龙《喻世明言》卷六"},"similar":["出生入死","枪林弹雨"],"opposite":["坐而论道","纸上谈兵","初出茅庐"],"usage":"作谓语、定语；指经验丰富"},{"id":42760,"word":"身自为之","pinyin":"shēn zì wéi zhī","abbr":"szwz","explanation":"亲自去做到它。","source":{"text":"那奚落他的人，昔日肆口乱道诽谤之言，至今日一一身自为之。","book":"清·褚人获《隋唐演义》第八十二回"},"usage":"作谓语、定语；用于处事等"},{"id":42761,"word":"身败名裂","pinyin":"shēn bài míng liè","abbr":"sbml","explanation":"身：身分，地位；败：毁坏；裂：破损。地位丧失，名誉扫地。指做坏事而遭到彻底失败。","source":{"text":"将军百战身名裂，向河梁，回头万里，故人长绝。","book":"宋·辛弃疾《贺新郎·别茂嘉十二弟》词"},"example":{"text":"家里破产了——我父亲因为地权的事打了官司，闹得～。","book":"杨沫《青春之歌》第一部第二章"},"similar":["声名狼藉","臭名远扬","身废名裂"],"opposite":["名满天下","流芳百世"],"usage":"作谓语、定语、状语；指彻底失败"},{"id":42762,"word":"身败名隳","pinyin":"shēn bài míng huī","abbr":"sbmh","explanation":"指做坏事而遭到彻底失败。同“身败名裂”。","source":{"text":"否则浪得虚名，毕竟才无足取，甚而至于弄得身败名隳的都有。","book":"《儿妇英雄传》第三二回"},"similar":["身败名裂","身废名裂"],"usage":"作谓语、定语、状语；指彻底失败"},{"id":42763,"word":"身贫如洗","pinyin":"shēn pín rú xǐ","abbr":"sprx","explanation":"穷得像死过似的，一无所有。","source":{"text":"如今梁鸿学成满腹文章，争奈身贫如洗，沿门题笔为生。","book":"元·无名氏《举案齐眉》第一折"},"similar":["一贫如洗"],"opposite":["腰缠万贯"],"usage":"作谓语、定语、状语；形容极其贫穷"},{"id":42764,"word":"身轻体健","pinyin":"shēn qīng tǐ jiàn","abbr":"sqtj","explanation":"身体健壮，行动灵活。","source":{"text":"沿路上身轻体健，这搭儿筋乏力软。","book":"元·无名氏《货郎旦》第三折"},"example":{"text":"你有何仙方妙术，保养的这等～。","book":"明·无名氏《黄眉翁》第三折"},"usage":"作谓语、定语；用于人"},{"id":42765,"word":"身轻言微","pinyin":"shēn qīng yán wēi","abbr":"sqyw","explanation":"身轻：身价低下，地位低；微：任用小。地位低下者说的话不为人所重视。","source":{"text":"臣前后七表言，故合浦太守孟尝，而身轻言微，终不蒙察。","book":"南朝·宋·范晔《后汉书·孟尝传》"},"example":{"text":"请听听我们这些～的忠告。"},"similar":["人微言轻"],"opposite":["一言千金"],"usage":"作谓语、宾语、定语；指地位低下者的话","story":["东汉时期，浙江会稽上虞户曹孟尝发现一件冤案报告新任太守，太守为之平反昭雪，让孟尝的名声大增。后来孟尝当上了合浦太守，尚书杨乔发现他是人才，先后7次向皇帝推荐，汉桓帝因为他身轻言微而没有重视。孟尝就辞官归隐"]},{"id":42766,"word":"身远心近","pinyin":"shēn yuǎn xīn jìn","abbr":"syxj","explanation":"指身体相隔虽远，但是双方的心却贴得很近。","source":{"text":"羽族之长，名为凤凰。一日失雄，三年感伤。虽有众鸟，不为匹双，故见鄙姿，逢君辉光，身远心近，何当暂忘。","book":"晋·干宝《搜神记》卷十六"},"similar":["身遥心迩"],"usage":"作谓语、定语；用于书面语"},{"id":42767,"word":"身退功成","pinyin":"shēn tuì gōng chéng","abbr":"stgc","explanation":"指功业成就，退隐家园。","source":{"text":"人生则陷身，身退功成，遂结婴，尚未可，何况空废弃。","book":"《云笈七签》卷五六"},"example":{"text":"宋·张君房《云笈七签》第56卷：“人生则陷身，～，遂结婴，尚未可，何况空废弃。”"},"similar":["功成身退"],"usage":"作谓语、定语；用于处事"},{"id":42768,"word":"身遥心迩","pinyin":"shēn yáo xīn ěr","abbr":"syxe","explanation":"犹言身远心近。指身体相隔虽远，但是双方的心却贴得很近。","source":{"text":"小生身遥心迩，恨不鹣鹣比翼，邛邛并躯。","book":"元·王德信《北西厢记·泥金报捷》"},"similar":["身远心近"],"usage":"作谓语、定语；用于书面语"},{"id":42769,"word":"身镜体牖","pinyin":"shēn jìng tǐ yǒu","abbr":"sjty","explanation":"身镜：指眼睛；体牖：指耳朵。身体上的镜子和窗户。比喻眼睛和耳朵。","source":{"text":"眼者身之镜，耳者体之牖，视众则镜昏，听众则牖闭","book":"宋·叶廷珪《海录碎事·人事·形相》"}},{"id":42770,"word":"身非木石","pinyin":"shēn fēi mù shí","abbr":"sfms","explanation":"指自身并不是毫无感情的人。","source":{"text":"身非木石，独与法吏为伍，深幽囹圄之中，谁可告诉者。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"～，与狱吏为伍，此少卿所以仰天捶心，泣尽而继之以血者也。","book":"南朝·梁·江淹《狱中上建平王书》"},"similar":["人非木石"],"usage":"作宾语、分句；常与“孰能无情”连用","story":["西汉时期，著名的史学家司马迁因汉将李陵攻打匈奴失败被迫投降一事，为李陵说了情，遭到了宫刑并被关入大牢，面对这奇耻大辱，他只好给好友任安写信倾诉他的不幸：“身非木石，独与法吏为伍，深幽囹圄之中，谁可告诉者？”"]},{"id":42771,"word":"身首分离","pinyin":"shēn shǒu fēn lí","abbr":"ssfl","explanation":"指斩首。","source":{"text":"本国残，社稷坏……首身分离，暴骨草泽。","book":"语出《战国策·秦策四》"},"example":{"text":"臣以为艾～，捐弃草土，宜收尸丧，还其田宅。","book":"《三国志·魏志·邓艾传》"},"similar":["首身分离","身首异处"],"usage":"作谓语、定语、宾语；指被砍头","story":["战国时期，秦军进攻魏国，魏国仓皇应战，上郡之战杀得血肉横飞、尸横遍野，3万魏军全部战死。秦军占领了上郡，把村庄洗劫一空，老百姓被掳走，秦国不断侵略六国，制造无数惨案。春申君评价为：“首身分离，暴骨草泽，头颅僵仆。”"]},{"id":42772,"word":"身首异地","pinyin":"shēn shǒu yì dì","abbr":"ssyd","explanation":"指被杀头。同“身首异处”。","source":{"text":"丑类敢越雷池，小心身首异地。","book":"《天安门诗抄·警告丑类》"},"similar":["身首异处","身首分离"],"usage":"作谓语、定语；指被杀头"},{"id":42773,"word":"身首异处","pinyin":"shēn shǒu yì chù","abbr":"ssyc","explanation":"首：头；异：不同；处：地方。指被杀头。","source":{"text":"假使获罪于天，身首异处，盖如一蝼蚁尔，亦何足可称？","book":"唐·陈子昂《申宗人冤狱书》"},"example":{"text":"我自正位东宫，并无失德，纵有过恶，不过贬谪，也不致～。","book":"明·许仲琳《封神演义》第九回"},"similar":["身首分离","身首异地"],"usage":"作谓语、定语；指被杀头"},{"id":42774,"word":"躬体力行","pinyin":"gōng tǐ lì xíng","abbr":"gtlx","explanation":"躬体：亲身体验；力行：努力实行。亲身体验，努力实行。","source":{"text":"更应该以身作则，躬体力行，加倍的奋勉，然后才能够完成自己的任务。","book":"郭沫若《文化人当前的急务》"},"example":{"text":"我们要～，努力实行自己的理想。"},"similar":["身体力行"],"usage":"作谓语；指亲身体验，努力实行"},{"id":42775,"word":"躬先士卒","pinyin":"gōng xiān shì zú","abbr":"gxsz","explanation":"犹身先士卒。现用来比喻领导带头，走在群众前面。","source":{"text":"誓将首冒锋刀，躬先士卒，上假神兵之威，下定鬼方之罪。","book":"唐·张说《为河内郡王武懿宗平冀州贼契丹等露布》"},"similar":["身先士卒"],"usage":"作谓语、定语；指带头"},{"id":42776,"word":"躬先表率","pinyin":"gōng xiān biǎo shuài","abbr":"gxbs","explanation":"表率：榜样。自身先做出榜样。","source":{"text":"尔等不能端本澂源，躬先表率而望秉铎司教之官，家喻户晓，易俗移风。","book":"《清史稿·刘师恕传》"},"similar":["躬先士卒","身先士卒"],"usage":"作谓语；用于为人"},{"id":42777,"word":"躬冒矢石","pinyin":"gōng mào shǐ shí","abbr":"gmss","explanation":"指将帅亲临前线，冒着敌人的箭矢礧石，不怕牺牲自己。同“躬蹈矢石”。","source":{"text":"诚以摧锋陷城躬冒矢石，本诸将士之力，固非坐而指画者所可同也。","book":"明·张居正《辽东大捷辞恩疏》"},"example":{"text":"文天祥～，毫不畏惧"},"similar":["躬蹈矢石","亲冒矢石"],"usage":"作谓语、定语；指人很勇敢"},{"id":42778,"word":"躬操井臼","pinyin":"gōng cāo jǐng jiù","abbr":"gcjj","explanation":"躬：亲自；操：从事；井臼：汲水舂米，泛指家务劳动。亲自操持家务。","source":{"text":"汉·刘向《列女传·周南妻传》：“家贫亲老，不择官而仕，亲操井臼。"},"example":{"text":"年二十余，始于归，～，琴瑟甚调。","book":"清·淮阴百一居士《壶天录》卷上"},"similar":["井臼躬操","身操井臼"],"usage":"作谓语、定语、宾语；指亲为"},{"id":42779,"word":"躬擐甲胄","pinyin":"gōng huàn jiǎ zhòu","abbr":"ghjz","explanation":"指亲自穿上铠甲和头盔。言长官坐镇军中亲自指挥。","source":{"text":"文公（晋文公）躬擐甲胄，跋履山川，逾越险阻，征东之诸侯。","book":"《左传·成公十三年》"},"example":{"text":"既而王～，吐诚师旅，誓在尽尽敌，以报前雠。","book":"唐·张说《论神兵军大总管功状》"},"usage":"作谓语；用于战争等"},{"id":42780,"word":"躬耕乐道","pinyin":"gōng gēng lè dào","abbr":"ggld","explanation":"躬：亲自；道：圣贤之道。亲自耕种，乐于信守圣贤之道。指过隐居生活。","source":{"text":"[胡]昭乃转居浑山中，躬耕乐道，以以经籍自娱。","book":"《三国志·魏书·袁张涼国田王邴管传》"},"example":{"text":"隐于田里，～，教育二子。","book":"明·冯梦龙《醒世恒言》卷十七"},"usage":"作谓语、定语；指过隐居生活"},{"id":42781,"word":"躬自厚而薄责于人","pinyin":"gōng zì hòu ér bó zé yú rén","abbr":"gzhebzyr","explanation":"躬自：自己；薄：少。对自己严格要求，对他人不苛刻要求。","source":{"text":"躬自厚而薄责于人，则远怨矣。","book":"《论语·卫灵公》"},"example":{"text":"～，吾何暇计外洋之欺凌我、虔刘我哉？责己而已矣。","book":"清·谭嗣同《报贝元征》"},"usage":"作谓语、宾语；用于处世"},{"id":42782,"word":"躬自菲薄","pinyin":"gōng zì fěi bó","abbr":"gzfb","explanation":"指亲身实行俭约。菲薄；微薄。","source":{"text":"躬自菲薄，谓俭约。","book":"《文选·张衡〈东京赋〉》：“文（汉文帝）又躬自菲薄，治致升平之德。”薛综注"},"example":{"text":"陛下昧旦临朝，无懈治道，～，劳心民庶。","book":"南朝·宋·范泰《早灾未已加以疾疫又上表》"},"usage":"作谓语、定语；指人很节约"},{"id":42783,"word":"躬行实践","pinyin":"gōng xíng shí jiàn","abbr":"gxsj","explanation":"亲身实行或体验。","source":{"text":"躬行实践，乡人化之。","book":"元·王恽《秋涧全集·紫山先生易直解序》：“欲见诸用者，不于先觉躬行践履之实迹而取法焉，未见能造其窔奥也。”明·焦竑《玉堂丛语·行谊》"},"example":{"text":"诏嘉勉，谕以～，勿骛虚名。","book":"《清史稿·陈瑸传》"},"similar":["亲历亲为"],"usage":"作谓语、宾语；指亲身实行或体验"},{"id":42784,"word":"躬行节俭","pinyin":"gōng xíng jié jiǎn","abbr":"gxjj","explanation":"躬行：亲自践行。亲自做到节约勤俭。","source":{"text":"师受《诗》、《论语》、《孝经》、躬行节俭，慈仁爱人。","book":"东汉·班固《汉书·霍光传》"},"example":{"text":"望陛下绝无益之费，～，为中外倡。","book":"《明史·刘健传》"},"usage":"作谓语；指亲自做到节约"},{"id":42785,"word":"躬蹈矢石","pinyin":"gōng dǎo shǐ shí","abbr":"gdss","explanation":"指将帅亲临前线，冒着敌人的箭矢礧石，不怕牺牲自己。","source":{"text":"卿在郡以来，擒奸讨暴，百姓获安，躬蹈矢石，年征辄克。","book":"三国·魏·曹操《褒扬泰山太守吕虔令》"},"similar":["躬冒矢石","亲冒矢石"],"usage":"作谓语、定语；指人很勇敢"},{"id":42786,"word":"躬逢其盛","pinyin":"gōng féng qí shèng","abbr":"gfqs","explanation":"亲身经历那种盛况。","source":{"text":"童子何知，躬逢胜饯。","book":"唐·王勃《滕王阁序》"},"example":{"text":"妹子素日虽有好茶之癖，可惜前者未得～，至今犹觉耿耿。","book":"清·李汝珍《镜花缘》第九十回"},"similar":["恭逢其盛"],"usage":"作谓语；指亲身经历那种盛况"},{"id":42787,"word":"躬逢盛事","pinyin":"gōng féng shèng shì","abbr":"gfss","explanation":"躬：亲自；逢：遇；盛：盛会。亲身经历那种盛况。","source":{"text":"童子何知，躬逢胜饯。","book":"唐·王勃《滕王阁序》"},"example":{"text":"～，岂可当面错过。","book":"清·文康《儿女英雄传》第三十八回"},"similar":["躬逢其盛"],"usage":"作谓语；指亲身经历那种盛况"},{"id":42788,"word":"躭惊受怕","pinyin":"dān jīng shòu pà","abbr":"djsp","explanation":"犹言担受惊吓。","source":{"text":"受官差在旅途，躭惊受怕过朝暮，受了五十四站风波苦。","book":"元·刘致《端正好·上高监司》套曲"},"example":{"text":"休听那算命的胡说，撇了海阔一个家业，～，去虎穴龙潭里做买卖！","book":"《水浒传》第六一回"}},{"id":42789,"word":"躲得和尚躲不得寺","pinyin":"duǒ dé hé shàng duǒ bù dé sì","abbr":"ddhsdbds","explanation":"寺：寺庙。指躲避一时，但终究不能根本逃避。","source":{"text":"你不愿慌，‘躲得和尚躲不得寺’。我自然有个料理。","book":"清·吴敬梓《儒林外史》第54回"},"similar":["躲过初一，躲不过十五"],"usage":"作宾语、定语；用于口语"},{"id":42790,"word":"躲灾避难","pinyin":"duǒ zāi bì nàn","abbr":"dzbn","explanation":"躲：逃避；避：避开。闪躲与逃避灾难。","source":{"text":"今日权且去沧州躲灾避难，早晚天可怜见，放你回来时，依旧夫妻完聚。","book":"明·施耐庵《水浒传》第八回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":42791,"word":"躲躲藏藏","pinyin":"duǒ duǒ cáng cáng","abbr":"ddcc","explanation":"躲：避开，隐藏。指遮遮掩掩，不敢正面面对。","source":{"text":"那小芸二爷也有些鬼鬼头头的。什么时候又要看人，什么时候又躲躲藏藏的，可知也是个心术不正的货。","book":"清·曹雪芹《红楼梦》第85回"},"example":{"text":"清·李汝珍《镜花缘》第二回：“～，贼头贼脑，任他装出斯文的样子，终失不了偷油的身分。”"},"similar":["躲躲闪闪","遮遮掩掩"],"usage":"作谓语、宾语、状语、定语；用于口语"},{"id":42792,"word":"躲躲闪闪","pinyin":"duǒ duǒ shǎn shǎn","abbr":"ddss","explanation":"躲避闪开，以免遇到某些情况。亦形容遮遮盖盖，支支吾吾，不坦率，不直爽。","source":{"text":"三人于是躲躲闪闪，联步而行。一面走著，看那国人都是端方大雅；再看自己，只觉无穷丑态。","book":"清·李汝珍《镜花缘》第十九回"},"example":{"text":"这一点事，也值得你～老半天总不肯说。","book":"茅盾《霜叶红似二月花》六"},"similar":["遮遮掩掩"],"opposite":["堂堂正正"],"usage":"作谓语、宾语；指不敢正面面对"},{"id":42793,"word":"躲过初一，躲不过十五","pinyin":"duǒ guò chū yī，duǒ bù guò shí wǔ","abbr":"dgcydbgsw","explanation":"指躲避一时，但终究不能根本逃避。","example":{"text":"俗话说：～，看你往哪逃。"},"similar":["躲得和尚躲不得寺"],"usage":"作宾语、定语；用于口语"},{"id":42794,"word":"輶轩之使","pinyin":"yóu xuān zhī shǐ","abbr":"yxzs","explanation":"輶轩：轻车，多由使臣乘坐。指出使的大臣。","source":{"text":"周、秦常以岁几月，輶轩之使，求异代方言。","book":"汉·应劭《风俗通义·序》"},"example":{"text":"先王声教，书必同文，～，纪言殊俗，所以一字体，总异音。","book":"南朝·梁·刘勰《文心雕龙·练字》"},"usage":"作宾语；用于书面语"},{"id":42795,"word":"輷輷殷殷","pinyin":"hōng hōng yīn yīn","abbr":"hhyy","explanation":"輷輷；象声词，同“轰轰”，指声势浩大；殷殷：震动声。形容人马众多，声势浩大。","source":{"text":"人民之众，车马之多，日夜行不绝，輷輷殷殷，若有三军之众。","book":"西汉·司马迁《史记·苏秦列传》"},"usage":"作定语；用于书面语"},{"id":42796,"word":"车击舟连","pinyin":"chē jī zhōu lián","abbr":"cjzl","explanation":"车相撞，船相连。极言车船之多。","source":{"text":"君以试大理评事佐荆南两税使，督食饶给，车击舟连。","book":"唐·柳宗元《故岭南盐铁院李侍御墓志》"},"usage":"作谓语、定语；形容车船多"},{"id":42797,"word":"车到山前必有路","pinyin":"chē dào shān qián bì yǒu lù","abbr":"cdsqbyl","explanation":"比喻事到临头，自然会有解决的办法。常用以宽慰处于困境中的人。","source":{"text":"车到山前必有路——到时再说吧，反正现在苦恼也无济于事。","book":"路遥《平凡的世界》第四卷第40章"},"example":{"text":"～，我们自有解决的办法。"},"similar":["船过桥门自然直"],"usage":"作宾语、分句；用于安慰"},{"id":42798,"word":"车同轨，书同文","pinyin":"chē tóng guǐ，shū tóng wén","abbr":"ctgstw","explanation":"同文：全国所用的文字相同；同轨：全国车辙阔狭相同。统一文字，统一车辙。比喻国家统一。","source":{"text":"今天下，车同轨，书同文，行同伦。","book":"《礼记·中庸》"}},{"id":42799,"word":"车在马前","pinyin":"chē zài mǎ qián","abbr":"czmq","explanation":"大马拖车在前，马驹系在车后，这样，可使小马慢慢地学拉车。比喻学习任何事物，只要有人指导，就容易学会。","source":{"text":"始驾马者反之，车在马前。","book":"西汉·戴圣《礼记·学记》"},"example":{"text":"我们干任何工作都有“～”的过程。"},"usage":"作宾语、定语；指见习"},{"id":42800,"word":"车填马隘","pinyin":"chē tián mǎ ài","abbr":"ctma","explanation":"指车马填塞门庭道路。形容宾客众多。","source":{"text":"棨戟门前，平沙堤上，何事车填马隘？","book":"明·高明《琵琶记·牛相教女》"},"similar":["车水马龙"],"opposite":["门可罗雀"],"usage":"作谓语、宾语、定语；用于热闹场面"},{"id":42801,"word":"车如流水马如龙","pinyin":"chē rú liú shuǐ mǎ rú lóng","abbr":"crlsmrl","explanation":"车像流水，马像游龙。形容车马往来不绝，繁华热闹的景象。","source":{"text":"前过濯龙门上，见外家问起居者，车如流水，马如游龙。","book":"南朝·宋·范晔《后汉书·明德马皇后纪》"},"example":{"text":"端的是走轮飞鞚，～。","book":"元·王实甫《丽春堂》第一折"},"similar":["车水马龙","车马如龙"],"usage":"作宾语、定语；形容繁华热闹的景象","story":["东汉章帝刘炟即位后，封其父王明帝刘庄的皇后马氏为太后。马太后亲自撰写《显宗起居注》，丝毫不提及父亲马援及兄长马防的功劳，还要章帝不要听信大臣的给马家封侯的建议，说：“我回家看他们门前车水马龙的，不能再封了。”"]},{"id":42802,"word":"车尘马足","pinyin":"chē chén mǎ zú","abbr":"ccmz","explanation":"①指车马奔波。亦喻人世俗事。②指代车骑。敬称对方时亦用之。","source":{"text":"奔走骇汗，羞愧俯伏，以自悔罪于车尘马足之间。","book":"宋·欧阳修《相州昼锦堂记》"},"example":{"text":"一旦别去，何时复望～邪？","book":"宋·洪迈《容斋续笔·李林甫秦桧》"},"usage":"作宾语、定语；用于书面语"},{"id":42803,"word":"车尘马迹","pinyin":"chē zhén mǎ jì","abbr":"ccmj","explanation":"指车马行过的痕迹。","source":{"text":"余既惜其出于荒堙废壤之余，而又幸其深阻敻绝，非车尘马迹之所能到。","book":"宋·朱熹《卧龙庵记》"},"example":{"text":"清·李百川《绿野仙踪》第65回：“放眼一望，见牌坊前面，～，士女纷纷行走。”"},"similar":["车辙马迹","蛛丝马迹"],"usage":"作宾语、定语；指痕迹"},{"id":42804,"word":"车怠马烦","pinyin":"chē dài mǎ fán","abbr":"cdmf","explanation":"车危且马疲。形容旅途困乏。怠：通“殆”。同“车殆马烦”。","source":{"text":"车怠马烦客忘归，兰膏明烛承夜辉。","book":"南朝·宋·鲍照《代白紵舞歌词》之一"},"similar":["车殆马烦"],"usage":"作谓语、定语；形容旅途困乏"},{"id":42805,"word":"车攻马同","pinyin":"chē gōng mǎ tóng","abbr":"cgmt","explanation":"攻：坚固，精致；同：齐聚。车子坚固精致，马又齐整雄壮。比喻军容之盛。","source":{"text":"我车既攻，我马既同。","book":"《诗经·小雅·车攻》"},"example":{"text":"～，教达戒通。","book":"汉·马融《广成颂》"},"usage":"作宾语、定语；用于军事"},{"id":42806,"word":"车无退表","pinyin":"chē wú tuì biǎo","abbr":"cwtb","explanation":"兵车无后退的标志。引申为军队决不退却。","source":{"text":"张侯御曰：‘三军之心在此车也，其耳目在于旗鼓。车无退表，鼓无退声。’","book":"《国语·晋语上》"},"example":{"text":"面对强敌的威胁，三军将士庄严得向军旗宣誓：“为了国家和民族的尊严，我全军将士～，严阵以待。”"},"similar":["决不后退","勇往直前"],"opposite":["临阵退缩"],"usage":"作宾语；指决不退却"},{"id":42807,"word":"车殆马烦","pinyin":"chē dài mǎ fán","abbr":"cdmf","explanation":"殆：通“怠”，疲乏；烦：烦躁。形容旅途劳顿。","source":{"text":"日既西倾，车殆马烦。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"至黄昏乃归，～，不胜困惫。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"similar":["车怠马烦"],"usage":"作谓语、定语；形容旅途困乏"},{"id":42808,"word":"车水马龙","pinyin":"chē shuǐ mǎ lóng","abbr":"csml","explanation":"车象流水，马象游龙。形容来往车马很多，连续不断的热闹情景。","source":{"text":"前过濯龙门上，见外家问起居者，车如流水，马如游龙。","book":"《后汉书·明德马皇后纪》"},"example":{"text":"花天酒地，闹个不休，～，日无暇晷。","book":"清·吴趼人《二十年目睹之怪现状》第一回"},"similar":["门庭若市","络绎不绝"],"opposite":["门可罗雀","门庭冷落"],"usage":"作谓语、定语；形容繁华热闹的景象","story":["东汉章帝刘炟即位后，封其父王明帝刘庄的皇后马氏为太后。马太后亲自撰写《显宗起居注》，丝毫不提及父亲马援及兄长马防的功劳，还要章帝不要听信大臣的给马家封侯的建议，说：“我回家看他们门前车水马龙的，不能再封了。”"]},{"id":42809,"word":"车烦马毙","pinyin":"chē fán mǎ bì","abbr":"cfmb","explanation":"形容旅途劳顿困乏。","source":{"text":"你看白日西弛，黄河东逝，车烦马毙，前驱不行，不免在此假宿一宵，多少是好。","book":"明·汪道昆《洛水悲》"},"similar":["车殆马烦"],"usage":"作谓语、定语；用于旅途辛劳"},{"id":42810,"word":"车笠之盟","pinyin":"chē lì zhī méng","abbr":"clzm","explanation":"笠：斗笠。比喻不因为富贵而改变贫贱之交。","source":{"text":"君乘车，我戴笠，他日相逢下车揖；丁君担簦，我跨马，他日相逢为君下。","book":"南宋·郭茂倩《乐府诗集·越谣歌》"},"example":{"text":"我们有～。"},"similar":["戴笠乘车"],"usage":"作宾语；指友好交往","story":["传说古代苏越一带风俗淳朴，凡初次同人交往，就封土坛，拿出鸡犬等作为祭品，向天祷告说：“卿虽乘车我戴笠，后日相逢下车揖；我步行，君乘马，他日相逢君当下。”希望以后再次见面时不分地位变化，还是不望这贫贱之交"]},{"id":42811,"word":"车轨共文","pinyin":"chē guǐ gòng wén","abbr":"cggw","explanation":"文；文字。车轨统一，文字一致。比喻统一一致。","source":{"text":"今天下车同轨，书同文。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"执珪柱国，尚不轻授，况～，四溟同宅。","book":"南朝·梁·江淹《萧骠骑让封表》"},"similar":["同文共轨","车同轨，书共文"],"usage":"作宾语、定语；用于政局"},{"id":42812,"word":"车轮战","pinyin":"chē lún zhàn","abbr":"clz","explanation":"用比对方多的人轮流跟对方打，使对方因疲乏而失败。","source":{"text":"只要他一踏上中国领土，就把他扣下，由我们的武士轮番上阵，跟他玩车轮战，直到打瘫为止。","book":"王朔《千万别把我当人》"},"example":{"text":"我们要防止敌人采用～的战术来拖垮我们。"},"usage":"作宾语、定语；用于战斗等"},{"id":42813,"word":"车载斗量","pinyin":"chē zài dǒu liáng","abbr":"czdl","explanation":"载：装载。用车载，用斗量。形容数量很多，不足为奇。","source":{"text":"如臣之比，车载斗量，不可胜数。","book":"《三国志·吴志·孙权传》：“遣都尉赵咨使魏。”裴松之注引《吴书》"},"example":{"text":"举人、进士、我和表兄两家～，也不是什么出奇的东西。","book":"清·吴敬梓《儒林外史》第四十六回"},"similar":["不可胜数","不计其数"],"opposite":["凤毛麟角","寥若晨星","屈指可数"],"usage":"作谓语、定语；表示事物数量很多","story":["三国时期蜀主刘备出兵伐吴，吴主孙权派中大夫赵咨出使魏国，向魏文帝曹丕求援。曹丕傲慢地侮辱他，赵咨十分巧妙地回敬曹丕，使曹丕十分佩服他的才能，问他东吴像他这样的人才多不多，他回答说可以车载斗量"]},{"id":42814,"word":"车载船装","pinyin":"chē zǎi chuán zhuāng","abbr":"czcz","explanation":"形容数量很多。","source":{"text":"‘啊呀！’瞎眼舅爷大吃一惊，‘你小子打发出这号话？你娘母子的票子，车载船装哩？’","book":"柳青《创业史》第一部第十八章"},"similar":["车载斗量"],"usage":"作谓语、定语；表示事物数量很多"},{"id":42815,"word":"车辖铁尽","pinyin":"chē xiá tiě jìn","abbr":"cxtj","explanation":"把铁销子都磨光了。形容旅途遥远。","source":{"text":"晋·崔豹《古今注·舆服第一》载：越裳氏来进贡，找不到回去的路，周公用指南车把使者送回国，等到回来时，车辖都磨光了。"}},{"id":42816,"word":"车辙马迹","pinyin":"chē zhé mǎ jì","abbr":"czmj","explanation":"指车马行过的痕迹。","source":{"text":"昔穆王欲肆其心，周行天下，将皆必有车辙马迹焉。","book":"《左传·昭公十二年》"},"example":{"text":"飘风冻雨，聊窃比于先驱；～，遂周行于天下。","book":"《旧唐书·李密传》"},"similar":["车尘马迹"],"usage":"作宾语、定语；指留下的痕迹","story":["春秋时期，楚王冬猎，右尹子革与楚王论国事。楚王想要去向周朝要封鼎同时想进攻郑国，大夫仆析父担心楚王无理要求遭到失败，要子革进行劝说。子革举出当年周穆王听从祭公谋父劝谏他不要到各地去留下车辙马迹避免篡位的例子劝阻楚王"]},{"id":42817,"word":"车过腹痛","pinyin":"chē guò fù tòng","abbr":"cgft","explanation":"原指经过朋友的坟墓如不祭奠，走过去肚子就会痛起来。用来表示对亡友的悼念。","source":{"text":"昔曹孟德祭桥公文，有车过腹痛之语，而予亦载与可畴昔戏笑之言者，以见与可于予亲厚无间如此也。","book":"宋·苏轼《筼筜谷偃竹记》"}},{"id":42818,"word":"车量斗数","pinyin":"chē liáng dǒu shǔ","abbr":"clds","explanation":"用车载，用斗量。形容数量很多，不足为奇。","source":{"text":"这真是……车量斗数的功德，为什么倒无人肯做呢？","book":"清·秋瑾《精卫石》第一回"},"similar":["车载斗量"],"opposite":["寥寥无几"],"usage":"作谓语、定语；表示事物数量很多"},{"id":42819,"word":"车马填门","pinyin":"chē mǎ tián mén","abbr":"cmtm","explanation":"车子充满门庭，比喻宾客很多。同“车马盈门”。","source":{"text":"是故馀人摄选，车马填门；及臣居边，宾游罕至。","book":"《北史·拓跋深传》"},"example":{"text":"这里接连着亲戚族中的人来来去去，闹闹穰穰，～，貂蝉满座。","book":"清·曹雪芹《红楼梦》第八十五回"},"similar":["车马盈门"],"usage":"作宾语、补语；形容宾客很多"},{"id":42820,"word":"车马如龙","pinyin":"chē mǎ rú lóng","abbr":"cmrl","explanation":"车马像游龙。形容车马往来不绝，繁华热闹的景象。","source":{"text":"风烟匝地，车马如龙。","book":"唐·王勃《还冀州别洛下知己序》"},"example":{"text":"这里有的是～，士女如云。","book":"蒋光慈《鸭绿江上·兄弟夜话》"},"similar":["车水马龙"],"usage":"作宾语、定语；形容繁华热闹的景象"},{"id":42821,"word":"车马盈门","pinyin":"chē mǎ yíng mén","abbr":"cmym","explanation":"车子充满门庭，比喻宾客很多。","source":{"text":"但得个车马盈门，这便是钱龙人家。","book":"元·马致远《青衫泪》第四折"},"example":{"text":"从前黄道台才过班的时候，那一天不是～，还有多少人要见不得见。","book":"清·李宝嘉《官场现形记》第四回"},"similar":["宾客盈门","车马填门"],"opposite":["门可罗雀"],"usage":"作宾语、补语；形容宾客很多"},{"id":42822,"word":"车马辐辏","pinyin":"chē mǎ fú còu","abbr":"cmfc","explanation":"辐辏：形容人或货物像车轮上的辐条聚集在车毂上一样。指车马集聚拥挤。","source":{"text":"两旁歧途曲巷中，有无数的车马辐辏，冠盖飞扬，人往人来，十分热闹。","book":"清·文康《儿女英雄传》缘起首回"},"similar":["车马骈阗"],"usage":"作宾语、定语；用于集市等"},{"id":42823,"word":"车马骈阗","pinyin":"chē mǎ pián tián","abbr":"cmpt","explanation":"车马聚集很多。形容非常热闹。","source":{"text":"衣冠杂沓，出城阙面盘游；车马骈阗，俯河滨而帐饮。","book":"唐·杨炯《晦日药园诗序》"},"example":{"text":"游人尽欢，见～往还。","book":"《群英类选·〈八义记·公主赏灯〉》"},"similar":["车马辐辏"],"usage":"作宾语、定语；用于集市等"},{"id":42824,"word":"车驰马骤","pinyin":"chē chí mǎ zhòu","abbr":"ccmz","explanation":"形容车马奔驰迅猛。","source":{"text":"走马灯者，剪纸为轮，以烛嘘之，则车驰马骤，团团不休，烛灭则顿止矣。","book":"清·富察敦崇《燕京岁时记·走马灯》"},"example":{"text":"敌寨不及防备，猛被元兵攻入，～，扫了一个精光。","book":"蔡东藩《元史通俗演义》第五七回"},"usage":"作宾语、定语；用于书面语"},{"id":42825,"word":"车龙马水","pinyin":"chē lóng mǎ shuǐ","abbr":"clms","explanation":"车像流水，马像游龙。形容车马往来不绝，繁华热闹的景象。","source":{"text":"超如笑着，向亭外一望，果然车龙马水。","book":"陆士谔《续孽海花》第33回"},"similar":["车水马龙","车如流水马如龙"],"usage":"作谓语、定语；形容繁华热闹的景象"},{"id":42826,"word":"轨物范世","pinyin":"guī wù fàn shì","abbr":"gwfs","explanation":"谓作事物的规范、世人的榜样。","source":{"text":"魏晋已来所著诸子，理重事复，递相模斅，犹屋下架屋，床上施床耳。吾今所以复为此者，非敢轨物范世也。","book":"北齐颜之推《颜氏训·序致》"},"usage":"作宾语、定语；指标准与榜样"},{"id":42827,"word":"轩冕相袭","pinyin":"xuān miǎn xiāng xí","abbr":"xmxx","explanation":"轩冕：原指古代卿大夫的车服，也指官位爵禄或显贵的人；袭：沿袭。指官位爵禄世代相继。","source":{"text":"自汉至魏，世以文章显，轩冕相袭，为郡盛族。","book":"《晋书·应贞传》"},"usage":"作宾语、定语；用于书面语"},{"id":42828,"word":"轩昂气宇","pinyin":"xuān áng qì yǔ","abbr":"xaqy","explanation":"形容人气度不凡。亦作“气宇轩昂”。","source":{"text":"一个个前撮后拥，看见他呵，是好个轩昂气宇。","book":"明·无名氏《渔樵闲话》第三折"},"similar":["气宇轩昂"],"usage":"作谓语、定语、状语；指人气概不凡"},{"id":42829,"word":"轩昂自若","pinyin":"xuān áng zì ruò","abbr":"xazr","explanation":"轩昂：形容气度不凡。形容人的气度不凡，神态如常。","source":{"text":"中有黄衣半席，轩昂自若，指诸人笑语轻脱。","book":"唐·李濬《松窗杂录·裴休》"},"usage":"作谓语、状语；用于书面语"},{"id":42830,"word":"轩昂魁伟","pinyin":"xuān áng kuí wěi","abbr":"xakw","explanation":"魁伟：魁梧。气宇轩昂，体格壮大。","source":{"text":"宋江看孙安轩昂魁伟，一表非俗，下阶迎接。","book":"明·施耐庵《水浒传》第97回"},"usage":"作谓语、定语；用于人的形貌"},{"id":42831,"word":"轩然大波","pinyin":"xuān rán dà bō","abbr":"xrdb","explanation":"轩然：波涛高高涌起的样子。高高涌起的波涛。比喻大的纠纷或乱子。","source":{"text":"轩然大波起，宇宙隘而妨。","book":"唐·韩愈《岳阳楼别窦司直》诗"},"example":{"text":"没想到这么点小事竟然引起这样一场～。"},"similar":["大吵大闹"],"opposite":["小事一桩"],"usage":"作主语、宾语；指大的纠纷或乱子"},{"id":42832,"word":"轩然霞举","pinyin":"xuān rán xiá jǔ","abbr":"xrxj","explanation":"轩然：高高的样子。象云霞高高飘举。形容人俊美潇洒。","source":{"text":"海西时，诸公每朝，朝堂犹暗；唯令稽王来，轩轩如朝霞举。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"李白名播海内，玄宗见其神气高朗，～，上不觉忘万乘之尊。","book":"宋·王谠《唐语林·文学》"},"similar":["轩轩韶举"],"usage":"作谓语、定语、状语；用于书面语"},{"id":42833,"word":"轩盖如云","pinyin":"xuān gài rú yún","abbr":"xgry","explanation":"轩：古时供官员乘坐的一种便车；盖：车盖。旧时形容官员很多，也形容官员、士绅集会的盛况。","source":{"text":"楼如若画，临故国之城池；轩盖如云，总名都之车马。","book":"唐·陈子昂《冬夜宴临邛李录事宅序》"},"usage":"作宾语、定语；用于书面语"},{"id":42834,"word":"轩裳华胄","pinyin":"xuān cháng huá zhòu","abbr":"xshz","explanation":"轩裳：古代贵族的车服；华胄：显贵的后裔。指贵族世家的子弟。","source":{"text":"二秀才轩裳华胄，金玉奇标，既富春秋，又洁操履。","book":"唐·孙恂《猎狐记》"},"usage":"作宾语、定语；用于书面语"},{"id":42835,"word":"轩輶之使","pinyin":"xuān yóu zhī shǐ","abbr":"xyzs","explanation":"轩輶：轻车，多由使臣乘坐。指出使的大臣。","source":{"text":"周、秦常以岁几月，輶轩之使，求异代方言。","book":"汉·应劭《风俗通义·序》"},"usage":"作主语、宾语；用于书面语"},{"id":42836,"word":"轩车载鹤","pinyin":"xuān chē zài hè","abbr":"xczh","explanation":"轩车：古代一种有帷幕的车。使鹤享有禄位，配以轩车。比喻胡乱封官。也作自谦词。","source":{"text":"卫懿公好鹤，鹤有乘轩者。将战，国人受甲者皆曰：‘使鹤，鹤有禄位，余焉能战。’","book":"《左传·闵公二年》"},"usage":"作宾语、定语；用于书面语","story":["公元前668年，卫惠公的儿子姬赤成为卫懿公后，不思富国强兵之道，整天喜欢养鹤，甚至荒唐到给鹤封官位，享官禄，给鹤配豪华的轩车，百姓怨声载道。北方狄国借机出兵攻打卫国，卫国士兵根本不抵抗就逃散，卫懿公被狄兵所杀"]},{"id":42837,"word":"轩轩甚得","pinyin":"xuān xuān shèn dé","abbr":"xxsd","explanation":"轩轩：洋洋自得的样子。形容非常得意。","source":{"text":"戣自以适所志，轩轩甚得。","book":"《新唐书·孔戣传》"},"similar":["洋洋自得"],"usage":"作谓语、定语；形容非常得意"},{"id":42838,"word":"轩轩韶举","pinyin":"xuān xuān sháo jǔ","abbr":"xxsj","explanation":"仪态轩昂就像朝霞飘举蓝天似的","source":{"text":"林公道王长史，敛衿作一来，何其轩轩韶举。","book":"南朝·宋·刘义庆《世说新语·容止》"},"similar":["轩然霞举"],"usage":"作谓语、定语、状语；用于书面语"},{"id":42839,"word":"轩轾不分","pinyin":"xuān zhì bù fēn","abbr":"xzbf","explanation":"轩轾：古代车子前高后低叫轩，前低后高叫轾。不分高下、轻重。比喻对待二者的态度或看法差不多。","source":{"text":"居前不能令人轾，居后不能令人轩……臣所耻也。","book":"《后汉书·马援传》"},"usage":"作谓语、定语；用于书面语"},{"id":42840,"word":"轩鹤冠猴","pinyin":"xuān hè guàn hóu","abbr":"xhgh","explanation":"乘轩之鹤，戴帽之猴。比喻滥厕禄位、虚有其表的人。","source":{"text":"池鱼幕燕依栖浅，轩鹤冠猴宠渥新。","book":"明·刘基《驿传杭台消息石末公有诗见寄次韵奉和并寓悲感》之一"},"usage":"作宾语、定语；用于比喻句"},{"id":42841,"word":"转于沟壑","pinyin":"zhuān yú gōu hè","abbr":"zygh","explanation":"壑：山沟。指死在山沟里。","source":{"text":"凶年饥岁，子之民，老羸转于沟壑，壮者散而之四方者，几午人矣。","book":"《孟子·公孙丑下》"},"example":{"text":"自卜已审，若道尽途殚则已耳，足下无事冤之令～也。","book":"《晋书·嵇康传》"},"similar":["转死沟壑","转死沟渠"],"usage":"作谓语、定语；用于书面语"},{"id":42842,"word":"转侧不安","pinyin":"zhuǎn cè bù ān","abbr":"zcba","explanation":"转侧：翻来复去。翻来复去，睡不着觉。形容心里有所思念或心事重重。","source":{"text":"世俗用心不实，省事失情，二语不定，转侧不安。","book":"《诗经·周南·关雎》：“悠哉悠哉，辗转反侧。”汉·王充《论衡·案书》"},"usage":"作谓语、状语；用于书面语"},{"id":42843,"word":"转凡为圣","pinyin":"zhuǎn fán wéi shèng","abbr":"zfws","explanation":"将平常人转化为圣人","source":{"text":"还丹一粒，转铁为金；至理一言，转凡为圣。","book":"宋·释延寿《宗镜录》"},"usage":"作宾语、定语；用于书面语"},{"id":42844,"word":"转危为安","pinyin":"zhuǎn wēi wéi ān","abbr":"zwwa","explanation":"由危险转为平安（多指局势或病情）。","source":{"text":"隐居会稽东山，年逾四十复出为桓温司马，累迁中书、司徒等要职，晋室赖以转危为安。","book":"《晋书·谢安传》"},"example":{"text":"经医务人员的全力抢救，这名危重病人已经～。"},"similar":["转败为胜","化险为夷","绝处逢生"],"opposite":["得而复失"],"usage":"作谓语、定语；用于局势等"},{"id":42845,"word":"转喉触讳","pinyin":"zhuǎn hóu chù huì","abbr":"zhch","explanation":"指一说话或一写文章就触犯忌讳。","source":{"text":"各有主张，私立名字，捩手覆羹，转喉触讳。凡所以使吾面目可憎、语言无味者，皆子之志也。","book":"唐·韩愈《送穷文》"},"example":{"text":"按文字避忌，至禁用‘哉’字，真所谓～者矣。","book":"清·俞樾《茶香室续钞·忌用“哉”字》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":42846,"word":"转嗔为喜","pinyin":"zhuǎn chēn wéi xǐ","abbr":"zcwx","explanation":"由生气转为喜欢。","source":{"text":"徐大军机一看，数目却比别的门生不同，因此方转嗔为喜，解释前嫌。","book":"清·李宝嘉《官场现形记》第二十九回"},"similar":["破涕为笑"],"usage":"作谓语、定语；指改变情绪"},{"id":42847,"word":"转弯抹角","pinyin":"zhuǎn wān mò jiǎo","abbr":"zwmj","explanation":"抹角：挨着墙角绕走。沿着弯弯曲曲的路走。比喻说话绕弯，不直截了当。","source":{"text":"转弯抹角，可早来到李家门前。","book":"元·秦简夫《东堂老》"},"example":{"text":"他说话总是直来直去，从不～。"},"similar":["迂回曲折","隐晦曲折","闪烁其辞"],"opposite":["直截了当","开门见山","直言不讳"],"usage":"作谓语、定语、状语；指人说话"},{"id":42848,"word":"转弯磨角","pinyin":"zhuǎn wān mó jiǎo","abbr":"zwmj","explanation":"指沿着曲折的道路走。","source":{"text":"锦云笑道：小春姐姐把‘爽爽快快’读做‘霜霜快快’，把‘转弯磨角’读做‘转弯磨禄’，满口都是古音，他还说人讲究古音。","book":"清·李汝珍《镜花缘》第八十二回"},"similar":["转弯抹角","转湾抹角"],"usage":"作谓语、定语、状语；用于书面语"},{"id":42849,"word":"转徙无常","pinyin":"zhuǎn xǐ wú cháng","abbr":"zxwc","explanation":"转移迁徙没有规律。指行踪不定。","source":{"text":"然其方土寒埆，谷稼不殖，民习鞍马，转徙无常。","book":"《三国志·吴志·薛综传》"},"example":{"text":"但不知怎的，总不时想着在那儿过了五六年～的生活的南方。","book":"朱自清《一封信》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":42850,"word":"转忧为喜","pinyin":"zhuǎn yōu wéi xǐ","abbr":"zywx","explanation":"由忧愁转为欢喜。","source":{"text":"解双眉转愁为喜，订芳期欢声和气。","book":"明·陆采《怀香记·池塘唔语》"},"example":{"text":"“昔人云，未有小人才于内，而大将立功于外者，正今日之谓也。”岑浚方始～。","book":"清·夏敬渠《野叟曝言》第一百回"},"similar":["转愁为喜"],"usage":"作谓语、定语、状语；用于处事"},{"id":42851,"word":"转念之间","pinyin":"zhuǎn niàn zhī jiān","abbr":"znzj","explanation":"非常短暂的一瞬间。","source":{"text":"曾参听了这席话，转念之间，料必是昨日陈亢回来，把我耘瓜受杖的经过，告知了夫子。","book":"丁寅生《孔子演义》第18回"},"similar":["转瞬之间"],"usage":"作宾语、状语、分句；形容时间很短"},{"id":42852,"word":"转悲为喜","pinyin":"zhuǎn bēi wéi xǐ","abbr":"zbwx","explanation":"转悲哀为喜悦。","source":{"text":"璇姑见素臣颇有回心，转悲为喜，把手放了下来说道：‘相公不须商议，奴身总属相公的了。’","book":"清·夏敬渠《野叟曝言》第七回"},"example":{"text":"良箴听了，不觉～，再三道谢。","book":"清·李汝珍《镜花缘》第五十九回"},"similar":["破涕为笑"],"usage":"作谓语、定语；指改变情绪"},{"id":42853,"word":"转愁为喜","pinyin":"zhuǎn chóu wéi xǐ","abbr":"zcwx","explanation":"由忧愁转为欢喜。","source":{"text":"解双眉转愁为喜，订芳期欢声和气。","book":"明·陆采《怀香记·池塘唔语》"},"example":{"text":"如今见刁大人这番说话，不但～，立刻爬在地下替大人、太太磕了几个响头。","book":"清·李宝嘉《官场现形记》第四十八回"},"similar":["转忧为喜"],"usage":"作谓语、定语、状语；用于处事"},{"id":42854,"word":"转战千里","pinyin":"zhuǎn zhàn qiān lǐ","abbr":"zzql","explanation":"形容连续作战，经历了很长的历程。","source":{"text":"转斗千里，矢尽道穷。","book":"西汉·司马迁《报任少卿书》"},"example":{"text":"～，杀伤以千数。","book":"《晋书·马隆传》"},"similar":["南征北战","转斗千里"],"usage":"作谓语；形容连续作战"},{"id":42855,"word":"转斗千里","pinyin":"zhuǎn dòu qiān lǐ","abbr":"zdql","explanation":"指长途转辗作战。","source":{"text":"转谓相驰逐；斗，战也。","book":"《文选·司马迁〈报任少卿书〉》：“转斗千里，矢尽道穷，救兵不至，士卒死伤如积。”刘良注"},"example":{"text":"孙策～，尽有江东。","book":"《三国志·魏志·郭解传》"},"similar":["转战千里"],"usage":"作谓语、定语；用于书面语"},{"id":42856,"word":"转日回天","pinyin":"zhuǎn rì huí tiān","abbr":"zrht","explanation":"形容力量大，能扭转很难挽回的局面。","source":{"text":"别有豪华称将相，转日回天不相让。","book":"唐·卢照邻《长安古意》诗"},"example":{"text":"他势压朝班，威倾京国，你却与他相别。只怕他～，那时须有个决裂。","book":"明·高明《琵琶记·官媒议婚》"},"similar":["转海回天"],"usage":"作谓语、定语；用于书面语"},{"id":42857,"word":"转死沟壑","pinyin":"zhuǎn sǐ gōu hè","abbr":"zsgh","explanation":"指弃尸于山沟水渠。","source":{"text":"凶年饥岁，子之民，老羸转于沟壑，壮者散而之四方者，几午人矣。","book":"《孟子·公孙丑下》"},"example":{"text":"先生年迈齿变，饥寒不赡，～，其谁知乎？","book":"《晋书·皇甫谧传》"},"similar":["转死沟渠","转于沟壑"],"usage":"作谓语、定语；用于书面语"},{"id":42858,"word":"转死沟渠","pinyin":"zhuǎn sǐ gōu qú","abbr":"zsgq","explanation":"指弃尸于山沟水渠。同“转死沟壑”。","source":{"text":"征发闾左，以充缮筑。流离寒暑，继以疫厉，转死沟渠，曾莫收恤，朽肉枯骸，乌鸢是厌。","book":"《梁书·武帝纪上》"},"example":{"text":"家给人足，即事虽难，～，于时可免。","book":"《宋书·良吏传》"},"similar":["转死沟壑","转于沟壑"],"usage":"作谓语、定语；用于书面语"},{"id":42859,"word":"转海回天","pinyin":"zhuǎn hǎi huí tiān","abbr":"zhht","explanation":"形容力量大，能扭转很难挽回的局面。同“转日回天”。","source":{"text":"扣角负鼎，无羡昔人；转海回天，复闻今日。","book":"宋·秦观《代参寥与锺山实启》"},"similar":["转日回天"],"usage":"作谓语、定语；用于书面语"},{"id":42860,"word":"转湾抹角","pinyin":"zhuǎn wān mò jiǎo","abbr":"zwmj","explanation":"指沿着曲折的道路走。","source":{"text":"转湾抹角，可早来到李家门首。","book":"元·秦简夫《东堂老》第一折"},"example":{"text":"～多一会，到了深山草舍门。","book":"《天雨花》第一回"},"similar":["转弯磨角","转弯抹角"],"usage":"作谓语、定语、状语；用于书面语"},{"id":42861,"word":"转灾为福","pinyin":"zhuǎn zāi wéi fú","abbr":"zzwf","explanation":"同“转祸为福”。把灾祸转化为幸福。","source":{"text":"必得将兼有二长之才，无二短之累，参以吏事，任以兵法，有此数姿，然后能折冲厌难，致其功实，转灾为福。","book":"汉·马融《延光四年日蚀上书》"},"example":{"text":"～吾缄舌，倚翠偎红你小心。","book":"明·汪廷讷《狮吼记·赏春》"},"similar":["转祸为福"],"usage":"作谓语、定语；指把坏事变成好事"},{"id":42862,"word":"转益多师","pinyin":"zhuǎn yì duō shī","abbr":"zyds","explanation":"以更多的人为师学习更多的东西。","source":{"text":"别裁伪体亲风雅，转益多师是汝师。","book":"唐·杜甫《戏为六绝句》"},"example":{"text":"～无别语，心胸万古拓须开。","book":"钱钟书《留别学人》"},"usage":"作宾语、定语；用于书面语"},{"id":42863,"word":"转盼流光","pinyin":"zhuǎn pàn liú guāng","abbr":"zplg","explanation":"盼：顾盼，看；流光：飘忽不定，光彩闪耀。形容美女灵活而多情的眼神","source":{"text":"本是一双秋水眼，再吃了几杯酒，越发横波入鬓，转盼流光。","book":"清·曹雪芹《红楼梦》第65回"},"usage":"作谓语、定语；用于书面语"},{"id":42864,"word":"转眄流精","pinyin":"zhuān miàn liú jīng","abbr":"zmlj","explanation":"眄：斜眼看；精：神采。一抬眼之间眼睛会流露出神采。","source":{"text":"转眄流精，光润玉颜。含辞未吐，气若幽兰。华容婀娜，令我忘餐。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"～艳辉光，将流将引双雁行。","book":"《南齐书·乐志》"}},{"id":42865,"word":"转眼之间","pinyin":"zhuǎn yǎn zhī jiān","abbr":"zyzj","explanation":"转眼：一眨眼。一眨眼的时间。形容极短的时间。","source":{"text":"无端平地起波涛，转眼之间忘久要。","book":"明·胡文焕《群音类选·》"},"example":{"text":"他～就不见了。"},"similar":["转瞬之间"],"opposite":["长年累月"],"usage":"作宾语；指很短暂的时间"},{"id":42866,"word":"转眼即逝","pinyin":"zhuǎn yǎn jí shì","abbr":"zyjs","explanation":"过得很快。","example":{"text":"人生苦短，～，好好珍惜。"},"similar":["稍纵即逝"],"usage":"作谓语；指过得很快"},{"id":42867,"word":"转瞬之间","pinyin":"zhuǎn shùn zhī jiān","abbr":"zszj","explanation":"非常短暂的一瞬间。","source":{"text":"若余于董氏，则有师友偲偲之力，而零落于转瞬之间，更可伤也。","book":"清·黄宗羲《董在中墓志铭》"},"example":{"text":"～，从曲折的山路有一队奔跑的马蹄声迎面而来。","book":"姚雪垠《李自成》"},"similar":["转眼之间","霎那之间"],"opposite":["遥遥无期"],"usage":"作宾语、分句；形容时间很短"},{"id":42868,"word":"转祸为福","pinyin":"zhuǎn huò wéi fú","abbr":"zhwf","explanation":"把祸患变为幸福。指把坏事变成好事。","source":{"text":"倘能转祸为福，送往事居。","book":"《战国策·燕策一》：“圣人之制事也，转祸而为福，因败而为功。”唐·骆宾王《为徐敬业讨代武氏檄》"},"example":{"text":"天下事非大善不能～，非大恶亦不能转福为祸。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["转危为安","转灾为福"],"opposite":["转福为祸"],"usage":"作谓语、定语；指把坏事变成好事"},{"id":42869,"word":"转败为功","pinyin":"zhuǎn bài wéi gōng","abbr":"zbwg","explanation":"指将失败转化为胜利。","source":{"text":"圣人之制事也，转祸而为福，因败而为功。","book":"汉·贾谊《新书·铜布》：“故善为天下者，因祸而为福，转败而为功。”《战国策·燕策一》"},"similar":["转败为胜","转败为成"],"usage":"作谓语、定语；指改变局面"},{"id":42870,"word":"转败为成","pinyin":"zhuǎn bài wéi chéng","abbr":"zbwc","explanation":"指将失败转化为胜利。同“转败为功”。","source":{"text":"径直易行，由之得进，常通不塞，正以治邪，转败为成，经纬相会也。","book":"《云笈七签》卷九"},"similar":["转败为胜","转败为功"],"usage":"作谓语、定语；指改变局面"},{"id":42871,"word":"转败为胜","pinyin":"zhuǎn bài wéi shèng","abbr":"zbws","explanation":"变失败为胜利。","source":{"text":"其为政也，善因祸而为福，转败而为功。","book":"西汉·司马迁《史记·管晏列传》"},"example":{"text":"他善于用兵，常能化险为夷，～。","book":"姚雪垠《李自成》第一卷第三章"},"similar":["反败为胜","转危为安","化险为夷"],"opposite":["大势已去","大厦将倾","栋析榱崩"],"usage":"作谓语、定语；指改变局面"},{"id":42872,"word":"转转相因","pinyin":"zhuǎn zhuǎn xiāng yīn","abbr":"zzxy","explanation":"因：因循。指转来转去，相互因循。","source":{"text":"在位者皆不知阴阳时政，转转相因，故令后人遂不知也。","book":"《汉书·成帝纪》：“传以不知，周行天下。”颜师古注引如淳曰"},"usage":"作宾语、定语；用于书面语"},{"id":42873,"word":"转辗反侧","pinyin":"zhuǎn zhǎn fǎn cè","abbr":"zzfc","explanation":"形容心中有事，翻来覆去不能入睡。同“辗转反侧”。","source":{"text":"闻女转辗反侧，久而不眠。","book":"清·王韬《淞宾琐话·田荔裳》"},"example":{"text":"清·王韬《淞滨琐话·田荔裳》：“闻女～，久而不眠。”"},"similar":["展转反侧","辗转反侧"],"usage":"作谓语、定语；用于书面语"},{"id":42874,"word":"转面无情","pinyin":"zhuǎn miàn wú qíng","abbr":"zmwq","explanation":"翻脸不认人。","example":{"text":"他这个人～，不识好歹。"},"similar":["翻脸无情"],"usage":"作谓语、定语；指人不讲情面"},{"id":42875,"word":"轮扁斫轮","pinyin":"lún biǎn zhuó lún","abbr":"lbzl","explanation":"轮扁：春秋时齐国有名的的造车工人；斫轮：用刀斧砍木制造车轮。指精湛的技艺。","source":{"text":"桓公读书于堂上，轮扁斫轮于堂下。","book":"《庄子·天道》"},"example":{"text":"丹青妙处不可传，～如此用。","book":"宋·黄庭坚《戏题小雀捕飞虫画扇》诗"},"usage":"作宾语、定语；指精湛的技艺"},{"id":42876,"word":"轮焉奂焉","pinyin":"lún yān huàn yān","abbr":"lyhy","explanation":"形容房屋高大众多。","source":{"text":"美哉轮焉！美哉奂焉！","book":"西汉·戴圣《礼记·檀弓下》"},"example":{"text":"寻访久之，而后得其道基，竭力恢复。今已～，俨然一祖庭矣。","book":"清·刘献廷《广阳杂记》第四卷"},"usage":"作谓语；形容房屋高大众多"},{"id":42877,"word":"软不拉耷","pinyin":"ruǎn bù lā dā","abbr":"rbld","explanation":"耷：松弛地下垂。指软弱无力，松弛下垂。","example":{"text":"听到这个消息，他一下子就像～的泄气皮球。"},"usage":"作谓语、定语、状语；指软弱无力"},{"id":42878,"word":"软刀子","pinyin":"ruǎn dāo zǐ","abbr":"rdz","explanation":"比喻使人在不知不觉中受到损害和腐蚀的手段。","source":{"text":"我们的老调子，也就是一把软刀子。","book":"鲁迅《集外集拾遗·老调子已经唱完》"},"example":{"text":"～杀人够狠。"},"similar":["糖衣炮弹"],"usage":"作主语、宾语、定语；指容易上当的手段"},{"id":42879,"word":"软壳鸡蛋","pinyin":"ruǎn ké jī dàn","abbr":"rkjd","explanation":"比喻性情软弱之人。","source":{"text":"做小娘的，不是个软壳鸡蛋，怎的这般嫩得紧？似你恁地怕羞，如何赚得大主银子？","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"他就像一个～，不敢有所作为。"},"usage":"作宾语、定语；用于比喻句"},{"id":42880,"word":"软弱无力","pinyin":"ruǎn ruò wú lì","abbr":"rrwl","explanation":"形容身体衰弱无气力。也可比喻处事不得力，不中用。","source":{"text":"倒是一个女学生给校党委写了一封信，批评了我们思想战线上软弱无能的现象。","book":"邓小平《关于思想战线上的问题的谈话》"},"example":{"text":"她～地回答我们的问题。"},"similar":["软弱无能"],"opposite":["力大无比"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":42881,"word":"软弱无能","pinyin":"ruǎn ruò wú néng","abbr":"rrwn","explanation":"指衰弱无能为力。","source":{"text":"我党对于这样一种软弱无能的腐朽的违背马克思列宁主义原则的思想，进行了坚决的斗争。","book":"毛泽东《目前形势和我们的任务》"},"example":{"text":"毛泽东《目前形势和我们的任务》：“我党对于这样一种～的腐朽的违背马克思列宁主义原则的思想，进行了坚决的斗争。”"},"similar":["懦弱无能","软弱无力"],"usage":"作谓语、定语、状语；用于处事"},{"id":42882,"word":"软玉娇香","pinyin":"ruǎn yù jiāo xiāng","abbr":"ryjx","explanation":"软：柔和；玉、香：女子的代称。形容年轻女子身体洁白柔软，散发着温馨的青春气息。","source":{"text":"他猿乖，意马劣，都将软玉娇香，嫩枝柔叶。","book":"明·胡文焕《群音类选·李爱山》"},"similar":["软玉温香","软香温玉"],"usage":"作宾语、定语；形容女子的肌肤细腻芳香"},{"id":42883,"word":"软玉温香","pinyin":"ruǎn yù wēn xiāng","abbr":"rywx","explanation":"软：柔和；温：温和；玉、香：女子的代称。旧小说形容女子的身体。","source":{"text":"人间天上，看莺莺强如做道场。软玉温香，休道是相亲傍。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"言已，竟以～之身，置生怀里。","book":"苏曼殊《非梦记》"},"similar":["软香温玉","软玉娇香"],"usage":"作宾语、定语；形容女子的肌肤细腻芳香"},{"id":42884,"word":"软硬不吃","pinyin":"ruǎn yìng bù chī","abbr":"rybc","explanation":"指与对方谈判或处理问题时态度很强硬，什么方法均不能使其改变态度。","source":{"text":"不行呵，软硬不吃呵，我就知道这岳穆的骨头硬。","book":"王朔《千万别把我当人》"},"example":{"text":"她～，你就没办法了。"},"opposite":["软硬通吃"],"usage":"作谓语、定语；指不进油盐的人"},{"id":42885,"word":"软硬兼施","pinyin":"ruǎn yìng jiān shī","abbr":"ryjs","explanation":"兼施：同时施展。软的和硬的手段都用上了。","source":{"text":"这位神甫满脸堆笑，帮着苏凤麒一唱一和，软硬兼施地劝告苏冠兰结婚。","book":"张扬《第二次握手》"},"example":{"text":"敌人～也没使他投降。"},"similar":["恩威并济","威逼利诱"],"usage":"作谓语、宾语；指各种办法都用"},{"id":42886,"word":"软磨硬抗","pinyin":"ruǎn mó yìng kàng","abbr":"rmyk","explanation":"以和缓的手段纠缠，以强硬的手段对抗。形容想方设法拒绝服从。"},{"id":42887,"word":"软红十丈","pinyin":"ruǎn hóng shí zhàng","abbr":"rhsz","explanation":"形容都市的繁华。","source":{"text":"前辈戏语：‘西湖风月，不如京华软红香土。’","book":"宋·苏轼《次韵蒋颖叔钱穆父从驾景陵宫》诗：“半白不羞垂领发，软红犹恋性车尘。”自注"}},{"id":42888,"word":"软红香土","pinyin":"ruǎn hóng xiāng yù","abbr":"rhxt","explanation":"形容都市的繁华。","source":{"text":"前辈戏语：‘西湖风月，不如京华软红香土。’","book":"宋·苏轼《次韵蒋颖叔钱穆父从驾景陵宫》诗：“半白不羞垂领发，软红犹恋性车尘。”自注"},"usage":"作宾语、定语；形容都市的繁华"},{"id":42889,"word":"软耳朵","pinyin":"ruǎn ěr duǒ","abbr":"red","explanation":"比喻无主见、容易轻信人言的人。","example":{"text":"他是一个～，经不起别人的甜言蜜语。"},"usage":"作宾语、定语；用于比喻句"},{"id":42890,"word":"软裘快马","pinyin":"ruǎn qiú kuài mǎ","abbr":"rqkm","explanation":"轻暖的毛皮衣服和善跑的马，喻生活豪奢。","source":{"text":"赤县官曹拥才杰，软裘快马当冰雪。","book":"唐·杜甫《投简咸华两县诸子》诗"},"example":{"text":"归逢吏胥狭路边，～行索钱。","book":"明·黄淳耀《野人》诗之二"},"similar":["轻裘快马"],"usage":"作宾语、定语；用于书面语"},{"id":42891,"word":"软语温言","pinyin":"ruǎn yǔ wēn yán","abbr":"rywy","explanation":"温和的话语。","source":{"text":"每逢女儿挨了爸爸骂，陈妈总要软语温言，劝慰几句，生怕她受了委屈。","book":"周立波《山乡巨变》上十四"},"usage":"作主语、宾语、定语；指委婉的话"},{"id":42892,"word":"软谈丽语","pinyin":"ruǎn tán lì yǔ","abbr":"rtly","explanation":"指谈话时态度温和，言辞柔美。","source":{"text":"饮酒娱乐，软谈丽语，交欢释闷者不为少矣。","book":"明·方孝孺《与郑叔度书》之三"},"usage":"作宾语、定语；用于书面语"},{"id":42893,"word":"软钉子","pinyin":"ruǎn dīng zǐ","abbr":"rdz","explanation":"比喻委婉的回绝或批评。","source":{"text":"总办碰了他这么一个软钉子，气的又不敢恼出来，只得和他软商量。","book":"清·吴趼人《二十年目睹之怪现状》第30回"},"example":{"text":"你向他借钱难免要碰～。"},"usage":"作宾语、定语；指委婉的回绝"},{"id":42894,"word":"软香温玉","pinyin":"ruǎn xiāng wēn yù","abbr":"rxwy","explanation":"软：柔和；温：温和；玉、香：女子的代称。旧小说形容女子的身体。","source":{"text":"软玉温香，休道是相亲旁若能够汤他一汤，倒与人消灾障。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"央公子减被添衾，～，岂无动情之处。","book":"明·冯梦龙《警世通言》卷二十一"},"similar":["软玉温香","软玉娇香"],"usage":"作宾语、定语；形容女子的肌肤细腻芳香"},{"id":42895,"word":"软骨头","pinyin":"ruǎn gǔ tóu","abbr":"rgt","explanation":"比喻意志薄弱、没有骨气的人，甚至丧失气节的人。","source":{"text":"想不到此人是个忘恩负义的软骨头，把我出卖了。","book":"陈残云《山谷风烟》第11章"},"example":{"text":"他这个～真没用。"},"opposite":["硬骨头"],"usage":"作宾语、定语；指没有骨气的人"},{"id":42896,"word":"轰动一时","pinyin":"hōng dòng yī shí","abbr":"hdys","explanation":"形容在一个时期里到处传播，影响很大。","source":{"text":"治好了走出，没有知道，死掉了抬出，就轰动一时了。","book":"鲁迅《马上日记》"},"example":{"text":"～的义和团运动被他平息了。"},"similar":["满城风雨"],"opposite":["打入冷宫"],"usage":"作谓语、宾语、状语；指社会新闻等"},{"id":42897,"word":"轰堂大笑","pinyin":"hōng táng dà xiào","abbr":"htdx","explanation":"形容满屋子的人同时放声大笑。","source":{"text":"安公子小夫妻以至那些媳妇丫头们听了，只管不敢笑，也由不得轰堂大笑起来。","book":"清·文康《儿女英雄传》第三十三回"},"example":{"text":"满堂的人～起来。——像这样的轰堂大笑，原因不必是一样，在陈先生的教课时间里总要发作一二次。","book":"郭沫若《我的童年》第二篇四"},"similar":["哄堂大笑"],"usage":"作谓语、定语；指大家都笑"},{"id":42898,"word":"轰天烈地","pinyin":"hōng tiān liè dì","abbr":"htld","explanation":"轰动天地。形容声响猛烈或声名巨大。","source":{"text":"好似千斤炮药，等着导火线，就要发作，是轰天烈地了。","book":"清·讴歌变俗人《经国美谈·奉使宴宾》"},"similar":["轰天裂地"],"usage":"作谓语、定语；用于比喻句"},{"id":42899,"word":"轰天裂地","pinyin":"hōng tiān liè dì","abbr":"htld","explanation":"轰动天地。形容声响猛烈或声名巨大。","source":{"text":"此十一年间，表面上之克林威尔，其声希味淡也若此，而后此轰天裂地之克林威尔又何以称焉。","book":"梁启超《新英国巨人克林威尔传》"},"example":{"text":"～地手榴弹，咝…嘶…咝…嗡…哄…砰…硼。","book":"瞿秋白《赤都心史》二三"},"similar":["轰天烈地"],"usage":"作谓语、定语；用于比喻句"},{"id":42900,"word":"轰天震地","pinyin":"hōng tiān liè dì","abbr":"htzd","explanation":"轰：带有巨大响声的爆炸崩裂。形容声威巨大。","source":{"text":"只听得城隍庙里火炮齐鸣，轰天震地。","book":"明·施耐庵《水浒传》第66回"},"similar":["轰天烈地"],"usage":"作谓语、定语；用于比喻句"},{"id":42901,"word":"轰轰烈烈","pinyin":"hōng hōng liè liè","abbr":"hhll","explanation":"轰轰：象声词，形容巨大的声响；烈烈：火焰炽盛的样子。形容事业的兴旺。也形容声势浩大，气魄宏伟。","source":{"text":"人生欻翕云亡，好烈烈轰轰做一场。","book":"宋·文天祥《沁园春·题张许双庙》词"},"example":{"text":"比前番在梁山泊上更觉～，做出惊天动地的事业来。","book":"清·陈忱《水浒后传》第一回"},"similar":["烈烈轰轰","声势浩大"],"opposite":["冷冷清清","死气沉沉"],"usage":"作宾语、定语、状语；形容声势浩大","story":["宋朝时期，抗金英雄文天祥在为唐代骂贼不屈而死的忠臣张巡庙题写《沁园春》的词中写道：“骂贼张巡，同心许远，皆得声名万古香。后来者，无二公之节，百炼之钢。人生欻翕云亡，好烈烈轰轰一场。”充分歌颂威武不屈的浩然正气"]},{"id":42902,"word":"轰雷掣电","pinyin":"hōng léi chè diàn","abbr":"hlcd","explanation":"轰响的雷声，急骤的闪电。比喻使人突然震惊的事物。","source":{"text":"轰雷掣电从天降，压伏定魔王。","book":"元·杨景贤《西游记杂剧》第二本第八出"},"example":{"text":"黛玉听了此话，如～，细细思之，竟比自己肺腑中掏出来的还觉恳切。","book":"清·曹雪芹《红楼梦》第三十二回"},"usage":"作宾语、定语；用于比喻句"},{"id":42903,"word":"轰雷贯耳","pinyin":"hōng léi guàn ěr","abbr":"hlge","explanation":"贯：贯穿。轰响的雷声贯满了耳朵。形容人的名声很大。","source":{"text":"久闻贤士大名，如轰雷贯耳。","book":"元·郑德辉《王粲登楼》第一折"},"example":{"text":"孙行者，闻你名如～，说你在南天门外施威，灵霄殿下逞势。","book":"明·吴承恩《西游记》第七十六回"},"similar":["如雷贯耳"],"usage":"作谓语、宾语、定语；指人名气大"},{"id":42904,"word":"轴轳千里","pinyin":"zhóu lú qiān lǐ","abbr":"zlql","explanation":"形容船多，首尾相连","source":{"text":"轴轳千里，前驱不过百舰。","book":"《晋书·陆机传》"},"similar":["舳舻千里"],"usage":"作定语；用于书面语"},{"id":42905,"word":"轶事遗闻","pinyin":"yì shì yí wén","abbr":"ysyw","explanation":"世人不大知道的事迹和传说。多指不见于正式记载的。","source":{"text":"故单辞只义，轶事遗闻，咸笔之于书，以冀流传久远。","book":"刘师培《论说部与文学之关系》"},"similar":["遗闻轶事"],"usage":"作主语、宾语、定语；指野史"},{"id":42906,"word":"轶伦越等","pinyin":"yì lún yuè děng","abbr":"ylyd","explanation":"轶：通“逸”，超过；伦、等：同辈。指才能出类拔萃。","source":{"text":"故能说适计险，历越逾俗，轶伦越等，知略之见，遗跋众人，求绝绍远。","book":"《鹖冠子·天权》"}},{"id":42907,"word":"轶类超群","pinyin":"yì lèi chāo qún","abbr":"ylcq","explanation":"超过众人和同辈。同“轶超绝类”。","source":{"text":"就是那一长一技之微，若果能专心致志，亦足以轶类超群，独步一时。","book":"清·禇人获《隋唐演义》第九十五回"},"similar":["轶群绝类"],"usage":"作谓语、定语；用于书面语"},{"id":42908,"word":"轶群绝伦","pinyin":"yì qún jué lún","abbr":"yqjl","explanation":"伦：同辈。越过众人和同辈。","source":{"text":"处道当逸群绝伦，非常之器，非汝曹所逮也。","book":"《隋书·杨素传》"}},{"id":42909,"word":"轶群绝类","pinyin":"yì qún jué lèi","abbr":"yqjl","explanation":"超过众人和同辈。","source":{"text":"意气飘然，发扬携伟，飞黄駃騠，轶群绝类。","book":"宋·曾巩《代人祭李白文》"},"similar":["逸群绝伦"],"usage":"作谓语、定语；指人出众"},{"id":42910,"word":"轶闻遗事","pinyin":"yì wén yí shì","abbr":"ywys","explanation":"世人不大知道的事迹和传说。多指不见于正式记载的。同“轶事遗闻”。","source":{"text":"及于唐宋，其体益滋，稗则为山，说则为海，轶闻遗事，杂然著已。","book":"姚华《曲海一勺·骈史上》"},"similar":["轶事遗闻","遗闻轶事"],"usage":"作主语、宾语、定语；指野史"},{"id":42911,"word":"轸念殊深","pinyin":"zhěn niàn shū shēn","abbr":"znss","explanation":"轸：悲痛；轸念：悲痛的怀念；殊：非常。形容非常悲痛地怀念。","source":{"text":"驾言未息，轸念殊深。特致恩颁，以嘉勤瘁。","book":"宋·苏轼《赵州赐大辽贺兴龙节副使茶药诏》"},"example":{"text":"陕西兵燹频年，疮痍满目，眷言民瘼，～。亟应促进和平，早谋安集。","book":"丁中江《北洋军阀史话》一百五十六"}},{"id":42912,"word":"轹釜待炊","pinyin":"lì fǔ dài chuī","abbr":"lfdc","explanation":"刮锅有声，等待烧火做饭。形容生活艰难。","example":{"text":"～的日子真让人寒心。"},"usage":"作宾语、定语；用于生活"},{"id":42913,"word":"轻世傲物","pinyin":"qīng shì ào wù","abbr":"qsaw","explanation":"藐视世俗，为人傲慢。","source":{"text":"此人自恃文才，轻世傲物，纵酒猖狂。","book":"明·屠隆《彩毫记·宫禁生谗》"},"example":{"text":"为人放浪不羁，有～之志。","book":"明·冯梦龙《警世通言·唐解元一笑姻缘》"},"similar":["不可一世"],"usage":"作谓语、定语；指对世俗之事不放在眼里"},{"id":42914,"word":"轻世肆志","pinyin":"qīng shì sì zhì","abbr":"qssz","explanation":"藐视世俗，放荡心志。","source":{"text":"吾与富贵而泏于人，宁贫贱而轻世肆志焉。","book":"西汉·司马迁《史记·鲁仲连邹阳列传》"},"example":{"text":"老学则刍狗万物，～，往往玩弄王侯，以鸣得意。","book":"梁启超《中国学术思想变迁之大势》第四章第一节"},"usage":"作谓语、定语；用于书面语"},{"id":42915,"word":"轻举妄动","pinyin":"qīng jǔ wàng dòng","abbr":"qjwd","explanation":"轻：轻率；妄：任意。指不经慎重考虑，轻率地采取行动。","source":{"text":"众人之轻弃道理而易忘（妄）举动者，不知其祸福之深大而道阔远若是也。","book":"《韩非子·解老》"},"example":{"text":"主公宜避凶就吉，不可～。","book":"明·罗贯中《三国演义》第一百六回"},"similar":["草率行事","随心所欲","胆大妄为"],"opposite":["谨言慎行","谨小慎微","小心翼翼"],"usage":"作谓语、宾语；指不经慎重考虑"},{"id":42916,"word":"轻举绝俗","pinyin":"qīng jǔ jué sú","abbr":"qjjs","explanation":"犹言避世隐居。","source":{"text":"或有遐栖高蹈，轻举绝俗，逍遥养和，恬神自足，斯盖道隆人逸，势使其然。","book":"《晋书·贺循传》"},"usage":"作谓语、定语；指隐居"},{"id":42917,"word":"轻举远游","pinyin":"qīng jǔ yuǎn yóu","abbr":"qjyy","explanation":"指避世隐居。","source":{"text":"悲时俗之迫厄兮，愿轻举而远游。","book":"战国·楚·屈原《楚辞·远游》"},"example":{"text":"服食三载，～。","book":"《参同契》上卷"},"usage":"作谓语；指避世隐居"},{"id":42918,"word":"轻事重报","pinyin":"qīng shì zhòng bào","abbr":"qszb","explanation":"指小事情却用严重的口气报告。","source":{"text":"过来，我看去，这厮轻事重报。","book":"元·郑廷玉《忍字记》第一折"},"example":{"text":"你人也认不得，只管～！","book":"清·褚人获《隋唐演义》第二十三回"},"similar":["小题大做"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42919,"word":"轻于去就","pinyin":"qīng yú qù jiù","abbr":"qyqj","explanation":"轻：轻率；去：离开；就：靠近；去就：指去留。轻率地离开一个地方而投靠另一个地方。比喻反复无常，没有标准和原则。","source":{"text":"登见太祖，因陈布勇而无计，轻于去就，宜早图之。","book":"《三国志·魏志·吕布传》"},"example":{"text":"吕布有勇无谋，～，明公宜早图为是！","book":"蔡东藩《后汉演义》第七十六回"}},{"id":42920,"word":"轻于鸿毛","pinyin":"qīng yú hóng máo","abbr":"qyhm","explanation":"鸿毛：大雁的毛。比大雁的毛还轻。比喻毫无价值。","source":{"text":"人固有一死，或重于泰山，或轻于鸿毛，用之所趣异也。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"梅伯死～，有何惜哉？","book":"明·许仲琳《封神演义》第六回"},"similar":["无足轻重","不屑一顾"],"opposite":["重于泰山","举足轻重"],"usage":"作谓语、宾语、补语；指毫无价值","story":["西汉时期，太史令司马迁为实现父亲的遗愿继续编著《史记》，因李陵事件被施以酷刑。他强忍痛苦，终于在公元前91年完成历史巨著《史记》。他在给朋友的信中谈到对死的认识：“人固有一死，或重于泰山，或轻于鸿毛。”"]},{"id":42921,"word":"轻偎低傍","pinyin":"qīng wēi dī bàng","abbr":"qwdb","explanation":"两两相依。形容亲密的状态。","source":{"text":"庭花不及娇模样，轻偎低傍，这鬓影衣光，掩映出丰姿千状。","book":"清·洪昇《长生殿·定情》"},"usage":"作谓语、定语、状语；用于亲热场面"},{"id":42922,"word":"轻傜薄赋","pinyin":"qīng yāo báo fù","abbr":"qybf","explanation":"减轻徭役，降低赋税。同“轻繇薄赋”。"},{"id":42923,"word":"轻动干戈","pinyin":"qīng dòng gān gē","abbr":"qdgg","explanation":"轻：轻率；干戈：古代兵器。轻率地动武挑起战争。","source":{"text":"如或纵肆小忿，轻动干戈，使敌人怨结，师出无名，非惟不胜，乃自危之道也。","book":"《旧唐书·萧俛传》"},"example":{"text":"我徒弟纵有手段，决不敢～。","book":"明·吴承恩《西游记》第三十七回"},"usage":"作谓语、宾语；多用于否定句"},{"id":42924,"word":"轻动远举","pinyin":"qīng dòng yuǎn jǔ","abbr":"qdyj","explanation":"指轻率出兵征讨无方。","source":{"text":"方今大军在远，外有强敌，将军为天下之镇也，轻动远举，虽克不武。","book":"《三国志·魏志·常林传》"}},{"id":42925,"word":"轻卒锐兵","pinyin":"qīng zú ruì bīng","abbr":"qzrb","explanation":"轻卒：不披铁甲的兵士。轻装的精锐部队。","source":{"text":"济上之军，奉令击齐，大胜之。轻卒锐兵。长驱至国。","book":"《战国策·燕策二》"},"usage":"作主语、宾语；用于战争"},{"id":42926,"word":"轻口薄舌","pinyin":"qīng kǒu bó shé","abbr":"qkbs","explanation":"形容说话轻率、刻薄。","source":{"text":"这酸子轻口薄舌，专会做词，今日你去送别，曾有词否？","book":"明·凌濛初《二刻拍案惊奇》卷四十"},"similar":["轻嘴薄舌"],"usage":"作谓语、定语；指尖酸刻薄"},{"id":42927,"word":"轻口轻舌","pinyin":"qīng kǒu qīng shé","abbr":"qkqs","explanation":"指说话轻率，言语随便。也比喻人爱说俏皮话。同“轻嘴薄舌”。","source":{"text":"你不理他便罢，不要十分轻口轻舌的冲撞他。","book":"明·凌濛初《二刻拍案惊奇》第九卷"},"similar":["轻口薄舌","轻嘴薄舌"],"usage":"作谓语、定语；指人说话轻佻"},{"id":42928,"word":"轻吞慢吐","pinyin":"qīng tūn màn tǔ","abbr":"qtmt","explanation":"形容歌唱时轻声缓慢地吐词。","source":{"text":"妥娘唱毕，大家又称赞了一会，朱贵儿方在轻吞慢吐，嘹嘹呖呖，唱将起来。","book":"清；　禇人获《隋唐演义》第三十回"},"usage":"作谓语、状语；多用于唱歌"},{"id":42929,"word":"轻嘴薄舌","pinyin":"qīng zuǐ bó shé","abbr":"qzbs","explanation":"指说话轻率，言语随便。也比喻人爱说俏皮话。","source":{"text":"叵耐邻里有一班浮薄子弟，平日见王媪是个俏丽孤霜，闲常时倚门靠壁，不三不四，轻嘴薄舌的狂言挑拨。","book":"明·冯梦龙《喻世明言》卷五"},"example":{"text":"袭人听了话内有因，素知宝钗不是～奚落人的，自己想起上日王夫人的意思来，便不再提了。","book":"清·曹雪芹《红楼梦》第三十五回"},"similar":["轻口薄舌","轻口轻舌"],"usage":"作谓语、定语；指人说话轻佻"},{"id":42930,"word":"轻如鸿毛","pinyin":"qīng rú hóng máo","abbr":"qrhm","explanation":"鸿毛：大雁的毛。比大雁的毛还要轻。比喻非常轻微或毫无价值。","source":{"text":"人固有一死，或重于泰山，或轻于鸿毛，用之所趣异也。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"梅伯死～，有何惜哉？","book":"明·许仲琳《封神演义》第六回"},"similar":["轻若鸿毛"],"usage":"作谓语、宾语、补语；指毫无价值"},{"id":42931,"word":"轻尘栖弱草","pinyin":"qīng chén qī ruò cǎo","abbr":"qcqrc","explanation":"比喻人生无常。","source":{"text":"我为郡，所谓四尽：水中鱼鳖尽，山中麞鹿尽，田中米谷尽，村里民庶尽。丈夫生世，如轻尘栖弱草，白驹之过隙。人生欢乐富贵几何时！","book":"《梁书·鱼弘传》"},"example":{"text":"生世间，如～，何至自苦如此？","book":"明·罗贯中《三国演义》第一百七回"},"usage":"作宾语、定语；用于人生"},{"id":42932,"word":"轻徙鸟举","pinyin":"qīng xǐ niǎo jǔ","abbr":"qxnj","explanation":"轻于去留，像鸟飞那样容易。","source":{"text":"河南路四通，轻徙鸟举不可制。","book":"清·梅曾亮《书李林孙事》"},"usage":"作宾语、定语；用于人的运动"},{"id":42933,"word":"轻徭薄税","pinyin":"qīng yáo báo shuì","abbr":"qybs","explanation":"犹言轻徭薄赋。减轻徭役，降低赋税。","source":{"text":"海内虚耗，户口减半，光知时务之要，轻徭薄赋，与民休息。","book":"《汉书·昭帝纪》"},"example":{"text":"愿黎民乐业，做官的皆如卓鲁，令史每尽压肖曹，～，免受涂炭者。","book":"元·武汉臣《生金阁》第三折"},"similar":["轻徭薄赋","轻赋薄敛"],"usage":"作谓语、定语、宾语；用于政策等"},{"id":42934,"word":"轻徭薄赋","pinyin":"qīng yáo bó fù","abbr":"qybf","explanation":"减轻徭役，赋税。","source":{"text":"海内虚耗，户口减半，光知时务之要，轻徭薄赋，与民休息。","book":"《汉书·昭帝纪》"},"example":{"text":"治黄河修漕运，～修明政治，抚有华夏九州六十一载，算得上明君主，功盖唐宗宋祖。","book":"二月河《乾隆皇帝》四"},"similar":["轻赋薄敛","轻徭薄税"],"usage":"作谓语、定语、宾语；用于政策等"},{"id":42935,"word":"轻怜疼惜","pinyin":"qīng lián téng xī","abbr":"qltx","explanation":"形容百般怜爱。同“轻怜重惜”。"},{"id":42936,"word":"轻怜痛惜","pinyin":"qīng lián tòng xī","abbr":"qltx","explanation":"形容百般怜爱。同“轻怜重惜”。"},{"id":42937,"word":"轻怜重惜","pinyin":"qīng lián zhòng xī","abbr":"qlzx","explanation":"形容百般怜爱。"},{"id":42938,"word":"轻手蹑脚","pinyin":"qīng shǒu niè jiǎo","abbr":"qsnj","explanation":"犹言蹑手蹑脚。形容走路时脚放得很轻。同“轻手软脚”。","source":{"text":"他想轻手蹑脚的过去，别叫虎姑娘看见。","book":"老舍《骆驼祥子》"},"similar":["轻手轻脚","蹑手蹑脚"],"usage":"作状语；指手脚动作很轻"},{"id":42939,"word":"轻手软脚","pinyin":"qīng shǒu ruǎn jiǎo","abbr":"qsrj","explanation":"犹言蹑手蹑脚。形容走路时脚放得很轻。","source":{"text":"忽听得贺司户船中剪刀声响，遂悄悄的轻手软脚，开了窗儿，跨将出去。","book":"明·冯梦龙《醒世恒言》第28卷"},"similar":["轻手轻脚"],"usage":"作状语；指手脚动作很轻"},{"id":42940,"word":"轻手轻脚","pinyin":"qīng shǒu qīng jiǎo","abbr":"qsqj","explanation":"手脚动作很轻，使没有响声。","source":{"text":"一日，正在槛上闷坐，忽见那禁子轻手轻脚走来，低声哑气，笑嘻嘻的说道。","book":"明·冯梦龙《醒世恒言》卷二十七"},"example":{"text":"她是个文静的姑娘，干什么都～的。"},"similar":["蹑手蹑脚","轻手软脚"],"usage":"作状语；指手脚动作很轻，使没有响声"},{"id":42941,"word":"轻才好施","pinyin":"qīng cái hào shī","abbr":"qchs","explanation":"指人不把钱财放在眼里，乐于慷慨解囊，急公好义。","source":{"text":"谦虚接士，轻财好施，禄赐虽丰而常不足用。","book":"《三国志·吴志·朱据传》"},"example":{"text":"不逾一年，散金三十余万，有落魄公子，悉皆济之，此则是白之～也。","book":"唐·李白《上安州裴长史书》"}},{"id":42942,"word":"轻拢慢捻","pinyin":"qīng lǒng màn niǎn","abbr":"qlmn","explanation":"拢：用手指在弦乐器的弦上按捺；捻：弹奏弦乐器的一种指法。形容轻巧从容地弹奏弦乐器。","source":{"text":"轻拢慢捻抹复挑, 初为霓裳后六幺。","book":"唐·白居易《琵琶行》诗"},"example":{"text":"一样乐器，两个人伺候，弹琵琶的自己只用右手～，另有个人替她按弦。","book":"高阳《慈禧全传》二十六"},"similar":["轻挑漫剔"],"usage":"作谓语、定语；用于弹琴等"},{"id":42943,"word":"轻挑漫剔","pinyin":"qīng tiāo màn tī","abbr":"qtmt","explanation":"形容从容地弹奏乐器。","source":{"text":"初起不过轻挑漫剔，声响悠柔。","book":"清·刘鹗《老残游记》第十回"},"similar":["轻拢慢捻"],"usage":"作谓语、定语；用于弹琴等"},{"id":42944,"word":"轻描淡写","pinyin":"qīng miáo dàn xiě","abbr":"qmdx","explanation":"原指描绘时用浅淡的颜色轻轻地着笔。现多指说话写文章把重要问题轻轻带过。","source":{"text":"臬台见他说得这等轻描淡写，更是着急。","book":"清·吴趼人《二十年目睹之怪现状》第四十八回"},"example":{"text":"写文章该详的地方要详，不可～。"},"similar":["蜻蜓点水","不痛不痒"],"opposite":["淋漓尽致","小题大做"],"usage":"作谓语、定语、状语；指一笔带过"},{"id":42945,"word":"轻敲缓击","pinyin":"qīng qiāo huǎn jī","abbr":"qqhj","explanation":"比喻婉转地表达意思和说明问题。","source":{"text":"且待四个宫人到，轻敲缓击试他们。","book":"清·陶贞怀《天雨花》第21回"},"usage":"作谓语、状语；用于说话"},{"id":42946,"word":"轻松愉快","pinyin":"qīng sōng yú kuài","abbr":"qsyk","explanation":"指人的心情很放松、欢欣快乐。","source":{"text":"我们要保持～的心情。"},"example":{"text":"我们要保持～的心情"},"opposite":["愁肠九转"],"usage":"作谓语、定语、状语；指人的心情"},{"id":42947,"word":"轻歌妙舞","pinyin":"qīng gē miào wǔ","abbr":"qgmw","explanation":"指轻快的音乐和柔美的舞蹈。","source":{"text":"轻歌妙舞常堪爱，锦砌花团色色怡。","book":"明·吴承恩《西游记》第95回"},"similar":["轻歌曼舞"],"usage":"作谓语、宾语；用于音乐和舞蹈"},{"id":42948,"word":"轻歌慢舞","pinyin":"qīng gē màn wǔ","abbr":"qgmw","explanation":"轻快的音乐和柔美的舞蹈。","source":{"text":"助人间才子佳人兴，轻歌慢舞，任星移斗横。","book":"明·胡文焕《群音类选·玉如意记·赏月登仙》"},"similar":["轻歌曼舞"],"usage":"作谓语、宾语；指轻快的音乐和柔美的舞蹈"},{"id":42949,"word":"轻歌曼舞","pinyin":"qīng gē màn wǔ","abbr":"qgmw","explanation":"音乐轻快，舞姿优美。","source":{"text":"似大姐这般玉质花容，清歌妙舞，在这歌妓中可是少也。","book":"元·乔孟符《两世姻缘》第一折"},"example":{"text":"梵呗圆音，竟将为～所“加被”，岂不出于意表也哉。","book":"鲁迅《花边文学·法会和歌剧》"},"similar":["轻歌妙舞"],"opposite":["载歌载舞"],"usage":"作谓语、宾语；指轻快的音乐和柔美的舞蹈"},{"id":42950,"word":"轻死重义","pinyin":"qīng sǐ zhòng yì","abbr":"qszy","explanation":"指以义气为重而不怕死。同“轻死重气”。","source":{"text":"指以义气为重而不怕死。同“轻死重气”。"},"example":{"text":"《旧唐书·崔融传》：“若乃富商大贾，豪宗恶少，轻死重义，结党连群。”"},"similar":["轻死重气"],"usage":"作谓语、定语、宾语；用于为人"},{"id":42951,"word":"轻死重气","pinyin":"qīng sǐ zhòng qì","abbr":"qszq","explanation":"指以义气为重而不怕死。","source":{"text":"都邑游侠，张起之伦，齐志无忌，拟迹田文，轻死重气，结党连群。","book":"汉·张衡《西京赋》"},"similar":["轻死重义"],"usage":"作谓语、定语、宾语；用于为人"},{"id":42952,"word":"轻浪浮薄","pinyin":"qīng làng fú bó","abbr":"qlfb","explanation":"形容人的行为轻浮浪荡。","source":{"text":"填词觅句，无所不能，便是弄管调弦，也无所不会，是个第一等轻浪浮薄子弟。","book":"清·文康《儿女英雄传》"},"example":{"text":"我不喜欢～的女孩。"},"similar":["放荡不羁"],"usage":"作谓语、定语；指行为放荡"},{"id":42953,"word":"轻生重义","pinyin":"qīng shēng zhòng yì","abbr":"qszy","explanation":"指轻视生命而重视正义事业。同“轻身重义”。","source":{"text":"朝闻夕改，轻生重义，徇国之躯，可谓志节之士也。","book":"《晋书·周访传》"},"similar":["轻身重义"],"usage":"作谓语、定语、宾语；用于人"},{"id":42954,"word":"轻禄傲贵","pinyin":"qīng lǜ ào guì","abbr":"qlag","explanation":"轻视禄位，傲视权贵。比喻鄙弃利禄富贵的行为。","source":{"text":"轻禄傲贵，与物无营。","book":"三国·魏·曹植《七启》"}},{"id":42955,"word":"轻繇薄赋","pinyin":"qīng yáo báo fù","abbr":"qybf","explanation":"减轻徭役，降低赋税。"},{"id":42956,"word":"轻而易举","pinyin":"qīng ér yì jǔ","abbr":"qeyj","explanation":"形容事情容易做，不费力气。","source":{"text":"言人皆言德甚轻而易举，然人莫能举也。","book":"《诗·大雅·烝民》：“人亦有言，德輶如毛，民鲜克举之。”朱熹注"},"example":{"text":"事情并不象宋福想的那样～。","book":"杨朔《渔笛》"},"similar":["易如反掌","唾手可得"],"opposite":["来之不易","寸步难行"],"usage":"作谓语、定语、状语；指毫不费力"},{"id":42957,"word":"轻脚轻手","pinyin":"qīng jiǎo qīng shǒu","abbr":"qjqs","explanation":"蹑手蹑脚。形容走路时脚放得很轻。","source":{"text":"于是萧萧轻脚轻手爬起床来，眼屎朦胧地走过床边。","book":"沈从文《萧萧》"},"similar":["轻手轻脚","轻手软脚"],"usage":"作状语；指手脚动作很轻"},{"id":42958,"word":"轻若鸿毛","pinyin":"qīng ruò hóng máo","abbr":"qrhm","explanation":"比大雁的毛还轻。比喻毫无价值。同“轻于鸿毛”。","source":{"text":"轻若鸿毛，重若泥沉，损之不得，测之愈深。","book":"《晋书·皇甫谧传》"},"similar":["轻如鸿毛","轻于鸿毛"],"usage":"作谓语、宾语、补语；指毫无价值"},{"id":42959,"word":"轻莹秀彻","pinyin":"qīng yíng xiù chè","abbr":"qyxc","explanation":"莹：光洁明亮；秀：秀丽；彻：透彻。比喻诗文的意境新、词藻精、语句俊雅。","source":{"text":"清莹秀彻，锵呜金石。","book":"唐·柳宗元《愚溪诗序》"}},{"id":42960,"word":"轻薄少年","pinyin":"qīng bó shào nián","abbr":"qbsn","explanation":"轻薄：放荡。比喻轻佻放荡的年轻人。","source":{"text":"杂举长安中轻薄少年恶子，无市籍商贩作务，而鲜衣凶服被铠扞持刀兵者，悉籍记之，得数百人。","book":"《汉书·伊赏传》"},"example":{"text":"这些浮浪子弟，～，却又尽多，有了杜子春恁样撒漫财主，再有那个不来！","book":"明·冯梦龙《醒世恒言》卷三十七"}},{"id":42961,"word":"轻薄无知","pinyin":"qīng bó wú zhī","abbr":"qbwz","explanation":"轻佻浮薄没有知识。","source":{"text":"即轻薄无知泛滥之徒，岂可见天地之心乎？","book":"宋·张君房《云笈七签》卷七十"},"example":{"text":"这样轻薄无知的人！书生得了科名，难道不该归来会一会宗族邻里？","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"usage":"作谓语、定语；指为人"},{"id":42962,"word":"轻薄无礼","pinyin":"qīng báo wú lǐ","abbr":"qbwl","explanation":"指轻佻浮薄，不知礼仪。","source":{"text":"那温庭筠这等轻薄无礼，小人也为着一事，丞相爷差去见他，倒被他呵叱了一场。","book":"明·叶宪祖《鸾鎞记》"},"usage":"作谓语、定语；指为人"},{"id":42963,"word":"轻薄无行","pinyin":"qīng bó wú xíng","abbr":"qbwx","explanation":"无行：品行坏。态度轻佻，道德败坏。","source":{"text":"恒为州大中正，乡人任让轻薄无行，为恒所黜。","book":"《晋书·华表传》"},"example":{"text":"他怎么变得如此～了。"},"usage":"作谓语、定语；指为人"},{"id":42964,"word":"轻虑浅谋","pinyin":"qīng lǜ qiǎn móu","abbr":"qlqm","explanation":"考虑不全面，计划不周密。","source":{"text":"夫人小有欲，轻虑浅谋，徒见其利，而不顾其害。","book":"《史记·越世家》"},"example":{"text":"燕丹不胜一朝之忿以犯虎狼之秦，～，挑怨速祸。","book":"《资治通鉴·秦纪·始皇帝二十五年》"},"opposite":["深谋远虑"],"usage":"作谓语、定语；指考虑不全面，计划不周密"},{"id":42965,"word":"轻装上阵","pinyin":"qīng zhuāng shàng zhèn","abbr":"qzsz","explanation":"指作战时不披盔甲，比喻放下思想包袱投入工作。","source":{"text":"这样一来，年轻人减轻了思想负担，轻装上阵，充分发挥创作才华。","book":"《文汇报》1983.1.6"},"example":{"text":"我们要解放思想，～。"},"opposite":["任重道远"],"usage":"作谓语；指放下包袱投入工作"},{"id":42966,"word":"轻装简从","pinyin":"qīng zhuāng jiǎn cóng","abbr":"qzjc","explanation":"行装简便，随从人少。","source":{"text":"今日常轻装简从，登门造访。","book":"京剧《红色娘子军》"},"example":{"text":"领导干部下乡要～，不能铺张浪费。"},"similar":["轻车简从"],"usage":"作宾语、定语；指行装简单"},{"id":42967,"word":"轻裘大带","pinyin":"qīng qiú dà dài","abbr":"qqdd","explanation":"轻暖的皮袍，宽松的腰带。形容从容闲适。","source":{"text":"轻裘大带，白玉横腰，而森罗于阶下者，其数尤多。","book":"《灵应传》"},"similar":["轻裘缓带","轻裘缓辔"],"usage":"作谓语、定语、状语；形容从容闲适"},{"id":42968,"word":"轻裘朱履","pinyin":"qīng qiú zhū lǚ","abbr":"qqzl","explanation":"裘：皮袄；履：鞋。穿着轻暖的皮袍和红色便鞋。形容闲适安逸的生活。","source":{"text":"朝罢袖香微，换了轻裘朱履，阳春十月，梅花早破红蕊。","book":"清·孔尚任《桃花扇·媚座》"}},{"id":42969,"word":"轻裘缓带","pinyin":"qīng qiú huǎn dài","abbr":"qqhd","explanation":"轻暖的皮袍，宽松的衣带。形容态度从容镇定。","source":{"text":"祜在军常轻裘缓带，身不披甲。","book":"《晋书·羊祜传》"},"example":{"text":"乐和选十个彪形大汉，各带弓刀，自己～，骑着白马；到城门边，果然大开，昂然而入。","book":"清·陈忱《水浒后传》第十二回"},"similar":["轻裘缓辔","缓带轻裘"],"usage":"作谓语、定语、状语；形容从容闲适","story":["西晋时期，巨平侯羊祜都督荆州军事，被任命为征南大将军。他经常在军中穿着轻暖的皮衣，系着宽大的带子，仪态从容，没有武将的风度气质，很有雅士的风度。他的居住地没有重兵把守，还经常因为打猎、喝酒而耽误军务"]},{"id":42970,"word":"轻裘缓辔","pinyin":"qīng qiú huǎn pèi","abbr":"qqhp","explanation":"犹言轻裘缓带。形容态度从容镇定。","source":{"text":"轻裘缓辔踏地来，不减襄阳晋羊祜。","book":"明·郭贞顺《上俞将军》"},"similar":["轻裘缓带"],"usage":"作谓语、定语、状语；形容从容闲适"},{"id":42971,"word":"轻裘肥马","pinyin":"qīng qiú féi mǎ","abbr":"qqfm","explanation":"穿着轻暖的皮袄，骑着肥壮的好马。形容生活阔绰。","source":{"text":"赤之造齐也，乘肥马，衣轻裘。","book":"《论语·雍也》"},"example":{"text":"苍颜照影，故应零落，～。","book":"宋·辛弃疾《水龙吟》词"},"similar":["肥马轻裘"],"usage":"作宾语、定语；形容生活阔绰"},{"id":42972,"word":"轻视傲物","pinyin":"qīng shì ào wù","abbr":"qsaw","explanation":"轻：轻慢；世：世人；傲：傲慢；物：人，公众。对世俗之事一概不放在眼里。","source":{"text":"此人自恃文才，轻世傲物。","book":"明·屠隆《彩毫记·宫禁生谗》"},"example":{"text":"为人放浪不羁，有～之志。","book":"明·冯梦龙《警世通言》卷二十六"}},{"id":42973,"word":"轻言寡信","pinyin":"qīng yán guǎ xìn","abbr":"qygx","explanation":"说话轻率，缺少信用。","source":{"text":"你不要非真当假，大丈夫言出无差，轻言寡信，休要耍。","book":"元·贾仲名《升仙梦》第三折"},"opposite":["一诺千金"],"usage":"作谓语、定语、宾语；用于为人"},{"id":42974,"word":"轻言细语","pinyin":"qīng yán xì yǔ","abbr":"qyxy","explanation":"形容说话轻而柔和。","source":{"text":"哥哥轻言细语地答道：‘在他面前把情理摆出来，想他会听进耳朵的。’","book":"谢璞《二月兰》"},"example":{"text":"请～地说话。"},"similar":["轻言轻语"],"opposite":["粗声粗气"],"usage":"作宾语、状语；指低声说话"},{"id":42975,"word":"轻言肆口","pinyin":"qīng yán sì kǒu","abbr":"qysk","explanation":"指说话轻率、放肆。","source":{"text":"近代宋孝武轻言肆口，侮弄朝臣，攻其门户，乃至狼狈。","book":"《旧唐书·张玄素传》"},"usage":"作谓语、定语、状语；用于说话"},{"id":42976,"word":"轻言软语","pinyin":"qīng yán ruǎn yǔ","abbr":"qyry","explanation":"形容说话轻而柔和。同“轻言细语”。","source":{"text":"娘们又用软手段，体贴他，笼络他，跟他轻言软语地说道。","book":"周立波《暴风骤雨》第二部"},"similar":["轻言细语","轻言轻语"],"usage":"作宾语、状语；指低声说话"},{"id":42977,"word":"轻言轻语","pinyin":"qīng yán qīng yǔ","abbr":"qyqy","explanation":"形容说话声音极轻微。","source":{"text":"排长跟杜富海夹在人缝里，轻言轻语地合计事情。","book":"杨朔《北线》"},"similar":["轻言细语"],"usage":"作宾语、状语；指低声说话"},{"id":42978,"word":"轻诺寡信","pinyin":"qīng nuò guǎ xìn","abbr":"qngx","explanation":"轻易答应人家要求的，一定很少守信用。","source":{"text":"夫轻诺必寡信，多易必多难。","book":"《老子》六十三章"},"example":{"text":"吾家非～。","book":"清·蒲松龄《聊斋志异·凤仙》"},"similar":["轻言寡信","花言巧语"],"opposite":["一诺千金","不轻然诺"],"usage":"作谓语、宾语、定语；指人少守信用"},{"id":42979,"word":"轻财仗义","pinyin":"qīng cái zhàng yì","abbr":"qczy","explanation":"犹轻财重义。指轻视钱财，重视士人。","source":{"text":"一生轻财仗义，把数万金的家资，不上十年，花得精光。","book":"陈天华《狮子吼》第六回"},"example":{"text":"陈天华《狮子吼》第六回：“一生～，把数万金的家资，不上十年，花得精光。”"},"similar":["轻财好义","轻财贵义","轻财重义"],"opposite":["爱财如命","见利忘义"],"usage":"作谓语、定语、宾语；指人很大方"},{"id":42980,"word":"轻财任侠","pinyin":"qīng cái rèn xiá","abbr":"qcrx","explanation":"轻视钱财，行侠义之事。","source":{"text":"想起那浮生易往，……轻财任侠，也属微尘。","book":"明·梅鼎祚《玉合记·诇约》"}},{"id":42981,"word":"轻财好义","pinyin":"qīng cái hào yì","abbr":"qchy","explanation":"犹言轻财重义。指轻视财利而看重道义。","source":{"text":"股肱宰臣，身行俭约，轻财重义，较然著明。","book":"汉·元王皇后《赐公孙弘子孙当为后者爵诏》"},"example":{"text":"原来汪革素性～，枢密府里的人，一个个和他相好。","book":"明·冯梦龙《喻世明言》卷三十九"},"similar":["轻财重义","轻财仗义"],"opposite":["爱财如命","见利忘义"],"usage":"作谓语、定语、宾语；指人很大方"},{"id":42982,"word":"轻财好士","pinyin":"qīng cái hào shì","abbr":"qchs","explanation":"轻视钱财，重视读书人。","source":{"text":"父允，轻财重士，名显州郡，为孙权东曹掾。","book":"《三国志·吴志·张温传》"},"example":{"text":"～，一乡多济友朋；月地花天，四海又闻豪杰。","book":"清·吴敬梓《儒林外史》第三十一回"},"similar":["轻财敬士"],"usage":"作谓语、定语、宾语；用于为人"},{"id":42983,"word":"轻财好施","pinyin":"qīng cái hǎo shī","abbr":"qchs","explanation":"指不吝惜钱财，喜好施舍。","source":{"text":"谦虚接士，轻财好施，禄赐虽丰而常不足用。","book":"晋·陈寿《三国志·吴志·朱据传》"},"example":{"text":"他是一个～的人。"},"similar":["仗义疏财"],"opposite":["爱财如命"],"usage":"作谓语、定语、宾语；指人很大方","story":["三国时期，吴国云阳侯朱据谦虚接士，轻财好施，被孙权认定为一个文武全才，并把公主嫁给了他。朱据的部队饷银三万串被王遂骗取，典校吕壹怀疑是朱据贪污，就向孙权举报。孙权觉得这不像他的为人，下令查明了真相"]},{"id":42984,"word":"轻财敬士","pinyin":"qīng cái jìng shì","abbr":"qcjs","explanation":"指轻视钱财，重视士人。同“轻财重士”。","source":{"text":"宁虽粗猛好杀，然开爽有计略，轻财敬士，能厚养健儿。","book":"晋·陈寿《三国志·吴志·甘宁传》"},"similar":["轻财重士"],"usage":"作谓语、定语、宾语；用于为人"},{"id":42985,"word":"轻财贵义","pinyin":"qīng cái guì yì","abbr":"qcgy","explanation":"犹言轻财重义。指轻视财利而看重道义。","source":{"text":"然轻财贵义，兼以强识，与人一面，数十年不忘。","book":"晋·陈寿《三国志·吴志·朱恒传》"},"similar":["轻财好义","轻财仗义","轻财重义"],"opposite":["爱财如命","见利忘义"],"usage":"作谓语、定语、宾语；指人很大方"},{"id":42986,"word":"轻财重义","pinyin":"qīng cái zhòng yì","abbr":"qczy","explanation":"指轻视财利而看重道义。","source":{"text":"股肱宰臣，身行俭约，轻财重义，较然著明。","book":"汉·元王皇后《赐公孙弘子孙当为后者爵诏》"},"example":{"text":"少时轻侠，数犯公法，长而修改，～，多所交结。","book":"《北齐书·高乾璺》"},"similar":["仗义疏财","轻财好义"],"opposite":["爱财如命"],"usage":"作谓语、定语、宾语；指人很大方","story":["三国时期，吴国别部司马凌统统领父亲凌操生前的军队，他亲贤接士，轻财重义，有国士之风。在与都督陈勤等喝酒时，陈勤暴戾任性，借醉酒侮辱凌统，凌统忍无可忍杀了他。一次战斗中凌统立下大功，孙权让他将功赎罪"]},{"id":42987,"word":"轻财重士","pinyin":"qīng cái zhòng shì","abbr":"qczs","explanation":"轻视钱财，重视读书人。","source":{"text":"父允，轻财重士，名显州郡，为孙权东曹掾。","book":"《三国志·吴志·张温传》"},"example":{"text":"高尝受诏教习胡亥，见他慈仁笃厚，～，口才似拙，心地却明，诸公子中，无一能及。","book":"蔡东藩《前汉演义》第七回"},"similar":["轻财好士","轻财敬士"],"usage":"作谓语、定语、宾语；用于为人"},{"id":42988,"word":"轻贤慢士","pinyin":"qīng xián màn shì","abbr":"qxms","explanation":"轻：轻视；慢：傲慢。轻视有才能的，不尊敬读书人。形容轻狂傲慢，狂妄无知。","source":{"text":"韩玄残暴不仁，轻贤慢士。","book":"明·罗贯中《三国演义》第53回"},"opposite":["礼贤下士"],"usage":"作谓语、定语；用于为人"},{"id":42989,"word":"轻赋薄敛","pinyin":"qīng fù báo liǎn","abbr":"qfbl","explanation":"犹言轻徭薄赋。减轻徭役，降低赋税。","source":{"text":"汤夙兴夜寐，以致聪明，轻赋薄敛，以宽民氓。","book":"西汉·刘安《淮南子·修务训》"},"similar":["轻徭薄赋","轻徭薄税"],"usage":"作谓语、定语、宾语；用于政策等"},{"id":42990,"word":"轻身下气","pinyin":"qīng shēn xià qì","abbr":"qsxq","explanation":"形容谦恭的态度。","source":{"text":"倾家破产，急士之穷，轻身下气，而交名胜。","book":"宋·陈师道《序》"},"usage":"作谓语、定语；用于为人"},{"id":42991,"word":"轻身徇义","pinyin":"qīng shēn xùn yì","abbr":"qsxy","explanation":"轻视生命而为正义事业牺牲。","source":{"text":"当时闻之，人无勇怯，莫不强胆增气，轻身徇义，攘袂高谈称羡。","book":"汉·申屠蟠《为缑氏女玉奏记外黄令》"},"similar":["轻身殉义"],"usage":"作谓语、宾语；用于人"},{"id":42992,"word":"轻身殉义","pinyin":"qīng shēn xùn yì","abbr":"qsxy","explanation":"指轻视生命而为正义事业牺牲。","source":{"text":"当时闻之，人无勇怯，莫不强胆增气，轻身殉义，攮袂高谈称羡。","book":"晋·杜预《女记》"},"similar":["轻身徇义"],"usage":"作谓语、宾语；用于人"},{"id":42993,"word":"轻身重义","pinyin":"qīng shēn zhòng yì","abbr":"qszy","explanation":"指轻视生命而重视正义事业。","source":{"text":"攻守进趣之术，轻身重义之节。","book":"《抱朴子·明本》"},"example":{"text":"纬武经文～，社稷是所不图也，天位非所倾望也。","book":"唐·释道宣《广弘明集》卷二十九"},"similar":["轻生重义"],"usage":"作谓语、定语、宾语；用于人"},{"id":42994,"word":"轻车介士","pinyin":"qīng chē jiè shì","abbr":"qcjs","explanation":"比喻战车和甲士。","source":{"text":"安世复强起视事，至秋薨。一辈子赠印绶，送以轻车介士。","book":"《汉书·张安世传》"},"example":{"text":"及葬，又使侍御史持节送丧，兰台令史十人发羽林骑～，前后部鼓吹。","book":"《后汉书·杨震传》"},"usage":"作宾语、定语；用于书面语"},{"id":42995,"word":"轻车减从","pinyin":"qīng chē jiǎn cóng","abbr":"qcjc","explanation":"行装简单，跟随的人少（多指有地位的人）。同“轻车简从”。","source":{"text":"贪吏如李侍尧辈布满天下，而公独以廉著，每出巡，轻车减从，不择饮食。","book":"清·昭梿《啸亭杂录·孙文靖》"},"similar":["轻车简从"],"opposite":["前呼后拥"],"usage":"作谓语、定语；指行装简单"},{"id":42996,"word":"轻车快马","pinyin":"qīng chē shú mǎ","abbr":"qckm","explanation":"喜事从天上掉下来。比喻突然遇到意想不到的喜事。","source":{"text":"贵脚踏践地，使下官喜从天降。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"张顺见了宋江，～。","book":"明·施耐庵《水浒全传》第四十回"}},{"id":42997,"word":"轻车熟路","pinyin":"qīng chē shú lù","abbr":"qcsl","explanation":"赶着装载很轻的车子走熟悉的路。比喻事情又熟悉又容易。","source":{"text":"若驷马驾轻车就熟路，而王良、造父为之先后也。","book":"唐·韩愈《送石处士序》"},"example":{"text":"逸气轩眉宇，似王良～，骅骝欲舞。","book":"宋·辛弃疾《贺新郎》词"},"similar":["得心应手","轻而易举","驾轻就熟"],"opposite":["人生地疏"],"usage":"作谓语、宾语、状语；指办事轻而易举"},{"id":42998,"word":"轻车熟道","pinyin":"qīng chē shú dào","abbr":"qcsd","explanation":"比喻事情又熟悉又容易。同“轻车熟路”。","source":{"text":"轻车熟道寻秋去，偕友傍午发临安。","book":"续范亭《莫干山》"},"similar":["轻车熟路"],"usage":"作谓语、宾语、状语；指办事轻而易举"},{"id":42999,"word":"轻车简从","pinyin":"qīng chē jiǎn cóng","abbr":"qcjc","explanation":"行装简单，跟随的人少（多指有地位的人）。","source":{"text":"他就向县里要了车，轻车简从的向平阴进发。","book":"清·刘鹗《老残游记》第八回"},"example":{"text":"明年正逢选缺之期，伯集～，只带了两个家人，北上进京。","book":"清·李宝嘉《文明小史》第三十回"},"similar":["轻车减从"],"opposite":["前呼后拥"],"usage":"作谓语、定语；指行装简单"},{"id":43000,"word":"轻轻巧巧","pinyin":"qīng qīng qiǎo qiǎo","abbr":"qqqq","explanation":"轻便灵巧，简单容易。","source":{"text":"却说铁公子在西山读书，待到秋闱，真是才高如拾芥，轻轻巧巧，中了一名举人。","book":"清·名教中人《好逑传》第15回"},"usage":"作定语、状语；多用于口语"},{"id":43001,"word":"轻轻快快","pinyin":"qīng qīng kuài kuài","abbr":"qqkk","explanation":"轻松愉快。","source":{"text":"目前根据地的情况已经要求我们褪去冬衣，穿起夏服，以便轻轻快快地同敌人作斗争。","book":"毛泽东《一个极其重要的政策》"},"example":{"text":"路遥《平凡的世界》第三卷第15章：“活着不仅为了填饱肚子，还想过两天排排场场～的日子啊！”"},"usage":"作定语、状语；用于人的心情"},{"id":43002,"word":"轻轻易易","pinyin":"qīng qīng yì yì","abbr":"qqyy","explanation":"毫不费力，轻而易举。","source":{"text":"我们是针锋相对，寸土必争，绝不让国民党轻轻易易地占我们的地方，杀我们的人。","book":"毛泽东《抗日战争胜利后的时局和我们的方针》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“而且出于阿七的推荐，～地去了自己心中一个‘痞块’，岂非一件极痛快的事？”"},"similar":["轻而易举"],"opposite":["难上加难"],"usage":"作状语；用于做事等"},{"id":43003,"word":"轻轻松松","pinyin":"qīng qīng sōng sōng","abbr":"qqss","explanation":"不感到有负担，很容易。","source":{"text":"果然将门之子，与众不同，看他拿这柄铁杆枪，犹如取了一根杉木棍，轻轻松松不用气力的一般。","book":"清·无名氏《说呼全传》第七回"},"example":{"text":"你倒好意思，～说不要了。","book":"曾朴《孽海花》第23回"},"usage":"作宾语、定语、状语；多用于口语"},{"id":43004,"word":"轻重之短","pinyin":"qīng zhòng zhī duǎn","abbr":"qzzd","explanation":"指对于事情考虑不周到的弊病。","source":{"text":"上书言偃受金及轻重之短。","book":"《史记·齐悼惠王世家》"}},{"id":43005,"word":"轻重九府","pinyin":"qīng zhòng jiǔ fǔ","abbr":"qzjf","explanation":"轻重：指钱币。掌管财政的九个官署，即大府、王府、内府、外府、泉府、天府、职内、职金、职币。","source":{"text":"设轻重九府。","book":"西汉·司马迁《史记·货殖列传》"},"usage":"作宾语、定语；指官衙"},{"id":43006,"word":"轻重倒置","pinyin":"qīng zhòng dào zhì","abbr":"qzdz","explanation":"把重要的和不重要的两者的地位摆颠倒了。","source":{"text":"轻重倒置，有害政体。","book":"宋·刘安世《尽言集·论韩玠差除不当第三》"},"example":{"text":"写文章做演说就不同了，这是专为影响人的，我们的同志反而随随便便，这就叫做～。","book":"毛泽东《反对党八股》"},"similar":["本末倒置","舍本逐末"],"opposite":["纲举目张","提纲挈领"],"usage":"作谓语、宾语、定语；指本末倒置"},{"id":43007,"word":"轻重失宜","pinyin":"qīng zhòng shī yí","abbr":"qzsy","explanation":"指重要的与不重要的处置失当。","source":{"text":"若列行陈之家与伎术之辈，均用此赏，臣窃恐轻重失宜矣。","book":"宋·苏舜钦《论宣借宅事》"},"example":{"text":"苟律例～，官吏舞文出入，政平讼理，其道曷由。","book":"《清史稿·世祖本纪》"},"usage":"作宾语、定语；用于处事"},{"id":43008,"word":"轻重疾徐","pinyin":"qīng zhòng jí xú","abbr":"qzjx","explanation":"疾徐：快慢。指弹奏器乐的方法。","source":{"text":"还要知道轻重疾徐、卷舒自若、体态尊重方好。","book":"清·曹雪芹《红楼梦》第89回"},"similar":["轻重缓急"],"usage":"作宾语、定语；用于弹琴"},{"id":43009,"word":"轻重缓急","pinyin":"qīng zhòng huǎn jí","abbr":"qzhj","explanation":"指各种事情中有主要的和次要的，有急于要办的和可以慢一点办的。","source":{"text":"古之人有至于张空弮、罗雀鼠而民无二志者，非上之信有以结其心乎？此又权于缓急轻重之间而为不得已之计也。","book":"清·顾炎武《日知录》卷七"},"example":{"text":"事有～，不能不从长计较哩。","book":"清·岭南羽衣女士《东欧女豪杰》第五回"},"similar":["缓急轻重","有条不紊"],"opposite":["齐头并进"],"usage":"作宾语、定语；用于事情"},{"id":43010,"word":"轻风高谊","pinyin":"qīng fēng gāo yì","abbr":"qfgy","explanation":"高尚的风格，深厚的友谊。","source":{"text":"百需所出，皆自复卿，并召僧建水陆斋三昼夜，以荐冥福，轻风高谊，传播江湖间。","book":"明·李昌祺《剪灯余话·两川都辖院志》"}},{"id":43011,"word":"轻饶素放","pinyin":"qīng ráo sù fàng","abbr":"qrsf","explanation":"轻易地饶恕，白白地放过。","source":{"text":"俺哥哥若有些好歹，我不道的轻饶素放了你也。","book":"元·李文蔚《燕青博鱼》第一折"},"example":{"text":"道士有个～的，还要谢将吃酒。","book":"明·兰陵笑笑生《金瓶梅词话》第39回"},"usage":"作谓语、定语、宾语；用于处事"},{"id":43012,"word":"轻骑减从","pinyin":"qīng qí jiǎn cóng","abbr":"qqjc","explanation":"行装简单，跟随的人少（多指有地位的人）。同“轻车简从”。","source":{"text":"所以我的主意，打算暂且不带家眷，我一个人带上几个家人轻骑减从的先去看看路数。","book":"清·文康《儿女英雄传》第二回"},"similar":["轻骑简从","轻车减从"],"usage":"作谓语、定语、状语；指行装简单"},{"id":43013,"word":"轻骑简从","pinyin":"qīng jì jiǎn cóng","abbr":"qqjc","explanation":"指出门时行装简单，跟随的人不多（多指有地位的人）。","source":{"text":"闺臣笑道：‘紫菱姐姐这才算得轻骑简从哩。’","book":"清·李汝珍《镜花缘》第六十二回"},"example":{"text":"暂且不带家眷，我一个人带上几个家人，～的先去看看路数。","book":"清·文康《儿女英雄传》第二回"},"similar":["轻车简从"],"opposite":["前呼后拥"],"usage":"作谓语、定语、宾语；指行装简单"},{"id":43014,"word":"轻鸡爱鹜","pinyin":"qīng jì ài wù","abbr":"qjaw","explanation":"鹜：鸭子。轻视鸡而爱野鸭子。比喻贵远贱近。","source":{"text":"小儿辈厌家鸡，爱野雉，皆学逸少书。","book":"晋·何法盛《晋中兴书》卷七"},"example":{"text":"爱屋及乌，谓因此而惜彼；轻鸡爱鹜，谓舍此而图他。","book":"清·程允升《幼学琼林·鸟兽》"}},{"id":43015,"word":"载一抱素","pinyin":"zài yī bào sù","abbr":"zybs","explanation":"指坚持一种信仰，固守素志。","source":{"text":"珞珞雪芹，载一抱素。八斗奇才，千秋名著。","book":"王旡生《中国三大小说家论赞》"},"usage":"作谓语、定语；用于处事"},{"id":43016,"word":"载戢干戈","pinyin":"zài jí gān gē","abbr":"zjgg","explanation":"载戢：装运收藏；干戈：古代的两种武器，引申为战争。将武器收藏起来。指不再诉诸武力。","source":{"text":"载戢干戈，载櫜弓矢。","book":"《诗经·周颂·时迈》"},"similar":["干戈载戢"],"usage":"作宾语、定语；指休战"},{"id":43017,"word":"载欢载笑","pinyin":"zài huān zài xiào","abbr":"zhzx","explanation":"形容尽情地欢笑。","source":{"text":"夫听《白雪》之音，观《绿水》之节，然后《东野》《巴人》蚩鄙益著，载欢载笑，欲罢不能。","book":"汉·陈琳《答东阿王笺》"},"usage":"作谓语、状语；用于书面语"},{"id":43018,"word":"载欣载奔","pinyin":"zài xīn zài bēn","abbr":"zxzb","explanation":"载：文言助司；欣：喜悦；奔：快走。一面心里高兴，一面加快脚步。","source":{"text":"乃瞻衡宇，载欣载奔。僮仆来迎，稚子侯门。","book":"晋·陶潜《归去来辞》"},"usage":"作谓语、定语；用于书面语"},{"id":43019,"word":"载歌且舞","pinyin":"zài gē qiě wǔ","abbr":"zgqw","explanation":"边唱歌，边舞蹈。","source":{"text":"饰牲举兽，载歌且舞，既舍伊腯，致精灵府。","book":"《乐府诗集·北齐南郊乐歌·昭夏乐》"},"similar":["载歌载舞"],"usage":"作谓语、状语；用于书面语"},{"id":43020,"word":"载歌载舞","pinyin":"zài gē zài wǔ","abbr":"zgzw","explanation":"载：动词词头，无实义。边唱歌，边跳舞。形容尽情欢乐。","source":{"text":"饰牲举兽，载歌且舞，既舍伊腯，致精灵府。","book":"宋·郭藏倩《乐府诗集·北齐南郊乐歌·昭夏乐》"},"example":{"text":"春节晚会上，穿着节日盛装的各族代表，在舞台上翩翩起舞，欢庆节日。"},"similar":["手舞足蹈","欢欣鼓舞","兴高采烈"],"opposite":["垂头丧气"],"usage":"作谓语、状语；形容欢乐的场面"},{"id":43021,"word":"载沉载浮","pinyin":"zài chén zài fú","abbr":"zczf","explanation":"在水中上下沉浮。","source":{"text":"泛泛杨舟，载沉载浮，既见君子，我心则休。","book":"《诗经·小雅·菁菁者莪》"},"example":{"text":"～，顺流九里，望之无迹。","book":"明·冯梦龙《东周列国志》第70回"},"usage":"作谓语、定语；指沉浮"},{"id":43022,"word":"载笑载言","pinyin":"zài xiào zài yán","abbr":"zxzy","explanation":"边笑边说话。","source":{"text":"于是回旋详观，目周意倦，御于方舟，载笑载言。","book":"汉·杨修《节游赋》"},"example":{"text":"不见复关，泣涕涟涟；及见复关，～。","book":"唐·孙文成《游仙窟》"},"usage":"作谓语、定语、状语；指人的状态"},{"id":43023,"word":"载舟覆舟","pinyin":"zài zhōu fù zhōu","abbr":"zzfz","explanation":"民众犹如水，可以承载船，也可以倾覆船。比喻人民是决定国家兴亡的主要力量。","source":{"text":"传曰：‘君者舟也，庶人者水也，水则载舟，水则覆舟。’此之谓也。","book":"《荀子·王制》"},"example":{"text":"怨不在大，可畏惟人。～，报宜深慎。","book":"唐·魏征《谏太宗十思疏》"},"similar":["水可载舟，亦可覆舟"],"usage":"作定语、分句；比喻民心向背的重要性"},{"id":43024,"word":"载誉而归","pinyin":"zài yù ér guī","abbr":"zyeg","explanation":"载：装载。获得荣誉后归来。","example":{"text":"是弟的那一个侥幸活了下来并且～。（梁晓声《泯灭》五）"}},{"id":43025,"word":"载道怨声","pinyin":"zài dào yuàn shēng","abbr":"zdys","explanation":"载：充满。道路上充满了怨恨的声音。形容人民群众普遍强烈不满。","source":{"text":"开门受赂，署用非次，天下纷然，怨声满道。","book":"《诗经·大雅·生民》：“实覃实訏，厥声载路。”《后汉书·李固传》"},"example":{"text":"笑雌黄舌饶，黑符心骄，绿豆儿眼小，博得个～碧汉高。（清·感惺《断头台·受谳》）"},"similar":["怨声载道","怨声载路","怨声盈路"],"usage":"作宾语、定语；指极为不满"},{"id":43026,"word":"载酒问字","pinyin":"zài jiǔ wèn zì","abbr":"zjwz","explanation":"载：携带。带着酒去别人家问字。指人有学问，常有人登门求教。也比喻勤学好问。","source":{"text":"家素贫，嗜酒，人希至门。时有好事者载酒肴从游学。”又，“乃刘棻尝从雄学作奇字。","book":"《汉书·扬雄传下》"},"example":{"text":"好事之徒，载酒而问人奇字。","book":"清·程允升《幼学琼林·饮食》"},"usage":"作宾语、定语；比喻勤学好问","story":["西汉时期，著名辞赋家扬雄因为生病而退养，后来被任命为大夫。他家十分贫穷，特别馋酒，人们很少登他家门。当时也有未出道的书生慕着他的名气，带着酒菜到他家去求教，他总是耐心教导。刘棻曾经跟从扬雄学作奇字就是一例"]},{"id":43027,"word":"载驰载驱","pinyin":"zǎi chí zǎi qū","abbr":"zczq","explanation":"指车马疾行。","source":{"text":"载驰载驱，聊以忘忧。","book":"《诗·鄘风·载驰》：“载驰载驱，归唁卫侯。”高亨注：“载，犹乃也，发语词。载、驱，车马疾行。”三国·魏·曹丕《善哉行》之一"},"example":{"text":"三国·魏·曹丕《善哉行》：“～，聊以忘忧。”"},"similar":["载驱载驰"],"usage":"作谓语、定语；用于书面语"},{"id":43028,"word":"载驱载驰","pinyin":"zài qū zài chí","abbr":"zqzc","explanation":"指车马疾行。","source":{"text":"矫矫乘马，载驱载驰。","book":"晋·陆云《答兄平原》诗"},"similar":["载驰载驱"],"usage":"作谓语、定语；用于书面语"},{"id":43029,"word":"载鬼一车","pinyin":"zài guǐ yī chē","abbr":"zgyc","explanation":"载：装载。装了一车鬼。形容十分荒诞离奇。","source":{"text":"上九：睽孤，见豕负涂，载鬼一车。","book":"《周易·睽》"},"example":{"text":"妄诞之言，载鬼一车；高明之家，鬼瞰其室。（明·程登吉《幼学琼林·释道鬼神》）"},"usage":"作宾语、定语；用于比喻句"},{"id":43030,"word":"辀张跋扈","pinyin":"zhōu zhāng bá hù","abbr":"zzbh","explanation":"辀张：强横。专横暴戾。","source":{"text":"功在不赏，辀张跋扈，遂搆凶逆耳。","book":"《晋书·张华传》"},"usage":"作谓语、定语；用于书面语"},{"id":43031,"word":"辁才小慧","pinyin":"quán cái xiǎo huì","abbr":"qcxh","explanation":"辁：没有辅条的车轮；辁才：小才。指见识少才能低下不堪重任。","source":{"text":"而辁才小慧之徒，则又号召张皇，重杀之以物质而囿之以多数，个人之性，剥夺无余。","book":"鲁迅《文化偏至论》"},"usage":"作谓语、定语；指庸才"},{"id":43032,"word":"较如画一","pinyin":"jiào rú huà yī","abbr":"jrhy","explanation":"指规章法令一致。","source":{"text":"萧何为法，较若画一，曹参代之，守而勿失。","book":"汉·荀悦《汉纪·惠帝纪》"},"example":{"text":"怀柔万姓，经营四方。举直措枉，～。","book":"《梁书·武帝纪上》"},"similar":["较若画一"],"usage":"作谓语、定语；用于书面语"},{"id":43033,"word":"较德焯勤","pinyin":"jiào dé zhuō qín","abbr":"jdzq","explanation":"显著的德行和功劳。","source":{"text":"自我公薨至葬，凡所以较德焯勤者，莫不粗完。","book":"唐·韩愈《刘统军碑》"},"example":{"text":"濂闻～在古者，不厌其详，故为表其行而益之以铭。","book":"明·宋濂《教授曾府君石表辞》"},"usage":"作定语、宾语；用于书面语"},{"id":43034,"word":"较时量力","pinyin":"jiào shí liàng lì","abbr":"jsll","explanation":"衡量时机和实力。","source":{"text":"又须审度彼己，较时量力，定为几年之规，若孟子大国五年小国七年之说。","book":"宋·朱熹《答张敬夫书》"},"usage":"作谓语、宾语；用于处事"},{"id":43035,"word":"较武论文","pinyin":"jiào wǔ lùn wén","abbr":"jwlw","explanation":"较：比较，评论。评论武艺，谈论文章。","source":{"text":"此书讲道学，筹经济谈天测地，较武论文，无不原原本本，穷极要妙，此其本领之大也。","book":"清·夏敬渠《野叟曝言》第四十七回"},"usage":"作谓语、宾语；指考校武艺，谈论文章"},{"id":43036,"word":"较瘦量肥","pinyin":"jiào shòu liàng féi","abbr":"jslf","explanation":"比较肥瘦。比喻评论姿容。","source":{"text":"何曾见侯门娇丽，肯容人较瘦量肥。","book":"清·李渔《风筝误·贺岁》"},"usage":"作谓语、定语、宾语；用于评论等"},{"id":43037,"word":"较短比长","pinyin":"jiào duǎn bǐ cháng","abbr":"jdbc","explanation":"指比较长短，评论优劣。同“较短量长”。","source":{"text":"看近来，西洋人，到了极步，这是我，毫未曾，较短比长。","book":"清·陈天华《猛回头》"},"similar":["较短量长"],"usage":"作谓语、宾语；用于比较"},{"id":43038,"word":"较短絜长","pinyin":"jiào duǎn xié cháng","abbr":"jdxc","explanation":"指比较高低。","source":{"text":"当斯时也，君子道消，小人道长，谁敢与之较短絜长哉？","book":"清·蒋恩《兵灾纪略》"},"similar":["较长絜短"],"usage":"作谓语；用于比较"},{"id":43039,"word":"较短量长","pinyin":"jiào duǎn liáng cháng","abbr":"jdlc","explanation":"指比较长短，评论优劣。","source":{"text":"较短量长，惟器是适者，宰相之方也。","book":"唐·韩愈《进学解》"},"example":{"text":"歌清舞妙，尽开怀抱。又何须～，此生心应自有天知道。","book":"明·徐有贞《水龙吟》词"},"similar":["较短比长"],"usage":"作谓语、宾语；用于比较"},{"id":43040,"word":"较若画一","pinyin":"jiào ruò huà yī","abbr":"jrhy","explanation":"指明确一致。","source":{"text":"萧何薨，曹参代之。百姓歌之曰：萧何为法，较若画一。曹参代之，守而勿失。","book":"《文选·班固〈西都赋〉》：“作画一之歌”李善注引《汉书》"},"example":{"text":"辩方正位，纳之轨度，蠲削烦苛，～，淳风美化，盈塞宇宙。","book":"南朝·梁·沈约《宋书·武帝纪中》"},"similar":["较如画一"],"usage":"作谓语、定语；用于书面语"},{"id":43041,"word":"较长絜短","pinyin":"jiào cháng xié duǎn","abbr":"jcxd","explanation":"指比较高低。同“较短絜长”。","source":{"text":"师其所长而掩其所短，变欲求立乎泰西诸大国之间，而与之较长絜短而无所馁也。","book":"清·王韬《变法自强下》"},"similar":["较短絜长"],"usage":"作谓语；用于比较"},{"id":43042,"word":"辄作数日恶","pinyin":"zhé zuò shù rì è","abbr":"zzsre","explanation":"辄：总是；恶：难受。动不动就接连几天不舒服。形容因受外界刺激而感到难受。","source":{"text":"谢太傅语王右军曰：‘中年丧于哀乐，与亲友别，辄作数日恶。’王曰：‘年在桑榆，自然至此，正赖丝竹陶写，恒恐儿辈觉，损欣乐之趣。’","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"余览白乐天《长恨歌》及元人《秋雨梧桐》剧，～。（清·洪昇《长生殿·自序》）"},"usage":"作谓语；用于书面语"},{"id":43043,"word":"辄鲋之急","pinyin":"zhé fù zhī jí","abbr":"zfzj","explanation":"比喻困厄迫身。","source":{"text":"车辙中有鲋鱼焉，曰：‘我东海之波臣也，君岂有斗升之水而活我哉。’","book":"《庄子·外物》"}},{"id":43044,"word":"辅世长民","pinyin":"fǔ shì zhǎng mín","abbr":"fszm","explanation":"辅世：辅佐当世的国君。长民：统治人民。辅佐当世的国君统治人民。","source":{"text":"天下有达尊三，爵一，齿一，德一。朝廷莫如爵，乡党莫如齿，辅世长民莫如德。","book":"《孟子·公孙丑下》"},"example":{"text":"意者太平之治，将从此见端，则必有～者出，而郑公其番番者耶？（清·侯方域《赠郑大夫序》）"},"usage":"作谓语、定语；指辅佐君主治国"},{"id":43045,"word":"辅弼之勋","pinyin":"fǔ bì zhī xūn","abbr":"fbzx","explanation":"弼：辅助；勋：功劳。辅助国家的功劳。","source":{"text":"以亲则君有辅弼之勋焉，以贤则君有醇固之茂焉。","book":"《三国志·魏志·何夔传》"},"usage":"作宾语；指人的功劳"},{"id":43046,"word":"辅牙相倚","pinyin":"fǔ yá xiāng yǐ","abbr":"fyxy","explanation":"颊骨与牙床相互倚傍。比喻关系密切，利害相关。","source":{"text":"本名怀玉，至是赐今名，遂有淄、青、齐、海、登、菜、沂、密、德、棣十州，与田承嗣、薛嵩、李宝臣、梁崇义辅牙相倚。","book":"《新唐书·藩镇传·李正己》"},"similar":["辅车相依","辅车相将"],"usage":"作谓语、定语；比喻两者关系密切，互相依存"},{"id":43047,"word":"辅车唇齿","pinyin":"fǔ chē chún chǐ","abbr":"fccc","explanation":"辅：嘴旁颊骨。车：牙床，即牙床骨。颊骨和牙床骨，嘴唇和牙齿。指相互依存的双方。","source":{"text":"谚所谓‘辅车相依，脣亡齿寒’者，其虞虢之谓也。”所谓‘辅车相依，唇亡齿寒’者，其虞虢之谓也。","book":"语出《左传·僖公五年》"},"example":{"text":"拙著之《甲骨文字研究》与此自是～。","book":"郭沫若《中国古代社会研究》第三篇第二章"},"usage":"作宾语、定语；指相互依存的双方"},{"id":43048,"word":"辅车相依","pinyin":"fǔ chē xiāng yī","abbr":"fcxy","explanation":"辅：颊骨；车：齿床。颊骨和齿床互相依靠。比喻两者关系密切，互相依存。","source":{"text":"谚所谓‘辅车相依，唇亡齿寒’者，其虞、虢之谓也。","book":"《左传·僖公五年》"},"example":{"text":"以言政党，犹非其时；若云～，以排一党专制之势，则薄有消长耳。","book":"章炳麟《致梁启超书》"},"similar":["辅牙相倚","唇齿相依","辅车相将"],"opposite":["反目成仇"],"usage":"作谓语、定语；比喻两者关系密切，互相依存"},{"id":43049,"word":"辅车相将","pinyin":"fǔ chē xiāng jiāng","abbr":"fcxj","explanation":"比喻两者关系密切，互相依存。同“辅车相依”。","source":{"text":"面蜀肘凉，辅车相将。","book":"清·叶方蔼《关陇平》诗"},"similar":["辅牙相倚","辅车相依"],"usage":"作谓语、定语；用于两者关系密切"},{"id":43050,"word":"辇毂之下","pinyin":"niǎn gòu zhī xià","abbr":"ngzx","explanation":"辇毂：帝王的车驾。在天子治下。引申为京都、帝都。","source":{"text":"仆赖先人绪业，得待罪辇毂下二十余年矣！","book":"汉·司马迁《报任少卿书》"},"example":{"text":"贪墨之夫，吸民之髓，括地之皮，在皇帝～，敢于恣赃以逞。","book":"清·西周生《醒世姻缘传》第17回"},"similar":["京辇之下"],"usage":"作主语、宾语；指京城"},{"id":43051,"word":"辉光日新","pinyin":"huī guāng rì xīn","abbr":"hgrx","explanation":"常指一个人在道德、文学、艺术等方面日有长进。","source":{"text":"刚健笃实，辉光日新。","book":"《周易·大畜》"},"example":{"text":"明白淳粹，～者，惟吾崔君一人。","book":"唐·韩愈《与崔群书》"},"similar":["晖光日新"],"usage":"作谓语、定语；指一个人在道德、文学、艺术"},{"id":43052,"word":"辉煌夺目","pinyin":"huī huáng duó mù","abbr":"hhdm","explanation":"夺目：耀眼。形容鲜艳耀眼。也用来形容某些艺术作品和艺术形象的极高成就。","source":{"text":"只见四壁排列的，都是周彝商鼎，奇巧玩物，辉煌夺目。","book":"清·褚人获《隋唐演义》第二回"},"similar":["光彩夺目"],"usage":"作谓语、状语、定语；用于事物或功绩等"},{"id":43053,"word":"辉煌金碧","pinyin":"huī huáng jīn bì","abbr":"hhjb","explanation":"形容建筑物等非常华丽灿烂。","source":{"text":"两面的房屋，都是画栋雕梁，辉煌金碧。","book":"清·彭养鸥《黑籍冤魂》第十五回"},"similar":["金碧辉煌"],"usage":"作谓语、宾语、定语；指光彩夺目"},{"id":43054,"word":"辍毫栖牍","pinyin":"chuò háo qī dú","abbr":"chqd","explanation":"停笔藏牍，指停止写作。牍，古代写字用的狭长木板。","example":{"text":"因受的打击太大，他已经辍毫栖牍了。"}},{"id":43055,"word":"辍食吐哺","pinyin":"chuò shí tǔ bǔ","abbr":"cstb","explanation":"辍：停止；哺：口中的食物。停止用饭，吐出口中含的食物。","source":{"text":"汉王辍食吐哺，骂曰：‘竖儒，几败而公事！’","book":"西汉·司马迁《史记·留侯世家》"},"opposite":["狼吞虎咽"],"usage":"作谓语；指人饭中发怒"},{"id":43056,"word":"辑志协力","pinyin":"jí zhì xié lì","abbr":"jzxl","explanation":"指同心合力。"},{"id":43057,"word":"输心服意","pinyin":"shū xīn fú yì","abbr":"sxfy","explanation":"犹言真心顺从。","source":{"text":"明锋争利芥针，投暗暗输心服意。","book":"明·罗贯中《平山冷燕》第十六回"},"example":{"text":"玉飞见妹子貌美异常，～，再见他举止安详，更兼出言和雅。","book":"清·天花才子《快心编三集》第五回"},"usage":"作定语、状语；用于处事"},{"id":43058,"word":"输攻墨守","pinyin":"shū gōng mò shǒu","abbr":"sgms","explanation":"输：公输般，即战国时期有名木匠“鲁般”；墨：墨子，战国时期思想家。比喻攻守双方力量相仿，各显神通。","source":{"text":"子墨子解带为城，以牒为械，公输般九设攻城之机变，子墨子九拒之。公输般之攻械尽，子墨子守御有余。","book":"战国·宋·墨翟《墨子·公输》"},"similar":["各显神通"],"usage":"作宾语、定语；指各显神通","story":["战国时期，木匠出身的墨翟主张兼爱与非攻，到处推广他的学说。楚国要去攻打宋国，鲁班为楚军设计攻城的云梯。墨子急忙去劝阻这场战争，楚王让墨子与鲁班比试比试攻防演习，墨子善于防守，鲁班败北。楚王只好放弃攻打宋国"]},{"id":43059,"word":"输泻跳蹙","pinyin":"shū xiè tiào cù","abbr":"sxtc","explanation":"泻：很快地流；蹙：紧迫。形容水流湍急，一泻千里。","source":{"text":"作输泻跳蹙之势，汹汹欲崩屋也。","book":"宋·苏轼《书蒲永升画后文》"}},{"id":43060,"word":"输肝写胆","pinyin":"shū gān xiě dǎn","abbr":"sgxd","explanation":"比喻对人极为忠诚。同“输肝剖胆”。","source":{"text":"当陛下旰食宵衣之日，是微臣输肝写胆之时。","book":"唐·白居易《杭州刺史谢上表》"},"similar":["输肝沥胆","输肝剖胆"],"usage":"作谓语、定语、状语；指非常忠诚"},{"id":43061,"word":"输肝剖胆","pinyin":"shū gān pōu dǎn","abbr":"sgpd","explanation":"比喻诚心待人。","source":{"text":"君不见昔时燕家重郭隗，拥篲折腰无嫌猜，剧辛、乐毅感恩分，输肝剖胆效英才。","book":"唐·李白《行路难》诗"},"example":{"text":"宋·秦观《代蕲守谢上表》：“复路迴车，顾迷途其未远；～，庶报效之可图。”"},"similar":["输肝沥胆","披肝沥胆"],"usage":"作谓语、定语、状语；指非常忠诚"},{"id":43062,"word":"输肝沥胆","pinyin":"shū gān lì dǎn","abbr":"sgld","explanation":"比喻诚心待人。","source":{"text":"君不见昔时燕家重郭隗，拥篲折腰无嫌猜，剧辛、乐毅感恩分，输肝剖胆效英才。","book":"唐·李白《行路难》诗"},"similar":["输肝剖胆","披肝沥胆","输肝写胆"],"usage":"作谓语、定语、状语；指非常忠诚"},{"id":43063,"word":"输财助边","pinyin":"shū cái zhù biān","abbr":"sczb","explanation":"输：捐献；边：边防。捐献财物作巩固边防的费用。","source":{"text":"时汉方事匈奴，式上书，愿输家财半助边。","book":"《汉书·卜式传》"},"similar":["助边输财"],"usage":"作谓语、定语；指为国分忧"},{"id":43064,"word":"辗转伏枕","pinyin":"zhǎn zhuǎn fú zhěn","abbr":"zzfz","explanation":"辗转：翻来复去；伏枕：伏卧在枕头上。翻来复去，难以入睡。","source":{"text":"寤寐无为，辗转伏枕。","book":"《诗经·陈风·泽陂》"},"similar":["展转反侧","辗转反侧"],"usage":"作谓语、定语、状语；用于处事"},{"id":43065,"word":"辗转反侧","pinyin":"zhǎn zhuǎn fǎn cè","abbr":"zzfc","explanation":"辗转：翻来复去；反侧：反复。翻来复去，睡不着觉。形容心里有所思念或心事重重。","source":{"text":"悠哉悠哉，辗转反侧。","book":"《诗经·周南·关雎》"},"example":{"text":"我心里又想起母亲的劳苦，～睡不着，很想起来陪陪母亲。","book":"邹韬奋《我的母亲》"},"similar":["翻来复去","夜不成眠"],"opposite":["高枕无忧"],"usage":"作谓语、状语；指睡不着觉","story":["在很久以前，一个青山环绕的河湾里有一个美丽的小岛，岛上住着一个美丽的姑娘，一个小伙子划船经过，听到姑娘那美妙动听的歌声，躺在船上辗转反侧，就是不能入睡，他想了很多的办法去接近那位姑娘，终于结为夫妻"]},{"id":43066,"word":"辗转思念","pinyin":"zhǎn zhuǎn sī niàn","abbr":"zzsn","explanation":"辗转：翻来复去。翻来复去一直想着。形容思念极为深切。","source":{"text":"朕因姜皇后行香到此，寡人见卿容貌妖娆，出世无比，辗转思念。","book":"元·无名氏《武王伐纣平话》卷上"},"example":{"text":"又在小屋的西南角栽上一排望日莲，叫它们站在河流的旁边，～着远方的行人……（孙犁《风云初记》一）"},"usage":"作谓语、定语；用于书面语"},{"id":43067,"word":"辗转推托","pinyin":"zhǎn zhuǎn tuī tuō","abbr":"zztt","explanation":"辗转：经过许多人或许多地方。反复拖延推辞。","source":{"text":"辗转推托，遂及半年。","book":"明·瞿佑《剪灯新话·三山福地志》"}},{"id":43068,"word":"辗转相传","pinyin":"zhǎn zhuǎn xiāng chuán","abbr":"zzxc","explanation":"辗转：多次转移。指多次转移传布。","source":{"text":"影响不论大小，辗转相传，永远有人受益，而且生命永在，撒布生命的人也可以不朽。","book":"巴金《怀念·忆施居甫》"},"example":{"text":"影响不论大小，～，永远有人受益，而且生命永在，撒布生命的人也可以不朽。","book":"巴金《怀念·忆施居甫》"},"usage":"作谓语、定语；用于书面语"},{"id":43069,"word":"辘辘远听","pinyin":"lù lù yuǎn tīng","abbr":"llyt","explanation":"辘辘：车行的声音。车声越听越远。","example":{"text":"～了，他才依依不舍地离开。"},"usage":"作定语；用于书面语"},{"id":43070,"word":"辙乱旂靡","pinyin":"zhé luàn qí mǐ","abbr":"zlqm","explanation":"形容军队溃败逃窜。同“辙乱旗靡”。"},{"id":43071,"word":"辙乱旗靡","pinyin":"zhé luàn qí mǐ","abbr":"zlqm","explanation":"辙：车辙；靡：倒下。车辙错乱，旗子倒下。形容军队溃败逃窜。","source":{"text":"吾视其辙乱，望其旗靡，故逐之。","book":"《左传·庄公十年》"},"example":{"text":"阵势一动，～，眼见得无法支持，纷纷败走。","book":"蔡东藩、许廑父《民国通俗演义》第二十七回"},"similar":["靡旗乱辙"],"usage":"作谓语、定语；用于军事或集体活动"},{"id":43072,"word":"辙环天下","pinyin":"zhé huán tiān xià","abbr":"zhtx","explanation":"乘车环游天下。","source":{"text":"昔者孟轲好辩，孔道以明，辙环天下，卒老干行。","book":"唐·韩愈《进学解》"},"usage":"作谓语、定语；用于书面语"},{"id":43073,"word":"辙鲋之急","pinyin":"zhé fù zhī jí","abbr":"zfzj","explanation":"辙鲋：陷在干涸车辙中的鲫鱼。比喻因厄迫身","source":{"text":"车辙中有鲋鱼焉，曰‘我东海之波臣也，君岂有斗升之水而活我哉！’","book":"战国·宋·庄周《庄子·外物篇》"},"usage":"作宾语；用于比喻句"},{"id":43074,"word":"辛壬癸甲","pinyin":"xīn rén guǐ jiǎ","abbr":"xrgj","explanation":"用以指一心为公，置个人利益于不顾的精神。","source":{"text":"[夏禹]辛日娶妻，至于甲日，复往治水，不以么害公。","book":"典出《书·益稷》：“娶于涂山，辛壬癸甲。”孔传"},"example":{"text":"～今何有？且向东门牵黄狗。","book":"清邹容《涂山》诗"},"usage":"作宾语、定语；用于书面语"},{"id":43075,"word":"辛辛苦苦","pinyin":"xīn xīn kǔ kǔ","abbr":"xxkk","explanation":"辛辣艰苦。比喻艰难困苦。","source":{"text":"我们辛辛苦苦的，里头赚些东西，也是应当的。难得是贼偷的不成？","book":"清·曹雪芹《红楼梦》第60回"},"example":{"text":"哪怕是～的官僚主义也好，哪怕是艰苦奋斗的命令主义也好，都在反对之列。","book":"邓小平《在西南区新闻工作会议上的报告》"},"opposite":["轻轻松松","舒舒服服"],"usage":"作定语、状语；指人的生活"},{"id":43076,"word":"辜恩背义","pinyin":"gū ēn bèi yì","abbr":"geby","explanation":"辜：辜负；背：违反，违背。辜负别人的恩德，做出对不起别人的事情。","source":{"text":"今为此传，非徒述美丽，窒祸源，且欲惩戒辜恩背义之类也。","book":"宋·乐史《绿珠传》"},"similar":["辜恩负义"],"opposite":["感恩戴德"],"usage":"作谓语、定语；指忘恩负义"},{"id":43077,"word":"辜恩负义","pinyin":"gū ēn fù yì","abbr":"gefy","explanation":"忘恩负义。","source":{"text":"畜生反面目，太心毒；辜恩负义难容恕，真堪恶。","book":"元·柯丹邱《荆钗记·觅真》"},"example":{"text":"我不想背上～的罪名。"},"similar":["忘恩负义"],"opposite":["感恩戴德"],"usage":"作谓语、定语；指忘恩负义"},{"id":43078,"word":"辞不意逮","pinyin":"cí bù yì dǎi","abbr":"cbyd","explanation":"逮：达到。言辞不能把思想确切表达出来。","source":{"text":"至预作数语以状风景胜概，辞不意逮，笔随句阁，良可慨叹。","book":"宋·刘学箕《松江哨遍》词序"},"similar":["辞不达意"],"usage":"作谓语、定语；用于说话或作文等"},{"id":43079,"word":"辞不获命","pinyin":"cí bù huò mìng","abbr":"cbhm","explanation":"指辞谢而未获允许。","source":{"text":"鲁君谓葂也曰：‘请受教。’辞不获命，既已告矣，未知中否。","book":"《庄子·天地》"},"example":{"text":"卫交军文子问二三子之于赐，天壹而三焉，赐也～，以所见者对矣。","book":"《孔子家语·弟子行》"},"similar":["辞不获己"],"usage":"作谓语、定语；用于书面语"},{"id":43080,"word":"辞不达义","pinyin":"cí bù dá yì","abbr":"cbdy","explanation":"指说话写文章不能确切地表达意思。","source":{"text":"辞多则史，少则不达，辞苟足以达义之至也。","book":"语出《仪礼·聘礼》"},"example":{"text":"语言糊涂曰～。","book":"清顾张思《土风录》卷十二"},"similar":["辞不达意"],"opposite":["言必有中"],"usage":"作谓语、宾语、状语；指表达不当"},{"id":43081,"word":"辞不达意","pinyin":"cí bù dá yì","abbr":"cbdy","explanation":"辞：言辞；意：意思。指词句不能确切地表达出意思和感情。","source":{"text":"盖五百年而书功烈者，辞不达意，余尝叹息之。","book":"《仪礼·聘礼》：“辞多则史，少则不达，辞苟足以达义之至也。”宋·惠洪《高安城隍庙记》"},"example":{"text":"大概学作文时，总患～。","book":"鲁迅《两地书》一一"},"similar":["词不达意","言不及辞"],"opposite":["言必有中"],"usage":"作谓语、宾语；用于说话与写作"},{"id":43082,"word":"辞严义正","pinyin":"cí yán yì zhèng","abbr":"cyyz","explanation":"辞：言词，语言。义：道理。言辞严厉，义理正大。","source":{"text":"欧公书岂惟翰墨之妙，而辞严义正，千载之下，见者兴起，某何足以辱公此赐也哉。","book":"宋·张孝祥《明守赵敷文》"},"example":{"text":"所不同的，只是他总有一面～的军旗，还有一条尤其义正辞言的逃路。","book":"鲁迅《华盖集续编·有趣的消息》"},"similar":["义正辞严"],"usage":"作谓语、定语、状语；同“义正严辞”"},{"id":43083,"word":"辞严意正","pinyin":"cí yán yì zhèng","abbr":"cyyz","explanation":"言辞严厉，义理正大。同“辞严义正”。","source":{"text":"辞严意正质非俚，古味虽淡醇不薄。","book":"宋·欧阳修《读张李二生文赠石先生》诗"},"similar":["辞严谊正"],"usage":"作谓语、定语；用于处事"},{"id":43084,"word":"辞严气正","pinyin":"cí yán qì zhèng","abbr":"cyqz","explanation":"言辞严厉，义理正大。同“辞严义正”。","source":{"text":"建中雅量却敌，辞严气正，尤为厅伟。","book":"《宋史·孙长卿楚建中等传论》"},"similar":["辞严义正","辞严谊正"],"usage":"作谓语、定语；用于处事"},{"id":43085,"word":"辞严谊正","pinyin":"cí yán yì zhèng","abbr":"cyyz","explanation":"言辞严厉，义理正大。同“辞严义正”。","source":{"text":"蕃武忠君爱国，辞严谊正，不暇自恤，枚蹈危机，其失在于疏尔。","book":"元·刘壎《隐居通议·诗歌六》"},"similar":["辞严气正","辞严意正"],"usage":"作谓语、定语；用于处事"},{"id":43086,"word":"辞丰意雄","pinyin":"cí fēng yì xióng","abbr":"cfyx","explanation":"指文辞丰富，意气雄健。","source":{"text":"非夫辞丰意雄，霈然有不可御之势。","book":"宋·欧阳修《答吴充秀才书》"},"usage":"作谓语、定语；用于说话或作文等"},{"id":43087,"word":"辞喻横生","pinyin":"cí yù héng shēng","abbr":"cyhs","explanation":"辞：言词；喻：比喻。言词中生动的比喻横逸而出。","source":{"text":"亦或辩口利舌，辞喻横生为胜，或诎弱缀跲，蹥蹇不比者为负。","book":"汉·王充《论衡·物势篇》"},"usage":"作谓语、定语；用于文章等"},{"id":43088,"word":"辞多受少","pinyin":"cí duō shòu shǎo","abbr":"cdss","explanation":"辞：推辞掉。受：接受。推辞不受的多而接受的少。","source":{"text":"宪矜其贫窭，每欲资给之。文举恒自谦逊，辞多受少。","book":"《周书·裴文举传》"},"example":{"text":"我每次给他东西，他都是～。"},"usage":"作宾语；指推辞不受的多而接受的少"},{"id":43089,"word":"辞富居贫","pinyin":"cí fù jū pín","abbr":"cfjp","explanation":"辞：推辞，推却。原指拒绝厚禄，只受薄俸。现形容抛弃优厚待遇，甘于清贫的生活。","source":{"text":"仕非为贫也，而有时乎为贫；娶妻非为养也，而有时乎为养。为贫者，辞尊居卑，辞富居贫。辞尊居卑，辞富居贫，恶乎宜乎？抱关击柝。","book":"《孟子·万章下》"},"usage":"作谓语、宾语；用于处世"},{"id":43090,"word":"辞尊居卑","pinyin":"cí zūn jū bēi","abbr":"czjb","explanation":"辞：推却。不受尊位，甘居卑下。","source":{"text":"为贫者，辞尊居卑，辞富居贫。","book":"《孟子·万章下》"},"example":{"text":"所以他在外洋虽赶不上～的大彼得，却可以算乐善好施的小孟尝。","book":"清·李宝嘉《文明小史》第五十七回"},"usage":"作谓语；指不受尊位，甘居卑下"},{"id":43091,"word":"辞巧理拙","pinyin":"cí qiǎo lǐ zhuō","abbr":"cqlz","explanation":"文辞虽然浮华，但不能阐明道理。","source":{"text":"公孙之白马孤犊，辞巧理拙，魏牟比之鸮鸟，非妄贬也。","book":"南朝·梁·刘勰《文心雕龙·诸子》"},"usage":"作谓语、定语；用于文章或说话等"},{"id":43092,"word":"辞微旨远","pinyin":"cí wēi zhǐ yuǎn","abbr":"cwzy","explanation":"辞：文词，言词。微：隐蔽，精深。旨：意思，目的。言词隐微而表达的意思很深远。","source":{"text":"省所撰《春秋》义，比事论书，辞微旨远。","book":"《梁书·刘之遴传》"},"usage":"作谓语、定语；用于说话或文章等"},{"id":43093,"word":"辞无所假","pinyin":"cí wú suǒ jiǎ","abbr":"cwsj","explanation":"辞：文词；假：利用。写文章时用词有所创新，没有因袭前人。形容文章自成一家，有独特的风格。","source":{"text":"斯七子者，于学无所遗，于辞无所假。","book":"三国·魏·曹丕《典论·论文》"}},{"id":43094,"word":"辞旨甚切","pinyin":"cí zhǐ shèn qiè","abbr":"czsq","explanation":"辞旨：言词和意旨。指言谈以及思想都十分恳切。","source":{"text":"厉音正色，辞旨甚切。","book":"《后汉书·郅寿传》"}},{"id":43095,"word":"辞有枝叶","pinyin":"cí yǒu zhī yè","abbr":"cyzy","explanation":"枝叶：比喻琐细的言辞，形容言辞虚美琐细。","source":{"text":"但言辞虚美，如树干之外而更有枝叶也。","book":"西汉·戴圣《礼记·表记》：“辞有枝叶。”孔颖达疏"},"opposite":["词无枝叶"],"usage":"作谓语、定语；用于说话或作文等"},{"id":43096,"word":"辞穷理尽","pinyin":"cí qióng lǐ jìn","abbr":"cqlj","explanation":"辞：文辞；穷：完，尽。无话可说，无理可辩。","source":{"text":"僧问：‘辞穷理尽时如何？’师曰：‘不入理岂同尽。","book":"宋·释道原《景德传灯录·怀州玄泉第二世和尚》"},"similar":["辞穷理极"],"usage":"作谓语、定语；用于说话或作文等"},{"id":43097,"word":"辞穷理屈","pinyin":"cí qióng lǐ qū","abbr":"cqlq","explanation":"理由站不住脚，被驳得无话可说。","source":{"text":"时或言论，人皆依违之，不敢难也；鲜之难必切至，未尝宽假，要须高祖辞穷理屈，然后置之。","book":"《宋书·郑鲜之传》"},"example":{"text":"沙门一闻究览，辞义无谬，以数百言辩而释之，因问宗致。外道～，杜口不酬。","book":"唐·玄奘《大唐西域记·羯罗挐苏伐刺那国》"},"similar":["词穷理屈"],"usage":"作谓语、定语；指理亏"},{"id":43098,"word":"辞穷理极","pinyin":"cí qióng lǐ jí","abbr":"cqlj","explanation":"辞：文辞；穷：完，尽；极：终，到头。无话可说，无理可辩。","source":{"text":"诚愿陛下日月之明，察臣之请，辞穷理极，非如向时避让职事犹在可冒之地。","book":"宋·王安石《辞同修起居注状》"},"similar":["词穷理绝","辞穷理尽"],"usage":"作谓语、定语；用于说话或作文等"},{"id":43099,"word":"辞简义赅","pinyin":"cí jiǎn yì gāi","abbr":"cjyg","explanation":"文辞简要，意义完备。","source":{"text":"诸臣以律文昉自《唐律》，辞简义赅，易致舛讹，于每篇正文后增用总注，疏解律义。","book":"《清史稿·刑法志一》"},"example":{"text":"这篇文章～，让人记忆犹新。"},"similar":["辞简意赅"],"usage":"作谓语、状语、定语；用于说话或作文等"},{"id":43100,"word":"辞简意赅","pinyin":"cí jiǎn yì gāi","abbr":"cjyg","explanation":"简：简练；赅：完备。言辞简练，意思完备。","source":{"text":"诸臣以律文昉自《唐律》，辞简意赅，易致舛讹。","book":"《清史稿·刑法制》"},"similar":["言简意赅"],"usage":"作谓语、状语、补语；用于说话或作文等"},{"id":43101,"word":"辞简意足","pinyin":"cí jiǎn yì zú","abbr":"cjyz","explanation":"文辞简炼而意思却很充足。","source":{"text":"如此数卷，辞简意足，一坐骇然。","book":"元·白珽《湛园静语·叶水心》"},"similar":["辞简意赅"],"usage":"作谓语、状语；用于说话或作文等"},{"id":43102,"word":"辞简理博","pinyin":"cí jiǎn lǐ bó","abbr":"cjlb","explanation":"辞：文词；博：大，深。虽然言词简单扼要，但说理十分深刻。","source":{"text":"可谓辞简而理博矣。","book":"《资治通鉴·晋记二十五》"}},{"id":43103,"word":"辞致雅赡","pinyin":"cí zhì yǎ shàn","abbr":"czys","explanation":"辞致：文辞的意境和情调；赡：充裕。指文辞的立意和情调高雅脱俗。","source":{"text":"博涉群书，好为词赋，尝献梁元帝《荆州颂》，辞致雅赡。","book":"《北史·颜之仪传》"}},{"id":43104,"word":"辞趣翩翩","pinyin":"cí qù piān piān","abbr":"cqpp","explanation":"辞趣：文辞的意趣；翩翩：形容风致、文采的优美。指文辞的意趣很优美。","source":{"text":"辞坡翩翩，足有才藻。","book":"南朝·齐·萧子良《与南郡太守刘景蕤书》"}},{"id":43105,"word":"辞鄙意拙","pinyin":"cí bǐ yì zhuō","abbr":"cbyz","explanation":"鄙：粗俗、低劣；义：意思；拙：拙劣。文词庸俗，立意拙劣。","source":{"text":"牛角之歌，词鄙而意拙。","book":"唐·韩愈《上兵部李侍郎书》"}},{"id":43106,"word":"辞金蹈海","pinyin":"cí jīn dǎo hǎi","abbr":"cjdh","explanation":"比喻不慕富贵，慷慨有气节。","source":{"text":"《史记·鲁仲连邹阳列传》载：战国时，秦军围赵都邯郸，齐人鲁仲连以利害进说赵魏大臣，劝阻尊秦昭王为帝，并表示若秦王为帝，则自己将蹈东海而死。秦军退后，赵平原君以千金谢之，鲁仲连却不受，以为为人排难解纷而取酬，是商贾之事。"},"example":{"text":"受爵能让，怀～之风；成功不居，从辟谷封留之请。","book":"明·武宗《刘基赠谥太师文成诰》"},"usage":"作定语；指有气节","story":["战国时期，秦国军队攻打赵国，齐人鲁仲连以利害劝说赵魏两国大臣，阻止秦昭王称帝，并表示如果秦昭王称帝，他就跳海而死。秦军败退后，赵国的平原君拿出千金酬谢他，他拒不接受，认为为人排难解纷而索取酬金是商人的作风"]},{"id":43107,"word":"辞顺理正","pinyin":"cí shùn lǐ zhèng","abbr":"cslz","explanation":"道理严正公允，措词简炼。","source":{"text":"及吕壹诛，权又有诏切磋瑾等，语在权传。瑾辄因事以答，辞顺理正。","book":"《三国志·吴志·进葛瑾传》"}},{"id":43108,"word":"辟地开天","pinyin":"pì dì kāi tiān","abbr":"pdkt","explanation":"开：开拓；辟：开辟。古代神话盘古氏开辟天地，创立世界。后比喻有史以来。","source":{"text":"天地混沌如鸡子，盘古生在其中，万八千岁，天地开辟，阳清为天，阴浊为地，盘古在其中一日九变，神于天，圣于地，天日高一丈，地日厚一丈。","book":"三国·吴·徐整《三五历纪》"},"example":{"text":"自思～，成了道果，得此二宝，方欲性修真，在罗浮洞中以证元始。","book":"明·许仲琳《封神演义》第四十七回"},"similar":["开天辟地"],"usage":"作谓语、定语；比喻前所未有的伟大事业"},{"id":43109,"word":"辟恶除患","pinyin":"pì è chú huàn","abbr":"pech","explanation":"辟：祛除。祛除邪恶与祸患。","source":{"text":"今日元吉，理发沐尘，辟恶除患，长生神仙。","book":"宋·张君房《云笈七签》第41卷"},"usage":"作谓语、定语；指为民除害"},{"id":43110,"word":"辟踊哭泣","pinyin":"pì yǒng kū qì","abbr":"pykq","explanation":"辟：通“擗”，以手拍击胸膛；踊：用脚顿地。捶着胸跺着脚大哭。形容极度哀伤地痛哭。","source":{"text":"衰绖管屦，辟踊哭泣，所以谕哀也。","book":"西汉·刘安《淮南子·主术训》"},"similar":["擗踊哭泣","擗踊号叫","擗踊号呼"],"usage":"作谓语、宾语；用于悲伤时"},{"id":43111,"word":"辨如悬河","pinyin":"biàn rú xuán hé","abbr":"brxh","explanation":"辨，通“辩”。犹言口若悬河。","source":{"text":"故士有读书万卷，辨如悬河，而不免为陋儒……唯其不合于大公至正之道故也。","book":"金·王若虚《后序》"},"similar":["能言善辩","辨若悬河"],"usage":"作谓语、定语；指人能言善辩"},{"id":43112,"word":"辨日炎凉","pinyin":"biàn rì yán liáng","abbr":"bryl","explanation":"古代传说中辩论太阳离地远近的故事。后以之形容兒童的聪明早慧。","source":{"text":"孔子东游，见两小兒辩斗。问其故，……一兒曰：‘日初出，大如车盖，及日中，则如盘盂：此不为远者小而近者大乎？’一兒曰：‘日初出，沧沧凉凉；及其日中，如探汤：此不为近者热而远者凉乎？’孔子不能决也。","book":"《列子·汤问》"}},{"id":43113,"word":"辨物居方","pinyin":"biàn wù jū fāng","abbr":"bwjf","explanation":"辨别众物的性质、条件等因素，使之各得其所。","source":{"text":"辨别众物，各居其方，使皆得安其所。","book":"《易·未济》：“君子以慎辨物居方。”孔颖达疏"},"example":{"text":"夫明哲之士者，威而不慑，困而能通，决嫌定疑，～。","book":"汉徐斡《中论·智行》"},"usage":"作谓语、宾语；指要具体看待事物"},{"id":43114,"word":"辨若悬河","pinyin":"biàn ruò xuán hé","abbr":"brxh","explanation":"辨，通“辩”。犹言口若悬河。","source":{"text":"吾见一人焉，辨若悬河，藻若春工；含吐邹枚，方驾陆谢。","book":"明·张居正《翰林院读书说》"},"similar":["辨如悬河"],"usage":"作谓语、定语；指人能言善辩"},{"id":43115,"word":"辩口利舌","pinyin":"biàn kǒu lì cí","abbr":"bkls","explanation":"指能言善辩，伶牙利嘴。","source":{"text":"亦或辩口利舌，辞喻横出为胜。","book":"汉·王充《论衡·物势》"},"similar":["辩口利辞","伶牙俐齿"],"opposite":["笨口拙舌"],"usage":"作宾语、定语；指人能言善辩"},{"id":43116,"word":"辩口利辞","pinyin":"biàn kǒu lì cí","abbr":"bklc","explanation":"指善辩的口才，犀利的言辞。形容能言善辩。","source":{"text":"妇言，不必辩口利辞也。","book":"《后汉书·班昭传》"},"similar":["伶牙俐齿","辩口利舌"],"opposite":["笨嘴拙舌"],"usage":"作宾语、定语；形容能言善辩"},{"id":43117,"word":"辩才无碍","pinyin":"biàn cái wú ài","abbr":"bcwa","explanation":"碍：滞碍。本是佛教用语，指菩萨为人说法，义理通达，言辞流利，后泛指口才好，能辩论。","source":{"text":"《华严经》“若能知法永不灭，则得辩才无障碍；若能辩才无障碍，则能开演无边法。”"},"example":{"text":"这可见韵高的～，说得顽石点头了。","book":"清·曾朴《孽海花》第十三回"},"similar":["能言善辩","口若悬河","辩才无阂"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；形容言辞流畅，能言善辩"},{"id":43118,"word":"辩才无阂","pinyin":"biàn cái wú hé","abbr":"bcwh","explanation":"佛教语。指菩萨为人说法，义理通达，言辞流利，后泛指口才好，能辩论。","source":{"text":"显证一乘，宣扬三慧，辩才无阂，游戏神通。","book":"《艺文类聚》卷七六引南朝梁王筠《国师草堂寺智者约法师碑》"},"similar":["辩才无碍"],"usage":"作谓语、定语；形容能言善辩"},{"id":43119,"word":"辩说属辞","pinyin":"biàn shuō zhǔ cí","abbr":"bssc","explanation":"属辞：撰写文章。用诡辩的的言论撰写文章。","source":{"text":"辩说属辞，饰非诈谋，以钓利于秦，而以韩利窥陛下。","book":"《韩非子·存韩》"}},{"id":43120,"word":"辱国丧师","pinyin":"rǔ guó sàng shī","abbr":"rgss","explanation":"指国家蒙受耻辱，军队遭到损失。","source":{"text":"琼遂劾泽妄增金币，遗书议和，失信启衅，辱国丧师。","book":"《明史·彭泽传》"},"example":{"text":"明·施耐庵《水浒传》第101回：“蔡京经体赞元，其子蔡攸，如是复军杀将，～。”"},"similar":["丧师辱国"],"usage":"作谓语、宾语、定语；用于战败"},{"id":43121,"word":"辱国殃民","pinyin":"rǔ guó yāng mín","abbr":"rgym","explanation":"使国家受辱，人民遭殃。亦作“辱国殄民”。","source":{"text":"韩侂胄居相位一十四年，陷害了赵愚丞相，罢黜道学诸臣，轻开边衅，辱国殃民。","book":"《古今小说·木绵庵郑虎臣报冤》"},"example":{"text":"夷人放肆，无恶不作，皆由官无血性，恬不识羞，以致～。","book":"郭沫若主编《中国近代史》第一章"},"similar":["辱国殄民"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":43122,"word":"辱国殄民","pinyin":"rǔ guó tiǎn mín","abbr":"rgtm","explanation":"使国家受辱，人民遭殃。同“辱国殃民”。","source":{"text":"他日西鄙之伐，辱国殄民，果谁之所致乎！","book":"明·刘基《春秋明经·公子结媵陈人之妇于鄄遂及齐侯宋公盟齐人宋人陈人伐我西鄙》"},"similar":["辱国殃民"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":43123,"word":"辱身败名","pinyin":"rǔ shēn bài míng","abbr":"rsbm","explanation":"指自身受辱，名声败坏。","source":{"text":"一旦失手，辱身败名，是为不智。","book":"《说岳全传》第三一回"},"similar":["身败名裂"],"usage":"作谓语、定语；指人的名声"},{"id":43124,"word":"辱门败户","pinyin":"rǔ mén bài hù","abbr":"rmbh","explanation":"指败坏门风，使家族受到差异辱。","source":{"text":"哥哥，俺是甚等样人家，着他辱门败户。","book":"元李文蔚《燕青博鱼》第一折"},"example":{"text":"留此无益，不若逐回，庶免～。","book":"《清平山堂话本·刎颈鸳鸯会》"},"opposite":["光宗耀祖"],"usage":"作谓语、定语；指败坏门风"},{"id":43125,"word":"边尘不惊","pinyin":"biān chén bù jīng","abbr":"bcbj","explanation":"比喻边境安定无战事。","source":{"text":"上曰：‘隋炀帝劳百姓，筑长城以备突厥，卒无所益。朕唯置李世勣于晋阳而边尘不惊，其为长城，岂不壮哉！","book":"《资治通鉴·唐太宗贞观十五年》"},"example":{"text":"明沈德符《野获编·兵部·蔡见庵宪法使》自此～，西陲寝烽者数岁，蔡坐此，被议罢归。"},"similar":["和平共处"],"opposite":["狼烟四起"],"usage":"作谓语、定语；形容相安无事"},{"id":43126,"word":"辽东之豕","pinyin":"liáo dōng zhī shǐ","abbr":"ldzs","explanation":"辽东：地名，在今辽宁省东南辽河以东；豕：猪。比喻少见多怪。","source":{"text":"伯通自伐，以为功高天下。往时辽东有豕，生子白头，异而献之，行至河东，见群豕皆白，怀惭而还。若以子之功论于朝廷，则为辽东豕也。","book":"《后汉书·朱浮传》"},"example":{"text":"考据之功，非书不可；子贫士也，势不能购尽天下之书，偶有所得，必为～。","book":"清·袁枚《再答黄生》"}},{"id":43127,"word":"辽东白豕","pinyin":"liáo dōng bái shǐ","abbr":"ldbs","explanation":"辽东：地名，在今辽宁省东南辽河以东；豕：猪。比喻少见多怪。","source":{"text":"往时辽东有豕，生子白头，异而献之，行至河东，见群豕皆白，怀惭而还。若以子之功论于朝廷，则为辽东豕也。","book":"南朝·宋·范晔《后汉书·朱浮传》"},"example":{"text":"他就像～一样。"},"similar":["辽东豕"],"usage":"作宾语、定语；指少见多怪","story":["东汉大将彭宠跟随刘秀打天下，并没有得到重用，他不服幽州长官朱浮的调遣想起兵反叛，朱浮写信给他，说有个辽河农夫因为生了一头白头猪就想去进献给皇帝，可走到辽东一带发现那里都是白头猪就只好打道回府，你就像那个农夫一样"]},{"id":43128,"word":"辽东豕","pinyin":"liáo dōng shǐ","abbr":"lds","explanation":"比喻知识浅薄，少见多怪。","source":{"text":"往时辽东有豕，生子白头，异而献之，行至河东，见群豕皆白，怀惭而还。若以子之功论于朝廷，则为辽东豕也。","book":"南朝·宋·范晔《后汉书·朱浮传》"},"example":{"text":"如井底蛙，如～，如夜郎之不知汉大，如匈奴之自谓天骄。","book":"清·梁启超《中国积弱溯源论》"},"similar":["井底之蛙","蜀犬吠日"],"usage":"作宾语、定语；指少见多怪","story":["东汉大将彭宠跟随刘秀打天下，并没有得到重用，他不服幽州长官朱浮的调遣想起兵反叛，朱浮写信给他，说有个辽河农夫因为生了一头白头猪就想去进献给皇帝，可走到辽东一带发现那里都是白头猪就只好打道回府，你就像那个农夫一样"]},{"id":43129,"word":"辽东鹤","pinyin":"liáo dōng hè","abbr":"ldh","explanation":"辽东丁令威学道成仙后，化作白鹤回到家乡去。后用来表示怀着思恋家乡的心情久别重归，慨叹故乡依旧，而人世变迁很大。","source":{"text":"丁令威，本辽东人，学道于灵虚山，后化鹤归辽，集城门华表柱。","book":"晋·陶渊明《搜神后记》卷一"},"example":{"text":"归羡～，吟同楚执珪。","book":"唐·杜甫《卜居》"}},{"id":43130,"word":"达人知命","pinyin":"dá rén zhī mìng","abbr":"drzm","explanation":"达人：通达事理的人。指心胸豁达的人，安于命运。","source":{"text":"君子安贫，达人知命。","book":"唐·王勃《滕五阁序》"},"example":{"text":"妾闻君子见几，～。","book":"明·王世贞《鸣凤记·写本》"},"usage":"作宾语、定语；指安于命运"},{"id":43131,"word":"达人立人","pinyin":"dá rén lì rén","abbr":"drlr","explanation":"达：引进；立：培植。指帮人建功立业。","source":{"text":"夫仁者，己欲立而立人，己欲达而达人。能近取譬，可谓仁之方也已！","book":"《论语·雍也》"},"example":{"text":"夫仁者～，取譬可谓仁之方而已。","book":"宋·程灏、程颐《二程全书·遗书六》"},"similar":["立人达人"],"usage":"作谓语、定语；指帮助人"},{"id":43132,"word":"达人雅志","pinyin":"dá rén yǎ zhì","abbr":"dryz","explanation":"达人：通达事理的人；雅：高雅，高尚；致：情趣。人品高尚，情趣深远。形容人的言谈举止不俗。","source":{"text":"纡谟定命，远猷辰告。’谓此句偏有雅人深致。","book":"南朝·宋·刘义庆《世说新语·文学》"}},{"id":43133,"word":"达则兼善天下","pinyin":"dá zé jiān shàn tiān xià","abbr":"dzjstx","explanation":"达：显贵。得志做了大官，就也把天下治理好。","source":{"text":"古之人，得志泽加于民；不得志，修身见于世。穷则独善其身，达则兼善天下。","book":"战国·邹·孟轲《孟子·尽心上》"},"example":{"text":"但是读书人也要‘～’。从前时代这种‘达’就是‘得君行道’。","book":"朱自清《论不满现状》"},"usage":"作宾语、定语；用于书面语"},{"id":43134,"word":"达地知根","pinyin":"dá dì zhī gēn","abbr":"ddzg","explanation":"指根底清楚、明白。","source":{"text":"怕不依随蒙君一夜恩，争奈忒达地忒知根，兼上亲上成亲好对门。","book":"元·关汉卿《调风月》第一折"},"example":{"text":"经了些十死九生，万苦千辛，俺出身入仕，荫子封妻，大人家～。","book":"元·关汉卿《哭存孝》第二折"},"similar":["知根知底"],"opposite":["来路不明"],"usage":"作谓语；指根底清楚"},{"id":43135,"word":"达士拔俗","pinyin":"dá shì bá sú","abbr":"dsbs","explanation":"达士：心胸豁达的人；拔俗：超脱凡俗，不庸俗。通达事理的人总是不同凡俗，超人一等。","source":{"text":"至人能变，达士拔俗。","book":"《吕氏春秋·知分》：“达士者，达乎死生之分。”《后汉书·仲长统传》"},"usage":"作宾语、定语；用于能人等"},{"id":43136,"word":"达士通人","pinyin":"dá shì tōng rén","abbr":"dstr","explanation":"通人：学识渊博贯通古今的人。指心胸豁达，学识渊博的人。","source":{"text":"伏望尊官长者，达士通人，共燃续慧命灯，不惜判虚空笔，起难遭想，结果胜缘。","book":"宋·陆游《雍煕请机老疏》"},"similar":["通人达士"],"usage":"作主语、宾语、定语；指人的学识等"},{"id":43137,"word":"达官显宦","pinyin":"dá guān xiǎn huàn","abbr":"dgxh","explanation":"达：显贵；宦：官。旧指职位高而声势显赫的官员。","source":{"text":"公子丧，诸达官之长杖。","book":"《礼记·檀弓下》"},"example":{"text":"我所知道的是四十年前的绍兴，那里没有～，所以未闻有专门为堂会的演剧。","book":"鲁迅《且介亭杂文附集·女吊》"},"similar":["达官贵人"],"opposite":["平民百胜","凡夫俗子","芸芸众生"],"usage":"作主语、宾语；指达官贵人"},{"id":43138,"word":"达官知命","pinyin":"dá guān zhī mìng","abbr":"dgzm","explanation":"达观：旧指一切听其自然，也指看得开。知命：旧指知天命，想念人的命运是由天决定的。指对不如意的事情看得开，任凭命运安排，无。","source":{"text":"达官知命的思想，暂时引渡静离开了苦闷的荆棘。天快亮时，她也沉沉入睡了。","book":"鲁迅《幻灭》十四"}},{"id":43139,"word":"达官要人","pinyin":"dá guān yào rén","abbr":"dgyr","explanation":"犹言达官贵人。指地位高的大官和出身侯门身价显赫的人。","source":{"text":"有日者能课，使之课莫不大奇中……凡为达官要人言皆无验；至为市进凡庸山林之士课，则如目见而言。","book":"宋·惠洪《冷斋夜话·课术有验无验》"},"similar":["达官贵人"],"usage":"作主语、宾语、定语；多用于讽刺人"},{"id":43140,"word":"达官贵人","pinyin":"dá guān guì rén","abbr":"dggr","explanation":"达官：大官。指地位高的大官和出身侯门身价显赫的人。","source":{"text":"公子丧，诸达官之长杖。","book":"《礼记·檀弓下》"},"example":{"text":"～，略有些名目在世者，其死后必有部诗文刻集。","book":"清·张贵胜《遣愁集·感慨》"},"similar":["达官显宦","皇亲国戚","土豪劣绅"],"opposite":["平民百胜","凡夫俗子","芸芸众生"],"usage":"作主语、宾语、定语；多用于讽刺人"},{"id":43141,"word":"达官贵要","pinyin":"dá guān guì yào","abbr":"dggy","explanation":"犹言达官贵人。指地位高的大官和出身侯门身价显赫的人。","source":{"text":"达官贵要多行非理，监察院察未尝举劾。","book":"《金史·世宗纪下》"},"similar":["达官贵人","达官要人"],"usage":"作主语、宾语、定语；多用于讽刺人"},{"id":43142,"word":"达权知变","pinyin":"dá quán zhī biàn","abbr":"dqzb","explanation":"指不死守常规，根据实际情况，随机应变。","source":{"text":"《左氏》义深于君父，《公羊》多任于权变。","book":"《后汉书·贾逵传》"},"example":{"text":"主四方之事的，顶寇束带，谓之丈夫；出将入相，无所不为；须要博古通今，～。","book":"明·冯梦龙《醒世恒言》卷十一"},"similar":["达权通变"],"opposite":["墨守成规"],"usage":"作谓语、定语、宾语；指人灵活"},{"id":43143,"word":"达权通变","pinyin":"dá quán tōng biàn","abbr":"dqtb","explanation":"通、达：通晓，懂得；权、变：权宜，变通。做理能适应客观情况的变化，懂得变通，不死守常规。","source":{"text":"《左氏》义深于君父，《公羊》多任于权变。","book":"《后汉书·贾逵传》"},"similar":["达权知变"],"opposite":["墨守成规"],"usage":"作谓语、定语、宾语；指灵活机动"},{"id":43144,"word":"达观知命","pinyin":"dá guān zhī mìng","abbr":"dgzm","explanation":"达观：指一切听其自然或看得开；命：命运；知命：指知天命。指对不如意的事情看得开，任凭命运摆布，无所烦恼。","source":{"text":"达观知命的思想，暂时引渡静离开了苦闷的荆棘。天快亮时，她也沉沉入睡了。","book":"茅盾《幻灭》十四"},"example":{"text":"你可不能有～的思想。"},"similar":["听天由命"],"usage":"作宾语、定语；指宿命论"},{"id":43145,"word":"达诚申信","pinyin":"dá chéng shēn xìn","abbr":"dcsx","explanation":"达：表达；申：表明；信：诚实。表达真诚忠贞。","source":{"text":"怡红院浊玉，谨以群花之蕊，冰鲛之縠，沁芳之泉，枫露之茗；四者虽微，聊以达诚申信。","book":"清·曹雪芹《红楼梦》第七十八回"},"usage":"作谓语；用于书面语"},{"id":43146,"word":"迁乔之望","pinyin":"qiān qiáo zhī wàng","abbr":"qqzw","explanation":"乔：高。指高升的希望。","source":{"text":"中华有顾瞻之哀，幽谷无迁知之望。","book":"晋·桓温《荐谯元彦表》"},"usage":"作主语、宾语；用于人的期望"},{"id":43147,"word":"迁乔出谷","pinyin":"qiān qiáo chū gǔ","abbr":"qqcg","explanation":"比喻人的地位上升。","source":{"text":"出自幽谷，迁于乔木。","book":"《诗经·小雅·伐木》"},"example":{"text":"《诗经·小雅·伐木》：“出自幽谷，迁于乔木。”"},"similar":["迁莺出谷"],"usage":"作宾语、定语；用于比喻句"},{"id":43148,"word":"迁于乔木","pinyin":"qiān yú qiáo mù","abbr":"qyqm","explanation":"迁：迁移。乔木：高树。原指鸟儿从幽深的山谷迁移到高树上去。比喻乔迁新居。","source":{"text":"出自幽古，迁于乔木。","book":"《诗经·小雅·伐木》"},"example":{"text":"汝如今～，只宜守分，也与父母争一口气。","book":"明·冯梦龙《警世通言》卷三十八"},"usage":"作谓语、定语；用于官场等"},{"id":43149,"word":"迁兰变鲍","pinyin":"qiān lán biàn bào","abbr":"qlbb","explanation":"比喻潜移默化。","source":{"text":"与善人居，如入芝兰之室，久而不闻其香，即与之化矣；与不善人居，如入鲍鱼之肆，久而不闻其臭，亦与之化矣。","book":"语出《孔子家语·六本》"},"example":{"text":"探求恩色，习睹威颜，～，久而弥信。","book":"《南史·恩幸传论》"},"similar":["潜移默化"],"usage":"作宾语、定语；用于书面语"},{"id":43150,"word":"迁善去恶","pinyin":"qiān shàn qù è","abbr":"qsqe","explanation":"犹言向善而去除邪恶。同“迁善黜恶”。","source":{"text":"《易》、《诗》、《书》、《礼》著其理，《春秋传》兼言征验，而四子书教人迁善去恶之道大备。","book":"清·冯桂芬《序》"},"similar":["迁善黜恶"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":43151,"word":"迁善塞违","pinyin":"qiān shàn sāi wéi","abbr":"qssw","explanation":"犹言向善而防堵邪恶。","source":{"text":"闻见既溥，法戒乃兴，迁善塞违，教治以懋。","book":"清·谭嗣同《刘淞芙跋》"},"usage":"作谓语、定语；用于书面语"},{"id":43152,"word":"迁善改过","pinyin":"qiān shàn gǎi guò","abbr":"qsgg","explanation":"指改正过失而向善。","source":{"text":"言忠信，行笃敬，惩忿窒欲，迁善改过，右修身之要。","book":"《易·益》：“君子以见善则迁，有过则改”三国·魏·王弼注：“迁善改过，益莫大焉。”宋·朱熹《白鹿洞书院揭示》"},"example":{"text":"赖英宗（宋英宗）～，方成就此一段好事。","book":"明·陆深《燕闲录》"},"similar":["改过迁善"],"usage":"作谓语、宾语、主语；指改正过错"},{"id":43153,"word":"迁善远罪","pinyin":"qiān shàn yuǎn zuì","abbr":"qsyz","explanation":"向善而远离罪恶。","source":{"text":"然而曰礼云礼云者，贵绝恶于未萌，而起教于微眇，使民日迁善远罪而不自知也。","book":"《汉书·贾谊传》"},"example":{"text":"吾里尝有陈融，孝慈仁信，不学不仕。乡人见也，皆自欲～，亦不知其所以然。","book":"唐·吕温《广陵陈先生墓表》"},"usage":"作谓语、定语；用于书面语"},{"id":43154,"word":"迁善黜恶","pinyin":"qiān shàn chù è","abbr":"qsce","explanation":"犹言向善而去除邪恶。","source":{"text":"考黜之政，谓迁善黜恶。","book":"三国·蜀·诸葛亮《便宜十六策·考黜》"},"similar":["迁善去恶"],"usage":"作谓语、宾语；用于书面语"},{"id":43155,"word":"迁地为良","pinyin":"qiān dì wéi liáng","abbr":"qdwl","explanation":"迁：迁移。迁移到他处更好。","source":{"text":"他觉得北京不大妙，赶快迁地为良，他有电话来找，也未可知，于是便走到书房去接电话。","book":"张恨水《金粉世家》第八十六回"},"usage":"作宾语、定语；用于变迁"},{"id":43156,"word":"迁客骚人","pinyin":"qiān kè sāo rén","abbr":"qksr","explanation":"迁客：被贬谪到外地的官吏；骚人：诗人。贬黜流放的官吏，多愁善感的诗人。泛指忧愁失意的文人。","source":{"text":"迁客骚人，多会于此。","book":"宋·范仲淹《岳阳楼记》"},"usage":"作宾语、定语；指失意的文人"},{"id":43157,"word":"迁延岁月","pinyin":"qiān yán suì yuè","abbr":"qysy","explanation":"犹言拖延时间。","source":{"text":"不然。人生如白驹过隙，似此迁延岁月，何日恢复中原乎？","book":"明·罗贯中《三国演义》第一百七回"},"example":{"text":"寇得～，设法困我，渐及秋冬，水更滞涸，北方早寒，三军未带裘褐，必叹无衣，不但无食可忧哩。","book":"蔡东蕃《两晋演义》第六十回"}},{"id":43158,"word":"迁延日月","pinyin":"qiān yán rì yuè","abbr":"qyry","explanation":"犹言拖延时间。同“迁延岁月”。"},{"id":43159,"word":"迁延时日","pinyin":"qiān yán shí rì","abbr":"qysr","explanation":"犹言拖延时间。同“迁延岁月”。","source":{"text":"不然。人生如白驹过隙，似此迁延岁月，何日恢复中原乎？","book":"明·罗贯中《三国演义》第一百七回"},"example":{"text":"到了魏州城下，驻立大营，亦不过虚张声势，～。","book":"蔡东藩《五代史演义》第三十回"},"usage":"作谓语、宾语、定语；指拖延时间"},{"id":43160,"word":"迁延稽留","pinyin":"qiān yán jī liú","abbr":"qyjl","explanation":"犹言拖延滞留。"},{"id":43161,"word":"迁延羁留","pinyin":"qiān yán jī liú","abbr":"qyjl","explanation":"犹言拖延滞留。同“迁延稽留”。"},{"id":43162,"word":"迁延观望","pinyin":"qiān yán guān wàng","abbr":"qygw","explanation":"指心情犹豫而行动迟延。"},{"id":43163,"word":"迁延过时","pinyin":"qiān yán guò shí","abbr":"qygs","explanation":"迁延：拖延。拖延错过时机。","source":{"text":"迁延过时，秋苗亦误锄治。","book":"明·徐光启《农政全书·营治》"},"usage":"作谓语、宾语；用于处事等"},{"id":43164,"word":"迁延顾望","pinyin":"qiān yán gù wàng","abbr":"qygw","explanation":"指心情犹豫而行动迟延。同“迁延观望”。"},{"id":43165,"word":"迁怒于人","pinyin":"qiān nù yú rén","abbr":"qnyr","explanation":"受甲的气向乙发泄或自己不如意时拿别人出气。","source":{"text":"怒于甲者，不移于乙。","book":"《论语·雍也》：“有颜回者好学，不迁怒，不贰过。”朱熹注"},"similar":["迁怒于众"],"usage":"作谓语；指拿别人出气"},{"id":43166,"word":"迁怒于众","pinyin":"qiān nù yú zhòng","abbr":"qnyz","explanation":"迁怒：受甲的气向乙发泄。自己不如意时拿别人出气。","source":{"text":"凡见了这一干人，心中又畏又让，未免又气又恨，亦且迁怒于众。","book":"清·曹雪芹《红楼梦》第59回"},"similar":["迁怒于人"],"usage":"作谓语；指拿别人出气"},{"id":43167,"word":"迁思回虑","pinyin":"qiān sī huí lǜ","abbr":"qshl","explanation":"形容反复思考。","source":{"text":"乃迁思回虑，总公卿之议，询封禅之事。","book":"汉·司马相如《封禅文》"},"example":{"text":"察圣贤之深戒，～，惩往念来，诏将作之官，息勤劳之众。","book":"宋·王曾《乞罢营玉清昭应宫疏》"},"usage":"作谓语；指反复思考"},{"id":43168,"word":"迁臣逐客","pinyin":"qiān chén zhú kè","abbr":"qczk","explanation":"指遭贬官放逐的人。","source":{"text":"子录非《资治通鉴》，奚益于迁臣逐客？火之久矣。","book":"宋·张端义《自序》"},"example":{"text":"～皆前辈，幕长郎官尽上才。","book":"元·范悙《休日出郊》"},"usage":"作主语、宾语；指遭贬官放逐的人"},{"id":43169,"word":"迁莺出谷","pinyin":"qiān yīng chū gǔ","abbr":"qycg","explanation":"比喻人的地位上升。同“迁乔出谷”。","source":{"text":"符弥轩调虎离山，金秀英迁莺出谷。","book":"清·吴趼人《二十年目睹之怪现状》第106回回目"},"similar":["迁乔出谷"],"usage":"作宾语、定语；用于比喻句"},{"id":43170,"word":"迁风移俗","pinyin":"qiān fēng yí sú","abbr":"qfys","explanation":"犹言移风易俗。改变旧的风俗习惯。","source":{"text":"择君所以求仕，择方所以修道；迁风移俗者嗜欲移性，可不慎乎？","book":"《孔子家语·六本》"},"similar":["移风易俗"],"usage":"作谓语、定语；用于书面语"},{"id":43171,"word":"迂回曲折","pinyin":"yū huí qū zhé","abbr":"yhqz","explanation":"迂回：回旋，环绕。弯弯曲曲，绕来绕去。常比喻事物发展的曲折性。","source":{"text":"多编数屏，随意遮拦，恍如绿阴满窗，透风蔽日，迂回曲折，随时可更。","book":"清·沈复《浮生六记·闲情记趣》"},"example":{"text":"打破“围剿”的过程往往是～的，不是径情直遂的。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["弯弯曲曲"],"opposite":["径情直遂"],"usage":"作谓语、定语；指道路、途径等"},{"id":43172,"word":"迂夫子","pinyin":"yū fū zǐ","abbr":"yfz","explanation":"迂腐的书呆子。","example":{"text":"我不想跟这～浪费时间。"},"usage":"作宾语、定语；用于口语"},{"id":43173,"word":"迂怪不经","pinyin":"yū guài bù jīng","abbr":"ygbj","explanation":"迂曲妄诞不合常理。","source":{"text":"劭在著作，将二十年，专典国史，撰《隋书》八十卷。多录口勅，又采迂怪不经之语及委巷之言。","book":"《隋书·王劭传》"},"usage":"作定语、状语；用于书面语"},{"id":43174,"word":"迂腐腾腾","pinyin":"yū fǔ téng téng","abbr":"yftt","explanation":"迂腐：言行谨慎不敢超越旧规。形容固执保守，不通世故。","source":{"text":"依晚生看去，莫某人还不至于如此；不过头巾气太重，有点迂腐腾腾的罢了。晚生看他世情都还不甚了了，太尊所说种种，他未必去做。","book":"清·吴趼人《二十年目睹之怪现状》第九十八回"},"example":{"text":"之乎者也，满口不绝，弄得～，毫无实学经济。","book":"蔡东藩《明史演义》第十八回"},"usage":"作谓语、状语、定语；用于处事"},{"id":43175,"word":"迂谈阔论","pinyin":"yū tán kuò lùn","abbr":"ytkl","explanation":"犹言高谈阔论。","source":{"text":"驺衍等迂谈阔论，虚而无实。","book":"明·冯梦龙《东周列国志》第八十九回"},"similar":["迂阔之论"],"usage":"作宾语、定语；用于书面语"},{"id":43176,"word":"迂阔之论","pinyin":"yū kuò zhī lùn","abbr":"ykzl","explanation":"迂：迂腐；阔：大加夸张的。不符合实际的，空洞的言论。","source":{"text":"上以其言迂阔，不甚宠异也。","book":"《汉书·王吉传》"},"example":{"text":"这话又似乎是说书的～了。殊不知凡为女子，必须妇德、妇言、妇容、妇工四者兼备，才算得个全人。","book":"清·文康《儿女英雄传》二七"},"similar":["迂谈阔论","高谈阔论"],"usage":"作宾语；用于书面语"},{"id":43177,"word":"迄未成功","pinyin":"qì wèi chéng gōng","abbr":"qwcg","explanation":"迄：毕竟、终究。指终究未能成功。","source":{"text":"融负其高气，志在靖难。而才疏意广，迄未成功。","book":"《后汉书·孔融传》"},"example":{"text":"当北代军尚在围攻武昌时，东南和平运动会派出张一麐和孙传芳的总代表蒋方震到汉口谋和，～。","book":"丁中江《北洋军阀史话》二四七"},"usage":"作谓语；指没有成功"},{"id":43178,"word":"迅电流光","pinyin":"xùn diàn liú guāng","abbr":"xdlg","explanation":"比喻光阴像电光迅速地消逝。","source":{"text":"迅电流光三载间，再游胜地百忧删。","book":"胡蕴《过临平》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":43179,"word":"迅雷不及","pinyin":"xùn léi bù jí","abbr":"xlbj","explanation":"雷声来得非常快，让人来不及反应。比喻来势凶猛，使人来不及防备。","source":{"text":"疾雷不及掩耳，迅电不及瞑目。","book":"《六韬·龙韬·军势》"}},{"id":43180,"word":"迅雷不及掩耳","pinyin":"xùn léi bù jí yǎn ěr","abbr":"xlbjye","explanation":"雷声来得非常快，连捂耳朵都来不及。比喻来势凶猛，使人来不及防备。","source":{"text":"疾雷不及掩耳，迅电不及瞑目。","book":"《六韬·龙韬·军势》"},"example":{"text":"因此我给他个～的突然袭击，一口把他吃掉，是完全有可能的。","book":"曲波《林海雪原》二九"},"similar":["出其不意"],"opposite":["蜗行牛步"],"usage":"作定语、分句；比喻来势凶猛","story":["东汉末年，曹操进攻黄河流域的马超和韩遂，把马超打败。马超要求割地求和，曹操不答应，占领渭口后修筑工事后，表面答应议和，暗中养精蓄锐，接着以疾雷不及掩耳之势向马超突然袭击，将丝毫没有防范的马超打得大败而逃"]},{"id":43181,"word":"迅雷烈风","pinyin":"xùn léi liè fēng","abbr":"xllf","explanation":"急猛的雷和狂烈的风。形容突如其来的巨大变动。","source":{"text":"迅雷烈风必变。","book":"《论语·乡党》"},"example":{"text":"俄然天变，忽有～，江波泛溢，城郭震动。","book":"明·冯梦龙《警世通言》卷四十"},"similar":["迅雷风烈"],"usage":"作宾语、定语；用于书面语"},{"id":43182,"word":"迅雷风烈","pinyin":"xùn léi fēng liè","abbr":"xlfl","explanation":"犹言迅雷烈风。","source":{"text":"孔子迅雷风烈必变。","book":"春秋·鲁·孔丘《论语·乡党》"},"example":{"text":"清·俞樾《古书疑义举例·错综成文例》：“如《论语》：‘～。’《楚辞》：‘吉日兮辰良。”"},"similar":["迅雷烈风"],"usage":"作宾语、定语；用于书面语"},{"id":43183,"word":"迅风暴雨","pinyin":"xùn fēng bào yǔ","abbr":"xfby","explanation":"迅：又快又猛；暴：突然而猛烈。形容风雨来势猛。比喻迅猛激烈的斗争。","source":{"text":"何谓隐之天？大寒甚暑，疾风暴雨，大雾冥晦，因此而为变者也。","book":"《淮南子·兵略训》"},"similar":["疾风暴雨","疾风横雨","疾风骤雨"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":43184,"word":"过为已甚","pinyin":"guò wéi yǐ shèn","abbr":"gwys","explanation":"过：过分；为：做；已甚：过头。做得太过分。","source":{"text":"仲尼不为已甚者。","book":"《孟子·离娄下》"},"example":{"text":"如能实行以上十二条，则事态自然平复，我们共产党和全国人民，必不～。","book":"毛泽东《为皖南事变发表的命令和谈话》"},"usage":"作谓语；指做得太过分"},{"id":43185,"word":"过了这个村，没这个店","pinyin":"guò le zhè gè cūn，méi zhè gè diàn","abbr":"glzgcmzgd","explanation":"比喻机会难得，机不可失。","source":{"text":"这是送上门的。你老人家休错这主意，过这村，就没这店了。","book":"清·李绿园《歧路灯》第13回"},"example":{"text":"况且俗话说的‘～儿。’你要再找我妹妹这么个人儿，只怕走遍天下，打着灯笼也没处找去。","book":"清·文康《儿女英雄传》第九回"},"usage":"作宾语、定语；用于口语"},{"id":43186,"word":"过五关斩六将","pinyin":"guò wǔ guān zhǎn liù jiàng","abbr":"gwgzlj","explanation":"比喻克服重重困难。这是《三国演义》中描写关羽的故事。","source":{"text":"这如今万世之下，那一个不说道过五关斩六将、掀天揭地的好大丈夫？","book":"《三宝太监西洋记通俗演义》第76回"},"example":{"text":"常言说，英雄难过美人关，这比～都难。","book":"王岭群《黑网下的星光》十一"},"similar":["过关斩将"],"usage":"作谓语、宾语；比喻克服重重困难","story":["东汉末年，刘备、关羽、张飞在徐州失散后，关羽留在曹营。得知刘备在河北袁绍处，就带领二位皇嫂去投奔，曹操不许。关羽凭自己的勇猛，连续过东岭、洛阳、沂水、荥阳和黄河五关，斩杀孙秀、孟坦、韩福、下喜、王植和秦琪六位战将"]},{"id":43187,"word":"过五关，斩六将","pinyin":"guò wǔ guān，zhǎn liù jiàng","abbr":"gwgzlj","explanation":"过了五个关口，斩了六员大将。比喻英勇无比。也比喻克服重重困难。","source":{"text":"关云长挂印封金，千里走单骑，过五关斩六将。","book":"明·罗贯中《三国演义》第二十七回"},"example":{"text":"常言道：英雄难过美人关，这比～都难。","book":"王玲群《黑网下的星光》十一"}},{"id":43188,"word":"过从甚密","pinyin":"guò cóng shèn mì","abbr":"gcsm","explanation":"过从：交往，来往。指交往频繁，关系密切。","source":{"text":"信阳王师竹宫庶，与先人最相善，且不拘词林前后辈俗体，博洽虚心，过从甚密。","book":"明·沈德符《万历野获编·王师竹宫庶》"},"example":{"text":"这固然因为他们两个人近来～，但大半还是抱素自己对男同学泄露秘密。","book":"茅盾《蚀·幻灭》"},"similar":["过往甚密"],"usage":"作谓语；指交往密切"},{"id":43189,"word":"过关斩将","pinyin":"guò guān zhǎn jiàng","abbr":"ggzj","explanation":"比喻不断战胜对手与克服困难。","example":{"text":"她一路～，终于赢得了胜利。"},"similar":["过五关斩六将"],"opposite":["损兵折将"],"usage":"作谓语、定语；指克服困难","story":["东汉末年，刘备、关羽、张飞在徐州失散后，关羽留在曹营。得知刘备在河北袁绍处，就带领二位皇嫂去投奔，曹操不许。关羽凭自己的勇猛，连续过东岭、洛阳、沂水、荥阳和黄河五关，斩杀孙秀、孟坦、韩福、下喜、王植和秦琪六位战将"]},{"id":43190,"word":"过则勿惮改","pinyin":"guò zé wù dàn gǎi","abbr":"gzwdg","explanation":"过：过错；惮：害怕。有了错误，不要怕改正。","source":{"text":"主忠信……过则勿惮改。","book":"《论语·学而》"},"example":{"text":"前者躲避现实，有点“明哲保身”的味道；后者也还看不见“～”的勇气。","book":"谢觉哉《反省》"},"usage":"作谓语、定语；用于处事"},{"id":43191,"word":"过化存神","pinyin":"guò huà cún shén","abbr":"ghcs","explanation":"过：经过；存：保存，具有。圣人所到之处，人民无不被感化，而永远受其精神影响。","source":{"text":"夫君子所过者化，所存者神，上下与天地同流。","book":"战国·邹·孟轲《孟子·尽心上》"},"example":{"text":"惟圣人有～之妙，拨乱反正之才。","book":"明·杨慎《用我吾为东周》"},"usage":"作谓语；指人的精神"},{"id":43192,"word":"过去未来","pinyin":"guò qù wèi lái","abbr":"gqwl","explanation":"已往的和今后的。","source":{"text":"那时天台韶国师是个得道的祖师，能知过去未来之事。","book":"明·周楫《西湖二集·寿禅师两生符宿愿》"},"example":{"text":"接引得胡无翳见性明心，灵台透彻，尽知～之事。","book":"清·西周生《醒世姻缘传》第100回"},"usage":"作宾语、定语；指已知的和未知的"},{"id":43193,"word":"过屠大嚼","pinyin":"guò tú dà jué","abbr":"gtdj","explanation":"比喻心里想而得不到手，只好用不切实际的办法来安慰自己。同“过屠门而大嚼”。","source":{"text":"然则居东南而谭富强，其犹过屠大嚼。","book":"梁启超《复刘古愚山长书》"},"similar":["过屠门而大嚼"],"usage":"作宾语、定语；指自我安慰"},{"id":43194,"word":"过屠门而大嚼","pinyin":"guò tú mén ér dà jiáo","abbr":"gtmedj","explanation":"屠门：肉店。比喻心里想而得不到手，只好用不切实际的办法来安慰自己。","source":{"text":"过屠门而大嚼，虽不得肉，贵且快意。","book":"汉·桓谭《新论》：“人闻长安乐，则出门而向西笑；知肉味美，则对屠门而大嚼。”三国魏·曹植《与吴质书》"},"example":{"text":"她做母亲的至少也该让孩子们到马路上睁大了惊异的眼睛，聊且“～”。","book":"茅盾《过年》"},"similar":["过屠大嚼"],"usage":"作宾语、定语；指自我安慰"},{"id":43195,"word":"过市招摇","pinyin":"guò shì zhāo yáo","abbr":"gszy","explanation":"市：闹市，指人多的地方；招摇：张扬炫耀。指在公开场合大摇大摆显示声势，引人注意。","source":{"text":"居卫月余，灵公与夫人同车，宦者雍渠参乘，出，使孔子为次乘，招摇市过之。","book":"《史记·孔子世家》"},"example":{"text":"凭阑凝望，～，虽分声价之低昂，各擅风花之点染。","book":"清·玉魫生《海陬冶游录》"}},{"id":43196,"word":"过府冲州","pinyin":"guò fǔ chōng zhōu","abbr":"gfcz","explanation":"行经了很多地方。形容旅途的漫长与跋涉的劳苦。","source":{"text":"两个商量了，径望沧州路上来。途中免不得登山涉水，过府冲州。","book":"明·施耐庵《水浒传》第二十二回"},"similar":["冲州过府"],"usage":"作谓语、宾语；用于旅行"},{"id":43197,"word":"过庭之训","pinyin":"guò tíng zhī xùn","abbr":"gtzx","explanation":"用以指父亲的教诲。","source":{"text":"掾孙翻，以贞固之质，受过庭之训。","book":"《论语·季氏》：“尝独立，鲤趋而过庭。曰：‘学诗乎？’对曰：‘未也。’‘不学诗，无以言。’鲤退而学诗。”汉·蔡邕《郡掾吏张玄祠堂碑》"},"example":{"text":"仆世承门之业，受～，是以得接冠带之末，充乎士大夫之列。","book":"《晋书·夏侯湛传》"},"usage":"作宾语；指父亲的教诲"},{"id":43198,"word":"过情之誉","pinyin":"guò qíng zhī yù","abbr":"gqzy","explanation":"过情：超出实情。指超出实际，名不副实的的赞美。","source":{"text":"从来志状之属，尽出其家子孙所创草稿，立言者随而润色之，不免过情之誉。","book":"明·沈德符《万历野获编·谀墓》"},"example":{"text":"至乃多蒙奖借之言，或是廖采～，而自揣陋劣，何以克当。","book":"清·顾炎武《答王茂衍》"}},{"id":43199,"word":"过意不去","pinyin":"guò yì bù qù","abbr":"gybq","explanation":"心中很不安，感到抱歉。","source":{"text":"而今见下得雨大，晓得躲雨的没去处，心下过意不去，有心要出来留他们进去，却又怪先前说这讨便宜话的人。","book":"明·凌濛初《初刻拍案惊奇·陶家翁大雨留宾》"},"example":{"text":"想起安老爷这等办得周到，却又添了一层～。","book":"清·文康《儿女英雄传》第二十三回"},"similar":["愧疚不安"],"opposite":["心安理得"],"usage":"作谓语、宾语；指心里感到不安"},{"id":43200,"word":"过时货","pinyin":"guò shí huò","abbr":"gsh","explanation":"指已经流行过的东西。","example":{"text":"我们不要～。"},"usage":"作主语、宾语、定语；指不流行的东西"},{"id":43201,"word":"过时黄花","pinyin":"guò shí huáng huā","abbr":"gshh","explanation":"黄花：菊花。重阳节后的菊花。比喻过了时的或失去意义的事物。","source":{"text":"相知不用忙归去，明日黄花蝶也愁。","book":"宋·苏轼《九日次韵王巩》"},"example":{"text":"今该转机已成～。","book":"蔡东藩、许廑父《民国通俗演义》第一百一回"},"similar":["明日黄花"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":43202,"word":"过桥抽板","pinyin":"guò qiáo chōu bǎn","abbr":"gqcb","explanation":"比喻目的达到后，就把帮助过自己的人一脚踢开。","source":{"text":"只要你不要过桥抽板，我马上去找他们，一定有个办法，明天来回复你。","book":"曾朴《孽海花》第31回"},"example":{"text":"我们两个人给你凑一个好了，不然你会以为我们～。","book":"沙汀《淘金记》"},"similar":["过河拆桥"],"usage":"作谓语、定语；同“过河拆桥”"},{"id":43203,"word":"过桥拆桥","pinyin":"guò qiáo chāi qiáo","abbr":"gqcq","explanation":"比喻达到目的后，就把帮助过自己的人一脚踢开。同“过河拆桥”。","source":{"text":"但是现在的人总是过桥拆桥，转过脸就不认得人的。等到你有事去请教他，他又跳到架子上去了。","book":"《官场现形记》第十七回"},"example":{"text":"雍正庚戌，贡士宋长城对策，有请废科目之议。置三甲末，停其选用。此元人所谓～者耶？","book":"清·阮葵生《荼馀客话》卷二"},"similar":["过河拆桥"],"usage":"作谓语、宾语、分句；指为人不好"},{"id":43204,"word":"过江之鲫","pinyin":"guò jiāng zhī jì","abbr":"gjzj","explanation":"东晋王朝在江南建立后，北方士族纷纷来到江南，当时有人说 “过江名士多于鲫”。比喻某种时兴的事物非常多。","source":{"text":"试把过江人物数，溪翁之外更谁哉。","book":"宋·刘克庄《竹溪生日二首》"},"example":{"text":"目光炯炯地看着～似的人群，满脸泛滥不屑。","book":"朱振国《穿过城市》"},"similar":["过江名士多如鲗"],"usage":"作宾语；形容多而纷乱"},{"id":43205,"word":"过江名士多如鲗","pinyin":"guò jiāng míng shì duō rú zéi","abbr":"gjmsdrz","explanation":"鲗：乌贼，墨鱼。形容多而纷乱。","source":{"text":"古人有言曰：‘过江名士多如鲗’，我就叫过江名士罢。","book":"清·吴趼人《俏皮话·乌龟雅名》"},"similar":["过江之鲫"],"usage":"作宾语、定语；用于口语"},{"id":43206,"word":"过江名士多如鲫","pinyin":"guò jiāng míng shì duō rú jì","abbr":"gjmsdrj","explanation":"东晋王朝在江南建立后，北方士族纷纷来到江南，当时有人说 “过江名士多于鲫”。比喻某种时兴的事物非常多。","source":{"text":"试把过江人物数，溪翁之外更谁哉。","book":"宋·刘克庄《竹溪生日二首》"},"example":{"text":"～，唯君杰出群流中。","book":"柳亚子《丹青引》"}},{"id":43207,"word":"过河卒子","pinyin":"guò hé zú zǐ","abbr":"ghzz","explanation":"象棋规则中卒子只能向前，不能后退，过了河之后可以横着走，威力更大。比喻只能前进，不能后退。","source":{"text":"这是‘做了过河卒子，只有拼命向前’的时候呀！","book":"张友鸾《秦淮粉墨图》第62回"},"example":{"text":"他觉得自己成了～，没有退路。"},"opposite":["进退自如"],"usage":"作宾语、主语；比喻只能前进，不能后退"},{"id":43208,"word":"过河拆桥","pinyin":"guò hé chāi qiáo","abbr":"ghcq","explanation":"自己过了河，便把桥拆掉。比喻达到目的后，就把帮助过自己的人一脚踢开。","source":{"text":"你休得顺水推船，偏不许我过河拆桥。","book":"元·康进之《李逵负棘》第三折"},"example":{"text":"祥子受了那么多的累，～，老头子翻脸不认人，他们替祥子不平。","book":"老舍《骆驼祥子》十四"},"similar":["鸟尽弓藏","兔死狗烹"],"opposite":["饮水思源"],"usage":"作谓语、宾语、分句；指为人不好","story":["刘备在长坂坡打了败仗，赵云找到冲散了的刘备的妻儿。曹操也追至长坂桥，见张飞胡须倒立，睁着圆眼，心中害怕中计，吓得掉头就跑。张飞见吓退了曹操，就将长坂桥拆掉。刘备担心曹操再追，连夜率军向汉津逃去"]},{"id":43209,"word":"过犹不及","pinyin":"guò yóu bù jí","abbr":"gybj","explanation":"过：过分；犹：象；不及：达不到。事情做得过头，就跟做得不够一样，都是不合适的。","source":{"text":"子贡问：‘师与商也孰贤？’子曰：‘师也过，商也不及。’曰：‘然则师愈与？’子曰：‘过犹不及。’","book":"《论语·先进》"},"example":{"text":"据老夫看来：这是“～”。大约两耳过长，反觉没用。","book":"清·李汝珍《镜花缘》第十四回"},"similar":["过为己甚"],"opposite":["恰如其分","恰到好处"],"usage":"作谓语、宾语、定语；强调言行恰如其分","story":["春秋时期，孔子的学生子贡问孔子他的同学子张和子夏哪个更贤明一些。孔子说子张常常超过周礼的要求，子夏则常常达不到周礼的要求。子贡又问，子张能超过是不是好一些，孔子回答说超过和达不到的效果是一样的"]},{"id":43210,"word":"过甚其词","pinyin":"guò shèn qí cí","abbr":"gsqc","explanation":"词：话，言词；甚：超过。指话说得过分，不符合实际情况。","source":{"text":"市面上的消息也许过甚其词。","book":"茅盾《子夜》"},"example":{"text":"这决非～。"},"similar":["言过其实","夸大其词"],"opposite":["恰如其分","实事求是","适可而止"],"usage":"作谓语、宾语；形容话说过了头"},{"id":43211,"word":"过甚其辞","pinyin":"guò shèn qí cí","abbr":"gsqc","explanation":"指话说得过分，不符合实际情况。","source":{"text":"说来恐怕有些人不大肯信，以为我是过甚其辞。","book":"郭沫若《反正前后》第一篇三"},"example":{"text":"当第一天传锣号召那些身居黑籍的可怜虫的时侯，因为那打更匠的～，大家以为真的不出任何费用，来的很是不少。","book":"沙汀《淘金记》十九"},"similar":["过甚其词"],"usage":"作宾语、定语；指言词过头"},{"id":43212,"word":"过盛必衰","pinyin":"guò shèng bì shuāi","abbr":"gsbs","explanation":"过分的兴盛必定会向衰败转化。","source":{"text":"厥今夷狄，物伙地大，德不足，力有余，过盛必衰，一失其御，必将豪杰并起，四分五裂。","book":"宋·辛弃疾《论荆襄上流为东南重地》"},"similar":["物极必反"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":43213,"word":"过目不忘","pinyin":"guò mù bù wàng","abbr":"gmbw","explanation":"看过就不忘记。形容记忆力非常强。","source":{"text":"耳闻则育，过目不忘。","book":"《晋书·苻融载记》"},"example":{"text":"公～，真天下奇才也！","book":"明·罗贯中《三国演义》第六十回"},"similar":["过目成诵"],"usage":"作谓语、定语；指人的记忆力好"},{"id":43214,"word":"过目成诵","pinyin":"guò mù chéng sòng","abbr":"gmcs","explanation":"成诵：能背诵。看过一遍就能背下来。形容记忆力强。","source":{"text":"恕少颖司，书过目即成诵。","book":"《晋书·苻融载记》：“耳闻则诵，过目不忘。”《宋史·刘恕传》"},"example":{"text":"天资高妙，～，出口成章。","book":"明·冯梦龙《警世通言》卷三"},"similar":["过目不忘","一览成诵","一目十行"],"usage":"作谓语、定语；形容记忆力超众"},{"id":43215,"word":"过眼云烟","pinyin":"guò yǎn yún yān","abbr":"gyyy","explanation":"从眼前飘过的云烟。原比喻身外之物，不必重视。后比喻很快就消失的事物。","source":{"text":"见可喜者，虽时复蓄之，然为人取去，亦不复惜也。譬之烟云之过眼，百鸟之感耳，岂不欣然接之，然去而不复念也。","book":"宋·苏轼《宝绘堂记》"},"example":{"text":"尽道是用不尽的金银，享不完的福禄了，谁知～，容易消歇。","book":"明·凌濛初《二刻拍案惊奇》卷十九"},"similar":["过眼烟云","昙花一现"],"usage":"作谓语、定语、状语；用于事物"},{"id":43216,"word":"过眼烟云","pinyin":"guò yǎn yān yún","abbr":"gyyy","explanation":"从眼前飘过的云烟。原比喻身外之物，不必重视。后比喻很快就消失的事物。","source":{"text":"见可喜者，虽时复蓄之，然为人取去，亦不复惜也。譬之烟云之过眼，百鸟之感耳，岂不欣然接之，然去而不复念也。","book":"宋·苏轼《宝绘堂记》"},"example":{"text":"论起荣华富贵，原不过是～。","book":"清·曹雪芹《红楼梦》第一百十八回"},"similar":["过眼云烟","昙花一现"],"usage":"作谓语、定语、状语；用于事物"},{"id":43217,"word":"过而能改","pinyin":"guò ér néng gǎi","abbr":"geng","explanation":"有了错误就能改正。","source":{"text":"吾知所过矣，将改之。稽首而曰：‘人谁无过，过而能改，善莫大焉。’","book":"《左传·宣公二年》"},"example":{"text":"真个是～，复于无过。","book":"清·李绿园《歧路灯》第二十六回"},"similar":["有过必改"],"opposite":["死不悔改"],"usage":"作谓语、定语、宾语；指知错就该"},{"id":43218,"word":"过耳之言","pinyin":"guò ěr zhī yán","abbr":"gezy","explanation":"听来的传言不值得认真对待。","source":{"text":"常言道：过耳之言，不可听信。","book":"明·吴承恩《西游记》第九回"}},{"id":43219,"word":"过耳春风","pinyin":"guò ěr chūn fēng","abbr":"gecf","explanation":"经过耳边的春风。比喻听话的人不重视，或认为不值得听。","source":{"text":"这句话我们听了都当作过耳春风，谁也不去理会话中的意义。","book":"孙伏园《长安道上》"}},{"id":43220,"word":"过耳秋风","pinyin":"guò ěr qiū fēng","abbr":"geqf","explanation":"吹过耳边的秋风。比喻无实际作用的身外之物。","source":{"text":"富贵之于我，如秋风之过耳。","book":"《吴越春秋·吴王寿梦传》"},"similar":["秋风过耳"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":43221,"word":"过街老鼠","pinyin":"guò jiē lǎo shǔ","abbr":"gjls","explanation":"比喻人人痛恨的坏人。","source":{"text":"吝者自能致富，然一有事则为过街老鼠；侠者或致破家，然一有事则为百足之虫。","book":"明·徐学谟《归有园尘谈》"},"example":{"text":"前村后舍人，人人怨恶，故取他一个绰号，叫做～。","book":"明·方汝浩《禅真逸史》"},"usage":"作宾语、定语；指坏人"},{"id":43222,"word":"过路财神","pinyin":"guò lù cái shén","abbr":"glcs","explanation":"比喻暂时经手大量钱财的人。","example":{"text":"我只是～，没有钱的。"},"usage":"作主语、宾语；指钱财经手人"},{"id":43223,"word":"过都历块","pinyin":"guò dōu lì kuài","abbr":"gdlk","explanation":"越过都市，经过山阜。意指纵横驰骋，施展才能。","source":{"text":"仆倘未即老死，行将见执事任重道远、过都历块以耀当世。","book":"明·唐顺之《与万两溪吏部》"},"usage":"作谓语、宾语；指人施展才华"},{"id":43224,"word":"过门不入","pinyin":"guò mén bù rù","abbr":"gmbr","explanation":"过：路过；入：进入。路过家门却不进去。形容恪尽职守，公而忘私。","source":{"text":"禹稷当平世，三过其门而不入。","book":"战国·邹·孟轲《孟子·离娄下》"},"example":{"text":"岂有相离咫尺，竟～？","book":"清·李汝珍《镜花缘》第42回"},"similar":["公而忘私"],"opposite":["假公济私"],"usage":"作谓语、定语；指大公无私","story":["禹为了完成父亲未尽事业，30岁才与涂山姑娘女娇结婚，婚后四天就离家治水。禹率能工巧匠开凿河道，疏导水流，经过13年的努力终于消灭水患。期间因为治水没时间回家，三次路过家门口，见自己的孩子都已长大，但他没有进家门"]},{"id":43225,"word":"过隙白驹","pinyin":"guò xī bái jū","abbr":"gxbj","explanation":"隙：空隙；白驹：原指白马，后比喻日影。比喻时光像骏马一样在细小的缝隙前飞快地越过。","source":{"text":"《庄子·知北游》“人生天地之间，若白驹之过卻，忽然而已。”"},"example":{"text":"恁兄弟一片功名心更速，岂不闻光阴如～。","book":"元·马致远《荐福碑》第一折"},"similar":["白驹过隙"],"usage":"作宾语；形容时间飞快流逝"},{"id":43226,"word":"迈古超今","pinyin":"mài gǔ chāo jīn","abbr":"mgcj","explanation":"指超越古今。","source":{"text":"方位里都按着郭景纯经天纬地阴阳诀，规矩上不离了鲁公迈古超今造化机。","book":"元·汤式《哨遍·新建构栏教坊求赞》"},"usage":"作谓语；指超越古今"},{"id":43227,"word":"迈四方步","pinyin":"mài sì fāng bù","abbr":"msfb","explanation":"不慌不忙，慢吞吞地走路。比喻办事缓慢。","example":{"text":"请快点行动，别～了。"},"opposite":["大步流星"],"usage":"作谓语；指人不着急"},{"id":43228,"word":"迈越常流","pinyin":"mài yuè cháng liú","abbr":"mycl","explanation":"迈：超过。超过一般人。","source":{"text":"阁下挺拔英气，迈越常流，独契圣谟，以昌鸿业。","book":"唐·柳宗元《为裴中丞上裴相贺破东平状》"},"similar":["超群出众"],"usage":"作谓语、定语；指人超群"},{"id":43229,"word":"迍邅之世","pinyin":"zhūn zhān zhī shì","abbr":"zzzs","explanation":"迍邅：困顿不得志。指处境艰难的乱世。","source":{"text":"今事未靖，不可以拘系常言，以太平之理责人于迍邅之世。","book":"《晋书·张轨传》"},"usage":"作宾语；用于书面语"},{"id":43230,"word":"迎刃以解","pinyin":"yíng rèn yǐ jiě","abbr":"yryj","explanation":"比喻处理事情、解决问题很顺利。同“迎刃而解”。","source":{"text":"准此推之，以真理诘幻状，以实验捣虚情，虽举国若狂，万人同梦，而迎刃以解，涣然冰消。","book":"《中国近代文论选·论科学之发达可以辟旧小说之荒谬思想》"},"similar":["迎刃立解","迎刃而解","迎刃而理"],"usage":"作谓语、定语、宾语；指很顺利"},{"id":43231,"word":"迎刃冰解","pinyin":"yíng rèn bīng jiě","abbr":"yrbj","explanation":"比喻处理事情、解决问题很顺利。同“迎刃而解”。","source":{"text":"至于要言微趣，人所难知，往往迎刃冰解。","book":"宋·叶適《题张君所注佛书》"},"similar":["迎刃而理","迎刃而解"],"usage":"作谓语、定语、宾语；指很顺利"},{"id":43232,"word":"迎刃立解","pinyin":"yíng rèn lì jiě","abbr":"yrlj","explanation":"比喻处理事情、解决问题很顺利。同“迎刃而解”。","source":{"text":"苟官兵长驱，则澧州、常德、湘阴，迎刃立解，可以夹攻长沙。","book":"清·魏源《圣武记》卷二"},"similar":["迎刃而理","迎刃而解","迎刃以解"],"usage":"作谓语、定语、宾语；指很顺利"},{"id":43233,"word":"迎刃而判","pinyin":"yíng rèn ér pàn","abbr":"yrep","explanation":"原意是说，劈竹子时，头上几节一破开，下面的顺着刀口自己就裂开了。比喻处理事情、解决问题很顺利。","source":{"text":"今兵威已振，譬如破竹，数节之后，皆迎刃而解。","book":"《晋书·杜预传》"},"example":{"text":"于此看得分明，则性情之分可见，而前日所疑，皆可～矣。","book":"宋·朱熹《答何叔京书》其二十四"}},{"id":43234,"word":"迎刃而理","pinyin":"yíng rèn ér lǐ","abbr":"yrel","explanation":"比喻处理事情、解决问题很顺利。同“迎刃而解”。","source":{"text":"潍，剧邑也，事繁丛弊，先大夫以书生受事，迎刃而理。","book":"清·周在浚《行述》"},"similar":["迎刃冰解","迎刃立解","迎刃而解"],"usage":"作谓语、定语、宾语；指很顺利"},{"id":43235,"word":"迎刃而解","pinyin":"yíng rèn ér jiě","abbr":"yrej","explanation":"原意是说，劈竹子时，头上几节一破开，下面的顺着刀口自己就裂开了。比喻处理事情、解决问题很顺利。","source":{"text":"今兵威已振，譬如破竹，数节之后，皆迎刃而解。","book":"《晋书·杜预传》"},"example":{"text":"只要这位教士到场，任你事情如何棘手，亦无不～的。","book":"清·李宝嘉《官场现形记》第五十四回"},"similar":["易如反掌","迎刃冰解"],"opposite":["百思不解"],"usage":"作谓语、定语、宾语；指很顺利","story":["公元280年，西晋镇南大将军杜预向晋武帝司马炎建议，讨伐吴国，他调兵遣将，10天功夫就占领了长江流域的大片地方。当时有人建议收兵待来年春天再战。杜预认为要乘胜追击，趁士气高涨时出兵就能迎刃而解，不久就一举占了吴国"]},{"id":43236,"word":"迎头痛击","pinyin":"yíng tóu tòng jī","abbr":"yttj","explanation":"迎头：迎面，当头；痛：狠狠地。迎上去给敌人以狠狠的打击。","source":{"text":"倘使此辈都是识时务熟兵机之员，外人扰我海疆时，迎头痛击，杀他个片甲不回。","book":"清·吴趼人《发财秘诀》"},"example":{"text":"我只见到对青年作家的～，冷笑，抹杀，却很少见诱掖奖劝的意思的批评。","book":"鲁迅《华盖集·并非闲话（三）》"},"similar":["浴血奋战"],"opposite":["负隅顽抗"],"usage":"作谓语、宾语；指打击敌人"},{"id":43237,"word":"迎头赶上","pinyin":"yíng tóu gǎn shàng","abbr":"ytgs","explanation":"迎：向着；头：走在前面的。加紧追过最前面的。","source":{"text":"这样，所谓迎头赶上和勿向后跟，都是不但见于经传，而且证诸实验的真理了。","book":"瞿秋白《迎头经》"},"example":{"text":"应该善用时机，～。","book":"夏衍《论正规化》"},"similar":["奋起直追"],"opposite":["退避三舍","踌躇不前","甘拜下风"],"usage":"作谓语；指追赶"},{"id":43238,"word":"迎奸卖俏","pinyin":"yíng jiān mài qiào","abbr":"yjmq","explanation":"指卖弄姿色，诱人偷情。","source":{"text":"浇奠罢守定灵床哭少年，则落的两泪涟涟，怕有一等迎奸卖俏俊官员，打一副金头面，早忘了守三年。","book":"元·岳伯川《铁拐李》第二折"},"example":{"text":"况兼这些偷寒送暖，～，各式各样许多方法，都学得熟滔滔在肚里。","book":"清·张南庄《何典》第四回"},"usage":"作谓语、定语；多用于女性"},{"id":43239,"word":"迎意承旨","pinyin":"yǐng yì chéng zhǐ","abbr":"yycz","explanation":"迎合、承接别人的意思。","source":{"text":"刘氏多智，善迎意承旨，其他嫔御莫得进见。","book":"《新五代史·唐庄宗神闵敬皇后刘氏传》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":43240,"word":"迎新弃旧","pinyin":"yíng xīn qì jiù","abbr":"yxqj","explanation":"指离开旧夫，再嫁新君。","source":{"text":"新人迎来旧人弃，掌上莲花眼中刺。迎新弃旧未足悲，悲在君家留两儿。","book":"唐·白居易《母别子》"}},{"id":43241,"word":"迎新送故","pinyin":"yíng xīn sòng gù","abbr":"yxsg","explanation":"泛指迎来新的，送走旧的。同“迎新送旧”。","source":{"text":"有迎新送故之困，朝令夕改之烦，自非有为而为，曷若且仍其旧。","book":"唐·元稹《授马总检校刑部尚书天平军节度使制》"},"example":{"text":"氓俗土宜，未及周悉；～，已闻代换。","book":"宋·宋敏求《宝历元年正月南郊敕》"},"similar":["送故迎新","迎新送旧","送旧迎新"],"usage":"作谓语、宾语；形容新旧交替"},{"id":43242,"word":"迎新送旧","pinyin":"yíng xīn sòng jiù","abbr":"yxsj","explanation":"旧指欢送卸任的官吏，迎接新来接替的官吏。后泛指送走旧的，凶恶新的。","source":{"text":"吏或居官数月而退，送故迎新，交错道路。","book":"《汉书·王嘉传》"},"example":{"text":"我管的那僧尼道俗乐人，～都是小人该管。","book":"元·关汉卿《谢天香》楔子"},"similar":["辞旧迎新","迎新送故","送旧迎新"],"usage":"作谓语、定语、宾语；用于交往等"},{"id":43243,"word":"迎来送往","pinyin":"yíng lái sòng wǎng","abbr":"ylsw","explanation":"走的欢送，来的欢迎。形容忙于交际应酬。","source":{"text":"其送往而迎来，来者勿禁，往者勿止。","book":"战国·宋·庄周《庄子·山木》"},"example":{"text":"天地山河有真主，～总成空。","book":"明·刘基《过苏州》"},"usage":"作谓语、定语、宾语；指接待工作"},{"id":43244,"word":"迎神赛会","pinyin":"yíng shén sài huì","abbr":"yssh","explanation":"旧俗把神像抬出庙来游行，并举行祭会，以求消灾赐福。","source":{"text":"抬头觑是个钟楼模样，往下觑却是人旋窝。见几个妇女向台儿上坐，又不是迎神赛社，不住的擂鼓筛锣。","book":"元·杜仁杰《耍孩儿·庄家不识构阑》套曲"},"example":{"text":"孩子们所盼望的，过年过节之外，大概要数～的时候了。","book":"鲁迅《朝花夕拾·五猖会》"}},{"id":43245,"word":"迎门请盗","pinyin":"yíng mén qǐng dào","abbr":"ymqd","explanation":"比喻至孝。","source":{"text":"咨少孤，有孝行……盗尝夜往劫之，咨恐母惊惧，乃先至门迎盗，因请为设食。","book":"典出《后汉书·赵咨传》"},"example":{"text":"昔人～，恒怀废寝之忧，当挽舆梓，犹有危途之惧。","book":"南朝·陈·徐陵《在北齐与梁太尉王僧辩书》"},"usage":"作谓语、定语；用于书面语","story":["东汉时期，敦煌太守赵咨年幼时死了父亲，他十分孝顺母亲，有一天晚上，他侍候母亲睡觉后，听到门外有强盗的声音，担心母亲惊醒后害怕，就主动开门请强盗到家里，给他们准备吃的。强盗们吃完后就立即离开"]},{"id":43246,"word":"迎风冒雪","pinyin":"yíng fēng mào xuě","abbr":"yfmx","explanation":"迎：对着，冲着。顶着寒风，冒着大雪。常形容旅途艰辛。","source":{"text":"真个是迎风冒雪，戴月披星，行彀多时，又值早春天气，但见三阳转运，万物生辉。","book":"明·吴承恩《西游记》第四十四回"},"example":{"text":"明·吴承恩《西游记》第44回：“真个是～，戴月披星。”"},"usage":"作宾语、状语；用于处事"},{"id":43247,"word":"迎风待月","pinyin":"yíng fēng dài yuè","abbr":"yfdy","explanation":"指男女秘密约会。","source":{"text":"待月西厢下，迎风户半开，拂墙花影动，疑是玉人来。","book":"唐·元稹《莺莺传》"},"example":{"text":"分明是～蒲东户，两下间偷吟诗句。","book":"明·孟称舜《娇红记·密约》"},"usage":"作谓语、定语；指男女秘密约会"},{"id":43248,"word":"迎风招展","pinyin":"yíng fēng zhāo zhǎn","abbr":"yfzz","explanation":"招展：飘动，摇动。形容旗子等随风飘扬。","source":{"text":"红旗一面迎风招展，附近至少一公里的半径内似乎都可以望见。","book":"郭沫若《洪波曲·南京印象》"},"example":{"text":"广场上到处是红旗在～。"},"similar":["随风飘扬","迎风飘扬"],"opposite":["偃旗息鼓"],"usage":"作谓语、定语；形容旗子等"},{"id":43249,"word":"运之掌上","pinyin":"yùn zhī zhǎng shàng","abbr":"yzzs","explanation":"运：运动，运转。运转于手掌之上。比喻极其容易。","source":{"text":"以不忍人之心，行不忍人之政，治天下可运之掌上。","book":"《齐桓晋文之事》：“老吾老，以及人之老；幼吾幼，以及人之幼；天下可运于掌。”《孟子·公孙丑上》"},"usage":"作谓语、定语；用于比喻句"},{"id":43250,"word":"运乖时蹇","pinyin":"yùn guāi shí jiǎn","abbr":"ygsj","explanation":"指时运不佳，处于逆境。同“运蹇时乖”。","source":{"text":"这是弟子运乖时蹇，异事非常。","book":"明·许仲琳《封神演义》第十三回"},"similar":["运拙时乖"],"usage":"作谓语、定语；用于书面语"},{"id":43251,"word":"运开时泰","pinyin":"yùn kāi shí tài","abbr":"ykst","explanation":"指时运吉利太平。","source":{"text":"台殿风微，山河气转，欣逢运开时泰。","book":"明·梁辰鱼《浣纱记·宴臣》"},"similar":["运旺时盛"],"opposite":["运乖时蹇","运蹇时乖"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":43252,"word":"运拙时乖","pinyin":"yùn zhuō shí guāi","abbr":"yzsg","explanation":"指时运不佳，处于逆境。","source":{"text":"莫不是你缘薄，都一般运拙时乖。","book":"元·关汉卿《五侯宴》第五折：“也是我运拙时乖，舍死的尽心儿奈。”元·王德信《四块玉》套曲"},"example":{"text":"明·无名氏《龙门隐秀》第三折：“则为这孝公姑劳苦饥寒，一时间～。”"},"similar":["运乖时蹇","运蹇时乖","运拙时艰"],"opposite":["运转时来"],"usage":"作谓语、定语；用于书面语"},{"id":43253,"word":"运拙时艰","pinyin":"yùn zhuō shí jiān","abbr":"yzsj","explanation":"指时运不佳，处于逆境。","source":{"text":"便似班定远在玉门关，空学的兵书战策，争奈运拙时艰，淹留在此去住无门。","book":"元·陈以仁《存孝打虎》第二折"},"similar":["运乖时蹇","运蹇时乖","运拙时乖"],"usage":"作谓语、定语；用于书面语"},{"id":43254,"word":"运掉自如","pinyin":"yùn diào zì rú","abbr":"ydzr","explanation":"指运用和回旋都非常熟练自然。","source":{"text":"提要驳之，谓犹能举七十斤者，举百斤则蹶，举五十斤则运掉自如，其言甚辨。","book":"王国维《人间词话》五三"},"usage":"作谓语、定语、状语；用于处事"},{"id":43255,"word":"运斤如风","pinyin":"yùn jīn rú fēng","abbr":"yjrf","explanation":"指挥斧成风声。形容技术的高妙。","source":{"text":"平阳贾叟，无目而能刻神像……僧说贾初立木胎，先摸索之，意有所会，运斤如风。","book":"金·元好问《续夷坚志·贾叟刻木》"},"similar":["运斤成风"],"usage":"作谓语、定语；用于技艺等"},{"id":43256,"word":"运斤成风","pinyin":"yùn jīn chéng fēng","abbr":"yjcf","explanation":"运：挥动；斤：斧头。挥动斧头，风声呼呼。比喻手法纯熟，技术高超。","source":{"text":"郢人垩漫其鼻端，若蝇翼，使匠石斫之。匠石运斤成风，听而斫之，尽垩而鼻不伤，郢人立不失容。","book":"《庄子·徐无鬼》"},"example":{"text":"故善旧国者，必有～，垩去而鼻不伤之手段。","book":"清·梁启超《变法通议·论变法后安置守旧大雅之法》"},"similar":["运斤如风","游刃有余"],"usage":"作定语；指技艺"},{"id":43257,"word":"运斧般门","pinyin":"yùn fǔ bān mén","abbr":"yfbm","explanation":"犹言班门弄斧。","source":{"text":"向管中窥豹那知外，坐井底观天又出来，运斧般门志何大。","book":"元·周德清《一枝花·遗张伯元》套曲"},"similar":["班门弄斧"],"usage":"作谓语、宾语；用于书面语"},{"id":43258,"word":"运旺时盛","pinyin":"yùn wàng shí shèng","abbr":"ywss","explanation":"时运旺盛。指运道很好。","source":{"text":"我说你们放了他回去走走罢，你们断不依我的话，如今只等他请出个运旺时盛的人来才罢。","book":"清·曹雪芹《红楼梦》第十六回"},"similar":["运开时泰"],"opposite":["运乖时蹇","运蹇时乖"],"usage":"作谓语、定语；用于书面语"},{"id":43259,"word":"运智铺谋","pinyin":"yùn zhì pù móu","abbr":"yzpm","explanation":"运用计谋。","source":{"text":"未知那小将军，怎生排兵布阵，运智铺谋，有何计策，保某赴会去也。","book":"明·无名氏《临潼斗宝》头折"},"similar":["运计铺谋"],"usage":"作谓语、宾语、定语；用于处事"},{"id":43260,"word":"运用之妙，在于一心","pinyin":"yùn yòng zhī miào，zài yú yī xīn","abbr":"yyzmzyyx","explanation":"指兵法运用得巧妙，全在于善于思考。","source":{"text":"且不要管他。‘运用之妙，在于一心。’","book":"清·吴敬梓《儒林外史》第四十三回"},"similar":["运用之妙，在乎一心"],"usage":"作状语、分句；用于战争"},{"id":43261,"word":"运用之妙，存乎一心","pinyin":"yùn yòng zhī miào，cún hū yī xīn","abbr":"yyzmchyx","explanation":"存乎：在于。意思是摆好阵势以后出战，这是打仗的常规，但运用的巧妙灵活，全在于善于思考。指高超的指挥作战的艺术。","source":{"text":"阵而后战，兵法之常，运用之妙，存乎一心。","book":"《宋史·岳飞传》记载，岳飞对宗泽说"},"example":{"text":"古人所谓“～”，这个“妙”，我们叫做灵活性，这是聪明的指挥员的出产品。","book":"毛泽东《论持久战》"},"similar":["运用之妙，存于一心"],"usage":"作状语、分句；用于战争","story":["1125年，金兵在灭了辽国后，大举南侵，渡过黄河扑向宋都汴京，岳飞奉命率军迎敌。由于岳飞机智善战，多次挫败金兵，副元帅宗泽送他一幅古阵图。岳飞婉转地说：“阵而后战，兵法之常，运用之妙，存乎一心。”"]},{"id":43262,"word":"运用自如","pinyin":"yùn yòng zì rú","abbr":"yyzr","explanation":"自如：活动不受阻碍。形容运用得非常熟练自然。","source":{"text":"幅员稍狭，故得厉行自制，而运用自如。","book":"清·梁启超《开明专政论》"},"example":{"text":"这些数学公式他掌握的很好，所以做题能～。"},"usage":"作谓语；指操作熟练"},{"id":43263,"word":"运移时易","pinyin":"yùn yí shí yì","abbr":"yysy","explanation":"指运数终尽，时势变易。","source":{"text":"金国凤之善守，曹变蛟之力战，均无愧良将材，然而运移时易，难于建功而易于挫败。","book":"《明史·金国凤曹变蛟传赞》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":43264,"word":"运策决机","pinyin":"yùn cè jué jī","abbr":"ycjj","explanation":"筹划情况，拟订作战策略。","source":{"text":"况于调元赞化，以召祯祥，运策决机，而居帷幄，功盖出于门下，赏奚及于军中。","book":"明·徐渭《代谢阁下启》"},"similar":["运筹决策","运筹决算"],"usage":"作谓语、定语；用于处事"},{"id":43265,"word":"运策帷幄","pinyin":"yùn cè wéi wò","abbr":"ycww","explanation":"指在后方决定作战策略。","source":{"text":"若乃运策帷幄，折冲樽俎，何以图恢复，何以靖海氛，自智勇不世出之事，非鄙心所敢任。","book":"清·谭嗣同《上欧阳瓣薑师书》"},"similar":["运筹帷握"],"usage":"作谓语、定语；用于处事"},{"id":43266,"word":"运筹借箸","pinyin":"yùn chóu jiè zhù","abbr":"ycjz","explanation":"指运筹计谋。","source":{"text":"求借所食之箸用指画也。","book":"《史记·留侯世家》：“汉王方食，曰：‘子房前！客有为我计桡楚权者。’具以丽生语告，曰：‘于子房何如？’……张良对曰：‘臣请藉前箸为大王筹之！’”裴骃集解引张晏曰"},"example":{"text":"难道就束手待毙不成！休僝僽，少不得要～，勉护神州。","book":"清·李渔《风筝误·请兵》"},"similar":["借箸运筹"],"usage":"作谓语、宾语；用于处事"},{"id":43267,"word":"运筹决策","pinyin":"yùn chóu jué cè","abbr":"ycjc","explanation":"筹划情况，拟订作战策略。","source":{"text":"所以当水陆军提督者……犹备有参佐数员，常与运筹决策，以资历练而审机宜。","book":"明·罗贯中《三国演义》第四十七回：“赤壁鏖兵用火攻，运筹决策尽皆同。”郑观应《盛世危言·练兵》"},"example":{"text":"郑观应《盛世危言·练兵》：“所以当水陆军提督者……犹备有参佐数员，常与～，以资历练而审机宜。”"},"similar":["运筹决算","运筹画策"],"usage":"作谓语、定语；用于处事"},{"id":43268,"word":"运筹决算","pinyin":"yùn chóu jué suàn","abbr":"ycjs","explanation":"筹划情况，拟订作战策略。","source":{"text":"运筹决算有神功，二虎还须逊一龙。","book":"明·罗贯中《三国演义》第一回"},"similar":["运筹决策"],"usage":"作谓语、宾语、定语；用于处事"},{"id":43269,"word":"运筹决胜","pinyin":"yùn chóu jué shèng","abbr":"ycjs","explanation":"指拟订作战策略以获取战斗胜利。","source":{"text":"夫运筹策帷帐之中，决胜於千里之外，吾不如子房（张良）。","book":"语出《史记·高祖本纪》"},"example":{"text":"加以～者，乃浮躁巧伪之士，不知彼己，妄动轻举，是以顿兵灵武，力疲食尽，自溃而归。","book":"宋·司马光《请革弊札子》"},"similar":["运筹制胜","运筹千里"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43270,"word":"运筹出奇","pinyin":"yùn chóu chū qí","abbr":"yccq","explanation":"拟订作战策略，定出奇计。","source":{"text":"《前书》高祖曰：‘运筹帷幄之中，决胜千里之外，子房是也。’出奇谓陈平从高祖定天下，凡六出奇计。","book":"《后汉书·文苑传上·杜笃》：“首策之臣，运筹出奇；虓怒之旅，如虎如螭。”李贤注"},"similar":["运筹帷幄"],"usage":"作谓语、定语；用于书面语"},{"id":43271,"word":"运筹制胜","pinyin":"yùn chóu zhì shèng","abbr":"yczs","explanation":"指拟订作战策略以获取战斗胜利。","source":{"text":"向使微臣督剿江、淮、豫、楚间，果能运筹制胜，马到功成，各省抚臣岂易于为力？","book":"明·卢象昇《剿荡衍期听候处分并陈贼势兵情疏》"},"similar":["运筹千里","运筹决胜"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43272,"word":"运筹千里","pinyin":"yùn chóu qiān lǐ","abbr":"ycql","explanation":"指拟订作战策略以获取战斗胜利。","source":{"text":"夫运筹策帷帐之中，决胜於千里之外，吾不如子房（张良）。","book":"语出《史记·高祖本纪》"},"example":{"text":"上柱国、总管、齐国公孟让……大将军、左长史邴元真等，并～，勇冠三军。","book":"《旧唐书·李密传》"},"similar":["运筹决胜","运筹制胜"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43273,"word":"运筹帏幄","pinyin":"yùn chóu wéi wò","abbr":"ycww","explanation":"指在后方决定作战策略。","source":{"text":"大总管运筹帏幄，继以中军，铁骑亘原野，金鼓动天地。","book":"《唐大唐左屯卫将军姜行本勒石纪功碑》"},"example":{"text":"将军过誉，惶恐之至，会（锺会）怎比大将军～！","book":"京剧《渡阴平》第二场"},"similar":["运筹帷幄","运筹决策","运筹设策"],"usage":"作谓语、定语；用于军事、政治等"},{"id":43274,"word":"运筹帷帐","pinyin":"yùn chóu wéi zhàng","abbr":"ycwz","explanation":"指在后方决定作战策略。","source":{"text":"夫运筹策帷帐之中，决胜於千里之外，吾不如子房（张良）。","book":"语出《史记·高祖本纪》"},"example":{"text":"［刘藏春］佐命新朝，～，致位枢衡，乃复作此等感慨语，何耶？","book":"况周颐《蕙风词话》卷三"},"similar":["运筹帏幄"],"usage":"作谓语、定语；用于处事","story":["宋朝时期，绍兴省试《高祖能用三杰赋》，有一卷文很奇特，第四韵押“运筹帷帐”。考官以《汉书》是“惟幄”，非“帐”字，没有录取。考官出院后就告诉周益公，周说：“有司误也，《史记》正是‘帷帐’，《汉书》乃作‘幄’。”"]},{"id":43275,"word":"运筹帷幄","pinyin":"yùn chóu wéi wò","abbr":"ycww","explanation":"筹：计谋、谋划；帷幄：古代军中帐幕。指拟定作战策略。引申为筹划、指挥。","source":{"text":"筹：计谋、谋划；帷幄：古代军中帐幕。指拟定作战策略。引申为筹划、指挥。"},"example":{"text":"筹：计谋、谋划；帷幄：古代军中帐幕。指拟定作战策略。引申为筹划、指挥。"},"similar":["握筹布画","运筹决策"],"usage":"作谓语、定语；用于军事、政治等","story":["刘邦当皇帝后在都城洛阳南宫摆酒宴，招待文武百官。他问百官他与项羽的区别，百官纷纷夸赞他大仁大义。刘邦说运筹帷幄不如张良，安抚百姓不如萧何，率军打仗不如韩信，但他能合理地使用他们三位俊杰，所以能得天下"]},{"id":43276,"word":"运筹帷幄之中，决胜千里之外","pinyin":"yùn chóu wéi wò zhī zhōng，jué shèng qiān lǐ zhī wài","abbr":"ycwwzzjsqlzw","explanation":"运：运筹；帷幄：军用帐幕；千里之外：指战场。在小小的军帐之内作出正确的部署，能决定千里之外战场上的胜负","source":{"text":"夫运筹帷幄之中，决胜于千里之外，吾不如子房。","book":"西汉·司马迁《史记·高祖本纪》"},"example":{"text":"清·百一居士《壶天录》上卷：“名将盖非徒以勇敢著也。胸罗武库，学具韬铃，～。”"},"similar":["运筹帷幄，决胜千里"],"usage":"作宾语、定语；用于处事","story":["西汉时期，刘邦当皇帝后在都城洛阳南宫摆酒宴，招待文武百官。他问百官他与项羽的区别，百官纷纷夸赞他大仁大义。刘邦说运筹帷幄不如张良，安抚百姓不如萧何，率军打仗不如韩信，但他能合理地使用他们三位俊杰，所以能得天下"]},{"id":43277,"word":"运筹帷幄，决胜千里","pinyin":"yùn chóu wéi wò，jué shèng qiān lǐ","abbr":"ycwwjsql","explanation":"筹：计谋、谋划；帷幄：古代军中帐幕。拟定作战策略，获取战斗的胜利。","source":{"text":"夫运筹帷幄之中，决胜千里之外，吾不如子房。","book":"《史记·高祖本纪》"},"example":{"text":"清·褚人获《隋唐演义》第37回：“如单二哥、王伯当，都是将之才；若说～，恐还未能。”"},"similar":["运筹帷幄之中，决胜千里之外"],"usage":"作宾语、定语；用于处事","story":["西汉时期，刘邦当皇帝后在都城洛阳南宫摆酒宴，招待文武百官。他问百官他与项羽的区别，百官纷纷夸赞他大仁大义。刘邦说运筹帷幄不如张良，安抚百姓不如萧何，率军打仗不如韩信，但他能合理地使用他们三位俊杰，所以能得天下"]},{"id":43278,"word":"运筹建策","pinyin":"yùn chóu jiàn cè","abbr":"ycjc","explanation":"筹划情况，拟订作战策略。","source":{"text":"运筹建策，通幽达冥，从命者获安，违命者悉祸。","book":"《隋书·李德林传》"},"similar":["运筹决策","运筹画策"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43279,"word":"运筹演谋","pinyin":"yùn chóu yǎn móu","abbr":"ycym","explanation":"筹划情况，拟订作战策略。","source":{"text":"太祖运筹演谋，鞭挞宇內。","book":"《三国志·魏书·武帝纪论》"},"similar":["运筹决策","运筹决算"],"usage":"作谓语、定语；用于书面语"},{"id":43280,"word":"运筹画策","pinyin":"yùn chóu huà cè","abbr":"ychc","explanation":"筹划情况，拟订作战策略。","source":{"text":"运筹画策，自具于章表；献可替否，总归于笔札。","book":"唐·刘知幾《史通·言语》"},"example":{"text":"是以天子安坐于上而士大夫为之奔走于下，大者为之～，治百官以济其大事；而小者为之按米盐，视鞭箠，以奉其小职。","book":"宋·苏辙《臣事策下》之五"},"similar":["运筹决策"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43281,"word":"运筹设策","pinyin":"yùn chóu shè cè","abbr":"ycsc","explanation":"筹划情况，拟订作战策略。","source":{"text":"日夜巡逻严预备，运筹设策夜衔枚。","book":"太平天国·洪秀全《诛妖歌》"},"similar":["运筹决策"],"usage":"作谓语、宾语、定语；用于处事"},{"id":43282,"word":"运筹谋画","pinyin":"yùn chóu móu huà","abbr":"ycmh","explanation":"指筹划计谋，制定策略。","source":{"text":"逮汉、魏已降，周、隋而往，世皆尚文，时无专对。运筹画策，自具于章表，献可替否，总归于笔札。","book":"唐·刘知己《史通·言语》"},"example":{"text":"如今生齿日繁，事务日盛，主仆上下，安富尊荣者尽多，～者无一。（清·曹雪芹《红楼梦》第二回）"}},{"id":43283,"word":"运计铺谋","pinyin":"yùn jì pù móu","abbr":"yjpm","explanation":"运用计谋。","source":{"text":"则要你鱼鳞般排军阵，雁行般列队伍，依着我运计铺谋。","book":"元·郑廷玉《后庭花》第二折：“哥也，你可怜见同衙共府，你休要运计铺谋。”元·无名氏《博望烧屯》第二折"},"similar":["运智铺谋"],"usage":"作谓语、宾语、定语；用于处事"},{"id":43284,"word":"运蹇时乖","pinyin":"yùn jiǎn shí guāi","abbr":"yjsg","explanation":"指时运不佳，处于逆境。","source":{"text":"陈光蕊运蹇時乖，著王安雇咱船只，一见他媳妇丰姿，又爱他钱财段匹，将主仆命丧江心。","book":"元·杨讷《西游记》第四出"},"example":{"text":"我李靖居官二十五载，谁知今日～。","book":"明·许仲琳《封神演义》第十三回"},"similar":["运乖时蹇","运拙时乖"],"opposite":["运开时泰"],"usage":"作谓语、定语；用于书面语"},{"id":43285,"word":"运蹇时低","pinyin":"yùn jiǎn shí dī","abbr":"yjsd","explanation":"指时运不佳，处于逆境。","source":{"text":"相抛万里，想合受凄凉，是我运蹇时低。","book":"明·谢谠《四喜记·翠阁耽思》"},"similar":["运乖时蹇","运蹇时乖"],"opposite":["运开时泰"],"usage":"作谓语、定语；用于书面语"},{"id":43286,"word":"运转时来","pinyin":"yùn zhuǎn shí lái","abbr":"yzsl","explanation":"时机来了，运气也有了转机。指由逆境转为顺境。","source":{"text":"至境界不顺，希冀运转时来，偶一推算，此亦人情之常，即使推算不准，亦属无伤。","book":"清·李汝珍《镜花缘》第十二回"},"example":{"text":"他盼望～的时候"},"similar":["时来运转"],"opposite":["运拙时乖"],"usage":"作谓语、定语；指转好"},{"id":43287,"word":"近不逼同","pinyin":"jìn bù bī tóng","abbr":"jbbt","explanation":"近：亲善；同：同僚。旧指自己受到君王的宠幸，但不以此去欺侮、要挟同僚。","source":{"text":"戊之为人也，远不忘君，近不逼同。","book":"《左传·昭公二十八年》"}},{"id":43288,"word":"近乡情怯","pinyin":"jìn xiāng qíng qiè","abbr":"jxqq","explanation":"指远离家乡多年，不通音信，一旦返回，离家乡越近，心情越不平静，惟恐家乡发生了什么不幸的事。用以形容游子归乡时的复杂心情。","source":{"text":"岭外音书断，经冬复历春，近乡情更怯，不敢问来人。","book":"唐·宋之问《汉江》诗"},"example":{"text":"鸿渐这两天～，心事重重，他觉得回家并不像理想那样的简单。","book":"钱钟书《围城》十七"},"usage":"作宾语、定语；用于书面语"},{"id":43289,"word":"近交远攻","pinyin":"jìn jiāo yuǎn gōng","abbr":"jjyg","explanation":"指与邻近者交好，而对较远者施用武力。","source":{"text":"如其怨恨有因，即可加意招徕，供我指臂，此近交远攻之计也。","book":"清·夏燮《中西纪事·互市档案》"},"similar":["远攻近交"],"usage":"作宾语、定语；用于对外交往"},{"id":43290,"word":"近亲繁殖","pinyin":"jìn qīn fán zhí","abbr":"jqfz","explanation":"指亲缘关系近的家畜个体间交配繁殖。可以用于领导干部在自己权利范围内任人唯亲。","source":{"text":"某省一位县委书记说，由于多年的近亲繁殖，如果查处一个科级干部，就会得罪半个县城。","book":"张周《步履艰难的中国》第十章"},"example":{"text":"～不利于后代的健康。"},"usage":"作主语、宾语；用于生殖或人事等"},{"id":43291,"word":"近在咫尺","pinyin":"jìn zài zhǐ chǐ","abbr":"jzzc","explanation":"咫尺：很近的距离。形容距离很近。","source":{"text":"凛然威光，近在咫尺。","book":"宋·苏轼《杭州谢上表》"},"example":{"text":"那马明明～，却误为丧失不见，就如“心不在焉，视而不见”之意。","book":"清·李汝珍《镜花缘》第十七回"},"similar":["一衣带水","天涯比邻","迫在眉睫"],"opposite":["天涯海角","山南海北"],"usage":"作谓语、宾语、定语；指两者间的距离很近"},{"id":43292,"word":"近在眉睫","pinyin":"jìn zài méi jié","abbr":"jzmj","explanation":"睫：眼睫毛。形容很近，就在眼前。","source":{"text":"虽远在八荒之外，近在眉睫之内，来干我者，我必知之。","book":"战国·郑·列御寇《列子·仲尼》"},"example":{"text":"期末考试～了，我们得好好复习。"},"similar":["近在咫尺"],"opposite":["远在天边"],"usage":"作谓语；形容很近，就在眼前"},{"id":43293,"word":"近墨者黑","pinyin":"jìn mò zhě hēi","abbr":"jmzh","explanation":"接近黑色就会使自身变黑。比喻接近坏人易使人学坏。指客观环境对人有很大影响。","usage":"多用于贬义。"},{"id":43294,"word":"近悦远来","pinyin":"jìn yuè yuǎn lái","abbr":"jyyl","explanation":"使近处的人受到好处而高兴，远方的人闻风就会前来投奔。旧指当权者给人恩惠，以便笼络人心。","source":{"text":"叶公问政，子曰：‘近者说（悦），远者来。’","book":"春秋·鲁·孔丘《论语·子路》"},"example":{"text":"民间客店门外经常写着‘安寓客商，仁宦行台’与‘～，宾至如归’之类的字样。","book":"李克非《京华感旧录·千里客来投》"},"similar":["悦近来远"],"usage":"作谓语、定语；指政治影响","story":["春秋时期，楚国大夫沈诸梁因封地于叶被称为叶公，孔子周游列国，来到楚国的叶邑，叶公向他请教怎样治理一个地方。孔子回答：“近者悦，远者来。”告诉他要先让境内的人民欢悦无怨，于是远处的人就会慕名而来投奔"]},{"id":43295,"word":"近朱者赤","pinyin":"jìn zhū zhě chì","abbr":"jzzc","explanation":"朱：朱砂。靠近朱砂的变红。比喻接近好人容易使人变好。指外部环境具有很大影响。","source":{"text":"故近朱者赤，近墨者黑；声和则响清，形正则影直。","book":"晋·傅玄《傅鹑觚集·太子少傅箴》"},"example":{"text":"我们都明白～的道理。"},"similar":["潜移默化"],"opposite":["近墨者黑"],"usage":"作宾语、定语；用于劝诫人","story":["晋朝文学家和哲学家傅玄在《太子少傅箴》中指出：“近朱者赤，近墨者黑；声和则响清，形正则影直。”告诉人们一个人生活在好的环境里受到好的影响，生活在坏的环境里也会受到坏的影响，强调环境对人的影响"]},{"id":43296,"word":"近朱者赤，近墨者黑","pinyin":"jìn zhū zhě chì，jìn mò zhě hēi","abbr":"jzzcjmzh","explanation":"靠着朱砂的变红，靠着墨的变黑。比喻接近好人可以使人变好，接近坏人可以使人变坏。指客观环境对人有很大影响。","source":{"text":"故近朱者赤，近墨者黑；声和则响清，形正则影直。","book":"晋·傅玄《太子少傅箴》"},"example":{"text":"原来～，朱樱日日伏侍小姐，绣床之暇，读书识字，此窃颇通。","book":"清·无名氏《西湖二集·洒雪堂巧结良缘》"},"similar":["耳濡目染"],"usage":"作宾语、分句；可分开使用","story":["晋朝文学家和哲学家傅玄在《太子少傅箴》中指出：“近朱者赤，近墨者黑；声和则响清，形正则影直。”告诉人们一个人生活在好的环境里受到好的影响，生活在坏的环境里也会受到坏的影响，强调环境对人的影响"]},{"id":43297,"word":"近朱近墨","pinyin":"jìn zhū jìn mò","abbr":"jzjm","explanation":"靠着朱砂的变红，靠着墨的变黑。比喻接近好人可以使人变好，接近坏人可以使人变坏。指客观环境对人有很大影响。","source":{"text":"故近朱者赤，近墨者黑；声和则响清，形正则影直。","book":"晋·傅玄《太子少傅箴》"}},{"id":43298,"word":"近水惜水","pinyin":"jìn shuǐ xī shuǐ","abbr":"jsxs","explanation":"虽靠近水源，用水方便，但也很珍惜水。比喻即便容易得到的东西也不能浪费。","source":{"text":"谚云：‘近水惜水’，此实修福之事云。","book":"宋·林洪《山家清事·泉源》"}},{"id":43299,"word":"近水楼台","pinyin":"jìn shuǐ lóu tái","abbr":"jslt","explanation":"水边的楼台先得到月光。比喻能优先得到利益或便利的某种地位或关系。","source":{"text":"范文正公镇钱塘，兵官皆被荐，独巡检苏麟不见录，乃献诗云：‘近水楼台先得月，向阳花木易逢春。’","book":"宋·俞文豹《清夜录》"},"example":{"text":"他的表兄调任了，调到他去年教课的那所中学校来当校长了。～，自然容易得月。","book":"叶圣陶《得失》"},"similar":["靠山吃山","靠水吃水"],"opposite":["隔岸观火"],"usage":"作主语、宾语、定语；指优先","story":["宋仁宗时期，杭州知府范仲淹脾气温和，与手下人同甘共苦，很多人得到他的关心与推荐提拔，有一个外地巡检苏麟到杭州办事，送范仲淹一首诗：“近水楼台先得月，向阳花木易为春”，范仲淹明白他的意思就给了他想要的东西"]},{"id":43300,"word":"近水楼台先得月","pinyin":"jìn shuǐ lóu tái xiān dé yuè","abbr":"jsltxdy","explanation":"水边的楼台先得到月光。比喻由于接近某些人或事物而抢先得到某种利益或便利。","source":{"text":"范文正公镇钱唐，兵官皆被荐，独巡检苏麟不见录，乃献诗云：‘近水楼台先得月，向阳花木易为春。’公即荐之。","book":"宋·俞文豹《清夜录》"},"example":{"text":"方许注选。正是‘～，向阳花木易为春’。","book":"明·汤显祖《紫钗记·权夸选士》"},"similar":["靠山吃山","靠水吃水","近水楼台"],"usage":"作宾语、分句；比喻因近便而获得优先机会","story":["宋仁宗时期，杭州知府范仲淹脾气温和，与手下人同甘共苦，很多人得到他的关心与推荐提拔，有一个外地巡检苏麟到杭州办事，送范仲淹一首诗：“近水楼台先得月，向阳花木易为春”，范仲淹明白他的意思就给了他想要的东西"]},{"id":43301,"word":"近火先焦","pinyin":"jìn huǒ xiān jiāo","abbr":"jhxj","explanation":"比喻跟祸事最接近的人首先遭殃。","source":{"text":"僧问：‘如何是佛？’师曰：‘近火先焦。’曰：‘如何是道？’师曰：‘泥里有剌。’","book":"宋·释普济《五灯会元》卷十九"},"example":{"text":"常言道：“～。”伯伯便替我们吃官司坐牢，那时又没人送饭来救你。","book":"明·施耐庵《水浒全传》第四十九回"},"usage":"作宾语、定语；比喻跟祸事接近的人首先遭殃"},{"id":43302,"word":"返哺之恩","pinyin":"fǎn bǔ zhī ēn","abbr":"fbze","explanation":"返哺：雏鸟长大，衔食哺其母。比喻报答亲恩。","source":{"text":"君如念妾，还祈以楼宅相假，使妾得以返哺之私。","book":"《春秋运斗枢》：“飞翔羽翮为阳，阳气仁，故乌反哺也。”清·蒲松龄《聊斋志异·青凤》"},"similar":["反哺之私"],"usage":"作宾语；比喻报答亲恩"},{"id":43303,"word":"返哺之私","pinyin":"fǎn bǔ zhī sī","abbr":"fbzs","explanation":"返哺：雏鸟长大，衔食哺其母。比喻报答亲恩。","source":{"text":"君如念妾，还祈以楼宅相假，使妾得以申返哺之私。","book":"清·蒲松龄《聊斋志异·青凤》"},"similar":["返哺之恩"],"usage":"作宾语；比喻报答亲恩"},{"id":43304,"word":"返我初服","pinyin":"fǎn wǒ chū fú","abbr":"fwcf","explanation":"返：归还；初服：未做官时的衣服。比喻辞官归隐。","source":{"text":"愿返初服，从子而归。","book":"三国·魏·曹植《七启》"},"usage":"作谓语；比喻辞官归隐"},{"id":43305,"word":"返本朝元","pinyin":"fǎn běn cháo yuán","abbr":"fbcy","explanation":"犹言返本还源。","source":{"text":"便着铁拐李岳直至下方，度脱此二人，走一朝去，还归正道，返本朝元。","book":"元·无名氏《玩江亭》第一折"},"similar":["返本还源"],"usage":"作谓语、宾语；指回复正道"},{"id":43306,"word":"返本还元","pinyin":"fǎn běn huán yuán","abbr":"fbhy","explanation":"犹言返本还源。","source":{"text":"那时着第十六尊罗汉月明尊者，直至人间点化柳翠，返本还元，同登佛会。","book":"元·李寿卿《度柳翠》楔子"},"example":{"text":"如此则以外物染移灭了真性，不能～，那得成仙作祖。","book":"《快心编二集》第四回"},"similar":["返本朝元","反本还原"],"usage":"作谓语、宾语；指回复正道"},{"id":43307,"word":"返本还原","pinyin":"fǎn běn huán yuán","abbr":"fbhy","explanation":"本、原：根本，原貌。返回原来的地方。佛教说法，指忘了本原的人通过拜佛修行，回到本原状态；或指贬谪人世的仙人又回到仙界。","source":{"text":"返本还原真体现，魂魄聚，净无阴。","book":"元·刘志渊《江神志令》"},"example":{"text":"后来直使得一尊古佛，来度柳翠，归依正道，～，成佛作祖。","book":"明·冯梦龙《喻世明言》卷二十九"},"similar":["返本还源"],"usage":"作谓语、宾语；指恢复原样"},{"id":43308,"word":"返本还源","pinyin":"fǎn běn huán yuán","abbr":"fbhy","explanation":"本、原：根本，原貌。返回原来的地方。佛教说法，指忘了本原的人通过拜佛修行，回到本原状态；或指贬谪人世的仙人又回到仙界。","source":{"text":"一年将欲尽，万里未归人，大众总是他乡之客，还有返本还源者么？","book":"宋·释普济《五灯会元·宝峰文禅师法嗣》"},"similar":["返本还源"],"opposite":["面目全非"],"usage":"作谓语、宾语；指恢复原样"},{"id":43309,"word":"返朴归真","pinyin":"fǎn pǔ guī zhēn","abbr":"fpgz","explanation":"归：返回；真：天然，自然。去掉外饰，还其本质。比喻回复原来的自然状态。","source":{"text":"归真反璞，则终身不辱也。","book":"西汉·刘向《战国策·齐策四》"},"example":{"text":"他讨伐的不是白话的‘反而难懂’，是白话的‘鲁里鲁苏’，连刘先生似的想白话‘～’的意思也全没有。","book":"鲁迅《花边文学》"},"similar":["回归自然","返璞归真"],"usage":"作谓语、宾语、定语；形容回复本真"},{"id":43310,"word":"返朴还淳","pinyin":"fǎn pǔ huán chún","abbr":"fphc","explanation":"返：返回，还。朴：朴实。淳：诚实，厚道。指恢复原始的诚实和朴实厚道的社会风气。","source":{"text":"用之治身，则神清志静；用之治国，则返朴还淳。","book":"隋·薛道衡《老氏碑》"},"example":{"text":"陛下贞观之初，动遵尧舜，捐金抵璧，～。","book":"唐·魏征《十渐不克终疏》"},"similar":["返朴归真"],"usage":"作谓语、定语；指复归于朴实敦厚"},{"id":43311,"word":"返朴还真","pinyin":"fǎn pǔ huán zhēn","abbr":"fphz","explanation":"去掉外饰，还其本质。比喻回复原来的自然状态。同“返朴归真”。","source":{"text":"就连那位声‘美言不信’，力主返朴还真的老聘，在他自己写《道德经》的时候，又何尝不运用精妙的语言来著书立说，可见他也并不反对真正美的文采。","book":"《人民日报》1961.8.19"},"similar":["返朴归真"],"usage":"作谓语、宾语、定语；形容回复本真"},{"id":43312,"word":"返来复去","pinyin":"fǎn lái fù qù","abbr":"flfq","explanation":"指多次重复。","source":{"text":"说醒着吧，他又神志不清，脑子里总是：黑马——白占魁——农业社，农业社——白占魁——黑马，返来复去地兜得他秃顶脑袋疼了起来。","book":"柳青《创业史》第二部第二五章"},"similar":["反来复去"],"usage":"作定语、状语；指重复"},{"id":43313,"word":"返正拨乱","pinyin":"fǎn zhèng bō luàn","abbr":"fzbl","explanation":"返：回复；正：正常；拨：治理；乱：乱世。整顿混乱局面，恢复正常秩序。","source":{"text":"向不遇返正拨乱之主，君臣父子之别；弈叶文武之雄，注意生灵之切。","book":"唐·杜甫《朝享太庙赋》"},"similar":["反正拨乱"],"usage":"作谓语、宾语、定语；指纠正重大错误"},{"id":43314,"word":"返照回光","pinyin":"fǎn zhào huí guāng","abbr":"fzhg","explanation":"佛教语。指用佛性对照检查，自我反省。","source":{"text":"等柳翠来时，击响云板，唱两句道《雨霖铃》：‘今宵醒醒何处，杨柳岸晓风残月。’那其间返照回光，同登大道。","book":"元·李寿卿《度柳翠》第四折"},"similar":["回光返照"],"usage":"作谓语、定语、状语；用于事物灭亡前夕"},{"id":43315,"word":"返璞归真","pinyin":"fǎn pú guī zhēn","abbr":"fpgz","explanation":"去掉外饰，还其本质。比喻回复原来的自然状态。同“返朴归真”。","source":{"text":"上帝基督化人，超凡入圣，返璞归真。","book":"太平天国·洪仁玕《英杰归真》"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“七姐现在～了，到处跟人学做菜。”"},"similar":["返朴归真","反璞归真"],"usage":"作谓语、宾语、定语；形容回复本真"},{"id":43316,"word":"返老归童","pinyin":"fǎn lǎo guī tóng","abbr":"flgt","explanation":"由衰老恢复青春。形容老年人充满了活力。同“返老还童”。","source":{"text":"第二返砂，服之一两，即体和神清，返老归童。","book":"《云笈七签》卷六九"},"similar":["返老还童"],"usage":"作谓语、定语、宾语；指人的外貌或精神"},{"id":43317,"word":"返老还童","pinyin":"fǎn lǎo huán tóng","abbr":"flht","explanation":"反：回。由衰老恢复青春。形容老年人充满了活力。","source":{"text":"可愈痿弱重膇之疾，复能返老还童。","book":"汉·史游《急就篇》：“长乐无极老复丁。”《旧唐书·宦官书》"},"example":{"text":"取此水用美玉为屑，调和服之，可以～。","book":"明·罗贯中《三国演义》第一百五回"},"similar":["鹤发童颜","老当益壮"],"opposite":["未老先衰"],"usage":"作谓语、定语、宾语；指人的外貌或精神","story":["西汉时期，淮南王刘安喜欢求仙问道，他潜心钻研，四处派人打听返老还童之术，访寻长生不老之药，一天一个白发老翁求见，说有返老还童之术，刘安认为老汉不可能有法术，就打发他走，只见一眨眼功夫，老汉就变成了儿童"]},{"id":43318,"word":"返虚入浑","pinyin":"fǎn xū rù hún","abbr":"fxrh","explanation":"①指诗作空灵，入于浑然之境。②指人无知无识，浑浑噩噩。","source":{"text":"返虚入浑，积健为雄。","book":"唐·司空图《二十四诗品·雄浑》"},"example":{"text":"他们是～，他们是等于‘无’——世界上就等于没有他们一样。","book":"郭沫若《塔·阳春别》"},"usage":"作谓语、定语；用于人或事物"},{"id":43319,"word":"返观内照","pinyin":"fǎn guān nèi zhào","abbr":"fgnz","explanation":"清·戴震《孟子字义疏证·理十五》：“于此不得其解，而见彼之捐弃物欲，返观内照，近于切己体察。”","source":{"text":"吾辈试于清夜平旦～，其能免于王子之所诃与否？ ★梁启超《新民说·论私德》"},"example":{"text":"梁启超《新民说·论私德》：“吾辈试于清夜平旦～，其能免于王子之所诃与否？”"},"similar":["返观内视","返视内照"],"usage":"作谓语、宾语；指自我反省"},{"id":43320,"word":"返观内视","pinyin":"fǎn guān nèi shì","abbr":"fgns","explanation":"原为佛教语。指用佛性对照检查。后亦指自我反省。","source":{"text":"即此宜得之公心，返观内视，而九幽十八狱，人人分明见之矣。","book":"清·蒲松龄《〈王如水问心集〉序》"},"similar":["返观内照","返视内照"],"usage":"作谓语、宾语；指自我反省"},{"id":43321,"word":"返视内照","pinyin":"fǎn shì nèi zhào","abbr":"fsnz","explanation":"原为佛教语。指用佛性对照检查。后亦指自我反省。","source":{"text":"澹然凝神静养一会，早听四野鸡鸣，于是垂目低眉，返视内照。","book":"《禅真逸史》第十七回"},"similar":["返观内照","返观内视"],"usage":"作谓语、宾语；指自我反省"},{"id":43322,"word":"返躬内省","pinyin":"fǎn gōng nèi xǐng","abbr":"fgnx","explanation":"躬：自身；省：检查，反省。回过头来检查自己的过失。","source":{"text":"今年过节春分，寒威未解，朕返躬内省，未能上感天和。","book":"《清史稿·文宗本纪》"},"similar":["反躬自省"],"opposite":["嫁祸于人"],"usage":"作谓语、定语、状语；用于有过失的人"},{"id":43323,"word":"返辔收帆","pinyin":"fǎn pèi shōu fān","abbr":"fpsf","explanation":"比喻退归。","source":{"text":"自兹二十年后，足下年造不吉，时至，当早图返辔收帆，移忠作孝。","book":"《儿女英雄传》第十八回"},"usage":"作谓语、宾语；指退隐"},{"id":43324,"word":"返邪归正","pinyin":"fǎn xié guī zhèng","abbr":"fxgz","explanation":"犹言改邪归正。","source":{"text":"唐·谭铢《庐州明教寺转关经藏记》；“由此八关，返邪归正，成佛之境矣。”"},"similar":["改邪归正"],"usage":"作谓语、宾语；指重新做人"},{"id":43325,"word":"返魂乏术","pinyin":"fǎn hún fá shù","abbr":"fhfs","explanation":"返魂：还魂，有起死回生之意；乏术：缺少方法。想使人起死回生却缺少方法。比喻人死无法救活，不能死而复生。"},{"id":43326,"word":"还乡昼锦","pinyin":"huán xiāng zhòu jǐn","abbr":"hxzj","explanation":"同衣锦昼行，指富贵时穿锦衣回归故乡。","source":{"text":"羽见秦宫室皆已烧残，又怀思东归，曰：‘富贵不归故乡，如衣锦夜行。’","book":"东汉·班固《汉书·项籍传》"},"example":{"text":"英雄岂学生算，也作～看。","book":"清·汪绎《项羽》诗"},"similar":["衣锦还乡","衣锦昼行"],"opposite":["衣锦夜行"],"usage":"作谓语；指衣锦还乡"},{"id":43327,"word":"还元返本","pinyin":"huán yuán fǎn běn","abbr":"hyfb","explanation":"回复到事物的本源状态。","source":{"text":"土能藏木金水火，而土自亦归于土，故墓亦在辰土，是谓还元返本，归根复命之道。","book":"宋·张君房《云笈七签》卷五十六"},"similar":["还原反本"],"usage":"作谓语、宾语；用于人或事物等"},{"id":43328,"word":"还其本来面目","pinyin":"huán qí běn lái miàn mù","abbr":"hqblmm","explanation":"让人或事的起初面目或情况显露出来。","source":{"text":"莫思善，莫思恶，还我明上座本来面目。","book":"宋·释道原《景德传灯录》卷二十五"}},{"id":43329,"word":"还原反本","pinyin":"huán yuán fǎn běn","abbr":"hyfb","explanation":"回复到事物的本来形态。","source":{"text":"毒蝎枉修人道行，还原反本见真形。","book":"明·吴承恩《西游记》第五十五回"},"similar":["反本还原","还元返本"],"usage":"作谓语、宾语；用于人或事物等"},{"id":43330,"word":"还年却老","pinyin":"huán nián què lǎo","abbr":"hnql","explanation":"恢复年轻，长生不老。","source":{"text":"炼形之家，必就深旷，反飞灵，糇丹石，粒芝精，所以还年却老，延年驻彩。","book":"南朝·宋·颜延之《庭诰文》"},"similar":["返老还童"],"usage":"作谓语、定语；用于书面语"},{"id":43331,"word":"还年卻老","pinyin":"huán nián què lǎo","abbr":"hnql","explanation":"恢复年轻，长生不老。"},{"id":43332,"word":"还年驻色","pinyin":"huán nián zhù sè","abbr":"hnzs","explanation":"恢复年轻，永葆青春。","source":{"text":"金盐重于素壁，玉豉贵于明珠，可以养性销痾，还年驻色。","book":"南朝·梁·刘孝标《山栖志》"},"usage":"作谓语、定语；用于书面语"},{"id":43333,"word":"还我河山","pinyin":"huán wǒ hé shān","abbr":"hwhs","explanation":"表示决心从侵略者手中夺回本属于自己的国土。","source":{"text":"徽宗尝梦吴越钱王引徽宗御衣云：‘我好来朝，便终于还我河山。’","book":"宋·赵与时《宾退录》第五卷"},"example":{"text":"……克服投降，战胜困难，驱除日寇，～的目的，是能够到达的，抗战的前途是光明的。","book":"毛泽东《团结到底》"},"similar":["还我山河"],"usage":"作谓语；指决心从侵略者手中夺回自己的国土"},{"id":43334,"word":"还朴反古","pinyin":"huán pǔ fǎn gǔ","abbr":"hpfg","explanation":"回复到人本来的淳厚、朴实的状态或本性。同“还淳反古”。","source":{"text":"夫文质递变，浇淳相革，还朴反古，今也其时。","book":"《陈书·周弘正传》"},"similar":["还淳返朴","还淳反古","还淳反朴"],"usage":"作谓语、宾语；用于书面语"},{"id":43335,"word":"还淳反古","pinyin":"huán chún fǎn gǔ","abbr":"hcfg","explanation":"指回复到原来的淳厚古朴的状态。","source":{"text":"先宜削华止伪，还淳反古，抵璧幽峰，捐珠清壑。","book":"《宋书·孔琳之传论》"},"similar":["还淳反朴"],"usage":"作谓语、宾语；同“返璞归真”"},{"id":43336,"word":"还淳反朴","pinyin":"huán chún fǎn pǔ","abbr":"hcfp","explanation":"回复到人本来的淳厚、朴实的状态或本性。同“还淳返朴”。","source":{"text":"处士阮孝绪闻之，叹曰：‘此言足使还淳反朴，激薄停浇矣。’","book":"《梁书·明山宾传》"},"example":{"text":"～已难期，依德依仁敢暂违。","book":"唐·李咸用《和友人〈喜相遇〉》之七"},"similar":["还淳返朴","还淳反古","还醇返朴"],"usage":"作谓语、宾语；用于书面语","story":["南朝时期，梁代的明山宾忠厚笃实，家里十分贫寒，外出乘坐牛车。为了生存，他把唯一的一头牛卖掉，收钱后对买主说：“这牛经常漏蹄，已经治好，恐怕以后会掉毛，只好如实相告。”买主立即要求退货还钱。处士阮孝绪感叹他的还淳反朴本性"]},{"id":43337,"word":"还淳反素","pinyin":"huán chún fǎn sù","abbr":"hcfs","explanation":"回复到人本来的淳厚、朴实的状态或本性。同“还淳返朴”。","source":{"text":"先王之所以移风易俗，还淳反素，垂拱而治天下以至太平者，莫不由此。","book":"《周书·苏绰传》"},"similar":["还淳反朴"],"usage":"作谓语、宾语；用于书面语"},{"id":43338,"word":"还淳返朴","pinyin":"huán chún fǎn pǔ","abbr":"hcfp","explanation":"回复到人本来的淳厚、朴实的状态或本性。","source":{"text":"洒以甘露，覆之庆云，制礼作乐，还淳返朴。","book":"唐·崔融《则天皇后哀册文》"},"example":{"text":"～，举蔡侯而为之，无不可矣。","book":"明·海瑞《赠养斋蔡太守抚黎序》"},"similar":["还淳返古","还淳反朴"],"usage":"作谓语、宾语；同“返朴归真”"},{"id":43339,"word":"还珠买椟","pinyin":"huán zhū mǎi dú","abbr":"hzmd","explanation":"比喻没有眼力，取舍不当。同“买椟还珠”。","source":{"text":"篇成名自观，笑还珠买椟、胠箧探丸，英雄欺世，久之毕竟难瞒。","book":"清·蒋士铨《临川梦·送尉》"},"similar":["买椟还珠"],"usage":"作宾语、定语；用于书面语"},{"id":43340,"word":"还珠合浦","pinyin":"huán zhū hé pǔ","abbr":"hzhp","explanation":"比喻东西失而复得或人去而复回。","source":{"text":"还珠合浦，波含远近之星。","book":"唐·骆宾王《上兗州刺史启》"},"similar":["珠还合浦"],"usage":"作宾语、定语；引申为政策好"},{"id":43341,"word":"还珠返璧","pinyin":"huán zhū fǎn bì","abbr":"hzfb","explanation":"宝物失而复得。","source":{"text":"若非耿耿包卿一腔忠赤，焉得有还珠返璧之期。","book":"清·石昆玉《三侠五义》第十八回"},"similar":["完璧归赵","物归原主"],"usage":"作宾语、定语；用于书面语"},{"id":43342,"word":"还醇返朴","pinyin":"huán chún fǎn pǔ","abbr":"hcfp","explanation":"回复到人本来的淳厚、朴实的状态或本性。同“还淳反朴”。","source":{"text":"玄宗雅尚儒术，崇实黜华，群臣亦厌虚浮，还醇返朴。","book":"胡朴安《〈中国文学史〉序》"},"similar":["还淳返朴","还朴反古","还淳反朴"],"usage":"作谓语、宾语；用于书面语"},{"id":43343,"word":"还顾之忧","pinyin":"huán gù zhī yōu","abbr":"hgzy","explanation":"还顾：回过头来照看。指身在前方或在前进过程中，还担心后方会出现问题或乱子。","source":{"text":"今使君统留事，孤无复还顾之忧也。","book":"《三国志·魏志·徐奕传》"}},{"id":43344,"word":"这山望着那山高","pinyin":"zhè shān wàng zhe nà shān gāo","abbr":"zswznsg","explanation":"爬上这一卒山，觉得那一座山更高。比喻对自己目前的工作或环境不满意，老认为别的工作、别的环境更好。","source":{"text":"登山者，处已高矣。左右望，尚巍巍焉山在其上。","book":"战国·卫·吕不韦《吕氏春秋·先识览·观世》"},"example":{"text":"今日不知明日事，～。","book":"明·李开先《词谑》引刘天民曲"},"usage":"作宾语、分句；指不知足"},{"id":43345,"word":"进不求名，退不避罪","pinyin":"jìn bù qiú míng，bì bù bì zuì","abbr":"jbqmtbbz","explanation":"名：功名。罪：罪责。指应以国家民族利益为重，从大局出发，不应考虑个人的功名、得失。","source":{"text":"故进不求名，退不避罪，唯人是保，而利合于主，国之宝也。","book":"《孙子·地形篇》"},"example":{"text":"兵法，～，艾虽无古人之节，终不自嫌以损于国也。","book":"《三国志·魏志·邓艾传》"}},{"id":43346,"word":"进人若将加诸膝，退人若将坠诸渊","pinyin":"jìn rén ruò jiāng jiā zhū xī，tuì rén ruò jiāng zhuì zhū yuān","abbr":"jrrjjzxtrrjzzy","explanation":"加诸膝：放在膝盖上；坠诸渊：推进深渊。指不讲原则，感情用事，对别人的爱憎态度，全凭自己的好恶来决定。","source":{"text":"今之君子，进人若将加诸膝，退人若将坠诸渊。","book":"西汉·戴圣《礼记·檀弓下》"},"example":{"text":"南朝·宋·刘义庆《世说新语·方正》：“古之君子，进人以礼，退人以礼；今之君子，～。”"},"similar":["爱则加诸膝，恶则坠诸渊"],"usage":"作宾语、分句；指人凭自己喜好待人","story":["晋朝时期，河内主簿向雄与郡太守刘淮积怨，后来向雄任黄门郎，刘淮任侍中，两人相见如同路人一般，晋武帝下令他们讲和，向雄说他们已经恩断义绝，无法沟通，并说：“古之君子，进人以礼，退人以礼；今之君子，进人若将加诸膝，退人若将坠诸渊。"]},{"id":43347,"word":"进俯退俯","pinyin":"jìn fǔ tuì fǔ","abbr":"jftf","explanation":"前进后退都不齐一。"},{"id":43348,"word":"进利除害","pinyin":"jìn lì chú hài","abbr":"jlch","explanation":"犹言兴利除害。兴办对国家人民有益利的事业，除去各种弊端。","source":{"text":"夫欲追速致远，不知任王良；欲进利除害，不知任贤能，此则不知类之患也。","book":"战国·韩·韩非《韩非子·难势》"},"similar":["兴利除害"],"usage":"作谓语、定语；用于书面语"},{"id":43349,"word":"进可以攻，据可以守","pinyin":"jìn kě yǐ gōng，jù kě yǐ shǒu","abbr":"jkygjkys","explanation":"进：前进；退：退却；据：占据。前进可以攻击，后退可以固守。比喻进攻和防守都有主动权。","source":{"text":"要是利用得好，那是进可以攻，据可以守，游可以击，退可以走。","book":"刘流《烈火金刚》第29回"},"similar":["进可以攻，据可以守"],"usage":"作谓语、定语；用于处事"},{"id":43350,"word":"进可以攻，退可以守","pinyin":"jìn kě yǐ gōng，tuì kě yǐ shǒu","abbr":"jkygtkys","explanation":"进：前进；退：退却；守：防守，固守。前进可以攻击，后退可以固守。比喻进攻和防守都有主动权。","source":{"text":"凡此数事，果能断自乃心，豫有成算，则用足兵强，形势险固，人心坚励，进可以攻，退可以守。","book":"明·归有光《菎山县倭寇始末书》"},"similar":["进退自如","进可以攻，据可以守"],"usage":"作谓语、定语；用于处事"},{"id":43351,"word":"进可替不","pinyin":"jìn kě tì bù","abbr":"jktb","explanation":"指向君主进献良策以废弃弊政。同“进可替否”。","source":{"text":"正色弼违，进可替不，举善弹枉，军国肃雍。","book":"晋·葛洪《抱朴子·外篇自叙》"},"similar":["进可替否"],"usage":"作宾语、定语；用于书面语"},{"id":43352,"word":"进可替否","pinyin":"jìn kě tì fǒu","abbr":"jktf","explanation":"指向君主进献良策以废弃弊政。","source":{"text":"官人秩才，圣帝所难，必须良佐，进可替否。","book":"《三国志·魏志·卢毓传》"},"similar":["进可替不"],"usage":"作宾语、定语；用于书面语"},{"id":43353,"word":"进善惩奸","pinyin":"jìn shàn chéng jiān","abbr":"jscj","explanation":"进用善良，惩治奸恶。","source":{"text":"进善惩奸立帝功，功成揖让益温恭。","book":"唐·周昙《咏史诗·虞舜》"},"similar":["进善惩恶"],"usage":"作谓语、宾语；用于治政等"},{"id":43354,"word":"进善惩恶","pinyin":"jìn shàn chéng è","abbr":"jsce","explanation":"进用善良，惩治奸恶。同“进善惩奸”。","source":{"text":"弼违救失，不以尤悔为虑；进善惩恶，不以亲雠自嫌。","book":"唐·白居易《除武元衡门下侍郎平章事制》"},"similar":["进善惩奸"],"usage":"作谓语、宾语；用于治政等"},{"id":43355,"word":"进善退恶","pinyin":"jìn shàn tuì è","abbr":"jste","explanation":"进用贤善，黜退奸恶。","source":{"text":"刺史古之方伯，上所委任，一州表率也，职进善退恶。","book":"《汉书·何武传》"},"example":{"text":"忠肃恭懿，远谢八元之名；～，近惭二君之美。","book":"唐·苏頲《太阳亏为宰臣乞退表》"},"similar":["进善黜恶"],"usage":"作谓语、宾语；用于治政等"},{"id":43356,"word":"进善黜恶","pinyin":"jìn shàn chù è","abbr":"jsce","explanation":"进用贤善，黜退奸恶。同“进善退恶”。","source":{"text":"扶弱抑强，进善黜恶，教化大行。","book":"《魏书·张蒲传》"},"similar":["进善退恶"],"usage":"作谓语、宾语；用于治政等"},{"id":43357,"word":"进壤广地","pinyin":"jìn rǎng guǎng dì","abbr":"jrgd","explanation":"指扩展地域。","source":{"text":"虽以进壤广地，如食荝之充肠也，欲其安存，何可得也。","book":"汉·桓宽《盐铁论·诛秦》"},"usage":"作谓语、定语；用于书面语"},{"id":43358,"word":"进奉门户","pinyin":"jìn fèng mén hù","abbr":"jfmh","explanation":"凡经过的地方都要付钱。指巧立名目进行敲诈勒索。","source":{"text":"仍索进奉门户及脚价钱。","book":"《新唐书·食货志二》：“又索进奉门户及脚价钱，有赍物入市而空归者。”《资治通鉴·唐纪·德宗贞元十三年》"}},{"id":43359,"word":"进寸退尺","pinyin":"jǐn cùn tuì chǐ","abbr":"jctc","explanation":"进一寸，退一尺。比喻得到的少，失掉的多。","source":{"text":"用兵有言，吾不敢为主而为客，不敢进寸而退尺，是谓行无行。","book":"《老子》第六十九章"},"example":{"text":"薄命不幸，动遭谗谤，～，卒无所成。","book":"唐·韩愈《上兵部李侍郎书》"},"similar":["得不偿失"],"opposite":["得寸进尺"],"usage":"作谓语、定语；比喻得不偿失"},{"id":43360,"word":"进德修业","pinyin":"jìn dè xiū yè","abbr":"jdxy","explanation":"修业：推广、扩大功业。提高道德修养，扩大功业建树。","source":{"text":"君子进德修业。","book":"《周易·乾》"},"example":{"text":"所谓有‘价值’，是必须使人看了在‘～’上得到多少的‘灵感’。","book":"邹韬奋《经历》"},"usage":"作谓语、宾语；用于勉励进步"},{"id":43361,"word":"进德脩业","pinyin":"jìn dé xiū yè","abbr":"jdxy","explanation":"指增进道德与建立功业。"},{"id":43362,"word":"进思尽忠，退思补过","pinyin":"jìn sī jìn zhōng，tuì sī bǔ guò","abbr":"jsjztsbg","explanation":"在朝廷做官，就忠心耿耿报效君主；辞官隐退时，就反省自己，以弥补过失。","source":{"text":"‘荀’林父之事君也，进思尽忠，退思补过，社稷之卫也，若之何杀之？","book":"春秋·鲁·左丘明《左传·宣公十二年》"},"example":{"text":"故必～，庶几无愧于夙夜在公之义。","book":"清·无名氏《杜诗言志》第五卷"},"usage":"作分句；指忠心为国"},{"id":43363,"word":"进旅退旅","pinyin":"jìn lǚ tuì lǚ","abbr":"jltl","explanation":"旅：共，同。与众人一起进退。形容跟着大家走，自己没有什么主张。","source":{"text":"今夫古乐，进旅退旅，和正以广。","book":"西汉·戴圣《礼记·乐记》"},"example":{"text":"～，万舞有奕。","book":"《宋史·乐志七》"},"usage":"作谓语、宾语；指队列进退如一而不杂乱"},{"id":43364,"word":"进本退末","pinyin":"jìn běn tuì mò","abbr":"jbtm","explanation":"本：根本；末：枝节。指重视根本、主要的东西，抑制直接、次要的。","source":{"text":"愿罢盐铁酒榷均输，所以进本退末，广利农业便也。","book":"西汉·桓宽《盐铁论·本议》"},"opposite":["舍本求末"],"usage":"作谓语、定语；指重视根本"},{"id":43365,"word":"进禄加官","pinyin":"jìn lù jiā guān","abbr":"jljg","explanation":"指进升官位增加俸禄。","source":{"text":"万载标名麒麟阁，封妻荫子，进禄加官。","book":"《全元散曲·青玉案》"},"similar":["加官进禄"],"usage":"作谓语、定语；指晋升官职，增加俸禄"},{"id":43366,"word":"进种善群","pinyin":"jìn zhǒng shàn qún","abbr":"jzsq","explanation":"指提高民族素质。","source":{"text":"且变法之后，而人亦有与之俱变者，此进种善群之公例，而其效有操券决也。","book":"清·张鹤龄《法人篇》"},"usage":"作谓语、定语；用于书面语"},{"id":43367,"word":"进荣退辱","pinyin":"jìn róng tuì rǔ","abbr":"jrtr","explanation":"以仕途的进升为光荣、降职为耻辱。","source":{"text":"赋形天地，受气阴阳，生乐死哀，进荣退辱。","book":"唐·刘知畿《思慎赋》"},"usage":"作宾语、定语；指人的仕途观"},{"id":43368,"word":"进谗害贤","pinyin":"jìn chán hài xián","abbr":"jchx","explanation":"谗：谗言，说他人的坏话；贤：贤良，指好人。说坏话，陷害好人。","example":{"text":"请不要在领导面前～。"},"usage":"作谓语、宾语、定语；多用于小人"},{"id":43369,"word":"进贤任能","pinyin":"jìn xián rèn néng","abbr":"jxrn","explanation":"进：推荐，选拔。举荐贤者，任用能人。","source":{"text":"三曰举贤，四曰使能。","book":"《礼记·大传》"},"example":{"text":"治兵训武，～，以公族屈完为贤，使为大夫。","book":"明·冯梦龙《东周列国志》第二十回"},"similar":["举贤使能","进贤达能","进贤进能"],"usage":"作谓语、宾语；指选拔人才"},{"id":43370,"word":"进贤兴功","pinyin":"jìn xián xīng gōng","abbr":"jxxg","explanation":"指荐举贤士功臣。","source":{"text":"以臣有贤有功举之与官，则起邦国之内劝善乐业之心，使不惰废善业也。","book":"《周礼·夏官·大司马》：“进贤兴功，以作邦国。”贾公彥疏"},"usage":"作谓语、定语；用于处世"},{"id":43371,"word":"进贤屏恶","pinyin":"jìn xián píng è","abbr":"jxpe","explanation":"犹言进贤黜佞。进用贤良，黜退奸佞。","source":{"text":"英宗即位，郓忠宪王拜住丞相，进贤屏恶，天下风动。","book":"元·解傒斯《吴澄神道碑》"},"similar":["进贤黜奸","进贤黜佞","进贤黜恶"],"usage":"作谓语、宾语、定语；用于用人等"},{"id":43372,"word":"进贤拔能","pinyin":"jìn xián bá néng","abbr":"jxbn","explanation":"犹言进贤任能。举荐贤者，任用能人。","source":{"text":"进贤拔能，重官人之举；标赏忠靖，旌养人之器。","book":"《魏书·任城王澄传》"},"similar":["进贤达能","进贤任能"],"usage":"作谓语、宾语；指选用人才"},{"id":43373,"word":"进贤用能","pinyin":"jìn xián yòng néng","abbr":"jxyn","explanation":"举荐贤者，任用能人。同“进贤任能”。","source":{"text":"进贤用能，各得其所。","book":"《东观汉记·明帝纪》"},"similar":["进贤拔能"],"usage":"作谓语、宾语；指选用人才"},{"id":43374,"word":"进贤达能","pinyin":"jìn xián dá néng","abbr":"jxdn","explanation":"犹言进贤任能。举荐贤者，任用能人。","source":{"text":"进贤达能谓之大夫，敬上爱下谓之诸侯，天覆地载谓之天子。","book":"汉·刘向《说苑·修文》"},"similar":["进贤拔能","进贤用能"],"usage":"作谓语、宾语；指选用人才"},{"id":43375,"word":"进贤进能","pinyin":"jìn xián jìn néng","abbr":"jxjn","explanation":"犹言进贤任能。举荐贤者，任用能人。","source":{"text":"进贤进能，日慎一日，诚信宽大，闲于理乱，此十万人之将。","book":"三国·蜀·诸葛亮《将苑·将器》"},"similar":["进贤达能","进贤任能"],"usage":"作谓语、宾语、定语；用于用人等"},{"id":43376,"word":"进贤退佞","pinyin":"jìn xián tuì nìng","abbr":"jxtn","explanation":"犹言进贤黜佞。进用贤良，黜退奸佞。","source":{"text":"凡不能进贤退佞，安内攘外，而徒以小康谨安常习故者，皆耻也。","book":"郑观应《论普国中只事略》"},"similar":["进贤退奸"],"usage":"作谓语、宾语、定语；用于任用人才"},{"id":43377,"word":"进贤退奸","pinyin":"jìn xián tuì jiān","abbr":"jxtj","explanation":"犹言进贤黜佞。进用贤良，黜退奸佞。","source":{"text":"方先帝厉精求治之秋，有大臣进贤退奸之助。","book":"宋·苏轼《王安礼知扬州》"},"similar":["进贤退佞"],"usage":"作谓语、宾语、定语；用于任用人才"},{"id":43378,"word":"进贤退愚","pinyin":"jìn xián tuì yú","abbr":"jxty","explanation":"进用贤能，黜退愚懦。","source":{"text":"进贤退愚，蛮夷率服。","book":"宋·苏轼《贺正表》"},"usage":"作谓语、宾语；用于任用人才"},{"id":43379,"word":"进贤黜佞","pinyin":"jìn xián chù nìng","abbr":"jxcn","explanation":"进用贤良，黜退奸佞。","source":{"text":"博采刍尧，进贤黜佞。","book":"《魏书·崔光传》"},"similar":["进贤黜奸","进贤黜恶","进贤屏恶"],"usage":"作谓语、宾语、定语；用于用人等"},{"id":43380,"word":"进贤黜奸","pinyin":"jìn xián chù jiān","abbr":"jxcj","explanation":"犹言进贤黜佞。进用贤良，黜退奸佞。","source":{"text":"优厘大开离照，独运乾刚，进贤黜奸，明令赏罚。","book":"明·郑晓《今言》第四卷"},"similar":["进贤黜恶","进贤黜佞","进贤屏恶"],"usage":"作谓语、宾语、定语；用于用人等"},{"id":43381,"word":"进贤黜恶","pinyin":"jìn xián chù è","abbr":"jxce","explanation":"犹言进贤黜佞。进用贤良，黜退奸佞。","source":{"text":"进贤黜恶，励勤惩惰，恬退有奖，奔竞有罚，责之周而任之重矣。","book":"明·李东阳《送宪副君提学浙江序》"},"similar":["进贤黜奸","进贤黜佞","进贤屏恶"],"usage":"作谓语、宾语、定语；用于用人等"},{"id":43382,"word":"进身之阶","pinyin":"jìn shēn zhī jiē","abbr":"jszj","explanation":"进身：上升；阶：台阶。使身体能够上升的阶梯。旧指借以提拔升迁的门路。","source":{"text":"殊不察自即位以来，所闻之言无大利害，适足以为口舌者进身之阶，虚失待大臣之体，渎上下之分。","book":"元·胡柢遹《紫山大全集·礼论》"},"example":{"text":"此行倘有～，必当举荐吾兄。","book":"明·冯梦龙《东周列国志》第八十七回"},"usage":"作宾语；指借以提拔升迁的门路"},{"id":43383,"word":"进进出出","pinyin":"jìn jìn chū chū","abbr":"jjcc","explanation":"走进走出，穿进穿出。","source":{"text":"以后人员可以动，但是名额不能动，这样有利于进进出出。","book":"邓小平《精简机构是一场革命》"},"example":{"text":"他～的都不理众人。"},"similar":["出出进进"],"usage":"作主语、宾语；指进出"},{"id":43384,"word":"进退两端","pinyin":"jìn tuì liǎng duān","abbr":"jtld","explanation":"进退两难，迟疑不决。","source":{"text":"首鼠之士，进退两端。","book":"唐·张鷟《朝野佥载·张鷟》"},"similar":["进退两难","进退为难"],"usage":"作谓语、定语、宾语；形容处境困难"},{"id":43385,"word":"进退两难","pinyin":"jǐn tuì liǎng nán","abbr":"jtln","explanation":"前进和后退都难。比喻事情无法决定，因而难以行动。","source":{"text":"凡攻城之兵……进退又难，前既不得上城，退则其师逼追。","book":"宋·李靖《卫公兵法》"},"example":{"text":"孔明曰：“既主公在涪关～之际，亮不得不去。”","book":"明·罗贯中《三国演义》第六十三回"},"similar":["进退维谷","进退为难"],"opposite":["进退自如"],"usage":"作谓语、定语、宾语；形容处境困难"},{"id":43386,"word":"进退中度","pinyin":"jìn tuì zhòng dù","abbr":"jtzd","explanation":"指前进后退动作均合法度。同“进退有度”。","source":{"text":"客有见田骈者，被服中法，进退中度，趋翔闲雅，辞令逊敏。","book":"《吕氏春秋·士容》"},"similar":["进退有度","进退中绳"],"usage":"作谓语、宾语；用于处事"},{"id":43387,"word":"进退中绳","pinyin":"jìn tuì zhōng shéng","abbr":"jtzs","explanation":"前进后退均合规矩。","source":{"text":"东野稷以御见庄公，进退中绳，左右旋中规。","book":"《庄子·达生》"},"example":{"text":"战国·卫·吕不韦《吕氏春秋·适威》：“夫～，左右旋中规，造父之御无以过焉。”"},"similar":["进退墨绳"],"usage":"作宾语、定语；用于处事"},{"id":43388,"word":"进退为难","pinyin":"jìn tuì wéi nán","abbr":"jtwn","explanation":"比喻事情无法决定，因而难以行动。同“进退两难”。","source":{"text":"若容舟楫，必须停滞，师老粮乏，进退为难。","book":"《魏书·李冲传》"},"example":{"text":"而他们在西北的匪军主力董钊和刘戡，则远在吴庄和柏树墕一线，～。","book":"柳青《铜墙铁壁》第九章"},"similar":["进退两难","进退两端"],"usage":"作谓语、定语、宾语；形容处境困难"},{"id":43389,"word":"进退亡据","pinyin":"jìn tuì wáng jù","abbr":"jtwj","explanation":"前进和后退都失去了依据。形容无处容身。也指进退两难。同“进退无据”。","source":{"text":"且三雍异所，复乖卢蔡之义；进退亡据，何用经通？","book":"《魏书·袁翻传》"},"similar":["进退无据"],"usage":"作谓语、定语；指陷于困境"},{"id":43390,"word":"进退出处","pinyin":"jìn tuì chū chǔ","abbr":"jtcc","explanation":"指仕途的升迁和降职，出仕和退隐。","source":{"text":"进退出处，何往而不自得哉？","book":"唐·白居易《与元九书》"},"example":{"text":"辞受取予不苟为有廉，～不苟为有耻。","book":"清·魏源《默觚下·治篇十》"},"usage":"作宾语；用于人的仕途"},{"id":43391,"word":"进退双难","pinyin":"jìn tuì shuāng nán","abbr":"jtsn","explanation":"比喻事情无法决定，因而难以行动。同“进退两难”。","source":{"text":"可怪进退双难，羝羊触藩偏困。","book":"明·孙柚《琴心记·家徒四壁》"},"similar":["进退两难","进退为难"],"usage":"作谓语、定语、宾语；形容处境困难"},{"id":43392,"word":"进退可否","pinyin":"jìn tuì kě fǒu","abbr":"jtkf","explanation":"指进升合格者，黜退不合格者。","source":{"text":"陛下圣镜照临，论才授职，进退可否，黜陟幽明。","book":"《魏书·郭祚传》"},"usage":"作谓语、宾语；用于治政等"},{"id":43393,"word":"进退可度","pinyin":"jìn tuì kě dù","abbr":"jtkd","explanation":"指前进后退动作均合法度。同“进退有度”。","source":{"text":"‘君子’容止可观，进退可度。","book":"《孝经·圣治》"},"example":{"text":"察君审行修德，～。","book":"汉·蔡邕《琅琊王傅蔡君碑》"},"similar":["进退有度"],"usage":"作谓语、宾语；用于处事"},{"id":43394,"word":"进退唯谷","pinyin":"jìn tuì wéi gǔ","abbr":"jtwg","explanation":"无论是进还是退，都是处在困境之中。形容进退两难。同“进退维谷”。","source":{"text":"仲堪流涕而起曰：‘臣进退唯谷。’","book":"南朝·宋·刘义庆《世说新语·纰漏》"},"similar":["进退维谷","进退惟谷"],"usage":"作谓语、宾语、定语；形容进退两难"},{"id":43395,"word":"进退失图","pinyin":"jìn tuì shī tú","abbr":"jtst","explanation":"前进或后退都有错误。谓指挥失策。","source":{"text":"叔业进退失图，于是奔走。","book":"《魏书·傅永传》"},"usage":"作谓语、定语；用于处事"},{"id":43396,"word":"进退失所","pinyin":"jìn tuì shī suǒ","abbr":"jtss","explanation":"前进后退均无容身之处。比喻处境困难。同“进退无所”。","source":{"text":"然则漠视君民，孤身遁世，进退失所，首鼠两旁，其与存者几何？","book":"清·唐才常《辨惑》"},"similar":["进退无所"],"usage":"作谓语、定语；指走投无路"},{"id":43397,"word":"进退失据","pinyin":"jìn tuì shī jù","abbr":"jtsj","explanation":"前进和后退都失去了依据。形容无处容身。也指进退两难。","source":{"text":"而子始以不訾之身，怒万乘之主；及其享受爵禄，又不闻匡救之术，进退无所据矣。","book":"《后汉书·樊英传》"},"example":{"text":"～，两无所容，此可谓调和者之戒矣。","book":"章炳麟《诸子学略说》"},"similar":["无所适从","骑虎难下","进退两难"],"opposite":["进退中绳","进退有常"],"usage":"作谓语、宾语、定语；指进退两难"},{"id":43398,"word":"进退失措","pinyin":"jìn tuì shī cuò","abbr":"jtsc","explanation":"指进退两难而无法应付。同“进退无措”。","source":{"text":"昔之照壁后，訾相人物，指摘仪度，见其或被上官诋诃，进退失措者，莫不群笑，声闻于外。","book":"宋·周煇《清波杂志》卷五"},"example":{"text":"陆方心动欲还，奈歧路之中又有歧焉者，不知所向，正～间，遥望前林，有灯火明灭。","book":"清·青城子《志异续编·陆炳吉》"},"similar":["进退无措"],"usage":"作谓语、定语、状语；用于处事"},{"id":43399,"word":"进退失踞","pinyin":"jìn tuì shī jù","abbr":"jtsj","explanation":"前进和后退都失去了依据。形容无处容身。也指进退两难。同“进退无据”。","source":{"text":"万一赵季和与之勾结，使其乘我之瑕，蹈我之隙，则我四面皆敌，进退失踞。","book":"李劼人《大波》第三部第七章"},"similar":["进退无据","进退失据"],"usage":"作谓语、定语；指陷于困境"},{"id":43400,"word":"进退存亡","pinyin":"jìn tuì cún wáng","abbr":"jtcw","explanation":"前进、后退、生存、死亡。泛指各种好的与坏的处境。","source":{"text":"知进退存亡，而不失其正者，其唯圣人乎。","book":"《周易·乾卦》"},"example":{"text":"君子所贵乎知～，而不失其正也。","book":"清·失彝尊《杭州洞霄宫提举题名记》"},"usage":"作主语、宾语；指各种处境"},{"id":43401,"word":"进退履绳","pinyin":"jìn tuì lǚ shéng","abbr":"jtls","explanation":"前进后退均合规矩。同“进退中绳”。","source":{"text":"内得于中心，而外合于马志，是故能进退履绳而旋曲中规矩。","book":"《列子·汤问》"},"similar":["进退中绳"],"usage":"作宾语、定语；用于处事"},{"id":43402,"word":"进退应矩","pinyin":"jìn tuì yīng jǔ","abbr":"jtyj","explanation":"前进后退均合规矩。","source":{"text":"旄旍指麾，进退应矩。","book":"《宋书·乐志》"},"similar":["进退有度","进退可度","进退中度"],"usage":"作谓语、宾语；用于处事"},{"id":43403,"word":"进退惟咎","pinyin":"jìn tuì wéi jiù","abbr":"jtwj","explanation":"指进退两难而动辄得咎。","source":{"text":"披沥丹款，未纡黄道，进退惟咎，投措靡由。","book":"唐·道宣《统论前议优劣并赞》"},"usage":"作谓语、定语；用于人的处境"},{"id":43404,"word":"进退惟谷","pinyin":"jìn tuì wéi gǔ","abbr":"jtwg","explanation":"无论是进还是退，都是处在困境之中。形容进退两难。同“进退维谷”。","source":{"text":"仲堪流涕而起曰：‘臣进退惟谷。’","book":"《晋书·殷仲堪传》"},"example":{"text":"适值险阻，～。","book":"元·辛文房《唐才子传·聂夷中》"},"similar":["进退唯谷","进退维谷"],"usage":"作谓语、宾语、定语；形容进退两难"},{"id":43405,"word":"进退损益","pinyin":"jìn tuì sǔn yì","abbr":"jtsy","explanation":"指增减变动。","source":{"text":"来不濡足，去不绝……进退损益。","book":"南朝·宋慧琳《武丘法纲法师诔》"},"similar":["进退消息"],"usage":"作谓语、宾语；指上下变化"},{"id":43406,"word":"进退无依","pinyin":"jìn tuì wú yī","abbr":"jtwy","explanation":"指前进、后退均无所凭依。","source":{"text":"师旅困穷，城池陷露，君臣失色，进退无依。","book":"晋·道安《平心露布文》"},"similar":["进退无据"],"usage":"作谓语、定语；指人的处境"},{"id":43407,"word":"进退无所","pinyin":"jìn tuì wú suǒ","abbr":"jtws","explanation":"前进后退均无容身之处。比喻处境困难。","source":{"text":"妇怀孕十月已足，适至万山之门首而产，时将夜半矣，进退无所，不得已就于门下，以手扳门环生一女子。","book":"明·孔迩《云蕉馆纪谈》"},"example":{"text":"生负气出门，～，踯躅于利涉桥上，将为抱石之谋。","book":"清·珠泉居士《续板桥杂记·轶事》"},"similar":["进退无门","进退无路","进退失所"],"usage":"作谓语、定语；指走投无路"},{"id":43408,"word":"进退无据","pinyin":"jìn tuì wú jù","abbr":"jtwj","explanation":"前进和后退都失去了依据。形容无处容身。也指进退两难。","source":{"text":"而子始以不訾之身，怒万乘之主；及其享受爵禄，又不闻匡救之术，进退无所据矣。","book":"《后汉书·樊英传》"},"example":{"text":"邪正失所，～，诚国体所宜深惜。","book":"《晋书·周处传》"},"similar":["进退失踞","进退失据"],"usage":"作谓语、定语；指陷于困境"},{"id":43409,"word":"进退无措","pinyin":"jìn tuì wú cuò","abbr":"jtwc","explanation":"指进退两难而无法应付。","source":{"text":"会西南风急，贼舟数千，果扬帆顺流鼓噪而至，舟遇桩不得动，进退无措，黼帅将士奋击，发火翎箭射之，焚溺死者无算，余舟散走。","book":"明·宋濂《元史·忠义列传二》"},"example":{"text":"你想那征战之事，可是期得日子定的么？遐叔得了这个消息，惊得～。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"similar":["进退失措"],"usage":"作谓语、定语、状语；用于处事"},{"id":43410,"word":"进退无路","pinyin":"jìn tuì wú lù","abbr":"jtwl","explanation":"前进无路，后退也无路。形容处境十分困难，进退两难，无处容身。","source":{"text":"吾道不幸遽失，此人馀子纷纷，才有毛发利害，便章皇失措，进退无门，亦何足为轩轾耶。","book":"宋·朱熹《答刘季章》"},"example":{"text":"小生囊箧罄然，家园迢递，～，特问公公指引，再去寻他。","book":"明·郑若庸《玉玦记·投贤》"},"similar":["进退无门"],"usage":"作谓语、定语；指陷于窘困境地"},{"id":43411,"word":"进退无途","pinyin":"jìn tuì wú tú","abbr":"jtwt","explanation":"形容处境十分困难，进退两难，无处容身。同“进退无路”。","source":{"text":"腹背受敌，进退无途，虽有韩白，恐无全理。","book":"《魏书·郦范传》"},"similar":["进退无路"],"usage":"作谓语、定语；指人的处境"},{"id":43412,"word":"进退无门","pinyin":"jìn tuì wú mén","abbr":"jtwm","explanation":"前进无路，后退无门。形容处境十分困难，进退两难，无处容身。","source":{"text":"吾道不幸遽失，此人馀子纷纷，才有毛发利害，便章皇失措，进退无门，亦何足为轩轾耶。","book":"宋·朱熹《答刘季章》"},"example":{"text":"奴家此时，～，竟不知所往，望姐姐有以教之。","book":"清·夏敬渠《野叟曝言》第三十四回"},"similar":["进退无路","走投无路","进退无所"],"opposite":["前程似锦"],"usage":"作谓语、定语；指走投无路"},{"id":43413,"word":"进退有常","pinyin":"jìn tuì yǒu cháng","abbr":"jtyc","explanation":"常：规律。前进和后退都有规律。","source":{"text":"日信出信人，南北有极，度之稽也，月信死信生，进退有常，数之稽也。","book":"《鹖冠子·泰鸿》"},"example":{"text":"而能始终有道，～；援礼引年，遗荣致政。","book":"唐·白居易《答高郢》"},"usage":"作谓语、宾语；前进和后退都有规律"},{"id":43414,"word":"进退有度","pinyin":"jìn tuì yǒu dù","abbr":"jtyd","explanation":"指前进后退动作均合法度。","source":{"text":"进退有度，左右有局。","book":"西汉·戴圣《礼记·曲礼》"},"example":{"text":"然对越谨严，～，天颜咫尺，举动从容。","book":"清·福格《听雨丛谈·赞礼郎》"},"similar":["进退可度","进退应矩"],"usage":"作谓语、宾语；用于处事"},{"id":43415,"word":"进退有节","pinyin":"jìn tuì yǒu jié","abbr":"jtyj","explanation":"指前进后退动作均合法度。","source":{"text":"观乎作军政，临武事，进退有节，沿回趋利。","book":"唐·王起《昆明池习水战赋》"},"usage":"作宾语、定语；指人懂法度"},{"id":43416,"word":"进退消息","pinyin":"jìn tuì xiāo xī","abbr":"jtxx","explanation":"指增减；变化。","source":{"text":"因以溯洄于民力物力之盛衰，人材风俗进退消息之本末。","book":"清·魏源《圣武记》叙"},"similar":["进退消长","进退损益"],"usage":"作宾语、定语；用于变化"},{"id":43417,"word":"进退消长","pinyin":"jìn tuì xiāo cháng","abbr":"jtxc","explanation":"指增减；变化。同“进退消息”。","source":{"text":"君在乾隆末，与大学士和珅同朝，郁郁不合，故与《诗》《易》君子小人进退消长之际，往往发愤慷慨，流连太息，读其书可以悲其志云。","book":"清·魏源《〈武进庄少宗伯遗书〉序》"},"similar":["进退消息","进退损益"],"usage":"作宾语、定语；用于变化"},{"id":43418,"word":"进退狐疑","pinyin":"jìn tuì hú yí","abbr":"jthy","explanation":"进退两难，迟疑不决。","source":{"text":"信任过说，一彼一此，进退狐疑，部伍狼籍。","book":"唐·李靖《李卫公兵法·将务兵谋》"},"usage":"作谓语、定语；指处事犹豫"},{"id":43419,"word":"进退狼狈","pinyin":"jìn tuì láng bèi","abbr":"jtlb","explanation":"进退两难；陷于困境。","source":{"text":"阜叙起于卤城，超出攻之不能下；宽衢闭冀城门，超不得入。进退狼狈，乃奔汉中依张鲁。","book":"《三国志·蜀志·马超传》"},"example":{"text":"晃穆未平，康宁复至，～，势必大危。","book":"《晋书·吕光载记》"},"similar":["进退狼跋"],"opposite":["一帆风顺"],"usage":"作谓语、定语；用于人的处境"},{"id":43420,"word":"进退狼跋","pinyin":"jìn tuì láng bá","abbr":"jtlb","explanation":"跋：踩，踏。比喻陷于困境，进退两难。","source":{"text":"当斯之时，进退狼跋。","book":"晋·陈寿《三国志·蜀志·法正传》"},"similar":["进退狼狈"],"usage":"作谓语、定语；用于人的处境"},{"id":43421,"word":"进退维亟","pinyin":"jìn tuì wéi jí","abbr":"jtwj","explanation":"进退都处于危急境地。","source":{"text":"岂不是思，进退维亟。","book":"明·何景明《中林之棘》诗"},"similar":["进退维谷","进退两难","进退维艰"],"usage":"作谓语、宾语、定语；形容进退两难"},{"id":43422,"word":"进退维艰","pinyin":"jìn tuì wéi jiān","abbr":"jtwj","explanation":"进退都处于危急境地。同“进退维亟”。","source":{"text":"欲留则违其归顺之心，欲去则恐膺不测之戮，低回无计，进退维艰。","book":"清·江忠源《条陈军务疏》"},"similar":["进退维亟"],"usage":"作谓语、宾语、定语；形容进退两难"},{"id":43423,"word":"进退维谷","pinyin":"jìn tuì wéi gǔ","abbr":"jtwg","explanation":"维：相当于“是”；谷：比喻困境。无论是进还是退，都是处在困境之中。形容进退两难。","source":{"text":"人亦有言，进退维谷。","book":"《诗经·大雅·桑柔》"},"example":{"text":"在我自己的思想上也正感受着一种～的苦闷。","book":"郭沫若《革命春秋·创造十年》"},"similar":["进退两难"],"opposite":["进退自如"],"usage":"作谓语、宾语、定语；形容进退两难"},{"id":43424,"word":"进退荣辱","pinyin":"jìn tuì róng rǔ","abbr":"jtrr","explanation":"指仕途的迁升或降职，荣耀或耻辱。","source":{"text":"虽鵩鸟集于前，枯柳生于肘，不能动其心也；而况进退荣辱之累耶？","book":"唐·白居易《答户部崔侍郎书》"},"usage":"作宾语、定语；用于官场等"},{"id":43425,"word":"进退裕如","pinyin":"jìn tuì yù rú","abbr":"jtyr","explanation":"指前进和后退均从容不费力。","source":{"text":"如乘骏马，进退裕如，不须鞭勒，无不当人意。","book":"宋·陈鹄《耆旧续闻》第三卷"},"example":{"text":"而荫昌职在巡视，～，仍可旧治部事。","book":"《辛亥革命·清吏条陈》"},"opposite":["进退无途"],"usage":"作谓语、宾语；指进退自如"},{"id":43426,"word":"进退触篱","pinyin":"jìn tuì chù lí","abbr":"jtcl","explanation":"前进后退都有障碍，指进退两难。同“进退触籓”。","source":{"text":"进退触篱，实维难处。","book":"明·方汝浩《禅真后史》第44回"},"similar":["进退两难","进退触藩","进退跋疐"],"usage":"作谓语、定语、宾语；形容处境困难"},{"id":43427,"word":"进退触籓","pinyin":"jìn tuì chù zǔ","abbr":"jtcf","explanation":"前进后退都有障碍，指进退两难。","source":{"text":"语出《易·大壮》：“羝羊触籓，不能退，不能遂。”孔颖达疏：“退谓退避，遂谓进往。”羝，公羊。籓，篱笆。"},"example":{"text":"～，计当安施，幸蚤图之，毋悔噬脐。","book":"清·魏源《筹漕篇上》"}},{"id":43428,"word":"进退触籵","pinyin":"jìn tuì chù zǔ","abbr":"jtcz","explanation":"前进后退都有障碍，指进退两难。","source":{"text":"羝羊触籵，不能退，不能遂。孔颖达疏退谓退避，遂谓进往。羝，公羊。籵，篱笆。","book":"语出《易·大壮》"},"quote":{"text":"～，计当安施，幸蚤图之，毋悔噬脐。","book":"清·魏源《筹漕篇上》"}},{"id":43429,"word":"进退触藩","pinyin":"jìn tuì chù fān","abbr":"jtcf","explanation":"触：碰撞；藩：屏障，篱笆。前进后退都碰到障碍。形容进退两难。","source":{"text":"羝羊触藩，不能退，不能遂。","book":"《周易·大壮》"},"example":{"text":"～，计当安施，幸蚤图之，毋悔噬脐。","book":"清·魏源《筹漕篇》"},"similar":["进退两难","进退触篱","进退跋疐"],"usage":"作谓语、定语、宾语；形容处境困难"},{"id":43430,"word":"进退跋疐","pinyin":"jìn tuì bá zǔ","abbr":"jtbz","explanation":"犹言进退两难。比喻事情无法决定，因而难以行动。","source":{"text":"狼跋其胡，载疐其尾。","book":"《诗经·豳风·狼跋》"},"example":{"text":"～，能事无所写，非施之训诂，且安施邪？","book":"章炳麟《訄书·学隐》"},"similar":["进退两难","跋前疐后","进退触籓"],"usage":"作谓语、定语、宾语；形容处境困难"},{"id":43431,"word":"进退跋痜","pinyin":"jìn tuì bá zǔ","abbr":"jtbz","explanation":"犹言进退两难。比喻事情无法决定，因而难以行动。"},{"id":43432,"word":"进退路穷","pinyin":"jìn tuì lù qióng","abbr":"jtlq","explanation":"犹言进退无路。形容处境十分困难，进退两难，无处容身。","source":{"text":"丕进退路穷，乃谋于群僚。","book":"《晋书·苻坚载记》"},"example":{"text":"裕西入函谷，则～，腹背受敌。","book":"《魏书·崔浩传》"},"similar":["进退两难","进退为难"],"usage":"作谓语、定语；用于人的处境"},{"id":43433,"word":"进退迍邅","pinyin":"jìn tuì chù zǔ","abbr":"jtzz","explanation":"犹言进退两难。比喻事情无法决定，因而难以行动。","source":{"text":"甘受些饥寒苦楚，怎当的进退迍邅。","book":"元·无名氏《合同文字》第一折"},"similar":["进退两难","进退维谷"],"usage":"作宾语、定语；用于人的处境"},{"id":43434,"word":"进退首鼠","pinyin":"jìn tuì shǒu shǔ","abbr":"jtss","explanation":"进退不定；犹豫不决。首鼠，踌躇。","source":{"text":"又思此别相见定何时，进退首鼠，卒以其所欲求正于仲实者而寓之书。","book":"宋·陈亮《与应仲实书》"},"similar":["进退两端"],"usage":"作谓语、定语；用于处事"},{"id":43435,"word":"进道若蜷","pinyin":"jìn dào ruò quán","abbr":"jdrq","explanation":"指前进之道反若后退。同“进道若退”。"},{"id":43436,"word":"进道若踡","pinyin":"jìn dào ruò quán","abbr":"jdrq","explanation":"指前进之道反若后退。同“进道若退”。"},{"id":43437,"word":"进道若退","pinyin":"jìn dào ruò tuì","abbr":"jdrt","explanation":"指前进之道反若后退。","source":{"text":"明道若昧，进道若退。","book":"《老子》"},"example":{"text":"虽老氏曲全，～，然行亦以需。","book":"《后汉书·张衡传》"},"usage":"作宾语、定语；用于比喻句"},{"id":43438,"word":"进锐退速","pinyin":"jǐn ruì tuì sù","abbr":"jrts","explanation":"锐：迅速。急于求进者往往后退也快。","source":{"text":"于不可已而已者，无所不已。于所厚者薄，无所不薄也。其进锐者，其退速。","book":"《孟子·尽心上》"},"example":{"text":"～，助长也；所恶于智者，为其凿助长也。","book":"清·陈澧《东塾读书记·孟子》"},"usage":"作谓语、定语；指急于求进者往往后退也快"},{"id":43439,"word":"远不间亲","pinyin":"yuǎn bù jiàn qīn","abbr":"ybjq","explanation":"间：离间。关系疏远者不参与关系亲近者的事。","source":{"text":"夫然，则不下倍（背叛）上，臣不杀君，贱不逾贵，少不凌长，远不间亲，新不间旧，小不加大，淫不破义。凡此八者，礼之经也。","book":"《管子·五辅》"},"similar":["疏不间亲"],"usage":"作宾语、定语；指人际关系"},{"id":43440,"word":"远举高飞","pinyin":"yuǎn jǔ gāo fēi","abbr":"yjgf","explanation":"举：飞、去。飞得又高又远。比喻前程远大。","source":{"text":"鸿鹄高飞远翔，其所恃者六翮也。","book":"汉·刘向《说苑·八·尊贤·十三节》"},"example":{"text":"矫首看鸿鹄，～。点检人间今古，问论语为赢局，底是输棋？","book":"宋·吴潜《八声甘州·和魏鹤山韵》"},"similar":["高飞远举","前程万里"],"usage":"作谓语；指前程广大"},{"id":43441,"word":"远井不解近渴","pinyin":"yuǎn jǐng bù jiě jìn kě","abbr":"yjbjjk","explanation":"指遥远的帮助解决不了目前迫切的需求。","example":{"text":"这是～的事情。"},"similar":["远水不解近渴"],"usage":"作宾语、定语、分句；指不能应急"},{"id":43442,"word":"远交近攻","pinyin":"yuǎn jiāo jìn gōng","abbr":"yjjg","explanation":"联络距离远的国家，进攻邻近的国家。这时战国时秦国采取的一种外资策略。后也指待人处世的一种手段。","source":{"text":"王不如远交而近攻，得寸则王之寸，得尺亦王之尺也。","book":"《战国策·秦策三》"},"example":{"text":"莫若以纳辽之币归之于金，坐复燕云故土，正合～之计。","book":"清·陈忱《水浒后传》第七回"},"usage":"作主语、定语、宾语；用于战争等","story":["战国时期，秦昭襄王向宰相张禄讨教治国方略，张禄说秦国有天然屏障与兵车，势力足够号令诸侯，最近攻打遥远的齐国，这是一个大错，应该采取远交近攻的政策，先前已有魏国打击中山结果让赵国吞并中山，秦王采用他的计谋"]},{"id":43443,"word":"远亲不如近邻","pinyin":"yuǎn qīn bù rú jìn lín","abbr":"yqbrjl","explanation":"指遇有急难，远道的亲戚就不如近旁的邻居那样能及时帮助。","source":{"text":"岂不闻远亲呵不似我近邻，我怎敢做的个有口偏无信。","book":"元·秦简夫《东堂老》第四折"},"example":{"text":"常言道：～，休要失了人情。","book":"明·施耐庵《水浒全传》第二十四回"},"similar":["远水不救近火"],"usage":"作宾语；用于告诫人处理邻里关系"},{"id":43444,"word":"远亲近友","pinyin":"yuǎn qīn jìn yǒu","abbr":"yqjy","explanation":"泛指远近的亲戚朋友。","source":{"text":"你便待佯推佯逊，我怎肯不瞅不问，常言道远亲近邻，不如你这对门。","book":"元·无名氏《冻苏秦》第四折"},"example":{"text":"于是接二连三，都听见贾府打醮，女眷都在庙里，凡一应～，世家相与都来送礼。","book":"清·曹雪芹《红楼梦》第二十九回"},"similar":["亲朋戚友"],"usage":"作主语、宾语、定语；用于书面语"},{"id":43445,"word":"远亲近邻","pinyin":"yuǎn qīn jìn lín","abbr":"yqjl","explanation":"泛指远近的亲戚朋友。","source":{"text":"你便待佯推佯逊，我怎肯不瞅不问，常言道远亲近邻，不如你这对门。","book":"元·无名氏《冻苏秦》第四折"}},{"id":43446,"word":"远人无目","pinyin":"yuǎn rén wú mù","abbr":"yrwm","explanation":"在远处看不清人的眼睛。形容距离太远，只能看到模糊的轮廓。","source":{"text":"凡画山水，意在笔先。丈山尺树，寸马分人。远人无目，远树无枝。远山无石，隐隐如眉；远水无波，高与云齐。","book":"唐·王维《山水论》"}},{"id":43447,"word":"远图长虑","pinyin":"yuǎn tú cháng lǜ","abbr":"ytzl","explanation":"长远周到的考虑和设想。","source":{"text":"心耽其荣，体安其玄，远图长虑，用遗旧居。","book":"汉·蔡邕《汉交阯都尉胡府君夫人黄氏神诰》"},"similar":["深谋远虑"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":43448,"word":"远在千里，近在目前","pinyin":"yuǎn zài qiān lǐ，jìn zài mù qián","abbr":"yzqljzmq","explanation":"认为远的话就远在千里，认为近的话就近在眼前。指对事物的看法，依人的主观认识而转移。也指要寻找的事物就在眼前","source":{"text":"素臣喜道：‘厅上所贴的对联，有刘夏文臣四字，不知所谓，毕竟指著何人。’玉麟笑道：‘远在千里，近在目前。’","book":"清·夏敬渠《野叟曝言》第70回"},"similar":["远在天边，近在眼前"],"usage":"作谓语、定语、分句；用于口语"},{"id":43449,"word":"远在天边，近在眼前","pinyin":"yuǎn zài tiān biān，jìn zài yǎn qián","abbr":"yztbjzyq","explanation":"形容寻找的人或物就在面前。","source":{"text":"原来远在天边，近在眼前！无论如何，你总要代我拉了来的。","book":"清·吴趼人《二十年目睹之怪现状》第七十九回"},"example":{"text":"道姑道：‘～，女菩萨自去问心，休来问我。’","book":"清·李汝珍《镜花缘》第四十六回"},"similar":["远在千里，近在目前"],"usage":"作谓语、定语、分句；用于口语"},{"id":43450,"word":"远垂不朽","pinyin":"yuǎn chuí bù xiǔ","abbr":"ycbx","explanation":"永垂不朽。","source":{"text":"所谓水中盐味，可取不可得，是为千古绝唱，当与古文远垂不朽者也。","book":"明·李贽《与汪鼎甫书》"},"similar":["永垂不朽"],"usage":"作谓语、定语；指名声、事迹等"},{"id":43451,"word":"远处夸称，近方卖弄","pinyin":"yuǎn chù kuā chēng，jìn fāng mài nòng","abbr":"yckcjfmn","explanation":"夸称：夸奖；卖弄：显示。向远近各处夸奖显示，吹嘘宣扬。","source":{"text":"小人远方来的人，投贵地特来就事。虽无惊人的本事，全靠恩官作成。远处夸称，近方卖弄。如要筋重膏，当下取赎。","book":"明·施耐庵《水浒全传》第三十六回"},"usage":"作谓语、定语；用于书面语"},{"id":43452,"word":"远害全身","pinyin":"yuǎn hài quán shēn","abbr":"yhqs","explanation":"促使自身，远离祸害。同“全身远害”。","source":{"text":"我为甚走入深山改姓名，我则是远害全身。","book":"《梁书·袁昂传》：“岂若翻然改图，自招多福，进则远害全身，退则长守禄位。”宋·王禹偁《四皓庙碑》：“远害全身，矫世励俗。”明·无名氏《破风诗》第一折"},"example":{"text":"但我对于有关面子的人物，仍然都不用真姓名，将罗马字来替代。既非欧化，也不是‘隐恶扬善’，只不过‘～’。","book":"鲁迅《而已集·谈所谓·〈大内档案〉》"},"similar":["全身远害"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43453,"word":"远山芙蓉","pinyin":"yuǎn shān fú róng","abbr":"ysfr","explanation":"远山：形容女子的眉毛像远山一样青翠。芙蓉：比喻女子的脸色像芙蓉花一样美丽。比喻女子貌美。","source":{"text":"异史氏曰：‘得远山芙蓉，与共四壁，与以南面王岂易哉？’","book":"清·蒲松龄《聊斋志异·云翠仙》"},"usage":"作宾语、定语；用于比喻句"},{"id":43454,"word":"远年近岁","pinyin":"yuǎn nián jìn suì","abbr":"ynjs","explanation":"过去至现在；长期以来。","source":{"text":"张郎，将俺那远年近岁欠少我钱钞的文书，都与我搬运将出来，算一算是多少。","book":"元·武汉臣《老生儿》楔子"},"example":{"text":"员外叫张郎取过那～欠他钱钞的文书，都搬将出来，叫小梅点个灯，一把火烧了。","book":"明·凌濛初《初刻拍案惊奇》卷三十八"},"similar":["远年近日"],"usage":"作宾语、定语；用于书面语"},{"id":43455,"word":"远年近日","pinyin":"yuǎn nián jìn rì","abbr":"ynjr","explanation":"过去至现在；长期以来。同“远年近岁”。","source":{"text":"恰才柳隆卿胡子传把那远年近日欠下我的银子，都对付在你身上，你还我银子来。","book":"元·刘君锡《来生债》楔子：“到家中我将这远年近日欠少我钱钞的文契，我都烧了。” 元·秦简夫《东堂老》第三折"},"similar":["远年近岁"],"usage":"作宾语、定语；用于书面语"},{"id":43456,"word":"远引曲喻","pinyin":"yuǎn yǐn qū yù","abbr":"yyqy","explanation":"说话从远处引证，作曲折比方。","source":{"text":"诸臣有艰苦之情，亦据实奏闻。苟不务直言主，远引曲喻，剿袭纷然，何益于事？","book":"《清史稿·太宗纪一》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":43457,"word":"远引深潜","pinyin":"yuǎn yǐn shēn qián","abbr":"yysq","explanation":"如鸟儿一样远远飞走，如鱼儿一样潜入深水。比喻逃避困难。","source":{"text":"某昨得罪后，都下沸腾未已，其谤皆出人情外，而往往信而转之，自念非远引深潜，则不能快仇者之意。","book":"宋·苏舜钦《答范资政书》"},"usage":"作谓语、定语；用于书面语"},{"id":43458,"word":"远怀近集","pinyin":"yuǎn huái jìn jí","abbr":"yhjj","explanation":"指远近的人都来归附。","source":{"text":"德盛业广则宅心者众，舍瑕录用则远怀近集。","book":"晋·葛洪《抱朴子·博喻》"},"usage":"作谓语、定语；用于书面语"},{"id":43459,"word":"远愁近虑","pinyin":"yuǎn chóu jìn lǜ","abbr":"ycjl","explanation":"既发愁未来的命运，又忧虑眼前的处境。形容过多的忧虑。","source":{"text":"他这远愁近虑，不抗不卑，他们奶奶就不是和咱们好，听他这一番话，也必要自愧的变好了。","book":"清·曹雪芹《红楼梦》第五十六回"},"usage":"作宾语；形容过多的忧虑"},{"id":43460,"word":"远来和尚好看经","pinyin":"yuǎn lái hé shàng hǎo kàn jīng","abbr":"ylhshkj","explanation":"比喻外地来的人比本地人更受重视。","source":{"text":"近寺人家不重僧，远来和尚好看经。","book":"元·张国宾《合汗衫》第三折"},"example":{"text":"好！好！好！常言道：‘～。’妹妹们！不可怠慢，快办斋来。","book":"明·吴承恩《西游记》第七十二回"},"similar":["远来和尚会念经"],"usage":"作宾语、分句；指外地人"},{"id":43461,"word":"远来的和尚会念经","pinyin":"yuǎn lái dé hé shàng huì niàn jīng","abbr":"yldhshnj","explanation":"比喻外地来的人比本地人更受重视","example":{"text":"～，你们就犯了大错"},"similar":["远来和尚好看经"],"usage":"作宾语、定语、分句；用于口语"},{"id":43462,"word":"远水不救近火","pinyin":"yuǎn shuǐ bù jiù jìn huǒ","abbr":"ysbjjh","explanation":"远处的水救不了近处的火。比喻慢的办法救不了急。","source":{"text":"失火而取水于海，海水虽多，火必不灭矣，远水不救近火也。","book":"《韩非子·说林上》"},"example":{"text":"为今之计，到临安取救是～。","book":"清·吴趼人《痛史》第三回"},"similar":["远水不解近渴"],"opposite":["雪中送炭"],"usage":"作宾语、定语；指不能应急","story":["春秋时期，小国鲁国与强大的齐国相邻，鲁穆公担心自己的安全，想把儿子送到晋国与楚国去做官，借以拉拢两国。大臣犁沮坚决反对，他认为这是远水不救近火。晋国与楚国离鲁国很远，一旦受到齐国的攻击，他们不可能及时救援"]},{"id":43463,"word":"远水不解近渴","pinyin":"yuǎn shuǐ bù jiě jìn kě","abbr":"ysbjjk","explanation":"远处的水不能立刻解决口渴的问题。比喻慢的办法救不了急。","source":{"text":"失火而取水于海，海水虽多，火必不灭矣，远水不救近火也。","book":"《韩非子·说林上》"},"example":{"text":"春宇是生意人性情，也觉着～，也就没叫上学。","book":"清·李绿园《歧路灯》第八回"},"similar":["远井不解近渴"],"opposite":["雪中送炭"],"usage":"作宾语、定语、分句；指缓不济急","story":["战国时期，庄子出游的路上见到车辙里的一条活蹦乱跳的鲫鱼求救，鲫鱼要庄子找一升水来救它的命，庄子说到吴国和越国去，路过锦江时给它带很多水来救，鲫鱼急了，那只是远水不解近渴，等到锦江的水来它已变成鱼干了"]},{"id":43464,"word":"远水救不了近火","pinyin":"yuǎn shuǐ jiù bù liǎo jìn huǒ","abbr":"ysjbljh","explanation":"远距离的水熄灭不了就在附近的火。比喻缓慢的纠正或抵制邪恶的东西不可能应付紧急的状态。","source":{"text":"只是远水救不得近火。小兄其实等不得那从容的事了。","book":"明·凌濛初《二刻拍案惊奇》"},"similar":["远水不救近火"],"usage":"作宾语、定语；指不能应急"},{"id":43465,"word":"远水救不得近渴","pinyin":"yuǎn shuǐ jiù bù dé jìn kě","abbr":"ysjbdjk","explanation":"远处的水解不了眼前的渴。比喻不在眼前的事物不能救急","source":{"text":"不应远水救近渴，空仓四壁雀不鸣。","book":"宋·陈师道《乌呼行》"},"example":{"text":"明·张四维《双烈记·代役》：“你说千金报我，～。”"},"similar":["远水不解近渴"],"usage":"作宾语、定语、分句；用于比喻句"},{"id":43466,"word":"远水救不得近火","pinyin":"yuǎn shuǐ jiù bù dé jìn huǒ","abbr":"ysjbdjh","explanation":"比喻缓慢的救助不能解决眼前的急难。","source":{"text":"只是远水救不得近火，小兄其实等不得那从容的事了。","book":"明·凌濛初《二刻拍案惊奇》卷三"},"example":{"text":"如今～，就是我们再帮点忙，至多再凑了几百银子，也无济于事。","book":"清·李宝嘉《官场现形记》第五十二回"},"similar":["远水不救近火","远水难救近火"],"usage":"作宾语、定语、分句；用于比喻句"},{"id":43467,"word":"远水解不了近渴","pinyin":"yuǎn shuǐ jiě bù liǎo jìn kě","abbr":"ysjbljk","explanation":"比喻慢的办法救不了急。","source":{"text":"这也容易，只是‘远水解不得近渴’。","book":"清·曹雪芹《红楼梦》"},"example":{"text":"离咱们这儿远得很呢！～呀！","book":"老舍《四世同堂》"},"similar":["远水不救近火"],"opposite":["雪中送炭"],"usage":"作宾语、分句；指不能应急"},{"id":43468,"word":"远水难救近火","pinyin":"yuǎn shuǐ nán jiù jìn huǒ","abbr":"ysnjjh","explanation":"比喻缓慢的救助不能解决眼前的急难。","source":{"text":"贼势方张，渐逼京师，外兵未能遽集，所谓远水难救近火。","book":"清·褚人获《隋唐演义》第91回"},"example":{"text":"清·褚人获《隋唐演义》第91回：“贼势方张，渐逼京师，外兵未能遽集，所谓～。”"},"similar":["远水不救近火","远水救不得近火"],"usage":"作宾语、定语；指不能应急"},{"id":43469,"word":"远求骐骥","pinyin":"yuǎn qiú qí jì","abbr":"yqqj","explanation":"骐骥：良马。到远方去寻求良马。比喻各处访求人材。","source":{"text":"吾远求骐骥，不知近在东邻，何识子之晚也！","book":"《晋书·冯跋载记》"},"usage":"作谓语、定语；指重视人才"},{"id":43470,"word":"远涉重洋","pinyin":"yuǎn shè chóng yáng","abbr":"yscy","explanation":"重洋：辽阔无边的海洋。远远地渡过海洋。","example":{"text":"他早年远涉重洋，历尽艰辛才创下这番基业。"},"similar":["远走高飞","跋山涉水","漂洋过海"],"opposite":["足不出户","闭关自守","深居简出"],"usage":"作谓语、定语；指飘泊很远"},{"id":43471,"word":"远溯博索","pinyin":"yuǎn sù bó suǒ","abbr":"ysbs","explanation":"指广泛地推寻考索。","source":{"text":"司马迁作《史记》，远溯博索，于孔子所不敢述者，皆采而实之。","book":"明·宋濂《题〈寿昌胡氏谱〉后》"},"usage":"作谓语、定语；用于书面语"},{"id":43472,"word":"远瞩高瞻","pinyin":"yuǎn zhǔ gāo zhān","abbr":"yzgz","explanation":"犹言高瞻远瞩。","source":{"text":"既而惮其劳也，携筇散步，随意所之，远瞩高瞻，不复造极。","book":"清·黄钧宰《金壶浪墨·平山堂》"},"similar":["高瞻远瞩"],"usage":"作谓语、定语；用于书面语"},{"id":43473,"word":"远至迩安","pinyin":"yuǎn zhì ěr ān","abbr":"yzea","explanation":"远方来归附，近民安居乐业。形容政治清明，国家大治。","source":{"text":"恕思以明德，则令名载而行之，是以远至迩安。","book":"《左传·襄公二十四年》"},"example":{"text":"元后钦崇之福，～，圣祖昭报之心，天长地久。","book":"唐·王维《贺神兵助取石堡城表》"},"usage":"作谓语、定语；用于书面语"},{"id":43474,"word":"远虑深思","pinyin":"yuǎn lǜ shēn sī","abbr":"ylss","explanation":"深远的谋划和考虑。","source":{"text":"昔圣王远虑深思，患民情之难防，忧奢淫之害政。","book":"汉·崔寔《政论》"},"similar":["远虑深谋","远虑深计","远谋深算"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43475,"word":"远虑深计","pinyin":"yuǎn lǜ shēn jì","abbr":"ylsj","explanation":"深远的考虑和计划。","source":{"text":"昔圣王远虑深思，患民情之难防，忧奢淫之害政。","book":"汉·崔寔《政论》"},"example":{"text":"若万一加以他疾，将复如何！宜远虑深计，不可专守一志。","book":"《晋书·齐王攸传》"},"similar":["远虑深思","远虑深谋","远谋深算"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43476,"word":"远虑深谋","pinyin":"yuǎn lǜ shēn móu","abbr":"ylsm","explanation":"指计划周密，考虑深远。","source":{"text":"此两人者，本无远虑深谋，意在邀功求赏。","book":"唐·韩愈《黄家贼事宜状》"},"similar":["远虑深思","远虑深虑","远谋深算"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43477,"word":"远行无急步","pinyin":"yuǎn xíng wú jí bù","abbr":"yxwjb","explanation":"走远路不能快走。比喻要完成重大的任务，在于持久，不能急躁。","source":{"text":"远行无急步。此去灵山，路程遥远，老师忙也不在一时。既蒙降临，岂可无一斋之敬？","book":"清·无名氏《后西游记》第十回"},"usage":"作宾语、定语；用于口语"},{"id":43478,"word":"远见卓识","pinyin":"yuǎn jiàn zhuó shí","abbr":"yjzs","explanation":"见：见解，见识；卓：高超；识：知识。有远大的眼光和高明的见解。","source":{"text":"解缙之才，有类东方朔，然远见卓识，朔不及也。","book":"明·焦竑《玉堂丛语·调护》"},"example":{"text":"共产党员应是实事求是的模范，又是具有～的模范。","book":"毛泽东《中国共产党在民族战争中的地位》"},"similar":["真知灼见"],"opposite":["一家之言","一孔之见","门户之见"],"usage":"作主语、定语、宾语；指人眼光长远"},{"id":43479,"word":"远见明察","pinyin":"yuǎn jiàn míng chá","abbr":"yjmc","explanation":"目光远大，看得清楚。形容目光敏锐，见识很广。","source":{"text":"智术之士，必远见而明察。","book":"《韩非子·孤愤》"},"usage":"作谓语、定语；用于处事"},{"id":43480,"word":"远谋深算","pinyin":"yuǎn móu shēn suàn","abbr":"ymss","explanation":"犹言深谋远虑。","source":{"text":"他们这样说，就见得我们的行动都出于他们的计划，他们有何等的远谋深算。","book":"叶圣陶《冥世别》"},"similar":["远虑深谋","远虑深思","远虑深计"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43481,"word":"远走高飞","pinyin":"yuǎn zǒu gāo fēi","abbr":"yzgf","explanation":"指象野兽远远跑掉，象鸟儿远远飞走。比喻人跑到很远的地方去。多指摆脱困境去寻找出路。","source":{"text":"汝独不欲修之，宁能高飞远走，不在人间邪？","book":"《后汉书·卓茂传》"},"example":{"text":"孙行者！好男子不可～！快向前与我交战三合。","book":"明·吴承恩《西游记》第六十五回"},"similar":["扬长而去","逃之夭夭","金蝉脱壳"],"opposite":["蜂拥而至","接踵而来","源源而来"],"usage":"作谓语；指离开"},{"id":43482,"word":"远近兼顾","pinyin":"yuǎn jìn jiān gù","abbr":"yjjg","explanation":"远处近处都照顾到。也指长远的和眼前的都要考虑。","example":{"text":"从前因幽州四近，尚有燕兵散布，须要～，内外合筹，一时不便进副，唯连营竖栅，与燕相持。","book":"蔡东藩《五代史演义》第九回"}},{"id":43483,"word":"远近闻名","pinyin":"yuǎn jìn wén míng","abbr":"yjwm","explanation":"形容人或物等非常有名气。","similar":["闻名遐迩"],"opposite":["无名小卒"]},{"id":43484,"word":"远近驰名","pinyin":"yuǎn jìn chí míng","abbr":"yjcm","explanation":"在相当大范围内都是很有名的。","example":{"text":"五指山绿茶在海南～。"},"similar":["小有名气"],"usage":"作谓语、定语；指出名"},{"id":43485,"word":"远门近枝","pinyin":"yuǎn mén jìn zhī","abbr":"ymjz","explanation":"比喻远亲近亲。","example":{"text":"人都有自己的～。"},"usage":"作宾语、定语；指远亲近亲"},{"id":43486,"word":"远隔重洋","pinyin":"yuǎn gé chóng yáng","abbr":"ygcy","explanation":"重洋：一重重的海洋。指相距遥远。","source":{"text":"无如远隔重洋，何能前去看来。","book":"清·李汝珍《镜花缘》第52回"},"usage":"作谓语、定语；指相距遥远"},{"id":43487,"word":"违世乖俗","pinyin":"wéi shì guāi sú","abbr":"wsgs","explanation":"违背世俗常情，与众不同。同“违时绝俗”。","source":{"text":"故非违世乖俗，廉耻礼仪之士，不得至是乡。","book":"清·管同《饿乡记》"},"usage":"作谓语、定语；用于书面语"},{"id":43488,"word":"违世异俗","pinyin":"wéi shì yì sú","abbr":"wsys","explanation":"违背世俗常情，与众不同。同“违时绝俗”。","source":{"text":"米芾性好洁，世号‘水淫’，违世异俗，每与物迕，人又名米颠。","book":"《宣和书谱·宣召记》"},"similar":["违世绝俗"],"usage":"作谓语、定语；用于书面语"},{"id":43489,"word":"违世绝俗","pinyin":"wéi shì jué sú","abbr":"wsjs","explanation":"违背世俗常情，与众不同。同“违时绝俗”。","source":{"text":"谢公江海之士，违世绝俗乃其常耳。","book":"宋·陈师道《上苏公书》"},"similar":["违世乖俗","违世异俗"],"usage":"作谓语、定语；用于书面语"},{"id":43490,"word":"违乡负俗","pinyin":"wéi xiāng fù sú","abbr":"wxfs","explanation":"离别家乡，违背世俗。","source":{"text":"昔苏季、张仪违乡负俗，尚复招三方以事赵，请六国以尊秦。","book":"南朝·陈·徐陵《劝进梁元帝表》"},"usage":"作谓语、定语；用于书面语"},{"id":43491,"word":"违信背约","pinyin":"wéi xìn bèi yuē","abbr":"wxby","explanation":"违：违背。失信于人，背弃约定，毫无信义可言。","source":{"text":"伪齐违信背约，恶稔祸盈。","book":"《周书·武帝纪下》"},"example":{"text":"我们不能干～的事。"},"similar":["背信弃义"],"opposite":["信守诺言"],"usage":"作谓语、定语；指毫无信义"},{"id":43492,"word":"违利赴名","pinyin":"wéi lì fù míng","abbr":"wlfm","explanation":"舍去利欲而求取名声。","source":{"text":"上世列传，弃荣养身，违利赴名，竹帛所载。","book":"汉·王充《论衡·答佞》"},"usage":"作谓语、定语；指放弃财利，求取功名"},{"id":43493,"word":"违利赴誉","pinyin":"wéi lì fù yù","abbr":"wlfy","explanation":"违：离去，引申为放弃；赴：奔走。去利欲而求名誉。指图名不图利。","source":{"text":"弃宗养身，违利赴名，竹帛所载。","book":"汉·王充《论衡·答佞》"}},{"id":43494,"word":"违天害理","pinyin":"wéi tiān hài lǐ","abbr":"wthl","explanation":"做事残忍，违背天道伦理。同“违天逆理”。","source":{"text":"武帝之胤悉被诛戮，初见报效，而反为今主尽节，违天害理。","book":"《南齐书·魏虏传》"},"example":{"text":"当初这厮在日，专一～，贪财好色，奸骗人家妻子。","book":"明·兰陵笑笑生《金瓶梅词话》第九十一回"},"similar":["违天悖理","违天逆理"],"usage":"作谓语、定语；用于处事"},{"id":43495,"word":"违天悖人","pinyin":"wéi tiān bèi rén","abbr":"wtbr","explanation":"违背天理人情。","source":{"text":"若浚（张浚）此举违天悖人，可取浚头归苗傅，不然，一有退缩，悉以军法从事。","book":"宋·罗大经《鹤林玉露》卷八"},"usage":"作谓语、定语；用于处事"},{"id":43496,"word":"违天悖理","pinyin":"wéi tiān bèi lǐ","abbr":"wtbl","explanation":"做事残忍，违背天道伦理。同“违天逆理”。","source":{"text":"今敌肆猖獗，违天悖理，陛下但宜固封疆，申号令，坚壁清野。","book":"《明史·王直传》"},"similar":["违天逆理","违天害理"],"usage":"作谓语、定语；用于处事"},{"id":43497,"word":"违天逆理","pinyin":"wéi tiān nì lǐ","abbr":"wtnl","explanation":"做事残忍，违背天道伦理。","source":{"text":"侯莫陈悦违天逆理，酷害良臣，自以专戮罪重，不恭诏命，阻兵水洛，强梁秦陇。","book":"《周书·文帝纪上》"},"similar":["违天害理"],"usage":"作谓语、定语；指办事与天道相违背"},{"id":43498,"word":"违害就利","pinyin":"wéi hài jiù lì","abbr":"whjl","explanation":"避开祸害，追求利益。","source":{"text":"义者所以行事立功，谋者所以违害就利，要者所以保业守成。","book":"《吴子·图国》"},"similar":["趋利避害"],"usage":"作谓语、宾语、定语；用于处事"},{"id":43499,"word":"违强凌弱","pinyin":"wéi qiáng líng ruò","abbr":"wqlr","explanation":"违：避去；凌：欺侮。避回躲开强者，欺侮凌辱弱者。","source":{"text":"违强凌弱，非勇也。","book":"《左传·定公四年》"},"example":{"text":"我们不要～。"},"similar":["违强陵弱"],"usage":"作谓语、定语；指欺弱怕强"},{"id":43500,"word":"违强陵弱","pinyin":"wéi qiáng líng ruò","abbr":"wqlr","explanation":"避开强暴的，欺凌弱小的。","source":{"text":"《诗》曰：‘柔亦不茹，刚亦不吐。不侮矜寡，不畏强御。’唯仁者能之。违强陵弱，非勇也。乘人之约，非仁也。","book":"《左传·定公四年》"},"similar":["欺弱怕强"],"usage":"作谓语、宾语、定语；用于处事"},{"id":43501,"word":"违心之言","pinyin":"wéi xīn zhī yán","abbr":"wxzy","explanation":"违；违背。违背个人心意的言论。","source":{"text":"仙凡路隔，尤不应以违心之言，释当日之恨。","book":"清·李汝珍《镜花缘》第88回"},"example":{"text":"迫于他的压力，我只好说～了。"},"similar":["违心之论"],"usage":"作宾语；指不是真话"},{"id":43502,"word":"违心之论","pinyin":"wéi xīn zhī lùn","abbr":"wxzl","explanation":"与内心相违背的话。","source":{"text":"若说过多，不独太偏，竟是‘违心之论’了。","book":"清·李汝珍《镜花缘》第十一回"},"example":{"text":"我不能够站到讲台上，滔滔不绝地尽说些～。","book":"叶圣陶《英文教授》"},"similar":["违心之言"],"opposite":["肺腑之言"],"usage":"作主语、宾语；指违背内心的话"},{"id":43503,"word":"违恩负义","pinyin":"wéi ēn fù yì","abbr":"wefy","explanation":"辜负了别人对自己的恩德、情谊，做出对不起别人的事。","source":{"text":"永不恭从，违恩负义，叛主之愆，天不容载。","book":"《南齐书·扶南国传》"},"example":{"text":"你不要～。"},"similar":["忘恩负义"],"opposite":["知恩图报"],"usage":"作谓语、宾语、定语；指忘恩负义"},{"id":43504,"word":"违时绝俗","pinyin":"wéi shí jué sú","abbr":"wsjs","explanation":"违背世俗常情，与众不同。","source":{"text":"冉好违时绝俗，为激诡之行。","book":"南朝·宋·范晔《后汉书·范冉》"},"example":{"text":"这篇文章～，让人耳目一新。"},"similar":["违世异俗"],"usage":"作谓语、定语；指有创新精神"},{"id":43505,"word":"违条犯法","pinyin":"wéi tiáo fàn fǎ","abbr":"wtff","explanation":"违犯法律条文。","source":{"text":"他做了违条犯法的事，昨已斩了。","book":"元·关汉卿《鲁斋郎》第四折"},"example":{"text":"另设牌二十四面，分类标明，如有～者，许被害抱牌进告。","book":"清·大汕《海外纪事》卷二"},"similar":["违条舞法"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43506,"word":"违条舞法","pinyin":"wéi tiáo wǔ fǎ","abbr":"wtwf","explanation":"违犯法律条文。同“违条犯法”。","source":{"text":"一船点检，即二十九只船皆须住岸侍候，显是违条舞法，析文破敕。","book":"宋·苏轼《论纲梢欠折利害状》"},"similar":["违条犯法"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43507,"word":"违法乱纪","pinyin":"wéi fǎ luàn jì","abbr":"wflj","explanation":"违犯法令，破坏纲纪。","source":{"text":"而且还会做出违反共同纲领和政策的事情，作出违法乱纪的事情，使自己完全居于无理和被动地位。","book":"邓小平《克服目前西南党内的不良倾向》"},"example":{"text":"毫无疑问，这是一起地地道道的欺上瞒下，弄虚作假的～事件。","book":"任斌武《无声的浩歌》"},"similar":["败法乱纪"],"opposite":["遵纪守法","奉公守法","安分守己"],"usage":"作谓语、定语；指破坏纲纪"},{"id":43508,"word":"连三并四","pinyin":"lián sān bìng sì","abbr":"lsbs","explanation":"犹言接连不断。","source":{"text":"犹言接连不断。"},"example":{"text":"他～地说：“谢谢你！”"},"similar":["连二并三","接二连三"],"usage":"作定语、状语；形容连续不断"},{"id":43509,"word":"连三接二","pinyin":"lián sān jiē èr","abbr":"lsje","explanation":"犹言接连不断。","source":{"text":"王夫人不免暗里落泪，悲女哭弟，又为宝玉耽忧.如此连三接二，都是不随意的事，那里搁得住？","book":"清·曹雪芹《红楼梦》第九十六回"},"example":{"text":"最初沉醉在男性的柔情里，一年之后，孩子～的来了，又一下子跌入所谓神圣的母爱里了。","book":"王西彦《古屋》第二部七"},"similar":["接二连三","连三接四"],"opposite":["断断续续"],"usage":"作定语、状语；形容连续不断"},{"id":43510,"word":"连三接五","pinyin":"lián sān jiē wǔ","abbr":"lsjw","explanation":"犹言接连不断。","source":{"text":"晚或系灯于线之腰，连三接五，曰鹞灯。","book":"清·顾禄《清嘉录·放断鹞》"},"similar":["连三并四","接二连三"],"usage":"作定语、状语；形容连续不断"},{"id":43511,"word":"连三接四","pinyin":"lián sān jiē sì","abbr":"lsjs","explanation":"犹言接连不断。","source":{"text":"我又没逃了，这么连三接四的叫人来找。","book":"清·曹雪芹《红楼梦》第三十九回"},"example":{"text":"桌上随便的谈笑，大家都觉得快乐，只是中间～的仆人进来回有人送年礼。","book":"冰心《别后》"},"similar":["连三接二"],"opposite":["断断续续"],"usage":"作定语、状语；形容连续不断"},{"id":43512,"word":"连三跨五","pinyin":"lián sān kuà wǔ","abbr":"lskw","explanation":"形容动作迅速。","source":{"text":"说着，出门下阶，嗖的一声，托地跳上房去，顺着那屋脊，迈步如飞，连三跨五，霎时间不见踪影。","book":"清·文康《儿女英雄传》第十六回"},"usage":"作定语、状语；用于口语"},{"id":43513,"word":"连中三元","pinyin":"lián zhòng sān yuán","abbr":"lzsy","explanation":"三元：科举制度称乡试、会试、殿试的第一名为解元、会元、状元，合称“三元”。接连在乡试、会试、殿试中考中了第一名。","source":{"text":"论他的志气，便象冯京商辂连中三元，也只算他便袋里东西，真个是足蹑风云，气冲斗牛。","book":"明·冯梦龙《警世通言》卷十八"},"example":{"text":"玉帝敕旨：谪下文曲星君与冯商为子，～，官封五世。","book":"明·沈受先《三元记·格天》"},"usage":"作谓语、定语；指接连三次中头名"},{"id":43514,"word":"连二并三","pinyin":"lián èr bìng sān","abbr":"lebs","explanation":"犹言接连不断。","source":{"text":"只见两边铺面排山也似价开着，大小客店也是连二并三。","book":"清·文康《儿女英雄传》第十一回"},"similar":["连三接二","接二连三"],"opposite":["断断续续"],"usage":"作定语、状语；形容连续不断"},{"id":43515,"word":"连二赶三","pinyin":"lián èr gǎn sān","abbr":"legs","explanation":"急忙；赶快。","source":{"text":"菊生不敢怠慢，连二赶三地穿好衣服，跳下床来。","book":"姚雪垠《长夜》三二"},"usage":"作定语、状语；用于匆忙时"},{"id":43516,"word":"连云叠嶂","pinyin":"lián yún dié zhàng","abbr":"lydz","explanation":"山峰高耸入云，重叠连绵。","source":{"text":"诸侯欲铲连云叠嶂，而造物夫复如何？","book":"宋·胡仔《苕溪渔隐丛话·杜少陵六》"}},{"id":43517,"word":"连云迭嶂","pinyin":"lián yún dié zhàng","abbr":"lydz","explanation":"连云：与云相连；迭：重叠；嶂：山峰。山峰高耸入云，重叠连绵。","source":{"text":"‘意欲铲选嶂’。则注云：袁盎曰：‘诸侯欲铲连云迭嶂，而造物夫复如何？’","book":"宋·胡仔《苕溪渔隐丛话·杜少陵》"},"similar":["层峦叠嶂"],"usage":"作宾语、定语；用于书面语"},{"id":43518,"word":"连城之价","pinyin":"lián chéng zhī jià","abbr":"lczj","explanation":"形容物品珍贵，价值极高。","source":{"text":"砻之以砥砺，错之以他山，故能致连城之价，为命世之宝。","book":"《史记·廉颇蔺相如列传》：“赵惠文王时，得楚和氏璧，秦昭王闻之，使人遗赵王书，愿以十五城请易璧。”《三国志·魏志·文帝纪》裴松之注引《魏略》"},"example":{"text":"故和璧之在荆山，随珠之潜重川，非遇其人，焉有～，照车之名乎！","book":"《晋书·张载传》"},"similar":["价值连城"],"usage":"作宾语；用于物品等","story":["秦昭王得知赵惠王得到价值连城的和氏璧，想假装以15座城池与他交换来骗取它。赵惠王派蔺相如前去交易，秦王拿到和氏璧后而不谈城池交换事宜。蔺相如设计骗回和氏璧，并派人连夜将它送回赵国，秦王气得要杀死蔺相如"]},{"id":43519,"word":"连城之珍","pinyin":"lián chéng zhī zhēn","abbr":"lczz","explanation":"价值极高的珍物。","source":{"text":"久诚所撰《隋纪》缮写咸毕，前舍弟与家人往，并有书借，咸不见付。岂连城之珍俟楚文而乃进。","book":"唐·王绩《与陈叔达重借隋纪书》"},"example":{"text":"垂棘之壁，～，六器之亨，五豹之分。","book":"清·西湖渔隐主人《欢喜冤家》第九回"},"similar":["连城之璧"],"usage":"作主语、宾语；用于某东西的价值"},{"id":43520,"word":"连城之璧","pinyin":"lián chéng zhī bì","abbr":"lczb","explanation":"价值连城的美玉。比喻极其贵重的东西。","source":{"text":"赵惠文王时，得楚和氏璧。秦昭王闻之，使人遗赵王书，原以十五城请易璧。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"大王不以为宝，臣以为～不过也。","book":"清·蒲松龄《聊斋志异·王成》"},"similar":["价值连城"],"opposite":["一钱不值"],"usage":"作主语、宾语；用于某东西的价值"},{"id":43521,"word":"连墙接栋","pinyin":"lián qiáng jiē dòng","abbr":"lqjd","explanation":"形容房屋连片。","source":{"text":"娇妻劲奴，纵横长安中，连墙接栋，比拟宸极，此岂复人臣也哉！","book":"明·陈子龙《霍光论》"},"similar":["连甍接栋"],"usage":"作谓语、定语；用于建筑物等"},{"id":43522,"word":"连天匝地","pinyin":"lián tiān zā dì","abbr":"ltzd","explanation":"形容规模大，数量多。","source":{"text":"那管他翻云覆雨把冤家构，连天匝地兵戈斗，真个是一往冥鸿不可求。","book":"明·屠隆《彩毫记·归隐林泉》"},"example":{"text":"但见那西南方位安营寨，～大明兵。","book":"《天雨花》第十五回"},"similar":["连山排海"],"usage":"作谓语、状语；用于书面语"},{"id":43523,"word":"连天峰火","pinyin":"lián tiān fēng huǒ","abbr":"ltfh","explanation":"烽火：古时边防报警点的烟火，比喻战火或战争。形容战火烧遍各地。","source":{"text":"其时鲜卑连犯云中五原，一月之中烽火不绝，埃尘连天。","book":"汉·蔡邕《蔡中郎集·外纪上·汉书十志疏》"},"example":{"text":"无限伤心劫后话，～独思君。","book":"李大钊《南天动乱，适将去国，忆天问军中诗》"}},{"id":43524,"word":"连天烽火","pinyin":"lián tiān fēng huǒ","abbr":"ltfh","explanation":"烽火：古时边防报警的烟火，比喻战火或战争。形容战火烧遍各地。","source":{"text":"其时鲜卑连犯云中五原，一月之中烽火不绝，埃尘连天。","book":"汉·蔡邕《蔡中郎集·外纪上·汉书十志疏》"},"example":{"text":"无限伤心劫后话，～独思君。","book":"李大钊《南天动乱·适将去国，忆天问军中诗》"},"similar":["烽火连天"],"opposite":["天下太平"],"usage":"作主语、宾语；形容战火烧遍各地"},{"id":43525,"word":"连宵彻曙","pinyin":"lián xiāo chè shǔ","abbr":"lxcs","explanation":"整整一夜，从天黑到天亮。同“连宵达旦”。","source":{"text":"下至无赖子弟，投琼赌采，连宵彻曙，及至父母病，教他坐侍一夜，瞌睡便驱不去。","book":"清·王夫之《读四书大全说·论语·里仁篇七》"},"similar":["连宵达旦"],"usage":"作谓语、状语；用于处事"},{"id":43526,"word":"连宵达旦","pinyin":"lián xiāo dá dàn","abbr":"lxdd","explanation":"犹言通宵达旦。整整一夜，从天黑到天亮。","source":{"text":"那些王孙公子来一遍，动不动有几个帮闲，连宵达且，好不费事。","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"有～，醉而醒，醒而复醉者。","book":"胡朴安《中华全国风俗志·新疆·回疆风俗记》"},"similar":["连宵彻曙","通宵达旦","连明彻夜"],"usage":"作谓语、状语；用于处事"},{"id":43527,"word":"连山排海","pinyin":"lián shān pái hǎi","abbr":"lsph","explanation":"形容数量多、规模大。","source":{"text":"初八日，得大雨四五寸，河水深一尺，蝗仍连山排海而来，不知内地受伤否？","book":"清·柯悟迟《漏网喁鱼集·咸丰六年》"},"similar":["连天匝地"],"usage":"作谓语、状语；用于书面语"},{"id":43528,"word":"连州比县","pinyin":"lián zhōu bǐ xiàn","abbr":"lzbx","explanation":"指遍及各地。同“连州跨郡”。","source":{"text":"自八纮九野，瓜剖豆分，窃帝偷王，连州比县。","book":"《陈书·高祖纪上》"},"similar":["连州跨郡"],"usage":"作谓语、定语；用于书面语"},{"id":43529,"word":"连州跨郡","pinyin":"lián zhōu kuà jùn","abbr":"lzkj","explanation":"指遍及各地。","source":{"text":"而山东义旗，攘袂争起，连州跨郡，皆以诛卓为名。","book":"唐·杨炯《大周明威将军梁公神道碑》：“连州跨郡，迈陶氏之隆基；开国承家，掩张门之累叶。”唐·高適《后汉贼臣董卓庙议》"},"similar":["连州比县"],"usage":"作谓语、定语；用于书面语"},{"id":43530,"word":"连帙累牍","pinyin":"lián zhì lèi dú","abbr":"lzld","explanation":"形容篇幅过多，文辞冗长。同“连篇累牍”。","source":{"text":"因自撰为方剂，括为歌诗，草纸蝇字，连帙累牍，以遗其后人。","book":"宋·文天祥《〈金匮歌〉序》"},"similar":["连篇累牍","连篇累册","连篇累帙"],"opposite":["言简意赅"],"usage":"作定语、状语；指文辞长"},{"id":43531,"word":"连战皆捷","pinyin":"lián zhàn jiē jié","abbr":"lzjj","explanation":"①打仗接连取得胜利。②今多指体育比赛或考试等接连取得好成绩。","source":{"text":"既连战皆捷，士马旌旗甚盛。","book":"《宋书·自序》"},"example":{"text":"《宋书·自序》：“既连战皆捷，士马旌旗甚盛。”"},"usage":"作谓语、定语；用于比赛等"},{"id":43532,"word":"连抵其隙","pinyin":"lián dǐ qí xì","abbr":"ldqx","explanation":"连续攻击他谈话中的漏洞。","example":{"text":"他的话～，让他没有还击的机会。"},"usage":"作谓语；用于对话、文章等"},{"id":43533,"word":"连日带夜","pinyin":"lián rì dài yè","abbr":"lrdy","explanation":"指日夜不停。同“连日继夜”。","source":{"text":"半个月来，连日带夜地赶着设计图样，左眼又红肿起来了，我点上眼药，扎起手帕，继续工作。","book":"吴云铎《把一切献给党·我们的平射炮》"},"similar":["连日继夜","连日连夜"],"usage":"作定语、状语；用于处事"},{"id":43534,"word":"连日继夜","pinyin":"lián rì jì yè","abbr":"lrjy","explanation":"指日夜不停。","source":{"text":"及肃宗雅好文章，固愈得幸，数入读书禁中，或连日继夜。","book":"《后汉书·班固传下》"},"similar":["连日连夜","连日带夜"],"opposite":["时断时续"],"usage":"作定语、状语；用于处事"},{"id":43535,"word":"连日连夜","pinyin":"lián rì lián yè","abbr":"lrly","explanation":"指日夜不停。","source":{"text":"如今竟成了痨病了，现在危急，专差一个人连日连夜赶来的。","book":"清·曹雪芹《红楼梦》第117回"},"example":{"text":"李大个子的铁匠炉子～生着通红的烈火，他正忙着给人修犁杖，打锄头。","book":"周立波《暴风骤雨》第二部"},"similar":["连日继夜","夜以继日"],"usage":"作状语；指日夜不停"},{"id":43536,"word":"连明彻夜","pinyin":"lián míng chè yè","abbr":"lmcy","explanation":"整整一夜，从天黑到天亮。同“连明连夜”。","source":{"text":"离开信阳的时侯，平汉线南段的客车已经不通，所有的车辆都是连明彻夜地运输军队。","book":"姚雪垠《长夜》二"},"similar":["连明达夜","连明连夜","连宵达旦"],"usage":"作定语、状语；用于处事"},{"id":43537,"word":"连明达夜","pinyin":"lián míng dá yè","abbr":"lmdy","explanation":"整整一夜，从天黑到天亮。同“连明连夜”。","source":{"text":"没有鞋面，就把没有缝上袖子的一个袄襟子用了，连明达夜做了一双。","book":"《解放日报》1944.9.2"},"similar":["通宵达旦","连明彻夜","连明连夜"],"usage":"作定语、状语；用于处事"},{"id":43538,"word":"连明连夜","pinyin":"lián míng lián yè","abbr":"lmly","explanation":"犹言通宵达旦。整整一夜，从天黑到天亮。","source":{"text":"那似此堂帘幕底，连明连夜碧潺湲？","book":"唐·白居易《水堂醉卧问杜三十一》诗"},"example":{"text":"这几天挖泥，四五台锅驼机地抽水，～都抽不干。","book":"西戎《女婿》"},"similar":["通宵达旦","连明彻夜","连明达夜"],"usage":"作定语、状语；用于处事"},{"id":43539,"word":"连昏接晨","pinyin":"lián hūn jiē chén","abbr":"lhjc","explanation":"通宵达旦。整日整夜。","source":{"text":"秋雨一向不解休，连昏接晨终穷秋。","book":"宋·梅尧臣《秋雨篇》"},"similar":["通宵达旦","连明达夜","连明彻夜"],"usage":"作定语、状语；用于处事"},{"id":43540,"word":"连昏达曙","pinyin":"lián hūn dá shǔ","abbr":"lhds","explanation":"犹言通宵达旦。整整一夜，从天黑到天亮。","source":{"text":"平明，竹者、木者、夹茆者、削藤者、锹者、锸者，乘屋而呼，穴坎而下者，连昏达曙，三日夜而成。","book":"清·大汕《海外纪事》卷一"},"similar":["通宵达旦","连明达夜","连明彻夜"],"usage":"作定语、状语；用于处事"},{"id":43541,"word":"连昬接晨","pinyin":"lián hūn jiē chén","abbr":"lhjc","explanation":"昬，同“昏”。通宵达旦。整日整夜。"},{"id":43542,"word":"连更彻夜","pinyin":"lián gèng chè yè","abbr":"lgcy","explanation":"犹连夜。形容办事赶紧，毫不拖延。同“连更晓夜”。","source":{"text":"宋四公思量道：‘梁园虽好，不是久恋之家。’连更彻夜，走归郑州去。","book":"明·冯梦龙《喻世明言》第三十六卷"},"similar":["连更晓夜","连更星夜"],"usage":"作定语、状语；用于处事"},{"id":43543,"word":"连更星夜","pinyin":"lián gèng xīng yè","abbr":"lgxy","explanation":"犹连夜。形容办事赶紧，毫不拖延。同“连更晓夜”。","source":{"text":"太平军来打镇平城，镇平大爷就是惊；连更星夜就逃走，带得家小到长沄。","book":"《中国近代反帝反封建历史歌谣选·太平军打仗好军机》"},"similar":["连更晓夜","连更彻夜"],"usage":"作定语、状语；用于处事"},{"id":43544,"word":"连更晓夜","pinyin":"lián gèng xiǎo yè","abbr":"lgxy","explanation":"犹连夜。形容办事赶紧，毫不拖延。","source":{"text":"中书省得了圣旨，一面连更晓夜，整顿酒肉，差官二员，前去给散。","book":"明·施耐庵《水浒传》第八十三回"},"example":{"text":"听见没有镜匣脂粉，立刻跑去，～地买。","book":"李劼人《死水微谰》第六部分二"},"similar":["连更彻夜","连更星夜"],"usage":"作定语、状语；用于处事"},{"id":43545,"word":"连朝接夕","pinyin":"lián zhāo jiē xī","abbr":"lcjx","explanation":"从早晨连到晚上。形容不分白天黑夜地边疆工伤。","source":{"text":"劳心灵，役声气，连朝接夕，不自知其苦，非魔而何？","book":"唐·白居易《与元九书》"},"example":{"text":"经过两天～的交战，我军虽然顶住了日军的攻势，却未能克复孟子岭高地，处境仍然被动。","book":"《张自忠传》第三章"},"similar":["夜以继日"],"usage":"作状语；用于连续工作"},{"id":43546,"word":"连枝共冢","pinyin":"lián zhī gòng zhǒng","abbr":"lzgz","explanation":"比喻爱情坚贞不渝。","source":{"text":"便有大梓生于二冢之端，旬日而大盈抱，屈体相就，根交于下，枝错于上。","book":"晋·干宝《搜神记》第11卷"},"example":{"text":"但得个同心子，死共穴，生同舍，便做～、共冢我也心欢悦。","book":"明·孟称舜《娇红记·晚绣》"},"usage":"作宾语、定语；形容爱情坚贞","story":["战国时期宋康王抢夺家人韩凭的妻子何氏，韩凭忧怨而自杀，何氏也殉情而死，留下遗书要求与韩合葬。宋康王不同意，将韩何分开葬，两坟可以相望。后来两坟之间长出一株大树，枝叶相连，盘根错节，宋人取名为相思树"]},{"id":43547,"word":"连枝分叶","pinyin":"lián zhī fēn yè","abbr":"lzfy","explanation":"同根所生的枝叶。常喻兄弟之间的密切关系。","source":{"text":"朕之于卿，兄弟非远，连枝分叶，兴灭相依。","book":"lián  zhī  fēn  yè北魏·杨衒之《洛阳伽蓝记·永宁寺》"},"similar":["连枝带叶","连枝同气"],"usage":"作谓语、定语；用于比喻句"},{"id":43548,"word":"连枝同气","pinyin":"lián zhī tóng qì","abbr":"lztq","explanation":"比喻同胞兄弟姐妹或情如兄弟的亲密关系。","source":{"text":"况我连枝树，与子同一身。","book":"《吕氏春秋·精通》：“故父母之于子也，子之于父母也，一体而两分，同气而异息。”旧题汉苏武《诗》之一"},"example":{"text":"鹊巢鸠处纷争夺，～竞反覆。","book":"清·刘青藜《地师》诗"},"similar":["连枝分叶"],"usage":"作谓语、定语；用于比喻句"},{"id":43549,"word":"连枝带叶","pinyin":"lián zhī dài yè","abbr":"lzdy","explanation":"同根所生的枝叶。常比喻兄弟之间的密切关系。","source":{"text":"朕之于卿，兄弟非远，连枝分叶，兴灭相依。","book":"北魏·杨衒之《洛阳伽蓝记·永宁寺》"},"example":{"text":"谁想俺嫂狠兄毒心意歹，全不想共根同蒂，～。","book":"明·无名氏《龙门隐秀》第三折"},"similar":["连枝分叶"],"usage":"作谓语、定语；用于比喻句"},{"id":43550,"word":"连枝并头","pinyin":"lián zhī bìng tóu","abbr":"lzbt","explanation":"连理枝和并头莲。比喻美满的婚姻。","source":{"text":"这一桩婚媾与卿卿可正是连枝并头。","book":"明·孙仁孺《东郭记·一妾》"},"similar":["连枝比翼"],"usage":"作宾语；用于爱情"},{"id":43551,"word":"连枝比翼","pinyin":"lián zhī bǐ yì","abbr":"lzby","explanation":"比翼：比翼鸟，即鹣鹣。传此鸟一目一翼，两只必须并列在一起飞。比喻男女成双成对。","source":{"text":"在天愿作比翼鸟，在地愿为连理枝。","book":"唐·白居易《长恨歌》"},"example":{"text":"他指望～，那知急煎煎，镜破簪折。","book":"明·高濂《玉簪记·叱谢》"},"similar":["比翼连枝"],"usage":"作宾语；用于爱情"},{"id":43552,"word":"连根共树","pinyin":"lián gēn gòng shù","abbr":"lggs","explanation":"同一棵树上生长的根相连。比喻关系极为密切。","source":{"text":"到门前偏撞见狠心的伯娘，把文书早先赚去，百般的道假嫌真，全不念连根共树。","book":"元·无名氏《合同文字》第三折"}},{"id":43553,"word":"连根带梢","pinyin":"lián gēn dài shāo","abbr":"lgds","explanation":"比喻事情的情节十分完整。","source":{"text":"萧队长笑着，对于这连根带梢、清清楚楚的说法，他最喜欢。","book":"周立波《暴风骤雨》第二部"},"usage":"作定语；比喻事情的情节十分完整"},{"id":43554,"word":"连汤带水","pinyin":"lián tāng dài shuǐ","abbr":"ltds","explanation":"比喻全部，无遗留。","source":{"text":"甚至，他把田主任如何当上所长等等废话，都连汤带水倒了出来。","book":"方之《内奸》"},"example":{"text":"姚长庚段上事忙，天天戴着星星才回家，老婆也要～，囉里囉喀，一样一样告诉他。","book":"杨朔《三千里江山》第一段"},"similar":["连汤带汁"],"usage":"作状语；指全部"},{"id":43555,"word":"连滚带爬","pinyin":"lián gǔn dài pá","abbr":"lgdp","explanation":"形容害怕得慌乱逃走的样子。","source":{"text":"我怒吼一声，朝小孩踢了一脚，他连滚带爬地跑了。","book":"王朔《动物凶猛》"},"example":{"text":"敌人被打得～地逃回去了。"},"similar":["屁滚尿流"],"usage":"作状语；形容人的窘态"},{"id":43556,"word":"连珠合璧","pinyin":"lián zhū hé bì","abbr":"lzhb","explanation":"比喻人才或美好的事物聚集在一起。","source":{"text":"连珠合璧重光来，天策暂转勾陈开。","book":"北周·庾信《郊庙歌辞·昭复》"},"example":{"text":"尽道是～，卻无由尊酒杯茶。","book":"明·徐复祚《红梨记·诉衷》"},"similar":["珠联璧合"],"usage":"作宾语、定语；同“珠联璧合”"},{"id":43557,"word":"连珠炮","pinyin":"lián zhū pào","abbr":"lzp","explanation":"比喻说话很快。","source":{"text":"秦波并不屈服，她向焦成思开起连珠炮来。","book":"谌容《人到中年》"},"example":{"text":"王朔《橡皮人》：“徐光涛气得一下没说出话，接着～似地连骂带说。”"},"usage":"作宾语、定语；用于比喻句"},{"id":43558,"word":"连理之木","pinyin":"lián lǐ zhī mù","abbr":"llzm","explanation":"不同根的树木而枝干连生在一起。古时认为是吉祥的征兆。","source":{"text":"一角之兽，连理之木。","book":"《晋书·元帝记》"},"example":{"text":"岭下客孤征，岭上木连理。～死复生，孤征之客生如死！","book":"清·魏子安《花月痕》第五回"},"usage":"作宾语；用于书面语"},{"id":43559,"word":"连理分枝","pinyin":"lián lǐ fēn zhī","abbr":"llfz","explanation":"比喻夫妻分离。","source":{"text":"愁肠欲断，正是青春半。连理分枝鸾失伴，又是一场离散。","book":"唐·孙光宪《清平乐》词"},"similar":["破镜分钗"],"opposite":["比翼连理"],"usage":"作谓语、定语；指夫妻离散"},{"id":43560,"word":"连理枝","pinyin":"lián lǐ zhī","abbr":"llz","explanation":"两棵树的枝条连生在一起。比喻夫妻恩爱。","source":{"text":"在天愿作比翼鸟，在地愿为连理枝。","book":"唐·白居易《长恨歌》"},"example":{"text":"清·褚人获《隋唐演义》第66回：“百和香匀～，三星气暖同心结。”"},"usage":"作宾语、定语；多用于比喻句"},{"id":43561,"word":"连璧贲临","pinyin":"lián bì bì lín","abbr":"lbbl","explanation":"贲临：光临。旧时的客套话，指两个客人同时到来。","source":{"text":"谢二客同至者，连璧贲临。","book":"宋·胡继宗《书言故事·访临类》"}},{"id":43562,"word":"连甍接栋","pinyin":"lián méng jiē dòng","abbr":"lmjd","explanation":"指房屋连片。","source":{"text":"今新街及马路侧，连甍接栋者皆是也。","book":"清·王韬《洋泾浜海市说》"},"example":{"text":"城中烟火万家，～。","book":"清·余宾硕《金陵览古·昭明读书台》"},"similar":["连里竟街","连墙接栋"],"usage":"作谓语、定语；用于建筑物等"},{"id":43563,"word":"连畴接陇","pinyin":"lián chóu jiē lǒng","abbr":"lcjl","explanation":"指田地连片。","source":{"text":"莺粟花连畴接陇于黛柳镜波之间，景趣殊胜。","book":"明·徐弘祖《徐霞客游记·滇海日记八》"},"usage":"作谓语、定语；用于书面语"},{"id":43564,"word":"连皮带骨","pinyin":"lián pí dài gǔ","abbr":"lpdg","explanation":"连皮肤及骨头一起。比喻全部。","source":{"text":"我只愿这会子立刻我死了，把心迸出来你们瞧见了，然后连皮带骨一概都化成一股灰。","book":"清·曹雪芹《红楼梦》第57回"},"usage":"作定语、状语；指全部"},{"id":43565,"word":"连章累牍","pinyin":"lián zhāng lèi dú","abbr":"lzld","explanation":"形容篇幅过多，文辞冗长。同“连篇累牍”。","source":{"text":"遂使握管怀铅，多无铨综之识；连章累牍，罕逢微婉之言。","book":"唐·刘知幾《史通·核才》"},"example":{"text":"顷，尝有一士焉，以草茅疏贱，不为禄诱，不为祸怵，～，抗论今日任兼将相之大臣。","book":"清·侯方域《南省试策二》"},"similar":["连篇累牍"],"opposite":["言简意赅"],"usage":"作定语、状语；指文辞长"},{"id":43566,"word":"连篇累册","pinyin":"lián piān lèi cè","abbr":"lplc","explanation":"形容篇幅过多，文辞冗长。同“连篇累牍”。","source":{"text":"世人作诗以敏捷为奇，以连篇累册为富，非知诗者也。","book":"明·都穆《南濠诗话》"},"similar":["连篇累牍","连篇累幅"],"opposite":["简明扼要"],"usage":"作宾语、定语、状语；指文辞长"},{"id":43567,"word":"连篇累帙","pinyin":"lián piān lèi zhì","abbr":"lplz","explanation":"形容篇幅过多，文辞冗长。同“连篇累牍”。","source":{"text":"楷法遒整，自习业至公牍，连篇累帙，多不可纪数。","book":"明·李东阳《明故资善大夫黎公先生行状》"},"similar":["连篇累幅","连篇累牍","连篇累册"],"opposite":["简明扼要","言简意赅"],"usage":"作定语、状语；指文辞长"},{"id":43568,"word":"连篇累帧","pinyin":"lián piān lèi zhèng","abbr":"lplz","explanation":"形容篇幅过多，文辞冗长。同“连篇累牍”。","source":{"text":"连篇累帧真难竟，引睡能消字几行。","book":"清·周亮工《重阳后二日》诗"},"similar":["连篇累幅","连篇累牍","连篇累册"],"opposite":["言简意赅"],"usage":"作定语、状语；指文辞长"},{"id":43569,"word":"连篇累幅","pinyin":"lián piān lèi fú","abbr":"lplf","explanation":"形容篇幅过多，文辞冗长。同“连篇累牍”。","source":{"text":"伧父极力铺张，连篇累幅，无此气势者，由于笔之钝故也。","book":"清·夏敬渠《野叟曝言》第八十三回"},"example":{"text":"偶尔撰述，信笔抒写，～。","book":"清·汤斌《江南镇江府海防同知冉渠吴公墓志铭》"},"similar":["连篇累牍","累牍连篇"],"usage":"作定语、状语；指文辞长"},{"id":43570,"word":"连篇累牍","pinyin":"lián piān lěi dú","abbr":"lpld","explanation":"累：重叠；牍：古代写字的木片。形容篇幅过多，文辞冗长。","source":{"text":"连篇累牍，不出月露之形。","book":"《隋书·李谔传》"},"example":{"text":"学诗有三节：其初不识好恶，～，肆笔而成。","book":"宋·严羽《沧浪诗话·诗法》"},"similar":["拖泥带水","长篇大论"],"opposite":["言简意赅","简明扼要","要言不烦"],"usage":"作定语、状语；指文辞长","story":["隋文帝时治书侍御史李谔看到六朝以来的文章华而不实，决定上书隋文帝通过行政手段来改变文风。李谔的《请正文体书》深得隋文帝的赞许，就发布政令不许天下文人用连篇累牍去吟咏风花雪月，要做到就事论事，言之有据"]},{"id":43571,"word":"连篇絫幅","pinyin":"lián piān lèi fú","abbr":"lplf","explanation":"形容篇幅过多，文辞冗长。同“连篇累牍”。"},{"id":43572,"word":"连篇絫牍","pinyin":"lián piān lèi dú","abbr":"lpld","explanation":"形容篇幅过多，文辞冗长。同“连篇累牍”。"},{"id":43573,"word":"连类引譬","pinyin":"lián lèi yǐn pì","abbr":"llyp","explanation":"引：援引；譬：比方。援引相类似的例证来说明事理。","source":{"text":"惟若辩通，文辞可从，连类引譬，以投祸凶。","book":"汉·刘向《列女传·辩通传题序》"}},{"id":43574,"word":"连类比事","pinyin":"lián lèi bǐ shì","abbr":"llbs","explanation":"连缀相类的事物，进行对比。同“连类比物”。","source":{"text":"《申子》与《商君书》，皆《韩非》之类，然其连类比事，不逮《韩非》远甚。","book":"明·何良俊《四有斋丛说·子二》"},"similar":["连类比物"],"usage":"作谓语；指进行对比"},{"id":43575,"word":"连类比物","pinyin":"lián lèi bǐ wù","abbr":"llbw","explanation":"连：连缀。连缀相类的事物，进行对比。","source":{"text":"多言繁称，连类比物，则见以为虚而无用。","book":"《韩非子·难言》"},"similar":["比物连类","连类比事"],"opposite":["混为一谈"],"usage":"作谓语；指进行对比"},{"id":43576,"word":"连类龙鸾","pinyin":"lián lèi lóng luán","abbr":"llll","explanation":"鸾：凤凰。与龙凤连成一类。比喻与贤人同派。","source":{"text":"比物荃荪，连类龙鸾，声溢金石，志华日月。","book":"《宋书·颜延之传》"}},{"id":43577,"word":"连绵不断","pinyin":"lián mián bù duàn","abbr":"lmbd","explanation":"连绵：连续不断的样子。形容连续不止，从不中断。","source":{"text":"往余再丧妻，四丧子，复丧妹，最后丧母，连绵不绝，哭泣悲伤，五衷菀结。","book":"明·朱国祯《涌幢小品》"},"example":{"text":"～的高山阻挡我们的去路。"},"similar":["源源不断","连续不断"],"opposite":["断断续续","一刀两断"],"usage":"作谓语、定语；形容连续不止"},{"id":43578,"word":"连绵不绝","pinyin":"lián mián bù jué","abbr":"lmbj","explanation":"连续而不中断。","source":{"text":"往余再丧妻，四丧子，复丧妹，最后丧母，连绵不绝。哭泣悲伤，五衷菀结。","book":"明·朱国祯《涌幢小品·神惠记》"},"example":{"text":"～的烦闷，正就是由回忆引起的。","book":"叶圣陶《被忘却的》"},"similar":["连绵不断"],"opposite":["断断续续"],"usage":"作谓语、定语；形容连续不止"},{"id":43579,"word":"连绵起伏","pinyin":"lián mián qǐ fú","abbr":"lmqf","explanation":"连绵：连续不断的样子；起伏：高低不平。连续不断而且起伏不平。","source":{"text":"连绵起伏的云宛如浮动在海上的冰山。","book":"孙荪《云赋》"},"example":{"text":"这里的丘陵真是～。"},"similar":["绵亘不绝","连绵不断"],"opposite":["一望无际","一马平川"],"usage":"作谓语、定语；指连续不断而且起伏不平"},{"id":43580,"word":"连编累牍","pinyin":"lián biān lěi dú","abbr":"lbld","explanation":"牍：古代写字的木片。形容篇幅过多，文辞长。","source":{"text":"虽终日兀坐车中，不发一语，其实连编累牍也写不了他胸中情绪。","book":"清·魏子安《花月痕》第三回"},"example":{"text":"最近报纸～的都是911事件。"},"similar":["连篇累牍"],"usage":"作定语；指文章过长"},{"id":43581,"word":"连群结党","pinyin":"lián qún jié dǎng","abbr":"lqjd","explanation":"结合同党，连成群体。","source":{"text":"轻死重气，结党连群，实蕃有徒，其从如云。","book":"汉·张衡《西京赋》"},"example":{"text":"若东西南北所在啸聚，～，日滋月蔓，弥漫山泽。","book":"宋·司马光《应诏言朝政阙失》"}},{"id":43582,"word":"连舆并席","pinyin":"lián yú bìng xí","abbr":"lybx","explanation":"形容亲密友爱。同“连舆接席”。","source":{"text":"连舆并席，琢磨益友之陪；会弁挥犀，磊落德星之聚。","book":"宋·苏籀《答曹机宜启》"},"similar":["连舆接席"],"usage":"作谓语、定语；用于交往等"},{"id":43583,"word":"连舆接席","pinyin":"lián yú jiē xí","abbr":"lyjx","explanation":"行并车，止同席。形容亲密友爱。","source":{"text":"望苑招贤，华池爱客；托乘同舟，连舆接席。","book":"《梁书·昭明太子统传》"},"similar":["连舆并席"],"usage":"作谓语、定语；用于交往等"},{"id":43584,"word":"连蒙带骗","pinyin":"lián mēng dài piàn","abbr":"lmdp","explanation":"欺蒙，欺骗别人。","example":{"text":"他～地把她带回家。"},"usage":"作谓语、状语；指欺骗"},{"id":43585,"word":"连街倒巷","pinyin":"lián jiē dǎo xiàng","abbr":"ljdx","explanation":"犹言满街倾巷。指所有地方。","source":{"text":"当时百姓连街倒巷，皆怨商君。","book":"《东周列国志》第八九回"},"usage":"作宾语、定语；用于书面语"},{"id":43586,"word":"连衽成帷","pinyin":"lián rèn chéng wéi","abbr":"lrcw","explanation":"衣襟相接而成帷幕。形容人多。","source":{"text":"车毂击，人肩摩，连衽成帷，举袂成幕，挥汗成雨。","book":"《史记·苏秦列传》"},"similar":["挥汗成雨","举袂成幕"],"usage":"作谓语、定语；形容人多"},{"id":43587,"word":"连蹦带跳","pinyin":"lián bèng dài tiào","abbr":"lbdt","explanation":"精力充沛的充满活力的样子。","source":{"text":"‘好吧。’我说。挂了电话，～地跑回宿舍。","book":"王朔《浮出海面》"},"example":{"text":"她～地跑回家去。"},"similar":["蹦蹦跳跳"],"usage":"作谓语、状语、定语；多用于小孩等"},{"id":43588,"word":"连车平斗","pinyin":"lián chē píng dǒu","abbr":"lcpd","explanation":"形容冗员很多。","source":{"text":"补阙连车载，拾遗平斗量。","book":"唐·张鷟《朝野佥载》第四卷"},"example":{"text":"朝臣多于州县，岂惟～之刺，亦有败财假器之失。","book":"《宋史·职官志八》"},"similar":["车载斗量"],"usage":"作谓语、定语；指人浮于事"},{"id":43589,"word":"连里竟街","pinyin":"lián lǐ jìng jiē","abbr":"lljj","explanation":"形容屋舍毗连不绝。","source":{"text":"伏见诏书为阿母兴起津城门内第舍，合两为一，连里竟街，雕修缮饰，穷极巧伎。","book":"《后汉书·杨震传》"},"example":{"text":"宅大曰～。","book":"明·王志坚《表异录·宫殿》"},"similar":["连街跨巷"],"usage":"作宾语、定语；用于建筑物等"},{"id":43590,"word":"连锁反应","pinyin":"lián suǒ fǎn yìng","abbr":"lsfy","explanation":"连锁：像锁链似的一环扣一环。比喻相关的事物发生相应的变化。","example":{"text":"我们要注意此事的连锁反应。"},"usage":"作宾语；形容事物的联系"},{"id":43591,"word":"连锅端","pinyin":"lián guō duān","abbr":"lgd","explanation":"喻指完全除灭或尽数挪走。","example":{"text":"他们家让小偷～了。"},"similar":["一锅端"],"usage":"作谓语、宾语；指全部"},{"id":43592,"word":"连镳并轸","pinyin":"lián biāo bìng zhěn","abbr":"lbbz","explanation":"镳：马勒；轸：车箱底部的横木，这里指车。指并驾齐驱。","source":{"text":"洪武之初，刘伯温高格，并以高季迪、袁景文诸人各逞才情，连镳并轸。","book":"清·沈德潜《明诗别裁集》序"},"similar":["并驾齐驱","连镳并驾"],"usage":"作谓语、状语；同“并驾齐驱”"},{"id":43593,"word":"连镳并驾","pinyin":"lián biāo bìng jià","abbr":"lbbj","explanation":"比喻彼此的力量或才能不分高下。同“连镳并轸”。","source":{"text":"尚双双奋翼抟扶摇而南，连镳并驾，秋桂齐攀，大吾门、亢吾宗，匪异人任，惟两孙子。","book":"清·蒲松龄《贺两侄曾孙兄弟同时游泮序》"},"similar":["连镳并轸"],"usage":"作谓语、状语；同“并驾齐驱”"},{"id":43594,"word":"连阡累陌","pinyin":"lián qiān lèi mò","abbr":"lqlm","explanation":"形容田多。","source":{"text":"若坐拥仓箱，刻剥小民，连阡累陌，粟红而不可食，铜臭而不可闻。","book":"清·王有光《吴下谚·一身财主》"},"usage":"作定语；用于书面语"},{"id":43595,"word":"连阶累任","pinyin":"lián jiē lèi rèn","abbr":"ljlr","explanation":"指接连升迁连任。","source":{"text":"先人馀福，得以弱冠特蒙征用，连阶累任，遂极台阁。","book":"《后汉书·黄香传》"},"usage":"作谓语；用于官场等"},{"id":43596,"word":"连鳌跨鲸","pinyin":"lián áo kuà jīng","abbr":"lakj","explanation":"以之表示超凡成仙。","source":{"text":"《列子·汤问》载：渤海之东有五山浮于海，天帝令巨鳌十五轮流负山，山始不动。“而龙伯之国有大人，举足不盈数步而暨五山之所，一钓而连六鳌。”又《文选·扬雄〈羽猎赋〉》有游猎江河湖泽，“乘巨鳞，骑京（或作鲸）鱼”的记载。"}},{"id":43597,"word":"连鸡之势","pinyin":"lián jī zhī shì","abbr":"ljzs","explanation":"连鸡：用绳子拴在一起的鸡。比喻互相掣肘，步调不一致。","source":{"text":"高杰一逃将也，恃士英卵翼，奉若骄子，浸浸尾大。而刘、黄诸将，又置若奕棋，汹汹为连鸡之势，动曰不和。","book":"明·李清《三垣笔记·补遗》"},"example":{"text":"曾百行和王伯申、赵守义是～，他们一定也到省里反告朱老伯，省里一定派人到县来调解。","book":"茅盾《霜叶红似二月花续稿》"}},{"id":43598,"word":"迟回观望","pinyin":"chí huí guān wàng","abbr":"chgw","explanation":"犹言迟疑观望。","source":{"text":"上孜孜图治，求言诏屡下，而诸臣迟回观望者，皆以从前言事诸葛亮臣，一经惩创，则流徙永锢，相率以言为戒耳。","book":"《清史稿·李森先传》"},"similar":["犹豫不决"],"usage":"作谓语、定语；指人不能决断"},{"id":43599,"word":"迟徊不决","pinyin":"chí huái bù jué","abbr":"chbj","explanation":"犹言迟疑不决。","source":{"text":"为朝廷计，与其迟徊不决以启天下之疑，何如明示政纲以箝党人之口。","book":"中国近代史资料丛刊《辛亥革命·清廷预备立宪》"},"similar":["迟疑不决"],"usage":"作谓语、定语、状语；用于处事"},{"id":43600,"word":"迟徊观望","pinyin":"chí huái guān wàng","abbr":"chgw","explanation":"犹言迟疑观望。","source":{"text":"主张国内军事当局，乘日本大隈内阁迟徊观望之时，及早自动，以武力收回青岛。","book":"刘揆一《黄兴传记》"},"similar":["迟疑观望"],"usage":"作谓语、定语、状语；用于处事"},{"id":43601,"word":"迟日旷久","pinyin":"chí rì kuàng jiǔ","abbr":"crkj","explanation":"犹言旷日持久。","source":{"text":"瞋目扼腕而语勇者得，垂衣裳而谈说者得，迟日旷久积劳私门者得。","book":"《商君书·君臣》"},"similar":["旷日持久"],"usage":"作谓语、定语；指时间久"},{"id":43602,"word":"迟暮之年","pinyin":"chí mù zhī nián","abbr":"cmzn","explanation":"迟暮：黄昏，比喻晚年。指人至老年。","source":{"text":"痛思臣母迟暮之年，不幸身婴残疾。","book":"《清朝野史大观·第九卷·两大文章》"},"example":{"text":"他虽然到了～，但是学习的热情丝毫不减。"},"similar":["桑榆暮年"],"usage":"作宾语；比喻晚年"},{"id":43603,"word":"迟疑不决","pinyin":"chí yí bù jué","abbr":"cybj","explanation":"形容拿不定主意。","source":{"text":"尔往至彼，如益来，即置勿问，苟迟疑不决，即以便宜从事。","book":"《宋史·侯益传》"},"example":{"text":"我做了她的俘虏，她反而有点～了。","book":"巴金《春天里的秋天》"},"similar":["犹豫不决"],"opposite":["当机立断"],"usage":"作谓语、宾语；指犹豫不定"},{"id":43604,"word":"迟疑不定","pinyin":"chí yí bù dìng","abbr":"cybd","explanation":"犹言迟疑不决。","source":{"text":"师若迟疑不定，或再或三，是亵渎，渎则不告。","book":"《易·蒙》“初筮告，再三渎，渎则不告”唐·孔颖达疏"},"example":{"text":"～的神色就很显然地浮上了杜竹斋的山羊脸儿。","book":"茅盾《子夜》二"},"similar":["迟疑不决"],"usage":"作谓语、定语、状语；用于处事"},{"id":43605,"word":"迟疑不断","pinyin":"chí yí bù duàn","abbr":"cybd","explanation":"犹言迟疑不决。","source":{"text":"迟疑不断，未有能成其事者也。","book":"唐·韩愈《沦淮西事宜状》"},"similar":["犹豫不决"],"opposite":["斩钉截铁"],"usage":"作谓语、定语、状语；用于处事"},{"id":43606,"word":"迟疑坐困","pinyin":"chí yí zuò kùn","abbr":"cyzk","explanation":"迟疑：犹豫不决；坐：遂，于是。因为犹豫不决而陷于困境中。"},{"id":43607,"word":"迟疑未决","pinyin":"chí yí wèi jué","abbr":"cywj","explanation":"形容拿不定主意。","source":{"text":"昭度迟疑未决，建遣军士擒昭度亲吏于军门，脔而食之。","book":"《新五代史·前蜀世家·王建传》"},"example":{"text":"其所以～者，只为要把两桩事情合成一件。","book":"清·李渔《巧团圆·议赘》"},"similar":["迟疑不决","犹豫不定"],"opposite":["斩钉截铁"],"usage":"作谓语、宾语；指犹豫不定"},{"id":43608,"word":"迟疑观望","pinyin":"chí yí guān wàng","abbr":"cygw","explanation":"指犹豫等待，不作决定。","source":{"text":"相公，俞旨既下，就该速速抽身，为什么还要迟疑观望？","book":"清·李渔《比目鱼·肥遁》"},"similar":["迟疑顾望","迟徊观望"],"usage":"作谓语、定语、状语；用于处事"},{"id":43609,"word":"迟疑顾望","pinyin":"chí yí gù wàng","abbr":"cygw","explanation":"犹言迟疑观望。","source":{"text":"[李勣]今若即发者，我死后可亲任之，如迟疑顾望，便当杀之。","book":"唐·刘餗《惰唐嘉话》卷中"},"similar":["迟疑观望"],"usage":"作谓语、定语、状语；用于处事"},{"id":43610,"word":"迟眉钝眼","pinyin":"chí méi dùn yǎn","abbr":"cmdy","explanation":"指眼神呆滞，不灵活。","source":{"text":"并且迟眉钝眼地，看着人憨痴痴地，比蔡兴顺精灵不到多少。","book":"李劼人《死水微澜》第六部分"},"example":{"text":"他生就～的模样。"},"opposite":["聪明伶俐"],"usage":"作宾语、定语；指呆板"},{"id":43611,"word":"迟迟吾行","pinyin":"chí chí wú xíng","abbr":"ccwx","explanation":"迟迟：慢慢地。原指慢慢考虑考虑再走。形容恋恋不舍地离开。","source":{"text":"孔子去齐，接淅而行；去鲁，曰：‘迟迟吾行也，去父母国之道也。","book":"《孟子·万章下》"}},{"id":43612,"word":"迢迢千里","pinyin":"tiáo tiáo qiān lǐ","abbr":"ttql","explanation":"迢迢：遥远的样子。形容路途遥远。","source":{"text":"如何咫尺仍有情，况复迢迢千里外。","book":"唐·高适《秋胡行》"},"example":{"text":"韦君现在一个人睡在刚秉庙的一间破屋里，等着他～的老父，天气又这样坏；韦君，你的魂也彷徨着吧！","book":"朱自清《哀韦杰三君》"},"similar":["千里迢迢"],"usage":"作定语、状语；指遥远","story":["传说汉明帝时期，汝州南城秀才张邵与楚州山阳秀才范式，两人结伴到洛阳应试。他们结为莫逆之交，相约来年重阳在张邵家聚会。范式因经商误了约期，便自刎而死。他的灵魂千里迢迢去会张邵。张邵也千里迢迢去拜谒范式的尸体，之后也自刎而死"]},{"id":43613,"word":"迤逦不绝","pinyin":"yǐ lǐ bù jué","abbr":"ylbj","explanation":"迤逦：曲折连续的样子。曲折连绵不断。","source":{"text":"行十余里，忽见幢节幡盖，迤逦不绝。","book":"宋·张君房《云笈七签》第113卷"},"usage":"作谓语、定语；指曲折"},{"id":43614,"word":"迥不犹人","pinyin":"jiǒng bù yóu rén","abbr":"jbyr","explanation":"指卓然超绝，不同于人。","source":{"text":"玉生曾受业于方茶山先生，故其诗笔迥不犹人。","book":"清·梁章锯《浪迹丛谈·二十四桥》"},"usage":"作谓语；指卓然超绝"},{"id":43615,"word":"迥乎不同","pinyin":"jiǒng hū bù tóng","abbr":"jhbt","explanation":"形容差别很大，完全不一样。","source":{"text":"我们所弹的曲子，一人弹与两人弹，迥乎不同。","book":"清·刘鹗《老残游记》第十回"},"example":{"text":"值得注意的是山的南北，自然条件～。","book":"翦伯赞《内蒙访古》"},"similar":["迥然不同","截然不同"],"opposite":["大同小异","不相上下"],"usage":"作谓语、宾语、定语；用于两者之间比较"},{"id":43616,"word":"迥然不同","pinyin":"jiǒng rán bù tóng","abbr":"jrbt","explanation":"迥然：相距很远或差别很大的样子。形容相差得远，很明显不一样。","source":{"text":"文章古今迥然不同，钟嵘《诗品》以古诗第一，子建次之，此论诚然。","book":"宋·张戒《岁寒堂诗话》卷上"},"example":{"text":"那公子朔虽与寿一母所生，贤愚～。","book":"明·冯梦龙《东周列国志》第十二回"},"similar":["截然不同","大相径庭"],"opposite":["毫无二致","不相上下","一模一样"],"usage":"作谓语、宾语、定语；用于两者之间比较"},{"id":43617,"word":"迥然不群","pinyin":"jiǒng rán bù qún","abbr":"jrbq","explanation":"迥然：相距很远或差别很大的样子；不群：与众不同，不同于流俗。形容超群出众，身手不凡。","source":{"text":"知命之年，有一子，始弱冠矣，隽朗有词藻，迥然不群，深为时辈推伏。","book":"唐·白行简《李娃传》"},"example":{"text":"佳作路头醇正，气势冲沛，辞意雅驯，与往日所见贵国之文～。","book":"明·朱之瑜《朱舜水集·九·与小宅生顺书三十六首（其一）》"},"similar":["与众不同"],"usage":"作谓语、定语；指卓然超绝"},{"id":43618,"word":"迥隔霄壤","pinyin":"jiǒng gé xiāo rǎng","abbr":"jgxr","explanation":"如天上地下之隔。形容相距很远。","source":{"text":"弓也易合，弦也靠怀，不但终身无病，更是日渐精熟，这与托字迥隔霄壤了。","book":"清·李汝珍《镜花缘》第七十九回"},"similar":["迥然不同","天壤之别"],"opposite":["彼此彼此","半斤八两"],"usage":"作谓语、宾语、定语；用于两者之间比较"},{"id":43619,"word":"迩安远怀","pinyin":"ěr ān yuǎn huái","abbr":"eayh","explanation":"迩：近处；怀：怀柔，安抚。使近处的百姓得到安定，使远处的百姓得到安抚。指全国各地人民都能安居乐业。","source":{"text":"至德所覆，迩安远怀。","book":"蔡东藩、许廑父《民国通俗演义》第五十五回"}},{"id":43620,"word":"迩安远至","pinyin":"ěr ān yuǎn zhì","abbr":"eayz","explanation":"谓近居之民以政治清明而欢乐，远地之民则闻风而附。指政治清明。","source":{"text":"叶公问政，子曰：‘近者说，远者来。’","book":"《论语子路》"},"example":{"text":"命我天王建京金陵，一时～。","book":"太平天国周际嗆《建天京于金陵论》"},"similar":["近悦远来"],"usage":"作谓语、定语；指政治局面"},{"id":43621,"word":"迫不及待","pinyin":"pò bù jí dài","abbr":"pbjd","explanation":"迫：紧急。急迫得不能等待。形容心情急切。","source":{"text":"且系酒后游戏，该仙子何以迫不急待。","book":"清·李汝珍《镜花缘》第六回"},"example":{"text":"他～地推开门，走进屋去。"},"similar":["刻不容缓","急不可待"],"opposite":["待机而动"],"usage":"作谓语、状语；形容心情急迫"},{"id":43622,"word":"迫不可待","pinyin":"pò bù kě dài","abbr":"pbkd","explanation":"形容心情急切。同“迫不及待”。","source":{"text":"迫不可待者，即令官吏带银子，按户稽查，量其家大小人口若干，先与银若干，使其度命。","book":"《绿野仙踪》第29回"},"similar":["迫不及待"],"usage":"作谓语、状语；形容心情急迫"},{"id":43623,"word":"迫不得已","pinyin":"pò bù dé yǐ","abbr":"pbdy","explanation":"被逼得没有办法，不得不这样。","source":{"text":"迫不得已然后受诏。","book":"《汉书·王莽传上》"},"example":{"text":"他这样做，完全是～。"},"similar":["无可奈何"],"opposite":["自觉自愿","甘心情愿"],"usage":"作谓语、宾语、定语；指不情愿","story":["北宋时期宋江救了阎婆母女，阎婆把女儿嫁给宋江，宋江并不怎么喜欢阎婆惜，而阎婆惜勾搭上宋江的同事张三，阎婆惜抓住宋江与梁山泊晁盖交往的证据，向宋江索要黄金100两，宋江见阎婆惜铁定心要敲诈他，迫不得已杀了她就上梁山"]},{"id":43624,"word":"迫于眉睫","pinyin":"pò yú méi jié","abbr":"pymj","explanation":"迫：迫近；眉睫：指眼前。形容事情已到眼前，情势十分紧迫。","source":{"text":"远在八荒之外，近在眉睫之内。","book":"《庄子·庚桑楚》：“曰：向吾见若眉睫之间。”《列子·仲尼》"},"example":{"text":"《庄子·庚桑楚》：“曰：向吾见若眉睫之间。”《列子·仲尼》：“远在八荒之外，近在眉睫之内。”"},"similar":["迫在眉睫"],"usage":"作谓语、定语；用于书面语"},{"id":43625,"word":"迫切陈词","pinyin":"pò qiè chén cí","abbr":"pqcc","explanation":"迫切：十分急切；陈：叙说。十分急切地表述自己的观点。","source":{"text":"倘忠言不纳，务逞其穷兵黩武之心，而甘以国家为孤注，则我国民宁与偕亡，断不忍为人鱼肉也。迫切陈词，伫候明教！","book":"蔡东蕃、许廑父《民国通俗演义》第九十六回"},"example":{"text":"爱国爱友，人同此心，～，敬祈明教。","book":"丁中江《北洋军阀史话》一八六"},"usage":"作谓语；用于说话"},{"id":43626,"word":"迫在眉尖","pinyin":"pò zài méi jiān","abbr":"pzmj","explanation":"迫：紧迫；眉：眉毛。形容事情已到眼前，情势十分紧迫。","source":{"text":"因为他看见他的危险处境迫在眉尖。","book":"路遥《平凡的世界》第一卷第18章"},"similar":["迫在眉前","迫在眉睫"],"usage":"作谓语、定语；用于书面语"},{"id":43627,"word":"迫在眉睫","pinyin":"pò zài méi jié","abbr":"pzmj","explanation":"形容事情已到眼前，情势十分紧迫。","source":{"text":"远在八荒之外，近在眉睫之内。","book":"《庄子·庚桑楚》：“曰：向吾见若眉睫之间。”《列子·仲尼》"},"example":{"text":"新的内战危机忽然又～了。","book":"方纪《挥手之间》"},"similar":["火烧眉毛","急如星火"],"opposite":["远在天边","慢条斯理"],"usage":"作谓语、定语；用于书面语"},{"id":43628,"word":"迭为宾主","pinyin":"dié wéi bīn zhǔ","abbr":"dwbz","explanation":"轮流做主人请客。","source":{"text":"有时迭为宾主，不过清茶寡饭，不设酒肴，以此为常。","book":"明·冯梦龙《醒世恒言》第九卷"},"example":{"text":"我们几个单身汉～，轮流请吃，打发时光。"},"similar":["迭为主宾"],"usage":"作谓语、定语；用于交往"},{"id":43629,"word":"迭嶂层峦","pinyin":"dié zhàng céng luán","abbr":"dzcl","explanation":"嶂：形势高险像屏障的山。层：重。峦：就是连着的山。形容山峦重叠，连绵不断。","source":{"text":"迭嶂层峦，点点苍苔铺翡翠。","book":"明·冯梦龙《醒世恒言》卷二十九"}},{"id":43630,"word":"迭床架屋","pinyin":"dié chuáng jià wū","abbr":"dcjw","explanation":"床上安床，屋下架屋。比喻重复、累赘","source":{"text":"讲到成语，有些人的脑子里不是没有若干成语，但是用起来，迭床架屋，拖泥带水。","book":"邹韬奋《经历·外国文和外国教师》"},"similar":["叠床架屋"],"usage":"作谓语、定语；指累赘"},{"id":43631,"word":"迭矩重规","pinyin":"dié jǔ chóng guī","abbr":"djcg","explanation":"规与规相重，矩矩与相迭，度数相同，完全符合。原比喻动静合乎法度或上下相合，后形容模仿、重复。","source":{"text":"君臣协美于朝，黎庶欣戴于野，动若重规，静若迭矩。","book":"《三国志·蜀书·郄正传》"},"example":{"text":"因先生之言，以读先生之书，如～，毫厘不失，灼然与才子之笔，分路而扬镳。","book":"清·纪昀《阅微草堂笔记·姑妄听之四》"}},{"id":43632,"word":"迭见杂出","pinyin":"diē jiàn zá chū","abbr":"djzc","explanation":"重复错杂出现。","source":{"text":"今民穷财殚，府藏虚罄，水旱盗贼，星象草木之变迭见杂出，万一祸生不测，国无老成，谁与共事。","book":"《明史·刘菃传》"}},{"id":43633,"word":"述而不作","pinyin":"shù ér bù zuò","abbr":"sebz","explanation":"述：阐述前人学说；作：创作。指只叙述和阐明前人的学说，自己不创作。","source":{"text":"述而不作，信而好古，窃比我于老彭。","book":"《论语·述而》"},"example":{"text":"～，信而好古，夫岂以其圣而傲当世哉。","book":"清·朱彝尊《刘永之传》"},"similar":["人云亦云","照本宣科"],"opposite":["别开生面","独树一帜"],"usage":"作谓语、宾语、定语；用于人"},{"id":43634,"word":"迷不知归","pinyin":"mí bù zhī guī","abbr":"mbzg","explanation":"迷：分辨不清。犯了错误却不知悔改。","source":{"text":"矛盾自相，迷不知归，以窘人者自窘。","book":"田北湖《与某生论韩文书》"},"similar":["执迷不悟"],"opposite":["迷而知反"],"usage":"作谓语、定语；用于不知改过"},{"id":43635,"word":"迷人眼目","pinyin":"mí rén yǎn mù","abbr":"mrym","explanation":"迷惑他人视线，使人分辨不清。指耍花招欺骗人。","source":{"text":"这些人也是敌人的第五纵队，不过比前一种稍具形式上的区别，借以伪装自己，迷人眼目而已。","book":"毛泽东《质问国民党》"},"usage":"作谓语、定语；指耍花招欺骗人"},{"id":43636,"word":"迷天大罪","pinyin":"mí tiān dà zuì","abbr":"mtdz","explanation":"形容极大的罪恶。","source":{"text":"纵有那弥天罪，也难赎。","book":"元·无名氏《谢金吾》第四折"},"example":{"text":"你在沧州做下～，却在这里。","book":"明·施耐庵《水浒全传》第十一回"},"similar":["弥天大罪"],"opposite":["盖世之功"],"usage":"作主语、宾语、定语；指极大的罪恶"},{"id":43637,"word":"迷天大谎","pinyin":"mí tiān dà huǎng","abbr":"mtdh","explanation":"迷：通“弥”。极大的谎话。","source":{"text":"她这临时诌起来的谎居然合式，她心里更加有把握了。她决定把这迷天大谎再推进一些。","book":"茅盾《子夜》"},"similar":["弥天大谎"],"opposite":["肺腑之言"],"usage":"作宾语；形容非常荒谬的谎言"},{"id":43638,"word":"迷头认影","pinyin":"mí tóu rèn yǐng","abbr":"mtry","explanation":"佛家语。形容非常糊涂。","source":{"text":"如演若多，迷头认影。","book":"《大佛顶如来密因修证了义诸菩萨万行首楞言经》"},"example":{"text":"言中取则，句里明机，也似～。","book":"宋·释普济《五灯会元》卷十二"},"similar":["认影迷头"],"usage":"作谓语、定语；指人糊涂"},{"id":43639,"word":"迷恋骸骨","pinyin":"mí liàn hài gǔ","abbr":"mlhg","explanation":"迷恋：过度爱好而难以舍弃；骸骨：尸骨。迷恋着尸骨。比喻舍不得丢弃陈旧腐朽的事物。","example":{"text":"最可怕的是，倡言守旧，其实只是～；唯新是骛，其实只是摭拾皮毛，那就是新旧之间两具失之了。","book":"梁实秋《旧》"},"usage":"作宾语、定语；用于书面语"},{"id":43640,"word":"迷惑不解","pinyin":"mí huò bù jiě","abbr":"mhbj","explanation":"指对谋事非常疑惑，很不理解。同“大惑不解”。","source":{"text":"大惑者终身不解，大愚者终身不灵。","book":"《庄子·天地》"},"example":{"text":"在这些个难以成眠的夏夜，他的脑子里纷乱如云，驰过这些往事和～的疑团。","book":"肖复兴《啊，老三届》一"},"similar":["疑疑惑惑","疑惑不解"],"usage":"作谓语、定语；用于处事"},{"id":43641,"word":"迷惑视听","pinyin":"mí huò shì tīng","abbr":"mhst","explanation":"使人耳目迷乱。比喻以错误的言论欺骗社会，毒害群众。","example":{"text":"这是因为当时我们毕竟还不敢公然承认我们主张实行法西斯主义，还是觉得抱着三民主义这块招牌较能～。","book":"萧作霖《复兴社述略》"},"usage":"作谓语、定语、宾语；用于言行等"},{"id":43642,"word":"迷涂知反","pinyin":"mí tú zhī fǎn","abbr":"mtzf","explanation":"比喻犯了错误能改正。同“迷途知反”。"},{"id":43643,"word":"迷留没乱","pinyin":"mí liú mò luàn","abbr":"mlml","explanation":"迷乱而没有头绪。","source":{"text":"着小生迷留没乱，心痒难挠。","book":"元·王实甫《西厢记》第一本第四折"},"example":{"text":"俺心中正～的，恰才天色已晚，是谁在门外叫门。","book":"明·冯惟敏《僧尼共犯》第一折"},"usage":"作谓语；指人的心情"},{"id":43644,"word":"迷离徜仿","pinyin":"mí lí cháng fǎng","abbr":"mlcf","explanation":"形容模糊而难以分辨清楚。同“迷离惝恍”。"},{"id":43645,"word":"迷离徜彷","pinyin":"mí lí cháng fǎng","abbr":"mlcp","explanation":"模糊不明。","example":{"text":"这个～的观点，我们不予采纳。"},"usage":"作谓语、定语、状语；用于书面语"},{"id":43646,"word":"迷离徜恍","pinyin":"mí lí cháng huǎng","abbr":"mlch","explanation":"形容模糊而难以分辨清楚。同“迷离惝恍”。"},{"id":43647,"word":"迷离恍惚","pinyin":"mí lí huǎng hū","abbr":"mlhh","explanation":"迷离：模糊，不分明；惝恍：不真切，不清楚。形容模糊而难以分辨清楚。","source":{"text":"庭中一半似银海一般的白，一半却迷离惝恍，摇曳着桐叶的黑影。","book":"曾朴《孽海花》"},"example":{"text":"城市街头～的霓虹灯光十分漂亮。"},"similar":["扑朔迷离"],"opposite":["一目了然"],"usage":"作谓语、状语、定语；形容事物"},{"id":43648,"word":"迷离惝恍","pinyin":"mí lí chǎng huǎng","abbr":"mlch","explanation":"迷离：模糊，不分明；惝恍：不真切，不清楚。形容模糊而难以分辨清楚。","source":{"text":"惟留二百余金，恰足两月余酒食费，一定迷离惝恍，如梦乍回。","book":"清·纪昀《阅微草堂笔记·槐西杂志三》"},"example":{"text":"庭中一半似银海一般的白，一半却～，摇曳着桐叶的黑影。（清·曾朴《孽海花》第四回）"},"similar":["模糊不清"],"usage":"作状语、定语；形容模糊而难以分辨清楚"},{"id":43649,"word":"迷离扑朔","pinyin":"mí lí pū shuò","abbr":"mlps","explanation":"形容事情错综复杂，难以辨别清楚。","source":{"text":"雄兔脚扑朔，雌兔眼迷离，双兔傍地走，安能辨我是雄雌！","book":"南宋·郭茂倩《乐府诗集·横吹曲辞五·木兰诗》"},"example":{"text":"惊追逐，回头一顾，～。","book":"陈毅《满江红·游广东……》词"},"similar":["迷离恍惚","扑朔迷离"],"opposite":["泾渭分明"],"usage":"作谓语、定语、补语；用于男女不分的场合"},{"id":43650,"word":"迷离马虎","pinyin":"mí lí mǎ hǔ","abbr":"mlmh","explanation":"糊里糊涂。","example":{"text":"你不能再这样～地过日子。"},"usage":"作定语、状语；用于口语"},{"id":43651,"word":"迷而不反","pinyin":"mí ér bù fǎn","abbr":"mebf","explanation":"迷路后不知回来。比喻犯了错误不知改正。","source":{"text":"若偷安旦夕，迷而不反，大兵一发，玉石皆碎。","book":"晋·陈寿《三国志·魏志·钟会传》"},"example":{"text":"主客倒置，～，惑而不解。","book":"宋·陆九渊《与曾宅之书》"},"similar":["迷而不返"],"opposite":["迷途知返"],"usage":"作谓语、宾语；指知错不改"},{"id":43652,"word":"迷而不返","pinyin":"mí ér bù fǎn","abbr":"mebf","explanation":"迷路后不知回来。比喻犯了错误不知改正。","source":{"text":"若使迷而不返，遂而不改，则戎狄蛮夷将有诮让之言。","book":"汉·王粲《为刘表与袁尚书》"},"example":{"text":"况奸回暴露，而复不罢，是衮阙不补，～也。","book":"晋·陈寿《三国志·魏志·程晓传》"},"similar":["迷而不反"],"opposite":["迷途知返"],"usage":"作谓语、宾语；指知错不改"},{"id":43653,"word":"迷而知反","pinyin":"mí ér zhī fǎn","abbr":"mezf","explanation":"迷路后知道回来。比喻有了过失能够改正。","source":{"text":"若迷而知反，尚可以免。","book":"晋·陈寿《三国志·魏志·袁术传》"},"similar":["迷而知返"],"opposite":["迷而不返"],"usage":"作谓语、宾语；指知错就该"},{"id":43654,"word":"迷而知返","pinyin":"mí ér zhī fǎn","abbr":"mezf","explanation":"迷路后知道回来。比喻有了过失能够改正。","source":{"text":"所以淹霆缓电者，犹冀弟迷而知返耳。","book":"《宋书·二凶传·元凶劭》"},"similar":["迷而知反","迷途知返"],"opposite":["迷而不返"],"usage":"作谓语、宾语；指知错就该"},{"id":43655,"word":"迷花恋柳","pinyin":"mí huā liàn liǔ","abbr":"mhll","explanation":"迷：沉迷。挑逗异性或嫖娼。","source":{"text":"然尊大人所心怒兄者，不过为迷花恋柳，挥金如土。","book":"明·冯梦龙《警世通言》第32卷"},"similar":["迷花沾草"],"usage":"作谓语、宾语；用于男性"},{"id":43656,"word":"迷花沾草","pinyin":"mí huā zhān cǎo","abbr":"mhzc","explanation":"指拈花惹草。","source":{"text":"休只为迷花沾草，断送了美身躯。","book":"明·孟称舜《娇红记·双逝》"},"similar":["拈花惹草","迷花恋柳"],"usage":"作谓语、宾语；指拈花惹草"},{"id":43657,"word":"迷花眼笑","pinyin":"mí huā yǎn xiào","abbr":"mhyx","explanation":"形容非常欢快、喜悦。","source":{"text":"那太监喜得迷花眼笑，也不更数，把袋里的钱都倒出来，给与翠莲。","book":"清·夏敬渠《野叟曝言》第25回"},"similar":["眉开眼笑"],"usage":"作定语、状语；用于高兴时"},{"id":43658,"word":"迷踪失路","pinyin":"mí zōng shī lù","abbr":"mzsl","explanation":"指迷失了道路。","source":{"text":"此人乃是张良，忠孝双全，迷踪失路。","book":"元·李文蔚《张子房圯桥进履》第一折"},"example":{"text":"来到这半路途中，寻不着宿处，可怎生～，天晚了也。","book":"明·无名氏《闹钟馗》第一折"}},{"id":43659,"word":"迷迷惑惑","pinyin":"mí mí huò huò","abbr":"mmhh","explanation":"心神迷乱，辨不清是非。","source":{"text":"彼时宝玉迷迷惑惑，若有所失。众人忙端上桂圆汤来，呷了两口，遂起身整衣。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"清·李汝珍《镜花缘》第45回：“俺自闻了这股果香，心里～，只顾想吃，那里还顾甚么妖怪！”"},"opposite":["一清二楚"],"usage":"作谓语、定语、状语；指不清醒"},{"id":43660,"word":"迷迷糊糊","pinyin":"mí mí hú hú","abbr":"mmhh","explanation":"使人混乱烦躁迷惑不清，使浑浊不清。","source":{"text":"车门已硼的关上了，弄得彩云迷迷糊糊，又惊又吓。","book":"曾朴《孽海花》第12回"},"example":{"text":"我喝酒之后头部一直是～的。"},"similar":["昏昏沉沉"],"opposite":["清清楚楚"],"usage":"作谓语、定语、状语；指不清晰"},{"id":43661,"word":"迷迷荡荡","pinyin":"mí mí dàng dàng","abbr":"mmdd","explanation":"晃悠貌，摇荡的样子。"},{"id":43662,"word":"迷途失偶","pinyin":"mí tú shī ǒu","abbr":"mtso","explanation":"迷途：迷失道路；偶：伴侣。迷失了道路，丢失了朋友。指遭到不幸或陷于孤独。","source":{"text":"慌若迷途失偶，黡如深夜扩撤烛。","book":"南朝·宋·颜延之《庭诰文》"},"example":{"text":"～，恸不及悲。","book":"《南齐书·褚渊传》"},"usage":"作宾语、定语；用于不佳的处境"},{"id":43663,"word":"迷途知反","pinyin":"mí tú zhī fǎn","abbr":"mtzf","explanation":"迷途：迷路；反：反回。迷了路知道回来。比喻犯了错误能改正。","source":{"text":"夫迷途知反，往哲是与。","book":"《南史·陈伯之传》"},"example":{"text":"一个人要～、知错必改。"},"similar":["迷途知返","迷而知返"],"opposite":["迷而不返"],"usage":"作谓语、定语；指知错就该","story":["南朝齐刺史陈伯之在齐灭亡后并没有被梁武帝萧衍撤换，他在部下邓缮的唆使下起兵反梁被梁军打败，就投降了北魏，当了平南将军进攻梁。萧衍的弟弟萧宏奉命北伐，在寿阳对峙，萧宏为争取陈伯之，叫丘迟给他写信劝他迷途知反"]},{"id":43664,"word":"迷途知返","pinyin":"mí tú zhī fǎn","abbr":"mtzf","explanation":"迷途：迷失道路；返：回来。迷了路知道回来。比喻发觉自己犯了错误，知道改正。","source":{"text":"以身试祸，岂不痛哉！若迷而知反，尚可以免。","book":"《三国志·魏志·袁术传》"},"example":{"text":"夫～，往哲是也。","book":"南朝·梁·丘迟《与陈伯之书》"},"similar":["悬崖勒马"],"opposite":["执迷不悟"],"usage":"作谓语、定语；指知错就该","story":["东汉末年，黄巾起义几乎推翻了汉朝，袁术占据南阳，过上奢华的生活。董卓被袁绍和曹操打败，袁术见汉室岌岌可危，写信给朋友陈，希望帮他称帝。陈回信说你已走上迷路，如果知道回返，就可避免一场灾难。袁术称帝被吕布打败"]},{"id":43665,"word":"迷途羔羊","pinyin":"mí tú gāo yáng","abbr":"mtgy","explanation":"迷途：迷失了方向、路途。比喻犯错误、一时失足的年轻人。"},{"id":43666,"word":"迷金醉纸","pinyin":"mí jīn zuì zhǐ","abbr":"mjzz","explanation":"犹言纸醉金迷。形容叫人沉迷的奢侈繁华环境。","source":{"text":"迷金醉纸开芳宴，豹舌熊蹯尝几遍。","book":"清·黄树仁《序》"},"similar":["纸醉金迷"],"usage":"作谓语、定语；指奢华糜烂的生活"},{"id":43667,"word":"迷魂夺魄","pinyin":"mí hún duó pò","abbr":"mhdp","explanation":"形容事物美好，使人醉迷。同“迷魂淫魄”。","source":{"text":"飘飘然如入神仙洞府，迷魂夺魄，不自知其在人间矣。","book":"明·冯梦龙《东周列国志》第六十八回"},"similar":["迷魂淫魄"],"usage":"作定语、宾语；多指美好的事物"},{"id":43668,"word":"迷魂汤","pinyin":"mí hún tāng","abbr":"mht","explanation":"比喻迷惑人的语言或行为。","source":{"text":"使了些巧心机，那里有真情实意。迷魂汤滋味美，纸汤瓶热火猥。","book":"《全元散曲·点绛唇·赠妓》"},"example":{"text":"'你甭给我灌～哩！'梁三老汉严肃地警觉着自己不被软化。","book":"柳青《创业史》第一部第17章"},"similar":["迷魂药"],"usage":"作宾语；比喻迷惑人的语言或行为"},{"id":43669,"word":"迷魂淫魄","pinyin":"mí hún yín pò","abbr":"mhyp","explanation":"迷人魂、乱人魄。形容事物美好，使人醉迷。","source":{"text":"师延乃更奏迷魂淫魄之曲，以欢修夜之娱。","book":"晋·王嘉《拾遗记·殷汤》"},"similar":["迷魂夺魄"],"usage":"作定语、宾语；指美好的事物"},{"id":43670,"word":"迷魂阵","pinyin":"mí hún zhèn","abbr":"mhz","explanation":"比喻使人迷惑而上当的圈套、计谋。","source":{"text":"岂是风流胜可争？迷魂阵里出奇兵。","book":"元·无名氏《云窗梦》第二折：“三停刀砍不断黄桑棍，九稍炮不破迷魂阵。”明·施耐庵《水浒传》第二十四回"},"example":{"text":"弟兄四个，都得异人传授，颇有妖术。关前各设“～”一座，极其利害。因此四方闻风而惧。","book":"清·李汝珍《镜花缘》第三回"},"usage":"作宾语、定语；指让人上当的圈套"},{"id":43671,"word":"追云逐电","pinyin":"zhuī yún zhú diàn","abbr":"zyzd","explanation":"极言迅疾。","source":{"text":"毕竟是张力人精选的好马，果然是四足生风，追云逐电。","book":"任光椿《戊戌喋血记》第三章十四"},"example":{"text":"我想有一匹～的马"},"similar":["追风逐电"],"usage":"作定语、状语；多用于比喻句"},{"id":43672,"word":"追亡逐北","pinyin":"zhuī bēn zhú běi","abbr":"zwzb","explanation":"追击败走的敌军。","source":{"text":"追亡逐北，伏尸百万。","book":"汉·贾谊《过秦论》"},"example":{"text":"因驱走之，～，径至夹石，斩获万余。","book":"晋·陈寿《三国志·吴志·陆逊传》"},"similar":["追奔逐北"],"usage":"作谓语；指追击败走的敌军"},{"id":43673,"word":"追亡逐遁","pinyin":"zhuī wáng zhú dùn","abbr":"zwzd","explanation":"追击败逃的敌人。同“追亡逐北”。","source":{"text":"器成教施，追亡逐遁若飘风，击刺若雷电。","book":"《管子·兵法》"},"similar":["追亡逐北","追奔逐北"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":43674,"word":"追名逐利","pinyin":"zhuī míng zhú lì","abbr":"zmzl","explanation":"追：追求。追求名和利。","source":{"text":"臣闻争名者于朝，争利者于市。","book":"《战国策·秦策一》"},"example":{"text":"目前江南士大夫仍是往年习气，到处结社，互相标榜，～。","book":"姚雪垠《李自成》第二卷第十七章"}},{"id":43675,"word":"追奔逐北","pinyin":"zhuī bēn zhú běi","abbr":"zbzb","explanation":"追击败走的敌军。","source":{"text":"然犹斩将搴旗，追奔逐北，灭迹扫尘，斩其枭帅。","book":"汉·贾谊《过秦论》：“追亡逐北，伏尸百万。”汉·李陵《答苏武书》"},"example":{"text":"他的精锐马队，又来自大漠，～，是其所长。","book":"高阳《玉座珠帘》上册"},"similar":["追亡逐北"],"usage":"作谓语；指追击败走的敌军"},{"id":43676,"word":"追悔不及","pinyin":"zhuī huǐ bù jí","abbr":"zhbj","explanation":"悔恨过去的往事，却已无法挽回了。","source":{"text":"上大怒，命左右杀之。既而追悔不及，因下诏罪状之。","book":"《北史·史万岁传》"},"example":{"text":"黄妃言罢，殷郊与殷洪～。","book":"明·许仲琳《封神演义》第八回"},"similar":["追悔何及","追悔无及"],"usage":"作谓语、定语；用于处事"},{"id":43677,"word":"追悔何及","pinyin":"zhuī huǐ hé jí","abbr":"zhhj","explanation":"悔恨以往的事情，但已无法改变了。亦作“追悔不及”。","source":{"text":"世上之人，多嗜欲伤生伐命，今古共焉；不早自防，追悔何及？","book":"《旧五代史·庄宗本纪八》：“将士经年离隔父母，不取敕旨归宁，上贻圣忧，追悔何及！”宋·张君房《云笈七签·慎守诀》"},"example":{"text":"一旦武王失恃，那时被擒，身弑国亡，遗机万世，～。","book":"明·许仲琳《封神演义》第八十一回"},"similar":["追悔不及","追悔无及"],"usage":"作谓语、定语；用于处事"},{"id":43678,"word":"追悔无及","pinyin":"zhuī huǐ wú jí","abbr":"zhwj","explanation":"悔恨过去的往事，却经已来不及了。","source":{"text":"不唯上挠圣怀，亦使天下闻而不平，人心一离，不可复收，陛下他日追悔无及。","book":"宋·苏轼《听政札子》"},"example":{"text":"再令左右四出侦察，遍求至三日有余，方闻他已往列人，～，徒唤奈何！","book":"蔡东藩《两晋演义》第六十八回"},"similar":["追悔何及","追悔不及"],"usage":"作谓语、定语；用于处事"},{"id":43679,"word":"追悔莫及","pinyin":"zhuī huǐ mò jí","abbr":"zhmj","explanation":"后悔也来不及了。","source":{"text":"夫以人之死争胜，跌而不振，则悔之亡及也。","book":"汉·晁错《上书言兵事》"},"example":{"text":"事情已经过去，我们～。"},"similar":["悔之晚矣","悔不当初","徒唤奈何"],"opposite":["悬崖勒马","回头是岸","迷途知返"],"usage":"作谓语、宾语；指人后悔"},{"id":43680,"word":"追本求源","pinyin":"zhuī běn qiú yuán","abbr":"zbqy","explanation":"追：追究；本：根本；求：探求。追究事情发生的根源。","source":{"text":"其能发明先贤旨意，溯流徂源，论著讲介卓然自为一家者，惟广汉张氏敬夫、东莱吕氏伯恭、新安朱氏元晦而已。","book":"宋·周密《齐东野语·道学》"},"example":{"text":"～，于是想严查鸦片，禁止入口。","book":"清·黄小配《洪秀全演义》第二回"},"similar":["追本穷源","追本溯源","追根查源"],"usage":"作谓语、宾语；指追查根源"},{"id":43681,"word":"追本溯源","pinyin":"zhuī běn sù yuán","abbr":"zbsy","explanation":"本：根本；溯：探求。追究根本，探索源头，比喻追寻根源。","source":{"text":"说到这八座模型，追本溯源，不能不提到北洋政府时的总长朱启钤。","book":"石三友《金陵野史·圆明园与基泰工程司》"},"example":{"text":"我们～，终于发现问题所在。"},"similar":["追根究底","顺藤摸瓜"],"opposite":["浅尝辄止","浮光掠影","走马观花"],"usage":"作谓语、宾语、状语；指追寻根源"},{"id":43682,"word":"追本穷源","pinyin":"zhuī běn qióng yuán","abbr":"zbqy","explanation":"穷：寻求到尽头。追究事情发生的根源。","source":{"text":"果然追本穷源，查鸦片进口，都有华商发售。","book":"《洪秀全演义》第二回"},"example":{"text":"《洪秀全演义》第二回：“果然～，查鸦片进口，都由华商发售。”"},"similar":["追本溯源"],"usage":"作谓语、宾语；指追查根源"},{"id":43683,"word":"追根刨底","pinyin":"zhuī gēn pao dǐ","abbr":"zgpd","explanation":"追究底细。一般指追究事情的原由。","example":{"text":"他爱～，我被他弄烦了。"},"similar":["寻根究底","追根究底","追根问底"],"usage":"作谓语、宾语、状语；指查根由"},{"id":43684,"word":"追根寻底","pinyin":"zhuī gēn xún dǐ","abbr":"zgxd","explanation":"追究底细。同“追根究底”。","source":{"text":"若是追根寻底，一定会牵涉到白玉梅身上来。","book":"沙陆墟《魂断梨园》第二十九回"},"similar":["追根究底","追根问底"],"usage":"作谓语、宾语、状语；指查根由"},{"id":43685,"word":"追根查源","pinyin":"zhuī gēn chá yuán","abbr":"zgcy","explanation":"指追溯事物发生的根源。同“追本溯源”。","source":{"text":"而眼下，在群众追根查源的时候，或者说对曾番有所怀疑的时候，曾番自然要来个搅浑水。","book":"木青《不许收获的秋天》第二一章"},"similar":["追根溯源","追本求源","追根求源"],"usage":"作谓语、宾语；指追查根源"},{"id":43686,"word":"追根求源","pinyin":"zhuī gēn qiú yuán","abbr":"zgqy","explanation":"指追溯事物发生的根源。同“追本溯源”。","source":{"text":"追根求源，倒溯黑幕，岑长进现出了面目。","book":"张周《步履艰难的中国》第四章"},"example":{"text":"考古工作靠的就是～。"},"similar":["追本溯源","追根溯源","追本求源"],"usage":"作谓语、宾语、状语；指追寻根源"},{"id":43687,"word":"追根溯源","pinyin":"zhuī gēn sù yuán","abbr":"zgsy","explanation":"指追溯事物发生的根源。同“追本溯源”。","source":{"text":"其实，若追根溯源，他还是为了使自己更能堂堂正正地搬进市长楼，而不至于落个将前人卸磨杀驴、扫地出门的恶名。","book":"晓剑《本市市长无房住》"},"similar":["追本溯源","追根求源","追根穷源"],"usage":"作谓语、宾语；指追查根源"},{"id":43688,"word":"追根究底","pinyin":"zhuī gēn jiū dǐ","abbr":"zgjd","explanation":"追究根底。一般指追问一件事的原由。","source":{"text":"你们这些做新闻记者的，就是喜欢这样追根究底地问。","book":"洪深《飞将军》"},"example":{"text":"我们一定要～，把它弄清楚。"},"similar":["追本溯源","顺藤摸瓜","追本求源"],"opposite":["浅尝辄止","浮光掠影","走马观花"],"usage":"作谓语、宾语、状语；指查根由"},{"id":43689,"word":"追根究蒂","pinyin":"zhuī gēn jiū dì","abbr":"zgjd","explanation":"追究底细。同“追根究底”。","source":{"text":"追根究蒂，知道是我们父女所为，便要想替他报仇。","book":"惜红馆主《续啼笑因缘》第八回"},"similar":["追根究底","追根寻底","追根问底"],"usage":"作谓语、宾语、状语；指查根由"},{"id":43690,"word":"追根穷源","pinyin":"zhuī gēn qióng yuán","abbr":"zgqy","explanation":"指追溯事物发生的根源。同“追本溯源”。","source":{"text":"原来家树、凤喜这头婚姻，追根穷源，自然不能不归功于寿峰父女。","book":"惜红馆主《续啼笑因缘》第三十七回"},"similar":["追根溯源","追本溯源","追根求源"],"usage":"作谓语、宾语；指追查根源"},{"id":43691,"word":"追根问底","pinyin":"zhuī gēn wèn dǐ","abbr":"zgwd","explanation":"追究底细。同“追根究底”。","source":{"text":"至于后来那水车问题，他也实在说的毫无漏洞，但老来旺一伙竟非要拧住他追根问底！","book":"康濯《春种秋收·三面宝镜》"},"example":{"text":"他有～的决心，一定会弄明白的"},"similar":["追根究底","寻根究底","追根刨底"],"usage":"作谓语、宾语、状语；指查根由"},{"id":43692,"word":"追欢买笑","pinyin":"zhuī huān mǎi xiào","abbr":"zhmx","explanation":"追求欢乐。多指狎妓饮酒之类。","source":{"text":"遇良辰，当美景，追欢买笑。","book":"宋·柳永《传花枝》词"},"example":{"text":"［贾珍］便约了贾琏去～，不在话下。","book":"清·曹雪芹《红楼梦》第五十四回"},"usage":"作谓语、宾语、定语；指狎妓"},{"id":43693,"word":"追欢作乐","pinyin":"zhuī huān zuò lè","abbr":"zhzl","explanation":"犹言寻欢作乐。同“追欢取乐”。","source":{"text":"琼英，你到那里，好生追欢作乐，务要丞相欢喜。","book":"元·王实甫《丽春堂》第三折"},"example":{"text":"～笑颜开，不念危亡半点哀。","book":"明·罗贯中《三国演义》第一百十九回"},"similar":["追欢取乐"],"usage":"作谓语、宾语、定语；多用于男性"},{"id":43694,"word":"追欢卖笑","pinyin":"zhuī huān mài xiào","abbr":"zhmx","explanation":"指出卖色情，供人取乐。","source":{"text":"从俺爹爹丧过，宦囊萧索，日穷一日，直弄到我一个亲女儿出身为娼，追欢卖笑。","book":"明·徐渭《翠乡梦》第二出"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":43695,"word":"追欢取乐","pinyin":"zhuī huān qǔ lè","abbr":"zhql","explanation":"犹言寻欢作乐。","source":{"text":"何况徽宗是个风流快活的官家，目见帝都景致，怎不追欢取乐。","book":"《宣和逸事》前集"},"example":{"text":"话说温如玉住在郑三家中，也顾不得他母孝服未满，人情天理上何如，一味要～。","book":"《绿野仙踪》第四十四回"},"similar":["追欢作乐"],"usage":"作谓语、宾语、定语；多用于男性"},{"id":43696,"word":"追趋逐耆","pinyin":"zhuī qū zhú shì","abbr":"zqzs","explanation":"指追逐时尚。","source":{"text":"追趋逐耆，随所趋向爱耆而追逐之也。趋，读趣，耆，读嗜。","book":"《汉书·扬雄传下》：“今夫弦者，高张急徽，追趋逐耆，则坐者不期而附矣；试为之施《咸池》，揄《六茎》，发《萧韶》，咏《九成》，则莫有和也。”颜师古注"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":43697,"word":"追踪觅影","pinyin":"zhuī zōng mì yǐng","abbr":"zzmy","explanation":"顺着踪迹追寻。","source":{"text":"都在灯市里穿来插去，寻香哄吃，追踪觅影，调情绰趣，何尝真心看灯。","book":"清·褚人获《隋唐演义》第十八回"},"usage":"作谓语、定语；用于处事"},{"id":43698,"word":"追踪问迹","pinyin":"zhuī zōng wèn jì","abbr":"zzwj","explanation":"追寻踪迹。","source":{"text":"阳台梦杳，苦追踪问迹，似无还有。","book":"明·胡文焕《群音类选·陈秋碧〈梧桐树〉》"},"usage":"作谓语、定语；用于处事"},{"id":43699,"word":"追远慎终","pinyin":"zhuī yuǎn shèn zhōng","abbr":"zysz","explanation":"犹言慎终追远。","source":{"text":"夫追远慎终，抑闻前诰。","book":"《陈书·南康愍王昙郎传》"},"example":{"text":"出家僧众，制无号哭，父母亡丧，诵念酬恩，～，实资冥福。","book":"唐玄奘《大唐西域记·印度总述》"},"similar":["慎终追远","谨终追远","慎终思远"],"usage":"作谓语、宾语；指旧的礼法"},{"id":43700,"word":"追风捕影","pinyin":"zhuī fēng bǔ yǐng","abbr":"zfby","explanation":"追寻风、捕捉影子。比喻追寻虚空的东西。","source":{"text":"祭遇者拾芥拈芹，似我时追风捕影。","book":"明·胡文焕《群音类选·五子登科记·祭头巾》"},"similar":["追风觅影"],"usage":"作宾语、定语；用于书面语"},{"id":43701,"word":"追风掣电","pinyin":"zhuī fēng chè diàn","abbr":"zfcd","explanation":"形容速度极快。多指马飞速奔驰。同“追风逐电”。","source":{"text":"愿得侧翅附鸿鹄，追风掣电凌太空。","book":"宋·张淏《云谷杂记·侍郎徐公帖》"},"example":{"text":"这千里马如～般驰骋，几小时就到了邺城"},"similar":["追风逐电","逐电追风","追风逐日"],"usage":"作宾语、定语；用于书面语"},{"id":43702,"word":"追风摄景","pinyin":"zhuī fēng niè jǐng","abbr":"zfsj","explanation":"形容马行疾速。蹑，一本作“摄”。同“追风蹑景”。","source":{"text":"假令奋翅则能凌厉玄霄，骋足则能追风蹑景。","book":"晋·葛洪《抱朴子·内篇序》"},"example":{"text":"这马～般地奔向海城"},"similar":["追风蹑影","追风逐影","追风蹑景"],"usage":"作宾语、状语；用于比喻句"},{"id":43703,"word":"追风觅影","pinyin":"zhuī fēng mì yǐng","abbr":"zfmy","explanation":"追寻如风、影那样虚空的东西。","source":{"text":"跋涉沧溟，才度灜蓬瀛，真乃是追风觅影。","book":"明·无名氏《三化邯郸》第四折"},"similar":["追风捕影"],"usage":"作宾语、定语；用于书面语"},{"id":43704,"word":"追风蹑影","pinyin":"zhuī fēng niè yǐng","abbr":"zfny","explanation":"形容马行疾速。同“追风蹑景”。","source":{"text":"风驰电逝，蹑景追风。","book":"三国·魏·阮籍《赠兄秀才入军》诗"},"example":{"text":"是好马，那竹批双耳镜夹双曈，天没权奇，～，小生虽令鸿章，敢扬骏骑。","book":"明·梅鼎祚《玉合记·赠处》"},"similar":["追风蹑景","追风摄景","追风逐影"],"usage":"作宾语、状语；用于比喻句"},{"id":43705,"word":"追风蹑景","pinyin":"zhuī fēng niè jǐng","abbr":"zfnj","explanation":"形容速度极快。","source":{"text":"奋翅则能凌厉玄霄，骋足则能追风蹑景。","book":"《抱朴子·内篇序》"},"example":{"text":"清·郎廷槐《师友诗传录》：“七言古若李太白、杜子美、韩退之三家，横绝万古；后之～，惟苏长公一人而已。”"},"similar":["追风蹑影","追风摄影"],"usage":"作宾语、状语；用于比喻句"},{"id":43706,"word":"追风逐影","pinyin":"zhuī fēng zhú yǐng","abbr":"zfzy","explanation":"形容马行疾速。同“追风蹑景”。","source":{"text":"追风逐影古来有，大宛渥洼君知否？","book":"明·陈子龙《献马行》"},"similar":["追风蹑景","追风摄景"],"usage":"作宾语、状语；用于比喻句"},{"id":43707,"word":"追风逐日","pinyin":"zhuī fēng zhú rì","abbr":"zfzr","explanation":"形容速度极快。多指马飞速奔驰。同“追风逐电”。","source":{"text":"励衔策而追风逐日，加剪拂则绝电奔星。","book":"唐·杨炯《后周明威将军梁公神道碑》"},"similar":["追风掣电","追风逐电","逐电追风"],"usage":"作宾语、状语；用于比喻句"},{"id":43708,"word":"追风逐电","pinyin":"zhuī fēng zhú diàn","abbr":"zfzd","explanation":"形容速度极快。多指马飞速奔驰。","source":{"text":"故孔方諲之相马也，虽未追风逐电，绝尘灭影，而迅足之势固已见矣。","book":"北齐·刘昼《新论·知人》"},"example":{"text":"山风忽起，那狮子～似的，追那些虎狼去了。","book":"清·陈天华《狮子吼》楔子"},"similar":["追风逐日","逐电追风","追风掣电"],"usage":"作定语、状语；多用于比喻句"},{"id":43709,"word":"追驷不及","pinyin":"zhuī sì bù jǐ","abbr":"zsbj","explanation":"驷：古代同驾一辆车的四匹马，或套着四匹马的车。已来不及追赶上飞奔的马车。比喻话说出去了再无法收回。","source":{"text":"言脱于口，追驷不及，聊志于此。","book":"汉·无名氏《杂事秘辛》"},"similar":["驷马难追"],"usage":"作谓语、定语；用于书面语"},{"id":43710,"word":"追魂夺命","pinyin":"zhuī hún duó mìng","abbr":"zhdm","explanation":"夺取魂魄性命。形容魅力极大。","source":{"text":"再看香裙下面，偏又配着周周正正、瘦瘦小小、追魂夺命一对小金莲，正是洛神临凡，西施出世。","book":"《绿野仙踪》第四十三回：“我活了四十多岁，才只见了这样个伶俐俊俏、追魂夺命、爱杀人的一位小堂客。”又第七十九回"},"usage":"作谓语、定语；用于书面语"},{"id":43711,"word":"追魂夺魄","pinyin":"zhuī hún duó pò","abbr":"zhdp","explanation":"迷信指摄取魂魄，致人死命。同“追魂摄魄”。","source":{"text":"文忠凛然端坐，价前如狼如虎的将官，排列两行，就如追魂夺魄的一般，甚是畏惧。","book":"明·郭勋《英烈传》第五十二回"},"example":{"text":"大吼一声，必定动天惊地；小笑两面，亦可～。","book":"《绿野仙踪》第二十二回"},"similar":["追魂摄魄"],"usage":"作谓语、定语；用于书面语"},{"id":43712,"word":"追魂摄魄","pinyin":"zhuī hún shè pò","abbr":"zhsp","explanation":"迷信指摄取魂魄，致人死命。","source":{"text":"活阎罗阮小七：地下阎罗，追魂摄魄。","book":"宋·周密《癸辛杂识续集·宋江三十六赞》"},"example":{"text":"两壁虽镌着一百单八条变化之法，仔细参求，都是偷天换日，～的伎俩。","book":"明·罗贯中《平妖传》第二回"},"similar":["追魂夺魄"],"usage":"作谓语、定语；用于书面语"},{"id":43713,"word":"退人坠渊","pinyin":"tuì rén zhuì yuān","abbr":"trzy","explanation":"坠渊：推进深渊里。指不讲原则，感情用事，对别人的爱憎态度，全凭自己的好恶来决定。","source":{"text":"今之君子，进入若将加诸膝，退人若将坠诸渊。","book":"《礼记·檀弓下》"}},{"id":43714,"word":"退如山移","pinyin":"tuì rú shān yí","abbr":"trsy","explanation":"退却时象一座山在移动。比喻遇到变故，沉着镇静。","source":{"text":"守以强弩，退如山移。","book":"《吴子·应变》"},"usage":"作宾语、定语；用于劝诫人"},{"id":43715,"word":"退徙三舍","pinyin":"tuì xǐ sān shè","abbr":"txss","explanation":"舍：古时行军计程以三十里为一舍。主动退让九十里。比喻退让和回避，避免冲突。","source":{"text":"夫三恶言不能使荧惑守心，三善言安能使荧惑退徙三舍？","book":"《左传·僖公二十三年》：“晋楚治兵，遇于中原，其辟君三舍。”汉·王充《论衡·变虚》"},"similar":["退避三舍"],"usage":"作谓语、定语；指退让"},{"id":43716,"word":"退思补过","pinyin":"tuì sī bǔ guò","abbr":"tsbg","explanation":"退思：退朝后检查自己的言行；过：过失，错误。表示事后省察自己的言行，有没有错误必须补正的地方。","source":{"text":"林父之事君也，进思尽忠，退思补过，社稷之卫也，若之何杀之？","book":"《左传·宣公十二年》"},"example":{"text":"故必进思尽忠。～，庶几无愧于夙夜在公之义。","book":"清·无名氏《杜诗言志》卷五"},"usage":"作谓语、宾语；指事后反省自己的过错"},{"id":43717,"word":"退旅进旅","pinyin":"tuì lǚ jìn lǚ","abbr":"tljl","explanation":"指一起进退。"},{"id":43718,"word":"退无后言","pinyin":"tuì wú hòu yán","abbr":"twhy","explanation":"离开了，就不在背后去议论。意为不在人们背后说长道短。","source":{"text":"人之有过，辄面折之，而退无后言。","book":"《晋书·崔洪传》"},"example":{"text":"纵令人切望治，～，犹不能不虑后世争乱之源。","book":"丁中江《北洋军阀史话》九十八"}},{"id":43719,"word":"退有后言","pinyin":"tuì yǒu hòu yán","abbr":"tyhy","explanation":"当面顺从答应，背后进行非议。","source":{"text":"汝无面从，退有后言。","book":"《尚书·益稷》"},"example":{"text":"此时受骂，就未免有点～了。","book":"清·吴趼人《二十年目睹之怪现状》第93回"},"usage":"作谓语、定语、宾语；指两面三刀"},{"id":43720,"word":"退步抽身","pinyin":"tuì bù chōu shēn","abbr":"tbcs","explanation":"指辞去官职，退居家中。"},{"id":43721,"word":"退藏于密","pinyin":"tuì cáng yú mì","abbr":"tcym","explanation":"后退隐藏于秘密之处，不露行迹。谓哲理精微深邃，包容万物。","source":{"text":"圣人以此洗心，退藏于密，吉凶与民同患，神以知来，知以藏往。","book":"《周易·系辞》"},"example":{"text":"明·天然痴叟《石点头·瞿凤奴情愆死盖》：“然皆听凭心灵指挥，有时～，方寸间现出四海垓。”"},"usage":"作谓语、定语；用于书面语"},{"id":43722,"word":"退让贤路","pinyin":"tuì ràng xián lù","abbr":"trxl","explanation":"退让：辞职的谦词；贤路：贤才仕进路。辞官退隐，让有才能的出来做事。","source":{"text":"愿归丞相侯印，乞骸骨归，避贤者路。","book":"《史记·万石张叔列传》"}},{"id":43723,"word":"退避三舍","pinyin":"tuì bì sān shè","abbr":"tbss","explanation":"舍：古时行军计程以三十里为一舍。主动退让九十里。比喻退让和回避，避免冲突。","source":{"text":"晋楚治兵，遇于中原，其辟君三舍。","book":"《左传·僖公二十三年》"},"example":{"text":"我说姊姊不过，只得～了。","book":"清·吴趼人《二十年目睹之怪现状》第四十二回"},"similar":["委曲求全"],"opposite":["针锋相对","锋芒毕露"],"usage":"作谓语、定语；指退让","story":["春秋时期，晋国内乱，晋献公的儿子重耳逃到楚国。楚成王收留并款待他，他许以如晋楚发生战争晋军退避三舍。后来重耳在秦穆公的帮助下重回晋国执政。晋国支持宋国与楚国发生矛盾，两军在城濮相遇，重耳退避三舍，诱敌深入而大胜"]},{"id":43724,"word":"退避贤路","pinyin":"tuì bì xián lù","abbr":"tbxl","explanation":"退避：辞职的谦词；贤路：贤才仕进路。辞官退隐，让有才能的出来做事。","source":{"text":"愿归丞相侯印，乞骸骨归，避贤者路。","book":"《史记·万石张叔列传》"},"example":{"text":"迫于时艰，勉膺重任，谨掬血诚，誓以公心效忠国事，一俟大难削平，即当～。","book":"丁中江《北洋军阀史话》八十七"},"usage":"作谓语、宾语；用于处事"},{"id":43725,"word":"退食从容","pinyin":"tuì shí cóng róng","abbr":"tscr","explanation":"指官吏品行节俭正直，仪容从容自得，可为楷模。","source":{"text":"语出《诗·召南·羔羊》：“退食自公，委蛇委蛇。”郑玄笺：“退食，谓减膳也。自，从也。从于公，谓正直顺于事也。委蛇，委曲自得之貌。节俭而顺心志定，故可自得也。”朱熹集传：“南国化文王之政，在位皆节俭正直，故诗人美其衣服有常，而从容自"}},{"id":43726,"word":"退食自公","pinyin":"tuì shí zì gōng","abbr":"tszg","explanation":"减膳以示节俭。指操守廉洁。","source":{"text":"退食自公，委蛇委蛇。","book":"《诗经·召南·羔羊》"},"example":{"text":"唐·杨炯《梓州惠义寺重阁铭》：“庶政惟私，万民以理，闲庭不忧，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":43727,"word":"送佛到西天","pinyin":"sòng fó dào xī tiān","abbr":"sfdxt","explanation":"比喻做好事做到底。","source":{"text":"姐姐原是为救安公子而来，如今自然送佛送到西天。","book":"清·文康《儿女英雄传》第九回"},"example":{"text":"我们中国人最讲信义，帮人帮到底，～！","book":"霍达《穆斯林的葬礼》第十一章"}},{"id":43728,"word":"送佛送到西","pinyin":"sòng fó sòng dào xī","abbr":"sfsdx","explanation":"比喻做好事做到底。","source":{"text":"姐姐原是为救安公子而来，如今自然送佛送到西天。","book":"清·文康《儿女英雄传》第九回"},"similar":["送佛送到西天"],"usage":"作宾语、分句；用于劝诫人"},{"id":43729,"word":"送佛送到西天","pinyin":"sòng fó sòng dào xī tiān","abbr":"sfsdxt","explanation":"比喻做好事做到底。","source":{"text":"姐姐原是为救安公子而来，如今自然送佛送到西天。","book":"清·文康《儿女英雄传》第九回"},"similar":["送佛送到西"],"usage":"作宾语、分句；用于劝诫人"},{"id":43730,"word":"送去迎来","pinyin":"sòng qù yíng lái","abbr":"sqyl","explanation":"形容忙于交际应酬。同“送往迎来”。","source":{"text":"公府门巷，宾客填集，送去迎来，财货无已。","book":"南朝·宋·范晔《后汉书·郎顗传》"},"similar":["送往迎来","送往劳来"],"usage":"作谓语、宾语、定语；形容忙于交际应酬"},{"id":43731,"word":"送君千里，终有一别","pinyin":"sòng jūn qiān lǐ，zhōng yǒu yī bié","abbr":"sjqlzyyb","explanation":"君：敬称对方；终：终究。送多远的路，终究要分别。","source":{"text":"哥哥，送君千里，终有一别，哥哥你回去。","book":"元·无名氏《马陵道》楔子"},"example":{"text":"老人最害怕告别，～，祖父晚年时，每次和他分手，心里都特别难受。","book":"叶兆言《旧式的情感》"}},{"id":43732,"word":"送君千里，终须一别","pinyin":"sòng jūn qiān lǐ，zhōng xū yī bié","abbr":"sjqlzxyb","explanation":"君：敬称对方；终：终究。送多远的路，终究要分别。","source":{"text":"哥哥，送君千里，终有一别，哥哥你回去。","book":"元·无名氏《马陵道》楔子"},"example":{"text":"～，我也不往下送了。","book":"清·文康《儿女英雄传》第十回"},"similar":["送君千里，也须一别"],"usage":"作宾语、分句；用于劝人止步"},{"id":43733,"word":"送往事居","pinyin":"sòng wǎng shì jū","abbr":"swsj","explanation":"往：死者；居：生者。礼葬死者，奉养生者。","source":{"text":"送往事居，耦俱无猜，贞也。","book":"《左传·僖公九年》"},"example":{"text":"少不失父，老不哭子，～，后先更迭，以终于无憾。","book":"宋·陈亮《祭朱寿之文》"},"similar":["送往视居"],"usage":"作谓语、宾语；指礼葬死者，奉养生者"},{"id":43734,"word":"送往劳来","pinyin":"sòng wǎng láo lái","abbr":"swll","explanation":"形容忙于交际应酬。同“送往迎来”。","source":{"text":"吾宁悃悃款款，朴以忠乎？将送往劳来，斯无穷乎？","book":"《楚辞·卜居》"},"similar":["送往迎来","送去迎来"],"usage":"作谓语、宾语、定语；形容忙于交际应酬"},{"id":43735,"word":"送往视居","pinyin":"sòng wǎng shì jū","abbr":"swsj","explanation":"礼葬死者，奉养生者。同“送往事居”。","source":{"text":"送往视居，则竭忠贞而不回。","book":"晋·葛洪《抱朴子·臣节》"},"similar":["送往事居"],"usage":"作谓语、宾语；指礼葬死者，奉养生者"},{"id":43736,"word":"送往迎来","pinyin":"sòng wǎng yíng lái","abbr":"swyl","explanation":"走的欢送，来的欢迎。形容忙于交际应酬。","source":{"text":"其送往而迎来，来者勿禁，往者勿止。","book":"《庄子·山木》"},"example":{"text":"况且他们来的是客，你我有地主之谊，书上还说～。","book":"清·李宝嘉《文明小史》第一回"},"similar":["送旧迎新","送往劳来","送去迎来"],"usage":"作谓语、宾语、定语；形容忙于交际应酬"},{"id":43737,"word":"送抱推襟","pinyin":"sòng bào tuī jīn","abbr":"sbtj","explanation":"真诚相待的意思。","source":{"text":"所可通梦交魂，推襟送抱者，唯丈人而已。","book":"《南史·张充传》"},"example":{"text":"这回在柏林时候，饭余灯背、～，一种密切的意思，真是笔不能写、口不能言。","book":"清·曾朴《孽海花》第十六回"},"similar":["推襟送抱"],"usage":"作谓语、定语；指真诚待人"},{"id":43738,"word":"送故迎新","pinyin":"sòng gù yíng xīn","abbr":"sgyx","explanation":"旧指欢送卸任的官吏，迎接新来接替的官吏。后也用于一般人事往来。","source":{"text":"吏或居官数月而退，送故迎新，交错道路。","book":"《汉书·王嘉传》"},"example":{"text":"你与我逞精神～。","book":"元·杨景贤《刘行首》第一折"},"similar":["送旧迎新","迎新送旧","迎新送故"],"usage":"作谓语、宾语；形容新旧交替"},{"id":43739,"word":"送旧迎新","pinyin":"sòng jiù yíng xīn","abbr":"sjyx","explanation":"送走旧的，迎来新的。","source":{"text":"送旧迎新也辛苦，一番辛苦两年闲。","book":"宋·杨万里《宿城外张氏庄早起入城》"},"example":{"text":"朝为秦雨，暮为楚云，～，此章台之恒事也。","book":"清·百一居士《壶天录》中卷"},"similar":["吐故纳新","喜新厌旧"],"opposite":["一成不变"],"usage":"作主语、谓语、宾语；形容新旧交替"},{"id":43740,"word":"送暖偎寒","pinyin":"sòng nuǎn wēi hán","abbr":"snwh","explanation":"元曲中指暗中为男女私情牵线撮合。也指男女偷情苟合，幽会叙情。后比喻奉承拍马。也比喻对人关切。同“送暖偷寒”。","source":{"text":"出入是非门里，定因家有三婆，替那好送暖偎寒，移商换羽，都是你这老贱人了。","book":"明·叶宪祖《团花凤》第二折"},"similar":["送暖偷寒"],"usage":"作谓语、宾语；指男女偷情苟合"},{"id":43741,"word":"送暖偷寒","pinyin":"sòng nuǎn tōu hán","abbr":"snth","explanation":"元曲中指暗中为男女私情牵线撮合。也指男女偷情苟合，幽会叙情。后比喻奉承拍马。也比喻对人关切。","source":{"text":"直待我拄着拐帮闲钻懒，缝合唇送暖偷寒。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"妄想～，谁与我传书寄简。","book":"明·周履靖《锦笺记·传私》"},"similar":["问寒送暖","送暖偎寒"],"usage":"作谓语、宾语；指男女偷情苟合"},{"id":43742,"word":"送死养生","pinyin":"sòng sǐ yǎng shēng","abbr":"ssys","explanation":"子女对父母的赡养和殡葬。","source":{"text":"养生者不足以当大事，惟送死可以当大事。","book":"《孟子·离娄下》"},"example":{"text":"德宗素不信阴阳鬼神，所以～，多循礼法。","book":"蔡东藩《唐史演义》第六十二回"}},{"id":43743,"word":"送眼流眉","pinyin":"sòng yǎn liú méi","abbr":"sylm","explanation":"以眉目传情。","source":{"text":"济南蒋稼，其妻毛氏，不育而妒。嫂每劝谏，不听，曰：‘宁绝嗣，不令送眼流眉者仇气人也。’","book":"清·蒲松龄《聊斋志异·段氏》"},"similar":["眉来眼去"],"usage":"作谓语、定语；用于书面语"},{"id":43744,"word":"送终养老","pinyin":"sòng zhōng yǎng lǎo","abbr":"szyl","explanation":"指老人赡养、丧葬之事。","source":{"text":"养生者不足以当大事，惟送死可以当大事。","book":"《孟子·离娄下》"},"example":{"text":"我儿，我指望你～，不枉我生你一场。谁知你夭命先亡，叫我举目无亲，怎不痛杀？","book":"清·吴璿《飞龙全传》第六回"}},{"id":43745,"word":"送货上门","pinyin":"sòng huò shàng mén","abbr":"shsm","explanation":"亲自将货物送到客户门上。指人自愿送上门来承担某种结果。","example":{"text":"这是你～，不能怪我了。"},"usage":"作谓语、定语、宾语；用于商业等"},{"id":43746,"word":"适以相成","pinyin":"shì yǐ xiāng chéng","abbr":"syxc","explanation":"恰好可以相辅相成。","source":{"text":"他们两个好像庙门前立着的那对哼哈二将，唯其不同，适以相成。","book":"老舍《赵子曰》"},"usage":"作谓语、定语；用于书面语"},{"id":43747,"word":"适俗随时","pinyin":"shì sú suí shí","abbr":"ssss","explanation":"犹言顺应时俗。","source":{"text":"案绰文虽去彼淫丽，存兹典实，而陷于矫枉过正之失，乖夫适俗随时之义。","book":"唐·刘知幾《史通·杂说中》"},"usage":"作谓语、定语；用于处事"},{"id":43748,"word":"适可而止","pinyin":"shì kě ér zhǐ","abbr":"skez","explanation":"适可：恰好可以。到适当的程度就停下来，不要过头。","source":{"text":"适可而止，无贪心也。","book":"《论语·乡党》：“不多食”宋·朱熹注"},"example":{"text":"从来没有暴风雨能够持久的。果然持久了，我们也吃不消，所以我们要它～。","book":"闻一多《宫体诗的自赎》"},"similar":["恰如其分","恰到好处","得休便休"],"opposite":["过犹不及","得寸进尺"],"usage":"作谓语、宾语；指恰到好处"},{"id":43749,"word":"适如其分","pinyin":"shì rú qí fèn","abbr":"srqf","explanation":"犹言恰如其分。指办事或说话正合分寸。","source":{"text":"权者，轻重适如其分之准也。","book":"清·王夫之《读通鉴论·唐高祖》"},"example":{"text":"鸦片遂～以获得了制御中国的主权。","book":"李大钊《马克思的中国民族革命论》"},"similar":["恰如其分"],"usage":"作谓语、宾语、状语；指说话或做事"},{"id":43750,"word":"适居其反","pinyin":"shì jú qí fǎn","abbr":"sjqf","explanation":"恰恰得到与预期相反的结果。同“适得其反”。","source":{"text":"这都是大错特错，唯物史观及于人生的影响乃适居其反。","book":"李大钊《唯物史观在现代史学上的价值》"},"similar":["适得其反"],"opposite":["如愿以偿"],"usage":"作谓语、定语；指事与愿违"},{"id":43751,"word":"适当其冲","pinyin":"shì dāng qí chōng","abbr":"sdqc","explanation":"正好对着冲要。","source":{"text":"适当其冲的是叶挺的独立团，混战了两个钟头，算把出城的敌人通统歼灭了。","book":"郭沫若《北伐途次》二七"},"similar":["首当其冲"],"usage":"作谓语、定语；用于书面语"},{"id":43752,"word":"适当其时","pinyin":"shì dāng qí shí","abbr":"sdqs","explanation":"指恰巧遇上那个时机。","source":{"text":"淮海秦少游论曰：杜子美之于诗，实积众流之长，适当其时而已。","book":"宋·蔡梦弼《草堂诗话》卷一"},"example":{"text":"若自桐归毫以三祀之十二月者，则～，而非有所取尔。","book":"清·顾炎武《日知录·惟元祀十有二月》"},"similar":["适逢其时"],"usage":"作谓语；用于处事等"},{"id":43753,"word":"适得其反","pinyin":"shì dé qí fǎn","abbr":"sdqf","explanation":"适：正，恰好。恰恰得到与预期相反的结果。","source":{"text":"今议防堵者，莫不曰：‘御诸内河不若御诸海口，御诸海口不若御诸外洋。’不知此适得其反也。","book":"清·魏源《筹海篇·议守上》"},"example":{"text":"不知道重视干部，爱护干部，而对于一般同事却要求全责备，在事实上也将～。","book":"邹韬奋《〈事业管理与职业修养〉弁言》"},"similar":["事与愿违","适居其反"],"opposite":["如愿以偿","尽如人意"],"usage":"作谓语、定语；指事与愿违","story":["春秋末年，晋国卿士赵鞅是一个不肯荼毒生灵的慈善家，每逢新年，他将百姓进献给他的斑鸠放生，然后重赏献斑鸠的人。有人说他这样做使更多的斑鸠遭到捕杀，劳民伤财。赵简子认为此话很有道理，下令禁止捕捉斑鸠与放生了"]},{"id":43754,"word":"适心娱目","pinyin":"shì xīn yú mù","abbr":"sxym","explanation":"犹言喜心悦目。","source":{"text":"予谓名人适心娱目，偶一为之，亦复何损。","book":"清·周亮工《书影》第十卷"},"example":{"text":"这是～的事情。"},"similar":["爽心悦目"],"usage":"作谓语、定语、状语；指使人高兴"},{"id":43755,"word":"适性任情","pinyin":"shì xìng rèn qíng","abbr":"sxrq","explanation":"指顺适性情。","source":{"text":"它们适性任情，对就对，错就错，不说一句分辩话。","book":"鲁迅《朝花夕拾·〈狗·猫·鼠〉》"},"usage":"作谓语、宾语、定语；用于处世等"},{"id":43756,"word":"适性忘虑","pinyin":"shì xìng wàng lǜ","abbr":"sxwl","explanation":"指顺悦情性忘却忧虑。","source":{"text":"《遁斋闲览》云：荆公棋品殊下，每与人对局，未尝致思，随手疾应，觉其势必败，便敛之，谓人曰：‘本图适性忘虑，反苦思劳神，不如且已。’","book":"宋·胡仔《苕溪渔隐丛话前集·半山老人》"},"usage":"作谓语、定语；用于书面语"},{"id":43757,"word":"适情任欲","pinyin":"shì qíng rèn yù","abbr":"sqry","explanation":"犹言任情纵欲。","source":{"text":"爰逮战国，风宪逾薄，适情任欲，颠倒衣裳，以至破国亡身，不可胜数。","book":"《后汉书·皇后纪序》"},"usage":"作谓语、宾语；用于为人处事等"},{"id":43758,"word":"适情率意","pinyin":"shì qíng shuài yì","abbr":"sqsy","explanation":"犹言放任情意。","source":{"text":"适情率意，旁若无人。","book":"晋·葛洪《抱朴子·行品》"},"usage":"作谓语、定语；用于处事"},{"id":43759,"word":"适时应务","pinyin":"shì shí yīng wù","abbr":"ssyw","explanation":"适合时宜，顺应世务。","source":{"text":"但廉平常迹，声问难高；适时应务，招响必速。","book":"《魏书·良吏传序》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":43760,"word":"适材适所","pinyin":"shì cái shì suǒ","abbr":"scss","explanation":"指办事能力与所安排的工作位置或场所相当。","source":{"text":"本来是在面坊里住惯了的老马又落到面坊里，也算得是适材适所。","book":"郭沫若《北伐途次》七"},"example":{"text":"周公这次把他挑选来作为撤退计划的执行人，真要算是～了。","book":"《洪波曲》第十五章二"},"usage":"作宾语、定语；用于书面语"},{"id":43761,"word":"适百里者宿舂粮","pinyin":"shì bǎi lǐ zhě xiǔ chōng liáng","abbr":"sblzscl","explanation":"适：往；宿：夜；舂：舂米，把谷类的壳捣掉。远行百里的人要连夜舂米，准备粮食。比喻事先做好准备工作。","source":{"text":"适百里者宿舂粮，适千里者三月聚粮。","book":"《庄子·逍遥游》"}},{"id":43762,"word":"适者生存","pinyin":"shì zhě shēng cún","abbr":"szsc","explanation":"适：符合，适应。适应环境要求的就能生存下去","example":{"text":"社会竞争十分残酷，～"},"usage":"作谓语、定语、宾语；用于处事"},{"id":43763,"word":"适逢其会","pinyin":"shì féng qí huì","abbr":"sfqh","explanation":"适：正，恰好；会：时机。恰巧碰上那个机会或时机。","source":{"text":"子牟客游荆门，适逢其会。","book":"隋·王通《文中子·周公》：“子谓仲长子光曰：‘山林可居乎？’曰：‘会逢其适也，焉知其可？’”唐·薛用弱《集异记·李子牟》"},"example":{"text":"戾死树木，也是～。","book":"清·李汝珍《镜花缘》第七十一回"},"similar":["适逢其时"],"opposite":["失之交臂"],"usage":"作谓语；指人或事碰到好机会"},{"id":43764,"word":"适逢其时","pinyin":"shì féng qí shí","abbr":"sfqs","explanation":"恰巧碰上那个机会或时机。同“适逢其会”。","source":{"text":"虽然姬昌之数偶验，适逢其时，岂得骤赦归国！","book":"明·许仲琳《封神演义》第十一回"},"similar":["适逢其会"],"opposite":["失之交臂"],"usage":"作谓语；指人或事碰到好机会"},{"id":43765,"word":"逃之夭夭","pinyin":"táo zhī yāo yāo","abbr":"tzyy","explanation":"本意是形容桃花茂盛艳丽。后借用“逃之夭夭”表示逃跑，是诙谐的说法。","source":{"text":"桃之夭夭，灼灼其华。","book":"《诗经·周南·桃夭》"},"example":{"text":"撞人者～，众人向他投去愤怒的眼光。"},"similar":["溜之大吉","桃之夭夭"],"opposite":["岿然不动"],"usage":"作谓语、定语；是逃跑诙谐的说法"},{"id":43766,"word":"逃灾躲难","pinyin":"táo zāi duǒ nàn","abbr":"tzdn","explanation":"指逃避灾难。","source":{"text":"头两炷香可也不打紧，第三炷香愿天下好男子休遭罗网之灾。我是逃灾避难之人，他说这等吉利的话。","book":"元·无名氏《争报恩》第二折"},"example":{"text":"按下三位公子～。且言那吏部米顺领了一千铁骑、四十名校尉，捧了圣旨，一拥来到秦府。","book":"明·罗贯中《粉妆楼》第四十四回"},"similar":["逃灾避难"],"usage":"作谓语、宾语；指逃避灾难"},{"id":43767,"word":"逃灾避难","pinyin":"táo zāi bì nàn","abbr":"tzbn","explanation":"逃避灾难。","source":{"text":"似这等逃灾避难，倒不如奔井投河。","book":"元·无名氏《盆儿鬼》"},"example":{"text":"不能因为～而放弃自己应尽的责任。"},"similar":["逃灾躲难","避难逃灾"],"usage":"作谓语、宾语；指逃避灾难"},{"id":43768,"word":"逃生不避路，到处便为家","pinyin":"táo shēng bù bì lù，dào chù biàn wéi jiā","abbr":"tsbbldcbwj","explanation":"指人在逃生时慌不择路，只要有地方躲藏就可以安家。","source":{"text":"这鲁达急急忙忙行过了几处州府，正是‘逃生不避路，到处便为家’。","book":"明·施耐庵《水浒传》第三回"},"similar":["慌不择路"],"usage":"作宾语、定语；用于处事"},{"id":43769,"word":"逃避现实","pinyin":"táo bì xiàn shí","abbr":"tbxs","explanation":"指不敢正视面临的困难和问题。","source":{"text":"不能不顾现实，更不能逃避现实，也不能向丑恶的现实投降。","book":"刘少奇《论共产党员的修养》"},"example":{"text":"我不喜欢用～的方法来解决。"},"usage":"作谓语、定语、宾语；指不敢面对现实"},{"id":43770,"word":"逆取顺守","pinyin":"nì qǔ shùn shǒu","abbr":"nqss","explanation":"逆：背叛；顺：合理。背叛国君夺取天下，遵循常理治理国家。","source":{"text":"且汤武逆而以取顺守之，文武并用，长久之术也。","book":"《汉书·陆贾传》"},"example":{"text":"且“兼弱攻昧”、“～”，汤武之道也。","book":"明·罗贯中《三国演义》第六十回"},"usage":"作谓语、宾语；指人篡权"},{"id":43771,"word":"逆坂走丸","pinyin":"nì bǎn zǒu wán","abbr":"nbzw","explanation":"逆着斜坡滚丸。比喻事情难于办到。","source":{"text":"若欲辅难佐之朝，雕朽败之木，是犹逆坂走丸，迎风纵槕，岂云易哉！","book":"南朝·宋·范晔《后汉书·皇甫嵩传》"},"example":{"text":"饥寒切体，而欲使民兴礼让者，此犹～，势不可得也。","book":"《周书·苏绰传》"},"similar":["逆阪走丸"],"usage":"作宾语、定语；指事情难办"},{"id":43772,"word":"逆天大罪","pinyin":"nì tiān dà zuì","abbr":"ntdz","explanation":"逆：违背。形容极大的罪恶。","source":{"text":"二则惟愿朝廷早降恩光，赦免逆天大罪，众当竭力捐躯，尽忠报国，死而后已。","book":"明·施耐庵《水浒传》第71回"},"example":{"text":"就是～，我们也可以原谅他。"},"similar":["弥天大罪"],"usage":"作主语、宾语；指极大的罪恶"},{"id":43773,"word":"逆天悖理","pinyin":"nì tiān bèi lǐ","abbr":"ntbl","explanation":"指违背天道常理。","source":{"text":"身灭祀绝，为天下笑，天以吴众不能成功者何？诚逆天违理而不见时也。","book":"汉·荀悦《汉纪·孝武帝纪》"},"example":{"text":"自甘一死，九泉可见太祖列宗之灵，不似你这～，碎尸万段！","book":"清·陈忱《水浒后传》第二十五回"},"similar":["逆天背理","逆理违天"],"usage":"作谓语、宾语、定语；指违背常规"},{"id":43774,"word":"逆天无道","pinyin":"nì tiān wú dào","abbr":"ntwd","explanation":"逆：违反；道：道义。违反天理，毫无道义。","source":{"text":"卓逆天无道，荡覆王室。今不夷汝三族，悬示四海，则吾死不瞑目。岂将与乃和亲邪?","book":"《三国志·吴志·孙破虏讨逆传》"},"example":{"text":"董卓～，荡覆王室，吾欲夷其九族，以谢天下，安肯与逆贼结亲耶！","book":"明·罗贯中《三国演义》第六回"},"usage":"作谓语、定语；用于指责人"},{"id":43775,"word":"逆天暴物","pinyin":"nì tiān bào wù","abbr":"ntbw","explanation":"违逆天理，残害生灵。","source":{"text":"故精诚内形，气动于天，景星见，黄龙下，凤皇至，醴泉出，嘉谷生，河不满溢，海不波涌；逆天暴物，即日月薄蚀，五星失行，四时相乘，昼明宵光，山崩川涸，冬雷夏霜。","book":"《文子·精诚》"},"example":{"text":"有陈窃据江表，～，朕初受命，陈顼尚存，厚纳叛亡，侵犯城戍。","book":"蔡东藩《南北史演义》第八十四回"},"usage":"作谓语、定语；用于处事"},{"id":43776,"word":"逆天犯顺","pinyin":"nì tiān fàn shùn","abbr":"ntfs","explanation":"背逆天意正道。","source":{"text":"直若逆天犯顺，此则自取灭亡。","book":"《周书·齐炀王宪传》"},"example":{"text":"且夏贼～，本因轻实朝廷，以为必不能讨己。","book":"宋·苏轼《乞约鬼章讨阿里骨札子》"},"usage":"作谓语、宾语；用于处事"},{"id":43777,"word":"逆天而行","pinyin":"nì tiān ér xíng","abbr":"ntex","explanation":"逆：违背。违背天意做事。比喻违背客观形势或规律。","source":{"text":"今孔明自负才智，逆天而行，乃自取败亡也。","book":"明·罗贯中《三国演义》第102回"},"example":{"text":"清·李汝珍《镜花缘》第二回：“据仙姑说得其难其慎，断不可～。”"},"similar":["逆天行事"],"opposite":["顺天应人"],"usage":"作谓语、定语、宾语；指人违背客观规律"},{"id":43778,"word":"逆天背理","pinyin":"nì tiān bèi lǐ","abbr":"ntbl","explanation":"逆：违背。违背天道常理。","source":{"text":"则他那逆天背理可钐杀，我则待要剿除乱掠扶家国。","book":"元·无名氏《陈仓路》头折"},"similar":["逆天悖理","逆天违理"],"usage":"作谓语、宾语、定语；指违背常规"},{"id":43779,"word":"逆天行事","pinyin":"nì tiān xíng shì","abbr":"ntxs","explanation":"逆：违背。违背天意做事。比喻违背客观形势或规律。","source":{"text":"逆天行事的无徒子，怎与皇家做柱石。","book":"元·无名氏《延安府》第二折"},"example":{"text":"我如这样做就是～。"},"similar":["逆天而行"],"opposite":["顺天应人"],"usage":"作谓语、定语、宾语；指人违背客观规律"},{"id":43780,"word":"逆天违众","pinyin":"nì tiān wéi zhòng","abbr":"ntwz","explanation":"指违背天理人情。","source":{"text":"夫以吴众不能成功者，何也？诚逆天违众而不见时也。","book":"东汉·班固《汉书·伍被传》"},"opposite":["顺天应时","奉天承运"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43781,"word":"逆天违理","pinyin":"nì tiān wéi lǐ","abbr":"ntwl","explanation":"指违背天道常理。","source":{"text":"身灭祀绝，为天下笑，天以吴众不能成功者何？诚逆天违理而不见时也。","book":"汉·荀悦《汉纪·孝武帝纪》"},"similar":["逆天悖理","逆天背理"],"usage":"作谓语、宾语、定语；指违背常规"},{"id":43782,"word":"逆子贰臣","pinyin":"nì zǐ èr chén","abbr":"nzec","explanation":"贰臣：由旧朝投降后在新朝又担任官职的人。忤逆不孝的儿子，不忠的大臣。","source":{"text":"鲁迅从进化论进到阶级论，从绅士阶级的逆子贰臣进到无产阶级和劳动群众的真正的友人，以至战士。","book":"瞿秋白《鲁迅的精神》"},"similar":["逆子贼臣"],"usage":"作主语、宾语、定语；用于书面语"},{"id":43783,"word":"逆子贼臣","pinyin":"nì zǐ zéi chén","abbr":"nzzc","explanation":"不忠不孝的反叛臣子。","source":{"text":"唯有逆臣贼子，欲谋王之国政，怀邪抱佞，不谨风谣。","book":"《敦煌变文·降魔变文》"},"similar":["逆臣贼子"],"usage":"作主语、宾语；指心怀异志的人"},{"id":43784,"word":"逆施倒行","pinyin":"nì shī dǎo xíng","abbr":"nsdx","explanation":"原指做事违反常理，不择手段。现多指所作所为违背时代潮流或人民意愿。同“逆行倒施”。","source":{"text":"逆施倒行，以迄于今。","book":"孙中山《临时大总统告各友邦书》"},"similar":["倒行逆施","逆行倒施"],"usage":"作谓语、定语、宾语；指违背情理"},{"id":43785,"word":"逆来顺受","pinyin":"nì lái shùn shòu","abbr":"nlss","explanation":"指对恶劣的环境或无礼的待遇采取顺从和忍受的态度。","source":{"text":"若是一个略略知趣的，见家主来光顾，也便逆来顺受。","book":"明·周楫《西湖二集·侠女散财殉节》"},"example":{"text":"从前受了主人的骂，无非～。","book":"清·吴趼人《二十年目睹之怪现状》第九十三回"},"similar":["委曲求全","犯而不校"],"opposite":["以牙还牙，以眼还眼","针锋相对"],"usage":"作谓语、定语、状语；指人的态度"},{"id":43786,"word":"逆水行舟","pinyin":"nì shuǐ xíng zhōu","abbr":"nsxz","explanation":"逆着水流的方向行船。比喻不努力就要后退。","source":{"text":"夫旧而能守，斯亦已矣！然鄙人以为人之处于世也，如逆水许舟，不进则退。","book":"清·梁启超《莅山西票商欢迎会学说词》"},"example":{"text":"即使目下还有点～，也只好拉纤。","book":"鲁迅《且介亭杂文·门外文谈》"},"similar":["知难而进","逆流而上"],"opposite":["知难而退","一帆风顺"],"usage":"作谓语、宾语；常与“不进则退”连用"},{"id":43787,"word":"逆水行舟，不进则退","pinyin":"nì shuǐ xíng zhōu，bù jìn zé tuì","abbr":"nsxzbjzt","explanation":"逆着水流的方向行船，如不努力推进，则会随水流后退。比喻学习或做事须克服困难，奋勉向前。","source":{"text":"夫旧而能守，斯亦已矣！然鄙人以为人之处于世也，如逆水许舟，不进则退。","book":"清·梁启超《莅山西票商欢迎会学说词》"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":43788,"word":"逆流而上","pinyin":"nì liú ér shàng","abbr":"nles","explanation":"逆：倒。逆水前进。比喻迎着困难而上。","source":{"text":"逆流而上曰溯洄。","book":"《诗经·秦风·蒹葭》：“溯洄从之。”毛亨传"},"example":{"text":"目前，正有一股寒流向我们压过来，我们要～，打上去！","book":"张天民《创业》第13章"},"similar":["知难而进"],"opposite":["知难而退"],"usage":"作谓语、宾语、定语；用于人的精神等"},{"id":43789,"word":"逆理违天","pinyin":"nì lǐ wéi tiān","abbr":"nlwt","explanation":"逆：违反；悖：违背。违背天道常理。","source":{"text":"身灭祀绝，为天下笑，天以吴众不能成功者何？诚逆天违理而不见时也。","book":"汉·荀悦《汉纪·孝武帝纪》"},"example":{"text":"我荐仁义，肯从他～。","book":"明·胡文焕《群音类选·宝剑记·避难遇义》"},"similar":["逆天悖理"],"usage":"作谓语、宾语、定语；指违背常规"},{"id":43790,"word":"逆知所始","pinyin":"nì zhī suǒ shǐ","abbr":"nzss","explanation":"逆：预先猜度。指事先掌握情况，判断对方的企图。","source":{"text":"善观敌者，当逆知其所始；善制敌者，当先去其所恃。","book":"清·黄邦宁《秦乞夏襄阳札子》"}},{"id":43791,"word":"逆耳之言","pinyin":"nì ěr zhī yán","abbr":"nezy","explanation":"听起来不舒服的话（多指尖锐、中肯的劝告或批评）。","source":{"text":"而忠臣挟难进之术，吐逆耳之言，其不合也，不亦宜乎。","book":"晋·陈寿《三国志·吴志·张纮传》"},"example":{"text":"你不要讨厌我的～。"},"similar":["逆耳良言"],"usage":"作宾语；指不顺耳的话"},{"id":43792,"word":"逆耳利行","pinyin":"nì ěr lì xíng","abbr":"nelx","explanation":"犹言忠言逆耳利于行。谓忠诚正直的话虽然不顺耳，但有益于行为。","source":{"text":"忠言逆耳利于行。","book":"《史记·留侯世家》"},"example":{"text":"臣蒙天泽，叨居重镇，～，敢不尽言。","book":"《旧唐书·王睃传》"},"similar":["忠言逆耳利于行"],"usage":"作谓语、定语；用于劝告等"},{"id":43793,"word":"逆耳忠言","pinyin":"nì ěr zhōng yán","abbr":"nezy","explanation":"逆耳：不顺耳。听起来感到刺耳的话是有益的好话。","source":{"text":"我忠心主意要兴兵，逆耳忠言不肯听。","book":"明·无名氏《四马投唐》楔子"},"example":{"text":"罕见的是能够像大帅这样喜欢～，不喜欢听奉承的话。","book":"姚雪垠《李自成》第23章"},"similar":["逆耳良言"],"usage":"作主语、宾语、定语；用于劝说等"},{"id":43794,"word":"逆耳良言","pinyin":"nì ěr liáng yán","abbr":"nely","explanation":"虽然使人听起来感到刺耳，但却是有益的好话。逆：抵触，不顺从。","source":{"text":"忠言逆耳利于行。","book":"《史记·留侯世家》"},"example":{"text":"你不妨耐心地听一听～，也许这对于你是有好处的。"},"similar":["逆耳忠言"],"usage":"作主语、宾语、定语；用于劝说等"},{"id":43795,"word":"逆臣贼子","pinyin":"nì chén zéi zǐ","abbr":"nczz","explanation":"逆臣：叛乱之臣；贼子：忤逆之子。旧指不守君臣、父子之道的人。后泛指心怀异志的人。","source":{"text":"孔子成《春秋》，而乱臣贼子惧。","book":"《孟子·藤文公下》"},"example":{"text":"～，何世无之，岂意今者近出臣族！（《晋书·王导传》）"},"similar":["乱臣贼子","逆子贼臣"],"usage":"作主语、宾语；指心怀异志的人"},{"id":43796,"word":"逆行倒施","pinyin":"nì xíng dǎo shī","abbr":"nxds","explanation":"犹言倒行逆施。原指做事违反常理，不择手段。现多指所作所为违背时代潮流或人民意愿。","source":{"text":"强者为雄，斯则弃德任力，逆行倒施，有一于此。","book":"南朝·宋·无名氏《移答魏安南平南府》"},"example":{"text":"吾既以孝廉举也，～，吾不能学众之伪。","book":"清·周亮工《张林宗先生传》"},"similar":["倒行逆施","逆施倒行"],"usage":"作谓语、定语、宾语；指违背情理"},{"id":43797,"word":"逆道乱常","pinyin":"nì dào luàn cháng","abbr":"ndlc","explanation":"指违背道德纲常。","source":{"text":"如小娥足以儆天下逆道乱常之心，足以观天下贞夫孝妇之节也。","book":"唐·李公佐《谢小娥传》"},"example":{"text":"你不能干～的事。"},"similar":["逆天违理"],"usage":"作谓语、定语；指违背道德纲常"},{"id":43798,"word":"逆阪走丸","pinyin":"nì bǎn zǒu wán","abbr":"nbzw","explanation":"比喻事情难于办到。同“逆坂走丸”。","source":{"text":"若欲辅难佐之朝，雕朽败之木，是犹逆阪走丸，迎风纵槕，岂云易哉！","book":"南朝·宋·范晔《后汉书·皇甫嵩传》"},"example":{"text":"决水于高原之上，以注川谷，无不行者，如～，虽竭力以进之，其复走而下，可必也。","book":"宋·司马光《乞去新法之病民伤国者疏》"},"similar":["逆坂走丸"],"opposite":["下阪走丸"],"usage":"作宾语、定语；指事情难办"},{"id":43799,"word":"逆风恶浪","pinyin":"nì fēng è làng","abbr":"nfel","explanation":"比喻险恶的形势。","source":{"text":"即使尹老师满腹牢骚及烦躁，也还是听到铃声，奔赴教室，顶着‘四人帮’掀起的逆风恶浪，为学生们上课。","book":"《人民文学》1978年第2期"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":43800,"word":"逆风撑船","pinyin":"nì fēng chēng chuán","abbr":"nfcc","explanation":"逆风：顶风。比喻身处逆境。","source":{"text":"老骥伏枥，虽未歇于壮心；逆风撑船，终不离于旧处。","book":"宋·陆游《与何蜀州启》"},"similar":["逆水行舟"],"usage":"作宾语、定语；指人的处境"},{"id":43801,"word":"选兵秣马","pinyin":"xuǎn bīng mò mǎ","abbr":"xbmm","explanation":"选好兵器喂饱战马。指作好战前准备。","source":{"text":"今若敕励诸将选兵秣马，疾入西界，但能痛败昊贼一阵，则吾军威大振而虏汁沮矣。","book":"宋欧阳修《准诏言事上书》"},"similar":["选士厉兵"],"usage":"作谓语、定语；用于书面语"},{"id":43802,"word":"选士厉兵","pinyin":"xuǎn shì lì bīng","abbr":"xslb","explanation":"厉：磨；兵：武器。挑选士兵，磨利武器。","source":{"text":"天子乃命将帅，选士厉兵，简炼桀俊，专任有功，以征不义。","book":"《吕氏春秋·孟秋纪》"},"similar":["选兵秣马"],"usage":"作谓语、定语；用于军事等"},{"id":43803,"word":"选妓征歌","pinyin":"xuǎn jì zhēng gē","abbr":"xjzg","explanation":"指放荡的生活方式。","source":{"text":"选妓随雕辇，征歌出洞房。","book":"唐李白《宫中行乐词》之二"},"example":{"text":"～惟买醉，只愁回首岁华虚。","book":"明冯梦龙《楚江情·歌筵买骏》"},"similar":["选歌试舞","选色征歌"],"usage":"作宾语、定语；用于生活"},{"id":43804,"word":"选歌试舞","pinyin":"xuǎn gē shì wǔ","abbr":"xgsw","explanation":"指放荡的生活方式。同“选色征歌”。","source":{"text":"选歌试舞，连宵恋醉珍丛。","book":"宋·周密《露华·次张岫云韵》"},"similar":["选妓征歌"],"usage":"作宾语、定语；用于生活"},{"id":43805,"word":"选舞征歌","pinyin":"xuǎn wǔ zhēng gē","abbr":"xwzg","explanation":"指放荡的生活方式。同“选色征歌”。","source":{"text":"布衣天子哭荒陵，选舞征歌好中兴。","book":"清·张问陶《读偶题》"},"similar":["选色征歌","选妓征歌"],"usage":"作宾语、定语；用于生活"},{"id":43806,"word":"选色征歌","pinyin":"xuǎn sè zhēng gē","abbr":"xszg","explanation":"挑选美女，征召歌伎。指放荡的生活方式。亦作“选歌试舞”、“选舞征歌”。","source":{"text":"结驷连骑，选色征歌。","book":"清余怀《板桥杂记·雅游》"},"example":{"text":"当玄宗天宝改元以后……除了～之外，一概付之不闻不问。","book":"《儿女英雄传》缘起首回。"},"similar":["选妓征歌","选舞征歌"],"usage":"作宾语、定语；用于生活"},{"id":43807,"word":"选贤与能","pinyin":"xuǎn xián yǔ néng","abbr":"xxyn","explanation":"选拔任用贤能的人。与，通“举”。亦作“选贤任能”、“选贤举能”。","source":{"text":"大道之行也，天下为公，选贤与能，讲售修睦。","book":"《礼记·礼运》"},"example":{"text":"～，于今虽重。","book":"唐韩愈《除崔群户部侍郎制》"},"similar":["选贤举能","选贤进能"],"usage":"作谓语、宾语、定语；指爱惜人才"},{"id":43808,"word":"选贤举能","pinyin":"xuǎn xián jǔ néng","abbr":"xxjn","explanation":"选拔任用贤能的人。亦作“选贤任能”、“选贤与能”。","source":{"text":"大道之行也，天下为公，选贤与能，讲售修睦。","book":"《礼记·礼运》"},"example":{"text":"他主张德政，主张～，主张大一统。","book":"郭沫若《历史人物·屈原研究三》"},"similar":["任人唯贤","知人善任","量才录用"],"opposite":["任人唯亲","拉帮结派","结党营私"],"usage":"作谓语、宾语、定语；指爱惜人才"},{"id":43809,"word":"选贤任能","pinyin":"xuǎn xián rèn néng","abbr":"xxrn","explanation":"选拔任用贤能的人。亦作“选贤与能”、“选贤举能”。","source":{"text":"设官分职，选贤任能，得其人则有益于国家，非其才则贻患于黎庶，此以不可不知也。","book":"《旧唐书·食货志上》"},"example":{"text":"以道言之，～以匡社稷者，天下之公也。","book":"清王夫之《读通鉴论·汉成帝》"},"similar":["选贤举能"],"usage":"作谓语、宾语、定语；指爱惜人才"},{"id":43810,"word":"选贤用能","pinyin":"xuǎn xián yòng néng","abbr":"xxyn","explanation":"选拔任用有才能有德行的人。","source":{"text":"不掩君过，谏乎前不华乎外，选贤进能，不私乎内。","book":"《晏子春秋·内篇问上》"},"example":{"text":"临下有赫，～。","book":"唐·贯休《大蜀皇帝寿春节进尧铭舜颂二首·舜颂》"}},{"id":43811,"word":"选贤进能","pinyin":"xuǎn xián jìn néng","abbr":"xxjn","explanation":"进：推荐。选拔推荐有才能有德行的人。","source":{"text":"不掩君过，谏乎前不华乎外，选贤进能，不私乎内。","book":"《晏子春秋·内篇问上》"},"similar":["选贤与能","选贤举能"],"usage":"作谓语、宾语、定语；指爱惜人才"},{"id":43812,"word":"逊志时敏","pinyin":"xùn zhì shí mǐn","abbr":"xzsm","explanation":"谦虚好学，时刻策励自己。","source":{"text":"惟学逊志，务时敏，厥修乃来。","book":"《尚书·说命下》"},"usage":"作谓语；用于书面语"},{"id":43813,"word":"逋慢之罪","pinyin":"bū màn zhī zuì","abbr":"bmzz","explanation":"不遵守法令的罪过。","source":{"text":"臣之区区，辞说已穷，然不敢避逋慢之罪而苟止者，非特欲守前言之信，亦不敢上累朝廷。","book":"宋·王安石《再辞同修起居注第五状》"},"usage":"作宾语；指罪过"},{"id":43814,"word":"逋逃之臣","pinyin":"bū táo zhī chén","abbr":"btzc","explanation":"逃亡的罪臣。","source":{"text":"以单于屈体称臣奉使朝贺，无有二心，而今反受其逋逃之臣，是贪一夫之得，而失一国之心。","book":"汉·荀悦《汉纪·成帝纪》"},"usage":"作宾语；指逃犯"},{"id":43815,"word":"逋逃之薮","pinyin":"bū táo zhī sǒu","abbr":"btzs","explanation":"逋逃：逃亡者；薮：人或物集中的地方。一般指某处成为逃亡者的藏身之所。","source":{"text":"为天下逋逃主，萃渊薮。","book":"《尚书·武成》"},"example":{"text":"遂成～，公私成患。","book":"《北史·李安世传》"},"usage":"作宾语；指避难所"},{"id":43816,"word":"逍遥事外","pinyin":"xiāo yáo shì wài","abbr":"xysw","explanation":"①指犯法者没有受到法律制裁。亦泛指做坏事或与坏事有牵连的人不受追查。②指置身事外，毫不关心。","source":{"text":"关于杨妃，禄山之乱以后的文人就都撒着大谎，玄宗逍遥事外，倒说是许多坏事情都由她。","book":"清·包世臣《致广东按察姚中丞书》：“首祸正凶，逍遥事外。”鲁迅《花边文学·女人未必多说谎》"},"example":{"text":"……但理论家或批评家是同有指导、评论、商量的责任的，不能只斥他交代未清之后，便可～。","book":"鲁迅《且介亭杂文·论“旧形式的采用”》"},"similar":["逍遥法外"],"usage":"作谓语、定语；用于书面语"},{"id":43817,"word":"逍遥法外","pinyin":"xiāo yáo fǎ wài","abbr":"xyfw","explanation":"逍遥：优游自得的样子。指犯法的人没有受到法律制裁，仍然自由自在。","source":{"text":"那些造神召鬼、制造冤案、虚报产量、逼死人命等等、等等的大骗子是不会长期逍遥法外的。","book":"巴金《探索集·再说小骗子》"},"example":{"text":"这些该死的反动派，当然也抓到一些，可是总还有～的。","book":"丁玲《粮秣主任》"},"similar":["逍遥自在"],"opposite":["罪有应得","法网难逃"],"usage":"作谓语、宾语；指没有受到法律制裁"},{"id":43818,"word":"逍遥物外","pinyin":"xiāo yáo wù wài","abbr":"xyww","explanation":"指不受外界事物的拘束，自由自在。","source":{"text":"识破嚣尘，作个逍遥物外人。","book":"宋·张孝祥《减字木兰花·赠尼师旧角奴也》词"},"example":{"text":"苟非金石，鲜不销亡。异日幸生还，当与君敝屣万有，～。","book":"清·冒襄《影梅庵忆语》卷二"},"similar":["逍遥自得"],"usage":"作谓语、定语；用于处世等"},{"id":43819,"word":"逍遥自在","pinyin":"xiāo yáo zì zài","abbr":"xyzz","explanation":"无拘无束，安闲自得。","source":{"text":"二十四腊，逍遥自在，逢人则喜，见佛不拜。","book":"宋·释道原《景德传灯录》卷二十九：“丈夫运用堂堂，逍遥自在无妨。” 宋·释普济《五灯会元》"},"example":{"text":"倒不如院长，放下名心，～。","book":"清·陈忱《水浒后传》第十四回"},"similar":["自由自在","无忧无虑"],"opposite":["提心吊胆","胆战心惊"],"usage":"作谓语、定语、状语；用于人"},{"id":43820,"word":"逍遥自娱","pinyin":"xiāo yáo zì yú","abbr":"xyzy","explanation":"指无拘无束，自得其乐。","source":{"text":"池台琴酒，逍遥自娱，贤士大夫，尚其轨躅。","book":"唐·李珏《唐丞相太子少师赠太尉牛公神道碑铭》"},"similar":["逍遥自得"],"usage":"作谓语、定语；用于处事等"},{"id":43821,"word":"逍遥自得","pinyin":"xiāo yáo zì dé","abbr":"xyzd","explanation":"无拘无束，安闲自得。","source":{"text":"日出而作，日入而息，逍遥于天地之间，而心意自得。","book":"战国·宋·庄周《庄子·让王》"},"example":{"text":"可以寡过，可以养生，性命双修，～。","book":"清·夏敬渠《野叟曝言》第59回"},"similar":["悠然自得","逍遥自在"],"usage":"作谓语、定语、状语；用于人"},{"id":43822,"word":"透古通今","pinyin":"tòu gǔ tōng jīn","abbr":"tgtj","explanation":"形容贯通古今。","source":{"text":"杳冥时，踪迹难寻。无中显有，透古通今。","book":"元·王吉昌《行香子·木金间隔》词"},"usage":"作谓语、定语；用于书面语"},{"id":43823,"word":"透心凉","pinyin":"tòu xīn liáng","abbr":"txl","explanation":"指十分失望。","source":{"text":"把叔宝说个透心凉，只得改口道：‘二位贤弟，若是这等多心，大家同去就罢了。’","book":"清·褚人获《隋唐演义》第15回"},"similar":["心灰意冷"],"usage":"作宾语、定语；多用于比喻句"},{"id":43824,"word":"透骨酸心","pinyin":"tòu gǔ suān xīn","abbr":"tgsx","explanation":"形容极度伤心。","source":{"text":"《儿女英雄传》第五回：“她自己心中，以有一腔的弥天恨事，透骨酸心。"},"usage":"作谓语、定语；指十分伤心"},{"id":43825,"word":"逐兔先得","pinyin":"zhú tù xiān dé","abbr":"ztxd","explanation":"逐：追逐。指众人追野兔，谁先得到就归谁所有。","source":{"text":"今日自付与将军，不可错失。岂不闻‘逐兔先得’之语乎？","book":"明·罗贯中《三国演义》第六十回"},"usage":"作宾语、定语；用于书面语"},{"id":43826,"word":"逐利争名","pinyin":"zhú lì zhēng míng","abbr":"zlzm","explanation":"争夺名位和财利。","source":{"text":"臣闻争名者于朝，争利者于市。","book":"《战国策·秦策一》"},"example":{"text":"闲忙两字无多子。叹举世、皆由此。～忙者事。廛中得丧，仕中宠辱，无限非和是。（宋·史浩《青玉案·劝酒》词）"},"similar":["争名逐利","争名夺利"],"usage":"作谓语、宾语、定语；指名利心重"},{"id":43827,"word":"逐句逐字","pinyin":"zhú jù zhú zì","abbr":"zjzz","explanation":"挨次序一字一句地。","source":{"text":"自上横行退一字成句，逐句逐字逆读，俱成回文。","book":"清·李汝珍《镜花缘》第四十一回"},"example":{"text":"要听他这段虚文合后面的实事，却是～针锋相对。","book":"清·文康《儿女英雄传》第十六回"}},{"id":43828,"word":"逐名趋势","pinyin":"zhú míng qū shì","abbr":"zmqs","explanation":"追求名声和权势。","source":{"text":"世俗之人，交不论志，逐名趋势，热来冷去，见过不改，视迷不救。","book":"晋·葛洪《抱朴子·交际》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":43829,"word":"逐字逐句","pinyin":"zhú zì zhú jù","abbr":"zzzj","explanation":"挨次序一字一句地。","source":{"text":"如果我们只把过去的一些文件逐字逐句照抄一通，那就不能解决任何问题，更谈不到正确地解决什么问题。","book":"邓小平《在全军政治工作会议上的讲话》"},"example":{"text":"她一下又翻到了今年寒假的第一天日记，并饶有兴趣地～看了下去。","book":"程树榛《大学时代》"},"similar":["一字一句"],"opposite":["一目十行"],"usage":"作状语；指认真读写"},{"id":43830,"word":"逐宕失返","pinyin":"zhú dàng shī fǎn","abbr":"zdsf","explanation":"随波流荡而忘却归来。指随逐时俗，而不知返归根本。","source":{"text":"虽絜瓶庸受，逐宕失返，若夫越世扶衰，有足征也。","book":"张尔田《〈词莂〉序》"},"similar":["逐流忘返"],"usage":"作宾语、定语；用于书面语"},{"id":43831,"word":"逐客之令","pinyin":"zhú kè zhī lìng","abbr":"zkzl","explanation":"秦始皇曾下令驱逐从各国来的客卿。后指主人赶走不受欢迎的客人为下逐客令","source":{"text":"今逐客以资敌国，损民以益仇，内自虚而外树怨于诸侯，求国无危，不可得也。秦王乃除逐客之令。","book":"西汉·司马迁《史记·李斯列传》"},"similar":["逐客令"],"usage":"作主语、宾语；用于交往等"},{"id":43832,"word":"逐客令","pinyin":"zhú kè lìng","abbr":"zkl","explanation":"秦始皇曾下令驱逐从各国来的客卿。后指主人赶走不受欢迎的客人为下逐客令。","source":{"text":"二位如再喧哗，不独耽误娇音妙舞，恐金母要下逐客令了。","book":"清·李汝珍《镜花缘》第二回"},"example":{"text":"你再不走，我就下～。"},"similar":["逐客之令"],"usage":"作主语、宾语、定语；常与“下”连用"},{"id":43833,"word":"逐影吠声","pinyin":"zhú yǐng fèi shēng","abbr":"zyfs","explanation":"形容人云亦云，毫无主见。","source":{"text":"至今学文之家，又皆逐影吠声，未尝有公论，实不见古人用心处，予每为之太息。","book":"宋·陈善《扪虱新话·唐宋文章皆三变末流不免有弊》"},"similar":["人云亦云"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":43834,"word":"逐影寻声","pinyin":"zhú yǐng xún shēng","abbr":"zyxs","explanation":"指多方寻求罅隙。","source":{"text":"在廷诸臣好为危言激论，汰如寿宁兄弟，庸驽如郑国泰，已逐影寻声，抨击不遗余力。","book":"《明史·外戚传序》"},"example":{"text":"今奸人～，将甘心于汝。","book":"清·徐瑶《太恨生传》"},"usage":"作谓语、定语；用于比喻句"},{"id":43835,"word":"逐影随波","pinyin":"zhú yǐng suí bō","abbr":"zysb","explanation":"跟着别人的影子走，随着水流飘移。形容无主见。","source":{"text":"思为报复仇，且结张诚欢，故出全力攻之，言官不过逐影随波而已。","book":"明·沈德符《野获编·内监·冯保之败》"},"similar":["随波逐流"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":43836,"word":"逐新趋异","pinyin":"zhú xīn qū yì","abbr":"zxqy","explanation":"逐：追逐。指追求新奇","source":{"text":"夫吃文为患，生于好诡，逐新趋异，故喉唇纠纷；将欲解结，务在刚断。","book":"南朝·梁·刘勰《文心雕龙·声律》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":43837,"word":"逐新趣异","pinyin":"zhú xīn qù yì","abbr":"zxqy","explanation":"指追求新奇。","source":{"text":"夫吃文为患，生于好诡，逐新趣异，故喉唇纠纷；将欲解结，务在刚断。","book":"南朝·梁·刘勰《文心雕龙·声律》"}},{"id":43838,"word":"逐日千里","pinyin":"zhú rì qiān lǐ","abbr":"zrql","explanation":"追逐太阳，奔跑千里。形容马跑得极快","source":{"text":"昂昂逸骥，逐日千里。","book":"南朝·陈·江总《度支尚书陆君谏》"},"usage":"作谓语、定语；用于书面语"},{"id":43839,"word":"逐日追风","pinyin":"zhú rì zhuī fēng","abbr":"zrzf","explanation":"逐日：追逐太阳；追风：追赶风。形容马跑得极快。","source":{"text":"骑则逐日追风，弓则吟猿落雁。","book":"《梁书·元帝纪》"},"usage":"作谓语、宾语、定语；指马跑得快"},{"id":43840,"word":"逐末弃本","pinyin":"zhú mò qì běn","abbr":"zmqb","explanation":"追求细枝末节，舍弃事物根本的、主要的部分。","source":{"text":"今在舅服止一时，为姨居丧五月，徇名丧实，逐末弃本。","book":"唐·魏徵《嫂叔舅服议》"},"similar":["逐末舍本"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43841,"word":"逐末忘本","pinyin":"zhú mò wàng běn","abbr":"zmwb","explanation":"追求细枝末节，忘记事物根本的、主要的部分。","source":{"text":"今题金山而必曰金玉之金，咏赤城而必云赤白之赤，皆逐末忘本之过也。","book":"明·胡应麟《诗薮·近体中》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":43842,"word":"逐末舍本","pinyin":"zhú mò shě běn","abbr":"zmsb","explanation":"追求细枝末节，舍弃事物根本的、主要的部分。","source":{"text":"长吏华浮，奉客以求小誉，逐末舍本，政之所疾，宜谨察之。","book":"《隋书·礼仪志四》"},"similar":["逐末弃本","舍本逐末"],"usage":"作谓语、定语、宾语；用于处事"},{"id":43843,"word":"逐本舍末","pinyin":"zhú běn shě mò","abbr":"zbsm","explanation":"逐：追求。抓住根本，放弃次要的东西","example":{"text":"做事要～，不要舍本逐末"},"opposite":["舍本逐末"],"usage":"作宾语、定语；用于处事"},{"id":43844,"word":"逐机应变","pinyin":"zhú jī yìng biàn","abbr":"zjyb","explanation":"随机应变。","source":{"text":"若固守武牢，以军汜水，逐机应变，禽殄必矣！","book":"《新唐书·郭孝恪传》"},"similar":["随机应变"],"usage":"作谓语、定语；用于书面语"},{"id":43845,"word":"逐流忘返","pinyin":"zhú liú wàng fǎn","abbr":"zlwf","explanation":"随波流荡而忘却归来。指随逐时俗，而不知返归根本。","source":{"text":"不通斯例，则古义不完，逐流忘返，则谬说滋起。","book":"章炳麟《文学说例》"},"similar":["逐宕失返"],"usage":"作宾语、定语；用于书面语"},{"id":43846,"word":"逐浪随波","pinyin":"zhú làng suí bō","abbr":"zlsb","explanation":"逐浪：追逐浪潮；随波：随顺波流。喻指一个人缺乏主见，总是随顺时尚，人云亦云。","source":{"text":"泥滞苟且，没而不觉，随波漂流，与漂俱灭者亦甚众多。","book":"汉·陈琳《檄吴将校部曲文》"},"example":{"text":"群飞独宿水中央，～羽半伤。","book":"陈衍《元诗纪事·宋无》"},"similar":["随波逐流","人云亦云"],"usage":"作定语、状语；指没主见"},{"id":43847,"word":"逐物不还","pinyin":"zhú wù bù huán","abbr":"zwbh","explanation":"指沉湎于世俗。","source":{"text":"流代难寤，逐物不还。至人远鉴，归之自然。","book":"语出《庄子·天下》：“惜乎惠施之才，骀荡而不得，逐万物而不反。”三国·魏·嵇康《赠兄秀才入军》诗之十八"},"example":{"text":"三国·魏·嵇康《赠兄秀才人军》诗：“流代难寤，～。至人远鉴，归之自然。”"},"usage":"作宾语、定语；用于书面语"},{"id":43848,"word":"逐电追风","pinyin":"zhú diàn zhuī fēng","abbr":"zdzf","explanation":"追赶闪电和迅风。形容速度非常快。","source":{"text":"叔宝（秦叔宝）拜辞，连夜起身，出庄上马，纵辔加鞭，如逐电追风，十分迅速。","book":"《说唐》第十回"},"example":{"text":"衣不解带，纵辔加鞭，如～，十分迅捷。","book":"清·禇人获《隋唐演义》第十五回"},"similar":["逐风追电","追风逐电","追风掣电"],"usage":"作宾语、状语；用于比喻句"},{"id":43849,"word":"逐臭之夫","pinyin":"zhú chòu zhī fū","abbr":"zczf","explanation":"追逐奇臭的人。比喻嗜好怪癖，与众不同的人。","source":{"text":"人各有好尚，兰荪蕙之芳，众人之好好，而海畔有逐臭之夫。","book":"《吕氏春秋·遇合》：“人有大臭者，其亲戚兄弟妻妾知识，无能与居者，自苦而居海上。”三国·魏·曹植《与杨德祖书》"},"example":{"text":"海上有～，君其是乎。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录六》"},"usage":"作宾语；指怪人"},{"id":43850,"word":"逐近弃远","pinyin":"zhú jìn qì yuǎn","abbr":"zjqy","explanation":"追求近的，舍弃远的。","source":{"text":"今班《志》所引，上自周之幽厉，下终鲁之定哀，而不云《国语》，惟称《史记》，岂非忘本徇末，逐近弃远者乎？","book":"唐·刘知幾《史通·汉书五行志错误》"},"opposite":["舍近求远"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":43851,"word":"逐逐眈眈","pinyin":"zhú zhú dān dān","abbr":"zzdd","explanation":"觊觎的样子。","source":{"text":"虎视眈眈，其欲逐逐。","book":"语本《易·颐》"}},{"id":43852,"word":"逐队成群","pinyin":"zhú duì chéng qún","abbr":"zdcq","explanation":"形容人多。","source":{"text":"游街的犯人，逐队成群；看游街的闲人，填街塞巷。","book":"清·彭养鸥《黑籍冤魂》第五回"},"example":{"text":"清·彭养鸥《黑籍冤魂》第五回：“游街的犯人，～；看游街的闲人，填街塞巷。”"},"similar":["填街塞巷"],"usage":"作谓语、定语；用于书面语"},{"id":43853,"word":"逐风追电","pinyin":"zhú fēng zhuī diàn","abbr":"zfzd","explanation":"追赶迅风和闪电。","source":{"text":"鸾旗日行三十里，焉用逐风追电为？","book":"宋·秦观《题腰袅图》诗"},"similar":["逐电追风"],"usage":"作宾语、状语；用于比喻句"},{"id":43854,"word":"逐鹿中原","pinyin":"zhú lù zhōng yuán","abbr":"zlzy","explanation":"逐：追赶；鹿：指所要围捕的对象，常比喻帝位、政权。指群雄并起，争夺天下。","source":{"text":"秦失其鹿，天下共逐之。","book":"《史记·淮阴侯列传》"},"example":{"text":"三军在江、淮、河、汉之间布成“品”字形阵势，互为觭角，～，机动歼敌。","book":"刘伯承《千里跃进大别山》"},"similar":["龙争虎斗","鹿死谁手"],"usage":"作谓语、定语；指争夺天下","story":["晋朝时北方的五胡十六国中赵国国王石勒十分有才干，但自以为是，有一次他问大臣徐光他能与历史上哪位皇帝相提并论。徐光答复为汉高祖刘邦。他笑道他只能做刘邦的部下，但与刘秀并驱于中原，相互较量，那就不知鹿死谁手了"]},{"id":43855,"word":"递兴递废","pinyin":"dì xīng dì fèi","abbr":"dxdf","explanation":"指有兴有废。","source":{"text":"德衰世乱，然后天子利天下。国君利国，官长利官，此国所以递兴递废也，乱难之所时作也。","book":"《吕氏春秋·恃君》"},"example":{"text":"成汤有南巢之伐，以殄夏乱。～，胜者用事，所受于天也。","book":"《史记·律书》"},"usage":"作谓语、宾语；用于事情等"},{"id":43856,"word":"递胜递负","pinyin":"dì shèng dì fù","abbr":"dsdf","explanation":"指胜负交替。","source":{"text":"环寇之师且十万，递胜递负，无寸尺功。","book":"清·薛福成《中兴叙略上》"},"example":{"text":"赌博总会有～的时候。","book":"赌棍都会自我安慰地说"},"usage":"作谓语；指胜负交替"},{"id":43857,"word":"途穷日暮","pinyin":"tú qióng rì mù","abbr":"tqrm","explanation":"犹日暮途穷。","source":{"text":"途穷日暮更何求，白首同拼一死休。","book":"清黄遵宪《群公》诗"},"similar":["途遥日暮","日暮途穷"],"usage":"作谓语、宾语、定语；指陷于绝境"},{"id":43858,"word":"途途是道","pinyin":"tú tú shì dào","abbr":"ttsd","explanation":"指头头是道。说话或做事很有条理。","source":{"text":"女人的幸福是看他的丈夫怎样，应该先努力安排一个家等等，这样或者那样，说得途途是道。","book":"聂绀弩《题记一》"},"similar":["头头是道"],"usage":"作状语；指说话做事"},{"id":43859,"word":"途遥日暮","pinyin":"tú yáo rì mù","abbr":"tyrm","explanation":"犹日暮途穷。比喻到了走投无路的或衰亡的境地。","source":{"text":"吾日暮途远，故倒行暴施之。","book":"语出《史记·平津侯主父列传》"},"example":{"text":"～，父乃后时。","book":"唐孙逖《陈情表》"},"similar":["途穷日暮","日暮途穷"],"usage":"作谓语、宾语、定语；指陷于绝境"},{"id":43860,"word":"逖听远闻","pinyin":"tì tīng yuǎn wén","abbr":"ttyw","explanation":"谓视听范围很远很广。","source":{"text":"庶以矜隐之念，昭被四方，逖听远闻，事均亲览。","book":"唐·姚思廉《梁书·武帝纪中》"},"similar":["逖听遐视"],"usage":"作谓语；指视听的范围很远"},{"id":43861,"word":"逖听遐视","pinyin":"tì tīng xiá shì","abbr":"ttxs","explanation":"指视听范围很远很广。","source":{"text":"圣主明目达聪，逖听遐视，罪其私冒不慎举者，小加谴责，大正刑典，责成授任，谁敢不勉？","book":"《新唐书·选举志下》"},"usage":"作谓语、定语；用于书面语"},{"id":43862,"word":"逗留不进","pinyin":"dòu liú bù jìn","abbr":"dlbj","explanation":"逗留：停顿。停顿不向前走。","source":{"text":"而祁连知虏在前，逗遛不进。","book":"《汉书·匈奴传》"},"example":{"text":"不意两人～，反通电中外及自主诸省，商请双方停战。","book":"蔡东藩、许廑父《民国通俗演义》第九十回"},"similar":["徘徊不前"],"usage":"作谓语；指停顿不前"},{"id":43863,"word":"通上彻下","pinyin":"tōng shàng chè xià","abbr":"tscx","explanation":"①指从天到地。②从上到下。指所有的人。","source":{"text":"天地是举其大体而言，鬼神是举其中运动变化者，通上彻下而言。","book":"宋·朱熹《朱子语类》第73卷"},"example":{"text":"《三宝太监西洋记通俗演义》第78回：“取过袍笏、冠带、靴袜之类，～，回敬一周。”"},"usage":"作定语、状语；用于书面语"},{"id":43864,"word":"通书达礼","pinyin":"tōng shū dá lǐ","abbr":"tsdl","explanation":"指通诗书，懂礼仪。","source":{"text":"原来田氏是东村田贡元的女儿，倒有十分颜色，又且通书达礼。","book":"明·冯梦龙《喻世明言》第二卷"},"similar":["知书达理"],"usage":"作谓语、定语；用于处事等"},{"id":43865,"word":"通人达才","pinyin":"tōng rén dá cái","abbr":"trdc","explanation":"通人：指学识渊博的人；达才：通达事理的人才。指知识广博，通达古今的人才。","source":{"text":"《易》之为术，幽明远矣，非通人达才孰能注意焉。","book":"《史记·田敬仲完世家》"},"usage":"作宾语、定语；用于书面语"},{"id":43866,"word":"通今博古","pinyin":"tōng jīn bó gǔ","abbr":"tjbg","explanation":"通：通晓；博：广博，知道得多。现代和古代的事情知道得很多。形容知识渊博。","source":{"text":"吾闻老聃博古知今。","book":"《孔子家语·观周》"},"example":{"text":"兼且～，出口成文，因此号为文美。 ◎明·冯梦龙《东周列国志》第九回"},"usage":"联合式；作谓语、定语；含褒义"},{"id":43867,"word":"通今达古","pinyin":"tōng jīn dá gǔ","abbr":"tjdg","explanation":"形容知识渊博。同“通今博古”。","source":{"text":"述学派之流别，论政治之得失，纵有通今达古之才，而无瑰玮奇丽之笔，言之无文，行之不远。","book":"胡蕴玉《序》"},"similar":["通今博古","博古通今"],"usage":"作谓语、定语；用于书面语"},{"id":43868,"word":"通俗易懂","pinyin":"tōng sú yì dǒng","abbr":"tsyd","explanation":"广大人民群众都能懂得。","source":{"text":"这十六个字，通俗易懂。","book":"邓小平《跃进中原的胜利形势与今后的政策策略》"},"example":{"text":"我们要用～的语言来写报告。"},"similar":["老妪能解"],"usage":"作谓语、定语；指简单明白"},{"id":43869,"word":"通儒硕学","pinyin":"tōng rú shuò xué","abbr":"trsx","explanation":"犹言通儒达士。指知识渊博、明智达理的学者。","source":{"text":"弱冠游学都下，通儒硕学，必造门质疑，计论无倦。","book":"《南史·贺瑒传》：“通儒硕学，复见贺生。今且还城，寻当相屈。”又《儒林传·顾越》"},"example":{"text":"《儒林传·顾越》：“弱冠游学部下，～，必造门质疑，讨论无倦。”"},"similar":["通儒达识","通儒达士"],"usage":"作宾语、定语；用于书面语"},{"id":43870,"word":"通儒达士","pinyin":"tōng rú dá shì","abbr":"trds","explanation":"指知识渊博、明智达理的学者。"},{"id":43871,"word":"通儒达识","pinyin":"tōng rú dá shí","abbr":"trds","explanation":"指知识渊博、明智达理的学者。同“通儒达士”。","source":{"text":"汉之于周，世代于此，通儒达识，不以为非。","book":"《南齐书·礼志》"},"similar":["通儒达士"],"usage":"作主语、宾语、定语；用于书面语"},{"id":43872,"word":"通元识微","pinyin":"tōng yuán shí wēi","abbr":"tysw","explanation":"通晓玄奥微妙的道理。","source":{"text":"孔子睹庙器而知持盈之理，聆琴音而思文王之德，倘有通元识微之士，能于器数之间，仰溯圣人之蕴者，则有司存焉。","book":"明·张居正《礼乐记》"},"usage":"作谓语、定语；用于书面语"},{"id":43873,"word":"通共有无","pinyin":"tōng gòng yǒu wú","abbr":"tgyw","explanation":"指互相接济；互通有无。","source":{"text":"俊振济贫乏，通共有无。","book":"晋·陈寿《三国志·魏志·杨俊传》"},"example":{"text":"宋·叶适《序》：“方其家居，得朋友，～，并坐接席，不知岁月迁改。”"},"similar":["互通有无","通无共有"],"usage":"作谓语、定语；用于书面语"},{"id":43874,"word":"通前彻后","pinyin":"tōng qián chè hòu","abbr":"tqch","explanation":"通：贯通；彻：通达，深透。指贯通于前后。","source":{"text":"只是我方才通前彻后一想，这件事，二叔，你老人家料估得防范得计算得都不差。","book":"清·文康《儿女英雄传》"},"example":{"text":"清·文康《儿女英雄传》第23回：“如今说书的从旁指点桃源路，引得渔郎来问津，算～交待明白了，然后再言归正传。”"},"similar":["通前澈后","通前至后"],"usage":"作定语、状语；用于书面语"},{"id":43875,"word":"通前澈后","pinyin":"tōng qián chè hòu","abbr":"tqch","explanation":"从开头到结尾。全部，整个。同“通前彻后”。","source":{"text":"只要这等通前澈后一算，就知道这书不是脱岔露空了。","book":"清·文康《儿女英雄传》第26回"},"similar":["通前彻后","通前至后"],"usage":"作定语、状语；用于书面语"},{"id":43876,"word":"通前至后","pinyin":"tōng qián zhì hòu","abbr":"tqzh","explanation":"从开头到结尾。全部，整个。同“通前彻后”。","source":{"text":"先从左壁上起，将手捻定，通前至后，凡有字处，次等拂过，共一十三张。","book":"《平妖传》第十一回"},"similar":["通前澈后","通前彻后"],"usage":"作定语、状语；用于书面语"},{"id":43877,"word":"通力合作","pinyin":"tōng lì hé zuò","abbr":"tlhz","explanation":"通力：一起出力。不分彼此，一齐出力。","source":{"text":"一夫受田百亩，而与同沟共井之人通力合作，计亩均收。","book":"《论语·颜渊》：“盍彻乎”朱熹注"},"example":{"text":"都在向我们说明～，进向平和的建设的道路。","book":"鲁迅《且介亭杂文末编·记苏联版画展览会》"},"similar":["合情合理","同心协力"],"opposite":["名行其事","不近情理"],"usage":"作谓语、宾语；指大力支持"},{"id":43878,"word":"通功易事","pinyin":"tōng gōng yì shì","abbr":"tgys","explanation":"分工合作，互通有无，拿多余的换没有的。","source":{"text":"子不通功易事，以羡补不足，则农有余粟，女有余布。","book":"《孟子·滕文公下》"},"example":{"text":"于是～，择其公且贤者，立而为之君。","book":"严复《辟韩》"},"similar":["通工易事"],"usage":"作谓语；指分工合作"},{"id":43879,"word":"通南彻北","pinyin":"tōng nán chè běi","abbr":"tncb","explanation":"指贯穿南北。","source":{"text":"又往前走，就看见东山根通南彻北的一条河从北边的山缝里钻出来，又钻进南边的山缝里去。","book":"赵树理《三里湾》"},"usage":"作谓语、定语；用于方位等"},{"id":43880,"word":"通变达权","pinyin":"tōng biàn dá quán","abbr":"tbdq","explanation":"做理能适应客观情况的变化，懂得变通，不死守常规。同“通权达变”。","source":{"text":"二公通变达权，皆可为长民者之法也。","book":"明·田汝成《西湖游览志余·熙朝乐事》"},"similar":["通权达变","通时达变"],"usage":"作谓语、宾语、定语；指人灵活机动"},{"id":43881,"word":"通古博今","pinyin":"tōng gǔ bó jīn","abbr":"tgbj","explanation":"形容知识渊博。同“通今博古”。","source":{"text":"你是一个老大学生了，通古博今，知书达理，何必与姚金根那种人一般见识，他小人得志。","book":"《钟山》1981年第4期"},"similar":["通今博古"],"usage":"作谓语、定语；指学识渊博"},{"id":43882,"word":"通古达变","pinyin":"tōng gǔ dá biàn","abbr":"tgdb","explanation":"通晓古代的学问，根据实际情况灵活行事。","source":{"text":"非经天纬地、通古达变者，其文不贵，则文学得其士也。","book":"宋·王禹偁《省试四科取士何先论》"},"usage":"作谓语、定语；用于书面语"},{"id":43883,"word":"通同一气","pinyin":"tōng tóng yī yì","abbr":"ttyq","explanation":"串通在一起。","source":{"text":"况且打死的贼是周瑞的干儿子，必是他们通同一气的。","book":"清·曹雪芹《红楼梦》第110回"},"example":{"text":"他们两人早就～了。"},"similar":["串通一气"],"usage":"作谓语；指串通一气"},{"id":43884,"word":"通同作弊","pinyin":"tōng tóng zuò bì","abbr":"ttzb","explanation":"作弊：用欺骗的手段做违法乱纪或不合规定的事情。串通一起做坏事。","source":{"text":"你与孩儿通同作弊，乱我家法。","book":"元·白朴《墙头马上》第三折"},"example":{"text":"臣细谅度，必是祝鹍、刁应祥等，～，受赂卖放，复将假首诳上，冒功请贷，情迹显然。","book":"明·方汝浩《禅真逸史》第十二回"},"similar":["共同舞弊"],"usage":"作谓语；指合伙共同舞弊"},{"id":43885,"word":"通商惠工","pinyin":"tōng shāng huì gōng","abbr":"tshg","explanation":"通商：便利各地货物交流；惠：给人以好处。使贸易畅通，给工商业者带来好处。","source":{"text":"务材训农，通商惠工。","book":"《左传·闵公二年》"},"example":{"text":"日后战乱停止，我将使国家轻摇薄赋，吏治清明，兴学校，奖农桑，～。","book":"姚雪垠《李自成》第二卷第三十六章"},"usage":"作宾语、定语；用于经济管理"},{"id":43886,"word":"通天彻地","pinyin":"tōng tiān chè dì","abbr":"ttcd","explanation":"彻：通，透。形容本领高强。","source":{"text":"举目遥观十万里，通天彻地人难比。","book":"明·无名氏《双林坐化》第二折"},"example":{"text":"清·李百川《绿野仙踪》第61回：“圣母修道五千余年，法力～。”"},"usage":"作谓语、定语、状语；用于书面语"},{"id":43887,"word":"通天本领","pinyin":"tōng tiān běn lǐng","abbr":"ttbl","explanation":"上通于天的本领。比喻本领极大。","source":{"text":"我主意拿的老老的，你纵有通天本领，也无奈我何。","book":"清·李汝珍《镜花缘》第八十四回"},"example":{"text":"因此若不是五岳派门下，不论他有～，可也不能见猎心喜，一时手痒，下场角逐。","book":"金庸《笑傲江湖》第三十三回"}},{"id":43888,"word":"通天达地","pinyin":"tōng tiān dá dì","abbr":"ttdd","explanation":"犹言顶天立地。形容形象高大，气慨豪迈。","source":{"text":"俺是通天达地，有一无二，带管本山山寨头名寨主女将军。","book":"《三宝太监西洋记通俗演义》第三六回"},"similar":["顶天立地"],"usage":"作谓语、定语、状语；用于书面语"},{"id":43889,"word":"通宵守夜","pinyin":"tōng xiāo shǒu yè","abbr":"txsy","explanation":"通宵不眠或整夜祈祷的行为。","example":{"text":"你不能～，搞坏了身体。"},"similar":["彻夜不眠"],"usage":"作谓语、定语、宾语；指通宵不眠"},{"id":43890,"word":"通宵彻夜","pinyin":"tōng xiāo chè yè","abbr":"txcy","explanation":"指整夜。","source":{"text":"他爱我……通宵彻夜之妙。你与姐姐说，不要轻慢人。","book":"明·无心子《金雀记·守贞》"}},{"id":43891,"word":"通宵彻旦","pinyin":"tōng xiāo chè dàn","abbr":"txcd","explanation":"指整天整夜。同“通宵彻昼”。","source":{"text":"秋谷知道自己寒热来得厉害的时候，他们两人都是通宵彻旦的伏侍，心上十分感激。","book":"《九尾鱼》第169回"},"similar":["通宵彻昼"],"usage":"作定语、状语；用于书面语"},{"id":43892,"word":"通宵彻昼","pinyin":"tōng xiāo chè zhòu","abbr":"txcz","explanation":"指整天整夜。","source":{"text":"通宵彻昼不暂停，堆积楼台满溪谷。","book":"宋·韩琦《广陵大雪》诗"},"similar":["通宵彻旦","通宵彻夜"],"usage":"作定语、状语；用于书面语"},{"id":43893,"word":"通宵达旦","pinyin":"tōng xiāo dá dàn","abbr":"txdd","explanation":"通宵：通夜，整夜；达：到；旦：天亮。整整一夜，从天黑到天亮。","source":{"text":"乙校昨夜通宵达旦，将赤化书籍完全焚烧矣。","book":"鲁迅《华盖集续编·无花的蔷薇之三》"}},{"id":43894,"word":"通家之好","pinyin":"tōng jiā zhī hǎo","abbr":"tjzh","explanation":"指两家交情深厚，象一家人一样。","source":{"text":"有西邻赵国器，是这扬州奴父亲，与老夫三十载通家之好。","book":"元·秦简夫《东堂老》第四折"},"example":{"text":"卑下意欲往谒洛中，以修～，娘子意下如何？（明·汪廷讷《狮吼记·叙别》）"},"usage":"作宾语；用于两者的关系"},{"id":43895,"word":"通家之谊","pinyin":"tōng jiā zhī yì","abbr":"tjzy","explanation":"指两家交情深厚，象一家人一样。","source":{"text":"原来杨安居在郭元振门下做个幕僚，与郭仲翔虽未厮认，却有通家之谊；又且他是个正人君子，不以存亡易心。","book":"明·冯梦龙《喻世明言》卷八"},"example":{"text":"现请闻先生为西席，～，极是便的是便的。","book":"清·陈忱《水浒后传》第十九回"}},{"id":43896,"word":"通工易事","pinyin":"tōng gōng yì shì","abbr":"tgys","explanation":"分工合作，互通有无，拿多余的换没有的。同“通功易事”。"},{"id":43897,"word":"通幽动微","pinyin":"tōng yōu dòng wēi","abbr":"tydw","explanation":"通晓、洞察幽深而细微的道理。同“通幽洞微”。","source":{"text":"推五岳即须臾，制约宇宙，造化之内，无人可皆，通幽动微。","book":"《敦煌变文集·叶净能诗》"},"similar":["通幽洞微"],"usage":"作谓语、定语；用于处事"},{"id":43898,"word":"通幽洞冥","pinyin":"tōng yōu dòng míng","abbr":"tydm","explanation":"通晓、洞察幽冥之事。","source":{"text":"文成作师，通幽洞冥。","book":"晋·陆机《汉高祖功臣颂》"},"example":{"text":"宋·张君房《云笈七签》第53卷：“～，吞咽九灵。”"},"similar":["通幽洞灵"],"usage":"作谓语、定语；用于书面语"},{"id":43899,"word":"通幽洞微","pinyin":"tōng yōu dòng wēi","abbr":"tydw","explanation":"通晓、洞察细微而幽深的道理。","source":{"text":"并钩深索隐，通幽洞微。","book":"宋·释普济《五灯会元·佛光满禅师法嗣》"},"similar":["通幽动微"],"usage":"作谓语、定语；用于处事"},{"id":43900,"word":"通幽洞灵","pinyin":"tōng yōu dòng líng","abbr":"tydl","explanation":"通晓、洞察幽冥灵异之事。","source":{"text":"尚辨天意，犹测地情。况我神造，通幽洞灵。","book":"南朝·梁·陆倕《新刻漏铭》"},"similar":["通幽洞冥"],"usage":"作谓语、定语；用于书面语"},{"id":43901,"word":"通忧共患","pinyin":"tōng yōu gòng huàn","abbr":"tygh","explanation":"共同承担忧患。","source":{"text":"尝推先王之意，非徒集思广益，通达民情，实以通忧共患，给民合志。","book":"康有为《上皇帝第二书》"},"usage":"作谓语、定语；用于处事"},{"id":43902,"word":"通情达理","pinyin":"tōng qíng dá lǐ","abbr":"tqdl","explanation":"通、达：懂得；情：人之常情；理：道理。指说话、做事很讲道理。","source":{"text":"只因民间有万不通情达理者，遂尔家有殊俗。","book":"清·李绿园《歧路灯》第八十五回"},"example":{"text":"他是个～的人，从来不胡搅蛮缠。"},"similar":["合情合理","善解人意"],"opposite":["强词夺理","不明事理"],"usage":"作谓语、定语、补语；指说话、做事很讲道理"},{"id":43903,"word":"通才硕学","pinyin":"tōng cái shuò xué","abbr":"tcsx","explanation":"学识通达渊博的人。","source":{"text":"一般自命开通之学生，粗得西学皮毛，辄满口名词，自诩为通才硕学……有不可一世之概。","book":"郑观应《致家塾潘教习论朱星源十大学书》"},"usage":"作宾语、定语；用于书面语"},{"id":43904,"word":"通才练识","pinyin":"tōng cái liàn shí","abbr":"tcls","explanation":"通才：学识渊博的人。指博学多才，见识练达。","source":{"text":"夫其通才练识，赡学多闻，翰墨之工，文章之美，皆忘其所能也。","book":"唐·崔尚《唐天台山新桐柏观之颂序》"},"similar":["通材达识"],"usage":"作宾语、定语；用于书面语"},{"id":43905,"word":"通才达识","pinyin":"tōng cái dá shí","abbr":"tcds","explanation":"通才：指学识渊博，具有多种才能的人；达识：通晓事理。形容学贯古今，才识兼备的人。","source":{"text":"世之论者，以为言不尽意，由来尚矣，至于通才达识，咸以为然。","book":"晋·欧阳建《言近意论》"}},{"id":43906,"word":"通文知理","pinyin":"tōng wén zhī lǐ","abbr":"twzl","explanation":"通晓文墨，懂得道理。指人有知识，懂道理。","source":{"text":"这小姐必是通文知理，无所不晓，竟是绝代佳人。","book":"清·曹雪芹《红楼梦》第五十四回"}},{"id":43907,"word":"通文调武","pinyin":"tōng wén diào wǔ","abbr":"twdw","explanation":"指卖弄文才和武艺。","source":{"text":"我这里是甚麽衙门？谁许你通文调武，可恶！","book":"明·无名氏《精忠记·严刑》"},"usage":"作谓语、定语；用于书面语"},{"id":43908,"word":"通文达理","pinyin":"tōng wén dá lǐ","abbr":"twdl","explanation":"指有学问懂道理。","source":{"text":"周员外，依你这许多通文达理，我道为些什么，不过要我替丈夫娶妾么！","book":"明·伏雌教主《醋葫芦》第二回"},"example":{"text":"叶圣陶《城中》：“～的父兄们便这么说：‘就是天下的学堂全都关完了……’”"},"similar":["知书达理"],"usage":"作谓语、定语；用于处事"},{"id":43909,"word":"通文达礼","pinyin":"tōng wén dá lǐ","abbr":"twdl","explanation":"指有学问懂礼仪。","source":{"text":"况甥女虽系一小小村女，然读书识字，通文达礼，有才有德，不减古之列女，岂有上以白壁之姿，下就青衣之列？","book":"清·荻岸山人《平山冷燕》第七回"},"similar":["通文达理"],"usage":"作谓语、定语；用于处事"},{"id":43910,"word":"通文达艺","pinyin":"tōng wén dá yì","abbr":"twdy","explanation":"多才多艺，知识渊博。","source":{"text":"我们老和尚是个通文达艺之人，却又慈悲太过。","book":"《西游补》第一回"},"usage":"作谓语、定语；用于书面语"},{"id":43911,"word":"通无共有","pinyin":"tōng wú gòng yǒu","abbr":"twgy","explanation":"指互相接济；互通有无。同“通共有无”。","source":{"text":"建翁内事两世母，奉从兄，抚幼弟；外交朋友，接乡里，通无共有。","book":"宋·叶适《刘建翁墓志铭》"},"similar":["通共有无"],"usage":"作谓语、定语；用于书面语"},{"id":43912,"word":"通时合变","pinyin":"tōng shí hé biàn","abbr":"tshb","explanation":"做理能适应客观情况的变化，懂得变通，不死守常规。同“通权达变”。","source":{"text":"立者非他，通时合变，不随俗为陈言者是已。","book":"清·梅曾亮《复上汪尚书书》"},"similar":["通权达变","通时达变"],"usage":"作谓语、定语；用于处事"},{"id":43913,"word":"通时达务","pinyin":"tōng shí dá wù","abbr":"tsdw","explanation":"指了解客观形势。","source":{"text":"而通时达务之士，则又群相惊惧危恐，蓄缩而莫取出一言。","book":"清·陈确《答沈朗思书》"},"usage":"作谓语、定语；用于处事"},{"id":43914,"word":"通时达变","pinyin":"tōng shí dá biàn","abbr":"tsdb","explanation":"做理能适应客观情况的变化，懂得变通，不死守常规。同“通权达变”。","source":{"text":"《左氏》义深于君父，《公羊》多任于权变。","book":"《后汉书·贾逵传》"},"example":{"text":"天下大乱，豪杰蜂起，胜得人附，败即附人，你既自称豪杰，正当～，何苦轻生？","book":"蔡东藩《明史演义》第六回"},"similar":["通权达变"],"usage":"作谓语、宾语、定语；用于处事"},{"id":43915,"word":"通权达变","pinyin":"tōng quán dá biàn","abbr":"tqdb","explanation":"通、达：通晓，懂得；权、变：权宜，变通。做理能适应客观情况的变化，懂得变通，不死守常规。","source":{"text":"《左氏》义深于君父，《公羊》多任于权变。","book":"《后汉书·贾逵传》"},"example":{"text":"满朝大臣中没有一个人在做事干练和～上能够比得杨嗣昌的。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["随机应变","看风使舵","通时达变"],"opposite":["刻舟求剑"],"usage":"作谓语、宾语、定语；指人灵活机动"},{"id":43916,"word":"通权达理","pinyin":"tōng quán dá lǐ","abbr":"tqdl","explanation":"通晓权宜与事理。","source":{"text":"因行聘志，通权达理，六博是也。","book":"汉·王粲《弹棋赋》序"},"usage":"作谓语、定语；用于处事"},{"id":43917,"word":"通材达识","pinyin":"tōng cái dá shí","abbr":"tcds","explanation":"指博学多才、见识练达的人。同“通才练识”。","source":{"text":"至于通材达识，义烈节士，嘉言善状，皆见于篇，则足为后法。","book":"宋·曾巩《寄欧阳舍人书》"},"similar":["通才练识"],"usage":"作宾语、定语；用于书面语"},{"id":43918,"word":"通盘酬算","pinyin":"tōng pán chóu suàn","abbr":"tpcs","explanation":"统一筹划，全面照顾。"},{"id":43919,"word":"通真达灵","pinyin":"tōng zhēn dá líng","abbr":"tzdl","explanation":"与神仙交往。","source":{"text":"太上四明，九门发精，耳目玄彻，通真达灵。","book":"《云笈七签》卷四七"},"usage":"作谓语、定语；用于书面语"},{"id":43920,"word":"通脱不拘","pinyin":"tōng tuō bù jū","abbr":"ttbj","explanation":"通脱：放达不拘小节。放达而不受礼法和世俗偏见的束缚。","source":{"text":"你从前那么通脱不拘，大家都称赞。","book":"叶圣陶《微波》"},"usage":"作谓语、宾语；用于书面语"},{"id":43921,"word":"通行无阻","pinyin":"tōng xíng wú zǔ","abbr":"txwz","explanation":"毫无阻碍地通行或通过。","source":{"text":"李希烈攻逼汴、郑，江、淮路绝，朝贡皆自宣、饶、荆、襄趣武关。皋治邮驿，平道路，由是往来之使，通行无阻。","book":"《资治通鉴·唐纪·德宗建中四年》"},"example":{"text":"二十年前这令牌在江湖上真有莫大的威势，不论是谁拿在手中，东至九江，西至成都，任凭～。","book":"金庸《射雕英雄传》第二十六回"},"similar":["畅通无阻"],"usage":"作谓语、定语、状语；形容没有阻碍"},{"id":43922,"word":"通衢大道","pinyin":"tōng qú dà dào","abbr":"tqdd","explanation":"通衢：四通八达的道路；道：道路。四通八达的道路。","source":{"text":"二使者押绍之后，通衢广漠，杳不可知际，行五十许里。","book":"唐·牛僧孺《玄怪录·崔绍》"},"example":{"text":"这里并不是～，要下大客店可没有。","book":"清·吴趼人《恨海》第三回"}},{"id":43923,"word":"通衢大邑","pinyin":"tōng qú dà yì","abbr":"tqdy","explanation":"四通八达的大都会、大城市。同“通都大邑”。","source":{"text":"又令通衢大邑设立官局，民以他省钞至者，验明准其换本省钞行用。","book":"清·王瑬《钞币议》"},"similar":["通都大邑"],"usage":"作宾语；泛指大城市"},{"id":43924,"word":"通衢广陌","pinyin":"tōng qú guǎng mò","abbr":"tqgm","explanation":"通衢：四通八达的道路；陌：田间小路。四通八达的大路和空旷的小路。","source":{"text":"二使者押绍之后，通衢广漠，杳不可知际，行五十许里。","book":"唐·牛僧孺《玄怪录·崔绍》"},"example":{"text":"曾朴《孽海花》第23回：“只觉得先走的倒都是平如砥、直如绳的～，一片太阳光照着马蹄蹴起的香尘，一闪一闪的发出金光。”"},"usage":"作主语、宾语、定语；用于书面语"},{"id":43925,"word":"通衢越巷","pinyin":"tōng qú yuè xiàng","abbr":"tqyx","explanation":"衢：大街；巷：小巷。穿过大街，越过小巷。","source":{"text":"至二十八日，两府中俱悬灯结彩，屏开鸾凤，褥设芙蓉，笙箫鼓乐之音，通衢越巷。","book":"清·曹雪芹《红楼梦》第七十一回"}},{"id":43926,"word":"通计熟筹","pinyin":"tōng jì shú chóu","abbr":"tjsc","explanation":"全面考虑，仔细筹划。","source":{"text":"拟于旬日之间出赴中路之虎门、澳门等处，与水师提臣关天培乘船周览，以便相机度势，通计熟筹。","book":"清·林则徐《报告抵粤日期并体察洋面堵截趸船情形折》"}},{"id":43927,"word":"通财之谊","pinyin":"tōng cái zhī yì","abbr":"tczy","explanation":"通：往来，交接。指在财物方面有互相接济，互通有无的情谊。","source":{"text":"你虽是个便家，况你我还有个通财之谊。只是你在差次，那有许多银子？","book":"清·文康《儿女英雄传》第十三回"},"usage":"作宾语；用于交往等"},{"id":43928,"word":"通身是胆","pinyin":"tōng shēn shì dǎn","abbr":"tssd","explanation":"形容胆量大，无所畏惧。","source":{"text":"先主明旦自来，至云营围视昨战处。曰：‘子龙一身都是胆也！’","book":"《三国志·蜀书·赵云传》裴松之注引《赵云别传》"},"example":{"text":"手辟洪蒙破混茫，浪翻古今是非场。～通身识，死后名多道益彰。","book":"明·冯元仲《吊李卓吾先生墓诗》"}},{"id":43929,"word":"通达古今","pinyin":"tōng dá gǔ jīn","abbr":"tdgj","explanation":"通达：明白。对古代的事知道得很多，并且通晓现代的事情。形容知识丰富。","source":{"text":"吾闻老聃博古知今。","book":"《孔子家语·观周》"},"example":{"text":"次用策论，使～之事变，以察其才猷。","book":"《清史稿·选举志》"},"similar":["通今博古"],"usage":"作谓语、定语；用于人的学识等"},{"id":43930,"word":"通达谙练","pinyin":"tōng dá ān liàn","abbr":"tdal","explanation":"通达：明白；谙练：熟悉，熟练。深知人情事理，处理问题老练。","source":{"text":"这人既如此通达谙练，岂有连个礼的轻重过节儿，他也不明白的理？","book":"清·文康《儿女英雄传》第二回"}},{"id":43931,"word":"通邑大都","pinyin":"tōng yì dà dōu","abbr":"tydd","explanation":"四通八达的大都会、大城市。同“通都大邑”。","source":{"text":"仆诚已著此书，藏之名山，传之其人，通邑大都，则仆偿前辱之责，虽万被戮，岂有悔哉！","book":"汉·司马迁《报任少卿书》"},"example":{"text":"～不以封。今命侯之家专择雄奥，滑州七县，而分封者五，王赋少于侯租，入家倍於输国。","book":"《新唐书·宋务光传》"},"similar":["通都大邑"],"usage":"作宾语；泛指大城市"},{"id":43932,"word":"通都大埠","pinyin":"tōng dōu dà bù","abbr":"tddb","explanation":"四通八达的大都会、大城市。同“通都大邑”。","source":{"text":"近年以来，朝野上下，始从事于女子教育问题，通都大埠之间，女校相继成立。","book":"燕斌《发刊词》"},"similar":["通都巨邑","通都大邑"],"usage":"作宾语；泛指大城市"},{"id":43933,"word":"通都大邑","pinyin":"tōng dū dà yì","abbr":"tddy","explanation":"都：都市；邑：城。四通八达的大都会、大城市。","source":{"text":"今天下所谓通都大邑，十里之城，万户之郭。","book":"宋·苏辙《民政策下·第三道》"},"example":{"text":"商之所在，必～。","book":"清·黄宗羲《万里寻兄记》"},"similar":["通邑大都"],"opposite":["偏乡僻壤"],"usage":"作宾语；泛指大城市"},{"id":43934,"word":"通都巨邑","pinyin":"tōng dōu jù yì","abbr":"tdjy","explanation":"四通八达的大都会、大城市。同“通都大邑”。","source":{"text":"通都巨邑虽有大学，而格致、诚、正、修、齐、治平之事不问矣。","book":"郑观应《致家塾潘教习论朱星源小大学书》"},"similar":["通都大埠","通都大邑"],"usage":"作宾语；泛指大城市"},{"id":43935,"word":"通险畅机","pinyin":"tōng xiǎn chàng jī","abbr":"txcj","explanation":"使险要之地畅通无阻。"},{"id":43936,"word":"通风报信","pinyin":"tōng fēng bào xìn","abbr":"tfbx","explanation":"风：风声。把对立双方中一方的机密暗中告诉另一方。","source":{"text":"那掌柜的说他恶毒，跟手叫送棺材到陈府上去的通风报信，一面地保就在内看守了这掌柜的。","book":"清·颐锁《黄绣球》第二十回"},"example":{"text":"他立刻掉头，抄横巷子赶回冼大妈的竹寮，打算给那几个共产党员～。（欧阳山《三家巷》二十六）"},"usage":"联合式；作谓语；指暗中传递消息"},{"id":43937,"word":"通风报讯","pinyin":"tōng fēng bào xùn","abbr":"tfbx","explanation":"把对立双方中一方的机密暗中告诉另一方。同“通风报信”。","source":{"text":"徐大奎进城到县衙门去了，芹姊觑了便，才赶回来通风报讯给我们。","book":"秦牧《愤怒的海》"},"similar":["通风报信"],"usage":"作谓语、定语、宾语；指暗中传递消息"},{"id":43938,"word":"通风讨信","pinyin":"tōng fēng tǎo xìn","abbr":"tftx","explanation":"犹言通风报信。把对立双方中一方的机密暗中告诉另一方。","source":{"text":"宫城中不比民家，虽皇后贵妃，难与父母往来，况宫女禁闭在内，谁能通风讨信。","book":"明·沈鲸《双珠记·京邸叙亲》"},"similar":["通风报信"],"usage":"作谓语、宾语、定语；指暗中传递消息"},{"id":43939,"word":"通首至尾","pinyin":"tōng shǒu zhì wěi","abbr":"tszw","explanation":"从开始到结尾。犹言原原本本。","source":{"text":"蕙娘将前前后后，通首至尾，说了一遍。","book":"清·李百川《绿野仙踪》第83回"},"similar":["从头至尾","原原本本"],"usage":"作定语、状语；用于书面语"},{"id":43940,"word":"逝将去汝","pinyin":"shì jiāng qù rǔ","abbr":"sjqr","explanation":"诀别之辞。"},{"id":43941,"word":"逝者如斯","pinyin":"shì zhě rú sī","abbr":"szrs","explanation":"用以形容光阴如流水一去不返。","source":{"text":"子在川上曰：‘逝者如斯夫！不舍昼夜。’","book":"《论语·子罕》"},"example":{"text":"感朝露，悲人生，～安得停。","book":"晋·陆机《乐府·顺东西门行》"},"similar":["光阴似箭"],"usage":"作谓语、定语；指光阴似流水"},{"id":43942,"word":"逞凶肆虐","pinyin":"chěng xiōng sì nüè","abbr":"cxsn","explanation":"逞：施展。肆：放肆。虐：残暴。放纵地行凶作恶，任意地进行残害。","example":{"text":"敌人在占领区内～，激起人们的奋起反抗。"},"similar":["逞凶肆暴"],"usage":"作谓语、宾语、定语；用于坏人"},{"id":43943,"word":"逞奇眩异","pinyin":"chěng qí xuàn yì","abbr":"cqxy","explanation":"指炫耀奇异。","source":{"text":"虽然，圣贤固非逞奇眩异，苟为制作以骇于天下，则其始之为象也，将谓其足以该道也。","book":"明·归有光《太极在先天范围之内》"},"usage":"作谓语、宾语；用于卖弄"},{"id":43944,"word":"逞妍斗色","pinyin":"chěng yán dòu sè","abbr":"cyds","explanation":"形容花儿盛开，竞相逞美。","source":{"text":"再看那岸上的蓼花苇叶，也都觉摇摇落落，似有追忆故人之态，迥非素常逞妍斗色可比。","book":"《红楼梦》第七九回"},"similar":["逞娇呈美","争奇斗艳"],"usage":"作谓语、定语、宾语；多用于花草"},{"id":43945,"word":"逞娇呈美","pinyin":"chěng jiāo chéng měi","abbr":"cjcm","explanation":"指花草显示出美丽的颜色。","source":{"text":"凭栏轩晓望迟迟，满苑逞娇呈美。","book":"明·陆采《怀香记·春闺寄简》"},"similar":["逞妍斗色"],"usage":"作谓语、定语、状语；用于花草或女性"},{"id":43946,"word":"逞娇斗媚","pinyin":"chěng jiāo dòu mèi","abbr":"cjdm","explanation":"犹言争娇斗媚。形容竞相撒娇献媚的样子。","source":{"text":"于中绮罗结队，粉黛成云，莫不尽态极妍，逞娇斗媚。","book":"清·王韬《淞滨琐话·谈艳上》"},"usage":"作谓语、定语、状语；用于花草或女性"},{"id":43947,"word":"逞工炫巧","pinyin":"chěng gōng xuàn qiǎo","abbr":"cgxq","explanation":"指炫耀工巧。","source":{"text":"汝虽赤其文，只其趾，逞工炫巧，莫救汝死。","book":"唐·柳宗元《逐毕方文》"},"usage":"作谓语、定语、宾语；指卖弄自己"},{"id":43948,"word":"逞工衒巧","pinyin":"chěng gōng xuàn qiǎo","abbr":"cgxq","explanation":"衒，同“炫”，夸耀。炫耀工巧。"},{"id":43949,"word":"逞己失众","pinyin":"chěng jǐ shī zhòng","abbr":"cjsz","explanation":"逞：放任。指由着性子胡来会失去众人的支持。","source":{"text":"盖骄则恃己轻人，骄则呈己失众，失众无以御人，那得不败。","book":"清·禇人获《隋唐演义》第五十六回"},"opposite":["严于律己"],"usage":"作谓语、宾语；用于劝诫人"},{"id":43950,"word":"逞异夸能","pinyin":"chěng yì kuā néng","abbr":"cykn","explanation":"施展奇异本事，夸耀能力高强。","source":{"text":"梅山七怪阻周兵，逞异夸能苦战争。","book":"《封神演义》第九二回"},"usage":"作宾语、定语；用于卖弄"},{"id":43951,"word":"逞强好胜","pinyin":"chěng qiáng hào shèng","abbr":"cqhs","explanation":"指显示自己能力强并想胜过别人。","source":{"text":"自从那天诉苦以后林四牙的思想一咬破口，狡猾变成机警，但总有点逞强好胜，不大服人。","book":"杨朔《北线》十五"},"example":{"text":"她是一个～的女孩子，一听这话，哪能忍受的下。","book":"周而复《上海的早晨》第三部二九"},"similar":["争强好胜"],"usage":"作谓语、定语；同“争强好胜”"},{"id":43952,"word":"逞强称能","pinyin":"chěng qiáng chēng néng","abbr":"cqcn","explanation":"炫耀卖弄自己的才能和本事。","source":{"text":"今后千万不可逞强称能，何况你既未读过多少诗书，更谈不上才气。","book":"端木蕻良《曹雪芹》第13章"},"example":{"text":"他最喜欢～了。"},"similar":["逞强好胜"],"usage":"作谓语、定语、宾语；指炫耀本事"},{"id":43953,"word":"逞心如意","pinyin":"chěng xīn rú yì","abbr":"cxry","explanation":"犹言称心如意。","source":{"text":"反过来说，作自传的人往往并无自己可传，就逞心如意地描摹出自己老婆、儿子都认不得的形象。","book":"钱锺书《写在人生边上·魔鬼夜访钱锤书先生》"},"similar":["称心如意"],"usage":"作宾语、状语；指人的心情与处事"},{"id":43954,"word":"逞性妄为","pinyin":"chěng xìng wàng wéi","abbr":"cxww","explanation":"由着性子胡来。也指坏人任意干坏事。","example":{"text":"杨荫榆发表过一个“须知学校犹家庭”的怪论。意思是说，学校好比封建大家庭，校长就是家长，有权～。（鲁迅《记念刘和珍君》）"},"similar":["恣意妄为"],"usage":"作谓语、宾语、定语；用于为人"},{"id":43955,"word":"逞怪披奇","pinyin":"chěng guài pī qí","abbr":"cgpq","explanation":"指炫耀奇异。","source":{"text":"尚修其辞，逞怪披奇，穷精备思，遐观千载，竟亦何裨，此谓名劳。","book":"明·方孝孺《息耕亭记》"},"usage":"作谓语；用于写作"},{"id":43956,"word":"速战速决","pinyin":"sù zhàn sù jué","abbr":"szsj","explanation":"用快速的战术结束战局。也比喻用迅速的办法完成任务。","source":{"text":"战争已拖了一年多，而一点看不出速战速决的希望。","book":"老舍《四世同堂》五一"},"example":{"text":"要不是因为他是一个‘进攻型’的快攻选手，一连几个重板扣杀，～地解决了问题，说不定夫人早就被别的小伙子‘抢’走了。","book":"张洁《含羞草》二"},"similar":["快刀斩乱麻"],"opposite":["拖泥带水"],"usage":"作谓语、定语、宾语；指快速的战术"},{"id":43957,"word":"造作矫揉","pinyin":"zào zuò jiǎo róu","abbr":"zzjr","explanation":"犹言矫揉造作。","source":{"text":"蚕儿呀，你的诗可还是出于有心？无意？造作矫揉？自然流泻？","book":"郭沫若《女神·春蚕》"},"example":{"text":"～的人是没有市场的"},"similar":["矫揉造作"],"usage":"作定语、宾语、状语；指故意做作"},{"id":43958,"word":"造化小儿","pinyin":"zào huà xiǎo ér","abbr":"zhxe","explanation":"造化：指命运；小儿：小子，轻蔑的称呼。这是对于命运的一种风趣说法。","source":{"text":"审言病甚，宋之问、武平一等省候如何。答曰：‘甚为造化小儿相苦，尚何言？’","book":"《新唐书·杜审言传》"},"example":{"text":"若夫孟轲遭采薪之忧，相如染枯竭之患，杜审言～之嗟。","book":"明·赵弼《疥鬼对》"},"usage":"作宾语、定语；比喻命运"},{"id":43959,"word":"造化弄人","pinyin":"zào huà nòng rén","abbr":"zhnr","explanation":"指命运捉弄人。","source":{"text":"我们在坐四五十人，似乎并一人落第，那知今日竟有八人之多，可见天道不测，造化弄人，你又从何捉摸。","book":"清·李汝珍《镜花缘》第六十七回"},"example":{"text":"若夫孟轲遭采薪之忧，相如染枯竭之患，杜审言～之嗟。","book":"明·赵弼《疥鬼对》"},"usage":"作宾语、定语；用于感慨等"},{"id":43960,"word":"造因得果","pinyin":"zào yīn dé guǒ","abbr":"zydg","explanation":"指无论制造何种因缘，必得相应之后果。","source":{"text":"可见造因得果，虽有人为，也是上天暗中安排定的。","book":"清·文康《儿女英雄传》第二十回"},"similar":["造因结果"],"usage":"作宾语、定语；用于书面语"},{"id":43961,"word":"造因结果","pinyin":"zào yīn jié guǒ","abbr":"zyjg","explanation":"指无论制造何种因缘，必得相应之后果。","source":{"text":"世人造因结果的这场公案，原是上天给众生开得一个公共道场。","book":"清·文康《儿女英雄传》第十九回"},"similar":["造因得果"],"usage":"作宾语、定语；用于书面语"},{"id":43962,"word":"造天立极","pinyin":"zào tiān lì jí","abbr":"ztlj","explanation":"指君王登上帝位，确立纲纪。","source":{"text":"伏惟陛下，革命开基。造天立极，方且弘宣帝典。","book":"唐·陈子昂《为资州郑使君让官表》"},"usage":"作谓语、定语；用于书面语"},{"id":43963,"word":"造微入妙","pinyin":"zào wēi rù miào","abbr":"zwrm","explanation":"形容达到微妙的境界。","source":{"text":"贺方回‘淡黄杨柳带栖鸦’、秦处度“藕叶清香胜花气”二句，写景咏物，可为造微入妙。","book":"宋·吴曾《能改斋漫录·沿袭》"},"example":{"text":"运意琢句，～，极其形容之工，真可企微孤山。","book":"元·韦居安《梅磵诗话》卷下"},"usage":"作宾语、定语；用于书面语"},{"id":43964,"word":"造恶不悛","pinyin":"zào è bù quān","abbr":"zebq","explanation":"作恶事而不肯悔改。","source":{"text":"宣公造恶不悛，而流毒于其国若是哉！","book":"明·刘基《春秋明经·公会齐侯伐莱公至自伐莱大旱》"},"usage":"作谓语、定语；用于处事"},{"id":43965,"word":"造极登峰","pinyin":"zào jí dēng fēng","abbr":"zjdf","explanation":"登峰造极。比喻达到极点。","source":{"text":"只看世上那班分明造极登峰的，也会变生不测；任是争强好胜的，偏逢用违所长。","book":"清·文康《儿女英雄传》第三十五回"},"example":{"text":"你想～，那就拿出真本事来"},"similar":["登峰造极"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":43966,"word":"造次行事","pinyin":"zào cì xíng shì","abbr":"zcxs","explanation":"匆忙做事。","example":{"text":"兴建图书馆虽是本校的当务之急，但应周密规划，不可～。"}},{"id":43967,"word":"造次颠沛","pinyin":"zào cì diān pèi","abbr":"zcdp","explanation":"流离失所，生活困顿。","source":{"text":"君子无终食之间违仁，造次必于是，颠沛必于是。","book":"春秋·鲁·孔丘《论语·里仁》"},"example":{"text":"人有迫于饥寒之患，为衣食之谋，～，未尝忘也。","book":"元·刘壎《隐居通议·理学一》"},"similar":["颠沛流离"],"usage":"作谓语、定语；指人生活没着落"},{"id":43968,"word":"造端倡始","pinyin":"zào duān chàng shǐ","abbr":"zdcs","explanation":"指首先倡导。","source":{"text":"何暇更从无明业识造端倡始，诱引后世阐提之党，背觉合尘，同人恶道，罪萃阙身。","book":"《说郛》卷八五引宋·张商英《护法论》"},"similar":["造端托始"],"usage":"作谓语、定语；用于书面语"},{"id":43969,"word":"造端托始","pinyin":"zào duān tuō shǐ","abbr":"zdts","explanation":"造：开始。指首先倡导","source":{"text":"吾惟尽造端托始之意，使后人可继而已者是也。","book":"明·宋濂《题张如心初修谱叙后》"},"similar":["造端倡始"],"usage":"作谓语、定语；用于书面语"},{"id":43970,"word":"造端讬始","pinyin":"zào duān tuō shǐ","abbr":"zdts","explanation":"指首先倡导。同“造端倡始”。","source":{"text":"吾惟尽造端讬始之意，使后人可继而已者是也。","book":"明·宋濂《题张如心初修谱叙后》"}},{"id":43971,"word":"造茧自缚","pinyin":"zào jiǎn zì fù","abbr":"zjzf","explanation":"作茧自缚。比喻做了某事，结果反而使自己受困。","source":{"text":"他们帮助敌人造成联合战线攻打他们自己，他们像蚕一样，造茧自缚。","book":"陶行知《中国大众教育问题》六"},"similar":["作茧自缚"],"usage":"作谓语、宾语、定语；指自作自受"},{"id":43972,"word":"造言之刑","pinyin":"zào yán zhī xíng","abbr":"zyzx","explanation":"刑：刑罚。对造谣惑众的人所处的刑罚。","source":{"text":"一曰不孝之刑；二曰不睦之刑；三曰不姻之刑；四曰不弟之刑；五曰不任之刑；六曰不恤之刑；七曰造言之刑；八曰乱民之刑。","book":"《周礼·地官·司徒》"}},{"id":43973,"word":"造言惑众","pinyin":"zào yán huò zhòng","abbr":"zyhz","explanation":"制造谣言，迷惑群众。","source":{"text":"老兄六尺须眉，何苦同妇人一般见识，造言惑众，说得天花乱坠，凿凿有据呢！","book":"清·壮者《扫迷帚》第十回"},"usage":"作谓语、宾语；用于处事"},{"id":43974,"word":"造言捏词","pinyin":"zào yán niē cí","abbr":"zync","explanation":"捏造虚假的言词。","source":{"text":"今既乱以皮鞭打常闻矣，犹然不得快活，复怨怒上山，造言捏词。","book":"明·李贽《穷途说》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":43975,"word":"造言生事","pinyin":"zào yán shēng shì","abbr":"zyss","explanation":"捏造虚言以挑起事端。","source":{"text":"只消说他造言生事，顶名告他一状，不怕不拿大锭大帛出来买静求安。","book":"《孟子·万章上》：“好事者为之也。”宋·朱熹集注：“好事，谓喜造言生事之人也。”清·张南庄《何典》第二回"},"example":{"text":"自知理屈，谨具伏辩，从此不敢再到某公馆滋闹，并不敢在外～。","book":"清·吴趼人《二十年目睹之怪现状》第一百六回"},"similar":["造谤生事","造谣生非"],"usage":"作谓语、定语；用于处事"},{"id":43976,"word":"造谋布穽","pinyin":"zào móu bù yán","abbr":"zmbj","explanation":"指设计陷害。"},{"id":43977,"word":"造谋布阱","pinyin":"zào móu bù jǐng","abbr":"zmbj","explanation":"指设计陷害。阱，同宑。","source":{"text":"其戕害杨左诸人，造谋布阱，实由外延线索，历历有据。","book":"明·刘若愚《酌中志·逆贤羽翼纪略》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":43978,"word":"造谣中伤","pinyin":"zào yáo zhòng shāng","abbr":"zyzs","explanation":"中伤：攻击和陷害别人。制造谣言，陷害别人。","source":{"text":"有忤逆于心者，必求事中伤。","book":"《后汉书·杨秉传》"},"example":{"text":"这人品质恶劣，对别人惯会～。"},"similar":["蜚短流长","含血喷人","血口喷人"],"opposite":["歌功颂德"],"usage":"作谓语、宾语；指伤害别人"},{"id":43979,"word":"造谣惑众","pinyin":"zào yáo huò zhòng","abbr":"zyhz","explanation":"制造谣言，迷惑群众。","source":{"text":"又都督府颁发暂行军律：一临阵退缩者斩，一强奸妇女者斩，一骚扰百姓者斩，一造谣惑众者斩。","book":"邹鲁《江苏光复纪事》"},"example":{"text":"更加上还有坏人的～，眼看着人心要散了。","book":"茹志鹃《剪辑错了的故事》"},"similar":["蛊惑人心","妖言惑众","造谣生事"],"usage":"作谓语、宾语；用于坏人"},{"id":43980,"word":"造谣生事","pinyin":"zào yáo shēng shì","abbr":"zyss","explanation":"制造谣言，挑起事端。","source":{"text":"尔作言造语，妄称文武。","book":"《庄子·盗跖》"},"example":{"text":"有许多言论是荒唐无知、捕风捉影、～。","book":"郭小川《沉重的教训》"},"similar":["蜚短流长","含血喷人","造谣中伤"],"opposite":["歌功颂德"],"usage":"作谓语、宾语；指生事"},{"id":43981,"word":"造谣生非","pinyin":"zào yáo shēng fēi","abbr":"zysf","explanation":"捏造谣言，挑起事端。同“造谣生事”。","source":{"text":"而且如今你的年纪，已是二十多了，住在这里，若再不同小大圆房，外间造谣生非的人多……说不定同我有了一手，岂不是你我二人的名誉，又将扫地。","book":"黄南丁氏《杨乃武与小白菜》第八回"},"example":{"text":"虽然北平人民每天所能接触的，都是这样‘～’、‘蓄意挑拨’的东西，但绝大多数的北平人到底具有慧眼。","book":"萧英《北平〈解放三日刊〉出版前后》"},"similar":["造谣生事"],"usage":"作谓语、宾语；指生事"},{"id":43982,"word":"造谤生事","pinyin":"zào bàng shēng shì","abbr":"zbss","explanation":"假造言语诽谤他人以生事端。","source":{"text":"若告贷银米以给口食，则必计其能还而后之，狡黠之流遂谓官有偏私，不免造谤生事。","book":"《清史稿·王恕传》"},"similar":["造谣生事"],"usage":"作谓语、宾语、定语；用于处事"},{"id":43983,"word":"造车合辙","pinyin":"zào chē hé zhé","abbr":"zchz","explanation":"比喻主观同客观相符合。","source":{"text":"反观序《修水集》造车合辙之语，则知持此论旧矣。","book":"宋·周煇《清波杂志》第五卷"},"example":{"text":"于是著作章句，藉相依据，人人能通其词，虽殊方异言，可以～焉。","book":"田北湖《论文章源流》"},"usage":"作谓语、宾语；指主观同客观相符"},{"id":43984,"word":"造难生患","pinyin":"zào nàn shēng huàn","abbr":"znsh","explanation":"造难：制造灾难；患：祸害。投靠不幸会引来祸害。","source":{"text":"德盛义尊，而不好加名于人；人众兵强，而不以其国造难生患。","book":"《管子·枢言》"}},{"id":43985,"word":"逡巡畏缩","pinyin":"qūn xún wèi suō","abbr":"qxws","explanation":"逡巡：想走又不走，犹豫不决的样子。指因为害怕而不敢向前。","source":{"text":"或鬼持世，乃是逡巡畏缩之象，欲行不行，必怀疑贰。","book":"明·刘基《黄金策·出行》"},"example":{"text":"那猛虎剪尾刨蹄，正欲向前扑人，见了林澹然，～，雄威顿挫，低头屈足，蹲于地上。","book":"明·清溪道人《禅真逸史》第三十八回"}},{"id":43986,"word":"逢人且说三分话","pinyin":"féng rén qiě shuō sān fēn huà","abbr":"frqssfh","explanation":"逢：遇见。指人与人互相欺瞒，不把实际情况或心里话说出来。","source":{"text":"孙富叫家童算还了酒钱，与公子携手下船，正是：逢人且说三分话，未可全抛一片心。","book":"明·冯梦龙《警世通言》第32卷"},"example":{"text":"资产阶级的心，自私自利，‘尔虞我诈’，是不可以告人的，‘～，未可全抛一片心’，他们是心隔心。","book":"谢觉哉《交心》"},"similar":["逢人只说三分话"],"usage":"作宾语、定语；用于劝诫人"},{"id":43987,"word":"逢人且说三分话，未可全抛一片心","pinyin":"féng rén qiě shuō sān fēn huà,wèi kě quán pāo yī piàn xīn","abbr":"frqssfhwkqpypx","explanation":"逢：遇见。指人与人互相欺瞒，不把实际情况或心里话说出来。","source":{"text":"孙富叫家童算还了酒钱，与公子携手下船，正是：逢人且说三分话，未可全抛一片心。","book":"明·冯梦龙《警世通言》第32卷"},"example":{"text":"资产阶级的心，自私自利，‘尔虞我诈’，是不可以告人的，‘～’，他们是心隔心。","book":"谢觉哉《交心》"},"similar":["逢人且说三分话"],"usage":"作宾语、定语；用于劝诫人"},{"id":43988,"word":"逢人只说三分话","pinyin":"féng rén zhǐ shuō sān fēn huà","abbr":"frzssfh","explanation":"逢：遇见。指人与人互相欺瞒，不把实际情况或心里话说出来。","source":{"text":"如今俗语云，逢人只说三分话，只此便是不忠。","book":"宋·朱熹《朱子语类》第21卷"},"example":{"text":"我们要记住～的古训。"},"similar":["逢人且说三分话"],"usage":"作宾语、定语；用于劝诫人"},{"id":43989,"word":"逢人说项","pinyin":"féng rén shuō xiàng","abbr":"frsx","explanation":"项：指唐朝诗人项斯。遇人便赞扬项斯。比喻到处为某人某事吹嘘，说好话。","source":{"text":"处处见诗诗总好，及观标格过于诗。平生不解藏人善，到处逢人说项斯。","book":"唐·杨敬之《赠项斯》"},"example":{"text":"菲亚又往各处村落，～，唇焦舌敝，语不离宗，一连跑了一个来月。","book":"清·岭南羽衣女士《东欧女豪杰》第二回"},"similar":["代为说项"],"usage":"作谓语；到处颂扬别人","story":["唐朝时期，江东年轻人项斯，字子迁，参加会考开始没有什么名气，别人拿他的卷子去给杨敬之看。杨特别喜欢就作诗“几度见诗诗尽好，及观标格过于诗，平生不解藏人善，到处逢人说项斯。”没多久，他就被长安方面录取"]},{"id":43990,"word":"逢凶化吉","pinyin":"féng xiōng huà jí","abbr":"fxhj","explanation":"逢：遭遇；凶：不幸；吉：吉利、吉祥。遇到凶险转化为吉祥、顺利。这是带有迷信的说法。","source":{"text":"豪杰交游满天下，逢凶化吉天生成。","book":"明·施耐庵《水浒全传》第四十二回"},"example":{"text":"我今叩求皇天保佑，在监的～，有病的早早安身。","book":"清·曹雪芹《红楼梦》第一○六回"},"similar":["绝处逢生","遇难成祥"],"opposite":["祸不单行","祸从天降","雪上加霜"],"usage":"作谓语、宾语、定语；指遇到凶险转化为吉祥"},{"id":43991,"word":"逢吉丁辰","pinyin":"féng jí dīng chén","abbr":"fjdc","explanation":"指遇上好时运。","source":{"text":"丁，当也。辰， 时也……逢休吉之代，当封禅之时，此为天子之大命也。","book":"《后汉书·班固传下》：“逢吉丁辰，景命也。”李贤注"},"similar":["逢机遘会"],"usage":"作谓语、宾语；指遭逢好时运"},{"id":43992,"word":"逢君之恶","pinyin":"féng jūn zhī è","abbr":"fjze","explanation":"执迎合昏庸的执政者，引他去干坏事。","source":{"text":"长君之恶其罪小，逢君之恶其罪大。","book":"《孟子·告子下》"},"example":{"text":"其时有个佞臣伯，～，劝他穷奢极欲，诛戮忠臣。","book":"明·冯梦龙《古今小说》第二十二卷"},"usage":"作谓语；指迎合昏庸的执政者"},{"id":43993,"word":"逢场作乐","pinyin":"féng chǎng zuò lè","abbr":"fczl","explanation":"犹言逢场作戏。偶尔随俗应酬凑凑热闹。","source":{"text":"对酒当歌须慷慨，逢场作乐任优游。","book":"明·沈受先《三元记·开宗》"},"example":{"text":"你们也去～。"},"similar":["逢场作趣"],"usage":"作谓语、宾语；指偶尔应酬"},{"id":43994,"word":"逢场作戏","pinyin":"féng chǎng zuò xì","abbr":"fczx","explanation":"逢：遇到；场：演戏的场地。原指旧时走江湖的艺人遇到适合的场合就表演。后指遇到机会，偶尔凑凑热闹。","source":{"text":"竿木随身，逢场作戏。","book":"宋·释道原《景德传灯录》卷六"},"example":{"text":"不过借他船坐坐舒服些，用他菜吃适口些，～，这有何妨。","book":"清·曾朴《孽海花》第七回"},"similar":["随俗应酬","随声附和"],"opposite":["矢忠不二","忠贞不渝"],"usage":"作谓语、定语、宾语；指轻浮的态度"},{"id":43995,"word":"逢场作趣","pinyin":"féng chǎng zuò qù","abbr":"fczq","explanation":"犹言逢场作戏。偶尔随俗应酬凑凑热闹。","source":{"text":"因为是师长的老部属，平时又会逢场作趣，这时节乘顺水船就来那么一手。","book":"沈从文《顾问官》"},"example":{"text":"他爱～，放松自己。"},"similar":["逢场作乐","逢场作戏"],"usage":"作谓语、宾语；指偶尔应酬"},{"id":43996,"word":"逢场游戏","pinyin":"féng chǎng yóu xì","abbr":"fcyx","explanation":"犹言逢场作戏。偶尔凑凑热闹。","source":{"text":"忆垂髫，留连节物，逢场游戏。","book":"宋·刘克庄《贺新郎·甲子端午》词"},"similar":["逢场作戏","逢场作乐"],"usage":"作谓语、定语、宾语；指轻浮的态度"},{"id":43997,"word":"逢场竿木","pinyin":"féng chǎng gān mù","abbr":"fcgm","explanation":"比喻偶尔凑凑热闹的人。","source":{"text":"竿木随身，逢场作戏。","book":"语出《五灯会元·南岳让禅师法嗣·江西马祖道一禅师》"},"example":{"text":"次年春，始获纵观，色艺之精，争妍夺媚。然余～，未能一一搜奇也。","book":"清·梁绍壬《两般秋雨庵随笔·京师梨园》"},"usage":"作宾语、定语；指凑热闹的人"},{"id":43998,"word":"逢山开路","pinyin":"féng shān kāi lù","abbr":"fskl","explanation":"形容不畏艰险，在前开道。","source":{"text":"旁边转过一个壮士，一臂扶轮，一手策马，逢山开路，救出赵盾去了。","book":"元·纪君祥《赵氏孤儿》楔子"},"example":{"text":"军旅～，遇水迭桥，岂有泥泞不堪之理。","book":"明·罗贯中《三国演义》第五十回"},"similar":["逢山开道"],"usage":"作谓语；形容不畏艰险，在前开道"},{"id":43999,"word":"逢山开路，遇水叠桥","pinyin":"féng shān kāi lù，yù shuǐ dié qiáo","abbr":"fsklysdq","explanation":"逢：遭逢，遇见。遇到山则打通道路，遇见水则架起桥梁。比喻不畏艰险，打通前进道路上的重重障碍。","source":{"text":"军旅逢山开路，遇水叠桥，岂有泥泞不堪行之理！","book":"明·罗贯中《三国演义》第50回"},"similar":["逢山开路，遇水迭桥"],"usage":"作谓语、宾语、定语；用于军事等"},{"id":44000,"word":"逢山开路，遇水迭桥","pinyin":"féng shān kāi lù，yù shuǐ dié qiáo","abbr":"fsklysdq","explanation":"逢：遭逢，遇见；迭：一层加上一层。遇到山则打通道路，遇见水则架起桥梁。比喻不畏艰险，打通前进道路上的重重障碍。","source":{"text":"三千鸦兵为先锋，逢山开路，遇水迭桥。","book":"元·关汉卿《哭存孝》第二折"},"example":{"text":"贫僧有两个徒弟，善能～。","book":"明·吴承恩《西游记》第29回"},"similar":["逢山开道，遇水造桥"],"usage":"作谓语、宾语、定语；用于军事等"},{"id":44001,"word":"逢山开道","pinyin":"féng shān kāi dào","abbr":"fskd","explanation":"形容不畏艰险，在前开路。常与“遇水叠桥”连用。","source":{"text":"三千鸦兵为先锋，逢山开道，遇水叠桥。","book":"元·关汉卿《哭存孝》第二折"},"example":{"text":"我今日同你两个来这杏花庄上呵，倒做了～。","book":"元·康进之《李逵负荆》第三折"},"similar":["逢山开路"],"usage":"作谓语、宾语；指先锋"},{"id":44002,"word":"逢山开道，遇水造桥","pinyin":"féng shān kāi dào，yù shuǐ zào qiáo","abbr":"fskdyszq","explanation":"逢：遭逢，遇见。遇到山则打通道路，遇见水则架起桥梁。比喻不畏艰险，打通前进道路上的重重障碍。","source":{"text":"奉旨出朝，地动山摇，逢山开道，遇水造桥。","book":"郭沫若《洪波曲》第七章"},"similar":["逢山开路，遇水迭桥"],"usage":"作谓语、宾语、定语；用于军事等"},{"id":44003,"word":"逢年过节","pinyin":"féng nián guò jié","abbr":"fngj","explanation":"在新年之际或在其他节日里。","source":{"text":"逢年过节，老太太时常想念，不过是儿行千里母担忧。","book":"清·姜振名《永庆升平前传》第40回"},"example":{"text":"～，我都特别想念你。"},"usage":"作状语；用于口语"},{"id":44004,"word":"逢恶导非","pinyin":"féng è dǎo fēi","abbr":"fedf","explanation":"指逢迎坏人，助长恶行。","source":{"text":"且言江彬遣恶导非，亟宜行诛，朝臣匡救 无闻，亦当罚治。","book":"《明史 ·张文明传》"},"usage":"作谓语、宾语；用于处事"},{"id":44005,"word":"逢新感旧","pinyin":"féng xīn gǎn jiù","abbr":"fxgj","explanation":"逢：遇到，遭遇；感旧：感念旧人旧事。遇到新相识而引起对故人的怀念。","source":{"text":"我已有亡过的妻室，乃洛阳角妓，与此女小字相同，面貌相类，因此见面生情，逢新感旧。","book":"元·乔孟符《两世姻缘》第二折"}},{"id":44006,"word":"逢时遇节","pinyin":"féng shí yù jié","abbr":"fsyj","explanation":"时：季节；节：节气。遇到四季节令。指过年过节的时候。","source":{"text":"方才老爹说的，他是个告命夫人，到家请会画的替他追个像，把凤冠补服画起来，逢时遇节，供在家里。","book":"清·吴敬梓《儒林外史》第二十回"},"similar":["逢时过节"],"usage":"作定语、状语；用于口语"},{"id":44007,"word":"逢机立断","pinyin":"féng jī lì duàn","abbr":"fjld","explanation":"犹言当机立断。","source":{"text":"观公之辨政，消烦解结，逢机立断。","book":"唐·元载《故相国杜鸿渐神道碑》"},"similar":["当机立断"],"opposite":["优柔寡断"],"usage":"作谓语、宾语、定语；形容人很果断"},{"id":44008,"word":"逢机遘会","pinyin":"féng jī gòu huì","abbr":"fjgh","explanation":"遭逢机会。","source":{"text":"谋取者，逢机遘会，阳施阴设，而人莫觉，宋主祖是也。","book":"明·王世贞《纲鉴会纂·宋纪》"},"similar":["逢吉丁辰"],"usage":"作谓语、宾语；指遭逢好时运"},{"id":44009,"word":"逢衣浅带","pinyin":"féng yī qiǎn dài","abbr":"fyqd","explanation":"逢衣：袖子宽大的衣服，古代读书人的衣服；浅带：宽博的衣带。宽袖大带是古代儒者的服饰，借指儒者。","source":{"text":"逢衣浅带。","book":"战国·赵·荀况《荀子·儒效》"},"similar":["缝衣浅带"],"usage":"作宾语；指儒者"},{"id":44010,"word":"逴俗绝物","pinyin":"chuò sú jué wù","abbr":"csjw","explanation":"犹言超世绝俗。","source":{"text":"吾无务为逴俗绝物之行，而天下已不能不群然趋向。","book":"清·周亮工《书影》卷五"},"usage":"作定语；用于书面语"},{"id":44011,"word":"逶迤退食","pinyin":"wēi yí tuì shí","abbr":"wyts","explanation":"从容谦退，公正廉洁。","source":{"text":"退食自公，委蛇委蛇。","book":"《诗经·召南·羔羊》"},"example":{"text":"诚违侧席之望，然～，足抑苟进之风。","book":"南朝·宋·范晔《后汉书·杨秉传》"},"usage":"作谓语、定语；指从容谦退"},{"id":44012,"word":"逷听远闻","pinyin":"tì tīng yuǎn wén","abbr":"ttyw","explanation":"“逷”同“逖”。指视听范围很远很广。"},{"id":44013,"word":"逸以待劳","pinyin":"yì yǐ dài láo","abbr":"yydl","explanation":"犹以逸待劳。","source":{"text":"逸以待劳，久以待变，亡费而有备，可谓善矣。","book":"宋陈师道《拟御试武举策》"},"example":{"text":"况汉口有极大市街，依托掩护，～，持久之力，明如指掌。","book":"杨玉如《辛亥革命先著记》"},"similar":["以逸待劳"],"usage":"作谓语、宾语、状语；指作战、工作等方法"},{"id":44014,"word":"逸兴云飞","pinyin":"yì xìng yún fēi","abbr":"yxyf","explanation":"指超逸豪放的意兴勃发飞扬。","source":{"text":"遥襟俯畅，逸兴遄飞。","book":"语出唐王勃《滕王阁序》"},"example":{"text":"雨后更阑，酒酣耳热，才思泉涌，～。","book":"陶曾佑《论文学之势力及其关系》"},"similar":["逸兴横飞","逸兴遄飞"],"usage":"作谓语、定语、状语；用于书面语"},{"id":44015,"word":"逸兴横飞","pinyin":"yì xìng héng fēi","abbr":"yxhf","explanation":"指超逸豪放的意兴勃发飞扬。","source":{"text":"遥襟俯畅，逸兴遄飞。","book":"语出唐王勃《滕王阁序》"},"example":{"text":"他～，登上了海拔二八六○公尺的莲花峰，黄山最高峰的绝顶。","book":"徐迟《黄山记》二"},"similar":["逸兴遄飞","逸兴云飞"],"usage":"作谓语、定语、状语；用于书面语"},{"id":44016,"word":"逸兴遄飞","pinyin":"yì xìng chuán fēi","abbr":"yxcf","explanation":"指超逸豪放的意兴勃发飞扬。","source":{"text":"遥襟俯畅，逸兴遄飞。","book":"唐王勃《滕王阁序》"},"example":{"text":"觥筹交错，～。","book":"清王韬《淞滨琐话·瑶台小咏上》"},"similar":["逸兴云飞","逸兴横飞"],"usage":"作谓语、定语、状语；用于书面语"},{"id":44017,"word":"逸尘断鞅","pinyin":"yì chén duàn yāng","abbr":"ycdy","explanation":"指马奔跑时扬起尘土，挣断马鞅。形容马跑得很快。","source":{"text":"[许俊]遂升堂，出翊札示柳氏，挟之跨鞍马，逸尘断鞅，倏忽乃至。","book":"唐许尧佐《柳氏传》"},"usage":"作定语、状语；用于书面语"},{"id":44018,"word":"逸态横生","pinyin":"yì tài héng shēng","abbr":"yths","explanation":"指清新美妙的姿态洋溢而出。","source":{"text":"柱国赵国公发言为论，下笔成章，逸态横生，新情振起，风雨争飞，鱼龙各变。","book":"北周庚信《序》"},"example":{"text":"新情振起，～，展育未终，感慨系之！","book":"清同亮工《序》"},"usage":"作谓语、定语；用于书面语"},{"id":44019,"word":"逸游自恣","pinyin":"yì yóu zì zī","abbr":"yyzz","explanation":"安闲玩乐，随心所欲。","source":{"text":"少为贵戚，逸游自恣。","book":"《后汉书·梁冀传》"},"usage":"作谓语、状语；用于处事"},{"id":44020,"word":"逸群之才","pinyin":"yì qún zhī cái","abbr":"yqzc","explanation":"拥有超过众人的才能。","source":{"text":"故君子常虚其心志，恭其容貌，不以逸群之才，加乎众人之上，视彼犹贤，自视犹不足也。","book":"汉·徐干《中论·虚道》"},"example":{"text":"唐·杨炯《后周宇文公神道碑》：“有如荀美，独负～。”"},"usage":"作宾语；用于书面语"},{"id":44021,"word":"逸群绝伦","pinyin":"yì qún jué lún","abbr":"yqjl","explanation":"指超出世人和同辈。","source":{"text":"处道当逸群绝伦，非常之器，非汝曹所逮也。","book":"《隋书·杨素传》"},"similar":["轶群绝类","超世绝伦"],"usage":"作谓语、定语；指人出众"},{"id":44022,"word":"逸趣横生","pinyin":"yì qù héng shēng","abbr":"yqhs","explanation":"指超逸不俗的情趣洋溢而出。","source":{"text":"[梅花和尚钱堉]醉后落笔，逸趣横生，自谓醒时不及也。","book":"清顾禄《桐桥倚棹录·冢墓》"},"example":{"text":"郭老的发言总是～，写的则是笔花四照。","book":"冰心《晚晴集·悼郭老》"},"similar":["妙趣横生"],"usage":"作谓语、定语；用于文字语言"},{"id":44023,"word":"逸辈殊伦","pinyin":"yì bèi shū lún","abbr":"ybsl","explanation":"指超越同辈，无与比伦。","source":{"text":"腾文炜色，九光连合于贞明；逸辈殊伦，百宝骈滋于动植。","book":"唐张说《为留守奏嘉禾表》"},"usage":"作谓语、定语；指与众不同"},{"id":44024,"word":"逸闻琐事","pinyin":"yì wén suǒ shì","abbr":"ywss","explanation":"指世人不在知道而感兴趣的传闻和故事。","source":{"text":"此十卷本，乃从毛氏汲古阁元版传钞，首尾完具，其间逸闻轶事，皆可以备考稽。","book":"语出《四库全书总目·地理三·武林旧事》"},"example":{"text":"又有时谈一些与评价无关的～，给文字增加无穷余韵，真是高妙极了。","book":"孙犁《澹定集·与友人论传记》"},"similar":["逸闻趣事","逸闻轶事"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44025,"word":"逸闻趣事","pinyin":"yì wén qù shì","abbr":"ywqs","explanation":"指世人不在知道而感兴趣的传闻和故事。","source":{"text":"此十卷本，乃从毛氏汲古阁元版传钞，首尾完具，其间逸闻轶事，皆可以备考稽。","book":"语出《四库全书总目·地理三·武林旧事》"},"example":{"text":"有的谈当前纷乱的政治形势，猜测战争的发展趋势；有的谈政界的～。","book":"管桦《将军河》第一部第三二章"},"similar":["逸闻轶事","逸闻琐事"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44026,"word":"逸闻轶事","pinyin":"yì wén yì shì","abbr":"ywys","explanation":"指世人不在知道而感兴趣的传闻和故事。","source":{"text":"此十卷本，乃从毛氏汲古阁元版传钞，首尾完具，其间逸闻轶事，皆可以备考稽。","book":"《四库全书总目·地理三·武林旧事》"},"similar":["逸闻琐事","逸闻趣事"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44027,"word":"逸韵高致","pinyin":"yì yùn gāo zhì","abbr":"yygz","explanation":"高逸的风度韵致。","source":{"text":"孝章逸韵高致，身有仙骨，故其书墨梅，柯干丰姿，意外超妙。","book":"清归庄《跋金孝章墨梅》"},"usage":"作谓语、宾语；用于书面语"},{"id":44028,"word":"逼上梁山","pinyin":"bī shàng liáng shān","abbr":"bsls","explanation":"比喻被迫起来反抗。现也比喻被迫采取某种行动。","source":{"text":"林冲雪夜上梁山。","book":"明·施耐庵《水浒全传》第十一回"},"example":{"text":"可以说差不多的人都是～的。","book":"姚雪垠《李自成》第一卷第二十八章"},"similar":["迫不得已","铤而走险"],"opposite":["自觉自愿","自告奋勇"],"usage":"作谓语、定语；用于被迫反抗时","story":["北宋禁军教头林冲因得罪太尉高俅，被发配到沧州充军。到沧州被安排分管草料场仓库，高俅在一个雪天的夜晚派两人去放火烧死林冲，林冲得知后被逼无奈，起来反抗，杀死纵火者，毅然去梁山投奔宋江起义军"]},{"id":44029,"word":"逼不得已","pinyin":"bī bù dé yǐ","abbr":"bbdy","explanation":"指迫不得已。","source":{"text":"欲此求方，终不可得，云伟骨未应得之，逼不得已，妻尸解而去。","book":"宋·张君房《云笈七签》第85卷"},"example":{"text":"他～，只好采取走为上计。"},"similar":["迫不得已"],"opposite":["自觉自愿"],"usage":"作谓语、定语；指被逼无奈"},{"id":44030,"word":"逼人太甚","pinyin":"bī rén tài shèn","abbr":"brts","explanation":"指对人逼迫不留馀地。","source":{"text":"生母力敌万夫，而妾实为其所出，不至逼人太甚。","book":"清·沈起凤《谐铎·恶饯》"},"example":{"text":"潜行反间之谋，洵～！","book":"清·王韬《淞滨琐话·记双烈》"},"similar":["欺人太甚"],"usage":"作谓语、宾语；指强迫别人"},{"id":44031,"word":"逼良为娼","pinyin":"bī liáng wéi chāng","abbr":"blwc","explanation":"①指强迫良家妇女卖淫。②比喻被迫做某件坏事。","source":{"text":"反映逼良为娼的文艺作品，从古到今可谓车载船装，数不胜数。","book":"《文汇报》1989.5.28"},"example":{"text":"目前有些读物是在间接～。"},"opposite":["弃恶从善"],"usage":"作谓语、宾语、定语；指强迫人干坏事"},{"id":44032,"word":"逾假不归","pinyin":"yú jiǎ bù guī","abbr":"yjbg","explanation":"即假期已满而未归营。","example":{"text":"我们要求按时归队，～的一律开除。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":44033,"word":"逾千越万","pinyin":"yú qiān yuè wàn","abbr":"yqyw","explanation":"指数字超过千或万。极言其多。","source":{"text":"岂不以拂水捎云，逾千越万，庶夫知我者谓我点点而成文，不知我者徒曰青青而怀怨。","book":"唐·蒋防《湘妃泣竹赋》"},"similar":["成千上万"],"usage":"作谓语、定语；用于书面语"},{"id":44034,"word":"逾墙窥蠙","pinyin":"yú qiáng kuī pín","abbr":"yqkp","explanation":"指男女偷情。同“逾墙钻穴”。"},{"id":44035,"word":"逾墙窥隙","pinyin":"yú qiáng kuī xì","abbr":"yqkx","explanation":"指男女偷情。","source":{"text":"不待父母之命，媒妁之言，钻穴隙相窥，逾墙相从，则父母国人皆贱之。","book":"语出《孟子·滕文公下》"},"example":{"text":"轻则欲火煎熬，忧患病死；甚且～，贪淫犯法而不之顾。","book":"明·方汝浩《禅真逸史》第一回"},"similar":["逾墙钻穴","逾墙钻隙"],"usage":"作谓语、定语；指男女偷情"},{"id":44036,"word":"逾墙越舍","pinyin":"yú qiáng yuè shě","abbr":"yqys","explanation":"指翻墙越舍很快就走了。","source":{"text":"言讫而别，遂逾墙越舍而去。","book":"唐·皇甫氏《原化记·崔慎思》"},"usage":"作定语、状语；用于书面语"},{"id":44037,"word":"逾墙避命","pinyin":"yú qiáng bì mìng","abbr":"yqbm","explanation":"越墙而逃，躲避被召之命。指隐士隐居不仕。","source":{"text":"昔段干木逾墙而避文侯之命，泄柳闭门不纳穆公之请。","book":"《后汉书·乔玄传》"},"usage":"作谓语、定语；用于书面语"},{"id":44038,"word":"逾墙钻穴","pinyin":"yú qiáng zuàn xué","abbr":"yqzx","explanation":"指男女偷情。","source":{"text":"不待父母之命，媒妁之言，钻穴隙相窥，逾墙相从，则父母国人皆贱之。","book":"语出《孟子·滕文公下》"},"example":{"text":"兄留丽人独居，难保无～之事。","book":"明·冯梦龙《警世通言·杜十娘怨沉百宝箱》"},"similar":["跳墙钻洞"],"usage":"作宾语、定语；用于书面语"},{"id":44039,"word":"逾墙钻蠙","pinyin":"yú qiáng zuàn pín","abbr":"yqzp","explanation":"指男女偷情。同“逾墙钻穴”。"},{"id":44040,"word":"逾墙钻隙","pinyin":"yú qiáng zuān xì","abbr":"yqzx","explanation":"逾：越过；钻：穿孔，打眼。越墙、钻洞。指对女子作挑逗的行为。","source":{"text":"钻穴隙相窥，逾墙相从，则父母国人皆贱之。","book":"战国·邹·孟轲《孟子·滕文公下》"},"example":{"text":"妾与君无媒妁之言，父母之命，～，何能白首。","book":"清·蒲松龄《聊斋志异·红玉》"},"similar":["逾墙钻穴","逾墙窥隙"],"usage":"作谓语、定语；指男女偷情"},{"id":44041,"word":"逾山越海","pinyin":"yú shān yuè hǎi","abbr":"ysyh","explanation":"越过山海。指长途跋涉。","source":{"text":"人迹罕至者，莫不逾山越海，北面称蕃。","book":"《南齐书·高帝纪上》"},"similar":["跋山涉水"],"usage":"作谓语、宾语、定语；用于旅行等"},{"id":44042,"word":"逾年历岁","pinyin":"yú nián lì suì","abbr":"ynls","explanation":"指经过一定年月。形容经历较长时间。","source":{"text":"王大怒，曰：‘夫用百成之众攻战，逾年历岁，未见一城也！今不用兵而得城七十，何故不为？’","book":"《战国策·赵策一》"},"usage":"作谓语、状语；用于书面语"},{"id":44043,"word":"逾庖而宴","pinyin":"yú páo ér yàn","abbr":"ypey","explanation":"逾：越过，穿过；庖：厨房。越过厨房去吃饭。指办事不合情理。","source":{"text":"东犬西吠，客逾庖而宴。","book":"明·归有光《项脊轩志》"},"usage":"作谓语、宾语、定语；指办事不合情理"},{"id":44044,"word":"逾次超秩","pinyin":"yú cì chāo zhì","abbr":"yccz","explanation":"犹言越过次序。","source":{"text":"久之，荣于时阶进于显密之途，则非循铨资，托引援，未有榆次超秩，用才地以自进者也。","book":"林纾《赠伍昭扆太守序》"},"usage":"作宾语、定语；用于书面语"},{"id":44045,"word":"逾沙轶漠","pinyin":"yú shā yì mò","abbr":"ysym","explanation":"穿越沙漠。谓经历险远的路途。","source":{"text":"栈山航海，逾沙轶漠之贡，府无虚月。","book":"南朝·宋·颜延之《三月三日曲水诗序》"},"example":{"text":"于是自昔辨发卉裳，羁縻之所未至；～，言语之所未通。咸奉玉帛而介九宾，袭衣冠而献万寿。","book":"宋·庞元英《文昌杂录》卷三"},"similar":["栈山航海"],"usage":"作谓语、定语；用于书面语"},{"id":44046,"word":"逾淮为枳","pinyin":"yú huái wéi zhǐ","abbr":"yhwz","explanation":"橘移到淮河以北就变成枳了。比喻事物随环境的变化而变化。","source":{"text":"婴闻之，橘生淮南则为橘，生于淮北则为枳，叶徒相似，其实味不同。所以然者何？水土异也。","book":"《晏子春秋·内篇杂下》"},"similar":["逾淮之橘"],"usage":"作宾语、定语；用于书面语","story":["春秋时期，齐国大夫晏婴奉命出使楚国，楚王见他矮小就嘲笑他，抓一个小偷说是齐国人。晏婴回答说：“人们都知道橘树逾淮为枳，齐国人到楚国来成为小偷，环境改变而已。”巧妙地应对楚王。楚王刮目相看，改用高规格接待他"]},{"id":44047,"word":"逾淮之橘","pinyin":"yú huái zhī jú","abbr":"yhzj","explanation":"比喻易地而变质的事物。","source":{"text":"晏子避席对曰：‘婴闻之，橘生淮南则为橘，生于淮北则为枳，叶徒相似，其实味不同。所以然者何？水土异也。’","book":"《晏子春秋·杂下十》"},"example":{"text":"无如工厂之制，昌于西土，殆如～，迁地弗良。","book":"叶圣陶《穷愁》"},"similar":["逾淮为枳"],"usage":"作宾语；用于比喻句","story":["春秋时期，齐国大夫晏婴奉命出使楚国，楚王见他矮小就嘲笑他，抓一个小偷说是齐国人。晏婴回答说：“人们都知道橘树逾淮为枳，齐国人到楚国来成为小偷，环境改变而已。”巧妙地应对楚王。楚王刮目相看，改用高规格接待他"]},{"id":44048,"word":"逾绳越契","pinyin":"yú shéng yuè qì","abbr":"ysyq","explanation":"指在结绳、书契之前没有文字。绳、契指结绳、书契。后引申指不通文字。","source":{"text":"逾绳越契，寂寥而亡诏者，《系》不得而缀也。","book":"《后汉书·班固传下》"},"example":{"text":"上以朝臣不足任使，所用文武，～。","book":"清·黄宗羲《移史馆熊公雨殷行状》"},"usage":"作谓语、定语；用于书面语"},{"id":44049,"word":"逾规越矩","pinyin":"yú guī yuè jǔ","abbr":"ygyj","explanation":"指说话或处事超越规矩","source":{"text":"就是说笑，也要有个分寸，这等逾规越矩的话是不许说的。","book":"清·无垢道人《八仙全传》第22回"},"opposite":["循规蹈矩"],"usage":"作宾语、定语；用于书面语"},{"id":44050,"word":"逾闲荡检","pinyin":"yú xián dàng jiǎn","abbr":"yxdj","explanation":"逾、荡：超越；闲、检：指规矩、法度。形容行为放荡，不守礼法。","source":{"text":"道家去名者，欲以笃实也，苟失其本，又有越检之行。","book":"《论语·子张》：“大德不逾闲，小德出入可也。”《晋书·戴逵传》"},"example":{"text":"耳洛克康德意欲自由之论，则相率于～。","book":"清·梁启超《论宗教家与哲学家之长短得失》"},"usage":"作谓语；指人品"},{"id":44051,"word":"遁世幽居","pinyin":"dùn shì yōu jū","abbr":"dsyj","explanation":"指避世而深居不做官。同“遁世隐居”。","source":{"text":"齐之华士，栖志丘壑，而太公诛之之；魏之干木，遁世幽居，而文侯敬之。","book":"北齐·刘昼《新论·遇不遇》"},"example":{"text":"杜门宴坐无伤道，～也是贤。","book":"元·耶律楚材《西域和王君玉》之十六"},"similar":["遁世隐居"],"usage":"作谓语、定语、宾语；用于隐居"},{"id":44052,"word":"遁世无闷","pinyin":"dùn shì wú mèn","abbr":"dswm","explanation":"指逃避世俗而心无烦忧。","source":{"text":"谓逃遁避世，虽逢无道，心无所闷。","book":"《易·乾》：“不成乎名，遁世无闷。”孔颖达疏"},"example":{"text":"诸君只要常常怀个～、不见是而无闷之心，依此良知，忍耐做去，任他功夫有进有退，久久自然有得力处。","book":"明·王守仁《传习录》卷下"},"similar":["遁俗无闷","遁逸无闷"],"usage":"作宾语、定语；用于人处世"},{"id":44053,"word":"遁世离俗","pinyin":"dùn shì lí sú","abbr":"dsls","explanation":"指隐居而屏绝世俗往来。","source":{"text":"申徒狄也，遇暗君遁世离俗，自拥石赴河，故言抗迹也。","book":"《楚辞·九章·悲回风》“望大河之洲渚兮，悲申徒之抗迹”汉·王逸注"},"similar":["遁世绝俗"],"usage":"作谓语、定语；用于隐居"},{"id":44054,"word":"遁世离群","pinyin":"dùn shì lí qún","abbr":"dslq","explanation":"犹言避世独处。","source":{"text":"后世之士，其所蕴蓄或未至，而好以迹为高，当邦有道之时，且遁世离群，谓之隐士。","book":"《元史·隐逸传序》"},"example":{"text":"宝钗道：‘你既说“赤子之心”，古圣贤原以忠孝为赤子之心，并不是～无关无系为赤子之心。’","book":"《红楼梦》第一一八回"},"usage":"作谓语、定语；用于隐居"},{"id":44055,"word":"遁世绝俗","pinyin":"dùn shì jué sú","abbr":"dsjs","explanation":"指隐居而屏绝世俗往来。同“遁世离俗”。","source":{"text":"能使人有孤臣孽子摈弃而不容之感，遁世绝俗之悲，泥而不滓，蝉蜕污浊之外者，诗也。","book":"明·王世贞《艺苑卮言》卷一"},"similar":["遁世离俗"],"usage":"作谓语、定语；用于隐居"},{"id":44056,"word":"遁世遗荣","pinyin":"dùn shì yí róng","abbr":"dsyr","explanation":"指避世隐居而抛弃荣华富贵。","source":{"text":"是故遁世遗荣，反俗而动。","book":"晋·慧远《答何镇南书》"},"usage":"作谓语、定语；用于处世"},{"id":44057,"word":"遁世长往","pinyin":"dùn shì cháng wǎng","abbr":"dscw","explanation":"避世隐居而长期不出。","source":{"text":"其所见四方贤公卿大夫、名士才人有几；遁世长往、怀道蕴术之士有几？","book":"明·归有光《白庵程翁八十寿序》"},"usage":"作谓语、定语；用于隐居"},{"id":44058,"word":"遁世隐居","pinyin":"dùn shì yǐn jū","abbr":"dsyj","explanation":"指避世而深居不做官。","source":{"text":"遁世隐居，竟不逢时。","book":"汉·焦赣《易林·革之旅》"},"similar":["遁世幽居"],"usage":"作谓语、定语、宾语；用于隐居"},{"id":44059,"word":"遁俗无闷","pinyin":"dùn sú wú mèn","abbr":"dswm","explanation":"指逃避世俗而心无烦忧。同“遁世无闷”。","source":{"text":"遁俗无闷，因时有待。","book":"唐·王勃《彭州九陇县龙怀寺碑》"},"similar":["遁世无闷","遁逸无闷"],"usage":"作宾语、定语；用于人处世"},{"id":44060,"word":"遁光不耀","pinyin":"dùn guāng bù yào","abbr":"dgby","explanation":"遁：隐藏；耀：显耀。隐去光芒，不使显耀。比喻暗中做好事，不向人们显示。","source":{"text":"辞重而清约，非计之得也。虽使古之君子积道藏德，遁其光而不耀。","book":"唐·韩愈《答窦秀才书》"}},{"id":44061,"word":"遁入空门","pinyin":"dùn rù kōng mén","abbr":"drkm","explanation":"遁：逃遁；空门：指佛教，因佛教认为世界是一切皆空的。指出家。避开尘世而入佛门。","source":{"text":"看破的，遁入空门，我听见，并不惊异。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"他一时想不开就～。"},"similar":["遁迹空门","削发为僧"],"usage":"作谓语、定语；指出家为僧尼"},{"id":44062,"word":"遁名匿迹","pinyin":"dùn míng nì jì","abbr":"dmnj","explanation":"遁：隐藏；匿：藏匿。隐姓埋名，不让人闻知。","source":{"text":"一不与细合，则飒然远举，遁名匿迹，惟恐有闻于人也。","book":"宋·苏舜钦《粹隐堂记》"},"example":{"text":"为了逃避责任，他竟然～了。"},"similar":["隐姓埋名"],"usage":"作谓语、宾语；指隐姓埋名，不让人知道"},{"id":44063,"word":"遁名改作","pinyin":"dùn míng gǎi zuò","abbr":"dmgz","explanation":"窜改物名，改变作品。"},{"id":44064,"word":"遁天之刑","pinyin":"dùn tiān zhī xíng","abbr":"dtzx","explanation":"指违背自然规律所受的刑罚。","source":{"text":"是遁天倍情，忘其所受，古者谓之遁天之刑。","book":"《庄子·养生主》"},"example":{"text":"“死底境地为生者所不知，所以畏惧，不知生是‘天刑’，故如《养生主》所说，死是‘～’，是‘呼之县解’”。","book":"许地山《道教史》第四章"}},{"id":44065,"word":"遁天倍情","pinyin":"dùn tiān bèi qíng","abbr":"dtbq","explanation":"指违背天然之性而加添流俗之情。一说，违背天性与真情。倍，通“背”。","source":{"text":"言逃遁天理，倍加俗情。","book":"《庄子·养生主》：“是遁天倍情，忘其所受，古者谓之遁天之刑。”成玄英疏"},"example":{"text":"弃惇德而染浇风，～，忘其所受，其不渐摩而与汉物化者寡矣。","book":"严复《原强》"},"usage":"作谓语、宾语；用于书面语"},{"id":44066,"word":"遁天妄行","pinyin":"dùn tiān wàng xíng","abbr":"dtwx","explanation":"指违背自然规律而胡作非为。","source":{"text":"皆违理谬感，遁天妄行，弥非真有矣。","book":"南朝·宋·宗炳《明佛论》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":44067,"word":"遁形远世","pinyin":"dùn xíng yuǎn shì","abbr":"dxys","explanation":"犹言避世隐居。","source":{"text":"真曰：‘吾既不能遁形远世，岂饮洗耳之水哉？’遂深自隐绝，终不降屈。","book":"《后汉书·逸民传·法真》"},"usage":"作谓语、定语、宾语；用于隐居"},{"id":44068,"word":"遁身远迹","pinyin":"dùn shēn yuǎn jì","abbr":"dsyj","explanation":"犹言避世隐居。","source":{"text":"已而久不合，退居山穷水绝处，慕王霸、梁鸿夫妇，赓《麦秀》、《五噫》之歌，将遁身远迹以自娱佚。","book":"宋·叶適《赵孺人墓铭》"},"similar":["遁名匿迹"],"usage":"作谓语、宾语、定语；用于隐居"},{"id":44069,"word":"遁迹匿影","pinyin":"dùn jì nì yǐng","abbr":"djny","explanation":"指隐藏踪迹和身形。","source":{"text":"但诸公皆不知用兵，闻贼至则盛怒而出，一有败衄则退然沮丧，遁迹匿影唯恐不密。","book":"明·何良俊《四友斋丛说·史七》"},"similar":["藏形匿影","遁迹潜形"],"usage":"作谓语、宾语；用于躲藏"},{"id":44070,"word":"遁迹方外","pinyin":"dùn jì fāng wài","abbr":"djfw","explanation":"犹言避世隐居于僧道中。","source":{"text":"余如惟信、王忱、金恺、秦衡、陆叙，类皆元季遗民，或逃名字宇内，或遁迹方外，并不欲以姓字传者。","book":"清·顾文彬《过云楼书画记·衡山补图元贤深翠轩诗文卷》"},"similar":["遁迹黄冠"],"usage":"作谓语、宾语；指隐居"},{"id":44071,"word":"遁迹桑门","pinyin":"dùn jì sāng mén","abbr":"djsm","explanation":"指避开尘世而出家为僧。桑门，即沙门。","source":{"text":"石涛和尚以前朝宗室，遁迹桑门，结茅于微之黄山。","book":"清·钮琇《觚剩·树怪》"},"similar":["遁迹空门"],"usage":"作谓语、定语；指出家为僧尼"},{"id":44072,"word":"遁迹潜形","pinyin":"dùn jì qián xíng","abbr":"djqx","explanation":"遁、潜：隐藏。迹、形：踪迹，形迹。指隐藏踪迹和身形。","source":{"text":"若要行刺呵，要隐。当遁迹潜形，翦蔓除根才事稳。","book":"明·张景《飞丸记·园中落阱》"},"example":{"text":"他干了坏事，只好～了。"},"similar":["遁迹匿影"],"opposite":["明目张胆"],"usage":"作谓语、宾语；指隐藏踪迹和身形"},{"id":44073,"word":"遁迹空门","pinyin":"dùn jì kōng mén","abbr":"djkm","explanation":"指出家。避开尘世而入佛门。同“遁入空门”。","source":{"text":"逼得我，此一身，走投无路，因此上，来披剃，遁迹空门。","book":"《天雨花》第五回"},"example":{"text":"智明长老迟疑不语，自己是个萍踪浪迹之人，生生死死，恩恩怨怨，已成过眼烟云，今已～。","book":"《今古传奇》1983年第4辑"},"similar":["遁入空门"],"usage":"作谓语、定语；指出家为僧尼"},{"id":44074,"word":"遁迹藏名","pinyin":"dùn jì cáng míng","abbr":"djcm","explanation":"犹言隐居不出。","source":{"text":"功成辞赏，遁迹藏名。","book":"《东周列国志》第八九回"},"similar":["隐迹埋名"],"usage":"作谓语、宾语；指隐居"},{"id":44075,"word":"遁迹销声","pinyin":"dùn jì xiāo shēng","abbr":"djxs","explanation":"指隐居不出。","source":{"text":"若任用无才，则有才之路塞，贤人君子所以遁迹销声，常怀叹恨者也。","book":"《旧唐书·韦嗣立传》"},"similar":["销声匿迹"],"usage":"作谓语、定语、宾语；用于隐居"},{"id":44076,"word":"遁迹黄冠","pinyin":"dùn jì huáng guàn","abbr":"djhg","explanation":"指避开尘世而做道士。","source":{"text":"原来先生是个留学日本速成法政的学生，又是个‘遁迹黄冠’的遗老，失敬失敬。","book":"刘复《奉答王敬先生》"},"similar":["遁迹方外","遁迹空门"],"usage":"作谓语、宾语；指隐居"},{"id":44077,"word":"遁逸无闷","pinyin":"dùn yì wú mèn","abbr":"dywm","explanation":"指逃避世俗而心无烦忧。同“遁世无闷”。","source":{"text":"欲使自天佑之，吉无不利，舒卷随取，进退自然，遁逸无闷，幽居永贞，亦何荣乎？","book":"南朝·梁·江淹《无为论》"},"similar":["遁俗无闷","遁世无闷"],"usage":"作宾语、定语；用于人处世"},{"id":44078,"word":"遁阴匿景","pinyin":"dùn yīn nì jǐng","abbr":"dynj","explanation":"指隐藏形迹。","source":{"text":"遁阴匿景，静言勿哗。","book":"晋·陆云《南征赋》"},"usage":"作谓语、定语；用于隐藏"},{"id":44079,"word":"遂心如意","pinyin":"suì xīn rú yì","abbr":"sxry","explanation":"犹言称心如意。亦作“遂心满意”、“遂心快意”。","source":{"text":"天底下的事，未必都那么遂心如意的。","book":"《红楼梦》第四六回"},"example":{"text":"他觉得儿子大了，要有一个～、知疼知热的也好。","book":"端木蕻良《乡愁》五"},"similar":["称心满意","遂心快意"],"usage":"作谓语、定语；指称心满意"},{"id":44080,"word":"遂心应手","pinyin":"suì xīn yīng shǒu","abbr":"sxys","explanation":"犹得心应手。形容运用自如。","source":{"text":"兴哥，阿鹊在向你报喜呢，你到了窑上一定遂心应手的。","book":"碧野《没有花的春天》第八章"},"similar":["得心应手"],"usage":"作谓语、定语；指得心应手"},{"id":44081,"word":"遂心快意","pinyin":"suí xīn kuài yì","abbr":"sxky","explanation":"形容心满意足，事情的发展完全符合心意。同“遂心如意”。","source":{"text":"无如他此时是满怀的遂心快意，满脸的吐气扬眉，话挤话，不由得冲口而出。","book":"清·文康《儿女英雄传》第37回"},"similar":["遂心满意","遂心如意","称心如意"],"usage":"作谓语、定语；指称心满意"},{"id":44082,"word":"遂心满意","pinyin":"suì xīn mǎn yì","abbr":"sxmy","explanation":"形容心满意足，事情的发展完全符合心意。同“遂心如意”。","source":{"text":"我们索性去截住他，夺了盘缠，抢了白马凑分，却不是遂心满意之事？","book":"明·吴承恩《西游记》第97回"},"example":{"text":"端木蕻良《科尔沁旗草原》：“来，三奶给你作主，管保给你挑个～的。”"},"similar":["遂心快意","遂心如意","称心如意"],"usage":"作谓语、定语；指称心满意"},{"id":44083,"word":"遂迷不寤","pinyin":"suí mí bù wù","abbr":"smbw","explanation":"执迷不悟；坚持错误而不觉悟。","source":{"text":"如王迁凑遂迷不寤，诸道宜便进军，以时翦灭。","book":"唐·元稹《拓村镇州制》"},"similar":["遂迷忘反","执迷不悟"],"usage":"作谓语、定语；用于书面语"},{"id":44084,"word":"遂迷不窹","pinyin":"suí méi bù wù","abbr":"smbw","explanation":"执迷不悟；坚持错误而不觉悟。亦作“遂迷忘反”。","source":{"text":"如王廷凑遂迷不窹，诸道宜便进军，以时翦灭。","book":"唐元稹《招讨镇州制》"},"example":{"text":"窃寻民之多伪，实由宋季军旅繁兴，役赋殷重，不勤剧，倚巧祈优，积习生常，遂迷忘反。","book":"《南齐书·顾宪之传》"}},{"id":44085,"word":"遂迷不竝","pinyin":"suí méi bù wù","abbr":"smbw","explanation":"执迷不悟；坚持错误而不觉悟。亦作遂迷忘反”。","source":{"text":"如王廷凑遂迷不竝，诸道宜便进军，以时翦灭。","book":"唐元稹《招讨镇州制》"},"quote":{"text":"窃寻民之多伪，实由宋季军旅繁兴，役赋殷重，不勤剧，倚巧祈优，积习生常，遂迷忘反。","book":"《南齐书·顾宪之传》"}},{"id":44086,"word":"遂迷忘反","pinyin":"suí mí wàng fǎn","abbr":"smwf","explanation":"执迷不悟；坚持错误而不觉悟。同“遂迷不寤”。","source":{"text":"窃寻民之多伪，实由宋季军旅繁兴，役赋殷重，不堪勤剧，倚巧祈优，积习生常，遂迷忘反。","book":"《南齐书·顾宪之传》"},"similar":["遂迷不寤"],"usage":"作谓语、定语；用于书面语"},{"id":44087,"word":"遂非文过","pinyin":"suí fēi wén guò","abbr":"sfwg","explanation":"饰非文过。掩饰错误和过错。","source":{"text":"今之君子，岂徒顺之，又从为之辞。","book":"汉荀悦《汉纪·昭帝纪》：“遂非文过，知而不改。”《孟子·公孙丑下》"},"example":{"text":"责贾不能勉其君以迁善改过，而教之以～也。","book":"宋朱熹集注"},"similar":["文过饰非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":44088,"word":"遇事不苟","pinyin":"yù shì bù gǒu","abbr":"ysbg","explanation":"苟：苟且，马虎。指做事认真细致，一点儿不马虎。","source":{"text":"具官某，学术精博，遣词甚工，操履坚正，遇事不苟。","book":"宋·苏辙《曾肇磨勘改朝散郎》"},"example":{"text":"镐端挺寡言，所至安静有体，而～，为世所推重。","book":"《宋史·明镐传》"}},{"id":44089,"word":"遇事掣肘","pinyin":"yù shì chè zhǒu","abbr":"yscz","explanation":"掣：拉；掣肘：拉住胳膊。比喻从旁牵制、阻挠。一遇到事情就从旁干涉阻挠。","source":{"text":"后来又被贾总办晓得了，反说他有意霸持，遇事掣肘，递了个禀帖给河台，请河台撤他的差使，以便事权归一。","book":"清·李宝嘉《官场现形记》第二十四回"},"example":{"text":"杨文弱纵有通天本领，深蒙崇祯信任，也无奈朝廷上很多人都攻击他，～。","book":"姚雪垠《李自成》第二卷第二十三章"},"usage":"作谓语、定语；用于局面"},{"id":44090,"word":"遇事生波","pinyin":"yù shì shēng bō","abbr":"yssb","explanation":"原形容处事果断而迅速。后指一有机会就挑拔是非，引起事端。","source":{"text":"所居好用世吏子孙新进年少者，专厉强壮蜂气，见事风生，无所回避，率多果敢之计，莫为持难。","book":"《汉书·赵广汉传》"},"example":{"text":"门包小费，一齐全，不敢稍有疏略，畏其凶焰，又恐～也。","book":"清·张集馨《道咸宦海见闻录》"}},{"id":44091,"word":"遇事生端","pinyin":"yù shì shēng duān","abbr":"yssd","explanation":"指好事者一有机会就借端兴风作浪。","source":{"text":"指好事者一有机会就借端兴风作浪。"},"similar":["遇事生风"],"usage":"作谓语、定语；指挑拨是非"},{"id":44092,"word":"遇事生风","pinyin":"yù shì shēng fēng","abbr":"yssf","explanation":"原形容处事果断而迅速。后指一有机会就挑拔是非，引起事端。","source":{"text":"见事风生，无所回避。","book":"《汉书·赵广汉传》"},"example":{"text":"我想他们着实和民党作对，～，或者知道了老兄到来，便要拿办，也未可定。","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"similar":["见风是雨","无事生非","遇事生端"],"usage":"作谓语、定语；指挑拨是非"},{"id":44093,"word":"遇事风生","pinyin":"yù shì fēng shēng","abbr":"ysfs","explanation":"原形容处事果断而迅速。后指一有机会就挑拔是非，引起事端。","source":{"text":"所居好用世吏子孙新进年少者，专厉强壮蜂气，见事风生，无所回避，率多果敢之计，莫为持难。","book":"《汉书·赵广汉传》"},"example":{"text":"～，辈流退缩；责难山立，左右惊嗟。","book":"宋·陈亮《谢黄正言启》"},"usage":"作谓语；用于书面语"},{"id":44094,"word":"遇人不淑","pinyin":"yù rén bù shū","abbr":"yrbs","explanation":"淑：善，美。指女子嫁了一个品质不好的丈夫。后泛指结交了不正派的人。","source":{"text":"有女仳离，条其啸矣。条其啸矣，遇人之不涉淑矣。","book":"《诗经·王风·中谷有蓷》"},"example":{"text":"谁知彩凤随鸦度，～遭摧残。","book":"清·陈春晓《卖花婆》"},"usage":"作谓语；用于女性","story":["我国最早的诗歌总集《诗经》有诗描写女人的艰难生活，谈到女人要真正认识一个人很不容易，如果错嫁一个负心人，生活就会不幸福，直到最后被丈夫遗弃，她只有痛苦地叹息自己遇人不淑"]},{"id":44095,"word":"遇文王施礼乐，遇桀纣动干戈","pinyin":"yù wén wáng shī lǐ yuè，yù jié zhòu dòng gān gē","abbr":"ywwslyyjzdgg","explanation":"文王：周文王；桀：夏桀；纣：商纣。指碰到好人以礼相待，遇到坏人以武相待","source":{"text":"遇文王兴礼乐，遇桀纣呈干戈。","book":"宋·释普济《五灯会元》第48卷"},"example":{"text":"《醒世姻缘》第51回：“我程谟～，你休要赶尽杀绝了。”"},"usage":"作宾语、定语；用于处事"},{"id":44096,"word":"遇水叠桥","pinyin":"yù shuǐ dié qiáo","abbr":"ysdq","explanation":"遇水阻拦，就架桥通过。形容不怕阻力，奋勇前进。","source":{"text":"老施主见得最是，但我还有三个小徒，逢山开路，遇水叠桥，保护贫僧，方得到此。","book":"元·无名氏《衣袄车》第二折：“也不用排军校，你端的逢山开道，遇水叠桥。”明·吴承恩《西游记》第四十八回"},"example":{"text":"军旅逢山开路，～，岂有泥泞不堪行之理！","book":"明·罗贯中《三国演义》第五十回"},"similar":["遇水架桥"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":44097,"word":"遇水架桥","pinyin":"yù shuǐ jià qiáo","abbr":"ysjq","explanation":"遇水阻拦，就架桥通过。形容不怕阻力，奋勇前进。","source":{"text":"他们的劲头都鼓的当当响，真是逢山开路，遇水架桥，一气儿跑步向前。","book":"康濯《太阳初升的时候·竞赛》"},"similar":["遇水叠桥"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":44098,"word":"遇水迭桥","pinyin":"yù shuǐ dié qiáo","abbr":"ysdq","explanation":"遇水阻拦，就架桥通过。形容不怕阻力，奋勇前进。"},{"id":44099,"word":"遇物持平","pinyin":"yù wù chí píng","abbr":"ywcp","explanation":"指对待人和事持公正态度。","source":{"text":"苟遇物持平，轻重判然于中矣。","book":"宋·苏舜钦《朝奉大夫尚书度支郎王公行状》"},"usage":"作谓语、定语；用于处事"},{"id":44100,"word":"遇难呈祥","pinyin":"yù nàn chéng xiáng","abbr":"yncx","explanation":"碰到灾难也能化为吉祥。","source":{"text":"若是想逢凶化吉，遇难呈祥，找人能逢，谋事能成，赌钱能赢，起个数，便知分晓。","book":"昆曲《十五贯》第七场"},"example":{"text":"观众有这种心理，好人不怕落难，却要逢凶化吉，～。","book":"《光明日报》1982.12.20"},"similar":["遇难成祥"],"usage":"作谓语、定语、宾语；用于祝愿"},{"id":44101,"word":"遇难成祥","pinyin":"yù nàn chéng xiáng","abbr":"yncx","explanation":"碰到灾难也能化为吉祥。","source":{"text":"愿他诸事如意，遇难成祥。","book":"清·李汝珍《镜花缘》第八十四回"},"example":{"text":"日后大了，各人成家立业，或一时有不遂心的事，必然是～，逢凶化吉，却从这‘巧’字上来。","book":"清·曹雪芹《红楼梦》第四十二回"},"similar":["逢凶化吉","遇难呈祥"],"usage":"作谓语、定语、宾语；用于祝愿"},{"id":44102,"word":"遍体鳞伤","pinyin":"biàn tǐ lín shāng","abbr":"btls","explanation":"浑身受伤，伤痕象鱼鳞一样密。形容受伤很重。","source":{"text":"打的遍体鳞伤，着实走不动了。","book":"清·吴趼人《痛史》第六回"},"example":{"text":"经过这十多天的轰炸，广州是～了。","book":"夏衍《广州在轰炸中》"},"similar":["皮开肉绽","体无完肤"],"opposite":["完好无损"],"usage":"作谓语、定语；形容身体受到摧残，伤势很重"},{"id":44103,"word":"遍地开花","pinyin":"biàn dì kāi huā","abbr":"bdkh","explanation":"比喻好的事物到处涌现或普遍发展。","source":{"text":"史家寨的民兵，掌握了敌人夜间出动的规律，打了他个伏击；军城游击小组配合部队……总之，这两三天是遍地开花。","book":"魏焕宗《山区巧打麻雀战》"},"example":{"text":"～闹，冲天干劲传。粮棉大增产，煤铁倍加权。","book":"董必武《祝贺建国十周年》"},"similar":["百花齐放","推而广之","层出不穷"],"opposite":["一花独秀"],"usage":"作谓语、定语；比喻好的事物到处涌现"},{"id":44104,"word":"遏云绕梁","pinyin":"è yún rào liáng","abbr":"eyrl","explanation":"遏：停止。歌声优美，使游动的浮云为之停下来静听，似余音绕着屋梁，不愿散去。","source":{"text":"惊神泣鬼，皆言词赋之雄豪；遏云绕梁，原是歌耷之嘹亮。","book":"明·程登吉《幼学琼林·文事》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“惊神泣鬼，皆言辞赋之雄豪；～，原是歌音之嘹亮。”"},"usage":"作谓语、定语；用于声音等"},{"id":44105,"word":"遏密八音","pinyin":"è mì bā yīn","abbr":"emby","explanation":"遏：阻止；密：寂静。各种乐器停止演奏，乐声寂静。旧指皇帝死后停乐举哀。后也用以形容国家元首之死。","source":{"text":"三载，四海遏密八音。","book":"《尚书·舜曲》"},"example":{"text":"余壬午年至京，当～之际，未得耳聆目赏。","book":"清·梁绍壬《两般秋雨庵随笔》卷三"},"similar":["八音遏密"],"usage":"作谓语、定语；形容国家元首之死"},{"id":44106,"word":"遏恶扬善","pinyin":"è è yán shàn","abbr":"eeys","explanation":"遏：阻止；扬：宣扬。禁绝坏事，宣扬提倡好事。","source":{"text":"君子以遏恶扬善，顺天休命。","book":"《周易·大有元亨》"},"example":{"text":"是以君子一类求同，～，以致其大。","book":"三国·魏·阮籍《通易论》"},"similar":["惩恶扬善"],"usage":"作谓语、定语；指惩恶扬善"},{"id":44107,"word":"遏渐防萌","pinyin":"è jiàn fáng méng","abbr":"ejfm","explanation":"犹言杜渐防萌。","source":{"text":"贡真绌伪，遏渐防萌。","book":"《隶释·汉冀州从事张表碑》"},"similar":["防微杜渐"],"usage":"作谓语、宾语；多指对错误或坏事"},{"id":44108,"word":"遐尔闻名","pinyin":"xiá ěr wén míng","abbr":"xewm","explanation":"形容名声大，远近都知道。","example":{"text":"中国的景泰蓝，一向是～的。"}},{"id":44109,"word":"遐州僻壤","pinyin":"xiá zhōu pì rǎng","abbr":"xzpr","explanation":"指边远偏僻的地方。","source":{"text":"我国家重于民社之寄，虽遐州僻壤，必慎选守令以抚摩其人民，苏息其凋瘵。","book":"明·宋濂《送王明府之官序》"},"similar":["遐方绝域"],"usage":"作宾语、定语；用于书面语"},{"id":44110,"word":"遐思遥爱","pinyin":"xiá fāng yáo ài","abbr":"xsya","explanation":"在远处思念着、爱慕着。形容爱慕深切。","source":{"text":"只因那宝玉闻得傅试有个妹子，名唤傅秋芳，也是个琼闺秀玉，常听人说才貌俱全，虽自未亲睹，然遐思遥爱之心十分诚敬。","book":"清·曹雪芹《红楼梦》第三十五回"},"usage":"作宾语、定语；用于书面语"},{"id":44111,"word":"遐方绝域","pinyin":"xiá fāng jué yù","abbr":"xfjy","explanation":"指边远偏僻的地区。","source":{"text":"后二年，出任宦，便有饭蔬衣餗，遐方绝域，尽天下古文奇字之志，日就月将，渐益堆积。","book":"宋·李清照《金石录后序》"},"example":{"text":"明·胡应麟《少室山房笔丛·四部正讹》：“名山大川，～，固本治水作贡之文。”"},"similar":["遐方绝壤"],"usage":"作宾语、定语；用于书面语"},{"id":44112,"word":"遐方绝壤","pinyin":"xiá fāng jué rǎng","abbr":"xfjr","explanation":"指边远偏僻的地区。同“遐方绝域”。","source":{"text":"庆历皇佑之盛，复见于今，虽遐方绝壤，皆当梯航而至矣。","book":"宋·陆游《上殿札子》"},"similar":["遐方绝域"],"usage":"作宾语、定语；用于书面语"},{"id":44113,"word":"遐迩一体","pinyin":"xiá ěr yī tǐ","abbr":"xeyt","explanation":"指远近犹如一个整体。形容协调统一。","source":{"text":"以偃甲兵于此，而息讨伐于彼，遐迩一体，中外提福，不亦康乎。","book":"汉·司马相如《难蜀父老》"},"example":{"text":"《南齐书·武帝纪》：“今～，车轨同文，宜高选学官，广延胄子。”"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":44114,"word":"遐迩知名","pinyin":"xiá ěr zhī míng","abbr":"xezm","explanation":"遐：远；迩：近。形容名声很大，远近都知道。","source":{"text":"上流声议，遐迩所闻。","book":"《南齐书·高帝纪上》"},"similar":["遐迩闻名"],"opposite":["默默无闻"],"usage":"作谓语、宾语、定语；指名声很大"},{"id":44115,"word":"遐迩著闻","pinyin":"xiá ěr zhù wén","abbr":"xezw","explanation":"远近闻名。形容名声很大。","source":{"text":"近代有王，号鸯输代摩，硕学陪睿，自制《声明论》，重学敬德，遐迩著闻。","book":"唐·玄奘《大唐西域记·尼波罗国》"},"similar":["遐迩知名","遐迩闻名"],"usage":"作谓语、定语；用于书面语"},{"id":44116,"word":"遐迩闻名","pinyin":"xiá ěr wén míng","abbr":"xewm","explanation":"遐：远；迩：近。形容名声很大，远近都知道。","source":{"text":"上流声议，遐迩所闻。","book":"《南齐书·高帝纪上》"},"example":{"text":"江西景德镇的瓷器质地优良，工艺精美，一向～。"},"similar":["举世闻名","闻名遐尔","大名鼎鼎"],"opposite":["默默无闻"],"usage":"作谓语、宾语、定语；指名声很大"},{"id":44117,"word":"遒文壮节","pinyin":"qiú wén zhuàng jié","abbr":"qwzj","explanation":"遒：强劲。指文辞刚劲有力，节奏雄壮。","source":{"text":"曹氏父子鞍马间为文，往往横槊赋诗，故其遒文壮节，抑扬怨哀悲离之作，尤极于古。","book":"宋·胡仔《苕溪渔隐丛话后集·杜子美四》"},"example":{"text":"～，于汉季得两人焉，孔文举、臧子源是也。","book":"清·刘熙载《艺概·文概》卷一"},"usage":"作宾语；用于文章或书法等"},{"id":44118,"word":"道三不着两","pinyin":"dào sān bù zháo liǎng","abbr":"dsbzl","explanation":"道：说话；着：接触到。说话三句有两句说不到地方。形容说话不着边际。","source":{"text":"道三不着两，四下乱倡扬，取得经来唐三藏，再莫管他人瓦上霜。","book":"明·胡文焕《群音类选·苏王文》"},"example":{"text":"文杏又小，～的。莺儿一个人，不够服侍的，还要买一个丫头来你使。","book":"清·曹雪芹《红楼梦》第48回"},"usage":"作谓语、定语；用于说话"},{"id":44119,"word":"道不举遗","pinyin":"dào bù jǔ yí","abbr":"dbjy","explanation":"路上没有人把别人丢失的东西拾走。形容社会风气好。同“道不拾遗”。","source":{"text":"部兵皆群盗，横相侵牟，祾案罪杀之，虽亲故无脱者，至道不举遗。","book":"《新唐书·阚祾传》"},"example":{"text":"至上元间，国人推女子为王，号悉莫，威令整肃，～。","book":"明·罗曰褧《咸宾录·南夷志一·爪哇》"},"similar":["道不掇遗","道不拾遗"],"usage":"作谓语、定语、状语；指好的社会风气"},{"id":44120,"word":"道不同不相为谋","pinyin":"dào bù tóng bù xiāng wéi móu","abbr":"dbtbxwm","explanation":"走着不同道路的人，就不能在一起谋划。比喻意见或志趣不同的人就无法共事。","source":{"text":"道不同，不相为谋。","book":"《论语·卫灵公》"},"example":{"text":"我非不知银行之可以发财也，其如“～”何。","book":"鲁迅《两地书·六六》"}},{"id":44121,"word":"道不同，不相为谋","pinyin":"dào bù tóng，bù xiāng wéi móu","abbr":"dbtbxwm","explanation":"比喻志趣不同的人不会在一起共事。","source":{"text":"道不同，不相为谋。","book":"先秦·孔子《论语·卫灵公》"},"example":{"text":"明明求财利，常恐困乏者，庶人之事也，故～。","book":"汉·杨恽《报孙会宗书》"},"similar":["道不相谋"],"opposite":["志同道合"],"usage":"作宾语、分句；指志不同的人不能一起共事","story":["春秋时期，孔子带领弟子周游列国碰壁后，在冉求的帮助下，终于回到了父母之邦鲁国，主事的季康子嫌他太老，没有重用他。他认为与季康子是“道不同，不相为谋。”于是闲居起来，专心著述，编辑整理《诗》《书》《礼》《乐》《春秋》等"]},{"id":44122,"word":"道不拾遗","pinyin":"dào bù shí yí","abbr":"dbsy","explanation":"遗：失物。路上没有人把别人丢失的东西拾走。形容社会风气好。","source":{"text":"道不拾遗，民不妄取。","book":"《韩非子·外储说左上》：“国无盗贼，道不拾遗。”《战国策·秦策一》"},"example":{"text":"人人称赞～，夜不闭户的良好社会风气。"},"similar":["路不拾遗"],"opposite":["打家劫舍"],"usage":"作谓语、定语、状语；指好的社会风气","story":["战国时期卫国人商鞅因逃难到秦国，主张法制国家，受到秦孝王的重用，他先后制定一系列新法，废除维护贵族特权的旧法，主张在法律面前人人平等，执法严明，不循私情。经过一段时间，秦国社会安定，夜不闭户，道不拾遗，国力强盛"]},{"id":44123,"word":"道不拾遗，夜不闭户","pinyin":"dào bù shí yí，yè bù bì hù","abbr":"dbsyybbh","explanation":"遗：遗失的东西；户：门。东西丢在路上没有人拾走，夜里睡觉都不需要关门防盗。形容社会风气好。","source":{"text":"谋闭而不兴，盗窃乱贼而不作，故外户而不闭。","book":"战国·韩·韩非《韩非子·外储说左》：“子产退而为政五年，国无盗贼，道不拾遗。”西汉·戴圣《礼记·礼运》"},"example":{"text":"农会势盛，地方牌赌禁绝，盗匪潜踪。有些地方真个～。","book":"毛泽东《湖南农民运动考察报告》"},"usage":"作宾语、定语、分句；用于社会","story":["战国时期，卫国人商鞅因逃难到秦国，主张法制国家，受到秦孝王的重用，他先后制定一系列新法，废除维护贵族特权的旧法，主张在法律面前人人平等，执法严明，不循私情。经过一段时间，秦国社会安定，夜不闭户，道不拾遗，国力强盛"]},{"id":44124,"word":"道不掇遗","pinyin":"dào bù duō yí","abbr":"dbdy","explanation":"路上没有人把别人丢失的东西拾走。形容社会风气好。同“道不拾遗”。","source":{"text":"降、败、杀人及剽动者斩，盗者十倍取偿，杀牛马者没为奴婢，故道不掇遗。","book":"《新唐书·东夷传·高丽》"},"similar":["道不拾遗"],"usage":"作谓语、定语、状语；指好的社会风气"},{"id":44125,"word":"道不相谋","pinyin":"dào bù xiāng móu","abbr":"dbxm","explanation":"指思想志向不同的人不会在一起共事。","source":{"text":"子曰：‘道不同，不相为谋。’","book":"语出《论语·卫灵公》"},"example":{"text":"孙为台臣时，与徐华亭莫逆，疏诋新郑最丑，二公～，相去亦三十余年。","book":"明·沈德符《野获编·内阁二·新郑富平身后》"},"similar":["道不同，不相为谋"],"usage":"作谓语、定语；用于处世"},{"id":44126,"word":"道东说西","pinyin":"dào dōng shuō xī","abbr":"ddsx","explanation":"指乱加谈论。同“道西说东”。","source":{"text":"自入舍做女婿，觑俺咱似儿戏，使着后，道东说西畅憋气。","book":"《刘知远诸宫调·知远别三娘太原投事》"},"similar":["道西说东","说三道四"],"usage":"作谓语、宾语、定语；用于处事"},{"id":44127,"word":"道义之交","pinyin":"dào yì zhī jiāo","abbr":"dyzj","explanation":"交：交情，友谊。有道德有正义感的交往和友情。指互相帮助，互相支持的朋友。","source":{"text":"道义之交，只此已足，何必更为介介。","book":"清·李绿园《歧路灯》第三十八回"},"usage":"作宾语；用于朋友"},{"id":44128,"word":"道傍之筑","pinyin":"dào bàng zhī zhù","abbr":"dbzz","explanation":"比喻无法成功的事。","source":{"text":"如当路筑室，得人而与之谋所为，路人之意不同，故不得遂成也。","book":"《诗经·小雅·小旻》：“如彼筑室于道谋，是用不溃于成。”郑玄注"},"example":{"text":"于时梅侍御客生独荐李成梁，又不合当事者意，复成～。","book":"明·李贽《西征奏议后语》"},"similar":["道傍筑室"],"usage":"作主语、宾语；指无法成功的事"},{"id":44129,"word":"道傍筑室","pinyin":"dào bàng zhù shì","abbr":"dbzs","explanation":"比喻杂采各家之说。亦比喻无法成功的事。","source":{"text":"如彼筑室于道谋，是用不溃于成。","book":"《诗经·小雅·小旻》"},"example":{"text":"后世众手修书，～，掠人之文，窃钟掩耳，皆固之作俑也。","book":"宋·郑樵《总序》"},"similar":["道旁筑室","筑室道谋"],"usage":"作谓语、定语、宾语；指没有主见"},{"id":44130,"word":"道傍苦李","pinyin":"dào páng kǔ lǐ","abbr":"dbkl","explanation":"比喻庸才，无用之才。同“道边苦李”。","source":{"text":"道傍苦李犹垂实，城外甘棠已布阴。","book":"唐·许浑《和淮南王相公与宾僚同游瓜洲别业，题旧书斋》诗"}},{"id":44131,"word":"道古稽今，言远合近","pinyin":"dào gǔ jī jīn，yán yuǎn hé jìn","abbr":"dgjjyyhj","explanation":"道：讲；稽：考核；合：契合。谈论古时的事要结合今天的实际，说远处的事要结合眼前的事。","source":{"text":"夫道古者稽之今，言远者合之近。","book":"汉·桓宽《盐铁论·论灾》"},"usage":"作宾语、定语；用于作文或说话等"},{"id":44132,"word":"道合志同","pinyin":"dào hé zhì tóng","abbr":"dhzt","explanation":"指彼此的志趣理想一致。","source":{"text":"及其见举于汤武、周文，诚道合志同，玄漠神通。","book":"晋·陈寿《三国志·魏志·陈思王植传》"},"example":{"text":"我们需要～的朋友。"},"similar":["志同道合"],"opposite":["同床异梦"],"usage":"作谓语、定语；指志趣相投的人","story":["三国时期，魏文帝曹丕即位后，对曹植一直心存疑忌，寻找各种机会加以陷害，由于母后的干预，曹丕才没有把弟弟置于死地。曹植苦于无用武之地，他上书说伊尹是陪嫁的小臣、吕尚当屠夫钓叟，他们遇到了志同道合的商汤和周文王，辅佐他们成大业"]},{"id":44133,"word":"道同义合","pinyin":"dào tóng yì hé","abbr":"dtyh","explanation":"犹言道合志同。","source":{"text":"他第三个兄弟钱塘君与我道同义合，相得甚欢。","book":"清·李渔《蜃中楼·婚诺》"},"example":{"text":"他有几个～的朋友。"},"similar":["道同志合"],"usage":"作谓语、定语；用于志趣相投的人"},{"id":44134,"word":"道同契合","pinyin":"dào tóng qì hé","abbr":"dtqh","explanation":"犹言道合志同。","source":{"text":"道同契合，体异心并。","book":"晋·陆云《失题》诗"},"similar":["道同志合","同志合道"],"usage":"作谓语、定语；用于志趣相投的人"},{"id":44135,"word":"道同志合","pinyin":"dào tóng zhì hé","abbr":"dtzh","explanation":"犹言道合志同。","source":{"text":"尝托僚寀，获友高明，道同志合，出处如一。","book":"宋·司马光《又谢庞参政启》"},"example":{"text":"予以修《明史》，亦馆于徐，与处士～，日讨论天地阴阳之变，伯王大略。","book":"清·王源《刘处士墓表》"},"similar":["志同道合","道同契合"],"usage":"作谓语、定语；用于志趣相投的人"},{"id":44136,"word":"道听涂说","pinyin":"dào tīng tú shuō","abbr":"dtts","explanation":"从道路上听到，在道路上传说。泛指没有根据的传闻。","source":{"text":"子曰：‘道听而涂说，德之弃也。’","book":"《论语·阳货》"},"example":{"text":"小说家者流，盖出于稗官，街谈巷语，～者之所造也。","book":"《汉书·艺文志》"},"similar":["道听途说"],"usage":"作主语、宾语、定语；指传闻"},{"id":44137,"word":"道听耳食","pinyin":"dào tīng ěr shí","abbr":"dtes","explanation":"对传闻之辞不加去取，盲目轻信。","source":{"text":"村学究道听耳食，窃一言以诧新奇，此等之论是也。","book":"清·叶燮《原诗·外篇下》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":44138,"word":"道听途说","pinyin":"dào tīng tú shuō","abbr":"dtts","explanation":"道、途：路。路上听来的、路上传播的话。泛指没有根据的传闻。","source":{"text":"小说家者流，盖出于稗官，街谈巷语，道听途说者之所造也。","book":"《论语·阳货》：“道听而途说，德之弃也。”《汉书·艺文志》"},"example":{"text":"妹子～，不知是否？尚求指示。","book":"清·李汝珍《镜花缘》第五十三回"},"similar":["小道消息","捕风捉影","海外奇谈"],"opposite":["言之有据","有根有据","言之凿凿"],"usage":"作主语、宾语、定语；指传闻","story":["古时学者艾子的邻居毛空是一个不务正业的人，经常把外边听到的事情加以夸大说给艾子听。一次他说：“一只鸭子一次下了100个蛋。”艾子不信，他又说天上掉下一块二十丈长十丈宽的大肉，而且还信誓旦旦地说他亲耳听来的"]},{"id":44139,"word":"道在人为","pinyin":"dào zài rén wéi","abbr":"dzrw","explanation":"犹言事在人为。","source":{"text":"净云：不打紧，道在人为，你见那里又一位王勃殿试来了。","book":"《金瓶梅词话》第三一回"},"similar":["事在人为"],"usage":"作宾语、分句；用于劝诫人"},{"id":44140,"word":"道在屎溺","pinyin":"dào zài shǐ nì","abbr":"dzsn","explanation":"比喻道之无所不在。","source":{"text":"东郭子问于庄子曰：‘所谓道，恶乎在？’庄子曰：‘无所不在。’东郭子曰：‘期而后可。’庄子曰：‘在蝼蚁。’曰：‘何其下耶？’曰：‘在稊稗。’……曰：‘何其愈甚耶？’曰：‘在屎溺。’东郭子不应。","book":"《庄子·知北游》"},"example":{"text":"以道眼观一切物，物物平等，本无大小堑久贵贱善恶之殊。庄生知之，故曰～，每下愈况。","book":"严复《救亡决论》"},"usage":"作宾语、定语；指道无处不在","story":["战国时期，东郭子问道家代表人庄周，“道”是什么，到底在什么地方。庄子说道在蚂蚁洞里，东郭子不明白，再问，庄子说道存在于野草、砖瓦、碎石甚至在屎尿里。东郭子说怎么道会越来越卑下，庄子说道就在于那些卑微低贱的地方"]},{"id":44141,"word":"道大莫容","pinyin":"dào dà mò róng","abbr":"ddmr","explanation":"原指孔子之道精深博大，所以天下容纳不了他。后用以正确的道理不为世间所接受。","source":{"text":"夫子之道，至大也，故天下莫能容夫子。","book":"《史记·孔子世家》"},"example":{"text":"～，反动派仇视共产主义真理是一点也不奇怪的。"},"usage":"作谓语、定语；指不为世间所接受"},{"id":44142,"word":"道头会尾","pinyin":"dào tóu huì wěi","abbr":"dthw","explanation":"说个开头就知道结果。形容思维敏捷、悟性好。同“道头知尾”。","source":{"text":"问：‘师唱谁家曲，宗风嗣阿谁？’师曰：‘道头会尾，举意知心。’","book":"《五灯会元·芭蕉清禅师法嗣·承天辞确禅师》"},"similar":["道头知尾"],"usage":"作谓语、宾语、定语；用于人的思维等"},{"id":44143,"word":"道头知尾","pinyin":"dào tóu zhī wěi","abbr":"dtzw","explanation":"说个开头就知道结果。形容思维敏捷、悟性好。","source":{"text":"惟圣人道头知尾，下学便上达，若教学者，则须循其序也。","book":"《朱子语类》卷四九"},"example":{"text":"抑且聪明伶俐，凡事～。","book":"《何典》第七回"},"similar":["道头会尾"],"usage":"作谓语、宾语、定语；用于人的思维等"},{"id":44144,"word":"道存目击","pinyin":"dào cún mù jī","abbr":"dcmj","explanation":"一个人具有深厚的道德修养，人们只需一接触便能感受得到。","source":{"text":"子路曰：‘吾子欲见温伯雪子久矣，见之而不言，何邪？’仲尼曰：‘若夫人者，目击而道存矣，亦不可以容声矣。’","book":"战国·宋·庄周《庄子·田子方》"},"example":{"text":"色瘁形枯应笑屈，～岂非温？","book":"宋·苏轼《是日偶至野人汪氏之居仍用前韵》"},"usage":"作定语；指一个人的道德修养"},{"id":44145,"word":"道学先生","pinyin":"dào xué xiān shēng","abbr":"dxxs","explanation":"指思想、作风特别迂腐的读书人。","source":{"text":"仲友喜的是俊爽名流，恼的是道学先生。","book":"明·凌濛初《二刻拍案惊奇》卷十二"},"example":{"text":"你怎么也是这么个～！","book":"清·曹雪芹《红楼梦》第一百九回"},"usage":"作主语、宾语、定语；指人迂腐"},{"id":44146,"word":"道寡称孤","pinyin":"dào guǎ chēng gū","abbr":"dgcg","explanation":"指自封为王，称霸一方。","source":{"text":"都待要分疆土，霸山川，寻战讨，相攻拒，出来的道寡称孤。","book":"明·无名氏《陈仓路》第三折"},"similar":["称孤道寡"],"usage":"作谓语、宾语；比喻狂妄自大，为所欲为"},{"id":44147,"word":"道尽涂殚","pinyin":"dào jìn tú dān","abbr":"djtd","explanation":"涂：通“途”；殚：尽。到了无路可走的境地。比喻穷途没路，末日来临。","source":{"text":"自卜已审，若道尽涂殚则已耳，足下无事冤之令转于沟壑也。","book":"《晋书·嵇康传》"},"similar":["走投无路","道尽途穷"],"opposite":["前途无量"],"usage":"作谓语、定语；指陷于绝境"},{"id":44148,"word":"道尽涂穷","pinyin":"dào jìn tú qióng","abbr":"djtq","explanation":"指无路可走，陷于绝境。","source":{"text":"三国·魏·嵇康《与山巨源绝交书》：“私意自试，必不能堪其所不乐，自卜已审，若道尽涂穷，则已耳。”《晋书·嵇康传》作“道尽途殚”。"},"similar":["道尽途穷"],"usage":"作宾语、定语；指陷于绝境"},{"id":44149,"word":"道尽途殚","pinyin":"dào jìn tú dān","abbr":"djtd","explanation":"指无路可走，陷于绝境。","source":{"text":"三国·魏·嵇康《与山巨源绝交书》：“私意自试，必不能堪其所不乐，自卜已审，若道尽涂穷，则已耳。”《晋书·嵇康传》作“道尽途殚”。"},"similar":["道尽途穷","道尽涂殚"],"usage":"作宾语、定语；指陷于绝境"},{"id":44150,"word":"道尽途穷","pinyin":"dào jìn tú qióng","abbr":"djtq","explanation":"道、途：路。走到路的尽头。形容无路可走，面临末日。","source":{"text":"自卜已审，若道尽涂殚则已耳，足下无事冤之令转于沟壑也。","book":"《晋书·嵇康传》"},"example":{"text":"国学国学，新学家既“薄为不足道”，国学家又道而不能亨，你真要～了！","book":"鲁迅《热风·“以震其艰深”》"},"similar":["穷途末路","山穷水尽"],"opposite":["前程远大"],"usage":"作宾语、定语；指陷于绝境"},{"id":44151,"word":"道山学海","pinyin":"dào shān xué hǎi","abbr":"dsxh","explanation":"道、学：学问。学识比天高比海深。形容学识渊博。","source":{"text":"道山学海功非浅，孔思周情文可传。","book":"明·无名氏《鸣凤记·邹林游学》"},"usage":"作主语、宾语；形容学识渊博"},{"id":44152,"word":"道弟称兄","pinyin":"dào dì chēng xiōng","abbr":"ddcx","explanation":"朋友间以兄弟相称，表示关系亲密。","source":{"text":"一会儿要和你道弟称兄，一会儿还要骂得欠涅磐出世。","book":"郭沫若《创造十年续篇》三"},"similar":["称兄道弟"],"usage":"作谓语、定语；形容关系密切"},{"id":44153,"word":"道微德薄","pinyin":"dào wēi dé báo","abbr":"dwdb","explanation":"道行和才能都很差。多作谦辞。","source":{"text":"贫僧道微德薄，不堪为师。","book":"《古今小说·月明和尚度柳翠》"},"usage":"作谓语、定语；用于谦辞"},{"id":44154,"word":"道德文章","pinyin":"dào dé wén zhāng","abbr":"ddwz","explanation":"指思想品德和学识学问。","source":{"text":"道德文章传几世，到君合上三台位。","book":"宋·辛弃疾《渔家傲·为余伯熙察院寿》"},"example":{"text":"尊人～，足为当代宗式。","book":"清·淮阴百一居士《壶天录》卷下"},"usage":"作主语、宾语；指学问与品德"},{"id":44155,"word":"道旁苦李","pinyin":"dào páng kǔ lǐ","abbr":"dpkl","explanation":"比喻不被重视的人。","source":{"text":"王戎七岁，尝与诸小儿游，看道旁李树多子折枝，诸儿竞走取之，唯戎不动。人问之，答曰：‘树在道旁而多子，此必苦李。’","book":"南朝·宋·刘义庆《世说新语·雅量》"},"example":{"text":"决飞只抢榆枋，白发青衫，竟作～。","book":"清·和邦额《夜谭随录·阮龙光》"},"similar":["道边苦李"],"usage":"作主语、宾语、定语；指庸才","story":["王戎七岁时，曾经与很多小孩一起到外边玩耍，看到路旁有许多李子树上长满了李子，枝头压得很低。其他小朋友赶忙跑过去摘李子。只有王戎不动。别人问他为什么不去摘，他说李子树在路边能有这么多李子证明其很酸苦，否则早被摘光了"]},{"id":44156,"word":"道无拾遗","pinyin":"dào wú shí yí","abbr":"dwsy","explanation":"路上没有人把别人丢失的东西拾走。形容社会风气好。同“道不拾遗”。","source":{"text":"商贾重宝，单车露宿，牛马放牧，道无拾遗。","book":"《东观汉记·光武帝纪》"},"example":{"text":"自是内部肃然不言，咸称其有神，～。","book":"《隋书·艺术传·韦鼎》"},"similar":["道不拾遗"],"usage":"作谓语、定语、状语；指好的社会风气"},{"id":44157,"word":"道殣相属","pinyin":"dào jìn xiāng shǔ","abbr":"djxs","explanation":"道路上饿死的人到处都是。同“道殣相望”。","source":{"text":"时遭饥岁，疾疫流行，医疗无功，道殣相属。","book":"唐·玄奘《大唐西域记·乌仗那国》"},"similar":["道殣相枕"],"usage":"作宾语、定语；用于灾荒或战乱时"},{"id":44158,"word":"道殣相望","pinyin":"dào jìn xiāng wàng","abbr":"djxw","explanation":"殣：饿死。道路上饿死的人到处都是。","source":{"text":"宫室兹侈，道殣相望。","book":"春秋·鲁·左丘明《左传·昭公二年》"},"example":{"text":"昆明被围久，粮馈阻绝，～。","book":"《清史稿·夏毓秀传》"},"similar":["哀鸿遍野","道殣相属"],"usage":"作宾语、定语；用于灾荒或战乱时"},{"id":44159,"word":"道殣相枕","pinyin":"dào jìn xiāng zhěn","abbr":"djxz","explanation":"道路上饿死的人到处都是。同“道殣相望”。","source":{"text":"明年大饥，道殣相枕，张罄家以糜粥济之，活者万计。","book":"郑观应《救时揭要·救济速报》"},"similar":["道殣相属"],"usage":"作宾语、定语；用于灾荒或战乱时"},{"id":44160,"word":"道而不径","pinyin":"dào ér bù jìng","abbr":"debj","explanation":"道：走路。径：小路。走路要走大路而不走小路，以免遇到危险。","source":{"text":"故舟而不游，道而不径，能全支体以守宗庙，可谓孝矣。","book":"《吕氏春秋·孝行览》"},"example":{"text":"岂不闻君子～，舟而不游。","book":"清·褚人获《隋唐演义》第十一回"},"usage":"作宾语；指不走小路"},{"id":44161,"word":"道西说东","pinyin":"dào xī shuō dōng","abbr":"dxsd","explanation":"说东家，讲西家。形容没有中心地随意说。","source":{"text":"那堪长老鼓两片皮，摇三寸舌，说东道西，指南言北。","book":"宋·释惟白《续传灯录》卷二十"},"example":{"text":"阿你两个，何用忩忩？阿谁许你，各拟论功。言词相毁，～。","book":"《敦煌变文集·茶酒论一卷》"},"similar":["道东说西"],"usage":"作谓语、宾语、定语；用于处事"},{"id":44162,"word":"道貌俨然","pinyin":"dào mào yǎn rán","abbr":"dmyr","explanation":"犹道貌岸然。指神态严肃，一本正经的样子。","source":{"text":"爷爷从前原也是荒唐的人，他到后来才变为道貌俨然的。","book":"巴金《家》九"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“曾相～，出语亦有冷隽的时候了。”"},"similar":["道貌岸然","道貌凛然"],"usage":"作谓语、定语、状语；用于嘲讽人"},{"id":44163,"word":"道貌凛然","pinyin":"dào mào lǐn rán","abbr":"dmlr","explanation":"犹道貌岸然。指神态严肃，一本正经的样子。","source":{"text":"光严整行之次，忽见维摩，道貌凛然，仪形垒落。","book":"《敦煌变文集·维摩诘经讲经文》"},"similar":["道貌岸然","道貌俨然"],"usage":"作谓语、定语、状语；用于嘲讽人"},{"id":44164,"word":"道貌岸然","pinyin":"dào mào àn rán","abbr":"dmar","explanation":"道貌：正经严肃的容貌；岸然：高傲的样子。指神态严肃，一本正经的样子。","source":{"text":"又八九年，成忽自至，黄巾氅服，岸然道貌。","book":"清·蒲松龄《聊斋志异·成仙》"},"example":{"text":"因看见端甫～，不敢造次。","book":"清·吴趼人《二十年目睹之怪现状》第一百四回"},"similar":["一本正经","正襟危坐","装腔作势"],"opposite":["嬉皮笑脸"],"usage":"作谓语、定语、状语；用于嘲讽人"},{"id":44165,"word":"道路以目","pinyin":"dào lù yǐ mù","abbr":"dlym","explanation":"在路上遇到不敢交谈，只是以目示意。形容人民对残暴统治的憎恨和恐惧。","source":{"text":"国人莫敢言，道路以目。","book":"《国语·周语上》"},"example":{"text":"此后要防的是“～”了，我们等待着遮眼文学吧。","book":"鲁迅《伪自由书·止哭文学》"},"similar":["缄口不言","三缄其口"],"opposite":["畅所欲言","敢说敢做"],"usage":"作谓语、定语；用于时局等","story":["周厉王时期，由于他的残暴统治，民怨沸腾，有人当众指责周厉王，邵公对周厉王说民不堪命。周厉王大怒，派卫巫去监督那些说他坏话的人，发现有就立即杀头。后来百姓慑于暴政的威力，在路上相见不敢交谈，只好用交换眼色来交谈"]},{"id":44166,"word":"道路传闻","pinyin":"dào lù chuán wén","abbr":"dlcw","explanation":"在道路上传播听到的消息。指社会上广为流传的消息。","source":{"text":"道路传闻，尚有假借取缔与指导名义，摧残合法组织，箝制正当议论，拘捕热血青年……","book":"邹韬奋《抗战以来·“来宾”种种》"},"similar":["马路新闻","道听途说","小道消息"],"usage":"作宾语、定语；用于言论等"},{"id":44167,"word":"道路侧目","pinyin":"dào lù cè mù","abbr":"dlcm","explanation":"侧目：侧目而视。在路上相遇，不敢交谈，以目示意。形容政治黑暗暴虐。","source":{"text":"所在囹圄皆满，道路侧目，无敢言者。","book":"《元史·阿鲁诨萨理传》"},"example":{"text":"在‘四害’横行，～的时期，我常常想到振铎，还为他的早逝而庆幸！","book":"冰心《晚晴集·追念振铎》"},"similar":["道路以目"],"usage":"作谓语、定语；用于时局等"},{"id":44168,"word":"道路指目","pinyin":"dào lù zhǐ mù","abbr":"dlzm","explanation":"路上行人用手指，用眼睛看。形容事情已经很明显，众人皆知。","source":{"text":"迄今抗战阵营中尚潜伏若干妥协主和分子，道路指目，当非空穴来风。","book":"邹韬奋、茅盾等《我们对国事的态度和主张》"},"similar":["众目睽睽"],"usage":"作谓语、定语；用于明摆的事"},{"id":44169,"word":"道路相告","pinyin":"dào lù xiāng gào","abbr":"dlxg","explanation":"路上行人互相传递消息。形容消息或事件引人注目。"},{"id":44170,"word":"道路相望","pinyin":"dào lù xiāng wàng","abbr":"dlxw","explanation":"望：看见。在道上可以互相看见。形容人络绎不绝。","source":{"text":"新罗日蹙，百姓涂炭，遣使请援，道路相望。","book":"唐·李世民《命俭等征诏》"}},{"id":44171,"word":"道路藉藉","pinyin":"dào lù jí jí","abbr":"dljj","explanation":"藉藉：纷乱众多的样子。形容社会上人们众说纷纭，纷纷传告。","source":{"text":"而道路藉藉，或谓执事者将循政府之意，而从事于武力解决。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十五回"},"usage":"作宾语、定语；用于消息传递等"},{"id":44172,"word":"道边苦李","pinyin":"dào biān kǔ lǐ","abbr":"dbkl","explanation":"比喻庸才，无用之才。","source":{"text":"王戎七岁，尝与诸小儿游，看道旁李树多子折枝，诸儿竞走取之，唯戎不动。人问之，答曰：‘树在道旁而多子，此必苦李。’取之信然。","book":"南朝·宋·刘义庆《世说新语·雅量》"},"example":{"text":"云霄直上，诸公衮衮，乃作～。","book":"宋·姜夔《永遇乐·次韵辛克清》词"},"similar":["无用之材"],"usage":"作主语、宾语；指庸才","story":["王戎七岁时，曾经与很多小孩一起到外边玩耍，看到路旁有许多李子树上长满了李子，枝头压得很低。其他小朋友赶忙跑过去摘李子。只有王戎不动。别人问他为什么不去摘，他说李子树在路边能有这么多李子证明其很酸苦，否则早被摘光了"]},{"id":44173,"word":"道远日暮","pinyin":"dào yuàn rì mù","abbr":"dyrm","explanation":"暮：太阳落山。道路很遥远，而且太阳西沉了。比喻还有很多事要做，可时间不多了。","source":{"text":"六曰：道远日暮，士众劳惧，倦而未食，解甲而息。","book":"《吴子·料敌》"},"similar":["日暮道远"],"usage":"作宾语、定语；比喻还有很多事要做"},{"id":44174,"word":"道远知骥","pinyin":"dào yuǎn zhī jì","abbr":"dyzj","explanation":"骥：千里马。路途遥远才可以辨别良马。比喻经过长久的锻练，才能看出人的优劣。","source":{"text":"道远知骥，世伪知贤。","book":"三国·魏·曹操《矫志》"},"similar":["路遥知马力"],"usage":"作宾语、定语；指时间检验人才"},{"id":44175,"word":"道远知骥，世伪知贤","pinyin":"dào yuǎn zhī jì，shì wěi zhī xián","abbr":"dyzjswzx","explanation":"骥：良马。路途遥远才可以辨别良马，世间的虚伪狡诈才能鉴别贤才。比喻经过长久的磨练，才能看出人的优劣。","source":{"text":"三国·魏·曹植《矫志》“道远知骥，世伪知贤。”"},"similar":["道远知骥"],"usage":"作宾语、定语、分句；用于书面语"},{"id":44176,"word":"道道地地","pinyin":"dào dào dì dì","abbr":"dddd","explanation":"非常地道。","example":{"text":"这是～的北京货。"},"similar":["地地道道"],"usage":"作谓语、定语；指非常地道"},{"id":44177,"word":"道键禅关","pinyin":"dào jjàn chán guān","abbr":"djcg","explanation":"道：道教；键：观宇，禅佛佛教；关：指寺院。道教的观宇，佛教的寺院。","source":{"text":"二室名游，花时雪夜，三堂胜常，道键禅关。","book":"宋·叶廷珪《海录碎事·人事·游览》"}},{"id":44178,"word":"道长争短","pinyin":"dào cháng zhēng duǎn","abbr":"dczd","explanation":"指评论好坏是非。","source":{"text":"你近来怎么这样瘦，精神也像不好：意志消沉，从前爱闹爱道长争短，现在只是死呆呆不爱说话？","book":"林如稷《将过去》"},"similar":["道长论短"],"usage":"作谓语、宾语；指评论"},{"id":44179,"word":"道长论短","pinyin":"dào cháng lùn duǎn","abbr":"dcld","explanation":"指评论好坏是非。","source":{"text":"车子转动的声音扰成一片，人们在周围道长论短，娃娃们跑来跑去，喊着妈，哄笑着，闹成一片。","book":"丁玲《三日杂记》"},"example":{"text":"他像女人一样爱～。"},"similar":["说长道短"],"opposite":["不予置评"],"usage":"作谓语、宾语；指评论"},{"id":44180,"word":"道骨仙风","pinyin":"dào gǔ xiān fēng","abbr":"dgxf","explanation":"指有得道者及仙人的气质神采。","source":{"text":"道骨仙风，安排顿著，须是人间紫府。","book":"宋·程珌《喜迁莺·寿薛枢密》词"},"example":{"text":"神功大力，有时济困扶危，～，尽可度人出世。","book":"明·冯梦龙《双雄记龙神遣救》"},"similar":["仙风道骨"],"usage":"作宾语、定语；用于人的风采"},{"id":44181,"word":"道高一尺，魔高一丈","pinyin":"dào gāo yī chǐ，mó gāo yī zhàng","abbr":"dgycmgyz","explanation":"原意是宗教家告诫修行的人要警惕外界的诱惑。后比喻取得一定成就以后往往面临新的更大的困难。","source":{"text":"道高一尺魔高丈，性乱情昏错认家。可恨法身无坐位，当时行动念头差。","book":"明·吴承恩《西游记》第五十回"},"example":{"text":"所谓“～”，他，吴荪甫，以及他的同志孙吉人他们，都是企业界身经百战的宿将，难道就怕了什么？","book":"茅盾《子夜》十"},"opposite":["魔高一尺，道高一丈"],"usage":"作宾语、分句；两种可以分开使用"},{"id":44182,"word":"道高德重","pinyin":"dào gāo dé zhòng","abbr":"dgdz","explanation":"道德高尚，很有威信。","source":{"text":"水元伯伯打发人来叫丁永森到他家去坐，丁永森知道定是讲这件不愉快的事情的，但因为水元伯伯是这村里道高德重的人，没法子违反他的命令，就只好硬着头皮去了。","book":"艾芜《回家》"},"similar":["德高望重"],"usage":"作谓语、定语；用于为人"},{"id":44183,"word":"道高望重","pinyin":"dào gāo wàng zhòng","abbr":"dgwz","explanation":"犹言德高望重。","source":{"text":"道高望重之人……一心一德，力行公天下之制，主张大同，联合世界异同之民族，组织全球统一之政府。其所持之政纲，必以道德为本。","book":"郑观应《与青城山人书》"},"similar":["德高望重"],"usage":"作谓语、定语；用于为人"},{"id":44184,"word":"道高益安，势高益危","pinyin":"dào gāo yì ān，shì gāo yì wēi","abbr":"dgyasgyw","explanation":"益：更加；势：权势。道德越高尚，为人处事好，就越安全；权势越大，更容易滥用权力，刚愎自用，就越危险。","source":{"text":"道高易安，势高益危。居赫赫之势，失身且有日矣。","book":"《史记·日者列传》"},"usage":"作宾语、分句；用于劝诫人"},{"id":44185,"word":"道高魔重","pinyin":"dào gāo mó zhòng","abbr":"dgmz","explanation":"形容法力高强。","source":{"text":"道高魔重文驱疟，海涸桑枯路未平。","book":"陶牧《七夕和儆庐仍用征字韵》"},"usage":"作谓语、定语、宾语；用于为人"},{"id":44186,"word":"遗世忘累","pinyin":"yí shì wàng lěi","abbr":"yswl","explanation":"避世隐居而不为世俗之事牵累。","source":{"text":"故或放迹于江海，或养操于山林，求遗世忘累志士而与之游。","book":"明·方孝孺《学士亭记》"},"usage":"作谓语、定语；用于书面语"},{"id":44187,"word":"遗世拔俗","pinyin":"yí shì bá sú","abbr":"ysbs","explanation":"超脱世俗。同“遗世越俗”。","source":{"text":"夫遗世拔俗者，逸民之所操；明道济物者，大贤之宏量也。","book":"明·张居正《与司成马孟河书》"},"similar":["遗世越俗"],"usage":"作谓语、定语；用于书面语"},{"id":44188,"word":"遗世独立","pinyin":"yí shì dú lì","abbr":"ysdl","explanation":"遗世：遗弃世间之事。脱离社会独立生活，不跟任何人往来。","source":{"text":"飘飘乎如遗世独立，羽化而登仙。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"吴门家太仆，示余以《望远图》，乃十四岁女子所作，雾鬓云鬟，薄施水墨，真～矣。","book":"清·杨漱玉《玉台画史·无名氏女子》"},"usage":"作谓语、定语；指不跟任何人往来"},{"id":44189,"word":"遗世绝俗","pinyin":"yí shì jué sú","abbr":"ysjs","explanation":"遗世：遗弃世间之事。脱离社会独立生活，不跟任何人往来。","source":{"text":"飘飘乎如遗世独立，羽化而登仙。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"他赋性既这样～，自然是落落寡合了。","book":"朱自清《白采》"},"similar":["遗世越俗"],"usage":"作谓语、定语；指脱离社会独立生活"},{"id":44190,"word":"遗世越俗","pinyin":"yí shì yuè sú","abbr":"ysys","explanation":"指超脱世俗。","source":{"text":"亦将有才人妙妓，遗世越俗，扬《北里》之流声，绍《阳阿》之妙曲。","book":"三国·魏·曹植《七启》"},"similar":["遗世拔俗"],"usage":"作谓语、定语；用于书面语"},{"id":44191,"word":"遗休余烈","pinyin":"yí xiū yú liè","abbr":"yxyl","explanation":"比喻前人留下的盛德美名和功烈业绩。同“遗芳余烈”。","source":{"text":"洪惟有宋，受命造邦，百年四圣，而小子获承之，以继我仁考之遗休余烈。","book":"宋·欧阳修《尊皇太后册文》"},"similar":["遗德余烈","遗恩余烈","遗德休烈"],"usage":"作宾语、定语；用于书面语"},{"id":44192,"word":"遗俗流风","pinyin":"yí sú liú fēng","abbr":"yslf","explanation":"前代流传给后世的风雅韵事。","source":{"text":"武丁朝诸侯有天下，犹运之掌也。纣之去武丁，未久也。其故家遗俗流风善政，犹有存者。","book":"《孟子·公孙丑上》"}},{"id":44193,"word":"遗俗绝尘","pinyin":"yí sú jué chén","abbr":"ysjc","explanation":"指超脱尘俗而避世隐居。","source":{"text":"其后苏文忠谪居海外，流离患难之际，深惩世网慨然有遗俗绝尘之志。","book":"清·戴名世《和陶诗》序"},"usage":"作谓语、定语；用于书面语"},{"id":44194,"word":"遗华反质","pinyin":"yí huá fǎn zhì","abbr":"yhfz","explanation":"指舍弃浮华而返归朴质。","source":{"text":"华谓采章，质谓淳朴也。遗，弃也。","book":"《文选·陆云〈大将军宴会被命做诗〉》：“颓纲既振，品物咸秩。神道见素，遗华反质。”李善注"},"usage":"作宾语、定语；用于书面语"},{"id":44195,"word":"遗名去利","pinyin":"yí míng qù lì","abbr":"ymql","explanation":"指丢弃名位和利益。","source":{"text":"但学者不能窒欲攘贪，遗名去利。","book":"唐·卢肇《宜州新兴寺碑铭》"},"opposite":["争权夺利"],"usage":"作谓语、定语；用于处事"},{"id":44196,"word":"遗哂大方","pinyin":"yí shěn dà fāng","abbr":"ysdf","explanation":"指让内行见笑。同“遗笑大方”。","source":{"text":"杜先生笑道：‘恐拙句遗哂大方。’","book":"《鼓掌绝尘》第二回"},"similar":["遗笑大方"],"usage":"作谓语、定语；用于书面语"},{"id":44197,"word":"遗声余价","pinyin":"yí shēng yú jià","abbr":"ysyj","explanation":"指前人死后在社会上流传的声誉和评价。","source":{"text":"神灭形消，遗声余价，亦犹蝉壳蛇皮、兽迒鸟迹耳，何预于死者，而圣人以为名教乎？","book":"北齐·颜之推《颜氏家训·名实》"},"usage":"作宾语、定语；用于书面语"},{"id":44198,"word":"遗声坠绪","pinyin":"yí shēng zhuì xù","abbr":"yszx","explanation":"指行将绝灭的诗歌创作传统。","source":{"text":"我朝唯纳兰公子，深入北宋唐奥。遗声坠绪，二百年后，乃为足下拾得，是何神术，钦佩钦佩！","book":"况周颐《蕙风词话续编》卷一"},"usage":"作宾语、定语；用于书面语"},{"id":44199,"word":"遗大投艰","pinyin":"yí dà tóu jiān","abbr":"ydtj","explanation":"遗、投：交给。指交给重大艰难的任务。","source":{"text":"予造天役，遗大投艰于朕身。","book":"《尚书·大浩》"},"example":{"text":"他要游历国内外考察风土人情，他要锻炼～的气魄。","book":"茅盾《创造》二"},"similar":["遗艰投大"],"usage":"作谓语、定语；指给予重担"},{"id":44200,"word":"遗孽余烈","pinyin":"yí niè yú liè","abbr":"ynyl","explanation":"指遗留下来的残余势力。","source":{"text":"高帝（汉高祖）之世，反者九起，其遗孽余烈，至于文景，而为淮南、济北、吴、楚之乱。","book":"宋·苏辙《唐论》"},"usage":"作宾语、定语；用于书面语"},{"id":44201,"word":"遗害无穷","pinyin":"yí hài wú qióng","abbr":"yhwq","explanation":"留下无穷的祸患。","source":{"text":"可见为人切忌不可取那娼妇，不止丧了家私，还要污了名节，遗害无穷。","book":"清·西周生《醒世姻缘传》第51回"},"example":{"text":"用这种导演的办法抓生产最容易，最省力，但～。","book":"蒋子龙《乔厂长上任记》"},"similar":["遗祸无穷"],"usage":"作谓语、定语；指留下祸根"},{"id":44202,"word":"遗寝载怀","pinyin":"yí qǐn zài huái","abbr":"yqzh","explanation":"指心有所念而寝不安席。","source":{"text":"且犹郡邑公选，岩穴敷求，遗寝载怀，比岁临问，伫经术以佐职，相艺能以建官，则古之坐明堂，议衢室，安可以俦清问之深也。","book":"唐·李元成《应贤良方正科对策》"},"usage":"作谓语、定语；用于书面语"},{"id":44203,"word":"遗形去貌","pinyin":"yí xíng qù mào","abbr":"yxqm","explanation":"指舍弃一切外在形式。","source":{"text":"然一相识，而遂遗形去貌，又非浅浅者可同年轮也。","book":"明·袁宏道《与陶孝若书》"},"opposite":["以貌取人"],"usage":"作谓语、定语；用于处事"},{"id":44204,"word":"遗形忘性","pinyin":"yí xíng wàng xìng","abbr":"yxwx","explanation":"超脱形骸，舍弃心性，进入忘我的精神境界。同“遗形藏志”。","source":{"text":"返朴还淳皆至理，遗形忘性尽真铨。","book":"前蜀·杜光庭逸句"},"similar":["遗形藏志"],"usage":"作谓语、定语；用于书面语"},{"id":44205,"word":"遗形藏志","pinyin":"yí xíng cáng zhì","abbr":"yxcz","explanation":"超脱形骸，舍弃心性，进入忘我的精神境界。","source":{"text":"遗形藏志，与道相得。","book":"汉·严遵《道德指归论·上德不德》"},"similar":["遗形忘性"],"usage":"作谓语、定语；用于书面语"},{"id":44206,"word":"遗德休烈","pinyin":"yí dé xiū liè","abbr":"ydxl","explanation":"指先人留下的德泽和功业。同“遗德余烈”。","source":{"text":"朕蒙遗德休烈，既已布泽四海之遐，矧定策禁中，以安社稷，褒功赋爵，庸敢后乎！","book":"宋·王珪《赐韩琦免恩命第二表不允断来章批答》"},"similar":["遗德余烈","遗恩余烈","遗休余烈"],"usage":"作宾语、定语；用于书面语"},{"id":44207,"word":"遗德余烈","pinyin":"yí dé yú liè","abbr":"ydyl","explanation":"指先人留下的德泽和功业。","source":{"text":"伏以仁宗皇帝遗德余烈，蒙被天下，施之无穷。","book":"宋·王珪《天地太庙七室皇后庙奉慈庙奏告仁宗皇帝谥号祝文》"},"similar":["遗德休烈","遗恩余烈","遗休余烈"],"usage":"作宾语、定语；用于书面语"},{"id":44208,"word":"遗恨千古","pinyin":"yí hèn qiān gǔ","abbr":"yhqg","explanation":"千古：时间久远。遗留的怨恨永远存在下去。","source":{"text":"且生与女相爱怜若此，而卒不相遇，真堪遗恨千古。","book":"清·徐瑶《太恨生传》"},"similar":["生离死别"],"opposite":["遗臭万年"],"usage":"作谓语、定语、宾语；指失误等"},{"id":44209,"word":"遗恨终天","pinyin":"yí hèn zhōng tiān","abbr":"yhzt","explanation":"指终身感到悔恨。","source":{"text":"则我之身虽死犹幸，他日殉节，庶有名目。但恐辱抹爹娘，害他涉险，计不出此，遗恨终天矣！","book":"佩蘅子《吴江雪》第十六回"},"example":{"text":"洪仁玕后来谈到这～的事件时指出，‘安庆一失，沿途至天京之城相继陷落不可复守矣。’","book":"《历史研究》1976年第6期"},"similar":["遗恨千古"],"usage":"作谓语、定语；用于处事"},{"id":44210,"word":"遗恩余烈","pinyin":"yí ēn yú liè","abbr":"yeyl","explanation":"前人遗留下的恩德功业。","source":{"text":"观更始之际，刘氏之遗恩余烈，英雄岂能抗之哉！","book":"《后汉书·王昌刘永传论》"},"similar":["遗德余烈","遗德休烈","遗休余烈"],"usage":"作宾语、定语；用于书面语"},{"id":44211,"word":"遗患无穷","pinyin":"yí huàn wú qióng","abbr":"yhwq","explanation":"留下无穷的祸患。","source":{"text":"炉鼎铅汞，皆是寓言，非言炼烧。方士转向附会，遂贻害无穷。","book":"汉·魏伯阳《参同契》"},"example":{"text":"说什么修筑减水坝不合古训，且耗费国库的银两，～等等，旁边还有康熙的朱笔御批。","book":"二月河《康熙大帝》二十二"},"similar":["贻患无穷","贻害无穷"],"usage":"作谓语、定语；用于劝诫人"},{"id":44212,"word":"遗惠余泽","pinyin":"yí huì yú zé","abbr":"yhyz","explanation":"前人留下的恩惠德泽。","source":{"text":"前乙巳赦书，远称先帝遗惠余泽，普增位一等，以酬四海欣戴之心。","book":"《晋书·挚虞传》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":44213,"word":"遗文轶事","pinyin":"yí wén yì shì","abbr":"ywys","explanation":"遗文：前人留下的诗文，多指未曾收入作者文集的文章；轶事：淬在民间而未见官方记载的事迹。指未见记载的文献资料。","source":{"text":"搜集先世遗文轶事，纤悉无遗。","book":"宋·朱熹《监潭州南岳庙刘君墓志铭》"},"similar":["遗闻琐事","遗闻逸事","遗闻轶事"],"usage":"作宾语、定语；用于书面语"},{"id":44214,"word":"遗文逸句","pinyin":"yí wén yì jù","abbr":"ywyj","explanation":"指散佚的文章和句子。","source":{"text":"虽千古茫昧，理世玄远，遗文逸句，容或可寻，沿途隐显，方土可验。","book":"北魏·郦道元《水经注·河水五》"},"usage":"作宾语、定语；用于书面语"},{"id":44215,"word":"遗物忘形","pinyin":"yí wù wàng xíng","abbr":"ywwx","explanation":"泯灭物我界限，指舍弃外在形式，精神进入忘我境界。","source":{"text":"目无外视，耳无外听，遗物忘形，在我而已。","book":"宋·秦观《心说》"},"usage":"作谓语、定语；用于书面语"},{"id":44216,"word":"遗物识心","pinyin":"yí wù shí xīn","abbr":"ywsx","explanation":"指舍弃一切外在形式而彼此心意一致。","source":{"text":"出自幽谷，及尔同林。双情交映，遗物识心。","book":"晋·陆机《赠冯文罴迁丘令》"},"usage":"作宾语、定语；用于书面语"},{"id":44217,"word":"遗珠弃璧","pinyin":"yí zhū qì bì","abbr":"yzqb","explanation":"本指弃置不用的珍珠玉璧，比喻弃置不用的美好事物和优秀人才。","source":{"text":"然裘父得意可传之作，盖不止此，遗珠弃璧，识者兴叹。","book":"宋·陆游《〈曾裘父诗集〉序》"},"example":{"text":"胡先骕《诗别萧叔綗燕京》：“碔砆鱼目征上选，～空晶莹。”"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":44218,"word":"遗珥坠簪","pinyin":"yí ěr zhuì zān","abbr":"yezz","explanation":"形容欢饮而不拘形迹。同“遗簪堕珥”。","source":{"text":"朱论，碾破芳堤，遗珥坠簪，落花相衬。","book":"清·洪昇《长生殿·禊游》"},"similar":["遗珥堕簪","遗簪堕珥"],"usage":"作宾语、定语；用于书面语"},{"id":44219,"word":"遗珥堕簪","pinyin":"yí ěr duò zān","abbr":"yedz","explanation":"形容欢饮而不拘形迹。同“遗簪堕珥”。","source":{"text":"清晓，侍婢不惜千金，相呼斗百草。遗珥堕簪，蹙着秋千，不禁笑语声高。","book":"宋·无名氏《张协状元》戏文第十七出"},"similar":["遗珥坠簪","遗簪堕珥"],"usage":"作宾语、定语；用于书面语"},{"id":44220,"word":"遗祸无穷","pinyin":"yí huò wú qióng","abbr":"yhwq","explanation":"指留下祸害没有穷尽。","source":{"text":"已而子婿兄弟表里祖述，遗祸无穷。","book":"宋·张元幹《跋〈了堂先生文集〉》"},"example":{"text":"除匪不尽，～。","book":"曲波《林海雪原》三"},"similar":["遗害无穷"],"usage":"作谓语、定语；指留下祸根"},{"id":44221,"word":"遗笑大方","pinyin":"yí xiào dà fāng","abbr":"yxdf","explanation":"指让内行见笑。","source":{"text":"晚生小子，怎敢在老先生面前放肆。况才非七步，未免一时遗笑大方。","book":"语出《庄子·秋水》：“吾长见笑于大方之家。”明·荻岸散人《玉娇梨》第八回"},"example":{"text":"女子有才一样处理国事，军师少见多怪，岂不～。","book":"桂剧《梁红玉》第九场"},"similar":["贻笑大方","遗哂大方"],"usage":"作谓语、宾语、定语；用于自谦"},{"id":44222,"word":"遗篇坠款","pinyin":"yí piān zhuì kuǎn","abbr":"ypzk","explanation":"指散佚的诗文篇章和书画款识。","source":{"text":"前代遗篇坠款，因得概见于方册间，此尤可贵也。","book":"宋·张淏《云谷杂记·藏金石刻》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":44223,"word":"遗篇断简","pinyin":"yí piān duàn jiǎn","abbr":"ypdj","explanation":"指散佚而残缺不全的典籍。同“遗编断简”。","source":{"text":"而苟其学之不足传，与传之不得其人，虽当时为诸儒所宗，而遗篇断简不可见于后世者，往往有之。","book":"清·梅曾亮《陈硕士〈学士授经图〉记》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":44224,"word":"遗簪坠履","pinyin":"yí zān zhuì lǚ","abbr":"yzzl","explanation":"比喻旧物或故情。同“遗簪坠屦”。","source":{"text":"昔人不弃遗簪坠屦者，恶与之同出，不与同归。吾之操行，虽不逮前烈，然舍旧录新，亦非吾志也。","book":"《北史·韦夐传》"},"similar":["遗簪弊履","遗簪堕履","遗簪坠屦"],"usage":"作宾语、定语；比喻旧物或故情"},{"id":44225,"word":"遗簪坠屦","pinyin":"yí zān zhuì jù","abbr":"yzzj","explanation":"遗：遗失；坠：掉落；屦：鞋子。掉落的簪和鞋子，比喻旧物。后指不忘旧友叫“不弃遗簪坠屦”。","source":{"text":"昔人不弃遗簪坠屦者，恶与之同出，不与同归。吾之操行虽有不逮前烈，然舍旧录新，亦非吾志也。","book":"《北史·韦夐传》"},"similar":["遗簪坠履","遗簪弊屦","遗簪堕屦"],"usage":"作宾语、定语；比喻旧物或故情","story":["南北朝时期，孝宽担任延州总管。韦瓊到延州去拜访他，回去时，孝宽把他的马及辔勒要送给韦瓊。韦瓊笑着说：“昔人不弃遗簪坠屦者，恶与之同出，不与同归。吾之操行，虽有不逮前烈，然舍旧录新，亦非吾志也。”坚决不受"]},{"id":44226,"word":"遗簪坠珥","pinyin":"yí zān zhuì ěr","abbr":"yzze","explanation":"指遗落、丢弃簪子珥珰。亦指遗弃的簪珥。","source":{"text":"盈盈，斗草踏青。人艳冶、递逢迎。向路傍往往，遗簪坠珥，珠翠纵横。","book":"宋·柳永《木兰花》词"}},{"id":44227,"word":"遗簪坠舄","pinyin":"yí zān zhuì xì","abbr":"yzzx","explanation":"指遗落在地的簪子鞋子。"},{"id":44228,"word":"遗簪堕履","pinyin":"yí zān duò lǚ","abbr":"yzdl","explanation":"比喻旧物或故情。同“遗簪坠屦”。","source":{"text":"遗簪堕履应留念，门客如今只下僚。","book":"唐·张说《让右丞相第二表》：“臣幸沐遗簪堕履之恩，好生养志之德。”唐·罗隐《得宣州窦尚书书因投寄》诗之二"},"similar":["遗簪弊屦","遗簪堕屦","遗簪坠屦"],"usage":"作宾语、定语；比喻旧物或故情"},{"id":44229,"word":"遗簪堕屦","pinyin":"yí zān duò jù","abbr":"yzdj","explanation":"遗：遗失；堕：掉落；屦：鞋子。掉落的簪和鞋子，比喻旧物。比喻能勾起人们怀旧之情的故物。","source":{"text":"昔人不弃遗簪坠屦者，恶与之同出，不与同归。吾之操行虽有不逮前烈，然舍旧录新，亦非吾志也。","book":"《北史·韦夐传》"},"similar":["遗簪弊屦","遗簪坠屦","遗簪弊履"],"usage":"作宾语、定语；比喻旧物或故情"},{"id":44230,"word":"遗簪堕珥","pinyin":"yí zān duò ěr","abbr":"yzde","explanation":"形容欢饮而不拘形迹。","source":{"text":"危弦促柱奏《巴渝》，遗簪堕珥解罗繻。","book":"《史记·滑稽列传》：“若乃州闾之会，男女杂坐，行酒稽留，六博投壶，相引为曹，握手无罚，目眙不禁，前有堕珥，后有遗簪，髡窃乐此，饮可八斗而醉二参。”唐·虞世南《门有车马客行》"},"example":{"text":"感谢女之思，～，鬯豪士之怀，吐锦绝缨。","book":"明·胡之骥《〈汇注江文通集〉叙》"},"similar":["遗珥堕簪","遗珥坠簪"],"usage":"作宾语、定语；用于书面语"},{"id":44231,"word":"遗簪弃舄","pinyin":"yí zān qì xì","abbr":"yzqx","explanation":"指遗落在地的簪子鞋子。同“遗簪坠舄”。"},{"id":44232,"word":"遗簪弊履","pinyin":"yí zān bì lǚ","abbr":"yzbl","explanation":"比喻旧物或故情。同“遗簪坠屦”。","source":{"text":"帝曰：‘古人念遗簪弊履，欲与六宫别，可乎？’","book":"《魏书·孝静帝纪》"},"similar":["遗簪坠屦","遗簪堕屦","遗簪弊屦"],"usage":"作宾语、定语；比喻旧物或故情"},{"id":44233,"word":"遗簪弊屦","pinyin":"yí zān bì jù","abbr":"yzbj","explanation":"比喻旧物或故情。同“遗簪坠屦”。","source":{"text":"魏静帝曰：‘人念遗簪弊屦，欲与六宫别，可乎？’乃人与夫人宾御以下诀别，莫不嘘欷掩涕。","book":"《北齐书·高德政传》"},"similar":["遗簪弊履","遗簪坠屦","遗簪堕屦"],"usage":"作宾语、定语；比喻旧物或故情"},{"id":44234,"word":"遗簪绝缨","pinyin":"yí zān jué yīng","abbr":"yzjy","explanation":"指男女杂坐，不拘形迹，欢饮无度。","source":{"text":"《史记·滑稽列传》：“若乃州闾之会，男女杂坐，行酒稽留，六博投壶，相引为曹，握手无罚，目眙不禁，前有堕珥，后有遗簪，髡（淳于髡）窃乐此，饮可八斗而醉二参。”另见《韩诗外传》卷七，王后所绝缨之事。后合二事为“遗簪绝缨”。"},"example":{"text":"两家父母亦共饮酒三五斗，以后～，欢谑无度，数日方止。","book":"徐珂《清稗类钞·婚姻·台湾番人婚嫁》"},"usage":"作宾语、定语；用于书面语","story":["楚庄王赐群臣酒宴，喝到天黑，大家均有醉意。风吹灭了蜡烛，有人趁机牵王后的衣服，王后立即把该人的帽缨摘下对庄王说要抓住那个非礼的人。庄王不许，就说：“今天参加聚会的人一律不得戴帽缨。”于是人们纷纷把帽缨扔掉，君臣尽欢而散"]},{"id":44235,"word":"遗簪脱舄","pinyin":"yí zān tuō xì","abbr":"yztx","explanation":"形容欢饮而不拘形迹。","source":{"text":"假敬神为名，列食欢呼，遗簪脱舄，虽云男女分曹，究属面面相觑。","book":"清·钱学纶《语新》卷上"},"similar":["遗簪堕珥"],"usage":"作宾语、定语；用于书面语"},{"id":44236,"word":"遗簪败履","pinyin":"yí zān bài lǚ","abbr":"yzbl","explanation":"遗：遗失；履：鞋子。掉落的簪和鞋子，比喻旧物。比喻能勾起人们怀旧之情的故物。","source":{"text":"昔人不弃遗簪坠屦者，恶与之同出，不与同归。吾之操行虽有不逮前烈，然舍旧录新，亦非吾志也。","book":"《北史·韦夐传》"}},{"id":44237,"word":"遗编坠简","pinyin":"yí biān zhuì jiǎn","abbr":"ybzj","explanation":"指散佚而残缺不全的典籍。同“遗编断简”。","source":{"text":"遗编坠简文章烂，粝食粗衣岁月长。","book":"金·元好问《入济源寓舍》诗"},"similar":["遗编绝简","遗编断简"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44238,"word":"遗编断简","pinyin":"yí biān duàn jiǎn","abbr":"ybdj","explanation":"指散佚而残缺不全的典籍。","source":{"text":"虽遗编断简，仅存二三，然世移俗革，人亡书残，不复想见先王之绪余。","book":"宋·吕大临《〈考古图〉后记》"},"similar":["遗编绝简","遗编坠简"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44239,"word":"遗编绝简","pinyin":"yí biān jué jiǎn","abbr":"ybjj","explanation":"指散佚而残缺不全的典籍。","source":{"text":"遗编绝简，往往遇之，豁然心胸，略无疑滞。","book":"唐·怀素《自叙》"},"similar":["遗编断简","遗编坠简"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44240,"word":"遗老孤臣","pinyin":"yí lǎo gū chén","abbr":"ylgc","explanation":"指改朝换代后已经失势而仍效忠前朝的老臣。","source":{"text":"昔者改姓易代，兴亡倏忽，一二遗老孤臣，不忍见宗社之倾，君父之辱，犹或黄冠草履，歌哭空山，乱礁穷岛，相望饮泣。","book":"李大钊《警告全国父老书》"},"similar":["孤臣遗老"],"usage":"作宾语、定语；用于书面语"},{"id":44241,"word":"遗老遗少","pinyin":"yí lǎo yí shào","abbr":"ylys","explanation":"遗老：旧称前朝的旧臣；遗少：留恋旧时代的少年。改朝换代后仍效忠前朝的老人和青年。也泛指留恋过去、思想顽固陈旧的人。","source":{"text":"在正面，就是遗老遗少们所戴瓜皮小帽的缀一粒珠子或一块宝石的地方，直写着四个字道：‘一见有喜’。","book":"鲁迅《无常》"},"example":{"text":"这些～的作用是微不足道的。"},"usage":"作宾语、定语；指旧臣等"},{"id":44242,"word":"遗臊撒粪","pinyin":"yí sāo sǎ fèn","abbr":"yssf","explanation":"比喻坏名声到处流传。","source":{"text":"干发虚，没钞分，遗臊撒粪。","book":"清·孔尚任《桃花扇·拒媒》"}},{"id":44243,"word":"遗臭万世","pinyin":"yí chòu wàn shì","abbr":"ycws","explanation":"死后恶名流传，永远受人唾骂。同“遗臭万载”。","source":{"text":"公不丧心病狂，奈何一旦为此，若不早改图，必且遗臭万世。","book":"宋·谢采伯《密斋笔记》卷一"},"example":{"text":"惟恐趋承之恐后，岂知其～乎？","book":"明·谢肇淛《五杂俎·事部三》"},"similar":["遗臭千秋","遗臭万代","遗臭万载"],"opposite":["流芳百世"],"usage":"作谓语、定语、宾语；用于坏人"},{"id":44244,"word":"遗臭万代","pinyin":"yí chòu wàn dài","abbr":"ycwd","explanation":"死后恶名流传，永远受人唾骂。同“遗臭万载”。","source":{"text":"母妻屠戮，种族无留，悬首燃脐，遗臭万代。","book":"唐·高適《后汉贼臣董卓庙议》"},"similar":["遗臭万世","遗臭万年","遗臭千年"],"opposite":["流芳百世"],"usage":"作谓语、定语、宾语；用于坏人"},{"id":44245,"word":"遗臭万年","pinyin":"yí chòu wàn nián","abbr":"ycwn","explanation":"遗臭：死后留下的恶名。死后恶名一直流传，永远被人唾骂。","source":{"text":"既不能流芳百世，不足复遗臭万载耶？","book":"《晋书·桓温传》"},"example":{"text":"卖国投敌的小丑们，没有一个不是～的。"},"similar":["声名狼藉","人所不齿","臭名昭著"],"opposite":["万古流芳","永垂不朽","名垂青史"],"usage":"作谓语、定语、宾语；用于坏人","story":["东晋时期，大司马桓温专揽朝政，他南征北战，立下不少战功。他位高权重，野心萌发，一次躺在床上说：“人生在世不能默默无闻。”亲信们不敢吭声，他从床上坐起接着说：“一个人即使不能流芳百世，那么就该遗臭万年。”"]},{"id":44246,"word":"遗臭万载","pinyin":"yí chòu wàn zǎi","abbr":"ycwz","explanation":"死后恶名流传，永远受人唾骂。","source":{"text":"［桓温］既而抚枕起曰：既不能流芳后世，亦不足复遗臭万载邪！","book":"南朝·宋·刘义庆《世说新语·尤悔》"},"similar":["遗臭万年","遗臭万世","遗臭无穷"],"opposite":["流芳百世"],"usage":"作谓语、定语、宾语；用于坏人"},{"id":44247,"word":"遗臭千代","pinyin":"yí chòu qiān dài","abbr":"ycqd","explanation":"遗臭：死后留下的恶名。死后恶名一直流传，永远被人唾骂。","source":{"text":"既不能流芳后世，亦不足复遗臭万载耶！","book":"南朝·宋·刘义庆《世说新语·尤悔》"}},{"id":44248,"word":"遗臭千年","pinyin":"yí chòu qiān nián","abbr":"ycqn","explanation":"死后恶名流传，永远受人唾骂。同“遗臭万载”。","source":{"text":"岂不闻李氏断臂，清风满耳如生；文君（卓文君）夜奔，遗臭千年未泯。","book":"明·邵璨《香囊记·强婚》"},"example":{"text":"盗贼全其名，自刎黄泉下。堪嗟降虏人，～骂。","book":"明·方汝浩《禅真逸史》第十七回"},"similar":["遗臭万年","遗臭万载","遗臭万代"],"usage":"作谓语、定语、宾语；用于坏人"},{"id":44249,"word":"遗臭千秋","pinyin":"yí chòu qiān qiū","abbr":"ycqq","explanation":"死后恶名流传，永远受人唾骂。同“遗臭万载”。","source":{"text":"姑念放麑，使御魍魉之鬼，拥戴称颂，悬金石不刊之书，令其遗臭千秋。","book":"清·侯方域《拟思宗改元廷臣谢表》"},"similar":["遗臭万年","遗臭万载","遗臭万代"],"opposite":["流芳百世"],"usage":"作谓语、定语、宾语；用于坏人"},{"id":44250,"word":"遗臭无穷","pinyin":"yí chòu wú qióng","abbr":"ycwq","explanation":"指坏名声永远流传下去，而无穷尽之日。","source":{"text":"燃脐易尽嗟何及，遗臭无穷古未闻。","book":"金·元好问《即事》诗"},"similar":["遗臭万载","遗臭万世","遗臭万年"],"opposite":["流芳百世"],"usage":"作谓语、定语、宾语；用于坏人"},{"id":44251,"word":"遗艰投大","pinyin":"yí jiān tóu dà","abbr":"yjtd","explanation":"指交给重大艰难的任务。同“遗大投艰”。","source":{"text":"人不深责之官，变之于遗艰投大、人所属心之日乎？","book":"明·海瑞《赠廖锦台膺首荐序》"},"similar":["遗大投艰"],"usage":"作谓语、定语；指给予重担"},{"id":44252,"word":"遗芬余荣","pinyin":"yí fēn yú róng","abbr":"yfyr","explanation":"比喻前人留下的盛德美名和功烈业绩。","source":{"text":"爰洎姬汉，风流尚存，遗芬余荣，绵映纪纬。","book":"《宋书·礼志三》"},"usage":"作宾语、定语；用于书面语"},{"id":44253,"word":"遗芬剩馥","pinyin":"yí fēn shèng fù","abbr":"yfsf","explanation":"比喻前人留下的精美文章。","source":{"text":"而诗书图史，遗芬剩馥，在其子孙者，其来未艾，谓非少保公之贤而至然哉！","book":"明·李东阳《跋〈聚芳亭卷〉》"},"usage":"作宾语、定语；用于书面语"},{"id":44254,"word":"遗芳余烈","pinyin":"yí fāng yú liè","abbr":"yfyl","explanation":"比喻前人留下的盛德美名和功烈业绩。","source":{"text":"遗芳余烈，奋乎百世。","book":"南朝·宋·傅亮《为宋公修楚元王墓教》"},"example":{"text":"学古训以道积阙躬，招俊乂以列庶位，对扬天子之命，亦足袭说～，报陛下矣。","book":"元·姚燧《李平章画像序》"},"similar":["遗风余烈"],"usage":"作宾语、定语；用于书面语"},{"id":44255,"word":"遗落世事","pinyin":"yí luò shì shì","abbr":"ylss","explanation":"指遗忘弃置世俗之事。","source":{"text":"籍闻步兵厨营人善酿，有贮酒三百斛，乃求为步兵校尉。遗落世事，虽去佐职，恒游府内，朝宴必与焉。","book":"《晋书·阮籍传》"},"example":{"text":"顷观《松林文献》，称其～，晨夕一编，行不识路，坐不知寒暑。","book":"清·陈康祺《郎潜纪闻》卷九"},"usage":"作谓语、定语；用于书面语"},{"id":44256,"word":"遗训余风","pinyin":"yí xùn yú fēng","abbr":"yxyf","explanation":"前代遗留下来的风尚教化。","source":{"text":"圣人立法垂制，所以必称先王，盖由遗训余风，足以贻之来世也。","book":"《宋书·明帝纪论》"},"usage":"作宾语、定语；用于书面语"},{"id":44257,"word":"遗训可秉","pinyin":"yí xùn kě bǐng","abbr":"yxkb","explanation":"秉：秉承，领受。前人留下来的训告可以继承。","source":{"text":"虽混成以无迹，实遗训之可秉。","book":"南朝·梁·沈约《郊居赋》"}},{"id":44258,"word":"遗迹谈虚","pinyin":"yí jì tán xū","abbr":"yjtx","explanation":"指舍弃根据而空谈玄虚。","source":{"text":"然有退之（韩愈）之学则可，无退之之学而遗迹谈虚，恐援据所及，金根金银或相贸易，并可赧矣。","book":"宋·程大昌《〈演繁露〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":44259,"word":"遗钿坠舄","pinyin":"yí diàn zhuì xì","abbr":"ydzx","explanation":"钿：有金翠珠宝等制成的首饰，舄：鞋子。形容女子在游玩、交际时纵情欢乐的景象。","source":{"text":"玄宗每年十月幸华清宫，国忠姊妹五家扈从，每家为一队，著一色衣，五家合队，照映如百花之焕发，而遗钿坠舄，瑟瑟珠翠，灿烂芳馥于路。","book":"《旧唐书·后妃传·杨贵妃》"}},{"id":44260,"word":"遗闻琐事","pinyin":"yí wén suǒ shì","abbr":"ywss","explanation":"指前代或前人遗留下来而少为人知的传闻，多指不见于正式记载的。同“遗闻逸事”。","source":{"text":"本以存昔日之遗闻琐事，以附于稗官野史，使避世者亦可考见世事而已。","book":"蠡勺居士《〈昕夕闲谈〉小序》"},"similar":["遗闻逸事","遗文轶事"],"usage":"作宾语、定语；用于书面语"},{"id":44261,"word":"遗闻轶事","pinyin":"yí wén yì shì","abbr":"ywys","explanation":"散失，遗留下来的事迹。","source":{"text":"此十卷之本，乃从毛氏汲古阁之版传抄。首尾完其，其间遗闻轶事，皆可备考稽。","book":"宋·周密《武林旧事》"},"example":{"text":"章炳麟《訄书·哀焚书》：“其他～，皆前代俌臣所录。”"},"similar":["遗闻逸事"],"usage":"作宾语；指史书未记载的事"},{"id":44262,"word":"遗闻逸事","pinyin":"yí wén yì shì","abbr":"ywys","explanation":"指前代或前人遗留下来而少为人知的传闻，多指不见于正式记载的。","source":{"text":"然而只有这一本，虽然浅薄，却还借此存留一点遗闻逸事。","book":"鲁迅《南腔北调集·题记》"},"example":{"text":"齐老先生（齐白石）的～也常听人说起，可是都没有新凤霞写的那么真。","book":"《大地》1981年第3期"},"similar":["遗文轶事","遗闻琐事","遗闻逸事"],"usage":"作宾语、定语；用于书面语"},{"id":44263,"word":"遗音余韵","pinyin":"yí yīn yú yùn","abbr":"yyyy","explanation":"前人作品的余音和韵致。形容作品美妙。","source":{"text":"则又见其遗音余韵，得之于笔墨外也。","book":"《宣和书谱·皇象》"},"usage":"作宾语、定语；用于书面语"},{"id":44264,"word":"遗风余习","pinyin":"yí fēng yú xí","abbr":"yfyx","explanation":"前代遗留下来的风俗。同“遗风余俗”。","source":{"text":"学家相传，四世不坠，盛哉，遂与王谢家遗风余习相季孟也。","book":"《宣和书谱·卫恒》"},"similar":["遗风余俗","遗风旧俗"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44265,"word":"遗风余俗","pinyin":"yí fēng yú sú","abbr":"yfys","explanation":"前代遗留下来的风俗。","source":{"text":"曩之为秦者，今转而为汉矣，然其遗风余俗，犹尚未改。","book":"汉·贾谊《治安策》"},"similar":["遗风旧俗","遗风余习"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44266,"word":"遗风余思","pinyin":"yí fēng yú sī","abbr":"yfys","explanation":"前代遗留下来的风尚情思。","source":{"text":"绛即东雍，为守理所，禀参实沉分，气蓄两河润，有陶唐冀遗风余思。","book":"唐·樊宗师《绛守居园池记》"},"example":{"text":"夫人之有一能，而使后人尚之如此，况仁人庄士之～，被于来世者如何哉！","book":"宋·曾巩《墨池记》"},"usage":"作宾语、定语；用于书面语"},{"id":44267,"word":"遗风余教","pinyin":"yí fēng yú jiào","abbr":"yfyj","explanation":"前代遗留下来的风尚教化。","source":{"text":"京口常为江南必争之地，其人以智诈勇力擅名于时，而古人遗风余教无闻焉，何也？","book":"宋·叶適《金坛县重建学记》"},"usage":"作宾语、定语；用于书面语"},{"id":44268,"word":"遗风余泽","pinyin":"yí fēng yú zé","abbr":"yfyz","explanation":"前人遗留下来的风教和德泽。","source":{"text":"此其遗风余泽，沾馥后人者特非一日。","book":"《宣和书谱·张彦远》"},"similar":["遗风遗泽"],"usage":"作宾语、定语；用于书面语"},{"id":44269,"word":"遗风余烈","pinyin":"yí fēng yú liè","abbr":"yfyl","explanation":"前人留传的风教和业迹。","source":{"text":"如或当身之政，遗风余烈不及后嗣。","book":"《汉书·礼乐志》：“夫乐本情性，浃肌肤而臧骨髓，虽经乎千载，其遗风余烈尚犹不绝。”《晋书·刘颂传》"},"example":{"text":"尝试与子登孤山而望吴越，歌山中之乐而饮此水，则公之～，亦或见於斯泉也。","book":"宋·苏轼《六一泉铭》"},"similar":["遗芳余烈"],"usage":"作宾语、定语；用于书面语"},{"id":44270,"word":"遗风余象","pinyin":"yí fēng yú xiàng","abbr":"yfyx","explanation":"前代遗留下来的风俗和法式。","source":{"text":"古者壶矢之制，揖让之容，今虽阙焉，然其遗风余象犹仿佛也。","book":"宋·司马光《投壶新格》"},"usage":"作宾语、定语；用于书面语"},{"id":44271,"word":"遗风余采","pinyin":"yí fēng yú cǎi","abbr":"yfyc","explanation":"前代遗留下来的风度文采。","source":{"text":"应对固无方，篇章亦不匮，遗风余采，莫与比盛。","book":"南朝·梁·刘勰《文心雕龙·时序》"},"usage":"作宾语、定语；用于书面语"},{"id":44272,"word":"遗风余韵","pinyin":"yí fēng yú yùn","abbr":"yfyy","explanation":"前人遗留下来的风教和韵致。","source":{"text":"此古之君子，所以成尊主庇民之功于一时，而其遗风余韵，犹有称思于后世者也。","book":"《朱子全书·治道一》"},"example":{"text":"在过去齐国、鲁国的都城，和一些戴着高高的帽子，宽大的衣袖的学者们，商讨学问，反复辩论，观察孔子的～。","book":"吴晗《学习集·伟大的历史学家司马迁》"},"usage":"作宾语、定语；用于书面语"},{"id":44273,"word":"遗风古道","pinyin":"yí fēng gǔ dào","abbr":"yfgd","explanation":"前代留传下来的淳厚古朴的风尚。","source":{"text":"水田茆屋莫愁村，别有遗风古道存。","book":"清·元祚《从安节宓草昆仲乞写鹤舟图》诗"},"usage":"作宾语、定语；用于书面语"},{"id":44274,"word":"遗风旧俗","pinyin":"yí fēng jiù sú","abbr":"yfjs","explanation":"前代遗留下来的风俗习惯。","source":{"text":"土著之姓十亡七八，五方之俗更为宾主，治者狃闻习见，以遗风旧俗为可鄙，前言往行为可鄙。","book":"元·揭傒斯《彭州学记》"},"similar":["遗风余俗","遗风余习"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44275,"word":"遗风逸尘","pinyin":"yí fēng yì chén","abbr":"yfyc","explanation":"前代遗留下来的风教和超逸的事迹。","source":{"text":"至于高蹈物表，远引方外，亦皆清隽卓绝志士，是其遗风逸尘，霑被无极。","book":"元·俞希鲁《至顺镇江志·人材》"},"usage":"作宾语、定语；用于书面语"},{"id":44276,"word":"遗风遗泽","pinyin":"yí fēng yí zé","abbr":"yfyz","explanation":"先人留下的教化德泽。","source":{"text":"慈和严翼以成其子，使朕得名世之士，以济艰难，其遗风遗泽盖有存者。","book":"宋·苏轼《母聂氏温国太夫人外制》"},"similar":["遗风余泽"],"usage":"作宾语、定语；用于书面语"},{"id":44277,"word":"遗魂亡魄","pinyin":"yí hún wáng pò","abbr":"yhwp","explanation":"指抛弃思虑，停止精神活动。","source":{"text":"遗魂亡魄，休精息神。","book":"汉·严遵《道德指归论·大成若缺》"},"usage":"作谓语、定语；用于书面语"},{"id":44278,"word":"遗黎故老","pinyin":"yí lí gù lǎo","abbr":"ylgl","explanation":"指前朝留下的历经世变的老人。","source":{"text":"当宋初改物，遗黎故老犹有存者。","book":"明·宋濂《曾君石表碑》"},"usage":"作主语、宾语；用于书面语"},{"id":44279,"word":"遝冈复岭","pinyin":"tà gāng fù lǐng","abbr":"tgfl","explanation":"指冈峦重沓。","example":{"text":"～的地形给修路带来很大的困难"},"similar":["层峦叠嶂"],"usage":"作谓语、定语；用于书面语"},{"id":44280,"word":"遣兴陶情","pinyin":"qiǎn xìng táo qíng","abbr":"qxtq","explanation":"遣释意兴，陶冶情趣。","source":{"text":"然不过是侍酒陪饮，追欢买笑，遣兴陶情，解闷破寂，实是少不得的。","book":"明·凌濛初《初刻拍案惊奇》卷二十五"},"example":{"text":"只因～以后，彼此怒气潜消，不止狄希陈与寄姐和好如初，权奶奶与戴奶奶也暂时歇气。","book":"清·西周生《醒世姻缘传》第八十七回"},"usage":"作谓语、宾语、定语；多用于人"},{"id":44281,"word":"遣兵调将","pinyin":"qiǎn bīng diào jiàng","abbr":"qbdj","explanation":"犹调兵遣将。亦作“遣将调兵”、“遣将征兵”。","source":{"text":"再说延州府丞汤思忠遣兵调将已定，然后自领马步军兵，离寨伺候。","book":"《禅真逸史》第二八回"},"example":{"text":"中山先生以为袁氏手握大权，发号施令，～，极称自由。","book":"陈英士《致黄克强书》"},"similar":["调兵遣将","遣将调兵"],"usage":"作谓语、定语、宾语；指调动安排人事"},{"id":44282,"word":"遣将征兵","pinyin":"qiǎn jiāng zhēng bīng","abbr":"qjzb","explanation":"泛指调动安排人力。同“遣兵调将”。","source":{"text":"原来魏主嗣欲乘丧南侵，报复旧怨，因将宋史执回，即日遣将征兵，进攻滑台。","book":"蔡东藩《南北史通俗演义》第七回"},"similar":["遣将调兵"],"usage":"作谓语、定语、宾语；指调动安排人事"},{"id":44283,"word":"遣将调兵","pinyin":"qiǎn jiāng diào bīng","abbr":"qjdb","explanation":"泛指调动安排人力。见“遣兵调将”。","source":{"text":"你既是昆仑之士，理当遣将调兵，共决雌雄。","book":"明·许仲琳《封神演义》第90回"},"similar":["调兵遣将","遣将征兵"],"usage":"作谓语、定语、宾语；指调动安排人事"},{"id":44284,"word":"遣愁索笑","pinyin":"qiǎn chóu suǒ xiào","abbr":"qcsx","explanation":"消愁求乐。","source":{"text":"履园主人于灌园之暇，就耳目所睹闻，著《丛话》二十卷，间以示予曰：‘吾以是遣愁索笑也。’","book":"清孙原湘《序》"},"usage":"作谓语、宾语；用于处世"},{"id":44285,"word":"遣言措意","pinyin":"qiǎn yán cuò yì","abbr":"qycy","explanation":"指写文章、说话时的用词立意。同“遣辞措意”。","source":{"text":"陆贽之文，遣言措意，切近的当，有执事之实。","book":"宋·苏洵《上欧阳内翰第一书》"},"similar":["遣词措意","遣辞措意"],"usage":"作谓语、宾语；用于文章或说话"},{"id":44286,"word":"遣词措意","pinyin":"qiǎn cí cuò yì","abbr":"qccy","explanation":"指写文章、说话时的用词立意。同“遣辞措意”。","source":{"text":"前辈读诗与作诗既多，则遣词措意，皆相缘以起，有不自知其然者。","book":"宋·吴开《优古堂诗话》"},"example":{"text":"写文章时要注意～。"},"similar":["遣辞措意","遣词立意","遣词造意"],"usage":"作谓语、宾语；用于文章或说话"},{"id":44287,"word":"遣词立意","pinyin":"qiǎn cí lì yì","abbr":"qcly","explanation":"指写文章或说话时的用辞立意。","source":{"text":"前辈读诗与作诗既多，则遣辞措意，皆相缘以起，有不自知其然者。","book":"宋·吴曾《能改斋漫录·细数落花因坐久缓寻芳草得归迟》"},"example":{"text":"你这个小妮子，学得几时唱，就晓得～，又念皇家雨露之恩，真个聪明敏慧，可喜可爱。","book":"清·褚人获《隋唐演义》第三十回"},"similar":["遣词造意"],"usage":"作谓语、宾语；用于文章或说话"},{"id":44288,"word":"遣词造句","pinyin":"qiǎn cí zào jù","abbr":"qczj","explanation":"运用词语组织句子。","example":{"text":"学生都要过～这一关。"},"similar":["命词遣意"],"usage":"作谓语、宾语、定语；用于作文等"},{"id":44289,"word":"遣词造意","pinyin":"qiǎn cí zào yì","abbr":"qczy","explanation":"指写文章、说话时的用词立意。同“遣辞措意”。","source":{"text":"虽然文字不同，但遣词造意，却是有一脉相通之处的。","book":"吴晗《学习集·葬花诗和》"},"similar":["遣词立意"],"usage":"作谓语、宾语；用于文章或说话"},{"id":44290,"word":"遣辞措意","pinyin":"qiǎn cí cuò yì","abbr":"qccy","explanation":"指写文章、说话时的用词立意。","source":{"text":"前辈读诗与作诗既多，则遣辞措意，皆相缘以起，有不自知其然者。","book":"宋吴曾《能改斋漫录沿袭》"},"similar":["遣词措意","遣词立意","遣言措意"],"usage":"作谓语、宾语；用于文章或说话"},{"id":44291,"word":"遥亘千里","pinyin":"yáo gè qiān lǐ","abbr":"ygql","explanation":"亘：横贯。指远隔千里。","source":{"text":"此乃迷津，深有万丈，遥亘千里。中无舟楫可通，只有一个木筏，乃木居士掌柁，灰侍者撑篙，不受金银之谢，但遇有缘者渡之。","book":"清·曹雪芹《红楼梦》第五回"}},{"id":44292,"word":"遥以心照","pinyin":"yáo yǐ xīn zhào","abbr":"yyxz","explanation":"遥：远。彼此相隔遥远而心相通。","source":{"text":"每日一入学中，四处各坐，却八目勾留， 或设言托意，或咏桑寓柳，遥以心照，却外面自为避人眼目。","book":"清·曹雪芹《红楼梦》第九回"}},{"id":44293,"word":"遥呼相应","pinyin":"yáo hū xiāng yìng","abbr":"yhxy","explanation":"远远地互相联系，互相配合。同“遥相呼应”。","source":{"text":"蒙古尽驱其家属来攻，父子兄弟，往往遥呼相应，由是人无固志，故所至郡邑皆下。","book":"清·陈忱《续资治通鉴·宋宁宗嘉定六年》"},"similar":["遥相呼应","遥相应和"],"usage":"作谓语、定语；指互相配合"},{"id":44294,"word":"遥夜沉沉","pinyin":"yáo yè chén chén","abbr":"yycc","explanation":"遥夜：长夜。长夜深沉。比喻忧郁的心情或黑暗的社会，好像漫漫长夜熬不到天明。","source":{"text":"遥夜沉沉如水，风紧驿亭深闭。","book":"战国·楚·宋玉《九辩》：“靓杪秋之遥夜兮，心缭悷而有哀。”宋·秦观《如梦令》词"},"example":{"text":"～满幕霜，有时归梦到家乡。","book":"金·宇文虚中《在金日作》"}},{"id":44295,"word":"遥岑寸碧","pinyin":"yáo cén cùn bì","abbr":"yccb","explanation":"岑：小而高的山。极目远望，映入眼帘的是一块仅有一寸来大的苍翠小山。","source":{"text":"遥岑出寸碧，远目增双明。","book":"唐·韩愈《城南联句》"},"example":{"text":"杨花点点是春心，替风前、万花吹泪。～，有谁识、朝来清气。","book":"宋·张炎《西子妆慢》词"}},{"id":44296,"word":"遥相呼应","pinyin":"yáo xiāng hū yìng","abbr":"yxhy","explanation":"遥：远远地；应：照应。远远地互相联系，互相配合。","source":{"text":"且郑成功出没闽、浙，奉其为号，遥相应和，声势颇张。","book":"《清史稿·许友信传》"},"example":{"text":"吴家沟东南面也传来了隆隆声，和常高山的炮声～。","book":"柳青《铜墙铁壁》第14章"},"similar":["遥遥相对","一呼百应"],"opposite":["各自为政","各行其是"],"usage":"作谓语、定语；指互相配合"},{"id":44297,"word":"遥相应和","pinyin":"yáo xiāng yìng hè","abbr":"yxyh","explanation":"遥：远远地；应：照应。远远地互相联系，互相配合。","source":{"text":"仪真蒋山卿、江都赵鹤亦与璘遥相应和。","book":"《明史·文苑传》"},"example":{"text":"且郑成功出没闽、浙，奉其伪号，～，声势颇张。","book":"《清史稿·许友信传》"},"similar":["遥相呼应","遥呼相应"],"usage":"作谓语、定语；指互相配合"},{"id":44298,"word":"遥荡恣睢","pinyin":"yáo dàng zì suī","abbr":"ydzs","explanation":"遥荡：任心纵散；恣睢：放任无拘束。指性情不受拘束，任心放荡。","source":{"text":"夫尧既已黥汝以仁义，而劓汝以是非矣，汝将何以游夫遥荡恣睢转徙之涂乎？","book":"《庄子·大宗师》"}},{"id":44299,"word":"遥遥华胄","pinyin":"yáo yáo huá zhòu","abbr":"yyhz","explanation":"指名人的远裔。嘲人自夸出于名门。","source":{"text":"何昌寓为吏部尚书，尝有客姓闵，求官……谓坐客曰：‘遥遥华胄！’","book":"唐·李延寿《南史·何昌寓传》"},"example":{"text":"清·唐孙华《草圣祠》诗：“～人谁辨，应似林宗问阿贞。”"},"usage":"作宾语、定语；指关系遥远","story":["南北朝时期，吏部尚书何昌寓为人正直高雅，一个姓闵青年给他送来一大堆礼品，希望能举荐他做官。何昌寓给他讲子鱼拒鱼的故事。青年则说奉父母之命前来求一官半职，并说自己是子骞的后代。何昌寓笑着对在座人说遥遥华胄怎能联系呢？"]},{"id":44300,"word":"遥遥在望","pinyin":"yáo yáo zài wàng","abbr":"yyzw","explanation":"先秦·左丘明《左传·昭公二十五年》：“鸲鹆之巢，远哉遥遥。”","source":{"text":"鸲鹆之巢，远哉遥遥。","book":"先秦·左丘明《左传·昭公二十五年》"},"similar":["近在眼前","鸡犬相闻","近在咫尺"],"opposite":["远在天边","天涯海角"],"usage":"作谓语、定语；指远远地可以看到"},{"id":44301,"word":"遥遥无期","pinyin":"yáo yáo wú qī","abbr":"yywq","explanation":"遥遥：形容时间长久。时间还远得很，不知道哪一天。比喻离达到目的的日子还远得很。","source":{"text":"看看前头存在黄胖姑那里的银子渐渐花完，只剩得千把两银子，而放缺又遥遥无期。","book":"清·李宝嘉《官场现形记》第二十七回"},"example":{"text":"因此工作便十分迁延，武昌城的攻破～。","book":"郭沫若《革命春秋》二十七"},"similar":["旷日持久","天长日久","天荒地老"],"opposite":["指日可待","一朝一夕","弹指之间"],"usage":"作谓语、定语；指不知道要到哪一天"},{"id":44302,"word":"遥遥相对","pinyin":"yáo yáo xiāng duì","abbr":"yyxd","explanation":"远远地对着。多形容两样事物的性质或形状相类似，配得上。","source":{"text":"两边行军队伍，已分为甲乙两垒，大家占着一块地面，作遥遥相对之势。","book":"清·李宝嘉《文明小史》第五十六回"},"example":{"text":"五七那天，章宅的事情，和我校的可算是～。（鲁迅《两地书》二十）"},"similar":["遥相呼应","两两相对","遥遥相望"],"opposite":["互不相干","毫无瓜葛"],"usage":"作谓语、定语、状语；指两者相对"},{"id":44303,"word":"遥遥相望","pinyin":"yáo yáo xiāng wàng","abbr":"yyxw","explanation":"远远地望着。多形容两样事物的性质或形状相类似，配得上。","source":{"text":"温温独游迹，遥遥相望情。","book":"唐·皎然《后与故人别，予西上，至今在扬楚，因有是寄》"},"example":{"text":"郭芙领着一队兵马待要冲入相救，却被蒙古两个千人队拦住了，夫妻俩～，却是不能相聚。","book":"金庸《神雕侠侣》第三十九回"}},{"id":44304,"word":"遥遥领先","pinyin":"yáo yáo lǐng xiān","abbr":"yylx","explanation":"遥遥：远远。远远地走在最前面。","source":{"text":"我们的声誉就是实力--遥遥领先的技术和工艺。","book":"罗来勇《世界在他们眼前展开》"},"similar":["一马当先"],"opposite":["一落千丈","江河日下","瞠乎其后"],"usage":"作谓语、定语、状语；指领先"},{"id":44305,"word":"遨翔自得","pinyin":"áo xiáng zì dé","abbr":"axzd","explanation":"指自由自在的样子。","example":{"text":"天空中那只老鹰～，真让人羡慕。"}},{"id":44306,"word":"遫俗绝物","pinyin":"chuò sú jué wù","abbr":"csjw","explanation":"犹言超世绝俗。","source":{"text":"卷五吾无务为遫俗绝物之行，而天下已不能不群然趋向。","book":"清·周亮工《书影》"}},{"id":44307,"word":"遬听远闻","pinyin":"tì tīng yuǎn wén","abbr":"ttyw","explanation":"遬”同逖”。指视听范围很远很广。"},{"id":44308,"word":"遭事制宜","pinyin":"zāo shì zhì yí","abbr":"zszy","explanation":"犹言因事制宜。","source":{"text":"世俗岁殊，时变日化，遭事制宜，因时而移，旧之非者，何可放焉！","book":"《汉书·外戚传下·孝成许皇后》"},"similar":["因事制宜"],"usage":"作谓语、定语、宾语；用于处事"},{"id":44309,"word":"遭倾遇祸","pinyin":"zāo qīng yù huò","abbr":"zqyh","explanation":"遭逢危亡之世而遇祸害。","source":{"text":"言己遭倾危之世而遇患祸，不可复救，故长叹歔欷而涕滂流，不可止也。","book":"《楚辞·刘向〈九叹·远逝〉》：“遭倾遇祸，不可救兮，长吟永欷，涕究究兮。”王逸注"},"usage":"作谓语、宾语；用于书面语"},{"id":44310,"word":"遭劫在数","pinyin":"zāo jié zài shù","abbr":"zjzs","explanation":"指命中注定要遇到灾难。","source":{"text":"他竟要弄得到一处，这人也就算个遭劫在数的了！","book":"清·文康《儿女英雄传》第三十四回"},"similar":["在劫难逃"],"usage":"作宾语、定语；用于书面语"},{"id":44311,"word":"遭家不造","pinyin":"zāo jiā bù zào","abbr":"zjbz","explanation":"遭：遇到；造：成。原是周成王居父丧时自哀之辞。后指遭遇家中不幸的事。","source":{"text":"闵予小子，遭家不造，嬛嬛在疚。於乎皇考。","book":"《诗经·周颂·闵予小子》"},"example":{"text":"予小子～，金寇猖狂，二帝北辕，九庙丘墟。","book":"清·钱彩《说岳全传》第二十二回"},"usage":"作谓语、定语；指遭遇不幸"},{"id":44312,"word":"遭时不偶","pinyin":"zāo shí bù ǒu","abbr":"zsbo","explanation":"指不遇合时机。","source":{"text":"遭时不偶，务自韬晦。","book":"元·许衡《时务五事·为君难·任贤》"},"similar":["遭逢不偶","遭际不偶"],"opposite":["遭逢会遇"],"usage":"作谓语、宾语、定语；用于处事"},{"id":44313,"word":"遭时制宜","pinyin":"zāo shí zhì yí","abbr":"zszy","explanation":"犹言因时制宜。","source":{"text":"遭时制宜，质文迭用，应之以通变，通变之以中庸。","book":"《隋书·经籍志一》"},"similar":["因时制宜","遭事制宜"],"usage":"作谓语、定语、宾语；用于处事"},{"id":44314,"word":"遭时定制","pinyin":"zāo shí dìng zhì","abbr":"zsdz","explanation":"指因时势而规定法制。","source":{"text":"遭遇其时而定法制，不循于旧也。","book":"南朝宋·范晔《后汉书·崔骃传》：“故圣人执权，遭时定制，步骤之差，各有云设。”李贤注"},"opposite":["墨守成规"],"usage":"作谓语、定语、宾语；用于处事"},{"id":44315,"word":"遭逢不偶","pinyin":"zāo féng bù ǒu","abbr":"zfbo","explanation":"指不遇合时机。","source":{"text":"说则说老手能修五凤楼，怕则怕遭逢不偶。","book":"明·冯惟敏《不伏老》第三折"},"example":{"text":"嗟乎！遇合难期，～。","book":"清·蒲松龄《聊斋志异·叶生》"},"similar":["遭时不偶","遭际不偶"],"opposite":["遭逢会遇"],"usage":"作谓语、宾语、定语；用于处事"},{"id":44316,"word":"遭逢会遇","pinyin":"zāo féng huì yù","abbr":"zfhy","explanation":"犹言逢遇时机。","source":{"text":"非二龙使厉王发孽、褒姒令幽王愚惑也，遭逢会遇，自相得也。","book":"汉·王充《论衡·偶会》"},"similar":["遭逢际会"],"opposite":["遭逢不偶"],"usage":"作谓语、定语；用于处事"},{"id":44317,"word":"遭逢时会","pinyin":"zāo féng shí huì","abbr":"zfsh","explanation":"犹言逢遇时机。同“遭遇际会”。","source":{"text":"于是，国字号的东西，又蜂然的遭逢时会，一时并起。","book":"郑振铎《论武侠小说》"},"similar":["遭逢际会","遭遇际会","遭遇运会"],"opposite":["遭际不偶"],"usage":"作谓语、定语；用于处事"},{"id":44318,"word":"遭逢际会","pinyin":"zāo féng jì huì","abbr":"zfjh","explanation":"犹言逢遇时机。","source":{"text":"侯莫陈悦本实庸才，遭逢际会，遂叨任委。","book":"《周书·文帝纪上》"},"similar":["遭逢时会","遭逢会遇","遭遇际会"],"opposite":["遭逢不偶","遭遇不偶"],"usage":"作谓语、定语；用于处事"},{"id":44319,"word":"遭遇不偶","pinyin":"zāo yù bù ǒu","abbr":"zybo","explanation":"指不遇合时机。","source":{"text":"遭遇不偶，居恒忽忽，悲歌感慨，以发其堙郁之气。","book":"清·谭嗣同《先仲兄行状》"},"example":{"text":"人都有～的时候"},"similar":["遭逢不偶","遭时不偶","遭际不偶"],"opposite":["遭逢际会","遭逢时会","遭遇际会"],"usage":"作谓语、定语；用于处事"},{"id":44320,"word":"遭遇运会","pinyin":"zāo yù yùn huì","abbr":"zyyh","explanation":"犹言逢遇时机。同“遭遇际会”。","source":{"text":"隗嚣遭遇运会，割有雍州，兵强士附，威加山东。","book":"《后汉书·公孙述传》"},"similar":["遭逢际会","遭逢时会","遭遇际会"],"opposite":["遭逢不偶","遭遇不偶"],"usage":"作谓语、定语；用于处事"},{"id":44321,"word":"遭遇际会","pinyin":"zāo yù jì huì","abbr":"zyjh","explanation":"犹言逢遇时机。","source":{"text":"今吾德至薄也，人至鄙也，遭遇际会，幸承先王馀业，恩未被四海，泽未及天下，虽倾仓竭府以振魏国百姓，犹寒者未尽暖，饥者未尽饱。","book":"晋·陈寿《三国志·魏书·文帝纪》"},"example":{"text":"～，毕力遐方。","book":"唐·房玄龄《晋书·宣帝纪》"},"similar":["遭遇运会","遭逢际会","遭逢时会"],"opposite":["遭逢不偶","遭遇不偶"],"usage":"作谓语、定语；用于处事"},{"id":44322,"word":"遭际不偶","pinyin":"zāo jì bù ǒu","abbr":"zjbo","explanation":"指不遇合时机。","source":{"text":"原来他因为自己辛苦一生，遭际不偶，此番回家，早打了个再不出山的主意。","book":"清·文康《儿女英雄传》第三十三回"},"similar":["遭逢不偶","遭时不偶"],"opposite":["遭逢会遇"],"usage":"作谓语、宾语、定语；用于处事"},{"id":44323,"word":"遭际时会","pinyin":"zāo jì shí huì","abbr":"zjsh","explanation":"犹言逢遇时机。","source":{"text":"厥后遭际时会，擢授京尹。","book":"陈夔龙《梦蕉亭杂记》卷一"},"similar":["遭逢时会","遭逢际会","遭遇际会"],"opposite":["遭际不偶"],"usage":"作谓语、定语；用于处事"},{"id":44324,"word":"遮三瞒四","pinyin":"zhē sān mán sì","abbr":"zsms","explanation":"说话、做事多方掩饰，不爽快。","source":{"text":"昨夜怎么他两个一同出来，你且告诉了我，我自有主意，可不要遮三瞒四的。","book":"清·吴趼人《二十年目睹之怪现状》第三十三回"},"similar":["藏头露尾","遮遮掩掩"],"opposite":["直言不讳"],"usage":"作状语、定语、宾语；用于说话"},{"id":44325,"word":"遮人眼目","pinyin":"zhē rén yǎn mù","abbr":"zrym","explanation":"明·方汝浩《禅真逸史》第十九回：“你只见庵观寺院的和尚贫财好色，明蔬暗荤，遮人眼目，俺庄内须与他们不同，荤酒俱有，待人甚恕。”","source":{"text":"你只见庵观寺院的和尚贫财好色，明蔬暗荤，遮人眼目，俺庄内须与他们不同，荤酒俱有，待人甚恕。","book":"明·方汝浩《禅真逸史》第十九回"},"example":{"text":"探春笑道：‘这种～儿的事，谁不会做？且再瞧就是了。’","book":"清·曹雪芹《红楼梦》第七十五回"},"similar":["遮人耳目","遮人耳目","遮掩耳目"],"opposite":["明目张胆"],"usage":"作谓语、定语；指欺骗"},{"id":44326,"word":"遮人耳目","pinyin":"zhē rén ěr mù","abbr":"zrem","explanation":"遮：遮掩。遮掩他人视听。指玩弄手法，掩盖真相。","source":{"text":"下游民间之坊市，宿于娼馆，事迹显然，虽欲掩人之耳目，不可得也。","book":"宋·无名氏《大宋宣和遗事》前集"},"example":{"text":"就叫自己兄弟二大人通信给他，叫他暂时搬出衙门，好～。","book":"清·李宝嘉《官场现形记》第三十三回"},"similar":["掩人耳目","遮人耳目","遮掩耳目"],"opposite":["明目张胆"],"usage":"作谓语、定语；指欺骗"},{"id":44327,"word":"遮前掩后","pinyin":"zhē qián yǎn hòu","abbr":"zqyh","explanation":"指说话藏头露尾，欲言又止。","source":{"text":"大家讲究到底，大开眼看觑，大开口说话，分明去取，直截剖判，不须得如此遮前掩后，似说不说，做三日新妇子模样，不亦快哉！","book":"宋·朱熹《答叶正则书》之四"},"usage":"作宾语、定语、状语；用于说话"},{"id":44328,"word":"遮地漫天","pinyin":"zhē dì màn tiān","abbr":"zdmt","explanation":"形容风沙、雨雪大或人马等极多。","source":{"text":"团空搅阵，不分南北西东；遮地迷天，变尽青黄赤黑。","book":"《清平山堂话本·羊角哀死战荆轲》"},"similar":["遮地盖天","遮天压地","遮天迷地"],"usage":"作谓语、定语、状语；指数量多"},{"id":44329,"word":"遮地盖天","pinyin":"zhē dì gài tiān","abbr":"zdgt","explanation":"形容风沙、雨雪大或人马等极多。同“遮天盖地”。","source":{"text":"大小据点一扫光，红军和赤卫军遮地盖天。","book":"李季《五月端阳·打横山》"},"similar":["遮天盖地","遮地漫天","遮天迷地"],"usage":"作谓语、定语、状语；指数量多"},{"id":44330,"word":"遮天压地","pinyin":"zhē tiān yā dì","abbr":"ztyd","explanation":"遮住天，盖住地。形容数量多，占的面积大。","source":{"text":"吴兵见先主奔走，皆要争功，各引大军，遮天盖地，往西追赶，先主令军士尽脱袍铠，塞道而焚，以断后军。","book":"明·罗贯中《三国演义》第八十四回"},"example":{"text":"在那八人轿前领着那些车轿人马，浩浩荡荡，一片锦绣香烟，～而来。（清·曹雪芹《红楼梦》第二十九回）"},"similar":["遮天盖地","遮地盖天","遮地漫天"],"usage":"作谓语、定语、状语；指数量多"},{"id":44331,"word":"遮天映日","pinyin":"zhē tiān yìng rì","abbr":"ztyr","explanation":"遮蔽天空和太阳。形容事物体积庞大、数量众多或气势盛大。","source":{"text":"高继能把蜈蜂袋一抖，好蜈蜂！遮天映日，若骤雨飞蝗。","book":"明·许仲琳《封神演义》第七十回"},"example":{"text":"人人动嘴，个个低头。～，犹如蝗蝻一齐来；挤眼掇肩，好似饿牢才打出。","book":"明·兰陵笑笑生《金瓶梅词话》第十二回"},"similar":["遮天蔽日","遮空蔽日","遮天盖日"],"usage":"作定语、状语；用于书面语"},{"id":44332,"word":"遮天盖地","pinyin":"zhē tiān gài dì","abbr":"ztgd","explanation":"形容数量多，占的面积大。","source":{"text":"啊，团结的大旗，啊，我们遮天盖地的红云！","book":"严阵《竹矛·大旗歌》"},"example":{"text":"洪水霎时～而来，冲毁了整个村镇。"},"similar":["铺天盖地","遮地漫天","遮天迷地"],"usage":"作谓语、定语、状语；指数量多"},{"id":44333,"word":"遮天盖日","pinyin":"zhē tiān gài rì","abbr":"ztgr","explanation":"遮蔽天空和太阳。形容事物体积庞大、数量众多或气势盛大。","source":{"text":"眼看要走进另一道川，忽然间被一座遮天盖日的大山挡住了。","book":"浩然《石山柏》"},"example":{"text":"天上，五六十架敌机隆隆飞来了，好像满天飞鸟似的，～，杀气腾腾。","book":"袁静《伏虎记》第十五回"},"similar":["遮天蔽日","遮空蔽日"],"usage":"作谓语、定语、状语；用于口语"},{"id":44334,"word":"遮天蔽日","pinyin":"zhē tiān bì rì","abbr":"ztbr","explanation":"遮蔽天空和太阳。形容事物体积庞大、数量众多或气势盛大。","source":{"text":"远远望见辽兵盖地而来，黑洞洞遮天蔽日，都是皂雕旗。","book":"明·施耐庵《水浒传》第八十三回"},"example":{"text":"沿着石砌的山路，两旁满是古松古柏，～的。","book":"杨朔《香山红叶》"},"similar":["蔽日遮天","遮空蔽日"],"usage":"作谓语、定语、状语；用于恶势力或气势等"},{"id":44335,"word":"遮天迷地","pinyin":"zhē tiān mí dì","abbr":"ztmd","explanation":"形容风沙、雨雪大或人马等极多。","source":{"text":"风起处遮天迷地，火来时烟飞焰裹。","book":"明·许仲琳《封神演义》第七十六回"},"similar":["遮地盖天","遮天压地","遮地漫天"],"usage":"作谓语、定语、状语；指数量多"},{"id":44336,"word":"遮掩耳目","pinyin":"zhē yǎn ěr mù","abbr":"zyem","explanation":"指遮掩别人的视听，掩饰真情。","source":{"text":"听说事后执政府乘人不知，已将尸首掩埋了些，以图遮掩耳目。","book":"朱自清《执政府大屠杀记》"},"similar":["遮人耳目","遮人眼目"],"usage":"作谓语、定语；指欺骗"},{"id":44337,"word":"遮空蔽日","pinyin":"zhē kōng bì rì","abbr":"zkbr","explanation":"遮蔽天空和太阳。形容事物体积庞大、数量众多或气势盛大。","source":{"text":"遮蔽天空和太阳。形容事物体积庞大、数量众多或气势盛大。"},"similar":["遮天蔽日"],"usage":"作谓语、定语、状语；用于恶势力或气势等"},{"id":44338,"word":"遮羞包丑","pinyin":"zhē xiū bāo chǒu","abbr":"zxbc","explanation":"指掩盖感到羞耻和丑陋的东西。","source":{"text":"这一张文凭，仿佛有亚当、夏娃下身那片树叶的功用，可以遮羞包丑。","book":"钱钟书《围城》"},"usage":"作谓语、定语；用于处事"},{"id":44339,"word":"遮羞布","pinyin":"zhē xiū bù","abbr":"zxb","explanation":"系在腰间遮盖下身的布。借指用来掩盖羞耻的事物。","source":{"text":"其实她没什么好怕的，别说身上还有块遮羞布，就是一丝不挂，再眼尖的观众也看不着什么。","book":"王朔《千万别把我当人》"},"example":{"text":"他老是拿文明两字来当他行为的～。"},"usage":"作宾语、定语；用于比喻句"},{"id":44340,"word":"遮遮掩掩","pinyin":"zhē zhē yǎn yǎn","abbr":"zzyy","explanation":"指要隐瞒某种真相而行为不爽利。","source":{"text":"起初还恐怕雌鬼要话长说短，遮遮掩掩的瞒着他。","book":"清·张南庄《何典》第五回"},"example":{"text":"钱钟书《围城》：“鸿渐才买了些回去，进旅馆时，～的深怕落在掌柜或伙计的势利眼里。”"},"similar":["掩掩藏藏"],"opposite":["爽爽快快"],"usage":"作定语、状语；用于处事等"},{"id":44341,"word":"遮风挡雨","pinyin":"zhē fēng dǎng yǔ","abbr":"zfdy","explanation":"比喻起保护作用。","source":{"text":"我这是冒着险来为你遮风挡雨呀，我的老战友。","book":"李娴娟《血染的爱》"},"example":{"text":"父母真诚地为孩子～。"},"usage":"作谓语、定语；指保护"},{"id":44342,"word":"遵养待时","pinyin":"zūn yǎng dài shí","abbr":"zyds","explanation":"指顺应时势积蓄力量以待时机。","source":{"text":"此言尔朱荣待有时机，即欲篡夺。","book":"北魏·杨衒之《洛阳伽蓝记·永宁寺》：“害卿兄弟，独夫介立，遵养待时，臣节讵久。”范祥雍校注"},"similar":["遵养晦时","遵养时晦","遵时养晦"],"usage":"作谓语、定语；用于处事"},{"id":44343,"word":"遵养时晦","pinyin":"zūn yǎng shí huì","abbr":"zysh","explanation":"遵：遵循，按照；时：时势；晦：隐藏。原为颂扬周武王顺应时势，退守待时。后多指暂时隐居，等待时机。","source":{"text":"于铄王师，遵养时晦。","book":"《诗经·周颂·酌》"},"example":{"text":"段祺瑞经了此险，越发杜门谢客，～，连几个围棋好友，也不甚往来了。","book":"蔡东藩、许厪父《民国通俗演义》第五十一回"},"similar":["遵时养晦"],"usage":"作谓语、宾语；指蓄势待发"},{"id":44344,"word":"遵养晦时","pinyin":"zūn yǎng huì shí","abbr":"zyhs","explanation":"内外受到敌人的攻击。","source":{"text":"浮云不足贵，遵养晦时文。","book":"唐·陈子昂《感遇》诗之十一"},"similar":["遵养时晦","遵时养晦","遵养待时"],"usage":"作谓语、定语；用于处事"},{"id":44345,"word":"遵厌兆祥","pinyin":"zūn yàn zhào xiáng","abbr":"zyzx","explanation":"指遵循预兆行事。","source":{"text":"田乞及常所以比犯二君，之齐国之政，非必事势之渐然也，盖若遵厌兆祥云。","book":"《史记·田敬仲完世家论》"},"usage":"作宾语、定语；用于处事"},{"id":44346,"word":"遵常守故","pinyin":"zūn cháng shǒu gù","abbr":"zcsg","explanation":"遵常：遵循常规；守故：坚持陈旧的作风。指因袭保守，不求建树。","source":{"text":"若夫龌龊近步，遵常守故，安足为陛下言哉！","book":"三国·魏·曹植《陈审举表》"}},{"id":44347,"word":"遵时养晦","pinyin":"zūn shí yǎng huì","abbr":"zsyh","explanation":"遵：遵循，按照；时：时势；晦：隐藏。原为颂扬周武王顺应时势，退守待时。后多指暂时隐居，等待时机。","source":{"text":"于铄王师，遵养时晦。","book":"《诗经·周颂·酌》"},"example":{"text":"仆拟～，以待政府之稔恶，其时排去一二佞人，有如摘果。","book":"章炳麟《致伯中书》四"},"similar":["遵养时晦"],"usage":"作谓语、宾语；指等待时机"},{"id":44348,"word":"遵而不失","pinyin":"zūn ér bù shī","abbr":"zebs","explanation":"遵照先人的典章制度而不违失。","source":{"text":"朕肃膺宝历，纂临万邦，遵而不失，心奉先志。","book":"《隋书·炀帝纪上》"},"similar":["遵而勿失"],"usage":"作谓语、定语；用于处事"},{"id":44349,"word":"遵而勿失","pinyin":"zūn ér wù shī","abbr":"zews","explanation":"遵照先人的典章制度而不违失。","source":{"text":"且高帝与萧何定天下，法令既明，今陛下垂拱，参等守职，遵而勿失，不亦可乎？","book":"《史记·曹相国世家》"},"similar":["遵而不失"],"usage":"作谓语、定语；用于处事"},{"id":44350,"word":"遵道秉义","pinyin":"zūn dào bǐng yì","abbr":"zdby","explanation":"犹言遵守道义。","source":{"text":"逮夫弱冠，遵道秉义。","book":"唐·柳宗元《清河张府君墓志铭》"},"usage":"作谓语、定语；用于处事"},{"id":44351,"word":"避世墙东","pinyin":"bì shì qiáng dōng","abbr":"bsqd","explanation":"指隐居于市井贩夫之中。","source":{"text":"君公（王君公）遭乱独不去，侩牛自隐。时人谓之论曰：‘避世墙东王君公。’","book":"《后汉书·逸民传·逢萌》"},"example":{"text":"著书何必向函关，～也驻颜。","book":"清·毛奇龄《平太翁初度》诗之二"},"usage":"作谓语；指隐居闹市"},{"id":44352,"word":"避世离俗","pinyin":"bì shì lí sú","abbr":"bsls","explanation":"指逃避浊世，超脱凡俗。","source":{"text":"以清节自守，不降志辱身为贤乎？是则避世离俗，长沮、桀溺之类也。","book":"汉·王充《论衡·定贤》"},"example":{"text":"山林之士，～以为亢者，其侏张不群，与夫贪墨佣驽之役夫，诚相去远矣。","book":"章炳麟《訄书·原变》"},"similar":["避世绝俗"],"usage":"作谓语、定语；形容人超俗"},{"id":44353,"word":"避世绝俗","pinyin":"bì shì jué sú","abbr":"bsjs","explanation":"避世：隐居不出仕；绝俗：与世间隔绝。脱离现实生活，不和人们往来。形容隐居山林，不与世人交往。一般指消极处世的态度。","source":{"text":"栖情玄远，确然绝俗。","book":"《庄子·刻意》：“此江海之士，避世之人。”《晋书·华轶传》"},"similar":["避世离俗"],"usage":"作谓语、定语；指消极处世的态度"},{"id":44354,"word":"避世金门","pinyin":"bì shì jīn mén","abbr":"bsjm","explanation":"以之比喻身为朝官而逃避世务。","source":{"text":"见“避世金马”。"},"example":{"text":"～不厌深，华颠短褐岁侵寻。","book":"清·沈元沧《杂咏》之二"},"similar":["避世金马"],"usage":"作宾语、定语；指避世"},{"id":44355,"word":"避世金马","pinyin":"bì shì jīn mǎ","abbr":"bsjm","explanation":"以之比喻身为朝官而逃避世务。","source":{"text":"（东方朔）时坐席中，酒酣，据地歌曰：‘陆沈於俗，避世金马门。宫殿中可以避世全身，何必深山之中、蒿庐之下！’","book":"《史记·滑稽列传》"},"example":{"text":"人有讥其靖默不能趣时者，逊常服东方朔之言，陆沉世欲，～，何必深山蒿芦之下，遂借陆沉公子为主人，拟《客难》，制《客诲》以自广。","book":"《北齐书·文苑传·樊逊》"},"similar":["避世金门"],"usage":"作宾语、定语；指避世"},{"id":44356,"word":"避之若浼","pinyin":"bì zhī ruò měi","abbr":"bzrm","explanation":"指躲避惟恐不及，生怕沾污了自身。","source":{"text":"与乡人立，见其冠不正，望望然，惭愧之貌也，去之恐其污己也。","book":"《孟子·公孙丑上》：“推恶恶之心，思与乡人立，其冠不正，望望然去之，若将浼也。”赵岐注"},"example":{"text":"他一口拒绝，～。","book":"夏衍《感谢德莱塞》"},"usage":"作谓语、定语；指回避"},{"id":44357,"word":"避井入坎","pinyin":"bì jǐng rù kǎn","abbr":"bjrk","explanation":"比喻躲过一害，又受一害。同“避坑落井”。","example":{"text":"他最终没有逃过～的结局。"},"similar":["避坑落井"],"usage":"作谓语、宾语、定语；指人不能避免受害"},{"id":44358,"word":"避人眼目","pinyin":"bì rén yǎn mù","abbr":"brym","explanation":"指避免走漏消息。同“避人耳目”。","source":{"text":"每日一入学中，四处各坐，却八目勾留，或设言托意，或咏桑寓柳，遥以心照，却外面自为避人眼目。","book":"清·曹雪芹《红楼梦》第九回"},"example":{"text":"在秋谷想起来，不过少年好事，喜欢闹玩意儿，要看看他箱内倒底装的什么，要这样的～，原不是什么歹心。","book":"清·张春帆《九尾龟》第二十回"},"similar":["避人耳目"],"usage":"作谓语、定语；用于隐秘的事情"},{"id":44359,"word":"避人耳目","pinyin":"bì rén ěr mù","abbr":"brem","explanation":"指避免走漏消息。","source":{"text":"我欲姐姐迁个住处，他日相迎，亦可以避人耳目。","book":"清·俞达《青楼梦》第二十八回"},"example":{"text":"以后切记在心，汝等亦不许向后花园闲玩，当～。","book":"《驻春园小史》第四回"},"similar":["掩人耳目"],"usage":"作谓语、定语、宾语；用于秘密等"},{"id":44360,"word":"避俗趋新","pinyin":"bì sú qū xīn","abbr":"bsqx","explanation":"指舍弃旧俗而追求新潮。","source":{"text":"‘拜年’有什么意义呢？无非是崇尚虚文的陋俗罢了。于是相率不‘拜年’，表示避俗趋新。","book":"叶圣陶《未厌集·苦辛》"},"usage":"作谓语、定语；指人赶时髦"},{"id":44361,"word":"避其锐气","pinyin":"bì qí ruì qì","abbr":"bqrq","explanation":"其：他的；锐气：勇猛的气势。避开敌人的旺盛气势，等敌人疲惫松懈时再狠狠打击。","source":{"text":"故善用兵者，避其锐气，击其惰归，此治气者也。","book":"春秋·齐·孙武《孙子·军争》"},"example":{"text":"我们要～，智取这个无名高地。"},"similar":["避实击虚"],"usage":"作宾语、定语；指一种战术","story":["公元前684年，齐国恃强凌弱攻打鲁国，鲁庄公率军在长勺迎敌，两军相遇，齐军擂起战鼓，鲁军在曹刿的带领下为避其锐气没有擂鼓。齐军第三次擂鼓时士气已经低落，鲁军才第一次擂鼓。鲁军靠的就是一鼓作气的士气以少胜多打败齐军"]},{"id":44362,"word":"避其锐气，击其惰归","pinyin":"bì qí ruì qì，jī qí duò guī","abbr":"bqrqjqdg","explanation":"其：他的；锐气：勇猛的气势；惰：松懈善于用兵之人，总是避开敌人初来时的气势，等敌人疲惫时再狠狠打击。","source":{"text":"故善用兵者，避其锐气，击其惰归，此治气者也。","book":"春秋·齐·孙武《孙子·军争》"},"example":{"text":"孙子说的‘～’，就是指的使敌疲劳沮丧，以求减杀其优势。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["避实击虚"],"usage":"作宾语、定语、分句；指一种战争计谋","story":["公元前684年，齐国恃强凌弱攻打鲁国，鲁庄公率军在长勺迎敌，两军相遇，齐军擂起战鼓，鲁军在曹刿的带领下为避其锐气没有擂鼓。齐军第三次擂鼓时士气已经低落，鲁军才第一次擂鼓。鲁军靠的就是一鼓作气的士气以少胜多打败齐军"]},{"id":44363,"word":"避军三舍","pinyin":"bì jūn sān shè","abbr":"bjss","explanation":"指退让和回避。一舍：三十里。","source":{"text":"见“避君三舍”。"},"example":{"text":"但是笑声过后，越想越不是滋味，因为那个夕佳轩主总是不冷不热，～，实在令人恼火。","book":"邢院生《叛女》十七"},"similar":["避君三舍","退避三舍"],"opposite":["针锋相对"],"usage":"作谓语、定语；指退让","story":["春秋时期，晋国内乱，晋献公的儿子重耳逃到楚国。楚成王收留并款待他，他许以如晋楚发生战争晋军退避三舍。后来重耳在秦穆公的帮助下重回晋国执政。晋国支持宋国与楚国发生矛盾，两军在城濮相遇，重耳退避三舍，诱敌深入而大胜"]},{"id":44364,"word":"避凉附炎","pinyin":"bì liáng fù yán","abbr":"blfy","explanation":"指疏远避开无权势者，亲热攀附有权势者。","source":{"text":"母，小人也，避凉附炎，且其性残虐。","book":"明·朱国桢《涌幢小品》"},"similar":["趋炎附势"],"usage":"作谓语、定语；指人很势利"},{"id":44365,"word":"避凶就吉","pinyin":"bì xiōng jiù jí","abbr":"bxjj","explanation":"避：避开；就：趋。指避开祸害而趋向吉利。","source":{"text":"主公宜避凶就吉，不可轻举妄动。","book":"明·罗贯中《三国演义》第106回"},"similar":["避凶趋吉"],"usage":"作谓语、定语；指人避开祸害"},{"id":44366,"word":"避凶趋吉","pinyin":"bì xiōng qū jí","abbr":"bxqj","explanation":"避开凶险，趋向吉祥。","source":{"text":"曾参不入胜母，汉祖不留柏人，避凶趋吉，所不可废。","book":"宋·王观国《学林·诗卜》"},"example":{"text":"想伊必是大仙，休咎事曾经明辨，论～，惟人当自先。","book":"明·沈鲸《双珠记·真武灵隐》"},"similar":["避祸就福"],"usage":"作谓语、定语；指人避开祸害"},{"id":44367,"word":"避君三舍","pinyin":"bì jūn sān shè","abbr":"bjss","explanation":"指退让和回避。一舍：三十里。","source":{"text":"楚子飨之，曰：‘公子若反晋国，则何以报不穀？’……（重耳）对曰：‘若以君之灵，得反晋国，晋楚治兵，遇於中原，其辟君三舍。’","book":"《左传·僖公二十三年》"},"example":{"text":"放子一头嗟我老，～与之平。","book":"宋·刘克庄《题蔡炷主簿诗卷》诗"},"similar":["退避三舍"],"opposite":["针锋相对"],"usage":"作谓语、定语；指退让","story":["春秋时期，晋国内乱，晋献公的儿子重耳逃到楚国。楚成王收留并款待他，他许以如晋楚发生战争晋军退避三舍。后来重耳在秦穆公的帮助下重回晋国执政。晋国支持宋国与楚国发生矛盾，两军在城濮相遇，重耳退避三舍，诱敌深入而大胜"]},{"id":44368,"word":"避嚣习静","pinyin":"bì xiāo xí jìng","abbr":"bxxj","explanation":"嚣：喧哗。躲开喧闹，安于清静。","source":{"text":"现在她已经住在医院里，既然不是有病，那就是有点避嚣习静的意味了。","book":"茅盾《追求·八》"},"usage":"作谓语、定语；指习惯安静"},{"id":44369,"word":"避坑落井","pinyin":"bì kēng luò jǐng","abbr":"bklj","explanation":"躲过了坑，又掉进井里。比喻躲过一害，又受一害。","source":{"text":"今宜共戮力以备贼，幸无外难，而内自相击，是避坑落井也。","book":"《晋书·褚翜传》"},"example":{"text":"他～，还是逃不脱厄运。"},"similar":["避阱入坑"],"usage":"作谓语、宾语、定语；形容人不能避免受害"},{"id":44370,"word":"避嫌守义","pinyin":"bì xián shǒu yì","abbr":"bxsy","explanation":"嫌：嫌疑；守义：保守道义。避开嫌疑，保守道义。","source":{"text":"今主公避嫌守义，恐失众人之望。","book":"明·罗贯中《三国演义》第73回"},"usage":"作谓语；指人守道义"},{"id":44371,"word":"避实击虚","pinyin":"bì shí jī xū","abbr":"bsjx","explanation":"实：实在，坚实部分；虚：空虚，虚弱部分。指避开敌人的主力，找敌人的弱点进攻。又指谈问题回避要害。","source":{"text":"兵之形，避实而击虚。","book":"《孙子·虚实》"},"example":{"text":"臣以为天下之势，～，不过如是。","book":"宋·辛弃疾《美芹十论·详战第十》"},"similar":["避实就虚"],"opposite":["以卵投石"],"usage":"作谓语、宾语、定语；用于军事方面","story":["公元前623年，晋楚在城濮交战，晋文公采用避实就虚的作战方法，避免与楚军的中军主力决战，先令其下军向楚右军进攻，因为楚右军是由陈、蔡两国军队组成的弱势部队，一举取胜。晋军主将狐毛又用计诱歼了楚左军，最终取得重大胜利"]},{"id":44372,"word":"避实就虚","pinyin":"bì shí jiù xū","abbr":"bsjx","explanation":"指避开敌人的主力，找敌人的弱点进攻。又指谈问题回避要害。","source":{"text":"兵之形，避实而击虚。","book":"《孙子·虚实》"},"example":{"text":"但执笔之际，～，顾彼忌此，实在气闷。","book":"鲁迅《致台静农》"},"similar":["避重就轻","避难就易","声东击西"],"opposite":["以卵击石","飞蛾投火"],"usage":"作谓语、宾语、定语；用于军事方面","story":["公元前623年，晋楚在城濮交战，晋文公采用避实就虚的作战方法，避免与楚军的中军主力决战，先令其下军向楚右军进攻，因为楚右军是由陈、蔡两国军队组成的弱势部队，一举取胜。晋军主将狐毛又用计诱歼了楚左军，最终取得重大胜利"]},{"id":44373,"word":"避害就利","pinyin":"bì hài jiù lì","abbr":"bhjl","explanation":"就：接近、走向。躲开有害的，接近有利的条件。","source":{"text":"谋者，所以避害就利。","book":"《吴子·图国第一》"},"similar":["趋利避害"],"usage":"作谓语、宾语；用于处事"},{"id":44374,"word":"避强击弱","pinyin":"bì qiáng jī ruò","abbr":"bqjr","explanation":"军事用语。在运动战中避开敌人的精锐部队而专拣疲弱的打。","source":{"text":"见“避强击惰”。"},"example":{"text":"凡攻取之道，必先其易者……奔走之间，可以知其虚实强弱，然后避实击虚，～。","book":"《资治通鉴·后周世宗显德二年》"},"similar":["避实击虚","避强打弱"],"usage":"作谓语、定语；用于军事等"},{"id":44375,"word":"避强击惰","pinyin":"bì qiáng jī duò","abbr":"bqjd","explanation":"军事用语。在运动战中避开敌人的精锐部队而专拣疲弱的打。","source":{"text":"卿宜密运谟猷，明宣号令，避强击惰，取暴抚羸。","book":"唐·元稹《批刘悟谢上表》"},"similar":["避强击弱"],"usage":"作谓语、定语；用于军事等"},{"id":44376,"word":"避强打弱","pinyin":"bì qiáng dǎ ruò","abbr":"bqdr","explanation":"军事用语。在运动战中避开敌人的精锐部队而专拣疲弱的打。","source":{"text":"见“避强击惰”。"},"example":{"text":"运动战的实行方面，问题是很多的，例如……～，围城打援、佯攻、防空、处在几个敌人之间、超越敌人作战……等等。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["避强击弱","避强击惰"],"usage":"作谓语、定语；用于军事等"},{"id":44377,"word":"避影匿形","pinyin":"bì yǐng nì xíng","abbr":"bynx","explanation":"指隐蔽起来，不露形迹。","source":{"text":"昔人所谓非亲非故，何由习知之也。此二者已当不同观，而况于避影匿形，惟恐多此一举，为身累者乎？","book":"清·侯方域《南省试策二》"},"similar":["避影敛迹"],"usage":"作谓语、宾语；指隐藏自己"},{"id":44378,"word":"避影敛迹","pinyin":"bì yǐng liǎn jì","abbr":"bylj","explanation":"指隐蔽起来，不露形迹。","source":{"text":"已而敷畅折衷，隐情遁节，如镱见象，奸民未尝不避影敛迹也。","book":"宋·叶適《刘建翁墓志铭》"},"similar":["避影匿形"],"usage":"作谓语、宾语；指隐藏自己"},{"id":44379,"word":"避李嫌瓜","pinyin":"bì lǐ xián guā","abbr":"blxg","explanation":"以之表示避免嫌疑。","source":{"text":"君子防未然，不处嫌疑间。瓜田不纳履，李下不整冠。","book":"三国·魏·曹植《君子行》"},"example":{"text":"他正气邪难犯，咱贞魂死不差。还只为守宫闱，～。","book":"清·杨潮观《信陵君义葬金钗》"},"similar":["避瓜防李"],"usage":"作宾语、定语；指避免嫌疑"},{"id":44380,"word":"避毁就誉","pinyin":"bì fuǐ jiù yù","abbr":"bhjy","explanation":"回避诋毁而追求称誉。","source":{"text":"且翟（墨翟）闻之：‘为义非避毁就誉。’支之苟道，受枉何伤？","book":"《墨子·耕柱》"},"usage":"作谓语、定语；指追求有利的东西"},{"id":44381,"word":"避溺山隅","pinyin":"bì nì shān yú","abbr":"bnsy","explanation":"指防止淹死而躲入山隅。表示远远回避。","source":{"text":"譬于防火水中，避溺山隅，此乃未见其可欲。","book":"汉·司马相如《美人赋》"},"example":{"text":"下官不能～，而止冠李下，既贻疵辱，方致微绳，解箓收簪，旦归初服。","book":"《梁书·王僧孺传》"},"usage":"作谓语、定语；指远远避开"},{"id":44382,"word":"避烦斗捷","pinyin":"bì fán dòu jié","abbr":"bfdj","explanation":"指避开烦难而比赛简捷。","source":{"text":"惟小楷试贴，一望可知优劣，不能无偏重之势，避烦斗捷，流风相师，久之而考者阅者，皆忘其所以然。","book":"清·薛福成《选举论下》"},"opposite":["不厌其烦"],"usage":"作谓语；指力求简捷"},{"id":44383,"word":"避瓜防李","pinyin":"bì guā fáng lǐ","abbr":"bgfl","explanation":"表示避免嫌疑。","source":{"text":"见“避李嫌瓜”。"},"example":{"text":"我和他呵，～，终朝相对如宾。","book":"清·李渔《慎鸾交·赠妓》"},"similar":["避李嫌瓜"],"usage":"作宾语、定语；指避免嫌疑"},{"id":44384,"word":"避祸就福","pinyin":"bì huò jiù fú","abbr":"bhjf","explanation":"避开凶险，趋向幸福。","source":{"text":"万民皆知所避就，避祸就福，而皆以自治也。","book":"战国·卫·商鞅《商君书·定分》"},"example":{"text":"我们要以～的方针来对待这个问题。"},"similar":["避祸求福"],"usage":"作谓语、定语；指避免灾祸"},{"id":44385,"word":"避祸求福","pinyin":"bì huò qiú fù","abbr":"bhqf","explanation":"指避开灾祸而求取幸福。","source":{"text":"臣不敢畏惮强御，避祸求福，与进（何进）合图，事无违异。","book":"《后汉书·袁绍传》"},"example":{"text":"清·褚人获《隋唐演义》第93回：“及至临大节、当危难，便把这两个字撇过一边了，只要全躯保家，～。”"},"similar":["避祸就福"],"usage":"作谓语、定语；指避免灾祸"},{"id":44386,"word":"避穽入坑","pinyin":"bì jǐng rù kēng","abbr":"bjrk","explanation":"穽，同“阱”。比喻躲过一害，又受一害。同“避坑落井”。"},{"id":44387,"word":"避繁就简","pinyin":"bì fán jiù jiǎn","abbr":"bfjj","explanation":"避开繁杂的，从事简单的。"},{"id":44388,"word":"避而不谈","pinyin":"bì ér bù tán","abbr":"bebt","explanation":"躲避开而不肯说。指有意回避事实。","source":{"text":"尖锐的矛盾，避而不谈，或加水冲淡了。","book":"徐迟《一九五六年序言》"},"example":{"text":"他只交待了一些多吃多占的小事儿，对贪污受贿的问题，却～。"},"similar":["守口如瓶","退避三舍"],"opposite":["口若悬河","滔滔不绝"],"usage":"作谓语、定语；形容有意避开话题不谈"},{"id":44389,"word":"避让贤路","pinyin":"bì ràng xián lù","abbr":"brxl","explanation":"避让：辞职的谦词；贤路：贤才仕进路。辞官退隐，让有才能的出来做事。","source":{"text":"愿归丞相侯印，乞骸骨归，避贤者路。","book":"《史记·万石张叔列传》"},"opposite":["尸位素餐"],"usage":"作谓语；指人让贤"},{"id":44390,"word":"避迹藏时","pinyin":"bì jì cáng shí","abbr":"bjcs","explanation":"指逃避时世。","source":{"text":"而君崎岖险阻，避迹藏时。","book":"唐·贾至《微子庙碑颂》"},"usage":"作谓语、定语；指逃避时世"},{"id":44391,"word":"避迹违心","pinyin":"bì jì wéi xīn","abbr":"bjwx","explanation":"指违背本意而隐匿。","source":{"text":"其为荆公与非荆公，亦难逃后世之公，某万不敢避迹违心，以负兄夙所教督之意。","book":"清·陈确《答张考夫书》"},"usage":"作谓语、定语；指违心隐居"},{"id":44392,"word":"避重就轻","pinyin":"bì zhòng jiù qīng","abbr":"bzjq","explanation":"指回避重的责任，只拣轻的来承担。也指回避要点，只谈无关紧要的事情。","source":{"text":"民始不以多男为患，父子始不以避重就轻相去。","book":"唐·李林甫《唐六典·工部尚书》：“技能功巧者，不得隐巧补拙，避重就轻。”宋·刘挚《侍御史黄君墓志铭》"},"example":{"text":"恐将来弄出大祸，所以借了一件失察的事情参的，倒是～的意思，也未可知。","book":"清·曹雪芹《红楼梦》第一百二回"},"similar":["避难就易","避实就虚"],"opposite":["避实击虚","知难而进"],"usage":"作谓语、定语、状语；指避开重大问题与责任"},{"id":44393,"word":"避重逐轻","pinyin":"bì zhòng zhú qīng","abbr":"bzzq","explanation":"指避开较重的责任，拣轻的承担。","source":{"text":"见“避重就轻”。"},"example":{"text":"各站额设车正贴人户，有近上富有实，有丁力站户，～，或弟或兄，擅自将本户分房家口。","book":"《元典章·兵部三·站户别投户事》"},"similar":["避重就轻","拈轻怕重"],"opposite":["知难而进"],"usage":"作谓语、定语、状语；指避开重大问题与责任"},{"id":44394,"word":"避阱入坑","pinyin":"bì jǐng rù kéng","abbr":"bjrk","explanation":"指避过了井，又掉进了坑里。比喻避去一害，又受另一害。阱，异“穽”。","source":{"text":"汉·焦赣《易林·观之益》：“避阱入坑，忧患日生。”一本作“避井入坎”。"},"similar":["避井入坎","避坑落井"],"usage":"作谓语、宾语、定语；形容人不能避免受害"},{"id":44395,"word":"避难就易","pinyin":"bì nán jiù yì","abbr":"bnjy","explanation":"就：凑近，靠近。躲开难的，去找容易的做。也指做事情先从容易的做起。","source":{"text":"大都总管刘原仁称疾，久不视事，及迁同知储政院事，即就职，侥幸巧宦避难就易。","book":"《元史·文宗本纪》四"},"example":{"text":"有些地方你的确说出了我的弱点，比如你说我～地在手法上取巧。","book":"巴金《生之忏悔·我的自剖》"},"similar":["避难趋易"],"usage":"作谓语、定语；指回避困难"},{"id":44396,"word":"避难趋易","pinyin":"bì nán qiù yì","abbr":"bnqy","explanation":"指避开困难的而拣容易的做。","source":{"text":"见“避难就易”。"},"example":{"text":"这就因为以前不承认简体字的合法地位的原故，因为群众写字的习惯总是～的。","book":"《人民日报》1955.6.1"},"similar":["避难就易"],"usage":"作谓语、定语；指回避困难"},{"id":44397,"word":"避难逃灾","pinyin":"bì nàn táo zāi","abbr":"bntz","explanation":"避：躲开。逃脱灾害侵袭，避免罹难之祸。","source":{"text":"争奈宋江出身微贱，郓城小吏，犯罪在逃，权居梁山水泊，避难逃灾。","book":"明·施耐庵《水浒传》第85回"},"similar":["逃灾避难"],"usage":"作谓语、宾语；指逃避灾难"},{"id":44398,"word":"避面尹邢","pinyin":"bì miàn yǐn xíng","abbr":"bmyx","explanation":"以之比喻因嫉妒而避不见面。","source":{"text":"汉武帝同时宠幸尹夫人与邢夫人，诏二人不得相见。尹夫人向武帝请求见邢夫人。相见后，尹夫人“乃低头俯而泣，自痛其不如也”。见《史记·外戚世家》。"},"example":{"text":"这等一个人，便在宦途世路上遇着了还不免弄成个～，怎的肯引他作同心管鲍？","book":"《儿女英雄传》第二七回"},"similar":["尹邢避面"],"usage":"作宾语、定语；多用于女性间","story":["西汉时期，汉武帝同时宠幸尹夫人和邢夫人，对他们照顾有加。为了避免她们互相倾轧，下诏书让她们不得见面。后来尹夫人请求汉武帝让她见一见邢夫人，汉武帝考虑再三同意了她的要求。相见后，尹夫人低头痛苦，自叹不如邢夫人"]},{"id":44399,"word":"避风港","pinyin":"bì fēng gǎng","abbr":"bfg","explanation":"一种无装卸设备、在暴风雨时使船只得到掩护的港口。比喻一块可以躲避危险的地方。","example":{"text":"你总不能一辈子把医院作为～吧。"},"similar":["避难所"],"usage":"作宾语、定语；多用于比喻句"},{"id":44400,"word":"邀功希宠","pinyin":"yāo gōng xī chǒng","abbr":"ygxc","explanation":"求取功名和宠信。","source":{"text":"苟以迎驾为名，自可邀功希宠。","book":"明·王琼《双溪杂记》"},"usage":"作谓语、定语；用于书面语"},{"id":44401,"word":"邀功求赏","pinyin":"yāo gōng qiú shǎng","abbr":"ygqs","explanation":"求取功劳和奖赏。","source":{"text":"本无运虑深谋，意在邀功求赏。","book":"唐·韩愈《黄家贼事宜状》"},"example":{"text":"州北乡团练不～，如此役也。","book":"王闿运《桂阳陈侍郎行状》"},"usage":"作谓语；指求取功劳和奖赏"},{"id":44402,"word":"邀功讨好","pinyin":"yāo gōng tǎo hǎo","abbr":"ygth","explanation":"指为得到好感或讨人喜欢而去迎合某人。","source":{"text":"另外，他对自己更不满意的是，他的行为看来似乎是向少安一家人邀功讨好一般！","book":"路遥《平凡的世界》第一卷第15章"},"usage":"作谓语、宾语、定语；用于处事"},{"id":44403,"word":"邀功请赏","pinyin":"yāo gōng qǐng shǎng","abbr":"ygqs","explanation":"邀：希求。拿着功劳去请求奖赏。","source":{"text":"本无远虑深谋，意在邀功求赏。","book":"唐·韩愈《黄家贼事宜状》"}},{"id":44404,"word":"邀名射利","pinyin":"yāo míng shè lì","abbr":"ymsl","explanation":"指求取名利。","source":{"text":"世人不终耆寿，咸多夭殁者，皆由不自爱惜，忿争尽意，邀名射利，聚毒攻神，内伤骨体，外乏筋肉。","book":"《云笈七签》卷三二"},"similar":["追名逐利"],"usage":"作谓语、宾语、定语；用于处事"},{"id":44405,"word":"邂逅不偶","pinyin":"xiè hòu bù ǒu","abbr":"xhbo","explanation":"碰巧不遇合；意外不成功。","source":{"text":"荆柯入秦之计，本欲劫秦王生致于燕，邂逅不偶，为秦所擒。","book":"汉·王充《论衡·定贤》"},"example":{"text":"夫亲遇明主，干说悟意，九筵之室可陛而登，屡省之歌可飏而赓也，尚～；况一夫之取舍，何足动心乎！","book":"宋·叶適《陈秀伯墓志铭》"},"usage":"作谓语、定语；用于处事"},{"id":44406,"word":"邂逅相逢","pinyin":"xiè hòu xiāng féng","abbr":"xhxf","explanation":"不期而遇。","source":{"text":"长记那回时邂逅相逢，郊外驻油壁。","book":"宋·周邦彦《应天长》词"},"example":{"text":"谁知恰好遇见贤侄。～，真是‘万里他乡遇故知’可谓三生有幸！","book":"清·李汝珍《镜花缘》第十回"},"similar":["邂逅相遇"],"usage":"作谓语、定语；指无意中相遇"},{"id":44407,"word":"邂逅相遇","pinyin":"xiè hòu xiāng yù","abbr":"xhxy","explanation":"邂逅：未约而相逢。指无意中相遇。","source":{"text":"有美一人，清扬婉兮。邂逅相遇，适我愿兮。","book":"《诗经·郑风·野有蔓草》"},"example":{"text":"这两个～的老朋友就站在路旁谈了起来。"},"similar":["不期而遇","萍水相逢"],"opposite":["不欢而散"],"usage":"作谓语、定语；指无意中相遇"},{"id":44408,"word":"邈以山河","pinyin":"miǎo yǐ shān hé","abbr":"mysh","explanation":"形容遥远得如隔山河。同“邈若山河”。","source":{"text":"而断金之谊，遂邈以山河，可云悲哉！","book":"清·谭嗣同《邹砚铭叙》"},"similar":["邈若山河"],"usage":"作谓语、定语；指非常遥远"},{"id":44409,"word":"邈处欿视","pinyin":"miǎo chǔ jī shì","abbr":"mcks","explanation":"指处世淡泊，视事谦逊。","source":{"text":"君亦邈处欿视，若韦布然，于是益以见君之贤云。","book":"明·李东阳《翰林伦封君墓表》"},"usage":"作谓语、定语；用于处世"},{"id":44410,"word":"邈处歬视","pinyin":"miǎo chǔ jī shì","abbr":"mcjs","explanation":"指处世淡泊，视事谦逊。"},{"id":44411,"word":"邈如旷世","pinyin":"miǎo rú kuàng shì","abbr":"mrks","explanation":"仿佛隔了久远的年代。","source":{"text":"距今只二十余年，惟以工员四散，军兴多故，遂邈如旷世，知之者绝少。","book":"清·冯桂芬《致李伯相书》"},"usage":"作谓语；指时间久远"},{"id":44412,"word":"邈若山河","pinyin":"miǎo ruò shān hé","abbr":"mrsh","explanation":"形容遥远得如隔山河。","source":{"text":"自嵇生夭阮公亡以来，便为时所羁绁，今日视此虽近，邈若山河。","book":"南朝·宋·刘义庆《世说新语·伤逝》"},"example":{"text":"昔君梦奠之时，值余置在丛棘。狱户咫尺，～，话言空存。","book":"唐·陈子昂《祭韦府君文》"},"similar":["邈若河山"],"opposite":["近在咫尺"],"usage":"作谓语、定语；指非常遥远"},{"id":44413,"word":"邈若河山","pinyin":"miǎo ruò hé shān","abbr":"mrhs","explanation":"形容遥远得如隔山河。同“邈若山河”。","source":{"text":"今近在咫尺，而邈若河山，恨何如也！","book":"清·蒲松龄《聊斋志异·鲁公女》"},"similar":["邈若山河","邈以山河"],"opposite":["近在咫尺"],"usage":"作谓语、定语；指非常遥远"},{"id":44414,"word":"邈若河汉","pinyin":"miǎo ruò hé hàn","abbr":"mrhh","explanation":"形容奇异怪诞之极。","source":{"text":"墨憨氏补辑《新平妖传》，奇奇怪怪，邈若河汉，海内惊为异书。","book":"明·可观道人《序》"},"usage":"作谓语、定语；指怪异"},{"id":44415,"word":"邋邋遢遢","pinyin":"lā lā tā tā","abbr":"lltt","explanation":"指人肮脏不整洁。","source":{"text":"裹一项油油腻腻旧头巾，穿一领邋邋遢遢泼戏袄。","book":"明·施耐庵《水浒传》第82回"},"example":{"text":"润叶见到丽丽后，看见他穿得～，拖着拖鞋，一边抽烟，一边在房子里走来走去。","book":"路遥《平凡的世界》第五卷第27章"},"similar":["邋里邋遢"],"opposite":["整整洁洁"],"usage":"作定语、状语；用于口语"},{"id":44416,"word":"邑犬群吠","pinyin":"yì quǎn qún fèi","abbr":"yqqf","explanation":"邑：乡邑。乡邑的狗群起吠叫。比喻庸人对不理解的观点进行群起攻击。","source":{"text":"邑犬群吠兮，吠所怪也。","book":"战国·楚·屈原《九章·怀沙》"},"usage":"作宾语、定语；指攻击别人"},{"id":44417,"word":"邑邑不乐","pinyin":"yì yì bù lè","abbr":"yybl","explanation":"邑邑：发愁的样子。形容心里苦闷，很少言笑。","source":{"text":"暕为尚书左丞仆射，当朝用事，骞自中书令为郡，邑邑不乐，在郡卧不视事。","book":"《南史·昙首传》"},"example":{"text":"宫中数见妖孽，帝春秋高，意～，中官因诈饰以娱之。","book":"《明史·王金传》"}},{"id":44418,"word":"邦以民为本","pinyin":"bāng yǐ mín wéi běn","abbr":"bymwb","explanation":"古代儒家民本思想的一种反映，认为万民百姓是国家的根本。治国应以安民、得民作为根本。","source":{"text":"民惟邦本，本固邦宁。","book":"《尚书·五子之歌》"},"example":{"text":"～，鱼饥费香饵。","book":"唐·杜甫《送顾八分文学适洪吉州》"},"similar":["民惟邦本"],"usage":"作宾语、定语；用于劝诫"},{"id":44419,"word":"邦国殄瘁","pinyin":"bāng guó tiǎn cuì","abbr":"bgtc","explanation":"殄：尽，绝；瘁：病。形容国家病困，陷于绝境。","source":{"text":"人之云亡，邦国殄瘁。","book":"《诗经·大雅·瞻印》"},"example":{"text":"宁使人材蛰伏，～，而必不可使一党不居于势要者。","book":"清·章炳麟《致张继、于右任书》"},"usage":"作宾语；指国家病困"},{"id":44420,"word":"邦家之光","pinyin":"bāng jiā zhī guāng","abbr":"bjzg","explanation":"邦：诸侯国；家：大夫的封地。指国家的光荣。","source":{"text":"乐只君子，邦家之光。","book":"《诗经·小雅·南山有台》"},"usage":"作主语、宾语；指国家的光荣"},{"id":44421,"word":"邪不伐正","pinyin":"xié bù fá zhèng","abbr":"xbfz","explanation":"指邪妖之法不能压倒刚正之气。同“邪不犯正”。","source":{"text":"夫妖不胜德，邪不伐正，天之经也。","book":"汉·王符《潜夫论·巫列》"},"similar":["邪不敌正","邪不犯正","邪不压正"],"usage":"作定语、宾语；指正义战胜邪恶"},{"id":44422,"word":"邪不压正","pinyin":"xié bù yā zhèng","abbr":"xbyz","explanation":"邪：邪气，指不正派的人或事；不正当的、不正派的压不倒正当的、正派的事物。","source":{"text":"此邪法也，臣闻邪不干正，若使咒臣，必不能行。","book":"唐·韦洵《刘宾客嘉话录》"},"example":{"text":"真是～，我们终于胜利了。"},"similar":["邪不干正"],"usage":"作谓语、宾语、分句；指正义战胜邪恶"},{"id":44423,"word":"邪不干正","pinyin":"xié bù gān zhèng","abbr":"xbgz","explanation":"邪恶的压不倒正派刚正的事物。","source":{"text":"臣闻邪不干正，若使咒臣，必不能行。","book":"宋·王谠《唐语林·方正》"},"example":{"text":"～，妖不胜德。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录四》"},"similar":["邪不犯正"],"usage":"作定语、宾语、分句；指正义战胜邪恶"},{"id":44424,"word":"邪不敌正","pinyin":"xié bù dí zhèng","abbr":"xbdz","explanation":"犹言邪不犯正。指邪妖之法不能压倒刚正之气。","source":{"text":"邪不敌正，理固然也。","book":"清·和邦额《夜谭随录·庄攈松》"},"similar":["邪不胜正","邪不干正","邪不压正"],"usage":"作定语、宾语；指正义战胜邪恶"},{"id":44425,"word":"邪不犯正","pinyin":"xié bù fàn zhèng","abbr":"xbfz","explanation":"指邪妖之法不能压倒刚正之气。亦作“邪不伐正”。","source":{"text":"臣闻邪不犯正，若使咒臣，必不得行。","book":"唐·刘束《隋唐嘉话》中卷"},"similar":["邪不伐正","邪不胜正","邪不压正"],"usage":"作定语、宾语；指正义战胜邪恶"},{"id":44426,"word":"邪不胜正","pinyin":"xié bù shèng zhèng","abbr":"xbsz","explanation":"犹言邪不犯正。指邪妖之法不能压倒刚正之气。","source":{"text":"此邪法也，臣闻邪不干正，若使咒臣，必不能行。","book":"唐·韦洵《刘宾客嘉话录》"},"example":{"text":"毕竟～，闹来闹去，往往狻猊、鹔鹴大败而归。","book":"清·李汝珍《镜花缘》第二十回"},"similar":["邪不犯正","邪不压正","邪不敌正"],"usage":"作定语、宾语；指正义战胜邪恶"},{"id":44427,"word":"邪书僻传","pinyin":"xié shū pì zhuàn","abbr":"xspc","explanation":"淫邪不正的书籍，冷僻怪异的传记。指内容荒诞不经的书籍。","source":{"text":"如今稍知些事，又看了些邪书僻传，凡远亲近友之家所见的那些闺英闱秀，皆未有稍及黛玉者，所以早存一段心事，只不好说出来。","book":"清·曹雪芹《红楼梦》第二十九回"},"usage":"作主语、宾语、定语；指坏书等"},{"id":44428,"word":"邪神野鬼","pinyin":"xié shén yě guǐ","abbr":"xsyg","explanation":"迷信指流散的鬼神。多比喻不务正业，到处游逛，寻事生非的人。","source":{"text":"人说门前撒下一把灰，那邪神野鬼便不敢进来。","book":"元·无名氏《盆儿鬼》第三折"},"example":{"text":"你不来家，不着我破死拉活把拦着这点子家事，～都要分一股子哩！","book":"清·西周生《醒世姻缘传》第七十六回"},"similar":["闲神野鬼"],"usage":"作宾语、定语；用于比喻句"},{"id":44429,"word":"邪说异端","pinyin":"xié shuō yì duān","abbr":"xsyd","explanation":"指和正统思想不同的有害的思想观点或言论学说。","source":{"text":"若异端邪说释老之学。","book":"《论语·为政》：“攻乎异端，斯害也已。”宋·朱熹《朱子语类·论语》"},"example":{"text":"因为她母亲认为男女平等是～，是从维新派的文章里学来的。","book":"林语堂《京华烟云》第十一章"},"similar":["异端邪说"],"usage":"作主语、宾语、定语；指坏的言论"},{"id":44430,"word":"邪门歪道","pinyin":"xié mén wāi dào","abbr":"xmwd","explanation":"指不正当的门路、手段或不正经的事情。","source":{"text":"又信世间邪魔外道，妖孽之师，妄说祸福。","book":"《药师经》"},"example":{"text":"你不能老搞～。"},"similar":["歪风邪气","旁门左道"],"opposite":["光明正大","光明磊落"],"usage":"作主语、宾语、定语；指不正当的门路"},{"id":44431,"word":"邪魔外祟","pinyin":"xié mó wai suì","abbr":"xmws","explanation":"指邪恶的鬼怪。","source":{"text":"只是人自己疑心，所以招出一些邪魔外祟来缠扰。","book":"清·曹雪芹《红楼梦》第109回"},"example":{"text":"清·文康《儿女英雄传》第五回：“要是你自己个儿招些～来弄的受了累，那我可全不知道。”"},"similar":["妖魔鬼怪"],"usage":"作宾语、定语；用于书面语"},{"id":44432,"word":"邪魔外道","pinyin":"xié mó wài dào","abbr":"xmwd","explanation":"佛教用语。指妨害正道的邪说和行为。比喻不符合正统思想的主张或教义。也比喻妖精鬼怪或品行不端的人。","source":{"text":"又信世间邪魔外道、妖孽之师，妄说祸福。","book":"《药师经》"},"example":{"text":"若是八股文章欠讲究，任你做出甚么来，都是野狐禅，～。","book":"清·吴敬梓《儒林外史》第十一回"},"similar":["旁门左道","邪门歪道"],"opposite":["光明磊落"],"usage":"作主语、宾语、定语；指不正统的学说","story":["贾宝玉放下书本跑到贾母那里，刚好贾母与王熙凤等在谈论邪魔外道。贾宝玉立即接话说当年赵姨娘请人做法让他和王熙凤一起中邪生病的事情。王熙凤说：“我也不很记得了。但觉自己身子不由自主，倒象有什么人，拉拉扯扯，要我杀人才好。”"]},{"id":44433,"word":"邪魔怪道","pinyin":"xié mó guài dào","abbr":"xmgd","explanation":"犹言邪魔歪道。指不正当的言行或途径。","source":{"text":"你看《禹贡》上面，何尝有一点这种邪魔怪道的话，他却实实在在把水治平了。","book":"清·吴趼人《二十年目睹之怪现状》第68回"},"similar":["邪魔歪道"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44434,"word":"邪魔歪道","pinyin":"xié mó wāi dào","abbr":"xmwd","explanation":"指不正当的言行或途径。","source":{"text":"邪魔歪道弄来的东西，咱不稀罕！","book":"孔厥《新儿女英雄传》第一回"},"similar":["邪魔怪道"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44435,"word":"邯郸匍匐","pinyin":"hán dān pú fú","abbr":"hdpf","explanation":"邯郸：战国时赵国的都城；学步：学习走路。比喻模仿人不到家，反把原来自己会的东西忘了。","source":{"text":"且子独不闻夫寿陵余子之学行于邯郸与？未得国能，又失其故行矣，直匍匐而归耳。","book":"《庄子·秋水》"},"example":{"text":"半臂添寒尚书醉，屏后金钗楚楚，齐俯首～。","book":"清·梁绍任《两般秋雨庵随笔》卷一"},"similar":["鹦鹉学舌","东施效颦","数典忘祖"],"opposite":["标新立异","独辟蹊径","择善而长"],"usage":"作定语、宾语、分句；指盲目崇拜的人","story":["战国时期，赵国国都邯郸人走路姿势非常优美与潇洒，外地人很赞赏和羡慕。燕国寿陵一个少年，特别迷恋邯郸人走路的姿态，竟专门到邯郸学习，他非常用心观摩、效仿、练习，过了一段时间，他没学会他们走路的姿态，连自己的也全忘了"]},{"id":44436,"word":"邯郸学步","pinyin":"hán dān xué bù","abbr":"hdxb","explanation":"邯郸战国时赵国的都城；学步学习走路。比喻模仿人不到家，反把原来自己会的东西忘了。","source":{"text":"且子独不闻夫寿陵余子之学行于邯郸与？未得国能，又失其故行矣，直匍匐而归耳。","book":"《庄子·秋水》"},"similar":["东施效颦"],"opposite":["独辟蹊径","择善而从"],"usage":"多用于贬义。","notice":"“邯郸学步”和“东施效颦”都有胡乱效仿、生搬硬套之意。但是“邯郸学步”还有模仿别人的，将自己的忘掉之意；而“东施效颦”比喻不了解人家的长处在哪里，也不考虑自己的条件盲目仿效。"},{"id":44437,"word":"邯郸梦","pinyin":"hán dān mèng","abbr":"hdm","explanation":"邯郸：古赵国都城。比喻虚幻不能实现的梦想。","source":{"text":"中年许国邯郸梦，晚岁还家圹埌游。","book":"宋·王安石《中年》诗"},"similar":["黄粱梦","黄粱一梦"],"usage":"作主语、宾语、定语；指不能实现的梦想","story":["从前有一个穷困潦倒的书生卢生，在邯郸一个客店遇见道士吕翁。吕翁送他一个枕头，这时店主正开始做黄粱饭，卢生小睡一会，在梦中他中进士做宰相娶美妻，儿孙满堂，生活美满。梦醒后，主人的黄粱饭都还没做熟"]},{"id":44438,"word":"邯郸重步","pinyin":"hán dān zhóng bù","abbr":"hdcb","explanation":"比喻进入梦乡。","source":{"text":"唐·沈既济《枕中记》载：卢生在邯郸客店中遇道士吕翁，目昏思睡，吕翁授以青瓷枕，卢生进入梦乡，历尽富贵荣华。及醒，店主炊黄粱未熟。"},"example":{"text":"[阿松]谓曰：‘请母安眠也。’母唯唯应，其音模糊，亡何而～矣。","book":"叶圣陶《穷愁》"},"similar":["邯郸学步","邯郸匍匐"],"usage":"作定语、宾语、分句；指盲目崇拜的人","story":["战国时期，赵国国都邯郸人走路姿势非常优美与潇洒，外地人很赞赏和羡慕。燕国寿陵一个少年，特别迷恋邯郸人走路的姿态，竟专门到邯郸学习，他非常用心观摩、效仿、练习，过了一段时间，他没学会他们走路的姿态，连自己的也全忘了"]},{"id":44439,"word":"邹缨齐紫","pinyin":"zōu yīng qí zǐ","abbr":"zyqz","explanation":"邹缨：春秋时邹国国君系在脖子上的帽带；齐紫：春秋时齐国国君穿的紫色服装。比喻上行下效。","source":{"text":"齐桓公好服紫，一国尽服紫，当是时也，五素不得一紫。”又“邹君好服长缨，左右皆服长缨，缨甚贵。","book":"《韩非子·外储说左上》"},"example":{"text":"是以～，且以移俗。","book":"《南史·儒林传论》"},"similar":["上行下效"],"usage":"作宾语、定语；指上行下效","story":["春秋时期，齐桓公喜欢穿紫色的衣服，于是全国人民都穿紫色衣服，在当时五件素色衣服还换不到一件紫色的衣服。有人建议齐桓公改穿其他颜色的衣服，齐桓公说他讨厌紫色，于是第二天大夫们都不穿紫色衣服了，再过几天全国都不穿紫色了"]},{"id":44440,"word":"邹衍谈天","pinyin":"zōu yǎn tán tiān","abbr":"zytt","explanation":"比喻善辩。邹，通“驺”。","source":{"text":"驺衍之术迂大而闳辩；奭也文具难施……故齐人颂曰：‘谈天衍，雕龙奭。’","book":"《史记·孟子荀卿列传》"},"example":{"text":"张华博物身终死，～舌竟体。","book":"元·袁桷《观物》诗"},"usage":"作宾语、定语；用于书面语"},{"id":44441,"word":"邹鲁遗风","pinyin":"zōu lǔ yí fēng","abbr":"zlyf","explanation":"孔子是鲁人，孟子是邹人，故以“邹鲁遗风”指孔孟遗留下来的儒家风气。","source":{"text":"吾闻仁者有勇，今见勇者有仁，可谓邹鲁遗风，英贤不绝。","book":"《梁书·羊侃传》"},"usage":"作宾语、定语；用于书面语"},{"id":44442,"word":"邺架之藏","pinyin":"yè jià zhī cáng","abbr":"yjzc","explanation":"对他人藏书的美称。","source":{"text":"邺侯家多书，插架三万轴。","book":"唐·韩愈《送诸葛觉往随州读书》诗"},"example":{"text":"清·顾炎武《与颜修来手札》：“如贵地友人家有～，欲一就观。”"},"usage":"作宾语；用于书面语"},{"id":44443,"word":"邻女窥墙","pinyin":"lín nǚ kuī qiáng","abbr":"lnkq","explanation":"战国时宋玉邻家有美女倾心于他，三年间常爬上墙头偷窥，但宋玉从未动心。后形容女子对男子的倾慕。","source":{"text":"然此女登墙窥臣三年，至今未许也。","book":"先秦·宋玉《登徒子好色赋》"}},{"id":44444,"word":"邻女詈人","pinyin":"lín nǚ lì rén","abbr":"lnlr","explanation":"比喻各为其主。詈，指“骂”。","source":{"text":"楚人有两妻者……，客曰：‘长者詈汝，少者报汝，汝何为取长者？’曰：‘居彼人之所，则欲其报我也；为我妻，则欲其为我詈人也。’","book":"《战国策·秦策一》"},"example":{"text":"夫跖犬吠尧，～，彼固各为其主。","book":"清邵长蘅《阎典史传》"},"similar":["各为其主"],"usage":"作谓语、定语；指各为其主","story":["战国时期楚国有一个人娶了两个老婆，别人去挑逗他的大老婆，被她骂了出来。转而就去挑逗与勾引他的小老婆，没想到小老婆主动接纳了他。有人问这个勾引别人老婆的人到底是喜欢那个大老婆还是小老婆，他回答说为妻者就得护夫"]},{"id":44445,"word":"邻父之疑","pinyin":"lín fù zhī yí","abbr":"lfzy","explanation":"邻父：指邻居的老年人。比喻那些心存偏见而喜欢主观用事的人。","source":{"text":"宋有富人，天雨坏墙，其子曰：‘不筑，必将有盗。’其邻人之父亦云。暮而果大亡其财。其家甚智其子，而疑邻人之父。此二人说者皆当矣，厚者为戮，薄者见疑。","book":"《韩非子·说难》"}},{"id":44446,"word":"邻里乡党","pinyin":"lín lǐ xiāng dǎng","abbr":"llxd","explanation":"周制1邻＝5家，1里＝5邻，1党＝500家，1乡＝12500家。泛称一乡的人。","source":{"text":"毋！以与你邻里乡党乎！","book":"春秋·鲁·孔丘《论语·雍世》"},"example":{"text":"其男口不盈八，而田过一井者，分予九族～。","book":"东汉·班固《汉书·王莽传上》"},"usage":"作主语、宾语；指邻居"},{"id":44447,"word":"郁垒神荼","pinyin":"yù lěi shēn shū","abbr":"ylst","explanation":"二神名，传说能治二鬼，后世奉为门神。指门神。","source":{"text":"于是黄帝乃作礼，以时驱之，立大桃人，门户画神荼郁垒与虎，悬苇索以御凶。","book":"《山海经新释》卷十二"},"example":{"text":"娇儿学作人间字，郁垒神荼写未真。","book":"宋·姜虁《鹧鸪天》词"}},{"id":44448,"word":"郁抑不申","pinyin":"yù yì bù shēn","abbr":"yybs","explanation":"郁抑：压抑；申：舒展。胸中压抑而得不到舒展。","source":{"text":"道轗轲而未遇，志郁抑而不申，愤激委约之中，飞文魏阙之下，奋迅泥滓，自致青云，振沈溺于一朝，流风声于千载，往往而有。","book":"《隋书·文学传》"},"opposite":["兴高彩烈"],"usage":"作谓语、定语；用于处事"},{"id":44449,"word":"郁肉漏脯","pinyin":"yù ròu lòu fǔ","abbr":"yrlp","explanation":"郁：腐臭；漏脯：古人认为肉为漏水所沾，有毒。形容腐臭的肉食。","source":{"text":"虽策命暂隆，弘赏暴集，无异乎牺牛之被纹绣，渊鱼之爱莽麦，渴者之资口于云日之酒，饥者之取饱于郁肉漏脯也。","book":"《抱朴子·良规》"},"example":{"text":"又次日，游木龙洞，洞甚狭，无火不能入，垂石乳如莲房半烂，又似～，离离可摘。","book":"清·袁枚《游桂林诸山记》"},"usage":"作宾语、定语；用于书面语"},{"id":44450,"word":"郁郁不乐","pinyin":"yù yù bù lè","abbr":"yybl","explanation":"郁郁：心里苦闷。闷闷不乐。","source":{"text":"伤情感物，郁郁不乐。","book":"唐·蒋防《霍小玉传》"},"example":{"text":"他那方寸之间，兀自～的，不晓得要怎样才好。","book":"蔡东藩、许廑父《民国通俗演义》第一二一回"},"similar":["闷闷不乐","怏怏不乐"],"opposite":["兴高采烈"],"usage":"作谓语、定语、补语；指人的心情"},{"id":44451,"word":"郁郁不得志","pinyin":"yù yù bù dé zhì","abbr":"yybdz","explanation":"郁郁：忧伤、愁闷的样子。因自己的抱负志向不能施展而忧郁苦闷。","source":{"text":"或因有才不售，郁郁不得志的。","book":"《快心编》第七回"}},{"id":44452,"word":"郁郁寡欢","pinyin":"yù yù guǎ huān","abbr":"yygh","explanation":"郁郁：发愁的样子；寡：少。形容心里苦闷。指闷闷不乐。","source":{"text":"心郁郁之忧思兮，独永叹乎增伤。","book":"战国楚·屈原《九章·抽思》"},"example":{"text":"在她给余永泽和王晓燕的信中充满了悲天悯人和～的情绪。","book":"杨沫《青春之歌》第一部第六章"},"similar":["忧心忡忡","忧心如焚","愁眉苦脸"],"opposite":["怡然自得","得意洋洋","得意忘形"],"usage":"作谓语、定语、补语；指人的心情"},{"id":44453,"word":"郁郁沉沉","pinyin":"yù yù chén chén","abbr":"yycc","explanation":"深广的样子。","source":{"text":"宋开禧丁柳，权臣韩侂胄诛死，刘淮叔通《咏韩家府》诗云：‘宝莲山下韩家府，郁郁沉沉深几许。’","book":"元·韦居安《梅磵诗话》卷上"}},{"id":44454,"word":"郁郁累累","pinyin":"yù yù lěi lěi","abbr":"yyll","explanation":"忧思不绝的样子。","source":{"text":"思念故乡，郁郁累累。","book":"《乐府诗集·杂曲歌辞二·悲歌》"},"usage":"作定语、状语；用于书面语"},{"id":44455,"word":"郁郁芊芊","pinyin":"yù yù qiān qiān","abbr":"yyqq","explanation":"犹言郁郁葱葱。①草木苍翠茂盛的样子。②气盛的样子。","source":{"text":"美哉国乎！郁郁芊芊。","book":"《列子·力命》"},"example":{"text":"以英雄忠义之气，～，积于笔墨间也。","book":"清·张岱《陶庵梦忆·水浒牌》"},"similar":["郁郁苍苍","郁郁葱葱"],"usage":"作定语、状语；用于书面语"},{"id":44456,"word":"郁郁苍苍","pinyin":"yù yù cāng cāng","abbr":"yycc","explanation":"犹言郁郁葱葱。草木苍翠茂盛的样子。","source":{"text":"仰视岩石松树，郁郁苍苍，如在云中。","book":"北魏·郦道元《水经注·汶水》"},"example":{"text":"左后方也有一座～的高山。","book":"魏巍《东方》第六部第一章"},"similar":["郁郁葱葱","郁郁芊芊"],"usage":"作定语、状语；用于书面语"},{"id":44457,"word":"郁郁葱葱","pinyin":"yù yù cōng cōng","abbr":"yycc","explanation":"形容草木苍翠茂盛。也形容气势美好蓬勃。","source":{"text":"望气者至南阳，曰：‘气佳哉，郁郁葱葱！","book":"汉·王充《论衡·吉验》：“城郭郁郁葱葱。”《后汉书·光武纪》"},"example":{"text":"远处是几个农村，丛树和屋舍密集重叠，大有～的气象。","book":"叶圣陶《游泳》"},"similar":["生机蓬勃","生意盎然","生气勃勃"],"opposite":["满目疮痍","赤地千里","枯木朽株"],"usage":"作谓语、定语、状语；形容气势"},{"id":44458,"word":"郁郁青青","pinyin":"yù yù qīng qīng","abbr":"yyqq","explanation":"形容香味浓烈，生机盎然的样子。","source":{"text":"芳年贵盛谁为比，郁郁青青岳顶松。","book":"唐·李频《贺同年翰林从叔舍人知制诰》"},"example":{"text":"至若春和景明，波澜不惊，上下天光，一碧万顷；沙鸥翔集，锦鳞游泳；岸芷汀兰，～。","book":"宋·范仲淹《岳阳楼记》"},"usage":"作谓语、定语；用于书面语"},{"id":44459,"word":"郊寒岛瘦","pinyin":"jiāo hán dǎo shòu","abbr":"jhds","explanation":"本指孟郊、贾岛简啬孤峭的诗歌风格。后用以形容诗文类似的意境。","source":{"text":"元轻白俗，郊寒岛瘦。","book":"宋·苏轼《祭柳子玉文》"},"example":{"text":"使其更悲，而其气仍壮，故能异于～，而与酸馅蔬笋者远矣。","book":"清·无名氏《杜诗言志》卷三"},"similar":["岛瘦郊寒"],"usage":"作宾语、定语；比喻穷酸相"},{"id":44460,"word":"郎不郎，秀不秀","pinyin":"láng bù láng，xiù bù xiù","abbr":"lblxbx","explanation":"比喻不成材，没出息。","source":{"text":"郎不郎时秀不秀，长衣一领遮前后。","book":"明·冯梦龙《醒世恒言》卷十七"},"example":{"text":"你这样人，种火又长，拄门又短，～。","book":"明·凌蒙初《初刻拍案惊奇》卷二十二"}},{"id":44461,"word":"郎前白发","pinyin":"láng qián bái fà","abbr":"lqbf","explanation":"当了很长时间的官，一直得不到提拔，头发都白了还是一个小官。比喻一直到白了都没有遇到一个好机会。","source":{"text":"上尝辇至郎署，见一老翁，须髯皓白，衣服不整。对曰：‘臣姓颜名驷，江都人也，以文帝时为郎。’","book":"汉·班固《汉武故事》"}},{"id":44462,"word":"郎才女姿","pinyin":"láng cái nǚ zī","abbr":"lcnz","explanation":"形容男女双方很相配。同“郎才女貌”。","source":{"text":"为郎才女姿，非是云邀雨期，这情踪傍人怎知？","book":"明·张凤翼《红拂记·掷家图国》"},"similar":["郎才女貌"],"usage":"作定语、宾语；指青年男女"},{"id":44463,"word":"郎才女貌","pinyin":"láng cái nǚ mào","abbr":"lcnm","explanation":"郎：旧指女子对丈夫或情人的称呼。男的有才气，女的有美貌。形容男女双方很相配。","source":{"text":"您两口子正是郎才女貌，天然配合。","book":"元·关汉卿《望乡亭》第一折"},"example":{"text":"夫人太过虑，小生空妄想，～合相仿。","book":"元·王实甫《西厢记》第一本第二折"},"similar":["才子佳人","郎才女姿"],"opposite":["无德无才"],"usage":"作定语、宾语；指青年男女"},{"id":44464,"word":"郐下无讥","pinyin":"kuài xià wú jī","abbr":"kxwj","explanation":"指微不足道。","source":{"text":"《郐》第十三，《曹》第十四。言季子闻此二国歌，不复讥论之，以其微也。","book":"《左传·襄公二十九年》：“吴公子札来聘……为之歌《陈》，曰‘国无主，其能久乎！’自《郐》以下无讥焉。”杜预注"},"example":{"text":"陈大樽《明诗选》于万历以下，如汤义仍、曹能始不愧作者，概置之～之列，此则大误。","book":"清·陈田《明诗纪事辛签·曹学佺》"},"similar":["自郐以下"],"usage":"作宾语、定语、分句；指不值一提","story":["春秋时期，吴国的公子季札自幼精通音乐，他访问鲁国时，鲁国请他欣赏周代的乐舞。鲁国的乐工演奏周王朝及各诸侯国的乐曲，对于各诸侯国的乐曲都有褒贬评论，但从演奏郐国的《郐风》以后，他就没有再表示意见了"]},{"id":44465,"word":"郑人买履","pinyin":"zhèng rén mǎi lǚ","abbr":"zrml","explanation":"用来讽刺只信教条，不顾实际的人。","source":{"text":"郑人有欲买履者，先自度其足，而置之其坐，至之市，而忘操之，已得履，乃曰：‘吾忘持度’。反归取之，及反，市罢，遂不得履。","book":"战国·韩·韩非《韩非子·外储说左上》"},"example":{"text":"你可千万不要学～。"},"similar":["生搬硬套","死搬教条"],"opposite":["随机应变","见机行事"],"usage":"作定语、状语；指办事机械","story":["从前有个郑国人想买一双鞋，就先在家里拿根绳子量好脚的尺寸，然后上街买鞋，他选好一双鞋想比比大小，发现量尺寸的绳子忘在家里，就赶忙回家去拿。等他拿回绳子，集市已经散了。有人说他怎么不用自己的脚试鞋呢，他只相信绳子"]},{"id":44466,"word":"郑人争年","pinyin":"zhèng rén zhēng nián","abbr":"zrzn","explanation":"年：年龄。比喻争论的事情既无根据，又无意义。","source":{"text":"郑人有相与争年者，一人曰：‘吾与尧同年。’其一人曰：‘我与黄帝之兄同年。’讼此而不决，以后息者为胜耳。","book":"《韩非子·外储说左上》"},"usage":"作宾语、定语；指瞎争论"},{"id":44467,"word":"郑人实履","pinyin":"zhèng rén shí lǚ","abbr":"zrsl","explanation":"郑人：春秋时期郑国人。履：鞋。郑国人买鞋。比喻只相信书本，不相信客观实际。多用以讽刺教条主义者。"},{"id":44468,"word":"郑卫之声","pinyin":"zhèng wèi zhī shēng","abbr":"zwzs","explanation":"郑卫：指春秋时的郑国和卫国。指春秋战国时郑、卫等国的民间音乐。因儒家认为其音淫靡，不同于雅乐，故斥之为淫声。","source":{"text":"郑卫之声，桑间之音，此乱国之所好，衰德之所说。","book":"《吕氏春秋·季夏纪》"},"example":{"text":"扬雄以为靡丽之赋，劝百而风一；犹骋～，曲终而奏雅，不已戏乎！（《汉书·司马相如传赞》）"},"similar":["郑卫之音","郑卫之曲"],"usage":"作宾语；指淫乐"},{"id":44469,"word":"郑卫之曲","pinyin":"zhèng wèi zhī qǔ","abbr":"zwzq","explanation":"郑卫：指春秋时的郑国和卫国。指春秋战国时郑、卫等国的民间音乐。因儒家认为其音淫靡，不同于雅乐，故斥之为淫声。","source":{"text":"故云雅颂之音理而民正，嘄噭之声兴而士奋，郑卫之曲动而心淫。","book":"《史记·乐书》"},"example":{"text":"臣闻秦王好淫声，华阳后为之不听～。（汉·荀悦《前汉纪·宣帝纪三》）"},"similar":["郑卫之声","郑卫之音"],"usage":"作宾语；指淫乐"},{"id":44470,"word":"郑卫之音","pinyin":"zhèng wèi zhī yīn","abbr":"zwzy","explanation":"郑卫：指春秋时的郑国和卫国。指春秋战国时郑、卫等国的民间音乐。","source":{"text":"郑卫之音，乱世之音也。","book":"西汉·戴圣《礼记·乐记》"},"example":{"text":"出入无得入茶房酒肆，市巷之语，～，未尝一经于耳。","book":"明·刘元卿《贤奕编·家闲》"},"similar":["郑卫之曲"],"usage":"作宾语；指淫乐"},{"id":44471,"word":"郑卫桑间","pinyin":"zhèng wèi sāng jiān","abbr":"zwsj","explanation":"郑卫：春秋时郑、卫二国；桑间：在濮水之上。指亡国之音。","source":{"text":"郑卫之音，乱世之音也，比于慢矣，桑间濮上之音，亡国之音也。","book":"《礼记·乐记》"},"example":{"text":"～，韶虞武象者，羿国之乐也。","book":"秦·李斯《上书秦始皇》"},"similar":["靡靡之音"],"usage":"作宾语、定语；用于书面语"},{"id":44472,"word":"郑声乱雅","pinyin":"zhèng shēng luàn yǎ","abbr":"zsly","explanation":"郑声：郑国的音乐。郑国靡乱的音乐扰乱了优雅的音乐。比喻邪扰乱了正。","source":{"text":"恶紫之夺朱也；恶郑声之乱雅乐也；恶利口之覆邦家者。","book":"《论语·阳货》"},"example":{"text":"七曰～。然朱紫有色而易别，雅、郑无象而难知，圣人惧其难知也，故定律吕中正之音，以示万世。（《宋史·乐志三》）"},"usage":"作宾语、定语；用于书面语"},{"id":44473,"word":"郑昭宋聋","pinyin":"zhèng zhāo sòng lóng","abbr":"zzsl","explanation":"杜预注：“昭，明也。聋，暗也。”比喻情况不同。","source":{"text":"楚子使申舟聘於齐，曰：‘无假道於宋。’亦使公子冯聘於晋，不假道於郑。申舟以孟诸之役恶宋，曰：‘郑昭宋聋，晋使不害，我则必死。’王曰：‘杀女，我伐之。’见犀而行。及宋，宋人止之……乃杀之。","book":"《左传·宣公十四年》"},"example":{"text":"～，一以免患，一以召祸。况各国竞骛于聪明，而我岸然自安其愚暗，将以求免，不亦难乎？","book":"康有为《上清帝第五书》"},"usage":"作宾语、定语；用于书面语","story":["春秋时期，楚王派申舟到齐国去缨聘告诫他不要从宋国经过，又派公子冯到晋国应聘要他不要从郑国经过。申舟因为孟诸之役而得罪宋国，他说：“郑昭宋聋，晋使不害，我则必死。”楚王说：“杀女，我伐之。”到了宋国，宋人拦住申舟并杀了他"]},{"id":44474,"word":"郑重其事","pinyin":"zhèng zhòng qí shì","abbr":"zzqs","explanation":"郑重：审慎，严肃认真。形容说话做事时态度非常严肃认真。","source":{"text":"所以郑重其事，必得三日后方进门。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"孙俊英背剪着手，～地在墙前站着看标语。","book":"冯德英《迎春花》第六章"},"similar":["一丝不苟","一板一眼","一本正经"],"opposite":["掉以轻心","视若等闲","敷衍了事"],"usage":"作谓语、状语；指对事的态度"},{"id":44475,"word":"郑重其辞","pinyin":"zhèng zhòng qí cí","abbr":"zzqc","explanation":"谓说话态度严肃认真。","source":{"text":"他才恭肃其貌，郑重其辞说道：‘年兄！你今日束修来见我，其实惭愧。’","book":"清·文康《儿女英雄传》第三十六回"},"usage":"作定语、状语；用于处事"},{"id":44476,"word":"郝隆晒书","pinyin":"hǎo lóng shài shū","abbr":"hlss","explanation":"指人腹中装书，很有学问。","source":{"text":"郝隆七月七日日中仰卧，人问其故，答曰：‘我晒书。’","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"～的故事让人发笑。"},"usage":"作宾语、定语；指人有学问","story":["西晋时期，大司马桓温手下的参军郝隆饱学多才，没有得到重用。他辞去参军的职务回故乡隐居。每年的七月七日当地有晒衣服的风俗，家贫的郝隆解开衣扣袒胸露腹晒太阳，人们问他何故？他傲然地回答道自己在晒书"]},{"id":44477,"word":"郢中白雪","pinyin":"yǐng zhōng bái xuě","abbr":"yzbx","explanation":"指高雅的乐曲或诗文。","source":{"text":"客有歌于郢中者，其始曰《下里巴人》，国中属而和者数千人；其为《阳阿》、《薤露》，国中属而和者数百人；其为《阳春白雪》，国中属而和者不过数十人……是其曲弥高，其和弥寡。","book":"典出战国·楚·宋玉《答楚王问》"},"example":{"text":"垂罗舞縠扬哀音，郢中《白雪》且莫吟。","book":"唐·李白《白紵辞》之二"},"usage":"作主语、宾语；用于书面语"},{"id":44478,"word":"郢书燕说","pinyin":"yǐng shū yān shuō","abbr":"ysys","explanation":"郢：春秋战国时楚国的都城；书：信；燕：古诸侯国名；说：解释。比喻牵强附会，曲解原意。","source":{"text":"郢人有遗燕相国书者，夜书，火不明，因谓持烛者曰：‘举烛’，云而过书‘举烛’。……燕相白王，王大悦，国以治。治则治矣，非书意也。","book":"《韩非子·外储说左上》"},"example":{"text":"是不必然，亦不必不然，～，固未为无益。","book":"清·纪昀《阅微草堂笔记》卷四"},"similar":["牵强附会"],"usage":"作宾语；指以讹传讹","story":["春秋时期，楚国都城郢地有个大臣与北方燕国相国是好朋友，两人经常书信往来。一天晚上郢地大臣命家人举烛写信，没想到把“举烛”两字写进信中。燕国相国看信后以为朋友在暗示他，就去拜见燕王，选拔有用人才参与治理国家，国力大增"]},{"id":44479,"word":"郢人斤斧","pinyin":"yǐng rén jīn fǔ","abbr":"yrjf","explanation":"比喻成熟、高超的技艺。同“郢匠挥斤”。","source":{"text":"庄子谈空惠子听，郢人斤斧俟忘形。莫嗟质丧无知者，对石何妨自说经。","book":"宋·苏辙《和子瞻濠州七绝·观鱼台》"},"similar":["郢匠挥斤","郢人斤斫","郢人运斧"],"usage":"作宾语、定语；用于书面语","story":["战国时期，楚国有一个人鼻尖上沾上了一点白粉，像苍蝇翅膀那样薄，他请一个石匠用斧头把白粉砍去，“匠石运斤成风，听而斫之，尽垩而鼻不伤。”他十分惊叹匠人的手艺精湛"]},{"id":44480,"word":"郢人斤斫","pinyin":"yǐng rén jīn zhuó","abbr":"yrjz","explanation":"比喻成熟、高超的技艺。同“郢匠挥斤”。","source":{"text":"郢人斤斫无痕迹，仙人衣裳弃刀尺。","book":"唐·刘禹锡《翰林白二十二学士见寄诗一百篇因以答贶》诗"},"similar":["郢人斤斧","郢人运斧","郢人斫垩"],"usage":"作宾语、定语；用于书面语"},{"id":44481,"word":"郢人斫垩","pinyin":"yǐng rén zhuó è","abbr":"yrze","explanation":"比喻成熟、高超的技艺。同“郢匠挥斤”。","source":{"text":"郢人斫垩元无迹，仙家种玉不论畦。","book":"元·刘敏中《最高楼》词"},"similar":["郢人运斧","郢人斤斧","郢人斤斫"],"usage":"作宾语、定语；用于书面语"},{"id":44482,"word":"郢人运斧","pinyin":"yǐng rén yùn fǔ","abbr":"yryf","explanation":"比喻成熟、高超的技艺。同“郢匠挥斤”。","source":{"text":"这真不亚于郢人运斧的本领，也不弱于西医开肠破肚所需要的准确与细心。","book":"《人民日报》1957.5.10"},"similar":["郢人斤斧","郢人斤斫","郢人斫垩"],"usage":"作宾语、定语；用于书面语"},{"id":44483,"word":"郢匠挥斤","pinyin":"yǐng jiàng huī jīn","abbr":"yjhj","explanation":"比喻纯熟、高超的技艺。","source":{"text":"《庄子·徐无鬼》载，匠石挥斧削去郢人涂在鼻翼上的白粉，而不伤其人。"},"example":{"text":"周官置臬，～，异态神行，全模化造。","book":"唐·崔融《嵩山启母庙碑序》"},"similar":["郢人斤斧","郢人运斤","郢人斤斫"],"usage":"作宾语、定语；用于书面语","story":["战国时期，楚国有一个人鼻尖上沾上了一点白粉，像苍蝇翅膀那样薄，他请一个石匠用斧头把白粉砍去，“匠石运斤成风，听而斫之，尽垩而鼻不伤。”他十分惊叹匠人的手艺精湛"]},{"id":44484,"word":"郤诜丹桂","pinyin":"xì shēn dān guì","abbr":"xsdg","explanation":"比喻科举及第，获得功名。","source":{"text":"晋郤诜举贤良对策为天下第一，自视为“桂林之一枝，昆山之片玉”。见《晋书·郤诜传》。"},"similar":["郤诜枝"],"usage":"作宾语、定语；用于书面语"},{"id":44485,"word":"郤诜高第","pinyin":"xì shēn gāo dì","abbr":"xsgd","explanation":"比喻指科举高中，荣登榜首。","source":{"text":"晋郤诜举贤良对策试，为天下第一。见《晋书·郤诜传》。"},"similar":["郤诜丹桂"],"usage":"作宾语、定语；用于书面语"},{"id":44486,"word":"郦寄卖友","pinyin":"lì jì mài yǒu","abbr":"ljmy","explanation":"郦寄出卖朋友。","source":{"text":"虽吕布贩君，郦寄卖友，方之斯人，未足为酷。","book":"南朝·齐·巨源《为尚书符荆州》"},"similar":["卖友求荣"],"usage":"作宾语、定语；指出卖朋友","story":["西汉时期，郦寄与吕后的亲戚吕禄关系很好，得到了荣华富贵。吕后死后，众大臣策划诛灭吕氏。将军吕禄掌管北军，太尉周勃不能进入其中，于是同郦寄的父亲商议，让郦寄骗吕禄出游，周勃才得以进据北军，乘机杀了吕禄"]},{"id":44487,"word":"郭公夏五","pinyin":"guō gōng xià wǔ","abbr":"ggxw","explanation":"《春秋》一书中，“郭公”下未记事，“夏五”后缺“月”字。比喻文字脱漏。","source":{"text":"十有四年春正月，公会郑伯于曹。无冰。夏五。","book":"《春秋·庄公二十四年》：“冬，戎侵曹。曹羁出奔陈。赤归于曹。郭公。”《春秋·桓公十四年》"}},{"id":44488,"word":"都中纸贵","pinyin":"dū zhōng zhǐ guì","abbr":"dzzg","explanation":"形容别人的著作受人欢迎，广为流传。","source":{"text":"都中纸贵流传后，海外金填姓字时。","book":"唐·元稹《和王侍郎酬广宣上人观放榜后相贺》"},"example":{"text":"他的作品造成“～”"},"similar":["洛阳纸贵"],"usage":"作宾语、定语；指文学作品","story":["西晋文学家左思勤奋好学，他的文章以辞藻华丽而出名。他写《齐都赋》时就小有名气，作为“著作郎”，花费十年时间写成《三都赋》。当时著名学者皇甫谧及张载、卫王灌、张华等为之批注作序，一时洛阳抄写该书成为时尚造成纸价上涨"]},{"id":44489,"word":"都俞吁咈","pinyin":"dōu yú xū fú","abbr":"dyxf","explanation":"皆为古汉语叹词。吁，不同意；咈，反对；都，赞美；俞，同意。本以表示尧、舜、禹等讨论政事时发言的语气，后用以赞美君臣论政问答，融洽雍睦。","source":{"text":"禹曰：‘都，帝，慎乃在位。’帝曰：‘俞！’","book":"《书·尧典》：“帝曰：‘吁！咈哉！’”又《益稷》"},"example":{"text":"君有过举，臣当直言，～，古之所尚。","book":"《续资治通鉴·宋理宗景定五年》"},"usage":"作宾语、状语；用于书面语"},{"id":44490,"word":"都头异姓","pinyin":"dū tóu yì xìng","abbr":"dtyx","explanation":"最高贵的称呼。","source":{"text":"兄岌，事悟为牙将，常乐滏山秀峻，曰：‘我死必葬此。’望气者言其地当三世为都头异姓，河北谓都头异姓，至贵称也。","book":"《新唐书·刘悟传》"},"example":{"text":"他被人称作～。"},"usage":"作宾语；指至贵的称谓"},{"id":44491,"word":"都鄙有章","pinyin":"dū bǐ yǒu zhāng","abbr":"dbyz","explanation":"都：国都；鄙：边远的地方；章：规章。国都和边远的地方车服尊卑各有规定。","source":{"text":"子产使都鄙有章，上下有服，田有封洫，庐井有伍。","book":"《左传·襄公三十年》"},"example":{"text":"公孙侨既执郑政，乃使～，上下有服，田有封洫，庐井有吾，尚忠俭，抑泰侈。","book":"明·冯梦龙《东周列国志》第六十七回"},"usage":"作宾语、定语；用于管理"},{"id":44492,"word":"鄐诜丹桂","pinyin":"xì shēn dān guì","abbr":"xsdg","explanation":"比喻科举及第，获得功名。","source":{"text":"。","book":"晋鄐诜举贤良对策为天下第一，自视为桂林之一枝，昆山之片玉”。见《晋书·鄐诜传》"}},{"id":44493,"word":"鄐诜高第","pinyin":"xì shēn gāo dì","abbr":"xsgd","explanation":"比喻指科举高中，荣登榜首。","source":{"text":"。","book":"晋鄐诜举贤良对策试，为天下第一。见《晋书·鄐诜传》"}},{"id":44494,"word":"鄙于不屑","pinyin":"bǐ yú bù xiè","abbr":"bybx","explanation":"鄙：粗俗卑鄙。不屑：认为不值得（做或看）。粗俗卑鄙到不值得一顾的程度。指既丑陋又下贱，叫人看不上眼。","example":{"text":"他对这次展览～。"},"similar":["鄙夷不屑"],"usage":"作谓语、定语；形容看不起别人"},{"id":44495,"word":"鄙俚浅陋","pinyin":"bǐ lǐ qiǎn lòu","abbr":"blql","explanation":"鄙俚：粗俗；浅陋：见闻不多。多形容文章或言谈粗俗浅薄。","source":{"text":"上询其政事，光不知文字，对皆鄙俚。","book":"宋·王傥《唐语林·政事上》卷一"},"similar":["粗俗浅薄"],"usage":"作谓语、定语；指见闻不多"},{"id":44496,"word":"鄙吝复萌","pinyin":"bǐ lìn fù méng","abbr":"blfm","explanation":"鄙吝：庸俗；萌：发生。庸俗的念头又发生了。","source":{"text":"时月之间，不见黄生，则鄙吝之萌复存乎心。","book":"南朝·宋·范晔《后汉书·黄宪传》"},"example":{"text":"已觉～矣！","book":"宋·胡继宗《书言故事大全·瞻仰类》"},"similar":["鄙吝复生"],"usage":"作谓语、宾语；指坏念头","story":["东汉学者黄宪出身贫寒，从小学识超人，名士荀淑见了他发现14岁的他居然可以当他的老师。别人把黄宪与功曹袁阆比较，认为他超出袁阆。周子居常说：“我如一段时间见不着黄宪，那么浅俗欲利的念头便又萌生了。”"]},{"id":44497,"word":"鄙夷不屑","pinyin":"bǐ yí bù xiè","abbr":"bybx","explanation":"指轻视；看不起。","source":{"text":"难得笑的平板的脸上却浮着鄙夷不屑的笑意。","book":"叶圣陶《倪焕之》九"},"example":{"text":"他小学校里的先生老觉得傅聚卿这孩子跟梢瞟着自己在表示～。","book":"钱锤书《猫》"},"similar":["不屑一顾"],"usage":"作谓语、定语；形容看不起别人"},{"id":44498,"word":"鄙薄之志","pinyin":"bǐ bó zhī zhì","abbr":"bbzz","explanation":"鄙薄：浅陋、微薄；志：志向。指微小的志向。多用作谦词。","source":{"text":"鄙薄之志，无以俸酬。","book":"唐·元稹《会真记》"}},{"id":44499,"word":"鄙言累句","pinyin":"bǐ yán lěi jù","abbr":"bylj","explanation":"鄙言：浅俗的言辞。指文章的词句浅俗，不精炼。","source":{"text":"上好为文章，自谓人莫能及。照悟其旨，为文章多鄙言累句。咸谓照才尽，实不然也。","book":"《南史·鲍照传》"}},{"id":44500,"word":"酌古准今","pinyin":"zhuó gǔ zhǔn jīn","abbr":"zgzj","explanation":"择取古代之事，用来比照今天的情况。","source":{"text":"今既汇为一书，固当深究本原，备详因革，酌古准今，以定一代之章程，垂万年之典则。","book":"明·张居正《请专官纂修疏》"},"example":{"text":"此是丞相～，仿《孙子》十三篇而作。","book":"明·罗贯中《三国演义》第六十回"},"usage":"作谓语、定语；用于书面语"},{"id":44501,"word":"酌古参今","pinyin":"zhuó gǔ cān jīn","abbr":"zgcj","explanation":"指斟酌古今之事，互相参照。","source":{"text":"步青先生著有《四时病机温毒病说》，重订《万氏女科三书》，发挥经旨，无奥不显，酌古参今，易施于用。","book":"清·冯桂芬《邵步青医学三书序》"},"similar":["酌古斟今"],"usage":"作谓语、定语；用于书面语"},{"id":44502,"word":"酌古御今","pinyin":"zhuó gǔ yù jīn","abbr":"zgyj","explanation":"指择古之善者以为治今的借鉴。","source":{"text":"强志足以成务，博见足以穷理，酌古御今，治繁总要，此其体也。","book":"南朝·梁·刘勰《文心雕龙·奏启》"},"usage":"作谓语、定语；用于书面语"},{"id":44503,"word":"酌古斟今","pinyin":"zhuó gǔ zhēn jīn","abbr":"zgzj","explanation":"指斟酌古今之事，互相参照。","source":{"text":"此词连用数韵，酌古斟今，尤妙。","book":"明·杨慎《词品·填词用韵宜谐俗》"},"similar":["酌古参今"],"usage":"作谓语、定语；用于书面语"},{"id":44504,"word":"酌古沿今","pinyin":"zhuó gǔ yán jīn","abbr":"zgyj","explanation":"指斟酌古今沿革，以明源流。","source":{"text":"此制酌古沿今，无以加也！","book":"唐·长孙讷言《〈切韵笺注〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":44505,"word":"酌水知源","pinyin":"zhuó shuǐ zhī yuán","abbr":"zszy","explanation":"饮水要明白它的来源。比喻不忘本。","source":{"text":"谬膺重任，得免愆尤，实老师教庇所及，酌水知源，敢忘衔结。","book":"明·张居正《答上师相徐存斋书》之二六"},"similar":["饮水思源"],"usage":"作谓语、定语；用于书面语"},{"id":44506,"word":"酌盈剂虚","pinyin":"zhuó yíng jì xū","abbr":"zyjx","explanation":"拿多余的弥补不足的或亏损的。","source":{"text":"上不亏展亲睦族之仁，下不失酌盈剂虚之术。","book":"明·张居正《请裁定宗藩事例疏》"},"example":{"text":"其裒多益寡、～者，必有其道矣。","book":"清·郑观应《盛世危言·恳荒》"},"similar":["取长补短","酌盈注虚"],"usage":"作谓语、定语；指相互调剂"},{"id":44507,"word":"酌盈注虚","pinyin":"zhuó yíng zhù xū","abbr":"zyzx","explanation":"指以有余调剂不足。","source":{"text":"盖量人为出，酌盈注虚，举望紧置邮，罔不皆然。","book":"明·沈榜《宛署杂记·经费下》"},"similar":["酌盈剂虚"],"usage":"作谓语、定语；指相互调剂"},{"id":44508,"word":"酌金馔玉","pinyin":"zhuó jīn zhuàn yù","abbr":"zjzy","explanation":"喝酒的杯子是金的，盛菜肴的器皿是玉的。极言饮宴的奢侈豪华。","source":{"text":"平台戚里带崇墉，酌金馔玉待鸣钟。","book":"唐·骆宾王《帝京篇》"},"similar":["炊金馔玉"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":44509,"word":"配享从汜","pinyin":"pèi xiǎng cóng sì","abbr":"pxcs","explanation":"旧时以孔子门徒及某些所谓“名儒”附属于孔子者一并受祭，称配享从汜。","source":{"text":"国子司业蒋静言：‘先圣与门人通被冕服无别，配享从汜之人当从所封之爵服。’","book":"《宋史·礼志八》"},"usage":"作定语；用于书面语"},{"id":44510,"word":"配套成龙","pinyin":"pèi tào chéng lóng","abbr":"ptcl","explanation":"把设备或设施搭配起来，成为完整的系统。","source":{"text":"搭好桥梁河好过，配套成龙生产高。","book":"《工人歌谣选·配套成龙生产高》"},"example":{"text":"现在，全大队二十六个山塘水库，已经～，形成了一个水利灌溉网。","book":"《人民日报》1973.1.28"},"similar":["成龙配套"],"usage":"作谓语、定语；指搭配起来，成为完整的系统"},{"id":44511,"word":"酒不醉人人自醉","pinyin":"jiǔ bù zuì rén rén zì zuì","abbr":"jbzrrzz","explanation":"指人因喝酒而自我陶醉。","source":{"text":"酒中贤圣得人传，人负邦家因酒覆。解嘲破惑有常言，酒不醉人人自醉。","book":"明·施耐庵《水浒传》第四回"},"example":{"text":"钱钟书《围城》：“～，色不迷人人自迷，今朝有缘来相会，明日你东我向西。”"},"similar":["花不迷人人自迷"],"usage":"作宾语、定语；用于自我解嘲"},{"id":44512,"word":"酒令如军令","pinyin":"jiǔ lìng rú jūn lìng","abbr":"jlrjl","explanation":"比喻喝酒行令如同军令一样严格，必须执行。","source":{"text":"高后令刘章为酒吏，请以军法行酒。诸吕有一人醉亡酒，章追仗剑斩之。","book":"《史记·齐悼惠王世家》"},"example":{"text":"次芳道：“你别管，～，违者先罚！”","book":"清·曾朴《孽海花》第八回"}},{"id":44513,"word":"酒余茶后","pinyin":"jiǔ yú chá hòu","abbr":"jych","explanation":"指随意消遣的空闲时间。","source":{"text":"但依我们中国的老眼睛看起来，小说是给人消闲的，是为酒余茶后之用。","book":"鲁迅《集外集拾遗·帮助文学与帮闲文学》"},"similar":["茶余饭后","茶余酒后"],"usage":"作宾语、定语；指空闲时间"},{"id":44514,"word":"酒余饭饱","pinyin":"jiǔ yú fàn bǎo","abbr":"jyfb","explanation":"酒已尽量，饭也吃饱。形容吃饱喝足。","source":{"text":"俺这里安排一席好酒……，我着他酒醉饭饱，走不动。","book":"元·高文秀《襄阳会》第一折"},"example":{"text":"乐得与二三同志，～，雨夕灯窗，同消寂寞。","book":"清·曹雪芹《红楼梦》第一百二十回"}},{"id":44515,"word":"酒入舌出","pinyin":"jiǔ rù shé chū","abbr":"jrsc","explanation":"形容人喝酒以后喜欢唠叨。","source":{"text":"臣闻之酒入者舌出，舌出者弃身，不宁弃酒乎？","book":"西汉·韩婴《韩诗外传》第十卷"},"example":{"text":"管仲对曰：‘臣闻～，舌出者言失。’","book":"西汉·刘向《说苑·敬慎》"},"similar":["酒后吐真言"],"usage":"作谓语、宾语、定语；指酒后"},{"id":44516,"word":"酒后之勇","pinyin":"jiǔ hǔ shī lóng","abbr":"jhzy","explanation":"比喻嗜酒善饮、才高能诗的人。","source":{"text":"狂饮且共楼头醉，酒虎诗龙各自豪。","book":"清·丘逢甲《东山酒楼次柳汀韵》"},"example":{"text":"你这样做只是～，算不了什么"},"usage":"作主语、宾语；用于讥笑人"},{"id":44517,"word":"酒后吐真言","pinyin":"jiǔ hòu tǔ zhēn yán","abbr":"jhtzy","explanation":"酒喝多了以后容易讲真心话。"},{"id":44518,"word":"酒后失言","pinyin":"jiǔ hòu shī yán","abbr":"jhsy","explanation":"酒喝多了以后，不能自持，说了不该说的话。","source":{"text":"杨雄道：‘兄弟，你休怪我。是我一时愚蠢，不是了，酒后失言，反被那婆娘瞒过了，怪兄弟相闹不得。我今特来寻贤弟，负荆请罪。’","book":"明·施耐庵《水浒传》第四十六回"},"example":{"text":"清·李汝珍《镜花缘》第50回：“刚才只因多饮几杯，痰迷心窍，～，只求夫人饶恕，从此再不妄生邪念了。”"},"usage":"作宾语、定语；用于口语"},{"id":44519,"word":"酒后无德","pinyin":"jiǔ hòu wú dé","abbr":"jhwd","explanation":"指醉酒之后胡言乱语或行为出路。","source":{"text":"平姑娘，过来！我当着大奶奶姑娘们替你赔个不是，担待我酒后无德罢。","book":"清·曹雪芹《红楼梦》第45回"},"example":{"text":"别劝她喝了，小心她～。"},"usage":"作谓语、定语、宾语；用于醉酒","story":["大观园又聚会了，李纨负责组织贾宝玉、林黛玉、薛宝钗、王熙凤等姐妹在一起喝酒聊天。在酒席中，王熙凤诉说家难当难管，平儿帮不了什么忙。李纨则为平儿打抱不平，骂王熙凤酒后无德。众人纷纷大笑起来"]},{"id":44520,"word":"酒后茶余","pinyin":"jiǔ hòu chá yú","abbr":"jhcy","explanation":"指随意消遣的空闲时间。","source":{"text":"从别的地方--如北京，南京，我的故乡--的例子推想起来，当时大概有若干人痛惜，若干人快意，若干人没有什么意见，若干人当作酒后茶余的谈助的罢。","book":"鲁迅《而已集·黄花节的杂感》"},"example":{"text":"人人都会在你身后指指点点，拿你呀当作～的小笑话。","book":"老舍《青蛙骑手》第二场"},"similar":["酒余茶后"],"usage":"作宾语、定语；指空闲时间"},{"id":44521,"word":"酒囊饭包","pinyin":"jiǔ náng fàn bāo","abbr":"jnfb","explanation":"讥讽无能的人，只会吃喝，不会做事。","source":{"text":"念区区酒囊饭包，又谁知生来命高，没生涯，终朝醉饱，都倚着那妖娆。","book":"清·李渔《意中缘·卷帘》"},"similar":["酒囊饭袋","酒瓮饭囊"],"usage":"作宾语、定语；指无能之辈"},{"id":44522,"word":"酒囊饭袋","pinyin":"jiǔ náng fàn dài","abbr":"jnfd","explanation":"囊：口袋。只会吃喝，不会做事。讥讽无能的人。","source":{"text":"饱食快饮，虑深求卧，腹为饭坑，肠为酒囊。","book":"汉·王充《论衡·别通》"},"example":{"text":"唐末马殷据湖南，称楚王，奢侈僭傲，诸院王子仆从烜赫，文武之道，未尝留意，时谓之～。","book":"宋·陶岳《荆湘近事》"},"similar":["行尸走肉","衣架饭囊"],"opposite":["英雄好汉","能工巧匠","真才实学"],"usage":"作宾语、定语；指无能之辈","story":["五代时期，武安节度使刘建锋的部下马殷在刘死后做统率，他无所作为。朱温篡唐建立后梁后，把马殷封成楚王，驻守湖南广西等地，马殷只知道享受，昏庸无能，人们都瞧不起他，替他取了个绰号“酒囊饭袋”"]},{"id":44523,"word":"酒地花天","pinyin":"jiǔ dì huā tiān","abbr":"jdht","explanation":"形容吃喝嫖赌、荒淫腐化的生活。","source":{"text":"安垲第喝茶，天乐窝听唱，马龙车水，酒地花天，好一派升平景象！","book":"清·曾朴《孽海花》第一回"},"example":{"text":"康中丞虽然年过五旬，看着这些粉白黛绿的妖姬，过着那般～的日月，自然的未免有情，谁能遣此？","book":"清·张春帆《九尾龟》第一百一十八回"},"similar":["花天酒地"],"opposite":["节衣缩食"],"usage":"作谓语、定语、状语；指酒色生活"},{"id":44524,"word":"酒有别肠","pinyin":"jiǔ yǒu bié cháng","abbr":"jybc","explanation":"指酒量大小，与身材高矮无关。","source":{"text":"帝曰：‘维岳身甚小，何饮酒之多？’左右曰：‘酒有别肠，不必长大。’","book":"清·吴任臣《十国春秋·闽·景宗纪》"},"example":{"text":"～，信然。","book":"清·纪昀《阅微草堂笔记》卷二十四"},"usage":"作宾语；指酒量大小与身材无关"},{"id":44525,"word":"酒朋诗侣","pinyin":"jiǔ péng shī lǚ","abbr":"jpsl","explanation":"指在一起喝酒作诗的朋友。","source":{"text":"持杯谢酒朋诗侣，余酲更不禁香醑。","book":"宋·柳永《归去来》"},"example":{"text":"来相召，香车宝马，谢他～。","book":"宋·李清照《永遇乐》词"}},{"id":44526,"word":"酒池肉林","pinyin":"jiǔ chí ròu lín","abbr":"jcrl","explanation":"古代传说，殷纣以酒为池，以肉为林，为长夜之饮。原指荒淫腐化、极端奢侈的生活，后也形容酒肉极多。","source":{"text":"行赏赐，酒池肉林。","book":"《史记·殷本纪》：“以酒为池，悬肉为林。”《汉书·张骞传》"},"example":{"text":"纣王听信妲己，造～，一无忌惮，朝纲不整，任意荒淫。","book":"明·许仲琳《封神演义》第十七回"},"similar":["灯红酒绿","穷奢极侈","荒淫无度"],"usage":"作宾语、定语；形容极端奢侈豪华的生活","story":["商朝末年，商纣王荒淫无道，甚至用酒装满池子，把肉挂在树林里，叫做酒池肉林，让不穿衣服的男女互相追逐嬉戏，还让乐师作淫声伴奏，以供他取乐。他的同族人比干劝谏他，被他所杀，还残忍地将比干的心挖了出来"]},{"id":44527,"word":"酒浇块垒","pinyin":"jiǔ jiāo kuài lěi","abbr":"jjkl","explanation":"块垒：指心里郁积着的忧愁、气愤。指用喝酒的方式来消去心中的愁闷。","source":{"text":"王孝伯问王大：‘阮籍何如司马相如？’王大曰：‘阮籍胸中垒快，胡须酒浇之。’","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"记桐飘坠叶，休惊时节，～。","book":"柳亚子《沁园春·寿巢南三纪初度》词"}},{"id":44528,"word":"酒浇垒块","pinyin":"jiǔ jiāo lěi kuài","abbr":"jjlk","explanation":"垒块：指心里郁积着的忧愁、气愤。指用喝酒的方式来消去心中的愁闷。","source":{"text":"王孝伯问王大：‘阮籍何如司马相如？’王大曰：‘阮籍胸中垒快，胡须酒浇之。’","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":44529,"word":"酒瓮饭囊","pinyin":"jiǔ wèng fàn náng","abbr":"jwfn","explanation":"犹言酒囊饭袋。","source":{"text":"荀彧犹强可与语，过此以往，皆木梗泥偶，似人而无人气，皆酒瓮饭囊耳。","book":"晋·葛洪《抱朴子·弹祢》"},"example":{"text":"～君勿诮，也胜满腹贮闲愁。","book":"宋·陆游《解嘲》诗"},"similar":["酒囊饭袋","酒囊饭包"],"usage":"作宾语、定语；指无能之辈"},{"id":44530,"word":"酒病花愁","pinyin":"jiǔ bìng huā chóu","abbr":"jbhc","explanation":"指因贪恋酒色而引起的烦愁。","source":{"text":"今日心中闷倦，故来此翠云楼游玩。小官只为酒病花愁，何日是好也呵。","book":"元·乔吉《扬州梦》第二折"},"usage":"作宾语；指贪恋酒色"},{"id":44531,"word":"酒社诗坛","pinyin":"jiǔ shè shī tán","abbr":"jsst","explanation":"酒社：酒友所成立的团体；诗坛：诗人会聚的场所。指文人墨客相约在一起饮酒作诗的组织。","source":{"text":"酒社我为敌，诗坛子有功。","book":"宋·苏轼《元日次韵张先子野见和七夕寄莘老之作》"},"example":{"text":"当日个叙寒温了无一字，与长者又不曾相会在～。","book":"元·无名氏《刘弘嫁婢》第三折"}},{"id":44532,"word":"酒绿灯红","pinyin":"jiǔ lǜ dēng hóng","abbr":"jldh","explanation":"灯光酒色，红绿相映，令人目眩神迷。形容奢侈糜烂的生活。","source":{"text":"（玉生）侧着头想了一会道‘灯红酒绿’好吗？","book":"清·吴趼人《二十年目睹之怪现状》第三十三回"},"example":{"text":"总之，大罢工使香港这个～的城市完全失色了。","book":"秦牧《沙面晨眺》"},"similar":["灯红酒绿","酒池肉林"],"usage":"作宾语、定语；形容奢侈糜烂的生活情景"},{"id":44533,"word":"酒肉兄弟","pinyin":"jiǔ ròu xiōng dì","abbr":"jrxd","explanation":"指酒肉朋友。","source":{"text":"这是前村催命鬼的酒肉兄弟，叫做破面鬼。","book":"清·张南庄《何典》第二回"},"example":{"text":"自古道：～千个有，急难之中一个无。"},"similar":["酒肉朋友","酒肉弟兄"],"opposite":["患难之交"],"usage":"作宾语、定语；指酒肉朋友"},{"id":44534,"word":"酒肉弟兄","pinyin":"jiǔ ròu dì xiōng","abbr":"jrdx","explanation":"在一起只是吃喝玩乐而不干正经事、不能共患难的朋友。","source":{"text":"哥哥放着常来的一班儿好酒肉弟兄，闲常不睬的是亲兄弟，今日才有事，便叫没捉处。","book":"明·施耐庵《水浒传》第18回"},"similar":["酒肉朋友"],"opposite":["患难之交"],"usage":"作宾语、定语；指酒肉朋友"},{"id":44535,"word":"酒肉朋友","pinyin":"jiǔ ròu péng yǒu","abbr":"jrpy","explanation":"在一起只是吃喝玩乐而不干正经事的朋友。","source":{"text":"关云长是我酒肉朋友，我交他两只手送与你那荆州来。","book":"元·关汉卿《单刀会》"},"example":{"text":"今虽势力滂沛，大抵是～耳。","book":"章炳麟《致伯中书一》"},"similar":["狐朋狗友","酒肉弟兄"],"opposite":["患难之交"],"usage":"作宾语；指吃喝朋友"},{"id":44536,"word":"酒能乱性","pinyin":"jiǔ néng luàn xìng","abbr":"jnlx","explanation":"喝多酒能够使人不能自控，就会淫乱。","source":{"text":"酒能乱性，色是败真。财乃致命，气动杀身。","book":"清·无名氏《说呼全传》第16回"},"example":{"text":"～，又碰着一向喜欢的人，生米下了锅，却又煮不成熟饭。","book":"高阳《胡雪岩全传·平步青云》中册"},"usage":"作宾语、定语；多用于劝诫人"},{"id":44537,"word":"酒色之徒","pinyin":"jiǔ sè zhī tú","abbr":"jszt","explanation":"指沉迷于吃喝与女色之中的人。","source":{"text":"以后相处的虽多，都是豪华之辈，酒色之徒，但知买笑追欢的乐意，哪有怜香惜玉的真心。","book":"明·冯梦龙《醒世恒言》"},"example":{"text":"那政老爷便不喜欢，说将来不过～，因此不甚爱惜。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["酒色财气"],"opposite":["正人君子"],"usage":"作宾语；指嗜酒好色的人"},{"id":44538,"word":"酒色财气","pinyin":"jiǔ sè cái qì","abbr":"jscq","explanation":"旧时以此为人生四戒。泛指各种不良品德、习气。","source":{"text":"一梦中十八年，见了酒色财气，人我是非，贪嗔痴爱，风霜雨雪。","book":"《后汉书·杨秉传》：“尝从容言曰：‘我有三不惑：酒、色、财也。’”元·马致远《黄梁梦》第四折"},"example":{"text":"李生起而观之，乃是一首词，名《西江月》，是说～四件的短处。","book":"明·冯梦龙《警世通言》卷十一"},"similar":["酒色之徒"],"usage":"作定语、宾语；指不良习气"},{"id":44539,"word":"酒虎诗龙","pinyin":"jiǔ hǔ shī lóng","abbr":"jhsl","explanation":"比喻嗜酒善饮、才高能诗的人。","source":{"text":"狂饮且共楼头醉，酒虎诗龙各自豪。","book":"清·丘逢甲《东山酒楼次柳汀韵》"},"similar":["酒龙诗虎"],"usage":"作宾语、定语；用于比喻句"},{"id":44540,"word":"酒言酒语","pinyin":"jiǔ yán jiǔ yǔ","abbr":"jyjy","explanation":"酒醉之后的胡言乱语。形容胡说八道，语无伦次。"},{"id":44541,"word":"酒足饭饱","pinyin":"jiǔ zú fàn bǎo","abbr":"jzfb","explanation":"酒已尽量，饭也吃饱。形容吃饱喝足。","source":{"text":"俺这里安排一席好酒……，我着他酒醉抉饭饱，走不动。","book":"元·高文秀《襄阳会》第一折"},"example":{"text":"我方才被杨公馆坚留，已经喝得～。","book":"姚雪垠《李自成》第二卷第十六章"},"similar":["酒醉饭饱"],"usage":"作谓语、定语、状语；比喻饮食得到满足"},{"id":44542,"word":"酒逢知己千杯少","pinyin":"jiǔ féng zhī jǐ qiān bēi shǎo","abbr":"jfzjqbs","explanation":"形容性情相投的人聚在一起总不厌倦。","source":{"text":"二人也把别后之事，谈了一番。三人俱备大悦。正是： 酒逢知己千杯少，话不投机半句多。","book":"清·吴璿《飞龙全传》第三回"},"example":{"text":"庞毅奋髯而起，慨然应诺。当下一番畅谈，正是～。","book":"清·俞万春《荡寇志》第一百二十三回"},"usage":"作宾语、定语；用于口语"},{"id":44543,"word":"酒酣耳热","pinyin":"jiǔ hān ěr rè","abbr":"jher","explanation":"酒酣：酒喝得很痛快。形容喝酒喝得正高兴的时候。","source":{"text":"每至觞酌流行，丝竹并奏，酒酣耳热，仰而赋诗，当此之时，忽然不自知乐也。","book":"汉·杨恽《报孙会宗书》：“酒后耳热，仰天拊缶，而呼乌乌。”三国·魏·曹丕《与吴质书》"},"example":{"text":"～，攘袂持杯。","book":"清·张潮《虞初新志·王翠翘传》"},"similar":["狂喝豪饮","酒后耳热"],"usage":"作谓语、定语；指酒兴正浓"},{"id":44544,"word":"酒酣耳熟","pinyin":"jiǔ hān ěr shú","abbr":"jhes","explanation":"酒酣：饮酒尽兴而痛快。耳热：指面红过耳，非常兴奋。形容酒兴很浓，喝得痛快。"},{"id":44545,"word":"酒酸不售","pinyin":"jiǔ suān bù shòu","abbr":"jsbs","explanation":"酒已经变酸了，依然卖不出去。原比喻奸臣阻拦了有学问、有贤德的人为国家效力，使国君受到蒙蔽。后比喻经营无方或办事用人不当。","source":{"text":"宋人有酤酒者，……著然不售，酒酸，怪其故，问其所知，问长者杨倩，……曰：‘狗猛则酒何故而不售？’曰：‘人畏焉。……，而狗迎龁之，此酒所以酸而不售也。","book":"《韩非子·外储说右上》"},"example":{"text":"人有酤酒者，为器甚洁清，置表甚长而～。","book":"汉·刘向《说苑·政理》"},"similar":["狗恶酒酸"],"usage":"作宾语、定语；用于书面语","story":["春秋时期，一个宋国酿酒人非常注意自己的信誉，店越开越大，酒越酿越好，他养一条狗看店。可是渐渐地酒卖不动了，越积越多，逐渐变酸。他问杨倩到底为什么？杨倩说：“你家的狗太凶猛了，别人害怕你的狗而不敢来买酒。”"]},{"id":44546,"word":"酒酽春浓","pinyin":"jiǔ yàn chūn nóng","abbr":"jycn","explanation":"酽：味厚，味浓。酒味醇美，春意盎然。形容美好圆满的时刻。","source":{"text":"酒酽春浓琼草齐，真公饮散醉如泥。","book":"唐·曹唐《小游仙》"}},{"id":44547,"word":"酒酽花浓","pinyin":"jiǔ yàn huā nóng","abbr":"jyhn","explanation":"酽：味厚，味浓。酒味醇美，花香浓郁。形容美好圆满的时刻。","source":{"text":"酒酽春浓琼草齐，真公饮散醉如泥。","book":"唐·曹唐《小游仙》"},"example":{"text":"你则待～，月圆人静。","book":"元·无名氏《云窗梦》第二折"}},{"id":44548,"word":"酒醉酒解","pinyin":"jiǔ zuì jiǔ jiě","abbr":"jzjj","explanation":"喝醉酒后，还必须用酒来解醉。比喻问题由谁造成，还应由谁来解决。","source":{"text":"以贵戚废锢，复以贵戚浣濯之，犹解酲当以酒也。","book":"《后汉书·第五伦传》"}},{"id":44549,"word":"酒醉饭饱","pinyin":"jiǔ zuì fàn bǎo","abbr":"jzfb","explanation":"比喻饮食得到了满足。","source":{"text":"我如今且不打你，等我吃得酒醉饭饱了，慢慢的打你。","book":"元·杨显之《酷寒亭》"},"example":{"text":"其一，不舟不车，不衫不帻，～，呼群三五，跻入人丛。","book":"明·张岱《陶庵梦忆西湖七月半》"},"similar":["酒足饭饱","大吃大喝","花天酒地"],"usage":"作谓语、定语；比喻饮食得到满足"},{"id":44550,"word":"酒醴麹蘖","pinyin":"jiǔ lǐ qū niè","abbr":"jlqn","explanation":"醴：甜酒；麹蘖：酒曲。好酒必须有酒曲才能酿成。比喻君主或领导左右不可缺少的忠臣或下属。","source":{"text":"若作酒醴，你惟麹蘖。","book":"《尚书·说命下》"}},{"id":44551,"word":"酒阑人散","pinyin":"jiǔ lán rén sàn","abbr":"jlrs","explanation":"阑：尽。酒席完毕，客人归去。","source":{"text":"时春物尚余，夏景初丽，酒阑宾散，离思萦怀。","book":"唐·蒋防《霍小玉传》"},"example":{"text":"～仲仲，闲阶独倚梧桐。","book":"宋·晏殊《清平乐》词"},"similar":["酒阑宾散","酒阑客散"],"usage":"作宾语、定语；指宴会结束"},{"id":44552,"word":"酒阑兴尽","pinyin":"jiǔ lán xìng jìn","abbr":"jlxj","explanation":"阑：尽；兴：兴致，兴夸。酒宴完了，兴致也没了。","source":{"text":"大家又与青雯谈了些海外的事情，彼酬此酢，不觉日红西斜，酒阑兴尽，诸客中有醉眠的，也有逃席的，纷纷离去。","book":"曾朴《孽海花》第20回"},"usage":"作定语；用于书面语"},{"id":44553,"word":"酒阑客散","pinyin":"jiǔ lán kè sàn","abbr":"jlks","explanation":"阑：尽。酒席完毕，客人归去。","source":{"text":"时春物尚余，夏景初丽，酒阑宾散，离思萦怀。","book":"唐·蒋防《霍小玉传》"},"example":{"text":"至夜静灯残，～，其于楹础之间，两目烂烂如岩下电者，非他人必一生也。","book":"明·张岱《祭秦一生文》"},"similar":["酒阑宾散","酒阑人散"],"usage":"作宾语、定语；指宴会后客人离去"},{"id":44554,"word":"酒阑宾散","pinyin":"jiǔ lán bīn sàn","abbr":"jlbs","explanation":"阑：尽；宾：客人。酒席完毕，客人归去。","source":{"text":"时春物尚余，夏景初丽，酒阑宾散，离思萦怀。","book":"唐·蒋防《霍小玉传》"},"similar":["酒阑人散","酒阑客散"],"usage":"作宾语、定语；指宴会后客人离去"},{"id":44555,"word":"酒食地狱","pinyin":"jiǔ shí dì yù","abbr":"jsdy","explanation":"陷入终日为酒食应酬而奔忙的痛苦境地。","source":{"text":"东坡倅杭，不胜杯酌……疲于应接，乃号杭倅为酒食地狱。","book":"宋·朱彧《萍洲可谈》卷三"},"usage":"作宾语、定语；指应酬"},{"id":44556,"word":"酒食征逐","pinyin":"jiǔ shí zhēng zhú","abbr":"jszz","explanation":"征：召唤；逐：追随。指酒肉朋友以吃喝交往。","source":{"text":"今夫平居里巷相慕悦，酒食游戏相征逐，诩诩强笑语以相取下。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"至于衣服奢华，～，尤宜切戒。","book":"清·李宝嘉《官场现形记》第二十回"},"usage":"作宾语；指酒肉朋友以吃喝交往"},{"id":44557,"word":"酒龙诗虎","pinyin":"jiǔ lóng shī hǔ","abbr":"jlsh","explanation":"比喻嗜酒善饮、才高能诗的人。","source":{"text":"来此人间不知岁，仍是酒龙诗虎。","book":"宋·葛长庚《贺新郎·别鹤林》词"},"example":{"text":"莫管存亡家国事，～尽多才。","book":"柳亚子《海上即事》诗"},"similar":["酒虎诗龙"],"usage":"作宾语、定语；用于比喻句"},{"id":44558,"word":"酗酒滋事","pinyin":"xù jiǔ zī shì","abbr":"xjzs","explanation":"喝醉酒寻衅生事者。","example":{"text":"公布栏上贴出公告，凡有～者，一概停职。"}},{"id":44559,"word":"酝藉风流","pinyin":"yùn jiè fēng liú","abbr":"yjfl","explanation":"酝藉：宽和有涵容。形容人的风度潇洒温文。","source":{"text":"动作语言，一无外饰，酝藉风流，为时称向。","book":"《旧唐书·权德舆传》"},"similar":["风流酝藉"],"usage":"作谓语、定语；指人的风度"},{"id":44560,"word":"酣声如雷","pinyin":"hān shēng rú léi","abbr":"hsrl","explanation":"酣：通“鼾”，熟睡时的鼻息声。形容熟睡时鼾声很大。","source":{"text":"各去睡了，不多时，酣声如雷。","book":"清·李汝珍《镜花缘》第37回"},"similar":["鼾声如雷"],"usage":"作谓语；形容熟睡时鼾声很大"},{"id":44561,"word":"酣嬉淋漓","pinyin":"hān xī lín lí","abbr":"hxll","explanation":"①形容恣意嬉戏，至于极点。②指文字非常畅达。","source":{"text":"时人不能用其材，曼卿亦不屈以求合。无所放其意，则往往从布衣野老酣嬉淋漓颠倒而不厌。","book":"宋·欧阳修《〈释秘演集〉序》"},"example":{"text":"至如董文敏《天马赋酬岕老》及《五更鹰窠顶观日出》等作，则兴会所到，～，力大于身，虽长而不觉其冗矣。","book":"清·赵翼《瓯北诗话·查初白诗》"},"usage":"作定语、状语；用于游玩场合"},{"id":44562,"word":"酣歌恒舞","pinyin":"hān gē héng wǔ","abbr":"hghw","explanation":"形容纵情歌舞，耽于声色。","source":{"text":"常舞则荒淫，乐酒曰酣，酣歌则废德。","book":"《书·伊训》：“敢有恒舞于宫，酣歌于室，时谓巫风。”孔传"},"example":{"text":"恬嬉如故，厝火积薪之下，而寝处其上，～，民怨沸腾，卒至鱼烂土崩，不可收拾。","book":"蔡东藩、许廑父《民国通俗演义》第四四回"},"similar":["酣歌醉舞"],"usage":"作谓语；形容纵情歌舞，耽于声色"},{"id":44563,"word":"酣歌醉舞","pinyin":"hān gē zuì wǔ","abbr":"hgzw","explanation":"形容纵情歌舞，耽于声色。同“酣歌恒舞”。","source":{"text":"不见他们朝朝暮暮酣歌醉舞么？","book":"茅盾《血战后一周年》"},"similar":["酣歌恒舞"],"usage":"作谓语、宾语；形容纵情歌舞，耽于声色"},{"id":44564,"word":"酣然入梦","pinyin":"hān rán rù mèng","abbr":"hrrm","explanation":"很舒适地进入梦乡","example":{"text":"看着她～的样子，我感到十分惬意。"},"similar":["酣然入睡"],"usage":"作谓语、定语；用于睡眠等"},{"id":44565,"word":"酣畅淋漓","pinyin":"hān chàng lín lí","abbr":"hcll","explanation":"酣畅：畅饮，引伸为舒适、畅快；淋漓：畅快的样子。形容非常畅快。","source":{"text":"无所放其意，则往往从布衣野老，酣嬉淋漓，颠倒而不厌。","book":"《晋书·阮修传》：“常步行，以百姓挂杖头，至酒店，便独酣畅。”宋·欧阳修《释秘演诗集序》"},"example":{"text":"老舍先生写老张的“钱本位”的哲学，确乎是～，阐扬尽致。","book":"朱自清《〈老张的哲学〉与〈赵子曰〉》"},"similar":["淋漓尽致"],"opposite":["扦格不通","诘屈聱牙"],"usage":"作状语、补语；形容非常舒畅和痛快"},{"id":44566,"word":"酣痛淋漓","pinyin":"hān tòng lín lí","abbr":"htll","explanation":"形容非常畅快。同“酣畅淋漓”。","source":{"text":"仓卒不工且快意，酣痛淋漓聊一贾。","book":"清·魏源《夜雨行》"},"similar":["酣畅淋漓"],"usage":"作状语、补语；形容非常舒畅和痛快"},{"id":44567,"word":"酩酊大醉","pinyin":"mǐng dǐng dà zuì","abbr":"mddz","explanation":"酩酊：沉醉的样子。形容醉得很厉害。","source":{"text":"日暮倒载归，酩酊无所知。","book":"北魏·郦道元《水经注·沔水》"},"example":{"text":"不两个时辰，把李逵灌得～，立脚不住。","book":"明·施耐庵《水浒全传》第四十三回"},"similar":["烂醉如泥","酩酊烂醉"],"opposite":["滴酒不沾"],"usage":"作谓语、定语、状语；指醉酒"},{"id":44568,"word":"酩酊烂醉","pinyin":"mǐng dǐng làn zuì","abbr":"mdlz","explanation":"形容醉得厉害。","source":{"text":"从下午吃起，直吃到黄昏时候，一个个酩酊烂醉。","book":"明·凌濛初《二刻拍案惊奇》第20卷"},"example":{"text":"他们每个都喝得～。"},"similar":["酩酊大醉"],"opposite":["滴酒不沾"],"usage":"作谓语、状语；指醉酒"},{"id":44569,"word":"酬功报德","pinyin":"chóu gōng bào dé","abbr":"cgbd","explanation":"酬：报谢；报：报答。酬谢功劳，报答恩德。","source":{"text":"呜呼！酬功报德，率由旧章。","book":"清·钱彩《说岳全传》第80回"},"example":{"text":"我们应该及时～。"},"usage":"作谓语、宾语；指给予回应"},{"id":44570,"word":"酬功给效","pinyin":"chóu gōng gěi xiào","abbr":"cggx","explanation":"效，呈献，献出（生命者）。指赏赐有功劳者。","source":{"text":"子胥随帝部卒入城，检纳干戈，酬功给效。","book":"《敦煌变文集·伍子胥变文》"},"similar":["按功行赏"],"usage":"作谓语；指奖励"},{"id":44571,"word":"酬应如流","pinyin":"chóu yìng rú liú","abbr":"cyrl","explanation":"酬应：应答。应答如同流水一样流畅。","source":{"text":"刘显执卷策劢，酬应如流，乃至卷次行数亦不差失。","book":"《南史·梁宗室吴平侯萧劢传》"}},{"id":44572,"word":"酸咸苦辣","pinyin":"suān xián kǔ là","abbr":"sxkl","explanation":"指各种味道。比喻幸福、痛苦等各种境遇。同“酸甜苦辣”。","source":{"text":"伯芬此时急的要哭出来，又是悔，又是恨，又是恼，又是急，一时心中把酸咸苦辣都涌了上来。","book":"清·吴研人《二十年目睹之怪现状》第九十回"},"example":{"text":"他细嚼着这些～，从这里面他发现了自身的危机。","book":"夏征农《一篇嫁女人的账》"},"similar":["甜酸苦辣","咸酸苦辣"],"usage":"作主语、宾语；用于比喻句"},{"id":44573,"word":"酸文假醋","pinyin":"suān wén jiǎ cù","abbr":"swjc","explanation":"形容装出一副文雅有礼貌的样子。","source":{"text":"则是听上他那酸文假醋，动不动便是‘诗云子曰’儿，那个奈烦那。","book":"明·无名氏《东篱赏菊》第一折"},"example":{"text":"这有什么？大凡一个人，总别～的才好。","book":"清·曹雪芹《红楼梦》第109回"},"usage":"作谓语、定语；指假正经"},{"id":44574,"word":"酸甜苦辣","pinyin":"suān tián kǔ là","abbr":"stkl","explanation":"指各种味道。比喻幸福、痛苦等各种境遇。","source":{"text":"阴阳不同气，然其为和同也；酸咸甘苦之味相反，然其为善均也。","book":"《鹖冠子·环流五》"},"example":{"text":"～，各种滋味搅和在一起，索性任情地倾吐。（叶圣陶《微波》）"},"similar":["世态炎凉","悲欢离合"],"opposite":["四大皆空"],"usage":"作主语、宾语；形容人生"},{"id":44575,"word":"酸眉醋眼","pinyin":"suān méi cù yǎn","abbr":"smcy","explanation":"指人用妒忌的眼光看待。","source":{"text":"公众场合不能酸眉醋眼，张东望西。","book":"路遥《平凡的世界》第一卷第九章"},"usage":"作谓语、定语、宾语；用于处事"},{"id":44576,"word":"醇酒妇人","pinyin":"chún jiǔ fù rén","abbr":"cjfr","explanation":"醇酒：味厚的酒。比喻颓废腐化的生活。","source":{"text":"饮醇酒，多近妇女。日夜为乐饮者四岁，竟病酒而卒。","book":"《史记·魏公子列传》"},"example":{"text":"蔡锷软禁京都，正具～计策，破掉那袁政府的疑心。","book":"蔡东藩、许廑父《民国通俗演义》第五十一回"},"similar":["灯红酒绿"],"usage":"作宾语、定语；指酒色","story":["战国时期，赵国被秦兵围困，赵相平原君派人向魏国求救，魏王派大将晋鄙率军救赵，迫于秦国的压力，晋鄙不敢行动。魏公子信陵君盗取兵符，杀了晋鄙，亲自率军救赵。他中了秦王的反间计被魏王免职，他只好纵情于醇酒美人之中"]},{"id":44577,"word":"醇酒美人","pinyin":"chún jiǔ měi rén","abbr":"cjmr","explanation":"指酒色。","source":{"text":"乃谢病不朝，与宾客为长夜饮，饮醇酒，多近妇女。","book":"西汉·司马迁《史记·魏公子列传》"},"example":{"text":"～堪送老，唯君能学信陵君。","book":"清·宋琬《题戴苍画陈阶之小像和王阮亭韵》"},"similar":["醇酒妇人"],"usage":"作主语、宾语、定语；指酒色","story":["战国时期，赵国被秦兵围困，赵相平原君派人向魏国求救，魏王派大将晋鄙率军救赵，迫于秦国的压力，晋鄙不敢行动。魏公子信陵君盗取兵符，杀了晋鄙，亲自率军救赵。他中了秦王的反间计被魏王免职，他只好纵情于醇酒美人之中"]},{"id":44578,"word":"醉吐相茵","pinyin":"zuì tǔ xiāng yīn","abbr":"ztxy","explanation":"后以这一典故喻指宽以待人必然会有好的回报。","source":{"text":"典出《汉书·丙吉传》：“吉驭吏耆酒，数逋荡，尝从吉出， 醉欧丞相车上。西曹主吏白欲斥之，吉曰：‘以醉饱之失去士，使此人将复何所容？西曹地忍之，此不过汙丞相车茵耳。’遂不去也。”此驭吏为边郡人，熟悉边事，后来为防务工作提出切实有用的建议。"}},{"id":44579,"word":"醉墨淋漓","pinyin":"zuì mò lín lí","abbr":"zmll","explanation":"淋漓：充盛、酣畅的样子。乘着酒兴挥毫泼墨。常用以形容行文作画挥洒自如，笔意酣畅。","source":{"text":"想拾遗之高风，醉墨淋漓，放肆纵横，实为一代杰作。","book":"宋·陆游《云安集序》"}},{"id":44580,"word":"醉山颓倒","pinyin":"zuì shān tuí dǎo","abbr":"zstd","explanation":"形容醉态。","source":{"text":"嵇叔夜之为人也，岩岩若孤松之独立；其醉也，傀俄若玉山之将崩。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"当年，吟赏处，～，飞屑成堆。","book":"宋·石孝友《满庭芳·次范倅忆洛阳梅》词"},"similar":["醉玉颓山"],"usage":"作宾语、定语；用于书面语"},{"id":44581,"word":"醉怒醒喜","pinyin":"zuì nù xǐng xǐ","abbr":"znxx","explanation":"酒醉后发怒，酒醒后欢喜","source":{"text":"醉而怒，醒而喜，庸何伤。","book":"春秋·鲁·左丘明《国语·鲁语下》"},"usage":"作谓语、定语；用于书面语"},{"id":44582,"word":"醉死梦生","pinyin":"zuì sǐ mèng shēng","abbr":"zsms","explanation":"像在醉梦中那样昏昏沉沉度日。形容生活目的不明确，糊里糊涂。","source":{"text":"陈涉、吴广起田间，农民之中今在否？一笔，全勾，醉死梦生俦！","book":"郭沫若《前茅·哀时古调》"},"similar":["醉生梦死"],"usage":"作谓语、定语、状语；指人的处世态度"},{"id":44583,"word":"醉玉颓山","pinyin":"zuì yù tuí shān","abbr":"zyts","explanation":"形容男子风姿挺秀，酒后醉倒的风采。","source":{"text":"南朝·宋·刘义庆《世说新语·容止》：“嵇叔夜之为人也，岩岩若孤松之独立；其醉也，傀俄若玉山之将崩。”宋·秦观《满庭芳》词：“相如，方病酒，一觞一咏，宾有群贤。便扶起灯前，醉玉颓山。"},"example":{"text":"且赢取升平快乐，又何辞～，是处有人扶著。","book":"宋·史浩《瑞鹤仙·劝酒》词"},"similar":["醉山颓倒"],"usage":"作宾语、定语；用于比喻句"},{"id":44584,"word":"醉生梦死","pinyin":"zuì shēng mèng sǐ","abbr":"zsms","explanation":"象喝醉酒和做梦那样，昏昏沉沉，糊里糊涂地过日子。","source":{"text":"虽高才明智，胶于见闻，醉生梦死，不自觉也。","book":"宋·朱熹《小学》卷五引程灏曰"},"example":{"text":"一切有志者都不应该～、浑浑噩噩地虚度年华。"},"similar":["花天酒地","纸醉金迷","灯红酒绿"],"opposite":["兢兢业业","节衣缩食","粗茶淡饭"],"usage":"作谓语、定语、状语；指人的处世态度"},{"id":44585,"word":"醉眼朦胧","pinyin":"zuì yǎn méng lóng","abbr":"zyml","explanation":"朦胧：模糊不清。形容醉后两眼模糊不清的样子。","source":{"text":"醉眼朦胧觅归路，松江烟雨晚疏疏。","book":"宋·苏轼《杜介送鱼》"},"example":{"text":"何～，竟忘所自。","book":"清·百一居士《壶天录》下卷"},"similar":["醉眼蒙胧"],"usage":"作谓语、定语、状语；指酒醉的样子"},{"id":44586,"word":"醉眼蒙胧","pinyin":"zuì yǎn méng lóng","abbr":"zyml","explanation":"形容醉后两眼模糊不清的样子","source":{"text":"只见美娘吃得大醉，侍女扶将进来，到于门首，醉眼蒙胧。","book":"明·冯梦龙《醒世恒言》第三卷"},"similar":["醉眼朦胧"],"usage":"作谓语、定语、状语；指酒醉的样子"},{"id":44587,"word":"醉翁之意","pinyin":"zuì wēng zhī yì","abbr":"zwzy","explanation":"之：的；意：意趣。表示本意不在此而在别的方面","source":{"text":"醉翁之意不在酒，在乎山水之间也。","book":"宋·欧阳修《醉翁亭记》"},"example":{"text":"清·李宝嘉《官场现形记》第八回：“仇五科说：‘翩翁是～罢了。’”"},"similar":["醉翁之意不在酒"],"usage":"作宾语；形容人的行动与言语"},{"id":44588,"word":"醉翁之意不在酒","pinyin":"zuì wēng zhī yì bù zài jiǔ","abbr":"zwzybzj","explanation":"原是作者自说在亭子里真意不在喝酒，而在于欣赏山里的风景。后用来表示本意不在此而在别的方面。","source":{"text":"醉瓮之意不在酒，在乎山水之间也。","book":"宋·欧阳修《醉瓮亭记》"},"example":{"text":"松坡果乐此不倦，我也可高枕无忧，但恐～，只借此过渡，瞒人耳目呢。","book":"蔡东藩、许廑父《民国通俗演义》第五二回"},"similar":["醉翁之意"],"usage":"作分句；形容人的行动与言语","story":["北宋时期，滁州太守欧阳修在县城西南风景秀丽的琅琊山“酿泉”边的亭子里，经常约朋友一起喝酒，他给这个亭子取名“醉翁亭”，经常喝得酩酊大醉。因此他作散文《醉翁亭记》：“醉翁之意不在酒，在乎山水之间也。”"]},{"id":44589,"word":"醉舞狂歌","pinyin":"zuì wǔ kuáng gē","abbr":"zwkg","explanation":"形容沉迷于声色歌舞之中。","source":{"text":"蓝桥仙路不崎岖，醉舞狂歌容倦客。","book":"宋·范成大《玉楼春》词"},"example":{"text":"我这里～，繁华梦已参破。","book":"元·关汉卿《鲁斋郎》第四折"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":44590,"word":"醉酒饱德","pinyin":"zuì jiǔ bǎo dé","abbr":"zjbd","explanation":"感谢主人宴请的客气话。","source":{"text":"既醉以酒，既饱以德。君子万年，介尔景福。","book":"《诗经·大雅·既醉》"},"example":{"text":"到了～之后，各学师引了五位生童上二堂禀谢。","book":"清·李绿园《歧路灯》第九十二回"},"usage":"作谓语；指感谢主人宴请的客气话"},{"id":44591,"word":"醋坛子","pinyin":"cù tán zǐ","abbr":"ctz","explanation":"装醋的坛子，指在男女关系上嫉妒心很强的人。","example":{"text":"他们家打烂了～，整天都不得安宁。"},"similar":["醋罐子"],"usage":"作主语、宾语、定语；多用于女人"},{"id":44592,"word":"醋海翻波","pinyin":"cù hǎi fān bō","abbr":"chfb","explanation":"醋：比喻嫉妒。比喻男女间因爱情而引起的纠葛。","example":{"text":"请不要把他们家搅得～。"},"similar":["醋海生波"],"usage":"作谓语、定语、宾语；用于两性间"},{"id":44593,"word":"醍醐灌顶","pinyin":"tí hú guàn dǐng","abbr":"thgd","explanation":"醍醐：酥酪上凝聚的油。用纯酥油浇到头上。佛教指灌输智慧，使人彻底觉悟。比喻听了高明的意见使人受到很大启发。也形容清凉舒适。","source":{"text":"岂知灌顶有醍醐，能使清凉头不热。","book":"唐·顾况《行路难》诗"},"example":{"text":"王生闻得，满心欢喜，却似～，甘露洒心，病体已减去六七分了。 ◎明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["茅塞顿开"],"usage":"主谓式；作谓语、宾语；含褒义"},{"id":44594,"word":"醒聩震聋","pinyin":"xǐng kuì zhèn lóng","abbr":"xkzl","explanation":"犹言振聋发聩。使昏昧糊涂、不明事理的人为之震惊，受到启发。","source":{"text":"一跃而登此庄严美丽之舞台中，一奋萃此醒聩震聋之盘涡里。","book":"陶曾佑《论小说之势力及其影响》"},"similar":["振聋发聩"],"usage":"作谓语、定语；用于书面语"},{"id":44595,"word":"醒骨真人","pinyin":"xǐng gǔ zhēn rén","abbr":"xgzr","explanation":"指盛暑的清风。","source":{"text":"清风云：醒骨真人，六月惠然。","book":"宋·陶谷《清异录·天文》"}},{"id":44596,"word":"醯鸡瓮里","pinyin":"xī jī wèng lǐ","abbr":"xjwl","explanation":"醯鸡：即蠓，酒瓮中生的一种小虫。比喻见闻狭隘的人。","source":{"text":"厥昭生乎湿，醯鸡生乎酒。","book":"《列子·天瑞》"},"similar":["瓮里醯鸡"],"usage":"作宾语；指见闻狭隘的人"},{"id":44597,"word":"醴酒不设","pinyin":"lǐ jiǔ bù shè","abbr":"ljbs","explanation":"醴酒：甜酒。置酒宴请宾客时不再为不嗜酒者准备甜酒。比喻待人礼貌渐衰。","source":{"text":"可以逝矣！醴酒不设，王之意怠，不去，楚人将钳我于市。","book":"《汉书·楚元王传》"},"example":{"text":"待人礼貌衰曰“～”。","book":"宋·胡继宗《书言故事·延接类》"},"usage":"作宾语、定语；用于书面语","story":["西汉时期，楚元王与穆生是好友，穆生不嗜酒，元王每次宴会都会特地为他备醴酒。后来楚王戊即位，宴会不再备醴酒，穆生说：“大王待我的心意不如以前了，我应当走了。不走，就会有杀身之祸。”于是就离开王府"]},{"id":44598,"word":"采光剖璞","pinyin":"cǎi guāng pōu pú","abbr":"cgpp","explanation":"采：采集；璞：含有美玉的石头。采集金子，剖璞取玉。比喻在众人之中选拔优秀人才。","source":{"text":"盐车之骥，自非伯乐，无以显名，采光剖璞，以独见宝，实为足下利之。","book":"汉·荀爽《与郭叔都书》"},"usage":"作谓语、宾语；指挑选人才"},{"id":44599,"word":"采兰赠芍","pinyin":"cǎi lán zèng sháo","abbr":"clzs","explanation":"兰：兰花，花味清香；芍：芍药。比喻男女互赠礼物，表示相爱。","source":{"text":"维士与女，伊其相谑，赠之以芍药。","book":"《诗经·郑风·溱洧》"},"example":{"text":"～终何奈，借琐消奇恰未安。","book":"姚锡钧《似了公》诗"},"similar":["采兰赠药"],"usage":"作谓语、定语；表示男女相爱"},{"id":44600,"word":"采兰赠药","pinyin":"cǎi lán zèng yào","abbr":"clzy","explanation":"兰：兰花，花味清香；药：芍药。比喻男女互赠礼物，表示相爱。","source":{"text":"维士与女，伊其相谑，赠之以芍药。","book":"《诗经·郑风·溱洧》"},"example":{"text":"怪道前日老哥同老嫂在桃园大乐！这就是你弹琴饮酒，～的风流了。","book":"清·吴敬梓《儒林外史》第三十回"},"similar":["采兰赠芍"],"usage":"作谓语、定语；表示男女相爱"},{"id":44601,"word":"采凤随鸦","pinyin":"cǎi fèng suí yā","abbr":"cfsy","explanation":"比喻才貌出众的女子嫁给远不如自己的男人。"},{"id":44602,"word":"采及葑菲","pinyin":"cǎi jí fēng fēi","abbr":"cjff","explanation":"别人征求自己意见时表示谦虚的说法。","source":{"text":"采葑采菲，无以下体？德音莫违，及尔同死。","book":"《诗经·国风·邶风》"},"example":{"text":"弟见世兄浪滚风飘，又怕徒惹絮聒，今既～，敢不敬献刍荛。","book":"清·李绿园《歧路灯》第六十三回"},"similar":["采葑采菲"],"usage":"作谓语；用于自谦"},{"id":44603,"word":"采善贬恶","pinyin":"cǎi shàn biǎn è","abbr":"csbe","explanation":"采：选择；贬；贬斥。采取善良的行为，贬斥恶劣的行径。","source":{"text":"《春秋》采善贬恶，推三代之德。","book":"西汉·司马迁《史记·太史公自序》"},"usage":"作谓语、定语；用于处世"},{"id":44604,"word":"采擢荐进","pinyin":"cǎi zhuó jiàn jìn","abbr":"czjj","explanation":"擢：选拔，提拔；荐：推荐。指对人才的选拔、举荐和提升。","source":{"text":"乃反得蒙采擢荐进，光耀如此。","book":"唐·韩愈《感二鸟赋》"},"usage":"作谓语、宾语；用于选拔人才"},{"id":44605,"word":"采椽不斫","pinyin":"cǎi chuán bù zhuó","abbr":"ccbz","explanation":"采：柞木。比喻生活简朴。","source":{"text":"尧之王天下也，茅茨不翦，采椽不斫。","book":"战国·韩·韩非《韩非子·五蠹》"},"example":{"text":"不及唐尧，～。世叹伯夷，欲以厉俗。","book":"三国·魏·曹操《度关山》"},"similar":["茅茨不翦"],"usage":"作谓语、定语；指住房简陋"},{"id":44606,"word":"采葑采菲","pinyin":"cǎi fēng cǎi fēi","abbr":"cfcf","explanation":"比喻不因其所短而舍其所长。葑即蔓青，叶和根、茎地可食，但根茎味苦。","source":{"text":"采葑采菲，无以下体。","book":"语出《诗·邶风·谷风》"},"example":{"text":"旧部当尊之人，相马不失之瘦，～取节焉。","book":"宋·陈亮《与章德茂侍郎书》"},"similar":["采及葑菲"],"usage":"作主语、谓语；比喻取其所长"},{"id":44607,"word":"采薪之忧","pinyin":"cǎi xīn zhī yōu","abbr":"cxzy","explanation":"采薪：打柴。病了不能打柴。自称有病的婉辞。","source":{"text":"昔者有王命，有采薪之忧，不能造朝。","book":"《孟子·公孙丑下》"},"example":{"text":"欲诣帐下，以叙数载间阔之情；奈至河中府普救寺，忽值～。","book":"元·王实甫《西厢记》第二本楔子"},"similar":["采薪之疾"],"usage":"作主语、宾语；有病的婉称"},{"id":44608,"word":"采薪之患","pinyin":"cǎi xīn zhī huàn","abbr":"cxzh","explanation":"病了不能打柴。自称有病的婉辞。","source":{"text":"见“采薪之忧”。"},"example":{"text":"漏已三转，犹徘徊桐槛之下，竟为风露所欺，致获～。","book":"《红楼梦》第三七回"},"similar":["采薪之忧","采薪之疾"],"usage":"作主语、宾语；有病的婉称","story":["大观园内整天吃喝玩乐，日子有点单调，探春在采薪之患时突发奇想，想组织一个诗社，以打发这无聊的时光，于是给宝玉、黛玉、宝钗等写信，邀请他们参加。宝玉特别喜欢吟诗作赋，欣然参加，于是他们就组成七人的海棠社"]},{"id":44609,"word":"采薪之疾","pinyin":"cǎi xīn zhī jí","abbr":"cxzj","explanation":"病了不能打柴。自称有病的婉辞。","source":{"text":"见“采薪之忧”。"},"example":{"text":"先朝备位，每怀窃食之惭；故里服丧，重困～。","book":"宋·王安石《辞参知政事表》"},"similar":["采薪之忧"],"usage":"作主语、宾语；有病的婉称"},{"id":44610,"word":"采风问俗","pinyin":"cǎi fēng wèn sú","abbr":"cfws","explanation":"采集歌谣，访问风俗。","source":{"text":"采风问俗，纪载宜详；品翠题红，篇章争丽。","book":"清·俞蛟《梦厂杂著·潮嘉风月》"},"example":{"text":"～周详甚，应有輶轩异代求。","book":"柳亚子《题辞》诗之十二"},"usage":"作谓语、宾语、主语；指采集民间习俗等"},{"id":44611,"word":"释回增美","pinyin":"shì huí zēng měi","abbr":"shzm","explanation":"指去除邪僻，增加美善。回，指邪僻。","source":{"text":"礼，释回，增美质。","book":"西汉·戴圣《礼记·礼器》"},"example":{"text":"为之～，是震旦所以卓绝矣。","book":"章炳麟《代议然否论》"},"usage":"作谓语、定语；用于劝诫人"},{"id":44612,"word":"释生取义","pinyin":"shì shēng qǔ yì","abbr":"ssqy","explanation":"犹言舍生取义。","source":{"text":"[郭修]于广坐之中手刃击褘，勇过聂政，功逾介子，可谓杀身成仁，释生取义者矣。","book":"《三国志·魏志·齐王芳传达室》"},"similar":["舍生取义"],"usage":"作谓语、定语；指为正义而牺牲生命"},{"id":44613,"word":"释知遗形","pinyin":"shì shì yí xíng","abbr":"szyx","explanation":"犹言弃智忘身。指超然物外，与世无争。","source":{"text":"释知遗形兮，超然自丧；寥廓忽荒兮，与道翱翔。","book":"《史记·屈原贾生列传》"},"similar":["弃智忘身"],"usage":"作宾语、定语；用于书面语"},{"id":44614,"word":"释缚焚榇","pinyin":"shì fù fén chèn","abbr":"sffc","explanation":"指解开降者的捆绑，烧悼降者带来的棺材。是使降者安心的一种表示。","source":{"text":"成王克许，许僖公如是。王亲释其缚，受其璧，焚其榇。","book":"语出《左传·昭公四年》"},"example":{"text":"苌至姑臧，天锡乘素车白马，面缚舆榇，降于军门，苌～，送之于长安。","book":"《晋书·苻坚载记上》"},"usage":"作宾语、定语；用于书面语"},{"id":44615,"word":"释车下走","pinyin":"shì chē xià zǒu","abbr":"scxz","explanation":"释：放下，放开。下车徒步跑。形容遇事不冷静。","source":{"text":"行数百数，以驹为不疾，夺辔代之；御可数百步，以马为不进，尽释车而走。","book":"战国·韩·韩非《韩非子·外储说左上》"},"usage":"作谓语、定语；指人急切的心情","story":["春秋时期，齐景公出游到少海，宫廷派人来报告说相国晏婴病得非常厉害。如果回去晚了就见不到他的面了，景公急忙上了车，刚走不远，景公认为车夫驾得太慢，就亲自驾车往回赶。又没走多远，他还认为马太慢就跳下马车徒步往回跑"]},{"id":44616,"word":"里丑捧心","pinyin":"lǐ chǒu pěng xīn","abbr":"lcpx","explanation":"指妄学别人而愈见其丑。","source":{"text":"西施病心而矉其里，其里之丑人见而美之，归亦捧心而矉其里。其里之富人见之，坚闭门而不出；贫人见之，挈妻子而去之走。","book":"战国·宋·庄周《庄子·天运》"},"example":{"text":"～，不关西施之颦矣。","book":"南朝·梁·刘勰《文心雕龙·杂文》"},"similar":["东施效颦"],"usage":"作宾语、定语；指妄学别人而愈见其丑"},{"id":44617,"word":"里出外进","pinyin":"lǐ chū wài jìn","abbr":"lcwj","explanation":"形容不平整、不整齐。","example":{"text":"这面墙砌得里出外进的，只好拆了重修。"},"similar":["参差不齐"],"opposite":["平平整整"],"usage":"作谓语、定语；用于指物体的表面"},{"id":44618,"word":"里勾外连","pinyin":"lǐ gōu wài lián","abbr":"lgwl","explanation":"内外勾结，串通一气。","source":{"text":"你这厮是北京本处良民，如何却去投梁山落草，坐了第二把交椅？如今倒来里钩外连，要打北京！","book":"明·施耐庵《水浒》第六十二回"},"example":{"text":"这两个就～的朋比为奸，闹的不成样子。","book":"清·吴趼人《糊涂世界》第七回"},"similar":["里应外合"],"usage":"作谓语、定语、宾语；指内外勾结，串通一气"},{"id":44619,"word":"里外夹攻","pinyin":"lǐ wài jiā gōng","abbr":"lwjg","explanation":"从里、外两方面配合同时进攻。","source":{"text":"乃取其军号，内外夹攻，号令相应，淮人以为神，遂人败之。","book":"《新五代史·吴越世家》"},"example":{"text":"清·李汝珍《镜花缘》第12回：“～，百般凌辱。”"},"similar":["内外夹攻"],"usage":"作谓语、宾语、定语；指同时进攻"},{"id":44620,"word":"里巷之谈","pinyin":"lǐ xiàng zhī tán","abbr":"lxzt","explanation":"出于街头巷尾的谈论。也指没有知识的人所说的话。多指轻视他人说的话，不值得重视。","source":{"text":"上自朝廷典章，下至稗里杂家，里谈巷议，无不记览。","book":"宋·曾敏行《独醒杂说·附录》"},"example":{"text":"今～，动以古为诟戏，不知今日口之所食，身之所衣，皆古人遗法而不可违者。","book":"清·毕沅《续资治通鉴》卷一百七十八"}},{"id":44621,"word":"里应外合","pinyin":"lǐ yìng wài hé","abbr":"lywh","explanation":"应：接应；合：配合。外面攻打，里面接应。","source":{"text":"反被韩，魏同谋，里应外合，决水淹我军，甲士溃乱，死者山积。","book":"元·杨梓《豫让吞炭》第三折"},"example":{"text":"过几日，我这里差人去投降，他们必然懈怠，我们却去劫寨，那时～，定获全胜。","book":"清·陈忱《水浒后传》第十七回"},"similar":["里勾外连","内外勾结","里通外国"],"opposite":["孤军深入","孤立无援"],"usage":"作谓语、宾语、定语；指相互配合"},{"id":44622,"word":"里挑外撅","pinyin":"lǐ tiǎo wài juē","abbr":"ltwj","explanation":"阳奉阴违，搬弄是非。","example":{"text":"这种～的人绝不可共事。"},"similar":["阳奉阴违"],"usage":"作谓语、定语；指挑拨是非"},{"id":44623,"word":"里生外熟","pinyin":"lǐ shēng wài shú","abbr":"lsws","explanation":"外表成熟，里面却夹生。形容人或事物里外不一。"},{"id":44624,"word":"里程碑","pinyin":"lǐ chéng bēi","abbr":"lcb","explanation":"路边标志里数的碑。比喻历史具有重大意义的事件。","source":{"text":"这次会议是标志着我国人民从一九四九年建国以来的新胜利和发展的里程碑。","book":"毛泽东《为建设一个伟大的社会主义国家而奋斗》"},"example":{"text":"申奥成功是中国体育事业上的一个～。"},"usage":"作宾语；指路边标志里数的碑"},{"id":44625,"word":"里谈巷议","pinyin":"lǐ tán xiàng yì","abbr":"ltxy","explanation":"里：乡里、邻居。邻里街巷间人们的议论谈说。指民间的议论。","source":{"text":"上自朝廷典章，下至稗里杂家，里谈巷议，无不记览。","book":"宋·曾敏行《独醒杂说·附录》"},"example":{"text":"请不要在乎这些无稽的～"},"similar":["街谈巷议"],"usage":"作主语、宾语、定语；指民间的舆论"},{"id":44626,"word":"里通外国","pinyin":"lǐ tōng wài guó","abbr":"ltwg","explanation":"暗中勾结外国，阴谋叛国。","source":{"text":"大则指为‘里通外国’，就是现在之所谓‘汉奸’。","book":"鲁迅《且介亭杂文·病后杂谈之余》"},"example":{"text":"他～，是一个典型的大汉奸。"},"similar":["卖国求荣","里应外合"],"opposite":["大义灭亲","大义凛然"],"usage":"作谓语、宾语、定语；指暗中勾结外国"},{"id":44627,"word":"里里外外","pinyin":"lǐ lǐ wài wài","abbr":"llww","explanation":"里面和外面。","source":{"text":"如今里里外外上上下下背着我嚼说我的不少，就差你来说了，可知没家亲引不出外鬼来。","book":"清·曹雪芹《红楼梦》第72回"},"example":{"text":"清·曹雪芹《红楼梦》第72回：“如今里里外外上上下下背着我嚼说我的不少，就差你来说了，可知没家亲引不出外鬼来。”"},"similar":["上上下下"],"usage":"作主语、宾语、状语；指里面和外面"},{"id":44628,"word":"重三叠四","pinyin":"chóng sān dié sì","abbr":"csds","explanation":"形容多次重复。","source":{"text":"经书中所言只是一个道理，都重三叠四说在理，只是许多头面出来。","book":"宋·朱熹《朱子语类》卷一百一十二：“本朝建官重三叠四，多少劳扰！此须大有为后痛更革之。”又卷一百一十八"},"similar":["重三迭四"],"usage":"作定语、状语；指重复"},{"id":44629,"word":"重三迭四","pinyin":"chóng sān dié sì","abbr":"csds","explanation":"形容多次重复。"},{"id":44630,"word":"重义轻生","pinyin":"zhòng yì qīng shēng","abbr":"zyqs","explanation":"指看重义行而轻视生命。","source":{"text":"重义轻生，亡躯殉节。劲松方操，严霜比烈。","book":"《晋书·忠义传赞》"},"example":{"text":"～一剑知，白虹贯日报雠归。","book":"唐·沈彬《结客少年场行》"},"similar":["重气轻命","重气轻身","重气轻生"],"usage":"作谓语、定语、宾语；用于处事"},{"id":44631,"word":"重义轻财","pinyin":"zhòng yì qīng cái","abbr":"zyqc","explanation":"指看重仁义而轻视钱财。","source":{"text":"古者贵德而贱利，重义而轻财。","book":"汉·桓宽《盐铁论·错币》"},"example":{"text":"～大丈夫。","book":"明·沈受先《三元记·博施》"},"similar":["仗义疏财"],"usage":"作谓语、定语、宾语；用于处事"},{"id":44632,"word":"重于泰山","pinyin":"zhòng yú tài shān","abbr":"zyts","explanation":"比泰山还要重。比喻人死得很有价值。也形容意义重大。","source":{"text":"人固有一死，或重于泰山，或轻于鸿毛。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"子鲜之势，～矣。","book":"明·冯梦龙《东周列国志》第六十五回"},"similar":["彪炳千古","万古流芳"],"opposite":["轻于鸿毛"],"usage":"作谓语、定语；用于死的价值或其他","story":["西汉时期，太史令司马迁为实现父亲的遗愿继续编著《史记》，因李陵事件被施以酷刑。他强忍痛苦，终于在公元前91年完成历史巨著《史记》。他在给朋友的信中谈到对死的认识：“人固有一死，或重于泰山，或轻于鸿毛。”"]},{"id":44633,"word":"重于泰山，轻于鸿毛","pinyin":"zhòng yú tài shān，qīng yú hóng máo","abbr":"zytsqyhm","explanation":"泰山：山名，在山东省，主峰海拔1524米；鸿毛：大雁的毛。形容意义重大或比大雁的毛还轻，指双重价值","source":{"text":"是的，刘宇要死了。人固有一死，或重于泰山，或轻于鸿毛。刘宇如果死了，究竟算泰山还是算鸿毛，只有天晓得。","book":"高晓声《刘宇写书》"},"usage":"作宾语、定语；用于书面语"},{"id":44634,"word":"重作冯妇","pinyin":"chóng zuò féng fù","abbr":"zzff","explanation":"表示人又重操旧业。","source":{"text":"曾经有一位总长，听说他的出来就职，是因为某公司要来立案，表决时可以多一个赞成者，所以重作冯妇的。","book":"鲁迅《而已集·反漫谈》"},"example":{"text":"赵师傅不当苦力已有十多年了，迫于生计艰难，现在只能～。"},"similar":["再作冯妇","再当冯妇"],"usage":"作谓语、宾语、定语；指重操旧业"},{"id":44635,"word":"重修旧好","pinyin":"chóng xiū jiù hǎo","abbr":"cxjh","explanation":"恢复旧情，重归于好。","source":{"text":"既然洋人已和我国重修旧好，为世界和平计，我们是否一定要再启战端？","book":"王朔《千万别把我当人》"},"example":{"text":"我们已经～了。"},"similar":["重归于好"],"usage":"作谓语；同“重归于好”"},{"id":44636,"word":"重光累洽","pinyin":"chóng guāng lèi qià","abbr":"cglq","explanation":"指前后功绩相继，累世升平。","source":{"text":"重光累洽，下武嗣文，负扆而化，垂衣以君。","book":"唐·崔融《嵩山启母庙碑》"},"similar":["重熙累洽"],"usage":"作谓语、定语；指繁荣稳定"},{"id":44637,"word":"重关击柝","pinyin":"chóng guān jī tuò","abbr":"cgjt","explanation":"设置重门，击柝（木梆）巡夜。指警戒森严。","source":{"text":"所以未具上闻者，欲待至上，面自咨申。不图重关击柝，觐接莫由。","book":"《宋书·沈攸之传》"},"similar":["重门击柝"],"usage":"作谓语；指戒备森严"},{"id":44638,"word":"重兴旗鼓","pinyin":"chóng xīng qí gǔ","abbr":"cxqg","explanation":"犹言重整旗鼓。","source":{"text":"现下招集人才，团练军马，倘有机会可乘，一定重兴旗鼓。","book":"清·新广东武生《黄萧养回头》"},"similar":["重振旗鼓"],"usage":"作谓语、宾语、定语；用于个人、团体等"},{"id":44639,"word":"重利盘剥","pinyin":"zhòng lì pán bō","abbr":"zlpb","explanation":"利：利息；盘剥：借贷银钱，盘算剥削。指发放高利贷，进行残酷剥削。","source":{"text":"好个重利盘剥！很该全抄！请王爷就此坐下，叫奴才去全抄来再候定夺罢。","book":"清·曹雪芹《红楼梦》第一百五回"},"example":{"text":"往者英国常禁酒矣，而民之酗酒者愈多；常禁～矣，而私债之息更重。（清·严复《原强》）"},"usage":"作宾语、定语；用于书面语"},{"id":44640,"word":"重厚寡言","pinyin":"zhòng hòu guǎ yán","abbr":"zhgy","explanation":"持重敦厚，不爱多说话。","source":{"text":"襄重厚寡言，务以镇静守法。","book":"《金史·襄传》"}},{"id":44641,"word":"重厚少文","pinyin":"zhòng hòu shǎo wén","abbr":"zhsw","explanation":"持重敦厚而少于文饰。","source":{"text":"已而吕后问：‘阶下百岁后，萧相国即死，令谁代之?'上曰：‘曹参可。’问其次，上曰：‘……陈平智有余，然难以独任。周勃重厚少文，然安刘氏者必勃也，可令为太尉。’","book":"《史记·高祖本纪》"},"usage":"作谓语、定语；用于书面语"},{"id":44642,"word":"重圭叠组","pinyin":"chóng guī dié zǔ","abbr":"cgdz","explanation":"指世代连续做官。","source":{"text":"予闻世之右族，重圭叠组者有之矣，索其家学相仍数世而弗坠，十百之中或一二见焉。","book":"明·宋濂《故东吴先生吴公墓碣铭》"}},{"id":44643,"word":"重垣叠锁","pinyin":"chóng yuán dié suǒ","abbr":"cyds","explanation":"重复的垣墙，重叠的锁钥。指深宫内苑，防护严密。","source":{"text":"她们从她们那神妙的故乡，移到这重垣叠锁的宫里来，她们的悲哀已就不堪设想了，那知道她们还有更悲痛的事情令人难受。","book":"郭沫若《王昭君》第一幕"},"similar":["重垣迭锁"],"usage":"作宾语、定语；指防备森严"},{"id":44644,"word":"重垣迭锁","pinyin":"chóng yuán dié suǒ","abbr":"cyds","explanation":"重复的垣墙，重迭的锁钥。指深宫内苑，防护严密。"},{"id":44645,"word":"重增其放","pinyin":"chong zhen qi fang","abbr":"zzqf","explanation":"更助长了我的狂放。"},{"id":44646,"word":"重山复岭","pinyin":"chóng shān fù lǐng","abbr":"csfl","explanation":"指山峦重叠层接。","source":{"text":"予使于滇，行将万里，所越皆重山复岭，以舆以马，颠顿驰跋，而不任其劳。","book":"明·何景明《进舟赋》序"},"similar":["重峦叠嶂"],"opposite":["一马平川"],"usage":"作宾语、定语；用于山脉等"},{"id":44647,"word":"重山复水","pinyin":"chóng shān fù shuǐ","abbr":"csfs","explanation":"指山峦重叠，水流盘曲。","source":{"text":"平昔常闻风水洞，重山复水去无穷。","book":"宋·林逋《风水洞》诗"},"example":{"text":"此日一帆凭顾盼，～是江南。","book":"陈毅《东征初抵高淳》诗"},"similar":["山重水复"],"usage":"作主语、宾语；用于风景等"},{"id":44648,"word":"重山峻岭","pinyin":"chóng shān jùn lǐng","abbr":"csjl","explanation":"重：重叠；峻：高。连绵起伏的山岭","source":{"text":"使周览江、浙、荆、湘重山峻岭，江湘溪涧之胜丽，以为笔端之助，则也不减晋宋流辈。","book":"《宣和画谱·赵令穰》"},"example":{"text":"清·李百川《绿野仙踪》第61回：“觉～之中，另具一番隐秀。”"},"similar":["崇山峻岭"],"usage":"作宾语、定语；用于山脉等"},{"id":44649,"word":"重岩叠嶂","pinyin":"chóng yán dié zhàng","abbr":"cydz","explanation":"形容山岭重重叠叠，连绵不断。","source":{"text":"自三峡七百里中，两岸连山，略无阙处，重岩叠嶂，隐天蔽日。","book":"北魏·郦道元《水经注·江水二》"},"example":{"text":"秋来奉诏写秋山，写在轻绡数幅间；高低向背无遗势，～何孱颜。","book":"唐·徐光溥《题黄居寀秋山图》"},"similar":["重峦叠嶂"],"usage":"作主语、宾语、定语；指山连绵不断"},{"id":44650,"word":"重岩叠障","pinyin":"chóng yán dié zhàng","abbr":"zydz","explanation":"山峰一个连着一个，连绵不断。","source":{"text":"秋来奉诏写秋山，写在轻绡数幅间；高低向背无遗势，重峦叠嶂何孱颜。","book":"唐·徐光溥《题黄居寀秋山图》"}},{"id":44651,"word":"重岩迭嶂","pinyin":"zhòng yán dié zhàng","abbr":"zydz","explanation":"山峰一个连着一个，连绵不断。同“重岩迭嶂”。"},{"id":44652,"word":"重岩迭障","pinyin":"chóng yán dié zhàng","abbr":"cydz","explanation":"山峰一个连着一个，连绵不断。","source":{"text":"秋来奉诏写秋山，写在轻绡数幅间；高低向背无遗势，重峦迭嶂何孱颜。","book":"唐·徐光溥《题黄居寀秋山图》"}},{"id":44653,"word":"重峦叠嶂","pinyin":"chóng luán dié zhàng","abbr":"cldz","explanation":"峦：连绵的山。山峰一个连着一个，连绵不断。","source":{"text":"秋来奉诏写秋山，写在轻绡数幅间；高低向背无遗势，重峦叠嶂何孱颜。","book":"唐·徐光溥《题黄居寀秋山图》"},"example":{"text":"仲武登陴死守，日宿于戍楼，夜尚烧烛为友人画～，笔墨安祥，意气生动，识者服其胆略。","book":"明·张岱《家传·附传》"},"similar":["层峦叠嶂","重峦复嶂"],"opposite":["一马平川"],"usage":"作主语、宾语、定语；指山连绵不断"},{"id":44654,"word":"重峦叠巘","pinyin":"chóng luán dié yǎn","abbr":"cldy","explanation":"形容山岭重重叠叠，连绵不断。同“重峦叠嶂”。","source":{"text":"其山（雁门山）重峦叠巘，霞举云高，连山隐隐，东出辽塞。","book":"北魏·郦道元《水经注·漯水》"},"similar":["重峦复嶂"],"usage":"作谓语、定语、宾语；指山脉"},{"id":44655,"word":"重峦复嶂","pinyin":"chóng luán fù zhàng","abbr":"clfz","explanation":"形容山岭重重叠叠，连绵不断。同“重峦叠嶂”。","source":{"text":"看那山势，虽不比梁山广，却也险峻，周围重峦复嶂，只有山前一条大路。","book":"清·陈忱《水浒后传》第二回"},"similar":["重峦叠巘","重峦叠嶂"],"opposite":["一马平川"],"usage":"作谓语、定语、宾语；指山脉"},{"id":44656,"word":"重峦迭嶂","pinyin":"chóng luán dié zhàng","abbr":"cldz","explanation":"峦：连绵的山。山峰一个连着一个，连绵不断。","source":{"text":"秋来奉诏写秋山，写在轻绡数幅间；高低向背无遗势，重峦迭嶂何孱颜。","book":"唐·徐光溥《题黄居寀秋山图》"},"example":{"text":"仲武登陴死守，日宿于戍楼，夜尚烧烛为友人画～，笔墨安祥，意气生动，识者服其胆略。","book":"明·张岱《家传·附传》"}},{"id":44657,"word":"重峦迭巘","pinyin":"chóng luán dié yǎn","abbr":"cldy","explanation":"山峰一个连着一个，连绵不断。同“重峦迭嶂”。"},{"id":44658,"word":"重床叠屋","pinyin":"chóng chuáng dié wū","abbr":"ccdw","explanation":"比喻重复繁多。","source":{"text":"战时的政治机关，贵简单而不贵复杂，机关应集中而不应重床叠屋。","book":"周恩来《“七七”四年》"},"similar":["重床叠架"],"usage":"作谓语、定语；用于重复"},{"id":44659,"word":"重床叠架","pinyin":"chóng chuáng dié jià","abbr":"ccdj","explanation":"比喻重复繁多。","source":{"text":"重床叠架的法令，何尝不严密堂皇，然而，解决了问题么？","book":"茅盾《清明前后》第五幕"},"similar":["重床叠屋"],"usage":"作谓语、定语；用于重复"},{"id":44660,"word":"重床迭屋","pinyin":"chóng chuáng dié wū","abbr":"ccdw","explanation":"比喻重复繁多。同“重床迭架”。"},{"id":44661,"word":"重床迭架","pinyin":"chóng chuáng dié jià","abbr":"ccdj","explanation":"比喻重复繁多。"},{"id":44662,"word":"重张旗鼓","pinyin":"chóng zhāng qí gǔ","abbr":"zzqg","explanation":"重：重新；旗鼓：古时作战用的旌旗与战鼓。比喻失败或受挫折后，重新整顿与组织力量，准备再干。","source":{"text":"圣清室已覆，袁为总统，他自然重张旗鼓，又复上台。","book":"蔡东藩《民国通俗演义》第48回"},"similar":["重整旗鼓","重振旗鼓"],"usage":"作谓语、宾语、定语；用于个人、团体等"},{"id":44663,"word":"重弹老调","pinyin":"chóng tán lǎo diào","abbr":"ctld","explanation":"又弹起陈旧的老调子。比喻把说过多次的理论、主张重新搬出来。也比喻把搁置很久的技艺重新做起来。"},{"id":44664,"word":"重归于好","pinyin":"chóng guī yú hǎo","abbr":"zgyh","explanation":"归于：回到；好：和好。指彼此重新和好。","example":{"text":"他们摒弃前嫌，～。"},"similar":["言归于好"],"opposite":["分道扬镳"],"usage":"作谓语、定语、宾语；用于人或组织等"},{"id":44665,"word":"重德不报","pinyin":"zhòng dé bù bào","abbr":"zdbb","explanation":"恩德重大，却无法得到相应的报答。","source":{"text":"原曰：‘事君无二心，人臣之职也。原知罪矣。’遂自杀。厉公于是谓甫假曰：‘子之事君有二心矣。’遂诛之。假曰：‘重德不报，诚然哉！’","book":"《史记·郑世家》"},"usage":"作宾语、定语；用于书面语"},{"id":44666,"word":"重手累足","pinyin":"chóng shǒu lěi zú","abbr":"cslz","explanation":"两手相重，两足相叠，不敢有所举动。形容十分恐惧的样子。","source":{"text":"故所在豪人猾吏，重手累足，以终君去，不敢有所触。","book":"宋·王安石《广西转运使李君墓志铭》"},"usage":"作谓语、定语；用于惊恐"},{"id":44667,"word":"重打鼓，另开张","pinyin":"chóng dǎ gǔ，lìng kāi zhāng","abbr":"zdglkz","explanation":"重：重新。比喻重新开始，另起炉灶。","source":{"text":"搬家，跟父亲痛痛快快的说一回，或者甚至闹一回，闹完了，重打鼓，另开张，干！","book":"老舍《二马》第四段"},"similar":["另起炉灶","重整旗鼓"],"usage":"作谓语、定语；用于重新开始"},{"id":44668,"word":"重振旗鼓","pinyin":"chóng zhèn qí gǔ","abbr":"czqg","explanation":"比喻失败后，整顿再起。","source":{"text":"侬欲重振旗鼓，烦你拟篇男女平权文劝戒女子。","book":"清·湘灵子《轩亭冤·惊梦》"},"example":{"text":"我深信我们在这样挣扎苦斗中所获得的极可宝贵的经验，对于将来～的《生活日报》是有很大的裨益的。","book":"邹韬奋《经历》五九"},"similar":["重整旗鼓","重兴旗鼓"],"usage":"作谓语、宾语、定语；用于个人、团体等"},{"id":44669,"word":"重提旧事","pinyin":"chóng tí jiù shì","abbr":"ctjs","explanation":"又重新谈起以往的事项或情景。","example":{"text":"请不要～了。"},"similar":["旧事重提"],"usage":"作谓语、宾语；指旧事重提"},{"id":44670,"word":"重操旧业","pinyin":"chóng cāo jiù yè","abbr":"ccjy","explanation":"指再做以前曾做的事。","source":{"text":"赛金花随洪钧的棺材返苏入葬时，突然中途变卦，跑到上海重操旧业，改名曹梦兰，悬牌应客。","book":"吴趋《姑苏野史·赛金花二三事》"},"example":{"text":"他不得不～。"},"similar":["重温旧业"],"opposite":["金盆洗手"],"usage":"作谓语、宾语；指重新开始"},{"id":44671,"word":"重整旗鼓","pinyin":"chóng zhěng qí gǔ","abbr":"czqg","explanation":"整：整顿，收拾。比喻失败之后，整顿力量，准备再干。","source":{"text":"依欲重振旗鼓，烦你拟篇男女乎权文，劝戒女子。","book":"清·萧山湘灵子《轩亭冤》卷上"},"example":{"text":"至清室已覆，袁为总统，他自然～，又复上台。”","book":"蔡东藩、许廑父《民国通俗演义》第四十八回"},"similar":["东山再起","卷土重来","另起炉灶"],"opposite":["偃旗息鼓","一蹶不振"],"usage":"作谓语、宾语、定语；用于个人、团体等"},{"id":44672,"word":"重新做人","pinyin":"chóng xīn zuò rén","abbr":"cxzr","explanation":"指已认识、悔改所犯罪过，并以此为起点重新塑自己的形象。"},{"id":44673,"word":"重施故伎","pinyin":"chóng shī gù jì","abbr":"zsgj","explanation":"重新施用过去的伎俩。","example":{"text":"～是达不到目的的。"},"similar":["故伎重施"],"usage":"作主语、谓语、宾语；指故技重演"},{"id":44674,"word":"重明继焰","pinyin":"chóng míng jì yàn","abbr":"cmjy","explanation":"指光焰相继，长明不息。","source":{"text":"因其支分派别，源流不绝，则名之曰宗；因其重明继焰，明明无尽，则称之曰灯，其实一也。","book":"明·李贽《五宗说》"},"usage":"作谓语、定语；用于书面语"},{"id":44675,"word":"重望高名","pinyin":"zhòng wàng gāo míng","abbr":"zwgm","explanation":"拥有崇高的名望。","source":{"text":"唯顾泾阳宪臣以铨郎救辛总宪外谪，后再入吏部，最为创见，然重望高名，终不得志而去。","book":"明·沈德符《野获编·吏部一·台省互改》"},"usage":"作宾语、定语；用于书面语"},{"id":44676,"word":"重楼飞阁","pinyin":"chóng lóu fēi gé","abbr":"zlfg","explanation":"重：重叠；飞阁：高阁。形容楼台高阁很多。","source":{"text":"在城内作光极殿，因名金墉城门为光极门，又作重楼飞阁，遍城上下，从地望之，有如云也。","book":"北魏·杨衒之《洛阳伽蓝记·城内瑶光寺》"},"usage":"作宾语、定语；用于建筑物"},{"id":44677,"word":"重此抑彼","pinyin":"zhòng cǐ yì bǐ","abbr":"zcyb","explanation":"重：重视；抑：压制，贬低。重视这个，压制那个。指待人或处事不公平。","example":{"text":"老师对学生不能有～的做法。"},"similar":["厚此薄彼"],"usage":"作谓语、定语；指偏爱"},{"id":44678,"word":"重气徇名","pinyin":"zhòng qì xùn míng","abbr":"zqxm","explanation":"徇：曲从，偏私。重视义气，慕求声名","source":{"text":"田文重气徇名，四豪莫及。","book":"南朝·梁·沈约《为东宫谢敕赐孟尝君剑启》"},"usage":"作谓语、定语；用于处事"},{"id":44679,"word":"重气徇命","pinyin":"zhòng qì xùn míng","abbr":"zqxm","explanation":"重视义气，慕求声名。","source":{"text":"田文重气徇命，四豪莫及。","book":"南朝·梁·沈约《为东宫谢敕赐孟尝君剑启》"}},{"id":44680,"word":"重气狥名","pinyin":"zhòng qì xùn míng","abbr":"zqxm","explanation":"重视义气，慕求声名。"},{"id":44681,"word":"重气猣名","pinyin":"zhòng qì xùn míng","abbr":"zqxm","explanation":"重视义气，慕求声名。"},{"id":44682,"word":"重气轻命","pinyin":"zhòng qì qīng mìng","abbr":"zqqm","explanation":"指看重义行而轻视生命。","source":{"text":"是以雄俊之徒，交党结伦，重气轻命，感分遗身。","book":"三国·魏·曹植《七启》"},"similar":["重气轻生","重气轻身","重义轻生"],"usage":"作谓语、定语、宾语；用于处事"},{"id":44683,"word":"重气轻生","pinyin":"zhòng qì qīng shēng","abbr":"zqqs","explanation":"指看重义行而轻视生命。","source":{"text":"沙场积路何为尔，重气轻生如许国。","book":"唐·张说《巡边河北作》诗之一"},"example":{"text":"我们不提倡～的做法"},"similar":["重气轻命","重气轻身","重义轻生"],"usage":"作谓语、定语、宾语；用于处事"},{"id":44684,"word":"重气轻身","pinyin":"zhòng qì qīng shēn","abbr":"zqqs","explanation":"指重义节而轻生死。","source":{"text":"去年六月西河西，今年六月北河北。沙场磧路何为尔，重气轻身知许国。","book":"唐·张说《巡边在河北作》诗"},"similar":["重气轻命","重气轻生","重义轻生"],"usage":"作谓语、定语、宾语；用于处事"},{"id":44685,"word":"重温旧业","pinyin":"chóng wēn jiù yè","abbr":"cwjy","explanation":"指再做以前曾做的事。","source":{"text":"亮青年立志，白首奋身，敢不益励初心，期在重温旧业。","book":"宋·陈亮《谢留丞相启》"},"similar":["重操旧业"],"usage":"作谓语、宾语；指重新开始"},{"id":44686,"word":"重温旧梦","pinyin":"chóng wēn jiù mèng","abbr":"cwjm","explanation":"温：复习，指回忆，体味。比喻再经历一次过去的光景。","source":{"text":"水木清华负郭园，三年客梦此重温。眼中故物诗留壁，身后浮文酒满樽。","book":"清·丘逢甲《岭云每日楼诗钞·重过感旧园二首》诗"},"example":{"text":"开始写《第四病室》的时候，因为“记忆犹新”，我的确有“～”的感觉。","book":"巴金《谈〈第四病室〉》"},"similar":["旧梦重温","破镜重圆"],"opposite":["永不相见"],"usage":"作谓语、宾语、定语；指回忆"},{"id":44687,"word":"重熙累叶","pinyin":"chóng xī lěi yè","abbr":"cxly","explanation":"形容累世圣明有德，天下升平昌盛。同“重熙累洽”。","source":{"text":"三光再朗，庶绩其凝。重熙累叶，景命是膺。","book":"《旧唐书·音乐志四》"},"similar":["重熙累盛"],"usage":"作谓语、定语；指繁荣稳定"},{"id":44688,"word":"重熙累洽","pinyin":"chóng xī lěi qià","abbr":"cxlq","explanation":"熙：光明；洽：谐和。指国家接连几代太平安乐。","source":{"text":"至乎永平之际，重熙而累洽。”张铣注：‘熙：光明也。洽：合也；言光武既明，而明帝继之，故曰重熙累洽。","book":"汉·班固《东都赋》"},"example":{"text":"宣庙临御，当～，四海无虞，万几之暇，留神词翰。","book":"明·韩昂《图绘宝鉴·皇明》"},"similar":["重光累洽","重熙累盛","重熙累叶"],"usage":"作谓语、定语；指繁荣稳定"},{"id":44689,"word":"重熙累盛","pinyin":"chóng xī lěi shèng","abbr":"cxls","explanation":"形容累世圣明有德，天下升平昌盛。同“重熙累洽”。","source":{"text":"国家系本仙宗，业承圣祖，重熙累盛，既锡无疆之休，合享登神，思弘不易之典。","book":"《旧唐书·礼仪志六》"},"similar":["重熙累叶"],"usage":"作谓语、定语；指繁荣稳定"},{"id":44690,"word":"重熙累绩","pinyin":"chóng xī lěi jì","abbr":"cxlj","explanation":"形容累世圣明有德，天下升平昌盛。同“重熙累洽”。","source":{"text":"明兴百八十余年，高皇帝作之于前，今天子述之于后，弈世载德，重熙累绩，稽古礼文之事，褎然具备矣。","book":"明·张居正《重刊〈大明集礼〉序》"},"similar":["重熙累洽"],"usage":"作谓语、定语；指繁荣稳定"},{"id":44691,"word":"重珪叠组","pinyin":"chóng guī dié zǔ","abbr":"cgdz","explanation":"指世代连续做官。","source":{"text":"予闻世之右族，重珪叠组者有之矣，索其家学相仍数世而弗坠，十百之中或一二见焉。","book":"明·宋濂《故东吴先生吴公墓碣铭》"},"example":{"text":"他出身于～的家庭。"},"usage":"作谓语、定语；用于书面语"},{"id":44692,"word":"重珪迭组","pinyin":"chóng guī dié zǔ","abbr":"cgdz","explanation":"指世代连续做官。"},{"id":44693,"word":"重理旧业","pinyin":"chóng lǐ jiù yè","abbr":"cljy","explanation":"指再做以前曾做的事。","source":{"text":"再嫁呢，还是住家？还是索性大张旗鼓的重理旧业？这倒是个大问题。","book":"清·曾朴《孽海花》第三十回"},"similar":["重操旧业","重温旧业"],"opposite":["金盆洗手"],"usage":"作谓语、宾语；指重新开始"},{"id":44694,"word":"重生父母","pinyin":"chóng shēng fù mǔ","abbr":"csfm","explanation":"重：重新。指对自己有重大恩情的人，多指救命的恩人。","source":{"text":"重生父母，再长爹娘。","book":"元·杨景贤《西游记》四本一五出"},"example":{"text":"某一家骨肉皆足下所再造，虽～不及此恩。”","book":"明·冯梦龙《警世通言》第二十五卷"},"similar":["再造之恩","再生父母","再长爷娘"],"opposite":["不共戴天"],"usage":"作宾语、定语；指救命恩人"},{"id":44695,"word":"重生爷娘","pinyin":"chóng shēng yé niáng","abbr":"csyn","explanation":"比喻有救命之恩的人。","source":{"text":"清·李宝嘉《文明小史》第三十八回：“你是个死囚，大老爷要开脱你，也全亏我在旁边说几句好话，我便是你的重生爷娘。”"}},{"id":44696,"word":"重男轻女","pinyin":"zhòng nán qīng nǚ","abbr":"znqn","explanation":"重视男子，看轻女性。指轻视妇女的封建思想。","source":{"text":"说的白茹含羞带乐的一撅嘴，‘什么黄毛丫头，重男轻女的思想。’","book":"曲波《林海雪原》"},"example":{"text":"我们不能有～的想法。"},"similar":["男尊女卑"],"usage":"作谓语、定语、宾语；指轻视妇女"},{"id":44697,"word":"重睹天日","pinyin":"chóng dǔ tiān rì","abbr":"cdtr","explanation":"比喻脱离黑暗，重见光明。","source":{"text":"一入真州，忽见中国衣冠，如流浪人乍归故乡，不意重睹天日至此。","book":"宋·文天祥《文山全集·十三·真州杂赋·序》"},"example":{"text":"一大批被禁锢的艺术品，现在得以～了。"},"similar":["重见光明","重见天日"],"opposite":["长夜漫漫"],"usage":"作谓语、定语；比喻脱离黑暗的处境"},{"id":44698,"word":"重纰貤缪","pinyin":"chóng pī yí miù","abbr":"cpym","explanation":"指谬误重出。","source":{"text":"言既重其悂，而又累其缪也。","book":"语本《文选·左思〈魏都赋〉》：“兼重悂以胣缪。”李善注"},"example":{"text":"民族主义之与宗法社会固非一事，则言宗法社会之得失，非吾所注意也。然今者～之说，实自此始。","book":"章炳麟《〈社会通铨〉商兑》"},"usage":"作宾语、定语；用于书刊、学说等"},{"id":44699,"word":"重纸累札","pinyin":"chóng zhǐ lèi zhá","abbr":"czlz","explanation":"指很多的纸张。","source":{"text":"苟别君臣同异之礼，恐重纸累札，书不尽也。","book":"《隋书·礼仪志四》"},"usage":"作宾语、定语；用于纸多或书信往来等"},{"id":44700,"word":"重而无基","pinyin":"zhòng ér wú jī","abbr":"zewj","explanation":"基：根基。外表强大，却没有基础。比喻虚而不实。","source":{"text":"纵之，使盈其罪，重而无基，能无敝乎？","book":"《左传·哀公二十六年》"},"example":{"text":"东门，大夫；叔孙，卿也。位在人下而侈其上，～，故不可以事二君也。（《国语·周语中》）"}},{"id":44701,"word":"重色轻友","pinyin":"zhòng sè qīng yǒu","abbr":"zsqy","explanation":"看重女色，轻视友情","source":{"text":"睡了一夜，就相好起来，也未免重色轻友太利害些。","book":"清·李百川《绿野仙踪》第51回"},"usage":"作谓语、定语、宾语；用于处事"},{"id":44702,"word":"重若丘山","pinyin":"zhòng ruò qiū shān","abbr":"zrqs","explanation":"比大山还要重。比喻人死得很有价值。也形容意义重大。","source":{"text":"若是驮着腾云，三尺也不能离地，常言道，背凡人重若丘山。若是驮着负水，转连我坠下水去了。","book":"明·吴承恩《西游记》第四十三回"},"example":{"text":"～，难比无穷泰华。（明·冯梦龙《警世通言》卷十六）"},"usage":"作谓语、定语；用于书面语"},{"id":44703,"word":"重葩累藻","pinyin":"chóng pā lèi zǎo","abbr":"cplz","explanation":"比喻许多华丽的篇章。","source":{"text":"古传记称帝之季女曰瑶姬，精魄化草，实为灵芝，宋玉本此以托讽，后世词人，转加缘饰，重葩累藻，不越此意。","book":"明·杨慎《跋赵文敏公书巫山词》"},"usage":"作谓语、宾语；用于写作等"},{"id":44704,"word":"重裀列鼎","pinyin":"chóng yīn liè dǐng","abbr":"cyld","explanation":"裀：夹层床垫。形容生活富裕，位居高官。","source":{"text":"累裀而坐，列鼎而食。","book":"汉·刘向《说苑·建本》"},"example":{"text":"忒心偏，觑～不值钱，把黄齑淡饭相留恋。要彻老终年。","book":"元·关汉卿《拜月亭》第三折"},"usage":"作宾语、定语；用于书面语"},{"id":44705,"word":"重裵列鼎","pinyin":"chóng yīn liè dǐng","abbr":"cyld","explanation":"喻指生活富贵，位居高官。","source":{"text":"第四折忒心偏，觑重裵列鼎不值钱，把黄齑淡饭相留恋，要彻老终年。","book":"元·关汉卿《拜月亭》"}},{"id":44706,"word":"重见天日","pinyin":"chóng jiàn tiān rì","abbr":"cjtr","explanation":"重新看到了天和太阳。比喻脱离黑暗，重见光明。","source":{"text":"一入真州，忽见中国衣冠，如流浪人乍归故乡，不意重睹天日至此。","book":"宋·文天祥《文山全集·十三·真州杂赋·序》"},"example":{"text":"仓乃一粗莽之夫，失身为盗；今遇将军，如～，岂忍复错过！","book":"明·罗贯中《三国演义》第二十八回"},"similar":["开云见日","重睹天日"],"opposite":["身陷囹圄"],"usage":"作谓语、宾语；指被关闭的东西重新开发"},{"id":44707,"word":"重规叠矩","pinyin":"chóng guī dié jǔ","abbr":"cgdj","explanation":"规与规相重，矩与矩相迭。指前后相合，重叠的规矩与制度。比喻因袭、重复。","source":{"text":"曰子曰孙，重规叠矩。","book":"《晋书·周访传赞》"},"example":{"text":"伟哉此论，与季长～。","book":"清·龚自珍《大誓答问第二十》"},"similar":["重规累矩"],"usage":"作主语、谓语、宾语；比喻重叠的法规"},{"id":44708,"word":"重规沓矩","pinyin":"chóng guī tà jǔ","abbr":"cgtj","explanation":"指前后相合，合乎同样的规矩法度。亦比喻因袭、重复。","source":{"text":"尧昔命舜，舜亦命禹，大人驭历，重规沓矩。","book":"《乐府诗集·燕射歌辞二·皇夏》"},"similar":["重规叠矩"],"usage":"作主语、谓语、宾语；比喻重叠的法规"},{"id":44709,"word":"重规累矩","pinyin":"chóng guī lèi jǔ","abbr":"cglj","explanation":"指前后相合，合乎同样的规矩法度。亦比喻因袭、重复。","source":{"text":"昔周旦翼成，越裳重译而献白雉，著在前典，历代以为美谈。今在我王，匡济皇维，而有白兔之应，可谓重规累矩，不忝先圣也。","book":"《艺文类聚》卷九五引晋·王廙《白兔赋》序"},"similar":["重规沓矩","重规叠矩"],"usage":"作主语、谓语、宾语；比喻重叠的法规"},{"id":44710,"word":"重规袭矩","pinyin":"chóng guī xí jǔ","abbr":"cgxj","explanation":"指前后相合，合乎同样的规矩法度。亦比喻因袭、重复。","source":{"text":"虽相去百世，具年一纪，限隔九州，殊俗千里，然其亡征败迹，若重规袭矩，稽节合符。","book":"汉·王符《潜夫论·思贤》"},"example":{"text":"爰有列圣，～。","book":"唐·杨炯《大唐益州大都督府……庙唐碑文》"},"similar":["重规沓矩","重规累矩"],"usage":"作主语、谓语、宾语；比喻重叠的法规"},{"id":44711,"word":"重规迭矩","pinyin":"chóng guī dié jǔ","abbr":"cgdj","explanation":"规与规相重，矩矩与相迭，度数相同，完全符合。原比喻动静合乎法度或上下相合，后形容模仿、重复。","source":{"text":"君臣协美于朝，黎庶欣戴于野，动若重规，静若迭矩。","book":"《三国志·蜀书·郤正传》"},"example":{"text":"例如于民政司外，又设巡警道，此皆～，毫无所取。","book":"清·梁启超《治标财政策》"},"similar":["重规累矩"],"usage":"作主语、谓语、宾语；比喻重叠的法规"},{"id":44712,"word":"重财轻义","pinyin":"zhòng cái qīng yì","abbr":"zcqy","explanation":"指看重财利而轻视道义。","source":{"text":"百姓小人，重财轻义，不能深达事体。","book":"唐·韩愈《论捕贼行赏表》"},"example":{"text":"我看不起那些～的人。"},"similar":["见财忘义"],"opposite":["仗义疏财"],"usage":"作谓语、定语；指人看重钱财"},{"id":44713,"word":"重赂轻贤","pinyin":"zhòng lù qīng xián","abbr":"zlqx","explanation":"看重别人的贿赂而轻视有才能的人。","source":{"text":"岂有此理！我想那秦太师亦是十载寒窗，由青灯而居相位，怎么重赂轻贤！","book":"清·钱彩《说岳全传》第五十四回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":44714,"word":"重赏之下，必有勇夫","pinyin":"zhòng shàng zhī xià，bì yǒu yǒng fū","abbr":"zszxbyyf","explanation":"在丰厚的赏赐之下，一定有胆量去做的人。旧指用大量金钱、财物作鼓励手段，可诱导人为之效力。","source":{"text":"香饵之下，必有悬鱼，重赏之下，必有死士。","book":"汉·黄石公《黄石公三略》上"},"example":{"text":"～，赏罚若明，其计必成。","book":"元·王实甫《西厢记》第二本第一折"},"similar":["香饵之下，必有死鱼"],"usage":"作宾语、定语、分句；用于书面语"},{"id":44715,"word":"重赏之下，必有死夫","pinyin":"zhòng shǎng zhī xià，bì yǒu sǐ fū","abbr":"zszxbysf","explanation":"指用重金悬赏，就会有勇于出来干事的人。","source":{"text":"芳饵之下，必有悬鱼，重赏之下，必有死夫。","book":"《后汉书·耿纯传》：“重赏甘饵，可以聚人者也。”李贤注引《黄石公记》"},"similar":["重赏之下，必有勇夫"],"usage":"作宾语、定语、分句；用于书面语"},{"id":44716,"word":"重赏甘饵","pinyin":"zhòng shàng gān ěr","abbr":"zsge","explanation":"用厚重的奖赏作为诱饵，来吸引他人。","source":{"text":"窃见明公单车临河北，非有府臧之蓄，重赏甘饵，可以聚人者也，徒以恩德怀之，是故士众乐附。","book":"《后汉书·耿纯传》"},"usage":"作宾语、定语；用于处事"},{"id":44717,"word":"重起炉灶","pinyin":"chóng qǐ lú zào","abbr":"cqlz","explanation":"指事情遭受挫折后，再从头做起。","source":{"text":"每遭一次顿挫，总要使前功尽弃，又来重起炉灶。","book":"郭沫若《北伐途次》"},"example":{"text":"经过这次台风的袭击，我们不得不～了。"},"similar":["另起炉灶"],"usage":"作谓语、定语；指重新开始"},{"id":44718,"word":"重足一迹","pinyin":"chóng zú yī jì","abbr":"czyj","explanation":"叠足而立，不敢迈步。形容非常恐惧。","source":{"text":"言极恐惧，不敢自宽纵。","book":"《汉书·佞幸传·石显》：“自是公聊以下畏显，重足一迹。”颜师古注"},"example":{"text":"［李沼］未几，按甲来觐，讽天子诛大臣，缙绅间～。","book":"五代·王定宝《唐摭言·四凶》"},"usage":"作谓语、定语；用于害怕"},{"id":44719,"word":"重足屏息","pinyin":"chóng zú bǐng xī","abbr":"czbx","explanation":"指畏惧之甚。","source":{"text":"魏武虽严科条，审律令，以重足屏息操制群下，而截然使人各得自尽以行其职守者犹在也。","book":"宋·叶適《法度总论二》"},"example":{"text":"令人不幸邻于虎，避之万不可得，则奋梃当关，与虎争一旦之命耳。～，以胥虎之人，诫毋撄虎，以翼虎之见哀，是赵豹之智也。","book":"清·周树槐《赵孝成王论》"},"similar":["重足屏气"],"usage":"作谓语、状语；用于人的神态"},{"id":44720,"word":"重足屏气","pinyin":"chóng zú bǐng qì","abbr":"czbq","explanation":"指畏惧之甚。","source":{"text":"师祖严暴无常，元景虽荷宠遇，恒虑及祸。太宰江夏王义恭及诸大臣，莫不重足屏气，未尝敢私往来。","book":"《宋书·柳元景传》"},"example":{"text":"令萱则自太后以下，皆受其指麾；提婆则唐邕之徒，皆～；杀生与夺，唯意所欲。","book":"宋·司马光《资治通鉴·陈宣帝太建四年》"},"similar":["重足屏息","重迹屏气"],"usage":"作谓语、状语；用于人的神态"},{"id":44721,"word":"重足累息","pinyin":"chóng zú lèi xī","abbr":"czlx","explanation":"指畏惧之甚。","source":{"text":"于是内外恐怖，人不自安，皆求苟免，莫有固志，重足累息，以逮于终。","book":"《梁书·柳忱传》：“朝迁狂悖，为恶日滋，顷闻京师长者，莫不重足累息。”宋·司马光《资治通鉴》卷第一百七十三"},"example":{"text":"今命之刺访，将必开罗织之门，逞机阱之术，祸贻善类，使人人～，何以为治。","book":"《明史·舒化传》"},"similar":["重足屏息"],"usage":"作谓语、状语；用于人的神态"},{"id":44722,"word":"重足而立","pinyin":"chóng zú ér lì","abbr":"czel","explanation":"叠足而立，不敢迈步。形容恐惧。","source":{"text":"故使天下之士，倾耳而听，重足而立，阖口而不言。","book":"西汉·贾谊《过秦论》下"},"example":{"text":"胁持荐绅，开告讦之门，兴罗织之狱，士大夫～。","book":"宋·王明清《玉照新志》第四卷"},"usage":"作谓语；指不敢迈步","story":["汉朝时期，张汤因改定刑律法令而做了廷尉，太子洗马汲黯对他十分不满，说他不努力去降低犯罪使人们生活富足，而是陷人于罪，如果这样下去，将使天下人重足而立、侧目而视。汲黯因此被外放为淮阴郡太守"]},{"id":44723,"word":"重足而立，侧目而视","pinyin":"chóng zú ér lì，cè mù ér shì","abbr":"czelcmes","explanation":"重足：双脚并拢；侧目：斜着眼睛。形容畏惧而愤恨的样子。","source":{"text":"今天下重足而立，侧目而视矣。","book":"《史记·汲郑列传》"},"example":{"text":"使通国之人～者，无过于此辈穷凶极恶之特务人员。","book":"毛泽东《向国民党的十点要求》"},"similar":["敢怒不敢言"],"usage":"作谓语、定语、分句；指害怕的样子"},{"id":44724,"word":"重蹈覆辙","pinyin":"chóng dǎo fù zhé","abbr":"cdfz","explanation":"蹈：踏；覆：翻；辙：车轮辗过的痕迹。重新走上翻过车的老路。比喻不吸取教训，再走失败的老路。","source":{"text":"今不想前事之失，复循覆车之轨。","book":"《后汉书·窦武传》"},"example":{"text":"要从失败中吸取教训，以免～。"},"similar":["重蹈前辙","蹈其覆辙"],"opposite":["前车可鉴","前车之鉴"],"usage":"作谓语、宾语；用于劝说、希望和警告的场合","story":["东汉光武帝刘秀重用外戚梁冀一家，梁家横行无忌，毒死汉质帝刘瓒。汉桓帝刘志当皇帝后，利用身边的五个宦官除掉了无恶不作的梁家，将这五个宦官封侯，大将军窦武写信给汉桓帝不要重蹈覆辙，结果被宦官杀害"]},{"id":44725,"word":"重迹屏气","pinyin":"chóng jì bǐng qì","abbr":"cjbq","explanation":"指畏惧之甚。","source":{"text":"又伺察官人罪失，动即奏闻，朝士见之，莫不重迹屏气，皆目之为卢校事。","book":"《北齐书·酷吏传·卢斐》"},"example":{"text":"令萱则自太后以下，皆受其指麾；提婆则唐邕之徒，皆～。","book":"《北史·恩幸传·穆提婆》"},"similar":["重足屏气"],"usage":"作谓语、状语；用于人的神态"},{"id":44726,"word":"重逆无道","pinyin":"zhòng nì wú dào","abbr":"znwd","explanation":"大逆不道，行事不循理。","source":{"text":"而卬（楚王刘卬）等又重逆无道，烧宗庙，卤御物，朕甚痛之。","book":"《汉书·吴王刘濞传》"},"similar":["大逆不道"],"usage":"作谓语、定语；用于书面语"},{"id":44727,"word":"重重叠叠","pinyin":"chóng chóng dié dié","abbr":"ccdd","explanation":"同样的东西层层堆叠。","source":{"text":"这又同才刚学里的八两一样，重重叠叠，事虽小，钱有限，看起来也不妥当。","book":"清·曹雪芹《红楼梦》第56回"},"example":{"text":"清·曹雪芹《红楼梦》第56回：“这又同才刚学里的八两一样，～，事虽小，钱有限，看起来也不妥当。”"},"similar":["层层叠叠"],"usage":"作定语、状语；用于重复"},{"id":44728,"word":"重金兼紫","pinyin":"chóng jīn jiān zǐ","abbr":"cjjz","explanation":"指一门中有数人佩金印紫绶，极言荣显。秦汉列侯以上皆金印紫绶。","source":{"text":"金印紫绶。重、兼，言累积也。","book":"《后汉书·宦者传·吕强》：“中常侍曹节、王甫、张让等，及侍中许相，并为列侯……又并及家人，重金兼紫，相继为蕃辅。”李贤注"},"usage":"作谓语、定语；用于官场"},{"id":44729,"word":"重金袭汤","pinyin":"chóng jīn xí tāng","abbr":"cjxt","explanation":"指几重金城汤池，防守非常坚固。","source":{"text":"疏斥忠良，猜忌有功，使臣下皆无亲附之意，推此道理行之，虽重金袭汤，不能以一日守也。","book":"宋·司马光《评项羽诛韩生》"},"usage":"作谓语、定语；用于防守"},{"id":44730,"word":"重门击柝","pinyin":"chóng mén jī tuò","abbr":"cmjt","explanation":"柝：打更用的梆子。设置重重门户，并派更夫巡夜。指严加戒备，以防不测。","source":{"text":"重门击柝，以待暴客。","book":"《周易·系辞下》"},"example":{"text":"若非高岸峻防，～，虽有盛德，曷观成功？","book":"唐·吕温《三受降城碑铭序》"},"similar":["戒备森严","重关击柝"],"usage":"作谓语；指戒备森严"},{"id":44731,"word":"重门叠户","pinyin":"chóng mén dié hù","abbr":"zmdh","explanation":"重：重复；门、户：房屋的出入口。比喻地方多关口，易于防守。","source":{"text":"山西三关得为九边之一，犹宣化之有居庸，所谓重门叠户者也。","book":"清·龚自珍《与吴虹生书》"},"usage":"作宾语、定语；用于书面语"},{"id":44732,"word":"重雍袭熙","pinyin":"chóng yōng xí xī","abbr":"zyxx","explanation":"雍、熙：和乐。指太平和乐的景象。","source":{"text":"盛哉大汉，既重雍而袭熙。","book":"汉·崔骃《东巡颂》"}},{"id":44733,"word":"野人奏曝","pinyin":"yě rén zòu pù","abbr":"yrzp","explanation":"比喻微薄的贡献。","source":{"text":"暨春东作，自曝于日，不知天下之有广厦隩室，绵纩狐貉。","book":"战国·郑·列御寇《列子·杨朱》"},"example":{"text":"～，自古而有之。","book":"清·章炳麟《记政闻社员大会破坏状》"},"similar":["野人献曝","野人献日"],"usage":"作宾语、定语；比喻微薄的贡献","story":["战国时期，宋国有一个没有见过世面的农夫，由于家贫终日穿一件粗麻衣，勉强过冬。第二年春天，天气晴朗，他就脱光衣服在太阳下曝晒，觉得十分舒服，由于没有见过漂亮的皮衣和高大的房子，就对妻子说将把这取暖的办法进献给国王"]},{"id":44734,"word":"野人献日","pinyin":"yě rén xiàn rì","abbr":"yrxr","explanation":"比喻微薄的贡献。同“野人奏曝”。","source":{"text":"唐·欧阳玭有《野人献日赋》。"},"similar":["野人献曝","野人奏曝"],"usage":"作宾语、定语；向人建议时的客套话"},{"id":44735,"word":"野人献曝","pinyin":"yě rén xiàn pù","abbr":"yrxp","explanation":"比喻贡献的不是珍贵的东西。（向人建议时的客套话）。","source":{"text":"自曝于日，不知天下之有广厦隩室，绵纩狐貉。","book":"《列子·杨朱》"},"similar":["野人奏曝","野人献日"],"usage":"作宾语、定语；向人建议时的客套话","story":["战国时期，宋国有一个没有见过世面的农夫，由于家贫终日穿一件粗麻衣，勉强过冬。第二年春天，天气晴朗，他就脱光衣服在太阳下曝晒，觉得十分舒服，由于没有见过漂亮的皮衣和高大的房子，就对妻子说将把这取暖的办法进献给国王"]},{"id":44736,"word":"野人献芹","pinyin":"yě rén xiàn qín","abbr":"yrxq","explanation":"把不值钱的芹菜当好东西献给别人。比喻贡献的不是有多大价值的东西（多用作送人礼物或建议时的客套话）。","source":{"text":"昔人有美戎菽、甘台茎、芹萍子者，对乡豪称之，乡豪取而尝之，蜇于口，惨于腹。众哂而怨之，其人大惭。","book":"《列子·杨朱》"},"similar":["野人之芹"],"usage":"作宾语、定语；指送人礼物或建议时客套话"},{"id":44737,"word":"野史稗官","pinyin":"yě shǐ bài guān","abbr":"ysbg","explanation":"野史：古代私家编撰的史书；稗官：古代其职为搜集街谈巷议、风俗故事，供皇帝看的小书。泛称记载轶闻琐事的文字。","source":{"text":"千秋莫道无金鉴，野史稗官话正长。","book":"清·褚人获《隋唐演义》第70回"},"similar":["稗官野史"],"usage":"作主语、宾语、定语；旧时小说、杂史的统称"},{"id":44738,"word":"野处穴居","pinyin":"yě chǔ xué jū","abbr":"ycxj","explanation":"穴：洞；处：居住。居住在洞里生活在荒野。形容原始人的生活状况。","source":{"text":"上古穴居而野处，后世圣人易之以宫室，上栋下宇，以待风雨，盖取诸大壮。","book":"《周易·系辞下》"},"example":{"text":"洪荒之世，～；有巢以后，上栋下宇。","book":"清·程允升《幼学琼林·宫室》"},"similar":["穴居野处"],"usage":"作谓语、定语；形容原始人的生活状况"},{"id":44739,"word":"野居穴处","pinyin":"yě jū xué chǔ","abbr":"yjxc","explanation":"穴：洞；处：居住。居住在洞里生活在荒野。形容原始人的生活状况。","source":{"text":"天下人民，野居穴处，未有室屋，则与禽兽同域。","book":"汉·陆贾《新语·道基》"},"similar":["穴居野处"],"usage":"作谓语、定语；形容原始人的生活状况"},{"id":44740,"word":"野心勃勃","pinyin":"yě xīn bó bó","abbr":"yxbb","explanation":"勃勃：旺盛的样子。形容野心非常大。","source":{"text":"这一位大帝野心勃勃，就想把世界各国尽归他的宇下。","book":"清·陈天华《狮子吼》第一回"},"example":{"text":"济度～地说大话：“我要斩草除根，拿下厦门，踏平他的巢穴！”","book":"华而实《汉衣冠》七"},"similar":["狼子野心","利欲熏心","垂涎三尺"],"opposite":["两袖清风","一尘不染","廉洁奉公"],"usage":"作谓语、定语、状语；指野心非常大"},{"id":44741,"word":"野性难训","pinyin":"yě xìng nán xún","abbr":"yxnx","explanation":"驯：顺服。比喻人的修改倔强，不屈服于任何外力。","source":{"text":"鸾翻有时铩，龙性谁能驯。","book":"晋·颜延之《五君咏》"}},{"id":44742,"word":"野性难驯","pinyin":"yě xìng nán xùn","abbr":"yxnx","explanation":"驯：顺服。动物的野性很难驯服。比喻人很难教导","source":{"text":"屡次正义的反抗，决不是所谓‘野性难驯’，相反，他们是有公正合理的民族精神的。","book":"范文澜《中国近代史》上册第三章"},"usage":"作谓语、定语；用于书面语"},{"id":44743,"word":"野战群龙","pinyin":"yě zhàn qún lóng","abbr":"yzql","explanation":"群龙在郭野大战。比喻群雄争天下。","source":{"text":"天地闭革，野战群龙。","book":"南朝·宋·范晔《后汉书·王刘张李彭卢传赞》"},"similar":["龙战于野"],"usage":"作宾语、定语；用于比喻句"},{"id":44744,"word":"野无遗才","pinyin":"yě wú yí cái","abbr":"ywyc","explanation":"指任人唯贤，人尽其才。同“野无遗贤”。","source":{"text":"既焚林而访阮，亦榜道以求孙，可谓野无遗才，朝多君子。","book":"《周书·苏亮等传论》"},"similar":["野无遗贤","野没遗贤"],"usage":"作宾语、定语；指爱惜人才"},{"id":44745,"word":"野无遗贤","pinyin":"yě wú yí xián","abbr":"ywyx","explanation":"野：指朝廷之外，民间；遗：漏掉。有才能的人都受到任用。指任人唯贤，人尽其才。","source":{"text":"野无遗贤，万邦咸宁。","book":"《尚书·大禹漠》"},"example":{"text":"百僚师师，真可谓朝无幸位，～。","book":"明·焦竑《玉堂丛语·荐举》"},"similar":["野无遗才","野没遗贤"],"usage":"作宾语、定语；指爱惜人才"},{"id":44746,"word":"野有饿殍","pinyin":"yě yǒu è piǎo","abbr":"yyep","explanation":"饿殍：饿死的人。在野外有饿死的人。多指灾荒年景或兵荒马乱给老百姓带来的凄惨景象。","source":{"text":"民有饥色，野有饿莩。","book":"《孟子·梁惠王上》"},"example":{"text":"卿等盈车受俸，岂知～乎？","book":"清·毕沅《续资治通鉴》卷十六"},"similar":["野有饿莩"],"usage":"作谓语、定语；用于书面语"},{"id":44747,"word":"野有饿莩","pinyin":"yě yǒu è piǎo","abbr":"yyef","explanation":"饿莩：饿死的人。在野外有饿死的人。多指灾荒年景或兵荒马乱给老百姓带来的凄惨景象。","source":{"text":"民有饥色，野有饿莩。","book":"《孟子·梁惠王上》"},"similar":["野有饿殍"],"usage":"作谓语、定语；用于书面语"},{"id":44748,"word":"野没遗贤","pinyin":"yě méi yí xián","abbr":"ymyx","explanation":"指任人唯贤，人尽其才。同“野无遗贤”。","source":{"text":"那爷爷圣武神文，英明仁孝，真个朝无幸位，野没遗贤。","book":"明·冯梦龙《醒世恒言》第二十卷"},"similar":["野无遗贤","野无遗才"],"usage":"作宾语、定语；指爱惜人才"},{"id":44749,"word":"野火烧不尽，春风吹又生","pinyin":"yě huǒ shāo bù jìn，chūn fēng chuī yòu shēng","abbr":"yhsbjcfcys","explanation":"野火不能烧尽野草，春天一到野草又长出来了。比喻富有生命力的事物，任何力量也扼杀不了。","source":{"text":"离离原上草，一岁一枯荣。野火烧不尽，春风吹又生。","book":"唐·白居易《赋得古原草送别》"},"example":{"text":"‘～’一到春天，漫山遍野，向大地显露着无限生机的，依然是那一望无际的青青翠竹！","book":"袁鹰《井冈翠竹》"},"usage":"作分句；指很有生命力","story":["唐朝著名的大诗人白居易16岁时带着他写的《赋得古原草送别》去拜见掌管编纂国史的著作郎顾况，请他帮助润色。顾况发现他的这首诗功底不浅。诗内容为：“离离原上草，一岁一枯荣。野火烧不尽，春风吹又生。”"]},{"id":44750,"word":"野狐参禅","pinyin":"yě hú cān chán","abbr":"yhcc","explanation":"野狐：佛家指不能妙悟禅道而堕入异端者。比喻欺世惑众但终无所成的异端邪说。","source":{"text":"野狐外道，蒙蔽其真识，不可救药。","book":"宋·严羽《沧浪诗话·诗辨》"}},{"id":44751,"word":"野狐外道","pinyin":"yě hú wài dào","abbr":"yhwd","explanation":"比喻欺世惑众但终无所成的异端邪说。","source":{"text":"野狐外道，蒙蔽其真识，不可救药。","book":"宋·严羽《沧浪诗话·诗辨》"}},{"id":44752,"word":"野草闲花","pinyin":"yě cǎo xián huā","abbr":"ycxh","explanation":"野生的花草。比喻男子在妻子以外所玩弄的女子。","source":{"text":"他和那青松翠柏为交友，野草闲花作近邻。","book":"元·无名氏《马陵道》楔子：“将军战马今何在？野草闲花满地愁。”元·无名氏《渔樵记》第三折"},"example":{"text":"俺见鞍思马，难道他是～？","book":"明·汤显祖《紫钗记·哭收钗燕》"},"similar":["冶叶倡条","闲花野草"],"usage":"作宾语、定语；指妓女"},{"id":44753,"word":"野荒民散","pinyin":"yě huāng mín sàn","abbr":"yhms","explanation":"野：田地。田地荒芜，人民离散。常指政治动荡不安的局面。","source":{"text":"暴内陵外，则坛之；野荒民散。则削之。","book":"《周礼·夏官·大司马》"}},{"id":44754,"word":"野蔌山肴","pinyin":"yě sù shān yáo","abbr":"yssy","explanation":"肴：熟的鱼肉；簌：野菜。指山中的野味和野菜。","source":{"text":"山肴野蔌，杂然而前陈者，太守宴也。","book":"宋·欧阳修《醉翁亭记》"}},{"id":44755,"word":"野调无腔","pinyin":"yě diào wú qiāng","abbr":"ydwq","explanation":"野：粗野；无腔：没有规矩。形容言行放肆，没有礼貌。","source":{"text":"横吹短笛，一声一声把春歌唱，野调无腔。","book":"《白雪遗音·马头调·九尽寒退》"},"example":{"text":"～的山姑娘！","book":"老舍《老张的哲学》"},"usage":"作宾语、定语；指不懂礼貌"},{"id":44756,"word":"野马尘埃","pinyin":"yě mǎ chén āi","abbr":"ymca","explanation":"野马：浮游的云气。云烟灰尘。比喻容易消失的事物。","source":{"text":"野马也，尘埃也。","book":"《庄子·逍遥游》"},"example":{"text":"～昼夜驰，五虫百卉互相吹。","book":"清·刘鹗《老残游记》第九回"},"usage":"作宾语、定语；用于比喻句"},{"id":44757,"word":"野马无缰","pinyin":"yě mǎ wú jiāng","abbr":"ymwj","explanation":"没有拴上缰绳的野马。比喻任意行动，没有约束。","source":{"text":"天机有碍尖还钝，野马无缰快已迟。","book":"明·名教中人《好逑传》第四回"},"usage":"作宾语、定语；指没有约束"},{"id":44758,"word":"野鬼孤魂","pinyin":"yě guǐ gū hún","abbr":"yggh","explanation":"魂：灵魂。指无人顾念，无人祭奠的死者。","source":{"text":"你莫不是野鬼孤魂索酒食？","book":"元·无名氏《盆儿鬼》第三折"},"example":{"text":"人亡马死怎归家？～乱似麻。可怜抖擞英雄将，不辨贤愚血染沙。","book":"明·吴承恩《西游记》第二十八回"},"similar":["孤魂野鬼"],"usage":"作宾语、定语；指孤立的人"},{"id":44759,"word":"野鸟入庙","pinyin":"yě niǎo rù miào","abbr":"ynrm","explanation":"庙：指太庙的明堂，古代帝王祭祀、议事的场所。野鸟闯入了庙堂。旧指国家败亡的征兆。","source":{"text":"野木生朝，野鸟入庙，则亡之异也。","book":"《汉书·五行志》"},"example":{"text":"夫野木生朝，～，古人皆以为败亡之象。","book":"《资治通鉴·梁纪·高祖天监四年》"}},{"id":44760,"word":"野鹤孤云","pinyin":"yě hè gū yún","abbr":"yhgy","explanation":"比喻无拘无束、来去自如的人。同“闲云孤鹤”。","source":{"text":"野鹤孤云元自在，刚论隐豹冥鸿。","book":"宋·王千秋《临江仙》词"},"example":{"text":"清霜烈日从渠畏，～觉自闲。","book":"元·刘因《自适》诗"},"similar":["野鹤闲云"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":44761,"word":"野鹤闲云","pinyin":"yě hè xián yún","abbr":"yhxy","explanation":"闲：无拘束。飘浮的云，野生的鹤。旧指生活闲散、脱离世事的人。","source":{"text":"野鹤孤云元自在，刚论隐豹冥鸿。","book":"宋·王千秋《临江仙》词"},"example":{"text":"乃三人～，不受笼络，身分自高，不愿小就。","book":"清·洪楝园《后南柯·旌召》"},"similar":["野鹤孤云"],"usage":"作宾语、定语；指不受任何约束的人"},{"id":44762,"word":"量体裁衣","pinyin":"liàng tǐ cái yī","abbr":"ltcy","explanation":"按照身材裁剪衣服。比喻按照实际情况办事。","source":{"text":"子观越王之志何若？意越王将听吾言，用我道，则翟将往，量腹面食，度身而衣，自比于群臣，奚能以封为哉？","book":"《墨子·鲁问》"},"example":{"text":"俗话说：“到什么山上唱什么歌。”又说：“看菜吃饭，～。”我们无论做什么事都要看情形办理。","book":"毛泽东《反对党八股》"},"similar":["量力而行","量入为出","实事求是"],"opposite":["力不从心","不自量力","力所不及"],"usage":"作谓语、宾语、分句；指实事求是","story":["南朝齐国官员张融深受齐太祖萧道成的器重和宠爱，说他是“不可无一，不可有二。”一次派人给张融送一件旧衣服，说是自己以前穿的，现叫裁缝根据他的身材改做好了，一定会合身的。张融收到后非常感激齐太祖的知遇之恩"]},{"id":44763,"word":"量入为出","pinyin":"liàng rù wéi chū","abbr":"lrwc","explanation":"量：计量。根据收入的多少来定开支的限度。","source":{"text":"五谷皆入，然后制国用，……以三十年之通制国用，量入以为出。","book":"《礼记·王制》"},"example":{"text":"宜～，汰冗食浮费。","book":"《明史·孙原贞传》"},"similar":["量入制出","精打细算","量入为用"],"opposite":["入不敷出"],"usage":"作谓语、定语；指根据收入的多少来决定开支","story":["三国时期，曹操派属官卫凯去巴蜀联络益州牧刘璋，卫凯到关中，见地方势力太大，会影响曹氏家族的利益，建议加强控制。曹睿继位后，大兴土木，营造宫殿，弄得关中地区民不聊生。卫凯上书曹睿要求根据国库收入来决定支出的限度"]},{"id":44764,"word":"量入制出","pinyin":"liàng rù zhì chū","abbr":"lrzc","explanation":"量：计量。根据收入的多少来定开支的限度。","source":{"text":"五谷皆入，然后制国用，……以三十年之通制国用，量入以为出。","book":"《礼记·王制》"},"example":{"text":"守富必须～，小心勤俭。","book":"明·东鲁古狂生《醉醒石》"}},{"id":44765,"word":"量入计出","pinyin":"liàng rù jì chū","abbr":"lrjc","explanation":"根据收入的多少来定开支的限度。同“量入为出”。","source":{"text":"颋尚简静，重兴力役，即募戍人，输雇直，开井置炉，量入计出，分所赢市谷，以广见粮。","book":"《新唐书·苏颋传》"},"similar":["量入为出"],"usage":"作谓语、定语；指根据收入来决定开支"},{"id":44766,"word":"量兵相地","pinyin":"liàng bīng xiàng dì","abbr":"lbxd","explanation":"量：计算；兵：兵力；相：选择。计算兵力，选择地形。","source":{"text":"凡行兵取胜，须量兵相地。兵务多易，兵少务险，要在兵与地相称。","book":"清·许乃济《武备辑要》卷五"}},{"id":44767,"word":"量出为入","pinyin":"liàng chū wéi rù","abbr":"lcwr","explanation":"量：衡量。根据支出来决定征收的数量。","source":{"text":"我们实行的是钱多多出，钱少少出的原则，是量入为出与量出为入的配合，既照顾人民的负担能力，又照顾抗战的需要。","book":"邓小平《太行区的经济建设》"},"usage":"作谓语、定语；用于个人或国家等"},{"id":44768,"word":"量出制入","pinyin":"liàng chū zhì rù","abbr":"lczr","explanation":"量：估量；制：规定。估量支出情况再定其收入之道。","source":{"text":"凡百役之费，一钱之敛，先度其数而赋于人，量出制入。","book":"《新唐书·杨炎传》"},"usage":"作谓语；用于管理"},{"id":44769,"word":"量凿正枘","pinyin":"liáng záo zhèng ruì","abbr":"lzzr","explanation":"指木工度量器物孔眼的大小方圆制作可与之相契合的榫头。比喻说话办事须从实际出发。","source":{"text":"事有所至，而巧不若拙，故圣人量凿而正枘。","book":"《楚辞·离骚》：“不量凿而正枘兮，固前修以葅醢。”《淮南子·人间训》"},"example":{"text":"西汉·刘安《淮南子·人间训》：“事有所至，而巧不若拙，故圣人～。”"},"similar":["量枘制凿"],"usage":"作宾语、定语；用于比喻句"},{"id":44770,"word":"量力度德","pinyin":"liàng lì duó dé","abbr":"lldd","explanation":"衡量自己的德行是否能够服人，估计自己的能力是否能够胜任。","source":{"text":"度德而处之，量力而行之。","book":"春秋·鲁·左丘明《左传·隐公十一年》"},"example":{"text":"～，《春秋》之义。","book":"南朝·宋·范晔《后汉书·崔寔传》"},"similar":["度德量力"],"usage":"作谓语；指衡量一个人的能力和德行"},{"id":44771,"word":"量力而为","pinyin":"liàng lì ér wéi","abbr":"llew","explanation":"量：估量。按照自己力量的大小去做，不要勉强。","source":{"text":"力能则进，否则退，量力而行。","book":"《左传·昭公十五年》"},"example":{"text":"法物所须，各以差降，士民之类，可～之。","book":"宋·张君房《云笈七签》卷一○三卷"},"similar":["量力而行"],"opposite":["力不从心"],"usage":"作谓语、定语；指做事实事求是的态度","story":["公元前712年，郑庄公借口许庄公不听周天子的命令，联合齐、鲁两国消灭许国，在处置问题上齐历公提议让鲁国管辖，鲁隐公则提议让郑庄公管辖。郑庄公量力而行将许国分成东西两块，东部由许庄公之弟许叔管，西边交大夫公孙获管辖"]},{"id":44772,"word":"量力而动","pinyin":"liàng lì ér dòng","abbr":"lled","explanation":"量：估量；动：行动。按照自己力量的大小去做，不要勉强。","source":{"text":"随之见伐，不量力也。量力而动，其过鲜矣。","book":"《左传·僖公二十年》"},"example":{"text":"审官而用者，君上之明也；～者，仁臣之义也。","book":"唐·独孤及《代于京兆请停官侍亲表》"}},{"id":44773,"word":"量力而行","pinyin":"liàng lì ér xíng","abbr":"llex","explanation":"量：估量；行：行事。按照自己力量的大小去做，不要勉强。","source":{"text":"力能则进，否则退，量力而行。","book":"《左传·昭公十五年》"},"example":{"text":"各位同学呢，大家～，能捐多少就捐多少。","book":"叶圣陶《英文教授》"},"similar":["实事求是","量入为出","量体裁衣"],"opposite":["力不从心","不自量力"],"usage":"作谓语、定语；指做事实事求是的态度","story":["公元前712年，郑庄公借口许庄公不听周天子的命令，联合齐、鲁两国消灭许国，在处置问题上齐历公提议让鲁国管辖，鲁隐公则提议让郑庄公管辖。郑庄公量力而行将许国分成东西两块，东部由许庄公之弟许叔管，西边交大夫公孙获管辖"]},{"id":44774,"word":"量如江海","pinyin":"liàng rú jiāng hǎi","abbr":"lrjh","explanation":"比喻度量非常大。","source":{"text":"你是多少人称赞，道你量如江海，器若丘山。","book":"元·董君瑞《般涉调·哨遍》"},"similar":["宽宏大量"],"usage":"作谓语、定语；指人的气度"},{"id":44775,"word":"量小力微","pinyin":"liàng xiǎo lì wēi","abbr":"lxlw","explanation":"数量很少，力量微薄。","source":{"text":"现在的各种小周刊，虽然量小力微，却是小集团或单身的短兵战，在黑暗中，时见匕首的闪光。","book":"鲁迅《华盖集·通讯》"},"example":{"text":"我们现在处在～的阶段。"},"similar":["势单力薄"],"opposite":["人多势众"],"usage":"作谓语、定语；指势单力薄"},{"id":44776,"word":"量小非君子，无毒不丈夫","pinyin":"liàng xiǎo fēi jūn zǐ，wú dú bù zhàng fū","abbr":"lxfjzwdbzf","explanation":"量：气量。气量小不是有才德的人。对仇敌打击不彻底算不得有作为的男人。","example":{"text":"心里不禁浮现出一句被他奉为经典的格言：～。","book":"罗广斌、杨益言《红岩》第六章"}},{"id":44777,"word":"量己审分","pinyin":"liàng jǐ shěn fèn","abbr":"ljsf","explanation":"估量自己，省察本分。","source":{"text":"悟性拙人闲，不习仕进……量己审分，不敢期荣。","book":"《南齐书·刘瓛传》"},"usage":"作谓语；用于书面语"},{"id":44778,"word":"量才器使","pinyin":"liàng cái qì shǐ","abbr":"lcqs","explanation":"指量才使用。","source":{"text":"军到即降者，保护其身家，愿留营者，量才器使；愿还乡者，厚给资斧，护送归乡。","book":"邹鲁《中国同盟会》"},"example":{"text":"他不是一向注意周密而且～的么？","book":"茅盾《子夜》五"},"similar":["量才录用"],"usage":"作谓语、宾语；用于选用人才"},{"id":44779,"word":"量才录用","pinyin":"liàng cái lù yòng","abbr":"lcly","explanation":"量：估量。根据才能大小分配一定工作。","source":{"text":"凡所擘画利害，不问何人，小则随事酬劳，大则量才录用。","book":"《礼记·王制》：“凡官民材必先论之，论辨然后使之。”宋·苏轼《上神守皇帝万言书》"},"example":{"text":"凡愿继续服务者，在人民政府接管后，准予～。","book":"毛泽东《中国人民解放军布告》"},"similar":["量入为出","量力而行","量体裁衣"],"opposite":["不自量力","一视同仁"],"usage":"作谓语、宾语；指按才能授职"},{"id":44780,"word":"量才而为","pinyin":"liàng cái ér wéi","abbr":"lcew","explanation":"按照自己力量的大小去做，不要勉强。","example":{"text":"你最好～，不要勉强自己。"},"similar":["量力而行"],"opposite":["不自量力"],"usage":"作谓语、定语；用于处事"},{"id":44781,"word":"量敌用兵","pinyin":"liàng dí yòng bīng","abbr":"ldyb","explanation":"量：估计；兵：兵力。根据敌方的具体情况，使用自己的兵力。"},{"id":44782,"word":"量时度力","pinyin":"liàng shí duó lì","abbr":"lsdl","explanation":"衡量时势，估计力量。","source":{"text":"帝有宽弘之量，忠恕之心，量时度力，举无过事。","book":"《元史·太宗纪》"},"similar":["审时度势"],"usage":"作谓语；同“审时度势”"},{"id":44783,"word":"量材录用","pinyin":"liàng cái lù yòng","abbr":"lcly","explanation":"根据才能大小分配一定工作。同“量才录用”。","source":{"text":"尔等果能悔悟来归，定然量材录用。","book":"太平天国·洪仁玕《诛妖檄文》"},"similar":["量才录用"],"usage":"作谓语、宾语；指按才能授职"},{"id":44784,"word":"量枘制凿","pinyin":"liáng ruì zhì záo","abbr":"lrzz","explanation":"比喻说话办事须从实际出发。同“量凿正枘”。","source":{"text":"从绳运斤，义且得于方正；量枘制凿，术仍取于纵横。","book":"唐·杨炯《卧读书架赋》"},"similar":["量凿正枘"],"usage":"作宾语、定语；用于比喻句"},{"id":44785,"word":"量能授器","pinyin":"liàng néng shòu qì","abbr":"lnsq","explanation":"根据人的能力大小而授予适当官职。","source":{"text":"论德而定次，量能而授官。","book":"《荀子·君道》"},"example":{"text":"推诚信士，不恤人之我欺，～，不患权之我逼。","book":"晋·陆机《辨亡论下》"}},{"id":44786,"word":"量能授官","pinyin":"liàng néng shòu guān","abbr":"lnsg","explanation":"根据人的能力大小而授予适当官职。","source":{"text":"论德而定次，量能而授官。","book":"《荀子·君道》"},"example":{"text":"陛下躬行大孝，鉴三王，建周道，兼文武，厉贤予禄，～。","book":"《史记·平津侯主父列传》"},"similar":["量才录用","任人唯贤"],"opposite":["任人唯亲"],"usage":"作谓语；指衡量人的能力大小而授予相应的官"},{"id":44787,"word":"量腹而食","pinyin":"liàng fù ér shí","abbr":"lfes","explanation":"形容自己加以节制。","source":{"text":"夫圣人量腹而食，度形而衣，节于己而已，贪污之心，奚由生哉？","book":"《淮南子·俶真训》"}},{"id":44788,"word":"量金买赋","pinyin":"liàng jīn mǎi fù","abbr":"ljmf","explanation":"指文章价值很高。","source":{"text":"孝武皇帝陈皇后，时得幸，颇妒，别在长门宫，愁闷悲思。闻蜀郡成都司马相如，天下工为文，奉黄金百斤，为相如、文君取酒，因于解悲愁之辞。而相如为文以悟主上，陈皇后复得亲幸。","book":"汉·司马相如《长门赋》序"},"example":{"text":"汉宫不锁陈皇后，谁肯～来？","book":"唐·黄滔《司马长卿》诗"},"similar":["千金买赋"],"usage":"作宾语、定语；指文章值钱","story":["西汉时期，汉武帝立表妹阿娇为皇后，陈皇后十年来没有生育儿子，嫉妒卫子夫妃子生儿子，被打入“长门宫”，失去了宠爱。她看了辞赋家司马相如的《子虚赋》，就送去一千金请他为自己写一篇《长门赋》，汉武帝看后就重新宠她"]},{"id":44789,"word":"量长较短","pinyin":"liáng cháng jiào duǎn","abbr":"lzjd","explanation":"量：衡量；较：比较。衡量、比较事物的长处和短处。原指比较人才的优劣。后用以比喻斤斤计较。","source":{"text":"较短量长，惟器是适者，宰相之方也。","book":"唐·韩愈《进学解》"},"example":{"text":"笑～，到头是梦，春三秋九，夫复何言。","book":"元·曹伯启《沁园春·用中丞敬相谢承卿送菊韵》"}},{"id":44790,"word":"金不换","pinyin":"jīn bù huàn","abbr":"jbh","explanation":"即使用金子来也不换，形容极为可贵。","source":{"text":"常言道：败子回头金不换。","book":"京剧《粉妆楼》第六本"},"example":{"text":"俗话说：浪子回头～。"},"usage":"作定语；形容极为可贵"},{"id":44791,"word":"金丹换骨","pinyin":"jīn dān huàn gǔ","abbr":"jdhg","explanation":"比喻诗人创作进入了造诣极深的顿悟境界。","source":{"text":"金丹换骨云者，盖以喻学诗工夫由渐修而入顿悟之境界。","book":"宋·陆游《夜吟》诗：“六十余年妄学诗，工夫深处独心知。夜来一笑寒灯下，始是金丹换骨时。”钱仲联校注"},"usage":"作宾语、定语；用于比喻句"},{"id":44792,"word":"金乌玉兔","pinyin":"jīn wū yù tù","abbr":"jwyt","explanation":"金乌：古代传说日中有三足乌，故称太阳为金乌；玉兔：古代传说中月中有玉兔，故称月亮为玉兔。借指时光。","source":{"text":"金乌飞，玉兔走，青鬓常青古无有。","book":"唐·韩琮《春愁》"},"example":{"text":"～最无情，驱驰不暂停。","book":"宋·张抡《阮郎归·咏夏》词"}},{"id":44793,"word":"金乌西坠，玉兔东升","pinyin":"jīn wū xī zhuì，yù tù dōng shēng","abbr":"jwxzytds","explanation":"乌：传说日中有三足乌，故称太阳为金乌；兔：传说中月中有玉兔，故称月亮为玉兔。太阳东山，月亮升起。指黄昏时分。也借指时光。","source":{"text":"金乌飞，玉兔走，青鬓常青古无有。","book":"唐·韩琮《春愁》"},"example":{"text":"一路说，一路行，不多时，早已～。","book":"清·钱彩《说岳全传》第十三回"},"usage":"作宾语、定语；指傍晚"},{"id":44794,"word":"金书铁券","pinyin":"jīn shū tiě quàn","abbr":"jstq","explanation":"铁券：古代帝王赐给功臣的铁制凭证。古代帝王赐给功臣世代享受优遇或免罪的凭证。","source":{"text":"赐臣金书铁券一道。","book":"唐·罗隐《代武肃王钱缪谢赐铁券表》"},"similar":["丹书铁券"],"usage":"作主语、宾语；指古代特权凭证"},{"id":44795,"word":"金人三缄","pinyin":"jīn rén sān jiān","abbr":"jrsj","explanation":"比喻因有顾虑而闭口不说话。","source":{"text":"孔子观周，遂入太祖后稷之庙。庙堂右阶之前有金人焉。三缄其口，而铭其背曰：‘古之慎言人也。’","book":"《孔子家语·观周》"},"example":{"text":"于是奉老氏多败之戒，思～之义。","book":"晋·葛洪《抱朴子·重言》"},"similar":["缄口不言"],"opposite":["滔滔不绝"],"usage":"作谓语；指缄口不言"},{"id":44796,"word":"金人之箴","pinyin":"jīn rén zhī zhēn","abbr":"jrzz","explanation":"比喻因有顾虑而闭口不说话。","source":{"text":"孔子观周，遂入太祖后稷之庙。庙堂右阶之前有金人焉。三缄其口，而铭其背曰：‘古之慎言人也。’","book":"三国·魏·王肃《孔子家语·观周》"},"example":{"text":"所以兄弟只得谨守～，不敢多事。","book":"清·李宝嘉《官场现形记》第24回"},"similar":["金人三缄"],"usage":"作宾语；比喻因有顾虑而闭口不说话"},{"id":44797,"word":"金人之缄","pinyin":"jīn rén zhī jiān","abbr":"jrzj","explanation":"比喻因有顾虑而闭口不说话。","source":{"text":"孔子观周，遂入太祖后稷之庙，庙堂右阶之前有金人焉，三缄其口，而铭其背曰：古之慎言人也。","book":"《孔子家语·观周》"}},{"id":44798,"word":"金人缄口","pinyin":"jīn rén jiān kǒu","abbr":"jrjk","explanation":"金人：铜制的人。缄口：封嘴，指缄默不言。铜人闭口不讲话。形容言词谨慎。亦作“金人三缄”。","source":{"text":"孔子观周，遂入太祖后稷之庙，庙堂右阶之前，有金人焉，三缄其口，而铭其背曰：‘古之慎言人也。’","book":"《孔子家语·观周》"},"similar":["金人三缄"],"usage":"作宾语、定语；用于说话等"},{"id":44799,"word":"金光灿烂","pinyin":"jīn guāng càn làn","abbr":"jgcl","explanation":"具有金色的光泽或光辉。","source":{"text":"只见城门石壁上镌着一副金字对联，字有斗大，远远望去，只觉金光灿烂。","book":"清·李汝珍《镜花缘》第二十回"},"example":{"text":"傍晚的天空～。"},"similar":["金光灿灿"],"usage":"作谓语、宾语；指有金色的光泽"},{"id":44800,"word":"金光盖地","pinyin":"jīn guāng gài dì","abbr":"jggd","explanation":"比喻钱神的本领高强。","source":{"text":"金光盖地，出梵书。此借喻钱神之道术也。","book":"清·蒲松龄《聊斋志异·席方平》：“金光盖地，因使阎摩殿上尽是阴霾；铜臭熏天，遂教枉死城中全无日月。”何垠注"},"usage":"作谓语、定语；用于比喻句"},{"id":44801,"word":"金光闪闪","pinyin":"jīn guāng shǎn shǎn","abbr":"jgss","explanation":"闪闪：光亮闪烁。金光闪烁耀眼。","source":{"text":"面上金光闪闪，手中雪刃辉辉。","book":"《新编五代史平话·唐史》"},"usage":"作谓语、定语；指光彩闪烁"},{"id":44802,"word":"金兰之交","pinyin":"jīn lán zhī jiāo","abbr":"jlzj","explanation":"像金石般坚固的交情。","source":{"text":"足下虽自以为与汉王为金石交，然终为汉王所擒矣。","book":"《汉书·韩信传》"},"similar":["金兰之友","金兰契友"],"usage":"作宾语；用于亲密的朋友"},{"id":44803,"word":"金兰之友","pinyin":"jīn lán zhī yǒu","abbr":"jlzy","explanation":"指亲密的朋友。","source":{"text":"二人同心，其利断金；同心之言，其臭如兰。","book":"《周易·系辞上》"}},{"id":44804,"word":"金兰之契","pinyin":"jīn lán zhī qì","abbr":"jlzq","explanation":"金：比喻坚；兰：比喻香；契：投合。指交情投合的朋友。","source":{"text":"二人同心，其利断金；同心之言，其臭如兰。","book":"《周易·系辞上》"},"example":{"text":"门馆游从，早托～；衣冠歆艳，共称冰玉之贤。","book":"宋·张孝祥《下定书》"},"similar":["莫逆之交","患难之交"],"opposite":["酒肉朋友"],"usage":"作宾语；指情投意合的朋友或结拜弟兄"},{"id":44805,"word":"金兰契友","pinyin":"jīn lán qì yǒu","abbr":"jlqy","explanation":"金兰：指友情投合，交谊深；契：投合；契友：情投意合的朋友。泛指结拜兄弟。","source":{"text":"二人同心，其利断金；同心之言，其臭如兰。","book":"《周易·系辞上》"},"example":{"text":"当初老丞相曾与令尊老先生～，二人指腹成亲。","book":"元·郑光祖《王粲登楼》"},"similar":["拜把兄弟"],"usage":"作宾语；指亲密的朋友"},{"id":44806,"word":"金刚努目","pinyin":"jīn gāng nǔ mù","abbr":"jgnm","explanation":"形容面目威猛可畏。","source":{"text":"隋吏部侍郎薛道衡，尝游钟山开善寺，谓小僧曰：‘金刚何为努目？菩萨何为低眉？’小僧答曰：‘金刚努目，所以降伏四魔；菩萨低眉，所以慈悲六道。’道衡怃然不能对。","book":"《太平广记》卷一七四引宋·庞元英《谈薮·薛道衡》"},"example":{"text":"板桥、心余未落笔时，先有意为刘蒋，～，正是力量歉处。","book":"清·陈廷焯《白雨斋词话》卷四"},"similar":["金刚怒目"],"usage":"作宾语、定语；形容面目威猛可畏"},{"id":44807,"word":"金刚怒目","pinyin":"jīn gāng nù mù","abbr":"jgnm","explanation":"怒目：睁大眼睛，眼珠突出。形容面目威猛可畏。","source":{"text":"金刚努目，所以降伏四魔；菩萨低眉，所以慈悲六道。","book":"《太平广记》卷一七四引《谈薮》"},"example":{"text":"不料他竟一点不窘，立刻用“～”式，向我大喝一声。","book":"鲁迅《且介亭杂文末编·我的第一个师父》"},"similar":["张牙舞爪","青面獠牙"],"opposite":["温文尔雅","低眉俯首","眉清目秀"],"usage":"作宾语、定语；形容面目威猛可畏","story":["隋朝时期，吏部侍郎薛道衡喜欢游历名胜古迹，他在游览钟山古寺开善寺时，见寺内各种金刚与菩萨形象各异，就好奇地问小和尚为什么金刚怒目而菩萨低眉，小和尚告诉他金刚怒目是为了降妖，菩萨低眉则为了对众生世界显其慈悲"]},{"id":44808,"word":"金刚眼睛","pinyin":"jīn gāng yǎn jīng","abbr":"jgyj","explanation":"指目光锐利能洞彻原形的眼睛。","source":{"text":"看诗须着金刚眼睛，庶不眩于旁门小法。","book":"宋·严羽《沧浪诗话·诗法》"},"example":{"text":"唯有～凭助汝发明真心。","book":"宋·释道原《景德传灯录·良匡禅师》"},"usage":"作宾语、定语；用于比喻句"},{"id":44809,"word":"金匮石室","pinyin":"jīn guì shí shì","abbr":"jgss","explanation":"匮：柜子。古时国家收藏重要文书处。","source":{"text":"迁为太史令，紬史记、石室金匮之书。","book":"《史记·太史公自序》"},"example":{"text":"自老聃写书征藏，以诒孔氏，然后竹帛下庶人，六籍既定，诸书复稍稍出～间。","book":"章炳麟《订孔上》"},"similar":["石室金匮"],"usage":"作宾语、定语；指古时国家收藏重要文书处"},{"id":44810,"word":"金华殿语","pinyin":"jīn huá diàn yǔ","abbr":"jhdy","explanation":"金华殿：宫殿名，汉成帝听郑宽中、张禹讲《尚书》、《论语》的地方。指金华殿中的讲说，不足以比拟真正的要言妙道。","source":{"text":"此关未至极，自是金华殿之语。","book":"南朝·宋·刘义庆《世说新语·言语》"},"usage":"作主语、宾语；用于口语"},{"id":44811,"word":"金印如斗","pinyin":"jīn yìn rú dǒu","abbr":"jyrd","explanation":"象斗一样大的金印。比喻官高位尊，功勋卓著。","source":{"text":"今年杀诸贼奴，当取一金印如斗大系肘。","book":"晋·郭澄之《郭子》"},"example":{"text":"迟子之献凯云台，奏事宣室，紫绶曳地，～。","book":"唐·王维《送高判官从军赴河西序》"}},{"id":44812,"word":"金印系肘","pinyin":"jīn yìn jì zhǒu","abbr":"jyxz","explanation":"象斗一样大的金印挂在手臂上。比喻官高位尊，功勋卓著。","source":{"text":"今年杀诸贼奴，当取一金印如斗大系肘。","book":"晋·郭澄之《郭子》"}},{"id":44813,"word":"金印紫绶","pinyin":"jīn yìn zǐ shòu","abbr":"jyzs","explanation":"黄金印章和系印的紫色绶带。古代相国、丞相、太尉、大司空、太傅、太师、太保、前后左右将军及六宫后妃所掌。后代指高官显爵。","source":{"text":"相国、丞相皆秦官，金印紫绶。","book":"东汉·班固《汉书·百官公卿表上》"},"example":{"text":"六宫称号，惟皇后贵人，～。","book":"南朝·宋·范晔《后汉书·皇后纪论》"},"similar":["金章紫绶"],"usage":"作宾语、定语；指高官显爵"},{"id":44814,"word":"金友玉昆","pinyin":"jīn yǒu yù kūn","abbr":"jyyk","explanation":"友、昆：指兄弟。对他人兄弟的美称。","source":{"text":"辛攀，字怀远，陇西狄道人也……兄鉴旷，弟宝迅，皆以才识著名。秦雍为之谚曰：‘三龙一门，金友玉昆。’","book":"北魏·崔鸿《十六国春秋·前凉·辛攀》"},"example":{"text":"说甚～，只是五龙一门。","book":"明·李贽《初潭集·兄弟上》"},"similar":["玉昆金友"],"usage":"作宾语；指对他人兄弟的美称"},{"id":44815,"word":"金口御言","pinyin":"jīn kǒu yù yán","abbr":"jkyy","explanation":"旧时用以指天子之言。后泛指说话正确，不能改变。同“金口玉音”。","source":{"text":"一个大人物，真像金口御言，有鬼神相助似的，说什么就是什么。","book":"聂绀弩《独夫之最后》"},"example":{"text":"我们不能把他的话当作～。"},"similar":["金口玉牙","金口玉言","金口玉音"],"usage":"作主语、宾语；指说话正确，不能改变"},{"id":44816,"word":"金口木舌","pinyin":"jīn kǒu mù shé","abbr":"jkms","explanation":"以木为舌的铜铃，即木铎，古代施行政教传布命令时所用。指宣扬教化的人。","source":{"text":"天之道不在仲尼乎？仲尼驾说者也；不在兹儒乎？如将复驾其所说，则莫若使诸儒金口而木舌。","book":"汉·扬雄《法言·学行》"},"example":{"text":"方领圆冠，～，谈章句之远旨，构纷纶之雅说。","book":"南朝·梁·何逊《七召·儒学》"},"usage":"作宾语；指宣扬圣人教化的话"},{"id":44817,"word":"金口玉牙","pinyin":"jīn kǒu yù yá","abbr":"jkyy","explanation":"金、玉：比喻珍贵。指皇帝是金口玉牙，说什么是什么，不能更改。现比喻说一不二。","source":{"text":"今乃金口玉音，漠然沉默。","book":"晋·夏侯湛《抵疑》"},"example":{"text":"不信你长个～！我故意从屋里取来秤一称。","book":"柳青《创业史》第二部第一章"},"similar":["金口玉言","说一不二"],"usage":"作主语、宾语；指说一不二"},{"id":44818,"word":"金口玉言","pinyin":"jīn kǒu yù yán","abbr":"jkyy","explanation":"旧时俗指皇帝说的话。现在指说出口不能改变的话（用在讽刺）。","source":{"text":"今乃金口玉音，漠然沈默。使吾子栖迟穷巷，守此困极。","book":"晋·夏侯湛《抵疑》"},"example":{"text":"拜舞已毕，天子～，问道：“卿是许武之弟乎？”","book":"明·冯梦龙《醒世恒言·三孝廉让产立高名》"},"similar":["金科玉律","金口玉牙","金口玉音"],"usage":"作主语、宾语；指说话正确，不能改变"},{"id":44819,"word":"金口玉音","pinyin":"jīn kǒu yù yīn","abbr":"jkyy","explanation":"旧时用以指天子之言。后泛指说话正确，不能改变。","source":{"text":"金口玉音，漠然沉默。","book":"晋·夏侯湛《抵疑》"},"similar":["金口玉牙","金口玉言","金口御言"],"usage":"作主语、宾语；指说话正确，补能改变"},{"id":44820,"word":"金台市骏","pinyin":"jīn tái shì jùn","abbr":"jtsj","explanation":"犹言千金市骨。指不惜以高价买养骏马。比喻延揽贤才十分诚恳。","source":{"text":"语出《战国策·燕策一》所载燕昭王筑黄金台招贤的故事。"},"example":{"text":"长安少年多驰骤车马以为乐，超尘逐电，劳瘁不辞。一骑之费，有贵至数百金者。岂犹有～之遗风欤？","book":"清·富察敦崇《燕京岁时记·大钟诗》"},"similar":["千金市骨"],"usage":"作宾语、定语；用于求贤"},{"id":44821,"word":"金吾不禁","pinyin":"jīn wú bù jìn","abbr":"jwbj","explanation":"金吾：秦汉时执掌京城卫戍的地方官。本指古时元宵及前后各一日，终夜观灯，地方官取消夜禁。后也泛指没有夜禁，通宵出入无阻。","source":{"text":"西都京城街衢，有金吾晓暝传呼，以禁夜行；惟正月十五日夜敕许金吾弛村，前后各一日。","book":"唐·韦述《西都杂记》"},"example":{"text":"北门管钥，亦为竟夕不键，殆所谓～欤？","book":"清·王韬《瀛壖杂志》"},"similar":["畅通无阻"],"usage":"作宾语、定语；指畅通无阻"},{"id":44822,"word":"金块珠砾","pinyin":"jīn kuài zhū lì","abbr":"jkzl","explanation":"黄金被当成土块，珍珠被当成砂砾。","source":{"text":"鼎铛玉石，金块珠砾，弃掷逦迤。","book":"唐·杜牧《阿房宫赋》"},"usage":"作定语；指视钱财如粪土"},{"id":44823,"word":"金城千里","pinyin":"jīn chéng qiān lǐ","abbr":"jcql","explanation":"指辽阔的国土坚城环绕，险固可靠。","source":{"text":"虽复舳舻沸海，旌旗触天，铁山四面，金城千里，亦不能为敌人计矣。","book":"《史记·留侯世家》：“夫关中左肴函，右陇蜀，沃野千里……此所谓金城千里，天府之国也。”唐·王勃《上刘右相书》"},"example":{"text":"秦地最胜，无如咸阳，被山带河，～。","book":"《东周列国志》第八十七回"},"usage":"作宾语、定语；用于书面语"},{"id":44824,"word":"金城汤池","pinyin":"jīn chéng tāng chí","abbr":"jctc","explanation":"城、池：城墙和护城河；汤：热水。金属的城墙，滚水的护城河。比喻坚固无比、防守严密的城市或工事。","source":{"text":"边地之城，必将婴城固守，皆为金城汤池，不可攻也。","book":"《汉书·蒯通传》"},"example":{"text":"有你这样的好弟兄，好帮手，仙霞就是～，满州人插上翅膀也过不来！","book":"华而实《汉衣冠》三"},"similar":["铜墙铁壁","固若金汤"],"usage":"作主语、宾语、定语；比喻根据牢固","story":["秦末陈胜起义军冲击秦王朝的统治，陈胜的部将武臣率军攻打越地范阳，蒯通去拜会并劝说范阳县令徐公，徐公放弃守城。蒯通就去拜会武臣，劝武臣妥善安置徐公，这样别的负隅顽抗的金城汤池的守备也会投降，武臣同意他的意见"]},{"id":44825,"word":"金城石室","pinyin":"jīn chéng shí shì","abbr":"jcss","explanation":"比喻险固的城池。","source":{"text":"近刘氏据三关之险，守重山之固，可谓金城石室，万世之业。","book":"《三国志·吴志·贺邵传》"},"usage":"作宾语、定语；用于比喻句"},{"id":44826,"word":"金声掷地","pinyin":"jīn shēng zhì dì","abbr":"jszd","explanation":"指掷地作金石之声。形容语言文字铿锵有力。","source":{"text":"卿试掷地，当作金石声也。","book":"《晋书·孙绰传》"},"example":{"text":"能以作四六平仄之法，用于宾白之中，则字字铿锵，人人乐听，有‘～’之评矣。","book":"清·李渔《闲情偶寄·词曲·宾白》"},"usage":"作宾语、定语；用于比喻句"},{"id":44827,"word":"金声玉振","pinyin":"jīn shēng yù zhèn","abbr":"jsyz","explanation":"以钟发声，以磬收韵，奏乐从始至终。比喻音韵响亮、和谐。也比喻人的知识渊博，才学精到。","source":{"text":"集大成也者，金声而玉振之也。金声也者，始条理也；玉振之也者，终条理也。始条理者，智之事也；终条理者，圣之事也。","book":"《孟子·万章下》"},"example":{"text":"～，寥亮于区寓。","book":"南朝齐·王俭《褚渊碑文》"},"similar":["掷地有声","声成金石"],"usage":"作定语、状语；指名声"},{"id":44828,"word":"金声玉服","pinyin":"jīn shēng yù fú","abbr":"jsyf","explanation":"比喻人的坚贞品格和操守。同“金声玉色”。","source":{"text":"实，其志气之见也；使人如己，不若金声玉服。","book":"战国·宋·墨翟《墨子·经说》"},"example":{"text":"言其实充美则见于外者，若～之昭著，即所谓荣也。","book":"孙诒让《墨子闲诂》"},"similar":["金声玉色"],"usage":"作宾语、定语；用于书面语"},{"id":44829,"word":"金声玉润","pinyin":"jīn shēng yù rùn","abbr":"jsyr","explanation":"金：指钟；玉：指磬。比喻文章气韵优美。","source":{"text":"玉润而金声。","book":"东汉·班固《东都赋》"},"example":{"text":"～，绣错绮文，赋体之正宗也。","book":"刘师培《文说》"},"usage":"作宾语；比喻文章气韵优美"},{"id":44830,"word":"金声玉色","pinyin":"jīn shēng yù sè","abbr":"jsys","explanation":"比喻人的坚贞品格和操守。","source":{"text":"经危蹈险，不易其节，金声玉色，久而弥彰。","book":"《三国志·魏志·管宁传》"},"example":{"text":"晋·陈寿《三国志·魏志·管宁传》：“经危蹈险，不易其节，～，久而弥彰。”"},"similar":["金声玉服"],"usage":"作宾语、定语；用于书面语"},{"id":44831,"word":"金壶墨汁","pinyin":"jīn hú mò zhī","abbr":"jhmz","explanation":"指极其珍贵罕见的书画用品。","source":{"text":"浮提之国献通善书二人，乍老乍少，隐形则出声，闻声则隐形，出肘间金壶四寸，上有五龙之检，封以青泥，壶中有墨汁如淳漆，洒地及石，皆成篆隶科斗之字。","book":"晋·王嘉《拾遗记·周灵王》"},"usage":"作宾语、定语；用于书面语"},{"id":44832,"word":"金头银面","pinyin":"jīn tóu yín miàn","abbr":"jtym","explanation":"形容挂金戴银，打扮得十分华丽讲究。","source":{"text":"他男人在外头不多几时，那些小老婆子们便金头银面的妆扮起来了。","book":"清·曹雪芹《红楼梦》第一○三回"}},{"id":44833,"word":"金字招牌","pinyin":"jīn zì zhāo pái","abbr":"jzzp","explanation":"旧时店铺为显示资金雄厚而用金箔贴字的招牌。现比喻高人一等可以炫耀的名义或称号。也比喻名誉好。","source":{"text":"珏斋郆只出使了一次朝鲜，办结了甲申金玉均一案，又曾同威毅伯和日本伊滕博文定了出兵朝鲜彼此知会的条约，总算一帆风顺，文武全才的金字招牌，还高高挂着。","book":"清·曾朴《孽海花》第二十五回"},"example":{"text":"只要敬爱他的人，多发挥这一点，不要七手八脚，专门把他拖进自己所好的油或泥里去做～就好了。","book":"鲁迅《花边文学·趋时与复古》"},"opposite":["臭名远扬"],"usage":"作主语、定语、宾语；指人炫耀的称号"},{"id":44834,"word":"金尽裘弊","pinyin":"jīn jìn qiú bì","abbr":"jjqb","explanation":"皮袍破了，钱用完了。比喻境况困难。","source":{"text":"说秦王书十上而说不行，黑貂之裘弊，黄金百斤尽。","book":"《战国策·齐策一》"},"example":{"text":"～，耻还乡里。","book":"清·纪昀《阅微草堂笔记·滦阳续录五》"},"similar":["金尽裘敝"],"usage":"作宾语、定语；比喻境况困难"},{"id":44835,"word":"金尽裘敝","pinyin":"jīn jìn qiú bì","abbr":"jjqb","explanation":"皮袍破了，钱用完了。形容贫困失意的样子。","source":{"text":"说秦王书十上而说不纳。黑貂之裘弊，黄金百镒尽。资用乏绝，去秦而归。","book":"西汉·刘向《战国策·秦策一》"},"example":{"text":"甚或～，耻还乡里，萍飘蓬转，不通音问者，亦往往有之。","book":"清·纪昀《阅微草堂笔记·滦阳续录五》"},"similar":["弹尽粮绝"],"usage":"作宾语、定语；比喻境况困难"},{"id":44836,"word":"金屋之选","pinyin":"jīn wū zhī xuǎn","abbr":"jwzx","explanation":"指被贵人选为妻室。","source":{"text":"只是小女貌丑，恐不足岂金屋之选，相烦好言达上。","book":"明·冯梦龙《醒世恒言》第11卷"},"similar":["金屋藏娇"],"usage":"作宾语；用于女性"},{"id":44837,"word":"金屋娇娘","pinyin":"jīn wū jiāo niáng","abbr":"jwjn","explanation":"指高贵而美丽之女子。","source":{"text":"蓦遇著这金屋娇娘，猛回头何方故乡？","book":"明·孟称舜《娇红记·会娇》"},"usage":"作主语、宾语、定语；用于女性"},{"id":44838,"word":"金屋藏娇","pinyin":"jīn wū cáng jiāo","abbr":"jwcj","explanation":"娇：原指汉武帝刘彻的表妹陈阿娇。汉武帝幼小时喜爱阿娇，并说要让她住在金屋里。指以华丽的房屋让所爱的妻妾居住。也指取妾。","source":{"text":"若得阿娇作妇，当作金屋贮之也。","book":"汉·班固《汉武故事》"},"example":{"text":"所以当时佘老五恋着雁翎，各有～之意。","book":"清·黄小配《廿载繁华梦》第二十三回"},"similar":["金屋贮娇"],"usage":"作谓语、宾语、定语；指娶妻或纳妾","story":["西汉时期，汉武帝刘彻年幼时非常活泼与聪明，和姑母长公主刘嫖一起玩耍。刘嫖问他将来想要娶什么样的媳妇。刘彻指着刘嫖的女儿阿娇说：“将来我要造一座黄金屋，娶阿娇为妻，把她藏在里面。”"]},{"id":44839,"word":"金屋贮娇","pinyin":"jīn wū zhù jiāo","abbr":"jwzj","explanation":"金屋：华丽的房屋；娇：阿娇，汉武帝刘彻姑母的长女，借指美丽的女子。指娶妻或纳妾。","source":{"text":"好！若得阿娇作妇，当作金屋贮之也。","book":"东汉·班固《汉武故事》"},"example":{"text":"～时，不言君不入。","book":"南朝·梁·费昶《长门怨》"},"similar":["金屋藏娇"],"usage":"作谓语、宾语、定语；指娶妻或纳妾","story":["汉武帝刘彻年幼时非常活泼与聪明，和姑母长公主刘嫖一起玩耍。刘嫖问他将来想要娶什么样的媳妇。刘彻指着刘嫖的女儿阿娇说：“将来我要造一座黄金屋，娶阿娇为妻，把她藏在里面。”"]},{"id":44840,"word":"金帛珠玉","pinyin":"jīn bó zhū yù","abbr":"jbzy","explanation":"帛：丝织品。黄金、绢帛、珍珠、美玉。形容珍贵的东西。","source":{"text":"其气非金帛珠玉也，不可求于人也。","book":"汉·韩婴《韩诗外传》第八卷"},"usage":"作宾语、定语；用于比喻句"},{"id":44841,"word":"金徽玉轸","pinyin":"jīn huī yù zhěn","abbr":"jhyz","explanation":"徽：系琴弦的丝线；轸：转动琴弦的轴。高贵、雅致的琴徽和琴轴。形容流畅悦耳的琴声。也比喻超凡脱俗的雅调。","source":{"text":"低红掩翠方无色，金徽玉轸为谁铿。","book":"晋·刘妙容《宛转歌二首》其二"},"example":{"text":"～方步武，虚堂榜名无自若。","book":"宋·龚明之《中吴纪闻·郏子高》"}},{"id":44842,"word":"金戈铁甲","pinyin":"jīn gē tiě jiǎ","abbr":"jgtj","explanation":"比喻战争。也形容战士持枪驰马的雄姿。同“金戈铁马”。","source":{"text":"他如今管领着金戈铁甲，簇拥着鼓吹鸣笳，他虽是违条犯法，咱无甚势剑铜铡。","book":"元·乔吉《两世姻缘》第三折"},"example":{"text":"～渡江来，红粉青娥化作灰。","book":"清·方文《刘旋九招集韦园观家伎》诗"},"similar":["金戈铁骑","金戈铁马"],"usage":"作谓语、宾语、定语；用于描写战争"},{"id":44843,"word":"金戈铁马","pinyin":"jīn gē tiě mǎ","abbr":"jgtm","explanation":"戈闪耀着金光，马配备了铁甲。比喻战争。也形容战士持枪驰马的雄姿。","source":{"text":"金戈铁马，蹂践于明时。","book":"《新五代史·李袭吉传》"},"example":{"text":"想当年～，气吞万里如虎。","book":"宋·辛弃疾《永遇乐·京口北固亭怀古》词"},"similar":["雄姿英才","大动干戈"],"opposite":["轻歌曼舞","天下太平"],"usage":"作谓语、宾语、定语；用于描写战争"},{"id":44844,"word":"金戈铁骑","pinyin":"jīn gē tiě qí","abbr":"jgtq","explanation":"比喻战争。也形容战士持枪驰马的雄姿。同“金戈铁马”。","source":{"text":"我太祖、太宗发祥之址，与夫金戈铁骑百战创业之区，皆所跋涉而导从。","book":"清·汪琬《〈苑西集〉序》"},"example":{"text":"～连蕃汉，烟尘茄角满关山。","book":"清·钱彩《说岳全传》第十五回"},"similar":["金戈铁马","铁马金戈"],"usage":"作谓语、宾语、定语；用于描写战争"},{"id":44845,"word":"金断觿决","pinyin":"jīn duàn xī jué","abbr":"jdxj","explanation":"如同金属的刀斧砍物，骨制成的锥子解结。形容决断迅速。","source":{"text":"叔则不以此时金断觿决，示斗极于中流，而又奚待与？","book":"清·钱谦益《复李叔则书》"},"similar":["斩钉截铁"],"usage":"作谓语、定语；用于处事"},{"id":44846,"word":"金无足赤","pinyin":"jīn wú zú chì","abbr":"jwzc","explanation":"足赤：成色十足的金子。比喻人也不能十全十美。","source":{"text":"黄金无足色，白璧有微瑕。求人不求备，妾愿老君家。","book":"宋·戴复古《寄兴》"},"example":{"text":"～，人无完人。"},"similar":["人无完人","白壁微瑕"],"opposite":["完美无缺","十全十美"],"usage":"作谓语、定语；指人不能十全十美"},{"id":44847,"word":"金无足赤，人无完人","pinyin":"jīn wú zú chì，rén wú wán rén","abbr":"jwzcrwwr","explanation":"足赤：足金，纯金。没有纯而又纯的金子。比喻没有十全十美的事物。也比喻不能要求一个人没有一点缺点错误。","source":{"text":"黄金无足色，白璧有微瑕。求人不求备，妾愿老君家。","book":"宋·戴复古《寄兴》"},"example":{"text":"～，谁没有毛病呢？"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":44848,"word":"金昭玉粹","pinyin":"jīn zhāo yù cuì","abbr":"jzyc","explanation":"指如金玉之明美。","source":{"text":"君彼东朝，金昭玉粹。","book":"南朝·宋·颜延之《应诏宴曲水作》诗"},"example":{"text":"徽音孔昭，宝传斯刻。～，有烨斯册。","book":"《宋史·乐志》"},"usage":"作宾语、定语；用于比喻句"},{"id":44849,"word":"金枝玉叶","pinyin":"jīn zhī yù yè","abbr":"jzyy","explanation":"原形容花木枝叶美好。后多指皇族子孙。现也比喻出身高贵或娇嫩柔弱的人。","source":{"text":"胡蝶、胡蝶，飞上金枝玉叶。","book":"晋·崔豹《古今注·舆服》：“与蚩尤战于涿鹿之野，常有五色云气金枝玉叶止于帝上。”唐·王建《宫中调笑》词"},"example":{"text":"嫂又～，吹股风都要生病。","book":"沙汀《一个秋天的晚上》"},"similar":["皇亲国戚","玉叶金枝","玉叶金柯"],"opposite":["蓬门荆布","赳赳武夫"],"usage":"作宾语、定语；称呼有钱人家的女儿"},{"id":44850,"word":"金枝花萼","pinyin":"jīn zhī huā è","abbr":"jzhe","explanation":"比喻皇室的子孙后代。","source":{"text":"牒出金枝，系连花萼，宜承大统诸宗长。","book":"清·孔尚任《桃花扇·设朝》"}},{"id":44851,"word":"金枷玉锁","pinyin":"jīn jiā yù suǒ","abbr":"jjys","explanation":"枷：套在脖子上的刑具；锁：用铁环连接而成的刑具。比喻儿女既是父母的宝贝，又是负担和包袱。","source":{"text":"到来日只少个殃人祸，儿女是金枷玉锁。","book":"元·无名氏《小张屠》第二折"},"example":{"text":"儿女是～，欢喜冤家，我都割舍了他。","book":"元·马致远《马丹阳三化任风子》第二折"},"usage":"作宾语、定语；指儿女"},{"id":44852,"word":"金榜挂名","pinyin":"jīn bǎng guà míng","abbr":"jbgm","explanation":"指科举得中。同“金榜题名”。","source":{"text":"若要洞府花烛夜，必须金榜挂名时。","book":"元·秦简夫《剪发待宾》第二折：“直等的俺孩儿金榜挂名时，那其间新婚燕尔。”明·冯梦龙《警世通言》第十七卷"},"example":{"text":"到那时，我是要恭贺你和小表嫂的～，洞房花烛了。","book":"清·曾朴《孽海花》第四回"},"similar":["金榜题名"],"opposite":["名落孙山"],"usage":"作谓语、宾语、定语；指科举得中"},{"id":44853,"word":"金榜题名","pinyin":"jīn bǎng tí míng","abbr":"jbtm","explanation":"金榜：科举时代称殿试揭晓的榜；题名：写上名字。指科举得中。","source":{"text":"何扶，太和九年及第；明年，捷三篇，因以一绝寄旧同年曰：‘金榜题名墨上新，今年依旧去年春。花间每被红妆问，何事重来只一人。’","book":"五代·五王保《唐摭言》卷三"},"example":{"text":"旬月之间，～，已登三甲进士。","book":"明·洪楩《清平山堂话本·陈巡检梅岭失妻记》"},"similar":["金榜挂名","名列前茅"],"opposite":["名落孙山","榜上无名"],"usage":"作谓语、宾语、分句；指科举得中"},{"id":44854,"word":"金母木公","pinyin":"jīn mǔ mù gōng","abbr":"jmmg","explanation":"金：五行之一，西方属金；木：五行之一，东方属木。指仙人东王公和西王母。比喻年高有才德的人。","source":{"text":"所云意马心猿，金母木公《西游记》中作‘金公’、‘木母’，比喻孙悟空和猪八戒。","book":"清·闲斋老人《儒林外史·序》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":44855,"word":"金汤之固","pinyin":"jīn tāng zhī gù","abbr":"jtzg","explanation":"像金城汤池那样牢不可破。","source":{"text":"右并城隍，赖有金汤之固。","book":"明·张岱《龙山文帝祠募疏》"},"example":{"text":"故宗庙社稷，乃得磐石之安，～。","book":"明·许仲琳《封神演义》第九回"},"similar":["金城汤池"],"usage":"作宾语；用于比喻句"},{"id":44856,"word":"金波玉液","pinyin":"jīn bō yù yè","abbr":"jbyy","explanation":"比喻美酒。","source":{"text":"今闻老母被囚，虽金波玉液不能下咽矣。","book":"明·罗贯中《三国演义》第八十八回"},"example":{"text":"海错山珍锦盘中，捧着龙肝凤胆；～银壶内，泛出青黄碧绿。","book":"《粉妆楼》第七十九回"},"similar":["琼浆玉液"],"usage":"作宾语、定语；指酒"},{"id":44857,"word":"金浆玉液","pinyin":"jīn jiāng yù yè","abbr":"jjyy","explanation":"道教说是一种用金和玉溶于朱草而成的仙药。也指美酒。","source":{"text":"真朋羽会，金浆玉液。","book":"唐·陈子昂《送中岳二三真人序》"},"similar":["金浆玉醴"],"usage":"作宾语；比喻美酒"},{"id":44858,"word":"金浆玉醴","pinyin":"jīn jiāng yù lǐ","abbr":"jjyl","explanation":"浆：酒；醴：甜酒。原指仙药，后指美酒佳酿。","source":{"text":"朱草生名山岩石中，汁如血，以金玉投其中，立便可丸如泥，久则成水。以金投之，名为金浆，以玉投之，名为玉醴，服之皆长生。","book":"晋·葛洪《抱朴子·内篇》"},"example":{"text":"道家谓之～。","book":"明·李时珍《本草纲目·人一·口津唾》"},"similar":["金浆玉液"],"usage":"作宾语、定语；指美酒"},{"id":44859,"word":"金淘沙拣","pinyin":"jīn táo shā jiǎn","abbr":"jtsj","explanation":"从沙里淘拣金子。比喻写作时琢词炼句。","source":{"text":"新词细写乌丝阑，都是金淘沙拣。","book":"清·孔尚任《桃花扇·侦戏》"},"usage":"作宾语、定语；多用于写作等"},{"id":44860,"word":"金漆饭桶","pinyin":"jīn qī fàn tǒng","abbr":"jqft","explanation":"饭桶：比喻无用的人。用金漆漆过的饭桶。指服饰华丽而无德无才的人。","source":{"text":"说说也气人！他背后说老师是个‘金漆饭桶’。","book":"清·李宝嘉《官场现形记》第27回"},"similar":["金漆马桶"],"usage":"作宾语、定语；指无能的人"},{"id":44861,"word":"金漆马桶","pinyin":"jīn qī mǎ tǒng","abbr":"jqmt","explanation":"马桶：粪桶。用金漆漆过的粪桶。指服饰华丽而无德无才的人。","source":{"text":"一个个不管自己肚子里是一团粪草，只顾外面打扮得美服华冠，可不像个金漆马桶。","book":"清·文康《儿女英雄传》第三十四回"},"example":{"text":"只两包袱衣服。两床缎被，一双鸳鸯绣花枕头，一对～，佟家来两个拥人一抱全走了。","book":"冯骥才《三雨金莲》"},"similar":["金漆饭桶","洋漆马桶"],"usage":"作宾语、定语；指缺德的人"},{"id":44862,"word":"金牙铁齿","pinyin":"jīn yá tiě chǐ","abbr":"jytc","explanation":"牙口结实，如同金铁。比喻年高体健。","source":{"text":"金牙铁齿，西王母子。","book":"汉·焦延寿《易林》"}},{"id":44863,"word":"金玉之言","pinyin":"jīn yù zhī yán","abbr":"jyzy","explanation":"金玉：黄金和美玉。象黄金美玉那样珍贵的话语。比喻可贵而有价值的劝告。","source":{"text":"小姐金玉之言，小生一一铭之肺腑。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"恩相～，某当终身佩铭。","book":"明·冯梦龙《醒世恒言》卷三十"},"similar":["金玉良言","金石之言"],"usage":"作主语、宾语；比喻可贵而有价值的劝告"},{"id":44864,"word":"金玉其外，败絮其中","pinyin":"jīn yù qí wài，bài xù qí zhōng","abbr":"jyqwbxqz","explanation":"金玉：比喻华美；败絮：烂棉花。外面象金象玉，里面却是破棉絮。比喻外表很华美，而里面一团糟。","source":{"text":"观其坐高堂，骑大马，醉醇醴而饫肥鲜者，孰不巍巍乎可畏，赫赫乎可象也？又何往而不金玉其外，败絮其中也哉？","book":"明·刘基《卖柑者言》"},"example":{"text":"难怪人说长皮不长肉，中看不中吃！这才是～呢！","book":"欧阳山《三家巷》一"},"similar":["华而不实"],"opposite":["妍皮不包痴骨"],"usage":"作宾语、分句；比喻徒有其表","story":["从前杭州一个卖鲜水果的人，很会保藏柑子，他保藏的柑子外表金黄似玉，里面却像破旧的棉絮。买柑的人说他欺骗世人，他说世界上搞欺骗的人很多，包括文官武将，他们不为人民办事，难道不是金玉其外，败絮其中吗"]},{"id":44865,"word":"金玉其表","pinyin":"jīn yù qí biǎo","abbr":"jyqb","explanation":"金玉：珍宝。比喻外表很华美，而里面一团糟。","example":{"text":"我不喜欢他们那～的欺骗做法。"},"similar":["金玉其外，败絮其中","徒有其表"],"usage":"作宾语、定语；比喻徒有其表"},{"id":44866,"word":"金玉其质","pinyin":"jīn yù qí zhì","abbr":"jyqz","explanation":"质：本质，品质。指人的品质高洁。","source":{"text":"不惟金玉其质，亦且冰雪为心。","book":"清·李汝珍《镜花缘》第一回"},"usage":"作宾语、定语；用于比喻句"},{"id":44867,"word":"金玉满堂","pinyin":"jīn yù mǎn táng","abbr":"jymt","explanation":"堂：高大的厅堂。金玉财宝满堂。形容财富极多。也形容学识丰富。","source":{"text":"金玉满堂，莫之能守。","book":"《老子》第九章"},"example":{"text":"纵～，田连阡陌，不愿也。","book":"明·李贽《剪灯余话·凤尾草记》"},"similar":["堆金积玉"],"opposite":["家徒四壁"],"usage":"作谓语、宾语；形容财产很多"},{"id":44868,"word":"金玉良缘","pinyin":"jīn yù liáng yuán","abbr":"jyly","explanation":"原指符合封建秩序的姻缘。后泛指美好的姻缘。","source":{"text":"都道是金玉良缘，俺只念木石前盟。","book":"清·曹雪芹《红楼梦》第五回"},"usage":"作主语、宾语；用于婚姻等"},{"id":44869,"word":"金玉良言","pinyin":"jīn yù liáng yán","abbr":"jyly","explanation":"金玉：黄金和美玉。比喻可贵而有价值的劝告。","source":{"text":"小姐金玉之言，小生一一铭之肺腑。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"老哥哥教导的话，句句是～。","book":"清·李宝嘉《官场现形记》第十一回"},"similar":["肺腑之言","至理名言"],"opposite":["花言巧语","冷言冷语","恶言置辞"],"usage":"作主语、宾语；指忠告"},{"id":44870,"word":"金玉货赂","pinyin":"jīn yù huò lù","abbr":"jyhl","explanation":"货赂：指珍宝、财富。泛指黄金、美玉等珍贵的财宝。","source":{"text":"大破楚军，尽得楚国金玉货赂。","book":"《史记·高祖本纪》"},"similar":["金银财宝"],"usage":"作宾语、定语；用于书面语"},{"id":44871,"word":"金玉锦绣","pinyin":"jīn yù jǐn xiù","abbr":"jyjx","explanation":"指精美珍贵的东西。也比喻巧妙的计策。","source":{"text":"安有说人主，不能出其金玉锦绣，取卿相之尊者乎？","book":"《战国策·秦策一》"},"example":{"text":"介子怡然就席，故意将～，陈列席前，指示安归。","book":"蔡东藩《前汉演义》第七十九回"},"usage":"作宾语；指精美珍贵的东西"},{"id":44872,"word":"金璧辉煌","pinyin":"jīn bì huī huáng","abbr":"jbhh","explanation":"辉煌：光辉灿烂。形容建筑物等装饰华丽，光彩夺目","source":{"text":"只见许多艳服女子引一座金璧辉煌的车，坐着一个缨络垂肩的人。","book":"清·魏秀仁《花月痕》第44回"},"example":{"text":"山上的琉璃塔～，十分耀眼"},"similar":["金碧辉煌","金碧辉映"],"usage":"作谓语、宾语、定语；指光彩夺目"},{"id":44873,"word":"金瓯无缺","pinyin":"jīn ōu wú quē","abbr":"jowq","explanation":"金瓯：盛酒器，比喻国土。金瓯没有残缺。比喻国土完整。","source":{"text":"我国家犹若金瓯，无一伤缺。","book":"《南史·朱异传》"},"example":{"text":"但各州之地，俱半错卫屯，半沦苗孽，似非当时～矣。","book":"明·徐宏祖《徐霞客游记·黔游日记》"},"similar":["完整无缺"],"opposite":["残山剩水"],"usage":"作宾语；比喻国土完整","story":["南北朝时期，大将军萧衍杀死南齐的最后一个皇帝萧宝融后自己称帝建立梁朝，成为梁武帝。他重用奸臣朱异，北方降将侯景叛乱，他没有采纳谢举的打落水狗的建议，而称自己的国家像个没有缺陷的大金瓯，结果被叛军侯景所杀"]},{"id":44874,"word":"金瓶素绠","pinyin":"jīn píng sù gěng","abbr":"jpsg","explanation":"金瓶：汲水器皿；素：白色；绠：井绳。指井上汲水的器具。","source":{"text":"后园作井银作床，金瓶素绠汲寒浆。","book":"《古乐府·淮南王篇》"},"usage":"作宾语、定语；用于书面语"},{"id":44875,"word":"金瓶落井","pinyin":"jīn píng luò jǐng","abbr":"jplj","explanation":"金瓶掉落井底。比喻一去再无音讯。","source":{"text":"金瓶落井无消息，令人行叹复坐思。","book":"唐·李白《寄远》"},"example":{"text":"他此去如同～一般，从此杳无音信。"},"similar":["石沉大海"],"usage":"作主语、宾语；比喻一去再无音讯"},{"id":44876,"word":"金盆洗手","pinyin":"jīn pén xǐ shǒu","abbr":"jpxs","explanation":"旧指某些黑道人物公开宣布改邪归正，不再干违法的事。现也泛指放弃以前长期从事的行业或所做的某件事。"},{"id":44877,"word":"金相玉式","pinyin":"jīn xiāng yù shì","abbr":"jxys","explanation":"同“金相玉质”。","source":{"text":"金相玉式，艳谥锱毫。","book":"南朝·梁·刘勰《文心雕龙·辨骚》"},"similar":["金相玉质"],"usage":"作宾语、定语；用于比喻句"},{"id":44878,"word":"金相玉振","pinyin":"jīn xiāng yù zhèn","abbr":"jxyz","explanation":"比喻文章的形式和内容都完美。也形容人相貌端美。同“金相玉质”。","source":{"text":"若贤人之美辞，忠臣之抗直，谋夫之话，辩士之端，冰释泉涌，金相玉振。","book":"南朝·梁·萧统《文选》序"},"similar":["金相玉映","金相玉质","玉质金相"],"usage":"作宾语、定语；用于比喻句"},{"id":44879,"word":"金相玉映","pinyin":"jīn xiāng yù yìng","abbr":"jxyy","explanation":"比喻文章的形式和内容都完美。也形容人相貌端美。同“金相玉质”。","source":{"text":"相印师坛，共观昼锦；金相玉映，各炫晨葩。","book":"唐·司空图《故盐州防御使王纵追述碑》"},"similar":["金相玉式","金相玉质"],"usage":"作宾语、定语；用于比喻句"},{"id":44880,"word":"金相玉质","pinyin":"jīn xiàng yù zhì","abbr":"jxyz","explanation":"金、玉：比喻美好；相：外貌；质：本质。比喻文章的形式和内容都完美。也形容人相貌端美。","source":{"text":"所谓金相玉质，百世无匹，名垂罔极，永不刊灭者矣。","book":"汉·王逸《序》"},"example":{"text":"左首八字，是‘天上神仙，～’；右首八字，是‘女中豪杰，说礼明诗’。","book":"蔡东藩《民国通俗演义》第37回"},"similar":["金相玉映"],"usage":"作宾语、定语；形容人相貌品质都美"},{"id":44881,"word":"金石不渝","pinyin":"jīn shí bù yú","abbr":"jsby","explanation":"像金石那样不可改变。形容坚守盟约、节操等。","source":{"text":"享爵禄之崇高，荷宠灵之优渥，挺金石不渝之操。","book":"宋·欧阳修《除许怀德制》"},"example":{"text":"～，曲高无和必矣。","book":"溥仪《我的前半生》第四章"},"similar":["坚贞不渝"],"usage":"作宾语、定语；用于比喻句"},{"id":44882,"word":"金石丝竹","pinyin":"jīn shí sī zhú","abbr":"jssz","explanation":"金：指金属制的乐器；石：指石制的磬；丝：指弦类乐器；竹：指管类乐器。泛指各种乐器。也形容各种声音。","source":{"text":"多于聪者，乱五声，淫六律，金石丝竹，黄钟大吕之声，非乎，而师旷是已。","book":"《庄子·骈母》"},"example":{"text":"乐也者，郁于中而泄于外者也，择其善鸣者而作壁上观之鸣。～，匏土革木，八者，物之善鸣者也。","book":"唐·韩愈《送孟东野序》"},"usage":"作宾语；泛指各种乐器"},{"id":44883,"word":"金石为开","pinyin":"jīn shí wèi kāi","abbr":"jswk","explanation":"金石：金属和石头，比喻最坚硬的东西。连金石都被打开了。形容一个人心诚志坚，力量无穷。","source":{"text":"熊渠子见其诚心，而金石为之开，况人心乎？","book":"汉·刘向《新序·杂事四》"},"example":{"text":"精诚所至。贞心不寐，死后重谐。","book":"明·凌濛初《初刻拍案惊奇》卷九"},"similar":["金石可开"],"opposite":["无动于衷"],"usage":"作谓语、定语；常与“精诚所至”连用","story":["西汉名将“飞将军”李广喜欢打猎，他的箭法特别准，经常带回很多猎物。一天傍晚他与弟弟上山打猎，看到一只老虎，李广拔箭就射，正中虎身。上前一看，原来是一块虎形石，他拔箭再射都没射进。扬雄评论说：“至诚则金石为开。”"]},{"id":44884,"word":"金石之交","pinyin":"jīn shí zhī jiāo","abbr":"jszj","explanation":"交：交情。比喻像金石一样牢不可破的交情。","source":{"text":"足下虽自以为与汉王为金石交，然终为汉王所禽矣。","book":"东汉·班固《汉书·韩信传》"},"example":{"text":"这样～我们是否已经缔订？","book":"郭沫若《战声集·人类进化的驿程》"},"similar":["生死之交","患难之交"],"opposite":["一面之交","对头冤家"],"usage":"作宾语；指友谊很深"},{"id":44885,"word":"金石之功","pinyin":"jīn shí zhī gōng","abbr":"jszg","explanation":"金：指钟鼎类。石：指碑碣类。刻在钟鼎碑碣之上，永不磨灭的功勋。","source":{"text":"领国之仇结于外，臣下之怨结于内，而欲建金石之功，终传不绝之世，岂不难哉？","book":"汉·陆贾《新语·至德》"},"example":{"text":"戮力上国，流惠下民，建永世之业，流～。","book":"三国·魏·曹植《与杨德祖书》"}},{"id":44886,"word":"金石之坚","pinyin":"jīn shí zhī jiān","abbr":"jszj","explanation":"象金属和石头那样坚硬。形容极为坚硬或强固。","source":{"text":"虽有金石之坚，犹将销铄而挺解也。","book":"汉·枚乘《七发》"},"example":{"text":"和而不同，性有盐梅之德，磨而不磷，同怀～。","book":"宋·苏辙《除冯京彦德军节度使制》"},"usage":"作宾语；形容极为坚硬或强固"},{"id":44887,"word":"金石之策","pinyin":"jīn shí zhī cè","abbr":"jszc","explanation":"形容如同金、石一般经久而稳定的策略。","source":{"text":"故信庸庸之论，破金石之策。","book":"《后汉书·冯衍传》"},"similar":["金石之计"],"usage":"作宾语；指牢靠的策略"},{"id":44888,"word":"金石之言","pinyin":"jīn shí zhī yán","abbr":"jszy","explanation":"象黄金宝石那样珍贵的话语。比喻可贵而有价值的劝告。","source":{"text":"小姐金玉之言，小生一一铭之肺腑。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"兄长～，小弟当铭刻肺腑。","book":"清·禇人获《隋唐演义》第十一回"},"similar":["金石良言"],"usage":"作宾语；比喻宝贵的教导"},{"id":44889,"word":"金石之计","pinyin":"jīn shí zhī jì","abbr":"jszj","explanation":"比喻最安全的计策。","source":{"text":"欲辞晋献公譬马之赂，而不假之夏阳之道，岂非金石之计哉？","book":"汉·陆贾《新语·资执》"},"similar":["金石之策"],"usage":"作宾语；指安全的计策"},{"id":44890,"word":"金石交","pinyin":"jīn shí jiāo","abbr":"jsj","explanation":"金石：金属和石头，比喻坚固；交：交情。像金石般坚固的交情。","source":{"text":"今足下虽自以为与汉王为金石交，然终为汉王所禽矣。","book":"东汉·班固《汉书·韩信传》"},"similar":["金石交","金石至交","金石交情"],"usage":"作宾语；指友谊很深"},{"id":44891,"word":"金石交情","pinyin":"jīn shí jiāo qíng","abbr":"jsjq","explanation":"比喻像金石一样牢不可破的交情。同“金石之交”。","source":{"text":"丝萝契合原非强，为其把金石交情一旦忘。","book":"明·胡文焕《群音类选·葛衣记·到既渝盟》"},"similar":["金石交","金石之交","金石至交"],"opposite":["一面之交"],"usage":"作宾语；指友谊很深"},{"id":44892,"word":"金石可开","pinyin":"jīn shí kě kāi","abbr":"jskk","explanation":"形容一个人心诚志坚，力量无穷。同“金石为开”。","source":{"text":"他更是从容不迫，把所有足以证明内战之会停止的种种论据罗列出来，融会在一种金石可开的信心里面。","book":"沙汀《范老老师》"},"similar":["金石为开"],"usage":"作定语；用于劝诫人"},{"id":44893,"word":"金石声","pinyin":"jīn shí shēng","abbr":"jss","explanation":"金属与石头撞击的声音。形容文辞精妙，音韵铿锵。","source":{"text":"祢衡被魏武谪为鼓吏，正月半试鼓，衡扬枹为渔阳掺挝，渊渊有金石声，四坐为之改容。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"尝作《天台山赋》，辞致甚工，初成，以示友人范荣期，云：‘卿试掷地，当作～也。","book":"《晋书·孙绰传》"}},{"id":44894,"word":"金石至交","pinyin":"jīn shí zhì jiāo","abbr":"jszj","explanation":"比喻像金石一样牢不可破的交情。同“金石之交”。","source":{"text":"今足下虽自以为与汉王为金石交，然终为汉王所擒矣。","book":"《汉书·淮阴侯传》"},"example":{"text":"卑人与令兄～，今与娘子又琴瑟永好，想是前缘分定呢。","book":"清·洪楝园《后南柯·招驸》"},"similar":["金石之交","金石交","金石交情"],"opposite":["冤家对头"],"usage":"作宾语；指友谊很深"},{"id":44895,"word":"金石良言","pinyin":"jīn shí liáng yán","abbr":"jsly","explanation":"象黄金宝石那样珍贵的话语。比喻可贵而有价值的劝告。","source":{"text":"小姐金玉之言，小生一一铭之肺腑。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"叔公教你的，都是～，务必一一记了，不可有负栽培。","book":"清·吴趼人《二十年目睹之怪现状》第九十九回"},"similar":["金玉良言"],"usage":"作宾语；指教导或劝告"},{"id":44896,"word":"金碗盛狗矢","pinyin":"jīn wǎn chéng gǒu shǐ","abbr":"jwsgs","explanation":"狗矢：狗屎。指小人位居高位。比喻地位与品德不相称。","source":{"text":"与冯延巳屏为昪相，晟轻延巳为人，常曰：‘金碗玉杯而盛狗矢可乎？’","book":"《新五代史·孙晟传》"}},{"id":44897,"word":"金碧荧煌","pinyin":"jīn bì yíng huáng","abbr":"jbyh","explanation":"形容建筑物装饰华丽，光彩夺目。同“金碧辉煌”。","source":{"text":"兖王假山成，请宫僚观之，姚坦熟视曰：‘此血山耳。’开宝塔成，田锡上疏曰：‘众以为金碧荧煌，臣以为涂膏衅血。’","book":"宋·罗大经《鹤林玉露》卷八"},"similar":["金壁辉煌"],"usage":"作宾语、定语；用于书面语"},{"id":44898,"word":"金碧辉映","pinyin":"jīn bì huī yìng","abbr":"jbhy","explanation":"形容建筑物装饰华丽，光彩夺目。同“金碧辉煌”。","source":{"text":"明·谢肇淛《滇略》卷四“点苍、鸡足、大鼎之间，缁徒云集，搭桂兰若，金碧辉映相若。”"},"example":{"text":"庙貌巍峨，～。","book":"清·百一居士《壶天录》卷下"},"similar":["金碧辉煌"],"usage":"作谓语、定语；指光彩夺目"},{"id":44899,"word":"金碧辉煌","pinyin":"jīn bì huī huáng","abbr":"jbhh","explanation":"碧：翠绿色。形容建筑物装饰华丽，光彩夺目。","source":{"text":"众以为金碧荧煌，臣以为涂膏衅血。","book":"宋·罗大经《鹤林玉露》补遗"},"example":{"text":"他便把门面装璜得～，把些光怪陆离的洋货，罗列在外。","book":"清·吴趼人《二十年目睹之怪现状》第七十七回"},"similar":["富丽堂皇"],"opposite":["黯然无光"],"usage":"作谓语、宾语、定语；指光彩夺目","story":["唐朝时期，画家李思训的书画造诣很深，十分擅长山水树石，笔力遒劲，能把云霞流水、鸟兽草木画得栩栩如生，他的山水画以金碧辉映，独创一格，笔法工整，色彩鲜艳，装饰性强，给人以绚烂多姿和富丽堂皇的印象，他的画风自成一家"]},{"id":44900,"word":"金科玉律","pinyin":"jīn kē yù lǜ","abbr":"jkyl","explanation":"科：旧指法律条文；律：规章，法则。原形容法令条文的尽善尽美。现比喻必须遵守、不能变更的信条。","source":{"text":"懿律嘉量，金科玉条。","book":"汉·扬雄《剧秦美新》"},"example":{"text":"他把他家里那种种可笑规矩，看成圣贤的～。","book":"清·李绿园《歧路灯》第一百三回"},"similar":["清规戒律","金口玉言","颠扑不破"],"usage":"作定语、宾语；指法律"},{"id":44901,"word":"金科玉条","pinyin":"jīn kē yù tiáo","abbr":"jkyt","explanation":"科、条：法律条文。原指完美的法律条文。后指不能更改、必须遵守的信条。","source":{"text":"懿律嘉量，金科玉条。","book":"汉·扬雄《剧秦美新》"},"example":{"text":"真台谏之～也。","book":"宋·罗大经《鹤林玉露·补遗》"},"similar":["金科玉律"],"usage":"作谓语、宾语；指法律"},{"id":44902,"word":"金科玉臬","pinyin":"jīn kē yù niè","abbr":"jkyn","explanation":"臬，标准，法式。原形容法令条文的尽善尽美。现比喻必须遵守、不能变更的信条。同“金科玉律”。","source":{"text":"各种各料虽互相差异，却又互相调和，这便正符那条艺术底金科玉臬‘变异中之一律’了。","book":"闻一多《女神之地方色彩》"},"similar":["金科玉律","金科玉条","玉律金科"],"usage":"作定语、宾语；指法律"},{"id":44903,"word":"金章玉句","pinyin":"jīn zhāng yù jù","abbr":"jzyj","explanation":"指华丽的诗文。","source":{"text":"先生半酣染霜免，金章玉句诗空万古。","book":"宋·杨万里《过白沙渡得长句呈澹庵先生》"},"usage":"作主语、宾语、定语；用于文章等"},{"id":44904,"word":"金章紫绶","pinyin":"jīn zhāng zǐ shòu","abbr":"jzzs","explanation":"紫色印绶和金印，古丞相所用。后用以代指高官显爵。","source":{"text":"贵人、夫人、贵嫔是为三夫人，皆金章紫绶。","book":"《晋书·舆服志》"},"example":{"text":"清·李百川《绿野仙踪》第65回：“两路朝房，端坐着～。”"},"similar":["金印紫绶"],"usage":"作宾语、定语；指高官显爵"},{"id":44905,"word":"金童玉女","pinyin":"jīn tóng yù nǚ","abbr":"jtyn","explanation":"道家指侍奉仙人的童男童女。后泛指天真无邪的男孩女孩。","source":{"text":"金童玉女意投机，才子佳人世罕稀。","book":"唐·徐彦伯《幸白鹿观应制》诗：“金童擎紫药，玉女献青莲。”元·李好古《张生煮海》第一折"},"example":{"text":"刚一到上海这“魔窟”，吴老太爷的“～”就变了！","book":"茅盾《子夜》一"},"similar":["才子佳人","玉女金童"],"usage":"作主语、宾语；指天真活泼的男女儿童"},{"id":44906,"word":"金篦刮目","pinyin":"jīn bì guā mù","abbr":"jbgm","explanation":"比喻翻然醒悟。","source":{"text":"然今及铁舰之未来功也，吾速以金篦刮目，槐柳取火，尤不容缓也。","book":"梁启超《读〈日本书目志〉书后》"},"example":{"text":"梁启超《读书后》：“然今及铁舰之未来攻也，吾速以～，槐柳取火，尤不容缓也。”"},"usage":"作宾语、定语；用于比喻句"},{"id":44907,"word":"金粉豪华","pinyin":"jīn fěn háo huá","abbr":"jfhh","explanation":"金粉：妇女化妆时用的铅粉；豪华：奢华阔绰。形容穷奢极侈的生活。"},{"id":44908,"word":"金精玉液","pinyin":"jīn jīng yù yè","abbr":"jjyy","explanation":"旧指一种仙药。也指珍贵的饮料。","source":{"text":"太上之药，有风实云子，金精玉液。","book":"《汉武帝外传》"},"similar":["金浆玉液"],"usage":"作宾语、定语；指珍贵的饮料"},{"id":44909,"word":"金紫银青","pinyin":"jīn zǐ yín qīng","abbr":"jzyq","explanation":"金紫：金印章，紫绶带。银青：银印章，青绶带。指高官配带的印绶。借指达官显贵。","source":{"text":"特进，左右光禄，金紫银青等光禄大夫，用人俱以旧德就闲者居之。","book":"《隋书·百官中》"}},{"id":44910,"word":"金翅擘海","pinyin":"jīn chì bāi hǎi","abbr":"jcbh","explanation":"金翅：佛经中所说鸟名；擘：用手把东西分开或折断。比喻文辞笔力雄壮。","source":{"text":"譬如金翅鸟王，飞行虚空，安住虚空，以清净眼观察大海龙王宫殿，奋勇猛力以左右翅搏开海水，悉令两辟，知龙男女有命尽者而撮取之。","book":"《大方广佛华严经》卷三十六"},"example":{"text":"李杜数公如～，香象渡河，下视郊岛辈，直蛩吟草间耳。","book":"宋·严羽《沧浪诗话·诗评》"},"usage":"作宾语；比喻诗文雄健有力，精深透彻"},{"id":44911,"word":"金舌弊口","pinyin":"jīn shé bì kǒu","abbr":"jsbk","explanation":"金舌：用金子做舌头；弊：破。用金做的舌头，说破了嘴。比喻说话很多，枉费口舌。","source":{"text":"金舌弊口，犹将无益也。","book":"《荀子·正论》"},"similar":["缄口不言"],"usage":"作宾语；比喻缄口不言"},{"id":44912,"word":"金舌蔽口","pinyin":"jīn shé bì kǒu","abbr":"jsbk","explanation":"比喻闭口不说话。","source":{"text":"金舌蔽口，犹将无益也。","book":"《荀子·正论》"}},{"id":44913,"word":"金蝉脱壳","pinyin":"jīn chán tuō qiào","abbr":"jctq","explanation":"蝉变为成虫时要脱去一层壳。比喻用计脱身，使人不能及时发觉。","source":{"text":"元·关汉卿《谢天香》第二折：”便使尽些伎俩，千愁断我肚肠，觅不的个金蝉脱壳这一个谎。”"},"example":{"text":"如今便赶着躲了，料也躲不及，少不得要使个“～”的法子。","book":"清·曹雪芹《红楼梦》第二十七回"},"similar":["缓兵之计","瞒天过海"],"opposite":["瓮中捉鳖"],"usage":"作谓语、宾语、定语；比喻用掩人耳目的手段"},{"id":44914,"word":"金衣公子","pinyin":"jīn yī gōng zǐ","abbr":"jygz","explanation":"黄鹂的别称，也叫黄莺。","source":{"text":"明皇每于禁苑中见黄莺，常呼之为金衣公子。","book":"五代·王仁裕《开元天宝遗事》上"},"example":{"text":"～绛桃花，飞下乔林过锦江。","book":"元·王恽《钱舜举桃花黄莺图》"}},{"id":44915,"word":"金装玉裹","pinyin":"jīn zhuāng yù guǒ","abbr":"jzyg","explanation":"形容贵重华丽的服饰或装潢。","source":{"text":"今日所见，却金装玉裹，打扮得与天仙相似。","book":"清·明教中人《好逑传》第十五回"},"example":{"text":"～梅边鹤，翠绕珠围柳浪莺。","book":"清·金埴《不下带编》"}},{"id":44916,"word":"金谷堕楼","pinyin":"jīn gǔ duò lóu","abbr":"jgdl","explanation":"金谷：园名，晋代石崇建，在今河南省洛阳市西北。晋朝石崇才貌双全的宠妓为表忠贞，被迫跳楼而死。比喻多才美貌女子的不幸遭遇。","source":{"text":"至竟息亡缘底事，可怜金谷堕楼人。","book":"《晋书·石崇传》：“崇有妓曰绿珠，美而艳，善吹笛。……绿珠泣曰：‘当效死于官前。’因自投于楼下而死。”唐·杜牧《题桃花夫人庙》"}},{"id":44917,"word":"金谷酒数","pinyin":"jīn gǔ jiǔ shù","abbr":"jgjs","explanation":"金谷：园名，晋代石崇建，在今河南省洛阳市西北。罚酒三斗的隐语。旧时泛指宴饮时罚酒的斗数。","source":{"text":"遂各赋诗，以叙中怀，或不能者，罚酒三斗。","book":"晋·石崇《金谷诗序》"},"example":{"text":"诸位是有能诗的，各自做来；如不能者，罚依～。","book":"清·陈忱《水浒后传》第四十回"},"usage":"作谓语、宾语；指宴饮时罚酒三杯的常例"},{"id":44918,"word":"金貂取酒","pinyin":"jīn diāo qǔ jiǔ","abbr":"jdqj","explanation":"取下金冠换美酒。形容不拘礼法，恣情纵酒。同“金貂换酒”。","source":{"text":"银字吹笙，金貂取酒。","book":"宋·毛滂《感皇恩·镇江待闸》词"},"similar":["金貂换酒"],"usage":"作宾语、定语；用于为人"},{"id":44919,"word":"金貂换酒","pinyin":"jīn diāo huàn jiǔ","abbr":"jdhj","explanation":"金貂：汉以后皇帝左右侍臣的冠饰。取下金冠换美酒。形容不拘礼法，恣情纵酒。","source":{"text":"迁黄门侍郎、散骑常侍。尝以金貂换酒，复为所司弹劾，帝宥之。","book":"《晋书·阮孚传》"},"example":{"text":"翠袖传觞，～，痛饮何妨三百杯。","book":"宋·刘过《沁园春》"},"similar":["金貂取酒"],"usage":"作宾语、定语；形容不拘礼法，恣情纵酒","story":["晋朝时期，“竹林七贤”的阮咸的儿子阮孚特别好酒，在做安东参军时，整天在军中饮酒作乐，醉眼朦胧，丝毫不把军务放在心上，皇帝派他去作车骑将军的长史，劝他少喝酒，他更是纵情狂饮，经常是烂醉如泥，有时甚至用他的金饰貂皮大衣去换酒喝"]},{"id":44920,"word":"金貂贳酒","pinyin":"jīn diāo shì jiǔ","abbr":"jdsj","explanation":"取下金冠换美酒。形容不拘礼法，恣情纵酒。同“金貂换酒”。","source":{"text":"金貂贳酒。乐事可为须趁手。","book":"宋·韦骧《减字木兰花·劝饮酒》词"},"similar":["金貂取酒","金貂换酒"],"usage":"作宾语、定语；用于为人"},{"id":44921,"word":"金辉玉洁","pinyin":"jīn huī yù jié","abbr":"jhyj","explanation":"形容文辞斑斓简洁。","source":{"text":"其法律森然，金辉玉洁，以自成为一家之言。","book":"清·刘大櫆《宋运夫时文序》"},"usage":"作谓语、定语；用于比喻句"},{"id":44922,"word":"金迷纸碎","pinyin":"jīn mí zhǐ suì","abbr":"jmzs","explanation":"形容剥削阶级奢侈豪华的生活。"},{"id":44923,"word":"金迷纸醉","pinyin":"jīn mí zhǐ zuì","abbr":"jmzz","explanation":"形容剥削阶级奢侈豪华的生活。","source":{"text":"有一小室，窗牖焕明，器皆金饰，光莹四射，金采夺目。所亲见之，归语人曰：‘此室暂憩，令人金迷纸醉。’","book":"宋·陶穀《清异录·金迷纸醉》"},"example":{"text":"～之中，同样的有无灯的人家，突不见烟的人家，遭受了灾荒的人家。","book":"阿英《“灯市”》"},"similar":["灯红酒绿","纸醉金迷"],"usage":"作宾语、定语；形容骄奢淫逸的生活","story":["唐朝末年，朝廷十分腐败，皇帝过着奢华的生活，给昭宗治病的御医孟斧经常出入皇宫，见识了皇宫的豪华。战乱时，孟斧流浪到四川居住，把他的屋子内所有家具都贴上金纸，人们说到他的房间休息就会金迷纸醉"]},{"id":44924,"word":"金鎞刮膜","pinyin":"jīn pī guā mó","abbr":"jbgm","explanation":"金鎞：传说古印度治眼病的形如箭头的金属工具。用金鎞刮去眼球表面的薄膜，使人复明。形容医术高超，能使他人失而复明。","source":{"text":"如盲目人为治目，造诣良医，良医即以金鎞扶其眼膜。","book":"《涅槃经》八"},"example":{"text":"～妙通灵，从此昏花不再生。闻道向来昏醉眼，而今黑白尽分明。","book":"宋·舒邦佐《挽黄助教四首》其一"}},{"id":44925,"word":"金鏣玉络","pinyin":"jīn biāo yù luò","abbr":"jsyl","explanation":"鏣：马嚼子；络：马笼头。金饰马嚼子和玉饰马笼头。指高官显贵人家的奢华坐骑。比喻高官显贵的优厚待遇。","source":{"text":"臣僻性野逸，志在长林丰草，金鏣玉络非所愿也。","book":"《金史·赵质传》"}},{"id":44926,"word":"金针度人","pinyin":"jīn zhēn dù rén","abbr":"jzdr","explanation":"金针：比喻秘法，诀窍；度：通“渡”，越过，引伸为传授。把高明的方法传授给别人。","source":{"text":"鸳鸯绣出从教看，莫把金针度与人。","book":"金·元好问《论诗》诗"},"example":{"text":"用笔之活可作～。","book":"鲁迅《集外集拾遗·怀旧》"},"similar":["诲人不倦"],"usage":"作谓语、宾语、定语；把高超的技艺传授给人","story":["唐朝时期，郑采娘从小聪明伶俐，心灵手巧，她的针线活、刺绣做得十分精巧。她七夕之夜设香案向织女祈祷，祈求做针线的绝活。当夜的梦中她见到织女送给她一枚金针，三天后可以得到绝技，然而她急不可待把到手的金针给弄飞了"]},{"id":44927,"word":"金针见血","pinyin":"jīn zhēn jiàn xuè","abbr":"jzjx","explanation":"犹言一针见血。比喻说话简短，切中要害。","source":{"text":"往岁尝遗余书曰：‘吾辈有一毫逃死之心，固害道；有一毫求死之心，亦害道。’此金针见血语。","book":"明·刘宗周《书高先生帖后》"},"similar":["一针见血"],"usage":"作谓语、定语；用于比喻句"},{"id":44928,"word":"金钉朱户","pinyin":"jīn dīng zhū hù","abbr":"jdzh","explanation":"红色大门上铆着金钉。指富贵人家。","source":{"text":"端个个金钉朱户，玉砌瑶阶。","book":"元·无名氏《抱妆盒》第二折"},"example":{"text":"仰观四面，萧墙粉壁，画栋雕梁，～，碧瓦重檐，四边帘卷虾须，正面横龟背。","book":"明·施耐庵《水浒全传》第八十八回"}},{"id":44929,"word":"金钗十二","pinyin":"jīn chāi shí èr","abbr":"jcse","explanation":"原形容妇女头上首饰多。后指人姬妾多。","source":{"text":"头上金钗十二行，足下丝履五文章。","book":"南朝·梁·武帝《河中之水歌》"},"example":{"text":"你看为官的列～行。","book":"元·郑德辉《王粲登楼》第一折"},"usage":"作宾语；指人妻妾多"},{"id":44930,"word":"金钗十二行","pinyin":"jīn chāi shí èr háng","abbr":"jcsex","explanation":"原形容妇女头上首饰多。后指人姬妾多。","source":{"text":"头上金钗十二行，足下丝履五文章。","book":"南朝·梁·萧衍《河中之水歌》"},"example":{"text":"你看为官的列～。","book":"元·郑德辉《王粲登楼》第一折"}},{"id":44931,"word":"金钗换酒","pinyin":"jīn chāi huàn jiǔ","abbr":"jchj","explanation":"形容贫穷潦倒，落魄失意。","source":{"text":"顾我无衣搜荩箧，泥他沽酒拔金钗。","book":"唐·元稹《三遣悲怀》诗之一"},"example":{"text":"归来紫陌东头，～消愁。","book":"宋·晏幾道《清平乐》词"},"usage":"作宾语、定语；形容贫穷潦倒，落魄失意"},{"id":44932,"word":"金钗细合","pinyin":"jīn chāi xì hé","abbr":"jcxh","explanation":"金钗和钿合。传说中唐玄宗与杨贵妃定情的信物。","source":{"text":"金钗和钿合。传说中唐玄宗与杨贵妃定情的信物。"},"example":{"text":"唐·陈鸿《长恨歌传》：“进见之日，奏《霓裳羽衣曲》以导之；定情之夕，授金钗钿合以固之。又命戴步摇，垂金璫。”"}},{"id":44933,"word":"金钗钿合","pinyin":"jīn chāi diàn hé","abbr":"jcdh","explanation":"金钗：妇女的首饰；钿合：装珠宝的盒子。传说中唐玄宗与杨贵妃的定情信物。指华美的首饰。","source":{"text":"进见之日，奏《霓裳羽衣曲》以导之；定情之夕，授金钗钿合以固之。","book":"唐·陈鸿《长恨歌传》"},"usage":"作宾语、定语；指首饰等"},{"id":44934,"word":"金铛大畹","pinyin":"jīn dāng dà wǎn","abbr":"jddw","explanation":"金铛：原为烃代侍中、中常侍帽子上的饰物，后借指高官；大畹：皇亲国戚居住的地方，借指显贵。比喻居高官，享厚禄的人。","source":{"text":"设或到得一花一果，必为金铛大畹所有，他人亦不易得。","book":"明·冯梦龙《醒世恒言》卷二十九"}},{"id":44935,"word":"金银财宝","pinyin":"jīn yín cái bǎo","abbr":"jycb","explanation":"钱财和珍宝。泛指钱财。","source":{"text":"且说那伙贼原是何三等邀的，偷抢了好些金银财宝接运出去，见人追赶，知道都是那些不中用的人。","book":"清·曹雪芹《红楼梦》第112回"},"example":{"text":"清·曹雪芹《红楼梦》第112回：“且说那伙贼原是何三等邀的，偷抢了好些～接运出去，见人追赶，知道都是那些不中用的人。”"},"usage":"作主语、宾语、定语；指财富"},{"id":44936,"word":"金铺屈曲","pinyin":"jīn pū qū qū","abbr":"jpqq","explanation":"金铺：大门上用来衔门环的金属底座，一般为兽形或龙蛇形；屈曲：盘绕。指大门上装饰华丽。比喻建筑物堂皇豪华。","source":{"text":"金铺屈曲，玉槛玲珑，映彻辉煌，心目俱夺。","book":"明·冯梦龙《醒世恒言》卷十三"}},{"id":44937,"word":"金锣腾空","pinyin":"jīn luó téng kōng","abbr":"jltk","explanation":"金锣：比喻太阳；腾：上升。比喻太阳高照。","source":{"text":"冬日云：金锣腾空，映檐白醉。","book":"陶糓《清异录·天文·润骨丹》"},"usage":"作宾语、定语；用于比喻句"},{"id":44938,"word":"金镳玉络","pinyin":"jīn biāo yù luò","abbr":"jbyl","explanation":"指施于马匹的华美御具。也比喻爵禄。同“金镳玉辔”。","source":{"text":"臣僻性野逸，志在长林丰草，金镳玉络非所愿也。","book":"《金史·隐逸传·赵质》"},"similar":["金镳玉辔"],"usage":"作宾语、定语；用于比喻句"},{"id":44939,"word":"金镳玉辔","pinyin":"jīn biāo yù pèi","abbr":"jbyp","explanation":"①指施于马匹的华美御具。②比喻爵禄。","source":{"text":"少年公子能乘驭，金镳玉辔珑璁。","book":"前蜀·毛文锡《接贤宾》词"},"similar":["金镳玉络"],"usage":"作宾语、定语；用于比喻句"},{"id":44940,"word":"金镶玉裹","pinyin":"jīn xiāng yù guǒ","abbr":"jxyg","explanation":"比喻荣华的生活。","source":{"text":"可又来，他自有雌雄一窠，受用着金镶玉裹，成就了富贵的姻缘，要穷人做什么。","book":"清·蒋士铨《空谷香·饮刃》"},"similar":["珠围翠绕"],"usage":"作宾语、定语；用于比喻句"},{"id":44941,"word":"金门绣户","pinyin":"jīn mén xiù hù","abbr":"jmxh","explanation":"指富贵人家。","source":{"text":"怨不得姑娘不认得，你们在这金门绣户里，那里认的木头。","book":"清·曹雪芹《红楼梦》第四十一回"},"similar":["朱门绣户"],"usage":"作主语、宾语、定语；用于书面语"},{"id":44942,"word":"金闺国士","pinyin":"jīn guī guó shì","abbr":"jggs","explanation":"指朝廷的杰出才士。","source":{"text":"勉求玉体长生诀，留报金闺国士知。","book":"清·龚自珍《已亥杂诗》之二六○"},"example":{"text":"～知多少，寂寞鱼龙江海秋。","book":"高旭《自题花前说剑图》诗"},"usage":"作主语、宾语；用于夸奖人"},{"id":44943,"word":"金闺玉堂","pinyin":"jīn guī yù táng","abbr":"jgyt","explanation":"指朝廷官宦。"},{"id":44944,"word":"金革之世","pinyin":"jīn gé zhī shì","abbr":"jgzs","explanation":"金革：兵器和铠甲；世：时代。战乱的年月。","source":{"text":"当今玉烛调和，既非金革之世。","book":"南朝·梁·庾信《为杞公让宗师骠骑表》"},"usage":"作宾语；指战争年代"},{"id":44945,"word":"金革之声","pinyin":"jīn gé zhī shēng","abbr":"jgzs","explanation":"金革：兵器和铠甲。兵器与铠甲相撞击的声音。指战争。","source":{"text":"四方无斗争金革之声。","book":"唐·韩愈《上巳日燕太学所弹琴诗序》"},"example":{"text":"一开始便是～，仿佛辕门传鼓，点将发兵，弦音轻快爽朗，是那种士饱马腾，跃跃欲试的光景。","book":"高阳《草莽英雄》第十章"},"usage":"作宾语；指战争"},{"id":44946,"word":"金革之患","pinyin":"jīn gé zhī huàn","abbr":"jgzh","explanation":"金革：兵器和铠甲；患：灾祸。指战乱。","source":{"text":"永亡边城之灾，金革之患。","book":"汉·扬雄《长杨赋》"},"similar":["金革之难"],"usage":"作宾语；指战争"},{"id":44947,"word":"金革之难","pinyin":"jīn gé zhī nàn","abbr":"jgzn","explanation":"金革：兵器和铠甲；难：灾难。指战乱。","source":{"text":"光武皇帝躬服金革之难，深昭天地之明。","book":"汉·扬雄《长杨赋》：“永亡边城之灾，金革之患。”《后汉书·宋意传》"},"example":{"text":"内外官非文武全才、出处系天下安危、能拯～者，勿许夺情起复。","book":"《元史·文宗五》"},"similar":["金革之患"],"usage":"作宾语；指战争"},{"id":44948,"word":"金题玉躞","pinyin":"jīn tí yù xiè","abbr":"jtyx","explanation":"金题：用泥金书写的题签；玉躞：系缚书卷的玉别子（又称“插签”）。指极精美的书画或书籍的装璜。","source":{"text":"二王缣素珊瑚二帙二十四卷，纸书金轴二帙二十四卷，又纸书玳瑁轴五帙五十卷，皆互轶，金题玉躞，织成带。","book":"唐·张彦远《法书要录》卷二"},"example":{"text":"天下之尤物，岂尽出于～中耶？（宋·王柏《鲁斋集》卷六）"},"usage":"作宾语、定语；用于书籍等"},{"id":44949,"word":"金风未动蝉先觉","pinyin":"jīn fēng wèi dòng chán xiān jué","abbr":"jfwdcxj","explanation":"金风：指秋风，古代以阴阳五行来解释季节，秋为金；觉：察觉。秋风还未来到，蝉却早已察觉。比喻事先觉察到将要发生的变故。","source":{"text":"可知道金风未动蝉先觉，那宝剑得来你怎消？","book":"元·尚仲贤《三夺槊》第二折"},"example":{"text":"～，暗送无常死不知。","book":"明·洪楩《清平山堂话本·曹伯明错勘赃记》"},"usage":"作宾语、定语；用于比喻句"},{"id":44950,"word":"金风玉露","pinyin":"jīn fēng yù lù","abbr":"jfyl","explanation":"泛指秋天的景物。","source":{"text":"由来碧落银河畔，可要金风玉露时。","book":"唐·李商隐《辛未七夕》诗"},"example":{"text":"清漏频移，微云欲湿，正是～。","book":"清·纳兰性德《齐天乐·塞外七夕》词"},"usage":"作宾语、定语；借指秋天"},{"id":44951,"word":"金风送爽","pinyin":"jīn fēng sòng shuǎng","abbr":"jfss","explanation":"金风：指秋天的风。古时以阴阳五行解释季节，秋为金。秋风带来了凉意。","source":{"text":"金风送爽，凉露惊秋。","book":"鲁迅《述香港恭祝圣诞》"},"usage":"作谓语、定语；指秋风带来了凉意"},{"id":44952,"word":"金飞玉走","pinyin":"jīn fēi yù zǒu","abbr":"jfyz","explanation":"金：金乌，指太阳；玉：玉兔，指月亮。日月如飞。比喻时光容易流逝。","source":{"text":"玉走金飞两曜忙，始闻花发又秋霜。","book":"唐·吕岩《寄白龙洞刘道人》"},"example":{"text":"若不见，～去如梭，人间乐地莫虚过。","book":"清·吴翼《丹湖泛月吊李白》"}},{"id":44953,"word":"金马玉堂","pinyin":"jīn mǎ yù táng","abbr":"jmyt","explanation":"金马：汉代的金马门，是学士待诏的地方；玉堂：玉堂殿，供侍诏学士议事的地方。旧指翰林院或翰林学士。","source":{"text":"今吾子幸得遭明盛之世，处不讳之朝，与群贤同行，历金门上玉堂有日矣，曾不能画一奇，出一策，上说人主，下谈公卿。","book":"汉·扬雄《解嘲》"},"example":{"text":"～三学士，清风明月两闲人。","book":"宋·欧阳修《会老堂致语》"},"similar":["达官显宦"],"usage":"作宾语、定语；指达官显宦的代称"},{"id":44954,"word":"金马碧鸡","pinyin":"jīn mǎ bì jī","abbr":"jmbj","explanation":"传说中的两个神仙，形状象马的金块和形状象鸡的碧玉。今云南昆明市有金马山，西有碧鸡山，相传就是汉代祭金马碧鸡的地方。","source":{"text":"西有盐泉铁冶，橘林铜陵，其傍则有期牛光旄，金马碧鸡。","book":"汉·扬雄《蜀都赋》"},"example":{"text":"自是以后，禁旅可班，军屯可复，～可致。","book":"清·汪琬《代寿洪太傅七十序》"},"usage":"作主语、宾语；用于比喻句"},{"id":44955,"word":"金鳷擘海","pinyin":"jīn zhī bò hǎi","abbr":"jzbh","explanation":"比喻诗文雄健有力，精深透彻。"},{"id":44956,"word":"金鴗擘海","pinyin":"jīn zhī bò hǎi","abbr":"jzbh","explanation":"比喻诗文雄健有力，精深透彻。"},{"id":44957,"word":"金鸡放赦","pinyin":"jīn jī fàng shè","abbr":"jjfs","explanation":"金鸡：古代大赦时，立一长杆，杆头设一黄金冠首的金鸡，口衔绛幡，然后如今罪犯，击鼓，宣布赦令。指朝廷大赦。","source":{"text":"我愁远谪夜郎去，何日金鸡放赦回。","book":"唐·李白《流夜郎赠辛判官》诗"},"example":{"text":"只因造下迷天罪，何日～回？","book":"明·施耐庵《水浒全传》第二十回"}},{"id":44958,"word":"金鸡消息","pinyin":"jīn jī xiāo xī","abbr":"jjxx","explanation":"金鸡：古时大赦时，所举行的一种仪式，即竖长杆，顶立金鸡，然后集中罪犯，击鼓，宣读赦令。指皇帝下赦令招安的消息。","source":{"text":"赦日，树金鸡于仗南，竿长七丈，有鸡高四尺，黄金饰首，衔绛幡长七尺，承以彩盘，维以绛绳。","book":"《新唐书·百官志三》"},"example":{"text":"六六雁行连八九，只等～。","book":"明·施耐庵《水浒全传》第七十二回"},"usage":"作主语、宾语；指皇帝下赦令招安的消息"},{"id":44959,"word":"金鸡独立","pinyin":"jīn jī dú lì","abbr":"jjdl","explanation":"指独腿站立的一种武术姿势。后也指用一足站立。","source":{"text":"我是‘金鸡独立’，要一足微长。","book":"清·李汝珍《镜花缘》第七十四回"},"example":{"text":"你站在这桌子上，～，那一条腿不许放下来。","book":"茅盾《子夜》十七"},"similar":["鹤立鸡群"],"opposite":["平淡无奇"],"usage":"作谓语、定语、状语；指用一足站立"},{"id":44960,"word":"金鼓喧天","pinyin":"jīn gǔ xuān tiān","abbr":"jgxt","explanation":"金鼓：古时作战，用金钟和战鼓指挥士兵，击鼓表示前进，鸣金表示后退。形容军威盛大或战斗激烈。","source":{"text":"公子偃命军中举火，一时金鼓喧天，直前冲突。","book":"明·冯梦龙《东周列国志》第17回"},"similar":["金鼓连天"],"usage":"作谓语、定语、分句；形容战斗激烈"},{"id":44961,"word":"金鼓喧阗","pinyin":"jīn gǔ xuān tián","abbr":"jgxt","explanation":"金鼓：金钲和鼓。喧阗：声音大。形容音乐演奏的声音嘈杂热闹。亦形容军威壮盛或战况激烈","source":{"text":"忽金鼓喧阗，仪卫甚盛，观者踵接肩摩。","book":"清·金捧阊《守一斋笔记·芦花会》"},"example":{"text":"游人往来如织，～，笙歌鼎沸，通宵达旦，金吾不禁。","book":"清·褚人获《隋唐演义》第七十六回"}},{"id":44962,"word":"金鼓连天","pinyin":"jīn gǔ lián tiān","abbr":"jglt","explanation":"金鼓：古时作战，用金钲和战鼓指挥士兵，击鼓表示前进，鸣金表示后退；连天：响彻云霄。形容军威盛大或战斗激烈。","source":{"text":"耳边厢金鼓连天震，征云冉冉，土雨纷纷。","book":"元·王实甫《西厢记》第二本第一折"},"example":{"text":"～，喊声震地，不是赤眉啸聚，定为碧眼横行，待我出门一看，便知端的。","book":"明·陈汝元《金莲记·焚券》"},"similar":["金鼓喧天"],"usage":"作谓语、分句；形容战斗激烈"},{"id":44963,"word":"金鼓齐鸣","pinyin":"jīn gǔ qí míng","abbr":"jgqm","explanation":"金鼓：指金钲和战鼓。金钲战鼓一齐响起。形容战斗气氛紧张激烈。","source":{"text":"有金鼓，所以一耳。","book":"《吕氏春秋·不二》"},"example":{"text":"走不到百十步，只见四下里～，喊声枕地，一路都是火把。","book":"明·施耐庵《水浒全传》第六十回"},"similar":["刀光剑影","金鼓连天"],"opposite":["偃旗息鼓"],"usage":"作谓语、宾语；形容战斗气氛紧张激烈","story":["古代军队行军作战都离不开“金”与“鼓”，命令军队行动与进攻就打鼓，即鸣鼓而攻，而命令军队停止或退回就击钲，即鸣金收兵。这种击鼓而攻、鸣金收兵的做法在各个朝代基本上是通行的，到了明朝时，有时也会金鼓齐鸣"]},{"id":44964,"word":"金齑玉鲙","pinyin":"jīn jī yù kuài","abbr":"jjyk","explanation":"古代吴郡制作的一种美味食品，用细切的鲜鲈鱼和菰菜拦以调料晒制而成，鲈鱼鲜白如玉，菰菜嫩黄如金，因而得名。泛指美味佳肴。","source":{"text":"所谓金齑玉鲙，东南之佳味也。","book":"唐·颜师古《大业拾遗记》"},"example":{"text":"闲觅钓师罟友，共饱～，乐事总无穷。","book":"清·黄景仁《水调歌头·题王兰泉先生〈三柳鱼庄图〉》"}},{"id":44965,"word":"金龟换酒","pinyin":"jīn guī huàn jiǔ","abbr":"jghj","explanation":"金龟：袋名，唐代官员的一种佩饰。解下金龟换美酒。形容为人豁达，恣情纵酒。","source":{"text":"太子宾客贺公，于长安紫极宫一见余，呼余为‘谪仙人’，因解金龟，换酒为乐。","book":"唐·李白《对酒忆贺监诗序》"},"example":{"text":"最好～，相与醉沧州。","book":"宋·秦观《望海潮》词"},"similar":["金貂换酒"],"usage":"作宾语、定语；指为人豁达","story":["唐朝秘书监贺知章听说20多岁的李白到长安，不顾自己年纪大及地位高，亲自去旅店拜访李白。李白送上诗作《蜀道难》，贺知章看后十分佩服，就请李白去酒楼吃饭，由于忘带银子，就把皇帝所赐的金龟佩饰送给酒店换酒来招待李白"]},{"id":44966,"word":"釜中之鱼","pinyin":"fǔ zhōng zhī yú","abbr":"fzzy","explanation":"在锅里游着的鱼。比喻不能久活。","source":{"text":"彼小国负险自守，釜中之鱼，非久自死。","book":"《元史·王荣祖传》"},"example":{"text":"杨八老和一群百姓们，都被倭奴擒了，好似瓮中之鳖，～。","book":"明·冯梦龙《古今小说》"},"similar":["釜中鱼","风中之烛"],"usage":"作主语、宾语；比喻处在绝境中的人"},{"id":44967,"word":"釜中游鱼","pinyin":"fǔ zhōng yóu yú","abbr":"fzyy","explanation":"在锅里游着的鱼。比喻处在绝境中的人。也比喻即将灭亡的事物。","source":{"text":"在锅里游着的鱼。比喻处在绝境中的人。也比喻即将灭亡的事物。"},"example":{"text":"他的境遇就如同～。"},"similar":["釜中之鱼"],"usage":"作宾语、定语；指即将灭亡的事物","story":["东汉顺帝时期，张婴聚众杀了残暴的广陵太守，转战于扬州、徐州一带，朝廷对他无可奈何。大将军梁冀任命张纲为广陵太守，张纲改用抚慰的手段，张婴主动带领义军投降说：不堪忍受前太守的压榨才起义的，这样做如鱼游釜中不能长久"]},{"id":44968,"word":"釜中生尘","pinyin":"fǔ zhōng shēng chén","abbr":"fzsc","explanation":"犹釜中生鱼。","source":{"text":"颜渊箪食瓢饮……范史云釜中生尘。","book":"明·王世贞《艺苑卮言》卷八"},"similar":["釜中生鱼","釜鱼甑尘"],"usage":"作谓语、定语；用于生活清苦"},{"id":44969,"word":"釜中生鱼","pinyin":"fǔ zhōng shēng yú","abbr":"fzsy","explanation":"比喻生活困难，断炊已久。","source":{"text":"门堪罗雀仍未害，釜欲生鱼当奈何。","book":"金·元好问《寄西溪相禅师》诗"},"example":{"text":"明·程登吉《幼学琼林》第三卷：“范丹～破甑生尘；曾子捉襟见肘纳履决踵。”"},"similar":["釜生鱼","釜中鱼"],"usage":"作谓语、定语；比喻生活困难，断炊已久","story":["汉朝时期，范冉遭到阉党的禁锢，只好弃官推鹿车载着妻子进行云游，经常是走到哪里无钱住店就在树荫下休息。十多年后终于自己盖了一间茅草屋，经常是断粮，靠吃野菜为生。同乡人嘲笑他说：“甑中生尘范史云，釜中生鱼范莱芜。”"]},{"id":44970,"word":"釜中鱼","pinyin":"fǔ zhōng yú","abbr":"fzy","explanation":"釜：锅，古代炊具。釜中已生出鱼来。比喻生活困难，断炊已久。","source":{"text":"机尽独亲沙上鸟，家贫唯向釜中鱼。","book":"唐·韩翃《寄雍丘窦明府》"},"example":{"text":"明·郭勋《英烈传》第28回：“不然粮草一日不支，是为～矣。”"},"similar":["釜中生鱼","釜生鱼"],"usage":"作宾语、定语；比喻生活困难，断炊已久"},{"id":44971,"word":"釜底抽薪","pinyin":"fǔ dǐ chōu xīn","abbr":"fdcx","explanation":"釜：古代的一种锅；薪：柴。把柴火从锅底抽掉。比喻从根本上解决问题。","source":{"text":"臣闻扬汤止沸，莫若去薪。","book":"汉·董卓《上何进书》"},"example":{"text":"如今有个道理，是“～”之法，只消央人去把告状的安抚住了，众人递个拦词便歇了。","book":"清·吴敬梓《儒林外史》第五回"},"similar":["抽薪止沸"],"opposite":["火上浇油","沸汤沸止"],"usage":"作谓语、定语、状语；比喻做事非常彻底","story":["北朝东魏大将侯景起兵反叛朝廷被打败，就跑到南朝梁武帝萧衍那里求救，萧衍发兵给他，他进攻东魏失败。东魏魏收给萧衍写了《为侯景判移梁朝文》，劝萧衍对侯景这种人只能“抽薪止沸，剪草除根。”萧衍不听，侯景后来又背叛梁朝"]},{"id":44972,"word":"釜底游魂","pinyin":"fǔ dǐ yóu hún","abbr":"fdyh","explanation":"比喻行将灭亡、苟延残喘的人。游魂，游荡的鬼魂。","source":{"text":"鼯是已穷之技，豕无可突之围，釜底游魂，苟延旦夕。","book":"《花月痕》第四回"},"example":{"text":"一百年来卖国罪魁的黑暗精神，集中表现在这一群败类身上，～，必随抗日战争的胜利，而消灭的无踪影。","book":"范文澜《紧张黑暗的一百年和伟大光明的一百年》"},"usage":"作宾语、定语；用于比喻句"},{"id":44973,"word":"釜底游鱼","pinyin":"fǔ dǐ yóu yú","abbr":"fdyy","explanation":"在锅里游着的鱼。比喻处在绝境的人。也比喻即将灭亡的事物。","source":{"text":"若鱼游釜中，喘息须臾间耳。","book":"《后汉书·张纲传》"},"example":{"text":"他们已是飞走路绝，恰似～，或降或死，别无他途。","book":"姚雪垠《李自成》第一卷第十一章"},"similar":["鱼游沸鼎","鱼游釜中","瓮中之鳖"],"opposite":["化险为夷"],"usage":"作宾语、定语；指危险境地","story":["东汉著名的清官张刚遭到外戚大将军梁冀的陷害，被派去强盗横行的广陵地区做广陵太守，想借刀杀人。张刚只好走马上任，到达广陵，第一件事就去义军张婴的营帐劝降谈判，张婴敬畏张刚的为人，说出自己釜底游鱼的滋味就归顺朝廷"]},{"id":44974,"word":"釜生鱼","pinyin":"fǔ shēng yú","abbr":"fsy","explanation":"釜：锅，古代炊具。釜中已生出鱼来。比喻生活困难，断炊已久。","source":{"text":"门堪罗雀仍未害，釜欲生鱼当奈何！","book":"金·元好问《寄西溪相禅师》"},"similar":["釜中生鱼","釜中鱼"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":44975,"word":"釜鱼幕燕","pinyin":"fǔ yú mù yàn","abbr":"fymy","explanation":"生活在锅里的鱼、筑巢在帷幕上的燕。比喻处境极不完全。","source":{"text":"今将军鱼游於沸鼎之中，燕巢於飞幕之上，不亦惑乎？","book":"语出南朝·梁·丘迟《与陈伯之书》"},"example":{"text":"霎时间，衰草斜阳。只是～，更有何人能居安思危呢？","book":"清·王蕴章《碧血花·洒愤》"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":44976,"word":"釜鱼甑尘","pinyin":"fǔ yú zèng chén","abbr":"fyzc","explanation":"釜中生鱼，甑中生尘，比喻生活清贫。","source":{"text":"一旦以辎重被讦于监司，夫以巡方而黩货，又何问下吏之操守，釜鱼甑尘之风，空谷于天下矣。","book":"清·黄宗羲《子刘子行状》"},"similar":["釜中生尘","釜中生鱼"],"usage":"作宾语、定语；用于生活"},{"id":44977,"word":"鉥心刳形","pinyin":"shù xīn kū xíng","abbr":"sxkx","explanation":"犹言呕心沥血。比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。同“鉥心刿目”。","source":{"text":"世之言功利者，恝恝然以自鉥心刳形。","book":"元·虞集《送薛玄卿序》"},"similar":["鉥心刿肾","鉥肝刿肾","鉥心刿目"],"usage":"作谓语、定语、状语；多用于比喻句"},{"id":44978,"word":"鉥心刿目","pinyin":"tóng xīn guì mù","abbr":"sxgm","explanation":"犹言呕心沥血。比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。"},{"id":44979,"word":"鉥心刿肾","pinyin":"shù xīn guì shèn","abbr":"sxgs","explanation":"比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。同“鉥心刿目”。","source":{"text":"若拈华摘艳，鉥心刿肾于辞章间，陋之陋者也。","book":"明·宋濂《故天台朱府君霞坞阡表》"},"similar":["鉥心刿目","鉥肝刿肾","鉥心刳形"],"usage":"作谓语、定语、状语；多用于比喻句"},{"id":44980,"word":"鉥肝刿肾","pinyin":"shù gān guì shèn","abbr":"sggs","explanation":"比喻用尽心思。多形容为事业、工作、文艺创作等用心的艰苦。同“鉥心刿目”。","source":{"text":"眭多诗人……世号为眭州诗派，方舟悉取而讽咏之，鉥肝刿肾，期超迈之乃已。","book":"明·宋濂《徐永舟墓铭》"},"similar":["鉥心刿目","呕心沥血","鉥心刿肾"],"usage":"作谓语、定语、状语；多用于比喻句"},{"id":44981,"word":"鉴前毖后","pinyin":"jiàn qián bì hòu","abbr":"jqbh","explanation":"指把过去的错误引为借鉴，以后谨慎行事，避免重犯。","source":{"text":"鉴前毖后，通三省而筹之，为曲突徙薪之计，建久安长治之谋。","book":"清·严如熤《三省边防备览·艺文·老林说》"},"usage":"作谓语、定语；用于处事"},{"id":44982,"word":"鉴影度形","pinyin":"jiàn yǐng duó xíng","abbr":"jydx","explanation":"观察揣度人的形迹。","source":{"text":"这三人将篮子内物件，一齐摆出仔细瞧看，或者寸纸，或者只字，鉴影度形，一概俱无，又仍一件一件装入篮内。","book":"清·李绿园《歧路灯》第一○二回"},"usage":"作谓语、宾语；指观察揣度人的形迹"},{"id":44983,"word":"鉴往知来","pinyin":"jiàn wǎng zhī lái","abbr":"jwzl","explanation":"鉴：审察或引为教训；往：过去；来：未来。根据以往的情形便知道以后怎样发生变化。","source":{"text":"殷鉴不远，在夏后之世。","book":"《诗经·大雅·荡》"},"example":{"text":"“～”，历史和科学已经给我们提出了铁证。","book":"秦牧《原始公社的影子》"},"similar":["高瞻远瞩","数往知来"],"opposite":["目光短浅","鼠目寸光"],"usage":"作定语、宾语、分句；审察过去可推断未来"},{"id":44984,"word":"鉴机识变","pinyin":"jiàn jī shí biàn","abbr":"jjsb","explanation":"察看时机，了解动向。","source":{"text":"燕朝无纲纪，实可图之，鉴机识变，唯皇甫真耳。","book":"《晋书·皇甫真载记》"},"usage":"作谓语、宾语；指随时掌握动向"},{"id":44985,"word":"鉴毛辨色","pinyin":"jiàn máo biàn sè","abbr":"jmbs","explanation":"根据对方的脸色、表情行事。同“鉴貌辨色”。","source":{"text":"把俺做新人嘴脸儿一寸寸鉴毛辨色，将俺那宝妆奁一件件都寓目囊箱。","book":"明·汤显祖《还魂记·道觋》"},"similar":["鉴貌辨色"],"usage":"作谓语、宾语；指善于观察别人"},{"id":44986,"word":"鉴空衡平","pinyin":"jiàn kōng héng píng","abbr":"jkhp","explanation":"犹言明察持平。","source":{"text":"今司文柄，鉴空衡平，不受一毫请托。","book":"清·杨潮观《开金榜朱衣点头》"},"usage":"作谓语、定语；用于处事"},{"id":44987,"word":"鉴貌辨色","pinyin":"jiàn mào biàn sè","abbr":"jmbs","explanation":"鉴：查看；色：指脸色。根据对方的脸色、表情行事。","source":{"text":"僧曰：‘争知某甲不肯？’师曰：‘鉴貌辨色。’","book":"南朝·梁·周兴嗣《千字文》：“聆音察理，鉴貌辨色。”宋·释道原《景德传灯录》卷二十二"},"example":{"text":"朱世远终是男子之辈，～，已知女儿的心事。","book":"明·冯梦龙《醒世恒言》卷九"},"similar":["鉴毛辨色","监貌辨色","见貌辨色"],"usage":"作谓语、宾语；指善于观察别人"},{"id":44988,"word":"针头削铁","pinyin":"zhēn tóu xuē tiě","abbr":"ztxt","explanation":"形容极力刮削搜刮。","source":{"text":"形容刮皮刻薄之至。为旧时俗语，明代已有之。《一笑散·夺泥燕口》：‘夺泥燕口，削铁针头，刮金佛面细搜求，无中觅有。’","book":"清·杨潮观《穷阮籍醉骂财神》：“若不是针头削铁将身惫，只怕你刀头餂蜜将人害。”胡士莹校注"},"usage":"作宾语、定语；用于比喻句"},{"id":44989,"word":"针头线尾","pinyin":"zhēn tóu xiàn wěi","abbr":"ztxw","explanation":"缝纫用的针线等物。","source":{"text":"要生存，必须努力开垦，举凡‘家头窑尾、灶头锅尾、针头线尾。田头地尾’的各种劳作，客家妇女无不参与，而且与客家男人一起辖内制川、同甘共苦。","book":"夏萍《曾宪梓传》第一部分"}},{"id":44990,"word":"针头线脑","pinyin":"zhēn tóu xiàn nǎo","abbr":"ztxn","explanation":"缝纫用的针线等物。比喻细微的事物。","source":{"text":"只有晁夫人是个不肯忘旧、念人好处的人，凡是便人回家，不是二两，就是一两，再少也是五钱，分外还有布匹鞋面、针头线脑之类。","book":"清·西周生《醒世姻缘传》第九十二回"},"example":{"text":"你家里有什么东西也得登记上，是个～也得算上。","book":"孙犁《白洋淀纪事·村歌下篇》"},"usage":"作主语、宾语、定语；指细小的东西"},{"id":44991,"word":"针尖对麦芒","pinyin":"zhēn jiān duì mài máng","abbr":"zjdmm","explanation":"比喻双方都很利害，互不相让。","source":{"text":"黄龙衮你这小子真叫会算账！怎奈呀针尖对麦芒，全三爷子不会上你的当。","book":"老舍《荷珠配》第一场"},"example":{"text":"他们的斗争就像～一样。"},"similar":["针锋相对"],"usage":"作宾语、定语；指互不相让"},{"id":44992,"word":"针插不进，水泼不进","pinyin":"zhēn chā bù jìn，shuǐ pō bù jìn","abbr":"zcbjspbj","explanation":"比喻一个集团非常排外，不容易打进去，也比喻一个人坚持已见，不听别人的任何意见。","example":{"text":"我们这儿是～的独立王国。"},"usage":"作定语、分句；指十分牢固"},{"id":44993,"word":"针芥之合","pinyin":"zhēn jiè zhī hé","abbr":"zjzh","explanation":"磁石引针，琥珀拾芥。指相互投契。","source":{"text":"近前一语忽大笑，针芥之合良非轻。","book":"清·方文《赠孟六玕明序》诗"},"similar":["针芥相投","针芥之契","针芥之投"],"usage":"作宾语；用于书面语"},{"id":44994,"word":"针芥之契","pinyin":"zhēn jiè zhī qì","abbr":"zjzq","explanation":"磁石引针，琥珀拾芥，因以之指相投契。同“针芥相投”。","source":{"text":"行可以余于武仲先生夙有针芥之契，属为题记。","book":"杨树达《积微居小学述林·跋刘武仲鲁田兄弟手书诗卷》"},"similar":["针芥之合","针芥之投","针芥相投"],"usage":"作宾语；用于书面语"},{"id":44995,"word":"针芥之投","pinyin":"zhēn jiè zhī tóu","abbr":"zjzt","explanation":"磁石引针，琥珀拾芥，因以之相投契。同“针芥相投”。","source":{"text":"每探赜析微，穷极理性，罔间晨夕，自谓针芥之投，庶儿终始也。","book":"清·陈梦雷《绝交书》"},"similar":["针芥之契","针芥之合","针芥相投"],"usage":"作宾语；用于书面语"},{"id":44996,"word":"针芥相投","pinyin":"zhēn jiè xiāng tóu","abbr":"zjxt","explanation":"磁石引针，琥珀拾芥。指相互投契。","source":{"text":"虎魄不取腐芥，磁石不受曲针。","book":"《三国志·吴志·虞翻传》“虞翻字仲翔，会稽余姚人也”裴松之注引三国吴韦昭《吴书》"},"example":{"text":"其机锋作用真可与侄女～，只怕这样人一时也寻不出来。","book":"明·明教中人《好逑传》第八回"},"similar":["针芥之合","针芥之契","针芥之投"],"usage":"作谓语、定语；用于书面语"},{"id":44997,"word":"针针丛棘","pinyin":"zhēn zhēn cóng jí","abbr":"zzcj","explanation":"针针：形容荆棘的刺尖锐如针。在带着像针一样尖刺的一丛丛的荆棘下面，形容环境恶劣。","source":{"text":"后小山下，怪石乱卧，针针丛棘，青麻头伏焉。","book":"清·蒲松龄《聊斋志异·促织》"},"similar":["荆棘丛生"],"usage":"作宾语、定语；指环境恶劣"},{"id":44998,"word":"针锋相对","pinyin":"zhēn fēng xiāng duì","abbr":"zfxd","explanation":"针锋：针尖。针尖对针尖。比喻双方在策略、论点及行动方式等方面尖锐对立。","source":{"text":"夫一切回答，如针锋相投，无纤毫参差。","book":"宋·释道原《景德传灯录》卷二"},"example":{"text":"彩云听着唐卿的话来得厉害，句句和自己的话～，思忖只有答应了再说。","book":"清·曾朴《孽海花》第二十六回"},"similar":["针锋相投"],"opposite":["逆来顺受"],"usage":"作谓语、定语、状语；用于辩论"},{"id":44999,"word":"钉嘴铁舌","pinyin":"dīng zuǐ tiě shé","abbr":"dzts","explanation":"形容嘴硬，不认错，不服输。","source":{"text":"法座下有甚么不能了达。钉嘴铁舌，铜头铁额，火眼金睛，都来问禅。","book":"元·李寿卿《度柳翠》第四折"},"example":{"text":"原来你家没大了，说着你，还～儿的。","book":"明·兰陵笑笑生《金瓶梅词话》第30回"},"similar":["不烂之舌","铁嘴钢牙"],"usage":"作宾语、定语；形容嘴硬，不服输"},{"id":45000,"word":"钉头磷磷","pinyin":"dīng tóu lín lín","abbr":"dtll","explanation":"建筑物上一颗颗的钉头光彩耀眼。","source":{"text":"钉头磷磷。","book":"唐·杜牧《阿房宫赋》"},"usage":"作谓语、定语；用于建筑"}]
