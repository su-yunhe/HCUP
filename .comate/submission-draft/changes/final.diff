+[{"id":27501,"word":"死也瞑目","pinyin":"sǐ yě míng mù","abbr":"symm","explanation":"瞑目：闭上眼睛。指死后无所牵挂。","source":{"text":"泰山可怜见林冲，依允人，便死也瞑目！","book":"明·施耐庵《水浒全传》第七回"},"example":{"text":"要是那一次多有一千精兵前去，截断敌人救兵，活捉老憨这个鞑子，～。","book":"姚雪垠《李自成》第三卷第二十六章"},"similar":["死亦瞑目"],"opposite":["死不瞑目"],"usage":"作谓语、定语；用于处事"},{"id":27502,"word":"死了张屠夫，不吃混毛猪","pinyin":"sǐ le zhāng tú fū，bù chī hùn máo zhū","abbr":"slztfbchmz","explanation":"俗语。比喻少了某人或某种条件，照样能办好事情。"},{"id":27503,"word":"死于非命","pinyin":"sǐ yú fēi mìng","abbr":"syfm","explanation":"非命：横死。在意外的灾祸中死亡。","source":{"text":"桎梏死者，非正命也。","book":"《孟子·尽心上》"},"example":{"text":"我三个若舍不得性命相帮他时，残酒为誓，教我们都遭横事，恶病临身，～。","book":"明·施耐庵《水浒全传》第十五回"},"similar":["飞来横祸"],"opposite":["寿终正寝"],"usage":"作谓语；指在意外的灾祸中死亡","story":["战国时期，孟子的学生对人的吉凶祸福不可理解，为什么行善洁身的人会突然死去。孟子回答：人世间的吉凶祸福是听天由命的，人必须承受天的正当的吉凶祸福。有人虽然潜心修身却死于非命，这也是正常的现象"]},{"id":27504,"word":"死亡无日","pinyin":"sǐ wáng wú rì","abbr":"swwr","explanation":"无日：没有多少日子。死期将近。","source":{"text":"政无礼则不行，王事无礼则不成，国无礼则不宁，王无礼则死亡无日矣。","book":"汉·韩婴《韩诗外传》卷一"},"example":{"text":"臣～，恐不得再见君父。","book":"清·毕沅《续资治通鉴》卷一百八十"},"similar":["死期将至"],"usage":"作谓语；用于口语"},{"id":27505,"word":"死亡枕藉","pinyin":"sǐ wáng zhěn jiè","abbr":"swzj","explanation":"枕藉：纵横相枕而卧。形容死的很多。","source":{"text":"值西晋之末，中原乱离，饥馑既臻，疫疠乃作，时有毒瘴，殒毙者多，闾里凋荒，死亡枕藉。","book":"宋·李昉《太平广记》卷十五"},"example":{"text":"那时前后都有枪弹，人多门狭，前面的枪又极近，～！","book":"朱自清《执政府大屠杀记》"},"similar":["死相枕藉"],"usage":"作谓语、定语；用于书面语"},{"id":27506,"word":"死亦瞑目","pinyin":"sǐ yì míng mù","abbr":"symm","explanation":"死而闭眼。指死后无所牵挂。","source":{"text":"是即吾家之佳子弟，老夫死亦瞑目矣。","book":"清·袁枚《与香亭书》"},"similar":["死也瞑目"],"opposite":["死不瞑目"],"usage":"作谓语、定语；用于处事"},{"id":27507,"word":"死伤枕藉","pinyin":"sǐ shāng zhěn jiè","abbr":"sszj","explanation":"枕藉：纵横相枕而卧。形容死亡的人非常多。","source":{"text":"李恒的船，本来乘着北风，满拽帆篷而来，到此收篷不及，被守义一阵弩箭，射得众鞑子死伤枕藉。","book":"清·吴趼人《痛史》第18回"},"similar":["死亡枕藉","死相枕藉"],"usage":"作谓语、定语；用于书面语"},{"id":27508,"word":"死伤相枕","pinyin":"sǐ shāng xiāng zhěn","abbr":"ssxz","explanation":"死亡受伤者相互枕藉而卧。形容伤亡者多。","source":{"text":"冻馁交侵，死伤相枕。","book":"唐·陆贽《请不置琼林大盈二库状》"},"example":{"text":"这场战争结束后，战场上～，惨不忍睹。"},"similar":["死伤相藉"],"usage":"作谓语、定语；形容伤亡者多"},{"id":27509,"word":"死伤相藉","pinyin":"sǐ shāng xiāng jiè","abbr":"ssxj","explanation":"死亡受伤者相互枕藉而卧。形容伤亡者多。同“死伤相枕”。","source":{"text":"以致师出连年，死伤相藉，系累相属，皆彼宋自祸其民也。","book":"《元史·世祖纪五》"},"similar":["死伤相枕"],"usage":"作谓语、定语；形容伤亡者多"},{"id":27510,"word":"死别生离","pinyin":"sǐ bié shēng lí","abbr":"sbsl","explanation":"永久的离别或难期再见的离别。","source":{"text":"死别生离辞故里，经历尽万种孤凄。","book":"元·柯丹丘《荆钗记·见母》"},"example":{"text":"何以贾宝玉那番乡试，那等难堪，后来直弄到～？","book":"清·文康《儿女英雄传》第三十四回"},"similar":["生离死别","生离死绝","生别死离"],"usage":"作主语、宾语、定语；表现对分别的悲伤"},{"id":27511,"word":"死到临头","pinyin":"sǐ dào lín tóu","abbr":"sdlt","explanation":"临：面临。快要到了死亡的时刻。","source":{"text":"别演戏，说真的。你一生都在撒谎，死到临头就说句真话吧。","book":"王朔《过把瘾就死》"},"example":{"text":"～，你该讲实话吧！"},"usage":"作谓语、定语；指临死"},{"id":27512,"word":"死去活来","pinyin":"sǐ qù huó lái","abbr":"sqhl","explanation":"指因极度的疼痛或悲哀，晕过去，又醒过来。多形容被打得很惨，或哭得很厉害。","source":{"text":"便是小户人家，还要挣一碗饭养活母亲；那里有将现成的闹光了，反害的老人家哭的死去活来的。","book":"清·曹雪芹《红楼梦》第一百回"},"example":{"text":"让众官进去，才晓得柳知府已经吓得～。","book":"清·李宝嘉《文明小史》第三回"},"similar":["痛不欲生","寻死觅活"],"opposite":["不痛不痒"],"usage":"作谓语、补语；用于被打或哭泣"},{"id":27513,"word":"死告活央","pinyin":"sǐ gào huó yāng","abbr":"sghy","explanation":"指苦苦恳求。","source":{"text":"当下二人死告活央，说的西门庆肯了。","book":"明·兰陵笑笑生《金瓶梅词话》第二十一回"},"usage":"作谓语、定语；用于书面语"},{"id":27514,"word":"死地求生","pinyin":"sǐ dì qiú shēng","abbr":"sdqs","explanation":"在极危险的境地中求取生存。","source":{"text":"士贵建功立名节，今虽众寡不敌，男子当死地求生，徒惧无益也。","book":"《新唐书·赵犨传》"},"similar":["死里求生"],"usage":"作谓语、宾语；指在很危险的境地中求生"},{"id":27515,"word":"死声咷气","pinyin":"sǐ shēng táo qì","abbr":"sstq","explanation":"大声嘶喊、哭叫。","source":{"text":"听不的他死生咷气，恶叉白赖。","book":"元·无名氏《玉壶春》第三折"},"similar":["死声淘气"],"usage":"作谓语、状语；用于书面语"},{"id":27516,"word":"死声唃气","pinyin":"sǐ shēng huó qì","abbr":"sshq","explanation":"大声嘶喊、哭叫。"},{"id":27517,"word":"死声活气","pinyin":"sǐ shēng huó qì","abbr":"sshq","explanation":"声音有气无力。","source":{"text":"鹊噪檐前不肯休，死声活气没来由。","book":"明·兰陵笑笑生《金瓶梅词话》第九十六回"},"similar":["有气无力"],"usage":"作宾语、状语；用于书面语"},{"id":27518,"word":"死声淘气","pinyin":"sǐ shēng táo qì","abbr":"sstq","explanation":"大声嘶喊、哭叫。同“死声咷气”。","source":{"text":"死声淘气叫皇天，老天公不管。","book":"明·冯惟敏《醉太平·李中麓醉归堂夜话》曲"},"similar":["死声咷气"],"usage":"作谓语、状语；用于书面语"},{"id":27519,"word":"死对头","pinyin":"sǐ duì tóu","abbr":"sdt","explanation":"指难以和解的仇敌。","source":{"text":"现在他们怕我们防得厉害，犯不着为这点小事，做成个死对头。","book":"高阳《胡雪岩全传·萧瑟洋场》"},"example":{"text":"你已经成了他的～了。"},"similar":["不共戴天"],"opposite":["铁哥们"],"usage":"作主语、宾语；指难以和解的仇敌"},{"id":27520,"word":"死得其所","pinyin":"sǐ dé qí suǒ","abbr":"sdqs","explanation":"所：处所，地方；得其所：得到合适的地方。指死得有价值，有意义。","source":{"text":"人生有死，死得其所，夫复何恨。","book":"《魏书·张普惠传》"},"example":{"text":"我们为人民而死，就是～。","book":"毛泽东《为人民服务》"},"similar":["流芳百世","名垂青史"],"opposite":["死有余辜"],"usage":"作谓语、宾语；指死得有价值"},{"id":27521,"word":"死心塌地","pinyin":"sǐ xīn tā dì","abbr":"sxtd","explanation":"原指死了心，不作别的打算。后常形容打定了主意，决不改变。","source":{"text":"这洛阳城刘员外，他是个有钱贼，只要你还了时方才死心塌地。","book":"元·无名氏《鸳鸯被》第四折"},"example":{"text":"那呆子纵身跳起，口里絮絮叨叨的，挑着担子，只得～，跟着前来。","book":"明·吴承恩《西游记》第二十回"},"similar":["至死不渝","执迷不悟"],"opposite":["举棋不定","犹豫不决"],"usage":"作谓语、状语；指态度顽固","story":["河南府尹李彦实与女儿玉英相依为命，由于被人诬陷，他向刘员外借十两银子前去受审。刘员外借此逼玉英嫁给他。玉英在尼姑庵与进京赶考的张晋卿私订终身，张生考中归来任洛阳县令，玉英让他还掉刘员外的债才能死心塌地地生活"]},{"id":27522,"word":"死心搭地","pinyin":"sǐ xīn dā dì","abbr":"sxdd","explanation":"形容打定了主意，决不改变。同“死心塌地”。","source":{"text":"常教他尽醉方归，是他拂茶客青山沽酒旗；伴着我死心搭地，是兀那隐离人望眼钓鱼矶。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"刘唐揭起桶盖，又兜了半瓢吃，故意耍他们看着，只是叫人～。","book":"明·施耐庵《水浒全传》第十六回"},"similar":["死心落地","死心塌地"],"usage":"作谓语、定语、状语；指态度顽固"},{"id":27523,"word":"死心眼","pinyin":"sǐ xīn yǎn","abbr":"sxy","explanation":"固执拘泥，想不开。比喻性情固执，或者遇事想不开的人。","source":{"text":"难道天下没有一样的风筝，单他有这个不成？二爷也死心眼儿了！","book":"清·曹雪芹《红楼梦》第70回"},"example":{"text":"这小子怎么一个～看上个润叶？","book":"路遥《平凡的世界》第三卷第三章"},"similar":["死心眼儿"],"usage":"作宾语、定语、状语；指性情固执"},{"id":27524,"word":"死心眼儿","pinyin":"sǐ xīn yǎn er","abbr":"sxye","explanation":"固执而不知变通。也指专一不变。","source":{"text":"难道天下没有一样的风筝，单他有这个不成？二爷也太死心眼儿。","book":"清·曹雪芹《红楼梦》第七十回"},"example":{"text":"问到底本有两种，一是“耍奸心”，一是“～”。","book":"朱自清《外东消夏录·引子》"},"similar":["死心眼"],"opposite":["缺心眼"],"usage":"作谓语、宾语、定语；指性情固执"},{"id":27525,"word":"死心落地","pinyin":"sǐ xīn luò dì","abbr":"sxld","explanation":"犹死心塌地。形容打定了主意，决不改变。","source":{"text":"安公子这几个头，真是磕了个死心落地的。","book":"清·文康《儿女英雄传》第十回"},"similar":["死心搭地"],"usage":"作定语、状语；用于书面语"},{"id":27526,"word":"死心踏地","pinyin":"sǐ xīn tà dì","abbr":"sxtd","explanation":"形容打定了主意，决不改变。同“死心塌地”。","source":{"text":"要不这么冤你一下，你怎么会死心踏地的点头呢？","book":"老舍《骆驼祥子》"},"example":{"text":"钱钟书《围城》：“我真不敢想要历过多少挫折，才磨练到这种～的境界。”"},"similar":["死心踏地","死心搭地"],"usage":"作谓语、定语、状语；用于处事"},{"id":27527,"word":"死搬硬套","pinyin":"sǐ bān yìng tào","abbr":"sbyt","explanation":"指不顾实际情况，机械地运用别人的经验，照抄别人的办法。","example":{"text":"我们不能～，得灵活运用。"},"similar":["生搬硬套","死搬教条"],"opposite":["灵活机动"],"usage":"作谓语、宾语、定语、状语；指照抄"},{"id":27528,"word":"死无对证","pinyin":"sǐ wú duì zhèng","abbr":"swdz","explanation":"对证：核实。当事人已死，无法核对事实。","source":{"text":"那厮死了，可不好了，你做的个死无对证。","book":"元·无名氏《抱妆盒》第三折"},"example":{"text":"汝说的都是～的话，我也不信。","book":"明·杨尔曾《韩湘子全传》第23回"},"opposite":["有据可查"],"usage":"作宾语、定语；指无法核对事实"},{"id":27529,"word":"死无所名","pinyin":"sǐ wú suǒ míng","abbr":"swsm","explanation":"名：为世人所知晓。虽死而不为世人所称道。指白白地送死。","source":{"text":"闻此必恐而谋泄，死无所名，非壮士也。","book":"《后汉书·班超传》"},"usage":"作谓语、定语；用于书面语"},{"id":27530,"word":"死无葬身之地","pinyin":"sǐ wú zàng shēn zhī dì","abbr":"swzszd","explanation":"死了没有地方埋葬。形容惨死或严厉的惩罚。","source":{"text":"虽然道臣事君已忠，君使臣以礼哎，这便是死无葬身之地，敢向那云阳市血染朝衣。","book":"元·马致远《陈抟高卧》第三折"},"example":{"text":"相公坚执如此，夫妇～矣！（明·王世贞《鸣凤记·写本》）"},"similar":["死无葬身之所"],"usage":"作宾语、状语；用于诅咒别人"},{"id":27531,"word":"死无葬身之所","pinyin":"sǐ wú zàng shēn zhī suǒ","abbr":"swzszs","explanation":"形容惨死或严厉的惩罚。同“死无葬身之地”。","source":{"text":"我先前的攻击社会，其实也是无聊的。社会没有知道我在攻击，倘一知道，我早已死无葬身之所了。","book":"鲁迅《而已集·答有恒先生》"},"similar":["死无葬身之地"],"usage":"作宾语、分句；用于诅咒别人"},{"id":27532,"word":"死无遗忧","pinyin":"sǐ wú yí yōu","abbr":"swyy","explanation":"死而心安，无后顾之忧。","source":{"text":"使其君生无废事，死无遗忧。","book":"《淮南子·泰族训》"}},{"id":27533,"word":"死日生年","pinyin":"sǐ rì shēng nián","abbr":"srsn","explanation":"多用作下对上的感恩之词。","source":{"text":"冀千虑一得，衮职有补，则死日生年，甘从斧钺。","book":"唐·魏征《十渐不克终疏》"},"usage":"作宾语；用于下级对上级的感恩"},{"id":27534,"word":"死有余僇","pinyin":"sǐ yǒu yú lù","abbr":"syyl","explanation":"僇：通“戮”。形容罪大恶极，虽死还杀不够。","source":{"text":"至杀无辜，污宫眷，如文臣李梦阳、内臣何文鼎辈所奏，真死有余僇。","book":"明·沈德符《万历野获编·世宗废后》"},"similar":["死有余诛","死有余辜","死有余罪"],"usage":"作谓语、定语；指罪大恶极"},{"id":27535,"word":"死有余僯","pinyin":"sǐ yǒu yú lù","abbr":"syyl","explanation":"犹死有余辜。形容罪大恶极，即使处死刑也抵偿不了他的罪恶。"},{"id":27536,"word":"死有余罪","pinyin":"sǐ yǒu yú zuì","abbr":"syyz","explanation":"犹死有余辜。形容罪大恶极，即使处死刑也抵偿不了他的罪恶。","source":{"text":"吾居大位，已负素餐之责矣，起受侯印，还卧而死，死有余罪。","book":"《汉书·平当传》"},"example":{"text":"况且张献忠识字不多，你替他草飞檄辱骂朝廷，直斥皇上，实系～！","book":"姚雪垠《李自成》第二卷第二十四章"},"similar":["死有余辜"],"usage":"作谓语、定语；指罪大恶极"},{"id":27537,"word":"死有余诛","pinyin":"sǐ yǒu yú zhū","abbr":"syyz","explanation":"犹死有余辜。形容罪大恶极，即使处死刑也抵偿不了他的罪恶。","source":{"text":"臣等虽三尺之喙，日诵五车之书，反不如医卜执技之流、簿书奔走之吏，其为尸素，死有余诛。","book":"宋·苏轼《谢除两职守礼部尚书表》"},"similar":["死有余责","死有余罪"],"usage":"作谓语、定语；指罪大恶极"},{"id":27538,"word":"死有余责","pinyin":"sǐ yǒu yú zé","abbr":"syyz","explanation":"指虽死尚有罪责。","source":{"text":"幸得充位宰相，不能进贤退不肖，以此负国，死有余责。","book":"汉·荀悦《汉纪·哀帝纪下》"},"example":{"text":"宋·苏轼《昌化军谢表》：“军讫者并鬼门而东鹜，浮瘴海以南迁，生无还期，～。”"},"similar":["死有余罪","死有余辜"],"usage":"作谓语、定语；指罪大恶极"},{"id":27539,"word":"死有余辜","pinyin":"sǐ yǒu yú gū","abbr":"syyg","explanation":"辜：罪。形容罪大恶极，即使处死刑也抵偿不了他的罪恶。","source":{"text":"盖奏当之成，虽咎繇听之，犹以为死有余辜。","book":"《汉书·路温舒传》"},"example":{"text":"这个杀人犯，谋财害命，真是～。"},"similar":["罪大恶极","罪该万死"],"opposite":["功德无量","功标青史"],"usage":"作谓语、定语；指罪大恶极","story":["西汉时期路温舒对法律十分精通，对当时的律令不满。汉宣帝即位后，他上书《尚德缓刑书》，援引历史上的一系列冤狱，加上当时狱卒屈打成招的现象十分普遍，就是清官断案也会认为是死有余辜的。汉宣帝觉得很有道理就施行仁政"]},{"id":27540,"word":"死标白缠","pinyin":"sǐ biāo bái chán","abbr":"sbbc","explanation":"指极力纠缠。","source":{"text":"若不是狄周死标白缠，他还要抓空子逃跑。","book":"清·西周生《醒世姻缘传》第38回"},"usage":"作谓语、定语；用于书面语"},{"id":27541,"word":"死样活气","pinyin":"sǐ yàng huó qì","abbr":"syhq","explanation":"不死不活，没有生气。","source":{"text":"我宁可向泼剌的妓女立正，却不愿意和死样活气的文人打棚。","book":"鲁迅《且介亭杂文二集·“京派”和“海派”》"},"similar":["不死不活"],"usage":"作定语、状语；用于书面语"},{"id":27542,"word":"死模活样","pinyin":"sǐ mó huó yàng","abbr":"smhy","explanation":"半死不活的模样。","source":{"text":"你这丫头，叫你做醒酒汤，则说道懒做便了，直装出许多死模活样。","book":"明·冯梦龙《警世通言》卷十三"},"example":{"text":"明·冯梦龙《警世通言》第13卷：“教你做醒酒汤，则说道懒做便了，直装出许多～！”"},"usage":"作宾语、定语；用于书面语"},{"id":27543,"word":"死欲速朽","pinyin":"sǐ yù sù xiǔ","abbr":"sysx","explanation":"指人死了以后尸体腐朽得越快越好。人死入土为安。","source":{"text":"有子问于曾子曰：‘问丧于夫子乎？’曰：‘闻之矣，丧欲速贫，死欲速朽。’","book":"《礼记·檀弓上》"},"example":{"text":"并掘发殷贵妃墓，毁去碑石，怪不得先圣有言，丧欲速贫，～。","book":"蔡东藩《南北史演义》第二十回"}},{"id":27544,"word":"死死平平","pinyin":"sǐ sǐ píng píng","abbr":"sspp","explanation":"麻木不仁，没有生气。","example":{"text":"他一辈子生活得没味没臭，～。"},"similar":["麻木不仁"],"usage":"作状语；指没有生气"},{"id":27545,"word":"死气沉沉","pinyin":"sǐ qì chén chén","abbr":"sqcc","explanation":"形容气氛不活泼。也形容人精神消沉，不振作。","source":{"text":"上海有官立的书报审查处，凡较好的作品，一定不准出版，所以出版界都是死气沉沉。","book":"鲁迅《书信集·致吴渤》"},"example":{"text":"这是一个～的地方。"},"similar":["万马齐喑"],"opposite":["生气勃勃","朝气蓬勃"],"usage":"作谓语、定语；指缺少活力"},{"id":27546,"word":"死求白赖","pinyin":"sǐ qiú bái lài","abbr":"sqbl","explanation":"指不停地纠缠。","source":{"text":"只怕死求白赖，或者竟拦住他也不可知。","book":"清·文康《儿女英雄传》第十六回"},"similar":["死乞白赖","死乞百赖"],"usage":"作谓语、宾语；指不停地纠缠"},{"id":27547,"word":"死求百赖","pinyin":"sǐ qiú bǎi lài","abbr":"sqbl","explanation":"形容纠缠不休。同“死乞白赖”。","source":{"text":"你死求百赖的叫我出去，出去干什么呀？","book":"孔厥《新儿女英雄传》第四回"},"similar":["死求白赖","死乞白赖"],"usage":"作谓语、宾语；指不停地纠缠"},{"id":27548,"word":"死灰复然","pinyin":"sǐ huī fù rán","abbr":"shfr","explanation":"比喻失势者重新得势或停息的事物又重新活动起来。","source":{"text":"安国坐法抵罪，蒙狱吏田甲辱安国，安国曰：‘死灰独不复然乎？’田甲曰：‘然即溺之。’","book":"西汉·司马迁《史记·韩长孺列传》"},"similar":["死灰复燃","死灰复燎"],"usage":"作谓语、宾语；指失势的人重新得势","story":["西汉景帝时，梁孝王刘武的手下中大夫韩安国因犯事被关在蒙地监狱，狱卒田甲经常欺辱他，韩安国说：“死灰独不复燃耶？”，田甲说撒泡尿浇灭它。不久韩安国被释放并做了更大的官，田甲便光着身子向韩安国求饶，韩安国并没报复他"]},{"id":27549,"word":"死灰复燃","pinyin":"sǐ huī fù rán","abbr":"shfr","explanation":"冷灰重新烧了起来。原比喻失势的人重新得势。现常比喻已经消失了的恶势力又重新活动起来。","source":{"text":"狱吏田甲辱安国。安国曰：‘死灰独不复燃乎？’","book":"《史记·韩长儒列传》"},"example":{"text":"儒家的理论，非等到董仲舒不能～的。","book":"闻一多《什么是儒家》"},"similar":["东山再起","卷土重来"],"opposite":["付之一炬","石沉大海"],"usage":"作谓语、宾语；指失势的人重新得势","story":["西汉景帝时，梁孝王刘武的手下中大夫韩安国因犯事被关在蒙地监狱，狱卒田甲经常欺辱他，韩安国说：“死灰独不复燃耶？”，田甲说撒泡尿浇灭它。不久韩安国被释放并做了更大的官，田甲便光着身子向韩安国求饶，韩安国并没报复他"]},{"id":27550,"word":"死灰复燎","pinyin":"sǐ huī fù liáo","abbr":"shfl","explanation":"比喻已经消失了的恶势力又重新活动起来。同“死灰复燃”。","source":{"text":"这个使不得，若非斩草除根，全消祸种，定要死灰复燎，自惹飞灾。","book":"清·遯庐《童子军·逼狱》"},"similar":["死灰复燃","余烬复燃","死灰复然"],"usage":"作谓语、宾语；指失势的人重新得势"},{"id":27551,"word":"死灰槁木","pinyin":"sǐ huī kū mù","abbr":"shgm","explanation":"冷了的灰烬，枯槁的树木。比喻毫无生气或意志消沉，对世事无动于衷。","source":{"text":"死灰槁木，取其寂寞无情耳。","book":"《庄子·齐物论》：“形固可使如槁木，而心固可使如死灰乎？”晋·郭象注"},"example":{"text":"我所居室，汝知之乎？沉寂湛然，无有喧争，嗒然其中，～，以异而同。","book":"宋·苏轼《观妙堂记》"},"similar":["槁木死灰"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":27552,"word":"死狗扶不上墙","pinyin":"sǐ gǒu fú bù shàng qiáng","abbr":"sgfbsq","explanation":"比喻不受别人尊重，不识抬举或没有培养前途。","source":{"text":"我说来么，你可不依我，这死狗扶不上墙。","book":"元·秦简夫《东堂老》第一折"},"example":{"text":"正是咬人脚后跟底货，大是～也。","book":"清·傅山《霜集·杂记》卷二十五"}},{"id":27553,"word":"死生不二","pinyin":"sǐ shēng bù èr","abbr":"ssbe","explanation":"在什么情况下都一样，至死不变。指友谊的真挚、忠诚。","source":{"text":"城里喧繁，空山寂静。然虽如此，动静一如，死生不二。","book":"宋·释普济《五灯会元》卷十六"},"example":{"text":"此皆父亲在世，缔交的正人君子，所以～。","book":"清·李绿园《歧路灯》第七十二回"}},{"id":27554,"word":"死生啕气","pinyin":"sǐ shēng táo qì","abbr":"sstq","explanation":"指大声嘶喊、哭叫。","source":{"text":"听不的他死生咷气，恶叉白赖。","book":"元·无名氏《玉壶春》第三折"},"example":{"text":"只得又要改行往那官盐店里顿了盐来用袋装盛，背在肩上，串长街，过短巷，～，吆喝盐哩。","book":"清·西周生《醒世姻缘传》第五十四回"}},{"id":27555,"word":"死生契阔","pinyin":"sǐ shēng qiè kuò","abbr":"ssqk","explanation":"契：合；阔：离。死生离合的意思。","source":{"text":"死生契阔，与子成说。","book":"《诗经·邶风·击鼓》"},"example":{"text":"宋·洪迈《夷坚丁志·王八郎》：“少顷又如前，乃知夫妇之情，～，犹为怨偶如此，然竟同穴焉。”"},"similar":["生死离合"],"usage":"作宾语、定语；用于书面语"},{"id":27556,"word":"死生存亡","pinyin":"sǐ shēng cún wáng","abbr":"sscw","explanation":"生存或者死亡。常比喻情势已到了非存即亡的关键时刻。","source":{"text":"夫礼，死生存亡之体也。","book":"《左传·定公十五年》"},"similar":["生死存亡"],"usage":"作主语、宾语、定语；指紧急关头"},{"id":27557,"word":"死生有命","pinyin":"sǐ shēng yǒu mìng","abbr":"ssym","explanation":"指人的生死都是命中注定。","source":{"text":"妾闻死生有命，富贵在天，修善尚不蒙福，为邪欲以何望。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"我不相信～的说法。"},"similar":["命中注定"],"opposite":["事在人为"],"usage":"作宾语、定语；指宿命论","story":["西汉后期，平庸而贪色的汉成帝整天在后宫享乐，他喜欢班美女，封她为婕妤。班婕妤很有文学才华和修养。汉成帝废许皇后立赵飞燕为皇后。赵飞燕为了消灭对手诬陷班婕妤诅咒皇帝。班婕妤辩解死生有命，世上根本没有鬼神。汉成帝认为言之有理"]},{"id":27558,"word":"死生有命，富贵在天","pinyin":"sǐ shēng yǒu mìng，fù guì zài tiān","abbr":"ssymfgzt","explanation":"指万事皆由天命注定。","source":{"text":"子夏曰：‘商闻之矣，死生有命，富贵在天。’","book":"《论语·颜渊》"},"example":{"text":"岂不闻夏云：“～。”何惧之有。","book":"元·无名氏《刘弘嫁婢》楔子"},"usage":"作宾语、定语、分句；用于宿命论","story":["西汉后期，平庸而贪色的汉成帝整天在后宫享乐，他喜欢班美女，封她为婕妤。班婕妤很有文学才华和修养。汉成帝废许皇后立赵飞燕为皇后。赵飞燕为了消灭对手诬陷班婕妤诅咒皇帝。班婕妤辩解死生有命，世上根本没有鬼神。汉成帝认为言之有理"]},{"id":27559,"word":"死生未卜","pinyin":"sǐ shēng wèi bǔ","abbr":"sswb","explanation":"指死活无法知道。","source":{"text":"徐郎辽海从戍，死生未卜，纵饶无恙，又安能至此而成姻乎？","book":"明·李祺昌《剪灯余话·琼奴传》"},"example":{"text":"清·无名氏《说呼全传》第11回：“俺现在难中，～，且自漂泊山河，行止莫考，岂可耽误令妹的终身？”"},"similar":["生死未卜"],"usage":"作谓语、定语；用于口语等"},{"id":27560,"word":"死生淘气","pinyin":"sǐ shēng táo qì","abbr":"sstq","explanation":"指大声嘶喊、哭叫。","source":{"text":"听不的他死生咷气，恶叉白赖。","book":"元·无名氏《玉壶春》第三折"},"example":{"text":"～叫皇天，老天公不管。","book":"明·冯惟敏《醉太平·李中麓醉归堂夜话》"}},{"id":27561,"word":"死生荣辱","pinyin":"sǐ shēng róng rǔ","abbr":"ssrr","explanation":"指死亡、生存、荣耀、耻辱。","source":{"text":"死生荣辱之道一，则三军之士可使一心矣。","book":"《吕氏春秋·论威》"},"example":{"text":"清·褚人获《隋唐演义》第40回：“～，天心早已安排，何必此时预作楚囚相对？”"},"similar":["生死荣辱"],"usage":"作宾语、定语；指人的处世观"},{"id":27562,"word":"死病无良医","pinyin":"sǐ bìng wú liáng yī","abbr":"sbwly","explanation":"比喻无法挽救。死病，不治之症。","source":{"text":"新垣固谓子顺曰：‘……子何去之速也。’答曰：‘以无异政，所以自退也。且死病无良医。今秦有吞食天下之心，以义事之，固不获安；救亡不暇，何化之兴？’","book":"《孔丛子·执节》"},"usage":"作宾语、定语；用于书面语"},{"id":27563,"word":"死皮赖脸","pinyin":"sǐ pí lài liǎn","abbr":"spll","explanation":"形容厚着脸皮，胡搅蛮缠。","source":{"text":"死皮赖脸的三日两头儿来缠舅舅，要三升米二升豆子。","book":"清·曹雪芹《红楼梦》第二十四回"},"example":{"text":"每个人都应有自尊心人家不给你，你不要～地去要。"},"similar":["执迷不悟","厚颜无耻","涎皮涎脸"],"opposite":["悬崖勒马"],"usage":"作谓语、定语；形容不顾羞耻的样子"},{"id":27564,"word":"死相枕藉","pinyin":"sǐ xiāng zhěn jí","abbr":"sxzj","explanation":"枕藉：纵横相枕而卧。死亡的人相互枕藉而卧。形容死亡的人非常多。","source":{"text":"值西晋之末，中原乱离，饥馑既臻，疫疠乃作，时有毒瘴，殒毙者多，闾里凋荒，死亡枕藉。","book":"宋·李昉《太平广记》卷十五"},"similar":["死亡枕藉","死伤枕藉"],"usage":"作谓语、定语；用于书面语"},{"id":27565,"word":"死眉瞪眼","pinyin":"sǐ méi dèng yǎn","abbr":"smdy","explanation":"眉不活，眼不动。比喻不灵活，不能应付。","source":{"text":"偏偏那日来的多，里头的人都死眉瞪眼的。凤姐只得在那里照料了一会子。","book":"清·曹雪芹《红楼梦》第一百十回"},"opposite":["明眸善睐"],"usage":"作谓语、定语；指表情冷漠"},{"id":27566,"word":"死缠硬磨","pinyin":"sǐ chán yìng mó","abbr":"scym","explanation":"指一味不休的纠缠某人或某事。","source":{"text":"但要是这家人死缠硬磨，她二妈又从旁劝说，她到时又可能没勇气和这一群县上的头面人物破开脸皮，让他们当场下不了台。","book":"路遥《平凡的世界》第二卷第36章"},"similar":["死缠滥打"],"usage":"作谓语、宾语、状语；用于口语"},{"id":27567,"word":"死者相枕","pinyin":"sǐ zhě xiāng zhěn","abbr":"szxz","explanation":"死亡的人相互枕藉而卧。形容死亡的人很多。","source":{"text":"谢石乘胜追击，至于青冈，死者相枕。","book":"《魏书·苻坚传》"},"similar":["死相枕藉"],"usage":"作谓语、定语；用于战争或灾害等"},{"id":27568,"word":"死而不僵","pinyin":"sǐ ér bù jiāng","abbr":"sebj","explanation":"即使死了也不僵硬。形容坏势力等不容易被清除。","source":{"text":"古人有言：‘百足之虫，死而不僵。’如今虽说不似先年那样兴盛，较之平常仕宦人家，到底气象不同。","book":"清·曹雪芹《红楼梦》第二回"},"usage":"作谓语、定语；用于坏势力等","story":["贾雨村在村野酒店喝酒，遇到都中做贸易的冷子兴，两人是老相识，而且很投合。两人在酒桌上谈论京城贾家荣国府与宁国府的事说：“古人有言：‘百足之虫，死而不僵。’如今虽说不似先年那样兴盛，较之平常仕宦人家，到底气象不同。”"]},{"id":27569,"word":"死而不悔","pinyin":"sǐ ér bù huǐ","abbr":"sebh","explanation":"就是死了也心甘。","source":{"text":"娥生长倡家，乃能坚白自守，死而不悔。人非倡女，而不能以礼自防者，视娥得无愧耻。","book":"宋·李昌龄《乐善录·节娥》"},"example":{"text":"宋·李昌龄《乐善录·节娥》：“娥生长倡家，乃能坚白自守，～。”"},"similar":["死而无悔"],"opposite":["死不瞑目","死不闭目"],"usage":"作谓语、定语；指态度坚决"},{"id":27570,"word":"死而不朽","pinyin":"sǐ ér bù xiǔ","abbr":"sebx","explanation":"指身虽死而声名、事业长存。","source":{"text":"古人有言曰：‘死而不朽，何谓也。’","book":"春秋·鲁·左丘明《左传·襄公二十四年》"},"example":{"text":"生而不淑，孰为其寿；～，孰为其天。","book":"唐·韩愈《唐太子校书李元宾墓志铭》"},"similar":["永不磨灭"],"usage":"作谓语、定语；指事业永不磨灭","story":["公元前549年，鲁国大夫穆叔奉命出访晋国，晋国卿范宣子问他“死而不朽”的含义是什么。穆叔没有回答，范宣子说他的祖先在各个朝代都是名门贵族，这就是死而不朽。穆叔则认为只有好的德行、功业、言论才会死而不朽的"]},{"id":27571,"word":"死而后已","pinyin":"sǐ ér hòu yǐ","abbr":"sehy","explanation":"已：停止。死了以后才罢手。形容为完成一种责任而奋斗终身。","source":{"text":"士不可以不弘毅，任重而道远。仁以为己任，不亦重乎？死而后已，不亦远乎？","book":"《论语·泰伯》"},"example":{"text":"臣披肝沥胆，尚不能补报皇上之恩。今奉诏命，敢不竭力尽忠，～。","book":"明·施耐庵《水浒全传》第八十三回"},"similar":["鞠躬尽瘁","摩顶放踵"],"opposite":["虚度年华"],"usage":"作谓语、宾语、分句；指奋斗终身","story":["三国时期，蜀主刘备死后，昏庸无能的阿斗继位，他只知享乐，把国内的军政大权交给诸葛亮处理。诸葛亮一面联吴伐魏，南征孟获，积极准备两次北伐，在最后一次北伐前夕给阿斗写《后出师表》表示自己为国鞠躬尽瘁、死而后已"]},{"id":27572,"word":"死而后止","pinyin":"sǐ ér hòu zhǐ","abbr":"sehz","explanation":"形容为完成一种责任而奋斗终身。同“死而后已”。","source":{"text":"夫二子之良，将勤营其君，复使立于外，死而后止，何日以来。","book":"《国语·晋语》"},"similar":["死而后已"],"usage":"作谓语、宾语、分句；指奋斗终身"},{"id":27573,"word":"死而复生","pinyin":"sǐ ér fù shēng","abbr":"sefs","explanation":"死去了又活过来，形容生命不息。","source":{"text":"方士有董仲君，有罪系狱，佯死数日，目陷虫出，死而复生，然后竟死。","book":"三国·魏·曹植《辩道论》"},"example":{"text":"经过～的挣扎，他才在风雪中摸下了祁连山。","book":"碧野《山高水长》"},"similar":["起死回生","死去活来","死而复苏"],"opposite":["与世长辞"],"usage":"作谓语、定语；用于失而复得"},{"id":27574,"word":"死而复苏","pinyin":"sǐ ér fù sū","abbr":"sefs","explanation":"死去了又活过来，形容生命不息。","source":{"text":"地狱百毒，汤镬锉碓，随索随见，鬼形糜碎，死而复苏屡矣。","book":"宋·洪迈《夷坚丙志·九圣奇鬼》"},"example":{"text":"清·李百川《绿野仙踪》第六回：“卜氏哭的～，直哭了两日夜，一点饭也不吃。”"},"similar":["死而复生"],"usage":"作谓语、定语；用于失而复得"},{"id":27575,"word":"死而无怨","pinyin":"sǐ ér wú yuàn","abbr":"sewy","explanation":"即使死了，也毫不怨恨。形容心甘情愿。","source":{"text":"不是我闲淘气，便死呵死而无怨，待悔呵悔之何及！","book":"元·郑光祖《倩女离魂》第三折"},"example":{"text":"求大人请臬台大人升一升冠，露一露头部，倘没有受伤痕迹，小人～。","book":"清·吴趼人《二十年目睹之怪现状》第二十七回"},"similar":["死而无悔"],"opposite":["死不瞑目"],"usage":"作谓语；指死而无悔","story":["春秋时期，孔子外出讲学，子路佩剑前往保护孔子，子路说自己像箭不用读书，孔子说读书可以让他有勇有谋。子路问孔子统率三军时愿意与谁共事，孔子说不愿与那些空手打虎及徒步过河的有勇无谋的人共事，与有勇有谋的人共事死而无怨"]},{"id":27576,"word":"死而无悔","pinyin":"sǐ ér wú huǐ","abbr":"sewh","explanation":"就是死了也不懊悔。形容态度坚决。","source":{"text":"子曰：‘暴虎冯河，死而无悔者，吾不与也。’","book":"春秋·鲁·孔丘《论语·述而》"},"example":{"text":"蕴利生孽，～者，葛若猩猩含血乎？","book":"唐·裴炎《猩猩铭》序"},"similar":["死而不悔","死而无憾"],"opposite":["死不瞑目"],"usage":"作谓语、定语；指态度坚决","story":["春秋时期，孔子外出讲学，子路佩剑前往保护孔子，子路说自己像箭不用读书，孔子说读书可以让他有勇有谋。子路问孔子统率三军时愿意与谁共事，孔子说不愿与那些空手打虎及徒步过河的有勇无谋的人共事，与有勇有谋的人共事死而无悔"]},{"id":27577,"word":"死而无憾","pinyin":"sǐ ér wú hàn","abbr":"sewh","explanation":"即使死了也而无遗憾。","example":{"text":"能让我再见你一面，我～了。"},"similar":["死而无怨"],"opposite":["死不瞑目"],"usage":"作谓语；指死而无悔"},{"id":27578,"word":"死而死矣","pinyin":"si er si yi","abbr":"sesy","explanation":"死就死罢了."},{"id":27579,"word":"死胡同","pinyin":"sǐ hú tòng","abbr":"sht","explanation":"指只有一个出入口的胡同。比喻绝境、绝路。","example":{"text":"搞台独就是钻进一条～。"},"usage":"作宾语、定语；用于比喻句"},{"id":27580,"word":"死脑瓜骨","pinyin":"sǐ nǎo guā gǔ","abbr":"sngg","explanation":"不开通。","source":{"text":"你呀，就是死脑瓜骨！","book":"锦云等《草莓三爷》"},"similar":["死脑筋"],"usage":"作宾语、定语；指不开通"},{"id":27581,"word":"死脑筋","pinyin":"sǐ nǎo jīn","abbr":"snj","explanation":"思想僵化固执的人。","source":{"text":"她就是这样一个～。"},"example":{"text":"她就是这样一个～"},"usage":"作宾语、定语；用于口语"},{"id":27582,"word":"死要面子","pinyin":"sǐ yào miàn zǐ","abbr":"symz","explanation":"指特别爱惜自己的颜面。","source":{"text":"阿巧姐却是有点如俗语说的‘死要面子活受罪’，硬记三家出张，颇以为苦。","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"他就是～。"},"opposite":["死不要脸"],"usage":"作谓语、宾语、定语；指爱面子"},{"id":27583,"word":"死要面子活受罪","pinyin":"sǐ yào miàn zǐ huó shòu zuì","abbr":"symzhsz","explanation":"指因爱面子而遭受痛苦。","source":{"text":"阿巧姐却是有点如俗语说的‘死要面子活受罪’，硬记三家出张，颇以为苦。","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"她就是～，何必硬撑呢？"},"usage":"作谓语、宾语、定语；用于为人"},{"id":27584,"word":"死记硬背","pinyin":"sǐ jì yìng bèi","abbr":"sjyb","explanation":"指不用理解力去使用记忆力而一味死板地背诵书本。","source":{"text":"中国这种考试方式鼓励了死记硬背，但往往排斥了真正的才学。","book":"路遥《平凡的世界》第二卷第37章"},"example":{"text":"读书不能靠～。"},"similar":["照本宣科"],"opposite":["活学活用","融会贯通"],"usage":"作谓语、宾语、定语；指读书"},{"id":27585,"word":"死说活说","pinyin":"sǐ shuō huó shuō","abbr":"sshs","explanation":"一定要。","source":{"text":"她死说活说把几条鱼放在锅台上。","book":"从维熙《故乡散记》"},"usage":"作状语；用于口语"},{"id":27586,"word":"死诸葛吓走生仲达","pinyin":"sǐ zhū gé xià zǒu shēng zhòng dá","abbr":"szgxzszd","explanation":"指人虽死，余威犹在。同“死诸葛能走生仲达”。","source":{"text":"时百姓为之谚曰：‘死诸葛走生仲达。’帝闻而笑曰：‘吾便料生，不便料死故也。","book":"《晋书·宣帝纪》"},"example":{"text":"鲁迅《且介亭杂文末编·续记》：“倒是活人在依靠死人的余光，想用‘～’。我不大佩服这些活家伙。”"},"similar":["死诸葛走生仲达"],"usage":"作宾语、定语、分句；指人虽死，余威犹在","story":["三国时期，蜀军主帅诸葛亮病死军中，蜀将姜维等遵照诸葛亮遗嘱，秘不发丧，缓缓退军。魏军主帅司马懿（字仲达）率军追击，见蜀军帅旗飘扬，孔明羽扇纶巾坐在车里。司马懿怀疑是孔明用计诱敌，赶紧策马收兵"]},{"id":27587,"word":"死诸葛能走生仲达","pinyin":"sǐ zhū gé néng zǒu shēng zhòng dá","abbr":"szgnzszd","explanation":"诸葛：诸葛亮；走：吓走；仲达：司马懿。指人虽死，余威犹在。","source":{"text":"君不闻‘死诸葛能走生仲达’，千古奇事真堪诧。","book":"傅専《题自书精神一到何事不成横卷》诗"},"similar":["死诸葛走生仲达"],"usage":"作宾语、分句；指人虽死，余威犹在","story":["三国时蜀军主帅诸葛亮病死军中，蜀将姜维等遵照诸葛亮遗嘱，秘不发丧，缓缓退军。魏军主帅司马懿（字仲达）率军追击，见蜀军帅旗飘扬，孔明羽扇纶巾坐在车里。司马懿怀疑是孔明用计诱敌，赶紧策马收兵"]},{"id":27588,"word":"死诸葛走生仲达","pinyin":"sǐ zhū gé zǒu shēng zhòng dá","abbr":"szgzszd","explanation":"诸葛：诸葛亮；走：吓走；仲达：司马懿。指用死人吓唬活人。","source":{"text":"时百姓为之谚曰：‘死诸葛走生仲达。’帝闻而笑曰：‘吾便料生，不便料死故也。","book":"《晋书·宣帝纪》"},"example":{"text":"你不能犯～的错误。"},"similar":["死诸葛能走生仲达"],"usage":"作宾语、分句；指人虽死，余威犹在","story":["三国时期，蜀军主帅诸葛亮病死军中，蜀将姜维等遵照诸葛亮遗嘱，秘不发丧，缓缓退军。魏军主帅司马懿（字仲达）率军追击，见蜀军帅旗飘扬，孔明羽扇纶巾坐在车里。司马懿怀疑是孔明用计诱敌，赶紧策马收兵"]},{"id":27589,"word":"死败涂地","pinyin":"sǐ bài tú dì","abbr":"sbtd","explanation":"指惨败而死伤严重的景象。"},{"id":27590,"word":"死路一条","pinyin":"sǐ lù yī tiáo","abbr":"slyt","explanation":"无路可走，比喻没有前途。","source":{"text":"不坚持社会主义，不改革开发，不发展经济，不改善人民生活，只能是死路一条。","book":"邓小平《在武昌、深圳、珠海、上海等地的谈话要点》"},"example":{"text":"与人民为敌，～。"},"opposite":["前途无量"],"usage":"作谓语、定语、宾语；指没有前途"},{"id":27591,"word":"死轻鸿毛","pinyin":"sǐ qīng hóng máo","abbr":"sqhm","explanation":"鸿毛：鸿雁的毛，比喻轻微不足道。人的死比大雁的毛还轻。比喻毫无价值。","source":{"text":"人固有一死，或重于泰山，或轻于鸿毛，用之所趣异也。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"身侔蝉翼，何以受恩？～，固得其所。","book":"唐·刘禹锡《谢中书张相公启》"},"opposite":["死重泰山"],"usage":"作谓语、定语；用于书面语","story":["西汉时期，太史令司马迁为实现父亲的遗愿继续编著《史记》，因李陵事件被施以酷刑。他强忍痛苦，终于在公元前91年完成历史巨著《史记》。他在给朋友的信中谈到对死的认识：“人固有一死，或重于泰山，或轻于鸿毛。”"]},{"id":27592,"word":"死里求生","pinyin":"sǐ lǐ qiú shēng","abbr":"slqs","explanation":"指在极其危险的境地中求取生存。","source":{"text":"合我师傅父女两人，费了无限精神，成全得我转祸为福，死里求生，重归故里。","book":"清·文康《儿女英雄传》第25回"},"example":{"text":"新军中的一些革命分子便决心起来反抗，以图～。","book":"吴玉章《从甲午战争前后到辛亥革命前后的回忆》"},"similar":["死中求生","九死一生"],"opposite":["死路一条"],"usage":"作谓语、宾语；指在很危险的境地中求生","story":["传说古代楚国人次非从外地得到一把宝剑，高兴地渡河回家。船到江心时，两条蛟龙兴风作浪，全船人吓得魂飞魄散。次非问船夫该如何处理，船夫认为只有等死。次非则认为必须死里求生，得与蛟龙拼个你死我活，于是跳江杀了蛟龙"]},{"id":27593,"word":"死里逃生","pinyin":"sǐ lǐ táo shēng","abbr":"slts","explanation":"从极危险的境地中逃脱，幸免于死。","source":{"text":"半万贼兵，卷浮云片时扫净，俺一家儿死里逃生。","book":"元·王实甫《西厢记》第二本第三折"},"example":{"text":"今日～，夫妻再合。","book":"明·冯梦龙《警世通言》卷十二"},"similar":["死中求生","九死一生"],"opposite":["死路一条"],"usage":"作谓语、宾语；指幸免于死","story":["春秋时期，鲁国内乱，大权由季孙氏、孟孙氏及叔孙氏三家轮流控制，其中季氏势力最大，无视鲁君的存在，季府的总管阳虎见孱弱的季恒子好欺，让公山弗扰暗中在蒲围布置谋杀季恒子。季恒子发现情况异常，借口上厕所而死里逃生"]},{"id":27594,"word":"死重泰山","pinyin":"sǐ zhòng tài shān","abbr":"szts","explanation":"比喻死得光荣。","source":{"text":"人固有一死，死或重于泰山，或轻于鸿毛。","book":"语出汉·司马迁《报任少卿书》"},"example":{"text":"不畏强御，忠肝沥血。～，名光日月。","book":"《东周列国志》第十七回"},"opposite":["死轻鸿毛"],"usage":"作谓语、定语；用于书面语","story":["西汉时期，太史令司马迁为实现父亲的遗愿继续编著《史记》，因李陵事件被施以酷刑。他强忍痛苦，终于在公元前91年完成历史巨著《史记》。他在给朋友的信中谈到对死的认识：“人固有一死，或重于泰山，或轻于鸿毛。”"]},{"id":27595,"word":"死马当活马医","pinyin":"sǐ mǎ dāng huó mǎ yī","abbr":"smdhmy","explanation":"比喻明知事情已经无可求药，仍然抱一丝希望，积极挽救。也泛指做最后的尝试。","source":{"text":"若恁么会去，许尔有安乐分，其或未然不免作死马医去也。","book":"宋·集成《宏智禅师广录》卷一"},"example":{"text":"哥哥所言，我也细细想过多次，但我的政策，全是俗话说的，～。","book":"清·梁启超《新中国未来记》第三回"},"usage":"作宾语、分句；指尽力挽救"},{"id":27596,"word":"死骨更肉","pinyin":"sǐ gǔ gèng ròu","abbr":"sggr","explanation":"犹起死回生。形容医术高明。也比喻把已经没有希望的事物挽救过来。","source":{"text":"使亡魂复归，死骨更肉。","book":"唐·牛肃《吴保安传》"},"similar":["起死回生"],"usage":"作谓语、定语；用于比喻句"},{"id":27597,"word":"歼一警百","pinyin":"jiān yī jǐng bǎi","abbr":"jyjb","explanation":"警：警告。处死一个人，借以警戒其他人。","source":{"text":"其有所取也，以一警百，吏民皆服，恐惧改行自新。","book":"《汉书·尹翁归传》"},"example":{"text":"～，消其观望。","book":"清·夏燮《中西纪事·后序》"},"similar":["杀一儆百"],"usage":"作宾语、定语；同“杀一儆百”"},{"id":27598,"word":"殁世不朽","pinyin":"mò shì bù xiǔ","abbr":"msbx","explanation":"指身虽死而名声、事业长存。","source":{"text":"卿之先父，为朕元臣，大节殊功，殁而不朽。","book":"唐·刏白居易《与刘总诏》"}},{"id":27599,"word":"殁而不朽","pinyin":"mò ér bù xiǔ","abbr":"mebx","explanation":"殁：死。人虽然死了，名声或事业长存。","source":{"text":"卿之先父，为朕元臣，大节殊功，殁而不朽。","book":"唐·白居易《与刘总诏》"},"example":{"text":"竟以盗憎，遂死王事，～，风声凛然。","book":"《旧唐书·忠义下》"},"similar":["殁而无朽","死而不僵"],"usage":"作谓语、定语；指人的名声或功绩等"},{"id":27600,"word":"殁而无朽","pinyin":"mò ér wú xiǔ","abbr":"mewx","explanation":"殁：死。人虽然死了，名声或事业长存。","source":{"text":"凭风云于异代，照日月于殊涂，死者有知，殁而无朽。","book":"唐·杨炯《遂州长江县先圣孔子庙堂碑》"},"similar":["殁而不朽"],"usage":"作谓语、定语；指人的名声或功绩等"},{"id":27601,"word":"殃及池鱼","pinyin":"yāng jí chí yú","abbr":"yjcy","explanation":"比喻无缘无故地遭受祸害。","source":{"text":"宋桓司马有宝珠，抵罪出亡，王使人问珠之所在，曰：‘投之池中。’于是竭池而求之，无得，鱼死焉。此言祸福之相及也。","book":"战国·卫·吕不韦《吕氏春秋·必己》"},"example":{"text":"城门失火，～。","book":"北齐·杜弼《檄梁文》"},"similar":["池鱼之殃"],"usage":"作谓语、宾语、定语；指无端受害","story":["春秋时期，宋国的一城门发生火灾，火借着风势越烧越旺，城里的居民纷纷到护城河去取水灭火，大火被扑灭了，但护城河的河水也被舀干了，河里的鱼再也没法生存下去，全部被干死"]},{"id":27602,"word":"殃国祸家","pinyin":"yāng guó huò jiā","abbr":"yghj","explanation":"使国家遭殃，家庭受害。","source":{"text":"前轮折轴，后车覆轨，殃国祸家，亡身绝祀。","book":"南朝·梁·萧衍《净业赋》"},"usage":"作谓语、定语；用于书面语"},{"id":27603,"word":"殆无孑遗","pinyin":"dài wú jié yí","abbr":"dwjy","explanation":"殆：几乎；孑遗：剩余。几乎没有一点余剩。","source":{"text":"然益土荒残，野无青草，成都之内，殆无孑遗。","book":"晋·周祗《与刘裕书谏伐蜀》"},"example":{"text":"至已丑为西兵所败，故境内残灭，～。","book":"清·归庄《黄孝子传》"},"usage":"作谓语、定语；指全部完毕"},{"id":27604,"word":"殆无虚日","pinyin":"dài wú xū rì","abbr":"dwxr","explanation":"殆：几乎；虚：空。几乎没有一天空着。形容几乎天天如此。","source":{"text":"先自前一月来，次第按试习仪，殆无虚日。","book":"宋·周密《武林旧事·大礼》"},"example":{"text":"旋吴之后，文宴过从，～。","book":"清·夏敬渠《野叟曝言·序》"},"usage":"作谓语、定语、状语；形容十分忙碌"},{"id":27605,"word":"殉义忘生","pinyin":"xùn yì wàng shēng","abbr":"xyws","explanation":"为追求正义而舍弃生命。","source":{"text":"或攻城略野，殉义忘生。","book":"唐·欧阳询《艺文类聚》卷五十一"},"similar":["殉义忘身"],"usage":"作谓语；指为追求正义而献身"},{"id":27606,"word":"殉义忘身","pinyin":"xùn yì wàng shēn","abbr":"xyws","explanation":"殉：献出生命。为追求正义而献身。","source":{"text":"鲁广达全忠守道，殉义忘身，盖亦陈代之良臣也。","book":"《陈书·鲁广达传论》"},"similar":["殉义忘生"],"usage":"作谓语；指为追求正义而献身"},{"id":27607,"word":"殊功劲节","pinyin":"shū gōng jìn jié","abbr":"sgjj","explanation":"指卓越的功勋和刚直的节操。","source":{"text":"其殊功劲节，超越常伦，别条状绩，当特优奖。","book":"唐·陆贽《奉天遣使定慰诸道诏》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":27608,"word":"殊功异德","pinyin":"shū gōng yì dé","abbr":"sgyd","explanation":"殊、异：特殊的；功：功劳；德：恩德。指特殊的功德。","source":{"text":"碑铭之作，以明示后昆，自非殊功异德，无以允应兹典，大者道动光远，世所宗推；其次节行高妙，遗烈可纪。","book":"《宋书·裴松之传》"},"example":{"text":"其有～，非太祖而不毁，不在七庙之数。","book":"《隋书·礼仪志》"}},{"id":27609,"word":"殊勋异绩","pinyin":"shū xún yì jì","abbr":"sxyj","explanation":"卓越的功勋业绩。同“殊勋茂绩”。","source":{"text":"且自非殊勋异绩，亦何足塞今日之忧。","book":"南朝·宋·何尚之《又答问庾炳之事》"},"example":{"text":"一门二世，粉骨卫主，～，已不能甄。","book":"《南齐书·王僧虔传》"},"similar":["殊勋茂绩","丰功伟绩"],"usage":"作宾语、定语；指人的功劳大"},{"id":27610,"word":"殊勋茂绩","pinyin":"shū xūn mào jì","abbr":"sxmj","explanation":"卓越的功勋业绩。","source":{"text":"殊勋茂绩，职尔之由，崇名厚秩，非卿孰赏？","book":"《魏书·裴叔业传》"},"similar":["殊勋异绩","丰功伟绩"],"usage":"作宾语、定语；指人的功劳大"},{"id":27611,"word":"殊形妙状","pinyin":"shū xíng miào zhuàng","abbr":"sxmz","explanation":"奇妙特异的形状。","source":{"text":"与夫沉沙栖陆，异域所至，殊形妙状，目不给视。","book":"宋·周邦彦《汴都赋》"},"usage":"作宾语、定语、状语；形容物体的外形"},{"id":27612,"word":"殊形怪状","pinyin":"shū xíng guài zhuàng","abbr":"sxgz","explanation":"奇奇怪怪的形状。","source":{"text":"殊形怪状不易说，就中惊燥尤枯绝。","book":"唐·窦冀《怀素上人草书歌》"},"similar":["奇形怪状","殊形诡状"],"usage":"作谓语、定语、宾语；形容物体的外形"},{"id":27613,"word":"殊形诡制","pinyin":"shū xíng guǐ zhì","abbr":"sxgz","explanation":"诡：怪异。原指宫室建筑形制多样，独特新奇。后泛指器物奇形怪状，争异斗艳。","source":{"text":"增盘崔嵬，登降炤烂。殊形诡制，每各异观。乘茵步辇，惟所息宴。","book":"汉·班固《西都赋》"},"similar":["奇形怪状","殊形诡色"],"usage":"作宾语、定语；形容物体的外形"},{"id":27614,"word":"殊形诡状","pinyin":"shū xíng guǐ zhuàng","abbr":"sxgz","explanation":"犹言奇形怪状。不同一般的，奇奇怪怪的形状。","source":{"text":"往往有神物来萃，殊形诡状，深可骇人。","book":"唐·康骈《剧谈录·说方士》"},"example":{"text":"若兹山则浙东西山海所蟠结，幽奇险峭，～者，实大且多。","book":"清·方苞《游雁荡记》"},"similar":["殊形怪状","殊形诡色","奇形怪状"],"usage":"作宾语、定语；形容物体的外形"},{"id":27615,"word":"殊形诡色","pinyin":"shū xíng guǐ sè","abbr":"sxgs","explanation":"事物奇异特殊的形色。","source":{"text":"凡物之殊形诡色，而无益于民用者，皆可以谓之祥，可以谓之妖者也。","book":"明·刘基《螇螰》"},"similar":["殊形诡状","殊形怪状"],"usage":"作宾语、定语；形容物体的外形"},{"id":27616,"word":"殊恩厚渥","pinyin":"shū ēn hòu wò","abbr":"sehw","explanation":"殊：特殊；渥：优厚。指恩惠优厚。","source":{"text":"向使明主有任贤之意，近臣无专对之能，徒彰妄进之讥，方病退惭之说，殊恩厚渥，岂及于身。","book":"唐·康骈《剧谈录·宣宗夜召翰林学士》"}},{"id":27617,"word":"殊方同致","pinyin":"shū fāng tóng zhì","abbr":"sftz","explanation":"犹殊途同归。比喻采取不同的方法而得到相同的结果。","source":{"text":"大抵南人约简，得其英华；北学深芜，穷其枝叶，考其终始，要其会归，其立身成名，殊方同致矣。","book":"《隋书·儒林传序》"},"similar":["殊途同归"],"usage":"作宾语、定语；用于书面语"},{"id":27618,"word":"殊方异域","pinyin":"shū fāng yì yù","abbr":"sfyy","explanation":"殊方：远方；异域：异邦。泛指远方或国外。","source":{"text":"故虽有峻山巨海之隔，绝域殊方之迥，登峰诡曲之因，皆可得举而定者。","book":"晋·裴秀《禹贡九州地域图论》"},"example":{"text":"风教遐被，德泽远洽，～，慕化称臣。","book":"唐·玄奘《大唐西域记·羯若鞠阇国》"},"similar":["异域他乡"],"usage":"作主语、宾语、定语；用于书面语"},{"id":27619,"word":"殊方异类","pinyin":"shū fāng yì lèi","abbr":"sfyl","explanation":"泛指不同的地方各种各样不同的事物。","source":{"text":"其中乃有九真之麟，大宛之马，黄支之犀，条支之鸟，逾昆仑，越巨海，殊方异类，至于三万里。","book":"汉·班固《西都赋》"},"example":{"text":"唐·王勃《采莲赋》：“～，舞咏相错，王公卿士，歌吹并作。”"},"usage":"作宾语、定语；用于书面语"},{"id":27620,"word":"殊方绝域","pinyin":"shū fāng jué yù","abbr":"sfjy","explanation":"指极远的地方。","source":{"text":"名山大川，随顾奔走；殊方绝域，举意而到。","book":"唐·吕温《地志图序》"},"example":{"text":"《元史·揭傒斯传》：“～，咸慕其名，得其文者，莫不以为荣云。”"},"similar":["异域他乡"],"usage":"作宾语、定语；用于书面语"},{"id":27621,"word":"殊涂一致","pinyin":"shū tú yī zhì","abbr":"styz","explanation":"本指由不同途径达到同一目的地。后比喻采用不同方法得到相同结果。同“殊涂同归”。","source":{"text":"夫大道宰世，殊涂一致。","book":"《晋书·刁协传》"},"similar":["殊涂同致","殊途同归","殊涂同归"],"usage":"作谓语、宾语、定语；用于处事"},{"id":27622,"word":"殊涂同会","pinyin":"shū tú tóng huì","abbr":"stth","explanation":"犹殊途同归。比喻采取不同的方法而得到相同的结果。","source":{"text":"如使用审其道，则殊涂同会；才爽其分，则一豪以乖。","book":"《后汉书·王充王符仲长统传论》"},"similar":["殊涂同致","殊涂同归"],"usage":"作谓语、宾语、定语；用于处事"},{"id":27623,"word":"殊涂同归","pinyin":"shū tú tóng guī","abbr":"sttg","explanation":"本指由不同途径达到同一目的地。后比喻采用不同方法得到相同结果。","source":{"text":"言天下万事终则同归于一，但初时殊异其涂路也。","book":"语出《易·系辞下》：“天下同归而殊涂，一致而百虑。”孔颖达疏"},"similar":["殊途同归","殊路同归"],"usage":"作谓语、宾语、定语；用于人生等"},{"id":27624,"word":"殊涂同致","pinyin":"shū tú tóng zhì","abbr":"sttz","explanation":"犹殊途同归。比喻采取不同的方法而得到相同的结果。","source":{"text":"故君子百行，殊涂而同致。","book":"三国·魏·嵇康《与山巨源绝交书》"},"example":{"text":"取类而信，如江海之润下；～，若鬼神之福谦。","book":"宋·范仲淹《天道益谦赋》"},"similar":["殊涂同会","殊途一致","殊途同归"],"usage":"作谓语、宾语、定语；用于处事"},{"id":27625,"word":"殊深轸念","pinyin":"shū shēn zhěn niàn","abbr":"sszn","explanation":"非常悲痛地怀念。","source":{"text":"驾言未息，轸念殊深。特致恩颁，以嘉勤瘁。","book":"宋·苏轼《赵州赐大辽贺兴龙节副使茶药诏》"},"example":{"text":"迭据该军第一支队长陈毅、参谋长张云逸等电陈皖南事变经过，愤慨之余，～。","book":"毛泽东《为皖南事变发表的命令和谈话》"}},{"id":27626,"word":"殊滋异味","pinyin":"shū zī yì wèi","abbr":"szyw","explanation":"奇异的滋味。指美味佳肴。","source":{"text":"饮食不守其度，则殊滋异味攻之。","book":"唐·白居易《策林二·立制度》"},"similar":["美味佳肴"],"usage":"作主语、宾语、定语；用于生活等"},{"id":27627,"word":"殊礼异务","pinyin":"shū lǐ yì wù","abbr":"slyw","explanation":"殖、异：不同；礼：礼俗；务：事情。指不同的礼俗和情况。","source":{"text":"帝王者，各殊礼异务，要以成功为统记，岂可绲乎？","book":"《史记·秦楚之际月表》"}},{"id":27628,"word":"殊致同归","pinyin":"shū zhì tóng guī","abbr":"sztg","explanation":"比喻采取不同的方法而得到相同的结果。同“殊涂同归”。","source":{"text":"夫神则阴阳不测，天则欲人迁善。均乎影响，殊致同归。","book":"《隋书·五行志上》"},"similar":["殊途同归","殊涂同致","殊途一致"],"usage":"作谓语、宾语、定语；用于处事"},{"id":27629,"word":"殊行绝才","pinyin":"shū xíng jué cái","abbr":"sxjc","explanation":"殊：特殊；绝：少有的。指才能和德行都很高超，世上少有。","source":{"text":"此六子者皆有殊行绝才，德隆当世。","book":"《后汉书·班固传》"}},{"id":27630,"word":"殊言别语","pinyin":"shū yán bié yǔ","abbr":"syby","explanation":"指方言土语。","source":{"text":"今者音韵虽一致，而殊言别语，终合葆存。","book":"清·章太炎《论汉字统一会》"},"similar":["方言土语"],"usage":"作主语、宾语、定语；指方言"},{"id":27631,"word":"殊路同归","pinyin":"shū lù tóng guī","abbr":"sltg","explanation":"比喻采取不同的方法而得到相同的结果。同“殊涂同归”。","source":{"text":"诸生对册，殊路同归。指在于崇礼义，退财利，复往古之道，匡当世之失。","book":"汉·桓宽《盐铁论·利议》"},"similar":["殊途同归","殊涂同归","同归殊途"],"usage":"作谓语、宾语、定语；用于人生等"},{"id":27632,"word":"殊途同归","pinyin":"shū tú tóng guī","abbr":"sttg","explanation":"通过不同的途径，到达同一个目的地。比喻采取不同的方法而得到相同的结果。","source":{"text":"天下同归而殊途，一致而百虑。","book":"《周易·系辞下》"},"example":{"text":"一道题，往往有几种解法，但～，答案只能有一个。"},"similar":["不约而同","不谋而合","异曲同工"],"opposite":["背道而驰","南辕北辙"],"usage":"作谓语、宾语、定语；用于人生等"},{"id":27633,"word":"残丝断魂","pinyin":"cán sī duàn hún","abbr":"csdh","explanation":"残：剩余的；丝：蚕和其它昆虫吐的丝；断：断绝；魂：魂魄。比喻即将死亡的生命。","source":{"text":"奴身止寥寥发数根，这便是我的残丝断魂。","book":"清·洪昇《长生殿·献发》"},"usage":"作宾语、定语；用于临死"},{"id":27634,"word":"残兵败卒","pinyin":"cán bīng bài zú","abbr":"cbbz","explanation":"残：残余的，不完整的；败：输。战败后剩余的兵卒。指被击溃的军队或势力","source":{"text":"杨铁刀恃着凶勇，保了元太子及些残兵败卒，约有二千余众，向北而驰，被朱亮祖同廖永忠赶上。","book":"明·郭勋《英烈传》第73回"},"similar":["残兵败将"],"usage":"作宾语、定语；用于书面语"},{"id":27635,"word":"残兵败将","pinyin":"cán bīng bài jiàng","abbr":"cbbj","explanation":"残余的军队，失败的将领。形容战败的部队。","source":{"text":"我如今连被岳家军杀败，收聚些残兵败将，济不得事，目下就要拔营回去如何？","book":"明·邵璨《香囊记·败兀》"},"example":{"text":"侯匪又转向那一撮～动员起来。","book":"曲波《林海雪原》三七"},"similar":["散兵游勇","残军败将"],"opposite":["锐不可当"],"usage":"作宾语、定语；用于指被击溃的军队或势力"},{"id":27636,"word":"残军败将","pinyin":"cán jūn bài jiàng","abbr":"cjbj","explanation":"战败后残余的兵将。同“残兵败将”。","source":{"text":"看了我这些残军败将，你都杀了，倒也是个干净。","book":"明·无名氏《开昭救忠》第二折"},"similar":["残兵败将"],"usage":"作宾语、定语；用于指被击溃的军队等"},{"id":27637,"word":"残冬腊月","pinyin":"cán dōng là yuè","abbr":"cdly","explanation":"腊月：阴历十二月。指一年将尽之时。","source":{"text":"错过了吉日良时，残冬腊月，未必有好日了。","book":"明·冯梦龙《醒世恒言·钱秀才错占凤凰俦》"},"example":{"text":"到了～，到处是荒凉的景象。"},"similar":["寒冬腊月"],"opposite":["阳春三月"],"usage":"作宾语、定语；指冬天"},{"id":27638,"word":"残喘待终","pinyin":"cán chuǎn dài zhōng","abbr":"ccdz","explanation":"残喘：仅存的一点喘息；终：死亡。指生命将尽，仅存一点喘息。","source":{"text":"天德弥厚，残喘待终。","book":"唐·陈子昂《为宗舍人谢赠物丧》"}},{"id":27639,"word":"残圭断璧","pinyin":"cán guī duàn bì","abbr":"cgdb","explanation":"残缺不全的圭璧。指虽然残缺却是很珍贵的东西。","source":{"text":"书既刊诸石，此虽仅得三分之一，残圭断璧要自可宝。","book":"宋·楼钥《跋傅梦良所藏山谷书渔父诗》"},"example":{"text":"造意成书，纵言为文，～，千古难群。","book":"元·戴表元《代祭王右军祠堂文》"},"usage":"作宾语、定语；用于残缺物品"},{"id":27640,"word":"残垣断壁","pinyin":"cán yuán duàn bì","abbr":"cydb","explanation":"倒塌了的墙壁，形容残破的景象","example":{"text":"地震后的～已经不复存在了"},"similar":["断壁残垣"],"usage":"作宾语、定语；指残破"},{"id":27641,"word":"残尸败蜕","pinyin":"cán shī bài tuì","abbr":"csbt","explanation":"残：破损的；败：败坏了的；蜕：昆虫脱的皮。残损的尸体，败坏了的躯壳。形容腐烂的骸骨。","source":{"text":"就是果然埋下呵，还只怕这残尸败蜕……","book":"清·洪昇《长生殿·冥追》"}},{"id":27642,"word":"残山剩水","pinyin":"cán shān shèng shuǐ","abbr":"csss","explanation":"指国家领土大都沦陷后残余的部分。也比喻未被消除而剩下来的事物。","source":{"text":"剩水沧江破，残山碣石开。","book":"唐·杜甫《陪郑广文游何将军山林》诗"},"example":{"text":"然而南宋的小朝廷却仍旧在～间的黎民施威，在～间行乐。","book":"鲁迅《且介亭杂文二集·田军作〈八月的乡村〉序》"},"similar":["剩水残山"],"opposite":["大好河山"],"usage":"作宾语、定语；形容沦陷的国土"},{"id":27643,"word":"残年余力","pinyin":"cán nián yú lì","abbr":"cnyl","explanation":"指年老体衰。","source":{"text":"甚矣，汝之不惠，以残年余力，曾不能毁山之一毛。","book":"战国·郑·列御寇《列子·汤问》"},"example":{"text":"我要充分利用这～为社会发挥余热。"},"usage":"作宾语、定语；用于老年人"},{"id":27644,"word":"残年暮景","pinyin":"cán nián mù jǐng","abbr":"cnmj","explanation":"残：衰残。指人到了晚年。","source":{"text":"秦母见叔宝又要出门，眼中流泪道：‘我儿，我残年暮景，喜的是相逢，怕的是别离。’","book":"清·无名氏《说唐》第十回"},"example":{"text":"努力吧，以免～很凄凉。"},"similar":["桑榆暮景","风烛残年"],"usage":"作宾语；指晚年"},{"id":27645,"word":"残忍不仁","pinyin":"cán rěn bù rén","abbr":"crbr","explanation":"残忍：凶暴；仁：仁爱。凶恶暴虐不讲仁义。","source":{"text":"卓性残忍不仁，遂以严刑胁众。","book":"晋·陈寿《三国志·魏志·董卓传》"},"similar":["残虐不仁"],"usage":"作谓语、定语；用于为人"},{"id":27646,"word":"残暴不仁","pinyin":"cán bào bù rén","abbr":"cbbr","explanation":"凶狠毒辣，一点也没有同情、怜悯之心。","source":{"text":"卓性残不仁，遂以严刑胁应。","book":"《三国志·魏志·董卓传》"},"example":{"text":"韩玄～，轻贤慢士，当众共殛之！","book":"明·罗贯中《三国演义》第五十三回"},"similar":["残忍不仁"],"usage":"作谓语、定语；指人很残酷"},{"id":27647,"word":"残杯冷炙","pinyin":"cán bēi lěng zhì","abbr":"cblz","explanation":"残：剩余；杯：指酒；炙：烤肉。指吃剩的饭菜。也比喻别人施舍的东西。","source":{"text":"不可令有称誉，见役勋贵，处之下坐，以取残杯冷炙之辱。","book":"北齐·颜之推《颜氏家训·杂艺》"},"example":{"text":"尘风薄雪，～，掩青灯我竹篱茅舍。","book":"元·乔吉《卖花声·悟世》"},"similar":["残羹冷炙"],"opposite":["山珍海味"],"usage":"作主语、宾语、定语；指残剩的酒肉","story":["北齐文学家颜之推学识渊博，他作书《颜氏家训》，宣扬儒家思想为立身之道，他认为不要因为有点称赞就去受权贵的驱使，地位低下受到权贵施舍残杯冷炙的屈辱，而权贵并不会给你一官半职，相反只会沦为权贵娱乐的工具"]},{"id":27648,"word":"残槃冷炙","pinyin":"cán pán lěng zhì","abbr":"cplz","explanation":"冷炙：已经凉了的烤肉。指残剩的饭菜。也指权贵施舍的东西。","source":{"text":"王光禄曰：‘正得残槃冷炙。’","book":"《郭子》"},"similar":["残杯冷炙","余杯冷炙"],"usage":"作主语、宾语、定语；指残剩的场面"},{"id":27649,"word":"残民以逞","pinyin":"cán mín yǐ chěng","abbr":"cmyc","explanation":"残：残害；逞：称愿，满足某种心愿。残害人民，来实现某种愿望，使自己称心如意。","source":{"text":"《诗》所谓‘人之无良’者，其羊斟之谓乎！残民以逞。","book":"《左传·宣公二年》"},"usage":"作谓语、定语；指害人民"},{"id":27650,"word":"残民害物","pinyin":"cán mín hài wù","abbr":"cmhw","explanation":"摧残百姓，损害财物。","source":{"text":"州以趣办财赋为急，县有残民害物之罪，而吏不敢问。","book":"宋·辛弃疾《淳熙己亥论盗贼札子》"},"example":{"text":"而上之所用者，莫非～之人矣。","book":"清·黄宗羲《诸敬槐先生八十寿序》"},"similar":["病民害物"],"usage":"作谓语；指摧残民众干坏事"},{"id":27651,"word":"残民害理","pinyin":"cán mín hài lǐ","abbr":"cmhl","explanation":"残害百姓，违背天理。形容反动统治者所作所为的残忍不义。","source":{"text":"州以趣办财赋为急，县有残民害物之罪，而吏不敢问。","book":"宋·辛弃疾《淳熙己亥论盗贼札子》"},"usage":"作谓语、定语；用于干坏事"},{"id":27652,"word":"残汤冷饭","pinyin":"cán tāng lěng fàn","abbr":"ctlf","explanation":"残：剩下。残剩下来的汤水和饭菜。","source":{"text":"两个自吃了一回，剩下些残汤冷饭，与卢俊义吃了。","book":"明·施耐庵《水浒传》第62回"},"similar":["残羹冷炙","残茶剩饭"],"usage":"作宾语、定语；形容吃剩的食物"},{"id":27653,"word":"残汤剩水","pinyin":"cán tāng shèng shuǐ","abbr":"ctss","explanation":"指残剩下来的汤水与食物。","source":{"text":"他瞧见乙类盆的底子上还有一点残汤剩水。","book":"路遥《平凡的世界》第一卷第一章"},"similar":["残羹冷炙","残茶剩饭"],"usage":"作宾语、定语；形容残剩的茶饭"},{"id":27654,"word":"残汤剩饭","pinyin":"cán tāng shèng fàn","abbr":"ctsf","explanation":"残：剩下的。吃剩下的汤水饭食。","source":{"text":"我三个孩儿都下在死囚牢中，我叫化了些残汤剩饭，送与孩儿每吃去。","book":"无·关汉卿《蝴蝶梦》第三折"},"example":{"text":"我乞讨～，犹如狗之向人讨骨头。","book":"巴金《光明集·狗》"},"similar":["残羹冷饭"],"opposite":["山珍海味"],"usage":"作主语、宾语、定语；形容吃剩的食物"},{"id":27655,"word":"残渣余孽","pinyin":"cán zhā yú niè","abbr":"czyn","explanation":"比喻在消灭或淘汰过程中残存下来的坏人。孽，邪恶的东西。","source":{"text":"由于不少奴隶主残渣余孽被集中于南阳，故而南阳之俗是‘夸奢、上气力、为商贾’，成为一个‘难制御’的地方。","book":"《历史研究》1976年第3期"},"example":{"text":"社会上的～时刻在危害社会。"},"similar":["残兵败将","漏网之鱼"],"opposite":["百里挑一","德才兼备"],"usage":"作宾语、定语；指坏人"},{"id":27656,"word":"残灯末庙","pinyin":"cán dēng mò miào","abbr":"cdmm","explanation":"快要熄灭的灯，将要结束的庙会。比喻事情已经衰落，接近完结。"},{"id":27657,"word":"残章断简","pinyin":"cán zhāng duàn jiǎn","abbr":"czdj","explanation":"指残缺不全的书籍或零散不整的诗文字画。编，用来穿联竹简的皮条或绳子。简，竹简，古代用来书写的竹片。同“断编残简”。","source":{"text":"秦汉晋唐以降金石刻，歌诗赋咏，残章断简，靡有遗者。","book":"宋·陆游《会稽志序》"},"similar":["残编断简"],"usage":"作宾语、定语；指残缺不全的书籍"},{"id":27658,"word":"残篇断简","pinyin":"cán piān duàn jiǎn","abbr":"cpdj","explanation":"残缺不全的书籍。","source":{"text":"某本乏财用，无多作述……至如残编落简，并入尘埃；赤轴青箱，多从灰烬。","book":"北周·庚信《谢滕王集序启》"},"similar":["残编断简"],"usage":"作宾语、定语；指残缺不全的书籍"},{"id":27659,"word":"残编断简","pinyin":"cán biān duàn jiǎn","abbr":"cbdj","explanation":"指残缺不全的书籍。编，用来穿联竹简的皮条或绳子。简，竹简，古代用来书写的竹片。","source":{"text":"北周·庚信《谢滕王集序启》：“某本乏财用，无多作述……至如残编落简，并入尘埃；赤轴青箱，多从灰烬。"},"example":{"text":"那军警执着火炬，照耀如同白昼，忽到这处，忽到那处，目光灼灼，东张西望，最注意的是片红只字，～。","book":"《民国演义》第五十回"},"similar":["断编残简"],"usage":"作宾语、定语；指残缺不全的书籍"},{"id":27660,"word":"残编裂简","pinyin":"cán biān liè jiǎn","abbr":"cblj","explanation":"指残缺不全的书籍或零散不整的诗文字画。","source":{"text":"古书历世兵革洊更，间有残编裂简，仅以空名，寓于载籍。辑录之家，存而不论。","book":"明·胡应麟《少室山房笔丛·经籍会通三》"},"similar":["残编断简"],"usage":"作宾语、定语；指残缺不全的书籍"},{"id":27661,"word":"残缺不全","pinyin":"cán quē bù quán","abbr":"cqbq","explanation":"残：残破；缺：缺少；全：完整。残破、缺少，很不完全。","source":{"text":"这些特点是事实上存在的，不是虚造骗人的；是战争的全部基本要素，不是残缺不全的片段。","book":"毛泽东《论持久战》"},"example":{"text":"教室里只剩下～的几张课桌了。"},"similar":["支离破碎","残缺不齐"],"opposite":["完好无损"],"usage":"作谓语、定语；形容事物不完整"},{"id":27662,"word":"残羹冷炙","pinyin":"cán gēng lěng zhì","abbr":"cglz","explanation":"指吃剩的饭菜。也比喻别人施舍的东西。","source":{"text":"残杯与冷炙，到处潜悲辛。","book":"唐·杜甫《奉赠韦左丞丈》"},"example":{"text":"做人不可攀结权贵，靠人施舍，以受～之辱。"},"similar":["残羹剩饭","残羹剩汁","残茶剩饭"],"opposite":["山珍海味","水陆俱陈"],"usage":"作宾语、定语；形容吃剩的食物","story":["北齐文学家颜之推学识渊博，他作书《颜氏家训》，宣扬儒家思想为立身之道，他认为不要因为有点称赞就去受权贵的驱使，地位低下受到权贵施舍残杯冷炙的屈辱，而权贵并不会给你一官半职，相反只会沦为权贵娱乐的工具"]},{"id":27663,"word":"残羹冷饭","pinyin":"cán gēng lěng fàn","abbr":"cglf","explanation":"指吃剩的饭菜。也比喻别人施舍的东西。","source":{"text":"清晨采薪日入归，残羹冷饭难充饥。","book":"明·刘基《孤儿行》"},"similar":["残汤剩饭","残羹冷炙"],"usage":"作主语、宾语、定语；形容吃剩的食物"},{"id":27664,"word":"残羹剩饭","pinyin":"cán gēng shèng fàn","abbr":"cgsf","explanation":"吃剩的饭菜，比喻别人取用后剩下的一点儿东西。","source":{"text":"公寓里只剩下许立宇一个人和一大桌杯盘狼藉的残羹剩饭。","book":"王朔《许爷》"},"example":{"text":"他给小狗喂一些～。"},"similar":["残茶剩饭"],"opposite":["山珍海味"],"usage":"作宾语、定语；指吃剩的饭菜"},{"id":27665,"word":"残膏剩馥","pinyin":"cán gāo shèng fù","abbr":"cgsf","explanation":"残：剩余；膏：油脂；馥：香气。比喻前人留下的文学遗产。","source":{"text":"唐诗人杜甫，浑涵汪茫，千汇万状，兼古今而有之。他人不足，甫乃厌余，残膏剩馥，沾丐后人多矣。","book":"《新唐书·杜甫传赞》"},"example":{"text":"君之文非不如人，今彼籍吾～者，取青紫如捡荠。","book":"明·宋廉《梅府君墓志铭》"},"similar":["余膏剩馥"],"usage":"作宾语；比喻前人留下的文学遗产"},{"id":27666,"word":"残花败柳","pinyin":"cán huā bài liǔ","abbr":"chbl","explanation":"败：衰败。残：凋残。凋残的柳树，残败了的花。旧时用以比喻生活放荡或被蹂躏遗弃的女子。","source":{"text":"休把似残花败柳冤仇结，我与你生男长女填还彻，指望生则同衾，死则共穴。","book":"元·白朴《墙头马上》三折"},"example":{"text":"我是个嫩蕊娇花，不比那～。","book":"明·无名氏《女贞观》第二折"},"similar":["半老徐娘","败柳残花"],"opposite":["金枝玉叶"],"usage":"作宾语、定语；指被摧残的女人"},{"id":27667,"word":"残茶剩饭","pinyin":"cán chá shèng fàn","abbr":"ccsf","explanation":"残留下的一点茶水，剩下来的一点食物。","source":{"text":"如今天色晚了也，有甚么残茶剩饭，与俺两个孩子些吃。","book":"元·马致远《黄梁梦》第四折"},"example":{"text":"他经常吃的是～。"},"similar":["残羹冷炙","残汤剩水"],"opposite":["山珍海味"],"usage":"作宾语、定语；形容残剩的茶饭"},{"id":27668,"word":"残虐不仁","pinyin":"cán nüè bù rén","abbr":"cnbr","explanation":"残：凶狠；虐：残暴。凶恶暴虐，不讲仁义。","source":{"text":"卓性残忍不仁，遂以严刑胁众。","book":"《三国志·魏志·董卓传》"},"example":{"text":"再说那山东鲁王刘豫守在山东，～，诈害良民，也非止一端。","book":"清·钱彩《说岳全传》第三十二回"},"similar":["残忍不仁"],"usage":"作谓语、定语；用于为人"},{"id":27669,"word":"残贤害善","pinyin":"cán xián hài shàn","abbr":"cxhs","explanation":"残：残害；贤：有才德的人。残害有才德善良的人。","source":{"text":"而操遂承资跋扈，恣行凶忒，割剥元元，残贤害善。","book":"明·罗贯中《三国演义》第22回"},"usage":"作谓语、宾语、定语；用于坏人"},{"id":27670,"word":"残酷无情","pinyin":"cán kù wú qíng","abbr":"ckwq","explanation":"残：凶狠。残暴、冷酷，毫无人情。","source":{"text":"命运如此残酷无情，是不是在报应她曾偷过那几块手帕？","book":"路遥《平凡的世界》第四卷第39章"},"example":{"text":"王朔《千万别把我当人》：“你要学习岳元帅，对同志春天般的温暖，对敌人严冬一样～。”"},"similar":["冷酷无情"],"usage":"作谓语、定语、状语；用于口语"},{"id":27671,"word":"殒身不恤","pinyin":"yǔn shēn bú xù","abbr":"ysbx","explanation":"殒：牺牲；恤：顾惜。牺牲生命也不顾惜。","source":{"text":"至于这一回……虽殒身不恤的事实，则更足为中国女子的勇毅没有消亡的明证。","book":"鲁迅《记念刘和珍君》"},"similar":["慷慨捐生","慷慨赴义"],"opposite":["贪生怕死"],"usage":"作定语；指捐躯"},{"id":27672,"word":"殒身碎首","pinyin":"yǔn shēn suì shǒu","abbr":"ysss","explanation":"犹粉身碎骨。","source":{"text":"臣愚驽垢秽，才质疵下，过受陛下日月之恩，不能摧身碎首，以答陛下厚德。","book":"三国·魏·曹植《谢封甄城王表》"},"example":{"text":"烦冤荼毒，心肝似麋，比者待罪幽囚，以～为奉。","book":"唐·陈子昂《为程处弼辞放流表》"},"similar":["陨身糜骨","粉身碎骨"],"usage":"作谓语、状语；用于书面语"},{"id":27673,"word":"殚心积虑","pinyin":"dān xīn jī lǜ","abbr":"dxjl","explanation":"殚：竭尽；积：聚；虑：思虑。竭尽心力思考谋划。","source":{"text":"必至殚心积虑者数十年，捐去三纲五常，绝去七情六欲，费其半菽如失金珠，拔其一毛有关痛痒。","book":"清·钱泳《履园丛话·臆伦·五福》"},"similar":["殚心竭虑"],"usage":"作谓语、定语；形容用尽心思"},{"id":27674,"word":"殚心竭虑","pinyin":"dān xīn jié lǜ","abbr":"dxjl","explanation":"殚：竭尽；虑：思虑。竭尽心力思考谋划。","source":{"text":"二十六年，京察，以殚心竭虑坐镇海疆。","book":"《清史稿·耆英传》"},"similar":["殚思极虑","殚精竭虑"],"usage":"作谓语、定语；形容用尽心思"},{"id":27675,"word":"殚思极虑","pinyin":"dān sī jí lǜ","abbr":"dsjl","explanation":"殚：竭尽；虑：思虑。形容用尽心思。","source":{"text":"殚思极虑，以尽微臣献言之道乎！","book":"唐·白居易《策林一·策头》"},"example":{"text":"阎敬铭亲自主持会议，～，拟成开源之策十二条。","book":"高阳《母子君臣》第八十一回"},"similar":["殚精竭虑","处心积虑"],"usage":"作谓语、定语；形容用尽心思"},{"id":27676,"word":"殚智竭力","pinyin":"dān zhì jié lì","abbr":"dzjl","explanation":"殚：竭尽。用尽智慧和力量。","source":{"text":"《吕氏春秋·本味》“相为殚智竭力，犯危行苦。”"},"example":{"text":"～求得这种“最大的贡献”，这是人人对于自己、对于社会应负的责任。","book":"邹韬奋《经历·前途》"},"similar":["殚智尽力"],"usage":"作谓语、定语；指尽心尽力"},{"id":27677,"word":"殚精极思","pinyin":"dān jīng jí sī","abbr":"djjs","explanation":"殚：竭尽。竭尽心力思虑谋划。","source":{"text":"其中典礼集会之词，标新立异固不同，机械陈腐亦不可，每殚精极思，广事征引，而学识肤浅，语焉不畅。","book":"朱自清《钟明序》"},"similar":["殚精极虑","殚精毕思"],"usage":"作谓语、宾语；用于思考"},{"id":27678,"word":"殚精极虑","pinyin":"dān jīng jí lǜ","abbr":"djjl","explanation":"犹殚思极虑。竭尽智谋与精力。","source":{"text":"训诰典谟，圣人岂殚精极虑作意而为之者哉。","book":"明·张居正《翰林院读书说》"},"similar":["殚精极思"],"usage":"作谓语、宾语；用于思考"},{"id":27679,"word":"殚精毕力","pinyin":"dān jīng bì lì","abbr":"djbl","explanation":"殚、毕：尽。尽心竭力。","source":{"text":"甲辰下第，然后揣己力量，复寻前辙，昼作夜思，殚精毕力，幸而艺成。","book":"明·张居正《示季子懋修》"},"example":{"text":"俾天下知功名之路，相率研求，～，以备干城之用。","book":"清·薛福成《应诏陈言疏》"},"similar":["尽心尽力"],"usage":"作谓语、定语、状语；指尽心尽力"},{"id":27680,"word":"殚精毕思","pinyin":"dān jīng bì sī","abbr":"djbs","explanation":"殚：竭尽；思：思考。竭尽心力思虑谋划。","source":{"text":"臣敢不殚精毕思，用效驽钝。","book":"《清史稿·宁完我传》"},"similar":["殚精极思"],"usage":"作谓语、宾语；用于思考"},{"id":27681,"word":"殚精竭力","pinyin":"dān jīng jié lì","abbr":"djjl","explanation":"犹殚精毕力。尽心竭力。","source":{"text":"而其叙致周折，语意神奇处，更千百年大匠国工，殚精竭力不能恍惚。","book":"明·胡应麟《诗薮·古体中》"},"similar":["殚精毕力","尽心尽力"],"usage":"作谓语、定语、状语；指尽心尽力"},{"id":27682,"word":"殚精竭思","pinyin":"dān jīng jié sī","abbr":"djjs","explanation":"殚：竭尽；思：思考。竭尽心力思虑谋划。","source":{"text":"有志于文章者，将殚精竭思于此乎？","book":"清·刘开《与阮芸台宫保论文书》"},"example":{"text":"吾以为火器之穷，人人～而无所进。","book":"章炳麟《弭兵难》"},"similar":["殚精毕思","殚思极虑"],"usage":"作谓语、宾语；用于思考"},{"id":27683,"word":"殚精竭虑","pinyin":"dān jīng jié lǜ","abbr":"djjl","explanation":"殚：竭尽；虑：思虑。形容用尽心思。","source":{"text":"殚思极虑，以尽微臣献言之道乎！","book":"唐·白居易《策林一·策头》"},"example":{"text":"但这“～用苦功夫去认真创作”出来的学说，和我们只有常识的见解是很不一样的。","book":"鲁迅《花边文学·商贾的批评》"},"similar":["费尽心机","煞费苦心","处心积虑"],"opposite":["敷衍塞责"],"usage":"作谓语、状语；多用于书面语"},{"id":27684,"word":"殚见洽闻","pinyin":"dān jiàn qià wén","abbr":"djqw","explanation":"殚：尽，完全；洽：广博。该见的都见过了，该听的都听过了。形容见多识广，知识渊博。","source":{"text":"元元本本，殚见洽闻。","book":"汉·班固《西都赋》"},"example":{"text":"～，非后儒所能及矣。","book":"清·陈澧《东塾读书记·礼记》"},"similar":["见多识广"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；指见多识广"},{"id":27685,"word":"殚诚毕虑","pinyin":"dān chéng bì lǜ","abbr":"dcbl","explanation":"指竭尽忠诚与思虑。","source":{"text":"不预外事，殚诚毕虑以事上。","book":"《清史稿·后妃传·太祖高皇后》"},"usage":"作谓语、状语；用于处事"},{"id":27686,"word":"殚谋戮力","pinyin":"dān móu lù lì","abbr":"dmll","explanation":"竭尽智谋和精力。","source":{"text":"诚意伯刘基……同徐达、汤和辈殚谋戮力，奉翊我太祖高皇帝，削平海内，奄有中原。","book":"《诚意伯文集·赠谥太师文成诰》附《礼部会议》"},"usage":"作谓语、状语；用于处事"},{"id":27687,"word":"殚财竭力","pinyin":"dān cái jié lì","abbr":"dcjl","explanation":"殚、竭：尽。用尽所有的财力和人力。形容竭尽全力。","source":{"text":"粤若殚财竭力，刻桷雕题，积四三年，模造化意。","book":"唐·李邕《海州大云寺禅院碑》"},"similar":["劳民伤财"],"usage":"作谓语、定语；指用完钱财与人力"},{"id":27688,"word":"殢云尤雨","pinyin":"tì yún yóu yǔ","abbr":"tyyy","explanation":"比喻男女之间的缠绵欢爱。","source":{"text":"殢云尤雨，有万般千种，相怜相惜。","book":"宋·柳永《浪淘沙·梦觉》词"},"similar":["殢雨尤云"],"usage":"作定语；指男女情爱"},{"id":27689,"word":"殢雨尤云","pinyin":"tì yǔ yóu yún","abbr":"tyyy","explanation":"比喻男女之间的缠绵欢爱。同“殢云尤雨”。","source":{"text":"拖泥带水两情痴，殢雨尤云都不辩。","book":"明·无名氏《桃符记》第四折：“门东娘殢雨尤云，缠搅定良家子弟。”明·兰陵笑笑生《金瓶梅词话》第二十九回"},"example":{"text":"更初，果至宗斋。～，备极亲爱。","book":"清·蒲松龄《聊斋志异·荷花三娘子》"},"similar":["尤云殢雨","殢雨尤云"],"usage":"作宾语、定语；用于比喻句"},{"id":27690,"word":"殴公骂婆","pinyin":"ōu gōng mà pó","abbr":"ogmp","explanation":"殴：殴打。指泼妇殴打辱骂公婆。","source":{"text":"偏他至不贤惠，殴公骂婆，打邻毁舍，降汉子，比凡人不同。","book":"清·西周生《醒世姻缘传》第89回"},"example":{"text":"清·西周生《醒世姻缘传》第89回：“偏他至不贤惠，殴公骂婆，打邻毁舍，降汉子，比凡人不同。”"},"usage":"作谓语、宾语、定语；用于泼妇对待公婆"},{"id":27691,"word":"殷天动地","pinyin":"yǐn tiān dòng dì","abbr":"ytdd","explanation":"殷：震动。震天动地，形容声音很大。","source":{"text":"车骑雷起，殷天动地。","book":"汉·司马相如《上林赋》"},"similar":["殷天震地","惊天动地"],"usage":"作谓语、定语；指惊天动地"},{"id":27692,"word":"殷天蔽日","pinyin":"yīn tiān bì rì","abbr":"ytbr","explanation":"染红了天，遮住了太阳。形容仪从之盛。","source":{"text":"段颖起于徒中，为并州刺史，有功，后徵还京师，颖乘轻车，介士鼓吹，曲盖朱旗骑马，殷天蔽日，连骑相继数十里。","book":"《艺文类聚》卷五十"},"usage":"作谓语、定语；指场面盛大"},{"id":27693,"word":"殷天震地","pinyin":"yǐn tiān zhèn dì","abbr":"ytzd","explanation":"殷：震动。震动天地。形容震动极大。","source":{"text":"车骑雷起，殷天动地。","book":"汉·司马相如《上林赋》"},"similar":["殷天动地","惊天动地"],"usage":"作谓语、定语；指惊天动地"},{"id":27694,"word":"殷忧启圣","pinyin":"yīn yōu qǐ shèng","abbr":"yyqs","explanation":"殷：深。深切的忧患能启发圣明。","source":{"text":"或多难以固邦国，或殷忧以启圣明。","book":"晋·刘琨《劝进表》"},"example":{"text":"古有多难兴国，～，盖事危则志锐，情苦则虑深，故能转祸为福也。","book":"《新唐书·张廷珪》"},"usage":"作宾语、定语；用于书面语"},{"id":27695,"word":"殷殷勤勤","pinyin":"yīn yīn qín qín","abbr":"yyqq","explanation":"殷殷：恳切的样子。热情而周到的样子。","source":{"text":"又送酒肴内房中去，殷殷勤勤，自不必说。","book":"明·凌濛初《初刻拍案惊奇》第18卷"},"example":{"text":"～叙过了寒温，说了些闲话儿。","book":"清·曹雪芹《红楼梦》第十回"},"usage":"作谓语、状语、定语；形容人的态度"},{"id":27696,"word":"殷殷垂念","pinyin":"yīn yīn chuí niàn","abbr":"yycn","explanation":"殷殷：殷切，诚恳；垂念：挂念。非常殷切地挂念着。"},{"id":27697,"word":"殷殷屯屯","pinyin":"yīn yīn tún tún","abbr":"yytt","explanation":"殷殷：众多的样子；屯屯：富足的样子。人口众多，财物充足。","source":{"text":"文、景之际，建元之始，民朴而归本，吏廉而自重，殷殷屯屯，人衍而家富。","book":"汉·桓宽《盐铁论·国疾》"},"similar":["繁荣兴旺"],"usage":"作谓语、定语；繁荣兴旺的样子"},{"id":27698,"word":"殷殷田田","pinyin":"yīn yīn tián tián","abbr":"yytt","explanation":"形容声音宏大。","source":{"text":"妇人不宜袒，故发胸，击心，爵踊，殷殷田田，如坏墙然，悲哀痛疾之至也。","book":"《礼记·问丧》"},"example":{"text":"清·袁枚《新齐谐·夏太史说三事》：“是夜，阅卷灯下，闻哭声自西来，～，群响杂沓。”"},"usage":"作定语、状语；用于书面语"},{"id":27699,"word":"殷民阜利","pinyin":"yīn mín fù lì","abbr":"ymfl","explanation":"殷、阜：盛富。百姓殷实，财物富足。","source":{"text":"君人者，务在殷民阜财，明道信义。","book":"汉·扬雄《法言·孝至》"},"similar":["殷民阜财","民殷财阜"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":27700,"word":"殷民阜财","pinyin":"yīn mín fù cái","abbr":"ymfc","explanation":"殷：富足。阜：多，盛；丰富。使百姓富足，使财物丰富。亦作“民殷财阜”、“殷民阜利”。","source":{"text":"君人者务在殷民阜财，明道信义。","book":"汉·扬雄《法言·孝至》"},"similar":["殷民阜利"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":27701,"word":"殷浩书空","pinyin":"yīn hào shū kōng","abbr":"yhsk","explanation":"借指事情令人惊奇诧异。","source":{"text":"殷中军（殷浩）被废在信安，终日恒书空作字，扬州吏民寻义逐之，窃视，唯作‘咄咄怪事’四字而已。","book":"南朝·宋·刘义庆《世说新语·黜免》"},"example":{"text":"流水不鸣而似鸣，高山是寂而非寂。坐客别去者，皆作～，谓咄咄怪事无有过此者矣。","book":"清·李渔《闲情偶寄·居室·墙壁》"},"usage":"作宾语、定语；用于书面语","story":["东晋扬州刺史殷浩与大将桓温不合，王羲之劝他大敌当前应以国事为重，殷浩不但不听，领兵北伐，屡战屡败，被废为平民，流放到信安，他整天无忧无虑地读书吟诗，老是在纸上写“咄咄怪事”四个字来表示心中的不平"]},{"id":27702,"word":"殷鉴不远","pinyin":"yīn jiàn bù yuǎn","abbr":"yjby","explanation":"殷：指商朝后期；鉴：镜子。指殷商子孙应以夏的灭亡为借戒。后泛指前人的教训就在眼前。","source":{"text":"殷鉴不远，在夏后之世。","book":"《诗经·大雅·荡》"},"example":{"text":"宋与金的历史，对崇桢说来，～，而他绝不愿在臣民心目和后代史书中被看成是懦弱无能的君主。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["引以为戒"],"opposite":["重蹈覆辙"],"usage":"作谓语、定语；泛指前人的教训就在眼前","story":["商朝末期，商纣王昏庸无能，对内残暴统治，社会十分腐败。西方诸侯之长的“西伯”周文王曾怀着一片好心，提出诚恳的劝告：殷商的教训不必向远处去找，就在夏桀那一代。商纣王没有接纳，终于被周武王所灭"]},{"id":27703,"word":"殿堂楼阁","pinyin":"diàn táng lóu gé","abbr":"dtlg","explanation":"楼阁：两层以上的房屋。指各种建筑物。殿堂：高大的房屋。","source":{"text":"在山上的参天古木中，林立着一百多座殿堂搂阁和亭台桥榭。","book":"《晋祠》"},"similar":["楼堂馆所"],"usage":"作主语、宾语、定语；用于建筑等"},{"id":27704,"word":"毁不危身","pinyin":"huǐ bù wēi shēn","abbr":"hbws","explanation":"儒家丧制。指居丧哀毁，但不应因此丧生。同“毁不灭性”。","source":{"text":"丧不虑居，毁不危身。丧不虑居，为无庙也；毁不危身，为无后也。","book":"《礼记·檀弓下》"},"similar":["毁不灭性"],"usage":"作宾语、定语；用于服丧等场合"},{"id":27705,"word":"毁不灭性","pinyin":"huǐ bù miè xìng","abbr":"hbmx","explanation":"毁：旧指居丧过于哀痛。指不能过分悲伤而失去本性。","source":{"text":"三日而食，教民无以死伤生。毁不灭性，此圣人之政也。","book":"《孝经·丧亲》"},"example":{"text":"～，圣人之制。","book":"《梁书·昭明太子传》"},"similar":["毁不危身"],"usage":"作宾语、定语；用于服丧等场合"},{"id":27706,"word":"毁于一旦","pinyin":"huǐ yú yī dàn","abbr":"hyyd","explanation":"于：在；一旦：一天。在一天的功夫全被毁掉。多指长期劳动的成果一下子被毁掉。","source":{"text":"百年累之，一朝毁之。","book":"《后汉书·窦融传》"},"example":{"text":"百余年辛苦经营的圆明园，～，更是令人椎心泣血的莫大恨事。","book":"高阳《清宫外史》下册"},"similar":["付之东流"],"opposite":["坚不可摧"],"usage":"作谓语、宾语；指一下子被毁掉"},{"id":27707,"word":"毁冠裂裳","pinyin":"huǐ guān liè cháng","abbr":"hglc","explanation":"毁坏帽子和衣裳。用作表示彻底决裂的意思。","source":{"text":"《后汉书·周燮传》：[冯良]耻在厮役，因坏车杀马，毁冠裂裳，乃遁至犍为，从杜抚学。”"},"example":{"text":"譬如有一批人是为要拥护中国的旧礼教、旧道德，以为新文字运动是～的叛逆。","book":"郭沫若《今日新文字运动所应取的路向》"},"usage":"作谓语、定语、宾语；用于比喻句"},{"id":27708,"word":"毁宗夷族","pinyin":"huǐ zōng yí zú","abbr":"hzyz","explanation":"把同宗簇的人都杀死。","source":{"text":"方臣所荷未足为泰，岂臣蒙垢含吝所宜忝，窃非臣毁宗夷族所能上报。","book":"晋·陆机《谢平原内史表》"},"usage":"作谓语、定语；用于书面语"},{"id":27709,"word":"毁家纾国","pinyin":"huǐ jiā shū guó","abbr":"hjsg","explanation":"毁：破坏，毁坏；纾：缓和，解除。捐献所有家产，帮助国家减轻困难。","source":{"text":"斗穀于菟为令尹，自毁其家以纾楚国之难。","book":"《左传·庄公三十年》"},"example":{"text":"夫～，大臣之有事，急病让夷，君子之所贵。","book":"清·钱谦益《清文华殿中书房办事大理寺右寺副汪镳授儒林郎》"},"similar":["毁家纾难"],"usage":"作谓语、宾语；指大公无私"},{"id":27710,"word":"毁家纾难","pinyin":"huǐ jiā shū nàn","abbr":"hjsn","explanation":"毁：破坏，毁坏；纾：缓和，解除。捐献所有家产，帮助国家减轻困难。","source":{"text":"斗穀于菟为令尹，自毁其家以纾楚国之难。","book":"《左传·庄公三十年》"},"example":{"text":"某等愿从众志，～，兴复宋室。","book":"清·吴趼人《痛史》第二十五回"},"similar":["精忠报国","舍身为国"],"opposite":["损公肥私","自私自利"],"usage":"作谓语、宾语；指大公无私","story":["公元前665年，楚国令尹子元率军攻打郑国，撤军后就住在王宫，意欲霸占已死楚文王的妻子。楚国的大臣用计除掉子元，让斗谷於菟担任令尹。斗谷於菟看到国家贫弱，就把自己的家产全部拿出来救助国家"]},{"id":27711,"word":"毁廉蔑耻","pinyin":"huǐ lián miè chǐ","abbr":"hlmc","explanation":"指不顾廉耻。","source":{"text":"于是处士以不仕为高，恒人以得位为宜；而仕者之势不尊，威不行，而令不信于下，知不为众之所与也，则益不自重，而为毁廉蔑收之行。","book":"明·方孝儒《官政》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":27712,"word":"毁形灭性","pinyin":"huǐ xíng miè xìng","abbr":"hxmx","explanation":"损坏形体，消灭本性。","source":{"text":"通天大圣，你本是毁形灭性的，老僧救了你，今次休起凡心。我与你一个法名，是孙悟空。","book":"元·杨景贤《西游记》第九折"},"example":{"text":"此时乘隙行事，唾手而得，何苦～，以求济其事乎？","book":"明·冯梦龙《东周列国志》第八十四回"},"usage":"作谓语、宾语、定语；用于事情"},{"id":27713,"word":"毁方投圆","pinyin":"huǐ fāng tóu yuán","abbr":"hfty","explanation":"比喻抛弃立身行事的准则，迎合世俗。","source":{"text":"毁方投圆，面从响应者，谓之绝伦之秀。","book":"《抱朴子·汉过》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":27714,"word":"毁方瓦合","pinyin":"huǐ fāng wǎ hé","abbr":"hfwh","explanation":"毁去棱角，与瓦砾相合。比喻屈己从众，君子为道不远离于人。后指毁弃自己的原则，迎合世俗。","source":{"text":"去己之大圭角，下与众人小合也。","book":"语出《礼记·儒行》：“慕贤而容众，毁方而瓦合，其宽裕有如此者。”郑玄注"},"example":{"text":"故《儒行》欲～，《老子》欲和光同尘。","book":"宋·俞文豹《吹剑录》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":27715,"word":"毁瓦画墁","pinyin":"huǐ wǎ huà màn","abbr":"hwhm","explanation":"打碎屋瓦，涂灭已画好的田地界线。比喻一种无益不害的行为。","source":{"text":"孟子言人但破碎瓦，画地则复墁灭之，此无用之为也，然而其意反欲求食，则子食乎？","book":"《孟子·滕文公下》：“[孟子]曰：‘有人于此，毁瓦画墁，其志将以求食也，则子食之乎？’”赵岐注"},"example":{"text":"将其藉兹遣日，如～者所为耶？","book":"章炳麟《五无论》"},"usage":"作宾语、定语；用于比喻句"},{"id":27716,"word":"毁舟为杕","pinyin":"huǐ zhōu wéi duò","abbr":"hzwd","explanation":"杕，通“舵”。将船改成舵。毁大物为小物，比喻随心所欲的不当行为。","source":{"text":"心所说，毁舟为杕；心所欲，毁钟为铎。","book":"《淮南子·说林训》"},"similar":["毁钟为铎"],"usage":"作宾语、定语；用于处事"},{"id":27717,"word":"毁节求生","pinyin":"huǐ jié qiú shēng","abbr":"hjqs","explanation":"毁节：抛弃自己的气节，变节。指败坏自己的操行和名声，苟且偷生。","source":{"text":"吾闻良将不怯死以苟免，烈士不毁节以求生。","book":"《三国志·魏志·庞德传》"}},{"id":27718,"word":"毁誉不一","pinyin":"huǐ yù bù yī","abbr":"hyby","explanation":"毁誉：诋毁和称赞；不一：不一样，不一致。有人说好，有人说坏，说法不一。","source":{"text":"外臣毁誉不一，俱着各自据实奏闻。","book":"清·名教中人《好逑传》第十七回"},"similar":["毁誉相半","毁誉参半"],"usage":"作谓语、定语；用于处事"},{"id":27719,"word":"毁誉参半","pinyin":"huǐ yù cān bàn","abbr":"hycb","explanation":"说坏话的和说好话的各占一半。表示对人的评价没有一致的意见。","source":{"text":"而商君荆公，为世诟病，以迄今日。管子亦毁誉参半。","book":"清·梁启超《管子传·自序》"},"example":{"text":"正常的现象是～。这个～……会争出一个对作品既不偏高，也不偏低的恰好评价。茅盾《温故以知新》）"},"similar":["毁誉相半"],"usage":"作宾语、定语；指对人的评价无一致的意见"},{"id":27720,"word":"毁车杀马","pinyin":"huǐ chē shā mǎ","abbr":"hcsm","explanation":"废弃车马。喻归隐意志坚决。","source":{"text":"元晦虽有毁车杀马之说，然势恐不容不一出也。","book":"宋·陆游《谢曾侍郎启》：“毁车杀马，逝从此以径归；卖剑买牛，分余生之永已。”宋·陆九渊《与陈倅书》"},"example":{"text":"宋·陆游《谢曾侍郎启》：“～，逝从此以经归；卖剑买牛，分余生之永己。”"},"similar":["杀马毁车"],"usage":"作谓语、定语、宾语；用于比喻句","story":["汉朝时期，冯良30岁时担任尉从佐，他讨厌为官被人驱使。一次，他奉命去迎接督邮，一路感慨万千，因路不好，车子颠坏了，他干脆抛弃车子，连马也杀掉，脱下官袍，从此隐遁到犍为，从杜抚学，过着隐士的生活"]},{"id":27721,"word":"毁钟为铎","pinyin":"huǐ zhōng wéi duó","abbr":"hzwd","explanation":"将钟改铸为铃。毁大物为小物，比喻随心所欲的愚蠢行为。","source":{"text":"心所说，毁舟为杕；心所欲，毁钟为铎。","book":"《淮南子·说林训》"},"similar":["毁舟为杕"],"usage":"作宾语、定语；用于处事"},{"id":27722,"word":"毁风败俗","pinyin":"huǐ fēng bài sú","abbr":"hfbs","explanation":"败坏良好的风俗。同“伤风败俗”。","source":{"text":"毁风败俗，无益于化；古今之失，莫大于此。","book":"《晋书·刘毅传》"},"example":{"text":"我不相信她竟干出如此～的事情"},"similar":["伤风败俗","伤风败化","败化伤风"],"usage":"作谓语、定语；指道德败坏的行为"},{"id":27723,"word":"毂交蹄劘","pinyin":"gǔ jiāo tí mó","abbr":"gjtm","explanation":"行车交错，马蹄磨削。形容车马来往频繁。","source":{"text":"忠穆公曾牧梁州，以褒城控三节度治所，龙节虎旗，驰驿奔轺，以去以来，毂交蹄劘，由是崇侈其绎，以示雄大。","book":"清·顾炎武《菰中随笔》"},"usage":"作定语、状语；形容繁华"},{"id":27724,"word":"毂击肩摩","pinyin":"gǔ jī jiān mó","abbr":"gjjm","explanation":"肩膀和肩膀相摩，车轮和车轮相撞。形容行人车辆往来拥挤。","source":{"text":"临淄之途，车毂击，人肩摩。","book":"《战国策·齐策一》"},"example":{"text":"只见这弄堂里面，熙来攘往，～；那出进的轿子，更觉络绎不绝。","book":"清·李宝嘉《官场现形记》第八回"},"similar":["摩肩接踵"],"usage":"作定语、状语；形容行人车辆往来拥挤","story":["战国时期，苏秦到齐国游说齐宣王联合抗秦，他说道：“临淄有7万户人家，每家可以出了3个男人当兵，地方很富足，街上人毂击肩摩，众人把衣袖举起来像帐幕，每人挥一把汗，简直像下雨一样，有这样的实力难道还要屈服于秦国？”"]},{"id":27725,"word":"毅然决然","pinyin":"yì rán jué rán","abbr":"yrjr","explanation":"毅然：顽强地；决然：坚决地。意志坚决，毫不犹豫。","source":{"text":"窦世豪得了这封信，所以毅然决然，借点原由同洋人反对，彼此分手。","book":"清·李宝嘉《官场现形记》第五回"},"example":{"text":"但似乎因为舍不得皮夹里仅存的六角钱，所以竟也～地走远了。","book":"鲁迅《呐喊·端午节》"},"similar":["当机立断","坚决果断"],"opposite":["优柔寡断","犹豫不决"],"usage":"作状语、定语；指人的性格"},{"id":27726,"word":"毋庸置疑","pinyin":"wú yōng zhì yí","abbr":"wyzy","explanation":"毋庸：不必。不必怀疑。","source":{"text":"是的，这点毋庸置疑！我相信她本来是沿着正确的方向前进的。","book":"王朔《痴人》"},"example":{"text":"～，我肯定能赢他。"},"similar":["无庸置疑"],"usage":"作谓语、定语、分句；指十分肯定"},{"id":27727,"word":"毋庸置议","pinyin":"wú yōng zhì yì","abbr":"wyzy","explanation":"毋：无：毋庸：不必，无须；置议：进行讨论。不需要讨论。指事实或道理很清楚。","source":{"text":"树勋初念该生等未谙情势，但能解散，即可毋庸置议。","book":"清·章炳麟《中国之川喜多大尉袁树勋》"},"example":{"text":"其原合同第十二款所载开车之日起，三十六年后，中国政府可给价收回一节，～。","book":"蔡东藩、许厪父《民国通俗演义》第四十三回"}},{"id":27728,"word":"毋忝厥职","pinyin":"wú tiǎn jué zhí","abbr":"wtjz","explanation":"毋：不要；忝：辱，谦词；毋忝：无愧于；厥：其。不要辱没自己的职守。","source":{"text":"当请之氤氲使者，令其管领十二月名花，庶几毋忝厥职。","book":"清·王韬《淞隐漫录·申江十美》"}},{"id":27729,"word":"毋望之祸","pinyin":"wú wàng zhī huò","abbr":"wwzh","explanation":"指平白无故受到的灾祸或损害。同“无妄之祸”。","source":{"text":"朱英谓春申君曰：‘世有毋望之福，又有毋望之祸。’","book":"《史记·春申君传》"},"similar":["无妄之祸"],"opposite":["无妄之福","毋望之福"],"usage":"作主语、宾语；用于书面语"},{"id":27730,"word":"毋望之福","pinyin":"wú wàng zhī fú","abbr":"wwzf","explanation":"指平白无故受到的灾祸或损害。同“无妄之福”。","source":{"text":"朱英谓春申君曰：‘世有毋望之福，又有毋望之祸。’","book":"《史记·春申君传》"},"similar":["无妄之福"],"opposite":["毋望之祸","无妄之祸"],"usage":"作主语、宾语；用于书面语"},{"id":27731,"word":"毋翼而飞","pinyin":"wú yì ér fēi","abbr":"wyef","explanation":"比喻传播之迅速。","source":{"text":"闻‘三人成虎，十夫揉椎，众口所移，毋翼而飞。’故曰，不如赐军吏而礼之。","book":"《战国策·秦策三》"},"similar":["无翼而飞","不翼而飞"],"usage":"作谓语；同“不翼而飞”"},{"id":27732,"word":"毋食马肝","pinyin":"wú shí mǎ gān","abbr":"wsmg","explanation":"相传马肝有毒，食之能致人于死。比喻不应研讨的事不去研讨。","source":{"text":"上曰：‘食肉毋食马肝，未为不知味也；言学者毋言汤武受命，不为愚。’","book":"《汉书·辕固传》"}},{"id":27733,"word":"母也天只，不谅人只","pinyin":"mǔ yě tiān zhǐ，bù liàng rén zhǐ","abbr":"mytzblrz","explanation":"只：助词。我的妈呀，我的天哪！不体谅人家的心哪。原指少女因爱情得不到支持而发出的概叹。后泛指得不到尊长的体谅。","source":{"text":"母也天只，不谅人只。","book":"《诗经·鄘风·柏舟》"},"example":{"text":"觉～，得毋有反唇而相稽者乎？","book":"清·袁枚《小仓山房尺牍》第五首"}},{"id":27734,"word":"母以子贵","pinyin":"mǔ yǐ zǐ guì","abbr":"myzg","explanation":"母亲因儿子的显贵而显贵。","source":{"text":"桓何以贵？母贵也。母贵则子何以贵？子以母贵，母以子贵。","book":"《公羊传·隐公元年》"},"example":{"text":"任凭他是青楼婢妾，到得收他做了侧室，后来生出儿子，做了官，就可算的～。","book":"清·吴敬梓《儒林外史》第五十三回"},"similar":["母凭子贵"],"usage":"作宾语、分句；指母子关系"},{"id":27735,"word":"母仪之德","pinyin":"mǔ yí zhī dé","abbr":"myzd","explanation":"母仪：作为母亲的典范。母亲的品德。泛指妇女的品德。","source":{"text":"好礼节剑，有母仪之德。","book":"三国·魏·曹操《立立卞王后策》：“夫人卞氏，抚养诸子，有母仪之德。”《后汉书·光武郭皇后纪》"},"example":{"text":"皇太后自在椒房，有聪明～；遭时不造，援立圣明，承继宗庙，功烈至重。","book":"蔡东藩《后汉演义》第五十七回"},"usage":"作宾语；用于女性"},{"id":27736,"word":"母夜叉","pinyin":"mǔ yè chā","abbr":"myc","explanation":"比喻凶悍的妇女。","source":{"text":"那人夫妻两个，亦是江湖上好汉有名的，都叫他做菜园子张青，其妻母夜叉孙二娘，甚是好义气。","book":"明·施耐庵《水浒传》第17回"},"similar":["母老虎"],"usage":"作宾语、定语；多用于比喻句"},{"id":27737,"word":"母慈子孝","pinyin":"mǔ cí zǐ xiào","abbr":"mczx","explanation":"母亲慈祥爱子，子女孝顺父母，是封建社会所提倡的道德风范。","source":{"text":"天与民五常，使父义、母慈、兄友、弟恭、子孝。","book":"《尚书·康诰》：“天惟与我彝。”孔传"},"example":{"text":"陛下蔽太子之元良，枉太子之神器，何以教天下～焉。","book":"唐·苏安恒《请则天皇后复位于皇子疏》"},"usage":"作谓语、定语；指家庭和睦"},{"id":27738,"word":"母老虎","pinyin":"mǔ lǎo hǔ","abbr":"mlh","explanation":"雌性虎。借指泼妇或刁妇。","source":{"text":"他们把农村扩大了几尺自留地或犯了点其它‘资本主义’禁忌的老百姓以及小偷、赌徒和所谓的‘村盖子’、‘母老虎’，都统统……","book":"路遥《平凡的世界》第一卷第五章"},"example":{"text":"王朔《千万别把我当人》：“你对他好吧，他就跟你来劲，你变成～，他就给你跪下。”"},"similar":["母夜叉"],"usage":"作主语、宾语、定语；用于口语"},{"id":27739,"word":"母难之日","pinyin":"mǔ nán zhī rì","abbr":"mnzr","explanation":"指自己的生日。","source":{"text":"后日是我母难之日，二公可光顾光顾？","book":"明·吴承恩《西游记》第17回"},"example":{"text":"近刘极斋宏济，蜀人，遇诞日，必斋沐焚香端坐曰：‘父忧～也。’","book":"白珽《湛渊静语》第二卷"},"similar":["初度之辰"],"usage":"作主语、宾语；指自己的生日"},{"id":27740,"word":"每下愈况","pinyin":"měi xià yù kuàng","abbr":"mxyk","explanation":"越往下越明显。表示情况越来越坏。","source":{"text":"夫子之问也，固不及质，正获之问于监市履稀也，每下愈况。","book":"战国·宋·庄周《庄子·知北游》"},"example":{"text":"然～，动以附会为能，转使历史真象，隐而不彰。","book":"清·吴趼人《序》"},"similar":["每况愈下","江河日下"],"opposite":["蒸蒸日上"],"usage":"作谓语、定语、补语；形容走下坡路"},{"id":27741,"word":"每事问","pinyin":"měi shì wèn","abbr":"msw","explanation":"每件事都要询问。指凡事都要作进一步的调查。","source":{"text":"子入太庙，每事问。","book":"春秋·鲁·孔丘《论语·八佾》"},"example":{"text":"学个孔夫子的‘～’，任凭你什么才力小也能解决问题。","book":"毛泽东《反对本本主义》"},"usage":"作谓语、宾语；用于治学或处世等"},{"id":27742,"word":"每况愈下","pinyin":"měi kuàng yù xià","abbr":"mkyx","explanation":"越往下越明显。表示情况越来越坏。","source":{"text":"夫子之问也，固不及质，正获之问于监市履希也，每下愈况。","book":"《庄子·知北游》"},"example":{"text":"下品中的魏武帝，更真是～：“曹公古直，甚有悲凉之句”，仅仅这样的十个字而已。","book":"郭沫若《论曹植》"},"similar":["江河日下","日暮途穷"],"opposite":["欣欣向荣","蒸蒸日上"],"usage":"作谓语、定语、状语；形容走下坡路","story":["战国时期，东郭子问道家代表人庄周，“道”是什么，到底在什么地方。庄子说道在蚂蚁洞里，东郭子不明白，再问，庄子说道存在于野草、砖瓦、碎石里。东郭子说怎么道会越来越卑下，庄子说道就在于那些卑微低贱的地方"]},{"id":27743,"word":"每时每刻","pinyin":"měi shí měi kè","abbr":"msmk","explanation":"每分钟，每一时刻。","source":{"text":"现在日本侵略者尚未实行投降，而且每时每刻都在杀中国人。","book":"毛泽东《第十八集团军总司令给蒋介石的两个电报》"},"example":{"text":"我～都在想你。"},"similar":["无时无刻"],"usage":"作状语；指任何时刻"},{"id":27744,"word":"每逢佳节倍思亲","pinyin":"měi féng jiā jié bèi sī qīn","abbr":"mfjjbsq","explanation":"佳节：原指农历九月九日重阳节。指到了节日特别想念在外地亲人的心情。","source":{"text":"独在异乡为异客，每逢佳节倍思亲。","book":"唐·王维《九月九日忆山东兄弟》"},"usage":"作宾语、定语、分句；用于节日"},{"id":27745,"word":"每食甘寝","pinyin":"měi shí gān qǐn","abbr":"msgq","explanation":"甘寝：安睡。吃得好，睡得好。形容生活安逸。","source":{"text":"江官为酂丞，家累巨产。发言不胜呜咽。媪不之异，又久困寒饿，得美食甘寝，不复言。","book":"唐·陈翰《异闻集·庐江冯媪》"}},{"id":27746,"word":"每饭不忘","pinyin":"měi fàn bù wàng","abbr":"mfbw","explanation":"指时刻不忘。","source":{"text":"文帝曰：‘吾居代时，吾尚食监高袪数为我言赵将李齐之贤，战于钜鹿下。今吾每饭，意未尝不在钜鹿也’","book":"西汉·司马迁《史记·张释之冯唐列传》"},"example":{"text":"人但知杜少陵～君，耳不知其于友朋、弟妹、夫妻、儿女间，何在不一往情深耶？","book":"清·袁枚《随园诗话》第14卷"},"similar":["时刻不忘"],"usage":"作谓语、宾语；指时刻不忘"},{"id":27747,"word":"毒手尊前","pinyin":"dú shǒu zūn qián","abbr":"dszq","explanation":"泛指无情的打击。","source":{"text":"至于毒手尊拳，交相于暮夜；金戈铁马，蹂践于明村。","book":"《新五代史·唐臣传·李袭吉》"}},{"id":27748,"word":"毒手尊拳","pinyin":"dú shǒu zūn quán","abbr":"dszq","explanation":"毒手：凶狠的殴打。泛指无情的打击。","source":{"text":"毒手尊拳，交相于暮夜；金戈铁马，蹂躏于明时。","book":"《旧五代史·唐书·李袭吉传》"},"example":{"text":"我不害怕你的～。"},"usage":"作宾语、定语；指打击"},{"id":27749,"word":"毒泷恶雾","pinyin":"dú lóng è wù","abbr":"dlew","explanation":"恶劣的云雨雾气。比喻暴虐凶残的黑暗势力。","source":{"text":"毒泷恶雾纷相乘，令我望望心惺惺。","book":"郑泽《登楼叹》诗"},"similar":["洪水猛兽"],"usage":"作主语、宾语、定语；多用于比喻句"},{"id":27750,"word":"毒燎虐焰","pinyin":"dú liáo nüè yàn","abbr":"dlny","explanation":"毒：恶毒的；燎：火烧；虐：凶残的；焰：火焰。恶毒的大火燃烧，凶残的火焰肆虐。形容凶猛狠暴虐的恶势力。","source":{"text":"爨以毒燎，煽以虐焰。","book":"唐·柳宗元《贞符》"}},{"id":27751,"word":"毒药苦口","pinyin":"dú yào kǔ kǒu","abbr":"dykk","explanation":"毒药：攻毒的药物。比喻尖锐的批评虽然像毒药一样苦口难服，却能让人醒悟。","source":{"text":"且‘忠言逆耳利于行，毒药苦口利于病’，愿沛公听樊哙言。","book":"西汉·司马迁《史记·留侯世家》"},"similar":["良药苦口"],"usage":"作主语、宾语、分句；用于规劝"},{"id":27752,"word":"毒蛇猛兽","pinyin":"dú shé měng shòu","abbr":"dsms","explanation":"泛指对人类生命有威胁的动物。比喻贪暴者。","source":{"text":"在人同兽争的时代，因为不知道何时有毒蛇猛兽来犯，所以人类时时刻刻不知生死。","book":"孙中山《民权主义》第一讲"},"example":{"text":"那地方本来‘人’迹稀少，～横行。","book":"瞿秋白《文艺杂著》"},"similar":["洪水猛兽"],"usage":"作宾语、定语；指坏人"},{"id":27753,"word":"毒赋剩敛","pinyin":"dú fù shèng liǎn","abbr":"dfsl","explanation":"指横征暴敛。","source":{"text":"当毒赋剩敛鞭箠马牛其人之日，一漕夔，再漕潼，川民独晏然倚以朝夕也。","book":"宋·邵博《闻见后录》卷二八"},"similar":["横征暴敛"],"usage":"作宾语、定语；指赋税重"},{"id":27754,"word":"毒魔狠怪","pinyin":"dú mó hěn guài","abbr":"dmhg","explanation":"凶恶残忍的妖魔鬼怪。","source":{"text":"大哥是个了得的。向者那般毒魔狠怪，也能收服，怕这几个毛贼？","book":"《西游记》第九七回"},"similar":["妖魔鬼怪"],"usage":"作主语、宾语、定语；多用于比喻句"},{"id":27755,"word":"毓子孕孙","pinyin":"yù zǐ yùn sūn","abbr":"yzys","explanation":"毓：养育。繁衍子孙。","source":{"text":"况乎将军，牧二州，二纪功载王府，赐命优备，赖而生者，毓子孕孙，能不歌叹！","book":"汉·蔡邕《刘镇南碑》"},"example":{"text":"赖而生者，～。","book":"《全三国文》卷五十六"},"usage":"作谓语、宾语；指繁衍后代"},{"id":27756,"word":"比上不足，比下有余","pinyin":"bǐ shàng bù zú，bǐ xià yǒu yú","abbr":"bsbzbxyy","explanation":"赶不上前面的，却超过了后面的。这是满足现状，不努力进取的人安慰自己的话。有时也用来劝人要知足。","source":{"text":"汉·赵岐《三辅决录》：“上比崔杜不足，下比罗赵有余。”晋·张华《鹪鹩赋》：“将以上方不足而下比有余”。"},"example":{"text":"在些地方我不如人，但有些地方人不如我，～。”","book":"杨献珍《加强党性锻炼》"},"similar":["甘居中游","不求有功，但求无过"],"opposite":["力争上游","百尺竿头，更进一步"],"usage":"作主语、分句；用于甘居中游的思想"},{"id":27757,"word":"比下有余","pinyin":"bǐ xià yǒu yú","abbr":"bxyy","explanation":"比：比较。对所处的中等地位感到知足。形容满足现状，不求进取。","source":{"text":"古人云：比上不足，比下有余。此最是寻乐妙法也。","book":"清·沈复《浮生六记·养生记道》"},"opposite":["比上不足"],"usage":"作宾语、定语；用于安慰自己"},{"id":27758,"word":"比众不同","pinyin":"bǐ zhòng bù tóng","abbr":"bzbt","explanation":"与大家相比，大不一样。","source":{"text":"原来悟空筋斗云比众不同，十分快疾，把个金星撇在脑后，先至南天门外。","book":"明·吴承恩《西游记》第四回"},"example":{"text":"这件作品构思独树一帜、～。"},"similar":["与众不同"],"opposite":["比比皆是"],"usage":"作谓语、定语、状语；形容出色"},{"id":27759,"word":"比居同势","pinyin":"bǐ jū tóng shì","abbr":"bjts","explanation":"比：勾结。纠集亲信，互相勾结，形成势力。","source":{"text":"树叶强大，比居同势，各结朋党，竞进憸人。","book":"三国·蜀·诸葛亮《兵要》"}},{"id":27760,"word":"比屋可封","pinyin":"bǐ wū kě fēng","abbr":"bwkf","explanation":"意思是在唐、虞时代，贤人很多，差不多每家都有可受封爵的德行。后比喻社会安定，民俗淳朴。也形容教育感化的成就。","source":{"text":"明圣之世，国多贤人，故唐虞之时，可彼屋而封。","book":"《汉书·王莽传上》"},"example":{"text":"夫古之所谓至治极盛者，曰家给人足，曰～。","book":"清·严复《原强》"},"similar":["比比皆是"],"opposite":["比屋可诛"],"usage":"作谓语、定语；形容很多"},{"id":27761,"word":"比屋可诛","pinyin":"bǐ wū kě zhū","abbr":"bwkz","explanation":"诛：杀戮。家家都可杀戮。旧指桀纣之时，世风败坏，恶人众多。","source":{"text":"尧舜之民，可比屋而封；桀纣之民，可比屋而诛者，教化使然也。","book":"汉·陆贾《新语·无为》"},"example":{"text":"则一命以上，～，亦非清律所能容矣。","book":"章炳麟《满洲总督侵吞赈款状》"},"similar":["世风日下"],"opposite":["比屋可封"],"usage":"作谓语、定语；形容民风败坏"},{"id":27762,"word":"比屋而封","pinyin":"bǐ wū ér fēng","abbr":"bwef","explanation":"指上古之世教化遍及四海，家家都有德行，堪受旌表。后泛称风俗淳美。","source":{"text":"尧舜之民，可比屋而封；桀纣之民，可比屋而诛者，教化使然也。","book":"《尚书大传》卷五：“周人可比屋而封。”汉·陆贾《新语·无为》"},"example":{"text":"臣推此以广其义，舜弹五弦之琴，咏《南风》之诗，而天下自理，由尧人可～也。","book":"《晋书·段灼传》"},"similar":["比屋可封"],"opposite":["比屋可诛"],"usage":"作谓语、定语；形容民风纯美"},{"id":27763,"word":"比屋连甍","pinyin":"bǐ wū lián méng","abbr":"bwlm","explanation":"屋舍紧密相连。指住户众多。","source":{"text":"比屋连甍，千庑万室。","book":"晋·左思《蜀都赋》"},"example":{"text":"迨国朝以来，吾邑贡籍不能出他邑上，而所辖金阊内外，～，通阛带阓，万商之渊，骎骎乎甲通省焉！","book":"清·冯桂芬《重修吴县学记》"},"usage":"作谓语；指住户很多"},{"id":27764,"word":"比岁不登","pinyin":"bǐ suì bù dēng","abbr":"bsbd","explanation":"比：屡屡；频频。农业连年歉收。","source":{"text":"关东比岁不登，吏民以义收食贫民、人谷物助县官赈赡者，已赐直。","book":"《汉书·成帝纪》"},"similar":["比年不登","岁比不登"],"opposite":["五谷丰登"],"usage":"作谓语；指农业欠收"},{"id":27765,"word":"比年不登","pinyin":"bǐ nián bù dēng","abbr":"bnbd","explanation":"比：屡屡；频频。农业连年歉收。亦作“比岁不登”。","source":{"text":"时比年不登，羌胡扰边，诏公卿会议，玄应对所问，陈事切直。","book":"《晋书·傅玄传》"},"similar":["比岁不登","岁比不登"],"usage":"作谓语、定语；指农业欠收"},{"id":27766,"word":"比张比李","pinyin":"bǐ zhāng bǐ lǐ","abbr":"bzbl","explanation":"比喻多方面设譬。","source":{"text":"豫让，你不替我展江山，夺社稷，到来比张比李的说我。","book":"元·杨梓《豫让吞炭》第一折"},"usage":"作谓语、定语；指打比方"},{"id":27767,"word":"比户可封","pinyin":"bǐ hù kě fēng","abbr":"bhkf","explanation":"差不多每家每户都有可受封爵的德行。用以泛指风俗淳美。","source":{"text":"见“比屋可封”。"},"example":{"text":"夫古之所谓至治极盛者，曰‘家给人足’，曰‘～’，曰‘刑措不用’。","book":"严复《原强》"},"similar":["比屋可封"],"usage":"作谓语、定语；形容很多"},{"id":27768,"word":"比手划脚","pinyin":"bǐ shǒu huà jiǎo","abbr":"bshj","explanation":"形容说话时用手势示意或加强语气。","source":{"text":"老看守却像没听见，紧比手划脚说。","book":"杨朔《金字塔夜月》"},"example":{"text":"二舅讲故事是很认真的，讲到红军胜利的时候，总是～，眉飞色舞。","book":"陈炎荣《雨过天晴》"},"similar":["比比划划","比手画脚"],"usage":"作谓语、状语；用于说话时"},{"id":27769,"word":"比手画脚","pinyin":"bǐ shǒu huà jiǎo","abbr":"bshj","explanation":"说话的同时用手脚来比画。","example":{"text":"他急得无法表达，只好～了。"},"similar":["比手划脚"],"usage":"作谓语、状语；用于人说话等"},{"id":27770,"word":"比权量力","pinyin":"bǐ quán liàng lì","abbr":"bqll","explanation":"比较衡量两方面的权力和力量。也用来指衡量两方面的轻重。","source":{"text":"试使山东之国与陈涉度长絜大，比权量力，则不可同年而语矣。","book":"汉·贾谊《过秦论上》"},"example":{"text":"清·王韬《变法中》：“安能埓于欧洲诸大国，而与之～也哉！”"},"similar":["权衡轻重"],"usage":"作谓语、定语；指权衡轻重得失"},{"id":27771,"word":"比比划划","pinyin":"bǐ bǐ huà huà","abbr":"bbhh","explanation":"指讲话时用手势示意。","source":{"text":"董延平比比划划对我讲述着下午传遍工地的一件新鲜事。","book":"王朔《永失我爱》"},"example":{"text":"他边讲边用手～。"},"similar":["比比画画"],"usage":"作谓语、状语；用于说话时人的神态"},{"id":27772,"word":"比比皆是","pinyin":"bǐ bǐ jiē shì","abbr":"bbjs","explanation":"比比：一个挨一个。到处都是，形容极其常见。","source":{"text":"年亢旱，民食艰阻，流亡者比比皆是。","book":"《战国策·秦策一》：“犯白刃，蹈煨炭，断死于前者，比是也。”宋·包拯《请救济江淮饥民疏》"},"example":{"text":"上自朝廷，下至草野，～。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["俯拾即是","比比皆然","举目皆是"],"opposite":["寥寥无几","屈指可数","寥若晨星"],"usage":"作谓语、定语；用于人与物"},{"id":27773,"word":"比比皆然","pinyin":"bǐ bǐ jiē rán","abbr":"bbjr","explanation":"比比：处处。到处都是。形容多。同“比比皆是”。","source":{"text":"将无固守之志，兵无敢死之心，人情趋利，比比皆然。","book":"清·褚人获《隋唐演义》第五十三回"},"similar":["比比皆是"],"opposite":["屈指可数"],"usage":"作谓语、定语；用于人与物"},{"id":27774,"word":"比物丑类","pinyin":"bǐ wù chǒu lèi","abbr":"bwcl","explanation":"指连缀同类事物，进行排比归纳。","source":{"text":"以事相况而为之。丑，犹比也。","book":"《礼记·学记》：“古之学者，比物丑类。”郑玄注"},"example":{"text":"则知三代语言，汉人犹难遍识，愿学者‘～’以求之。","book":"清·王引之《经传释词》卷十"},"similar":["比物连类"],"usage":"作谓语；指进行排比归纳"},{"id":27775,"word":"比物假事","pinyin":"bǐ wù jiǎ shì","abbr":"bwjs","explanation":"假借相类的事物，相进行比较归纳。","source":{"text":"一呼一吸，因事纳谏，比物假事，不辞矫诬之刑。","book":"清·龚自珍《古史钩沉论二》"},"similar":["比物属事"],"usage":"作谓语；指进行排比归纳"},{"id":27776,"word":"比物属事","pinyin":"bǐ wù zhǔ shì","abbr":"bwzs","explanation":"连缀相类的事物，进行排比归纳。","source":{"text":"于是使博辩之士，原本山川，极命草木；比物属事，离辞连类。","book":"汉·枚乘《七发》"},"similar":["比物属事"],"usage":"作谓语；指进行排比归纳"},{"id":27777,"word":"比物此志","pinyin":"bǐ wù cǐ zhì","abbr":"bwcz","explanation":"比物：比类，比喻；志：心意。指用事物行为来寄托、表达自己的心意。","source":{"text":"圣人有金城者，比物此志也。","book":"《汉书·贾谊传》"},"usage":"作谓语；形容人寄托心意"},{"id":27778,"word":"比物连类","pinyin":"bǐ wù lián lèi","abbr":"bwll","explanation":"连：连缀。连缀相类的事物，进行对比。","source":{"text":"多言繁称，连类比物，则见以为虚而无用。","book":"《韩非子·难言》"},"example":{"text":"每下笔，乃如文人才士就题，赋咏词源衮衮出于毫端，～，激昂顿挫，无所不有。","book":"宋·赵佶《宣和画谱·山水三》"},"similar":["分门别类"],"usage":"作谓语；指进行排比归纳"},{"id":27779,"word":"比目连枝","pinyin":"bǐ mù lián zhī","abbr":"bmlz","explanation":"比目：比目鱼，传说仅一眼，须两鱼并游；连枝：连在一起的树枝。比喻形影不离的情侣和朋友。","source":{"text":"乐心儿比目连枝，肯意儿新婚燕儿。","book":"元·贾固《醉高歌过红绣鞋·寄金莺儿》"},"similar":["比翼连枝"],"usage":"作宾语、定语；指情侣和夫妻"},{"id":27780,"word":"比类从事","pinyin":"bǐ lèi cóng shì","abbr":"blcs","explanation":"比：比照。其它类似的情况按照这种精神办理。","source":{"text":"它不在令者中，皆以此令比类从事。","book":"《汉书·文帝纪》"},"usage":"作谓语；用于书面语"},{"id":27781,"word":"比翼双飞","pinyin":"bǐ yì shuāng fēi","abbr":"bysf","explanation":"比翼：翅膀挨着翅膀。双飞：成双的并飞。比喻夫妻情投意合，在事业上并肩前进。","source":{"text":"南方有比翼鸟焉，不比不飞，其名谓之鹣鹣。","book":"《尔雅·释地》"},"example":{"text":"不是妾身多薄幸，只因司马太风骚，效神凤，下丹霄，～上泬寥。","book":"明·朱权《卓文君》"},"similar":["比翼齐飞","并驾齐驱"],"usage":"作谓语、宾语、补语；用于夫妻或情侣"},{"id":27782,"word":"比翼连枝","pinyin":"bǐ yì lián zhī","abbr":"bylz","explanation":"比翼：鸟名。传说此鸟一目一翼，须两两齐飞。比喻夫妇亲密不离。","source":{"text":"在天愿作比翼鸟，在地愿为连理枝。","book":"唐·白居易《长恨歌》诗"},"example":{"text":"但愿你百岁夫妻长好，比翼共连枝，无异般。","book":"明·谢谠《四喜记·大宋毕姻》"},"similar":["比目连枝"],"usage":"作宾语；用于夫妻或情侣"},{"id":27783,"word":"比翼鸟","pinyin":"bǐ yì niǎo","abbr":"byn","explanation":"传说中的一种雌雄在一起飞的鸟。比喻恩爱夫妻。","source":{"text":"七月七日长生殿，夜半无人私语时。在天愿作比翼鸟，在地愿为连理枝。","book":"唐·白居易《长恨歌》"},"usage":"作宾语、定语；多用于比喻句"},{"id":27784,"word":"比翼齐飞","pinyin":"bǐ yì qí fēi","abbr":"byqf","explanation":"比翼：翅膀挨着翅膀。齐飞：成双的并飞。比喻夫妻情投意合，在事业上并肩前进。","source":{"text":"南方有比翼鸟焉，不比不飞，其名谓之鹣鹣。","book":"《尔雅·释地》"},"example":{"text":"居里夫妇在科学征途上～。"},"similar":["比翼双飞"],"usage":"作谓语、定语；用于夫妻或情侣"},{"id":27785,"word":"比而不党","pinyin":"bǐ ér bù dǎng","abbr":"bebd","explanation":"比：亲近；党：偏私。亲近而不偏私。","source":{"text":"吾闻事君者，比而不党。","book":"《国语·晋语》"}},{"id":27786,"word":"比肩叠踵","pinyin":"bǐ jiān dié zhǒng","abbr":"bjdz","explanation":"形容人多。叠踵，脚尖踩脚跟。","source":{"text":"辽沈旧人，胜朝遗耈，比肩叠踵，同掌丝纶。","book":"清·陈康棋《郎潜纪闻》卷一"},"similar":["比肩继踵"],"opposite":["门可罗雀","人迹罕至"],"usage":"作谓语、定语；比喻人多很拥挤"},{"id":27787,"word":"比肩叠迹","pinyin":"bǐ jiān dié jì","abbr":"bjdj","explanation":"肩膀相靠，足迹相叠。形容人多。","source":{"text":"荣古虐今者，比肩叠迹。","book":"唐·柳宗元《与友人论为文书》"},"similar":["比肩叠踵"],"opposite":["人迹罕至","人烟稀少"],"usage":"作谓语、定语；形容人多"},{"id":27788,"word":"比肩并起","pinyin":"bǐ jiān bìng qǐ","abbr":"bjbq","explanation":"比：并。肩并肩地一齐起来。比喻同时相随而起。","source":{"text":"弃其亲家而欲奔之者比肩并起。","book":"《荀子·非相》"},"usage":"作谓语；比喻同时相随而起"},{"id":27789,"word":"比肩接踵","pinyin":"bǐ jiān jiē zhǒng","abbr":"bjjz","explanation":"犹比肩继踵。形容人很多或接连不断。","source":{"text":"天下之谬悠庸烂者，比肩接踵，不可胜数。","book":"清·戴名世《序》：“其间名臣巨儒、魁奇俊伟豪杰不群之士，比肩接踵而出。”又《序》"},"similar":["比肩继踵"],"usage":"作谓语、定语；形容人多拥挤或接连不断"},{"id":27790,"word":"比肩接迹","pinyin":"bǐ jiān jiē jì","abbr":"bjjj","explanation":"肩膀相靠，足迹相接。形容人多或接连不断。","source":{"text":"贤者槁项黄馘而死于下，不贤者比肩接迹而显于世。","book":"明·瞿佑《剪灯新话·修文舍人传》"}},{"id":27791,"word":"比肩皆是","pinyin":"bǐ jiān jiē shì","abbr":"bjjs","explanation":"到处都是。形容同类的事物或情况很多。","source":{"text":"然雅达通博，不代而生；浮学守株，比肩皆是。","book":"《旧唐书·元行冲传》"},"similar":["比比皆是"],"opposite":["屈指可数"],"usage":"作谓语、定语；用于人与物"},{"id":27792,"word":"比肩相亲","pinyin":"bǐ jiān xiāng qīn","abbr":"bjxq","explanation":"比：紧靠。形容夫妻感情挚笃。","source":{"text":"南朝·梁·任昉《述异记》载：三国时，吴国海盐有个叫陆东的人，娶妻朱氏，夫妻互助互爱，同心同意，人称“比肩人”。"}},{"id":27793,"word":"比肩系踵","pinyin":"bǐ jiān xì zhǒng","abbr":"bjxz","explanation":"犹比肩继踵。形容人很多或接连不断。","source":{"text":"今之取人，未试而遽迁，务进徼幸，比肩系踵。","book":"《新唐书·韦嗣立传》"},"similar":["比肩继踵"],"usage":"作谓语、定语；比喻人多很拥挤"},{"id":27794,"word":"比肩继踵","pinyin":"bǐ jiān jì zhǒng","abbr":"bjjz","explanation":"比：挨着；踵：脚跟。肩挨着肩，脚跟着脚。形容人很多，很拥挤。","source":{"text":"临淄三百闾，张袂成阴，挥汗成雨，比肩继踵而在，何为无人。","book":"《晏子春秋·杂下》"},"example":{"text":"大街上，行人～，十分热闹。"},"similar":["摩肩接踵","水泄不通","人山人海"],"opposite":["门可罗雀","荒无人烟","人迹罕至"],"usage":"作谓语、定语；比喻人多很拥挤","story":["春秋时期，齐国大夫晏婴奉命出使楚国，楚王见他矮小就说齐国无人才派他来。晏婴回答说：“齐国都城临淄有3万户人家，可以挥汗成雨，大街上行人比肩继踵，热闹非凡。”巧妙地应对楚王。楚王刮目相看，改用高规格接待他"]},{"id":27795,"word":"比肩而事","pinyin":"bǐ jiān ér shì","abbr":"bjes","explanation":"比：并。肩并肩做事。指共事、同事。","source":{"text":"方羽杀卿子冠军，增与羽比肩而事义帝，君臣之分未定也。","book":"宋·苏轼《范增论》"},"usage":"作谓语；指共事"},{"id":27796,"word":"比肩而立","pinyin":"bǐ jiān ér lì","abbr":"bjel","explanation":"比肩：并肩。肩并肩地站立。比喻彼此距离极近。","source":{"text":"寡人闻之，千里而一士，是比肩而立；百世而一圣，若随踵而至。","book":"《战国策·齐策三》"},"example":{"text":"虽使间世而生，何异～！","book":"宋·陈亮《贺周丞相启》"},"similar":["并肩而立"],"usage":"作谓语；比喻距离极近"},{"id":27797,"word":"比肩连袂","pinyin":"bǐ jiān lián mèi","abbr":"bjlm","explanation":"肩膀相并，衣袖相连。形容连接不断。","source":{"text":"明·徐弘祖《徐霞客游记·游恒山日记》；“近则龙山西亘，支峰东连，若比肩连袂。”"},"similar":["接二连三"],"opposite":["断断续续"],"usage":"作谓语、宾语、状语；指连续不断"},{"id":27798,"word":"比肩迭踵","pinyin":"bǐ jiān dié zhǒng","abbr":"bjdz","explanation":"形容人多。迭踵，脚尖踩脚跟。","source":{"text":"辽沉旧人，胜朝遗耈，比肩迭踵，同掌丝纶。","book":"清·陈康棋《郎潜纪闻》卷一"},"example":{"text":"我们尽量少去那些～的闹市。"},"similar":["比肩叠踵"],"usage":"作谓语、定语；比喻人多很拥挤"},{"id":27799,"word":"比肩迭迹","pinyin":"bǐ jiān dié jì","abbr":"bjdj","explanation":"肩膀相靠，足迹相迭。形容人多。","source":{"text":"荣古虐今者，比肩迭迹。","book":"唐·柳宗元《与友人论为文书》"},"example":{"text":"广场上人山人海、～，真是热闹非凡。"},"similar":["比肩叠迹"],"usage":"作谓语、定语；形容人多"},{"id":27800,"word":"比肩随踵","pinyin":"bǐ jiān suí zhǒng","abbr":"bjsz","explanation":"犹比肩继踵。形容接连不断。","source":{"text":"《韩非子·难势》；“且夫尧、舜、桀、纣千世而一出，是比肩随踵而生也，世之治者不绝于中。”"},"similar":["比肩继踵","比肩连袂"],"opposite":["断断续续"],"usage":"作谓语、定语、状语；指连续不断"},{"id":27801,"word":"比肩齐声","pinyin":"bǐ jiān qí shēng","abbr":"bjqs","explanation":"比喻地位、声望相等或相近。","source":{"text":"虽起孤傲，与同郡陆逊、卜静等比肩齐声矣。","book":"《三国志·吴书·吾粲传》"},"usage":"作谓语、定语；用于地位、声望等"},{"id":27802,"word":"比葫芦画瓢","pinyin":"bǐ hú lú huà piáo","abbr":"bhlhp","explanation":"比喻照样子模仿。","example":{"text":"这种～的做法不值得提倡。"},"similar":["依葫芦画瓢"],"usage":"作谓语、宾语、定语、分句；用于口语"},{"id":27803,"word":"比量齐观","pinyin":"bǐ liàng qí guān","abbr":"blqg","explanation":"指同等看待。","source":{"text":"而且他们的输出东西，又是工艺品，是精制品；我们的输出东西，是农产品，是原料。因此我们的输出，必不能和输入比量齐观。","book":"廖仲恺《中国的实业的现状及产业落后的原因》"},"similar":["等量齐观","一视同仁"],"usage":"作谓语、宾语；指同等看待"},{"id":27804,"word":"毕其功于一役","pinyin":"bì qí gōng yú yī yì","abbr":"bqgyyy","explanation":"把应该分成几步做的事一次做完。亦以形容急于求成。","source":{"text":"吾国治民生主义者，睹其祸害于未萌，诚可举政治革命、社会革命毕其功于一役。","book":"孙中山《〈民报〉发刊词》"},"example":{"text":"例如社会主义的任务，合并在民主主义任务上面去完成，这叫做‘～’，那就是空想。","book":"毛泽东《新民主主义论》八"},"similar":["大功告成"],"usage":"作谓语、宾语；指一举成事"},{"id":27805,"word":"毕力同心","pinyin":"bì lì tóng xīn","abbr":"bltx","explanation":"犹言齐心协力。","source":{"text":"毕力同心，共平多难，止土崩于绝岸，收板荡于横流。","book":"唐·陆贽《兴元论赐浑瑊诏书为取散失内人等议状》"},"similar":["同心协力"],"usage":"作宾语、状语；指齐心协力"},{"id":27806,"word":"毕恭毕敬","pinyin":"bì gōng bì jìng","abbr":"bgbj","explanation":"形容态度十分恭敬。","source":{"text":"军长为李玉堂，一山东大汉，抵军部时，在门外相迎，毕恭毕敬。","book":"《诗经·小雅·小弁》：“维桑与梓，必恭敬止，靡瞻匪父，靡依匪母。”郭沫若《洪波曲》第十章五"},"example":{"text":"［韩老六］对于穷人的～的招呼从不理睬，而对于有钱的人，有说有笑。","book":"周立波《暴风骤雨》第一部二"},"similar":["必恭必敬"],"opposite":["出言不逊"],"usage":"作状语、定语；形容人的态度","story":["西周周幽王十分昏庸暴虐，十分宠爱褒国进献的美女褒姒，想尽千方百计并不惜一切代价地让褒姒一笑，对外得罪各路诸侯，废除原太子宜臼立褒姒的儿子伯服为太子。尽管如此，宜臼写《小弁》诗抒发对父母必恭必敬的心情"]},{"id":27807,"word":"毕雨箕风","pinyin":"bì yǔ jī fēng","abbr":"byjf","explanation":"原指民性如星，星好风雨，比喻庶民喜好人主的恩泽。后为颂扬统治者普施仁政之词。","source":{"text":"箕星好风，毕星好雨，亦民所好。","book":"《书·洪范》：“庶民惟星，星有好风，星有好雨。”孔传"},"example":{"text":"使雷车电椅，扫荡四方；～，稣舒品物。","book":"前蜀·杜光庭《晋公北帝醮词》"},"similar":["箕风毕雨"],"usage":"作宾语；指官吏施政应顺应民情"},{"id":27808,"word":"毙而后已","pinyin":"bì ér hòu yǐ","abbr":"behy","explanation":"指努力工作或为某一目的奋斗终生，至死才罢休。","source":{"text":"乡道而行，中道而废，忘身之老也，不知年数之不足也，俯焉日有孳孳，毙而后已。","book":"西汉·戴圣《礼记·表记》"},"example":{"text":"公尔忘私，～，是岂寻常所可及哉！","book":"明·田汝成《阿寄传》"},"similar":["死而后已"],"usage":"作谓语、宾语；指人很积极"},{"id":27809,"word":"毛举糠秕","pinyin":"máo jǔ kāng bǐ","abbr":"mjkb","explanation":"毛举：琐碎列举。糠秕：谷类废弃不可食的部分。比喻不厌其烦地列举琐碎的事或没有价值的事物。","source":{"text":"其一则极守旧之人，夙负盛名，为天下所归往，及见西法，不欲有一事为彼所不知不能也，乃举声光化电之粗迹，兵商工艺之末流，毛举糠秕，附会经训，张唇植髭，不自愧汗。","book":"严复《论中国分党》"}},{"id":27810,"word":"毛举细事","pinyin":"máo jǔ xì shì","abbr":"mjxs","explanation":"毛：琐碎；细事：小事。指烦琐地列举细微的小事情。同“毛举细故”。","source":{"text":"而群臣邈焉不知所急，毛举细事，以乱大谋。","book":"宋·陈亮《论励臣之道》"},"similar":["毛举细故","毛举细务"],"usage":"作谓语、定语；指烦琐地列举细小事情"},{"id":27811,"word":"毛举细务","pinyin":"máo jǔ xì wù","abbr":"mjxw","explanation":"毛举：琐碎列举；细务：小事。烦琐地列举细小事情。","source":{"text":"而群臣邈焉不知所急，毛举细事以乱大谋。","book":"宋·陈亮《论励臣之道》"},"example":{"text":"时言事者率毛举细务，略大利害。","book":"《宋史·陈桷传》"},"similar":["毛举细故"],"usage":"作谓语、定语；指烦琐地列举细小事情"},{"id":27812,"word":"毛举细故","pinyin":"máo jǔ xì gù","abbr":"mjxg","explanation":"毛：琐碎；细故：小事。指烦琐地列举小事情，加以责难或攻击。","source":{"text":"治有大体，不当毛举细故；令在必行，不当徒为文具。","book":"宋·张孝祥《论治体札子》"},"example":{"text":"而犹禽视息息，行尸走肉，～，瞻前顾后，相妒相轧。","book":"清·梁启超《南学会序》"},"similar":["毛举细务","毛举细事"],"usage":"作谓语、定语；指烦琐地列举细小事情"},{"id":27813,"word":"毛举缕析","pinyin":"máo jǔ lǚ xī","abbr":"mjlx","explanation":"详细列举，详尽剖析。","source":{"text":"士大夫稍自振厉，不肯阿附，或小有违忤，则罗致之狱；毛举缕析，旁逮知旧，惧其不能废锢，必以赃私罪污之。","book":"宋·张孝祥《乞改正迁谪士大夫罪名札子》"},"usage":"作宾语、定语；用于处事"},{"id":27814,"word":"毛发不爽","pinyin":"máo fā bù shuǎng","abbr":"mfbs","explanation":"犹毫发不爽。形容一点不差。","source":{"text":"四至八到，方方凑合，求其毛发不爽难矣。","book":"清·刘献廷《广阳杂记》第二卷"},"similar":["毫发不爽"],"opposite":["天差地别"],"usage":"作谓语、宾语；形容一点不差"},{"id":27815,"word":"毛发丝粟","pinyin":"máo fà sī sù","abbr":"mfss","explanation":"比喻十分细小的事物。","source":{"text":"毛发丝粟之才纷纷然而起。","book":"宋·欧阳洵《上欧阳内翰书》"},"similar":["毫发丝粟"],"usage":"作宾语、定语；比喻十分细小的事物"},{"id":27816,"word":"毛发为竖","pinyin":"máo fà wéi shù","abbr":"mfws","explanation":"汗毛、头发都竖起来。形容愤怒的样子。也形容非常害怕、紧张。","source":{"text":"日未昏黑深掩关，毛发为竖心悲酸，客子岂知行路难！","book":"宋·方岳《三虎行》诗"},"example":{"text":"余肃然而恐，～。","book":"明·张岱《海志》"}},{"id":27817,"word":"毛发之功","pinyin":"máo fà zhī gōng","abbr":"mfzg","explanation":"形容极微小的功劳。","source":{"text":"窃不自量，志在授命，庶立毛发之功，以报所受之恩。","book":"三国·魏·曹植《求自试表》"},"example":{"text":"请不要再提这～了。"},"similar":["尺寸之功"],"opposite":["赫赫之功"],"usage":"作宾语；形容极微小的功劳"},{"id":27818,"word":"毛发倒竖","pinyin":"máo fà dào shù","abbr":"mfds","explanation":"形容愤怒的样子。","source":{"text":"腾读毕，毛发倒竖，咬齿嚼唇，满口流血。","book":"明·罗贯中《三国演义》第二十回"},"example":{"text":"看那月色时，也淡淡的，不似先前明朗，众人都觉～。","book":"清·曹雪芹《红楼梦》第七十五回"},"similar":["毛发皆竖"],"usage":"作谓语、状语、定语；用于愤怒、惊吓等"},{"id":27819,"word":"毛发尽竖","pinyin":"máo fà jìn shù","abbr":"mfjs","explanation":"竖：直立。汗毛和头发都竖立起来。形容愤怒或极度恐惧、紧张的样子。","source":{"text":"黑蛮龙听了，不觉腮边火冒，毛发尽竖。","book":"清·钱彩《说岳全传》第71回"},"similar":["毛发皆竖","毛发森竖"],"usage":"作谓语、状语、定语；用于愤怒、惊吓等"},{"id":27820,"word":"毛发悚然","pinyin":"máo fā sǒng rán","abbr":"mfsr","explanation":"毛发竖起。极言惊骇、恐惧。亦作“毛发耸然”。","source":{"text":"戴监生偷听到两个鬼的一番议论，议论中居然提到他。戴骤聆至此，毛发悚然。","book":"清·和邦额《夜谭随录·戴监生》"},"example":{"text":"煞静的深夜，一个人在毫无掩蔽的山顶上，听到一声虎啸，那是不由人～的。","book":"邓洪《山中历险记》"},"similar":["毛发耸然","毛发悚立","毛骨悚然"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；形容十分恐惧"},{"id":27821,"word":"毛发悚立","pinyin":"máo fà sǒng lì","abbr":"mfsl","explanation":"毛发：头发和汗毛；耸：竖起。头发与汗毛竖起。形容非常恐惧。","source":{"text":"迄今思之，尚毛发悚立也。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"similar":["毛发悚然","毛发耸然"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；形容十分恐惧"},{"id":27822,"word":"毛发森竖","pinyin":"máo fà sēn shù","abbr":"mfss","explanation":"竖：直立。汗毛和头发都竖立起来。形容愤怒或极度恐惧、紧张的样子。","source":{"text":"向行事近我者，非太尉邪？每顾我，毛发为森竖。","book":"《新唐书·李德裕传》"},"example":{"text":"余忽心动，～，乃迹故步，还至不浒；消苔读碑，慷慨吊古。","book":"宋·岳珂《桯史·馆娃浯溪》"},"similar":["毛发皆竖"],"usage":"作谓语、状语、定语；用于愤怒、惊吓等"},{"id":27823,"word":"毛发皆竖","pinyin":"máo fà jiē shù","abbr":"mfjs","explanation":"竖：直立。汗毛和头发都竖立起来。形容极度恐惧、紧张的样子。","source":{"text":"猛然间听的呼呼风响，杨忠觉得毛发皆竖，连忙起身，手掣宝剑。","book":"清·石玉昆《三侠五义》第六回"},"similar":["毛发倒竖","毛发尽竖"],"usage":"作谓语、状语、定语；用于愤怒、惊吓等"},{"id":27824,"word":"毛发耸然","pinyin":"máo fā sǒng rán","abbr":"mfsr","explanation":"毛发竖起。极言惊骇、恐惧。同“毛发悚然”。","source":{"text":"朵思见之，毛发耸然。","book":"明·罗贯中《三国演义》第八十九回"},"example":{"text":"虽然～，心中却也明白。","book":"清·曹雪芹《红楼梦》第一百一回"},"similar":["毛发悚然","毛骨悚然","毛发悚立"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；形容十分恐惧"},{"id":27825,"word":"毛头小子","pinyin":"máo tóu xiǎo zi","abbr":"mtxz","explanation":"指年轻人。","source":{"text":"想不到世事一变，这么个毛头小子倒把他像毛头小子一样指教了一番！","book":"路遥《平凡的世界》第三卷第11章"},"example":{"text":"他是没有经验的～。"},"similar":["毛头小伙"],"usage":"作主语、宾语、定语；指年轻人"},{"id":27826,"word":"毛头毛脑","pinyin":"máo tóu máo nǎo","abbr":"mtmn","explanation":"形容年轻人的鲁莽冒失或很着急的样子。","example":{"text":"汽车抛锚了，他～地敲着车，毫无办法。"},"similar":["毛手毛脚"],"usage":"作定语、状语；指人鲁莽"},{"id":27827,"word":"毛宝放龟","pinyin":"máo bǎo fàng guī","abbr":"mbfg","explanation":"指毛宝帐下军人放养白龟，得白龟酬恩的传说。比喻施恩获报。","source":{"text":"初，宝在武昌，军人有于市买得一白龟，长四五寸，养之渐大，放诸江中。邾城之败，养龟人被铠持刀，自投于水中，如觉堕石上，视之，为先所养白龟，长五六尺，送至岸边。","book":"《晋书·毛宝传》"},"example":{"text":"昔～而得渡，隋侯救蛇而获珠。","book":"明·马中锡《中山狼传》"}},{"id":27828,"word":"毛手毛脚","pinyin":"máo shǒu máo jiǎo","abbr":"msmj","explanation":"毛：举动轻率。做事粗心，不细致。","source":{"text":"可不知怎么又生下我这样尖嘴缩眼，毛手毛脚，这等碜东西来。","book":"明·无名氏《齐天大圣》第三折"},"example":{"text":"但凡有点～的，小人决不用他。（清·石玉昆《三侠五义》第七十六回）"},"similar":["粗心大意","马马虎虎"],"opposite":["认认真真"],"usage":"作补语、定语；指做事粗心"},{"id":27829,"word":"毛施淑姿","pinyin":"máo shī shū zī","abbr":"mssz","explanation":"毛、施：毛嫱、西施；淑：温和善良。形容女子姿容美丽。","source":{"text":"毛施淑姿，工颦妍笑。","book":"《管子·小称》：“毛嫱、西施，天下之美人也。”南朝·梁·周兴嗣《千字文》"},"example":{"text":"俺娘说，你内才儿虽然守真志满，外像儿～，是人家有个上和下睦，偏你石二姐没个夫唱妇随？","book":"二月河《乾隆皇帝》五"}},{"id":27830,"word":"毛森骨立","pinyin":"máo sēn gǔ lì","abbr":"msgl","explanation":"森：阴森；立：竖立。阴森可怖，汗毛都竖了起来。","source":{"text":"是三更时分了，觉一阵风过，吹的我毛森骨立。","book":"元·无名氏《桃花女》第二折"}},{"id":27831,"word":"毛毛楞楞","pinyin":"máo máo lèng lèng","abbr":"mmll","explanation":"慌手慌脚。","example":{"text":"他一进屋就～地脱下外套。"},"similar":["慌手慌脚","毛毛腾腾"],"usage":"作定语、状语；用于方言"},{"id":27832,"word":"毛毛细雨","pinyin":"máo máo xì yǔ","abbr":"mmxy","explanation":"毛：小，细碎。形容雨下得很细。","source":{"text":"那天恰好是个阴天，还落着毛毛细雨。","book":"《刘胡兰传》"},"example":{"text":"每天都下～，让人心烦。"},"similar":["牛毛细雨"],"opposite":["倾盆大雨"],"usage":"作主语、宾语、定语；指小雨"},{"id":27833,"word":"毛毛腾腾","pinyin":"máo máo tēng tēng","abbr":"mmtt","explanation":"形容不沉着，慌里慌张。","source":{"text":"见他们毛毛腾腾，北侠看着，有点诧异。","book":"清·石玉昆《小五义》第91回"},"example":{"text":"请不要～地处理事情。"},"similar":["毛毛楞楞"],"usage":"作定语、状语；用于方言"},{"id":27834,"word":"毛热火辣","pinyin":"máo rè huǒ là","abbr":"mrhl","explanation":"毛：粗率，急躁。形容十分焦急。","source":{"text":"周大勇心里毛热火辣地发躁。","book":"杜鹏程《保卫延安》第五章"},"usage":"作定语、状语；用于人的心情"},{"id":27835,"word":"毛羽未丰","pinyin":"máo yǔ wèi fēng","abbr":"mywf","explanation":"比喻力量不足，条件还不成熟。","source":{"text":"毛羽不丰满者，不可以高飞。","book":"西汉·刘向《战国策·秦策一》"},"example":{"text":"惜此时群治～，又迭经挫折。","book":"杨玉如《辛亥革命先著记》"},"similar":["羽毛未丰"],"opposite":["羽毛丰满"],"usage":"作谓语、定语；指条件还不成熟"},{"id":27836,"word":"毛羽零落","pinyin":"máo yǔ líng luò","abbr":"myll","explanation":"比喻失去了帮手或亲近的人。","source":{"text":"外失辅车唇齿之援，内有毛羽零落之渐。","book":"晋·孙楚《为石仲容与孙皓书》"},"opposite":["羽毛丰满"],"usage":"作定语；指没有帮手"},{"id":27837,"word":"毛羽鳞鬣","pinyin":"máo yǔ lín liè","abbr":"myll","explanation":"鬣：指鱼的背鳍。鸟的羽毛，鱼鳞鱼鳍。指事物的表面现象。","source":{"text":"毛羽鳞鬣之间皆有喜气。","book":"明·袁宏道《满井游记》"},"usage":"作宾语、定语；用于书面语"},{"id":27838,"word":"毛遂堕井","pinyin":"máo suí duò jǐng","abbr":"msdj","explanation":"用为传闻不实之典。","source":{"text":"赵有两毛遂……野人毛遂坠井而死，客以告平原君，平原君曰：‘嗟乎！天丧予矣。’既而知野人毛遂，非平原君客也。","book":"《西京杂记》卷六"},"example":{"text":"毛遂不墮井，曾参宁杀人？虚言误公子，投抒惑慈亲。","book":"唐·李白《系寻阳上崔相涣》诗之二"},"usage":"作宾语、定语；用于比喻句","story":["战国时期，赵国平原君手下食客毛遂自荐为赵国解难，深得平原君的器重。一天，一个叫毛遂的平民堕井而死，一食客听说后立即报告平原君，平原君悲痛欲绝地说：“嗟乎！天丧予矣。”于是下令毛遂的尸体，才证实是同名人而已"]},{"id":27839,"word":"毛遂自荐","pinyin":"máo suí zì jiàn","abbr":"mszj","explanation":"毛遂自我推荐。比喻自告奋勇，自己推荐自己担任某项工作。","source":{"text":"《史记·平原君列传》记载：秦军围攻赵国都城邯郸，平原君去楚国求救，门下食客毛遂自动请求一同前去。到了楚国，毛遂挺身而出，陈述利害，楚王才派兵去救赵国。"},"example":{"text":"我作～，居然被校长核准了。这样才勉强捱过难关。","book":"邹韬奋《经历·深挚的友谊》"},"similar":["自告奋勇"],"opposite":["自惭形秽"],"usage":"作谓语、宾语、定语；指自告奋勇","story":["战国时赵孝成王九年，秦兵攻打赵国，赵孝成王命令平原君赵胜到楚国去求救，平原君的门客毛遂主动自荐随同前去。平原君与楚王谈判半天没有成效，毛遂手拿宝剑走上宫殿，陈述利害关系，终于打动楚王出兵联合抗击秦国的侵略"]},{"id":27840,"word":"毛里拖毡","pinyin":"máo lǐ tuō zhān","abbr":"mltz","explanation":"在毛里拖毡行进困难。比喻畏缩不前的样子。","source":{"text":"好教我足未移心先战，一步步似毛里拖毡。","book":"元·关汉卿《金线池》第四折"},"usage":"作宾语、定语；用于吃力的样子"},{"id":27841,"word":"毛骨悚然","pinyin":"máo gǔ sǒng rán","abbr":"mgsr","explanation":"形容极度惊慌与恐惧。","source":{"text":"那些租户债户见了，赫得毛骨竦然。","book":"清·李渔《比目鱼·狐威》"},"example":{"text":"淑英看得～，淑华看得怒气冲天。","book":"巴金《春》"},"similar":["不寒而栗","胆战心惊"],"opposite":["镇定自若","面无惧色"],"usage":"作谓语、定语、状语；形容十分恐惧"},{"id":27842,"word":"毛骨森竦","pinyin":"máo gǔ sēn sǒng","abbr":"mgss","explanation":"毛：头发和汗毛；骨：脊背。汗毛竖起，脊梁骨发冷。形容非常恐惧。","source":{"text":"想起方才路上光景，不觉毛骨森竦。","book":"清·刘鹗《老残游记》第九回"},"similar":["毛骨悚然","毛发悚立","毛骨竦然"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；形容十分恐惧"},{"id":27843,"word":"毛骨竦然","pinyin":"máo gǔ sǒng rán","abbr":"mgsr","explanation":"毛：头发和汗毛；骨：脊背。形容极度惊慌与恐惧","source":{"text":"忽然一阵冷风，吹得毛骨竦然。","book":"明·冯梦龙《醒世恒言》第34卷"},"example":{"text":"巴金《春》：“淑英看得～，淑华看得怒气冲天。”"},"similar":["毛骨悚然"],"opposite":["镇定自若"],"usage":"作定语、状语；指十分恐惧"},{"id":27844,"word":"毛骨耸然","pinyin":"máo gǔ sǒng rán","abbr":"mgsr","explanation":"形容极度恐惧与惊慌。","source":{"text":"许武叠两个指头，说将出来。言无数句，使听者毛骨耸然。","book":"明·冯梦龙《醒世恒言·三孝廉让产立高名》"},"example":{"text":"这笑，老赵听了，却～。","book":"茅盾《过年》"},"similar":["毛骨悚然","毛骨竦然"],"opposite":["面不改色"],"usage":"作谓语；指十分害怕"},{"id":27845,"word":"毡上拖毛","pinyin":"zhān shàng tuō máo","abbr":"zstm","explanation":"氈为毛制，在氈上拖毛，则涩滞难行。用以形容脚步畏缩不前。","source":{"text":"鲁智深窟里拔蛇……宋公明似毡上拖毛。","book":"元·纪君祥《赵氏孤儿》第一折：“我着你去呵，似弩箭离弦，叫你回来呵，便似毡上拖毛。程婴，你则道我不认的你哩！”元·康进之《李逵负荆》第三折"},"usage":"作宾语、定语；指行动难"},{"id":27846,"word":"毡袜裹脚靴","pinyin":"zhān wà guǒ jiǎo xuē","abbr":"zwgjx","explanation":"毡袜、裹脚、靴子，都是穿在脚上的东西。比喻彼此都一样。","source":{"text":"而今这银子我也不问是你出是他出，你们原是毡袜裹脚靴，但须要我效劳的来。","book":"清·吴敬梓《儒林外史》第十四回"},"usage":"作主语、宾语、定语；指彼此都一样"},{"id":27847,"word":"毫不介怀","pinyin":"háo bù jiè huái","abbr":"hbjh","explanation":"介：留存，搁置；介怀：放在心上。对不愉快或不满意的事，一点也不放在心上。","source":{"text":"于是生资皆尽，不以介怀。","book":"《南史·张盾传》"},"example":{"text":"对此不惟～，且愿趁此为陛下举荐贤材，为国效力。","book":"姚雪垠《李自成》第一卷第二十二章"},"similar":["毫不介意","毫不经意"],"opposite":["小肚鸡肠","斤斤计较"],"usage":"作谓语；指丝毫不往心里去"},{"id":27848,"word":"毫不介意","pinyin":"háo bù jiè yì","abbr":"hbjy","explanation":"介：留存，搁置；介意：放在心上。对不愉快或不满意的事，一点也不放在心上。","source":{"text":"于是生资皆尽，不以介怀。","book":"《南史·张盾传》"},"example":{"text":"我当时虽然觉得圈得可笑，但是～，这回才悟出那字也在讥刺我了。","book":"鲁迅《藤野先生》"},"similar":["毫不在乎","毫不在意"],"opposite":["斤斤计较"],"usage":"作谓语；指丝毫不往心里去"},{"id":27849,"word":"毫不关心","pinyin":"háo bù guān xīn","abbr":"hbgx","explanation":"对人对事态度冷淡，丝毫不在意。","source":{"text":"有的部分对群众利益毫不关心，而尽情地耗费人力和物力。","book":"邓小平《贯彻执行中共中央关于土改与整党工作的指示》"},"example":{"text":"林海音《晚晴》：“他竟变得对桥牌～了。”"},"similar":["漠不关心"],"opposite":["关怀备至"],"usage":"作谓语、定语、状语；指态度冷淡"},{"id":27850,"word":"毫不利己，专门利人","pinyin":"háo bù lì jǐ，zhuān mén lì rén","abbr":"hbljzmlr","explanation":"丝毫不为个人利益着想，一心一意做有利于他人的事情。","source":{"text":"白求恩同志毫不利己专门利人的精神，表现在他对工作的极端负责任，对同志对人民的极端热忱。","book":"毛泽东《纪念白求恩》"},"example":{"text":"他～，赢得了人民群众的拥护。"},"similar":["大公无私","公而忘私"],"opposite":["自私自利"],"usage":"作谓语、宾语；指人大公无私"},{"id":27851,"word":"毫不动摇","pinyin":"háo bù dòng yáo","abbr":"hbdy","explanation":"丝毫也不会改变意志。","source":{"text":"愚公批驳了智叟的错误思想，毫不动摇，每天挖山不止。","book":"毛泽东《愚公移山》"},"example":{"text":"面对丰厚的物质诱惑，她的心～。"},"similar":["立场坚定","坚定不移"],"opposite":["飘浮不定"],"usage":"作谓语、定语、状语；用于人的立场等"},{"id":27852,"word":"毫不含糊","pinyin":"háo bù hán hú","abbr":"hbhh","explanation":"态度明确坚定。","source":{"text":"关于这种政策改变的客观原因和时间性，我们曾经毫不含糊地说明了自己的观点。","book":"毛泽东《国共合作成立的迫切任务》"},"example":{"text":"他们没有忘记人民，没有忘记党的教导，没有忘记国家利益，面对死亡～。","book":"邓小平《在接见首都戒严部队军以上干部时的讲话》"},"similar":["斩钉截铁"],"opposite":["拖泥带水"],"usage":"作谓语、定语、状语；用于人的态度、处事"},{"id":27853,"word":"毫不在乎","pinyin":"háo bù zài hū","abbr":"hbzh","explanation":"毫：丝毫，形容细小；在乎：在意。形容丝毫不在意、无所谓的样子。","source":{"text":"但仍然毫不在乎地开着车来到这偏僻山庄，给生活于困境的孤儿寡母送这送那，关怀备至……","book":"路遥《平凡的世界》第四卷第47章"},"example":{"text":"他对此事～。"},"similar":["满不在乎"],"usage":"作谓语、宾语、状语；形容丝毫不在意"},{"id":27854,"word":"毫不在意","pinyin":"háo bù zài yì","abbr":"hbzy","explanation":"丝毫不在乎或不介意。","source":{"text":"我佛原是个大慈大悲之主，毫不在意。","book":"清·钱彩《说岳全传》第一回"},"example":{"text":"清·钱彩《说岳全传》第一回：“我佛原是个大慈大悲之主，毫不在意。”"},"similar":["毫不在乎"],"opposite":["耿耿于怀"],"usage":"作谓语、定语、状语；用于处事"},{"id":27855,"word":"毫不犹豫","pinyin":"háo bù yóu yù","abbr":"hbyy","explanation":"毫：一点儿；犹豫：迟疑，拿不定主意。一点儿也不迟疑。","source":{"text":"第二次杜修经、杨开明来，主张红军毫不犹豫地向湘南发展。","book":"毛泽东《井冈山的斗争》"},"example":{"text":"我～地跳了进来，就再也不去了。","book":"《会摇尾巴的狼》"},"similar":["毫不迟疑"],"opposite":["迟疑不决"],"usage":"作谓语、状语；指很果断"},{"id":27856,"word":"毫不留情","pinyin":"háo bù liú qíng","abbr":"hblq","explanation":"指人丝毫不给别人留情面。","source":{"text":"恼的是这个狗官不知听了谁的唆使，毫不留情。","book":"清·吴趼人《二十年目睹之怪现状》第96回"},"example":{"text":"他～地开除了她。"},"opposite":["留有余地"],"usage":"作谓语、定语、状语；指人不讲情面"},{"id":27857,"word":"毫不相干","pinyin":"háo bù xiāng gān","abbr":"hbxg","explanation":"指丝毫没有任何联系。","source":{"text":"其实，月球并无分别，只是半个明，半个暗，盈亏圆缺，都是人眼睛现出来的景相，与月球毫不相干。","book":"清·刘鹗《老残游记》第十回"},"example":{"text":"不只是她，城里的所有市民谁留心这些和自己～的事呢？","book":"路遥《平凡的世界》第三卷第23章"},"similar":["毫不相关"],"usage":"作谓语、定语、状语；用于两种关系等"},{"id":27858,"word":"毫不经意","pinyin":"háo bù jīng yì","abbr":"hbjy","explanation":"毫：丝毫。指丝毫不往心里去。","source":{"text":"警长毫不经意的，从那黑泥中插过去，昂昂地跨着大的踏步。","book":"葛琴《罗警长》"},"example":{"text":"他那～的态度让人置疑。"},"similar":["毫不介意"],"usage":"作定语、状语；指丝毫不往心里去"},{"id":27859,"word":"毫不讳言","pinyin":"háo bù huì yán","abbr":"hbhy","explanation":"讳言：有顾虑，不愿把真实情况说出来。丝毫也没有隐讳不说的。","example":{"text":"他是个直肠子，说话～。"},"usage":"作谓语、宾语、分句；用于说话"},{"id":27860,"word":"毫不迟疑","pinyin":"háo bù chí yí","abbr":"hbcy","explanation":"毫：一点儿。一点儿也不迟疑。","source":{"text":"他们毫不迟疑地向土豪劣绅营垒进攻。","book":"毛泽东《湖南农民运动考察报告》"},"example":{"text":"在两分钟之内，列车把一些旅客抛在淋着雨的小站，就～地顶着雨向西冲去。","book":"柳青《创业史》"},"similar":["毫不犹豫","毫不怀疑"],"opposite":["犹豫不决"],"usage":"作谓语、状语；指很果断"},{"id":27861,"word":"毫分缕析","pinyin":"háo fēn lǚ xī","abbr":"hflx","explanation":"细致详尽的剖析。","source":{"text":"凡本府委送剖决民讼，毫分缕析，多得其情。","book":"《云谷杂记》附宋·张嗣古《特荐状》"},"example":{"text":"至论其学术，则一以考亭、朱子为宗，～，洞见其肯。","book":"明·宋溓《故务光先生张公墓碣铭》"},"usage":"作谓语、状语；用于处事"},{"id":27862,"word":"毫厘不爽","pinyin":"háo lí bù shuǎng","abbr":"hlbs","explanation":"毫：细毛；发：头发；爽：差错。形容一点不差。","source":{"text":"便是心中许多道理，光明鉴照，毫发不差。","book":"宋·朱熹《朱子语类》卷十四"},"example":{"text":"此见神理分明，～。","book":"清·纪昀《阅微草堂笔记·姑妄听之》"},"similar":["毫发不爽"],"opposite":["大相径庭","天差地别"],"usage":"作谓语、宾语；形容一点不差"},{"id":27863,"word":"毫厘丝忽","pinyin":"háo lí sī hū","abbr":"hlsh","explanation":"古代“分”以下四个微小长度单位的并称。喻指极微细的事物。","source":{"text":"我来时不知吃了多少苦楚，真个性命是毫厘丝忽上挣来的。","book":"《醒世恒言·李道人独步云门》"},"usage":"作宾语、定语；形容微小"},{"id":27864,"word":"毫厘千里","pinyin":"háo lí qiān lǐ","abbr":"hlql","explanation":"毫、厘：两种极小的长度单位。开始时虽然相差很微小，结果会造成很大的错误。","source":{"text":"《易》曰：‘君子慎始，差若毫厘，缪以千里。’","book":"《礼记·经解》"},"example":{"text":"若认此法便可超凡入圣，岂非～之谬！","book":"明·施耐庵《水浒全传》第九十七回"},"similar":["差之毫厘，谬以千里"],"usage":"作宾语、定语；指差距大"},{"id":27865,"word":"毫发不爽","pinyin":"háo fà bù shuǎng","abbr":"hfbs","explanation":"毫：细毛；发：头发；爽：差错。形容一点不差。","source":{"text":"便是心中许多道理，光明鉴照，毫发不差。","book":"宋·朱熹《朱子语类》卷十四"},"example":{"text":"呼邻问之，则市肉方归。言其片数斤数，～。","book":"清·蒲松龄《聊斋志异·邑人》"},"similar":["不失分毫","丝毫不差","不差累黍"],"opposite":["截然不同","大相径庭","天差地别"],"usage":"作谓语、宾语；形容一点不差"},{"id":27866,"word":"毫发丝粟","pinyin":"háo fā sī sù","abbr":"hfss","explanation":"形容极其微小。","source":{"text":"诸公巨人踵武相接，天下毫发丝粟之才，皆得以牵连成就，况若伯强之卓然能自见者乎！","book":"宋·陈亮《跋焦伯强帖》"},"usage":"作宾语、定语；形容小事物等"},{"id":27867,"word":"毫发无憾","pinyin":"háo fà wú hàn","abbr":"hfwh","explanation":"毫发：细毛和头发，指极微小的数量；憾：心感不足，不满意。一点令人感到遗憾的地方也没有。形容非常完美。","source":{"text":"思飘云物外，律中鬼神惊。毫发无遗憾，波澜独老成。","book":"唐·杜甫《敬赠郑谏议十韵》"},"example":{"text":"后读程泰之《演繁露》，证据精祥，可谓～矣。","book":"明·胡应麟《少室山房笔丛》卷四十"}},{"id":27868,"word":"毫发无遗","pinyin":"háo fà wú yí","abbr":"hfwy","explanation":"毫发：细毛和头发，指极微小的数量；遗：疏漏。一点遗漏都没有。形容非常细致周密。","source":{"text":"臣当修撰之时，史官沈传师等采事得于传闻，诠次不精，致有差误，圣明所鉴，毫发无遗。","book":"唐·韩愈《进顺宗皇帝实录表状》"},"usage":"作定语、状语；用于事物等"},{"id":27869,"word":"毫无二致","pinyin":"háo wú èr zhì","abbr":"hwez","explanation":"二致：两样。丝毫没有什么两样。指完全一样。","source":{"text":"佘道台见了这副神气，更觉得同花小红一式一样，毫无二致。","book":"清·李宝嘉《官场现形记》第二十九回"},"example":{"text":"那时候的文体的变革和近代的文学革命，由文言文改为白话文的，实在是～。","book":"郭沫若《屈原研究》"},"similar":["一模一样"],"opposite":["天差地别"],"usage":"作谓语、定语；指完全一样"},{"id":27870,"word":"毫无例外","pinyin":"háo wú lì wài","abbr":"hwlw","explanation":"指全部如此，没有例外。","source":{"text":"我们所有的企业必须毫无例外地实行民主管理，使集中领导和民主管理结合起来。","book":"邓小平《工人阶级要为实现四个现代化作出优异贡献》"},"similar":["毫不例外"],"usage":"作谓语、定语、状语；用于口语"},{"id":27871,"word":"毫无所得","pinyin":"háo wú suǒ dé","abbr":"hwsd","explanation":"一点儿也没有得到。","source":{"text":"又在我藏躲地方的周围，低头注目搜寻了一番，也毫无所得，他们是多么失望呵！","book":"方志敏《清贫》"},"example":{"text":"这场较量让我～。"},"similar":["一无所得"],"opposite":["满载而归"],"usage":"作谓语；用于事情的结果"},{"id":27872,"word":"毫无疑义","pinyin":"háo wú yí yì","abbr":"hwyy","explanation":"疑义：可疑之理。一点也没有可以怀疑的地方。表示完全明确肯定。","source":{"text":"怎么他毫无疑义，就照五百两一条命算呢？这是第二据。","book":"清·刘鹗《老残游记》第十六回"},"example":{"text":"我们的工作成绩是很显然的，～的。","book":"毛泽东《论联合政府》"},"similar":["不容置疑"],"opposite":["大有可疑","满腹疑团"],"usage":"作谓语、状语；表示完全明确肯定"},{"id":27873,"word":"毫无疑问","pinyin":"háo wú yí wèn","abbr":"hwyw","explanation":"不存在问题，十分肯定。","source":{"text":"毫无疑问，他们的这种威信、影响和经验乃是党、阶级和人民的宝贵财富。","book":"邓小平《关于修改党的章程的报告》"},"example":{"text":"～，这事跟她有直接关系。"},"similar":["毫无疑义"],"usage":"作谓语、分句；指十分肯定"},{"id":27874,"word":"毫无逊色","pinyin":"háo wú xùn sè","abbr":"hwxs","explanation":"表示比得上，丝毫不差。","example":{"text":"这篇文章同大师的作品相比～。"},"similar":["毫不逊色"],"usage":"作谓语、定语；用于比较"},{"id":27875,"word":"毫无顾忌","pinyin":"háo wú gù jì","abbr":"hwgj","explanation":"对违反道德的行为丝毫没有反感或犹豫，或不考虑对人对事情的利害关系，没有顾虑。","source":{"text":"我毫无顾忌地拿起漆满茶垢的茶碗舀水喝，还把自己的水壶灌满。","book":"余华《活着》"},"example":{"text":"她对做错了这个零件～。"},"similar":["毫不顾忌"],"usage":"作谓语、定语；指不考虑别人"},{"id":27876,"word":"毫无顾虑","pinyin":"háo wú gù lǜ","abbr":"hwgl","explanation":"丝毫没有后顾之忧。","source":{"text":"使我们的红军毫无顾虑地在将来顺利的条件下去打南昌，打九江。","book":"毛泽东《必须注意经济工作》"},"similar":["毫无顾忌"],"usage":"作谓语、定语、状语；用于处事"},{"id":27877,"word":"毫末不札，将寻斧柯","pinyin":"háo mò bù zhā，jiāng xún fǔ kē","abbr":"hmbzjxfk","explanation":"比喻祸害萌生时若不重视，酿成大患，再要消除，就很困难。","source":{"text":"札，拔也；寻，用者也。","book":"《孔子家语·观周》：“勿谓何伤，其祸将长；勿谓何害，其祸将大……焰焰不灭，炎炎若何？涓涓不壅，终为江河；绵绵不绝，或成网罗；毫末不札，将寻斧柯。”王肃注"},"example":{"text":"《金人铭》曰：‘涓涓不壅，将为江河；～。’古人所见远矣。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录五》"},"similar":["豪厘不伐，将用斧柯"],"usage":"作宾语、定语；用于劝诫人"},{"id":27878,"word":"毫末之利","pinyin":"háo mò zhī lì","abbr":"hmzl","explanation":"毫：细毛；末：不重要的，轻微不足道的事物。极微小的利益。","source":{"text":"有司屡变其法，以争毫末之利。","book":"宋·欧阳修《原弊》"},"similar":["蝇头小利"],"usage":"作主语、宾语；用于处事"},{"id":27879,"word":"毫末之差","pinyin":"háo mò zhī chā","abbr":"hmzc","explanation":"指由于微小的失误而造成巨大的差错。","example":{"text":"我们不能忽视～，否则将会酿成大祸的。"},"similar":["毫厘千里"],"usage":"作宾语、定语；用于处事"},{"id":27880,"word":"毫毛不犯","pinyin":"háo máo bù fàn","abbr":"hmbf","explanation":"毫：细毛。一丝一毫也不侵占。形容非常廉洁或守纪律。","source":{"text":"纯独清廉，毫毛不犯，夷汉歌叹，表闻三司。","book":"晋·常璩《华阳国志·广汉士女》"},"example":{"text":"广汉郑纯，独尚清廉，～，夷汉歌咏，表荐无数。","book":"《南中志·宁州》"},"similar":["秋毫不犯"],"usage":"作谓语、定语；指军纪严明"},{"id":27881,"word":"毫毛斧柯","pinyin":"háo máo fǔ kē","abbr":"hmfk","explanation":"毫：细毛；柯：斧柄。很小很细的杂木如果不被拔除，那么它就会长成像斧柄那样粗的树木。比喻微小的隐患不除，将有可能酿成大祸。","source":{"text":"周书曰：‘绵绵不绝，蔓蔓奈何。毫毛不拔，将成斧柯。’前虑不定，后有大患，将奈之何？","book":"《战国策·魏策一》"}},{"id":27882,"word":"民不堪命","pinyin":"mín bù kān mìng","abbr":"mbkm","explanation":"堪：忍受；命：命令。民众负担沉重，痛苦得活不下去。","source":{"text":"宋殇公立，十年十一战，民不堪命。","book":"《左传·桓公二年》"},"example":{"text":"由今之道，且顿变而为千万无赖之尤，～矣，于兴国究何与焉。","book":"鲁迅《坟·文化偏至论》"},"similar":["民不聊生"],"opposite":["国泰民安"],"usage":"作谓语、定语、补语；指不堪忍受"},{"id":27883,"word":"民不安枕","pinyin":"mín bù ān zhěn","abbr":"mbaz","explanation":"安：安稳。人民不能安心睡觉。形容生活极不稳定。","source":{"text":"被他这一闹，却闹得人心皇皇，民不安枕了。","book":"清·李宝嘉《文明小史》第43回"},"similar":["民不聊生"],"usage":"作谓语、定语、状语；指生活不安定"},{"id":27884,"word":"民不畏威","pinyin":"mín bù wèi wēi","abbr":"mbww","explanation":"畏：害怕；威：威胁。人民不害怕威胁。形容人民的大无畏气概。","source":{"text":"民不畏威，则大威至矣。","book":"《老子》第七十二章"}},{"id":27885,"word":"民不畏死","pinyin":"mín bù wèi sǐ","abbr":"mbws","explanation":"畏：惧怕。人民不怕死。形容不怕死的气慨。","source":{"text":"民不畏死，奈何以死惧之。","book":"《老子》第七十四章"},"example":{"text":"夫～，欲其不为陈胜、吴广、赤眉、铜马之纷纷发难，不可得也。","book":"姚雪垠《李自成》第二卷第四十三章"},"usage":"作宾语、定语；用于书面语"},{"id":27886,"word":"民不聊生","pinyin":"mín bù liáo shēng","abbr":"mbls","explanation":"聊：依赖，凭借。指老百姓无以为生，活不下去。","source":{"text":"财匮力尽，民不聊生。","book":"《史记·张耳陈余列传》"},"example":{"text":"在那些年月，军阀混战，土匪横行，～。","book":"冯德英《迎春花》第八章"},"similar":["民穷财尽"],"opposite":["丰衣足食"],"usage":"作谓语、定语、补语、状语；指社会腐败","story":["战国末年，秦昭王派大将白起攻打韩国、魏国，消灭了他们24万联军，然后去进攻楚国，假意与韩魏和好。楚国贵族黄歇给秦昭王上书说：“你把韩魏弄得民不聊生，他们最恨你，你如借道韩魏进攻楚国，他们军队倒戈一击怎么办？”"]},{"id":27887,"word":"民为邦本","pinyin":"mín wéi bāng běn","abbr":"mwbb","explanation":"邦：国家。百姓是国家的根本。","source":{"text":"皇祖有训，民可近不可下。民惟邦本，本固邦宁。","book":"春秋·鲁·孔丘《论语·五子之歌》"},"example":{"text":"作为领导者应该明白～的道理。"},"similar":["载舟覆舟","民惟邦本"],"usage":"作宾语、定语；用于劝诫统治者","story":["夏朝时期，禹的孙子太康即位，他荒淫无度，百姓为之悲哀，他到洛水南面去打猎，穷国君主羿趁机篡夺了夏国的政权。太康的弟弟做《五子之歌》：“皇祖有训，民可近不可下。民惟邦本，本固邦宁。”","中康起兵恢复了夏国"]},{"id":27888,"word":"民为邦本，本固邦宁","pinyin":"mín wéi bāng běn，běn gù bāng níng","abbr":"mwbbbgbn","explanation":"邦：国家。百姓是国家的根本，只有根本稳固，国家才能安宁。","source":{"text":"皇祖有训，民可近不可下。民惟邦本，本固邦宁。","book":"《尚书·五子之歌》"},"example":{"text":"～。要人民安乐，先要让他们衣食无缺。","book":"冯玉祥《我的生活》第十九章"}},{"id":27889,"word":"民以食为天","pinyin":"mín yǐ shí wéi tiān","abbr":"myswt","explanation":"天：比喻赖以生存的最重要的东西。人民以粮食为自己生活所系。指民食的重要。","source":{"text":"天：比喻赖以生存的最重要的东西。人民以粮食为自己生活所系。指民食的重要。"},"example":{"text":"《汉书·郦食其传》：“王者以民为天，而民以食为天。”"},"similar":["国以粮为本"],"usage":"作宾语、定语；指粮食的重要性","story":["楚汉相争时期，刘邦与项羽在颖阳一带打仗，由于没有后援，刘邦准备放弃敖山粮仓，找谋士郦食其商量。郦食其认为称王要依赖百姓，百姓又依赖粮食。要想赢得战争，必须占据敖仓，才能稳住军心。刘邦赞同并奋勇作战取得了胜利"]},{"id":27890,"word":"民以食为本","pinyin":"mín yǐ shí wéi běn","abbr":"myswb","explanation":"民众以粮食为根本。","source":{"text":"常言道大富由天，小富由勤，民以食为本。","book":"明·无名氏《拔宅飞升》第一折"},"similar":["民以食为天"],"usage":"作宾语、定语；指粮食的重要性"},{"id":27891,"word":"民保于信","pinyin":"mín bǎo yú xìn","abbr":"mbyx","explanation":"指执政的人有信还要有义，才能受到人民拥护。","source":{"text":"谚曰：‘民保于信。’吾以信义也。","book":"《左传·定公十四年》"},"example":{"text":"夫信者，人君之大宝也。国保于民，～。","book":"《资治通鉴·周纪·显王十年》"},"usage":"作宾语、定语；用于劝诫人"},{"id":27892,"word":"民力凋弊","pinyin":"mín lì diāo bì","abbr":"mldb","explanation":"人民生活穷困。","source":{"text":"当武帝之世，赋役烦众，民力凋弊。","book":"汉·荀悦《汉纪·武帝纪四》"}},{"id":27893,"word":"民力凋敝","pinyin":"mín lì diāo bì","abbr":"mldb","explanation":"凋敝：破落，衰败。人民生活穷困。","source":{"text":"当武帝之世，赋役烦众，民力凋敝。","book":"汉·荀悦《汉纪·武帝纪四》"},"example":{"text":"亦因连年战事，～，财政枯竭，即派遣代表旅费，往往筹措维艰，迟延甚久，或竟终止。","book":"丁中江《北洋军阀史话》一七四"}},{"id":27894,"word":"民力雕弊","pinyin":"mín lì diāo bì","abbr":"mldb","explanation":"雕弊：困苦，衰败。社会经济衰败，人民生活困苦。","source":{"text":"当武帝之时，赋役烦众，民力雕弊。","book":"汉·荀悦《汉纪·武帝纪》"},"similar":["民生凋敝"],"opposite":["国富民强"],"usage":"作谓语、定语、补语；指人民生活困苦"},{"id":27895,"word":"民变蜂起","pinyin":"mín biàn fēng qǐ","abbr":"mbfq","explanation":"蜂起：如群蜂飞舞一般。旧指人民反抗斗争蜂拥而起。","source":{"text":"陈涉首难，豪杰蜂起。","book":"《史记·项羽本纪》"},"example":{"text":"使得它自己和广大人民之间发生了深刻的裂痕，造成了民生凋敝、民怨沸腾、～的严重危机。","book":"毛泽东《论联合政府》"}},{"id":27896,"word":"民可使由之，不可使知之","pinyin":"mín kě shǐ yóu zhī，bǔ kě shǐ zhī zhī","abbr":"mksyzbkszz","explanation":"由：顺从；之：统治者的意志和要求。老百姓只可以让他们按照统治者的意志和要求去做，不可以让他们知道为什么这样做。","source":{"text":"民可使由之，不可使知之。","book":"《论语·泰伯》"},"example":{"text":"还是让他照原文背吧，～。好好的经典都弄成四不象了。","book":"二月河《乾隆皇帝》十七"}},{"id":27897,"word":"民和年丰","pinyin":"mín hé nián fēng","abbr":"mhnf","explanation":"百姓安居，年成很好。","source":{"text":"奉盛以告曰：‘洁粢丰盛’，谓其三时不害而民和年丰也。","book":"《左传·桓公六年》"},"example":{"text":"闻外间人多宴乐，想是～，所以得此佳象，良慰朕怀。","book":"蔡东藩《唐史演义》第七十七回"},"similar":["民和年稔","民安物阜"],"usage":"作宾语、定语；指时局"},{"id":27898,"word":"民和年稔","pinyin":"mín hé nián rěn","abbr":"mhnr","explanation":"犹言民乐年丰。","source":{"text":"幸赖股肱御侮之助，残丑消荡，民和年稔，普天率土，遐迩洽同。","book":"《后汉书·孝桓帝纪》"},"similar":["民和年丰"],"usage":"作宾语、定语；指时局"},{"id":27899,"word":"民困国贫","pinyin":"mín kùn guó pín","abbr":"mkgp","explanation":"人民困苦，国家贫穷。","source":{"text":"当此天灾岁旱，民困国贫之际，不量人力，不顺天时，知其有大不可者五。","book":"《宋史·河渠志一》"},"example":{"text":"此天灾岁旱、～之际，不量人力，不顺天时，知其有大不可者五……","book":"清·毕沅《续资治通鉴》卷五十五"},"opposite":["国富民强"],"usage":"作宾语、定语；用于时局"},{"id":27900,"word":"民安国泰","pinyin":"mín ān guó tài","abbr":"magt","explanation":"泰：平安，安定。国家太平，人民安乐。","source":{"text":"每岁海潮太溢，冲激州城，春秋醮祭，诏命学士院，撰青词以祈国泰民安。","book":"宋·吴自牧《梦梁录·山川神》"},"example":{"text":"百姓每家家庆，庆道是～，法正官清。","book":"元·宫大用《垂钓七里滩》第三折"},"similar":["国泰民安"],"opposite":["兵荒马乱"],"usage":"作谓语、宾语；同“国泰民安”"},{"id":27901,"word":"民安物阜","pinyin":"mín ān wù fù","abbr":"mawf","explanation":"阜：多。社会安定，物资丰富。形容太平盛世的景象。","source":{"text":"皆因中国雨顺风调，民安物阜。","book":"明·朱有燉《灵芝庆寿》第一折"},"example":{"text":"天下和乐，四海人又安。虽未敢谓家给人足，俗易风移，而欲使～之心，始终如一。","book":"《清史稿·圣祖纪三》"},"similar":["民康物阜"],"usage":"作宾语、定语；指社会状况"},{"id":27902,"word":"民富国强","pinyin":"mín fù guó qiáng","abbr":"mfgq","explanation":"人民富裕，国家强盛。","source":{"text":"越主内实府库，垦其田畴，民富国强，众安道泰。","book":"汉·赵晔《吴越春秋·勾践归国外传》"},"example":{"text":"我们中国现在可以说是～了。"},"similar":["国富民强"],"opposite":["民不聊生"],"usage":"作宾语、定语；指国力强盛"},{"id":27903,"word":"民康物阜","pinyin":"mín kāng wù fù","abbr":"mkwf","explanation":"阜：多。人民平安，物产丰富。形容社会安定，经济繁荣的景象。","source":{"text":"皆因中国雨顺风调，民安物阜。","book":"明·朱有燉《灵芝庆寿》第一折"},"example":{"text":"可见当时君明臣良，～，致治之隆非无故也。（清·郑观应《盛世危言·吏治下》）"},"similar":["民安物阜","国泰民安"],"usage":"作宾语、定语；指社会状况"},{"id":27904,"word":"民心不一","pinyin":"mín xīn bù yī","abbr":"mxby","explanation":"老百姓思想不一致。","source":{"text":"晋侯谓伯瑕曰：‘吾所问日食从矣，可常乎？’对曰：‘不可，六物不同，民心不一。’","book":"《左传·昭公七年》"},"example":{"text":"上四心，下四心，宁德～；外十口，内十口，古田户口何多。"}},{"id":27905,"word":"民心不壹","pinyin":"mín xīn bù yī","abbr":"mxby","explanation":"人民的心意不一致。","source":{"text":"六物不同，民心不壹，事序不类，官职不则，同始异终，胡可常也？","book":"《左传·昭公七年》"},"example":{"text":"永与陛下系出同宗，乃独僭称尊号，煽动华夷，惑民视听……今若不先加除灭，恐～，后患方长，怎得谓不足深忧！","book":"蔡东藩《两晋演义》第七十五回"}},{"id":27906,"word":"民心无常","pinyin":"mín xīn wú cháng","abbr":"mxwc","explanation":"常：长久。百姓的思想没有经久不变的。指民心将随着政治的清明与昏暗发生变化。","source":{"text":"皇天无亲，惟德是辅，民心无常，惟惠之怀。","book":"《尚书·蔡仲之命》"},"example":{"text":"书不云乎：皇天无亲，惟德是辅，～，惟惠之怀。","book":"蔡东藩《南北史演义》第二十六回"}},{"id":27907,"word":"民怨沸腾","pinyin":"mín yuàn fèi téng","abbr":"myft","explanation":"人民的怨声就象开水在翻滚一样。形容人民对腐败黑暗的反动统治怨恨到了极点。","source":{"text":"自古大兵大役，未有不民怨沸腾，丧国亡身者。","book":"清·赵翼《二十二史札记》卷二十八"},"example":{"text":"上半年在那里办过几个月厘局，不该应要钱的心太狠了，直弄得～，有无数商人来省上控。","book":"清·李宝嘉《官场现形记》第五回"},"similar":["怨声载道"],"opposite":["有口皆碑"],"usage":"作谓语、状语；指人们怨声载道"},{"id":27908,"word":"民怨盈涂","pinyin":"mín yuàn yíng tú","abbr":"myyt","explanation":"怨：怨恨；涂：通“途”；盈涂：充满道路。人民的怨恨充满道路。形容人民的怨恨情绪非常大。","source":{"text":"败道伤俗，悖乱人神，忆怨盈涂，国谤弥岁。","book":"《宋书·臧质传》"}},{"id":27909,"word":"民怨神怒","pinyin":"mín yuàn shén nù","abbr":"mysn","explanation":"百姓怨恨，天神愤怒。形容作恶太甚，引进极大愤怒。","source":{"text":"不惮鬼神，神怒民痛，无悛于心。","book":"《晏子春秋·外篇七》"},"example":{"text":"赋役不均，财用不节，民～，感伤和气，惟陛下裁择以答天意，消弭灾变。","book":"蔡东藩《元史演义》第三十七回"}},{"id":27910,"word":"民情土俗","pinyin":"mín qíng tǔ sú","abbr":"mqts","explanation":"一地的人情世故，风俗习惯。","source":{"text":"到任诸事皆毕，薛举体访民情土俗，颁号令约束军民人等、差心腹将土巡按州县，拿问贪官污吏，访察巨恶积奸。","book":"明·清溪道人《禅真逸史》第三十八回"},"example":{"text":"顺德近接省会，～，仕弟必一一措置得宜。","book":"清·恽敬《与福子申》"},"similar":["风土人情"],"usage":"作主语、宾语、定语；指风俗习惯"},{"id":27911,"word":"民情物理","pinyin":"mín qíng wù lǐ","abbr":"mqwl","explanation":"人情事理。","source":{"text":"民情物理之隐微，无不了如指掌。","book":"清·钱泳《履园丛话·廿一经》"},"similar":["人情事理"],"usage":"作主语、宾语、定语；指人情事理"},{"id":27912,"word":"民惟邦本","pinyin":"mín wéi bāng běn","abbr":"mwbb","explanation":"惟：乃，是；邦：国家。人民是立国之本。","source":{"text":"皇祖有训，民可近不可下。民惟邦本，本固邦宁。","book":"《尚书·五子之歌》"},"example":{"text":"～，伤本以敛怨，亦非宰相福也。","book":"《元史·岳柱传》"},"similar":["民为邦本"],"usage":"作宾语、定语；用于劝诫统治者"},{"id":27913,"word":"民无信不立","pinyin":"mín wú xìn bù lì","abbr":"mwxbl","explanation":"无信：缺乏信任；不立：立不起来人民如果对国家缺乏信任，这个国家就不稳固。","source":{"text":"自古皆有死，民无信不立。","book":"《论语·颜渊》"},"example":{"text":"～。咱们开会不挂自家儿旗，是公开欺骗老百姓。","book":"冯雪峰《山盗和他们的旗》"}},{"id":27914,"word":"民无噍类","pinyin":"mín wú jiào lèi","abbr":"mwjl","explanation":"噍类：指能吃东西的动物，特指活人。老百姓没有活路了。","example":{"text":"这地方让敌人搞得～。"},"similar":["民不堪命"],"usage":"作谓语、定语、状语；指老百姓没有活路了","story":["南宋时期，岳飞率领岳家军英勇抗击金军，经过十年战争，很快要打到金国首都黄龙府。宋高宗一天之内发12道金牌命岳飞撤军。岳飞下令撤军，当地的老百姓纷纷哀求他们留下，说宋军撤走老百姓就再也没有活路了，金兵会反攻倒算的"]},{"id":27915,"word":"民有菜色","pinyin":"mín yǒu cài sè","abbr":"mycs","explanation":"菜色：饥饿的脸色。形容因饥饿而显得营养不良的样子。","source":{"text":"岁比灾害，民有菜色。","book":"《汉书·元帝纪》"},"example":{"text":"入其朝，不闻直言；经其野，～。","book":"明·罗贯中《三国演义》第一百十三回"},"usage":"作定语；指营养不良的样子"},{"id":27916,"word":"民殷国富","pinyin":"mín yīn guó fù","abbr":"mygf","explanation":"殷：殷实，富足；阜：丰富。国家人民殷实富裕。","source":{"text":"民殷国富而不知存恤。","book":"《三国志·蜀志·诸葛亮传》"},"example":{"text":"今刘璋暗弱，～，而不知存恤，智能之士，思得明君。","book":"明·罗贯中《三国演义》第三十八回"},"similar":["国富民强"],"usage":"作谓语、定语；用于时局"},{"id":27917,"word":"民殷财阜","pinyin":"mín yīn cái fù","abbr":"mycf","explanation":"殷：殷实，富足；阜：丰富。民众富足，物产丰饶。","source":{"text":"君人者务在殷民阜财，明道信义。","book":"汉·扬雄《法言·孝至》"},"example":{"text":"夫欲～，要在止役禁夺，则百姓不劳而足。","book":"《后汉书·刘陶传》"},"similar":["民康物阜"],"opposite":["民穷财尽"],"usage":"作宾语、定语；指社会状况"},{"id":27918,"word":"民淳俗厚","pinyin":"mín chún sú hòu","abbr":"mcsh","explanation":"民风质朴敦厚。","source":{"text":"海东之邑，闻有民淳俗厚如邹、鲁者，必张氏之化也欤。","book":"明·宋濂《敦睦堂记》"},"usage":"作宾语、定语；用于社会风气"},{"id":27919,"word":"民熙物阜","pinyin":"mín xī wù fù","abbr":"mxwf","explanation":"人民安乐，物产富饶。形容升平景象。","source":{"text":"昔贞观中，民康物阜，盗贼衰熄，人知自爱，而不犯法。","book":"宋·华镇《治论下》"},"example":{"text":"～岁时丰，三边烽火息，四海受恩隆。","book":"明·杨柔胜《玉环记·延赏庆寿》"},"similar":["民康物阜"],"usage":"作宾语、定语；指社会状况"},{"id":27920,"word":"民生凋敝","pinyin":"mín shēng diāo bì","abbr":"msdb","explanation":"民生：人民的生计；凋敝：衰败，艰苦。社会穷困，经济衰败，人民生活极端困苦。","source":{"text":"民用凋敝，奸轨不禁。","book":"《汉书·循吏传序》"},"example":{"text":"那时～，一心寻面包吃尚且来不及，那里有心思谈文学呢？","book":"鲁迅《而已集·革命时代的文学》"},"similar":["民不聊生"],"opposite":["国富民强"],"usage":"作谓语、定语、补语；指人民生活困苦"},{"id":27921,"word":"民生国计","pinyin":"mín shēng guó jì","abbr":"msgj","explanation":"国家经济和人民生活。","source":{"text":"民生在勤，勤则不匮。","book":"《荀子·富国》：“如是则上下俱富，交无所藏之，是国计之极也。”《左传·宣公十二年》"},"example":{"text":"旧章既失，便新不成新，旧不成旧，一物一器，尚不适用，何况那政治上的事，关系～的呢？","book":"清·颐琐《黄绣球》第七回"},"similar":["国计民生"],"usage":"作宾语、定语；指国家经济和人民生活"},{"id":27922,"word":"民生在勤","pinyin":"mín shēng zài qín","abbr":"mszq","explanation":"人民的生计在于勤劳。","source":{"text":"民生在勤，勤则不匮。","book":"《左传·宣公十二年》"},"example":{"text":"何若自谋本业，知～，定当有济。","book":"清·王永彬《转炉夜话》"}},{"id":27923,"word":"民生在勤，勤则不匮","pinyin":"mín shēng zài qín，qín zé bù kuì","abbr":"mszqqzbk","explanation":"匮：缺乏。人民的生计在于勤劳，勤劳就不会缺少衣食。","source":{"text":"民生在勤，勤则不匮。","book":"《左传·宣公十二年》"},"example":{"text":"～。宴安自逸，岁暮奚冀。","book":"晋·陶潜《劝农》"}},{"id":27924,"word":"民生涂炭","pinyin":"mín shēng tú tàn","abbr":"mstt","explanation":"涂：泥沼；炭：炭火。人民陷在泥塘和火坑里。形容人民处于极端困苦的境地。","source":{"text":"先帝晏驾贼庭，京师鞠为戎穴，神州萧条，生灵涂炭。","book":"《尚书·仲虺之诰》：“有夏昏德，民坠涂炭。”《晋书·苻丕载记》"},"example":{"text":"《尚书·仲虺之诰》：“有夏昏德，民坠涂炭。”《晋书·苻丕载记》：“先帝晏驾贼庭，京师鞠为戎穴，神州萧条，生灵涂炭。”"},"similar":["生灵涂炭","生灵涂地"],"opposite":["国泰民安","安居乐业"],"usage":"作谓语、宾语；指社会时局"},{"id":27925,"word":"民疲师老","pinyin":"mín pí shī lǎo","abbr":"mpsl","explanation":"民：民众；疲：疲乏；师：军队；老：衰竭。部队士气衰落，百姓疲惫不堪。形容连年征战造成士兵、人民极其疲劳。","source":{"text":"北狄则弓硬马肥，转难擒制，中国则民疲师老，应误指挥。","book":"宋·邵伯温《闻见前录》"}},{"id":27926,"word":"民穷国困","pinyin":"mín qióng guó kùn","abbr":"mqgk","explanation":"百姓穷困，国家困难。"},{"id":27927,"word":"民穷财匮","pinyin":"mín qióng cái kuì","abbr":"mqck","explanation":"人民穷困，国家财富也消耗完了。","source":{"text":"本处万山环列，易于哨聚，又值水旱频仍，民穷财尽，人心思乱。","book":"明·施耐庵《水浒全传》第九十一回"},"example":{"text":"当此～之时，尤不可轻敌。","book":"《清史稿·长庚传》"},"similar":["民穷财尽"],"usage":"作宾语、状语、定语；指国力衰竭"},{"id":27928,"word":"民穷财尽","pinyin":"mín qióng cái jìn","abbr":"mqcj","explanation":"人民穷困，国家财富也消耗完了。","source":{"text":"本处万山环列，易于哨聚，又值水旱频仍，民穷财尽，人心思乱。","book":"明·施耐庵《水浒全传》第九十一回"},"example":{"text":"自古以来，有～而人主独拥多藏于上者乎？","book":"清·顾炎武《日知录》卷十二"},"similar":["民不聊生","民穷财匮"],"usage":"作宾语、状语；指社会状况"},{"id":27929,"word":"民胞物与","pinyin":"mín bāo wù yǔ","abbr":"mbwy","explanation":"民为同胞，物为同类。泛指爱人和一切物类。","source":{"text":"民吾同胞，物吾与也。","book":"宋·张载《西铭》"},"example":{"text":"那里有一个是认真存了“仁人测隐”之心，行他那“～”的志向，不过都是在那里邀福。","book":"清·吴趼人《二十年目睹之怪现状》第十五回"},"usage":"作宾语；指泛爱的一切人和物"},{"id":27930,"word":"民脂民膏","pinyin":"mín zhī mín gāo","abbr":"mzmg","explanation":"脂、膏：脂肪。比喻人民用血汗换来的财富。多用于指反动统治阶级压榨人民来养肥自己的场合。","source":{"text":"尔俸尔禄，民膏民脂。","book":"五代·后蜀·孟昶《戒石文》"},"example":{"text":"可怜民膏民脂，弃之无用之地。","book":"明·许仲琳《封神演义》第二十五回"},"similar":["民膏民脂"],"usage":"作主语、定语；指人们的财富"},{"id":27931,"word":"民膏民脂","pinyin":"mín gāo mín zhī","abbr":"mgmz","explanation":"脂、膏：脂肪。比喻人民用血汗换来的财富。多用于指反动统治阶级压榨人民来养肥自己的场合。","source":{"text":"尔俸尔禄，民膏民脂。为人父母，罔不仁慈。","book":"宋·张唐英《蜀壽杌》下卷"},"example":{"text":"尔俸尔禄，～，下民易虐，上苍难欺也呵！","book":"元·无名氏《村乐堂》第三折"},"similar":["民脂民膏"],"usage":"作宾语；指人们的财富"},{"id":27932,"word":"民贵君轻","pinyin":"mín guì jūn qīng","abbr":"mgjq","explanation":"人民比君主更重要。这是民本思想。","source":{"text":"民为贵，社稷次之，君为轻。","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"他劝国王行仁政，王天下，虽然也包含着‘～’、‘土芥寇仇’等危险思想……","book":"范文澜《中国经学史的演变》"},"usage":"作宾语、定语；用于劝诫人"},{"id":27933,"word":"民贼独夫","pinyin":"mín zéi dú fū","abbr":"mzdf","explanation":"民贼：残害人民的坏家伙；独夫：暴虐无道、众叛亲离的统治者。指残害人民众叛亲离的反动统治者。","source":{"text":"今之所谓良臣，古之所谓民贼也。","book":"《尚书·泰誓下》：“独夫受，洪惟作威，乃汝世仇。”《孟子·告子下》"},"example":{"text":"这种险惨刻毒的～思想，与孔孟正统派的仁义学说恰恰处于对立的地位。","book":"范文澜《中国通史简编》第二编第一章第一节"},"similar":["独夫民贼"],"usage":"作主语、宾语；指反动统治者"},{"id":27934,"word":"氓獠户歌","pinyin":"méng liáo hù gē","abbr":"mlhg","explanation":"氓：外来的人；獠：古时对西南少数民族的侮称。形容全国人民全都歌颂。","source":{"text":"明条谨狱，氓獠户歌。","book":"唐·韩愈《祭河南张员外文》"}},{"id":27935,"word":"气义相投","pinyin":"qì yì xiāng tóu","abbr":"qyxt","explanation":"指志趣、情谊互相投合。","source":{"text":"吾四人者，臭味相似而气义相投也，故不结而合，既合而欢。","book":"金·王若虚《林下四友赞》"},"similar":["气谊相投"],"usage":"作谓语、定语；用于交往等"},{"id":27936,"word":"气傲心高","pinyin":"qì ào xīn gāo","abbr":"qaxg","explanation":"心比天高，气性骄傲。态度傲慢，自以为高人一等。","source":{"text":"我可也心高气傲惹人憎。","book":"元·无名氏《冻苏秦》第一折"},"example":{"text":"自家想着当年的事，还有些～。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["心高气傲"],"usage":"作谓语、定语；指人心高"},{"id":27937,"word":"气充志定","pinyin":"qì chōng zhì dìng","abbr":"qczd","explanation":"充：充实，充足。精力充沛，意志坚定。","source":{"text":"磨砻砥砺，使其气充志定，卓然成材，然后举而用之，以任天下国家事无难矣！","book":"《明史·范济传》"},"usage":"作谓语、定语；用于书面语"},{"id":27938,"word":"气充志骄","pinyin":"qì chōng zhì jiāo","abbr":"qczj","explanation":"指心满意得，骄傲自大。","source":{"text":"遂合诸侯于嘉陵，气充志骄，淫侈无度。","book":"西汉·刘安《淮南子·人间训》"},"similar":["气满志骄","气骄志满"],"usage":"作谓语、定语、状语；用于书面语"},{"id":27939,"word":"气克斗牛","pinyin":"qì kè dǒu niú","abbr":"qkdn","explanation":"斗：北斗星。牛：牵牛星。斗牛泛指星空。形容气魄很大。同“气吞牛斗”。","source":{"text":"俺自有翅排云，气克斗牛，怎肯与他年少成仇。","book":"明·胡文焕《群音类选〈千金记·受辱胯下〉》"},"similar":["气吞斗牛","气冲牛斗"],"usage":"作谓语、定语；用于比喻句"},{"id":27940,"word":"气冠三军","pinyin":"qì guàn sān jūn","abbr":"qgsj","explanation":"三军：军队的总称。指勇敢或勇猛是全军第一。","source":{"text":"吕尚七十，气冠三军，诗人作歌，如鹰如鴠。","book":"南朝·宋·范晔《后汉书·高彪传》"},"similar":["勇贯三军","勇冠三军"],"usage":"作谓语、宾语；形容人的英勇"},{"id":27941,"word":"气冲志定","pinyin":"qì chōng zhì dìng","abbr":"qczd","explanation":"精力旺盛，意志坚定。","source":{"text":"磨磨砥砺，使其气充志定，卓然成材。","book":"《明史·范济传》"}},{"id":27942,"word":"气冲志骄","pinyin":"qì chōng zhì jiāo","abbr":"qczj","explanation":"指气势冲盈，高傲自大。","source":{"text":"遂合诸侯于嘉陵，气冲志骄，淫侈无度。","book":"《淮南子·人间训》"}},{"id":27943,"word":"气冲斗牛","pinyin":"qì chōng dǒu niú","abbr":"qcdn","explanation":"气：气势；牛、斗：即牵牛星和北斗星，指天空。形容怒气冲天或气势很盛。","source":{"text":"雄气堂堂贯斗牛，誓将真节报君仇。","book":"唐·崔融《咏宝剑》：“匣气冲牛斗，山形转辘轳。”宋·岳飞《题青泥赤壁》诗"},"example":{"text":"兴见马忠是害父仇人，～，举青龙刀望忠便砍。","book":"明·罗贯中《三国演义》第八十三回"},"similar":["气冲牛斗"],"usage":"作谓语、定语；形容怒气很盛"},{"id":27944,"word":"气冲牛斗","pinyin":"qì chōng niú dǒu","abbr":"qcnd","explanation":"气：气势；牛、斗：即牵牛星和北斗星，指天空。形容怒气冲天或气势很盛。","source":{"text":"雄气堂堂贯牛斗，誓将真节报君仇。","book":"宋·岳飞《题青泥赤壁》诗"},"example":{"text":"兴见马忠是害父仇人，～，举青龙刀望忠便砍。","book":"明·罗贯中《三国演义》第八十三回"},"similar":["怒发冲冠","气贯长虹"],"opposite":["低声下气"],"usage":"作谓语、宾语；形容怒气很盛"},{"id":27945,"word":"气冲霄汉","pinyin":"qì chōng xiāo hàn","abbr":"qcxh","explanation":"霄汉：指天空。形容魄力非常大。","source":{"text":"公受命宗祊，精贯朝日，拥节和门，气逾霄汉。","book":"《南齐书·高帝纪上》"},"example":{"text":"白玉堂一看，却是蒋平穿着水靠，不由得～。（清·石玉昆《三侠五义》第五十七回）"},"similar":["气冲牛斗"],"opposite":["垂头丧气"],"usage":"作谓语、宾语；指气魄很盛"},{"id":27946,"word":"气决泉达","pinyin":"qì jué quán dá","abbr":"qjqd","explanation":"如气之逸出，泉水之流泻。比喻事情进行非常顺利。","source":{"text":"气决泉达，无所凝滞。","book":"汉·蔡邕《袁满来碑铭》"},"usage":"作谓语、定语；用于书面语"},{"id":27947,"word":"气凌霄汉","pinyin":"qì líng xiāo xiàn","abbr":"qlxh","explanation":"霄汉：高空。形容气势壮阔。","source":{"text":"公精贯朝日，气凌霄汉，奋其灵武，大歼群慝。","book":"南朝·宋·傅亮《策宋公九锡文》"},"example":{"text":"说时侠～，听罢奇文冠古今。","book":"明·凌濛初《初刻拍案惊奇》卷八"},"similar":["气逾霄汉","气冲霄汉"],"usage":"作谓语、宾语；指气魄很盛"},{"id":27948,"word":"气势汹汹","pinyin":"qì shì xiōng xiōng","abbr":"qsxx","explanation":"汹汹：气势盛大的样子。形容气势凶猛。","source":{"text":"君子不为小人之汹汹也辍行。","book":"《荀子·天论》"},"example":{"text":"就在这时候，从门外闯进了一位～中年农妇。","book":"郭沫若《金刚坡下》"},"similar":["气焰嚣张","其势汹汹"],"opposite":["心平气和","和蔼可亲"],"usage":"作谓语、定语、状语；指气势凶猛"},{"id":27949,"word":"气势熏灼","pinyin":"qì shì xūn zhuó","abbr":"qsxz","explanation":"熏灼：用烟熏，用火灼。拿气势压制人家。形容气势极盛，威逼他人。","source":{"text":"康熙中，满洲大臣以权位相尚者，惟索额图、明珠，一时气势熏灼。","book":"《清史稿·索额图等传论》"},"usage":"作谓语、定语；用于书面语"},{"id":27950,"word":"气势磅礴","pinyin":"qì shì páng bó","abbr":"qspb","explanation":"磅礴：广大无边的样子。形容气势雄伟壮大。","source":{"text":"《破浪》者，戊寅以后，一变其格，大抵议论激昂，气势磅礴，纵横驰骤，不拘绳墨之作也。","book":"清·归庄《自订时文序》"},"example":{"text":"这是中国近代史上～的一页。","book":"秦牧《古战场春晓》"},"similar":["气吞山河","气贯长虹"],"opposite":["有气无力"],"usage":"作谓语、定语；指气势雄伟"},{"id":27951,"word":"气压山河","pinyin":"qì yā shān hé","abbr":"qysh","explanation":"形容气势极盛，可以压倒山河。","source":{"text":"可正是气压山河百二雄，元也波戎，将军校统，宰臣每为头儿又尽忠。","book":"元·王实甫《丽春堂》第一折"},"similar":["气盖山河"],"usage":"作宾语、定语；用于比喻句"},{"id":27952,"word":"气吐虹霓","pinyin":"qì tǔ hóng ní","abbr":"qthn","explanation":"虹霓：天空出现的弧形彩带。吐气能成天上彩虹。形容气魄很大。","source":{"text":"云路鹏程九万里，气吐虹霓，志逞风雷。","book":"元·无名氏《百花亭》第三折"},"example":{"text":"～兴宇宙，赤心忠孝保江山。","book":"明·无名氏《聚兽牌》第一折"},"usage":"作宾语、定语；用于书面语"},{"id":27953,"word":"气吞万里","pinyin":"qì tūn wàn lǐ","abbr":"qtwl","explanation":"气：气势；吞：吞掉。形容气魄宏大。","source":{"text":"想当年，金戈铁马，气吞万里如虎。","book":"宋·辛弃疾《永遇乐·京口北固亭怀古》"},"similar":["气吞宇宙"],"usage":"作谓语、定语；用于气势"},{"id":27954,"word":"气吞宇宙","pinyin":"qì tūn yǔ zhòu","abbr":"qtyz","explanation":"犹气吞山河。形容气魄很大。","source":{"text":"李太原喘喘余息，犹气吞宇宙，可诟骂之。","book":"《旧五代史·唐书·李袭吉传》"},"similar":["气吞万里"],"usage":"作谓语、定语；用于气势"},{"id":27955,"word":"气吞山河","pinyin":"qì tūn shān hé","abbr":"qtsh","explanation":"气势可以吞没山河。形容气魄很大。","source":{"text":"背楚投汉，气吞山河。知音未遇，弹琴空歌。","book":"元·金仁杰《追韩信》第二折"},"example":{"text":"这号人，在困难中不是低头叹息，而是奋发图强，壮志凌云，～。","book":"姚雪垠《李自成》第二卷第二十八章"},"similar":["气冲牛斗","气壮山河"],"opposite":["气息奄奄"],"usage":"作谓语、定语；指气势雄伟"},{"id":27956,"word":"气吞斗牛","pinyin":"qì tūn dǒu niú","abbr":"qtdn","explanation":"斗、牛：牵牛星和北斗星。气势可以吞没星斗。形容气魄宏大。","example":{"text":"毛泽东的诗词有～的气概。"},"similar":["气吞牛斗","气克牛斗"],"usage":"作谓语、定语；用于比喻句"},{"id":27957,"word":"气吞河山","pinyin":"qì tūn hé shān","abbr":"qths","explanation":"气势可以吞没山河。形容气魄很大。","source":{"text":"君不见，马侍中，气吞河朔称英雄。","book":"唐·薛逢《君不见》"},"example":{"text":"果然使李自成陷于绝境，还称颂他如何在战场上横刀跃马，～；大旗指处，“悍贼”披靡。","book":"姚雪垠《李自成》第一卷第十一章"},"similar":["气吞山河"],"usage":"作谓语、定语；指气势雄伟"},{"id":27958,"word":"气吞湖海","pinyin":"qì tūn hú hǎi","abbr":"qthh","explanation":"犹气吞山河。形容气魄很大。","source":{"text":"气吞湖海豪犹昔，老阅沧桑骨已仙。","book":"清·查慎行《送田间先生归桐城兼寄高丹植明府》诗"},"similar":["气吞山河"],"usage":"作谓语、定语；指气势雄伟"},{"id":27959,"word":"气吞牛斗","pinyin":"qì tūn niú dǒu","abbr":"qtnd","explanation":"牛、斗：即牵牛星和北斗星，指天空。气势能吞没星空。形容气魄很大。","source":{"text":"雄气堂堂贯斗牛，誓将真节报君仇。","book":"唐·崔融《咏宝剑》：“匣气冲牛斗，山形转辘轳。”宋·岳飞《题青泥赤壁》诗"},"example":{"text":"看兰孙，～，知不是等闲人。","book":"明·胡文焕《群音类选·蟠桃记·诞孙相庆》"},"similar":["气克斗牛","气冲牛斗"],"usage":"作谓语、定语；用于比喻句"},{"id":27960,"word":"气吞虹蜺","pinyin":"qì tūn hóng yī","abbr":"qthn","explanation":"犹气吞山河。形容气魄宏大。"},{"id":27961,"word":"气吞虹蝩","pinyin":"qì tūn hóng yī","abbr":"qthy","explanation":"犹气吞山河。形容气魄宏大。"},{"id":27962,"word":"气吞虹霓","pinyin":"qì tūn hóng ní","abbr":"qthn","explanation":"虹霓：彩虹。气势可以吞掉天上的彩虹。形容气魄宏大。","source":{"text":"阮得此诗独怃然不满意，曰：‘先生气吞虹霓，今独少卑之，何也？’","book":"宋·岳珂《桯史·王义丰诗》"},"similar":["气吐虹霓"],"usage":"作谓语、定语；指气势雄伟"},{"id":27963,"word":"气味相投","pinyin":"qì wèi xiāng tóu","abbr":"qwxt","explanation":"气味：比喻性格和志趣；投：投合。指人思想作风相同，彼此很合得来。","source":{"text":"气味相投，风情迥别，议论通玄。","book":"明·冯惟敏《天香引·送陈震南》"},"example":{"text":"前者妹子同表妹舜英进京，曾与此女中途相遇，因他学问甚优，兼之～，所以结伴同行。","book":"清·李汝珍《镜花缘》第六十二回"},"similar":["情投意合","志同道合"],"opposite":["格格不入","针锋相对"],"usage":"作谓语、定语、宾语；指彼此投合"},{"id":27964,"word":"气咽声丝","pinyin":"qì yè shēng sī","abbr":"qyss","explanation":"呼吸困难，声音细微如丝。形容人极度虚弱。","source":{"text":"走的我气咽声丝，恨不的两肋生双翅。","book":"元·关汉卿《包待制三勘蝴蝶梦》第一折"},"example":{"text":"呀，雪消也见死尸，打的你～，倒着我抹泪揉眵。","book":"元·无名氏《抱妆盒》第三折"},"usage":"作定语、状语；用于书面语"},{"id":27965,"word":"气喘吁吁","pinyin":"qì chuǎn xū xū","abbr":"qcxx","explanation":"形容呼吸急促，大声喘气。","source":{"text":"一眼看见喜媚乌云散乱，气喘吁吁。","book":"明·许仲琳《封神演义》第二十六回"},"example":{"text":"廖二嫂～，脸色铁青，奔到他面前来了。","book":"沙汀《呼嚎》"},"similar":["气喘如牛","气急败坏"],"opposite":["心平气和","悠然自得"],"usage":"作谓语、状语、补语；用于人"},{"id":27966,"word":"气喘如牛","pinyin":"qì chuǎn rú niú","abbr":"qcrn","explanation":"形容大声喘气的模样。","source":{"text":"脸是喝了个漆紫，连乐带忙，一头说着，只张着嘴，气喘如牛的拿了条大手巾擦那脑门子上的汗。","book":"清·文康《儿女英雄传》第三十九回"},"example":{"text":"那总办～的说道：‘那贱人我不要了！’","book":"清·吴趼人《二十年目睹之怪现状》第六十六回"},"similar":["气喘吁吁"],"usage":"作谓语、状语；指出粗气"},{"id":27967,"word":"气喘汗流","pinyin":"qì chuǎn hàn liú","abbr":"qchl","explanation":"因繁忙、劳累而呼吸急促，流汗很多。形容工作非常繁忙。","source":{"text":"繁至文林馆，气喘汗流，问书之外，不暇他语。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"待～赶到店内，庶见房内杂物零乱，空空落落，哪还有半个人影？","book":"明·兰陵笑笑生《金瓶梅词话》第九回"}},{"id":27968,"word":"气噎喉堵","pinyin":"qì yē hóu dǔ","abbr":"qyhd","explanation":"喉咙被堵噎了。形容喘不过气。","source":{"text":"此时黛玉虽不是嚎啕大哭，然越是这等无声之泣，气噎喉堵，更觉厉害。","book":"清·曹雪芹《红楼梦》第34回"},"usage":"作谓语、定语；用于人的神态"},{"id":27969,"word":"气壮如牛","pinyin":"qì zhuàng rú niú","abbr":"qzrn","explanation":"气很盛，但使人觉得笨拙。","example":{"text":"他那气壮如牛的样子，简直像要吃人。"},"similar":["色厉内荏","装腔作势"],"opposite":["胆小如鼠","死气沉沉"],"usage":"作谓语、定语；指人的气势"},{"id":27970,"word":"气壮山河","pinyin":"qì zhuàng shān hé","abbr":"qzsh","explanation":"气：气概；壮：使壮丽；山河：高山和大河。形容气概豪迈，使祖国山河因而更加壮丽。","source":{"text":"族高辰象，气壮河山，神作铜钩，天开金印。","book":"唐·张说《孔补阙集市》"},"example":{"text":"又听到了你的朴朴实实、～的言谈了。","book":"梁信《从奴隶到将军》上集第四章"},"similar":["气冲霄汉","气势磅礴"],"opposite":["气息奄奄","奄奄一息"],"usage":"作谓语、定语；指人的气概","story":["北宋时期，赵鼎21岁中进士受到宰相吴敏的赏识，调到都城开封任职。金兵南下，宋钦宗惊慌失措，赵鼎主张抗金到底，可是宋钦宗不予理睬。北宋灭亡后，赵鼎仍然坚持抗金，秦桧迫害他，他只好写下：身骑箕，尾归天上，气壮山河壮本朝"]},{"id":27971,"word":"气壮河山","pinyin":"qì zhuàng hé shān","abbr":"qzhs","explanation":"形容气概豪迈，使祖国山河因而更加壮丽。同“气壮山河”。","source":{"text":"族高辰象，气壮河山，神作铜钩，天开金印。","book":"唐·张说《序》"},"similar":["气壮山河"],"usage":"作谓语、定语；指人的气概"},{"id":27972,"word":"气壮理直","pinyin":"qì zhuàng lǐ zhí","abbr":"qzlz","explanation":"指理由充分，说话有气势。","source":{"text":"法人无端废约于先，吾滇人要求废约于后，气壮理直，谅法人不复狡焉思逞。","book":"义侠《为滇越铁路告成警告全滇》"},"example":{"text":"他倒显得～了。"},"similar":["理直气壮"],"opposite":["理屈词穷"],"usage":"作谓语、定语、状语；指在理"},{"id":27973,"word":"气壮胆粗","pinyin":"qì zhuàng dǎn cū","abbr":"qzdc","explanation":"气势壮、胆量大。形容无所畏惧。","source":{"text":"她的那点聪明根本不在何玉凤之下，况又受了公婆的许多锦囊妙计，此时转比何玉凤来的气壮胆粗。","book":"清·文康《儿女英雄传》第26回"},"similar":["胆大气粗"],"usage":"作谓语、宾语、定语；指人胆大"},{"id":27974,"word":"气夯胸脯","pinyin":"qì hāng xiōng pú","abbr":"qhxp","explanation":"夯：冲撞。形容极度气愤。","source":{"text":"有口难言，气夯破胸脯。","book":"元·王实甫《西厢记》第五本第四折"},"example":{"text":"你是个朽木之材，在人前强做支吾，有甚么真实的肺腑，不由人～。","book":"明·无名氏《宝光殿天真祝万寿》头折"},"usage":"作谓语；指非常气愤"},{"id":27975,"word":"气宇不凡","pinyin":"qì yǔ bù fán","abbr":"qybf","explanation":"气：气质；气宇：仪表。气质和风度不同一般。","source":{"text":"妾见郞君气宇不凡，……愿托终身，不知可否？","book":"明·周楫《西湖二集·寄梅花鬼闹西阁》"},"example":{"text":"李自成是一位魁梧大汉，由一柄黄伞前导，骑在一匹黄辔头、黄鞍鞯的深灰色马上，毡笠，缥衣，～。","book":"姚雪垠《李自成》第四卷六章"},"similar":["气度不凡"],"usage":"作谓语、定语；用于人的气势"},{"id":27976,"word":"气宇昂昂","pinyin":"qì yǔ áng áng","abbr":"qyaa","explanation":"气宇：气度，仪表；昂昂：气概轩昂的样子。精神饱满，气度不凡。","source":{"text":"指挥军士，东西布阵，气宇昂昂，旁若无人。","book":"明·冯梦龙《东周列国志》第三十四回"},"example":{"text":"又见展爷穿着簇新的四品武职服色，越显得～，威风凛凛，真真令人羡慕之中可畏可亲。","book":"清·石玉昆《三侠五义》第二十二回"},"similar":["气宇轩昂","气宇不凡"],"usage":"作谓语、定语、状语；用于人的气质"},{"id":27977,"word":"气宇轩昂","pinyin":"qì yǔ xuān áng","abbr":"qyxa","explanation":"气宇：指人的仪表、风度；轩昂：精神饱满的样子。形容人精力充沛，风度不凡。","source":{"text":"张昭等见孔明丰神飘洒，器宇轩昂，料到此人必来游说。","book":"明·罗贯中《三国演义》第四十三回"},"example":{"text":"庄绍光见萧昊轩～，不同流俗，也就着实亲近。","book":"清·吴敬梓《儒林外史》第三十四回"},"similar":["精神抖擞","英姿焕发","轩昂气宇"],"opposite":["没精打采","垂头丧气","唯唯诺诺"],"usage":"作谓语、定语、状语；指人气概不凡","story":["东汉末年，曹操派83万大军进攻刘备与孙权，刘备接受鲁肃的联合抗曹的建议，派诸葛亮前往柴桑去商谈具体合作事宜。鲁肃担心诸葛亮不能担此大任，就组织一帮谋士去考他，只见诸葛亮气宇轩昂，舌战群儒，从而赢得东吴的信任"]},{"id":27978,"word":"气度不凡","pinyin":"qì dù bù fán","abbr":"qdbf","explanation":"气：气质。气质和风度不同一般。","source":{"text":"我不禁惊诧于这穷乡僻壤，竟有如此气度不凡的建筑。","book":"《人民日报》"},"example":{"text":"这个白发苍苍的老人～。"},"similar":["气宇不凡"],"usage":"作谓语、定语；用于人的气势"},{"id":27979,"word":"气度雄远","pinyin":"qì dù xióng yuǎn","abbr":"qdxy","explanation":"气度：气魄，度量；雄：宏大。比喻气魄度量宽阔，志向远大。","source":{"text":"猛瑰恣俊伟，博学好兵书，谨质严毅，气度雄远，细事不干其虑，自不参其神契，略不与交通，是以浮华之士咸轻而笑之。","book":"《晋书·王猛传》"}},{"id":27980,"word":"气弱声嘶","pinyin":"qì ruò shēng sī","abbr":"qrss","explanation":"弱：微弱；嘶：声音沙哑。气息微弱，声音沙哑。","source":{"text":"打的你气咽声丝，倒着我抹泪揉眵。","book":"元·无名氏《抱妆盒》楔子"},"example":{"text":"玉生来未经过这样苦楚，起先觉得打的疼不过还乱嚷乱哭，后来渐渐～，哽咽不出。","book":"清·曹雪芹《红楼梦》第三十三回"},"usage":"作谓语、定语、状语；用于人的神态"},{"id":27981,"word":"气得志满","pinyin":"qì dé zhì mǎn","abbr":"qdzm","explanation":"洋洋自得，心满意足。","source":{"text":"是故文章之作，恒发于羁旅草野，至若王公贵人，气得志满，非性能而好之则不暇以为。","book":"唐·韩愈《荆潭唱和诗序》"},"usage":"作谓语、定语、状语；用于为人"},{"id":27982,"word":"气忍声吞","pinyin":"qì rěn shēng tūn","abbr":"qrst","explanation":"受了气而勉强忍耐，不说什么话。形容窝囊。","source":{"text":"他一世儿为人，半世儿孤贫，气忍声吞，何日酬恩。","book":"元·张国宾《合汗衫》第一折"},"example":{"text":"受了委屈，他也只能～了。"},"similar":["忍气吞声"],"usage":"作谓语、定语、状语；指不敢出声抗争"},{"id":27983,"word":"气急败丧","pinyin":"qì jí bài sàng","abbr":"qjbs","explanation":"形容十分荒张或恼怒。同“气急败坏”。","source":{"text":"桂长林脸上挂了彩，气急败丧地跑来。","book":"茅盾《子夜》十五"},"similar":["气急败坏"],"opposite":["心平气和"],"usage":"作谓语、定语、状语；指十分慌张"},{"id":27984,"word":"气急败坏","pinyin":"qì jí bài huài","abbr":"qjbh","explanation":"上气不接下气，狼狈不堪。形容十分荒张或恼怒。","source":{"text":"水军头领棹船接济军马，陆续过渡，只见一个人气急败坏跑将来。","book":"明·施耐庵《水浒全传》第六十七回"},"example":{"text":"那时～的样子，实是不堪入目。","book":"清·吴趼人《瞎编奇闻》"},"similar":["恼羞成怒","暴跳如雷"],"opposite":["平心静气","心平气和"],"usage":"作谓语、定语、状语；指十分慌张"},{"id":27985,"word":"气息奄奄","pinyin":"qì xī yān yān","abbr":"qxyy","explanation":"气息：呼吸；奄奄：呼吸微弱的样子，形容呼吸微弱，快要断气的样子。也比喻事物衰败没落，即将灭亡。","source":{"text":"但以刘日薄西山，乞息奄奄，人命危浅，朝不虑夕。","book":"晋·李密《陈情表》"},"example":{"text":"到了次日早晨，慧娘已是～，十分不好。","book":"清·李绿园《歧路灯》第四十七回"},"similar":["奄奄一息","苟延残喘"],"opposite":["生龙活虎","生气勃勃"],"usage":"作谓语、补语；指即将灭亡","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母，尊重老人。他想启用西蜀尚书郎李密，就下诏书任命李密为郎中。李密不愿出来做官，就写《陈情表》上书晋武帝，说祖母已经气息奄奄，两人形影相吊、相依为命，待伺候祖母后再出来做官"]},{"id":27986,"word":"气愤填胸","pinyin":"qì fèn tián xiōng","abbr":"qftx","explanation":"形容愤怒之情充满胸中。","source":{"text":"唐·赵元一《奉天录》卷三：“筑垒清野，秣马训兵，愤气填胸，誓雪国耻。”《旧唐书·文宗纪下》：“我每思贞观开元之时，观今日之事，往往愤气填膺耳。"},"example":{"text":"一连三疏，请圣上还都，谁知被汪伯豢、黄潜善所遏，～。","book":"清·陈忱《水浒后传》第二十七回"}},{"id":27987,"word":"气愤填膺","pinyin":"qì fèn tián yīng","abbr":"qfty","explanation":"膺：胸。形容愤怒之情充满胸中。亦作“愤气填膺”、“愤气填胸”、“激愤填膺”。","source":{"text":"唐·赵元一《奉天录》卷三：“筑垒清野，秣马训兵，愤气填胸，誓雪国耻。”《旧唐书·文宗纪下》：“我每思贞观开元之时，观今日之事，往往愤气填膺耳。"},"example":{"text":"秦妈妈～，盯着徐义德。","book":"周而复《上海的早晨》四十八"}},{"id":27988,"word":"气数已尽","pinyin":"qì shù yǐ jìn","abbr":"qsyj","explanation":"气数：命运。形容人已生命垂危，即将死亡或没有生命力。","source":{"text":"汉东都洛阳，二百余年，气数已尽。","book":"明·罗贯中《三国演义》第六回"},"example":{"text":"大明～，四下起火，八下冒烟，崇祯的龙椅早就坐不稳啦。","book":"姚雪垠《李自成》第一卷第十四章"},"similar":["气数已衰"],"usage":"作谓语、定语；用于垂死的事物"},{"id":27989,"word":"气数已衰","pinyin":"qì shù yǐ shuāi","abbr":"qsys","explanation":"气数：命运。形容人已生命垂危，即将死亡或没有生命力。","source":{"text":"汉东都洛阳，二百余年，气数已衰。","book":"明·罗贯中《三国演义》第六回"},"similar":["气数已尽"],"usage":"作谓语、定语；用于垂死的事物"},{"id":27990,"word":"气断声吞","pinyin":"qì duàn shēng tūn","abbr":"qdst","explanation":"气出不来，话说不出。形容极度忧伤失望。","source":{"text":"成顾蟋蟀笼虚，则气断声吞，亦不复以儿为念。","book":"清·蒲松龄《聊斋志异·促织》"},"usage":"作谓语、状语、定语；用于人的神情"},{"id":27991,"word":"气杀钟馗","pinyin":"qì shā zhōng kuí","abbr":"qszk","explanation":"气：气恼。比喻因愤怒而脸色难看。","source":{"text":"清·樵玉山人《钟馗捉鬼传》载：唐代人钟馗，考取了状元，但由于相貌丑陋，皇帝打算另选。于是钟馗气愤之极，自刎而死。"},"example":{"text":"他们就是专和我作对，一个个都像个“～”。","book":"鲁迅《彷徨·离婚》"},"usage":"作宾语、定语；用于人愤怒的神态","story":["传说唐朝时期有一个难看的书生钟馗，他家境不是太好，但刻苦读书，终于考取了状元，家人十分高兴。皇帝嫌他长得丑陋，就打算另选别人。钟馗听说后气愤至极，于是自杀身亡，后来他成为传说中的疾恶如仇的捉鬼大师"]},{"id":27992,"word":"气消胆夺","pinyin":"qì xiāo dǎn duó","abbr":"qxdd","explanation":"形容恐惧到极点。","source":{"text":"初，景之围台城，援军三十万，兵士望青袍则气消胆夺。","book":"《南史·侯景传》"},"opposite":["气冲牛斗"],"usage":"作谓语、定语；用于处事"},{"id":27993,"word":"气涌如山","pinyin":"qì yǒng rú shān","abbr":"qyrs","explanation":"形容恼怒到极点。","source":{"text":"朕年六十，世事难易，靡所不尝，近为鼠子所前却，令人气涌如山。","book":"晋·陈寿《三国志·吴志·吴主传》：“权大怒，欲自征渊”裴松之注引晋·虞溥《江表传》"},"example":{"text":"大怒，来余家，～，为言并无奏加津贴事。","book":"清·冯桂芬《江苏减赋记》"},"similar":["怒发冲冠"],"usage":"作谓语；指恼怒到极点"},{"id":27994,"word":"气满志得","pinyin":"qì mǎn zhì dé","abbr":"qmzd","explanation":"指志愿实现，心满意足。"},{"id":27995,"word":"气满志骄","pinyin":"qì mǎn zhì jiāo","abbr":"qmzj","explanation":"指气势冲盈，高傲自大。","source":{"text":"遂合诸侯于嘉陵，气冲志骄，淫侈无度。","book":"《淮南子·人间训》"},"example":{"text":"他打了俺三个大郡，～，必然想着幽州。","book":"明·施耐庵《水浒全传》第八十六回"},"similar":["气充志骄","气骄志满"],"usage":"作谓语、定语、状语；用于书面语"},{"id":27996,"word":"气焰嚣张","pinyin":"qì yàn xiāo zhāng","abbr":"qyxz","explanation":"嚣张：猖狂的样子。形容人威势逼人，猖狂放肆。","source":{"text":"气焰嚣张的日寇刚到齐会镇，就挨了当头一棒，被我等消灭了五百多人。","book":"《手术台就是阵地》"},"example":{"text":"你不要怕他～的样子。"},"similar":["肆无忌惮"],"opposite":["心平气和"],"usage":"作谓语、定语；指人猖狂放肆"},{"id":27997,"word":"气焰熏天","pinyin":"qì yàn xūn tiān","abbr":"qyxt","explanation":"气焰：气势。形容盛气凌人，十分傲慢。","source":{"text":"独不见气焰熏天谁敢当。","book":"明·胡文焕《群音类选·双惠记·巡守雍丘》"},"example":{"text":"比时康太守正是～，寻常的候补道都不在他眼里，这位因为是亲戚，所以还时时见面。","book":"清·李宝嘉《文明小史》第四十一回"},"similar":["气焰嚣张"],"usage":"作谓语、宾语；指人的气势"},{"id":27998,"word":"气生气死","pinyin":"qì shēng qì sǐ","abbr":"qsqs","explanation":"形容极度气愤。","source":{"text":"那妇人气生气死，和他合了几场气。","book":"明·兰陵笑笑生《金瓶梅词话》第二回"},"usage":"作谓语、定语；用于愤怒"},{"id":27999,"word":"气盖山河","pinyin":"qì gài shān hé","abbr":"qgsh","explanation":"形容气势很盛，可以覆盖山河。","source":{"text":"可正是气压山河百二雄，元也波戎，将军校统。宰臣每为头儿又尽忠，文官每守正直，武将每建大功，到今日可也乐升平，好受用。","book":"元·王实甫《丽春堂》第一折"},"example":{"text":"怎当得一个是气冲牛斗，一个是～。","book":"清·李宝嘉《中国现在记》第六回"},"similar":["气压山河"],"usage":"作宾语、定语；用于比喻句"},{"id":28000,"word":"气盛言宜","pinyin":"qì shèng yán yí","abbr":"qsyy","explanation":"气：文章的气势；言：语言；宜：合适。文章气势宏大而语言适宜。","source":{"text":"气，，水也；言，浮物也。水大而物之浮者大小毕浮。气之与言犹是也，气盛则言之短长与声之高下皆宜。","book":"唐·韩愈《答李翊书》"},"example":{"text":"乃貌若相合，心实相离，口血未干，私争已启，徒赖一～之曹操，亦何能济？","book":"蔡东蕃《后汉演义》第六十七回"}},{"id":28001,"word":"气竭声嘶","pinyin":"qì jié shēng sī","abbr":"qjss","explanation":"气力竭尽，声音嘶哑。","source":{"text":"小气竭声嘶，呼而求饮。","book":"清·蒲松龄《聊斋志异·吕无病》"},"similar":["气竭声澌"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":28002,"word":"气竭声澌","pinyin":"qì jié shēng sī","abbr":"qjss","explanation":"气力竭尽，声音嘶哑。同“气竭声嘶”。","source":{"text":"气竭声澌，不知所云。","book":"《辛亥革命·关于南北议和的清方档案》"},"similar":["气竭声嘶"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":28003,"word":"气竭形枯","pinyin":"qì jié xíng kū","abbr":"qjxk","explanation":"竭：尽；枯：枯槁。力气用尽，形容枯槁。形容病人生命垂危的样子。","source":{"text":"如是而精耗形枯，神亡气竭，药不能补，养不能回，恹恹病矣，又一劫也。","book":"元·张三丰《五劫篇》"}},{"id":28004,"word":"气粗胆壮","pinyin":"qì cū dǎn zhuàng","abbr":"qcdz","explanation":"气势旺盛，胆子很大。形容气势很盛。","source":{"text":"我枚独气粗胆壮，而奋然治具者，恰别有说焉。","book":"清·袁枚《小仓山房尺牍》卷九"},"example":{"text":"不完全是害怕，又不完全～，就那么怪不得劲的，手心上出了点凉汗。","book":"老舍《我这一辈子》七"},"similar":["气高胆壮"],"usage":"作谓语、定语、状语；用于为人"},{"id":28005,"word":"气血方刚","pinyin":"qì xuè fāng gāng","abbr":"qxfg","explanation":"犹血气方刚。指精力正值旺盛。","source":{"text":"及其壮也，血气方刚，戒之在斗。","book":"《论语·季氏》"},"example":{"text":"前辈～，不拘小节，盖或有之。","book":"宋·周煇《清波别志》卷下"},"similar":["血气方刚","血气方盛","血气方壮"],"usage":"作谓语、定语；用于年轻人"},{"id":28006,"word":"气谊相投","pinyin":"qì yì xiāng tóu","abbr":"qyxt","explanation":"指志趣、情谊互相投合。同“气义相投”。","source":{"text":"太史慈……与孔融亲非骨肉，比非乡党，特以气谊相投，有分忧共患之意。","book":"明·罗贯中《三国演义》第11回"},"similar":["气义相投"],"usage":"作谓语、定语；用于交往等"},{"id":28007,"word":"气象一新","pinyin":"qì xiàng yī xīn","abbr":"qxyx","explanation":"形容出现崭新的面貌，显得很光彩。","source":{"text":"我们的国家发展得确实很快，气象一新。","book":"邓小平《今后的主要任务是搞建设》"},"example":{"text":"高阳《胡雪岩全传·灯火楼台》：“贪庸疲软的劣员，参的参，调的调，官场～。”"},"similar":["焕然一新","面貌一新"],"usage":"作谓语、宾语；指面貌改观"},{"id":28008,"word":"气象万千","pinyin":"qì xiàng wàn qiān","abbr":"qxwq","explanation":"气象：情景。形容景象或事物壮丽而多变化。","source":{"text":"朝晖夕阴，气象万千。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"这庄严秀丽、～的长江真是美极了。","book":"刘白羽《长江三日》"},"similar":["波澜壮阔","云蒸霞蔚"],"opposite":["百孔千疮","每况愈下","一成不变"],"usage":"作谓语、定语；指事物壮丽"},{"id":28009,"word":"气贯虹霓","pinyin":"qì guàn hóng ní","abbr":"qghn","explanation":"贯：贯穿。正义的精神直上高空，穿过彩虹。形容精神极其崇高，气概极其豪壮。","source":{"text":"炭炽红炉，光喷星日；硎新雪刃，气贯虹霓。","book":"《礼记·聘义》：“气如白虹，天也。”宋·史浩《剑舞》"},"example":{"text":"谨以炙鸡絮酒，致祭于仁兄巨卿范君之灵曰：于维巨卿，～，义高云汉。","book":"明·冯梦龙《喻世明言》卷十六"}},{"id":28010,"word":"气贯长虹","pinyin":"qì guàn cháng hóng","abbr":"qgch","explanation":"贯：贯穿。正义的精神直上高空，穿过彩虹。形容精神极其崇高，气概极其豪壮。","source":{"text":"气如白虹，天也。","book":"《礼记·聘义》"},"example":{"text":"斗争结盟友，殉难慷慨同。　人民柴市节，浩气贯长虹。","book":"陈毅《纪念李大钊同志殉难三十周年》诗"},"similar":["气吞山河","气势磅礴"],"opposite":["气息奄奄"],"usage":"作谓语、定语；指气势壮盛"},{"id":28011,"word":"气逾霄汉","pinyin":"qì yú xiāo hàn","abbr":"qyxh","explanation":"正气昂扬，直冲云天。形容魄力、勇气非常大。霄汉，云霄和银河。","source":{"text":"公受命宗枋，精贯朝日，拥节和门，气逾霄汉。","book":"《南齐书·高帝本纪》"},"similar":["气冲霄汉","气凌霄汉"],"usage":"作谓语、宾语；指气魄很盛"},{"id":28012,"word":"气食全牛","pinyin":"qì shí quán niú","abbr":"qsqn","explanation":"能吃下一头牛的气慨。形容人的气魄非凡。","source":{"text":"小儿五岁气食牛，满堂宾客皆回头。","book":"唐·杜甫《徐卿二子歌》"},"example":{"text":"佳作～，自堪压卷。","book":"明·汤显祖《与门人陈仲宣》"}},{"id":28013,"word":"气骄志满","pinyin":"qì jiāo zhì mǎn","abbr":"qjzm","explanation":"指气势冲盈，高傲自大。","source":{"text":"遂合诸侯于嘉陵，气冲志骄，淫侈无度。","book":"《淮南子·人间训》"},"example":{"text":"就未免～，一天一天的放荡恣纵起来。","book":"清·文康《儿女英雄传》第二十九回"},"similar":["气充志骄","气满志骄"],"usage":"作谓语、定语、状语；用于书面语"},{"id":28014,"word":"气高志大","pinyin":"qì gāo zhì dà","abbr":"qgzd","explanation":"意气高昂，志向远大。","source":{"text":"则为你气高志大，见是如此。","book":"元·郑光祖《王粲登楼》第一折"},"usage":"作谓语、定语；用于人的气势"},{"id":28015,"word":"气高胆壮","pinyin":"qì gāo dǎn zhuàng","abbr":"qgdz","explanation":"气势旺盛，胆子很大。形容气势很盛。","source":{"text":"我枚独气粗胆壮，而奋然治具者，恰别有说焉。","book":"清·袁枚《小仓山房尺牍》卷九"},"example":{"text":"何世清这老头子为什么这样～呢？","book":"刘流《烈火金刚》第十一回"},"similar":["气粗胆壮"],"usage":"作谓语、定语、状语；用于为人"},{"id":28016,"word":"氤氲使者","pinyin":"yīn yūn shǐ zhě","abbr":"yysz","explanation":"泛指男女婚姻的撮合者，即媒人。","source":{"text":"若道姻缘人可强，氤氲使者有何功？","book":"明·凌濛初《初刻拍案惊奇》卷三十四"},"example":{"text":"昨蒙玉帝敕我为～，专管世上男女姻缘，和合喜庆。","book":"清·俞万春《荡寇志》结子"}},{"id":28017,"word":"氤氲叆叇","pinyin":"yīn yūn ài dài","abbr":"yyad","explanation":"氤氲：烟云弥漫的样子；叆叇：云彩浓密。形容云气弥漫浓厚。","source":{"text":"看了这样云瑞气，氤氲叆叇罩周围，白云隐隐，绿水依依。","book":"明·无名氏《度黄龙》第一折"},"similar":["云雾迷漫"],"usage":"作谓语、定语；指云雾迷漫"},{"id":28018,"word":"氤氲大使","pinyin":"yīn yūn dà shǐ","abbr":"yyds","explanation":"传说中掌管婚姻的神。","source":{"text":"世人阴阳之契，有缱绻司总统，其长官号氤氲大使。","book":"宋·陶谷《清异录》卷一"},"example":{"text":"及至后来两下各不相望了，又曲曲湾湾反弄成了，这是～颠倒人的去处。","book":"明·凌濛初《二刻拍案惊奇》卷九"}},{"id":28019,"word":"水不扬波","pinyin":"shuǐ bù yáng bō","abbr":"sbyb","explanation":"扬：高举，往上升；波：波澜。水面很平静，没有波浪。","source":{"text":"八年，卢扶国来朝，渡河万里方至。云其国中山川无禽兽，水不扬波，风不折木。","book":"晋·王嘉《拾遗记》卷四"},"example":{"text":"大江以东，民皆安堵；遵海而北，～。","book":"明·张岱《陶庵梦忆·闰元宵》"}},{"id":28020,"word":"水中捉月","pinyin":"shuǐ zhōng zhuō yuè","abbr":"szzy","explanation":"比喻空虚幻想，不能实现。","source":{"text":"镜里看形见不难，水中捉月争拈得。","book":"宋·释道原《景德传灯录·永嘉真觉禅师》"},"example":{"text":"～事同然，隔靴抓痒越孜煎。","book":"元·王洁《浣溪沙·兹据律补》"},"similar":["水中捞月"],"usage":"作谓语、宾语；指徒劳无功"},{"id":28021,"word":"水中捞月","pinyin":"shuǐ zhōng lāo yuè","abbr":"szly","explanation":"到水中去捞月亮。比喻去做根本做不到的事情，只能白费力气。","source":{"text":"镜里拈花，水中捉月，觑着无由得近伊。","book":"宋·黄庭坚《沁园春》词"},"example":{"text":"恰便似沙里淘金，石中取火，～。","book":"元·杨景贤《刘行首》第三折"},"similar":["竹篮打水","徒劳无益","水底捞明月"],"opposite":["立竿见影","行之有效"],"usage":"作谓语、宾语；指白费力气"},{"id":28022,"word":"水中著盐","pinyin":"shuǐ zhōng zhuó yán","abbr":"szzy","explanation":"比喻不着痕迹。","source":{"text":"作诗用事，要加释语；水中著盐，饮水乃知。","book":"清·薛雪《一瓢诗话》"},"similar":["撮盐入水"],"usage":"作宾语、定语；用于比喻句"},{"id":28023,"word":"水乳不分","pinyin":"shuǐ rǔ bù fēn","abbr":"srbf","explanation":"指水和奶汁融合为一体。形容关系密切，意气投合。","source":{"text":"致使玄黄不辨，水乳不分。","book":"宋·释普济《五灯会元》卷十七"}},{"id":28024,"word":"水乳之合","pinyin":"shuǐ rǔ zhī hé","abbr":"srzh","explanation":"指水和奶汁融合为一体。形容关系密切，意气投合。","source":{"text":"寿谐馆于康山，踪迹最密，谈论经史有水乳之合。","book":"清·江藩《国朝汉学师承记·王兰泉先生》"}},{"id":28025,"word":"水乳之契","pinyin":"shuǐ rǔ zhī qì","abbr":"srzq","explanation":"象水和乳汁融合在一起。比喻感情很融洽或结合十分紧密。","source":{"text":"至伏肘腋之间，而为心腹之大患，托水乳之契，而藏钩距之深谋，则不知者或多矣。","book":"清·纪昀《阅微草堂笔记·姑妄听之一》"},"similar":["水乳交融","乳水交融"],"usage":"作宾语；用于书面语"},{"id":28026,"word":"水乳交融","pinyin":"shuǐ rǔ jiāo róng","abbr":"srjr","explanation":"交融：融合在一起。象水和乳汁融合在一起。比喻感情很融洽或结合十分紧密。","source":{"text":"致使玄黄不辨，水乳不分。","book":"宋·释普济《五灯会元》卷十七"},"example":{"text":"几日工夫，同吴仁扰得～。","book":"清·刘鹗《老残游记》第十九回"},"similar":["浑然一体","难分难解","水乳之契"],"opposite":["格格不入","若即若离"],"usage":"作谓语、定语、补语；指感情融洽"},{"id":28027,"word":"水佩风裳","pinyin":"shuǐ pèi fēng shang","abbr":"spfs","explanation":"以水作佩饰，以风为衣裳。本写美人的妆饰。后用以形容荷叶荷花之状貌。","source":{"text":"语出唐·李贺《苏小小墓》诗：“风为裳，水为佩”。"},"example":{"text":"宋·姜夔《念奴娇》词：“三十六陂人来到，～无数。”"},"usage":"作宾语、定语；用于书面语"},{"id":28028,"word":"水光山色","pinyin":"shuǐ guāng shān sè","abbr":"sgss","explanation":"指湖上风光，山间景色。形容山水秀丽。","source":{"text":"水光潋滟晴方好，山色空濛雨亦奇。","book":"宋·苏轼《饮湖是初晴后雨》诗"},"example":{"text":"画船重泛西湖上，～都无恙。","book":"宋·楼钥《寿安抚伯父》诗"},"similar":["水色山光"],"usage":"作宾语、定语；用于景物描写"},{"id":28029,"word":"水光接天","pinyin":"shuǐ guāng jiē tiān","abbr":"sgjt","explanation":"水的光色与天的光色相连接。形容水域广阔。","source":{"text":"少焉月出于东山之上，徘徊于斗牛之间，白白露横江，水光接天。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"《英烈传》第47回：“但见湖中清风徐来，～，万籁无声，一碧万顷。”"},"usage":"作宾语、定语；用于景物描写"},{"id":28030,"word":"水净鹅飞","pinyin":"shuǐ jìng é fēi","abbr":"sjef","explanation":"比喻人财两失，一无所有。亦比喻民穷财尽。","source":{"text":"我则道地北天南，锦营花阵，偎红倚翠，今日个水净鹅飞。","book":"元·无名氏《云窗梦》第四折"},"example":{"text":"眼见的吹翻了这家，吹伤了那家，只吹的～罢！","book":"明·王磐《朝天子·咏喇叭》曲"},"similar":["水尽鹅飞"],"usage":"作宾语、定语；用于比喻句"},{"id":28031,"word":"水则资车","pinyin":"shuǐ zé zī chē","abbr":"szzc","explanation":"资：取。在水路上通船时，应该取来车辆备用。比喻有备无患。","source":{"text":"旱则资舟，水则资车，以待乏时。","book":"《国语·越语上》"}},{"id":28032,"word":"水则载舟，水则覆舟","pinyin":"shuǐ zé zài zhōu，shuǐ zé fù zhōu","abbr":"szzzszfz","explanation":"水能载舟，也能覆舟。比喻民可拥护君主，也能推翻君主。","source":{"text":"孔子对鲁哀公曰：‘君者，舟也；庶人者，水也。水则载舟，水则覆舟，君以此，思危，则不危焉。’","book":"《孙卿子》"},"similar":["载舟覆舟","水能载舟，亦能覆舟"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":28033,"word":"水到渠成","pinyin":"shuǐ dào qú chéng","abbr":"sdqc","explanation":"渠：水道。水流到的地方自然形成一条水道。比喻条件成熟，事情自然会成功。","source":{"text":"至时别作经画，水到渠成，不须预虑。","book":"宋·苏轼《答秦太虚书》"},"example":{"text":"须要自然而然，～，非由车戽，最忌无因而至，突如其来。","book":"清·李渔《闲情偶寄·大收煞》"},"similar":["顺理成章","瓜熟蒂落"],"opposite":["功败垂成"],"usage":"作谓语、定语；指条件成熟"},{"id":28034,"word":"水到鱼行","pinyin":"shuǐ dào yú xíng","abbr":"sdyx","explanation":"比喻条件具备，事情就可办成。","source":{"text":"谚云：水到鱼行。既已官之，不患其不知政也。","book":"清·俞樾《茶香室丛钞·张安道论科第》"},"usage":"作宾语、定语；用于比喻句"},{"id":28035,"word":"水剩山残","pinyin":"shuǐ shèng shān cán","abbr":"sssc","explanation":"多指亡国或经过变乱后国土分裂、山河残破的景象。","source":{"text":"唐·杜甫《陪郑广文游何将军山林》诗之五：“剩水沧江破，残山碣石开”。"},"example":{"text":"清·无名氏《指南梦》第九曲：“叹息长江天堑，～。”"},"similar":["残山剩水"],"usage":"作宾语、定语；形容沦陷的国土"},{"id":28036,"word":"水可载舟，亦可覆舟","pinyin":"shuǐ kě zài zhōu，yì kě fù zhōu","abbr":"skzzykfz","explanation":"比喻在平时要想到可能发生的困难和危险。","source":{"text":"孔子曰：‘夫君者舟也，人者水也。水可载舟，亦可覆舟。君以此思危，则可知也。’","book":"南朝·宋·范晔《后汉书·皇甫规传》李贤注引《孔子家语》"},"example":{"text":"作为统治者应该明白“～”的道理，不能贪求无厌。"},"similar":["水能载舟，亦能覆舟"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":28037,"word":"水因地而制流","pinyin":"shuǐ yīn dì ér zhì liú","abbr":"sydezl","explanation":"制：引，限定。流水因地势而引出其流向。比喻用兵时要按敌人的具体情况来采取制胜的办法。","source":{"text":"水因地而制流，兵因敌而制胜。","book":"《孙子·虚实篇》"}},{"id":28038,"word":"水土不伏","pinyin":"shuǐ tǔ bù fú","abbr":"stbf","explanation":"水土：指地方，引申为自然环境。对于一个地方的气候条件或饮食习惯不能适应。","source":{"text":"大抵此症，起于饮食失调，兼之水土不伏，食积于小腹之中，凝滞不消，遂至生热，升至胸中，便觉饥饿。","book":"明·冯梦龙《醒世恒言》第28卷"},"similar":["水土不服"],"usage":"作谓语、宾语、定语；指不适应异地的条件"},{"id":28039,"word":"水土不服","pinyin":"shuǐ tǔ bù fú","abbr":"stbf","explanation":"对于一个地方的气候条件或饮食习惯不能适应。","source":{"text":"道理来远，或不服水土，药自可疗。","book":"《三国志·吴志·周瑜传》：“不习水土，必生疾病。”《宋书·索虏传》"},"example":{"text":"大抵此症，起于饮食失调，兼之～，食积于小腹之中，凝滞不消，遂至生热，升至胸中，便觉饥饿。","book":"明·冯梦龙《醒世恒言》卷二十"},"similar":["不服水土","水土不伏"],"usage":"作谓语、宾语、定语；指不适应异地的环境"},{"id":28040,"word":"水壅而溃，伤人必多","pinyin":"shuǐ yōng ér kuì，shāng rén bì duō","abbr":"syeksrbd","explanation":"壅：堵塞；溃：河堤决口。河水一旦决口，伤害的人必然更多。比喻拒绝纳谏，堵塞言路，所带来的害处会更大。","source":{"text":"是障之也。防民之口，甚于防水。水壅而溃，伤人必多，民亦如之。","book":"《史记·周本纪》"}},{"id":28041,"word":"水复山重","pinyin":"shuǐ fù shān chóng","abbr":"sfsz","explanation":"比喻无路可走，陷入绝境。","source":{"text":"怅佳人来未，碧云冉冉；王孙去后，芳草萋萋。明日相思，山重水复。","book":"宋·刘克庄《沁园春·送包尉》"},"example":{"text":"～客到稀，文房四士独相依。","book":"宋·陆游《闲居无客所与度日笔砚纸墨而已戏作长句》"}},{"id":28042,"word":"水大鱼多","pinyin":"shuǐ dà yú duō","abbr":"sdyd","explanation":"水面宽广，鱼必众多。比喻事物随其所凭借之物的丰盛而丰盛。","source":{"text":"夫形大，衣不得褊；事众，文不得褊。事众文饶，水大鱼多。","book":"汉·王充《论衡·自纪》"},"usage":"作宾语、定语；用于口语"},{"id":28043,"word":"水天一色","pinyin":"shuǐ tiān yī sè","abbr":"stys","explanation":"水光与天色相浑。形容水天相接的辽阔景象。","source":{"text":"落霞与孤鹜齐飞，秋水共长天一色。","book":"唐·王勃《滕王阁诗序》"},"example":{"text":"那洞庭湖真个波涛万顷，～。","book":"清·钱彩《说岳全传》第四十九回"},"usage":"作定语；形容水天相接的辽阔景象"},{"id":28044,"word":"水失鱼犹为水","pinyin":"shuǐ shī yú yóu wéi shuǐ","abbr":"ssyyws","explanation":"没有鱼的水仍然是水。比喻没有君主的百姓仍然是百姓，而失掉百姓的君主，则不成其为君主。","source":{"text":"孔子谓子夏曰：‘商，汝知君之为君乎？’子夏曰：‘鱼失水则死，水失鱼犹为水也。’孔子曰：‘商，汝知之矣。’","book":"《尸子》卷下"}},{"id":28045,"word":"水宽鱼大","pinyin":"shuǐ kuān yú dà","abbr":"skyd","explanation":"宽：广大。水面宽的地方鱼肥大。比喻事物的发展由环境决定。","source":{"text":"水广鱼大，山高木修。","book":"《淮南子·说山训》"}},{"id":28046,"word":"水宿山行","pinyin":"shuǐ xiǔ shān xíng","abbr":"sxsx","explanation":"夜宿于水，日行于山。形容长途跋涉。","source":{"text":"一官万里向丰溪，水宿山行鱼浦西。","book":"唐·李嘉佑《送从弟永任饶州录事参军》诗"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第四卷：“一路～，防闲营护，皆得其力。”"},"usage":"作谓语、宾语、定语；用于旅行"},{"id":28047,"word":"水宿风餐","pinyin":"shuǐ xiǔ fēng cān","abbr":"sxfc","explanation":"水上住宿，临风野餐。形容旅途生活艰苦。","source":{"text":"吏民莫见参军面，水宿风餐鬓发焦。","book":"唐·殷尧藩《还京口》"},"example":{"text":"孙行者执了铁棒，剖开路，径下高山前进。说不尽那～，披霜冒露。","book":"明·吴承恩《西游记》第三十六回"},"similar":["餐风宿水"],"usage":"作谓语、宾语、定语；用于旅途生活"},{"id":28048,"word":"水尽山穷","pinyin":"shuǐ jìn shān qióng","abbr":"sjsq","explanation":"穷：尽。山和水都到了尽头。比喻无路可走陷入绝境。","source":{"text":"山穷水断，马束桥飞。","book":"北周·庾信《宇文常神道碑》"},"example":{"text":"论做官的道理呢，原该追究个～；然既已如此，先让他把这个供画了。","book":"清·刘鹗《老残游记》第十六回"},"similar":["山穷水尽","山穷水断","山穷水绝"],"usage":"作谓语、定语、宾语；指绝境"},{"id":28049,"word":"水尽鹅飞","pinyin":"shuǐ jìn é fēi","abbr":"sjef","explanation":"水干涸，鹅飞走。比喻恩情断绝，各走各的路。也比喻精光，一点儿也不剩。","source":{"text":"你休等的我恩断意绝，眉南面北，恁时节水尽鹅飞。","book":"元·关汉卿《望江亭》第二折"},"example":{"text":"我眼见多少肥产厚业比谭家强几倍，霎时灯消火灭，～，做讨饭吃鬼哩。（清·李绿园《歧路灯》第三十二回）"},"similar":["鸡飞蛋打","水净鹅飞"],"usage":"作宾语、定语；比喻精光，一点儿也不剩"},{"id":28050,"word":"水广鱼大","pinyin":"shuǐ guǎng yú dà","abbr":"sgyd","explanation":"广：广大。水面宽的地方鱼肥大。比喻事物的发展由环境决定。","source":{"text":"水广鱼大，山高木修。","book":"《淮南子·说山训》"}},{"id":28051,"word":"水底捞明月","pinyin":"shuǐ dǐ lāo míng yuè","abbr":"sdlmy","explanation":"到水底去捞月亮。比喻去做根本做不到的事情，只能白费力气。","source":{"text":"当初意儿别，今日相抛撒，要相逢似水底捞明月。","book":"元·无名氏《塞鸿秋·先题》曲"},"similar":["水底捞月","水中捞月"],"usage":"作定语、宾语；指白费力气"},{"id":28052,"word":"水底捞月","pinyin":"shuǐ dǐ lāo yuè","abbr":"sdly","explanation":"比喻去做根本做不到的事情，只能白费力气。同“水中捞月”。","source":{"text":"若要去葭灰黍粒中求元声，却如水底捞月。","book":"明·王守仁《传习录》卷下"},"similar":["海底捞月","水底摸月"],"usage":"作宾语；指白费力气"},{"id":28053,"word":"水底捞针","pinyin":"shuǐ dǐ lāo zhēn","abbr":"sdlz","explanation":"在水底下捞一根针。形容很难找到。","source":{"text":"俊儿夫似海内寻针，姻缘事在天数临，无缘分怎的消任？直耽搁到如今。","book":"元·吴昌龄《二郎收猪八戒》第三折"},"example":{"text":"就是小儿侥幸脱体，也是～，不知何日到手，岂可担阁人家闺女。","book":"明·冯梦龙《醒世恒言》卷九"},"similar":["海底捞针"],"usage":"作宾语、定语；指劳而无功"},{"id":28054,"word":"水底摸月","pinyin":"shuǐ dǐ mō yuè","abbr":"sdmy","explanation":"比喻去做根本做不到的事情，只能白费力气。同“水中捞月”。","source":{"text":"赊酒时风花雪月，饮之时流星赶月，讨钱时水底摸月。喻世之无赖者也。","book":"明·郎瑛《七修类稿·奇谑·谚语至理》"},"similar":["水底捞月","海底捞月"],"usage":"作宾语；指白费力气"},{"id":28055,"word":"水底纳瓜","pinyin":"shuǐ dǐ nà guā","abbr":"sdng","explanation":"形容不能容纳。","source":{"text":"好家私水底纳瓜，亲子父在拳中的这掿沙。","book":"元·张国宾《合汗衫》第二折"},"example":{"text":"我劝他似～，他觑我似镜里观花。","book":"明·兰陵笑笑生《金瓶梅词话》第四十一回"},"similar":["水里纳瓜"],"usage":"作宾语、定语；多用于比喻句"},{"id":28056,"word":"水径不深","pinyin":"shuǐ jìng bù shēn","abbr":"sjbs","explanation":"径：直，直往。水流很急的地方，水则不会深。","source":{"text":"山锐则不高，水径则不深。","book":"汉·韩婴《韩诗外传》卷一"}},{"id":28057,"word":"水性杨花","pinyin":"shuǐ xìng yáng huā","abbr":"sxyh","explanation":"象流水那样易变，象杨花那样轻飘。比喻妇女在感情上不专一。","source":{"text":"你休得强惺惺，杨花水性无凭准。","book":"宋·无名氏《小孙屠戏文》第九出"},"example":{"text":"大凡女人都是～，我若说有钱，他便是贪图银钱了。","book":"清·曹雪芹《红楼梦》第九十二回"},"similar":["搔首弄姿"],"opposite":["冰清玉洁","忠贞不渝"],"usage":"作谓语、宾语、定语；用于女性"},{"id":28058,"word":"水性随邪","pinyin":"shuǐ xìng suí xié","abbr":"sxsx","explanation":"比喻没有主见，不正派。","source":{"text":"枉了他那眠霜卧雪，阿妈他水性随邪。","book":"元·关汉卿《哭存孝》第三折"},"usage":"作谓语、定语；多用于比喻句"},{"id":28059,"word":"水懦民玩","pinyin":"shuǐ nuò mín wán","abbr":"snmw","explanation":"懦：怯懦，软弱；玩：轻视。比喻法令、政策过宽，百姓就会轻视，不遵守，以至犯罪。","source":{"text":"贵脚踏践地，使下官喜从天降。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"《左传·昭公二十年》：“水懦弱，民狎而玩之，则多死焉。故宽难。”"}},{"id":28060,"word":"水断陆绝","pinyin":"shuǐ duàn lù jué","abbr":"sdlj","explanation":"指道路阻隔，不能相通。","source":{"text":"穷南之珠，极西之玉，山海之犀象，蜀里之锦，楚南荆北之材，天下之殊也，然皆水断陆绝。","book":"宋·王令《与邵不疑书》"}},{"id":28061,"word":"水旱频仍","pinyin":"shuǐ hàn pín réng","abbr":"shpr","explanation":"频：屡次；仍：频繁。水灾、旱灾连续不断。","source":{"text":"又值水旱频仍，民穷财尽，人心思乱。","book":"明·施耐庵《水浒全传》第九十一回"},"example":{"text":"今四方刀兵乱起，～，府库空虚，民生日促。","book":"明·许仲琳《封神演义》第十八回"}},{"id":28062,"word":"水明山秀","pinyin":"shuǐ míng shān xiù","abbr":"smsx","explanation":"形容风景优美。同“水秀山明”。","source":{"text":"渐迤逦、水明山秀，暖生帘幕。","book":"宋·张先《满江红·初春》词"},"example":{"text":"马浩澜《念奴娇》词：‘冷翠柔金红绮幔，掩映～。’","book":"明·田汝成《西湖游览志·南山胜迹三》"},"similar":["水秀山明"],"usage":"作谓语、定语；形容风景优美"},{"id":28063,"word":"水晶灯笼","pinyin":"shuǐ jīng dēng lóng","abbr":"sjdl","explanation":"比喻遇事能明察是非的人。","source":{"text":"刘随待制为成都通判，严明通达，人谓之水晶灯笼。","book":"宋·范镇《东斋记事补遗》"},"example":{"text":"他的外号就是“～”"},"usage":"作宾语、定语；指人眼光锐利"},{"id":28064,"word":"水月观音","pinyin":"shuǐ yuè guān yīn","abbr":"sygy","explanation":"佛经谓观音菩萨有三十三个不同形象的法身，画作观水中月影状的称水月观音。见《法华经·普门品》。后用以喻人物仪容清。","source":{"text":"兰麝香仍在，佩环声渐远。东风摇曳垂杨线，游丝牵惹桃花片，珠帘掩映芙蓉面。你道是河中开府相公家，我道是南海水月观音现。","book":"元·王实甫《西厢记》第一本第一折"},"example":{"text":"吴宫西子不如，楚国南威难赛。若比～，一样烧香礼拜。","book":"明·冯梦龙《喻世明言》第一卷"},"usage":"作宾语、定语；用于书面语"},{"id":28065,"word":"水月镜像","pinyin":"shuǐ yuè jìng xiàng","abbr":"syjx","explanation":"水中月，镜中像。比喻一切虚幻的影像。也比喻诗中的空灵意境。","source":{"text":"空门正辟，法宇方开，峥嵘栋梁，一旦而摧，水月镜像，无心去来，徒令后学，瞻仰徘徊。","book":"唐·裴休《唐赐紫方袍大达法师玄秘塔碑铭》"},"example":{"text":"宋·释道原《景德传灯录》第14卷：“三界六道，唯有心观，～，岂有生灭？”"},"similar":["水月镜花"],"usage":"作宾语、定语；指虚幻的东西"},{"id":28066,"word":"水月镜花","pinyin":"shuǐ yuè jìng huā","abbr":"syjh","explanation":"水中月，镜中花。比喻虚幻景象。","source":{"text":"诗有可解，不可解，不必解，若水月镜花，勿泥其迹可也。","book":"明·谢榛《四溟诗话》卷一"},"example":{"text":"～空好看，不过是，今生如此算收梢。","book":"《再生缘》第六十七回"},"similar":["水月镜像"],"usage":"作主语、宾语、定语；指虚幻的东西"},{"id":28067,"word":"水木明瑟","pinyin":"shuǐ mù míng sè","abbr":"smms","explanation":"瑟：洁净鲜明的样子。形容风景清爽洁净。","source":{"text":"池上有客亭，左右楸桐，负日俯仰，目对鱼鸟，水木明瑟，可谓濠梁之性，物我无违矣。","book":"北魏·郦道元《不经注·济水》"},"example":{"text":"天镜园浴凫堂，高槐深竹，樾暗千层，坐对兰荡，一泓漾之，水木明瑟，鱼鸟藻荇，类若乘空。","book":"明·张岱《陶庵梦忆·天镜园》"}},{"id":28068,"word":"水木清华","pinyin":"shuǐ mù qīng huá","abbr":"smqh","explanation":"水：池水，溪水；木：花木；清：清幽；华：美丽有光彩。指园林景色清朗秀丽。","source":{"text":"景晨鸣禽集，水木湛清华。","book":"晋·谢混《游西池》诗"},"example":{"text":"近来又在南城外建造一座更大的花园，引三里河的水流进园中，真是～，入其园如置身江南胜地。","book":"姚雪垠《李自成》第二卷第二九章"},"similar":["水石清华"],"usage":"作谓语、定语；指园林景色清朗秀丽"},{"id":28069,"word":"水村山郭","pinyin":"shuǐ cūn shān guō","abbr":"scsg","explanation":"郭：城外城。水边的村庄，靠近山的城镇。","source":{"text":"千里莺啼绿映红，水村山郭酒旗风。","book":"唐·杜牧《江南春》诗"},"example":{"text":"故人一去无期约。尺书忽寄西飞鹤。西飞鹤。故人何在，～。","book":"宋·孙道绚《忆秦娥·季温老友归樵阳，人来闲书，因以为寄》"}},{"id":28070,"word":"水来伸手，饭来张口","pinyin":"shuǐ lái shēn shǒu，fàn lái zhāng kǒu","abbr":"slssflzk","explanation":"形容懒惰成性，坐享别人劳动成果的人。","source":{"text":"你们深宅大院，‘水来伸手，饭来张口’，只知鸡蛋是平常东西，那里知道外头买卖的行市呢？","book":"清·曹雪芹《红楼梦》第61回"},"example":{"text":"他是一个～的花花阔少。"},"similar":["衣来伸手，饭来张口"],"usage":"作定语、分句；指懒惰成性"},{"id":28071,"word":"水来土掩","pinyin":"shuǐ lái tǔ yǎn","abbr":"slty","explanation":"大水来了，用土堵住。比喻敌人来犯，就引兵抵抗。","source":{"text":"自古道兵来将迎，水来土堰，他若领兵前来，俺这里领兵与他交锋。","book":"元·高文秀《渑池会》"},"example":{"text":"自古道：‘～，兵来将迎。’","book":"明·施耐庵《水浒传》第20回"},"similar":["针锋相对"],"usage":"作定语、分句；指采取相应的措施"},{"id":28072,"word":"水枯石烂","pinyin":"shuǐ kū shí làn","abbr":"sksl","explanation":"极言历时长久。同“海枯石烂”。","source":{"text":"爱人呀，还不回来呀！我们从春望到秋，从秋望到夏，望到水枯石烂了！","book":"郭沫若《女神·湘累》"},"similar":["海枯石烂"],"usage":"作宾语、定语；用于书面语"},{"id":28073,"word":"水楔不通","pinyin":"shuǐ xiē bù tōng","abbr":"sxbt","explanation":"形容拥挤或包围的非常严密。同“水泄不通”。","source":{"text":"敕既下，水楔不通，川县相知，榜标道路。","book":"《敦煌变文集·伍子胥变文》"},"similar":["水泄不透","水泄不通"],"usage":"作谓语、状语；形容道路阻塞"},{"id":28074,"word":"水母目虾","pinyin":"shuǐ mǔ mù xiā","abbr":"smmx","explanation":"比喻没有主见，随声附和。","source":{"text":"璅蛣腹蟹，水母目虾。","book":"晋·郭璞《江赋》"},"example":{"text":"吾尝论中国人之性质，最易为一议论所转移，有百犬吠声之观，有～之性。","book":"清·梁启超《答和事人》"},"usage":"作宾语、定语；用于书面语"},{"id":28075,"word":"水泄不漏","pinyin":"shuǐ xiè bù lòu","abbr":"sxbl","explanation":"犹言滴水不漏。形容说话慎密。","source":{"text":"德山门下，水泄不通。","book":"宋·释道原《景德传灯录》"},"example":{"text":"你正是“马蹄刀木杓里切菜”，～，半点儿也没有落地！","book":"明·施耐庵《水浒全传》第二十三回"},"similar":["滴水不漏"],"usage":"作定语、状语；用于比喻句"},{"id":28076,"word":"水泄不透","pinyin":"shuǐ xiè bù tòu","abbr":"sxbt","explanation":"形容拥挤或包围的非常严密。同“水泄不通”。","source":{"text":"我觉得他的身边便总有几个包围的人们，围得水泄不透。","book":"鲁迅《而已集·扣丝杂感》"},"similar":["水泄不通","水楔不通"],"usage":"作谓语、状语；形容道路阻塞"},{"id":28077,"word":"水泄不通","pinyin":"shuǐ xiè bù tōng","abbr":"sxbt","explanation":"汇：排泄。象是连水也流不出去。形容拥挤或包围的非常严密。","source":{"text":"德山门下，水泄不通。","book":"宋·释道原《景德传灯录》"},"example":{"text":"热心的读者除邮局汇捐款络绎不绝外，每天到门口来亲交捐款的，也挤得～。","book":"邹韬奋《经历·社会的信用》"},"similar":["风雨不透","人山人海"],"opposite":["畅通无阻","四通八达"],"usage":"作谓语、状语；形容道路阻塞"},{"id":28078,"word":"水波不兴","pinyin":"shuǐ bō bù xīng","abbr":"sbbx","explanation":"没有涟漪和波纹。形容十分平静。","source":{"text":"苏子与客泛舟游于赤壁之下。清风徐来，水波不兴。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"清·石玉昆《小五义》第42回：“女娟见风恬浪静，～，因对简子说道。”"},"similar":["风平浪静"],"opposite":["波澜壮阔"],"usage":"作谓语、定语；指十分平静"},{"id":28079,"word":"水泼不进","pinyin":"shuǐ pō bù jìn","abbr":"spbj","explanation":"比喻一个人不接受意见或者一个单位拒绝和外界来往。","example":{"text":"他们的防线真是～的。"},"similar":["固若金汤","紧密无间"],"usage":"作定语；指十分稳固"},{"id":28080,"word":"水洁冰清","pinyin":"shuǐ jié bīng qīng","abbr":"sjbq","explanation":"像冰水一样洁白清净。形容人品高洁或文笔雅致。","source":{"text":"金刚玉润，水洁冰清，郁郁文彩，唤若朝荣。","book":"晋·张华《魏刘骠骑诔》"},"similar":["冰清玉洁"],"usage":"作谓语、状语；多用于人品与操行等"},{"id":28081,"word":"水洩不通","pinyin":"shuǐ xiè bù tōng","abbr":"sxbt","explanation":"汇：排泄。象是连水也流不出去。形容拥挤或包围的非常严密。同“水泄不通”。"},{"id":28082,"word":"水流云散","pinyin":"shuǐ liú yún sàn","abbr":"slys","explanation":"比喻时过境迁，人各一方。","source":{"text":"水流云散各西东。半廊花院月，一帽柳桥风。","book":"宋·陆游《临江仙·离果州作》词"},"example":{"text":"待殷勤寄与，旧游莺燕，～。","book":"元·张翥《陌上花·使归闽浙岁暮有怀》词"},"similar":["水流花落"],"usage":"作宾语、定语；用于书面语"},{"id":28083,"word":"水流湿，火就燥","pinyin":"shuǐ liú shī，huǒ jiù zào","abbr":"slshjz","explanation":"水向湿处流，火往干处烧。指物之气质类似必相感应。后用以比喻事物发展的必然规律。","source":{"text":"此二者以形象相感。水流於地，先就湿处；火焚其薪，先就燥处。","book":"《易·乾》：“水流湿，火就燥，云从龙，风从虎……各从其类也。”孔颖达疏"}},{"id":28084,"word":"水流花落","pinyin":"shuǐ liú huā luò","abbr":"slhl","explanation":"①比喻飘泊不定或踪迹无常。②比喻时过境迁。","source":{"text":"水流花落叹浮生，又伴游人宿杜城。","book":"唐·温庭筠《宿城南亡友别墅》诗"},"example":{"text":"今哭阿雄，爱心大动，又增修持一病。然过此以往，～，总不相关矣。","book":"清·尤侗《遗亡友汤卿谋书》"},"similar":["时过境迁","漂泊不定"],"usage":"作宾语、定语；用于书面语"},{"id":28085,"word":"水流花谢","pinyin":"shuǐ liú huā xiè","abbr":"slhx","explanation":"谢：脱落。指河水流逝，花儿也凋谢了。形容景色凋零残败，用来比喻局面残破，好景已不存在，无法挽回。亦作“花谢水流”。","source":{"text":"水流花谢魂安在，空有骚人赋大招。","book":"清·吴道潜《骆宾王遗墓诗》"},"example":{"text":"浊酒一杯沉醉去，～知何处？","book":"《儒林外史》第一回"},"usage":"作宾语、定语；用于比喻句"},{"id":28086,"word":"水浅不容大鱼","pinyin":"shuǐ qiǎn bù róng dà yú","abbr":"sqbrdy","explanation":"容：容纳。指有才能的人无法在小地方或小单位发挥作用。","source":{"text":"地薄者大物不产，水浅者大鱼不游；树秃者大禽不栖，林疏者大兽不居。","book":"汉·黄石公《素书·白文》"}},{"id":28087,"word":"水浅者大鱼不游","pinyin":"shuǐ qiǎn zhě dà yú bù yóu","abbr":"sqzdyby","explanation":"水太浅则大鱼不能生存。比喻条件太差或待人过苛，有才德的人则难以发挥其特长。","source":{"text":"地薄者大物不产，水浅者大鱼不游；树秃者大禽不栖，林疏者大兽不居。","book":"汉·黄石公《素书·白文》"}},{"id":28088,"word":"水浆不入","pinyin":"shuǐ jiāng bù rù","abbr":"sjbr","explanation":"流汁也无法进口。形容病重或劳伤过度。","source":{"text":"水浆不入于口者，至自禹它。","book":"南朝·梁·任昉《齐竟陵文宣王行状》"},"example":{"text":"公顿伏苫寝，～，虽王人劝夺，创巨越增。","book":"北周·庚信《周大将军赵公墓铭》"},"similar":["滴水不沾"],"usage":"作谓语、定语；用于书面语"},{"id":28089,"word":"水浊鱼噞","pinyin":"shuǐ zhuó yú yǎn","abbr":"szyy","explanation":"浊：浑浊；噞：鱼张口呼吸的样子。因水太浑浊使鱼喘不过气来，只得露出水面张口呼吸。比喻苛政之下民不聊生。","source":{"text":"夫水浊则鱼噞，政苛则民乱。","book":"《淮南子·主术训》"}},{"id":28090,"word":"水涨船高","pinyin":"shuǐ zhǎng chuán gāo","abbr":"szcg","explanation":"水位升高，船身也随之浮起。比喻事物随着它所凭借的基础的提高而增长提高。","source":{"text":"水长船高，泥多佛大。","book":"宋·释道原《景德传灯录》"},"example":{"text":"几回事情一来，他晓得人家有仰仗他的地方，顿时～，架子亦就慢慢的大了起来。","book":"清·李宝嘉《官场现形记》第五十九回"},"similar":["情随事迁","水长船高"],"opposite":["一成不变"],"usage":"作谓语、定语；用于事物随环境在变"},{"id":28091,"word":"水深火热","pinyin":"shuǐ shēn huǒ rè","abbr":"sshr","explanation":"老百姓所受的灾难，象水那样越来越深，象火那样越来越热。比喻人民生活极端痛苦。","source":{"text":"如水益深，如火益热，亦运而已矣。","book":"《孟子·梁惠王下》"},"example":{"text":"只要能把国家从～里救出来，他就是至高无上的英雄。","book":"梁斌《红旗谱》四二"},"similar":["水火之中","民不聊生"],"opposite":["安居乐业","人寿年丰"],"usage":"作宾语、定语；指人民生活","story":["战国时期，燕国由于相国子之暴政，大将子被、太子平率兵讨伐被打败，国内大乱。齐国齐宣王趁机出兵攻打燕国，燕国老百姓欢迎齐军，齐宣王侵吞了燕国后问孟子为什么燕国老百姓欢迎齐军，孟子说：“老百姓为了摆脱水深火热的局面。"]},{"id":28092,"word":"水深鱼聚","pinyin":"shuǐ shēn yú jù","abbr":"ssyj","explanation":"聚：聚集。水越深鱼越聚集。比喻越有德行，依附他的人就越多。","source":{"text":"林茂鸟有归，水深鱼知聚。","book":"《史记·货殖列传》：“渊深而鱼生之，山深而兽往之，人富而仁义附焉。”唐·杜甫《遣兴》"}},{"id":28093,"word":"水清无鱼","pinyin":"shuǐ qīng wú yú","abbr":"sqwy","explanation":"水太清，鱼就存不住身，对人要求太苛刻，就没有人能当他的伙伴。比喻过分计较人的小缺点，就不能团结人。","source":{"text":"故水清无鱼，人察无徒。","book":"汉·班固《白虎通》"},"example":{"text":"谁都知道～的道理，你还是得过且过吧。"},"similar":["水至清则无鱼"],"usage":"作谓语、分句；指不能过于要求"},{"id":28094,"word":"水清石见","pinyin":"shuǐ qīng shí xiàn","abbr":"sqsj","explanation":"清：清澈；见：同“现”，显露。比喻情况搞清楚了，问题的性质也就明白了。","source":{"text":"语卿且勿眄，水清石自见。石见何累累，远行不如归。","book":"汉·无名氏《艳歌行》"},"example":{"text":"～，无半点瑕疵。","book":"明·汤显祖《牡丹亭·旁疑》"}},{"id":28095,"word":"水源木本","pinyin":"shuǐ yuán mù běn","abbr":"symb","explanation":"源：水的源头；木：树的根。水的源头，树的根本。比喻事物的根本或事情的原因。","source":{"text":"我在伯父，犹衣服之有冠冕，水木之有本原，民人之有谋主也。","book":"《左传·昭公九年》"},"example":{"text":"我如今何不上荆州府走一回，一重～之谊。","book":"清·李绿园《歧路灯》第八十六回"}},{"id":28096,"word":"水满则溢","pinyin":"shuǐ mǎn zé yì","abbr":"smzy","explanation":"溢：水满外流。水满了就会流出来。比喻事物发展到极端就向相反方面变化。","source":{"text":"你如何连两句俗话也不晓得？常言道：‘月满则亏，水满则溢。’","book":"清·曹雪芹《红楼梦》第13回"},"similar":["月满则亏","器满则盈"],"usage":"作宾语、定语；用于书面语"},{"id":28097,"word":"水满金山","pinyin":"shuǐ mǎn jīn shān","abbr":"smjs","explanation":"神话故事。金山，在江苏省镇江市。同“水漫金山”。","source":{"text":"[法海禅师]便将他藏在金山寺的法座后，白蛇娘娘来寻夫，于是就水满金山。","book":"鲁迅《坟·论雷峰塔的倒掉》"},"similar":["水漫金山"],"usage":"作谓语、宾语、定语；用于比喻句","story":["传说古代白蛇娘子与许仙一见钟情后，就结为夫妻。法海和尚见到许仙面带妖气，就把他带到金山寺藏到法座后，白蛇娘子带领小青蛇来寻夫，法海不许。白蛇娘子无奈只好与法海斗法，于是水漫金山，法海搬来天兵天将来对付白蛇，将白蛇压在雷峰塔下"]},{"id":28098,"word":"水滴石穿","pinyin":"shuǐ dī shí chuān","abbr":"sdsc","explanation":"水不停地滴，石头也能被滴穿。比喻只要有恒心，不断努力，事情就一定能成功。","source":{"text":"泰山之霤穿石，单极之绠断干。水非石之钻，索非木之锯，渐靡使之然也。","book":"《汉书·枚乘传》"},"example":{"text":"乖崖援笔判云：“一日一钱，千日千钱；绳锯木断，～。”","book":"宋·罗大经《鹤林玉露》卷十"},"similar":["磨杵成针","绳锯木断"],"opposite":["虎头蛇尾"],"usage":"作定语；指坚持就会成功","story":["宋朝崇阳县令张乖崖为官清廉，铁面无私。一次见县衙管理铁库的库吏从钱库里偷了一文钱，张乖崖认为数量虽小但性质严重，必须严惩。该官吏不服，张乖崖判他死刑并在判决书上写道：“一日一钱，千日一千；绳锯木断，水滴石穿。”"]},{"id":28099,"word":"水漫金山","pinyin":"shuǐ màn jīn shān","abbr":"smjs","explanation":"神话故事。金山，在江苏省镇江市。","source":{"text":"金山寺里法海一见许仙，面带妖色，不放下山。怒恼白蛇，忙唤青儿，带领着虾兵蟹将，这才水漫金山。","book":"《白雪遗音·马头调·雷峰塔》"},"example":{"text":"福根《追老姚》：“暴风雨洗刷着河北平原，窑厂周围像～，混浊的大水足有半人高。”"},"similar":["水满金山"],"usage":"作宾语、定语；用于比喻句","story":["传说古代白蛇娘子与许仙一见钟情后，就结为夫妻。法海和尚见到许仙面带妖气，就把他带到金山寺藏到法座后，白蛇娘子带领小青蛇来寻夫，法海不许。白蛇娘子无奈只好与法海斗法，于是水漫金山，法海搬来天兵天将来对付白蛇，将白蛇压在雷峰塔下"]},{"id":28100,"word":"水激则旱","pinyin":"shuǐ jī zé hàn","abbr":"sjzh","explanation":"旱：同“悍”，勇猛；激：因水受阻或震荡而向上涌。指水流受阻，激而劲悍。比喻越受阻挠，越能激起力量。","source":{"text":"水激则旱兮，矢激则远。","book":"《史记·屈原贾生列传》"}},{"id":28101,"word":"水激则旱，矢激则远","pinyin":"shuǐ jī zé hàn，shǐ jī zé yuǎn","abbr":"sjzhsjzy","explanation":"水流矢飞，受阻则劲悍而去远。旱，通“悍”。比喻因祸致福。"},{"id":28102,"word":"水火不兼容","pinyin":"shuǐ huǒ bù xiāng róng","abbr":"shbjr","explanation":"容：容纳。比喻二者对立，绝不兼容。","source":{"text":"故水火不相逮。","book":"《周易·说卦》"},"example":{"text":"他们闹得～。"}},{"id":28103,"word":"水火不容","pinyin":"shuǐ huǒ bù róng","abbr":"shbr","explanation":"容：容纳。水和火是两种性质相反的东西，根本不相容。比喻二者对立，绝不相容。","source":{"text":"《易》有八卦，乾坤六子，水火不相逮，雷风不相悖，山泽通气，然后能变化，既成万物也。","book":"汉·王符《潜夫论·慎微》：“且夫邪之与正，犹水与火，不同原，不得并盛。”《汉书·郊祀志下》"}},{"id":28104,"word":"水火不投","pinyin":"shuǐ huǒ bù tóu","abbr":"shbt","explanation":"水和火是两种性质相反的东西，根本不相容。比喻二者对立，绝不相容。","source":{"text":"且夫邪之与正，犹水与火，不同原，不得并盛。","book":"汉·王符《潜夫论·慎微》"},"example":{"text":"～母道损，阴阳难合各分开。","book":"明·吴承恩《西游记》第八十三回"}},{"id":28105,"word":"水火不相容","pinyin":"shuǐ huǒ bù xiāng róng","abbr":"shbxr","explanation":"容：容纳。比喻二者对立，绝不相容。","source":{"text":"《易》有八卦，乾坤六子，水火不相逮，雷风不相悖，山泽通气，然后能变化，既成万物也。","book":"汉·王符《潜夫论·慎微》：“且夫邪之与正，犹水与火，不同原，不得并盛。”《汉书·郊祀志下》"},"example":{"text":"太太！求道不求医，求医不求道，医者治病靠药力，道者治病靠神力，医道两门，～。","book":"曲波《林海雪原》一一"},"similar":["势不两立"],"opposite":["水乳交融"],"usage":"作谓语、补语；指两者关系不可协调"},{"id":28106,"word":"水火不辞","pinyin":"shuǐ huǒ bù cí","abbr":"shbc","explanation":"指赴汤蹈火，在所不辞。","source":{"text":"兵既整齐，王可试下观之，唯王所欲用之，虽赴水火犹可也。","book":"《史记·孙子吴起列传》"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第四卷：“凭爷分付，那厢使用，～。”"},"usage":"作谓语、定语；用于处事"},{"id":28107,"word":"水火不避","pinyin":"shuǐ huǒ bù bì","abbr":"shbb","explanation":"指不避艰险。","source":{"text":"若有驱使，奋勇直前，水火不避。","book":"《醒世恒言·徐老仆义愤成家》"},"example":{"text":"懒龙道：‘小人是市井无赖，既蒙相公青目，要干何事，小人～。’","book":"《二刻拍案惊奇》卷二九"},"similar":["不避水火"],"usage":"作谓语、定语；指人勇敢"},{"id":28108,"word":"水火之中","pinyin":"shuǐ huǒ zhī zhōng","abbr":"shzz","explanation":"水火：比喻灾难。灾难困苦之中。","source":{"text":"今燕虐其民，王往而证之，民以为将拯己于水火之中也。","book":"《孟子·梁惠王下》"},"example":{"text":"今百姓如在～。","book":"明·许仲琳《封神演义》第二十八回"},"similar":["危难之中，水深火热"],"usage":"作宾语；指灾难困苦之中"},{"id":28109,"word":"水火兵虫","pinyin":"shuǐ huǒ bīng chóng","abbr":"shbc","explanation":"指使古书遭受损毁的四种灾害：水灾、火灾、战乱和书蠹。也泛指各种天灾人祸。","source":{"text":"今人标点古书而古书亡，因为他们乱点一通，佛头着粪：这是古书的水火兵虫以外的三大厄。","book":"鲁迅《且介亭杂文·病后杂谈之余》"},"similar":["天灾人祸"],"usage":"作宾语、定语；用于书面语"},{"id":28110,"word":"水火无交","pinyin":"shuǐ huǒ wú jiāo","abbr":"shwj","explanation":"没有财物牵涉。形容为官清正廉洁。","source":{"text":"别驾在官，水火不与百姓交，是以不敢以壶酒相送。","book":"《隋书·循吏传·赵轨》"},"example":{"text":"我与他也是～，今日才见。","book":"清·文康《儿女英雄传》第八回"},"similar":["清正廉明","水菜不交"],"opposite":["贪污腐化"],"usage":"作谓语、定语、状语；指为官清正廉洁"},{"id":28111,"word":"水火无情","pinyin":"shuǐ huǒ wú qíng","abbr":"shwq","explanation":"指水和火是不讲情面的，如疏忽大意，容易造成灾祸。","source":{"text":"俺城中把金鼓鸣，正是外合里应，教智伯才知水火无情。","book":"元·杨梓《豫让吞炭》第二折"},"example":{"text":"水火无情，我们都应该提高防范意识。"},"usage":"作主语、补语、分句；指水和火是不讲情面"},{"id":28112,"word":"水火相济，盐梅相成","pinyin":"shuǐ huǒ xiāng jì，yán méi xiāng ché","abbr":"shxjymxc","explanation":"烹饪赖水火而成，调味兼盐梅而用。喻人之才性虽各异，而可以和衷共济。","source":{"text":"天子置三公、九卿……本欲水火相济，盐梅相成，然后庶绩咸熙，风雨交泰。","book":"《旧唐书·忠义传上·王义方》"},"example":{"text":"[太公伯夷]念王室之如毁，固欲起而救乱，思冠冕之毁裂，又恐因而阶乱，故～，各以一事自任。","book":"宋·罗大经《鹤林玉露》卷十二"},"usage":"作宾语、定语；用于比喻句"},{"id":28113,"word":"水牛过河","pinyin":"shuǐ niú guò hé","abbr":"sngh","explanation":"指出露头角，出头露面。","example":{"text":"这次她的演出算是～露头角了。"},"usage":"作宾语、定语；指出头露面"},{"id":28114,"word":"水盛胜火","pinyin":"shuǐ shèng shèng huǒ","abbr":"sssh","explanation":"盛：强烈。水势盛大定能战胜火势。比喻善良终究能战胜邪恶。","source":{"text":"遭逢之祸大，命善禄盛不能却也。譬犹水火相更也，水盛胜火，火盛胜水。","book":"汉·王充《论衡·命义》"}},{"id":28115,"word":"水石清华","pinyin":"shuǐ shí qīng huá","abbr":"ssqh","explanation":"指园林景色清朗秀丽。同“水木清华”。","source":{"text":"且岩壑闲远，水石清华，虽复崇门八袭，高城万雉，莫不蓄壤开泉，仿佛林泽。","book":"《宋书·隐逸传论》"},"similar":["水木清华"],"usage":"作谓语、定语；指园林景色清朗秀丽"},{"id":28116,"word":"水碧山青","pinyin":"shuǐ bì shān qīng","abbr":"sbsq","explanation":"形容景色艳丽如画。","source":{"text":"骆驼桥上苹风起，鹦鹉杯中箬雨青。水碧山青知好处，开颜一笑问何人。","book":"唐·刘禹锡《洛中逢韩七中丞之吴兴口号五首》"},"similar":["山清水秀","水绿山青"],"usage":"作宾语、定语；用于景物描写"},{"id":28117,"word":"水磨功夫","pinyin":"shuǐ mó gōng fū","abbr":"smgf","explanation":"掺水细磨。比喻周密细致的工夫。","source":{"text":"安太太一年的水磨功夫，才陶熔得姑娘这等出娴贞静。","book":"清·文康《儿女英雄传》第25回"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“我是不容你下～。”"},"similar":["水磨工夫"],"opposite":["操之过急"],"usage":"作宾语；形容某件事物的周密细致"},{"id":28118,"word":"水磨工夫","pinyin":"shuǐ mó gōng fū","abbr":"smgf","explanation":"掺水细磨。形容工作深入细致，费时很多。","source":{"text":"今日撞了一日，并不曾遇得个可意人儿。不想这所在到藏着如此妙人。须用些水磨工夫撩拨他，不怕不上我的钩儿。","book":"明·冯梦龙《醒世恒言》卷十五"},"example":{"text":"第一须用上些～，叫他们潜移默化，断不可操切从事，以致打草惊蛇，反为不美。","book":"清·李宝嘉《文明小史》第一回"},"similar":["磨杵成针","磨穿铁砚"],"opposite":["粗枝大叶","操之过急"],"usage":"作宾语；形容某件事物的周密细致"},{"id":28119,"word":"水秀山明","pinyin":"shuǐ xiù shān míng","abbr":"sxsm","explanation":"山光明媚，水色秀丽。形容风景优美。","source":{"text":"眉黛敛秋波，尽湖南，山明水秀。","book":"宋·黄庭坚《蓦山溪·赠衡阳陈湘》"},"example":{"text":"红外风娇日暖，翠边～。","book":"宋·高观国《风入松》"},"similar":["山明水秀"],"usage":"作谓语、定语；形容风景优美"},{"id":28120,"word":"水积成川","pinyin":"shuǐ jī chéng chuān","abbr":"sjcc","explanation":"川：河流。指水积多了才能成为河流。比喻在学习上日积月累，必然能成才。","source":{"text":"水积成川，则蛟龙生焉；土积成山，则豫樟生焉；学积成圣，则富贵尊显至焉。","book":"汉·刘向《说苑·建本》"},"example":{"text":"～，载澜载清。土积成山，歊蒸郁冥。","book":"晋·张华《励志诗九首》其七"}},{"id":28121,"word":"水穷山尽","pinyin":"shuǐ qióng shān jìn","abbr":"sqsj","explanation":"水和山都到了尽头，前面无路可走。比喻陷入绝境。","source":{"text":"行到水穷山尽处，斜阳依旧向西倾。","book":"元·丘处机《雪山》诗"},"example":{"text":"那些人只要混得过去就行了的，可是，我们究竟也还没有到～的时候啦！","book":"沙汀《困兽记》十八"},"similar":["山穷水尽"],"usage":"作谓语、定语、宾语；指绝境"},{"id":28122,"word":"水米不粘牙","pinyin":"shuǐ mǐ bù zhān yá","abbr":"smbzy","explanation":"没喝水也没吃饭。形容病重不能进食。","source":{"text":"不则俺那姐姐害，那生呵！二三日来水米不粘牙。因姐姐闭月羞花，真假、这其间性儿难按纳，一地里胡拿。","book":"元·王实甫《西厢记》第三本第三折"},"example":{"text":"大清早上，～，从你家走到这里，就是办皇差也不能这般寡刺！","book":"清·吴敬梓《儒林外史》第四十五回"}},{"id":28123,"word":"水米无交","pinyin":"shuǐ mǐ wú jiāo","abbr":"smwj","explanation":"指没有吃过别人一点东西。比喻为官清廉，不妄取民物。也比喻双方毫无往来。","source":{"text":"老夫在此为理三年，治百姓水米无交，于天香秋毫不染。","book":"元·关汉卿《谢天香》第四折"},"example":{"text":"兄弟在这巴县～，就算是有事，也只好自己去做的了。","book":"清·吴趼人《糊涂世界》卷十一"},"similar":["水火无交","水菜不交","水火无交"],"opposite":["横征暴敛"],"usage":"作谓语、定语；指为官清廉"},{"id":28124,"word":"水米无干","pinyin":"shuǐ mǐ wú gàn","abbr":"smwg","explanation":"比喻彼此经济上没有往来。旧时指官吏清廉。同“水米无交”。","source":{"text":"我知道上海虽然也许比知道绍兴多些，但是绍兴究竟是我的祖籍，上海是和我水米无干的。","book":"朱自清《我是扬州人》"},"similar":["水菜不交","水火无交","水米无交"],"usage":"作谓语、定语；用于书面语"},{"id":28125,"word":"水绿山青","pinyin":"shuǐ lǜ shān qīng","abbr":"slsq","explanation":"形容景色艳丽如画。","source":{"text":"水绿山青风日美，此时正惬幽人意。","book":"唐·刘禹锡《洛中逢韩七中丞之吴兴口号五首》：“骆驼桥上苹风起，鹦鹉杯中箬雨青。水碧山青知好处，开颜一笑问何人。”宋·吕胜己《渔家傲》词"},"example":{"text":"此去剑门，鸟啼花落，～，无非助朕悲悼妃子之由也。","book":"清·褚人获《隋唐演义》第九十一回"},"similar":["水碧山清","山清水秀"],"usage":"作宾语、定语；用于景物描写"},{"id":28126,"word":"水置座右","pinyin":"shuǐ zhì zuò yòu","abbr":"szzy","explanation":"置：搁，放。比喻知足。","source":{"text":"仕至郎中矣。至是持一石止水，置于座右，以示有止足之意","book":"《旧唐书·文苑传》"}},{"id":28127,"word":"水能载舟，亦能覆舟","pinyin":"shuǐ néng zài zhōu，yì néng fù zhōu","abbr":"snzzynfz","explanation":"载：承载；覆：倾覆。比喻在平时要想到可能发生的困难和危险，事物有利有害。","source":{"text":"故喻君为舟，喻人为水，言水能载舟亦能覆舟也，舟即君道，水即人情，舟顺水之道则浮，违则没。","book":"唐·陆贽《奉天论延访朝臣表》"},"example":{"text":"～，电报亦是如此，非得托付给很妥当的人不可，否则机密容易外泄。","book":"高阳《胡雪岩全传·灯火楼台》"},"similar":["载舟覆舟","水可载舟，亦可覆舟"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":28128,"word":"水至清则无鱼","pinyin":"shuǐ zhì qīng zé wú yú","abbr":"szqzwy","explanation":"水太清，鱼就存不住身，对人要求太苛刻，就没有人能当他的伙伴。比喻过分计较人的小缺点，就不能团结人。","source":{"text":"故水至清则无鱼，人至察则无徒。","book":"西汉·戴圣《大戴礼记·子张问入官》"},"example":{"text":"故～，政至察则众乖，此自然之势也。","book":"《晋书·郭璞传》"},"similar":["水清无鱼"],"opposite":["浑水摸鱼"],"usage":"作分句；用于劝诫人"},{"id":28129,"word":"水色山光","pinyin":"shuǐ sè shān guāng","abbr":"sssg","explanation":"水波泛出秀色，山上景物明净。形容山水景色秀丽。","source":{"text":"楼阁高低树浅深，山光水色暝暝沈沈。","book":"唐·白居易《菩提寺上方晚眺》诗"},"example":{"text":"既登途，凡道中风晨月夕，～，睹景怀人，只增悲惋。","book":"明·李昌祺《剪灯余话·贾云华还魂记》"},"similar":["湖光山色","水光山色"],"usage":"作宾语、定语；形容山水"},{"id":28130,"word":"水菜不交","pinyin":"shuǐ cài bù jiāo","abbr":"scbj","explanation":"比喻彼此经济上没有往来。旧时指官吏清廉。同“水米无干”。","source":{"text":"[文帝]在任清俭，与民水菜不交。","book":"《八琼室金石补正·北周强独乐文帝庙造像碑》"},"similar":["水火无交"],"usage":"作谓语、定语；用于生活"},{"id":28131,"word":"水落归槽","pinyin":"shuǐ luò guī cáo","abbr":"slgc","explanation":"四溢的洪水流入了河槽。比喻一心惦记着的事有了着落。","source":{"text":"今日听了这些话，心里方才水落归漕，倒也喜欢。","book":"清·曹雪芹《红楼梦》第九十六回"},"example":{"text":"转眼就是腊月，～，河工也就合龙。","book":"清·李宝嘉《中国现在记》第十回"},"similar":["水落归漕"],"usage":"作谓语、定语；用于比喻句"},{"id":28132,"word":"水落归漕","pinyin":"shuǐ luò guī cáo","abbr":"slgc","explanation":"汛期过后，水位下降，河水流入了河槽。","source":{"text":"今日听了这些话，心里方才水落归漕，倒也喜欢。","book":"清·曹雪芹《红楼梦》第96回"},"similar":["水落归槽"],"usage":"作谓语、定语；比喻惦记的事有了着落"},{"id":28133,"word":"水落石出","pinyin":"shuǐ luò shí chū","abbr":"slsc","explanation":"水落下去，水底的石头就露出来。比喻事情的真相完全显露出来。","source":{"text":"山高月小，水落石出。","book":"宋·欧阳修《醉翁亭记》：“野芳发而幽香，佳木秀而繁阴，风霜高洁，水落而石出者，山间之四时也。”宋·苏轼《后赤壁赋》"},"example":{"text":"水山，不要急。事情早晚能弄个～。","book":"冯德英《迎春花》第二十章"},"similar":["真相大白","原形毕露"],"opposite":["匿影藏形"],"usage":"作谓语、宾语、定语；指真相完全显露出来","story":["北宋时期，著名文学家苏轼生性豪放，学识渊博，很有文采。他不愿屈服权贵，被贬到黄州，两次游历黄州城外的赤壁，写出两篇《赤壁赋》。他借着酒兴，在《后赤壁赋》中描绘赤壁是：江流有声，断岸千尺，山高月小，水落石出"]},{"id":28134,"word":"水裙风带","pinyin":"shuǐ qún fēng dài","abbr":"sqfd","explanation":"形容舞衣的飘动。","source":{"text":"正清歌满台，水裙风带，三更未歇轻盈舞。","book":"清·孔尚任《桃花扇·逃难》"}},{"id":28135,"word":"水覆难收","pinyin":"shuǐ fù nán shōu","abbr":"sfns","explanation":"覆：倒。倒在地上的水难以收回。比喻事情已成定局，无法挽回。","source":{"text":"念璧月长亏，玉簪中断，覆水难收。","book":"《后汉书·何进传》：“国家之事易可容易？覆水不收，宜深思之。”宋·张孝祥《木兰花慢·紫箫吹散后词》"},"similar":["覆水难收"],"usage":"作谓语、宾语、分句；比喻事情已成定局"},{"id":28136,"word":"水调歌头","pinyin":"shuǐ diào gē tóu","abbr":"sdgt","explanation":"词牌名。","source":{"text":"相传隋炀帝开汴河时曾制《水调歌》，唐人演为大曲。大曲有散序、中序、入破三部分，“歌头”当为中序的第一章。双调九十四字至九十七字，前后片各四平韵。宋人于前后片中的各两个六字句，多夹叶仄韵。也有平仄互叶几乎句句押韵的。共八体。"}},{"id":28137,"word":"水软山温","pinyin":"shuǐ ruǎn shān wēn","abbr":"srsw","explanation":"形容景色幽雅。","source":{"text":"老爷果肯见怜，这功德不小，保奏淮水软山温。","book":"清·孔尚任《桃花扇·拒媒》"}},{"id":28138,"word":"水过地皮湿","pinyin":"shuǐ guò dì pí shī","abbr":"sgdps","explanation":"水流过地面，地皮就湿。意思是没二话，就是这样。也用来比喻事情办过没什么效果，作用不大，印象不深。","source":{"text":"如今没别的，水过地皮湿，姑娘就是照师傅的话，实打实的这么一点头，算你瞧得起这个师傅了。","book":"清·文康《儿女英雄传》第二十七回"},"example":{"text":"官家的事儿，不过是～，卖个眼前俏就算了！","book":"孙犁《风云初记》二十五"}},{"id":28139,"word":"水过鸭背","pinyin":"shuǐ guò yā bèi","abbr":"sgyb","explanation":"比喻事过之后没有留下一点痕迹。","example":{"text":"事情已经过去，像～一样，就不要再担心了"},"usage":"作宾语、定语；用于比喻句"},{"id":28140,"word":"水远山遥","pinyin":"shuǐ yuǎn shān yáo","abbr":"sysy","explanation":"指路程遥远。","source":{"text":"我避不得水远山遥，须有一个日头走到。","book":"宋·汪元量《忆秦娥》词之七：“心如焦。彩笺难寄，水远山遥。”元·关汉卿《哭存孝》第四折"},"example":{"text":"淅零零洒琼瑶，乱纷纷剪鹅毛。越映的江阔天低，～。","book":"元·金仁杰《追韩信》第一折"},"similar":["山遥水远"],"opposite":["近在咫尺"],"usage":"作谓语、宾语；比喻道路遥远艰险"},{"id":28141,"word":"水远山长","pinyin":"shuǐ yuǎn shān cháng","abbr":"sysc","explanation":"形容路途遥远，关山阻隔。","source":{"text":"忆得旧时携手处，如今水远山长。","book":"宋·辛弃疾《临江仙》词"},"example":{"text":"清·褚人获《隋唐演义》第11回：“愁里看春不当春，每逢佳节倍思亲。谁堪登眺烟云里，～愁杀人。”"},"similar":["山长水远","水远山遥"],"usage":"作谓语、宾语；比喻道路遥远艰险"},{"id":28142,"word":"水送山迎","pinyin":"shuǐ sòng shān yíng","abbr":"sssy","explanation":"玩赏风景，寄情山水。也指旅途绵长。","source":{"text":"水送山迎入富春，一川如画晚晴新。","book":"唐·吴融《富春》诗"},"example":{"text":"元·魏初《沁园春·留别张周卿韵》词：“甚年来行役，交情契阔，东奔西走，～。”"},"usage":"作宾语、定语；用于书面语"},{"id":28143,"word":"水里纳瓜","pinyin":"shuǐ lǐ nà guā","abbr":"slng","explanation":"比喻格格不入，不能相容。","source":{"text":"我劝谏他似水里纳瓜，他看觑咱如镜里观花。","book":"元·乔孟符《两世姻缘》第三折"},"similar":["水底纳瓜"],"usage":"作宾语、定语；多用于比喻句"},{"id":28144,"word":"水银泻地","pinyin":"shuǐ yín xiè dì","abbr":"syxd","explanation":"泻：流得很快。水银倒在地上，很快就会全部渗入土中。比喻无微不至，极为细密周到。也比喻非常流畅，一气呵成。","example":{"text":"舞到后来，只见一团电光，滚来滚去，宛如～，花雨缤纷！","book":"梁羽生《七剑下天山》第十四回"}},{"id":28145,"word":"水长船高","pinyin":"shuǐ zhǎng chuán gāo","abbr":"szcg","explanation":"比喻事物随着所凭借的基础的提高而提高。","source":{"text":"水长船高，泥多佛大。","book":"宋·释普济《五灯会元·芭蕉清禅师法嗣·芭蕉继彻禅师》"},"example":{"text":"长姐儿更不想到此时～，不曾吃尽苦中苦，早得修成人上人，一时好不兴致，连忙又给太太磕了个头。","book":"清·文康《儿女英雄传》第四十回"},"similar":["水涨船高"],"usage":"作谓语、定语；用于事物随环境在变"},{"id":28146,"word":"水阔山高","pinyin":"shuǐ kuò shān gāo","abbr":"sksg","explanation":"指隔着高山大河，不得相能。","source":{"text":"音书谁送，知隔着关山几重，见如今水阔山高，促急里怎觅鳞鸿。","book":"明·胡文焕《群音类选·清腔类·山坡里羊一套》"},"similar":["山高水阔"],"usage":"作谓语、定语；用于书面语"},{"id":28147,"word":"水陆之珍","pinyin":"shuǐ lù zhī zhēn","abbr":"slzz","explanation":"水陆：指水陆所产的珍贵食物。指美味佳肴。","source":{"text":"丝竹尽当时之选，庖膳穷水陆之珍。","book":"《晋书·石崇传》"},"example":{"text":"篯出入以庖者十余人从行，食皆～鲜，厚自奉养，无与为比。《旧唐书·张篯传》"}},{"id":28148,"word":"水陆之馔","pinyin":"shuǐ lù zhī zhuàn","abbr":"slzz","explanation":"馔：饭食；水陆：水上和陆上出产的山珍海味。泛指山珍海味。","source":{"text":"旬余，方荐水陆之馔。","book":"唐·白行简《李娃传》"}},{"id":28149,"word":"水陆俱备","pinyin":"shuǐ lù jù bèi","abbr":"sljb","explanation":"水：指水产，海味；陆：指陆产，山珍；俱：全。各种山珍海味都有。形容宴席上菜肴丰盛。","source":{"text":"我打了个料帐，去那街市上，不一时把那应用的按酒果品，都买将来，安排的水陆俱备。","book":"唐·白居易《轻肥》诗：“尊罍溢九酝，水陆罗八珍。”元·刘唐卿《降桑椹蔡顺奉母》第一折"},"example":{"text":"大王今日～，大宴群臣，四方异物极多，内中欠少何物，贫道愿取之。","book":"明·罗贯中《三国演义》第六十八回"},"similar":["水陆毕陈"],"usage":"作谓语、定语；形容菜肴丰富"},{"id":28150,"word":"水陆并进","pinyin":"shuǐ lù bìng jìn","abbr":"slbj","explanation":"水上陆上同时进兵。","source":{"text":"先主与吴军，水陆并进，追到南郡。","book":"《三国志·蜀志·先主传》"},"example":{"text":"因为怕清军从潜江、沔阳一带截断长江，所以也日以继夜，～，向武昌撤退。","book":"姚雪垠《李自成》第五卷第二十一章"}},{"id":28151,"word":"水陆杂陈","pinyin":"shuǐ lù zá chén","abbr":"slzc","explanation":"水陆所产的各种美味无不具备。形容菜肴丰富。","source":{"text":"明皇每年十月幸华清宫，杨国忠姐妹五家扈从。出发前会忠府第，大摆筵席，‘翟釜’红烧‘紫驼峰’，水晶盘进‘赤尾鲤’，琼浆玉液，水陆杂陈。……极尽豪奢。","book":"据唐人郑处诲的《明皇杂录》记载"},"example":{"text":"满桌～，看了不禁令人食指大动。"},"similar":["水陆毕陈"],"usage":"作谓语、定语；形容菜肴丰富"},{"id":28152,"word":"水陆毕陈","pinyin":"shuǐ lù bì chén","abbr":"slbc","explanation":"水陆：指水陆所产的珍贵食物。各种山珍海味全都陈列出来。形容菜肴丰富。","source":{"text":"尊罍溢九酝，水陆罗八珍。","book":"唐·白居易《轻肥》诗"},"example":{"text":"光禄寺排设筵宴，～，笙簧迭奏。","book":"清·陈忱《水浒后传》第四十回"},"similar":["山珍海味","水陆俱备"],"usage":"作谓语、定语；形容菜肴丰富","story":["西晋时期，荆州刺史石崇靠抢劫外地商人而积累了万贯家财，他在京城做卫尉，大肆挥霍。晋武帝的舅舅王恺想办法与石崇比富。王恺得到一株珊瑚十分得意，拿到石崇家。石崇拿出水陆毕陈的宝物送给王恺。王恺自叹不如"]},{"id":28153,"word":"水鱼之交","pinyin":"yú shuǐ zhī jiāo","abbr":"syzj","explanation":"指像鱼和水二者的关系一样。旧时指君臣之间或夫妻之间的情谊。","source":{"text":"诗有之，浩浩者水，育育者鱼，未有家室，而安召我居，宁子其欲室乎。","book":"《管子·小问》"}},{"id":28154,"word":"永不磨灭","pinyin":"yǒng bù mó miè","abbr":"ybmm","explanation":"永远不会消灭。","example":{"text":"他为中国革命建立了永不磨灭的功勋。"},"similar":["永垂不朽"],"opposite":["烟消云散","荡然无存"],"usage":"作宾语、定语；指人的功劳等"},{"id":28155,"word":"永世不忘","pinyin":"yǒng shì bù wàng","abbr":"ysbw","explanation":"永世：无穷尽的世代。终身铭记在心，永不忘怀。","source":{"text":"丹青著明世，永世不相忘。","book":"晋·阮籍《咏怀诗》"},"example":{"text":"但凌未风却舍了性命为我们尽力，此恩此德，～。","book":"梁羽生《七剑下天山》第五回"}},{"id":28156,"word":"永世其芳","pinyin":"yǒng shì qí fāng","abbr":"ysqf","explanation":"美德长存，永远流传。","source":{"text":"长春不老，永世其芳。","book":"《剪灯余话·胡媚娘传》"},"similar":["万古流芳"],"usage":"作谓语、定语；用于书面语"},{"id":28157,"word":"永世无穷","pinyin":"yǒng shì wú qióng","abbr":"yswq","explanation":"永世：永远。永远没有穷尽。","source":{"text":"作宾于王家，与国咸休，永世无穷。","book":"《尚书·微子之命》"},"similar":["永永无穷"],"usage":"作谓语、状语；指永远"},{"id":28158,"word":"永世长存","pinyin":"yǒng shì cháng cún","abbr":"yscc","explanation":"永远存在","source":{"text":"双层平台的汉白玉栏板上，精雕着万年青花饰，象征着红色的江山将永世长存。","book":"《庄严的毛主席纪念堂》"},"opposite":["昙花一现"],"usage":"作谓语、定语；用于书面语"},{"id":28159,"word":"永传不朽","pinyin":"yǒng chuán bù xiǔ","abbr":"ycbx","explanation":"传：留传；朽：腐烂，磨灭。指光辉的事迹和伟大的精神永远流传，不会磨灭。","source":{"text":"勒功天府，配祭庙庭，俾示徽章，垂美长世，茂绩远猷，永传不朽。","book":"汉·苏武《报李陵书》：“向使君服节死难，书功竹帛，传名千代，茅土之封，永在不朽。”《宋书·宗室传》"},"example":{"text":"简而易从，可以制器垂象，～。","book":"《新唐书·天文志》"},"similar":["永垂不朽","永存不朽"],"usage":"作谓语、定语；指名声、事迹等"},{"id":28160,"word":"永劫沉沦","pinyin":"yǒng jié chén lún","abbr":"yjcl","explanation":"指永远不得超生。同“永劫沉轮”。"},{"id":28161,"word":"永劫沉轮","pinyin":"yǒng jié chén lún","abbr":"yjcl","explanation":"指永远不得超生。亦作“永劫沉沦”。"},{"id":28162,"word":"永垂不朽","pinyin":"yǒng chuí bù xiǔ","abbr":"ycbx","explanation":"垂：留传后世；朽：腐烂，磨灭。指光辉的事迹和伟大的精神永远流传，不会磨灭。","source":{"text":"虽不足纲范万度，永垂不朽，且可释滞目前，釐整时务。","book":"《魏书·高祖纪下》"},"example":{"text":"小将军丹心忠义，为国捐躯，青史简篇，～，亦不辜负将军教养之功。","book":"明·许仲琳《封神演义》第七十四回"},"similar":["名垂青史","永不磨灭"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指名声、事迹等"},{"id":28163,"word":"永垂千古","pinyin":"yǒng chuí qiān gǔ","abbr":"ycqg","explanation":"垂：流传后世。永远流传于后世。","source":{"text":"他的光辉形象如同高耸入云的秦岭雄峰，气贯长虹，永垂千古。","book":"《一次难忘的航行》"},"example":{"text":"他希望自己能够～。"},"similar":["永垂不朽"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指名声、事迹等"},{"id":28164,"word":"永垂竹帛","pinyin":"yǒng chuí zhú bó","abbr":"yczb","explanation":"竹帛：竹简和绢，古时用来写字，因借指典籍。指人的姓名、事迹、功名记载于史书上，永远传于后世。"},{"id":28165,"word":"永垂青史","pinyin":"yǒng chuí qīng shǐ","abbr":"ycqs","explanation":"光辉的事迹或伟大的精神永远流传在历史上。","source":{"text":"古人日以远，青史字不泯。","book":"唐·杜甫《赠郑十八贲》"},"example":{"text":"他的光辉业绩～。"},"similar":["流芳百世"],"opposite":["遗臭万年"],"usage":"作谓语、定语；用于人的业绩"},{"id":28166,"word":"永存不朽","pinyin":"yǒng cún bù xiǔ","abbr":"ycbx","explanation":"朽：腐烂，磨灭。指光辉的事迹和伟大的精神永远流传，不会磨灭。","source":{"text":"向使君服节死难，书功竹帛，传名千代，茅土之封，永在不朽。","book":"汉·苏武《报李陵书》"},"example":{"text":"况乎三神壮观，万代鸿名，礼极殷崇，事资藻缛。玉牒玉检，式韫灵奇。传之无穷，～。","book":"《旧唐书·礼仪志》"},"similar":["永垂不朽","永传不朽"],"usage":"作谓语、定语；指名声、事迹等"},{"id":28167,"word":"永志不忘","pinyin":"yǒng zhì bù wàng","abbr":"yzbw","explanation":"永远记住，不遗忘。","source":{"text":"捻军的失败，也引起人民无尽的悲愤，他们对起义的英雄们是永志不忘的。","book":"冰心《〈儿童文学选〉序言》"},"example":{"text":"范蠡（含蓄地）：‘敬谢伍相国的忠告，这一切，我们君臣～。’","book":"曹禺等《胆剑篇》第一幕"},"usage":"作谓语、定语；用于事情等"},{"id":28168,"word":"永无宁日","pinyin":"yǒng wú níng rì","abbr":"ywnr","explanation":"永远没有安宁的日子。指动乱岁月。","source":{"text":"或者人民认为是个平平庸庸体现不出中国前途的班子，将来闹事的情形就还会很多很多，那就真正要永无宁日。","book":"邓小平《组成一个实行改革的有希望的领导集体》"},"example":{"text":"若不将这些十恶不赦的歹徒绳之以法，社会将～。"},"usage":"作谓语、宾语；用于口语"},{"id":28169,"word":"永无止境","pinyin":"yǒng wú zhǐ jìng","abbr":"ywzj","explanation":"止境：尽头。永远没有到头的时候。","source":{"text":"秦岭上还有积雪，秦岭的层岚屏障永无止境似的。","book":"茅盾《秦岭之夜》"},"example":{"text":"追求真理～。"},"similar":["学无止境","地久天长"],"opposite":["浅尝辄止"],"usage":"作谓语、宾语；指没有尽头"},{"id":28170,"word":"永永无穷","pinyin":"yǒng yǒng wú qióng","abbr":"yywq","explanation":"永永：永远。永远没有穷尽。","source":{"text":"然后祖宗之功德，施于万世，永永无穷。","book":"《汉书·景帝纪》"},"similar":["永世无穷"],"usage":"作谓语、状语；指永远"},{"id":28171,"word":"永生永世","pinyin":"yǒng shēng yǒng shì","abbr":"ysys","explanation":"永远。","example":{"text":"我～会记住你的大恩大德。"},"usage":"作状语；指永远"},{"id":28172,"word":"永矢弗谖","pinyin":"yǒng shǐ fú xuān","abbr":"ysfx","explanation":"决心永远牢记着。","source":{"text":"独寐寤言，永矢弗谖。","book":"《诗经·卫风·考盘》"},"usage":"作谓语；指永不忘记"},{"id":28173,"word":"永锡不匮","pinyin":"yǒng xī bù kuì","abbr":"yxbk","explanation":"原指孝道。后泛指永远供给，不使匮乏。形容恩遇之隆。","source":{"text":"孝子不匮，永锡其类。","book":"《诗经·大雅·既醉》"},"example":{"text":"余闻旧说，天降孔明，谁谓灵延，丧落淑贞。～，克扬其名。","book":"唐·杨炯《唐赠荆州刺史成公神道碑》"},"usage":"作谓语、定语；用于书面语"},{"id":28174,"word":"求三拜四","pinyin":"qiú sān bài sì","abbr":"qsbs","explanation":"形容到处请求人家帮忙。","source":{"text":"花了银钱不算，自己还求三拜四的谋干。","book":"清·曹雪芹《红楼梦》第一百回"},"similar":["求爷爷告奶奶"],"usage":"作谓语、定语；指求人"},{"id":28175,"word":"求之不得","pinyin":"qiú zhī bù dé","abbr":"qzbd","explanation":"想找都找不到。原指急切企求，但不能得到。后多形容迫切希望得到。","source":{"text":"求之不得，寤寐思服。","book":"《诗·周南·关雎》"},"example":{"text":"岂有此理！你老弟台肯栽培，那是～的，那里有甚委屈的话。","book":"清·吴趼人《二十年目睹之怪现状》第九十九回"},"similar":["梦寐以求"],"opposite":["举手可得"],"usage":"作谓语、定语、状语；用于迫切希望的事情","story":["很久以前在黄河边上有个采荇菜的漂亮姑娘，苗条的身材实在迷人，她引起了一个与她年龄相仿的男子的注意，顿时爱上了她，在梦中都想念她。由于两家不允许往来，就更加思念。有诗为证：“求之不得，寤寐思服，悠哉悠哉，辗转反侧。"]},{"id":28176,"word":"求之有道","pinyin":"qiú zhī yǒu dào","abbr":"qzyd","explanation":"指谋求财物应采取正当的途径，不能不择手段。","source":{"text":"求之有道，得之有命，是求无益于得也，求在外者也。","book":"《孟子·尽心上》"},"example":{"text":"太公何力，比干何罪，循性而行指，或害或利。～，得之在命。","book":"淮南子·缪称训》"}},{"id":28177,"word":"求亲告友","pinyin":"qiú qīn gào yǒu","abbr":"qqgy","explanation":"请求亲友救济。","source":{"text":"姑母不爱求亲告友，不爱向人诉苦。","book":"李纳《姑母》"},"example":{"text":"我一时周转不灵就只好～，东挪西借。"},"similar":["求亲靠友"],"usage":"作谓语；指向亲友乞求帮助"},{"id":28178,"word":"求亲靠友","pinyin":"qiú qīn kào yǒu","abbr":"qqky","explanation":"向亲友乞求帮助。","source":{"text":"或者做个小本买卖，或者置几亩地，以后再别求亲靠友的。","book":"清·曹雪芹《红楼梦》第四十二回"},"example":{"text":"～去呢，就让人家肯罢，谁家也不能存许多现的。","book":"清·文康《侠女奇缘》第三回"},"similar":["求亲告友"],"usage":"作谓语；指向亲友乞求帮助"},{"id":28179,"word":"求人不如求己","pinyin":"qiú rén bù rú qiú jǐ","abbr":"qrbrqj","explanation":"仰求别人，不如自己努力。","source":{"text":"怨人不如自怨，求诸人不如求之己。","book":"《论语·卫灵公》：“君子求诸己，小人求诸人。”《文子·上德》"},"example":{"text":"一片绿阴如洗，护竹何劳荆杞？仍将竹作笆篱，～。","book":"清·郑燮《题画·篱竹》"},"similar":["靠人不如靠己"],"usage":"作谓语、定语；用于劝诫人"},{"id":28180,"word":"求仁得仁","pinyin":"qiú rén dé rén","abbr":"qrdr","explanation":"求仁德便得到仁德。比喻理想和愿望实现。","source":{"text":"求仁而得仁，又何怨。","book":"《论语·述而》"},"example":{"text":"君所谓～，亦复何怨：老夫耄矣，不能驱役鬼神，预人家儿女事。","book":"清·纪昀《阅微草堂笔记》卷十七"},"similar":["如愿以偿"],"usage":"作谓语、宾语；指如愿以偿"},{"id":28181,"word":"求全之毁","pinyin":"qiú quán zhī huǐ","abbr":"qqzh","explanation":"毁：毁谤。一心想保全声誉，反而受到了毁谤。","source":{"text":"有不虞之誉，有求全之毁。","book":"《孟子·离娄上》"},"example":{"text":"既熟惯，便更觉亲密；既亲密，便不免有些不虞之隙，～。","book":"清·曹雪芹《红楼梦》第五回"},"usage":"作宾语、定语；指要求完美"},{"id":28182,"word":"求全责备","pinyin":"qiú quán zé bèi","abbr":"qqzb","explanation":"求、责：要求；全、备：完备，完美。对人对事物要求十全十美，毫无缺点。","source":{"text":"君子不施其亲，不使大臣怨乎不以，故旧无大故，则不弃也；无求备于一人。","book":"《论语·微子》"},"example":{"text":"于已成之局那么委曲求全，于初兴之事就这么～？","book":"鲁迅《华盖集·这个与那个》"},"similar":["吹毛求疵","洗垢求瘢"],"opposite":["人无完人","金无足赤"],"usage":"作谓语、定语；指过分要求"},{"id":28183,"word":"求其友声","pinyin":"qiú qí yǒu shēng","abbr":"qqys","explanation":"指朋友以意气相投而结交，如昆虫以同声而相应。","source":{"text":"嘤其鸣矣，求其友声。","book":"《诗经·小雅·伐木》"},"example":{"text":"言念平生，～，适我愿兮，共得朋从之道。","book":"唐·杨炯《为薛少令祭刘少监文》"},"usage":"作谓语、定语；用于书面语"},{"id":28184,"word":"求同存异","pinyin":"qiú tóng cún yì","abbr":"qtcy","explanation":"求：寻求；存：保留；异：不同的。找出共同点，保留不同意见。","source":{"text":"共同点是基本的，分歧是局部的，可以求同存异。","book":"《人民日报》1965.3.23"},"example":{"text":"在这个问题上，我们还是～吧。"},"similar":["大同小异"],"opposite":["求全责备"],"usage":"作谓语、宾语、定语；指相互沟通"},{"id":28185,"word":"求名夺利","pinyin":"qiú míng duó lì","abbr":"qmdl","explanation":"指追求名誉，争夺财利。","source":{"text":"祷告些儿，也都不是，求名求利。","book":"宋·孙惟信《水龙吟·除夕》"},"example":{"text":"～夸得意，胜似状元及第。","book":"明·沈受先《三元记·空归》"},"similar":["求名求利"],"usage":"作谓语、定语；指追求名利"},{"id":28186,"word":"求名求利","pinyin":"qiú míng qiú lì","abbr":"qmql","explanation":"追求名誉与财利。","source":{"text":"祷告些儿，也都不是，求名求利。","book":"宋·孙惟信《水龙呤·除夕》"},"example":{"text":"他喜欢～，不作无名英雄。"},"similar":["求名夺利"],"usage":"作谓语、定语；指追求名利"},{"id":28187,"word":"求名责实","pinyin":"qiú míng zé shí","abbr":"qmzs","explanation":"责：要求。按着名称或名义去寻找实际内容，使得名实相符。","source":{"text":"术者，因任而授官，循名而责实，操生杀之柄，课群臣之能者也，此人主之所执也。","book":"《韩非子·定法》"},"example":{"text":"霸王者，即当时诸侯，诸侯而称本纪，～，再三乖缪。","book":"唐·刘知己《史通·本纪》"},"similar":["循名责实"],"usage":"作谓语、宾语、定语；指要名实相符"},{"id":28188,"word":"求备一人","pinyin":"qiú bèi yī rén","abbr":"qbyr","explanation":"求：希求；备：具备，完美无缺。要求人完美无缺。形容苛求过分。","source":{"text":"尔无仇疾于顽，无求备于一夫。","book":"《尚书·君陈》"},"example":{"text":"是故五帝宪德，三王乞言，若～，同之古哲，叔世之老，孰能克堪？","book":"《魏书·尉元传》"}},{"id":28189,"word":"求大同，存小异","pinyin":"qiú dà tóng，cún xiǎo yì","abbr":"qdtcxy","explanation":"一致寻求共同之处，保留不同意见。指不因个别分歧而影响主要方面的求得一致。","example":{"text":"海峡两岸要统一必须要坚持～的原则。"},"similar":["求同存异"],"usage":"作分句、宾语；指不因个别分歧而影响"},{"id":28190,"word":"求容取媚","pinyin":"qiú róng qǔ mèi","abbr":"qrqm","explanation":"指谄媚讨好。","source":{"text":"旦夕偷幸，求容取媚，不虑远图，莫肯尽心献良计耳。","book":"《三国志·蜀志·法正传》"},"usage":"作谓语、定语；用于书面语"},{"id":28191,"word":"求志达道","pinyin":"qiú zhì dá dào","abbr":"qzdd","explanation":"指隐居以保全自己的意志，行义以贯彻自己的主张。是儒家一种理想的人生观。","source":{"text":"隐居以求其志，行义以达其道。","book":"语本《论语·季氏》"},"example":{"text":"明·李贽《世纪列传总目后论》：“自儒者出，而～之学兴矣。”"},"usage":"作谓语、定语、宾语；用于儒家思想"},{"id":28192,"word":"求忠出孝","pinyin":"qiú zhōng chū xiào","abbr":"qzcx","explanation":"指寻求忠臣必于孝子之门。","source":{"text":"夫国以简贤为务，贤以孝行为首。孔子曰：‘事亲孝故忠可移于君，是以求忠臣必于孝子之门。’","book":"语本《后汉书·韦彪传》"},"example":{"text":"南朝·梁·梁元帝《上忠臣传表》：“资父事君，实曰严敬，～，义兼臣子。”"},"usage":"作谓语、宾语；用于书面语"},{"id":28193,"word":"求新立异","pinyin":"qiú xīn lì yì","abbr":"qxly","explanation":"力求新奇异样，以示与众不同。","source":{"text":"众美人亦因炀帝留心裙带，便个个求新立异蛊惑他，博片刻之欢。","book":"清·禇人获《隋唐演义》第三十三回"},"similar":["标新立异"],"usage":"作谓语、定语；用于处事"},{"id":28194,"word":"求死不得","pinyin":"qiú sǐ bù dé","abbr":"qsbd","explanation":"形容处境险恶，痛苦之极。","source":{"text":"璞流汗惊惧，因成疮疾，遍身有疮，皆有口及舌，日夜楚痛，求死不得。","book":"宋·张君房《云笈七签》第120卷"},"example":{"text":"倘有混造黑白之人，那时妹子～，是以展转于心，未有良策。","book":"清·夏敬渠《野叟曝言》第四回"},"opposite":["求生不能"],"usage":"作谓语、定语；用于人的处境"},{"id":28195,"word":"求民病利","pinyin":"qiú mín bìng lì","abbr":"qmbl","explanation":"病：病苦，痛恨。求得了解百姓的不利和有利的事。形容对百姓的生活非常关心。","source":{"text":"尝到官，革易前敝，求民病利。","book":"《后汉书·孟尝传》"}},{"id":28196,"word":"求浆得酒","pinyin":"qiú jiāng dé jiǔ","abbr":"qjdj","explanation":"浆：饮料。比喻所得过于所求。","source":{"text":"岁在申酉，求浆得酒。","book":"唐·张鷟《朝野佥载》"},"similar":["乞浆得酒"],"usage":"作谓语、定语；指得到的超过所要求的"},{"id":28197,"word":"求爹爹告奶奶","pinyin":"qiú diē diē gào nǎi nǎi","abbr":"qddgnn","explanation":"比喻到处求人。","example":{"text":"他尝够了～的苦处。"},"similar":["求爷爷告奶奶"],"usage":"作谓语、定语；指求人"},{"id":28198,"word":"求生不得","pinyin":"qiú shēng bù dé","abbr":"qsbd","explanation":"想活活不了。形容处境十分艰难。","source":{"text":"造成了普遍于全国的灾荒和匪祸，使得广大的农民和城市贫民走上求生不得的道路。","book":"毛泽东《星星之火，可以燎原》"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“心里那份不宁帖，真有～，求死不能之感。”"},"similar":["求生不得，求死不能"],"usage":"作谓语、定语；用于人的处境"},{"id":28199,"word":"求生不得，求死不能","pinyin":"qiú shēng bù dé，qiú sǐ bù néng","abbr":"qsbdqsbn","explanation":"想死死不了，想活活不了。形容处境十分艰难。","source":{"text":"此时慕政弄得没法，求生不得，求死不能。","book":"清·李宝嘉《文明小史》第37回"},"example":{"text":"姑娘说道司空玄那老儿身上中了“生死符”，发作起来～，那是什么东西？","book":"金庸《天龙八部》第一回"},"similar":["求生不能，求死不得"],"usage":"作谓语、定语；用于人的处境"},{"id":28200,"word":"求生不生，求死不死","pinyin":"qiú shēng bù shēng，qiú sǐ bù sǐ","abbr":"qsbsqsbs","explanation":"想死死不了，想活活不了。形容处境十分艰难。","source":{"text":"予以齐人非不贪生也，畏死而反忘其生；逵非不畏死也，以理之必至于死；一可谓求生不生，一可谓求死不死。","book":"明·郎瑛《七修类稿》卷十七"},"example":{"text":"你做的勾当，我亲手捉着你奸，你倒挑拨奸夫踢了我心。至今～，你们却自去快活。","book":"明·施耐庵《水浒全传》第五回"},"similar":["求生不得，求死不能"],"usage":"作谓语、定语、状语；用于人的处境"},{"id":28201,"word":"求生不能，求死不得","pinyin":"qiú shēng bù néng，qiú sǐ bù dé","abbr":"qsbnqsbd","explanation":"想死死不了，想活活不了。形容处境十分艰难。","source":{"text":"求生不能，求死不得地活受罪一年多了，她挣扎着。","book":"《上饶集中营·炼狱杂忆》"},"example":{"text":"《上饶集中营·炼狱杂忆》：“～地活受罪一年多了，她挣扎着。”"},"similar":["求生不生，求死不死"],"usage":"作谓语、定语、状语；用于人的处境"},{"id":28202,"word":"求生害义","pinyin":"qiú shēng hài yì","abbr":"qshy","explanation":"为保全性命而伤害道义。","source":{"text":"故其民有见危以授命，而不求生以害义，又况可奋臂大呼，聚之以干纪作乱乎。","book":"《晋书·孝愍帝纪》"},"similar":["求生害仁"],"usage":"作谓语、定语；用于处世"},{"id":28203,"word":"求生害仁","pinyin":"qiú shēng hài rén","abbr":"qshr","explanation":"指因谋求活命而有伤仁德。","source":{"text":"志士仁人，无求生以害仁，有杀身以成仁。","book":"春秋·鲁·孔丘《论语·卫灵公》"},"example":{"text":"如式，不能去，又不能死，可谓～者乎？","book":"《新唐书·房式传》"},"similar":["求生害义"],"opposite":["杀身成仁"],"usage":"作谓语、定语；用于处世"},{"id":28204,"word":"求田问舍","pinyin":"qiú tián wèn shě","abbr":"qtws","explanation":"舍：房子。多方购买田地，到处问询屋介。指只知道置产业，谋求个人私利。比喻没有远大的志向。","source":{"text":"君有国士之名，今天下大乱，帝主失所，望君忧国忘家，有救世之意，而君求田问舍，言无可采，是元龙所讳也，何缘当与君语。","book":"《三国志·魏书·陈登传》"},"example":{"text":"如今这些贪人，拥着娇妻美妾，～，损人肥己，搬斤播两，何等肚肠。","book":"明·凌濛初《初刻拍案惊奇》卷十八"},"usage":"作谓语、宾语；指没有大志","story":["东汉末年，广陵太守陈登见胸无大志的好友许汜来拜访，问他有什么时期。许汜说只想谋求田地，购置房产，陈登只是简单招待他，让他睡下床。几年后，许汜在荆州牧刘表手下任职，同刘备谈起此事，刘备说：“要是我就会让你睡地上。”"]},{"id":28205,"word":"求益反损","pinyin":"qiú yì fǎn sǔn","abbr":"qyfs","explanation":"为图好处，反招损害。","source":{"text":"以方心偶俗之累，求益反损，盖孔子所以忧心，孟轲所以惆怅也。","book":"汉·王充《论衡·累害篇第二》"},"example":{"text":"不然，有风雷洞、鬼神洞、地狱洞、龙蛇洞，误入其中，害及性命，～，深可戒也。","book":"宋·张君房《云笈七签》卷一百十二"},"usage":"作宾语、定语；用于处事"},{"id":28206,"word":"求知心切","pinyin":"qiú zhī xīn qiè","abbr":"qzxq","explanation":"追求知识，心情十分迫切。","example":{"text":"～去黄埔，夜梦依依我不然。","book":"彭德怀《跃上井冈旗帜新》诗"}},{"id":28207,"word":"求知若渴","pinyin":"qiú zhī ruò kě","abbr":"qzrk","explanation":"知：知识。探求知识像口渴想喝水一样迫切。形容求知愿望十分迫切。","example":{"text":"也许根本不具有艺术的什么不朽性，但当年感动过激动过多少～的中国人啊！","book":"梁晓声《狡猾是一种冒险》第四章"}},{"id":28208,"word":"求神拜佛","pinyin":"qiú shén bài fó","abbr":"qsbf","explanation":"礼拜神仙，请求保佑。","source":{"text":"有一富民姓严，夫妻两口儿过活，三十岁上无子，求神拜佛，无时无处不将此事挂在念头上。","book":"明·凌濛初《初刻拍案惊奇》第13卷"},"example":{"text":"当他妈妈生病的时候，他去～。","book":"周恩来《学习毛泽东》"},"similar":["烧香许愿"],"usage":"作谓语、宾语、定语；指迷信"},{"id":28209,"word":"求神问卜","pinyin":"qiú shén wèn bǔ","abbr":"qswb","explanation":"迷信的人遇有疑难，求神鬼帮助，或靠卜卦解决。","source":{"text":"人事不省，十分危笃。吃的药犹如泼在石上，一毫没用。求神问卜，俱说无效。","book":"明·冯梦龙《醒世恒言·乔太守乱点鸳鸯谱》"},"example":{"text":"我与你～，且自宽心，将息守己。（明·胡文焕《群音类选·南西厢记·莺莺探病》）"},"similar":["求签问卜"],"usage":"作谓语、定语；指人迷信"},{"id":28210,"word":"求福禳灾","pinyin":"qiú fú ráng zāi","abbr":"qfrz","explanation":"禳：祈祷消灾。祈求福运降临，灾害消除。","source":{"text":"若夫神君之类精神之异，非求请所能致也，又非可以求福而禳灾矣。","book":"汉·荀悦《汉纪·武帝纪四》"},"usage":"作谓语；用于书面语"},{"id":28211,"word":"求端讯末","pinyin":"qiú duān xùn mò","abbr":"qdxm","explanation":"求寻求；讯：询问；端：开始；末：结果。寻求事情的起源，询问事情的结果。形容办事态度十分严肃认真。","source":{"text":"人之好怪也，不求其端，不讯其末，惟怪之欲闻。","book":"唐·韩愈《原道》"}},{"id":28212,"word":"求签问卜","pinyin":"qiú qiān wèn bǔ","abbr":"qqwb","explanation":"卜：占卜。祈求于神灵，求决于占卜。","source":{"text":"又常闻得官府要拿他家属，又不知生死存亡，求签问卜，越望越不回来，忧出一场大病，卧在床上，起身不动。","book":"清·褚人获《隋唐演义》第十回"},"example":{"text":"他郎舅二人因失女之后合家愁闷，～，四路寻访，终无影响，已无计可施。","book":"清·陈朗《雪月梅》第十一回"},"similar":["求神问卜"],"usage":"作谓语、定语、宾语；指人迷信"},{"id":28213,"word":"求索无厌","pinyin":"qiú suǒ wú yàn","abbr":"qswy","explanation":"求：追求；索：搜索；厌：满足。形容贪欲没有满足的时候。","source":{"text":"征敛无期，求索无厌。","book":"《吕氏春秋·怀宠》"},"example":{"text":"富家子弟騃懦不可用，守戍岁时～，家产随坏。","book":"《金史·魏子平传》"}},{"id":28214,"word":"求荣卖国","pinyin":"qiú róng mài guó","abbr":"qrmg","explanation":"荣：荣华富贵。出卖国家的权益，谋求个人的名利权势。","source":{"text":"康王用的俱是奸臣，求荣卖国之辈，如何保守得江山？","book":"清·钱彩《说岳全传》第26回"},"similar":["卖国求荣","卖国求利"],"opposite":["赤心报国"],"usage":"作谓语、定语；指人谋求个人的名利"},{"id":28215,"word":"求荣反辱","pinyin":"qiú róng fǎn rǔ","abbr":"qrfr","explanation":"比喻追求荣誉反而受到污辱。","source":{"text":"这样的人到了堂子里头这样的地方，那就真是求荣反辱、自寻苦吃了。","book":"清·张春帆《九尾龟》第一百五十九回"},"example":{"text":"电奏一到，瞿鸿玑力主严办，周荣曜～，做了未出国门的几天公使，反落得个倾家荡产的结局。","book":"高阳《慈禧全传》九十六"}},{"id":28216,"word":"求贤下士","pinyin":"qiú xián xià shì","abbr":"qxxs","explanation":"访求贤士且礼遇之。","source":{"text":"兄弟，俺求贤用士哩，你依着师父出去。","book":"元·白朴《博望烧屯》第二折"},"example":{"text":"乞陛下特恩，赐以冠带，更使一朝臣往宣，乃见圣主～之至意。","book":"清·褚人获《隋唐演义》第八十二回"},"similar":["求贤用士"],"usage":"作谓语、定语、宾语；用于处世"},{"id":28217,"word":"求贤如渴","pinyin":"qiú xián rú kě","abbr":"qxrk","explanation":"象口渴思饮那样访求贤士。形容罗致人才的迫切。","source":{"text":"昔在前世，求贤如渴。","book":"南朝·宋·范晔《后汉书·周举传》"},"example":{"text":"贞观之初，～。","book":"唐·魏征《十渐不克终疏》"},"similar":["求贤若渴"],"usage":"作谓语、定语；指爱惜人才"},{"id":28218,"word":"求贤用士","pinyin":"qiú xián yòng shì","abbr":"qxys","explanation":"招求贤良，聘用士人。","source":{"text":"兄弟，俺求贤用士哩，你依着师父出去。","book":"元·白朴《博望烧屯》第二折"},"similar":["求贤下士"],"usage":"作谓语、定语、宾语；用于处世"},{"id":28219,"word":"求贤若渴","pinyin":"qiú xián ruò kě","abbr":"qxrk","explanation":"象口渴思饮那样访求贤士。形容罗致人才的迫切。","source":{"text":"昔在前世，求贤如渴。","book":"《后汉书·周举传》"},"example":{"text":"～，从柬如流。","book":"《宋史·窦贞固传》"},"similar":["求贤如渴","爱才如命"],"opposite":["嫉贤妒能"],"usage":"作谓语、定语；指爱惜人才","story":["战国时期，晋献公用碧玉骏马向虞国行贿借道灭掉虢国与虞国，俘虏虞国大夫百里奚，晋献公将百里奚作为奴隶陪嫁到楚国，秦穆公释放用五张羊皮换取百里奚并与他共商国事。百里奚向他推荐蹇叔，秦穆公重金迎接蹇叔，并封他为上大夫"]},{"id":28220,"word":"求过于供","pinyin":"qiú guò yú gòng","abbr":"qgyg","explanation":"需求多而供应量少。","example":{"text":"印刷用纸若是～，便会影响出版品的及时问世。"},"similar":["供不应求"],"opposite":["供过于求"],"usage":"作谓语、定语；用于人或商品"},{"id":28221,"word":"求道于盲","pinyin":"qiú dào yú máng","abbr":"qdym","explanation":"盲：盲人。向盲人问路。比喻向毫无所知的人请教。","source":{"text":"足下求速化之术，不于其人，乃以访愈，是所谓借听于聋，求道于盲。","book":"唐·韩愈《答陈生书》"},"similar":["问道于盲"],"usage":"作宾语、定语；用于处事"},{"id":28222,"word":"求马于唐市","pinyin":"qiú mǎ yú táng shì","abbr":"qmyts","explanation":"到空无所有的市集去买马。比喻求非所求，必无所获。同“求马于唐肆”。","source":{"text":"（达吐，）西域术语，或神秘之名，即查泰西字书，不啻求马于唐市。","book":"苏曼殊《与刘半农书》"},"similar":["求马于唐肆"],"usage":"作谓语、定语；形容白费功夫"},{"id":28223,"word":"求马于唐肆","pinyin":"qiú mǎ yú táng sì","abbr":"qmyts","explanation":"到空无所有的市集去买马。比喻求非所求，必无所获。","source":{"text":"唐肆，非停马处也。","book":"庄周《庄子·田子方》：“彼已尽矣，而女求之以为有，是求马于唐肆也。”郭象注"},"example":{"text":"（达吐，）西域术语，或神秘之名，即查泰西字书，不啻～。","book":"苏曼殊《与刘半农书》"},"similar":["求马唐肆","缘木求鱼","求马于唐市"],"usage":"作谓语、定语；形容白费功夫"},{"id":28224,"word":"求马唐肆","pinyin":"qiú mǎ táng sì","abbr":"qmts","explanation":"唐：原指无壁之屋，引伸为空的；肆：铺子，这里指卖马的地方。到不是停马处去找马。比喻在什么也没有的地方寻求自己所需的东西。","source":{"text":"彼已尽矣，而女求之以为有，是求马于唐肆也。","book":"《庄子·田子方》"},"similar":["缘木求鱼"],"usage":"作宾语、定语；指方法不对"},{"id":28225,"word":"汉人煮箦","pinyin":"hàn rén zhǔ zé","abbr":"hrzz","explanation":"汉：汉中地区；箦：席子。汉中有个人将自家的竹席子当作竹笋煮着吃。比喻仅靠肤浅的知识去生搬硬套而不认真学习真知的荒唐行为。","source":{"text":"汉人有适吴，吴人设笋，问是何物，语曰：‘竹也。’归，煮其床箦而不熟。","book":"三国·魏·邯郸淳《笑林》"}},{"id":28226,"word":"汉官威仪","pinyin":"hàn guān wēi yí","abbr":"hgwy","explanation":"原指汉朝官吏的服饰制度。后常指汉族的统治制度。","source":{"text":"老吏或垂涕曰：‘不图今日复见汉官威仪。’","book":"《后汉书·光武帝纪上》"},"example":{"text":"惟兹梨园子弟，犹存～。","book":"陈去病《论戏剧之有益》"},"usage":"作宾语；泛指正统的皇家礼制"},{"id":28227,"word":"汉武托孤","pinyin":"hàn wǔ tuō gū","abbr":"hwtg","explanation":"汉武：汉武帝；孤：遗孤。汉武帝把8岁的儿子托霍光辅佐。","example":{"text":"～的故事就这样得以流传。"},"usage":"作宾语、定语；用于交往","story":["汉武帝时期，霍去病大将军的弟弟霍光被汉武帝任命为光禄大夫，侍奉汉武帝20多年。汉武帝年事已高，几个儿子争夺帝位而发生变故。汉武帝决定立8岁的小儿子为皇帝，拜托霍光辅佐小皇帝。霍光尽心尽责，直到去世"]},{"id":28228,"word":"汉皋解珮","pinyin":"hàn gāo jiè pèi","abbr":"hgjp","explanation":"汉皋：山名，在今湖北襄阳县西北；珮：玉珮。相传周郑交甫于汉皋台下遇二女，解珮相赠。后多指男女的爱慕赠答。","source":{"text":"心摇汉皋珮，泪堕岘亭碑。","book":"唐·白居易《代书诗一百韵寄微之》诗"},"example":{"text":"此皆妾辈。其末后着藕白者，所谓“～”，即其人也。","book":"清·蒲松龄《聊斋志异·竹青》"},"similar":["汉皋解佩"],"usage":"作宾语、定语；用于男女之间"},{"id":28229,"word":"汉贼不两立","pinyin":"hàn zéi bù liǎng lì","abbr":"hzbll","explanation":"比喻有我无你。","source":{"text":"先帝虑汉贼不两立，王业不偏安。","book":"三国·蜀·诸葛亮《后出师表》"},"example":{"text":"惟有杜氏一个，直如添上敌国一般，心中竟安排下“～”的主意。","book":"清·李绿园《歧路灯》第六十七回"},"similar":["势不两立"],"usage":"作宾语、定语；比喻有我无你"},{"id":28230,"word":"汗下如流","pinyin":"hàn xià rú liú","abbr":"hxrl","explanation":"汗水像小溪一样往下淌。形容极其羞愧的心情。也形容汗水出得特别多。","source":{"text":"腼颜于其间，汗下如流浆。","book":"宋·苏舜钦《舟中感怀寄馆中诸君》"}},{"id":28231,"word":"汗不敢出","pinyin":"hàn bù gǎn chū","abbr":"hbgc","explanation":"吓得连汗都不敢往外冒了。形容紧张害怕到了极点。","source":{"text":"战战栗栗，汗不敢出。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"在中国，从道士听说道，从批评家听谈文，都令人毛孔痉挛，～。","book":"鲁迅《文学与出汗》"},"usage":"作状语；形容紧张害怕到了极点","story":["钟繇的两个儿子钟毓、钟会少年时就有名气，魏文帝听说后就下令接见。文帝见钟毓脸上有汗问为什么？钟毓回答：“战战惶惶，汗出如浆。”文帝问钟会为什么不出汗，钟会回答道：“战战栗栗，汗不敢出。”","文帝深为喜爱"]},{"id":28232,"word":"汗出如渖","pinyin":"hàn chū rú shěn","abbr":"hcrs","explanation":"渖：汁液。满身汗水。形容天气炎热或心情极度紧张而导致浑身冒汗的现象。"},{"id":28233,"word":"汗出沾背","pinyin":"hàn chū zhān bèi","abbr":"hczb","explanation":"沾：浸湿。汗水沾湿了脊背。形容天气炎热或人极度惊慌或惭愧。","source":{"text":"朝而问右丞相勃曰：‘天下一岁钱谷出入几何？’勃又谢不知，汗出沾背，愧不能对。","book":"西汉·司马迁《史记·陈丞相世家》"},"similar":["汗出浃背","汗出洽背"],"usage":"作谓语、状语；用于人的状态","story":["西汉时期，孝文皇帝经常关心国家大事和人民的生计问题，他在朝上问右丞相周勃说：“国家一年的刑事案件判定了多少件？”周勃如实回答不知。皇帝又问周勃：“国家一年的钱谷开支多少？”周勃又说不知，惊恐得汗出沾背，惭愧不能应对"]},{"id":28234,"word":"汗出洽背","pinyin":"hàn chū qià bèi","abbr":"hcqb","explanation":"形容非常恐惧或非常害怕。同“汗流浃背”。","source":{"text":"[周勃]汗出洽背，愧不能对。","book":"《汉书·王陵传》"},"similar":["汗出浃背"],"usage":"作谓语、状语；用于人的状态"},{"id":28235,"word":"汗出浃背","pinyin":"hàn chū jiā bèi","abbr":"hcjb","explanation":"形容非常恐惧或非常害怕。现也形容出汗很多，背上的衣服都湿透了。同“汗流浃背”。","source":{"text":"敞惊惧不知所言，汗出浃背。","book":"汉·刘向《续列女传·杨夫人》"},"example":{"text":"风力虽尚劲，然徒步则～。","book":"明·袁宏道《满井游记》"},"similar":["汗出洽背","汗出沾背"],"usage":"作谓语、状语；用于人的状态"},{"id":28236,"word":"汗如雨下","pinyin":"hàn rú yǔ xià","abbr":"hryx","explanation":"汗珠象下雨似的往下掉。形容出汗很多。","source":{"text":"三冬汗如雨。","book":"宋·释普济《五灯会元》卷四十七"},"example":{"text":"不防一块石头绊了一跤，犹如梦醒一般，浑身～。","book":"清·曹雪芹《红楼梦》第一○一回"},"similar":["挥汗如雨"],"usage":"作谓语、状语；形容出汗很多"},{"id":28237,"word":"汗洽股栗","pinyin":"hàn qià gǔ lì","abbr":"hqgl","explanation":"汗流浃背，两腿颤抖。形容害怕、恐惧的样子。","source":{"text":"虽单于不觉自失，况余子有不汗洽股栗者？","book":"宋·陆游《跋韩立道所藏兰亭序》"},"usage":"作谓语、定语；用于恐惧时"},{"id":28238,"word":"汗流夹背","pinyin":"hàn liú jiā bèi","abbr":"hljb","explanation":"浃：湿透。汗水流得满背都是。形容非常恐惧或惭愧","source":{"text":"陪臣汗流夹背，出谓人曰：‘此诚宰相语。’","book":"清·昭梿《啸亭杂录·阿文成相度》"},"similar":["汗流浃肤","汗流浃背","汗流洽背"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28239,"word":"汗流接踵","pinyin":"hàn liú jiē zhǒng","abbr":"hljz","explanation":"汗出得多，流到脚跟。常形容极端恐惧或惭愧。","source":{"text":"柳在椟中，历历闻之，汗流接踵，不敢出气。","book":"清·蒲松龄《聊斋志异·柳氏子》"},"similar":["汗流至踵","汗流浃踵"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28240,"word":"汗流洽背","pinyin":"hàn liú qià bèi","abbr":"hlqb","explanation":"汗流得满背都是。形容非常恐惧或非常害怕。现也形容出汗很多，背上的衣服都湿透了。同“汗流浃背”。","source":{"text":"昭宗临轩自谕之曰：‘卿等藩侯，宜存臣节，称兵入朝，不由奏请，意在何也？’茂贞、行瑜汗流洽背，不能对。","book":"《旧唐书·昭宗纪》"},"example":{"text":"左右悉闻齐氏哀诉之声，惊起来视，即齐氏～，精神恍然。","book":"宋·无名氏《异闻总录》卷三"},"similar":["汗流浃背","汗流夹背"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28241,"word":"汗流洽衣","pinyin":"hàn liú qià yī","abbr":"hlqy","explanation":"汗出甚多，湿透衣服。形容极其惶恐羞愧。","source":{"text":"顷贤郎至，辱华翰奖借，烂然盈楮，不匡其所不及，而假其所不能。读之使人汗流洽衣也。","book":"明·张居正《答宗伯董浔阳》"},"similar":["汗流洽背","汗流浃背"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28242,"word":"汗流浃体","pinyin":"hàn liú jiā tǐ","abbr":"hljt","explanation":"汗流全身。形容极度惊惧。","source":{"text":"张焘误食厌物，谢既再拜而悟，汗流浃体。","book":"宋·张师正《括异志·张龙图》"},"example":{"text":"梦觉，～。","book":"宋·王巩《随手杂录》"},"similar":["汗流浃肤"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28243,"word":"汗流浃肤","pinyin":"hàn liú jiā fū","abbr":"hljf","explanation":"形容极度惊惧。同“汗流浃体”。","source":{"text":"[深父]梦若至诸天阁下……有人挤之，坠潭中，蹶然而寤，汗流浃肤。","book":"宋·洪迈《夷坚乙志·青童神君》"},"similar":["汗流浃体"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28244,"word":"汗流浃背","pinyin":"hàn liú jiā bèi","abbr":"hljb","explanation":"形容非常恐惧或非常害怕。同“汗流浃背”。","source":{"text":"陪臣汗流夹背，出谓人曰：‘此诚宰相语。’","book":"清·昭槤《啸亭杂录·阿文成相度》"},"example":{"text":"鲁迅《坟·再论雷峰塔的倒掉》：“但我们一翻历史，怕不免有～的时候罢。”"},"similar":["挥汗如雨","汗如雨下"],"opposite":["冰天雪地","滴水成冰"],"usage":"作谓语、定语、状语；指满身大汗","story":["汉武帝的托孤重臣霍光对皇帝刘贺寻欢作乐不理朝政忧心忡忡，他与张安世、田延年密议要废掉刘贺，得让丞相杨敞提出。杨敞听说后吓得汗流浃背，不置可否。他的妻子是司马迁的女儿代他决定同意。第二天他们奏请太后另立刘洵为帝"]},{"id":28245,"word":"汗流浃踵","pinyin":"hàn liú jiā zhǒng","abbr":"hljz","explanation":"汗出得多，流到脚跟。常形容极端恐惧或惭愧。","source":{"text":"汗出得多，流到脚跟。常形容极端恐惧或惭愧。"},"similar":["汗流接踵","汗流至踵"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28246,"word":"汗流满面","pinyin":"hàn liú mǎn miàn","abbr":"hlmm","explanation":"形容极度紧张或非常劳累。","source":{"text":"况且她又这样地终日汗流满面，短发都粘在脑额上；两只手又只是这样地粗糙起来。","book":"鲁迅《彷徨·伤逝》"},"example":{"text":"工人们累得～。"},"similar":["汗流浃背"],"usage":"作谓语、状语；指非常劳累"},{"id":28247,"word":"汗流至踵","pinyin":"hàn liú zhì zhǒng","abbr":"hlzz","explanation":"汗出得多，流到脚跟。常形容极端恐惧或惭愧。","source":{"text":"御寇伏地，汗流至踵。","book":"《庄子·田子方》"},"similar":["汗流浃踵","汗流接踵"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28248,"word":"汗牛充屋","pinyin":"hàn niú chōng wū","abbr":"hncw","explanation":"形容藏书非常多。同“汗牛充栋”。","source":{"text":"非要非玄，而冗长并录，是《书》不止百篇，《诗》不止三百。非惟汗牛充屋，不能尽载，且适以罔道迷人。","book":"清·方东树《〈切问斋文抄〉书后》"},"similar":["汗牛塞栋","汗牛充栋","汗牛塞屋"],"usage":"作谓语、补语；形容藏书非常多"},{"id":28249,"word":"汗牛充栋","pinyin":"hàn niú chōng dòng","abbr":"hncd","explanation":"栋：栋宇，屋子。书运输时牛累得出汗，存放时可堆至屋顶。形容藏书非常多。","source":{"text":"其为书，处则充栋宇，出则汗牛马。","book":"唐·柳宗元《陆文通墓表》"},"example":{"text":"世传养生术，～，行而效者谁也？","book":"清·蒲松龄《聊斋志异·封三娘》"},"similar":["左图右史","不计其数","浩如烟海"],"opposite":["寥寥无几","屈指可数","寥若晨星"],"usage":"作谓语、补语；形容藏书非常多","story":["唐代学者陆质对孔子的《春秋》特别有研究，著书《春秋集注》、《春秋辨疑》、《春秋微旨》，对《春秋》有独到研究，柳宗元对他的治学严谨深表敬佩，他在陆质死后为《文通先生陆给事墓表》：“其为书，处则充栋宇，出则汗牛马。”"]},{"id":28250,"word":"汗牛塞屋","pinyin":"hàn niú sè wū","abbr":"hnsw","explanation":"书运输时牛累得出汗，存放时可放满整个屋子。形容藏书非常多。","source":{"text":"其为书，处则充栋宇，出则汗牛马。","book":"唐·柳宗元《陆文通先生墓表》"},"example":{"text":"～，富贵家之书，然富贵者读书者有几？","book":"清·袁枚《黄生借书说》"},"similar":["汗牛塞栋","汗牛充栋","汗牛充屋"],"usage":"作谓语、补语、定语；形容藏书非常多"},{"id":28251,"word":"汗牛塞栋","pinyin":"hàn niú sāi dòng","abbr":"hnsd","explanation":"形容藏书非常多。同“汗牛充栋”。","source":{"text":"余不自揆，尝取《左氏》、历代诸史及诸大家文字所谓汗牛塞栋者，稍删次之以从简约。","book":"明·唐顺之《胡贸棺记》"},"similar":["汗牛充屋","汗牛充栋","汗牛塞屋"],"usage":"作谓语、补语、定语；形容藏书非常多"},{"id":28252,"word":"汗血盐车","pinyin":"hàn xuè yán chē","abbr":"hxyc","explanation":"骏马拉运盐的车子。“汗血”，骏马。后以之比喻人才埋没受屈。","source":{"text":"夫骥之齿至矣，服盐车而上太行，蹄申膝折，尾湛胕溃，漉汁洒地，白汗交流，中阪迁延，负辕不能上。","book":"“汗血马”，在我国又称天马、大宛马，语出《史记·大宛列传》；“盐车”，语出《战国策·楚策四》"},"example":{"text":"～无人顾，千里空收骏骨。","book":"宋·辛弃疾《贺新郞·同父见和再用前韵答之》词"},"usage":"作宾语、定语；用于比喻句"},{"id":28253,"word":"汗青头白","pinyin":"hàn qīng tóu bái","abbr":"hqtb","explanation":"指书写成，人也老了。","source":{"text":"每欲记一事载一言，皆阁笔相视，含毫不断。故头白可期，而汗青无日。","book":"语出唐·刘知几《史通·忤时》"},"example":{"text":"庶人有定守，事易考成，在各官可免～之讥，而臣等亦得以逭旷职素飧之咎矣。","book":"明·张居正《纂修事宜疏》"},"usage":"作定语；用于文人等"},{"id":28254,"word":"汗颜无地","pinyin":"hàn yán wú dì","abbr":"hywd","explanation":"汗颜：脸上出汗。形容极其羞愧，无地自容。","source":{"text":"服章岂不好，不与德相对，顾影听其声，赪颜汁渐背。","book":"唐·韩愈《朝归》诗"},"example":{"text":"这在我们做中国人的说来虽觉～，但却是事实。","book":"邹韬奋《经历·新闻检查》"},"similar":["无地自容"],"opposite":["恬不知耻"],"usage":"作谓语、宾语；形容极其羞愧，无地自容"},{"id":28255,"word":"汗马之功","pinyin":"hàn mǎ zhī gōng","abbr":"hmzg","explanation":"指战争中立下的功绩。","source":{"text":"遂良出自草茅，无汗马之功，蒙先帝殊遇，以有今日。","book":"宋·王谠《唐语林·补遗一》"},"example":{"text":"倘效玄宗幸金牛之道，岂无诸将立～。","book":"清·孙枝蔚《甲申述忧》诗序"},"similar":["汗马之劳"],"usage":"作宾语；指功劳大"},{"id":28256,"word":"汗马之劳","pinyin":"hàn mǎ zhī láo","abbr":"hmzl","explanation":"①指征战的劳苦。亦指战功。②指用马运输的劳累。","source":{"text":"弃私家之事而必汗马之劳，家困而上弗论，则穷矣。","book":"《韩非子·五蠹》"},"example":{"text":"舫船载卒，一舫载五十人，与三月之粮，下水而浮，一日行三百馀里；里数虽多，不费～。","book":"《战国策·楚策一》"},"similar":["汗马之功"],"usage":"作宾语；指功劳大"},{"id":28257,"word":"汗马功劳","pinyin":"hàn mǎ gōng láo","abbr":"hmgl","explanation":"汗马：将士骑的马奔驰出汗，比喻征战劳苦。指在战场上建立战功。现指辛勤工作做出的贡献。","source":{"text":"弃私家之事，而必汗马之劳。","book":"《韩非子·五蠹》"},"example":{"text":"将俺丞相～一旦忘了，贬在济南府闲住。","book":"元·王实甫《丽堂春》第四折"},"similar":["丰功伟绩","劳苦功高"],"opposite":["一事无成"],"usage":"作宾语；形容战功","story":["西汉初期，萧何跟随刘邦打天下，出谋划策，刘邦当了皇帝后就让萧何做丞相，其他武将不服，刘邦说：“打猎的时候，追逐野兽的狗，而指明野兽方向的是人，你们只是有功劳的狗，而萧何则是这个猎人。”"]},{"id":28258,"word":"汗马功绩","pinyin":"hàn mǎ gōng jì","abbr":"hmgj","explanation":"汗马：战马奔驰出汗。指在战场上建立战功。现指对事业的辛勤贡献。","source":{"text":"感皇恩宠锡无穷，端不负汗马功绩。","book":"明·无名氏《精忠记·闻讣》"},"similar":["汗马功劳","汗马勋劳"],"usage":"作宾语；形容战功"},{"id":28259,"word":"汗马勋劳","pinyin":"hàn mǎ xūn láo","abbr":"hmxl","explanation":"汗马：战马奔驰出汗。指在战场上建立战功。现指对事业的辛勤贡献。","source":{"text":"和衷共济祈公等戮力同心敌北兵，方能够汗马勋劳报圣明。","book":"清·吴梅《凤洞山》"},"similar":["汗马功劳","汗马功绩"],"usage":"作宾语；形容战功"},{"id":28260,"word":"汝南晨鸡","pinyin":"rǔ nán chén jī","abbr":"rncj","explanation":"即汝南鸡。"},{"id":28261,"word":"汝南月旦","pinyin":"rǔ nán yuè dàn","abbr":"rnyd","explanation":"月旦：月朔，每月初一。指品评人物。","source":{"text":"初，劭与靖俱有高名，好共核认乡党人物，每月辄更其品题，故汝南俗有月旦评焉。","book":"《后汉书·许劭传》"},"similar":["月旦春秋"],"usage":"作谓语、宾语；指评论"},{"id":28262,"word":"汝成人耶","pinyin":"rǔ chéng rén yé","abbr":"rcry","explanation":"你当真还算是个人吗？"},{"id":28263,"word":"江东父老","pinyin":"jiāng dōng fù lǎo","abbr":"jdfl","explanation":"江东：古指长江以南芜湖以下地区；父老：父兄辈人。泛指家乡的父兄长辈。","source":{"text":"项王笑曰：‘籍与江东子弟八千人，渡江而西，今无一人还，纵江东父兄怜而王我，和何面目见之？’","book":"《史记·项羽本纪》"},"example":{"text":"待回归，有何颜见得～兄妹。","book":"明·胡文焕《跃鲤记·芦林相会》"},"similar":["家乡父老"],"usage":"作宾语；用于有愧时","story":["楚汉相争时期，项羽率领8000江东子弟组成的部队攻打秦军，他们越战越勇，势力也越来越大。由于项羽刚愎自用，听不进部下的意见，一意孤行，被刘邦的汉军围困在垓下乌江边，江东子弟死伤无数，项羽感觉没脸见江东父老就拔剑自刎"]},{"id":28264,"word":"江东独步","pinyin":"jiāng dōng dú bù","abbr":"jddb","explanation":"江东：古指长江以南芜湖以下地区。泛指人才俊美，在一定范围内独占鳌头。","source":{"text":"坦之字文度，弱冠与郗超俱有重名，时人为之语曰：‘盛德绝论郗嘉宾，江东独步王文度。’","book":"《晋书·王坦之传》"},"usage":"作谓语、定语；指杰出人才"},{"id":28265,"word":"江云渭树","pinyin":"jiāng yún wèi shù","abbr":"jyws","explanation":"比喻深厚的离情别意。","source":{"text":"渭北春天树，江东日暮云。何时一樽酒，重与细论文。","book":"语出唐·杜甫《春日忆李白》诗"},"example":{"text":"依然辽绝千山万水一方，使我～空怀仰。","book":"《群音类选·清腔类·念奴娇》"},"usage":"作宾语、定语；用于书面语"},{"id":28266,"word":"江南海北","pinyin":"jiāng nán hǎi běi","abbr":"jnhb","explanation":"大江之南，大海之北。形容地域广阔，","source":{"text":"书传所载也，江南海北有万里之限，辽东君臣，无怵惕之患。","book":"魏·明帝《赦辽东吏民公文》"},"similar":["天南海北"],"usage":"作主语、宾语、定语；用于口语"},{"id":28267,"word":"江天一色","pinyin":"jiāng tiān yī sè","abbr":"jtys","explanation":"形容江面宽阔，水天相接。","source":{"text":"江天一色无纤尘，皎皎空中孤月轮。","book":"唐·张若虚《春江花月夜》"},"example":{"text":"明·冯梦龙《警世通言》第11卷：“见山水相衔，～。”"},"usage":"作谓语；形容江水辽阔，水天相接"},{"id":28268,"word":"江山不老","pinyin":"jiāng shān bù lǎo","abbr":"jsbl","explanation":"指高山大河千古长存，永不衰老。祝人长寿之语。","source":{"text":"今来古往，物是人非，天地里，唯有江山不老。","book":"宋·林外《洞仙歌》词"},"example":{"text":"按今婴饰间多镂～，日月同年等字为祝辞。","book":"清·翟灏《通俗编·祝诵》"},"usage":"作谓语、宾语；用于比喻句"},{"id":28269,"word":"江山之助","pinyin":"jiāng shān zhī zhù","abbr":"jszz","explanation":"江山：山水风景；助：帮助。自然景色的帮助。形容清雅、拔俗的诗文、绘画都借助于自然山水的熏陶感染。","source":{"text":"然屈平所以能洞监《风》《骚》之情者，抑亦江山之助乎。","book":"南朝·梁·刘勰《文心雕龙·物色》"},"example":{"text":"动笔形似，画外有情，足使先辈名流，动容变色。但地处平原，阙～。","book":"唐·张彦远《历代名画记·董伯仁》"}},{"id":28270,"word":"江山之异","pinyin":"jiāng shān zhī yì","abbr":"jszy","explanation":"江山：指疆土。指疆土易主。","source":{"text":"风景不殊，举目有江山之异。","book":"《晋书·王导传》"},"usage":"作宾语；用于丧国"},{"id":28271,"word":"江山之恨","pinyin":"jiāng shān zhī hèn","abbr":"jszh","explanation":"江山：指疆土。指失去疆土的仇恨。","source":{"text":"万里烟波，举目有江山之恨。","book":"唐·陈熙晋《骆侍御传》"},"usage":"作宾语；用于丧国"},{"id":28272,"word":"江山半壁","pinyin":"jiāng shān bàn bì","abbr":"jsbb","explanation":"江山：比喻国家疆土；半壁：半边。指在敌人入侵后残存或丧失的部分国土。","source":{"text":"清·蒋士诠《冬青树·提纲》：“半壁江山，比五季朝廷尤小。”江山不老"},"example":{"text":"面对这～，胸中有无限感慨"},"similar":["半壁江山"],"usage":"作主语、宾语；指保存丧失的部分国土"},{"id":28273,"word":"江山可改，本性难移","pinyin":"jiāng shān kě gǎi，běn xìng nán yí","abbr":"jskgbxny","explanation":"江山：山川，河流；移：改变。改变人的本性比改变自然面貌还困难。强调人的习性是很难改变的。","source":{"text":"俗语有道：‘江山可改，本性难移。’","book":"蔡东藩《慈禧太后演义》第27回"},"example":{"text":"蔡东藩《慈禧太后演义》第27回：“俗语有道：‘～。’”"},"similar":["江山好改，本性难移"],"usage":"作定语、宾语、分句；形容本性很难改变"},{"id":28274,"word":"江山好改，本性难移","pinyin":"jiāng shān hǎo gǎi，běn xìng nán yí","abbr":"jshgbxny","explanation":"形容人的本性难以改变。同“江山易改，本性难移”。","source":{"text":"但‘江山好改，本性难移’，也许后来还要开开口。","book":"鲁迅《而已集·“意表之外”》"},"similar":["江山好改，秉性难移"],"usage":"作定语、宾语、分句；形容本性很难改变"},{"id":28275,"word":"江山好改，秉性难移","pinyin":"jiāng shān hǎo gǎi，bǐng xìng nán yí","abbr":"jshgbxny","explanation":"旧时俗语。强调人要改变习性是非常困难的。","source":{"text":"常言道得好，江山易改，禀性难移。","book":"明·冯梦龙《醒世恒言·徐老仆义愤成家》"},"example":{"text":"老兄，你岂不闻‘～’？你切不可打量他从此就这等好说话了。","book":"清·文康《儿女英雄传》第20回"},"similar":["江山易改，秉性难移"],"usage":"作定语、宾语、分句；形容本性很难改变"},{"id":28276,"word":"江山如故","pinyin":"jiāng shān rú gù","abbr":"jsrg","explanation":"故：从前。高山大河面貌依旧。多用于比喻物是人非。","source":{"text":"兵安在，膏锋锷。民安在，填沟壑。叹江山如故，千村寥落。","book":"宋·岳飞《满江红·登黄鹤楼有感》词"},"example":{"text":"偶披图旧时景象，历历可追凭。描摹出～，输与丹青。","book":"清·吴趼人《二十年目睹之怪现状》第四十回"},"similar":["江山依旧"],"usage":"作宾语、定语；比喻物是人非"},{"id":28277,"word":"江山如旧","pinyin":"jiāng shān rú jiù","abbr":"jsrj","explanation":"如：象。山河还同原来一样。常用来感叹世事的变迁。","source":{"text":"烧灯节，朝京道上风和雪。风和雪，江山如旧，朝京人绝。","book":"宋·刘辰翁《忆秦娥》词"},"example":{"text":"我今送客放舟去，～还英雄。","book":"明·朱桢《赤壁石刻》诗"}},{"id":28278,"word":"江山如画","pinyin":"jiāng shān rú huà","abbr":"jsrh","explanation":"山川、河流美如画卷。形容自然风光美丽如图画。","source":{"text":"江山如画，一时多少豪杰。","book":"宋·苏轼《念如娇，赤壁怀古》"},"example":{"text":"苍天无语，～，一片残阳西挂。","book":"梁启超《劫灰梦传奇·独啸》"},"usage":"作谓语；形容山河美如图画"},{"id":28279,"word":"江山易改，本性难移","pinyin":"jiāng shān yì gǎi，běn xìng nán yí","abbr":"jsygbxny","explanation":"人的本性的改变，比江山的变迁还要难。形容人的本性难以改变。","source":{"text":"可不的江山易改，本性难移。","book":"元·无名氏《谢金吾》第三折"},"example":{"text":"屡次说你，你总不听。真是～。","book":"巴金《家》"},"similar":["江山易改，秉性难移"],"usage":"作定语、宾语、分句；形容本性很难改变"},{"id":28280,"word":"江山易改，禀性难移","pinyin":"jiāng shān yì gǎi，bǐng xìng nán yí","abbr":"jsygbxny","explanation":"人的本性的改变，比江山的变迁还要难。形容人的本性难以改变。","source":{"text":"看官有所不知。常言道得好，江山易改，禀性难移。","book":"明·冯梦龙《醒世恒言》第三十五卷"},"example":{"text":"真是～，他宁死不屈。"},"similar":["江山可改，本性难移"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":28281,"word":"江山易改，秉性难移","pinyin":"jiāng shān yì gǎi，bǐng xìng nán yí","abbr":"jsygbxny","explanation":"旧时俗语。强调人要改变习性是非常困难的。","source":{"text":"常言道得好，‘江山易改，秉性难移。’","book":"明·冯梦龙《醒世恒言》卷三十五"},"similar":["江山好改，本性难移"],"usage":"作宾语、定语、分句；指人的性格"},{"id":28282,"word":"江左夷吾","pinyin":"jiāng zuǒ yí wú","abbr":"jzyw","explanation":"管夷吾，春秋时期政治家管仲，相齐桓公成霸业。后来诗文中多以之称有辅国救民之才的人。","source":{"text":"于时江左草创，纲维未举，峤殊以为忧。及见王导共谈，欢然曰：‘江左自有管夷吾，吾复何虑！’","book":"《晋书·温峤传》"},"example":{"text":"野人只欲安耕钓，～可见不？","book":"宋·陆游《泛舟湖山间有感》"},"usage":"作宾语、定语；用于政治家"},{"id":28283,"word":"江心补漏","pinyin":"jiāng xīn bǔ lòu","abbr":"jxbl","explanation":"船到江心才补漏洞。指临到紧急关头才设法补救，为时已晚。","source":{"text":"凭时节船到江心补漏迟，烦恼怨他谁，事要前思免后悔，我也劝你不得，有朝一日，准备着搭救你块望夫石。","book":"元·关汉卿《救风尘》第八折"},"example":{"text":"王铚续义山杂纂，载不济事四十一条，其一曰～。","book":"清·翟灏《通俗编·地理》"},"similar":["悔之莫及","临渴掘井"],"opposite":["有备无患","防微杜渐"],"usage":"作谓语、宾语、定语；同“船到江心补漏迟”"},{"id":28284,"word":"江水不犯河水","pinyin":"jiāng shuǐ bù fàn hé shuǐ","abbr":"jsbfhs","explanation":"比喻彼此互不相干，没有关系。"},{"id":28285,"word":"江汉之珠","pinyin":"jiāng hàn zhī zhū","abbr":"jhzz","explanation":"江汉：长江和汉水。江汉一带所产的珍珠。形容贵重之物。","source":{"text":"尧舜之王所以化海内者，北用禺氏之玉，南用江汉之珠。","book":"春秋·齐·管仲《管子·揆度》"},"usage":"作宾语；指贵重物品"},{"id":28286,"word":"江汉朝宗","pinyin":"jiāng hàn cháo zōng","abbr":"jhcz","explanation":"江汉：指长江和汉水；朝宗：诸侯朝见天子，借喻百川入海。指江河奔流入海。也比喻魇、大势所趋，人心所向。","source":{"text":"江汉朝宗于海。","book":"《尚书·禹贡》"},"similar":["大势所趋"],"usage":"作宾语、定语；比喻大势所趋"},{"id":28287,"word":"江河不实漏卮","pinyin":"jiāng hé bù shí lòu zhī","abbr":"jhbslz","explanation":"卮：古代盛酒的器具。江河的水，漏处太多，也会像有漏洞的酒器那样迟早要干涸。比喻不能忽视事物的细微之处。","source":{"text":"今夫溜水足以溢壶榼，而江河不能实漏卮。","book":"《淮南子·汜论训》"}},{"id":28288,"word":"江河日下","pinyin":"jiāng hé rì xià","abbr":"jhrx","explanation":"江河的水一天天地向下流。比喻情况一天天地坏下去。","source":{"text":"其状如长江大河，日夜浑浑趋于下而不能止。","book":"宋·苏辙《栾城集·应诏进策·君术策第五道》"},"example":{"text":"不瞒大师说，现在的时势，实在是～了！","book":"清·李宝嘉《官场现形记》第二十九回"},"similar":["每况愈下","江流日下"],"opposite":["蒸蒸日上"],"usage":"作谓语、宾语、定语；指事业精力等每况愈下"},{"id":28289,"word":"江河行地","pinyin":"jiāng hé xíng dì","abbr":"jhxd","explanation":"江河永远在陆地上奔流。比喻事情明显，无庸置疑，颠扑不破。","source":{"text":"岂得为日月经天，江河行地哉？","book":"清·郑燮《焦山别峰庵雨中无事书寄舍弟墨》"},"example":{"text":"盖以为道德者，日月经天，～，自无始以来，不增不减。","book":"清·梁启超《论公德》"},"similar":["天经地义","一成不变"],"usage":"作宾语、分句；常与“日月经天”连用"},{"id":28290,"word":"江洋大盗","pinyin":"jiāng yáng dà dào","abbr":"jydd","explanation":"在江河湖海抢劫行凶的强盗。","source":{"text":"小妇人父及夫，俱为江洋大盗所杀。","book":"明·凌濛初《初刻拍案惊奇》卷十九"},"example":{"text":"他一向本是～，因他善于使船，专能抢上风，踅顺水。","book":"清·文康《儿女英雄传》第二十一回"},"similar":["杀人越货"],"usage":"作主语、宾语；指强盗"},{"id":28291,"word":"江流日下","pinyin":"jiāng liú rì xià","abbr":"jlrx","explanation":"江河的水一天天地向下流。比喻情况一天天地坏下去。同“江河日下”。","source":{"text":"既经非常之破坏，而无非常之建设以继之，此所以祸乱相寻，江流日下。","book":"孙中山《建国方略·知行总论》"},"similar":["江河日下"],"usage":"作谓语、宾语、定语；用于事业精力等"},{"id":28292,"word":"江海不逆小流","pinyin":"jiāng hǎi bù nì xiǎo liú","abbr":"jhbnxl","explanation":"江海的浩瀚，是能容纳细流的缘故。比喻人气度大才能担当大事。","source":{"text":"太山不辞壤石，江海不逆小流。","book":"汉·刘向《说苑·尊贤》"},"usage":"作宾语、定语；指人的气度"},{"id":28293,"word":"江海之士","pinyin":"jiāng hǎi zhī shì","abbr":"jhzs","explanation":"旧指隐居不愿出来做官的人。","source":{"text":"就薮泽，处闲旷，钓鱼闲处，无为而已矣。此江海之士，避世之人，闲暇者之所好也。","book":"《庄子·刻意》"},"similar":["江海士"],"usage":"作主语、宾语、定语；用于隐士"},{"id":28294,"word":"江海之学","pinyin":"jiāng hǎi zhī xué","abbr":"jhzx","explanation":"比喻学识渊博。","source":{"text":"先生江海之学，小道是井底之蛙，焉敢班门弄斧。","book":"明·无名氏《女真观》第二折"},"usage":"作宾语；用于人的学识等"},{"id":28295,"word":"江海同归","pinyin":"jiāng hǎi tóng guī","abbr":"jhtg","explanation":"大江大海同归于大洋。指殊途而同归。","source":{"text":"贞元十二年天子诞日，诏儒官与缁黄讲论。初若矛楯相向，后类江海同归。三殿谈经，自此始也。","book":"宋·钱易《南部新书》乙"},"similar":["殊途同归"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":28296,"word":"江海士","pinyin":"jiāng hǎi shì","abbr":"jhs","explanation":"指志在江海不肯做官的隐士。","source":{"text":"孟生江海士，古貌又古心。","book":"唐·韩愈《孟生诗》"},"similar":["江海之士"],"usage":"作主语、宾语、定语；用于隐士"},{"id":28297,"word":"江淮河汉","pinyin":"jiāng huái hé hàn","abbr":"jhhh","explanation":"指长江、淮河、黄河、汉水。","source":{"text":"水由地中行，江、淮、河、汉是也。","book":"战国·邹·孟轲《孟子·滕文公》"},"usage":"作主语、宾语、定语；指江河等"},{"id":28298,"word":"江淹才尽","pinyin":"jiāng yān cái jìn","abbr":"jycj","explanation":"南朝梁江淹，少有文名，世称江郎。晚年诗文无佳句，时人谓之才尽。后来常用于比喻才思衰退。","source":{"text":"尔后为诗，不复成语，故世传‘江淹才尽’。","book":"南朝·梁·钟嵘《诗品》"},"example":{"text":"今世之惟务作诗，而不喜涉学，逮世故日胶，性灵日退，遂皆有～之消矣。","book":"清·洪亮吉《北江诗话》第三卷"},"similar":["江郎才尽","江淹梦笔"],"usage":"作定语、宾语；用于书面语","story":["南朝梁时期，文学家江淹年轻时刻苦读书，文思敏捷，作品深得众人喜爱。官至光禄大夫后文章大不如以前，诗也平淡无奇。原来他去宣城游玩时，在冶亭梦中见到郭璞，郭璞向他讨还五色笔，从此就文思枯竭，才能丧尽"]},{"id":28299,"word":"江淹梦笔","pinyin":"jiāng yān mèng bǐ","abbr":"jymb","explanation":"传说南朝梁江淹夜梦郭璞索还五色笔，尔后为诗遂无佳句。后以之比喻才思减退。","source":{"text":"宋玉悲秋愁闷，江淹梦笔寂寞，人间岂无成与破。","book":"元·白朴《恼煞人》"},"similar":["江淹才尽","江郎才尽"],"opposite":["梦笔生花"],"usage":"作定语、宾语；用于书面语","story":["南朝梁时期，文学家江淹年轻时刻苦读书，文思敏捷，作品深得众人喜爱。官至光禄大夫后文章大不如以前，诗也平淡无奇。原来他去宣城游玩时，在冶亭梦中见到郭璞，郭璞向他讨还五色笔，从此就文思枯竭，才能丧尽"]},{"id":28300,"word":"江湖义气","pinyin":"jiāng hú yì qì","abbr":"jhyq","explanation":"旧指走南闯北的人之间所遵循的忠义之气。今多指不顾原则地一味讲求朋友间的义气。"},{"id":28301,"word":"江湖医生","pinyin":"jiāng hú yī shēng","abbr":"jhys","explanation":"假称有医学知识的人或卖药的流动小贩，指那些没有真才实学的人。","source":{"text":"你不过是个江湖医生。","book":"清·吴趼人《二十年目睹之怪现状》第105回"},"example":{"text":"请不要轻信这些～的话，以免延误了病情。"},"similar":["江湖郎中"],"usage":"作主语、宾语、定语；用于戏谑人"},{"id":28302,"word":"江湖艺人","pinyin":"jiāng hú yì rén","abbr":"jhyr","explanation":"在街上表演吟唱、讲故事、舞蹈、变戏法和哑剧等艺术而谋生的人。","example":{"text":"这些～的生活真可怜。"},"usage":"作主语、宾语、定语；指卖艺求生的人"},{"id":28303,"word":"江湖骗子","pinyin":"jiāng hú piàn zi","abbr":"jhpz","explanation":"指闯荡江湖靠卖假药、算命等骗人谋生的人或招摇撞骗的人。","source":{"text":"近几年来，发生了不少诈骗事件，出现了一些各式各样的骗子，其中有政治骗子、经济骗子、文化骗子和江湖骗子。","book":"王仲方《序》"},"example":{"text":"我们不能相信～的话。"},"similar":["江湖郎中"],"usage":"作主语、宾语、定语；指招摇撞骗的人"},{"id":28304,"word":"江翻海倒","pinyin":"jiāng fān hǎi dǎo","abbr":"jfhd","explanation":"犹江翻海沸。形容水势浩大。多用以比喻力量或声势壮大。","source":{"text":"金鼓齐鸣，喊声如江翻海沸。","book":"明·罗贯中《三国演义》第十二回"},"example":{"text":"虎踞深林，顷刻～；蜂屯三澨，一霎时火烈烟飞。","book":"清·钱彩《说岳全传》第二十九回"},"similar":["倒海翻江"],"usage":"作谓语、定语；用于比喻句"},{"id":28305,"word":"江翻海扰","pinyin":"jiāng fān hǎi rǎo","abbr":"jfhr","explanation":"犹江翻海沸。形容水势浩大。多用以比喻力量或声势壮大。","source":{"text":"遍地腥膻，直弄得江翻海扰，鼠偷狗盗，大劫何日了？","book":"清·无名氏《陆沉病》楔子"},"similar":["江翻海搅","江翻海沸"],"usage":"作宾语、定语；用于比喻句"},{"id":28306,"word":"江翻海搅","pinyin":"jiāng fān hǎi jiǎo","abbr":"jfhj","explanation":"犹江翻海沸。形容水势浩大。多用以比喻力量或声势壮大。","source":{"text":"江翻海搅走六丁，纷纷水怪无留踪。","book":"明·吴承恩《二郎搜山图歌》"},"similar":["江翻海沸","江翻海扰"],"usage":"作宾语、定语；用于比喻句"},{"id":28307,"word":"江翻海沸","pinyin":"jiāng fān hǎi fèi","abbr":"jfhf","explanation":"形容水势浩大。多用以比喻力量或声势壮大。","source":{"text":"金鼓齐鸣，喊声如江翻海沸。","book":"明·罗贯中《三国演义》第十二回"},"example":{"text":"瞅上眼～，喝一声地惨天昏。","book":"明·无名氏《哪吒三变》"},"similar":["江翻海搅","江翻海扰"],"usage":"作宾语、定语；用于比喻句"},{"id":28308,"word":"江郎才尽","pinyin":"jiāng láng cái jìn","abbr":"jlcj","explanation":"江郎：指南朝江淹。原指江淹少有文名，晚年诗文无佳句。比喻才情减退。","source":{"text":"淹乃探怀中得五色笔一以授之。尔后为诗绝无美句，时人谓之才尽。","book":"《南史·江淹传》"},"example":{"text":"不，他不能和菊子散伙。散了伙，他必感到空虚，寂寞，无聊，或者还落个～，连诗也写不出了。","book":"老舍《四世同堂》五十五"},"similar":["黔驴技穷","江淹才尽","江郎才掩"],"opposite":["出类拔萃","初露锋芒"],"usage":"作谓语、定语、宾语；用于书面语","story":["南朝梁时文学家江淹年轻时刻苦读书，成为一个鼎鼎有名的文学家，官至光禄大夫。后来他的文章大不如以前了，诗也平淡无奇了，偶尔灵感一来，写出的东西也一无可取。据说他在梦中丢失了五色笔，从此就文思枯竭，才能丧尽"]},{"id":28309,"word":"江郎才掩","pinyin":"jiāng láng cái yǎn","abbr":"jlcy","explanation":"比喻才思衰退。同“江淹才尽”。","source":{"text":"炀帝好大喜功，每事自恃有才，及至征蛮草诏，便觉江郎才掩。","book":"清·褚人获《隋唐演义》第36回"},"similar":["江郎才尽","江淹才尽"],"usage":"作谓语、定语、宾语；用于书面语","story":["南朝梁时文学家江淹年轻时刻苦读书，成为一个鼎鼎有名的文学家，官至光禄大夫。后来他的文章大不如以前了，诗也平淡无奇了，偶尔灵感一来，写出的东西也一无可取。据说他在梦中丢失了五色笔，从此就文思枯竭，才能丧尽"]},{"id":28310,"word":"池中之物","pinyin":"chí zhōng zhī wù","abbr":"czzw","explanation":"池：池塘。比喻没有远大抱负的人。","source":{"text":"恐蛟龙得云雨，终非池中之物也。","book":"晋·陈寿《三国志·吴志·周瑜传》"},"example":{"text":"据先生甘贫守困，待势乘时，所谓蛟龙得云雨，终非～。","book":"元·无名氏《冻苏秦》第一折"},"similar":["井底之蛙"],"usage":"作宾语；多用于比喻句"},{"id":28311,"word":"池中物","pinyin":"chí zhōng wù","abbr":"czw","explanation":"指养在水池里的小鱼小虾。比喻困在狭小天地里不能施展抱负的人物。","source":{"text":"恐蛟龙得云雨，终非池中物也。","book":"《三国志·吴志·周瑜传》"},"example":{"text":"子建怀方抱智，终非～，若非早除，必为后患。","book":"明·罗贯中《三国演义》第七十九回"}},{"id":28312,"word":"池酒林胾","pinyin":"chí jiǔ lín zì","abbr":"cjlz","explanation":"胾，切成的大块肉。形容酒肉极多，生活奢侈。","source":{"text":"扞帝纣呴大冣乐戏於沙丘，以酒为池，县肉为林，使男女倮相逐其閒，为长夜之饮。","book":"《史记·殷本纪》"}},{"id":28313,"word":"池鱼之殃","pinyin":"chí yú zhī yāng","abbr":"cyzy","explanation":"比喻受牵连而遭到的祸害。","source":{"text":"汝宜择地而居，否则恐预池鱼之殃。","book":"《剪灯新话·三山福地传》"},"example":{"text":"王仁东也觉得军机全班尽撤，未免过分，连带使翁同酥受～，内心更为不安。","book":"高阳《清宫外史》下册"},"similar":["殃及池鱼","池鱼之祸"],"usage":"作宾语；比喻因牵连而遭到的祸害"},{"id":28314,"word":"池鱼之祸","pinyin":"chí yú zhī huò","abbr":"cyzh","explanation":"比喻受牵连而遭到的祸害。","source":{"text":"道士道：‘不出三年，世运变革。地方将有兵戈大乱，不产这光景了。你快择善地而居，免受池鱼之祸。’","book":"《二刻拍案惊奇》卷二四"},"similar":["池鱼之殃","池鱼遭殃"],"usage":"作宾语；比喻因牵连而遭到的祸害"},{"id":28315,"word":"池鱼之虑","pinyin":"chí yú zhī lǜ","abbr":"cyzl","explanation":"指担忧无端受累遭灾。","source":{"text":"讹传丁国恩率大兵会剿罗店，盖以吾镇贼曾踞巢穴，人人抱池鱼之虑，一时惊惶无措，各扶老携幼避匿四乡，半皆露宿。","book":"《上海小刀会起义史料汇编·罗店镇志》"},"usage":"作宾语；指担心"},{"id":28316,"word":"池鱼堂燕","pinyin":"chí yú táng yàn","abbr":"cyty","explanation":"比喻无辜受祸。","source":{"text":"俺来此携琴访友，并不曾流连夜晓。无端的池鱼堂燕一时烧。","book":"清·孔尚任《桃花扇·归山》"},"similar":["池鱼幕燕"],"usage":"作宾语、定语；多用于比喻句"},{"id":28317,"word":"池鱼幕燕","pinyin":"chí yú mù yàn","abbr":"cymy","explanation":"比喻处境危险极易遭殃的人。","source":{"text":"池鱼幕燕依栖浅，轩鹤冠猴宠渥新。","book":"明·刘基《驿传杭台消息石末公有诗见寄次韵奉和并寓悲感》之一"},"similar":["池鱼堂燕"],"usage":"作宾语、定语；用于比喻句"},{"id":28318,"word":"池鱼林木","pinyin":"chí yú lín mù","abbr":"cylm","explanation":"比喻无辜而受连累，遭祸害。","source":{"text":"楚王亡其猿，而林木为之残；宋君亡其珠，池中鱼为之殚。","book":"《淮南子·说山训》"},"example":{"text":"耿藩问罪之师，旦暮即至，～之殃，在所不免。","book":"清·李渔《义士李伦表传》"},"usage":"作主语、宾语、定语；指无辜的人、物"},{"id":28319,"word":"池鱼笼鸟","pinyin":"chí yú lóng niǎo","abbr":"cyln","explanation":"池里的鱼，笼里的鸟。比喻受束缚而失去自由的人。","source":{"text":"譬犹池鱼笼鸟，有江湖山薮之思。","book":"晋·潘岳《秋兴赋》"},"example":{"text":"他现在处于～的地步。"},"usage":"作主语、宾语、定语；指不自由的人"},{"id":28320,"word":"池鱼遭殃","pinyin":"chí yú zāo yāng","abbr":"cyzy","explanation":"比喻因牵连而遭到的祸害。","source":{"text":"党祸起中江，正士寒心，连袂长往，俺事外人也池鱼遭殃。","book":"清·孙雨林《皖江血》上卷"},"similar":["池鱼之殃"],"usage":"作宾语；比喻因牵连而遭到的祸害"},{"id":28321,"word":"污七八糟","pinyin":"wū qī bā zāo","abbr":"wqbz","explanation":"形容十分杂乱。","source":{"text":"可是，整个的北平都在污七八糟中，她所知道的‘能人’们，都闭着眼瞎混。","book":"老舍《四世同堂》"},"example":{"text":"在这种～的地方能出什么好人？"},"similar":["乱七八糟","乌七八糟"],"opposite":["井然有序","井井有条"],"usage":"作谓语、定语、补语；指脏乱"},{"id":28322,"word":"污吏黠胥","pinyin":"wū lì xiá xù","abbr":"wlxx","explanation":"黠：狡诈；胥：小吏。贪赃枉法的狡猾的官吏。","source":{"text":"比来道路四亩，皆鼓盛德，污吏黠胥，颇亦敛戢。","book":"宋·陆九渊《书与赵子直》"},"similar":["贪官污吏"],"usage":"作宾语、定语；用于书面语"},{"id":28323,"word":"污手垢面","pinyin":"wū shǒu gòu miàn","abbr":"wsgm","explanation":"形容手脸都很肮脏。","example":{"text":"他从车间出来，把自己弄得～"},"similar":["污首垢面"],"usage":"作定语、状语；用于人的外貌"},{"id":28324,"word":"污泥浊水","pinyin":"wū ní zhuó shuǐ","abbr":"wnzs","explanation":"比喻一切落后、腐朽和反动的东西。","source":{"text":"君若清路尘，妾若浊水泥，浮沉各异势，会合何时谐？","book":"三国·魏·曹植《七哀诗》"},"example":{"text":"她以一种宗教徒似的虔诚，拼命在自己灵魂深处挖‘～’，一点一滴都写在思想汇报上。","book":"陈登科《破壁记》第四章"},"similar":["残渣余孽"],"opposite":["清澈见底"],"usage":"作谓语、宾语；指腐朽和反动的东西"},{"id":28325,"word":"污言浊语","pinyin":"wū yán zhuó yǔ","abbr":"wyzy","explanation":"指粗俗下流、不堪入耳的话。","source":{"text":"莫学愚妇，不问根源，秽言污语，触突尊贤。","book":"唐·宋若华、宋若昭《女语论·和柔章》"}},{"id":28326,"word":"污言秽语","pinyin":"wū yán huì yǔ","abbr":"wyhy","explanation":"指肮脏下流的或不文明的话语。","source":{"text":"莫学愚妇，不问根源，秽言污语，触突尊贤。","book":"唐·宋若华、宋若昭《女语论·和柔章》"},"example":{"text":"我们不能说～。"},"usage":"作宾语、定语；指不文明的话语"},{"id":28327,"word":"汤去三面","pinyin":"tāng qù sān miàn","abbr":"tqsm","explanation":"泛言普施仁德。","source":{"text":"汤出，见野张网四面，祝曰：‘自天下四方皆入吾网。’汤曰：‘嘻，尽之矣！’乃去其三面，祝曰：‘欲左，左。欲右，右。不用命，乃入吾网。’诸侯闻之，曰：‘汤德至矣，及禽兽。’","book":"《史记·殷本纪》"},"example":{"text":"南朝·宋·范晔《后汉书·王畅传》：“～，八方归仁。”"},"similar":["网开一面"],"usage":"作宾语、定语；用于书面语","story":["商朝初年，商汤外出，见野外有人张四面网网动物，他对天而祷告：“自天下四方，皆入吾网。”商汤笑着说：“可以了。”就命人去掉三面网，说：“想左就左，想右就右，一切都入网。”诸侯们听说后称赞商汤德行很高能自动网罗一切"]},{"id":28328,"word":"汤池之固","pinyin":"tāng chí zhī gù","abbr":"tczg","explanation":"汤：热水；池：护城河。形容坚不可摧。","source":{"text":"殷中军虽思虑通长，然于才性偏精，忽言及四本，便苦汤池铁城，无可攻之势。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"明教经营总坛光明顶已数百年，凭借危崖天险，实有金城～。","book":"金庸《倚天屠龙记》第十九回"}},{"id":28329,"word":"汤池铁城","pinyin":"tāng chí tiě chéng","abbr":"tctc","explanation":"形容城池牢不可破。亦比喻言谈无懈可击。","source":{"text":"忽言及四本，便若汤池铁城，无可攻之势。","book":"南朝·宋·刘义庆《世说新语·文学四》"},"example":{"text":"就是～，我们也要把它拿下。"},"similar":["金城汤池"],"usage":"作宾语、定语；指十分坚固"},{"id":28330,"word":"汤烧火热","pinyin":"tāng shāo huǒ rè","abbr":"tshr","explanation":"指生病发高烧。","source":{"text":"又见他汤烧火热，自己守着他，歪在旁边劝他：‘只养病，别想着些没要紧的事。’","book":"清·曹雪芹《红楼梦》第二十回"},"usage":"作谓语、定语；用于书面语"},{"id":28331,"word":"汤里来，水里去","pinyin":"tāng lǐ lái，shuǐ lǐ qù","abbr":"tllslq","explanation":"指银钱随手来随手去，留不住。","source":{"text":"王明耀却是最工心计，什么钱都会弄，然而却是汤里来，水里去，白忙了半世，一些不能积蓄。","book":"清·李宝嘉《文明小史》第53回"},"example":{"text":"我们现在不需要～了。"},"usage":"作宾语、状语；指花钱"},{"id":28332,"word":"汤风冒雪","pinyin":"tāng fēng mào xuě","abbr":"tfmx","explanation":"汤：顶、当。顶着风，冒着雪。形容冬天旅途的艰辛。","source":{"text":"汤风冒雪，妨寒受冷。","book":"元·秦简夫《东堂老》第二折"},"example":{"text":"落在长行队，提铃报更点。～图荣显。","book":"元·刘唐卿《白兔记》第十七出"}},{"id":28333,"word":"汤饼之会","pinyin":"tāng bǐng zhī huì","abbr":"tbzh","explanation":"指孩子出生第三天举行宴会","source":{"text":"三朝洗儿，曰汤饼之会；周岁试周，曰睟盘之期。","book":"明·程登吉《幼学琼林》第二卷"},"example":{"text":"明·冯梦龙《喻世明言》第十卷：“一来为寿诞，二来小孩儿三朝，就当个～。”"},"usage":"作主语、宾语；用于书面语"},{"id":28334,"word":"汪洋大海","pinyin":"wāng yáng dà hǎi","abbr":"wydh","explanation":"汪洋：形容大水宽广无边。水势极其浩大。也比喻声势极其浩大。","source":{"text":"轰天炮响，汪洋大海起春雷。","book":"明·许仲琳《封神演义》第二回"},"example":{"text":"动员了全国的老百姓，就造成了陷敌于灭顶之灾的～。","book":"毛泽东《论持久战》"},"similar":["声势浩大","波澜壮阔"],"usage":"作主语、宾语；指大海"},{"id":28335,"word":"汪洋大肆","pinyin":"wāng yáng dà sì","abbr":"wyds","explanation":"形容文章、言论书法等气势豪放，潇洒自如。同“汪洋自肆”。","source":{"text":"当其所得，粹然一出于正，刊落陈言，横骛别驱，汪洋大肆，要之无抵捂圣人者。","book":"《新唐书·韩愈传赞》"},"similar":["汪洋恣肆","汪洋闳肆"],"usage":"作谓语、定语；用于书面语"},{"id":28336,"word":"汪洋恣肆","pinyin":"wāng yáng zī sì","abbr":"wyzs","explanation":"形容文章、言论书法等气势豪放，潇洒自如。同“汪洋自肆”。","source":{"text":"听其言汪洋恣肆，而实无所折衷，此今世之通患也。","book":"唐·柳宗元《直城县开国伯柳公行状》：“凡为文，去藻饰之华靡，汪洋自肆，以适己为用。” 明·归有光《与潘子实书》"},"example":{"text":"他激动地铺开稿纸，提笔写下了小说的题目，便～地写起来。","book":"刘绍棠《春草》"},"similar":["汪洋闳肆","汪洋大肆","汪洋自恣"],"usage":"作谓语、定语；用于书面语"},{"id":28337,"word":"汪洋浩博","pinyin":"wāng yáng hào bó","abbr":"wyhb","explanation":"形容人的气度宽广、文辞豪放、学识渊博像水势浩大无边。","source":{"text":"德者前辈之学，积小以成大，以所有易所无，以所能问于不能。故其久也，汪洋浩博，该极百家，而不可涯矣。","book":"宋·陆游《答刘主簿书》"},"example":{"text":"绎曾字伯敷，处州人，为人虽口吃，而精敏异常，诸经注疏，多能成诵。文辞～，其气烨如也。","book":"《元史·儒学传二·陈绎曾》"},"usage":"作谓语、定语；指人的气量或学问"},{"id":28338,"word":"汪洋自恣","pinyin":"wāng yáng zì zī","abbr":"wyzz","explanation":"比喻人的气度或气势宏大。","source":{"text":"且夫今之言汪洋自恣，莫如《庄子》，然未有因读《庄子》而汪洋自恣者也，即汪洋自恣之人，又未必读《庄子》也。","book":"明·袁中道《李温陵传》"},"example":{"text":"为诗文，机锋电激，～，寓言十九。","book":"《清史稿·余增远传》"},"similar":["汪洋自肆","汪洋大肆","汪洋恣肆"],"usage":"作谓语、定语；指人的气度或文章"},{"id":28339,"word":"汪洋自肆","pinyin":"wāng yáng zì sì","abbr":"wyzs","explanation":"汪洋：形容文章气势浑厚，义理深广。肆：放纵。形容人的气度或文章等大气磅礴，豪放自如。","source":{"text":"去藻饰之华靡，汪洋自肆，以适己为用。","book":"唐·柳宗元《宣城县开国伯柳公行状》"},"example":{"text":"她的文章作风～。"},"similar":["汪洋自恣"],"usage":"作谓语、定语；指人的气度或文章"},{"id":28340,"word":"汪洋辟阖","pinyin":"wāng yáng pì hé","abbr":"wyph","explanation":"汪洋：水势浩大；辟阖：开和关。水势浩大而开关有制。比喻文笔言谈酣畅淋漓，放得开，收得拢。"},{"id":28341,"word":"汪洋闳肆","pinyin":"wāng yáng hóng sì","abbr":"wyhs","explanation":"形容文章、言论书法等气势豪放，潇洒自如。同“汪洋自肆”。","source":{"text":"钦止少从王氏学，又尝见眉山苏公，故其文汪洋闳肆，粹然一本于经，而笔力豪放。","book":"宋·汪藻《鲍吏部集序》"},"similar":["汪洋大肆","汪洋恣肆","汪洋自恣"],"usage":"作谓语、定语；用于书面语"},{"id":28342,"word":"汰劣留良","pinyin":"tài liè liú liáng","abbr":"tlll","explanation":"指淘汰掉低劣的而留下精良的。","source":{"text":"若能汰劣留良，得一万则可给与一万，得二万亦可给与二万。","book":"孙中山《致蒋介石书》"},"similar":["去粗取精"],"usage":"作谓语、定语；指淘汰"},{"id":28343,"word":"汲古阁本","pinyin":"jí gǔ gé běn","abbr":"jggb","explanation":"版本名。指明毛晋汲古阁的刻本。也称毛本。"},{"id":28344,"word":"汲引忘疲","pinyin":"jí yǐn wàng pí","abbr":"jywp","explanation":"汲引：从井里提水，比喻引荐和提拔人才。引荐和提拔人才而忘记了疲劳。","source":{"text":"汲引忘疲，奖题不倦。","book":"唐·骆宾王《上衮州刺史启》"},"usage":"作宾语、定语；用于书面语"},{"id":28345,"word":"汲汲于富贵","pinyin":"jī jī yú fù guì","abbr":"jjyfg","explanation":"汲汲：急切的样子。指热衷于富贵利禄。","source":{"text":"圣贤异带而同出，其出之也，岂以汲汲于富贵，私丰于己之身也？将以区区于仁义，公知于古之道也。","book":"宋·柳开《应责》"}},{"id":28346,"word":"汲汲忙忙","pinyin":"jī jī máng máng","abbr":"jjmm","explanation":"汲汲：急切的样子。形容匆匆忙忙。","source":{"text":"使著作之人，总众事之凡，典国境之职，汲汲忙忙，何暇著作？","book":"汉·王充《论衡·书解》"},"example":{"text":"瞧他那～的样子，好像比国务院总理还忙"},"similar":["急急忙忙"],"usage":"作谓语、定语、状语；用于口语"},{"id":28347,"word":"汲汲皇皇","pinyin":"jī jī huáng huáng","abbr":"jjhh","explanation":"汲汲：急切的样子；皇皇：惶恐不安的样子。心情急切，举止匆忙。","source":{"text":"疑而后释，屯而后解，屯疑之极，必有汲汲皇皇，不敢顷刻自安之意，乃能解释。","book":"宋·陆九渊《与周元忠书》"},"example":{"text":"孔子异国大夫，列侯汉末郡守，既无讨贼之权，又乏兵车之卫，犹然～，席不暇暖。","book":"明·吾丘瑞《运甓记·闻判勤王》"},"similar":["汲汲忙忙"],"opposite":["慢条斯理"],"usage":"作谓语、状语；指急切匆忙"},{"id":28348,"word":"汲汲营营","pinyin":"jí jí yíng yíng","abbr":"jjyy","explanation":"急迫追求的样子。","example":{"text":"他显出一幅～的模样，她故意吊他胃口。"},"usage":"作定语、状语；用于口语"},{"id":28349,"word":"汲汲顾影","pinyin":"jí jí gù yǐng","abbr":"jjgy","explanation":"惶惶然自顾其影，孤苦失望的样子。也指频频地自顾其影，洋洋得意的样子。","source":{"text":"自兹以往，我民岁增二千余万之负担，汲汲顾影。","book":"清·梁启超《中国外债史》"},"example":{"text":"多置娇妻美妾，多买良田美宅，多役童仆奴婢，～。","book":"《辛亥革命前十年间时论选集》"},"usage":"作谓语；指洋洋得意的样子"},{"id":28350,"word":"汲深绠短","pinyin":"jí shēn gěng duǎn","abbr":"jsgd","explanation":"指井深而吊绳短。后比喻力不胜任。","source":{"text":"褚小者不可以怀大，绠短者不可以汲深。","book":"语出《庄子·至乐》"},"example":{"text":"东省幅员广阔，政务殷繁，臣才识庸暗，实有～之虞。","book":"《辛亥革命·人民反清斗争资料·山东莱阳县官民交战事馀闻》"},"similar":["绠短汲深"],"usage":"作宾语、定语；指力小任重的谦辞"},{"id":28351,"word":"汶阳田反","pinyin":"wèn yáng tián fǎn","abbr":"wytf","explanation":"比喻失而复返。","source":{"text":"先失楚弓，旋归赵璧。汶阳田反，合浦珠还。","book":"清·袁枚《随园诗话》第三卷"},"similar":["合浦珠还"],"usage":"作宾语、定语；用于书面语"},{"id":28352,"word":"汹汹拳拳","pinyin":"xiōng xiōng quán quán","abbr":"xxqq","explanation":"形容众人喧闹欢腾的样子。","source":{"text":"或朋从游宴，扰杂其间，他人皆汹汹拳拳，若将不及，张生容顺而已，终不能乱。","book":"唐·元稹《莺莺传》"}},{"id":28353,"word":"汹涌彭湃","pinyin":"xiōng yǒng péng pài","abbr":"xypp","explanation":"汹涌：波涛猛烈地向上涌。波浪翻腾，互相撞击。形容声势浩大","source":{"text":"沸乎暴怒，汹涌彭湃。","book":"汉·司马相如《上林赋》"},"similar":["汹涌淜湃","汹涌澎湃"],"usage":"作谓语、定语、状语；指声势浩大"},{"id":28354,"word":"汹涌淜湃","pinyin":"xiōng yǒng péng pai","abbr":"xypp","explanation":"波浪翻腾，互相撞击。亦比喻声势浩大，不可阻挡。同“汹涌彭湃”。","source":{"text":"荷兰之来因河、马斯河，美之密昔西比等河汹涌淜湃，从前濒年泛决。","book":"清·薛福成《出使四国日记·光绪十六年八月三十日》"},"similar":["汹涌澎湃","澎湃汹涌","奔腾澎湃"],"usage":"作谓语、定语、状语；指声势浩大"},{"id":28355,"word":"汹涌渒湃","pinyin":"xiōng yǒng péng pai","abbr":"xypp","explanation":"波浪翻腾，互相撞击。亦比喻声势浩大，不可阻挡。同汹涌彭湃”。"},{"id":28356,"word":"汹涌澎湃","pinyin":"xiōng yǒng péng pài","abbr":"xypp","explanation":"汹涌：洪水猛烈上涌的样子；澎湃：波浪互相撞击。形容声势浩大，不可阻挡。","source":{"text":"沸乎暴怒，汹涌澎湃。","book":"汉·司马相如《上林赋》"},"example":{"text":"两洋的潮水交织一起，形成一派～的大浪，这就是横扫亚非两洲的反殖民主义的浪潮。","book":"杨朔《两洋潮水》"},"similar":["波澜壮阔","声势浩大"],"opposite":["风平浪静"],"usage":"作谓语、定语、状语；指声势浩大"},{"id":28357,"word":"沁人心肺","pinyin":"qìn rén xīn fèi","abbr":"qrxf","explanation":"指人感到舒适，有清新爽朗的感觉。同“沁人心脾”。","source":{"text":"槐花的香味沁人心肺。","book":"草明·沈德符《野获编·词曲·时尚小令》：“举世传诵，沁人心腑。”明《乘风破浪》"},"similar":["沁人心脾","沁入心脾"],"usage":"作谓语、定语；指芳香凉爽的空气或饮料"},{"id":28358,"word":"沁人心脾","pinyin":"qìn rén xīn pí","abbr":"qrxp","explanation":"沁：渗入。原指芳香凉爽的空气或饮料使人感到舒适。也形容诗歌和文章优美动人，给人清新爽朗的感觉。","source":{"text":"沁：渗入。原指芳香凉爽的空气或饮料使人感到舒适。也形容诗歌和文章优美动人，给人清新爽朗的感觉。"},"example":{"text":"然而夜气很清爽，真所谓“～”，我在北京遇着这样的好空气，仿佛这是第一遭了。","book":"鲁迅《呐喊·社戏》"},"similar":["感人肺腑","沁人肺腑"],"opposite":["空气污染"],"usage":"作谓语、定语；指芳香凉爽的空气或饮料"},{"id":28359,"word":"沁人心腑","pinyin":"qìn rén xīn fǔ","abbr":"qrxf","explanation":"指人感到舒适，有清新爽朗的感觉。同“沁人心脾”。","source":{"text":"举世传诵，沁人心腑。","book":"明·沈德符《野获编·词曲·时尚小令》"},"example":{"text":"上面真的只有少数花朵开放，散发出一股～的清香。","book":"周而复《上海的早晨》第四部"},"similar":["沁人心脾"],"usage":"作谓语、定语；指芳香凉爽的空气或饮料"},{"id":28360,"word":"沁人肺腑","pinyin":"qìn rén fèi fǔ","abbr":"qrff","explanation":"吸入新鲜空气像渗入内脏一样感到舒畅。","source":{"text":"玉液珠胶，雪腴霜腻；吹气胜兰，沁人肺腑。","book":"明·张岱《陶庵梦忆》"},"example":{"text":"闻到一股子～的新麦的清香。","book":"浩然《艳阳天》第129章"},"similar":["感人肺腑","沁人心脾"],"usage":"作谓语、定语；指气味等"},{"id":28361,"word":"沁入心脾","pinyin":"qìn rù xīn pí","abbr":"qrxp","explanation":"指人感到舒适，有清新爽朗的感觉。同“沁人心脾”。","source":{"text":"兰儿遂一吸告干，味清而甘，沁入心脾，顿觉精神倍增。","book":"《慈禧太后演义》第二回"},"example":{"text":"《慈禧太后演义》第二回：“兰儿遂一吸告干，味清而甘，～，顿觉精神倍增。”"},"similar":["沁人心脾"],"usage":"作谓语、定语；指芳香凉爽的空气或饮料"},{"id":28362,"word":"沁入肺腑","pinyin":"qìn rù fèi fǔ","abbr":"qrff","explanation":"沁：渗入。原指芳香凉爽的空气或饮料使人感到舒适。也形容诗歌和文章优美动人，给人清新爽朗的感觉。","source":{"text":"一泓清可沁诗脾，冷暖年来只自知。","book":"宋·林稹《冷泉亭》诗"},"example":{"text":"玉液珠胶，雪腴霜腻；吹气胜兰，～。","book":"清·张岱《陶庵梦忆·乳酪》"},"similar":["沁入心脾"],"usage":"作谓语、定语；指感受极深"},{"id":28363,"word":"沂水弦歌","pinyin":"yí shuǐ xián gē","abbr":"ysxg","explanation":"指知时处世，逍遥游乐。","source":{"text":"[曾点]曰：‘莫春者，春服既成，冠者五六人，童子六七人，浴乎沂，风乎舞雩，咏而归。’","book":"语出《论语·先进》"},"example":{"text":"～重曾点，菑川故旧识平津。","book":"宋·苏辙《送龚鼎臣谏议移守青州》诗之一"},"similar":["沂水春风","沂水舞雩"],"usage":"作宾语、定语；用于书面语"},{"id":28364,"word":"沂水春风","pinyin":"yí shuǐ chūn fēng","abbr":"yscf","explanation":"沂水：河水名，在山东省曲阜县境内，孔子出生地。春风：春天和暖的风，比喻良好的熏陶和教育。来自沂水的春风。比喻深受孔学的教育与熏陶。","source":{"text":"这位霸王果然能照我家子晰公一般，领略些沂水春风乐趣，自然上下与天地同流了哇。又怎得会短如春梦。","book":"清·文康《儿女英雄传》第三十九回"},"similar":["沂水舞雩","沂水弦歌"],"usage":"作宾语、定语；用于书面语"},{"id":28365,"word":"沂水舞雩","pinyin":"yí shuǐ wǔ yú","abbr":"yswy","explanation":"指知时处世，逍遥游乐。","source":{"text":"浴乎沂，风乎舞雩。","book":"语出《论语·先进》"},"example":{"text":"亮今甚贫，疑此景之可致，故以为可只作富贵者之事业。而来谕便谓‘做～意思不得，亦不是抱膝长啸底气象’。如此则咳嗽亦不可矣。","book":"宋·陈亮《又一巳春书之二》"},"similar":["沂水春风","沂水弦歌"],"usage":"作宾语、定语；用于书面语"},{"id":28366,"word":"沃壤千里","pinyin":"wò rǎng qiān lǐ","abbr":"wrql","explanation":"形容肥沃的土地极为宽广。","source":{"text":"夫关中左殽函，右陇蜀，沃野千里，南有巴蜀之饶，北有胡苑之利，阻三面而守，独以一面东制诸侯。","book":"《史记·留侯世家》"},"example":{"text":"况襄阳依山阻汉，～，设若侵略，据山以为巢穴，如人扼其咽喉。","book":"清·毕沅《续资治通鉴》卷一百三十四"}},{"id":28367,"word":"沃野千里","pinyin":"wò yě qiān lǐ","abbr":"wyql","explanation":"形容肥沃的土地极为宽广。","source":{"text":"夫关中左殽函，右陇蜀，沃野千里。","book":"《汉书·张良传》"},"example":{"text":"天府之国，～。"},"opposite":["赤地千里"],"usage":"作谓语、定语；指肥沃的土地极为宽广"},{"id":28368,"word":"沃雪注萤","pinyin":"wò xuě zhù yíng","abbr":"wxzy","explanation":"沃、注：用水浇。用水浇萤火和雪。比喻轻而易举的事情。","source":{"text":"若使旗鼓相望，埃尘相接，势如沃雪，事等注萤。","book":"《梁书·侯景传》"}},{"id":28369,"word":"沅江九肋","pinyin":"yuán jiāng jiǔ lèi","abbr":"yjjl","explanation":"传说中产于沅江流域的异龟。用以比喻稀少或难得的人才。","source":{"text":"袁州出举人，亦犹沅江出龟甲九肋者，盖稀矣。","book":"五代·王定保《唐摭言·自负》"},"example":{"text":"唯故人二三辈与门生时时相过，文采议论，灿然可观，求子微、怀一，盖～也。","book":"宋·叶梦得《避暑录话》卷上"},"similar":["凤毛麟角"],"usage":"作宾语、定语；用于书面语"},{"id":28370,"word":"沅芷湘兰","pinyin":"yuán zhǐ xiāng lán","abbr":"yzxl","explanation":"本指生于沅湘两岸的芳草，后用以比喻高洁的人或事物。同“沅芷澧兰”。","source":{"text":"沅芷湘兰昔所闻，十年今始觏群芬。","book":"清·方文《酬邹师可见投之作》诗"},"similar":["沅芷澧兰"],"usage":"作宾语、定语；用于书面语"},{"id":28371,"word":"沅芷澧兰","pinyin":"yuán zhǐ lǐ lán","abbr":"yzll","explanation":"芷，一本作“茝”。澧，一本作“醴”。本指生于沅澧两岸的芳草，后用以比喻高洁的人或事物。","source":{"text":"《楚辞·九歌·湘夫人》：“沅有芷兮澧有兰。”王逸注：“言沅水之中有盛茂之芷，澧水之内有芬芳之兰，异於众草”。"},"example":{"text":"～骚客远，朱桥粉郭酒人疏。","book":"清·金农《寄岳州黄处士》诗"},"similar":["沅芷湘兰"],"usage":"作宾语、定语；用于书面语"},{"id":28372,"word":"沅茝醴兰","pinyin":"yuán chǎi lǐ lán","abbr":"ycll","explanation":"本指生于沅澧两岸的芳草，后用以比喻高洁的人或事物。同“沅芷澧兰”。"},{"id":28373,"word":"沅茞澧兰","pinyin":"yuán zhǐ lǐ lán","abbr":"ycll","explanation":"沅、澧：都是水名；茞、兰：都是香草。比喻高洁的人品或高尚的事物。","source":{"text":"沅有茞兮澧有兰。","book":"战国楚·屈原《九歌·湘夫人》"},"similar":["沅芷澧兰"],"usage":"作宾语、定语；指人的品德"},{"id":28374,"word":"沆瀣一气","pinyin":"hàng xiè yī qì","abbr":"hxyq","explanation":"沆瀣：指唐时的崔沆、崔瀣。比喻臭味相投的人结合在一起。","source":{"text":"又乾符二年，崔沆放崔瀣，谭者称座主门生，沆瀣一气。","book":"宋·钱易《南部新书·戊集》"},"example":{"text":"皓东的敏锐活泼，和胜佛的豪迈灵警，两雄相遇，尤其～。","book":"清·曾朴《孽海花》第十四回"},"similar":["狼狈为奸","同流合污"],"opposite":["志同道合","肝胆相照","精诚团结"],"usage":"作谓语、宾语；指坏人聚在一块","story":["唐僖宗时，主考官崔沆录取一个成绩平平、长相也不出众的崔瀣，并分配他一个很好的官职。崔瀣得意洋洋去上任，显出一幅不可一世的样子。人们纷纷猜测他与崔沆的关系，有人还嘲笑他们是“座主门生，沆瀣一气。”"]},{"id":28375,"word":"沈博绝丽","pinyin":"chén bó jué lì","abbr":"cbjl","explanation":"指文章的含意深远，内容渊博，文辞美妙。","source":{"text":"少不得学，而心好沈博绝丽之文。","book":"汉·扬雄《答刘歆书》"},"example":{"text":"行卷～，脍炙一时。","book":"清·平步清《霞外捃屑》卷五"}},{"id":28376,"word":"沈腰潘鬓","pinyin":"shěn yāo pān bìn","abbr":"sypb","explanation":"形容姿态、容貌美好（特指男子）。","source":{"text":"一旦归为臣虏，沈腰潘鬓消磨。","book":"南·李煜《破阵子》词"},"similar":["潘鬓沈腰"],"usage":"作宾语、定语；形容身体过早衰弱"},{"id":28377,"word":"沈诗任笔","pinyin":"shěn shī rèn bǐ","abbr":"ssrb","explanation":"①南朝梁沈约以诗着称，任昉以表、奏、书、启诸体散文擅名，时人称为“沈诗任笔”。笔，指无韵之文。②用以泛指诗文。","source":{"text":"沈诗任笔俱忘尽，酒户新来却少僧。","book":"宋·陆游《亲旧书来多问近况以诗答之》"},"usage":"作宾语、定语；用于书面语"},{"id":28378,"word":"沉不住气","pinyin":"chén bù zhù qì","abbr":"cbzq","explanation":"易激动，遇事保持不了冷静镇定。","source":{"text":"这当然也要怪俞武成沉不住气，自己失去了镇江一带的地盘，寄人篱下。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"他这人就是～。"},"similar":["心浮气躁"],"opposite":["沉着应战"],"usage":"作谓语、定语；指不冷静"},{"id":28379,"word":"沉冤莫白","pinyin":"chén yuān mò bái","abbr":"cymb","explanation":"沉冤：长期得不到伸雪的冤案；莫白：无法辩白，不能弄清。长期得不到申雪的冤屈。","source":{"text":"潜遁幽岩，沉冤莫雪。","book":"唐·于逖《灵应传》"},"example":{"text":"案关出入，岂容蒙混。仰在研询，务得确情，不得含糊了事，以致～。","book":"清·李宝嘉《中国现在记》第十一回"},"similar":["不白之冤","沉冤莫雪"],"opposite":["平反昭雪"],"usage":"作谓语、定语；指不白之冤"},{"id":28380,"word":"沉冤莫雪","pinyin":"chén yuān mò xuě","abbr":"cymx","explanation":"沉冤：长期得不到伸雪的冤案；莫雪：无法昭雪。长期得不到昭雪的冤屈。","source":{"text":"潜遁幽岩，沉冤莫雪。","book":"唐·于逖《灵应传》"},"example":{"text":"不过为的是死者～，所以代抱不平罢了。","book":"清·吴趼人《九命奇冤》第24回"},"similar":["沉冤莫白"],"opposite":["平反昭雪"],"usage":"作谓语、定语；指不白之冤"},{"id":28381,"word":"沉几观变","pinyin":"chén jī guān biàn","abbr":"cjgb","explanation":"沉：沉着；几：事物变化前的前兆。冷静观察事物，随机应变。","source":{"text":"沉几观变，前事可师。","book":"蔡东藩《民国通俗演义》第二回"},"example":{"text":"践实体诚非别术，～竟通神。","book":"谢觉哉《在范亭处谈毛泽东的思想方法》"},"similar":["随机应变"],"usage":"作谓语、宾语；用于处事"},{"id":28382,"word":"沉博绝丽","pinyin":"chén bó jué lì","abbr":"cbjl","explanation":"沉：深长；博：渊博。指文章的含义深远，内容渊博，文辞美妙。","source":{"text":"少不得学，而心好沉博绝丽之文。","book":"汉·扬雄《答刘歆书》"},"example":{"text":"行卷～，脍炙一时。","book":"清·平步清《霞外捃屑》卷五"},"similar":["沉博艳丽"],"usage":"作谓语、定语；指文字华丽"},{"id":28383,"word":"沉厚寡言","pinyin":"chén hòu guǎ yán","abbr":"chgy","explanation":"朴实稳重，不爱多说话。同“沉重少言”。","source":{"text":"帝美容仪，性沉厚寡言，雅好儒士。","book":"《旧五代史·梁书·末帝纪》"},"example":{"text":"四五岁能说前生事，～，人传为异事。","book":"金·元好问《续夷坚志》第四卷"},"similar":["沉重寡言","沉重少言"],"opposite":["口若悬河","喋喋不休"],"usage":"作谓语、定语；用于人言语不多"},{"id":28384,"word":"沉吟不决","pinyin":"chén yín bù jué","abbr":"cybj","explanation":"沉吟：深思吟味，引申为犹豫；决：决断。形容人遇到难题时，自言自语地决定不下来。","source":{"text":"沉吟不决，遂上升天。","book":"三国·魏·曹操《秋胡行》"},"example":{"text":"张逸芳吐出那座“马”，把自己的“车”抓在手里～。","book":"巴金《虹》六"},"similar":["犹豫不决","沉吟未决"],"opposite":["当机立断","斩钉截铁"],"usage":"作谓语、定语、状语；形容迟疑不决"},{"id":28385,"word":"沉吟不语","pinyin":"chén yīn bù yǔ","abbr":"cyby","explanation":"沉默地思量着，不说话。引伸为迟疑不决的态度。","source":{"text":"钱万选听了，沉吟不语。","book":"明·冯梦龙《醒世恒言·钱秀才错占凤凰俦》"},"example":{"text":"见士及～，便问士及道：“请问哥哥，这是何人所送？如此踌躇？”","book":"清·禇人获《隋唐演义》第四十八回"},"similar":["沉默寡言"],"usage":"作谓语、定语；指沉默"},{"id":28386,"word":"沉吟未决","pinyin":"chén yīn wèi jué","abbr":"cywj","explanation":"沉吟：深思吟味，引伸为犹豫；决：决断。形容人遇到难题时，自言自语地决定不下来。","source":{"text":"沉吟不决，遂上升天。","book":"三国·魏·曹操《秋胡行》"},"example":{"text":"英～，永曰：‘机者如神，难遇易失，今日不往，明朝必为贼有，虽悔无及。’","book":"《魏书·傅永传》"},"similar":["沉吟不决","犹豫不决"],"opposite":["斩钉截铁","当机立断"],"usage":"作谓语、定语；形容迟疑不决"},{"id":28387,"word":"沉吟章句","pinyin":"chén yīn zhāng jù","abbr":"cyzj","explanation":"沉吟：沉思吟味。章句：章节和句子，亦指诗文。默默地琢磨构思诗文。","source":{"text":"然而善属文，往往沉吟章句，怨慕者久之。","book":"唐·无稹《莺莺传》"},"usage":"作谓语、宾语；用于写作等"},{"id":28388,"word":"沉声静气","pinyin":"chén shēng jìng qì","abbr":"csjq","explanation":"指声调低沉，态度平和。","source":{"text":"他沉声静气的问：‘你是那里的，要往那里去？’","book":"冰心《到青龙桥去》"},"example":{"text":"他习惯～地说话。"},"similar":["心平气和"],"usage":"作宾语、状语；指心平气和"},{"id":28389,"word":"沉密寡言","pinyin":"chén mì guǎ yán","abbr":"cmgy","explanation":"犹沉默寡言。不声不响，很少说话。","source":{"text":"[羡之]沉密寡言，不以忧喜见色。","book":"《宋书·徐羡之传》"},"similar":["沉默寡言"],"usage":"作谓语、宾语、定语；形容人性格沉稳"},{"id":28390,"word":"沉心静气","pinyin":"chén xīn jìng qì","abbr":"cxjq","explanation":"犹言心平气和。","source":{"text":"我走着不敢说疲乏，我忍着不敢说饥渴；且沉心静气的听，听荒漠里的天籁。","book":"瞿秋白《文艺杂著·荒漠里》"},"similar":["平心静气","心平气和"],"usage":"作定语、状语；用于人处事"},{"id":28391,"word":"沉思熟虑","pinyin":"chén sī shú lǜ","abbr":"cssl","explanation":"深入思索，仔细考虑。","source":{"text":"像受了什么刺戟似的，梅女士忽然戴着一付沉思熟虑的面孔。","book":"茅盾《虹》"},"example":{"text":"经过～，她终于答应嫁给我。"},"similar":["深思熟虑"],"usage":"作谓语、宾语；指深入考虑"},{"id":28392,"word":"沉思翰藻","pinyin":"chén sī hàn zǎo","abbr":"cshz","explanation":"沉：深沉；翰藻：文辞华丽。寓意深刻，文辞华丽。","source":{"text":"事出于沉思，义归于翰藻。","book":"南朝·梁·萧统《文选》序"},"example":{"text":"为其以立意纪事为本，非～之比也。","book":"清·阮元《与友人论古文书》"},"usage":"作宾语、定语；用于文章或说话等"},{"id":28393,"word":"沉思默想","pinyin":"chén sī mò xiǎng","abbr":"csmx","explanation":"形容深入地思考。沉：深。默：不作声。","source":{"text":"三藏沉思默想道：‘……我三个徒弟，不知我困陷在于这里，倘或加害，却不枉丢性命？’","book":"明·吴承恩《西游记》第55回"},"example":{"text":"他又在窗前～起来。"},"similar":["冥思苦想"],"usage":"作谓语、状语；用于思考问题"},{"id":28394,"word":"沉思默虑","pinyin":"chén sī mò lǜ","abbr":"csml","explanation":"沉：深；默：不出声。深深地思索，默默地考虑。","source":{"text":"樵子见行者沉思默虑，嗟叹不已。","book":"明·吴承恩《西游记》第五十九回"}},{"id":28395,"word":"沉机观变","pinyin":"chén jī guān biàn","abbr":"cjgb","explanation":"沉：深藏；机：机智。深藏机智，观察变化。形容头脑里办法多，有随机应变的才能。"},{"id":28396,"word":"沉李浮瓜","pinyin":"chén lǐ fú guā","abbr":"clfg","explanation":"吃在冷水里浸过的瓜果。形容暑天消夏的生活。","source":{"text":"淝甘瓜于清泉，沉朱李于寒水。","book":"三国·魏·曹丕《与朝歌令吴质书》"},"example":{"text":"恁般楼台正宜夏，却输他～。","book":"元·马致远《新水令·题西湖》"},"similar":["浮瓜沉李"],"usage":"作宾语、定语；形容夏季消暑的情形"},{"id":28397,"word":"沉毅寡言","pinyin":"chén yì guǎ yán","abbr":"cygy","explanation":"沉毅：深沉宁静。深沉文静，不爱多说话。","source":{"text":"崇义有勇力，能卷铁舒钩，沉毅寡言，得众心。","book":"《资治通鉴·肃宗文明武德大圣大宣孝皇帝广德元年》"},"example":{"text":"子俊～，有伟略。凡奏疏公移，必自属草，每夜分方寝。","book":"清·张廷玉《明史·余子俊传》"}},{"id":28398,"word":"沉沉稳稳","pinyin":"chén chén wěn wěn","abbr":"ccww","explanation":"指稳重不浮躁或指安稳。","source":{"text":"上皇看饮了，只道其胎即堕，不意腹中全无发动，竟沉沉稳稳的直睡至天明。","book":"清·褚人获《隋唐演义》第99回"},"similar":["稳稳重重","安安稳稳"],"usage":"作定语、状语；指稳当"},{"id":28399,"word":"沉洝浓郁","pinyin":"chén jìn nóng yù","abbr":"cany","explanation":"沉浸：沉入；浓：味厚的美酒；郁：用芳草合成的酒。原指嗜好美酒。也比喻嗜好价值很高的古籍。","source":{"text":"沉浸浓郁，含英咀华。","book":"唐·韩愈《进学解》"}},{"id":28400,"word":"沉浮俯仰","pinyin":"chén fú fǔ yǎng","abbr":"cffy","explanation":"形容人、事物、时势的盛衰。","source":{"text":"沉浮犹盛衰。","book":"汉·刘安《淮南子·原道训》：“与道貌沉浮俯仰。” 高诱注"},"similar":["俯仰沉浮"],"usage":"作宾语、定语；用于人或事物等"},{"id":28401,"word":"沉渐刚克","pinyin":"chén qián gāng kè","abbr":"cjgk","explanation":"渐：通“潜”，潜伏；刚克：以刚强见胜。形容深沉不外露，内里刚强。","source":{"text":"及温而还，其妻问之，赢曰：‘以刚。’商书曰：‘沉渐刚克，高明柔克。’","book":"春秋·鲁·左丘明《左传·文公五年》"},"similar":["沉乾刚克"],"usage":"作谓语、定语；指人深沉"},{"id":28402,"word":"沉湎淫逸","pinyin":"chén miǎn yín yì","abbr":"cmyy","explanation":"沉湎：沉迷。沉溺于酒和安逸中间。形容对于美酒和女色过于放纵，纵欲放荡。","source":{"text":"太康败于甘酒，桀败于酒池，厉王败于荒酒，幽王败于沉湎淫逸。","book":"宋·杨万里《宋故龙图阁学士张公神道碑》"},"example":{"text":"他～，终于一事无成。"},"similar":["沉湎酒色"],"usage":"作谓语、定语；指贪图安逸"},{"id":28403,"word":"沉湎酒色","pinyin":"chén miǎn jiǔ sè","abbr":"cmjs","explanation":"沉湎：沉迷。沉溺于酒和女人中间。形容对于美酒和女色过于放纵，毫无节制。","source":{"text":"沉湎酒色，敢行暴虐。","book":"《尚书·泰誓上》"},"similar":["纵情酒色"],"usage":"作谓语、宾语；用于处世"},{"id":28404,"word":"沉滓泛起","pinyin":"chén zǐ fàn qǐ","abbr":"czfq","explanation":"已经沉底的渣滓重新浮上水面。","example":{"text":"小心这种不好的思潮～。"},"similar":["老调重弹","沉渣泛起"],"usage":"作谓语、定语；用于不好的东西"},{"id":28405,"word":"沉潜刚克","pinyin":"chén qián gāng kè","abbr":"cqgk","explanation":"沉潜：深沉不露；刚克：以刚强见胜。形容深沉不露，内蕴刚强。","source":{"text":"沉潜刚克，高明柔克。","book":"《尚书·洪范》"},"example":{"text":"～，高明柔克，德之中也。","book":"南宋·陆九渊《常胜之道曰柔论》"},"similar":["沉渐刚克"],"usage":"作谓语、定语；指人深沉"},{"id":28406,"word":"沉灶产蛙","pinyin":"chén zào chǎn wā","abbr":"czcw","explanation":"灶没与水中，产生青蛙。形容水患之甚。","source":{"text":"今城不没者三板。臼灶升蛙，人马相食。","book":"《国语·晋语九》：“晋师围而灌之，沉灶产蛙，民无叛意。”《战国策·赵策一》"},"example":{"text":"智伯攻围甚急，某避走晋阳，今又引水围灌城，不浸者三版，～看看渰倒城墙。","book":"元·杨梓《豫让吞炭》第二折"},"similar":["沉灶生蛙"],"usage":"作宾语、定语；形容水患严重"},{"id":28407,"word":"沉灶生蛙","pinyin":"chén zào shēng wā","abbr":"czsw","explanation":"灶没与水中，产生青蛙。形容水患之甚。","source":{"text":"百川泛滥，潢潦横流，沉灶生蛙，中庭运舟。","book":"晋·成公绥《阴霖赋》"},"similar":["沉灶产蛙"],"usage":"作宾语、定语；形容水患严重"},{"id":28408,"word":"沉烽静柝","pinyin":"chén fēng jìng tuò","abbr":"cfjt","explanation":"烽火熄灭，柝声寂静。比喻边疆无战事。","source":{"text":"偃武修文九围泰，沉烽静柝八荒宁。","book":"唐·玄宗《明堂乐章·舒和》"},"usage":"作宾语、定语；指无战事"},{"id":28409,"word":"沉疴宿疾","pinyin":"chén kē sù jì","abbr":"cksj","explanation":"疴：病；宿：长久的。指重病和老病。也比喻积久而成，为害甚大的社会弊端。","source":{"text":"美雨欧风，顿起沉疴宿疾；发聋振聩造成儿女英雄。","book":"清·秋谨《精卫石》第五回"},"example":{"text":"我们要彻底根治这些～。"},"similar":["疑难杂症"],"usage":"作宾语、定语；指弊端"},{"id":28410,"word":"沉疴难起","pinyin":"chén kē nán qǐ","abbr":"cknq","explanation":"沉疴：重病或老病。久患重病，不能下床。"},{"id":28411,"word":"沉痼自若","pinyin":"chén gù zì ruò","abbr":"cgzr","explanation":"沉痼：积久难治的疾病。比喻积久难改的习俗或嗜好没有改变。","source":{"text":"第言端平以来，窜脏吏，禁包苴，戒奔竟，戢横敛，而风俗沉痼自若。","book":"《宋史·赵与懽》"},"usage":"作谓语、定语；用于人或事物等"},{"id":28412,"word":"沉着痛快","pinyin":"chén zhuó tòng kuài","abbr":"cztk","explanation":"指书法、文章深厚稳健，直率而无拘泥之态。","source":{"text":"吴人皇象能草，世称沉重痛快。","book":"南朝·宋·羊欣《采古来能书人名》"},"example":{"text":"～，天也。自然与学道，其为天一也。","book":"宋·姜夔《白石道人诗说》"},"similar":["沉著痛快"],"usage":"作谓语、宾语；用于作品等"},{"id":28413,"word":"沉舟侧畔千帆过，病树前头万木春","pinyin":"chén zhōu cè pàn qiān fān guò，bìng shù qián tóu wàn mu chun","abbr":"czcpqfgbsqtwmc","explanation":"沉：沉没；侧畔：旁边；帆：船。沉船旁边有很多船过，发病的树木旁边有很多茂盛的树木。比喻新生势力锐不可当。","source":{"text":"怀旧空吟闻笛赋，到郡翻似烂柯人。沉舟侧畔千帆过，病树前头万木春。","book":"唐·刘禹锡《酬乐天扬州缝席上见赠》"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":28414,"word":"沉舟破釜","pinyin":"chén zhōu pò fǔ","abbr":"czpf","explanation":"釜，锅。打破饭锅，沉掉渡船。表示决一死战。","source":{"text":"项羽乃悉引兵渡河，皆沉船，破釜甑，烧庐舍，持三日粮，以示士卒必死，无一还心。","book":"《孙子·九地》：“焚舟破釜，若驱羊而往。”《史记·项羽本纪》"},"example":{"text":"欲令诸师毕渡，～，为不返之计。","book":"清·黄宗羲《移史馆熊公雨殷行状》"},"similar":["破釜沉舟"],"usage":"作谓语、宾语、状语；用于做事的决心","story":["秦朝末年，秦王派大将章邯带20万大军进攻诸侯国赵国，赵王派人向楚王求援，楚王让宋义挂帅，项羽辅佐率军救援，宋义故意拖延时机，项羽杀了宋义并率军渡过漳水去援赵，他们把锅砸了，把船沉入江底，作生死决战，终于击败秦军"]},{"id":28415,"word":"沉著痛快","pinyin":"chén zhù tòng kuài","abbr":"cztk","explanation":"坚劲而流利，遒劲而酣畅。形容诗文、书法遒劲流利。","source":{"text":"吴人皇象能草，世称沉著痛快。","book":"《法书要录》卷一引南朝·宋·羊欣《采古来能书人名》"},"similar":["沉着痛快"],"usage":"作谓语、宾语；用于作品等"},{"id":28416,"word":"沉谋研虑","pinyin":"chén móu yán lǜ","abbr":"cmyl","explanation":"指计划周密，考虑详尽。","source":{"text":"不亲烦务，而专以沉谋研虑，将以鼓舞天下之民，以行乎事业也。","book":"宋·苏舜钦《复辨》"},"similar":["沉谋重虑"],"usage":"作谓语、宾语；用于处事"},{"id":28417,"word":"沉谋重虑","pinyin":"chén móu chóng lǜ","abbr":"cmcl","explanation":"指计划周密，考虑详尽。","source":{"text":"是沉谋重虑，制胜万里，师徒不劳，兵矢未折，功莫伟焉。","book":"清·陆以湉《冷庐杂识·阮文达公拟疏》"},"similar":["沉谋研虑"],"usage":"作谓语、宾语；用于处事"},{"id":28418,"word":"沉迷不悟","pinyin":"chén mí bù wù","abbr":"cmbw","explanation":"形容不知觉悟。","example":{"text":"赌博已使他倾家荡产，他却依然～，无法自拔。"},"similar":["执迷不悟"],"usage":"作谓语、定语；指坚持错误"},{"id":28419,"word":"沉郁顿挫","pinyin":"chén yù dùn cuò","abbr":"cydc","explanation":"郁：低沉郁积。指诗文的风格深沉蕴籍，语势有停顿转折。","source":{"text":"至于沉郁顿挫，随时敏捷，而扬雄、枚皋之徒，庶可企及也。","book":"唐·杜甫《进雕赋表》"},"example":{"text":"弹《湘妃怨》一曲，～，如泣如诉。","book":"清·百一居士《壶天录》上卷"},"similar":["抑扬顿挫"],"usage":"作谓语、定语；形容诗文抑扬顿挫"},{"id":28420,"word":"沉重寡言","pinyin":"chén zhòng guǎ yán","abbr":"czgy","explanation":"朴实稳重，不爱多说话。同“沉重少言”。","source":{"text":"同甫夜思，幼安沉重寡言，因酒误发，若醒而悟，必杀我灭口。","book":"明·朱国祯《涌幢小品·陈同甫谈兵》"},"similar":["沉厚寡言","沉重少言"],"opposite":["口若悬河"],"usage":"作谓语、定语；用于人言语不多"},{"id":28421,"word":"沉重少言","pinyin":"chén zhòng shǎo yán","abbr":"czsy","explanation":"朴实稳重，不爱多说话。亦作“沉厚寡言”、“沉重寡言”。","source":{"text":"少有父风，颇览书传。沉重少言，宽和好士。","book":"《魏书·道武七王传·河南王曜传》"},"similar":["沉重寡言","沉厚寡言"],"opposite":["口若悬河"],"usage":"作谓语、定语；用于人言语不多"},{"id":28422,"word":"沉雄古逸","pinyin":"chén xióng gǔ yì","abbr":"cxgy","explanation":"沉雄：深沉雄健；逸：超迈。形容书画风格沉毅雄健，古朴飘逸。","source":{"text":"与时敏砥砺画学，以董源、巨然为宗，沉雄古逸，虽青绿重色，书味盎然。","book":"《清史稿·王时敏传》"},"usage":"作谓语、定语；用于书画等"},{"id":28423,"word":"沉雄悲壮","pinyin":"chén xióng bēi zhuàn","abbr":"cxbz","explanation":"沉雄：深沉雄健。指深沉雄健，悲壮有力。","source":{"text":"白仁甫秋夜语梧桐雨剧，沉雄悲壮为元曲冠冕。","book":"王国维《人间词话》"},"usage":"作宾语、定语；用于作品等"},{"id":28424,"word":"沉静寡言","pinyin":"chén jìng guǎ yán","abbr":"cjgy","explanation":"性格深沉文静，不爱多说话。","source":{"text":"沉静而寡言，多稽而险貌，曰质貌者也。","book":"《逸周书·官人解》"},"example":{"text":"公子～，少挺易操，河东侯器其贤。","book":"唐·牛肃《纪闻·牛腾》"},"similar":["沉默寡言"],"opposite":["口若悬河"],"usage":"作谓语、定语；指人话语不多"},{"id":28425,"word":"沉鱼落雁","pinyin":"chén yú luò yàn","abbr":"cyly","explanation":"鱼见之沉入水底，雁见之降落沙洲。形容女子容貌美丽。","source":{"text":"毛嫱、丽姬，人之所美也；鱼见之深入，鸟见之高飞，麋鹿见之决骤，四者孰知天下之正色哉？","book":"《庄子·齐物论》"},"example":{"text":"他二人长的一个是～之容，一个是闭月羞花之貌。","book":"清·李宝嘉《官场现形记》第十二回"},"similar":["闭月羞花","花容月貌","国色天香"],"usage":"作谓语、宾语、定语；形容女子极其美丽动人","story":["春秋时期，越国倾国倾城的美女西施在故乡溪边浣纱时，溪中游动的鱼儿见了她都羞愧得沉入水底，不敢浮出水面。汉元帝时绝色美女王昭君在她出塞嫁给匈奴王时，天空飞过的大雁惊讶她的美丽，忘了飞行跌落到树林里"]},{"id":28426,"word":"沉默不语","pinyin":"chén mò bù yǔ","abbr":"cmby","explanation":"指一言不发。","source":{"text":"他沉默不语了。他知道父亲说得对。","book":"路遥《平凡的世界》第一卷第11章"},"similar":["沉默不言","沉默寡言"],"opposite":["喋喋不休"],"usage":"作谓语、定语、状语；用于处事"},{"id":28427,"word":"沉默寡言","pinyin":"chén mò guǎ yán","abbr":"cmgy","explanation":"沉默：不出声；寡：少。不声不响，很少说话。","source":{"text":"梁崇义，长安人，以升斗给于市，有臀力，能卷金舒钩。后为羽林射生，从来瑱于襄阳，沉默寡言，众悦之，累迁为偏裨。","book":"《旧唐书·梁崇义传》"},"example":{"text":"～，深沉不露，令我忆君之丰采。","book":"陈毅《哭叶军长希夷同志》诗"},"similar":["默不做声","沉吟不语","默默无言"],"opposite":["夸夸其谈","口若悬河","喋喋不休"],"usage":"作谓语、宾语、定语；形容人性格沉稳","story":["唐朝时期，长安人梁崇义投奔平定“安史之乱”的名将来瑱，跟随他到襄阳。他在军中沉默寡言，人们认为他沉稳，逐渐升迁到偏将地位。来瑱被诬陷后，群龙无首，大家推举他为首领，不久朝廷正式封他为节度使"]},{"id":28428,"word":"沐仁浴义","pinyin":"mù rén yù yì","abbr":"mryy","explanation":"指受仁义的熏陶。","source":{"text":"自《宋史》创立道学之徒，以尊濂、洛、关、闽诸贤，一时从其游者，罔非沐仁浴义，暗然为心性之谋，何其盛也。","book":"清·吴定《示诸生书》"},"usage":"作宾语、定语；用于书面语"},{"id":28429,"word":"沐日浴月","pinyin":"mù rì yù yuè","abbr":"mryy","explanation":"指受日月光华的润泽。","source":{"text":"，妖气尽豁，脱履人间，天高地阔。","book":"传说禹登南岳，获金简玉字之书，有文曰：“祝融司方发其英，沐日浴月百宝生。”《花月痕》第四九回"},"example":{"text":"～百宝光，轻生七尺何昂藏。","book":"清·秋瑾《宝刀歌》"},"usage":"作谓语、定语；指受恩惠"},{"id":28430,"word":"沐浴膏泽","pinyin":"mù yù gāo zé","abbr":"mygz","explanation":"沐浴；比喻身受润泽；膏泽：恩泽。指身受别人的恩惠。","source":{"text":"佚能思切，安能惟始，沐浴膏泽而歌泳勤苦，非大德谁能如斯。","book":"《孟子·离娄下》：“谏行言听，膏泽下于民。”《史记·乐书》"},"example":{"text":"臣等～，咏歌升平。幸以髡髦之微，得参舞羽之末。敢干宸听，伏俟俞音。","book":"宋·苏轼《小儿致语》"},"usage":"作谓语、宾语；指受恩惠"},{"id":28431,"word":"沐猴冠冕","pinyin":"mù hóu guàn miǎn","abbr":"mhgm","explanation":"沐猴：猕猴；冠：戴帽子。猴子穿衣戴帽，究竟不是真人。比喻虚有其表，形同傀儡。常用来讽刺投靠恶势力窃据权位的人。","source":{"text":"人言楚人沐猴而冠耳，果然。","book":"《史记·项羽本纪》"},"example":{"text":"我骂你个～，牛马襟裙。","book":"元·石君宝《秋胡戏妻》第三折"},"similar":["沐猴而冠","木猴而冠","沐猴衣冠"],"usage":"作谓语、定语、宾语；指人面兽心的人"},{"id":28432,"word":"沐猴而冠","pinyin":"mù hóu ér guàn","abbr":"mheg","explanation":"沐猴：猕猴；冠：戴帽子。猴子穿衣戴帽，究竟不是真人。比喻虚有其表，形同傀儡。常用来讽刺投靠恶势力窃据权位的人。","source":{"text":"人言楚人沐猴而冠耳，果然。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"丰私家之积，此～尔，尚焉足道哉！","book":"《晋书·张载传》"},"similar":["衣冠禽兽","沐猴衣冠"],"usage":"作谓语、定语、状语；指人面兽心的人","story":["秦朝末年，刘邦、项羽、楚怀王三人约定，谁先攻入咸阳谁就做关中王。刘邦先攻进咸阳，项羽很不高兴，进城就杀百姓及已投降的国王子婴，放火烧了阿房宫，掠夺大量金银财宝准备回江东地区。有人在背后讥讽楚国人是戴着帽子的猴子"]},{"id":28433,"word":"沐猴衣冠","pinyin":"mù hóu yī guàn","abbr":"mhyg","explanation":"比喻虚有其表，形同傀儡。常用来讽刺投靠恶势力窃据权位的人。同“沐猴而冠”。","source":{"text":"人言楚人沐猴而冠耳，果然。","book":"《史记·项羽本纪》"},"example":{"text":"你这等人，乃～之辈，马牛马襟裙之材。","book":"明·无名氏《十探子》第二折"},"similar":["沐猴而冠","木猴而冠","沐猴冠冕"],"usage":"作谓语、定语、宾语；指人面兽心的人"},{"id":28434,"word":"沐雨栉风","pinyin":"mù yǔ zhì fēng","abbr":"myzf","explanation":"沐：洗头发；栉：梳头发。风梳发，雨洗头。形容人经常在外面不避风雨地辛苦奔波。","source":{"text":"腓无胈，胫无毛，沐甚雨，栉疾风。","book":"《庄子·天下》"},"example":{"text":"戎旗既建，出镇寿阳，驱其豺狼，剪其荆棘，收罗向义，广开屯田，～，等勤台仆。","book":"《晋书·诸葛恢传》"},"similar":["饱经风霜","沐雨梳风"],"usage":"作谓语、定语；形容饱经风霜，劳苦奔波"},{"id":28435,"word":"沐雨梳风","pinyin":"mù yǔ shū fēng","abbr":"mysf","explanation":"形容人经常在外面不避风雨地辛苦奔波。同“沐雨栉风”。","source":{"text":"农夫力田望秋至，沐雨梳风尽劳瘁。","book":"明·刘基《野田黄雀行》"},"similar":["沐雨栉风"],"usage":"作谓语、定语；形容饱经风霜，劳苦奔波"},{"id":28436,"word":"沐雨经霜","pinyin":"mù yǔ jīng shuāng","abbr":"myjs","explanation":"指承受雨淋霜打。形容历尽辛苦。","source":{"text":"还想我沐雨经霜，身中锁甲，手里沉枪。","book":"明·屠隆《昙花记·云游遇师》"},"example":{"text":"披星戴月无嫌苦，～不厌辛。","book":"《太平天国·天情道理书》"},"similar":["沐露梳风"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28437,"word":"沐露梳风","pinyin":"mù lù shū fēng","abbr":"mlsf","explanation":"指受风露轻拂、浸润。","source":{"text":"半含欲吐不胜情，沐露梳风睡明月。","book":"宋·王十朋《郡圃无海棠买数根植之》诗"},"similar":["风餐露宿","沐雨梳风"],"usage":"作宾语、定语；多用于旅行生活"},{"id":28438,"word":"沐露沾霜","pinyin":"mù lù zhān shuāng","abbr":"mlzs","explanation":"形容饱经霜露辛苦。","source":{"text":"因公入务，怀书将相之门；沐露沾霜，拥箒公侯之门。","book":"唐·王勃《为人与蜀城父老书》"},"similar":["沐露梳风"],"usage":"作宾语、定语；多用于旅行生活"},{"id":28439,"word":"沓冈复岭","pinyin":"tà gāng fù lǐng","abbr":"tgfl","explanation":"指冈峦重沓。"},{"id":28440,"word":"沓来踵至","pinyin":"tǎ lái zhǒng zhì","abbr":"tlzz","explanation":"指纷纷到来。亦作“踏来麕至”。","source":{"text":"倘敢抗违不遵，即照前札或用炮轰击，或用火烧，务使创巨痛深，始免沓来踵至。","book":"清林则徐《札南澳镇饬严办东路贩烟外国船只》"},"example":{"text":"至难至险之现象，踏来麕至。","book":"梁启超《匈牙利爱国者噶苏士传·匈国之内乱及其原因》"},"similar":["纷至沓来"],"usage":"作谓语、定语；指纷纷到来"},{"id":28441,"word":"沓来麕至","pinyin":"tà lái yǒu zhì","abbr":"tljz","explanation":"指纷纷到来。同“沓来踵至”。","source":{"text":"至难至险之现象，沓来麕至。","book":"梁启超《匈牙利爱国者噶苏士传·匈国之内乱及其原因》"},"similar":["沓来踵至"],"usage":"作谓语、定语；指纷纷到来"},{"id":28442,"word":"沙上建塔","pinyin":"shā shàng jiàn tǎ","abbr":"ssjt","explanation":"比喻基础极不牢固。","example":{"text":"我想，但倘不将这些改革，则这革命即等于无成，如～，顷刻倒坏。","book":"鲁迅《二心集·习惯与改革》"}},{"id":28443,"word":"沙里淘金","pinyin":"shā lǐ táo jīn","abbr":"sltj","explanation":"淘：用水冲洗，滤除杂质。从沙里淘出黄金。比喻好东西不易得。也比喻做事费力大而收效少。也比喻从大量的材料里选择精华。","source":{"text":"我之为我，如灰中金，而不若矿沙之金。破矿得金，淘沙得金，扬灰终身，无得金也。","book":"《关尹子》六七"},"example":{"text":"恰便似～。","book":"元·杨景贤《刘行首》第三折"},"similar":["去粗取精","去伪存真"],"opposite":["泥沙俱下","鱼龙混杂"],"usage":"作宾语、定语；形容工作困难"},{"id":28444,"word":"沙鸥翔集","pinyin":"shā ōu xiáng jí","abbr":"soxj","explanation":"水鸟时而飞翔，时而聚集。"},{"id":28445,"word":"沛雨甘霖","pinyin":"pèi yǔ gān lín","abbr":"pygl","explanation":"充足而甘美的雨水。比喻恩泽深厚。","source":{"text":"情浓意长，情浓意长，沛雨甘霖，憔悴生香。","book":"明·无名氏《四贤记》第二十八出"},"usage":"作主语、宾语、定语；指风调雨顺"},{"id":28446,"word":"沟中之瘠","pinyin":"gōu zhōng zhī jí","abbr":"gzzj","explanation":"瘠：腐烂的肉。指因贫困而流落荒野或死于沟壑的人。","source":{"text":"是规磨之说也，沟中之瘠也，则未足与及王者之制也。","book":"《荀子·正论》"},"example":{"text":"怀市井锥刀之心，背先圣立人之教，～，宁复挂念。","book":"明·袁宏道《良乡三教寺记》"},"similar":["沟中瘠"],"usage":"作宾语、定语；用于比喻句"},{"id":28447,"word":"沟中瘠","pinyin":"gōu zhōng jí","abbr":"gzj","explanation":"瘠：通“胔”，没有完全腐烂的尸体。暴露在山沟的尸体。指因贫困而死无葬身之地的人。","source":{"text":"瘠：通“胔”，没有完全腐烂的尸体。暴露在山沟的尸体。指因贫困而死无葬身之地的人。"},"example":{"text":"宋·文天祥《正气歌》：“一朝蒙雾露，分作沟中瘠。”"},"similar":["沟中之瘠"],"usage":"作宾语、定语；用于比喻句"},{"id":28448,"word":"沟沟坎坎","pinyin":"gōu gōu kǎn kǎn","abbr":"ggkk","explanation":"难走的地方，比喻做事时所遇到的困难与障碍。","example":{"text":"人生道路上难免会有许多～的。"},"similar":["坎坷不平"],"usage":"作宾语、定语；指困难与障碍"},{"id":28449,"word":"沟深垒高","pinyin":"gōu shēn lěi gāo","abbr":"gslg","explanation":"沟：壕沟；垒：堡垒。深挖沟和高筑墙。指坚固的防御工事。","source":{"text":"沟深垒高，不得以为固；甲坚兵利，不得以为强。","book":"战国·齐·孙膑《孙膑兵法·客主人兮》"},"similar":["深沟高垒"],"usage":"作宾语、定语；指坚固的防御工事"},{"id":28450,"word":"沟满壕平","pinyin":"gōu mǎn háo píng","abbr":"gmhp","explanation":"形容饱满。","source":{"text":"见他们一个个蹲在地下，吃了个狼餐虎咽，沟满壕平。","book":"清·文康《儿女英雄传》第十四回"}},{"id":28451,"word":"沟满濠平","pinyin":"gōu mǎn háo píng","abbr":"gmhp","explanation":"濠：护城河。形容填满所有的空隙。","source":{"text":"见他们一个个蹲在地下，吃了个狼餐虎咽，沟满壕平。","book":"清·文康《儿女英雄传》第14回"},"example":{"text":"一场暴雨下来，到处是～。"},"similar":["濠平沟满"],"usage":"作谓语、宾语；形容饱满"},{"id":28452,"word":"没三没四","pinyin":"méi sān méi sì","abbr":"msms","explanation":"不三不四，行为不端正。","source":{"text":"还有几个没三没四帮闲的，专一在街上寻些空头事过日子。","book":"明·凌濛初《初刻拍案惊奇》第31卷"},"similar":["不三不四"],"usage":"作谓语、定语、补语；形容人的品行不好"},{"id":28453,"word":"没上没下","pinyin":"méi shàng méi xià","abbr":"msmx","explanation":"不分尊卑长幼，没有礼貌。","source":{"text":"再者也没刚柔，有时见了我们，喜欢时没上没下，大家乱顽一阵；不喜欢各自走了，他也不理人。","book":"清·曹雪芹《红楼梦》第66回"},"example":{"text":"我不许你～。"},"similar":["没大没小"],"opposite":["彬彬有礼"],"usage":"作谓语、定语、宾语；指没有礼貌","story":["贾琏经贾珍贾蓉父子的撮合，私自在外娶了贾珍的二姨妹尤二姐为二奶，过起了夫妻生活。有时贾琏不能自己去，就派家人去送东西。尤二姐向小童兴儿打听贾府宝玉的情况，兴儿说宝玉高兴时就没上没下与下人玩，不高兴时就谁也不理"]},{"id":28454,"word":"没世不忘","pinyin":"mò shì bù wàng","abbr":"msbw","explanation":"没世：死。一辈子也忘不了。","source":{"text":"君子贤其贤而亲其亲，小人乐其乐而利其利。此以没世不忘也。","book":"《礼记·大学》"},"example":{"text":"故大将军正义愍公毓，临节能固，捐生殉国，成为令典，～。","book":"《隋书·豆毓传》"},"similar":["没齿不忘","刻骨铭心"],"usage":"作谓语；用于书面语"},{"id":28455,"word":"没世不渝","pinyin":"méi shì bù yú","abbr":"msby","explanation":"指终身不变。","source":{"text":"一直到鲁迅的病殁，蔡元培是尽了没世不渝的友谊的。","book":"郭沫若《历史人物·鲁迅与王国维》"},"similar":["忠贞不渝"],"usage":"作谓语、定语；指不改变"},{"id":28456,"word":"没世无称","pinyin":"méi shì wú chēng","abbr":"mswc","explanation":"死后名声不能为人所颂扬。指死后没有名声，不为人所知。亦作“没世无闻”。","source":{"text":"君子疾没世而名不称焉。","book":"《论语·卫灵公》"},"example":{"text":"《论语·卫灵公》：“君子疾没世而名不称焉。”"},"similar":["没世无闻"],"usage":"作谓语、定语；指十分没有名气"},{"id":28457,"word":"没世无闻","pinyin":"méi shì wú wén","abbr":"msww","explanation":"指终身不为人知。","source":{"text":"如微才弗试，没世无闻，徒荣其躯而丰其体，生无益于事，死无损于数。","book":"《论语·卫灵公》：“君子疾没世而名不称焉。”三国·魏·曹植《《求自试表》》"},"example":{"text":"何不弃终南山而保朕躬，官居愿爵，扬名於後世，岂不美哉！何苦甘为淡泊，～？","book":"明·许仲琳《封神演义》第五回"},"similar":["没世无称","默默无闻"],"opposite":["赫赫有名","大名鼎鼎"],"usage":"作谓语、定语；指十分没有名气"},{"id":28458,"word":"没世穷年","pinyin":"méi shì qióng nián","abbr":"msqn","explanation":"犹终生，一辈子。","source":{"text":"以可知人之性，求可以知物之理，而无所疑止之。则没世穷年不能遍也。","book":"《荀子·解蔽》"},"example":{"text":"大学八者条目，若必待行得一节了，旋进一节，则～，亦做不彻。","book":"宋·朱熹《朱子语类·大学二》"},"usage":"作定语、状语；指一辈子"},{"id":28459,"word":"没世难忘","pinyin":"mò shì nán wàng","abbr":"msnw","explanation":"没世：死。一辈子也忘不了。","source":{"text":"君子贤其贤而亲其亲，小人乐其乐而利其利。此以没世不忘也。","book":"《礼记·大学》"},"example":{"text":"惟在深入其心，斯～，而穆然足千古也。","book":"清·李棒阊《守一斋笔记·副戎传》"},"similar":["没齿难泯","没身不忘"],"usage":"作谓语、定语；指终身不能忘记"},{"id":28460,"word":"没事找事","pinyin":"méi shì zhǎo shì","abbr":"mszs","explanation":"指故意找借口滋事。","source":{"text":"是阿兰姐和她男人厉害，没事找事，脑筋动到了我头上。","book":"高阳《胡雪岩全传·平步青云》中册"},"example":{"text":"你不要～，挑起事端。"},"similar":["故意找茬"],"usage":"作谓语、宾语；指自找麻烦"},{"id":28461,"word":"没仁没义","pinyin":"méi rén méi yì","abbr":"mrmy","explanation":"没有一点仁义。","source":{"text":"似你这般没仁没义的，死了一个，又讨一个，出了一个，又纳一个。","book":"明·冯梦龙《警世通言》卷二"},"example":{"text":"明·冯梦龙《警世通言》卷二：“似你这般没仁没义的，死了一个，又讨一个，出了一个，又纳一个。”"},"usage":"作谓语、定语；用于人"},{"id":28462,"word":"没偏没向","pinyin":"méi piān méi xiàng","abbr":"mpmx","explanation":"指为人公正无私。","source":{"text":"我就怕你挑眼，先把话说明，没偏没向。","book":"清·石玉昆《小五义》第19回"},"example":{"text":"我这样做就是～。"},"similar":["不偏不倚"],"usage":"作谓语、定语、宾语；指为人公正"},{"id":28463,"word":"没卫饮羽","pinyin":"méi wèi yǐn yǔ","abbr":"mwyy","explanation":"指连箭的翎都射没在物体中。极言射力之大。","source":{"text":"儒书之言楚熊渠子、养由基、李广射寝石，矢没卫饮羽者，皆增之也。","book":"汉·王充《论衡·儒增》"},"similar":["没金饮羽","没石饮羽"],"usage":"作定语；指箭术高明"},{"id":28464,"word":"没可奈何","pinyin":"méi kě nài hé","abbr":"mknh","explanation":"指没有办法，无计可施。","source":{"text":"清早是死不起床的，点名时监学向床上去拉他，也拉他不动，监学把他也没可奈何。","book":"郭沫若《反正前后》第一篇"},"example":{"text":"他～的走了。"},"similar":["没法奈何"],"usage":"作谓语、定语；指无计可施"},{"id":28465,"word":"没嘴的葫芦","pinyin":"méi zuǐ dé hú lú","abbr":"mzdhl","explanation":"没有嘴的葫芦。比喻不善言谈或说话很少的人。","source":{"text":"浑身是口怎支吾，恰似个没嘴的葫芦。","book":"元·关汉卿《蝴蝶梦》第二折"}},{"id":28466,"word":"没嘴葫芦","pinyin":"méi zuǐ hú lu","abbr":"mzhl","explanation":"比喻人不爱说话或不善于说话。也指人因某种原因一时说不出话来。","source":{"text":"小小葫芦，生来不大身材矮，子儿在内，无口如何怪。","book":"宋·张继先《点绛唇》词"},"example":{"text":"岂知几个耆民，在乡下时，虽然众人见了他们惟命是听，及至他们见了官，亦变成了～。","book":"清·李宝嘉《官场现形记》第十五回"},"usage":"作宾语；用于不爱说话的人"},{"id":28467,"word":"没大没小","pinyin":"méi dà méi xiǎo","abbr":"mdmx","explanation":"指不分长幼，不遵礼法。","source":{"text":"恁不合理的行货子，先生把个丫头惯得恁没大没小，上头上脸的，还嗔人说哩。","book":"明·兰陵笑笑生《金瓶梅词话》第七十五回"},"example":{"text":"做人不能～的。"},"similar":["长幼不分","没规没矩"],"opposite":["尊老爱幼"],"usage":"作谓语、定语、宾语；常用于口语"},{"id":28468,"word":"没头官司","pinyin":"méi tóu guān sī","abbr":"mtgs","explanation":"官司：诉讼。没有头绪或没有尽头的官司。","source":{"text":"今年造物不可言，争头鼓脑要当先，铫期若还杀了我，我和他没头没脑官司打几年。","book":"明·无名氏《大战邳彤》第三折"},"example":{"text":"你却与小娘子杀了人，拐了钱财，盗了妇女，同往他乡，却连累我地方邻里打～。","book":"明·冯梦龙《醒世恒言》卷三十三"},"similar":["无头公案"],"usage":"作主语、宾语、定语；用于纠纷等"},{"id":28469,"word":"没头没脑","pinyin":"méi tóu méi nǎo","abbr":"mtmn","explanation":"头、脑：比喻线索或根由。毫无线索或没有根由。","source":{"text":"而今说一个人，在实地上行，步步不着，极贫极苦的，却在渺渺茫茫、做梦不到的去处，得了一注没头没钱财，变成了巨富。","book":"明·凌濛初《初刻拍案惊奇》卷一"},"example":{"text":"这些人虽常在这里，却是散在各处，这一会～，往哪里去捉？（清·吴敬梓《儒林外史》第二十八回）"},"similar":["无缘无故","糊里糊涂","呆头呆脑"],"opposite":["有头有脑","有条不紊"],"usage":"作宾语、定语；指毫无线索或没有根由"},{"id":28470,"word":"没头没脸","pinyin":"méi tóu méi liǎn","abbr":"mtml","explanation":"指不顾脸面或不顾一切，狠狠；也满头满脸。","source":{"text":"那道士闻得此言，拦住门，一齐动叉钯、扫帚、瓦块、石头，没头没脸，往里面乱打。","book":"明·吴承恩《西游记》第45回"},"example":{"text":"咱们得有点身价，以后不准你～地去撩骚。","book":"陈登科《破壁记》第五章"},"similar":["劈头盖脸"],"opposite":["有头有脸"],"usage":"作谓语、定语；指不顾一切"},{"id":28471,"word":"没头苍蝇","pinyin":"méi tóu cāng ying","abbr":"mtcy","explanation":"比喻乱闯乱碰的人。","source":{"text":"上年往东京买卖，与那个没头苍蝇牛信曾相认识。","book":"清·俞万春《荡寇志》第97回"},"example":{"text":"没有训练的部队是乌合之众，不讲战术的指挥员是～。","book":"《刘伯承回忆录·治军必先治校》"},"similar":["无头苍蝇"],"usage":"作宾语、定语；指莽撞的人"},{"id":28472,"word":"没完没了","pinyin":"méi wán méi liǎo","abbr":"mwml","explanation":"无穷尽。","source":{"text":"没完没了的苛捐杂税不算，还他妈的乱抢乱夺。","book":"郭澄清《大刀记》第二章"},"example":{"text":"他总是～地缠着我。"},"similar":["无休无止"],"opposite":["到此为止"],"usage":"作谓语、状语、定语；指无穷尽","story":["清朝咸丰年间，李鸿章因为同英法签订《北京条约》，受到慈禧太后的重用，他组建清朝的海军，从日本人那里得到一条游船，送到昆明湖，湖水太浅，李鸿章命人再修建一个更大的湖泊及宫殿，老百姓说“李鸿章修致敬阁——没完”"]},{"id":28473,"word":"没家亲引不出外鬼来","pinyin":"méi jiā qīn yǐn bù chū wài guǐ lái","abbr":"mjqybcwgl","explanation":"指如果没有自己人从中捣鬼就不会引来外人捣乱。","source":{"text":"指如果没有自己人从中捣鬼就不会引来外人捣乱。"},"usage":"作宾语、定语；用于口语"},{"id":28474,"word":"没屋架梁","pinyin":"méi wū jià liáng","abbr":"mwjl","explanation":"比喻无中生有。","source":{"text":"更有一等狠心肠的人，偏要从家门首打墙脚起：诈害亲戚，侵占乡里，受投献，窝盗贼，无风起浪，没屋架梁。","book":"明·凌濛初《二刻拍案惊奇》第四卷"},"usage":"作宾语、定语；用于处事"},{"id":28475,"word":"没巧不成话","pinyin":"méi qiǎo bù chéng huà","abbr":"mqbch","explanation":"无巧不成书。指非常凑巧。","source":{"text":"自古道：‘没巧不成话。’这妇人手里拿叉杆不牢，失手滑将倒去，不端不正，恰好打在那人头巾上。","book":"明·施耐庵《水浒传》第23回"},"similar":["无巧不成书"],"usage":"作宾语、分句；同“无巧不成书”"},{"id":28476,"word":"没心没想","pinyin":"méi xīn méi xiǎng","abbr":"mxmx","explanation":"精神不集中。","source":{"text":"方才喝礼时节，看他没心没想，两眼只看着新人。","book":"明·凌濛初《二刻拍案惊奇》第25卷"},"usage":"作谓语、定语、状语；用于人的思想"},{"id":28477,"word":"没心没绪","pinyin":"méi xīn méi xù","abbr":"mxmx","explanation":"没有心思与情绪。","source":{"text":"袭人等每日提心吊胆，宝玉也好几天不上学，只是怔怔的，不言不语，没心没绪的。","book":"清·曹雪芹《红楼梦》第95回"},"usage":"作谓语、定语、状语；用于人的心情"},{"id":28478,"word":"没心没肺","pinyin":"méi xīn méi fèi","abbr":"mxmf","explanation":"没心眼儿，不用心。或指没心肝，没良心。","source":{"text":"假若老二没心没肺的赞同此意呢？她也会只去此一遭，下不为例。","book":"老舍《四世同堂》"},"example":{"text":"我说你怎么这么～的！"},"similar":["没心没肝"],"opposite":["菩萨心肠"],"usage":"作谓语、定语；指人没良心"},{"id":28479,"word":"没情没绪","pinyin":"méi qíng méi xù","abbr":"mqmx","explanation":"情绪低落的样子。","source":{"text":"崔宁到家中，没情没绪，走进房中，只见浑家坐在床上。","book":"《京本通俗小说·碾玉观音》"},"example":{"text":"随即进到珍哥房内，～，垂了头坐在椅上。","book":"清·西周生《醒世姻缘传》第二回"},"similar":["没撩没乱"],"usage":"作谓语、定语；用于人的情绪"},{"id":28480,"word":"没撩没乱","pinyin":"méi liáo méi luàn","abbr":"mlml","explanation":"指没有情绪。","source":{"text":"过了两三日，众多闲汉都来伺候，见衙内心焦，没撩没乱，众人散了。","book":"明·施耐庵《水浒传》第七回"},"usage":"作谓语、定语；指没有情绪"},{"id":28481,"word":"没斤没两","pinyin":"méi jīn méi liǎng","abbr":"mjml","explanation":"没有大小、份量。指人做事不分轻重。","example":{"text":"你这样～的做法让人难以接受。"},"similar":["不知轻重","没轻没重"],"usage":"作谓语、定语；用于指责人"},{"id":28482,"word":"没日没夜","pinyin":"méi rì méi yè","abbr":"mrmy","explanation":"犹言不分白天夜晚。","source":{"text":"所以缫丝一定是一家大小动手，没日没夜赶完为止。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"他让省里科研所请去了，正～地写书哪！"},"similar":["夜以继日","非日非月"],"usage":"作定语、状语；指不分昼夜干事"},{"id":28483,"word":"没有说的","pinyin":"méi yǒu shuō de","abbr":"mysd","explanation":"指没有可以指责的缺点。或指不成问题，没有申说的必要。","example":{"text":"他思想进步，工作积极，真是～。"},"usage":"作谓语、定语；指不成问题"},{"id":28484,"word":"没查没利","pinyin":"méi chá méi lì","abbr":"mcml","explanation":"指言语不实。"},{"id":28485,"word":"没根没据","pinyin":"méi gēn méi jù","abbr":"mgmj","explanation":"指没有依据的事物或论点。","example":{"text":"你这～的话有谁信？"},"similar":["无凭无据"],"opposite":["有理有据"],"usage":"作谓语、状语、定语；用于口语"},{"id":28486,"word":"没毛大虫","pinyin":"méi máo dà chóng","abbr":"mmdc","explanation":"没有毛的老虎。比喻凶猛的人或事物。","source":{"text":"这一把无情毒火，岂非是没毛大虫。","book":"元·无名氏《货郎旦》第一折"},"example":{"text":"分兵左右迎敌，那里当得起这班～，声若翻江，势如倒海。","book":"清·钱采《说岳全传》第34回"},"similar":["衣冠禽兽"],"usage":"作宾语、定语；指恶人"},{"id":28487,"word":"没没无闻","pinyin":"mò mò wú wén","abbr":"mmww","explanation":"无声无息，没人知道。指没有什么名声。","source":{"text":"仆虽无无，非志不立，故疾没世而无闻焉。","book":"《晋书·祖纳传》"},"example":{"text":"你我要是见的到此，虽不能和大帅一般威震四海，也不致～了。","book":"蔡东藩、许廑父《民国通俗演义》第一三三回"},"similar":["默默无闻","漠漠无闻"],"opposite":["赫赫有名"],"usage":"作谓语、定语、状语；指不为人所知"},{"id":28488,"word":"没法奈何","pinyin":"méi fǎ nài hé","abbr":"mfnh","explanation":"指没有办法，无计可施。","source":{"text":"所以那些没法奈何的人，我想都将向这三条路里躲了进去。","book":"朱自清《那里走·我们的路》"},"example":{"text":"他对我～。"},"similar":["没可奈何"],"usage":"作谓语、定语；指无可奈何"},{"id":28489,"word":"没法没天","pinyin":"méi fǎ méi tiān","abbr":"mfmt","explanation":"旧指不顾国法和天理，任意干坏事。现多形容违法乱纪，不受管束。","source":{"text":"你是那里的这么个横强盗，这样没法没天的！我偏要打这里走。","book":"清·曹雪芹《红楼梦》第一百十回"},"similar":["无法无天"],"opposite":["安分守己"],"usage":"作谓语、定语、补语；指违法乱纪"},{"id":28490,"word":"没深没浅","pinyin":"méi shēn méi qiǎn","abbr":"msmq","explanation":"言行没分寸。","example":{"text":"小孩子不懂事，说话～，请多原谅。"},"similar":["不知深浅"],"usage":"作定语、状语；指没分寸"},{"id":28491,"word":"没皮没脸","pinyin":"méi pí méi liǎn","abbr":"mpml","explanation":"不知羞耻，不要脸面。","source":{"text":"你怎么那么没皮没脸？闯到人家里来了？","book":"王朔《刘慧芳》"},"example":{"text":"你还眯嘻眯嘻笑，别那么～的。"},"similar":["没脸没皮"],"usage":"作谓语、定语；指不知羞耻"},{"id":28492,"word":"没眉没眼","pinyin":"méi méi méi yǎn","abbr":"mmmy","explanation":"眉目不清，形容一塌糊涂的样子。也指没有脸面。","source":{"text":"上面是扳鳌抓角的桥亭，已经多年没有修理，金碧彩画全着尘土糊得没眉没眼。","book":"李劼人《大波》第二部第五章"},"example":{"text":"仿佛他自己在北斗镇对待什么～的脚色一样。","book":"沙汀《淘金记》"},"usage":"作定语、状语；指没有脸面"},{"id":28493,"word":"没石饮羽","pinyin":"méi shí yǐn yǔ","abbr":"msyy","explanation":"后用以喻指功力精湛。","source":{"text":"汉李广出猎，见草中石，以为虎而射之，箭入石，箭翎也隐没不见。事见《史记·李将军列传》。"},"similar":["没金饮羽"],"usage":"作定语；指箭术高明"},{"id":28494,"word":"没精塌彩","pinyin":"méi jīng tā cǎi","abbr":"mjtc","explanation":"形容精神不振，情绪低落。同“没精打彩”。"},{"id":28495,"word":"没精打彩","pinyin":"méi jīng dǎ cǎi","abbr":"mjdc","explanation":"形容精神不振，情绪低落。","source":{"text":"王夫人见宝玉没精打彩，也只当是金钏儿昨日之事，他好没意思的。","book":"清·曹雪芹《红楼梦》第31回"},"example":{"text":"就在这样一个昏黑的晚上，我照常～的回来。","book":"鲁迅《彷徨·伤逝》"},"similar":["没精打采"],"opposite":["神采奕奕"],"usage":"作定语、状语；指情绪低落"},{"id":28496,"word":"没精打采","pinyin":"méi jīng dǎ cǎi","abbr":"mjdc","explanation":"采：精神。形容精神不振，提不起劲头。","source":{"text":"贾宝玉满肚疑团，没精打采的归至怡红院中。","book":"清·曹雪琴《红楼梦》第八十七回"},"example":{"text":"欲往别家，已无隙地，不得已，同他瑞三商议。那人才～的开一间房门。","book":"清·刘鹗《老残游记》第一回"},"similar":["精疲力竭","垂头丧气","萎靡不振"],"opposite":["神采奕奕","兴高采烈"],"usage":"作定语、状语；用于口语","story":["妙玉来大观园探望惜春，贾宝玉自作多情要去送妙玉，两人来到弯弯曲曲的园内小路上，听到潇湘馆内传来叮咚的琴声，两人坐在石头上听这凄惨悠扬的琴声，突然琴弦断了。妙玉要回寺庙，弄得宝玉满肚疑团，没精打采地回到怡红院中"]},{"id":28497,"word":"没精没彩","pinyin":"méi jīng méi cǎi","abbr":"mjmc","explanation":"犹没精打彩。形容精神不振，情绪低落。","source":{"text":"犹没精打彩。形容精神不振，情绪低落。"},"similar":["没精打彩"],"opposite":["生气勃勃"],"usage":"作定语、状语；指情绪低落"},{"id":28498,"word":"没羽之虎","pinyin":"mò yǔ zhī hǔ","abbr":"myzh","explanation":"比喻怪石。","source":{"text":"楚能渠子夜行，见寝石，以为伏虎，弯弓而射之，没金饮羽，下视，知其石也。","book":"西汉·韩婴《韩诗外传》第六卷"},"example":{"text":"～行林间，萚龙失职因藏跧。","book":"宋·王安石《酬王浚贤良松泉二诗·泉》"},"usage":"作宾语；用于比喻句"},{"id":28499,"word":"没而不朽","pinyin":"méi ér bù xiǔ","abbr":"mebx","explanation":"没：同“殁”，死。指人的身体虽死，但其精神、业绩、文章永存人间。","source":{"text":"虽没而不朽，书贵垂休名。","book":"《宋书·乐志三》"},"example":{"text":"庄周著论，生也若浮；史佚立言，～。","book":"唐·杨炯《泸州都督王湛神道碑》"},"similar":["殁而不朽"],"usage":"作谓语、定语；指人的名声或功绩等"},{"id":28500,"word":"没脸没皮","pinyin":"méi liǎn méi pí","abbr":"mlmp","explanation":"不知羞耻，不要脸面。","example":{"text":"好一个赵老犟，～，想趁人家言语有失，白拣人家姑娘。"},"similar":["恬不知耻","死不要脸"],"opposite":["死要面子"],"usage":"作谓语、定语；指不要脸面"},{"id":28501,"word":"没衷一是","pinyin":"mò zhōng yī shì","abbr":"mzys","explanation":"衷：折中。指意见纷歧，不能决定哪一方面对。","source":{"text":"就我见闻所及，论者的意见仍属没衷一是。","book":"郭沫若《盲肠炎·一个伟大的教训》"},"similar":["莫衷一是"],"usage":"作谓语、定语；用于书面语"},{"id":28502,"word":"没计奈何","pinyin":"méi jì nài hé","abbr":"mjnh","explanation":"指无法可想。","source":{"text":"他因不忍见你分离，待得你明日出了门才来。这也是我没计奈何，一言为定。","book":"《京本通俗小说·错斩崔宁》"},"example":{"text":"～，我想来，只好还是作这个下流事。","book":"李劼人《暴风雨前》第二部"},"similar":["无计可施"],"usage":"作谓语、定语；指无法可想"},{"id":28503,"word":"没身不忘","pinyin":"mò shēn bù wàng","abbr":"msbw","explanation":"没身：终身。一辈子不能忘记。","source":{"text":"失声而号，痛裂肺肠。何以尉子？没身不忘。","book":"宋·陈亮《众祭孙冲季文》"},"similar":["没世难忘"],"usage":"作谓语、定语；指终身不能忘记"},{"id":28504,"word":"没轻没重","pinyin":"méi qīng méi zhòng","abbr":"mqmz","explanation":"指言语或动作鲁莽。","source":{"text":"那小孩子没轻没重的便说不好了，石师爷的老太太上了吊了。","book":"清·吴趼人《二十年目睹之怪现状》第69回"},"example":{"text":"管秀芬这丫头，打断我们的谈话，～的。","book":"周而复《上海的早晨》第一部"},"similar":["没大没小"],"usage":"作定语、状语；指言语或动作鲁莽"},{"id":28505,"word":"没里没外","pinyin":"méi lǐ méi wài","abbr":"mlmw","explanation":"里外不分，指说话做事不分场合。","source":{"text":"若一味只管没里没外，不与大人争光，凭他生的怎样，也是该打死的。","book":"清·曹雪芹《红楼梦》第56回"},"example":{"text":"他说话～，不分场合。"},"opposite":["内外有别"],"usage":"作宾语、定语；指不分场合","story":["江南甄府派了几个老婆子来贾府送礼拜访，大家相互聊天，她们很想见贾府那个衔着玉出生的贾宝玉，并告知她们甄府也有一个叫宝玉的淘气鬼。贾母十分感兴趣，问长问短。甄府婆子说她们的宝玉刁钻古怪。贾母则说如果处世没里没外的那就不应该了"]},{"id":28506,"word":"没金铩羽","pinyin":"méi jīn shā yǔ","abbr":"mjsy","explanation":"指射箭入石，箭镞和箭杆后的雕翎全都隐没不见。同“没金饮羽”。"},{"id":28507,"word":"没金饮羽","pinyin":"méi jīn yǐn yǔ","abbr":"mjyy","explanation":"指射箭入石，箭镞和箭杆后的雕翎全都隐没不见。","source":{"text":"楚能渠子夜行，见卧石，以为伏虎，弯弓而射之，没金饮羽，下视，知其石也。","book":"《韩诗外传》第六卷"},"similar":["没石饮羽"],"usage":"作定语；指箭术高明","story":["春秋时期，楚国的熊渠子箭术相当精湛。一次从外地赶夜回家，借着月光看见前面好像有一只老虎在蹲着，于是拔出箭来，弯弓一射，正中目标。上前一看，原来虚惊一场，只见箭已经射到石头里，隐没了箭尾的羽毛"]},{"id":28508,"word":"没颜落色","pinyin":"méi yán méi sè","abbr":"myls","explanation":"形容情绪低落。","source":{"text":"你休要没颜落色，休等那霜欺雪盖，愿师父早些儿引度俺到蓬莱！","book":"元·贾仲明《吕洞宾桃柳升仙梦》第一折"},"example":{"text":"我要不起去，一个家～的。","book":"清·西周生《醒世姻缘传》第三回"},"usage":"作定语、状语；用于人的情绪"},{"id":28509,"word":"没颠没倒","pinyin":"méi diān méi dǎo","abbr":"mdmd","explanation":"指没分晓或纷乱的样子。","source":{"text":"你两个都不为年纪老，怎么的便这般没颠没倒，对官司不分个真假，辨个清浊。","book":"元·李行道《灰阑记》第二折"},"example":{"text":"老的小的，村的俏的，～，胜似闹元宵。","book":"元·王实甫《西厢记》第一本第四折"},"usage":"作宾语、定语；指纷乱的样子"},{"id":28510,"word":"没魂少智","pinyin":"méi hún shǎo zhì","abbr":"mhsz","explanation":"智：智慧。形容失魂落魄的样子。","source":{"text":"晃大舍因一连做了两个梦，又兼病了两场，也就没魂少智的。","book":"清·西周生《醒世姻缘传》第四回"},"similar":["失魂落魄"],"usage":"作谓语、定语、状语；同“失魂落魄”"},{"id":28511,"word":"没齿不忘","pinyin":"mò chǐ bù wàng","abbr":"mcbw","explanation":"没齿：终身。一辈子也忘不了。","source":{"text":"长老，你果是救得我回朝，没齿不忘大恩。","book":"明·吴承恩《西游记》第七十回"},"example":{"text":"恩师大德，门生等～。","book":"清·钱彩《说岳全传》第十四回"},"similar":["刻骨铭心","永志不忘"],"opposite":["忘恩负义"],"usage":"作谓语；用于书面语"},{"id":28512,"word":"没齿无怨","pinyin":"mò chǐ wú yuàn","abbr":"mcwy","explanation":"比喻永无怨言。","source":{"text":"夺伯氏骈邑三百饭疏食，没齿无怨言。","book":"春秋·鲁·孔丘《论语·宪问》"},"example":{"text":"固非不当，受命之日，～。","book":"鲁迅《致许寿裳》"},"similar":["死而无憾"],"usage":"作谓语、宾语、定语；比喻永无怨言"},{"id":28513,"word":"没齿难忘","pinyin":"mò chǐ nán wàng","abbr":"mcnw","explanation":"没齿：终身。一辈子也忘不了。","source":{"text":"司马谈阙陪盛礼，没齿难忘。","book":"唐·李商隐《为汝南公华州贺赦表》"},"example":{"text":"遽然拆散更堞怜，何时结草报衔环，～感二天。","book":"明·杨柔胜《玉环记·范张别皋》"},"similar":["没齿不忘","铭心刻骨"],"opposite":["忘恩负义"],"usage":"作谓语；指终身不能忘记"},{"id":28514,"word":"没齿难泯","pinyin":"mò chǐ nán mǐn","abbr":"mcnm","explanation":"没齿：终身。终身不能忘记。","source":{"text":"你果成得此事，下官感你的恩德，真是镂骨铭心，没齿难泯。","book":"明·陆采《怀香记·夕阳亭议》"},"similar":["没齿难忘","没世难泯"],"opposite":["忘恩负义"],"usage":"作谓语、定语；指终身不能忘记"},{"id":28515,"word":"沤沫槿艳","pinyin":"ōu mò jǐn yàn","abbr":"omjy","explanation":"比喻短暂的幻景。同“沤珠槿艳”。","source":{"text":"唐·高彦休《唐阙史·韦进士见亡妓》：“任生曰：‘某非猎食者，哀君情切，因来奉救。沤珠槿艳，不必多怀。’”  按，《太平广记》卷三五一引作“沤沫槿艳”。"},"similar":["沤珠槿艳"],"usage":"作宾语、定语；用于幻象"},{"id":28516,"word":"沤浮泡影","pinyin":"ōu fú pào yǐng","abbr":"ofpy","explanation":"水中气泡。比喻容易消失的事物。","source":{"text":"君听：叹世人似沤浮泡影，笑眼前繁华富贵，可能常定？","book":"明·张景《飞丸记·赏春话别》"},"usage":"作宾语；指易于消失的事物"},{"id":28517,"word":"沤珠槿艳","pinyin":"ōu zhū jǐn yàn","abbr":"ozjy","explanation":"比喻短暂的幻景。沤珠，水泡。槿，木槿花，鲜艳而易凋谢。","source":{"text":"任生曰：‘某非猎食者，哀君情切，因来奉救。沤珠槿艳，不必多怀。’","book":"唐·高彦休《唐阙史·韦进士见亡妓》"},"similar":["沤沫槿艳"],"usage":"作宾语、定语；用于幻象"},{"id":28518,"word":"沥胆堕肝","pinyin":"lì dǎn duò gān","abbr":"lddg","explanation":"比喻竭尽忠诚。","source":{"text":"世人逐势争奔走，沥胆堕肝惟恐后。","book":"唐·李颀《行路难》诗"},"example":{"text":"仙郎旧有黄金约，～更祷祈。","book":"唐·罗隐《暮云寄裴郎中》"},"similar":["沥胆披肝","沥胆隳肝"],"usage":"作谓语、定语；比喻竭尽忠诚"},{"id":28519,"word":"沥胆披肝","pinyin":"lì dǎn pī gān","abbr":"ldpg","explanation":"比喻开诚相见。也形容非常忠诚。","source":{"text":"沾巾堕睫，沥胆披肝，不在他门，誓于死节。","book":"唐·黄滔《启裴侍郎》"},"example":{"text":"入会之人，无宜情意真挚，～，以维时局。","book":"张篁溪《记自立会》"},"similar":["沥胆堕肝"],"usage":"作谓语、定语；形容非常忠诚"},{"id":28520,"word":"沥胆抽肠","pinyin":"lì dǎn chōu cháng","abbr":"ldcc","explanation":"犹沥胆披肝。比喻开诚相见。也形容非常忠诚。","source":{"text":"身当将帅之任，而不能沥胆抽肠，共诛奸逆，雪天地之痛，报君父之仇，则不可以禀灵含识，戴天覆地。","book":"《梁书·王僧辩传》"},"similar":["沥胆披肝"],"usage":"作谓语、状语；指人忠心"},{"id":28521,"word":"沥胆濯肝","pinyin":"lì dǎn zhuó gān","abbr":"ldzg","explanation":"犹沥胆披肝。比喻开诚相见。也形容非常忠诚。","source":{"text":"沥胆濯肝，明何尝负朋友，幽何尝畏鬼神！","book":"明·唐寅《与文徵明书》"},"similar":["沥胆披肝","沥胆堕肝","沥胆隳肝"],"usage":"作谓语、定语；比喻竭尽忠诚"},{"id":28522,"word":"沥胆隳肝","pinyin":"lì dǎn huī gān","abbr":"ldhg","explanation":"犹沥胆披肝。比喻开诚相见。也形容非常忠诚。","source":{"text":"世人逐势争奔走，沥胆堕肝惟恐后。","book":"唐·李颀《杂曲歌辞·行路难》"},"example":{"text":"仙郎旧有黄金约，～更祷祈。","book":"唐·罗隐《冬暮寄裴郎中》诗"},"similar":["沥胆披肝","沥胆堕肝","沥胆濯肝"],"usage":"作谓语、定语；比喻竭尽忠诚"},{"id":28523,"word":"沥血剖肝","pinyin":"lì xuè pōu gān","abbr":"lxpg","explanation":"光明磊落，以诚相见。","source":{"text":"来往的，尽是咬钉截铁汉；出入的，无非沥血剖肝人。","book":"明·施耐庵《水浒全传》第九回"}},{"id":28524,"word":"沥血叩心","pinyin":"lì xuè kòu xīn","abbr":"lxkx","explanation":"沥：滴。比喻费尽心血。","source":{"text":"沥血叩心，枕戈尝胆，其何故哉。","book":"南朝·梁·萧绎《与诸藩令》"},"similar":["尽心尽力"],"usage":"作定语、状语；指尽心尽力"},{"id":28525,"word":"沥血披心","pinyin":"lì xuè pī xīn","abbr":"lxpx","explanation":"比喻竭尽忠诚、恳挚的心意。同“沥血叩心”。","source":{"text":"诚切祷祈，沥血披心，仰希鉴祐。","book":"前蜀·杜光庭《晋公后土醮词》"},"similar":["沥血披肝","沥血叩心"],"usage":"作谓语、定语、状语；用于处事"},{"id":28526,"word":"沥血披肝","pinyin":"lì xuè pī gān","abbr":"lxpg","explanation":"比喻竭尽忠诚、恳挚的心意。同“沥血叩心”。","source":{"text":"实指望尽心竭力，不负天恩，沥血披肝，勤于王事。","book":"《再生缘》第五四回"},"similar":["沥血披心","沥血叩心"],"usage":"作谓语、定语、状语；用于处事"},{"id":28527,"word":"沦浃肌髓","pinyin":"lún jiā jī suǐ","abbr":"ljjs","explanation":"透入肌肉和骨髓。比喻感受深刻。同“沦肌浃髓”。","source":{"text":"三百余年豢养深恩，沦浃肌髓。","book":"清·陈康祺《郎潜纪闻》第一卷"},"example":{"text":"静觉得凉意～，异常地舒适。","book":"茅盾《幻灭》"},"similar":["沦肌浃髓"],"usage":"作谓语、定语；比喻程度或感受深刻"},{"id":28528,"word":"沦肌浃骨","pinyin":"lún jī jiā gǔ","abbr":"ljjg","explanation":"沦：深入；浃：通彻。透入肌肉和骨髓。比喻感受深刻。","source":{"text":"不浸于肌肤，不浃于骨髓。","book":"《淮南子·原道训》"}},{"id":28529,"word":"沦肌浃髓","pinyin":"lún jī jiā suǐ","abbr":"ljjs","explanation":"沦：深入；浃：通彻。透入肌肉和骨髓。比喻感受深刻。","source":{"text":"不浸于肌肤，不浃于骨髓。","book":"《淮南子·原道训》"},"example":{"text":"全座的人都快乐，都象喝着青春之酒，～全是爱与生意。","book":"叶圣陶《春光不是她的了》"},"similar":["沦浃肌髓","铭心刻骨"],"usage":"作谓语、定语；比喻程度或感受深刻"},{"id":28530,"word":"沦落风尘","pinyin":"lún luò fēng chén","abbr":"llfc","explanation":"沦落：流落，指陷入坏的境地。风尘：旧指娼妓的生活。旧指妇女不幸沦为娼妓。","source":{"text":"可怜一片无瑕玉，误落风尘花柳中。","book":"明·冯梦龙《警世通言·杜十娘怒沉百宝箱》"},"example":{"text":"她的～是终生的！她的悲剧也是终生的！","book":"朱自清《温州的踪迹·四》"},"similar":["流离失所","流落他乡"],"opposite":["安家立业","安家落户"],"usage":"作谓语、定语；指被迫"},{"id":28531,"word":"沧桑之变","pinyin":"cāng sāng zhī biàn","abbr":"cszb","explanation":"沧海变桑田的变化。比喻世事变化巨大。","source":{"text":"有金元遗山先生，具班马之才，阅沧桑之变，隐居不仕，著述自娱。","book":"《续夷坚志》序"},"similar":["沧海桑田"],"usage":"作宾语；用于变化等"},{"id":28532,"word":"沧浪老人","pinyin":"cāng láng lǎo rén","abbr":"cllr","explanation":"指隐者、渔父。","source":{"text":"渔父莞尔而笑，鼓枻而去。乃歌曰：‘沧浪之水清兮，可以濯吾缨；沧浪之水浊兮，可以濯吾足。’","book":"《楚辞·渔父》"},"example":{"text":"君不见～歌一曲，还道沧浪濯吾足。","book":"唐·李白《笑歌行》"},"usage":"作宾语、定语；指渔翁"},{"id":28533,"word":"沧海一粟","pinyin":"cāng hǎi yī sù","abbr":"chys","explanation":"粟：谷子，即小米。大海里的一粒谷子。比喻非常渺小。","source":{"text":"寄蜉蝣天天地，渺苍海之一粟。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"我本人只是～，渺小得很。真正伟大的是中国人民，是中国共产党，是中华人民共和国！","book":"钱学森《在授奖仪式上的讲话》"},"similar":["九牛一毛","太仓一粟","微不足道"],"opposite":["恒河沙数"],"usage":"作定语、宾语；指微不足道的事","story":["北宋文人苏东坡因反对王安石变法，被贬至黄州，在黄州先后写了两篇《赤壁赋》，感叹世事的变化，当年声势浩大的曹操在赤壁兵败，人是历史大海中的一粒粟米，微乎其微，但每个人要在有生之年奋发进取才能不枉费一生"]},{"id":28534,"word":"沧海一鳞","pinyin":"cāng hǎi yī lín","abbr":"chyl","explanation":"大海中的一片鱼鳞。比喻非常渺小。","source":{"text":"因要替一个死百姓伸冤，先得罪了一位阔公子，把自己从前十载青灯，半生黄卷，都随着乌鞭黑帽，犹如沧海一鳞，巫山片云，顷刻间风弛电掣，卷入无何有之乡。","book":"《冷眼观》第七回"},"similar":["沧海一粟"],"usage":"作定语、宾语；指微不足道的事"},{"id":28535,"word":"沧海桑田","pinyin":"cāng hǎi sāng tián","abbr":"chst","explanation":"桑田：农田。大海变成桑田，桑田变成大海。比喻世事变化很大。","source":{"text":"桑田：农田。大海变成桑田，桑田变成大海。比喻世事变化很大。"},"example":{"text":"～，谓世事之多变。","book":"清·程元升《幼学故事琼林·地舆》"},"similar":["日新月异","沧桑陵谷","白云苍狗"],"opposite":["一成不变"],"usage":"作谓语、宾语、分句；形容世事变化很大","story":["从前仙人王远和麻姑，他们相约到蔡经家去饮酒，王远一行很快就到蔡经家，但没见到麻姑的到来，就派使者去请。麻姑到来说她奉命去巡视蓬莱，已经三次见到东海变成桑田，现在海水又退了一半。王远说那里又要扬起尘土来了"]},{"id":28536,"word":"沧海横流","pinyin":"cāng hǎi héng liú","abbr":"chhl","explanation":"沧海：指大海；横流：水往四处奔流。海水四处奔流。比喻政治混乱，社会动荡。","source":{"text":"沧海横流，处处不安也。","book":"晋·袁宏《三国名臣序赞》：“沧海横流，玉石同碎。”《晋书·王尼传》"},"example":{"text":"～，方显出英雄本色。","book":"郭沫若《满江红》词"},"similar":["时局动荡"],"opposite":["歌舞升平"],"usage":"作谓语；形容天下大乱","story":["西晋末年，匈奴等少数民族起兵反晋，天下战乱纷纷，洛阳失陷，王尼带上儿子离乡背井到江南躲避祸乱，一路颠沛流离，他喟然长叹：“沧海横流，处处不安也”。到江夏投奔荆州刺史王澄，王澄不久死去，他们也活活饿死"]},{"id":28537,"word":"沧海遗珠","pinyin":"cāng hǎi yí zhū","abbr":"chyz","explanation":"大海里的珍珠被采珠人所遗漏。比喻埋没人才或被埋没的人才。","source":{"text":"仲尼称观过知仁，君可谓沧海遗珠矣。","book":"唐·牟融《寄永平友人二首》：“青蝇点玉原非病，沧海遗珠世所嗟。”《新唐书·狄人杰传》"},"example":{"text":"一首新诗一线书，喜于沧海得遗珠。","book":"元·金好问《寄答飞卿》"},"usage":"作谓语、宾语；指被埋没的人才"},{"id":28538,"word":"河不出图","pinyin":"hé bù chū tú","abbr":"hbct","explanation":"河：指黄河。黄河当中没有出现河图。古代相传每当圣明之世时，黄河便出现河图。因此黄河不出河图则不是圣明之世。指时当乱世。","source":{"text":"凤鸟不至，河不出图，自伤卑贱，不能致也。","book":"《论语·子罕》"},"usage":"作宾语、定语；用于书面语"},{"id":28539,"word":"河东三箧","pinyin":"hé dōng sān qiè","abbr":"hdsq","explanation":"指亡失的书籍。","source":{"text":"上行幸河东，尝亡书三箧，诏问莫能知，唯安世识之，具作其事。后购求得书，以相校无所遗失。","book":"语出《汉书·张安世传》"},"example":{"text":"及梓成，果大行于时，宝爱之者，比于吉光片羽，莫不思复得～，以睹其全焉。","book":"清·宋荦《〈唐百家诗选〉序一》"},"usage":"作宾语；指书籍等"},{"id":28540,"word":"河东狮吼","pinyin":"hé dōng shī hǒu","abbr":"hdsh","explanation":"比喻悍妒的妻子对丈夫大吵大闹。","source":{"text":"龙丘居士亦可怜，谈空说有夜不眠。忽闻河东师子吼，拄杖落手心茫然。","book":"宋·苏轼《寄吴德仁兼简陈季常》诗"},"example":{"text":"少不得太太面前还要趋奉趋奉，防是～起来，要不太平。","book":"清·彭养鸥《黑籍冤魂》第二十二回"},"similar":["河东狮子吼"],"usage":"作宾语、状语；借以讥讽惧内的人","story":["苏轼被贬至黄州，常与好友陈季常一起谈论文学。陈季常很好客，经常邀客人到家里，他的妻子是河东郡柳氏经常敲墙赶客，苏轼作诗“龙邱居士亦可怜，谈空说有夜不眠，忽闻河东狮子吼，柱杖落手心茫然。”笑陈季常怕老婆"]},{"id":28541,"word":"河东狮子","pinyin":"hé dōng shī zi","abbr":"hdsz","explanation":"旧指妒悍的妇女。","source":{"text":"吼动河东狮子，惊回海底鸥儿。","book":"明·梅鼎祚《玉合记·砥节》"},"example":{"text":"倘入侯门，～，虽不逞威；三五小星，也须生妒。","book":"《西湖佳话·西泠韵迹》"},"similar":["河东狮子吼","河东狮吼"],"usage":"作宾语、状语；借以讥讽惧内的人"},{"id":28542,"word":"河东狮子吼","pinyin":"hé dōng shī zi hǒu","abbr":"hdszh","explanation":"比喻妒悍的妻子发怒，并借以嘲笑惧内的人。","source":{"text":"陈慥字季常……自称‘龙丘先生’，又曰‘方山子’。好宾客，喜畜声妓，然其妻柳氏绝凶妒，故东坡有诗云：‘龙丘居士亦可怜，谈空说有夜不眠。忽闻河东师（狮）子吼，拄杖落手心茫然。’","book":"宋·洪迈《容斋三笔·陈季常》"},"example":{"text":"夫道本于刚，爱妻要有方。～ ，切莫胆惊慌。","book":"中国近代史资料丛刊《太平天国·夫道》"},"similar":["河东狮吼"],"usage":"作宾语、定语；借以讥讽惧内的人","story":["北宋时期，苏轼被贬至黄州，常与好友陈季常一起谈论文学。陈季常很好客，经常邀客人到家里，他的妻子是河东郡柳氏经常敲墙赶客，苏轼作诗“龙邱居士亦可怜，谈空说有夜不眠，忽闻河东狮子吼，柱杖落手心茫然。”笑陈季常怕老婆"]},{"id":28543,"word":"河伯为患","pinyin":"hé bó wéi huàn","abbr":"hbwh","explanation":"指歪门邪恶的风气。","example":{"text":"我省～，灾情十分严重。"},"opposite":["旱魃为虐"],"usage":"作谓语、定语；指水灾","story":["魏文侯时期，邺县县令西门豹得知县内人们深受河伯娶妻之苦，祝巫到处串门访户，遇到美貌女孩就让她嫁给河伯，还要收很多钱财，借此害人命而收揽钱财。西门豹看出其中的奥秘，就把这些女巫及帮凶投入河中，救出那些女孩"]},{"id":28544,"word":"河倾月落","pinyin":"hé qīng yuè luò","abbr":"hqyl","explanation":"表示夜将尽。","source":{"text":"河倾月落，馀欢未歇。","book":"元·陈樵《月放过赋》"},"similar":["河斜月落"],"usage":"作宾语、定语；用于深夜"},{"id":28545,"word":"河决鱼烂","pinyin":"hé jué yú làn","abbr":"hjyl","explanation":"比喻事物坏到极点，不可收拾。","source":{"text":"孰如近在汾晋之间，使我不轨之士民，教猱伥虎，河决鱼烂于腹心乎？","book":"清·王夫之《读通监论·晋武帝》"},"example":{"text":"近代之文章，～，败坏而不可救者，凡以百年以来学问之缪种淫于世运，熏结于人心，袭习纶轮，酝酿发作，以至于此极也。","book":"清·钱谦益《〈赖古堂文选〉序》"},"usage":"作宾语、定语；用于比喻句"},{"id":28546,"word":"河出伏流","pinyin":"hé chū fú liú","abbr":"hcfl","explanation":"比喻潜在力量爆发，其势猛不可挡。","source":{"text":"河源出昆仑，伏流地中方三千里，禹导而通之，故出积石。","book":"语出《淮南子·坠形训》“河出积石”汉高诱注"},"example":{"text":"周室之势既微，其所余虚文仪式之陈言，不足以范围一世之人心。遂有～，一泻千里之概。","book":"梁启超《中国学术思想变迁之大势》第三章第一节"},"usage":"作宾语、定语；用于比喻句"},{"id":28547,"word":"河同水密","pinyin":"hé tóng shuǐ mì","abbr":"htsm","explanation":"比喻彼此关系密切。","source":{"text":"邵氏故意欲责秀姑，却教秀姑引得贵以塞其口。彼此河同水密，各不相瞒。","book":"《警世通言·况太守断死孩儿》"},"usage":"作谓语、定语；用于两者的关系"},{"id":28548,"word":"河奔海聚","pinyin":"hé bēn hǎi jù","abbr":"hbhj","explanation":"比喻思路开阔，文辞畅达。","source":{"text":"与朱文公往复辩论，每书辄倾竭浩荡，河奔海聚。","book":"元·刘壎《隐居通议·理学二》"},"usage":"作宾语；指文辞畅达"},{"id":28549,"word":"河山之德","pinyin":"hé shān zhī dé","abbr":"hszd","explanation":"形容妇人德容之美。","source":{"text":"如山凝然而重，如河渊然而深，皆以状德容之美。","book":"《诗·墉风·君子偕老》：“委委佗佗，如山如河，象服是宜。”陆德明释文：“《韩诗》云：德之美貌。”王先谦《诗三家义集疏》"},"example":{"text":"敕：诗人之义，君之夫人有委蛇之行，～，然后在尊位，备盛服，从其夫荣，可以为称。","book":"宋·曾巩《左仆射门下侍郎王珪追封三代并妻制·妻郑氏追封楚国夫人》"},"usage":"作宾语；多用于女性"},{"id":28550,"word":"河山带砺","pinyin":"hé shān dài lì","abbr":"hsdl","explanation":"黄河细得象条衣带，泰山小得象块磨刀石。比喻时间久远，任何动荡也决不变心。","source":{"text":"封爵之誓曰：‘使河如带，泰山若砺，国以永宁，爱及苗裔。’","book":"《史记·高祖功臣侯者年表》"},"example":{"text":"功载鼎彝，名藏王府，子孙代代，为国勋臣，～，传祚无绝。","book":"唐·陆贽《唐德宗皇帝赐李纳田悦王武俟铁券文》"},"similar":["河带山砺"],"usage":"作谓语、定语；比喻时间久远"},{"id":28551,"word":"河山破碎","pinyin":"hé shān pò suì","abbr":"hsps","explanation":"河山：指国家的领土。比喻国家遭到外敌侵略，领土沦陷丧失。","source":{"text":"山河破碎风漂絮，身世浮沉雨打萍。","book":"宋·文天祥《过零丁洋》诗"}},{"id":28552,"word":"河带山砺","pinyin":"hé dài shān lì","abbr":"hdsl","explanation":"河：黄河；带：衣带；山：泰山；砺：磨刀石。黄河像条衣带，泰山像块磨刀石。比喻经历的时间久远。","source":{"text":"河带山砺，贻厥于后。","book":"北周·宇文道《庾信集序》"},"similar":["河山带砺"],"usage":"作宾语、定语；比喻时间久远"},{"id":28553,"word":"河斜月落","pinyin":"hé xié yuè luò","abbr":"hxyl","explanation":"表示夜将尽。同“河倾月落”。","source":{"text":"你看河斜月落，斗转参横，不免回去罢。","book":"清·洪昇《长生殿·偷曲》"},"similar":["河倾月落"],"usage":"作宾语、定语；用于深夜"},{"id":28554,"word":"河梁之谊","pinyin":"hé liáng zhì yí","abbr":"hlzy","explanation":"河梁：桥，指送别之地。指送别时依依不舍的情谊。","source":{"text":"携手上河梁，游子暮何之？徘徊蹊路侧，悢悢不得辞。……行人难久留，各言长相思。","book":"汉·李陵《与苏武》"},"example":{"text":"匆匆言别，未及接杯酒不实之欢，并不得展～，深以为愧！","book":"清·归庄《与朱宗远书》"},"usage":"作宾语；指送别时依依不舍的情谊"},{"id":28555,"word":"河梁携手","pinyin":"hé liáng xié shǒu","abbr":"hlxs","explanation":"河梁：桥。指送别。","source":{"text":"携手上河梁，游子暮何之？徘徊蹊路侧，悢悢不得辞。","book":"汉·李陵《与苏武》诗"},"usage":"作谓语；指送别"},{"id":28556,"word":"河水不洗船","pinyin":"hé shuǐ bù xǐ chuán","abbr":"hsbxc","explanation":"比喻不相干或相安无事。","source":{"text":"我是一片本心，特地来报信，我也只愿得无事，落得“河水不洗船”。","book":"清·吴敬梓《儒林外史》第十四回"},"usage":"作宾语、定语；用于比喻句"},{"id":28557,"word":"河水不犯井水","pinyin":"hé shuǐ bù fàn jǐng shuǐ","abbr":"hsbfjs","explanation":"比喻互不干犯。","source":{"text":"而另一方面周瘦鹃在自己编的内说各种副刊有各种副刊的特性，作河水不犯井水之论。","book":"鲁迅《从与说起》"},"example":{"text":"钱钟书《围城》：“这时候他知道鸿渐跟自己～，态度轻松了许多，嗓子已恢复平日的响朗。”"},"similar":["井水不犯河水"],"usage":"作谓语、宾语、定语；指界限分明"},{"id":28558,"word":"河汉予言","pinyin":"hé hàn yú yán","abbr":"hhyy","explanation":"河汉：银河，比喻言论虚夸迂阔，不着边际。把这话看作不实的言论，不重视。","source":{"text":"倘革命党当时不河汉予言，则后天民国之进行，亦如先天组党之手续，凡归顺之官吏，新进之国民，必当于民国为正心诚意之宣誓。","book":"孙中山《心理建设》第六章"},"similar":["河汉斯言","河汉吾言"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28559,"word":"河汉吾言","pinyin":"hé hàn wú yán","abbr":"hhwy","explanation":"河汉：银河，比喻言论虚夸迂阔，不着边际；斯：这。把这话看作不实的言论，不重视。","source":{"text":"足下上观千古，博观而约取之，当不河汉吾言。","book":"清·蒋湘南《与田叔子论古文第二书》"},"similar":["河汉斯言","河汉予言"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28560,"word":"河汉斯言","pinyin":"hé hàn sī yán","abbr":"hhsy","explanation":"河汉：银河，此比喻言论夸张荒诞；斯：此。把这番话看作是虚夸不实的言论。比喻大而无当，不可置信的话。","source":{"text":"吾闻言于接舆，大而无当，往而不返，吾惊怖其言，犹河汉而无极也。","book":"《庄子·逍遥游》"},"example":{"text":"如我将来，亦出一辙，性情同者，当不～。","book":"清·梁绍壬《两般秋雨庵随笔》卷三"},"similar":["河汉予言","河汉吾言"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28561,"word":"河汉无极","pinyin":"hé hàn wú jí","abbr":"hhwj","explanation":"河汉：银河；极：尽头，边际。银河广阔，无边无际。比喻言论荒诞不经，难以置信。亦比喻恩泽广大，使人难以报答。","source":{"text":"吾闻言于接舆，大而无当，往而不返，吾惊怖其言，犹河汉而无极也。","book":"《庄子·逍遥游》"},"example":{"text":"循襟佩德，抚事知恩，山岳有轻，～。","book":"唐·王勃《上皇甫常伯启》"},"usage":"作宾语、定语；用于比喻句"},{"id":28562,"word":"河汉江淮","pinyin":"hé hàn jiāng huái","abbr":"hhjh","explanation":"黄河、汉水、长江与淮河的合称。比喻胸怀宽广。","source":{"text":"生就的准绳规矩，养成的河汉江淮。","book":"明·黄叔初《端正好·寿李如真明府》套曲"},"usage":"作宾语、定语；用于比喻句"},{"id":28563,"word":"河汾门下","pinyin":"hé fén mén xià","abbr":"hfmx","explanation":"河：黄河。汾：汾水。用以比喻名师门下，人才济济或人才辈出。","source":{"text":"隋末大儒王通（文中子）在黄河、汾水之间设馆教学，远近来此求学者达一千余人，房玄龄、杜如晦、魏征、李靖、程之、薛收、温大雅等都是他的门徒，而这些人都是唐初的功臣，时称“河汾门下”。"},"usage":"作宾语、定语；指名师","story":["隋朝末年，大儒王通不想谋一官半职，他决定把自己的学问传授他人，就在河汾设帐授学，他的教育方法十分独特，很多人都慕名而来求学。他的学生如房玄龄、魏征、李靖、程元、窦威、贾琼等，人们以河汾门下的学生为荣"]},{"id":28564,"word":"河沙世界","pinyin":"hé shā shì jiè","abbr":"hssj","explanation":"指多如恒河沙数的佛世界。","source":{"text":"河沙世界尽空空，一存寒灰冷灯畔。","book":"语出《金刚经·一体同观分》：“是诸恒河所有沙数，佛世界如是，宁为多不？”南汉·张瀛《赠琴棋僧歌》"},"example":{"text":"南汉·张嬴《赠琴棋僧歌》：“～尽空空，一寸寒灰冷灯畔。”"},"usage":"作宾语、定语；用于佛家语"},{"id":28565,"word":"河海不择细流","pinyin":"hé hǎi bù zé xì liú","abbr":"hhbzxl","explanation":"比喻不论大小，一律收容。","source":{"text":"太山不让土壤，故能成其大；河海不择细流，故能就其深。","book":"《史记·李斯列传》"},"usage":"作宾语、定语；用于书面语"},{"id":28566,"word":"河海清宴","pinyin":"hé hǎi qīng yàn","abbr":"hhqy","explanation":"比喻天下太平。同“河清海晏”。","source":{"text":"河海清宴，中外乐康。","book":"清·纳兰性德《金山歌》"},"similar":["河清海晏","河清海宴"],"usage":"作宾语、定语；比喻天下太平"},{"id":28567,"word":"河润泽及","pinyin":"hé rùn zé jí","abbr":"hrzj","explanation":"河润：如同河流浸润土地那样；泽：恩泽，恩惠。能将恩惠施与众人，使都能得到好处和利益。","source":{"text":"河润九里，泽及三族。","book":"《列子·列御寇》"}},{"id":28568,"word":"河涸海干","pinyin":"hé hé hǎi qián","abbr":"hhhg","explanation":"河流干涸，大海枯竭。比喻穷尽、彻底，不留余地。","source":{"text":"谁知那姓展的不知好歹，他说菜是剩下的，酒是浑的，坛子也摔了，盘子碗也砸了，还骂了个河涸海干。","book":"《三峡五义》第五五回"},"similar":["河落海干"],"usage":"作宾语、定语；用于比喻句"},{"id":28569,"word":"河清三日","pinyin":"hé qīng sān rì","abbr":"hqsr","explanation":"为升平祥瑞的预兆。","source":{"text":"吾圣主始生，此河清者三日。黄河清，圣人出，今果然矣。","book":"《易纬乾凿度》卷下：“天之将降嘉瑞应，河水清三日。”明·张居正《承天大志纪赞·龙飞纪》"},"example":{"text":"逾年辛酉，钦天监奏日月合壁，五星连珠……豫河监督奏～。","book":"清·魏秀仁《花月痕》第四十七回"},"usage":"作宾语、定语；用于书面语"},{"id":28570,"word":"河清云庆","pinyin":"hé qīng yún qìng","abbr":"hqyq","explanation":"黄河水清，云呈五彩。古人以为太平祥瑞的象征。","source":{"text":"河清云庆，祥光烛天。","book":"明·张居正《承天大志纪赞·龙飞纪》"},"usage":"作宾语、定语；用于书面语"},{"id":28571,"word":"河清人寿","pinyin":"hé qīng rén shòu","abbr":"hqrs","explanation":"古时传说黄河水千年一清，因以之极言人之长寿。","source":{"text":"但愿得、河清人寿。归日急翻行戍稿，把空名、料理传身后。","book":"清·顾贞观《金缕曲·寄吴汉槎宁古塔以词代书》词之二"},"usage":"作宾语、定语；用于祝寿等"},{"id":28572,"word":"河清海宴","pinyin":"hé qīng hǎi yàn","abbr":"hqhy","explanation":"比喻天下太平。同“河清海晏”。","source":{"text":"垂衣而治，际河清海宴之期；乘钺有虔，鼓雷厉风飞烈。","book":"明·张居正《拟唐回鹘率众内附贺表》"},"similar":["河清海晏"],"usage":"作宾语、定语；比喻天下太平"},{"id":28573,"word":"河清海晏","pinyin":"hé qīng hǎi yàn","abbr":"hqhy","explanation":"河：黄河；晏：平静。黄河水清了，大海没有浪了。比喻天下太平。","source":{"text":"河清海晏，时和岁丰。","book":"唐·郑锡《日中有王子赋》"},"example":{"text":"诚所谓～，太平之世界也。","book":"明·吴承恩《西游记》第九十回"},"similar":["天下太平","海晏河清"],"opposite":["天下大乱","烽火连天"],"usage":"作宾语、定语；比喻天下太平"},{"id":28574,"word":"河清海竭","pinyin":"hé qīng hǎi jié","abbr":"hqhj","explanation":"黄河水清，大海干涸。比喻难得遇到的事情。","source":{"text":"小臣莫效于鸿毛，穿街鲜而嗽醪。虽复河清海竭，终无增景于边撩。","book":"《西京杂记》卷四引汉·枚乘《柳赋》"},"usage":"作宾语、定语；用于比喻句"},{"id":28575,"word":"河清社鸣","pinyin":"hé qīng shè míng","abbr":"hqsm","explanation":"为太平祥瑞的象征。","source":{"text":"里社，神祠也。","book":"《文选·李康〈运命论〉》：“夫黄河清而圣人生，里社鸣而圣人出。”刘良注"},"example":{"text":"～，千载启兴王之道；天长地久，万邦倾祝圣之心。","book":"宋·王禹偁《缴连寿宁节功德疏表》"},"usage":"作宾语、定语；用于书面语"},{"id":28576,"word":"河清难俟","pinyin":"hé qīng nán sì","abbr":"hqns","explanation":"俟：等待。很难等到黄河水清。比喻时间太长，难以等待。","source":{"text":"俟河之清，人寿几何？","book":"《左传·襄公八年》"},"example":{"text":"不佞粗中坦率，全无彼此，冀望诚深，未知得如愿否也，景迫桑榆，～，奈何。","book":"明·朱之瑜《答奥村庸礼书十二首》其一"},"usage":"作谓语、补语；比喻时间太久，难以等待","story":["春秋时期，郑国公子子国和子耳出兵攻打蔡国，打了胜仗。子国的儿子子产深为忧虑，担心楚国会讨伐郑国。楚庄王派公子贞率兵攻打郑国，郑国当权者子驷引用周诗“俟河之清，人寿几何？兆支询多，职竞作罗”准备向楚国投降"]},{"id":28577,"word":"河溓海夷","pinyin":"hé lián hǎi yí","abbr":"hlhy","explanation":"犹言河清海晏。比喻天下太平。","source":{"text":"故精纬上灵，动殖下端，诸侯轨道，河溓海夷。","book":"《宋书·礼志三》"},"similar":["河溓海晏"],"usage":"作宾语、定语；用于局势等"},{"id":28578,"word":"河溓海晏","pinyin":"hé lián hǎi yàn","abbr":"hlhy","explanation":"犹言河清海晏。比喻天下太平。","source":{"text":"地平天成，河溓海晏。","book":"唐·陈集源《龙龛道场铭序》"},"similar":["河溓海夷"],"usage":"作宾语、定语；用于局势等"},{"id":28579,"word":"河目海口","pinyin":"hé mù hǎi kǒu","abbr":"hmhk","explanation":"河目：形状像河一样的眼睛，上下眼眶平而长；海口：像大海一样的嘴，又大又深。比喻相貌非凡。","source":{"text":"孔子海口含泽。","book":"《孔子家语·困誓》：“孔子适郑，与弟子相失，独立于东郭门外。或人谓子贡日：‘东门外有一人焉，其长九尺有六寸，河目隆颡。’”《孝经援神契》"},"example":{"text":"大人的根器厚的很，天庭开阔，地角也称的过。况且～，是人间有一无二的相。","book":"清·嘿生《玉佛缘》第二回"},"usage":"作定语；比喻相貌非凡"},{"id":28580,"word":"河落海干","pinyin":"hé luò hǎi gān","abbr":"hlhg","explanation":"比喻一点不剩。同“河涸海干”。","source":{"text":"这会子你怕花钱，挑唆他们来闹我，我乐得去吃个河落海干，我还不知道呢！","book":"清·曹雪芹《红楼梦》第四十五回"},"example":{"text":"你们就弄了这些吃的，我乐得吃个～睡觉。","book":"《儿女英雄传》第一回"},"similar":["河涸海干"],"usage":"作定语、宾语；比喻穷尽、彻底，不留余地"},{"id":28581,"word":"河门海口","pinyin":"hé mén hǎi kǒu","abbr":"hmhk","explanation":"比喻说大话。","source":{"text":"你忒河门海口，不要我拣好的，我不道的拣好的去哩。","book":"元·无名氏《午时牌》第二折"},"usage":"作谓语、宾语、定语；用于说话等"},{"id":28582,"word":"河鱼之疾","pinyin":"hé yú zhī jí","abbr":"hyzj","explanation":"河鱼：腹疾的隐称，因鱼腐烂是从腹中开始而得名。指腹泻。","source":{"text":"河鱼腹疾，奈何？","book":"《左传·宣公十二年》"},"example":{"text":"到韶累月，疲于人事，又苦～，少留调理乃行，益远，愈增瞻系也。","book":"宋·苏轼《与冯祖仁书三首》"},"similar":["河鱼腹疾"],"usage":"作宾语；指腹泻","story":["公元前597年冬天，楚国攻打萧国，围住萧国的城池，楚国大夫申叔展和萧国大夫还无社是好朋友，还无社还在城内，申叔展无法明救他，只好用“河鱼腹疾”暗语示意躲在枯井里逃难，后来终于救出朋友"]},{"id":28583,"word":"河鱼天雁","pinyin":"hé yú tiān yàn","abbr":"hyty","explanation":"古传鱼雁都能传递书信，后即以之借指传送书信者。","source":{"text":"意马心猿萦梦寐，河鱼天雁托音书。","book":"《二十年目睹之怪现状》第五回"},"usage":"作宾语、定语；用于信史等"},{"id":28584,"word":"河鱼腹疾","pinyin":"hé yú fù jí","abbr":"hyfj","explanation":"河鱼：腹疾的隐称，因鱼腐烂是从腹中开始而得名。指腹泻。","source":{"text":"河鱼腹疾，奈何？","book":"《左传·宣公十二年》"},"example":{"text":"……申叔展～之叹，若罹霜露之疾，当由生灵有限，此数子者，病鬼之为也。","book":"明·赵弼《疥鬼对》"},"similar":["河鱼之疾"],"usage":"作谓语；指腹泻","story":["公元前597年冬天，楚国攻打萧国，围住萧国的城池，楚国大夫申叔展和萧国大夫还无社是好朋友，还无社还在城内，申叔展无法明救他，只好用“河鱼腹疾”暗语示意躲在枯井里逃难，后来终于救出朋友"]},{"id":28585,"word":"沸反盈天","pinyin":"fèi fǎn yíng tiān","abbr":"ffyt","explanation":"沸：滚翻；盈：充满。声音象水开锅一样沸腾翻滚，充满了空间。形容人声喧闹，乱成一片。","source":{"text":"刚刚到门，听见里面哭的沸反盈天。","book":"清·李宝嘉《中国现在记》"},"example":{"text":"你自己荐她来，又合伙劫她去，闹得～的，大家看了成个什么样子？","book":"鲁迅《彷徨·祝福》"},"similar":["人声鼎沸","蜩螗沸羹"],"opposite":["鸦雀无声","万籁俱寂"],"usage":"作谓语、定语、状语；用于书面语"},{"id":28586,"word":"沸反连天","pinyin":"fèi fǎn lián tiān","abbr":"fflt","explanation":"形容人声喧闹，乱成一片。同“沸反盈天”。","source":{"text":"那黑虎带来的两员偏将，给散了众军羊酒，仍回到殿上，听得里面沸反连天，拔出腰刀抢进来。","book":"《说岳全传》第六七回"},"similar":["沸反盈天"],"usage":"作谓语、定语、补语；用于书面语"},{"id":28587,"word":"沸天震地","pinyin":"fèi tiān zhèn dì","abbr":"ftzd","explanation":"形容声音极其喧腾。","source":{"text":"那一对小新人面对面站着，在一阵沸天震地的拍手声里，他们俩鞠上三个大躬。","book":"叶圣陶《一个朋友》"},"example":{"text":"于是在～的锣鼓鞭炮中，这一对人儿——他十五，她十六——如一对羔羊，昏惑而惊惧，被人笑嘻嘻地推到焰光熊熊的龙凤喜烛之前。","book":"曹禺《北京人》第一幕"},"usage":"作谓语、定语；用于喧哗的环境"},{"id":28588,"word":"沸沸扬扬","pinyin":"fèi fèi yáng yáng","abbr":"ffyy","explanation":"沸沸：水翻滚的样子；扬扬：喧闹、翻动的样子。象沸腾的水一样喧闹。形容人声喧闹。","source":{"text":"其中多白玉，是有玉膏，其原沸沸汤汤。","book":"《山海经·西山经》"},"example":{"text":"后来听得～地说：“黄泥冈上一伙贩枣的客人把蒙汗药麻翻了人，劫了生辰冈去。”","book":"明·施耐庵《水浒全传》第十八回"},"similar":["沸反盈天","人声鼎沸"],"opposite":["鸦雀无声","耳根清静","冷冷清清"],"usage":"作谓语、定语、补语；形容人声喧闹"},{"id":28589,"word":"沸沸汤汤","pinyin":"fèi fèi tāng tāng","abbr":"ffss","explanation":"水奔腾汹涌的样子。","source":{"text":"[峚山]丹水出焉，西流注于稷泽，其中多白玉，是有玉膏，其原沸沸汤汤。","book":"《山海经·西山经》"},"similar":["浩浩汤汤"],"usage":"作谓语、定语；用于水等"},{"id":28590,"word":"油光可鉴","pinyin":"yóu guāng kě jiàn","abbr":"ygkj","explanation":"形容非常光亮润泽。","source":{"text":"也有解散辫子，盘得平的，除下帽来，油光可鉴，宛如小姑娘的发髻一般，还要将脖子扭几扭。","book":"鲁迅《朝花夕拾·藤野先生》"},"example":{"text":"他年近三十岁，留着‘西洋装’的头，梳的蓬蓬的，～。","book":"吴组缃《山洪》五"},"usage":"作谓语、定语；用于书面语"},{"id":28591,"word":"油光晶亮","pinyin":"yóu guāng jīng liàng","abbr":"ygjl","explanation":"形容非常光滑明亮。","source":{"text":"雪白西装领上一个油光晶亮的头和两个烫得蓬蓬松松的头斗成个‘品’字。","book":"茅盾《泡沫·第一个半天的工作》"},"usage":"作定语、状语；用于口语"},{"id":28592,"word":"油光水滑","pinyin":"yóu guāng shuǐ huá","abbr":"ygsh","explanation":"①形容光滑润泽。②形容人的圆滑、狡诈。","source":{"text":"原来这顶柜子里面，中腰不安抽屉，下面也没榻板；那后面的背板一扇到底抹的油光水滑，像是常有人出入的样子。","book":"《儿女英雄传》第七回"},"example":{"text":"这东昌巡道衙门住扎临清；因临清是马头所在，有那班～的光棍，真是‘天高皇帝远’晓得怕些什么。","book":"《醒世姻缘传》第十二回"},"usage":"作定语、状语；多用于比喻句"},{"id":28593,"word":"油嘴油舌","pinyin":"yóu zuǐ yóu shé","abbr":"yzys","explanation":"形容说话油滑轻浮。","source":{"text":"你这游方和尚，便是有些油嘴油舌的说话。","book":"《西游记》第三六回"},"example":{"text":"汤镇台见他～，恼了道：‘我出门三十年，你长成人了，怎么学出这般一个下流气质。’","book":"《儒林外史》第四四回"},"similar":["油嘴滑舌","油嘴花唇"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":28594,"word":"油嘴滑舌","pinyin":"yóu zuǐ huá shé","abbr":"yzhs","explanation":"形容说话油滑，耍嘴皮子。","source":{"text":"俺看他油嘴滑舌，南腔北调，到底算个甚么？","book":"清·李汝珍《镜花缘》第二十一回"},"example":{"text":"这个人～的，很使人烦。"},"similar":["虚头滑脑","油腔滑调"],"opposite":["一本正经"],"usage":"作谓语、宾语；指人说话"},{"id":28595,"word":"油嘴狗舌","pinyin":"yóu zuǐ gǒu shé","abbr":"yzgs","explanation":"形容说话油滑，态度轻浮。","source":{"text":"你会唱的甚么好成样的套数儿，左右是几句，东沟窝，西沟灞，油嘴狗舌，不上纸笔的。","book":"明·兰陵笑笑生《金瓶梅词话》第七十六回"},"similar":["油嘴滑舌"],"usage":"作谓语、宾语、定语；用于说话"},{"id":28596,"word":"油嘴花唇","pinyin":"yóu zuǐ huā chún","abbr":"yzhc","explanation":"形容说话油滑虚浮。","source":{"text":"日日假忙，说道某乡绅叫管家来邀；时时捣鬼，说道某官府着农民相召。止不过油嘴花唇，无非要骗人钱钞。","book":"清·李玉《清忠谱·创祠》"},"similar":["油嘴滑舌","油嘴油舌"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":28597,"word":"油嘴骗舌","pinyin":"yóu zuǐ piàn shé","abbr":"yzps","explanation":"形容说话轻浮，不实在。","source":{"text":"况我老爷是朝中官宰，因贬谪潮阳，在此经过，遇着这天大雪，问你一条走路，又不是低三下四的人，你如何这油嘴骗舌！","book":"明·杨尔增《韩湘子全传》第二十回"},"example":{"text":"积年棍黠，～者，谓之老棍。","book":"安积觉《朱文恭遗事》"}},{"id":28598,"word":"油回磨转","pinyin":"yóu huí mò zhuàn","abbr":"yhmz","explanation":"比喻拿不出主意，非常着急的样子。","source":{"text":"急的敬济只是油回磨黑转，转眼看见金莲身底下露出钥匙带儿来。","book":"明·兰陵笑笑生《金瓶梅词话》第三十三回"}},{"id":28599,"word":"油壁香车","pinyin":"yóu bì xiāng chē","abbr":"ybxc","explanation":"称妇女所乘油壁车。","source":{"text":"油壁香车不再逢，峡云无迹任西东。","book":"宋·晏殊《寓意》诗"}},{"id":28600,"word":"油头光棍","pinyin":"yóu tóu guāng gùn","abbr":"ytgg","explanation":"指浮浪子弟。","source":{"text":"七大人进来了。穿的衣服并不像什么大人老爷，简直油头光棍一样。","book":"《官场现形记》第五一回"},"similar":["戏蝶游蜂","游蜂浪蝶"],"usage":"作宾语、定语；用于口语"},{"id":28601,"word":"油头滑脑","pinyin":"yóu tóu huá nǎo","abbr":"ythn","explanation":"形容人又轻浮，又狡滑。","source":{"text":"歌德派拉君之事，我未注意，此君盖法国礼拜六派，油头滑脑，其到中国来，大概确是搜集小说材料。","book":"鲁迅《书信集·550·致王志之》"},"example":{"text":"你那～的形象让人生厌。"},"similar":["油腔滑调"],"opposite":["待人诚恳"],"usage":"作谓语、宾语、定语；指人的形象"},{"id":28602,"word":"油头滑脸","pinyin":"yóu tóu huá liǎn","abbr":"ythl","explanation":"形容人狡猾轻浮。","source":{"text":"正看之间，有小和尚疾忙进报。随有中年和尚油头滑脸，摆将出来。","book":"《醒世恒言·张淑儿巧智脱杨生》"},"example":{"text":"他们原是一伙儿！你们想他们那个会的名儿，一批会员又是些～的小伙子。","book":"叶圣陶《城中》"},"similar":["油头滑面"],"usage":"作谓语、定语、状语；指人很轻浮"},{"id":28603,"word":"油头滑面","pinyin":"yóu tóu huá miàn","abbr":"ythm","explanation":"形容人狡猾轻浮。同“油头滑脸”。","source":{"text":"招弟的那一群油头滑面的小鬼听到这消息，也准备拚命给若霞喊倒好儿，作为抵抗。","book":"老舍《四世同堂》六三"},"example":{"text":"钱钟书《围城》：“这男人～，像浸油的枇杷核，穿件青布大褂，跟女人并肩而坐，看不出是用人。”"},"similar":["油头滑脸"],"usage":"作谓语、定语、状语；指人很轻浮"},{"id":28604,"word":"油头粉面","pinyin":"yóu tóu fěn miàn","abbr":"ytfm","explanation":"头上擦油，脸上搽粉。形容人打扮得妖艳粗俗。","source":{"text":"皓齿明眸，粉面油头，点花牌，行酒令。","book":"元·钟嗣成《骂玉郎过感恩采茶歌·四景》"},"example":{"text":"～成虚话，广智多谋一旦休。","book":"明·许仲琳《封神演义》第九十四回"},"similar":["施脂着粉","浓妆艳抹","淡扫蛾眉"],"opposite":["朴素自然","质朴无华","天生丽质"],"usage":"作谓语、定语；指人的打扮"},{"id":28605,"word":"油尽灯枯","pinyin":"yóu jìn dēng kū","abbr":"yjdk","explanation":"灯油熬干了，火也灭了。比喻生命衰竭直至老死。","example":{"text":"主后，你渐渐～，再过得一炷香时分，你便精力耗竭而死。","book":"金庸《鹿鼎记》第六回"}},{"id":28606,"word":"油干火尽","pinyin":"yóu gān huǒ jìn","abbr":"yghj","explanation":"形容罄尽。","source":{"text":"[丁生]直赢得两人油干火尽，两人也怕起来。只得忍着性子住了，垂头丧气而别。","book":"《二刻拍案惊奇》卷八"},"similar":["油干灯尽","油干灯草尽"],"usage":"作宾语、定语；用于比喻句"},{"id":28607,"word":"油干灯尽","pinyin":"yóu gàn dēng jìn","abbr":"ygdj","explanation":"比喻很快就要死亡。同“油干灯草尽”。","source":{"text":"孔厚道：‘嫂嫂揣理，小生并非不出力，只我不是神仙，那有灵芝仙药，所用不过树皮草根，油干灯尽，大命已终，如何救得。’","book":"《荡寇志》第四四回"},"example":{"text":"章诒和《往事并不如烟·最后的贵族》：“最后一次见到的罗仪凤那～的样子，就在眼前摇来晃去。”"},"similar":["油干灯草尽","油干火尽"],"usage":"作宾语、定语；用于比喻句"},{"id":28608,"word":"油干灯草尽","pinyin":"yóu gān dēng cǎo jìn","abbr":"ygdcj","explanation":"比喻很快就要死亡。","source":{"text":"中国有句俗语叫做‘油干灯草尽’，资本主义进展到了第三期，它的渐渐地崩溃，在目前‘油’虽还未‘干’，‘灯草’虽还未‘尽’，但这样下去，是朝着‘油干灯草尽’的路线走去，这是很显然的趋势。","book":"邹韬奋《〈萍踪寄语初集〉弁言》"},"similar":["油干灯尽"],"usage":"作宾语、定语；用于比喻句"},{"id":28609,"word":"油油腻腻","pinyin":"yóu yóu nì nì","abbr":"yynn","explanation":"指油很多或沾满油污的样子。","source":{"text":"裹一项油油腻腻旧头巾，穿一领邋邋遢遢泼戏袄。","book":"明·施耐庵《水浒传》第82回"},"usage":"作定语、状语；用于口语"},{"id":28610,"word":"油浇火燎","pinyin":"yóu jiāo huǒ liáo","abbr":"yjhl","explanation":"形容焦急。","source":{"text":"齐标虽认为有理，却油浇火燎地问：‘依你说该咋办？’","book":"向春《煤城怒火》第二一章"},"similar":["油煎火燎"],"usage":"作定语、状语；用于比喻句"},{"id":28611,"word":"油渍麻花","pinyin":"yóu zì má huā","abbr":"yzmh","explanation":"形容油污斑斑的样子。"},{"id":28612,"word":"油炸猢狲","pinyin":"yóu zhá hú sūn","abbr":"yzhs","explanation":"形容人轻狂浮躁。","source":{"text":"莺莺呵，你嫁个油炸猢狲的丈夫；红娘呵，你伏侍个烟薰猫儿的姐夫；张生呵，你撞着个水浸老鼠的姨夫。","book":"元·王实甫《西厢记》第五本第四折"}},{"id":28613,"word":"油然而生","pinyin":"yóu rán ér shēng","abbr":"yres","explanation":"油然：很自然的。形容自然地产生（某种思想感情）。","source":{"text":"观吾之谱者，孝弟之心可以油然而生矣。","book":"《礼记·乐记》：“则易直子谅之心油然生矣。”宋·苏洵《族谱引》"},"example":{"text":"不敬之心～，勃然而长。","book":"鲁迅《书信集·致钱玄同》"},"similar":["情不自禁","自然而然"],"opposite":["漠然置之","戛然而止"],"usage":"作谓语、定语；指好思想等"},{"id":28614,"word":"油煎火燎","pinyin":"yóu jiān huǒ liáo","abbr":"yjhl","explanation":"形容痛苦或焦灼。","source":{"text":"他觉着，像有个什么东西，在胸口上剧烈地涌动，闹得血管里的血，也加快了流速。继而，心里又油煎火燎，阵阵剧疼。","book":"郭澄清《大刀记》第十章"},"example":{"text":"当时我心里急得～，只怕他说个不成。","book":"马烽《太阳刚刚出山》"},"similar":["火烧火燎"],"usage":"作谓语、定语、状语；指着急"},{"id":28615,"word":"油盐酱醋","pinyin":"yóu yán jiàng cù","abbr":"yyjc","explanation":"①泛指烹调佐料。比喻另外添加的原来没有的内容。②指琐碎庸俗。","source":{"text":"景翼便把阿良那节事写信给鸿甫，信里面总是加了些油盐酱醋。","book":"清·吴趼人《二十年目睹之怪现状》第三十二回"},"example":{"text":"我想女子之中，若通些文墨，必竟脱俗；就是不美，自有一种文雅可观，料不是～的恶气。","book":"《天雨花》第一回"},"similar":["柴米油盐"],"usage":"作主语、宾语、定语；指生活必需品"},{"id":28616,"word":"油腔滑调","pinyin":"yóu qiāng huá diào","abbr":"yqhd","explanation":"形容说话轻浮油滑，不诚恳，不严肃。","source":{"text":"若不多读书，多贯穿，而遽言性情，则开后学油腔滑调，信口成章之恶习矣。","book":"清·王士祯《师友诗传录》"},"example":{"text":"人们——特别是小何还是认定他～。","book":"茹志娟《新当选的团支书》"},"similar":["油嘴滑舌"],"opposite":["一本正经"],"usage":"作谓语、定语、宾语；指人说话"},{"id":28617,"word":"治一经，损一经","pinyin":"zhì yī jīng，sǔn yī jīng","abbr":"zyjsyj","explanation":"顾了这边，顾不了那边。","source":{"text":"若有些机变，未免又治一经，损一经。","book":"清·曹雪芹《红楼梦》第七十一回"}},{"id":28618,"word":"治不忘乱","pinyin":"zhì bù wàng luàn","abbr":"zbwl","explanation":"治：安定。国家太平安定的时候不能忘记防止可能出现的动乱。","source":{"text":"是故君子安而不忘危，存而不忘亡，治而不忘乱，是以身安而国家可保也。","book":"《周易·系辞下》"},"example":{"text":"宽以养民，安不忘危，～，恒以北征宵旰之勤，为南面逸豫之戒。（表·毕沅《续资治通鉴》卷一百七十六）"},"similar":["安不忘危","居安思危"],"usage":"作宾语、定语；用于书面语"},{"id":28619,"word":"治丝益棼","pinyin":"zhì sī yì fén","abbr":"zsyf","explanation":"治：整理；益：越发；棼：纷乱。理丝不找头绪，结果越理越乱。比喻解决问题的方法不对头，反而使问题更加复杂。","source":{"text":"臣闻以德和民，不闻以乱。以乱，犹治丝而棼之也。","book":"《左传·隐公四年》"},"example":{"text":"以今日外交吃紧，若舍事实而争言法理，势必旷日持久，～，陆沉之忧，悬于眉睫。","book":"蔡东藩、许廑父《民国通俗演义》第九十九回"},"similar":["理丝益棼"],"opposite":["迎刃而解"],"usage":"作宾语、补语；指处理问题的方法不对"},{"id":28620,"word":"治丝而棼","pinyin":"zhì sī ér fén","abbr":"zsef","explanation":"指理丝不找头绪，就会越理越乱。比喻解决问题的方法不正确，使问题更加复杂。","source":{"text":"臣闻以德和民，不闻以乱。以乱，犹治丝而棼之也。","book":"语出《左传·隐公四年》"},"example":{"text":"夫政出多门，非国家之福也。既有下院以代表民意，而复以上院掣肘之，是～也。","book":"梁启超《乐利主义泰斗边沁之学说·边沁之政法论》"},"similar":["治丝益棼"],"usage":"作宾语、补语；用于处事"},{"id":28621,"word":"治乱兴亡","pinyin":"zhì luàn xīng wáng","abbr":"zlxw","explanation":"安定、祸乱、振兴、灭亡。指国运的各种情况。","source":{"text":"治乱存亡，则不然，如可知，如可不知；如可见，如可不见。","book":"《吕氏春秋·察微》"},"example":{"text":"嗟呼！～之迹，为人君者，可以鉴矣。（宋·欧阳修《朋党论》）"},"similar":["治乱存亡"],"usage":"作主语、宾语、定语；用于书面语"},{"id":28622,"word":"治乱存亡","pinyin":"zhì luàn cún wáng","abbr":"zlcw","explanation":"安定、祸乱、存续、灭亡。指国运的各种情况。","source":{"text":"治乱存亡，则不然，如可知，如可不知；如可见，如可不见。","book":"《吕氏春秋·察微》"},"example":{"text":"东汉·班固《汉书·杜周传》：“后妃之制，夭寿～之端也。”"},"similar":["治乱兴亡"],"usage":"作主语、宾语、定语；用于书面语"},{"id":28623,"word":"治乱安危","pinyin":"zhì luàn ān wēi","abbr":"zlaw","explanation":"治：治理；安：安定。治理乱世，安定危局。","source":{"text":"所归善，虽恶之，赏；所归不善，虽爱之，罚；此先王之所以治乱安危也。","book":"《吕氏春秋·不苟论》"},"example":{"text":"方今幅员数万里，生齿至夥，～之要，系执政数人而已。（清·毕沅《续资治通鉴》卷五十四）"},"similar":["力挽狂澜"],"usage":"作谓语、定语；用于书面语"},{"id":28624,"word":"治乱扶危","pinyin":"zhì luàn fú wēi","abbr":"zlfw","explanation":"治：治理。治理乱世，扶持危局。","example":{"text":"他才是～的合适人选。"},"similar":["旋乾转坤"],"usage":"作谓语、定语；指扭转危局"},{"id":28625,"word":"治乱持危","pinyin":"zhì luàn chí wēi","abbr":"zlcw","explanation":"治：治理。治理乱世，安定危局。","source":{"text":"继绝世，举废国，治乱持危，朝聘以时，厚往而薄来，所以怀诸侯也。","book":"《中庸·章句》"},"example":{"text":"陛下得不亟为～之计，而可复以常日玩易之心处之乎！（《宋史·儒林传·汤汉》）"}},{"id":28626,"word":"治兵以信","pinyin":"zhì bīng yǐ xìn","abbr":"zbyx","explanation":"兵：军队。要用信义来管理军队。","source":{"text":"治兵以信，求胜以奇。","book":"晋·马隆《握奇经·八阵总论》"},"usage":"作宾语、定语；用于书面语"},{"id":28627,"word":"治兵振旅","pinyin":"zhì bīng zhèn lǚ","abbr":"zbzl","explanation":"兵：军队；旅：军旅。训练军队，振奋士气。","source":{"text":"乃使旁告于诸侯，治兵振旅，呜钟鼓，以至于宋。","book":"《国语·晋语五》"},"example":{"text":"乃～，为仁义之师，长驱东向，而欲天下向应，盖亦难矣。（宋·周密《齐东野语》卷一）"},"usage":"作谓语、宾语；用于书面语"},{"id":28628,"word":"治国安民","pinyin":"zhì guó ān mín","abbr":"zgam","explanation":"治：治理；安：安定。治理国家，安定人民。","source":{"text":"财者，帝王所以聚人守位，养成群生，奉顺天德，治国安民之本也。","book":"《汉书·食货志上》"},"example":{"text":"十一届三中全会以来，中央政府实行了一整套～的措施。"},"similar":["治国安邦"],"opposite":["祸国殃民"],"usage":"作谓语、定语；用于统治者"},{"id":28629,"word":"治国安邦","pinyin":"zhì guó ān bāng","abbr":"zgab","explanation":"治理国家，使之太平、安定。","source":{"text":"不能勾治国安邦朝帝阙，常只是披霜带月似檐中。","book":"元·无名氏《猿听经》第一折"},"example":{"text":"王朔《谁比谁傻多少》：“咱们女人图什么？又不想开天辟地，～，图的不就是个舒服吗？”"},"similar":["治郭安邦"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28630,"word":"治国齐家","pinyin":"zhì guó qí jiā","abbr":"zgqj","explanation":"齐：整治。整治家庭和治理国家。","source":{"text":"所谓治国必先齐其家者，其家不可教，而能教人者，无之。故君子不出家而成教于国。","book":"《礼记·大学》"},"example":{"text":"说与你夫人爱女休禽犊，馆明师茶饭须清楚。你看俺～、也则是数卷书。","book":"明·汤显祖《牡丹亭·训女》"},"similar":["修身齐家治国平天下","修齐治平"],"usage":"作宾语、定语；用于书面语"},{"id":28631,"word":"治标不治本","pinyin":"zhì biāo bù zhì běn","abbr":"zbbzb","explanation":"治：治理；标：树梢，指事物枝节、表面。仅就显露在外面的毛病加以应急的处理，而不是从根本上加以治理。形容处理问题不彻底。","example":{"text":"你这样做～"},"opposite":["标本兼治"],"usage":"作宾语、定语；用于处事"},{"id":28632,"word":"治气养生","pinyin":"zhì qì yǎng shēng","abbr":"zqys","explanation":"治气：修养气度。指修养精神，保养身体","source":{"text":"扁善之度，以治气养生，则身后彭祖；以修身自强，则名配尧、禹。","book":"战国·赵·荀况《荀子·修身》"},"usage":"作宾语、定语；用于书面语"},{"id":28633,"word":"治病救人","pinyin":"zhì bìng jiù rén","abbr":"zbjr","explanation":"治好病把人挽救过来。比喻帮助犯错误的人改正错误。","source":{"text":"沈羲，吴郡人，学道于蜀，能治病救人，甚有恩德。","book":"晋·葛洪《神仙传》"},"example":{"text":"我们应该抱着～的态度来帮助他，挽救他。","book":"陈登科《风雷》第一部第59章"},"similar":["救死扶伤"],"opposite":["落井下石","致人死地"],"usage":"作谓语、宾语、定语；常与“惩前毖后”连用"},{"id":28634,"word":"治谱家传","pinyin":"zhì pǔ jiā chuán","abbr":"zpjc","explanation":"谱：治理的方案。管理方案只传给子孙。后形容父子兄弟作官都有政绩。","source":{"text":"琰父子并著奇绩，江左鲜有。世云诸傅有治县谱，子孙相传，不以示人。","book":"《南齐书·傅琰传》"},"usage":"作宾语、定语；用于书面语"},{"id":28635,"word":"治郭安邦","pinyin":"zhì guō ān bāng","abbr":"zgab","explanation":"犹治国安邦。","source":{"text":"间有古之长仆，亦有治郭安邦之功，救世保民之力，其形象概亦毁之，其意何也？","book":"太平天国·洪仁玕《英杰归真》"},"similar":["治国安邦"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28636,"word":"治阿之宰","pinyin":"zhì ē zhī zǎi","abbr":"zazz","explanation":"治：治理。治理东阿的地方官。后泛指有才能，治理有方的官吏。","source":{"text":"若才实拔群，进宜尚德，治阿之宰，不必计年，免徒之守，岂限资秩。","book":"《晏子春秋·杂上》记载：晏子曾为东阿地方官，治理有方，三年后誉满全国。《宋书·王华传》"},"example":{"text":"我也是一个～"},"usage":"作主语、宾语；用于书面语"},{"id":28637,"word":"沽名卖直","pinyin":"gū míng mài zhí","abbr":"gmmz","explanation":"故作正直以猎取名誉。","source":{"text":"伯巨、敬心以缝掖诸生言天下至计，虽违于信而后谏之义，然原厥本心，由于忠爱，以视末季沽名卖直之流，有不可同日而语者也。","book":"《明史·钱唐韩宜可等传赞》"},"similar":["沽誉买直"],"usage":"作谓语、宾语、定语；用于处世"},{"id":28638,"word":"沽名吊誉","pinyin":"gū míng diào yù","abbr":"gmdy","explanation":"指用某种不正当的手段捞取名誉。同“沽名钓誉”。","source":{"text":"我不为别的，自恨我奔丧来后，又不是沽名吊誉没来由。","book":"元·宫天挺《范张鸡黍》第三折"},"example":{"text":"不似他每逞英雄，～，试剑咶骢，不思映雪与囊萤，心机枉空用。","book":"明·杨柔胜《玉环记·富童谮非》"},"similar":["沽名干誉","沽名钓誉","沽誉钓名"],"usage":"作谓语、宾语、定语；指人猎取名誉"},{"id":28639,"word":"沽名干誉","pinyin":"gū míng gàn yù","abbr":"gmgy","explanation":"犹沽名钓誉。指用某种不正当的手段捞取名誉。","source":{"text":"追想我昔日纠劾仇贼，岂是沽名干誉。","book":"明·无名氏《鸣凤记·驿里相逢》"},"similar":["沽名吊誉","沽名钓誉","沽誉钓名"],"usage":"作谓语、宾语、定语；指人猎取名誉"},{"id":28640,"word":"沽名要誉","pinyin":"gū míng yào yù","abbr":"gmyy","explanation":"犹沽名钓誉。指用某种不正当的手段捞取名誉。","source":{"text":"子张问闻与达一章，达是躬行实践做出来底，闻是沽名要誉底。","book":"《朱子语类》卷四二"},"similar":["沽名钓誉","沽名邀誉"],"usage":"作谓语、宾语、定语；指人猎取名誉"},{"id":28641,"word":"沽名邀誉","pinyin":"gū míng yāo yù","abbr":"gmyy","explanation":"沽：通“酤”，买；邀：求得。以不正当的手法博取名誉。","source":{"text":"若此税不当收，潢当请豁免，何得以公指代完，沽名邀誉？","book":"《清史稿·迈柱传》"},"example":{"text":"清·吴璿《飞龙全传》第29回：“非是在下～，妄断乡评，只为俺一生最喜锄强扶弱，屏恶携良。”"},"similar":["沽名钓誉","沽名要誉"],"usage":"作谓语、宾语、定语；指人猎取名誉"},{"id":28642,"word":"沽名钓誉","pinyin":"gū míng diào yù","abbr":"gmdy","explanation":"沽：买；钓：用饵引鱼上钩，比喻骗取。用某种不正当的手段捞取名誉。","source":{"text":"彼虽硁硁有类沽名者。","book":"《管子·法法》：“钓名之人，无贤士焉。”《后汉书·逸民传序》"},"example":{"text":"我只道你只不过是～，却不道长他的志气，灭我的威风。","book":"明·张凤翼《灌园记·齐王拒谏》"},"similar":["盗名窃誉","好大喜功"],"opposite":["实至名归","名不虚传"],"usage":"作谓语、宾语、定语；指人猎取名誉"},{"id":28643,"word":"沽激虚名","pinyin":"gū jī xū míng","abbr":"gjxm","explanation":"沽激：伪装真情骗取名誉；虚名：虚有的，不副实际的名声。指通过伪装骗取名誉。","source":{"text":"康节先公深达世务，不以沽激取虚名。","book":"宋·邵伯温《闻见前录》卷十九"},"usage":"作谓语、定语、宾语；指骗名誉"},{"id":28644,"word":"沽誉买直","pinyin":"gū yù mǎi zhí","abbr":"gymz","explanation":"故作正直以猎取名誉。同“沽名卖直”。","source":{"text":"若方其争论新法之际，便行窜黜，谓之立异好胜，谓之沽誉买直，谓之非上所建立，谓之不能体国，谓之不遵禀处分，言章交攻，命令切责，亦不能成其美矣。","book":"《续资治通鉴·宋高宗建炎二年》"},"similar":["沽名卖直"],"usage":"作谓语、宾语、定语；用于处世"},{"id":28645,"word":"沽誉钓名","pinyin":"gū yù diào míng","abbr":"gydm","explanation":"指用某种不正当的手段捞取名誉。同“沽名钓誉”。","source":{"text":"并非沽誉钓名，不过稍尽棉力。","book":"《“五四”爱国运动资料·上海罢市实录》"},"example":{"text":"我并非要～，只是想尽一点绵薄之力罢了"},"similar":["沽名钓誉","沽名吊誉","沽名干誉"],"usage":"作谓语、宾语、定语；指人猎取名誉"},{"id":28646,"word":"沽酒当垆","pinyin":"gū jiǔ dāng lú","abbr":"gjdl","explanation":"沽：卖；当垆：古代酒店垒土成垆，用以安放酒瓮，卖酒的人守在垆边，叫做当垆。原指古代卖酒的人。后引申为名士隐身于尘世间。","source":{"text":"想当日沽酒当垆，拚了个三不归青春卓氏女。","book":"元·关汉卿《温太真玉镜台》第四折"},"example":{"text":"信两个无端贼子，终日去～，把家私渐行消磨，使妾身难以支吾。","book":"元·无名氏《杀狗劝夫》第四折"},"usage":"作宾语、定语；用于书面语"},{"id":28647,"word":"沾丐后人","pinyin":"zhān gài hòu rén","abbr":"zghr","explanation":"沾：因为有关系而得到好处；丐：施与。给后人以好处。","source":{"text":"至甫，浑涵汪茫，千汇万状，兼古今而有之，它人不足，甫乃厌余，残膏賸馥，沾丐后人多矣。","book":"《新唐书·杜甫传赞》"}},{"id":28648,"word":"沾亲带友","pinyin":"zhān qīn dài yǒu","abbr":"zqdy","explanation":"有亲戚朋友的关系。","source":{"text":"因此上装一个送饭的沾亲带友，那一个管牢的便不乱扯胡揪。","book":"元·高文秀《黑旋风》第四折"},"similar":["沾亲带故"],"usage":"作宾语、定语；用于人际关系等"},{"id":28649,"word":"沾亲带故","pinyin":"zhān qīn dài gù","abbr":"zqdg","explanation":"故：故人，老友。有亲戚朋友的关系。","source":{"text":"因此上装一个送饭的沾亲带友，那一个管牢的便不乱扯胡揪。","book":"元·高文秀《黑旋风》第四折"},"example":{"text":"于是～，平日受过赈济，平粜过米粮，城里城外的士民百姓，十分中倒来了九分九厘。","book":"《醒世姻缘》第九十回"},"similar":["沾亲带友"],"usage":"作定语；指有亲戚关系"},{"id":28650,"word":"沾体涂足","pinyin":"zhān tǐ tú zú","abbr":"zttz","explanation":"沾：浸湿；涂：泥。身体被沾湿，足被沾上了泥土。形容耕作的劳苦。","source":{"text":"沾体涂足，暴其发肤，尽其四支之敏，以从事于田野。","book":"《国语·齐语》"},"usage":"作谓语、定语；用于书面语"},{"id":28651,"word":"沾沾自喜","pinyin":"zhān zhān zì xǐ","abbr":"zzzx","explanation":"形容自以为不错而得意的样子。","source":{"text":"魏其者，沾沾自喜耳。","book":"《史记·魏其武安侯列传》"},"example":{"text":"然而象他那样的人，决不至于让某一件事的胜利弄得～，就此满足。","book":"茅盾《子夜》五"},"similar":["自鸣得意","沾沾自满"],"opposite":["垂头丧气","灰心丧气"],"usage":"作谓语、定语、状语；指人自鸣得意","story":["西汉汉武帝的母亲窦太后排挤窦婴，窦婴称病回家。吴、楚七国叛乱，汉景帝拜窦婴为大将军去平定叛乱。窦婴对皇帝所赐的金银很不在意，平定叛乱后，窦婴被封为魏其侯。窦太后改变陈见想让他出任丞相，汉景帝认为他在沾沾自喜就作罢"]},{"id":28652,"word":"沾沾自好","pinyin":"zhān zhān zì hào","abbr":"zzzh","explanation":"犹言沾沾自喜。","source":{"text":"好善与强知虑多闻识正相违，强知多闻必沾沾自好。","book":"明·袁宗道《读〈孟子〉》"},"similar":["沾沾自满","沾沾自喜","沾沾自足"],"usage":"作谓语、定语、状语；用于书面语"},{"id":28653,"word":"沾沾自满","pinyin":"zhān zhān zì mǎn","abbr":"zzzm","explanation":"犹言沾沾自喜。","source":{"text":"但文采正在沾沾自满于对江世荣的胜利的时候，他并不懂得这只是激动了群众的情绪，这还不能说，群众已完全觉悟，形成了一个运动。","book":"丁玲《太阳照在桑干河上》三九"},"similar":["沾沾自好","沾沾自足","沾沾自喜"],"usage":"作谓语、定语、状语；用于书面语"},{"id":28654,"word":"沾沾自衒","pinyin":"zhān zhān zì xuàn","abbr":"zzzx","explanation":"自以为美好而自我炫耀。","source":{"text":"［锺谟李德明］天资皆浮躁，沾沾自衒。","book":"宋·陆游《南唐书·锺谟传》"},"similar":["沾沾自满","沾沾自喜"],"usage":"作谓语、定语、状语；用于书面语"},{"id":28655,"word":"沾沾自足","pinyin":"zhān zhān zì zú","abbr":"zzzz","explanation":"沾沾：飘飘然的样子。形容自以为不错而得意满足的样子。","source":{"text":"立一善，修一行，沾沾自足，怠而不复前矣。","book":"《史记·魏其武安侯列传》：“魏其者，沾沾自喜耳，多易，难以为相持重。”宋·吕祖谦《东莱博议》"},"example":{"text":"鼐得书甚喜，宣示友人。～，适以取祸。（蔡东藩《明史演义》第四十三回）"},"similar":["沾沾自好","沾沾自满","沾沾自喜"],"usage":"作谓语、定语、状语；用于书面语"},{"id":28656,"word":"沾泥带水","pinyin":"zhān ní dài shuǐ","abbr":"znds","explanation":"比喻说话、写文章不简洁或办事不干脆。","source":{"text":"一有字迹，则沾泥带水，有不如无矣。","book":"清·李渔《闲情偶寄·演习·授曲》"},"similar":["拖泥带水"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":28657,"word":"沾泥絮","pinyin":"zhān ní xù","abbr":"znx","explanation":"沾上泥土的柳絮不再飞扬。比喻人心情孤寂，不因外界影响而动心。","source":{"text":"消得留春春且住。不比杨花，轻作沾泥絮。","book":"宋·参寥《答杭妓》：“禅心已作沾泥絮，不逐春风上下狂。”宋·吴潜《蝶恋花·和处静木香》"},"example":{"text":"禅心已作～， 莫向春风舞鹧鸪。（清·曹雪芹《红楼梦》第九十一回）"}},{"id":28658,"word":"沾溉后人","pinyin":"zhān gài hòu rén","abbr":"zghr","explanation":"沾溉：沾润灌溉，引申为使人受益。使后来人得到好处","source":{"text":"他人不足，甫乃厌余，残膏剩馥，沾丐后人多矣。","book":"《新唐书·杜甫传赞》"},"usage":"作谓语、定语；用于书面语"},{"id":28659,"word":"沾花惹草","pinyin":"zhān huā rě cǎo","abbr":"zhrc","explanation":"犹言沾风惹草。","source":{"text":"对了，说她是那种逗引男人去沾花惹草的妖冶，肯定百分之百的正确！","book":"《花城》1981年第5期"},"example":{"text":"男人最好不要去～。"},"similar":["拈花惹草"],"usage":"作谓语、宾语、定语；指好色"},{"id":28660,"word":"沾风惹草","pinyin":"zhān fēng rě cǎo","abbr":"zfrc","explanation":"比喻卖弄风流，挑逗、勾引异性。","source":{"text":"左右街坊，有几个奸诈浮浪子弟，晙见了武大这个老婆，打扮油样，沾风惹草，被这干人在街上，撒谜语，往来嘲戏。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"similar":["沾花惹草"],"usage":"作谓语、定语、宾语；多用于男性"},{"id":28661,"word":"沿才受职","pinyin":"yán cái shòu zhí","abbr":"ycsz","explanation":"根据人的才能授以相称的职务。","source":{"text":"南朝·齐·王融《永明十一年策秀才文》：“必待天爵具修，人纪咸事，然后沿才受职，揆务分司。”。受，一本作“授”。"},"similar":["沿才授职"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":28662,"word":"沿才授职","pinyin":"yán cái shòu zhí","abbr":"ycsz","explanation":"根据人的才能委以相称的职务。","source":{"text":"必待天爵具修，人纪咸事，然后沿才授职，揆务公司。","book":"南朝·齐·王融《永明十一年策秀才文》"},"example":{"text":"选拔人才应该～，千万不能拍脑袋"},"similar":["沿才受职"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":28663,"word":"沿泝阻绝","pinyin":"yán sù zǔ jué","abbr":"yszj","explanation":"泝：通“溯”，逆流而上。顺流而下和逆流而上的船舶都被阻隔不能行驶。","source":{"text":"至于夏水襄陵，沿泝阻绝。","book":"北魏·郦道元《水经注·江水》"}},{"id":28664,"word":"沿波讨源","pinyin":"yán bō tǎo yuán","abbr":"ybty","explanation":"沿波：顺着水流；讨源：探索源头。循着水流寻找源头。原比喻作文时由次要的写到主要的，最后点出主题。后比喻探讨事物的本末。","source":{"text":"或因枝以振叶，或沿波而讨源。","book":"晋·陆机《文赋》"},"example":{"text":"观文者披文以人情，～，虽幽必显。","book":"南朝·梁·刘勰《文心雕龙·知音》"},"similar":["顺藤摸瓜","追本溯源"],"usage":"作谓语、定语；指追求事物本源"},{"id":28665,"word":"沿流求源","pinyin":"yán liú qiú yuán","abbr":"ylqy","explanation":"沿流：顺着水流；求源：探索源头。循着水流寻找源头。原比喻作文时由次要的写到主要的，最后点出主题。后比喻探讨事物的本末。","source":{"text":"或因枝以振叶，或沿波而讨源。","book":"晋·陆机《文赋》"},"example":{"text":"况夫之派之疏近不齐，世家之隆替不一，贤而上或无所传，愚而前虽有所作欲冀～不可得也。","book":"宋·刘经《庆源集序》"}},{"id":28666,"word":"沿流溯源","pinyin":"yán liú sù yuán","abbr":"ylsy","explanation":"沿流：顺着水流；溯源：探索源头。循着水流寻找源头。原比喻作文时由次要的写到主要的，最后点出主题。后比喻探讨事物的本末。","source":{"text":"或因枝以振叶，或沿波而讨源。","book":"晋·陆机《文赋》"},"example":{"text":"庶考因革者，得以～，详稽一代之制焉。","book":"《清史稿·舆服志》"},"similar":["沿流讨源","沿波讨源"],"usage":"作谓语、定语；指追求事物本源"},{"id":28667,"word":"沿流讨源","pinyin":"yán liú tǎo yuán","abbr":"ylty","explanation":"沿流：顺着水流；讨源：探索源头。循着水流寻找源头。原比喻作文时由次要的写到主要的，最后点出主题。后比喻探讨事物的本末。","source":{"text":"或因枝以振叶，或沿波而讨源。","book":"晋·陆机《文赋》"},"example":{"text":"其勉人治群学者，意则谓天下～，执因责果之事，惟群事为最难，非不素讲者之所得与。","book":"严复《原强》"},"similar":["沿流溯源","沿波讨源"],"usage":"作谓语、定语；指追求事物本源"},{"id":28668,"word":"沿门托钵","pinyin":"yán mén tuō bō","abbr":"ymtb","explanation":"钵：和尚吃东西用的器具。原指僧徒化缘。比喻挨家乞讨。","source":{"text":"故读者于此等处最要分别，不然则视少陵为随地蓦缘，沿门托钵者流矣。","book":"清·无名氏《杜诗言志》卷一"},"example":{"text":"却说仲勋穷途落魄，流入乞丐道中，终日在街头～，到了夜间，就在人家屋檐底下歇宿。","book":"清·彭养鸥《黑籍冤魂》第二十回"},"similar":["沿门持钵"],"usage":"作谓语、定语；指乞讨"},{"id":28669,"word":"沿门持钵","pinyin":"yán mén chí bō","abbr":"ymcb","explanation":"原指僧、尼挨门向人求布施，后泛指到处乞求施舍。","source":{"text":"若天分之我不承受，此家当，我却无分了，便至沿门持钵，仰息他人。","book":"明·高攀龙《讲义·君子所性仁义礼智根于心》"},"similar":["沿门托钵","托钵沿门"],"usage":"作谓语、定语；指乞讨"},{"id":28670,"word":"沿门讬钵","pinyin":"yán mén tuō bō","abbr":"ymtb","explanation":"泛指到处乞求施舍。同“沿门持钵”。","source":{"text":"你若借了这事，向亲友各家不问交谊一概的沿门讬钵摇尾乞怜起来，就大不是我的意思了！","book":"清·文康《儿女英雄传》第十二回"}},{"id":28671,"word":"泄泄沓沓","pinyin":"xiè xiè tà tà","abbr":"xxtd","explanation":"本指多言，罗嗦。后转义指拖拖沓沓。","source":{"text":"泄泄犹沓沓也。事君无义，进退天礼，言则非先王之道者，犹沓沓也。","book":"《孟子·离娄上》"},"example":{"text":"今上十一年来吁食宵衣，孜孜求治而天下日乱，以严刑峻法督责臣工而臣工徇私害公，～如故。","book":"姚雪垠《李自成》第一卷第二十六章"},"usage":"作谓语、状语；用于书面语"},{"id":28672,"word":"泄漏天机","pinyin":"xiè lòu tiān jī","abbr":"xltj","explanation":"天机：旧指神秘不可知的天意。借指特别秘密的事。指向人透露了不应该让人知道的神秘天意（迷信）或重要秘密。亦作“天机不可泄漏”、“漏泄天机”、“泄露天机”","source":{"text":"回见管辂，教再休泄漏天机；不然，必致天谴。","book":"明·罗贯中《三国演义》第六十九回"},"example":{"text":"清·李汝珍《镜花缘》第48回：“若说出实情，又恐～，致生灾患。”"},"similar":["泄露天机"],"usage":"作谓语、宾语、定语；用于处事"},{"id":28673,"word":"泄露天机","pinyin":"xiè lòu tiān jī","abbr":"xltj","explanation":"天机：旧指神秘不可知的天意，借指很秘密的事。比喻泄露秘密。","source":{"text":"稚子问翁新语处，欲言直恐泄天机。","book":"宋·陆游《醉中草书因戏作此》诗"},"example":{"text":"君此去切不可～，恐遭大祸。","book":"明·冯梦龙《古今小说·李公子救蛇获称心》"},"similar":["天机泄露","泄漏天机"],"opposite":["缄口不言","保守秘密"],"usage":"作谓语；指泄露秘密"},{"id":28674,"word":"泉下之客","pinyin":"quán xià zhī kè","abbr":"qxzk","explanation":"泉：黄泉。指做鬼。","source":{"text":"想起宋万这人，虽然不曾立得奇功，当初梁山泊开创之时，多亏此人。今日作泉下之客！","book":"明·施耐庵《水浒传》第111回"},"usage":"作宾语；指死人"},{"id":28675,"word":"泉石之乐","pinyin":"quán shí zhī lè","abbr":"qszl","explanation":"泉石：指山水、泉石名胜之处；乐：乐趣。比喻生活在山水园林之中，享受其中的乐趣。","source":{"text":"闻将军兴仁义之师，大驾到城，倾心愿投麾下，不思爵禄之荣，惟求泉石之乐。","book":"明·清溪道人《禅真逸史》第二十九回"}},{"id":28676,"word":"泉石膏肓","pinyin":"quán shí gāo huāng","abbr":"qsgh","explanation":"泉石：指山水；膏肓：古人把心尖脂肪叫“膏”，心脏和隔膜之间叫“肓”，据说这是药力达不到的地方。比喻嗜好山水成癖。","source":{"text":"臣所谓泉石膏肓，烟霞固疾者。","book":"《新唐书·田游岩传》"},"example":{"text":"～，自叙不仁之意。","book":"宋·胡继宗《书言故事·隐逸类》"},"usage":"作宾语；比喻嗜好山水成癖","story":["唐朝时期，唐高宗游览嵩山时，隐士田游岩前去拜见。唐高宗便问田游岩：“先生在此山养道是否感觉不错？”田游岩回答道：“我非常喜欢山林泉水石头这些自然景观，而且嗜之成癖，不可救药了。因此感觉十分逍遥。”"]},{"id":28677,"word":"泉石膏肓，烟霞痼疾","pinyin":"quán shí gāo huāng，yān xiá gù jí","abbr":"qsghyxgj","explanation":"膏肓：病情严重；痼疾：久治不愈的病。形容爱好山水林泉，烟雾云霞，已经成为难以改变的癖好。","source":{"text":"臣所谓泉石膏肓，烟霞固疾者。","book":"《新唐书·田游岩传》"}},{"id":28678,"word":"泓峥萧瑟","pinyin":"hóng zhēng xiāo sè","abbr":"hzxs","explanation":"形容诗文意境深远。引申指幽雅恬静。","source":{"text":"郭景纯诗云：‘林无静树，川无停流。’阮孚云：‘泓峥萧瑟，实不可言。每读此文，辄觉神超形越。’","book":"南朝宋刘义庆《世说新语·文学》"},"example":{"text":"～不可言，周遭水木亭轩。","book":"清黄遵宪《诸君子约游后乐园》诗"},"usage":"作谓语、定语；用于诗文"},{"id":28679,"word":"泓涵演迤","pinyin":"hóng hán yǎn yǐ","abbr":"hhyy","explanation":"泓：水深；涵：包含；演：长流；迤：延伸。比喻学问渊博精深。","source":{"text":"泓涵演迤，日以大肆。","book":"唐·韩愈《蓝田县丞厅壁记》"}},{"id":28680,"word":"法不传六耳","pinyin":"fǎ bù chuán liù ěr","abbr":"fbcle","explanation":"指极端秘密，不能让第三者知道。","source":{"text":"这话可法不传六耳。","book":"《儿女英雄传》第四回"},"example":{"text":"佛门有句话，～。大师父总该知道。","book":"《花城》1981年第4期"},"usage":"作谓语、宾语、定语；用于口语"},{"id":28681,"word":"法不容情","pinyin":"fǎ rù róng qíng","abbr":"fbrq","explanation":"在法律面前不能容许人情宽容。","example":{"text":"谁都明白～。"},"usage":"作宾语、定语；用于法律方面"},{"id":28682,"word":"法不徇情","pinyin":"fǎ bù xùn qíng","abbr":"fbxq","explanation":"法：法律；徇：偏私；情：人情，私情。法律不徇私情。指执法公正，不讲私人感情。","source":{"text":"居家为父子，受事为君臣，法不徇情，尔直深戒。","book":"明·罗贯中《三国演义》第七十二回"},"similar":["法不容情"],"usage":"作宾语、定语；用于政策等"},{"id":28683,"word":"法不责众","pinyin":"fǎ bù zé zhòng","abbr":"fbzz","explanation":"责：责罚；众：多数人。指某种行为即使应受到法律的惩罚，但很多人都那样干，也就不好惩罚了","source":{"text":"大家一议论，法不责众，全走了。","book":"清·石玉昆《小五义》第38回"},"similar":["罚不责众"],"usage":"作宾语、定语；用于口语"},{"id":28684,"word":"法不阿贵","pinyin":"fǎ bù ē guì","abbr":"fbeg","explanation":"法：法律；阿：偏袒。法律即使是对高贵的人，有权势的人也不徇情。形容执法公正，法律面前人人平等。","source":{"text":"法不阿贵，绳不绕曲。法之所加，智者弗能辞，勇者弗敢争，刑过不避大臣，赏善不遗匹夫。","book":"《韩非子·有度》"},"example":{"text":"做到～可能会遇到种种习惯势力的阻挠，因此，我们一定执法守法，坚决顶住歪风邪气的侵袭。"},"similar":["铁面无私","法网无情"],"opposite":["徇私枉法","贪赃枉法"],"usage":"作宾语、定语、分句；指法律面前人人平等"},{"id":28685,"word":"法出一门","pinyin":"fǎ chū yī mén","abbr":"fcym","explanation":"指法律统一，前后一致，不能随意变通。","source":{"text":"法出一门，然后人知恒禁，吏无淫巧，政明于上，民安于下。","book":"《艺文类聚》卷五四引晋杜预《奏事》"},"similar":["法无二门"],"opposite":["法出多门"],"usage":"作谓语、定语；用于政策等"},{"id":28686,"word":"法出多门","pinyin":"fǎ chū duō mén","abbr":"fcdm","explanation":"门：门径。指各部门各自为政，自立法制，使法令不能统一，无从执行。","source":{"text":"或正刑于外则破律于中，法出多门，人无所措。","book":"北宋·欧阳修《新唐书·刘贲传》"},"example":{"text":"我们不希望看到～的局面。"},"similar":["政出多门"],"opposite":["法出一门"],"usage":"作宾语、定语；指各自为政","story":["唐朝时期，内侍省权重一时，他们挟制天子，横行海内，无法无天。唐文宗想摆脱这种场面，下诏让正直的人上疏辩政之疵，以便量才录用。幽州进士刘贲上疏说豪门猾吏之所以敢不守法度，是因为法出多门，造成有令不止"]},{"id":28687,"word":"法力无边","pinyin":"fǎ lì wú biān","abbr":"flwb","explanation":"法力：佛教中指佛法的力量；后泛指神奇超人的力量。佛法的力量没有边际。比喻力量极大而不可估量。","source":{"text":"小圣我法力无边，通天达地，指山山崩，指水水跑。","book":"明·无名氏《八仙过海》第三折"},"example":{"text":"万万众人天列宝阶，将我佛仰戴，～，不用编排。","book":"明·无名氏《哪吒三变》第三折"},"usage":"作宾语、定语；比喻力量极大"},{"id":28688,"word":"法外施仁","pinyin":"fǎ wài shī rén","abbr":"fwsr","explanation":"旧时指宽大处理罪犯。","source":{"text":"其驰驱通义一带，亦不无微劳可悯，乞皇上法外施仁。","book":"明·李清《三垣笔记·崇祯》"},"example":{"text":"当朝的圣人最恼的贪官污吏，也还算～，止于把他革职，发往军台效力。","book":"清·文康《儿女英雄传》第十三回"},"similar":["从宽发落","法外施恩"],"usage":"作宾语、分句；指宽大处理罪犯"},{"id":28689,"word":"法外施恩","pinyin":"fǎ wài shī ēn","abbr":"fwse","explanation":"施：施行，给予。超越法律而给予恩惠。指宽大处理，免施刑罚。","source":{"text":"仍照皇祖所降谕旨，给予一等男爵，世袭罔替，已足以示国家法外施恩，旧勋之意矣。","book":"清·梁章钜《归田琐记·鳌拜》"},"example":{"text":"章诒和《往事并不如烟·斯人寂寞》：“烦劳他找到山西省负责人，能否为聂绀弩‘～’。”"},"similar":["法外施仁"],"usage":"作宾语、分句；指宽大处理罪犯"},{"id":28690,"word":"法家拂士","pinyin":"fǎ jiā bì shì","abbr":"fjbs","explanation":"拂：通“弼”。法家：明法度的大臣；拂士：辅弼之士。指忠臣贤士。","source":{"text":"入则无法家拂士，出则无敌国外患者，国恒亡。","book":"《孟子·告子下》"},"example":{"text":"孟轲言～，荀卿称家言邪学，百家无所窜，小家珍说之所愿皆衰，其遗迹也。","book":"清·章炳麟《订孔上》"},"similar":["忠臣贤士"],"usage":"作宾语、定语；指忠臣贤士"},{"id":28691,"word":"法成令修","pinyin":"fǎ chéng lìng xiū","abbr":"fclx","explanation":"指有法律为依据，行政命令也恰当。","source":{"text":"法成令修，治出张施。","book":"唐·韩愈《曹成王碑》"},"usage":"作宾语、定语；用于政策等"},{"id":28692,"word":"法无二门","pinyin":"fǎ wú èr mén","abbr":"fwem","explanation":"指法律统一，前后一致，不能随意变通。同“法出一门”。","source":{"text":"有犯罪当死者，宰相欲从末减。德基曰：‘法无二门，失出犹失入也。’不从。","book":"《金史·高德基传》"},"similar":["法出一门"],"usage":"作谓语、定语；用于政策等"},{"id":28693,"word":"法无可贷","pinyin":"fǎ wú kě dài","abbr":"fwkd","explanation":"指按法律不可宽恕。","source":{"text":"《清史稿·刑法志一》；“强盗分别法无可贷、情有可原，歼渠魁、赦胁从之义也。”"},"example":{"text":"[马子畦]实属甘心从逆，～，应请即予就地正法，以昭炯戒。","book":"中国近代史资料丛刊《辛亥革命·徐锡麟安庆起义清方档案》"},"opposite":["情有可原"],"usage":"作宾语、定语；指不能原谅的"},{"id":28694,"word":"法有定论，兵无常形","pinyin":"fǎ yǒu dìng lùn，bīng wú cháng xíng","abbr":"fydlbwcx","explanation":"法：兵法；论：论断；形：方法。兵法上虽有确定的论断，然而用兵作战却没有固定不变的方法。比喻做事要根据实际采取灵活的措施。","source":{"text":"法有定论，而兵无常形，一旦之内，一阵之间，离合取舍，其变无穷。","book":"宋·何去非《何博士备论·霍去病论》"}},{"id":28695,"word":"法海无边","pinyin":"fǎ hǎi wú biān","abbr":"fhwb","explanation":"佛教中比喻佛法广大如大海，无边无际。"},{"id":28696,"word":"法灸神针","pinyin":"fǎ jiǔ shén zhēn","abbr":"fjsz","explanation":"神奇的针灸技术。","source":{"text":"虽不会法灸神针，更胜似救苦难观世音。","book":"元·王实甫《本厢记》第三本第四折"},"usage":"作宾语、定语；用于称赞医术等"},{"id":28697,"word":"法眼通天","pinyin":"fǎ yǎn tōng tiān","abbr":"fytt","explanation":"法眼：佛教中所谓有“五眼”之一，能看见实相。法眼能看穿天。比喻人的眼力卓越精深，看得很远。"},{"id":28698,"word":"法脉准绳","pinyin":"fǎ mài zhǔn shéng","abbr":"fmzs","explanation":"犹言法则标准。","source":{"text":"尝怪天地之间，有一种文字，即有一种文字之法脉准绳载之于书者。","book":"清·李渔《闲情偶寄·词曲·授曲》"},"usage":"作宾语、定语；指标准等"},{"id":28699,"word":"法贵必行","pinyin":"fǎ guì bì xíng","abbr":"fgbx","explanation":"法律贵在切实执行。","source":{"text":"法贵必行，慎在深刻，裕其治以便俗，严其令以惩违，微损有余，稍优不足。","book":"《资治通鉴·唐纪·德宗贞元十年》"},"usage":"作宾语、定语；用于政策等"},{"id":28700,"word":"法轮常转","pinyin":"fǎ lún cháng zhuàn","abbr":"flcz","explanation":"法轮：佛家语，轮有二义，一为运转，一为摧碾，佛运转心中清净妙法以度人，且摧毁世俗一切邪惑之见。指佛法无边，普济众生。","source":{"text":"三转法轮于大千，其轮本来常清净。","book":"《维摩诘所说经·佛国品》"},"example":{"text":"此一炷香，愿～，佛日增辉。","book":"元·吴昌龄《东坡梦》第四折"},"usage":"作宾语、定语；用于佛教"},{"id":28701,"word":"泛宅浮家","pinyin":"fàn zhái fú jiā","abbr":"fzfj","explanation":"指以船为家。","source":{"text":"老身长子知无憾，泛宅浮家苦未能。","book":"宋·张元干《临江仙·送宇文德和被召赴行在所》词：“泛宅浮家游戏去，流行坎止忘怀。江边鸥鹭莫相猜。上林消息好，鸿雁已归来。”宋·陆游《书志》诗"},"example":{"text":"杨柳外，羡～，当日元真子。","book":"元·韦居安《梅磵诗话》卷下"}},{"id":28702,"word":"泛家浮宅","pinyin":"fàn jiā fú zhái","abbr":"fjfz","explanation":"泛：漂浮水上。形容以船为家，浪迹江湖。","source":{"text":"泛家浮宅，不知老之将至。","book":"明·袁宏道《锦帆集·尺牍·龚惟长先生》"},"similar":["浮家泛宅"],"usage":"作宾语、定语；指浪迹江湖"},{"id":28703,"word":"泛应曲当","pinyin":"fàn yīng qǔ dāng","abbr":"fyqd","explanation":"指广泛适应，无不恰当。","source":{"text":"若得胸中义理明，从此去量度事物，自然泛应曲当。","book":"《朱子语类》卷十三"},"example":{"text":"这（辩证唯物论）并不是外来的异物，而是～的真理。","book":"郭沫若《海涛集·跨着东海》"},"usage":"作谓语、定语；用于书面语"},{"id":28704,"word":"泛泛之交","pinyin":"fàn fàn zhī jiāo","abbr":"ffzj","explanation":"泛泛：一般，平常。交情不深的朋友。","source":{"text":"朋友交游，固有深浅，若泛然之交，一一要周旋，也不可。","book":"宋·朱熹《朱子语类》卷三十八"},"example":{"text":"或全不交际，或普作～际。","book":"鲁迅《书信集·致章廷谦》"},"similar":["一面之交"],"opposite":["生死之交"],"usage":"作宾语；形容交情不深"},{"id":28705,"word":"泛泛之人","pinyin":"fàn fàn zhī rén","abbr":"ffzr","explanation":"泛泛：平常，一般。一般的人。指不是什么有所作为有才干的人物。","source":{"text":"［李信］他明白在杞县境内停留着耽误时间对他十分不利，也相信李闯王大概不是泛泛之人，但是他更明白，去投闯王，这是他兄弟和红娘子的一生大事，不能不特别慎重。","book":"姚雪垠《李自成》第二卷第四十一章"}},{"id":28706,"word":"泛泛之谈","pinyin":"fàn fàn zhī tán","abbr":"ffzt","explanation":"泛泛：浮浅不深入。一般化地泛泛地谈谈。","source":{"text":"他的泛泛之谈让我如堕五里雾中。"},"example":{"text":"他的～让我如堕五里雾中"},"similar":["泛泛其词","泛泛而论"],"opposite":["一针见血","一语破的"],"usage":"作谓语、定语、分句；指笼统地说"},{"id":28707,"word":"泛泛其词","pinyin":"fàn fàn qí cí","abbr":"ffqc","explanation":"泛泛：浮浅，寻常。形容说话或行文只是表面文章，并不打算真正解决问题。","source":{"text":"查办一下，并且下了一道泛泛其词的禁烟命令。","book":"陶菊隐《北洋军阀统治时期史话》第66章"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“胡雪岩当然只有劝慰，但～，不能发生作用。”"},"usage":"作宾语、定语；用于说话等"},{"id":28708,"word":"泛泛而谈","pinyin":"fàn fàn ér tán","abbr":"ffet","explanation":"泛泛：平常，不深入。一般地浮泛地谈谈。","source":{"text":"也由于时间关系，不能把《青春之歌》重读一遍然后执笔，故而只能泛泛而谈，不能引证原文作具体的分析。","book":"茅盾《怎样评价〈青春之歌〉》"},"example":{"text":"他～，没有中心。"},"similar":["泛泛其词"],"usage":"作谓语、宾语；指一般化的谈话"},{"id":28709,"word":"泛浩摩苍","pinyin":"fàn hào mó cāng","abbr":"fhmc","explanation":"泛海摩天。形容文词博大高深。","source":{"text":"李杜泛浩浩，韩柳摩苍苍。","book":"语出唐·杜牧《冬至日寄小侄阿宜诗》"},"example":{"text":"交游少，约文房四友，～。","book":"宋·刘克庄《沁园春·八和》词"},"usage":"作谓语；用于文词等"},{"id":28710,"word":"泛滥博文","pinyin":"fàn làn bó wén","abbr":"flbw","explanation":"泛滥：太宽泛；博文：文句繁多。内容太宽泛，语句繁多。","source":{"text":"泛滥博文，则多而久之。","book":"《史记·老子韩非列传》"}},{"id":28711,"word":"泛滥成灾","pinyin":"fàn làn chéng zāi","abbr":"flcz","explanation":"江河湖泊的水溢出，造成灾害。比喻不好的文章或思想到处传播，影响极坏。","source":{"text":"洪水横流，泛滥于天下。","book":"《孟子·滕文公上》"},"example":{"text":"表报之多，闹得～。","book":"毛泽东《论十大关系》"},"similar":["多如牛毛","洪水横流"],"opposite":["绝无仅有"],"usage":"作谓语、定语、补语；比喻发生在内部"},{"id":28712,"word":"泛萍浮梗","pinyin":"fàn píng fú gěng","abbr":"fpfg","explanation":"浮动在水面的萍草和树根。比喻踪迹漂泊不定。","source":{"text":"酒尽欲终问后期，泛萍浮梗不胜悲。","book":"唐·徐夤《别》诗"},"similar":["浮梗泛萍"],"usage":"作宾语、定语；比喻飘荡无主"},{"id":28713,"word":"泛驾之马","pinyin":"fěng jià zhī mǎ","abbr":"fjzm","explanation":"泛驾：不服人驾驭。不服从驾驭的马。比喻很有才能而不循旧规的人。也形容敢于创新的人。","source":{"text":"夫泛驾之马，跅驰之士，亦在御之而已。","book":"《汉书·武帝纪》"},"example":{"text":"而千里之足，多出于～。","book":"明·袁宏道《与陈正甫提学》"},"usage":"作主语、宾语；用于比喻句"},{"id":28714,"word":"泡病号","pinyin":"pào bìng hào","abbr":"pbh","explanation":"指借故称病长期不上班或小病大养。","example":{"text":"我们不能靠～来混下去。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":28715,"word":"泡蘑菇","pinyin":"pào mó gū","abbr":"pmg","explanation":"故意东拉西扯或纠缠来拖延时间。","source":{"text":"不让进就是不让进！少在这儿泡蘑菇，泡也没用！赶紧走——听见没有？","book":"王朔《我是你爸爸》"},"example":{"text":"你不要跟我来～，我们会坚持原则的。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":28716,"word":"波光粼粼","pinyin":"bō guāng lín lín","abbr":"bgll","explanation":"形容波光明净。波光：阳光或月光照在水波上反射过来的光。粼粼：形容水石明净。","example":{"text":"波光粼粼的湖面上，渔帆点点。"},"similar":["波光鳞鳞"],"usage":"作谓语、定语；用于风景写作"},{"id":28717,"word":"波光鳞鳞","pinyin":"bō guāng lín lín","abbr":"bgll","explanation":"形容波光像鱼鳞一样层层排列。","example":{"text":"旅游度假村前面有水质清澈，～、深不见底、一望无际的水库。"},"similar":["波光粼粼"],"usage":"作谓语、定语；用于风景写作"},{"id":28718,"word":"波委云集","pinyin":"bō wěi yún jí","abbr":"bwyj","explanation":"委：堆积。如波浪之相积，云层聚集。比喻众物聚集在一处。","source":{"text":"虽复门千户万，波委云集，而言皆琐碎，事必丛残。","book":"唐·刘知畿《史通·杂述》"},"usage":"作谓语、定语；指很多事物聚集"},{"id":28719,"word":"波属云委","pinyin":"bō zhǔ yún wěi","abbr":"bzyw","explanation":"属：连接；委：累积。波涛连绵，云层堆叠。比喻连续不断，层见叠出。","source":{"text":"自建武暨乎义熙，历载将百，虽缀响联辞，波属云委，莫不寄言上德，托意玄珠。","book":"《宋书·谢灵运传论》"},"similar":["波骇云属"],"usage":"作谓语、定语；比喻连续不断"},{"id":28720,"word":"波波碌碌","pinyin":"bō bō lù lù","abbr":"bbll","explanation":"奔走忙碌的样子。","source":{"text":"指望一举状元及第，峥嵘发达。谁想今日波波碌碌，受如此般辛勤也。","book":"元·马致远《荐福碑》第二折"}},{"id":28721,"word":"波流弟靡","pinyin":"bō liú dì mǐ","abbr":"bldm","explanation":"弟：即稊，一种结实如小米的草。如水波之逐势流，如稊草之随风倒。比喻无所执着，随顺应变。","source":{"text":"因以为弟靡，因以为波流，故逃也。","book":"《庄子·应帝王》"}},{"id":28722,"word":"波流茅靡","pinyin":"bō liú máo mǐ","abbr":"blmm","explanation":"随波逐流，随风而倒。比喻胸无定见，趋势而行。","source":{"text":"世宗朝，璁、萼、言、嵩相继用事，六卿之长不得其职。大都波流茅靡，淟涊取容。","book":"《明史·赵炳然传》"},"similar":["随波逐流"],"usage":"作谓语、定语；指人没有自己的意见"},{"id":28723,"word":"波涛汹涌","pinyin":"bō tāo xiōng yǒng","abbr":"btxy","explanation":"汹涌：水势腾涌的样子。形容波浪又大又急。","source":{"text":"是冬魏文帝至广陵，临江观兵……帝见波涛汹涌，叹曰：‘嗟乎！固天所以隔南北也。’","book":"《三国志·吴书·孙策传》：“是岁地连震”裴松之注引《吴录》"},"example":{"text":"我跟着书本活了那么长的时间。我的心仿佛落在一个～的海上受着颠簸。","book":"巴金《长夜》"},"similar":["波涛滚滚"],"usage":"作谓语、定语；形容波浪又大又急"},{"id":28724,"word":"波涛滚滚","pinyin":"bō tāo gǔn gǔn","abbr":"btgg","explanation":"滚滚：大水奔流的样子。形容江河奔流而来或迅猛发展的潮流。","source":{"text":"便有那波涛滚滚长江限，假若是无敌手战应难。","book":"元·郑廷玉《楚宫》"},"example":{"text":"我的心情像～一样不能平静。"},"similar":["波涛汹涌"],"usage":"作定语、宾语；指人的心情等"},{"id":28725,"word":"波澜不惊","pinyin":"bō lán bù jīng","abbr":"blbj","explanation":"水面平静，没有风浪。比喻局面安定，形势平稳。","similar":["风平浪静","水波不兴"],"opposite":["波澜壮阔","波涛汹涌"]},{"id":28726,"word":"波澜壮阔","pinyin":"bō lán zhuàng kuò","abbr":"blzk","explanation":"原形容水面辽阔。现比喻声势雄壮或规模巨大。","source":{"text":"旅客贫辛，波路壮阔。","book":"南朝·宋·鲍照《登大雷岸与妹书》"},"example":{"text":"七言诗须～，顿挫激昂，大开开阖耳。","book":"清·郎廷槐《师友诗传续录》"},"similar":["浩浩荡荡","气势磅礴","汹涌澎湃"],"opposite":["一潭死水"],"usage":"作谓语、定语；用于文章、运动等"},{"id":28727,"word":"波澜老成","pinyin":"bō lán lǎo chéng","abbr":"bllc","explanation":"波澜：波涛，形容文章多起伏；老成：指文章很老练。形容文章气势雄壮，语句老练。","source":{"text":"毫发无遗憾，波澜独老成。","book":"唐·杜甫《敬赠郑谏议十韵》诗"},"example":{"text":"情辞斐亹，～，吾敬孙君宇台。","book":"清·王晫《今世说·品藻》"},"usage":"作谓语、定语；形容诗文气势雄壮"},{"id":28728,"word":"波罗塞戏","pinyin":"bō luó sāi xì","abbr":"blsx","explanation":"即双陆。古代游戏，二人相博，类似下棋。"},{"id":28729,"word":"波罗奢花","pinyin":"bō luó shē huā","abbr":"blsh","explanation":"即鸡冠花。"},{"id":28730,"word":"波谲云诡","pinyin":"bō jué yún guǐ","abbr":"bjyg","explanation":"谲：诡：怪异，变化。好像云彩和水波那样，形态不可捉摸。原形容房屋构造就象云彩、波浪一样千姿百态。后多形容事物变幻莫测。","source":{"text":"于是大厦云谲波诡，摧摧而成观。","book":"汉·扬雄《甘泉赋》"},"example":{"text":"这其间的悲欢离合，～，令人在冷静沉默中回想起来，抚今追昔，实不胜其感慨系之.","book":"邹韬奋《抗战以来·开场白》"},"similar":["变化多端","难以捉摸"],"opposite":["一成不变"],"usage":"作谓语；形容变幻不定，难以捉摸"},{"id":28731,"word":"波路壮阔","pinyin":"bō lù zhuàng kuò","abbr":"blzk","explanation":"波路：波涛。比喻规模宏伟，声势浩大。同“波澜壮阔”。","source":{"text":"旅客贫辛，波路壮阔。","book":"南朝·宋·鲍照《登大雷岸与妹书》"},"similar":["波澜壮阔"],"opposite":["一潭死水"],"usage":"作谓语、定语；用于文章、运动等"},{"id":28732,"word":"波骇云属","pinyin":"bō hài yún zhǔ","abbr":"bhyz","explanation":"犹波属云委。比喻连续不断，层见叠出。","source":{"text":"至夫游夏以文词擅美，颜回则庶几将圣，屈宋所以后尘，卿云未能辍简。于是辞人才子，波骇云属。","book":"《北齐书·文苑传序》"},"similar":["波属云委"],"usage":"作谓语、定语；比喻连续不断"},{"id":28733,"word":"泣下如雨","pinyin":"qǐ xià rú yǔ","abbr":"qxry","explanation":"眼泪象雨一样。形容伤心到极点。","source":{"text":"瞻望弗及，泣涕如雨。","book":"《诗·邶风·燕燕》"},"example":{"text":"十一娘困述病源，封～。","book":"清·蒲松龄《聊斋志异·封三娘》"},"similar":["泣涕如雨","泪如雨下"],"opposite":["兴高采烈"],"usage":"作谓语；形容极度悲痛"},{"id":28734,"word":"泣下沾襟","pinyin":"qǐ xià zhān jīn","abbr":"qxzj","explanation":"襟：衣服胸前的部分。泪水滚滚流下，沾湿衣服前襟。哭得非常悲伤。","source":{"text":"曾子每读《丧礼》，泣下沾襟。","book":"《尸子》卷下"},"example":{"text":"昔季流子向风而鼓琴，听之者～。","book":"三国魏·阮籍《乐论》"},"similar":["泪流满面"],"usage":"作谓语；指非常悲伤"},{"id":28735,"word":"泣不可仰","pinyin":"qì bù kě yǎng","abbr":"qbky","explanation":"哭泣得抬不起头。形容极度悲伤。","source":{"text":"他把书记大骂一顿，责她多管闲事；她正在泣不可仰。","book":"洪深《编剧二十八问》"},"example":{"text":"她听完一曲后竟感动得～"},"usage":"作谓语、定语；用于人悲伤"},{"id":28736,"word":"泣不成声","pinyin":"qǐ bù chéng shēng","abbr":"qbcs","explanation":"哭得噎住了，出不来声音。形容非常伤心。","source":{"text":"尽夜哭泣，气不属声。","book":"《吴越春秋·越王无余外传》"},"example":{"text":"弥留之际，日饮白汤升许，欲以洗涤肺腑，及食不下咽，～。","book":"清·黄钧宰《金壶七墨·鸳鸯印传奇始末》"},"similar":["痛哭流涕","涕泗滂沱"],"opposite":["笑容可掬","欢天喜地"],"usage":"作谓语、定语、宾语；指非常悲伤"},{"id":28737,"word":"泣数行下","pinyin":"qì shù háng xià","abbr":"qshx","explanation":"眼泪接连不断的往下掉。形容非常悲伤。","source":{"text":"令儿皆和习之。上乃起舞，忼慨伤怀，泣数行下。","book":"汉·班固《汉书·高帝纪》"},"example":{"text":"安陵君～而进。","book":"《战国策·楚策一》"},"usage":"作状语；用于古语"},{"id":28738,"word":"泣歧悲染","pinyin":"qì qí bē rǎn","abbr":"qqbr","explanation":"泣歧：见歧路哭，因可以向南也可以向北；悲染：见染丝而悲伤，因可以染成黄色或黑色。形容悲叹人们易受外界世俗影响而迷失方向。","source":{"text":"杨子泣歧路，墨子悲杂丝。","book":"三国·魏·阮籍《咏怀诗》"}},{"id":28739,"word":"泣涕如雨","pinyin":"qì tì rú yǔ","abbr":"qtry","explanation":"泣：低声哭；涕：鼻涕。眼泪像雨一样。形容极度悲伤。","source":{"text":"瞻望弗及，泣涕如雨。","book":"《诗经·邶风·燕燕》"},"example":{"text":"浑公～，身被铁甲，举身自扑。","book":"唐·赵元一《奉天录》卷一"},"similar":["涕泗流涟"],"opposite":["兴高采烈"],"usage":"作谓语、宾语；用于人"},{"id":28740,"word":"泣荆之情","pinyin":"qì jīng zhī qíng","abbr":"qjzq","explanation":"比喻人留恋旧物，缅怀往事。","source":{"text":"鲁女有遗荆钗而泣者，路人笑之曰：‘以荆为钗易办，女乃泣何也？’女以手掠发曰：‘非以其难致也，以其故旧耳。’予所以玩之者，实钟鲁女泣荆之情。","book":"宋·释惠洪《石门文字禅·跋·山谷字》"}},{"id":28741,"word":"泣血捶膺","pinyin":"qì xuè chuí yīng","abbr":"qxcy","explanation":"形容悲痛到极点。","source":{"text":"太太毕竟是个女人，没有气力，拗他不过，索性躺在楼板上，泣血捶膺的，一直哭到半夜。","book":"清·李宝嘉《官场现形记》第十一回"},"usage":"作定语、状语；用于悲伤"},{"id":28742,"word":"泣血枕戈","pinyin":"qǐ xuè zhěn gē","abbr":"qxzg","explanation":"悲愤得眼睛流血，睡眠时枕着武器。形容发愤自励，立志雪恨。","source":{"text":"萧雍州勋业盖世，谋猷渊肃，既痛家祸，兼愤国难，泣血枕戈，誓雪怨酷。","book":"《南齐书·萧赤斧传》"},"example":{"text":"君侯体重宗支，任系方岳，理应～，偕仆就道，奈何反谕仆中止呢！","book":"蔡东藩《南北史演义》第六十三回"},"usage":"作谓语、定语；用于处事"},{"id":28743,"word":"泣血椎心","pinyin":"qì xuè chuí xīn","abbr":"qxcx","explanation":"泣血：哭得眼中流血；椎心：捶胸脯。捶拍胸膛，哭泣出血。形容非常悲痛。","source":{"text":"何图志未立而怨已成，计未从而骨肉受刑。此陵所以仰天椎心而泣血也。","book":"汉·李陵《答苏武书》"}},{"id":28744,"word":"泣血涟如","pinyin":"qǐ xuè lián rú","abbr":"qxlr","explanation":"指哭泣出血，悲痛异常。","source":{"text":"上六，乘马班如，泣血涟如。","book":"《周易·屯》"},"example":{"text":"原来那封签上的又辞是：鸿渐于磐，据于蒺藜，困而不复，～……凶！","book":"马辂《国共和谈演义》第三部第二十五回"},"usage":"作谓语、定语；用于书面语"},{"id":28745,"word":"泣血稽颡","pinyin":"qǐ xuè qǐ sāng","abbr":"qxjs","explanation":"稽颡：古时的一种跪拜礼，屈膝下拜，以额触地。指怀着万分沉痛的心情向来吊唁的宾客哭拜，以致谢忱。","source":{"text":"主人哭拜，稽颡成踊。","book":"《仪礼·士丧礼》"},"example":{"text":"虽然讣闻上说过“寝苫枕块”，“～”的话，但是他们整天躲在灵帏里，既不需要哭，又不必出来答礼。","book":"巴金《家》"},"usage":"作谓语、定语；用于书面语"},{"id":28746,"word":"泣鬼神","pinyin":"qì guǐ shén","abbr":"qgs","explanation":"使鬼神为之哭泣。比喻诗文感人至深。","source":{"text":"落笔惊风雨，诗成泣鬼神。","book":"唐·杜甫《寄李太白二十韵》诗"}},{"id":28747,"word":"泣麟悲凤","pinyin":"qǐ lín bēi fèng","abbr":"qlbf","explanation":"麟：麒麟；凤：凤凰。古代传说是吉祥的禽兽，只有在太平盛世才能见到。谓哀伤国家衰败。","source":{"text":"孔子因乱世获麟而涕泣，又因凤鸟不至而伤。见《公羊传·哀公十四年》、《论语·子罕》。"},"example":{"text":"又不是清夜闻钟，又不是黄鹤醉翁，又不是～。","book":"元·王实甫《西厢记》第二本第五折"},"usage":"作谓语、定语；用于书面语"},{"id":28748,"word":"泥中隐刺","pinyin":"ní zhōng yǐn cì","abbr":"nzyc","explanation":"比喻说话中带着讥讽。","source":{"text":"莫怪他泥中隐刺，他不曾道节外生枝。","book":"元·高茂卿《儿女团圆》第四折"},"example":{"text":"看玄德公面皮，将这厮抢下楼去。这厮敢～。","book":"元·无名氏《刘玄德醉走黄鹤楼》第三折"},"similar":["话中带刺"],"usage":"作宾语、定语；用于讥讽"},{"id":28749,"word":"泥佛劝土佛","pinyin":"ní fó quàn tǔ fó","abbr":"nfqtf","explanation":"比喻同病相怜，相互劝慰。也比喻顾不了自己，还要劝慰别人。","source":{"text":"我的哥哥，你自顾了你罢，又泥佛劝土佛。","book":"明·兰陵笑笑生《金瓶梅词话》第十三回"}},{"id":28750,"word":"泥古不化","pinyin":"nì gǔ bù huà","abbr":"ngbh","explanation":"泥：拘泥，固执。拘泥于古代的成规或古人的说法而不知变通。","source":{"text":"儒者泥古，致详于形名度数间，而不知清浊轻重之用。","book":"《宋史·刘几传》"},"example":{"text":"故对近代军旅之事，亦深有研究，非一般徒卖弄《孙子兵法》、～者可比。","book":"姚雪垠《李自成》第二卷第四十八章"},"similar":["食古不化","因循守旧"],"opposite":["推陈出新","弃旧图新"],"usage":"作谓语、定语；指人守旧"},{"id":28751,"word":"泥古守旧","pinyin":"nì gǔ shǒu jiù","abbr":"ngsj","explanation":"泥古：拘泥于古代的成规或说话。拘泥古代的制度或说法，不知变通。","source":{"text":"我们要写许多通俗的书，说明古不如今，旧不如新的道理，以破除社会上一般泥古守旧的思想。","book":"冯玉祥《我的生活》第27章"},"similar":["泥古不化"],"opposite":["推陈出新"],"usage":"作谓语、定语；指不知变通"},{"id":28752,"word":"泥古执今","pinyin":"nì gǔ zhí jīn","abbr":"ngzj","explanation":"泥：拘泥；执：执拘，约束限制。比喻用古代的陈规硬套今天的事物。","source":{"text":"于此礼不遵，而泥古执今，不独失礼，竟可谓之不臣矣。","book":"清·名教中人《好逑传》第16回"},"similar":["泥古违今"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28753,"word":"泥古拘方","pinyin":"nì gǔ jū fāng","abbr":"ngjf","explanation":"拘守成规、旧说而不知变通。","source":{"text":"恐以一定陈言，误泥古拘方之作者。","book":"清·李渔《闲情偶寄·词曲·结构》"},"similar":["泥古守旧"],"usage":"作谓语、定语；指不知变通"},{"id":28754,"word":"泥古违今","pinyin":"nì gǔ wéi jīn","abbr":"ngwj","explanation":"泥：拘泥，约束限制。比喻用古代的陈规硬套今天的事物。","source":{"text":"既非泥古以违今，直可据经而从事。","book":"宋·楼钥《荐黄肤卿林椅札子》"},"similar":["泥古执今"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28755,"word":"泥古非今","pinyin":"nì gǔ fēi jīn","abbr":"ngfj","explanation":"拘守古代的而否定当今的。形容崇尚陈规旧法，贬低新鲜事物。","source":{"text":"泥古非今，不达时变，疑滞少断，劳而无功。","book":"宋·刘恕《自讼》"},"usage":"作谓语、定语；指人不知变通"},{"id":28756,"word":"泥名失实","pinyin":"nì míng shī shí","abbr":"nmss","explanation":"拘守空名，不求实际。","source":{"text":"夫其本圣言而推之者，尚破碎如此，其他何可泥名失实而不敢加辨也欤！","book":"宋·程大昌《考古编·诗论九》"},"usage":"作谓语、定语；指人死板"},{"id":28757,"word":"泥塑木雕","pinyin":"ní sù mù diāo","abbr":"nsmd","explanation":"指泥做的和木头雕的偶像。比喻人的表情和举动呆板。","source":{"text":"有人说道，城隍也是泥塑木雕的，有什么灵感在那里。","book":"元·无名氏《冤家债主》第四折"},"example":{"text":"两班文武，如～，无人敢应。","book":"明·冯梦龙《警世通言》卷九"},"similar":["呆若木鸡"],"opposite":["活龙活现"],"usage":"作宾语、定语；形容人的动作和神情"},{"id":28758,"word":"泥多佛大","pinyin":"ní duō fó dà","abbr":"ndfd","explanation":"泥土越多，佛像就塑得越大。比喻底子厚或增加进来的多成就就大。","source":{"text":"十五日已前，水涨船高；十五日已后，泥多佛大；正当十五日，东海鲤鱼。","book":"宋·释普济《五灯会元》卷二十"},"usage":"作补语、宾语；指基本条件好就能成事"},{"id":28759,"word":"泥封函谷","pinyin":"ní fēng hán gǔ","abbr":"nfhg","explanation":"泥：泥丸；封：守住。用一个小泥丸就可以守住函谷关。比喻能利用险要地势，坚守住军事要地。","source":{"text":"然则君臣无常位，陵谷有变迁，或箠塞长河。泥封函谷，时移事改，理有万殊。","book":"《旧五代史·唐书·武皇本纪下》"},"example":{"text":"沙拥大江水，～关，古来世上雄，宰木风雨寒。","book":"宋·黄庭坚《寄晁元忠十首》"}},{"id":28760,"word":"泥沙俱下","pinyin":"ní shā jù xià","abbr":"nsjx","explanation":"指在江河的急流中泥土和沙子随着水一起冲下。比喻好人和坏人混杂在一起。","source":{"text":"人称才大者，如万里黄河，与泥沙俱下。余以为：此粗才，非大才也。","book":"清·袁枚《随园诗话》第一卷"},"example":{"text":"虽然难免～，但它却以宏大的气魄，荡开了中国现代文学发展的绚丽前景。"},"similar":["鱼龙混杂","鱼目混珠"],"opposite":["泾渭分明"],"usage":"作谓语、定语、分句；用于人或事物"},{"id":28761,"word":"泥涂曳尾","pinyin":"ní tú yè wěi","abbr":"ntyw","explanation":"涂：污泥；曳：施。像乌龟拖着尾巴在泥地里爬行一样。比喻行为卑鄙龌龊。","source":{"text":"叶伯芬的曳尾泥涂，大都如此，这回事情，不过略表一二。","book":"清·吴趼人《二十年目睹之怪现状》第九十一回"}},{"id":28762,"word":"泥牛入海","pinyin":"ní niú rù hǎi","abbr":"nnrh","explanation":"泥塑的牛掉到海里。比喻一去不再回来。","source":{"text":"我见两个泥牛斗入海，直至如今无消息。","book":"宋·释道原《景德传灯录》卷八"},"example":{"text":"那两个钱庄干事的人，等了好久，只等得一个～，永无消息。","book":"清·吴趼人《二十年目睹之怪现状》第七回"},"similar":["石沉大海","杳无音信"],"usage":"作谓语、定语、分句；表示没有希望"},{"id":28763,"word":"泥猪瓦狗","pinyin":"ní zhū wǎ gǒu","abbr":"nzwg","explanation":"泥塑的猪，土捏的狗。比喻不中用。","source":{"text":"见个败类，纵然势焰熏天，她看着也同泥猪瓦狗。","book":"清·文康《儿女英雄传》第五回"},"similar":["泥猪癞狗"],"usage":"作主语、宾语、定语；用于贬低人"},{"id":28764,"word":"泥猪疥狗","pinyin":"ní zhū jiè gǒu","abbr":"nzjg","explanation":"比喻卑贱或粗鄙的人。","source":{"text":"再谁想泥猪疥狗生涯苦。","book":"元·马致远《任凤子》第二折"},"similar":["泥猪瓦狗","泥猪癞狗"],"usage":"作主语、宾语、定语；用于贬低人"},{"id":28765,"word":"泥猪癞狗","pinyin":"ní zhū lài gǒu","abbr":"nzlg","explanation":"比喻卑贱或粗鄙的人。同“泥猪疥狗”。","source":{"text":"天下竟有这等人物！如今看来，我竟成了泥猪癞狗。","book":"清·曹雪芹《红楼梦》第七回"},"similar":["泥猪疥狗"],"usage":"作主语、宾语、定语；用于贬低人"},{"id":28766,"word":"泥而不滓","pinyin":"niè ér bù zǐ","abbr":"nebz","explanation":"染而不黑。比喻洁身自好，不受坏的影响。泥，通“涅”。染黑。滓，通“缁”。黑色。","source":{"text":"濯淖污泥之中，蝉蜕于浊秽，以浮游尘埃之外，不获世之滋垢，皭然泥而不滓者也。","book":"《史记·屈原贾生列传》"},"example":{"text":"《史记·屈原贾生列传》：“濯淖污泥之中，蝉蜕于浊秽，以浮游尘埃之外，不获世之滋垢，皭然泥而不滓者也。”"},"similar":["泥蟠不滓"],"usage":"作定语；用于比喻句"},{"id":28767,"word":"泥船渡河","pinyin":"ní chuán dù hé","abbr":"ncdh","explanation":"坐泥土做的船过河。比喻非常危险。","source":{"text":"人在世间，譬如乘泥船渡河，当浮渡船且坏，人身如泥船不可久。","book":"《三慧经》"},"example":{"text":"你这样做是～——自身难保。"},"similar":["自身难保","泥菩萨过江"],"usage":"作宾语、补语；比喻非常危险"},{"id":28768,"word":"泥菩萨落水，自身难保","pinyin":"ní pú sà luò shuǐ，zì shēn nán bǎo","abbr":"npslszsnb","explanation":"泥塑的泥菩萨在水中会被浸坏。比喻连自己都保护不了，更顾不上帮助别人。","source":{"text":"我想江西不沉却好，若沉了时节，正是‘泥菩萨落水，自身难保’，还保得别人？","book":"明·冯梦龙《警世通言》第40卷"},"similar":["泥菩萨过江，自身难保"],"usage":"作宾语、定语、分句；用于比喻句"},{"id":28769,"word":"泥菩萨过江","pinyin":"ní pú sà guò jiāng","abbr":"npsgj","explanation":"表示连自己也保不住，更谈不上帮助别人。","source":{"text":"哥哥说：‘泥菩萨过江，自身难保’，送回去也好。","book":"丁玲《太阳照在桑乾河上》"},"example":{"text":"你这样做是～——自身难保。"},"similar":["泥船渡河"],"usage":"作宾语；指自身难保"},{"id":28770,"word":"泥菩萨过江，自身难保","pinyin":"ní pú sà guò jiāng，zì shēn nán bǎo","abbr":"npsgjzsnb","explanation":"泥塑的泥菩萨在水中会被浸坏。比喻连自己都保护不了，更顾不上帮助别人。","source":{"text":"哥哥说：‘泥菩萨过江，自身难保’，送回去也好。","book":"丁玲《太阳照在桑乾河上》"},"similar":["泥菩萨落水，自身难保"],"usage":"作宾语、定语、分句；用于比喻句"},{"id":28771,"word":"泥蟠不滓","pinyin":"ní pān bù zǐ","abbr":"npbz","explanation":"盘绕在泥里而没有被污染。比喻人不得志但不丧失节操。","source":{"text":"有补于事，泥蟠不滓，行参圣师。","book":"《三国志·蜀书·秦宓传》"},"similar":["泥而不滓"],"usage":"作谓语、定语；用于比喻句"},{"id":28772,"word":"泥足巨人","pinyin":"ní zú jù rén","abbr":"nzjr","explanation":"比喻表面强大而实际非常虚弱的势力或事物。","source":{"text":"多威武，泥足巨人，过街老鼠。","book":"郭沫若《忆秦娥》词"},"usage":"作宾语、定语；指笨大东西"},{"id":28773,"word":"泥车瓦狗","pinyin":"ní chē wǎ gǒu","abbr":"ncwg","explanation":"小泥车，小瓦狗。比喻无用或无价值的物品。","source":{"text":"或作泥车瓦狗诸戏弄之具，以巧诈小儿。","book":"汉·王符《潜夫论》"},"usage":"作宾语、定语；指玩具"},{"id":28774,"word":"泥车瓦马","pinyin":"ní chē wǎ mǎ","abbr":"ncwm","explanation":"比喻没有实际用处的东西。"},{"id":28775,"word":"泥金万点","pinyin":"ní jīn wàn diǎn","abbr":"njwd","explanation":"指菊花名。"},{"id":28776,"word":"泥雪鸿迹","pinyin":"ní xuě hóng jì","abbr":"nxhj","explanation":"大雁在雪泥上踏过留下的爪印。比喻往事遗留的痕迹。","source":{"text":"人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。","book":"宋·苏轼《和子由渑池怀旧》诗"}},{"id":28777,"word":"泥饭碗","pinyin":"ní fàn wǎn","abbr":"nfw","explanation":"指集体所有制或个体的没有保障的工作。","example":{"text":"现在没有铁饭碗，只有～，所以要努力工作。"},"opposite":["铁饭碗"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":28778,"word":"泥首谢罪","pinyin":"ní shǒu xiè zuì","abbr":"nsxz","explanation":"用泥涂首谢罪。表示自辱服罪。","source":{"text":"导率子弟二十余人旦旦到公车，泥首庙罪。","book":"南朝·宋·刘义庆《世说新语》注引《中兴书》"},"example":{"text":"克用自引兵围攻邢州，存孝固守经年，城中食尽，乃出见克用，～。","book":"蔡东藩《唐史演义》第九十七回"}},{"id":28779,"word":"注玄尚白","pinyin":"zhù xuán shàng bái","abbr":"zxsb","explanation":"指白纸黑字的文字记载。","source":{"text":"斯文千古之不附也，注玄尚白，其功孰与京哉！","book":"明宋应星《天工开物·丹青》"},"usage":"作谓语、定语；用于书面语"},{"id":28780,"word":"注萤沃雪","pinyin":"zhù yíng wò xuě","abbr":"zywx","explanation":"注萤：用水浇萤火；沃雪：用沸水浇雪。比喻事情很容易办成。","source":{"text":"若使旗鼓相望，埃尘相接，势如沃雪，事等注萤。","book":"《梁书·侯景传》高澄与景书"},"usage":"作宾语、定语；指办事很容易"},{"id":28781,"word":"泪下如雨","pinyin":"lèi xià rú yǔ","abbr":"lxry","explanation":"眼泪象雨水似的直往下流。形容悲痛或害怕之极。","source":{"text":"有时登高望鄠社，悲歌仰天泪如雨。","book":"宋·陆游《闻虏乱有感》诗"},"example":{"text":"见孤鹤集于塔顶，曼声天末，君不觉～。","book":"清·黄宗羲《谢时符墓志铭》"},"similar":["泪如雨下"],"opposite":["喜笑颜开"],"usage":"作谓语、状语；指十分悲伤"},{"id":28782,"word":"泪出痛肠","pinyin":"lèi chū tòng cháng","abbr":"lctc","explanation":"痛遥：伤痛的内心。指因心里难过而流出了眼泪。","source":{"text":"曰：‘饭袋子江西湖南便恁么去又作么生？’师曰：‘泪出痛肠。’","book":"宋·释惟白《续传灯录》卷三十一"},"example":{"text":"事实两难，因此～。","book":"明·罗贯中《三国演义》第五十六回"}},{"id":28783,"word":"泪如泉涌","pinyin":"lèi rú quán yǒng","abbr":"lrqy","explanation":"眼泪象泉水一样直往外涌。形容悲痛或害怕之极。","source":{"text":"唐·刘损《愤惋诗三首（其三）》“莫道诗成无泪下，泪如泉滴亦须干。”"},"example":{"text":"允曰：“汝可怜汉天下生灵！”言讫，～。","book":"明·罗贯中《三国演义》第八回"},"similar":["声泪俱下","老泪纵横"],"opposite":["捧腹大笑","纵声大笑"],"usage":"作谓语、定语；用于书面语"},{"id":28784,"word":"泪如泉滴","pinyin":"lèi rú quán dī","abbr":"lrqd","explanation":"形容触动伤心事，眼泪象泉水一样流出。","source":{"text":"唐·刘损《愤惋诗》之三“莫道诗成无泪下，泪如泉滴亦须干。”"},"similar":["泪如泉涌"],"usage":"作谓语、定语；用于书面语"},{"id":28785,"word":"泪如雨下","pinyin":"lèi rú yǔ xià","abbr":"lryx","explanation":"眼泪象雨水似的直往下流。形容悲痛或害怕之极。","source":{"text":"有时登高望鄠社，悲歌仰天泪如雨。","book":"宋·陆游《闻虏乱有感》诗"},"example":{"text":"眼盻盻看着他人去了，自己不能奋飞，万箭攒心，不觉～。","book":"明·冯梦龙《喻世明言》卷八"},"similar":["泪下如雨"],"opposite":["眉开眼笑","笑逐颜开"],"usage":"作谓语、定语、状语；指悲痛"},{"id":28786,"word":"泪干肠断","pinyin":"lèi gān cháng duàn","abbr":"lgcd","explanation":"形容伤心到极点。","source":{"text":"气的彩云哭个泪干肠断。","book":"清·曹雪芹《红楼梦》第六十二回"},"example":{"text":"等到～的时候，她的心也就是死了"},"usage":"作定语、状语；用于伤心时"},{"id":28787,"word":"泪河东注","pinyin":"lèi hé dōng zhù","abbr":"lhdz","explanation":"眼泪似向东的的河流一样。比喻人极度悲痛。","source":{"text":"白发故交空掩卷，泪河东注问苍旻。","book":"南朝·宋·刘义庆《世说新语·言语》：“声如震雷破山，泪如倾河注海。”宋·苏轼《和王游》"}},{"id":28788,"word":"泪流满面","pinyin":"lèi liú mǎn miàn","abbr":"llmm","explanation":"眼泪流了一脸。形容极度悲伤。","source":{"text":"言讫，以印绶付之，泪流满面。","book":"明·罗贯中《三国演义》第110回"},"example":{"text":"听完这个故事，他已经～。"},"similar":["泪如雨下"],"opposite":["眉开眼笑"],"usage":"作谓语、状语；形容极度悲伤"},{"id":28789,"word":"泪眼愁眉","pinyin":"lèi yǎn chóu mé","abbr":"lycm","explanation":"流泪的眼，发愁的眉。形容极其痛苦悲伤的样子。","source":{"text":"留恋你别无意，见据鞍上马，阁不住泪眼愁眉。","book":"元王实甫《西厢记》第四本第三折"},"example":{"text":"人去天涯几许，凝望处，～。","book":"明·高濂《玉簪记·愁眉》"},"similar":["愁眉泪眼"],"usage":"作谓语、定语、宾语；形容悲苦的样子"},{"id":28790,"word":"泪眼汪汪","pinyin":"lèi yǎn wāng wāng","abbr":"lyww","explanation":"汪汪：满眼泪水的样子。两眼充满泪水。","source":{"text":"黄巢听得凭地说，不觉泪眼汪汪。","book":"《新编五代史评话·梁史》卷上"},"example":{"text":"小姐在旁，～，只是叹气。","book":"清·吴敬梓《儒林外史》第十一回"},"similar":["热泪盈眶"],"usage":"作谓语、定语；用于伤心时"},{"id":28791,"word":"泪迸肠绝","pinyin":"lèi bèng cháng jué","abbr":"lbcj","explanation":"指悲痛得泪涌肠断。","source":{"text":"北山哭得泪迸肠绝，听了周升这话，想了一想，觉得有理。","book":"《轰天雷》第二回"},"similar":["泪干肠断"],"usage":"作状语；指人悲痛"},{"id":28792,"word":"泫然流涕","pinyin":"xuàn rán liú tì","abbr":"xrlt","explanation":"泫然：水珠向下滴的样子；涕：泪。指泪珠止不住地流下来。","source":{"text":"乃至闻李唐之谏，泫然流涕，而不敢修寝门之节。","book":"清·王夫之《读通鉴论·唐肃宗》十二"},"example":{"text":"念母老子幼，～。","book":"清·蒲松龄《聊斋志异·鄷都御史》"},"similar":["痛哭流涕"],"opposite":["兴高采烈"],"usage":"作谓语；指十分伤心"},{"id":28793,"word":"泮林革音","pinyin":"pàn lín gé yīn","abbr":"plgy","explanation":"比喻在好的影响感化下而改变旧习性。","source":{"text":"言鸮恒恶鸣，今来止于泮水之木上，食其桑黮。为此之故，故改其鸣，归就我以善音。喻人感于恩则化也。","book":"《诗·鲁颂·泮水》：“翩彼飞鸮，集于泮林，食我桑黮，怀我好音。”郑玄笺"},"example":{"text":"自上而下，速于置邮，～，无复故态。","book":"唐·刘禹锡《唐故相同赠司空令狐公集序》"},"usage":"作宾语、定语；指环境改变人"},{"id":28794,"word":"泰山不让土壤","pinyin":"tài shān bù ràng tǔ rǎng","abbr":"tsbrtr","explanation":"泰山不排除细小的土石，所以能那么高。比喻人度量大，能包容不同的事物。","source":{"text":"是以泰山不让土壤，故能成其大；河海不择细流，故能就其深。","book":"《史记·李斯无传》"},"similar":["河海不择细流"],"usage":"作宾语、定语；用于劝诫人"},{"id":28795,"word":"泰山不让土壤，故能成其大","pinyin":"tài shān bù ràng tǔ rǎng，gù néng chéng qí dà","abbr":"tsbrtrgncqd","explanation":"让：推辞，拒绝。泰山不排除细小的土石，所以能那么高。比喻人度量大，能包容不同的事物。","source":{"text":"是以泰山不让土壤，故能成其大；河海不择细流，故能就其深；王者不却众庶，故能明其德。","book":"秦·李斯《上书秦始皇》"},"similar":["泰山不让土壤，故能成其高"],"usage":"作宾语、定语；用于劝诫人"},{"id":28796,"word":"泰山不让土壤，故能成其高","pinyin":"tài shān bù ràng tǔ rǎng，gù néng chéng qí gāo","abbr":"tsbrtrgncqg","explanation":"让：推辞，拒绝。泰山不排除细小的土石，所以能那么高。比喻人度量大，能包容不同的事物。","source":{"text":"泰山不让土壤，故能成其高。未到泰山者，泰山壁立千丈，不藉寸土，栉沐甚净。","book":"清·张岱《岱志》"},"similar":["泰山不让土壤，故能成其大"],"usage":"作宾语、定语；用于劝诫人"},{"id":28797,"word":"泰山不辞土壤，故能成其高","pinyin":"tài shān bù cí tǔ rǎng，gù néng chéng qí gāo","abbr":"tsbctrgncqg","explanation":"泰山不排除细小的土石，所以能那么高。比喻人度量大，能包容不同的事物。","source":{"text":"是以泰山不辞土壤，故能成其高；河海不择细流，故能就其深。","book":"太平天国·洪秀全《原道醒世训》"},"similar":["泰山不让土壤，故能成其高"],"usage":"作宾语、定语；用于劝诫人"},{"id":28798,"word":"泰山之安","pinyin":"tài shān zhī ān","abbr":"tsza","explanation":"像泰山一样稳固。形容稳固、安定。","source":{"text":"以居泰山之安，而欲乘累卵之危。","book":"汉·枚乘《上书谏吴王》"},"example":{"text":"明·冯梦龙《东周列国志》第16回：“内安百姓，外抚四夷，勋加于王室，泽布于诸侯，国有～，君享无强之福。”"},"opposite":["累卵之危"],"usage":"作宾语；用于书面语"},{"id":28799,"word":"泰山其颓","pinyin":"tài shān qí tuí","abbr":"tsqt","explanation":"旧时用于哀悼大家敬仰的人。","source":{"text":"泰山其颓乎！梁木其坏乎！哲人其萎乎！","book":"西汉·戴圣《礼记·檀弓上》"},"example":{"text":"学人文人同声哀悼，‘～，哲人其萎’的成语。","book":"叶圣陶《乡里善人》"},"similar":["泰山梁木"],"usage":"作谓语；用于悼词"},{"id":28800,"word":"泰山北斗","pinyin":"tài shān běi dǒu","abbr":"tsbd","explanation":"泰山：东岳，在山东省泰安市；北斗：北斗星。比喻道德高、名望重或有卓越成就为众人所敬仰的人。","source":{"text":"自愈没，其言大行，学者仰之如泰山北斗云。","book":"《新唐书·韩愈传赞》"},"example":{"text":"五兄梦中题孔子庙棂星门柱联有“～，景星庆云”之语，敬意如此者，士之望、人之瑞，一代不过数人。","book":"清·恽敬《答姚秋农书》"},"similar":["德高望重","众望所归"],"usage":"作主语、宾语；指为众人所敬仰的人","story":["唐朝时期，受六朝的影响，文风追求词藻华丽，崇尚对句空洞形式，而司马迁、扬雄等高超的写作技巧已经不见其踪。唐宋八大家之首的韩愈积极倡导古文运动，提倡散文。后世评说韩愈是文坛上的泰山北斗"]},{"id":28801,"word":"泰山压卵","pinyin":"tài shān yā luǎn","abbr":"tsyl","explanation":"泰山压在蛋上。比喻力量相差极大，强大的一方必然压倒弱小的一方。","source":{"text":"况履顺讨逆，执政伐邪，是乌获摧冰，贲育拉朽，猛兽吞狐，泰山压卵，因风燎原，未足方也。","book":"《晋书·孙惠传》"},"example":{"text":"六军之来，殄此丑夷，如～耳。","book":"明·赵弼《何忠节传》"},"opposite":["以卵投石"],"usage":"作谓语、宾语、定语；指力量悬殊","story":["晋朝时爆发八王之乱，河间王与长沙王联合攻打成都王司马颖，司马颖启用孙惠为大将军参军。河间王联合成都王攻打长沙王，孙惠杀死成都王的牙门将后给东海王司马越写信，赞扬司马越出兵拥戴王室是泰山压碎鸡蛋一样必胜无疑"]},{"id":28802,"word":"泰山压顶","pinyin":"tài shān yā dǐng","abbr":"tsyd","explanation":"泰山压在头上。比喻遭遇到极大的压力和打击。","source":{"text":"给了他个泰山压顶没有躲闪，把那助纣为虐的杀个净，直杀的血流飘杵，堵了城门。","book":"明·贾凫西《木皮词·正传》"},"example":{"text":"一个棍起处似～，打下来举手无措。（清·文康《儿女英雄传》第六回）"},"similar":["不堪重负"],"usage":"作谓语、宾语；指压力大"},{"id":28803,"word":"泰山可倚","pinyin":"tài shān kě yǐ","abbr":"tsky","explanation":"有如泰山一样可以倚靠。形容有强有力的靠山。","source":{"text":"人以国忠为泰山可倚，吾视之如冰山耳，若皎日既升，得无失所恃乎？","book":"清·郑志鸿《常语寻源》卷下"},"opposite":["冰山难靠"],"usage":"作宾语、定语；用于书面语","story":["唐玄宗李隆基十分宠爱杨贵妃，她的族兄杨国忠被任命为宰相，官吏们纷纷投靠杨国忠。有人劝说陕西进士张彖去投靠杨国忠，张彖说：“杨国忠不是泰山可倚，只不过是一座冰山，总有一天会化掉的。”就去嵩山隐居了"]},{"id":28804,"word":"泰山梁木","pinyin":"tài shān liáng mù","abbr":"tslm","explanation":"象泰山崩塌，梁木毁坏一样。比喻伟人死亡。","source":{"text":"孔子蚤作，负手曳杖，消摇于门，歌曰：‘泰山其颓乎！染木其坏乎！哲人其萎乎！’","book":"《礼记·檀弓上》"},"example":{"text":"当此国基未固，人才消乏之秋，近者如斯，将谁与支撑危局？～，同人等悲不自胜。","book":"蔡东藩、许廑父《民国通俗演义》第二十二回"},"similar":["泰山其颓"],"usage":"作宾语、定语；比喻伟人死亡"},{"id":28805,"word":"泰山盘石","pinyin":"tai shān pán shí","abbr":"tsps","explanation":"比喻安定稳固。"},{"id":28806,"word":"泰山磐石","pinyin":"tài shān pán shí","abbr":"tsps","explanation":"比喻安定稳固。","source":{"text":"我算什么，明相国不动声色，却出斯民于火热水深，措天下于泰山磐石。","book":"清·魏秀仁《花月痕》第50回"},"usage":"作宾语、定语；用于比喻句"},{"id":28807,"word":"泰山若厉","pinyin":"tài shān ruò lì","abbr":"tsrl","explanation":"厉：“砺”的本字，磨刀石。泰山剥蚀得像一块磨刀石那样大。比喻时间久远。","source":{"text":"使黄河如带，泰山若厉，国以永存，爰及苗裔。","book":"《汉书·高惠高后文功臣表》"},"usage":"作宾语、定语；用于比喻句"},{"id":28808,"word":"泰山鸿毛","pinyin":"tài shān hóng máo","abbr":"tshm","explanation":"比喻轻重相差极大。","source":{"text":"人固有一死，或重于泰山，或轻于鸿毛，用之所趋异也。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"因为这对她是无比重要的荣辱关头，错过这一刻，也许就死不成；就是死成了，～之间，评价大不相同。","book":"高阳《清官册》第二章"},"usage":"作宾语、定语；用于比较","story":["西汉时期，太史令司马迁为实现父亲的遗愿继续编著《史记》，因李陵事件被施以酷刑。他强忍痛苦，终于在公元前91年完成历史巨著《史记》。他在给朋友的信中谈到对死的认识：“人固有一死，或重于泰山，或轻于鸿毛。”"]},{"id":28809,"word":"泰来否往","pinyin":"tài lái pǐ wǎng","abbr":"tlpw","explanation":"否、泰：《周易》中的两个卦名。否：卦不顺利；泰：卦顺利；极：尽头。逆境达到极点，就会向顺境转化。指坏运到了头好运就来了。","source":{"text":"时过于期，否终则泰。","book":"《周易·否》：“否之匪人，不利君子贞，大往小来。”《周易·泰》：“泰，小往大来，吉亨。”《吴越春秋·勾践入臣外传》"},"example":{"text":"可正是乐极生悲，今日个～。","book":"元·宫大用《范张鸡黍》"},"similar":["泰来否极","否极泰来"],"usage":"作谓语、宾语；指厄运结束"},{"id":28810,"word":"泰来否极","pinyin":"tài lái pǐ jí","abbr":"tlpj","explanation":"否、泰：《周易》中的两个卦名。否：卦不顺利；泰：卦顺利；极：尽头。逆境达到极点，就会向顺境转化。指坏运到了头好运就来了。","source":{"text":"时过于期，否终则泰。","book":"《周易·否》：“否之匪人，不利君子贞，大往小来。”《周易·泰》：“泰，小往大来，吉亨。”《吴越春秋·勾践入臣外传》"},"example":{"text":"乐往必百万生，泰来犹否极。","book":"唐·白居易《遣怀》诗"},"similar":["否极泰至","泰来否往"],"usage":"作谓语、宾语；指厄运结束"},{"id":28811,"word":"泰极生否","pinyin":"tài jí shēng pǐ","abbr":"tjsf","explanation":"指事物发展到极端，就会向其相反的方面转化，好事会变成坏事。","source":{"text":"[你师父]泰极生否，乐盛成悲，今被妖邪捕获。","book":"《西游记》第九一回"},"similar":["泰极而否"],"opposite":["否极泰来"],"usage":"作谓语、分句；指好事变坏事"},{"id":28812,"word":"泰极而否","pinyin":"tài jí ér pǐ","abbr":"tjep","explanation":"否、泰：《周易》中的两个卦名；否：卦不顺利；泰：卦顺利；极：尽头。好的到了极点，坏的就来了。","source":{"text":"泰极而否。","book":"《周易·本义》"},"example":{"text":"侍中以帐下生变闻，～，当歌而哭。","book":"唐·刘禹锡《史公神道碑》"},"similar":["泰极生否","乐极生悲"],"opposite":["否极泰来"],"usage":"作谓语、分句；指好事变坏事"},{"id":28813,"word":"泰然处之","pinyin":"tài rán chǔ zhī","abbr":"trcz","explanation":"泰然：安然，不以为意的样子；处：处理，对待。形容毫不在意，沉着镇定。","source":{"text":"爰初发迹，遘此颠沛，神情玄定，处之弥泰。","book":"晋·袁宏《三国名臣序赞》"},"example":{"text":"老东山已松开孙若西，他平了平气，眼睛半闭，～，稳立不动。","book":"冯德英《迎春花》第二十二章"},"similar":["泰然自若","镇定自如"],"opposite":["忐忑不安","惊惶失措","六神无主"],"usage":"作谓语、宾语；指处事方式"},{"id":28814,"word":"泰然居之","pinyin":"tài rán jū zhī","abbr":"trjz","explanation":"泰然：毫不在意很放心的样子。形容处理事情不慌不忙、沉着镇定或对待事情毫不在意。","source":{"text":"太宗方奋然有运天下豪杰之心，使新进叠用事，而玄龄泰然居之，不以进退自嫌。","book":"宋·陈亮《王珪确论如何》"},"similar":["泰然处之"],"usage":"作谓语、宾语；用于处事"},{"id":28815,"word":"泰然自得","pinyin":"tài rán zì dé","abbr":"trzd","explanation":"指身体感到不寻常的舒适的满足。","example":{"text":"她坐在那里显得～。"},"similar":["怡然自得"],"usage":"作定语、状语；指人的感觉"},{"id":28816,"word":"泰然自若","pinyin":"tài rán zì ruò","abbr":"trzr","explanation":"自若：象平常一样。不以为意，神情如常。形容在紧急情况下沉着镇定，不慌不乱。","source":{"text":"有敌忽来，虽矢石至前，泰然自若。","book":"《史记·樗里子甘茂列传》：“鲁人有与曾参同姓者杀人，人告其母曰：‘曾参杀人。’其母织自若也。”《金史·颜盏门都传》"},"example":{"text":"施天福坦率地注视郑成功，～地摇头。","book":"华而实《汉衣冠》三"},"similar":["安之若素","若无其事"],"opposite":["忐忑不安","心惊肉跳"],"usage":"作谓语、宾语、状语；指处事方式","story":["金人颜盏门都性情忠厚，谨小慎微，他作战善于安置营垒，计划十分周密，遇事十分沉着，即使矢箭如雨，他仍泰然自若，一切按计划行事，他很勇敢，亲自带兵救出被西夏李世辅挟持的完颜杲，他一生中立下不少的战功"]},{"id":28817,"word":"泰而不骄","pinyin":"tài ér bù jiāo","abbr":"tebj","explanation":"态度舒泰而不骄傲。也指有地位、有权势后不骄傲。","source":{"text":"子曰：‘君子惠而不费，劳而不怨，欲而不贪，泰而不骄，威而不猛。’","book":"《论语·尧曰》"}},{"id":28818,"word":"泰阿倒持","pinyin":"tài ē dào chí","abbr":"tadc","explanation":"倒拿着剑，把剑柄给别人。比喻把大权交给别人，自己反受其害。","source":{"text":"至秦则不然，张诽谤之罔，以为汉驱除，倒持泰阿，授楚其柄。","book":"《汉书·梅福传》"},"similar":["太阿倒持"],"usage":"作谓语、宾语、定语；指使自己被动"},{"id":28819,"word":"泱泱大风","pinyin":"yāng yāng dà fēng","abbr":"yydf","explanation":"泱泱：宏大的样子。指气魄宏大的大国风度。","source":{"text":"为之歌《齐》，曰：‘美哉，泱泱乎，大风也哉！表东海者，其大公乎！国未可量也。’","book":"《左传·襄公二十九年》"},"example":{"text":"明孝陵道上的石人石马，虽然残缺零乱，还可见～。","book":"朱自清《南京》"},"similar":["泱泱大国"],"usage":"作宾语；指气魄宏大的大国风度","story":["春秋时期，吴国的公子季札自幼精通音乐，他访问鲁国时，鲁国特地为他举行一场演出。鲁国的乐工演奏周王朝及诸侯国的乐曲，他对齐国歌曲说：“美哉，泱泱乎，大风也哉！”等演奏曹国、郐国的《郐风》以后，他就没有再表示意见了"]},{"id":28820,"word":"泻水著地","pinyin":"xiè shuǐ zháo dì","abbr":"xszd","explanation":"水倾泻在地上，随地势而流注。比喻只能任其自然。","source":{"text":"譬如写水著地，正自纵横漫流，略无正方圆者。","book":"南朝·宋·刘义庆《世说新语·文学》"},"similar":["顺其自然"],"usage":"作谓语；指顺其自然"},{"id":28821,"word":"泼冷水","pinyin":"pō lěng shuǐ","abbr":"pls","explanation":"比喻挫伤别人的热情或兴致。","example":{"text":"你不要对别人的热情～。"},"usage":"作谓语、定语、宾语；指挫伤别人的热情"},{"id":28822,"word":"泼声浪气","pinyin":"pō shēng làng qì","abbr":"pslq","explanation":"泼：泼辣；浪：放浪。泼辣的声调放浪的声势。形容撒泼的神态。","source":{"text":"金桂听见他婆婆如此说，怕薛蟠心软意活了，便泼声浪气大哭起来。","book":"清·曹雪芹《红楼梦》第80回"},"usage":"作定语、状语；多用于女性"},{"id":28823,"word":"泼天冤枉","pinyin":"pō tiān yuān wǎng","abbr":"ptyw","explanation":"泼天：极大的。天大的冤屈。","source":{"text":"这妇人好大胆！”闻氏哭倒在地，口称泼天冤枉。","book":"明·冯梦龙《喻世明言》卷四十：“唬得中军官失了三魂，把门吏丧了七魄，一齐跑来，将绳缚往，喝道"},"example":{"text":"求青天大老爷明鉴万里，伸超小妇人丈夫杨乃武的～，小妇人便死，也感激大老爷的恩典。","book":"黄南丁氏《杨乃武与小白菜》第三十六回"}},{"id":28824,"word":"泼天大祸","pinyin":"pō tiān dà huò","abbr":"ptdh","explanation":"泼天：形容极大。极大的祸害。","source":{"text":"为了玉霜夫妻两个，弄下这一场泼天大祸。","book":"明·罗贯中《粉妆楼》第三十回"},"example":{"text":"假如换了一个人，或者有一句话说得不对，随之而来的，可就是又一场惊动全国的～了！","book":"二月河《雍正皇帝》第二十五回"},"similar":["弥天大祸"],"usage":"作宾语、定语；指极大的祸害"},{"id":28825,"word":"泼妇骂街","pinyin":"pō fù mà jiē","abbr":"pfmj","explanation":"泼妇：泼辣凶悍的妇女。象泼妇在街上当众谩骂。多指大肆攻击、谩骂别人。","source":{"text":"对政敌或争论的对方有着诚恳的礼貌，一点没有泼妇骂街的恶习气。","book":"邹韬奋《经历·新闻记者的作品》"},"example":{"text":"你不能学～。"},"usage":"作宾语、定语；指大肆攻击"},{"id":28826,"word":"泼水难收","pinyin":"pō shuǐ nán shōu","abbr":"psns","explanation":"相传汉朱买臣因家贫，其妻离去，后买臣富贵，妻又求合。买臣取水泼洒于地，令妻收回，以示夫妻既已离异就不能再合。后用以比喻不可挽回的局面。","source":{"text":"已装不卸，泼水难收怎奈何？","book":"金·董解元《西厢记诸宫调》第六卷"},"example":{"text":"小神只会放水，却不会收水。常言道：‘～’。","book":"明·吴承恩《西游记》第51回"},"similar":["覆水难收"],"usage":"作宾语、定语；指不可挽回的局面","story":["汉朝书生朱买臣年轻时家里十分贫穷，每天靠打柴卖维持生计，但他坚持好学，经常边走边背诵书本。他的妻子以此为耻辱就离他而去。后来朱买臣考学当上太守，他的前妻要求复婚，他将水泼在马前，教她收回就复婚"]},{"id":28827,"word":"泼油救火","pinyin":"pō yóu jiù huǒ","abbr":"pyjh","explanation":"救火时用油浇洒。比喻事情处理不得法，反而使事态更严重。","source":{"text":"今使他为先锋，是泼油救火也。","book":"明·罗贯中《三国演义》第74回"},"example":{"text":"正是‘～’，恐怕他死得不快罢了。","book":"清·吴趼人《二十年目睹之怪现状》第85回"},"similar":["负薪救火"],"usage":"作宾语、定语；指处理不得法"},{"id":28828,"word":"泽及万世","pinyin":"zé jí wàn shì","abbr":"zjws","explanation":"泽：恩泽。恩惠可施及子孙万代。形容恩德无量。","source":{"text":"吾师乎！吾师乎！赍万物而不为义，泽及万世而不为仁，长于上古而不为老，覆载天地、刻雕众形而不为巧。此所游已！","book":"《庄子·大宗师》"}},{"id":28829,"word":"泽及枯骨","pinyin":"zé jí kū gǔ","abbr":"zjkg","explanation":"泽：恩泽；枯骨：死去已久的人。恩泽及于死者。形容给人恩惠极大。","source":{"text":"文王贤矣，泽及髊骨，又况于人乎！","book":"《吕氏春秋·孟冬纪·异用》"},"example":{"text":"圣德之君，～，何况我等人民，不沾雨露之恩。","book":"明·许仲琳《封神演义》第二十三回"},"similar":["泽及髊骨"],"usage":"作谓语、定语；指给人恩惠极大"},{"id":28830,"word":"泽及髊骨","pinyin":"zé jí cī gǔ","abbr":"zjcg","explanation":"泽：恩泽；髊骨：死去已久的人。恩泽及于死者。形容给人恩惠极大。","source":{"text":"文王贤矣，泽及髊骨，又况于人乎！","book":"《吕氏春秋·孟冬纪·异用》"},"similar":["泽及髊骨"],"usage":"作谓语、定语；指给人恩惠极大"},{"id":28831,"word":"泽吻磨牙","pinyin":"zé wěn mó yá","abbr":"zwmy","explanation":"犹言龇牙咧嘴。凶残的样子。","source":{"text":"于是索元礼、来俊臣之徒，揣后密旨，纷纷并兴，泽吻磨牙，噬绅缨若狗豚然。","book":"《新唐书·酷吏传序》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":28832,"word":"泽深恩重","pinyin":"zé shēn ēn zhòng","abbr":"zsez","explanation":"德泽深远，恩情厚重。","source":{"text":"当陛下圣明之朝，事出非常，泽深恩重，今者誓将沥血，未足竭诚，徒欲杀身，岂能报答。","book":"唐·张说《谢京城东亭子宴送表》"},"usage":"作谓语、定语；用于书面语"},{"id":28833,"word":"泽畔吟","pinyin":"zé pàn yín","abbr":"zpy","explanation":"泽畔：湖泽旁边。在湖泽旁边吟颂。形容官吏被贬失意时所写的作品。","source":{"text":"空将泽畔吟，寄尔江南管。","book":"《史记·屈原贾生列传》；唐·李白《流夜郎至西塞驿寄裴隐》"},"example":{"text":"计日西归在，休为～。（唐·戎昱《送郑炼师贬辰州》）"}},{"id":28834,"word":"泽被后世","pinyin":"zé bèi hòu shì","abbr":"zbhs","explanation":"泽：恩泽，恩惠。被：覆盖。恩惠遍及到后代的人民。","source":{"text":"李冰父子为了解决当时成都平原的水利问题，不知克服了多少困难，终于修成了泽被后世的都江堰。","book":"陶铸《崇高的理想》"}},{"id":28835,"word":"泾浊渭清","pinyin":"jīng zhuó wèi qīng","abbr":"jzwq","explanation":"泾水浊，渭水清。比喻人品的高下和事物的好坏，显而易见。","source":{"text":"言泾水以有渭水清，故见泾水浊。","book":"《诗经·邶风·谷风》：“泾以渭浊，湜湜其沚。”孔颖达疏"},"example":{"text":"泾涨渭涸，则‘泾清渭浊’；泾涸渭涨，则‘～’。","book":"清·谭嗣同《石菊影庐笔识》"},"similar":["泾渭分明"],"opposite":["泾渭不分"],"usage":"作宾语、定语；指界限分明"},{"id":28836,"word":"泾清渭浊","pinyin":"jīng qīng wèi zhuó","abbr":"jqwz","explanation":"泾水清，渭水浊。比喻人品的高下和事物的好坏，显而易见。","source":{"text":"言泾水以有渭水清，故见泾水浊。","book":"《诗经·邶风·谷风》：“泾以渭浊，湜湜其沚。”唐·孔颖达疏"},"example":{"text":"泾涨渭涸，则‘～’；泾涸渭涨，则‘泾清渭浊’。","book":"清·谭嗣同《石菊影庐笔识》"},"similar":["泾渭分明"],"opposite":["泾渭不分"],"usage":"作宾语、定语；指界限分明"},{"id":28837,"word":"泾渭不分","pinyin":"jīng wèi bù fēn","abbr":"jwbf","explanation":"泾水和渭水清浊不分。比喻好坏不分，是非不明。","source":{"text":"熏莸无辨，泾渭不分，二纪于兹，莫之能整。","book":"唐·陆贽《又论进瓜果人拟官状》"},"example":{"text":"江南既定，人材毕集，若复～，则君子气沮。","book":"《清史稿·李森先传》"},"similar":["莫伪莫辨","目迷五色","是非不分"],"opposite":["是非分明","泾渭分明"],"usage":"作谓语、宾语、定语；指好坏是非不分"},{"id":28838,"word":"泾渭分明","pinyin":"jīng wèi fēn míng","abbr":"jwfm","explanation":"泾河水清，渭河水浑，泾河的水流入渭河时，清浊不混。比喻界限清楚或是非分明。","source":{"text":"泾以渭浊，湜湜其沚。","book":"《诗经·邶风·谷风》"},"example":{"text":"～缘底事，元戎总未计恩仇。","book":"林伯渠《和朱总出太行韵》"},"similar":["一清二楚","黑白分明"],"opposite":["不分皂白","泾渭不分","黑白不分"],"usage":"作谓语、宾语、定语；指界限清楚"},{"id":28839,"word":"泾渭同流","pinyin":"jīng wèi tóng liú","abbr":"jwtl","explanation":"泾渭：泾水、渭水。比喻是非、好坏不分。","source":{"text":"夫岂知世终异数，泾渭同流。","book":"唐·王勃《上刘右相书》"},"similar":["泾渭不分"],"opposite":["泾渭分明"],"usage":"作谓语、宾语、定语；指好坏是非不分"},{"id":28840,"word":"泾渭自分","pinyin":"jīng wèi zì fēn","abbr":"jwzf","explanation":"比喻界限清楚或是非分明。同“泾渭分明”。","source":{"text":"遇物而泾渭自分，立诚而风雨如晦。","book":"唐·李德裕《刘公神道碑铭》"},"example":{"text":"大家一会，～矣。","book":"清·无名氏《玉娇梨》第19回"},"similar":["泾渭分明","泾渭自明"],"opposite":["泾渭不分"],"usage":"作谓语、宾语、定语；指界限清楚"},{"id":28841,"word":"泾渭自明","pinyin":"jīng wèi zì míng","abbr":"jwzm","explanation":"比喻界限清楚或是非分明。同“泾渭分明”。","source":{"text":"然咏歌太平，无非圣朝佳话，间有稍关时事者，其泾渭自明。","book":"明·沈德符《野获编·续编小引》"},"similar":["泾渭自分","泾渭分明"],"opposite":["泾渭不分"],"usage":"作谓语、宾语、定语；指界限清楚"},{"id":28842,"word":"洁己从公","pinyin":"jié jǐ cóng gōng","abbr":"jjcg","explanation":"保持自身廉洁，一心奉行公事。同“洁己奉公”。","source":{"text":"是时湖北不仅财政充裕，同志皆洁己从公，而军械子弹被服，亦甚充足。","book":"《辛亥革命·武昌起义·湖北军政府都督命令》"},"similar":["洁己奉公"],"usage":"作谓语、定语；指廉洁奉公"},{"id":28843,"word":"洁己奉公","pinyin":"jié jǐ fèng gōng","abbr":"jjfg","explanation":"保持自身廉洁，一心奉行公事。","source":{"text":"法命肃齐，文武毕力，洁己奉公，以身率下。","book":"《宋书·林邑国》"},"example":{"text":"万想不到果真总督大人还要当当，真算得～第一等好官了。","book":"清·李宝嘉《文明小史》第13回"},"similar":["克己奉公","洁己从公"],"usage":"作谓语、定语；指廉洁奉公"},{"id":28844,"word":"洁己爱人","pinyin":"jié jǐ ài rén","abbr":"jjar","explanation":"指洁身自好，爱护他人。","source":{"text":"所至洁己爱人，扶植风教。","book":"《明史·刘魁传》"},"example":{"text":"其各殚忠尽职，～，利弊悉以上闻，德意期于下究。","book":"《清史稿·世祖纪》"},"usage":"作谓语、宾语；指为人处世"},{"id":28845,"word":"洁浊扬清","pinyin":"jié zhuó yáng qīng","abbr":"jzyq","explanation":"犹激浊扬清。比喻清除坏的，发扬好的。","source":{"text":"至洁浊扬清，疾恶好善，臣于数子有一日之长。","book":"《新唐书·王珪传》"},"similar":["激浊扬清"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":28846,"word":"洁清不洿","pinyin":"jié qīng bù wū","abbr":"jqbw","explanation":"洁清：纯洁清白；洿：同“污”，污浊。保持清纯的品质，不同流合污。","source":{"text":"独安能使我洁清不洿，而处其所可乐哉！","book":"唐·韩愈《与李翱书》"},"usage":"作谓语；指人的品性"},{"id":28847,"word":"洁清自矢","pinyin":"jié qīng zì shǐ","abbr":"jqzs","explanation":"指保持自身清廉正直。","source":{"text":"以李侍尧、国泰所办贡物过优，皆致罪戾，谕各督抚等惟当洁清自矢，毋专以进献为能。","book":"《清史稿·高宗纪》"},"usage":"作谓语、定语；用于书面语"},{"id":28848,"word":"洁言污行","pinyin":"jié yán wū xǐng","abbr":"jywx","explanation":"洁净的言辞，污秽的行为。形容言行不一，表里相违。","source":{"text":"文学言行，虽人伯夷之廉，不及柳下惠之贞，不过高瞻下视，洁言污行，觞酒豆肉，迁延相让，辞小取大，鸡廉狼吞。","book":"汉·桓宽《盐铁论·褒贤》"},"similar":["言行不一","表里不一"],"opposite":["言行一致"],"usage":"作宾语、定语；用于书面语"},{"id":28849,"word":"洁身守道","pinyin":"jié shēn shǒu dào","abbr":"jssd","explanation":"指保持自身纯洁，坚守正道。","source":{"text":"洁身守道，不与世陷乎邪。","book":"《晏子春秋·问上》"}},{"id":28850,"word":"洁身累行","pinyin":"jié shēn lèi xíng","abbr":"jslx","explanation":"纯洁身心，约束自己的行为。累，通“缧”。","source":{"text":"士之能修其内，洁身累行者，非自好之笃莫能至，而世亦罕能知之也。","book":"宋·曾巩《库部员外郎范君墓志铭》"},"usage":"作谓语、定语；用于书面语"},{"id":28851,"word":"洁身自好","pinyin":"jié shēn zì hào","abbr":"jszh","explanation":"保持自己纯洁，不同流合污。也指怕招惹是非，只顾自己好，不关心公众事情。","source":{"text":"归洁其身而已矣。","book":"《孟子·万章上》"},"example":{"text":"他以作家、教授的身份、地位，～，有所不为，对国家的前途，忧心忡忡。","book":"臧克家《老舍永在》"},"similar":["明哲保身"],"opposite":["同流合污"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":28852,"word":"洁身自守","pinyin":"jié shēn zì shǒu","abbr":"jszs","explanation":"保持住个人自身的纯洁。","source":{"text":"她在大学时曾经恋爱过，但由于这次恋爱严重地伤害了她的心，以后她就把情丝一刀斩断，洁身自守了。","book":"陈国凯《我应该怎么办》"},"similar":["洁身自好"],"opposite":["同流合污"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":28853,"word":"洁身自爱","pinyin":"jié shēn zì ài","abbr":"jsza","explanation":"保持自己纯洁，不同流合污。也指怕招惹是非，只顾自己好，不关心公众事情。","source":{"text":"归洁其身而已矣。","book":"《孟子·万章上》"},"example":{"text":"纵为生活所迫，不得不按时上班，也当～，不与人同桌进食，同杯用茶，以免传布病菌，贻害他人。","book":"巴金《寒夜》"},"similar":["洁身自好","束身自爱","束身自修"],"opposite":["同流合污"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":28854,"word":"洋为中用","pinyin":"yáng wéi zhōng yòng","abbr":"ywzy","explanation":"批判地吸收外国文化中一切有益的东西，为我所用。","source":{"text":"古为今用，洋为中用。","book":"毛泽东《对中央音乐学院的意见的批示》"},"example":{"text":"～和古为今用要有机地结合。"},"opposite":["全盘西化"],"usage":"作谓语、定语；指吸收外来文化"},{"id":28855,"word":"洋洋万言","pinyin":"yáng yáng wàn yán","abbr":"yywy","explanation":"洋洋：众多、盛大的样子；言：字。形容文章写得很长。"},{"id":28856,"word":"洋洋大观","pinyin":"yáng yáng dà guān","abbr":"yydg","explanation":"洋洋：盛大、众多的样子；大观：丰富多采的景象。形容美好的事物众多丰盛。","source":{"text":"夫道，覆载万物者也，洋洋乎大哉！","book":"《庄子·天地》"},"example":{"text":"到了《诗经》时代，有了琴瑟钟鼓，已是～了。","book":"朱自清《经典常谈·诗经第四》"},"similar":["蔚为大观","洋洋洒洒","声势浩大"],"opposite":["微不足道"],"usage":"作谓语、定语、宾语；用于文章、问题"},{"id":28857,"word":"洋洋得意","pinyin":"yáng yáng dé yì","abbr":"yydy","explanation":"形容得意时神气十足的姿态。","source":{"text":"意气扬扬，甚自得也。","book":"《史记·管晏列传》"},"example":{"text":"一席话说得夏作人～。","book":"清·吴趼人《二十年目睹之怪现状》第五十六回"},"similar":["得意洋洋"],"usage":"作谓语、定语；指非常得意"},{"id":28858,"word":"洋洋洒洒","pinyin":"yáng yáng sǎ sǎ","abbr":"yyss","explanation":"洋洋：盛大、众多的样子；洒洒：明白、流畅的样子。形容文章或谈话丰富明快，连续不断。","source":{"text":"所以难言者，言顺此滑泽，洋洋洒洒，则见以为华而不实。","book":"《韩非子·难言》"},"example":{"text":"局面询问也用不着～的大文章。","book":"邹韬奋《抗战以来·“来宾”的建议》"},"similar":["鸿篇巨制","挥洒自如","洋洋万言"],"opposite":["味同嚼蜡","简明扼要"],"usage":"作定语、状语；用于文章或谈话"},{"id":28859,"word":"洋洋盈耳","pinyin":"yáng yáng yíng ěr","abbr":"yyye","explanation":"洋洋：众多；盈：充满。指宏亮而优美的声音充满双耳。形容讲话、读书的声音悦耳动听。","source":{"text":"师挚之始，《关雎》之乱，洋洋乎，盈耳哉。","book":"《论语·泰伯》"},"example":{"text":"今也名贤秀士，济济一堂，大义正音，～。","book":"清·归庄《静观楼讲义序》"},"usage":"作谓语、定语；用于书面语"},{"id":28860,"word":"洋洋纚纚","pinyin":"yáng yáng sǎ sǎ","abbr":"yyss","explanation":"形容盛美而有条理。","source":{"text":"所以难言者，言顺比滑泽，洋洋纚纚然，则见以为华而不实。","book":"《韩非子·难言》"},"similar":["洋洋洒洒"],"usage":"作定语、状语；用于书面语"},{"id":28861,"word":"洋洋自得","pinyin":"yáng yáng zì dé","abbr":"yyzd","explanation":"犹言洋洋得意。形容得意时神气十足的姿态。","source":{"text":"鄙陋之夫以一材一艺自诩，腐朽之士以一文一诗自矜，洋洋自得，沾沾自喜。","book":"铁厓《名说》"},"example":{"text":"他一走三晃，十分～，连脚步都有些轻飘飘的。","book":"魏巍《东方》第四部第六章"},"similar":["洋洋得意"],"opposite":["垂头丧气"],"usage":"作谓语、定语、状语；指非常得意"},{"id":28862,"word":"洋漆马桶","pinyin":"yáng qī mǎ tǒng","abbr":"yqmt","explanation":"马桶：粪桶。用西洋漆漆过的粪桶。指服饰华丽而无德无才的人","source":{"text":"不意他是个洋漆马桶，外面光彩，肚里臭不可闻。","book":"清·李百川《绿野仙踪》第49回"},"similar":["金漆马桶"],"usage":"作宾语、定语；指缺德的人"},{"id":28863,"word":"洋相百出","pinyin":"yáng xiàng bǎi chū","abbr":"yxbc","explanation":"尽是逗人发笑的怪样子。","example":{"text":"我最喜欢看她那～的样子。"},"similar":["丑态百出"],"usage":"作谓语、宾语、定语；用于人的神态"},{"id":28864,"word":"洒心更始","pinyin":"sǎ xīn gèng shǐ","abbr":"sxgs","explanation":"犹言改过自新。自改正错误，重新做起。","source":{"text":"谋反大逆不道诸犯，不当得赦皆除之，将与士大夫洒心更始。","book":"汉·王符《潜夫论·述赦》"},"similar":["改过自新"],"usage":"作谓语、定语；用于书面语"},{"id":28865,"word":"洒扫应对","pinyin":"sǎ sào yìng duì","abbr":"ssyd","explanation":"洒水扫地，酬答宾客。封建时代儒家教育、学习的基本内容之一。","source":{"text":"人生八岁，则自王公以下，至于庶人之子弟，皆入小学，而教之以洒扫应对进退之节，礼乐射御书数之文。","book":"宋·朱熹《〈大学章句〉序》"},"example":{"text":"圣人之道，贯彻上下，自～，以至均平天下，其事理一也。","book":"明·王廷相《慎言·作圣》"},"usage":"作谓语、定语；用于处事"},{"id":28866,"word":"洒扫应对进退","pinyin":"sà sǎo yìng duì jìn tuì","abbr":"ssydjt","explanation":"洒扫：河水扫地，泛指家务事；进退：迎送客人之类的礼节。旧指青年人居家在尊长、客人面前应做的起码的事。","source":{"text":"子夏之门人小子，当洒扫应对进退，则可矣，抑未也。","book":"《论语·子张》"},"example":{"text":"二仪之奠，日月星辰之纪，氓庶之生成，鬼神之情状，草木鸟兽之成若，～之琐，皆吾性分之所有事。","book":"清·曾国藩《书学案小识后》"}},{"id":28867,"word":"洒泪而别","pinyin":"sǎ lèi ér bié","abbr":"sleb","explanation":"流着泪告别。","source":{"text":"众人都在江边，安排行枷，取酒食上船饯行，当下众人洒泪而别。","book":"明·施耐庵《水浒全传》第三十七回"},"example":{"text":"秦老手提一个小白灯笼，直送出村口，～。","book":"清·吴敬梓《儒林外史》第一回"}},{"id":28868,"word":"洒洒洋洋","pinyin":"sǎ sǎ yáng yáng","abbr":"ssyy","explanation":"洒洒：明白、流畅的样子；洋洋：盛大、众多的样子。形容文章或谈话丰富明快，连续不断。","source":{"text":"所以难言者，言顺此滑泽，洋洋洒洒，则见以为华而不实。","book":"《韩非子·难言》"},"example":{"text":"则至今犹如天之无云，水之无波，树之无风，而纸之无字，亦安望有此～奇奇怪怪五十余万言耶？","book":"清·陈森《品花宝鉴》序"}},{"id":28869,"word":"洒洒潇潇","pinyin":"sǎ sǎ xiāo xiāo","abbr":"ssxx","explanation":"犹落落大方。","source":{"text":"厌桃香灼灼夭夭，伴松篁洒洒潇潇。","book":"元·汤式《一枝花·题白梅深处》套曲"},"example":{"text":"他出落得～。"},"similar":["潇潇洒洒","落落大方"],"usage":"作谓语；同“潇潇洒洒”"},{"id":28870,"word":"洒狗血","pinyin":"sǎ gǒu xuè","abbr":"sgx","explanation":"形容演员脱离情节而卖弄技巧或作一些过火表演。"},{"id":28871,"word":"洒酽春浓","pinyin":"jiǔ yàn chūn nóng","abbr":"sycn","explanation":"酽：味厚，味浓。酒味醇美，春意盎然。形容美好圆满的时刻。","source":{"text":"酒酽春浓琼草齐，真公饮散醉如泥。","book":"唐·曹唐《小游仙》"}},{"id":28872,"word":"洗兵不用","pinyin":"xǐ bīng bù yòng","abbr":"xbby","explanation":"兵：兵器。洗净兵器。收藏起来，不再使用。比喻停止战争。","source":{"text":"安得壮士挽天河，净洗甲兵长不用。","book":"唐·杜甫《洗兵马》"}},{"id":28873,"word":"洗兵牧马","pinyin":"xǐ bīng mù mǎ","abbr":"xbmm","explanation":"洗擦兵器，喂养战马。指做好作战准备。","source":{"text":"吾洗兵牧马，坐食转输，温饱有馀。俟城中无食，公帑家财皆竭，然后进梯冲以逼之，飞羽檄以招之。","book":"《资治通鉴·后汉高祖乾祐元年》"},"usage":"作谓语、宾语；指作战斗准备"},{"id":28874,"word":"洗削更革","pinyin":"xǐ xiāo gēng gé","abbr":"xxgg","explanation":"清洗、削平、更改、变革。形容大刀阔斧地进行改革。","source":{"text":"洗削更革，罔不顺适，唯山东不服，亦再攻之，皆不利以返。","book":"唐·杜牧《罪言》"},"usage":"作宾语、定语；用于书面语"},{"id":28875,"word":"洗劫一空","pinyin":"xǐ jié yī kōng","abbr":"xjyk","explanation":"洗劫、抢光。","example":{"text":"八国联军把北京城～。"},"usage":"作谓语；指抢劫"},{"id":28876,"word":"洗垢匿瑕","pinyin":"xǐ gòu nì xiá","abbr":"xgnx","explanation":"洗涤玉的污垢时，遮盖其斑点。比喻对人有所包涵。","source":{"text":"所以上昭圣明，伏老念旧，洗垢匿瑕之美意，下使衰朽捐弃之人，得托退休之号，除废锢之籍，而少慰其出身。","book":"宋·朱熹《与宰执札子三十三》之三十三"}},{"id":28877,"word":"洗垢寻痕","pinyin":"xǐ gòu xún hén","abbr":"xgxh","explanation":"垢：污垢；痕：痕迹。洗掉污垢来寻找痕迹。比喻想尽办法挑剔别人的缺点。","source":{"text":"所好，则钻皮出其毛屑；所恶，则洗垢求其瘢痕。","book":"汉·赵壹《刺世疾邪赋》"},"example":{"text":"不想他苦恹恹痛遭危困，只因笑吟吟陷平人～。","book":"元·孔文卿《东窗事犯》第四折"}},{"id":28878,"word":"洗垢寻瘢","pinyin":"xǐ gòu xún bān","abbr":"xgxb","explanation":"垢：污垢；瘢：瘢痕。洗掉污垢来寻找瘢痕。比喻想尽办法挑剔别人的缺点。","source":{"text":"所好，则钻皮出其毛屑；所恶，则洗垢求其瘢痕。","book":"汉·赵壹《刺世疾邪赋》"}},{"id":28879,"word":"洗垢求瑕","pinyin":"xǐ gòu qiú xiá","abbr":"xgqx","explanation":"比喻想尽办法挑剔别人的缺点。同“洗垢求瘢”。","source":{"text":"以次知党人之意，未尝一日不在倾臣，洗垢求瑕，止得此事。","book":"宋·苏轼《杭州召还乞郡状》"},"similar":["洗垢索瘢","洗垢求瘢"],"usage":"作谓语、定语；指过分挑剔别人的缺点"},{"id":28880,"word":"洗垢求瘢","pinyin":"xǐ gòu qiú bān","abbr":"xgqb","explanation":"垢：污垢；瘢：瘢痕。洗掉污垢来寻找瘢痕。比喻想尽办法挑剔别人的缺点。","source":{"text":"所好则钻皮出其毛羽，所恶则洗垢求其瘢痕。","book":"南朝·宋·范晔《后汉书·文苑传下·赵壹》"},"example":{"text":"惟以格律痛绳之，～，苛甚。","book":"元·刘祁《归潜志》第九卷"},"similar":["百般挑剔","洗垢索瘢","吹毛求疵"],"usage":"作谓语；指过分挑剔别人的缺点"},{"id":28881,"word":"洗垢索瘢","pinyin":"xǐ gòu suǒ bān","abbr":"xgsb","explanation":"洗掉污垢来寻找瘢痕。比喻想尽办法挑剔别人的缺点。同“洗垢求瘢”。","source":{"text":"好则钻皮出羽，恶则洗垢索瘢。","book":"《新唐书·魏徵传》"},"example":{"text":"若知其出于老氏，宋儒必～，曲为讥评；但知其出于经，则护持交赞。此亦矮人之观场也。","book":"明·杨慎《升庵诗话老子论性》"},"similar":["洗垢求瑕"],"usage":"作谓语、定语；用于处事"},{"id":28882,"word":"洗尘接风","pinyin":"xǐ chén jiē fēng","abbr":"xcjf","explanation":"指设宴款待远来的客人，以示慰问和欢迎","source":{"text":"殷氏同欧阳氏将他扶入后院房中，劝解了一番，回到前边，与文魁洗尘接风。","book":"清·李百川《绿野仙踪》第19回"},"similar":["接风洗尘"],"usage":"作谓语、宾语、定语；用于交往等"},{"id":28883,"word":"洗心回面","pinyin":"xǐ xīn huí miàn","abbr":"xxhm","explanation":"比喻彻底悔改。同“洗心革面”。","source":{"text":"［楚士］习其反复教诲，出于至诚，莫不洗心回面，誓不忍负。","book":"清·钱谦益《王淑士墓志铭》"},"similar":["洗心革面","革面洗心"],"usage":"作谓语、定语；指彻底悔改"},{"id":28884,"word":"洗心换骨","pinyin":"xǐ xīn huàn gǔ","abbr":"xxhg","explanation":"道家语，指洗去尘心，换掉凡骨，即可超离凡尘而入圣。","source":{"text":"为吾洗心复换骨，背凡入圣奔长生。","book":"宋·张君房《云笈七签·翊圣保德真君传》"},"similar":["脱胎换骨"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":28885,"word":"洗心涤虑","pinyin":"xǐ xīn dí lǜ","abbr":"xxdl","explanation":"指涤除私心杂念，比喻彻底改悔。","source":{"text":"而天下皆洗心涤滤，以听朝廷之所为。","book":"宋·苏轼《策略二》"},"example":{"text":"自是知县～，遂为良牧。","book":"明·冯梦龙《警世通言》"},"similar":["洗心革面"],"usage":"作谓语、定语；指涤除私心杂念"},{"id":28886,"word":"洗心自新","pinyin":"xǐ xīn zì xīn","abbr":"xxzx","explanation":"清洗心中污浊，改过自新。比喻认真悔改。","source":{"text":"其党康花七者，家已丰余，欲洗心自新，佯为出探官军，密以告慰。","book":"宋·洪迈《夷坚丁志·谢花六》"},"example":{"text":"追悔既往，～，虽失之于壮齿，冀收之于晚节。","book":"《云笈七签》卷九三"},"similar":["洗心革面"],"usage":"作谓语；指重新做人"},{"id":28887,"word":"洗心革志","pinyin":"xǐ xīn gé zhì","abbr":"xxgz","explanation":"指彻底改变旧有心思和意向。","source":{"text":"皆延颈以视，倾耳以听，希道慕业，洗心革志，想洙泗之风，歌来苏之惠。","book":"《晋书·潘尼传》"},"similar":["洗心革意"],"usage":"作谓语、定语；用于处事"},{"id":28888,"word":"洗心革意","pinyin":"xǐ xīn gé yì","abbr":"xxgy","explanation":"指彻底改变旧有心思和意向。同“洗心革志”。","source":{"text":"凡诸牧守令长，宜洗心革意，上承朝旨，下宣教化矣。","book":"《周书·苏绰传》"},"similar":["洗心革志"],"usage":"作谓语、定语；用于处事"},{"id":28889,"word":"洗心革面","pinyin":"xǐ xīn gé miàn","abbr":"xxgm","explanation":"清除旧思想，改变旧面貌。比喻彻底悔改。","source":{"text":"洗心而革面者，必若清波之涤轻尘。","book":"《周易·系辞上》：“圣人以此洗心，退藏于密。”《周易·革》：“君子豹变，小人革面。”《抱朴子·用刑》"},"example":{"text":"除非它真能放弃传统意识，完全～，重新做起。","book":"闻一多《神话与诗·文学的历史动向》"},"similar":["改过自新","痛改前非"],"opposite":["顽固不化","死不改悔"],"usage":"作谓语、定语；指重新做人"},{"id":28890,"word":"洗手不作","pinyin":"xǐ shǒu bù zuò","abbr":"xsbz","explanation":"洗手：比喻清白廉洁。原是盗贼的行话，放弃盗贼的勾当，不再干了。比喻对某项职业或事情不再继续干了。","source":{"text":"小人从前原也作些小道儿上的买卖，后来洗手不干，就在河工上充了一个夫头。","book":"清·文康《儿女英雄传》第十一回"},"example":{"text":"待到称为诗人的一出现，就～了。","book":"鲁迅《集外集·序言》"},"similar":["洗手不干"],"usage":"作谓语；指做过的事不再干了"},{"id":28891,"word":"洗手不干","pinyin":"xǐ shǒu bù gàn","abbr":"xsbg","explanation":"把手洗干净休息了。","source":{"text":"小人从前原也作些小道儿上的买卖，后来洗手不干，就在河工上充了一个夫头。","book":"清·文康《儿女英雄传》"},"example":{"text":"自己只带得这个女儿秀姑，逃到北京来，～，专做好人。","book":"张恨水《啼笑姻缘》第一回"},"similar":["改邪归正","洗心革面","洗手不作"],"opposite":["死不悔改","执迷不悟"],"usage":"作谓语；指做过的事不再干了"},{"id":28892,"word":"洗手奉公","pinyin":"xǐ shǒu fèng gōng","abbr":"xsfg","explanation":"比喻忠于职守，廉洁奉公。同“洗手奉职”。","source":{"text":"宫闱日用之数，视前代不过什二三，而内务府堂郎中皆视为脂膏窟泽，相沿积习，几无一洗手奉公之人。","book":"清·陈康祺《郎潜纪闻》卷十一"},"similar":["洗手奉职"],"usage":"作谓语、定语；指忠于职守"},{"id":28893,"word":"洗手奉职","pinyin":"xǐ shǒu fèng zhí","abbr":"xsfz","explanation":"洗手：使手干净，比喻廉洁；奉职：担任职务。比喻忠于职守，廉洁奉公。","source":{"text":"建中四年，侍郎赵赞为度支使，荐公为监察御史，主馈给渭桥以东军，洗手奉职，不以一钱假人。","book":"唐·韩愈《唐故中散大夫少府监胡良公墓神道碑》"},"similar":["洗手奉公"],"usage":"作谓语、定语；指忠于职守"},{"id":28894,"word":"洗濯磨淬","pinyin":"xǐ zhuó mó cuì","abbr":"xzmc","explanation":"指修养锻炼。","source":{"text":"士大夫皆自洗濯磨淬，戮力于王事，而不敢为非常可怪之行。此三代王政之所由兴也。","book":"宋·苏轼《上韩太尉书》"},"example":{"text":"明·李东阳《祁阳县学重修记》：“尔诸王归而求之，～入圣贤之域，庶几尔业与兹学其俱新也。”"},"usage":"作谓语、宾语；用于书面语"},{"id":28895,"word":"洗眉刷目","pinyin":"xǐ méi shuā mù","abbr":"xmsm","explanation":"比喻清晰明白。","source":{"text":"此考（《职方考》）虽简略，然提纲挈领，洗眉刷目。此则欧公笔力，非薛史所能及。","book":"清·王鸣盛《十七史商榷·新旧五代史四·五代土地梁最小唐最大》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":28896,"word":"洗耳不闻","pinyin":"xǐ ěr bù wén","abbr":"xebw","explanation":"比喻不愿意听或不愿过问世事。","source":{"text":"尧又召为九州长，由不欲闻之，洗耳于颍水滨。","book":"晋·皇甫谧《高士传·许由》"},"example":{"text":"旁有大夫散宜生欠身言曰：“‘～亡国音’”者何也？”","book":"明·许仲琳《封神演义》第二十四回"}},{"id":28897,"word":"洗耳恭听","pinyin":"xǐ ěr gōng tīng","abbr":"xegt","explanation":"洗干净耳朵恭恭敬敬听别人讲话。请人讲话时的客气话。指专心地听。","source":{"text":"请大王试说一遍，容小官洗耳恭听。","book":"元·郑廷玉《楚昭公》第四折"},"example":{"text":"如此甚妙，我们～。","book":"清·李汝珍《镜花缘》第七十八回"},"similar":["倾耳细听"],"opposite":["充耳不闻"],"usage":"作谓语、宾语、定语；用于讽刺或诙谐","story":["传说尧帝想让位给隐世高人许由，派使者去游说他。许由坚决不同意，觉得使者的话污染了他清静的耳朵，立即跑到山下颖水边去捧水洗耳，许由的朋友巢父恰好牵牛在饮水，听说原委后就牵牛去上游饮水，以免玷污小牛的嘴"]},{"id":28898,"word":"洗耳投渊","pinyin":"xǐ ěr tóu yuān","abbr":"xety","explanation":"洗耳、投渊：指尧让位于许由、舜让位北铎的传说。旧时指隐逸的人厌恶听有关政治的事。","source":{"text":"故有洗耳投渊，以振玄邈之风。","book":"晋·桓温《荐谯元彦表》"}},{"id":28899,"word":"洗耳拱听","pinyin":"xǐ ěr gǒng tīng","abbr":"xegt","explanation":"请人讲话时的客气话。指专心地听。同“洗耳恭听”。","source":{"text":"哥哥才学，与在下不同，有什么名人古书，前皇后代，哥哥讲说些儿，小官洗耳拱听。","book":"元·宫天挺《范张鸡黍》第一折"},"example":{"text":"必须再求一风月艳丽之曲，我等～，幸勿推辞。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"similar":["洗耳恭听"],"usage":"作谓语、宾语、定语；用于讽刺或诙谐"},{"id":28900,"word":"洗肠涤胃","pinyin":"xǐ cháng dí wèi","abbr":"xcdw","explanation":"①比喻彻底清除。②比喻彻底改过。","source":{"text":"若权奸之去，则正当洗肠涤胃，若借温太真之事，为小人开一线之路，借范尧夫之言，为君子忧后来之祸，则失之矣。","book":"宋·罗大经《鹤林玉露》卷十六"},"example":{"text":"［诸生］从此～，以听指南。","book":"明·沈德符《野获编·吏部一·异途任用》"},"similar":["洗心革面"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":28901,"word":"洗脚上船","pinyin":"xǐ jiǎo shàng chuán","abbr":"xjsc","explanation":"指居于水滨，舟行极便。","source":{"text":"扞孙权呴欲作坞，诸将皆曰：‘上岸击贼，洗足入船，何用坞为？’","book":"语出《三国志·吴志·吕蒙传》：“又劝权夹水口立坞”裴松之注引晋张勃《吴录》"},"example":{"text":"宋·岳珂《桯史·郭倪自比诸葛亮》：“君所谓～也，予生西陲，如斜谷、祁山，皆狭隘，可守而不可出。”"},"usage":"作宾语、定语；用于书面语"},{"id":28902,"word":"洗雪逋负","pinyin":"xǐ xuě bū fù","abbr":"xxbf","explanation":"洗雪：队掉；逋负：旧欠，引伸为旧恨。报仇雪恨，以偿夙愿。","source":{"text":"洗雪百年之逋负，以慰忠将之亡魂。","book":"《后汉书·段颎传》"},"usage":"作谓语；指报仇雪恨"},{"id":28903,"word":"洗颈就戮","pinyin":"xǐ jǐng jiù lù","abbr":"xjjl","explanation":"把脖子洗净，伸到刀下受斩。比喻等待灭亡。","source":{"text":"不看丞相之面，先斩汝首！今且放汝回去，说与孙权：洗颈就戮！","book":"明·罗贯中《三国演义》第八十二回"},"example":{"text":"他说传话相爷，叫相爷～呢！","book":"清·吴趼人《痛史》第六回"},"similar":["引颈就戮","坐以待毙","束手就擒"],"usage":"作宾语、定语；用于处事等"},{"id":28904,"word":"洗髓伐毛","pinyin":"xǐ suǐ fá máo","abbr":"xsfm","explanation":"清洗骨髓，削除毛发。比喻彻底涤除自身的污秽。有脱胎换骨的意思。","source":{"text":"汉张良蹑足附耳，东方朔洗髓伐毛。","book":"明·程登吉《幼学琼林·身体》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“汉张良蹑足附耳，黄眉翁～。”"},"similar":["伐毛洗髓"],"usage":"作谓语；指脱胎换骨","story":["西汉时期，东方朔说他认识一个仙人叫黄眉翁，三千年洗一次骨髓，两千年剥一次皮换一次毛，现在已经有九千多岁了，已经洗了三次骨髓，伐了五次皮毛"]},{"id":28905,"word":"洛阳才子","pinyin":"luò yáng cái zǐ","abbr":"lycz","explanation":"本指西汉贾谊。泛指有文学才华的人。","source":{"text":"终童山东之英妙，贾生洛阳之才子。","book":"晋·潘岳《西征赋》"},"example":{"text":"洛阳城里春光好，～他乡老。","book":"前蜀·韦庄《菩萨蛮》"},"usage":"作宾语；指有文学才华的人"},{"id":28906,"word":"洛阳纸贵","pinyin":"luò yáng zhǐ guì","abbr":"lyzg","explanation":"比喻著作有价值，流传广。","source":{"text":"于是豪贵之家竞相传写，洛阳为之纸贵。","book":"《晋书·左思传》"},"example":{"text":"人说“～”，谁知今日闹到“长安扇贵”。此时画的手也酸了，眼也花了。","book":"清·李汝珍《镜花缘》第七十七回"},"similar":["有口皆碑","交口称誉","有目共赏"],"usage":"作宾语、定语、补语；指作品好","story":["西晋文学家左思勤奋好学，他的文章以辞藻华丽而出名。他写《齐都赋》时就小有名气，作为“著作郎”，花费十年时间写成《三都赋》。当时著名学者皇甫谧及张载、卫王灌、张华等为之批注作序，一时洛阳抄写该书成为时尚造成纸价上涨"]},{"id":28907,"word":"洞中肯綮","pinyin":"dòng zhōng kěn qǐng","abbr":"dzkq","explanation":"观察敏锐，言论能掌握问题的关键处。","source":{"text":"郡之良二千石政事有所未达，辄往咨访，性从容开导，洞中肯綮，裨益者多。","book":"《元史·韩性传》"},"example":{"text":"她说话做事都能～。"},"similar":["击中要害","切中时弊"],"opposite":["无的放矢"],"usage":"作谓语、定语；指切中问题的症结"},{"id":28908,"word":"洞天福地","pinyin":"dòng tiān fú dì","abbr":"dtfd","explanation":"原为道家语，指神道居住的名山胜地。后多比喻风景优美的地方。","source":{"text":"列出十大洞天、三十六小洞天、七十二福地的名称。","book":"唐·杜光庭《洞天福地记》"},"example":{"text":"如此～，倘得几间幽室，在此暂住几时，也不枉人生一世。","book":"清·李汝珍《镜花缘》第九十九回"},"similar":["名山大川","名胜古迹","桃源胜境"],"opposite":["穷乡僻壤","穷巷拙门"],"usage":"作宾语、定语；指风景优美的地方"},{"id":28909,"word":"洞如观火","pinyin":"dòng rú guān huǒ","abbr":"drgh","explanation":"形容观察事物非常清楚，好像看火一样。同“洞若观火”。","source":{"text":"得悉其山川险要部落游牧，暨其强弱多寡离合之情，皆洞如观火矣。","book":"清·刘献廷《广阳杂记》卷二"},"similar":["洞若观火"],"usage":"作谓语、定语；指看得清楚"},{"id":28910,"word":"洞察一切","pinyin":"dòng chá yī qiè","abbr":"dcyq","explanation":"对一切观察得很清楚。","source":{"text":"浓黑的眉梢下，又是那双炯炯有神、明亮、洞察一切的目光，还是那无比坚定、声震屋宇的语音。","book":"罗广斌《红岩》第五章"},"example":{"text":"他是一位能够～的政治家。"},"similar":["洞察其奸"],"opposite":["一无所知","一窍不通"],"usage":"作谓语、定语；指看得清"},{"id":28911,"word":"洞察其奸","pinyin":"dòng chá qí jiān","abbr":"dcqj","explanation":"对别人的阴谋诡计看得很清楚。","source":{"text":"嵩稔恶误国，陛下岂不洞烛其奸。","book":"《明史·董传策传》"},"example":{"text":"倘明哲君子，～……诸事预为防范，毋许临门，他又何所施其伎俩。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["洞烛其奸","明察秋毫","洞悉其奸"],"usage":"作谓语；指对别人的阴谋诡计看得很清楚"},{"id":28912,"word":"洞察秋毫","pinyin":"dòng chá qiū háo","abbr":"dcqh","explanation":"洞察：看得很清楚；秋毫：鸟兽秋天身上新生的细毛，比喻极其细小的事物。形容人目光敏锐，任何细小的事物都能看得很清楚。","source":{"text":"明足以察秋毫之末，而不见舆薪，则王许之乎？","book":"《孟子·梁惠王上》"},"similar":["明察秋毫"],"usage":"作谓语、定语；指看得清楚"},{"id":28913,"word":"洞幽察微","pinyin":"dòng yōu chá wēi","abbr":"dycw","explanation":"彻底地看到幽深微妙处。","example":{"text":"他对事物有洞幽察微的本事。"},"similar":["洞察其奸","洞若观火","见微知著"],"opposite":["雾里看花","不知就里","隐隐约约"],"usage":"作谓语、宾语、定语；指看得清楚"},{"id":28914,"word":"洞幽烛微","pinyin":"dòng yōu zhú wēi","abbr":"dyzw","explanation":"洞：洞察；幽：深远；烛：照亮；微：微末，精细处。形容目光锐利，能洞察事物幽深细微之处。","source":{"text":"有洞幽烛远之明，有含茹翕张不疾不徐之度。","book":"明·吴承恩《赠郡伯愚邵公报政序》"},"example":{"text":"谓能～，提纲挈领，非徒钻故纸者可比。","book":"清·马建忠《上李伯相言出洋工课书》"},"similar":["洞幽察微","洞隐烛微"],"opposite":["雾里看花"],"usage":"作谓语、定语；指人目光锐利"},{"id":28915,"word":"洞幽烛远","pinyin":"dòng yōu zhú yuǎn","abbr":"dyzy","explanation":"洞：洞察；幽：深远；烛：照亮。形容目光锐利，能洞察事物幽深细微之处。","source":{"text":"有洞幽烛远之明，有含茹翕张不疾不徐之度。","book":"明·吴承恩《赠郡伯古愚邵公报政序》"},"example":{"text":"他有～的眼光。"},"similar":["洞幽烛微"],"opposite":["雾里看花"],"usage":"作谓语、定语；指人目光锐利"},{"id":28916,"word":"洞彻事理","pinyin":"dòng chè shì lǐ","abbr":"dcsl","explanation":"洞彻：透彻，深远；理：道理，规律。深入透彻了解事物规律。","example":{"text":"我们要～，才能很好处理。"},"usage":"作谓语、宾语；用于处事"},{"id":28917,"word":"洞心骇目","pinyin":"dòng xīn hài mù","abbr":"dxhm","explanation":"形容使人惊异。","source":{"text":"‘濯龙’二大字，洞心骇目，得未曾有。","book":"宋·杨万里《答周监丞》"},"example":{"text":"初不知异闻之有录也。一日出示，余～，多闻所未闻者。","book":"清·卢文弨《跋》"},"similar":["洞心骇耳"],"usage":"作谓语；用于事情等"},{"id":28918,"word":"洞心骇耳","pinyin":"dòng xīn hài ěr","abbr":"dxhe","explanation":"形容使人震惊。","source":{"text":"金鼓迭起，铿锵铛鼞，洞心骇耳。","book":"《史记·司马相如列传》"},"similar":["洞心骇目"],"usage":"作谓语；用于事情等"},{"id":28919,"word":"洞悉其奸","pinyin":"dòng xī qí jiān","abbr":"dxqj","explanation":"洞悉：清楚地知道；奸：奸诈。看清楚对方的阴谋诡计。同“洞烛其奸”。","source":{"text":"甫出口，而上已洞悉其奸，斥逐不已。","book":"明·沈德符《野获编·列朝·庙议献谄不用》"},"similar":["洞见其奸","洞烛其奸","洞察其奸"],"usage":"作谓语、定语；指看问题敏锐"},{"id":28920,"word":"洞悉底蕴","pinyin":"dòng xī dǐ yùn","abbr":"dxdy","explanation":"洞悉：清楚地知道；底蕴：内情，事情的具体内容。透彻地观察到事物的详细内情。同“洞见底蕴”。","source":{"text":"先生自幼通于小学，及长，博极群书，于汉、唐先儒之学，无不洞悉底蕴。","book":"清·钱泳《履园丛话·耆旧·十兰判官》"},"similar":["洞见底蕴"],"usage":"作谓语、定语；用于观察事物"},{"id":28921,"word":"洞悉无遗","pinyin":"dòng xī wú yí","abbr":"dxwy","explanation":"洞：深入，透彻；洞悉：知道。对一切观察得很清楚。","source":{"text":"此人之果为谁，及其抵英国后之一举一动，本使馆洞悉无遗。","book":"孙中山《伦敦被难记》"},"similar":["洞察一切"],"usage":"作谓语、定语；指看得清"},{"id":28922,"word":"洞房花烛","pinyin":"dòng fáng huā zhú","abbr":"dfhz","explanation":"形容结婚的景象。","source":{"text":"洞房花烛明，燕余双舞轻。","book":"北周·庾信《和咏舞》诗"},"example":{"text":"～之夜，两新人原是旧相知，又多是吃惊吃吓，哭哭啼啼，死边过的，竟得团圆，其乐不可名状。","book":"《初刻拍案惊奇》卷二十九"},"similar":["燕尔新婚"],"usage":"作宾语、定语；指新婚"},{"id":28923,"word":"洞无城府","pinyin":"dòng wú chéng fǔ","abbr":"dwcf","explanation":"城府：城市和官署，比喻难于揣测的深远用心。形容待人接物坦率真诚，心口如一。","source":{"text":"君夷易疏畅，洞无城府，虽居官亦敝衣羸马，不改其度。","book":"宋·魏了翁《知灵泉县奉议郎致仕高君行状》"}},{"id":28924,"word":"洞洞属属","pinyin":"dòng dòng shǔ shǔ","abbr":"ddss","explanation":"洞洞：恭敬虔诚的样子。形容非常恭敬谨慎，小心翼翼的样子。","source":{"text":"孝子如执玉，如奉盈，洞洞属属然，如不胜，如将失之。","book":"《礼记·祭义》"},"example":{"text":"对门洒扫应对，可以精义入神，况～执玉奉盈者乎？（清·魏源《曾子章句序》）"}},{"id":28925,"word":"洞洞惺惺","pinyin":"dòng dòng xīng xīng","abbr":"ddxx","explanation":"洞洞：贯通的样子；惺惺：清醒。形容明彻清醒的样子。","source":{"text":"徒孤守洞洞惺惺、觉了能知之主，则亦灵岩三唤主人之旨而已。","book":"清·王夫之《读四书大全说·论语·子张篇二》"}},{"id":28926,"word":"洞烛其奸","pinyin":"dòng zhú qí jiān","abbr":"dzqj","explanation":"洞：透彻；烛：照见；奸：奸诈。对别人的阴谋诡计看得很清楚。","source":{"text":"（严）嵩稔恶误国，陛下岂不洞烛其奸！","book":"《明史·董传策传》"},"example":{"text":"他有一双～的眼睛。"},"similar":["洞察其奸","明察秋毫"],"opposite":["不明真相","制造冤案"],"usage":"作谓语、定语；指看问题敏锐","story":["明朝嘉靖时期，奸相严嵩专权，朝廷里尽是他的党羽，这些人上下勾结、狼狈为奸。松江府华亭县董传策上书弹劾严嵩，希望嘉靖皇帝洞烛其奸，消除朋党。昏庸的嘉靖听不进忠言，将董传策打入大牢，发配云南"]},{"id":28927,"word":"洞若观火","pinyin":"dòng ruò guān huǒ","abbr":"drgh","explanation":"洞：透彻。形容观察事物非常清楚，好象看火一样。","source":{"text":"予若观火。","book":"《尚书·盘庚上》"},"example":{"text":"否则怎样，他却没有说。但这是“～”的，否则，就不给。","book":"鲁迅《华盖集续编·记“发薪”》"},"similar":["洞察一切","明察秋毫","一目了然"],"opposite":["雾里看花","隐隐约约","大惑不解"],"usage":"作谓语、定语；指看得清楚"},{"id":28928,"word":"洞见其奸","pinyin":"dòng jiàn qí jiān","abbr":"djqj","explanation":"洞见：清楚地看到；奸：奸诈。看清楚对方的阴谋诡计。同“洞烛其奸”。","source":{"text":"李林甫妒贤嫉能，明皇洞见其奸而不能退。","book":"《元史·许衡传》"},"similar":["洞烛其奸","洞察其奸"],"usage":"作谓语、定语；指看问题敏锐"},{"id":28929,"word":"洞见古今","pinyin":"dòng jiàn gǔ jīn","abbr":"djgj","explanation":"洞鉴：明察。深入透彻地了解历史与现实世事。","source":{"text":"苟非洞鉴古今，深识王霸，何由立其高论哉。","book":"《旧唐书·王及善等传论》"},"example":{"text":"公高明远识，～，知国家之事，心至于斯乎。","book":"宋·钱世超《钱氏私志·蔡鲁公》"}},{"id":28930,"word":"洞见底蕴","pinyin":"dòng jiàn dǐ yùn","abbr":"djdy","explanation":"洞见：清楚地看到；底蕴：内情，事情的具体内容。透彻地观察到事物的详细内情。","source":{"text":"宰相遗公书曰：拘摧检核，洞见底蕴，不胜钦叹。","book":"宋·刘克庄《待制徐侍郎神道碑》"},"example":{"text":"其开陈治道，区别邪正，辨释事宜，平易明白，～。","book":"《宋史·范祖禹传论》"},"similar":["洞悉底蕴"],"usage":"作谓语、定语；用于观察事物"},{"id":28931,"word":"洞见症结","pinyin":"dòng jiàn zhèng jié","abbr":"djzj","explanation":"洞见：清楚地看到；症结：肚子里结块的病，比喻问题的关键。比喻事情的纠葛或问题的关键所在。形容观察锐利，看到了问题的关键。","source":{"text":"扁鹊以其言饮药三十日，视见垣一方人。以此视病，尽见五脏症结，特以诊脉为名耳。","book":"《史记·扁鹊仓公列传》"},"example":{"text":"香畹首肯曰：“斯言～矣。”","book":"清·纪昀《阅微草堂笔记》卷十"},"usage":"作谓语；形容观察锐利，看到了问题的关键","story":["战国时期，著名的医学家扁鹊跟随民间医生长桑君学医，学习了十多年，积累了一些秘方与偏方。长桑君在临终前把所藏的秘方和医书交给扁鹊，并送给他一副药。扁鹊连服了30天后，就能洞见症结，对症下药，从而成为一代名医"]},{"id":28932,"word":"洞见肺腑","pinyin":"dòng jiàn fèi fǔ","abbr":"djff","explanation":"很清楚地看见人的内心。形容襟怀坦白，待人诚恳。","source":{"text":"愬复能待以厚礼，示之赤诚，言笑无间，洞见肺腑。","book":"宋·陈亮《酌古论·李愬》"},"usage":"作谓语、定语；用于处世"},{"id":28933,"word":"洞达事理","pinyin":"dòng dá shì lǐ","abbr":"ddsl","explanation":"洞达：透彻，深远；理：道理，规律。深入透彻了解事物规律。"},{"id":28934,"word":"洞鉴古今","pinyin":"dòng jiàn gǔ jīn","abbr":"djgj","explanation":"洞鉴：明察。深入透彻地了解历史与现实世事。","source":{"text":"苟非洞鉴古今，深识王霸，何由立其高论哉。","book":"《旧唐书·王及善等传论》"},"example":{"text":"公高明远识，～，知国家之事，必至于斯乎。","book":"宋·钱世昭《钱氏私志·蔡鲁公》"},"usage":"作谓语、宾语；用于处事"},{"id":28935,"word":"洞鉴废兴","pinyin":"dòng jiàn fèi xīng","abbr":"djfx","explanation":"洞鉴：明察。深入透彻地了解历代兴盛衰败情况。","source":{"text":"卿往复积岁，洞鉴废兴。若朕此年行师，不克以不？","book":"《魏书·李顺传》"},"usage":"作谓语、定语；用于处事"},{"id":28936,"word":"洞隐烛微","pinyin":"dòng yǐn zhú wēi","abbr":"dyzw","explanation":"形容目光犀利，观察事物深刻透彻。","source":{"text":"[学师]谓[马建忠]能洞隐烛微，提纲挈领，非徒钻故纸者可比。","book":"清·马建忠《上李伯相言出洋工课书》"},"similar":["洞幽烛微"],"usage":"作谓语、定语；指人目光锐利"},{"id":28937,"word":"津关险塞","pinyin":"jīn guān xiǎn sài","abbr":"jgxs","explanation":"津：渡口；关：关口；险：险要之地；塞：要塞。指水陆山川关隘、险要之处。","source":{"text":"善哉乎贾生推言之也，曰：‘秦并诸侯山东三十余郡，缮津关，据险塞，修甲兵而守之。","book":"《史记·秦始皇本纪》"},"similar":["关津要隘"],"usage":"作主语、宾语；用于书面语"},{"id":28938,"word":"津津乐道","pinyin":"jīn jīn lè dào","abbr":"jjld","explanation":"津津：兴趣浓厚的样子；乐道：喜欢谈讲。很有兴趣地说个不停。","source":{"text":"这位莱恩女杰，他才学固然卓越，但他也只从口讲指画入手，每遇乡愚，津津乐道。","book":"清·颐琐《黄绣球》第七回"},"example":{"text":"十余年来，在不少出版物中我都看到这幅画，它为不少人所～。","book":"秦牧《一幅古画的风味》"},"similar":["津津有味","夸夸其谈","乐此不疲"],"opposite":["沉默寡言","兴味索然"],"usage":"作谓语、定语；形容对有兴趣的事说个没完"},{"id":28939,"word":"津津有味","pinyin":"jīn jīn yǒu wèi","abbr":"jjyw","explanation":"津津：兴趣浓厚的样子。指吃得很有味道或谈得很有兴趣。","source":{"text":"哀悁悁之可怀兮，良醰醰而有味。","book":"汉·王褒《洞箫赋》"},"example":{"text":"话是这样说，可是谈起理论，许宁还是一套套地向道静谈得～，头头是道。","book":"杨沫《青春之歌》第一部第十二章"},"similar":["兴致勃勃"],"opposite":["味同嚼蜡","索然无味","枯燥无味"],"usage":"作谓语、宾语；指兴味浓厚"},{"id":28940,"word":"洪乔捎书","pinyin":"hóng qiáo shāo shū","abbr":"hqss","explanation":"指言而无信的人。","example":{"text":"我已经很久没有收到家信了，不由得想起“洪乔捎书”的故事"},"similar":["言而无信"],"usage":"作宾语、定语；指言而无信的人","story":["晋朝豫章太守殷羡，字洪乔，在离任时，很多人委托他捎带书信回家乡，因那时还没有邮局，只有托人捎带。他很客气地接受了100多封信，可到了石头渚就将信全部扔进河水里。当人们收不到信总联想到信是托洪乔捎带的"]},{"id":28941,"word":"洪水横流","pinyin":"hóng shuǐ héng liú","abbr":"hshl","explanation":"横流：不循河道而流。洪水泛滥。比喻邪道横行。","source":{"text":"《孟子·滕文公上》：“当尧之时，天下犹未平，洪水横流，氾滥于天下。"},"example":{"text":"臣闻～，帝思俾乂；旁求四方，以招贤俊。","book":"明·罗贯中《三国演义》第二十三回"},"usage":"作宾语、定语；指水灾"},{"id":28942,"word":"洪水猛兽","pinyin":"hóng shuǐ měng shòu","abbr":"hsms","explanation":"猛兽：残食人畜的野兽。比喻极大的祸害。","source":{"text":"昔者禹抑洪水而天下平，周公兼夷狄、驱猛兽而百姓宁。","book":"《孟子·滕文公下》"},"example":{"text":"当初革命军来了，以为全是～一般的家伙，原来倒不少我辈中人。","book":"叶圣陶《丁祭》"},"similar":["后患无穷","祸不单行","天灾人祸"],"usage":"作主语、宾语；比喻为害极大的人或事物"},{"id":28943,"word":"洪炉点雪","pinyin":"hóng lú diǎn xuě","abbr":"hldx","explanation":"大火炉里放进一点雪，马上就会融化。比喻对问题领会极快。","source":{"text":"余夜宿金山之方丈，不得寤，信手而抽几案文书，得此阅之，至洪炉点雪，恍然非平时之境。","book":"宋·王质《雪山集·大慧禅师正法眼藏序》"},"example":{"text":"他原是明悟禅师转世，根气不同，所以出儒入墨，如～。","book":"明·冯梦龙《醒世恒言》卷十二"},"similar":["红炉点雪"],"usage":"作宾语；比喻对问题领会极快"},{"id":28944,"word":"洪炉燎发","pinyin":"hóng lú liáo fà","abbr":"hllf","explanation":"洪炉：大炉子。大火炉里烧毛发。比喻事情极易解决。","source":{"text":"夫以鸿毛燎于炉炭之上，必无事矣。","book":"《史记·刺客列传》"},"example":{"text":"今将军仗皇威，掌兵要，龙骧虎步，高下在心；若欲诛宦官，如鼓～耳。","book":"明·罗贯中《三国演义》第二回"},"usage":"作宾语；比喻事情极易解决"},{"id":28945,"word":"洪炉燎毛","pinyin":"hóng lú liáo máo","abbr":"hllm","explanation":"洪炉：大炉子；燎：烧。大火炉里烧毛发。比喻问题极易解决。","source":{"text":"夫以鸿毛燎于炉炭之上，必无事矣。","book":"《史记·刺客列传》"}},{"id":28946,"word":"洪福齐天","pinyin":"hóng fú qí tiān","abbr":"hfqt","explanation":"洪：大。旧时颂扬人福气极大。","source":{"text":"这南阳排叟村诸葛，辅佐着洪福齐天汉帝王。","book":"元·关汉卿《西蜀梦》"},"example":{"text":"我居然逃过了这一关，真是～，就是每年开一次庆祝会也不算过分。","book":"鲁迅《集外集拾遗·我的种痘》"},"similar":["福如东海"],"opposite":["灭顶之灾","祸不单行"],"usage":"作谓语、宾语；客套话"},{"id":28947,"word":"洪钟大吕","pinyin":"hóng zhōng dà lǜ","abbr":"hzdl","explanation":"大吕：阳律中排第四。形容音乐或文辞正大、庄严、高妙。","source":{"text":"至其真洪钟大吕，大扣大鸣，小扣小应，俱系精神骨髓所在。","book":"明·李贽《焚书·复焦弱侯》"},"similar":["黄钟大吕"],"usage":"作宾语；形容音乐或文辞庄严"},{"id":28948,"word":"活不活，死不死","pinyin":"huó bù huó，sǐ bù sǐ","abbr":"hbhsbs","explanation":"指陷于困境，不知怎么办。","source":{"text":"打的你活不活，死不死，则要你一则一，二则二。","book":"元·无名氏《抱妆盒》第三折"},"example":{"text":"他那～的状态让人担心。"},"similar":["半死不活"],"opposite":["生龙活虎"],"usage":"作谓语、定语、状语；指没有生机"},{"id":28949,"word":"活人手段","pinyin":"huó rén shǒu duàn","abbr":"hrsd","explanation":"使将要死亡的人能够生存下来的本领或方法。","source":{"text":"君不见温公年方髫龀时，奋然击瓮活小儿。至今遗事在图画，活人手段良可奇。","book":"宋·王十朋《左原记异》"},"example":{"text":"都未展，经邦志。医与卜，浑余事。把活人手段，此中聊试。","book":"金·段克己《满江红·寿陈丈良臣》"}},{"id":28950,"word":"活到老学到老","pinyin":"huó dào lǎo xué dào lǎo","abbr":"hdlxdl","explanation":"指老人坚持学习或知识不断更新，人们永远学不尽。","source":{"text":"活到老学到老嘛。","book":"王朔《橡皮人》"}},{"id":28951,"word":"活到老，学到老","pinyin":"huó dào lǎo，xué dào lǎo","abbr":"hdlxdl","explanation":"指人一生虚心好学。","source":{"text":"人是要活到老，学到老的，今天能看出昨天的缺欠或错误，正好鞭策自己努力学习，要求进步。","book":"老舍《老舍短篇小说选·后记》"},"example":{"text":"他～，是我们的榜样。"},"usage":"作宾语、定语、分句；指人爱学习"},{"id":28952,"word":"活剥生吞","pinyin":"huó bāo shēng tūn","abbr":"hbst","explanation":"比喻机械地搬用或生硬地模仿。","source":{"text":"有枣强尉张怀庆好偷名士文章，乃为诗曰：‘生情镂月成歌扇，出意裁云作舞衣。照镜自怜回雪影，时来好取洛川归’。人谓之谚曰：‘活剥王昌龄，生吞郭正一。’","book":"语出唐·刘肃《大唐新语·谐谑》"},"example":{"text":"‘竹影横斜水清浅，桂香浮动月黄昏’，非江为诗乎？林君复‘疏暗’二字，竟成千古名句，所云一字之师，与～者有别也。","book":"清·王士禛《五代诗话·江为》"},"similar":["生吞活剥"],"usage":"作谓语、状语、定语；指生拉硬扯","story":["唐高宗时，河北枣强官吏张怀庆不学无术，爱好舞文弄墨，他把李义府的五言诗各行加两字成为自己的七言诗，让人啼笑皆非，别人见他抄袭王昌龄及郭正一的诗，就送他顺口溜：“活剥王昌龄，生吞郭正一”来讥讽他的抄袭行为"]},{"id":28953,"word":"活天冤枉","pinyin":"huó tiān yuān wǎng","abbr":"htyw","explanation":"形容冤枉之极。","source":{"text":"你们都说三闾大夫发了疯，其实真是活天冤枉。","book":"郭沫若《屈原》第四幕"},"example":{"text":"我想从前那些有钱人家把阿炳叫做‘秃尾龙’、‘废料’、‘周游’，真是～！","book":"欧阳山《苦斗》五四"},"similar":["不白之冤"],"usage":"作主语、宾语、定语；指冤屈"},{"id":28954,"word":"活形活现","pinyin":"huó xíng huó xiàn","abbr":"hxhx","explanation":"形容神情逼真，使人感到好像亲眼看到一般。同“活龙活现”。"},{"id":28955,"word":"活捉生擒","pinyin":"huó zhuō shēng qín","abbr":"hzsq","explanation":"擒：捕捉。活着被抓住。","source":{"text":"明来暗去，活捉生擒。","book":"宋·释普济《五灯会元·温州护国钦禅师》"}},{"id":28956,"word":"活泼天机","pinyin":"huó pō tiān jī","abbr":"hptj","explanation":"活泼：使富有生机；天机：指人的灵性。使灵性生动活泼，自然舒展。","source":{"text":"否则闲中望望行云，听听流水，都可活泼天机。","book":"清·文康《儿女英雄传》第三十四回"},"usage":"作谓语、定语；用于为人"},{"id":28957,"word":"活灵活现","pinyin":"huó líng huó xiàn","abbr":"hlhx","explanation":"形容神情逼真，使人感到好像亲眼看到一般。","source":{"text":"再说王氏闻丈夫凶信，初时也疑惑。被吕宝说得活龙活现，也信了。","book":"明·冯梦龙《警世通言》卷五"},"example":{"text":"他忽然把个乐正子又请出来，说的～，倒也有个意思。","book":"清·李汝珍《镜花缘》第六十五回"},"similar":["栩栩如生","绘声绘色","有声有色"],"usage":"作定语、状语；指人说话等方面"},{"id":28958,"word":"活现眼","pinyin":"huó xiàn yǎn","abbr":"hxy","explanation":"真正出丑丢脸。","example":{"text":"请不要在此～了。"},"similar":["丢人现眼"],"usage":"作谓语、定语；用于口语骂人"},{"id":28959,"word":"活眼活报","pinyin":"huó yǎn huó bào","abbr":"hyhb","explanation":"指现世的报应。","source":{"text":"丁丁儿那张尖嘴平生带过太多了，所以死的时候连话都不能够说一句。这是活眼活报。","book":"郭沫若《我的童年》"}},{"id":28960,"word":"活眼活现","pinyin":"huó yǎn huó xiàn","abbr":"hyhx","explanation":"形容神情逼真，使人感到好像亲眼看到一般。同“活龙活现”。","source":{"text":"是说些事也不过是个纸上空谈哪，可不知怎么个原故儿，稀不要紧的平常事，到了你们文墨人儿嘴里一说，就活眼活现的，那么怪有个听头儿的。","book":"清·文康《儿女英雄传》第三十二回"},"similar":["活灵活现","活龙活现","活神活现"],"usage":"作定语、状语、补语；指人说话等方面"},{"id":28961,"word":"活眼现报","pinyin":"huó yǎn xiàn bào","abbr":"hyxb","explanation":"指现世的报应。","source":{"text":"丁丁儿那张尖嘴平生带过太带多了，所以死的时候连话都不能够说一句。这是活眼现报。","book":"郭沫若《我的童年》第三篇七"},"similar":["现世现报"],"usage":"作宾语；指现世的报应"},{"id":28962,"word":"活神活现","pinyin":"huó shén huó xiàn","abbr":"hshx","explanation":"形容生动逼真，像真的一样。","source":{"text":"他把衣袖一挽，活神活现地比划着说，好像他真的在破坏铁路一样。","book":"杜鹏程《年轻的朋友·第一天》"},"similar":["活龙活现","活眼活现","活灵活现"],"usage":"作状语；指生动逼真"},{"id":28963,"word":"活色生香","pinyin":"huó sè shēng xiāng","abbr":"hssx","explanation":"书面上呈现活生生的景象，而且散发出香味。形容诗画所描绘的景物生动逼真。","source":{"text":"尽堪活色生香里，拥顾双栖过一春。","book":"元·王恽《繁杏锦鸠图》"},"example":{"text":"其夫人静庄女史，名守箴，亦工写生，余尝见其扇头作穿花蛱蝶，～，栩栩然如欲飞去。","book":"清·盛大士《溪山卧游录·雷菱舟》"}},{"id":28964,"word":"活蹦乱跳","pinyin":"huó bèng luàn tiào","abbr":"hblt","explanation":"欢蹦乱跳，活泼、欢乐，生气勃勃的样子。","source":{"text":"我一定可以把小东西还是活蹦乱跳地找回来。","book":"曹禺《日出》第四幕"},"example":{"text":"大水看到～的艾和尚一眨眼的工夫，就死在敌人枪弹之下，心里一阵疼。","book":"孔厥、袁静《新儿女英雄传》第九回"},"similar":["欢蹦乱跳","活蹦活跳"],"opposite":["垂头丧气"],"usage":"作谓语、定语；指欢蹦乱跳"},{"id":28965,"word":"活蹦活跳","pinyin":"huó bèng huó tiào","abbr":"hbht","explanation":"活蹦乱跳。","source":{"text":"我的小孩子，一个能讲能说，活蹦活跳的娃娃，死啦！","book":"周而复《白求恩大夫》"},"example":{"text":"～的孩子人人都喜爱。"},"similar":["活蹦乱跳"],"usage":"作谓语、定语；指活跃"},{"id":28966,"word":"活龙活现","pinyin":"huó lóng huó xiàn","abbr":"hlhx","explanation":"形容神情逼真，使人感到好像亲眼看到一般。","source":{"text":"再说王氏闻丈夫凶信，初时也疑惑。被吕宝说得活龙活现，也信了。","book":"明·冯梦龙《警世通言》卷五"},"example":{"text":"他把那个的的模样说得～。"},"similar":["栩栩如生","绘声绘色","有声有色"],"usage":"作定语、状语、补语；指人说话等方面"},{"id":28967,"word":"活龙鲜健","pinyin":"huó lóng xiān jiàn","abbr":"hlxj","explanation":"形容健壮有活力。","source":{"text":"这是两服仙人弗识的丸散在内：一服用软口汤送下，明日再将乱话汤送下一服，包你活龙鲜健便了。","book":"清·张南庄《何典》第三回"},"usage":"作谓语、定语、状语；用于生命力"},{"id":28968,"word":"洽博多闻","pinyin":"qià bó duō wén","abbr":"qbdw","explanation":"指知识和见闻广博。","source":{"text":"玄敬当时最以洽博多闻称，不知何所据而云然。","book":"明·俞弁《逸老堂诗话》"},"example":{"text":"明俞弁《逸老堂诗话》卷下：“玄敬当时最以洽博多闻称，不知何所据而云然。”"},"similar":["洽闻博见"],"usage":"作谓语、宾语、定语；指人的学识"},{"id":28969,"word":"洽闻博见","pinyin":"qià wén bó jiàn","abbr":"qwbj","explanation":"见闻广博，知识丰富。","source":{"text":"子才洽闻博见，无所不通，军国制度，罔不访及。","book":"北魏·杨衒之《洛阳伽兰记·景明寺》"},"similar":["博见洽闻"],"usage":"作谓语、宾语、定语；指人的学识"},{"id":28970,"word":"洽闻强记","pinyin":"qià wén qiáng jì","abbr":"qwqj","explanation":"见闻广博，记忆力强。","source":{"text":"[孔仲尼]躬履谦让，洽闻强记。","book":"《孔丛子·嘉言》"},"example":{"text":"仕优而学，退食自公，～，贵异贱同。","book":"明杨慎《祭用贞弟文》"},"similar":["博闻强记"],"usage":"作谓语、定语；用于书面语"},{"id":28971,"word":"流光如箭","pinyin":"liú guāng rú jiàn","abbr":"lgrj","explanation":"形容时间过得极快。","source":{"text":"少年不管，流光如箭，因循不觉韶光换。","book":"宋·宋祁《浪淘沙近》"}},{"id":28972,"word":"流光易逝","pinyin":"liú guāng yì shì","abbr":"lgys","explanation":"形容时间过得极快。","source":{"text":"少年不管，流光如箭，因循不觉韶光换。","book":"宋·宋祁《浪淘沙近》"},"example":{"text":"胜会难逢，～。","book":"蔡东藩、许廑父《民国通俗演义》第四十六回"},"similar":["流光瞬息"],"usage":"作宾语、定语；用于时间等"},{"id":28973,"word":"流光溢彩","pinyin":"liú guāng yì cǎi","abbr":"lgyc","explanation":"光像在流动，色彩像要溢出来。形容珠宝、灯光等的绚丽。","similar":["绚丽夺目"],"usage":"有时也可指服装表演。"},{"id":28974,"word":"流光瞬息","pinyin":"liú guāng shùn xī","abbr":"lgsx","explanation":"形容时间极短。","source":{"text":"流光瞬息驹过隙，莫把青春枉抛掷。","book":"明·徐霖《绣襦记·鸣珂嘲客》"},"example":{"text":"我们不能放过这～。"},"similar":["转瞬之间"],"usage":"作谓语、宾语；形容时间极短"},{"id":28975,"word":"流口常谈","pinyin":"liú kǒu cháng tán","abbr":"lkct","explanation":"人人挂在嘴上的老话。","source":{"text":"人人挂在嘴上的老话。"},"similar":["老生常谈"],"usage":"作宾语、定语；用于套话等"},{"id":28976,"word":"流天澈地","pinyin":"liú tiān chè dì","abbr":"ltcd","explanation":"形容液体漫溢。"},{"id":28977,"word":"流宕忘反","pinyin":"liú dàng wàng fǎn","abbr":"ldwf","explanation":"流宕：流浪，飘泊；反：同“返”，回家。指长期在外面飘泊而不知返回。","source":{"text":"雷同影附，流宕忘反，非一时也。","book":"晋·杜预《春秋左氏传序》"},"example":{"text":"狂简斐然成俗，～，无所取裁。","book":"《隋书·文学传序》"},"similar":["流荡忘反"],"usage":"作谓语；指长期在外面飘泊"},{"id":28978,"word":"流年不利","pinyin":"liú nián bù lì","abbr":"lnbl","explanation":"流年：旧时算命看相的人称一年中所行之“运”；利：吉利。指人长年里处于不吉利的状态。谓时运不佳。","source":{"text":"想是我流年不利，故此没福消受，以致如此。","book":"明·冯梦龙《醒世恒言》"},"example":{"text":"而自己呢，虽然前一段身处逆境，～，但倚恃个人的顽强奋斗，终究否极泰来，转败为胜。","book":"康式昭、奎曾《大学春秋》"},"similar":["命运多舛","时运不济","运交华盖"],"opposite":["飞黄腾达","春风得意","青云直上"],"usage":"作谓语、宾语；指时运不好"},{"id":28979,"word":"流年似水","pinyin":"liú nián sì shuǐ","abbr":"lnss","explanation":"流年：光阴。形容时间一去不复返。","source":{"text":"则为你如花美眷，似水流年。","book":"明·汤显祖《牡丹亭》第十出"},"example":{"text":"虽然～，风狂雨虐，然而当年梅雨的风姿，仍旧镌刻和保存在他的心上，没有褪色，没有残缺。","book":"刘绍棠《二度梅》六"},"similar":["似水流年"],"usage":"作主语、宾语；形容时间流逝之快"},{"id":28980,"word":"流星掣电","pinyin":"liú xīng chè diàn","abbr":"lxcd","explanation":"比喻迅疾。同“流星飞电”。","source":{"text":"手起处真似流星掣电，石子来吓得鬼哭神惊。","book":"明·施耐庵《水浒传》第九十八回"},"example":{"text":"清·李百川《绿野仙踪》第31回：“一个个如～，飞奔贼营。”"},"similar":["流星飞电"],"usage":"作宾语、定语；用于比喻句"},{"id":28981,"word":"流星赶月","pinyin":"liú xīng gǎn yuè","abbr":"lxgy","explanation":"象流星追赶月亮一样。形容行动迅速。","source":{"text":"那一顿如流星赶月，风卷残云，吃得罄尽。","book":"明·吴承恩《西游记》第四十四回"},"example":{"text":"放开马蹄，如～一般，一口气就跑有三十余里。","book":"清·夏敬渠《野叟曝言》第四十四回"},"usage":"作宾语；形容行动迅速"},{"id":28982,"word":"流星飞电","pinyin":"liú xīng fēi diàn","abbr":"lxfd","explanation":"比喻迅疾。","source":{"text":"人世是流星飞电，荣华才转眼，似车轮下坂，弩箭离弦。","book":"明·屠隆《彩毫记·湘娥访道》"},"similar":["流星掣电"],"usage":"作宾语、定语；用于比喻句"},{"id":28983,"word":"流景扬辉","pinyin":"liú jǐng yáng huī","abbr":"ljyh","explanation":"形容太阳西沉时发出的光芒。","source":{"text":"佩则结绿悬黎，宝之妙微。符彩照烂，流景扬辉。","book":"三国·魏·曹植《七启》"}},{"id":28984,"word":"流杯曲水","pinyin":"liú bēi qū shuǐ","abbr":"lbqs","explanation":"觞：古代酒器；曲水：弯曲的水道。原是古风俗。后泛指在水边宴集，把酒杯放在水中，杯流行时停在谁的前面，谁就取杯喝酒。","source":{"text":"三月三日，士民并出水渚，为流杯曲水之饮。","book":"南朝·梁·宗懔《荆楚岁时记》"},"example":{"text":"晋海西钟山后流杯曲水，延百僚，皆其事也。","book":"《宋书·礼乐志二》"}},{"id":28985,"word":"流水不腐","pinyin":"liú shuǐ bù fǔ","abbr":"lsbf","explanation":"腐：臭。流动的水不会发臭。比喻经常运动的东西不易受侵蚀。","source":{"text":"流水不腐，户枢不蝼，动也。","book":"《吕氏春秋·尽数》"},"example":{"text":"他一时想不清楚，怔了怔才道：“～，户枢不蠢。”","book":"二月河《乾隆皇帝》二十六"}},{"id":28986,"word":"流水不腐，户枢不蝼","pinyin":"liú shuǐ bù fǔ，hù shū bù lóu","abbr":"lsbfhsbl","explanation":"比喻经常运动的东西不易受侵蚀。同“流水不腐，户枢不蠹”。","source":{"text":"流水不腐，户枢不蝼，动也。","book":"《吕氏春秋·尽数》"},"similar":["流水不腐，户枢不蠹"],"usage":"作宾语、定语、分句；用于书面语"},{"id":28987,"word":"流水不腐，户枢不蠹","pinyin":"liú shuǐ bù fǔ，hù shū bù dù","abbr":"lsbfhsbd","explanation":"腐：臭；枢：门轴；蠹：蛀。流动的水不会发臭，经常转动的门轴不会腐烂。比喻经常运动的东西不易受侵蚀。","source":{"text":"流水不腐，户枢不蝼，动也。","book":"《吕氏春秋·尽数》"},"example":{"text":"“～”，是说它们在不停的运动中抵抗了微生物或其他生物的侵蚀。","book":"毛泽东《论联合政府》"},"similar":["流水不腐，户枢不蝼"],"usage":"作主语、宾语；比喻经常运动的东西不易受侵"},{"id":28988,"word":"流水无情","pinyin":"liú shuǐ wú qíng","abbr":"lswq","explanation":"流水一去不复返，毫无情意。比喻时光消逝，无意停留。","source":{"text":"落花不语空辞树，流水无情自入地。","book":"唐·白居易《过元家履信宅》"},"example":{"text":"落花有意，翻成就无意姻缘；流水无情，倒做了有情夫妇。","book":"清·钱彩《说岳全传》第七十八回"},"opposite":["落花有意"],"usage":"作宾语、定语；指毫无情意"},{"id":28989,"word":"流水朝宗","pinyin":"liú shuǐ cháo zōng","abbr":"lscz","explanation":"朝宗：原指古代诸侯天子，借指百川入海。比喻人心所向。","source":{"text":"沔彼流水，朝宗于海。","book":"《诗经·小雅·沔水》"},"example":{"text":"天子当阳，臣工率职。～，众星拱极。","book":"《宋史·乐志十三》"},"usage":"作宾语、定语；多用于比喻句"},{"id":28990,"word":"流水桃花","pinyin":"liú shuǐ táo huā","abbr":"lsth","explanation":"形容春日美景。也比喻男女爱情。","source":{"text":"桃花流水窅然去，别有天地非人间。","book":"唐·李白《山中问答》诗"},"example":{"text":"～情不已，待刘郎。","book":"五代·后蜀·欧阳炯《春光好》词六"},"similar":["桃花流水"],"usage":"作宾语、定语；用于书面语"},{"id":28991,"word":"流水游龙","pinyin":"liú shuǐ yóu lóng","abbr":"lsyl","explanation":"比喻川流不息的车马。","source":{"text":"前过濯龙门上，见外家问起居者，车如流水，马如游龙，仓头衣绿褠，领袖正白，顾视御者，不及远矣。","book":"语出《后汉书·皇后纪上·明德马皇后》"},"example":{"text":"～日夜弛，品题素竹与哀丝。","book":"清·李慈铭《大风有感》诗"},"similar":["车水马龙"],"usage":"作主语、宾语、定语；形容繁华热闹的景象","story":["东汉章帝刘炟即位后，封其父王明帝刘庄的皇后马氏为太后。马太后亲自撰写《显宗起居注》，丝毫不提及父亲马援及兄长马防的功劳，还要章帝不要听信大臣的给马家封侯的建议，说：“我回家看他们门前车水马龙的，不能再封了。”"]},{"id":28992,"word":"流水落花","pinyin":"liú shuǐ luò huā","abbr":"lslh","explanation":"形容春残的景象。也比喻好时光的消逝。","source":{"text":"流水落花春去也，天上人间。","book":"南唐·李煜《浪淘沙》词"},"example":{"text":"弹得一时金戈铁马破空而来，一时～悠然而去。","book":"清·文康《儿女英雄传》第18回"},"similar":["落花流水"],"usage":"作主语、宾语；形容春残的景象"},{"id":28993,"word":"流水行云","pinyin":"liú shuǐ xíng yún","abbr":"lsxy","explanation":"形容文章自然不受约束，就象漂浮着的云和流动着的水一样。","source":{"text":"流水行云才思，光风霁月精神。","book":"宋·洪咨夔《朝中措·寿章君举》"},"example":{"text":"容止则光风霁月，应对则～。","book":"明·汤显祖《邯郸记·极欲》"},"similar":["行云流水"],"usage":"作宾语、定语；指文章等"},{"id":28994,"word":"流水高山","pinyin":"liú shuǐ gāo shān","abbr":"lsgs","explanation":"比喻知己或知音。也比喻乐曲高妙。","source":{"text":"伯牙鼓琴，志在登高山，钟子期曰：‘善哉，峨峨兮若泰山。’志在流水，曰：‘善哉，洋洋兮若江河。’","book":"《列子·汤问》"},"example":{"text":"金垆焚宝烟，瑶琴鸣素弦，无非是～调，和那堆风积雪篇。","book":"元·石子章《竹坞听琴》第一折"},"similar":["高山流水"],"usage":"作宾语、定语；指知音","story":["春秋时期，晋国大夫俞伯牙很擅长弹琴，他到楚国马鞍山遇到钟子期，两人谈论琴律很投机。伯牙看到高山流水就弹奏一曲，钟子期高兴地说泰山江河。两人结为知己。第二年伯牙去拜会钟子期，得知钟子期病故，就在坟前伤心地毁琴"]},{"id":28995,"word":"流汗浃背","pinyin":"liú hàn jiā bèi","abbr":"lhjb","explanation":"①形容出汗多，湿透了背上的衣服。②形容惭愧不安之极。","source":{"text":"［桂员外］猛然惊醒，流汗浃背，乃是一梦，身子却在寓所，天已大明了。","book":"宋·无名氏《青琐后集》：“每延英奏对，虽严冬盛寒亦流汗浃背。”明·冯梦龙《警世通言》第二十五卷"},"example":{"text":"圣公藉新市之兵，盆子凭赤眉之众，其乌合同也。圣公称尊，～；盆子建号，宛缩欲啼，其负乘同也。","book":"明·胡应麟《少室山房笔丛·史书佔毕一》"},"similar":["汗流浃背"],"usage":"作谓语、定语、状语；指满身大汗"},{"id":28996,"word":"流汤滴水","pinyin":"liú tāng dī shuǐ","abbr":"ltds","explanation":"比喻罗罗嗦嗦，不干脆，不痛快。","example":{"text":"古今中外的大人物没有一个是～的。"},"usage":"作宾语、定语；方言"},{"id":28997,"word":"流涕痛哭","pinyin":"liú tì tòng kū","abbr":"lttk","explanation":"涕：眼泪。形容伤心到极点。","source":{"text":"臣窃惟事势，可为痛哭者一，可为流涕者二，可为长太息者六。","book":"《汉书·贾谊传》"},"example":{"text":"绍兴初，某甫成童，亲见当时士大夫相与言及国事，或裂眦嚼齿，或～。","book":"宋·陆游《跋傅给事帖》"}},{"id":28998,"word":"流溺忘反","pinyin":"liú nì wàng fǎn","abbr":"lnwf","explanation":"犹言流连忘反。留恋不舍，忘记返回。","source":{"text":"犹言流连忘反。留恋不舍，忘记返回。"},"similar":["流连忘反"],"usage":"作谓语；用于吸引人的事物"},{"id":28999,"word":"流离失所","pinyin":"liú lí shī suǒ","abbr":"llss","explanation":"流离：转徒离散。无处安身，到处流浪。","source":{"text":"窃见关东困极，人民流离。","book":"《汉书·薛广德传》"},"example":{"text":"年荒劫大，百姓们不是离家逃荒，～，便是等待饿死。","book":"姚雪垠《李自成》第二卷第二十八章"},"similar":["无家可归","流离颠沛"],"opposite":["安家立业","安居乐业"],"usage":"作谓语、定语；指无处安身，到处流浪","story":["汉元帝时期，御史大夫薛广德陪同汉元帝外出打猎。元帝忘乎所以，不想停止，严重影响当地百姓的生活。薛广德就上书说当地百姓因为皇帝狩猎而流离失所，希望皇帝体恤百姓的疾苦。元帝认为言之有理，就与光禄大夫张猛等立即回宫"]},{"id":29000,"word":"流离播越","pinyin":"liú lí bō yuè","abbr":"llby","explanation":"指流转迁徙。","source":{"text":"乃草创子书，会遇兵乱，流离播越，有所亡失。","book":"晋·葛洪《抱朴子·自叙》"},"example":{"text":"[蔡润石]～，不脱衰绖。","book":"叶名沣《桥西杂记·蔡夫人书孝经卷》"},"similar":["流离播迁"],"usage":"作谓语、定语；用于生活"},{"id":29001,"word":"流离播迁","pinyin":"liú lí bō qiān","abbr":"llbq","explanation":"指流转迁徙。同“流离播越”。","source":{"text":"一旦变起仓卒，遂至流离播迁，犹幸天命未改，人心未去，天子虽不免蒙尘，储君却已得践柞；然而事势已成，仓皇内禅，毕竟授者不能正其终，受者不能正其始。","book":"清·褚人获《隋唐演义》第九十二回"},"example":{"text":"清·褚人获《隋唐演义》第九十二回：“一旦变起仓卒，遂至流离播迁，犹幸天命未改，人心未去，天子虽不免蒙尘，储君却已得践柞；然而事势已成，仓皇内禅，毕竟授者不能正其终，受者不能正其始。”"},"similar":["流离播越"],"usage":"作谓语、定语；用于生活"},{"id":29002,"word":"流离琐尾","pinyin":"liú lí suǒ wěi","abbr":"llsw","explanation":"流离：枭的别名；琐尾：细小时美好。枭细小时怪可爱，长大后却非常丑恶。比喻处境由顺利转为艰难。","source":{"text":"《诗经·邶风·旌丘》：“琐兮尾兮，流离之子”。"},"example":{"text":"哀我父老，嗟我子弟，奔走呼号，～，泣血椎心，无以自赎。","book":"蔡东藩、许厪父《民国通俗演义》第十二九回"},"usage":"作谓语、定语；比喻处境由顺利转为艰难"},{"id":29003,"word":"流离转徙","pinyin":"liú lí zhuǎn xǐ","abbr":"llzx","explanation":"流离：流转离散；徙：迁移。辗转迁移，无处安身。","source":{"text":"间有上陈者，部司又以国用不敷，不为停免粮税，以致冻馁，贫困流离转徙。","book":"明·余继登《典故纪闻》卷十一"},"example":{"text":"我～，脚尖儿踏呀，却踏不上自己的国土！","book":"朱自清《毁灭》"},"similar":["颠沛流离"],"opposite":["安居乐业"],"usage":"作谓语；指辗转迁移，无处安身"},{"id":29004,"word":"流离遇合","pinyin":"liú lí yù hé","abbr":"llyh","explanation":"流离：流转，离散；遇合：指遇到赏识自己的人。流离失所又再团聚。","source":{"text":"流离遇合，破家失国。","book":"清·黄宗羲《柳敬亭传》"},"example":{"text":"人生少不了～的。"},"usage":"作谓语、宾语；指流离失所又再团聚"},{"id":29005,"word":"流离颠沛","pinyin":"liú lí diān pèi","abbr":"lldp","explanation":"由于灾荒或战乱而流转离散。形容生活艰难，四处流浪。","source":{"text":"窃见关东困极，人民流离。","book":"《诗经·大雅·荡》：“人亦有言，颠沛之揭。”《汉书·薛广德传》"},"example":{"text":"虽在～之中，他的高华的气度，渊雅的局量，还不曾改变。","book":"郑振铎《桂公堂》"},"similar":["流离失所","流离颠顿"],"opposite":["安家立业","安居乐业"],"usage":"作谓语、定语；形容生活困苦，四处流浪"},{"id":29006,"word":"流离颠疐","pinyin":"liú lí diān zhì","abbr":"lldz","explanation":"形容生活艰难，四处流浪。同“流离颠沛”。","source":{"text":"形容生活艰难，四处流浪。同“流离颠沛”。"},"similar":["流离颠顿","流离颠沛"],"opposite":["安居乐业"],"usage":"作谓语、定语；用于生活"},{"id":29007,"word":"流离颠痜","pinyin":"liú lí diān shǔ","abbr":"llds","explanation":"形容生活艰难，四处流浪。同流离颠沛”。"},{"id":29008,"word":"流离颠顿","pinyin":"liú lí diān dùn","abbr":"lldd","explanation":"形容生活艰难，四处流浪。同“流离颠沛”。","source":{"text":"［夫人］维能顺其性，所以居流离颠顿之间，而不为悲哀愁忧乱其志也。","book":"宋·曾巩《永兴尉章佑妻夫人张氏墓志铭》"},"similar":["流离颠沛","流离颠疐"],"opposite":["安居乐业"],"usage":"作谓语、定语、宾语；用于生活"},{"id":29009,"word":"流移失所","pinyin":"liú yí shī suǒ","abbr":"lyss","explanation":"犹言流离失所。指无处安身，到处流浪。","source":{"text":"自后有流移失所甘心投诚者，有司礼送京师，加恩畜养。","book":"《清史稿·世祖纪二》"},"similar":["流离失所"],"usage":"作谓语、定语；指无处安身，到处流浪"},{"id":29010,"word":"流脍人口","pinyin":"liú kuài rén kǒu","abbr":"lkrk","explanation":"指（诗文等）被人广为传颂称美。","source":{"text":"杨状元慎才情盖世，所著有《洞天玄记》、《陶情乐府》、《续陶情乐府》，流脍人口，而颇不为当家所许。","book":"明·王世贞《曲藻》"},"similar":["脍炙人口"],"usage":"作谓语、定语；指作品等"},{"id":29011,"word":"流芳万古","pinyin":"liú fāng wàn gǔ","abbr":"lfwg","explanation":"流：流传；芳：花草的香味，比喻好的名声。指美名永远流传下去。","source":{"text":"流芳万古，迹绝当今。","book":"《大齐乡老举李义隽侪罗之碑》"},"similar":["流芳千古","流芳后世","万古流芳"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指美名"},{"id":29012,"word":"流芳千古","pinyin":"liú fāng qiān gǔ","abbr":"lfqg","explanation":"美名永传于后世。","source":{"text":"楼船笳吹晓霞横，旌节新移宠若惊。运道风柔思报国，沙场尘敛喜消兵。恩纶加惠全忠孝，呼氏流芳千古闻。宋主听奸生祸乱，征辽平寇旧功臣。","book":"清·佚名《说呼全传》"},"example":{"text":"争回疆土功劳大，～永无涯。","book":"《天地会诗歌选·金台开山歌》"},"similar":["流芳百世","流芳后世","万古流芳"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指美名"},{"id":29013,"word":"流芳后世","pinyin":"liú fāng hòu shì","abbr":"lfhs","explanation":"指美名留传于后代。同“流芳百世”。","source":{"text":"既不能流芳后世，亦不足复遗臭万载耶？","book":"南朝·宋·刘义庆《世说新语·尤悔》"},"example":{"text":"我们要干些～的事情。"},"similar":["流芳百世"],"opposite":["遗臭万年"],"usage":"作谓语、定语；指好名声","story":["东晋时期，大司马桓温专揽朝政，他南征北战，立下不少战功。他位高权重，野心萌发，一次躺在床上说：“人生在世不能默默无闻。”亲信们不敢吭声，他从床上坐起接着说：“一个人即使不能流芳百世，那么就该遗臭万年。”"]},{"id":29014,"word":"流芳百世","pinyin":"liú fāng bǎi shì","abbr":"lfbs","explanation":"美好形象永不磨灭，不会被忘却。","source":{"text":"桓公卧语曰：‘作此寂寞，将为文景所笑。’既而屈起坐曰：‘既不能流芳后世，亦不足复遗臭万载耶？’","book":"南朝·宋·刘义庆《世说新语·尤悔》"},"example":{"text":"要做到～也不是很难。"},"similar":["永垂不朽","名垂青史"],"opposite":["臭名远扬","遗臭万年"],"usage":"作谓语；指好名声","story":["东晋时期，大司马桓温专揽朝政，他南征北战，立下不少战功。他位高权重，野心萌发，一次躺在床上说：“人生在世不能默默无闻。”亲信们不敢吭声，他从床上坐起接着说：“一个人即使不能流芳百世，那么就该遗臭万年。”"]},{"id":29015,"word":"流芳遗臭","pinyin":"liú fāng yí chòu","abbr":"lfyc","explanation":"“流芳百世”和“遗臭万年”的简称。","source":{"text":"既不能流芳百世，亦不足复遗臭万载耶！","book":"《晋书·桓温传》"},"example":{"text":"叹息知人真未易，～尽书生。","book":"宋·陆游《过广安吊张才叔谏议》"},"usage":"作宾语、定语；用于人或事等"},{"id":29016,"word":"流荡忘反","pinyin":"liú dàng wàng fǎn","abbr":"ldwf","explanation":"流荡：流浪；反：同“返”，回家。指长期在外面飘泊而不知返回。","source":{"text":"雷同影附，流宕忘反，非一时也。","book":"晋·杜预《春秋左氏传序》"},"example":{"text":"反人～，盖其得也，荐宗庙，揪管弦。其失也，语淫奔，事诡怪而已。","book":"宋·王禹偁《答张知白书》"},"similar":["流宕忘反"],"usage":"作谓语；指长期在外面飘泊"},{"id":29017,"word":"流落不偶","pinyin":"liú luò bù ǒu","abbr":"llbo","explanation":"偶：遇。飘泊穷困而无人相知。形容潦倒失意。","source":{"text":"诸宿将常留落不耦，由此去病日以亲贵，比大将军。","book":"《汉书·霍去病传》"},"example":{"text":"得志者司诏令，垂金石；～者，娱忧纾愤，发为诗骚。","book":"宋·陆游《陈长翁文集序》"},"usage":"作谓语、定语；用于生活"},{"id":29018,"word":"流落他乡","pinyin":"liú luò tā xiāng","abbr":"lltx","explanation":"被迫离开家乡，漂泊外地。","source":{"text":"舍父逃走，流落他乡，撞东磕西，苦哉，阿弥陀佛。","book":"宋·释普济《五灯会元》"},"example":{"text":"这种～的酸甜苦辣，又有谁能理解，谁能同情？","book":"魏孝淳《杨柳怨》"},"similar":["流离失所","流离颠沛"],"opposite":["安居乐业","安家立业","安家落户"],"usage":"作谓语、定语；指飘泊在外"},{"id":29019,"word":"流落天涯","pinyin":"liú luò tiān yá","abbr":"llty","explanation":"天涯：天边，指极远的地方。穷困潦倒，到处漂泊。形容生活不安定，极为困苦。","source":{"text":"叹离阻！有恨流落天涯，谁念泣孤旅？","book":"宋·德祐太学生《祝英台近（德祐乙亥）》"},"example":{"text":"他变卖了家产，背起药囊，～，寻师认能，当起游方郎中来。","book":"李栋、周毅如《碧落黄泉》"},"similar":["流落他乡","流离失所","流离颠沛"],"opposite":["安家落户","安家立业","安身立命"],"usage":"作谓语、定语；指到外地飘泊"},{"id":29020,"word":"流落失所","pinyin":"liú luò shī suǒ","abbr":"llss","explanation":"流转沦落，没有安身的地方。","source":{"text":"吾至亲骨肉流落失所，理当收拾，此乃万不得已之事。","book":"明·冯梦龙《古今小说·单符郎全州佳偶》"},"similar":["流离失所"],"opposite":["安居乐业"],"usage":"作谓语、定语；指没有安身的地方"},{"id":29021,"word":"流落异乡","pinyin":"liú luò yì xiāng","abbr":"llyx","explanation":"被迫离开家乡，漂泊外地。","source":{"text":"今委顿兮，流落异乡。","book":"宋·无名氏《新刊大宋宣和遗事》"},"example":{"text":"吴之荣又碰了一鼻子灰，眼见回家已无盘缠，势将～。","book":"金庸《鹿鼎记》第一回"}},{"id":29022,"word":"流落江湖","pinyin":"liú luò jiāng hú","abbr":"lljh","explanation":"形容穷困潦倒，漂泊异乡。","source":{"text":"庶曰：‘某幼逃难，流落江湖，偶至新野，遂与玄德交厚，老母在此，幸蒙慈念，不胜愧感。’","book":"宋·李清照《瑞鹧鸪·双银杏》词：“谁怜流落江湖上，玉骨冰肌未肯枯。”明·罗贯中《三国演义》第三十七回"},"example":{"text":"［郑恩］年长一十八岁，生得形容丑陋，力大无穷。最异的那双尊目，生来左小右大，善识妖邪。自幼父母双亡，～，挑卖香油度日。","book":"清·吴璿《飞龙全传》第七回"},"similar":["沦落江湖","流落风尘"],"usage":"作谓语、定语、宾语；用于生活"},{"id":29023,"word":"流落风尘","pinyin":"liú luò fēng chén","abbr":"llfc","explanation":"流落：因生活所迫而留居他乡；风尘：指纷扰的生活。穷困潦倒，漂泊江湖。","source":{"text":"我则为十载萤窗苦学文，惭愧杀万里鹏程未致身，因此上甘流落在风尘。","book":"元·范子安《竹叶舟》楔子"},"example":{"text":"想着～，将来终究没有好好的结局。","book":"清·张春帆《九尾龟》第一百七十六回"},"similar":["沦落风尘","流落江湖"],"usage":"作谓语、定语；用于生活"},{"id":29024,"word":"流血千里","pinyin":"liú xuè qiān ǐ","abbr":"lxql","explanation":"形容战乱中死伤极多的景象。","source":{"text":"天子之怒，伏尸百万，流血千里。","book":"西汉·刘向《战国策·魏策》"},"example":{"text":"故镆铘之藏于中者，今而～矣。","book":"清·黄宗羲《诸敬槐先生八十寿序》"},"usage":"作谓语、定语；用于战争灾难等"},{"id":29025,"word":"流血成河","pinyin":"liú xuè chéng hé","abbr":"lxch","explanation":"鲜血流成了河。形容被杀的人极多。","source":{"text":"尸骸蔽野，血流成河，积怨满于山川，号哭动于天地。","book":"隋·祖君彦《檄洛州文》：“尸骸蔽野，血流成河，积怨满于山川，号哭动于天地。”《旧唐书·李密传》"},"example":{"text":"清·夏敬渠《野叟曝言》第21回：“纷纷撞击，杀人如麻，～。”"},"similar":["血流成河","流血成渠"],"usage":"作谓语、定语；指战争残酷"},{"id":29026,"word":"流血成渠","pinyin":"liú xuè chéng qú","abbr":"lxcq","explanation":"渠：水渠。形容被杀的人极多。","source":{"text":"尸骸蔽野，血流成河，积怨满于山川，号哭动于天地。","book":"隋·祖君彦《檄洛州文》"},"example":{"text":"乐毅身先士卒，四国兵将无不贾勇争奋，杀得齐兵尸横原野，～。","book":"明·冯梦龙《东周列国志》第九十五回"},"similar":["流血成河"],"usage":"作谓语、定语、状语；指战争残酷"},{"id":29027,"word":"流血浮丘","pinyin":"liú xuè fú qiū","abbr":"lxfq","explanation":"流的备可以把山丘漂起来。比喻战争中死伤的人极多。","source":{"text":"国有彗星，必有流血浮丘之战。","book":"《管子·轻重丁》"}},{"id":29028,"word":"流血浮尸","pinyin":"liú xuè fú shī","abbr":"lxfs","explanation":"形容作废极大。","source":{"text":"晋知其兵革之罢倦，粮食尽索，兴师击之，大败。吴师涉江，流血浮尸者不可胜数。","book":"汉·袁康《越绝书·外传记吴王占梦》"},"similar":["血流成河","流血漂橹","流血漂卤"],"usage":"作谓语、定语；指战争残酷"},{"id":29029,"word":"流血漂卤","pinyin":"liú xuè piāo lǔ","abbr":"lxpl","explanation":"卤：通“橹”，大盾牌。血流得能将橹浮起来。形容死伤极多。亦作“流血漂忤”。","source":{"text":"此战之于伊阙，大破二国之军，流血漂卤，斩首二十四万。","book":"《史记·秦始皇本纪》：“秦有余力而制其敌，追亡逐北，伏尸百万，流血漂卤。”《战国策·中山策》"},"example":{"text":"西汉·司马迁《史记·秦始皇本纪》：“秦有余力而制其敌，追亡逐北，伏尸百万，～。”"},"similar":["流血漂杵","流血漂橹"],"usage":"作宾语、定语；指血流成河"},{"id":29030,"word":"流血漂杵","pinyin":"liú xuè piāo chǔ","abbr":"lxpc","explanation":"杵：捣物的棒槌。血流成河，舂米的木棰都漂了起来。形容战死的人很多。也泛指流血很多。","source":{"text":"炎帝无道，黄帝伐之，涿鹿之野，血流漂杵。","book":"《尚书·武成》：“会于牧野，罔有敌于我师，前徒倒戈，攻于后以北，血流漂杵。”汉·贾谊《益攘》"},"example":{"text":"～，方自此始。","book":"宋·陆游《禹庙赋》"},"similar":["流血漂卤","流血漂橹"],"usage":"作宾语、定语；指血流成河"},{"id":29031,"word":"流血漂橹","pinyin":"liú xuè piāo lǔ","abbr":"lxpl","explanation":"橹：盾牌。血流成河，可以漂浮盾牌。","source":{"text":"伏尸百万，流血漂橹。","book":"汉·贾谊《过秦论》"},"similar":["流血漂杵","血流成河"],"usage":"作宾语、定语；指血流成河"},{"id":29032,"word":"流血飘丘","pinyin":"liú xuè piāo qiū","abbr":"lxpq","explanation":"形容战死的人很多。也泛指流血很多。","source":{"text":"必有流血飘丘之战。","book":"《管子·轻重》"}},{"id":29033,"word":"流血飘尸","pinyin":"liú xuè piāo shī","abbr":"lxps","explanation":"形容伤亡极大。","source":{"text":"晋知其兵革之罢倦，粮食尽索，兴师击之，大败。吴师涉江，流血浮尸者不可胜数。","book":"汉·袁康《越绝书·外传记·吴王占梦》"}},{"id":29034,"word":"流行坎止","pinyin":"liú xíng kǎn zhǐ","abbr":"lxkz","explanation":"流：水顺势流；坎：低陷不平。顺流而行，遇险即止。比喻顺利时出仁，遇挫时退隐。","source":{"text":"乘流则逝，得坎则止。纵躯委命，不私与已。","book":"汉·贾谊《鹏鸟赋》"},"example":{"text":"旧管新收几妆镜，～一虚舟。","book":"宋·黄庭坚《赠李辅圣》诗"},"similar":["坎止流行"],"usage":"作谓语、定语；比喻行止进退视境况而定"},{"id":29035,"word":"流觞曲水","pinyin":"liú shāng qū shuǐ","abbr":"lsqs","explanation":"觞：古代酒器；曲水：弯曲的水道。古代的风俗，夏历三月上旬的巳日，在水滨聚会宴饮，以祓除不祥。后泛指在水边宴集。","source":{"text":"又有清流激湍，映带左右，引以为流觞曲水。","book":"晋·王羲之《临河叙》"},"example":{"text":"剩记乃翁诗，绿水红莲觅旧题。归骑春衫花满路，相期。来岁～时。","book":"宋·辛弃疾《南乡子》词"}},{"id":29036,"word":"流言惑众","pinyin":"liú yán huò zhòng","abbr":"lyhz","explanation":"流言：无根据的话。指制造谣言以欺骗、迷惑群众。","source":{"text":"今翟义、刘信等谋反大逆，流言惑众，欲以篡位。","book":"《汉书·翟方进传》"},"example":{"text":"或又谓希崇～，反状已明，请速诛以绝内应。","book":"蔡东藩《五代史演义》第四十四回"},"similar":["妖言惑众"],"usage":"作宾语、定语；指制造谣言迷惑群众"},{"id":29037,"word":"流言止于智者","pinyin":"liú yán zhǐ yú zhì zhě","abbr":"lyzyzz","explanation":"没有根据的话，传到有头脑的人那里就不能再流传了。形容谣言经不起分析。","source":{"text":"流丸止于瓯臾，流言止于智者。","book":"《荀子·大略》"},"example":{"text":"清·褚人获《隋唐演义》第24回：“～，诸兄都是高人，怎么以戏言当真？”"},"usage":"作谓语、定语、宾语、分句；指谣言"},{"id":29038,"word":"流言流说","pinyin":"liú yán liú shuō","abbr":"lyls","explanation":"流流传，引申为没有根据的意见。没有根据的话。多指背后议论、诬蔑或挑拔的话。","source":{"text":"凡流言、流说、流事、流谋、流誉、流愬，不官而衡至者，君子慎之。","book":"《荀子·致士》"}},{"id":29039,"word":"流言混话","pinyin":"liú yán hùn huà","abbr":"lyhh","explanation":"无根据无道理的言语。","source":{"text":"他到底念了些什么书！倒念了些流言混话在肚子里。","book":"清·曹雪芹《红楼梦》第九回"},"usage":"作主语、宾语；用于无根据的话"},{"id":29040,"word":"流言混语","pinyin":"liú yán hùn yǔ","abbr":"lyhy","explanation":"毫无根据而且不明事理的话。","source":{"text":"到念了些流言混语在肚子里，学了些精致的淘气。","book":"清·曹雪芹《红楼梦》第九回"}},{"id":29041,"word":"流言蜚语","pinyin":"liú yán fēi yǔ","abbr":"lyfy","explanation":"毫无根据的话。指背后散布的诽谤性的坏话。","source":{"text":"乃有蜚语，为恶言闻上。","book":"《礼记·儒行》：“久不相见，闻流言不信。”《史记·魏其武安侯列传》"},"example":{"text":"村里人传开了～，说什么夏家的寡妇不正派，伤风败俗。","book":"杨朔《渔笛》"},"similar":["蜚短流长","风言风语"],"opposite":["金玉良言","药石之言"],"usage":"作主语、宾语；指坏话","story":["公元前131年，安武侯田蚡娶燕王的女儿，失势的魏其侯窦婴与将军灌夫奉王太后的命令前去祝贺。灌夫给他们敬酒，田蚡及他的手下不理不睬，灌夫大骂他们，田蚡抓了灌夫全家。王太后出面要挟杀了灌夫，窦婴也被流言蜚语所杀"]},{"id":29042,"word":"流言风语","pinyin":"liú yán fēng yǔ","abbr":"lyfy","explanation":"犹言流言蜚语。毫无根据的话。指背后散布的诽谤性的坏话。","source":{"text":"蛤蟆滩曾经传播过生宝和这女人的流言风语。","book":"柳青《创业史》第二部第五章"},"similar":["流言蜚语"],"opposite":["金玉良言"],"usage":"作主语、宾语；指坏话"},{"id":29043,"word":"流言飞文","pinyin":"liú yán fēi wén","abbr":"lyfw","explanation":"毫无根据的话。多指背后议论、诽谤，或挑拔离间的话。","source":{"text":"是以群小窥见间隙，缘饰文字，巧言丑诋，流言飞文，哗于民间。","book":"《尚书·金滕》：“武王既丧，管叔及其群弟乃流言于国。”《汉书·楚元王传》"},"example":{"text":"是以群小窥见间隙，缘饰文字，巧言丑诋，～哗于民间。","book":"《资治通鉴·汉纪二十》"},"similar":["流言飞语","流言蜚语"],"usage":"作主语、宾语；指坏话"},{"id":29044,"word":"流言飞语","pinyin":"liú yán fēi yǔ","abbr":"lyfy","explanation":"毫无根据的话。指背后散布的诽谤性的坏话。同“流言蜚语”。","source":{"text":"流言飞语，何足凭信。","book":"清·和邦额《夜谭随录·修鳞》"},"similar":["流言飞文","流言蜚语"],"usage":"作主语、宾语；指坏话"},{"id":29045,"word":"流连光景","pinyin":"liú lián guāng jǐng","abbr":"llgj","explanation":"留恋风光景物。指因逗留某地而拖延时间。也指文艺作品的题材或辞句史局限于风花雪夜。","source":{"text":"宋齐之间，文章以风容色泽放旷精清为高，盖吟写性灵，流连光景之文也。","book":"唐·元稹《唐故工部员外郎杜君墓系铭序》"},"example":{"text":"乘兴而来，却难兴尽而返；～，不觉又是半年有余。","book":"明·冯梦龙《警世通言》卷十七"}},{"id":29046,"word":"流连忘反","pinyin":"liú lián wàng fǎn","abbr":"llwf","explanation":"流连：留恋；反：通“返”，回家。留恋不舍，忘记返回","source":{"text":"以杜言者之口，然后流连忘反，不闻其过。","book":"宋·吕公《进十事·无逸》"},"example":{"text":"明·许仲琳《封神演义》第95回：“人君之宴乐有常，未闻～。”"},"similar":["流连忘返"],"opposite":["迷途知返"],"usage":"作谓语、定语、宾语；指十分留恋"},{"id":29047,"word":"流连忘返","pinyin":"liú lián wàng fǎn","abbr":"llwf","explanation":"留恋不舍，忘记返回。","source":{"text":"以杜言者之口，然后流连忘反，不闻其过。","book":"宋·吕公《进十事·无逸》"},"example":{"text":"人君之宴乐有常，未闻～。","book":"明·许仲琳《封神演义》第95回"},"similar":["依依不舍","恋恋不舍","悠悠忘返"],"opposite":["迷途知返"],"usage":"作谓语、定语；指十分留恋"},{"id":29048,"word":"流连荒亡","pinyin":"liú lián huāng wáng","abbr":"llhw","explanation":"指沉溺于游乐。","source":{"text":"流连荒亡，为诸侯忧，从流下而忘反谓之流，从流上而忘反谓之连，从兽无厌谓之荒，乐酒无厌谓之亡。先王无流连之乐，荒亡之行。","book":"《孟子·梁惠王下》"},"example":{"text":"今乐则不然，徒娱人耳目而荡人心志，自昔人君～者，莫不由此。","book":"清·毕沅《续资治通鉴》卷三十六"}},{"id":29049,"word":"流里流气","pinyin":"liú lǐ liú qì","abbr":"lllq","explanation":"举止轻浮，品行不端。","source":{"text":"一些农村姑娘羞羞答答在照相摊前造作地摆好姿势，等待城里来的流里流气的摄影师按快门。","book":"路遥《平凡的世界》第四卷第38章"},"example":{"text":"这人～，让人看不顺眼。"},"opposite":["举止大方"],"usage":"作谓语、定语；指人举止轻浮"},{"id":29050,"word":"流金铄石","pinyin":"liú jīn shuò shí","abbr":"ljss","explanation":"铄、流：熔化。形容天气酷热，好像金石都要熔化。","source":{"text":"大热铄石流金，火弗为益其烈。","book":"战国·楚·宋玉《招魂》：“十日代出，流金铄石些。”《淮南子·铨言训》"},"example":{"text":"季月烦暑，～，聚蚊成雪，封狐千里。","book":"《南史·梁武帝诸子传》"},"similar":["铄石流金"],"usage":"作谓语、定语；形容天气酷热"},{"id":29051,"word":"流风余俗","pinyin":"liú fēng yú sú","abbr":"lfys","explanation":"指遗留的风气、习俗。","source":{"text":"尧舜三代，从容无为，同四海于一堂之上，而流风余俗咏叹之不息，凡以此也。","book":"宋·王安石《虔州学记》"},"example":{"text":"惟自中古以来所输入之旧文物，犹未全废，而～尚有所寄。","book":"达时《夫己氏之支那观》"},"usage":"作主语、宾语；用于民间风俗"},{"id":29052,"word":"流风余韵","pinyin":"liú fēng yú yùn","abbr":"lfyy","explanation":"前代流传给后世的风雅韵事。","source":{"text":"卒之无有识生之才而用之者，宜其伤于情而碎于琴也。然生流风余韵，宛在丹山碧水之间，迄今登鼓山之亭，如闻其哭焉。","book":"清·张潮《虞初新志·焚琴子传》"},"example":{"text":"然而～，足以兴起后人，则惟乡先生之言行为最易入。","book":"清·方宗诚《桐城文录序》"},"similar":["流风余俗"],"usage":"作宾语；指前人流传下来的风度、情操"},{"id":29053,"word":"流风回雪","pinyin":"liú fēng huí xuě","abbr":"lfhx","explanation":"形容婀娜多姿。","source":{"text":"仿佛兮若轻云之蔽月，飘飘兮若流风之回雪。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"范诗清便宛转，如～。","book":"南朝·梁·钟嵘《诗品·梁卫将军范云》"},"usage":"作宾语、定语；用于书面语"},{"id":29054,"word":"流风遗俗","pinyin":"liú fēng yí sú","abbr":"lfys","explanation":"流传下来的风尚习俗。形容人物虽逝，风范犹存。","source":{"text":"臣不及见其人矣，而识其为人，其流风遗俗可得而称者，以世考之也。","book":"宋·苏轼《仁宗皇帝御飞白记》"},"example":{"text":"虽更衰乱，先王之典刑犹存，～，未尽泯然也。","book":"宋·陆九渊《白鹿洞书院论语讲义》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":29055,"word":"流风遗泽","pinyin":"liú fēng yí zé","abbr":"lfyz","explanation":"遗泽：遗留下来的恩惠。指前代留传下来的风尚和德泽。","source":{"text":"太祖经史大基，流风遗泽，所被者远，五圣遵业至今，百有二十余年。","book":"宋·曾巩《太祖皇帝总叙》"},"example":{"text":"君臣上下画江之虑精矣。其～，固足以后亡也。","book":"宋·陈亮《三国纪年·会稽王》"},"usage":"作宾语、定语；用于书面语"},{"id":29056,"word":"流风遗烈","pinyin":"liú fēng yí liè","abbr":"lfyl","explanation":"前辈留下来的风尚和功业。","source":{"text":"后生不复见其流风遗烈，是以日趋于智巧便佞而莫之止。","book":"宋·苏轼《凫绎先生文集叙》"},"usage":"作主语、宾语；用于书面语"},{"id":29057,"word":"流风遗躅","pinyin":"liú fēng yí zhú","abbr":"lfyz","explanation":"流风：遗风。前代遗留下来的风尚和陈迹。","source":{"text":"方今天壤间，盖第一胜绝之境，有意十筑于斯，雅咏玄虚，不谈世事，起其流风遗躅。","book":"金·蔡松年《雨中花》词序"},"similar":["流风遗迹"],"usage":"作主语、宾语、定语；用于书面语"},{"id":29058,"word":"流风遗迹","pinyin":"liú fēng yí jì","abbr":"lfyj","explanation":"前代遗留下来的风尚和陈迹。","source":{"text":"至于长洲之滨，故城之墟，曹孟德、孙仲谋之所睥睨，周瑜、陆逊之所驰骛，其流风遗迹，亦足以称快世俗。","book":"宋·苏辙《黄州快哉亭记》"},"similar":["流风遗躅"],"usage":"作主语、宾语、定语；用于书面语"},{"id":29059,"word":"流风遗韵","pinyin":"liú fēng yí yùn","abbr":"lfyy","explanation":"流风：遗风。前代流传下来的风俗韵事。","source":{"text":"流风：遗风。前代流传下来的风俗韵事。"},"similar":["流风余韵"],"usage":"作主语、宾语；用于书面语"},{"id":29060,"word":"浃沦肌髓","pinyin":"jiā lún jī suǐ","abbr":"jljs","explanation":"浸透肌肉，深入骨髓。比喻感受极深。同“浃髓沦肌”。","source":{"text":"这是不会竭尽的喷泉，这是浃沦肌髓的甘露。","book":"巴金《秋》三十九"},"similar":["浃髓沦肌"],"usage":"作谓语、定语；比喻感受影响很深"},{"id":29061,"word":"浃背汗流","pinyin":"jiā bèi hàn liú","abbr":"jbhl","explanation":"同“汗流浃背”，形容十分惭愧或惶恐。","source":{"text":"当其方成的时候，总觉得满腔高兴，及到过了两日，自家反复读读看时，又不禁浃背汗流了。","book":"郭沫若《文艺论集·论诗三札》"},"example":{"text":"郭沫若《文艺论集·论诗三札》：“当其方成的时候，总觉得满腔高兴，及到过了两日，自家反复读读看时，又不禁～了。”"},"similar":["汗流浃背"],"usage":"作宾语；指流汗多"},{"id":29062,"word":"浃髓沦肌","pinyin":"jiā suǐ lún jī","abbr":"jslj","explanation":"浃：通，透；沦：陷入。浸透肌肉，深入骨髓。比喻感受极深。","source":{"text":"不浸于肌肤，不浃于骨髓。","book":"《淮南子·原道训》"},"example":{"text":"改头换面夸奇遇，～感大恩。","book":"清·吴趼人《二十年目睹之怪现状》第八十二回"},"similar":["浃髓沦肤","浃沦肌髓"],"usage":"作谓语、定语；比喻感受影响很深"},{"id":29063,"word":"浃髓沦肤","pinyin":"jiā suǐ lún fū","abbr":"jslf","explanation":"浃：通，透；沦：陷入。浸透肌肉，深入骨髓。比喻感受极深。","source":{"text":"不浸于肌肤，不浃于骨髓。","book":"《淮南子·原道训》"},"example":{"text":"～都是病，倾囷倒廪更无诗。","book":"宋·范成大《谢江东漕杨廷秀秘监送江东集并索近诗二首》二"},"similar":["浃髓沦肌"],"usage":"作谓语；比喻感受影响很深"},{"id":29064,"word":"浅尝辄止","pinyin":"qiǎn cháng zhé zhǐ","abbr":"qczz","explanation":"辄：就。略微尝试一下就停下来。指不深入钻研。","source":{"text":"此物非不可尝，苟文人墨客，浅尝辄止，用以悦性陶情，有何不可？","book":"清·彭养鸥《黑籍冤魂》第二十四回"},"example":{"text":"做事情不能～，要持之以恒，这样才能成功。"},"similar":["半途而废","浮光掠影"],"opposite":["持之以恒","坚持不懈"],"usage":"作谓语、定语；指害怕困难"},{"id":29065,"word":"浅希近求","pinyin":"qiǎn xī jìn qiú","abbr":"qxjq","explanation":"目标不远，要求不高。","source":{"text":"是以太真夫人犹语马君云：‘与安期相随少久，其术可得而传。如浅希近求，则房户幽坚。","book":"宋·张君房《云笈七签》卷六十五"},"usage":"作谓语、宾语、定语；用于人的企求"},{"id":29066,"word":"浅斟低唱","pinyin":"qiǎn zhēn dī chàng","abbr":"qzdc","explanation":"慢慢地喝酒，低低地歌唱。形容封建时代的士大夫消闲享乐的情状。","source":{"text":"忍把浮名，换了浅尝低唱。","book":"宋·柳永《鹤冲天》词"},"example":{"text":"这公则会阔论高谈，那里知～。","book":"元·戴善夫《风光好》第二折"},"similar":["浅斟低讴"],"usage":"作谓语、定语；用于烦闷的时候"},{"id":29067,"word":"浅斟低讴","pinyin":"qiǎn zhēn dī ōu","abbr":"qzdo","explanation":"斟：筛酒；讴：歌唱。斟着茶酒，低声歌唱。形容悠然自得、遣兴消闲的样子。","source":{"text":"我则待休休游游，他道是御酒金瓯，浅斟低讴，锦袋吴钩，拜相封侯。","book":"明·无名氏《东篱赏菊》第一折"},"similar":["浅斟低唱"],"usage":"作谓语、定语；用于烦闷的时候"},{"id":29068,"word":"浅斟低酌","pinyin":"qiǎn zhēn dī zhuó","abbr":"qzdz","explanation":"斟：筛酒；酌：饮酒。慢慢地饮着茶酒欣赏。形容悠然自得的样子。","source":{"text":"一是北方的佳人，一是关西的大汉，都不宜于浅斟低酌。","book":"朱自清《怀魏握青君》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“王有龄依然喝他的酒，于是～，越发慢了。”"},"opposite":["一饮而尽"],"usage":"作谓语、宾语；用于人悠闲时"},{"id":29069,"word":"浅显易懂","pinyin":"qiǎn xiǎn yì dǒng","abbr":"qxyd","explanation":"浅显：浅近明显。道理或寓意浅显，容易理解、明白。","example":{"text":"宽严相济其政乃安，这本是～的道理，可王士俊之流就偏要曲解，想以不孝之名加罪于朕。","book":"二月河《乾隆皇帝》二十七"}},{"id":29070,"word":"浅见寡识","pinyin":"qiǎn jiàn guǎ shí","abbr":"qjgs","explanation":"浅见：肤浅的见解；寡识：见识很少。形容见闻不广，知识贫乏。","source":{"text":"今辄条数事，布于左右，非出于浅见寡识。","book":"宋·苏舜钦《上范公参政书》"},"example":{"text":"在这事实发生以前，以我的～，是万万想不到的。","book":"鲁迅《华盖集续编·的成因》"},"similar":["浅见寡闻"],"opposite":["见多识广"],"usage":"作谓语、宾语；用于自谦"},{"id":29071,"word":"浅见寡闻","pinyin":"qiǎn jiàn guǎ wén","abbr":"qjgw","explanation":"浅见：肤浅的见解；寡闻：听到的很少。形容见闻不广，所知不多。","source":{"text":"非好学深思，心知其意，固难为浅见寡闻道也。","book":"《史记·五帝本纪赞》"},"example":{"text":"在这事实发生以前，以我的浅见寡识，是万万想不到的。","book":"鲁迅《华盖集续编的续编·阿Ｑ正传的成因》"},"similar":["浅见寡识"],"opposite":["见多识广"],"usage":"作谓语、宾语；指见识浅陋"},{"id":29072,"word":"浅见薄识","pinyin":"qiǎn jiàn bó shí","abbr":"qjbs","explanation":"浅见：肤浅的见解；薄识：见识很少。形容见闻不广，所知不多。","source":{"text":"非好学深思，心知其意，固难为浅见寡闻道也。","book":"《史记·五帝本纪赞》"},"example":{"text":"人每不能测天，致汝纷纭议论，皆由～之故也。","book":"明·冯梦龙《喻世明言》卷三十一"},"similar":["浅见寡识"],"opposite":["见多识广"],"usage":"作谓语、宾语、定语；用于自谦"},{"id":29073,"word":"浅闻小见","pinyin":"qiǎn wén xiǎo jiàn","abbr":"qwxj","explanation":"闻：见识。学问浅薄，见解不高。","source":{"text":"习训诂，传记诵，没溺于浅闻小见，以涂天下之耳目。","book":"明·王守仁《尊经阁记》"},"usage":"作主语、宾语、定语；用于自谦等"},{"id":29074,"word":"浆水不交","pinyin":"jiāng shuǐ bù jiāo","abbr":"jsbj","explanation":"浆水不沾。指为官清廉，无取于民。","source":{"text":"少给佐吏，浆水不交。为从事，大小毕举，郡县敛手。","book":"晋·干宝《搜神记》第11卷"},"usage":"作谓语、定语、宾语；用于为官清廉"},{"id":29075,"word":"浆酒藿肉","pinyin":"jiāng jiǔ huò ròu","abbr":"jjhr","explanation":"把酒肉当作水浆、豆叶一样。形容饮食的奢侈。同“浆酒霍肉”。","source":{"text":"涂金披绣，浆酒藿肉者，故不可称纪。","book":"《宋书·周朗传》"},"example":{"text":"公奈何独私养外亲，与幸臣董贤，多赏赐，宾客～。","book":"《艺文类聚》第72卷引《汉书》"},"similar":["浆酒霍肉"],"usage":"作宾语、定语；形容饮食奢侈"},{"id":29076,"word":"浆酒霍肉","pinyin":"jiāng jiǔ huò ròu","abbr":"jjhr","explanation":"把酒肉当作水浆、豆叶一样。形容饮食的奢侈。","source":{"text":"使奴从宾客浆酒霍肉。","book":"《汉书·鲍宣传》"},"example":{"text":"张灯悬彩，～，竟有昏昏达旦者。","book":"清·李绿园《歧路灯》第九十五回"},"similar":["浆酒藿肉"],"usage":"作宾语、定语；形容饮食奢侈"},{"id":29077,"word":"浇淳散朴","pinyin":"jiāo chún sàn pǔ","abbr":"jcsp","explanation":"使淳朴的社会风气变得浮薄。","source":{"text":"浇淳散朴，并行伪貌。","book":"《汉书·循吏传·黄霸》"},"example":{"text":"若夫修身以取必于天，而天道之爽，百求之而无一应也；将欲求之于人，而一引手援之，非可望于～之世也。","book":"清戴名世《序》"},"similar":["浇醇散朴"],"usage":"作谓语、定语；指社会风气"},{"id":29078,"word":"浇瓜之惠","pinyin":"jiāo guā zhī huì","abbr":"jgzh","explanation":"比喻以德报怨，不因小事而引起纷争。","source":{"text":"汉刘向《新序·杂事四》载：梁与楚的边亭皆种瓜。楚亭人妒恨梁人的瓜长得好，夜往毁之。梁县令宋就制止了梁人的报复，并派人帮助楚人灌瓜，使楚瓜日美。楚王以重金相谢，与梁交好。"},"example":{"text":"昔荆昊之战，事兴蚕妇；～，梁宋息兵。","book":"《晋书苻坚载记上》"},"similar":["灌瓜之义"],"usage":"作宾语；用于处世","story":["传说古代梁国与楚国边境都种了很多瓜，楚人忌妒梁人瓜种得好，乘天黑把梁人的瓜全都毁了。梁人没有报复，在县令宋的带领下，夜间去给楚人浇瓜，楚人的瓜长得一天比一天好。楚王听说后，以重金相谢，并表示以后长期修好"]},{"id":29079,"word":"浇醇散朴","pinyin":"jiāo chún sàn pǔ","abbr":"jcsp","explanation":"使淳朴的社会风气变得浮薄。同“浇淳散朴”。","source":{"text":"施及周室，浇醇散朴，离道以为伪，险德以为行。","book":"《文子·上礼》"},"example":{"text":"这种思潮会让社会风气～。"},"similar":["浇淳散朴"],"usage":"作谓语、定语；指社会风气"},{"id":29080,"word":"浇风薄俗","pinyin":"jiāo fēng bó sú","abbr":"jfbs","explanation":"指社会风气轻浮庸俗。","source":{"text":"得之则逸身丰家，不得则嫉时怨命，噫，此真浇风薄俗者之心也。","book":"唐陈黯《辩谋》"},"usage":"作宾语、定语；指社会风气"},{"id":29081,"word":"浊泾清渭","pinyin":"zhuó jīng qīng wèi","abbr":"zjqw","explanation":"渭水清，泾水浊。比喻界限分明。","source":{"text":"泾以渭浊，湜湜其沚。","book":"《诗经·邶风·谷风》"},"example":{"text":"谁辨～，一任东流。","book":"元·刘秉忠《木兰花慢》词"},"similar":["泾渭分明","清渭浊泾"],"opposite":["是非不分"],"usage":"作宾语、定语；指界限分明"},{"id":29082,"word":"浊质凡姿","pinyin":"zhuó zhì fán zī","abbr":"zzfz","explanation":"凡庸的姿质。","source":{"text":"想我浊质凡姿，今夕得到月府，好侥幸也。","book":"清·洪昇《长生殿·闻乐》"},"usage":"作谓语、定语、宾语；用于自谦"},{"id":29083,"word":"浊酒一杯","pinyin":"zhuó jiǔ yī bēi","abbr":"zjyb","explanation":"浊：浑浊。指酒质差而且有限，聊以自娱或排遣","source":{"text":"浊酒一杯，弹琴一曲，志愿毕矣。","book":"三国·魏·嵇康《与山巨源绝交书》"},"example":{"text":"唐·杜之松《答王绩书》：“～，清琴数弄，诚足乐也。”"},"usage":"作宾语、定语；用于书面语"},{"id":29084,"word":"浊酒菲肴","pinyin":"zhuó jiǔ fěi yáo","abbr":"zjfy","explanation":"菲：微薄；肴：荤菜。浑浊的酒，微薄的菜肴","source":{"text":"今具浊酒菲肴……枉驾来临，城为周瑜万幸也。","book":"元·无名氏《黄鹤楼》第三折"},"usage":"作宾语、定语；多用于自谦"},{"id":29085,"word":"浊醪粗饭","pinyin":"zhuó láo cū fàn","abbr":"zlcf","explanation":"浊醪：浊酒。指简单粗糙的饮食","source":{"text":"钟鼎山林各天性，浊醪粗饭任吾年。","book":"唐·杜甫《清明二首》诗"},"example":{"text":"宋·陆游《秋夜》诗：“老病龙钟不入城，～饯余生。”"},"usage":"作宾语、定语；用于书面语"},{"id":29086,"word":"浊骨凡胎","pinyin":"zhuó gǔ fán tāi","abbr":"zgft","explanation":"凡人的重浊躯体。指尘世之人。","source":{"text":"休道是浊骨凡胎，便是释迦佛也恼下莲台。","book":"元·马致远《黄粱梦》第二折"},"example":{"text":"大家与玉皇大帝相傲，却不再寻思你这点点子～，怎能傲得天过。","book":"清·西周生《醒世姻缘传》第二十七回"},"similar":["凡夫俗子","凡胎浊骨"],"usage":"作宾语、定语；用于书面语"},{"id":29087,"word":"济世之才","pinyin":"jì shì zhī cái","abbr":"jszc","explanation":"济世：拯救时世。能够拯救时世，治理国家的人才。","source":{"text":"殊方又喜故人来，重镇还须济世才。","book":"唐·杜甫《待严大夫诗》"},"example":{"text":"若真有点～，竟自遯世，岂不辜负天地生才之心吗？","book":"清·刘鹗《老残游记》第六回"},"usage":"作宾语；指救世的才能"},{"id":29088,"word":"济世匡时","pinyin":"jì shì kuāng shí","abbr":"jsks","explanation":"济：拯救；匡：匡正。拯救人世，匡正时政。","source":{"text":"却说管夷吾字仲，生得相貌魁梧，精神俊爽，博通坟典，淹贯古今，有经天纬地之才，","book":"明·冯梦龙《东周列国志》第十五回"},"example":{"text":"错综今古，尝怀～之略，运会不偶。","book":"清·黄宗羲《黎眉郭公传》"},"usage":"作宾语、定语；指拯救人世"},{"id":29089,"word":"济世安人","pinyin":"jì shì ān rén","abbr":"jsar","explanation":"拯救时世，安定人民。","source":{"text":"一夜霜风雕玉芝，苍生望绝士林悲，空怀济世安人略，不见男婚女嫁时。","book":"唐·刘禹锡《哭吕衡州》"},"similar":["济世安民"],"usage":"作谓语、宾语、定语；指安邦定国"},{"id":29090,"word":"济世安民","pinyin":"jì shì ān mín","abbr":"jsam","explanation":"使国家得到治理，百姓安居乐业。","source":{"text":"龙凤之姿，天日之表，其年将二十，必能济世安民矣。","book":"《旧唐书·太宗本纪上》"},"example":{"text":"孟轲得圣贤之传于子思，有～之志。","book":"明·冯梦龙《东周列国志》第八十七回"},"similar":["济世安邦","济世匡时"],"opposite":["祸国殃民"],"usage":"作谓语、宾语、定语；指安邦定国","story":["隋朝末年，李渊带着4岁的儿子到歧州，歧州书生拜谒李渊。他会相面术，仔细观察李渊之后认为他是贵人，观看他的儿子后说“龙凤之姿，天日之表，其年将二十，必能济世安民矣。”李渊觉得有理，就给儿子取名“李世民”"]},{"id":29091,"word":"济世安邦","pinyin":"jì shì ān bāng","abbr":"jsab","explanation":"济：拯救；邦：国家。拯救时世，安定国家。","source":{"text":"你学济世安邦策，按六韬三略书。","book":"元·无名氏《九世同堂》第一折"},"example":{"text":"实话相告，岩与佛法缘分很浅，虽无功名富贵之念，却有～之心。","book":"姚雪垠《李自成》第四卷第三章"},"similar":["济世安民"],"usage":"作谓语、宾语、定语；指安邦定国"},{"id":29092,"word":"济世救人","pinyin":"jì shì jiù rén","abbr":"jsjr","explanation":"济：拯救。拯治时世救济人民。","source":{"text":"乃命其子命龙宫药方三十首与先生，此真道者，可以济世救人。","book":"宋·张君房《云笈七签》第一百一十三卷"},"similar":["济世匡时"],"usage":"作宾语、定语；指拯治人世"},{"id":29093,"word":"济世爱民","pinyin":"jì shì ài mín","abbr":"jsam","explanation":"拯济时世，爱护人民。","source":{"text":"我本清泰世间奇男子，济世爱民，扶危定难，忠勋不小，爵位已高。","book":"明·屠隆《昙花记·辞家访道》"},"similar":["济世安民"],"usage":"作谓语、宾语、定语；指救助民众"},{"id":29094,"word":"济世经邦","pinyin":"jì shì jīng bāng","abbr":"jsjb","explanation":"指拯救人世，治理国家。","source":{"text":"此行指望济世经邦，谁想竟成画饼。","book":"明·屠隆《彩毫记·知幾引退》"},"example":{"text":"进德修行，要个木石的念头，若一有欣羡便趋欲境；～，要段云水的趣味，若一有贪著便堕危机。","book":"明·洪应明《菜根谭·修身》"},"similar":["济世安邦"],"usage":"作谓语、宾语、定语；指治理国家"},{"id":29095,"word":"济人利物","pinyin":"jì rén lì wù","abbr":"jrlw","explanation":"指救助别人，对世事有益。","source":{"text":"岁大疫，亲旧有尽室病卧者，公每清旦辄携粥药造之，遍饮食之而后返，日以为常，其他济人利物之事不胜计，虽倾资竭力无吝色。","book":"宋·朱熹《记外大父祝公遗事》"},"example":{"text":"中国词章家有警语二句，曰:‘～非吾事，自有周公孔圣人。’","book":"梁启超《呵旁观者文》"},"usage":"作谓语、定语；用于书面语"},{"id":29096,"word":"济困扶危","pinyin":"jì kùn fú wēi","abbr":"jkfw","explanation":"济、扶：帮助。救济贫困的人，扶助有危难的人。","source":{"text":"一个报冤仇称了子胥，一个打赌赛去了包胥，何处也济困扶危重复楚。","book":"元·郑廷玉《楚昭公》第三折"},"example":{"text":"你是最肯～的人，难道就眼睁睁的看着人家来摆布死了我们娘儿们不成？","book":"清·曹雪芹《红楼梦》第二十五回"},"similar":["仗义疏财","扶弱抑强"],"opposite":["自私自利","落井下石"],"usage":"作谓语、定语、分句；指救助弱势"},{"id":29097,"word":"济寒赈贫","pinyin":"jì hán zhèn pín","abbr":"jhzp","explanation":"济：救济；赈：赈济。救助寒苦，赈济贫穷。","source":{"text":"养老尊贤，教其术，畜其能，吊死问孤，济寒赈贫，与百姓同甘共苦。","book":"《全相平话·乐毅图齐七国春秋后集》"},"usage":"作谓语、定语；指救助贫寒"},{"id":29098,"word":"济弱扶倾","pinyin":"jì ruò fú qīng","abbr":"jrfq","explanation":"弱：弱小；倾：倒塌，比喻境遇困难。扶助弱小和处境困难的人。","source":{"text":"你若肯扶倾济弱，我可便回嗔作笑。","book":"南朝·梁·周兴嗣《千字文》：“桓公匡合，济弱扶倾。”元·王子一《误入桃源》第四折"},"example":{"text":"倘蒙仁慈隐恻，庶有～，希垂顾答审详，望感渠荷滴沥。","book":"清·平步青《霞外捃屑》卷五"},"similar":["扶危济困","济弱扶危"],"usage":"作谓语、定语；指救助弱小危难的人"},{"id":29099,"word":"济弱扶危","pinyin":"jì ruò fú wēi","abbr":"jrfw","explanation":"济：救助；弱：弱小。指救助弱小危难的人。","source":{"text":"更喜新娶妻张氏，奁中颇有积蓄，得以散财结交，济弱扶危。","book":"清·褚人获《隋唐演义》第四回"},"similar":["济弱扶倾"],"usage":"作谓语、定语；指救助弱小危难的人"},{"id":29100,"word":"济弱锄强","pinyin":"jì ruò chú qiáng","abbr":"jrcq","explanation":"济：帮助；锄：铲除。帮助弱者，铲除强暴。","source":{"text":"这不平之气，个个有的，若没个济弱锄强的手段，也只干着恼一番。","book":"清·褚人获《隋唐演义》第十八回"},"similar":["锄强扶弱"],"usage":"作谓语、定语、宾语；指锄强扶弱"},{"id":29101,"word":"济时拯世","pinyin":"jì shí zhěng shì","abbr":"jszs","explanation":"指拯救时世。","source":{"text":"且济时拯世之术，岂必体尧蹈舜然后乃理哉？","book":"《后汉书·崔寔传》"},"example":{"text":"且～之术，岂必体尧蹈舜，然后乃理哉？","book":"蔡东藩《后汉演义》第四十九回"},"usage":"作谓语、定语；指人挽救社会","story":["汉桓帝时期，涿郡人崔骃喜欢研究典籍，写了《政论》议论时政，他认为汉朝经历了350多年，积弊很深，应根据当时情况制定法律，解决急需解决的问题，才能补漏纠错、济时拯世。他的理论在任五原太守时充分得到实践"]},{"id":29102,"word":"济时行道","pinyin":"jì shí xíng dào","abbr":"jshd","explanation":"济：拯救；道：仁道。拯救时世，施行仁道。","source":{"text":"乃谓先生以王者之术说武后，荐圭璧于房闼，而讽其聋瞽，岂瞳以知先生济时行道，忠忧之心进进不已哉。","book":"明·杨澄《陈伯玉先生文集后序》"},"usage":"作谓语、定语；指救世行王道"},{"id":29103,"word":"济河焚舟","pinyin":"jì hé fén zhōu","abbr":"jhfz","explanation":"济：渡；焚：烧。渡过了河，把般烧掉。比喻有进无退，决一死战。","source":{"text":"秦伯伐晋，济河楚舟。","book":"《左传·文公三年》"},"example":{"text":"若文度来，我以偏师待之；康伯来，～。","book":"南朝·宋·刘义庆《世说新语·言语》"},"similar":["过河拆桥","有进无退"],"usage":"作谓语、宾语；表示决心死战","story":["公元前628年，秦国趁晋国大丧而出兵占领晋国滑城，晋国出兵将秦军全部消灭，主将孟明视靠晋文公夫人帮助才得以逃回秦国。3年后，秦穆公又派孟明视伐晋。孟明视从茅津渡河后将船全部烧毁，背水一战，大败晋军，占领王官等地"]},{"id":29104,"word":"济济一堂","pinyin":"jǐ jǐ yī táng","abbr":"jjyt","explanation":"济济：形容人多。形容很多有才能的人聚集在一起。","source":{"text":"济济有众，咸听朕命。","book":"《尚书·大禹谟》"},"example":{"text":"摄影中～的满是儿童。","book":"朱自清《“海阔天空”与“古今中外”》"},"similar":["高朋满座","群贤毕集"],"opposite":["一盘散沙","分道扬镳"],"usage":"作谓语、定语；指人多"},{"id":29105,"word":"济济彬彬","pinyin":"jǐ jǐ bīn bīn","abbr":"jjbb","explanation":"济济：庄重恭敬；彬彬：温文尔雅。仪态庄重，举止文雅。","source":{"text":"朝门外有十余位官员，一个个峨冠博带，济济彬彬，列于两行。","book":"明·冯梦龙《东周列国志》第六十九回"},"usage":"作谓语、定语；指人有修养"},{"id":29106,"word":"济济跄跄","pinyin":"jǐ jǐ qiāng qiāng","abbr":"jjqq","explanation":"济济：庄重恭敬；跄跄：举止合乎礼仪，形容队列整齐庄严，行动合乎礼仪。","source":{"text":"济济跄跄,絜尔牛羊,以往烝尝。","book":"《诗经·小雅·楚茨》"},"example":{"text":"尾接头，头接尾，鱼贯行来，那敢挨挨挤挤；后照前，前照后，雁行列去，无非～。","book":"明·徐渭《英烈传》第七十八回"},"usage":"作谓语、定语；指队列整齐有礼节"},{"id":29107,"word":"济窍飘风","pinyin":"jì qiào piāo fēng","abbr":"jqpf","explanation":"指大风止则所有的窍孔都空寂无声。后比喻毫无影响与作用的事物。","source":{"text":"飘风则大和，厉风济则众窍为虚。","book":"语出《庄子·齐物论》"},"example":{"text":"此奚翅当士子出身之日，先教以赫赫王言，实等诸～，不关人事，又何怪他日者，身为官吏，刑在前而不栗，议在后而不惊。","book":"严复《救亡决论》"},"usage":"作谓语、定语；用于书面语"},{"id":29108,"word":"济胜之具","pinyin":"jì shèng zhī jù","abbr":"jszj","explanation":"具备跋山涉水游览名胜的身体条件。形容身体强健。","source":{"text":"许掾好游山水，而体便登陟。时人云：‘许非徒有胜情，实有济胜之具。’","book":"南朝·宋·刘义庆《世说新语·栖逸》"},"example":{"text":"小弟无～，就登山临水，也是勉强。","book":"清·吴敬梓《儒林外史》第三十回"},"usage":"作宾语；用于书面语"},{"id":29109,"word":"济苦怜贫","pinyin":"jì kǔ lián pín","abbr":"jklp","explanation":"救济爱惜穷苦的人。","source":{"text":"善惠谦柔，济苦怜贫，随方就圆。","book":"元·侯善渊《沁园春》词"},"similar":["济困扶危"],"usage":"作谓语、定语、宾语；指救助弱势"},{"id":29110,"word":"济贫拔苦","pinyin":"jì pín bá kǔ","abbr":"jpbk","explanation":"指救援贫苦人家。","source":{"text":"常行慈悲，济贫拔苦，归将有余数不足者，将安乐施厄者。","book":"《敦煌变文集·维摩诘讲经文》"},"example":{"text":"举善荐君子事，～圣贤心。","book":"明·无名氏《破风诗》第四折"},"usage":"作谓语、宾语；用于书面语"},{"id":29111,"word":"浑俗和光","pinyin":"hún sú hé guāng","abbr":"hshg","explanation":"浑俗：与世俗混同；和光：混合所有光彩。比喻不露锋芒，与世无争。也比喻无能，不中用。","source":{"text":"俺先人甚的是浑俗和光，真一味风清月朗。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"你这小乘教法，度不得亡者超升，只可～而已。","book":"明·吴承恩《西游记》第十二回"},"similar":["与世无争"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；比喻不露锋芒，与世无争"},{"id":29112,"word":"浑抡吞枣","pinyin":"hún lún tūn zǎo","abbr":"hltz","explanation":"比喻笼统地接受，不加分析，食而不化。同“浑沦吞枣”。","source":{"text":"嗟见浑抡吞枣，只管诵持。","book":"元·耶律楚材《〈心经宗说〉后序》"},"similar":["浑沦吞枣","囫囵吞枣","鹘仑吞枣"],"usage":"作谓语、宾语、状语；形容读书不认真"},{"id":29113,"word":"浑水摸鱼","pinyin":"hún shuǐ mō yú","abbr":"hsmy","explanation":"浑水：不清的水。比喻乘混乱的时候从中捞取利益。","source":{"text":"假若事情已定，他大可以马上去浑水摸鱼，管什么上海开仗不开仗。","book":"老舍《四世同堂·惶惑》"},"example":{"text":"助纣为虐，他是不干的。～，此其时也。","book":"徐迟《牡丹》五"},"similar":["趁火打劫","混水摸鱼"],"opposite":["夜不闭户","路不拾遗"],"usage":"作谓语、定语；指趁火打劫"},{"id":29114,"word":"浑沦吞枣","pinyin":"hún lún tūn zǎo","abbr":"hltz","explanation":"整个地吞下枣子。比喻笼统地接受，不加分析，食而不化。","source":{"text":"今学者有几个理会得章句，也只是浑沦吞枣。","book":"《朱子语类》卷一二四"},"similar":["鹘仑吞枣","囫囵吞枣"],"usage":"作谓语、宾语、状语；形容读书不认真"},{"id":29115,"word":"浑浑噩噩","pinyin":"hún hún è è","abbr":"hhee","explanation":"浑浑：深厚的样子；噩噩：严肃的样子。原意是浑厚而严正。现形容糊里糊涂，愚昧无知。","source":{"text":"虞夏之书浑浑尔，商书灏灏尔，周书噩噩尔。","book":"汉·扬雄《法言·问神》"},"example":{"text":"他自己在十六七岁时～的，所以觉得十六岁的女孩子便那么练达人情世故，不是“寿相”。","book":"茅盾《一个女性》"},"similar":["糊里糊涂","混混沌沌","昏头昏脑"],"usage":"作谓语、定语、宾语；指人的头脑"},{"id":29116,"word":"浑浑无涯","pinyin":"hún hún wú yá","abbr":"hhwy","explanation":"浑浑：浩浩茫茫的样子。形容广阔无边，博大精深。多赞誉内容丰富的巨著。","source":{"text":"上规姚姒，浑浑无涯，周诰殷盘，佶屈聱牙。","book":"唐·韩愈《进学解》"}},{"id":29117,"word":"浑浑沉沉","pinyin":"hún hún shěn chén","abbr":"hhcc","explanation":"广大的样子。","source":{"text":"《淮南子·兵略训》：“天化育而无形象，地生长而无计量，浑浑沉沉，孰知其藏。”一说，“沉”当为“沆”字。参阅清·王念孙《读书杂志·淮南内篇二》。"}},{"id":29118,"word":"浑浑沌沌","pinyin":"hún hún dùn dùn","abbr":"hhdd","explanation":"混杂、不分明的样子，也指糊涂无知的样子，形容迷糊，不清醒。","source":{"text":"纷纷纭纭，斗乱而不可乱也；浑浑沌沌，形圆而不可败也。","book":"先秦·孙武《孙子·势》"},"example":{"text":"在湖南念书的时候，我还是～的，不太晓得事情。","book":"田汉《暴风雨中的七个女性》"},"similar":["浑浑噩噩","迷迷糊糊"],"usage":"作宾语、补语、定语；指人的头脑"},{"id":29119,"word":"浑然一体","pinyin":"hún rán yī tǐ","abbr":"hryt","explanation":"混然：混同在一起的样子。融合成一个整体，不可分割。也形容文章绘画，布置匀整，结构谨严。","source":{"text":"学者须先识仁。仁者，浑然与物同体。义、礼、知、信皆仁也。","book":"《二程遗书》卷二上"},"example":{"text":"这幅山水画气势雄壮，结构紧凑，～。"},"similar":["天衣无缝","水乳交融","沆瀣一气"],"opposite":["格格不入","若即若离","支离破碎"],"usage":"作谓语、宾语、定语；用于诗文、绘画等"},{"id":29120,"word":"浑然天成","pinyin":"hún rán tiān chéng","abbr":"hrtc","explanation":"形容诗文结构严密自然，用词运典毫无斧凿痕迹。亦形容人的才德完美自然。","source":{"text":"阁下负超卓之奇才，蓄雄刚之俊德，浑然天成，无有畔岸。","book":"唐·韩愈《上襄阳于相公书》"},"example":{"text":"为诗用事，～，不见痕迹。","book":"明·焦竑《玉堂丛语·文学》"},"similar":["混然天成","浑然自成"],"usage":"作谓语；形容诗文结构严密自然"},{"id":29121,"word":"浑然无知","pinyin":"hún rán wú zhī","abbr":"hrwz","explanation":"形容糊里糊涂，什么都不知道。","source":{"text":"那贼浑然不知，不言不语。","book":"明·吴承恩《西游记》第九十九回"},"usage":"作谓语、定语；用于处事"},{"id":29122,"word":"浑然自成","pinyin":"hún rán zì chéng","abbr":"hrzc","explanation":"形容诗文结构严密自然，用词运典毫无斧凿痕迹。亦形容人的才德完美自然。同“浑然天成”。","source":{"text":"美丽的形象，应有适当的字汇来构成，这原是不错的；但二者实应同时产生，浑然自成。","book":"茅盾《大题小解》"},"similar":["浑然天成","混然天成"],"usage":"作谓语、定语；形容诗文结构严密自然"},{"id":29123,"word":"浑身是口","pinyin":"hún shēn shì kǒu","abbr":"hssk","explanation":"表示浑身都有能言善辩的嘴。","source":{"text":"浑身是口怎支吾，恰似个没嘴的葫芦。","book":"元·关汉卿《蝴蝶梦》第二折"}},{"id":29124,"word":"浑身是胆","pinyin":"hún shēn shì dǎn","abbr":"hssd","explanation":"形容胆量大，无所畏惧。","source":{"text":"先主明旦自来，至云营围，视昨战处，曰：‘子龙一身都是胆也！’","book":"《三国志·蜀志·赵云传》裴松之注引《云别传》"},"example":{"text":"武松～，赤手空拳打死了凶猛的老虎。"},"similar":["胆大包天","胆大如斗"],"opposite":["胆小如鼠"],"usage":"作谓语、定语；形容胆量极大，无所畏惧"},{"id":29125,"word":"浑身皆胆","pinyin":"hún shēn jiē dǎn","abbr":"hsjd","explanation":"形容胆量大，无所畏惧。","source":{"text":"先主明旦自来，至云营围，视昨战处，曰：‘子龙一身都是胆也！’","book":"《三国志·蜀志·赵云传》裴松之注引《赵云别传》"},"example":{"text":"最是满腹精神，担负处，～。","book":"宋·陈著《宝鼎观·寿京尹曾留远侍郎渊子》"}},{"id":29126,"word":"浑身解数","pinyin":"hún shēn xiè shù","abbr":"hsxs","explanation":"浑身：全身，指所有的；解数：那套数，指武艺。所有的本领，全部的权术手腕。","source":{"text":"浑身解数如花锦，双手腾那似辘轳。","book":"明·吴承恩《西游记》第七十三回"},"example":{"text":"以后的三年里，她如同狮子滚绣球一般，无一时不活动，无一时不是使出～的在活动。","book":"冰心《关于女人·我的学生》"},"usage":"作宾语；用在“使出”、“用尽”之后"},{"id":29127,"word":"浑金璞玉","pinyin":"hún jīn pú yù","abbr":"hjpy","explanation":"比喻天然美质，未加修饰。多用来形容人的品质淳朴善良。","source":{"text":"王戎目山巨源如璞玉浑金，人皆钦其宝，莫知名其器。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"灵芝继起殊寻常，～其器良。","book":"清·黄遵宪《别赖云芝同年》诗"},"similar":["浑金白玉"],"usage":"作宾语；比喻未加修饰的天然美质","story":["魏晋时期，“竹林七贤”之一的山涛担任晋朝吏部尚书，嵇康为此与他绝交。山涛推荐嵇康的儿子嵇绍做秘书丞。为了抵制小人陆亮为官，他自己辞官回乡。“竹林七贤”的王戎称赞山涛像浑金璞玉一样高贵"]},{"id":29128,"word":"浑金白玉","pinyin":"hún jīn bái yù","abbr":"hjby","explanation":"比喻天然美质，未加修饰。多用来形容人的品质淳朴善良。同“浑金璞玉”。","source":{"text":"士大夫出处，如浑金白玉，不可玷阙。","book":"宋·戴埴《鼠璞·魏相许伯》"},"similar":["浑金璞玉"],"usage":"作宾语、定语；比喻未加修饰的天然美质"},{"id":29129,"word":"浓墨重彩","pinyin":"nóng mò zhòng cǎi","abbr":"nmzc","explanation":"用浓重的墨汁和颜色来描绘。形容着力描写。","example":{"text":"他用～，着重描写这次活动。"},"usage":"作宾语、定语、状语；用于写作等"},{"id":29130,"word":"浓妆淡抹","pinyin":"nóng zhuāng dàn mò","abbr":"nzdm","explanation":"指浓艳和淡雅两种不同的妆饰。参见“淡妆浓抹”。","source":{"text":"欲把西湖比西子，浓妆淡抹总相宜。","book":"宋·苏轼《饮湖上初晴后雨》诗"},"similar":["浓抹淡妆"],"usage":"作宾语、定语；用于书面语"},{"id":29131,"word":"浓妆艳抹","pinyin":"nóng zhuāng yàn mǒ","abbr":"nzym","explanation":"形容妇女妆饰打扮得十分艳丽。","source":{"text":"每日只是浓妆艳抹，和西门庆做一处取乐。","book":"明·施耐庵《水浒传》"},"example":{"text":"她穿得比以前漂亮，而且是～，还戴了一副长耳坠。","book":"巴金《家》"},"similar":["浓妆艳裹"],"opposite":["青鞋布袜"],"usage":"作谓语、定语；用于女性"},{"id":29132,"word":"浓妆艳服","pinyin":"nóng zhuāng yàn fú","abbr":"nzyf","explanation":"指妇女妆饰浓重、艳丽。同“浓妆艳裹”。","source":{"text":"众宫人都浓妆艳服，骑在马上，一簇绮罗，千行丝竹，从大内直排至西苑。","book":"清·褚人获《隋唐演义》第三十五回"},"example":{"text":"曾朴《孽海花》第六回：“把个小姐看得忍俊不禁，竟～的现出了庄严宝相。”"},"similar":["浓妆艳裹"],"usage":"作谓语、定语、宾语；用于女性"},{"id":29133,"word":"浓妆艳裹","pinyin":"nóng zhuāng yàn guǒ","abbr":"nzyg","explanation":"妆：打扮。指妇女妆饰浓重、艳丽。","source":{"text":"一个个浓妆艳裹，一对妙舞清歌。","book":"元·王子一《误入桃源》第二折"},"example":{"text":"祭毕，即除去孝服，沐浴薰香，～，言笑自若。","book":"明·罗贯中《三国演义》第三十八回"},"similar":["粉墨登场"],"opposite":["青鞋布袜"],"usage":"作谓语、定语；形容女子打扮得很浓艳"},{"id":29134,"word":"浓妆艳质","pinyin":"nóng zhuāng yàn zhì","abbr":"nzyz","explanation":"浓妆：浓艳的妆饰；质：资质。妆饰华美，容貌艳丽。","source":{"text":"军声哄，军声哄，长枪大戟香尘拥，香尘拥，浓妆艳质。","book":"明·梅鼎祚《玉合记·还玉》"},"usage":"作谓语、定语、状语；用于女性"},{"id":29135,"word":"浓妆艳饰","pinyin":"nóng zhuāng yàn shì","abbr":"nzys","explanation":"形容妇女妆饰打扮得十分艳丽。同“浓妆艳抹”。","source":{"text":"嘉兴白县尹得代，过姚庄，访僧胜福林。闲游市井间，见妇人女子，皆浓妆艳饰。","book":"明·陶宗仪《辍耕录·白县尹诗》"},"example":{"text":"那女孩儿～从里面出来。","book":"明·施耐庵《水浒传》第四回"},"similar":["浓妆艳裹","浓妆艳服"],"usage":"作谓语、定语；用于女性"},{"id":29136,"word":"浓抹淡妆","pinyin":"nóng mò dàn zhuāng","abbr":"nmdz","explanation":"指淡雅和浓艳两种不同的妆饰打扮。同“淡妆浓抹”。","source":{"text":"坡谓西湖，正如西子，浓抹淡妆临镜台。","book":"宋·刘过《沁园春·寄稼轩承旨》词"},"example":{"text":"兴来走笔如有神，～无不好。","book":"明·刘基《顾周道山水图》诗"},"similar":["浓妆淡抹"],"usage":"作宾语、定语；用于书面语"},{"id":29137,"word":"浓桃艳李","pinyin":"nóng táo yàn lǐ","abbr":"ntyl","explanation":"桃花浓丽，李花鲜艳。比喻人容貌俊美，神采焕发。","source":{"text":"谁承望今宵牛女，银河咫尺间，巧一似穿针会，两下里青春浓桃艳李。","book":"明·高濂《玉簪记·词媾》"},"usage":"作宾语、定语；用于人的容貌"},{"id":29138,"word":"浓浓郁郁","pinyin":"nóng nóng yù yù","abbr":"nnyy","explanation":"指香气、色彩、气氛等浓厚热烈。","source":{"text":"方进得院来，早闻得浓浓郁郁的异香扑鼻。","book":"清·褚人获《隋唐演义》第29回"},"usage":"作定语、状语；用于香气、色彩、气氛等"},{"id":29139,"word":"浓眉大眼","pinyin":"nóng méi dà yǎn","abbr":"nmdy","explanation":"又黑又密的眉毛，大大的眼睛。形容眉目有神的人。","source":{"text":"只见里面一个浓眉大眼的黑面肥胖妇人，穿着一件黑夏布小衣，两袖勒得高高的，膊肘子也露了出来。","book":"清·吴趼人《二十年目睹之怪现状》第三十三回"},"example":{"text":"那和尚生得～。","book":"清·文康《儿女英雄传》第五回"},"usage":"作宾语、定语、状语；指人的外表"},{"id":29140,"word":"浓翠蔽日","pinyin":"nóng cuì bì rì","abbr":"ncbr","explanation":"翠：青绿色；蔽：挡住。形容树木茂密遮挡阳光。","source":{"text":"长松修竹，浓翠蔽日，层峦奇岫，静窈紫深。","book":"宋·周密《武林旧事》第三卷"},"similar":["浓荫蔽日","浓荫蔽天"],"usage":"作谓语、定语；指树木茂密"},{"id":29141,"word":"浓荫蔽天","pinyin":"nóng yīn bì tiān","abbr":"nybt","explanation":"蔽：挡住。形容树木茂密遮挡阳光。","source":{"text":"我们全团战士集合在有几排浓荫蔽天的大树遮盖的一个院子里。","book":"《星火燎原·难忘的日子》"},"example":{"text":"天果真是阴了，西边还隐隐传来隆隆的雷声，只是满园的老树薛萝～，看不见天上的云是怎样的情形儿。","book":"二月河《乾隆皇帝》十五"},"similar":["浓荫蔽日"],"usage":"作谓语、定语；指树木茂密"},{"id":29142,"word":"浓荫蔽日","pinyin":"nóng yīn bì rì","abbr":"nybr","explanation":"形容树木枝繁叶茂，可以遮住阳光。","source":{"text":"譬如种柳树，特到柳树长大，浓荫蔽日，农夫耕作到正午，或者可以坐在柳树底下吃饭，休息休息。","book":"鲁迅《革命时代的文学》"},"similar":["浓翠蔽日"],"usage":"作谓语、定语；指树木茂密"},{"id":29143,"word":"浓装艳抹","pinyin":"nóng zhuāng yàn mò","abbr":"nzym","explanation":"形容妇女妆饰打扮得十分艳丽。同“浓妆艳抹”。","source":{"text":"大姑娘却浓装艳抹，体态轻盈的靠在寝宫门口。","book":"清·曾朴《孽海花》第二十七回"},"example":{"text":"女的仍有男的装扮，～，妖娆非常。","book":"洪深《民间的戏剧艺术》"},"similar":["浓妆艳抹"],"usage":"作谓语、定语；用于女性"},{"id":29144,"word":"浓郁葱茏","pinyin":"nóng yù cōng lóng","abbr":"nycl","explanation":"浓郁：花草的香气浓重；葱茏：草木青翠茂盛。形容花草香气浓重，枝叶茂密青翠。","source":{"text":"首先映入眼帘的是，山上那浓郁葱茏的松柏，巍然挺立，充满生机。","book":"肖兵《太行青松》"},"usage":"作谓语、定语；用于风景描写"},{"id":29145,"word":"浞訾栗斯","pinyin":"zhuó zī lì sī","abbr":"zzls","explanation":"指妄自尊大。"},{"id":29146,"word":"浩乎无际","pinyin":"hào hū wú jì","abbr":"hhwj","explanation":"广大没有边际。","example":{"text":"在这～的大荒漠里，他几乎绝望了。"},"similar":["广大无际","无边无际"],"usage":"作谓语、定语；形容广大"},{"id":29147,"word":"浩如烟海","pinyin":"hào rú yān hǎi","abbr":"hryh","explanation":"浩：广大；烟海：茫茫大海。形容典籍、图书等极为丰富。","source":{"text":"若夫正法宏深，妙理难寻，非生非灭，非色非心，浩如沧海，郁如邓林。","book":"隋·释真观《梦赋》"},"example":{"text":"古今载籍，～。","book":"清·周永年《儒藏记》"},"similar":["不计其数","汗牛充栋","不可胜数"],"opposite":["寥若晨星"],"usage":"作谓语、定语；用于书籍、学识等"},{"id":29148,"word":"浩气凛然","pinyin":"hào qì lǐn rán","abbr":"hqlr","explanation":"浩气：即正气，刚直正大的精神；凛然：严肃，令人敬畏的样子。浩然之气令人敬畏。","source":{"text":"我善养吾浩然之气……其为气也，至大至刚，以直养而无害，则塞于天地之间，其为气也，配义与道；无是，馁也。","book":"《孟子·公孙丑上》"},"similar":["正气凛然"],"usage":"作定语、状语；用于人的态度等"},{"id":29149,"word":"浩气四塞","pinyin":"hào qì sì sāi","abbr":"hqss","explanation":"浩气：浩然正气；塞：充满。正气充满四面八方。","source":{"text":"浩气四塞。","book":"孙中山《序》"},"example":{"text":"我们要营造～的环境。"},"usage":"作谓语、定语；用于书面语"},{"id":29150,"word":"浩气英风","pinyin":"hào qì yīng fēng","abbr":"hqyf","explanation":"浩气：即正气，刚直不屈的气节；英风：英勇豪迈的气概。形容英勇刚直，气度非凡。","source":{"text":"二人死节之烈，浩气英风，实足为后死者之模范。","book":"孙中山《心理建设》第八章"}},{"id":29151,"word":"浩气长存","pinyin":"hào qì cháng cún","abbr":"hqcc","explanation":"浩气：即正气，刚直正大的精神。浩然之气永远长存。","example":{"text":"他的逝世流芳千古，～。"},"usage":"作谓语、定语；用于书面语"},{"id":29152,"word":"浩汗无涯","pinyin":"hào hàn wú yá","abbr":"hhwy","explanation":"浩汗：同“浩瀚”，辽阔广大的样子。广大辽阔，无边无际。形容非常辽阔。","source":{"text":"三江五湖，洁汗无涯。","book":"《晋书·孙楚传》"}},{"id":29153,"word":"浩浩汤汤","pinyin":"hào hào shāng shāng","abbr":"hhss","explanation":"犹浩浩荡荡。指水势壮阔的样子。","source":{"text":"浩浩汤汤，横无际涯。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"大江洪河出三峡，下底柱，奔腾冲突于平原之地，～，莫之能御矣。","book":"清·薛福成《论俄罗斯立国之势》"},"similar":["沸沸汤汤"],"usage":"作谓语、定语；用于水等"},{"id":29154,"word":"浩浩漫漫","pinyin":"hào hào màn màn","abbr":"hhmm","explanation":"大雾无边无际的样子。","example":{"text":"江面被～的大雾笼罩，我们只好鸣笛前进。"},"usage":"作谓语、定语；用于景物描写"},{"id":29155,"word":"浩浩荡荡","pinyin":"hào hào dàng dàng","abbr":"hhdd","explanation":"原形容水势广大的样子。后形容事物的广阔壮大，或前进的人流声势浩大。","source":{"text":"浩浩荡荡，横夫际涯。","book":"《尚书·尧典》：“汤汤洪水方割，荡荡怀山襄陵，浩浩滔天。”宋·范仲淹《岳阳楼记》"},"example":{"text":"一时只见宁府大殡～，压地银山一般从北而至。","book":"清·曹雪芹《红楼梦》第十四回"},"similar":["汹涌澎湃","波澜壮阔","气壮山河"],"opposite":["风平浪静"],"usage":"作谓语、定语、状语；形容人流或水流等"},{"id":29156,"word":"浩然之气","pinyin":"hào rán zhī qì","abbr":"hrzq","explanation":"浩：盛大、刚直的样子；气：指精神。指浩大刚正的精神。","source":{"text":"我善养吾浩然之气。","book":"《孟子·公孙丑上》"},"example":{"text":"贫薄把人灰，且养就这～。","book":"元·汤显祖《牡丹亭·言怀》"},"similar":["光明正大","光明磊落","刚正不阿"],"usage":"作主语、宾语；指正大刚直的精神"},{"id":29157,"word":"浩然正气","pinyin":"hào rán zhèng qì","abbr":"hrzq","explanation":"正大刚直的气势。","source":{"text":"铿锵话语，浩然正气，使世贞为之所震，沉思良久，附耳低低说出一番话语。","book":"《金瓶梅传奇》第二回"},"example":{"text":"王朔《懵然无知》：“于德利一脸～，昂首走进招待所大门。”"},"similar":["浩然之气"],"usage":"作主语、宾语；指正大刚直的精神"},{"id":29158,"word":"浩若烟海","pinyin":"hào ruò yān hǎi","abbr":"hryh","explanation":"浩：广大，众多；烟海：茫茫大海。指广大繁多如茫茫烟海。","source":{"text":"其下陂湖汗漫，葭芦无畔，菱荷荇藻，蘅荃杜茝，众物居之，浩若烟海。","book":"宋·晁补之《北渚亭赋》"},"similar":["浩如烟海"],"usage":"作谓语、定语；用于书籍、学识等"},{"id":29159,"word":"浪声浪气","pinyin":"làng shēng làng qì","abbr":"lslq","explanation":"怪声怪调。","source":{"text":"没的浪声浪气，放屁拉臊，精扯淡的话，谁是你家奴才，收着你的包袱？","book":"清·丁耀亢《续金瓶梅》第八回"},"example":{"text":"他们男女混杂地聚在一处，倒也不一定是乱搞，可是或打麻将，或～地狂吼尖笑。","book":"刘心武《栖凤楼》十三"},"similar":["阴阳怪气"],"usage":"作谓语、宾语；指怪声怪气"},{"id":29160,"word":"浪子回头","pinyin":"làng zǐ huí tóu","abbr":"lzht","explanation":"浪子：二流子。不务正业的人改邪归正。","source":{"text":"有道是浪子回头金不换。","book":"《八十一梦·第32梦》"},"example":{"text":"他终于～，改邪归正了。"},"similar":["弃恶从善","迷途知返"],"opposite":["执迷不悟"],"usage":"作谓语；用于失足青年"},{"id":29161,"word":"浪子回头金不换","pinyin":"làng zǐ huí tóu jīn bù huàn","abbr":"lzhtjbh","explanation":"指不走正道的人改邪归正后极其可贵。","source":{"text":"有道是浪子回头金不换。","book":"《八十一梦·第32梦》"},"example":{"text":"常言道：～，我们得尽力帮助他。"},"similar":["败子回头金不换"],"usage":"作宾语、定语；用于夸奖有过失改正的人"},{"id":29162,"word":"浪子宰相","pinyin":"làng zǐ zǎi xiàng","abbr":"lzzx","explanation":"浪子：不务正业、专事游荡的人。指北宋徽宗时宰相李邦彦。","source":{"text":"邦彦尝自言赏尽天下花，踢尽天下球，做尽天下官，而都人亦呼邦彦为浪子宰相。","book":"《三朝北盟会编》"},"example":{"text":"因～李邦彦力主和议，与粘没喝讲定。","book":"清·陈忱《水浒后传》第21回"},"usage":"作宾语；指浪子回头成为名人"},{"id":29163,"word":"浪恬波静","pinyin":"làng tián bō jìng","abbr":"ltbj","explanation":"波浪不兴。比喻十分平静。","source":{"text":"任在芦花最深处。浪静风恬，又泛轻舟去。去到滩头遇俦侣。散唱狂歌鱼未取。","book":"宋·杜安世《蝶恋花》词"},"example":{"text":"～，指日到武冈之任。","book":"明·吾邱瑞《运甓记·辞亲赴任》"},"similar":["浪静风恬","风平浪静"],"usage":"作谓语、定语；用于风景描写"},{"id":29164,"word":"浪荡乾坤","pinyin":"làng dàng qián kūn","abbr":"ldqk","explanation":"浪荡：同“朗朗”，明朗；乾坤：天地。形容政治清明，天下太平。","source":{"text":"清平世界，浪荡乾坤，你怎么当街里打人。","book":"元·李文蔚《燕青博鱼》第一折"},"usage":"作谓语、定语；形容天下太平"},{"id":29165,"word":"浪蕊浮花","pinyin":"làng ruǐ fú huā","abbr":"lrfh","explanation":"指寻常花草。","source":{"text":"浮花浪蕊镇长有，才开还落瘴雾中。","book":"唐·韩愈《杏花》诗"},"example":{"text":"～不辨春，归来方识岁寒人。","book":"宋·苏轼《次韵王廷老退居见寄》"},"similar":["浮花浪蕊"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":29166,"word":"浪蝶游蜂","pinyin":"làng dié yóu fēng","abbr":"ldyf","explanation":"比喻态度轻佻好挑逗女子的男子。","source":{"text":"惊起娇莺语燕，打开浪蝶狂蜂。","book":"元·高明《琵琶记·牛小姐规劝侍俾》"},"example":{"text":"我若做～，老天呵，须教是裾马襟牛。","book":"明·高濂《玉簪记·姑阻》"},"similar":["浪蝶狂蜂"],"usage":"作宾语、定语；用于比喻句"},{"id":29167,"word":"浪蝶狂蜂","pinyin":"làng dié kuáng fēng","abbr":"ldkf","explanation":"轻狂的蜂蝶。比喻轻狂的男子。","source":{"text":"风景晴和，翩翩浪蝶狂蜂，阵阵游丝飞絮。","book":"明·梁辰鱼《浣纱记·效颦》"},"example":{"text":"心猿意马驰千里，～闹五更。","book":"《西湖佳话·雷峰怪迹》"},"similar":["狂蜂浪蝶"],"usage":"作宾语、定语；用于男性，指浪荡公子"},{"id":29168,"word":"浪费笔墨","pinyin":"làng fèi bǐ mò","abbr":"lfbm","explanation":"指人作品不好或文章过于繁琐。","example":{"text":"这篇文章纯粹是在～。"},"usage":"作宾语；用于批评别人的作品"},{"id":29169,"word":"浪迹天下","pinyin":"làng jì tiān xià","abbr":"ljtx","explanation":"浪迹：到处流浪。到处流浪，足迹遍天下。","source":{"text":"为同列者所谤，诏令归山，遂浪迹天下。","book":"宋·王楙《野客丛书·李白事说者不一》"},"example":{"text":"他打算一辈子就这样～。"},"similar":["浪迹天涯"],"opposite":["安居乐业"],"usage":"作谓语；指到处流浪"},{"id":29170,"word":"浪迹天涯","pinyin":"làng jì tiān yá","abbr":"ljty","explanation":"浪迹：到处流浪。到处流浪，足迹遍天下。","source":{"text":"为同列者所谤，诏令归山，遂浪迹天下。","book":"宋·李楙《野客丛书·李白事说者不一》"},"example":{"text":"我们做这体面憋脚生意，～，那社会上奇闻怪事，与此事相仿的，也说不尽许多。","book":"清·壮者《扫迷帚》"},"similar":["流离失所","颠沛流离"],"opposite":["安家落户","安居乐业","安营扎寨"],"usage":"作谓语、定语；形容人生飘泊"},{"id":29171,"word":"浪迹江湖","pinyin":"làng jì jiāng hú","abbr":"ljjh","explanation":"浪迹：到处流浪；江湖：泛指各地。到处漂泊，没有固定的住处。","source":{"text":"某不能甘于寒苦，且浪迹江湖。","book":"宋·张君房《云笈七签》卷一百十三"},"example":{"text":"一时未际，～。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"similar":["流离失所","颠沛流离","放浪江湖"],"opposite":["安家落户","安居乐业","安如泰山"],"usage":"作谓语、定语；形容人生飘泊"},{"id":29172,"word":"浪迹浮踪","pinyin":"làng jì fú zōng","abbr":"ljfz","explanation":"到外漫游，行踪不定。","source":{"text":"想当日恨冲冲，乱离间家业空，浪迹浮踪，水远山重。","book":"元·白朴《梧桐雨》第四折"},"usage":"作宾语、定语；用于生活"},{"id":29173,"word":"浪迹萍踪","pinyin":"làng jì píng zōng","abbr":"ljpz","explanation":"浪迹：四处流浪；萍踪：象浮萍一样，漂浮不定。形容踪迹漂泊不定，就象流水和浮萍一样。","source":{"text":"恨怱怱，萍踪浪影，风剪了玉芙蓉。","book":"明·汤显祖《牡丹亭》第二十出"},"example":{"text":"引见就有职业，不比从前～，东西无定了。","book":"清·夏敬渠《野叟曝言》第三十九回"},"similar":["浪迹浮踪","萍踪浪迹"],"usage":"作谓语、定语；指到处漫游，行踪不定"},{"id":29174,"word":"浪酒闲茶","pinyin":"làng jiǔ xián chá","abbr":"ljxc","explanation":"指风月场中的吃喝之事。","source":{"text":"你浪酒闲茶，卧柳眠花，半世禁害杀自矜自夸。","book":"元·张国宾《合汗衫》第二折"},"example":{"text":"恁的般受怕担惊，又不图甚～。","book":"元·王实甫《西厢记》第三本第三折"},"usage":"作谓语、宾语、定语；用于风月场"},{"id":29175,"word":"浪静风恬","pinyin":"làng jìng fēng tián","abbr":"ljft","explanation":"波浪不兴。比喻十分平静。","source":{"text":"任在芦花最深处。浪静风恬，又泛轻舟去。去到滩头遇俦侣。散唱狂歌鱼未取。","book":"宋·杜安世《蝶恋花》词"},"example":{"text":"是非海天惊地险，水云乡～。","book":"元·乔孟符《满庭芳·渔父词》"},"similar":["浪恬波静","风平浪静"],"usage":"作谓语、定语；用于风景描写"},{"id":29176,"word":"浮一大瓟","pinyin":"fú yī dà páo","abbr":"fydb","explanation":"浮：违反酒令被罚饮酒；瓟：同“匏”，匏瓜。原指罚饮一大杯酒。后指满饮一大杯酒。","source":{"text":"目击其先公之大节，具书于国史，先生之心，足以自慰，于介寿日，宜浮一大瓟者也。","book":"清·朱彝尊《黄征君寿序》"},"similar":["浮一大白","浮以大白"],"usage":"作谓语、定语；指满饮一大杯酒"},{"id":29177,"word":"浮一大白","pinyin":"fú yī dà bái","abbr":"fydb","explanation":"浮：违反酒令被罚饮酒；白：罚酒用的酒杯。原指罚饮一大杯酒。后指满饮一大杯酒。","source":{"text":"魏文侯与大夫饮酒，使公乘不仁为觞政，曰：‘饮不釂者，浮以大白。’","book":"汉·刘向《说苑·善说》"},"example":{"text":"得此喜信，胜听挞音，当～。","book":"清·曾朴《孽海花》第二十四回"},"similar":["浮以大白"],"usage":"作谓语、定语；指满饮一大杯酒"},{"id":29178,"word":"浮云富贵","pinyin":"fú yún fù guì","abbr":"fyfg","explanation":"浮云：飘浮的云彩。把富贵看成飘浮的云彩。比喻把金钱、地位看得很轻。","source":{"text":"不义而富且贵，于我如浮云。","book":"《论语·述而》"},"example":{"text":"自己一生契重名士，以为无不可招致之人，今日竟遇着一个铁君，真是～。","book":"清·刘鹗《老残游记》第六回"},"similar":["富贵如云"],"usage":"作谓语、宾语；指把金钱、地位看得很轻","story":["春秋时期，孔子带领弟子们周游列国，再次到达卫国时，卫国政局发生重大改变，卫出公赶走父亲而即位，大夫孔悝拿出一堆金币要孔子为卫出公正名，说卫出公名正言顺。孔子感觉到自己受了侮辱，说富贵与金钱对他来说像空中的浮云一样"]},{"id":29179,"word":"浮云惊龙","pinyin":"fú yún jīng lóng","abbr":"fyjl","explanation":"浮云：飘浮的云彩，这里指姿态飘逸。形容笔势轻快敏捷而有力。","source":{"text":"尤善隶书，为古今之冠，论者称其笔势，以为飘若浮云，矫若惊龙。","book":"《晋书·王羲之传》"}},{"id":29180,"word":"浮云朝露","pinyin":"fú yún zhāo lù","abbr":"fyzl","explanation":"漂浮的云彩，清晨的露水。比喻时光易逝，人生短促。","source":{"text":"人生若浮云朝露，宁俟长绳第景，实不愿之。","book":"《周书·萧大圜传》"},"usage":"作宾语；比喻时光易逝，人生短促"},{"id":29181,"word":"浮云翳日","pinyin":"fú yún yì rì","abbr":"fyyr","explanation":"浮云：漂浮在空中的云；翳：遮蔽。浮云遮住太阳。比喻奸佞之徒蒙蔽君主的光明，但时间不会太长。","source":{"text":"谗邪害公正，浮云翳白日。","book":"汉·孔融诗"},"similar":["浮云蔽日"],"usage":"作宾语、定语；用于比喻句"},{"id":29182,"word":"浮云蔽日","pinyin":"fú yún bì rì","abbr":"fybr","explanation":"浮云遮住太阳。原比喻奸佞之徒蒙蔽君主。后泛指小人当道，社会一片黑暗。","source":{"text":"故邪臣之蔽贤，犹浮云之障日月也。","book":"汉·陆贾《新语·慎微》"},"example":{"text":"莫道浮云终蔽日，严冬过尽绽春蕾。","book":"陈毅《赠同志》诗"},"similar":["浮云翳日"],"usage":"作宾语、补语；指小人当道，社会一片黑暗"},{"id":29183,"word":"浮以大白","pinyin":"fú yǐ dà bái","abbr":"fydb","explanation":"浮：违反酒令被罚饮酒；白：罚酒用的酒杯。原指罚饮一大杯酒。后指满饮一大杯酒。","source":{"text":"魏文侯与大夫饮酒，使公乘不仁为觞政，曰：‘饮不釂者，浮以大白。’","book":"汉·刘向《说苑·善说》"},"similar":["浮一大白","浮一大瓟"],"usage":"作谓语、定语；指满饮一大杯酒"},{"id":29184,"word":"浮光掠影","pinyin":"fú guāng lüè yǐng","abbr":"fgly","explanation":"水面的光和掠过的影子，一晃就消逝。比喻观察不细致，学习不深入，印象不深刻。","source":{"text":"浮光随日度，漾影逐波深。","book":"唐·禇亮《临高台》诗"},"example":{"text":"学问从实地上用功，议论自然确有根据；若～，中无成见，自然随波逐流，无所适从。","book":"清·李汝珍《镜花缘》第十八回"},"similar":["走马观花","浅尝辄止"],"opposite":["洞察秋毫","一丝不苟"],"usage":"作宾语、状语、定语；指印象不深"},{"id":29185,"word":"浮光略影","pinyin":"fú guāng lüè yǐng","abbr":"fgly","explanation":"比喻观察不细致，学习不深入，印象不深刻。同“浮光掠影”。","source":{"text":"沧浪论诗，止是浮光略影，如有所见，其实脚跟未曾点地。","book":"清·冯班《钝吟杂录·严氏纠谬》"},"similar":["浮光掠影"],"usage":"作宾语、状语、定语；指印象不深"},{"id":29186,"word":"浮光跃金","pinyin":"fú guāng yào jīn","abbr":"fgyj","explanation":"浮光：水面上反射的光；跃金：闪烁出的金光。指月光照在水面上闪烁出的金光。","source":{"text":"长烟一空，皓月千里，浮光跃金，静影沉璧。","book":"宋·范仲淹《岳阳楼记》"}},{"id":29187,"word":"浮出水面","pinyin":"fú chū shuǐ miàn","abbr":"fcsm","explanation":"指事物逐渐显露出来。","usage":"可用于新事物的诞生，原来隐蔽事物的暴露，以及通过比赛或评选而得出结果等。"},{"id":29188,"word":"浮名薄利","pinyin":"fú míng bó lì","abbr":"fmbl","explanation":"浮名：虚浮的名声；薄利：微薄的利益。形容名利微不足道。","source":{"text":"一杯洗涤无余，万事消磨去远，浮名薄利休羡。","book":"宋·赵师侠《扑蝴蝶》"},"similar":["淡薄名利"],"usage":"作谓语、宾语、定语；形容名利微不足道"},{"id":29189,"word":"浮名虚利","pinyin":"fú míng xū lì","abbr":"fmxl","explanation":"虚有的名声，空有的利益。指名利是空虚的东西。","source":{"text":"若肯要灰心学道，可致神仙，何苦要碌碌尘埃，甘为浮名虚利所驱逐也。","book":"明·冯梦龙《东周列国志》第八十七回"},"usage":"作主语、宾语、定语；用于口语"},{"id":29190,"word":"浮名虚誉","pinyin":"fú míng xū yù","abbr":"fmxy","explanation":"浮名：虚有的名声；虚誉：不实在的称誉。虚有的名声和不实在的称誉。","source":{"text":"欷歔，白发垂肩老更癯，空有些浮名虚誉，不能够补衮朝班，则落的抱瓮村居。","book":"明·桑绍良《独乐园》第三折"},"example":{"text":"他不想要～，要点实惠的东西。"},"usage":"作宾语；指虚名"},{"id":29191,"word":"浮图七级，重在合尖","pinyin":"fú tú qī jí，zhòng zài hé jiān","abbr":"ftqjzzhj","explanation":"浮图：佛塔；合尖：造好塔尖。比喻办成事情的关键在最后。","source":{"text":"为浮屠者，必合其尖。","book":"《新五代史·李菘传》"},"example":{"text":"～，为山九仞，功亏一篑。","book":"蔡东藩《民国通俗演义》第102回"},"usage":"作宾语、定语；用于做事","story":["后唐时期，唐明宗在朝会上要求百官推荐将领率军抵抗契丹的入侵，李菘举荐石敬瑭。石敬瑭早有反叛之心，对此心存感激，暗中派人对李菘说：“为浮屠者，必合其尖。”石敬瑭得到大军指挥权后就开始反唐，投降契丹成为“儿皇帝”"]},{"id":29192,"word":"浮声切响","pinyin":"fú shēng qiè xiǎng","abbr":"fsqx","explanation":"浮声：平声；切响：仄声。指古汉语中的平仄声。也泛指音韵的纤细低沉和洪亮高亢。","source":{"text":"夫五色相宣，八音协畅，由乎玄黄律吕，各物宜。欲使宫羽相变，低昂互节，若前有浮生，则后须切响。","book":"《宋书·谢灵运传论》"},"example":{"text":"然命意深切，用事精远，非止于～而已也。","book":"元·袁桷《清容居士集·书汤西楼诗后》"},"usage":"作宾语、定语；指古汉语中的平仄声"},{"id":29193,"word":"浮头滑脑","pinyin":"fú tóu huá nǎo","abbr":"fthn","explanation":"犹言油头滑脑。形容人轻浮狡猾。","source":{"text":"座中几个人，都是浮头滑脑的，没有甚么事可记。","book":"《二十年目睹之怪现状》第一○四回"},"similar":["油头滑脑"],"usage":"作谓语、定语、补语；用于为人"},{"id":29194,"word":"浮家泛宅","pinyin":"fú jiā fàn zhái","abbr":"fjfz","explanation":"泛：漂浮；宅：住所。形容以船为家，在水上生活，漂泊不定。","source":{"text":"愿为浮家泛宅，往来苕、霅间。","book":"《新唐书·张志和传》"},"example":{"text":"明太祖为惩罚叛逆，不准他们在岸上落脚，因而～在富春江上，以打鱼为生。","book":"高阳《清宫外史》下册"},"similar":["浪迹江湖"],"usage":"作宾语、定语；指浪迹江湖"},{"id":29195,"word":"浮寄孤悬","pinyin":"fú jì gū xuán","abbr":"fjgx","explanation":"浮：漂浮不定；寄：寄存；孤：孤独；悬：吊挂。漂浮似地悬挂着。形容做事情没有基础，花架子大。也指形势急迫，很危险。","source":{"text":"急之则怨，缓之则不用命，浮寄孤悬，形势销弱。","book":"唐·韩愈《与鄂州杨中丞书》"}},{"id":29196,"word":"浮岚暖翠","pinyin":"fú lán nuǎn cuì","abbr":"flnc","explanation":"浮岚：飘浮在山林间的雾气；暖翠：青翠的山色。形容山林美好的景色。","source":{"text":"欲令浮岚暖翠千万状，坐卧常对乎轩窗。","book":"样·欧阳修《庐山高》"}},{"id":29197,"word":"浮想联翩","pinyin":"fú xiǎng lián piān","abbr":"fxlp","explanation":"浮想：飘浮不定的想象；联翩：鸟飞的样子，比喻连续不断。指许许多多的想象不断涌现出来。","source":{"text":"浮藻联翩。","book":"晋·陆机《文赋》"},"example":{"text":"读六月三十日《人民日报》，余江县消灭了血吸虫。～，夜不能寐。","book":"毛泽东《七律二首·送瘟神·序》"},"similar":["思绪万千"],"usage":"作谓语、宾语、定语；形容思绪活跃"},{"id":29198,"word":"浮收勒折","pinyin":"fú shōu lè shé","abbr":"fsls","explanation":"用强迫手段额外征收。","source":{"text":"意甚决，是将奉旨浮收勒折矣。","book":"清·冯桂芬《江苏减赋记》"},"example":{"text":"酌留数成以为卫所增兵造船之用，则州县之～者，无可籍口。","book":"清·夏燮《中西纪事·江浙卫兵》"},"similar":["浮收勒索"],"usage":"作谓语、定语；用于剥削等"},{"id":29199,"word":"浮收勒索","pinyin":"fú shōu lè suǒ","abbr":"fsls","explanation":"用强迫手段额外征收。同“浮收勒折”。","source":{"text":"辛酉，以图思德劾苏墧浮收勒索，命袁守侗等严鞫之。","book":"《清史稿·高宗纪四》"},"similar":["浮收勒折"],"usage":"作谓语、定语；用于剥削等"},{"id":29200,"word":"浮文套语","pinyin":"fú wén tào yǔ","abbr":"fwty","explanation":"不疼不痒的客套话。","example":{"text":"请说一些实际的内容，少来一些～。"},"usage":"作主语、宾语、定语；用于说话或文章等"},{"id":29201,"word":"浮文巧语","pinyin":"fú wén qiǎo yǔ","abbr":"fwqy","explanation":"华丽而空泛的言词。","source":{"text":"宜人人自效，而虚谈废务，浮文妨要，恐非当今所宜。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"我是不相信他的～的。"},"similar":["浮语虚辞"],"usage":"作宾语、定语；指空泛的言词"},{"id":29202,"word":"浮来暂去","pinyin":"fú lái zàn qù","abbr":"flzq","explanation":"比喻来去无定。","source":{"text":"姨太太这几天浮来暂去，不能过来回老太太，今日饭后家去了。","book":"《红楼梦》第八八回"},"similar":["来来去去"],"usage":"作谓语、定语；用于行踪等"},{"id":29203,"word":"浮沉草野","pinyin":"fú chén cǎo yě","abbr":"fccy","explanation":"浪迹山野乡间，四处漂泊。","example":{"text":"他决心～，浪迹天涯。"},"usage":"作谓语、定语；用于生活"},{"id":29204,"word":"浮泛江海","pinyin":"fú fàn jiāng hǎi","abbr":"ffjh","explanation":"泛：泛舟。坐船在江河湖海中游玩。","source":{"text":"啸咏山林，浮泛江海。","book":"《晋书·谢安传论》"},"usage":"作谓语、宾语；指旅游"},{"id":29205,"word":"浮浪不经","pinyin":"fú làng bù jīng","abbr":"flbj","explanation":"浮浪：行为轻薄放荡；不经：不遵守成规定法。指行为轻浮，不守法纪。","source":{"text":"海内必以兄为浮浪不经之人。","book":"明·冯梦龙《警世通言·杜十娘怒沉百宝箱》"},"similar":["放荡不羁"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":29206,"word":"浮湛连蹇","pinyin":"fú zhàn lián jiǎn","abbr":"fzlj","explanation":"指宦海浮沉，遭遇坎坷。","source":{"text":"余自通籍后，浮湛连蹇，强半里居。","book":"清·钱谦益《黄子羽六十寿序》"},"usage":"作谓语、定语；用于人生"},{"id":29207,"word":"浮瓜沈李","pinyin":"fú guā shěn lǐ","abbr":"fgsl","explanation":"指以寒泉洗瓜果解渴。后代指消夏的生活。","source":{"text":"语出三国·魏·曹丕《与朝歌令吴质书》：“浮甘瓜於清泉，沈朱李於寒水。”亦作“浮瓜沉李”。"}},{"id":29208,"word":"浮瓜沉李","pinyin":"fú guā chén lǐ","abbr":"fgcl","explanation":"吃在冷水里浸过的瓜果。形容暑天消夏的生活。","source":{"text":"浮甘瓜于清泉，沉朱李于寒冰。","book":"三国·魏·曹丕《与朝歌令吴质书》"},"example":{"text":"这样时候，多少王孙公子雪藕调冰、～也不为过。","book":"明·凌濛初《初刻拍案惊奇》"},"similar":["沉李浮瓜"],"usage":"作宾语、补语、定语；形容暑天消夏的生活"},{"id":29209,"word":"浮生一梦","pinyin":"fú shēng yī mèng","abbr":"fsym","explanation":"浮生：世事无定，人生短暂。指人生就像短暂的梦幻。","source":{"text":"至理无言了，浮生一梦劳。清风朝复暮，四海自波涛。","book":"唐·李咸用《早秋游山寺》"},"similar":["浮生若梦"],"usage":"作宾语、定语；指人生就像短暂的梦幻"},{"id":29210,"word":"浮生切响","pinyin":"fú shēng qiè xiǎng","abbr":"fsqx","explanation":"指古汉语中的平仄声。"},{"id":29211,"word":"浮生如寄","pinyin":"fú shēng rú jì","abbr":"fsrj","explanation":"浮生：指人生变化不定。人生短暂虚浮无定，如同寄居世间。","source":{"text":"少年曰：‘浮生如寄，年少几何。’繁花正妍，黄叶又继，人间之恨，何啻千端。","book":"唐·郑哲《女鬼记·孟氏》"},"similar":["浮生若寄"],"usage":"作宾语、定语；用于人生"},{"id":29212,"word":"浮生若寄","pinyin":"fú shēng ruò jì","abbr":"fsrj","explanation":"浮生：虚浮的人生。人生虚浮，如同寄居在世间。","source":{"text":"浮生若寄，大渐弥留，遗诲子孙，庶几薄葬。","book":"唐·杨炯《原州百泉县令李君神道碑》"},"example":{"text":"～，年少几何，繁花正妍，黄叶又继，人间之恨，何啻千端，岂如且偷顷刻之欢也。","book":"唐·郑哲《女鬼记·孟氏》"},"similar":["浮生如寄"],"usage":"作宾语、定语；用于人生"},{"id":29213,"word":"浮生若梦","pinyin":"fú shēng ruò mèng","abbr":"fsrm","explanation":"浮生：空虚不实的人生；若：象。把人生当作短暂虚幻的梦境。","source":{"text":"其生若浮，其死若休。","book":"战国·宋·庄周《庄子·刻意》"},"example":{"text":"夫天地者，万物之逆旅也；光阴者，百代之过客也。而～，为欢几何。","book":"唐·李白《春夜宴从弟桃花园序》"},"similar":["浮生一梦"],"usage":"作宾语、定语；指人生就像短暂的梦幻"},{"id":29214,"word":"浮白载笔","pinyin":"fú bái zǎi bǐ","abbr":"fbzb","explanation":"浮：罚人饮酒；白：指专用来罚酒的大杯；浮白：指喝酒和干杯；载笔：拿着笔。一面喝酒，一面写作。旧时比喻文人的雅量和才气。","source":{"text":"集腋为裘，妄续幽冥之录；浮白载笔，仅成孤愤之书。","book":"清·蒲松龄《聊斋志异·自志》"},"usage":"作宾语、定语；用于文人"},{"id":29215,"word":"浮皮潦草","pinyin":"fú pí liáo cǎo","abbr":"fplc","explanation":"形容不扎实，不仔细。","example":{"text":"对于～的作风，我们要严肃处理。"},"similar":["肤皮潦草"],"opposite":["认真仔细"],"usage":"作谓语、定语；指不认真"},{"id":29216,"word":"浮石沉木","pinyin":"fú shí chén mù","abbr":"fscm","explanation":"比喻是非颠倒。","source":{"text":"夫众口之毁誉，浮石沉木，群邪所抑，以直为曲。","book":"汉·陆贾《新语·辨惑》"},"example":{"text":"文肃之股肱国本，眉目清流也，而不能免于～之口。","book":"清·钱谦益《王奉尝烟客七十寿序》"},"usage":"作宾语、定语；用于比喻句"},{"id":29217,"word":"浮称流说","pinyin":"fú chēng liú shuō","abbr":"fcls","explanation":"称：称引。广泛称引，丰博谈论。","source":{"text":"故为之浮称流说其所以能听，所以使学者孳孳以自几也。","book":"西汉·刘安《淮南子·要略》"},"usage":"作谓语、宾语；用于说话"},{"id":29218,"word":"浮笔浪墨","pinyin":"fú bǐ làng mò","abbr":"fblm","explanation":"指多余累赘的文字。","source":{"text":"知此，虽著述汗牛充栋，岂有浮笔浪墨耶？","book":"清·恽敬《答来卿》"},"example":{"text":"他的文章很精练，很少有～。"},"usage":"作宾语、定语；用于文章等"},{"id":29219,"word":"浮翠流丹","pinyin":"fú cuì liú dān","abbr":"fcld","explanation":"翠：青绿色；丹：朱红色。青绿、朱红的颜色在浮现和流动。形容色彩鲜明艳丽。","source":{"text":"浮翠流丹，倘复还于巨丽；撞昏击晓，实大警于沉冥。","book":"宋·陆游《安稳寺修钟楼疏》"},"usage":"作宾语、定语；用于色彩"},{"id":29220,"word":"浮而不实","pinyin":"fú ér bù shí","abbr":"febs","explanation":"形容知识浅薄，基础不扎实；形容作风浮泛，不深入不踏实。","source":{"text":"反过来‘嬉’字不作懒惰解释，要当作浮而不实的不敬来讲。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"他办事总是浮而不实的。"},"similar":["华而不实"],"opposite":["脚踏实地"],"usage":"作谓语、宾语；指不踏实"},{"id":29221,"word":"浮花浪蕊","pinyin":"fú huā làng ruǐ","abbr":"fhlr","explanation":"指寻常的花草。比喻轻浮的人。","source":{"text":"浮花浪蕊镇长有，才开还落瘴雾中。","book":"唐·韩愈《杏花》诗"},"example":{"text":"泛清香满棹秋，比～优游。","book":"元·乔吉《水仙子·菊舟》"},"similar":["浪蕊浮花"],"usage":"作宾语、定语；比喻轻浮的人"},{"id":29222,"word":"浮萍断梗","pinyin":"fú píng duàn gěng","abbr":"fpdg","explanation":"浮萍：浮在水上的萍草；断梗：折断的草木茎。比喻飘泊无定的浪子。","source":{"text":"博着个甚功名，教俺做浮萍浪梗，因此上意懒出豫章城。","book":"元·乔吉《扬州梦》"},"example":{"text":"到家时，养起头发，听凭父母择一头亲事，结果终身，再不作～，路柳墙花了。","book":"清·夏敬渠《野叟曝言》第十一回"},"similar":["浮萍浪梗"],"usage":"作宾语、定语；用于比喻句"},{"id":29223,"word":"浮萍浪梗","pinyin":"fú píng làng gěng","abbr":"fplg","explanation":"浮萍：浮在水上的萍草；浪梗：浪里的草木茎。比喻飘泊无定的浪子。","source":{"text":"博着个甚功名，教俺做浮萍浪梗，因此上意懒出豫章城。","book":"元·乔吉《扬州梦》"},"similar":["浮萍断梗"],"usage":"作宾语、定语；用于比喻句"},{"id":29224,"word":"浮言虚论","pinyin":"fú yán xū lùn","abbr":"fyxl","explanation":"浮夸的语言，虚饰的言论。指大话、空话。","source":{"text":"当制举之盛时，置学立师，以法相授，浮言虚论，披抉不穷。","book":"宋·叶适《水心集·水集·制科》"},"similar":["浮语虚辞"],"usage":"作主语、宾语、定语；用于说话等"},{"id":29225,"word":"浮词曲说","pinyin":"fú cí qū shuō","abbr":"fcqs","explanation":"浮：虚浮，不真实；曲：歪曲。虚浮不实的词句，歪曲不正的言论。","source":{"text":"凭陵风涛，纵横锋镝，今逾一纪矣，岂复以浮词曲说动其心哉！","book":"《清史稿·张煌言传》"},"usage":"作主语、宾语、定语；用于言语等"},{"id":29226,"word":"浮语虚辞","pinyin":"fú yǔ xū cí","abbr":"fyxc","explanation":"指大话、空话。","source":{"text":"在兵中十岁，所更非一，厌浮语虚辞耳。","book":"《东观汉记·隗嚣传》"},"similar":["大话连篇"],"usage":"作主语、宾语；指大话、空话"},{"id":29227,"word":"浮踪浪迹","pinyin":"fú zōng làng jì","abbr":"fzlj","explanation":"浮：飘浮；浪：流浪。飘浮不定的踪影，到处流浪的足迹。比喻四处飘泊，不安定的人或生活。","source":{"text":"似恁般妄作胡为，敢欺侮咱浮踪浪迹。","book":"元·王子一《误入桃园》第三折"},"example":{"text":"清·荑荻散人《玉娇梨》第15回：“我择婿数年，只有这个苏友白中意，却又～，无处去寻访。”"},"similar":["浮迹浪踪"],"opposite":["安居乐业"],"usage":"作宾语、定语；指不安定"},{"id":29228,"word":"浮迹浪踪","pinyin":"fú jì làng zōng","abbr":"fjlz","explanation":"指行踪不定。","source":{"text":"一任他浮迹浪踪，终须是有个相逢。","book":"明·陈铎《山坡羊·怨别》套曲"},"similar":["浮踪浪迹"],"usage":"作宾语、定语；指不安定"},{"id":29229,"word":"浴日补天","pinyin":"yù rì bǔ tiān","abbr":"yrbt","explanation":"这是指女娲炼五色石补天和羲和给太阳洗澡两个神话故事。后用来比喻人有战胜自然的能力。也形容伟大的功业。","source":{"text":"有羲和之国，有女子名曰羲和，方日浴于甘渊。","book":"《淮南子·览冥训》：“于是女娲炼五色石以补苍天。”又《山海经·大荒南经》"}},{"id":29230,"word":"浴血奋战","pinyin":"yù xuè fèn zhàn","abbr":"yxfz","explanation":"形容顽强地拼死战斗。","source":{"text":"战士们在这十五昼十五夜中，不是浴血奋战就是急行军转移。","book":"杜鹏程《保卫延安》第六章一"},"example":{"text":"全班战士，个个奋勇当先，冲下山去与敌人浴血奋战。"},"similar":["短兵相接","决一死战","背水一战"],"opposite":["相安无事","和平共处"],"usage":"作谓语、定语；指顽强"},{"id":29231,"word":"浴血战斗","pinyin":"yù xuè zhàn dòu","abbr":"yxzd","explanation":"浴血：浑身都是血。浑身是血还在奋勇战斗。形容顽强地拼死战斗。","source":{"text":"不但鼓舞了当时在共产党领导下浴血战斗的革命群众的士气，也使广大读者从书本联系到自己国家的现实，坚定了对革命的信仰。","book":"茅盾《向鲁迅学习》"},"example":{"text":"啊，这就是自己当年～的沙场、三十年来无时无刻不在怀恋向往的故地呵！","book":"尤凤伟《静静的疗养地》二"},"similar":["浴血奋战"],"usage":"作谓语、定语；指顽强"},{"id":29232,"word":"海不扬波","pinyin":"hǎi bù yáng bō","abbr":"hbyb","explanation":"扬：升起，翻腾。海上不起波浪。比喻天下太平无事。","source":{"text":"吾闻太平之世，海不扬波，安有今日。","book":"明·梅鼎祚《玉合记·枯海》"},"example":{"text":"～万国通，三吴闽浙各乘风。","book":"清·陈恭尹《饶歌》"},"similar":["风平浪静"],"usage":"作宾语、定语；比喻太平无事"},{"id":29233,"word":"海不波溢","pinyin":"hǎi bù bō yì","abbr":"hbby","explanation":"海上风平浪静，没有波浪。比喻平安无事。","source":{"text":"久矣，天之不迅风疾雨也，海之不波溢也，三年于兹也。意者中国殆有圣人，盍往朝之。","book":"汉·韩婴《韩诗外传》卷五"},"similar":["海不扬波","海波不惊"],"usage":"作宾语、定语；比喻太平无事"},{"id":29234,"word":"海中捞月","pinyin":"hǎi zhōng lāo yuè","abbr":"hzly","explanation":"比喻劳而无功，白费气力。","source":{"text":"临安府也没奈何，只得行个文书访拿，先前的两个轿夫，却又不知姓名住址，无影无踪，海中捞月，眼见得一个夫人送在别处去了。","book":"《初刻拍案惊奇》卷二七"},"example":{"text":"这点如不弄明了，简直等于是～一样了。","book":"郭沫若《中国古代社会研究》导论二"},"similar":["海底捞月"],"usage":"作宾语、定语；指白费力气"},{"id":29235,"word":"海内存知己，天涯若比邻","pinyin":"hǎi nèi cún zhī jǐ，tiān yá ruò bǐ lín","abbr":"hnczjtyrbl","explanation":"四海之内有知己朋友，即使远在天边，也感觉象邻居一样近。","source":{"text":"与君离别意，同是宦游人；海内存知己，天涯若比邻。无为在歧路，儿女共沾巾。","book":"唐·王勃《杜少府之任蜀洲》"},"example":{"text":"～，我们心灵会互相感应的。"},"similar":["莫逆之交"],"opposite":["割席分座"],"usage":"作宾语；指朋友"},{"id":29236,"word":"海内无双","pinyin":"hǎi nèi wú shuāng","abbr":"hnws","explanation":"海内：四海之内，旧指中国，现亦指世界各地。四海之内独一无二。","source":{"text":"好学乐道之效明白甚矣，自以为智能海内无双，则可谓博闻。","book":"汉·东方朔《答客难一首》"},"example":{"text":"论富贵京都为上，数繁华～，风流人物貌堂堂。","book":"元·胡用和《粉蝶儿·题金陵景》"},"similar":["国士无双"],"opposite":["比比皆是"],"usage":"作宾语、定语；指国内第一"},{"id":29237,"word":"海内澹然","pinyin":"hǎi nèi dàn rán","abbr":"hndr","explanation":"海内：四海之内；澹然：安静从容的样子。形容国家安定，生活秩序正常。","source":{"text":"海内澹然，永亡边城之灾，金革之患。","book":"《汉书·扬雄传》"},"similar":["天下太平"],"opposite":["海内鼎沸"],"usage":"作谓语、定语；用于局势等"},{"id":29238,"word":"海内鼎沸","pinyin":"hǎi nèi dǐng fèi","abbr":"hndf","explanation":"鼎沸：比喻局势不安定，如同鼎水沸腾。形容天下大乱。","source":{"text":"今海内鼎沸，刘氏微弱，吾家四世公辅，百姓所归，欲应天顺民，于诸何如？","book":"《后汉书·袁术传》"},"example":{"text":"黄巾起来二十余年，～。","book":"《三国志·魏志·邢颙传》"},"similar":["天下大乱"],"opposite":["太平盛世"],"usage":"作谓语、定语、状语；形容天下大乱"},{"id":29239,"word":"海北天南","pinyin":"hǎi běi tiān nán","abbr":"hbtn","explanation":"形容万里之遥，相距极远。亦形容地区各异。","source":{"text":"昔年意气结群英，几度朝回一字行。海北天南零落尽，两人相见洛阳城。","book":"唐·刘禹锡《送别四十六首·洛中逢韩七中丞之吴兴口号五首》"},"example":{"text":"～各自行，不劳鱼雁通消息。","book":"宋·释普济《五灯会元·文德延禅师法嗣》"},"similar":["天南海北"],"usage":"作宾语；形容距离遥远"},{"id":29240,"word":"海啸山崩","pinyin":"hǎi xiào shān bēng","abbr":"hxsb","explanation":"大海汹涌呼啸，高山崩裂倒塌。形容来势凶猛急速。","source":{"text":"楚兵人人耀武，个个扬威，分明似海啸山崩，天摧地塌。","book":"明·冯梦龙《东周列国志》第五十四回"},"example":{"text":"冯夷为虐，～，毒龙战野，其目千灯。","book":"清·黄宗羲《大方伯马公救菑颂》"},"similar":["山崩海啸"],"usage":"作谓语、宾语；形容来势凶猛"},{"id":29241,"word":"海外东坡","pinyin":"hǎi wài dōng pō","abbr":"hwdp","explanation":"东坡：北宋文学家苏轼的号。苏轼被贬于惠州、儋州（今海南岛儋县）其间，有人谣传他已经死去。比喻说人已死的谣传。","source":{"text":"苏长公在惠州，天下传其已死。","book":"明·何良俊《世说新语补·排调下》"}},{"id":29242,"word":"海外奇谈","pinyin":"hǎi wài qí tán","abbr":"hwqt","explanation":"海外：中国以外；奇谈：奇怪的说法。比喻没有根据的，荒唐的言论或传闻。","source":{"text":"瑞为牍，令兵马司申之于给事钟宇淳。宇淳批其牍尾曰：‘海外奇谈。’","book":"明·沈德符《万历野获编补遗·台省·台疏讥谑》"},"example":{"text":"这明明白白的欺侮中国读者，信口开河的来乱讲～。","book":"鲁迅《二心集·关于翻译的通信》"},"similar":["道听途说","奇谈怪论","不经之谈"],"opposite":["确凿不移","言之有据"],"usage":"作宾语、定语；指奇闻"},{"id":29243,"word":"海外扶余","pinyin":"hǎi wài fú yú","abbr":"hwfy","explanation":"扶余：传说中的古国名，有说是今天的日本，也有说是今天的南美洲。比喻遥远的与世隔绝的异国他乡。","source":{"text":"海外扶余，隐然复有世界。","book":"唐·杜光庭《虬髯客传》中有虬髯客在东南的扶余国称王的故事。明·张岱《与王白岳》"},"example":{"text":"虽归英王统治之下，然鞭长莫及，无异～。","book":"孙中山《心理建设》第六章"},"similar":["扶余海外"],"usage":"作主语、宾语；指外国"},{"id":29244,"word":"海宴河清","pinyin":"hǎi yàn hé qīng","abbr":"hyhq","explanation":"沧海波平，黄河水清。形容国内安定，天下太平。","source":{"text":"旋闻海宴河清，远播民舒物泰。","book":"五代·欧阳熙《龙寿院光化大师碑铭》"},"example":{"text":"现在就是～的时候，我们得好好珍惜今天的安定局面。"},"similar":["河清海宴"],"usage":"作谓语；指天下太平"},{"id":29245,"word":"海屋添筹","pinyin":"hǎi wū tiān chóu","abbr":"hwtc","explanation":"海屋：寓言中堆存记录沧桑变化筹码的房间；筹：筹码。旧时用于祝人长寿。","source":{"text":"海水变桑田时，吾辄下一筹，迩来吾筹已满十间屋。","book":"宋·苏轼《东坡志林》卷二"},"example":{"text":"照定制，凡遇万寿，应该唱搬演神仙故事的“九九大庆”，无非～，麻姑献寿之类。","book":"高阳《清宫外史》下册"},"similar":["海屋筹添","寿比南山"],"usage":"作宾语；用于祝人长寿","story":["传说古代有三个老人相遇，他们互相询问年龄。一个说自己的年龄不记得了，只记得少年时与盘古有交情。一个说他看见海水变桑田就添一个筹码，如今他的筹码可装十间屋子。另一个则说他吃过的蟠桃核丢到昆仑山下，如今长得与昆仑一样高了"]},{"id":29246,"word":"海屋筹添","pinyin":"hǎi wū chóu tiān","abbr":"hwct","explanation":"原指长寿，后为祝寿之词。","source":{"text":"尝有三老人相遇，或问之年……一人曰：‘海水变桑田时，吾辄下一筹，尔（迩）来吾筹已满十间屋。’","book":"宋苏轼《东坡志林·三老语》"},"example":{"text":"庄庭椿老枝偏盛，～数倍增。","book":"元·沈禧《一枝花·寿人八十》"},"similar":["海屋添筹"],"usage":"作宾语；用于祝人长寿"},{"id":29247,"word":"海岱清士","pinyin":"hǎi dài qīng shì","abbr":"hdqs","explanation":"海岱：指东海与泰山之间的地方，引申为四海之内。指海内的清正廉洁的人。","source":{"text":"人所应有，其不必有；人所应无，己不必无。真海岱清士。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":29248,"word":"海岳高深","pinyin":"hǎi yuè gāo shēn","abbr":"hygs","explanation":"海：大海；岳：高山。像大海一样深，像山岳那样高。","source":{"text":"由道究千变而得一，乘薄俗而居老，如海岳高深，青分孤岛。","book":"唐·窦氏《述书赋》上"}},{"id":29249,"word":"海市蜃楼","pinyin":"hǎi shì shèn lóu","abbr":"hssl","explanation":"蜃：大蛤。原指海边或沙漠中，由于光线的反向和折射，空中或地面出现虚幻的楼台城郭。现多比喻虚无缥渺的事物。","source":{"text":"此海市蜃楼比耳，岂长久耶？","book":"《史记·天官书》：“海旁蜃气象楼台，广野气成宫阙然。”《隋唐遗事》"},"example":{"text":"第五出是达摩带着徒弟过江回去，正扮出～，好不热闹。","book":"清·曹雪芹《红楼梦》第八十五回"},"similar":["空中楼阁","子虚乌有","虚无飘渺"],"usage":"作主语、宾语、定语；指不实际存在的事物"},{"id":29250,"word":"海底捞月","pinyin":"hǎi dǐ lāo yuè","abbr":"hdly","explanation":"到水中去捞月亮。比喻去做根本做不到的事，只能白费力气。","source":{"text":"镜里看形见不难，水中捉月争拈得？","book":"唐·释元觉《永嘉证道歌》"},"example":{"text":"访拿先前的两个轿夫，却又不知姓名住址，有影无踪，～。","book":"明·凌濛初《初刻拍案惊奇》卷二十七"},"similar":["徒劳无力","海底捞针","枉费心机"],"opposite":["立杆见影","行之有效"],"usage":"作宾语；指白费力气"},{"id":29251,"word":"海底捞针","pinyin":"hǎi dǐ lāo zhēn","abbr":"hdlz","explanation":"在大海里捞一根针。形容很难找到。","source":{"text":"俊儿夫似海内寻针，姻缘事在天数临，无缘分怎的消任？直耽搁到如今。","book":"元·吴昌龄《二郎收猪八戒》第三折"},"example":{"text":"一面点起民壮，分头追捕，多应是～，那寻一个？","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"similar":["海底捞月","大海捞针"],"opposite":["行之有效","易如反掌"],"usage":"作宾语；形容很难找到"},{"id":29252,"word":"海底眼","pinyin":"hǎi dǐ yǎn","abbr":"hdy","explanation":"比喻事情的底细、内幕或隐秘。","source":{"text":"小妖见说着海底眼，更不疑惑，把行者认作一家人。","book":"明·吴承恩《西游记》第三十四回"},"example":{"text":"见他脸红黄不定，晓得有些～，且不说破，竟叫人寻将牛黑子来，把来拴住，一径投县里来。","book":"明·凌濛初《初刻拍案惊奇》卷三十六"}},{"id":29253,"word":"海怀霞想","pinyin":"hǎi huái xiá xiǎng","abbr":"hhxx","explanation":"本托意仙游。后指远游隐居之思。","source":{"text":"唐·李白《秋夕书怀》诗“海怀结沧洲，霞想游赤城。”"},"example":{"text":"解兰焚芰非吾事，只是～春水涨。","book":"清·朱彜尊《迈陂塘·题王咸中坞山房图》"},"usage":"作宾语、定语；用于生活等"},{"id":29254,"word":"海晏河清","pinyin":"hǎi yàn hé qīng","abbr":"hyhq","explanation":"晏：平静。黄河水清了，大海没有浪了。比喻天下太平。","source":{"text":"河清海晏，时和岁丰。","book":"唐·薛逢《九日曲池游眺》：“正当海晏河清日，便是修文偃武时。”唐·郑锡《日中有王子赋》"},"example":{"text":"如今～，重逢太平，重乐太平。","book":"元·施惠《幽闺记·和寇还朝》"},"similar":["太平盛世","国泰民安","海宴河澄"],"opposite":["海水群飞","兵荒马乱","鸡犬不宁"],"usage":"作谓语、宾语；比喻太平盛世"},{"id":29255,"word":"海晏河澄","pinyin":"hǎi yàn hé chéng","abbr":"hyhc","explanation":"晏：平静；河：黄河；澄：清澈。黄河水清，大海波平浪静。比喻天下太平。","source":{"text":"海晏河澄二百年，那信鲸鲵吞士女。","book":"清·魏源《秦淮灯船引》"},"similar":["海晏河清"],"usage":"作谓语、宾语、定语；比喻太平盛世"},{"id":29256,"word":"海枯石烂","pinyin":"hǎi kū shí làn","abbr":"hksl","explanation":"海水干涸、石头腐烂。形容历时久远。比喻坚定的意志永远不变。","source":{"text":"老我重来，海干石烂，那复断碑残础。","book":"宋·王奕《法曲献仙音·和朱静翁青溪词》"},"example":{"text":"汝要说我降，除非～。","book":"明·罗贯中《三国演义》第四十七回"},"similar":["地久天长","海誓山盟","矢志不移"],"opposite":["见异思迁","朝秦暮楚","朝三暮四"],"usage":"作定语、宾语、状语；多用于盟誓"},{"id":29257,"word":"海枯见底","pinyin":"hǎi kū jiàn dǐ","abbr":"hkjd","explanation":"海枯：海水干涸。海水干涸之后终究可以看见海底，但并非容易事。用以比喻人心难测。","source":{"text":"海枯终见底，人死不知心。","book":"唐·杜荀鹤《感遇》"},"example":{"text":"～，人死不知心。","book":"清·翟灏《通俗编·地理》"},"usage":"作宾语、定语；用于比喻句"},{"id":29258,"word":"海桑陵谷","pinyin":"hǎi sāng líng gǔ","abbr":"hslg","explanation":"沧海变桑田，山陵变深谷，比喻世事变迁极大。","source":{"text":"海桑陵谷又经三百秋，以手摩挱尚如故。","book":"清·朱彜尊《玉带生歌》"},"example":{"text":"～幻乾坤，春梦模糊不见痕。","book":"清·南荃外史《叹老》"},"similar":["沧海桑田"],"usage":"作宾语、定语；形容世事变化很大"},{"id":29259,"word":"海水不可斗量","pinyin":"hǎi shuǐ bù kě dǒu liáng","abbr":"hsbkdl","explanation":"海水是不可以用斗去量的。比喻不可根据某人的现状就低估他的未来。","source":{"text":"太山不可丈尺也，江海不可斗斛也。","book":"《淮南子·泰族训》"},"example":{"text":"凡人不可以貌相，～。","book":"元·无名氏《小尉迟》第二折"},"similar":["海水难量"],"usage":"作主语、宾语；常与“人不可貌相”连用"},{"id":29260,"word":"海水桑田","pinyin":"hǎi shuǐ sāng tián","abbr":"hsst","explanation":"犹沧海变桑田。比喻世事变迁很大。","source":{"text":"海水桑田几翻覆，中间此桃四五熟。","book":"唐·韦应物《汉武帝杂歌》之一"},"example":{"text":"～几变迁，桃花依旧郡城边。","book":"清·厉鹗《东城杂记·东皋隐者》"},"similar":["海桑陵谷","沧海桑田"],"opposite":["亘古不变"],"usage":"作宾语、定语；形容世事变化很大"},{"id":29261,"word":"海水群飞","pinyin":"hǎi shuǐ qún fēi","abbr":"hsqf","explanation":"海水飞腾，狂乱地涌起。比喻国家不安宁。","source":{"text":"海水群飞，终不可语也。","book":"汉·扬雄《太玄经·剧》"},"example":{"text":"自永安以来，魏室大坏，～，天星乱动。","book":"北周·庾信《周使持节大将军广化郡开公丘乃敦崇传》"},"similar":["海内鼎沸"],"opposite":["海不扬波"],"usage":"作谓语、定语；指国家局势"},{"id":29262,"word":"海水难量","pinyin":"hǎi shuǐ nán liáng","abbr":"hsnl","explanation":"海水是不可以去量的。比喻不可根据某人的现状就低估他的未来。","source":{"text":"太山不可丈尺也，江海不可斗斛也。","book":"《淮南子·泰族训》"},"example":{"text":"看从来～也，任你纷纷白眼多。","book":"明·胡文焕《群音类选·清腔类·前腔二首》"},"similar":["海水不可斗量"],"usage":"作定语、宾语；指不能低估别人"},{"id":29263,"word":"海沸山崩","pinyin":"hǎi fèi shān bēng","abbr":"hfsb","explanation":"海水沸腾，山石崩塌。比喻变化巨大。","source":{"text":"我呵喝一喝骨碌碌的海沸山崩，瞅一瞅赤力力的天摧地塌。","book":"元·无名氏《昊天塔》第二折"},"similar":["海沸山摇","海沸山裂"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":29264,"word":"海沸山摇","pinyin":"hǎi fèi shān yáo","abbr":"hfsy","explanation":"比喻声势或力量极大。同“海沸山裂”。","source":{"text":"小圣啸起大风，刮的来天昏地暗，海沸山摇。","book":"明·无名氏《那吒三变》第三折"},"example":{"text":"明·伏雌教主《醋葫芦》第十回：“～的嚷得好不热闹。”"},"similar":["海沸山裂","海沸山崩"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":29265,"word":"海沸山裂","pinyin":"hǎi fèi shān liè","abbr":"hfsl","explanation":"海水沸腾，山石崩裂。比喻声势或力量极大。亦作“海沸山摇”。","source":{"text":"坐谈间早辨龙蛇，把袖里乾坤做梦里蝴蝶，狠的人海沸山裂，不禁支发，空跌双靴。","book":"明·张凤翼《红拂记·髯客海归》"},"similar":["海沸山崩","海沸山摇"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":29266,"word":"海沸江翻","pinyin":"hǎi fèi jiāng fān","abbr":"hfjf","explanation":"大海沸腾，江河翻滚。比喻声势或力量极大。","source":{"text":"怒时节海沸江翻，恼时节天昏地惨。","book":"明·无名氏《那吒三变》第四折"},"similar":["海沸波翻","海沸河翻"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":29267,"word":"海沸河翻","pinyin":"hǎi fèi hé fān","abbr":"hfhf","explanation":"比喻声势或力量极大。同“海沸江翻”。","source":{"text":"抵多少雷轰电转，可正是海沸河翻。","book":"清·洪昇《长生殿·合围》"},"similar":["海沸波翻","海沸江翻"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":29268,"word":"海沸波翻","pinyin":"hǎi fèi bō fān","abbr":"hfbf","explanation":"比喻声势或力量极大。同“海沸江翻”。","source":{"text":"人喧呼海沸波翻，马嘶喊山崩地裂。","book":"《金瓶梅词话》第七二回"},"similar":["海沸河翻","海沸江翻"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":29269,"word":"海波不惊","pinyin":"hǎi bō bù jīng","abbr":"hbbj","explanation":"海面平静，不起波浪。比喻平安无事。","source":{"text":"开元太平，海波不惊，乃驾神都，东人夸荣。","book":"唐·李庾《东都赋》"},"similar":["海不扬波","海不波溢"],"usage":"作宾语、定语；用于比喻句"},{"id":29270,"word":"海涯天角","pinyin":"hǎi yá tiān jiǎo","abbr":"hytj","explanation":"犹言天涯海角。指僻远的地方。","source":{"text":"雨冷云昏日暮，海涯天角轻衾。","book":"明·刘基《声声慢·咏愁》词"},"similar":["天涯海角","海角天涯","海角天隅"],"usage":"作主语、宾语；指偏僻遥远的地方"},{"id":29271,"word":"海涵地负","pinyin":"hǎi hán dì fù","abbr":"hhdf","explanation":"如海之能包容，地之能负载。比喻才能特异。","source":{"text":"公具海涵地负之才，出其余力为词章，已足以弁冕群贤，推倒一世。","book":"宋·陈亮《笏记》：“皇帝陛下，日照天临，海涵地负。”清·王韬《重刻〈曾文正公文集〉叙》"},"example":{"text":"至于杜之～，韩之鳌掷鲸呿，尚有所未逮。","book":"清·宋荦《漫堂说诗》三"},"usage":"作定语；用于比喻句"},{"id":29272,"word":"海涸石烂","pinyin":"hǎi hé shí làn","abbr":"hhsl","explanation":"犹海枯石烂。形容历时久远。比喻坚定的意志永远不变。","source":{"text":"海涸石烂情无改，正欲归坐续言词。","book":"清·秋瑾《精卫石》第二回"},"example":{"text":"千人心上千人恨，～难罢休。","book":"《中国歌谣资料·千人心上千人恨》"},"similar":["海枯石烂"],"usage":"作谓语、宾语、分句；用于盟誓等"},{"id":29273,"word":"海盟山咒","pinyin":"hǎi méng shān zhòu","abbr":"hmsz","explanation":"犹言海誓山盟。","source":{"text":"海盟山咒，都随一江逝水东流。","book":"明·梁辰鱼《醉太平·暮愁闺怨》套曲"},"example":{"text":"他们的～已随风而去"},"similar":["海誓山盟","海约山盟"],"usage":"作谓语、宾语、定语；用于男女爱情等"},{"id":29274,"word":"海立云垂","pinyin":"hǎi lì yún chuí","abbr":"hlyc","explanation":"形容文辞气魄极大。","source":{"text":"九天之云下垂，四海之水皆立。","book":"唐·杜甫《朝献太清宫赋》"},"usage":"作谓语、定语；用于文辞等"},{"id":29275,"word":"海约山盟","pinyin":"hǎi yuē shān méng","abbr":"hysm","explanation":"指男女相爱时立下的誓言，爱情要象山和海一样永恒不变。同“海誓山盟”。","source":{"text":"问海约山盟何时，镇教人，目断魂飞。","book":"宋·欧阳修《解仙佩》"},"similar":["海誓山盟","海盟山咒"],"usage":"作谓语、宾语、定语；用于男女爱情等"},{"id":29276,"word":"海纳百川","pinyin":"hǎi nà bǎi chuān","abbr":"hnbc","explanation":"纳：容纳，包容。大海可以容得下成百上千条江河之水。比喻包容的东西非常广泛，而且数量很大。","source":{"text":"方寸之心，如海之纳百川也，言其包含广也。","book":"晋·袁宏《三国名臣序赞》：“形器不存，方寸海纳。”李周翰注"},"usage":"作宾语、定语；用于人的心怀等"},{"id":29277,"word":"海翁失鸥","pinyin":"hǎi wēng shī ōu","abbr":"hwso","explanation":"翁：老人。在海边居住的那个老翁没有捉取到海鸥。比喻人如果怀有私心，就会失去朋友的信任和情谊。","source":{"text":"海上之人有好鸥鸟者，每旦之海上，从鸥鸟游，鸥鸟之至者，百住而不止。其父曰：‘吾闻鸥鸟皆从汝游，汝取来吾玩之。’明日之海上，鸥鸟舞而不下也。","book":"《列子·黄帝》"}},{"id":29278,"word":"海角天涯","pinyin":"hǎi jiǎo tiān yá","abbr":"hjty","explanation":"形容极远的地方，或彼此相隔极远。","source":{"text":"春生何处暗周游，海角天涯遍始休。","book":"唐·白居易《浔阳春·春生》诗"},"example":{"text":"人民法庭早安排，～难逃避。","book":"陈毅《渡黄河作歌》"},"similar":["海角天隅"],"opposite":["近在咫尺"],"usage":"作主语、宾语；指偏僻遥远的地方"},{"id":29279,"word":"海角天隅","pinyin":"hǎi jiǎo tiān yú","abbr":"hjty","explanation":"形容极远的地方，或彼此相隔极远。同“海角天涯”。","source":{"text":"海角天隅，须有日再完整。","book":"元·张好古《张生煮海》第四折"},"similar":["海角天涯","海涯天角"],"usage":"作主语、宾语；指偏僻遥远的地方"},{"id":29280,"word":"海誓山盟","pinyin":"hǎi shì shān méng","abbr":"hssm","explanation":"指男女相爱时立下的誓言，爱情要象山和海一样永恒不变。","source":{"text":"别泪没些些，海誓山盟总是赊。","book":"宋·辛弃疾《南乡子·赠妓》"},"example":{"text":"非是我夸清正，只为他星前月下，亲曾设～。","book":"元·石君宝《曲江池》第三折"},"similar":["地久天长","坚定不移","始终不渝"],"opposite":["朝三暮四","水性杨花","见异思迁"],"usage":"作谓语、宾语、定语；用于男女爱情"},{"id":29281,"word":"海说神聊","pinyin":"hǎi shuō shén liáo","abbr":"hssl","explanation":"漫无边际的胡吹乱谈。","source":{"text":"我呢，要请老兄多多恕罪，从此戒烟戒酒，戒牌戒棋，海说神聊，我也再是奉陪不起。","book":"王蒙《友人和烟》"},"example":{"text":"我不想跟你～浪费时间。"},"similar":["谈天说地"],"usage":"作谓语、宾语；指胡吹乱谈"},{"id":29282,"word":"海错江瑶","pinyin":"hǎi cuò jiāng yáo","abbr":"hcjy","explanation":"海错：指海产品种类繁多，后用以指海味；江瑶：蚌属，肉不能食，但前后两柱味美，俗称“江瑶柱”。泛指美味佳肴。","source":{"text":"山毛海错，事同于腐鼠。","book":"南朝·梁·沈约《究竟慈悲论》"},"example":{"text":"有～玉浆液。","book":"清·孔尚任《桃花扇·访翠》"},"similar":["山珍海味"],"usage":"作宾语、主语、定语；指美味"},{"id":29283,"word":"海阔从鱼跃，天空任鸟飞","pinyin":"hǎi kuò cóng yú yuè，tiān kōng rèn niǎo fēi","abbr":"hkcyytkrnf","explanation":"阔：宽广。大海辽阔随鱼跳跃，天空空旷任鸟飞翔。形容无牵无挂，自由自在。比喻可充分施展抱负。","source":{"text":"大海从鱼跃，长空任鸟飞。","book":"宋·阮阅《诗话总龟》前集引《古今诗话》"},"example":{"text":"这四个人得了这道赦书，～，从鹊华桥发脚，由黑虎庙到了贡院里边，毕进指点着前后看了一遍。","book":"清·西周生《醒世姻缘传》第37回"},"usage":"作宾语、定语；用于书面语"},{"id":29284,"word":"海阔天空","pinyin":"hǎi kuò tiān kōng","abbr":"hktk","explanation":"象大海一样辽阔，象天空一样无边无际。形容大自然的广阔。比喻言谈议论等漫无边际，没有中心。","source":{"text":"青鸾脉脉西飞去，海阔天高不知处。","book":"唐·刘氏瑶《暗离别》诗"},"example":{"text":"人们总羡慕～，以为一片茫茫，无边无界，必然大有可观。","book":"朱自清《飞》"},"similar":["广阔天地","无边无际","东拉西扯"],"opposite":["弹丸之地","一隅之地","丝丝入扣"],"usage":"作谓语、宾语、状语；形容空间广阔"},{"id":29285,"word":"海阔天高","pinyin":"hǎi kuò tiān gāo","abbr":"hktg","explanation":"比喻天地广阔，征程遥远。","source":{"text":"青鸾脉脉西飞去，海阔天高不知处。","book":"唐·刘氏瑶《杂曲歌辞·暗别离》"},"example":{"text":"鸿鹄冥冥乌鹊暮，～，翼短迷征路。","book":"明·刘基《苏幕遮·次韵和刘宗保》词"},"similar":["海阔天空"],"usage":"作谓语、宾语、状语；形容空间广阔"},{"id":29286,"word":"浸微浸消","pinyin":"jìn wēi jìn xiāo","abbr":"jwjx","explanation":"浸：渐渐；微：衰败；消：消失。逐渐衰微而至于消失。","source":{"text":"上嘉唐虞，下悼桀纣，浸微浸灭浸明浸昌之道，虚心以改。","book":"《汉书·董仲舒传》"},"example":{"text":"～，释然而溃。","book":"宋·苏洵《审势》"},"similar":["浸微浸灭"],"opposite":["浸明浸昌"],"usage":"作谓语、定语；用于社会局面"},{"id":29287,"word":"浸微浸灭","pinyin":"jìn wēi jìn miè","abbr":"jwjm","explanation":"浸：渐渐；微：衰败；灭：消灭。逐渐衰微而至于消失。","source":{"text":"上嘉唐虞，下悼桀纣，浸微浸灭浸明浸昌之道，虚心以改。","book":"《汉书·董仲舒传》"},"example":{"text":"汉、唐末世，朋党相确，小人在位，然犹有君子扶持迁延，～。","book":"《宋史·王宇附传》"},"similar":["浸微浸消"],"opposite":["浸明浸昌"],"usage":"作谓语、定语；用于社会局面"},{"id":29288,"word":"浸明浸昌","pinyin":"jìn míng jìn chāng","abbr":"jmjc","explanation":"浸：渐渐；明：显明；昌：兴盛，繁荣。逐渐明显至于昌盛。","source":{"text":"上嘉唐虞，下悼桀纣，浸微浸灭浸明浸昌之道，虚心以改。","book":"《汉书·董仲舒传》"},"example":{"text":"～，不可不循，浸微浸灭，不可不慎。","book":"《南齐书·崔慧景传》"},"opposite":["浸微浸灭"],"usage":"作谓语、定语；用于社会局面"},{"id":29289,"word":"浸润之谮","pinyin":"jìn rùn zhī zèn","abbr":"jrzz","explanation":"比喻暗中诽谤别人的坏话。","source":{"text":"浸润之谮，肤受之诉，不行焉，可谓明也已矣。","book":"春秋·鲁·孔丘《论语·颜渊》"},"example":{"text":"时有言语，轻而易信，～，为患特深。","book":"唐·吴兢《贞观政要·公平》"},"usage":"作宾语；指中伤他人的谗言逐渐发生作用"},{"id":29290,"word":"涂不拾遗","pinyin":"tú bù shí yí","abbr":"tbsy","explanation":"涂：通“途”，道路。路上有失物，无人拾取。形容社会风气好。","source":{"text":"与闻国政三月，粥羔豚者弗饰贾：男女行者别于途；涂不拾遗。","book":"西汉·司马迁《史记·孔子世家》"},"similar":["道不拾遗"],"usage":"作谓语、定语、状语；指好的社会风气"},{"id":29291,"word":"涂东抹西","pinyin":"tú dōng mǒ xī","abbr":"tdmx","explanation":"涂、抹：原喻从事文辞。比喻用笔随便写写画画。","source":{"text":"报道莫贫相！阿婆三五少年时，也曾东涂西抹来。","book":"五代·王定保《唐摭言·慈恩寺题名游赏赋咏杂记》"}},{"id":29292,"word":"涂歌巷舞","pinyin":"tú gē xiàng wǔ","abbr":"tgxw","explanation":"形容百姓欢欣快乐的升平景象。同“涂歌里抃”。","source":{"text":"一温然长者，兀坐而泣之，可立使民涂歌巷舞。","book":"明·袁宗道《顾使君考绩序》"},"similar":["涂歌里咏","涂歌邑诵"],"usage":"作定语；用于书面语"},{"id":29293,"word":"涂歌邑诵","pinyin":"tú gē yì sòng","abbr":"tgys","explanation":"路途邑里的人全都歌诵。形容国泰民安、百姓欢乐的景象。","source":{"text":"增类帝之宫，饬礼神之馆，涂歌邑诵，以望属车之尘者久矣。","book":"南朝·宋·颜延之《三月三日曲水诗序》"},"similar":["涂歌巷舞","涂歌里咏"],"usage":"作定语；用于书面语"},{"id":29294,"word":"涂歌里咏","pinyin":"tú gē lǐ yǒng","abbr":"tgly","explanation":"形容国泰民安、百姓欢乐的景象。同“涂歌邑诵”。","source":{"text":"老安少怀，涂歌里咏。莫不欢若亲戚，芬若椒兰。","book":"南朝·梁·沈约《齐故安陆昭王碑》"},"similar":["涂歌里抃","涂歌巷舞"],"usage":"作定语；用于书面语"},{"id":29295,"word":"涂歌里抃","pinyin":"tú gē lǐ biàn","abbr":"tglb","explanation":"路途的人歌诵，里巷的人抃舞。形容百姓欢欣快乐的升平景象。","source":{"text":"涂歌里抃，载怀凫藻。","book":"南朝·梁·沈约《贺齐明帝登祚启》"},"similar":["涂歌里咏","涂歌巷舞"],"usage":"作定语；用于书面语"},{"id":29296,"word":"涂炭生民","pinyin":"tú tàn shēng mín","abbr":"ttsm","explanation":"涂：泥沼；炭：炭火；生民：百姓。人民陷在泥塘和火坑里。形容人民处于极端困苦的境地。","source":{"text":"而夏桀陵虐涂炭生民，成汤武丁思贤若渴。","book":"《尚书·仲虺之诰》：“有夏昏德，民坠涂炭。”唐·释道宣《广弘明集》卷九"},"example":{"text":"叔宝无道，～。天兵南征，势同压卵；若或迁延，叔宝殒灭，嗣以令主，恐难为功。","book":"清·褚人获《隋唐演义》第一回"},"similar":["民生涂炭","生灵涂炭","涂炭生灵"],"opposite":["国泰民安","安居乐业"],"usage":"作谓语、宾语；指社会时局"},{"id":29297,"word":"涂炭生灵","pinyin":"tú tàn shēng líng","abbr":"ttsl","explanation":"涂：泥沼；炭：炭火；生灵：百姓。人民陷在泥塘和火坑里。形容人民处于极端困苦的境地。","source":{"text":"先帝晏驾贼庭，京师鞠为戎穴，神州萧条，生灵涂炭。","book":"《尚书·仲虺之诰》：“有夏昏德，民坠涂炭。”《晋书·苻丕载记》"},"example":{"text":"若能顺时达变，可保宝贵，毋为～，自贻后悔。","book":"《元史·世祖纪五》"},"similar":["民生涂炭","生灵涂炭","生人涂炭"],"opposite":["国泰民安","安居乐业"],"usage":"作谓语、宾语；指社会时局"},{"id":29298,"word":"涂脂傅粉","pinyin":"tú zhī fù fěn","abbr":"tzff","explanation":"脂：胭脂。搽胭脂抹粉。指妇女打扮。也比喻为遮掩丑恶的本质而粉饰打扮。","source":{"text":"一日称有疾，键户昼卧，某公穴窗纸窥之，则涂脂傅粉，钗钏衫裙一一整饬，然后陈设酒果，若有所祀者。","book":"清·纪昀《阅微草堂笔记·槐西杂志一》"},"example":{"text":"潘侯爷便坐在沉二宝旁边，看着他～，掠月挑云，看得甚是得意。","book":"清·张春帆《九尾龟》第一百六十七回"},"similar":["涂脂抹粉"],"usage":"作谓语、定语；指打扮"},{"id":29299,"word":"涂脂抹粉","pinyin":"tú zhī mǒ fěn","abbr":"tzmf","explanation":"脂：胭脂。搽胭脂抹粉。指妇女打扮。也比喻为遮掩丑恶的本质而粉饰打扮。","source":{"text":"其涂脂抹粉，惯卖风情，挑逗那富家郎君。","book":"明·凌濛初《二刻拍案惊奇·赵县君乔送黄柑》"},"example":{"text":"我照作品的年月看下去，这些不肯～的青年们的魂灵便依次屹立在我眼前。","book":"鲁迅《野草·一觉》"},"similar":["乔装打扮","文过饰非","涂脂傅粉"],"opposite":["本来面目","真相大白"],"usage":"作谓语、定语；指打扮"},{"id":29300,"word":"涅而不淄","pinyin":"niè ér bù zī","abbr":"nebz","explanation":"比喻品格高尚，不受恶劣环境的影响。同“涅而不缁”。","source":{"text":"蝉蜕于粪溷之中，皭然涅而不淄者也。","book":"明·张居正《七贤咏》序"},"similar":["涅而不缁"],"opposite":["同流合污"],"usage":"作谓语、定语；指人的性格"},{"id":29301,"word":"涅而不渝","pinyin":"niè ér bù yú","abbr":"neby","explanation":"涅：黑泥；渝：改变。用涅染也染不黑。比喻品格高尚，不受恶劣环境的影响。","source":{"text":"非淳人淑士，其谁能涅而不渝哉？","book":"唐·陈子昂《周故内供奉学士怀州河内县尉陈君硕人墓志铭》"},"similar":["涅而不缁","涅而不淄"],"usage":"作谓语、定语；指人的性格"},{"id":29302,"word":"涅而不缁","pinyin":"niè ér bù zī","abbr":"nebz","explanation":"涅：矿物名，古代用作黑色染料；缁：黑色。用涅染也染不黑。比喻品格高尚，不受恶劣环境的影响。","source":{"text":"不曰白乎，涅而不缁。","book":"《论语·阳货》"},"example":{"text":"义孙可谓岁寒不凋，～者矣。","book":"《晋书·刘曜载记》"},"similar":["泥而不滓","出淤泥而不染"],"opposite":["同流合污"],"usage":"作谓语、定语；指人的性格","story":["春秋时期，孔子在鲁国政坛遭到排挤后，带领弟子们周游列国，先后在卫国、宋国等没受到重视，在赴晋的途中，子路劝他不要去投奔赵鞅这种小人，孔子相信自己是君子，会“磨而不磷，涅而不缁”，不会玷污自己的名声的"]},{"id":29303,"word":"消声匿影","pinyin":"xiāo shēng nì yǐng","abbr":"xsny","explanation":"不公开讲话，不出头露面。形容隐藏起来，不再出现。","source":{"text":"禽巢欲远，鱼穴惟深，消声灭迹，何必山林！","book":"语出《艺文类聚》卷三六引北周庚信《五月披裘负薪画赞》"},"example":{"text":"不转瞬间，～，至今日而昔年之全盛，渺不可复睹矣。","book":"梁启超《欧洲地理大势论》"},"similar":["消声灭迹","消声匿迹","声销迹灭"],"usage":"作谓语、定语；用于处事"},{"id":29304,"word":"消声匿迹","pinyin":"xiāo shēng nì jì","abbr":"xsnj","explanation":"消：消失；匿：隐藏；迹：踪迹。指隐藏进来或不公开露面","source":{"text":"禽巢欲远，鱼穴惟深，消声灭迹，何必山林！","book":"北周·庾信《五月皮裘负薪画赞》"},"example":{"text":"郭沫若《沸羹集·抗战以来的文艺思潮》：“但为大势所迫，不久也就～了。”"},"similar":["销声匿迹"],"usage":"作谓语、宾语、补语；用于人或事物"},{"id":29305,"word":"消声灭迹","pinyin":"xiāo shēng miè jì","abbr":"xsmj","explanation":"不公开讲话，不出头露面。形容隐藏起来，不再出现。","source":{"text":"禽巢欲远，鱼穴惟深，消声灭迹，何必山林！","book":"《艺文类聚》卷三六引北周庚信《五月披裘负薪画赞》"},"similar":["声销迹灭","消声匿迹","消声匿影"],"usage":"作谓语、定语；用于处事"},{"id":29306,"word":"消息灵通","pinyin":"xiāo xī líng tōng","abbr":"xxlt","explanation":"指对各方面的消息能及时掌握。","example":{"text":"王太太真是～，小镇上来了什么人，她都一清二楚。"},"usage":"作谓语、定语；用于处事"},{"id":29307,"word":"消息盈冲","pinyin":"xiāo xī yíng chōng","abbr":"xxyc","explanation":"指事物的盛衰变化或行为的出处进退。","source":{"text":"君子尚消息盈虚，天行也。","book":"语出《易·剥》"},"example":{"text":"时行则行，时止则止，～，取诸天纪。","book":"汉蔡邕《释诲》"},"similar":["消息盈虚"],"usage":"作宾语、定语；用于书面语"},{"id":29308,"word":"消息盈虚","pinyin":"xiāo xī yíng xū","abbr":"xxyx","explanation":"指事物的盛衰变化或行为的出处进退。","source":{"text":"君子尚消息盈虚，天行也。","book":"《易·剥》"},"example":{"text":"～，终则有始。","book":"《庄子·秋水》"},"similar":["消息盈冲"],"usage":"作宾语、定语；用于书面语"},{"id":29309,"word":"消患未形","pinyin":"xiāo huàn wèn xíng","abbr":"xhwx","explanation":"患：祸患；形：形成。消除祸患于未形成之前。","source":{"text":"必有消患未形，而为朝野所利赖，远人所折服也。","book":"清·黎庶昌《上沈相国书》"},"similar":["防患未然"],"usage":"作谓语、定语、宾语；用于处事"},{"id":29310,"word":"消愁破闷","pinyin":"xiāo chóu pò mèn","abbr":"xcpm","explanation":"消除忧愁，破除郁闷。","source":{"text":"但观其事迹原委，亦可消愁破闷。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["消愁解闷"],"usage":"作谓语、宾语、定语；用于处事"},{"id":29311,"word":"消愁解闷","pinyin":"xiāo chóu jiě mèn","abbr":"xcjm","explanation":"消除忧愁，解除烦闷。","source":{"text":"[搽旦云]我不和你撒赖撒痴的，断了酒者！[正末唱]教我断消愁解闷瓮头香。","book":"元高文秀《遇上皇》第一折"},"example":{"text":"随时拣一支合式的唱唱，也足可～。","book":"朱自清《经典常谈·诗经》"},"similar":["消愁破闷"],"usage":"作谓语、宾语、定语；用于处事"},{"id":29312,"word":"消愁释愦","pinyin":"xiāo cháo shì kuì","abbr":"xcsk","explanation":"指消除烦闷，愉快身心。","source":{"text":"弹棋亦近世雅戏，消愁释愦，时可为之。","book":"北齐颜之推《颜氏家训·杂艺》"},"similar":["消愁释闷"],"usage":"作谓语、定语；用于书面语"},{"id":29313,"word":"消愁释闷","pinyin":"xiāo chóu shì mèn","abbr":"xcsm","explanation":"释：解除。消除忧愁，排解郁闷","source":{"text":"弹棋亦近世雅戏，消愁释愦，时可为之。","book":"北齐·颜之推《颜氏家训·杂艺》"},"example":{"text":"而后者的文字往往颇觉新奇，值得引用，以～。","book":"鲁迅《伪自由书·后记》"},"similar":["消愁破闷","消愁释愦"],"usage":"作谓语、定语；用于处事"},{"id":29314,"word":"消损白日","pinyin":"xiāo sǔn bái rì","abbr":"xsbr","explanation":"消：耗费；损：减；白日：时光。耗费时光。","source":{"text":"坐食嘉谷，消损白日。","book":"南朝·宋·范晔《后汉书·王符传》"},"similar":["消磨时光","虚度光阴"],"usage":"作谓语、定语、宾语；用于处事"},{"id":29315,"word":"消极应付","pinyin":"xiāo jí yìn fù","abbr":"xjyf","explanation":"不求进取地处理问题。","source":{"text":"有的人对政策对工作采取漠不关心的消极应付态度。","book":"邓小平《贯彻执行中共中央关于土改与整党工作的指示》"},"similar":["敷衍了事"],"opposite":["积极进取"],"usage":"作谓语、宾语、定语；用于处事"},{"id":29316,"word":"消极怠工","pinyin":"xiāo jí dài gōng","abbr":"xjdg","explanation":"消极对抗不合作。","source":{"text":"（五）消极怠工。稍不遂意，就消极起来，不做工作。","book":"毛泽东《关于纠正党内的错误思想》"},"example":{"text":"陈老板对于员工们的～毫无办法，只得同意增加工资。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":29317,"word":"消磨岁月","pinyin":"xiāo mó suì yuè","abbr":"xmsy","explanation":"消磨：虚度。虚度年月。","source":{"text":"再说那舅太太只和姑娘这等消磨岁月，转瞬之间，早度过残岁，又到新年。","book":"清·文康《儿女英雄传》第24回"},"example":{"text":"年轻人不能～，浪费光阴。"},"similar":["浪费光阴"],"usage":"作谓语、定语；指虚度年月"},{"id":29318,"word":"消遥自在","pinyin":"xiāo yáo zì zài","abbr":"xyzz","explanation":"指逍遥自得。","source":{"text":"你看那人踏雪寻梅，那人寒江独钓，何等消遥自在。","book":"明谢谠《四喜记·亲忆琼英》"},"similar":["逍遥自在"],"usage":"作谓语、定语、状语；用于人"},{"id":29319,"word":"消释前嫌","pinyin":"xiāo shì qián xián","abbr":"xsqx","explanation":"消释：消除，解除；嫌：嫌怨，怨恨。消解了过去的仇怨。","source":{"text":"若此则流言消释，疑惑著明。","book":"东汉·班固《汉书·杜钦传》"},"usage":"作谓语、定语；用于处事"},{"id":29320,"word":"消除异己","pinyin":"xiāo chú yì jǐ","abbr":"xcyj","explanation":"排挤、消除与自己意见不同或非本集团的人。","source":{"text":"这样的敌我倒置，真是由蒋介石自己召供，活画出他一贯勾结敌伪，消除异己的全部心理了。","book":"毛泽东《蒋介石在挑动内战》"},"example":{"text":"你不要急于～。"},"similar":["排除异己"],"usage":"作谓语、定语；指排除不同政见的人"},{"id":29321,"word":"涉世未深","pinyin":"shè shì wèi shēn","abbr":"ssws","explanation":"指接触社会少，经历世事不多，处理问题的能力不强","source":{"text":"宗人夷吾有美名，博学不及衍，涉世声誉过之。","book":"《晋书·孔衍传》"},"example":{"text":"林海音《孟珠的旅程》：“天真～的妹妹，也许不知道姐姐所唱的歌词，都是很浅俗容易懂的。”"},"similar":["乳臭未干"],"opposite":["老于世故"],"usage":"作谓语、定语；用于处事"},{"id":29322,"word":"涉危履险","pinyin":"shè wēi lǚ xiǎn","abbr":"swlx","explanation":"跋涉危难，经历险阻。形容闯越重重困难。","source":{"text":"磐身婴甲冑，涉危履险，讨击凶患，斩殄渠帅，余尽鸟窜冒遁，还奔荆州。","book":"《后汉书·度尚传》"},"similar":["涉艰履危"],"usage":"作谓语、定语；用于人的处境"},{"id":29323,"word":"涉想犹存","pinyin":"shè xiǎng yǒu cún","abbr":"sxyc","explanation":"涉想：想到，念及；犹；还。形容某种情景依然存在于想像之中。","source":{"text":"帐前微笑，涉想犹存，而幄里余香，从风且歇。","book":"南朝·梁·何逊《为衡山侯与妇书》"}},{"id":29324,"word":"涉水登山","pinyin":"shè shuǐ dēng shān","abbr":"ssds","explanation":"形容旅程的艰苦，也形容行程连绵不断。同“涉海登山”。","source":{"text":"假饶他升天摄地三千里，亦任他涉水登山二百州，赶将去活喇喇牵转白牛。","book":"明·杨慎《洞天玄记》第一折"},"example":{"text":"清·姜振名《永庆升平前传》第46回：“吾～，各处访察，不想今天在此相遇。”"},"similar":["涉海登山"],"usage":"作谓语、宾语、定语；用于旅行等"},{"id":29325,"word":"涉海凿河","pinyin":"shè hǎi záo hé","abbr":"shzh","explanation":"渡过海去开河道。比喻事情无法成功。","source":{"text":"其于治天下也，犹涉海凿河，而使蚊负山也。","book":"《庄子·应帝王》"}},{"id":29326,"word":"涉海登山","pinyin":"shè hǎi dēng shān","abbr":"shds","explanation":"渡过大海，攀登高山。形容旅程的艰苦，也形容行程连绵不断。亦作“涉水登山”。","source":{"text":"奉宣圣旨，内出新撰历书二十五卷，以示臣等，窃窥深奥，仰观英华，涉海登山，罔知攸际。","book":"唐·张说《贺示历书表》"},"similar":["涉水登山"],"usage":"作谓语、宾语、定语；用于旅行等"},{"id":29327,"word":"涉笔成趣","pinyin":"shè bǐ chéng qù","abbr":"sbcq","explanation":"涉笔：动笔：趣：风趣，意味。形容一动笔就画出或写出很有意趣的东西。","source":{"text":"心有余闲，涉笔成趣，每于长夏余冬，灯前月夕，以文为戏，年复一年，编出这《镜花缘》一百回。","book":"清·李汝珍《镜花缘》第一百回"},"example":{"text":"这一段～。","book":"茅盾《一九六０年短篇小说漫评》"},"similar":["栩栩如生","涉笔成雅"],"opposite":["枯燥无味"],"usage":"作谓语、定语；用于写作"},{"id":29328,"word":"涉笔成雅","pinyin":"shè bǐ chéng yǎ","abbr":"sbcy","explanation":"指动笔就雅致而不落俗套。","source":{"text":"于物无择，而涉笔成雅；于思无豫，而往必造微。","book":"清·毛先舒《诗辩坻》卷一"},"similar":["涉笔成趣"],"usage":"作谓语、定语；用于写作"},{"id":29329,"word":"涉艰履危","pinyin":"shè jiān lǚ wēi","abbr":"sjlw","explanation":"形容闯越重重困难。同“涉危履险”。","source":{"text":"经昏践乱，涉艰履危，仰圣德以求全，凭贤辅以申节。","book":"南朝·齐·虞玩之《上表告退》"},"similar":["涉危履险"],"usage":"作谓语、定语；用于人的处境"},{"id":29330,"word":"涎玉沫珠","pinyin":"xián yù mò zhū","abbr":"xymz","explanation":"流出美玉，吐出珍珠。比喻水花四溅的美丽景象。","source":{"text":"木腔瀑三丈余，涎玉沫珠。","book":"唐·樊宗师《绛守居园池记》"},"usage":"作谓语、定语；用于书面语"},{"id":29331,"word":"涎皮涎脸","pinyin":"xián pí xián liǎn","abbr":"xpxl","explanation":"嬉皮笑脸；厚着脸皮跟人纠缠。亦作“涎皮赖脸”。亦作“涎脸涎皮”。","source":{"text":"一个大嘴的黑人走过来，向姚长庚涎皮涎脸伸着手说：‘淡贝！淡贝！’","book":"杨朔《三千里江山》第八段"},"similar":["涎脸涎皮"],"usage":"作谓语、定语、状语；用于处事等"},{"id":29332,"word":"涎皮赖脸","pinyin":"xián pí lài liǎn","abbr":"xpll","explanation":"厚着脸皮纠缠，惹人厌烦。","source":{"text":"你在这青堂瓦舍里坐着，到也自在，你这等涎皮赖脸的，俺管监的吃风！","book":"明·李开先《宝剑记》第十四出"},"example":{"text":"黛玉将手一摔道：“谁和你拉拉扯扯的！一天大似一天，还这么～的，连个理也不知道。","book":"清·曹雪芹《红楼梦》第三十回"},"similar":["涎皮涎脸","嬉皮笑脸"],"usage":"作谓语、定语、宾语；指脸皮厚"},{"id":29333,"word":"涎眉邓眼","pinyin":"xián méi dèng yǎn","abbr":"xmdy","explanation":"犹嬉皮笑脸。形容嬉笑不严肃的样子。","source":{"text":"涎眉邓眼没志气的东西，没有下唇，就不该揽着箫吹。","book":"清·西周生《醒世姻缘传》第三回"},"similar":["涎脸饧眼"],"usage":"作定语、状语；用于书面语"},{"id":29334,"word":"涎脸涎皮","pinyin":"xián liǎn xián pí","abbr":"xlxp","explanation":"嬉皮笑脸；厚着脸皮跟人纠缠。同“涎皮涎脸”。","source":{"text":"月娘看不上，说道：‘你真个恁涎脸涎皮的！’","book":"明·兰陵笑笑生《金瓶梅词话》第21回"},"similar":["涎皮涎脸","嘻皮涎脸"],"usage":"作谓语、定语、状语；用于处事等"},{"id":29335,"word":"涎脸饧眼","pinyin":"xián liǎn táng yǎn","abbr":"xlty","explanation":"嬉皮笑脸，挤眉弄眼。形容轻佻相。","source":{"text":"像卫队似的，梅女士前后左右总有四五个涎脸饧眼的恶少。","book":"茅盾《虹》"},"similar":["涎眉邓眼"],"usage":"作定语、状语；用于书面语"},{"id":29336,"word":"涎言涎语","pinyin":"xián yán xián yǔ","abbr":"xyxy","explanation":"厚着脸皮胡言乱语，撒赖。","source":{"text":"那贾琏撒娇撒痴，涎言涎语的还只管乱说。","book":"清·曹雪芹《红楼梦》第四十四回"},"usage":"作定语、状语；用于处事等"},{"id":29337,"word":"涓埃之力","pinyin":"juān āi zhī lì","abbr":"jazl","explanation":"比喻微小的力量。","source":{"text":"念臣寒陋无堪，上感圣恩，备员军事，未有涓埃之力，以报国家。","book":"宋·岳珂《金佗粹编》卷九"},"example":{"text":"我愿尽～帮助灾区重建"},"usage":"作宾语；多用于自谦"},{"id":29338,"word":"涓埃之功","pinyin":"juān āi zhī gōng","abbr":"jazg","explanation":"涓埃：细小的流水和尘埃；功：功劳。比喻很小的功劳。","source":{"text":"恨无涓埃之功，以为进见之礼。","book":"明·罗贯中《三国演义》第三回"}},{"id":29339,"word":"涓埃之微","pinyin":"juān āi zhī wēi","abbr":"jazw","explanation":"涓埃：细小的流水和尘埃。比喻特别小或特别少，微乎其微。","source":{"text":"于裨补无涓埃之微，而谗谤有丘山之积。","book":"唐·韩愈《为裴相公让官表》"},"example":{"text":"冀以涓埃之微，上裨天地之德，俾功业与尧、舜比崇，而生灵亦跻仁寿之域矣。","book":"《宋史·田锡传》"}},{"id":29340,"word":"涓埃之报","pinyin":"juān āi zhī bào","abbr":"jazb","explanation":"涓埃：细小的流水和尘埃。比喻极其微薄的报答。","source":{"text":"臣敢不瞻望京邑，推广风教之余；勉强疲驽，少致涓埃之报。","book":"宋·苏辙《代张刍谏议南京谢表》"},"example":{"text":"姜尚何幸，蒙先王顾聘，未效～，又蒙大王拜尚为将，知遇之隆，古今罕及。","book":"明·许仲琳《封神演义》第六十八回"}},{"id":29341,"word":"涓涓不壅，终为江河","pinyin":"juān juān bù yōng，zhōng wéi jiāng hé","abbr":"jjbyzwjh","explanation":"壅：堵塞。细小的水流如果不堵塞，终将汇合成为大江大河。比喻对细小或刚刚萌芽的问题不加注意或纠正，就会酿成大的问题。","source":{"text":"涓涓不壅，终为江河，绵绵不绝，或成网罗。","book":"三国·魏·王肃《孔子家语·观周》"},"usage":"作宾语、分句；指从小入手防治"},{"id":29342,"word":"涓滴不漏","pinyin":"juān dī bù lòu","abbr":"jdbl","explanation":"涓滴：小水珠，比喻极小或极少的东西。一点儿也不遗漏。亦作“涓滴不留”、“涓滴不遗”。","source":{"text":"重露成涓滴，稀星乍有无。","book":"唐·杜甫《倦夜》"},"example":{"text":"独步丹霄临机大用，把住～，放行乃浪涌千江，踞地全威壁立千仞。","book":"宋·释惟白《续传灯录》卷十"}},{"id":29343,"word":"涓滴不遗","pinyin":"juān dī bù yí","abbr":"jdby","explanation":"涓：细流；滴：小水珠。一点一滴也不遗漏。比喻极小的或极少的东西也不遗漏。","source":{"text":"重露成涓滴，稀星乍有无。","book":"唐·杜甫《倦夜》"},"example":{"text":"如水传器，～。","book":"宋·释普济《五灯会元》卷五十三"},"similar":["巨细无遗"],"usage":"作宾语、状语；形容十分严密"},{"id":29344,"word":"涓滴之劳","pinyin":"juān dī zhī láo","abbr":"jdzl","explanation":"涓：细流；滴：水珠。很小的一点功劳。","source":{"text":"刘洎出自闾武，言行罕称，于国无涓滴之劳，在朕匪粉榆之旧。","book":"唐·李世民《赐刘洎自尽诏》"},"similar":["尺寸之功"],"usage":"作主语、宾语；指很小的一点功劳"},{"id":29345,"word":"涓滴归公","pinyin":"juān dī guī gōng","abbr":"jdgg","explanation":"涓滴：小水点，比喻细微的东西。形容属于公家的财物全部缴公，不占为私有。","source":{"text":"真正是涓滴归公，一丝一毫不敢乱用。","book":"清·李宝嘉《官场现形记》第三十三回"},"example":{"text":"然必～，撙节动用，始得实济。","book":"《清史稿·文宗纪》"},"similar":["颗粒归公","点滴归公"],"opposite":["假公济私","贪污受贿","中饱私囊"],"usage":"作宾语；形容丝毫不损公肥私"},{"id":29346,"word":"涓滴微利","pinyin":"juān dī wēi lì","abbr":"jdwl","explanation":"涓：细流；滴：水珠。象小水珠一样微小的利益。","source":{"text":"贪取涓滴之微利，而自弃丘山之大功乎！","book":"《新编五代史评话·晋史》卷上"},"similar":["蝇头小利"],"usage":"作主语、宾语、定语；指小利"},{"id":29347,"word":"涓滴成河","pinyin":"juān dī chéng hé","abbr":"jdch","explanation":"涓滴：小水珠。一点一滴的水珠汇集起来就可以成为河流。形容积少成多。","example":{"text":"～，我们坚持节约，那将受益匪浅。"},"similar":["积少成多"],"usage":"作宾语、定语；同“积少成多”"},{"id":29348,"word":"涕泗交下","pinyin":"tì sì jiāo xià","abbr":"tsjx","explanation":"眼泪鼻涕一起流下。形容痛哭的样子。同“涕泗交流”。","source":{"text":"全贪其重赂，径入（南）曲追天水入兜舆中，相与至宴所，至则蓬头垢面，涕泗交下。","book":"唐·孙棨《北里志·天水仙哥》"},"example":{"text":"宣宗郊天前一日，谒太庙。至宪宗室，捧斝而入，～。左右观者，莫能仰视。","book":"宋·王谠《唐语林·德行》"},"similar":["涕泗交流","涕泗纵横","涕泪交流"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":29349,"word":"涕泗交流","pinyin":"tì sì jiāo liú","abbr":"tsjl","explanation":"眼泪鼻涕一起流下。形容痛哭的样子。","source":{"text":"夏，四月，甲申，郭子仪辞还邠州，复为上言边事，至涕泗交流。","book":"北齐·魏收《魏书·元顺传》：“顺即哽塞，涕泗交流，久而不能言，遂令换之。”宋·司马光《资治通鉴》卷第二百二十五"},"example":{"text":"说话未毕，早见小姐从屏后转出，见了尚书，～。","book":"清·烟霞散人《凤凰池》第十五回"},"similar":["涕泪交下","涕泗交下","涕泗纵横"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":29350,"word":"涕泗交颐","pinyin":"tì sì jiāo yí","abbr":"tsjy","explanation":"眼泪鼻涕流满脸颊。形容哀恸哭泣。","source":{"text":"男抛未下，女失所依。矧姑钟爱，涕泗交颐。","book":"宋·陈亮《祭徐子宜内子宋氏恭人文》"},"example":{"text":"虽祖～，再四苦留，亦不之顾。","book":"明·李贽《焚书·三判记》"},"similar":["涕泗交下","涕泗流涟","涕泗纵横"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":29351,"word":"涕泗横流","pinyin":"tì sì héng liú","abbr":"tshl","explanation":"眼泪鼻涕满脸乱淌。形容极度悲伤。","source":{"text":"眼泪鼻涕满脸乱淌。形容极度悲伤。"},"example":{"text":"抚剑悲歌，临书浩叹，每感岁时之易失，不知涕泗之横流。","book":"宋·陆游《上王宣抚启》"},"similar":["涕泗纵横"],"usage":"作谓语、定语；指极度悲伤"},{"id":29352,"word":"涕泗流涟","pinyin":"tì sì liú lián","abbr":"tsll","explanation":"鼻涕眼泪直往下流。形容痛哭流涕。","source":{"text":"孔时为太常，形素羸瘦，着重服，竟日涕泗流涟，见者以为真孝子。","book":"《世说新语·德行》"}},{"id":29353,"word":"涕泗滂沱","pinyin":"tì sì páng tuó","abbr":"tspt","explanation":"滂沱：雨下得很大。雨下得很大的样子。形容哭得很厉害，眼泪鼻涕象下雨一样。","source":{"text":"有美一人，伤如之何！寤寐无为，涕泗滂沱。","book":"《诗经·陈风·泽陂》"},"example":{"text":"月中再设净馔，每至展拜，～，哀动左右。","book":"《南史·梁本纪中》"},"similar":["痛哭流涕","涕泗横流"],"opposite":["眉开眼笑","笑容可掬"],"usage":"作谓语、状语；用于书面语"},{"id":29354,"word":"涕泗滂沲","pinyin":"tì sì pāng tuó","abbr":"tspt","explanation":"谓涕泪如雨。形容涕泪流得极多。同“涕泗滂沱”。","source":{"text":"孔稚珪，字德璋，会稽山阴人也。祖道隆，位侍中。父灵产，泰始中罢晋安太守。有隐遁之怀，于禹井山立馆，事道精笃，吉日于静屋四向朝拜，涕泗滂沲。","book":"《南齐书·孔稚珪传》"},"example":{"text":"高祖生知淳孝。年六岁，献皇太后崩，水浆不入口三日，哭泣哀苦，有过成人……每至展拜，恒～，哀动左右。","book":"《梁书·武帝纪下》"}},{"id":29355,"word":"涕泗纵横","pinyin":"tì sì zòng héng","abbr":"tszh","explanation":"眼泪鼻涕满脸乱淌。形容极度悲伤。同“涕泗横流”。","source":{"text":"非小臣稽古之力，乃陛下好文之心，涕泗纵横，乱于縻绠。","book":"宋·王禹偁《谢加朝请大夫表》"},"similar":["涕泗流涟","涕泗交流","涕泗横流"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":29356,"word":"涕泪交下","pinyin":"tì lèi jiāo xià","abbr":"tljx","explanation":"鼻涕眼泪同时流下，形容极度哀痛。同“涕泪交零”。","source":{"text":"彧闻乐声，歔欷，涕泪交下，悲感傍人，衍为之不乐。","book":"《魏书·临淮王谭传》"},"example":{"text":"清·夏敬渠《野叟曝言》第41回：“一阵心酸，不觉～，竟要哭出声来。”"},"similar":["涕泪交零","涕泪交加","涕泪交集"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":29357,"word":"涕泪交加","pinyin":"tì lèi jiāo jiā","abbr":"tljj","explanation":"犹涕泪交零。","source":{"text":"情则至矣，仪匪靖嘉。临风一酹，涕泪交加。","book":"宋·陈亮《祭彭子复父文》"},"example":{"text":"明·伏雌教主《醋葫芦》第五回：“都氏起初还道是假，看那～，稳信是真。”"},"similar":["涕泪交集","涕泪交零"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":29358,"word":"涕泪交垂","pinyin":"tì lèi jiāo chuí","abbr":"tljc","explanation":"鼻涕眼泪同时流下，形容极度悲哀。","source":{"text":"十有四拍兮涕泪交垂，河水东流兮心是思。","book":"汉·蔡琰《胡笳十八拍》"},"example":{"text":"谁料父子衔冤，赴黄泉没转期，细思之，～。","book":"明·无名氏《精忠记·毕命》"},"similar":["涕泪交流"],"usage":"作谓语、状语；指非常悲痛"},{"id":29359,"word":"涕泪交流","pinyin":"tì lèi jiāo liú","abbr":"tljl","explanation":"鼻涕眼泪同时流下，形容极度哀痛。同“涕泪交零”。","source":{"text":"是何微类，误我至尊，乞明验于奸人，愿不容于首恶。兴言及此，涕泪交流。","book":"宋·邵伯温《闻见前录》卷六"},"example":{"text":"王朔《我是你爸爸》：“上来二话不说，直接就扇马锐大耳刮子，打得他～，到了学校脸上还留着手印子。”"},"similar":["涕泪交垂","涕泪交下"],"usage":"作谓语、状语；指非常悲痛"},{"id":29360,"word":"涕泪交集","pinyin":"tì lèi jiāo jí","abbr":"tljj","explanation":"犹涕泪交零。","source":{"text":"王闻师言，涕泪交集曰：‘此国何罪，彼土何祥。’","book":"《五灯会元·东土祖师》"},"similar":["涕泪交加"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":29361,"word":"涕泪交零","pinyin":"tì lèi jiāo líng","abbr":"tljl","explanation":"鼻涕眼泪同时流下，形容极度哀痛。","source":{"text":"同胞恻怆，涕泪交零，呱呱竖子，号咷失声。","book":"汉·无名氏《安平相孙根碑》"},"example":{"text":"亮即为诵之，～，声韵不异。","book":"《魏书·崔亮传》"},"similar":["涕泪交加","涕泪交下","涕泪交集"],"opposite":["喜笑颜开"],"usage":"作谓语、定语、状语；用于悲痛时"},{"id":29362,"word":"涕零如雨","pinyin":"tì líng rú yǔ","abbr":"tlry","explanation":"涕零：流泪。眼泪象雨水一样往下淌。形容思念的感情极深。","source":{"text":"念彼共人，涕零如雨。","book":"《诗经·小雅·小明》"},"similar":["涕泗滂沱"],"usage":"作谓语、定语；形容人的感情"},{"id":29363,"word":"涛澜汹涌","pinyin":"tāo lán xiōng yǒng","abbr":"tlxy","explanation":"形容波涛翻滚的样子。","source":{"text":"涛澜汹涌，风云开阖。","book":"宋·苏辙《黄州快哉亭记》"}},{"id":29364,"word":"涣发大号","pinyin":"huàn fā dà hào","abbr":"hfdh","explanation":"犹言涣汗大号。指帝王号令，如人之汗，一出不复收。也指帝王发布号令。","source":{"text":"罢息诛求，敦尚节俭，涣发大号，与人更新。","book":"唐·陆贽《论裴延龄奸蠹书》"},"example":{"text":"～，申明旧章。","book":"唐·柳宗元《代韦中丞贺元和大赦表》"},"similar":["涣汗大号"],"usage":"作宾语、定语；用于比喻句"},{"id":29365,"word":"涣如冰释","pinyin":"huàn rú bīng shì","abbr":"hrbs","explanation":"犹言涣然冰释。形容疑虑、误会、隔阂等完全消除。","source":{"text":"久即下部血出，并鲜血片，便无痛苦，涣如冰释。","book":"宋·张君房《云笈七签》卷七十五"},"similar":["涣若冰释","涣然冰释","焕然冰释"],"usage":"作谓语、宾语；比喻相互间的嫌隙等消除"},{"id":29366,"word":"涣尔冰开","pinyin":"huàn ěr bīng kāi","abbr":"hebk","explanation":"犹言涣然冰释。形容疑虑、误会、隔阂等完全消除。","source":{"text":"钻仰渊秘，涣尔冰开。","book":"南朝·梁·何炯《答释法云书难范缜〈神灭论〉》"},"similar":["涣然冰释","涣若冰释","涣如冰释"],"usage":"作谓语、宾语；比喻相互间的嫌隙等消除"},{"id":29367,"word":"涣汗大号","pinyin":"huàn hàn dà hào","abbr":"hhdh","explanation":"①指帝王号令，如人之汗，一出不复收。②指帝王发布号令。","source":{"text":"人遇险厄惊怖而劳，则汗从体出，故以汗喻险厄也。九五处尊履正，在号令之中，能行号令以散险厄者也。","book":"《易·涣》：“九五，涣汗其大号。”孔颖达疏"},"example":{"text":"先帝诛逆表忠，～。","book":"清·钱谦益《故南京国子监祭酒石门许公合葬墓志铭》"},"similar":["涣发大号"],"usage":"作宾语、定语；用于比喻句"},{"id":29368,"word":"涣然冰消","pinyin":"huàn rán bīng xiāo","abbr":"hrbx","explanation":"象冰冻遇热似的一下子消融。多比喻疑团、困难等很快消除。同“涣如冰释”。","source":{"text":"准此推之，以真理诘幻状，以实验捣虚情，虽举国若狂，万人同梦，而迎刃以解，涣然冰消。","book":"《中国近代文论选·论科学之发达可以辟旧小说之荒谬思想》"}},{"id":29369,"word":"涣然冰释","pinyin":"huàn rán bīng shì","abbr":"hrbs","explanation":"涣然：流散的样子；释：消散。象冰遇热消融一般。形容疑虑、误会、隔阂等完全消除。","source":{"text":"涣兮若冰之将释。","book":"《老子》第十五章"},"example":{"text":"误解和偏见并不能随着时间的推移而～。"},"similar":["烟消云散","冰消瓦解","化为乌有"],"usage":"作谓语、宾语；比喻相互间的嫌隙等消除"},{"id":29370,"word":"涣若冰消","pinyin":"huàn ruò bīng xiāo","abbr":"hrbx","explanation":"犹言涣然冰释。象冰遇热消融一般。形容疑虑、误会、隔阂等完全消除。","source":{"text":"标理明例，涣若冰消。","book":"南朝·梁·王莹《答释法云书难范缜〈神灭论〉》"},"similar":["涣若冰释","涣如冰释","涣然冰释"],"usage":"作谓语、宾语；比喻相互间的嫌隙等消除"},{"id":29371,"word":"涣若冰释","pinyin":"huàn ruò bīng shì","abbr":"hrbs","explanation":"犹言涣然冰释。形容疑虑、误会、隔阂等完全消除。","source":{"text":"澄（吴澄）答问亹亹，使人涣若冰释。","book":"《续资治通鉴·元顺帝元统元年》"},"similar":["涣如冰释","涣然冰释","涣尔冰开"],"usage":"作谓语、宾语；比喻相互间的嫌隙等消除"},{"id":29372,"word":"涤地无类","pinyin":"dí dì wú lèi","abbr":"ddwl","explanation":"荡涤无遗。形容清除得彻底。","source":{"text":"[王莽]使四境之外，并入为害，缘边之郡，江海之濒，涤地无类。","book":"《后汉书·隗嚣传》"},"similar":["荡涤无遗"],"usage":"作谓语；指打扫干净"},{"id":29373,"word":"涤垢洗瑕","pinyin":"dí gòu xǐ xiá","abbr":"dgxx","explanation":"涤：清除；垢：污秽；瑕：瑕疵。指清除缺点过失，清除污泥浊水。","source":{"text":"涤垢洗瑕，以倡四海。","book":"唐·吴武陵《遗吴元济书》"},"similar":["涤瑕荡垢","涤瑕荡秽"],"usage":"作谓语、宾语；指清除缺点等"},{"id":29374,"word":"涤故更新","pinyin":"dí gù gēng xīn","abbr":"dggx","explanation":"涤除陈旧，换上新的。","source":{"text":"譬之昨死而今生，须从此涤故更新；再一馁，则不可为矣。","book":"清·蒲松龄《聊斋志异·马介甫》"},"example":{"text":"我们要～，开创未来。"},"similar":["推陈出新"],"opposite":["一成不变"],"usage":"作谓语、定语；形容清除旧的换新的"},{"id":29375,"word":"涤瑕荡垢","pinyin":"dí xiá dàng gòu","abbr":"dxdg","explanation":"指清除旧的恶习。同“涤瑕荡秽”。","source":{"text":"迁者追回流者还，涤瑕荡垢朝清班。","book":"唐·韩愈《八月十五夜赠张功曹》诗"},"example":{"text":"看～土重光，全无敌。","book":"陈毅《满江红·黄金海岸》词"},"similar":["涤秽荡瑕","涤垢洗瑕"],"usage":"作谓语、宾语；指清除缺点等"},{"id":29376,"word":"涤瑕荡秽","pinyin":"dí xiá dàng huì","abbr":"dxdh","explanation":"涤：清除；瑕：玉上的斑点；荡：清除；秽：肮脏。指清除旧的恶习。","source":{"text":"于是百姓涤瑕荡秽，而镜至清。","book":"汉·班固《东都赋》"},"example":{"text":"使其上下一心，痛自刻责，～，发愤为雄，犹足以为善国。","book":"蔡东藩、许廑父《民国通俗演义》第四十四回"},"similar":["涤瑕荡垢"],"opposite":["藏污纳垢"],"usage":"作谓语、宾语；指清除缺点等"},{"id":29377,"word":"涤瑕蹈隙","pinyin":"dí xiá dǎo xī","abbr":"dxdx","explanation":"指攻击别人的弱点或错误。"},{"id":29378,"word":"涤私愧贪","pinyin":"dí sī kuì tān","abbr":"dskt","explanation":"涤：清除；私：私心；愧：惭愧；贪：贪心。清除私心，对贪心感到惭愧。这是一种内心自我修养的要求。"},{"id":29379,"word":"涤秽布新","pinyin":"dí huì bù xīn","abbr":"dhbx","explanation":"清除陈旧的，建立新的。","source":{"text":"比来大江以南，盛行新剧，竟以现身说法，涤秽布新，甚美甚善。","book":"黄远庸《新剧杂论》"},"similar":["除旧布新"],"usage":"作谓语、定语；用于指革新"},{"id":29380,"word":"涤秽荡瑕","pinyin":"dí huì dàng xiá","abbr":"dhdx","explanation":"指清除旧的恶习。同“涤瑕荡秽”。","source":{"text":"殿下以命世之资，属当倾危之运，礼乐征伐，翼成中兴，将涤秽荡瑕，拨乱反正。","book":"《宋书·礼志一》"},"similar":["涤瑕荡垢","涤瑕荡秽"],"usage":"作谓语、宾语；指清除缺点等"},{"id":29381,"word":"润屋润身","pinyin":"rùn wū rùn shēn","abbr":"rwrs","explanation":"后用为恭贺新屋落成的题辞。","source":{"text":"富润屋，德润身。","book":"《礼记·大学》"}},{"id":29382,"word":"润笔之绢","pinyin":"rùn bǐ zhī juàn","abbr":"rbzj","explanation":"为人作诗文书画所得的报酬。","source":{"text":"特地托人到上海去，出了一块洋钱润笔求来的呀。","book":"清·吴趼人《二十年目睹之怪现状》"},"example":{"text":"我免费给你作画，不需要～。"},"similar":["润笔之资"],"usage":"作宾语；用于书面语"},{"id":29383,"word":"润笔之资","pinyin":"rùn bǐ zhī zī","abbr":"rbzz","explanation":"为人作诗文书画所得的报酬。","source":{"text":"以物求文，谓之润笔之资；因文得钱，乃曰稽古之力。","book":"明·程登吉《幼学琼林》第四卷"},"example":{"text":"他两个便将五钱银子，送秀才做～。","book":"明·凌濛初《初刻拍案惊奇》第20卷"},"similar":["润笔之绢"],"usage":"作宾语；用于书面语"},{"id":29384,"word":"涨啮城郭","pinyin":"zhàng niè chéng guō","abbr":"zncg","explanation":"涨：涨水；啮：咬；城：内城的墙；郭：外城的墙。指洪水上涨，冲击城墙。","source":{"text":"张柬之授襄阳刺史，会汉水涨啮城郭，柬之因垒为堤，以遏湍怒。","book":"《渊鉴类函·汉四》"},"usage":"作谓语；指洪水上涨"},{"id":29385,"word":"涩于言论","pinyin":"sè yú yán lùn","abbr":"syyl","explanation":"形容说话迟钝。","source":{"text":"生而舌短，涩于言论。","book":"《宋书·南郡王义宣传》"},"opposite":["伶牙俐齿"],"usage":"作谓语、定语；用于说话等"},{"id":29386,"word":"涵今茹古","pinyin":"hán jīn rú gǔ","abbr":"hjrg","explanation":"涵：包容；茹：吃。包容吞吐古今。形容学识渊博，通晓古今。","source":{"text":"先生之作，抉经之心，执经之权，茹古涵今，无有端涯，浑浑灏灏，不可窥校。","book":"唐·皇甫湜《韩文公墓志铭》"}},{"id":29387,"word":"涵泳玩索","pinyin":"hán yǒng wán suǒ","abbr":"hyws","explanation":"涵：沉浸；泳：潜行水中；涵泳：完全进入水中进行游泳，指深入理解体会。深入反复地体会和思索。","source":{"text":"此语或中或否，皆出臆度，要之未可遽论，且涵泳玩索，久之当自有见。","book":"晋·左思《吴都赋》：“涵泳乎其中。”宋·朱熹《朱子语类·性理》"},"usage":"作谓语、宾语；指反复探索"},{"id":29388,"word":"涸思干虑","pinyin":"hé sī qián lǜ","abbr":"hsgl","explanation":"犹言绞尽脑汁。","source":{"text":"极思为文，曰涸思干虑。","book":"明·王志坚《表异录·艺文》"},"similar":["绞尽脑汁","穷思竭想"],"usage":"作谓语、宾语；用于思考问题"},{"id":29389,"word":"涸泽之蛇","pinyin":"hé zé zhī shé","abbr":"hzzs","explanation":"老实人受欺负，奸诈的人玩弄手段得到好处。","source":{"text":"子独不闻涸泽之蛇首？泽涸，蛇将徙。","book":"战国·韩·韩非《韩非子·说林上》"},"usage":"作宾语；用于人情世故","story":["田成子离开齐国去燕国，鸱夷子皮当随从。子皮讲涸泽之蛇的故事，水泽干了，大蛇背着小蛇逃离，人们纷纷避让，以为碰见神蛇了。现在您仪表堂堂而我其貌不扬，您不如装作我的随从，人们会当我是一个万乘之卿。于是田成子背文书跟行受到优待"]},{"id":29390,"word":"涸泽而渔","pinyin":"hé zé ér yú","abbr":"hzey","explanation":"抽干池水捉鱼。比喻只图眼前利益，不作长远打算。","source":{"text":"先王之法，不涸泽而渔，不焚林而猎。","book":"《文子·七仁》"},"example":{"text":"是由～，焚林而狩。","book":"《宋书·袁淑传》"},"similar":["竭泽而渔","杀鸡取卵"],"opposite":["从长计议"],"usage":"作谓语、宾语；指不作长远打算"},{"id":29391,"word":"涸泽而渔，焚林而猎","pinyin":"hé zé ér yú，fén lín ér liè","abbr":"hzeyflel","explanation":"涸：使水干枯；泽：聚水的洼地；焚：烧毁。把池水戽干来捕鱼，将林地烧毁来打猎。比喻只图眼前利益，不作长远打算。","source":{"text":"先王之法，……不涸泽而渔，不焚林而猎。","book":"《文子·上仁》"},"example":{"text":"是由～，若浚风之儛轻箨，杲日之拂浮霜。","book":"《宋书·袁淑传》"},"usage":"作谓语、宾语、定语；可分开使用"},{"id":29392,"word":"涸辙之枯","pinyin":"hé zhé zhī kū","abbr":"hzzk","explanation":"涸：水涸，干涸；辙：车轮的痕迹。干涸的车沟里的小鱼。比喻在困境中急待援助的人。","source":{"text":"但愿捐斗水而活涸辙之枯，下壶飨而救翳桑之饿，此则故人之赐也。","book":"《剪灯新话·三山福地志》"},"similar":["涸辙之鲋","涸辙之鱼","涸辙枯鱼"],"usage":"作主语、宾语；比喻处于困境中的人"},{"id":29393,"word":"涸辙之鱼","pinyin":"hé zhé zhī yú","abbr":"hzzy","explanation":"涸：水涸，干涸；辙：车轮的痕迹。干涸的车沟里的小鱼。比喻在困境中急待援助的人。","source":{"text":"惊心草木皆兵，举目椿萱何在，累累如丧家之犬，圉圉似涸辙之鱼。","book":"明·无名氏《四贤记·告贷》"},"example":{"text":"争乃一碗水儿生意，怎能活～？","book":"清·李绿园《歧路灯》第81回"},"similar":["涸辙之鲋","涸辙之枯","涸辙枯鱼"],"usage":"作主语、宾语；比喻处于困境中的人","story":["战国时期，宋国庄周家贫，一次向他的朋友监河侯借粮食时，朋友推说等收了租再借给他。他给朋友讲：路上遇到一条车痕沟里水快干的鲫鱼向他求助，他答应鲫鱼说到要去吴国越国去给他借水。说完就头也不回地走了"]},{"id":29394,"word":"涸辙之鲋","pinyin":"hé zhé zhī fù","abbr":"hzzf","explanation":"涸：干；辙：车轮辗过的痕迹；鲋：鲫鱼。水干了的车沟里的小鱼。比喻在困境中急待援救的人。","source":{"text":"周昨来，有中道而呼者，周顾视车辙中，有鲋鱼焉。","book":"《庄子·外物》"},"example":{"text":"但人不能饿着静候理想世界的到来，至少也得留一点残喘，正如～，急谋升斗之水一样。","book":"鲁迅《坟·娜拉走后怎样》"},"similar":["涸辙之枯","涸辙穷鳞","涸辙穷鱼"],"opposite":["绝处逢生"],"usage":"作主语、宾语；比喻处于困境中的人","story":["战国时期，宋国庄周家贫，一次向他的朋友监河侯借粮食时，朋友推说等收了租再借给他，他讲了一个车痕沟里水快干的鲫鱼向他求助，他对鲫鱼说到吴国越国去给你借水的故事。说完就头也不回地走了"]},{"id":29395,"word":"涸辙枯鱼","pinyin":"hé zhé kū yú","abbr":"hzky","explanation":"比喻在困境中急待援救的人。同“涸辙之鲋”。","source":{"text":"吹嘘一点灵犀热，涸辙枯鱼沐浩波。","book":"明·张景《飞丸记·怜儒脱难》"},"similar":["涸辙穷鳞","涸辙穷鱼","涸辙之鲋"],"usage":"作主语、宾语；比喻处于困境中的人"},{"id":29396,"word":"涸辙穷鱼","pinyin":"hé zhé qióng yú","abbr":"hzqy","explanation":"涸：水涸，干涸；辙：车轮的痕迹。干涸的车沟里的小鱼。比喻在困境中急待援助的人。","source":{"text":"失林飞鸟无投处，涸辙穷鱼转困苦。","book":"明·张凤翼《红拂记·天开良佐》"},"similar":["涸辙枯鱼","涸辙之鱼","涸辙之枯"],"usage":"作主语、宾语；比喻处于困境中的人"},{"id":29397,"word":"涸辙穷鳞","pinyin":"hé zhé qióng lín","abbr":"hzql","explanation":"涸：水涸，干涸；辙：车轮的痕迹；鳞：指鱼。干涸的车沟里的小鱼。比喻在困境中急待援助的人。","source":{"text":"远道失夫，遐荒滞身，真如涸辙穷鳞。","book":"明·胡文焕《群音类选·》"},"similar":["涸辙穷鱼","涸辙之鲋","涸辙之鱼"],"usage":"作主语、宾语；比喻处于困境中的人"},{"id":29398,"word":"涸鱼得水","pinyin":"hé yú dé shuǐ","abbr":"hyds","explanation":"涸辙之鱼得到水。比喻绝处逢生，有所凭借。","source":{"text":"何力入延陀，如涸鱼得水，其脱必遽。","book":"《新唐书·契苾何力传》"},"example":{"text":"你的帮助简直就像～。"},"similar":["涸鲋得水","绝处逢生"],"usage":"作宾语、定语；用于危难得到解决时"},{"id":29399,"word":"涸鲋得水","pinyin":"hé fù dé shuǐ","abbr":"hfds","explanation":"比喻绝处逢生，有所凭借。同“涸鱼得水”。","source":{"text":"虽然，以当时久困地狱，渴望天日之意大利人，骤闻此语，殆如涸鲋得水，笼鸟脱樊，且距且跃，且汗且喘。","book":"梁启超《意大利建国三杰传》第六节"},"similar":["涸鱼得水","枯木逢春"],"usage":"作宾语、定语；用于危难得到解决时"},{"id":29400,"word":"淅淅沥沥","pinyin":"xī xī lì lì","abbr":"xxll","explanation":"象声词，形容轻微的风雨声、落叶声等。","source":{"text":"这里黛玉喝了两口稀粥，仍歪在床上，不想日未落时天就变了，淅淅沥沥下起雨来。","book":"清·曹雪芹《红楼梦》第45回"},"example":{"text":"今天又～地下起雨来了。"},"similar":["淅零淅留"],"usage":"作定语、状语；用于象声"},{"id":29401,"word":"淅淅飒飒","pinyin":"xī xī sà sà","abbr":"xxss","explanation":"象声词，物体发出的轻微的响声。","source":{"text":"只听得外面淅淅飒飒，又象风声，又象雨声。","book":"清·曹雪芹《红楼梦》第82回"},"usage":"作定语、状语；用于拟声"},{"id":29402,"word":"淆乱是非","pinyin":"xiáo luàn shì fēi","abbr":"xlsf","explanation":"淆乱：混淆，混乱。故意把正确的说成错误的，把错误的说成正确的，制造混乱，使是非不清。","example":{"text":"～的说法终于被制止了。"},"similar":["淆混是非","混淆是非"],"usage":"作谓语、定语；指故意制造混乱"},{"id":29403,"word":"淆乱视听","pinyin":"xiáo luàn shì tīng","abbr":"xlst","explanation":"视听：看和听。混淆是非，以扰乱人们的视听。","source":{"text":"或巧布流言蜚语，或匿名文书，害正党邪，淆乱视听。","book":"明·文秉《先拨志始》下卷"},"example":{"text":"你不能干～的事情。"},"similar":["混淆视听"],"opposite":["以正视听"],"usage":"作谓语、定语；指故意混淆"},{"id":29404,"word":"淆惑视听","pinyin":"xiáo huò shì tīng","abbr":"xhst","explanation":"故意用假象或谎言迷惑人，使人分辨不清是非真伪。","source":{"text":"第一，这些人一般都打着所谓民主的幌子，很容易淆惑视听。","book":"邓小平《坚持四项基本原则》"},"similar":["混淆视听"],"usage":"作谓语、定语；指故意用假象或谎言迷惑人"},{"id":29405,"word":"淆混是非","pinyin":"xiáo hùn shì fēi","abbr":"xhsf","explanation":"故意把正确的说成错误的，把错误的说成正确的，制造混乱，使是非不清。","source":{"text":"锢蔽见闻，淆混是非。","book":"清·陶曾佑《论文学之势力及其关系》"},"similar":["混淆是非","淆乱是非"],"usage":"作谓语、定语；指故意制造混乱"},{"id":29406,"word":"淈泥扬波","pinyin":"gǔ ní yáng bō","abbr":"gnyb","explanation":"搅浑泥水，激起波浪。比喻没有主意，随俗沉浮。","source":{"text":"世人皆浊，何不淈其泥而扬其波。","book":"战国·楚·屈原《渔父》"},"example":{"text":"世方～，而公之志独洁。","book":"明·朱之渝《高枕亭志》"},"similar":["随波逐流"],"usage":"作谓语、定语；指人没主见"},{"id":29407,"word":"淋淋漓漓","pinyin":"lín lín lí lí","abbr":"llll","explanation":"液体湿湿地淌下，指流滴的样子。","source":{"text":"那妇人方才从缸里爬得出来，头脸都吃磕破了，下半截淋淋漓漓都拖着酒浆。","book":"明·施耐庵《水浒传》第29回"},"example":{"text":"那丫头倒退了几步，一滑手，那杯茶全个儿～，都泼在彩云新衣上了。","book":"曾朴《孽海花》第15回"},"usage":"作定语、状语；用于流体事物"},{"id":29408,"word":"淋漓尽致","pinyin":"lín lí jìn zhì","abbr":"lljz","explanation":"淋漓：形容湿淋淋往下滴，比喻尽情，酣畅；尽致：达到极点。形容文章或说话表达得非常充分、透彻，或非常痛快。","source":{"text":"（刘若愚）著《酌中志略》叙次大内规制井井，而所纪客氏、魏忠贤骄横状，亦淋漓尽致，其为史家必采无疑。","book":"明·李清《三垣笔记·崇祯补遗》"},"example":{"text":"再就让我说，我也没姐姐说的这等透彻，这等～。","book":"清·文康《儿女英雄传》第三十回"},"similar":["酣畅淋漓","痛快淋漓"],"opposite":["理屈词穷"],"usage":"作定语、状语、补语；用于文章或说话"},{"id":29409,"word":"淋漓痛快","pinyin":"lín lí tòng kuài","abbr":"lltk","explanation":"淋漓：形容湿淋淋往下滴，比喻尽情，酣畅。形容文章或说话表达得非常充分、透彻。也形容非常痛快。","source":{"text":"杜律闳整，古诗序恺切，淋漓痛快，殆过于李。","book":"宋·欧阳修《释秘演诗集序》：“无所放其意，则往往从布衣野老，酣嬉淋漓，颠倒而不厌。”清·陈确《书韩柳集后附录》"},"example":{"text":"他又逐条分释，每条数百言，内有事安逸的祸源，及不明赏罚的祸源，最说得～。","book":"蔡东藩《元史演义》第五十七回"}},{"id":29410,"word":"淋漓透彻","pinyin":"lín lí tòu chè","abbr":"lltc","explanation":"淋漓：形容湿淋淋往下滴，比喻尽情，酣畅。形容文章或说话表达得非常充分、透彻。也形容非常痛快。","source":{"text":"怎么他竟变成了一个人？这些话竟讲得淋漓透彻。","book":"清·颐琐《黄绣球》第三回"},"example":{"text":"统计一篇奏牍，约有数千言，直说得～，慷慨激昂。","book":"蔡东藩《宋史演义》第六十六回"}},{"id":29411,"word":"淑人君子","pinyin":"shū rén jūn zǐ","abbr":"srjz","explanation":"指善良贤惠，公道正直的人。","source":{"text":"淑人君子，其仪一兮。","book":"《诗经·曹风·鸤鸠》"},"example":{"text":"晋·陆机《汉高祖功臣颂》：“～，实邦之基。”"},"similar":["正人君子"],"usage":"作主语、宾语、定语；用于书面语"},{"id":29412,"word":"淑性茂质","pinyin":"shū xìng mào zhì","abbr":"sxmz","explanation":"淑：和善；茂：美好。形容性情和善，品质美好。","source":{"text":"淑性茂质，为九烟所重。","book":"唐·李朝威《柳毅传》"}},{"id":29413,"word":"淑质英才","pinyin":"shū zhì yīng cái","abbr":"szyc","explanation":"淑：善良；英：非凡。善良的品质，非凡的才能。","source":{"text":"字正平，淑质贞亮，英才卓砾。","book":"《后汉书·祢衡传》"},"usage":"作宾语、定语；用于夸奖人","story":["东汉时期，平原郡人祢衡，字正平，年轻时十分有才华与文采，人们夸他有淑质英才，但性情高傲与刚强，喜欢矫时慢物，少与人交往。建安年初到都城许昌游历，刚到颍川时，朋友给他一个大人物的名帖，祢衡揣在身上，直到名帖字迹模糊也没去找他"]},{"id":29414,"word":"淑质贞亮","pinyin":"shū zhì zhēn liàng","abbr":"szzl","explanation":"淑：善良；贞：坚贞；亮：诚信质直。品质善良，为人诚信质直。","source":{"text":"字正平，淑质贞亮，英才卓砾。","book":"汉·孔融《荐祢衡表》"},"usage":"作谓语、定语；指人的品性"},{"id":29415,"word":"淘沙取金","pinyin":"táo shā qǔ jīn","abbr":"tsqj","explanation":"指淘金。","source":{"text":"我朝任人如淘沙取金，剖石采玉，皆得其精粹。","book":"五代·王仁裕《开元天宝遗事·任人如市瓜》"},"similar":["淘沙得金"],"usage":"作宾语、定语；指去粗取精"},{"id":29416,"word":"淘沙得金","pinyin":"táo shā dé jīn","abbr":"tsdj","explanation":"用水选的方法从沙子里取得真金。比喻除去杂质，提取精华。也比喻费力大而成效少。","source":{"text":"破矿得金，淘沙得金，扬灰终身，无得金也。","book":"《关尹子》"},"example":{"text":"隔日一删，逾月一改，始能～，无瑕瑜互见之失也。","book":"清·李渔《闲情偶寄·词曲》"},"similar":["淘沙取金"],"opposite":["泥沙俱下"],"usage":"作宾语、定语；指去粗取精"},{"id":29417,"word":"淡写轻描","pinyin":"dàn xiě qīng miáo","abbr":"dxqm","explanation":"犹细写细描。指描写细致。","source":{"text":"笔调是沉静得很的，人物性格是淡写轻描而又能深刻表现的。","book":"郁达夫《闲书》"},"example":{"text":"小说不妨纡徐曲折，～。","book":"黄远庸《新剧杂论·说脚本》"},"similar":["轻描淡写"],"usage":"作谓语、定语、状语；指一笔带过"},{"id":29418,"word":"淡妆浓抹","pinyin":"dàn zhuāng nóng mǒ","abbr":"dznm","explanation":"妆：化妆；抹：抹粉。指淡雅和浓艳两种不同的妆饰打扮。","source":{"text":"欲把西湖比西子，淡妆浓抹总相宜。","book":"宋·苏轼《饮湖上初晴后雨》诗"},"example":{"text":"衣裳着得也俏，～，总称他的高兴。","book":"清·彭养鸥《黑籍冤魂》第18回"},"similar":["淡抹浓妆"],"usage":"作谓语、定语、宾语；指两种打扮","story":["宋朝时期，礼部尚书苏东坡因反对新法，屡次遭贬，先后被贬至杭州、黄州、惠州、琼州等地。官场上的不如意，使他热衷于文学创作。他在杭州期间见到美丽的西湖即兴作《饮湖上初晴后雨》诗：“欲把西湖比西子，淡妆浓抹总相宜。”"]},{"id":29419,"word":"淡妆轻抹","pinyin":"dàn zhuāng qīng mò","abbr":"dzqm","explanation":"略加妆饰打扮。","source":{"text":"只见那妇人从楼上下来，不敢十分穿重孝，只是淡妆轻抹。","book":"《水浒传》第四五回"},"opposite":["浓妆艳抹"],"usage":"作谓语、宾语、定语；指化妆"},{"id":29420,"word":"淡扫蛾眉","pinyin":"dàn sǎo é méi","abbr":"dsem","explanation":"轻淡地画眉。指妇女淡雅的化妆。","source":{"text":"却嫌脂粉污颜色，淡扫蛾眉朝至尊。","book":"唐·张祜《集灵台》诗之二"},"example":{"text":"～，巧妆时样打扮，十分娇态。","book":"明·孙仁孺《东郭记·其妻妾不羞也》"},"usage":"作谓语、宾语；指化妆"},{"id":29421,"word":"淡抹浓妆","pinyin":"dàn mǒ nóng zhuāng","abbr":"dmnz","explanation":"淡：浅，薄；抹：抹粉；浓：密、厚；妆：化妆。指淡雅和浓艳两种不同的妆饰打扮。","source":{"text":"淡抹浓妆意态殊，居然重复见西湖。","book":"柳亚子《浙游杂诗》"},"similar":["淡妆浓抹"],"usage":"作谓语、定语、宾语；指两种打扮"},{"id":29422,"word":"淡水之交","pinyin":"dàn shuǐ zhī jiāo","abbr":"dszj","explanation":"友情像水一样清澈。指不以势利为基础的朋友。","source":{"text":"且君子之交淡若水，小人之交甘若醴；君子淡以亲，小人甘以绝。","book":"《庄子·山木》"},"example":{"text":"安宅与不佞游，于今六七年，～，始终如一。","book":"明·朱之瑜《与奥村庸礼书二十二首》"}},{"id":29423,"word":"淡水交情","pinyin":"dàn shuǐ jiāo qíng","abbr":"dsjq","explanation":"友情像水一样清澈。指不以势利为基础的朋友。","source":{"text":"且君子之交淡若水，小人之交甘若醴；君子淡以亲，小人甘以绝。","book":"《庄子·山木》"},"example":{"text":"《阳春》曲调高难和，～老始知。","book":"唐·白居易《张十八员外以新诗二十五首见寄》"},"similar":["君子之交"],"usage":"作主语、宾语；指君子之交"},{"id":29424,"word":"淡汝浓抹","pinyin":"dàn zhuāng nóng mǒ","abbr":"drnm","explanation":"妆：装饰；抹：涂抹。形容素雅和艳丽两种不同的装饰。","source":{"text":"欲把西湖比西子，淡装浓抹总相宜。","book":"宋·苏轼《饮湖上初晴后雨》诗"},"example":{"text":"头梳得也时，衣裳穿得也俏，～，总称他的高兴。","book":"《晚清文学丛钞·黑籍冤魂》第四十八回"}},{"id":29425,"word":"淡泊以明志，宁静以致远","pinyin":"dàn bó yǐ míng zhì，níng jìng yǐ zhì yuǎn","abbr":"dbymznjyzy","explanation":"淡泊：恬淡寡欲；宁静：安宁恬静；致：达到。不追求名利，生活简朴以表现自己高尚的情趣；心情平稳沉着，才可有所作为。","source":{"text":"是故非淡薄无以明德，非宁静无以致远，非宽大无以兼覆。","book":"汉·刘安《淮南子·主术训》"},"example":{"text":"我们要做到～。"},"usage":"作宾语、分句；指人的修养"},{"id":29426,"word":"淡泊明志","pinyin":"dàn bó míng zhì","abbr":"dbmz","explanation":"指不追求名利才能使志趣高洁。","source":{"text":"非淡泊无以明志，非宁静无以致远。","book":"三国·蜀·诸葛亮《戒子书》"},"example":{"text":"至于宽闲之野，寂寞之滨，每自寓其天怀之乐，而～，宁静致远，未尝不处处流露。","book":"清·无名氏《杜诗言志》卷三"},"similar":["平平淡淡"],"opposite":["争权夺利"],"usage":"作谓语、定语；指不追求名利"},{"id":29427,"word":"淡然处之","pinyin":"dàn rán chǔ zhī","abbr":"drcz","explanation":"淡然：不经心，不在意；处：处理，对待。以漫不经心的态度对待事物。","example":{"text":"我们对此不能～，要引起高度重视。"},"similar":["淡泊明志"],"opposite":["认认真真","勇往直前"],"usage":"作谓语；指态度冷淡"},{"id":29428,"word":"淡然置之","pinyin":"dàn rán zhì zhī","abbr":"drzz","explanation":"很冷淡地放在一旁。形容毫不在意。","source":{"text":"不过他经的大风大浪太多，虽未到宠辱不惊，名利皆忘的境地，却已能不动声色，淡然置之。","book":"高阳《清宫外史》下册"},"example":{"text":"我对此事～。"},"similar":["淡然处之"],"usage":"作谓语、定语；用于处事"},{"id":29429,"word":"淡而不厌","pinyin":"dàn ér bù yàn","abbr":"deby","explanation":"比喻既不热心也不厌弃。","source":{"text":"淡而不厌者陶潜，则王维可废也。","book":"章炳麟《辨诗》"},"example":{"text":"大家有的看着那两辆车～的微笑，有的叼着小烟袋坐着，连头也不抬。","book":"老舍《骆驼祥子》一"},"similar":["漫不经心"],"usage":"作谓语、定语；指漫不经心"},{"id":29430,"word":"淡而无味","pinyin":"dàn ér wú wèi","abbr":"deww","explanation":"淡：薄，与“浓”相对。菜肴因盐少而没有味道。亦泛指清淡无味。亦形容说话、写文章内容平淡，无趣味。","source":{"text":"此工夫似淡而无味，然做时却自有可乐。","book":"宋·朱熹《朱子语类辑略》第四卷"},"example":{"text":"他的味觉变了，不能再喝浓烈苦涩的茶，只好喝一点～的白开水。","book":"叶圣陶《线下·孤独》"},"similar":["平淡无奇"],"opposite":["津津有味","耐人寻味"],"usage":"作谓语、定语；指清淡"},{"id":29431,"word":"淡饭黄齑","pinyin":"dàn fàn huáng jī","abbr":"dfhj","explanation":"泛指很差的饭菜。","source":{"text":"住的是小窗茅屋疏篱，吃的是粗羹淡饭黄齑，穿的是破帽歪靴布衣。","book":"元·马致远《荐福碑》第四折：“今日个列鼎而食，煞强如淡饭黄齑。”元·费唐臣《贬黄州》第三折"}},{"id":29432,"word":"淫学流说","pinyin":"yín xué liú shuō","abbr":"yxls","explanation":"淫：浮华。指不合正道的邪说或没有根据的言论。","source":{"text":"至治之世，其民不好空言虚辞，不好淫学流说。","book":"《孟子·滕文公下》：“闲先圣之道，距杨、墨，放淫辞邪说者不得作。”《吕氏春秋·知度》"},"usage":"作宾语、定语；多用于说话"},{"id":29433,"word":"淫心匿行","pinyin":"yín xīn nì xíng","abbr":"yxnx","explanation":"指思想邪乱、行为不正。","source":{"text":"后三日，复徙军于隽李，斩有罪者三人以徇于军日：‘其淫心匿行不当敌者如斯矣。’","book":"汉·赵哗《吴越春秋·勾践伐吴外传》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":29434,"word":"淫朋密友","pinyin":"yín péng mì yǒu","abbr":"ypmy","explanation":"亲近密切的朋友。","source":{"text":"水侧有凉堂，结飞梁于水上，左右杂树交阴，希见曦景。至有淫朋密友，羁游宦子，莫不寻梁契集，用相娱慰。","book":"北魏·郦道元《水经注·晋水》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":29435,"word":"淫朋狎友","pinyin":"yín péng xiá yǒu","abbr":"ypxy","explanation":"不正派的亲密朋友。","source":{"text":"［姚公子］自恃富足有余，豪奢成习。好往来这些淫朋狎友，把言语奉承他，哄诱他，说是自古豪杰英雄，必然不事生产，手段慷慨，不以财物为心，居食为志，方是侠烈之士。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"usage":"作主语、宾语、定语；用于书面语"},{"id":29436,"word":"淫猥下流","pinyin":"yín wěi xià liú","abbr":"ywxl","explanation":"放荡淫乱，指人纵欲乱为。","example":{"text":"对于～的恶魔一定要严惩不贷。"},"usage":"作谓语、定语、状语；用于为人"},{"id":29437,"word":"淫荒无度","pinyin":"yín huāng wú dù","abbr":"yhwd","explanation":"淫：淫乱；度：限度；荒：荒唐。形容征逐酒色，生活糜烂。","source":{"text":"人生行乐耳，须富贵何时。是日也，拂衣而喜，奋袖低昂，顿足起舞，诚淫荒无度，不知其不可也。","book":"汉·杨恽《报孙会宗书》"},"example":{"text":"～，法令滋彰；教绝四维，刑参五虐。","book":"《北史·隋本纪》"},"similar":["荒淫无度"],"usage":"作谓语、定语、宾语；指生活糜烂"},{"id":29438,"word":"淫言媟语","pinyin":"yín yán liǎng yǔ","abbr":"yyxy","explanation":"轻狎的言词；淫秽猥亵的言词。","source":{"text":"淫言媟语，冬寒夏热，人人肌骨，不可除去。","book":"唐·杜牧《唐故平卢军节度巡官陇西李府君墓志铭》"},"example":{"text":"清·宋永岳《志异续编·殷循复》：“窃以为文公乃唐时一代人杰，何至～，见于咏歌？”"},"similar":["淫言狎语"],"usage":"作宾语、定语；用于书面语"},{"id":29439,"word":"淫言狎语","pinyin":"yín yán xiá yǔ","abbr":"yyxy","explanation":"轻狎的言词；淫秽猥亵的言词。同“淫言媟语”。","source":{"text":"（襄城）一日偶至书院中，见案上一帙，观之，乃春画也。每幅有洪诗，多淫言狎语，遂为逐客。","book":"明·郎瑛《七修类稿·诗文·洪遂初》"},"similar":["淫言媟语"],"usage":"作宾语、定语；用于书面语"},{"id":29440,"word":"淫言诐行","pinyin":"yín yán bì xíng","abbr":"yybx","explanation":"指不正当的言行。","source":{"text":"淫言诐行诡怪之术，不足以辅世，则无所容乎其时。","book":"宋·王安石《虔州学记》"},"usage":"作主语、宾语；用于书面语"},{"id":29441,"word":"淫词亵语","pinyin":"yín cí xiè yǔ","abbr":"ycxy","explanation":"淫荡猥亵的言词。亦作“淫词秽语”。","source":{"text":"改之（刘改之）全学稼轩皮毛，不则即为《沁园春》等调，淫词亵语，污秽词坛。","book":"清·陈廷焯《白雨斋词话》第一卷"},"similar":["淫词秽语"],"usage":"作宾语、定语；用于说话等"},{"id":29442,"word":"淫词媟语","pinyin":"yín cí xiè yǔ","abbr":"ycxy","explanation":"淫：淫秽；媟：狎，轻慢。放荡淫秽、低级趣味的话。","source":{"text":"子父女母，交口教授，淫言媟语，冬寒夏热，入人肌骨，不可除去。","book":"唐·杜牧《唐故平卢军节度巡官陇西李府君墓志铭》"},"example":{"text":"杜牧尝讥元白云：“～，入人肌肤，吾恨不在位，不得以法治之。”","book":"明·杨慎《升庵诗话》卷九"}},{"id":29443,"word":"淫词秽语","pinyin":"yín cí huì yǔ","abbr":"ychy","explanation":"淫荡猥亵的言词。同“淫词亵语”。","source":{"text":"若南唐女冠，淫词秽语，污人闺耳。","book":"明·田艺蘅《留青日札》第21卷"},"example":{"text":"～，概所不录。","book":"清·李汝珍《镜花缘》第一回"},"similar":["淫词亵语"],"usage":"作主语、宾语、定语；指下流话"},{"id":29444,"word":"淫词艳曲","pinyin":"yín cí yàn qǔ","abbr":"ycyq","explanation":"黄色的、不健康的诗歌、词曲。","source":{"text":"你这该死的胡说！好好的把这淫词艳曲弄了来，还学了这些混话来欺负我。我告诉舅舅舅母去。","book":"清·曹雪芹《红楼梦》第23回"},"example":{"text":"这些～早该取缔了。"},"usage":"作主语、宾语、定语；指黄色歌曲"},{"id":29445,"word":"淫词艳语","pinyin":"yín cí yàn yǔ","abbr":"ycyy","explanation":"淫：淫荡；艳：香艳。淫秽下流的言辞。","source":{"text":"淫词艳语有害于人心风俗。","book":"清·江顺诒《词学集成》卷五"}},{"id":29446,"word":"淫辞秽语","pinyin":"yín cí huì yǔ","abbr":"ychy","explanation":"淫：淫荡；秽：肮脏。指轻薄猥亵的下流话。","source":{"text":"淫词秽语，概所不录。","book":"清·李汝珍《镜花缘》第一回"},"similar":["淫词秽语"],"usage":"作主语、宾语、定语；用于说话等"},{"id":29447,"word":"淫辞邪说","pinyin":"yín cí xié shuō","abbr":"ycxs","explanation":"夸大失实的言论，荒谬的学说。","source":{"text":"头先圣之道，距杨、墨，放淫辞邪说者不得作。","book":"《孟子·滕文公下》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":29448,"word":"淮南鸡犬","pinyin":"huái nán jī quǎn","abbr":"hnjq","explanation":"淮南王的鸡和狗。比喻投靠别人而得势的人。","source":{"text":"淮南王刘安坐反而死，天下并闻，当时并见，儒书尚有言其得道仙去，鸡犬升天者。","book":"汉·王充《论衡·道虚》"},"example":{"text":"逐臭吞膻事可怜，～早成仙。","book":"柳亚子《题〈饮冰室集〉》"},"similar":["淮王鸡狗","鸡犬升天"],"usage":"作宾语、定语；指投靠别人而得势的人","story":["汉高祖刘邦的孙子淮南王刘安十分信奉道教，为了长生不老，他找到八公仙翁，按照八公仙翁的话炼制仙丹。丹药炼成后，刘安吃下觉得自己轻飘飘的升天而去。庭院里的鸡狗抢着吃剩下的丹药也纷纷飞上天成了仙"]},{"id":29449,"word":"淮橘为枳","pinyin":"huái jú wéi zhǐ","abbr":"hjwz","explanation":"淮南的橘树，移植到淮河以北就变为枳树。比喻环境变了，事物的性质也变了。","source":{"text":"婴闻之：橘生淮南则为橘，生于淮北则为枳，叶徒相似，其实味不同。所以然者何？水土异也。","book":"《晏子春秋·杂下之十》"},"example":{"text":"此中大半，皆西洋以富以强之基，而自吾人行之，则～，若存若亡，不能实收其效者，则又何也？","book":"严复《原强》"},"usage":"作谓语、分句；用于人或事物"},{"id":29450,"word":"淮王鸡犬","pinyin":"huái wáng jī quǎn","abbr":"hwjq","explanation":"淮王：西汉淮南王刘安。淮南王家的鸡和狗。比喻攀附别人而得势的人。","source":{"text":"我本淮王旧鸡犬，不随仙去落人间。","book":"清·吴伟业《过淮阴有感》"},"similar":["淮王鸡狗","淮南鸡犬"],"usage":"作宾语、定语；指投靠别人而得势的人"},{"id":29451,"word":"淮王鸡狗","pinyin":"huái wáng jī gǒu","abbr":"hwjg","explanation":"比喻攀附别人而得势的人。","source":{"text":"时人传八公、安临去时，余药器置在中庭。鸡犬舐啄之，尽得升天。","book":"晋·葛洪《神仙传·刘安》"},"example":{"text":"神仙侣～，衣冠队楚国猕猴。","book":"清·朱彝尊《折桂令》词"},"similar":["鸡犬升天","淮王鸡犬","淮南鸡犬"],"usage":"作宾语、定语；指投靠别人而得势的人","story":["汉高祖刘邦的孙子淮南王刘安十分信奉道教，为了长生不老，他找到八公仙翁，按照八公仙翁的话炼制仙丹。丹药炼成后，刘安吃下觉得自己轻飘飘的升天而去。庭院里的鸡狗抢着吃剩下的丹药也纷纷飞上天成了仙"]},{"id":29452,"word":"深不可测","pinyin":"shēn bù kě cè","abbr":"sbkc","explanation":"深得无法测量。比喻对事物的情况捉摸不透。","source":{"text":"山下石骨为匠者搜去，积水为潭，望之洞黑如墨汁，深不可测。","book":"明·袁宏道《吼山》"},"example":{"text":"隆武帝～地微笑。","book":"华而实《汉衣冠》一"},"similar":["高深莫测"],"opposite":["一目了然"],"usage":"作谓语、定语、状语；指对事物捉摸不透"},{"id":29453,"word":"深中笃行","pinyin":"shēn zhōng dǔ xíng","abbr":"szdx","explanation":"指内心廉正，行为淳厚。","source":{"text":"其人（壶遂）深中笃行君子。","book":"《汉书·韩安国传》"},"similar":["深中隐厚"],"usage":"作谓语、定语；用于为人"},{"id":29454,"word":"深中肯綮","pinyin":"shēn zhōng kěn qǐng","abbr":"szkq","explanation":"比喻分析深刻，能击中要害，或能说到点子上。","example":{"text":"这篇文章不长，但是论点明确，深中肯綮，有很强的说服力。"},"usage":"作谓语、定语；用于说话或文章等"},{"id":29455,"word":"深中隐厚","pinyin":"shēn zhōng yǐn hòu","abbr":"szyh","explanation":"指内心廉正忠厚。","source":{"text":"余与壶遂定律历，观韩长孺之义，壶遂之深中隐厚。世之言梁多长者，不虚哉！","book":"《史记·韩长孺列传论》"},"example":{"text":"盖公之～，可验于是矣。","book":"宋·叶適《兵部尚书蔡公墓志铭》"},"similar":["深中笃行"],"usage":"作谓语、定语、宾语；用于为人"},{"id":29456,"word":"深于城府","pinyin":"shēn yú chéng fǔ","abbr":"sycf","explanation":"比喻为人用心深远，令人难以揣测。","source":{"text":"性深阻若城府，而能宽绰以容纳。","book":"《晋书·愍帝纪论》"},"example":{"text":"以盛文颐的～、工于心计，想来对自己的将来，一定想过；不知如何安排？","book":"高阳《粉墨春秋》第二部第十三章"}},{"id":29457,"word":"深仁厚泽","pinyin":"shēn rén hòu zé","abbr":"srhz","explanation":"指深厚的仁爱和恩惠。","source":{"text":"初，天圣、明道之间，太祖、太宗、真宗以深仁厚泽涵养天下盖七十年。","book":"宋·陈亮《书〈欧阳文粹〉后》"},"example":{"text":"我待你还要怎样的～，你公然同奸贼们串通在起，对我加以诽谤。","book":"郭沫若《高渐离》第五幕"},"usage":"作宾语、定语；用于书面语"},{"id":29458,"word":"深仇大恨","pinyin":"shēn chóu dà hèn","abbr":"scdh","explanation":"深而大的仇恨。","source":{"text":"从今后深仇积恨都消解。","book":"元·杨显之《酷寒亭》第四折"},"example":{"text":"多年积压的～，象火山的岩浆一样从江水山的身上暴发了！","book":"冯德英《迎春花》第二章"},"similar":["血海深仇","新仇旧恨"],"opposite":["救命之恩","恩重如山"],"usage":"作主语、宾语；形容双方矛盾很深"},{"id":29459,"word":"深仇宿怨","pinyin":"shēn chóu xiǔ yuàn","abbr":"scxy","explanation":"犹深仇大恨。深而大的仇恨。","source":{"text":"甚至彼此之间深仇宿怨的人也在‘抗日第一’的前提下，一致携手。","book":"董必武《反侵略声中纪念钱亦石先生》"},"similar":["深仇大恨","深仇积恨"],"usage":"作主语、宾语；形容双方矛盾很深"},{"id":29460,"word":"深仇积恨","pinyin":"shēn chóu jī hèn","abbr":"scjh","explanation":"深而大的仇恨。形容仇恨极深。","source":{"text":"从今后深仇积恨都消解。","book":"元·杨显之《酷寒亭》第四折"},"example":{"text":"见及此而犹作此阴谋，宁非有～于国家，必绝其命而始快，此四万万人所宜共诛也！","book":"丁中江《北洋军阀史话》七十"},"similar":["深仇大恨","深仇宿怨"],"usage":"作主语、宾语；形容双方矛盾很深"},{"id":29461,"word":"深仇重怨","pinyin":"shēn chóu zhòng yuàn","abbr":"sczy","explanation":"怨：仇恨。极深极大的仇恨。","source":{"text":"在邻近闹攘一下当然不会成什么深仇重怨。","book":"鲁迅《且介亭杂文·阿金》"},"usage":"作主语、宾语、定语；用于人际关系等"},{"id":29462,"word":"深信不疑","pinyin":"shēn xìn bù yí","abbr":"sxby","explanation":"非常相信，没有一点怀疑。","source":{"text":"慰藉翁者，咸以为道路讹传，惟翁则深信不疑。","book":"清·蒲松龄《聊斋志异·梦狼》"},"example":{"text":"你不能对他的话～。"},"similar":["毫不怀疑"],"opposite":["疑神疑鬼","疑心生鬼"],"usage":"作主语、谓语；形容对事对人非常相信"},{"id":29463,"word":"深入不毛","pinyin":"shēn rù bù máo","abbr":"srbm","explanation":"不毛：指不生长庄稼的贫瘠土地或地带。深入到荒凉的地方。","source":{"text":"故五月渡泸，深入不毛，并日而食，臣非不自惜也。","book":"《三国志·蜀志·诸葛亮传》"},"example":{"text":"今丞相亲提士卒，～，收服蛮方；目今蛮王既已归服，何不置官吏，与孟获一同守之？","book":"明·罗贯中《三国演义》第九十回"}},{"id":29464,"word":"深入人心","pinyin":"shēn rù rén xīn","abbr":"srrx","explanation":"指理论、学说、政策等为人们深切了解和信服。","source":{"text":"且君新得诸侯，非有存亡兴灭之德，深入人心，恐诸侯之兵，不为我用。","book":"明·冯梦龙《东周列国志》第二十回"},"example":{"text":"可是总没有这位先生的讲说那样一句句～。","book":"叶圣陶《英文教授》"},"similar":["家喻户晓"],"opposite":["不得人心"],"usage":"作谓语、宾语；指受到拥护"},{"id":29465,"word":"深入显出","pinyin":"shēn rù xiǎn chū","abbr":"srxc","explanation":"指讲话或文章的内容深刻，语言文字却浅显易懂。","source":{"text":"指讲话或文章的内容深刻，语言文字却浅显易懂。"},"example":{"text":"清·俞樾《湖楼笔谈》：“盖诗人用意之妙，在乎～。入之不深，则有浅易之病，出之不显，则有艰涩之患。”"},"similar":["深入浅出"],"usage":"作谓语、定语、状语；指讲话或文章"},{"id":29466,"word":"深入浅出","pinyin":"shēn rù qiǎn chū","abbr":"srqc","explanation":"指讲话或文章的内容深刻，语言文字却浅显易懂。","source":{"text":"盖诗人用意之妙，在乎深入显出。入之不深，则有浅易之病；出之不显，则有艰涩之患。","book":"清·俞樾《湖楼笔谈》六"},"example":{"text":"这篇文章写得～，使人爱看、易懂。"},"similar":["深入显出"],"opposite":["深文奥义","隐晦曲折"],"usage":"作谓语、定语、状语；指讲话或文章"},{"id":29467,"word":"深入细致","pinyin":"shēn rù xì zhì","abbr":"srxz","explanation":"细致：精细周密。深入而精细周密。","source":{"text":"主席对战士那种无微不至的关怀，深入细致的作风，给我留下了难忘的印象。","book":"徐海东《奠基礼》"},"example":{"text":"我们得～去调查研究。"},"usage":"作定语、状语；指很认真的态度"},{"id":29468,"word":"深入膏肓","pinyin":"shēn rù gāo huāng","abbr":"srgh","explanation":"指毛病已经无可救药。","source":{"text":"我在广播时也曾考虑到这讳病忌医的深入膏肓的毛病，但我把话说得委婉了一些，结果倒也没有触犯到那一片的逆鳞。","book":"郭沫若《洪波曲》第十章六"},"similar":["病入膏肓"],"usage":"作谓语、定语；用于事物或人"},{"id":29469,"word":"深入骨髓","pinyin":"shēn rù gǔ suǐ","abbr":"srgs","explanation":"形容达到极深极重的程度。","source":{"text":"高太尉着令医人治疗，见丘岳重伤，恨梁山泊深入骨髓。","book":"明·施耐庵《水浒传》第八十回"},"usage":"作谓语、定语；用于比喻句"},{"id":29470,"word":"深切着明","pinyin":"shēn qiē zhe míng","abbr":"sqzm","explanation":"指深刻而显明。"},{"id":29471,"word":"深切着白","pinyin":"shēn qiē zhe bái","abbr":"sqzb","explanation":"指深刻而显明。同“深切着明”。"},{"id":29472,"word":"深切著明","pinyin":"shēn qiè zhù míng","abbr":"sqzm","explanation":"深刻而显明。","source":{"text":"子曰：‘我欲载之空言，不如见之于行事之深切著明也。’","book":"《史记·太史公自序》"},"example":{"text":"乃其所言者，虽不～，显道之藏，立学之准，而固尝尽非也。","book":"清·王夫之《尚书引义·说命》"},"similar":["深切著白"],"usage":"作谓语、定语；用于书面语"},{"id":29473,"word":"深切著白","pinyin":"shēn qiè zhù bái","abbr":"sqzb","explanation":"深刻而显明。同“深切著明”。","source":{"text":"观足下之文……深切著白，使其人果举而行之，则足下虽未得位，而泽固施于民矣。","book":"宋·司马光《与薛子立秀才书》"},"similar":["深切著明"],"usage":"作谓语、定语；用于书面语"},{"id":29474,"word":"深刺腧髓","pinyin":"shēn cì shù suǐ","abbr":"scss","explanation":"穿穴入骨。形容深透理解。腧，穴位。","source":{"text":"使读者剖幽析微，深刺腧髓，渠不开其智。","book":"宋·叶適《〈覆瓿集〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":29475,"word":"深厉浅揭","pinyin":"shēn lì qiǎn qì","abbr":"slqq","explanation":"厉：连衣涉水；揭：撩起衣服。意思是涉浅水可以撩起衣服；涉深水撩起衣服也没有用，只得连衣服下水。比喻处理问题要因地制宜。","source":{"text":"深厉浅揭，随时为义，曾何贪于支离，而席其孤技邪？","book":"《诗经·邶风·匏有苦叶》：“深则厉，浅则揭。”《后汉书·张衡传》"},"example":{"text":"少年性情，风事风生，坐在河滩，早已脱鞋解袜，准备～。","book":"清·李绿园《歧路灯》第七十三回"},"similar":["因地制宜","相机行事"],"usage":"作谓语、定语；指行动适宜"},{"id":29476,"word":"深图远算","pinyin":"shēn tú yuǎn suàn","abbr":"stys","explanation":"指计划得很周密，考虑得很长远。同“深谋远虑”。","source":{"text":"议者多非光武不以功臣任职，至使英姿茂绩，委而勿用。然原夫深图远算，固将有以焉尔。","book":"《后汉书·朱祐景丹等传论》"},"similar":["深谋远虑","深猷远计"],"usage":"作谓语、宾语、定语；指计划得很周密"},{"id":29477,"word":"深图远虑","pinyin":"shēn tú yuǎn lǜ","abbr":"styl","explanation":"指计划得很周密，考虑得很长远。","source":{"text":"又况愚人之愚，而望其遵巡正路，谦虚节俭，深图远虑，为国家校计者乎。","book":"汉·仲长统《昌言下》"},"similar":["深谋远虑","深谋远略","深谋远猷"],"usage":"作谓语、宾语、定语；指计划得很周密"},{"id":29478,"word":"深壁固垒","pinyin":"shēn bì gù lěi","abbr":"sbgl","explanation":"犹深沟高垒。深的战壕和高的营垒。指坚固的防御工事。","source":{"text":"宜顿兵所在，深壁固垒，至秋不了，乃进大军。","book":"《晋书·蔡豹传》"},"similar":["深沟高垒"],"usage":"作主语、宾语、定语；多用于军事等"},{"id":29479,"word":"深奥莫测","pinyin":"shēn ào mò cè","abbr":"samc","explanation":"高深不易了解。","example":{"text":"小王最近几天都一副～的样子，不知葫芦里卖的是什么药。"}},{"id":29480,"word":"深奸巨滑","pinyin":"shēn jiān jù huá","abbr":"sjjh","explanation":"奸：邪恶；猾：狡猾。形容人深于世故、奸诈狡猾。","source":{"text":"若有深奸巨滑，伤化败结，悖乱人伦，不忠不孝。","book":"《周书·苏绰传》"},"example":{"text":"对于～的老狐狸，我们要认真对待。"},"similar":["老奸巨滑"],"opposite":["老实巴交"],"usage":"作谓语、定语；指人奸诈"},{"id":29481,"word":"深奸巨猾","pinyin":"shēn jiān jù huá","abbr":"sjjh","explanation":"犹老奸巨猾。形容世故深而手段极其奸诈狡猾的人。","source":{"text":"若有深奸巨猾，伤化败俗，悖乱人伦，不忠不孝，故为背道者，杀一利百，以清王化，重刑可也。","book":"《周书·苏绰传》"},"similar":["深奸巨滑"],"opposite":["老实巴交"],"usage":"作谓语、定语；指人奸诈"},{"id":29482,"word":"深孚众望","pinyin":"shēn fú zhòng wàng","abbr":"sfzw","explanation":"在群众中享有威望，使大家信服。","source":{"text":"该提督老于戎事，忠爱性成……深孚众望，其朴诚忠勇，早在圣明洞鉴之中。","book":"清·刘坤一《提臣应行陛见暂请展缓折》"},"example":{"text":"路遥《平凡的世界》第六卷第50章：“～的金老先生精通孔孟学说。”"},"usage":"作谓语、定语；用于书面语"},{"id":29483,"word":"深宅大院","pinyin":"shēn zhái dà yuàn","abbr":"szdy","explanation":"房屋多厕而有围墙的院子。旧时多指富贵人家。","source":{"text":"他每待强巴劫深宅大院，便侍折摧了舞榭歌楼。","book":"元·关汉卿《救风尘》第二折"},"example":{"text":"婶子在里面住着，～，那里就知道了。（清·曹雪芹《红楼梦》第六十四回）"},"similar":["豪门大宅"],"opposite":["篷门筚户"],"usage":"作主语、宾语、定语；指富贵人家的住宅"},{"id":29484,"word":"深居简出","pinyin":"shēn jū jiǎn chū","abbr":"sjjc","explanation":"简：简省。原指野兽藏在深密的地方，很少出现。后指常呆在家里，很少出门。","source":{"text":"夫兽深居而简出，惧物之为己害也，犹且不脱焉。","book":"唐·韩愈《送浮屠文畅师序》"},"example":{"text":"自摈弃以来，尤自刻励，～，几不与世人相通。","book":"宋·秦观《谢王学士书》"},"similar":["闭门谢客","离群索居"],"opposite":["抛头露面"],"usage":"作谓语、定语、状语；形容不与人来往"},{"id":29485,"word":"深山大泽","pinyin":"shēn shān dà zé","abbr":"ssdz","explanation":"形容深邃的山野和广阔的湖泽。引申为远离城市的穷乡僻壤。","source":{"text":"深山大泽，实生龙蛇。","book":"《左传·僖公二十三年》"},"example":{"text":"它奔泄千里，所经过的有～，有禾田花岸，有各种风物，有各种情绪。","book":"孙犁《论情节》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":29486,"word":"深山密林","pinyin":"shēn shān mì lín","abbr":"ssml","explanation":"与山外、林外距离远的、人迹罕至的山岭、森林。","source":{"text":"我看见怒涛中的渔夫，战壕中的兵士，摩托车中的贵人，洋场上的投机家，深山密林中的豪杰。","book":"鲁迅《彷徨·伤逝》"},"similar":["深山穷林","深山老林"],"usage":"作主语、宾语、定语；用于口语"},{"id":29487,"word":"深山幽谷","pinyin":"shēn shān yōu gǔ","abbr":"ssyg","explanation":"与山外距离远、人迹罕至的山岭、山谷。","source":{"text":"寝吾庭者，不愿深山幽谷。","book":"《列子·黄帝》"},"similar":["深山长谷","深山野墺"],"usage":"作主语、宾语、定语；用于书面语"},{"id":29488,"word":"深山穷林","pinyin":"shēn shān qióng lín","abbr":"ssql","explanation":"与山外、林外距离远的、人迹罕至的山岭、森林。","source":{"text":"且夫乳穴必在深山穷林，冰雪之所储，豺虎之所庐。","book":"唐·柳宗元《零都郡复乳穴记》"},"similar":["深山密林","深山老林"],"usage":"作主语、宾语、定语；用于口语"},{"id":29489,"word":"深山穷谷","pinyin":"shēn shān qióng gǔ","abbr":"ssqg","explanation":"与山外距离远、人迹罕至的山岭、山谷。","source":{"text":"其藏冰也，深山穷谷，固阴冱寒，于是乎取之。","book":"《左传·昭公四年》"},"example":{"text":"一直走到～之中，绝无人烟之地，与木石居，与鹿豕游去了。","book":"清·吴研人《二十年目睹之怪现状》第一回"},"similar":["穷乡僻壤","深山幽谷","深山长谷"],"usage":"作宾语、定语；指荒远偏僻的山野"},{"id":29490,"word":"深山老林","pinyin":"shēn shān lǎo lín","abbr":"ssll","explanation":"与山外、林外距离远的、人迹罕至的山岭、森林。","source":{"text":"还有些人，钻到深山老林里找人参、采木耳，摘蘑菇。","book":"秦牧《莽原语丝》"},"example":{"text":"在这～中怎么会有电话通信呢？"},"similar":["深山密林","深山穷林"],"usage":"作主语、宾语、定语；用于口语"},{"id":29491,"word":"深山野墺","pinyin":"shēn shān yě ào","abbr":"ssya","explanation":"荒僻的大山深处。","source":{"text":"倘许给本村人，财礼就不多；惟独肯嫁进深山野墺里去的女人少，所以她就到手了八十千。","book":"鲁迅《彷徨·祝福》"},"similar":["深山老林","深山幽谷"],"usage":"作主语、宾语、定语；用于书面语"},{"id":29492,"word":"深山长谷","pinyin":"shēn shān cháng gǔ","abbr":"sscg","explanation":"与山外距离远、人迹罕至的山岭、山谷。","source":{"text":"此吾之所以于内者，得其时则行，守深山长谷而不出者，非也。","book":"宋·曾巩《南轩记》"},"example":{"text":"我终于从这个～中跳出来了"},"similar":["深山幽谷","深山穷谷"],"usage":"作主语、宾语、定语；用于书面语"},{"id":29493,"word":"深得人心","pinyin":"shēn dé rén xīn","abbr":"sdrx","explanation":"得到广大人民的热烈拥护。","example":{"text":"他在任内大施德政，～，因此虽已逝去多年，仍然为人所追思、怀念。"}},{"id":29494,"word":"深得民心","pinyin":"shēn dé mín xīn","abbr":"sdmx","explanation":"得到广大人民的衷心拥护。","source":{"text":"尝置酒大会，耆老中坐流涕歌曰：‘幸哉遗黎免俘虏，三辰既朗遇慈父。玄酒忘劳甘瓠脯，何以咏恩歌且舞。’其得人心如此。","book":"《晋书·祖逖传》"},"example":{"text":"对于李自成进人河南两年来的各种行事，～，部伍整肃，纪律严明，兵强马壮，他完全清楚。","book":"姚雪垠《李自成》第三卷第四十二章"}},{"id":29495,"word":"深思极虑","pinyin":"shēn sī jí lǜ","abbr":"ssjl","explanation":"反复深入地考虑。","source":{"text":"故臣深思极虑，以为方今之计，莫如丰财。","book":"宋·苏辙《上皇帝书》"},"example":{"text":"愿陛下以宰相为股肱，以谏官为耳目，以正人君子为腹心，～，定宗社长久之计，则大纲正矣。","book":"《明史·邹智传》"},"similar":["深思远虑","深计远虑"],"usage":"作谓语、宾语、定语；指有远见"},{"id":29496,"word":"深思熟虑","pinyin":"shēn sī shú lǜ","abbr":"sssl","explanation":"反复深入地考虑。","source":{"text":"愿君熟虑之。","book":"《楚辞·渔父》：“何故深思高举，自令放为？”《史记·穰侯列传》"},"example":{"text":"而其人亦得～，周旋于是，不过十年，将必有卓然可观者也。","book":"宋·苏轼《策别第九》"},"similar":["深谋远虑","三思而后行"],"opposite":["不假思索","灵机一动"],"usage":"作宾语、定语；指反复深入地思索考虑"},{"id":29497,"word":"深思苦索","pinyin":"shēn sī kǔ suǒ","abbr":"ssks","explanation":"绞尽脑汁，苦思苦想。","source":{"text":"灵运诸佳句，多出深思苦索。","book":"明·胡应鳞《诗薮·外编二》"}},{"id":29498,"word":"深思远虑","pinyin":"shēn sī yuǎn lǜ","abbr":"ssyl","explanation":"谋划周密，考虑长远。指计划周到，具有远见。","source":{"text":"先帝即位，务休力役，然犹深思远虑，安不忘危，探观旧典，复收盐铁，欲以防备不虞，宁安边境。","book":"《后汉书·孝和孝殇帝纪》"},"example":{"text":"你负郭有田千顷，城中有油磨坊，解典库，有儿有妇，是扬州点一点二的财主，有甚么不足，索这般～那。","book":"元·秦简夫《东堂老》楔子"},"similar":["深思熟虑","深计远虑","深思极虑"],"usage":"作谓语、宾语、定语；指有远见","story":["汉朝时期，汉哀帝的老师师丹为人廉正守道，深得皇帝的信任，在改革币制问题上他认为时机不成熟，国弱民贫会引起恶性循环。由于他曾得罪丁太后及傅太后，因而被认为不支持改革。申咸为他求情说此事师丹欠深思远虑，但不应治罪"]},{"id":29499,"word":"深思长计","pinyin":"shēn sī cháng jì","abbr":"sszj","explanation":"谋划周密，考虑长远。指计划周到，具有远见。","source":{"text":"发愤懑，奏封事，不及深思远虑，使主簿书，漏泄之过不在丹。","book":"《汉书·师丹传》"}},{"id":29500,"word":"深恶痛嫉","pinyin":"shēn wù tòng jí","abbr":"swtj","explanation":"嫉：憎恨。极其厌恶、痛恨。","source":{"text":"揭开了‘以华制华’的黑幕，他们竟有如此的深恶痛嫉，莫非真是太伤了此辈的心么？","book":"鲁迅《伪自由书·“以夷制夷”》"},"similar":["深恶痛疾","深恶痛恨","深恶痛诋"],"usage":"作谓语、宾语、定语；指对人或事不满"},{"id":29501,"word":"深恶痛恨","pinyin":"shēn wù tòng hèn","abbr":"seth","explanation":"深：很，十分；恶：厌恶。指对某人或某事物极端厌恶痛恨。","source":{"text":"倘使我对剥削人、压迫人的制度并不深恶痛恨，那么我绝不会写《家》《春》《秋》那样的书。","book":"巴金《谈》"},"similar":["深恶痛嫉","深恶痛疾","深恶痛诋"],"usage":"作谓语、宾语、定语；指对人或事不满"},{"id":29502,"word":"深恶痛疾","pinyin":"shēn wù tòng jí","abbr":"swtj","explanation":"恶：厌恶；痛：痛恨。指对某人或某事物极端厌恶痛恨。","source":{"text":"过门不入而不恨之，以其不见亲就为幸，深恶而痛绝之也。","book":"《孟子·尽心下》“斯可谓之乡愿矣” 宋·朱熹集注"},"example":{"text":"人民群众对社会上以权谋私、贪污受贿等不正之风～。"},"similar":["疾恶如仇","痛心疾首","深恶痛绝"],"opposite":["情深意重","爱不释手"],"usage":"作谓语、宾语、定语；指对人或事不满"},{"id":29503,"word":"深恶痛绝","pinyin":"shēn wù tòng jué","abbr":"swtj","explanation":"恶：厌恶；痛：痛恨；绝：极。指对某人或某事物极端厌恶痛恨。","source":{"text":"过门不入而不恨之，以其不见亲就为幸，深恶而痛绝之也。","book":"《孟子·尽心下》“斯可谓之乡愿矣” 宋·朱熹集注"},"example":{"text":"不象他对于墨家那样的真心的～。","book":"闻一多《杂文·善于儒、道、土匪》"},"similar":["疾恶如仇","痛心疾首","深恶痛疾"],"opposite":["情深意重","爱不释手"],"usage":"作谓语、宾语；指对人或事不满"},{"id":29504,"word":"深恶痛诋","pinyin":"shēn wù tòng dǐ","abbr":"setd","explanation":"深：很，十分；恶：厌恶；诋：诋毁。指对某人或某事物极端厌恶痛恨。","source":{"text":"我们对于旧文字，应该不要那么时髦地一概的深恶痛诋。","book":"郭沫若《沸羹集·今日新文字运动所应取的路向》"},"similar":["深恶痛嫉","深恶痛疾","深恶痛恨"],"usage":"作谓语、宾语、定语；指对人或事不满"},{"id":29505,"word":"深情厚意","pinyin":"shēn qíng hòu yì","abbr":"sqhy","explanation":"深厚的感情和友谊。","source":{"text":"铁公子本不欲留，因见过公子深情厚意，恳恳款留，只得坐下。","book":"明·名教中人《好逑传》"},"example":{"text":"横溢着满纸的义愤和系念来安慰我们，未尝不深深地感到～，永不能忘。","book":"邹韬奋《经历》"},"similar":["深情厚谊","情同手足","骨肉深情"],"opposite":["无情无义","六亲不认"],"usage":"作谓语、宾语；指感情深厚"},{"id":29506,"word":"深情厚谊","pinyin":"shēn qíng hòu yì","abbr":"sqhy","explanation":"深厚的感情和友谊。","source":{"text":"因见过公子深情厚意，恳恳款留，只得坐下。","book":"明·明教中人《好逑传》第十二回"},"example":{"text":"向秀丽，你当得起这样的～。","book":"陈毅《向秀丽歌》"},"similar":["深情厚意","情同手足"],"opposite":["无情无义","六亲不认"],"usage":"作谓语、宾语；指感情深厚"},{"id":29507,"word":"深情底理","pinyin":"shēn qíng dǐ lǐ","abbr":"sqdl","explanation":"事情的内里真情与根由。","source":{"text":"内中深情底理，奴才不知道，不敢妄回。","book":"《红楼梦》第六七回"},"usage":"作宾语、定语；用于事情等"},{"id":29508,"word":"深情故剑","pinyin":"shēn qíng gù jiàn","abbr":"sqgj","explanation":"故剑：比喻结发之妻。结发夫妻情意浓厚。指不喜新厌旧。","source":{"text":"公卿议更立皇后，皆心仪霍将军女，亦未有言。上乃诏求微时故剑，大臣知指，白立许倢伃为皇后。","book":"《汉书·外戚传上》"},"example":{"text":"老泪长门掬，～知。","book":"章炳麟《台北旅馆书怀寄呈南海先生》"},"similar":["故剑情深"],"usage":"作宾语；用于夫妻间"},{"id":29509,"word":"深惟重虑","pinyin":"shēn wéi zhòng lǜ","abbr":"swzl","explanation":"犹深思熟虑。谋划周密，考虑长远。指计划周到，具有远见。","source":{"text":"今王深惟重虑，明太平以弼朕失。","book":"《汉书·严助传》"},"usage":"作谓语、宾语；用于处事"},{"id":29510,"word":"深扃固钥","pinyin":"shēn jiōng gù yào","abbr":"sjgy","explanation":"把门窗关紧锁严。比喻把事物的真相隐藏起来而不使之外露。","source":{"text":"窃惟山川之与人文，同于擅天地之灵秘，顾若有神物爱乎其间，深扃固钥而不轻以示。","book":"明·唐顺之《永州祭柳子厚文》"},"usage":"作宾语、定语；用于比喻句"},{"id":29511,"word":"深文傅会","pinyin":"shēn wén fù huì","abbr":"swfh","explanation":"牵强而苛细地援引法律条文陷人以罪。","source":{"text":"吏或深文傅会，以致冤滥。","book":"《明史·仁宗纪》"},"similar":["深文附会"],"usage":"作谓语、宾语；用于书面语"},{"id":29512,"word":"深文周内","pinyin":"shēn wén zhōu nà","abbr":"swzn","explanation":"歪曲或苛刻地援引法律条文，陷人以罪。","source":{"text":"小大之狱，必以情本伦常依法比，不为深文周内。","book":"清·钱谦益《兵部尚书李公神道碑》"},"example":{"text":"满洲太祖以七恨誓师，未必无～之言，然明之无端起衅，亦不得谓无咎。","book":"蔡东藩《清史演义》第三回"},"similar":["深文周纳","深文罗织","深文曲折"],"usage":"作谓语、宾语、定语；指强加人罪"},{"id":29513,"word":"深文周纳","pinyin":"shēn wén zhōu nà","abbr":"swzn","explanation":"周纳：罗织罪名。指苛刻地或歪曲地引用法律条文，把无罪的人定成有罪。也指不根据事实，牵强附会地给人硬加罪名。","source":{"text":"上奏畏却，则锻炼而周纳之。","book":"《史记·酷吏列传》：“与赵禹共定诸律令，务在深文。”《汉书·路温舒传》"},"example":{"text":"但这也许是“刀笔吏”工的～。","book":"鲁迅《华盖集续编·可惨与可笑》"},"similar":["深文罗织","故入人罪"],"usage":"作谓语、宾语、定语；指强加人罪"},{"id":29514,"word":"深文大义","pinyin":"shēn wén dà yì","abbr":"swdy","explanation":"指深奥的大道理。","source":{"text":"谈话不敷衍，不散漫，即使并没有什么深文大义谈出来，但灵魂与灵魂对面，总觉有古人诗句‘与君一夕话，胜读十年书’的乐趣。","book":"叶圣陶《四三集·招魂》"},"usage":"作宾语、定语；用于书面语"},{"id":29515,"word":"深文奥义","pinyin":"shēn wén ào yì","abbr":"sway","explanation":"指文词、言语艰深，含义晦涩。","source":{"text":"深文奥义烦音释，棘句钩章费削除。","book":"清·石承楣《读吕新吾先生闺范题辞》诗"},"example":{"text":"职道想这个文书，是不好～，最好是用白话，他也看得懂，省得辗转翻译，误了事。","book":"《中国现在记》第六回"},"usage":"作宾语、定语；用于说话或文章等"},{"id":29516,"word":"深文峻法","pinyin":"shēn wén jùn fǎ","abbr":"swjf","explanation":"犹言严刑峻法。严厉的刑罚和严峻的法令。","source":{"text":"显祖尝召见，问以治方，语及政刑宽猛，帝意深文峻法，稚廉固以为非，帝意不悦。","book":"《北齐书·李稚廉传》"},"similar":["严刑峻法"],"usage":"作宾语、定语；指残暴统治"},{"id":29517,"word":"深文巧劾","pinyin":"shēn wén qiǎo hé","abbr":"swqh","explanation":"深文：苛刻地援用法律条文；巧劾：用巧妙的手段攻击诋毁别人。指用巧妙的手段，网织罪名，陷人于罪。","source":{"text":"今之从政者则不然，深文巧劾，宁致善人于法，不免有罪于刑。","book":"《北史·苏绰传》"},"similar":["深文巧诋"],"usage":"作谓语、定语、状语；用于书面语"},{"id":29518,"word":"深文巧诋","pinyin":"shēn wén qiǎo dǐ","abbr":"swqd","explanation":"罗织罪名，蓄意毁谤。","source":{"text":"而刀笔吏专深文巧诋，陷人于罪。","book":"《史记·汲郑列传》"},"example":{"text":"近阅所传，可备参考……而故摘一字一句以售己说，遂至略人全文，则亦～而可笑之甚矣！","book":"明·徐渭《又奉师季先生书》"},"similar":["深文曲折","深文巧劾"],"usage":"作谓语、定语、状语；用于书面语"},{"id":29519,"word":"深文曲折","pinyin":"shēn wén qǔ shé","abbr":"swqs","explanation":"歪曲地援引法律条文，不露痕迹地陷人于罪。","source":{"text":"他却要卖弄自己的精明，张大自家的势焰，深文曲折的送了这个人的脑袋，方才觉得心中舒服。","book":"《宦海》第六回"},"similar":["深文巧诋"],"usage":"作谓语、定语、状语；用于书面语"},{"id":29520,"word":"深文罗织","pinyin":"shēn wén luó zhī","abbr":"swlz","explanation":"深文：制定或援用法律条文苛细严峻；罗织：虚构种种罪名，对无辜者加以诬陷。指苛刻地或歪曲地引用法律条文，把无罪的人定成有罪。","source":{"text":"此皆当国者深文罗织，不足为据。","book":"清·汪琬《跋序》"},"similar":["深文周纳","深文巧劾","深文周内"],"usage":"作谓语、宾语、定语；指强加人罪"},{"id":29521,"word":"深文附会","pinyin":"shēn wén fù huì","abbr":"swfh","explanation":"牵强而苛细地援引法律条文陷人以罪。同“深文傅会”。","source":{"text":"当是时，帝以威刑驭下，法官引律，大抵深文附会，予重比。","book":"《明史·徐石麟传》"},"similar":["深文傅会"],"usage":"作谓语、宾语；用于书面语"},{"id":29522,"word":"深明大义","pinyin":"shēn míng dà yì","abbr":"smdy","explanation":"指识大体，顾大局。","source":{"text":"只是要娶到家来作个媳妇，世上这般双瞳如豆、一叶迷山的，以至糊涂下人，又有几个深明大义的呢！","book":"清·文康《儿女英雄传》第二十五回"},"example":{"text":"那严仲子为人～，我想二弟此去一定可以做些不会辱没母亲的事情。","book":"郭沫若《棠棣之花》第一幕"},"usage":"作谓语、定语；指人的认识"},{"id":29523,"word":"深更半夜","pinyin":"shēn gēng bàn yè","abbr":"sgby","explanation":"指深夜。","source":{"text":"时盐城副使陈象舆与昌言善，知制诰胡旦、度支副使董俨皆昌言同年，四人者，旦夕会昌年之第。京师为之语曰：‘陈三更，董半夜。’","book":"《宋史·赵昌言传》"},"example":{"text":"这样吵下去有什么意思？～，还闹得四邻秒安的。（巴金《秋》四十二）"},"similar":["三更半夜"],"opposite":["青天白日"],"usage":"作宾语、定语；指深夜"},{"id":29524,"word":"深根固本","pinyin":"shēn gēn gù běn","abbr":"sggb","explanation":"使根基深固而不可动摇。同“深根固柢”。","source":{"text":"令之有渐，轨之有度，宠之有节，权不外授，威不下黩，所以杜其萌际，深根固本，传之百世。","book":"《三国志·吴志·陆瑁传》：“至于中夏鼎沸，九域槃亘之时，率须深根固本，爱力惜费。” 《晋书·文苑传·伏滔》"},"example":{"text":"天元实无积德；视其相貌，寿亦不长。又，诸籓微弱，各令就国，曾无～之计。","book":"宋·司马光《资治通鉴》卷第一百七十三"},"similar":["深根固蒂","深根固柢"],"usage":"作宾语、定语；多用于比喻句"},{"id":29525,"word":"深根固柢","pinyin":"shēn gēn gù dǐ","abbr":"sggd","explanation":"柢：树根。使根基深固，不易动摇。比喻基础稳固，不容易动摇。","source":{"text":"有国之母，可以长久，是谓深根固柢，长生久视之道。","book":"《老子》第五十九章"},"example":{"text":"乔道清法败奔走，若放他进城，便深根固蒂。","book":"明·施耐庵《水浒全传》第九十六回"},"similar":["深根固蒂","根深蒂固"],"usage":"作谓语、定语；指不容易动摇"},{"id":29526,"word":"深根固蒂","pinyin":"shēn gēn gù dì","abbr":"sggd","explanation":"使根基深固而不可动摇。","source":{"text":"乔道清法败奔走，若放他进城，便深根固蒂。","book":"明·施耐庵《水浒传》第九十六回"},"example":{"text":"明·施耐庵《水浒传》第96回：“乔道清法败奔走，若放他进城，便～。”"},"similar":["深根固柢","深根固本"],"usage":"作谓语、定语；指不容易动摇"},{"id":29527,"word":"深根宁极","pinyin":"shēn gēn níng jí","abbr":"sgnj","explanation":"①指深藏静处。②根柢牢固。","source":{"text":"不当时命而大穷乎天下，则深根宁极而待，此存身之道也。","book":"《庄子·缮性》"},"example":{"text":"革命果成，取此～之政府而覆灭之，其兵力必非犹人而已。","book":"章炳麟《中华民国解》"},"usage":"作定语、状语；多用于比喻句"},{"id":29528,"word":"深根蟠结","pinyin":"shēn gēn pán jié","abbr":"sgpj","explanation":"犹盘根错节。比喻恶势力根基深厚，勾结紧密。","source":{"text":"推其究竟，贵者以势怙，富者以赂免，若其著名之窑口，则地方官之门印胥吏，无非其深根蟠结之党羽。","book":"清·夏燮《中西纪事·管蠡一得》"},"usage":"作谓语、定语；用于比喻句"},{"id":29529,"word":"深沟固垒","pinyin":"shēn gōu gù lěi","abbr":"sggl","explanation":"犹深沟高垒。深的战壕和高的营垒。指坚固的防御工事。","source":{"text":"江南江北一带官军，因此得以深沟固垒，卧守一冬。","book":"《花月痕》第四二回"},"similar":["深沟高垒","深沟高壁","深沟坚壁"],"usage":"作宾语、定语；指坚固的防御工事"},{"id":29530,"word":"深沟坚垒","pinyin":"shēn gōu jiān lěi","abbr":"sgjl","explanation":"深的战壕和坚固的营垒。指坚固的防御工事。","source":{"text":"将军怒，将深沟高垒，将军不怒，将懈怠。","book":"《孙子·虚实》：“故我欲战，敌虽高垒深沟，不得不与我战者，攻其所必救也。”《韩非子·说林下》"},"example":{"text":"五年八月，攻大凌河城，伊尔登当城东迤南，～，环而守之，卒以破敌。","book":"《清史稿·伊尔登传》"},"similar":["深沟坚壁","深沟高垒","深沟高壁"],"usage":"作宾语、定语；指坚固的防御工事"},{"id":29531,"word":"深沟坚壁","pinyin":"shēn gōu jiān bì","abbr":"sgjb","explanation":"《后汉书·南匈奴列传》：“宜令续深沟高壁，以恩信招降，宣示购赏，明其期约。”","source":{"text":"宜令续深沟高壁，以恩信招降，宣示购赏，明其期约。","book":"《后汉书·南匈奴列传》"},"example":{"text":"《后汉书·南匈奴列传》：“宜令续深沟高壁，以恩信招降，宣示购赏，明其期约。”"},"similar":["深沟坚垒","深沟高垒","深沟高壁"],"usage":"作宾语、定语；指坚固的防御工事"},{"id":29532,"word":"深沟壁垒","pinyin":"shēn gōu bì lěi","abbr":"sgbl","explanation":"犹深沟高垒。深的战壕和高的营垒。指坚固的防御工事。","source":{"text":"汉王收诸侯，还守成皋、荥阳，下蜀汉之粟，深沟壁垒，分卒守徼乘塞。","book":"《汉书·黥布传》"},"similar":["深沟高垒","深沟固垒"],"usage":"作宾语、定语；指坚固的防御工事"},{"id":29533,"word":"深沟高垒","pinyin":"shēn gōu gāo lěi","abbr":"sggl","explanation":"深的战壕和高的营垒。指坚固的防御工事。","source":{"text":"足下深沟高垒坚营，勿与战。","book":"《孙子·虚实》：“故我欲战，敌虽高垒深沟，不得不与我战者，攻其所必救也。”《史记·淮阴侯列传》"},"example":{"text":"你则～，紧守城池。","book":"元·郑廷玉《楚昭公》第一折"},"similar":["深沟壁垒","深沟坚垒","深沟高壁"],"usage":"作宾语、定语；指坚固的防御工事"},{"id":29534,"word":"深沟高壁","pinyin":"shēn gōu gāo bì","abbr":"sggb","explanation":"深的战壕和高的城墙。指坚固的防御工事。","source":{"text":"宜令续深沟高壁，以恩信招降，宣示购赏，明其期约。","book":"《后汉书·南匈奴列传》"},"similar":["深沟高垒","深沟坚壁","深沟坚垒"],"usage":"作宾语、定语；指坚固的防御工事"},{"id":29535,"word":"深渊薄冰","pinyin":"shēn yuān bó bīng","abbr":"sybb","explanation":"面对着深渊，脚踩着薄冰。比喻处境危险，心存戒惧。","source":{"text":"战战兢兢，如临深渊，如履薄冰。","book":"《诗经·小雅·小旻》"},"example":{"text":"圣恩所及，有隆天重地之施，私义未安，有～之惧。","book":"宋·王安石《乞退表第三》"},"similar":["临深履薄"],"usage":"作宾语、定语；用于比喻句"},{"id":29536,"word":"深猷远计","pinyin":"shēn yóu yuǎn jì","abbr":"syyj","explanation":"指计划得很周密，考虑得很长远。同“深谋远虑”。","source":{"text":"先生好古力践，深猷远计，发而为言者，固其所自立也。","book":"明·李东阳《〈桃溪杂稿〉序》"},"similar":["深谋远虑","深图远算"],"usage":"作谓语、宾语、定语；指计划得很周密"},{"id":29537,"word":"深知灼见","pinyin":"shēn zhī zhuó jiàn","abbr":"szzj","explanation":"明·冯梦龙《警世通言》卷三：“真知灼见者，尚且有误，何况其他！”","source":{"text":"真知灼见者，尚且有误，何况其他！","book":"明·冯梦龙《警世通言》卷三"},"example":{"text":"幼闻义方，长读经传，崇正辟邪之志，愈坚愈定，时以灭除老佛为念，～，确然无疑。","book":"清·夏敬渠《野叟曝言》第一○五回"},"similar":["真知灼见"],"opposite":["一孔之见"],"usage":"作宾语、定语；用于评论人的看法"},{"id":29538,"word":"深稽博考","pinyin":"shēn jī bó kǎo","abbr":"sjbk","explanation":"深入地稽核，广泛地考察。形容苦心钻研学问。","source":{"text":"逮穷年累月，深稽博考，然后乃晓然于是非得失之宜，长短取舍之要。","book":"钱仲联《黄公度先生年谱》"},"usage":"作宾语、定语；用于学习等"},{"id":29539,"word":"深耕易耨","pinyin":"shēn gēng yì nòu","abbr":"sgyn","explanation":"易耨：勤于除草。深耕细做，及时除草。比喻精心耕种。","source":{"text":"王如施仁政于民，省刑罚，薄税敛，深耕易耨，壮者以暇日，修其孝悌忠信。","book":"《孟子·梁惠王上》"},"example":{"text":"今农夫祁寒暑雨，～，播种五谷，吾得而食之。","book":"《二程全书·遗书十七》"},"similar":["精耕细作"],"usage":"作谓语；比喻精心耕种"},{"id":29540,"word":"深自砥砺","pinyin":"shēn zì dǐ lì","abbr":"szdl","explanation":"砥砺：磨刀石，引申为磨砺，磨炼。自己刻苦地磨炼。","source":{"text":"文帝使人问诩自固之术，诩曰：‘愿将军恢崇德度，躬素士之业，朝夕孜孜，不违子道，如此而已。’文帝从之，深自砥砺。","book":"《三国志·魏志·贾诩传》"},"example":{"text":"无由复得动相规诲，宜～，思而后行。","book":"《金史·江夏文献王义恭传》"},"usage":"作谓语、定语；用于书面语","story":["三国时期，曹操巩固北方后，与刘备、孙权形成三足鼎立之势。儿子曹丕为了稳固自己的地位，派人去向贾诩请教自固之术。贾诩说：“愿将军恢崇德度，躬素士之业，朝夕孜孜，不违子道，如此而已。”曹丕听从他的建议，自己刻苦磨练，最后成功称帝"]},{"id":29541,"word":"深藏简出","pinyin":"shēn cáng jiǎn chū","abbr":"scjc","explanation":"简：简省。原指野兽藏在深密的地方，很少出现。后指常呆在家里，很少出门。","source":{"text":"夫兽深居而简出，惧物之为己害也，犹且不脱焉。","book":"唐·韩愈《送浮屠文畅师序》"},"example":{"text":"于是家中的妇女也就只好～的不出去多暴露自己的缺陷。","book":"老舍《四世同堂》二"}},{"id":29542,"word":"深藏若虚","pinyin":"shēn cáng ruò xū","abbr":"scrx","explanation":"虚：无。把宝贵的东西藏起来，好像没有这东西一样。比喻人有真才实学，但不爱在人前卖弄。","source":{"text":"虚：无。把宝贵的东西藏起来，好像没有这东西一样。比喻人有真才实学，但不爱在人前卖弄。"},"example":{"text":"虚：无。把宝贵的东西藏起来，好像没有这东西一样。比喻人有真才实学，但不爱在人前卖弄。"},"similar":["深藏不露"],"usage":"作谓语；比喻有真才不外露"},{"id":29543,"word":"深藏远遁","pinyin":"shēn cáng yuǎn dùn","abbr":"scyd","explanation":"藏身于深密之处，远远地离开人群。指逃避尘世而隐居。","source":{"text":"君子有深藏远遁，以自脱天下之讥而已。","book":"宋·杨万里《论相上》"},"usage":"作谓语、定语、宾语；用于处世等"},{"id":29544,"word":"深虑远议","pinyin":"shēn lǜ yuǎn yì","abbr":"slyy","explanation":"深：深入。细致的考虑，从长计议。","source":{"text":"今日若听此一面之词，杨仪等必投魏矣。此事当深虑远议，不可造次。","book":"明·罗贯中《三国演义》第一百五回"},"similar":["深谋远虑"],"usage":"作谓语、宾语；用于处事"},{"id":29545,"word":"深见远虑","pinyin":"shēn jiàn yuǎn lǜ","abbr":"sjyl","explanation":"指看得深，想得远。","source":{"text":"昔高祖大圣，深见远虑，班爵割地，与下分功，著录勋臣，颂其德美。","book":"《后汉书·祭遵传》"},"similar":["高瞻远瞩"],"usage":"作谓语、宾语、定语；用于处事"},{"id":29546,"word":"深计远虑","pinyin":"shēn jì yuǎn lǜ","abbr":"sjyl","explanation":"犹深思远虑。谋划周密，考虑长远。指计划周到，具有远见。","source":{"text":"窃恐未得其志，而轻薄之徒自相侵侮，偷快一时，无深计远虑。","book":"《三国志·魏志·田畴传》"},"example":{"text":"顷者诏旨裁减皇族恩例，此实陛下至明至断，所以～，割爱为民。","book":"宋·苏轼《谏买浙灯状》"},"similar":["深谋远虑","深思远虑","深思极虑"],"usage":"作谓语、宾语、定语；指计划得很周密"},{"id":29547,"word":"深识远虑","pinyin":"shēn shí yuǎn lǜ","abbr":"ssyl","explanation":"见识深广，考虑久远。","source":{"text":"古之明王，深识远虑，动居其厚，不务多辟，周之五刑，不过三千。","book":"《后汉书·杜林传》"},"example":{"text":"～，有宰相才，则史天泽其人也。","book":"《元史·窦默传》"},"similar":["深谋远虑"],"opposite":["目光短浅"],"usage":"作谓语、宾语、定语；指眼光长远"},{"id":29548,"word":"深谋远猷","pinyin":"shēn móu yuǎn yóu","abbr":"smyy","explanation":"谋：计划；猷：谋略。指计划得很周密，考虑得很长远。","source":{"text":"陛下明并日月，无幽不烛，深谋远猷，出自胸怀。","book":"《晋书·元帝纪》"},"similar":["深谋远虑","深谋远图","深图远虑"],"usage":"作谓语、宾语、定语；用于处事"},{"id":29549,"word":"深谋远略","pinyin":"shēn móu yuǎn lüè","abbr":"smyl","explanation":"指计划得很周密，考虑得很长远。","source":{"text":"深谋远虑，行军用兵之道，非及曩时之士也。","book":"汉·贾谊《过秦论》"},"example":{"text":"所共之事者，皆邪佞之徒，惟竞荣利，无～。","book":"《晋书·赵王伦传》"},"similar":["深谋远虑","深谋远猷","深图远虑"],"usage":"作谓语、宾语、定语；指计划得很周密"},{"id":29550,"word":"深谋远虑","pinyin":"shēn móu yuǎn lǜ","abbr":"smyl","explanation":"指计划得很周密，考虑得很长远。","source":{"text":"深谋远虑，行军用兵之道，非及曩时之士也。","book":"汉·贾谊《过秦论》"},"example":{"text":"大王～，说得有理。","book":"明·吴承恩《西游记》第二十回"},"similar":["深思熟虑","老谋深算","深谋远略"],"opposite":["少不更事","掉以轻心","鼠目寸光"],"usage":"作谓语、宾语、定语；指计划得很周密"},{"id":29551,"word":"深谋远计","pinyin":"shēn móu yuǎn jì","abbr":"smyj","explanation":"指计划得很周密，考虑得很长远。","source":{"text":"大夫种为越王深谋远计，免会稽之危，以亡为存，因辱为荣，垦草入邑，辟地殖谷，率四方之士，专上下之力，辅句践之贤，报夫差之仇，卒擒劲吴。","book":"《史记·范睢蔡泽列传》"}},{"id":29552,"word":"深谷为陵","pinyin":"shēn gǔ wéi líng","abbr":"sgwl","explanation":"深谷变成山陵。常喻人世间的重大变迁。","source":{"text":"社稷无常奉，君臣无常位，自古以然。故诗曰：‘高岸为谷，深谷为陵。’","book":"《左传·昭公三十二年》"},"example":{"text":"百年之后，何知不～也。","book":"北魏·郦道元《水经注·沔水二》"},"similar":["沧海桑田"],"usage":"作宾语、定语；用于书面语"},{"id":29553,"word":"深铭肺腑","pinyin":"shēn míng fèi fǔ","abbr":"smff","explanation":"指深深铭记于心。","source":{"text":"师傅，我合你三载相依，多承你与我掌持这小小门庭，深铭肺腑，容当再报！","book":"清·文康《儿女英雄传》第十八回"}},{"id":29554,"word":"深闭固拒","pinyin":"shēn bì gù jù","abbr":"sbgj","explanation":"固：坚决；距：同“拒”，拒绝。形容坚决不接受别人的意见。","source":{"text":"以金匮石室进呈乙览之书而视同阴谋，深闭固拒。","book":"清·魏源《拟进呈序》"},"example":{"text":"对内地朝廷采～的态度，政治上很少有往来。","book":"范文澜《中国通史》第三编第六章第一节"},"similar":["深闭固距","刚愎自用"],"usage":"作谓语、定语；形容坚决不接受别人"},{"id":29555,"word":"深闭固距","pinyin":"shēn bì gù jù","abbr":"sbgj","explanation":"紧紧闭关，坚决抵制。","source":{"text":"今则不然，深闭固距，而不肯试，猥以不诵绝之，欲以杜塞馀道，绝灭微学。","book":"汉·刘歆《移书让太常博士》"},"example":{"text":"我～，使彼不得安息。","book":"宋·王安石《与赵卨书》"},"similar":["深闭固拒"],"usage":"作谓语、定语；形容坚决不接受别人"},{"id":29556,"word":"深雠大恨","pinyin":"shēn chóu dà hèn","abbr":"scdh","explanation":"深而大的仇恨。同“深仇大恨”。"},{"id":29557,"word":"混世魔王","pinyin":"hùn shì mó wáng","abbr":"hsmw","explanation":"《西游记》中的一个妖怪。比喻扰乱世界、给人们带来严重灾难的人。有时也指成天吃喝玩乐、到处胡闹的有钱有势人家的子弟。","source":{"text":"我有一个孽根祸胎，是家里的混世魔王。","book":"清·曹雪芹《红楼梦》第三回"},"example":{"text":"曹操决不是一个以残破天下为乐的～。"},"similar":["纨绔子弟"],"usage":"作主语、宾语；指骄横作恶的人"},{"id":29558,"word":"混为一谈","pinyin":"hùn wéi yī tán","abbr":"hwyt","explanation":"把不同的事物混在一起，当作同样的事物谈论。","source":{"text":"万口和附，并为一谈。","book":"唐·韩愈《平淮西碑》"},"example":{"text":"可见“言志”跟“缘情”到底两样，是不能～的。","book":"朱自清《诗言志辩·诗言志（三）》"},"similar":["相提并论","并为一谈","等量齐观"],"opposite":["不可同日而语"],"usage":"作谓语、宾语；用于否定句"},{"id":29559,"word":"混作一谈","pinyin":"hùn zuò yī tán","abbr":"hzyt","explanation":"把不同的事物混在一起，当作同样的事物谈论。同“混为一谈”。","source":{"text":"东瀛的‘武士道’，是指武士应守的道德，与技击无关。武士单能技击，不守这道德，便是没有武士道。中国近来每与柔术混作一谈，其实是两件事。","book":"鲁迅《集外集拾遗补编·拳术与拳匪》"},"similar":["混为一谈"],"usage":"作谓语、宾语；用于否定句"},{"id":29560,"word":"混俗和光","pinyin":"hùn sú hé guāng","abbr":"hshg","explanation":"同于尘俗，不露锋芒。指不求特异，与世无争。","source":{"text":"典册高文，不晓是翰墨林中大手；淫词艳曲，多认作繁华队里当家。只得混俗和光，偷闲寄傲。见作开封监税，权为吏隐金门。","book":"明·凌濛初《二刻拍案惊奇》卷四十"},"example":{"text":"贫道～，常於闹市之中，口发狂言，串拖二八金钱，每与孩童嬉戏游翫。","book":"明·无名氏《李云卿》第一折"},"similar":["浑俗和光"],"usage":"作谓语、定语；比喻不露锋芒，与世无争"},{"id":29561,"word":"混应滥应","pinyin":"hùn yīng làn yīng","abbr":"hyly","explanation":"指随便答应别人的请求。","example":{"text":"你不能～，得考虑你能否办到。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":29562,"word":"混水捞鱼","pinyin":"hùn shuǐ lāo yú","abbr":"hsly","explanation":"比喻乘混乱的时候从中捞取利益。同“混水摸鱼”。","source":{"text":"何应钦，骨头轻，混水捞鱼鬼门经，口吃中国饭，心向大‘皇军’。","book":"《中国歌谣资料·口吃中国饭》"},"similar":["混水摸鱼"],"usage":"作谓语、定语；指趁火打劫"},{"id":29563,"word":"混水摸鱼","pinyin":"hùn shuǐ mō yú","abbr":"hsmy","explanation":"比喻乘混乱的时候从中捞取利益。","source":{"text":"而他打算把这个拾来的鸡蛋，寄在邻居母鸡生下的许多鸡蛋里一起去孵，其目的更显然是混水摸鱼。","book":"马南邨《燕山夜话·一个鸡蛋的家当》"},"example":{"text":"他总想～捞个官来当当。"},"similar":["浑水摸鱼","趁火打劫"],"usage":"作谓语、定语；指趁火打劫"},{"id":29564,"word":"混沌不分","pinyin":"hùn dùn bù fēn","abbr":"hdbf","explanation":"混沌：亦作“浑沌”，古代寓言中的中央帝名。原意是借喻一切事物都应顺其自然。后常用以表示愚昧无知。","source":{"text":"南海之帝为倏，北海之帝为善，倏与忽谋报浑沌之德，曰：‘人皆有七窃，以视听食息，此独无有，尝试凿之。’日凿一窃，七日而浑沌死。","book":"《庄子·应帝王》"},"usage":"作谓语、定语；用于处事"},{"id":29565,"word":"混沌未凿","pinyin":"hùn dùn wèi záo","abbr":"hdwz","explanation":"混沌：古人想像中的天地形成以前的状态；凿：凿开。世界尚处于蒙昧状态之中，天地尚未形成。比喻人的本性纯真朴实。","source":{"text":"自天地开辟以来，原有这等混沌未凿之人……无不富贵寿考，安乐终身。","book":"清·文康《儿女英雄传》第十五回"}},{"id":29566,"word":"混沌芒昧","pinyin":"hùn dùn máng mèi","abbr":"hdmm","explanation":"混沌：古人想像中的天地形成以前的状态。指上古时期人类尚未开化的状态。也形容人无知无识的样子。","source":{"text":"其时淳风未散，故处在混沌茫昧之中。","book":"《庄子·缮性》：“古之人在混茫之中。”成玄英疏"}},{"id":29567,"word":"混淆是非","pinyin":"hùn xiáo shì fēi","abbr":"hxsf","explanation":"混淆：使界限不清。故意把正确的说成错误的，把错误的说成正确的。","source":{"text":"锢蔽见闻，淆混是非。","book":"清·陶曾佑《论文学之势力及其关系》"},"example":{"text":"他们颠倒黑白，～，结帮营私，横行霸道。","book":"巴金《一封信》"},"similar":["颠倒是非","是非不分","混淆视听"],"opposite":["泾渭分明","黑白分明","是非分明"],"usage":"作谓语、定语；指故意制造混乱"},{"id":29568,"word":"混淆视听","pinyin":"hùn xiáo shì tīng","abbr":"hxst","explanation":"混淆：混杂。用假象或谎言让旁人分辨不清是非。","source":{"text":"如此之类，正足以诬罔视听，贻误后生矣。","book":"《三国志·袁尚传》裴松之注"},"example":{"text":"那些人经常故意～，影响很坏。"},"similar":["耸人听闻","混淆黑白","危言耸听"],"opposite":["以正视听"],"usage":"作谓语、定语；指故意用假象或谎言迷惑人"},{"id":29569,"word":"混淆黑白","pinyin":"hùn xiáo hēi bái","abbr":"hxhb","explanation":"混淆：使界限模糊。故意把黑的说成白的，白的说成黑的，制造混乱。指故意制造混乱，使人辨别不清。","source":{"text":"白黑溷淆，清浊同源。","book":"《后汉书·杨震传》"},"example":{"text":"盖党史见纷争，～，虽稍与立异者，犹不可保，况素非其类邪？","book":"章炳麟《致梁启超书》"},"similar":["颠三倒四","颠倒黑白"],"opposite":["泾渭分明","黑白分明","是非分明"],"usage":"作谓语、定语；指故意制造混乱"},{"id":29570,"word":"混混噩噩","pinyin":"hún hún è è","abbr":"hhee","explanation":"无知无识，糊里糊涂。","source":{"text":"三代以前，人类混混噩噩，不识不知，行之而不知其道。","book":"孙中山《建国方略·知行总论》"},"example":{"text":"无变化相刺激，梦梦昧昧～之地域，以老以死。","book":"赵汉卿《宣言书》"},"similar":["浑浑噩噩","迷迷糊糊"],"usage":"作谓语、定语、宾语；指糊里糊涂"},{"id":29571,"word":"混混沄沄","pinyin":"gǔn gǔn yún yún","abbr":"hhyy","explanation":"水流汹涌的样子。比喻连续不断。","source":{"text":"大臣无耻，凡百士大夫法则之，以及士庶人法则之，则是有三数辱社稷者，而令合天下之人，举辱国以辱其家，辱其身，混混沄沄，而无所底，厥咎上达下，象似水！","book":"清·龚自珍《明良论二》"},"usage":"作谓语、定语；指多而连续"},{"id":29572,"word":"混混沌沌","pinyin":"hùn hùn dùn dùn","abbr":"hhdd","explanation":"迷糊不清的样子，模糊一片，不分明。","source":{"text":"仍然不知稼穑艰难，混混沌沌的过日子。","book":"清·吴趼人《二十年目睹之怪现状》第53回"},"example":{"text":"茫茫的东海和迷蒙的夜空连成一片，分不清哪里是水，哪里是天，～。","book":"周而复《上海的早晨》第四部"},"similar":["浑浑沌沌"],"opposite":["清清楚楚"],"usage":"作谓语、定语、状语；指不分明"},{"id":29573,"word":"混混泇泇","pinyin":"hùn hùn chā kē","abbr":"hhck","explanation":"水流汹涌貌。比喻连续不断。"},{"id":29574,"word":"混然一体","pinyin":"hún rán yī tǐ","abbr":"hryt","explanation":"混然：混同在一起的样子。融合成一个整体，不可分割。也形容文章绘画，布置匀整，结构谨严。","source":{"text":"学者须先识仁。仁者，浑然与物同体。义、礼、知、信皆仁也。","book":"《二程遗书》卷二上"},"example":{"text":"这幅山水画气势雄壮，结构紧凑，～。"}},{"id":29575,"word":"混然天成","pinyin":"hùn rán tiān chéng","abbr":"hrtc","explanation":"自然形成的整体，没有斧凿的痕迹。","source":{"text":"《胡笳十八拍》混然天成，绝无痕迹，如蔡文姬肝肺间流出。","book":"宋·罗大经《鹤林玉露》卷一：“余家藏山谷八大字云：‘作德日休，为善最乐。’摘经史语，混然天成，可置座右。”宋·严羽《沧浪诗话·诗评》"},"similar":["浑然天成"],"usage":"作谓语；形容诗文结构严密自然"},{"id":29576,"word":"混说白道","pinyin":"hùn shuō bái dào","abbr":"hsbd","explanation":"指没有根据，不符实际的瞎说，或说胡话。","source":{"text":"怎么人到了老来，就是混说白道，叫人听着又生气，又好笑。","book":"清·曹雪芹《红楼梦》第八十二回"}},{"id":29577,"word":"混造黑白","pinyin":"hùn zào hēi bái","abbr":"hzhb","explanation":"故意颠倒黑白，制造混乱。","source":{"text":"人之多言，亦可畏也。倘有混造黑白之人，那时妹子求死不得。","book":"清·夏敬渠《野叟曝言》第四回"},"similar":["混淆黑白"],"opposite":["黑白分明"],"usage":"作谓语、定语；指故意制造混乱"},{"id":29578,"word":"淹会贯通","pinyin":"yān huì guàn tōng","abbr":"yhgt","explanation":"犹融会贯通。把各方面的知识和道理融化汇合，得到全面透彻的理解。","source":{"text":"遂使义理之微不备，事变之实不详，无以淹会贯通，明其同异而辨其得失矣。","book":"明·高启《〈史要类钞〉序》"},"similar":["融会贯通"],"usage":"作谓语、定语；指融会贯通"},{"id":29579,"word":"淹旬旷月","pinyin":"yān xún kuàng yuè","abbr":"yxky","explanation":"淹：滞留。旷：荒废。拖延时日，荒废岁月。","source":{"text":"至者必淹旬旷月，不得遽去。","book":"宋·苏舜钦《涟水军新闸记》"},"usage":"作谓语、宾语；用于书面语"},{"id":29580,"word":"淹淹一息","pinyin":"yān yān yī xī","abbr":"yyyx","explanation":"形容呼吸微弱，濒于死亡。同“奄奄一息”。","source":{"text":"马二先生大惊，急上楼进房内去看，已是淹淹一息，头也抬不起来。","book":"《儒林外史》第十五回"},"similar":["奄奄一息"],"usage":"作谓语、定语、状语；指临近死亡"},{"id":29581,"word":"淹滞措大","pinyin":"yān zhì cuò dà","abbr":"yzcd","explanation":"淹滞：有才德而居下位者；措大：旧指贫寒的读书人。旧指当不上官的读书人。"},{"id":29582,"word":"淹荠燎菜","pinyin":"yān jì liáo cài","abbr":"yjlc","explanation":"荠：荠菜；燎：熏制。像腌制的荠菜和熏制的肉菜一样脏乱。形容肮脏、破旧。","example":{"text":"他穿的衣服如同～一样脏乱。"},"usage":"作宾语、定语；用于比喻句"},{"id":29583,"word":"淹贯精微","pinyin":"yān guàn jīng wēi","abbr":"ygjw","explanation":"精微：精深微妙。渊博贯通、精深微妙。","example":{"text":"我们需要真正～的学者来指导。"},"usage":"作谓语、定语；用于学识等"},{"id":29584,"word":"淹黄潦倒","pinyin":"yān huáng liáo dǎo","abbr":"yhld","explanation":"形容病人形貌枯槁、气息奄奄的状态。","example":{"text":"他已经～，没有多少时日了。"},"usage":"作谓语、定语；用于人的状态"},{"id":29585,"word":"添兵减灶","pinyin":"tiān bīng jiǎn zào","abbr":"tbjz","explanation":"增加兵员，反而减少行军饭灶。指伪装士兵逃亡，示弱以欺骗对方。","source":{"text":"使齐军入魏地为十万灶，明日为五万灶，又明日为三万灶。庞涓行三日，大喜，曰：‘吾固知齐军怯，入吾地三日，士卒亡者过半矣。’","book":"《史记·孙子吴起列传》"},"example":{"text":"则你是～齐孙膑，唤雨呼风蜀武侯，将巧计亲传授。","book":"元·无名氏《百花亭》第二折"},"usage":"作宾语、定语；用于军事等","story":["战国时期，兵法大师鬼谷子的弟子庞涓请魏王残害师弟孙膑。被砍了双腿的孙膑逃到齐国做大将田忌的军师。魏王派庞涓去攻打赵国。田忌采纳孙膑的围魏救赵、添兵减灶计，迫使庞涓撤军并追至马陵道齐军的埋伏圈自杀身亡"]},{"id":29586,"word":"添枝加叶","pinyin":"tiān zhī jiā yè","abbr":"tzjy","explanation":"在树干上添上些枝叶。比喻叙述事情或转述别人的话，为了夸大，添上原来没有的内容。","source":{"text":"今人生出重重障碍，添枝接叶，无有了期。","book":"宋·朱熹《答黄子耕》"},"example":{"text":"杨子荣为了消磨时间，大为～，渲染逗趣。","book":"曲波《林海雪原》十七"},"similar":["节外生枝","添油加醋"],"opposite":["恰如其分","实事求是"],"usage":"作定语、状语；指夸张"},{"id":29587,"word":"添枝增叶","pinyin":"tiān zhī zēng yè","abbr":"tzzy","explanation":"比喻接连不断地附加。同“添枝接叶”。","source":{"text":"当时五言诗正是一个新体，有文人便用之来添枝增叶的改写了一遍。","book":"郑振铎《中国俗文学史》第三章第六节"},"similar":["添枝加叶","添枝接叶"],"usage":"作定语、状语；指夸张"},{"id":29588,"word":"添枝接叶","pinyin":"tiān zhī jiē yè","abbr":"tzjy","explanation":"比喻接连不断地附加。","source":{"text":"今人生出重重障碍，添枝接叶，无有了期。","book":"宋·朱熹《答黄子耕》"},"example":{"text":"说话爱～的人，是不诚实的人。"},"similar":["添枝加叶"],"usage":"作谓语、定语；指添油加醋"},{"id":29589,"word":"添油加醋","pinyin":"tiān yóu jiā cù","abbr":"tyjc","explanation":"比喻叙述事情或转述别人的话，为了夸大，添上原来没有的内容。","source":{"text":"我们这些当通信兵的，常在首长身边转，把听来的一些话，添油加醋相互传说着。","book":"屈兴栋《血战剑门关》"},"example":{"text":"你说话要实事求是，不要～。"},"similar":["添枝加叶","加油加醋","加油添酱"],"opposite":["恰如其分","实事求是"],"usage":"作谓语、定语、状语；指夸张"},{"id":29590,"word":"添油炽薪","pinyin":"tiān yóu chì xīn","abbr":"tycx","explanation":"犹言火上加油。比喻人为地激化矛盾，使事态严重。","source":{"text":"昨见公，令我两个月心事顿然冰消冻解也。乃知向之劝我者，只为我添油炽薪耳。","book":"明·李贽《与曾中野书》"},"similar":["火上加油","火上浇油"],"usage":"作谓语、宾语；比喻有意扩大事态"},{"id":29591,"word":"添盐着醋","pinyin":"tiān yán zhe cù","abbr":"tyzc","explanation":"比喻叙述事情或转述别人的话，为了夸大，添上原来没有的内容。同“添油加醋”。"},{"id":29592,"word":"添砖加瓦","pinyin":"tiān zhuān jiē wǎ","abbr":"tzjw","explanation":"比喻做一些工作，尽一点力量。","example":{"text":"我们要学好本领，将来为祖国建设添砖加瓦。"},"similar":["增砖加瓦"],"usage":"作谓语；指尽力作贡献"},{"id":29593,"word":"添粮不如减口","pinyin":"tiān liáng bù rú jiǎn kǒu","abbr":"tlbrjk","explanation":"家穷人多，添粮食不如疏散人口。比喻解决困难须从根本入手。","source":{"text":"自古云，添粮不如减口。他们又不愿跟咱，不如善善的各给他们几句好话，打发他们出去。","book":"清·李绿园《歧路灯》第七十六回"}},{"id":29594,"word":"添醋加油","pinyin":"tiān cù jiā yóu","abbr":"tcjy","explanation":"比喻叙述事情或转述别人的话，为了夸大，添上原来没有的内容。同“添油加醋”。","source":{"text":"她是担心符癞子首先把事情吵开，又添醋加油，把真象歪曲，引起他所看中的人的难以解释的误会。","book":"周立波《山乡巨变》"},"similar":["添油加醋","添盐着醋"],"usage":"作谓语、定语、状语；指夸张"},{"id":29595,"word":"清一色","pinyin":"qīng yī sè","abbr":"qys","explanation":"原指打麻将时由一种花色组成的一副牌。后比喻全部由同一种成分构成。","source":{"text":"而且他［佘小观］赌品甚高，输得越多心越定，脸上神色丝毫不动。又欢喜做‘清一色’。所以同赌的人更拿他当财神看待。","book":"清·李宝嘉《官场现形记》第二十九回"},"example":{"text":"至于经常的事务，她可以放心的由职员们代办，因为职员们都～的换上了她的娘家的人。","book":"老舍《四世同堂》三七"},"similar":["千篇一律"],"opposite":["杂七杂八"],"usage":"作宾语、定语；指全部如此"},{"id":29596,"word":"清丽俊逸","pinyin":"qīng lì jùn yì","abbr":"qljy","explanation":"指诗文清美新颖，不落俗套。","source":{"text":"清新庾开府，俊逸鲍参军。","book":"唐·杜甫《春日忆李白》诗"},"example":{"text":"工词章，才思涌溢，发为歌诗，～。","book":"《元史·吴师道传》"},"similar":["清新俊逸"],"usage":"作谓语、定语；指不落俗套"},{"id":29597,"word":"清交素友","pinyin":"qīng jiāo sù yǒu","abbr":"qjsy","explanation":"素友：真诚的朋友。交往纯洁，友情纯朴。","source":{"text":"清交素友，比景共波。","book":"南朝·宋·王僧达《祭颜光禄文》"},"example":{"text":"便是～，频相视、笑晴空。","book":"宋·张继先《风入松》词"},"usage":"作主语、宾语、定语；用于朋友"},{"id":29598,"word":"清介有守","pinyin":"qīng jiè yǒu shǒu","abbr":"qjys","explanation":"守：操守。指人的品格高尚而有节操。","source":{"text":"张知謇，子匪躬，幽州方城人，徙家岐。兄弟五人，知玄、知晦、知泰、知默，皆明经高第，晓吏治，清介有守，公卿争为引重。","book":"《新唐书·张知謇传》"},"example":{"text":"容为人，～，仕至宰相，居处不改其初。","book":"清·毕沅《续资治通鉴》卷一百四十"}},{"id":29599,"word":"清仓查库","pinyin":"qīng cāng chá kù","abbr":"qcck","explanation":"检查、清理仓库物资。","example":{"text":"我们要进行一月一次的～工作。"},"usage":"作谓语、宾语、定语；指盘点"},{"id":29600,"word":"清净寂灭","pinyin":"qīng jìng jì miè","abbr":"qjjm","explanation":"指道教的清净无为与佛家的涅盘寂灭之说。","source":{"text":"今其法曰：必弃而君臣，去而父子，禁而相生养之道，以求其所谓清净寂灭者。","book":"唐·韩愈《原道》"},"example":{"text":"时接佛老之徒，闻其所谓～者，而心悦之。","book":"清·王士禛《池北偶谈·谈艺·屏山诗禅》"},"usage":"作宾语、定语；用于书面语"},{"id":29601,"word":"清净无为","pinyin":"qīng jìng wú wéi","abbr":"qjww","explanation":"道家语。指一切听其自然，人力不必强为。","source":{"text":"真宗皇帝奉天体道，清净无为。","book":"《俱舍论》十六：“暂永远离一切恶行烦恼垢，故名为清净。”宋·范仲淹《答赵元昊书》"},"example":{"text":"出家人～，红尘不染。","book":"明·冯梦龙《警世通言·赵太祖千里送京娘》"},"similar":["清静无为"],"usage":"作谓语、宾语；指道家的观念"},{"id":29602,"word":"清原正本","pinyin":"qīng yuán zhèng běn","abbr":"qyzb","explanation":"清理水的源头，扶正树的根。比喻从根本解决问题。","source":{"text":"岂宜惟思所以清原正本之论，删定律令。","book":"东汉·班固《汉书·刑法志》"},"similar":["清源正本","澄源正本"],"usage":"作宾语、定语；用于书面语"},{"id":29603,"word":"清君侧","pinyin":"qīng jūn cè","abbr":"qjc","explanation":"指清除君主身旁的亲信、坏人。","source":{"text":"如奸臣难制，誓以死清君侧。","book":"《公羊传·定公十三年》：“此逐君侧之恶人。”唐·李商隐《有感》诗：“古有清君侧，今非乏老成。”《新唐书·仇士良传》"},"example":{"text":"若变起，足下以一军敌彼二军，保护圣主，复大权，～，肃宫廷，指挥若定，不世之业也。","book":"梁启超《戊戌政变记·谭嗣同传》"},"usage":"作谓语、定语；指清除君主身旁的坏人"},{"id":29604,"word":"清和平允","pinyin":"qīng hé píng yǔn","abbr":"qhpy","explanation":"平允：性格平和。形容人的性格温和，容易接近。","source":{"text":"齐献王攸，字大猷，少而岐嶷。及长，清和平允，亲贤好施，爱经籍，能属文，善尺牍，为世所楷。","book":"《晋书·齐献王攸传》"},"example":{"text":"攸性孝友，多材艺，～，名闻过于炎。","book":"《资治通鉴·魏纪十》"},"usage":"作谓语、定语；用于书面语"},{"id":29605,"word":"清圣浊贤","pinyin":"qīng shèng zhuó xián","abbr":"qszx","explanation":"汉代末年因饥荒严禁酿酒，饮者讳言酒，称酒之清者为圣人，浊者为贤人。用来指酒。","source":{"text":"平日棜客谓酒清者为圣人，浊者为贤人。","book":"《三国志·魏志·徐邈传》"},"example":{"text":"闲携～酒，重试朝南莫北风。？","book":"宋·陆游《泝溪》诗"},"usage":"作宾语、定语；指酒"},{"id":29606,"word":"清夜扪心","pinyin":"qīng yè mén xīn","abbr":"qymx","explanation":"清：清静；扪：按摸。指深夜不眠，进行反省。","source":{"text":"倘清夜扪心，原无芥蒂。","book":"唐·白居易《和梦游春》诗：“扪心无愧畏，腾口有谤讟。”明·茅维《闹门神》"},"example":{"text":"在今天，谁要是在团结两个字上不生长些诚意，他即使不被人唾骂，也当～，有点儿羞愧。","book":"毛泽东《反对日本进攻的方针、办法和前"},"similar":["改过自新","闭门思过"],"opposite":["执迷不悟","一意孤行"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":29607,"word":"清天白日","pinyin":"qīng tiān bái rì","abbr":"qtbr","explanation":"指大白天。","source":{"text":"醒来！清天白日，却怎的这等酣睡？","book":"清·文康《儿女英雄传》第一回"},"example":{"text":"好大胆！～就截路抢人啦！","book":"赵树理《李家庄的变迁》"},"similar":["青天白日"],"usage":"作宾语、定语；指大白天"},{"id":29608,"word":"清如冰壶","pinyin":"qīng rú bīng hú","abbr":"qrbh","explanation":"冰壶：盛冰的玉壶，喻指清白洁净。比喻为人高洁，不同凡俗。也比喻诗文格调清新。","source":{"text":"直如朱丝绳，清如玉壶冰。","book":"南朝·宋·鲍照《白头吟》"},"example":{"text":"老秀，～，艳如红玉。","book":"明·陆时雍《诗镜总论》"}},{"id":29609,"word":"清如水，明如镜","pinyin":"qīng rú shuǐ，míng rú jìng","abbr":"qrsmrj","explanation":"形容官吏廉洁自守，办事明智无误。","source":{"text":"老爷是清如水，明如镜，万人念佛的。老爷试想，偷了人家东西，还说人家欠他银子，再没有了出外人过的日子。","book":"清·李绿园《歧路灯》第十一回"},"example":{"text":"看来，想要让所有的官员们，一个个～，竟是一厢情愿，水中捞月！","book":"二月河《雍正皇帝》七十二"},"similar":["清正廉洁"],"usage":"作谓语、定语；用于比喻句"},{"id":29610,"word":"清官能断家务事","pinyin":"qīng guān néng duàn jiā wù shì","abbr":"qgndjws","explanation":"俗语。表示家族纠纷情况复杂，只有更公正的官吏才有可能断定谁是谁非。","source":{"text":"人们常说清官难断家务事，哈，这次我做到了清官能断家务事。","book":"曹树厚《好梦成真记》第六十九章"}},{"id":29611,"word":"清官难断家事","pinyin":"qīng guān nán duàn jiā shì","abbr":"qgndjs","explanation":"清官：公正清廉的官吏。指家庭内部纠纷情况复杂，外人没法断定谁是谁非","source":{"text":"常言道：‘清官难断家事’，我如今管你母子一生衣食充足，你也休做十分大望。","book":"明·冯梦龙《喻世明言》第十卷"},"similar":["清官难断家务事"],"usage":"作宾语、定语、分句；指家务事情复杂"},{"id":29612,"word":"清官难断家务事","pinyin":"qīng guān nán duàn jiā wù shì","abbr":"qgndjws","explanation":"再公正的官吏也很难论断家庭纠纷的是非曲直。指家庭内部的事，外人很难搞清楚。","source":{"text":"常言道清官难断家事。我如今管你母子一生衣食充足，你也休做十分大望。","book":"明·冯梦龙《喻世明言》第十卷"},"example":{"text":"实是俗语说的‘～’，此事正是公婆难断床帏事了。","book":"清·曹雪芹《红楼梦》第八十回"},"similar":["清官难断家事"],"usage":"作宾语、分句；指家务事情复杂"},{"id":29613,"word":"清宫除道","pinyin":"qīng gōng chú dào","abbr":"qgcd","explanation":"清、除：洒水扫除；宫：古代房屋的通称。打扫房屋和道路。指准备迎接贵宾到来。","source":{"text":"将说楚王，路过洛阳，父母闻之，清宫除道，张乐设饮，郊迎三十里。","book":"《战国策·秦策一》"},"example":{"text":"吏民歌吟思汉久矣，故更始举尊号而天下响应，三辅～以迎之。","book":"《后汉书·邳彤传》"},"usage":"作谓语；指准备迎接贵宾到来"},{"id":29614,"word":"清尘浊水","pinyin":"qīng chén zhuó shuǐ","abbr":"qczs","explanation":"清尘：喻他人；浊水：喻自己。比喻相隔很远，会面没有希望。","source":{"text":"君若清路尘，妾若浊水泥，浮沉各异势，会合何时谐？","book":"三国魏·曹植《七哀诗》"},"example":{"text":"歙漆阿胶忽纷解，～何由逢。","book":"明·李昌褀《剪灯余话·田洙遇薛涛联句记》"},"usage":"作宾语；比喻相隔很远，没有希望会面","story":["三国时期，曹植年少时聪明伶俐，经常出口成章，深受曹操的宠爱。曹操见其做事任性，行为不检，就没有立他太子。曹丕上台后对他不信任，总想找机会除掉他。曹植一心想报国，写《七哀诗》：“君若清路尘，妾若浊水泥，浮沉各异势，会合何时偕！”"]},{"id":29615,"word":"清平世界","pinyin":"qīng píng shì jiè","abbr":"qpsj","explanation":"清平：安定，太平；世界：这里是世道的意思。指社会安定，天下太平。","source":{"text":"清平世界说什么佛法。","book":"宋·释普济《五灯会元》"},"example":{"text":"～，荡荡乾坤，逼死人命。","book":"明·罗贯中《平妖传》第24回"},"similar":["太平盛世"],"opposite":["兵荒马乱"],"usage":"作主语、宾语、定语；指太平盛世"},{"id":29616,"word":"清庙之器","pinyin":"qīng miào zhī qì","abbr":"qmzq","explanation":"原指宗庙里的祭器。后比喻可以担当国家重任的人。","source":{"text":"武昌牛僧孺辟署掌书记，还为殿中侍御史。宰宰相韦处厚曰：‘清庙之器,岂击搏才乎?’除礼部员外郎。","book":"《新唐书·李珏传》"}},{"id":29617,"word":"清廉正直","pinyin":"qīng lián zhèng zhí","abbr":"qlzz","explanation":"清白廉洁，为人正直不阿。","source":{"text":"我不以清廉方正奉法，乃以贪污之心枉法以取私利，是犹上高陵之颠，堕峻溪之下以求生，凶不几矣。","book":"《韩非子·奸劫弑臣》"},"example":{"text":"亲自问杀人贼，全不论～，倒不如懵懵遇痴。","book":"元·孙仲章《勘头巾》第三折"},"usage":"作谓语、定语、宾语；用于为人"},{"id":29618,"word":"清微淡远","pinyin":"qīng wēi dàn yuǎn","abbr":"qwdy","explanation":"清雅微妙，淡泊深远。","source":{"text":"小时跟着你们雨村先生念书，也曾看过。内中也有近情尽理的，也有清微淡远的。","book":"清·曹雪芹《红楼梦》第82回"},"example":{"text":"他喜欢结交～的朋友。"},"usage":"作谓语、定语；用于书面语"},{"id":29619,"word":"清心寡欲","pinyin":"qīng xīn guǎ yù","abbr":"qxgy","explanation":"清：清净；寡：少：欲：欲望，需求。保持心地清净，减少欲念。","source":{"text":"隗字仲和，少好黄老，清静寡欲。","book":"《后汉书·任隗传》"},"example":{"text":"刘均佐，我奉师父法旨，等你清心寡欲，受戒持斋，不许凡心动。","book":"元·郑廷玉《忍字记》第三折"},"similar":["清心少欲","清静寡欲"],"opposite":["欲壑难填"],"usage":"作谓语、宾语；指心地清净"},{"id":29620,"word":"清心少欲","pinyin":"qīng xīn shǎo yù","abbr":"qxsy","explanation":"指保持心地清净，少生欲念。","source":{"text":"出行雍州刺史，清心少欲，吏民安之。","book":"《魏书·张衮传》"},"similar":["清心寡欲"],"usage":"作谓语、宾语、定语；指心地清净"},{"id":29621,"word":"清心省事","pinyin":"qīng xīn shěng shì","abbr":"qxss","explanation":"指心境清静，政事杂务简省。","source":{"text":"人君与天同德，惟当清心省事，淡然虚静，损之又损，至于无为。","book":"宋·陆游《上殿札子》"},"example":{"text":"临发，疏诸～，与民休息。","book":"《清史稿·冯溥传》"},"usage":"作谓语、定语；用于为人"},{"id":29622,"word":"清新俊逸","pinyin":"qīng xīn jùn yì","abbr":"qxjy","explanation":"指诗文清美新颖，不落俗套。","source":{"text":"清新庾开府，俊逸鲍参军。","book":"唐·杜甫《春日忆李白》诗"},"example":{"text":"～，庾子山、鲍明远也只如此。","book":"明·梅鼎祚《玉合记·参成》"},"similar":["清丽俊逸"],"usage":"作谓语、定语；指不落俗套"},{"id":29623,"word":"清旷超俗","pinyin":"qīng kuàng chāo sú","abbr":"qkcs","explanation":"指清明旷达，超脱于世俗之外。","source":{"text":"欲一去而不还，怅邹衣之未褫。揖林壑之清旷，事氓俗之纷诡。","book":"南朝·梁·沈约《被褐守山东》"}},{"id":29624,"word":"清明在躬","pinyin":"qīng míng zài gōng","abbr":"qmzg","explanation":"清明：指人的神志很清醒；躬：指自身。形容人的心地光明正大，头脑清晰明辨。","source":{"text":"清明在躬，气志如神。嗜欲将至，有开必先。","book":"《礼记·孔子闲居》"},"example":{"text":"只尹继善此人～，多年的“江南王”。","book":"二月河《乾隆皇帝》二十九"}},{"id":29625,"word":"清曹峻府","pinyin":"qīng cáo jùn fǔ","abbr":"qcjf","explanation":"曹、府：官府。泛指庄严肃穆的官署。","source":{"text":"朝廷上下相蒙，善恶同致。清曹峻府，为鼠养资，岂所以裨政邪？","book":"宋·王谠《唐语林·方正》"}},{"id":29626,"word":"清曹竣府","pinyin":"qīng cáo jùn fǔ","abbr":"qcjf","explanation":"曹：官府。庄严肃静的官府。","source":{"text":"朝廷上下相蒙，善恶同政。清曹竣府，为鼠辈养资，岂所以裨政邪？","book":"宋·王谠《唐语林·方正》"},"usage":"作主语、宾语、定语；用于官府"},{"id":29627,"word":"清歌妙舞","pinyin":"qīng gē miào wǔ","abbr":"qgmw","explanation":"指清亮的歌声，美妙的舞蹈。","source":{"text":"此翁白头真可怜，伊昔红颜美少年。公子王孙芳树下，清歌妙舞落花前。","book":"唐·宋之问《有所思》"},"example":{"text":"步寒宫出落的紫霓裳，一个个～世上无双。","book":"明·汤显祖《邯郸记·极欲》"},"similar":["轻歌妙舞"],"usage":"作宾语、定语；指歌舞"},{"id":29628,"word":"清歌曼舞","pinyin":"qīng gē màn wǔ","abbr":"qgmw","explanation":"清亮的歌声，柔美的舞蹈。","source":{"text":"‘乾嘉以降’不久，昆曲的清歌曼舞的绮梦，给红巾长毛的‘叛贼’揭乱了。","book":"瞿秋白《乱弹·代序》"},"similar":["轻歌曼舞"],"usage":"作谓语、宾语、定语；用于欢娱"},{"id":29629,"word":"清歌雅舞","pinyin":"qīng gē yǎ wǔ","abbr":"qgyw","explanation":"歌声清新悦耳，舞姿轻盈优美。","source":{"text":"清歌自言妍，雅舞空仟仟。","book":"南朝·梁·丘迟《敬酬柳仆射征怨》诗"},"example":{"text":"～，暂同于梦寐；广厦高堂，俄成于幻化。","book":"南朝·梁·何逊《七召·神仙》"}},{"id":29630,"word":"清正廉明","pinyin":"qīng zhèng lián míng","abbr":"qzlm","explanation":"比喻为官廉洁公正，不贪污徇私。","source":{"text":"忽的云板响亮，皂役高喝，一位清正廉明的边公，又坐到暖阁内边了。","book":"清·李绿园《歧路灯》第六十五回"}},{"id":29631,"word":"清正廉洁","pinyin":"qīng zhèng lián jié","abbr":"qzlj","explanation":"品行端正，为人正直廉洁。","example":{"text":"～的官员值得表扬。"},"similar":["清正廉明"],"usage":"作谓语、定语；用于为人","story":["明朝时期，清正廉洁的清官海瑞不畏强权，在担任延平府南平县教谕时，按《会典》规定不向延平府官员下跪行拜礼，获“笔架博士”雅号。他从不收受贿赂，也看不惯别的官员讲排场，主张为人正直，讲孝道，资助贫寒学士"]},{"id":29632,"word":"清水冷灶","pinyin":"qīng shuǐ lěng zào","abbr":"qslz","explanation":"形容生活清苦。","source":{"text":"这时候是个小家庭蒸蒸日上的建设时期，可是他们这里却是清水冷灶，没有增设，连必要的投资也都送进了书店。","book":"陆文夫《献身》"},"example":{"text":"我不想一辈子都过～的生活。"},"similar":["清灰冷灶","清锅冷灶"],"usage":"作宾语、定语；指生活贫困"},{"id":29633,"word":"清水出芙蓉","pinyin":"qīng shuǐ chū fú róng","abbr":"qscfr","explanation":"芙蓉：荷花的别称。形容诗文清丽，犹如出水的芙蓉一样清新。","source":{"text":"清水出芙蓉，天然去雕饰。","book":"唐·李白《经乱离後天恩流夜郎忆旧游书怀赠江夏韦太守良宰》"}},{"id":29634,"word":"清水无大鱼","pinyin":"qīng shuǐ wú dà yú","abbr":"qswdy","explanation":"指待人处事不能求全责备。","source":{"text":"水至清则无鱼，人至察则无徒。","book":"东汉·班固《汉书·东方朔传》"},"example":{"text":"今君性严急，～，将军宜宽小过，总大纲而已。","book":"晋·袁宏《后汉纪·和帝纪》"},"similar":["水清无鱼"],"opposite":["浑水摸鱼"],"usage":"作宾语、定语；用于劝诫人"},{"id":29635,"word":"清水衙门","pinyin":"qīng shuǐ yá mén","abbr":"qsym","explanation":"比喻没有油水的机构或地方。","source":{"text":"在市总工会混了两年，觉得工会是清水衙门。","book":"《新华月报》1980年第5期"},"example":{"text":"我们单位是一个真正的～。"},"usage":"作主语、宾语、定语；指没有外快"},{"id":29636,"word":"清汤寡水","pinyin":"qīng tāng guǎ shuǐ","abbr":"qtgs","explanation":"形容菜肴水太多，粗糙没有味道。","example":{"text":"他很快就适应了这～的生活。"},"similar":["粗茶淡饭"],"opposite":["山珍海味"],"usage":"作宾语、定语；指生活清苦"},{"id":29637,"word":"清洌可鉴","pinyin":"qīng liè kě jiàn","abbr":"qlkj","explanation":"洌：水清。鉴：照。清澈得可以照见人影。","source":{"text":"……山麓有树大合抱，倚崖而耸立，下有泉，东向漱根窍而出，清洌可鉴。","book":"冯牧《澜沧江边的蝴蝶会》"}},{"id":29638,"word":"清浊同流","pinyin":"qīng zhuó tóng liú","abbr":"qztl","explanation":"清水与浊水一渠同流。比喻美恶混杂，良莠不分。","source":{"text":"今之九品，所下不彰其罪，所上不列其善，废褒贬之义，任爱憎之断，清浊同流，以植其私。","book":"《晋书·刘毅传》"},"example":{"text":"我们不能让～、是非不分的现象存在。"},"similar":["同流合污","好坏不分"],"opposite":["泾渭分明"],"usage":"作宾语、定语；指好坏不分"},{"id":29639,"word":"清浊难澄","pinyin":"qīng zhuó nán chéng","abbr":"qznc","explanation":"清水和浊水混在一起，使人很难分清楚。"},{"id":29640,"word":"清浑皁白","pinyin":"qīng hún wú bái","abbr":"qhzb","explanation":"比喻事物的本来面目、是非、情由等。"},{"id":29641,"word":"清清楚楚","pinyin":"qīng qīng chǔ chǔ","abbr":"qqcc","explanation":"清晰明白有条理。","source":{"text":"盗窃国家财产，贪污受贿，这是现钱买卖，清清楚楚，不容易搞错。","book":"邓小平《坚决打击经济犯罪活动》"},"example":{"text":"我把帐目理得～了。"},"similar":["明明白白"],"opposite":["糊里糊涂"],"usage":"作定语、状语；指十分清晰"},{"id":29642,"word":"清清爽爽","pinyin":"qīng qīng shuǎng shuǎng","abbr":"qqss","explanation":"指整洁干净或清新凉爽。","source":{"text":"好是无啥好，不过清清爽爽，倒像是个娘姨。","book":"清·韩邦庆《海上花列传》第15回"},"example":{"text":"地上，炕上，还有那个小炕桌，都被他弄得～。","book":"路遥《平凡的世界》第六卷第41章"},"similar":["干干净净"],"usage":"作定语、状语；用于口语"},{"id":29643,"word":"清清白白","pinyin":"qīng qīng bái bái","abbr":"qqbb","explanation":"品行纯洁，没有污点，特指廉洁。","source":{"text":"古人曾也说的，‘不作狠心人，难得自了汉。’我清清白白的一个人，为什么教你们带累坏了我！","book":"清·曹雪芹《红楼梦》第74回"},"example":{"text":"我这辈子一向都是～的。"},"similar":["一清二白","干干净净"],"opposite":["一团漆黑"],"usage":"作谓语、定语、状语；指人的品行等","story":["大观园内发现了春宫画香袋，王夫人命王熙凤去搜园内各丫鬟的住房，希望能发现一些蛛丝马迹。在惜春房内发现丫鬟入画藏有金银首饰，惜春坚决要撵出入画。尤氏等查明原因，证明入画不是偷的。惜春要清清白白做人，坚决不要入画了"]},{"id":29644,"word":"清清静静","pinyin":"qīng qīng jìng jìng","abbr":"qqjj","explanation":"安安静静，不嘈杂。","source":{"text":"我这一进去，他又赌气走了，不如咱们回去罢，让他两个清清静静的说一回。","book":"清·曹雪芹《红楼梦》第54回"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“剩下胡雪岩与张胖子，才得～谈话。”"},"similar":["安安静静"],"usage":"作谓语、定语、状语；指十分清闲"},{"id":29645,"word":"清渭浊泾","pinyin":"qīng wèi zhuó jīng","abbr":"qwzj","explanation":"渭河水清，泾河水浑，泾河的水流入渭河时，清浊不混。比喻界限清楚或是非分明。","source":{"text":"泾以渭浊，湜湜其沚。","book":"《诗经·邶风·谷风》"},"example":{"text":"北有～，兰池周曲。","book":"晋·潘岳《西征赋》"},"similar":["泾渭分明","浊泾清渭"],"usage":"作宾语、定语；用于比喻句"},{"id":29646,"word":"清源正本","pinyin":"qīng yuán zhèng běn","abbr":"qyzb","explanation":"清源：从源头上清理；正本：从根本上整顿。从源头上清理，从根本上整顿。比喻从根本上加以整顿清理。","source":{"text":"思与天下式明王度，正本清源。","book":"《汉书·刑法志》：“岂宜惟思所以清原正本之论，删定律令。”《晋书·武帝纪》"},"example":{"text":"惟欲～，还应谴及牛李二人。","book":"蔡东藩《唐史演义》第八十六回"},"similar":["清原正本"],"usage":"作宾语、定语；用于书面语"},{"id":29647,"word":"清灰冷火","pinyin":"qīng huī lěng huǒ","abbr":"qhlh","explanation":"没吃没喝。常用以形容贫困冷清的景象。同“清灰冷灶”。","source":{"text":"及至到了家，清灰冷火的锁着门。","book":"清·西周生《醒世姻缘传》第85回"},"similar":["清灰冷灶","清锅冷灶"],"usage":"作宾语、定语；用于无法吃饭"},{"id":29648,"word":"清灰冷灶","pinyin":"qīng huī lěng zào","abbr":"qhlz","explanation":"形容生活窘迫，久不举火。","source":{"text":"空滴滴，清灰冷灶谁曾惯，黑漫漫苦海无边岸。","book":"明·无名氏《龙门隐秀》第一折"},"example":{"text":"这般关门不出，我们这清灰冷灶，一夜怎过！","book":"明·吴承恩《西游记》第二十三回"},"similar":["清灰冷火","清锅冷灶"],"usage":"作宾语、定语；用于无法吃饭"},{"id":29649,"word":"清简寡欲","pinyin":"qīng jiǎn guǎ yù","abbr":"qjgy","explanation":"欲：欲望。保持心地清净，很少欲望。","source":{"text":"转河间内史，在郡清简寡欲。","book":"《晋书·张协传》"},"similar":["清心寡欲","清静寡欲"],"usage":"作谓语、宾语、定语；指心地清净"},{"id":29650,"word":"清耳悦心","pinyin":"qīng ěr yuè xīn","abbr":"qeyx","explanation":"耳朵为之清宁，心情为之欢悦。形容声音美妙动听。","source":{"text":"春露初霭，朝华始敷，文羽清喙，飞鸣自如，若奏琴筝而和笙竽，清耳悦心，听者为娱。","book":"宋·张耒《鸣蛙赋》"},"usage":"作谓语、定语；用于声音等"},{"id":29651,"word":"清茶淡话","pinyin":"qīng chá dàn huà","abbr":"qcdh","explanation":"清：清淡。喝着清茶随意闲聊。形容待客亲切随和。","source":{"text":"寐静茅庵潇洒，危峰密锁烟霞。朝阳轩外一枝斜，待客清茶淡话。","book":"金·侯善渊《西江月》词"},"example":{"text":"借人茅屋，但有客相过，～，闲与论今古。","book":"元·谢应芳《摸鱼子》词"},"usage":"作宾语、定语、状语；用于为人"},{"id":29652,"word":"清茶淡饭","pinyin":"qīng chá dàn fàn","abbr":"qcdf","explanation":"清：清淡。形容饭食非常简单。","source":{"text":"三叔，你今到寒家，清茶淡饭，暂住几日。","book":"明·冯梦龙《警世通言》第24卷"},"example":{"text":"我已经习惯了这～的生活。"},"similar":["清汤寡水"],"opposite":["山珍海味"],"usage":"作主语、宾语、定语；指简单饮食"},{"id":29653,"word":"清莹秀彻","pinyin":"qīng yíng xiù chè","abbr":"qyxc","explanation":"莹：光洁明亮；彻：通透。清洁光亮、秀丽透彻。形容诗文意境清新，词藻华美。","source":{"text":"清莹秀彻，锵鸣金石。","book":"唐·柳宗元《愚溪诗序》"},"example":{"text":"他的作品～，让人耳目一新。"},"usage":"作谓语、定语；用于文章等"},{"id":29654,"word":"清莹秀澈","pinyin":"qīng yíng xiù chè","abbr":"qyxc","explanation":"清洁光亮、秀丽澄澈。"},{"id":29655,"word":"清虚洞府","pinyin":"qīng xū dòng fǔ","abbr":"qxdf","explanation":"指月宫。","source":{"text":"除却了清虚洞府，只有那沉香亭院。","book":"清·洪昇《长生殿·骂贼》"},"usage":"作宾语、定语；指月宫"},{"id":29656,"word":"清规戒律","pinyin":"qīng guī jiè lǜ","abbr":"qgjl","explanation":"原指佛教徒所遵守的规则和戒条。现比喻束缚人的繁琐不合理的规章制度。","source":{"text":"百丈山怀海禅师始立天下禅林规式，谓之清规。","book":"《释门正统》"},"example":{"text":"老先生～很多，学生们都很怕他。"},"similar":["墨守成规","因循守旧"],"opposite":["推陈出新","打破常规"],"usage":"作主语、宾语；指不合理的规章制度"},{"id":29657,"word":"清议不容","pinyin":"qīng yì bù róng","abbr":"qybr","explanation":"清议：公正的评论。行为不正，舆论不容许。","source":{"text":"当一人侧席于上，多士建议于下，臣若肆然自处，默无所为，清议不容，素履将丧。","book":"宋·苏舜钦《杜公求退第一表》"},"example":{"text":"帝虽以挠察典责之，国观卒免察。然～，旋以终养去。","book":"《明史·薛国观传》"},"usage":"作谓语、定语；用于行为等"},{"id":29658,"word":"清词丽句","pinyin":"qīng cí lì jù","abbr":"qclj","explanation":"指清新美丽的词句。","source":{"text":"不薄今人爱古人，清词丽句必为邻。","book":"唐·杜甫《戏为六绝句》之五"},"example":{"text":"若唐之李杜韩柳、本朝之欧王苏黄，～，不可悉数。","book":"宋·胡仔《苕溪隐渔丛话后集·楚汉魏六朝》"},"similar":["清辞丽句"],"usage":"作主语、宾语、定语；用于文章等"},{"id":29659,"word":"清词妙句","pinyin":"qīng cí miào jù","abbr":"qcmj","explanation":"清新绝妙的诗文词句。形容诗词所用的语言清新华美。","source":{"text":"音义既远，清词妙句，焱绝焕柄。","book":"汉·陈琳《答东阿王笺》"},"example":{"text":"南宋乐府，～，略尽于此。","book":"清·谭献《复堂词话》"}},{"id":29660,"word":"清谈高论","pinyin":"qīng tán gāo lùn","abbr":"qtgl","explanation":"高妙清正而空泛不实的言论。","source":{"text":"孔公绪清谈高论，噓枯吹生，并无军旅之才。","book":"《后汉书·郑太傅传》"},"example":{"text":"孔公绪徒～，吹枯嘘生，并无甚么韬略，足为公敌。","book":"蔡东藩《后汉演义》第六十七回"}},{"id":29661,"word":"清贫如洗","pinyin":"qīng pín rú xǐ","abbr":"qprx","explanation":"穷得象用水洗过似的，什么都没有。形容十分贫穷。","source":{"text":"清贫如洗，无以为殓，龚为经理其丧，复资助旅费。","book":"清·李心衡《金川琐记·示梦先生》"},"example":{"text":"我再也不想过～的日子。"},"similar":["一贫如洗","一无所有"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；形容贫穷"},{"id":29662,"word":"清贫寡欲","pinyin":"qīng pín guǎ yù","abbr":"qpgy","explanation":"清寒贫苦，欲念甚少。","source":{"text":"谦廉不竞，曾撰《儒棋》，以表其志焉。清贫寡欲，资仰俸禄而已。","book":"《魏书·游明根传》"},"example":{"text":"～，终日长蔬，虽有妻子，独处山舍。","book":"宋·吴曾《能改斋漫录·周颙宅作阿兰若》"},"usage":"作谓语、宾语、定语；用于生活"},{"id":29663,"word":"清跸传道","pinyin":"qīng bì chuán dào","abbr":"qbcd","explanation":"清跸：帝王出行时开路清道，禁止通行。指帝王或大官出巡时护卫传呼清道，禁止行人通过。","source":{"text":"两街仪卫喧阗，清跸传道，人马森列，多官俱上马远送，太尉悉令免之，举手上轿而去。","book":"明·兰陵笑笑生《金瓶梅词话》第六十六回"},"similar":["鸣锣喝道"],"usage":"作谓语、定语、宾语；用于帝王出行"},{"id":29664,"word":"清身洁己","pinyin":"qīng shēn jié jǐ","abbr":"qsjj","explanation":"指保持自身节操，身体力行。","source":{"text":"太保王弘每称其清身洁己。","book":"《南史·可尚之传》"},"example":{"text":"系及二弟洁育并～，甚得声誉。","book":"《晋书·解系传》"},"similar":["洁身自好"],"usage":"作谓语、宾语；用于为人"},{"id":29665,"word":"清辞丽句","pinyin":"qīng cí lì jù","abbr":"qclj","explanation":"指清新美丽的词句。同“清词丽句”。","source":{"text":"读其诗，摹写物情，颂美祖德，称述土风，清辞丽句，时时错出。","book":"清·戴名世《道墟图诗序》"},"similar":["清词丽句","清辞丽曲"],"usage":"作主语、宾语、定语；用于文章等"},{"id":29666,"word":"清辞丽曲","pinyin":"qīng cí lì qǔ","abbr":"qclq","explanation":"指清新美丽的词曲。同“清词丽句”。","source":{"text":"清辞丽曲，时发手篇。","book":"《宋书·谢灵运传》"},"similar":["清辞丽句","清词丽句"],"usage":"作主语、宾语、定语；用于文章等"},{"id":29667,"word":"清辞妙句","pinyin":"qīng cí miào jù","abbr":"qcmj","explanation":"喜事从天上掉下来。比喻突然遇到意想不到的喜事。","source":{"text":"贵脚踏践地，使下官喜从天降。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"张顺见了宋江，～。","book":"明·施耐庵《水浒全传》第四十回"},"similar":["清辞丽句"],"usage":"作主语、宾语、定语；用于文章等"},{"id":29668,"word":"清道夫","pinyin":"qīng dào fū","abbr":"qdf","explanation":"旧时称城市的清洁工。现指扫除障碍的人。","example":{"text":"我成了她的～了。"},"usage":"作宾语、定语；用于比喻句"},{"id":29669,"word":"清都紫府","pinyin":"qīng dōu zǐ fǔ","abbr":"qdzf","explanation":"神话传说中天帝所居之宫阙。同“清都紫微”。","source":{"text":"莫问清都紫府，长教绿鬓朱颜。","book":"宋·张孝祥《西江月·代五三弟为老母》词"},"similar":["清都绛阙","清都紫微"],"usage":"作宾语、定语；用于书面语"},{"id":29670,"word":"清都紫微","pinyin":"qīng dōu zǐ wēi","abbr":"qdzw","explanation":"神话传说中天帝所居之宫阙。","source":{"text":"王实以为清都紫微，钧天广乐，旁之所居。","book":"战国·郑·列御寇《列子·周穆王》"},"example":{"text":"始八岁经仙城山……有～之遐想。","book":"唐·李白《汉东紫阳先生碑铭》"},"similar":["清都紫府","清都绛阙"],"usage":"作宾语、定语；用于书面语"},{"id":29671,"word":"清都绛阙","pinyin":"qīng dōu jiàng què","abbr":"qdjq","explanation":"神话传说中天帝所居之宫阙。同“清都紫微”。","source":{"text":"清都绛阙，我自经行惯。璧月带珠星，引钧天、笙箫不断。","book":"宋·张孝祥《蓦山溪》词"},"similar":["清都紫府","清都紫微"],"usage":"作宾语、定语；用于书面语"},{"id":29672,"word":"清酌庶羞","pinyin":"qīng zhuó shù xiū","abbr":"qzsx","explanation":"清醇美酒，多样佳肴。指祭奠用品。","source":{"text":"维年月日，具官欧阳修谨以濔酌庶羞之奠致祭于亡友湖州长史苏君子美之灵。","book":"宋·欧阳修《祭苏子美文》"},"example":{"text":"男玄奘谨以～，致祭于亡考洪州知府君之灵。","book":"元·杨景贤《西游记》第四折"},"similar":["美酒佳肴"],"usage":"作宾语、定语；用于书面语"},{"id":29673,"word":"清锅冷灶","pinyin":"qīng guō lěng zào","abbr":"qglz","explanation":"没吃没喝。常用以形容贫困冷清的景象。同“清灰冷灶”。","source":{"text":"走到计氏院内，只见清锅冷灶，一物也无。","book":"清·西周生《醒世姻缘传》第三回"},"similar":["清灰冷灶","清灰冷火"],"usage":"作宾语、定语；用于无法吃饭"},{"id":29674,"word":"清闲自在","pinyin":"qīng xián zì zài","abbr":"qxzz","explanation":"清静空闲，无拘无束。形容生活安闲舒适。","source":{"text":"老夫自谪济南歇马，倒也清闲自在。","book":"元·王实甫《丽堂春》第四折"},"example":{"text":"我向往过～的生活。"},"similar":["逍遥自在"],"usage":"作谓语、定语；指生活安闲"},{"id":29675,"word":"清雅绝尘","pinyin":"qīng yǎ jué chén","abbr":"qyjc","explanation":"洁净高雅，一尘不染。","source":{"text":"这屋里清雅绝尘，有加无已的花，把我围将起来。","book":"冰心《寄小读者》"},"example":{"text":"我有一帮～的小朋友跟着，怎么能不活力四射呢？"},"usage":"作谓语、定语；指清新雅致"},{"id":29676,"word":"清静寡欲","pinyin":"qīng jìng guǎ yù","abbr":"qjgy","explanation":"清：清净；寡：少：欲：欲望，需求。保持心地清净，减少欲念。","source":{"text":"隗字仲和，少好黄老，清静寡欲。","book":"《后汉书·任隗传》"},"example":{"text":"尊祖高才而性退让，慈和泛爱，～，不营当世，惟修德行而已。","book":"《晋书·庾峻传》"},"similar":["清心寡欲","清心少欲"],"usage":"作谓语、宾语、定语；指心地清净"},{"id":29677,"word":"清静无为","pinyin":"qīng jìng wú wéi","abbr":"qjww","explanation":"道家语。春秋时期道家的一种哲学思想和治术。指一切听其自然，人力不必强为。","source":{"text":"闻昔人君崇尚土木，孰若清静无为，邑人以康。","book":"宋·王曾《谏作玉清昭应宫》"},"example":{"text":"真正能过上～的生活也不错。"},"similar":["清净无为"],"usage":"作宾语、定语；指一切事情听其自然"},{"id":29678,"word":"清音幽韵","pinyin":"qīng yīn yōu yùn","abbr":"qyyy","explanation":"比喻文章造诣极深。","source":{"text":"其清音幽韵，凄如飘风急雨之骤至。","book":"宋·王安石《祭欧阳文忠公文》"},"example":{"text":"我也想写出～的好文章来。"},"usage":"作宾语、定语；用于文章等"},{"id":29679,"word":"清风两袖","pinyin":"qīng fēng liǎng xiù","abbr":"qflx","explanation":"衣袖中除清风外，别无所有。比喻做官廉洁。也比喻穷得一无所有。","source":{"text":"两袖清风身欲飘，杖藜随月步长桥。","book":"元·陈基《次韵吴江道中》诗"},"example":{"text":"绢帕麻菇与线香，本资民用反为殃；～朝天去，免得闾阎话短长。","book":"明·都穆《都公谭篡》卷上"},"similar":["两袖清风"],"opposite":["公饱私囊"],"usage":"作谓语、定语；指为官清廉","story":["明朝时期，于谦从小受到良好的教育，他很敬佩苏武、诸葛亮、文天祥等，他先后在明宣宗、英宗、代宗各朝做官，为官十分清廉，从不揽权纳贿和向权贵进贡，《入京》诗有体现：“绢帕麻菇与线香，本资民用反为殃。清风两袖朝天去，免得闾阎话短长。"]},{"id":29680,"word":"清风亮节","pinyin":"qīng fēng liàng jié","abbr":"qflj","explanation":"比喻人品格高尚，节操坚贞。","source":{"text":"然司空图清风亮节，唐季忠臣。","book":"清·袁枚《随园诗话》第八卷"},"example":{"text":"他以～而文明于世。"},"similar":["清风高节"],"usage":"作谓语、宾语、定语；指人的节操"},{"id":29681,"word":"清风劲节","pinyin":"qīng fēng jìn jié","abbr":"qfjj","explanation":"比喻人的品格清正，节操坚贞。","source":{"text":"公雍容侍从之列，以清风峻节，为一时所畏。","book":"唐·韩愈《朝奉大夫尚书度支郎中充天章阁待制王公行状》"},"example":{"text":"我有～之标，戛玉鸣金之韵，用分一半，少答殷勤。","book":"明·朱有燉《赛娇容》第二折"},"similar":["高风亮节"],"usage":"作宾语、定语；指人的节操"},{"id":29682,"word":"清风峻节","pinyin":"qīng fēng jùn jié","abbr":"qfjj","explanation":"清廉正直的风尚，高尚峻伟的气节。","source":{"text":"公雍容侍从之列，以清风峻节，为一时所畏。","book":"唐·韩愈《朝奉大夫尚书度支郎中充天章阁待制王公行状》"},"example":{"text":"吾师～，夙昔所仪。","book":"清·陈确《上闵辰先生书》"},"similar":["清风劲节"],"usage":"作宾语、定语；指人的节操"},{"id":29683,"word":"清风明月","pinyin":"qīng fēng míng yuè","abbr":"qfmy","explanation":"只与清风、明月为伴。比喻不随便结交朋友。也比喻清闲无事。","source":{"text":"入吾室者，但有清风；对吾饮者，惟当明月。","book":"《南史·谢惠传》"},"example":{"text":"金马玉堂三学士，～两闲人。","book":"宋·欧阳修《会老堂致语》"},"similar":["清风朗月"],"usage":"作宾语、定语；比喻清闲无事"},{"id":29684,"word":"清风朗月","pinyin":"qīng fēng lǎng yuè","abbr":"qfly","explanation":"比喻不随便结交朋友。也比喻清闲无事。同“清风明月”。","source":{"text":"清风朗月不用一钱买，玉山自倒非人推。","book":"唐·李白《襄阳歌》"},"example":{"text":"谢镇西经船行，其夜～，闻江渚间估客船上有咏诗声，甚有情致，所诵五言，又其所未尝闻，叹美不能已。","book":"朱自清《论书生的酸气》"},"similar":["清风明月"],"usage":"作宾语、定语；比喻清闲无事"},{"id":29685,"word":"清风高节","pinyin":"qīng fēng gāo jié","abbr":"qfgj","explanation":"比喻人品格纯洁，节操高尚。","source":{"text":"我有清风高节在，知君不负岁寒交。","book":"唐·牟融《题赵支》诗"},"example":{"text":"果然华歆后来附了曹操，杀伏皇后，废汉献帝，管宁～，浊世不污。","book":"清·西周生《醒世姻缘传》第三十四回"},"similar":["清风峻节"],"usage":"作宾语、定语；指人的节操"},{"id":29686,"word":"清风高谊","pinyin":"qīng fēng gāo yì","abbr":"qfgy","explanation":"风格高尚，友谊深厚。","source":{"text":"以荐冥福，清风高谊，传播江湖间。","book":"《剪灯余话·两川都辖院志》"},"usage":"作宾语、定语；用于为人"},{"id":29687,"word":"渊亭山立","pinyin":"yuān tíng shān lì","abbr":"ytsl","explanation":"比喻人品德如渊水深沉，如高山耸立。同“渊渟岳峙”。"},{"id":29688,"word":"渊停山立","pinyin":"yuān tíng shān lì","abbr":"ytsl","explanation":"喻人品德如渊水深沉，如高山耸立。","source":{"text":"公生而孝友顺祥，笃诫明允，渊停山立，不苟訾笑。","book":"清·钱谦益《太保都察院左都御史李公神道碑》"},"similar":["渊渟岳立","渊渟岳峙"],"usage":"作谓语、定语；用于书面语"},{"id":29689,"word":"渊图远算","pinyin":"yuān tú yuǎn suàn","abbr":"ytys","explanation":"深谋远虑。","source":{"text":"世祖顾命，情深尊嫡，渊图远算，意在无遗。","book":"《南齐书·高帝十二王传论》"},"similar":["深谋远虑"],"usage":"作宾语、定语；用于处事"},{"id":29690,"word":"渊思寂虑","pinyin":"yuān sī jì lǜ","abbr":"ysjl","explanation":"深入而冷静地思考。","source":{"text":"体已康矣，志已壮矣。渊思寂虑，默想曩昔之艺业，可温习乎？","book":"唐·白行简《李娃传》"}},{"id":29691,"word":"渊涌风厉","pinyin":"yuān yǒng fēng lì","abbr":"yyfl","explanation":"如水之涌，如风之疾。比喻谈吐滔滔不绝。","source":{"text":"士有机变清锐，巧言绮粲，揽引譬喻，渊涌风厉。然而口之所谈，身不能行。","book":"晋·葛洪《抱朴子·行品》"},"usage":"作宾语、定语；用于比喻句"},{"id":29692,"word":"渊涓蠖濩","pinyin":"yuān juān huò hù","abbr":"yjhh","explanation":"刻镂之形。借指华丽的宫殿。","source":{"text":"人主能时怀警惧，而渊涓蠖濩之中，此心卓然清明，则宴安之欲不生，而虑周于天下，衅孽之萌无所作矣。","book":"《隆庆元年浙江程策》之一"},"similar":["渊蜎蠖伏"],"usage":"作宾语、定语；用于书面语"},{"id":29693,"word":"渊涓蠖瀋","pinyin":"yuān juān huò hù","abbr":"yjhh","explanation":"刻镂之形。借指华丽的宫殿。","source":{"text":"之一人主能时怀警惧，而渊涓蠖瀋之中，此心卓然清明，则宴安之欲不生，而虑周于天下，衅孽之萌无所作矣。","book":"《隆庆元年浙江程策》"}},{"id":29694,"word":"渊清玉絜","pinyin":"yuān qīng yù jié","abbr":"yqyj","explanation":"如渊之清，如玉之洁。比喻人品高尚。","source":{"text":"渊清玉絜，有礼有法，吾敬华子鱼。","book":"《三国志·魏志·陈矫传》"},"usage":"作谓语、定语；用于书面语"},{"id":29695,"word":"渊渟岳峙","pinyin":"yuān tíng yuè zhì","abbr":"ytyz","explanation":"喻人品德如渊水深沉，如高山耸立。","source":{"text":"矫矫庄王，渊渟岳峙。","book":"晋·石崇《楚妃叹》诗"},"similar":["渊渟岳立","渊停山立"],"usage":"作谓语、定语；用于书面语"},{"id":29696,"word":"渊渟岳立","pinyin":"yuān tíng yuè lì","abbr":"ytyl","explanation":"喻人品德如渊水深沉，如高山耸立。","source":{"text":"执经衡门，渊渟岳立，宁洁身以守滞，耻胁肩以苟合。","book":"晋·葛洪《抱朴子·名实》"},"similar":["渊停山立","渊渟岳峙"],"usage":"作谓语、定语；用于书面语"},{"id":29697,"word":"渊渟泽汇","pinyin":"yuān tíng zé huì","abbr":"ytzh","explanation":"比喻事物的集聚汇合。","source":{"text":"汉兴，董贾诸人，渐趋醇朴，一代文章，垂复古始，淮南又群集浮华，纲罗淫僻，渊渟泽汇，萃为此编。","book":"明·胡应麟《少室山房笔丛·九流绪论中》"},"usage":"作宾语、定语；用于书面语"},{"id":29698,"word":"渊源有自","pinyin":"yuān yuán yǒu zì","abbr":"yyyz","explanation":"亦作“渊源有自来”。①有根据，有来源。②指有根底。","source":{"text":"锻炼无遗力，渊源有自来。","book":"宋·陆游《读宛陵先生诗》诗"},"example":{"text":"中国文字比她的朋友冯眉卿高明些。对交易所证券市场的经络，那她更是‘～’。","book":"茅盾《子夜》十一"},"similar":["渊源有自来"],"usage":"作宾语、定语；用于书面语"},{"id":29699,"word":"渊源有自来","pinyin":"yuān yuán yǒu zì lái","abbr":"yyyzl","explanation":"有根据，有来源。","source":{"text":"锻炼无遗力，渊源有自来。","book":"宋·陆游《读宛陵先生诗》诗"},"example":{"text":"至君凡四世，历百有余年，咸以医名授受，～矣。","book":"清·冯桂芬《邵步青〈医学三书〉序》"},"similar":["渊源有自"],"usage":"作宾语、定语；用于书面语"},{"id":29700,"word":"渊蜎蠖伏","pinyin":"yuān juān huò fú","abbr":"yyhf","explanation":"刻镂之形。借指华丽的宫殿。","source":{"text":"渊蜎蠖伏之中，深宫宥密之地，俯仰之间，而抚四海之外，岂其疲智虑于一人之耳目哉？","book":"明·归有光《明君恭己而成功论》"},"similar":["渊涓蠖濩"],"usage":"作宾语、定语；用于书面语"},{"id":29701,"word":"渊谋远略","pinyin":"yuān móu yuǎn lüè","abbr":"ymyl","explanation":"深谋远略。","source":{"text":"陛下渊谋远略，非臣所知。","book":"宋·曾巩《自福州召判太常寺上殿札子》：“其渊谋远略，必中事几。”宋·岳飞《奏画守襄阳等郡营田札子》"},"usage":"作宾语、定语；用于书面语"},{"id":29702,"word":"渊鱼丛爵","pinyin":"yuān yú cóng què","abbr":"yycj","explanation":"比喻为政不善，结果驱使人民投向敌方。爵，古同“雀”。","source":{"text":"故为渊驱鱼者，獭也；为丛驱爵者，鹯也；为汤武驱民者，桀与纣也。","book":"《孟子·离娄上》"},"example":{"text":"～，楚材晋用，此固在上者驱迫使然，彼为士者独不可悟商务力量之大乎？","book":"清·谭嗣同《思纬氤氲台短书·报贝元徴》"},"usage":"作谓语、宾语、定语；用于政治、交往等"},{"id":29703,"word":"渊鱼丛雀","pinyin":"yuān yú cóng què","abbr":"yycq","explanation":"把鱼赶进深潭，把雀赶到丛林。原比喻统治者施行暴政，百姓逃往别国。现也比喻把可以团结的人赶到敌方去。","source":{"text":"为渊驱鱼者，獭也。为丛驱爵者，鹯也；为汤武驱民者，桀与纣也。","book":"《孟子·离娄上》"}},{"id":29704,"word":"渎货无厌","pinyin":"dú huò wú yàn","abbr":"dhwy","explanation":"渎：贪污；厌：满足。贪污财货永无满足。","source":{"text":"晋有羊舌鲋者，渎货无厌。","book":"春秋·鲁·左丘明《左传·昭公十三年》"},"example":{"text":"我遇上一个～的家伙。"},"similar":["贪得无厌"],"usage":"作谓语、定语；指人很贪婪"},{"id":29705,"word":"渐不可长","pinyin":"jiàn bù kě zhǎng","abbr":"jbkz","explanation":"指刚露头的不好事物不能容许其发展滋长。","source":{"text":"韩玉曾任卿监，理当靖共，乃敢伏阙妄有陈诉，鼓惑众听，渐不可长，可送谭州居住。","book":"宋·周密《齐东野语·孝宗圣政》"},"example":{"text":"贪狠，～。","book":"明·刘若愚《酌中志·辽左弃地》"},"similar":["防微杜渐"],"usage":"作谓语；用于劝诫人"},{"id":29706,"word":"渐仁摩义","pinyin":"jiān rén mó yì","abbr":"jrmy","explanation":"渐：浸润；摩：磨砺。用仁义感化教育百姓。","source":{"text":"立大学以教于国，设庠序以化于邑，渐民以仁，摩民以谊，节民以礼，故其刑罚甚轻而禁不犯者，教化行而习俗美也。","book":"《汉书·董仲舒传》"}},{"id":29707,"word":"渐入佳境","pinyin":"jiàn rù jiā jìng","abbr":"jrjj","explanation":"佳：好；境：境地。原指甘蔗下端比上端甜，从上到下，越吃越甜。后比喻境况逐渐好转或兴趣逐渐浓厚。","source":{"text":"恺之每食甘遮，恒自尾至本，人或怪之。云：‘渐入佳境。’","book":"《晋书·顾恺之传》"},"example":{"text":"行过了许多亭阁，真是个～。","book":"明·吴承恩《西游记》第八十二回"},"similar":["佳境渐入","渐至佳境"],"opposite":["急转直下"],"usage":"作谓语、状语；表示向好的方面发展","story":["东晋著名画家顾恺之多才多艺，擅长人物绘画，生活上比较随便。一次朋友送一捆甘蔗给他，他正在聚精会神地欣赏风景，竟从甘蔗末梢吃起来，朋友问他感觉如何，他说渐渐甜起来，这才是甘蔗正常的吃法"]},{"id":29708,"word":"渐至佳境","pinyin":"jiàn zhì jiā jìng","abbr":"jzjj","explanation":"比喻境况逐渐好转或兴趣逐渐浓厚。同“渐入佳境”。","source":{"text":"顾长康啖甘蔗，先食尾，人问所以，云‘渐至佳境’。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"我们的日子～，越来越红火。"},"similar":["渐入佳境"],"opposite":["江河日下","每况愈下"],"usage":"作谓语、宾语；表示向好的方面发展"},{"id":29709,"word":"渑池之功","pinyin":"miǎn chí zhī gōng","abbr":"mczg","explanation":"渑池：古城名，在今河南渑池县南。本指战国时赵国蔺相如在渑池会上不畏秦王，为赵国立下功勋。后泛指为国立下巨大功勋。","source":{"text":"《史记·廉颇蔺相如列传》"}},{"id":29710,"word":"渔人之利","pinyin":"yú rén zhī lì","abbr":"yrzl","explanation":"渔人：比喻第三者。比喻双方争执不下，两败俱伤，让第三者占了便宜。","source":{"text":"蚌方出曝，而鹬啄其肉，蚌合而蘁其喙。鹬曰：‘今日不雨，明日不雨，即有死蚌。’蚌亦谓鹬曰：‘今日不出，明日不出，即有死鹬。’两者不肯相舍，渔者得而并禽之。","book":"《战国策·燕策二》"},"example":{"text":"王世充残忍褊隘之人，刻刻在那里觊觎非望，以收～。","book":"清·禇人获《隋唐演义》第五十二回"},"similar":["渔翁得利"],"usage":"作宾语；指意外收获","story":["战国时期赵国准备攻打燕国，燕王派苏代去赵国劝阻赵王，给他讲述一只河蚌在岸上晒太阳，鹬去啄它，蚌夹住鹬鸟的长嘴，双方争执不让，最后被一个渔翁轻易擒住的故事。如果燕赵发生战争，秦国就像渔翁那样吞并燕赵。赵王放弃了战争"]},{"id":29711,"word":"渔人得利","pinyin":"yú rén dé lì","abbr":"yrdl","explanation":"趁着双方争执不下而从中得到好处。","source":{"text":"两者不肯相舍，渔者得而并禽之。","book":"西汉·刘向《战国策·燕策二》"},"example":{"text":"鹬蚌相持，自己～。","book":"明·冯梦龙《醒世恒言·乔太守乱点鸳鸯谱》"},"similar":["渔翁得利"],"usage":"作谓语、宾语；指得便宜","story":["战国时期，赵国准备攻打燕国，燕王派苏代去赵国游说赵王不要战争，讲述一只河蚌在岸上夹住一只鹬鸟的长嘴，双方争执不让，最后被一个渔翁轻易擒住。如果燕赵发生战争，秦国就像渔翁那样轻易吞并燕赵。赵王只好放弃战争的打算"]},{"id":29712,"word":"渔夺侵牟","pinyin":"yú duó qīn móu","abbr":"ydqm","explanation":"渔夺：掠夺；侵牟：侵夺。指掠夺、榨取百姓财物。","source":{"text":"吏以货赂为市，渔夺百姓，侵牟万民。","book":"《汉书·景帝纪》"},"usage":"作谓语、宾语；指贪官"},{"id":29713,"word":"渔海樵山","pinyin":"yú hǎi qiáo shān","abbr":"yhqs","explanation":"入海打鱼，上山砍柴。借指隐居生活。","source":{"text":"愿君早奏升平略，鱼海樵山任所之。","book":"清·方文《留别马倩若兼订毗陵之游》诗：“渔海樵山过此生，向平儿女未忘情。”又《送旻昭御史征兵广西》诗"},"usage":"作宾语、定语；用于书面语"},{"id":29714,"word":"渔经猎史","pinyin":"yú jīng liè shǐ","abbr":"yjls","explanation":"渔、猎：涉猎。泛览群经，博涉诸史。形容博览群书，知识广博。","source":{"text":"进士王叡，渔经猎史之士也。","book":"宋·张君房《云笈七签》卷一百十二"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":29715,"word":"渔翁之利","pinyin":"yú wēng zhī lì","abbr":"ywzl","explanation":"犹言渔人之利。","source":{"text":"甲午为日本侵我东三省，俄、德出为调停，借收渔翁之利，大局又为之一变。","book":"清·刘鹗《老残游记》第十一回"},"example":{"text":"茅盾《虹》：“上海人所崇拜的就是利，而且是不用自己费力的～。”"},"similar":["渔人之利"],"usage":"作宾语；指意外收获"},{"id":29716,"word":"渔翁得利","pinyin":"yú wēng dé lì","abbr":"ywdl","explanation":"渔翁：比喻第三者。比喻双方争执不下，两败俱伤，让第三者占了便宜。","source":{"text":"蚌方出曝，而鹬啄其肉，蚌合而蘁其喙。鹬曰：‘今日不雨，明日不雨，即有死蚌。’蚌亦谓鹬曰：‘今日不出，明日不出，即有死鹬。’两者不肯相舍，渔者得而并禽之。","book":"《战国策·燕策二》"},"example":{"text":"郭沫若《屈原》第五幕：“后来他又骂他愚弄国王，愚弄南后，想离间齐国和楚国的邦交，好让秦国来～。”"},"similar":["渔人得利"],"usage":"作谓语、宾语、定语；指得便宜"},{"id":29717,"word":"渔阳鞞鼓","pinyin":"yǔ yáng pí gǔ","abbr":"yypg","explanation":"指公元755年安禄山于渔阳举兵叛唐事。鞞鼓，骑兵用的小鼓。后亦用为外族侵略之典。","source":{"text":"渔阳鞞鼓动地来，惊破《霓裳羽衣曲》。","book":"唐·白居易《长恨歌》"},"similar":["渔阳鼙鼓"],"usage":"作宾语、定语；指发生战事"},{"id":29718,"word":"渔阳鼙鼓","pinyin":"yǔ yáng pí gǔ","abbr":"yypg","explanation":"渔阳：地名，现河北省蓟县，唐时安禄山驻军在此；鼙鼓：古代军中用的小鼓。渔阳郡响起了战鼓。指有战事发生。","source":{"text":"渔阳鼙鼓动地来，惊破霓裳羽衣曲。","book":"唐·白居易《长恨歌》"},"example":{"text":"一朝渔阳动鼙鼓，大河以北无坚城。","book":"宋·文天祥《过平原作》诗"},"similar":["渔阳鞞鼓"],"usage":"作宾语、定语；指发生战事"},{"id":29719,"word":"渟膏湛碧","pinyin":"tíng gāo zhàn bì","abbr":"tgzb","explanation":"渟：积水；膏：油脂；湛：深色；碧：青绿。形容水清如膏，颜色碧绿。","source":{"text":"潭在山半深谷中，渟膏湛碧，莹洁如玉。","book":"明·文征明《玉女潭山居记》"}},{"id":29720,"word":"渡江亡楫","pinyin":"dù jiāng wú jí","abbr":"djwj","explanation":"亡：同“无”；楫：船桨。过江时船上没有桨。比喻没有准备，没有必要的凭借。","source":{"text":"若夫经制不定，是犹度江河亡维楫，中流而遇风波，船必覆矣。","book":"《汉书·贾谊传》"}},{"id":29721,"word":"渡河香象","pinyin":"dù hé xiāng xiàng","abbr":"dhxx","explanation":"渡：横渡江河。大象过河，脚踏河底。形容评论文字精辟透彻。","source":{"text":"如恒河水。三兽俱渡，兔、马、香象。兔不能至底，浮水而过；马或至底或不至底，象则尽底。","book":"《优婆塞戒经》第一卷"},"similar":["香象渡河"],"usage":"作宾语、定语；指评论文章等"},{"id":29722,"word":"渣滓浊沫","pinyin":"zhā zǐ zhuó mò","abbr":"zzzm","explanation":"渣滓：物品提炼后的废物；浊沫：混浊的泡沫。指无用之物。","source":{"text":"男儿们不过是些渣滓浊沫而已。","book":"清·曹雪芹《红楼梦》第20回"},"similar":["残渣余孽"],"usage":"作主语、宾语、定语；指无用之物"},{"id":29723,"word":"渤澥桑田","pinyin":"bó xiè sāng tián","abbr":"bxst","explanation":"渤澥，渤海的古称。大海变成桑田，桑田变成大海。犹沧海桑田。比喻世事变化巨大。","source":{"text":"不惊渤澥桑田变，来看龟蒙漏泽春。","book":"宋·苏轼《送乔仝寄贺君》诗之二"},"similar":["沧海桑田"],"usage":"作宾语；比喻世事变化巨大"},{"id":29724,"word":"温凊定省","pinyin":"wēn qǐng dìng shěng","abbr":"wqdx","explanation":"冬温夏凊、昏定晨省的省称。谓冬天温被，夏天扇席，晚上侍候睡定，早晨前往请安。表示侍奉父母无微不至。","source":{"text":"凡为人子之礼，冬温而夏凊，昏定而晨省。","book":"语出《礼记·曲礼上》"},"example":{"text":"蜀《孟熙》：“贩果实养父母，承颜顺旨，～，出告反面，不惮苦辛。”"},"usage":"作宾语、定语；用于侍奉父母"},{"id":29725,"word":"温席扇枕","pinyin":"wēn xí shān zhěn","abbr":"wxsz","explanation":"指侍奉父母无微不至。同“温枕扇席”。","source":{"text":"子之承亲，温席扇枕；子之友悌，同舆共寝。","book":"唐·杨炯《从弟去盈墓志铭》"},"similar":["温枕扇席"],"usage":"作宾语、定语；用于侍奉父母"},{"id":29726,"word":"温恭直谅","pinyin":"wēn gōng zhí liàng","abbr":"wgzl","explanation":"温恭：温和谦恭；直谅：性格正直，能谅解人。指和气、谦恭、正直、诚信的高尚品德。","source":{"text":"但愿温恭直谅之友，来此讲学论道，示以孝友谦和之行，德业相劝，过失相规，以教训我子弟，使无陷于非僻。","book":"明·王阳明《客坐私祝》"}},{"id":29727,"word":"温恭自虚","pinyin":"wēn gōng zì xū","abbr":"wgzx","explanation":"温恭：温和谦恭；虚：虚心。温顺谦恭而不自满。形容诚恳受教的好态度。","source":{"text":"先生施教，弟子是则，温恭自虚，所受是极。","book":"《管子·弟子职》"}},{"id":29728,"word":"温情密意","pinyin":"wēn qíng mì yì","abbr":"wqmy","explanation":"指情意温柔亲密。","source":{"text":"然而散见零星的翠色，好一似美人的眉飞色舞，已确然见温情密意的‘春之和畅’之先声。","book":"瞿秋白《饿乡纪程》"},"similar":["温情蜜意"],"usage":"作宾语、定语；用于处事"},{"id":29729,"word":"温情脉脉","pinyin":"wēn qíng mò mò","abbr":"wqmm","explanation":"脉脉：默默地用眼神或行动表达情意。形容饱含温和的感情，很想表露出来的样子。","source":{"text":"千金曾买相如赋，脉脉此情谁诉。","book":"宋·辛弃疾《摸鱼儿》词"},"example":{"text":"总之，资本主义制度把无数家庭的～的气氛都给败坏了。","book":"秦牧《衰老》"},"similar":["含情脉脉","柔情脉脉"],"opposite":["冷若冰霜"],"usage":"作定语、状语；带讽刺意味","story":["宋朝时期，湖北转运副使辛弃疾调任湖南转运副使时，接任的王正之备酒为他送行，他无限感慨地作词《摸鱼儿》：“长门事，准拟佳期又误，蛾眉曾有人妒。千金纵买相如赋，脉脉此情难诉？君莫舞。君不见，玉环飞燕皆尘土。”"]},{"id":29730,"word":"温情蜜意","pinyin":"wēn qíng mì yì","abbr":"wqmy","explanation":"指情意温柔亲密。同“温情密意”。","source":{"text":"一个男人家，做什么婆婆妈妈的，做出些温情蜜意，也不怕难为情？","book":"杨朔《三千里江山》"},"similar":["温情密意"],"usage":"作宾语、定语；用于处事"},{"id":29731,"word":"温故知新","pinyin":"wēn gù zhī xīn","abbr":"wgzx","explanation":"温：温习；故：旧的。温习旧的知识，得到新的理解和体会。也指回忆过去，能更好地认识现在。","source":{"text":"温故知新已难，而知德者鲜矣。","book":"《论语·为政》：“温故而知新，可以为师矣。”汉·班固《东都赋》"},"example":{"text":"～是学习上的重要方法。"},"similar":["忆苦思甜"],"opposite":["数典忘祖"],"usage":"作谓语、定语；用于学习、工作或其他","story":["春秋时期，孔子在教学上有丰富的经验，常常与学生们一道研讨问题，给学生解决各种疑难问题，他鼓励学生培养很好的品德，深入钻研，提出“学而时习之，温故而知新”，学生赞扬孔子教学的耐心，孔子谦逊地说：“学而不厌，诲人不倦。”"]},{"id":29732,"word":"温文儒雅","pinyin":"wēn wén rú yǎ","abbr":"wwry","explanation":"态度温和，举止文雅。","source":{"text":"为首的是个半老的儒者气象……次后便是一个温文儒雅的白面书生。","book":"清·文康《儿女英雄传》缘起首回"},"example":{"text":"从他的相貌、神气和言谈、举止看，也很～，不带一点儿草莽英雄模样。","book":"姚雪垠《李自成》第一卷第二十四章"},"similar":["温文尔雅"],"usage":"作谓语、定语、状语；指人态度温和"},{"id":29733,"word":"温文尔雅","pinyin":"wēn wén ěr yǎ","abbr":"wwey","explanation":"温文：态度温和，有礼貌；尔雅：文雅。形容人态度温和，举动斯文。现有时也指缺乏斗争性，做事不大胆泼辣，没有闯劲。","source":{"text":"此名士之子，温文尔雅，乌能作贼？","book":"清·蒲松龄《聊斋志异·陈锡九》"},"example":{"text":"～，正是学者的态度。","book":"叶圣陶《演讲》"},"similar":["温良恭俭","文质彬彬","彬彬有礼"],"opposite":["凶神恶煞","暴跳如雷"],"usage":"作谓语、定语、状语；指人态度温和"},{"id":29734,"word":"温枕扇席","pinyin":"wēn zhěn shān xí","abbr":"wzsx","explanation":"指侍奉父母无微不至。","source":{"text":"每跪读家书，前惧后喜，温枕扇席，无复成童。","book":"《陈书·沈炯传》"},"similar":["温席扇枕"],"usage":"作宾语、定语；用于侍奉父母"},{"id":29735,"word":"温柔乡","pinyin":"wēn róu xiāng","abbr":"wrx","explanation":"比喻女色迷人之所。","source":{"text":"是夜进合德，帝大悦，以辅属体，无所不靡，谓为温柔乡。","book":"汉·伶玄《飞燕外传》"},"example":{"text":"清·韩邦庆《海上花列传》第一回：“乃流寓于众香国之～，而自号花也怜侬云。”"},"usage":"作宾语、定语；用于比喻句"},{"id":29736,"word":"温柔体贴","pinyin":"wēn róu tǐ tiē","abbr":"wrtt","explanation":"温顺关怀体贴。","source":{"text":"袭人才将心事说出，蒋玉菡也深为叹息敬服，不敢勉强，并越发温柔体贴，弄得个袭人真无死所了。","book":"清·曹雪芹《红楼梦》第120回"},"similar":["温顺体贴"],"usage":"作谓语、定语；多用于女性"},{"id":29737,"word":"温柔敦厚","pinyin":"wēn róu dūn hòu","abbr":"wrdh","explanation":"温柔：温和柔顺；敦厚：厚道。原指态度温和，朴实厚道。后也泛指待人温和宽厚。","source":{"text":"温柔敦厚，《诗》教也。","book":"《礼记·经解》"},"example":{"text":"依孔子的见解，诗的灵魂是要“～”的。","book":"闻一多《诗人的横蛮》"},"similar":["温文尔雅","温情脉脉"],"opposite":["尖酸刻薄","出言不逊"],"usage":"作谓语、定语；指人态度温和"},{"id":29738,"word":"温润而泽","pinyin":"wēn rùn ér zé","abbr":"wrez","explanation":"比喻人的态度、言语温和柔顺。","source":{"text":"昔者君子比德于玉焉，温润而泽，仁也。","book":"《礼记·聘义》"},"usage":"作谓语、定语；用于处事"},{"id":29739,"word":"温清定省","pinyin":"wēn qīng dìng xǐng","abbr":"wqds","explanation":"冬天使被子温暖，夏日让室内清凉，晚间给父母安睡，早晨起来问候安好。形容对父母尽心侍奉。","source":{"text":"凡为人子之礼，冬温而夏清，昏定而晨省。","book":"《礼记·曲礼上》"},"example":{"text":"贩果实养父母，承颜顺旨，～，出告反面，不惮苦辛。","book":"《太平御览》卷一百六十二引《儆诫录》"}},{"id":29740,"word":"温生绝裾","pinyin":"wēn shēng jué jū","abbr":"wsjj","explanation":"后用为去意坚决的典故。","source":{"text":"温公初受，刘司空使劝进，母崔氏固驻之，峤绝裾而去。","book":"南朝·宋·刘义庆《世说新语·尤悔》"},"example":{"text":"清·虞名《指南公·举义》：“悲～不犹，渐莱子承欢弗久。”"},"usage":"作宾语、定语；用于处事"},{"id":29741,"word":"温良俭让","pinyin":"wēn liáng jiǎn ràng","abbr":"wljr","explanation":"温：温和；良：善良；俭：节制；让：忍让。儒家提倡待人接物的准则，泛指态度谦恭，举止文雅。","source":{"text":"夫子温良恭俭让以得之。夫子之求之也，其诸异乎人之求之与？","book":"春秋·鲁·孔丘《论语·学而》"},"example":{"text":"张端甫，我见你一贫如洗，教你做门馆先生，你则合～。","book":"明·无名氏《女姑姑》第四折"},"similar":["温良恭俭让","温良恭俭"],"usage":"作谓语、定语、宾语；形容态度温和","story":["春秋时期，子禹问孔子的学生子贡为什么孔子每到一个国家都能听到该国的政事。子贡回答他老人家温和、善良、恭敬、俭朴、谦让，他用这样的态度去对待别人。别人自然会把政事告诉他，这是他与众不同的品德"]},{"id":29742,"word":"温良忍让","pinyin":"wēn liáng rěn ràng","abbr":"wlrr","explanation":"听他人意志的摆布、忍让、屈从。","source":{"text":"一向温良忍让的母亲，愤愤地说：‘受苦的日子过去了，我们也没有什么使用价值了。’","book":"章诒和《往事并不如烟·斯人寂寞》"},"example":{"text":"你不要因为他～就欺负他。"},"similar":["温良俭让"],"usage":"作谓语、定语；指态度谦虚"},{"id":29743,"word":"温良恭俭","pinyin":"wēn liáng gōng jiǎn","abbr":"wlgj","explanation":"原意为温和、善良、恭敬、节俭等美德。这原是儒家提倡待人接物的准则。现也形容态度温和而缺乏斗争性。","source":{"text":"夫子温良恭俭让以得之。","book":"《论语·学而》"},"example":{"text":"冯翊郡开国公鱼朝恩，～，宽柔简廉，长才博达，敏识高妙。","book":"《旧唐书·礼仪志四》"},"similar":["温良恭俭让","温良俭让"],"usage":"作谓语、定语、宾语；形容态度温和","story":["春秋时期，子禹问孔子的学生子贡为什么孔子每到一个国家都能听到该国的政事。子贡回答他老人家温和、善良、恭敬、俭朴、谦让，他用这样的态度去对待别人。别人自然会把政事告诉他，这是他与众不同的品德"]},{"id":29744,"word":"温良恭俭让","pinyin":"wēn liáng gōng jiǎn ràng","abbr":"wlgjr","explanation":"原意为温和、善良、恭敬、节俭、忍让这五种美德。这原是儒家提倡待人接物的准则。现也形容态度温和而缺乏斗争性。","source":{"text":"夫子温良恭俭让以得之。夫子之求之也，其诸异乎人之求之与？","book":"春秋·鲁·孔丘《论语·学而》"},"example":{"text":"物有本来，事有终始，以～之德，五者乃圣德光辉。","book":"明·无名氏《孟母三移》第二折"},"similar":["温良俭让","温良恭俭"],"usage":"作谓语、定语、宾语；形容态度温和","story":["春秋时期，子禹问孔子的学生子贡为什么孔子每到一个国家都能听到该国的政事。子贡回答他老人家温和、善良、恭敬、俭朴、谦让，他用这样的态度去对待别人。别人自然会把政事告诉他，这是他与众不同的品德"]},{"id":29745,"word":"温衾扇枕","pinyin":"wēn qīn shān zhěn","abbr":"wqsz","explanation":"指侍奉父母无微不至。同“温枕扇席”。","source":{"text":"亲年迈，且自温衾扇枕，随分度朝昏。","book":"元·柯丹邱《荆钗记·会讲》"},"similar":["扇枕温衾","温枕扇席"],"usage":"作谓语、定语；用于处事"},{"id":29746,"word":"温香艳玉","pinyin":"wēn xiāng yàn yù","abbr":"wxyy","explanation":"比喻妇女的美好姿质。","source":{"text":"看他温香艳玉神清绝，人间迥别。","book":"明·汤显祖《牡丹亭·冥誓》"},"example":{"text":"清·洪昇《长生殿·埋玉》：“～须臾化，今世今生怎见他！”"},"usage":"作宾语、定语；多用于女性"},{"id":29747,"word":"温香软玉","pinyin":"wēn xiāng ruǎn yù","abbr":"wxry","explanation":"温：温和；软：柔和；香、玉：女子的代称。旧小说形容女子的身体。","source":{"text":"软玉温香，休道是相亲旁若能够汤他一汤，倒与人消灾障。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"可怜嫩蕊新花，拍残狂蝶；却恨～，抛掷终风。","book":"明·冯梦龙《醒世恒言》卷三十九"}},{"id":29748,"word":"渭川千亩","pinyin":"wèi chuān qiān mǔ","abbr":"wcqm","explanation":"用以言竹之繁茂。","source":{"text":"齐鲁千亩桑麻；渭川千亩竹……此其人皆与千户侯等。","book":"《史记·货殖列传》"},"example":{"text":"～，淇泉菉竹，西北且然，况潇湘、云梦之间，洞庭、青草之外；何在非水，何在非竹也！","book":"清郑燮《为马秋玉画扇》"},"usage":"作宾语、定语；用于书面语"},{"id":29749,"word":"渭浊泾清","pinyin":"wèi zhuó jīng qīng","abbr":"wzjq","explanation":"泾水清，渭水浊。用以比喻事物和人品的差别。","source":{"text":"沈砺《咏史》；“渭浊泾清本异流，当涂符谶趁时收。”"},"similar":["泾渭分明"],"usage":"作宾语、定语；用于比喻句"},{"id":29750,"word":"渭阳之思","pinyin":"wèi yáng zhī sī","abbr":"wyzs","explanation":"指甥舅间的思念、怀旧之情。","source":{"text":"舅氏失道，宗族陨坠，渭阳之思，孔怀感伤。","book":"《晋书·杨骏传》"},"example":{"text":"甲父母在，出学三年而归，舅氏问其学何得，并序别父久。乃答曰：“～，过于秦康。”","book":"宋·李昉《太平广记》卷二百六十二"},"similar":["渭阳之情"],"usage":"作宾语；指甥舅情谊"},{"id":29751,"word":"渭阳之情","pinyin":"wèi yáng zhī qíng","abbr":"wyzq","explanation":"渭阳：渭水的北边。传说秦康公送其舅重耳返晋，直到渭水之北。指甥舅间的情谊。","source":{"text":"其令许侯思愆田庐，有司勿复请，以慰朕渭阳之情。","book":"《诗经·秦风·渭阳》：“我送舅氏，曰至渭阳。”《后汉书·马援传》"},"example":{"text":"舅又曲垂顾念，恩其庭闱，～，实多荷戴。","book":"唐·陈子昂《为苏令本与岑内史书》"},"similar":["渭阳之思"],"usage":"作宾语；指甥舅情谊"},{"id":29752,"word":"渲染烘托","pinyin":"xuàn rǎn hōng tuō","abbr":"xrht","explanation":"渲染：国画的一种画法；烘托：国画的画法，用衬托手法使事物鲜明。指用衬托和夸张的艺术手法，突出主题。","example":{"text":"他喜欢运用～的手法作画。"},"similar":["烘托渲染"],"usage":"作谓语、定语；指使用夸张的手法造势"},{"id":29753,"word":"渴尘万斛","pinyin":"kě chén wàn hú","abbr":"kcwh","explanation":"形容十分想念。","source":{"text":"三入寺，曦未来，辘轳无人井百尺，渴心归去生尘埃。","book":"唐·卢仝《访含曦上人》"},"example":{"text":"一日三秋，言思暮之甚切；～，言想望之久殷。","book":"清·程允升《幼学琼林·身体》"}},{"id":29754,"word":"渴心生尘","pinyin":"kě xīn shēng chén","abbr":"kxsc","explanation":"渴：迫切。形容非常想念。","source":{"text":"三入寺，曦未来，辘轳无人井百尺，渴心归去生尘埃。","book":"唐·卢仝《访含曦上人》"},"example":{"text":"多时不见吾妹，渴心生尘，今何自至？","book":"明·余邵鱼《周朝秘史》第一○五回"}},{"id":29755,"word":"渴者易饮","pinyin":"kě zhě yì yǐn","abbr":"kzyy","explanation":"口渴的人喝什么都觉得甘甜。旧时比喻久经苛政而最知对德政感恩。","source":{"text":"饥者易为食，渴者易为饮。","book":"《孟子·公孙丑上》"},"usage":"作宾语、定语；用于比喻句"},{"id":29756,"word":"渴而掘井","pinyin":"kě ér jué jǐng","abbr":"kejj","explanation":"到口渴才掘井。比喻事先没有准备，临时才想办法。","source":{"text":"夫病已成而后药之，乱已成而后治之，譬犹渴而穿井，斗而铸锥，不亦晚乎！","book":"《素问·四气调神大论》"},"similar":["临渴掘井","渴而穿井"],"usage":"作谓语、定语；指办事没计划"},{"id":29757,"word":"渴而穿井","pinyin":"kě ér chuān jǐng","abbr":"kecj","explanation":"比喻事先没准备，临时才想办法。","source":{"text":"夫病已成而后药之，乱已成而后治之，譬渴而穿井，斗而铸锥，不亦晚乎！","book":"《素问·四气调神大论》"},"example":{"text":"寡人所谓饥而求黍稷，～者，未尝能以欢喜见子。","book":"西汉·刘向《说苑·奉使》"},"similar":["临渴掘井"],"usage":"作谓语、定语；指办事没计划"},{"id":29758,"word":"渴骥奔泉","pinyin":"kě jì bēn quán","abbr":"kjbq","explanation":"骥：骏马。如同骏马口渴思饮，飞快奔赴甘泉一般。形容书法笔势矫健。也比喻迫切的欲望。","source":{"text":"尝书四十二，幅屏，八体皆备，草隶尤工，世状其法曰：‘怒猊抉石，渴骥奔泉。’","book":"《新唐书·徐浩传》"},"example":{"text":"廪生伺于门，表妹乘车至，彼此如～，入户稍寒温，即携手至柴室狎亵。","book":"清·采蘅子《虫鸣漫录》"},"similar":["怒猊抉石"],"usage":"作宾语、定语；比喻迫切的样子","story":["唐朝时期，中书舍人徐浩深得唐肃宗的信任，专门为朝廷起草重要文件，他才思敏捷，字写得好。他向肃宗提出许多建议得到采纳，被任命为国子祭酒。他对书法很有研究，精于楷法，写字圆劲厚重，自成一家，如渴骥奔泉"]},{"id":29759,"word":"渴骥怒猊","pinyin":"kě jì nù ní","abbr":"kjnn","explanation":"骥：骏马；猊：狻猊，即狮子。口渴的骏马奔向泉水，如愤怒的狮子撬扒石头。形容书法遒劲奔放。","source":{"text":"始，浩父峤之善书，以法授浩，益工。尝书四十二幅屏，八体皆备，草隶尤工，世状其法曰‘怒猊抉石，渴骥奔泉。’","book":"《新唐书·徐浩传》"},"similar":["怒猊抉石，渴骥奔泉"],"usage":"作宾语、定语；用于比喻句"},{"id":29760,"word":"渴鹿奔泉","pinyin":"kě lù bēn quán","abbr":"klbq","explanation":"如同鹿口渴思饮，飞快奔赴甘泉一般。形容书法笔势矫健。也比喻迫切的欲望。","source":{"text":"尝书四十二，幅屏，八体皆备，草隶尤工，世状其法曰：‘怒猊抉石，渴骥奔泉。’","book":"《新唐书·徐浩传》"},"example":{"text":"习久，渐惯苦读，古人微意，或有一二悟解处，辄叫号跳跃，如渴鹿之奔泉也。","book":"明·袁宏道《瓶花斋集》"}},{"id":29761,"word":"游丝飞絮","pinyin":"yóu sī fēi xù","abbr":"ysfx","explanation":"游动的蛛丝，飘盈的柳絮。比喻不由自主，随风而倒的轻浮之人。","source":{"text":"恩情占断人间丽，莫认做游丝飞絮，看万岁千秋鸾凤仪。","book":"明·胡文焕《群音类选·惊鸿记·七夕私盟》"},"usage":"作宾语、定语；用于比喻句"},{"id":29762,"word":"游云惊龙","pinyin":"yóu yún jīng lóng","abbr":"yyjl","explanation":"形容书法精妙。","source":{"text":"论者称其笔势，以为飘若游云，矫若惊龙。","book":"《晋书·王羲之传》"},"usage":"作主语、宾语、定语；形容人的书法"},{"id":29763,"word":"游侠骑士","pinyin":"yóu xiá qí shì","abbr":"yxqs","explanation":"漫无目的浪游四方，寻求冒险以显示武功、勇敢、宽仁侠义的人。","example":{"text":"武侠小说中少不了～。"},"usage":"作主语、定语、宾语；用于书面语"},{"id":29764,"word":"游光扬声","pinyin":"yóu guāng yáng shēng","abbr":"ygys","explanation":"流传荣誉，播扬名声。","source":{"text":"列郡之中，亦有弓旌贲及，著作繁富，游光扬声，倾动海内者矣。","book":"清·钱谦益《吴中名贤表扬续议》"},"usage":"作谓语、定语；用于书面语"},{"id":29765,"word":"游刃余地","pinyin":"yóu rèn yú dì","abbr":"yryd","explanation":"犹游刃有余。比喻做事熟练，轻而易举。","source":{"text":"出新意于法度之中，寄妙理于豪放之外，所谓游刃余地，运斤成风，盖古今一人而已。","book":"宋·苏轼《书吴道子画后》"},"example":{"text":"主权既定，且将竞人而非可竞于人矣。于是～，仅有南亚美利加、亚非利加、亚细亚之三土。","book":"梁启超《论民族竞争之大势》"},"similar":["游刃有余"],"usage":"作谓语、宾语、状语；指十分老练"},{"id":29766,"word":"游刃恢恢","pinyin":"yóu rèn huī huī","abbr":"yrhh","explanation":"游刃：自由地运转刀刃；恢恢：宽阔广大的样子。比喻技术熟练，操作轻松。","source":{"text":"彼节者有间，而刀刃者无厚。以无厚入有间，恢恢乎其于游刃必有余地矣。","book":"《庄子·养生主》"},"example":{"text":"境内翕然称治，～，所向辄解。","book":"宋·王之道《相山集·无为集序》"}},{"id":29767,"word":"游刃有余","pinyin":"yóu rèn yǒu yú","abbr":"yryy","explanation":"刀刃运转于骨节空隙中，在有回旋的余地。比喻工作熟练，有实际经验，解决问题毫不费事。","source":{"text":"彼节者有间，而刀刃者无厚。以无厚入有间，恢恢乎其于游刃必有余地矣。","book":"语出《庄子·养生主》"},"example":{"text":"从前他们又要办厂，又要做公债，也居然稳渡了两次险恶的风波，现在他们全力来做公债，自然觉得～。","book":"茅盾《子夜》十七"},"similar":["挥洒自如","滚瓜烂熟","炉火纯青"],"opposite":["捉襟见肘","一筹莫展","笨手笨脚"],"usage":"作谓语、宾语；指十分老练","story":["战国时期道家代表庄周讲一个故事：有个厨师替梁惠王宰牛，他的宰牛技术十分娴熟，刀子在牛骨缝里灵活地移动，没有一点障碍，而且很有节奏。梁惠王看呆了，一个劲夸他技术高超。厨师说他解牛已经19年了，对牛的结构完全了解"]},{"id":29768,"word":"游刃有余地","pinyin":"yóu rèn yǒu yú dì","abbr":"yryyd","explanation":"刀刃运转于骨节空隙中，在有回旋的余地。比喻工作熟练，有实际经验，解决问题毫不费事。","source":{"text":"彼节者有间，而刀刃者无厚。以无厚入有间，恢恢乎其于游刃必有余地矣。","book":"《庄子·养生主》"},"example":{"text":"谁言～，自信无功可补天。","book":"宋·黄庭坚《次韵寄上七兄》"}},{"id":29769,"word":"游刃皆虚","pinyin":"yóu rèn jiē xū","abbr":"yrjx","explanation":"游刃：转动的刀锋；虚：空。刀锋所到之处都是空隙。形容技艺高超，运用熟练。","source":{"text":"范容期见郗超俗情不淡，戏之曰：‘夷、齐、巢、许一诣垂名。何必劳神苦形，支策据梧邪？’郗未答，韩康伯曰：‘何不使游刃皆虚？’","book":"南朝·宋·刘义庆《世说新语·排调》"}},{"id":29770,"word":"游响停云","pinyin":"yóu xiǎng tíng yún","abbr":"yxty","explanation":"形容响亮的歌声，高入云霄，能使流云受阻而停下来。","source":{"text":"抚节悲歌，声振林木，响遏行云。","book":"战国·郑·列御寇《列子·汤问》"},"example":{"text":"真个是遗声振木，～。","book":"明·汪廷讷《广陵月》第四出"},"similar":["响彻云霄"],"usage":"作谓语、定语；指声音","story":["战国时期秦国歌手薛潭向歌唱家秦青拜师学艺，经过刻苦学习，薛潭的技艺有了很大的提高，就向老师辞行。秦青在郊外设宴送行，席间唱了一曲十分悲壮的歌曲，声振林木，游响停云，薛潭觉得十分惭愧，于是留下继续学习"]},{"id":29771,"word":"游回磨转","pinyin":"yóu huí mó zhuǎn","abbr":"yhmz","explanation":"犹言团团转。形容不知道怎么办好。","source":{"text":"玳安来家，到处寻书童儿，那里得来，急的只游回磨转。","book":"《金瓶梅词话》第五十一回"},"usage":"作状语；用于书面语"},{"id":29772,"word":"游尘土梗","pinyin":"yóu chén tǔ gěng","abbr":"yctg","explanation":"游尘：四处漂浮的尘土；土梗：指泥制的小人。比喻琐碎或轻贱的事物。","source":{"text":"视若游尘，遇同土梗。","book":"南朝·梁·刘峻《广绝交论》"}},{"id":29773,"word":"游居有常","pinyin":"yóu jū yǒu cháng","abbr":"yjyc","explanation":"常：正常，常规。外出或家居都要遵守常规。","source":{"text":"志毋虚邪，行必正直，游居有常，必就有德。","book":"《管子·弟子职》"}},{"id":29774,"word":"游山玩景","pinyin":"yóu shān wán jǐng","abbr":"yswj","explanation":"游览、玩赏山水景物。同“游山玩水”。","source":{"text":"虽也上过学，不过略识几字，终日惟有斗鸡走马，游山玩景而已。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"一转身，他看见梁建和张孔在半山坡闲暇无事～似的指手划脚，心里的火气更盛了。","book":"杜鹏程《在和平的日子里》第六章"},"similar":["游山玩水"],"usage":"作谓语、宾语、定语；指旅游"},{"id":29775,"word":"游山玩水","pinyin":"yóu shān wán shuǐ","abbr":"ysws","explanation":"游览、玩赏山水景物。","source":{"text":"问：‘如何是学人自己？’师曰：‘游山玩水去。’","book":"宋·释道原《景德传灯录》卷十九"},"example":{"text":"每与源～，吊古寻幽，赏月吟风，怡情遣兴，诗赋文词，山川殆遍。","book":"明·冯梦龙《喻世明言》卷三十"},"similar":["观山玩水","游山逛水"],"usage":"作谓语、宾语；指旅游"},{"id":29776,"word":"游山逛水","pinyin":"yóu shān guàng shuǐ","abbr":"ysgs","explanation":"山、水：指风景；逛：闲游。游览、玩赏山水景物","source":{"text":"平生最喜游山逛水。","book":"宗璞《西湖漫笔》"},"similar":["游山玩水"],"usage":"作谓语、宾语；指旅游"},{"id":29777,"word":"游心寓目","pinyin":"yóu xīn yù mù","abbr":"yxym","explanation":"指留心观看。","source":{"text":"由是言之，六经者，先王之遗烈，圣人之盛事也，安可不游心寓目习性文身哉！","book":"《晋书·干宝传》：“幸将来好事之士录其根体，有以游心寓目而无尤焉。”《北史·常爽传》"},"example":{"text":"《北史·常爽传》：“由是言之，六经者，先王之遗烈，圣人之盛事也，安可不～习性文身哉！”"},"usage":"作谓语、定语；用于书面语"},{"id":29778,"word":"游心骇耳","pinyin":"yóu xīn hài ěr","abbr":"yxhe","explanation":"发人遐想，动人听闻。","source":{"text":"可以览观扬意，以示后世好事者读之，以游心骇耳，以附益上方太史公之三章。","book":"《史记·滑稽列传褚少孙论》"},"example":{"text":"文史外无遗自娱，乃广采～之事，妄言妄听，记而存之，非有所惑也。","book":"清·袁枚《〈新齐谐〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":29779,"word":"游心骋目","pinyin":"yóu xīn chěng mù","abbr":"yxcm","explanation":"纵情品览，极目远眺。","source":{"text":"于宇宙之中，游心骋目，此娱信可乐只。","book":"宋·吴潜《哨遍·括兰亭记》词"},"similar":["游目骋怀"],"usage":"作谓语、定语；用于书面语"},{"id":29780,"word":"游必有方","pinyin":"yōu bì yǒu fāng","abbr":"ybyf","explanation":"要是出游，必须要告辞去处。","source":{"text":"父母在，不远游，游必有方。","book":"春秋·鲁·孔丘《论语·里仁》"},"example":{"text":"即语称～，不过稽远近，计岁月，往返如期。","book":"明·徐宏祖《徐霞客游记·续编》"},"usage":"作谓语、宾语、定语；指让父母安心"},{"id":29781,"word":"游思妄想","pinyin":"yóu sī wàng xiǎng","abbr":"yswx","explanation":"犹言胡思乱想。指没有根据，不切实际的瞎想。","source":{"text":"翰林当下别了老尼，到静室中。游思妄想，过了一夜。","book":"明·凌濛初《二刻拍案惊奇》卷三"},"example":{"text":"～者取首级；心志不猛者取首级；争斗尚气者取首级！","book":"明·董说《西游补》第十五回"},"similar":["胡思乱想"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":29782,"word":"游戏三昧","pinyin":"yóu xì sān mèi","abbr":"yxsm","explanation":"原为佛家语，意思是排除杂念，使心神平静。也比喻事物的精义、决窍。后指用游戏的态度对待一切。","source":{"text":"扣大寂之室，顿然忘筌，得游戏三昧。","book":"宋·释道原《景德传灯灵》卷八"},"example":{"text":"凡为小说及杂剧戏文，须是虚实相伴，方为～之笔，亦要情景造极而止，不必问其有无也。","book":"鲁迅《小说旧闻钞·杂说》"},"usage":"作谓语；指游戏"},{"id":29783,"word":"游戏人世","pinyin":"yóu xì rén shì","abbr":"yxrs","explanation":"指把人生当作游戏的一种生活态度。同“游戏人间”。"},{"id":29784,"word":"游戏人间","pinyin":"yóu xì rén jiān","abbr":"yxrj","explanation":"原指人还活在世上。指把人生当作游戏的一种生活态度。","source":{"text":"世传端明（即苏轼）已归道山，今尚尔游戏人间邪？","book":"明·何良俊《世说新语补·排调下》"},"example":{"text":"诗此篇者，镜涵其果非狂也，根器深远矣。～，撒手一哭，悲夫。","book":"清·梁启超《饮冰室诗话》"},"similar":["游戏尘寰"],"usage":"作谓语、宾语；指生活态度"},{"id":29785,"word":"游戏尘寰","pinyin":"yóu xì chén huán","abbr":"yxch","explanation":"犹言游戏人间。指把人生当作游戏的一种生活态度。","source":{"text":"缑山老仙，翳凤骖鸾，游戏尘寰。","book":"元·周权《沁园春六首》词之一"},"example":{"text":"余雄服～，物色奇士，殊无知我者。","book":"清·程麟《此中人语·广寒宫扫花女》"},"similar":["游戏人间"],"usage":"作谓语、宾语；指生活态度"},{"id":29786,"word":"游戏笔墨","pinyin":"yóu xì bǐ mò","abbr":"yxbm","explanation":"指以游戏态度所写的诗文。","source":{"text":"果然是敷衍荒唐！不但作者不知，抄者不知，并阅者也不知。不过游戏笔墨，陶情适性而已！","book":"清·曹雪芹《红楼梦》第一百二十回"},"example":{"text":"黄龙子道：‘尽信《书》，则不如无《书》。此鄙人之～耳。公直当《桃花源记》读可矣。’","book":"清·刘鹗《老残游记》第九回"},"similar":["游戏翰墨"],"usage":"作谓语、宾语、定语；用于作文等"},{"id":29787,"word":"游戏翰墨","pinyin":"yóu xì hàn mò","abbr":"yxhm","explanation":"指以游戏态度所写的诗文。同“游戏笔墨”。","source":{"text":"近世士人游戏翰墨，因其资地高韵，创意出奇，如晋韦仲将、宋张永所制者，故自不少。","book":"宋·何薳《春渚纪闻·南海松煤》"},"example":{"text":"陶进士与柳孝廉看见，字字俱从风筝打觑到宋信身上，大有～之趣。","book":"《平山冷燕》第六回"},"similar":["游戏笔墨"],"usage":"作谓语、宾语、定语；用于作文等"},{"id":29788,"word":"游手偷闲","pinyin":"yóu shǒu tōu xián","abbr":"ystx","explanation":"指人游荡懒散，不愿参加劳动。同“游手好闲”。","source":{"text":"诚以游手偷闲，所以长其心之淫欲，劳心劳力，所以增其量之所不能。","book":"太平天国·洪仁玕《资政新篇》"},"example":{"text":"李石曾《驳论中国今日不能提倡共产主义》：“曾不得一享其利，而～之辈反得以坐享其成，而无匮乏之忧，更何人尽心于殖产之途者？”"},"similar":["游手好闲"],"usage":"作谓语、定语；指无所事事"},{"id":29789,"word":"游手好闲","pinyin":"yóu shǒu hào xián","abbr":"yshx","explanation":"指人游荡懒散，不愿参加劳动。","source":{"text":"南朝·宋·范晔《后汉书·章帝纪·元和三年诏》：“今肥田尚多，未有垦辟。其悉与赋贫民，给与粮种，务尽地力，勿令游手。”元·无名氏《杀狗劝夫》：“我打你个游手好闲，不务生理的弟子孩儿。"},"example":{"text":"这位督办，那时候正在上海～，无所事事，正好有功夫做那些不相干的闲事。","book":"清·吴趼人《二十年目睹之怪现状》第七十八回"},"similar":["好吃懒做","好逸恶劳","无所事事"],"opposite":["不舍昼夜","夜以继日","废寝忘食"],"usage":"作谓语、定语；指无所事事"},{"id":29790,"word":"游目骋怀","pinyin":"yóu mù chěng huái","abbr":"ymch","explanation":"游目：远眺；骋怀：放开胸怀，往远处想。纵目四望，开阔心胸。","source":{"text":"仰观宇宙之大，俯察品类之盛，所以游目骋怀，足以极视听之娱，信可乐也。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"笙歌如沸，士女如云，～，乐而忘返。","book":"清·俞樾《右台仙馆笔记·闽中陈生》"},"similar":["游心骋目"],"usage":"作谓语、定语；指纵目四望，开阔心胸"},{"id":29791,"word":"游目骋观","pinyin":"yóu mù chěng guān","abbr":"ymcg","explanation":"纵目观望，尽览景物。","source":{"text":"于是游目骋观，南援三州，北集京都。","book":"汉·蔡邕《汉津赋》"},"usage":"作谓语、定语；用于书面语"},{"id":29792,"word":"游移不定","pinyin":"yóu yí bù dìng","abbr":"yybd","explanation":"游移：犹豫。犹豫不决，拿不定主意。","source":{"text":"游环在服马背上，骖马之外辔贯之。游移前却，无定处也。","book":"汉·刘熙《释名·释车》"},"example":{"text":"各级党组织直到每个支部的态度都要十分坚定，不能有任何～、含糊不清的表现。","book":"邓小平《目前的形势和任务》"},"similar":["犹豫不决","狐疑不决","举棋不定"],"opposite":["当机立断","坚定不移"],"usage":"作谓语、定语、宾语；指犹豫"},{"id":29793,"word":"游荡不羁","pinyin":"yóu dàng bù jī","abbr":"ydbj","explanation":"游乐放荡，不受拘束。","source":{"text":"殊少为士人，游荡不羁。","book":"宋·陆游《老学庵笔记》卷七"},"example":{"text":"后闵以～，卓锥无地，姬延之至家，寝食与共，虽伉俪不过也。","book":"清·朱泉居士《雪鸿小记补遗》"},"usage":"作谓语、定语、状语；用于人的性格"},{"id":29794,"word":"游蜂戏蝶","pinyin":"yóu fēng xì dié","abbr":"yfxd","explanation":"飞舞游戏的蝴蝶和蜜蜂。后用以比喻浪荡子弟。","source":{"text":"风恬日暖荡春光，戏蝶游蜂乱人房。","book":"唐·岑参《山房春事二首》"},"example":{"text":"～空自忙，岂知美人在西厢。","book":"宋·陆游《驿舍海棠已过有感》"},"similar":["戏蝶游蜂","游蜂浪蝶"],"usage":"作主语、宾语、定语；指浪荡子弟"},{"id":29795,"word":"游蜂浪蝶","pinyin":"yóu fēng làng dié","abbr":"yfld","explanation":"比喻态度轻佻好挑逗女子的人。","source":{"text":"不相饶，游蜂浪蝶簇花梢，生来懒去追欢笑。","book":"明·顾大典《青衫记·裴兴私叹》"},"example":{"text":"何来姊妹服鲜衣，顿使～迷。","book":"清·顾夔璋《下海子》"},"similar":["游蜂戏蝶"],"usage":"作宾语、定语；指好色之徒"},{"id":29796,"word":"游行示威","pinyin":"yóu xíng shì wēi","abbr":"yxsw","explanation":"广大群众为了庆祝、纪念、示威等在街上结队而行。","source":{"text":"在这些口号下煽动一部分人游行示威，蓄谋让外国人把他们的言论行动拿到世界上去广为宣传。","book":"邓小平《坚持四项基本原则》"},"usage":"作谓语、宾语、定语；用于集会等"},{"id":29797,"word":"游谈无根","pinyin":"yóu tán wú gēn","abbr":"ytwg","explanation":"指没有根据信口乱说。","source":{"text":"而后生科举之士，皆束书不观，游谈无根，此又何也？","book":"宋·苏轼《李氏山房藏书记》"},"example":{"text":"剿袭陈言可谓之健乎？～可谓之厚乎？","book":"清·黄宗羲《高元发三稿类存序》"},"similar":["胡说八道"],"usage":"作宾语、定语；用于书面语"},{"id":29798,"word":"游辞巧饰","pinyin":"yóu cí qiǎo shì","abbr":"ycqs","explanation":"用没有根据的话多方掩饰。","source":{"text":"服罪输情者虽重必释；游辞巧饰者虽轻必戮。","book":"《三国志·蜀书·诸葛亮传评》"},"usage":"作宾语、定语；指掩饰自己"},{"id":29799,"word":"游辞浮说","pinyin":"yóu cí fú shuō","abbr":"ycfs","explanation":"游离不定的言辞，浮夸滓的议论。","source":{"text":"王何蔑弃典文，不遵礼度，游辞浮说，波荡后生，饰华言以翳实，骋繁文以惑世。","book":"《晋书·范汪传》"},"usage":"作宾语、定语；用于书面语"},{"id":29800,"word":"游闲公子","pinyin":"yóu xián gōng zǐ","abbr":"yxgz","explanation":"指游手好闲的富家子弟。","source":{"text":"游闲公子，饰冠剑，连车骑，亦为富贵容也。","book":"西汉·司马迁《史记·货殖列传》"},"example":{"text":"于是～，暇豫王孙。","book":"汉·马融《长笛赋》"},"similar":["纨绔子弟","公子哥儿"],"usage":"作主语、宾语、定语；指富家子弟"},{"id":29801,"word":"游骑无归","pinyin":"yóu jì wú guī","abbr":"yqwg","explanation":"游骑：离队的骑兵。离队的骑兵，无处可归。比喻离了根本，得不到归宿。","source":{"text":"只务观物理，汛然正如游骑无所归也。","book":"宋《二程遗书·遗书七》"},"example":{"text":"文公分致知格物为先知，诚意正心为后行，故有～之虑。","book":"明·黄宗羲《明儒学案》卷十二引王畿《答吴悟斋》"},"usage":"作谓语、定语；指做学问等"},{"id":29802,"word":"游鱼出听","pinyin":"yóu yú chū tīng","abbr":"yyct","explanation":"形容音乐美妙动听。","source":{"text":"昔者瓠巴鼓瑟，而流鱼出听，伯牙鼓琴，而六马仰秣。","book":"《荀子·劝学》"},"example":{"text":"伯牙鼓琴，～。","book":"明·张鼎思《琅玡代醉编》"},"similar":["六马仰秣","余音绕梁"],"usage":"作宾语、定语；用于书面语"},{"id":29803,"word":"渺不足道","pinyin":"miǎo bù zú dào","abbr":"mbzd","explanation":"非常微小，不值得一谈。","source":{"text":"但是这些自然界的事物和人比较起来，特别是和社会主义革命时代的先进人物比较起来，却又完全显得渺不足道了。","book":"秦牧《序》"},"example":{"text":"在这大时代里，生与死的意义固然都很重大，然而，对于一个生活在空隙当中的人，却又是多么的～呵！","book":"沙汀《老烟的故事》"},"similar":["微不足道"],"opposite":["举足轻重"],"usage":"作谓语、宾语；指非常微小"},{"id":29804,"word":"渺无人烟","pinyin":"miǎo wú rén yān","abbr":"mwry","explanation":"一片渺茫，没有人家。","source":{"text":"不上一月，将淮北千里，扫荡个渺无人烟。","book":"《花月痕》第四七回"},"example":{"text":"长征中，红军斩关夺隘……跋涉了～的草原。","book":"刘伯承《回顾长征》"},"similar":["荒无人烟"],"opposite":["人口稠密"],"usage":"作宾语、定语；形容空旷荒凉"},{"id":29805,"word":"渺无人踪","pinyin":"miǎo wú rén zōng","abbr":"mwrz","explanation":"很少看见人的踪影，形容空旷寂静。","source":{"text":"田间是静悄悄的，大路上也是静悄悄的渺无人踪。","book":"王汶石《大木匠》"},"similar":["渺无人迹","渺无人烟"],"usage":"作宾语、定语；形容空旷寂静"},{"id":29806,"word":"渺无人迹","pinyin":"miǎo wú rén jì","abbr":"mwrj","explanation":"看不见一个人的脚印。形容空旷寂静。亦作“渺无人踪”。","source":{"text":"从大道上望去，却就像一座渺无人迹的黄土荒山。","book":"沙汀《淘金记》十三"},"example":{"text":"田间是静悄悄的，大路上也是静悄悄的渺无人踪。","book":"王汶石《大木匠》"},"similar":["渺无人踪","渺无人烟"],"opposite":["人口稠密"],"usage":"作定语；形容空旷寂静"},{"id":29807,"word":"渺无影踪","pinyin":"miǎo wú yǐng zōng","abbr":"mwyz","explanation":"看不到一点踪迹和影子。","source":{"text":"努力追忆昨夜的颠倒迷梦，然而——已经渺无影踪。","book":"茅盾《腐蚀·十一月十三日》"},"example":{"text":"他已经消失得～了"},"similar":["渺无踪影"],"usage":"作谓语、状语；指没有踪迹和影子"},{"id":29808,"word":"渺无踪影","pinyin":"miǎo wú zōng yǐng","abbr":"mwzy","explanation":"看不到一点踪迹和影子。亦作“渺无影踪”。","source":{"text":"宜春、蕊儿，渺无踪影。","book":"清和邦额《夜谭随录·霍筠》"},"example":{"text":"睁大眼，惘然凝视屋角的鼠洞，努力追忆昨夜的颠倒迷梦，然而——已经渺无影踪。","book":"茅盾《腐蚀·十一月十三日》"},"similar":["渺无影踪","无影无踪"],"usage":"作谓语、状语；指踪迹和影子"},{"id":29809,"word":"渺无边际","pinyin":"miǎo wú biān jì","abbr":"mwbj","explanation":"渺：邈远的样子。无边无际的样子。","source":{"text":"向机下展望，一望青黄色的草原，渺无边际。","book":"郭沫若《苏联纪行·6月25日》"},"example":{"text":"为什么在这～的林海里，会有这样一片连一棵树也没有的大山洼呢？","book":"曲波《林海雪原》第三十二章"},"similar":["无边无际"],"usage":"作谓语、定语；指广大"},{"id":29810,"word":"渺无音信","pinyin":"miǎo wú yīn xìn","abbr":"mwyx","explanation":"渺：邈远的样子。指毫无消息","source":{"text":"你不能就这样渺无音信地丢开了我，让我孤零零地住在这个陌生的大城市里。","book":"巴金《发的故事·窗下》"},"example":{"text":"他三年前离家，至今～"},"similar":["渺无音讯","杳无音信"],"usage":"作谓语、定语、宾语；指毫无消息"},{"id":29811,"word":"渺无音讯","pinyin":"miǎo wú yīn xùn","abbr":"mwyx","explanation":"指毫无消息。","source":{"text":"太阳下了山，同志们打起灯笼火把，披开一丛丛的荒草搜寻，炮弹还是渺无音讯。","book":"吴运铎《把一切献给党·新任务》"},"similar":["渺无音信"],"usage":"作定语、宾语；指毫无消息"},{"id":29812,"word":"渺渺茫茫","pinyin":"miǎo miǎo máng máng","abbr":"mmmm","explanation":"辽阔无际的样子。亦指模糊；不清楚。","source":{"text":"神仙事渺渺茫茫，有什么准程，教我去做他。","book":"元马致远《黄梁梦》第一折"},"example":{"text":"追寻畴者，愁如流水，～趁潮汐。","book":"明刘基《六幺令》词"},"usage":"作谓语、定语、状语；指模糊不清"},{"id":29813,"word":"渺然一身","pinyin":"miǎo rán yī shēn","abbr":"mrys","explanation":"渺然：微小的样子。孤孤单单一个人。形容力量微小。","source":{"text":"遗诏曰：朕获保宗庙，以眇眇之身托于天下君王之上，二十有余年矣。","book":"《汉书·文帝纪》"},"example":{"text":"古之君子以～而能与天地并立者，岂周旋上下委曲弥逢之所能办哉。","book":"宋·陈亮《与石应之》"},"usage":"作谓语、定语；指单个力量"},{"id":29814,"word":"渺若烟云","pinyin":"miǎo ruò yān yún","abbr":"mryy","explanation":"渺：渺茫；若：象。象烟云一样渺茫不清。比喻模糊不清，令人捉摸不定。","example":{"text":"像一个多情的幽灵独自追念着那不可唤回的～的以往，又是惋惜，又是哀伤，那样充满了怨望和依恋。","book":"曹禺《北京人》第三幕"}},{"id":29815,"word":"湔肠伐胃","pinyin":"jiān cháng fá wèi","abbr":"jcfw","explanation":"湔：洗；伐：敲打。形容以聪慧代替原来的愚钝。","source":{"text":"湔肠伐胃，受赐已多。尚有一事相烦，不知可否？","book":"清·蒲松龄《聊斋志异·陆判》"},"usage":"作宾语、定语；用于方言"},{"id":29816,"word":"湖光山色","pinyin":"hú guāng shān sè","abbr":"hgss","explanation":"湖的风光，山的景色。指有水有山，风景秀丽。","source":{"text":"杭城湖光山色之秀，锺为人物，所以清奇特，为天下寇。","book":"宋·吴自牧《梦梁录·五代人物》"},"example":{"text":"园内轩窗四启，看着～，真如仙境。","book":"清·吴敬梓《儒林外史》第三十五回"},"similar":["山清水秀","山明水秀"],"opposite":["穷山恶水"],"usage":"作主语、宾语；形容美好的自然风景"},{"id":29817,"word":"湖吃海喝","pinyin":"hú chī hǎi hē","abbr":"hchh","explanation":"放肆地大吃大喝。","example":{"text":"～和软磨硬缠是他的两项本事。"},"similar":["大吃大喝","山吃海喝"],"opposite":["忍饥挨饿"],"usage":"作谓语、宾语、定语；指大吃大喝"},{"id":29818,"word":"湖海之士","pinyin":"hú hǎi zhī shì","abbr":"hhzs","explanation":"旧时形容气慨豪放之人。","source":{"text":"陈元龙湖海之士，豪气不除。","book":"《三国志·魏志·张邈传》"}},{"id":29819,"word":"湖海飘零","pinyin":"hú hǎi piāo líng","abbr":"hhpl","explanation":"飘零：飘泊。居无定所，四处飘泊。","example":{"text":"我不想再过这种～的生活。"},"usage":"作谓语、定语；指飘泊"},{"id":29820,"word":"湛恩汪濊","pinyin":"zhàn ēn wāng hún","abbr":"zewh","explanation":"指恩泽深厚。"},{"id":29821,"word":"湛湛青天","pinyin":"zhàn zhàn qīng tīan","abbr":"zzqt","explanation":"湛湛：厚重的样子。比喻正义和公正。","source":{"text":"若没些儿圣灵与世人传，也不见得湛湛青天。","book":"元·关汉卿《窦娥冤》"},"example":{"text":"～作证，他是个为革命事业流血牺牲的英雄，不是叛徒。"},"usage":"作宾语、定语；指上天"},{"id":29822,"word":"湮坠无闻","pinyin":"yān zhuì wú wén","abbr":"yzww","explanation":"湮：埋没；无闻：没有知道。名声被埋没，没人知道。","source":{"text":"由来贤达胜士，登此远望，如我与卿者多矣！皆湮灭无闻，使人悲伤。","book":"《史记·伯夷列传》：“岩穴之士，趋舍有时若此，英名湮没而不称，悲夫。”《晋书·羊祜传》"}},{"id":29823,"word":"湮没不宣","pinyin":"yān mò bù xuān","abbr":"ymbx","explanation":"湮：埋没。名声被埋没，没有宣传出去。","source":{"text":"岩穴之士，趋舍有时若此，英名湮没而不称，悲夫。","book":"《史记·伯夷列传》"}},{"id":29824,"word":"湮没不彰","pinyin":"yān mò bù zhāng","abbr":"ymbz","explanation":"湮：埋没；彰：明显。名声被埋没，没有宣扬。","source":{"text":"岩穴之士，趋舍有时若此，英名湮没而不称，悲夫。","book":"《史记·伯夷列传》"},"example":{"text":"诗人岂可以没有别号；倘使不弄个别号，那诗名就～了。","book":"清·吴趼人《二十年目睹之怪现状》第三十五回"}},{"id":29825,"word":"湮没无闻","pinyin":"yān mò wú wén","abbr":"ymww","explanation":"湮：埋没；无闻：没有知道。名声被埋没，没人知道。","source":{"text":"由来贤达胜士，登此远望，如我与卿者多矣！皆湮灭无闻，使人悲伤。","book":"《晋书·羊祜传》"},"example":{"text":"高才博识，俱有可录，岁月弥久，～，遂传其本末，吊以乐章。","book":"元·钟嗣成《录鬼簿序》"},"similar":["碌碌无闻","不见经传","默默无闻"],"opposite":["赫赫有名","举世闻名","鼎鼎大名"],"usage":"作谓语、定语；指默默无闻"},{"id":29826,"word":"湮没罕闻","pinyin":"yān mò hǎn wén","abbr":"ymhw","explanation":"湮：埋没；无闻：没有知道。名声被埋没，没人知道。","source":{"text":"由来贤达胜士，登此远望，如我与卿者多矣！皆湮灭无闻，使人悲伤。","book":"《史记·伯夷列传》：“岩穴之士，趋舍有时若此，英名湮没而不称，悲夫。”《晋书·羊祜传》"},"similar":["湮没无闻","湮灭无闻"],"usage":"作谓语、定语；指默默无闻"},{"id":29827,"word":"湮灭无闻","pinyin":"yān miè wú wén","abbr":"ymww","explanation":"名声被埋没，没人知道","source":{"text":"自有宇宙，便有此山。由来贤达胜士，登此望远，如我与卿者多矣！皆湮灭无闻，使人悲伤。","book":"《晋书·羊祜传》"},"similar":["湮没无闻","湮没罕闻"],"usage":"作谓语、定语；指默默无闻"},{"id":29828,"word":"湿哭干啼","pinyin":"shī kū gān tí","abbr":"skgt","explanation":"湿哭：有眼泪地啼哭；干啼：没有眼泪地啼哭。形容哭哭啼啼的样子。也泛指因苦楚而呈现出的各种表情。","source":{"text":"小儿惯去，放使作心腹，何须干啼湿哭不听打耶！","book":"《北齐书·尉景传》"},"example":{"text":"留客且为无事饮，对花还作有情痴，羲之乐死从今定，～总不知。","book":"清·赵翼《瓯北诗钞·七言律五·七十自述》其二十五"}},{"id":29829,"word":"湿肉伴干柴","pinyin":"shī ròu bàn gān chái","abbr":"srbgc","explanation":"形容拷打。"},{"id":29830,"word":"溃不成军","pinyin":"kuì bù chéng jūn","abbr":"kbcj","explanation":"溃：溃败，散乱。被打得七零八落，不成队伍。形容惨败。","source":{"text":"等待着敌人的锐气开始衰落时，抓住要害猛力击，就可以把敌人杀得溃不成军。","book":"姚雪垠《李自成》第一卷第八章"},"example":{"text":"那些洋鬼子被义和团打得～。"},"similar":["弃甲曳兵","一败涂地"],"opposite":["旗开得胜"],"usage":"作谓语、定语、补语；用于军事等"},{"id":29831,"word":"溃兵游勇","pinyin":"kuì bīng yóu yǒng","abbr":"kbyy","explanation":"指逃散的士兵。","source":{"text":"国民党部队的溃兵游勇，带枪到处抢劫肇事，很影响群众的抗日情绪。","book":"李昌《回忆民先队》七"},"similar":["散兵游勇"],"usage":"作主语、宾语；指没有统帅的逃散士兵"},{"id":29832,"word":"溃冒冲突","pinyin":"kuì mào chōng tū","abbr":"kmct","explanation":"溃：水冲破堤坝。洪水成灾，堤坝溃决。","source":{"text":"昔禹之治水，凿龙门，决大河，而放之海。方其功之未成也，盖亦有溃冒冲突可畏之患。","book":"宋·苏轼《晁错传》"},"usage":"作宾语、定语；用于比喻句"},{"id":29833,"word":"溃敌如决河","pinyin":"kuì dí rú jué hé","abbr":"kdrjh","explanation":"溃：散，乱。溃败的敌人像河水冲决堤坝一样。","source":{"text":"尊彼前茅，追奔若顺海，乘兹破竹，溃敌如决河。","book":"唐·许敬宗《唐并州都督鄂国公尉迟恭碑》"},"usage":"作宾语、定语；用于战争等"},{"id":29834,"word":"源头活水","pinyin":"yuán tóu huó shuǐ","abbr":"yths","explanation":"原比喻读书越多，道理越明。现也指事物发展的动力和源泉。","source":{"text":"半亩方塘一鉴开，天光云影共徘徊。问渠那得清如许，为有源头活水来。","book":"宋·朱熹《观书有感》诗"},"example":{"text":"～溢平川，桃花色香总自然。","book":"明·海瑞《乐耕堂》"},"usage":"作宾语、定语；指读书越多，道理越明"},{"id":29835,"word":"源广流长","pinyin":"yuán guǎng liú cháng","abbr":"yglz","explanation":"源：源头；流：流程。源头很远，水流很长。比喻历史悠久","source":{"text":"源广流长，庆深祚远。","book":"唐·陆贽《晋王荆襄江西道兵马都元帅制》"},"similar":["源远流长","源深流长"],"usage":"作谓语、定语；指历史悠久"},{"id":29836,"word":"源殊派异","pinyin":"yuán shū pài yì","abbr":"yspy","explanation":"水流的源头不同，其支流各自不同。比喻学派、学说皆自立门户，各不相涉。","source":{"text":"源殊派异，无所适从，索隐探微，宜伸确论。","book":"宋·吴自牧《梦梁录·浙江》"},"usage":"作宾语、定语；用于书面语"},{"id":29837,"word":"源泉万斛","pinyin":"yuán quán wàn hú","abbr":"yqwh","explanation":"比喻文思涌溢。","source":{"text":"吾文如万斛泉源，不择地而出。","book":"宋·苏轼《文说》"},"usage":"作宾语、定语；指人的文才"},{"id":29838,"word":"源深流长","pinyin":"yuán shēn liú cháng","abbr":"yslz","explanation":"源：河流的源头；流：流程。源头很深，水流很长。比喻历史悠久。","source":{"text":"人谓其机会与造化争衡，非人工可到。盖胸中所养不凡，源深流长，自然之道。","book":"唐·白居易《海州刺史裴君夫人李氏墓志铭》：“夫源远者流长，根深者枝茂。”《宣和书谱·草书·唐·贺知章》"},"example":{"text":"奉承若宥，神其乐康。锡以多祉，～。","book":"《宋史·乐志十》"},"similar":["源广流长","源远流长"],"usage":"作谓语、定语；指历史悠久"},{"id":29839,"word":"源清流净","pinyin":"yuán qīng liú jìng","abbr":"yqlj","explanation":"源头的水清，下游的水自然就清。比喻因果相连，事物的本原好，其发展和结局也就好；或领导贤明，其下属也廉洁。同“源清流洁”。","source":{"text":"你是花根本艳，源清流净，端的不虚名。","book":"明·无名氏《怒斩关平》第一折"},"similar":["源清流清","源清流洁"],"usage":"作宾语、定语；用于书面语"},{"id":29840,"word":"源清流洁","pinyin":"yuán qīng liú jié","abbr":"yqlj","explanation":"源头的水清，下游的水也清。原比喻身居高位的人好，在下面的人也好。也比喻事物的因果关系。","source":{"text":"源清则流清，源浊则流浊。","book":"《荀子·君道》"},"example":{"text":"～，本盛末荣。","book":"汉·班固《泗水亭碑铭》"},"similar":["源清流清","源清流净"],"usage":"作宾语、定语；比喻因果相关"},{"id":29841,"word":"源清流清","pinyin":"yuán qīng liú qīng","abbr":"yqlq","explanation":"源头的水清，下游的水自然就清。比喻因果相连，事物的本原好，其发展和结局也就好；或领导贤明，其下属也廉洁。源，也作原。亦作“源清流洁”、“源清流净”。","source":{"text":"君者民之源也，源清则流清，源浊则流浊。","book":"语出《荀子·君道》：“故械数者，治之流也，非治之原也。君子者，治之原也。官人守数，君子养原，原清则流清，原浊则流浊。”《韩诗外传》卷五"},"similar":["源清流洁","源清流净"],"usage":"作宾语、定语；用于书面语"},{"id":29842,"word":"源源不断","pinyin":"yuán yuán bù duàn","abbr":"yybd","explanation":"形容接连不断。","source":{"text":"欲常常而见之，故源源而来。","book":"《孟子·万章上》"},"example":{"text":"夜间，官军打通了由智亭山通往龙驹寨的大道，所以从天亮起就有军粮～地从龙驹寨向西运送。","book":"姚雪垠《李自成》第二卷第十三章"},"similar":["连绵不断","络绎不绝","接连不断"],"opposite":["一刀两断","断断续续"],"usage":"作定语、状语；指连续不断"},{"id":29843,"word":"源源不竭","pinyin":"yuán yuán bù jié","abbr":"yybj","explanation":"源源：水流不断的样子；竭：完。形容接连不断，没有尽头。","source":{"text":"又防止了对于人力资源的滥用和浪费，人力动员却可以源源不竭。","book":"毛泽东《论联合政府》"},"similar":["源源不断"],"usage":"作定语、状语；指连续不断"},{"id":29844,"word":"源源不绝","pinyin":"yuán yuán bù jué","abbr":"yybj","explanation":"源源：水流不断的样子。形容接连不断。","source":{"text":"欲常常而见之，故源源而来。","book":"《孟子·万章上》"},"example":{"text":"甚么《启蒙画报》、《经国美谈》、《新小说》、《浙江潮》等书报差不多是～地寄来。","book":"郭沫若《少年时代·我的童年》"},"similar":["源源不断"],"opposite":["断断续续"],"usage":"作定语、状语；指连续不断"},{"id":29845,"word":"源源本本","pinyin":"yuán yuán běn běn","abbr":"yybb","explanation":"源头和根本。多用以指事情的始末。","source":{"text":"自从这立宪二字发见了，就有人从西书上译出一部宪法新论，讲的源源本本，有条有理。","book":"清·李宝嘉《文明小史》第六十回"},"example":{"text":"我已经查明白～是怎么一回事。","book":"茅盾《子夜》十五"},"usage":"作宾语、状语；用于口语"},{"id":29846,"word":"源源而来","pinyin":"yuán yuán ér lái","abbr":"yyel","explanation":"原指诸侯相继朝觐一辈子。后形容接连不断地到来。","source":{"text":"欲常常而见之，故源源而来。","book":"《孟子·万章上》"},"example":{"text":"果然有了此好，方士～，零零星星，也弄去了好些银子，受过了好些丹客的哄骗。","book":"明·凌濛初《初刻拍案惊奇》卷十八"},"similar":["源源不断","源源不绝"],"opposite":["断断续续"],"usage":"作谓语、定语、状语；形容接连不断地到来"},{"id":29847,"word":"源远根深","pinyin":"yuán yuǎn gēn shēn","abbr":"yygs","explanation":"水源很远，树根很深。比喻基础牢固。","source":{"text":"水波澜者源必远，树扶疏者根必深。","book":"北周·庾信《徵调曲》"},"example":{"text":"棋虽小道，品德最尊。中国绝技，～。","book":"陈毅《题〈围棋名谱精选〉》"},"usage":"作宾语、定语；用于书面语"},{"id":29848,"word":"源远流长","pinyin":"yuán yuǎn liú cháng","abbr":"yylc","explanation":"源头很远，水流很长。比喻历史悠久。","source":{"text":"夫源远者流长，根深者枝茂。","book":"唐·白居易《海州刺史裴君夫人李氏墓志铭》"},"example":{"text":"剥削阶级的幸福观，是～，影响仍然是相当深广的。","book":"秦牧《一个黑人战士的豪迈声音》"},"similar":["源源不绝","源源不断","源源而来"],"opposite":["无本之木","无源之水"],"usage":"作谓语、定语；指历史悠久"},{"id":29849,"word":"溘先朝露","pinyin":"kè xiān zhāo lù","abbr":"kxzl","explanation":"指生命比朝露消失得还快。形容死得过早。","source":{"text":"若平勃二人溘先朝露，则刘氏之业必归吕宗。","book":"唐·李德裕《张辟疆论》"},"example":{"text":"质常恐～，不得展其旅力，为公扫除。","book":"宋·司马光《资治通鉴·宋孝武帝孝建元年》"},"usage":"作谓语、宾语；指生命短暂"},{"id":29850,"word":"溘焉长往","pinyin":"kè yán cháng wǎng","abbr":"kyzw","explanation":"溘：忽然。指人突然死亡。","source":{"text":"宁溘死以流亡兮，余不忍为此态也。","book":"战国·楚·屈原《楚辞·离骚》"},"example":{"text":"方欲以高文大册自鸣天子之前，而又～矣。","book":"清·汪琬《归震川先生年谱后序》"},"similar":["溘然长逝"],"usage":"作谓语；常作悼念死者用词"},{"id":29851,"word":"溘然而去","pinyin":"kè rán ér qù","abbr":"kreq","explanation":"溘然：突然。指人忽然死去。","source":{"text":"则一旦溘然而去，将一生心血，付之茫茫，岂不大可惜也。","book":"清·袁枚《小仓山房尺牍》第92首"},"similar":["溘然长逝"],"usage":"作谓语；多指病故"},{"id":29852,"word":"溘然而逝","pinyin":"kè rán ér shì","abbr":"kres","explanation":"溘然：突然。指人忽然死去。","source":{"text":"忽呼邻里语曰：‘同居三十余年，今长别矣，以遗蜕奉托可乎？’溘然而逝。","book":"清·纪昀《阅微草堂笔记·滦阳徐录五》"},"similar":["溘然而去"],"usage":"作谓语；多指病故"},{"id":29853,"word":"溘然长往","pinyin":"kè rán cháng wǎng","abbr":"krcw","explanation":"溘：忽然。指人突然死亡，常作悼念死者用词。","source":{"text":"《楚辞·离骚》：“宁溘死以流亡兮。"},"example":{"text":"方欲以高文大册自鸣天子之前，而又溘然长往矣。","book":"清·汪琬《归震川先生年谱后序》"},"similar":["溘然长逝","溘焉长往"],"usage":"作谓语；常作悼念死者用词"},{"id":29854,"word":"溘然长逝","pinyin":"kè rán cháng shì","abbr":"krcs","explanation":"指死去。","source":{"text":"乃归未及一月，竟溘然长逝，年仅逾弱冠耳。","book":"梁启超《饮冰室诗话》"},"example":{"text":"延至十二月十五日，即～。","book":"冯玉祥《我的生活》第七章"},"similar":["溘然而去","溘然而逝"],"usage":"作谓语；多指病故"},{"id":29855,"word":"溜之乎也","pinyin":"liū zhī hū yě","abbr":"lzhy","explanation":"溜走（讽刺的、风趣的说法）。","source":{"text":"他却少陪也不说一声，就此溜之乎也去了。","book":"清·吴趼人《痛史》第六回"},"example":{"text":"三荷包见此光景，搭讪着就～。","book":"清·李宝嘉《官场现形记》第五回"},"similar":["溜之大吉"],"usage":"作谓语、宾语；用于口语"},{"id":29856,"word":"溜之大吉","pinyin":"liū zhī dà jí","abbr":"lzdj","explanation":"溜：趁人看不见走开；吉：吉祥。偷偷地跑掉为妙。","source":{"text":"稚燕趁着他们扰乱的时候，也就溜之大吉。","book":"清·曾朴《孽海花》第二十四回"},"example":{"text":"有的～，悄悄地爬上开往上海的四等车。","book":"叶圣陶《多收了三五斗》"},"similar":["逃之夭夭"],"opposite":["一往无前"],"usage":"作谓语、定语；用于人的行动"},{"id":29857,"word":"溜干二净","pinyin":"liū gān èr jìng","abbr":"lgej","explanation":"一点不剩，非常干净。","example":{"text":"一点不剩，非常干净。"},"similar":["一干二净"],"usage":"作定语、状语；用于口语"},{"id":29858,"word":"溜须拍马","pinyin":"liū xū pāi mǎ","abbr":"lxpm","explanation":"拍马：拍马屁。比喻讨好奉承。","source":{"text":"跟在李乡长的屁股后边，溜须拍马，可神气啦。","book":"浩然《艳阳天》第128章"},"example":{"text":"他一向会～。"},"similar":["阿谀奉承"],"opposite":["刚正不阿"],"usage":"作谓语、宾语；比喻讨好奉承"},{"id":29859,"word":"溢于文辞","pinyin":"yì yú wén cí","abbr":"yywc","explanation":"溢：水满外流，引申为超过、超出。指深刻的内涵和丰富的思想情感通过文辞充分显露出来，甚至超过了文辞本身。","source":{"text":"方今公孙丞相……严安、徐乐、司马迁之伦，皆辩知闳达，溢于文辞，先生自视，何与比哉？","book":"《汉书·东方朔传》"},"example":{"text":"少豪隽慷慨，～。","book":"《宋史·文苑传·秦观》"}},{"id":29860,"word":"溢于楮墨之表","pinyin":"yì yú chǔ mò zhī biǎo","abbr":"yycmzb","explanation":"楮墨：纸墨。诗文、绘画作品所要表达的某种思想感情超出纸墨之外。","source":{"text":"来札蔼蔼之情，溢于楮墨之表，彼此同之。","book":"明·朱之瑜《答野节书二十八首》"}},{"id":29861,"word":"溢于言外","pinyin":"yì yú yán wài","abbr":"yyyw","explanation":"溢：水满外流，引申为超出。超出语言之外。指某种意思、感情通过语言文字充分表露出来。亦作“溢于言表”。","source":{"text":"郑重叮咛的意思，溢于言外。","book":"叶圣陶《倪焕之》六"},"similar":["溢于言表"],"usage":"作谓语、定语；指人的思想感情"},{"id":29862,"word":"溢于言表","pinyin":"yì yú yán biǎo","abbr":"yyyb","explanation":"超出言语以外，指某种思想感情虽未说明却能使人体会出来。","source":{"text":"来书十读，不忍释手，真挚之情，溢于言表。","book":"明·朱舜水《答安东守约书三十首》"},"example":{"text":"农民们互相传说，彼此相告，雀跃的欣喜的心情～。","book":"陈残云《山谷风烟》第七章"},"similar":["言外之音","意在言外"],"opposite":["直抒胸臆","一言已尽"],"usage":"作谓语；指人的思想感情"},{"id":29863,"word":"溢巷填街","pinyin":"yì xiàng tián jiē","abbr":"yxtj","explanation":"形容人非常多。","source":{"text":"又生不长发，便谓为道人，填街溢巷，是处皆然。","book":"《南齐书·虞玩之传》"},"example":{"text":"公卿命士，更吊迭唁，～，为之缟素。","book":"唐·张说《祁国公碑》"}},{"id":29864,"word":"溢气坌涌","pinyin":"yì qì bèn yōng","abbr":"yqby","explanation":"才气横溢，喷涌而出。","example":{"text":"他是我们单位的一个～的才子。"},"usage":"作谓语、定语；用于书面语"},{"id":29865,"word":"溢美之言","pinyin":"yì měi zhī yán","abbr":"ymzy","explanation":"过分夸奖的话。","source":{"text":"夫两喜必多溢美之言，两怒必多溢恶之言。","book":"先秦·庄周《庄子·人间世》"},"similar":["过甚其辞","言过其实"],"usage":"作主语、宾语；指过分夸奖的话"},{"id":29866,"word":"溢美之语","pinyin":"yì měi zhī yǔ","abbr":"ymzy","explanation":"过分夸奖的话。","source":{"text":"夫两喜必多溢美之语，两怒必多溢恶之言。","book":"《庄子·人间世》"}},{"id":29867,"word":"溢美之辞","pinyin":"yì měi zhī cí","abbr":"ymzc","explanation":"溢：水满外溢，引申为过分。过分吹嘘的话语。亦作“溢美之言”。","source":{"text":"雨农遽为之序，且有溢美之辞。","book":"清·梁章钜《归田琐记·高雨农序》"},"similar":["溢美之言"],"usage":"作主语、宾语；指过分夸奖的话"},{"id":29868,"word":"溢美溢恶","pinyin":"yì měi yì wù","abbr":"ymyw","explanation":"溢：水满外流，引伸为过度。过分夸奖，过分指责。","source":{"text":"夫两喜必多溢美之言，两怒必多溢恶之言。","book":"《庄子·人世间》"},"usage":"作定语；指极端赞美和贬斥"},{"id":29869,"word":"溢言虚美","pinyin":"yì yán xū měi","abbr":"yyxm","explanation":"过甚其辞、不符合实际地称美。","source":{"text":"古人事君亲要于诚心，不敢溢言虚美，以滋天下后世之口实也。","book":"清·方苞《书周颂清庙诗后》"},"usage":"作谓语、定语；用于处事"},{"id":29870,"word":"溥博如天","pinyin":"pǔ bó rú tiān","abbr":"pbrt","explanation":"溥：广大；溥、博：周遍广远。形容广阔，犹如无边的天空。","source":{"text":"溥博如天，渊泉如渊。","book":"《礼记·中庸》"}},{"id":29871,"word":"溥天之下，莫非王土","pinyin":"pǔ tiān zhī xià，mò fēi wáng tǔ","abbr":"ptzxmfwt","explanation":"溥：通“普”，普遍，全。苍天之下都是天子的辖地。指大一统思想。","source":{"text":"溥天之下，莫非王土；率土之滨，莫非王臣。","book":"《诗经·小雅·北山》"},"similar":["普天之下，莫非王土"],"usage":"作宾语、定语；用于书面语"},{"id":29872,"word":"溥天同庆","pinyin":"pǔ tiān tóng qìng","abbr":"pttq","explanation":"遍天下的人一同欢庆。","source":{"text":"今溥天同庆而卿最留迟，何也？","book":"晋·陈寿《三国志·魏志·郭淮传》"},"example":{"text":"盖天助有德而非人功，振古所无，～。","book":"宋·苏轼《徐州贺河平表》"},"similar":["普天同庆"],"usage":"作谓语、宾语、分句；指国家有喜事"},{"id":29873,"word":"溥天率土","pinyin":"pǔ tiān lǜ tǔ","abbr":"ptlt","explanation":"指整个天下、四海之内。","source":{"text":"溥天之下，莫非王土；率土之滨，莫非王臣。","book":"语出《诗·小雅·北山》"},"example":{"text":"使千万斯年，～，紬绎之而无穷，禀承之而难尽也。","book":"清·黄六鸿《福惠全书·教养上谕》"},"similar":["普天率土"],"usage":"作宾语、定语；指天下"},{"id":29874,"word":"溪壑无厌","pinyin":"xī hè wú yàn","abbr":"xhwy","explanation":"溪壑：山里的溪流和深谷；厌：满足。比喻人的贪欲太大，难以满足。","source":{"text":"自尔升擢，超越伦伍，而溪壑无厌，著于触事。","book":"《南齐书·谢脁传》"},"example":{"text":"富弼不能止夷狄～之求。","book":"宋·邵伯温《闻见前录》第九卷"},"similar":["贪得无厌","贪心不足"],"opposite":["知足常乐"],"usage":"作谓语、定语；指人很贪心"},{"id":29875,"word":"溯本求源","pinyin":"sù běn qiú yuán","abbr":"sbqy","explanation":"溯：追寻；本：事物的根本；求：探索；源：源头。追寻根本，探求起源。比喻寻根究底。","source":{"text":"其能发明先贤旨意，溯流徂源，论著讲介卓然自为一家者，惟广汉张氏敬夫、东莱吕氏伯恭、新安朱氏元晦而已。","book":"宋·周密《齐东野语·道学》"}},{"id":29876,"word":"溯水行舟","pinyin":"sù shuǐ xíng zhōu","abbr":"ssxz","explanation":"指逆水行船。","source":{"text":"客从巴水渡，传尔溯行舟。","book":"唐·崔颢《赠卢八象》诗"}},{"id":29877,"word":"溯流从源","pinyin":"sù liú cóng yuán","abbr":"slcy","explanation":"溯：逆流而上。顺支流上溯河源。比喻追根究底。","source":{"text":"其能发明先贤旨意，溯流徂源，论著讲介卓然自为一家者，惟广汉张氏敬夫、东莱吕氏伯恭、新安朱氏元晦而已。","book":"宋·周密《齐东野语·道学》"},"similar":["溯流徂源"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":29878,"word":"溯流徂源","pinyin":"sù liú cú yuán","abbr":"slcy","explanation":"溯：逆流而上；徂：往、到。顺支流上溯河源。比喻追根究底。","source":{"text":"其能发明先贤旨意，溯流徂源，论著讲介卓然自为一家者，惟广汉张氏敬夫、东莱吕氏伯恭、新安朱氏元晦而已。","book":"宋·周密《齐东野语·道学》"},"similar":["溯流从源","寻根究底"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":29879,"word":"溯流求源","pinyin":"sù liú qiú yuán","abbr":"slqy","explanation":"比喻寻究事物的起始演变。同“溯流穷源”。","source":{"text":"夫善始者未必善终，今不能溯流求源，明法正俗，育材兴化，以拯数百千年之祸，仆恐后日之弊，将有不可胜言者矣。","book":"《元史·隐逸列·杜瑛》"},"similar":["溯流穷源"],"usage":"作谓语、宾语；指探求事物的本源"},{"id":29880,"word":"溯流穷源","pinyin":"sù liú qióng yuán","abbr":"slqy","explanation":"溯：逆流而上。往河流上游寻找发源的地方。比喻寻求事物的根源。","source":{"text":"春秋之时，善论姓氏者，鲁有众仲，晋有胥臣，郑有子羽，而其他诸子无称焉。溯流穷源，若斯之难也。","book":"明·谢肇淛《五杂俎·事部二》"},"example":{"text":"故是编所录惟汉人散文，乃唐宋八家专集。俾承学治古文者，先得其津梁，然后可～，尽诸家之精蕴耳。","book":"清·方苞《古文约选序例》"},"similar":["推本溯源","溯源穷流","溯流追源"],"usage":"作谓语、定语；多用于比喻句"},{"id":29881,"word":"溯流而上","pinyin":"sù liú ér shàng","abbr":"sles","explanation":"溯：逆流而上。逆着水流的方向行进。","source":{"text":"兴世乃令轻舸溯流而上，旋复回还，一二日中，辄复如此，使贼不为之备。","book":"《尔雅·释水》：“逆流而上曰溯洄，顺流而下曰溯游。”《宋书·张兴世传》"},"example":{"text":"只见一只官船～，船头站著四五个人，喜笑歌唱，甚是得意。","book":"明·冯梦龙《醒世恒言》卷六"}},{"id":29882,"word":"溯流追源","pinyin":"sù liú zhuī yuán","abbr":"slzy","explanation":"犹溯流穷源。比喻寻究事物的起始演变。","source":{"text":"觉得这封信，含蕴深厚，溯流追源，就得考虑整个诗歌的历史。","book":"《诗刊》1978年第1期"},"similar":["溯流穷源"],"usage":"作谓语、定语；多用于比喻句"},{"id":29883,"word":"溯源穷流","pinyin":"sù yuán qióng liú","abbr":"syql","explanation":"溯：逆流而上；源：河流发源的地方。原指逆流而上探寻河流的源头。现比喻探究和追溯事物的原由。","source":{"text":"故是编所录惟汉人散文，乃唐宋八家专集。俾承学治古文者，先得其津梁，然后可溯流穷源，尽诸家之精蕴耳。","book":"清·方苞《古文约选序例》"},"example":{"text":"世臣创明北朝书派，～，为一家之学。","book":"《清史稿·杨沂孙传》"},"similar":["溯流穷源"],"usage":"作谓语、定语；多用于比喻句"},{"id":29884,"word":"溯端竟委","pinyin":"sù duān jìng wěi","abbr":"sdjw","explanation":"指寻求事情从头到尾的经过。","source":{"text":"故欲语一学问之沿革，不可不上下千古，溯端竟委，观前此萌达之迹，为将来进步之阶。","book":"梁启超《格致学沿革考略》导言"},"similar":["穷源竟委","追根溯源"],"usage":"作谓语、宾语、定语；指追根溯源"},{"id":29885,"word":"溺心灭质","pinyin":"nì xīn miè zhì","abbr":"nxmz","explanation":"指淹没天然的心性，掩盖纯朴的本质。","source":{"text":"文灭质，博溺心。","book":"语出《庄子·缮性》"},"example":{"text":"仆之驰骛于博杂也久矣。近稍知向里，自悟～之为病。乃欲发愤而刊落之，然亦自悔其岁月之晚矣。","book":"明唐顺之《与莫子良主事》"},"usage":"作谓语、定语；指伪装自己"},{"id":29886,"word":"溺爱不明","pinyin":"nì ài bù míng","abbr":"nabm","explanation":"溺爱：十分宠爱。形容对子孙或晚辈过分宠爱，看不到他们的缺点。","source":{"text":"溺爱者不明","book":"西汉·戴圣《礼记·大学》：“人莫知其子之恶”朱熹注"},"example":{"text":"或夫子～，而遂许巢、许与夔、龙接席耶？","book":"清·袁枚《小仓山房尺牍》"},"usage":"作谓语、宾语；用于长辈对晚辈等"},{"id":29887,"word":"滂沱大雨","pinyin":"páng tuó dà yǔ","abbr":"ptdy","explanation":"滂沱：大雨的样子。形容雨下得很大。","source":{"text":"月离于毕，俾滂沱矣。","book":"《诗·小雅·渐渐之石》"},"example":{"text":"只见～，一似瓢泼盆倾，下有半个时辰。","book":"明·许仲琳《封神演义》第十回"},"similar":["倾盆大雨"],"usage":"作主语、宾语；形容雨下得很大"},{"id":29888,"word":"滂渤怫郁","pinyin":"páng bó fú yù","abbr":"pbfy","explanation":"滂渤：水势怒激的样子；怫：形容忧愁或愤怒；怫郁：郁闷。指波涛激荡的情景。","source":{"text":"观其两傍，则滂渤怫郁，暗漠感突，上击下律。","book":"汉·枚乘《七发》"}},{"id":29889,"word":"滋蔓难图","pinyin":"zī màn nán tú","abbr":"zmnt","explanation":"本指野草滋生，难以消除。后以之比喻势力扩大了再要消灭它就很困难。","source":{"text":"[祭仲]对曰：‘姜氏何厌之有？不如早为之所；无使滋蔓，蔓，难图也。蔓草犹不可除。况君之宠弟乎。’","book":"《左传隐公元年》"},"example":{"text":"若不别进用贤臣，臣恐危乱之萌，将来～也。","book":"宋要焘《续资治通鉴长编·真宗咸平五年》"},"similar":["孳蔓难图"],"usage":"作宾语、定语；指要防患未然"},{"id":29890,"word":"滑天下之大稽","pinyin":"huá tiān xià zhī dà jī","abbr":"htxzdj","explanation":"强调事情非常滑稽可笑（带讽刺意味）。","source":{"text":"不但唱工，单是黑头涎脸扮丑脚，丑脚挺胸学黑头，戏场上只见白鼻子的和黑脸孔的丑脚多起来，也就滑天下之大稽。","book":"鲁迅《花边文学·小品文的生机》"},"example":{"text":"你们只是个客边，怎么倒要他们来作主呢？这岂不是～。","book":"张天翼《速写三篇·谭九先生的工作》"},"similar":["滑稽可笑"],"usage":"作谓语；强调事情非常滑稽可笑"},{"id":29891,"word":"滑头滑脑","pinyin":"huá tóu huá nǎo","abbr":"hthn","explanation":"形容人狡诈、不诚实。也指圆滑，不肯负责任。","example":{"text":"他长得～的。"},"similar":["贼头滑脑"],"usage":"作谓语、状语、定语；指人圆滑"},{"id":29892,"word":"滑泥扬波","pinyin":"gǔ ní yáng bō","abbr":"hnyb","explanation":"滑：同“淈”，搅浑，搞乱；扬波：激起波涛。把泥水搅浑，激起波浪。比喻随波逐流，不知自洁。","source":{"text":"圣人不凝滞于物，而能与世推移，世人皆浊，何不淈其泥而扬其波。","book":"战国·楚·屈原《楚辞·渔父》"},"example":{"text":"～，偷荣求利。","book":"《后汉书·袁绍传》"},"similar":["淈泥扬波"],"usage":"作谓语、定语；指人没主见"},{"id":29893,"word":"滑稽之雄","pinyin":"gǔ jí zhī xióng","abbr":"hjzx","explanation":"滑稽：古代流酒器，专能注吐酒，后则用双比喻人能言善辩；雄：有杰出才能的人。旧时指诙谐善辩，口才超群的人。","source":{"text":"首阳为拙，柱下为工，饱食安步，以仕为农，依隐玩世，诡时不逢，其滑稽之雄乎？","book":"《汉书·东方朔传》"}},{"id":29894,"word":"滓秽太清","pinyin":"zǐ huì tài qīng","abbr":"zhtq","explanation":"滓秽：玷污，污辱；太清：天空。污染天空，比喻玷污清白。","source":{"text":"太傅因戏谢曰：‘卿居心不净，乃复强滓秽太清邪？’","book":"南朝·宋·刘义庆《世说新语·言语》"},"usage":"作谓语、宾语；指人玷污清白"},{"id":29895,"word":"滔天之势","pinyin":"tāo tiān zhī shì","abbr":"ttzs","explanation":"滔天：漫天。形容势力极大。","source":{"text":"股肱非挑战之秋，刘石有滔天之势，疗饥中断，婴戈外绝，两京沦狄，再驾徂戎。","book":"《晋书·孝愍帝纪论》"}},{"id":29896,"word":"滔天之罪","pinyin":"tāo tiān zhī zuì","abbr":"ttzz","explanation":"形容罪恶极大。","source":{"text":"稍正滔天之罪，永为垂世之规。","book":"宋·苏轼《吕惠卿责授建宁军节度副使本州安置不得签书公事》"},"example":{"text":"内贪淫欲，～，理合法更凌迟。","book":"明·罗贯中《风云会》第四折"},"similar":["弥天大罪"],"usage":"作宾语；比喻罪恶极大"},{"id":29897,"word":"滔天大祸","pinyin":"tāo tiān dà huò","abbr":"ttdh","explanation":"滔天：漫天。形容遭到了极大的灾祸。","source":{"text":"白玉堂年幼无知，惹下滔天大祸，致干圣怒，理应罪民寻找擒拿到案。任凭圣上天恩，相爷的垂照。","book":"清·石玉昆《三侠五义》第四十五回"},"example":{"text":"这一下惹出了～。杂种们将我抓进承奉公馆，吊起来打了半天。","book":"姚雪垠《李自成》第二卷第四十五章"}},{"id":29898,"word":"滔天大罪","pinyin":"tāo tiān dà zuì","abbr":"ttdz","explanation":"滔天：漫天。比喻罪恶极大。","source":{"text":"这两种错误，都是滔天大罪的性质，都是和敌人汉奸毫无区别的，你们必须纠正这些错误。","book":"毛泽东《质问国民党》"},"example":{"text":"你犯下了如此～，将难逃法律的严厉制裁。"},"similar":["滔天罪行"],"usage":"作宾语、定语；指罪大"},{"id":29899,"word":"滔天罪行","pinyin":"tāo tiān zuì xíng","abbr":"ttzx","explanation":"滔天：漫天。弥天的大罪。比喻罪恶极大。","source":{"text":"稍正滔天之罪，永为垂世之规。","book":"宋·苏轼《吕惠卿责授建宁军节度副使本州安置不得签书公事》"},"example":{"text":"“九·一八”事变后，日本侵略军对中国人民犯下了～。"},"similar":["滔天大罪"],"usage":"作主语、宾语、定语；指罪大"},{"id":29900,"word":"滔滔不尽","pinyin":"tāo tāo bù jìn","abbr":"ttbj","explanation":"比喻像流水一样连续不断。同“滔滔不竭”。","source":{"text":"与客谈中州文献，滔滔不尽。","book":"《清史稿·傅山传》"},"similar":["滔滔不断","滔滔不竭"],"usage":"作定语、状语；用于说话等"},{"id":29901,"word":"滔滔不息","pinyin":"tāo tāo bù xī","abbr":"ttbx","explanation":"滔滔：波浪滚滚涌动，连续不断的样子。象流水那样毫不间断，永不停息。指话很多，说个不停。","source":{"text":"其深无极，悠悠既凑，滔滔不息。","book":"《乐府诗集·郊庙歌辞·积善舞》：“饮福胙，舞降歌迎。滔滔不竭，洪惟水行。”南朝·梁·简文帝《大壑赋》"},"example":{"text":"他俩人伫立在阁上，面对～的汀江既有对往事的几多感慨，又有对未来的无限踌躇。","book":"王运朝《井冈风云录》第一部第十章"}},{"id":29902,"word":"滔滔不断","pinyin":"tāo tāo bù duàn","abbr":"ttbd","explanation":"比喻像流水一样连续不断。","source":{"text":"［安老先生］将作了个破题儿，又早被姑娘接过话来，滔滔不断的一套，把他四位凑起来二百多周儿、商量了将及一年的一个透鲜的招儿，说了个隔肠如见！","book":"清·文康《儿女英雄传》第二十五回"},"example":{"text":"我一心只想翡翠镯子，那知青钿妹妹同他们谈论算法，～，再也说不完。","book":"清·李汝珍《镜花缘》第七十九回"},"similar":["滔滔不竭","滔滔不绝"],"usage":"作状语、定语；形容话多"},{"id":29903,"word":"滔滔不穷","pinyin":"tāo tāo bù qióng","abbr":"ttbq","explanation":"滔滔：波浪滚滚涌动，连续不断的样子。象流水那样毫不间断。指话很多，说个不停。","source":{"text":"饮福胙，舞降歌迎。滔滔不竭，洪惟水行。","book":"《乐府诗集·郊庙歌辞·积善舞》"},"example":{"text":"老板嘴里吊着旱烟管，～地对我讲，无非是近年来生意不好，身子也一年一年的不成啦之类。","book":"俞平伯《人生不过如此·梦记》"}},{"id":29904,"word":"滔滔不竭","pinyin":"tāo tāo bù jié","abbr":"ttbj","explanation":"比喻像流水一样连续不断。","source":{"text":"饮福受胙，舞降歌迎，滔滔不竭，洪惟水行。","book":"《乐府诗集·郊庙歌辞十二·积善歌》"},"example":{"text":"张九龄善谈论，每与宾客议论经旨，～，如下阪走丸也。","book":"五代·王仁裕《开元天宝遗事·走丸之辩》"},"similar":["滔滔不断","滔滔不绝"],"usage":"作状语、定语；形容话多","story":["唐朝时期，中书侍郎张九龄负责吏部选拔人才，他主张不循资格用人，设十道采访使，受到皇帝的赞许。他不但能很好地协助皇帝处理政务，而且是有才的诗人。他能言善辩，每当谈论经书时总是滔滔不绝，像下阪走丸一样毫无阻碍"]},{"id":29905,"word":"滔滔不绝","pinyin":"tāo tāo bù jué","abbr":"ttbj","explanation":"滔滔：形容流水不断。象流水那样毫不间断。指话很多，说起来没个完。","source":{"text":"张九龄善谈论，每与宾客议论经旨，滔滔不竭，如下阪走丸也。","book":"五代后周·王仁裕《开元天宝遗事·走丸之辩》"},"example":{"text":"斡离不得汪豹献了李刘隘口，无人阻当，～，把十万大兵尽数渡了黄河。","book":"清·陈忱《水浒后传》第二十回"},"similar":["源源不断"],"opposite":["张口结舌","哑口无言"],"usage":"作状语、定语；形容话多","story":["唐朝时期，中书侍郎张九龄负责吏部选拔人才，他主张不循资格用人，设十道采访使，受到皇帝的赞许。他不但能很好地协助皇帝处理政务，而且是有才的诗人。他能言善辩，每当谈论经书时总是滔滔不绝，像下阪走丸一样毫无阻碍"]},{"id":29906,"word":"滔滔汩汩","pinyin":"tāo tāo gǔ gǔ","abbr":"ttgg","explanation":"滔滔：形容流水不断；汩汩：水流动的声音或样子。比喻说话连续不断。","source":{"text":"说罢，又把题诗的人名字，屈着手指头数出来，说了许多甚么生，甚么主人，甚么居士，甚么词人，甚么词客，滔滔汩汩，数个不了。","book":"清·吴趼人《二十年目睹之怪现状》第三十三回"},"example":{"text":"大家一听到提起火烧的事，言语好像开了闸，～泻个不歇。","book":"叶圣陶《四三集·一桶水》"},"similar":["滔滔不绝","滔滔滚滚"],"usage":"作定语、状语；多用于说话"},{"id":29907,"word":"滔滔滚滚","pinyin":"tāo tāo gǔn gǔn","abbr":"ttgg","explanation":"大水奔流的样子。常比喻说话连续不断。亦比喻声势浩大。","source":{"text":"他便把他父亲怎的半生攻苦，才得了个榜下知县……一五一十、从头至尾、本本源源、滔滔滚滚的对那女子哭诉了一遍。","book":"清·文康《儿女英雄传》第五回"},"example":{"text":"像这般～的潮流，实非现在资本家的政府所能防遏得住的。 ◎李大钊《Bolshevism的胜利》"}},{"id":29908,"word":"滔滔者天下皆是","pinyin":"tāo tāo zhě tiān xià jiē shì","abbr":"ttztxjs","explanation":"洪水弥漫，到处都是。比喻社会普遍纷乱。也比喻某种低下的人或不好的风气到处都是。","source":{"text":"滔滔者天下皆是也，而谁以易之？且而与其从辟人之士也，岂若从辟世之士哉！","book":"《论语·微子》"},"example":{"text":"～也，世无知我，我辈终于埋没，尚有何说！","book":"清·俞万春《荡寇志》第一百二回"},"similar":["天下滔滔"],"usage":"作谓语、定语；用于书面语"},{"id":29909,"word":"滕屠郑酤","pinyin":"téng tú zhèng gū","abbr":"ttzg","explanation":"屠：屠夫；酤：卖酒的人。旧时泛指鄙俗的人。","source":{"text":"王荆公素不乐滕元发、郑毅夫，目为滕屠郑酤。","book":"宋·陆游《老学庵笔记》卷七"}},{"id":29910,"word":"滕缄扃鐍","pinyin":"téng jiān jiōng jué","abbr":"tjjj","explanation":"滕、缄：绳子；扃、鐍：箱柜上加锁的关钮。将紧锁的箱柜用绳索捆绑起来以防盗贼。后比喻固守政策。","source":{"text":"为胠箧探囊之盗而为守备，则必摄缄縢，固扁鐍，此世俗之所谓知也。","book":"《庄子·胠箧》"}},{"id":29911,"word":"滕薛争长","pinyin":"téng xuē zhēng zhǎng","abbr":"txzz","explanation":"滕侯与薛侯争夺席位。指争夺尊位或首位。","source":{"text":"十一年春，滕侯、薛侯来朝，争长。","book":"春秋·鲁·左丘明《左传·隐公十一年》"},"usage":"作宾语、定语；指争斗","story":["公元前712年，姬姓滕侯与任姓薛侯同去鲁国朝见鲁隐公，两人都争着排在前头为长。薛侯认为他的祖先分封在前应排在前头，滕侯认为自己是皇族姓应排首位。鲁隐公派羽父去劝说薛侯，薛侯同意让滕侯居上"]},{"id":29912,"word":"滚汤泼雪","pinyin":"gǔn tāng pō xuě","abbr":"gtpx","explanation":"滚：液体沸腾；汤：开水。沸水倒在冰雪上，雪很快就溶化。形容极为容易。","example":{"text":"让他来办这件事简直就是～一般。"},"similar":["滚汤浇雪"],"usage":"作宾语、定语；用于比喻句"},{"id":29913,"word":"滚汤浇雪","pinyin":"gǔn tāng jiāo xuě","abbr":"gtjx","explanation":"滚：液体沸腾；汤：开水。沸水倒在冰雪上，雪很快就溶化。形容极为容易，必然成功。","source":{"text":"那一肚皮家里怀来的恶意，如滚汤浇雪一般……心中把那恼怒都又变了可怜。","book":"清·西周生《醒世姻缘传》第40回"},"similar":["滚汤泼雪"],"opposite":["滚芥投针"],"usage":"作宾语、定语；用于比喻句"},{"id":29914,"word":"滚滚当潮","pinyin":"gǔn gǔn dāng cháo","abbr":"ggdc","explanation":"相继不断地掌握政权。","example":{"text":"中国历史上～的农民政权大部分都是昙花一现。"},"similar":["滚滚当道"],"usage":"作谓语、定语；用于书面语"},{"id":29915,"word":"滚滚滔滔","pinyin":"gǔn gǔn tāo tāo","abbr":"ggtt","explanation":"连续不绝的样子。","example":{"text":"昔日～的河水已经不复存在，只留下干涸的河道。"},"similar":["滔滔不绝"],"usage":"作状语、定语；形容话多"},{"id":29916,"word":"滚滚而来","pinyin":"gǔn gǔn ér lái","abbr":"ggel","explanation":"滚滚：指滔滔流水。形容波涛汹涌连续不断。比喻事物、言谈等连续不断。","source":{"text":"无边落木萧萧下，不尽长江滚滚来。","book":"唐·杜甫《登高》诗"},"example":{"text":"甄龙友日常问一答十，问十答百之口，～，不知此时怎么就……一句也答不出来。","book":"明·周楫《西湖二集·巧书生金銮失对》"},"usage":"作谓语；指来势状态"},{"id":29917,"word":"滚瓜流水","pinyin":"gǔn guā liú shuǐ","abbr":"ggls","explanation":"形容说话极其熟练、流利。","source":{"text":"他得意地哈了一声就滚瓜流水地一口气说道：‘说是男女在那件事上也该平等。’","book":"茅盾《霜叶红似二月花》五"},"similar":["滚瓜烂熟","滚瓜溜油"],"usage":"作定语、状语；用于说话等"},{"id":29918,"word":"滚瓜溜圆","pinyin":"gǔn guā liū yuán","abbr":"ggly","explanation":"指非常圆，滚圆。","source":{"text":"他养的猪头头～。"},"example":{"text":"他养的猪头头～"},"usage":"作谓语、定语、状语；用于口语"},{"id":29919,"word":"滚瓜溜油","pinyin":"gǔn guā liū yóu","abbr":"ggly","explanation":"形容背得非常熟练。","source":{"text":"做的有枝有叶，念的滚瓜溜油。","book":"清·蒲松龄《东郭外传》"},"similar":["滚瓜烂熟","滚瓜流水"],"usage":"作定语、状语；用于说话等"},{"id":29920,"word":"滚瓜烂熟","pinyin":"gǔn guā làn shú","abbr":"ggls","explanation":"象从瓜蔓上掉下来的瓜那样熟。形容读书或背书流利纯熟。","source":{"text":"十一二岁就讲书、读文章，先把一部王守溪的稿子读的滚瓜烂熟。","book":"清·吴敬梓《儒林外史》第十一回"},"example":{"text":"曹寅从小对唐诗就背得～。","book":"端木蕻良《曹雪芹》四"},"similar":["倒背如流","驾轻就熟"],"opposite":["半生半熟","吞吞吐吐"],"usage":"作补语、定语、状语；指读书方面"},{"id":29921,"word":"滚芥投针","pinyin":"gǔn jiè tóu zhēn","abbr":"gjtz","explanation":"滚动芥耔把针投到小孔里。比喻事情进展缓慢，成效很小。","source":{"text":"修行虽是滚芥投针，……弟子情愿在山苦行。","book":"明·许仲琳《封神演义》第十五回"},"opposite":["滚汤浇雪"],"usage":"作宾语、定语；用于做事"},{"id":29922,"word":"滚雪球","pinyin":"gǔn xuě qiú","abbr":"gxq","explanation":"雪球在雪中滚动，越滚越大。比喻越活动越发展的事物。","example":{"text":"我们用～的办法逐步积累资金。"},"usage":"作宾语、定语；用于事物等"},{"id":29923,"word":"滚鞍下马","pinyin":"gǔn ān xià mǎ","abbr":"gaxm","explanation":"迅速地离开鞍子跳到马下。","source":{"text":"良久，见一员小将，白袍银铠，滚鞍下马。","book":"明·罗贯中《三国演义》第八十一回"},"example":{"text":"关官一冲向前，看见了老子的脸，就惊叫了一声，即刻～，打着拱。","book":"鲁迅《出关》"},"usage":"作谓语；指下马"},{"id":29924,"word":"满不在乎","pinyin":"mǎn bù zài hū","abbr":"mbzh","explanation":"满：全；在乎：在意。丝毫不在意。形容对事情一点也不重视。","source":{"text":"区区一条生命，在他们眼里，正和一根草，一堆马粪一般，是满不在乎的！","book":"朱自清《执政府大屠杀记》"},"example":{"text":"交代了几句话，～地随苏沛霖到了朱家。","book":"周而复《上海的早晨》第一部"},"similar":["漫不经心","无动于衷","若无其事"],"opposite":["郑重其事"],"usage":"作宾语、状语；形容丝毫不在意"},{"id":29925,"word":"满不在意","pinyin":"mǎn bù zài yì","abbr":"mbzy","explanation":"全然不放在心上，不当一回事。","source":{"text":"这是一只破旧的提琴，他拿着弓满不在意地拉着。","book":"巴金《复仇集·不幸的人》"},"example":{"text":"这孩子对干什么事都～。"},"similar":["满不在乎"],"opposite":["郑重其事"],"usage":"作谓语、定语、状语；指不在意"},{"id":29926,"word":"满口之乎者也","pinyin":"mǎn kǒu zhī hū zhě yě","abbr":"mkzhzy","explanation":"满口文言词语。指人物的书呆子气。","source":{"text":"他对人说话，总是满口之乎者也，教人半懂不懂的。","book":"鲁迅《呐喊·孔乙己》"},"example":{"text":"你不要～，别人听不懂。"},"usage":"作谓语、宾语；指书呆子气"},{"id":29927,"word":"满园春色","pinyin":"mǎn yuán chūn sè","abbr":"mycs","explanation":"整个园子里一片春天的景色。比喻欣欣向荣的景象。","source":{"text":"春色满园关不住，一枝红杏出墙来。","book":"宋·叶绍翁《游小园不值》诗"},"example":{"text":"昔日穷乡僻壤，今朝～。","book":"《新华文摘》"},"similar":["春色满园"],"usage":"作宾语、定语；指欣欣向荣的景象"},{"id":29928,"word":"满坐寂然","pinyin":"mǎn zuò jì rán","abbr":"mzjr","explanation":"坐：同“座”，座位。全场静悄悄的。","source":{"text":"但闻屏障中抚尺一下，满坐寂然，无敢哗者。","book":"清·张潮《虞初新志·秋声诗自序》"},"example":{"text":"他的讲演让～。"},"usage":"作状语、定语；形容十分安静"},{"id":29929,"word":"满坐风生","pinyin":"mǎn zuò fēng shēng","abbr":"mzfs","explanation":"座席之间飘来清风，使同座者都能感到。比喻来者神气不凡，光采动人。亦作“满座风生”。","source":{"text":"俄而文皇到来，精彩惊人，长揖而坐，满坐风生，顾盼炜如也。","book":"前蜀·杜光庭《虬髯客传》"},"similar":["满座风生"],"usage":"作谓语、定语、状语；用于书面语"},{"id":29930,"word":"满坑满谷","pinyin":"mǎn kēng mǎn gǔ","abbr":"mkmg","explanation":"充满了谷，充满了坑。形容多得很，到处都是。","source":{"text":"在谷满仓，在坑满坑。","book":"《庄子·天运》"},"example":{"text":"从国家方面设想，～的“坡土”分布在中央和各地政界，政治则更安有清明之一日？（清·梁启超《如何才能完成“国庆”的意见》）"},"similar":["满满当当"],"opposite":["空空如也"],"usage":"作状语；形容数量极多"},{"id":29931,"word":"满城桃李","pinyin":"mǎn chéng táo lǐ","abbr":"mctl","explanation":"桃李：比喻学生。城中到处都有自己的学生。比喻学生很多。","source":{"text":"礼闺新榜动长安，九陌人人走马看。一日声名遍天下，满城桃李属春官。","book":"唐·刘禹锡《宣上人远寄贺礼部王侍郎放榜后诗因而继和》"},"example":{"text":"拂杀官黄春有思，～不能春。","book":"宋·黄庭坚《出礼部试院王才元惠梅花三种皆妙绝戏答三首》其三"},"similar":["桃李满天下"],"usage":"作宾语、定语；用于教师"},{"id":29932,"word":"满城风雨","pinyin":"mǎn chéng fēng yǔ","abbr":"mcfy","explanation":"城里到处刮风下雨。原形容重阳节前的雨景。后比喻某一事件传播很广，到处议论纷纷。","source":{"text":"满城风雨近重阳。","book":"宋·潘大林《题壁》诗"},"example":{"text":"为什么倒弄得闹闹攘攘，～的呢？","book":"鲁迅《花边文学·零食》"},"similar":["沸沸扬扬"],"opposite":["一片祥和"],"usage":"作谓语、定语、状语；用于坏事","story":["北宋时期，江西临川的谢无逸与湖北黄州的潘大临是一对好朋友，他们都是贫寒的诗人，经常鱼来燕往，在信中共同切磋诗艺。一天谢无逸去信问潘最近的诗作。潘刚写好“满城风雨近重阳”就被催田租的打断，没有下文只好单句寄去"]},{"id":29933,"word":"满堂灌","pinyin":"mǎn táng guàn","abbr":"mtg","explanation":"一种填鸭式的教学方法。教师主观地将众多的教学内容在课堂上向学生灌输。","example":{"text":"～的教学方式已经不适应时代的需要了。"},"usage":"作主语、宾语、定语；用于教学等"},{"id":29934,"word":"满堂红","pinyin":"mǎn táng hóng","abbr":"mth","explanation":"比喻各方面都取得好成绩或到处都很兴旺。","source":{"text":"红纸牌儿在当中，点着几对满堂红。","book":"明·洪楩《清平山堂话本·快嘴李翠莲记》"},"example":{"text":"今年我们家真是～，名利双收。"},"usage":"作谓语、定语、宾语；指处处兴旺"},{"id":29935,"word":"满天星斗","pinyin":"mǎn tiān xīng dǒu","abbr":"mtxd","explanation":"星斗：星的总称。布满天空的星星。比喻事情多而杂乱。后形容文章华美。","source":{"text":"雷霆驰号令，星斗焕文章。","book":"唐·杜牧《华清宫三十韵》"},"example":{"text":"淅淅潇潇飞落叶，飘飘荡荡卷浮云。～皆昏昧，遍地尘沙尽洒纷。","book":"明·吴承恩《西游记》第三十七回"},"similar":["满天星"],"usage":"作宾语、定语；用于比喻句"},{"id":29936,"word":"满天飞","pinyin":"mǎn tiān fēi","abbr":"mtf","explanation":"形容到处都是。亦作“满空飞”。","source":{"text":"风威卷荷叶满天飞，火势燎芦林连梗断。","book":"宋·张元《咏雪》：“战退玉龙三百万，败鳞残甲满空飞。” 明·施耐庵《水浒传》第七十九回"},"example":{"text":"却便似战退玉龙三百万，果然如败鳞残甲～。","book":"明·吴承恩《西游记》第四十八回"},"usage":"作谓语、定语、状语；指行踪不定"},{"id":29937,"word":"满山满谷","pinyin":"mǎn shān mǎn gǔ","abbr":"msmg","explanation":"到处都是。形容非常多。","source":{"text":"我们在国民党的党报刊中可以看到满山满谷反对宪政的大作。","book":"邹韬奋《抗战以来·一幕悲喜剧》"},"similar":["漫山遍野"],"usage":"作谓语、定语、状语；形容人或动植物等"},{"id":29938,"word":"满山遍野","pinyin":"mǎn shān biàn yě","abbr":"msby","explanation":"布满山岭田野。形容数量多或范围广。","source":{"text":"他坐镇延安，用红蓝铅笔在地图上乱画，我们就满山遍野乱窜！","book":"杜鹏程《保卫延安》第二章"},"example":{"text":"这时候就像塌了天一样，～都是大人哭孩子叫的声音。"},"similar":["漫山遍野"],"opposite":["寥寥无几"],"usage":"作谓语、定语；形容数量多"},{"id":29939,"word":"满床叠笏","pinyin":"mǎn chuáng dié hù","abbr":"mcdh","explanation":"笏：古代朝见时大臣所执的手板，用以记事，指里指高官。床上堆积着高官所执的手板。比喻家门昌盛，做高官的很多。","source":{"text":"开元中，神庆子琳等皆至大官，群从数十人，趋奏省闼。每岁时家宴，组珮辉映，以一榻置笏，重叠于其上。","book":"《旧唐书·崔神庆传》"}},{"id":29940,"word":"满座风生","pinyin":"mǎn zuò fēng shēng","abbr":"mzfs","explanation":"座席之间飘来清风，使同座者都能感到。形容来客神气不凡。光彩动人。","source":{"text":"俄而文皇来，长揖就坐，神清气朗，满座风生，顾盼伟如也。","book":"唐·张说《虬髯客传》"},"example":{"text":"他不裘不履，自是非常品，～，那更神清朗，果然是异人。","book":"明·张凤翼《红拂记·俊杰知时》"},"similar":["满坐风生"],"usage":"作谓语、定语、状语；用于书面语"},{"id":29941,"word":"满心欢喜","pinyin":"mǎn xīn huān xǐ","abbr":"mxhx","explanation":"形容非常高兴。"},{"id":29942,"word":"满怀信心","pinyin":"mǎn huái xìn xīn","abbr":"mhxx","explanation":"心中充满自信心。","example":{"text":"他～地走向报告大厅。"},"similar":["胸有成竹"],"usage":"作谓语、定语、状语；用于处事"},{"id":29943,"word":"满打满算","pinyin":"mǎn dǎ mǎn suàn","abbr":"mdms","explanation":"全部计算在内。","source":{"text":"孔夫子给子华他们老太太的米，那是行人情，自然给的是串过的细米，那得满打满算。","book":"清·文康《儿女英雄传》第39回"},"example":{"text":"作计划时不能～，要留有余地。"},"opposite":["留有余地"],"usage":"作谓语；指全部计算在内"},{"id":29944,"word":"满招损，谦受益","pinyin":"mǎn zhāo sǔn，qiān shòu yì","abbr":"mzsqsy","explanation":"自满会招致损失，谦虚可以得到益处。","source":{"text":"满招损，谦受益，时乃天道。","book":"《尚书·大禹谟》"},"example":{"text":"君子胜人不以力，有化存焉，化者，诚服之也。故曰：‘～。’","book":"宋·陈师道《拟御诗武举策》"},"similar":["虚怀若谷","一谦自益","益谦亏盈"],"opposite":["妄自尊大","刚愎自用"],"usage":"作补语、宾语、分句；用于劝诫人"},{"id":29945,"word":"满满当当","pinyin":"mǎn mǎn dāng dāng","abbr":"mmdd","explanation":"形容很满的样子。","example":{"text":"王明挑着～的两桶水。"},"similar":["满坑满谷"],"opposite":["空空如也"],"usage":"作定语、状语；指很满"},{"id":29946,"word":"满满登登","pinyin":"mǎn mǎn dēng dēng","abbr":"mmdd","explanation":"极丰富的，富裕的，装得很多的。","example":{"text":"我们的晚餐是～的一篮野餐食品。"},"similar":["满满当当"],"opposite":["空空如也"],"usage":"作定语、状语；形容很丰富"},{"id":29947,"word":"满盘皆输","pinyin":"mǎn pán jiē shū","abbr":"mpjs","explanation":"下棋时走错一步，整个棋就输掉。比喻因受某一局部的影响而使全局归于失败。","source":{"text":"说‘一着不慎，满盘皆输’，乃是说的带全局性的，即对全局有决定意义的一着。","book":"毛泽东《中国革命战争的战略问题》"},"example":{"text":"人有时一招不慎，就会落得～的下场。"},"usage":"作宾语、定语；用于处事"},{"id":29948,"word":"满目凄凉","pinyin":"mǎn mù qī liáng","abbr":"mmql","explanation":"所见的全是凄惨冷落的景象。","source":{"text":"三过黄泛区，走跄踉。川原水洗，城社荒落，满目凄凉。","book":"陈毅《过黄泛区书所见》"},"example":{"text":"城市凋敝，农村破产，～，惨绝人寰。"},"similar":["凄凉满目"],"usage":"作谓语、定语；指凄惨冷落的景象"},{"id":29949,"word":"满目疮痍","pinyin":"mǎn mù chuāng yí","abbr":"mmcy","explanation":"比喻眼前看到的都是灾祸的景象。","source":{"text":"乾坤含疮痍，忧虞何时毕？","book":"唐·杜甫《北征》诗"},"example":{"text":"台风过处，～，给人们的生命财产造成了极大的危害。"},"similar":["疮痍满目"],"usage":"作谓语、宾语、定语；指眼前看到的是灾难"},{"id":29950,"word":"满目荆榛","pinyin":"mǎn mù jīng zhēn","abbr":"mmjz","explanation":"荆：荆条，灌木。榛：树丛。满眼看见的都是荆条和树丛。形容十分荒凉萧条的环境。","source":{"text":"初，蔡贼孙儒、诸葛爽争据洛阳，迭相攻伐，七八年间，都城灰烬，满目荆榛。","book":"《旧五代史·唐书·张全义传》"},"usage":"作谓语、定语；用于书面语"},{"id":29951,"word":"满目萧然","pinyin":"mǎn mù xiāo rán","abbr":"mmxr","explanation":"萧然：冷落的样子。满目是凄凉的景象。","source":{"text":"登斯楼也，则有去国怀乡，忧谗畏讥，满目萧然，感极而悲者矣。","book":"宋·范仲淹《岳阳楼记》"},"similar":["环堵萧然"],"opposite":["满目青山"],"usage":"作谓语、定语；用于凄凉的景象"},{"id":29952,"word":"满目青山","pinyin":"mǎn mù qīng shān","abbr":"mmqs","explanation":"形容景色美好或形势大好。","source":{"text":"禅师愿达南泉去，满目青山万万秋。","book":"宋·释道原《景德传灯录》第十卷"},"example":{"text":"老夫喜作黄昏颂，～夕照明。","book":"叶剑英《八十述怀》"},"opposite":["满目萧然"],"usage":"作宾语、定语；用于风景或形势等"},{"id":29953,"word":"满眼韶华","pinyin":"mǎn yǎn sháo huá","abbr":"mysh","explanation":"韶华：美好的时光，一般指春光。比喻到处都是欣欣向荣的景象。"},{"id":29954,"word":"满纸空言","pinyin":"mǎn zhǐ kōng yán","abbr":"mzky","explanation":"满纸都是废话。形容文章空洞，毫无内容。","source":{"text":"若二三文人，假一题目，互相研究，满纸空言，何以谓之扰乱治安？","book":"张庸《章太炎先生问答》"},"example":{"text":"这样～的文章坚决不能发表。"},"similar":["空话连篇"],"usage":"作宾语、定语；用于文章"},{"id":29955,"word":"满而不溢","pinyin":"mǎn ér bù yì","abbr":"meby","explanation":"器物已满盈但不溢出。比喻有资财而不浪用，有才能而不自炫，善于节制守度。","source":{"text":"高而不危，所以长守贵也，满而不溢，所以长守富也。","book":"《吕氏春秋·察微》"},"example":{"text":"制节谨度，～。","book":"《后汉书·光武帝纪上》"},"usage":"作谓语、定语；指人谦虚"},{"id":29956,"word":"满肚疑团","pinyin":"mǎn dù yí tuán","abbr":"mdyt","explanation":"疑团：弄不清的问题。形容心里充满了疑问。","source":{"text":"弄得宝玉满肚疑团，没精打采，归至怡红院中。","book":"清·曹雪芹《红楼梦》第87回"},"example":{"text":"她没有办法来解决这～。"},"similar":["满腹疑团"],"usage":"作宾语、定语、状语；用于莫明其妙时","story":["妙玉来大观园探望惜春，贾宝玉自作多情要去送妙玉，两人来到弯弯曲曲的园内小路上，听到潇湘馆内传来叮咚的琴声，两人坐在石头上听这凄惨悠扬的琴声，突然琴弦断了。妙玉要回寺庙，弄得宝玉满肚疑团，没精打采地回到怡红院中"]},{"id":29957,"word":"满脸春色","pinyin":"mǎn liǎn chūn sè","abbr":"mlcs","explanation":"比喻满脸充满喜悦的笑容。","source":{"text":"谈话自然又热闹起来，刚才发牢骚的朱吟秋和陈君宜也是满脸春色。","book":"茅盾《子夜》"},"example":{"text":"他～，这事准没问题。"},"similar":["满脸春风"],"opposite":["愁眉苦脸"],"usage":"作谓语、宾语；指心情好"},{"id":29958,"word":"满脸春风","pinyin":"mǎn liǎn chūn fēng","abbr":"mlcf","explanation":"形容心情喜悦，满脸笑容。","source":{"text":"早见那位钦差顶冠束带满脸春风的迎出舱来。","book":"清·文康《儿女英雄传》第13回"},"example":{"text":"她慌慌张张接着被子，笑得～。","book":"李准《李双双小传·春笋》"},"similar":["满面春风"],"opposite":["愁眉苦脸"],"usage":"作谓语、定语、状语；指心情好"},{"id":29959,"word":"满脸生花","pinyin":"mǎn liǎn shēng huā","abbr":"mlsh","explanation":"满脸高兴的样子。","example":{"text":"他的同学高兴时是～。"},"similar":["满面春风"],"opposite":["愁眉苦脸"],"usage":"作谓语、状语；指心情好"},{"id":29960,"word":"满腔义愤","pinyin":"mǎn qiāng yì fèn","abbr":"mqyf","explanation":"满腔：充满心中。心中充满对不合理的事情的愤怒。","source":{"text":"那些人满腔义愤，来势汹汹，一进门就捣毁了家具和窗户，走的时候把能带走的财物都拿去了。","book":"马克·吐温《竞选州长》"},"usage":"作谓语、定语；用于愤怒"},{"id":29961,"word":"满腔怒火","pinyin":"mǎn qiāng nù huǒ","abbr":"mqnh","explanation":"满腔：充满心中；怒火：形容极大的愤怒。心里充满着极大的愤怒。","source":{"text":"我们怀着满腔怒火，勇猛地冲上‘391’高地。","book":"《我们的战友邱少云》"},"usage":"作宾语、谓语；用于十分愤怒"},{"id":29962,"word":"满腔悲愤","pinyin":"mǎn qiāng bēi fèn","abbr":"mqbf","explanation":"满腔：充满心中。心中充满悲痛愤怒。","source":{"text":"吴吉昌满腔悲愤，他在家里对老伴激动地说：‘我相信总有一日，会重见青天……’","book":"穆青《为了周总理的嘱托》"},"usage":"作谓语；用于十分悲痛愤怒"},{"id":29963,"word":"满腔热忱","pinyin":"mǎn qiāng rè chén","abbr":"mqrc","explanation":"形容心里充满着热烈诚挚的感情。","source":{"text":"对同志对人民不是满腔热忱，而是冷冷清清，漠不关心，麻木不仁。","book":"毛泽东《纪念白求恩》"},"example":{"text":"对待生活要～、斗志昂扬。"},"similar":["一腔热血","热肠古道"],"opposite":["漠不关心","冷若冰霜"],"usage":"作谓语、定语、状语；指十分热情"},{"id":29964,"word":"满腔热枕","pinyin":"mǎn qiāng rè chén","abbr":"mqrz","explanation":"心里充满热烈真挚的感情。","example":{"text":"他总是满腔热枕地帮助别人。"}},{"id":29965,"word":"满腔热血","pinyin":"mǎn qiāng rè xuè","abbr":"mqrx","explanation":"满腔：充满心中。心中充满为正义而工作的热情。","source":{"text":"吾病难将医药治，耿耿满腔热血，待洒向西风残月。","book":"清·吴伟业《贺新郎·病中有感》"},"similar":["满腔热忱"],"usage":"作主语、宾语；用于正义事业"},{"id":29966,"word":"满腹文章","pinyin":"mǎn fù wén zhāng","abbr":"mfwz","explanation":"比喻文章极好，很有才华。","source":{"text":"他凭着满腹文章七步才，管情取日转千阶。","book":"元·白朴《墙头马上》第二折"},"example":{"text":"他觉得自己～得不到应用。"},"similar":["满腹经纶","满腹诗书"],"usage":"作谓语；指很有才华"},{"id":29967,"word":"满腹牢骚","pinyin":"mǎn fù láo sāo","abbr":"mfls","explanation":"牢骚：抑郁不平之感。一肚子的牢骚。形容心情极为抑郁，很不得意。","source":{"text":"把同情人民不满现实的满腹牢骚曲折地寄托于笔墨之外。","book":"傅抱石《序》"},"example":{"text":"先是～，如今也就渐渐的平和下来。"},"similar":["牢骚满腹"],"usage":"作谓语、定语、状语；指不顺心"},{"id":29968,"word":"满腹狐疑","pinyin":"mǎn fù hú yí","abbr":"mfhy","explanation":"狐疑：象狐狸那样多疑。一肚子的疑惑。比喻疑惑不解的神态。","source":{"text":"宝玉满腹狐疑，只得问道：‘姐姐说是妃子叫我，那妃子究竟是何人？’","book":"清·曹雪芹《红楼梦》第一百十六回"},"example":{"text":"公子听如此说，便不好问，只是未免～。（清·文康《儿女英雄传》第十三回）"},"similar":["满腹疑团"],"usage":"作谓语、定语；指一肚子的疑惑"},{"id":29969,"word":"满腹珠玑","pinyin":"mǎn fù zhū jī","abbr":"mfzj","explanation":"玑：不圆的珠子；珠玑：比喻优美的文章。形容人很有文才。","source":{"text":"只知外貌之粉泽，谁料满腹填珠玑。","book":"唐·杜牧《樊川文集》三：“一杯宽幕席，五字弄珠玑。”宋·吴处厚《表箱杂记》卷八"},"example":{"text":"仁兄～，胸藏锦绣，区区小事，势如反掌。","book":"清·乌有先生《绣鞋记》第八回"}},{"id":29970,"word":"满腹疑团","pinyin":"mǎn fù yí tuán","abbr":"mfyt","explanation":"疑团：许多弄不清的问题。形容心里充满了疑问。","source":{"text":"弄得宝玉满肚疑团，没精打采，归至怡红院中。","book":"清·曹雪芹《红楼梦》第87回"},"example":{"text":"无论他怎样辩解，我们～都得不到解答。"},"similar":["满腹狐疑"],"opposite":["坚信不疑"],"usage":"作谓语、定语、状语；形容心里充满了疑问","story":["妙玉来大观园探望惜春，贾宝玉自作多情要去送妙玉，两人来到弯弯曲曲的园内小路上，听到潇湘馆内传来叮咚的琴声，两人坐在石头上听这凄惨悠扬的琴声，突然琴弦断了。妙玉要回寺庙，弄得宝玉满肚疑团，没精打采地回到怡红院中"]},{"id":29971,"word":"满腹经纶","pinyin":"mǎn fù jīng lún","abbr":"mfjl","explanation":"经纶：整理丝缕，引伸为人的才学、本领。形容人极有才干和智谋。","source":{"text":"云雷屯，君子以经纶。","book":"《周易·屯》"},"example":{"text":"仲老，真佩服，～！这果然是奥妙！","book":"茅盾《子夜》二"},"similar":["才高八斗"],"opposite":["胸无点墨","才疏学浅"],"usage":"作谓语、定语；指有学问"},{"id":29972,"word":"满腹诗书","pinyin":"mǎn fù shī shū","abbr":"mfss","explanation":"比喻博学多才，知识丰富。","source":{"text":"面苍然，鬓皤然，满腹诗书不直钱。官闲常昼眠。","book":"宋·陆游《长相思》词"},"example":{"text":"何老爷一表人才，～，当然是好的。","book":"高阳《状元娘子》六"},"similar":["满腹文章"],"usage":"作谓语；指很有才华"},{"id":29973,"word":"满舌生花","pinyin":"mǎn shé shēng huā","abbr":"mssh","explanation":"比喻能说会道。","source":{"text":"锦囊形容水夫人，能令玉麟发想，变男为女作妾，以听其言语，真词令妙品，满舌生花者。","book":"清·夏敬渠《野叟曝言》第七十二回"},"similar":["能说会道"],"usage":"作谓语、定语；指人会说话"},{"id":29974,"word":"满袖春风","pinyin":"mǎn xiù chūn fēng","abbr":"mxcf","explanation":"衣袖飘曳生风。形容十分得意。","source":{"text":"翰林风月进多才，满袖春风下玉阶。","book":"元·张可久《水仙子》曲"},"similar":["满面春风"],"usage":"作谓语、定语；用于得意时"},{"id":29975,"word":"满谷满坑","pinyin":"mǎn gǔ mǎn kēng","abbr":"mgmk","explanation":"充满了谷，充满了坑。形容多得很，到处都是。","source":{"text":"在谷满仓，在坑满坑。","book":"《庄子·天运》"},"example":{"text":"都是各种的药水，一瓶一瓶的都上了架，登时～起来。","book":"清·吴趼人《二十年目睹之怪现状》第五十五回"},"similar":["满坑满谷"],"usage":"作状语；形容数量极多"},{"id":29976,"word":"满身是胆","pinyin":"mǎn shēn shì dǎn","abbr":"mssd","explanation":"形容胆量大，无所畏惧。","source":{"text":"先主明旦自来，至云营围视昨战处。曰：‘子龙一身都是胆也！’","book":"《三国志·蜀书·赵云传》裴松之注引《赵云别传》"},"example":{"text":"王景宋～，惜欠沉细者，如掞副之，何事不可为也，但恐终以勇败。","book":"《宋史·杨掞传》"}},{"id":29977,"word":"满车而归","pinyin":"mǎn chē ér guī","abbr":"mceg","explanation":"满：满满地；归：返回。东西装得满满地回来。形容收获极丰富。","source":{"text":"然林汝宁向者三任，彼无一任不往，往必满载而归，兹尚未厌足，如饿狗思想隔日屎，乃敢欺我以为游嵩少。","book":"明·李贽《又与焦弱侯》"},"similar":["满载而归"],"usage":"作谓语、定语；指收获大"},{"id":29978,"word":"满载而归","pinyin":"mǎn zài ér guī","abbr":"mzeg","explanation":"载：装载；归：回来。装得满满地回来。形容收获很大。","source":{"text":"然林汝宁向者三任，彼无一任不往，往必满载而归。","book":"明·李贽《焚书·又焦弱侯》"},"example":{"text":"将卫国府库，及民间存留金粟之类，劫掠一空，堕其城郭，～。","book":"明·冯梦龙《东周列国志》第二十三回"},"similar":["满载而回"],"opposite":["一无所获","空手而归"],"usage":"作谓语、定语；指收获大"},{"id":29979,"word":"满门抄斩","pinyin":"mǎn mén chāo zhǎn","abbr":"mmcz","explanation":"投没财产，杀戮全家。","source":{"text":"看你抓进县里去杀头，——满门抄斩，——嚓！嚓！","book":"鲁迅《呐喊·阿Q正传》"},"example":{"text":"曹操将他家～。"},"similar":["斩尽杀绝"],"usage":"作谓语、宾语；指杀戮全家"},{"id":29980,"word":"满门英烈","pinyin":"mǎn mén yīng liè","abbr":"mmyl","explanation":"满门：全家；英烈：英雄人物。全家人都是英雄人物。","example":{"text":"贺龙一家可以说是～，大姐贺民英、二姐贺戊姐在战斗中壮烈牺牲……","book":"魏白《一野十大虎将传奇·西北英豪——中将廖汉生》"}},{"id":29981,"word":"满面含春","pinyin":"mǎn miàn hán chūn","abbr":"mmhc","explanation":"比喻心情喜悦舒畅，满脸笑容。","source":{"text":"那女子才回过头来满面含春的向安公子道：‘尊客，这石头放在哪里？’","book":"清·文康《儿女英雄传》第四回"},"similar":["满面春风"],"opposite":["愁眉不展"],"usage":"作谓语、定语、状语；用于人高兴时"},{"id":29982,"word":"满面征尘","pinyin":"mǎn miàn zhēng chén","abbr":"mmzc","explanation":"形容旅途奔波，忙碌劳累。"},{"id":29983,"word":"满面春风","pinyin":"mǎn miàn chūn fēng","abbr":"mmcf","explanation":"春风：指笑容。比喻人喜悦舒畅的表情。形容和蔼愉快的面容。","source":{"text":"满面春风，一团和气，发露胸中书与诗。","book":"宋·程节斋《沁园春》词"},"example":{"text":"只见路旁走过两个老者，都是鹤发童颜，～，举止大雅。","book":"清·李汝珍《镜花缘》第十一回"},"similar":["喜气洋洋"],"opposite":["愁眉苦脸","愁眉不展"],"usage":"作谓语、定语、状语；常与“得意洋洋”连用"},{"id":29984,"word":"满面红光","pinyin":"mǎn miàn hóng guāng","abbr":"mmhg","explanation":"满面：整个面部。形容心情舒畅，精神健旺的样子。","source":{"text":"舅兄今日满面红光，必有非常喜事，大约货物定是十分得彩，我们又要畅饮喜酒了。","book":"清·李汝珍《镜花缘》第32回"},"example":{"text":"他满面红光，看样子精神很好。"},"similar":["容光焕发"],"opposite":["面容憔悴"],"usage":"作谓语、定语、状语；形容人精神很好"},{"id":29985,"word":"满面羞惭","pinyin":"mǎn miàn xiū cán","abbr":"mmxc","explanation":"满脸现出了羞愧的表情。","source":{"text":"杨再兴满面羞惭，跪在地下。","book":"清·钱彩《说岳全传》第48回"},"similar":["羞惭满面"],"usage":"作谓语、定语、状语；用于人的表情"},{"id":29986,"word":"满面羞愧","pinyin":"mǎn miàn xiū kuì","abbr":"mmxk","explanation":"羞愧：感到羞耻和惭愧。满脸都表现出羞耻和惭愧的表情。形容因做错事而内疚和惭愧。","source":{"text":"成然满面羞愧，缩颈而退。","book":"明·冯梦龙《东周列国志》第六十九回"},"example":{"text":"杨再兴～，跪在地上。","book":"清·钱彩《说岳全传》第四十八回"}},{"id":29987,"word":"滥吏赃官","pinyin":"làn lì zāng guān","abbr":"llzg","explanation":"滥：贪得。贪污腐化的官吏。","source":{"text":"莫不是滥吏赃官，将民业攘。","book":"明·无名氏《大劫牢》第一折"},"similar":["滥官污吏"],"usage":"作主语、宾语、定语；指贪官"},{"id":29988,"word":"滥官污吏","pinyin":"làn guān wū lì","abbr":"lgwl","explanation":"滥官：贪官。旧称贪财纳贿的官吏。","source":{"text":"只因老夫廉能清正，节操坚刚，谢圣恩可怜，加老夫两淮提刑肃政廉访使之职，随处审囚刷卷，体察滥官污吏容老夫先斩后奏。","book":"元·关汉卿《窦娥冤》第四折"},"example":{"text":"你将那～都杀坏，敕赐金牌势剑吹毛快，与一人分忧，万民除害。","book":"田汉《关汉卿》"},"similar":["贪官污吏","奸官污吏","滥官酷吏"],"opposite":["清正廉明"],"usage":"作主语、宾语、定语；指贪官"},{"id":29989,"word":"滥官酷吏","pinyin":"làn guān kù lì","abbr":"lgkl","explanation":"滥：贪得。贪污腐化和残酷统治的官吏。","source":{"text":"俺哥哥以忠义为主，誓不扰害忠良，单杀滥官酷吏，倚强凌弱之人。","book":"明·施耐庵《水浒传》第86回"},"similar":["滥官污吏"],"usage":"作主语、宾语、定语；多指贪官"},{"id":29990,"word":"滥用职权","pinyin":"làn yòng zhí quán","abbr":"lyzq","explanation":"指过分地或非法地行使自己掌握的权力。","example":{"text":"我们不能～去谋私利。"},"usage":"作谓语、定语；指过分地或非法地行使职权"},{"id":29991,"word":"滥竽充数","pinyin":"làn yú chōng shù","abbr":"lycs","explanation":"滥：失实的，假的。不会吹竽的人混在吹竽的队伍里充数。比喻无本领的冒充有本领，次货冒充好货。","source":{"text":"齐宣王使人吹竽，必三百人。南郭处士请为王吹竽，宣王说之，廪食以数百人。宣王死，湣王立，好一一听之，处士逃。","book":"《韩非子·内储说上》"},"example":{"text":"言调整人事，～，依然如故。","book":"邹韬奋《抗战以来》二七"},"similar":["名不副实","掩人耳目","鱼目混珠"],"opposite":["货真价实","名副其实"],"usage":"作谓语、定语；指混饭吃的人","story":["战国时期，齐国的国王非常喜欢听吹竽合奏，好吃懒做的南郭先生想办法混进了乐队，他不懂装懂、摇头晃脑，装出一幅行家的样子。不久老国王死后，新国王喜欢听吹竽独奏，南郭先生这下心虚了，害怕会露馅就连夜逃出了皇宫"]},{"id":29992,"word":"滥竽自耻","pinyin":"làn yú zì chǐ","abbr":"lyzc","explanation":"没有真才实学却占了一席之位，自己感到有愧。","source":{"text":"使夫怀鼠知惭，滥竽自耻。","book":"南朝·梁·萧纲《与湘东王书》"}},{"id":29993,"word":"滥觞所出","pinyin":"làn shāng suǒ chū","abbr":"lssc","explanation":"觞：酒器；滥觞：使酒杯浮起来。原指江河的发源之处水很小，只能浮起酒杯。后用以指事物的起源。也比喻事物所起源的地方。","source":{"text":"若汉书之立表志，其殆侵官虽局者乎！考其滥觞所出，起于司马氏。","book":"《荀子·子道》：“昔者江出于岷山，其始出也，其源可以滥觞。”唐·刘知己《史通·断根》"}},{"id":29994,"word":"滴如车轴","pinyin":"dī rú chē zhóu","abbr":"drcz","explanation":"滴：水滴，雨点。雨点大如车轴。形容雨大。","source":{"text":"注大洪雨，其滴甚粗或如车轴，或复如杵。","book":"唐·释道世《法苑珠林·劫量》"},"example":{"text":"渐降大雨，～。","book":"《长阿含经》"},"usage":"作宾语、定语；用于形容雨"},{"id":29995,"word":"滴水不漏","pinyin":"dī shuǐ bù lòu","abbr":"dsbl","explanation":"一滴水也不外漏。形容说话、办事非常细致、周密，无懈可击。也形容钱财全部抓在手里，轻易不肯出手。","source":{"text":"又要说得极密处无缝罅，盛水不漏。","book":"宋·朱熹《朱子语类·易三》"},"example":{"text":"这也是王春宇几年江湖上精细，把这宗事，竟安插的～。","book":"清·李绿园《歧路灯》第二十七回"},"similar":["自圆其说","天衣无缝","无懈可击"],"opposite":["破绽百出","自相矛盾","漏洞百出"],"usage":"作谓语、状语、补语；指严密"},{"id":29996,"word":"滴水不羼","pinyin":"dī shuǐ bù chàn","abbr":"dsbc","explanation":"形容十分纯正。","source":{"text":"对付别人要滴水不羼的公理，对自己总还不如虽在阴司里，也还能够寻到一点私情。","book":"鲁迅《无常》"},"example":{"text":"这是～的纯正的米酒。"},"similar":["不折不扣"],"usage":"作定语；指十分纯正"},{"id":29997,"word":"滴水成冰","pinyin":"dī shuǐ chéng bīng","abbr":"dscb","explanation":"水滴下去就结成冰。形容天气十分寒冷。","source":{"text":"严冬冱寒，滴水成冰。","book":"宋·钱易《南部新书》"},"example":{"text":"有一节苦处，任你～的天气，少不得向水孔中洗浣污秽衣服，还要憎嫌洗得不洁净，加一场咒骂。","book":"明·冯梦龙《喻世明言》卷二十七"},"similar":["冰天雪窖","冰天雪地"],"opposite":["骄阳似火","赤日炎炎","风和日丽"],"usage":"作谓语、定语；形容天气非常寒冷"},{"id":29998,"word":"滴水成冻","pinyin":"dī shuǐ chéng dòng","abbr":"dscd","explanation":"滴：液体一点点落下；冻：凝结成冰。水滴下去就结成冰。形容天气十分寒冷。","source":{"text":"严冬冱寒，滴水成冻。","book":"宋·钱易《南部新书》"},"similar":["滴水成冰"],"usage":"作谓语、定语；形容天气非常寒冷"},{"id":29999,"word":"滴水成河","pinyin":"dī shuǐ chéng hé","abbr":"dsch","explanation":"比喻积少成多。","source":{"text":"几年过去，聚少成多，滴水成河，手里以有几块花边了。","book":"周立波《山乡世变》上一"},"similar":["积少成多"],"usage":"作宾语、定语；同“积少成多”"},{"id":30000,"word":"滴水成河，粒米成箩","pinyin":"dī shuǐ chéng hé，lì mǐ chéng luó","abbr":"dschlmcl","explanation":"一滴水一滴水汇集起来能成河，一粒米一粒米聚起来能装满箩。比喻积少成多。"}]
