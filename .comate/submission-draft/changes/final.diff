+[{"id":40001,"word":"衣裳楚楚","pinyin":"yī cháng chǔ chǔ","abbr":"yscc","explanation":"楚楚：鲜明的样子。形容服装整齐漂亮。","source":{"text":"蜉蝣之羽，衣裳楚楚。","book":"《诗经·曹风·蜉蝣》"},"example":{"text":"清·蒲松龄《聊斋志异·胡四相公》：“张如其言，推扉一觑，则内有美少年，相视而笑，～，眉目如画，转眨之间，不复睹矣。”"},"similar":["衣冠楚楚"],"usage":"作谓语、定语；用于书面语"},{"id":40002,"word":"衣裳盟会","pinyin":"yī cháng méng huì","abbr":"ysmh","explanation":"衣：穿。穿着礼服聚会。与“兵车之会”相对而言，指春秋时代诸国之间和好的会议","source":{"text":"若乃衣裳盟会，九合一匡，犹惭德斯礼也。","book":"南朝·梁·江淹《萧让太傅相国齐公十郡九锡表》"},"similar":["衣裳之会"],"usage":"作宾语；用于交往等"},{"id":40003,"word":"衣褐怀宝","pinyin":"yì hè huái bǎo","abbr":"yhhb","explanation":"衣：穿；褐：粗布衣服。外面穿着粗布衣，内心藏有珍宝。比喻人外表朴素而内藏真才。","source":{"text":"东郭先生久待诏公车，贫困饥寒，衣敝，履不完。……及其拜为二千石，佩青緺出宫门，行谢主人。……荣华道路，立名当世。此所谓衣褐怀宝者也。","book":"《史记·滑稽列传》"}},{"id":40004,"word":"衣赭关木","pinyin":"yì zhě guān mù","abbr":"yzgm","explanation":"衣：穿；赭：赭衣，赤褐色的囚衣；关：禁闭；木：三木，古时加在囚犯手脚和颈项上的刑具。穿囚衣，戴刑具。指服刑。","source":{"text":"魏其，大将也。衣赭衣，关三木。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"高尔嘉～，雷电击之。","book":"清·章炳麟《哀陆军学生》"},"usage":"作谓语、定语；用于书面语"},{"id":40005,"word":"衣轻乘肥","pinyin":"yì qīng chéng féi","abbr":"yqcf","explanation":"衣：穿。轻：轻暖的裘衣；肥：肥壮的马。穿着贵重的衣服，驾驭肥壮的马。形容生活奢侈豪华。","source":{"text":"钟会，名公子，以才能贵幸，乘肥衣轻，宾从如云。","book":"《论语·雍也》：“赤之适齐也，乘肥马，衣轻裘。”《三国志·魏书·王粲传》裴松之注引《魏氏春秋》"},"example":{"text":"想为官的前呼后拥，～，有多少荣耀。","book":"元·无名氏《赚蒯通》第二折"},"similar":["衣裘肥马"],"usage":"作谓语、定语；形容富贵奢华"},{"id":40006,"word":"衣钵之传","pinyin":"yī bō zhī chuán","abbr":"ybzc","explanation":"原指佛教徒师父把袈裟和食钵传授给徒弟。泛指前人思想、学问、技能的传授和继承。","source":{"text":"彼中朋友今有几人其趣向成就果能不失前人衣钵之传否？","book":"宋·朱熹《答郑仲礼》"},"example":{"text":"衣钵之传，将在子矣！","book":"《清史稿·朱骏声传》"}},{"id":40007,"word":"衣钵相传","pinyin":"yī bō xiāng chuán","abbr":"ybxc","explanation":"中国禅宗师徒间道法传授，常常举行授与衣钵的仪式。比喻技术、学术的师徒相传。","source":{"text":"昔后魏末，有僧达摩者，本天竺王子，以护国出家，入南海，得禅宗妙法，云自释迦相传，有衣钵为记，世相付授。","book":"《旧唐书·神秀传》"},"example":{"text":"世上既有“缠足大仙”，自然该有“赤足小仙”，这是～，亦非偶然。","book":"清·李汝珍《镜花缘》第六十回"},"similar":["口传心授"],"usage":"作谓语、定语；比喻技术、学术的师徒相传"},{"id":40008,"word":"衣钵相承","pinyin":"yī bō xiāng chéng","abbr":"ybxc","explanation":"中国禅宗师徒间道法传授，常常举行授与衣钵的仪式。比喻技术、学术的师徒相传。","source":{"text":"昔后魏末，有僧达摩者，本天竺王子，以护国出家，入南海，得禅宗妙法，云自释迦相传，有衣钵为记，世相付授。","book":"《旧唐书·神秀传》"},"example":{"text":"由此道者无不各得其所欲而去，～，牢结而不可解。","book":"刘德桂《嘉庆皇帝》第二十节"},"similar":["衣钵相传"],"usage":"作谓语、定语；用于技术、学术等"},{"id":40009,"word":"衣锦之荣","pinyin":"yī jǐn zhī róng","abbr":"yjzr","explanation":"显贵后回归故乡的荣耀。","source":{"text":"然公门之内，须有衣锦之荣。","book":"《周书·令狐整传》"},"example":{"text":"宋·欧阳修《昼锦堂记》：“一介之士，得志当时，而意气之盛，昔人比之～也。”"},"usage":"作宾语；用于书面语"},{"id":40010,"word":"衣锦夜游","pinyin":"yī jǐn yè yóu","abbr":"yjyy","explanation":"穿了锦绣衣裳在夜间出行。比喻虽居官位，却不能使人看到自己的荣耀显贵。同“衣绣夜行”。","source":{"text":"且衣锦夜游，有识不许。","book":"《北史·鹿悆传》"},"similar":["衣锦夜行","衣绣夜行","衣绣夜游"],"usage":"作谓语、定语；指爱炫耀的人"},{"id":40011,"word":"衣锦夜行","pinyin":"yī jǐn yè xíng","abbr":"yjyx","explanation":"锦：有彩色花纹的丝织品。夜里穿着锦绣衣服走路。比喻不能在人前显示荣华富贵。","source":{"text":"富贵不归故乡，如衣锦夜行。","book":"《史记·项羽本纪传》"},"example":{"text":"明·冯梦龙《喻世明言》第21卷：“闻古人有云：‘富贵不归故乡，如～耳。’”"},"similar":["衣绣夜行","衣锦夜行","衣锦夜游"],"opposite":["荣归故里","衣锦还乡"],"usage":"作谓语、定语；指爱炫耀的人"},{"id":40012,"word":"衣锦故乡","pinyin":"yì jǐn gù xiāng","abbr":"yjgx","explanation":"衣：穿。旧指富贵以后穿着华中的衣服回到故乡。含有向乡里夸耀的意思。","source":{"text":"海槎虽定隔天回，衣锦还乡愧不才。","book":"唐·崔致远《酬杨赡秀才送别》"},"example":{"text":"昔人称～，今以本州相授，所以偿功。凉州荒梗，宜有以靖之。","book":"《新唐书·姜谟传》"}},{"id":40013,"word":"衣锦昼游","pinyin":"yī jǐn zhòu yóu","abbr":"yjzy","explanation":"衣：穿。白天身着华贵官服，使人看见。旧时比喻富贵后还乡，向乡亲们夸耀。","source":{"text":"未几，除征北将军，定州刺史，衣锦昼游，在为称满。","book":"《魏书·甄琛传》"},"similar":["衣锦昼行","衣绣昼行"],"usage":"作宾语、定语；用于处事"},{"id":40014,"word":"衣锦昼行","pinyin":"yī jǐn zhòu xíng","abbr":"yjzx","explanation":"穿了锦绣衣裳在白天出行。旧时形容在本乡做官，或在外地做官告老回乡，荣耀异常。同“衣绣昼行”。","source":{"text":"大父康伯，相高宗，值逆亮送死，竭臣子力，赖累圣威灵，幸而破虏。临内禅，特诏定第，自请退休，得守乡社。都人称赞曰：‘所谓衣锦昼行者也。’","book":"宋·叶適《朝请大夫主管冲佑观焕章侍郎陈公墓志铭》"},"similar":["衣锦昼游","衣绣昼游","衣绣昼行"],"opposite":["变服诡行"],"usage":"作宾语、定语；用于处事"},{"id":40015,"word":"衣锦荣归","pinyin":"yī jǐn róng guī","abbr":"yjrg","explanation":"衣：衣服。锦：有多彩图案的丝织品。还乡：回家、探亲。古时指做官以后，穿了锦绣的衣服，回到故乡向亲友夸耀。也说衣锦还乡。","source":{"text":"谢得鲁昭公可怜，赐小官黄金一饼，以充膳母之资，如今衣锦荣归。","book":"明·臧懋循《元曲选·石君宝〈秋胡戏妻〉三》"},"example":{"text":"一年半的工夫，果然乡试连捷，并且探花及第，～了。","book":"清·文康《儿女英雄传》第三十七回"},"similar":["衣锦还乡","叶落归根","荣归故里"],"opposite":["离乡背井"],"usage":"作主语、谓语、宾语；指富贵后回家乡"},{"id":40016,"word":"衣锦褧衣","pinyin":"yī jǐn jiǒng yī","abbr":"yjjy","explanation":"锦衣外面再加上麻纱单罩衣，以掩盖其华丽。比喻不炫耀于人。","source":{"text":"裳锦褧裳，衣锦褧衣。叔兮伯兮，驾予与归。","book":"《诗·卫风·硕人》：“硕人其颀，衣锦褧衣。”又《诗·郑风·丰》"},"example":{"text":"是以～，恶文太章，贲象穷白，贵乎反本。","book":"南朝·梁·刘勰《文心雕龙·情采》"},"usage":"作定语；用于书面语"},{"id":40017,"word":"衣锦过乡","pinyin":"yī jǐn guò xiāng","abbr":"yjgx","explanation":"旧指富贵以后回到故乡。含有向乡里夸耀的意思。","source":{"text":"吾乃送公衣锦过乡邪！","book":"《新唐书·于高张传》"}},{"id":40018,"word":"衣锦还乡","pinyin":"yī jǐn huán xiāng","abbr":"yjhx","explanation":"衣：衣服。锦：有多彩图案的丝织品。还乡：回家、探亲。古时指做官以后，穿了锦绣的衣服，回到故乡向亲友夸耀。也说衣锦荣归。","source":{"text":"卿母年德并高，故令卿衣锦还乡，尽荣养之理。","book":"唐·姚思廉《梁书·刘之遴传》"},"example":{"text":"但愿得你名登高选，～，教人作话传。","book":"明·高则诚《琵琶记·南浦嘱别》"},"similar":["叶落归根","衣锦荣归","荣归故里"],"opposite":["离乡背井"],"usage":"作主语、谓语、宾语；指富贵后回家乡"},{"id":40019,"word":"衣锦食肉","pinyin":"yī jǐn shí ròu","abbr":"yjsr","explanation":"穿锦绣衣裳，吃肉食。形容生活富足。亦借指居官食禄。","source":{"text":"信（韩信）望衣锦食肉，谁指望夺印怀仇，不似芒荡山下累求良士。","book":"《商君书·算地》：“刑人有列，则君子下其位；衣锦食肉，则小人冀其利。”《前汉书平话续集》卷上"},"example":{"text":"《周书·突厥》：“突厥在京师者，又待以优礼，～者，常以千数。”"},"similar":["衣帛食肉","锦衣玉食"],"opposite":["布衣蔬食","粗衣粝食"],"usage":"作谓语、定语；用于书面语"},{"id":40020,"word":"衣食不周","pinyin":"yī shí bù zhōu","abbr":"ysbz","explanation":"周：齐备。形容衣食缺乏，生活困窘。","source":{"text":"我今衣食不周，无力婚娶，何不俯就他家，一举两得？","book":"明·冯梦龙《古今小说》卷二十七"},"example":{"text":"败落了家产，弄得～，那里还要得起媳妇呢。","book":"清·曹雪芹《红楼梦》第六十四回"},"similar":["缺衣少食"],"opposite":["丰衣足食"],"usage":"作谓语、定语、状语；指生活贫困"},{"id":40021,"word":"衣食之谋","pinyin":"yī shí zhī móu","abbr":"yszm","explanation":"维持生活的谋划。","source":{"text":"比坐啼号之迫，浪为衣食之谋。投檄无缘，强颜可笑。","book":"宋·陆九渊《谢参政启》"},"usage":"作宾语；用于生活"},{"id":40022,"word":"衣食住行","pinyin":"yī shí zhù xíng","abbr":"yszx","explanation":"泛指穿衣、吃饭、住房、行路等生活上的基本需要。","source":{"text":"大家都能各尽各的义务，大家自然可以得衣食住行的四种需要。","book":"孙中山《民生主义》第三讲"},"example":{"text":"前后相继约两个世纪，～相互影响，极为显著。","book":"沈从文《中国古代服饰研究·北齐张肃俗墓》"},"usage":"作主语、宾语、定语；指人的基本需要"},{"id":40023,"word":"衣食所安","pinyin":"yī shí suǒ ān","abbr":"yssa","explanation":"安：养；所安：养生的东西。衣食这类养生的东西。","source":{"text":"衣食所安，弗敢专也，必以分人。","book":"春秋·鲁·左丘明《左传·庄公十年》"},"usage":"作宾语、定语；指养生的东西"},{"id":40024,"word":"衣食父母","pinyin":"yī shí fù mǔ","abbr":"ysfm","explanation":"踏入社会都靠父母提供。指生活所依赖的人。","source":{"text":"着甚么南庄田，北庄地，有溜二便是衣食父母。","book":"明·汤显祖《南柯记》"},"example":{"text":"农民是他们的～。他们盼望农民有钱就象他们盼望自己一样。（茅盾《故乡杂记》）"},"usage":"作宾语；指生活所依赖的人"},{"id":40025,"word":"衣食税租","pinyin":"yī shí shuì zū","abbr":"yssz","explanation":"指居官食禄。同“衣租食税”。","source":{"text":"武（武帝）有衡山、淮南之谋，作左官之律，设附益之法，诸侯惟得衣食税租，不与政事。","book":"《汉书·诸侯王表》"},"similar":["衣租食税"],"usage":"作宾语、定语；用于书面语"},{"id":40026,"word":"衣食饭碗","pinyin":"yī shí fàn wǎn","abbr":"ysfw","explanation":"比喻赖以生存的职业或技能等","source":{"text":"俺女孩儿倒也肯嫁他，只是俺这衣食饭碗，如何便割舍得。","book":"元·李行道《灰阑记》楔子"},"usage":"作宾语、定语；用于比喻句"},{"id":40027,"word":"衣香人影","pinyin":"yī xiāng rén yǐng","abbr":"yxry","explanation":"衣服上的香气，人的影子。写女性的气息形体","source":{"text":"日午画船桥下过，衣香人影太匆匆。","book":"清·王士禛《冶春绝句》"},"similar":["衣香鬓影","衣香髻影"],"usage":"作宾语、定语；用于描写女性"},{"id":40028,"word":"衣香髻影","pinyin":"yī xiāng jì yǐng","abbr":"yxjy","explanation":"衣香：衣服上散发出来的香气；髻影：头发的影子。形容妇女的衣着穿戴十分华丽。借指妇女。","source":{"text":"弹琴看文君，春风吹鬓影。","book":"北周·庾信《春赋》：“池中水影悬胜镜，屋里衣香不如花。”唐·李贺《咏怀》诗"},"example":{"text":"有少年观灯，夜归遇少妇甚妍丽，徘徊歧路，若有所待，～，楚楚动人。","book":"清·纪昀《阅微草堂笔记·姑妄听之二》"},"similar":["衣香鬓影"],"usage":"作宾语、定语；用于女性"},{"id":40029,"word":"衣香鬓影","pinyin":"yī xiāng bìn yǐng","abbr":"yxby","explanation":"形容妇女的衣着穿戴十分华丽（多指人多的场合）。借指妇女。","source":{"text":"弹琴看文君，春风吹鬓影。","book":"北周·庾信《春赋》：“屋里衣香不如花。”唐·李贺《咏怀》诗"},"example":{"text":"那红楼画阁，卷上珠帘，二作婵娟，倚栏而望，～，掩映霏微。","book":"清·陈忱《水浒后传》第九回"},"similar":["衣香髻影"],"usage":"作宾语、定语；借指妇女"},{"id":40030,"word":"衣马轻肥","pinyin":"yì mǎ qīng féi","abbr":"ymqf","explanation":"穿着轻暖的皮袍，坐着由肥马驾的车。形容生活的豪华。","source":{"text":"同学少年多不贱，五陵衣马自轻肥。","book":"语出《论语·雍也》：“乘肥马，衣轻裘。”唐·杜甫《秋兴》诗之三"},"example":{"text":"儿子从宦者，有人来云：贫乏不能存，此是好消息；若闻赀货充足，～，此是恶消息。","book":"宋·孔平仲《续世说·贤媛》"},"similar":["衣轻马肥","衣轻乘肥"],"usage":"作谓语、定语；形容富贵奢华"},{"id":40031,"word":"补偏救弊","pinyin":"bǔ piān jiù bì","abbr":"bpjb","explanation":"偏：偏差；弊：赞美。补救偏差漏洞，纠正缺点错误。","source":{"text":"先王之道必有偏而不起之处，故政有眊而不行，举其偏者以补其弊而已也。","book":"《汉书·董仲舒传》"},"example":{"text":"《汉书·董仲舒传》：“先王之道必有偏而不起之处，故政有眊而不行，举其偏者以补其弊而已也。”"},"similar":["补阙拾遗","拨乱反正"],"usage":"作谓语、宾语、定语；用于书面语中"},{"id":40032,"word":"补天柱地","pinyin":"bǔ tiān zhù dì","abbr":"btzd","explanation":"修补天，支撑地。比喻伟大的功勋。","source":{"text":"业类补天，功均柱地。","book":"南朝·梁·陆倕《新陋刻铭》"},"usage":"作定语；指功绩大"},{"id":40033,"word":"补天济世","pinyin":"bǔ tiān jì shì","abbr":"btjs","explanation":"修补苍天，挽回世运。","example":{"text":"女娲有～之功。"},"similar":["女娲补天"],"usage":"作谓语、定语；用于称颂人"},{"id":40034,"word":"补天浴日","pinyin":"bǔ tiān yù rì","abbr":"btyr","explanation":"这是指女娲炼五色石补天和羲和给太阳洗澡两个神话故事。后用来比喻人有战胜自然的能力。也形容伟大的功业。","source":{"text":"有羲和之国，有女子名曰羲和，方日浴于甘渊。","book":"《淮南子·览冥训》：“于是女娲炼五色石以补苍天。”又《山海经·大荒南经》"},"example":{"text":"反听刘隗刁协之徒，窃弄威柄，将我～之功，弃而不录，思之不能无怨也。","book":"明·朱鼎《玉镜合记·新亭流涕》"},"usage":"作定语；用于挽救危险的局面"},{"id":40035,"word":"补天炼石","pinyin":"bǔ tiān liàn shí","abbr":"btls","explanation":"炼：用加热的方法使物质纯净或坚韧。古神话，相传天缺西北，女娲炼五色石补之。比喻施展才能和手段，弥补国家以及政治上的失误。","source":{"text":"往古之时，四极废，九州裂，天下兼覆，地不周载……于是女娲练五色石以补苍天。","book":"汉·刘安《淮南子·览冥训》"},"example":{"text":"～无虚日，忧国如家有几人。","book":"宋·杨万里《送徐送臣监丞补外》诗"}},{"id":40036,"word":"补敝起废","pinyin":"bǔ bì qǐ fèi","abbr":"bbqf","explanation":"补：修整；敝：破旧；起：起用；废：废弃。修整破旧的东西，起用废弃的东西。比喻恢复旧的制度。","source":{"text":"存亡国，继绝世，补敝起废，王道之大者。","book":"《史记·太史公自序》"}},{"id":40037,"word":"补残守缺","pinyin":"bǔ cán shǒu quē","abbr":"bcsq","explanation":"残：残缺，不完整；缺：残破。舍不得扔下残缺陈旧的东西。形容思想保守。","source":{"text":"至于国家大事，则幽冥莫知其原，然犹补残守缺，挟恐见破之私意，而忘服义从善之公心。","book":"汉·荀悦《汉纪·哀帝纪》"},"similar":["抱残守缺"],"opposite":["标新立异"],"usage":"作谓语、宾语、状语；形容人守旧"},{"id":40038,"word":"补漏订讹","pinyin":"bǔ lòu dìng é","abbr":"blde","explanation":"补：补充，填满；讹：错误。补充缺漏，订正错误。","source":{"text":"王板《史记》之外，并博考他书所引，为之补漏订讹，手钞成帖。","book":"清·叶廷琯《吹网录·钞辑史记正义》"},"similar":["补残拾遗"],"usage":"作谓语、宾语、定语；指修正"},{"id":40039,"word":"补牢顾犬","pinyin":"bǔ láo gù quǎn","abbr":"blgq","explanation":"丢失了羊，才修补羊圈；见了野兔，才回头唤狗去追捕。比喻对出现的失误，及时设法补救。","source":{"text":"见兔而顾犬，未为晚也；亡羊而补牢，未为迟也。","book":"语本《战国策·楚策四》"},"example":{"text":"及待开厂制办，～，已觉其迟。","book":"清·左宗棠《请拓增船炮大厂疏》"},"similar":["亡羊补牢"],"usage":"作宾语、定语；指采取措施"},{"id":40040,"word":"补缀乾坤","pinyin":"bǔ zhuì qián kūn","abbr":"bzqk","explanation":"缝补天地，比喻治理国家。","example":{"text":"他有～的才能。"},"usage":"作谓语、定语；指治理国家"},{"id":40041,"word":"补苴罅漏","pinyin":"bǔ jū xià lòu","abbr":"bjxl","explanation":"苴：鞋底的草垫；罅：缝隙。补好裂缝，堵住漏洞。比喻弥补事物的缺陷。","source":{"text":"补苴罅漏，张皇幽眇。","book":"唐·韩愈《进学解》"},"example":{"text":"～，经纬万端。来日之难，培于往昔。","book":"蔡东藩、许廑父《民国通俗演义》第七十七回"},"similar":["补偏救弊","刊谬补缺"],"usage":"作谓语、定语；用于书面语"},{"id":40042,"word":"补苴调胹","pinyin":"bǔ jū tiáo ér","abbr":"bjde","explanation":"补苴：补缀，引申为弥缝；调胹：烹调煮熟。比喻加工使之完美。多用于对文章加工使之提高，或对理论作进一步完美的表述。","source":{"text":"博闻该见有志之士，补苴调胹，冀以就完而力不足，又无可为之地，故终不得。","book":"宋·王安石《涟水军淳化院经藏记》"},"usage":"作谓语；用于文章等"},{"id":40043,"word":"补过拾遗","pinyin":"bǔ guò shí yí","abbr":"bgsy","explanation":"拾遗：纠正帝王的过失。填补、纠正帝王的过失。也指匡正、改掉自己的过失、缺点。","source":{"text":"出入禁闼，补过拾遗，臣之愿也。","book":"《汉书·汲黯传》"},"usage":"作宾语；用于书面语"},{"id":40044,"word":"补过饰非","pinyin":"bǔ guò shì fēi","abbr":"bgsf","explanation":"补过：弥补过失；饰非：文饰过错。指掩饰过错。","source":{"text":"文士笔墨，为人补过饰非，往往如是。","book":"清·袁枚《随园诗话》第16卷"},"similar":["文过饰非"],"usage":"作谓语、定语、宾语；指掩饰过错"},{"id":40045,"word":"补阙拾遗","pinyin":"bǔ quē shí yí","abbr":"bqsy","explanation":"阙：通“缺”，缺失。拾遗：补录遗漏。补录缺失遗漏的内容。","source":{"text":"圣王将举大事，必崇三讯之法，朝置谏官以匡大理，疑承弼以补阙拾遗。","book":"《晋书·张轨传》"},"example":{"text":"其次扬清激浊，能～。","book":"《明史·孙磐传》"},"similar":["拾遗补阙"],"usage":"作谓语、宾语；指补录缺失遗漏的内容"},{"id":40046,"word":"补阙挂漏","pinyin":"bǔ quē guà lòu","abbr":"bqgl","explanation":"阙：缺；漏：遗漏。指弥补事物的缺陷和漏洞。","source":{"text":"至于补阙挂漏，俾臻完善，不能无望于将伯之助云。","book":"清·赵曦明《跋》"},"similar":["补苴罅漏"],"usage":"作谓语、定语；指弥补缺陷"},{"id":40047,"word":"补阙灯檠","pinyin":"bǔ quē dēng qíng","abbr":"bqdq","explanation":"阙：缺；灯檠：灯架。没有灯架，用人充作灯架。旧时讽刺男人惧内。","source":{"text":"冀州儒李大壮畏服小君，万一不遵号令，则叱令正坐，为绾髻，中安灯碗燃灯火，大壮屏气定体，如枯木土偶，人诨目之曰补阙灯檠。","book":"宋·陶谷《清异传》"},"usage":"作谓语、宾语；指男人惧内"},{"id":40048,"word":"表壮不如理壮","pinyin":"biǎo zhuàng bù rú lǐ zhuàng","abbr":"bzbrlz","explanation":"外表好看，不如里面结实。比喻妻子能够治家，就是丈夫的好帮手。","source":{"text":"外表好看，不如里面结实。比喻妻子能够治家，就是丈夫的好帮手。"}},{"id":40049,"word":"表壮不如里壮","pinyin":"biǎo zhuàng bù rú lǐ zhuàng","abbr":"bzbrlz","explanation":"外表好看，不如里面结实。比喻妻子能够治家，就是丈夫的好帮手。","source":{"text":"常言道：‘表壮不如里壮’，嫂嫂把得家定，我哥哥烦恼做什么？","book":"明·施耐庵《水浒传》第24回"},"example":{"text":"常言道：～，这个家多亏了你。"},"opposite":["徒有其表"],"usage":"作宾语、定语；用于口语"},{"id":40050,"word":"表情见意","pinyin":"biǎo qíng jiàn yì","abbr":"bqjy","explanation":"表达感情，申述意见。","source":{"text":"人所以相拜者何，所以表情见意，屈节卑体尊事人者也。","book":"汉·班固《白虎通·姓名》"}},{"id":40051,"word":"表里一致","pinyin":"biǎo lǐ yī zhì","abbr":"blyz","explanation":"犹表里如一。","source":{"text":"苟有谦默自持……叫信乐易，表里一致者，使其人资禀虽甚鲁钝，侪辈之中有弗称慕之者乎？","book":"明·王守仁《教条示龙场诸生》"},"example":{"text":"现在我们要想的对、说的对、写的对，这才是～革命的诗。","book":"续范亭《论诗》"},"similar":["表里如一"],"opposite":["内外有别"],"usage":"作谓语、定语；指人的言行"},{"id":40052,"word":"表里不一","pinyin":"biǎo lǐ bù yī","abbr":"blby","explanation":"表面与内在不一样。","source":{"text":"行见中外曰悫。","book":"《逸周书·谥法解》"},"example":{"text":"我们不能做～的人。"},"similar":["虚有其表","名不副实","徒有虚名"],"opposite":["表里如一","言行一致"],"usage":"作谓语、定语；指内外不一样"},{"id":40053,"word":"表里为奸","pinyin":"biǎo lǐ wéi jiān","abbr":"blwj","explanation":"表里：内外；奸：虚伪狡诈。比喻用勾结、欺诈等不正当手段做坏事。","source":{"text":"弘治初，王虎谷为祠祭郎中，以太监李广交结寿宁侯，表里为奸，特疏请斩广以谢宗庙。","book":"明·沈德符《万历野获编·王虎谷封事》卷十二"},"example":{"text":"那姓周的在库书内，不知亏空了多少银子，他～，凭这个假册子，要来侵吞款项。","book":"清·黄小配《廿载繁华梦》第二十八回"},"similar":["狼狈为奸"],"usage":"作谓语、定语；指互相勾结"},{"id":40054,"word":"表里受敌","pinyin":"biǎo lǐ shòu dí","abbr":"blsd","explanation":"内外受到敌人的攻击。","source":{"text":"城固而众多，攻之必力屈，若有外寇，表里受敌，此危道也。","book":"《三国志·魏书·诸葛诞传》"},"example":{"text":"攻守势殊，未可卒拔，若引日劳师，～，非计也。","book":"《周书·杨忠传》"},"similar":["腹背受敌"],"usage":"作定语、补语；指陷入困境"},{"id":40055,"word":"表里如一","pinyin":"biǎo lǐ rú yī","abbr":"blry","explanation":"表：外表；里：内心。表面和内心象一个东西。形容言行和思想完全一致。","source":{"text":"行之以忠者，是事事要着实，故某集注云：‘以忠，则表里如一。’","book":"南朝·梁·刘勰《文心雕龙·附会》：“首尾周密，表里一体。”《朱子全书·论语》"},"example":{"text":"我言行一致，～。","book":"郭沫若《屈原》第四幕"},"similar":["言行一致","心口如一","说一不二"],"opposite":["言不由衷","口是心非","言行不一"],"usage":"作谓语、定语；形容言行与思想一致"},{"id":40056,"word":"表里山河","pinyin":"biǎo lǐ shān hé","abbr":"blsh","explanation":"表里：即内外。外有大河，内有高山。指有山河天险作为屏障。","source":{"text":"子犯曰：‘战也。战而捷，必得诸侯。若其不捷，表里山河，必无害也。’","book":"《左传·僖公二十八年》"},"example":{"text":"重门杰观屹相望，～自一方。","book":"宋·陈师道《和寇十一晚登白门》"},"similar":["表里河山"],"usage":"作定语、宾语；形容山势陡峭","story":["春秋时期，楚国的军队在嶲地背后驻扎，晋侯担心他们来偷袭晋国，听到童谣“原田每每，舍其旧而新足谋。”晋侯更加担心了。子犯进谏说：“战也！战而捷，必得诸侯；若其不捷，表里山河，必无害也。”晋侯决定依据地势而进攻"]},{"id":40057,"word":"表里相依","pinyin":"biǎo lǐ xiāng yī","abbr":"blxy","explanation":"指关系密切，互相依存。","source":{"text":"三晋者，齐楚之藩蔽，齐楚者，三晋之根柢；形势相资，表里相依。","book":"《资治通鉴·秦始皇二十六年》"},"similar":["表里相济"],"usage":"作谓语、宾语；指关系密切"},{"id":40058,"word":"表里相合","pinyin":"biǎo lǐ xiāng hé","abbr":"blxh","explanation":"内外互相应和。","source":{"text":"左右有水，前有大阜，后有高山，战于雨水之间，乘敌过邑，是谓表里相合。","book":"春秋·吕尚《阴符》"},"similar":["表里相应"],"usage":"作谓语、定语、宾语；指内外配合"},{"id":40059,"word":"表里相应","pinyin":"biǎo lǐ xiāng yìng","abbr":"blxy","explanation":"内外互相应合。","source":{"text":"内外互相应合。"},"example":{"text":"然则元城造成一个言行一致，～，盖自五年从游之久。","book":"宋·文天祥《西涧书院释菜讲义》"},"similar":["表里相合","里应外合","表里相依"],"usage":"作谓语、定语、宾语；指内外配合"},{"id":40060,"word":"表里相济","pinyin":"biǎo lǐ xiāng jì","abbr":"blxj","explanation":"表里：指内外；济：救助。原意是指内外互相庇护。后泛指内外互相救助。","source":{"text":"不有行者，谁捍牧圉，表里相济，实深实重。","book":"晋·桓温《辞参朝政疏》"},"example":{"text":"文贯乎道，仁思义色，～者，其孰能至于此哉？（宋·王安石《上邵学士书》）"},"similar":["表里相应"],"usage":"作谓语、定语；指内外互相补充"},{"id":40061,"word":"表里相符","pinyin":"biǎo lǐ xiāng fú","abbr":"blxf","explanation":"犹表里如一。","source":{"text":"惟三代之学，本诸身心，著于行事，发于文辞，表里相符，华质不爽。","book":"明·方孝孺《五待制私谥议》"},"similar":["表里如一"],"opposite":["表里不一"],"usage":"作谓语、定语、宾语；指内外一致"},{"id":40062,"word":"表面光","pinyin":"biǎo miàn guāng","abbr":"bmg","explanation":"表面上光洁，形容虚有其表。","example":{"text":"这些伪劣产品只是～，一点不经用。"},"similar":["虚有其表"],"usage":"作谓语、宾语、定语；指人或物体"},{"id":40063,"word":"表面文章","pinyin":"biǎo miàn wén zhāng","abbr":"bmwz","explanation":"比喻浮夸或不切实际，敷衍塞责的做法。","source":{"text":"一句话，就是要落在实处。追求表面文章，不讲实际效果、实际效率、实际速度、实际质量、实际成本的形式主义必须制止。","book":"邓小平《在全国科学大会开幕式上的讲话》"},"example":{"text":"他总爱做～。"},"similar":["表面功夫"],"usage":"作宾语、定语；指应付"},{"id":40064,"word":"衮实无阙","pinyin":"gǔn shí wú quē","abbr":"gswq","explanation":"衮衣无缺损。比喻帝王治理无过失。","source":{"text":"衮实无阙者，先皇之德也。","book":"语出《诗·大雅·烝民》：“衮职有阙，维仲山甫补之。”《魏书·李彪传》"}},{"id":40065,"word":"衮衣以归","pinyin":"gǔn yī yǐ guī","abbr":"gyyg","explanation":"指功勋卓著，位拜三公而归。同“衮衣西归”。","source":{"text":"是以有衮衣兮，无以我公归，无使我心悲兮。","book":"相传周公东征，周大夫为作《九罭》之诗，其辞曰：“九罭之鱼鳟鲂，我觏之子，衮衣绣裳。”又曰"},"example":{"text":"绣斧既定，～。","book":"唐·刘禹锡《贺门下裴相公启》"},"similar":["衮衣西归"],"usage":"作谓语、定语；用于书面语"},{"id":40066,"word":"衮衣绣裳","pinyin":"gǔn yī xiù cháng","abbr":"gyxs","explanation":"古代天子祭祀时所穿的绣有龙的礼服，形容衣着华丽奢华。","source":{"text":"我觏之子，衮衣绣裳。","book":"《诗经·豳风·九罭》"},"usage":"作主语、宾语、定语；用于人的生活"},{"id":40067,"word":"衮衣西归","pinyin":"gǔn yī xī guī","abbr":"gyxg","explanation":"谓功勋卓著，位拜三公而归。","source":{"text":"是以有衮衣兮，无以我公归，无使我心悲兮。","book":"相传周公东征，周大夫为作《九罭》之诗，其辞曰：“九罭之鱼鳟鲂，我觏之子，衮衣绣裳。”又曰"},"example":{"text":"卿未照朕心，殊乖素望。新政俟才，宜速铨补；俟东方化洽，当～。","book":"《资治通鉴·晋简文帝咸安元年》"},"similar":["衮衣以归"],"usage":"作谓语、定语；用于书面语"},{"id":40068,"word":"衮衮诸公","pinyin":"gǔn gǔn zhū gōng","abbr":"ggzg","explanation":"衮衮：相继不绝。旧指身居高位而无所作为的官僚们。","source":{"text":"诸公衮衮登台省，广文先生官独冷。","book":"唐·杜甫《醉时歌》"},"example":{"text":"国民党的～管我们这些穷学生的什么“宣言”、“上书”！","book":"杨沫《青春之歌》第二部第三十六章"},"similar":["达官贵人"],"opposite":["芸芸众生","黎民百胜","凡夫俗子"],"usage":"作主语、宾语；指无所作为的官僚们"},{"id":40069,"word":"衰季之风","pinyin":"shuāi jì zhī fēng","abbr":"sjzf","explanation":"衰季：末世。末世的不良风气。","source":{"text":"庶几得忠实之士，不至蹈衰季之风，则天下幸甚。","book":"宋·苏轼《议学校贡举札子》"},"similar":["歪风邪气","不正之风"],"opposite":["浩然正气"],"usage":"作主语、宾语、定语；指歪风邪气"},{"id":40070,"word":"衰当益壮","pinyin":"shuāi dāng yì zhuàng","abbr":"sdyz","explanation":"犹老当益壮。","source":{"text":"衰当益壮，结草知归。瞻望恩光，无忘景刻。","book":"唐李白《为赵宣城与杨右相书》"},"similar":["老当益壮"],"usage":"作谓语、定语；多用于老年人"},{"id":40071,"word":"衰草寒烟","pinyin":"shuāi cǎo hán yān","abbr":"schy","explanation":"衰草：衰败的野草；寒烟：空旷荒凉的原野上的雾气。比喻空旷偏僻，冷落荒凉。","source":{"text":"更衰草寒烟淡薄。似当时、将军部曲，迤逦度沙漠。","book":"宋·姜夔《凄凉犯》词"},"example":{"text":"醒时幽怨同谁诉，～无限情。","book":"清·曹雪芹《红楼梦》第三十八回"}},{"id":40072,"word":"衹树有缘","pinyin":"qí shù yǒu yuán","abbr":"zsyy","explanation":"衹树：佛教语，给孤独园的略称；缘：缘分。与佛法有缘分。","source":{"text":"漫言衹树有缘，落得浮萍无定。","book":"明·陈汝元《金莲记·郊遇》"},"usage":"作宾语、定语；指有佛缘"},{"id":40073,"word":"衽扱囊括","pinyin":"rèn xī náng kuò","abbr":"rxnk","explanation":"比喻全部擒获或肃清。","source":{"text":"天下多群盗，衽扱囊括，可次取也。","book":"清·唐甄《潜书·两权》"},"usage":"作谓语、定语；用于比喻句"},{"id":40074,"word":"衽抭囊括","pinyin":"rèn xī náng kuò","abbr":"rxnk","explanation":"比喻全部擒获或肃清。","source":{"text":"天下多群盗，衽抭囊括，可次取也。","book":"清·唐甄《潜书·两权》"}},{"id":40075,"word":"衽革枕戈","pinyin":"rèn gé zhěn gē","abbr":"rgzg","explanation":"以铠甲为席，以兵器为枕。形容战事频繁，生活不安定。","source":{"text":"当是之时，哀哀黔首，衽革枕戈，不得喙息，盖几靡有孑遗，秏矣！","book":"严复《原强》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":40076,"word":"衾寒枕冷","pinyin":"qīn hán zhěn lěng","abbr":"qhzl","explanation":"衾：被子。被枕俱冷。形容独眠的孤寂凄凉。","source":{"text":"［旦］奴不虑衾寒枕冷；奴只虑公婆没主一旦冷清清。","book":"宋·柳永《爪茉莉（秋夜）》：“衾寒枕冷，夜迢迢、更无寐。”明·高明《琵琶记》第五出"},"example":{"text":"却说唐长老师徒四人，歇在陈家。将近天晓，师徒们～。","book":"明·吴承恩《西游记》第四十七回"},"similar":["枕冷衾寒"],"usage":"作谓语、宾语、定语；指孤单"},{"id":40077,"word":"衾影何惭","pinyin":"qīn yǐng hé cán","abbr":"qyhc","explanation":"衾：被子。指不做亏心事，独处时内心不感到惭愧。比喻为人行为光明，问心无愧。","source":{"text":"故身恒居善，则内无忧虑，外无畏惧，独立不愧影，独寝不愧衾。","book":"南朝·齐·刘昼《新论·慎独》"},"example":{"text":"寿名千古，～！","book":"清·李渔《闲情偶寄·词曲部·音律》"}},{"id":40078,"word":"衾影无惭","pinyin":"qīn yǐng wú cán","abbr":"qywc","explanation":"衾：被子。指行为光明，问心无愧。","source":{"text":"贻书训诸子曰：‘独行不愧影，独寝不愧衾，勿以吾得罪故遂懈。’","book":"南朝·齐·刘昼《新论·慎独》：“故身恒居善，则内无忧虑，外无畏惧，独立不愧影，独寝不愧衾。”《宋史·蔡元定传》"},"example":{"text":"我们讲理学的人，最讲究的是“慎独”工夫，总要能够～，屋漏不愧。","book":"清·李宝嘉《官场现形记》第十九回"},"similar":["问心无愧"],"usage":"作谓语；指行为光明，问心无愧"},{"id":40079,"word":"衾影无愧","pinyin":"qīn yǐng wú kuì","abbr":"qywk","explanation":"指在私生活中无丧德败行之事问心无愧。","source":{"text":"我们讲理学的人，最讲究的是‘慎独’工夫，总要能够衾影无惭，屋漏不愧。","book":"清·李宝嘉《官场现形记》"},"similar":["屋漏不愧"],"usage":"作谓语、宾语；用于自省"},{"id":40080,"word":"衾影独对","pinyin":"qīn yǐng dú duì","abbr":"qydd","explanation":"指独自一人。","source":{"text":"独立不惭影，独寝不愧衾。","book":"语本北齐·刘昼《新论·慎独》"},"usage":"作定语；指孤单一人"},{"id":40081,"word":"袁安高卧","pinyin":"yuán ān gāo wò","abbr":"yagw","explanation":"指身处困穷但仍坚守节操的行为。","source":{"text":"《后汉书·袁安传》唐·李贤注引《汝南先贤传》载：汉时袁安未达时，洛阳大雪，人多出乞食，安独僵卧不起，洛阳令按行至安门，见而贤之，举为孝廉，除阴平长、任城令。"},"example":{"text":"～太寒酸，党尉羊膏未书欢。","book":"柳亚子《消寒一绝》"},"usage":"作宾语、定语；用于书面语","story":["汉朝时期，袁安还没有发达时，那年洛阳下起了鹅毛大雪，很多人外出乞食，唯独袁安僵卧在家里不起，洛阳县令按户巡查至袁安家门，见他十分贤能，就举他为孝廉，后来袁安相继担任阴平长官，任城县令"]},{"id":40082,"word":"袂云汗雨","pinyin":"mèi yún hàn yǔ","abbr":"myhy","explanation":"形容行人之多。","source":{"text":"张袂成阴，挥汗成雨。","book":"春秋·齐·晏婴《晏子春秋·杂下九》"},"example":{"text":"士女麇至，几于～。","book":"清·王韬《淞滨琐话·画船纪艳》"},"usage":"作定语；形容行人之多","story":["战国时期，说客苏秦到齐国游说齐宣王联合抗秦，他说道：“临淄有7万户人家，每家可以出了3个男人当兵，地方很富足，街上人很多，众人把衣袖举起来像帐幕，每人挥一把汗，简直像下雨一样，有这样的实力难道还要屈服于秦国？”"]},{"id":40083,"word":"袂接肩摩","pinyin":"mèi jiē jiān mó","abbr":"mjjm","explanation":"袂：袖子。衣袖相连，肩膀相触。形容人非常多。","source":{"text":"其他智士谋臣，袂接肩摩，殆未可一二数。","book":"明·宋濂《国朝名臣序颂》"},"similar":["摩肩接踵"],"usage":"作谓语、状语；形容人多"},{"id":40084,"word":"袅娜娉婷","pinyin":"niǎo nuó pīng tíng","abbr":"nnpt","explanation":"形容女子姿态美好的样子。亦借指美人。","source":{"text":"这赵友梅年方二八，巧慧绝伦，言不尽袅娜娉婷，真乃是天姿国色。","book":"清·烟水散人《合浦珠》第三回"},"example":{"text":"匡胤定睛一看，好一个齐整人品：年纪不过十五六岁，生得唇红齿白，～，宛然一个美貌女子，娇艳异常。","book":"清·吴璿《飞龙全传》第五回"}},{"id":40085,"word":"袅袅不绝","pinyin":"niǎo niǎo bù jué","abbr":"nnbj","explanation":"袅袅：声音宛转悠扬。形容宛转悠扬的音乐声连绵不断。","source":{"text":"余音袅袅，不绝如缕。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"那声气哗啦哗啦，又像风涛澎，又像狼吞虎咽，中间还夹着一丝又尖又细的声音，忽高忽低，～。","book":"钱钟书《围城》第五章"}},{"id":40086,"word":"袅袅亭亭","pinyin":"niǎo niǎo tíng tíng","abbr":"nntt","explanation":"形容女子体态轻盈柔美。","source":{"text":"风风韵韵，袅袅亭亭。","book":"元·张可久《折桂令·酒边分得卿字韵》曲"},"example":{"text":"况兹～，又何能当此煎迫哉。","book":"清·陈裴之《香畹楼忆语》"},"similar":["袅袅婷婷","袅袅娜娜"],"usage":"作谓语、定语；用于女性"},{"id":40087,"word":"袅袅余音","pinyin":"niǎo niǎo yú yīn","abbr":"nnyy","explanation":"袅袅：宛转悠扬。余音：不绝之音。形容音乐结束后悠扬悦耳的声音仍然绵延不绝，回响在耳边。同“余音袅袅” 。","source":{"text":"诸君听小子讲书，不必就散，尚有一回袅袅余音哩。","book":"清·魏秀仁《花月痕》第五十一回"},"example":{"text":"她已离去，但她那美妙的歌声仍然～，不绝于耳。","book":"于明之《走在羊肠小道上》"}},{"id":40088,"word":"袅袅娉娉","pinyin":"niǎo niǎo píng píng","abbr":"nnpp","explanation":"袅袅：柔美貌；娉娉：美好貌。形容女子姿态柔美。","source":{"text":"等待那齐齐整整，袅袅婷婷，姐姐莺莺。","book":"元·王实甫《西厢记》第一本第三折"},"example":{"text":"不一时，只见众夫人多打扮得鲜妍妩媚，～，齐走进轩来。","book":"清·禇人获《隋唐演义》第三十回"},"similar":["袅袅娜娜"],"usage":"作状语、定语；用于女性"},{"id":40089,"word":"袅袅娜娜","pinyin":"niǎo niǎo nuó nuó","abbr":"nnnn","explanation":"形容女子体态轻盈柔美。同“袅袅亭亭”。","source":{"text":"正自没个消息，忽见松阴下，有一女子，手折了一枝香兰，袅袅娜娜而来。","book":"明·施耐庵《水浒传》第一百一回：“那簇人歇下轿，养娘扶女子出了轿，径望艮岳门内，袅袅娜娜，妖妖娆娆走进去。”明·吴承恩《西游记》第六十回"},"example":{"text":"那小娘子啭莺声、吐燕语道：‘主翁先行，贱妾随后。’只见～走出房来，道了万福。","book":"明·凌濛初《初刻拍案惊奇》卷十八"},"similar":["袅袅娉娉"],"usage":"作状语、定语；用于女性"},{"id":40090,"word":"袅袅婷婷","pinyin":"niǎo niǎo tíng tíng","abbr":"nntt","explanation":"袅袅：柔美貌；婷婷：美好貌。形容女子姿态柔美。","source":{"text":"等待那齐齐整整，袅袅婷婷，姐姐莺莺。","book":"元·王实甫《西厢记》第一本第三折"},"example":{"text":"刚到山门，只见～一行妇女，在巷道中走将进来。","book":"清·禇人获《隋唐演义》第六十七回"},"similar":["袅袅娜娜","袅袅亭亭"],"usage":"作谓语、定语；用于女性"},{"id":40091,"word":"袍泽之谊","pinyin":"páo zé zhī yì","abbr":"pzzy","explanation":"袍泽：长袍与内衣，泛指军队中的同事。指军队中同事的交情、友谊。","source":{"text":"岂曰无衣，与子同袍，王于兴师，修我戈矛，与子同仇。岂曰无衣，与子同泽，王于兴师，修我矛戟，与子偕作。","book":"《诗经·秦风·无衣》"},"example":{"text":"他是洪承畴统率下援救锦州的八总兵之一，与吴三桂有～。","book":"姚雪垠《李自成》第五卷第七章"},"similar":["袍泽故旧"],"usage":"作宾语；指战友感情"},{"id":40092,"word":"袍笏登场","pinyin":"páo hù dēng chǎng","abbr":"phdc","explanation":"笏：古代官员上朝时手中拿的狭长板子，用玉、象牙或竹片做。原指官员打扮，上场演戏。现比喻新官上任（含有讽刺之意）。","source":{"text":"袍笏登场也等闲。","book":"清·赵翼《数月内频送南雷述庵淑斋诸人赴京补官戏作之二》"},"example":{"text":"关于组织临时政府的问题，段已通电北方各省征求意见，只等回电一到，就要～。（陶菊隐《北洋军阀统治时期史话》第二十七章）"},"similar":["走马上任","逢场作戏"],"opposite":["告老还乡"],"usage":"作谓语；指上台做官"},{"id":40093,"word":"袒胸露背","pinyin":"tǎn xiōng lù bèi","abbr":"txlb","explanation":"敞开上衣，露出胳膊。","example":{"text":"湛越加咆哮，迫令宫女褫李氏衣，使她～，然后取鞭自挞。","book":"蔡东藩《南北史演义》第七十一回"},"similar":["袒胸露臂"],"usage":"作谓语、定语；指衣冠不整"},{"id":40094,"word":"袒胸露臂","pinyin":"tǎn xiōng lù bì","abbr":"txlb","explanation":"袒：裸露。敞开上衣，露出胳膊，指没有修养和礼貌。","source":{"text":"远远望见一个长大汉子，草帽短衣，肩上背了行囊，袒胸露臂，忙忙的走来。","book":"清·褚人获《隋唐演义》第37回"},"example":{"text":"我不喜欢～的样子。"},"similar":["袒胸露背","坦胸露臂"],"opposite":["衣冠楚楚"],"usage":"作谓语、定语；指衣冠不整"},{"id":40095,"word":"袒臂挥拳","pinyin":"tǎn bì huī quán","abbr":"tbhq","explanation":"挽袖露臂，挥动拳头。形容准备动武的样子。","source":{"text":"我特故里说的别，包弹遍，不嫌些蹬弩开弓，怎说他袒臂挥拳。","book":"元·关汉卿《拜月亭》第四折"},"similar":["裸袖揎拳"],"usage":"作谓语、状语；用于人的形态"},{"id":40096,"word":"袒裼裸裎","pinyin":"tǎn xī luǒ chéng","abbr":"txlc","explanation":"袒裼：露臂；祼裎：露体。指脱衣露体，没有礼貌。","source":{"text":"尔为尔，我为我，虽袒裼裸裎于我侧，尔焉能浼我哉？","book":"《孟子·公孙丑上》"},"example":{"text":"盖昔者伯夷羞与乡人处，而柳下惠至不以～为浼，事固有大异不然者，各从其心之所安也。","book":"宋·陈亮《送叔祖主筠州高安簿序》"},"similar":["无拘无束"],"usage":"作谓语、定语；指脱衣露体，粗野无礼"},{"id":40097,"word":"袖中挥拳","pinyin":"xiù zhōng huī quán","abbr":"xzhq","explanation":"挥：舞动。形容迫不及待地跟人争斗","source":{"text":"其始无端，其终无谓。袖中挥拳，针尖竞利。","book":"清·王夫之《示子侄》"},"usage":"作宾语、定语；用于比喻句"},{"id":40098,"word":"袖手傍观","pinyin":"xiù shǒu bàng guān","abbr":"xsbg","explanation":"把手笼在袖子里在旁观看。比喻置身事外，不参与","source":{"text":"想起黄衫豪客也，女伴们袖手傍观，英雄拔刀相济。","book":"明·汤显祖《紫钗记·剑合钗圆》"},"similar":["袖手旁观"],"usage":"作谓语、宾语、定语；指不过问"},{"id":40099,"word":"袖手充耳","pinyin":"xiù shǒu chōng ěr","abbr":"xsce","explanation":"袖手：藏手于袖中；充耳：塞住耳朵。指不闻不问，漠然置之","source":{"text":"既不能誓师讨贼，视其力之所能为，则当袖手充耳，姑听命于发踪指示之人。","book":"清·夏燮《中西纪事·江上议款》"},"similar":["袖手旁观","充耳不闻","漠然置之"],"usage":"作谓语、定语；用于处事"},{"id":40100,"word":"袖手旁观","pinyin":"xiù shǒu páng guān","abbr":"xspg","explanation":"把手笼在袖子里，在一旁观看。比喻置身事外，既不过问，也不协助别人。","source":{"text":"奕棋者胜负之形，虽国工有所不尽，而袖手旁观者常尽之。","book":"唐·韩愈《祭柳子厚文》：“不善为斫，血指汗颜，巧匠旁观，缩手袖间。”宋·苏轼《朝辞赴定州论事状》"},"example":{"text":"荪老三的事就和我自己的事一样，我不能～。","book":"茅盾《子夜》四"},"similar":["漠不关心","冷眼旁观","束手旁观"],"opposite":["挺身而出"],"usage":"作谓语、宾语、定语；指不过问"},{"id":40101,"word":"袖里乾坤","pinyin":"xiù lǐ qián kūn","abbr":"xlqk","explanation":"乾坤：指天地。袖中藏有天地。比喻离奇的幻术","source":{"text":"尚曰：‘袖里乾坤真个大。’惠曰：‘离人思妇尽包容。’","book":"清·蒲松龄《聊斋志异·巩仙》"},"similar":["壶中天地"],"usage":"作宾语、定语；用于书面语"},{"id":40102,"word":"袖里玄机","pinyin":"xiù lǐ xuán jī","abbr":"xlxj","explanation":"玄机：道家所谓的奥秘。袖里藏有奥妙的道理。指暗中采用的玄妙谋略","source":{"text":"又不知，袖里玄机怎主张。","book":"清·陈瑞生《再生缘》第66回"},"usage":"作宾语、定语；用于书面语"},{"id":40103,"word":"袖里藏刀","pinyin":"xiù lǐ cáng dāo","abbr":"xlcd","explanation":"袖中暗藏凶器。形容对人外表和气，内心却十分阴险毒辣。","example":{"text":"王熙凤是一个脸上带笑、～的人。"},"usage":"作谓语、定语；指人很阴险"},{"id":40104,"word":"被发佯狂","pinyin":"pī fà yáng kuáng","abbr":"bfyk","explanation":"佯：假装。披头散发，假做颠狂。多指古时避世超俗的狂士。","source":{"text":"箕子被发佯狂而为奴。","book":"《史记·宋世家》"},"example":{"text":"王子比干，非不知箕子～以免其身也，然而乐直行尽忠以死节，故不为也。","book":"《淮南子·齐俗训》"},"similar":["被发详狂","被发洋狂"],"usage":"作谓语、定语；用于书面语"},{"id":40105,"word":"被发入山","pinyin":"pī fà rù shān","abbr":"bfrs","explanation":"被：同“披”，散开。披散着头发，隐居在山林。形容与世隔绝，不问世事。","source":{"text":"汝欲取蜀，吾当披发入山，不失信于天下也。","book":"《三国志·蜀志·先主传》裴松之注引《献帝春秋》"},"example":{"text":"明·陈侚《余庵杂录》上卷：“若草庐则既为宋人，且试乡校，为宋贡士矣，即不死，亦当～，而奈何其膺程钜夫之荐也。”"},"similar":["披发入山"],"usage":"作谓语、定语；用于书面语"},{"id":40106,"word":"被发左衽","pinyin":"pī fà zuǒ rèn","abbr":"pfzr","explanation":"被发：散发不作髻；左衽：瓣襟向左掩。指古代中原地区以外少数民族的装束。也指沦为夷狄。","source":{"text":"微管仲，吾其被发左衽矣。","book":"《论语·宪问》"},"example":{"text":"或～，奋迅泥滓。","book":"晋·潘岳《西征赋》"},"similar":["披发左衽"],"usage":"作谓语、宾语；借指沦陷为异族统治","story":["春秋时期，孔子带领弟子们周游列国，在陈国闲居等待封官，不久吴王夫差灭了越国后，势力强大，带领披发左衽的吴兵乘机攻打陈国，陈君连夜潜逃，孔子还是按计划去主持祭祀仪式，被弟子们强拉上车，逃出陈国前往蔡国"]},{"id":40107,"word":"被发徒跣","pinyin":"pī fà tú xiǎn","abbr":"bftx","explanation":"徒跣：赤脚步行。披散着头发，赤着脚走路。形容悲痛到极点。","source":{"text":"奢僭放纵，变乱阴阳，灾异众多，百姓讹言，持筹相惊，被发徒跣而走，乘马者驰，天惑其意，不能自止。","book":"《汉书·王嘉传》"},"example":{"text":"可怜诸王～，极口呼冤，随他叫破喉咙，没一个出来救护。","book":"蔡东藩《唐史演义》第九十八回"},"usage":"作谓语、定语、状语；用于书面语"},{"id":40108,"word":"被发拊膺","pinyin":"pī fà fǔ yīng","abbr":"bffy","explanation":"被：通“披”；拊膺：拍胸。披散头发捶拍胸脯。形容悲愤、痛心到极点。","source":{"text":"臣等若不克所请，与亿兆之众将被发拊膺号于天而诉于帝矣。","book":"唐·杨炎《灵武受命宫颂序》"}},{"id":40109,"word":"被发撄冠","pinyin":"pī fā yīng guàn","abbr":"bfyg","explanation":"被：通“披”，披散；撄：萦绕。披发散缨。形容匆忙急迫不及整束。","source":{"text":"大家总必赶快把手上的事丢下，呼朋唤友，一齐跑来，一以表示他们被发撄冠的热忱。","book":"《暴风雨前》第二部"},"similar":["被发缨冠","披发缨冠"],"usage":"作定语、状语；形容人的装束不整洁"},{"id":40110,"word":"被发文身","pinyin":"pī fà wén shēn","abbr":"pfws","explanation":"被发：散发；文身：身上刺花纹。原指古代吴越一代的风俗。后也用以泛指未开化地带的风俗。","source":{"text":"东方曰夷，被发文身。","book":"《礼记·王制》"},"example":{"text":"禹入裸国，～，墨子入楚，锦衣吹笙，非乐而为此也。","book":"章炳麟《驳康有为论革命书》"},"similar":["披发文身"],"usage":"作定语；指人的装束"},{"id":40111,"word":"被发洋狂","pinyin":"pī fà yáng kuáng","abbr":"bfyk","explanation":"被发：披散头发。披散头发，装作疯狂。","source":{"text":"箕子曰：‘为人臣谏不听而去，是彰君之恶而自说于民，吾不忍为也。’乃被发洋狂而为奴。","book":"西汉·司马迁《史记·宋微子世家》"},"similar":["被发佯狂","被发阳狂"],"usage":"作谓语、定语；用于书面语"},{"id":40112,"word":"被发缨冠","pinyin":"pī fà yīng guàn","abbr":"pfyg","explanation":"来不及将头发束好，来不及将帽带系上。形容急于去救助别人。","source":{"text":"今有同室之人斗者，救之，虽被发缨冠而救之可也。","book":"《孟子·离娄下》"},"example":{"text":"此种举动，岂英之前人曾受黑番何项德泽，不然，何～如此耶？","book":"严复《救亡决论》"},"similar":["披发散缨"],"usage":"作定语；形容人的装束不整洁"},{"id":40113,"word":"被发详狂","pinyin":"pī fà yáng kuáng","abbr":"bfxk","explanation":"被发：披散头发。披散头发，装作疯狂。","source":{"text":"子胥之吴，乃被发详狂，跣足涂面，行乞于市。","book":"汉·赵晔《吴越春秋·王僚使公子光传》"},"similar":["被发佯狂","被发阳狂","被发洋狂"],"usage":"作谓语、定语；用于书面语"},{"id":40114,"word":"被发跣足","pinyin":"pī fà xiǎn zú","abbr":"bfxz","explanation":"被发：披散头发；跣足：赤脚。披散头发，光着脚。形容困苦或生活散漫。","source":{"text":"瞥见一画衣女子，被发跣足，冒风而至，连呼：‘三郎救我命！’","book":"清·和邦额《夜谭随录·王侃》"},"similar":["科头跣足","披发跣足"],"usage":"作宾语、定语；形容困苦或生活散漫"},{"id":40115,"word":"被发阳狂","pinyin":"pī fà yáng kuáng","abbr":"bfyk","explanation":"被发：披散头发。披散头发，装作疯狂。","source":{"text":"于是被发阳狂，游行市里，形体垢秽，未尝栉沐。","book":"《隋书·杨伯丑传》"},"similar":["被发洋狂","被发佯狂"],"usage":"作谓语、定语；用于书面语"},{"id":40116,"word":"被发附膺","pinyin":"pī fà fù yīng","abbr":"bffy","explanation":"被：通“披”，散乱；附膺：拍胸。披散头发捶拍胸脯。形容十分悲愤痛心。","source":{"text":"臣等若不克所请，与亿兆之众将被发附膺号于天而诉于帝矣！","book":"唐·杨炎《灵武受命宫颂序》"},"usage":"作谓语；用于凄凉的场合"},{"id":40117,"word":"被坚执锐","pinyin":"pī jiān zhí ruì","abbr":"bjzr","explanation":"穿坚固甲胄，握锐利武器。谓上阵战斗或作好战斗准备。","source":{"text":"前日天下大乱，兵革并起，万民苦殃，朕亲被坚执锐，自帅士卒，犯危难，平暴乱，立诸侯，偃兵息民，天下大安，此皆太公之教训也。","book":"汉·班固《汉书·高帝纪》"},"example":{"text":"其将帅首鼠两端，唯利是视，孰能～，长驱深入，系马埋轮，奋不顾命，以先士卒者乎！","book":"宋·司马光《资治通鉴》卷第一百六十九"},"similar":["披坚执锐","被甲执锐"],"usage":"作谓语、宾语、状语；指装备精良","story":["秦朝末年，项梁和项羽拥立楚怀王的孙子熊心为楚怀王起兵反秦，秦朝大将章邯派王离、涉间率军围困赵国，楚怀王派宋义为上将军、项羽为副将率军去救赵国。宋义到安阳后不进军，对项羽说：“披坚执锐不如你，运用计谋你不如我。”"]},{"id":40118,"word":"被宠若惊","pinyin":"bèi chǒng ruò jīng","abbr":"bcrj","explanation":"指受到意外的恩遇而顿觉吃惊不安。","source":{"text":"未及期年，擢置周行，遽参法从，省躬无有，被宠若惊。","book":"宋苏轼《谢中书舍人启》"},"similar":["受宠若惊","宠辱不惊"],"opposite":["宠辱不惊"],"usage":"作谓语、定语、状语；指人惊讶"},{"id":40119,"word":"被山带河","pinyin":"pī shān dài hé","abbr":"psdh","explanation":"靠着山，环着河。指形势险要的地方。","source":{"text":"秦地半天下，兵敌四国，被山带河，四塞以为固。","book":"《战国策·楚策一》"},"example":{"text":"秦地最胜，无如咸阳，～，金城千里。","book":"明·冯梦龙《东周列国志》第八十七回"},"usage":"作定语；形容地势险要"},{"id":40120,"word":"被朱佩紫","pinyin":"pī zhū pèi zǐ","abbr":"bzpz","explanation":"穿红袍，挂紫绶。指身为大官。","source":{"text":"若乃群公百辟，卿士常伯，被朱佩紫，耀金带白，坐而论道者，又充路盈寝。","book":"《晋书·夏侯湛传》"},"usage":"作谓语、定语；用于官场等"},{"id":40121,"word":"被泽蒙庥","pinyin":"bèi zé méng xiū","abbr":"bzmx","explanation":"指受恩泽，蒙庇护。","source":{"text":"留村在无锡既膺殊遇，夙驾将行，锡之父老士庶被泽蒙庥，自县治以至何干，直达于省城之金阊门，八九十里，号泣攀留，行趾相接，不下数万人。","book":"清钱泳《履园丛话·旧闻·吴留村》"},"usage":"作谓语、定语；指受到照顾"},{"id":40122,"word":"被灾蒙祸","pinyin":"pī zāi méng huò","abbr":"bzmh","explanation":"被、蒙：遭受。指遭受灾祸。","source":{"text":"人命有长短，时有盛衰，衰则疾病，被灾蒙祸之验也。","book":"汉·王充《论衡·命义篇》"},"usage":"作谓语、定语；指人遭难"},{"id":40123,"word":"被甲执兵","pinyin":"pī jiǎ zhí bīng","abbr":"pjzb","explanation":"甲：古代打仗时军人穿的护身衣服。兵：兵器。身穿护身衣服，手握武器。指全副武装。","source":{"text":"臣等被甲执兵，多者百余战。","book":"汉·荀悦《汉纪·高祖纪》"},"example":{"text":"至晓，洞中微明，乃入十余里，望见岩壑间有金城绛阙，而～者守卫之。","book":"宋·张君房《云笈七签》卷一百十三"},"similar":["被甲持兵","被甲载兵"],"usage":"作谓语、宾语；用于战争"},{"id":40124,"word":"被甲执锐","pinyin":"pī jiǎ zhí ruì","abbr":"bjzr","explanation":"被：通“披”，穿戴；甲：铠甲；执：拿着；锐：兵器。穿着坚固的盔甲，拿着锐利的武器。","source":{"text":"已而之细柳军，军吏被甲执锐，榖弓弩持满。","book":"汉·荀悦《汉纪·文帝纪》"},"similar":["被坚执锐"],"usage":"作谓语、宾语、状语；指装备精良"},{"id":40125,"word":"被甲持兵","pinyin":"pī jiǎ chí bīng","abbr":"pjcb","explanation":"身穿护身衣服，手握武器。指全副武装。","source":{"text":"勃在国，常恐惧，每郡守使丞尉行县，勃常被甲持兵。","book":"汉·荀悦《汉纪·文帝纪上》"},"example":{"text":"骄惰既久，胆力耗惫，虽近戍短使，辄与妻孥泣别，～，行数十里，即便喘汗。","book":"宋·苏轼《乞增修弓箭社条约状》之一"},"similar":["被甲执兵","披坚执锐","被甲载兵"],"usage":"作谓语、宾语；用于战争"},{"id":40126,"word":"被甲据鞍","pinyin":"pī jiǎ jù ān","abbr":"pjja","explanation":"形容武将年虽老而壮志不减。","source":{"text":"《後汉书·马援传》载：汉·马援年六十二，请出征，光武帝以其老，未许。“援自请曰： ‘臣尚能被甲上马。’帝令试之。援据鞍顾眄，以示可用。帝笑曰：‘矍铄哉是翁也！’”。"},"example":{"text":"赵国廉将军，一饭斗米肉十斤，～走若云。","book":"明·刘基《宝林同讲师渴马图歌》"},"usage":"作谓语、宾语；用于战争","story":["东汉初年，国内局势未稳，西北少数民族发生动乱，大将马援62岁了请求带兵出征，光武帝刘秀认为他年迈不允。马援说他还能被甲上马，于是亲自演示自己不减当年威风，光武帝看后十分高兴，称赞他宝刀未老，允许他带兵出征"]},{"id":40127,"word":"被甲枕戈","pinyin":"pī jiǎ zhěn gē","abbr":"pjzg","explanation":"身穿坚甲，头枕兵器。指处于高度戒备状态。","source":{"text":"词居暇日，常被甲枕戈而卧。","book":"《新五代史·杂传十二·刘词》"},"similar":["枕戈待旦"],"usage":"作谓语、状语、定语；用于战争"},{"id":40128,"word":"被甲载兵","pinyin":"pī jiǎ zài bīng","abbr":"bjzb","explanation":"身穿铠甲，手拿武器。指全副武装，披坚执锐。","source":{"text":"杂古今人物小画共一卷，骑而立者五人，骑而被甲载兵立者十人。","book":"唐·韩愈《画记》"},"similar":["被甲执兵"],"usage":"作谓语、宾语；用于战争"},{"id":40129,"word":"被绣之牺","pinyin":"pī xiù zhī xī","abbr":"bxzx","explanation":"被：通“披”；牺：祭祀用的牲畜。披着锦绣的牲牛。比喻求得功名利禄而不能全余生的人。","source":{"text":"或聘于庄子。庄子应其使曰：‘子见夫牺牛乎？衣以文绣，食以刍叔，及其牵而入于大庙，虽欲为孤犊，其可得乎！’","book":"战国·宋·庄周《庄子·列御寇》"},"example":{"text":"子永叹天伦之伟，漆园悲～。","book":"晋·葛洪《抱朴子·博喻》"},"usage":"作宾语；用于比喻句"},{"id":40130,"word":"被绣昼行","pinyin":"pī xiù zhòu xíng","abbr":"bxzx","explanation":"穿着锦绣衣服白天出行。指在人前夸耀自己富贵。","source":{"text":"被绣昼行，昔人攸羡。","book":"晋·陆云《赠鄱阳府君张仲膺》诗"},"similar":["衣锦昼行"],"usage":"作谓语、宾语、定语；用于为人"},{"id":40131,"word":"被苫蒙荆","pinyin":"pī shān méng jīng","abbr":"bsmj","explanation":"苫：用草编成的帘子、垫子等草制品。披草苫，裹荆棘。泛指受尽艰难，吃尽苦头。","source":{"text":"乃吾祖离被苫盖，蒙荆棘，以来归我先君。","book":"《左传·襄公十四年》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":40132,"word":"被褐怀宝","pinyin":"pī hè huái bǎo","abbr":"bhhb","explanation":"被：通“披”，散开；褐：兽毛或粗麻制成的短衣。身穿粗布衣服，怀中藏着宝玉。比喻人有才德而深藏不露。","source":{"text":"臣伏见光禄大夫江夏黄琼，耽道乐术，清亮自然，被褐怀宝，含味经籍。","book":"南朝·宋·范晔《后汉书·郎顗传》"},"similar":["被褐怀玉"],"usage":"作谓语、定语；指有才者不外露"},{"id":40133,"word":"被褐怀玉","pinyin":"pī hè huái yù","abbr":"phhy","explanation":"身穿粗布衣服而怀抱美玉。比喻虽是贫寒出身，但有真才实学。","source":{"text":"知我者希，则我者贵，是以圣人被褐怀玉。","book":"《老子》第七十章"},"example":{"text":"今天下得无有～而钓于渭滨者乎？","book":"三国魏·曹操《求贤令》"},"similar":["被褐怀珠","被褐怀宝","被褐藏辉"],"usage":"作谓语、定语；指有才者不外露"},{"id":40134,"word":"被褐怀珠","pinyin":"pī hè huái zhū","abbr":"phhz","explanation":"身穿粗布衣服而怀抱宝珠。比喻虽是贫寒出身，但有真才实学。","source":{"text":"知我者希，则我者贵，是以圣人被褐怀玉。","book":"《老子》第七十章"},"example":{"text":"他则是假躯劳幻世愚眸，～，含素藏脩。","book":"明·朱权《冲漠子》第四折"},"similar":["被褐怀玉","被褐怀宝"],"usage":"作谓语、定语；指有才者不外露"},{"id":40135,"word":"被褐藏辉","pinyin":"pī hè cáng huī","abbr":"bhch","explanation":"被：通“披”，散开；褐：兽毛或粗麻制成的短衣。身穿粗布衣服，怀中藏着宝玉。比喻人有才德而深藏不露。","source":{"text":"且沉山虀影，被褐藏辉。","book":"明·叶宪祖《易水寒》第一折"},"similar":["被褐怀玉","被褐怀宝"],"usage":"作谓语、定语；指有才者不外露"},{"id":40136,"word":"被赭贯木","pinyin":"pī zhě guàn mù","abbr":"bzgm","explanation":"赭：赭衣，古代囚衣；木：指“三木”。加在手足上的刑具。穿囚衣，戴刑具。","source":{"text":"虽李绂、孙嘉琻之无过，犹一切被赭贯木以挫辱之。","book":"章炳麟《驳康有为论革命书》"},"usage":"作宾语、定语；用于比喻句"},{"id":40137,"word":"袭人故伎","pinyin":"xí rén ɡù jì","abbr":"xrgj","explanation":"袭：因袭，套用。沿用别人使用过的伎俩。"},{"id":40138,"word":"袭人故技","pinyin":"xí rén gù jì","abbr":"xrgj","explanation":"袭：因袭，套用；故：过去。沿用别人使用过的伎俩。","example":{"text":"～一般是难以成功。"},"similar":["袭人故智"],"opposite":["别出心裁","独具一格"],"usage":"作谓语、定语；指抄袭"},{"id":40139,"word":"袭人故智","pinyin":"xí rén ɡù zhì","abbr":"xrgz","explanation":"袭：因袭，套用。智：指计算。套用别人使用过的计策。","example":{"text":"我不想～，要自己想别的办法。"},"similar":["袭人故技"],"opposite":["独树一帜"],"usage":"作谓语、定语；指抄袭"},{"id":40140,"word":"袭以成俗","pinyin":"xí yǐ chéng sú","abbr":"xycs","explanation":"袭：因袭。因袭旧有的东西已成为习俗。","source":{"text":"世代沿革，袭以成俗，无复古意。","book":"清·朱彝尊《朱佑传》"},"similar":["习以成俗"],"usage":"作宾语、定语；指成为习俗"},{"id":40141,"word":"袭冶承弓","pinyin":"xí yě chéng gōng","abbr":"xycg","explanation":"指继承父业。","source":{"text":"良冶之子，必学为袭；良弓之子，必学为箕。","book":"语出《礼记·学记》"},"example":{"text":"枕经籍史，销灯火于三余；～，觊风云于一旦。","book":"明·陈汝元《金莲记·就逮》"},"usage":"作谓语、定语；用于书面语"},{"id":40142,"word":"袭凡蹈故","pinyin":"xí fán dǎo gù","abbr":"xfdg","explanation":"因袭俗套，遵循旧规。","source":{"text":"世人或不察其立辞之说，而徒取其所谓袭凡蹈故，缀辑成篇者。","book":"明·方孝孺《与舒君书》"},"usage":"作宾语、定语；用于处事"},{"id":40143,"word":"袭常缀琐","pinyin":"xí cháng zhuì suǒ","abbr":"xczs","explanation":"袭用常言，堆砌琐语。谓行文风格不高。","source":{"text":"震川之文，乡曲应酬者十六七，而又徇请者之意，袭常缀琐，虽欲大远于俗言，其道无由。","book":"清·方苞《书〈归震川文集〉后》"},"usage":"作谓语、宾语、定语；用于处事或作文等"},{"id":40144,"word":"袭故守常","pinyin":"xí gù shǒu cháng","abbr":"xgsc","explanation":"按照成例、常规办事。","source":{"text":"使上自朝廷，下及田野，内起京师，外周四海，士吏兵农工商僧道，无一人得袭故而守常者，纷纷扰扰，莫安其居。","book":"宋·司马光《与王安石书》"},"example":{"text":"～的做法我不赞成"},"similar":["蹈常袭故","墨守成规","因循守旧"],"opposite":["除旧布新","革故鼎新","独辟蹊径"],"usage":"作谓语、宾语、定语；指守旧"},{"id":40145,"word":"袭故蹈常","pinyin":"xí gù dǎo cháng","abbr":"xgdc","explanation":"袭：沿袭；故：老办法；蹈：踩，引伸为遵循；常：常规，老规矩。因循守旧，照老规矩办事。","source":{"text":"后之君子，蹈常而袭故，惴惴焉惧不免于天下。","book":"宋·苏轼《伊尹论》"}},{"id":40146,"word":"袭衣兼食","pinyin":"xí yī jiān shí","abbr":"xyjs","explanation":"成套衣服，多盘菜肴。指生活优裕。","source":{"text":"居家甚勤俭，无袭衣兼食，然施族仁下，不有所害。","book":"明·何景明《徐太母潘氏墓志铭》"},"opposite":["节衣缩食"],"usage":"作宾语、定语；用于书面语"},{"id":40147,"word":"袭蹈前人","pinyin":"xí dǎo qián rén","abbr":"xdqr","explanation":"袭：因袭；蹈：踩，引申为遵循。因袭前人，缺乏创新。","source":{"text":"然而必出于己，不袭蹈前人一言一句。","book":"唐·韩愈《南阳樊绍述墓志铭》"},"example":{"text":"至它文，造端置辞，要为不～者。","book":"《新唐书·韩愈传》"},"similar":["蹈袭前人"],"opposite":["独树一帜"],"usage":"作谓语、定语；指作品等"},{"id":40148,"word":"裁书叙心","pinyin":"cai shu xu xin","abbr":"csxx","explanation":"写了这封信表述心意。"},{"id":40149,"word":"裁云剪水","pinyin":"cái yún jiǎn shuǐ","abbr":"cyjs","explanation":"裁行云，剪流水。比喻诗文构思精妙新巧。","source":{"text":"名擅雕龙，诗成倚马，清思裁云剪水。","book":"明·屠隆《彩毫记·夫妻玩赏》"},"similar":["裁月镂云"],"usage":"作谓语、定语；指文章等"},{"id":40150,"word":"裁心镂舌","pinyin":"cái xīn lòu shé","abbr":"cxls","explanation":"形容用尽心思，费尽口舌。","source":{"text":"如使恢宏博大之士，裁心镂舌，比辞而道，安可见乎？","book":"唐·沈亚之《贤良方正能直言极谏策》"},"similar":["费尽口舌"],"usage":"作谓语；用于处事"},{"id":40151,"word":"裁月镂云","pinyin":"cái yuè lòu yún","abbr":"cyly","explanation":"剪裁明月，雕刻云霞。比喻诗文中辞藻润饰，景物描绘的新巧。","source":{"text":"裁月镂云，未足与言新也。","book":"清·汪琬《〈绮里诗选〉序》"},"example":{"text":"温柔敦厚，缠绵悱恻，诗之正也；慷慨激昂，～，诗之变也。","book":"清·薛雪《一瓢诗话》卷四十二"},"similar":["镂云裁月"],"usage":"作谓语、定语、宾语；形容诗文奇巧工丽"},{"id":40152,"word":"裁红点翠","pinyin":"cái hóng diǎn cuì","abbr":"chdc","explanation":"①采摘花卉。②比喻选择华丽的辞藻。","source":{"text":"谁家总角歧路阴，裁红点翠愁人心。","book":"南朝·梁·简文帝《东飞伯劳歌》"},"example":{"text":"乐府初翻新谱，漫～，闲题金缕。","book":"宋·陆游《真珠帘》词"},"usage":"作谓语、宾语；用于写作等"},{"id":40153,"word":"裁长补短","pinyin":"cái cháng bǔ duǎn","abbr":"ccbd","explanation":"指吸收别人长处，以弥补自己的不足。","source":{"text":"安道诗虽嫩弱，有清上之句。裁长补短，袁彦伯之亚乎？","book":"南朝·梁·钟嵘《诗品》下卷"},"example":{"text":"～的做法不可取。"},"similar":["截长补短","取长补短"],"usage":"作谓语、定语；指取长补短"},{"id":40154,"word":"裂冠毁冕","pinyin":"liè guān huǐ miǎn","abbr":"lghm","explanation":"①比喻背弃王室。②比喻绝意仕进。③比喻毁灭华夏文化，背离民族传统。","source":{"text":"汉室中微，王莽篡位，士之蕴藉义愤甚矣。是时裂冠毁冕，相携持而去之者，盖不可胜数。","book":"《左传·昭公九年》：“王使詹桓伯辞于晋，曰：‘……伯父若裂冠毁冕，拔本塞原，专弃谋主，虽戎狄，其何有余一人？’”《后汉书·逸民传序》"},"example":{"text":"陛下一屈膝……天下士大夫皆当～，变为胡服。","book":"《宋史·胡铨传》"},"usage":"作谓语、宾语；指不愿当官"},{"id":40155,"word":"裂冠毁冕，拔本塞源","pinyin":"liè guān huǐ miǎn，bá běn sāi yuán","abbr":"lghmbbsy","explanation":"冕：古代王侯卿大夫所戴的礼帽；本：树根。原比喻诸侯背弃礼法，侵犯天子的直接领地。后用作臣下推翻国君，夺取王位的代称。","source":{"text":"伯父若裂冠毁冕，拔本塞源，专弃谋主，虽戎狄其何有余一人？","book":"《左传·昭公九年》"},"example":{"text":"桂阳负众，轻问九鼎，～。","book":"《南齐书·高帝记》"},"usage":"作谓语、定语；用于书面语"},{"id":40156,"word":"裂土分茅","pinyin":"liè tǔ fēn máo","abbr":"ltfm","explanation":"古代分封诸侯时，用白茅裹着的泥土授予被封的人，象征授予土地和权力。","source":{"text":"王者封五色土以为社，若封建诸侯则各割其方色土与之，使归国立社……四方各依其方色皆以黄土覆之，其割土与之时。苴以白茅，用白茅裹土与之。","book":"《尚书·禹贡》：“厥贡惟土五色。”孔颖达疏"},"example":{"text":"我西平王功存社稷，庆流后嗣，子孙多贤，～。","book":"唐·杜牧《李叔玫除太仆卿高证除均州刺史等制》"},"similar":["列土分茅"],"usage":"作谓语；指分封土地"},{"id":40157,"word":"裂地分茅","pinyin":"liè dì fēn máo","abbr":"ldfm","explanation":"古代分封诸侯时，用白茅裹着的泥土授予被封的人，象征授予土地和权力。同“裂土分茅”。","source":{"text":"古者裂地分茅以报人臣之有功，使其子孙嗣之，所以酬祖宗，垂后裔也。","book":"宋·叶適《任子》"},"example":{"text":"～的想法不是天方夜谈"},"similar":["裂土分茅","列土分茅"],"usage":"作谓语、定语；指分封土地"},{"id":40158,"word":"裂眦嚼齿","pinyin":"liè zì jué chǐ","abbr":"lzjc","explanation":"眦：眼眶。瞪眼欲裂，紧咬牙齿。形容愤怒到极点。","source":{"text":"绍兴初，某甫成童，亲见当时士大夫，相与言及国事，或裂眦嚼齿，或流涕痛哭，人人自期以杀身翊戴王室。","book":"宋·陆游《跋傅给事贴》"},"usage":"作谓语、定语；用于人愤怒时"},{"id":40159,"word":"裂石停云","pinyin":"liè shí tíng yún","abbr":"lsty","explanation":"震开山石，使行云停住。形容声音高亢嘹亮，婉转动人","source":{"text":"婷婷袅袅，锦簇花攒，端的有裂石停云之音，霓裳羽衣之妙。","book":"清·李百川《绿野仙踪》第26回"},"similar":["裂石穿云"],"usage":"作谓语、定语；形容声音高亢嘹亮"},{"id":40160,"word":"裂石流云","pinyin":"liè shí liú yún","abbr":"lsly","explanation":"流：往来无定或转运不停。裂开山石，震动云霄。形容声音高昂响亮。","source":{"text":"唱出一句来，端的有落尘绕梁之声，裂石流云之响。","book":"明·兰陵笑笑生《金瓶梅词话》第43回"},"example":{"text":"她的声音～，天生就是女高音。"},"similar":["响彻云霄","裂石穿云"],"usage":"作谓语、定语；形容声音高亢嘹亮"},{"id":40161,"word":"裂石穿云","pinyin":"liè shí chuān yún","abbr":"lscy","explanation":"震开山石，透过云霄。形容声音高亢嘹亮。","source":{"text":"平生最喜听长笛，裂石穿云何处吹。","book":"宋·陆游《黄鹤楼》"},"similar":["裂石流云","裂石停云"],"usage":"作谓语、定语；形容声音高亢嘹亮"},{"id":40162,"word":"裂裳衣疮","pinyin":"liè sháng yī chuāng","abbr":"lsyc","explanation":"撕下自己的衣服，裹扎农民的疮伤。"},{"id":40163,"word":"裂裳裹膝","pinyin":"liè cháng guǒ xī","abbr":"lsgx","explanation":"裂：破裂；裹：包裹。指奔走急切。同“裂裳裹足”。","source":{"text":"申包胥知不可，乃之于秦，求救楚，昼驰夜趋，足踵跖劈，裂裳裹膝，鹤倚哭于秦庭，七日七夜，口不绝声。","book":"汉·赵晔《吴越春秋·阖闾内传》"},"similar":["裂裳裹足"],"usage":"作谓语、定语；用于书面语"},{"id":40164,"word":"裂裳裹足","pinyin":"liè cháng guǒ zú","abbr":"lcgz","explanation":"裂：破裂；裹：包裹。指奔走急切。","source":{"text":"是以耿介之士，疾其若斯，裂裳裹足，弃之长骛。","book":"南朝·梁·刘孝标《广绝交论》"},"example":{"text":"老兄忧时之切，惓惓不忘，窃计～不俟屦而就徒矣。","book":"宋·朱熹《答吕伯恭书》"},"similar":["裂裳裹膝"],"usage":"作谓语；形容急切奔走"},{"id":40165,"word":"装一佛像一佛","pinyin":"zhuāng yī fó xiàng yī fó","abbr":"zyfxyf","explanation":"指装什么像什么。","source":{"text":"铺内一应什物家伙，无不完备。真个装一佛像一佛，自然像个专门的太医起来。","book":"明·冯梦龙《醒世恒言》卷三十八"}},{"id":40166,"word":"装傻充愣","pinyin":"zhuāng shǎ chōng lèng","abbr":"zscl","explanation":"假装傻头傻脑的样子。","source":{"text":"你这是装傻充愣！除了闹义和团，咱们还有第二条路走吗？","book":"老舍《神拳》第二幕"},"example":{"text":"王朔《我是你爸爸》：“说些街上流传的轶闻趣事，～地问些他早已知道答案的愚蠢问题。”"},"usage":"作谓语、定语、状语；多用于口语"},{"id":40167,"word":"装妖作怪","pinyin":"zhuāng yāo zuò guài","abbr":"zyzg","explanation":"装扮妖怪骗人。比喻故意做作，把事情弄得玄妙莫测。","source":{"text":"只应送来这些诗，不是陈腐，就是抄袭，若要新奇，便装妖作怪，无一首看得上眼。","book":"清·古吴墨浪子《西湖佳话·白堤政迹》"},"example":{"text":"说有鬼神，就可以～，鼓惑乡愚，其志不过如此而已。","book":"清·刘鹗《老残游记》第十一回"},"usage":"作谓语、定语、宾语；用于处事"},{"id":40168,"word":"装孙子","pinyin":"zhuāng sūn zǐ","abbr":"zsz","explanation":"装可怜相。","example":{"text":"你不要在我面前～，我不会同情你的。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":40169,"word":"装怯作勇","pinyin":"zhuāng qiè zuò yǒng","abbr":"zqzy","explanation":"本来胆怯，却装出勇敢的样子。","source":{"text":"我以为‘打死老虎’者，装怯作勇，颇含滑稽，虽然不免有卑怯之嫌，却怯得令人可爱。","book":"鲁迅《坟·“费厄泼赖”应该缓行》"},"usage":"作谓语、宾语、定语；指伪装"},{"id":40170,"word":"装模作样","pinyin":"zhuāng mó zuò yàng","abbr":"zmzy","explanation":"样：模样、姿态。指故意做作，故做姿态。","source":{"text":"装模作样，恼吾气满胸膛。","book":"宋·史浩《荆钗记传奇》"},"example":{"text":"冷酒冷粉冷汤，着咱如何近傍，百般～，讪笑寒酸魍魉。","book":"元·无名氏《冻苏秦》第三折"},"similar":["装腔作势","矫柔造作","无病呻吟"],"opposite":["本来面目"],"usage":"作谓语、定语、状语；指故做姿态","story":["三国时期，诸葛亮用计三气周瑜。周瑜病倒，不久就一命呜呼。诸葛亮代表刘备前去吊唁，在周瑜灵前泪如雨下，悲痛欲绝，别人一点也看不出他是装模作样的，认为诸葛亮心胸豁达，不计前嫌。鲁肃也认为周瑜心胸狭隘"]},{"id":40171,"word":"装模做样","pinyin":"zhuāng mó zuò yàng","abbr":"zmzy","explanation":"模、样：模样、姿态。指故意做作，故做姿态。","source":{"text":"装模作样，恼吾气满胸膛。","book":"宋·史浩《荆钗记传奇》"},"example":{"text":"自此许庭辅所过州县，愈加～，要人家银子，千方百计，点选了许多绣女，然后起身。","book":"清·褚人获《隋唐演义》第二十六回"},"similar":["装模作样","装模装样"],"usage":"作谓语、定语、状语；指故做姿态"},{"id":40172,"word":"装模装样","pinyin":"zhuāng mó zhuāng yàng","abbr":"zmzy","explanation":"指故意做作，故做姿态给人看。","source":{"text":"只有我急得要哭，母亲却竭力的嘱咐我，说万不能装模装样，怕又招外祖母生气，又不准和别人一同去，说是怕外祖母要担心。","book":"鲁迅《呐喊·社戏》"},"similar":["装模作样","装模做样"],"usage":"作谓语、定语、状语；指故做姿态"},{"id":40173,"word":"装死卖活","pinyin":"zhuāng sǐ mài huó","abbr":"zsmh","explanation":"耍死狗，耍赖。","example":{"text":"你不要～了。"},"usage":"作谓语、宾语；指耍赖，用于口语"},{"id":40174,"word":"装洋蒜","pinyin":"zhuāng yáng suàn","abbr":"zys","explanation":"装腔作势，装糊涂。","example":{"text":"你不要～，我们早已了如指掌了。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":40175,"word":"装潢门面","pinyin":"zhuāng huáng mén miàn","abbr":"zhmm","explanation":"装潢：原指裱糊字画，现也指装饰物品使之美观；门面：指外观。比喻只把外表装饰得很漂亮。","source":{"text":"止则有这两件儿衣服，装点着门面。","book":"元·秦简夫《东堂老》第一折"},"example":{"text":"里面用了佛说，外面排斥佛说，不过是～，难道有识的人，就被他瞒过去。","book":"清·章炳麟《论教育的根本要从自国自心发出来》"},"similar":["装点门面"],"usage":"作宾语、定语；多用于比喻句"},{"id":40176,"word":"装点一新","pinyin":"zhuāng diǎn yī xīn","abbr":"zdyx","explanation":"装点：装饰点缀。经过装饰点缀后，焕然一新。","source":{"text":"先期后苑及修内司分任排办，凡诸苑亭榭花木，妆点一新。","book":"宋·周密《武林旧事》卷二"},"usage":"作谓语、定语、状语；用于书面语"},{"id":40177,"word":"装点门面","pinyin":"zhuāng diǎn mén miàn","abbr":"zdmm","explanation":"装点：装饰；门面：指外观。比喻只把外表装饰得很漂亮。","source":{"text":"止则有这两件儿衣服，装点着门面。","book":"元·秦简夫《东堂老》第一折"},"similar":["装潢门面"],"usage":"作谓语、宾语、定语；多用于比喻句"},{"id":40178,"word":"装疯作傻","pinyin":"zhuāng fēng zuò shǎ","abbr":"zfzs","explanation":"故意装成疯疯癫癫，傻里傻气。同“装疯卖傻”。","source":{"text":"贾余庆在饮酒中间，装疯作傻，诋骂南朝人物无所不至，用以献媚于铁木儿。","book":"郑振铎《桂公塘》八"},"similar":["装痴做疯","装疯卖傻"],"usage":"作谓语、定语、状语；用于处事"},{"id":40179,"word":"装疯卖俏","pinyin":"zhuāng fēng mài qiào","abbr":"zfmq","explanation":"假装疯癫，卖弄风骚","source":{"text":"那个叫做什么木兰的就是她，装疯卖俏的。","book":"欧阳予倩《木兰从军》第一场"},"usage":"作谓语、定语、状语；用于书面语"},{"id":40180,"word":"装疯卖傻","pinyin":"zhuāng fēng mài shǎ","abbr":"zfms","explanation":"故意装成疯疯癫癫，傻里傻气。","source":{"text":"打算装疯卖傻，充作神仙附体，杀此一龙，自己便可即位。","book":"程道一《庚子事变演义》"},"example":{"text":"你这样～也难逃惩罚。"},"similar":["装聋作哑","装腔作势","装模作样"],"opposite":["疯疯癫癫"],"usage":"作谓语、宾语、定语；指故意做傻"},{"id":40181,"word":"装痴作傻","pinyin":"zhuāng chī zuò shǎ","abbr":"zczs","explanation":"故意装作痴呆的样子","source":{"text":"至少，也大概叨光过什么，虽然自己的显在意识上并不了然，或者其实了然，而故意装痴作傻。","book":"鲁迅《华盖集续编·》"},"similar":["装痴卖傻"],"usage":"作谓语、定语、状语；用于处事"},{"id":40182,"word":"装痴作态","pinyin":"zhuāng chī zuò tài","abbr":"zczt","explanation":"故意装出呆傻的样子","source":{"text":"持大斧出，劈棺，骂曰：‘业已到家，何必装痴作态。’死者大笑，掀棺而起。","book":"清·袁枚《新齐谐·借棺为车》"},"similar":["装痴作傻"],"usage":"作谓语、定语、状语；用于处事"},{"id":40183,"word":"装痴做疯","pinyin":"zhuāng chī zuò fēng","abbr":"zczf","explanation":"指故意装成疯疯癫癫以逃避或掩盖真相","source":{"text":"吾故意装痴做疯，教他不识咱真相。","book":"明·冯梦龙《喻世明言》第20卷"},"similar":["装疯卖傻"],"usage":"作谓语、宾语、定语；指故意做傻"},{"id":40184,"word":"装痴卖傻","pinyin":"zhuāng chī mài shǎ","abbr":"zcms","explanation":"故意装作痴呆的样子","source":{"text":"吴天宝说：‘你不用装痴卖傻的，跟我耍这个！我们的事你打算怎么办呢？’","book":"杨朔《三千里江山》第11段"},"similar":["装痴作傻"],"usage":"作谓语、宾语、定语、状语；用于处事"},{"id":40185,"word":"装神做鬼","pinyin":"zhuāng shén zuò guǐ","abbr":"zszg","explanation":"装鬼神吓唬人。比喻玩弄手段蒙骗人。也比喻故意把事情弄得很神秘，使人无法捉摸。","source":{"text":"拆莫大擂鼓吹笛，折莫大装神弄鬼，折莫特调当扑旗。","book":"宋·古杭才人《宦门子弟错立身·延寿马参加戏班》"},"example":{"text":"秋谷听他们～，暗中甚是好笑。","book":"清·张春帆《九尾龟》第三十二回"},"similar":["装神扮鬼","装神弄鬼"],"usage":"作谓语、宾语、定语；指故弄玄虚"},{"id":40186,"word":"装神弄鬼","pinyin":"zhuāng shén nòng guǐ","abbr":"zsng","explanation":"装鬼神吓唬人。比喻玩弄手段蒙骗人。也比喻故意把事情弄得很神秘，使人无法捉摸。","source":{"text":"拆莫大擂鼓吹笛，折莫大装神弄鬼，折莫特调当扑旗。","book":"宋·古杭才人《宦门子弟错立身》"},"example":{"text":"你们别和我～的，什么事我不知道？（清·曹雪芹《红楼梦》第三十七回）"},"similar":["装神扮鬼","装神做鬼"],"usage":"作谓语、宾语、定语；指故弄玄虚"},{"id":40187,"word":"装神扮鬼","pinyin":"zhuāng shén bàn guǐ","abbr":"zsbg","explanation":"装扮鬼神。比喻故弄玄虚蒙骗人","source":{"text":"今人于开场一出，便欲异人，乃装神扮鬼，作怪兴妖。","book":"清·张岱《答袁萚庵》"},"example":{"text":"清·李百川《绿野仙踪》第58回：“你且～，将窗子、衣服、锁子丢在房内院外，饰人的耳目。”"},"similar":["装神做鬼","装神弄鬼"],"usage":"作谓语、宾语、定语；指故弄玄虚"},{"id":40188,"word":"装穷叫苦","pinyin":"zhuāng qióng jiào kǔ","abbr":"zqjk","explanation":"装扮成穷人，声称日子过得很困苦。","example":{"text":"她最会～博得别人的同情了。"},"usage":"作谓语、宾语、定语；指伪装"},{"id":40189,"word":"装聋作哑","pinyin":"zhuāng lóng zuò yǎ","abbr":"zlzy","explanation":"假装聋哑。指故意不理睬，只当不知道。","source":{"text":"可怎生装聋作哑？","book":"元·马致远《青衫泪》第四折"},"example":{"text":"自己的事为甚么要让旁人摆布，自己还～！","book":"闻一多《组织民众与保卫大西南》"},"similar":["不闻不问","装模作样","矫柔造作"],"opposite":["振聋发聩"],"usage":"作谓语、宾语、状语；指故意当不知道"},{"id":40190,"word":"装聋作痴","pinyin":"zhuāng lóng zuò chī","abbr":"zlzc","explanation":"假装又聋又傻。指故意不理睬，只当不知道。","source":{"text":"则这白侍郎正是我生死的冤家从头认，都不差，可怎行装聋作哑？","book":"元·马致远《青衫泪》第四折"},"example":{"text":"你～也逃不过的"},"similar":["装聋作哑","装聋装哑"],"usage":"作谓语、宾语、状语；指故意当不知道"},{"id":40191,"word":"装聋做哑","pinyin":"zhuāng lóng zuò yǎ","abbr":"zlzy","explanation":"假装聋哑。指故意不理睬，只当不知道","source":{"text":"方氏已许出了口，不好悔得，只得装聋做哑，听他娶了一个妾。","book":"明·凌濛初《二刻拍案惊奇》第十卷"},"example":{"text":"清·魏秀仁《花月痕》第47回：“你不想中国三十年兵资，是那个开端？前前后后糟蹋几许生灵，你还～么？”"},"similar":["装聋作哑","装聋装哑"],"usage":"作谓语、宾语、状语；指故意当不知道"},{"id":40192,"word":"装聋卖傻","pinyin":"zhuāng lóng mài shǎ","abbr":"zlms","explanation":"故意装作聋子傻子。形容明明知道，假装糊涂。","source":{"text":"他应当鼓舞起他们的爱国心，告诉他们抵抗敌人，但是他自己怎么还在这里装聋卖傻的教书，而不到战场上去呢？","book":"老舍《四世同堂》二二"},"example":{"text":"你欠了我的，你得还。我一直没说过，你不能再～。","book":"曹禺《北京人》第二幕"},"similar":["装聋作哑"],"usage":"作谓语、定语、状语；用于处事"},{"id":40193,"word":"装聋装哑","pinyin":"zhuāng lóng zhuāng yǎ","abbr":"zlzy","explanation":"假装聋哑。指故意不理睬，只当不知道。","source":{"text":"则这白侍郎正是我生死的冤家从头认，都不差，可怎行装聋作哑？","book":"元·马致远《青衫泪》第四折"},"example":{"text":"明明是官军到处奸掳烧杀，苦害百姓，这班读书人～，却硬是昧着良心，血口喷人。","book":"姚雪垠《李自成》第二卷第四十九章"},"similar":["装聋作哑","装聋做哑","装聋作痴"],"usage":"作谓语、宾语、状语；指故意当不知道"},{"id":40194,"word":"装腔作势","pinyin":"zhuāng qiāng zuò shì","abbr":"zqzs","explanation":"拿腔拿调，故意做作想引人注意或吓唬人。","source":{"text":"娘娘不消着急，他这两三日请我不去，故这等装腔作势。”罗广斌 杨益言《红岩》第十三章“余新江望着眼前这个横蛮无理，惯于装腔作势的敌人，气愤地握紧了拳头。","book":"《西湖佳话·西泠韵迹》"},"example":{"text":"人民不喜欢假话，哪怕多么～，多么冠冕堂皇的假话都不会打动人民的心。","book":"《〈艾青诗选〉自序》"},"similar":["虚张声势","装模作样","装聋作哑"],"opposite":["神情自若","落落大方"],"usage":"作谓语、宾语、状语；指故意做作"},{"id":40195,"word":"装腔作态","pinyin":"zhuāng qiāng zuò tài","abbr":"zqzt","explanation":"拿腔拿调，故意做作想引人注意或吓唬人。","source":{"text":"教那厮越装模，越作势。","book":"元·无名氏《杀狗劝夫》第四折"},"example":{"text":"发抒她的生活实感，不玩弄词藻，也不～。","book":"叶圣陶《招魂》"},"similar":["装腔作势","装腔做势"],"usage":"作谓语、定语、宾语、状语；指故意做作"},{"id":40196,"word":"装腔做势","pinyin":"zhuāng qiāng zuò shì","abbr":"zqzs","explanation":"腔：腔调；势：姿态。装出一种腔调，摆出一种姿态，故意做作想引人注意或吓唬人。","source":{"text":"况他又倚着天子宠眷，公卿出身，见你我寒士，未必不装腔做势。","book":"清·荻岸山人《平山冷燕》第15回"},"example":{"text":"听凭痴鸳～，并不觑一正眼儿。","book":"清·韩邦庆《海上花列传》第45回"},"similar":["装腔作势","装腔作态"],"usage":"作谓语、定语、宾语、状语；指故意做作"},{"id":40197,"word":"装葱卖蒜","pinyin":"zhuāng cōng mài suàn","abbr":"zcms","explanation":"假装糊涂，装腔作势","source":{"text":"指着刘喜道说：‘姓刘的，你不要装葱卖蒜，你打死了人还赖谁？走！上碉堡见太君去！’","book":"马烽《吕梁英雄传》第57回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":40198,"word":"装虚作假","pinyin":"zhuāng xū zuò jiǎ","abbr":"zxzj","explanation":"耍弄虚假的一套来欺骗人","source":{"text":"他一转身，站在梁建对面说：‘我有必要对你装虚作假？’","book":"杜鹏程《在和平的日子里》第一章"},"similar":["弄虚作假"],"usage":"作谓语、定语、状语；用于处事"},{"id":40199,"word":"装门面","pinyin":"zhuāng mén miàn","abbr":"zmm","explanation":"表面伪装。","source":{"text":"这一件不够，求师父再添几件装装门面。","book":"清·钱彩《说岳全传》第51回"},"example":{"text":"她此时已经很贫穷了，但还是想办法～以显示往日的辉煌。"},"similar":["装点门面"],"usage":"作谓语、定语；指伪装"},{"id":40200,"word":"裋褐不完","pinyin":"shù hè bù wán","abbr":"shbw","explanation":"裋褐：古代仆役所穿的短衣。粗布短衣还破旧不完整。形容生活贫苦。","source":{"text":"妻子糠豆不赡，裋褐不完。","book":"东汉·班固《汉书·贡禹传》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“贵者重裀叠褥；贫者～。”"},"similar":["短褐不完"],"usage":"作谓语、定语；指生活贫困"},{"id":40201,"word":"裒凶鞠顽","pinyin":"pū xiōng jū wán","abbr":"pxjw","explanation":"裒：刨除；凶：凶狠的人；鞠：阻塞；顽：贪婪的人。除掉凶狠，制止贪婪。","source":{"text":"裒凶鞠顽，锋猬斧螗，赤子匍匐，厥父是亢。","book":"唐·柳完元《奉平淮夷雅表》"},"usage":"作谓语、宾语；用于书面语"},{"id":40202,"word":"裒多增寡","pinyin":"póu duō zēng guǎ","abbr":"pdzg","explanation":"裒：减少；增：补充。削减有余以补不足。","source":{"text":"裒多增寡，人道之所以成乎天也。","book":"宋·陈亮《赠楼应允序》"},"similar":["裒多益寡"],"usage":"作谓语、宾语；指取长补短"},{"id":40203,"word":"裒多益寡","pinyin":"póu duō yì guǎ","abbr":"pdyg","explanation":"裒：减少；：增补。拿多余的一方，增加给缺少的一方。比喻多接受别人的意见，弥补自己的不足。","source":{"text":"君子以裒多益寡，称物平施。","book":"《易·谦》"},"example":{"text":"愿君侯～，非礼勿履。","book":"明·罗贯中《三国演义》第一百六回"},"similar":["裒多增寡","截长补短"],"usage":"作谓语、宾语；指取长补短"},{"id":40204,"word":"裒如充耳","pinyin":"yòu rú chōng ěr","abbr":"prce","explanation":"像聋子一样塞耳不闻，形容拒绝听取别人的意见。同“褎如充耳”。","source":{"text":"向者累请于公城守，裒如充耳。今欲为于国亡势去之余，亦已知其难矣。","book":"清·黄宗羲《子刘子行状》"},"similar":["褎如充耳"],"usage":"作谓语；指服饰与德行不相称"},{"id":40205,"word":"裒敛无厌","pinyin":"pū liǎn wú yàn","abbr":"plwy","explanation":"裒：聚；敛：收拢；厌：满足。搜刮财物没有满足的时候。泛指搜刮无遗。","source":{"text":"推毂所镇，裒敛无厌。","book":"《陈书·侯安都传》"},"example":{"text":"招聚逋逃，穷极轻狡，无赖无行，不畏不恭，受脉专征，剽掠一逞，推毂所镇，～。","book":"蔡东蕃《南北史演义》第七十二回"}},{"id":40206,"word":"裕后光前","pinyin":"yù hòu guāng qián","abbr":"yhgq","explanation":"裕：富饶。为后人造福，给前辈增光","source":{"text":"敬老慈幼，必然裕后光前。","book":"宋·陈抟《心相编》"},"example":{"text":"清·陶贞怀《天雨花》第八回：“文武两途都已足，～亦可称。”"},"similar":["光前裕后"],"usage":"作谓语、定语；用以歌颂人的不世功勋"},{"id":40207,"word":"裕国足民","pinyin":"yù guó zú mín","abbr":"ygzm","explanation":"裕：富饶。使人民富裕，国家丰足","source":{"text":"且此项钱粮，贮积甚多，将来裕国足民，更不外索。","book":"明·张居正《答应天巡抚论大政大典》"},"similar":["裕民足国"],"usage":"作谓语、定语；用于书面语"},{"id":40208,"word":"裕民足国","pinyin":"yù mín zú guó","abbr":"ymzg","explanation":"使人民富裕，国家丰足。","source":{"text":"足国之道，节用裕民。","book":"战国·赵·荀况《荀子·富国》"},"example":{"text":"此数百万金，皆中国～之资。","book":"清·彭养鸥《黑籍冤魂》第四回"},"similar":["裕民足民"],"usage":"作谓语、定语；形容国家的实力"},{"id":40209,"word":"裘弊金尽","pinyin":"qiú bì jīn jìn","abbr":"qbjj","explanation":"皮袍破了，钱用完了。比喻境况困难。","source":{"text":"说秦王书十上而说不行，黑貂之裘弊，黄金百斤尽。","book":"《战国策·齐策一》"},"similar":["穷困落拓","裘敝金尽"],"usage":"作谓语、定语；指人落魄"},{"id":40210,"word":"裘敝金尽","pinyin":"qiú bì jīn jìn","abbr":"qbjj","explanation":"裘：皮衣。皮衣穿破了，钱用完了。比喻生活穷困。","source":{"text":"忽裘敝而金尽，遂寡欢而愁殷。","book":"清·余怀《板桥杂记·雅游》"},"similar":["裘弊金尽"],"usage":"作谓语、定语；指人落魄"},{"id":40211,"word":"裘葛之遗","pinyin":"qiú gě zhī yí","abbr":"qgzy","explanation":"裘：皮衣；葛：夏衣；遗：赠与。比喻根据季节不同，赠送适时的衣服。","source":{"text":"父母岁有裘葛之遗，无冻馁之患矣。","book":"明·宋濂《送东阳马生序》"}},{"id":40212,"word":"裘马声色","pinyin":"qiú mǎ shēng sè","abbr":"qmss","explanation":"衣轻裘，乘肥马，醉心歌舞，迷恋女色。谓贪图享受，生活糜烂。","source":{"text":"宋诸王咸以文雅自饬，工笔札，喜《诗》《书》，不专溺于裘马声色之间，盖其风流自上被之也。","book":"明·归有光《宋史论赞·诸王总论》"},"usage":"作宾语、定语；用于生活"},{"id":40213,"word":"裘马清狂","pinyin":"qiú mǎ qīng kuáng","abbr":"qmqk","explanation":"指生活富裕，放逸不羁。","source":{"text":"放荡齐赵间，裘马颇清狂。","book":"唐·杜甫《壮游》诗"},"example":{"text":"当其游吴越，游齐赵，少年快意，～，固尚未困厄。","book":"清·赵翼《瓯北诗话·杜少陵诗》"},"usage":"作谓语、定语、宾语；指生活富裕，放逸不羁"},{"id":40214,"word":"裘马轻狂","pinyin":"qiú mǎ qīng kuáng","abbr":"qmqk","explanation":"指生活富裕，放荡不羁。"},{"id":40215,"word":"裘马轻肥","pinyin":"qiú mǎ qīng féi","abbr":"qmqf","explanation":"身上穿着软皮衣，骑着肥壮骏马。指生活富裕，放荡不羁。","source":{"text":"赤之适齐也，乘肥马，衣轻裘。","book":"《论语·雍也》"},"example":{"text":"朋友是旧同学，现在正当“～”，对青年丙说了许多“借重”的话。","book":"茅盾《诗与散文》四"},"similar":["肥马轻裘"],"usage":"作定语；指生活富裕"},{"id":40216,"word":"裙屐少年","pinyin":"qún jī shào nián","abbr":"qjsn","explanation":"裙：下裳；屐：木鞋。裙屐是六朝贵族子弟的衣着。形容只知道讲究穿戴的年轻人。","source":{"text":"萧深藻是裙屐少年，未拾政务。","book":"《北史·邢峦传》"},"example":{"text":"门外钿车骈溢，飞尘散香，～，洋舶大贾，辄坠鞭留宴。","book":"清·王韬《瀛壖杂志》"},"similar":["纨绔子弟"],"usage":"作宾语；泛指大家子弟"},{"id":40217,"word":"裙布荆钗","pinyin":"qún bù jīng chāi","abbr":"qbjc","explanation":"以布作裙，以荆代钗。比喻贫困。同“钗荆裙布”。","source":{"text":"贡元乃丰衣足食之家，老身乃裙布荆钗之妇。","book":"明·柯丹邱《荆钗记·议亲》"},"example":{"text":"梁鸿之妻～，也称得贤女。","book":"清·文康《儿女英雄传》第25回"},"similar":["裙布钗荆"],"usage":"作主语、宾语、定语；用于女性"},{"id":40218,"word":"裙布钗荆","pinyin":"qún bù chāi jīng","abbr":"qbcj","explanation":"钗：妇女的发饰；荆：灌木名。荆枝为钗，粗布为裙。形容妇女装束简陋寒素。","source":{"text":"夫人是香闺绣阁之名姝，奴家是裙布钗荆之贫妇。","book":"明·高明《琵琶记·散发归林》"},"example":{"text":"明·冯梦龙《喻世明言》第22卷：“～，任是村妆希罕。”"},"similar":["裙布荆钗","荆钗布裙"],"usage":"作主语、宾语、定语；用于女性"},{"id":40219,"word":"裙带关系","pinyin":"qún dài guān xì","abbr":"qdgx","explanation":"裙带：比喻妻女、姊妹的亲属。指相互勾结攀援的妇女姻亲关系。","source":{"text":"亲王南班之婿，号曰西宫，即所谓郡马也，俗谓裙带头官。","book":"宋·赵昇《朝野类要》卷三"},"example":{"text":"便拿她的同事而言，就很有几位是～来混一口饭的。","book":"茅盾《幻灭》十"},"usage":"作宾语、定语；指妇女姻亲关系"},{"id":40220,"word":"裙带官","pinyin":"qún dài guān","abbr":"qdg","explanation":"旧指凭妻女姊妹的关系而得到的官职。","source":{"text":"亲王南班之婿，号曰西宫，即所谓郡马也，俗谓裙带头官。","book":"宋·赵昇《朝野类要》卷三"}},{"id":40221,"word":"裸袖揎拳","pinyin":"luǒ xiù xuān quán","abbr":"lxxq","explanation":"挽起衣袖，露出拳头，形容浪荡。","source":{"text":"铺眉苫眼早三公，裸袖揎拳享万钟。","book":"元·张鸣善《水仙子·讥时》"},"similar":["攞袖揎拳","揎拳裸袖"],"usage":"作谓语、状语；指人的外表"},{"id":40222,"word":"裸袖揎衣","pinyin":"luǒ xiù xuān yī","abbr":"lxxy","explanation":"揎衣：卷袖。卷起或捋起衣袖。","source":{"text":"当日先生沈醉，脱巾露顶，裸袖揎衣。","book":"元·马致远《哨遍·张玉嵓草书》"},"usage":"作谓语、定语；指裸露手臂"},{"id":40223,"word":"裸裎袒裼","pinyin":"luǒ chéng tǎn xī","abbr":"lctx","explanation":"袒裼：露臂；祼裎：露体。指脱衣露体，没有礼貌。","source":{"text":"尔为尔，我为我，虽袒裼裸裎于我侧，尔焉能浼我哉？","book":"《孟子·公孙丑上》"},"example":{"text":"乃使郑叔、晋妇之徒，睽孤刲刺，～。","book":"《后汉书·马融传》"},"similar":["袒裼裸裎"],"usage":"作谓语、定语；指脱衣露体，粗野无礼"},{"id":40224,"word":"裹尸马革","pinyin":"guǒ shī mǎ gé","abbr":"gsmg","explanation":"革：皮革。用马皮包裹尸体。形容将士战死沙场的英勇无畏的气慨。","source":{"text":"男儿要当死于边野，以马革裹尸还葬耳，何能卧床上在儿女子手中邪？","book":"《后汉书·马援传》"},"example":{"text":"男儿坠地志四方，裹尸马革固其常。","book":"宋·陆游《陇头水》"},"similar":["马革裹尸","马革盛尸"],"usage":"作宾语；指将士战死沙场","story":["东汉时期，北方匈奴发生动乱，大将军马援率军前去镇压骚乱，他英勇杀敌，大破匈奴，平定了边境的动乱，皇帝封他为伏波将军。他62岁时，匈奴又侵东汉，马援请求带兵出战说：“男儿当死于沙场，以马革裹尸还葬”，同年病死在军中"]},{"id":40225,"word":"裹粮坐甲","pinyin":"guǒ liáng zuò jiǎ","abbr":"glzj","explanation":"携带干粮，披甲而坐。形容全副武装，准备迎战。","source":{"text":"十二月戊午，秦军掩晋上军。赵穿追之，不及。反，怒曰：‘裹粮坐甲，固敌是求。敌至不击，将何俟焉？’","book":"春秋·鲁·左丘明《左传·文公十二年》"},"example":{"text":"～成何事，谁为临淮恕逗留。","book":"清·陆黻恩《读秋水斋诗·拟工部诸将》"},"usage":"作谓语；形容全副武装，准备迎战"},{"id":40226,"word":"裹粮策马","pinyin":"guǒ liáng cè mǎ","abbr":"glcm","explanation":"携带粮食，鞭赶马匹。形容忠义之士踊跃参军的情景。","example":{"text":"现在人民服兵役不需像古人～一样了。"},"usage":"作定语、状语；用于参军场面"},{"id":40227,"word":"裹血力战","pinyin":"guǒ xuè lì zhàn","abbr":"gxlz","explanation":"犹言浴血奋战。形容顽强地拼死战斗。","source":{"text":"指挥之子泰，当建文时，为北平都指挥使；燕师起，与战于怀来，中矢，裹血力战，竟陷陈死。","book":"清·姚鼐《孙忠愍祠记》"},"similar":["浴血奋战"],"usage":"作谓语、定语；指顽强勇敢"},{"id":40228,"word":"裹足不前","pinyin":"guǒ zú bù qián","abbr":"gzbq","explanation":"裹：缠。停步不前，好像脚被缠住了一样。","source":{"text":"使天下之士，退而不敢西向，裹足不入秦。","book":"秦·李斯《谏逐客书》"},"example":{"text":"我们不能做有名无实的党员，不能总在困难面前～。","book":"杨沫《青春之歌》第二部第二十九章"},"similar":["作茧自缚","故步自封"],"opposite":["义无返顾","一往无前"],"usage":"作谓语、定语、状语；指思想保守","story":["战国时期，魏国中大夫须贾的门客范雎因受到诬陷而改名张禄逃到秦国。他征对秦国四人专权问题去拜见秦昭王。他说自己冒死晋见是为了秦国的将来，如果被杀就会让天下有志于助秦的人裹足不前，他分析秦国的现状头头是道，秦王拜他为相"]},{"id":40229,"word":"裹足不进","pinyin":"guǒ zú bù jìn","abbr":"gzbj","explanation":"裹足：包缠住脚。好像脚被缠住了一样，不能前进。形容有所顾虑而止步不敢向前。","source":{"text":"奈奉阳君妒才嫉能，是以游士裹足而不进，卷口而不言。","book":"明·冯梦龙《东周列国志》第90回"},"similar":["裹足不前"],"usage":"作谓语、定语、状语；指思想保守"},{"id":40230,"word":"裾马襟牛","pinyin":"jū mǎ jīn niú","abbr":"jmjn","explanation":"像马牛穿上人的衣服。比喻没有头脑和无知。亦作“襟裾马牛”。","source":{"text":"人不通古今，马牛而襟裾。","book":"唐韩愈《符读书城南》诗"},"example":{"text":"我若做浪蝶游蜂，老天呵，须教是～。","book":"明高濂《玉簪记·姑阻》"},"similar":["襟裾马牛"],"usage":"作宾语、定语；用于骂人等"},{"id":40231,"word":"褎如充耳","pinyin":"yòu rú chōng ěr","abbr":"xrce","explanation":"褎：常带笑容。面带笑容，塞耳不闻。","source":{"text":"叔兮伯兮，褎如充耳。","book":"《诗经·邶风·旄丘》"},"example":{"text":"辄浚巡退缩，即严旨屡颁，～。","book":"《明史·汤开远传》"},"similar":["裒如充耳"],"usage":"作谓语；指服饰与德行不相称"},{"id":40232,"word":"褎然举首","pinyin":"yòu rán jǔ shǒu","abbr":"xrjs","explanation":"褎然：出众的样子；举：推举；首：第一。指人的才能超出同辈。","source":{"text":"今子大夫褎然为举首。","book":"《汉书·董仲舒传》"},"similar":["褎然居首","褎然冠首"],"usage":"作谓语；用于书面语"},{"id":40233,"word":"褎然冠首","pinyin":"yòu rán guàn shǒu","abbr":"yrgs","explanation":"指出众，超出同辈而居首席。同“褎然举首”。","source":{"text":"我朝学者，以顾亭林为宗，《国史儒林传》褎然冠首。","book":"清·曾国藩《圣哲画像记》"},"similar":["褎然举首","褎然居首"],"usage":"作谓语、定语；用于书面语"},{"id":40234,"word":"褎然居首","pinyin":"yòu rán jú shǒu","abbr":"xrjs","explanation":"指出众，超出同辈而居首席。同“褎然举首”。","source":{"text":"太守少尝读书于米利坚者十年，两试太学，褎然居首。","book":"清·王韬《征设香山南屏乡义学府》"},"similar":["褎然举首","褎然冠首"],"usage":"作谓语、定语；用于书面语"},{"id":40235,"word":"褐衣不完","pinyin":"hè yī bù wán","abbr":"hybw","explanation":"褐：粗布衣服。连粗布衣服也穿不周全。形容生活困苦。","source":{"text":"邯郸之民，炊骨易子而食，可谓急矣。而君之后宫以百数，婢妾被绮穀，余梁肉，而民褐衣不完，糟糠不厌。","book":"《史记·平原君虞卿列传》"},"similar":["衣不蔽体"],"usage":"作谓语、定语；指生活清苦"},{"id":40236,"word":"褐衣蔬食","pinyin":"hè yī shū shí","abbr":"hyss","explanation":"褐衣：粗布衣服；蔬食：粗糙的饭食。穿的是粗布衣服，吃的是粗茶淡饭。形容生活困苦。","source":{"text":"故季次、原宪终年空室蓬户，褐衣蔬食。","book":"《史记·游侠列传》"},"usage":"作宾语、定语；用于生活等"},{"id":40237,"word":"褒善贬恶","pinyin":"bāo shàn biǎn è","abbr":"bsbe","explanation":"褒：赞扬；贬：批评。对好人好事加以赞扬；对坏人坏事加以斥责。指分清善恶，提出公正的评价。","source":{"text":"君子为小人所胜抑者，不过禄位耳。惟有三四寸管子，向口角头褒善贬恶，使善人贵、恶人贱，善人生、恶人死。","book":"宋·邵博《闻见后录》"},"example":{"text":"其中～，尊君抑经，内夏外夷，正名谨分，也不是等闲的文字也。","book":"明·桑绍良《独乐园》第一折"},"similar":["惩恶扬善"],"usage":"作谓语、定语；指人的立场"},{"id":40238,"word":"褒衣博带","pinyin":"bāo yī bó dài","abbr":"bybd","explanation":"褒、博：形容宽大。着宽袍，系阔带。指古代儒生的装束。","source":{"text":"褒衣博带，盛服至门上谒。","book":"《汉书·隽不疑传》"},"example":{"text":"～进贤冠，礼乐东方万国看。","book":"清·黄遵宪《续怀人》诗"},"similar":["宽衣大带","博带褒衣"],"usage":"作宾语、定语；指古代儒生的装束","story":["汉朝时期，大将暴胜之到长安拜访京兆尹赵广汉，夸他维护治安有功。赵广汉谦虚地说自己不如前任京兆尹隽不疑。隽不疑智擒假冒太子成方遂。暴胜之说他当年发现隽不疑时，他头戴进贤冠，腰佩玉柄长剑，褒衣博带，就荐他为青州刺史"]},{"id":40239,"word":"褒衣危冠","pinyin":"bāo yī wēi guān","abbr":"bywg","explanation":"褒衣：宽大的衣服。危冠：高帽子。古代儒生的装束。指宽袍高帽。","source":{"text":"献酬有容，歌风雅之古辞，斥夷狄之新声。褒衣危冠，兴兴如此。","book":"唐·韩愈《上巳日燕太学听弹琴诗序》"},"similar":["褒衣博带"],"usage":"作宾语、定语；指古代儒生的装束"},{"id":40240,"word":"褒衣缓带","pinyin":"bāo yī huǎn dài","abbr":"byhd","explanation":"褒：阔。宽衣大带。指古代儒生的装束。","source":{"text":"博带褒衣，革履高冠。","book":"《新唐书·刘知畿传》"},"similar":["褒衣博带"],"usage":"作宾语、定语；指古代儒生的装束"},{"id":40241,"word":"褒贤遏恶","pinyin":"bāo xián è è","abbr":"bxee","explanation":"褒：赞扬；遏：阻止。赞扬好的，阻止坏的。","source":{"text":"公之文章，大抵以立宪诫世，褒贤遏恶为用，故论议最长。","book":"唐·崔祐甫《唐故常州刺史独孤公神道碑铭序》"},"similar":["抑恶扬善"],"usage":"作谓语、宾语、定语；指社会风气"},{"id":40242,"word":"褒贬与夺","pinyin":"bǎo biǎn yǔ duó","abbr":"bbyd","explanation":"与夺：给予或夺取。指对人或事物给予赞扬或批评。","source":{"text":"每见世人有好论人物者，比方伦匹，未必当允，而褒贬与夺，或失准格。","book":"晋·葛洪《抱朴子·外篇自叙》"},"example":{"text":"若使修著一代之典，～，诚一时之俊也。","book":"《晋书·祖逖传》"},"usage":"作宾语、定语；指对人的态度"},{"id":40243,"word":"褒采一介","pinyin":"bāo cǎi yī jiè","abbr":"bcyj","explanation":"褒：褒奖；采：采用；一介：微小。有细小的长处也可以褒奖、采用。","source":{"text":"褒采一介，抽扬小善。","book":"南朝·齐·谢朓《辞随王子隆牋》"},"usage":"作宾语；指人的优缺点"},{"id":40244,"word":"褕衣甘食","pinyin":"yú yī gān shí","abbr":"yygs","explanation":"褕衣：美衣。穿漂亮衣服，吃美味食品。","source":{"text":"农夫莫不辍耕释耒，褕衣甘食，倾耳以待命者。","book":"《史记·淮阴侯列传》"}},{"id":40245,"word":"褚小怀大","pinyin":"zhǔ xiǎo huái dà","abbr":"zxhd","explanation":"褚：口袋。用小口袋装大东西。比喻能力不能胜任。","source":{"text":"褚小者不可以怀大，绠短者不可以汲深。","book":"战国·宋·庄周《庄子·至乐》"},"similar":["力不能及"],"usage":"作谓语、定语；指力不能及"},{"id":40246,"word":"褚小杯大","pinyin":"zhǔ xiǎo bēi dà","abbr":"zxbd","explanation":"用小口袋装大东西。比喻能力不能胜任。","source":{"text":"褚小者不可以怀大，绠短者不可以汲深。","book":"《庄子·至乐》"}},{"id":40247,"word":"褦襶触热","pinyin":"nài dài chù rè","abbr":"ndcr","explanation":"褦襶：粗重胆肥大的衣服。大热天穿着粗重肥大的衣服。比喻不晓事理，不知进退。","source":{"text":"今世褦襶子，触热到人家。","book":"晋·程晓《嘲热客》"}},{"id":40248,"word":"褪前擦后","pinyin":"tuì qián cā hòu","abbr":"tqch","explanation":"褪：后退。从前面退下来又碰到后面的。形容惊恐不安。","source":{"text":"怕的是严城夜禁天街净，响当当喝号提铃，唬的我褪前擦后不敢行。","book":"明·冯惟敏《僧尼共犯》第三折"},"usage":"作谓语、状语；指惊恐不安"},{"id":40249,"word":"褪后趋前","pinyin":"tuì hòu qū qián","abbr":"thqq","explanation":"形容前前后后向人献殷勤。","source":{"text":"你道是如何发付，我索避着不做。我这里敛袂回身，褪后趋前，眼笑眉舒。","book":"元·贾仲明《荆楚臣重对玉梳记》第三折"},"example":{"text":"不由我不心惊胆战，索陪着笑脸儿～。","book":"元·无名氏《碧桃花》第三折"}},{"id":40250,"word":"褫其华衮，示人本相","pinyin":"chǐ qí huá gǔn，shì rén běn xiàng","abbr":"cqhgsrbx","explanation":"褫：剥夺；衮：礼服；示：展示。剥开华美的外衣，在人前显示本来面目。比喻揭穿别人的伪装。","source":{"text":"此种物件，都须褫其华衮，示人本相，庶青年不再乌烟瘴气，莫名其妙。","book":"鲁迅《书信集·至曹聚仁》"},"usage":"作谓语、定语；用于书面语"},{"id":40251,"word":"褰裳躩步","pinyin":"qiān cháng jué bù","abbr":"qsjb","explanation":"褰：把衣服提起来；躩步：快步疾走。提着衣服小心地快步疾走。形容谨慎而匆忙的样子。","source":{"text":"庄周曰：‘此何鸟哉，翼殷不逝，目不大睹？’褰裳躩步，执弹而留之。","book":"《庄子·山木》"}},{"id":40252,"word":"褴褛筚路","pinyin":"lán lǚ bì lù","abbr":"llbl","explanation":"指穿着破衣，驾着柴车，开发山林，形容开创者的艰辛。","source":{"text":"筚路蓝缕，以启山林。","book":"先秦·左丘明《左传·宣公十二年》"},"example":{"text":"又被注者摘索无遗，不得不～，逃之无何有之乡。","book":"清·周亮工《与某书》"},"similar":["筚路蓝缕"],"usage":"作谓语、定语；指开创者的艰辛","story":["春秋时期，楚庄王率军攻打郑国，郑国派大夫皇戍到晋国求援，并称楚人很骄傲，现在出兵可以大败楚军。下军副将栾书极力反对，说楚王灭庸以后经常教育百姓不要忘记楚国先君若敖开创基业时筚路蓝缕的生活。晋国出兵，结果被楚军打败"]},{"id":40253,"word":"襟怀坦白","pinyin":"jīn huái tǎn bái","abbr":"jhtb","explanation":"襟怀：胸怀；坦白：正直无私。形容心地纯洁，光明正大。","source":{"text":"贯之性质粹美，襟怀坦夷，凝静有常。","book":"宋·黄榦《黄勉斋文集·七·祭李贯之》"},"example":{"text":"一个共产党员，应该是～，忠实，积极，以革命利益为第一生命，以个人利益服从革命利益。","book":"毛泽东《反对自由主义》"},"similar":["胸无城府","光明正大"],"opposite":["心怀叵测","两面三刀"],"usage":"作谓语、宾语、定语；形容心地纯洁"},{"id":40254,"word":"襟怀洒落","pinyin":"jīn huái sǎ luò","abbr":"jhsl","explanation":"襟怀：胸怀；洒落：洒脱。心情坦率，光明正大。","source":{"text":"不妄与人交，而襟怀洒落，人自受之。","book":"宋·周必大《益公题跋·三·跋唐子西贴》"},"usage":"作谓语、宾语；用于为人"},{"id":40255,"word":"襟怀磊落","pinyin":"jīn huái lěi luò","abbr":"jhll","explanation":"襟怀：胸怀；磊落：光明正大。心怀坦荡，光明磊落。","source":{"text":"弟之襟怀磊落，交游敬之。","book":"宋·胡梦昱《竹林愚隐集·象州祭弟利用行十八文》"},"example":{"text":"清·褚人获《隋唐演义》第54回：“大丈夫当～，妾见君家何多不豫之色？”"},"similar":["襟怀坦白"],"opposite":["两面三刀"],"usage":"作宾语、定语；用于为人"},{"id":40256,"word":"襟江带湖","pinyin":"jīn jiāng dài hú","abbr":"jjdh","explanation":"襟：衣襟；带：衣带。形容江河湖泊之间相互萦绕交错，如同衣襟和衣带一样。","source":{"text":"襟三江而带五湖。","book":"唐·王勃《滕王阁序》"},"example":{"text":"吴方破蜀，上下齐心，况复～，到处可守，不如缓攻为是。","book":"蔡东藩《后汉演义》第九十一回"},"usage":"作宾语、定语；用于比喻句"},{"id":40257,"word":"襟裾马牛","pinyin":"jīn jú mǎ niú","abbr":"jjmn","explanation":"像马牛穿上人的衣服。比喻没有头脑和无知。","source":{"text":"人不通古今，马牛而襟裾。","book":"语出唐·韩愈《符读书城南》诗"},"example":{"text":"厌～，笑衣冠沐猴。","book":"元·汪元亨《朝天子·归隐》曲"},"similar":["裾马襟牛"],"usage":"作宾语、定语；用于骂人等"},{"id":40258,"word":"西台痛哭","pinyin":"xī tái tòng kū","abbr":"xttk","explanation":"宋末文天祥抗元失败被害。八年后，谢翱与友人登西台痛哭致祭，并作《登西台恸哭记》以记其事。后用以称亡国之痛。","source":{"text":"西台痛哭谢晞发，眢井沉书郑亿翁。","book":"柳弃疾《怀人诗》之四"},"example":{"text":"风流十年无遗爱，谁解～诗。","book":"叶叶《书壬子宫驼记后》诗"},"usage":"作宾语、定语；用于书面语","story":["宋朝末年，爱国将领文天祥抗元失败后被害在西台。八年后，谢翱与友人登上西台缅怀与祭奠文天祥，痛哭流涕，并作挽词《登西台恸哭记》记述其事，抒发亡国之痛及对文天祥的崇拜之情"]},{"id":40259,"word":"西子捧心","pinyin":"xī zǐ pěng xīn","abbr":"xzpx","explanation":"指美女之病态，愈增其妍。","source":{"text":"故西施病心而矉其里，其里之丑人见而 美之，归亦捧心而矉其里。其里之富人见之，坚闭门而不出；贫人见之，挈妻子而去之走。彼知矉美，而不知矉之所以美。","book":"《庄子·天运》"},"example":{"text":"～，孙寿折腰。","book":"五代·李瀚《蒙求》诗"},"similar":["西施捧心"],"usage":"作宾语、定语；用于比喻句","story":["春秋时期，越国美女西施身材苗条，唇红齿白，十分漂亮，由于有心痛的毛病，犯病时常用手捧心口皱眉头，看起来十分妩媚动人。邻居丑女东施见了也学她那样做，人们见了，觉得东施更加丑陋难看，纷纷避开她"]},{"id":40260,"word":"西学东渐","pinyin":"xī xué dōng jiàn","abbr":"xxdj","explanation":"渐：流入；东渐：原指河水东流入海，引申为向东方流传。西方的自然科学和社会科学向东方流传。","source":{"text":"东渐于海。","book":"《尚书·禹贡》"},"usage":"作宾语、定语；用于文化等"},{"id":40261,"word":"西山日薄","pinyin":"xī shān rì bó","abbr":"xsrb","explanation":"薄：逼近。太阳快要落山。比喻事物接近衰亡或人近老年。亦作“日薄西山”、“西山日迫”。","source":{"text":"世事几番新局面，看底却高三著。况转首，西山日薄。","book":"宋·洪咨夔《贺新郎·谁识昂昂鹤》词"},"similar":["日薄西山","西山日迫"],"usage":"作谓语、宾语、补语；指临近死亡"},{"id":40262,"word":"西山日迫","pinyin":"xī shān rì pò","abbr":"xsrp","explanation":"比喻事物接近衰亡或人近老年。同“西山日薄”。","source":{"text":"堪叹的是西山日迫桑榆暮，喜的是高堂月旦芝兰聚。","book":"元·无名氏《九世同居》第一折"},"similar":["西山日薄"],"usage":"作谓语、宾语、补语；指临近死亡"},{"id":40263,"word":"西山饿夫","pinyin":"xī shān è fū","abbr":"xsef","explanation":"传说周武王灭商后，伯夷、叔齐逃到首阳山，不食周粟而死。后用“西山饿夫”指伯夷、叔齐。","source":{"text":"之遴尝闻夷、柳惠，不逢仲尼一言，则西山饿夫、东国黜土，名岂施于后世。","book":"《梁书·刘显传》"},"example":{"text":"唐·刘轲《重与刘宾虞书》：“不然，则东国绌臣、～，微仲尼，何伤为展季、伯夷矣。”"},"usage":"作宾语、定语；用于比喻句","story":["商朝末年，孤竹君的长子伯夷在父亲死后坚决不肯继承王位。后来商朝灭亡，周武王建立周朝，他也不愿出来为官，感到十分耻辱，就与弟弟叔齐决定不再吃周朝的粮食，两人隐居在首阳山，专门靠吃采山上的野果及野菜，最后饿死在山中"]},{"id":40264,"word":"西市朝衣","pinyin":"xī shì cháo yī","abbr":"xscy","explanation":"西市：指北京菜市口，明、清两代在那里处决犯人；朝衣：古代官员上朝时所穿的礼服。指大臣被杀。","source":{"text":"乃使中尉召错，给载行市。错衣朝衣斩东市。","book":"东汉·班固《汉书·爰盎晁错传》"},"usage":"作宾语、定语；用于书面语"},{"id":40265,"word":"西方净国","pinyin":"xī fāng jìng guó","abbr":"xfjg","explanation":"指西方净土。","source":{"text":"西方净国未可到，下笔绮语何漓漓。","book":"清·龚自珍《西郊落花歌》"},"similar":["西方净土"],"usage":"作宾语；指西方净土"},{"id":40266,"word":"西方净土","pinyin":"xī fāng jìng tǔ","abbr":"xfjt","explanation":"佛教语。西方之极乐世界，即佛国。","source":{"text":"唐·李白有《金银泥画西方净土变相赞》诗。"},"example":{"text":"朕当初多少英雄，赤手打成天下，身登九五，威倾朝野。也只为孽海无边，冤愆有报，故此皈依我佛，要目圆寂后，径归～极乐世界，莲花化生。","book":"明·方汝浩《禅真逸"},"similar":["极乐世界","西方净国"],"usage":"作主语、宾语、定语；用于佛教等"},{"id":40267,"word":"西施捧心","pinyin":"xī shī pěng xīn","abbr":"xspx","explanation":"西施：春秋越国美女。指美女病态更加娇美。","source":{"text":"故西施病心而颦其里，其里之丑人见而美之。","book":"战国·宋·庄周《庄子·天运》"},"example":{"text":"～而颦，邻人笑之，人皆弃而走。","book":"宋·马永卿《懒真子》第一卷"},"similar":["西子捧心"],"usage":"作宾语、定语；用于比喻句","story":["春秋时期，越国美女西施身材苗条，唇红齿白，十分漂亮，由于有心痛的毛病，犯病时常用手捧心口皱眉头，看起来十分妩媚动人。邻居丑女东施见了也学她那样做，人们见了，觉得东施更加丑陋难看，纷纷避开她"]},{"id":40268,"word":"西歪东倒","pinyin":"xī wāi dōng dǎo","abbr":"xwdd","explanation":"歪：偏斜。指身不由己，倾斜不稳。也形容物体倾斜不牢固。","source":{"text":"柱肚撑肠酒力催，西歪东倒脚高低。","book":"明·胡文焕《群音类选·刘郎中》"},"similar":["东倒西歪"],"opposite":["整整齐齐"],"usage":"作谓语、定语、状语；指不整齐"},{"id":40269,"word":"西河之痛","pinyin":"xī hé zhī tòng","abbr":"xhzt","explanation":"指丧子之痛。","source":{"text":"孔子既没，子夏居西河教授，为魏文侯师。其子死，哭之失明。","book":"《史记·仲尼弟子列传》"},"example":{"text":"知道傩寿先生具～，又因着家中病人非傩寿先生亲来诊视不成。","book":"沈从文《好管闲事的人·爹爹》"},"similar":["丧明之痛"],"usage":"作宾语；用于书面语"},{"id":40270,"word":"西狩获麟","pinyin":"xī shòu huò lín","abbr":"xshl","explanation":"《左传·哀公十四年》：“十有四年春，西狩获麟。”","source":{"text":"老爷便从“麟现阙里”起，一直讲到“～”。 ★清·文康《儿女英雄传》第三十八回"},"example":{"text":"老爷便从“麟现阙里”起，一直讲到“～”。","book":"清·文康《儿女英雄传》第三十八回"}},{"id":40271,"word":"西眉南脸","pinyin":"xī méi nán liǎn","abbr":"xmnl","explanation":"春秋时美女西施的眉和南威的脸。后泛指美丽的女子。","source":{"text":"西眉南脸人中美，或者皆闻无所利。","book":"唐·李咸用《巫山高》"},"usage":"作宾语、定语；用于比喻句"},{"id":40272,"word":"西窗剪烛","pinyin":"xī chuāng jiǎn zhú","abbr":"xcjz","explanation":"原指思念远方妻子，盼望相聚夜语。后泛指亲友聚谈。","source":{"text":"何当共剪西窗烛，却话巴山夜雨时。","book":"唐·李商隐《夜雨寄北》诗"},"example":{"text":"待归来细问当年事，有谁念残香冷腻，共话却潦倒～时。","book":"明·陈汝元《金莲记·便省》"},"similar":["剪烛西窗"],"usage":"作宾语；指亲友聚谈","story":["唐朝时期，诗人李商隐任东川节度使柳仲郢幕僚，四川一向多雨多雾，阴雨绵绵。他身处异乡，面对秋雨夜深人静，勾起对妻子的怀念，作诗《夜雨寄北》诗：“君问归期未有期，巴山夜雨涨秋池。何当共剪西窗烛，却话巴山夜雨时。”"]},{"id":40273,"word":"西装革履","pinyin":"xī zhuāng gé lǚ","abbr":"xzgl","explanation":"身穿西装，脚穿皮鞋。形容衣着入时。","source":{"text":"这位‘管乐’西服革履，趾高气扬。后来忽然低头丧气起来。","book":"孙犁《澹定集摘抄》"},"example":{"text":"～、华裙艳服，只有在演出的时候演员的身上才出现。","book":"吴伯箫《记一辆纺车》"},"usage":"作主语、宾语、定语；指人的穿着"},{"id":40274,"word":"西赆南琛","pinyin":"xī jìn nán chēn","abbr":"xjnc","explanation":"谓四方皆来朝贡为“西赆南琛”。赆，贡物。琛，珍宝。","source":{"text":"西赆浮玉，南琛没羽。吴歈越吟， 荆艳楚舞。","book":"北周·庾信《哀江南赋》"},"example":{"text":"～，无闻竹素。","book":"《南史·夷貊传论》"},"usage":"作宾语、定语；用于书面语"},{"id":40275,"word":"西邻责言","pinyin":"xī lín zé yán","abbr":"xlzy","explanation":"西邻：西部的邻国；责言：问罪的话。原指秦国（在西）向晋国（在东）问罪。后泛指别人的责备。","source":{"text":"西邻责言，不可偿也。","book":"《左传·僖公十五年》"},"example":{"text":"西邻方责言，东市又相斫。","book":"清·黄遵宪《番客篇》"},"usage":"作宾语；泛指别人的责备"},{"id":40276,"word":"西除东荡","pinyin":"xī chú dōng dàng","abbr":"xcdd","explanation":"到处征剿。形容身经百战。","source":{"text":"他待要南征北讨，西除东荡，廝杀相持。问甚抡枪使剑，挟人捉将，扯鼓夺旗。","book":"元·李寿卿《伍员吹萧》第一折：“俺也曾西除东荡，把功劳立下几桩桩。”元·张国宾《薛仁贵》第三折"},"example":{"text":"想我年纪小时，南讨北征，～，鞍不离身，甲不离马背，多曾建功来。","book":"明·无名氏《十样锦》第二折"},"similar":["南征北战"],"usage":"作谓语、宾语；指到处征战"},{"id":40277,"word":"西颦东效","pinyin":"xī pín dōng xiào","abbr":"xpdx","explanation":"西施捧心、东施效颦。比喻以丑陋学美好而愈显其丑。","source":{"text":"西颦东效，没来由把国民价值扫地尽了。","book":"清·无名氏《少年登场》"},"similar":["西施捧心","东施效颦"],"usage":"作宾语、定语；用于比喻句","story":["春秋时期，越国美女西施身材苗条，唇红齿白，十分漂亮，由于有心痛的毛病，犯病时常用手捧心口皱眉头，看起来十分妩媚动人。邻居丑女东施见了也学她那样做，人们见了，觉得东施更加丑陋难看"]},{"id":40278,"word":"西风斜阳","pinyin":"xī fēng xié yáng","abbr":"xfxy","explanation":"形容秋天傍晚的景象。","source":{"text":"则你那路途迢遥，趁西风斜阳古道。","book":"元·无名氏《千里独行》第三折"},"similar":["西风残照"],"usage":"作宾语、定语；多用于比喻句"},{"id":40279,"word":"西风残照","pinyin":"xī fēng cán zhào","abbr":"xfcz","explanation":"秋天的风，落日的光。比喻衰败没落的景象。多用来衬托国家的残破和心境的凄凉。”","source":{"text":"乐游原上清秋节，咸阳古道音尘绝。音尘绝，西风残照，汉家陵阙。","book":"唐·李白《忆秦娥》词"},"example":{"text":"～旧山河，故国遗台忆独过。","book":"元·王恽《望歌风台》诗"},"similar":["西风斜阳"],"usage":"作宾语、定语；多用于比喻句"},{"id":40280,"word":"西风落叶","pinyin":"xī fēng luò yè","abbr":"xfly","explanation":"形容秋天的景象。多比喻人或事物已趋衰落。","source":{"text":"秋风吹渭水，落叶满长安。","book":"唐·贾岛《忆江上吴处士》"},"example":{"text":"蚂蚁缘槐夸大国，蚍蜉撼树谈何易。正～下长安，飞鸣镝。","book":"毛泽东《满江红·和郭沫若同志》词"},"usage":"作宾语、定语；用于比喻句"},{"id":40281,"word":"西风贯驴耳","pinyin":"xī fēng guàn lǘ ěr","abbr":"xfgle","explanation":"贯：穿过。比喻听话的人认为无关紧要，不值得一听的话。","source":{"text":"李白答王去一诗‘有如东风射马耳’，按守元人又有‘西风贯马耳’语，当即因此转变。","book":"清·翟灏《通俗编》卷一"}},{"id":40282,"word":"西食东眠","pinyin":"xī shí dōng mián","abbr":"xsdm","explanation":"在西家吃饭，在东家睡觉。比喻贪利的人企图兼有两利。","source":{"text":"别人知道是性命交关的事，又谁敢多嘴，倒放骥东兼收并蓄，西食东眠，安享一年多的艳福了。","book":"清·曾朴《孽海花》第三十一回"},"similar":["东食西宿"],"usage":"作谓语、定语；比喻唯利是图，贪得无厌"},{"id":40283,"word":"西鹣东鲽","pinyin":"xī jiān dōng dié","abbr":"xjdd","explanation":"鹣：比翼鸟；鲽：比目鱼。泛指四海珍异之物。","source":{"text":"然则西鹣东鲽，南茅北黍，空谈非征，勋德而已。","book":"南朝·宋·刘勰《文心雕龙·封禅》"},"example":{"text":"～伫云亭，百神受职惟德馨。","book":"清·黄景仁《平金川饶歌》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":40284,"word":"要价还价","pinyin":"yào jià huán jià","abbr":"yjhj","explanation":"买卖东西，卖主要价高，买主给价低，双方要反复争议。也比喻在进行谈判时反复争议，或接受任务时讲条件。"},{"id":40285,"word":"要利盗名","pinyin":"yào lì dào míng","abbr":"yldm","explanation":"以不正当手段逐取名利。","source":{"text":"盖其心术不谨，趋向一差，则要利盗名，文奸济恶，皆学之力也。","book":"金·王若虚《论语辨惑二》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":40286,"word":"要好成歉","pinyin":"yào hǎo chéng qiàn","abbr":"yhcq","explanation":"指好意反而招怨。","source":{"text":"真是冤天屈地，要好成歉。","book":"明·凌濛初《初刻拍案惊奇》卷八"},"example":{"text":"～的滋味真是令人难受"},"similar":["为好成歉"],"usage":"作谓语、定语；比喻好心得不到好报"},{"id":40287,"word":"要宠召祸","pinyin":"yāo chǒng zhāo huò","abbr":"yczh","explanation":"要：通“邀”，求取；召：招。希求得到过分的宠爱就会招致祸患。","source":{"text":"幸门一开，争言祈祷，要宠召祸，实基于此，祝文不敢奉诏。","book":"《明史·刘吉传》"},"usage":"作谓语、定语；用于处事"},{"id":40288,"word":"要害之地","pinyin":"yào hài zhī dì","abbr":"yhzd","explanation":"要害：人体上能致命的部位，比喻军事上处于至关重要位置的地方。多比喻军事战略要地。亦作“要害之处”。","source":{"text":"凡东北一带要害之地，皆其统辖，声势强盛。","book":"清·褚人获《隋唐演义》第83回"},"example":{"text":"我们不能轻易放过这～。"},"similar":["要害之处"],"usage":"作主语、宾语；指重要的地方"},{"id":40289,"word":"要害之处","pinyin":"yào hài zhī chù","abbr":"yhzc","explanation":"处于极为重要的位置。","source":{"text":"良将劲弩而守要害之处。","book":"汉·贾谊《过秦论上》"},"example":{"text":"我们击中了他的～。"},"similar":["要害之地"],"usage":"作主语、宾语；指重要的地方"},{"id":40290,"word":"要死不活","pinyin":"yào sǐ bù huó","abbr":"ysbh","explanation":"半死不活。","example":{"text":"这～的庄稼终于蔫了。"},"similar":["半死不活"],"opposite":["生机勃勃"],"usage":"作谓语、定语；指半死不活"},{"id":40291,"word":"要死要活","pinyin":"yào sǐ yào huó","abbr":"ysyh","explanation":"形容闹得很凶。","source":{"text":"那婆娘索性抓破脸皮，反要死要活，分毫不让。","book":"明·冯梦龙《醒世恒言》第二十七卷"},"example":{"text":"虔婆也慌了，叫了老乌龟上来，再三劝解，总是不肯依，闹的～。","book":"清·吴敬梓《儒林外史》第五十四回"},"similar":["寻死觅活"],"usage":"作定语、状语；指吵架寻短见"},{"id":40292,"word":"要而言之","pinyin":"yào ér yán zhī","abbr":"yeyz","explanation":"要：简要。概括地说，简单地说。","source":{"text":"且要而言之，五等之君为己思治，郡县之长为利图物。","book":"晋·陆机《五等论》"},"example":{"text":"～，《全上古文》实在是大而无当的书，可供陈列而不适于实用的。（鲁迅《书信集·致章廷谦》）"},"similar":["总而言之","要而论之"],"usage":"作分句；同“总而言之”"},{"id":40293,"word":"要而论之","pinyin":"yào ér lùn zhī","abbr":"yelz","explanation":"犹言要而言之。概括地说，简单地说。","source":{"text":"要而论之，满人之人中国也，据其土地山河，窃棋子女玉帛……固古人所谓倒行逆施者矣。","book":"《天讨·豕韦之裔〈普告汉人〉》"},"example":{"text":"～，法者天下之公器也，变者天下之公理也。","book":"梁启超《论不变法之害》"},"similar":["要而言之","总而言之"],"usage":"作分句；用于总结文章等"},{"id":40294,"word":"要言不烦","pinyin":"yào yán bù fán","abbr":"yybf","explanation":"要：简要；烦：烦琐。指说话或写文章简单扼要，不烦琐。","source":{"text":"晏含笑而赞之曰：‘可谓要言不烦也。’","book":"《三国志·魏书·管辂传》"},"example":{"text":"是的，那——《中国国粹义务论》，真真～，百读不厌！","book":"鲁迅《彷徨·高老夫子》"},"similar":["言简意赅","简明扼要"],"opposite":["长篇大论","洋洋洒洒","拖泥带水"],"usage":"作谓语、宾语；用于书面语","story":["三国时期魏国少府丞管辂精通天文地理及《易经》和占卜术，吏部尚书何晏请管辂到家中作客，朋友邓先生请管辂谈谈《易经》中的义理。管辂要言不烦地回答他的问题，并为他们占了一卦，均为凶兆。果然十天后，他们俩被司马懿杀害"]},{"id":40295,"word":"要言不繁","pinyin":"yào yán bù fán","abbr":"yybf","explanation":"要：简要；繁：繁多。指说话或写文章简单扼要，不烦琐。","source":{"text":"晏含笑而赞之曰：‘可谓要言不烦也。’","book":"《三国志·魏书·管辂传》裴松之注引《管辂别传》"},"example":{"text":"“是！”陈汤～地答说：“第一、请示行期；第二、报告长公主，毛延寿已经就捕。”","book":"高阳《王昭君》第三十章"},"similar":["要言不烦"],"usage":"作谓语、宾语；用于书面语"},{"id":40296,"word":"要言妙道","pinyin":"yào yán miào dào","abbr":"yymd","explanation":"要：重要，中肯；妙：神妙，深微。中肯的名言，深微的道理。","source":{"text":"今太子之病，可无药石针刺灸疗而已，可以要言妙道说而去也。","book":"汉·枚乘《七发》"},"example":{"text":"有～，往问北山愚。","book":"宋·辛弃疾《六州歌头》词"},"usage":"作主语、宾语、定语；指中肯的名言，深微的"},{"id":40297,"word":"覆亡无日","pinyin":"fù wáng wú rì","abbr":"fwwr","explanation":"马上就会灭亡，已经没有可以推延的时间了。","source":{"text":"四夷交侵，覆亡无日，非维新变旧，不能自强。","book":"《清史稿·康有为传》"},"example":{"text":"夜中彷徨，焦思达旦，窃虑～。","book":"蔡东藩《民国通俗演义》第90回"},"usage":"作谓语、宾语；指马上就会灭亡"},{"id":40298,"word":"覆公折足","pinyin":"fù gōng zhé zú","abbr":"fgzz","explanation":"比喻不胜重任，败坏公事。","source":{"text":"鼎折足，覆公餗。","book":"《周易·鼎》"},"example":{"text":"太尉樊裬，司徒许相，皆窃位怀禄，苟进无耻，终无匡救之益，必有～之患。","book":"晋·袁宏《后汉纪·献帝纪》"},"usage":"作宾语、定语；用于书面语"},{"id":40299,"word":"覆军杀将","pinyin":"fù jūn shā jiàng","abbr":"fjsj","explanation":"覆：消灭。军队被消灭，将领被杀死。","source":{"text":"故战之道，有多杀人而不得将卒者，有得将卒而不得舍者，有得舍而不得将军者，有覆军杀将者。","book":"《孙膑兵法·月战》"},"example":{"text":"凡南方之事，卒至于破十余州，～，丧元元之命，竭山海之财者，非其变发于隐伏，而起于仓卒也。","book":"宋·曾巩《与孙同封书》"},"usage":"作谓语、定语；用于战败"},{"id":40300,"word":"覆前戒后","pinyin":"fù qián jiè hòu","abbr":"fqjh","explanation":"覆：倾覆；戒：防备。指前面事情的失败可以为后面事情的借鉴。","source":{"text":"览古人成败之所由，鉴既往存亡之异轨，覆前戒后，居安思危。","book":"《旧唐书·王方庆传》"},"similar":["前车之鉴"],"usage":"作宾语、定语；用于处事"},{"id":40301,"word":"覆去翻来","pinyin":"fù qù fān lái","abbr":"fqfl","explanation":"形容一次又一次。也形容来回翻动身体。","source":{"text":"终宵无寐。覆去翻来真个是。屈指归期。","book":"宋·赵长卿《减字木兰花》词"},"example":{"text":"恶暖憎寒，～病几般。","book":"明·全道人《懒画眉》"},"similar":["翻来覆去"],"usage":"作谓语、状语；指来回翻动身体"},{"id":40302,"word":"覆地翻天","pinyin":"fù dì fān tiān","abbr":"fdft","explanation":"指发生极大的事。也比喻亡国。","source":{"text":"天翻地覆谁得知，如今正南看北斗。","book":"唐·刘商《胡茄十八拍》诗"},"example":{"text":"你道他两个～，射影吹沙，舞爪张牙，那恢恢天网，终久还他带锁披枷。","book":"明·杨珽《龙膏记·脱难》"},"similar":["翻天覆地"],"usage":"作谓语、定语；比喻巨大的变化"},{"id":40303,"word":"覆宗灭祀","pinyin":"fù zōng miè sì","abbr":"fzms","explanation":"宗：祖庙；祀：祭祀；灭祀：灭了香火，引申为绝后。毁坏宗庙，断绝后代。","source":{"text":"晋获骊戎，毙怀恭子，有夏取仍覆宗灭祀。","book":"汉·张超《诮青衣赋》"},"similar":["覆宗绝嗣"],"usage":"作宾语、定语；指灭亡"},{"id":40304,"word":"覆宗绝嗣","pinyin":"fù zōng jué sì","abbr":"fzjs","explanation":"宗：祖庙；嗣：后代；绝嗣：灭了香火，引申为绝后。毁坏宗庙，断绝后代。","source":{"text":"晋获骊戎，毙怀恭子，有夏取仍覆宗灭祀。","book":"汉·张超《诮青衣赋》"},"similar":["覆宗灭祀"],"usage":"作宾语、定语；指灭亡"},{"id":40305,"word":"覆巢倾卵","pinyin":"fù cháo qīng luǎn","abbr":"fcql","explanation":"覆：翻。翻倒鸟窝，破碎鸟蛋。比喻毁灭性的打击降临于众时，无一可以幸免。","source":{"text":"覆巢倾卵之中，笺传《燕子》，焚屋沉舟之际，唱出《春灯》。","book":"柳亚子《二十世纪大舞台发刊词》"},"similar":["覆巢破卵","覆巢毁卵"],"usage":"作宾语、定语；用于整体与个体的关系"},{"id":40306,"word":"覆巢无完卵","pinyin":"fù cháo wú wán luǎn","abbr":"fcwwl","explanation":"覆：翻倒。翻倒的鸟窝里不会有完好的卵。比喻灭门大祸，无一幸免。又比喻整体毁灭，个体也不能幸存。","source":{"text":"大人，岂见覆巢之下复有完卵乎？","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"你是知道～的结局的。"},"similar":["覆巢破卵"],"usage":"作定语、分句；比喻整体毁灭，个体不能幸存","story":["东汉末年，北海相孔融反对曹操率50万大军征讨刘备与孙权，御史大夫向来与孔融不合，在曹操面前添油加醋，恶意挑拨。曹操大怒，命人逮捕孔融全家，孔融的孩子无动于衷，也不逃跑，说：“大人，岂见覆巢之下复有完卵乎？”"]},{"id":40307,"word":"覆巢毁卵","pinyin":"fù cháo huǐ luǎn","abbr":"fchl","explanation":"覆：翻倒；巢：鸟窝；毁：破坏；卵：蛋。翻倒了鸟窝，打破了鸟蛋。比喻整体毁灭了，各部分都不复存在。","source":{"text":"臣闻之：有覆巢毁卵而凤皇不翔，刳胎焚夭碢骐驎不至。","book":"《战国策·赵策四》"},"example":{"text":"西汉·刘向《战国策·赵策》：“有～，而凤皇不翔。”"},"similar":["覆巢破卵","覆巢倾卵"],"usage":"作宾语、定语；用于整体与个体的关系"},{"id":40308,"word":"覆巢破卵","pinyin":"fù cháo pò luǎn","abbr":"fcpl","explanation":"覆：翻；破：打破。翻倒鸟窝，破碎鸟蛋。比喻毁灭性的打击降临于众时，无一可以幸免。","source":{"text":"秦以刑罚为巢，故有覆巢破卵之患。","book":"汉·陆贾《新语·辅政》"},"similar":["覆巢毁卵","覆巢倾卵"],"usage":"作宾语、定语；用于整体与个体的关系"},{"id":40309,"word":"覆是为非","pinyin":"fù shì wéi fēi","abbr":"fswf","explanation":"是：正确的；非：错误的。把正确的翻过来当成错误的。","source":{"text":"谗言乱国，覆是为非，伯奇乖难，恭子忧哀。","book":"汉·焦延寿《易林·丰之鼎》"},"similar":["颠倒是非"],"usage":"作谓语、定语；指故意颠倒"},{"id":40310,"word":"覆水不收","pinyin":"fù shuǐ bù shōu","abbr":"fsbs","explanation":"覆：倒。倒在地上的水难以收回。比喻事情已成定局，无法挽回。","source":{"text":"国家之事易可容易？覆水不收，宜深思之。","book":"《后汉书·何进传》"},"example":{"text":"晋·潘岳《伤弱子辞》：“叶落永离，～，赤子何辜，罪我之由？”"},"similar":["覆水难收"],"usage":"作谓语、宾语、分句；比喻事情已成定局"},{"id":40311,"word":"覆水难收","pinyin":"fù shuǐ nán shōu","abbr":"fsns","explanation":"覆：倒。倒在地上的水难以收回。比喻事情已成定局，无法挽回。","source":{"text":"国家之事易可容易？覆水不收，宜深思之。","book":"《后汉书·何进传》"},"example":{"text":"如此才人，足以快婚，尔女已是～，何不宛转成就了他。","book":"明·凌濛初《初刻拍案惊奇·通闺闼坚心灯火》"},"similar":["木已成舟","驷马难追"],"opposite":["破镜重圆"],"usage":"作谓语、宾语、分句；比喻事情已成定局","story":["商朝时期，姜尚（姜太公）才学过人，精通兵法，但因家贫，他的妻子马氏见他年老没出息就离开他，他只好到渭水边搭茅屋钓鱼为生，周文王拜他为国师，姜太公助周文王灭了商朝，他的妻子要求复合，他取一盆水泼地如能收回就复合"]},{"id":40312,"word":"覆海移山","pinyin":"fù hǎi yí shān","abbr":"fhys","explanation":"翻转大海，移动大山。形容力量巨大。","source":{"text":"阿修罗众圣偏殊，覆海移山功力大，上住须弥福德强，平扶日月感神煞。","book":"《敦煌变文集·维摩诘经讲经文》"},"usage":"作定语；形容力量巨大"},{"id":40313,"word":"覆瓿之用","pinyin":"fù bù zhī yòng","abbr":"fbzy","explanation":"覆：盖；瓿：古代容器，用陶或青铜制成。用来盖瓿。形容著作没有什么价值，只能用来盖盛酱的瓦罐。","source":{"text":"空自苦，今学者又禄利，然尚不能明《易》，又如《玄》何！吾恐后人用覆酱瓿也。","book":"《汉书·扬雄传下》"},"example":{"text":"著书反供～，虽多亦奚以为？","book":"清·李渔《曲话·结构》"}},{"id":40314,"word":"覆盂之固","pinyin":"fù yú zhī gù","abbr":"fyzg","explanation":"象覆置的盂那样安稳。形容稳固，不可动摇。","source":{"text":"天下震慑，诸侯宾服，连四海之外以为带，安于覆盂。","book":"汉·东方朔《答客难》"},"similar":["覆盂之安"],"usage":"作宾语；用于比喻句"},{"id":40315,"word":"覆盂之安","pinyin":"fù yú zhī ān","abbr":"fyza","explanation":"象覆置的盂那样安稳。形容稳固，不可动摇。","source":{"text":"天下震慑，诸侯宾服，连四海之外以为带，安于覆盂。","book":"汉·东方朔《答客难》"},"example":{"text":"四海有～。","book":"唐·张说《开元正历握乾符颂》"},"similar":["覆盂之固"],"usage":"作宾语；用于比喻句"},{"id":40316,"word":"覆盆之冤","pinyin":"fù pén zhī yuān","abbr":"fpzy","explanation":"翻过来放的盆子，阳光照不到里面。形容无处申诉的冤枉。","source":{"text":"周孔自偶不信仙道。日月有所不照，圣人有所不知，岂可以圣人所不为，便云天下无仙，是责三光不照覆盆之内也。","book":"《抱朴子·辨问》"},"example":{"text":"辱示运宜被劫事，顷苏、松按院已直将本官论劾，若不得大疏存此说，则～谁与雪之。","book":"明·张居正《答应天张按院》"},"similar":["不白之冤"],"usage":"作宾语；指无处申诉的冤枉"},{"id":40317,"word":"覆盆难照","pinyin":"fù pén nán zhào","abbr":"fpnz","explanation":"覆盆：翻扣的盆子。翻过来扣着的盆子，阳光照不到里面。比喻暗无天日。","source":{"text":"日月有所不照，圣人有所不知，岂可以圣人所不为，便云天下无仙，是责三光不照覆盆之内也。","book":"《抱朴子·辨问》"},"example":{"text":"久知～，已拚毕命于此，幸遇高贤大侠，倘蒙怜而垂手，则死之日，犹生之年矣。","book":"明·明教中人《好逑传》第五回"},"similar":["覆盆之冤"],"usage":"作宾语、定语；指无处申诉的冤枉"},{"id":40318,"word":"覆窟倾巢","pinyin":"fù kū qīng cháo","abbr":"fkqc","explanation":"窟：洞穴；巢：鸟窝。翻了洞穴，塌了鸟窝。比喻家室倾毁。","source":{"text":"彼四子者，皆当世雄杰，以犯顺取祸，覆窟倾巢，为竖子笑。","book":"《宋书·沈攸之传》"},"usage":"作宾语、定语；用于比喻句"},{"id":40319,"word":"覆舟之戒","pinyin":"fù zhōu zhī jiè","abbr":"fzzj","explanation":"推翻船的教训。比喻失败的教训。","source":{"text":"后之人主，亦知邱民之可畏，而覆舟之戒始信。","book":"明·陈子龙《陈涉论》"},"similar":["覆车之戒"],"usage":"作宾语；比喻失败的教训"},{"id":40320,"word":"覆舟载舟","pinyin":"fù zhōu zài zhōu","abbr":"fzzz","explanation":"覆：颠覆；载：承载。比喻民心向背决定国家兴亡。","source":{"text":"传曰：‘君者舟也，庶人者水也，水则载舟，水则覆舟。’此之谓也。","book":"战国·赵·荀况《荀子·王制》"},"similar":["载舟覆舟"],"usage":"作定语、分句；用于比喻句"},{"id":40321,"word":"覆蕉寻鹿","pinyin":"fù jiāo xún lù","abbr":"fjxl","explanation":"覆：遮盖；蕉：同“樵”，柴。比喻把真事看作梦幻而一再失误。","source":{"text":"守株待兔之举，视若不二法门，覆蕉寻鹿之徒，尊为无上妙品。","book":"清·吴趼人《糊涂世界》序"},"similar":["覆鹿寻蕉","覆鹿遗蕉"],"usage":"作宾语、定语；指人办事失误","story":["从前郑国人在野外砍柴，看到一只受伤的鹿跑过来，就把鹿打死，担心猎人追来，就把死鹿藏在一条小沟里，顺便砍了一些蕉叶覆盖。天黑了，他想找到死鹿扛回家，可惜怎么也找不到。于是他只好放弃，就当作自己做了同样的梦罢了"]},{"id":40322,"word":"覆车之戒","pinyin":"fù chē zhī jiè","abbr":"fczj","explanation":"比喻先前的失败，可以作为以后的教训。","source":{"text":"纯以凡才，备位卿尹，不惟谦敬之节，不忌覆车之戒矣。","book":"《晋书·庾纯传》"},"similar":["前车之鉴"],"usage":"作宾语；比喻失败的教训","story":["西汉时期，洛阳人贾谊从小就有天才儿童的美誉，汉文帝听说他很有才学，请他进京担任博士，问他治理国家的看法。贾谊主张要以秦朝灭亡作为镜子，时刻提醒自己要施行仁政，让老百姓休养生息，重视农业生产才能使国家强大"]},{"id":40323,"word":"覆车之轨","pinyin":"fù chē zhī guǐ","abbr":"fczg","explanation":"轨：车辙。翻车的辙迹。比喻失败的教训。","source":{"text":"可为至戒，覆车之轨，其迹不远。","book":"汉·陈忠《清盗源疏》"},"example":{"text":"青之号令不得行，是循～也。","book":"宋·司马光《涑水记闻》第13卷"},"similar":["覆车之鉴","覆车之辙"],"usage":"作主语、宾语；比喻失败的教训"},{"id":40324,"word":"覆车之辙","pinyin":"fù chē zhī zhé","abbr":"fczz","explanation":"辙：车辙。翻车的辙迹。比喻失败的教训。","source":{"text":"今公克平祸乱，安国定家，故复因前倾败之法，寻中间覆车之轨，却冀长存，非所敢闻。","book":"汉·陈忠《清盗源疏》"},"example":{"text":"明·陆贽《翰苑集》第15卷：“愿陛下惟事无大小，皆以～为戒。”"},"similar":["覆车之轨","覆车之鉴"],"usage":"作主语、宾语；比喻失败的教训"},{"id":40325,"word":"覆车之鉴","pinyin":"fù chē zhī jiàn","abbr":"fczj","explanation":"覆：倾覆；鉴：镜子。把翻车作为镜子。比喻先前的失败，可以作为以后的教训。","source":{"text":"隗器凭陇而亡，公孙述据蜀而灭，此皆前世覆车之鉴。","book":"《三国志·蜀志·后主传》裴松之注引王隐《蜀记》"},"example":{"text":"～，近可信矣。","book":"《魏书·阳尼传》"},"similar":["前车之鉴"],"usage":"作宾语；比喻失败的教训","story":["西汉时期，洛阳人贾谊从小就有天才儿童的美誉，汉文帝听说他很有才学，请他进京担任博士，问他治理国家的看法。贾谊主张要以秦朝灭亡作为镜子，时刻提醒自己要施行仁政，让老百姓休养生息，重视农业生产才能使国家强大"]},{"id":40326,"word":"覆车继轨","pinyin":"fù chē jì guǐ","abbr":"fcjg","explanation":"轨：车辙。前车翻倒了，后面的车仍沿着前车留下的辙行进。比喻不吸取教训，继续错误行事。","source":{"text":"故木秀于林，风必摧之；堆出于岸，流必湍之；行高于人，众必非之。前鉴不远，覆车继轨。","book":"三国·魏·李康《运命论》"},"example":{"text":"《旧唐书·辛替否传》：“千帝百王，饰弥盛而国弥空，役弥重而祸弥大。～，曾不改途。”"},"usage":"作谓语、定语；用于处事"},{"id":40327,"word":"覆载之下","pinyin":"fù zài zhī xià","abbr":"fzzx","explanation":"覆载：天覆地载，指天地的代称。生存于天地之间。","source":{"text":"覆载之下，胡颜独存也？","book":"唐·陈玄佑《离魂记》"}},{"id":40328,"word":"覆酱烧薪","pinyin":"fù jiàng shāo xīn","abbr":"fjsx","explanation":"指著作无价值或不受重视。","source":{"text":"吟风弄月各自得，覆酱烧薪空尔悲。","book":"康有为《与菽园论诗》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":40329,"word":"覆雨翻云","pinyin":"fù yǔ fān yún","abbr":"fyfy","explanation":"形容人反复无常或惯于耍手段。","source":{"text":"翻手作云覆手雨，纷纷轻薄何须数。","book":"唐·杜甫《贫交行》"},"example":{"text":"～四十年，专房共辇承恩顾。","book":"清·吴伟业《银泉山》"},"similar":["翻云覆雨","两面三刀"],"usage":"作谓语、定语；形容惯于耍手段"},{"id":40330,"word":"覆餗之忧","pinyin":"fù sù zhī yōu","abbr":"fszy","explanation":"覆：翻；餗：鼎里的食物。鼎足坏了，食物倒出。指因不胜其力而坏事。","source":{"text":"于时疆场多虞，宪章罕备，天子居缀旆之运，人臣微覆餗之忧。","book":"《晋书·韩伯传》"},"similar":["覆餗之患","覆餗之衅"],"usage":"作主语、宾语；用于比喻句"},{"id":40331,"word":"覆餗之患","pinyin":"fù sù zhī huàn","abbr":"fszh","explanation":"覆：翻倒；餗：鼎中的食品。鼎足坏了，食物从鼎中翻出。比喻因不能胜任而坏事。","source":{"text":"公府掾属，古之造士也，必擢时隽，搜扬英逸，得其人则穹道之任隆，非其才则覆餗之患至。","book":"《周易·鼎》：“鼎折足，覆公餗。”《三国志·吴志·何夔传》"},"similar":["覆餗之衅","覆餗之忧"],"usage":"作主语、宾语；用于比喻句"},{"id":40332,"word":"覆餗之衅","pinyin":"fù sù zhī xìn","abbr":"fszx","explanation":"覆：翻；餗：鼎里的食物。鼎足坏了，食物倒出。指因不胜其力而坏事。","source":{"text":"上亏圣朝栋隆之举，下增微臣覆餗之衅，惶惧战灼，寄颜无所。","book":"《晋书·蔡谟传》"},"similar":["覆餗之患","覆餗之忧"],"usage":"作主语、宾语；用于比喻句"},{"id":40333,"word":"覆餗偾辕","pinyin":"fù sù fè yuán","abbr":"fsfy","explanation":"覆：翻倒；餗：鼎中的食品；偾：仆倒。翻倒鼎中的食物，仆倒车辕。比喻因不能胜任而失败。","source":{"text":"圣人能以所甚惜，夺所甚爱。故天下之中，人皆可全于功名之途，而不致有覆餗偾辕之伤。","book":"清·侯方域《豫省试策》"}},{"id":40334,"word":"覆鹿寻蕉","pinyin":"fù lù xún jiāo","abbr":"flxj","explanation":"覆：遮盖；蕉：同“樵”，柴。比喻把真事看作梦幻而一再失误。","source":{"text":"郑人有薪于野者，……，覆之以蕉，不胜其喜。","book":"战国·郑·列御寇《列子·周穆王》"},"example":{"text":"乌轮兔驾迅长空，～恍梦中。","book":"明·陈汝元《金莲记·慈训》"},"similar":["覆蕉寻鹿","覆鹿遗蕉"],"usage":"作宾语、定语；指人办事失误","story":["从前郑国人在野外砍柴，看到一只受伤的鹿跑过来，就把鹿打死，担心猎人追来，就把死鹿藏在一条小沟里，顺便砍了一些蕉叶覆盖。天黑了，他想找到死鹿扛回家，可惜怎么也找不到。于是他只好放弃，就当作自己做了同样的梦罢了"]},{"id":40335,"word":"覆鹿遗蕉","pinyin":"fù lù yí jiāo","abbr":"flyj","explanation":"覆：遮盖；蕉：同“樵”，柴。比喻把真事看作梦幻而一再失误。","source":{"text":"罗平沼成，明社已屋，覆鹿遗蕉，亡猿灾木。","book":"清·王闿运《桂阳州志序》"},"similar":["覆鹿寻蕉","覆蕉寻鹿"],"usage":"作宾语、定语；指人办事失误","story":["从前郑国人在野外砍柴，看到一只受伤的鹿跑过来，就把鹿打死，担心猎人追来，就把死鹿藏在一条小沟里，顺便砍了一些蕉叶覆盖。天黑了，他想找到死鹿扛回家，可惜怎么也找不到。于是他只好放弃，就当作自己做了同样的梦罢了"]},{"id":40336,"word":"见世生苗","pinyin":"jiàn shì shēng miáo","abbr":"jssm","explanation":"比喻眼前就会收效得利。","source":{"text":"你尚图些紫绶金章，赤紧的见世生苗，我则理会的埋根千丈。","book":"元·无名氏《冻苏秦》第三折"},"usage":"作谓语、定语；用于书面语"},{"id":40337,"word":"见义勇为","pinyin":"jiàn yì yǒng wéi","abbr":"jyyw","explanation":"看到正义的事，就勇敢地去做。","source":{"text":"见义不为，无勇也。","book":"《论语·为政》"},"example":{"text":"～真汉子，莫将成败论英雄。","book":"明·冯梦龙《东周列国志》第十四回"},"similar":["急公好义","挺身而出"],"opposite":["袖手旁观","见利忘义","见义不为"],"usage":"作谓语、定语；指勇于做好事","story":["1993年8月，济南军区某部中士徐洪刚探亲期满乘车返队，在车上遇到几个歹徒在调戏一个女青年，并肆无忌惮耍流氓，徐洪刚这时立即见义勇为，毫不犹豫上前制止，被歹徒连刺多刀，他顽强地追赶歹徒，被授予英雄称号"]},{"id":40338,"word":"见义当为","pinyin":"jiàn yì dāng wéi","abbr":"jydw","explanation":"指看到正义的事情就去做。同“见义必为”。","source":{"text":"赵实见义当为，不行邪径，就加你为吉阳县令。","book":"元·马致远《荐福碑》第四折"},"similar":["见义必为"],"opposite":["见义不为"],"usage":"作谓语、定语；用于为人"},{"id":40339,"word":"见义必为","pinyin":"jiàn yì bì wéi","abbr":"jybw","explanation":"指看到正义的事情就去做。","source":{"text":"见义不为，无勇也。","book":"春秋·鲁·孔丘《论语·为政》"},"example":{"text":"君年少，～，岂可量哉。","book":"《宋史·儒林传·石介》"},"similar":["见义当为"],"opposite":["见义不为"],"usage":"作谓语、定语；用于为人"},{"id":40340,"word":"见义敢为","pinyin":"jiàn yì gǎn wéi","abbr":"jygw","explanation":"看到正义的事，就勇敢地去做。同“见义勇为”。","source":{"text":"为吏明悟敏捷，见义敢为，不少屈以求合。","book":"宋·曾巩《太子宾客致仕陈公神道碑铭》"},"example":{"text":"庄重寡言笑，～。","book":"《明史·伍骥传》"},"similar":["见义勇为"],"opposite":["见义不为"],"usage":"作谓语、定语；指勇于做好事"},{"id":40341,"word":"见之不取，思之千里","pinyin":"jiàn zhī bù qǔ，sī zhī qiān lǐ","abbr":"jzbqszql","explanation":"见到时不拿过来，以后再想要就更难办了。","source":{"text":"见之不取，思之千里。只道张协状元，不知榜眼探花是那里人，买本看。","book":"宋·无名氏《张协状元》二八"},"example":{"text":"呀，道兄差矣！岂不闻～，既遇明主，何必远去？","book":"明·张风翼《红拂记·俊杰知时》"},"similar":["坐失良机","见物不取，失之千里"],"usage":"作宾语、分句；形容不要错失良机"},{"id":40342,"word":"见事生风","pinyin":"jiàn shì shēng fēng","abbr":"jssf","explanation":"形容遇到事情，兴风作浪。","source":{"text":"见事风生，无所回避。","book":"东汉·班固《汉书·赵广汉传》"},"example":{"text":"第少年喜事，每捕风捉影，～。","book":"清·和邦额《夜潭随录·棘闱志异》"},"similar":["惹是生非","见事风生"],"usage":"作谓语、宾语；指借故搬弄是非"},{"id":40343,"word":"见事风生","pinyin":"jiàn shì fēng shēng","abbr":"jsfs","explanation":"原形容处事果断而迅速。后指一有机会就挑拔是非，引起事端。","source":{"text":"所居好用世吏子孙新进年少者，专厉强壮蜂气，见事风生，无所回避，率多果敢之计，莫为持难。","book":"《汉书·赵广汉传》"},"example":{"text":"无赖者～，谓之“打抱不平，近少敛戢。”","book":"清·李声振《百戏竹枝词·角觗·词序》"},"usage":"作定语、状语；用于处事"},{"id":40344,"word":"见人说人话，见鬼说鬼话","pinyin":"jiàn rén shuō rén huà，jiàn guǐ shuō guǐ huà","abbr":"jrsrhjgsgh","explanation":"指看人说话与处事。形容人善于说话。","source":{"text":"第二要嘴巴会说，见人说人话，见鬼说鬼话，见了官场说官场上的话，见了生意人说生意场中的话。","book":"清·李宝嘉《官场现形记》第38回"},"example":{"text":"无非‘～’，你要想他帮忙，就得先跟他做生意。","book":"高阳《胡雪岩全传·平步青云》下册"},"similar":["看人说话"],"opposite":["千篇一律"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40345,"word":"见仁见智","pinyin":"jiàn rén jiàn zhì","abbr":"jrjz","explanation":"对同一个问题，不同的人从不同的立场或角度有不同的看法。","source":{"text":"仁者见之谓之仁，智者见之谓之智。","book":"《周易·系辞上》"},"example":{"text":"～，议论纷纭，却无非背后论人是非，在兆奎面前都有忌讳。","book":"高阳《清宫外史》上册"},"similar":["见智见仁"],"usage":"作谓语、定语；指对同一个问题各有各的看法"},{"id":40346,"word":"见佛不拜","pinyin":"jiàn fó bù bài","abbr":"jfbb","explanation":"看见佛像，却不上前叩拜。比喻自有主张。","source":{"text":"有云，二十四腊，逍遥自在，逢人则喜，见佛不拜。……有僧问曰：‘既见佛，为甚不拜？’曰：‘家无二主。’","book":"宋·释普济《五灯会元》"},"example":{"text":"六十余年和光混俗，四十二腊逍遥自在，逢人则喜～。","book":"宋·释惟白《续传灯录》卷二十三"}},{"id":40347,"word":"见兔放鹰","pinyin":"jiàn tù fàng yīng","abbr":"jtfy","explanation":"看到野兔，立即放出猎鹰追捕。比喻行动及时，适合需要。","source":{"text":"布大教网，漉人天鱼，不如见兔放鹰，遇獐发箭。","book":"宋·释普济《五灯会元》"},"example":{"text":"当今世情，何人不趋炎附势，～，谁肯结交穷秀才。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"similar":["有的放矢"],"usage":"作宾语、定语；指有的放矢"},{"id":40348,"word":"见兔顾犬","pinyin":"jiàn tù gù quǎn","abbr":"jtgq","explanation":"顾：回头看。看到了兔子，再回头叫唤猎狗去追捕。比喻动作虽稍迟，但赶紧想办法，还来得及。","source":{"text":"见兔而顾犬，未为晚也。","book":"《战国策·楚策四》"},"example":{"text":"夫～，或未为晚，今能议及，岂不犹愈于已。","book":"清·梁启超《我政府之对俄政策》"},"similar":["亡羊补牢"],"usage":"作谓语、定语；比喻时机当前，急谋对策"},{"id":40349,"word":"见其一未见其二","pinyin":"jiàn qí yī wèi jiàn qí èr","abbr":"jqywjqe","explanation":"知道事物的一方面，不知道还有另一方面。形容对事物的了解不全面。","source":{"text":"不敢暴虎，不敢冯河，人知其一，莫知其它。","book":"《诗经·小雅·小旻》"}},{"id":40350,"word":"见几而作","pinyin":"jiàn jī ér zuò","abbr":"jjez","explanation":"几：苗头；作：行动。指发现一点苗头就立刻采取措施。","source":{"text":"君子见几而作，不俟终日。","book":"《周易·系辞下》"},"example":{"text":"富春子见似道举动非常，惧祸而逃，可谓～者矣，","book":"明·冯梦龙《古今小说》卷二十二"},"similar":["见幾而作"],"usage":"作谓语、宾语；用于处事"},{"id":40351,"word":"见利忘义","pinyin":"jiàn lì wàng yì","abbr":"jlwy","explanation":"见到有利可图就不顾道义。","source":{"text":"夫卖友者，谓见利而忘义也。","book":"《汉书·樊郦滕灌傅靳周传》"},"example":{"text":"某与吕布同乡，知其勇而无谋，～。","book":"明·罗贯中《三国演义》第三回"},"similar":["见钱眼开","唯利是图","利令智昏"],"opposite":["见利思义","舍生取义","见义勇为"],"usage":"作谓语、宾语、定语；指人见钱眼开","story":["西汉时期，刘邦死后，大权落在吕后手里，吕氏安排吕产、吕禄掌握国家大权，不得人心。吕后死后，老臣周勃、陈平想办法铲除吕家势力，就请老丞相郦商的儿子郦寄出面约他的好朋友吕禄外出打猎，借机杀掉吕禄，郦寄被封为大将军"]},{"id":40352,"word":"见利忘危","pinyin":"jiàn lì wàng wēi","abbr":"jlww","explanation":"利：利益；危：危险。看到眼前的利益，忘记自己身处危难之中。"},{"id":40353,"word":"见利思义","pinyin":"jiàn lì sī yì","abbr":"jlsy","explanation":"看到货财，要想到道义。","source":{"text":"见利思义，见危授命，久要不忘平生之言，亦可以为成人矣。","book":"《论语·宪问》"},"example":{"text":"财利迷心，人情世态，～，于君无愧。","book":"明·胡文焕《群音类选·还带记》"},"opposite":["见利忘义"],"usage":"作谓语、宾语；形容廉洁自守"},{"id":40354,"word":"见制于人","pinyin":"jiàn zhì yú rén","abbr":"jzyr","explanation":"见：被；制：控制。指被别人控制。","source":{"text":"事贵制人而不贵见制于人。制人者，握权也；见制于人者，制命也。","book":"《鬼谷子·谋篇第十》"}},{"id":40355,"word":"见势不妙","pinyin":"jiàn shì bù miào","abbr":"jsbm","explanation":"看到形势不好。","example":{"text":"他见势不妙，乘机溜走了。"},"usage":"作谓语；指看到形势对自己不利"},{"id":40356,"word":"见危授命","pinyin":"jiàn wēi shòu mìng","abbr":"jwsm","explanation":"授命：献出生命。在危急关头勇于献出自己的生命。","source":{"text":"见利思义，见危授命，久要不忘平生之言，亦可以为成人矣。","book":"《论语·宪问》"},"example":{"text":"慨自烽烟告警，～，而尽力王事者，有几人哉！","book":"清·淮阴百一居士《壶天录》"},"similar":["见危致命"],"usage":"作谓语、定语；指在危急关头勇于献身","story":["子路问孔子怎样才能成为一个十全十美的人，孔子要他学鲁国的臧武仲、孟公绰、卞庄子、冉求他们的优点，同时加强礼乐的学习，见利不能忘义，看到别人遭到危险时能舍身去搭救，坚守信用，这样就能成为完美的人"]},{"id":40357,"word":"见危致命","pinyin":"jiàn wēi zhì mìng","abbr":"jwzm","explanation":"在危急关头勇于献出自己的生命。同“见危授命”。","source":{"text":"士见危致命，见得思义。","book":"春秋·鲁·孔丘《论语·子罕》"},"example":{"text":"臣敢不温故知新，有司之职；～，更输异日之忠。","book":"宋·苏东坡《谢处侍读表》"},"similar":["见危授命"],"usage":"作谓语、定语；指在危急关头勇于献身"},{"id":40358,"word":"见卵求鸡","pinyin":"jiàn luǎn qiú jī","abbr":"jlqj","explanation":"看到鸡蛋，就希求蛋化为鸡，而来司晨报晓。比喻言之过早。","source":{"text":"女亦大早计，见卵而求时夜，见弹而求鸮炙。","book":"《庄子·齐物论》"},"example":{"text":"今徒学语其圣德，而不知圣之所以德，可谓见卵而求时夜，见弹而求鸮炙，何其造次哉。","book":"宋·张君房《云笈七签·坐忘论》"}},{"id":40359,"word":"见可而进","pinyin":"jiàn kě ér jìn","abbr":"jkej","explanation":"见到形势有利就进军。后指有把握就行动。","source":{"text":"赵兵出国迎战，见可而进，知难而退，怀内顾之心，无必死之计。","book":"汉·荀悦《汉纪·高帝纪》"},"example":{"text":"臣又闻圣人不凝滞于物，～，知难而退，理有变通，情无拘执。","book":"宋·邵伯温《闻见前录》第六卷"},"opposite":["知难而退"],"usage":"作谓语；指有把握就行动"},{"id":40360,"word":"见可而进，知难而退","pinyin":"jiàn kě ér jìn，zhī nán ér tuì","abbr":"jkejznet","explanation":"根据实际情况决定进攻和退却。","source":{"text":"赵兵出国迎战，见可而进，知难而退，怀内顾之心，无必死之计。","book":"汉·荀悦《汉纪·高帝纪》"},"example":{"text":"臣又闻圣人不凝滞于物，～，理有变通，情无拘执。宋·邵伯温《闻见前录》卷六"},"usage":"作谓语、宾语、定语；用于处事"},{"id":40361,"word":"见哭兴悲","pinyin":"jiàn kū xīng bēi","abbr":"jkxb","explanation":"见别人哭泣而引起自己的悲伤。指产生同情心。","source":{"text":"迟共疾，俺敢待寻生替死，自古道见哭兴悲。","book":"明·梅鼎祚《玉合记·还玉》"},"usage":"作谓语、定语；用于处事"},{"id":40362,"word":"见善则迁","pinyin":"jiàn shàn zé qiān","abbr":"jszq","explanation":"看到好事就仿效去做。","source":{"text":"风雷益，君子以见善则迁，有过则改。","book":"《周易·益》"}},{"id":40363,"word":"见善必迁","pinyin":"jiàn shàn bì qiān","abbr":"jsbq","explanation":"迁：去恶从善。遇到好事，一定去做。","source":{"text":"以陛下天姿英圣，傥加之见善必迁，是将化蓄怨衔恩，反过差为至当。","book":"唐·陆贽《奉天请罢琼林大盈二库状》"},"usage":"作谓语、宾语；用于处事"},{"id":40364,"word":"见善若惊","pinyin":"jiàn shàn ruò jīng","abbr":"jsrj","explanation":"善：善良，美好；惊：震动。看见好人好事就会受到震动。","source":{"text":"忠果正直，志怀霜雪，见善若惊，嫉恶如仇。任座抗行，史鱼厉节，殆无以过也。","book":"汉·孔融《荐祢衡表》"},"example":{"text":"蔡东藩《后汉演义》第七十八回：“说他淑质贞亮，英才卓烁，～，嫉恶若仇，有鸷鸟累百，不如一鹗等语。”"},"similar":["见贤思齐"],"usage":"作谓语；指好人好事的作用"},{"id":40365,"word":"见噎废食","pinyin":"jiàn yē fèi shí","abbr":"jyfs","explanation":"比喻遇到偶然挫折就停止应作的事。","source":{"text":"此皆见噎废食之说，究竟书可竟弃，仕可尽废乎？","book":"清·李渔《闲情偶寄·声容·习技》"},"similar":["因噎废食"],"usage":"作定语、谓语、宾语；指机械处事"},{"id":40366,"word":"见墙见羹","pinyin":"jiàn qiáng jiàn gēng","abbr":"jqjg","explanation":"比喻念念不忘先贤。","source":{"text":"昔尧殂之后，舜仰慕三年，坐则见尧于墙，食则睹尧于羹。","book":"《后汉书·李固传》"},"similar":["见羹见墙"],"usage":"作谓语、宾语；指念念不忘先贤"},{"id":40367,"word":"见多识广","pinyin":"jiàn duō shí guǎng","abbr":"jdsg","explanation":"识：知道。见过的多，知道的广。形容阅历深，经验多。","source":{"text":"还是大家宝眷，见多识广，比男子汉眼力到胜十倍。","book":"明·冯梦龙《古今小说》卷一"},"example":{"text":"她是每天上街去买菜的，自然～，知道这东西的时价。","book":"茅盾《过年》"},"similar":["博学多才","博古通今"],"opposite":["一孔之见","孤陋寡闻"],"usage":"作谓语、定语、宾语；指人的见识"},{"id":40368,"word":"见好就收","pinyin":"jiàn hǎo jiù shōu","abbr":"jhjs","explanation":"趁着形势大好时就收兵。","source":{"text":"赌场无赢家，我是见好就收，免得日后也落到你这种地步。","book":"余华《活着》"},"usage":"作谓语、定语；用于处事"},{"id":40369,"word":"见始知终","pinyin":"jiàn shǐ zhī zhōng","abbr":"jszz","explanation":"指看见事物的开始阶段就能预见到它的最终结果。","source":{"text":"故圣人见微知著，睹始知终。","book":"汉·袁康《越绝书·越绝德序外传》"},"example":{"text":"君子视微见著，～，祸无从起，此思虑之政也。","book":"三国·蜀·诸葛亮《便宜十六策·思虑》"},"similar":["见微知著"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40370,"word":"见小暗大","pinyin":"jiàn xiǎo àn dà","abbr":"jxad","explanation":"指小事清楚，大事糊涂。","source":{"text":"而不知所务，从物如流不知其所执，此则庸人也。","book":"《孔子家语·五仪解》"},"usage":"作谓语、定语；用于处事"},{"id":40371,"word":"见幾而作","pinyin":"jiàn jī ér zuò","abbr":"jjez","explanation":"幾：通“机”，时机；作：行动。指抓住有利时机及时采取行动。","source":{"text":"君子见幾而作，不俟终日。","book":"《周易·系辞下》"},"example":{"text":"知其后来必不可支持，故亦须～可也。","book":"宋·朱熹《朱子语类》第44卷"},"similar":["见机行事","见几而作"],"opposite":["鲁莽行事"],"usage":"作谓语、宾语；指发现一点苗头就立刻采取措"},{"id":40372,"word":"见异思迁","pinyin":"jiàn yì sī qiān","abbr":"jysq","explanation":"迁：变动。看见另一个事物就想改变原来的主意。指意志不坚定，喜爱不专一。","source":{"text":"少而习焉，其心安焉，不见异物而迁焉。","book":"《管子·小匡》"},"example":{"text":"因此满胸抑郁，终不免宗旨不定。～，是个自然的道理。","book":"清·黄小配《大马扁》第七回"},"similar":["三心二意"],"opposite":["一心一意","专心致志"],"usage":"作谓语、宾语、定语；指人的意志","story":["春秋时期，齐国相国管仲为国家的强盛做出重要的贡献，齐桓公问管仲是如何使民众安居乐业？管仲说把民众分士、农、工、商四个行业分开居住，使他们便于学习与钻研本行业的技能，而不会“见异物而迁”，这样可以安居乐业"]},{"id":40373,"word":"见弃于人","pinyin":"jiàn qì yǔ rén","abbr":"jqyr","explanation":"见：被；弃：遗弃，抛弃。被别人抛弃。","example":{"text":"尤其是一个自尊心重的人，～，那种伤感是非常沉重的！","book":"萧逸《龙吟曲》第九章"},"usage":"作谓语、定语；用于人或事物等"},{"id":40374,"word":"见弹求鸮","pinyin":"jiàn dàn qiú háo","abbr":"jdqx","explanation":"看到弹丸，就想得到鸟的炙肉。比喻过早估计实效。","source":{"text":"且女亦大早计，见卵而求时夜，见弹而求鸮炙。","book":"《庄子·齐物论》"},"example":{"text":"因罤觅菟，～。","book":"清·顾炎武《答帮一公肃两甥书》"},"similar":["见弹求鸮炙"],"usage":"作谓语、宾语、定语；比喻过早估计实效"},{"id":40375,"word":"见弹求鸮炙","pinyin":"jiàn dàn qiú xiāo zhì","abbr":"jdqxz","explanation":"弹：弹丸；鸮：猫头鹰；炙：烤肉。看到弹丸，就想得到吃到美味的烤鸮肉。比喻过早估计实效。","source":{"text":"且女亦大早计，见卵而求时夜，见弹而求鸮炙。","book":"《庄子·齐物论》"},"example":{"text":"宋·张君房《云笈七签》第49卷：“今徒学语其圣德，而不知圣之所以德，可谓见卵而求时夜，～，何其造次哉。”"},"similar":["见弹求鸮"],"usage":"作谓语、宾语、定语；比喻过早估计实效"},{"id":40376,"word":"见弹求鹗","pinyin":"jiàn dàn qiú è","abbr":"jdqe","explanation":"看到弹丸，就想得到鸟的炙肉。比喻过早估计实效。同“见弹求鸮”。","source":{"text":"是以见弹求鹗，或欲速则不达；投珠抵鹊，或见小而妨大。","book":"明·张居正《辛未会试程策》之三"},"similar":["见弹求鸮"],"usage":"作谓语、宾语、定语；用于处事"},{"id":40377,"word":"见微知萌","pinyin":"jiàn wēi zhī méng","abbr":"jwzm","explanation":"微：细微；萌：发生。看到事物微小的迹象，就知道其发展的程度。","source":{"text":"圣人见微以知萌，见端以知末，故见象箸而怖，知天下不足也。","book":"《韩非子·说林上》"},"similar":["见微知著"],"usage":"作谓语、宾语；指事物的苗头推断发展趋势"},{"id":40378,"word":"见微知著","pinyin":"jiàn wēi zhī zhù","abbr":"jwzz","explanation":"微：隐约；著：明显。见到事情的苗头，就能知道它的实质和发展趋势。","source":{"text":"故圣人见微知著，睹始知终。","book":"《韩非子·说林上》：“圣人见微以知萌，见端以知末，故见象箸而怖，知天下不足也。”汉·袁康《越绝书·越绝德序外传》"},"example":{"text":"上揆天道，下察民情，酌古准今，～。","book":"清·郑观应《盛世危言·弭兵》"},"similar":["原始见终","因小见大"],"usage":"作谓语、宾语；指事物的苗头推断发展趋势"},{"id":40379,"word":"见德思齐","pinyin":"jiàn dé sī qí","abbr":"jdsq","explanation":"见到德才兼备的人就想赶上他。同“见贤思齐”。","source":{"text":"有教无类，童子羞于霸功；见德思齐，狂夫成于圣业。","book":"《隋书·李德林传》"},"example":{"text":"《隋书·李德林传》：“有教无类，童子羞于霸功；～，狂夫成于圣业。”"},"similar":["见贤思齐"],"usage":"作谓语、宾语、定语；指追求进步"},{"id":40380,"word":"见性成佛","pinyin":"jiàn xìng chéng fó","abbr":"jxcf","explanation":"性：本性。佛教禅宗认为只要“识自本心，见自本性”，就可以成佛。","source":{"text":"久参泐潭，潭因问：‘禅师西来单传心印直指人心，见性成佛，子作么生会？’师曰：‘某甲不会。’","book":"宋·释惟白《续传灯录》卷五"},"usage":"作宾语、定语；用于佛教等"},{"id":40381,"word":"见怪不怪","pinyin":"jiàn guài bù guài","abbr":"jgbg","explanation":"看到怪异的现象不要大惊小怪。指遇到不常见的事物或意外情况，要沉着镇静。","source":{"text":"畜生之言何足为信？我已数月来知之矣。见怪不怪，其怪自坏。","book":"宋·洪迈《夷坚三志己》卷二"},"example":{"text":"“～，其怪自败。”不用砍他，随他去就是了。","book":"清·曹雪芹《红楼梦》第九十四回"},"similar":["以怪为常","见怪未怪","司空见惯"],"opposite":["大惊小怪"],"usage":"作宾语、定语、状语；形容遇事沉着","story":["宋朝一旅客对店主姜七说昨晚听到猪圈中的老母猪在哭泣，姜七说：“我早就见过了，老母猪说是我祖母投胎变的，这有什么稀奇古怪的。”两人不欢而散。两天后，姜七患病怀疑是老母猪所为，就杀了它，姜七不久也就一命呜呼了"]},{"id":40382,"word":"见怪不怪，其怪自坏","pinyin":"jiàn guài bù guài，qí guài zì huài","abbr":"jgbgqgzh","explanation":"怪：奇异的；坏：败。发现怪事怪物不要惊慌，它就不会危害了。","source":{"text":"畜生之言，何足为信，我已数月来知之矣。见怪不怪，其怪自坏。","book":"宋·洪迈《夷坚三志·己·姜七家猪》"},"example":{"text":"此必山鬼野魅所为。常言道：～。莫睬便了。","book":"明·罗贯中《平妖传》第三回"},"similar":["见怪不怪，其怪自绝"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":40383,"word":"见怪不怪，其怪自绝","pinyin":"jiàn guài bù guài，qí guài zì jué","abbr":"jgbgqgzj","explanation":"怪：奇异的；绝：绝迹，了却。发现怪事怪物不要惊慌，它就不会危害了。","source":{"text":"既是毫无根据，那见怪不怪，其怪自绝，又何必大惊小怪呢。","book":"谢觉哉《作风漫谈》"},"similar":["见怪非怪，其怪自害"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":40384,"word":"见怪不怪，其怪自败","pinyin":"jiàn guài bù guài，qí guài zì bài","abbr":"jgbgqgzb","explanation":"怪：奇异的。发现怪事怪物不要惊慌，它就不会危害了。","source":{"text":"见怪不怪，其怪自败。无如愚夫愚妇始终不悟耳。","book":"清·百一居士《壶天录》下卷"},"example":{"text":"先前的‘见怪者’，说是‘～’，现在的‘怪’，却早已声明着，叫你‘见莫怪’了。","book":"鲁迅《花边文学·奇怪》"},"similar":["见怪不怪，其怪自坏"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":40385,"word":"见怪非怪","pinyin":"jiàn guài fēi guài","abbr":"jgfg","explanation":"看到怪异的现象不要大惊小怪。指遇到不常见的事物或意外情况，要沉着镇静。同“见怪不怪”。","source":{"text":"见怪非怪，其怪自害。","book":"明·无名氏《白兔记·牧牛》"},"similar":["见怪不怪"],"usage":"作宾语、定语、状语；形容遇事沉着"},{"id":40386,"word":"见怪非怪，其怪自害","pinyin":"jiàn guài fēi guài，qí guài zì hài","abbr":"jgfgqgzh","explanation":"怪：奇异的。发现怪事怪物不要惊慌，它就不会危害了。","source":{"text":"见怪非怪，其怪自害。","book":"明·无名氏《白兔记·牧牛》"},"similar":["见怪不怪，其怪自败"],"opposite":["少见多怪","大惊小怪"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":40387,"word":"见惯不惊","pinyin":"jiàn guàn bù jīng","abbr":"jgbj","explanation":"看惯了，就不觉得奇怪了。","source":{"text":"见惯不惊新物盛，话长难说故人稀。","book":"宋·邵雍《首尾吟135首》"},"example":{"text":"他们～，也就只好由我了。","book":"朱自清《笑的历史》"},"similar":["见怪不怪"],"usage":"作谓语、宾语；指不以为然"},{"id":40388,"word":"见惯司空","pinyin":"jiàn guàn sī kōng","abbr":"jgsk","explanation":"指经常看到，不足为奇。","source":{"text":"妙部新奇，见惯司空自品题。","book":"清·孔尚任《桃花扇·媚座》"},"similar":["司空见惯","司空眼惯"],"opposite":["绝无仅有","盖世无双"],"usage":"作谓语、定语、宾语；形容常见的东西"},{"id":40389,"word":"见所不见","pinyin":"jiàn suǒ bù jiàn","abbr":"jsbj","explanation":"看到从来没有看到过的。形容事物十分稀罕。同“见所未见”。","source":{"text":"七十子之于仲尼也，日闻所不闻，见所不见，文章亦不足为矣。","book":"汉·扬雄《法言·渊骞》"},"similar":["见所未见"],"usage":"作宾语、定语；用于人或事物等"},{"id":40390,"word":"见所未见","pinyin":"jiàn suǒ wèi jiàn","abbr":"jswj","explanation":"看到从来没有看到过的。形容事物十分稀罕。","source":{"text":"日闻所不闻，见所不见。","book":"汉·扬雄《法言·渊骞》"},"example":{"text":"许多奇事，则～，闻所未闻。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["前无古人","前所未有","史无前例"],"opposite":["司空见惯","习以为常","屡见不鲜"],"usage":"作宾语、定语；与“闻所未闻”连用"},{"id":40391,"word":"见时知几","pinyin":"jiàn shí zhī jǐ","abbr":"jszj","explanation":"指看到时运的推移而预知事情变化的先兆。"},{"id":40392,"word":"见时知幾","pinyin":"jiàn shí zhī jī","abbr":"jszj","explanation":"时：时势，时世；幾：细微的迹象，先兆。看到时运的推移而预知事情变化的先兆。","source":{"text":"监军之计在于持牢，而非见时知幾之变也。","book":"宋·司马光《资治通鉴·汉献帝建安四年》"},"usage":"作谓语、定语；用于处事"},{"id":40393,"word":"见景生情","pinyin":"jiàn jǐng shēng qíng","abbr":"jjsq","explanation":"看到眼前的景物，唤起某种感慨。亦指看到眼前的景物，想起应对的办法，即随机应变。","source":{"text":"俺那里水似蓝山如黛，不由我见景生情，睹物伤怀。","book":"元·宫天挺《七里滩》第四折"},"example":{"text":"亏得他足智多谋，～，便想出一个法子来。","book":"清·吴趼人《二十年目睹之怪现状》第97回"},"similar":["触景生情","生情见景"],"usage":"作谓语、宾语；同“触景生情”"},{"id":40394,"word":"见智见仁","pinyin":"jiàn zhì jiàn rén","abbr":"jzjr","explanation":"对同一个问题，不同的人从不同的立场或角度有不同的看法。","source":{"text":"仁者见之谓之仁，智者见之谓之智。","book":"《周易·系辞上》"},"example":{"text":"《易》道广大，无所不包，～，理原一贯。","book":"清·纪昀《阅微草堂笔记》卷六"},"similar":["见仁见智"],"usage":"作谓语、宾语；指看法不一"},{"id":40395,"word":"见木不见林","pinyin":"jiàn mù bù jiàn lín","abbr":"jmbjl","explanation":"比喻只看到局部，看不到整体或全部。"},{"id":40396,"word":"见机而作","pinyin":"jiàn jī ér zuò","abbr":"jjez","explanation":"看到适当时机立即行动。","source":{"text":"君子见几而作，不俟终日。","book":"《周易·系辞下》"},"example":{"text":"富春子见似道举动非常，惧祸而逃，可谓～者矣，","book":"明·冯梦龙《古今小说》第二十二卷"},"similar":["见机而行","相机行事"],"opposite":["鲁莽行事"],"usage":"作谓语；指看到适当时机立即行动"},{"id":40397,"word":"见机而行","pinyin":"jiàn jī ér xíng","abbr":"jjex","explanation":"见机：看时机，看情况。看具体情况灵活办事。","source":{"text":"君子见几而作，不俟终日。","book":"《周易·系辞下》"},"example":{"text":"大家灵活些，到时候～。"},"similar":["见机而作","相机行事"],"opposite":["鲁莽行事"],"usage":"作谓语、定语；指灵活处世"},{"id":40398,"word":"见机行事","pinyin":"jiàn jī xíng shì","abbr":"jjxs","explanation":"看具体情况灵活办事。","source":{"text":"君子见几而作，不俟终日。","book":"《周易·系辞下》"},"example":{"text":"你去～，得回再回方好。","book":"清·曹雪芹《红楼梦》第九十八回"},"similar":["见机而作","相机行事"],"opposite":["鲁莽行事","生搬硬套","一成不变"],"usage":"作谓语、定语；指看具体情况灵活办事"},{"id":40399,"word":"见树不见林","pinyin":"jiàn shù bù jiàn lín","abbr":"jsbjl","explanation":"只看见眼前的树木，却看不到背后的森林。","example":{"text":"你这种～的说法真是荒唐极了。"},"similar":["一叶障目，不见森林"],"usage":"作宾语、定语；用于处事"},{"id":40400,"word":"见棱见角","pinyin":"jiàn léng jiàn jiǎo","abbr":"jljj","explanation":"有棱有角。喻人的气势，个性表现很强。","example":{"text":"他是一个～的人。"},"similar":["棱角分明"],"usage":"作谓语、定语；指人有个性"},{"id":40401,"word":"见死不救","pinyin":"jiàn sǐ bù jiù","abbr":"jsbj","explanation":"看见人家有急难而不去救援。","source":{"text":"你做的今见死不救，羞见这桃园中杀马宰乌牛。","book":"元·关汉卿《救风尘》第二折"},"example":{"text":"周金大哥死在国民党军阀、官僚手里，你们～。","book":"欧阳山《三家巷》三一"},"similar":["自私自利","明哲保身","漠不关心"],"opposite":["舍己为人","济困扶危","助人为乐"],"usage":"作谓语、宾语、定语；形容冷酷无情","story":["春秋时期，孔子带领弟子们周游列国，在蔡国的日子里，孔子给弟子们讲仁，讲见义勇为，发现宰予在课堂上睡觉，叫醒宰予，宰予问孔子有人落井，跳下去救死了是仁和见义勇为，不救是见死不救是不仁。孔子说可以用其他办法救"]},{"id":40402,"word":"见溺不救","pinyin":"jiàn nì bù jiù","abbr":"jnbj","explanation":"犹言见死不救。看见人家有急难而不去救援。","source":{"text":"然僻居于山薮接珍，豺狼所皋，若固相拒，是见溺不救也。","book":"唐·皇甫枚《王知古》"},"example":{"text":"～的人真是麻木不仁。"},"similar":["见死不救"],"usage":"作宾语、定语；同“见死不救”"},{"id":40403,"word":"见物不取，失之千里","pinyin":"jiàn wù bù qǔ，shī zhī qiān lǐ","abbr":"jwbqszql","explanation":"见：遇到，看见；取：取得；失：失去。见到时不拿过来，以后再想要就更难办了。形容不要错失良机。","source":{"text":"呀，道兄差矣！岂不闻见物不取，失之千里，既遇明主，何必远去？","book":"明·张凤翼《红拂记·俊杰知时》"},"similar":["见之不取，思之千里"],"usage":"作宾语、分句；形容不要错失良机"},{"id":40404,"word":"见物不见人","pinyin":"jiàn wù bù jiàn rén","abbr":"jwbjr","explanation":"只看到事物，看不见人。指片面强调物质条件，看不到人的主观能动作用。","example":{"text":"我们看问题不能～。"},"usage":"作谓语、定语、宾语；用于处事"},{"id":40405,"word":"见猎心喜","pinyin":"jiàn liè xīn xǐ","abbr":"jlxx","explanation":"猎：打猎。看到打猎心里就高举。比喻看见别人在做的事正是自己过去所喜好的，不由得心动，也想试一试。","source":{"text":"和风扇物，弓燥手柔，草浅兽肥，见猎心喜。","book":"三国·魏·曹丕《典论自序》"},"example":{"text":"公子何不作一番我看，或者我～，竟领会得一两件，也不见得。","book":"清·文康《儿女英雄传》第十八回"},"similar":["跃跃欲试","触景生情","不觉技痒"],"usage":"作谓语、定语；指人的爱好","story":["北宋著名理学家程颢年轻时特别喜欢打猎，后来由于潜心研究学问就放弃了这个爱好，友人周茂叔说他这个爱好是不会消失的。12年后，程颢外出见到猎人在打猎，顿时感觉心痒手痒的，但想起周茂叔的话就只好强行克制自己的欲望"]},{"id":40406,"word":"见神见鬼","pinyin":"jiàn shén jiàn guǐ","abbr":"jsjg","explanation":"好像看见了鬼神。比喻多疑。","source":{"text":"有一般不识好恶秃奴，便即见神见鬼，指东划西。","book":"唐·释惠然《临济慧照玄公大宗师语录》"},"example":{"text":"袭人才去了一夜，你们就～的。","book":"清·曹雪芹《红楼梦》第五十一回"},"similar":["疑神疑鬼"],"usage":"作谓语、定语；指人多疑"},{"id":40407,"word":"见笑大方","pinyin":"jiàn xiào dà fāng","abbr":"jxdf","explanation":"指让内行人笑话。","source":{"text":"吾非至于子之门则殆矣，吾长见笑于大方之家。","book":"战国·宋·庄周《庄子·秋水》"},"example":{"text":"今时叠床架屋以为声气，不知见笑于大方之家。","book":"清·恽敬《与廖听桥书》"},"similar":["贻笑大方","见诮大方"],"usage":"作谓语、定语、宾语；常用于谦辞"},{"id":40408,"word":"见精识精","pinyin":"jiàn jīng shí jīng","abbr":"jjsj","explanation":"形容一看便明白，十分机灵。同“见经识经”。","source":{"text":"却被院中婆娘见精识精，看破了八九分。","book":"明·兰陵笑笑生《金瓶梅词话》第十一回"},"similar":["见经识经"],"usage":"作谓语、定语；用于为人处事"},{"id":40409,"word":"见素抱朴","pinyin":"xiàn sù bào pǔ","abbr":"xsbp","explanation":"老子提出的治国的三项具体措施之一。是说要推举圣人，实行法治，即用“无为之治”取代“有为之治”。对应于“绝圣弃智”。","source":{"text":"《老子》曰：“见素抱朴”。老子《道德经》新解：“见：现，呈现，推出。素：没有染色的生丝。这里比喻品质纯洁、高尚的圣人。朴：没有加工的原木。这里比喻合乎自然法则的社会法律。”。“见素抱朴、绝学无忧、少私寡欲”是老子提出的治国的三项具体措施。"},"example":{"text":"宋·程大昌《考古编·庄子》：“又皆推见礼法败坏之自，而归诸～之域。”"},"usage":"作宾语、定语；用于书面语"},{"id":40410,"word":"见经识经","pinyin":"jiàn jīng shí jīng","abbr":"jjsj","explanation":"形容一看便明白，十分机灵。","source":{"text":"［莲女］这女子件件聪明，见经识经，见书识书，邻近又有一个学堂，教此女子入学读书，不过一年，经史皆通。","book":"明·洪楩《清平山堂话本·花灯轿莲女成佛记》"},"example":{"text":"龙氏方才～，渐渐的收了法术。","book":"清·西周生《醒世姻缘传》第四十八回"},"similar":["见精识精"],"usage":"作谓语、定语；用于为人处事"},{"id":40411,"word":"见缝下蛆","pinyin":"jiàn fèng xià qū","abbr":"jfxq","explanation":"蛆：蝇的幼虫。比喻一有机会便为非作歹。","source":{"text":"公子不可不防，那严家父子，见缝下蛆，便鸡蛋里也寻骨头，没有做不出的坏事！如今他恼了，不如公子去拜拜老贼，将话语说开。","book":"明·兰陵笑笑生《金瓶梅词话》第十七回"},"example":{"text":"叶念秋～，四姨太枕畔吹风，天长日久，“红人”也会变成“白人”。","book":"桂雨清《蓝色妖姬》第八章"}},{"id":40412,"word":"见缝就钻","pinyin":"jiàn fèng jiù zuān","abbr":"jfjz","explanation":"比喻到处钻营或利用各种空子。","example":{"text":"我们不能～。"},"similar":["见缝插针"],"usage":"作谓语、定语、宾语；指人会钻营"},{"id":40413,"word":"见缝插针","pinyin":"jiàn fèng chā zhēn","abbr":"jfcz","explanation":"比喻尽可能利用一切可以利用的空间或时间。","source":{"text":"‘小钢炮后来打死了敌人不少’，陈三又见缝插针地鼓励他。","book":"魏巍《东方》第三部第七章"},"example":{"text":"分割敌人，牵制敌人，～，集中兵力，狠狠打击敌人。","book":"向春《煤城怒火》第21章"},"similar":["相机行事","争分夺秒"],"opposite":["水泼不进","针插不入"],"usage":"作定语、状语；指善于抓紧机会"},{"id":40414,"word":"见羹见墙","pinyin":"jiàn gēng jiàn qiáng","abbr":"jgjq","explanation":"后用以指对圣贤的思慕。","source":{"text":"相传尧去世后，舜仰慕三年，坐则见尧之幻影于墙，食则见尧之幻影于羹。见《后汉书·李固传》。"},"example":{"text":"既改旧观，亦资攻苦，～，趋绳步矩。","book":"清·戴名世《樊川书院碑记》"},"similar":["见墙见羹"],"usage":"作谓语、宾语；指念念不忘先贤","story":["传说古代，部落首领尧去世后，禅位给舜，舜很仰慕尧的丰功伟绩及德行操守，处处想以他为榜样。他非常思念尧，在三年内，一坐下就看见尧的影子出现在墙上，一吃饭就看见尧的影子出现在他的肉汤中"]},{"id":40415,"word":"见诮大方","pinyin":"jiàn qiào dà fāng","abbr":"jqdf","explanation":"指让内行人笑话。同“见笑大方”。","source":{"text":"庶几不以小说家言见诮大方，而笔墨匠亦不致笑我之浪用其资料也。","book":"清·吴趼人《〈两晋演义〉序》"},"similar":["见笑大方"],"usage":"作谓语、定语、宾语；常用于谦辞"},{"id":40416,"word":"见豕负涂","pinyin":"jiàn shǐ fù tú","abbr":"jsft","explanation":"看见猪趴在路上。比喻肮脏污秽。","source":{"text":"见豕负涂，甚可秽也。","book":"《周易·暌》：“上九，暌孤，见豕负涂。”王弼注"},"example":{"text":"～之爱竖，非次宠升，焦头烂额之辅臣，无辜窜逐。","book":"《旧唐书·懿宗纪论》"},"usage":"作宾语、定语；比喻肮脏污秽"},{"id":40417,"word":"见貌辨色","pinyin":"jiàn mào biàn sè","abbr":"jmbs","explanation":"根据对方的脸色、表情行事。","source":{"text":"僧问：‘和尚见古人得个什么便住此山？’师曰：‘情知汝不肯。’僧曰：‘争知某甲不肯？’师曰：‘鉴貌辨色。’","book":"宋·释道原《景德传灯录》"},"example":{"text":"朱世远终是男子之辈，～，已知女儿的心事。","book":"明·冯梦龙《醒世恒言》卷九"},"similar":["监貌辨色","鉴貌辨色"],"usage":"作谓语、宾语、定语；指根据对方的脸色行事"},{"id":40418,"word":"见财起意","pinyin":"jiàn cái qǐ yì","abbr":"jcqy","explanation":"见人钱财，动起歹念。","source":{"text":"刚道个一声儿恶人回避，早激的他恶哏哏闹是非，那里也见财起意。","book":"元·无名氏《硃砂担》第四折"},"example":{"text":"这厮原是远流配军，如何不做贼，以定是一时～。","book":"明·施耐庵《水浒全传》第三十回"},"similar":["见钱眼开"],"opposite":["路不拾遗","拾金不昧"],"usage":"作谓语、定语；指贪财"},{"id":40419,"word":"见贤不隐","pinyin":"jiàn xián bù yǐn","abbr":"jxby","explanation":"贤：贤能之人；隐：埋没。看见贤能的人，不予埋没。","source":{"text":"见贤不隐，食禄不专，此公叔之所以为文，魏成子所以为贤也。","book":"汉·桓谭《盐铁论·刺权》"},"example":{"text":"不实免王丹之官，得人加翟璜之赏，自然～，食禄不专。","book":"《旧唐书·薛登传》"},"usage":"作谓语、定语；用于处世"},{"id":40420,"word":"见贤思齐","pinyin":"jiàn xián sī qí","abbr":"jxsq","explanation":"贤：德才兼备的人；齐：相等。见到德才兼备的人就想赶上他。","source":{"text":"见贤思齐焉，见不贤而内自省也。","book":"《论语·里仁》"},"example":{"text":"则为他和曲填词，移宫换羽，使老夫～，回嗔作喜。","book":"元·关汉卿《谢天香》第四折"},"similar":["力争上游","取法乎上","见德思齐"],"opposite":["见利忘义"],"usage":"作谓语、宾语、定语；指追求进步"},{"id":40421,"word":"见金不见人","pinyin":"jiàn jīn bù jiàn rén","abbr":"jjbjr","explanation":"只看见金子，没有看见人。比喻人目光短浅，唯利是图。","source":{"text":"昔齐人有欲金者，清旦衣冠而之市，适鬻金者之所，因攫其金而去。吏捕得之，问曰：‘人皆在焉，子攫人之金何？’对曰：‘取金之时，不见人，徒见金。’","book":"《列子·说符》"},"example":{"text":"～，渠辈非吾族。君独臭味同，吾固知之熟。","book":"王炎《用前韵答黄一翁二首》"}},{"id":40422,"word":"见钱眼开","pinyin":"jiàn qián yǎn kāi","abbr":"jqyk","explanation":"看到钱财，眼睛就睁大了。形容人贪财。","source":{"text":"弃旧迎新，见钱眼开，自然之理。","book":"明·兰陵笑笑生《金瓶梅词话》第八十一回"},"example":{"text":"现在的这位中丞，面子上虽然清廉，骨底子是个～的人。","book":"清·李宝嘉《官场现形记》第二十三回"},"similar":["见利忘义","见钱眼红"],"opposite":["见利思义"],"usage":"作谓语、宾语；比喻贪婪爱财"},{"id":40423,"word":"见钱眼红","pinyin":"jiàn qián yǎn hóng","abbr":"jqyh","explanation":"看到钱财，眼睛就红了。形容人贪财。同“见钱眼开”。","source":{"text":"其中最易辨的，就只那双贼眼，因他见钱眼红，所以易辨。","book":"清·李汝珍《镜花缘》第58回"},"example":{"text":"请不要～，君子爱财，取之有道。"},"similar":["见钱眼开"],"usage":"作谓语、宾语；比喻贪婪爱财"},{"id":40424,"word":"见雀张罗","pinyin":"jiàn què zhāng luó","abbr":"jqzl","explanation":"比喻设圈套诱骗。","source":{"text":"则怕他指山卖磨，见雀张罗，满口儿如蜜钵，心如逝波。","book":"《红梨记·踏月》"},"usage":"作谓语、宾语；指设圈套诱骗"},{"id":40425,"word":"见鞍思马","pinyin":"jiàn ān sī mǎ","abbr":"jasm","explanation":"看见死去或离别的人留下的东西就想起了这个人。","source":{"text":"倚鞍思骏骨，抚辔念绿駬。","book":"宋·石介《徂徕石先生文集·三·感兴》"},"example":{"text":"看见旧时船中掠去锦绣衣服、宝玩器具等物，都在申兰家里，正是“～”。","book":"明·凌濛初《初刻拍案惊奇》卷十九"},"similar":["睹物思人"],"usage":"作宾语、定语；比喻触类相思"},{"id":40426,"word":"见风使帆","pinyin":"jiàn fēng shǐ fān","abbr":"jfsf","explanation":"比喻看势头或看别人的眼色行事。同“见风使舵”。","source":{"text":"幸喜写了凭据的二万头，中丞已允，卸了我的干系。别事见风使帆，再作道理。","book":"清·李宝嘉《官场现形记》第十九回"},"similar":["见风使舵","见风使船","见风转篷"],"usage":"作谓语、宾语、定语、状语；指见机行事"},{"id":40427,"word":"见风使舵","pinyin":"jiàn fēng shǐ duò","abbr":"jfsd","explanation":"看风向转发动舵柄。比喻看势头或看别人的眼色行事。","source":{"text":"看风使舵，正是随波逐流。","book":"宋·释普济《五灯会元》"},"example":{"text":"他们也就～，凡事一混了之。","book":"朱自清《闻一多全集编后记》"},"similar":["顺水推舟","见机行事"],"opposite":["一成不变"],"usage":"作谓语、宾语、定语、状语；指见机行事","story":["清朝时期，浙江刘中丞被御史告状，朝廷派钦差大臣去查办，该大臣到了浙江后采取“只拉弓，不放箭”的办法，想叫刘中丞贿赂他，于是让学生拉达对过道台说要二百万两银子就能过关，过道台写了字据给拉达，禀告刘中丞，刘中丞叫他见风使舵"]},{"id":40428,"word":"见风使船","pinyin":"jiàn fēng shǐ chuán","abbr":"jfsc","explanation":"比喻看势头或看别人的眼色行事。同“见风使舵”。","source":{"text":"这贺推仁更有一件本事，是专会见风驶船，看眼色行事。","book":"清·李宝嘉《官场现形记》第四十一回"},"similar":["见风使帆","见风使舵","见风转篷"],"usage":"作谓语、宾语、定语、状语；指见机行事"},{"id":40429,"word":"见风是雨","pinyin":"jiàn fēng shì yǔ","abbr":"jfsy","explanation":"比喻只看到一点迹象，就轻率地信以为真。","source":{"text":"他们做都老爷的，听见风就是雨，皇上原许他风闻奏事，说错了又没有不是的。","book":"清·李宝嘉《官场现形记》第25回"},"example":{"text":"你别～，造谣生事好不好。"},"usage":"作谓语、定语；指轻信"},{"id":40430,"word":"见风转篷","pinyin":"jiàn fēng zhuǎn péng","abbr":"jfzp","explanation":"比喻看势头或看别人的眼色行事。同“见风使舵”。","source":{"text":"那也不是真心替我办事，还是见风转篷的自私。我有钱不给这等人！","book":"茅盾《子夜》七"},"similar":["见风使帆","见风转舵","见风使船"],"usage":"作谓语、宾语、定语、状语；指见机行事"},{"id":40431,"word":"见风转舵","pinyin":"jiàn fēng zhuǎn duò","abbr":"jfzd","explanation":"看风向转发动舵柄。比喻看势头或看别人的眼色行事。","source":{"text":"看风使舵，正是随波逐流。","book":"宋·释普济《五灯会元》"},"example":{"text":"万一上面再传我去问话的时候，我也好～，别再那么一股死心眼儿卖傻劲。","book":"茅盾《腐蚀·十二月二十二日》"},"similar":["见机行事","见风使舵"],"usage":"作谓语、宾语、定语；指见机行事"},{"id":40432,"word":"见马克思","pinyin":"jiàn mǎ kè sī","abbr":"jmks","explanation":"死的委婉语。","source":{"text":"我比老弟痴长五岁，河北沧州人氏，父亲一九六七年被‘造反派’赶去见马克思了；不久，母亲也悲伤过度，哀哀而逝。","book":"李栋《心心相印》"},"similar":["见上帝"],"usage":"作谓语、定语；用于信仰马克思主义的人的死"},{"id":40433,"word":"见骥一毛","pinyin":"jiàn jì yī máo","abbr":"jjym","explanation":"只看见良马身上的一根毛。比喻只了解事物的局部。","source":{"text":"见骥一毛，不知其状；见画一色，不知其美。","book":"战国·鲁·尸佼《尸子》下卷"},"example":{"text":"见虎一文，不知其武；～，不知善走。","book":"西汉·刘安《淮南子·说林训》"},"usage":"作谓语、宾语、定语；指了解事物的局部"},{"id":40434,"word":"观于海者难为水","pinyin":"guān yú hǎi zhě nán wéi shuǐ","abbr":"gyhznws","explanation":"看过海的人，对一般的江河学觉得不值一看了。形容见的世面大，眼界高。","source":{"text":"孔子登东山而小鲁，登泰山而小天下，故观于海者难为水，游于圣人之门者难为言。","book":"《孟子·尽心上》"},"example":{"text":"清·褚人获《隋唐演义》第29回：“饮到半晌，真个是～，不但众人心中都有一点不足之意，就是……”"},"usage":"作宾语、定语；用于书面语"},{"id":40435,"word":"观今宜鉴古","pinyin":"guān jīn yì jiàn gǔ","abbr":"gjyjg","explanation":"宜：应该；鉴：镜子。观察当今的社会，应以古代为镜子加以借鉴。","source":{"text":"观今宜鉴古，无古不成今。","book":"《增广贤文》"},"example":{"text":"后代年轻朋友，更可以从这些历史经验中吸以一些‘～’的教训。","book":"李六如《六十年的变迁·自序》"},"usage":"作宾语、定语、分句；指借鉴古代的东西"},{"id":40436,"word":"观凤一羽","pinyin":"guān fèng yī yǔ","abbr":"gfyy","explanation":"观：看：凤：凤凰；羽：羽毛。只看见凤凰的一根羽毛。比喻只看到事物的一小部分，并不全面。","source":{"text":"毕竟一事做得时，在可以见其全体。古人谓观凤一羽，足以知其五色之备。","book":"宋·朱熹《论语四》"}},{"id":40437,"word":"观化听风","pinyin":"guān huà tīng fēng","abbr":"ghtf","explanation":"指希望看到良好的政治教化。","source":{"text":"言改易视听，欲急闻见善政化了。","book":"《汉书·张敞传》：“今天子以盛年初即位，天下莫不拭目倾耳，观化听风。”颜师古注"},"usage":"作谓语、宾语；用于书面语"},{"id":40438,"word":"观变沉机","pinyin":"guān biàn chén jī","abbr":"gbcj","explanation":"沉：深藏；机：机智。深藏机智，观察变化。形容头脑里办法多，有随机应变的才能。","source":{"text":"此观变沉机之士，恐不易罗致之。","book":"《洪秀全演义》第九回"},"usage":"作谓语、定语；指观察事物"},{"id":40439,"word":"观场矮人","pinyin":"guān chǎng ǎi rén","abbr":"gcar","explanation":"指见识浅鄙者。","source":{"text":"与紫庭诸葛孔明之出祁山，屯兵五丈原之失，叹陈寿之论孔明，分寸不失。观场矮人，未可与论古今也。紫庭见解超卓，迥出伦类，天下不多见也。","book":"清·刘献廷《广阳杂记》卷二"},"similar":["矮人观场"],"usage":"作宾语、定语；形容没见识、人云亦云"},{"id":40440,"word":"观山玩水","pinyin":"guān shān wán shuǐ","abbr":"gsws","explanation":"犹言游山玩水。","source":{"text":"诸仁者还明心也未？莫不是语言谭笑时……观山玩水时，耳目绝对时，是汝心否？","book":"《五灯会元·法眼宗·宝塔绍岩禅师》"},"example":{"text":"明·冯梦龙《醒世恒言》第38卷：“你在此若要～，任意无拘。”"},"similar":["游山玩水","观山览水"],"usage":"作谓语、定语、宾语；指旅游"},{"id":40441,"word":"观山览水","pinyin":"guān shān lǎn shuǐ","abbr":"gsls","explanation":"观：游览；山、水：指风景。游览、玩赏山水景物。","source":{"text":"我今主意，只教大官人多怀宝钞，远离家门，正好问柳寻花，又好观山览水。","book":"明·伏雌教主《醋葫芦》第14回"},"similar":["观山玩水"],"usage":"作谓语、定语、宾语；指旅游"},{"id":40442,"word":"观形察色","pinyin":"guān xíng chá sè","abbr":"gxcs","explanation":"观察脸色以揣测对方的心意。同“观貌察色”。","source":{"text":"此是人之常情，更待多说……观形察色，见貌之情。","book":"《水浒传》第一一○回"},"example":{"text":"且术士喜言怪诞……并造出无数捕风捉影之说，～之机，以肥囊利己。","book":"太平天国·洪仁玕《英杰归真》"},"similar":["观貌察色","观颜察色"],"usage":"作谓语、宾语、定语；用于处世"},{"id":40443,"word":"观往知来","pinyin":"guān wǎng zhī lái","abbr":"gwzl","explanation":"认真研究过去，就能推测未来。","source":{"text":"是故圣人见出以知入，观往而知来，此其所以先知之理也。","book":"《列子·说符》"},"usage":"作谓语、宾语；指看过去就能预知未来"},{"id":40444,"word":"观望不前","pinyin":"guān wàng bù qián","abbr":"gwbq","explanation":"不前：不敢上前。事情尚难确定时，怀着犹豫不定的心情，观察事物的发展，暂不前进。","source":{"text":"名为救赵，实持两端以观望。","book":"《史记·信陵君列传》"},"example":{"text":"接连又得知弟浣密书，教他切勿入朝，入朝必死，他越加恐惧，～。","book":"蔡东藩《五代史演义》第六回"},"similar":["坐山观虎斗","徘徊不前"],"usage":"作谓语、定语；形容犹豫不决"},{"id":40445,"word":"观望徘徊","pinyin":"guān wàng pái huái","abbr":"gwph","explanation":"观望：看风头，犹豫不决；徘徊：来回地走。形容犹豫不定，坐观事态发展。","source":{"text":"总之因循苟安之积习牢不可破，观望徘徊，不肯身先发难，所以然者畏杀而已。","book":"李群《杀人篇》"},"similar":["观望不前"],"usage":"作谓语、定语；形容犹豫不决"},{"id":40446,"word":"观望风色","pinyin":"guān wàng fēng sè","abbr":"gwfs","explanation":"观望：看风头。指犹豫不定，坐观情势发展，以便见机行事。","source":{"text":"由于黎的态度逐步软化，原属国民党的国会议员纷纷南下或者躲在六国饭店里观望风色。","book":"陶菊隐《北洋军阀统治时期史话》第27章"},"similar":["观望形势"],"usage":"作谓语、宾语、定语；用于处事"},{"id":40447,"word":"观机而作","pinyin":"guān jī ér zuò","abbr":"gjez","explanation":"等待时机然后行动。同“观机而动”。","source":{"text":"今臣在此，观机而作，不得准诏行事。","book":"《隋书·贺娄子幹传》"},"similar":["观机而动","相机而动"],"usage":"作谓语；指相机而动"},{"id":40448,"word":"观机而动","pinyin":"guān jī ér dòng","abbr":"gjed","explanation":"时：时机。等待时机然后行动。","source":{"text":"君子藏器于身，待时而动。","book":"《周易·系辞下》"},"similar":["相机而动","观机而作"],"usage":"作谓语；指相机而动"},{"id":40449,"word":"观眉说眼","pinyin":"guān méi shuō yǎn","abbr":"gmsy","explanation":"比喻挑眼，说闲话。","source":{"text":"叫你大娘寻家儿人家，你出身去罢，省得观眉说眼，在这屋里叫人骂没主子的奴才。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"},"usage":"作谓语；指看人家脸色"},{"id":40450,"word":"观瞻所系","pinyin":"guān zhān suǒ xì","abbr":"gzsx","explanation":"观瞻：外观以及对外观的反应。指人或具体物件的外观与人们的印象有很大的关系。","source":{"text":"后来自己也觉得在战时首都，国际观瞻所系，究竟不大方便。","book":"邹韬奋《患难余生记》第二章"},"usage":"作谓语；用于书面语"},{"id":40451,"word":"观者云集","pinyin":"guān zhě yún jí","abbr":"gzyj","explanation":"观看的人如行云那样密集。形容观看的人多。","source":{"text":"自咸通迄光启四十年间，游淮浙之宛陵，所至之处，观者云集。","book":"《云笈七签》卷一一三引前蜀·杜光庭《墉城集仙录·王奉仙》"},"example":{"text":"于是～，皆恐伤其子。计无所出。","book":"清·俞樾《右台仙馆笔记》卷四"},"similar":["观者如云","观者麕集"],"usage":"作谓语、定语；比喻看的人多"},{"id":40452,"word":"观者如云","pinyin":"guān zhě rú yún","abbr":"gzry","explanation":"观看的人就象行云一样密集。形容围看的人非常多。","source":{"text":"铿锵揖让秋光里，观者如云出凤城。","book":"唐·刘禹锡《监祠夕月坛书事》"},"example":{"text":"言适为项王相召饮酒，欲醉方返。溪滨～。","book":"宋·张君房《云笈七签》卷一百一十三"},"similar":["观者如堵","观者云集"],"usage":"作谓语、定语；比喻看的人多"},{"id":40453,"word":"观者如垛","pinyin":"guān zhě rú duǒ","abbr":"gzrd","explanation":"形容观看人数众多。同“观者如堵”。","source":{"text":"此时琼英这段事，东京已传遍了。当日观者如垛。","book":"《水浒传》第一○一回"},"similar":["观者如堵","观者成堵","观者如市"],"usage":"作定语、状语；形容观看人数众多"},{"id":40454,"word":"观者如堵","pinyin":"guān zhě rú dǔ","abbr":"gzrd","explanation":"堵：墙壁。观看的人象一堵墙一样。形容观看人数众多。","source":{"text":"孔子射于矍相之圃，盖观者如堵墙。","book":"《礼记·射义》"},"example":{"text":"在都市偶过市廛，闻弦歌声，～。","book":"清·蒲松龄《聊斋志异·口技》"},"similar":["观者如垛","观者成堵"],"usage":"作定语、状语；形容观看人数众多"},{"id":40455,"word":"观者如堵墙","pinyin":"guān zhě rú dǔ qiáng","abbr":"gzrdq","explanation":"堵：墙壁。形容观看人数众多。","source":{"text":"孔子射于矍相之圃，盖观者如堵墙。","book":"西汉·戴圣《礼记·射义》"},"example":{"text":"卫玠从豫章至下都，人久闻其名，～。","book":"南朝·宋·刘义庆《世说新语·容止》"},"similar":["观者如堵","观者如山"],"usage":"作定语、状语；形容观看人数众多"},{"id":40456,"word":"观者如山","pinyin":"guān zhě rú shān","abbr":"gzrs","explanation":"形容观看人数众多。","source":{"text":"昔有佳人公孙氏，一舞剑器动四方，观者如山色沮丧，天地为之久低昂。","book":"唐·杜甫《观公孙大娘弟子舞剑器行》"},"similar":["观者如堵"],"usage":"作定语、状语；形容观看人数众多"},{"id":40457,"word":"观者如市","pinyin":"guān zhě rú shì","abbr":"gzrs","explanation":"形容观看的人多。","source":{"text":"元和初，泗州普光王寺有梵氏戒坛，人之为僧者必由之。四方辐辏，僧尼繁会，观者如市焉。","book":"唐·牛僧孺《玄怪录·尼妙寂》"},"example":{"text":"罗方远，江夏人也。刺史春致设，～。","book":"《云笈七签》卷一一三引前蜀·杜光庭《神仙感遇传·罗方远》"},"similar":["观者如山","观者如堵"],"usage":"作定语、状语；形容观看人数众多"},{"id":40458,"word":"观者如织","pinyin":"guān zhě rú zhī","abbr":"gzrz","explanation":"织：编织的衣物。观众像编织起来的衣物一样密。形容观看的人非常多。","source":{"text":"御街游人嬉集，观者如织。","book":"宋·孟元老《东京梦华录·大礼预教车象》"},"similar":["观者如市","观者云集"],"usage":"作定语、状语；形容观看人数众多"},{"id":40459,"word":"观者成堵","pinyin":"guān zhě chéng dǔ","abbr":"gzcd","explanation":"形容观看人数众多。同“观者如堵”。","source":{"text":"又见其紫衫衣衲、拽杖挂珠，交错燕市之衢，所在说法衍乐，观者成堵。","book":"明·沈榜《宛署杂记·寺观》"},"similar":["观者如堵","观者如山","观者云集"],"usage":"作定语、状语；形容观看人数众多"},{"id":40460,"word":"观者猬集","pinyin":"guān zhě wèi jí","abbr":"gzwj","explanation":"猬：刺猬；猬集：像刺猬的硬刺那样多。观看的人如猬毛丛集。形容观看的人众多。","source":{"text":"儿初见人时，犹手持饼啖，了无怖畏，及观者猬集，语嘈嘈然，方惊啼。","book":"清·李清《鬼母传》"},"similar":["观者云集"],"usage":"作谓语、定语；比喻看的人多"},{"id":40461,"word":"观者穈集","pinyin":"guān zhě qún jí","abbr":"gzmj","explanation":"穈：成群；穈集：聚集，群集。观看的人聚集在一起。形容观看的人很多。","source":{"text":"柴皇急无措，大号，观者穈集询故，柴以实告，众以为狂，柴不得以行乞而归。","book":"清·杨复吉《梦阑琐笔·柴打鼓》"}},{"id":40462,"word":"观者蝟集","pinyin":"guān zhě wèi jí","abbr":"gzwj","explanation":"蝟集：比喻象刺猬的毛一样聚集在一起。形容观看的人很多。","source":{"text":"儿初见人时，犹手持饼啖，了无布畏，及观者蝟集，语嘈嘈然，方惊啼。","book":"清·李清《鬼母传》"}},{"id":40463,"word":"观者麕集","pinyin":"guān zhě jūn jí","abbr":"gzjj","explanation":"麕：通“群”，成群。形容观看的人数众多。","source":{"text":"柴皇急无措，大号，观者麕集询故，柴以实告，众以为狂，柴不得以行乞而归。","book":"杨复吉《梦阑琐笔·柴打鼓》"},"similar":["观者如山"],"usage":"作谓语、定语；形容人多"},{"id":40464,"word":"观衅伺隙","pinyin":"guān xìn sì xì","abbr":"gxsx","explanation":"衅、隙：破绽、漏洞。探察对方的破绽、漏洞，以待时机。","source":{"text":"且阻兵无众，古之明鉴，诚宜暂息进取小规，以蓄士民之力，观衅伺隙，庶无悔吝。","book":"《三国志·吴书·陆逊传》"},"usage":"作谓语、定语；指等待时机"},{"id":40465,"word":"观衅而动","pinyin":"guān xìn ér dòng","abbr":"gxed","explanation":"衅：破绽、漏洞。探察对方的破绽、漏洞，乘机发动进攻。","source":{"text":"隋武子曰：‘善。会闻而师，观衅而动。’","book":"《左传·宣公十二年》"},"example":{"text":"未可轻举，～可也。","book":"《辽史·太宗纪上》"},"similar":["伺机而动","观衅伺隙"],"usage":"作谓语、宾语；用于处事"},{"id":40466,"word":"观貌察色","pinyin":"guān mào chá sè","abbr":"gmcs","explanation":"观察脸色以揣测对方的心意。","source":{"text":"优笑侏儒，左右近习，此人主未命而唯唯，未使而诺诺，先意承旨，观貌察色以先主心者也。","book":"《韩非子·八奸》"},"similar":["观形察色","观颜察色"],"usage":"作谓语、宾语、定语；用于处世"},{"id":40467,"word":"观过知仁","pinyin":"guān guò zhī rén","abbr":"ggzr","explanation":"察看一个人所犯过错的性质，就可以了解他的为人。","source":{"text":"人之过也，各于其党，观过，斯知仁矣。","book":"《论语·里仁》"},"example":{"text":"～，斯亦可矣。","book":"明·李贽《初潭集·君臣七》"},"usage":"作谓语；指从过错看为人"},{"id":40468,"word":"观隅反三","pinyin":"guān yú fǎn sān","abbr":"gyfs","explanation":"犹言举一反三。比喻从一件事情类推而知道其他许多事情。","source":{"text":"进无方一知二之机，退无观隅反三之慧。","book":"北魏·郦道元《〈水经注〉序》"},"similar":["举一反三"],"usage":"作谓语、定语；用于书面语"},{"id":40469,"word":"观风察俗","pinyin":"guān fēng chá sú","abbr":"gfcs","explanation":"指观察国风民俗。","source":{"text":"其理谠而切，其文简而要，足以惩恶劝善，观风察俗者矣。","book":"唐·刘知幾《史通·载文》"},"usage":"作谓语、定语；用于书面语"},{"id":40470,"word":"规圆矩方","pinyin":"guī yuán jǔ fāng","abbr":"gyjf","explanation":"比喻够标准，合法度。","source":{"text":"夫推历生律制器，规圆矩方，权重衡平，准绳嘉量。","book":"《汉书·律历志上》"},"similar":["规矩绳墨"],"usage":"作宾语、定语；指合乎法度"},{"id":40471,"word":"规圜矩方","pinyin":"guī yuán jǔ fāng","abbr":"ghjf","explanation":"规：画圆的工具；圜：同“圆”；矩：方的工具。指合乎法度。","source":{"text":"夫推历生律制器，规圜矩方，权重衡平，准绳嘉量。","book":"东汉·班固《汉书·律历志》"},"similar":["规矩绳墨"],"usage":"作宾语、定语；指法规"},{"id":40472,"word":"规天矩地","pinyin":"guī tiān jǔ dì","abbr":"gtjd","explanation":"①规，为圆，象征天；矩，为方，象征地。②泛指效法天地。","source":{"text":"谓宫室之饰，贺者像天，方者则地也。","book":"《文选·张衡〈东京赋〉》：“乃营三宫，布教颁常。复庙重屋，八达九房。规天矩地，授时顺乡。”薛综注"},"example":{"text":"～，匡貌言，防狂僭，通蒙蔽……教人主法天，公卿、师保、大臣之世言也。","book":"清·龚自珍《乙丙之际塾议第十七》"},"usage":"作宾语、定语；用于处事"},{"id":40473,"word":"规旋矩折","pinyin":"guī xuán jǔ shé","abbr":"gxjs","explanation":"形容回旋转折的态势。","source":{"text":"或长邪角趣，或规旋矩折，修短相副，异体同势。","book":"汉·蔡邕《隶势》"},"example":{"text":"汉·蔡邕《隶势》：“或长邪角趣，或规旋矩折，修短相副，异体同势。”"},"usage":"作宾语、定语；用于书面语"},{"id":40474,"word":"规求无度","pinyin":"guī qiú wú dù","abbr":"gqwd","explanation":"规求：贪求；度：限度。一味贪求，没有限度。形容贪得无厌。","source":{"text":"侵欲无厌，规求无度。","book":"《左传·昭公二十六年》"},"similar":["贪得无厌"],"usage":"作谓语、宾语；形容贪得无厌"},{"id":40475,"word":"规矩准绳","pinyin":"guī jǔ zhǔn shéng","abbr":"gjzs","explanation":"规矩：画圆、方的工具；准绳：水准和绳墨，量平直的工具。指应当遵守的标准、法则。","source":{"text":"世用器械，规矩准绳，称量数度，品有所成。","book":"《孟子·离娄上》：“圣人既竭目力焉，继之以规矩准绳，以为方员平直，不可胜用也。”《管子·宙合》"},"example":{"text":"人才短长高下之不齐，而学力浅深中否之或异，岂能出～之外哉。","book":"宋·陈亮《告先圣文》"},"similar":["规矩绳墨","规矩钩绳"],"usage":"作谓语、定语；指标准"},{"id":40476,"word":"规矩绳墨","pinyin":"guī jǔ shéng mò","abbr":"gjsm","explanation":"规矩：画圆、方的工具；绳墨：量平直的工具。指应当遵守的标准、法则。","source":{"text":"法律政令者，吏民规矩绳墨也。","book":"春秋·齐·管仲《管子·七臣七主》"},"example":{"text":"他们还是严守一定的～的，只是在一个巨大的范围内，加以变化罢了。","book":"秦牧《巧匠和竹》"},"similar":["规矩钩绳"],"usage":"作宾语、定语；指法规"},{"id":40477,"word":"规矩钩绳","pinyin":"guī jǔ gōu shéng","abbr":"gjgs","explanation":"规矩：画圆、方的工具。指应当遵守的标准、法则。","source":{"text":"方圜曲直，皆中规矩钩绳。","book":"春秋·齐·管仲《管子·形势》"},"example":{"text":"若夫～，此巧之具也。","book":"西汉·刘向《淮南子·齐俗训》"},"similar":["规矩绳墨","规矩准绳"],"usage":"作宾语、定语；指法规"},{"id":40478,"word":"规绳矩墨","pinyin":"guī shéng jǔ mò","abbr":"gsjm","explanation":"指应当遵守的标准、法则。同“规矩绳墨”。","source":{"text":"昔倕之巧，目茂圆方，心定定平直，又造规绳矩墨以诲后人。","book":"汉·王符《潜夫论·赞学》"},"similar":["规矩绳墨"],"usage":"作宾语、定语；指法规"},{"id":40479,"word":"规虑揣度","pinyin":"guī lü chuǎi duó","abbr":"glcd","explanation":"按照常规考虑打算。指进行认真周密的计划。","source":{"text":"凡人之举事，莫不先以其知，规虑揣度，而后敢以定谋。","book":"《淮南子·人间训》"}},{"id":40480,"word":"规行矩止","pinyin":"guī xíng jǔ zhǐ","abbr":"gxjz","explanation":"规、矩：圆规和角尺，引伸为准则。指严格按照规矩办事，毫不苟且。也指办事死板，不灵活。","source":{"text":"二学儒官，缙绅先生之徒，垂缨佩玉，规行矩步者，皆端委而陪于堂下，以待执事之命。","book":"晋·潘尼《释奠颂》"},"example":{"text":"端居危坐，～，相与奋髯横议，役袂高谈。","book":"宋·司马光《稷下赋》"},"similar":["规行矩步","墨守成规"],"usage":"作宾语、定语；指办事死板，不灵活"},{"id":40481,"word":"规行矩步","pinyin":"guī xíng jǔ bù","abbr":"gxjb","explanation":"规、矩：圆规和角尺，引伸为准则；步：用脚走。指严格按照规矩办事，毫不苟且。也指办事死板，不灵活。","source":{"text":"规行矩步，安辞定色。","book":"晋·潘尼《释奠颂》：“二学儒官，缙绅先生之徒，垂缨佩玉，规行矩步者，皆端委而陪于堂下，以待执事之命。”北齐·颜之推《颜氏家训·序致》"},"example":{"text":"今士循常习故，～，积阶级，累阀阅，碌碌然以取世资。","book":"《晋书·张载传》"},"similar":["循规蹈矩","墨守成规"],"opposite":["别开生面","无法无天"],"usage":"作谓语、定语；指人很死板"},{"id":40482,"word":"规规矩矩","pinyin":"guī guī jǔ jǔ","abbr":"ggjj","explanation":"指人的品行方正，谨守礼法。","source":{"text":"说了不多几句话，宝玉也来了，进门见了王夫人，不过规规矩矩说了几句。","book":"清·曹雪芹《红楼梦》第25回"},"example":{"text":"靠右的一间正屋住着屋主罗斯托玛乞维列，一个～的市民。","book":"《第比利斯的地下印刷所》"},"similar":["老老实实"],"opposite":["有伤风化","不三不四"],"usage":"作谓语、定语、状语；指正正规规","story":["贾宝玉上了几天的学后就在家里与众姐妹厮混，王夫人见贾环下了学，命他抄《金刚咒》，贾环拿腔作势地抄写。凤姐来拜见王夫人，宝玉也来了，滚到了王夫人怀里，搂着王夫人的脖子，规规矩矩说了几句话，贾环在一旁痛恨宝玉"]},{"id":40483,"word":"规言矩步","pinyin":"guī yán jǔ bù","abbr":"gyjb","explanation":"说话赶路不离规矩。比喻言行谨遵法度。","source":{"text":"二学儒官，缙绅先生之徒，垂缨佩玉，规行矩步者，皆端委而陪于堂下，以待执事之命。","book":"晋·潘尼《释奠颂》"},"example":{"text":"汝近乃作负心事，知从前～，皆貌是心非。","book":"清·纪昀《阅微草堂笔记·如是我闻四》"},"usage":"作谓语、宾语；用于处事"},{"id":40484,"word":"规贤矩圣","pinyin":"guī xián jǔ shèng","abbr":"gxjs","explanation":"指效法圣贤。","source":{"text":"长铺广引，浩绝河汉，渠不起其辨！规贤矩圣，皎逾雪霜，渠不范其廉！","book":"宋·叶適《〈覆瓿集〉序》"},"usage":"作宾语、定语；用于处事"},{"id":40485,"word":"规重矩叠","pinyin":"guī chóng jǔ dié","abbr":"gcjd","explanation":"指合乎规矩法度。","source":{"text":"灵贶具臻，神光烨烨。晖祚无疆，规重矩叠。","book":"《宋史·乐志十》"},"example":{"text":"及今六合载清，真人抚运，崇尚佛乘，锡额建官……呜呼，何其～而一倡一新也。","book":"明·宋濂《觉原禅师遗衣塔铭》"},"usage":"作谓语、宾语；指符合礼法"},{"id":40486,"word":"规重矩迭","pinyin":"guī zhòng jǔ dié","abbr":"gzjd","explanation":"指合乎规矩法度。"},{"id":40487,"word":"觅柳寻花","pinyin":"mì liǔ xún huā","abbr":"mlxh","explanation":"觅：寻找。欣赏春天的景色。也指狎妓。","source":{"text":"元戎小队出郊坰，问柳寻花到野处。","book":"唐·杜甫《严中丞枉驾见过》诗"},"example":{"text":"那儿子却是风流博浪的人，专要结识朋友，～。","book":"明·冯梦龙《警世通言》卷三十"},"similar":["寻花问柳"],"usage":"作谓语、宾语、定语；指狎妓"},{"id":40488,"word":"觅爱追欢","pinyin":"mì ài zhuī huān","abbr":"mazh","explanation":"追求爱情与欢乐。","source":{"text":"你两人好大胆，竟忘却隔墙有耳，要觅爱追欢还须待后期。","book":"明·王錂《春芜记·邂逅》"}},{"id":40489,"word":"觅缝钻头","pinyin":"mì fèng zuān tóu","abbr":"mfzt","explanation":"缝：空隙；觅：寻找。比喻到处寻找门路，投机钻营。","source":{"text":"那玉箫听见主子使他干营生，又似来昭媳妇子那一本帐，连忙钻头觅缝，袖的去了。","book":"明·兰陵笑笑生《金瓶梅词话》第七十九回"}},{"id":40490,"word":"觅衣求食","pinyin":"mì yī qiú shí","abbr":"myqs","explanation":"寻找吃的和穿的。指谋生。","source":{"text":"却专一唬吓人财物，倚名托姓，觅衣求食，狐假虎威，鼠仗猫势。","book":"明·无名氏《渔樵闲话》第三折"},"example":{"text":"看你既不是官员赴任，以不是买卖经商，更不是～，究竟有什么要紧的勾当？","book":"清·文康《儿女英雄传》第五回"},"usage":"作谓语、宾语、定语；用于生存需要"},{"id":40491,"word":"觅迹寻踪","pinyin":"mì jì xún zōng","abbr":"mjxz","explanation":"觅：找；踪：迹，脚印，指行踪。到处寻找别人的行踪。","source":{"text":"却待要拄眼睁睛，觅迹寻踪，莫非他锦阵花营，不曾厮共，险教咱风月无功。","book":"元·吴昌龄《张天师断风花雪夜》第一折"}},{"id":40492,"word":"视下如伤","pinyin":"shì xià rú shāng","abbr":"sxrs","explanation":"把百姓当作有伤病的人一样照顾。旧时形容在位者关怀人民。同“视民如伤”。","source":{"text":"加以雄才大略，爱奇好士，视下如伤，役己利物，亦无得而称之。其经纬天地，岂虚谥也！","book":"《北史·魏纪三·孝文帝纪论》"},"similar":["视人如伤","视民如伤"],"usage":"作谓语、定语；多用于管理者"},{"id":40493,"word":"视丹如绿","pinyin":"shì dān rú lǜ","abbr":"sdrl","explanation":"丹：红。把红的看成绿的。形容因过分忧愁而目视昏花。","source":{"text":"心之忧矣，视丹如绿。","book":"三国魏·郭遐叔《赠嵇叔夜》诗"},"usage":"作谓语；指眼光模糊"},{"id":40494,"word":"视为儿戏","pinyin":"shì wéi ér xì","abbr":"swex","explanation":"比喻不当一回事，极不重视。同“视同儿戏”。","source":{"text":"你夫妻两口全没有一毫正经，把儿女终身视为儿戏。","book":"《平山冷燕》第五回：“这个使不得，既已写出，便关系朝廷耳目，须与山小姐一看，看是何如。岂可出乎反乎，视为儿戏。”《十二楼·夺锦楼》"},"example":{"text":"人命官司一事，他竟～，自为花上几个臭钱，没有不了的。","book":"清·曹雪芹《红楼梦》第四回"},"similar":["视同儿戏","视若儿戏"],"opposite":["郑重其事"],"usage":"作谓语、宾语；指极不重视"},{"id":40495,"word":"视为具文","pinyin":"shì wéi jù wén","abbr":"swjw","explanation":"具文：指徒有形式而不起实际作用的一纸空文。形容面对法规法令、文书条款等，仅将其看作一纸空文而全然不加以执行、实施。","source":{"text":"上计簿，具文而已，务为欺漫，以避其课。","book":"《汉书·宣帝纪》"},"example":{"text":"不惟地方上不见些起色，久而久之，连那些地方官也就～。","book":"清·文康《儿女英雄传》第四十回"}},{"id":40496,"word":"视为寇仇","pinyin":"shì wéi kòu chóu","abbr":"swkc","explanation":"寇仇：仇敌。看得象仇人一样。","source":{"text":"君之视臣如土芥，则臣视君如寇仇。","book":"《孟子·离娄下》"},"example":{"text":"倘明哲君子，洞察其奸，于家中妇女不时正言规劝，以三姑六婆～。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["视如寇仇"],"usage":"作谓语；指像仇人一样看待"},{"id":40497,"word":"视为寇雠","pinyin":"shì wéi kòu chóu","abbr":"swkc","explanation":"比喻极端仇视。","source":{"text":"君之视臣如土芥，则臣视君如寇雠。","book":"《孟子·离娄下》"}},{"id":40498,"word":"视为畏途","pinyin":"shì wéi wèi tú","abbr":"swwt","explanation":"畏途：可怕的道路。看成可怕的、危险的道路。也比喻看成困难的、可怕的事情。","source":{"text":"夫畏涂者，十杀一人，则父子兄弟相戒也。","book":"《庄子·达生》"},"example":{"text":"近来刑部，因批驳严，参罚重，缙绅中～。","book":"明·东鲁古狂生《醉醒石》第九回"},"similar":["望而生畏","望而却步"],"opposite":["奋不顾身","视死如归"],"usage":"作谓语；指胆小","story":["春秋时期，周威公与田开元谈论养生之道，田开元举出鲁国单豹与张毅两人养生的例子，强调要注意文化修养。庄子知道后感慨道：有人听说前面杀了人，于是视为畏途，告诫全家带上刀结伴而行是明智之举，纵情声色享受比杀人还可怕"]},{"id":40499,"word":"视为知己","pinyin":"shì wéi zhī jǐ","abbr":"swzj","explanation":"看成好朋友。","example":{"text":"独故太仆灌夫，却与婴沆瀣相投，始终交好，不改故态，婴遂～，格外情深。","book":"蔡东藩《前汉演义》第六十三回"},"usage":"作谓语、定语；用于交往"},{"id":40500,"word":"视为等闲","pinyin":"shì wéi děng xián","abbr":"swdx","explanation":"等闲：无关紧要。把它看成无关紧要，不予重视。","source":{"text":"难道对人民负责的文艺工作者应当对这样的事实视为等闲吗？","book":"周恩来《在中华全国文学艺术工作者代表大会上的政治报告》"},"example":{"text":"周恩来《在中华全国文学艺术工作者代表大会上的政治报告》：“难道对人民负责的文艺工作者应当对这样的事实～吗？”"},"similar":["等闲视之"],"usage":"作谓语、宾语；多用于否定句，反问句"},{"id":40501,"word":"视为至宝","pinyin":"shì wéi zhì bǎo","abbr":"swzb","explanation":"至宝：极珍贵的宝物。极其珍视，看成是最珍贵的宝物。","example":{"text":"先是匈奴与汉和亲，得汉所遗缯絮食物，～，自单于以至贵族，并皆衣缯食米，诩诩自得。","book":"蔡东藩《前汉演义》第五十回"}},{"id":40502,"word":"视之不见，听之不闻","pinyin":"shì zhī bù jiàn，tīng zhī bù wén","abbr":"szbjtzbw","explanation":"看见了同没有看见一样，听见了同没有听见一样。形容不重视，不注意。同“视而不见，听而不闻”。","source":{"text":"看见了同没有看见一样，听见了同没有听见一样。形容不重视，不注意。同“视而不见，听而不闻”。"},"example":{"text":"宋·张君房《云笈七签》第二卷：“唯吾老君犹处空玄寂寥之外，玄虚之中，～。”"},"similar":["视而不见，听而不闻"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40503,"word":"视人如伤","pinyin":"shì rén rú shāng","abbr":"srrs","explanation":"把百姓当作有伤病的人一样照顾。旧时形容在位者关怀人民。同“视民如伤”。","source":{"text":"居传其政，爱人如子；山则有梁，镇兹一方；君宏其道，视人如伤。","book":"唐·杨炯《为梓州官属祭陆郪县文》"},"similar":["视民如伤","视下如伤"],"usage":"作谓语、定语；多用于管理者"},{"id":40504,"word":"视人如子","pinyin":"shì rén rú zǐ","abbr":"srrz","explanation":"形容帝王、官吏爱护百姓。同“视民如子”。","source":{"text":"其在军州，倾心下士，视人如子，无约而亲附，不言而条理。","book":"唐·张说《河西节度副大使鄯州都督安乡神道碑序》"},"similar":["视民如子"],"usage":"作谓语、定语；用于称赞有仁义道德的官员"},{"id":40505,"word":"视人犹芥","pinyin":"shì rén yóu jiè","abbr":"sryj","explanation":"视：看待；犹：像；芥：草芥，小草。看待别人像草芥一样。形容骄傲自大，看不起别人。","source":{"text":"器满意得，视人如芥。","book":"《抱朴子·刺骄》"},"similar":["视如土芥"],"usage":"作谓语、定语；用于书面语"},{"id":40506,"word":"视其所使","pinyin":"shì qí suǒ shǐ","abbr":"sqss","explanation":"所使：所使用的人。他所使用的人，就知道其人如何。","source":{"text":"夫欲知其子视其友，欲知其君视其所使。","book":"汉·王充《论衡·问孔》"}},{"id":40507,"word":"视同一律","pinyin":"shì tóng yī lǜ","abbr":"styl","explanation":"指同等看待。","source":{"text":"至于‘忠实于自己的艺术的作者’，却并未视同一律。","book":"鲁迅《南腔北调集·又论“第三种人”》"},"example":{"text":"这两件事不能～。"},"similar":["一视同仁"],"usage":"作谓语；指同等看待"},{"id":40508,"word":"视同儿戏","pinyin":"shì tóng ér xì","abbr":"stex","explanation":"把事情当成小孩儿玩耍一样来对待。比喻不当一回事，极不重视。","source":{"text":"曩者霸上、棘门军，若儿戏耳，其将固可袭而虏也。","book":"《史记·绛侯周勃世家》"},"example":{"text":"为官做吏的人，千万不可草菅人命，～。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["率尔操觚","视为儿戏","视若儿戏"],"opposite":["三思而行","小心翼翼"],"usage":"作谓语、宾语；指极不重视","story":["汉文帝时期，匈奴与汉朝关系紧张，汉文帝安排宗正刘礼驻守灞上、祝兹侯徐历驻守棘门、河内郡太守周亚夫驻守细柳抵御匈奴，并亲自视察灞上与棘门，见到刘礼与徐历把防守视同儿戏，十分生气，见到周亚夫严密防卫才放心"]},{"id":40509,"word":"视同手足","pinyin":"shì tóng shǒu zú","abbr":"stsz","explanation":"手足：比喻亲兄弟。看得跟亲弟兄一样。指关系非常亲密。","example":{"text":"既蒙顾全宗谊，此后当～，誓不相负。","book":"蔡东藩《宋史演义》第三回"}},{"id":40510,"word":"视同拱璧","pinyin":"shì tóng gǒng bì","abbr":"stgb","explanation":"看作两手合抱的璧玉。比喻十分珍贵。","source":{"text":"求着他一副对子，一把扇子，那就视同拱壁，也不管他的字好歹。","book":"清·吴研人《二十年目睹之怪现状》第二十四回"},"similar":["视如拱璧"],"usage":"作谓语、定语；用于书面语"},{"id":40511,"word":"视同秦越","pinyin":"shì tóng qín yuè","abbr":"stqy","explanation":"古代秦国与越国相距甚远，因称疏远隔膜为“秦越”。把事情看得似秦国和越国那样毫不相关。","source":{"text":"激切忠怀一生凭谁说，怎忍得视同秦越。","book":"明·陈汝元《金莲记·赐环》"},"usage":"作谓语、定语；用于处事"},{"id":40512,"word":"视同路人","pinyin":"shì tóng lù rén","abbr":"stlr","explanation":"路人：过路人，指素不相识的人。看做路上遇到的陌生人。指与亲人或熟人非常疏远。","source":{"text":"漫然视若路人；甚而等之仇敌。","book":"明·凌濛初《初刻拍案惊奇》卷十三"},"example":{"text":"他把自己的亲儿子～，太不像话了"},"similar":["视若路人","视如陌路"],"usage":"作谓语、定语；指关系疏远"},{"id":40513,"word":"视同陌路","pinyin":"shì tóng mò lù","abbr":"stml","explanation":"看做路上遇到的陌生人。指与亲人或熟人非常疏远。","source":{"text":"他今有病，便视同陌路，此岂稍有人心者耶？","book":"清·夏敬渠《野叟曝言》第20回"},"example":{"text":"当亲朋好友来借钱时，他把他们～置之不理。"},"similar":["视若路人","视如陌路"],"usage":"作谓语；指关系疏远"},{"id":40514,"word":"视如土芥","pinyin":"shì rú tǔ jiè","abbr":"srtj","explanation":"芥：小草。看作象泥土，小草一般轻贱。比喻不放在眼里。","source":{"text":"君之视臣如土芥，则臣视君如寇仇。","book":"《孟子·离娄下》"},"example":{"text":"盐商富贵奢华，多少士大夫见了就销魂夺魄，你一个弱女子，～，这就可敬的极了。","book":"清·吴敬梓《儒林外史》第二十一回"},"similar":["视如草芥"],"usage":"作谓语；指极端轻视"},{"id":40515,"word":"视如寇仇","pinyin":"shì rú kòu chóu","abbr":"srkc","explanation":"寇仇：仇敌。看得象仇人一样。","source":{"text":"君之视臣如土芥，则臣视君如寇仇。","book":"《孟子·离娄下》"},"example":{"text":"倘明哲君子，洞察其奸，于家中妇女不时正言规劝，以三姑六婆～。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["视为寇仇"],"opposite":["亲如骨肉"],"usage":"作谓语；指像仇人一样看待"},{"id":40516,"word":"视如拱璧","pinyin":"shì rú gǒng bì","abbr":"srgb","explanation":"拱璧：以两拇指尖与两个食指尖合围那样的大璧。指看得极其宝贵。","source":{"text":"始纳婢，经年余生一子，视如拱璧，名之珠儿。","book":"清·蒲松龄《聊斋志异·珠儿》"},"similar":["视同拱璧"],"usage":"作谓语、定语；用于书面语"},{"id":40517,"word":"视如敝屐","pinyin":"shì rú bì jī","abbr":"srbj","explanation":"象破烂鞋子一样看待。比喻非常轻视。"},{"id":40518,"word":"视如敝屣","pinyin":"shì rú bì xǐ","abbr":"srbx","explanation":"敝屣：破鞋子。象破烂鞋子一样看待。比喻非常轻视。","source":{"text":"舜视弃天下犹弃敝屣也。","book":"《孟子·尽心上》"},"example":{"text":"其仁如天，至公如地，视天位如敝屣。","book":"清·章炳麟《驳康有为论革命书》"},"similar":["视若敝屣"],"usage":"作谓语、宾语；指非常轻视"},{"id":40519,"word":"视如珍宝","pinyin":"shì rú zhēn bǎo","abbr":"srzb","explanation":"形容十分珍爱。","source":{"text":"当此圣世，咱们世受国恩，祖父锦衣玉食；况你自有生以来，自去世的老太太，以及老爷太太，视如珍宝。","book":"清·曹雪芹《红楼梦》第一百十八回"},"example":{"text":"令尊只亲生你一个儿子，～。","book":"清·李绿园《歧路灯》第十四回"},"opposite":["视如敝屣"],"usage":"作谓语、定语；指十分重视"},{"id":40520,"word":"视如畏途","pinyin":"shì rú wèi tú","abbr":"srwt","explanation":"畏途：可怕的道路。看成可怕的、危险的道路。也比喻看成困难的、可怕的事情。","source":{"text":"夫畏涂者，十杀一人，则父子兄弟相戒也。","book":"《庄子·达生》"},"example":{"text":"近来刑部，因批驳严，参罚重，缙绅中～。","book":"明·东鲁古狂生《醉醒石》第九回"}},{"id":40521,"word":"视如粪土","pinyin":"shì rú fèn tǔ","abbr":"srft","explanation":"粪土：秽土，脏土。看得如同粪土那样恶劣、下贱。比喻极为蔑视。","source":{"text":"今舅儿把他视如粪土，又是王衍一流人物了。","book":"清·李汝珍《镜花缘》第38回"},"example":{"text":"我们把小人～。"},"similar":["视如草芥"],"opposite":["视如珍宝"],"usage":"作谓语；比喻极为蔑视"},{"id":40522,"word":"视如草芥","pinyin":"shì rú cǎo jiè","abbr":"srcj","explanation":"芥：小草。看作象泥土，小草一般轻贱。比喻极端轻视。","source":{"text":"君之视臣如土芥，则臣视君如寇仇。","book":"《孟子·离娄下》"},"example":{"text":"任其生死，～。","book":"鲁迅《且介亭杂文·病后杂谈之余》"},"similar":["视如敝屣","草菅人命","不屑一顾"],"opposite":["刮目相看","敝帚自珍"],"usage":"作谓语；指非常轻视"},{"id":40523,"word":"视如陌路","pinyin":"shì rú mò lù","abbr":"srml","explanation":"指与亲人或熟人非常疏远。同“视若路人”。","source":{"text":"当今之世，面交者多。饮酒宴乐，情若同胞；利害相关，视如陌路。","book":"明·方汝浩《禅真逸史》第十一回"},"similar":["视若路人","视同陌路"],"usage":"作谓语、定语；指关系疏远"},{"id":40524,"word":"视富如贫","pinyin":"shì fù rú pín","abbr":"sfrp","explanation":"视：看。看见富有如同贫困。指对贫富毫不在意。","source":{"text":"视生如死，视富如贫。","book":"《列子·仲尼》"}},{"id":40525,"word":"视微知著","pinyin":"shì wēi zhī zhuó","abbr":"swzz","explanation":"看到细微迹象，就能知道它的发展趋势。","source":{"text":"君子视微知著，见始知终，祸无从起，此思虑之政也。","book":"三国·蜀·诸葛亮《便宜十六策·思虑》"},"usage":"作谓语、定语；用于处事"},{"id":40526,"word":"视日如年","pinyin":"shì rì rú nián","abbr":"srrn","explanation":"指时间虽短，但却感到过得很长。","source":{"text":"自发义乌信，引领西跂，视日如年，今两月矣。","book":"明·方孝孺《与郑叔度书》之七"},"similar":["度日如年"],"usage":"作谓语、宾语、定语；形容日子很不好过"},{"id":40527,"word":"视有如无","pinyin":"shì yǒu rú wú","abbr":"syrw","explanation":"把有事看得象没事一样。形容不重视，不当一回事。","source":{"text":"贾母等如何谢恩，如何回家，亲朋如何来庆贺，宁荣两处近日如何热闹，众人如何得意，独他一个皆视有如无，毫不曾介意。","book":"清·曹雪芹《红楼梦》第十六回"},"example":{"text":"那鳌拜～，眯着眼口中念念有词。","book":"二月河《康熙大帝》十二三"},"similar":["视有若无"],"usage":"作谓语、定语；用于处事"},{"id":40528,"word":"视有若无","pinyin":"shì yǒu ruò wú","abbr":"syrw","explanation":"把有事看得象没事一样。形容不重视，不当一回事。","source":{"text":"究之这戏子见惯浑闲事，视有若无。","book":"清·李绿园《歧路灯》第七十八回"},"example":{"text":"眼见高士奇毫不惭愧，直将众人～，越发耐不得。","book":"二月河《乾隆皇帝》十九"},"similar":["视有如无"],"usage":"作谓语、定语；用于处事"},{"id":40529,"word":"视死如归","pinyin":"shì sǐ rú guī","abbr":"ssrg","explanation":"把死看得象回家一样平常。形容不怕牺牲生命。","source":{"text":"三军之士，视死如归。","book":"《韩非子·外储说左下》：“三军既成阵，使士视死如归，臣不如公子成父。”《吕氏春秋·勿躬》"},"example":{"text":"我们已经是～，我们大踏步地走着我们的大路。","book":"郭沫若《如火如荼的恐怖》诗"},"similar":["舍生忘死","舍生取义","视死若归"],"opposite":["贪生怕死"],"usage":"作谓语、定语、状语；指不怕死","story":["1904年秋瑾不顾丈夫的阻挠，变卖首饰东渡日本，结识黄兴、陈天华、宋教仁等，她加盟孙中山的同盟会。1906年她带领由留日学生组成的敢死队回国，任大通学堂督办。后因徐锡麟起义失败而被捕，临刑前说“革命党人不怕死，欲杀便杀”"]},{"id":40530,"word":"视死如生","pinyin":"shì sǐ rú shēng","abbr":"ssrs","explanation":"把死去看作如活着一样。形容不怕死。","source":{"text":"故能使其众蒙矢石，赴汤火，视死如生。","book":"《庄子·秋水》：“视死若生者，烈士之勇也。”《汉书·晁错传》"},"similar":["视死若生"],"usage":"作谓语、定语；用于处世等"},{"id":40531,"word":"视死如饴","pinyin":"shì sǐ rú yí","abbr":"ssry","explanation":"饴：糖。指甘心死去。","source":{"text":"蒯彻本以口舌从事，与武涉同时，为主其心，吠尧何罪，甘赴鼎镬，视死如饴，诚壮士也。","book":"元·无名氏《赚蒯通》第四折"},"example":{"text":"清·徐岳《琼枝曼仙记》：“琼枝曼仙一娼耳，奋不顾身，～，不更贤于忠臣义士之所为耶？”"},"similar":["含笑九泉"],"usage":"作谓语；指甘心死去"},{"id":40532,"word":"视死犹归","pinyin":"shì sǐ yóu guī","abbr":"ssyg","explanation":"把死看得象回家一样平常。形容不怕牺牲生命。同“视死如归”。","source":{"text":"然而胆劲心方，不畏强御，义正所在，视死犹归。","book":"晋·葛洪《抱朴子·行品》"},"similar":["视死如归","视死若归"],"opposite":["贪生怕死"],"usage":"作谓语、定语、状语；指不怕死"},{"id":40533,"word":"视死若归","pinyin":"shì sǐ ruò guī","abbr":"ssrg","explanation":"把死看得象回家一样平常。形容不怕牺牲生命。同“视死如归”。","source":{"text":"故战日有期，视死若归。","book":"《淮南子·兵略训》"},"similar":["视死如归","视死犹归"],"opposite":["贪生怕死"],"usage":"作谓语、定语、状语；指不怕死"},{"id":40534,"word":"视死若生","pinyin":"shì sǐ ruò shēng","abbr":"ssrs","explanation":"把死去看做活着一样。形容不怕死。","source":{"text":"白刃交于前，视死若生者，烈士之勇也。","book":"《庄子·秋水》"},"similar":["视死如生"],"usage":"作谓语、定语；用于处世等"},{"id":40535,"word":"视民如伤","pinyin":"shì mín rú shāng","abbr":"smrs","explanation":"把百姓当作有伤病的人一样照顾。旧时形容在位者关怀人民。","source":{"text":"臣闻国之兴也，视民如伤，是其福也；其亡也，以民为土芥，是其祸也。","book":"《左传·哀公元年》"},"example":{"text":"君莅其任，～。","book":"晋·潘岳《扬荆州诔》"},"similar":["爱民如子","视人如伤","视下如伤"],"opposite":["视如草芥"],"usage":"作谓语、定语；多用于管理者"},{"id":40536,"word":"视民如子","pinyin":"shì mín rú zǐ","abbr":"smrz","explanation":"把百姓看得像自己的孩子一样。形容爱民。","source":{"text":"吴光新得国，而亲其民，视民如子，辛苦同之，将用之也。","book":"春秋·鲁·左丘明《左传·昭公三年》"},"example":{"text":"其在军州倾心下士，～，无约而视附，不言而条理。","book":"唐·张说《河西节度副大使鄯州都督安乡神道碑》"},"similar":["爱民如子","视人如子"],"usage":"作谓语、定语；用于称赞有仁义道德的官员","story":["春秋时期，公子僚当上吴王，长子光心存怨恨，他设宴让专诸扮作厨师杀掉吴王，自己成为吴王阖闾。他任用伍子胥为相国，任用孙武为将军，特别注意自己的一举一动，生活十分俭朴，视民如子，几年后，吴国就成为强国"]},{"id":40537,"word":"视溺不援","pinyin":"shì nì bù yuán","abbr":"snby","explanation":"看到人淹没在水里而不拉他一把。比喻见到人处于危险境地而置之不理。","source":{"text":"临渴掘井，固是不弟不情；视溺不援，在吾兄亦觉太忍。","book":"清·无名氏《赛红丝》五"}},{"id":40538,"word":"视白成黑","pinyin":"shì bái chéng hēi","abbr":"sbch","explanation":"视：看。把白色看成黑色。指颠倒美丑、善恶或是非。","source":{"text":"视白成黑，颠倒妍媸。","book":"唐·柳完元《瓶赋》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":40539,"word":"视而不见","pinyin":"shì ér bù jiàn","abbr":"sebj","explanation":"指不注意，不重视，睁着眼却没看见。也指不理睬，看见了当作没看见。","source":{"text":"终日视之而不见，听之而不闻，搏之而不得也。","book":"战国·宋·庄周《庄子·知北游》"},"example":{"text":"～，谓合道于希夷。","book":"唐·韩愈《明水赋》"},"similar":["视若无睹","听而不闻"],"opposite":["过目不忘"],"usage":"作谓语、定语；指漠不关心"},{"id":40540,"word":"视而不见，听而不闻","pinyin":"shì ér bù jiàn，tīng ér bù wén","abbr":"sebjtebw","explanation":"虽然望着，却没看见；虽然听着，却没听到。形容不关心，不注意。","source":{"text":"心不在焉，视而不见，听而不闻，食而不知其味。","book":"《老子》第十四章：“视之不见名曰夷，听之不闻名曰希。”《礼记·大学》"},"example":{"text":"英雄人物即使就在他眼前，他也会～的。","book":"秦牧《核心》"},"similar":["视之不见，听之不闻"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40541,"word":"视而弗见，听而弗闻","pinyin":"shì ér fú jiàn，tīng ér fú wén","abbr":"sefjtefw","explanation":"视：看。指不注意，不重视，睁着眼却没看见。也指不理睬，看见了当作没看见，听到了当作没听见。","source":{"text":"鬼神之为德其咸乎，视之而弗见，听之而弗闻。","book":"西汉·戴圣《礼记·中庸》"},"similar":["视之不见，听之不闻"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40542,"word":"视若儿戏","pinyin":"shì ruò ér xì","abbr":"srex","explanation":"比喻不当一回事，极不重视。同“视同儿戏”。","source":{"text":"又劾都察院京察给事中色成额先经列入六法，自赴公堂辩论，干求改列三等，反覆视若儿戏，都御史被严议，色成额仍列有疾。","book":"《清史稿·李振祜传》"},"example":{"text":"《清史稿·李振祜传》：“自赴公堂辩论，干求改列三等，反覆～，都御史被严议，色成额仍列有疾。”"},"similar":["视同儿戏","视为儿戏"],"opposite":["郑重其事"],"usage":"作谓语、宾语；指极不重视"},{"id":40543,"word":"视若无睹","pinyin":"shì ruò wú dǔ","abbr":"srwd","explanation":"睹：看见。虽然看见了，却象没有看见一样。指对眼前事物莫不关心。","source":{"text":"是以有力者遇之，熟视之若无睹也。","book":"唐·韩愈《应科目时与人书》"},"example":{"text":"对敌人采用的反动的新原则～。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["视而不见","充耳不闻","熟视无睹"],"opposite":["亲眼目睹"],"usage":"作谓语、状语；指漠不关心"},{"id":40544,"word":"视若路人","pinyin":"shì ruò lù rén","abbr":"srlr","explanation":"看做路上遇到的陌生人。指与亲人或熟人非常疏远。","source":{"text":"漫然视若路人，甚而等之仇敌，败坏彝伦，灭绝天理。","book":"明·凌濛初《初刻拍案惊奇》第13卷"},"example":{"text":"～，至饥饱寒温，无可告语。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录六》"},"similar":["视同陌路","视如陌路"],"usage":"作谓语、定语；指关系疏远"},{"id":40545,"word":"视虱如轮","pinyin":"shì shī rú lún","abbr":"ssrl","explanation":"把虱子看成像车轮那样大。指全神贯注于某一事物，达到造诣极深的境界。","source":{"text":"昌以氂悬虱于牖，南面而望之，旬日之间，浸大也；三年以后，如车轮焉。以睹余物，皆丘山也。","book":"《列子·汤问》"},"example":{"text":"圣处分明世鲜知，古人岂是异肝脾。谓鳌可钓无传法，～有悟时。","book":"宋·刘克庄《答陈楙伯二首》其二"}},{"id":40546,"word":"视财如命","pinyin":"shì cái rú mìng","abbr":"scrm","explanation":"形容人的吝啬，把钱财看得有如生命一般。","source":{"text":"如今这位哨官要求给三钱银子，竟碰了这样一个钉子，可见此时的武官是怎样的视财如命了。","book":"冯玉祥《我的生活》第六章"},"example":{"text":"他～，若想要他捐款，真比登天还难。"},"similar":["爱财如命"],"opposite":["仗义疏财"],"usage":"作谓语、定语；形容十分贪婪、吝啬"},{"id":40547,"word":"视远步高","pinyin":"shì yuǎn bù gāo","abbr":"sybg","explanation":"高视阔步。形容态度傲慢。","source":{"text":"视远，望视远；步高，举足高也。","book":"《国语·周语下》：“柯陵之会，单襄公见晋厉公，视远步高。”韦昭注"},"similar":["高视阔步"],"usage":"作谓语、定语、状语；指人的风度"},{"id":40548,"word":"视险如夷","pinyin":"shì xiǎn rú yí","abbr":"sxry","explanation":"夷：平坦。走在危险的地方就象走在平地一样。比喻平安地渡过困境。","source":{"text":"今得东移，望远若近，视险如夷。","book":"汉·刘协《喻郭汜诏》"},"example":{"text":"处谥不骄，居劳不惮；～，忘身逐叛。","book":"晋·史援《后汉史君颂》"},"similar":["视险若夷"],"usage":"作谓语、定语；指人勇敢"},{"id":40549,"word":"视险若夷","pinyin":"shì xiǎn ruò yí","abbr":"sxry","explanation":"走在危险的地方就象走在平地一样。比喻平安地渡过困境。同“视险如夷”。","source":{"text":"方肃承庙略，恭行天讨，饮冰遄迈，视险若夷。","book":"三国·魏·吴质《与文帝书》：“虽云幽深，视险若夷。”《隋书·刘方传》"},"example":{"text":"《隋书·刘方传》：“方肃承庙略，恭行天讨，饮冰煓迈，～。”"},"similar":["视险如夷"],"usage":"作谓语、定语；指人勇敢"},{"id":40550,"word":"览闻辩见","pinyin":"lǎn wén biàn jiàn","abbr":"lwbj","explanation":"指见识多，能说会道。","source":{"text":"为人览闻辩见，目达耳通，诸事无所不知。","book":"汉·袁康《越绝书·外传纪策考》"},"similar":["见多识广"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；指见识多"},{"id":40551,"word":"觉人觉世","pinyin":"jué rén jué shì","abbr":"jrjs","explanation":"指启发世人觉悟。","source":{"text":"我如今也谱得《道情》十首，无非唤醒痴聋，销除烦恼……若遇争名夺利之场，正好觉人觉世。","book":"清关燮《序》"},"similar":["发蒙振聩"],"usage":"作谓语、定语；指启发世人觉悟"},{"id":40552,"word":"觊觎之心","pinyin":"jì yú zhī xīn","abbr":"jyzx","explanation":"觊觎：非分的希望或企图。指非分之想。","source":{"text":"君多内宠，公子突、公子仪、公子亹三人，皆有觊觎之志。","book":"明·冯梦龙《东周列国志》第八回"},"example":{"text":"那知那声色犬马，奇技淫物，适足以起大盗～。","book":"清·褚人获《隋唐演义》第九十三回"},"similar":["觊觎之志","非分之想"],"usage":"作主语、宾语；指非分之想"},{"id":40553,"word":"觊觎之志","pinyin":"jì yú zhī zhì","abbr":"jyzz","explanation":"觊觎：非分的希望或企图。指非分之想。","source":{"text":"君多内宠，公子突、公子仪、公子亹三人，皆有觊觎之志。","book":"明·冯梦龙《东周列国志》第八回"},"similar":["觊觎之心"],"usage":"作主语、宾语；指非分之想"},{"id":40554,"word":"角力中原","pinyin":"jué lì zhōng yuán","abbr":"jlzy","explanation":"角：较量。在中原角逐、较量。比喻以武力争雄天下。","source":{"text":"今当角力中原，以害强弱。","book":"《三国志·吴志·华覈传》"}},{"id":40555,"word":"角巾东第","pinyin":"jiǎo jīn dōng dì","abbr":"jjdd","explanation":"角巾：古代隐士常戴的一种有角的头巾；东第：即家乡。穿着普通的衣服，回到家乡。比喻隐居不仕。","source":{"text":"既完边事，当角巾东路，归故里，为容棺之墟。","book":"《晋书·羊祜传》"}},{"id":40556,"word":"角巾东路","pinyin":"jiǎo jīn dōng lù","abbr":"jjdl","explanation":"意指辞官退隐，登东归之路。后用以为归隐的典故。","source":{"text":"尝与从弟琇书曰：‘既定边事，当角巾东路，归故里，为容棺之墟。’","book":"《晋书·羊祜传》"},"example":{"text":"待～，蹇驴北阜，伴公游钓。","book":"宋·刘克庄《水龙吟·辛亥安晚生朝》词"},"similar":["角巾私第"],"usage":"作谓语、宾语；指归隐"},{"id":40557,"word":"角巾私第","pinyin":"jiǎo jīn sī dì","abbr":"jjsd","explanation":"角巾：古时隐士常戴的一种有棱角的头巾；私第：私人住宅。脱掉官服，戴上头巾，居住在私宅。指闲居不仕。","source":{"text":"卿旋旆之日，角巾私第，口不言平吴之事。","book":"《晋书·王濬传》"},"example":{"text":"老先生功在社稷，今日～，口不言功，真古名将风度。","book":"清·吴敬梓《儒林外史》第46回"},"similar":["功成身退"],"opposite":["东山再起"],"usage":"作宾语、定语；指功成隐退"},{"id":40558,"word":"角巾素服","pinyin":"jiǎo jīn sù fú","abbr":"jjsf","explanation":"角巾：古代隐士的有棱形的头巾。泛指便服。","example":{"text":"我羡慕那些～的隐士。"},"usage":"作宾语、定语；用于书面语"},{"id":40559,"word":"角户分门","pinyin":"jiǎo hù fēn mén","abbr":"jhfm","explanation":"指分立门户，比喻结党营私。","source":{"text":"四海渐成土崩瓦解之形，诸臣但有角户分门之念。","book":"《明史·华允诚传》"},"usage":"作谓语、定语；比喻结党营私"},{"id":40560,"word":"角立杰出","pinyin":"jiǎo lì jié chū","abbr":"jljc","explanation":"指卓然特立，超过一般。","source":{"text":"至于穉者，爰自江南卑薄之域，面角立杰出。","book":"《后汉书·徐穉传》"}},{"id":40561,"word":"觞酒豆肉","pinyin":"shāng jiǔ dòu ròu","abbr":"sjdr","explanation":"觞，古代盛酒器；豆，古代盛食器。泛指饮食。","source":{"text":"觞酒豆肉，让而受恶，民犹犯次。","book":"《礼记·坊记》"},"example":{"text":"始则膏泽不御，～不尝。","book":"清·汪琬《孝贞女墓志铭》"},"usage":"作主语、宾语、定语；指饮食"},{"id":40562,"word":"解人难得","pinyin":"jiě rén nán dé","abbr":"jrnd","explanation":"解人：原指通达言语或文辞意趣的人，借指知己；难得：不易得到。比喻知己难得。","source":{"text":"谢安年少时，请阮光禄道《白马论》，为论以示谢，于时，谢不即解阮语，重相咨尽。阮乃叹曰：‘非但能言人不可得，正索解人亦不得。’","book":"南朝·宋·刘义庆《世说新语·文学》"},"similar":["知音难觅"],"usage":"作宾语、定语；用于感叹"},{"id":40563,"word":"解人颐","pinyin":"jiě rén yí","abbr":"jry","explanation":"解：脱掉。笑掉人的下巴颏儿。形容人开怀大笑。","source":{"text":"无说《诗》，匡鼎来，匡说诗，解人颐。","book":"《汉书·匡衡传》"},"example":{"text":"红炉火热香围坐，梅蕊迎春破。一声清唱～，人道牢愁千斛，我谁知。","book":"宋·葛胜仲《虞美人·自兰陵归，冬夜饮严州酒作》"}},{"id":40564,"word":"解兵释甲","pinyin":"jiě bīng shì jiǎ","abbr":"jbsj","explanation":"解：解除；释：卸下。解除武装，卸掉盔甲。比喻不再参战。","source":{"text":"解兵释甲，社稷宁谧，黎民乐业。","book":"明·无名氏《伐晋兴齐》第四折"},"example":{"text":"庆氏有马，惊而逸走，军士逐而得之，乃尽絷其马，～，共往观之。","book":"明·冯梦龙《东周列国志》第六十七回"},"similar":["马放南山","解甲释兵"],"opposite":["穷兵黩武"],"usage":"作谓语、宾语；指停战"},{"id":40565,"word":"解剑拜仇","pinyin":"jiě jiàn bài chóu","abbr":"jjbc","explanation":"指息争释怨。","source":{"text":"汉许荆兄子世尝杀人，仇者将杀世，荆乃跪拜仇者曰：“兄早没，只一子，原杀身代之。”仇者曰：“许掾郡中称贤，何敢相侵！”因解剑去。事见《汉书·许荆传》。"},"example":{"text":"公不谋声训，而楚夏移情，故能使～，归田息讼。","book":"南朝·梁·任昉《〈王文宪集〉序》"},"usage":"作宾语、定语；用于处事","story":["汉朝时期，许荆的侄子许世曾经杀人，仇家要杀许世，许荆向仇家跪拜求情说：“兄早没，只一子，愿杀身代之。”仇家说：“你是郡中的大贤人，我们怎么敢杀你呢？”于是丢下剑就离去"]},{"id":40566,"word":"解发佯狂","pinyin":"jiě fà yáng kuáng","abbr":"jfyk","explanation":"解发：把头发散开；佯：假装。散开头发假装癫狂。","source":{"text":"比干谏而死。箕子曰：‘知不用而言，愚也；杀身以彰君之恶，不忠也。二者不可然且为之，不祥莫大焉！’遂解发佯狂而去。","book":"汉·韩婴《韩诗外传》第六卷"},"similar":["装疯卖傻"],"usage":"作谓语、宾语；指假装癫狂"},{"id":40567,"word":"解囊相助","pinyin":"jiě náng xiāng zhù","abbr":"jnxz","explanation":"囊：口袋。拿出财物帮助别人。","source":{"text":"若有贤士大夫解囊乐助，自为王所式凭。","book":"元·无名氏《来生债》：“但见个贫的呵，我早则倾囊儿资助。”明·张岱《娘嬛文集·募修岳鄂王祠募疏》"},"example":{"text":"每当同学有困难时，老师总是～。"},"similar":["解衣缩食"],"opposite":["一毛不拔"],"usage":"作谓语、定语、宾语；指帮助别人"},{"id":40568,"word":"解巾从仕","pinyin":"jiě jīn cóng shì","abbr":"jjcs","explanation":"巾：古代隐士常戴的一种头巾；仕：做官。结束隐居生活，出去做官。","source":{"text":"臣兄自解巾从仕，三十余年。","book":"唐·陈子昂《为王美畅谢兄官表》"}},{"id":40569,"word":"解弦更张","pinyin":"jiě xián gēng zhāng","abbr":"jxgz","explanation":"更：改换；张：给乐器上弦。改换、调整乐器上的弦，使声音和谐。比喻改革制度或变更计划、方法。","source":{"text":"窃譬之琴瑟不调，甚者必解而更张之，乃可鼓也。","book":"《汉书·董仲舒传》"},"usage":"作谓语；指改革","story":["西汉初年，著名学者董仲舒受到汉武帝的器重，为了著书立说就辞官回家。汉武帝经常在国家大事难以决断时就派人去听取他的意见。有一次董仲舒说：“当更张而不更张，虽有良工不能善调整也”建议汉武帝实行政治改革"]},{"id":40570,"word":"解惑释疑","pinyin":"jiě huò shì yí","abbr":"jhsy","explanation":"解：解释；释：消除。解答疑难问题，消除困惑情绪。","source":{"text":"使衡立朝，必有可观。飞辩骋辞，溢气坌涌，解疑释结，临敌有余。","book":"汉·孔融《荐祢衡表》"},"example":{"text":"公在朝廷，群公百司，～，公为蓍龟。","book":"宋·曾巩《祭宋龙图文》"}},{"id":40571,"word":"解手背面","pinyin":"jiě shǒu bèi miàn","abbr":"jsbm","explanation":"解手：分手，分离；背面：各奔东西。形容别离。","source":{"text":"解手背面，遂十一年，君出我入，如相避然。","book":"唐·韩愈《祭河南张员外文》"}},{"id":40572,"word":"解放思想","pinyin":"jiě fàng sī xiǎng","abbr":"jfsx","explanation":"冲破传统的束缚，把思想从旧的条条框框中解脱出来。"},{"id":40573,"word":"解构之言","pinyin":"jiě gòu zhī yán","abbr":"jgzy","explanation":"解构：附会，捏造。指牵强附会或胡乱捏造的话。","source":{"text":"自今以后，手书相闻，勿用傍人解构之言。","book":"《后汉书·隗嚣传》"}},{"id":40574,"word":"解民倒悬","pinyin":"jiě mín dào xuán","abbr":"jmdx","explanation":"解：解救；倒悬：人被倒挂，比喻处境困难、危急。比喻把受苦难的人民解救出来。","source":{"text":"当今之时，万乘之国行仁政，民之悦之，犹解倒悬也。","book":"《孟子·公孙丑上》"},"example":{"text":"近一两年来，他常常在心中琢磨着要得天下必须如何～收买人心。","book":"姚雪垠《李自成》第一卷第六章"},"usage":"作谓语；比喻把受苦难的人民解救出来"},{"id":40575,"word":"解狐荐仇","pinyin":"xiè hú jiàn chóu","abbr":"jhjc","explanation":"解狐推荐仇人为相。比喻公正无私。","source":{"text":"解狐荐其仇于简主以为相，其仇以为且幸释己民，乃因往拜谢，狐乃引弓送而射之，曰：‘夫荐汝公也，以汝能当之也……故私怨不入公门。’","book":"《韩非子·外储说左下》"}},{"id":40576,"word":"解甲休兵","pinyin":"jiě jiǎ xiū bīng","abbr":"jjxb","explanation":"卸下盔甲让士兵休息。比喻不再战斗。","source":{"text":"虽昔萧相辅佐之功，功冠群后，弗以加之，遂解甲休士，阵而不战。","book":"汉·张昶《西岳华山堂阙碑铭》"},"example":{"text":"黔中方定，旋军反旆，～。","book":"北周·庾信《周柱国楚国公岐州刺史慕容公神道碑》"},"similar":["解甲休士"],"usage":"作谓语、宾语；用于书面语"},{"id":40577,"word":"解甲休士","pinyin":"jiě jiǎ xiū shì","abbr":"jjxs","explanation":"卸下盔甲让士兵休息。比喻不再战斗。","source":{"text":"虽昔萧相辅佐之功，功冠群后，弗以加之，遂解甲休士，阵而不战。","book":"汉·张昶《西岳华山堂阙碑铭》"},"similar":["解甲休兵"],"usage":"作谓语、宾语；用于书面语"},{"id":40578,"word":"解甲倒戈","pinyin":"jiě jiǎ dǎo gē","abbr":"jjdg","explanation":"指敌方战士归顺，转向攻击。","source":{"text":"叔孙通起于枹鼓之间，解甲投戈，遂作君臣之仪，得也。","book":"汉·扬雄《解嘲》"},"example":{"text":"若王师一临，旧章暂睹，自应～，冰销叶散。","book":"《隋书·越王杨侗传》"},"similar":["反戈一击"],"usage":"作谓语、定语；用于战争或处事等"},{"id":40579,"word":"解甲归田","pinyin":"jiě jiǎ guī tián","abbr":"jjgt","explanation":"解：脱下；甲：古代将士打仗时穿的战服。脱下军装，回家种地。指战士退伍还乡。","source":{"text":"叔孙通起于桴鼓之间，解甲投戈，遂作君臣之仪，得也。","book":"汉·扬雄《解嘲》"},"example":{"text":"我李自成愿意～，做一个尧舜之民，决不会有非分之想。","book":"姚雪垠《李自成》第一卷第18章"},"similar":["刀枪入库","马放南山"],"opposite":["投笔从戎"],"usage":"作谓语、宾语、定语、分句；指战士退伍还乡"},{"id":40580,"word":"解甲投戈","pinyin":"jiě jiǎ tóu gē","abbr":"jjtg","explanation":"卸下盔甲，放下武器。比喻不再战斗。","source":{"text":"叔孙通起于桴鼓之间，解甲投戈，遂作君臣之仪，得也。","book":"汉·扬雄《解嘲》"},"example":{"text":"群寇困逼，知命穷数尽，～。","book":"晋·陈寿《三国志·魏志·钟会传》"},"similar":["解甲归田"],"usage":"作谓语、定语；比喻不再战斗"},{"id":40581,"word":"解甲释兵","pinyin":"jiě jiǎ shì bīng","abbr":"jjsb","explanation":"解：解除；释：卸下。放下武装，卸掉盔甲。比喻不再战斗。","source":{"text":"庆氏有马，惊而逸走，军士逐而得之，乃尽絷其马，解甲释兵，共往观优。","book":"明·冯梦龙《东周列国志》第67回"},"example":{"text":"非为胡公作说客，乃为故人作忠臣耳，王直已遣子纳款，故人不乘此时～，他日必且为虏。","book":"清·余怀《王翠翘传》"},"similar":["解兵释甲"],"usage":"作谓语、宾语；指停战"},{"id":40582,"word":"解疑释惑","pinyin":"jiě yí shì huò","abbr":"jysh","explanation":"解：解释；释：消除。解答疑难问题，消除困惑情绪。","source":{"text":"使衡立朝，必有可观。飞辩骋辞，溢气坌涌，解疑释结，临敌有余。","book":"汉·孔融《荐祢衡表》"},"example":{"text":"器足以任重而致远，明足以解疑而释惑，强足以胜难而处剧。","book":"宋·晁补之《祁州新修学记》"},"usage":"作宾语、定语；用于书面语"},{"id":40583,"word":"解疑释结","pinyin":"jiě yí shì jié","abbr":"jysj","explanation":"解：解释；释：消除。解答疑难问题，消除困惑情绪。","source":{"text":"使衡立朝，必有可观。飞辩骋辞，溢气坌涌，解疑释结，临敌有余。","book":"汉·孔融《荐祢衡表》"},"example":{"text":"飞辩骋词，溢气坌涌；～，临敌有余。","book":"明·罗贯中《三国演义》第二十三回"}},{"id":40584,"word":"解粘去缚","pinyin":"jiě nián qù fù","abbr":"jzqf","explanation":"解：消除；缚：拘束。解除粘着和拘束。","source":{"text":"而竹林诸子，箕踞啸傲于醉乡，见以为能解粘去缚。","book":"明·袁宗道《真正英雄从战战兢兢来》"},"example":{"text":"大鉴乃言佛性无常，诸法有常，皆以～而已。","book":"清·恽敬《书后》"},"usage":"作谓语、宾语；用于书面语"},{"id":40585,"word":"解纷排难","pinyin":"jiě fēn pái nán","abbr":"jfpn","explanation":"指为人调解纠纷或排除危难。","source":{"text":"御土酋解纷排难不专以恩，洞其阴事。","book":"明·唐顺之《都督沈紫江山墓碑记》"},"similar":["排难解纷"],"opposite":["挑拨是非"],"usage":"作谓语、定语；指为人排除危难"},{"id":40586,"word":"解组归田","pinyin":"jiě zǔ guī tián","abbr":"jzgt","explanation":"解组：去官。指辞官返乡务农。","source":{"text":"只消婆婆亲写一书，说爹爹因富贵已极，欲解组归田，而意不能决，必得舅公一劝，同为五湖之游。","book":"清·夏敬渠《野叟曝言》第一百十八回"},"example":{"text":"否则～，尽可自适，为什么负气自戕，效那匹夫匹妇的短见呢？","book":"蔡东藩、许廑父《民国通俗演义》第一百二十回"},"similar":["解甲归田"],"usage":"作谓语、宾语；用于归隐"},{"id":40587,"word":"解衣包火","pinyin":"jiě yī bāo huǒ","abbr":"jybh","explanation":"比喻不解决问题，只招致危险。","source":{"text":"关中华戎杂错，风俗劲悍；裕欲以荆扬之化，施之函秦，此无异解衣包火，张罗捕虎。","book":"《资治通鉴·晋安帝义熙十三年》"},"similar":["解衣抱火"],"usage":"作宾语、定语；用于处事"},{"id":40588,"word":"解衣卸甲","pinyin":"jiě yī xiè jiǎ","abbr":"jyxj","explanation":"解：脱衣；卸：卸掉。脱下战衣，卸掉灰甲。比喻不再作战。","source":{"text":"他若是解衣卸甲顺天朝，班中封位爵。","book":"明·无名氏《杏林庄》第一折"},"example":{"text":"刀剑出鞘，弓弩上弦，不许～，好生捉铃喝号，转箭支更。","book":"明·无名氏《陈仓路》第四折"},"similar":["解兵释甲"],"usage":"作谓语、宾语；指不再作战"},{"id":40589,"word":"解衣抱火","pinyin":"jiě yī bào huǒ","abbr":"jybh","explanation":"比喻不解决问题，只招致危险。同“解衣包火”。","source":{"text":"《资治通鉴·晋安帝义熙十三年》：“关中华戎杂错，风俗劲悍；裕欲以荆扬之化，施之函秦，此无异解衣包火，张罗捕虎。”清·唐训方《里语征实》卷下引作“解衣抱火”。"},"example":{"text":"清·唐训方《里语徵实》下卷：“此无异～，张罗捕虎。”"},"similar":["解衣包火"],"usage":"作宾语、定语；用于处事"},{"id":40590,"word":"解衣推食","pinyin":"jiě yī tuī shí","abbr":"jyts","explanation":"推：让。把穿着的衣服脱下给别人穿，把正在吃的食物让别人吃。形容对人热情关怀。","source":{"text":"汉王授我上将军印，予我数万众，解衣衣我，推食食我。","book":"《史记·淮阴侯列传》"},"example":{"text":"小生飘蓬浪迹，幸蒙令尊一见如故，～，恩已过甚。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"similar":["助人为乐","慷慨解囊"],"usage":"作谓语、宾语、分句；指爱惜人才","story":["楚汉相争时期，项羽手下的韩信因得不到重用就投靠刘邦。刘邦认为韩信是一个很好的人才，就把他的衣服送给韩信，还给韩信送去精美的食物、兵马。韩信带兵灭掉齐国。项羽派武涉去劝韩信自立为王，被韩信拒绝"]},{"id":40591,"word":"解衣槃磅","pinyin":"jiě yī pán páng","abbr":"jypp","explanation":"指神闲意定，不拘形迹。后亦指行为随便，不受拘束。同“解衣般礴”。"},{"id":40592,"word":"解衣槃礴","pinyin":"jiě yī pán bó","abbr":"jypb","explanation":"形容行为随便，不拘礼法。","source":{"text":"俗俭讼简，宾客罕至，吏散则闭门，解衣槃礴移日，山水之意未尝不落落焉在予胸中也。","book":"清·施润章《就亭记》"},"similar":["解衣般礴"],"usage":"作宾语、定语；用于人的举止"},{"id":40593,"word":"解衣盘磅","pinyin":"jiě yī pán páng","abbr":"jypp","explanation":"指神闲意定，不拘形迹。后亦指行为随便，不受拘束。同“解衣般礴”。"},{"id":40594,"word":"解衣盘礴","pinyin":"jiě yī pán bó","abbr":"jypb","explanation":"指神闲意定，不拘形迹。后亦指行为随便，不受拘束。同“解衣般礴”。"},{"id":40595,"word":"解衣磅礴","pinyin":"jiě yī páng bó","abbr":"jypb","explanation":"指神闲意定，不拘形迹。后亦指行为随便，不受拘束。同“解衣般礴”。"},{"id":40596,"word":"解衣磐礴","pinyin":"jiě yī pán bó","abbr":"jypb","explanation":"解衣：解开衣服；磐礴：坐地时两腿张开。形容衣着随便，举止不拘礼节。","source":{"text":"有一吏后至者，儃儃然不趋，受揖不立，舐笔和墨，因之舍。公使人视之，则解衣般礴，裸。","book":"《庄子·田子方》"},"example":{"text":"酣酒之后～，先以黑墨幛上，因其形似或为山石，或为林泉，自然天成。","book":"元·夏文彦《图绘宝鉴》卷二"}},{"id":40597,"word":"解衣般礴","pinyin":"jiě yī bān bó","abbr":"jybb","explanation":"脱衣箕坐。指神闲意定，不拘形迹。后亦指行为随便，不受拘束。","source":{"text":"有一吏后至者，儃儃然不趋，受揖不立，舐笔和墨，因之舍。公使人视之，则解衣般礴，裸。","book":"《庄子·田子方》"},"similar":["解衣槃礴"],"usage":"作宾语、定语；用于人的举止","story":["战国时期，宋元君准备画图画，众史官都来拜见与在一旁伺候笔墨纸砚，一半在外边候着。有一个史官后才来，悠悠闲闲跟在外边，只作揖而不站立。宋元君派人去看他，见他解开衣服盘坐在地上，上身裸露。宋元君说这样才是真正的画家"]},{"id":40598,"word":"解衣衣人","pinyin":"jiè yī yī rén","abbr":"jyyr","explanation":"脱下衣服给别人穿。","source":{"text":"汉王授我上将军印，予我数万众，解衣衣我，推食食我。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"宏老先生生平为人，乐善好施，～，在这百里湖区德高望重。","book":"严亚楚《龙感湖》"},"similar":["助人为乐","与人为善"],"opposite":["嫁祸于人","落井下石","趁火打劫"],"usage":"作谓语；指脱下衣服给别人穿","story":["楚汉相争时期，项羽手下的韩信因得不到重用就投靠刘邦。刘邦认为韩信是一个很好的人才，就把他的衣服送给韩信，还给韩信送去精美的食物、兵马。韩信带兵灭掉齐国。项羽派武涉去劝韩信自立为王，被韩信拒绝"]},{"id":40599,"word":"解衣衣我，推食食我","pinyin":"jiě yī yì wǒ，tuī shí sì wǒ","abbr":"jyywtssw","explanation":"解：脱下；衣我：给我穿；推：让；食我：给我吃。把穿着的衣服脱下给别人穿，把正在吃的食物让别人吃。形容对人热情关怀。","source":{"text":"汉王授我上将军印，予我数万众，解衣衣我，推食食我。","book":"《史记·淮阴侯列传》"},"example":{"text":"承娘子相爱，～，此恩没身难报。","book":"明·周楫《西湖二集·寄梅花鬼病闹西阁》"}},{"id":40600,"word":"解语花","pinyin":"jiě yǔ huā","abbr":"jyh","explanation":"比喻胜似花朵般美丽的女子。","source":{"text":"明皇秋八月，太液池有千叶白莲数枝盛开，帝与贵戚宴赏焉。左右皆叹羡久之，帝指贵妃示于左右曰：‘争如我解语花？’","book":"五代·王仁裕《开元天宝遗事·解语花》"},"example":{"text":"他是一片生香玉，他是一枝～。","book":"元·乔孟符《金钱记》第一折"}},{"id":40601,"word":"解铃系铃","pinyin":"jiě líng jì líng","abbr":"jljl","explanation":"比喻谁惹出来的麻烦，还得由谁去解决。","source":{"text":"金陵清凉泰钦禅师，性豪逸，众易之，法眼独契重。一日眼问众：‘虎项金铃，是谁解得？’众无对，师适至，眼举前语问，对曰：‘系者解得。'","book":"明·瞿汝稷《指月录》卷二十三"},"example":{"text":"我不妨和他见了面，窥察他的神气语意，如果事由他起，则系铃解铃，原须一人。","book":"清·颐琐《黄绣球》第五回"},"similar":["心病还须心药医","解铃还须系铃人"],"usage":"作宾语、定语；比喻谁惹出的麻烦由谁收拾","story":["南唐法眼宗始祖法眼法师在金陵清凉寺给众僧讲佛经，希望他们潜心向佛，遵守清规戒律。法灯和尚却偏偏不爱遵守这些清规戒律，但人很聪明。法眼法师问谁能从凶猛的老虎脖子上取下金铃来，法灯和尚回答道解铃还须系铃人"]},{"id":40602,"word":"解铃还是系铃人","pinyin":"jiě líng hái shì xì líng rén","abbr":"jlhsxlr","explanation":"比喻由谁引起的麻烦，仍由谁去解决。同“解铃还须系铃人”。","source":{"text":"心病终须心药治，解铃还是系铃人。","book":"清·曹雪芹《红楼梦》第90回"},"similar":["解铃还须系铃人","解铃系铃"],"usage":"作宾语、定语；用于处事","story":["南唐时期，法眼宗始祖法眼法师在金陵清凉寺给众僧讲佛经，希望他们潜心向佛，遵守清规戒律。法灯和尚却偏偏不爱遵守这些清规戒律，但人很聪明。法眼法师问谁能从凶猛的老虎脖子上取下金铃来，法灯和尚回答道解铃还须系铃人"]},{"id":40603,"word":"解铃还需系铃人","pinyin":"jiě líng hái xū jì líng rén","abbr":"jlhxjlr","explanation":"比喻谁惹出来的麻烦，还得由谁去解决。","source":{"text":"金陵清凉泰钦禅师，性豪逸，众易之，法眼独契重。一日眼问众：‘虎项金铃，是谁解得？’众无对，师适至，眼举前语问，对曰：‘系者解得。'","book":"明·瞿汝稷《指月录》卷二十三"},"example":{"text":"“～”，所以这回伏园回来，我仍要他将事情弄清楚。","book":"鲁迅《两地书·六十九》"}},{"id":40604,"word":"解铃还须系铃人","pinyin":"jiě líng hái xū xì líng rén","abbr":"jlhxxlr","explanation":"比喻由谁引起的麻烦，仍由谁去解决。","source":{"text":"宋·惠洪《林间集》卷下载：法灯泰钦禅师少解悟，然未为人知，独法眼禅师深奇之。一日法眼问大众曰：“虎项下金铃，何人解得？”众无以对。泰钦适至，法眼举前语问之，泰钦曰：“大众何不道：‘系者解得。’”由是人人刮目相看。"},"example":{"text":"常言道：～。当初是他两个说他进去，如今依先要这两个说他出来。","book":"明·王錂《春芜记·忤奸》"},"similar":["解铃系铃","心病还须心药医"],"usage":"作分句、宾语；比喻谁惹出来的麻烦由谁解决","story":["南唐法眼宗始祖法眼法师在金陵清凉寺给众僧讲佛经，希望他们潜心向佛，遵守清规戒律。法灯和尚却偏偏不爱遵守这些清规戒律，但人很聪明。法眼法师问谁能从凶猛的老虎脖子上取下金铃来，法灯和尚回答道解铃还须系铃人"]},{"id":40605,"word":"解铃须用系铃人","pinyin":"jiě líng xū yòng xì líng rén","abbr":"jlxyxlr","explanation":"比喻由谁引起的麻烦，仍由谁去解决。同“解铃还须系铃人”。","source":{"text":"眼一日问众：‘虎项金铃，是谁解得？’众无对。师适至，眼举前语问，师曰：‘系者解得。’","book":"明·瞿汝稷《指月录》第23卷"},"similar":["解铃还是系铃人","解铃系铃"],"usage":"作宾语、定语；用于处事","story":["南唐时期，法眼宗始祖法眼法师在金陵清凉寺给众僧讲佛经，希望他们潜心向佛，遵守清规戒律。法灯和尚却偏偏不爱遵守这些清规戒律，但人很聪明。法眼法师问谁能从凶猛的老虎脖子上取下金铃来，法灯和尚回答道解铃还须系铃人"]},{"id":40606,"word":"解颜而笑","pinyin":"jiě yán ér xiào","abbr":"jyex","explanation":"解颜：开颜。笑得使面容舒展开来。形容满脸笑容，十分高兴的样子。","source":{"text":"夫子始一解颜而笑。","book":"《列子·黄帝》"}},{"id":40607,"word":"解骖推食","pinyin":"jiě cān tuī shí","abbr":"jcts","explanation":"解骖：解下车旁的马；推食：送上食物。解下车旁的马匹，换取食物送给人。指以财物救人之急。","source":{"text":"维伯时父，吊古啜泣，道逢玉人，解骖推食。","book":"宋·苏轼《洗玉池铭》"},"usage":"作谓语、定语；用于书面语"},{"id":40608,"word":"解黏去缚","pinyin":"jiě nián qù fù","abbr":"jnqf","explanation":"解除粘着和束缚。"},{"id":40609,"word":"觥筹交错","pinyin":"gōng chóu jiāo cuò","abbr":"gcjc","explanation":"觥：古代的一种酒器；筹：行酒令的筹码。酒杯和酒筹杂乱地放着。形容许多人聚会喝酒时的热闹场景。","source":{"text":"射者中，奕者胜，觥筹交错，坐起而喧哗者，众宾欢也。","book":"宋·欧阳修《醉翁亭记》"},"example":{"text":"余大先生抬头看尊经阁上绣衣朱履，～。","book":"清·吴敬梓《儒林外史》第四十七回"},"similar":["杯盘狼藉"],"opposite":["自斟自饮"],"usage":"作谓语、定语；用于描写酒宴","story":["宋朝时期，滁州太守欧阳修自号醉翁，他经常去西南郊琅玡山的酿泉边去玩，那儿有一个亭子，他取名“醉翁亭”，经常与朋友在此饮酒欢聚，有《醉翁亭记》为证：“宴酣之乐，非丝非竹，射者中，奕者胜，觥筹交错，起坐而喧哗者，众宾欢也。”"]},{"id":40610,"word":"觥饭不及壶飧","pinyin":"gōng fàn bù jí hú sūn","abbr":"gfbjhs","explanation":"丰盛的酒肴没有准备好，不如一壶水泡饭可以解除饥饿。比喻事情很急，不能等待。","source":{"text":"觥饭不及壶飧。今岁晚矣，子将奈何？","book":"《国语·越语下》"},"similar":["急不可待"],"usage":"作宾语、定语、分句；指事情很急不能等"},{"id":40611,"word":"触事面墙","pinyin":"chù shì miàn qiáng","abbr":"csmq","explanation":"遇事像面对墙壁而立，一无所知。","source":{"text":"吾常近之才，加以多事昏塞，触事面墙，不知道理安在。","book":"晋·姚兴《重答安成侯嵩》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":40612,"word":"触地号天","pinyin":"chù dì hào tiān","abbr":"cdht","explanation":"呼天抢地。形容悲痛之极。","source":{"text":"既出，遂触地号天，几不可生。","book":"明·张敬修等《文忠公行实》"},"similar":["呼天抢地"],"usage":"作谓语、状语、定语；用于人的状态"},{"id":40613,"word":"触处机来","pinyin":"chù chǔ jī lái","abbr":"ccjl","explanation":"指触及某一事物而生出机悟。","source":{"text":"众人都见他忽笑悲，也不解是何意，只道是他的旧病；岂知宝玉触处机来，竟能把偷看册上的诗句牢牢记住了。","book":"《红楼梦》第一一六回"},"usage":"作谓语、宾语、定语；用于接触新事物"},{"id":40614,"word":"触手可及","pinyin":"chù shǒu kě jí","abbr":"cskj","explanation":"近在手边，一伸手就可以接触到。","example":{"text":"这东西就在你身边，你触手可及就可以拿到。"},"similar":["举手之劳","唾手可及"],"opposite":["来之不易"],"usage":"作宾语、定语；形容很容易"},{"id":40615,"word":"触手生春","pinyin":"chù shǒu shēng chūn","abbr":"cssc","explanation":"一动手就转成了春天，富有生机。形容技术高明神奇。","source":{"text":"清·赵翼《瓯北诗话·李青莲诗》；“然以杜韩与之比较，一则用力而不免痕迹，一则不用力而触手生春：此仙与人之别也。”"},"similar":["妙手回春"],"usage":"作谓语、定语；用于人的技艺等"},{"id":40616,"word":"触斗蛮争","pinyin":"chù dòu mán zhēng","abbr":"cdmz","explanation":"触和蛮，《庄子》寓言中蜗牛角上两个小国。见《庄子·则阳》。后以之比喻为私利而争斗。","source":{"text":"竖子英雄，触斗蛮争蜗角中。","book":"清·尤侗《注云飞·十空曲》"},"example":{"text":"～，由造物主观之，不值一笑。","book":"清·王韬《答强弱论》"},"similar":["蛮触相争"],"usage":"作宾语、定语；用于争权夺利等","story":["传说古代有一只蜗牛的两个触角上有两个小国，左边的叫触氏国，右边的叫蛮氏国。两个国家因为争夺地盘而经常发生战争，有时竟伏尸百万，血流成河，造成民不聊生，怨声载道，蜗牛因此而丧失触觉功能"]},{"id":40617,"word":"触景伤心","pinyin":"chù jǐng shāng xīn","abbr":"cjsx","explanation":"被眼前的景物所触动而引起伤感。","source":{"text":"茅舍萧萧傍竹篱，西风惨淡雨霏霏，其时黄菊花初放，触景伤心最惨凄。","book":"《吴歌甲集·茅舍萧萧傍竹篱》"},"similar":["触景伤怀"],"usage":"作谓语、定语、宾语；指伤感"},{"id":40618,"word":"触景伤怀","pinyin":"chù jǐng shāng huái","abbr":"cjsh","explanation":"被眼前的景物所触动而引起伤感。","source":{"text":"夜来皓魄当空，澄波万里，上下一碧，灿若独自无聊，触景伤怀，遂尔口占一曲。","book":"《初刻拍案惊奇》卷十六"},"example":{"text":"现在旧地重游，怎么能不～！","book":"谷风《加勒比海上的黄昏》"},"similar":["触景伤情","触景伤心"],"usage":"作谓语、定语、宾语；指伤感"},{"id":40619,"word":"触景伤情","pinyin":"chù jǐng shāng qíng","abbr":"cjsq","explanation":"被眼前的景物所触动而引起伤感。伤：悲哀。","source":{"text":"被眼前的景物所触动而引起伤感。伤：悲哀。"},"example":{"text":"他来到这里，～，已经默然用指头抹了几回眼泪。","book":"柳青《创业史》第一部第八章"},"similar":["触景生情","触景伤怀"],"opposite":["无动于衷"],"usage":"作谓语、定语、宾语；指伤感"},{"id":40620,"word":"触景生怀","pinyin":"chù jǐng shēng huái","abbr":"cjsh","explanation":"看到眼前景象因而产生某种感情。同“触景生情”。","source":{"text":"与人为主气中和，触景生怀变态多。","book":"明·杨慎《洞天玄记》第三折"},"similar":["触景生情"],"usage":"作谓语、定语、状语；用于引起回忆的事物"},{"id":40621,"word":"触景生情","pinyin":"chù jǐng shēng qíng","abbr":"cjsq","explanation":"受到眼前景物的触动，引起联想，产生某种感情。","source":{"text":"风，吹灭残灯，不由的见景生情，伤心。","book":"元·无名氏《闺怨》曲"},"example":{"text":"人在～的时候，能联想起很多往事。"},"similar":["触物伤情","见景生情","抚景伤情"],"opposite":["无动于衷"],"usage":"作谓语、定语、状语；用于引起回忆的事物"},{"id":40622,"word":"触机便发","pinyin":"chù jī biàn fā","abbr":"cjbf","explanation":"机：弓弩上的发箭器。原指弓弩上的发箭器，一经触发，箭便射出。后亦指人遇到机会便要发作。","source":{"text":"吾狂鄙之性，假以雄权，触机便发，固宜为身灾也。","book":"《旧唐书·韦思谦传》"},"example":{"text":"在这～的时刻，我们得谨慎从事。"},"similar":["一触即发"],"usage":"作谓语、定语；指一触即发"},{"id":40623,"word":"触机落阱","pinyin":"chù jī luò jǐng","abbr":"cjlj","explanation":"阱：陷井；机：弓弩上的发箭器。触动发箭器就能使野兽落入陷井。比喻遭到厄运。","source":{"text":"叶子盈，我遭逢时乖运梗，你为甚也触机落阱。","book":"明·沈景《义侠记·奇功》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":40624,"word":"触物伤情","pinyin":"chù wù shāng qíng","abbr":"cwsq","explanation":"触：触动，感动。看到某一景物内心感到悲伤。","source":{"text":"哀人易感伤，触物增悲心。","book":"晋·张载《七哀诗二首》"},"example":{"text":"惟有黛玉看见他家乡之物，反自～。","book":"清·曹雪芹《红楼梦》第67回"},"similar":["触景伤情"],"usage":"作谓语、宾语；指见到某物品而伤心"},{"id":40625,"word":"触物兴怀","pinyin":"chù wù xīng huái","abbr":"cwxh","explanation":"受到眼前景物的触动而产生某种情怀。","source":{"text":"触物兴怀言不尽，春来非是爱吟诗。","book":"明·李诩《戒庵老人漫笔·月泉吟社》"},"similar":["触物伤情"],"usage":"作谓语、宾语；用于事物等"},{"id":40626,"word":"触目伤心","pinyin":"chù mù shāng xīn","abbr":"cmsx","explanation":"看到某种情况而内心伤悲。","source":{"text":"赤贫者无力赁屋，男妇老幼皆露处。忽澍雨滂沱，立泥淖中，相向而哭。翁触目伤心，计极穷人不过百十，费无多，思有以援之。","book":"清·宣鼎《夜雨秋灯录·阮封翁》"},"example":{"text":"平日这灯下，便是我们的天堂；今日却成了地狱了，没有一个地方一件事情，不是使我～的。","book":"冰心《集外·庄鸿的姊姊》"},"similar":["触目伤怀"],"usage":"作谓语、定语；用于人或事物等"},{"id":40627,"word":"触目伤怀","pinyin":"chù mù shāng huái","abbr":"cmsh","explanation":"看到眼前景物而引起内心的悲伤和回忆。","source":{"text":"朕少离苦辛，情地弥切，虽宅相克成，辂车靡赠，兴言永往，触目恸心。","book":"南朝·梁武帝《追赠张弘籍诏》"},"example":{"text":"他～，自然情不能自已。","book":"朱自清《背影》"},"similar":["触目伤心"],"usage":"作谓语、定语；用于人或事物等"},{"id":40628,"word":"触目儆心","pinyin":"chù mù jǐng xīn","abbr":"cmjx","explanation":"看到某种情况而引为儆戒。","source":{"text":"并将各犯首级在于上下游干革命枭示，俾各触目儆心。","book":"清·林则徐《拿获行动盗犯袁溃等审明定拟折》"},"similar":["触目警心"],"usage":"作谓语、定语；用于人或事物等"},{"id":40629,"word":"触目兴叹","pinyin":"chù mù xīng tàn","abbr":"cmxt","explanation":"看到某种情况而引起感叹。","source":{"text":"一旦见景生情，触目兴叹。","book":"明·李贽《焚书·杂述·杂说》"},"usage":"作谓语、定语；用于人或事物等"},{"id":40630,"word":"触目如故","pinyin":"chù mù rú gù","abbr":"cmrg","explanation":"触目：目光所及。故：旧的，过去的，本来的。满眼看到的都是过去的老样子。","source":{"text":"未周岁，公主忽告殂，国主不胜其哀，怒曰：‘吾不欲复见刘生，其官物一不与，遣归洪州。’生恍疑梦觉，触目如故。","book":"宋·李昌令《乐善录·洪州刘生》"},"example":{"text":"他回到久别的故乡，～，倍感亲切。"},"opposite":["焕然一新"],"usage":"作谓语；指没有改变"},{"id":40631,"word":"触目崩心","pinyin":"chù mù bēng xīn","abbr":"cmbx","explanation":"看到某种情况而心中极度悲伤。","source":{"text":"缅寻遗烈，触目崩心。","book":"《南齐书·豫章文献王嶷传》"},"example":{"text":"且年光遒尽，～。扶力含毫，诸不申具。","book":"南朝·陈·徐陵《答李颙之书》"},"usage":"作谓语、定语；用于人"},{"id":40632,"word":"触目恸心","pinyin":"chù mù tòng xīn","abbr":"cmtx","explanation":"恸：极悲哀；大哭。看到眼前景物而引起内心悲伤。","source":{"text":"朕少离苦辛，情地弥切，虽宅相克成，辂车靡赠，兴言永往，触目恸心。","book":"南朝·梁武帝《追赠张弘籍诏》"},"example":{"text":"这件事让我～。"},"similar":["触目伤心"],"usage":"作谓语、补语、定语；指伤心"},{"id":40633,"word":"触目悲感","pinyin":"chù mù bēi gǎn","abbr":"cmbg","explanation":"触目：目光所及。指所看到的一切都令人悲痛伤感。","source":{"text":"来达襄阳，触目悲感，略无欢情。","book":"《晋书·习凿齿传》"}},{"id":40634,"word":"触目惊心","pinyin":"chù mù jīng xīn","abbr":"cmjx","explanation":"看见某种严重情况，心里感到震惊。","source":{"text":"及其为诗，刿目怵心。","book":"唐·韩愈《昌黎集·贞曜先生墓志铭》"},"example":{"text":"又因他姓赤，惟恐厕内倘有赤痢血痔之类，也好教他～，时常打扫：因此把他派了。","book":"清·李汝珍《镜花缘》第九十九回"},"similar":["胆战心惊","惊心动魄"],"opposite":["司空见惯","习以为常"],"usage":"作谓语、定语；形容事态严重"},{"id":40635,"word":"触目成诵","pinyin":"chù mù chéng sòng","abbr":"cmcs","explanation":"成诵：能背诵。看上一眼就能背下来。形容记忆力强。","source":{"text":"论其博综子史，谙究儒墨，经耳无遗，触目成诵。","book":"唐·姚思廉《陈书·陆瑜传》"},"similar":["过目成诵"],"usage":"作谓语、定语；形容记忆力超众"},{"id":40636,"word":"触目皆是","pinyin":"chù mù jiē shì","abbr":"cmjs","explanation":"触目：接触到视线。眼睛所看到的地方，到处都是。","source":{"text":"故魏太祖曰：‘若使无孤，天下几人称帝，几人称王！’明窃号议者触目皆是。","book":"唐·朱敬则《五等论》"},"example":{"text":"北京真是人海，情形可大不相同了，单是羊肉铺就～。","book":"鲁迅《华盖集续编·一点比喻》"},"similar":["俯拾即是","比比皆是","堆积如山"],"opposite":["寥寥无几","寥若晨星","屈指可数"],"usage":"作谓语、定语；形容很多"},{"id":40637,"word":"触目神伤","pinyin":"chù mù shén shāng","abbr":"cmss","explanation":"触目：目光所及；神：神思；伤：悲哀。所见之处，令人哀伤。"},{"id":40638,"word":"触目经心","pinyin":"chù mù jīng xīn","abbr":"cmjx","explanation":"见到而萦烦于心。","source":{"text":"风光物色元非恶，触目经心偏苦情。","book":"明·何大复《感春》诗"},"usage":"作谓语、宾语；用于人或事物"},{"id":40639,"word":"触目警心","pinyin":"chù mù jǐng xīn","abbr":"cmjx","explanation":"看到某种情况，心中引起警觉。","source":{"text":"如为子而必诚于孝，触目警心，自有许多痛痒相关处。","book":"清·王夫之《读四书大全说·大学·传第六章一》"},"example":{"text":"贵友既著有《醒迷文》，俟寄到时明岁开设学堂，可钞贴各乡镇讲堂，以便教习随时讲解，俾学生～。","book":"《扫为帚》第二四回"},"similar":["触目儆心"],"usage":"作谓语、定语；用于人或事物等"},{"id":40640,"word":"触目骇心","pinyin":"chù mù hài xīn","abbr":"cmhx","explanation":"看见某种严重情况而内心震惊。形容事态严重，引起震动。同“触目惊心”。","source":{"text":"触目骇心，动成篇什，素所蓄积，于此焉发之，秘见者与人同，秘得者固与人异也。","book":"清·黄宗羲《陈葵献偶刻诗文序》"},"similar":["触目惊心"],"usage":"作谓语、定语；形容事态严重"},{"id":40641,"word":"触石决木","pinyin":"chù shí jué mù","abbr":"csjm","explanation":"比喻莽撞蛮干。","source":{"text":"以弱治刚，故非所任也。","book":"汉·扬雄《太玄·难》：“次八，触石决木，维折角。测曰：触石决木，非所治也。”范望注"},"usage":"作谓语、宾语；用于处事"},{"id":40642,"word":"触禁犯忌","pinyin":"chù jìn fàn jì","abbr":"cjfj","explanation":"禁：禁令；忌：忌讳。触犯了禁令和忌讳。","source":{"text":"夫立功德者，不得触禁犯忌，当与身神相和。","book":"宋·张君房《云笈七签》卷四十"},"usage":"作谓语、宾语、定语；用于处事"},{"id":40643,"word":"触类旁通","pinyin":"chù lèi páng tōng","abbr":"clpt","explanation":"触类：接触某一方面的事物；旁通：相互贯通。掌握了某一事物的知识或规律，进而推知同类事物的知识或规律。","source":{"text":"引而伸之，触类而长之，天下之能事毕矣。","book":"《周易·系辞上》"},"example":{"text":"我真高兴，得着两个新鲜的意思，让我对于生活的方法，能～的思索一回。","book":"朱自清《“海阔天空”与“古今中外”》"},"similar":["融会贯通","举一反三"],"opposite":["一窍不通"],"usage":"作谓语、定语；用于学习方面"},{"id":40644,"word":"触类而通","pinyin":"chù lèi ér tōng","abbr":"clet","explanation":"指掌握了某一事物的知识或规律，进而推知同类事物的知识或规律。","source":{"text":"人之念虑一正，则万善可触类而通；行一善，则万善皆萌蘖于此。","book":"《说郛》卷七七引宋·李之彦《东谷所见·寿福德》"},"example":{"text":"而夫子作大象，多于卦爻之辞之外，别起一义以示学者，使之～，此即举隅之说也。","book":"清·顾炎武《与友人论书》之一"},"similar":["触类旁通"],"usage":"作谓语、定语；用于学习方面"},{"id":40645,"word":"触类而长","pinyin":"chù lèi ér cháng","abbr":"clec","explanation":"意指掌握一类事物知识或规律，就能据此而增长同类事物知识。","source":{"text":"谓触逢事类而增长之。","book":"语出《易·系辞上》：“引而伸之，触类而长之，天下之能事毕矣。”孔颖达疏"},"example":{"text":"其余～，所致非一，同归殊途，或文或质。","book":"三国·魏·嵇康《琴赋》"},"usage":"作谓语、宾语；用于书面语"},{"id":40646,"word":"触而即发","pinyin":"chù ér jí fā","abbr":"cejf","explanation":"触：碰；即：就。原指把箭扣在弦上，拉开弓等着射出去。比喻事态发展到了十分紧张的阶段，稍一触动就立即会爆发。","source":{"text":"积数千年民族之精髓，递相遗传，递相扩充，其机固有磅礴郁积，一触即发之势。","book":"清·梁启超《论中国学术思想变迁之大势》三"}},{"id":40647,"word":"觳觫伏罪","pinyin":"hú sù fú zuì","abbr":"hsfz","explanation":"觳觫：恐惧得发抖的样子。指惶恐认罪。","source":{"text":"吾不忍其觳觫若无罪而就死地。","book":"战国·邹·孟轲《孟子·梁惠王上》"},"example":{"text":"公子宋随班行礼，全无～之语。","book":"明·冯梦龙《东周列国志》第52回"},"usage":"作谓语、定语；指认罪"},{"id":40648,"word":"言三语四","pinyin":"yán sān yǔ sì","abbr":"ysys","explanation":"言、语：说、讲。形容人多嘴杂，议论纷纷。","source":{"text":"小生欲待要不去，悬心挂意，怎生撇得？欲待要去呵，又惹的人言三语四，使人惶恐，好两难也呵！","book":"元·武汉臣《玉壶春》第三折"},"example":{"text":"除了平儿，众丫头媳妇无不～，指桑说槐，暗相讥刺。","book":"清·曹雪芹《红楼梦》第六十九回"},"similar":["说三道四"],"usage":"作谓语、定语；指说三道四"},{"id":40649,"word":"言不二价","pinyin":"yán bù èr jià","abbr":"ybej","explanation":"货物的价钱说一不二。同“言无二价”。","source":{"text":"货在商人店里，贵得如同宝贝，真是言不二价的。","book":"艾芜《人生哲学的一课》"},"similar":["言无二价"],"usage":"作宾语、定语、状语；用于处事等"},{"id":40650,"word":"言不入耳","pinyin":"yán bù rù ěr","abbr":"ybre","explanation":"指说的话不中听。","source":{"text":"却说铁公子怪水运言不入耳，遂出门带了小丹，一径走到长寿院，自立在寺前，却叫小丹进去，问和尚要行李。","book":"清·名教中人《好逑传》第八回"},"example":{"text":"反正话不投机或～，不妨抽身退场，甚至砰一下推上大门。","book":"杨绛《读书苦乐》"}},{"id":40651,"word":"言不及义","pinyin":"yán bù jí yì","abbr":"ybjy","explanation":"及：涉及；义：正经的道理。指净说些无聊的话，没有一句正经的。","source":{"text":"群居终日，言不及义，好行小慧，难矣哉！","book":"《论语·魏灵公》"},"example":{"text":"真所谓“～”，那里有好事情串出来。","book":"清·吴趼人《二十年目睹之怪现状》第一百四回"},"similar":["胡言乱语","鬼话连篇","信口开河"],"opposite":["一语破的","一针见血","言之有理"],"usage":"作谓语、宾语、定语；指胡言乱语"},{"id":40652,"word":"言不及私","pinyin":"yán bù jí sī","abbr":"ybjs","explanation":"言谈之中不涉及个人私事。比喻为官忠心，一心为国。","source":{"text":"王湛言不及私。","book":"唐·房玄龄《晋书·王湛传》"},"example":{"text":"他始终保持～、一心为公的优良作风。"},"similar":["一心为公"],"opposite":["自私自利"],"usage":"作谓语、定语；指人一心为公","story":["公元371年，大臣王坦之极力劝谏简文帝不要让位给大司马桓温。简文帝死后，桓温辅佐幼主登基，桓温去世后，由王坦之与谢安共辅幼主。王坦之多次上书谏幼主要“尊尊亲亲，信纳大臣。”他自己言不及私，只是忧国忧民"]},{"id":40653,"word":"言不及行","pinyin":"yán bù jí xíng","abbr":"ybjx","explanation":"指言行不一。","source":{"text":"言不及行，可耻之甚，非特发于口谓之言，凡著于文词者皆是也。","book":"明·薛瑄《薛子道论》"},"similar":["言不顾行"],"usage":"作谓语、宾语、定语；用于处事"},{"id":40654,"word":"言不尽意","pinyin":"yán bù jìn yì","abbr":"ybjy","explanation":"情意曲折深远，言语难以全部表达。常用于书信末尾，表示说的话没能把意思都表达出来。","source":{"text":"书不尽言，言不尽意。","book":"《易·系辞上》"},"example":{"text":"病中作词一阙，调寄《菩萨蛮》，奉上文郎云杰翰座，谨望挽回春色。词不尽言，～。","book":"元·贾仲名《萧淑兰》第三折"},"similar":["言外之意","词不尽意","意味深长"],"opposite":["言之无物","言讷词直","空洞无物"],"usage":"作谓语、宾语；用于书信末尾"},{"id":40655,"word":"言不愿行","pinyin":"yán bù yuàn xíng","abbr":"ybyx","explanation":"言语和行为不相符合。","example":{"text":"我不同～的人往来。"},"similar":["言行不一"],"opposite":["言行一致"],"usage":"作宾语、定语；用于处事等"},{"id":40656,"word":"言不由中","pinyin":"yán bù yóu zhōng","abbr":"ybyz","explanation":"指心口不一致。同“言不由衷”。","source":{"text":"实相告：此言不由中，转瞬即去，便受夏楚，不能复忆之也。","book":"清·蒲松龄《聊斋志异·贾奉雉》"},"similar":["言不由衷"],"usage":"作谓语、定语、状语；指心口不一致"},{"id":40657,"word":"言不由衷","pinyin":"yán bù yóu zhōng","abbr":"ybyz","explanation":"由：从；衷：内心。话不是打心眼里说出来的，即说的不是真心话。指心口不一致。","source":{"text":"人言为信，中同衷。","book":"《左传·隐公三年》： “信不由中，质无益也。”杨伯峻注"},"example":{"text":"旋复下一通令，洋洋洒洒，约一二千言，小子因他～，不愿详录。","book":"蔡东藩、许廑父《民国通俗演义》第二十八回"},"similar":["言行不一","口是心非","口蜜腹剑"],"opposite":["由衷之言","言之有信","出自肺腑"],"usage":"作谓语、定语、状语；指心口不一致","story":["春秋时期，诸侯郑国的实力强大，郑庄公任周朝的卿士，执掌朝廷大权。周平王想让虢公忌来取代郑庄公管理朝政，郑庄公就去威胁周平王，周平王只好违心说没这回事，双方交换儿子做人质。周桓王时也是如此，后来郑国强行侵吞朝廷公粮"]},{"id":40658,"word":"言不诡随","pinyin":"yán bù guǐ suí","abbr":"ybgs","explanation":"说话不谲诈善变。","source":{"text":"文然简略，言不诡随。","book":"晋·常璩《华阳国志》卷十中"},"example":{"text":"清明虚受，磊落标奇，～，行不苟合，游必英俊，门无尘杂。","book":"唐·张说《齐黄门侍郎卢公神道碑》"},"usage":"作谓语、定语；用于说话等"},{"id":40659,"word":"言不谙典","pinyin":"yán bù ān diǎn","abbr":"ybad","explanation":"谙：熟悉。诗话用词不熟悉经典。","source":{"text":"则见他一时半刻使尽了千方百计，吃紧的理不服人，言不谙典，话不投机；看不的乔所为，歹见识，刁天决地。","book":"元·王子一《误入桃源》第三折"},"usage":"作谓语、定语；用于书面语"},{"id":40660,"word":"言不践行","pinyin":"yán bù jiàn xíng","abbr":"ybjx","explanation":"践行：履行，实行。说了不能实行。","source":{"text":"此刻害我做了个言不践行的人，我气的就是这一点。","book":"清·吴趼人《二十年目睹之怪现状》第二十回"},"opposite":["一诺千金"],"usage":"作谓语、定语；用于处事"},{"id":40661,"word":"言不达意","pinyin":"yán bù dá yì","abbr":"ybdy","explanation":"说的话不能准确地表达思想内容。亦作“言不逮意”。","source":{"text":"以译者言不达意，复为书晓之。","book":"《明史·广西土司传二·思明》"},"similar":["言不逮意"],"usage":"作谓语、定语；用于说话或作文等"},{"id":40662,"word":"言不逮意","pinyin":"yán bù dǎi yì","abbr":"ybdy","explanation":"说的话不能准确地表达思想内容。同“言不达意”。","source":{"text":"群居终日，言不及义，好行小慧，难矣哉！","book":"《论语·魏灵公》"},"example":{"text":"陛下不取此，其不可十也，臣～。","book":"宋·孙在、奭《谏幸汾阴"},"similar":["言不达意"],"usage":"作谓语、定语；用于说话或作文等"},{"id":40663,"word":"言不逾阈","pinyin":"yán bù yú yù","abbr":"ybyy","explanation":"言：说的话；逾：越过；阈：门坎。夫妻间说的话，不能越过大门。比喻说体己话不能让外人知道。","source":{"text":"床第之言不逾阈，况在野乎？","book":"《左传·襄公二十七年》"}},{"id":40664,"word":"言不顾行","pinyin":"yán bù gù xíng","abbr":"ybgx","explanation":"说话与行事不相符合。","source":{"text":"言不顾行，行不顾言。","book":"《孟子·尽心下》"},"example":{"text":"但无论怎样，由这儿又可以看出，申子这个人是怎样的～。","book":"郭沫若《十批判书·前期法家的批判》"},"similar":["言不顾行，行不顾言"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":40665,"word":"言不顾行，行不顾言","pinyin":"yán bù gù xíng，xíng bù gù yán","abbr":"ybgxxbgy","explanation":"说话与行事不能相照应，行动和言语也不相符合。指言行不符。","source":{"text":"何以是嘐嘐也？言不顾行，行不顾言，则曰：古之人，古之人。行何为踽踽凉凉？生斯世也，为斯世也，善斯可矣。","book":"《孟子·尽心下》"},"example":{"text":"夫～，诚足病也。","book":"宋·陆九渊《策问》"},"similar":["言不顾行"],"usage":"作宾语、定语；用于处事"},{"id":40666,"word":"言与心违","pinyin":"yán yǔ xīn wéi","abbr":"yyxw","explanation":"言语与心意相违背。","source":{"text":"臣以见占隐，以往察来，主君何言与心违？","book":"《吴子·图国》"},"example":{"text":"苟非其人，必将有～之病。","book":"清·阎尔梅《〈泊水斋诗〉序》"},"usage":"作谓语、宾语；用于处事"},{"id":40667,"word":"言中事隐","pinyin":"yán zhōng shì yǐn","abbr":"yzsy","explanation":"指言语虽然委曲却中正不偏，论事虽然放纵却隐藏着精深的道理。","source":{"text":"其言曲而中，其事肆而隐。","book":"语出《易·系辞下》"},"example":{"text":"南朝·梁·刘勰《文心雕龙·宗经》：“故夫《易》惟谈天，入神致用；《系》称旨远辞文，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":40668,"word":"言中无物","pinyin":"yán zhōng wú wù","abbr":"yzww","explanation":"无物：不存在东西，空洞。言论空洞而无实际内容。","example":{"text":"这篇文章～，看了让人不知所云。"},"opposite":["言必有物"],"usage":"作谓语、定语；用于说话等"},{"id":40669,"word":"言为心声","pinyin":"yán wéi xīn shēng","abbr":"ywxs","explanation":"言语是思想的反映，从一个人的话里可以知道他的思想感情。","source":{"text":"故言，心声也；书，心画也。声画形，君子小人见矣。","book":"汉·扬雄《法言·问神》"},"example":{"text":"～，从一个人平时的言谈之中，就可以了解他的思想状况。"},"similar":["文如其人"],"usage":"作主语、宾语、分句；用于书面语"},{"id":40670,"word":"言之不尽","pinyin":"yán zhī bù jìn","abbr":"yzbj","explanation":"想表达的意思说也说不完。","source":{"text":"欲说交颐泪两行，言之不尽，他们亲自到门墙。","book":"明·胡文焕《群音类选·玉簪记·陈母投亲》"},"usage":"作谓语、定语；用于书面语"},{"id":40671,"word":"言之不文，行之不远","pinyin":"yán zhī bù wén，xíng zhī bù yuǎn","abbr":"yzbwxzby","explanation":"文章没有文采，就不能流传很远。同“言之无文，行而不远”。","source":{"text":"宋·陆游《严州到任谢王丞相启》：“黼黻圣猷，谓言之不文则行之不远；甄陶士类，每舍其所短而取其所长。“"},"similar":["言之无文，行之不远"],"usage":"作宾语、分句；用于劝诫人"},{"id":40672,"word":"言之不渝","pinyin":"yán zhī bù yú","abbr":"yzby","explanation":"渝：改变，违背。说出的话决不改变。","source":{"text":"任穷达以逝止，亦进仕而退耕；庶斯言之不渝，抱耿介以成名。","book":"晋·陆机《遂志赋》"},"similar":["说一不二"],"usage":"作谓语、定语；用于处事"},{"id":40673,"word":"言之不预","pinyin":"yán zhī bù yù","abbr":"yzby","explanation":"没有预先说明。","source":{"text":"这是我们共产党人的衷心劝告，‘勿谓言之不预也’。","book":"毛泽东《新民主主义论》七"},"example":{"text":"否则同人当以非常手段对付，勿谓～也。","book":"巴金《寒夜》二八"},"usage":"作谓语；指没有把话说在头里"},{"id":40674,"word":"言之凿凿","pinyin":"yán zhī záo záo","abbr":"yzzz","explanation":"凿凿：确实。形容说得非常确实。","source":{"text":"言之凿凿，确可信据。","book":"清·蒲松龄《聊斋志异·段氏》"},"example":{"text":"宋儒据理谈天，自谓穷造化阴阳之本；于日月五星，～，如指诸掌。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录四》"},"similar":["千真万确","无庸置疑","铁证如山"],"opposite":["捕风捉影","空中楼阁","水中捞月"],"usage":"作谓语、分句；形容说话有根有据"},{"id":40675,"word":"言之成理","pinyin":"yán zhī chéng lǐ","abbr":"yzcl","explanation":"之：代词，指所说的话。话说得有一定道理。","source":{"text":"然而其持之有故，其言之成理，足以欺惑愚众。","book":"《荀子·非十二子》"},"example":{"text":"虽然仁人们未必肯用，但我还可以～。","book":"鲁迅《论“费厄泼赖”应该缓行》"},"similar":["理直气壮","顺理成章","合情合理"],"opposite":["强词夺理","岂有此理","莫名其妙"],"usage":"作谓语、定语；指说话合乎道理","story":["战国时期，郑国大夫邓析能言善辩，聚众讲学，倡导法治，帮助老百姓打官司，与传统的礼治唱反调。他的见解与主张都是言之成理，创立新刑书《竹刑》，主张刑法改革，施行法治，遭到郑国当权的贵族们的强烈反对"]},{"id":40676,"word":"言之无文，行之不远","pinyin":"yán zhī wú wén，xíng zhī bù yuǎn","abbr":"yzwwxzby","explanation":"说话没有文采，就传播不远。亦作“言之无文，行而不远”、“言之不文，行之不远”。","source":{"text":"言以足志，文以足言。”不言，谁知其志？言之无文，行而不远。’","book":"《左传·襄公二十五年》：“仲尼曰：‘《志》有之"},"example":{"text":"今人徙知‘～’，而不知言之无物，又何用文为乎？","book":"胡適《文学改良刍议》"},"similar":["言而无文，行之不远"],"usage":"作宾语、分句；用于劝诫人"},{"id":40677,"word":"言之无文，行而不远","pinyin":"yán zhī wú wén，xíng ér bù yuǎn","abbr":"yzwwxeby","explanation":"文章没有文采，就不能流传很远。","source":{"text":"仲尼曰：‘志有之，言以足志，文以足言。不言谁知其志？言而无文，行而不远。’","book":"《左传·襄公二十年》"},"similar":["言之无文，行之不远"],"usage":"作宾语、分句；用于劝诫人"},{"id":40678,"word":"言之无物","pinyin":"yán zhī wú wù","abbr":"yzww","explanation":"物：指内容。指文章或言论空空洞洞，没有实际内容。","source":{"text":"今人诋呵七子，而言之无物，庸鄙粗哑，所谓不及伪者是矣。","book":"清·袁枚《随园诗话》卷八"},"example":{"text":"空话连篇～的演说，是必须停止的。","book":"毛泽东《反对党八股》"},"similar":["不着边际","华而不实","纸上谈兵"],"opposite":["言之有物","言之有理","言必有中"],"usage":"作谓语、定语；指文章或言论"},{"id":40679,"word":"言之无罪，闻之足戒","pinyin":"yán zhī wú zuì，wén zhī zú jiè","abbr":"yzwzwzzj","explanation":"言：说话；闻：听话；足：足以，值得；戒：警惕。指进言的人没有罪过，听的人足以引起警戒","source":{"text":"诗独主志，所为主文谲谏，与言之无罪，闻之足戒者，其词则隐，其旨则微。","book":"清·汪琬《诗说序》"},"similar":["言者无罪，闻者足戒"],"usage":"作宾语、定语、分句；用于批评与自我批评"},{"id":40680,"word":"言之有序","pinyin":"yán zhī yǒu xù","abbr":"yzyx","explanation":"说话和写文章很有条理。","source":{"text":"言有序，悔亡。","book":"《周易·艮》"},"example":{"text":"这篇文章～。"},"similar":["条分缕析"],"opposite":["颠三倒四"],"usage":"作谓语、宾语、定语；指文章或讲话有条理"},{"id":40681,"word":"言之有据","pinyin":"yán zhī yǒu jù","abbr":"yzyj","explanation":"说话和写文章有充分的证据或事实根据。","example":{"text":"写文章必须要～，不要空发议论。"},"similar":["言之有物"],"usage":"作谓语、宾语；指说话和写文章有充分的证据"},{"id":40682,"word":"言之有故","pinyin":"yán zhī yǒu gù","abbr":"yzyg","explanation":"所说的话有根据。同“言之成理”。","source":{"text":"其言之有故，其持之成理，上傅会乎经义，使人主中其腊毒而不自知，君子所深恶也。","book":"清·魏源《默觚下·治篇六》"},"usage":"作谓语、定语；用于书面语"},{"id":40683,"word":"言之有物","pinyin":"yán zhī yǒu wù","abbr":"yzyw","explanation":"物：内容。文章或讲话有具体内容。","source":{"text":"君子以言有物而行有恒。","book":"《周易·家人》"},"example":{"text":"惟首两句笼罩全篇，末句总结大意，不必～。","book":"清·曾朴《孽海花》第二十回"},"similar":["持之有故","言之有理","言简意赅"],"opposite":["言之无物","废话连篇","纸上谈兵"],"usage":"作谓语、宾语、定语；指文章或讲话有内容"},{"id":40684,"word":"言之有理","pinyin":"yán zhī yǒu lǐ","abbr":"yzyl","explanation":"说的话有道理。","source":{"text":"然而其持之有故，其言之成理，足以欺惑愚众。","book":"《荀子·非十二子》"},"example":{"text":"众卿～，再上酒来。","book":"清·洪昇《长生殿·骂贼》"},"similar":["言之成理"],"opposite":["胡说八道","言不及义","无稽之谈"],"usage":"作谓语、定语；指说的话有道理"},{"id":40685,"word":"言之有礼","pinyin":"yán zhī yǒu lǐ","abbr":"yzyl","explanation":"说的话有道理。"},{"id":40686,"word":"言之者无罪，闻之者足以戒","pinyin":"yán zhī zhě wú zuì，wén zhī zhě zú yǐ jiè","abbr":"yzzwzwzzzyj","explanation":"言者：说话的人；闻者：听话的人；足：足以，值得；戒：警惕。指进言的人没有罪过，听的人足以引起警戒","source":{"text":"言之者无罪，闻之者足以戒。","book":"《诗经·大序》"},"example":{"text":"《文选·卜商》：“上以风化下，下以风刺上，主文而谲谏，～。”"},"similar":["言者无罪，闻者足戒"],"usage":"作宾语、分句；用于批评与自我批评"},{"id":40687,"word":"言之谆谆，听之藐藐","pinyin":"yán zhī zhūn zhūn，tīng zhī miǎo miǎo","abbr":"yzzztzmm","explanation":"说的人很诚恳，听的人却不放在心上。","source":{"text":"诲而谆谆，听我藐藐。","book":"《诗经·大雅·抑》"},"example":{"text":"～。良药苦口，信有之矣。","book":"明·无名氏《三化邯郸》第二折"},"similar":["言者谆谆，听者藐藐"],"usage":"作宾语、分句；用于书面语"},{"id":40688,"word":"言之过甚","pinyin":"yán zhī guò shèn","abbr":"yzgs","explanation":"话说得太过头了。","source":{"text":"自然外边人是言之过甚。但是，空穴来风，仲翁，你也是太登多了。以后总得注意。","book":"茅盾《追求》四"},"example":{"text":"钱钟书《围城》：“我看你愈就愈野蛮无礼了。就算她～，也是她做长辈的一片好意。”"},"usage":"作谓语、定语；用于处事"},{"id":40689,"word":"言事若神","pinyin":"yán shì ruò shén","abbr":"ysrs","explanation":"预测事情象神仙一样灵验。","source":{"text":"而日晓占候布卦，言事若神。","book":"唐·皇甫氏《原化记·郗鉴》"},"similar":["料事如神"],"usage":"作谓语、定语；用于处事"},{"id":40690,"word":"言人人同","pinyin":"yán rén rén tóng","abbr":"yrrt","explanation":"指对某件事情人们的说法一样。","source":{"text":"向在京湖，来归人吴旺等备言文焕父子降状，先纳莞钥，旋献襄城，且陈策攻郢州，请自为先锋。言人人同，制司案辞可征，非敢加诬人罪。","book":"《宋史·度宗纪》"},"example":{"text":"阿其乃亲驰乐邦牛场诇视，～，遂弛备。","book":"《明史·贵州土司传》"}},{"id":40691,"word":"言人人殊","pinyin":"yán rén rén shū","abbr":"yrrs","explanation":"殊：不同。说的话个个不同。指各人有各人的意见。","source":{"text":"尽召长老诸生，问所以安集百姓，如齐故诸儒以百数，言人人殊。参未知所定。","book":"《史记·曹相国世家》"},"example":{"text":"然此辈执术疏，谋生急，信口欺诈，～，甚至徒毁其师，子讥其父，各持己见，彼此相非。","book":"清·黄钧宰《金壶七墨·堪舆》"},"similar":["各执一词","各抒己见"],"opposite":["众口一词"],"usage":"作宾语、定语；指各人有各人的意见"},{"id":40692,"word":"言人所不言","pinyin":"yán rén suǒ bù yán","abbr":"yrsby","explanation":"言：说。敢于说别人不敢和不便说的话，即直言不讳。","source":{"text":"卿所言皆人所不能言，真忠臣也。","book":"《旧唐书·李绛传》"},"example":{"text":"见人所不见，～。"}},{"id":40693,"word":"言从字顺","pinyin":"yán cóng zì shùn","abbr":"yczs","explanation":"从：通顺。语言文字通顺、流畅。","source":{"text":"盖以其落浮夸之气，得忧患之助。言从字顺，遂透真理耳。","book":"唐·柳宗元《叙说》"}},{"id":40694,"word":"言从计听","pinyin":"yán cóng jì tīng","abbr":"ycjt","explanation":"形容对某人十分信任。同“言听计从”。","source":{"text":"便道我言从计听微有权，这就里机关不易言。","book":"清·洪昇《长生殿·贿权》"},"similar":["言听计从","言从计纳","言从计行"],"usage":"作谓语、定语；用于处事"},{"id":40695,"word":"言从计纳","pinyin":"yán cóng jì nà","abbr":"ycjn","explanation":"讲的话、出的主意，都听从采纳。","source":{"text":"及其所以匡辅本朝，忠言嘉谋，造膝危辞，当事而行，言从计纳。","book":"汉·蔡邕《司空临晋侯杨公碑》"},"similar":["言从计听","言听计从"],"usage":"作谓语、定语；用于处事"},{"id":40696,"word":"言从计行","pinyin":"yán cóng jì xíng","abbr":"ycjx","explanation":"形容对某人十分信任。同“言行计从”。","source":{"text":"武宗知而能任之，言从计行。","book":"《新唐书·李德裕传》"},"example":{"text":"李德裕相武宗，～。","book":"宋·洪迈《容斋五笔·李德裕论命令》"},"similar":["言从计纳"],"usage":"作谓语、定语；用于处事"},{"id":40697,"word":"言以足志","pinyin":"yán yǐ zú zhì","abbr":"yyzz","explanation":"足：完成；志：意愿。言语能够用来表达意愿。指思想可以通过言语反映出来。","source":{"text":"言以足志，文以足言。","book":"《左传·襄公二十五年》"}},{"id":40698,"word":"言传身教","pinyin":"yán chuán shēn jiào","abbr":"ycsj","explanation":"言传：用言语讲解、传授；身教：以行动示范。既用言语来教导，又用行动来示范。指行动起模范作用。","source":{"text":"以身教者从，以言教者论。","book":"南朝·宋·范晔《后汉书·第五伦传》"},"example":{"text":"这般～的情景，社员们看在眼里，喜在心头。","book":"《人民文学》1976年第9期"},"similar":["以身作则","现身说法"],"opposite":["言而无信","言行不一"],"usage":"作主语、谓语；指行动起模范作用"},{"id":40699,"word":"言信行果","pinyin":"yán xìn xíng guǒ","abbr":"yxxg","explanation":"说了就一定守信用，做事一定办到。同“言必信，行必果。”","source":{"text":"正直谨严，言信行果。","book":"梁启超《近世第一大哲康德之学说·发端及其略传》"},"example":{"text":"严复《原强》：“而我中国则～，仅成硁硁小人，君子弗尚也。”"},"similar":["言必信，行必果"],"opposite":["言而无信"],"usage":"作宾语、定语；用于处事","story":["春秋时期，孔子带领弟子们周游列国，在陈国闲居无事，与弟子讨论修身之事。孔子认为做“士”要做到“仁者不忧、知者不惑、勇者不惧”三好，士分三类：“不辱君命，为国效力；孝悌兼备，乡邻模范；言信行果，千金一诺。”"]},{"id":40700,"word":"言信行直","pinyin":"yan xin xing zhi","abbr":"yxxz","explanation":"指言语信实，行为正直。"},{"id":40701,"word":"言出患入","pinyin":"yán chū huàn rù","abbr":"ychr","explanation":"话随便说出口，易招致祸患。","source":{"text":"言出患入，言失身亡，故圣人当言而惧，发言而忧，常如临危履冰，以大居小，以富居贫。","book":"宋·张君房《云笈七签》卷九十"},"similar":["言出祸从"],"usage":"作宾语、定语；用于书面语"},{"id":40702,"word":"言出法随","pinyin":"yán chū fǎ suí","abbr":"ycfs","explanation":"言：这里指法令或命令；法：法律。话一说出口，法律就跟在后面。指法令一经公布就严格执行，如有违犯就依法处理。","source":{"text":"言出法随，各宜懔遵毋违。","book":"清·林则徐《奉旨前往广东查办海口事件传牌稿》"},"example":{"text":"有敢违犯的，不论何人，一律治罪，轻则吊打，重则砍头，我是～，你们要好生传谕将士，不要以身试法。","book":"姚雪垠《李自成》"},"similar":["秉公执法","令行禁止","执法如山"],"opposite":["徇私舞弊","言而无信","贪赃枉法"],"usage":"作谓语、定语；指言出必行"},{"id":40703,"word":"言出祸从","pinyin":"yán chū huò cóng","abbr":"ychc","explanation":"话一出口，祸患随之而来。","source":{"text":"虽忠良怀愤，时或愤发，而言出祸从，旋见拏戮。","book":"《后汉书·宦者传论》"},"similar":["言出祸随"],"usage":"作宾语、定语；用于处事等"},{"id":40704,"word":"言出祸随","pinyin":"yán chū huò suí","abbr":"ychs","explanation":"话一出口，祸患随之而来。同“言出祸从”。","source":{"text":"吾非不欲言，言出则祸随，其谁吾听？","book":"《明史·邹智传》"},"similar":["言出祸从"],"usage":"作宾语、定语；用于处事等"},{"id":40705,"word":"言十妄九","pinyin":"yán shí wàng jiǔ","abbr":"yswj","explanation":"形容说话虚妄不实。","source":{"text":"咱则道舌刺刺言十妄九，村棒棒呼幺喝六。","book":"元·尚仲贤《气英布》第三折"},"usage":"作谓语、定语；用于书面语"},{"id":40706,"word":"言发祸随","pinyin":"yán fā huò suí","abbr":"yfhs","explanation":"话一出口，祸患随之而来。同“言出祸从”。","source":{"text":"其如言发祸随，求之以情既无端，验之以迹又无兆，宜蒙昭恕，理在不疑。","book":"唐·陆贽《谢密旨因论所宣事状》"},"similar":["言出祸随","言出祸从"],"usage":"作宾语、定语；用于处事等"},{"id":40707,"word":"言同勒石","pinyin":"yán tóng lè shí","abbr":"ytls","explanation":"指说的话深刻而珍贵，如同刻石。","example":{"text":"我们会铭记他～的讲演。"},"usage":"作宾语、定语；用于说话"},{"id":40708,"word":"言听事行","pinyin":"yán tīng shì xíng","abbr":"ytsx","explanation":"指说话能听从，事情能执行。","source":{"text":"言听事行，则如师徒之势。","book":"《韩非子·说疑》"},"similar":["言听计从","言听行从"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40709,"word":"言听行从","pinyin":"yán tīng xíng cóng","abbr":"ytxc","explanation":"指说话、做事有人听从。形容威望很高。","source":{"text":"圣人之功，定制于冥冥，求至欲得，言听行从，近亲远附，明达四通。","book":"《鹖冠子·道端》"},"similar":["言听事行"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":40710,"word":"言听计从","pinyin":"yán tīng jì cóng","abbr":"ytjc","explanation":"听：听从。什么话都听从，什么主意都采纳。形容对某人十分信任。","source":{"text":"汉王授我上将军印，予我数万众，解衣衣我，推食食我，言听计用，故吾得以至于此。","book":"《史记·淮阴侯列传》"},"example":{"text":"邓对于他也就和刘玄德之于诸葛孔明，几几乎是～的。","book":"郭沫若《革命春秋·北伐途次》二十六"},"similar":["百依百顺","深信不疑","言听计用"],"opposite":["一意孤行","疑神疑鬼","疑团满腹"],"usage":"作谓语、定语、状语；用于上下级或长晚辈","story":["楚汉相争时期，齐王韩信一举击败项羽的20万大军，项羽派谋士武涉去劝韩信亲近他，与刘邦为敌或者自己称王、三分天下，告诉他一旦项王失败，下一个就轮到韩信了。韩信说：“汉王十分信任我，对我言听计从，我不能失道义。”"]},{"id":40711,"word":"言听计用","pinyin":"yán tīng jì yòng","abbr":"ytjy","explanation":"形容对某人十分信任。同“言听计从”。","source":{"text":"汉王授我上将军印，予我数万众，解衣衣我，推食食我，言听计用，故吾得以至于此。","book":"《史记·淮阴侯列传》"},"example":{"text":"多蒙丞相顾爱，累授迁除，～。","book":"明·无名氏《五马破曹》楔子"},"similar":["言听计从"],"usage":"作谓语、定语；同“言听计从”"},{"id":40712,"word":"言听计行","pinyin":"yán tīng jì xíng","abbr":"ytjx","explanation":"形容对某人十分信任。同“言听计从”。","source":{"text":"观玄宗开元时，厉精求治，元老魁旧，动所尊惮，故姚元崇、宋璟言听计行，力不难而功已成。","book":"《新唐书·魏知古卢怀慎传赞》"},"similar":["言听计用","言听计从"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40713,"word":"言听谋决","pinyin":"yán tīng móu jué","abbr":"ytmj","explanation":"指说的话听从照办，出的主意决定实行。","source":{"text":"绎堂制府以为能，言听谋决。","book":"清·昭槤《啸亭杂录·朱白泉狱中上百朱二公书》"},"similar":["言听计从"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40714,"word":"言和心顺","pinyin":"yán hé xīn shùn","abbr":"yhxs","explanation":"说话和气，使人心情舒畅。","source":{"text":"那怪既神通广大，变得与你相同，满朝文武，一个个言和心顺；三宫妃嫔，一个个意合情投。","book":"明·吴承恩《西游记》第三十七回"}},{"id":40715,"word":"言和意顺","pinyin":"yán hé yì shùn","abbr":"yhys","explanation":"言语和顺，情意相谐。","source":{"text":"但愿他们两口儿言和意顺，从此老太太也省好些心。","book":"清·曹雪芹《红楼梦》第五回：“真是言和意顺，似漆如胶。”又第九十八回"},"usage":"作宾语、定语；用于处事"},{"id":40716,"word":"言外之味","pinyin":"yán wài zhī wèi","abbr":"ywzw","explanation":"语言中含而不露的深长意味。","source":{"text":"古今词人格调之高无如白石。惜不于意境上用力，故觉无言外之味，弦外之响，终落第二手。","book":"王国维《人间词话》二二"},"similar":["言外之意"],"usage":"作宾语；用于说话或文辞等"},{"id":40717,"word":"言外之意","pinyin":"yán wài zhī yì","abbr":"ywzy","explanation":"指有这个意思，但没有在话里明说出来。","source":{"text":"七言难于气象雄浑，句中有力而纡余，不失言外之意。","book":"宋·欧阳修《六一诗话》：“必能状难写之景，如在目前，含不尽之意，见于言外，然后为至矣。”宋·叶梦得《石林诗话》"},"example":{"text":"间有一二不尽之言，～，以少少许胜多多许者，是他一枝一节好处。","book":"清·郑燮《潍县署中与舍弟第五书》"},"similar":["弦外之音","意在言外","音在言外"],"opposite":["一针见血","一语道破","直截了当"],"usage":"作主语、宾语；同“弦外之音”"},{"id":40718,"word":"言多伤倖","pinyin":"yán duō shāng xìng","abbr":"ydsx","explanation":"话多易出问题，以致言行不一，使品行受损害。同“言多伤行”。"},{"id":40719,"word":"言多伤幸","pinyin":"yán duō shāng xìng","abbr":"ydsx","explanation":"话多易出问题，以致言行不一，使品行受损害。同“言多伤行”。","source":{"text":"他那里问言多伤幸，絮得些家宅神长是不安宁。","book":"元·石德玉《紫云庭》第一折"},"similar":["言多伤行"],"usage":"作宾语、定语；用于书面语"},{"id":40720,"word":"言多伤行","pinyin":"yán duō shāng xíng","abbr":"ydsx","explanation":"话多易出问题，以致言行不一，使品行受损害。","source":{"text":"不是我把不定，无记性，言多伤行。","book":"元·关汉卿《金钱池》第三折"},"similar":["言多伤幸"],"usage":"作宾语、定语；用于书面语"},{"id":40721,"word":"言多失实","pinyin":"yán duō shī shí","abbr":"ydss","explanation":"话讲得多就失去了真实性。指说话不实在，浮夸严重。","source":{"text":"宋齐丘不欲唐主割地，谓李德明轻佻，言多失实。","book":"《新编五代史平话·周史平话》卷下"},"usage":"作宾语、定语；用于书面语"},{"id":40722,"word":"言多必失","pinyin":"yán duō bì shī","abbr":"ydbs","explanation":"话说多了一定有失误。","source":{"text":"言多必有数短之处。","book":"《鬼谷子·本经符》"},"example":{"text":"处世戒多言，～。","book":"清·朱用纯《治家格言》"},"similar":["直言贾祸","祸从口出"],"opposite":["谨小慎微","少说为妙","守口如瓶"],"usage":"作谓语、宾语；用于劝诫人"},{"id":40723,"word":"言多语失","pinyin":"yán duō yǔ shī","abbr":"ydys","explanation":"话说多了就难免有说错的地方。","source":{"text":"贤弟，你的言多语失，怎么拜把子？","book":"清·石玉昆《小五义》第27回"},"example":{"text":"要记住～的道理，防止祸从口出。"},"similar":["言多必失"],"usage":"作宾语、定语；同“言多必失”"},{"id":40724,"word":"言大非夸","pinyin":"yán dà fēi kuā","abbr":"ydfk","explanation":"乭：夸口。说的虽然是大话，但不是虚夸的。","source":{"text":"言有大而非夸者，达者信之。","book":"宋·苏轼《六一居士集序》"},"example":{"text":"玉池此赞，～，猗若我公，撰述成家。","book":"钱基博、李肖聃《近百年湖南学风·湘学略》·九"}},{"id":40725,"word":"言寡尤，行寡悔","pinyin":"yán guǎ yóu，xíng guǎ huǐ","abbr":"ygyxgh","explanation":"指说话做事很少犯错误。","source":{"text":"言寡尤，行寡悔，禄在其中矣。","book":"春秋·鲁·孔丘《论语·为政》"},"example":{"text":"就日日讲究‘～’，那个给你做官？","book":"清·吴敬梓《儒林外史》第13回"},"usage":"作谓语、定语、分句；指说话做事很少犯错误"},{"id":40726,"word":"言差语错","pinyin":"yán chā yǔ cuò","abbr":"ycyc","explanation":"言语冲撞或口舌之争。","source":{"text":"谁都有～的，不必过分计较。"},"example":{"text":"谁都有～的，不必过分计较"},"usage":"作宾语、定语；用于说话"},{"id":40727,"word":"言帚忘笤","pinyin":"yán zhǒu wàng tiáo","abbr":"yzwt","explanation":"帚：扫帚；笤：条笤。说扫帚忘条笤。形容人健忘。","source":{"text":"世尊在日，有比丘钝根，无多闻性，佛令诵笤帚二字，旦夕诵之，言笤则已忘帚，言帚则又忘笤。","book":"宋·陈善《扪虱新话》"}},{"id":40728,"word":"言归于好","pinyin":"yán guī yú hǎo","abbr":"ygyh","explanation":"言：句首助词，无义。指彼此重新和好。","source":{"text":"凡我同盟之人，既盟之后，言归于好。","book":"《左传·僖公九年》"},"example":{"text":"奉教撤兵，～。","book":"明·冯梦龙《东周列国志》第五回"},"similar":["破镜重圆","重修盟好"],"opposite":["话不投机"],"usage":"作谓语、定语、宾语；用于人或组织等","story":["三国时期，曹丕称帝，东吴孙权也想成就帝业就投靠他，曹丕封他为吴王，还想立他的儿子孙登为太子。孙权派沈珩送去很多珠宝与香料。他们约定魏吴信守诺言，言归于好。沈珩不辱使命，回东吴后被封安乡侯"]},{"id":40729,"word":"言归和好","pinyin":"yán guī hé hǎo","abbr":"yghh","explanation":"指彼此重新和好。同“言归于好”。","source":{"text":"昔之疆场用兵，本冀言归和好。不幸寇凶极祸，明祚永终。","book":"《清史稿·世祖纪一》"},"similar":["言归于好"],"usage":"作谓语、定语、宾语；用于人或组织等"},{"id":40730,"word":"言归正传","pinyin":"yán guī zhèng zhuàn","abbr":"ygzz","explanation":"正传：正题或本题。指话头转回到正题上来。旧小说中常用的套语。","source":{"text":"如今说书的‘从旁指点桃源路，引得渔郎来问津’，算通前彻后交待明白了，然后这再言归正传。","book":"清·文康《儿女英雄传》第二十三回"},"example":{"text":"现在我们～，集中讨论这件事，发言要围绕中心。"},"similar":["闲话少说","闲话休说"],"opposite":["离题万里","不着边际","言不及义"],"usage":"作谓语；旧小说中常用的套语"},{"id":40731,"word":"言微旨远","pinyin":"yán wēi zhǐ yuǎn","abbr":"ywzy","explanation":"言辞精妙，意义深远。","source":{"text":"圣哲垂训，言微旨远。","book":"唐·白居易《礼部试策王道三》"},"usage":"作谓语、定语；用于说话或文章等"},{"id":40732,"word":"言必信，行必果","pinyin":"yán bì xìn，xíng bì guǒ","abbr":"ybxxbg","explanation":"信：守信用；果：果断，坚决。说了就一定守信用，做事一定办到。","source":{"text":"言必信，行必果，硁硁然小人哉。","book":"《论语·子路》"},"example":{"text":"我们中国人说话是算数的，从来是～。"},"similar":["言而有信","君子一言，驷马难追"],"opposite":["背信弃义"],"usage":"作宾语、主语、分句；指言出必行","story":["春秋时期，孔子带领弟子们周游列国，在陈国闲居无事，与弟子讨论修身之事。孔子认为做“士”要做到“仁者不忧、知者不惑、勇者不惧”三好，士分三类：“不辱君命，为国效力；孝悌兼备，乡邻模范；言信行果，千金一诺。”"]},{"id":40733,"word":"言必有中","pinyin":"yán bì yǒu zhòng","abbr":"ybyz","explanation":"中：正对上。指一说话就能说到点子上。","source":{"text":"夫人不言，言必有中。","book":"《论语·先进》"},"example":{"text":"夫人不言，～。","book":"《周书·武帝纪上》"},"similar":["一语破的","击中要害","言不虚发"],"opposite":["漫无边际","废话连篇","语无伦次"],"usage":"作分句；形容说话中肯"},{"id":40734,"word":"言必有据","pinyin":"yán bì yǒu jù","abbr":"ybyj","explanation":"言：说话；据：依据。说话一定要有根据。","source":{"text":"对于历史小说，则以为博考文献，言必有据者，纵使有人讥为‘教授小说’，其实是很难组织之作。","book":"鲁迅《序言》"},"example":{"text":"说话必须～。"},"similar":["言之成理","有案可稽","有凭有据"],"opposite":["牵强附会","言过其实","捕风捉影"],"usage":"作谓语、宾语、定语；指说话一定要有根据"},{"id":40735,"word":"言必有物","pinyin":"yán bì yǒu wù","abbr":"ybyw","explanation":"指言论或文章内容充实。","source":{"text":"故凡所录取，皆以发明义理，清真古雅，言必有物为宗。","book":"清·方苞《进〈四书〉〈文选〉表》"},"usage":"作谓语、定语；用于说话或作文等"},{"id":40736,"word":"言意相离","pinyin":"yán yì xiāng lí","abbr":"yyxl","explanation":"语言和思想相分离。比喻说的与想的不一致。","source":{"text":"言意相离，凶也。","book":"《吕氏春秋·离谓》"}},{"id":40737,"word":"言扬行举","pinyin":"yán yáng xíng jǔ","abbr":"yyxj","explanation":"根据德行和名声来选择人才。","source":{"text":"凡语于郊者，必取贤敛才焉：或以德进，或以事举，或以言扬。","book":"西汉·戴圣《礼记·文王世子》"},"example":{"text":"那时用‘～’做官，故孔子只讲得个‘言寡尤，行寡悔，禄在其中’。","book":"清·吴敬梓《儒林外史》第13回"},"usage":"作谓语、定语；指根据德行和名声来选择人才"},{"id":40738,"word":"言提其耳","pinyin":"yán tí qí ěr","abbr":"ytqe","explanation":"揪着他耳朵。指恳切地教诲。言，助词。","source":{"text":"我非但对面语之，亲提其耳。此言以教道之，孰不可启觉。","book":"《诗·大雅·抑》：“匪面命之，言提其耳。”郑玄笺"},"example":{"text":"故丁宁周至，～，每事指斥，不尚浮辞。","book":"北魏·贾思勰《〈齐民要术〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":40739,"word":"言教身传","pinyin":"yán jiào shēn chuán","abbr":"yjsc","explanation":"言教：用言语讲解、传授；身传：以行动示范。既用言语来教导，又用行动来示范。指行动起模范作用。","source":{"text":"语之所贵者意也，意有所随。意之所随者，不可以言传也。","book":"《庄子·天道》"},"example":{"text":"正是在潘汉年～之下，郑育之很快掌握了党的秘密工作的方法。","book":"张云《潘汉年传奇·一身二任的“八办”主任》"},"similar":["言传身教"],"usage":"作宾语、定语；用于处事"},{"id":40740,"word":"言文刻深","pinyin":"yán wén kè shēn","abbr":"ywks","explanation":"法律条文严峻刻薄。","example":{"text":"现代社会不能有～的法律条文。"},"usage":"作谓语、定语；用于法律等"},{"id":40741,"word":"言文行远","pinyin":"yán wén xíng yuǎn","abbr":"ywxy","explanation":"言辞有文采，才能传播远方或影响后世。","source":{"text":"明·张溥《〈壬申文选〉序》：“言文行远，国家赖之。”参见“言而无文，行之不远”。"},"usage":"作宾语、定语；用于书面语"},{"id":40742,"word":"言方行圆","pinyin":"yán fāng xíng yuán","abbr":"yfxy","explanation":"指言论正直而行为圆滑。","source":{"text":"凡今之人，言方行圆，口正心邪。","book":"汉·王符《潜夫论·交际》"},"similar":["言行不一"],"opposite":["言行一致"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40743,"word":"言无不尽","pinyin":"yán wú bù jìn","abbr":"ywbj","explanation":"把内心的话说尽，毫不保留。","source":{"text":"德政与帝旧相昵爱，言无不尽。","book":"《北齐书·高德政传》"},"example":{"text":"故情无不通，～。","book":"宋·司马光《乞改求谏诏书札子》"},"similar":["知无不言"],"opposite":["缄口不言"],"usage":"作谓语、定语、宾语；常与“知无不言”连用","story":["后齐时期，丞相高洋与相府参军高德政关系十分融洽，高德政言无不尽，高洋言听计从。高祖在晋阳去世，渤海王世宗继位，在晋阳处理后事时被盗贼所杀。高德政拥立高洋为文宣皇帝，高洋拜他为侍中，一唱一和"]},{"id":40744,"word":"言无二价","pinyin":"yán wú èr jià","abbr":"ywej","explanation":"货物的价钱说一不二。","source":{"text":"常采药名山，卖于长安市，口不二价，三十余年。","book":"南朝·宋·范晔《后汉书·逸民传·韩康》"},"example":{"text":"况敝货并非‘～’，其中颇有虚头。","book":"清·李汝珍《镜花缘》第11回"},"similar":["买卖公平","老少无欺","公平交易"],"opposite":["欺行霸市"],"usage":"作谓语；用于说话算数"},{"id":40745,"word":"言无伦次","pinyin":"yán wú lún cì","abbr":"ywlc","explanation":"语言杂乱无章。","source":{"text":"明·李开先《亡妻张宜人散传》：“言无伦次，事无统纪。”参见“语无伦次”。"},"similar":["语无伦次"],"usage":"作谓语、定语、状语；用于说话等"},{"id":40746,"word":"言无枝叶","pinyin":"yán wú zhī yè","abbr":"ywzy","explanation":"枝叶：比喻琐细的言辞。形容言词文字简洁，没有枝蔓的言词。","source":{"text":"内行修谨，言无枝叶。","book":"《宋史·李沆传》"},"similar":["词无枝叶"],"opposite":["辞有枝叶"],"usage":"作谓语、定语；用于说话或作文等"},{"id":40747,"word":"言无粉饰","pinyin":"yán wú fěn shì","abbr":"ywfs","explanation":"粉饰：装饰表面。说出的话没有虚伪掩饰的地方。形容说话直言不讳。","source":{"text":"宋滕甫，东阳人，在帝前论事如家人父子，言无粉饰，洞见肺腑。","book":"明·彭大翼《山堂肆考》"}},{"id":40748,"word":"言是人非","pinyin":"yán shì rén fēi","abbr":"ysrf","explanation":"指言论无可非议，但为人不可取。","source":{"text":"徐铉、张洎言是人非。","book":"明·李贽《史纲评要·宋纪·太祖》"},"usage":"作谓语、定语；用于书面语"},{"id":40749,"word":"言是心声","pinyin":"yán shì xīn shēng","abbr":"ysxs","explanation":"言语是思想的反映，从一个人的话里可以知道他的思想感情。","source":{"text":"故言，心声也；书，心画也。声画形，君子小人见矣。","book":"汉·扬雄《法言·问神》"}},{"id":40750,"word":"言有召祸","pinyin":"yán yǒu zhào huò","abbr":"yyzh","explanation":"召：招来；祸：灾祸。出言不慎容易招致祸患。旧戒人说话要慎重。","source":{"text":"故言有召祸也，行有召辱也，君子慎其所立乎！","book":"《荀子·劝学》"}},{"id":40751,"word":"言有尽而意无穷","pinyin":"yán yǒu jìn ér yì wú qióng","abbr":"yyjeywq","explanation":"指诗文含义深刻，令人品味不尽。","source":{"text":"盛唐诸人惟在兴趣，羚羊挂角，无迹可求。故其妙处，透彻玲珑，不可凑泊，如空中之音，相中之色，水中之月，镜中之象，言有尽而意无穷。","book":"宋·严羽《沧浪诗话·诗辨》"},"similar":["言有尽而音意无穷"],"usage":"作宾语、定语；用于书面语"},{"id":40752,"word":"言有尽而音意无穷","pinyin":"yán yǒu jìn ér yīn yì wú qióng","abbr":"yyjeyywq","explanation":"语言有穷尽而含意没有穷尽。指诗文等蕴含着深刻含义","source":{"text":"故知词也者，言有尽而音意无穷也。","book":"清·刘熙载《艺概·词曲赋》"},"similar":["言有尽而意无穷"],"usage":"作宾语、定语；用于书面语"},{"id":40753,"word":"言来语去","pinyin":"yán lái yǔ qù","abbr":"ylyq","explanation":"指谈笑时你一言我一语，彼此应对。","source":{"text":"他把娇胭腻粉频交易，与我言来语去相调戏。","book":"元·曾瑞《留鞋记》第一折"},"example":{"text":"～闲谈笑，二更鼓罢又三更。","book":"《天雨花》第二六回"},"usage":"作定语、状语；用于说话"},{"id":40754,"word":"言气卑弱","pinyin":"yán qì bēi ruò","abbr":"yqbr","explanation":"说话的态度谦虚温顺。"},{"id":40755,"word":"言泉会九流","pinyin":"yán quán huì jiǔ liú","abbr":"yqhjl","explanation":"形容人口才好，滔滔不绝。","source":{"text":"洎姬历云季，歌颂滋繁，荀宋之流，导源自远，总金羁而齐骛，扬玉轪而并驰，言泉会于九流，交律诣于六变。","book":"《晋书·文苑传序》"}},{"id":40756,"word":"言深交浅","pinyin":"yán shēn jiāo qiǎn","abbr":"ysjq","explanation":"交：交情，友谊。跟交情浅的人谈心里话。","source":{"text":"夫望人而笑，是和也；言而不称师，是庸说也；交浅而言深，是忠也。","book":"《战国策·赵策四》"}},{"id":40757,"word":"言清行浊","pinyin":"yán qīng xíng zhuó","abbr":"yqxz","explanation":"清：清高；浊：浑浊，指低下。说的是清白好话，十的是污浊坏事。形容人言行不一。","source":{"text":"言轻行浊，执不通变。","book":"唐·李虚中《命书》卷中"},"example":{"text":"余观世人恒无真志，要不过落在委靡浑浊之中，是故口是心非，～。","book":"明·李贽《焚书·书答·失言三首》"},"usage":"作谓语、定语；用于处事"},{"id":40758,"word":"言犹在耳","pinyin":"yán yóu zài ěr","abbr":"yyze","explanation":"犹：还。说的话还在耳边。比喻说的话还清楚地记得。","source":{"text":"今君虽终，言犹在耳。","book":"《左传·文公七年》"},"example":{"text":"～，忠岂忘心。","book":"唐·骆宾王《代李敬业传檄天下文》"},"similar":["念念不忘","记忆犹新","余音绕梁"],"opposite":["置之脑后"],"usage":"作谓语；形容对别人的话印象很深","story":["春秋时期，晋襄公死后，太子夷皋年少，赵盾执掌国政，他想立襄公弟弟雍为国君，派人去秦国接他。太子夷皋的母亲缪赢知道后，日夜抱着夷皋在朝廷上痛哭，说襄公生前托孤言犹在耳，怎么能立即变卦呢"]},{"id":40759,"word":"言狂意妄","pinyin":"yán kuáng yì wàng","abbr":"ykyw","explanation":"说话狂放，意态虚妄。","source":{"text":"述其自序云：‘歜上书之明年，言狂意妄，圣天子不赐镬樵全生，弃逐岭表。","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵六》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":40760,"word":"言甚详明","pinyin":"yán shèn xiáng míng","abbr":"ysxm","explanation":"论述很详尽明了。","example":{"text":"这篇文章观点已经～。"},"usage":"作谓语、定语；用于文章或说话"},{"id":40761,"word":"言由衷发","pinyin":"yán yóu zhōng fā","abbr":"yyzf","explanation":"衷：内心。言语是从内心发出来的。指口说的和心想的一致。","source":{"text":"即投赠名公巨卿，或感其知，或颂其德，或纪其功，或述其义，但使言由衷发，无溢美逾分之词。","book":"清·朱庭珍《筱园诗话》"}},{"id":40762,"word":"言笑不苟","pinyin":"yán xiào bù gǒu","abbr":"yxbg","explanation":"不随便谈笑。形容态度严肃庄重。同“不苟言笑”。","source":{"text":"妙观变以师道自尊，妆模做样，尽自矜持，言笑不苟。","book":"《二刻拍案惊奇》卷二"},"example":{"text":"又闻美国学童，跬步必肃，～。","book":"梁启超《变法通议·论幼学》"},"similar":["不苟言笑"],"usage":"作谓语、定语；用于书面语"},{"id":40763,"word":"言笑嘻怡","pinyin":"yán xiào xī yí","abbr":"yxxy","explanation":"形容神情十分欢快。","source":{"text":"晓下黄阁，车骑威迟。夕归华堂，言笑嘻怡。","book":"唐·刘禹锡《代诸郎中祭王相国文》"},"usage":"作谓语、定语；用于书面语"},{"id":40764,"word":"言笑晏晏","pinyin":"yán xiào yàn yàn","abbr":"yxyy","explanation":"说说笑笑，和柔温顺。","source":{"text":"晏晏，和柔也。","book":"《诗·卫风·氓》：“总角之宴，言笑晏晏。”毛传"},"example":{"text":"复有公子女郎共十数辈，青衣黄头亦十数人，步月徐来，～。","book":"唐·任蕃《梦游录·独孤遐叔》"},"usage":"作谓语、定语；用于书面语"},{"id":40765,"word":"言笑自如","pinyin":"yán xiào zì rú","abbr":"yxzr","explanation":"谈笑如常，十分镇定。","source":{"text":"群夷纵火，牛街镇去城三十馀里，火光烛天。公言笑自如，日夜为守战计，贼不敢逼。","book":"清·方苞《通议大夫江南布政使陈介墓志铭》"},"similar":["言笑自若"],"usage":"作谓语、状语；指人遇事镇定"},{"id":40766,"word":"言笑自若","pinyin":"yán xiào zì ruò","abbr":"yxzr","explanation":"谈笑如常，十分镇定。","source":{"text":"其后修贬夷陵，太夫人言笑自若。","book":"《三国志·蜀志·关羽传》：“时羽适请诸将饮食相对，臂血流离，盈于盘器，而羽割灸引酒，言笑自若。”宋·欧阳修《泷冈阡表》"},"example":{"text":"祭毕，即除去孝服，沐浴薰香，浓妆艳裹，～。","book":"明·罗贯中《三国演义》第三十八回"},"similar":["言笑自如"],"usage":"作谓语、状语；指人遇事镇定"},{"id":40767,"word":"言简义丰","pinyin":"yán jiǎn yì fēng","abbr":"yjyf","explanation":"语言简练，含意丰富。","source":{"text":"夫《坛经》者，言简义丰，理明事备，具足诸佛无量法门。","book":"元·德异《〈六祖大师法宝坛经〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":40768,"word":"言简意不遗","pinyin":"yán jiǎn yì bù yí","abbr":"yjyby","explanation":"话不多，但没有遗漏的。形容说话写文章简明扼要。","source":{"text":"人之迷经者，盖己所守未明，故常为语言可以移动。己守既定，虽孔孟之言有纷错，亦不须思而改之，复锄去其繁，使词简而意备。","book":"宋·张载《张子全书·义理》"}},{"id":40769,"word":"言简意少","pinyin":"yán jiǎn yì shǎo","abbr":"yjys","explanation":"简：简练。语言简洁，内容贫乏。","example":{"text":"写文章要言简意赅，但并不是言简意少。"},"similar":["简明扼要","言简意赅"],"opposite":["洋洋万言"],"usage":"作谓语、补语；用于文章等"},{"id":40770,"word":"言简意明","pinyin":"yán jiǎn yì míng","abbr":"yjym","explanation":"简：简练。言辞简练，意思完备","source":{"text":"王公伯言简意明地说：‘他的刑判得不合理，而且他没认罪。’","book":"王亚平《神圣的使命》"},"similar":["言简意该","言简意赅"],"usage":"作谓语、状语、定语；用于说话或文章等"},{"id":40771,"word":"言简意深","pinyin":"yán jiǎn yì shēn","abbr":"yjys","explanation":"言辞简练，含意深刻。","source":{"text":"不在乎奇险诘曲，惊人耳目，而在乎言简意深，一语胜人千百。","book":"清·赵翼《瓯北诗话·陆放翁诗》"},"example":{"text":"词语虽然粗俗，笔气极其纵横，而且～，包括不遗。","book":"《三侠五义》第四一回"},"usage":"作谓语、定语；用于书面语"},{"id":40772,"word":"言简意该","pinyin":"yán jiǎn yì gāi","abbr":"yjyg","explanation":"简：简练。言辞简练，意思完备","source":{"text":"若《关雎》、《思无邪》章，诵《诗三百》以及《兴观群怨》、《周南》、《召南》等章，莫不言简意该，义深词洁。","book":"清·崔述《读风偶识》第一卷"},"similar":["言简意赅","言简意明"],"usage":"作谓语、状语、定语；用于说话或文章等"},{"id":40773,"word":"言简意赅","pinyin":"yán jiǎn yì gāi","abbr":"yjyg","explanation":"形容说话写文章简明扼要。同“言简意赅”。","source":{"text":"夫《论语》所载孔子论诗之言多矣，若《关雎》、《思无邪》章，诵《诗三百》以及《兴观群怨》、《周南》等章，莫不言简意该，义深词洁。","book":"清·崔述《读风偶识》卷一"},"example":{"text":"萧乾《一本褪色的相册》：“要～，因而得半文半白。”"},"similar":["要言不烦","言近旨远","简明扼要"],"opposite":["长篇大论","连篇累牍","空洞无物"],"usage":"作谓语、状语、定语；用于说话或文章等"},{"id":40774,"word":"言简意足","pinyin":"yán jiǎn yì zú","abbr":"yjyz","explanation":"言辞简练，但含意很明确。形容说话写文章简明透彻。","source":{"text":"人之迷经者，盖己所守未明，故常为语言可以移动。己守既定，虽孔孟之言有纷错，亦不须思而改之，复锄去其繁，使词简而意备。","book":"宋·张载《张子全书·义理》"}},{"id":40775,"word":"言类悬河","pinyin":"yán lèi xuán hé","abbr":"ylxh","explanation":"形容能言善辩，说话滔滔不绝。","source":{"text":"郭象言类悬河，不自劳苦，何由至此。","book":"南朝·齐·王僧虔《诫子书》"},"similar":["言若悬河"],"usage":"作谓语、定语；用于书面语"},{"id":40776,"word":"言约旨远","pinyin":"yán yuē zhǐ yuǎn","abbr":"yyzy","explanation":"言辞简练，含意深远。","source":{"text":"言各有隔而不通处，张忽遥于末坐判之，言约旨远，便足以畅彼我之怀。","book":"《太平御览》卷六一七引晋·郭澄之《郭子》"},"example":{"text":"全信～，博大精深，像一盏灿烂的明灯，照亮了诗歌和整个文艺创作发展的道路。《诗刊》1978年第4期"},"usage":"作谓语、定语；用于书面语"},{"id":40777,"word":"言约理辨","pinyin":"yán yuē lǐ biàn","abbr":"yylb","explanation":"约：简约。言辞简练，但含意深远。形容说话写文章简明透彻。","source":{"text":"夜深，语及养生，言约理辨。黎转敬惧。","book":"宋·李昉《太平广记》卷一百九十五"}},{"id":40778,"word":"言美则响美","pinyin":"yán měi zé xiǎng měi","abbr":"ymzxm","explanation":"比喻人的人格、行为高尚，声誉也必然好。","source":{"text":"言美则响美，身长则影长，身短则影短。名也者，响也；身也者，影也。","book":"《列子·说符》"}},{"id":40779,"word":"言者不知","pinyin":"yán zhě bù zhī","abbr":"yzbz","explanation":"指多言多语的人缺乏智能。","source":{"text":"《老子》：“知者不言，言者不知。”河上公注：“知者贵行不贵言也。驷不及舌，多言多患。”一本作“言者弗知”。"},"example":{"text":"～知者默，此语吾闻于老君。","book":"唐·白居易《读〈老子〉》诗"},"similar":["言者弗知"],"usage":"作宾语、定语；用于书面语"},{"id":40780,"word":"言者弗知","pinyin":"yán zhě fú zhī","abbr":"yzfz","explanation":"指多言多语的人缺乏智能。同“言者不知”。","source":{"text":"《老子》：“知者不言，言者不知。”河上公注：“知者贵行不贵言也。驷不及舌，多言多患。”一本作“言者弗知”。"},"similar":["言者不知"],"usage":"作宾语、定语；用于书面语"},{"id":40781,"word":"言者心之声","pinyin":"yán zhě xīn zhī shēng","abbr":"yzxzs","explanation":"言语是思想的反映，从一个人的话里可以知道他的思想感情。","source":{"text":"故言，心声也；书，心画也。声画形，君子小人见矣。","book":"汉·扬雄《法言·问神》"},"example":{"text":"夫～也，其心慷慨择其言必磊落而英多。","book":"清·陈维崧《陈伽陵文集》卷二"}},{"id":40782,"word":"言者无意，听者有心","pinyin":"yán zhě wú yì，tīng zhě yǒu xīn","abbr":"yzwytzyx","explanation":"说话的人不是有心的，听话的人却认真计较。","source":{"text":"言者无意，听者有心，这句话正触着阿珠的‘隐痛’，要想保持平静也不可能了。","book":"高阳《胡雪岩全传·平步青云》中册"},"usage":"作宾语、定语、分句；用于说话等"},{"id":40783,"word":"言者无罪","pinyin":"yán zhě wú zuì","abbr":"yzwz","explanation":"指提意见的人只要是善意的，即使提得不正确，也是无罪的。","source":{"text":"上以风化下，下以风刺上，主文而谲谏，言之者无罪，闻之者足以戒。","book":"《诗经·周南·关雎·序》"},"example":{"text":"～闻者诫，下流上通上下泰。","book":"唐·白居易《采诗官》"},"usage":"作宾语、定语；用于批评与自我批评"},{"id":40784,"word":"言者无罪，闻者足戒","pinyin":"yán zhě wú zuì，wén zhě zú jiè","abbr":"yzwzwzzj","explanation":"指提意见的人只要是善意的，即使提得不正确，也是无罪的。听取意见的人即使没有对方所提的缺点错误，也值得引以为戒。","source":{"text":"上以风化下，下以风刺上，主文而谲谏，言之者无罪，闻之者足以戒。","book":"《诗经·周南·关雎·序》"},"example":{"text":"对待批评的态度，应该是～，有则改之，无则加勉。"},"similar":["言之无罪，闻之足戒"],"usage":"作主语、分句；用于批评与自我批评"},{"id":40785,"word":"言者谆谆，听者藐藐","pinyin":"yán zhě zhūn zhūn，tīng zhě miǎo miǎo","abbr":"yzzztzmm","explanation":"谆谆：教诲不倦的样子；藐藐：疏远的样子。说的人很诚恳，听的人却不放在心上。形容徒费口舌。","source":{"text":"诲尔谆谆，听我藐藐。","book":"《诗经·大雅·抑》"},"example":{"text":"顾～。","book":"廖仲恺《消费合作社概论》"},"similar":["言之谆谆，听之藐藐"],"usage":"作分句；用于书面语"},{"id":40786,"word":"言而不信","pinyin":"yán ér bù xìn","abbr":"yebx","explanation":"说话不讲信用。","source":{"text":"施而不仁，言而不信，怒而不威，是以外貌为之者也。","book":"《淮南子·泰族训》"},"similar":["言而无信"],"opposite":["言而有信"],"usage":"作谓语、定语；用于处事"},{"id":40787,"word":"言而无信","pinyin":"yán ér wú xìn","abbr":"yewx","explanation":"说话不算数，没有信用。","source":{"text":"言之所以为言者，信也。言而不信，何以为言？","book":"《谷梁传·僖公二十二年》"},"example":{"text":"老孙若不与你，恐人说我～。","book":"明·吴承恩《西游记》第六十一回"},"similar":["言而不信","自食其言","背信弃义"],"opposite":["一言为定","一诺千金","言而有信"],"usage":"作谓语、定语；指不讲信用"},{"id":40788,"word":"言而无文，行之不远","pinyin":"yán ér wú wén，xíng zhī bù yuǎn","abbr":"yewwxzby","explanation":"文章没有文采，就不能流传很远。同“言之无文，行之不远”。","source":{"text":"言而无文，行之不远；义而无立，勤则无成。","book":"北周·庚信《燕射歌辞·角调曲》"},"similar":["言之无文，行而不远"],"usage":"作宾语、分句；用于劝诫人"},{"id":40789,"word":"言而有信","pinyin":"yán ér yǒu xìn","abbr":"yeyx","explanation":"说话靠得住，有信用。","source":{"text":"与朋友交，言而有信。","book":"《论语·学而》"},"example":{"text":"则要你～，休担阁了少年人。","book":"元·戴善夫《风光好》第三折"},"similar":["言出必行"],"opposite":["言而无信","自食其言"],"usage":"作谓语、定语；用于讲信用的人"},{"id":40790,"word":"言能践行","pinyin":"yán néng jiàn xíng","abbr":"ynjx","explanation":"践：履行，实现。说到做到。","example":{"text":"他一向守信，～。"},"opposite":["言行不一"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40791,"word":"言芳行洁","pinyin":"yán fāng xíng jié","abbr":"yfxj","explanation":"指言行高洁。","source":{"text":"言芳行洁师古人，白玉不肯污纤尘。","book":"清·方文《赠别周颖侯》诗"},"usage":"作谓语、定语；用于处事"},{"id":40792,"word":"言若悬河","pinyin":"yán ruò xuán hé","abbr":"yrxh","explanation":"形容能言善辩，说话滔滔不绝。同“言类悬河”。","source":{"text":"《北史·裴蕴传》：“蕴亦机辩，所论法理，言若悬河，或重或轻，皆由其口，剖析明敏，时人不能致诘。”参见“口若悬河”。"},"similar":["言类悬河"],"usage":"作谓语、定语；用于书面语"},{"id":40793,"word":"言行一致","pinyin":"yán xíng yī zhì","abbr":"yxyz","explanation":"说的和做的完全一个样。指人表里如一。","source":{"text":"力行七年而后成，自此言行一致，表里相应，遇事坦然，常有余裕。","book":"宋·赵善璙《自警篇·诚实》"},"example":{"text":"我～，表里如一，事实具在，我虽死不移。","book":"郭沫若《屈原》第四幕"},"similar":["言而有信","心口如一","表里如一"],"opposite":["言不由衷","心口不一","表里不一"],"usage":"作主语、谓语、宾语；指表里如一"},{"id":40794,"word":"言行不一","pinyin":"yán xíng bù yī","abbr":"yxby","explanation":"说的是一套，做的又是另外一套。","source":{"text":"言行不类，始终相悖。","book":"《逸周书·官人》"},"example":{"text":"为人处世要言行一致，不可～。"},"similar":["言而无信"],"opposite":["言行一致"],"usage":"作宾语、定语；指不讲信用"},{"id":40795,"word":"言行不符","pinyin":"yán xíng bù fú","abbr":"yxbf","explanation":"说的和做的不相符合。","source":{"text":"言行不类，始终相悖。","book":"《逸周书·官人》"},"example":{"text":"无论怎样～，名实不副，前后矛盾……经过若干时候，自然被忘得干干净净。","book":"鲁迅《十四年的“读经”》"},"similar":["言行不一"],"opposite":["言行一致","言行相符"],"usage":"作谓语、定语、状语；用于处事"},{"id":40796,"word":"言行不类","pinyin":"yán xíng bù lèi","abbr":"yxbl","explanation":"说的和做的不相符合。指人表里不一，说一套，做一套。","source":{"text":"言行不类，始终相悖。","book":"《逸周书·官人》"}},{"id":40797,"word":"言行不贰","pinyin":"yán xíng bù èr","abbr":"yxbe","explanation":"犹言言行一致。说的和做的完全一个样。","source":{"text":"至性孝友，立节清峻，与物恭让，言行不贰。","book":"《晋书·孝友传·许孜》"},"similar":["言行一致"],"opposite":["言行不一"],"usage":"作谓语、定语；用于书面语"},{"id":40798,"word":"言行信果","pinyin":"yán xíng xìn guǒ","abbr":"yxxg","explanation":"说了就一定守信用，做事一定办到。同“言必信，行必果”。","source":{"text":"从今后，望言行信果，和睦万邦。","book":"郭沫若《沁园春·祝中日恢复邦交》词"},"similar":["言信行果","言必信，行必果"],"usage":"作宾语、定语；用于处事等"},{"id":40799,"word":"言行抱一","pinyin":"yán xíng bào yī","abbr":"yxby","explanation":"犹言言行一致。说的和做的完全一个样。","source":{"text":"言行抱一谓之贞，反贞为伪。","book":"汉·贾谊《新书·道述》"},"similar":["言行一致"],"opposite":["言行不一"],"usage":"作谓语、定语；用于书面语"},{"id":40800,"word":"言行相副","pinyin":"yán xíng xiāng fù","abbr":"yxxf","explanation":"说的和做的相符合。同“言行相符”。","source":{"text":"此章勉人使言行相副也。","book":"《论语·宪问》“君子耻其言而过其行”宋·邢昺疏"},"similar":["言行相符"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40801,"word":"言行相悖","pinyin":"yán xíng xiāng bèi","abbr":"yxxb","explanation":"说话和行动不一致，互相矛盾。","example":{"text":"与人相交贵在诚信，若经常～，出尔反尔，将难以取信于人。"}},{"id":40802,"word":"言行相符","pinyin":"yán xíng xiāng fú","abbr":"yxxf","explanation":"说的和做的相符合。","source":{"text":"言行相符，始终如一。","book":"南朝·梁简文帝《与刘孝仪令》"},"example":{"text":"臣时见其所行，信谓～，忠清内发。","book":"《魏书·李彪传》"},"similar":["言行一致","言行相副"],"opposite":["言行不一"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40803,"word":"言行相诡","pinyin":"yán xíng xiāng guǐ","abbr":"yxxg","explanation":"诡：违反，违背。说的和做的相违背。指言行不一。","source":{"text":"言行相诡，不祥莫大焉。","book":"《吕氏春秋·淫辞》"},"similar":["言行一致"],"opposite":["言行不一"],"usage":"作谓语、定语；指言行不一"},{"id":40804,"word":"言行相顾","pinyin":"yán xíng xiāng gù","abbr":"yxxg","explanation":"指言行不互相矛盾。","source":{"text":"言行相顾，慎终犹始。","book":"《北齐书·魏收传》"},"example":{"text":"君子～，若言过其行，谓有言而行不副，君子所耻也。","book":"《论语·宪问》“君子耻其言而过其行”宋·邢昺疏"},"similar":["言行相副","言行相符","言行一致"],"opposite":["言行不一"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40805,"word":"言行若一","pinyin":"yán xíng ruò yī","abbr":"yxry","explanation":"说的和做的完全一个样。指人表里如一。","source":{"text":"非义之事不计于心，非理之利不入于家，言行若一，情貌相副。","book":"汉·刘向《列女传·齐田稷母》"},"similar":["言行一致","说到做到"],"opposite":["言行不一"],"usage":"作谓语、定语；指说到做到"},{"id":40806,"word":"言行计从","pinyin":"yán xíng jì cóng","abbr":"yxjc","explanation":"说的话出的主意都采纳照办。形容深被信任。","source":{"text":"光自见言行计从，欲以身徇社稷。","book":"《宋史·司马光传》"},"example":{"text":"宋·司马光《乞去新法之病民伤国者疏》：“～，人莫能间。”"},"similar":["言听计从"],"usage":"作谓语、定语；用于处事"},{"id":40807,"word":"言言善果","pinyin":"yán yán shàn guǒ","abbr":"yysg","explanation":"言言：说好话。多说劝人行善的话，必有好处。","example":{"text":"佛教提倡～，这是有一定道理的。"},"usage":"作宾语、定语；用于说话"},{"id":40808,"word":"言讷词直","pinyin":"yán nè cí zhí","abbr":"yncz","explanation":"言讷：出言迟钝；直：直率。说话不利索，用词直率。形容说话直率，不善于花言巧语。","source":{"text":"欲学为辞，则患言讷词直，卒事不成。","book":"唐·韩愈《上考工崔虞部书》"}},{"id":40809,"word":"言论风生","pinyin":"yán lùn fēng shēng","abbr":"ylfs","explanation":"形容言谈议论时兴致很高，气氛活跃。","source":{"text":"[书生]邀入坐，言论风生。","book":"清·袁枚《新齐谐·赵李二生》"},"usage":"作谓语、状语；用于说话"},{"id":40810,"word":"言语举止","pinyin":"yán yǔ jǔ zhǐ","abbr":"yyjz","explanation":"人的言语、举动、行为。","source":{"text":"今诸将皆壮士屈起，多暴横，独有刘将军所到不虏掠。观其言语举止，非庸人也，可以归身。","book":"《后汉书·冯异传》"},"example":{"text":"怪道我这女学生～另是一样，不与近日女子相同，度其母必不凡，方得其女。","book":"清·曹雪芹《红楼梦》第二回"}},{"id":40811,"word":"言语妙天下","pinyin":"yán yǔ miào tiān xià","abbr":"yymtx","explanation":"形容言语非常精妙。","source":{"text":"君房下笔，言语妙天下。","book":"东汉·班固《汉书·贾捐之传》"},"example":{"text":"顾子年虽少，所交多名公钜儒，下笔～。","book":"清·汪琬《序》"},"usage":"作谓语、宾语；用于书面语"},{"id":40812,"word":"言语漏泄","pinyin":"yán yǔ lòu xiè","abbr":"yylx","explanation":"机密的话被泄露出去。","source":{"text":"今诸侯之事晋，不如昔者。盖言语漏泄，则职汝之由。","book":"《左传·襄公十四年》"},"example":{"text":"袁请训往天津，光绪帝出乾清宫召见，用尽方法，不使～。","book":"蔡东藩《清史演义》第八十六回"}},{"id":40813,"word":"言语路绝","pinyin":"yán yǔ lù jué","abbr":"yylj","explanation":"犹言言语道断。指不能通过交谈、谈判的方法解决问题。"},{"id":40814,"word":"言语道断","pinyin":"yán yǔ dào duàn","abbr":"yydd","explanation":"原为佛家语，指意义深奥微妙，无法用言辞表达。后指不能通过交谈、谈判的方法解决问题。","source":{"text":"言语道断，心行所灭。","book":"《缨珞经》"},"example":{"text":"三月十八日段政府惨杀徒手请愿的市民和学生的事，本已～，只使我们觉得所住的并非人间。","book":"鲁迅《华盖集续编·“死地”》"},"usage":"作谓语、定语；指不能用语言来解决问题"},{"id":40815,"word":"言语高低","pinyin":"yán yǔ gāo dī","abbr":"yygd","explanation":"指说话没分寸，冲撞别人。","example":{"text":"别在意他的～，不与他一般见识。"},"similar":["言高语低"],"usage":"作谓语、定语、宾语；用于说话"},{"id":40816,"word":"言谈举止","pinyin":"yán tán jǔ zhǐ","abbr":"ytjz","explanation":"人的言语、举动、行为。","source":{"text":"其言谈举止，不问可知胡先生弟子也。","book":"清·黄宗羲《陈母沈孺人墓志铭》"},"example":{"text":"她又长得好看，身子单薄，～非常斯文。","book":"刘绍棠《蒲柳人家》"},"similar":["音容笑貌"],"usage":"作主语、宾语、定语；指人的言行"},{"id":40817,"word":"言谈林薮","pinyin":"yán tán lín sǒu","abbr":"ytls","explanation":"林薮：人或物聚集的地方。指关于谈论的人。","source":{"text":"乐广尝与頠清言，欲以理服之，而頠辞论丰博，广笑而不言。时人谓頠为言谈之林薮。","book":"《晋书·裴秀传》"},"usage":"作宾语、定语；指善于谈论的人"},{"id":40818,"word":"言谈自若","pinyin":"yán tán zì ruò","abbr":"ytzr","explanation":"自若：跟平常一样。指能平静地对待所发生的情况，不改常态。","source":{"text":"融隐几读书，谈笑自若。","book":"《三国志·吴书·甘宁传》：“城中士众皆惧，惟宁谈笑自若。”《后汉书·孔融传》"},"example":{"text":"龛遣将杜泰乘虚掩至，将士相视失色，帝～，部分益明，于是众心乃定。","book":"明·刘基《百战奇略》卷十"}},{"id":40819,"word":"言过其实","pinyin":"yán guò qí shí","abbr":"ygqs","explanation":"实：实际。原指言语浮夸，超过实际才能。后也指话说得过分，超过了实际情况。","source":{"text":"马谡言过其实，不可大用。","book":"《三国志·蜀书·马良传》"},"example":{"text":"我不能不将他们那旗人的历史对你讲明，你好知道我不是～。","book":"清·吴趼人《二十年目睹之怪现状》第七回"},"similar":["夸大其辞","夸夸其谈","名不副实"],"opposite":["言必有信","恰如其分","名副其实"],"usage":"作谓语、定语；指浮夸","story":["三国时期蜀国大将马谡喜欢谈论军事理论，诸葛亮比较欣赏他。刘备认为马谡言过其实，不可大用。魏国司马懿亲自带兵与张郃进攻蜀国街亭，诸葛亮派马谡带兵防守，可是马谡骄傲轻敌，死搬兵书，结果被打败。诸葛亮只好挥泪斩马谡"]},{"id":40820,"word":"言近意远","pinyin":"yán jìn yì yuǎn","abbr":"yjyy","explanation":"话很浅近，含义却很深远。同“言近旨远”。","source":{"text":"所谓言近意远，合《三百篇》之旨也。","book":"宋·孙光宪《北梦琐言》卷二"},"similar":["言近指远","言近旨远","言高旨远"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":40821,"word":"言近指远","pinyin":"yán jìn zhǐ yuǎn","abbr":"yjzy","explanation":"话很浅近，含义却很深远。同“言近旨远”。","source":{"text":"言辞之近而指意远者，乃为善言者也。","book":"语出《孟子·尽心下》：“言近而指远者，善言也。”孙奭疏"},"example":{"text":"其～，词坦义明，诵者各有所获。","book":"元·宗宝《〈坛经〉跋》"},"similar":["言高旨远","言近旨远","言近意远"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":40822,"word":"言近旨远","pinyin":"yán jìn zhǐ yuǎn","abbr":"yjzy","explanation":"旨：意思。话很浅近，含义却很深远。","source":{"text":"言近而指远者，善言也。","book":"《孟子·尽心下》"},"example":{"text":"其书阐发孔、孟大旨，殚尽心力，折衷旧解，～，文简义明。","book":"清·李汝珍《镜花缘》第十八回"},"similar":["语重心长","微言大义","回味无穷"],"opposite":["言之无物","言不及义","空洞无物"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":40823,"word":"言重九鼎","pinyin":"yán zhòng jiǔ dǐng","abbr":"yzjd","explanation":"形容说话有分量，比较比来九鼎也不算重。","source":{"text":"昔之所以议进退天下士大夫者，今又重之以权位，故其一言之出，则九鼎不足为重。","book":"宋·邵博《邵氏闻见后录》卷十五"},"usage":"作谓语、定语；用于书面语"},{"id":40824,"word":"言颠语倒","pinyin":"yán diān yǔ dǎo","abbr":"ydyd","explanation":"说话颠三倒四。","source":{"text":"他是老年人，言颠语倒，不可认为闻言心旆摇。","book":"《群音类选·〈绣襦记·蝎蛇炽恶〉》"},"usage":"作谓语、定语、状语；用于说话等"},{"id":40825,"word":"言高旨远","pinyin":"yán gāo zhǐ yuǎn","abbr":"ygzy","explanation":"高：高深；远：深远。言论高深且含意深远。","source":{"text":"过蒙奖引，追赐诗书，言高旨远，足以为学者师法。","book":"宋·王安石《与参政王禹玉书》"},"example":{"text":"圣人之道，布在方册，《六经》则～，非讲求讨论，不可测其渊深。","book":"《宋史·田锡传》"},"similar":["言近指远","言近旨远"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":40826,"word":"言高语低","pinyin":"yán gāo yǔ dī","abbr":"ygyd","explanation":"说话不知轻重，没有分寸。","source":{"text":"店小二云：‘小人早晚言高语低，耽待些儿。’","book":"元·郑廷玉《金凤钗》第三折"},"similar":["言语高低"],"usage":"作谓语、定语；用于说话"},{"id":40827,"word":"言高趣远","pinyin":"yán gāo qù yuǎn","abbr":"ygqy","explanation":"高：高深；远：深远。言论高深且含意深远。","source":{"text":"过蒙奖引，追赐诗书，言高旨远，足以为学者师法。","book":"宋·王安石《与参政王禹玉书》"}},{"id":40828,"word":"訏谟定命","pinyin":"xū mò dìng mìng","abbr":"xmdm","explanation":"訏谟：大计，宏谋。胸怀大的谋划来确定政令。旧指处理军国大事。","source":{"text":"訏谟定命，远猷辰告。","book":"《诗经·大雅·抑》"},"example":{"text":"清·王夫之《葁斋诗话》：“谢太傅于《毛诗》取‘～，远猷辰告’，以此八句如一串珠。”"},"usage":"作宾语、定语；用于书面语"},{"id":40829,"word":"詀言詀语","pinyin":"zhān yán zhān yǔ","abbr":"zyzy","explanation":"花言巧语，胡说八道。","source":{"text":"贤弟[沙僧]，你是个好人，却只要留心防着八戒詀言詀语，途中更要仔细。","book":"明·吴承恩《西游记》第二十七回"}},{"id":40830,"word":"詈夷为跖","pinyin":"lì yí wéi zhí","abbr":"lywz","explanation":"詈：咒骂；夷：伯夷；跖：盗跖。指将伯夷责骂为盗跖。比喻颠倒黑白，诬蔑好人。","source":{"text":"其他占风望气，詈夷为跖，自弃名教者，固不可胜数矣。","book":"明·沈德符《野获编·言事·言官一言之失》"},"similar":["颠倒黑白"],"usage":"作谓语、定语；指是非不分"},{"id":40831,"word":"詟谀立懦","pinyin":"zhé yú lì nuò","abbr":"zyln","explanation":"指使谄谀者知所畏忌，怯懦者知所自立。","source":{"text":"指使谄谀者知所畏忌，怯懦者知所自立。"},"usage":"作谓语、定语；用于书面语"},{"id":40832,"word":"詹言曲说","pinyin":"zhān yán qǔ shuō","abbr":"zyqs","explanation":"烦琐、片面的言论。","source":{"text":"其他詹言曲说戋戋琐琐，又无讥焉。","book":"清·徐芳《〈书影〉序》"},"usage":"作宾语、定语；指片面的言论"},{"id":40833,"word":"詹詹炎炎","pinyin":"zhān zhān yán yán","abbr":"zzyy","explanation":"形容喋喋不休之状。","source":{"text":"炎炎，猛烈也；詹詹，词费也。","book":"《庄子·齐物论》：“大言炎炎，小言詹詹。”成玄英疏"},"example":{"text":"然方言社会革命，当与政治革命并行……苟无此不得不行之关系，则社会主义束之高阁可也，复何用～为？","book":"朱执信《论社会革命当与政治革命并行》"},"usage":"作宾语、定语；用于书面语"},{"id":40834,"word":"誉不绝口","pinyin":"yù bù jué kǒu","abbr":"ybjk","explanation":"不住地称赞。","source":{"text":"中书令温峤，前遭敦忌，由敦表请为左司马，峤竟诣敦所，佯为勤敬，尝进密谋，从敦所欲，厚结钱凤，誉不绝口。","book":"蔡东藩《两晋演义》第三十六回"}},{"id":40835,"word":"誉塞天下","pinyin":"yù sāi tiā xià","abbr":"ystx","explanation":"美好的名声，天下皆知。","source":{"text":"当此时，梁君誉塞天下，属词求进士，奉文章走梁君门下者，盖无虚日。","book":"五代·王定保《唐摭言·知己》"},"similar":["誉满天下","誉满寰中"],"usage":"作谓语、定语；用于书面语"},{"id":40836,"word":"誉望所归","pinyin":"yù wàng suǒ guī","abbr":"ywsg","explanation":"誉望：名誉和威望；归：归向。指为声誉所托，为众人所敬仰。多指某人担任某项重要职务是受到群众拥护的，和他的声誉相称。","source":{"text":"自营郃分司，卢钦兼掌，誉望所归，允集兹日。","book":"南朝·梁·任昉《王文宪集序》"},"usage":"作谓语、定语；用于书面语"},{"id":40837,"word":"誉满全球","pinyin":"yù mǎn quán qiú","abbr":"ymqq","explanation":"美好的名声，全世界皆知。","source":{"text":"宴语谈笑，情澜不竭；誉满天下，德冠生民。","book":"南朝·梁·沈约《齐故安陆昭王碑文》"},"example":{"text":"贵国的“茶道”艺术～，今天一经品尝，真是名不虚传了。","book":"陈玙《夜幕下的哈尔滨》第五十五章"}},{"id":40838,"word":"誉满天下","pinyin":"yù mǎn tiān xià","abbr":"ymtx","explanation":"美好的名声天下皆知。亦作“誉满全球”、“誉满寰中”、“誉塞天下”。","source":{"text":"君七岁，能诵数经，背碑覆局，十岁以文章知名，十五誉满天下。","book":"唐·李华《唐扬州功曹萧颖士文集序》"},"similar":["誉满寰中","誉塞天下"],"usage":"作谓语、定语；用于书面语"},{"id":40839,"word":"誉满寰中","pinyin":"yù mǎn huán zhōng","abbr":"ymhz","explanation":"寰：世间，天下。美好的名声，天下皆知。","source":{"text":"穷金坛之秘诀，百战不孤。誉满寰中，声盖天下。","book":"唐·杨梛《大周明威将军梁公神道碑》"},"example":{"text":"刘家两骥，～；荀氏八龙，名高海内。","book":"唐·武三思《大周无上孝明高皇后碑铭》"},"similar":["誉塞天下","誉满天下"],"usage":"作谓语、定语；用于书面语"},{"id":40840,"word":"誉满杏林","pinyin":"yù mǎn xìng lín","abbr":"ymxl","explanation":"誉：名声；满：充满。杏林春意盎然。赞扬医术高明","example":{"text":"～的好医生难找"},"similar":["杏林春满"],"usage":"作谓语、定语；用于书面语","story":["三国时期，著名医生董奉每天免费为人治病，医术十分高明，经常手到病除。病人要给他送礼，他坚决不收，只要求病人在他门前种一棵杏树，时间长了，他房子周围种上10万棵杏树，春天花开十分漂亮，他用杏树周济那些穷苦人家"]},{"id":40841,"word":"誉过其实","pinyin":"yù guò qí shí","abbr":"ygqs","explanation":"誉：声誉，声名。名声超过了其人的实际情况。","source":{"text":"此数子者，皆誉过其实。","book":"《晋书·王羲之传》"},"usage":"作谓语、定语；指名实不符"},{"id":40842,"word":"誓不两立","pinyin":"shì bù liǎng lì","abbr":"sbll","explanation":"誓：发誓。发誓不与敌人并存。指双方仇恨极深，不能同时存在。","source":{"text":"秦之所害于天下莫如楚，楚强则秦弱，楚弱则秦强，此其势不两立。","book":"《战国策·楚策一》"},"example":{"text":"瑜曰：“吾与老贼～。”","book":"明·罗贯中《三国演义》第四十四回"},"similar":["不共戴天","你死我活"],"opposite":["情投意合","亲密无间","同流合污"],"usage":"作谓语；指不能同时存在"},{"id":40843,"word":"誓不甘休","pinyin":"shì bù gān xiū","abbr":"sbgx","explanation":"誓：发誓；甘休：甘愿罢休。表示要坚持到底，决不善罢甘休。","example":{"text":"叔父梁战死定陶，仇尚未报，末将谊关子侄，～！","book":"蔡东藩《前汉演义》第十六回"}},{"id":40844,"word":"誓不罢休","pinyin":"shì bù bà xiū","abbr":"sbbx","explanation":"发誓不达目的决不甘休。","example":{"text":"我们不达目的～。"},"similar":["誓不甘休"],"usage":"作谓语；指具有坚定的决心"},{"id":40845,"word":"誓以皦日","pinyin":"shì yǐ jiǎo rì","abbr":"syjr","explanation":"指誓同生死，亲爱终生。","source":{"text":"谷则异室，死则同穴。谓予不信，有如皦日。","book":"语出《诗·王风·大车》"},"example":{"text":"女曰：‘能矢山河，勿令秋扇见捐，则惟命是听。’公乃～，女不复拒。","book":"清蒲松龄《聊斋志异·黄九郎》"},"usage":"作谓语、定语；用于处事"},{"id":40846,"word":"誓同生死","pinyin":"shì tóng shēng sǐ","abbr":"stss","explanation":"立誓同生共死。形容十分密切，不可拆散。","source":{"text":"吾三人义同骨肉，誓同生死；二人既亡，吾安能自活？","book":"明·冯梦龙《喻世明言》第二十五卷"},"example":{"text":"当年寒舍，曾与仁兄有一拜之交，～患难，真莫逆之交。","book":"清·褚人获《隋唐演义》第二十三回"},"similar":["同生共死"],"usage":"作谓语、定语；指关系密切"},{"id":40847,"word":"誓天指日","pinyin":"shì tiān zhǐ rì","abbr":"stzr","explanation":"对着天、日发誓。","source":{"text":"而其臣抱君之遗孤，奔走海岛，誓天指日，拥立为帝。","book":"明·方孝孺《正俗》"},"similar":["誓日指天"],"usage":"作谓语、定语；用于处事"},{"id":40848,"word":"誓天断发","pinyin":"shì tiān duàn fā","abbr":"stdf","explanation":"断发向天起誓。","source":{"text":"至于誓天断发，泣下沾襟，何其衰也！","book":"《新五代史·伶官传序》"},"usage":"作谓语、定语；用于处事"},{"id":40849,"word":"誓山盟海","pinyin":"shì shān méng hǎi","abbr":"ssmh","explanation":"指男女相爱时立下的誓言，表示爱情要象山和海一样永恒不变。同“山盟海誓”。","source":{"text":"顿忘了誓山盟海，顿忘了音书不寄来。","book":"《群音类选·四块玉·女相思》"},"similar":["山盟海誓","誓海盟山"],"usage":"作谓语、宾语、定语；用于男女之间"},{"id":40850,"word":"誓无二心","pinyin":"shì wú èr xīn","abbr":"swex","explanation":"形容意志坚定专一。同“誓无二志”。","source":{"text":"万岁爷休出此言，臣等情愿随驾，誓无二心。","book":"清·洪昇《长生殿·献饭》"},"similar":["誓无二志"],"usage":"作谓语、定语；用于处事"},{"id":40851,"word":"誓无二志","pinyin":"shì wú èr zhì","abbr":"swez","explanation":"立下誓言决不变心。形容意志坚定专一。","source":{"text":"倘蒙矜厄之仁，退师三十里，寡君愿以国从，誓无二志。","book":"《东周列国志》第五五回"},"similar":["誓无二心"],"usage":"作谓语、定语；用于处事"},{"id":40852,"word":"誓日指天","pinyin":"shì rì zhǐ tiān","abbr":"srzt","explanation":"对着天、日发誓。同“誓天指日”。","source":{"text":"沥肝碎首，无以鸣冤，誓日指天，莫能伸曲。","book":"清·钱泳《履园从话·旧闻·席氏多贤》"},"similar":["誓天指日"],"usage":"作谓语、定语；用于处事"},{"id":40853,"word":"誓死不二","pinyin":"shì sǐ bù èr","abbr":"ssbe","explanation":"誓死：立下志愿，至死不变。至死也不变心。形容意志坚定专一。","source":{"text":"被吃者也无须在被吃之前，先承认自己之理应被吃，心悦诚服，誓死不二。","book":"鲁迅《华盖集·夏三虫》"},"example":{"text":"他对党的忠心～。"},"similar":["矢忠不二","誓死不贰","忠贞不渝"],"opposite":["三心二意"],"usage":"作谓语、定语；指至死也不变心","story":["春秋时期，晋国典狱官李离为人正直，秉公办案，执法量刑均以律法为准绳，对高官与百姓一视同仁，做到有法必依，有罪必罚。他发现一起错判死刑的冤案，认为自己有责任，让下属绑了自己去见晋文公。文公要放他，他则认为应该对律法誓死不二"]},{"id":40854,"word":"誓死不从","pinyin":"shì sǐ bù cóng","abbr":"ssbc","explanation":"从：服从。发誓就是死也不服从。","source":{"text":"宜之子誓死不从，而衣裳远避也。","book":"清·名教中人《好逑传》第17回"},"example":{"text":"她违背夫妻的指腹为婚，表示～。"},"similar":["誓死不屈"],"usage":"作谓语、定语；指态度坚决"},{"id":40855,"word":"誓死不屈","pinyin":"shì sǐ bù qū","abbr":"ssbq","explanation":"宁死而不屈服，形容很有气节。","source":{"text":"司马忠洁公仗节虏廷，誓死不屈。","book":"宋·朱熹《跋王枢密答司马忠洁公帖》"},"example":{"text":"她～，慷慨就义。"},"similar":["宁死不屈"],"opposite":["贪生怕死"],"usage":"作谓语；指有气节"},{"id":40856,"word":"誓死不渝","pinyin":"shì sǐ bù yú","abbr":"ssby","explanation":"立誓至死不变。","source":{"text":"陈力之志，誓死不渝。","book":"唐·柳宗元《为裴中丞上裴相乞讨黄贼状》"},"similar":["誓死不贰","忠贞不渝"],"opposite":["朝秦暮楚"],"usage":"作谓语、定语；指至死也不变心"},{"id":40857,"word":"誓死不贰","pinyin":"shì sǐ bù èr","abbr":"ssbe","explanation":"立誓至死不生二心。形容忠贞不渝或意志坚定专一。","source":{"text":"宜速处分，为一战之资，当停据盆城，誓死不贰。","book":"《宋书·邓琬传》"},"example":{"text":"曾朴《孽海花》第29回：“我辈当率江上健儿，共隶于青年会会长孙君五色旗下，～。”"},"similar":["誓死不渝","誓死不二"],"opposite":["三心二意","朝秦暮楚"],"usage":"作谓语、定语；指至死也不变心"},{"id":40858,"word":"誓海盟山","pinyin":"shì hǎi méng shān","abbr":"shms","explanation":"指男女相爱时立下的誓言，表示爱情要象山和海一样永恒不变。同“山盟海誓”。","source":{"text":"皇天在上，照证两心知，誓海盟山永不移。","book":"明·王玉峰《焚香记·折证》：“相当初誓海盟山，他把香云痛剪。”《群音类选·〈玉簪记·词姤私情〉》"},"example":{"text":"蘅舫是一向有了交情的，～，已有白头之约。","book":"清·吴研人《二十年目睹之怪现状》第九十回"},"similar":["山盟海誓","誓山盟海"],"usage":"作谓语、宾语、定语；用于男女之间"},{"id":40859,"word":"諠客夺主","pinyin":"xī kè duó zhǔ","abbr":"xkdz","explanation":"客人占了主人的地位，或外来的、次要的事物占了原有的、主要的事物的地位。"},{"id":40860,"word":"謇謇谔谔","pinyin":"jiǎn jiǎn è è","abbr":"jjee","explanation":"謇謇：正直，诚实；谔谔：直言敢谏。形容忠正直言。","source":{"text":"其一謇謇谔谔，毅然若忠臣之蹈鼎镬也。","book":"宋·杨万里《浯溪赋》"},"example":{"text":"那～的左伯豪，又不能不乘机进谏，再贡忠忱。","book":"蔡东藩《后汉演义》第四十四回"}},{"id":40861,"word":"謇谔之节","pinyin":"jiǎn è zhī jié","abbr":"jezj","explanation":"謇谔：忠诚直言；节：节操。忠诚直言的节操。","source":{"text":"忠臣尽謇谔之节，不畏逆耳之害。","book":"《后汉书·陈忠传》"},"example":{"text":"王汝训诸人建言，挺～，洊历卿贰，不陨厥问。","book":"《明史·吴羽文传》"}},{"id":40862,"word":"謇谔之风","pinyin":"jiǎn è zhī fēng","abbr":"jezf","explanation":"謇谔：正直敢言。正直敢言的作风。","source":{"text":"骞素无謇谔之风，然与帝语傲。","book":"《晋书·裴秀传》"},"similar":["蹇谔之风"],"usage":"作主语、宾语；指敢直言的风气"},{"id":40863,"word":"謇谔自负","pinyin":"jiǎn è zì fù","abbr":"jezf","explanation":"謇谔：正直敢言；自负：自恃。正直敢言而自许很高。","source":{"text":"性警敏，善属文。及居言路，謇谔自负。","book":"《明史·夏言传》"},"usage":"作谓语、定语；用于书面语"},{"id":40864,"word":"謏文浅说","pinyin":"xiǎo wén qiǎn shuō","abbr":"xwqs","explanation":"謏闻：小有名声。小有名声，学识浅陋。","source":{"text":"凡我同志，庶几于此者，要在细求真诀，务以师授，不可以謏闻浅说，多言或中之义所希企及矣。","book":"宋·张君房《云笈七签》卷七十"}},{"id":40865,"word":"謏言謏说","pinyin":"xiǎo yán xiǎo shuō","abbr":"xyxs","explanation":"謏：小。指不值得重视的言论或指流言蜚语。","source":{"text":"下至謏言謏说，巷议街谈，苟足以资记注而广多闻，要未必为三长之士所尽斥。","book":"清·吴骞《拜经楼诗话》"},"similar":["流言蜚语"],"usage":"作宾语、定语；用于书面语"},{"id":40866,"word":"謏闻之陋","pinyin":"xiǎo wén zhī lòu","abbr":"xwzl","explanation":"謏闻：小有名声。仅有小小的名声，很浅陋。","source":{"text":"数年之后，士类濯磨，必以通经学古为高，脱去謏闻之陋。","book":"《明史·王鏊传》"},"usage":"作宾语；用于书面语"},{"id":40867,"word":"謏闻浅说","pinyin":"xiǎo wén qiǎn shuō","abbr":"xwqs","explanation":"謏闻：小有名声。小有名声，学识浅陋。","source":{"text":"凡我同志，庶几于此者，要在细求真诀，务以师授，不可謏闻浅说，多言或中之义所希企及矣。","book":"宋·张君房《云笈七签》第70卷"},"usage":"作谓语、宾语；用于书面语"},{"id":40868,"word":"謷牙诘屈","pinyin":"áo yá jié qū","abbr":"ayjq","explanation":"同“诘屈聱牙”。謷，通“聱”。诘屈：同“佶屈”，曲折，引申为不顺畅；謷牙：读起来拗口、别扭。形容文字晦涩艰深，难懂难读。","source":{"text":"周浩殷盘，佶屈聱牙。","book":"语出唐·韩愈《进学解》"},"example":{"text":"我今赠君亦无物，但有～村田诗。","book":"元·戴元表《剡源集·寿陈贵白》"}},{"id":40869,"word":"警心涤虑","pinyin":"jǐng xīn dí lǜ","abbr":"jxdl","explanation":"警觉内心，消除杂念。","source":{"text":"至于紧要员缺，特令会同推举，原期得人，亦欲令被举者警心涤虑。恐至累及举者，而贪黩匪类，往往败露。","book":"《清史稿·明珠传》"},"usage":"作谓语；用于人的心理"},{"id":40870,"word":"警愦觉聋","pinyin":"jǐng kuì jué lóng","abbr":"jkjl","explanation":"发出很大的声音，使昏聩的人觉醒，耳聋的人感知。比喻用语言文字等唤醒糊涂麻木的人。","source":{"text":"贤士大夫主持风教，固宜默握其权，时与厘定，以为警愦觉聋之助，初非徒娱心适志已也。","book":"陈去病《论戏剧之有益》"},"similar":["震耳发愦"],"usage":"作谓语、定语；指唤醒糊涂麻木"},{"id":40871,"word":"计上心头","pinyin":"jì shàng xīn tóu","abbr":"jsxt","explanation":"心里突然有了计策。同“计上心来”。","source":{"text":"计上心头，暗令家童私问候。","book":"元·张氏《青衲袄·偷期》"},"example":{"text":"他顿时～，决定曲线救国。"},"similar":["计上心来"],"usage":"作谓语；指计谋涌上心头"},{"id":40872,"word":"计上心来","pinyin":"jì shàng xīn lái","abbr":"jsxl","explanation":"计：计策、计谋。心里突然有了计策。","source":{"text":"眉头一纵，计上心来。","book":"元·马致远《汉宫秋》第一折"},"example":{"text":"因一沉思，～，故作失手，将那一盏油汪汪的蜡烛，向宝玉脸上只一推。","book":"清·曹雪芹《红楼梦》第25回"},"similar":["计上心头"],"usage":"作谓语；指计谋涌上心头"},{"id":40873,"word":"计不反顾","pinyin":"jì bù fǎn gù","abbr":"jbfg","explanation":"指不作回头、后退的打算。同“计无返顾”。","source":{"text":"当其慷慨发言，计不反顾时，岂知有今日哉！","book":"明·范景文《恤用建储被废诸臣缘由疏》"},"similar":["计不返顾"],"usage":"作谓语；指不打算回头"},{"id":40874,"word":"计不旋跬","pinyin":"jì bù xuán kuǐ","abbr":"jbxk","explanation":"指计谋的实现十分神速。","source":{"text":"陛下举晋阳，天下响应，计不旋跬，大业以成。","book":"《新唐书·孙伏伽传》"},"similar":["计不旋踵"],"usage":"作谓语、定语；用于处事"},{"id":40875,"word":"计不旋踵","pinyin":"jì bù xuán zhǒng","abbr":"jbxz","explanation":"计：计议，打算；旋踵：旋转脚跟。脚跟还未转过来，计议就定了下来。形容在极短的时间内就拿定主意。也比喻行动迅速，毫不犹豫。","source":{"text":"触白刃，冒流矢，议不反顾，计不旋踵，人怀怒心，如报私雠。","book":"汉·司马相如《喻巴蜀檄》"},"example":{"text":"臣非不知事在燃眉，～，而揆之愚衷，参之闻见。","book":"明·萧彦《夷心难测借兵宜慎疏》"},"similar":["计不旋跬"],"usage":"作谓语、定语；用于处事"},{"id":40876,"word":"计不返顾","pinyin":"jì bù fǎn gù","abbr":"jbfg","explanation":"指不作回头、后退的打算。同“计无返顾”。","source":{"text":"愤柄人之嫉，而飘然去，最后慷慨殉城，计不返顾。","book":"明·范景文《〈鹿奉常集〉叙》"},"similar":["计不反顾"],"usage":"作谓语；指不打算回头"},{"id":40877,"word":"计伐称勋","pinyin":"jì fá chēng xūn","abbr":"jfcx","explanation":"指计算、称扬自己的功勋。伐，功勋。","source":{"text":"不以为高，所求者仁；异彼区区，计伐称勋。","book":"宋·叶適《故朝散大夫周先生墓志铭》"},"similar":["计功程劳"],"usage":"作谓语、宾语；用于处事"},{"id":40878,"word":"计出万全","pinyin":"jì chū wàn quán","abbr":"jcwq","explanation":"万全：非常安全周到。形容计划非常稳当周密，决不会发生意外。","source":{"text":"帝王之道，出于万全。","book":"《汉书·晁错传》"},"example":{"text":"不过这种事情，其势已迫，不能～的。","book":"清·刘鹗《老残游记》第十六回"},"similar":["万全之策"],"usage":"作宾语；指谋划万无一失"},{"id":40879,"word":"计出万死","pinyin":"jì chū wàn sǐ","abbr":"jcws","explanation":"指谋划来自必死的决心。","source":{"text":"玄曰：‘不然，彼兵速锐，计出万死。若行遣水军，不足相抗，如有蹉跌，则彼气成而吾事败矣。’","book":"《宋书·武帝纪上》"},"usage":"作谓语、定语；用于处事"},{"id":40880,"word":"计出无奈","pinyin":"jì chū wú nai","abbr":"jcwn","explanation":"主意出于无可奈何。同“计出无聊”。","source":{"text":"小人受公子厚恩，委是舍不得，只是计出无奈。","book":"明·孟称舜《花舫缘》第二出"},"example":{"text":"我这也是～。"},"similar":["计出无聊"],"usage":"作宾语；指没办法的主意"},{"id":40881,"word":"计出无聊","pinyin":"jì chū wú liáo","abbr":"jcwl","explanation":"主意出于无可奈何。","source":{"text":"上复责问吴使者，使者对曰：‘……今王始诈病，及觉，见责急，愈益闭，恐上诛之，计乃无聊。唯上弃之，而与更始。’","book":"西汉·司马迁《史记·吴王濞列传》"},"example":{"text":"～，抑且奈之何哉！","book":"明·鹿善继《催用巡仓御史疏》"},"similar":["计出无奈"],"usage":"作宾语；指主意出于无可奈何"},{"id":40882,"word":"计功受爵","pinyin":"jì gōng shòu jué","abbr":"jgsj","explanation":"衡量功绩而授予爵禄。受，授。","source":{"text":"量能处位，计功受爵，苟所不堪，有殒无从。","book":"三国·魏·曹操《让九锡表》"},"similar":["计功授爵"],"usage":"作谓语、宾语、定语；用于上级对下级"},{"id":40883,"word":"计功受赏","pinyin":"jì gōng shòu shǎng","abbr":"jgss","explanation":"按功劳的大小给于奖赏。同“计功行赏”。受，授。","source":{"text":"其南部斩首获生，计功受赏如常科。","book":"《淮南子·人间训》：“是故忠臣事君也，计功而受赏，不为苟得；积力而受官，不贪爵禄。其所能者，受之勿辞也。”《后汉书·南匈奴传》"},"example":{"text":"长沙、成都，鲁、卫之密，国之亲亲，与明公～，尚不自先。","book":"《晋书·齐王冏传》"},"similar":["按劳取酬"],"usage":"作谓语、宾语；指按劳取酬"},{"id":40884,"word":"计功程劳","pinyin":"jì gōng chéng láo","abbr":"jgcl","explanation":"指计算功劳。","source":{"text":"人臣自靖之义，若铢铢两两，计功程劳，以责望于上，似非所谓怀仁义以事君者也。","book":"明·张居正《答督抚吴环洲言敬事后食之义书》"},"similar":["计伐称勋"],"usage":"作谓语、宾语；用于处事"},{"id":40885,"word":"计功行封","pinyin":"jì gōng xíng fēng","abbr":"jgxf","explanation":"犹言计功行赏。按功劳的大小给于奖赏。","source":{"text":"公蒙犯矢石，躬贯甲胄，攻围陷阵，得济今日。计功行封，事殷未遍。三台纳言不恤王事，尝报稽缓，责不在府。","book":"《晋书·齐王冏传》"},"similar":["计功行赏"],"usage":"作谓语、宾语；按功劳的大小颁发奖赏"},{"id":40886,"word":"计功行赏","pinyin":"jì gōng xíng shǎng","abbr":"jgxs","explanation":"按功劳的大小给于奖赏。","source":{"text":"计功而行赏，程能而授事。","book":"《韩非子·八说》"},"example":{"text":"收拾人马，放炮安营，～。","book":"清·钱彩《说岳全传》第七十八回"},"similar":["论功行赏","按劳计酬"],"usage":"作谓语、宾语；按功劳的大小颁发奖赏"},{"id":40887,"word":"计功补过","pinyin":"jì gōng bǔ guò","abbr":"jgbg","explanation":"计：考定；失：过失。考定一个人的功绩以弥补其过失。","source":{"text":"齐恒先有匡周之功，后有来项之罪，君子计功补过。","book":"汉·荀悦《汉纪·元帝纪》"},"similar":["将功补过"],"usage":"作谓语；指考定他的功绩以弥补其过失"},{"id":40888,"word":"计功谋利","pinyin":"jì gōng móu lì","abbr":"jgml","explanation":"计较功名，谋求私利。","source":{"text":"以其计功谋利之心，而任之以正谊明道之责，譬犹建樛屈之木，而为测景之表，欲其远近浅深度数之不忒也胡得焉！","book":"明·锺士懋《送郑先生之昌国训导序》"},"example":{"text":"区区一念报国赤忠，庶几得以少见矣。实未敢有一毫～之心。","book":"明·张居正《答总宪孙华山书》"},"usage":"作宾语、定语；用于处事"},{"id":40889,"word":"计功量罪","pinyin":"jì gōng liàng zuì","abbr":"jglz","explanation":"指全面衡量其功罪是非。","source":{"text":"考试之法，合其爵禄，并其秩，积其日，陈其实，计功量罪，以多除少，以名定实。","book":"汉·董仲舒《春秋繁露·考功名》"}},{"id":40890,"word":"计劳纳封","pinyin":"jì láo nà fēng","abbr":"jlnf","explanation":"计：考定，计算；纳封：接受封赏。根据付出的劳动而接受封赏。","source":{"text":"此之厚幸，可谓弘矣，岂复得计劳纳封，受赏司勋哉。","book":"《晋书·虞亮传》"},"usage":"作谓语、宾语；用于处事"},{"id":40891,"word":"计勋行赏","pinyin":"jì xūn xíng shǎng","abbr":"jxxs","explanation":"按功劳的大小给于奖赏。同“计功行赏”。","source":{"text":"今计勋行赏，玄龄等有筹谋帷幄，定社稷之功，所以汉之萧何，虽无汗马，指踪推毂，故得功居第一。","book":"《旧唐书·房玄龄传》"},"similar":["计功行赏","计功行封"],"usage":"作谓语、宾语；按功劳的大小颁发奖赏"},{"id":40892,"word":"计合谋从","pinyin":"jì hé móu cóng","abbr":"jhmc","explanation":"指计谋合乎君上之意而被采纳。","source":{"text":"计合谋从，己之图也；勋绩不立，予之辜也。","book":"汉·蔡邕《释诲》"},"similar":["言听计从"],"usage":"作谓语、定语；用于书面语"},{"id":40893,"word":"计将安出","pinyin":"jì jiāng ān chū","abbr":"jjac","explanation":"计：计策，计谋；安：怎么，怎样。如何制定计谋呢？","source":{"text":"沛公喜，赐郦生食，问曰：‘计将安出？’","book":"《史记·郦生陆贾列传》"},"example":{"text":"～？”（《晋书·应詹传》","book":"及敦作逆，明帝问詹"},"usage":"作状语；用于询问"},{"id":40894,"word":"计尽力穷","pinyin":"jì jìn lì qióng","abbr":"jjlq","explanation":"穷：尽。计谋、力量都用尽了。","source":{"text":"齐人历年赴救，丧败而反，内离外叛，计尽力穷。","book":"《周书·韦孝宽传》"},"example":{"text":"太祖地狭兵少，惧不当敌，～。","book":"唐·无名氏《广古今五行记》"},"similar":["计穷力竭"],"usage":"作谓语、补语、定语、状语；指无计可施"},{"id":40895,"word":"计斗负才","pinyin":"jì dòu fù cái","abbr":"jdfc","explanation":"比喻才高。","source":{"text":"相传南朝宋谢灵运曾称：“天下才共一石，曹子建独占八斗，我得一斗，天下共分一斗。”见宋·无名氏《释常谈·八斗之才》。"},"example":{"text":"伏以员外断籯积学，～；龟镜词林，梯航陆海。","book":"唐·黄滔《启卢员外浔》"},"similar":["才高八斗"],"usage":"作谓语、定语；用于书面语"},{"id":40896,"word":"计无付之","pinyin":"jì wú fǔ zhī","abbr":"jwfz","explanation":"再没有别的办法可想，不得不这样。","source":{"text":"夫婢妾贱人感慨而自杀者，非能勇也，其计画无复之耳。","book":"《史记·季布栾布列传》"}},{"id":40897,"word":"计无复之","pinyin":"jì wú fù zhī","abbr":"jwfz","explanation":"指再无别的办法可想，不得不这样。","source":{"text":"夫婢妾贱人感慨而自杀者，非能勇也，其计画无复之耳。","book":"西汉·司马迁《史记·季布栾布列传论》"},"example":{"text":"从来际逆境者，其情不一，有～。","book":"清·沈德潜《与张承夫书》"},"usage":"作宾语；指再无别的办法可想，不得不这样"},{"id":40898,"word":"计无所之","pinyin":"jì wú suǒ zhī","abbr":"jwsz","explanation":"犹言计无所出。想不出什么办法。","source":{"text":"子仙等困蹙，计无所之，乞输郢城，身还就景。","book":"《梁书·王僧辩传》"},"similar":["计无所出","计无由出"],"usage":"作谓语、定语；指想不出什么办法"},{"id":40899,"word":"计无所出","pinyin":"jì wú suǒ chū","abbr":"jwsc","explanation":"计：计策，办法。想不出什么办法。","source":{"text":"后主使群臣会议，计无所出。","book":"《三国志·蜀志·谯周传》"},"example":{"text":"众人～，只得走转来，把卢生光景说了一遍。","book":"明·凌濛初《初刻拍案惊奇》卷五"},"similar":["无计可施","走投无路"],"usage":"作谓语、定语；指想不出什么办法"},{"id":40900,"word":"计无所施","pinyin":"jì wú suǒ shī","abbr":"jwss","explanation":"计：计策；施：施展。再也没有可施展的计谋了。","source":{"text":"因为田承嗣所縻，曾因讨叛，飞矢中肩。左右与之拔箭，而镞留于骨……曹进痛楚，计无所施。","book":"宋·李昉《太平广记》"},"example":{"text":"门外故有深渊，遂以石系尸沉其中，王觅女不得，～。","book":"清·蒲松龄《聊斋志异·博兴女》"},"similar":["计无所出"],"usage":"作谓语；指什么办法也没有"},{"id":40901,"word":"计无由出","pinyin":"jì wú yóu chū","abbr":"jwyc","explanation":"想不出什么办法。同“计无所出”。","source":{"text":"苻坚为慕容冲所袭，坚驰騧马，堕而落涧，追兵几及，计无由出。马即踟蹰临涧，垂控与坚，坚不能及。马又跪而授焉，坚攀之，得登岸而走。","book":"《太平御览》卷六九引《异苑》"},"similar":["计无所之","计无所出"],"usage":"作谓语、定语；指想不出什么办法","story":["晋朝时期，前秦王苻坚被慕容冲的军队袭击时，苻坚乘坐黑马在战斗中不幸堕入深渊，慕容冲的追兵马上就要来到，苻坚此时计无由出。这时黑马走近深渊，低头来拉苻坚，苻坚不能抓到，黑马跪地伸长脖子，苻坚终于攀沿而上，得以逃走"]},{"id":40902,"word":"计无返顾","pinyin":"jì wú fǎn gù","abbr":"jwfg","explanation":"指不作回头、后退的打算。","source":{"text":"乃门下遂跃马东归，计无返顾，岂不超然尘壒之表哉？","book":"明·赵南星《答蔡闻吾书》"},"usage":"作谓语；指不打算回头"},{"id":40903,"word":"计日以俟","pinyin":"jì rì yǐ sì","abbr":"jrys","explanation":"数着日子等待。极言盼望之殷切。","source":{"text":"前者村仆还，承书约在月末相过，计日以俟，未遂一见，岂以雨故愆期邪？","book":"明·方孝孺《与邵真斋书》之六"},"similar":["计日以期","计日而俟"],"usage":"作谓语、状语；形容为时不远"},{"id":40904,"word":"计日以待","pinyin":"jì rì yǐ dài","abbr":"jryd","explanation":"可以数着日子等待。形容为时不远。同“计日而待”。","source":{"text":"侍御为两京学使者，即不复外补，坐致九列，惟计日以待耳。","book":"明·赵南星《贺贾元礼食廪序》"},"similar":["计日而待"],"usage":"作谓语、状语；形容为时不远"},{"id":40905,"word":"计日以期","pinyin":"jì rì yǐ qī","abbr":"jryq","explanation":"可以数着日子等待。形容为时不远。同“计日而待”。","source":{"text":"望焉而羡，至焉则厌，计日以期，涉艰不倦，嗜荣者之情与！","book":"明·徐祯稷《耻言》一"},"similar":["计日以待","计日可待","计日可期"],"opposite":["遥遥无期"],"usage":"作谓语、状语；形容为时不远"},{"id":40906,"word":"计日可待","pinyin":"jì rì kě dài","abbr":"jrkd","explanation":"指为期不远。","source":{"text":"夫以万全之力，视此直狐兔耳。其束身系颈，计日可待也。","book":"明·海瑞《治黎策》"},"example":{"text":"现今满政府之颠覆，～。","book":"曹亚伯《通告城镇乡自治职员电》"},"similar":["指日可待","计日可期"],"usage":"作谓语、宾语；指为期不远"},{"id":40907,"word":"计日可期","pinyin":"jì rì kě qī","abbr":"jrkq","explanation":"可以数着日子等待。形容为时不远。同“计日而待”。","source":{"text":"耀天威而尽殪，昭文德以即叙，止戈之庆，计日可期。","book":"唐·权德舆《中书门下贺剑南西川节度使大破蕃寇状》"},"similar":["计日以待","计日以期","计日可待"],"usage":"作谓语、状语；形容为时不远"},{"id":40908,"word":"计日奏功","pinyin":"jì rì zòu gōng","abbr":"jrzg","explanation":"可以数日子看到功效。谓成功极快。","source":{"text":"自兴师以来，未有今日之捷，此乃陛下洪福齐天，得此大帅，可计日奏功，以安社稷者也，特具本齐奏。","book":"明·许仲琳《封神演义》第八十九回"},"similar":["指日可待","胜利在望"],"opposite":["遥遥无期"],"usage":"作谓语、宾语；形容很快成功"},{"id":40909,"word":"计日指期","pinyin":"jì rì zhǐ qī","abbr":"jrzq","explanation":"指计数天数，以估定行程和到达期。","source":{"text":"曾无亭堠，莫审涂程，跂履者计日指期，沉浮者占风定信。","book":"唐·崔致远《补安南录异图记》"},"usage":"作谓语、状语；指估计日期"},{"id":40910,"word":"计日程功","pinyin":"jì rì chéng gōng","abbr":"jrcg","explanation":"计：计算；程：估量，考核；功：成效。工作进度或成效可以按日计算。形容进展快，有把握按时完成。","source":{"text":"程功积事，惟贤以尽达之。","book":"《礼记·儒行》"},"example":{"text":"法治国虽进不必骤，而得寸进尺，～。","book":"清·梁启超《中国法理学发达史论》"},"similar":["指日可待","企足而待"],"opposite":["旷日持久","遥遥无期"],"usage":"作谓语、宾语、定语；形容工作等马上大功告"},{"id":40911,"word":"计日而俟","pinyin":"jì rì ér sì","abbr":"jres","explanation":"可以数着日子等待。形容为时不远。同“计日而待”。","source":{"text":"事终无成，败亡可计日而俟。","book":"晋·常璩《华阳国志·大同志》"},"similar":["计日以俟"],"usage":"作谓语、状语；形容为时不远"},{"id":40912,"word":"计日而待","pinyin":"jì rì ér dài","abbr":"jred","explanation":"计：计算；待：等待。可以数着日子等待。形容为时不远。","source":{"text":"则汉室之隆，可计日而待也。","book":"三国·蜀·诸葛亮《出师表》"},"example":{"text":"高考的日子已经可以～了，大家要认真复习。"},"similar":["指日可待","计日以待"],"usage":"作谓语、状语；形容为时不远"},{"id":40913,"word":"计深虑远","pinyin":"jì shēng lǜ yuǎn","abbr":"jsly","explanation":"计：计谋；虑：考虑。计谋想得很深远。","source":{"text":"计深虑远，急国家之难，而乐尽人臣之首也。","book":"汉·司马相如《喻巴蜀檄》"},"example":{"text":"然而～，非见王师则未肯轻发。","book":"宋·辛弃疾《美芹十论·详战》"},"similar":["深谋远虑"],"usage":"作谓语、宾语；指计谋周密"},{"id":40914,"word":"计然之术","pinyin":"jì rán zhī shù","abbr":"jrzs","explanation":"泛指生财致富之道。同“计然之策”。"},{"id":40915,"word":"计然之策","pinyin":"jì rán zhī cè","abbr":"jrzc","explanation":"泛指生财致富之道。","source":{"text":"相传越王勾践困于会稽之上，用计然之策，修之十年而国富；范蠡既雪会稽之耻，用计然之策于家而富至巨万。所谓计然之策，主要指“六岁穰六岁旱”的农业循环学说，农末俱利的平籴论，以及物价观测、贵出贱取等经商致富的“积着之理”。"}},{"id":40916,"word":"计研心算","pinyin":"jì yán xīn suàn","abbr":"jyxs","explanation":"指精心研究计算。","source":{"text":"继丁大故，生产益落，府君得计研心算以治产，累岁遂致饶衍。","book":"宋·范浚《张府君墓志铭》"},"usage":"作谓语、宾语；用于书面语"},{"id":40917,"word":"计穷力尽","pinyin":"jì qióng lì jìn","abbr":"jqlj","explanation":"计：计策；穷、屈：尽，竭。计策、力量都用完了。","source":{"text":"郭默清夷、晋熙附义，计穷力屈，反杀后主。","book":"南朝·梁·萧绎《驰檄告四方》"},"example":{"text":"臣已～，只好整兵与他决一死战。","book":"清·钱彩《说岳全传》第四十二回"},"similar":["计穷力屈","计穷力诎","计穷力竭"],"usage":"作谓语、定语；指计策和力量都用完"},{"id":40918,"word":"计穷力屈","pinyin":"jì qióng lì qū","abbr":"jqlq","explanation":"计：计策；穷、屈：尽，竭。计策、力量都用完了。","source":{"text":"郭默清夷，晋熙附义，计穷力屈，反杀后主。","book":"《梁书·元帝纪》"},"example":{"text":"人多言安于贫贱，其实只是～，才短不宜营画耳！","book":"宋·张载《经学理窟·气质》"},"similar":["计穷力尽"],"usage":"作谓语、定语；指计策和力量都用完"},{"id":40919,"word":"计穷力极","pinyin":"jì qióng lì jí","abbr":"jqlj","explanation":"计谋、力量都用尽了。同“计穷力竭”。","source":{"text":"妓曰：‘然则君将何往？’东谓：‘计穷力极，终还家，功名事终直之耳。’","book":"明·冯梦龙《情史类略·东御史妓》"},"example":{"text":"彼～，必入内峒坚守，汝等便分队攻击，以休军力。","book":"清·夏敬渠《野叟曝言》第一百二回"},"similar":["计穷力尽","计穷力诎","计穷力竭"],"usage":"作谓语、定语；指计策和力量都用完"},{"id":40920,"word":"计穷力竭","pinyin":"jì qióng lì jié","abbr":"jqlj","explanation":"穷、竭：尽。计谋、力量都用尽了。","source":{"text":"郭默清夷，晋熙附义，计穷力屈，反杀后主。","book":"南朝·梁·萧绎《驰檄告四方》"},"example":{"text":"妖王笑道：“那猴儿～，无处求人，断然是送命来也。”","book":"明·吴承恩《西游记》第六十六回"},"similar":["黔驴技穷","计穷力尽"],"usage":"作谓语、定语；指计谋和力量都用尽了"},{"id":40921,"word":"计穷力诎","pinyin":"jì qióng lì qū","abbr":"jqlq","explanation":"计策、力量都用完了。见“计穷力屈”。","source":{"text":"臣今日之请，非但司辽饷言辽饷，实在新库言新库，计穷力诎，不得不出于此。","book":"明·鹿善继《请发帑疏》"},"similar":["计穷力尽","计穷力屈","计穷力竭"],"usage":"作谓语、定语；指计策和力量都用完"},{"id":40922,"word":"计穷势蹙","pinyin":"jì qióng shì cù","abbr":"jqsc","explanation":"无计可施，情势紧迫。","source":{"text":"深既不能制乱，反为乱众所制，军中乏粮，人自相食，计穷势蹙，仓黄退走，土兵随击，以致大败。","book":"《元史·陈天祥传》"},"example":{"text":"但恐莽～，又与其党与造饰言语，迷乱天下，曲释己恶，或冀见兔。","book":"明·吴应箕《为翟义讨王莽檄》"},"similar":["计穷势迫"],"usage":"作谓语、定语；指局势很严峻"},{"id":40923,"word":"计穷势迫","pinyin":"jì qióng shì pò","abbr":"jqsp","explanation":"无计可施，情势紧迫。同“计穷势蹙”。","source":{"text":"计穷势迫，愿投充军，原其本情，岂所得已。","book":"明·蹇义《上言十事疏》"},"similar":["计穷势蹙"],"usage":"作谓语、定语；指局势很严峻"},{"id":40924,"word":"计穷智极","pinyin":"jì qióng zhì jí","abbr":"jqzj","explanation":"指计虑穷尽。见“计穷虑极”。","source":{"text":"及其计穷智极，几微仓卒之际，盖有赪面泚颡，而不能自己者。","book":"明·李东阳《冰玉斋记》"},"similar":["计穷虑极"],"usage":"作谓语、定语；指无计可施"},{"id":40925,"word":"计穷智短","pinyin":"jì qióng zhì duǎn","abbr":"jqzd","explanation":"计：计谋；穷：尽；智：智谋；短：缺少。计策用完了，才智也不够用了。形容已经想不出什么办法了。","source":{"text":"我为那贺家姐姐，烦恼的小生计穷智短了。","book":"元·无名氏《百花亭》"},"similar":["计穷智尽","计穷虑尽"],"usage":"作谓语、定语；用于处事"},{"id":40926,"word":"计穷虑尽","pinyin":"jì qióng lǜ jìn","abbr":"jqlj","explanation":"指计虑穷尽。同“计穷虑极”。","source":{"text":"计穷虑尽，求来连和，和不时，心中忧戚。","book":"三国·魏·缪袭《定武功》诗"},"similar":["计穷虑极","计穷智极"],"usage":"作谓语、定语；用于处事"},{"id":40927,"word":"计穷虑极","pinyin":"jì qióng lǜ jí","abbr":"jqlj","explanation":"指计虑穷尽。","source":{"text":"始与豫州观于长阪，豫州之众不当一校，计穷虑极，志势摧弱，图欲远窜，望不及此。","book":"《三国志·吴志·鲁肃传》：“备遂割湘水为界，于是罢军”裴松之注引三国·吴·韦昭《吴书》"},"example":{"text":"君侯始与皇叔同败于长，～，将欲远窜。","book":"明·罗贯中《三国演义》第六十六回"},"similar":["计穷虑尽","计穷智极"],"usage":"作谓语、定语；用于处事"},{"id":40928,"word":"计穷途拙","pinyin":"jì qióng tú zhuō","abbr":"jqtz","explanation":"指无计可施，无路可走。","source":{"text":"相公，休怯。你病人凋梧，贪依衰草，一时计穷途拙，且自藏珍。","book":"明·孙梅锡《琴心记·相如倦游》"},"usage":"作谓语、定语；指无计可施"},{"id":40929,"word":"计绌方匮","pinyin":"jì chù fāng kuì","abbr":"jcfk","explanation":"计谋不足，方略匮竭。","source":{"text":"平贼之要领未得，计绌方匮，又必有变，纵不横决，凋丧可立而待也。","book":"王闿运《与曾侍郎言兵事书》"},"usage":"作谓语、定语；用于处事"},{"id":40930,"word":"计获事足","pinyin":"jì huò shì zú","abbr":"jhsz","explanation":"犹言如愿以偿。指愿望实现。","source":{"text":"唯至互市，乃来靡服。苟欲中国珍货，计获事足，旋踵为害，非为畏威怀德。","book":"《后汉书·应劭传》"},"similar":["如愿以偿"],"usage":"作谓语、定语；用于处事"},{"id":40931,"word":"计行虑义","pinyin":"jì xíng lǜ yì","abbr":"jxly","explanation":"计：计策。行：实施。虑：考虑。义：道义。实施计策前要考虑到是否合乎道义。","source":{"text":"君子计行虑义，小人计行其利。","book":"《吕氏春秋·慎行》"},"usage":"作谓语、宾语；用于书面语"},{"id":40932,"word":"计行言听","pinyin":"jì xíng yán tīng","abbr":"jxyt","explanation":"行其计，听其言。形容十分信任。","source":{"text":"高琪止欲以重兵屯驻南京以自固，州郡残破不复恤也。宣宗惑之，计行言听，终以自毙。","book":"《金史·术虎高琪传》"},"similar":["言听计从"],"usage":"作谓语、定语、状语；用于处事"},{"id":40933,"word":"计较锱铢","pinyin":"jì jiào zī zhū","abbr":"jjzz","explanation":"指为争取财利而斤斤较量，连极微小的数量也不放过。","source":{"text":"近世嫁娶，遂有卖女纳财，买妇输绢，比量父祖，计较锱铢，责多还少，市井无异。","book":"北齐·颜之推《颜氏家训·治家》"},"example":{"text":"游船妓馆尤得利，略无～意。","book":"清·郏谈《卖花船》诗"},"similar":["斤斤计较"],"usage":"作谓语、定语；用于处事"},{"id":40934,"word":"计过自讼","pinyin":"jì guò zì sòng","abbr":"jgzs","explanation":"检讨自己的过错而内心自责。","source":{"text":"吾未能见其过而内自讼者也。","book":"《论语·公冶长》"},"example":{"text":"芬丰神玉立，负气峻厉，端居竟日无倦容。夜则～。","book":"《明史·舒芬传》"},"usage":"作谓语；指检讨自己的过错而内心自责"},{"id":40935,"word":"认仇作父","pinyin":"rèn chóu zuò fù","abbr":"rczf","explanation":"把仇敌当作父亲。比喻甘心卖身投靠敌人。同“认贼作父”。","source":{"text":"朋友，虽然在我们之中，有汉奸，有傀儡，有卖国贼，他们认仇作父，为虎作伥，但他们那班可耻的人，终竟是少数。","book":"方志敏《可爱的中国》"},"example":{"text":"我不想让你去～。"},"similar":["认贼作父","认敌作父"],"usage":"作谓语、定语、状语；指甘心投靠敌人"},{"id":40936,"word":"认奴作郎","pinyin":"rèn nú zuò láng","abbr":"rnzl","explanation":"指颠三倒四，糊里糊涂。","source":{"text":"师曰：‘城中不颠倒，因什么认奴作郎？’","book":"《景德传灯录·良价禅师》"},"example":{"text":"师曰：‘礼拜一任礼拜，不得～。’","book":"《五灯会元·南泉愿禅师法嗣·香严义端禅师》"},"usage":"作谓语、宾语；指人糊涂"},{"id":40937,"word":"认奴作郞","pinyin":"rèn nú zuò láng","abbr":"rnzl","explanation":"形容昏馈糊涂。","source":{"text":"若不颠倒，因什么认奴作郎。","book":"宋·释道原《景德传灯录·良价禅师》"},"example":{"text":"礼拜一任礼拜，不得～。","book":"宋·释普济《五灯会元》第四卷"}},{"id":40938,"word":"认奴作鄌","pinyin":"rèn nú zuò láng","abbr":"rnzl","explanation":"形容昏馈糊涂。"},{"id":40939,"word":"认妄为真","pinyin":"rèn wàng wéi zhēn","abbr":"rwwz","explanation":"佛教用语。把虚妄当成真实。","source":{"text":"认妄为真，虽真亦妄。","book":"《圆觉经》"}},{"id":40940,"word":"认影为头","pinyin":"rèn yǐng wéi tóu","abbr":"rywt","explanation":"佛教语。指认虚作实。","source":{"text":"所以道，从门入者不是家珍，认影为头岂非大错？","book":"《景德传灯录·月轮禅师》"},"usage":"作谓语、宾语；指人糊涂"},{"id":40941,"word":"认影迷头","pinyin":"rèn yǐng mí tóu","abbr":"rymt","explanation":"佛家语。形容非常糊涂。","source":{"text":"如演若多，迷头认影。","book":"《大佛顶如来密因修证了义诸菩萨万行首楞言经》"},"example":{"text":"不是家珍，～，岂非大错。","book":"宋·释普济《五灯会元》卷六"},"similar":["迷头认影"],"usage":"作谓语、定语；指人糊涂"},{"id":40942,"word":"认敌为友","pinyin":"rèn dí wéi yǒu","abbr":"rdwy","explanation":"认敌人作为朋友。指人的思想糊涂，不分敌友。","example":{"text":"你好歹不分，～，卖身投靠，害死我同胞，这简直就是瞎了眼，既然瞎了眼，就该挖掉。","book":"池莉《预谋杀人》十一"}},{"id":40943,"word":"认敌作父","pinyin":"rèn dí zuò fù","abbr":"rdzf","explanation":"把仇敌当作父亲。比喻甘心卖身投靠敌人。同“认贼作父”。","source":{"text":"同时也不能不想那些认敌作父、卖国求荣的大汉奸。","book":"蒲韧《二千年间》八"},"similar":["认仇作父","认贼作父"],"usage":"作谓语、定语、状语；指甘心投靠敌人"},{"id":40944,"word":"认死扣儿","pinyin":"rèn sǐ kòu ér","abbr":"rske","explanation":"坚定地认为，固执己见。","example":{"text":"她一～时，我们都害怕她。"},"similar":["固执己见","认死理儿"],"usage":"作谓语、定语、宾语；用于口语"},{"id":40945,"word":"认死理儿","pinyin":"rèn sǐ lǐ ér","abbr":"rsle","explanation":"坚持某种道理或理由。","source":{"text":"不准备变，岿然不动认死理儿不管山下旌旗是否在望。","book":"王朔《一点正经没有》"},"example":{"text":"她最大的缺点就是～。"},"similar":["认死理","认死扣儿"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40946,"word":"认祖归宗","pinyin":"rèn zǔ guī zōng","abbr":"rzgz","explanation":"①寻认祖先，并归还本宗。②喻指回归故土。","source":{"text":"我只为认祖归宗，迟眠早起，登山涉水，甫能勾到庭帏。","book":"元·无名氏《合同文字》第四折"},"example":{"text":"刘绍棠《芳年》：“‘爸爸，咱们回老家去看看吧！’丽苔兴致勃勃地说，‘您返朴归真，我～。’”"},"usage":"作谓语、宾语、定语；用于处事"},{"id":40947,"word":"认贼为子","pinyin":"rèn zéi wéi zǐ","abbr":"rzwz","explanation":"佛家语，比喻错将妄想认为真实。","source":{"text":"譬如有人，认贼为子，其家财宝终不成就。","book":"《大方广园觉修多罗经》下卷"},"example":{"text":"以断千古之是非，宜指铁为金，～，而不自知其非也。","book":"宋·朱熹《寄陈同甫书》"},"similar":["认贼作子"],"usage":"作谓语、宾语；指把坏人当作亲人"},{"id":40948,"word":"认贼为父","pinyin":"rèn zéi wéi fù","abbr":"rzwf","explanation":"把仇敌当作父亲。比喻甘心卖身投靠敌人。同“认贼作父”。","source":{"text":"先是余家既亡，怅怅无之。大盗更迫我侪，为供奔走。测彼居心，是畜猎犬之技。斯是认贼为父，自残梵裔者，亦复不少。","book":"苏曼殊《遁迹记》"},"example":{"text":"他是那种～的小人。"},"similar":["认贼作父","认仇作父","认敌作父"],"usage":"作谓语、定语、状语；指甘心投靠敌人"},{"id":40949,"word":"认贼作子","pinyin":"rèn zéi zuò zǐ","abbr":"rzzz","explanation":"佛家语，比喻错将妄想认为真实。同“认贼为子”。","source":{"text":"有一等颠倒丧志，投东觅西，失却眼前至宝，这便是认贼作子。","book":"明·徐复祚《一文钱》第三出"},"example":{"text":"不正其名而言其实，紾戾不通，至于如是，徒使人害于名则已耳！乃至指鹿为马，～。","book":"章炳麟《论承用维新二字之荒谬》"},"similar":["认贼为子"],"usage":"作谓语、宾语；指把坏人当作亲人"},{"id":40950,"word":"认贼作父","pinyin":"rèn zéi zuò fù","abbr":"rzzf","explanation":"把仇敌当作父亲。比喻甘心卖身投靠敌人。","source":{"text":"但是偶一念及那一班贪官污吏，人面兽心，处处为虎作伥，人人认贼作父……一个个斩尽杀绝，方泄我心头恨。","book":"清·华伟生《开国奇冤·追悼》"},"example":{"text":"你～！”（华而实《汉衣冠》三","book":"郑成功脸色发白，全然失去了希望，他悲愤地昂起头，一字一音地说"},"similar":["卖身投靠","认敌为友"],"opposite":["泾渭分明"],"usage":"作谓语、定语、状语；指甘心投靠敌人"},{"id":40951,"word":"认鸡作凤","pinyin":"rèn jī zuò fèng","abbr":"rjzf","explanation":"佛教语。指认凡庸为珍贵。","source":{"text":"如楚国愚人认鸡作凤，犹春池小果执石为珠。但任浅近之情，不探深密之旨。","book":"《万善同归集》卷一"},"usage":"作谓语、定语、宾语；用于人的看法"},{"id":40952,"word":"讥而不征","pinyin":"jī ér bù zhēng","abbr":"jebz","explanation":"讥：稽查，查看；征：征税。指在关卡、市场等处只稽查而不征税。","source":{"text":"昔者文王之治岐也，耕者九一，仕者世禄，关市讥而不征。","book":"《孟子·梁惠王下》"}},{"id":40953,"word":"讦以为直","pinyin":"jié yǐ wéi zhí","abbr":"jywz","explanation":"讦：攻击别人短处；直：直率。揭发别人的隐私自认为坦率。形容人品奸诈虚伪。","source":{"text":"恶徼以为知者，恶不孙以为勇者，恶讦以为直者。","book":"春秋·鲁·孔丘《论语·阳货》"},"example":{"text":"吾闻君子不欲加诸人，而恶～者。","book":"唐·韩愈《争臣论》"},"usage":"作宾语、定语；指人的品性"},{"id":40954,"word":"讨价还价","pinyin":"tǎo jià huán jià","abbr":"tjhj","explanation":"讨：索取。买卖东西，卖主要价高，买主给价低，双方要反复争议。也比喻在进行谈判时反复争议，或接受任务时讲条件。","source":{"text":"三巧儿问了他讨价还价，便道：‘真个亏你些儿。’","book":"明·冯梦龙《古今小说》卷一"},"example":{"text":"我们的方针是不拒绝谈判，要求对方完全承认八条，不许～。","book":"毛泽东《在中国共产党第七届中央委员会第二次全体会议上的报告》"},"similar":["斤斤计较"],"opposite":["三言两语","宽宏大量"],"usage":"作谓语、定语；指交易"},{"id":40955,"word":"讨恶剪暴","pinyin":"tǎo è jiǎn bào","abbr":"tejb","explanation":"征伐和消除凶恶残暴的势力。","source":{"text":"夫讨恶剪暴必声其罪，宜先分裂，夺其土地，使士民之心，各知所归。","book":"《三国志·吴志·吴主传》"},"similar":["讨恶翦暴"],"usage":"作谓语、定语；用于书面语"},{"id":40956,"word":"讨恶翦暴","pinyin":"tǎo è jiǎn bào","abbr":"tejb","explanation":"征讨和剪除凶恶残暴的势力。","source":{"text":"夫讨恶翦暴必声其罪，宜先分裂，夺其土地，使土民之心，各知所归。","book":"晋·陈寿《三国志·吴志·吴主传》"},"similar":["讨恶剪暴"],"usage":"作谓语、定语；用于书面语"},{"id":40957,"word":"讨是寻非","pinyin":"tǎo shì xún fēi","abbr":"tsxf","explanation":"挑剔，寻找是非。形容存心找岔子。","source":{"text":"哥嫂每夜巡更不睡，讨是寻非。哥嫂他那里昧己瞒心，料想苍天不负亏。","book":"明·无名氏《白兔记·诉猎》"},"similar":["寻是生非"],"usage":"作谓语、定语、宾语；用于处事"},{"id":40958,"word":"讨流溯源","pinyin":"tǎo liú sù yuán","abbr":"tlsy","explanation":"指深究事物的源流本末。","source":{"text":"余自少读诗，自古作者以逮本朝诸大家，皆欲讨流溯源，穷其旨趣，久之，益知作诗之难。","book":"清·王韬《蘅花馆诗录》自序"},"similar":["追根溯源"],"usage":"作谓语、宾语；用于处事"},{"id":40959,"word":"讨类知原","pinyin":"tǎo lèi zhī yuán","abbr":"tlzy","explanation":"指通过类比而探知渊源。","source":{"text":"稽其典礼，明其行事，令后生得以讨类知原，无忘国故，斯其要也。","book":"章炳麟《与简竹居书》"},"usage":"作谓语、宾语；用于处事"},{"id":40960,"word":"讨逆除暴","pinyin":"tǎo nì chú bào","abbr":"tncb","explanation":"征伐和消除背叛的残暴势力。","source":{"text":"立秋，万物将成，杀气之始，其于王事，杖麾誓众，衅鼓礼神，所以讨逆除暴，成功济务，宁宗庙社稷，致天下之福，不可废也。","book":"《晋书·张轨传》"},"usage":"作谓语、定语；用于处事"},{"id":40961,"word":"让三让再","pinyin":"ràng sān ràng zài","abbr":"rsrz","explanation":"指几次三番地推让。同“让再让三”。","source":{"text":"且各曹长被举之人，亦必须让三让再以副举贤若夔龙之美事，及再三为大众所推乃得受之，以弘让德而镇嚣争焉。","book":"康有为《大同书》辛部第四章"},"similar":["让再让三"],"usage":"作定语、状语；用于处事"},{"id":40962,"word":"让再让三","pinyin":"ràng zài ràng sān","abbr":"rzrs","explanation":"指几次三番地推让。","source":{"text":"群臣劝进，今上悲不自胜，让再让三，仅允监国。","book":"明·史可法《复多尔衮书》"},"example":{"text":"就譬如世兄孝敬老师万金，难道老师也合他～不成？","book":"清·文康《儿女英雄传》第十三回"},"similar":["让三让再"],"usage":"作谓语、定语、状语；用于处事"},{"id":40963,"word":"让枣推梨","pinyin":"ràng zǎo tuī lí","abbr":"rztl","explanation":"小儿推让食物的典故。比喻兄弟友爱。","source":{"text":"年四岁时，每与诸兄共食梨，融辄引小者。","book":"《南史·王泰传》：“年数岁时，祖母集诸孙侄，散枣栗于床。群儿竞之，泰独不取。”《后汉书·孔融传》注引《融家传》"},"example":{"text":"～，长罢欢愉之日。","book":"《南史·梁武陵王传》"},"similar":["让梨推枣"],"usage":"作定语、宾语；指兄弟友爱","story":["南北朝时期，王泰幼年时，祖母给他们分枣子和栗子，他不去参与争抢而是等他们拿完后自己再吃剩下的。汉朝时期的孔融4岁他与兄弟吃梨时，他从不挑大梨吃，而是把大梨让给大人们吃，家人都夸他很懂事"]},{"id":40964,"word":"让礼一寸，得礼一尺","pinyin":"ràng lǐ yī cùn，dé lǐ yī chǐ","abbr":"rlycdlyc","explanation":"比喻以礼相让，事虽微而获益必大。","source":{"text":"里谚曰：‘让礼一寸，得礼一尺。’斯合经之要矣。","book":"语出《太平御览》卷四二四引三国魏曹操《礼让令》"},"example":{"text":"宋·王楙《野客丛书·俗语有所自》：“谓‘让一寸，饶一尺’，则曹氏《令》曰：‘～’。”"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":40965,"word":"让逸竞劳","pinyin":"ràng yì jìng láo","abbr":"ryjl","explanation":"指安逸之事互相谦让，劳苦之事互相争抢。","source":{"text":"昆弟同居四十余载，闺门和睦，让逸竞劳。","book":"《魏书·孝感传·吴悉达》"},"usage":"作谓语、定语；用于处事"},{"id":40966,"word":"讪牙闲嗑","pinyin":"shàn yá xián kē","abbr":"syxk","explanation":"指闲得无聊，磨牙斗嘴以为笑乐。","source":{"text":"挺王留讪牙闲嗑，李大公信口开合。","book":"元·薛昂夫《端正好·高隐》套曲"},"example":{"text":"请别在人后～了"},"similar":["嗑牙料嘴"],"usage":"作谓语、定语、宾语；用于口语"},{"id":40967,"word":"讪皮讪脸","pinyin":"shàn pí shàn liǎn","abbr":"spsl","explanation":"指嘻皮笑脸。","source":{"text":"若是员外不在跟前，他便合他姑妈讪皮讪脸，百般的央告，甚至屈膝。","book":"《三侠五义》第三五回"},"similar":["嬉皮笑脸"],"usage":"作谓语、定语；用于书面语"},{"id":40968,"word":"讫情尽意","pinyin":"qì qíng jìn yì","abbr":"qqjy","explanation":"指尽量满足自己的情感和心意，不加控制。","source":{"text":"帝王之怒，不宜讫情尽意。","book":"晋·陈寿《三国志·吴志·诸葛恪传》"},"usage":"作谓语、宾语；指尽情满足"},{"id":40969,"word":"讬孤寄命","pinyin":"xíng gū jì mìng","abbr":"tgjm","explanation":"指受遗命托付辅助幼君；或君主居丧时，受命摄理朝政。亦泛指付托以常之重任。","source":{"text":"可以讬六尺之孤者，谓可委讬以幼少之君也。若周公、霍光也；可以寄百里之命者，谓君在亮阴，可当国摄君之政令也。","book":"《论语·泰伯》：“可以讬六尺之孤，可以寄百里之命。”邢昺疏"}},{"id":40970,"word":"训兵秣马","pinyin":"xùn bīng mò mǎ","abbr":"xbmm","explanation":"训练好士兵，喂饱战马。指作好战斗准备。","source":{"text":"臣自奉诏总平凉之师，责重忧深，不遑启处。训兵秣民，唯思竭力。","book":"《周书·文帝纪》"},"example":{"text":"且金人新造之势，难与争锋。宜～，保疆而已，俟十年乃可议战。","book":"清·毕沅《续资治通鉴》卷一○八"},"similar":["厉兵秣马"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":40971,"word":"训格之言","pinyin":"xùn gé zhī yán","abbr":"xgzy","explanation":"指可以奉为行为准则的教诲之言。","source":{"text":"所谓庸人者，心不存慎终之规，口不吐训格之言。","book":"《孔子家语·五仪》"},"example":{"text":"明·赵南星《明敕赠吏科都给事中继川魏公碑》：“夫～， 可剿袭也；中绳之行，可假托也。”"},"usage":"作主语、宾语；用于书面语"},{"id":40972,"word":"训练有方","pinyin":"xùn liàn yǒu fāng","abbr":"xlyf","explanation":"方：方法。训练很有办法。也形容部队的训练素质很好。","source":{"text":"浚欲慰人望，下令以富平之役，泾原军马出力最多，既却退之后，先自聚集，皆缘前帅曲端训练有方。","book":"《宋史·张滩传》"},"example":{"text":"那贾夫人才智超群，他的兵马～，尽可用得。","book":"清·俞万春《荡寇志》第一百二十二回"}},{"id":40973,"word":"训练有素","pinyin":"xùn liàn yǒu sù","abbr":"xlys","explanation":"素：平素，向来。平时一直有严格的训练。","source":{"text":"显亦为当时名将，所至有功，故知训练有素。","book":"清·赵翼《二十二史札记·卷三十四·将帅家丁》"},"example":{"text":"如此整齐严密，虽极迅猛激烈而丝毫不乱，足见～，名不虚传。","book":"姚雪垠《李自成》第二卷第四十七章"},"similar":["行家里手","挥洒自如"],"opposite":["半路出家"],"usage":"作宾语、定语；指经常有训练"},{"id":40974,"word":"议不反顾","pinyin":"yì bù fǎn gù","abbr":"ybfg","explanation":"指为了正义奋勇向前，不回头、后退。议，通“义”。","source":{"text":"《文选·司马相如》：“触白刃，冒流矢，议不反顾，计不旋踵，人怀怒心，如报私雠。”《史记·司马相如列传》作“义不反顾”。"},"example":{"text":"方是时，阁下与于公无积累之欢，特为国是起见，重悯江淮亿兆夷人无辜而斩艾，迫于至诚，～。","book":"清冯景《与乔侍读书》"},"similar":["义不反顾"],"usage":"作谓语、定语、状语；用于书面语"},{"id":40975,"word":"议事日程","pinyin":"yì shì rì chéng","abbr":"ysrc","explanation":"议事：讨论或办理事情；日程：时间进度表。在计划之内的讨论、办理事情的日期。","source":{"text":"……建立根据地的任务，放在自己的议事日程上，把它作为战略任务执行起来。","book":"毛泽东《抗日游击战争的战略问题》"},"example":{"text":"环境保护已经提到各级领导的～上来了。"},"usage":"作宾语；指计划内的事情"},{"id":40976,"word":"议论纷纭","pinyin":"yì lùn fēn yún","abbr":"ylfy","explanation":"形容意见不一，议论很多。","source":{"text":"是以远近狐疑，议论纷错者也。","book":"语出《后汉书·袁绍传》"},"example":{"text":"东汉之末，礼乐萧条，虽东观石渠～，无济于事。","book":"《通志乐府总序》"},"similar":["议论纷错"],"usage":"作谓语、定语；用于书面语"},{"id":40977,"word":"议论纷纷","pinyin":"yì lùn fēn fēn","abbr":"ylff","explanation":"形容意见不一，议论很多。","source":{"text":"是以远近狐疑，议论纷错者也。","book":"语出《后汉书·袁绍传》"},"example":{"text":"他俩现在越发脱离群众，每天下午跑到宝塔下谈天，群众～。","book":"刘绍棠《西苑草》"},"similar":["争长论短","众说纷纭","说长道短"],"opposite":["哑口无言","万马齐喑","噤若寒蝉"],"usage":"作谓语、主语、定语；指意见不统一"},{"id":40978,"word":"议论纷错","pinyin":"yì lùn fēn cuò","abbr":"ylfc","explanation":"形容意见不一，议论很多。","source":{"text":"是以远近狐疑，议论纷错者也。","book":"《后汉书·袁绍传》"},"similar":["议论纷纭","议论纷纷"],"usage":"作谓语、定语；用于书面语"},{"id":40979,"word":"议论英发","pinyin":"yì lùn yīng fā","abbr":"ylyf","explanation":"指崇论弘议，才华横溢。","source":{"text":"时会下龙象杂遝，而师议论英发，常倾四座，声名藉甚。","book":"《续传灯录·洪英禅师》"},"example":{"text":"大学士李贤曰：“高庙看书，～，每儒臣进讲，必有辩说。”","book":"明黄佐《翰林记·御前讲论经文》"},"usage":"作谓语、定语；用于书面语"},{"id":40980,"word":"议论蜂起","pinyin":"yì lùn fēng qǐ","abbr":"ylfq","explanation":"议论很多，像一窝蜂飞起一样。形容意见不一致，有很多种说法。","source":{"text":"秘书与叔昌子约书，乃言‘诸贤死后，议论蜂起’，有独力不能支之意。","book":"宋·陈亮《又乙巳春书之一》"},"example":{"text":"且六万之众，千里袭人，一举失利，议论蜂起，乌能待三？","book":"《明史·翁万达传》"},"similar":["异议蜂起"],"usage":"作谓语、定语；用于书面语"},{"id":40981,"word":"议论风发","pinyin":"yì lùn fēng fā","abbr":"ylff","explanation":"形容谈论广泛、生动而又风趣。","source":{"text":"平居议论风发，品藻古今人物，亹亹不能休，座客闻之，率为之夺气。","book":"元戴良《申屠先生墓志铭》序"},"example":{"text":"群居酒次，贻上～，而先生独恂恂不妄措一词。","book":"清汪琬《节孝王先生传》"},"similar":["议论风生"],"usage":"作谓语、定语；用于书面语"},{"id":40982,"word":"议论风生","pinyin":"yì lùn fēng shēng","abbr":"ylfs","explanation":"形容谈论广泛、生动而又风趣。","source":{"text":"韩持国为人凝严方重，每兄弟聚话，玉汝、子华议论风生，持国未尝有一言。","book":"宋王暐《道山清话》"},"example":{"text":"伊和女伴商量装饰，～，足以使大家心折。","book":"叶圣陶《一个朋友》"},"similar":["议论风发"],"usage":"作谓语、定语；用于书面语"},{"id":40983,"word":"记功忘失","pinyin":"jì gōng wàng shī","abbr":"jgws","explanation":"指记其功绩而略其小过。","source":{"text":"《后汉书·党锢传·李膺》：“夫立政之要，，是以武帝舍安国于徒中，宣帝征张敞于亡命。”一本作“记功忘过”。"},"similar":["记功忘过"],"usage":"作宾语、定语；用于衡量一个人"},{"id":40984,"word":"记功忘过","pinyin":"jì gōng wàng guò","abbr":"jgwg","explanation":"指记其功绩而略其小过。同“记功忘失”。","source":{"text":"山藏川纳，记功忘过者，明主之深仁也。","book":"明·张居正《为故大学士高拱乞恩疏》"},"example":{"text":"评价一个人不能～。"},"similar":["记功忘失"],"usage":"作宾语、定语；用于衡量一个人"},{"id":40985,"word":"记忆犹新","pinyin":"jì yì yóu xīn","abbr":"jyyx","explanation":"犹：还。过去的事，至今印象还非常清楚，就象刚才发生的一样。","source":{"text":"仆曩官健上，多识其士，友去之数十年，犹记忆如新相知；今屈指故交存者十无一二。","book":"宋·刘克庄《后村全集·跋章南举千藁》"},"example":{"text":"恭王因为皇帝的告戒，～，在这些加官进爵的事上，要避把持的嫌疑。","book":"高阳《玉座珠帘》下册"},"similar":["历历在目","言犹在耳"],"opposite":["时过境迁","浮光掠影"],"usage":"作谓语、定语；指对过去的事记得清"},{"id":40986,"word":"记问之学","pinyin":"jì wèn zhī xué","abbr":"jwzx","explanation":"只是记诵书本，以资谈助或应答问难的学问。指对学问未融会贯通，不成体系。","source":{"text":"记问之学，不足以为人师，必也其听语乎？","book":"《礼记·学记》"},"example":{"text":"就是记问之学，也亏他了。我再试他一试。”（明·冯梦龙《警世通言》卷一","book":"伯牙听见他对答如流，犹恐是～。又想道"},"usage":"作宾语；指无真知之学"},{"id":40987,"word":"讲信修睦","pinyin":"jiǎng xìn xiū mù","abbr":"jxxm","explanation":"修：建立；睦：和睦。人与人之间，国与国之间，讲究信用，谋求和睦。","source":{"text":"选贤与能，讲信修睦。","book":"《礼记·礼运》"},"example":{"text":"我国民务扩新知，多尽义务，对于内则父诏兄勉，对于外则～。","book":"蔡东藩、许厪父《民国通俗演义》第四十四回"},"usage":"作谓语；指讲究信用，睦邻修好"},{"id":40988,"word":"讲古论今","pinyin":"jiǎng gǔ lùn jīn","abbr":"jglj","explanation":"从古到今无所不谈，无不评论。形容话题广泛。","source":{"text":"只待要说古谈今，寻山问水，傍柳穿花；那里也修身正己，利民润物，治国齐家。","book":"元·石子章《竹坞听琴》第二折"},"example":{"text":"钱青云见那先生学问平常，故意谈天说地，～，惊得先生一字俱无。","book":"明·冯梦龙《醒世恒言》卷七"},"similar":["谈今说古"],"usage":"作谓语；形容话题广泛"},{"id":40989,"word":"讲文张字","pinyin":"jiǎng wén zhāng zì","abbr":"jwzz","explanation":"指讲求文字工丽并张大其词。","source":{"text":"夫史家条序人物，宜存警训，不当徒以官大庞浓，讲文张字。","book":"唐·孙樵《与高锡望书》"},"usage":"作谓语、宾语、定语；用于说话或文章等"},{"id":40990,"word":"讲是说非","pinyin":"jiǎng shì shuō fēi","abbr":"jssf","explanation":"犹言说三道四。形容不负责任地胡乱议论。","source":{"text":"这财礼虽是轻微，你为何讲是说非？","book":"元·柯丹邱《荆钗记·受钗》"},"example":{"text":"请不要随便～，影响不好。"},"similar":["说三道四"],"usage":"作谓语、定语；用于评说事物等"},{"id":40991,"word":"讲经说法","pinyin":"jiǎng jīng shuō fǎ","abbr":"jjsf","explanation":"讲传宗教经典，宣扬宗教教义。亦指引经据典地谈说议论。","source":{"text":"有上方贪狼星，乃是第十三尊罗汉，不听我佛讲经说法，起一念思凡之心。","book":"元·郑廷玉《忍字记》楔子"},"example":{"text":"到今日来，灵山兴旺，今十大弟子，～。","book":"《西游记·南游记》第一回"},"similar":["谈经论道","引经据典"],"usage":"作谓语、宾语；指引经据典的谈说议论"},{"id":40992,"word":"讲若画一","pinyin":"jiǎng ruò huà yī","abbr":"jrhy","explanation":"讲：和；画一：整齐，统一。协调，整齐划一。","source":{"text":"萧何为法，讲若画一，曹参代之，守而勿失。","book":"《汉书·曹参传》"},"example":{"text":"及天下既平，政事一出于何，法令讲若画一，民安其生，天下遂以无事。","book":"宋·苏辙《栾城后集·历代论二》"}},{"id":40993,"word":"讳兵畏刑","pinyin":"huì bīng wèi xíng","abbr":"hbwx","explanation":"指慎于用兵和用刑。","source":{"text":"于惟祖宗，有常则兮。讳兵畏刑，后货食兮。政有损益，兹不易兮。","book":"宋·张耒《大礼庆成赋》"},"usage":"作宾语、定语；用于处事"},{"id":40994,"word":"讳恶不悛","pinyin":"huì è bù quān","abbr":"hebq","explanation":"悛：改过，悔改。坚持作恶，不肯悔改。","source":{"text":"讳恶不悛，卒至亡灭。","book":"南朝·宋·范晔《后汉书·朱穆传》"},"example":{"text":"对那些～的战犯一定要严惩。"},"similar":["死不悔改"],"usage":"作谓语、定语；指不肯悔改"},{"id":40995,"word":"讳树数马","pinyin":"huì shù shù mǎ","abbr":"hssm","explanation":"表示居官为人忠诚谨慎。","source":{"text":"建为郎中令，书奏事，事下，建读之，曰：‘误书！“马”者与尾当五，今乃四，不足一。上谴死矣！’……万石君少子庆为太仆，御出，上问车中几马，庆以策数马毕，举手曰：六马。庆于诸子中最为简易矣，然犹如此。","book":"《史记·万石张叔列传》"},"example":{"text":"《汉书·孔光传》：“沐日归休，兄弟妻子燕语，终不及朝省政事。或问光：‘温室省中树皆何木也？’光默不应，更答以它语，其不泄如是。”"},"usage":"作定语；用于书面语"},{"id":40996,"word":"讳疾忌医","pinyin":"huì jí jì yī","abbr":"hjjy","explanation":"讳：避忌；忌：怕，畏惧。隐瞒疾病，不愿医治。比喻怕人批评而掩饰自己的的缺点和错误。","source":{"text":"今人有过，不喜人规，如护疾而忌医，宁灭其身而无悟也。","book":"宋·周敦颐《周子通书·过》"},"example":{"text":"患着浮肿，而～，但愿别人糊涂，误认他为肥胖。","book":"鲁迅《且介亭杂文末编·“立此存照”》"},"similar":["文过饰非"],"usage":"作主语、宾语、定语；比喻不认错","story":["战国时期名医扁鹊见到蔡桓公，发现他有病在皮肤上，劝他早点医治，蔡桓公不高兴。十天后扁鹊又劝蔡桓公趁病在肌肉里赶快医治。蔡桓公采取讳疾忌医的态度对付。过了一段时间后，蔡桓公遍身疼痛，派人怎么也找不到扁鹊了"]},{"id":40997,"word":"讳莫如深","pinyin":"huì mò rú shēn","abbr":"hmrs","explanation":"讳：隐讳；深：事件重大。原意为事件重大，讳而不言。后指把事情隐瞒得很紧。","source":{"text":"讳莫如深，深则隐。苟有所见，莫如深也。","book":"《谷梁传·庄公三十二年》"},"example":{"text":"中国则～，枢府举动，真相不知。","book":"清·梁启超《论报馆有益于国事》"},"similar":["秘而不宣","守口如瓶","高深莫测"],"opposite":["直言不讳","和盘托出","显而易见"],"usage":"作谓语、状语；指把事情隐瞒得很深","story":["春秋时期鲁庄公喜欢妃子孟任，想让孟的儿子般继承王位，叔牙想让庆父为王，庄公不同意。季友杀死叔牙让般当国君。庆父杀死般，让开当王，一年后杀死鲁公自己为王。孔子没有将这段历史写进《春秋》，人说他是“讳莫如深”"]},{"id":40998,"word":"讳莫高深","pinyin":"huì mò gāo shēn","abbr":"hmgs","explanation":"隐瞒得很紧，不让别人知道。","example":{"text":"对自己的错误和缺点，决不可～，应该去寻求他人的帮助并尽快改正。"}},{"id":40999,"word":"讳败推过","pinyin":"huì bài tuī guò","abbr":"hbtg","explanation":"隐瞒失败，推托过失。","source":{"text":"若乃讳败推过，归咎万物，常执其功，而隐其表，上下离心，贤愚解体。","book":"晋·习凿齿《司马景物引过》"},"usage":"作谓语、宾语；指不负责"},{"id":41000,"word":"讴功颂德","pinyin":"ōu gōng sòng dé","abbr":"ogsd","explanation":"犹言歌功颂德。","source":{"text":"民皆歌乐之，颂其德。","book":"西汉·司马迁《史记·周本纪》"},"example":{"text":"却该受无产阶级的威胁，去做～的文章。","book":"鲁迅《二心集·“硬译”与“文学的阶级性”》"},"similar":["歌功颂德"],"usage":"作谓语、宾语；指歌功颂德"},{"id":41001,"word":"讷于言，敏于行","pinyin":"nè yú yán，mǐn yú xíng","abbr":"nyymyx","explanation":"讷：语言迟钝；敏：敏捷。指说话谨慎，办事敏捷。","source":{"text":"君子欲讷于言而敏于行。","book":"春秋·鲁·孔丘《论语·里仁》"},"example":{"text":"广少与赵郡李謇齐名，为邢、魏之亚，而～。","book":"《北齐书·文苑传·李广》"},"similar":["敏行讷言"],"usage":"作谓语、定语、宾语；用于处事"},{"id":41002,"word":"讷口少言","pinyin":"nè kǒu shǎo yán","abbr":"nksy","explanation":"讷口：不善于说话。不善言谈，说话不多。","source":{"text":"广讷口少言，与人居则画地为军陈，射阔狭以饮。","book":"《史记·李将军列传》"},"similar":["沉默寡言"],"usage":"作谓语、定语；指不善言谈"},{"id":41003,"word":"讷直守信","pinyin":"nè zhí shǒu xìn","abbr":"nzsx","explanation":"讷直：言语迟钝，品格正直；守信：遵守信用。指人纯朴憨厚，不善辞令。","source":{"text":"饰口利辞，竞相推荐；讷直守信，坐见埋没。","book":"《南史·郭祖深传》"}},{"id":41004,"word":"讷言敏行","pinyin":"nè yán mǐn xíng","abbr":"nymx","explanation":"讷言：说话谨慎；敏：敏捷。指说话谨慎，办事敏捷。","source":{"text":"君子欲讷于言而敏于行。","book":"春秋·鲁·孔丘《论语·里仁》"},"example":{"text":"不可不深自警省，～，以改故习之谬也。","book":"宋·朱熹《答王近思书》"},"similar":["谨言慎行"],"usage":"作谓语、定语；指人说话办事"},{"id":41005,"word":"许友以死","pinyin":"xǔ yǒu yǐ sǐ","abbr":"xyys","explanation":"许：应许。朋友以死相许。形容重友谊。","source":{"text":"父母存，不许友以死，不有私财。","book":"《周礼·曲礼上》"},"similar":["生死与共"],"usage":"作谓语、定语；指重友情"},{"id":41006,"word":"许由洗耳","pinyin":"xǔ yóu xǐ ěr","abbr":"xyxe","explanation":"许由：远古时代人名。许由洗自己的耳朵，指不想当官。","source":{"text":"尧又召为九州长，由不欲闻之，洗耳于颖水滨……巢父曰：‘……子故浮游俗间，求其名誉，污吾犊口。’牵犊上流而饮之。","book":"晋·皇甫谧《高士传·许由》"},"example":{"text":"他一心想学～，过隐居生活。"},"similar":["盥耳山栖"],"usage":"作宾语、定语；指不想当官","story":["远古时期，尧听说德高望重的贤士许由很有本事，就想传位给他。许由听说后连夜逃走。他喜欢过清静的隐居生活。尧派人四处寻找，终于在箕山找到了他，请他出山为王。许由坚决不从，觉得耳朵被弄脏就跑到河边反复冲洗耳朵"]},{"id":41007,"word":"许结朱陈","pinyin":"xǔ jié zhū chén","abbr":"xjzc","explanation":"朱陈：古村名，内住朱、陈两姓，世代互相联姻。比喻同意结成婚姻。","source":{"text":"徐州古丰县，有村曰朱陈。……一村唯两姓，世世为婚姻。","book":"唐·白居易《朱陈村》"},"example":{"text":"清·曹雪芹《红楼梦》第99回：“仰蒙雅爱，～，至今佩德勿谖。”"},"usage":"作谓语、定语；用于书面语"},{"id":41008,"word":"许许多多","pinyin":"xǔ xǔ duō duō","abbr":"xxdd","explanation":"很多数量的人或物。","source":{"text":"要完成这个基本任务，有许许多多的工作要做。","book":"邓小平《在全国科学大会开幕式上的讲话》"},"example":{"text":"路遥《平凡的世界》第一卷第二章：“当然，～的所见所识他都还不能全部理解。”"},"usage":"作宾语、定语；指数量多"},{"id":41009,"word":"讹以传讹","pinyin":"é yǐ chuán é","abbr":"eyce","explanation":"把本来就是错误的东西妄加传播，越传越错。","source":{"text":"不然，长髯紫衣，怪诞幽显之说，何其骇异哉？后人又不考而吟咏焉，讹以传讹也。","book":"明·郎瑛《七修类稿·辩证上·爱妾换马》"},"example":{"text":"如其不经审判，恐愚民～，借词煽动，其乱愈滋。","book":"中国近代史资料丛刊《辛亥革命·保路运动》"},"similar":["讹以滋讹"],"usage":"作宾语、定语；指谣言等"},{"id":41010,"word":"讹以滋讹","pinyin":"é yǐ zī é","abbr":"eyze","explanation":"把本来错误的东西加以传播，越传越错。","source":{"text":"而无如市井仓皇，讹以滋讹，几于三人成虎。","book":"清·侯方域《为司徒公与宁南侯书》"},"similar":["以讹传讹","三人成虎"],"usage":"作宾语、定语；指谣言等"},{"id":41011,"word":"讹言惑众","pinyin":"é yán huò zhòng","abbr":"eyhz","explanation":"讹言：诈伪的话。用谣言欺骗迷惑群众。","source":{"text":"癸丑，初建东宫，甲寅，诛西京讹言惑众者。","book":"《元史·世祖五》"},"example":{"text":"他故意在～，制造事端。"},"similar":["谣言惑众"],"usage":"作谓语、宾语、定语；指造谣生事"},{"id":41012,"word":"讹言谎语","pinyin":"é yán huǎng yǔ","abbr":"eyhy","explanation":"讹言：诈伪的话；谎语：不真实的话。指造谣说谎。","source":{"text":"俺孩儿也不曾讹言谎语，又不曾方头不律。","book":"元·无名氏《冤家债主》第三折"},"usage":"作谓语、宾语；指谎话"},{"id":41013,"word":"论一增十","pinyin":"lùn yī zēng shí","abbr":"lyzs","explanation":"指诽谤或赞美他人，要夸大其辞，使人信服。","source":{"text":"誉人不增其美，则闻者不快其意，毁人不益其恶，则听者不惬于心。闻一增以为十，见百益以为千。","book":"汉·王充《论衡·艺增》"}},{"id":41014,"word":"论世知人","pinyin":"lùn shì zhī rén","abbr":"lszr","explanation":"犹言知人论世。指了解一个人并研究他所处的时代。亦泛指鉴别人物，评论世事。","source":{"text":"石夫高尚之情，谨慎之识，俱可见焉。附录之，亦可以论世知人也。","book":"清·叶廷琯《鸥陂渔话·范石夫朋旧尺牍跋语》"},"example":{"text":"但是穷而在下，权不我操，虽抱着拨乱反正之心，与那～之识，也不过空口说白话，谁来睬我？","book":"《中国现在记》楔子"},"usage":"作宾语、定语；用于书面语"},{"id":41015,"word":"论今说古","pinyin":"lùn jīn shuō gǔ","abbr":"ljsg","explanation":"从今到古无所不谈，无不评论。","source":{"text":"人间开口笑樵渔，会谈今论古。","book":"元·张可久《端正好·渔乐》"},"example":{"text":"还有一个道士，妙解章令。又能饮宴，～，无有不知，多解多能，人间皆晓。","book":"《敦煌变文集·叶净能诗》"},"similar":["谈今论古"],"usage":"作谓语、宾语；形容谈话内容广泛"},{"id":41016,"word":"论列是非","pinyin":"lùn liè shì fēi","abbr":"llsf","explanation":"论：评论；列：列举。罗列事实，评论是非。","source":{"text":"乃欲卬首信眉，论列是非，不亦轻朝廷，羞当世之士邪。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"面逍遥河上之耆旧，乃忽仰首伸眉，～，与众为仇，助贼张目。","book":"清·梁启超《辟复辟论》"},"usage":"作谓语、宾语；用于书面语"},{"id":41017,"word":"论功受赏","pinyin":"lùn gōng shòu shǎng","abbr":"lgss","explanation":"评定功劳，接受赏赐。","source":{"text":"奋匹夫之命，轻若鸿毛，救万乘之尊，急于虎口，论功受赏，我无愧焉。","book":"宋·王禹偁《刻石为丘行恭赞序》"},"example":{"text":"本主已死，尔却～，我转来取你，何计与主公报仇？","book":"《前汉书平话》中卷"},"opposite":["无功受禄"],"usage":"作谓语、定语；用于事情结束后"},{"id":41018,"word":"论功封赏","pinyin":"lùn gōng fēng shǎng","abbr":"lgfs","explanation":"论：按照。按功劳的大小给于奖赏。","source":{"text":"季龙入辽宫，论功封赏各有差。","book":"《晋书·石季龙传上》"},"example":{"text":"嗣是驾还燕京，～，加哈喇哈孙为太傅，答剌罕一作达尔罕。","book":"蔡东藩《元史演义》第二十九回"},"similar":["论功行封"],"usage":"作谓语、定语；指按功劳大小给予奖赏"},{"id":41019,"word":"论功行封","pinyin":"lùn gōng xíng fēng","abbr":"lgxf","explanation":"评定功劳之大小给予封赏。","source":{"text":"汉五年，既杀项羽，定天下，论功行封。","book":"《史记·萧相国世家》"},"example":{"text":"畴乃自卢龙引军出塞，堑山堙谷五百余里，后～，畴曰：‘吾岂卖卢龙塞以图富贵哉？’","book":"明·蒋一葵《长安客话·徐无山》"},"similar":["论功行赏"],"opposite":["赏罚不明"],"usage":"作谓语、定语；指按功劳大小给予奖赏"},{"id":41020,"word":"论功行赏","pinyin":"lùn gōng xíng shǎng","abbr":"lgxs","explanation":"论：按照。按功劳的大小给于奖赏。","source":{"text":"计功而行赏，程能而授事。","book":"《韩非子·八说》"},"example":{"text":"这春彩，臣等断不敢受。请留待他时～。","book":"清·洪昇《长生殿·献饭》"},"similar":["赏罚分明","计功行赏"],"opposite":["赏罚不明"],"usage":"作谓语、定语；指按功劳大小给予奖赏","story":["西汉初年，汉王刘邦打败了西楚霸王项羽当上皇帝，他开始封赏有功的文臣武将，可大臣们互不相让，均想得到首功。刘邦只好让大臣们不说自己推荐别人得首功，他们推荐萧何排第一，曹参排第二，然后按各自的军功等级进行封赏"]},{"id":41021,"word":"论千论万","pinyin":"lùn qiān lùn wàn","abbr":"lqlw","explanation":"指成千上万，数量极多。","source":{"text":"爹家里论千论万满箱满柜无数的银子。","book":"元·刘君锡《来生债》第二折"},"similar":["数以万计","千千万万"],"usage":"作谓语；形容数量多"},{"id":41022,"word":"论德使能","pinyin":"lùn dé shǐ néng","abbr":"ldsn","explanation":"选拔有道德的人和使用有才能的人。论，通“抡”。","source":{"text":"论德使能而官施之者，圣王之道也，儒之所谨守也。","book":"战国·赵·荀况《荀子·王霸》"},"similar":["任贤使能","任人唯贤"],"opposite":["任人唯亲"],"usage":"作谓语、定语、宾语；用于选拔人才"},{"id":41023,"word":"论心定罪","pinyin":"lùn xīn dìng zuì","abbr":"lxdz","explanation":"根据犯罪人的动机和情节来判定其罪行。","source":{"text":"故《春秋》之治狱，论心定罪。","book":"汉·桓宽《盐铁论·刑德》"},"similar":["原心定罪"],"usage":"作谓语、宾语、定语；用于判案等"},{"id":41024,"word":"论甘忌辛","pinyin":"lùn gān jì xīn","abbr":"lgjx","explanation":"说到甘甜的就忌讳辛辣的。比喻有所好而偏执。","source":{"text":"至于世之诸贤，各滞所迷，莫不论甘而忌辛，好丹而非素。","book":"南朝·梁·江淹《杂体》诗序"},"example":{"text":"今者务反其说，迹适成～之见。","book":"章炳麟《文学论略》"},"usage":"作定语；指有所好而偏执"},{"id":41025,"word":"论短道长","pinyin":"lùn duǎn dào cháng","abbr":"lddc","explanation":"议论别人的是非好坏。同“论长说短”。","source":{"text":"当着众人也对她评头品足，论短道长起来。","book":"欧阳山《苦斗》"},"similar":["说长道短","论长道短"],"usage":"作谓语、宾语；同“说长道短”"},{"id":41026,"word":"论议风生","pinyin":"lùn yì fēng shēng","abbr":"lyfs","explanation":"谈论得极其生动而又风趣。","source":{"text":"亮为人才气超迈，喜谈兵；论议风生，下笔数千言立就。","book":"《宋史·陈亮传》"},"similar":["论辩风生"],"usage":"作谓语、状语、定语；用于谈话、作文等"},{"id":41027,"word":"论资排辈","pinyin":"lùn zī pái bèi","abbr":"lzpb","explanation":"论：根据；资：资历，资格；辈：大小或前后顺序。根据资历深浅、辈份的大小决定级别、待遇的高低。","source":{"text":"现在有些地方对选进领导班子的年轻人，还是论资排辈，发挥不了他们的作用。","book":"邓小平《思想路线政治路线的实现要考组织路线来保证》"},"example":{"text":"～是封建阶级、特权制度和宗法等级制度的产物。"},"similar":["循次进取","依流平进"],"opposite":["破格提升","破格录用"],"usage":"作谓语、定语、宾语、主语；指排资历"},{"id":41028,"word":"论辩风生","pinyin":"lùn biàn fēng shēng","abbr":"lbfs","explanation":"议论辩驳，极生动而又风趣。","source":{"text":"惟张九龄论辩风生，升此座，余人不可阶也。","book":"五代·王仁裕《开元天宝遗事·七宝山座》"},"similar":["论议风生"],"usage":"作谓语、状语、定语；用于辩论等"},{"id":41029,"word":"论道经邦","pinyin":"lùn dào jīng bāng","abbr":"ldjb","explanation":"研究治国之道，以经营治理国家。","source":{"text":"此惟三公之任，佐王论道，以经纬国事。","book":"《书·周官》：“立太师、太傅、太保，兹惟三公，论道经邦，燮理阴阳。”孔传"},"example":{"text":"明公以明聪杰出之资，任馆阁清华之地，穷金匮石室之藏，豫～之略。","book":"清·刘大櫆《与李侍郎书》"},"usage":"作宾语、定语；用于书面语"},{"id":41030,"word":"论长说短","pinyin":"lùn cháng shuō duǎn","abbr":"lcsd","explanation":"议论别人的是非好坏。","source":{"text":"算功课论长说短，欲诉无门。","book":"清·褚人获《坚瓠十集·卷堂文》"},"example":{"text":"则分疆画界之时，此多彼寡，～，岂能无争。","book":"梁启超《论今日各国待中国之善法》"},"similar":["论短道长","说三道四","论长道短"],"usage":"作谓语、宾语；同“说长道短”"},{"id":41031,"word":"论长道短","pinyin":"lùn cháng dào duǎn","abbr":"lcdd","explanation":"议论别人的是非好坏。","source":{"text":"两个商议定了，一对儿论长道短。","book":"清·曹雪芹《红楼梦》第九回"},"example":{"text":"我们不要对别人～。"},"similar":["说长道短"],"usage":"作谓语、宾语；同“说长道短”"},{"id":41032,"word":"论高寡合","pinyin":"lùn gāo guǎ hé","abbr":"lggh","explanation":"言论高超，投合者少。"},{"id":41033,"word":"论黄数白","pinyin":"lùn huáng shù bái","abbr":"lhsb","explanation":"①指任意评论是非好坏。②点了黄金又数白银。极言财富之多。","source":{"text":"笑弩骀言不逊，论黄数白不堪听。","book":"明·丘濬《投笔记·投笔空回》"},"example":{"text":"任纡青拖紫，名齐北斗；～，富比长淮。","book":"清·袁枚《随园诗话》第二卷"},"similar":["论黄数黑"],"usage":"作宾语、定语；用于书面语"},{"id":41034,"word":"论黄数黑","pinyin":"lùn huáng shǔ hēi","abbr":"lhsh","explanation":"数：数落，批评。背后乱加评论，肆意诽谤别人。","source":{"text":"你入门来便闹起，有甚的论黄数黑。","book":"元·杨文奎《儿女团圆》第一折"},"example":{"text":"是何方劣相酸丁？混入花丛举止轻。看～，画影描形。","book":"明·凌濛初《二刻拍案惊奇》第40卷"},"similar":["论黄数白"],"usage":"作谓语、定语；指任意评论是非好坏"},{"id":41035,"word":"讽一劝百","pinyin":"fěng yī quàn bǎi","abbr":"fyqb","explanation":"讽：用委婉含蓄的言语批评、指责；劝：劝告，劝戒。委婉含蓄地批评、指责一个，使大家都受到教育。","source":{"text":"扬雄以为靡丽之赋，劝百而讽一，犹驰骋郑卫之声，曲终而奏雅，不已亏乎？","book":"《史记·司马相如列传》"},"example":{"text":"然～，势不自反。","book":"南朝·梁·刘勰《文心雕龙·杂文》"},"usage":"作谓语、定语；指意在使人警戒"},{"id":41036,"word":"讽多要寡","pinyin":"fěng duō yào guǎ","abbr":"fdyg","explanation":"讽谕之言多，切要之言少。","source":{"text":"然骚人之辞，怨刺愤怼，虽援及君臣教化，而不能拈洽持论；相如、子云，瑰丽诡变，讽多要寡，漫羡无归，不见治乱。","book":"唐·裴延翰《〈樊川文集〉序》"},"usage":"作宾语、定语；用于文章或说话等"},{"id":41037,"word":"讽德诵功","pinyin":"fěng dé sòng gōng","abbr":"fdsg","explanation":"赞美、颂扬功德。","source":{"text":"讽德诵功，周美盛隆，奭旦辅成，光济冲人。","book":"汉·焦赣《易林·节之革》"},"similar":["歌功颂德"],"usage":"作谓语；指歌功颂德"},{"id":41038,"word":"设下圈套","pinyin":"shè xià quān tào","abbr":"sxqt","explanation":"引诱人受骗上当。","example":{"text":"他～让你上当。"},"usage":"作谓语；指诱人受骗上当","story":["从前寿春县有一个断案如神的县令李崇，他经常设下圈套让双方当事人去钻，从而使案件真相大白，例如让人通知当事人孩子已死看他们的反应，从而让失儿回到父母的身边。乔装打扮去识别逃犯等都是很好的例证"]},{"id":41039,"word":"设官分职","pinyin":"shè guān fēn zhí","abbr":"sgfz","explanation":"设立官爵或官府，分派职权。","source":{"text":"设官分职，营处署居。","book":"晋·左思《魏都赋》"},"example":{"text":"自从周公作《周礼》，～，到今日也不曾听得钦差拜过典史！","book":"清·文康《儿女英雄传》第十三回"},"usage":"作谓语、定语、宾语；用于官场等"},{"id":41040,"word":"设张举措","pinyin":"shè zhāng jǔ cuò","abbr":"szjc","explanation":"设：设置；张：主张；举措：举动措施。指所想所为的一切行动。","source":{"text":"长德时，天子以为宰相，宜参用道德人，因拜礼部尚书，同中书门下平章事，公既谢辞不许，其所设张举措，必本于宽大。","book":"唐·韩愈《唐故相权公墓碑》"},"usage":"作宾语、定语；用于书面语"},{"id":41041,"word":"设弧之辰","pinyin":"shè hú zhī chén","abbr":"shzc","explanation":"弧：弓；辰：时辰。旧指男子的生日。","source":{"text":"子生，男子设弧于门左，女子设帨于门右。","book":"《礼记·内则》"}},{"id":41042,"word":"设彀藏阄","pinyin":"shè gòu cáng jiū","abbr":"sgcj","explanation":"指设置圈套、暗藏机关以捉弄人。","source":{"text":"我这里设彀藏阄，你那里妆聋作哑。","book":"明·陈汝元《红莲债》第二折"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":41043,"word":"设心处虑","pinyin":"shè xīn chǔ lǜ","abbr":"sxcl","explanation":"处心积虑；用尽心思。同“设心积虑”。","source":{"text":"以此知创业之人，设心处虑，必有过人者。","book":"《续资治通鉴·宋高宗绍兴八年》"},"example":{"text":"然则该太监之～，于皇上为何如乎？","book":"《轰天雷》第十一回"},"similar":["处心积虑","设心积虑"],"usage":"作宾语、状语；指费尽心思做坏事"},{"id":41044,"word":"设心积虑","pinyin":"shè xīn jī lǜ","abbr":"sxjl","explanation":"处心积虑；用尽心思。","source":{"text":"魏唐之祚，竟为高朱所倾。凶盗设心积虑，由来一揆也。","book":"宋·洪迈《容斋续笔·贼臣迁都》"},"similar":["设心处虑","处心积虑"],"usage":"作谓语、宾语、状语；指费尽心思做坏事"},{"id":41045,"word":"设棁之辰","pinyin":"shè shuì zhī chén","abbr":"szzc","explanation":"帨：女子的佩巾；辰：时辰。古时风俗，生了女孩，就放一条佩巾在六的右首。旧指女子的生日。","source":{"text":"子生，男子设弧于门左，女子设帨于门右。","book":"《礼记·内则》"},"example":{"text":"～，子拜于前，孙拜于后。","book":"清·朱彝尊《胡母杨太君八十寿序》"}},{"id":41046,"word":"设棁良辰","pinyin":"shè shuì liáng chén","abbr":"szlc","explanation":"帨：女子的佩巾；辰：时辰。古时风俗，生了女孩，就放一条佩巾在六的右首。旧指女子的生日。","source":{"text":"子生，男子设弧于门左，女子设帨于门右。","book":"《礼记·内则》"}},{"id":41047,"word":"设疑破敌","pinyin":"shè yí pò dí","abbr":"sypd","explanation":"设：设置；破：攻下。设置疑兵，迷惑敌人，寻机攻击。"},{"id":41048,"word":"设言托意","pinyin":"shè yán tuō yì","abbr":"syty","explanation":"用言语寄寓心意。","source":{"text":"每日一入学中，四处各坐，却八目勾留，或设言托意，或咏桑寓柳，遥以心照，却外面自为避人眼目。","book":"《红楼梦》第九回"},"usage":"作谓语、宾语；用于书面语"},{"id":41049,"word":"设计铺谋","pinyin":"shè jì pū móu","abbr":"sjpm","explanation":"铺：铺设。设下计谋。","source":{"text":"捕风捉影，设计铺谋。","book":"清·李汝珍《镜花缘》第12回"},"usage":"作谓语；指用计"},{"id":41050,"word":"设身处地","pinyin":"shè shēn chǔ dì","abbr":"sscd","explanation":"设：设想。设想自己处在别人的那种境地。指替别人的处境着想。","source":{"text":"体，谓设以身处其地而察其心也。","book":"《礼记·中庸》：“体群臣也。”朱熹注"},"example":{"text":"若非梦往神游，何谓～？","book":"清·李渔《闲情偶寄》卷三《语求肖似》"},"similar":["身临其境","将心比心"],"opposite":["自以为是","随心所欲"],"usage":"作谓语、状语；指替别人的处境着想"},{"id":41051,"word":"访亲问友","pinyin":"fǎng qīn wèn yǒu","abbr":"fqwy","explanation":"访：拜访；问：问候。指拜访亲朋好友。","source":{"text":"足有半年多不能读书作文，于是每天访亲问友，在一些忙人中间鬼混，消磨时光。","book":"茅盾《后记》"},"example":{"text":"春节期间，国人大多数都在～。"},"similar":["走亲访友"],"usage":"作谓语、宾语；指拜访亲友"},{"id":41052,"word":"访论稽古","pinyin":"fǎng lùn jī gǔ","abbr":"fljg","explanation":"访：查访；稽：查对。讨论考究古代的事情。","source":{"text":"矜我劬瘁，睠我皓首，访论稽古，慰以大道。","book":"汉·赵歧《孟子题辞》"},"example":{"text":"考古工作者经常～。"},"usage":"作谓语、宾语；多用于考古"},{"id":41053,"word":"访贫问苦","pinyin":"fǎng pín wèn kǔ","abbr":"fpwk","explanation":"访问贫苦的老百姓。","source":{"text":"平地春雷响，来了共产党，访贫问苦下了乡，介梅见太阳。","book":"郭寿《迷路记》"},"example":{"text":"郭寿《迷路记》：“平地春雷响，来了共产党，访贫问苦下了乡，介梅见太阳。”"},"opposite":["不闻不问"],"usage":"作谓语、宾语、定语；指关心贫苦人"},{"id":41054,"word":"证据确凿","pinyin":"zhèng jù què záo","abbr":"zjqz","explanation":"确凿：确实。证据确实可靠，无法否认。","source":{"text":"尸场检验，证据确凿。且并未用刑，尔兄自认斗杀，招供在案。今尔远来，并非目睹，何得捏词妄控。理应治罪，姑念为兄情切，且恕。不准。","book":"清·曹雪芹《红楼梦》第八十六回"},"example":{"text":"深恐不法勇丁，骚扰百姓，所以面谕本县：倘有前项情事，～，准其到县指控。审明之后，即以军法从事，决不宽贷。","book":"清·李宝嘉《官场现形记》第十五回"},"usage":"作谓语、定语；用于处事等"},{"id":41055,"word":"证龟成鳖","pinyin":"zhèng guī chéng biē","abbr":"zgcb","explanation":"将乌龟说成甲鱼。比喻蓄意歪曲，颠倒是非。","source":{"text":"晋武帝欲为太子娶妇。卫瓘曰：‘贾氏有五不可：青、黑、短、妒而无子。’竟为群臣所誉娶之，竟以亡晋。……俚语曰‘证龟成鳖’，此未足怪也。以此观之、当云‘证龟成蛇’。……","book":"宋苏轼《东坡志林·贾氏五不可》"},"similar":["指鹿为马"],"opposite":["实事求是"],"usage":"作谓语、定语；指故意歪曲"},{"id":41056,"word":"诃佛诋巫","pinyin":"hē fó dǐ wū","abbr":"hfdw","explanation":"“诃”同“呵”。犹言诃佛骂祖。巫，巫师。","source":{"text":"兄实高明，卒监此心，顾托警励，琅琅其音。诃佛诋巫，考礼正俗，奉承靡他，葬又得卜。","book":"宋·朱熹《祭魏元履国录文》"},"similar":["呵佛骂祖"],"usage":"作谓语、定语；指敢做敢为"},{"id":41057,"word":"诃佛骂祖","pinyin":"hē fó mà zǔ","abbr":"hfmz","explanation":"佛教语，斥骂佛祖，比喻不受前人束缚。","source":{"text":"不然，则梯接凌虚，而遽为此诃佛骂祖耳。","book":"元·许谦《与赵伯器书》"},"example":{"text":"以乞儿市驵之为，而袭～之迹。","book":"清·钱谦益《题佛海上人卷》"},"similar":["呵佛骂祖"],"usage":"作谓语、定语；指不受前人束缚"},{"id":41058,"word":"评功摆好","pinyin":"píng gōng bǎi hǎo","abbr":"pgbh","explanation":"评定成绩，摆出优点。","source":{"text":"他又一次在军党委会上甩帽，为陈老总评功摆好。","book":"李存葆《高山下的花环》"},"example":{"text":"秀才，这种为我个人～的书，我劝你别写。","book":"周梅森《中国制造》第二章"},"usage":"作谓语、宾语；用于事成后"},{"id":41059,"word":"评头品足","pinyin":"píng tóu pǐn zú","abbr":"ptpz","explanation":"原指轻浮地议论妇女的容貌。现也比喻任意挑剔。","source":{"text":"那全副精神又注在各妓，那个好颜色，那个好太度，评头品足，少不免要乱哦几句诗出来了。","book":"清·黄小配《大马扁》第四回"},"example":{"text":"你应该多干点实事，不要总～。"},"similar":["评头论足","品头评足","说长道短"],"opposite":["无可非议","无可厚非"],"usage":"作谓语、宾语、定语；指乱发议论","story":["春秋时期，鲁班要雕刻一只凤凰，周围很多人前去围观，不一会，凤凰的头刻出来了，人们开始议论纷纷，有说像仙鹤的，有说像老鹰的，有说像野鸭子的。待凤凰全部雕刻出来后，人们纷纷赞美鲁班是如何神奇，刻得多么好"]},{"id":41060,"word":"评头论脚","pinyin":"píng tóu lùn jiǎo","abbr":"ptlj","explanation":"原指轻浮地议论妇女的容貌。现也比喻任意挑剔。同“评头品足”。","source":{"text":"她们的眼睛老瞅着新娘，有时也看看新郎，她们肩挨着肩，手拉着手，评头论脚，叽叽嘈嘈地小声地吵嚷个不休。","book":"周立波《暴风骤雨》第二部"},"similar":["评头论足","评头品足"],"usage":"作谓语、宾语；指乱发议论"},{"id":41061,"word":"评头论足","pinyin":"píng tóu lùn zú","abbr":"ptlz","explanation":"原指轻浮地议论妇女的容貌。现也比喻任意挑剔。","source":{"text":"那全副精神又注在各妓，那个好颜色，那个好太度，评头品足，少不免要乱哦几句诗出来了。","book":"清·黄小配《大马扁》第四回"},"example":{"text":"你应该多干点实事，不要总～。"},"similar":["评头品足","评头论脚"],"usage":"作谓语、宾语；指乱发议论"},{"id":41062,"word":"识二五而不知十","pinyin":"shí èr wǔ ér bù zhī shí","abbr":"sewebzs","explanation":"只知道一个方面，而不懂得全面地观察问题。","source":{"text":"且王之所求者，斗晋楚也；晋楚不斗，越兵不起，是知二五而不知十也。","book":"西汉·司马迁《史记·越王勾践世家》"},"example":{"text":"夫回瑗可弃，而杨董获升，可谓～者也。","book":"唐·刘知幾《史通·品藻》"},"usage":"作谓语、定语、分句；指不懂得全面看问题"},{"id":41063,"word":"识其一不识其二","pinyin":"shí qí yī bù shí qí èr","abbr":"sqybsqe","explanation":"了解事物的一方面，不了解还有另一方面。形容对事物的了解不全面。","source":{"text":"识其一不识其二，治其内而不治其外。","book":"《庄子·天地》"},"example":{"text":"昔汉阴丈人修浑沌之术，孔子以为～。（《晋书·王坦之传》）"}},{"id":41064,"word":"识变从宜","pinyin":"shí biàn cóng yí","abbr":"sbcy","explanation":"指认识事物的变化，灵活地处理问题。","source":{"text":"五则使命之臣，取其识变从宜，不辱君命。","book":"北齐·颜之推《颜氏家训·涉务》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":41065,"word":"识多才广","pinyin":"shí duō cái guǎng","abbr":"sdcg","explanation":"具有广博的知识和多方面的才能。","source":{"text":"他是晋国勋臣，识多才广。","book":"明·冯梦龙《东周列国志》第55回"},"example":{"text":"我们很需要～的人才。"},"similar":["见多识广"],"opposite":["孤陋寡闻"],"usage":"作谓语、定语；指人的见识多"},{"id":41066,"word":"识大体，顾大局","pinyin":"shí dà tǐ，gù dà jú","abbr":"sdtgdj","explanation":"认识到有关大局的重要道理，照顾全局利益。","source":{"text":"不论工人也好，农民也好，知识分子也好，爱国民主人士也好，都是识大体、顾大局的，都是相信跟着党走是对的。","book":"邓小平《在扩大的中央会议上的讲话》"},"example":{"text":"路遥《平凡的世界》第一卷第28章：“不愧是共产党员嘛！～……”"},"similar":["顾全大局"],"usage":"作谓语、定语、宾语；用于处事"},{"id":41067,"word":"识字知书","pinyin":"shí zì zhī shū","abbr":"szzs","explanation":"指有文化知识。","source":{"text":"莫说别个，就是阙忠辈呵，一般也貌昂藏，识字知书，怎奈这命低微，执镫随鞭。","book":"清·李渔《奈何天·虑婚》"},"example":{"text":"一百多代表中，‘～’的很少，可是穿着倒还不错。","book":"瞿秋白《饿乡纪程》十五"},"similar":["识文谈字"],"usage":"作谓语、定语；用于书面语"},{"id":41068,"word":"识微知著","pinyin":"shí wēi zhī zhuó","abbr":"swzz","explanation":"看到事物的苗头而能察知它的发展趋向或问题的实质。","source":{"text":"传曰：‘远人不服，则修文德以来之。’管仲有言：‘国家无使勇猛者为边境。’此诚圣哲识微知著之略也。","book":"《新唐书·杜佑传》"},"similar":["识微见几"],"usage":"作宾语、定语；用于处事"},{"id":41069,"word":"识微见几","pinyin":"shí wēi jiàn jǐ","abbr":"swjj","explanation":"看到事物的苗头而能认识和察见事物的本质和发展。","source":{"text":"惟识微见几之士，然后能逆知其渐。","book":"《宋史·常安民传》"},"example":{"text":"如常君者，真～之士也。","book":"明·李贽《史纲评要·宋纪·哲宗》"},"similar":["识微见远"],"usage":"作宾语、定语；用于处事"},{"id":41070,"word":"识微见远","pinyin":"shí wēi jiàn yuǎn","abbr":"swjy","explanation":"看到事物的苗头而能察知它的发展远景。","source":{"text":"是时海禁初开，恭恪此奏可谓识微见远。","book":"清·陈康祺《郎潜记闻》卷十一"},"similar":["识微见几"],"usage":"作宾语、定语；用于处事"},{"id":41071,"word":"识才尊贤","pinyin":"shí cái zūn xián","abbr":"sczx","explanation":"能识别并尊重有才能的人。","source":{"text":"以此见真正高阳酒徒之能人下士，识才尊贤又如此。","book":"明·李贽《焚书·复麻城人书》"},"example":{"text":"～的人大有人在。"},"similar":["爱惜人才"],"usage":"作谓语、宾语、定语；指爱惜人才"},{"id":41072,"word":"识文断字","pinyin":"shí wén duàn zì","abbr":"swdz","explanation":"识字。指有一点文化知识。","source":{"text":"当着人家识文断字的人儿呢？别抡荤，看人家笑话。","book":"清·文康《儿女英雄传》第三十八回"},"example":{"text":"你看，先父是个举人，我自幼就～。","book":"老舍《女店员》第一幕"},"similar":["识文谈字"],"usage":"作谓语、定语；指有一点文化知识"},{"id":41073,"word":"识文谈字","pinyin":"shí wén tán zì","abbr":"swtz","explanation":"知晓文字。","source":{"text":"孩儿也，你是个识文谈字的人。","book":"明·无名氏《薛苞认母》第二折"},"similar":["识字知书"],"usage":"作谓语、定语；用于书面语"},{"id":41074,"word":"识时务者为俊杰","pinyin":"shí shí wù zhě wéi jùn jié","abbr":"sswzwjj","explanation":"意思是能认清时代潮流的，是聪明能干的人。认清时代潮流势，才能成为出色的人物。","source":{"text":"识时务者，在乎俊杰。此间自有伏龙、凤雏。","book":"《三国志·蜀志·诸葛亮传》裴松之注引晋习凿齿《襄阳记》"},"example":{"text":"语曰：“～。”我愿今日的三民主义者记取此语。","book":"毛泽东《新民主主义论》"},"usage":"作宾语、分句；指看清时局","story":["三国时期，诸葛亮在隆中潜心攻读大量经史和诸子百家的著作，积累了丰富的政治、军事方面知识，他对当时的政局有独到的见解。襄阳的司马徽认为他是杰出人才，能认清天下大势，就把这个卧龙推荐给在荆州投靠刘牧的刘备"]},{"id":41075,"word":"识时知务","pinyin":"shí shí zhī wù","abbr":"sszw","explanation":"认清形势的发展，通晓事务的变化。","source":{"text":"孰谓洛阳车少通达国体，识时知务如此哉。","book":"明·李贽《焚书·李中丞奏议序》"}},{"id":41076,"word":"识时达务","pinyin":"shí shí dá wù","abbr":"ssdw","explanation":"达：通晓。认清形势的发展，通晓事务的变化。","source":{"text":"他不多几年，已巴到极顶的分儿，也只为识时达务，能够上和下睦罢了。","book":"清·曹雪芹《红楼梦》第99回"},"example":{"text":"她～，很快适应了环境。"},"usage":"作谓语、宾语、定语；用于处世方面"},{"id":41077,"word":"识时达变","pinyin":"shí shí dá biàn","abbr":"ssdb","explanation":"认清时势，通达权变。","source":{"text":"若蒙圣慈，特发使命，宣示德音，开其生路，彼亦识时达变之士也，宁不以数万生灵为念乎！","book":"明·陶宗仪《辍耕录·汉儿字圣旨》"},"example":{"text":"士大夫以媕婀雷同，无所可否，为～。","book":"明·归有光《〈雍里先生文集〉序》"},"similar":["识时通变"],"usage":"作谓语、宾语、定语；指认清时势"},{"id":41078,"word":"识时通变","pinyin":"shí shí tōng biàn","abbr":"sstb","explanation":"能认清时势，通达应变。","source":{"text":"尔祖子文，为楚名臣，识时通变。","book":"明·冯梦龙《东周列国志》第69回"},"example":{"text":"只要做到～，我们就能融合进去。"},"similar":["识时达变"],"usage":"作谓语、宾语、定语；指认清时势"},{"id":41079,"word":"识明智审","pinyin":"shí míng zhì shěn","abbr":"smzs","explanation":"识见明敏，智虑周详。","source":{"text":"且夫识明智审，则虑事精而信道笃。","book":"宋·张琰《〈洛阳名园记〉序》"},"usage":"作宾语、定语；用于书面语"},{"id":41080,"word":"识昧高卑","pinyin":"shí mèi gāo bēi","abbr":"smgb","explanation":"识：见识；昧：昏暗不明白事理。不懂得尊卑高下。","source":{"text":"是知虻俗昏鄙，识昧高卑，不可以尊极临，而可以诚义感。","book":"唐·陆贽《奉天请罢琼林大盈二库状》"},"usage":"作宾语、定语；用于书面语"},{"id":41081,"word":"识涂老马","pinyin":"shí tú lǎo mǎ","abbr":"stlm","explanation":"老马认识路。比喻对某种事物十分熟悉的人。同“识途老马”。","source":{"text":"攫食饥乌心未饱，识涂老马足堪扪。","book":"清·钱谦益《夜过磨盘岭》诗"},"similar":["识途老马"],"usage":"作主语、宾语；指有经验的人"},{"id":41082,"word":"识知无字","pinyin":"shí zhī wú zì","abbr":"szwz","explanation":"指幼儿识字。","source":{"text":"仆始生六七月时，乳母抱弄于书屏下。有指‘无’字、‘之’字示仆者，仆虽口未能言，心已默识。后有问此二字者，虽百十其试，而指之不差。","book":"唐·白居易《与元九书》"},"example":{"text":"儿识字，曰已～。","book":"宋·胡继宗《书言故事·幼敏类》"}},{"id":41083,"word":"识礼知书","pinyin":"shí lǐ zhī shū","abbr":"slzs","explanation":"懂得礼仪，熟知诗书。","source":{"text":"此乃罪臣家属，籍没入官，姓木名难儿，温柔贤淑，识礼知书，兼通数学。","book":"《野叟曝言》第五八回"},"similar":["知书识礼"],"usage":"作谓语、定语；用于人"},{"id":41084,"word":"识荆恨晚","pinyin":"shí jīng hèn wǎn","abbr":"sjhw","explanation":"遗憾自己与某人特别是知己或有才能的人相识太晚了。","example":{"text":"我们都有～的感觉。"},"similar":["相见恨晚"],"usage":"作谓语、定语；用于交往之间"},{"id":41085,"word":"识途老马","pinyin":"shí tú lǎo mǎ","abbr":"stlm","explanation":"老马认识路。比喻对某种事物十分熟悉的人。","source":{"text":"管仲、隰朋从于桓公伐孤竹，春往冬反，迷惑失道。管仲曰：‘老马之智可用也。’乃放老马而随之，遂得道。","book":"《韩非子·说林上》"},"example":{"text":"你也不用发忧，还有你老子是“～”，慢慢地来指拨你罢！","book":"茅盾《子夜》四"},"similar":["老马识途","驾轻就熟"],"opposite":["初出茅庐","乳臭未干"],"usage":"作主语、宾语；指有经验的人"},{"id":41086,"word":"诈取豪夺","pinyin":"zhà qǔ háo duó","abbr":"zqhd","explanation":"用欺骗的手段或武力夺取。","source":{"text":"暑假以后他自己的吃饭问题还不知道着落在何处，胁肩谄笑是不屑，诈取豪夺又不能。","book":"茅盾《路》"},"similar":["巧偷豪夺"],"usage":"作谓语、定语、状语；指夺取别人的东西"},{"id":41087,"word":"诈哑佯聋","pinyin":"zhà yǎ yáng lóng","abbr":"zyyl","explanation":"假装哑巴聋子。指置身事外。","source":{"text":"身在伍伦中，怎做得诈哑佯聋，为官食禄，直须尽职输忠。","book":"《群音类选·官腔类·双忠记·睢阳陷守》"},"similar":["装聋作哑"],"usage":"作谓语、宾语、定语；用于处事"},{"id":41088,"word":"诈奸不及","pinyin":"zhà jiān bù jí","abbr":"zjbj","explanation":"犹言十分奸诈。","source":{"text":"那厮带将许多诈奸不及的三二十人，迳入家里，来宅子后看了，便要发遣我们出去，他要来住。","book":"明·施耐庵《水浒传》第七回：“正在五岳楼下来，撞见个奸诈不及的，把娘子拦住了不肯放。”又第五十二回"},"usage":"作谓语、定语；用于书面语"},{"id":41089,"word":"诈痴不颠","pinyin":"zhà chī bù diān","abbr":"zcbd","explanation":"诈痴不颠","source":{"text":"方明白前日卖酒歌诗，诈痴不颠的老儿，正是他所差之人。","book":"《石点头·卢梦仙江上寻妻》"},"similar":["诈痴佯呆"],"usage":"作谓语、定语；用于处事"},{"id":41090,"word":"诈痴佯呆","pinyin":"zhà chī yáng dāi","abbr":"zcyd","explanation":"指假装痴呆。","source":{"text":"不如目今权依了他们处法，诈痴佯呆，住了官司，且保全了父骨，别图再报。","book":"明·凌蒙初《二刻拍案惊奇》卷三十一"},"similar":["诈痴不颠"],"usage":"作谓语、定语；用于处事"},{"id":41091,"word":"诈谋奇计","pinyin":"zhà móu qí jì","abbr":"zmqj","explanation":"狡诈的谋划，出人意料的计策。","source":{"text":"有报成安君不用诈谋奇计，而广武君之说不行，信于是欣然大喜。","book":"宋·王楙《野客丛书·韩信之幸》"},"usage":"作宾语、定语；用于书面语"},{"id":41092,"word":"诈败佯输","pinyin":"zhà bài yáng shū","abbr":"zbys","explanation":"诈、佯：假装。假装败阵，引人上当。","source":{"text":"林冲、花荣占住吊桥，回身再战，诈败佯输，诱引卢俊义抢入城中。背后三军，齐声呐喊。城中宋江等诸将，一齐兵变，接应入城。四方混杀，人人束手，个个归心。","book":"明·施耐庵《水浒传》第八十五回"},"example":{"text":"猪八戒料道不得赢他，对沙僧丢了个眼色，二人～，各拖兵器，回头就走。","book":"明·吴承恩《西游记》第四十九回"},"usage":"作谓语、宾语；指假败"},{"id":41093,"word":"诉诸武力","pinyin":"sù zhū wǔ lì","abbr":"szwl","explanation":"诉：诉讼。武力：军事力量。指用战争来解决冲突。","example":{"text":"求统一之方法，固宜尊重和平，和平所不能达，则不得不～。","book":"蔡东藩、许廑父《民国通俗演义》第九十九回"}},{"id":41094,"word":"诌上抑下","pinyin":"zhōu shàng yì xià","abbr":"zsyx","explanation":"谄：讨好，奉承。讨好上司，压制下级。","source":{"text":"[安同]性平正柔和，未尝有喜怒色，忠驾爱厚，不谄上抑下。","book":"《北史·安同传》"}},{"id":41095,"word":"词不悉心","pinyin":"cí bù xī xīn","abbr":"cbxx","explanation":"悉：尽，全。言词不能完全表达心意。","source":{"text":"飨德怀恩，词不悉心。","book":"唐·李朝威《柳毅传》"}},{"id":41096,"word":"词不达意","pinyin":"cí bù dá yì","abbr":"cbdy","explanation":"词：言词；意：意思。指词句不能确切地表达出意思和感情。","source":{"text":"盖五百年而书功烈者，辞不达意，余尝叹息之。","book":"《仪礼·聘礼》：“辞多则史，少则不达，辞苟足以达义之至也。”宋·惠洪《高安城隍庙记》"},"example":{"text":"不然，必有个～的毛病。","book":"清·吴趼人《二十年目睹之怪现状》第三十回"},"similar":["言不尽意","拐弯抹角"],"opposite":["酣畅淋漓","言必有中"],"usage":"作谓语、定语；指词语不能确切表达意"},{"id":41097,"word":"词不逮意","pinyin":"cí bù dài yì","abbr":"cbdy","explanation":"词：言语，词句；逮：到，及。指说话、写文章时所用的词句不能充分、确切表达出思想感情。","source":{"text":"嗣有四乡联团之议，曾泐数行奉达，仓卒中词不逮意。","book":"清·龙启瑞《覆唐子实书》"},"similar":["词不达意"],"opposite":["言必有中"],"usage":"作谓语、定语；指词语不能确切表达意思"},{"id":41098,"word":"词不逮理","pinyin":"cí bù dài lǐ","abbr":"cbdl","explanation":"词：言语，词句。逮：到；及。指说话、写文章时所用的词句不能充分、确切表达出思想感情。","source":{"text":"少孺（枚乘）速而未工，长卿（司马相如）工而未速，孟坚（班固）辞不逮理，平子（张衡）意不及文。","book":"南朝·梁·王僧孺《太常敬子任府君传》"}},{"id":41099,"word":"词严义密","pinyin":"cí yán yì mì","abbr":"cyym","explanation":"措词严谨，道理周密。","source":{"text":"宋朝诸儒所述，皆明白正大，词严义密，无馀蕴。","book":"《剪灯馀话·幔亭遇仙录》"},"usage":"作谓语、定语；用于作文或说话等"},{"id":41100,"word":"词严义正","pinyin":"cí yán yì zhèng","abbr":"cyyz","explanation":"词：言词，语言；严：严谨；义：道理；正：纯正。指言辞严厉，道理纯正。","source":{"text":"为之开陈祸福，词严义正，累数千言。","book":"元·黄溍《湖广等处行中书省平章政事追封文国公谥武宣刘公神道碑》"},"example":{"text":"这真可谓‘～’。所举的群小，也都确定的。","book":"鲁迅《且介亭杂文二集·“题未定”草九》"},"similar":["义正严词"],"usage":"作谓语、状语；指言辞严厉，道理纯正"},{"id":41101,"word":"词人墨客","pinyin":"cí rén mò kè","abbr":"crmk","explanation":"墨客：文人。泛指风雅的文人。","source":{"text":"馆娃宫、铜雀台，惹了多少词人墨客嗟呀嘲诮。","book":"清·褚人获《隋唐演义》第一回"},"similar":["骚人墨客","骚人词客"],"usage":"作宾语、定语；指文人"},{"id":41102,"word":"词人才子","pinyin":"cí rén cái zǐ","abbr":"crcz","explanation":"词人：善于文辞的人。旧指有才华的文人墨客。","source":{"text":"词人才子，则名溢于缥囊；飞文染墨，则卷盈乎缃帙。","book":"南朝·梁·萧统《文选序》"},"example":{"text":"当世之～，孰不欲附名简末，分荣后祀。","book":"清·黄宗羲《辞张郡侯请修郡志书》"},"usage":"作主语、比喻、定语；用于文人"},{"id":41103,"word":"词华典瞻","pinyin":"cí huá diǎn zhān","abbr":"chdz","explanation":"赡：充裕。文章遣词华丽，用典充裕。","source":{"text":"今所考载，体例虽仿孟书，而词华典瞻，南宋人遗篇剩句，颇赖以存，‘近雅’之言不谬。","book":"宋·周密《武林旧事记·叙录》"}},{"id":41104,"word":"词华典赡","pinyin":"cí huá diǎn shàn","abbr":"chds","explanation":"文词华丽，用典周备。","source":{"text":"今考所载，体例虽仿孟书，而词华典赡，南宋人遗篇剩句，颇赖以存，‘近雅’之言不谬。","book":"《四库全书总目·史部二六·武林旧事》"},"usage":"作谓语、宾语；用于作文等"},{"id":41105,"word":"词少理畅","pinyin":"cí shǎo lǐ chàng","abbr":"cslc","explanation":"词：言词；畅：通行无阻。虽然言辞不多，但说理畅达。"},{"id":41106,"word":"词无枝叶","pinyin":"cí wú zhī yè","abbr":"cwzy","explanation":"词：言词，词句。形容文字简炼，无枝蔓之辞。","source":{"text":"前后著文凡一百五十二首，皆理义撮要，词无枝叶。","book":"唐·白居易《有唐善人墓碑》"},"similar":["言无枝叶"],"usage":"作谓语、定语；用于说话或作文等"},{"id":41107,"word":"词正理直","pinyin":"cí zhèng lǐ zhí","abbr":"czlz","explanation":"言词严正，理由充足。","source":{"text":"按院见说得词正理直，更不再问。","book":"《醒世恒言·卢太学诗酒傲王侯》"},"example":{"text":"他的话～，应该相信。"},"usage":"作谓语、定语、状语；用于作文或说话等"},{"id":41108,"word":"词清讼简","pinyin":"cí qīng sòng jiǎn","abbr":"cqsj","explanation":"词讼清简。指狱讼稀少，政事清闲。","source":{"text":"词清讼简，陶情诗与酒。帘垂清昼，唐民得自由。","book":"明·范受益《寻亲记·发配》"},"example":{"text":"莅任半年，治得那一府物阜民安，～。","book":"《初刻拍案惊奇》卷二十"},"usage":"作宾语、定语；用于政治等"},{"id":41109,"word":"词穷理尽","pinyin":"cí qióng lǐ jìn","abbr":"cqlj","explanation":"指再也找不到理由，无话可说。","source":{"text":"仰干陶冶，敬托笺毫，始知调急声哀，唯愧词穷理尽。","book":"唐·崔致远《萧遘相公书》之二"},"example":{"text":"臣子之义，身非己有，～，不敢求去。","book":"宋·苏轼《辩试馆职策问札子》之二"},"similar":["理屈词穷"],"usage":"作谓语、定语；指理亏"},{"id":41110,"word":"词穷理屈","pinyin":"cí qióng lǐ qū","abbr":"cqlq","explanation":"指理由亏屈，无话可说。","source":{"text":"切详按问，自言皆是；词穷理屈，势必不免。","book":"宋·苏轼《论河北京东盗贼状》"},"example":{"text":"冯永祥给马慕韩这么一追问，有点～，尴尬地瞪着两只眼睛。","book":"周而复《上海的早晨》第四部"},"similar":["理屈词穷"],"usage":"作谓语、定语；指理亏"},{"id":41111,"word":"词穷理极","pinyin":"cí qióng lǐ jí","abbr":"cqlj","explanation":"穷：完，尽；极：终，到头。把话说完，把理讲透。","source":{"text":"诚原陛下日月之明，察臣之清，辞穷理极，非如向时避让职事犹在可冒之地。","book":"宋·王安石《辞同修起居注状七之五》"}},{"id":41112,"word":"词穷理绝","pinyin":"cí qióng lǐ jué","abbr":"cqlj","explanation":"指再也找不到理由，无话可说。同“词穷理尽”。","source":{"text":"师窘无以对，即放包依席下求决择。近一月馀，日呈见解，说道理。藏语之曰：‘佛法不恁么。’师曰：‘某甲词穷理绝也。'","book":"《五灯会元·罗汉琛禅师法嗣·清凉文益禅师》"},"similar":["词穷理尽"],"usage":"作谓语、定语；指理亏"},{"id":41113,"word":"词约指明","pinyin":"cí yuē zhǐ míng","abbr":"cyzm","explanation":"言词简洁，旨意明确。","source":{"text":"议者贵其辞约而指明。","book":"汉·桓宽《盐铁论·水旱》"},"example":{"text":"大圜～，应答无滞。","book":"《北史·萧大圜传》"},"usage":"作谓语、定语；用于作文或说话等"},{"id":41114,"word":"词言义正","pinyin":"cí yán yì zhèng","abbr":"cyyz","explanation":"词：言词，语言。义：道理。言辞严厉，义理正大。","source":{"text":"欧公书岂惟翰墨之妙，而辞严义正，千载之下，见者兴起，某何足以辱公此赐也哉。","book":"宋·张孝祥《明守赵敷文》"}},{"id":41115,"word":"词钝意虚","pinyin":"cí dùn yì xū","abbr":"cdyx","explanation":"形容由于心虚而说话吞吞吐吐。","source":{"text":"林之孝家的听他词钝意虚，又因近日玉钏儿说那边正房内失落了东西，几个丫头对赖，没主儿，心下便起了疑。","book":"清·曹雪芹《红楼梦》第六十"},"similar":["笨嘴拙舌"],"usage":"作谓语、定语；指人说话"},{"id":41116,"word":"诎寸信尺","pinyin":"qū cùn shēn chǐ","abbr":"qcxc","explanation":"诎：通“屈”；信：通“伸”。屈折一寸可伸长一尺。比喻小处受点委曲，以求得较大的利益。","source":{"text":"孔子曰：诎寸而信尺，小枉而大直，吾弗为也。","book":"《尸子》卷下"}},{"id":41117,"word":"诎膝请和","pinyin":"qū xī qǐng hé","abbr":"qxqh","explanation":"诎：通“屈”，弯曲；屈膝：下跪。下跪降服，请求和解。","source":{"text":"然后兴师出兵，北征匈奴，单于怖骇，交臂受事，诎膝请和。","book":"西汉·司马迁《史记·司马相如列传》"},"similar":["屈膝求和"],"usage":"作谓语、定语；指投降"},{"id":41118,"word":"诎要桡腘","pinyin":"qū yào ráo yù","abbr":"qyrg","explanation":"指弯腰曲膝。","source":{"text":"诎要桡腘。","book":"战国·赵·荀况《荀子·富国》"},"usage":"作定语、状语；用于书面语"},{"id":41119,"word":"诎要桡膎","pinyin":"qū yào ráo yù","abbr":"qyry","explanation":"指弯腰曲膝。"},{"id":41120,"word":"诒厥之谋","pinyin":"yí jué zhī móu","abbr":"yjzm","explanation":"诒：通“贻”，遗留；厥：其。留下安定天下的谋略","source":{"text":"武皇钟爱，既深诒厥之谋；天下归心，颇有后来之望。","book":"《晋书·愍怀太子传》"},"similar":["诒厥孙谋","贻厥孙谋"],"usage":"作宾语；用于书面语"},{"id":41121,"word":"诒厥孙谋","pinyin":"yí jué sūn móu","abbr":"yjsm","explanation":"为子孙的将来善做安排。","source":{"text":"诒厥孙谋，以燕翼子。","book":"《诗经·大雅·文王有声》"},"example":{"text":"有忠孝之道焉，有礼义之规焉，有经邦之则焉，有正家之训焉，固可以～，播乎长世者也。","book":"唐·李翰《凤阁王侍郎传论赞序》"},"similar":["诒厥之谋","贻厥孙谋"],"usage":"作谓语、定语；指长远安排"},{"id":41122,"word":"诒阙之谋","pinyin":"yí jué zhī móu","abbr":"yqzm","explanation":"诒：遗留；厥：他的；谋：计谋。原意为留下使天下安定的谋略。后也指为子孙的将来善做安排。","source":{"text":"诒厥孙谋，以燕翼子。","book":"《诗经·大雅·文王有声》"}},{"id":41123,"word":"诓言诈语","pinyin":"kuāng yán zhà yǔ","abbr":"kyzy","explanation":"诓：欺骗；诈：骗人。欺骗人的话。","source":{"text":"有那等先生，自夸自会，盗听偷学，诓言诈语，骗口张舌，世俗人。","book":"明·无名氏《李云卿》第二折"}},{"id":41124,"word":"试才录用","pinyin":"shì cái lù yòng","abbr":"scly","explanation":"指根据他人的能力大小给予录用。","source":{"text":"弃暇录用。","book":"南朝·梁·丘迟《与陈伯之书》"},"example":{"text":"请放心，我们会～的。"},"similar":["量才录用"],"usage":"作谓语、定语、宾语；指量才录用","story":["宋朝时期，眉州苏洵要为苏小妹订亲，很多学子纷纷慕名去提亲，苏小妹仅仅只看上了秦观的求婚文章，但决定亲自见面考试他，借上岳庙烧香之机当场出题考秦观，满意后觉得嫁他。新婚之夜要秦观过三关才能进洞房"]},{"id":41125,"word":"试金石","pinyin":"shì jīn shí","abbr":"sjs","explanation":"一种黑色坚硬的石块，用黄金在上面画一条纹，就可以看出黄金的成色。比喻精确可靠的检验方法。","source":{"text":"这里，端的，现放着试金石。","book":"元·马致远《荐福碑》第四折"},"example":{"text":"自古英雄豪杰，不经心志之拂乱，未必能奋发有为，故敌国外患之来，实磨砺英豪之一块～也。","book":"蔡东藩《清史演义》第二回"},"usage":"作主语、宾语、定语；指可靠的检验方"},{"id":41126,"word":"诗中有画","pinyin":"shī zhōng yǒu huà","abbr":"szyh","explanation":"形容长于描写景物的诗，使读者如置身图画当中。也形容诗的意境非常优美。","source":{"text":"味摩诘之诗，诗中有画；观摩诘之画，画中有诗。","book":"宋·苏轼《东坡题跋·书摩诘〈蓝关烟雨图〉》"},"example":{"text":"今观此句，古人所谓“～”果真不错。","book":"清·李汝珍《镜花缘》第九十回"},"usage":"作谓语、宾语；指诗文优美"},{"id":41127,"word":"诗中有画，画中有诗","pinyin":"shī zhōng yǒu huà，huà zhōng yǒu shī","abbr":"szyhhzys","explanation":"形容长于描写景物的诗，使读者如置身图画当中。也形容诗的意境非常优美。","source":{"text":"味摩诘之诗，诗中有画；观摩诘之画，画中有诗。","book":"宋·苏轼《东坡题跋·书摩诘〈蓝关烟雨图〉》"},"example":{"text":"弟独谓～，因摩诘一身兼此二妙，故连合言之。","book":"明·张岱《与包严介》"}},{"id":41128,"word":"诗书发冢","pinyin":"shī shū fà zhǒng","abbr":"ssfz","explanation":"比喻口是心非、言行不一的伪君子作风。","source":{"text":"儒以诗礼发冢。","book":"战国·宋·庄周《庄子·外物》"},"example":{"text":"不止～，《周官》资篡而已。","book":"清·高珩《序》"},"similar":["诗礼发冢"],"usage":"作谓语、定语；指伪君子作风"},{"id":41129,"word":"诗书礼乐","pinyin":"shī shū lǐ yuè","abbr":"ssly","explanation":"六代儒家六经的名称，即《诗经》、《尚书》、《周礼》、《仪礼》、、《礼记》、《乐经》。","source":{"text":"乐正崇四术，立四教，顺先王《诗》、《书》、《礼》、《乐》以造士。","book":"《礼记·王制》"},"example":{"text":"～，定自孔子，发明章句，始于子夏。","book":"清·朱彝尊《文水县卜子祠堂记》"},"similar":["诗书礼易"],"usage":"作主语、宾语、定语；用于书面语"},{"id":41130,"word":"诗云子曰","pinyin":"shī yún zǐ yuè","abbr":"syzy","explanation":"《诗经》所说和孔子所言。二者均为历代儒者遵奉的信条。因用以泛指儒家言论或经典著作。","source":{"text":"见那诗云子曰、者也之乎的人，他就摇首闭目，只与云锷颖臭味相投。","book":"明·刘璋《凤凰池》第一回"},"example":{"text":"刘绍棠《蒲柳人家》：“老秀才又酸气冲天，开口～，闭口之乎者也。”"},"similar":["子曰诗云"],"usage":"作宾语、定语；用于书面语"},{"id":41131,"word":"诗以言志","pinyin":"shī yǐ yán zhì","abbr":"syyz","explanation":"用诗来表达自己的单向和决心。","source":{"text":"诗言志，歌永言。","book":"《尚书·舜典》"},"example":{"text":"～，赋以敷陈，箴铭诔颂，咸各有伦。","book":"南朝·宋·谢灵运《山居赋》"},"similar":["诗以道志"],"usage":"作宾语、定语；用于书面语"},{"id":41132,"word":"诗以道志","pinyin":"shī yǐ dào zhì","abbr":"sydz","explanation":"用诗歌表达自己的思想和志趣。","source":{"text":"。《诗》以道志，《书》以道事，《礼》以道行，《乐》以道和，《易》以道阴阳，《春秋》以道名分。","book":"《庄子·天下》"},"similar":["诗以言志"],"usage":"作宾语、定语；用于书面语"},{"id":41133,"word":"诗家三昧","pinyin":"shī jiā sān mèi","abbr":"sjsm","explanation":"指作诗的诀窍。","source":{"text":"三昧，《大智度论》：‘善心一处住不动，是名三昧。’又：‘一切禅定，亦名定，亦名三昧。’此用以指诗家悟人之境地。","book":"宋·陆游《九月一日夜读诗稿有感走笔作歌》：“诗家三昧忽见前，屈贾在眼元历历。”钱仲联校注"},"example":{"text":"余尝观荆浩论山水，而悟～，曰远人无目，远水无波，远山无皴。","book":"清·王士禛《香祖笔记》卷六"},"usage":"作宾语、定语；用于书面语"},{"id":41134,"word":"诗庭之训","pinyin":"shī tíng zhī xùn","abbr":"stzx","explanation":"指父训。"},{"id":41135,"word":"诗情画意","pinyin":"shī qíng huà yì","abbr":"sqhy","explanation":"像诗画里所描摩的能给人以美感的意境。","source":{"text":"诗情画意，只在阑杆外，雨露天低生爽气，一片吴山越水。","book":"宋·周密《清平乐·横玉亭秋倚》词"},"example":{"text":"放棹西湖发浩歌，～两如何。","book":"清·袁枚《随园诗话补遗》卷五"},"similar":["画情诗意"],"opposite":["平淡无奇"],"usage":"作主语、宾语、定语；用于文章等"},{"id":41136,"word":"诗成得袍","pinyin":"shī chéng dé páo","abbr":"scdp","explanation":"夺锦：相传武则天游龙门，命群臣赋诗，先成者赏锦袍。指科举及第或竞赛优胜者。也用以称赞文才出众或被宠赐。","source":{"text":"武后游洛南龙门，诏从臣赋诗，左史东方虬诗先成，后赐锦袍，之问俄顷献，后鉴之嗟赏，更夺袍以赐。","book":"《新唐书·宋之问传》"}},{"id":41137,"word":"诗有别才","pinyin":"shī yǒu bié cái","abbr":"sybc","explanation":"别才：特殊的才能。指诗写得好，表现出作者的特殊才能。","source":{"text":"夫诗有别才，非关书也；诗有别趣，非关理也。","book":"宋·严羽《沧浪诗话·诗辨》"}},{"id":41138,"word":"诗朋酒侣","pinyin":"shī péng jiǔ lǚ","abbr":"spjl","explanation":"侣：伴侣，同伴。作诗饮酒的朋友。同“诗朋酒友”。","source":{"text":"且开怀，共诗朋酒侣欢宴。”明·刘兑《金童玉女娇红记》“诗朋酒侣，向此地游嬉。","book":"元·无名氏《小孙屠》第二出"},"example":{"text":"到处～。","book":"明·徐复祚《投梭记·叙饮》"},"similar":["诗朋酒友","诗朋酒侪"],"usage":"作宾语、定语；用于书面语"},{"id":41139,"word":"诗朋酒侪","pinyin":"shī péng jiǔ chái","abbr":"spjc","explanation":"侪：辈。在一起写诗喝酒的朋友。","source":{"text":"同消遣，诗朋酒侪尽堪尽月盘桓。","book":"明·叶宪祖《鸾鎞记·论心》"},"similar":["诗朋酒友","诗朋酒侣"],"usage":"作宾语、定语；用于书面语"},{"id":41140,"word":"诗朋酒友","pinyin":"shī péng jiǔ yǒu","abbr":"spjy","explanation":"作诗饮酒的朋友。","source":{"text":"但有个诗朋酒友共开尊，少不得倚玉偎香珠翠拥。","book":"明·冯惟敏《粉蝶儿·李争冬有犯》套曲"},"example":{"text":"我一心待相伴著～，我其实不爱您紫绶金貂。","book":"明·无名氏《东篱赏菊》第二折"},"similar":["诗朋酒侣","诗朋酒侪"],"usage":"作宾语、定语；指在一起写诗喝酒的朋友"},{"id":41141,"word":"诗礼之家","pinyin":"shī lǐ zhī jiā","abbr":"slzj","explanation":"诗：指《诗经》；礼：指《周祀》、《仪礼》、《礼记》。旧指世代读书讲究礼教的人家。","source":{"text":"因仍苟且，多为惜财之小而忘大义，奈何诗礼之家亦如此是耶！","book":"明·郎英《七修类稿》卷十六"},"example":{"text":"明·冯梦龙《喻世明言》第11卷：“其父赵伦，字文宝，母亲刘氏，都是世代～。”"},"similar":["书香门第","诗礼人家"],"usage":"作宾语；指读书人的家"},{"id":41142,"word":"诗礼之训","pinyin":"shī lǐ zhī xùn","abbr":"slzx","explanation":"子女遵承父亲的教诲。","source":{"text":"尝独立，鲤趋而过庭。曰：‘学《诗》乎？’对曰：‘未也’。‘不学《诗》，无以言。’鲤退而学《诗》。他日，又独立，鲤趋而过庭。曰：‘学《礼》乎？’对曰：‘未也。’‘不学《礼》，无以立。’鲤退而学《礼》。","book":"《论语·季氏》"},"example":{"text":"子承父教，云～。","book":"宋·胡继宗《书言故事·父母》"},"similar":["诗庭之训"],"usage":"作宾语；指子女遵从父母的教诲","story":["春秋时期，孔子生下儿子伯鱼后，十分关心他的教育，一次见儿子从庭前走过，就问他学过《诗经》没有？伯鱼回答没有，孔子说不学《诗经》就不会说话，伯鱼立刻去读《诗经》。后来，孔子又要求伯鱼学《周礼》、《仪礼》等著作"]},{"id":41143,"word":"诗礼人家","pinyin":"shī lǐ rén jiā","abbr":"slrj","explanation":"世代读书以传统封建礼教为行为准则的人家。","source":{"text":"好个叶太太，到底是诗礼人家出身，知道规矩礼法。","book":"清·吴研人《二十年目睹之怪现状》第九十一回"},"example":{"text":"‘你看，全是这样的子弟，所谓～，书香人家，还有什么希望？’琴感慨地说。","book":"巴金《秋》三"},"similar":["诗礼之家"],"usage":"作宾语；指读书人的家"},{"id":41144,"word":"诗礼传家","pinyin":"shī lǐ chuán jiā","abbr":"slcj","explanation":"指世代皆读书习礼。","source":{"text":"诗礼传家忝儒裔，先君不幸早倾逝。","book":"元·柯丹丘《荆钗记·会讲》"},"example":{"text":"茅盾《子夜》：“冯大爷，是有面子的地主，～，怎么听了老何的一篇混帐话，就居然心中摇摇起来了呢？”"},"usage":"作宾语、定语；用于书面语"},{"id":41145,"word":"诗礼发冢","pinyin":"shī lǐ fā zhǒng","abbr":"slfz","explanation":"一边念着《诗经》、《周礼》，一边去挖坟盗墓。原是讽刺儒家倡导仁义的虚伪性。后用以讽刺口是心非、言行不一的伪君子作风。","source":{"text":"儒以《诗》、《礼》发冢，大儒胪传曰：‘东方作矣，事之何苦？’小儒曰：‘未解裙襦，口中有珠。’","book":"《庄子·外物》"},"similar":["诗书发冢"],"usage":"作宾语、定语；用于书面语"},{"id":41146,"word":"诗礼簪缨","pinyin":"shī lǐ zān yīng","abbr":"slzy","explanation":"诗礼：《诗经》和《周礼》，指礼教；簪缨：比喻高官。讲究礼教的高官显宦。","source":{"text":"然后携你到那昌明隆盛之邦，诗礼簪缨之族，花柳繁华之地，温柔富贵之乡那里去安身乐业。","book":"清·曹雪芹《红楼梦》第一回"}},{"id":41147,"word":"诗肠鼓吹","pinyin":"shī chá gǔ chuì","abbr":"scgc","explanation":"鼓吹：乐器合奏。特指听到黄鹂鸣声，可以引起诗兴。","source":{"text":"戴颙春携双柑斗酒，人问何之，曰：‘往听黄鹂声，此俗耳针砭，诗肠鼓吹，汝知之乎！’","book":"唐·冯贽《云仙杂记》卷二"},"usage":"作宾语；用于作诗"},{"id":41148,"word":"诗言志","pinyin":"shī yán zhī","abbr":"syz","explanation":"用诗来表达自己的意向和决心。","source":{"text":"诗言志，歌咏言，声依永，律和声。","book":"语出《书·舜典》"}},{"id":41149,"word":"诗词歌赋","pinyin":"shī cí gē fù","abbr":"scgf","explanation":"文章的四种形式。指作文。","source":{"text":"最妙是古今书史无所不通，做出来的诗词歌赋直欲压倒古人。","book":"清·荑荻散人《玉娇梨》第六回"},"example":{"text":"形容才子不是常用‘～，无所不晓，琴棋书画，无所不通’吗？","book":"章诒和《往事并不如烟·君子之交》"},"usage":"作主语、宾语、定语；指文章"},{"id":41150,"word":"诗酒征逐","pinyin":"shī jiǔ zhēng zhú","abbr":"sjzz","explanation":"征逐：朋友之间相互邀请宴饮。指互相邀约，饮酒作诗。","source":{"text":"今夫平居里巷相慕悦，酒食游戏相征逐。","book":"唐·韩愈《柳子厚墓志铭》"}},{"id":41151,"word":"诗酒朋侪","pinyin":"shī jiǔ péng chái","abbr":"sjpc","explanation":"侪：等辈，同类的人。作诗饮酒的朋友。同“诗朋酒友”。","source":{"text":"同消遣，诗酒朋侪尽堪尽日盘桓。","book":"明·叶宪祖《鸾鎞记》第二出"}},{"id":41152,"word":"诗酒风流","pinyin":"shī jiǔ fēng liú","abbr":"sjfl","explanation":"作诗饮酒。古人以此为风流韵事，故称。","source":{"text":"身外虚名一羽轻，封侯何必胜躬耕。田园活计浑闲在，诗酒风流属老成。","book":"金·元好问《鹧鸪天》词"},"example":{"text":"我两个便‘退避三舍’，搬到那三间南倒座去同住，尽着你在这屋里嘲风弄月，诗酒风流，我两个绝不敢来过问。","book":"清·文康《儿女英雄传》第三十回"},"usage":"作宾语、定语；用于书面语"},{"id":41153,"word":"诘屈磝碻","pinyin":"jié qū bìng zhòu","abbr":"jqaq","explanation":"形容语言生硬难懂。","source":{"text":"是岁首士以江西优人来，登场歌舞，皆诘屈磝碻，不可听。","book":"清·朱克敬《瞑庵杂识》卷一"},"similar":["诘屈聱牙"],"usage":"作谓语；用于说话或文章"},{"id":41154,"word":"诘屈聱牙","pinyin":"jié qū áo yá","abbr":"jqay","explanation":"诘屈：同“佶屈”，曲折，引申为不顺畅；聱牙：读起来拗口、别扭。形容文字晦涩艰深，难懂难读。","source":{"text":"周诰殷盘，佶屈聱牙。","book":"唐·韩愈《进学解》"},"example":{"text":"但传到后世，这种官话或普通话却变成～的古语了。","book":"朱自清《尚书第三》"},"similar":["诘曲聱牙"],"usage":"作宾语、定语；指文章与说话"},{"id":41155,"word":"诘屈謷牙","pinyin":"jié qū dà yá","abbr":"jqay","explanation":"形容文句艰涩，不通顺畅达。同“诘曲聱牙”。","source":{"text":"其间独照之匠，若荆川、遵岩、震川，变秦汉为欧曾，易诘屈謷牙为字顺文从。","book":"清·陈田《〈明诗纪事戊签〉序》"},"similar":["诘曲聱牙","诘诎聱牙","佶屈聱牙"],"opposite":["琅琅上口","字顺文从"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":41156,"word":"诘戎治兵","pinyin":"jié róng zhì bīng","abbr":"jrzb","explanation":"指整治军事。","source":{"text":"其克诘尔戎兵。","book":"《尚书·立政》"},"example":{"text":"故古人～，当太平之世，犬兢兢焉。","book":"明·张居正《与操江宋阳山书》"},"usage":"作谓语；指整治军事"},{"id":41157,"word":"诘曲聱牙","pinyin":"jié qǔ áo yá","abbr":"jqay","explanation":"形容文句艰涩，不通顺畅达。","source":{"text":"予窃怪世之为文者，不为不多，骋新奇者，钩摘隐伏，变更庸常，甚至不可句读，且曰：不诘曲聱牙非古文也。","book":"明·宋濂《文原》"},"example":{"text":"审其往来踪迹，以察知周召二公陈诰纳诲心事，于～中而如闻其告语。","book":"清·魏源《章教谕〈强恕斋书〉序》"},"similar":["诘屈聱牙","诘诎聱牙"],"opposite":["字顺文从"],"usage":"作宾语、定语；指文章与说话"},{"id":41158,"word":"诘究本末","pinyin":"jié jiū běn mò","abbr":"jjbm","explanation":"诘究：详细追究；本末：缘由。详细追究事物的始末情由。","source":{"text":"至德乃诘究本末，理直者，密为奏，终不显私恩。","book":"《新唐书·戴至德传》"}},{"id":41159,"word":"诘诎聱牙","pinyin":"jié qū áo yá","abbr":"jqay","explanation":"形容文句艰涩，不通顺畅达。同“诘曲聱牙”。","source":{"text":"且又日鼓舞之以报章，间协助之以书籍，中之文词，虽诘诎聱牙，难于尽晓，顾究亦输入文明之利器也。","book":"鲁迅《集外集拾遗补编·破恶声论》"},"similar":["诘屈謷牙","佶屈聱牙"],"opposite":["琅琅上口"],"usage":"作谓语、定语、补语；用于书面语"},{"id":41160,"word":"诚心实意","pinyin":"chéng xīn shí yì","abbr":"cxsy","explanation":"形容十分真挚诚恳。","source":{"text":"而其诚心实意之所在，以为不如是则无以济其私而满其欲也。","book":"明·王守仁《传习录》中卷"},"example":{"text":"他～地想要你跟他过日子。","book":"姚雪垠《长夜》"},"similar":["真心实意","诚心诚意"],"opposite":["三心二意"],"usage":"作宾语、定语、状语；指真诚"},{"id":41161,"word":"诚心敬意","pinyin":"chéng xīn jìng yì","abbr":"cxjy","explanation":"形容对人十分真诚和有礼貌。","source":{"text":"你道是诚心敬意亲呈进，俺那里知重知轻在您行。","book":"明·无名氏《下西洋》第三折"},"similar":["诚心实意"],"usage":"作宾语、定语、状语；用于为人"},{"id":41162,"word":"诚心正意","pinyin":"chéng xīn zhèng yì","abbr":"cxzy","explanation":"诚：真诚。心意真诚恳切。形容对人十分真挚诚恳。亦作“诚心诚意”。","source":{"text":"皇天有意为斯文，教人从诚心正意修根本，以至齐家治国为标准。","book":"元·宫大用《范张鸡黍》第一折"},"example":{"text":"则为他治国齐家存妙策，～请贤臣。","book":"明·无名氏《孟母三移》第四折"},"similar":["诚心实意"],"usage":"作宾语、定语、状语；用于为人"},{"id":41163,"word":"诚心诚意","pinyin":"chéng xīn chéng yì","abbr":"cxcy","explanation":"形容十分真挚诚恳。","source":{"text":"开心见诚，无所隐伏。","book":"《后汉书·马援传》"},"example":{"text":"大远的～来了，岂有个不叫你见个真佛儿去的呢？","book":"清·曹雪芹《红楼梦》第六回"},"similar":["真心实意"],"opposite":["虚情假意"],"usage":"作谓语、宾语、定语；指十分真挚","story":["贾府的远房亲戚刘姥姥见女儿女婿的生活十分艰难，就亲自带着外孙板儿到贾府告援。她先去拜见贾府管家周瑞妻子，周瑞妻子猜着她的来意，说：“姥姥你放心。大远的诚心诚意来了，岂有个不教你见个真佛去的呢。”于是带她去见王夫人及王熙凤"]},{"id":41164,"word":"诚恐诚惶","pinyin":"chéng kǒng chéng huáng","abbr":"ckch","explanation":"诚：确实；惶：害怕。惶恐不安。指非常小心谨慎以至于惶恐不安。","source":{"text":"念臣棼诚恐诚惶，壍江城遭寇与拦当。","book":"明·汤显祖《南柯记·朝议》"},"similar":["诚惶诚恐","诚惶诚惧"],"usage":"作谓语、定语、状语；带有幽默或讽刺"},{"id":41165,"word":"诚惶诚恐","pinyin":"chéng huáng chéng kǒng","abbr":"chck","explanation":"诚：实在，的确；惶：害怕；恐：畏惧。非常小心谨慎以至达到害怕不安的程度。","source":{"text":"奉职无效，久窃禄位，令功臣怀愠，诚惶诚恐。","book":"汉·杜诗《乞退郡疏》"},"example":{"text":"一些成了惊弓之鸟的部员们算也～地先后把那段危险的地面通过了。","book":"郭沫若《北伐途中》二十一"},"similar":["惊惶失措","惶恐不安","胆战心惊"],"opposite":["处之泰然"],"usage":"作谓语、定语、状语；带有幽默或讽刺"},{"id":41166,"word":"诚惶诚惧","pinyin":"chéng huáng chéng jù","abbr":"chcj","explanation":"诚：确实；惶：害怕；惧：畏惧。惶恐不安。指非常小心谨慎以至于惶恐不安。","source":{"text":"真君事迹三卷，谨随表上进以闻，臣诚惶诚惧，顿首顿首，谨言。","book":"宋·张君房《云笈七签》第103卷"},"similar":["诚惶诚恐"],"usage":"作谓语、定语、状语；带有幽默或讽刺"},{"id":41167,"word":"诚意正心","pinyin":"chéng yì zhèng xīn","abbr":"cyzx","explanation":"诚：真心实意；正：纠正。有真诚的心意才能端正心思。","source":{"text":"欲正其心者，先诚其意。","book":"西汉·戴圣《礼记·大学》"},"usage":"作宾语、定语；用于书面语"},{"id":41168,"word":"诚欢诚喜","pinyin":"chéng huān chéng xǐ","abbr":"chcx","explanation":"打心里非常喜欢。","source":{"text":"诚欢诚喜，无所恨也。","book":"《后汉书·刘盆子传》"},"usage":"作谓语；指高兴"},{"id":41169,"word":"诚至金开","pinyin":"chéng zhì jīn kāi","abbr":"czjk","explanation":"精诚所至，金石为开。","source":{"text":"事在人为，诚至金开，自有曙光逢。","book":"杨靖宇《中朝民族联合抗日歌》"},"similar":["精诚所至，金石为开"],"usage":"作宾语、定语；用于书面语"},{"id":41170,"word":"诛一警百","pinyin":"zhū yī jǐng bǎi","abbr":"zyjb","explanation":"诛：杀死；警：警告。处死一个人，借以警戒许多人。","source":{"text":"其有所取也，以一警百，吏民皆服，恐惧改行自新。","book":"《汉书·尹翁归传》"},"similar":["杀一警百"],"usage":"作谓语、宾语、定语；指警戒别人"},{"id":41171,"word":"诛不避贵","pinyin":"zhū bù bì guì","abbr":"zbbg","explanation":"诛：杀死；贵：富贵的人。惩治罪人没躲避富贵的人。形容法制之下不分贵贱。","source":{"text":"诛不避贵，赏不遗贱；不淫于乐，不遁于哀；尽智导民，而不伐焉，劳力岁事，而不责焉。","book":"《晏子春秋·内篇问上》"},"usage":"作宾语、定语；用于书面语"},{"id":41172,"word":"诛凶殄逆","pinyin":"zhū xiōng tiǎn nì","abbr":"zxtn","explanation":"诛：杀死；殄：灭绝；逆：叛逆。讨伐消灭作恶叛乱的人。","source":{"text":"治军之政，谓治边境之事，匡教大乱之道，以威武为政，诛暴讨逆，所以存国家安社稷之计。","book":"三国·蜀·诸葛亮《便宜十六策·治军》"},"example":{"text":"圣人诛凶殄逆，济人宁乱，必资刑杀，以清天下。（唐·陈子昂《请措刑科》）"},"similar":["诛凶讨逆","诛暴讨逆"],"usage":"作谓语、定语、状语；用于书面语"},{"id":41173,"word":"诛凶讨逆","pinyin":"zhū xiōng tǎo nì","abbr":"zxtn","explanation":"诛：杀死；逆：叛逆。讨伐消灭作恶叛乱的人。","source":{"text":"治军之政，谓治边境之事，匡教大乱之道，以威武为政，诛暴讨逆，所以存国家安社稷之计。","book":"三国·蜀·诸葛亮《便宜十六策·治军》"},"example":{"text":"身为上将，统领大军，奋武扬威，～。（明·姚茂良《精忠记》第八出）"},"similar":["诛凶殄逆","诛暴讨逆"],"usage":"作谓语、定语、状语；用于书面语"},{"id":41174,"word":"诛尽杀绝","pinyin":"zhū jìn shā jué","abbr":"zjsj","explanation":"诛；斩。杀得一个不留。","source":{"text":"将俺老相国伍奢父子，满门家属，诛尽杀绝。","book":"元·李寿卿《伍员吹箫》第一折"},"example":{"text":"贵府退贼之功，兄弟亦早有所闻。但弟只怕不能～，将来一发而不可收拾。","book":"清·李宝嘉《官场现形记》"},"similar":["斩尽杀绝","斩草除根"],"usage":"作谓语；指全部杀光"},{"id":41175,"word":"诛心之律","pinyin":"zhū xīn zhī lǜ","abbr":"zxzl","explanation":"诛：惩罚。指不问罪行，只根据其用心以认定罪状。也指揭穿动机的评论。","source":{"text":"《春秋》之义，原情定过，赦事诛意，故许止虽弑君而不罪，赵盾以纵贼而见书。","book":"《后汉书·霍谞传》"},"example":{"text":"姑不用～，只就现在脱逃，也该重鞭一百！（清·吕熊《女仙外史》第十回）"},"similar":["诛心之论"],"usage":"作宾语；用于书面语"},{"id":41176,"word":"诛心之论","pinyin":"zhū xīn zhī lùn","abbr":"zxzl","explanation":"诛：惩罚。指不问罪行，只根据其用心以认定罪状。也指揭穿动机的评论。","source":{"text":"《春秋》之义，原情定过，赦事诛意，故许止虽弑君而不罪，赵盾以纵贼而见书。","book":"《后汉书·霍谞传》"},"example":{"text":"你那里晓得，那时他虽满嘴只说未将剪子带来，其实只想以手代剪。这个“撕”字乃～，如何不切！","book":"清·李汝珍《镜花缘》第九十回"},"similar":["诛心之律"],"usage":"作宾语；指揭穿别人动机的批评和深刻的评论"},{"id":41177,"word":"诛意之法","pinyin":"zhū yì zhī fǎ","abbr":"zyzf","explanation":"诛：惩罚，责备。以意图和动机论罪，不问实际结果如何。也指深刻的议论","source":{"text":"夹子之言，亦《春秋》诛意之法也。","book":"春秋·鲁·孔丘《论语·宪问》：“臧武仲以防求为后于鲁”集注"},"usage":"作宾语；用于书面语"},{"id":41178,"word":"诛故贳误","pinyin":"zhū gù shì wù","abbr":"zgsw","explanation":"指严惩故意犯罪的人，宽赦无意中犯错误的人。","source":{"text":"故曰：刑故无小，宥过无大。圣君原心省意，故诛故贳误。","book":"汉·王充《论衡·答佞》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":41179,"word":"诛暴讨逆","pinyin":"zhū bào tǎo nì","abbr":"zbtn","explanation":"诛：讨伐。讨伐凶暴、叛逆之人。","source":{"text":"治军之政，谓治边境之事，匡救大乱道，以威武为政，诛暴讨逆，所以存国家安社稷之计。","book":"三国·蜀·诸葛亮《便宜十六策·治军》"},"similar":["诛凶殄逆"],"usage":"作谓语、定语、状语；指英雄"},{"id":41180,"word":"诛求不已","pinyin":"zhū qiú bù yǐ","abbr":"zqby","explanation":"指勒索，强取没完没了。同“诛求无已”。","source":{"text":"无丁之家，诛求不已；有丁之户，诈称死亡。","book":"清·张廷玉《明史·范济传》"},"similar":["诛求无已"],"usage":"作谓语、分句；指贪心不足"},{"id":41181,"word":"诛求无厌","pinyin":"zhū qiú wú yàn","abbr":"zqwy","explanation":"诛求：需索；无厌：不停止。。指勒索诈取没完没了。","source":{"text":"经敝邑褊小，介于大国，诛求无时，是以不敢宁居。","book":"《左传·襄公三十一年》"},"example":{"text":"湖广平章政事要束木贪纵淫虐，～。","book":"《元史·乌古孙泽传》"},"similar":["诛求无已"],"usage":"作谓语、定语；指干坏事"},{"id":41182,"word":"诛求无已","pinyin":"zhū qiú wú yǐ","abbr":"zqwy","explanation":"诛求：需索；已：停止。指勒索诈取没完没了。","source":{"text":"经敝邑褊小，介于大国，诛求无时，是以不敢宁居。","book":"《左传·襄公三十一年》"},"example":{"text":"另外的错误观点，就是不顾人民困难，只顾政府和军队的需要，竭泽而渔，～。","book":"毛泽东《抗日时期的经济问题和财政问题》"},"similar":["贪得无厌","得寸进尺","欲壑难填"],"opposite":["廉政自守","两袖清风"],"usage":"作谓语、分句；指贪心不足"},{"id":41183,"word":"诛求无度","pinyin":"zhū qiú wú dù","abbr":"zqwd","explanation":"敛取、需索财贿没有限度。","source":{"text":"擅兴全师，僭为正乐，侵辱中使，擅止制囚，杀戮不辜，诛求无度，臣故定谥为厉。","book":"《旧唐书·于頔传》"},"example":{"text":"洋人本性贪劣，～，这点你心里要清楚。","book":"唐浩明《曾国藩第二部·野焚》第五章三"},"similar":["诛求不已"],"usage":"作谓语、定语；指贪心不足"},{"id":41184,"word":"诛求无时","pinyin":"zhū qiú wú shí","abbr":"zqws","explanation":"诛求：需索。指勒索诈取没完没了。","source":{"text":"经敝邑褊小，介于大国，诛求无时，是以不敢宁居。","book":"《左传·襄公三十一年》"},"similar":["诛求无度"],"usage":"作谓语、定语；指贪心不足"},{"id":41185,"word":"诛锄异己","pinyin":"zhū chú yì jǐ","abbr":"zcyj","explanation":"诛：杀；锄：铲除。指消灭和清除在政治上反对自己或与自己意见不合的人。","source":{"text":"齐武帝崩，明帝作相，诛锄异己，季直不能阿意，明帝颇忌之，乃出为辅国长史、北海太守。","book":"《梁书·止足·陶季直传》"},"example":{"text":"而镇压人民的反对，竟不惜采用最卑劣无耻的手段来～。（郭沫若《悼闻一多》）"},"similar":["党同伐异"],"usage":"作谓语、状语；指人专制"},{"id":41186,"word":"话不在行","pinyin":"huà bù zài háng","abbr":"hbzx","explanation":"指人说外行话，话不投机。","example":{"text":"你～，别人一听就知是外行。"},"similar":["话不投机"],"usage":"作宾语、定语；用于人说话"},{"id":41187,"word":"话不投机","pinyin":"huà bù tóu jī","abbr":"hbtj","explanation":"投机：意见相合。形容话说不到一起。","source":{"text":"吃紧的理不服人，言不谙典，话不投机。","book":"元·王子一《误入桃源》第三折"},"example":{"text":"宝玉听来，～，便靠在桌上睡去。","book":"清·曹雪芹《红楼梦》第一一三回"},"similar":["语不投机"],"opposite":["一拍即合"],"usage":"作谓语；形容话说不到一起"},{"id":41188,"word":"话不投机半句多","pinyin":"huà bù tóu jī bàn jù duō","abbr":"hbtjbjd","explanation":"彼此心意不同，谈话不能相契，干脆就沉默不言。","source":{"text":"这日大家畅饮，正是‘酒逢知己千杯少，话不投机半句多’，不知不觉，喝了个酩酊大醉。","book":"清·贪梦道人《彭公案》第26回"},"example":{"text":"俗话说：酒逢知己千杯少，～。"},"usage":"作宾语、定语、分句；用于不投合的场面"},{"id":41189,"word":"话不相投","pinyin":"huà bù xiāng tóu","abbr":"hbxt","explanation":"犹言话不投机。形容话说不到一起。","source":{"text":"我和他话不相投，我可便见他呵。","book":"元·无名氏《望江亭》第三折"},"example":{"text":"俗话说：～半句多。"},"similar":["话不投机"],"opposite":["一拍即合"],"usage":"作谓语；形容话说不到一起"},{"id":41190,"word":"话不虚传","pinyin":"huà bù xū chuán","abbr":"hbxc","explanation":"虚：假。流传的话不是假的。","source":{"text":"话不虚传，果然岳家兵厉害。","book":"清·钱彩《说岳全传》第三十回"},"example":{"text":"果然～。”（清·夏敬渠《野叟曝言》第六十七回","book":"只见门面宽广，房屋众多，槽道齐全，店家和气，暗道"},"similar":["名不虚传"],"usage":"作宾语、定语；用于口语"},{"id":41191,"word":"话中带刺","pinyin":"huà zhōng dài cì","abbr":"hzdc","explanation":"指话中包含着讥笑和讽刺。","source":{"text":"因此待亲家母面上冷落，话中带刺。","book":"清·李绿园《歧路灯》第85回"},"example":{"text":"他～，出口伤人。"},"similar":["话里带刺"],"usage":"作谓语、宾语；指讥讽"},{"id":41192,"word":"话中有话","pinyin":"huà zhōng yǒu huà","abbr":"hzyh","explanation":"话里含有别的意思。","source":{"text":"邢夫人等听了话中有话，不想到自己不令凤姐便宜行事，反说：‘凤丫头果然有些不用心。’","book":"清·曹雪芹《红楼梦》第110回"},"example":{"text":"老宫听得出这～，心里也自然明白了几分。","book":"峻青《海啸》第四章"},"similar":["言外之意","弦外之音"],"opposite":["直言不讳"],"usage":"作宾语；指说话不直接，让对方体会","story":["贾母去世，贾府上下为之操办丧事，因为刚被抄完家，财力不济。王熙凤虽然有病，但还是要去操办。丫鬟鸳鸯坚持要大操大办，让老太太风光而去，邢夫人等听了话中有话，不想到自己不令凤姐便宜行事，希望王熙凤不要插手"]},{"id":41193,"word":"话言话语","pinyin":"huà yán huà yǔ","abbr":"hyhy","explanation":"犹谈话。","source":{"text":"并且话言话语间，很不满意郭振山。","book":"柳青《创业史》第二部第七章"},"example":{"text":"听其～，他不想干了。"},"similar":["言下之意"],"usage":"作宾语、定语；指言下之意，用于口语"},{"id":41194,"word":"话里带刺","pinyin":"huà lǐ dài cì","abbr":"hldc","explanation":"指话中包含着讥笑和讽刺。同“话中带刺”。","source":{"text":"升级一听，话里带刺，来者不善。","book":"范乃仲《小技术员战服神仙手》"},"similar":["话中带刺","话里有刺"],"usage":"作谓语、宾语；指讥讽"},{"id":41195,"word":"话里有刺","pinyin":"huà lǐ yǒu cì","abbr":"hlyc","explanation":"指话中包含着讥笑和讽刺。同“话中带刺”。","source":{"text":"郭全海听见话里有刺，把筷子放下，但还是按下心头的火。","book":"周立波《暴风骤雨》第一部十"},"similar":["话里带刺","话中带刺"],"usage":"作谓语、宾语；指讥讽"},{"id":41196,"word":"话里有话","pinyin":"huà lǐ yǒu huà","abbr":"hlyh","explanation":"话里含有别的意思。","source":{"text":"邢夫人等听了话中有话，不想到自己不令凤姐便宜行事，反说：‘凤丫头果然有些不用心。’","book":"清·曹雪芹《红楼梦》第第一百十回"},"example":{"text":"她听出～，怕嚷下去再被人掀出丑来，就咕噜着走了。","book":"冯德英《苦菜花》第十四章"},"similar":["话中有话","一语双关"],"opposite":["直言不讳"],"usage":"作宾语；同“话中有话”"},{"id":41197,"word":"话里藏阄","pinyin":"huà lǐ cáng jiū","abbr":"hlcj","explanation":"话里藏着哑谜儿。","source":{"text":"宋江不晓得梢公话里藏阄，在船舱里悄悄的和两个公人说：‘也难得这个梢公救了我们三个性命。’","book":"《水浒传》第三七回"},"similar":["话里有话"],"usage":"作宾语；同“话中有话”"},{"id":41198,"word":"话长说短","pinyin":"huà cháng shuō duǎn","abbr":"hcsd","explanation":"评论他人的好坏是非。","source":{"text":"起初还恐怕雌鬼要话长说短，遮遮掩掩的瞒着他。","book":"清·张南庄《何典》第五回"},"similar":["说长道短"],"usage":"作谓语、宾语、定语；指嘴多"},{"id":41199,"word":"诞妄不经","pinyin":"dàn wàng bù jīng","abbr":"dwbj","explanation":"荒诞虚妄，不合常理。","source":{"text":"按骥上此疏时，思任发已逃去不获，乃为诞妄不经之语。","book":"明·沈德符《野获编·释道·夷僧行法》"},"example":{"text":"首致诘难，以为～之说。","book":"清·梁启超《罗兰夫人传》"},"similar":["荒诞不经"],"usage":"作谓语、定语；指荒谬"},{"id":41200,"word":"诞幻不经","pinyin":"dàn huàn bù jīng","abbr":"dhbj","explanation":"怪诞虚幻，不合常理。","source":{"text":"夏商以前，仅数十种，率皆诞幻不经，当时具悉其伪。","book":"明·胡应麟《少室山房笔丛·经籍会通三》"},"example":{"text":"我不相信这～的事情。"},"similar":["诞妄不经"],"usage":"作谓语、定语；指荒谬"},{"id":41201,"word":"诞罔不经","pinyin":"dàn wǎng bù jīng","abbr":"dwbj","explanation":"荒诞虚妄，不合常理。","source":{"text":"辟辟实实，，由光明正大一路去，把一切诞罔不经之事，付诸一笑，那就不负我今日一番饶舌了。","book":"《扫迷帚》第九回"},"similar":["诞谩不经","诞幻不经"],"usage":"作谓语、定语；指荒谬"},{"id":41202,"word":"诞谩不经","pinyin":"dàn màn bù jīng","abbr":"dmbj","explanation":"荒诞虚妄，不合常理。","source":{"text":"古今传记《拾遗记》、《东文朔外传》之类，悉诞谩不经。","book":"清·王士禛《香祖笔记》卷六"},"example":{"text":"尝考《洪武实录》及《舆地志》，时地人事多信俗，～。","book":"清·曹寅《重葺鸡鸣寺浮图碑记》"},"similar":["诞罔不经","诞妄不经"],"usage":"作谓语、定语；指荒谬"},{"id":41203,"word":"诟如不闻","pinyin":"gòu rú bù wén","abbr":"grbw","explanation":"诟：辱骂。被人辱骂却好像没有听见一样，不动声色，形容宽宏大量，有涵养。","example":{"text":"他有～的涵养。"},"similar":["宽宏大量"],"opposite":["小肚鸡肠"],"usage":"作谓语、定语；指人的气量大","story":["宋仁宗时期，河南人富弼为人气量很大，遇到别人辱骂他时，他好像没听见一样。旁人对他说有人指名骂他，他说同名同姓的人很多，别人不会是骂他的。在与契丹谈判时，一向宽宏大量的富弼则态度十分坚决地拒绝契丹的无礼要求"]},{"id":41204,"word":"诟谇谣诼","pinyin":"gòu suì yáo zhuó","abbr":"gsyz","explanation":"诟：辱骂；谇：斥责；谣诼：造谣污蔑。辱骂斥责，造谣诽谤。形容相互勾心斗角，弄得乌烟瘴气。","source":{"text":"不知又有什么小人诟谇谣诼之辞。","book":"清·曹雪芹《红楼梦》第九回"},"usage":"作谓语、宾语；指毁谤"},{"id":41205,"word":"诟龟呼天","pinyin":"gòu guī hū tiān","abbr":"gght","explanation":"原意为占卜不吉，对占卜器具及天辱骂呼叫。引申为对不幸命运的呼号。","source":{"text":"《浅论儒家的孝道·再兴国学》：“八十多年前，时人发愤于国之积弱，诟龟呼天。一批深受西学影响又急欲救亡图强的激进青年，以胡适、陈独秀为主将，发起了一场中国近代以来反孔非儒的高潮——‘五四新文化革命运动’”。"}},{"id":41206,"word":"诠才末学","pinyin":"quán cái mò xué","abbr":"qcmx","explanation":"低下的才能与肤浅的学识。多用作自谦之词。","source":{"text":"某以诠才末学，年未弱冠，出应科举之试。","book":"清·纳兰性德《上座主徐健庵先生书》"},"example":{"text":"对于这种～，我们不能提拔他。"},"similar":["才疏学浅"],"usage":"作宾语、定语；指才疏学浅的人"},{"id":41207,"word":"诡变多端","pinyin":"guǐ biàn duō duān","abbr":"gbdd","explanation":"诡变：狡诈多变；端：项目，点。形容坏主意很多。","source":{"text":"怀张汤之辩诈，兼卢杞之奸凶，诡变多端。","book":"宋·苏辙《论吕惠卿》"},"similar":["诡计多端"],"usage":"作谓语、定语；指人的鬼点子多"},{"id":41208,"word":"诡形奇制","pinyin":"guǐ xíng qí zhì","abbr":"gxqz","explanation":"奇特、怪异的形体。","source":{"text":"若钟鼎所采，自是春秋、战国时各国书体，故诡形奇制，与《苍颉篇》不同也。","book":"康有为《广艺舟双楫·原书》"},"usage":"作宾语、定语；用于书面语"},{"id":41209,"word":"诡形怪状","pinyin":"guǐ xíng guài zhuàng","abbr":"gxgz","explanation":"诡：怪异。奇特怪异的形状。","source":{"text":"戴叔伦诗云：‘诡形怪状翻合宜。’","book":"宋·胡仔《山谷下》"},"similar":["诡形殊状","诡状殊形","诡状异形"],"usage":"作谓语、定语；形容物体的外形"},{"id":41210,"word":"诡形殊状","pinyin":"guǐ xíng shū zhuàng","abbr":"gxsz","explanation":"诡：怪异；殊：特殊，特别。奇特怪异的形状。","source":{"text":"好画古僻人物，诡形殊状，格虽高古，意务新奇，故不能不近乎谲怪。","book":"《宣和画谱·人物》"},"similar":["诡状殊形","诡形怪状","诡状异形"],"usage":"作谓语、定语；形容物体的外形"},{"id":41211,"word":"诡状异形","pinyin":"guǐ zhuǎng yì xíng","abbr":"gzyx","explanation":"诡：怪异。奇奇怪怪的形状。","source":{"text":"岑崟峍屼，或坳或平；盘坚枕卧，诡状殊形。","book":"《梁书·沈约传》"},"example":{"text":"鸣鼓聒天，燎炬照地，人戴兽面，男为女服，倡优杂技，～。","book":"《隋书·柳彧传》"},"similar":["诡状殊形","诡形怪状","诡形殊状"],"usage":"作谓语、定语；形容物体的外形"},{"id":41212,"word":"诡状殊形","pinyin":"guǐ zhuǎng shū xíng","abbr":"gzsx","explanation":"诡：怪异。奇奇怪怪的形状。","source":{"text":"诡：怪异。奇奇怪怪的形状。"},"similar":["诡形殊状","诡形怪状","诡状异形"],"usage":"作谓语、定语；形容物体的外形"},{"id":41213,"word":"诡秘莫测","pinyin":"guǐ mì mò cè","abbr":"gmmc","explanation":"诡秘：神秘不可知；莫测：无法捉摸。指人的行为态度神秘难以揣测。","source":{"text":"鬼谷纵横舌，终南诡秘踪。","book":"宋·刘克庄《后村全集·和实之读邸报之一》"},"similar":["神出鬼没"],"usage":"作谓语、宾语；指不可捉摸"},{"id":41214,"word":"诡衔窃辔","pinyin":"guǐ xián qiè pèi","abbr":"gxqp","explanation":"诡衔：吐出马嚼；窃辔：摆脱笼头。马吐出嚼子，咬断缰绳。比喻不受束缚。","source":{"text":"夫加之以衡扼，齐之以月题，而马知介倪闉扼鸷曼，诡衔窃辔。故马之知而态至盗者，伯乐之罪也。","book":"《庄子·马蹄》"},"similar":["无拘无束","自由自在"],"usage":"作谓语；比喻不受束缚"},{"id":41215,"word":"诡言浮说","pinyin":"guǐ yán fú shuō","abbr":"gyfs","explanation":"指虚假不实的话。","source":{"text":"[侯景]衅暴恶盈，侧首无托，以金陵逋逃之薮，江南流寓之地，甘辞卑礼，进孰图身，诡言浮说，抑可知矣。","book":"《资治通鉴·梁武帝太清元年》"},"similar":["浮言虚辞"],"usage":"作主语、宾语、定语；用于说话"},{"id":41216,"word":"诡计多端","pinyin":"guǐ jì duō duān","abbr":"gjdd","explanation":"诡计：狡诈的计谋；端：项目，点。形容坏主意很多。","source":{"text":"绪曰：‘维诡计多端，诈取雍州。’","book":"宋·苏辙《论吕惠卿》：“怀张汤之辩诈，兼卢杞之奸凶，诡变多端。”明·罗贯中《三国演义》第一百十七回"},"example":{"text":"只为他～，生相凶恶，大家送他绰号，叫做李“鬼子”。","book":"清·曾朴《孽海花》第三十二回"},"similar":["诡变多端","鬼计多端"],"opposite":["老实本分"],"usage":"作谓语、定语；指坏主意很多"},{"id":41217,"word":"诡诞不经","pinyin":"guǐ dàn bù jīng","abbr":"gdbj","explanation":"怪异荒诞，不合常理。","source":{"text":"且神仙、方技，秘怪之事，书传所记，从古有之。然诡诞不经，无补世教。","book":"宋·张世南《游宦纪闻》卷四"},"example":{"text":"时对空设位，谈笑酬倡，作～之语，有李邺侯之风。","book":"清·昭槤《啸亭杂录·朱文正》"},"similar":["怪诞不经"],"usage":"作定语、状语；指言语奇怪荒唐"},{"id":41218,"word":"诡谲多变","pinyin":"guǐ jué duō biàn","abbr":"gjdb","explanation":"谲：欺诈；诡谲：怪异。形容人的性情怪异多变。","source":{"text":"于是崇墉四匝，丰厦诡谲，烂若丹霞，皎如素雪。","book":"晋·张协《玄武馆赋》"},"similar":["诡谲怪诞"],"opposite":["忠厚老实"],"usage":"作谓语、定语；指人的性情"},{"id":41219,"word":"诡谲怪诞","pinyin":"guǐ jué guài dàn","abbr":"gjgd","explanation":"怪诞：奇异古怪。形容十分古怪离奇。","source":{"text":"一旦骇于荒唐缪悠之说，惊于诡谲怪诞之辞，则其颠顿狼狈之状，可胜方哉？","book":"宋·陆九渊《书与包洋道》"},"similar":["稀奇古怪"],"usage":"作谓语、定语；指古怪离奇"},{"id":41220,"word":"诡谲无行","pinyin":"guǐ jué wú xíng","abbr":"gjwx","explanation":"诡谲：欺诈；无行：无德行。形容欺诈成性，品行不端。","source":{"text":"而宋言犹在耳谲无行，且懒惰。，不肯竟其学。","book":"宋·洪迈《夷坚丙志·河北道士》"},"usage":"作谓语、定语；用于为人处世"},{"id":41221,"word":"诡雅异俗","pinyin":"guǐ yǎ yì sú","abbr":"gyys","explanation":"和雅正相背，与常俗相违。谓异端邪说。","source":{"text":"使奇耦之言，文章之议，日竞于世，失其所以■（木敬），而诡雅异俗者据之，斯亦非足下之所惧邪！","book":"章炳麟《与人论文书》"},"similar":["异端邪说"],"usage":"作主语、宾语、定语；指坏的言论"},{"id":41222,"word":"询事考言","pinyin":"xún shì kǎo yán","abbr":"xsky","explanation":"询：查询；考：考核。查询、考核所做的事和所说的话。后多指对官员的考核。","source":{"text":"询事考言，乃言底可绩，三载。","book":"《尚书·舜典》"},"example":{"text":"古之用人者，～，是以功罪有征。","book":"清·严有禧《漱华随笔·夹带怀挟》"},"usage":"作谓语、宾语、定语；指对官员的考核"},{"id":41223,"word":"询于刍荛","pinyin":"xún yú chú ráo","abbr":"xycr","explanation":"询：问；刍荛：割草打柴的人，借指地位低微的人。指向普通老百姓了解情况，征求意见。","source":{"text":"先民有言，询于刍荛。","book":"《诗经·大雅·板》"},"example":{"text":"鲁迅《且介亭杂文二集·六朝小说和唐代传奇文有怎样的区别？》：“比之‘～’，就是以为虽然小说，也有所为的明证。”"},"usage":"作宾语、定语；用于书面语"},{"id":41224,"word":"询根问底","pinyin":"xún gēn wèn dǐ","abbr":"xgwd","explanation":"指询问事情的详细原委，问个水落石出。","source":{"text":"妈妈说：‘你问我，叫我问谁呢？别总是那个老毛病，询根问底的，追的人心慌。’","book":"杨朔《雪花飘飘》"},"similar":["寻根问底"],"usage":"作谓语、宾语、定语；指询问底细"},{"id":41225,"word":"询谋佥同","pinyin":"xún móu qiān tóng","abbr":"xmqt","explanation":"指咨询和商议的意见都一致。","source":{"text":"官占，惟先蔽志，昆命于元龟。朕志先定，询谋佥同，鬼神其依。","book":"《书·大禹谟》"},"example":{"text":"臣等若各述所见，则非～之议，望许其为一状，陈其利害。","book":"《宋史·张洎传》"},"usage":"作宾语、定语；用于书面语"},{"id":41226,"word":"询谋咨度","pinyin":"xún móu zī dù","abbr":"xmzd","explanation":"询：询问；谋：商量；咨：咨询；度：推测。咨询谋议，商讨衡量","source":{"text":"但海性既偏执，又不能询谋咨度，喜自用。","book":"明·何良俊《四友斋丛说·史九》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":41227,"word":"询谋谘度","pinyin":"xún móu zī dù","abbr":"xmzd","explanation":"咨询谋议，商量研究。"},{"id":41228,"word":"询迁询谋","pinyin":"xún qiān xún móu","abbr":"xqxm","explanation":"指国家的安危、国都的迁徙、国君的拥立，都要征求人民的意见。","source":{"text":"小司寇之职，掌外朝之政，以致万民而询焉。一曰询国危；二曰询国迁；三曰询立君。","book":"语出《周礼·秋官·小司寇》"},"example":{"text":"康有为《上清帝第二书》：“《周礼》之～，皆合大众。”"},"usage":"作宾语、定语；用于书面语"},{"id":41229,"word":"该当何罪","pinyin":"gāi dāng hé zuì","abbr":"gdhz","explanation":"当：承担。应该承担什么罪。","source":{"text":"你还想引诱良家子弟，该当何罪？","book":"曾朴《孽海花》第二回"},"example":{"text":"你们教她的好事，～？","book":"朱自清《阿河》"},"usage":"作谓语、分句；用于责问人"},{"id":41230,"word":"详刑慎罚","pinyin":"xiáng xíng shèn fá","abbr":"xxsf","explanation":"详明周密地量刑，慎重妥善地定罪。多指决狱审慎。","source":{"text":"岂夫当今隆兴盛明之时，祖述尧舜之际，割奢务俭之政，除繁崇省之令，详刑慎罚之教，所宜希慕哉？","book":"《三国志·魏志·王郞传》"},"example":{"text":"有司其勉顺时气，劝督农桑，去其螟蜮，以及蝥贼；～，明察单辞，夙夜匪懈，以称朕意。","book":"《后汉书·明帝纪》"},"usage":"作谓语、宾语；用于处事"},{"id":41231,"word":"详情度理","pinyin":"xiáng qíng dù lǐ","abbr":"xqdl","explanation":"审察情由，推测事理。","source":{"text":"凤姐详情度理，说：‘他们必不敢多说一句话，倒别委屈了他们。如今把这事靠后，且把太太打发了去要紧。宁可咱们短些，别又讨没意思。’","book":"清·曹雪芹《红楼梦》第七十四回"}},{"id":41232,"word":"详星拜斗","pinyin":"xiáng xīng bài dǒu","abbr":"xxbd","explanation":"祭拜星斗。道教仪式之一。以此驱妖疗疾。","source":{"text":"过了些时，果然贾珍患病。竟不请医调治，轻则到园化纸许愿，重则详星拜斗。","book":"清·曹雪芹《红楼梦》第一零二回"},"usage":"作谓语、定语；用于书面语"},{"id":41233,"word":"详略得当","pinyin":"xiáng luè dé dàng","abbr":"xldd","explanation":"详略：详细和简略；得当：适当，恰当。指应当详细和应当简略的地方都处理得很妥当。","source":{"text":"略则举大，详则举小。","book":"战国·赵·荀况《荀子·非相》"},"example":{"text":"写文章应该～。"},"usage":"作谓语、定语；用于说话、写文章等"},{"id":41234,"word":"详计审处","pinyin":"xiáng jì shěn chǔ","abbr":"xjsc","explanation":"详细考虑，审慎选择。","source":{"text":"此两计者，显名厚实也，愿公详计而审处一焉。","book":"《史记·鲁仲连邹阳列传》"},"usage":"作谓语、定语；用于处事等"},{"id":41235,"word":"详详细细","pinyin":"xiáng xiáng xì xì","abbr":"xxxx","explanation":"指说话或写作等交待事情具体而微。","source":{"text":"孔子待门弟子向来和蔼可亲，并且谈锋很健，弟子有问，总是回对得详详细细，所以及门弟子，都喜欢与他在灯下长谈。","book":"丁寅生《孔子演义》第20回"},"example":{"text":"丁寅生《孔子演义》第20回：“孔子待门弟子向来和蔼可亲，并且谈锋很健，弟子有问，总是回对得～，所以及门弟子，都喜欢与他在灯下长谈。"},"similar":["具体而微"],"opposite":["粗枝大叶","简明扼要"],"usage":"作定语、状语；用于描述等"},{"id":41236,"word":"诪张为幻","pinyin":"zhōu zhāng wéi huàn","abbr":"zzwh","explanation":"诪张：欺诳。以欺骗迷惑别人。","source":{"text":"民无或胥诪张为幻。","book":"《尚书·无逸》"},"example":{"text":"幸亏我因为省事，用了二三百吊钱，凭他打点开来，不然就不知要怎样的～。","book":"清·颐琐《黄绣球》第五回"},"similar":["侜张为幻","诪张变眩"],"usage":"作谓语、定语；指欺骗人"},{"id":41237,"word":"诪张变眩","pinyin":"zhōu zhāng biàn xuàn","abbr":"zzbx","explanation":"犹言诪张为幻。诪张：欺诳。以欺骗迷惑别人。","source":{"text":"自《世本》取中以齐量，则诪张变眩皆辐凑于一极，视其书不逾旁行邪上。","book":"章炳麟《訄书·尊史》"},"similar":["诪张为幻"],"usage":"作谓语、定语；指欺骗人"},{"id":41238,"word":"诫莫如豫","pinyin":"jiè mò rú yù","abbr":"jmry","explanation":"诫：引以为诫；莫：不；豫：同“预”，预防。事后警戒不如事瓣预防。","source":{"text":"诫莫如豫，预而后给。","book":"《国语·晋语一》"}},{"id":41239,"word":"诫莫若豫","pinyin":"jiè mò ruò yù","abbr":"jmry","explanation":"诫：警戒；豫：通“预”，预先。指事后有所警戒不如事先有所防备。","source":{"text":"诫莫若豫，豫而后给。","book":"《国语·晋语一》"},"usage":"作谓语、定语；指事先有所防备"},{"id":41240,"word":"诬良为盗","pinyin":"wū liáng wéi dào","abbr":"wlwd","explanation":"诬：诬陷。良：好人。指捏造事实，陷害好人。","source":{"text":"据尔所供，一无实迹，难道本衙门诬良为盗不成！","book":"清·孔尚任《桃花扇·归山》"},"example":{"text":"只说刘大老爷到了常熟县任上，不到一年就闹了一起诬良为盗的案子。","book":"清·张春帆《九尾龟》第八十四回"},"similar":["逼良为娼"],"usage":"作谓语、定语；用于处事"},{"id":41241,"word":"语不惊人","pinyin":"yǔ bù jīng rèn","abbr":"ybjr","explanation":"语：言语，也指文句。语句平淡，没有令人震惊的地方。","source":{"text":"为人性僻耽佳句，语不惊人死不休。","book":"唐·杜甫《江上值水如海势聊短述》诗"},"example":{"text":"～，而意自至，由其理明而气足以掳之也。","book":"明·刘基《序》"},"opposite":["一鸣惊人"],"usage":"作谓语、定语；指语句平淡"},{"id":41242,"word":"语不惊人死不休","pinyin":"yǔ bù jīng rèn sǐ bù xiū","abbr":"ybjrsbx","explanation":"语：言语，也指文句。如果没有令人震惊的地方，至死也不罢休。","source":{"text":"为人性僻耽佳句，语不惊人死不休。","book":"唐·杜甫《江上值水如海势聊短述》诗"},"example":{"text":"大约耐肚皮里先有仔“～”一个成见，所以与“温柔敦厚”之旨离开得远仔点。","book":"清·韩邦庆《海上花列传》第六十回"},"usage":"作宾语、定语；指语句平淡"},{"id":41243,"word":"语不投机","pinyin":"yǔ bù tóu jī","abbr":"ybtj","explanation":"佛教禅宗谓说法不契合时机或对方的根机。","source":{"text":"所以道，言无展事，语不投机，承言者丧，滞句者迷。","book":"《五灯会元·大愚芝禅师法嗣·云峰文悦禅师》"},"similar":["话不投机"],"usage":"作宾语、定语；用于交往"},{"id":41244,"word":"语不择人","pinyin":"yǔ bù zé rén","abbr":"ybzr","explanation":"讲话不看对象。","source":{"text":"大约二位语不择人，失于检点，以至于此。幸而知觉尚早，未遭其害。","book":"清·李汝珍《镜花缘》第二十五回"},"usage":"作谓语、定语；用于处事或说话"},{"id":41245,"word":"语出月胁","pinyin":"yǔ chū yuè xié","abbr":"ycyx","explanation":"出语惊人，非同寻常。","source":{"text":"偏于逸歌长句，骏发踔厉，往往若穿天心，出月胁，意外惊人，语非寻常所能及，最为快也。","book":"唐·皇甫湜《〈顾况集〉序》"},"example":{"text":"大范忽长谣，～令人惊。","book":"宋·苏轼《轼近以月石砚……纯父数句》"},"opposite":["语不惊人"],"usage":"作宾语、定语；指语言功夫好"},{"id":41246,"word":"语四言三","pinyin":"yǔ sì yán sān","abbr":"ysys","explanation":"指信口乱说闲话。","source":{"text":"为何的语四言三，平白地将人讥诮。","book":"《群音类选·〈分钗记·计诱皮氏〉》"},"similar":["言三语四"],"usage":"作谓语、定语、状语；用于说话"},{"id":41247,"word":"语妙天下","pinyin":"yǔ miào tiān xià","abbr":"ymtx","explanation":"形容言语精妙无比。","source":{"text":"君房下笔，言语妙天下。","book":"《汉书·贾捐之传》"},"example":{"text":"皤然一老莅故都，吴稚晖～。”（鲁迅《且介亭杂文二集·六论文人相轻》","book":"但大了几十年，新闻上就大登特登，还用方体字标题道"},"similar":["语妙绝伦"],"usage":"作谓语、定语；指语言功夫"},{"id":41248,"word":"语妙绝伦","pinyin":"yǔ miào jué lún","abbr":"ymjl","explanation":"指言语精妙，无与伦比。","source":{"text":"又姚秋农总宪典顺天乡试……因对云：‘蒋径荒芜，大戛含冤呼大卞。姚墟榛莽，秋农一笑对秋吟。’语妙绝伦。","book":"清·梁绍壬《两般秋雨庵随笔·科场对》"},"similar":["语妙天下"],"usage":"作谓语、状语、定语；用于书面语"},{"id":41249,"word":"语惊四座","pinyin":"yǔ jīng sì zuò","abbr":"yjsz","explanation":"四座：周围在座的人。所讲的话让周围在座的人都感到震惊。形容说话观点与众不同，有分量。","example":{"text":"这番话当真是～，骇人听闻。","book":"金庸《神雕侠侣》第十四回"}},{"id":41250,"word":"语挚情长","pinyin":"yǔ zhì qíng cháng","abbr":"yzqz","explanation":"语言真挚，情意深长。形容对人真诚的劝告或忠告。","source":{"text":"书来规讽，语挚情长，真难备录。","book":"清·雪樵居士《秦淮闻见录·小住清溪》"}},{"id":41251,"word":"语无伦次","pinyin":"yǔ wú lún cì","abbr":"ywlc","explanation":"伦次：条理。话讲得乱七八糟，毫无次序。","source":{"text":"古人律诗，亦是一片文章，语或似无伦次，而意若贯珠。","book":"宋·胡仔《苕溪渔隐丛话前集》卷七引《诗眼》"},"example":{"text":"他～地向周围的人诉说自己的遭遇。"},"similar":["颠三倒四","乱七八糟","胡说八道"],"opposite":["井井有条","有条有理","有条不紊"],"usage":"作谓语、定语、状语；指语言没有逻辑"},{"id":41252,"word":"语无诠次","pinyin":"yǔ wú quán cì","abbr":"ywqc","explanation":"言辞未加选择和斟酌。","source":{"text":"灯下草创，语无诠次，字条行草，伏唯涵察。","book":"清·包世臣《致广东按察姚中丞书》"},"usage":"作谓语、状语；用于书面语"},{"id":41253,"word":"语焉不详","pinyin":"yǔ yān bù xiáng","abbr":"yybx","explanation":"指虽然提到了，但说得不详细。","source":{"text":"荀与杨也，择焉而不精，语焉而不详。","book":"唐·韩愈《原道》"},"example":{"text":"绣春也是急性子，对锦儿～深致不满，主张秋月仍是进京，去问一问明白，到底是怎么回事？","book":"高阳《曹雪芹别传》"},"similar":["言之不详"],"opposite":["不厌其详","纤悉无遗","细大不捐"],"usage":"作谓语；指说话"},{"id":41254,"word":"语焉既详","pinyin":"yǔ yān jì xiáng","abbr":"yyjx","explanation":"焉：语助词。说得很详细。","source":{"text":"予因是而思平上去入之交付明白，向来词家谱规，语焉既详，而唱家曲律，论之亦悉。","book":"明·沈宠绥《度曲须知·中秋品曲》"}},{"id":41255,"word":"语短情长","pinyin":"yǔ duǎn qíng cháng","abbr":"ydqc","explanation":"语言简短，情意深长。","source":{"text":"‘人民，真是太伟大了！’这句语短情长的衷心赞叹，我想，是足以代表所有长征战士的心意的。","book":"袁鹰《悲欢·深深的怀念》"},"usage":"作宾语、定语；用于书面语"},{"id":41256,"word":"语笑喧呼","pinyin":"yǔ xiào xuān hū","abbr":"yxxh","explanation":"大声说笑。同“语笑喧哗”。","source":{"text":"则要你悄语低言，不要你语笑喧呼。","book":"明·无名氏《陈仓路》第四折"},"similar":["语笑喧哗"],"usage":"作谓语、宾语；用于书面语"},{"id":41257,"word":"语笑喧哗","pinyin":"yǔ xiào xuān huá","abbr":"yxxh","explanation":"大声说笑。","source":{"text":"金鼓不许乱鸣，不许交头接耳，不许语笑喧哗。","book":"元·关汉卿《单刀会》第三折"},"similar":["语笑喧呼"],"usage":"作谓语、宾语；用于书面语"},{"id":41258,"word":"语笑喧阗","pinyin":"yǔ xiào xuān tiān","abbr":"yxxt","explanation":"喧阗：声音大而杂，喧闹。形容许多人挤来挤去地大声说笑。","source":{"text":"金殿不许交头接耳，不许语笑喧哗。","book":"元·关汉卿《单刀会》第三折"},"example":{"text":"一夜人声杂沓，～，爆竹烟火，络绎不绝。（清·曹雪芹《红楼梦》第五十三回）"},"similar":["欢声笑语"],"usage":"作谓语；指场面热闹"},{"id":41259,"word":"语简意赅","pinyin":"yǔ jiǎn yì gāi","abbr":"yjyg","explanation":"语言简练，意思完备。","source":{"text":"如今，当‘周马’这个绰号，由于语简意赅，迅速地成为我的正式代号的时候，我反而处之泰然了。","book":"余易木《初恋的回声》十一"},"similar":["言简意赅"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":41260,"word":"语言无味","pinyin":"yǔ yán wú wèi","abbr":"yyww","explanation":"指说的话枯燥无味或庸俗无聊。","source":{"text":"凡所以使吾面目可憎，语言无味者，皆子之志也。其名曰智穷。","book":"唐·韩愈《送穷文》"},"example":{"text":"我在这里不大高兴的原因，首先是在周围多是～的人物，令我觉得无卿。","book":"鲁迅《两地书》"},"similar":["语无伦次","平铺直叙"],"opposite":["语妙天下","一字千金","字字珠玑"],"usage":"作主语、定语、宾语；指说话或作文"},{"id":41261,"word":"语言无味，面目可憎","pinyin":"yǔ yán wú wèi，miàn mù kě zēng","abbr":"yywwmmkz","explanation":"憎：厌恶。形容说话枯燥无味，面貌使人厌恶","source":{"text":"她的确是一个‘语言无味，面目可憎’的女人。","book":"巴金《谈》"},"similar":["面目可憎，语言无味"],"usage":"作谓语、定语；用于形容人"},{"id":41262,"word":"语近指远","pinyin":"yǔ jìn zhǐ yuǎn","abbr":"yjzy","explanation":"语言浅近，含意深远。指，本旨。","source":{"text":"文浅意深，语近指远。","book":"太平天国·汪吉人等《〈钦定军次实录〉序》"},"usage":"作谓语、定语；用于文章等"},{"id":41263,"word":"语近词冗","pinyin":"yǔ jìn cí rǒng","abbr":"yjcr","explanation":"指文辞浅近，但不简炼。","source":{"text":"翟公巽谓范蔚宗书语近词冗，事多注见。","book":"宋·王应麟《困学纪闻·考史三》"},"usage":"作谓语、定语；用于说话或作文等"},{"id":41264,"word":"语重心沉","pinyin":"yǔ zhòng xīn chén","abbr":"yzxc","explanation":"言辞恳切，心情沉重。","source":{"text":"孟老汉可又自自然然地一忽晃火气全消，甚至还进一步责备自己似的，哑默了半天，才又脑袋一抬，愣着两只深窝大眼，语重心沉地说。","book":"康濯《东方红》第五章二"},"usage":"作定语、状语；用于书面语"},{"id":41265,"word":"语重心长","pinyin":"yǔ zhòng xīn cháng","abbr":"yzxc","explanation":"话深刻有力，情意深长。形容对人真诚的劝告或忠告。","source":{"text":"叹别离苦况，转忘了母亲的语重心长。","book":"清·洛日生《海国英雄记·回唐》"},"example":{"text":"他这些～的话，深深地打劫了我的心。"},"similar":["言近旨远","微言大义"],"opposite":["轻描淡写","浮光掠影"],"usage":"作定语、状语、宾语；用于教诲等"},{"id":41266,"word":"语重情深","pinyin":"yǔ zhòng qíng shēn","abbr":"yzqs","explanation":"犹言语重心长。","source":{"text":"忽蒙佳什誉过庭，语重情深谁敢荷？","book":"严复《以〈渔洋精华录〉寄琥唐山春榆侍郎有诗见述率赋奉答》"},"similar":["语重心长"],"usage":"作定语、状语、宾语；用于教诲等"},{"id":41267,"word":"语长心重","pinyin":"yǔ cháng xīn zhòng","abbr":"ycxz","explanation":"言辞恳切，情意深长。","source":{"text":"公书语长心重，深以外间谣诼纷纭集为北京大学惜，甚感。","book":"蔡元培《致“公言报”函并符答林琴南君函》"},"similar":["语重心长"],"usage":"作谓语、定语、状语；用于说话等"},{"id":41268,"word":"误人子弟","pinyin":"wù rén zǐ dì","abbr":"wrzd","explanation":"误：耽误。指因无才或不负责任而耽误人家后辈学生。","source":{"text":"先生犯了这样小错，就要打手心，那终日旷功误人子弟的，岂不都要打杀么？","book":"清·李汝珍《镜花缘》第19回"},"example":{"text":"不料‘思想权威者’或‘思想界先驱者’这一顶‘纸糊的假冠’，竟又是如此～。","book":"鲁迅《华盖集续编的续编·厦门通信三》"},"similar":["悮人子弟"],"usage":"作谓语、定语、宾语；指不负责任"},{"id":41269,"word":"误付洪乔","pinyin":"wù fù hóng qiáo","abbr":"wfhq","explanation":"用来比喻把信件寄丢了或没有收到对方的信件。","source":{"text":"沉者自沉，浮者自浮，殷洪乔不能作致书郎。","book":"南朝宋·刘义庆《世说新语·任诞》"},"similar":["付诸洪乔"],"usage":"作谓语、定语；用于书面语","story":["晋朝豫章太守殷羡，字洪乔，在离任时，很多人委托他捎带书信回家乡，因那时还没有邮局，只有托人捎带。他很客气地接受了100多封信，可到了石头渚就将信全部扔进河水里。当人们收不到信总联想到信是托洪乔捎带的"]},{"id":41270,"word":"误作非为","pinyin":"wù zuò fēi wéi","abbr":"wzfw","explanation":"犹言胡作非为。不顾法纪或舆论，毫无顾忌地做坏事。","source":{"text":"况尔等为兵为勇之人，多系平日误作非为，是以借兵勇以为逃死之地。","book":"太平天国·洪仁玕《诛妖檄文》"},"similar":["胡作非为"],"usage":"作谓语、定语、状语；指任意做坏事"},{"id":41271,"word":"误入歧途","pinyin":"wù rù qí tú","abbr":"wrqt","explanation":"误：受惑；歧途：错误的道路。由于受煽惑而走上了错误的道路。","source":{"text":"然被告等皆年幼无知，误入歧途，不无可悯。","book":"鲁迅《写于深夜里》"},"example":{"text":"台湾的真情实况如何，不少人是～的，需要教育挽救。","book":"邓小平《目前的形势和任务》"},"similar":["误入迷途"],"opposite":["迷途知返"],"usage":"作谓语、宾语、定语；指迷失方向"},{"id":41272,"word":"误入迷津","pinyin":"wù rù mí jīn","abbr":"wrmj","explanation":"指受人迷惑而走上迷途。","example":{"text":"小心～，迷失方向。"},"similar":["误入迷途"],"opposite":["迷途知返"],"usage":"作谓语、定语；指误入迷途"},{"id":41273,"word":"误入迷途","pinyin":"wù rù mí tú","abbr":"wrmt","explanation":"误：受惑；迷途：错误的道路。由于受迷惑而走上了错误的道路。","example":{"text":"越是聪明越是昏，想始皇一心求仙，所以不多思索，～呢。","book":"蔡东藩《前汉演义》第五回"},"similar":["误入迷津","误入歧途"],"opposite":["迷途知返"],"usage":"作谓语、定语；用于人的处境"},{"id":41274,"word":"误国害民","pinyin":"wù guó hài mín","abbr":"wghm","explanation":"给国家人民带来祸害。同“误国殃民。”","source":{"text":"张俊身为大将，不思报效，专权乱政，误国害民。","book":"清·钱彩《说岳全传》第七十四回"},"similar":["误国殃民","祸国殃民","误国殄民"],"usage":"作谓语、定语；用于处事"},{"id":41275,"word":"误国欺君","pinyin":"wù guó qī jūn","abbr":"wgqj","explanation":"欺骗君主，祸害国家。","source":{"text":"假如有一等做官的，误国欺君，侵剥百姓，虽然官高禄厚，难道不是大盗？","book":"明·凌濛初《初刻拍案惊奇》卷八"},"example":{"text":"蔡京父子为宰相二十徐年，妒贤嫉能，贪婪无厌，～。","book":"清·陈忱《水浒后传》第二十二回"}},{"id":41276,"word":"误国殃民","pinyin":"wù guó yāng mín","abbr":"wgym","explanation":"给国家人民带来祸害。","source":{"text":"切惟元老严嵩僭窃，权侔人主，误国殃民，奸谋久矣。","book":"明·杨继盛《请诛贼臣疏》：“臣观大学士严嵩，盗权窃柄，误国殃民，其天下之第一大贼乎。”明·王世贞《鸣凤记》第十五出"},"example":{"text":"这实在是～的事！","book":"郭沫若《孔雀胆》第二幕"},"similar":["误国害民","祸国殃民"],"usage":"作谓语、定语；用于处事"},{"id":41277,"word":"误国殄民","pinyin":"wù guó tiǎn mín","abbr":"wgtm","explanation":"给国家人民带来祸害。","source":{"text":"贪缪之相，误国殄民，逐之已晚。","book":"宋·周密《齐东野语·洪君畴》"},"similar":["误国殃民","误国害民","祸国殃民"],"usage":"作谓语、定语；用于处事"},{"id":41278,"word":"误打误撞","pinyin":"wù dǎ wù zhuàng","abbr":"wdwz","explanation":"指事先未经周密考虑。","source":{"text":"［牧羊关］板筑的商傅说，钓鱼儿姜吕望，这两个梦善感动历代君王，这梦先应先知，臣则是误打误撞。","book":"元·关汉卿《双赴梦》第二折"},"example":{"text":"袭人笑道：“不过是～的遇见了，说约下了可是没有的事。”","book":"清·曹雪芹《红楼梦》第六十二回"},"similar":["歪打正着"],"usage":"作状语；指无意中"},{"id":41279,"word":"误杀好人","pinyin":"wù shā hǎo rén","abbr":"wshr","explanation":"好人：品德好、行为端的人。过失地杀掉品行好的人。","example":{"text":"我们不能～，放过坏人。"},"usage":"作谓语；指过失杀好人","story":["宋朝时期，杨六郎安排孟良去辽国望乡台取回父亲的遗骸，消息被焦赞得到，他也想去领功。孟良来到望乡台，趁着夜色去偷遗骸，刚得手却遇到黑影焦赞，担心碰上辽人，孟良就挥刀砍死了他，证实是焦赞后，孟良也自杀身亡"]},{"id":41280,"word":"误石为宝","pinyin":"wù shí wéi bǎo","abbr":"wswb","explanation":"误：错误。把石头误认为是宝贝。比喻真假不辨。","source":{"text":"宋之愚人得燕石梧台之东，归而藏之，以为大宝。周客闻而观之。……客见之，俯而掩口，卢胡而笑曰：‘此燕石也，与瓦甓不殊。’","book":"《阙子·宋之愚人》"}},{"id":41281,"word":"误笔成蝇","pinyin":"wù bǐ chéng yíng","abbr":"wbcy","explanation":"把屏风上的因误笔而成的污点画成苍蝇。形容绘画技术十分高超。","source":{"text":"曹不兴，吴兴人也。孙权使画屏风，误落笔点素，因就成蝇状。权疑其真，以手弹之。","book":"唐·张彦远《历代名画记》卷四"},"example":{"text":"移镫见蝎宁防毒，～肯被汙。","book":"清·查慎行《残冬展假病榻消寒聊当呻吟语无伦次录存十六章》"}},{"id":41282,"word":"误落风尘","pinyin":"wù luò fēng chén","abbr":"wlfc","explanation":"误落：指陷入坏的境地；风尘：旧指娼妓的生活。旧指妇女不幸沦为娼妓。","source":{"text":"可怜一片无瑕玉，误落风尘花柳中。","book":"明·冯梦龙《警世通言》卷二十三"},"example":{"text":"奴是好人家儿女，～，倘得姨娘主张从良，胜造九级浮图。","book":"明·冯梦龙《醒世恒言》卷三"},"similar":["沦落风尘"],"usage":"作谓语、定语；多用于女性"},{"id":41283,"word":"误认颜标","pinyin":"wù rèn yán biāo","abbr":"wryb","explanation":"形容懵懂浅陋。","source":{"text":"主司头脑太冬烘，错认颜标作鲁公。","book":"五代·王定保《唐摭言》卷八"},"example":{"text":"他少年时代为题扇，以此调之，妓家借托盛名，而不解文义，遂～耳。","book":"清·纪昀《阅微草堂笔记》卷十三"},"usage":"作谓语；指人见识不广"},{"id":41284,"word":"诱掖后进","pinyin":"yòu yè hòu jìn","abbr":"yyhj","explanation":"诱掖：诱导扶持。引导帮助后辈上进。","source":{"text":"翥勤于诱掖后进，绝去崖岸，不徒以师道自尊，用是学者乐亲炙之。","book":"《元史·张翥传》"},"usage":"作谓语、宾语；用于处事"},{"id":41285,"word":"诱掖奖劝","pinyin":"yòu yè jiǎng quàn","abbr":"yyjq","explanation":"引导扶持，奖励劝勉。","source":{"text":"先生曰：‘大凡朋友须箴规指摘处少，诱掖奖劝意多方是。’","book":"明·王守仁《传习录》卷中"},"example":{"text":"也许是一些批评家，眼界便极高卓，所以我只见到对于青年作家的迎头痛击，冷笑，抹杀，却很少见～的意思的批评。","book":"鲁迅《华盖集·并非闲话（三）》"},"usage":"作宾语、定语；用于处事"},{"id":41286,"word":"诱敌深入","pinyin":"yòu dí shēn rù","abbr":"ydsr","explanation":"把敌人引进来，使它处于孤立而又不易逃跑的不利地位。","source":{"text":"我们历来主张‘诱敌深入’，就是因为这是战略防御中弱军对强军作战的最有效的军事政策。","book":"毛泽东《论持久战》"},"example":{"text":"我们～，来个全歼。"},"similar":["严阵以待"],"usage":"作谓语、宾语、补语；用于军事方面"},{"id":41287,"word":"诱秦诓楚","pinyin":"yòu qín kuāng chǔ","abbr":"yqkc","explanation":"战国时张仪劝导秦国以连衡破合从，以诡诈手段欺骗楚国背齐向秦。后遂因以之表示挑拨离间。","source":{"text":"用诱秦诓楚之计，作摧兰折玉之谋。","book":"清·余怀《板桥杂记·丽品》"},"usage":"作宾语、定语；用于处事"},{"id":41288,"word":"诲人不倦","pinyin":"huì rén bù juàn","abbr":"hrbj","explanation":"诲：教导。教导人特别耐心，从不厌倦。","source":{"text":"学而不厌，诲人不倦，何有于我哉？","book":"《论语·述而》"},"example":{"text":"圣人说：“～”，你又来问我，我岂有不说的理！","book":"清·曹雪芹《红楼梦》第四十八回"},"similar":["谆谆教导","不厌其烦","循循善诱"],"usage":"作谓语、定语、状语；指耐心教导别人","story":["春秋时期，孔子带领弟子们周游列国，经历新郑之病，他们不得不在当地住了几月，弟子樊迟问孔子怎样干农活。孔子心里不高兴，一反诲人不倦的习惯，承认不如老农。樊迟只好向当地农民请教，终于种出了葫芦、扁豆等瓜菜"]},{"id":41289,"word":"诲人不惓","pinyin":"huì rén bù tiě","abbr":"hrbj","explanation":"教导人特别耐心，从不厌倦。同“诲人不倦”。"},{"id":41290,"word":"诲奸导淫","pinyin":"huì jiān dǎo yín","abbr":"hjdy","explanation":"引诱人做奸恶淫荡等坏事。","source":{"text":"若夫诲奸导淫，使今之社会风尚为江河之日下，则我知免尔。","book":"姚锡钧《自序》"},"example":{"text":"你不要做这～的打扮，让人有非分之想。"},"similar":["诲淫诲道"],"usage":"作谓语、定语、宾语；用于书籍传媒等"},{"id":41291,"word":"诲尔谆谆，听我藐藐","pinyin":"huì ěr zhūn zhūn，tīng wǒ miǎo miǎo","abbr":"hezztwmm","explanation":"教诲不倦的样子。藐藐：疏远的样子。讲的人不知疲倦，听的人若无其事。形容徒费唇舌。","source":{"text":"诲尔谆谆，听我藐藐。","book":"《诗·大雅·抑》"},"example":{"text":"方玭之为是书也，璨已长矣，诗曰：‘～。’悲夫!","book":"宋·陆游《跋柳氏训序》"},"usage":"作宾语、定语；用于处事"},{"id":41292,"word":"诲淫诲盗","pinyin":"huì yín huì dào","abbr":"hyhd","explanation":"原意是财物不仔细保管，招致别人来偷盗；女子打扮得十分妖艳，也是引诱别人来调戏。现指引诱人做奸淫盗窃的事。","source":{"text":"慢藏诲盗，冶容诲淫。","book":"《周易·系辞上》"},"example":{"text":"“诲淫”“诲盗”只是代表统治者的利益的说话。","book":"朱自清《论雅俗共赏》"},"similar":["诲盗诲淫"],"usage":"作谓语、定语、补语；指引诱人去干坏事"},{"id":41293,"word":"诲盗诲淫","pinyin":"huì dào huì yín","abbr":"hdhy","explanation":"原意是财物不仔细保管，招致别人来偷盗；女子打扮得十分妖艳，也是引诱别人来调戏。现指引诱人做奸淫盗窃的事。","source":{"text":"慢藏诲盗，冶容诲淫。","book":"《周易·系辞上》"},"example":{"text":"我们要坚决杜绝那些～的作品出版。"},"similar":["诲淫诲盗"],"usage":"作谓语、定语；同“诲淫诲盗”"},{"id":41294,"word":"诲而不倦","pinyin":"huì ér bù juàn","abbr":"hebj","explanation":"诲：教诲，教导；倦：厌烦，疲倦。教导人特别耐心，从不厌烦。","source":{"text":"太皇太后以至德之隆，诲而不倦。","book":"《魏书·高允传》"},"example":{"text":"《魏书·高允传》：“太皇太后以至德之隆，～。”"},"similar":["诲人不倦"],"usage":"作谓语、定语、状语；指耐心教导别人"},{"id":41295,"word":"诳时惑众","pinyin":"kuáng shí huò zhòng","abbr":"kshz","explanation":"指欺骗迷惑世人。","source":{"text":"况乃寝宿冢藏，而孕育其中，诳时惑众，诬污鬼神乎？","book":"南朝·宋·范晔《后汉书·陈蕃传》"},"similar":["欺世盗名"],"usage":"作谓语；指欺骗迷惑世人"},{"id":41296,"word":"说一不二","pinyin":"shuō yī bù èr","abbr":"sybe","explanation":"说怎么样就怎么样。形容说话算数。","source":{"text":"这个时候的邵孝廉，就是个小小的制台一般，说一是一，说二是二，庄制军没有一回驳过他的。","book":"清·张春帆《宦海》第四回"},"example":{"text":"穷苦人们起来，在村里～！","book":"梁斌《红旗谱》十八"},"similar":["言而有信","一言为定"],"opposite":["出尔反尔","言而无信"],"usage":"作谓语、定语；指说话算数"},{"id":41297,"word":"说一是一，说二是二","pinyin":"shuō yī shì yī，shuō èr shì èr","abbr":"sysysese","explanation":"说怎样就怎样，不能更改。","source":{"text":"这个时候的邵孝廉，就是个小小的制台一般，说一是一，说二是二，庄制军没有一回驳过他的。","book":"清·张春帆《宦海》第四回"},"example":{"text":"何小姐想，我是向来～，早间既有那等一句话，此时没个说了不算的理。","book":"清·文康《儿女英雄传》第三十一回"},"similar":["说一不二"],"usage":"作谓语、分句；指说话算数"},{"id":41298,"word":"说七说八","pinyin":"shuō qī shuō bā","abbr":"sqsb","explanation":"总之，不管怎么说。","example":{"text":"～，我还是让他占了便宜。"},"similar":["总而言之"],"usage":"作分句；用于口语"},{"id":41299,"word":"说三道四","pinyin":"shuō sān dào sì","abbr":"ssds","explanation":"形容不负责任地胡乱议论。","source":{"text":"莫学他人不知朝暮，走启蒙乡村，说三道四。","book":"清·崔灏《通俗编·言笑》"},"example":{"text":"有的人工作不努力，别人有了成绩，却整天～。"},"similar":["说东道西","夸夸其谈"],"opposite":["相对无言","默不做声"],"usage":"作谓语、状语；指乱加谈论"},{"id":41300,"word":"说不过去","pinyin":"shuō bù guò qù","abbr":"sbgq","explanation":"不合情理，无法交代。","example":{"text":"这理由似乎有点～。"},"similar":["不合情理"],"opposite":["于情于理"],"usage":"作谓语、定语、宾语；指不合情理"},{"id":41301,"word":"说东忘西","pinyin":"shuō dōng wàng xī","abbr":"sdwx","explanation":"说了这样忘了那样。形容记忆力差。","source":{"text":"一贯没担过事的人嘛，一下子料理五十来户人家的庄稼事务，再加上社员们复杂的思想状况，劳神劳得他颠三倒四，说东忘西。","book":"柳青《狠透铁》一"},"usage":"作谓语、定语、宾语；用于口语"},{"id":41302,"word":"说东谈西","pinyin":"shuō dōng tán xī","abbr":"sdtx","explanation":"说这说那，随意谈论。","source":{"text":"那堪长老鼓两片皮，摇三寸舌，说东道西，指南言北。","book":"宋·释惟白《续传灯录》卷二十"},"example":{"text":"只见几个挺胸叠肚指手画脚的人坐在大门上～的。","book":"清·曹雪芹《红楼梦》第六回"},"similar":["说东道西"],"opposite":["默默无语"],"usage":"作谓语、宾语；指随意谈论各种事情"},{"id":41303,"word":"说东道西","pinyin":"shuō dōng dào xī","abbr":"sddx","explanation":"说东家，讲西家。形容没有中心地随意说。","source":{"text":"老工程师哪有工夫听别人说东道西？","book":"杜鹏程《在和平的日子里》第四章"},"example":{"text":"我不喜欢在别人背后～。"},"similar":["说三道四","说长道短"],"opposite":["守口如瓶","缄口不言"],"usage":"作谓语、宾语；指随意谈论各种事情"},{"id":41304,"word":"说亲道热","pinyin":"shuō qīn dào rè","abbr":"sqdr","explanation":"说亲切热情的话。用来形容只在口头上亲热。","source":{"text":"可恨宝姐姐、琴妹妹天天说亲道热。","book":"清·曹雪芹《红楼梦》第76回"},"usage":"作谓语；指亲密交谈"},{"id":41305,"word":"说今道古","pinyin":"shuō jīn dào gǔ","abbr":"sjdg","explanation":"从今到古无所不谈，无不评论。","source":{"text":"人间开口笑樵渔，会谈今论古。","book":"元·张可久《端正好·渔乐》"},"example":{"text":"你们又文绉绉的～，我那里省得。","book":"清·钱彩《说岳全传》第九回"}},{"id":41306,"word":"说到做到","pinyin":"shuō dào zuò dào","abbr":"sdzd","explanation":"言行一致，说过的话一定用行动实现。","example":{"text":"我喜欢他～的性格。"},"similar":["言出必行"],"opposite":["言行不一"],"usage":"作谓语、定语；指言行一致"},{"id":41307,"word":"说到曹操，曹操就到","pinyin":"shuō dào cáo cāo，cáo cāo jiù dào","abbr":"sdccccjd","explanation":"指谈论到某人，某人恰巧来了。","source":{"text":"无巧不成书！说到曹操，曹操就到。","book":"曾朴《孽海花》第29回"},"example":{"text":"真是～，把你给说来了。"},"similar":["说到就到"],"usage":"作宾语、分句；用于口语"},{"id":41308,"word":"说千说万","pinyin":"shuō qiān shuō wàn","abbr":"sqsw","explanation":"说了许许多多的话。","source":{"text":"今人解《易》……说千说万，与《易》全不相干。","book":"宋·朱熹《朱子语类》第67卷"},"similar":["说来说去","说千道万"],"usage":"作分句、状语；用于口语"},{"id":41309,"word":"说千道万","pinyin":"shuō qiān dào wàn","abbr":"sqdw","explanation":"道：说。指各种各样的说法。后用来形容话说的很多。亦作“说一千道一万”。","source":{"text":"今人解《易》者说千说万，与《易》全不相干。","book":"宋·朱熹《朱子语类》卷六十七"},"example":{"text":"～，自己的事情还得自己去处理"},"similar":["说千说万","说一千，道一万"],"usage":"作分句、状语；用于口语"},{"id":41310,"word":"说古谈今","pinyin":"shuō gǔ tán jīn","abbr":"sgtj","explanation":"从今到古无所不谈，无不评论。形容话题广泛。","source":{"text":"只待要说古谈今，寻山问水，傍柳穿花；那里也修身正己，利民润物，治国齐家。","book":"元·石子章《竹坞听琴》第二折"},"example":{"text":"周瘦鹃《苏州游踪·杨梅时节到西山》：“我们正在～，敲诗斗韵，蓦见重云叠叠，盖住了前面的山峰，料知山雨欲来。”"},"similar":["谈今论古","论今说古","说今道古"],"usage":"作谓语、宾语；形容谈话内容广泛"},{"id":41311,"word":"说古道今","pinyin":"shuō gǔ dào jīn","abbr":"sgdj","explanation":"从今到古无所不谈，无不评论。形容话题广泛。同“说古谈今”。","source":{"text":"你们又文绉绉的说古道今，我那里省得？","book":"清·钱彩《说岳全传》第九回"},"example":{"text":"柳青《创业史》第二部第24章：“干活儿不久，铁镇王三、王生茂和跛子福蛋他们就忘了刚才闹过的别扭，开始～了。”"},"similar":["谈今论古","论今说古","说古谈今"],"usage":"作谓语、宾语；形容谈话内容广泛"},{"id":41312,"word":"说咸道淡","pinyin":"shuō xián dào dàn","abbr":"sxdd","explanation":"说别人闲话。","example":{"text":"你不要在别人背后～。"},"similar":["说三道四"],"usage":"作谓语、定语；指说别人闲话"},{"id":41313,"word":"说嘴打嘴","pinyin":"shuō zuǐ dǎ zuǐ","abbr":"szdz","explanation":"说嘴：自夸、吹牛。夸口的人，偏偏自己出丑。","source":{"text":"老不死的娼妇，怎么造下孽了？说嘴打嘴，现世现报！","book":"清·曹雪芹《红楼梦》第七十四回"},"usage":"作谓语、宾语；用于处事"},{"id":41314,"word":"说嘴说舌","pinyin":"shuō zuǐ shuō shé","abbr":"szss","explanation":"指搬弄是非。","source":{"text":"我孩儿又不曾别嫁了人，是斗他耍，怎么这等认真，就说嘴说舌背槽抛粪。","book":"元·无名氏《渔樵记》第三折"},"similar":["说三道四"],"usage":"作谓语、宾语；指搬弄是非"},{"id":41315,"word":"说嘴郎中","pinyin":"shuō zuǐ láng zhōng","abbr":"szlz","explanation":"比喻喜欢说空话、大话而没有本事的人。","example":{"text":"他是一个十足的～。"},"usage":"作宾语、定语；指说大话的人"},{"id":41316,"word":"说地谈天","pinyin":"shuō dì tán tiān","abbr":"sdtt","explanation":"天上地下，无所不谈。形容话题广泛或巧于言辞。","source":{"text":"指挥说地谈天口，来诱翻江搅海人。","book":"明·施耐庵《水浒传》第十三回"},"example":{"text":"清·夏敬渠《野叟曝言》第23回：“一个人搧着扇子，在那里～，指方卖药。”"},"similar":["谈天说地"],"usage":"作谓语、宾语、定语；形容人说话没有主题"},{"id":41317,"word":"说大人则藐之","pinyin":"shuō dà rén zé miǎo zhī","abbr":"sdrzmz","explanation":"大人：大人物。原指向大人物游说时，不能把他们的地位和权势放在眼里。后比喻敢于同权威名流争鸣辩论的精神。","source":{"text":"说大人则藐之，勿视其巍巍然。","book":"《孟子·尽心下》"}},{"id":41318,"word":"说大话","pinyin":"shuō dà huà","abbr":"sdh","explanation":"夸口说话或言过其实地说话。","source":{"text":"《传灯录》云门偃曰：‘忽一日眼光落地，无汝掠虚说大话处。’","book":"清·翟灏《通俗编·言笑》"},"example":{"text":"你不要再～，没人相信你。"},"similar":["吹牛皮"],"usage":"作谓语、宾语、定语；指吹牛皮"},{"id":41319,"word":"说好嫌歹","pinyin":"shuō hǎo xián dǎi","abbr":"shxd","explanation":"说这个好，嫌那个坏。泛指批评，褒贬。","source":{"text":"所演的戏，却是里外一样的，里面演什么，外面也演什么，以免那些人说好嫌歹的吵闹。","book":"《雪岩外传》第11回"},"similar":["说好说歹"],"usage":"作谓语、定语；用于口语"},{"id":41320,"word":"说好说歹","pinyin":"shuō hǎo shuō dǎi","abbr":"shsd","explanation":"①指百般劝说或请求。②褒贬，评论好坏。","source":{"text":"我赶眼错就走出来，还要拦阻，又说好说歹，放了我来。","book":"明·兰陵笑笑生《金瓶梅词话》第16回"},"example":{"text":"我～才通过。"},"similar":["好说歹说","评头品足","说好嫌歹"],"usage":"作谓语、状语；形容反复劝说"},{"id":41321,"word":"说家克计","pinyin":"shuō jiā kè jì","abbr":"sjkj","explanation":"谈说持家的事。","source":{"text":"有一等妇女每相随，并不说家克计，则打听些闲是非。","book":"元·关汉卿《窦娥冤》第二折"},"usage":"作谓语、定语；用于书面语"},{"id":41322,"word":"说得行不得","pinyin":"shuō dé xíng bù dé","abbr":"sdxbd","explanation":"只能说不能做。","source":{"text":"曰：‘争得不识和尚？’师曰：‘脚法师，说得行不得。’","book":"宋·释普济《五灯会元》卷十一"}},{"id":41323,"word":"说得轻巧","pinyin":"shuō dé qīng qiǎo","abbr":"sdqq","explanation":"说起来很简单容易。","example":{"text":"～，有那么简单吗？"},"similar":["说得容易"],"usage":"作谓语、定语；用于口语"},{"id":41324,"word":"说时迟，那时快","pinyin":"shuō shí chí，nà shí kuài","abbr":"sscnsk","explanation":"小说中的常用套语。意指事情发生的速度不是记叙速度所能跟得上的。","source":{"text":"说时迟，那时快，武松见大虫扑来，只一闪，闪在大虫背后。","book":"明·施耐庵《水浒传》第23回"},"example":{"text":"～，她一棍劈将下来。"},"usage":"作分句；旧小说用语"},{"id":41325,"word":"说是弄非","pinyin":"shuō shì nòng fēi","abbr":"ssnf","explanation":"评说是非。也指搬弄口舌。同“说是谈非”。","source":{"text":"从‘老好人’薛××的眼里，以为大家又在说是弄非了。","book":"《解放日报》1943.1.23"},"similar":["说是道非","说是谈非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":41326,"word":"说是谈非","pinyin":"shuō shì tán fēi","abbr":"sstf","explanation":"评说是非。","source":{"text":"不问生熟办酒食，他便要弄盏传杯，说是谈非，斜眼相窥。","book":"元·无名氏《赠妓》"},"example":{"text":"明·无名氏《骗英布》第三折：“本待要～，不承望走将来正逢着本对，岂不闻好斗者必遇其敌。”"},"similar":["说三道四","说是道非","说是弄非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":41327,"word":"说是道非","pinyin":"shuō shì dào fēi","abbr":"ssdf","explanation":"评说是非。也指搬弄口舌。同“说是谈非”。","source":{"text":"我的父母没眼睛，把我嫁在这里，没来由教他来望，却教别人说是道非。","book":"明·冯梦龙《喻世明言》第38卷"},"similar":["说是弄非","说是谈非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":41328,"word":"说曹操，曹操到","pinyin":"shuō cáo cāo，cáo cāo dào","abbr":"sccccd","explanation":"正说着曹操，曹操就到了。比喻正说着某人，某人就来了。"},{"id":41329,"word":"说条念款","pinyin":"shuō tiáo niàn kuǎn","abbr":"stnk","explanation":"指做出多项承诺，多项保证。","source":{"text":"你家汉子说条念款说将来，我趁将你家来了？这也不难的勾当，等他来家，与了我休书，我去就是了。","book":"《金瓶梅词话》第七十五回"},"usage":"作谓语、定语、状语；用于处事"},{"id":41330,"word":"说来话长","pinyin":"shuō lái huà cháng","abbr":"slhc","explanation":"表示事情很复杂，不是几句话就能说清楚（多指不大愉快的事）。","source":{"text":"说来话长。五年前我们老娘家里做生日，妈和我们到那里与老娘拜寿。","book":"清·曹雪芹《红楼梦》第66回"},"example":{"text":"这件事～，不是一两句话能说清的。"},"usage":"作谓语、分句；用于口语，指不大愉快的事"},{"id":41331,"word":"说来说去","pinyin":"shuō lái shuō qù","abbr":"slsq","explanation":"①反复阐说。②犹言总而言之。","source":{"text":"说来说去，只是一个道理。","book":"宋·朱熹《朱子语类》第116卷"},"example":{"text":"唉～。就是太不灵机，太死脑筋。","book":"浩然《石山柏》"},"similar":["总而言之"],"usage":"作状语、分句；用于口语"},{"id":41332,"word":"说来道去","pinyin":"shuō lái dào qù","abbr":"sldq","explanation":"指众说纷纭。","source":{"text":"一大伙人，你一句，我一句，说来道去，搞得好几个生产组长也五心不定，都不开口了。","book":"周立波《桐花没有开》"},"similar":["说来说去","众说纷纭"],"usage":"作谓语、定语、分句；用于口语"},{"id":41333,"word":"说梅止渴","pinyin":"shuō méi zhǐ kě","abbr":"smzk","explanation":"说到梅子，就会流口水，因而止渴。比喻借想像以自慰。","source":{"text":"说梅止渴，稍苏奔竞之心；画饼充饥，少谢腾骧之志。","book":"宋·李清照《打马赋》"},"similar":["望梅止渴"],"usage":"作宾语、定语；用于处事"},{"id":41334,"word":"说死说活","pinyin":"shuō sǐ shuō huó","abbr":"sssh","explanation":"任凭如何说法。","source":{"text":"‘看吧——’孔丽丽把照片塞过来，冲着老崔头的背影作了个怪相，‘老崔头说死说活也不照。’","book":"《花城》1981年第5期"},"usage":"作谓语、定语、状语；用于口语"},{"id":41335,"word":"说白道绿","pinyin":"shuō bái dào lǜ","abbr":"sbdl","explanation":"比喻对人对事任意评论。","source":{"text":"那婆子吃了许多酒，口里只管夹七带八嘈，正在那里张家长，李家短，说白道绿。","book":"明·施耐庵《水浒传》第二十一回"},"similar":["说长道短","信口雌黄","说白道黑"],"usage":"作谓语、定语；比喻对人对事任意评论"},{"id":41336,"word":"说白道黑","pinyin":"shuō bái dào hēi","abbr":"sbdh","explanation":"比喻对人对事任意评论。同“说白道绿”。","source":{"text":"小肉儿，还恁说白道黑。他一个佛家之子，你也消受不的他这个问讯。","book":"明·兰陵笑笑生《金瓶梅词话》第第八十八回"},"similar":["说黑道白"],"usage":"作谓语；比喻对人对事任意评论"},{"id":41337,"word":"说短论长","pinyin":"shuō duǎn lùn cháng","abbr":"sdlc","explanation":"议论别人的好坏是非。","source":{"text":"无道人之短，无说己之长。","book":"汉·崔瑗《座佑铭》"},"example":{"text":"休那里～语话频。","book":"元·无名氏《冯玉兰》第一折"},"similar":["说长道短","说长话短","说长论短"],"opposite":["一言不发"],"usage":"作谓语、宾语、定语；指随意谈论各种事情"},{"id":41338,"word":"说短道长","pinyin":"shuō duǎn dào cháng","abbr":"sddc","explanation":"说长处，讲短处。形容议论别人的好坏是非。","source":{"text":"无道人之短，无说己之长。","book":"汉·崔瑗《座佑铭》"},"example":{"text":"“禹过家门不入”似的一头赶来谈正经事，却如得到了空泛的好像是第三者的～。","book":"茅盾《三人行》"},"similar":["说长道短","说长论短","说长话短"],"usage":"作谓语、宾语、定语；指嘴多"},{"id":41339,"word":"说经夺席","pinyin":"shuō jīng duó xí","abbr":"sjdx","explanation":"讲说经书，争夺席位。原指讲经者互相诘难，义理不通者夺其讲席。后比喻口头上讲仁义道德，实际在争权夺利。","source":{"text":"正旦朝贺，光武令群臣能说经者，更相诘难，义有不通，辄夺其席，以益通者，戴凭遂夺五十余席。","book":"《后汉书·戴凭传》"}},{"id":41340,"word":"说说笑笑","pinyin":"shuō shuō xiào xiào","abbr":"ssxx","explanation":"有说有笑，连说带笑。","source":{"text":"还象适才坐着，大家说说笑笑，岂不斯文些儿。","book":"清·曹雪芹《红楼梦》第22回"},"example":{"text":"他们～，闹到尽欢而散。"},"similar":["有说有笑"],"usage":"作谓语、状语；指人的形态","story":["贾府热闹非凡，贾母开宴庆生日，贾政陪贾母一起玩闹、猜谜与讲笑话，大家十分高兴。贾政因故离开，宝玉就神气活现了，他跑至围屏灯前指手画脚，满口批评说这个的这句不好，那个的破的不恰当，就像开了锁的猴子一样，他们说说笑笑，尽欢而散"]},{"id":41341,"word":"说说而已","pinyin":"shuō shuō ér yǐ","abbr":"ssey","explanation":"非实质性的事物，空谈，闲谈。","source":{"text":"但是僚友必要耻笑于我，只好说说而已的了。","book":"清·无名氏《说呼全传》第二回"},"example":{"text":"这只是～。"},"similar":["空谈阔论"],"usage":"作宾语；指空谈"},{"id":41342,"word":"说谎调皮","pinyin":"shuō huǎng tiáo pí","abbr":"shtp","explanation":"说假话并从中捣鬼。","source":{"text":"你这和尚，风张风势，说谎调皮，没些儿至诚的。","book":"元·李寿卿《度柳翠》楔子"},"usage":"作谓语、宾语；用于口语"},{"id":41343,"word":"说长论短","pinyin":"shuō cháng lùn duǎn","abbr":"scld","explanation":"说长处，讲短处。形容议论别人的好坏是非。","source":{"text":"无道人之短，无说己之长。","book":"汉·崔瑗《座佑铭》"},"example":{"text":"她的性格有一面很像我的一个妹妹，就是心直口快，对什么都没有顾忌，也不怕别人～。","book":"巴金《谈〈秋〉》"},"similar":["说长话短","说长道短","说短道长"],"usage":"作谓语、宾语、定语；指嘴多"},{"id":41344,"word":"说长话短","pinyin":"shuō cháng huà duǎn","abbr":"schd","explanation":"议论别人的好坏是非。同“说长道短”。","source":{"text":"无道人之短，无说己之长。","book":"汉·崔瑗《座佑铭》"},"example":{"text":"数黑论黄雌陆贾，～女随何。","book":"明·冯梦龙《醒世恒言》卷三"},"similar":["说长论短","说长道短","说短道长"],"usage":"作谓语、宾语、定语；指嘴多"},{"id":41345,"word":"说长说短","pinyin":"shuō cháng shuō duǎn","abbr":"scsd","explanation":"议论别人的好坏是非。同“说长道短”。","source":{"text":"词语甚工，然犹说长说短，说人说我，未能尽抱滕之意也。","book":"宋·叶适《爱日斋丛钞》第三卷"},"example":{"text":"清·曹雪芹《红楼梦》第60回：“赵姨娘无法，只好同他们三人出来，口内犹～。”"},"similar":["说长道短","说长论短","说短道长"],"usage":"作谓语、宾语、定语；指嘴多"},{"id":41346,"word":"说长道短","pinyin":"shuō cháng dào duǎn","abbr":"scdd","explanation":"议论别人的好坏是非。","source":{"text":"无道人之短，无说己之长。","book":"汉·崔瑗《座佑铭》"},"example":{"text":"这些缙绅士大夫家筵席间，定要几个梨园中人，杂坐衣冠队中，～，这个成何体统！","book":"清·吴敬梓《儒林外史》第五十三回"},"similar":["说三道四","议论纷纷"],"opposite":["守口如瓶","一言不发"],"usage":"作谓语、宾语、定语；指嘴多"},{"id":41347,"word":"说雨谈云","pinyin":"shuō yǔ tán yún","abbr":"syty","explanation":"谈说男女风情之事。","source":{"text":"弄柳拈花手倦抬，说雨谈云口倦开，须发已斑白，风流顿改。","book":"元·汤式《赏花时·送友人观光》套曲"},"usage":"作谓语、定语、宾语；用于聊天"},{"id":41348,"word":"说风凉话","pinyin":"shuō fēng liáng huà","abbr":"sflh","explanation":"站在事件之外说讽刺性的话。","example":{"text":"世上有些人喜欢锦上添花或站在高枝上～，很难在别人犯了错误时多想想人家的长处。","book":"姚雪垠《李自成》第二卷第五十章"}},{"id":41349,"word":"说风说水","pinyin":"shuō fēng shuō shuǐ","abbr":"sfss","explanation":"指撺掇怂勇。","source":{"text":"茶童见了钱，欢喜起来，又去说风说水道：‘娘子受了两杯，也该去回敬一杯。’","book":"《二刻拍案惊奇》卷十四"},"usage":"作谓语、状语；用于方言"},{"id":41350,"word":"说黄道黑","pinyin":"shuō huáng dào hēi","abbr":"shdh","explanation":"比喻对人对事任意评论。","source":{"text":"你入门来便闹起，有甚的论黄数黑。","book":"元·杨文奎《儿女团圆》第一折"},"example":{"text":"你这厮在蔡九知府后堂且会～，拨置害人，无中生有撺掇他。","book":"明·施耐庵《水浒全传》第四十一回"},"similar":["说黑道白","说长道短"],"usage":"作谓语；指挑拨是非"},{"id":41351,"word":"说黑道白","pinyin":"shuō hēi dào bái","abbr":"shdb","explanation":"比喻对人对事任意评论。","source":{"text":"你入门来便闹起，有甚的论黄数黑。","book":"元·杨文奎《儿女团圆》第一折"},"example":{"text":"你这丫头，也跟着他恁张眉瞪眼儿，～的，将就些儿罢。","book":"明·兰陵笑笑生《金瓶梅词话》第六十回"},"similar":["说长道短","说三道四"],"usage":"作谓语；比喻对人对事任意评论"},{"id":41352,"word":"请人捉刀","pinyin":"qǐng rén zhuō dāo","abbr":"qrzd","explanation":"捉刀：指代人作文。代人做事或写文章。","source":{"text":"魏王雅望非常，然床头捉刀人，此乃英雄也。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"能写最好是亲笔书写，不要～。"},"similar":["代人捉刀"],"usage":"作谓语；指请人代做","story":["三国时期，生性多疑的曹操在会见匈奴的使者时，为了显示他的威武形象就让一表人才的崔季珪装成他接见，自己则扮成武士提着刀站在床头。会见完毕就命间谍问匈奴使者对魏王的印象如何，匈奴使者说床头捉刀人才是真正的英雄"]},{"id":41353,"word":"请从隗始","pinyin":"qǐng cóng wěi shǐ","abbr":"qcks","explanation":"隗：郭隗自称。原指拿自己做一个榜样。后比喻自愿带头。","source":{"text":"王必欲致士，请从隗始；况贤于隗者，岂远千里哉？","book":"《史记·燕召公世家》"},"example":{"text":"万事～耳，神州是我我神州！","book":"龚济民、方仁念《郭沫若传》第三章七"}},{"id":41354,"word":"请先入瓮","pinyin":"qǐng xiān rù wèng","abbr":"qxrw","explanation":"指请先受审认罪。","source":{"text":"则说老夫请先入瓮。","book":"元·纪君祥《赵氏孤儿》第二折"},"usage":"作谓语；用于口语"},{"id":41355,"word":"请功受赏","pinyin":"qǐng gōng shòu shǎng","abbr":"qgss","explanation":"请示评定功绩给予奖赏。","source":{"text":"务要将这贼众拿住了，请功受赏去也。","book":"元·纪君祥《赵氏孤儿》第一折：“罢，罢，罢！将军，你拿将程婴去，请功受赏。”明·无名氏《女学士》第四折"},"example":{"text":"货物撇了不打紧，且收拾车子装贼；把这贼首解上京师，～，方表我平生之志。","book":"明·施耐庵《水浒全传》第六十回"},"usage":"作谓语；用于口语"},{"id":41356,"word":"请君入瓮","pinyin":"qǐng jūng rù wèng","abbr":"qjrw","explanation":"瓮：一种陶制的盛器。比喻用某人整治别人的办法来整治他自己。","source":{"text":"兴曰：‘此甚易尔！取大瓮，令囚入中，何事不承！’俊臣乃索大瓮，火围如兴法，因起谓兴曰：‘有内状推兄，请兄入此瓮。’兴惶恐叩头伏罪。","book":"《资治通鉴·唐纪·则天皇后天授二年》"},"example":{"text":"掬西江之水，为尔洗肠，即烧东壁之床，～。","book":"清·蒲松龄《聊斋志异·席方平》"},"similar":["以毒攻毒","以牙还牙"],"opposite":["与人为善"],"usage":"作谓语、定语；用于书面语","story":["唐朝武则天时酷吏周兴设计许多惨无人道的酷刑对付囚犯。后来有人密告武则天说周兴想谋反，武则天派另一个酷吏来俊臣去查办。来俊臣请周兴喝酒询问对付囚犯的办法，周兴说用大瓮烧火对付，来俊臣就用这个办法使周兴就范"]},{"id":41357,"word":"请客送礼","pinyin":"qǐng kè sòng lǐ","abbr":"qksl","explanation":"宴请客人，馈赠礼物。","source":{"text":"有的部队请客送礼，修建楼堂馆所。","book":"邓小平《军队整顿的任务》"},"usage":"作谓语、宾语、定语；用于交往"},{"id":41358,"word":"请将不如激将","pinyin":"qǐng jiàng bù rú jī jiàng","abbr":"qjbrjj","explanation":"指用话语刺激别人去干事要比正面请他去干事来得好。","source":{"text":"请将不如激将，等我激他一激。","book":"明·吴承恩《西游记》第31回"},"example":{"text":"我有道理，～，且待激他一激，或者激些主意出来，也不可知。","book":"清·李渔《怜香伴·鞅望》"},"usage":"作宾语、定语；用于处事"},{"id":41359,"word":"请由此亡","pinyin":"qing you chi wang","abbr":"qycw","explanation":"请允许我从此离开您。"},{"id":41360,"word":"请自隗始","pinyin":"qǐng zì wěi shǐ","abbr":"qzws","explanation":"自：从；隗：郭隗自称。原指拿自己做一个榜样。后比喻自愿带头。","source":{"text":"王必欲致士，请从隗始；况贤于隗者，岂远千里哉？","book":"《史记·燕召公世家》"},"example":{"text":"愈虽不才，其自处不敢后于恒人，阁下将求之而未得欤？古人有言，～。","book":"唐·韩愈《与于襄阳书》"},"similar":["先自隗始"],"usage":"作谓语；比喻自愿带头","story":["战国时期，燕昭王即位后，一心想振兴燕国，想招揽天下贤才为之服务，就与谋士郭隗商量计策。郭隗说：“今大王想招揽贤才，请先从我郭隗开始。像我这样的人都能被重用，那么比我能干的人肯定会来归附的。”燕昭王采纳他的意见"]},{"id":41361,"word":"请长缨","pinyin":"qǐng cháng yīng","abbr":"qcy","explanation":"缨：绳子。指请求上前线杀敌。","source":{"text":"少小虽非投笔吏，论功还须请长缨。","book":"唐·祖咏《望蓟门》"},"example":{"text":"尽识山川险，深穷彼我情。归来俱封奏，直上～。","book":"宋·李觏《送路拯北游》"}},{"id":41362,"word":"请骸骨","pinyin":"qǐng hái gǔ","abbr":"qhg","explanation":"请：求。古代官吏因年老请求退职。","source":{"text":"天下事大定矣，君王自为之！愿请骸骨归！","book":"西汉·司马迁《史记·陈丞相世家》"},"similar":["乞骸骨"],"usage":"作谓语；指告老还乡"},{"id":41363,"word":"诸事麇集","pinyin":"zhū shì qún jí","abbr":"zsjj","explanation":"麇：成群。许多事情集中在一起","source":{"text":"一日诸事麇集，几至调排不开。","book":"清·吴跃人《俏皮话》"},"usage":"作谓语、定语；用于书面语"},{"id":41364,"word":"诸亲六眷","pinyin":"zhū qīn liù juàn","abbr":"zqlj","explanation":"总称所有亲戚。","source":{"text":"自此，严监生的病，一日重似一日，再不回头。诸亲六眷都来问候。","book":"清·吴敬梓《儒林外史》第五回"},"similar":["诸亲好友"],"usage":"作主语、宾语、定语；用于书面语"},{"id":41365,"word":"诸亲好友","pinyin":"zhū qīn hǎo yǒu","abbr":"zqhy","explanation":"总称所有亲友。","source":{"text":"等到张书生和李相公临走时，街坊乡邻、诸亲好友来送行，姑嫂两人就借这个机会表明心迹。","book":"《苏州的传说·双塔的传说》"},"similar":["诸亲六眷"],"usage":"作主语、宾语、定语；用于书面语"},{"id":41366,"word":"诸如此例","pinyin":"zhū rú cǐ lì","abbr":"zrcl","explanation":"许多像这样的事例。","source":{"text":"凡后宫乐府，西解暴室，诸如此例，一皆放遣。","book":"《梁书·武帝纪中》"},"example":{"text":"周则冠冕衣裘，乘车而战，今何故不行？周则三老五更、胶序养老， 今何故不行乎？～，不可胜述。","book":"唐·田再思《服母齐衰三年议》"},"usage":"作定语、分句；用于书面语"},{"id":41367,"word":"诸如此比","pinyin":"zhū rú cǐ bǐ","abbr":"zrcb","explanation":"许多与此相类似的事物。","source":{"text":"又州郡估税，所在市调，多有烦刻。山泽之利，犹或禁断，役召之品，遂及稚弱。诸如此比，伤治害民。","book":"《宋书·文帝纪》"},"similar":["诸如此类"],"usage":"作宾语、分句；用于书面语"},{"id":41368,"word":"诸如此类","pinyin":"zhū rú cǐ lèi","abbr":"zrcl","explanation":"诸：众多；此：这，这样。象这类的各种事物。","source":{"text":"诸如此类 ，亦不得已已。","book":"《晋书·刘颂传》"},"example":{"text":"书法、绘画、吟诗，～，他无一不会。"},"similar":["依此类推"],"usage":"作状语、分句；常与“举不胜举”连用"},{"id":41369,"word":"诸子百家","pinyin":"zhū zǐ bǎi jiā","abbr":"zzbj","explanation":"原指先秦时期各种思想的代表人物和各个派别，后用来对先秦至汉初各种流派的总称。","source":{"text":"贾生年少，颇通诸子百家之书。文帝召以为博士。","book":"西汉·司马迁《史记·屈原贾生列传》"},"example":{"text":"我们决不拘泥统属，我们只以会全力追求自己的人生目的——不管它是三教九流，～。","book":"王西彦《古屋》第五部"},"similar":["百家诸子"],"usage":"作宾语、定语；指各种学术流派"},{"id":41370,"word":"诸恶莫作","pinyin":"zhū è mò zuò","abbr":"zemz","explanation":"诸恶：各种坏事。佛家语，凡是坏事都不要做。旧时用以劝人行善。","source":{"text":"诸恶莫作，诸善奉行。","book":"《大般涅槃经》"},"example":{"text":"劝君诸善奉行，但是～。","book":"明·冯梦龙《醒世恒言》卷十八"},"usage":"作谓语、宾语；用以劝人行善"},{"id":41371,"word":"诸有此类","pinyin":"zhū yǒu cǐ lèi","abbr":"zycl","explanation":"许多与此相类似的事物。","source":{"text":"诸有此类，并文士之瑕累。","book":"南朝·梁·刘勰《文心雕龙·程器》"},"usage":"作定语、分句；用于书面语"},{"id":41372,"word":"诸法实相","pinyin":"zhū fǎ shí xiàng","abbr":"zfsx","explanation":"佛家语。指各种现象的真实面目","source":{"text":"唯佛与佛，乃能究尽诸法实相。","book":"《法华经·方便品》"},"usage":"作宾语、定语；用于书面语"},{"id":41373,"word":"诸色人等","pinyin":"zhū sè rén děng","abbr":"zsrd","explanation":"各种各样、各色各等的人们。","source":{"text":"百姓及诸色人等如能力行仁义，均减有无，赒贷贫人，全活数众者，府司具事迹闻奏，朕当授以官秩，蠲其征徭。","book":"唐·陆贽《优恤畿内百姓并除十县令诏》"},"example":{"text":"这是一个演说时代，所以‘～’都能演说。","book":"许地山《危巢坠简·街头巷尾之伦理》"},"usage":"作宾语、定语；用于书面语"},{"id":41374,"word":"诸若此类","pinyin":"zhū ruò cǐ lèi","abbr":"zrcl","explanation":"许多与此相类似的事物。","source":{"text":"诸若此类，注所未及，讵可以非注所有，而谓为异说乎？","book":"清·王夫之《夕堂永日绪论外编》二六"},"similar":["诸如此类"],"usage":"作宾语、分句；用于书面语"},{"id":41375,"word":"诸行无常","pinyin":"zhū xíng wú cháng","abbr":"zxwc","explanation":"佛家语。指万物变化多端。比喻人生无常","source":{"text":"诸行无常，是生是灭，生灭灭已，寂灭为乐。","book":"宋·释道原《景德传灯录》"},"usage":"作谓语、定语；用于书面语"},{"id":41376,"word":"诺诺尔尔","pinyin":"nuò nuò ěr ěr","abbr":"nnee","explanation":"尔尔：如此如此。是，就这样办。","source":{"text":"媒人下床去，诺诺复尔尔。","book":"《玉台新咏·古诗为焦仲卿妻作》"},"usage":"作分句、定语；用于书面语"},{"id":41377,"word":"诺诺连声","pinyin":"nuò nuò lián shēng","abbr":"nnls","explanation":"一声接一声地答应。形容十分恭顺的样子。","source":{"text":"单道台诺诺连声，告退下去。","book":"清·李宝嘉《官场现形记》第57回"},"example":{"text":"他对谁的话都是～地称赞。"},"similar":["连连称是","点头哈腰","喏喏连声"],"usage":"作谓语、状语；表示顺从的样子"},{"id":41378,"word":"读万卷书，行万里路","pinyin":"dú wàn juàn shū，xíng wàn lǐ lù","abbr":"dwjsxwll","explanation":"读万卷书，如同行万里路一样。形容多读书，则见多识广。","source":{"text":"《眼镜铭》：读万卷书，行万里路，有耀自他，我得其助。","book":"清·梁绍壬《两般秋雨庵随笔》卷五"},"usage":"作宾语、定语；用于口语"},{"id":41379,"word":"读不舍手","pinyin":"dú bù shě shǒu","abbr":"dbss","explanation":"舍：舍得，愿意。读书读到有兴趣时舍不得放下。","source":{"text":"爱其诗，读不舍手；属其谈，挽不听去。","book":"宋·胡仔《苕溪渔隐丛话·参寥》"},"example":{"text":"年轻人遇到好书都会～的。"},"similar":["手不释卷"],"usage":"作谓语、定语；指爱读书"},{"id":41380,"word":"读书三余","pinyin":"dú shū sān yú","abbr":"dssy","explanation":"余：冬者岁之余，夜者日之余，阴雨者晴之余。指读好书要抓紧一切闲余时间。","source":{"text":"人有从学者，……从学者云，苦渴无日。遇言：‘当以三余。’或问：‘三余’之意。遇言：冬者岁之余，夜者日之余，阴雨者晴之余。","book":"《三国志·魏志·董遇传》云"},"usage":"作宾语、定语；用于学习"},{"id":41381,"word":"读书三到","pinyin":"dú shū sān dào","abbr":"dssd","explanation":"形容读书十分认真。","source":{"text":"余尝谓读书有三到：谓心到，眼到，口到……三到之中，心到最紧。","book":"宋·朱熹《训学斋规》"},"example":{"text":"我们要学古人～的学习方法。"},"usage":"作宾语、定语；指读书十分认真"},{"id":41382,"word":"读书君子","pinyin":"dú shū jūn zǐ","abbr":"dsjz","explanation":"旧时称有志操有学问的人。","source":{"text":"［末云］敢问小姐常出来么？［红怒云］先生是读书君子，孟子曰：‘男女授受不亲，礼也。’","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"高赞见女儿人物整齐，且又聪明，不肯将他配个平等之，定要拣个～、才貌兼全的配他，聘礼厚薄到也不论。","book":"明·冯梦龙《醒世恒言》第七卷"}},{"id":41383,"word":"读书得间","pinyin":"dú shū dé jiàn","abbr":"dsdj","explanation":"间：间隙。比喻窍门。读书得了窍门。形容读书能寻究窍门，心领神会。","source":{"text":"你真可谓读书得间了！你说的一点不错。","book":"清·李宝嘉《官场现形记》第54回"},"example":{"text":"古人说的‘～’这也许可以说是要‘看题得间’。","book":"邹韬奋《经历·大声疾呼的国文课》"},"usage":"作宾语；形容读书能探究窍门，心领神会"},{"id":41384,"word":"读书百遍，其义自见","pinyin":"dú shū bǎi biàn，qí yì zì xiàn","abbr":"dsbbqyzj","explanation":"见：显现。读书上百遍，书意自然领会。指书要熟读才能真正领会。","source":{"text":"人有从学者，遇不肯教，而云：‘必当先读百遍’，言‘读书百遍而义自见。’","book":"晋·陈寿《三国志·魏志·王肃传》"},"example":{"text":"～，这话一点不假。"},"usage":"作定语、分句；指导人读书"},{"id":41385,"word":"读书破万卷","pinyin":"dú shū pò wàn juàn","abbr":"dspwj","explanation":"破：突破；卷：书籍册数。形容读书很多，学识渊博。","source":{"text":"读书破万卷，下笔如有神。","book":"唐·杜甫《奉赠韦左丞文二十韵》"},"example":{"text":"所谓‘～，下笔如有神’，也便指的是学力。","book":"茅盾《杂谈思想与技巧、学力与经验》"},"similar":["学识渊博","满腹经纶"],"opposite":["胸无点墨"],"usage":"作主语、宾语；指人读书多"},{"id":41386,"word":"读书破万卷，下笔如有神","pinyin":"dú shū pò wàn juàn，xià bǐ rú yǒu shén","abbr":"dspwjxbrys","explanation":"将万卷书读破了，下笔写文章就如有神助。比喻要想写好文章，就要多读书。","source":{"text":"读书破万卷，下笔如有神。","book":"唐·杜甫《奉赠韦丞丈二十二韵》"},"example":{"text":"～，前程事业，岂期中路惹灾迍。","book":"宋·无名氏《张协状元》第十八出"}},{"id":41387,"word":"读书种子","pinyin":"dú shū zhǒng zǐ","abbr":"dszz","explanation":"指在文化上能承先启后的读书人。","source":{"text":"山谷云：‘士大夫子弟，不可令读书种子断绝，有才气者出，便当名世矣。’","book":"宋·周密《齐东野语·书种文种》"},"example":{"text":"城下之日，彼必不降，幸勿杀之。杀孝孺，天下～绝矣。","book":"《明史·方孝孺传》"},"usage":"作主语、宾语；指读书人"},{"id":41388,"word":"诽誉在俗","pinyin":"fěi yù zài sú","abbr":"fyzs","explanation":"诽：指诽谤；誉：赞扬；俗：风气、习惯。诽谤或赞扬在于当时的风习。后来引申指风气、习惯的作用非常大。","source":{"text":"故趋舍同，诽誉在俗；意行钧，穷达在时。","book":"汉·刘安《淮南子·齐俗训》"},"usage":"作谓语、宾语；指习惯的作用非常大"},{"id":41389,"word":"诽谤之木","pinyin":"fěi bàng zhī mù","abbr":"fbzm","explanation":"诽谤：引以为谏言；木：木牌。在交通要塞竖立木牌，让人们写上谏言。","source":{"text":"古之治天下，朝有进善之旌，诽谤之木，所以通治者而来谏者。","book":"《史记·孝文本纪》"},"usage":"作宾语；指让人写谏言的木牌"},{"id":41390,"word":"课嘴撩牙","pinyin":"kè zuǐ liáo yá","abbr":"kzly","explanation":"搬唇弄舌。课，用同“嗑”。","source":{"text":"锦心绣腹，宣扬《老子》经文，发科打诨，不离机锋；课嘴撩牙，长存道眼。","book":"明·陶宗仪《南村辍耕录·连枝秀》"},"similar":["磕牙料嘴"],"usage":"作谓语、宾语；用于口语"},{"id":41391,"word":"课语讹言","pinyin":"kè yǔ é yán","abbr":"kyey","explanation":"多嘴多舌，胡言乱语。","source":{"text":"咱家里有课语讹言的，怎奈何？娘，你可急忙告报官司去，恐带累咱们！","book":"《宣和遗事》前集"},"similar":["胡言乱语"],"usage":"作宾语；指胡言乱语"},{"id":41392,"word":"诿过于人","pinyin":"wěi guò yú rén","abbr":"wgyr","explanation":"诿：推卸；过：过错。把过错推给别人。","source":{"text":"朕自少时，见三藩势焰日炽，不可不撤，岂因三桂背叛，遂诿过于人？","book":"蔡东藩《清史演义》第二十六回"},"example":{"text":"陈诚为了～，把新五军被歼的责任推到将领不服从命令上去。","book":"刘凤舞《民国春秋》第二十二章"}},{"id":41393,"word":"谁为为之","pinyin":"shuí wèi wéi zhī","abbr":"swwz","explanation":"谁为：即为谁；为：做，作为。慨叹没有知己，为谁而作。","source":{"text":"谚曰：‘谁为为之？孰令听之？’","book":"汉·司马迁《报任少卿书》"},"example":{"text":"请问晋人的清谈，～？孰令致之？","book":"朱自清《“海阔天空”与“古今中外”》"}},{"id":41394,"word":"谁是谁非","pinyin":"shuí shì shuí fēi","abbr":"sssf","explanation":"犹言谁对谁错。","source":{"text":"谁与你挑唇料嘴，辨别个谁是谁非。","book":"元·李致远《还牢末》第一折"},"example":{"text":"～谁曲谁直，没梁桶儿一再休提！","book":"明·刘兑《金童玉女娇红记》"},"similar":["谁对谁错","是是非非"],"usage":"作宾语、定语；用于口语"},{"id":41395,"word":"调三惑四","pinyin":"tiáo sān huò sì","abbr":"tshs","explanation":"指挑拨是非。同“调三斡四”。","source":{"text":"恼的是那狐朋狗友，搬是弄非、调三惑四。","book":"《红楼梦》第十回"},"similar":["调三斡四"],"usage":"作谓语、定语、宾语；用于口语"},{"id":41396,"word":"调三斡四","pinyin":"tiáo sān wò sì","abbr":"tsws","explanation":"指挑拨是非。","source":{"text":"你休那里便伶牙俐齿，调三斡四，说人好歹，讦人暧昧。","book":"元·吴昌龄《张天师》第三折"},"example":{"text":"他正是节外生枝，～，只教你大浑家吐不的咽不的这一个心头刺。","book":"元·无名氏《货郎旦》第四折"},"similar":["调三窝四","挑三豁四","挑三拨四"],"usage":"作谓语、定语、宾语；用于口语"},{"id":41397,"word":"调三窝四","pinyin":"tiáo sān wō sì","abbr":"tsws","explanation":"指挑拨是非。同“调三斡四”。","source":{"text":"少不得意，不是背地里嚼舌根，就是调三窝四的。","book":"清·曹雪芹《红楼梦》第71回"},"example":{"text":"你不要在我家人面前～的好不好？"},"similar":["调三斡四"],"usage":"作谓语、定语、宾语；用于口语"},{"id":41398,"word":"调丝品竹","pinyin":"tiáo sī pǐn zhú","abbr":"tspz","explanation":"指吹弹乐器。","source":{"text":"自家鲍四娘，调丝品竹，蚤谢同心；挟策追锋，还推老手。","book":"明·汤显祖《紫箫记·假骏》"},"example":{"text":"明·冯梦龙《醒世恒言》第29卷：“旁边五六个标致青衣，～，按板而歌。”"},"similar":["调弦品竹","调丝弄竹"],"usage":"作谓语、宾语、定语；用于音乐"},{"id":41399,"word":"调丝弄竹","pinyin":"tiáo sī nòng zhú","abbr":"dsnz","explanation":"泛指吹弹乐器。","source":{"text":"论文时芸窗下摘句寻章，论武时柳营内调丝弄竹。","book":"元·汤式《一枝花·赠人》套曲"},"similar":["调丝品竹","调弦品竹","调弦弄管"],"usage":"作谓语、宾语、定语；用于音乐"},{"id":41400,"word":"调停两用","pinyin":"tiáo tíng liǎng yòng","abbr":"ttly","explanation":"指居间观望，骑墙投机。","source":{"text":"拥戴称颂，悬金石不刊之书，令其遗臭千秋；门户宗盟，杜调停两用之局，防其夤缘一旦。","book":"清·侯方域《拟思宗改元追复扬涟等官爵并起被废诸臣旋钦定逆案颁示百官廷臣谢表》"},"usage":"作谓语、定语；用于处事"},{"id":41401,"word":"调兵遣将","pinyin":"diào bīng qiǎn jiàng","abbr":"dbqj","explanation":"调动兵力，派遣将领。泛指调动安排人力。","source":{"text":"写书教太师知道，早早调兵遣将，剿除贼寇报仇。","book":"明·施耐庵《水浒全传》第六十七回"},"example":{"text":"我闻得海上倭贼利害，自去厮杀不成？只是～，罚罪赏功而已。","book":"明·无名氏《鸣凤记·文华祭海》"},"similar":["兴师动众","招兵买马"],"opposite":["鸣金收兵","班师回朝"],"usage":"作谓语、定语；指调动安排人事"},{"id":41402,"word":"调剂盐梅","pinyin":"tiáo jì yán méi","abbr":"tjym","explanation":"盐、梅：调味品。比喻协调、平衡不同的力量和因素，多指宰相职责。后也指调解家庭矛盾。","source":{"text":"若作和羹，尔惟盐梅。","book":"《尚书·说命下》"},"example":{"text":"我一向原没学问，只因两个房下动了曲直之味，我～，燮理阴阳，平白添了许多大学问。","book":"清·李绿园《歧路灯》第七十九回"},"usage":"作谓语、定语；用于处事"},{"id":41403,"word":"调和阴阳","pinyin":"tiáo hé yīn yáng","abbr":"thyy","explanation":"使阴阳有序，风调雨顺。旧多指宰相处理政务。","source":{"text":"调和阴阳，陶治万物，化正天下，易于决流抑队。","book":"《汉书·贡禹传》"},"example":{"text":"臣蒙恩备台辅，不能奉宣政化，～。","book":"《后汉书·杨震传》"},"similar":["调理阴阳"],"usage":"作谓语、定语、宾语；用于处事"},{"id":41404,"word":"调和鼎鼐","pinyin":"tiáo hé dǐng nài","abbr":"thdn","explanation":"鼎：古代烹调食物的器具，三足两耳；鼐：大鼎。于鼎鼐中调味。比喻处理国家大事。多指宰相职责。","source":{"text":"果闻勿药之喜，更喜调鼎之功。","book":"《旧唐书·裴度传》"},"example":{"text":"司徒，你怎生立一人之下，坐万人之上，～，燮理阴阳。","book":"元·无名氏《连环计》第二折"},"usage":"作谓语、宾语；多指宰相职责"},{"id":41405,"word":"调唇弄舌","pinyin":"tiáo chún nòng shé","abbr":"tcns","explanation":"①耍嘴皮子，纵谈。②搬弄是非。亦作“调唇弄舌”。","source":{"text":"况在私衙中，料中外人来往，恣意调唇弄舌。","book":"《醒世恒言·李汧公穷邸遇侠客》"},"example":{"text":"～，莫非骂詈之言。","book":"明·汪廷讷《狮吼记·争宠》"},"similar":["调嘴弄舌","调舌弄唇","调嘴调舌"],"usage":"作谓语、宾语；指搬弄是非"},{"id":41406,"word":"调嘴学舌","pinyin":"tiáo zuǐ xué shé","abbr":"tzxs","explanation":"调嘴：耍嘴皮。指背地里说人闲话，搬弄是非。","source":{"text":"这早晚，东方将亮了，尚兀子调嘴弄舌！","book":"明·洪楩《清平山堂话本·快嘴李翠莲记》"},"example":{"text":"本意是在请灶君吃了，粘住他的牙，使他不能～，对玉帝说坏话。","book":"鲁迅《华盖集续编·送灶日漫笔》"},"similar":["调嘴弄舌"],"usage":"作谓语、宾语；指搬弄是非"},{"id":41407,"word":"调嘴弄舌","pinyin":"tiáo zuǐ nòng shé","abbr":"tzns","explanation":"调嘴：耍嘴皮。指背地里说人闲话，搬弄是非。","source":{"text":"这早晚，东方将亮了，还不梳妆完，尚兀子调嘴弄舌！","book":"明·洪楩《清平山堂话本·快嘴李翠莲记》"},"example":{"text":"你出去了几时，那杜兴十分放肆，不时进来～，要来欺骗我，没些尊卑。","book":"清·陈忱《水浒后传》第四回"},"similar":["调嘴调舌","调唇弄舌"],"usage":"作谓语、宾语；指搬弄是非"},{"id":41408,"word":"调嘴调舌","pinyin":"tiáo zuǐ diào shé","abbr":"tzds","explanation":"指耍嘴皮子，搬弄是非。同“调唇弄舌”。","source":{"text":"打的经济鲫鱼般跳。骂道：‘怪短命！谁和你那等调嘴调舌的！","book":"《金瓶梅词话》第四八回"},"example":{"text":"你们～的搞什么鬼呀？","book":"王镇《枪》第四幕"},"similar":["调嘴弄舌","调唇弄舌","调舌弄唇"],"usage":"作谓语、宾语；指搬弄是非"},{"id":41409,"word":"调墨弄笔","pinyin":"tiáo mò nòng bǐ","abbr":"tmnb","explanation":"指玩弄文字技巧。","source":{"text":"天文人文，文岂徒调墨弄笔为美丽之观哉？载人之行，传人之名也。","book":"汉·王充《论衡·佚文》"},"similar":["舞文弄墨"],"usage":"作谓语、宾语、定语；用于作文等"},{"id":41410,"word":"调度征求","pinyin":"diào dù zhēng qiú","abbr":"ddzq","explanation":"指征敛赋税。","source":{"text":"其令大司农艳今岁调度征求，及前年所调未毕者，勿复收责。","book":"《后汉书·桓帝纪》"},"usage":"作谓语、定语、宾语；用于征税"},{"id":41411,"word":"调弦品竹","pinyin":"diào xián pǐn zhú","abbr":"dxpz","explanation":"吹奏乐器。同“调丝品竹”。","source":{"text":"只听的调弦品竹，甚的是论道经邦。","book":"元·杨梓《霍光鬼谏》第一折"},"similar":["调丝品竹","调丝弄竹"],"usage":"作谓语、宾语、定语；用于音乐"},{"id":41412,"word":"调弦弄管","pinyin":"tiáo xián nòng guǎn","abbr":"dxng","explanation":"弦：弦乐器；管：管乐器。弹拨吹奏乐器。","source":{"text":"调弦弄管，持觞举杯；吟风咏月，朝东暮西。","book":"明·杨柔胜《玉环记·玉箫叹怀》"},"similar":["调弦品竹","调丝弄竹"],"usage":"作谓语、宾语、定语；用于音乐"},{"id":41413,"word":"调朱傅粉","pinyin":"tiáo zhū fù fěn","abbr":"tzff","explanation":"调弄、涂抹脂粉。比喻刻意修饰。","source":{"text":"此外汗牛充栋，效颦以为工，学步以为巧，调朱傅粉以为妍，使以白话译之，外美既去，陋质悉呈，好古之士，将骇而走耳。","book":"裘廷梁《伦白话为维新之本》"},"similar":["调朱弄粉"],"usage":"作谓语、宾语、定语；用于修饰"},{"id":41414,"word":"调朱弄粉","pinyin":"tiáo zhū nòng fěn","abbr":"tznf","explanation":"调弄脂粉，打扮妆饰。","source":{"text":"调朱弄粉总无心，瘦觉宽馀缠臂金。","book":"宋·朱淑真《恨别》诗"},"similar":["涂脂抹粉","调脂弄粉"],"usage":"作谓语、宾语；用于女性妆扮"},{"id":41415,"word":"调查研究","pinyin":"diào chá yán jiū","abbr":"dcyj","explanation":"了解情况，考察分析。","source":{"text":"调查研究，我们从前做得比较好。","book":"毛泽东《在扩大的中央工作会议上的讲话》"},"example":{"text":"我们要充分～之后才能下结论。"},"usage":"作主语、谓语、宾语；指考察分析"},{"id":41416,"word":"调理阴阳","pinyin":"tiáo lǐ yīn yáng","abbr":"tlyy","explanation":"犹言调和阴阳。","source":{"text":"宰相在上佐天子调理阴阳，下遂万物之宜，外镇抚四夷，内亲附百姓，使公卿大夫各得其职。","book":"汉·荀悦《汉纪·文帝纪一》"},"example":{"text":"以公～，燮谐风雅，三灵允降，万国同和，是用锡公轩县之乐，六佾之舞。","book":"南朝·陈·徐陵《陈公九锡文》"},"similar":["调和阴阳"],"usage":"作谓语、定语、宾语；用于处事"},{"id":41417,"word":"调神畅情","pinyin":"tiáo shén chàng qíng","abbr":"tscq","explanation":"使精神顺适，情绪欢畅。","source":{"text":"一日三饱，圣贤通执。奉君养亲，靡不加精。安虑润气，调神畅情。","book":"《北堂书钞》卷一四二引南朝·宋·徐爰《食箴》"},"usage":"作宾语、定语；用于书面语"},{"id":41418,"word":"调脂弄粉","pinyin":"tiáo zhī nòng fěn","abbr":"tznf","explanation":"①指妇女涂抹脂粉，整容打扮。②喻指诗文的富丽香艳。","source":{"text":"徐仲雅李九皋俱善诗。徐诗富艳，李多用事。李谓徐曰：‘公诗如美女善调脂弄粉。’徐曰：‘公诗乃鬻冥器者，乃垛叠死人耳。’","book":"宋·李颀《古今诗话》"},"example":{"text":"至后《尧民歌》《十二月》托物寓意，尤为妙绝，是岂作～语者可得窥其堂庑哉。","book":"明·何良俊《四友斋丛说·词曲》"},"similar":["涂脂抹粉"],"usage":"作谓语、宾语；用于女性妆扮"},{"id":41419,"word":"调舌弄唇","pinyin":"tiáo shé nòng chún","abbr":"tsnc","explanation":"犹言调唇弄舌。","source":{"text":"须不会调舌弄唇。对天修合方真药圣，揭榜入宫庭。","book":"明·徐元《八义记·孤儿出宫》"},"similar":["调唇弄舌","调嘴弄舌","调嘴调舌"],"usage":"作谓语、宾语；指搬弄是非"},{"id":41420,"word":"调良稳泛","pinyin":"tiáo liáng wěn fàn","abbr":"tlwf","explanation":"马匹调良，行船稳泛。指路途平安。","source":{"text":"七夕前，盛使遥临，捧读翰教，知旌旌于前月初五日莅镇，途间车马舟桥，调良稳泛，三省亦附骥平安。","book":"清·朱之瑜《与锅岛直能书》之二"},"usage":"作谓语、宾语；用于旅途"},{"id":41421,"word":"调虎离山","pinyin":"diào hǔ lí shān","abbr":"dhls","explanation":"设法使老虎离开原来的山冈。比喻用计使对方离开原来的地方，以便乘机行事。","source":{"text":"子牙公须是亲自用调虎离山计，一战成功。","book":"明·许仲琳《封神演义》第八十八回"},"example":{"text":"这自然是～之计，邓和武汉派都是不同意的。","book":"郭沫若《海涛集·南昌之一夜》"},"similar":["声东击西","围魏救赵"],"usage":"作谓语、定语；用于军事等"},{"id":41422,"word":"调虎离窠","pinyin":"diào hǔ lí kē","abbr":"dhlk","explanation":"调：调动，引诱；窠：动物的巢穴。比喻用计使敌方离开有利的地方，以便乘机行事","source":{"text":"天已大明，李文忠把大队人马，径抵应昌城外安营。此是刘军师这调虎离窠之计。","book":"明·郭勋《英烈传》第73回"},"similar":["调虎离山"],"usage":"作谓语、定语；用于处事等"},{"id":41423,"word":"调词架讼","pinyin":"tiáo cí jià sòng","abbr":"tcjs","explanation":"指调唆他人诉讼。","source":{"text":"尼姑在社会上并没有特殊地位，可是因为她是林德贵的知己，她竟能调词架讼，成了村里政治舞台上的要人。","book":"孙梨《白洋淀纪事·钟》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":41424,"word":"调风变俗","pinyin":"tiáo fēng biàn sú","abbr":"tfbs","explanation":"犹言移风易俗。","source":{"text":"详察朝士，有柴车蓬馆，高以殊等；雕墙华轮，卑其称谓。驰禽荒色，长违清编，嗜音酣酒，守官不徙，物识义方，且惧且劝，则调风变俗，不俟终日。","book":"《南齐书·崔祖思传》"},"usage":"作谓语、宾语；用于风俗等"},{"id":41425,"word":"调风弄月","pinyin":"tiáo fēng nòng yuè","abbr":"tfny","explanation":"调弄风月。比喻男女间的谈情说爱。","source":{"text":"春风管弦，夜月秋千，调风弄月醉花前。","book":"元·查德卿《醉太平·春情》曲"},"example":{"text":"我也曾絮叨叨讲口舌，实丕丕倾肺腑，下了些～死工夫。","book":"《全元散曲·集贤宾·秋怀》"},"similar":["打情骂俏","谈情说爱"],"usage":"作谓语、宾语、定语；用于男女之间"},{"id":41426,"word":"谄上傲下","pinyin":"chǎn shàng ào xià","abbr":"csax","explanation":"谄：讨好，奉承。对上谄媚讨好，对下傲慢。","source":{"text":"上交不谄，下交不骄，则可以有为矣。","book":"汉·扬雄《法言·修身》"},"example":{"text":"所谓“富贵在天”便是打破地上的权威，不走～的路去求不义的富贵。","book":"郭沫若《孔墨的批判》第三篇"},"similar":["谄上骄下"],"usage":"作谓语、定语；形容对上对下两面三刀"},{"id":41427,"word":"谄上抑下","pinyin":"chǎn shàng yi xià","abbr":"csyx","explanation":"讨好上司，欺压下级。","source":{"text":"（安同）性平正柔和，未尝有喜怒色，忠笃爱厚，不谄上抑下。","book":"《北史·安同传》"},"example":{"text":"这年头当官就靠～才能立足。"},"similar":["谄上欺下"],"usage":"作谓语、宾语、定语；形容讨好上司欺压下级"},{"id":41428,"word":"谄上欺下","pinyin":"chǎn shàng qī xià","abbr":"csqx","explanation":"谄：讨好，奉承；欺：欺压。讨好上司，欺压下级。","source":{"text":"上交不谄，下交不骄。","book":"汉·杨雄《法言·修身》"},"example":{"text":"……这位‘相府门前七品官，见他容易见我难’是旧社会里趋炎附势、～的典型人物。","book":"吴祖光《相府门前七品官》"},"similar":["谄上骄下"],"usage":"作谓语、定语；形容对上对下两面三刀"},{"id":41429,"word":"谄上骄下","pinyin":"chǎn shàng jiāo xià","abbr":"csjx","explanation":"谄：讨好，奉承。对上谄媚讨好，对下骄横无理。","source":{"text":"上交不谄，下交不骄，则可以有为矣。","book":"汉·扬雄《法言·修身》"},"example":{"text":"凡是这一号乡绅，一定是～，剥下奉上的。","book":"清·李绿园《歧路灯》第五十一回"},"similar":["狐假虎威","狗仗人势"],"opposite":["锄强扶弱"],"usage":"作谓语、定语；形容对上对下两面三刀"},{"id":41430,"word":"谄笑胁肩","pinyin":"chǎn xiào xié jiān","abbr":"cxxj","explanation":"讨好地强装笑脸，缩敛肩膀。形容阿谀逢迎的丑态。","source":{"text":"那些人贪他是出钱施主，当面只是甜言蜜语，谄笑胁肩，赚他上手。","book":"《初刻折案惊奇》卷十三"},"similar":["胁肩谄笑"],"opposite":["刚正不阿"],"usage":"作谓语、宾语；用于献媚讨好人"},{"id":41431,"word":"谄词令色","pinyin":"chǎn cí lìng sè","abbr":"ccls","explanation":"说奉承人家的话，扮作讨好人家的表情。","source":{"text":"勾践为人机险，今为釜中之鱼，命制庖人故谄词令色，以求免刑诛。","book":"《东周列国志》八○回"},"usage":"作谓语、宾语、定语；指讨好别人"},{"id":41432,"word":"谄谀取容","pinyin":"chǎn yú qǔ róng","abbr":"cyqr","explanation":"谄谀：谄媚，阿谀；容：脸色。谄谀巴结有权势的人，以求得他们的欢喜。","source":{"text":"自是之后，有腹诽之法，公卿大夫多谄谀取容矣。","book":"《史记·平准书八》"},"example":{"text":"而充无公方之操，不能正身率下，专以～。","book":"《晋书·贾充传》"},"similar":["阿意取容"],"opposite":["刚正不阿"],"usage":"作谓语、定语；指巴结别人"},{"id":41433,"word":"谆谆不倦","pinyin":"zhūn zhūn bù juàn","abbr":"zzbj","explanation":"恳切耐心地教诲，不知疲倦。","source":{"text":"先生从容告语，谆谆不倦，在邑三年，百姓爱之如父母，去之日，哭声震野。","book":"明·程颐《明道先生行状》"},"example":{"text":"父亲在日的～的‘庭训’早把他的青春情绪剥完。","book":"茅盾《创造》二"},"usage":"作谓语、定语、状语；用于书面语"},{"id":41434,"word":"谆谆告戒","pinyin":"zhūn zhūn gào jiè","abbr":"zzgj","explanation":"谆谆：教诲时恳切耐心的样子；告戒：劝告。恳切耐心地劝告","source":{"text":"命诸子子妇皆坐，置酒，谆谆告戒，家人见公无疾而遽若是，愕眙不知所答。","book":"宋·费衮《梁溪漫志·闲乐异事》"},"example":{"text":"明·余继登《典故纪闻》第六卷：“去岁命御史给事中往各处抚安军民，禁止奸慝，导其为善；临遣之际，～，务要安民。”"},"similar":["谆谆告诫"],"usage":"作谓语、定语；用于书面语"},{"id":41435,"word":"谆谆告诫","pinyin":"zhūn zhūn gào jiè","abbr":"zzgj","explanation":"谆谆：教诲不倦的样子；告诫：规劝。恳切耐心地劝告。","source":{"text":"诲尔谆谆，听我藐藐。","book":"《诗经·大雅·抑》"},"example":{"text":"督促提督吴永安等，相机前进，并与广西抚臣徐延旭联络会商，和衷共济，仰副圣意～之至意。","book":"高阳《清宫外史》下册"},"similar":["谆谆教导","循循善诱","诲人不倦"],"opposite":["不教而诛"],"usage":"作谓语、宾语；指开导人"},{"id":41436,"word":"谆谆善诱","pinyin":"zhūn zhūn shàn yòu","abbr":"zzsy","explanation":"耐心恳切地教诲、诱导。","source":{"text":"昔之设学校，教养之法，师生问对，愤悱开发，相与曲折反复，谆谆善诱。","book":"宋·刘挚《乞重修太学条制疏》"},"example":{"text":"做教师的要～，引导学生"},"similar":["循循善诱"],"usage":"作谓语、定语；用于书面语"},{"id":41437,"word":"谆谆教导","pinyin":"zhūn zhūn jiào dǎo","abbr":"zzjd","explanation":"谆谆：恳切、耐心的样子。恳切、耐心地教导。","source":{"text":"诲尔谆谆，听我藐藐。","book":"《诗经·大雅·抑》"},"example":{"text":"父亲，您生前～我们，不要那种脱离人民的虚无主义、个人主义。","book":"毛岸青《我们爱韶山的红杜鹃》"},"similar":["谆谆告诫","诲人不倦","循循善诱"],"opposite":["不教而诛","颐指气使"],"usage":"作主语、谓语、宾语；指开导别人"},{"id":41438,"word":"谆谆教诲","pinyin":"zhūn zhūn jiào huì","abbr":"zzjh","explanation":"谆谆：恳切、耐心的样子。恳切、耐心地启发开导。","source":{"text":"伯承同志热爱自己的同志，对干部总是循循善诱，谆谆教诲，期以进步。","book":"邓小平《庆祝刘伯承同志五十寿辰》"},"example":{"text":"周恩来同志关于如何对待困难和危险的～，永远牢记在我们心中。","book":"《一次难忘的航行》"},"similar":["谆谆教导"],"opposite":["不教而诛"],"usage":"作主语、谓语、宾语；指开导别人"},{"id":41439,"word":"谆谆诰诫","pinyin":"zhūn zhūn gào jiè","abbr":"zzgj","explanation":"恳切耐心地教诲劝告。同“谆谆告戒”。","source":{"text":"各省长官，皆能力保治安，军人尤深明大义，均任守卫地方之责，务望各以爱国勤勉，恪尽厥职，用副予视民如伤，谆谆诰诫之至意。此令。","book":"丁中江《北洋军阀史话·云南护国起义》"}},{"id":41440,"word":"谇帚德锄","pinyin":"suì zhǒu dé chú","abbr":"szdc","explanation":"形容风俗败坏，不仁爱。","source":{"text":"借父耰锄，虑有德色；母取箕帚，立而谇语。","book":"汉·贾谊《治安策》"},"example":{"text":"分房割奥，～。","book":"元·吴莱《狙赋》"},"similar":["伤风败俗"],"usage":"作宾语、定语；指败坏风俗"},{"id":41441,"word":"谈不容口","pinyin":"tán bù róng kǒu","abbr":"tbrk","explanation":"犹言赞不绝口。不住口地称赞。","source":{"text":"有弘农杨蘧者，曾到岭外，见阳朔、荔浦山水，谈不容口。","book":"宋·孙光宪《北梦琐言》第五卷"},"similar":["赞不绝口"],"usage":"作谓语、定语；用于处事"},{"id":41442,"word":"谈今论古","pinyin":"tán jīn lùn gǔ","abbr":"tjlg","explanation":"从今到古无所不谈，无不评论。","source":{"text":"还有一个道士，妙解章令。又能饮宴，论今说古，无有不知，多解多能，人间皆晓。","book":"《敦煌变文集·叶净能诗》"},"example":{"text":"人间开口笑樵渔，会～。","book":"元·张可久《端正好·渔乐》"},"similar":["论今说古","谈今说古"],"usage":"作谓语、宾语；形容谈话内容广泛"},{"id":41443,"word":"谈今说古","pinyin":"tán jīn shuō gǔ","abbr":"tjsg","explanation":"从今到古无所不谈，无不评论。形容谈话内容广泛。","source":{"text":"他在和田维勤躺着烟灯，谈今说古，没有完结。","book":"冯玉祥《我的生活》第30章"},"example":{"text":"冯玉祥《我的生活》第30章：“他在和田维勤躺着烟灯，～，没有完结。”"},"similar":["谈今论古","论今说古","说古谈今"],"usage":"作谓语、宾语；形容谈话内容广泛"},{"id":41444,"word":"谈优务劣","pinyin":"tán yōu wù liè","abbr":"tywl","explanation":"善于空谈而治理政务的能力很差。","source":{"text":"浚冲居鼎，谈优务劣。","book":"《晋书·山涛王戎等传赞》"},"usage":"作谓语、定语；用于为人"},{"id":41445,"word":"谈何容易","pinyin":"tán hé róng yì","abbr":"thry","explanation":"原指臣下向君主进言很不容易。后指事情做起来并不象说的那样简单。","source":{"text":"於戏！可乎哉？可乎哉？谈何容易。","book":"汉·东方朔《非有先生论》：“於戏！可乎哉？可乎哉？谈何容易。”《汉书·东方朔传》"},"example":{"text":"说的，～，他肯由你要回，方才不带他们去了。","book":"清·李宝嘉《文明小史》第十回"},"similar":["来之不易"],"opposite":["一挥而就","轻而易举"],"usage":"作谓语；形容问题复杂","story":["西汉时期，常侍郎东方朔极力反对汉武帝划上林苑，提出耕战强国的建议，没有被采纳。他只好写《非有先生论》，虚构故事：非有先生在吴国做官三年，从不发表政见，吴王纳闷。他列举关龙逢及比干等进言被杀，臣下向君上进言真不容易"]},{"id":41446,"word":"谈古论今","pinyin":"tán gǔ lùn jīn","abbr":"tglj","explanation":"从古到今无所不谈，无不评论。","source":{"text":"人间开口笑樵渔，会谈今论古。","book":"元·张可久《端正好·渔乐》"},"example":{"text":"连知识也说不上，哪里还有资格～。","book":"巴金《谈我的散文》"},"similar":["夸夸其谈","论今说古","说古谈今"],"usage":"作谓语、宾语；指夸夸其谈"},{"id":41447,"word":"谈古说今","pinyin":"tán gǔ shuō jīn","abbr":"tgsj","explanation":"从今到古无所不谈，无不评论。","source":{"text":"人间开口笑樵渔，会谈今论古。","book":"元·张可久《端正好·渔乐》"},"example":{"text":"到瓦官寺游耍，僧齐公一向与他相厚，出来接洽了。登阁眺远，～。","book":"明·凌濛初《初刻拍案惊奇》卷十九"},"similar":["谈今论古","论今说古","说古谈今"],"usage":"作谓语、宾语；形容谈话内容广泛"},{"id":41448,"word":"谈吐如流","pinyin":"tán tǔ rú liú","abbr":"ttrl","explanation":"形容说话滔滔不绝。","source":{"text":"是日焦大郎安排晚饭与满生同吃，满生一间，谈吐如流，更加酒兴豪迈，痛饮不醉，大郎一发投机，以为相见之晚。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"usage":"作谓语、定语、状语；用于说话等"},{"id":41449,"word":"谈吐生风","pinyin":"tán tǔ shēng fēng","abbr":"ttsf","explanation":"谈话机敏风趣。","source":{"text":"则其人殊魁梧俊伟，谈吐生风。","book":"清·王韬《淞滨琐话·田荔裳》"},"similar":["谈吐风生"],"usage":"作谓语、定语；用于说话等"},{"id":41450,"word":"谈吐风声","pinyin":"tán tǔ fēng shēng","abbr":"ttfs","explanation":"形容谈话活跃而有趣。"},{"id":41451,"word":"谈吐风生","pinyin":"tán tǔ fēng shēng","abbr":"ttfs","explanation":"谈话机敏风趣。同“谈吐生风”。","source":{"text":"一呼一吸兴致豪，谈吐风生议论高。","book":"清·彭养鸥《黑籍冤魂》第21回"},"example":{"text":"丁玲《太阳照在桑乾河上》：“区上并不了解他，只觉得他～，学问渊博，对他非常客气，也就相信了他。”"},"similar":["谈吐生风"],"usage":"作谓语、定语；用于说话等"},{"id":41452,"word":"谈吐风雅","pinyin":"tán tǔ fēng yǎ","abbr":"ttfy","explanation":"风雅：风流儒雅。指有文化修养和生活风度。","example":{"text":"他是一个～的人。"},"usage":"作谓语、定语；指有文化修养"},{"id":41453,"word":"谈噱自若","pinyin":"tán jué zì ruò","abbr":"tjzr","explanation":"噱：大笑；自若：跟平常一样。指和平常一样有说有笑。形容态度自然。","source":{"text":"密贿永左右，俱得其欢心。甩晨起直登永床，与语，谈噱自若。","book":"明·焦竑《玉堂丛语·筹策》"},"similar":["谈笑自若","谈笑自如"],"usage":"作谓语、定语、状语；指态度自然"},{"id":41454,"word":"谈圆说通","pinyin":"tán yuán shuō tōng","abbr":"tyst","explanation":"论说权变之道。","source":{"text":"宁禀前哲之矩，硁硁为乡党自好，而不敢谈圆说通，自陷于无忌惮之中。","book":"明·高攀龙《答叶台山书》"},"usage":"作谓语、定语；用于书面语"},{"id":41455,"word":"谈天论地","pinyin":"tán tiān lùn dì","abbr":"ttld","explanation":"谈论天文地理。形容博学多识。","source":{"text":"说地谈天口若开，伏虎降龙志不改。","book":"元·郑德辉《王粲登楼》第二折"},"similar":["谈天说地"],"usage":"作谓语、定语；用于说话等"},{"id":41456,"word":"谈天说地","pinyin":"tán tiān shuō dì","abbr":"ttsd","explanation":"指随谈话机敏风趣","source":{"text":"说地谈天口若开，伏虎降龙志不改。","book":"元·郑德辉《王粲登楼》第二折"},"example":{"text":"钱青见那先生学问平常，故意～，讲古论今，惊得先生一字俱无。","book":"明·冯梦龙《醒世恒言》卷七"},"similar":["侃侃而谈","说地谈天"],"opposite":["缄口不言"],"usage":"作谓语、宾语、定语；形容人说话没有主题"},{"id":41457,"word":"谈情说爱","pinyin":"tán qíng shuō ài","abbr":"tqsa","explanation":"指谈恋爱。","source":{"text":"看人家一对对谈情说爱，好不眼红。","book":"钱钟书《围城》"},"example":{"text":"不要光顾～荒废了学业。"},"similar":["打情骂俏","调风弄月"],"usage":"作宾语、定语；用于男女之间"},{"id":41458,"word":"谈玄说妙","pinyin":"tán xuán shuō miào","abbr":"txsm","explanation":"谈论玄妙的事理。","source":{"text":"又有一种人思虑向里去，又嫌眼前道理粗，于事物上都不理会。此乃谈玄说妙之病。","book":"宋·朱熹《朱子语类》第16卷"},"example":{"text":"明·高攀龙《答叶台山书》：“宁守先儒之说，拘拘为寻行数墨，而不敢～，自陷于不知之妄作。”"},"usage":"作谓语、宾语、定语；用于说话"},{"id":41459,"word":"谈空说幻","pinyin":"tán kōng shuō huàn","abbr":"tksh","explanation":"指谈说佛理。","source":{"text":"兄数罹骨肉之变，乃嫂复中捐，何以自遣，谈空说幻，何足以解。","book":"明·赵南星《答周元孚书》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":41460,"word":"谈空说有","pinyin":"tán kōng shuō yǒu","abbr":"tksy","explanation":"泛指闲谈、空谈。","source":{"text":"龙丘居士亦可怜，谈空说有夜不眠。","book":"宋·苏轼《寄吴德仁兼简陈季常》诗"},"example":{"text":"～，与实际应用益相远。","book":"梁启超《中国学术思想变迁之大势》第七章第一节"},"similar":["谈天说地"],"usage":"作谓语；泛指闲谈、空谈"},{"id":41461,"word":"谈笑封侯","pinyin":"tán xiào fēng hóu","abbr":"txfh","explanation":"说笑之间就封了侯爵。旧时形容获得功名十分容易。","source":{"text":"闾阎听小子，谈笑觅封侯。","book":"唐·杜甫《复愁》诗"},"example":{"text":"自矜奇骨，必～。","book":"元·辛文房《唐才子传·张谓》"},"usage":"作谓语、定语；形容获得功名很容易"},{"id":41462,"word":"谈笑有鸿儒","pinyin":"tán xiào yǒu hóng rú","abbr":"txyhr","explanation":"鸿儒：大儒，有名的学者。与学问渊博的人在一起无拘无束地谈笑。指交游的人不同一般。","source":{"text":"谈笑有鸿儒，往来无白丁。","book":"唐·刘禹锡《陋室铭》"},"example":{"text":"清·李绿园《歧路灯》第38回：“今日～，正该叫小徒在此虚心聆教才是。”"},"usage":"作宾语、定语；用于交往等"},{"id":41463,"word":"谈笑而道","pinyin":"tán xiào ér dào","abbr":"txed","explanation":"有说有笑地讲述。形容讲述不相关切的事。","source":{"text":"有人于此，越人关弓而射之，则已谈笑而道之；无他，疏之也。","book":"《孟子·告子下》"}},{"id":41464,"word":"谈笑自如","pinyin":"tán xiào zì rú","abbr":"txzr","explanation":"和平常一样有说有笑。形容态度自然。","source":{"text":"契丹犯澶渊，急书日至，一夕凡五至，莱公不发封，谈笑自如。","book":"宋·陈师道《后山谈丛》卷一"},"example":{"text":"是日席上，唯裴玄与生举觞连饮，～，郑心如酒量虽宽，反觉蹴躇不安，而有惭色。","book":"《合浦珠》第四回"},"similar":["谈笑自若","谈噱自若"],"usage":"作谓语、定语、状语；指态度自然"},{"id":41465,"word":"谈笑自若","pinyin":"tán xiào zì ruò","abbr":"txzr","explanation":"自若：跟平常一样。指能平静地对待所发生的情况，说说笑笑，不改常态。","source":{"text":"融隐几读书，谈笑自若。","book":"《三国志·吴书·甘宁传》：“城中士众皆惧，惟宁谈笑自若。”《后汉书·孔融传》"},"example":{"text":"上面虽有倾盆大雨淋着，我们还是～，边走边谈，愈谈愈有味。","book":"邹韬奋《经历·初出茅庐》"},"similar":["谈笑风生","神色自若"],"opposite":["张皇失措"],"usage":"作谓语、定语、状语；指态度自然","story":["三国时期，孙权刘备在赤壁大败曹操，联军乘胜追击到南郡。吴将甘宁奉命占领夷陵，曹仁率五千兵马前来围困并不断向城里射箭，只有二千兵马的甘宁并不惧怕，仍然谈笑自若，命士兵收集曹军的箭，一面派人冲出重围去向周瑜报信求援"]},{"id":41466,"word":"谈笑风生","pinyin":"tán xiào fēng shēng","abbr":"txfs","explanation":"有说有笑，兴致高。形容谈话谈得高兴而有风趣。","source":{"text":"遐想后日蛾眉，两山横黛，谈笑风生颊。","book":"宋·辛弃疾《念奴娇·赠夏成玉》词"},"example":{"text":"他嘻嘻笑着，让酒让菜，～，又谈起他的山林生活。","book":"梁斌《播火记》十七"},"similar":["谈笑自若","谈古说今"],"opposite":["默默无语","相对无言"],"usage":"作谓语、定语；形容谈话谈得高兴而有风趣"},{"id":41467,"word":"谈经说法","pinyin":"tán jīng shuō fǎ","abbr":"tjsf","explanation":"讲说佛经佛法。","source":{"text":"对人前敲禅板谈经说法，背地里跳墙头恋酒贪花。","book":"元·无名氏《僧犯奸得马表背救》"}},{"id":41468,"word":"谈若悬河","pinyin":"tán ruò xuán hé","abbr":"trxh","explanation":"犹言口若悬河。形容能说会辨，说起来没个完。","source":{"text":"加以谈若悬河，识同藻鉴，车骑填门，履綦沓座，狎梵侣以玄深，结胜流而觞咏。","book":"《司勘集》"},"similar":["口若悬河"],"usage":"作谓语、宾语、定语；指口才很好"},{"id":41469,"word":"谈虎色变","pinyin":"tán hǔ sè biàn","abbr":"thsb","explanation":"色：脸色。原指被老虎咬过的人才真正知道虎的厉害。后比喻一提到自己害怕的事就情绪紧张起来。","source":{"text":"真知与常知异。尝见一田夫曾被虎伤，有人说虎伤人，众莫不惊，独田夫色动异于众。","book":"《二程全书·遗书二上》"},"example":{"text":"有光生长穷乡，～，安能默然而已。","book":"明·归有光《论三区赋役水利书》"},"similar":["闻风丧胆","心有余悸"],"opposite":["面不改色","谈笑自若"],"usage":"作谓语、定语、状语；指心有余悸","story":["北宋著名理学家程顥说：从前一个曾被老虎咬伤的农夫深知老虎的厉害，一次他听说老虎在外地咬伤了人，周围的人听了十分吃惊，而他则惊慌失色。因为他有被咬的亲身感受，研究学问的人要获得真知应该明白这个道理"]},{"id":41470,"word":"谈言微中","pinyin":"tán yán wēi zhòng","abbr":"tywz","explanation":"微中：微妙而又恰中要害。形容说话委婉而中肯。","source":{"text":"天道恢恢，岂不大哉！谈言微中，亦可以解纷。","book":"《史记·滑稽列传》"},"example":{"text":"范学台幕中查一个童生卷子，尊公说出何景明的一段话，真乃“～，名士风流。”","book":"清·吴敬梓《儒林外史》第十回"},"usage":"作谓语、定语；指说话隐微曲折而切中事理","story":["秦朝善于歌舞的小矮人优旎，他很会说笑话，他所说的笑话中包含着大道理，往往都是切中要害的精辟之言，深得秦始皇的信任。一次秦始皇想扩大御花园。优旎风趣地说可以多养鹿，用鹿角去顶撞敌人。秦始皇觉得想法不妥就打消这念头"]},{"id":41471,"word":"谈议风生","pinyin":"tán yì fēng shēng","abbr":"tyfs","explanation":"言谈议论活跃，有风趣。同“谈论风生”。"},{"id":41472,"word":"谈论风生","pinyin":"tán lùn fēng shēng","abbr":"tlfs","explanation":"风生：谈话时兴致很高，气氛活跃。形容谈话活跃而有趣。","source":{"text":"生素豪，谈论风生，孝儿亦倜傥。","book":"清·蒲松龄《聊斋志异·青凤》"},"example":{"text":"我们在一起～，十分投合。"},"similar":["谈笑风生","谈议风生"],"usage":"作谓语；指人健谈"},{"id":41473,"word":"谈辞如云","pinyin":"tán cí rú yún","abbr":"tcry","explanation":"指谈话时言辞如飘云那样奔涌而出。","source":{"text":"融幅巾奋裒，谈辞如云。","book":"南朝·宋·范晔《后汉书·符融传》"},"example":{"text":"符融～，让李膺十分佩服。"},"similar":["口若悬河"],"usage":"作谓语、定语；指人健谈","story":["东汉时期，为官清廉的李膺从青州刺史做到乌桓校尉、长乐少府等，他疾恶如仇，惩治贪官绝不手软，很多士大夫们想结识他，得到他的接纳就是登龙门。符融去拜见李膺，双方谈得十分投机，相见恨晚，谈辞如云，遂结为好友"]},{"id":41474,"word":"谈过其实","pinyin":"tán guò qí shí","abbr":"tgqs","explanation":"犹言言过其实。原指言语浮夸，超过实际才能。后也指话说得过分，超过了实际情况。","source":{"text":"尝谓谈过其实，辨而非真。","book":"唐·卢照邻《五悲·悲今日》"},"similar":["言过其实"],"usage":"作谓语、定语、宾语；指浮夸"},{"id":41475,"word":"谈霏玉屑","pinyin":"tán fēi yù xiè","abbr":"tfyx","explanation":"谈话时美好的言辞像玉的碎末纷纷洒落一样。形容言谈美妙，滔滔不绝。","source":{"text":"谈霏玉屑惊人听，歌和阳春满坐谣。","book":"宋·欧阳澈《显道辞中以诗示教因和韵复之》诗"},"example":{"text":"清·金埴《不下带编》第一卷：“家遇佳客诣门，必延入斋中，～，多及宵深。”"},"usage":"作谓语、定语；用于书面语"},{"id":41476,"word":"谊不容辞","pinyin":"yì bù róng cí","abbr":"ybrc","explanation":"犹言义不容辞。道义上不允许推辞。","source":{"text":"予与光世处三十年矣，谊不容辞，故为序如此。","book":"明·杨荣《送陈司业诗序》"},"example":{"text":"这一篇，是Ｔ先生要我做的，因为那集子要在和他有关系的Ｇ书局出版。我～，只得写了这一点。","book":"鲁迅《南腔北调集·〈守常全集〉题记》"},"similar":["谊不敢辞","义不容辞"],"usage":"作谓语、定语、状语；指应该如此"},{"id":41477,"word":"谊不敢辞","pinyin":"yì bù gǎn cí","abbr":"ybgc","explanation":"犹言义不容辞。道义上不允许推辞。","source":{"text":"曾蒙令祖先生知己之爱，谊不敢辞，已具一稿，藏之箧中。","book":"清·顾炎武《答陈亮工书》"},"similar":["谊不容辞","义不容辞"],"usage":"作谓语、定语、状语；指应该如此"},{"id":41478,"word":"谊切苔岑","pinyin":"yì qiè tái cén","abbr":"yqtc","explanation":"切：亲近；苔岑：志同道合的朋友。形容志同道合，感情深厚。","source":{"text":"人亦有言，松竹有林，及余臭味，异苔同岑。","book":"晋·郭璞《赠温峤》诗"},"usage":"作谓语、定语；指朋友"},{"id":41479,"word":"谋为不轨","pinyin":"móu wéi bù guǐ","abbr":"mwbg","explanation":"指准备做违反法纪的事或搞叛乱活动。","source":{"text":"适得阳平表曰：穆泰谋为不轨，招诱宗室。","book":"《魏书·任城王澄传》"},"example":{"text":"这并非为了消灭‘～’的痕迹，不过以为因通信而累及别人，是很无谓的。","book":"鲁迅《序言》"},"similar":["谋图不轨"],"usage":"作谓语、定语；指谋划做叛逆违法的事"},{"id":41480,"word":"谋事在人","pinyin":"móu shì zài rén","abbr":"mszr","explanation":"谋：谋划，安排。根据个人的能力策划事情。","source":{"text":"孔明叹曰：‘谋事在人，成事在天，不可强也！’","book":"明·罗贯中《三国演义》"},"example":{"text":"不过剩下的五百万就没有把握。～，成事在天！","book":"茅盾《子夜》"},"similar":["事在人为"],"opposite":["听天由命"],"usage":"作分句、定语；常与“成事在天”连用"},{"id":41481,"word":"谋事在人，成事在天","pinyin":"móu shì zài rén，chéng shì zài tiān","abbr":"mszrcszt","explanation":"旧谚。意思是自己已经尽力而为，至于能否达到目的，那就要看时运如何了。","source":{"text":"孔明叹曰：‘谋事在人，成事在天，不可强也！’","book":"明·罗贯中《三国演义》第103回"},"example":{"text":"不过剩下的五百万就没有把握。～！","book":"茅盾《子夜》"},"usage":"作分句；可分开使用"},{"id":41482,"word":"谋先则事昌","pinyin":"móu xiān zé shì chāng","abbr":"mxzsc","explanation":"谋计划、计谋；昌：兴盛。事前做好计划，事情就容易成功兴盛。","source":{"text":"谋先事则昌，事先谋则亡。","book":"汉·刘向《说苑·丛谈》"}},{"id":41483,"word":"谋及妇人","pinyin":"móu jí fù rén","abbr":"mjfr","explanation":"谋：计议，商量。指机密大事与不明大义的妇女商量，因而遭致失败。","source":{"text":"公载以出，曰：‘谋及妇人，宜其死也。’","book":"《左传·桓公十五年》"},"example":{"text":"看君举措，并非欲～，不过欲得我财物呢。","book":"蔡东藩《两晋演义》第九十回"}},{"id":41484,"word":"谋及庶人","pinyin":"móu jí shù rén","abbr":"mjsr","explanation":"谋：计谋，商议；庶人：百姓。与老百姓商量国家大事。比喻广泛征求意见。","source":{"text":"女则有大疑，谋及女心，谋及卿士，谋及庶人，谋及卜筮。","book":"《尚书·洪范》"},"example":{"text":"昔在希腊罗马之初政，凡百设施，～。","book":"清·梁启超《论自由》"},"usage":"作谓语、定语；指广泛征求意见"},{"id":41485,"word":"谋听计行","pinyin":"móu tīng jì xíng","abbr":"mtjx","explanation":"犹言言听计从。形容对某人十分信任。","source":{"text":"然后天下之君，下堂去席，引手倒耳，以倾就其说而谋听计行。","book":"宋·王令《读》"},"similar":["言听计从"],"usage":"作谓语、定语；同“言听计从”"},{"id":41486,"word":"谋图不轨","pinyin":"móu tú bù guǐ","abbr":"mtbg","explanation":"图谋：暗中策划；不轨：越出常轨，不守法度。谋划越出常规、法度之事。","source":{"text":"安帝乳母王圣与中常侍江京等谮邓骘兄弟及翼，云与中大夫赵王谋图不轨，窥觎神器，怀大逆心。","book":"《后汉书·章帝八王列传》"},"example":{"text":"一道诏书，接连颁下，说玮擅杀二公父子，又欲诛灭朝臣，～，罪大恶极，应速正大典。","book":"蔡东藩《两晋演义》第九回"},"similar":["谋逆不轨","谋为不轨"],"usage":"作谓语、定语、宾语；指篡位"},{"id":41487,"word":"谋夫孔多","pinyin":"móu fū kǒng duō","abbr":"mfkd","explanation":"指谋划的人很多。孔，很。","source":{"text":"谋夫孔多，是用不集。","book":"《诗·小雅·小旻》"},"example":{"text":"这个差使本是丁忧后委的，现在就是续丁，谅亦无改委之理。但是～，还要求在抚台面前保举点的话。","book":"《糊涂世界》卷二"},"similar":["谋臣如雨"],"usage":"作谓语、定语；指贤士很多"},{"id":41488,"word":"谋如泉涌","pinyin":"móu rú quán yǒng","abbr":"mrqy","explanation":"谋略像奔涌的泉水一样多。","source":{"text":"援奉诏西使，镇慰边众，乃诏集豪杰，晓诱羌戎，谋如泉涌，势如转规。","book":"《后汉书·马援传》"}},{"id":41489,"word":"谋如涌泉","pinyin":"móu rú yǒng quán","abbr":"mryq","explanation":"谋略像奔涌的泉水一样多。","source":{"text":"乃招集豪杰，晓诱羌戎，谋如涌泉，势如转规。","book":"南朝·宋·范晔《后汉书·马援传》"},"usage":"作谓语、定语；指人的计谋多"},{"id":41490,"word":"谋定后战","pinyin":"móu dìng hòu zhàn","abbr":"mdhz","explanation":"谋：计谋，策略。用兵打仗时，要先定好计谋然后再行动。","source":{"text":"光弼用兵，谋定而后战，能以少覆战。","book":"《唐书·李光弼传》"},"example":{"text":"统是～，以少胜多。","book":"蔡东藩《两晋演义》第七十八回"}},{"id":41491,"word":"谋无遗策","pinyin":"móu wéi yí cè","abbr":"mwyc","explanation":"计谋没有遗漏的地方。形容计谋周密稳妥。","source":{"text":"蜀之豪帅，面缚归命，谋无遗策，举无废功。","book":"三国·魏·曹奂《以钟会为司徒诏》"},"example":{"text":"自顷以来，君谋无遗策，张、陈复何以过之。","book":"《晋书·王廙传》"},"similar":["谋无遗谞","算无遗策"],"usage":"作谓语、定语；指非常准确"},{"id":41492,"word":"谋无遗谞","pinyin":"móu wú yí ér","abbr":"mwyx","explanation":"遗谞：才智不足之处。所设计谋没有不足之处。形容计谋周密，十分稳妥。","source":{"text":"骆统、刘基强谏以补过，谋无遗谞，举不失策。","book":"晋·陆机《辩士论》"},"similar":["谋无遗策"],"usage":"作谓语、定语；指非常准确"},{"id":41493,"word":"谋而后动","pinyin":"móu ér hòu dòng","abbr":"mehd","explanation":"做事要先订好计划然后再行动。","source":{"text":"珍其货而后市，修其身而后交，善其谋而后动成道也。","book":"汉·扬雄《法言义疏》卷三"},"example":{"text":"苞苴所入实行张霍之家，～，毫芒寡忒，是曰量交，其流五也。","book":"南朝·梁·刘峻《广绝交论》"}},{"id":41494,"word":"谋臣似雨，猛将如云","pinyin":"móu chén sì yǔ，měng jiàng rú yún","abbr":"mcsymjry","explanation":"形容谋士武将非常多，人才济济。","source":{"text":"当此之时，猛将如云，谋臣如雨，然犹七日不食仅乃得免。","book":"汉·李陵《答苏武书》"},"example":{"text":"然则便因你说的他那猛将如云，谋臣似雨，觉得我动不得他？","book":"清·文康《儿女英雄传》第十八回"}},{"id":41495,"word":"谋臣如雨","pinyin":"móu chén rú yǔ","abbr":"mcry","explanation":"形容智谋之士极多。","source":{"text":"当此之时，猛将如云，谋臣如雨，然犹七日不食仅乃得免。","book":"西汉·李陵《答苏武书》"},"example":{"text":"南岳会议是在十一月尾上召开的，我只是在闭幕的一天赶去参加了一次，依然是猛将如云，～的场面。","book":"郭沫若《洪波曲》第16章"},"similar":["谋夫孔多"],"usage":"作谓语、定语；指贤士很多"},{"id":41496,"word":"谋臣武将","pinyin":"móu chén wǔ jiàng","abbr":"mcwj","explanation":"指有计谋的大臣和勇猛的战将。","source":{"text":"尔其则有谋臣武将，皆能攫戾执猛，破坚摧刚。","book":"汉·张衡《南都赋》"},"example":{"text":"今曹操拥兵二十余万，～数十员，若得此人扶持社稷，剿除奸党，天下幸甚。","book":"明·罗贯中《三国演义》第十三回"},"similar":["谋臣猛将"],"usage":"作主语、宾语；指得力助手"},{"id":41497,"word":"谋臣猛将","pinyin":"móu chén měng jiāng","abbr":"mcmj","explanation":"善于谋划的文臣和勇猛善战的将帅。","source":{"text":"尔其则有谋臣武将，皆能攫戾执猛，破坚摧刚。","book":"汉·张衡《南都赋》"},"example":{"text":"方元昊强时，～尽其智力，十年而敢近。","book":"宋·苏轼《代滕甫论西夏书》"},"similar":["谋臣武将"],"usage":"作主语、宾语、定语；指得力干将"},{"id":41498,"word":"谋莫难于周密","pinyin":"móu mò nán yú zhōu mì","abbr":"mmnyzm","explanation":"计谋最难得的在于周到严密。","source":{"text":"谋莫难于周密，说莫难于悉听，事莫难于必成。","book":"《鬼谷子·摩篇》"},"usage":"作宾语、定语；用于书面语"},{"id":41499,"word":"谋虑深远","pinyin":"móu lǜ shēn yuǎn","abbr":"mlsy","explanation":"考虑谋划深远的问题。","source":{"text":"光禄勋庆忌行义所正，柔毅敦厚，谋虑深远。","book":"《汉书·辛庆忌传》"},"example":{"text":"皇上胸富韬略，～，步步有法，臣妾望尘莫及。","book":"姚雪垠《李自成》第二卷第十九章"},"similar":["深谋远虑"],"usage":"作谓语、定语；指人考虑长远"},{"id":41500,"word":"谋虚逐妄","pinyin":"móu xū zhú wàng","abbr":"mxzw","explanation":"谋：谋求；虚：不真实；逐：追逐；妄：不存在。追求一种不存在或不合理的事物。","source":{"text":"不但是洗旧翻新，却也省了些寿命筋力，不更去谋虚逐妄了。","book":"清·曹雪芹《红楼梦》第一回"}},{"id":41501,"word":"谋谟帷幄","pinyin":"móu mó wéi wò","abbr":"mmww","explanation":"犹言运筹帷幄。指拟定作战策略。引申为筹划、指挥。","source":{"text":"制诏前将军禹，深执忠孝，与朕谋谟帷幄，决胜千里。","book":"《后汉书·邓禹传》"},"example":{"text":"景王薨于许昌，文王总统六军，会～。","book":"《三国志·魏志·钟会传》"},"usage":"作谓语、定语；用于书面语"},{"id":41502,"word":"谋财害命","pinyin":"móu cái hài mìng","abbr":"mchm","explanation":"为了劫夺财物，害人性命。","source":{"text":"你如今将俺主人摆布死了，故意将这绣鞋揣在怀里，正是你图财致命，便待干罢。","book":"元·曾瑞卿《留鞋记》第二折"},"example":{"text":"血池狱、阿鼻狱、秤杆狱，脱皮露骨，折臂断筋，也只为～，宰畜屠生。","book":"明·吴承恩《西游记》第十一回"},"similar":["打家劫舍"],"opposite":["仗义疏财"],"usage":"作谓语、定语、宾语；指为财杀人"},{"id":41503,"word":"谋逆不轨","pinyin":"móu nì bù guǐ","abbr":"mnbg","explanation":"谋：图谋；逆：违背；不轨：不合法。图谋进行违法叛逆活动。","source":{"text":"汝窃据太原，称孤道寡，偷生一隅，亦已足矣，奈何谋逆不轨。","book":"《杨家将演义》第二回"},"similar":["谋图不轨","谋为不轨"],"usage":"作谓语、定语、宾语；指篡位"},{"id":41504,"word":"谋道作舍","pinyin":"móu dào zuò shě","abbr":"mdzs","explanation":"造房子请教路人。比喻人多嘴杂，意见纷纷，办不成事。","source":{"text":"谋道作舍，三年弗架。","book":"宋·宋祁《杂说》"},"similar":["筑室道谋"],"usage":"作宾语、定语；用于人的处世"},{"id":41505,"word":"谏争如流","pinyin":"jiàn zhēng rú liú","abbr":"jzrl","explanation":"谏争：争同“诤”，直言相劝。劝谏的话如同流水一样，滔滔不绝。","source":{"text":"从父令是何由，从君令是何由，冒斧当戈，谏争如流。","book":"明·无名氏《东篱赏菊》第二折"},"usage":"作谓语、宾语；指经常劝告"},{"id":41506,"word":"谏尸谤屠","pinyin":"jiàn shī bàng tú","abbr":"jsbt","explanation":"向尸体劝谏，向屠伯指责杀牲的过失。比喻劝谏无济于事。","source":{"text":"幽祸挐以夸，惮褒以渔。淫嗜筏杀，谏尸谤屠。","book":"唐·柳宗元《天对》"},"usage":"作谓语、定语；指做事无济于事"},{"id":41507,"word":"谏鼓谤木","pinyin":"jiàn gǔ bàng mù","abbr":"jgbm","explanation":"谏鼓：相传尧曾在庭中设鼓，让百姓击鼓进谏；谤木：相传舜在交通要道立木牌，让百姓在上面写谏言。指广开言路，听取各方意见。","source":{"text":"臣闻尧舜之时，谏鼓谤木，立之于朝。","book":"《淮南子·主术训》：“故尧置敢谏之鼓，舜立诽谤之木。”《后汉书·杨震传》"},"example":{"text":"臣闻尧舜之世，～，立之于朝；殷周哲王，小人怨詈，则还自敬德。","book":"蔡东藩《后汉演义》第四十二回"}},{"id":41508,"word":"谑浪笑傲","pinyin":"xuè làng xiào ào","abbr":"xlxa","explanation":"形容戏谑笑闹。","source":{"text":"谑浪笑敖，中心是悼。","book":"《诗经·邶风·终风》"},"example":{"text":"钱钟书《围城》：“今天是几个熟人吃便饭，并且有女人，他当然～，另有适应。”"},"similar":["谑浪笑敖"],"usage":"作谓语、定语；用于书面语"},{"id":41509,"word":"谑浪笑敖","pinyin":"xuè làng xiào áo","abbr":"xlxa","explanation":"形容戏谑笑闹。","source":{"text":"谑浪笑敖，中心是悼。","book":"《诗经·邶风·终风》"},"similar":["谑浪笑傲"],"usage":"作谓语、定语；用于书面语"},{"id":41510,"word":"谑笑科诨","pinyin":"xuè xiào kē wù","abbr":"xxkh","explanation":"谑笑：滑稽可笑；诨：诙谐逗趣的话。指情节滑稽引人发笑的喜剧动作。","source":{"text":"凤姐虽有邢王二夫人在前，但因贾母之命，不敢违拗，且知贾母喜热闹更喜谑笑科诨，便先点了一出，却是《刘二当衣》。","book":"清·曹雪芹《红楼梦》第二十二回"},"similar":["插科打诨"],"usage":"作宾语、定语；用于书面语"},{"id":41511,"word":"谑而不虐","pinyin":"xuè ér bù nüè","abbr":"xebn","explanation":"谑：开玩笑。开玩笑而不使人难堪。","source":{"text":"善戏谑兮，不为虐矣。","book":"《诗经·卫风·淇奥》"},"opposite":["谑近于虐"],"usage":"作谓语、定语；指人幽默"},{"id":41512,"word":"谑而虐","pinyin":"xuè ér nüè","abbr":"xen","explanation":"开玩笑很尖刻。","source":{"text":"当其时，内府之权皆归堂郎中，各堂端拱无为而已。有嘲之曰：‘嵩不知，巴不管，胡涂堂官填不满……’可谓谑而虐矣。","book":"清·崇彝《道咸以来朝野杂记》"},"example":{"text":"这等说话，也算善于劝谏的了，无奈李纯生长山水之间，久执樵渔之业，～。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十一回"},"similar":["谑而近虐","谑近于虐"],"usage":"作宾语、定语；用于书面语"},{"id":41513,"word":"谑而近虐","pinyin":"xuè ér jìn nüè","abbr":"xejn","explanation":"开玩笑近乎伤害人。","source":{"text":"其言谑而近虐，宜林之怫然不悦也。","book":"《世说新语笺疏》卷下"},"example":{"text":"这等议论，谑而近虐，有识者不值一笑，迷信者奉为圭臬。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十三回"},"similar":["谑而虐","谑近于虐"],"usage":"作宾语、定语；用于书面语"},{"id":41514,"word":"谑近于虐","pinyin":"xuè jìn yú nüè","abbr":"xjyn","explanation":"开玩笑近于伤害人。","source":{"text":"这番譬喻虽谑近于虐，却非深知此中甘苦者道不出来。","book":"清·文康《儿女英雄传》第三十五回"},"similar":["谑而虐","谑而近虐"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":41515,"word":"谓予不信","pinyin":"wèi yú bù xìn","abbr":"wybx","explanation":"如果以为我的话不真实。","source":{"text":"谓予不信，有如日。","book":"《诗经·王风·采葛》"}},{"id":41516,"word":"谔谔以昌","pinyin":"è è yǐ chāng","abbr":"eeyc","explanation":"谔谔：直言争辩的样子。群臣勇于直言争辩，国家就会兴盛。","source":{"text":"竿人之诺诺，不如一士之谔谔。武王谔谔以昌，殷纣墨墨以亡。","book":"《史记·商君列传》"},"opposite":["墨墨以亡"],"usage":"作宾语、定语；用于书面语"},{"id":41517,"word":"谗佞之徒","pinyin":"chán nìng zhī tú","abbr":"cnzt","explanation":"指说人坏话与用花言巧语谄媚的人。","source":{"text":"谁想这伙官员，贪滥无厌，徇私作弊，克减酒肉。都是那等谗佞之徒，贪爱贿赂的人。","book":"明·施耐庵《水浒传》第83回"},"usage":"作主语、宾语；用于书面语"},{"id":41518,"word":"谗口嗷嗷","pinyin":"chán kǒu áo áo","abbr":"ckaa","explanation":"谗：讲别人的坏话；嗷嗷：形容七嘴八舌地诽谤人。形容众人以谗言诋毁人。","source":{"text":"无罪无辜，谗口嗷嗷。","book":"《诗经·小雅·十月之交》：“黾勉从事，不敢告劳。无罪无辜，谗口嚣嚣。”《汉书·刘向传》"},"similar":["谗口嚣嚣"],"usage":"作谓语；指毁谤别人"},{"id":41519,"word":"谗口嚣嚣","pinyin":"chán kǒu xiāo xiāo","abbr":"ckxx","explanation":"嚣嚣：喧闹的样子。指讲坏话的人到处喧闹。","source":{"text":"黾勉从事，不敢告劳。无罪无辜，谗口嚣嚣。","book":"《诗经·小雅·十月之交》"},"similar":["谗口嗷嗷"],"usage":"作定语、状语；用于众口谗毁别人"},{"id":41520,"word":"谗口铄金","pinyin":"chán kǒu shuò jīn","abbr":"cksj","explanation":"谗言足以熔化金石。极言谗言毁贤害能之厉害。","source":{"text":"丁亥，谗口铄金，太行千盘，横起人面。","book":"清·冒襄《影梅庵忆语》"},"similar":["众口铄金"],"usage":"作谓语、定语；用于谎言等"},{"id":41521,"word":"谗慝之口","pinyin":"chán tè zhī kǒu","abbr":"ctzk","explanation":"专进谗言的恶人的嘴。","source":{"text":"愿以间执谗慝之口。","book":"《左传·僖公二十八年》"},"example":{"text":"乐羊既反，谤书盈箧，况臣顽疏，能免～。","book":"《晋书·王濬传》"},"usage":"作宾语；用于说坏话的人"},{"id":41522,"word":"谗言佞语","pinyin":"chán yán nìng yǔ","abbr":"cyny","explanation":"中伤他人和奉承讨好的话语。","source":{"text":"一个李存信，两头蛇谗言佞语。","book":"元·关汉卿《哭存孝》第三折"},"example":{"text":"怨着大金主上，信～，杀害我忠良。","book":"元·施惠《幽闺记·文武同盟》"},"opposite":["好言好语"],"usage":"作主语、宾语、定语；指说别人坏话去讨好人"},{"id":41523,"word":"谘师访友","pinyin":"zī shī fǎng yǒu","abbr":"zsfy","explanation":"谘：询问，商量。请教老师，问询朋友。","source":{"text":"他日斋静，行来出入得通，更不必斋时，宜谘师访友，思而行之。","book":"宋·张君房《云笈七签》卷四十"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":41524,"word":"谘经诹史","pinyin":"zī jīng zōu shǐ","abbr":"zjzs","explanation":"指商讨、研究经史。","source":{"text":"至则解衣盘薄，谘经诹史，旁若无人。","book":"清·方苞《送王篛林南归序》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":41525,"word":"谛分审布","pinyin":"dì fēn shěn bù","abbr":"dfsb","explanation":"仔细察看分布状况。","source":{"text":"奕者之斗棋也，谛分审布，失其守者逐而攻之。","book":"宋·秦观《奇兵》"},"usage":"作谓语；指仔细察看"},{"id":41526,"word":"谠言嘉论","pinyin":"dǎng yán jiā lùn","abbr":"dyjl","explanation":"公正、正直而有说服力的言论。","source":{"text":"孔孙素以文学名，且善琴，工画山水竹石，而骑射尤精，及其立朝，谠言嘉论，有可观者，士论服之。","book":"《元史·张孔孙传》"},"similar":["谠言直声"],"usage":"作宾语、定语；用于文章或说话等"},{"id":41527,"word":"谠言直声","pinyin":"dǎng yán zhí shēng","abbr":"dyzs","explanation":"谠言：公正的言论；直：正直的。公正的、正直的、理直气壮的言论。","source":{"text":"（元稹）由校书郎拜左拾遗，不数月，谠言直声动于朝廷。","book":"唐·白居易《唐河南元府君夫人墓志铭序》"},"similar":["谠言嘉论"],"usage":"作宾语、定语；指直言"},{"id":41528,"word":"谠论侃侃","pinyin":"dǎng lùn kǎn kǎn","abbr":"dlkk","explanation":"谠论：公正、正直的言论。对上敢于直言，谈论理直气壮，从容不迫。","source":{"text":"往往谏列，谠论侃侃；屡触权要，卒就贬窜。","book":"宋·苏舜钦《祭滕子京文》"},"usage":"作谓语；用于书面语"},{"id":41529,"word":"谠论危言","pinyin":"dǎng lùn wēi yán","abbr":"dlwy","explanation":"公正的议论，无畏的直言。","source":{"text":"谠论危言望素隆，独于声利性偏慵。","book":"宋·曾巩《和酬赵宫保致政言怀》诗"}},{"id":41530,"word":"谢兰燕桂","pinyin":"xiè lán yàn guì","abbr":"xlyg","explanation":"比喻能光耀门庭的子侄辈。","source":{"text":"谢兰，系“谢庭兰玉”之省称；燕桂，《宋史·窦仪传》载：“仪学问优博，风度峻整。弟俨、侃、偁、僖，皆相继登科。冯道与禹钧（窦仪父）有旧，尝赠诗，有‘灵椿一株老，丹桂五枝芳’之句，缙绅多讽诵之。”时称窦氏兄弟为燕山五龙。"},"similar":["谢庭兰玉"],"usage":"作宾语、定语；用于比喻句","story":["南朝宋时期，窦仪学问优博，风度峻整。他的兄弟俨、侃、偁、僖都相继榜上有名。冯道与窦仪的父亲窦禹钧关系要好，就送他“灵椿一株老，丹桂五枝芳”诗句，当时人们羡慕地称赞他们五兄弟为“燕山五龙”或比喻为“谢兰燕桂”"]},{"id":41531,"word":"谢天谢地","pinyin":"xiè tiān xiè dì","abbr":"xtxd","explanation":"表示目的达到或困难解除后满意轻松的心情。","source":{"text":"祖孙空切陈情表，母子遥悬陟屺怀，到如今谢天谢地全恩爱。","book":"明·冯惟敏《正官端正好·徐我亭归田》"},"example":{"text":"～，这件事总算办成了。"},"similar":["心满意足","称心如意"],"opposite":["怨声载道"],"usage":"作谓语、分句；用于感叹"},{"id":41532,"word":"谢家宝树","pinyin":"xiè jiā bǎo shù","abbr":"xjbs","explanation":"比喻能光耀门庭的子侄。","source":{"text":"非谢家之宝树，接孟氏之芳邻。","book":"唐·王勃《滕王阁序》"},"example":{"text":"若得～向此间栽，却不是累世簪缨百福来。","book":"明·冯梦龙《双雄记·赏荷造谋》"},"similar":["谢庭玉兰"],"usage":"作宾语、定语；用于比喻句"},{"id":41533,"word":"谢家活计","pinyin":"xiè jiā huó jì","abbr":"xjhj","explanation":"喻指赋诗。","source":{"text":"南朝宋诗人谢灵运与从弟谢惠连俱以诗文着称，见《宋书·谢惠连传》。"},"usage":"作主语、宾语、定语；用于书面语","story":["南屏僧净慈在明中讲经，听众如云。他善于诗画，画笔雅近井西老人，他的五言诗做得很好，人们称不愧为高人吐属。他在58岁圆寂前自做偈诗：“五十八年一报周，谢家活计霎时收。披蓑赤脚千峰去，不问芦塘旧钓舟。”"]},{"id":41534,"word":"谢庭兰玉","pinyin":"xiè tíng lán yù","abbr":"xtly","explanation":"比喻能光耀门庭的子侄。","source":{"text":"谢太傅问诸子侄曰：‘子弟何预人事，而政欲使其佳？’诸人莫有言者，车骑答曰：‘譬如芝兰玉树，欲使生于阶庭耳。’","book":"晋·裴启《语林》"},"example":{"text":"汉节从来纵真赏，～载芳音。","book":"宋·曾巩《庭桧呈蒋颖叔》"},"similar":["芝兰玉树"],"usage":"作宾语；指夸奖别人的小孩"},{"id":41535,"word":"谢馆秦楼","pinyin":"xiè guǎn qín lóu","abbr":"xgql","explanation":"指妓院。","source":{"text":"茶余饭饱邀故友，谢馆秦楼，散闷消愁。","book":"元·关汉卿《斗鹌鹑·女校尉》曲"},"example":{"text":"明·兰陵笑笑生《金瓶梅词话》第46回：“你在～，倚翠偎红，色胆天来大。”"},"similar":["楚馆秦楼"],"usage":"作宾语、定语；指妓院"},{"id":41536,"word":"谣诼诬谤","pinyin":"yáo zhuó wū bàng","abbr":"yzwb","explanation":"凭空捏造事实，对人加以诬陷和毁谤。","source":{"text":"谣诼谓余以善淫。","book":"战国·楚·屈原《离骚》"},"example":{"text":"记得提倡白话那时，受了许多～，而白话终于没有跌倒的时候。","book":"鲁迅《华盖集序编·古书与白话》"}},{"id":41537,"word":"谤书一箧","pinyin":"bàng shū yī qiè","abbr":"bsyq","explanation":"谤书：毁谤别人的文书；箧：箱子。比喻私下对人攻击。","source":{"text":"魏文侯令乐羊将攻中山，三年而拔之。乐羊反而语功，文侯示之谤书一箧。乐羊再拜稽首曰：‘此非臣之功，主君之力也。’","book":"《战国策·秦策三》"}},{"id":41538,"word":"谦以下士","pinyin":"qiān yǐ xià shì","abbr":"qyxs","explanation":"下：屈己尊人。指谦虚恭敬地对待地位比自己低的人。","source":{"text":"少好学，修父业，尤谦逊下士。","book":"《汉书·韦玄成传》"},"example":{"text":"白不知君侯何以得此声于天壤之间，岂不由重诺好贤、～得也?","book":"唐·李白《上安州裴长史书》"},"similar":["谦逊下士"],"usage":"作谓语、定语；指态度谦虚"},{"id":41539,"word":"谦光自抑","pinyin":"qiān guāng zì yì","abbr":"qgzy","explanation":"谦光：谦虚退让的风度。比喻德高望重的人能够谦虚退让。","source":{"text":"谦光自抑，厥辉愈扬。","book":"《周易·谦》：“谦尊而光。”晋·陆云《赠顾尚书》"}},{"id":41540,"word":"谦冲自牧","pinyin":"qiān chōng zì mù","abbr":"qczm","explanation":"谦冲：谦虚；自牧：自我修养，克制。比喻谦虚谨慎，自我克制。","source":{"text":"念高危，则思谦冲而自牧；惧满溢，则思江海下百川。","book":"唐·魏征《谏太宗十思疏》"},"example":{"text":"如今听他说了这一番话，真是～，不槐有道之言。","book":"梁羽生《冰川天女传》第二十三回"}},{"id":41541,"word":"谦卑自牧","pinyin":"qiān bēi zì mù","abbr":"qbzm","explanation":"谦卑：谦虚；牧：养。谦虚谨慎，修身养性。","source":{"text":"谦谦君子，卑以自牧。","book":"《周易·谦》"},"example":{"text":"惟让～，简默寡言。","book":"明·焦竑《玉堂丛书》第三卷"},"usage":"作谓语、宾语、定语；用于养性"},{"id":41542,"word":"谦受益，满招损","pinyin":"qiān shòu yì，mǎn zhāo sǔn","abbr":"qsymzs","explanation":"谦：谦逊，虚心；受：得到；益：好处；满：自满，骄傲；招：招惹；损：损害。自满会招致损失，谦虚可以得到好处。","source":{"text":"谦受益，满招损。","book":"明·沈采《千金记·延访》"},"similar":["满招损，谦受益","虚受益，满招损"],"usage":"作定语、宾语、分句；用于劝诫人"},{"id":41543,"word":"谦尊而光","pinyin":"qiān zūn ér guāng","abbr":"qzeg","explanation":"尊者谦虚而显示其美德。","source":{"text":"谦，尊而光，卑而不可逾。","book":"《周易·谦》"},"example":{"text":"公子原是说自己不通庶务，不想惹得老人家也‘～’起来。","book":"清·文康《儿女英雄传》第33回"},"usage":"作谓语；用于教人谦虚"},{"id":41544,"word":"谦恭下士","pinyin":"qiān gōng xià shì","abbr":"qgxs","explanation":"旧时指达官贵人对地位不高但有才德的人谦虚而有礼貌。","source":{"text":"少好学，修父业，尤谦逊下士。","book":"《汉书·韦玄成传》"},"example":{"text":"他亲自送至车旁，亲自代关车门，行一深鞠躬礼而别，颇能～。","book":"邹韬奋《患难余生记·流亡》"},"similar":["谦躬下士"],"usage":"作谓语、定语；指态度谦虚"},{"id":41545,"word":"谦恭仁厚","pinyin":"qiān gōng rén hòu","abbr":"qgrh","explanation":"指态度谦逊恭谨，为人忠诚老实。","source":{"text":"今日见宋江谦恭仁厚，愈加钦敬。","book":"明·施耐庵《水浒传》第98回"},"usage":"作谓语、定语；用于为人"},{"id":41546,"word":"谦恭虚己","pinyin":"qiān gōng xū jǐ","abbr":"qgxj","explanation":"虚己：谦虚，虚心。谦虚恭敬地听取别人的意见。","source":{"text":"就是待那同僚，却也谦恭虚己，百凡从事。","book":"明·冯梦龙《醒世恒言》第26卷"},"usage":"作谓语、定语；用于对人的态度"},{"id":41547,"word":"谦虚敬慎","pinyin":"qiān xū jìng shèn","abbr":"qxjs","explanation":"形容人虚心礼让，小心谨慎。同“谦虚谨慎”。","source":{"text":"封濮阳侯，任遇优显，衣冠当时，而谦虚敬慎，开襟下士。","book":"《晋书·张宾载记》"},"similar":["谦虚谨慎"],"usage":"作谓语、定语；指人虚心"},{"id":41548,"word":"谦虚谨慎","pinyin":"qiān xū jǐn shèn","abbr":"qxjs","explanation":"形容人虚心礼让，小心谨慎。","source":{"text":"封濮阳侯，任遇优显，宠冠当时，而谦虚敬慎，开襟下士。","book":"《晋书·张宾载记》"},"example":{"text":"务必使同志们继续保持～、不骄不躁的作风。","book":"毛泽东《在中国共产党第七届中央委员会议上的报告》"},"similar":["谦恭虚己"],"opposite":["狂妄自大","骄傲自满"],"usage":"作谓语、定语；指人虚心"},{"id":41549,"word":"谦让未遑","pinyin":"qiān ràng wèi huáng","abbr":"qrwh","explanation":"遑：闲暇。谦让都来不及。指不好意思接受别人的推崇。","source":{"text":"谊以为汉兴二十余年，天下和洽，宜当改正朔，易服色制度，定官名，兴礼乐。乃草具其仪法，色上黄，数用五，为官名悉更，奏之。文帝谦让未皇（遑）也。","book":"《汉书·贾谊传》"},"example":{"text":"《汉书·贾谊传》：“谊以为汉兴二十余年，天下和洽，宜当改正朔，易服色制度，定官名，兴礼乐。乃草具其仪法，色上黄，数用五，为官名悉更，奏之。文帝谦让未皇（遑）也。”"},"usage":"作谓语；用于书面语"},{"id":41550,"word":"谦谦下士","pinyin":"qiān qiān xià shì","abbr":"qqxs","explanation":"下：屈己尊人。指谦虚恭敬地对待地位比自己低的人。","source":{"text":"少好学，修父业，尤谦逊下士。","book":"《汉书·韦玄成传》"},"example":{"text":"纵是当朝元宰，也须要～为嘉。","book":"明·叶宪祖《鸾鎞记·挫权》"},"similar":["谦躬下士"],"usage":"作谓语、定语；指态度谦虚"},{"id":41551,"word":"谦谦君子","pinyin":"qiān qiān jūn zǐ","abbr":"qqjz","explanation":"指谦虚而严格要求自己的人。","source":{"text":"谦谦君子，卑以自牧也。","book":"《易·谦》"},"example":{"text":"俺这等～，须不比泛泛庸徒。","book":"元·无名氏《渔樵记》第一折"},"usage":"作主语、宾语、定语；指很谦虚的人"},{"id":41552,"word":"谦躬下士","pinyin":"qiān gōng xià shì","abbr":"qgxs","explanation":"犹言谦恭下士。谦虚恭敬地对待地位比自己低的士人。","source":{"text":"听说李闯王谦躬下士，对读书人十分珍重。","book":"姚雪垠《李自成》第二卷第四一章"},"similar":["谦恭下士","谦谦下士"],"usage":"作谓语、定语；指态度谦虚"},{"id":41553,"word":"谦逊下士","pinyin":"qiān xùn xià shì","abbr":"qxxs","explanation":"下：礼让。旧时指达官贵人对地位不高但有才德的人谦虚而有礼貌。","source":{"text":"少好学，修父业，尤谦逊下士。","book":"《汉书·韦玄成传》"},"example":{"text":"虽～，于敌己上一无所屈。","book":"《金史·郑建充传》"},"similar":["谦恭下士","谦以下士"],"usage":"作谓语、定语；指态度谦虚"},{"id":41554,"word":"谨始虑终","pinyin":"jǐn shǐ lǜ zhōng","abbr":"jslz","explanation":"指慎之于始并虑及其终。","source":{"text":"惟是世变滔滔，党同伐异，任重道远，谨始虑终，往常书本生活，到此躬行实践，别有光景，如人饮水，冷暖自知。","book":"明·鹿善继《答范景龙书》"},"usage":"作谓语、定语；用于处事"},{"id":41555,"word":"谨小慎微","pinyin":"jǐn xiǎo shèn wēi","abbr":"jxsw","explanation":"谨、慎：小心，慎重；小、微：细小。过分小心谨慎，缩手缩脚，不敢放手去做。","source":{"text":"圣人敬小慎微，动不失时。","book":"《淮南子·人间训》"},"example":{"text":"其生平无不～，事事得其所处。","book":"清·恽敬《卓忠毅公遗稿书后》"},"similar":["谨言慎行","小心翼翼","小心谨慎"],"opposite":["胆大妄为","粗心大意","粗心大意"],"usage":"作谓语、宾语、定语、状语；指过分小心"},{"id":41556,"word":"谨慎从事","pinyin":"jǐn shèn cóng shì","abbr":"jscs","explanation":"细心慎重地处事。","source":{"text":"凡是可以招致敌人摧残人民的事，都应谨慎从事。","book":"邓小平《敌占区的组织工作与政策运用》"},"similar":["慎重从事"],"usage":"作谓语、定语；用于处事"},{"id":41557,"word":"谨慎小心","pinyin":"jǐn shèn xiǎo xīn","abbr":"jsxx","explanation":"非常小心地进行，谨言慎行。","source":{"text":"出入禁闼二十余年，小心谨慎，未尝有过，甚见亲信。","book":"东汉·班固《汉书·霍光传》"},"example":{"text":"但处理具体事情要～，及时总结经验。","book":"邓小平《吸取历史经验，防止错误倾向》"},"similar":["谨言慎行","小心谨慎"],"opposite":["粗枝大叶"],"usage":"作谓语、定语；指非常小心","story":["西汉时期，大将军霍去病的同父异母兄弟霍光被任命为光禄大夫，每当皇帝出行，霍光总跟随左右。他出入皇宫总是处处小心，事事谨慎，从不出任何差错。汉武帝十分宠信他，封他为大司马。汉武帝死后，他与御史大夫桑弘羊辅佐汉昭帝刘弗陵执政"]},{"id":41558,"word":"谨本详始","pinyin":"jǐn běn xiáng shǐ","abbr":"jbxs","explanation":"指事情一开始就要谨慎严格。","source":{"text":"故为人君者，谨本详始，敬小慎微，志如死灰，形如委衣。","book":"汉·董仲舒《春秋繁露·立元神》"},"usage":"作谓语、宾语；指人做事"},{"id":41559,"word":"谨毛失貌","pinyin":"jǐn máo shī mào","abbr":"jmsm","explanation":"原指绘画时小心地画出了细微而无关紧要之处，却忽略了整体面貌。后用以比喻注意了小处而忽略了大处。","source":{"text":"画者谨毛而失貌。","book":"《淮南子·说林训》"},"similar":["因小失大"],"usage":"作谓语、宾语；指因小失大"},{"id":41560,"word":"谨终如始","pinyin":"jǐn zhōng rú shǐ","abbr":"jzrs","explanation":"指谨慎小心、始终一致。","source":{"text":"心与天通，动有阴相，谨终如始，视险若夷。","book":"宋·楼钥《签书枢密院致仕赠资政殿学士正惠林公神道碑》"},"similar":["谨终慎始"],"usage":"作谓语、定语；用于处事"},{"id":41561,"word":"谨终慎始","pinyin":"jǐn zhōng shèn shǐ","abbr":"jzss","explanation":"指谨慎小心、始终一致。同“谨终如始”。","source":{"text":"谦恭抑畏，谨终慎始，巍巍蔼蔼，不可悉记。","book":"明·解缙《瑞应歌辞序》"},"similar":["谨终如始"],"usage":"作谓语、定语；用于处事"},{"id":41562,"word":"谨终追远","pinyin":"jǐn zhōng zhuī yuǎn","abbr":"jzzy","explanation":"终：人死；远：指祖先。指慎重地办理父母丧事，虔诚地祭祀远代祖先。","source":{"text":"谨终追远，仁也；显亲扬名，孝也。","book":"宋·苏轼《母蒲氏王氏秦国太天人外制》"},"similar":["慎终追远","慎终思远","追远慎终"],"usage":"作谓语、宾语；指旧的礼法"},{"id":41563,"word":"谨能胜祸","pinyin":"jǐn néng shèng huò","abbr":"jnsh","explanation":"谨：小心慎重；祸：灾难。做事谨慎可避免灾祸。","source":{"text":"力能胜贫，谨能胜祸。","book":"北魏·贾思勰《齐民要术序》"},"usage":"作宾语、定语；用于劝诫人"},{"id":41564,"word":"谨行俭用","pinyin":"jǐn xíng jiǎn yòng","abbr":"jxjy","explanation":"谨慎行事，节省费用。","source":{"text":"可不道个谨行俭用，十年不富，天之命也。","book":"元·马致远《任风子》第三折"},"usage":"作谓语、定语；指人很节省"},{"id":41565,"word":"谨言慎行","pinyin":"jǐn yán shèn xíng","abbr":"jysx","explanation":"谨、慎：小心，慎重。言语行动小心谨慎。","source":{"text":"君子道人以言而禁人以行，故言必虑其所终，而行必稽其所敝，则民谨于言而慎于行。","book":"《礼记·缁衣》"},"example":{"text":"八十年来识更真，深知言行切修身；～无些过，细数吾乡有几人。","book":"明·朱国桢《涌幢小品·笃行》"},"similar":["谨小慎微","小心谨慎"],"opposite":["胡作非为","为非作歹"],"usage":"作谓语、定语、状语；指人言行小心谨慎"},{"id":41566,"word":"谨谢不敏","pinyin":"jǐn xiè bù mǐn","abbr":"jxbm","explanation":"犹言敬谢不敏。用作自谦或推托之辞。不敏，不聪明，无能力。","source":{"text":"对于话剧‘预演’，或者‘招待参观，请予指教之类’却还是常常谨谢不敏，理由还不很明白吗？","book":"夏衍《谈自己》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“无奈胡雪岩自己也是人手不足，便只有～了。”"},"similar":["敬谢不敏"],"usage":"作谓语；用于自谦或推托之辞"},{"id":41567,"word":"谨谨慎慎","pinyin":"jǐn jǐn shèn shèn","abbr":"jjss","explanation":"细心慎重。","source":{"text":"如今进来了，老姑嫂两个照看得谨谨慎慎，一根草也不许人动。","book":"清·曹雪芹《红楼梦》第59回"},"example":{"text":"清·李宝嘉《官场现形记》第48回：“也不想辞差使了，仍旧～上他的局子，办他的公事。”"},"similar":["谨慎小心"],"opposite":["粗心大意"],"usage":"作定语、状语；用于处事"},{"id":41568,"word":"谨身节用","pinyin":"jǐn shēn jié yòng","abbr":"jsjy","explanation":"修身饬行，节省其用。","source":{"text":"谨身节用，以养父母。","book":"《孝经·庶人章》"},"example":{"text":"小人寡欲则能～，远罪丰家。","book":"宋·司马光《训俭示康》"},"usage":"作谓语、定语；指节俭"},{"id":41569,"word":"谨重严毅","pinyin":"jǐn zhòng yán yì","abbr":"jzyy","explanation":"谨：慎重小心；严：威严；毅：坚强。处事事情谨慎持重，严峻果断。","source":{"text":"猛瑰姿俊伟，博学好兵书。谨重严毅，气度雄远，细事不干其虑。","book":"《晋书·苻坚载记》"},"usage":"作谓语、定语；用于处事"},{"id":41570,"word":"谩上不谩下","pinyin":"mán shàng bù mán xià","abbr":"msbmx","explanation":"瞒：欺骗。欺骗上级，对下级无所顾忌。","source":{"text":"又谓制作之法曰：‘谩上不谩下’，通衢用以为戏云。","book":"宋·江万里《宣政杂录·通同部》"},"similar":["瞒上不瞒下"],"usage":"作谓语、宾语、定语；用于中层人物"},{"id":41571,"word":"谩不经意","pinyin":"màn bù jīng yì","abbr":"mbjy","explanation":"指随随便便不放在心上。谩，通“漫”。","source":{"text":"今谓皇上谩不经意，一切委之于臣，何其敢于厚诬皇上邪？","book":"明·张居正《乞鉴别忠邪以定国事疏》"},"similar":["漫不经意"],"usage":"作定语、状语；同“漫不经心”"},{"id":41572,"word":"谩天昧地","pinyin":"mán tiān mèi dì","abbr":"mtmd","explanation":"指无限制地隐瞒一切真实情况骗人。","source":{"text":"镇日谩天昧地，不顾神明。","book":"金·马钰《满庭芳·叹世》词"},"similar":["瞒天过海"],"usage":"作谓语、定语；指欺骗人"},{"id":41573,"word":"谩天谩地","pinyin":"màn tiān màn dì","abbr":"mtmd","explanation":"犹言谩天昧地。指无限制地隐瞒一切真实情况骗人。","source":{"text":"贾相国当国，陈藏一作《雪词》讥之，词曰：‘没巴没鼻，霎时间，做出谩天谩地。’","book":"元·刘一清《钱塘遗事·雪词》"},"similar":["瞒天瞒地"],"usage":"作谓语、宾语；指欺骗"},{"id":41574,"word":"谩藏诲盗","pinyin":"màn cáng huì dào","abbr":"mchd","explanation":"指收藏东西不谨慎而招致盗贼。谩，通“慢”。","source":{"text":"俗语说，财勿露白，要到子尴尬个时候，倒说伲是谩藏诲盗。","book":"《冷眼观》第17回"},"example":{"text":"事情过后，镇上出了不少的议论：有人说老蒲确是‘～’，不要看他自己装穷。","book":"王统照《五十元》"},"similar":["慢藏诲盗"],"usage":"作谓语、宾语；因保管疏忽而招致盗窃"},{"id":41575,"word":"谩辞哗说","pinyin":"màn cí huá shuō","abbr":"mchs","explanation":"指谎言乱语。","source":{"text":"今君王国于会稽，穷于入吴，言悲辞苦……而君王何为谩辞哗说，用而相欺，臣诚不取。","book":"汉·赵晔《吴越春秋·勾践入臣外传》"},"usage":"作宾语、定语；指谎话"},{"id":41576,"word":"谬以千里","pinyin":"miù yǐ qiān lǐ","abbr":"myql","explanation":"指错误荒谬到了极点。","source":{"text":"反对者们以为他真相信读经可以救国，真是‘谬以千里’了！","book":"鲁迅《华盖集·十四年的“读经”》"},"usage":"作宾语；指错误荒谬到了极点"},{"id":41577,"word":"谬妄无稽","pinyin":"miù wàng wú jī","abbr":"mwwj","explanation":"指极端错误，毫无根据。","source":{"text":"今之言相地卜兆者，皆叔季希觊之私，谬妄无稽之论也。","book":"明·张居正《葬地论》"},"usage":"作谓语、定语；指错误的"},{"id":41578,"word":"谬悠之说","pinyin":"miù yōu zhī shuō","abbr":"myzs","explanation":"谬悠：荒诞，无稽。荒唐、不合情理的言论。","source":{"text":"以谬悠之说，荒唐之言，无端崖之辞，时恣纵两不傥。","book":"战国·宋·庄周《庄子·天下》"},"similar":["无稽之谈"],"usage":"作主语、宾语；指荒唐的言论"},{"id":41579,"word":"谬想天开","pinyin":"miù xiǎng tiān kāi","abbr":"mxtk","explanation":"形容想法非常荒谬。","source":{"text":"而况梁氏之地租地价论，谬想天开，得未曾有。","book":"民意《告非难民生主义者》"},"example":{"text":"你这是～。"},"similar":["异想天开"],"usage":"作谓语、宾语；指想法非常荒谬"},{"id":41580,"word":"谬托知己","pinyin":"miù tuō zhī jǐ","abbr":"mtzj","explanation":"指假托为知心朋友。","source":{"text":"有班谬托知己的朋友，天天在一块儿打牌吃酒。","book":"清·李宝嘉《官场现形记》第五十二回"},"example":{"text":"至于《野草》，此后做不做很难说，大约是不见得再做了，省得人来～，舐皮论骨。","book":"鲁迅《华盖集续编的续编·海上通信》"},"usage":"作谓语、定语；用于交往等"},{"id":41581,"word":"谬种流传","pinyin":"miù zhǒng liú chuán","abbr":"mzlc","explanation":"泛指荒谬的东西一代代地传下去。","source":{"text":"所取之士既不精，数年之后，复俾之主文，是非颠倒愈甚，时谓之缪种流传。","book":"《宋史·选举志二》"},"example":{"text":"然有可解者，～已数十年。","book":"清·恽敬《与饶陶南》"},"similar":["以讹传讹"],"opposite":["流芳百世"],"usage":"作宾语、分句；指谎言、谬论等","story":["宋朝时期，何澹见当时科举考试制度不严，考场上贿赂成风，致使没有真才实学的人投机取得功名，他向朝廷上奏折，指出先科考试的种种弊端与危害。如果考试不严，所选人才质量就不高，隔几年由他们主持考试，那么就会让谬误的根子代代相传"]},{"id":41582,"word":"谬误百出","pinyin":"miù wù bǎi chū","abbr":"mwbc","explanation":"谬误：错误；百出：很多。形容说话或写作漏洞或错误很多。","example":{"text":"众人素知他富商出身，手面阔绰好客豪爽而已，说出话来都着三不着两别字连篇，～。","book":"二月河《乾隆皇帝》八"}},{"id":41583,"word":"谬采虚声","pinyin":"miù cǎi xū shēng","abbr":"mcxs","explanation":"指错误地相信虚假的名声。","source":{"text":"制台又谬采虚声，拿他当作了一员能员，先委了他几个好差使。","book":"清·李宝嘉《官场现形记》第56回"},"similar":["谬采虚誉"],"usage":"作谓语；有时用作谦词"},{"id":41584,"word":"谬采虚誉","pinyin":"miù cǎi xū yù","abbr":"mcxy","explanation":"指错误地相信虚假的名声。同“谬采虚声”。","source":{"text":"自惟庸陋，靡所取裁，顾承过爱，谬采虚誉。","book":"梁启超《致伍秩庸星使书》"},"similar":["谬采虚声"],"usage":"作谓语；有时用作谦词"},{"id":41585,"word":"谭何容易","pinyin":"tán hé róng yì","abbr":"thry","explanation":"谭：同“谈”；何容：岂可，怎能容许；易：轻易。指事情做起来并不像说的那样简单。","source":{"text":"盖做一富人，谭何容易，必至殚心极虑者数十年。","book":"清·钱泳《履园丛话·臆论·五福》"},"similar":["谈何容易"],"usage":"作谓语；形容问题复杂"},{"id":41586,"word":"谭天说地","pinyin":"tán tiān shuō dì","abbr":"ttsd","explanation":"指所谈的内容极为广泛。形容谈论者知识广博。","source":{"text":"钱青见那先生学问平常，故意谭天说地，讲论古今，惊得先生一字俱无。","book":"《醒世恒言钱秀才错占凤凰俦》"},"similar":["谈天说地"],"usage":"作谓语、宾语、定语；形容人说话没有主题"},{"id":41587,"word":"谭虎色变","pinyin":"tán hǔ sè biàn","abbr":"thsb","explanation":"谭：同“谈”；色：脸色。比喻一提到可怕的事就情绪紧张起来。","source":{"text":"有光生长穷乡，谭虎色变，安能默然而已。","book":"明·归有光《论三区赋役水利书》"},"similar":["谈虎色变"],"usage":"作谓语、定语、状语；指心有余悸"},{"id":41588,"word":"谭言微中","pinyin":"tán yán wēi zhòng","abbr":"tywz","explanation":"说话隐微曲折而切中事理。","source":{"text":"真所谓谭天微中，可以解纷矣。","book":"明沈德符《野获编·督抚·海忠介被纠》"},"similar":["谈言微中"],"usage":"作宾语、定语；指人说话"},{"id":41589,"word":"谮下谩上","pinyin":"zèn xià mán shàng","abbr":"zxms","explanation":"谗毁下级，欺谩上级。","source":{"text":"谮下谩上，恒其心术，妒人之能，幸人之失。","book":"唐柳宗元《骂尸虫文》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":41590,"word":"谲怪之谈","pinyin":"jué guài zhī tán","abbr":"jgzt","explanation":"谲怪：怪诞。荒诞不稽的言论。","source":{"text":"康回倾地，夷羿彃日，木夫九首，土伯三目，谲怪之谈也。","book":"南朝·梁·刘勰《文心雕龙·辨骚》"},"example":{"text":"～不可信。"},"similar":["无稽之谈"],"opposite":["言之凿凿"],"usage":"作主语、宾语；指荒诞不稽的言论"},{"id":41591,"word":"谲而不正","pinyin":"jué ér bù zhèng","abbr":"jebz","explanation":"谲：欺诈。诡诈而不正派。","source":{"text":"子曰：‘晋文公谲而不正，齐桓公正而不谲。’","book":"《论语·宪问》"},"opposite":["光明正大"],"usage":"作谓语、定语；指人狡诈"},{"id":41592,"word":"谷父蚕母","pinyin":"gǔ fù cán mǔ","abbr":"gfcm","explanation":"指传说中的农桑之神。","source":{"text":"三川饥，有青衣音子曰：‘世人厌弃五谷，地司已收其种矣，可相率祈谢谷父蚕母，当致丰穰。’","book":"宋·曾慥《类说续仙传》"},"usage":"作宾语；指农神"},{"id":41593,"word":"谷贱伤农","pinyin":"gǔ jiàn shāng nóng","abbr":"gjsn","explanation":"谷：粮食。指粮价过低，使农民受到损害。","source":{"text":"籴甚贵，伤民；甚贱，伤农。民伤则离散，农伤则国贫。","book":"《汉书·食货志上》"},"example":{"text":"叶圣陶《多收了三五斗》：“‘～’的古语成为都市间报上的时行标题。”"},"usage":"作宾语；指粮价过低，使农民受到损害"},{"id":41594,"word":"谷马砺兵","pinyin":"gǔ mǎ lì bīng","abbr":"gmlb","explanation":"犹言秣马厉兵。","source":{"text":"秋来待试丞相府，谷马砺兵吾甚武。","book":"宋·陈师道《赠张文潜》诗"},"similar":["秣马砺兵","秣马厉兵"],"usage":"作谓语、宾语、定语；形容准备战斗"},{"id":41595,"word":"豁人耳目","pinyin":"huò rén ěr mù","abbr":"hrem","explanation":"开扩眼界，使耳目清新。","source":{"text":"大家之作，其言情也必沁人心脾，其写景也必豁人耳目。","book":"王国维《人间词话》五六"},"usage":"作谓语；用于使人开眼界"},{"id":41596,"word":"豁口截舌","pinyin":"huō kǒu jié shé","abbr":"hkjs","explanation":"撕开嘴巴，截去舌头。指命人住嘴。","source":{"text":"我根前使不着你之乎者也、诗云子曰，早该豁口截舌！","book":"元·关汉卿《单刀会》第四折"},"usage":"作谓语、宾语；指命人住嘴"},{"id":41597,"word":"豁然大悟","pinyin":"huò rán dà wù","abbr":"hrdw","explanation":"形容彻底晓悟。","source":{"text":"曰：‘吾今而后’，是豁然大悟语。","book":"宋·释道原《景德传灯录》卷五：“简蒙指教，豁然大悟。”宋·睦安《祖庭事苑》：“闻道安讲《般若》，豁然大悟。”明·李贽《四书评·孟子七》"},"example":{"text":"颜渊至此，～矣。","book":"明·袁宗道《读〈论语〉》"},"similar":["豁然顿悟","豁然省悟","豁然开悟"],"opposite":["执迷不悟"],"usage":"作谓语、定语；用于处事"},{"id":41598,"word":"豁然开悟","pinyin":"huò rán kāi wù","abbr":"hrkw","explanation":"形容彻底晓悟。同“豁然大悟”。","source":{"text":"初闻安师讲《般若经》，豁然开悟，叹曰：‘九流异议，皆糠秕耳。’","book":"晋·无名氏《莲社高贤传·慧远法师》"},"similar":["豁然顿悟","豁然大悟","豁然省悟"],"usage":"作谓语、定语；用于处事"},{"id":41599,"word":"豁然开朗","pinyin":"huò rán kāi lǎng","abbr":"hrkl","explanation":"豁然：形容开阔；开朗：开阔明亮。从黑暗狭窄变得宽敞明亮。比喻突然领悟了一个道理。","source":{"text":"极初狭，才通人。复行数十步，豁然开朗。","book":"晋·陶潜《桃花园记》"},"example":{"text":"宝玉～笑道：“很是，很是。","book":"清·曹雪芹《红楼梦》第九十一回"},"similar":["豁然贯通"],"opposite":["百思莫解","大惑不解"],"usage":"作谓语、宾语、定语；比喻突然领悟了道理","story":["晋朝时期，陶渊明看不惯官场的尔虞我诈，毅然不为五斗米而折腰，辞官归隐。他在《桃花源记》中构想一个没有阶级、没有剥削的太平世界：“山有小口，仿佛若有光。便舍船，从口入。初极狭，才通人。复行数十步，豁然开朗。”"]},{"id":41600,"word":"豁然省悟","pinyin":"huò rán xǐng wù","abbr":"hrxw","explanation":"形容彻底晓悟。同“豁然大悟”。","source":{"text":"祖曰：‘汝被我解。’马鸣豁然省悟，稽首皈依，遂求剃度。","book":"《五灯会元·西天祖师·十一祖富那夜奢尊者》"},"example":{"text":"武帝（梁武帝）道：‘卿言深透禅机，使朕～。’","book":"《禅真逸史》第二回"},"similar":["豁然开悟","豁然大悟","豁然顿悟"],"usage":"作谓语、定语；用于处事"},{"id":41601,"word":"豁然确斯","pinyin":"huò rán què sī","abbr":"hrqs","explanation":"指明白透彻。","source":{"text":"此都忘其知也。尔乃俄然始了无耳。了无，则天地万物彼我是非豁然确斯也。","book":"《庄子·齐物论》：“依而有无矣，而未知有无之果孰有孰无也”晋·郭象注"},"example":{"text":"今君复能实证古文，则真～，持之有故矣。","book":"章炳麟《与刘光汉书》"},"similar":["豁然开悟"],"usage":"作谓语、定语；用于处事"},{"id":41602,"word":"豁然贯通","pinyin":"huò rán guàn tōng","abbr":"hrgt","explanation":"豁然：通达的样子；贯通：前后贯穿通晓。指一下了弄通了某个道理。","source":{"text":"至于用力之久，而一旦豁然贯通焉，则众物之表里精粗无不到，而吾心之全体大用无明矣。","book":"宋·朱熹《大学章句》"},"example":{"text":"把札文反复细看，看了十来遍，忽然～，竟悟出一个道理来。","book":"清·李宝嘉《官场现形记》第五十四回"},"similar":["豁然开朗","顿开茅塞","恍然大悟"],"opposite":["大惑不解"],"usage":"作谓语、定语；指学问、事理等方面"},{"id":41603,"word":"豁然雾解","pinyin":"huò rán wù jiě","abbr":"hrwj","explanation":"豁然：开阔明亮的样子；雾解：消除。形容长期的疑团一下子消除了。","source":{"text":"积年疑滞，豁然雾解。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["豁然开朗"],"usage":"作谓语、定语；用于处事"},{"id":41604,"word":"豁然顿悟","pinyin":"huò rán dùn wù","abbr":"hrdw","explanation":"同“豁然大悟”。形容彻底晓悟。","source":{"text":"贾豁然顿悟，曰：‘翁不知贾奉雉即某是也。’翁大骇，走报其家。","book":"清·蒲松龄《聊斋志异·贾奉雉》"},"similar":["豁然开悟","豁然大悟","豁然省悟"],"usage":"作谓语、定语；用于处事"},{"id":41605,"word":"豁目开襟","pinyin":"huò mù kāi jīn","abbr":"hmkj","explanation":"豁目：开阔眼界；襟：襟怀，胸怀。极目远视，开阔胸襟。","source":{"text":"高楼闲上对晴空，豁目开襟半日中。","book":"唐·李中《登毗陵青山楼》诗"},"usage":"作谓语、定语；用于书面语"},{"id":41606,"word":"豁达先生","pinyin":"huò dá xiān shēng","abbr":"hdxs","explanation":"指人心胸坦荡，头脑清醒。","source":{"text":"此处向不平静，自豁达先生过后，永无为祟者。","book":"《子不语》"},"example":{"text":"他被人公称为～。"},"usage":"作主语、宾语、定语；指人的心胸","story":["孝廉蔡魏公对人讲鬼有三技：一迷、二遮、三吓。他列举他的表弟豁达先生遇鬼的故事。豁达先生晚上路过西乡，看到一个涂脂擦粉的女人跟着他走，后又上前拦住他，继而又变成披头散发、血流满面的恶鬼吓他，他始终不怕，鬼拿他没辙"]},{"id":41607,"word":"豁达大度","pinyin":"huò dá dà dù","abbr":"hddd","explanation":"豁达：胸襟开阔；大度：试题大。形容人宽宏开通，能容人。","source":{"text":"观夫汉高之兴也，非徒聪明神武，豁达大度而已也。","book":"晋·潘岳《西征赋》"},"example":{"text":"刘邦是在封建时代被历史家称为“～，从谏如流”的英雄人物。","book":"毛泽东《在扩大的中央工作会议上的讲话》"},"similar":["宽大为怀","恢宏大度","宽宏大量"],"opposite":["鼠肚鸡肠","心胸狭窄"],"usage":"作谓语、定语、状语；形容人豪爽"},{"id":41608,"word":"豆分瓜剖","pinyin":"dòu fēn guā pōu","abbr":"dfgp","explanation":"象瓜被剖开，豆从荚里裂出一样。比喻国土被分割。同“豆剖瓜分”。","source":{"text":"出入三代，五百余载，竟瓜剖而豆分。","book":"南朝·宋·鲍照《芜城赋》"},"example":{"text":"自五季乱离，各据城垒，～，七十余年。","book":"《宋史·王禹偁传》"},"similar":["豆剖瓜分"],"opposite":["融为一体"],"usage":"作谓语、定语；指国土等被分割"},{"id":41609,"word":"豆剖瓜分","pinyin":"dòu pōu guā fēn","abbr":"dpgf","explanation":"象瓜被剖开，豆从荚里裂出一样。比喻国土被分割。","source":{"text":"平王东迁，星离豆剖；当涂驭寓，瓜分鼎立。","book":"语出《晋书·地理志序》"},"example":{"text":"看如此江山，忍归胡虏？～，都为吾故士。","book":"清·秋瑾《如此江山》词"},"similar":["分崩离析","土崩瓦解"],"opposite":["打成一片","融为一体","合而为一"],"usage":"作谓语、定语；指国土等被分割"},{"id":41610,"word":"豆棚瓜架","pinyin":"dòu péng guā jià","abbr":"dpgj","explanation":"指百姓聚会纳凉说话闲聊的地方。","source":{"text":"姑妄言之姑听之，豆棚瓜架雨如丝，料应厌作人间语，爱听秋坟鬼唱诗。","book":"清·王士慎《〈聊斋志异〉题辞》"}},{"id":41611,"word":"豆渣脑筋","pinyin":"dòu zhā nǎo jīn","abbr":"dznj","explanation":"脑子好像豆渣。比喻极其愚蠢的人。","example":{"text":"跟这种～是讲不通的。"},"usage":"作宾语、定语；用于骂人"},{"id":41612,"word":"豆萁燃豆","pinyin":"dòu qí rán dòu","abbr":"dqrd","explanation":"比喻兄弟相残。","source":{"text":"煮豆燃豆萁，豆在釜中泣。本是同根生，相煎何太急。","book":"三国·魏·曹植《七步诗》"},"example":{"text":"生死由来一样情，～并根生；存亡姊妹能相念，可笑阋墙亲弟兄。","book":"《初刻拍案惊奇》卷二三"},"similar":["豆萁相煎"],"usage":"作宾语、定语；用于内部争斗","story":["三国时期，魏文帝曹丕很妒忌兄弟曹植的才华，想找一个借口把他杀死，命令他在七步之内作出一首诗，否则处死。曹植作诗：“煮豆持作羹，漉菽以为汁，萁在釜下然，豆在釜中泣。本是同根生，相煎何太急。”曹丕只好贬他去镇守边疆"]},{"id":41613,"word":"豆萁相煎","pinyin":"dòu qí xiāng jiān","abbr":"dqxj","explanation":"比喻兄弟相残。同“豆萁燃豆”。","source":{"text":"煮豆持作羹，漉菽以为汁；萁在釜下燃，豆在釜中泣；本自同根生，相煎何太急！","book":"三国·魏·曹植《七步诗》"},"example":{"text":"～，便宜了民族仇敌。","book":"林基路《囚徒歌》"},"similar":["豆萁燃豆"],"usage":"作宾语、定语；用于内部争斗","story":["三国时期，魏文帝曹丕很妒忌兄弟曹植的才华，想找一个借口把他杀死，命令他在七步之内作出一首诗，否则处死。曹植作诗：“煮豆持作羹，漉菽以为汁，萁在釜下然，豆在釜中泣。本是同根生，相煎何太急。”曹丕只好贬他去镇守边疆"]},{"id":41614,"word":"豆蔻年华","pinyin":"dòu kòu nián huá","abbr":"dknh","explanation":"豆蒄：多年生草本植物，比喻处女。指女子十三四岁时。","source":{"text":"娉娉袅袅十三余，豆蔻梢头二月初。","book":"唐·杜牧《赠别》诗"},"example":{"text":"一遇到女人，可就要发挥才藻了，不是“徐娘半老，风韵犹存”，就是“～，玲珑可爱”。","book":"鲁迅《且介亭杂文二集·论人言可畏》"},"similar":["黄金时代","金色年华","黄花少年"],"opposite":["风烛残年","桑榆暮景","人老珠黄"],"usage":"作主语、宾语；用于少女"},{"id":41615,"word":"豆觞之会","pinyin":"dòu shāng zhī huì","abbr":"dszh","explanation":"豆：古代的一种食器，形如高脚盘；觞：古代盛酒器。指宴会。","source":{"text":"至于豆觞之会，轩盖之游，多奉光尘，最承欢会。","book":"唐·白居易《祭李司徒文》"}},{"id":41616,"word":"豆重榆瞑","pinyin":"dòu chóng yú míng","abbr":"dcym","explanation":"原指多吃大豆使人发胖，吃榆能使人久睡。后形容人本性难改。","source":{"text":"豆令人重，榆令人瞑。","book":"三国·魏·稽康《养生论》"},"example":{"text":"你知道“～”的道理吗？"},"usage":"作定语；指人的饮食"},{"id":41617,"word":"豕交兽畜","pinyin":"shǐ jiāo shòu chù","abbr":"sjsc","explanation":"比喻待人没有礼貌。","source":{"text":"食而弗爱，豕交之也；爱而不敬，兽畜之也。","book":"《孟子·尽心上》"},"usage":"作宾语、定语；用于书面语"},{"id":41618,"word":"豕亥鱼鲁","pinyin":"shǐ hài yú lǔ","abbr":"shyl","explanation":"指书籍传写或刊印中的文字错误。","source":{"text":"书字人知之，犹尚写之多误。故谚曰：书三写，鱼成鲁，虚成虎。此之谓也。","book":"《吕氏春秋·察传》载有“己亥”误作“三豕”的故事。晋葛洪《抱朴子·遐览》"},"example":{"text":"宋·宋咸《注序》：“然士大夫号藏书者，所得本皆～，不堪其读。”"},"similar":["鲁鱼亥豕","豕虎传讹"],"usage":"作宾语、定语；指文字错误"},{"id":41619,"word":"豕分蛇断","pinyin":"shǐ fēn shé duàn","abbr":"sfsd","explanation":"比喻支离破碎。","source":{"text":"一击而鱼溃鸟离；四合而豕分蛇断。","book":"后蜀·何光远《鉴诫录·知机对》"},"similar":["支离破碎"],"usage":"作宾语、定语；多用于比喻句"},{"id":41620,"word":"豕突狼奔","pinyin":"shǐ tū láng bēn","abbr":"stlb","explanation":"豕：猪；突：猛冲。象猪那样冲撞，象狼那样奔跑。形容成群的坏人乱冲乱撞，到处搔扰。","source":{"text":"豕突狼奔，坚瑕避乱。","book":"清·娮中人《后序》"},"example":{"text":"虽然没有像抗战初期的势若燎原，可是敌寇的～，并未稍歇。","book":"叶剑英《在敌后的两年》"},"similar":["狼奔豕突"],"usage":"作主语、定语、状语；形容坏人"},{"id":41621,"word":"豕窜狼逋","pinyin":"shǐ cuàn láng bū","abbr":"sclb","explanation":"狼狈逃窜的样子。","source":{"text":"看这赖功贼容颜如粪土，出辕门豕窜狼逋。","book":"元·张国宾《薛仁贵》第一折"},"similar":["狼奔豕突"],"usage":"作谓语、宾语、状语；用于比喻句"},{"id":41622,"word":"豕而负涂","pinyin":"shǐ ér fù tú","abbr":"seft","explanation":"豕：猪；涂：泥；负涂：背上有泥。猪身上有很多污泥。比喻肮脏污秽。","source":{"text":"豕而负涂，秽莫过焉。","book":"《周易·暌》：“上九，暌孤，见豕负涂。”王弼注"},"usage":"作宾语、定语；用于书面语"},{"id":41623,"word":"豕虎传讹","pinyin":"shǐ hǔ chuán é","abbr":"shce","explanation":"指书籍传写或刊印中的文字错误。同“豕亥鱼鲁”。","source":{"text":"而世之考古者，拾班范之一言，摘沈萧之数简，兼有竹素烂脱，豕虎传讹，易斗分作升分，更予琳为惠琳，乃出校书之陋，本非作者之愆。","book":"清·钱大昕《〈甘二史考异〉序》"},"similar":["豕亥鱼鲁"],"usage":"作宾语、定语；用于书面语"},{"id":41624,"word":"豕虱濡濡","pinyin":"shǐ shī rú rú","abbr":"ssrr","explanation":"豕：猪；濡濡：苟且偷安。猪身上的虱子，苟且偷安。比喻在个人小天地里苟且偷安，自我陶醉。","source":{"text":"濡濡者，豕虱是也。","book":"《庄子·徐无鬼》"}},{"id":41625,"word":"豕食丐衣","pinyin":"shǐ shí gài yī","abbr":"ssgy","explanation":"吃猪狗之食，穿乞丐之衣。比喻极其贫困。","source":{"text":"举良吏而拨之高位，既显荣而去矣。观其境内，冻饿僵死犹昔也，豕食丐衣犹昔也。","book":"清·唐甄《潜书·考功》"},"opposite":["锦衣玉食"],"usage":"作宾语、定语；用于生活"},{"id":41626,"word":"豚蹄穰田","pinyin":"tún tí ráng tián","abbr":"ttrt","explanation":"比喻所花费的极少而所希望的过多。","source":{"text":"《史记·滑稽列传》记载：有一个农民，用一个小猪蹄祭神，祝庄稼丰收。"},"usage":"作宾语、定语；用于处事等"},{"id":41627,"word":"象形夺名","pinyin":"xiàng xíng duó míng","abbr":"xxdm","explanation":"夺：决定。指依据事物形态特征决定它的名字。","source":{"text":"如今年深岁改，人不能识，故皆象形夺名，渐渐的唤差了，也是有的。","book":"清·曹雪芹《红楼梦》第十七回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":41628,"word":"象煞有介事","pinyin":"xiàng shà yǒu jiè shì","abbr":"xsyjs","explanation":"指装模作样，活像真有那么一回事似的。","source":{"text":"屠维岳的法宝就是说大话，象煞有介事，满嘴的有办法，有把握！","book":"茅盾《子夜》"},"similar":["像煞有介事","装模作样"],"usage":"作谓语；指装模作样"},{"id":41629,"word":"象牙之塔","pinyin":"xiàng yá zhī tǎ","abbr":"xyzt","explanation":"指主张“为艺术而艺术”的资产阶级文艺家脱离社会现实的个人幻想的艺术境界。也比喻脱离现实生活的知识分子的小天地。","source":{"text":"现在比较安全一点的，还有一条路，而不做时评而作艺术家，要为艺术而艺术。住在‘象牙之塔’里，目前自然要比别处平安。","book":"鲁迅《集外集拾遗·关于知识阶级》"},"example":{"text":"他们死也不肯走出‘～’，也许走出了‘～’，又走进了‘水晶之宫’。","book":"瞿秋白《乱弹·世纪末的悲哀》"},"similar":["空中楼阁"],"usage":"作主语、宾语；指幻想的艺术境界"},{"id":41630,"word":"象简乌纱","pinyin":"xiàng jiǎn wū shā","abbr":"xjws","explanation":"象简：象牙做的朝笏；乌纱：黑纱制成的官帽。手执象牙笏，头戴乌纱帽。指旧时大官的装束。","source":{"text":"把象简乌纱收拾起，打扮出村翁的风致，拜谢当今圣主赐臣归。","book":"明·冯惟敏《商调集贤宾·舍弟乞休》"},"usage":"作宾语、定语；用于书面语"},{"id":41631,"word":"象箸玉杯","pinyin":"xiàng zhù yù bēi","abbr":"xzyb","explanation":"象箸：象牙筷子；玉杯：犀玉杯子。形容生活奢侈。","source":{"text":"象箸玉杯，必不羹菽藿，则必旄象豹胎。","book":"战国·韩·韩非《韩非子·喻老》"},"example":{"text":"倾宫琼榭，～，截胫剖心。","book":"晋·符洪《谏杀朱轨》"},"usage":"作宾语、定语；指极度奢侈的生活"},{"id":41632,"word":"象耕鸟耘","pinyin":"xiàng gēng niǎo yún","abbr":"xgny","explanation":"传说舜死苍梧，象为之耕；禹葬会稽，鸟为之耘。后用以形容民俗古朴，有舜禹时代的遗风。","source":{"text":"《文选·左思〈吴都赋〉》：“象耕鸟耘，此之自与。”李善注引《越绝书》：“舜死苍梧，象为之耕；禹葬会稽，鸟为之耘。”一说，耕者以象行为法，耘者如鸟之啄食。"},"example":{"text":"恒水又东迳蓝莫塔，塔边有池……此中空荒无人，群象以鼻取水洒地，若苍梧、会稽～矣。","book":"北魏郦道元《水经注·河水一》"}},{"id":41633,"word":"象齿焚身","pinyin":"xiàng chǐ fén shēn","abbr":"xcfs","explanation":"焚身：丧生。象因为有珍贵的牙齿而遭到捕杀。比喻人因为有钱财而招祸。","source":{"text":"象有齿以焚其身，贿也。","book":"《左传·襄公二十四年》"},"example":{"text":"正是：山木自寇，～。恫哉李督！死不分明。","book":"蔡东藩、许廑父《民国通俗演义》第一二一回"},"usage":"作宾语；比喻人因为有钱财而招祸"},{"id":41634,"word":"豪侠尚义","pinyin":"háo xiá shàng yì","abbr":"hxsy","explanation":"待人豪爽勇敢，注重义气。","source":{"text":"于同学中物识郑士良号弼臣者，其为人豪侠尚义。","book":"孙中山《心理建设》第八章"},"usage":"作谓语、定语；用于为人"},{"id":41635,"word":"豪厘不伐，将用斧柯","pinyin":"háo lí bù fá，jiāng yòng fǔ kē","abbr":"hlbfjyfk","explanation":"豪，通“毫”。比喻祸害初萌生时若不加重视，酿成大患后再要消除，就很困难。","source":{"text":"《周书》曰：‘绵绵不绝，蔓蔓奈何？豪厘不伐，将用斧柯，前虑不定，将有大患，将奈之何？’","book":"《史记·苏秦列传》"},"similar":["豪末不掇，将成斧柯"],"usage":"作宾语、定语；用于劝诫人"},{"id":41636,"word":"豪厘之差，将致千里","pinyin":"háo lí zhī chā，jiāng zhì qiān lǐ","abbr":"hlzcjzql","explanation":"豪：通“毫”；厘：很小的计量单位；差：差异；致：招引。指极其微小的差错，最终会造成很大的错误。","source":{"text":"然某等区区，实恐理失于内，事败于外，豪厘之差，将致千里，使荆蛮乖离，西嵎不守，唇亡齿寒，侵逼无限也。","book":"《晋书·陶侃传》"},"similar":["差之毫厘，谬以千里"],"usage":"作宾语、分句；用于强调不能有一丝差错"},{"id":41637,"word":"豪取智笼","pinyin":"háo qǔ zhì lóng","abbr":"hqzl","explanation":"犹言巧取豪夺。","source":{"text":"及其为家也，以俭勤自将，铢积寸累，迄用有成，而豪取智笼之术一切置不用，故无怨恶于人。","book":"宋·陈亮《金元卿墓志铭》"},"similar":["巧取豪夺"],"usage":"作谓语、定语；用于掠夺财富等"},{"id":41638,"word":"豪商巨贾","pinyin":"háo shāng jù jiǎ","abbr":"hsjj","explanation":"指大商人。","source":{"text":"由是虚估之利皆入豪商巨贾。","book":"《宋史·食货志下五》"},"example":{"text":"而当时通商之业亦渐盛，～往往与士大夫酬酢。","book":"梁启超《中国学术思想变迁之大势》第三章第一节"},"usage":"作主语、宾语、定语；用于书面语"},{"id":41639,"word":"豪夺巧取","pinyin":"háo duó qiǎo qǔ","abbr":"hdqq","explanation":"豪夺：强抢；巧取：软骗。旧时形容达官富豪谋取他人财物的手段。现指用各种方法谋取财物。","source":{"text":"巧偷豪夺古来有，一笑谁似痴虎头。","book":"宋·苏轼《次韵米黻二王书跋尾》"},"example":{"text":"～，岁以多金寄归。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录六》"},"similar":["巧取豪夺"],"usage":"作主语、宾语、定语；指用各种方法谋取财物"},{"id":41640,"word":"豪奢放逸","pinyin":"háo shē fàng yì","abbr":"hsfy","explanation":"奢：过分，过多；逸：安闲。气魄特别豪放，不受任何拘束。","source":{"text":"中山平，拜幽州刺史，豪奢放逸，左迁上谷太守，后赐爵曲阳侯。","book":"《魏书·曲阳侯素延传》"},"usage":"作谓语、定语；指气魄特别豪放"},{"id":41641,"word":"豪干暴取","pinyin":"háo gàn bào qǔ","abbr":"hgbq","explanation":"指恃强夺取。","source":{"text":"治储之事，散有聚无，士需将征，豪干暴取，凶不改敛，贫不减费，权利而府怨是难之也。","book":"明·何景明《内篇》"},"similar":["横征暴敛"],"usage":"作谓语、宾语、定语；用于抢劫等"},{"id":41642,"word":"豪情壮志","pinyin":"háo qíng zhuàng zhì","abbr":"hqzz","explanation":"豪迈的情感，远大的志向。","source":{"text":"他们大多数两鬓添霜，然而豪情壮志，更见坚强。","book":"茅盾《温故以知新》"},"example":{"text":"那长街，那小巷，正有无限的～拥塞其间。","book":"郭小川《厦门风姿》诗"},"similar":["慷慨激昂","雄心壮志"],"opposite":["碌碌无为","万念俱灰"],"usage":"作主语、宾语；指人的理想"},{"id":41643,"word":"豪情逸致","pinyin":"háo qíng yì zhì","abbr":"hqyz","explanation":"豪情：指兴奋豪放的感情；逸致：悠闲脱俗的情趣。兴奋豪放的情感和洒脱的情趣。","source":{"text":"记得丁歌甲舞，曾醉昆仑，豪情逸致，飘飘若仙。","book":"清·梁章钜《楹联丛话·三话·上·戏楼旧联》"},"example":{"text":"古人所渴想的诗境是具现在眼前来了，是～吗？不，一点也不！","book":"郭沫若《革命春秋·神泉七》"},"similar":["闲情逸致"],"usage":"作宾语；指人的志趣"},{"id":41644,"word":"豪放不羁","pinyin":"háo fàng bù jī","abbr":"hfbj","explanation":"羁：马笼头，引伸为束缚。形容人性情豪迈，不受拘束。","source":{"text":"彝少而豪放，出入殿庭，步眄高上，无所顾忌。","book":"《北史·张彝传》"},"example":{"text":"方岳宗是现任松江知府方岳贡的哥哥，为人慷慨侠义，～，喜欢喝酒，十分健谈。","book":"姚雪垠《李自成》第一卷第十六章"},"similar":["豪迈不羁","任达不拘"],"opposite":["畏首畏尾","束手束脚"],"usage":"作谓语、定语；指不受拘束"},{"id":41645,"word":"豪末不掇，将成斧柯","pinyin":"háo mò bù duō，jiāng chéng fǔ kē","abbr":"hmbdjcfk","explanation":"豪，通“毫”。比喻祸害初萌生时若不加重视，酿成大患后再要消除，就很困难。","source":{"text":"此言防患在微也。","book":"《逸周书·观周》：“绵绵不绝，蔓蔓奈何？豪末不掇，将成斧柯。”孔晁注"},"similar":["毫末不札，将寻斧柯"],"usage":"作宾语、定语；用于劝诫人"},{"id":41646,"word":"豪杰并起","pinyin":"háo jié bìng qǐ","abbr":"hjbq","explanation":"豪杰：英雄，也指有杰出才干之人。到处都涌现出英雄人物。","source":{"text":"自董卓以来，豪杰并起，跨州连郡者不可胜数。","book":"《三国志·蜀志·诸葛亮传》"}},{"id":41647,"word":"豪杰英雄","pinyin":"háo jié yīng xióng","abbr":"hjyx","explanation":"指气概、胆识、能力都杰出的人物。","source":{"text":"家住浔阳江浦上，最称豪杰英雄。","book":"明·施耐庵《水浒传》第37回"},"similar":["英雄豪杰"],"usage":"作主语、宾语、定语；指杰出人物"},{"id":41648,"word":"豪横跋扈","pinyin":"háo hèng bá hù","abbr":"hhbh","explanation":"跋扈：专横暴戾。横行不法，专横暴虐。","source":{"text":"禄山豪横跋扈，远近忧之，而上意未寤，一日遐周隐去，不知所之。","book":"唐·郑处诲《明皇杂录·李遐周》"},"similar":["专横跋扈"],"opposite":["彬彬有礼","谦虚谨慎"],"usage":"作谓语、定语；用于为人处世等"},{"id":41649,"word":"豪气未除","pinyin":"háo qì wèi chú","abbr":"hqwc","explanation":"豪放不羁的作风或气慨依然未改。","source":{"text":"湖海人～，可怜七尺落蘧庐。 ★清·赵翼《瓯北诗话·七言律五·遣兴》"}},{"id":41650,"word":"豪竹哀丝","pinyin":"háo zhú āi sī","abbr":"hzas","explanation":"指管弦乐。","source":{"text":"打鱼斫脍修故事，豪竹哀丝奉欢乐。","book":"宋·陆游《东津》诗"},"example":{"text":"想当年那种门卷珠帘，河泊画舫，～，玉软香温的旖旎风光，不知迷醉了多少王孙公子。","book":"石三友《金陵野史·武定桥边》"},"similar":["豪管哀弦"],"usage":"作宾语、定语；用于音乐等"},{"id":41651,"word":"豪管哀弦","pinyin":"háo guǎn āi xián","abbr":"hgax","explanation":"指管弦乐。","source":{"text":"在红氍毹上，在豪管哀弦之中，要演出的是许多热耳酸心、悲欢离合的故事。","book":"秦牧《艺海拾贝·变形》"},"example":{"text":"我喜欢听～"},"similar":["豪竹哀丝"],"usage":"作宾语、定语；用于音乐等"},{"id":41652,"word":"豪言壮语","pinyin":"háo yán zhuàng yǔ","abbr":"hyzy","explanation":"豪迈雄壮的言语。形容充满英雄气概的话。","source":{"text":"（丘濬）即席联句，动辄数百言。豪言警语，如壮涛激浪，飞雪走雷，去触山而迸发。","book":"明·焦竑《玉堂丛语·一·文学·丘濬》"},"example":{"text":"即使他的作品有革命乐观主义的～，那么必有大气磅礴，感人极深，指出方向……的革命浪漫主义。","book":"茅盾《老兵的希望》"},"similar":["慷慨激昂"],"opposite":["唉声叹气"],"usage":"作主语、宾语、定语；形容充满英雄气概的话"},{"id":41653,"word":"豪言空话","pinyin":"háo yán kōng huà","abbr":"hykh","explanation":"内容空洞的大话。","example":{"text":"她习惯用～骗人。"},"similar":["豪言壮语"],"usage":"作宾语、定语；指大话"},{"id":41654,"word":"豪迈不羁","pinyin":"háo mài bù jī","abbr":"hmbj","explanation":"羁：束缚。形容人性情豪迈直爽，不受拘束。","source":{"text":"（方域）性豪迈不羁，为文有奇气。","book":"《清史稿·文艺传·侯方域》"},"similar":["豪放不羁"],"usage":"作谓语、定语；指不受拘束"},{"id":41655,"word":"豪迈不群","pinyin":"háo mài bù qún","abbr":"hmbq","explanation":"群：合群。性格豪放而不合群。","source":{"text":"庄昹，字孔旸，江浦人。自幼豪迈不群，嗜古博学。","book":"《明史·庄昹传》"},"usage":"作谓语、定语；用于人的性格"},{"id":41656,"word":"豪门巨室","pinyin":"háo mén jù shì","abbr":"hmjs","explanation":"豪门：权贵之家；巨室：大家望族。指富贵之家。","source":{"text":"为政不难，不得罪于巨室。","book":"《晋书·阎缵传》：“其侍臣以下文武将吏，且勿复取戚豪门子弟。”《孟子·离娄上》"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“～的帐房，明欺暗骗，东家跌倒，西宾吃饱的情形，比比皆是。”"},"similar":["豪门贵宅","富室豪家"],"usage":"作宾语、定语；指富贵之家"},{"id":41657,"word":"豪门贵宅","pinyin":"háo mén guì zhái","abbr":"hmgz","explanation":"豪富者的门庭，显贵者的院落。指有权势的达官贵人之家。","source":{"text":"先生拣豪门贵宅之女，别为之求。","book":"元·王实甫《西厢记》第二本第三折"},"example":{"text":"她出身于～。"},"similar":["豪门贵族"],"usage":"作主语、宾语、定语；指富贵人家"},{"id":41658,"word":"豪门贵胄","pinyin":"háo mén guì zhòu","abbr":"hmgz","explanation":"指权们贵族的子孙。","source":{"text":"况且你们那豪门贵胄做官读书的上等人物，个个都做了我家吮痈舐痔一呼百诺的孝顺孙儿。","book":"梁启超《新罗马·党狱》"},"usage":"作主语、宾语、定语；用于权贵人家"},{"id":41659,"word":"豹头环眼","pinyin":"bào tóu huán yǎn","abbr":"bthy","explanation":"形容人的面目威严凶狠。","source":{"text":"我也不信，我豹头环眼，倒拿不住一目的夏侯惇。","book":"元·无名氏《博望烧屯》第二折"},"example":{"text":"那官人生的～，燕颔虎须，八尺长短身材，三十四五年纪。","book":"明·施耐庵《水浒全传》第七回"},"usage":"作谓语、宾语；指人的长相"},{"id":41660,"word":"豹死留皮","pinyin":"bào sǐ liú pí","abbr":"bslp","explanation":"豹子死了，皮留在世间。比喻将好名声留传于后世。","source":{"text":"豹死留皮，人死留名。","book":"《新五代史·王彦章传》"},"example":{"text":"则其人肉体虽死，精神永生。俗语说：‘人死留名，～’，也就是这个意思。","book":"冯玉祥《我的生活》第三十八章"},"similar":["人死留名"],"opposite":["遗臭万年"],"usage":"作宾语、定语、分句；与“人死留名”连用","story":["五代时期，梁朝名将“王铁枪”王彦章跟随梁太祖朱温南征北战，屡立战功，深受重用。梁末帝朱贞继位后，唐军进攻梁国。王彦章受命御敌，但因寡不敌众被俘。唐庄宗劝王彦章归降。王彦章说：豹死留皮，人死留名，宁死不降。不久就被杀害"]},{"id":41661,"word":"豹死留皮，人死留名","pinyin":"bào sǐ liú pí，rén sǐ liú míng","abbr":"bslprslm","explanation":"豹子死后留下珍贵的毛皮,人死后留下美名于后世。","source":{"text":"豹死留皮，人死留名，大丈夫怎肯负人恩德？","book":"宋·无名氏《新编五代史平话·唐史上》"},"example":{"text":"教授公训戒子姓，每称引古语，‘～’，斯其芳风流尘，顾不远与？","book":"清·钱谦益《和州鲁氏先茔神道碑铭》"},"usage":"作宾语、定语；可分开使用","story":["五代时期，梁朝名将“王铁枪”王彦章跟随梁太祖朱温南征北战，屡立战功，深受重用。梁末帝朱贞继位后，唐军进攻梁国。王彦章受命御敌，但因寡不敌众被俘。唐庄宗劝王彦章归降。王彦章说：豹死留皮，人死留名，宁死不降。不久就被杀害"]},{"id":41662,"word":"豺狐之心","pinyin":"chái hú zhī xīn","abbr":"chzx","explanation":"指有豺狼和狐狸那样的凶残、狡猾的心肠。","source":{"text":"近闻楚王无道，遂发材（豺）狐之心，诛妾家破芒（亡）消。","book":"《敦煌变文集·伍子胥变文》"},"example":{"text":"他的心肠就像～一样。"},"similar":["狼子野心","豺狼成性"],"usage":"作宾语；指心肠狠毒"},{"id":41663,"word":"豺狼之吻","pinyin":"chái láng zhī wěn","abbr":"clzw","explanation":"比喻残酷贪婪的官吏。","source":{"text":"使百姓困于豺狼之吻，一夫有死，皆亮之罪。","book":"《三国志·蜀书·诸葛亮传》注"},"usage":"作宾语；指贪官"},{"id":41664,"word":"豺狼冠缨","pinyin":"chái láng guàn yīng","abbr":"clgy","explanation":"豺狼：比喻坏人；冠缨：古代官吏的装束。比喻坏人作官掌权。","source":{"text":"俯视洛阳川，茫茫走胡兵，流血涂野草，豺狼尽冠缨。","book":"唐·李白《古风·第十九》"}},{"id":41665,"word":"豺狼塞路","pinyin":"chái láng sāi lù","abbr":"clsl","explanation":"豺狼：两种凶狠的野兽；塞：堵塞。比喻坏人当权。","source":{"text":"一人失德，四海土崩，群盗蜂起，豺狼塞路，南巢遂往，流彘不归。","book":"《北史·隋本纪》"},"similar":["豺狼当路"],"usage":"作宾语、定语；比喻坏人当权得势"},{"id":41666,"word":"豺狼塞道","pinyin":"chái láng sè dào","abbr":"clsd","explanation":"塞：堵塞。豺狼堵塞了路。比喻坏人得势掌权。","source":{"text":"一人失德，四海土崩，群盗蜂起，豺狼塞路，南巢遂往，流彘不归。","book":"《北史·隋本纪》"}},{"id":41667,"word":"豺狼当涂","pinyin":"chái láng dāng tú","abbr":"cldt","explanation":"比喻暴虐奸邪的人掌握国政。","source":{"text":"孝怀皇帝宫未反，豺狼当涂，人神同忿。","book":"《晋书·熊远传》"},"similar":["豺狼当路","豺狼横道"],"usage":"作宾语、定语；比喻坏人当权得势"},{"id":41668,"word":"豺狼当路","pinyin":"chái láng dāng lù","abbr":"cldl","explanation":"比喻暴虐奸邪的人掌握国政。","source":{"text":"方今豺狼当路而狐狸是先，人将谓殿下避强攻弱，进不为勇，退不为仁。","book":"《三国志·魏志·杜袭传》"},"example":{"text":"～，非止一人；鲸鲵不枭，倏焉五载。","book":"南朝·陈·沈炯《为王僧辩等劝进梁元帝第三表》"},"similar":["豺狼当道","豺狼当涂"],"usage":"作宾语、定语；比喻坏人当权得势"},{"id":41669,"word":"豺狼当道","pinyin":"chái láng dāng dào","abbr":"cldd","explanation":"当道：横在道路中间。比喻坏人当权。","source":{"text":"宝问其次，文曰：‘豺狼当道，安问狐狸！’宝默然不应。","book":"汉·荀悦《汉纪·平帝纪》"},"example":{"text":"男子汉非不以功名为念，那堪～，不如只在家中侍奉尊堂兄弟。","book":"元·宫大用《范张鸡黍》第一折"},"similar":["暗无天日","长夜漫漫","豺狼塞路"],"opposite":["舜日尧年","舜日尧天"],"usage":"作宾语、定语；比喻坏人当权得势","story":["东汉顺帝刘保的妻舅梁冀成为汉朝的大将军后，与其弟梁不疑及宦官势力勾结，狼狈为奸，无恶不作，天下人恨之入骨。光禄大夫张纲想主持正义弹劾梁冀，碰了一鼻子灰，结果大发感叹：“朝廷也是豺狼当道。”"]},{"id":41670,"word":"豺狼成性","pinyin":"chái láng chéng xìng","abbr":"clcx","explanation":"象豺狼一样凶恶残暴成了习性。形容为人残暴。","source":{"text":"加以虺蜴为心，豺狼成性。","book":"唐·骆宾王《为徐敬业讨武氏檄》"},"example":{"text":"此人枭獍为心，～，诚然王法所不容。","book":"明·凌濛初《二刻拍案惊奇》卷四"},"similar":["丧尽天良","惨无人道"],"opposite":["乐善好施"],"usage":"作谓语、定语；比喻阴险狠毒的坏人"},{"id":41671,"word":"豺狼横道","pinyin":"chái láng héng dào","abbr":"clhd","explanation":"横道：横在道路中间。比喻坏人当权。","source":{"text":"豺狼横道，不宜复问狐狸。","book":"《汉书·孙宝传》"},"similar":["豺狼当涂","豺狼塞路"],"usage":"作宾语、定语；比喻坏人当权得势"},{"id":41672,"word":"豺狼虎豹","pinyin":"chái láng hǔ bào","abbr":"clhb","explanation":"泛指危害人畜的各种猛兽。也比喻凶残的恶人。","source":{"text":"实在可怕的是豺狼虎豹。天晚了，倘若出来个把，我们就坏了。","book":"清·刘鹗《老残游记》第八回"},"example":{"text":"第一种蛇鼠虫蚊；第二种是～。","book":"清·吴趼人《二十年目睹之怪现状》第一回"},"usage":"作宾语、定语；指恶人"},{"id":41673,"word":"豺狼野心","pinyin":"chái láng yě xīn","abbr":"clyx","explanation":"比喻坏人的狠毒用心。","source":{"text":"而操豺狼野心，潜包祸谋。","book":"汉·陈琳《为袁绍檄豫州》"},"example":{"text":"寻超宗植性险戾，禀行凶詖，～，久暴遐迩。","book":"《南齐书·谢超宗传》"},"similar":["狼子野心"],"usage":"作宾语、定语；指坏人的心肠"},{"id":41674,"word":"豺虎肆虐","pinyin":"chái hǔ sì nüè","abbr":"chsn","explanation":"豺、虎：两种凶残的野兽。比喻坏人像凶残的野兽般横行不法。","source":{"text":"帝乱其政，豺虎肆虐，真人革命之秋也。","book":"汉·张衡《南都赋》"},"example":{"text":"中常待同郡侯览，专权王命，～，威震天下。","book":"汉·孔融《卫尉张俭碑铭》"},"usage":"作宾语、定语；用于时局"},{"id":41675,"word":"貂不足，狗尾续","pinyin":"diāo bù zú，gǒu wěi xù","abbr":"dbzgwx","explanation":"①指授官太滥。②指美中不足或以次充好。","source":{"text":"赵王伦篡位，时侍中、常侍九十七人，每朝，小人满庭，貂蝉半坐，时人谣曰：‘貂不足，狗尾续。’","book":"《文选·任昉》“华貂深不足之叹”唐·李善注"},"example":{"text":"散文，在文苑中算是成功的，但试看今年的选本，便是前三名，也即令人有‘～’之感。","book":"鲁迅《准风月谈·由聋而哑》"},"similar":["狗尾续貂","貂狗相属"],"usage":"作宾语、定语；用于官场等","story":["晋朝赵王司马伦狡猾、阴险、野心极大，勾结孙秀，密谋篡位。为了篡位成功，对属下及属下的家属也封官，当时官员上朝都要戴貂尾帽子，因官太多，貂尾不足，用狗尾代替。齐王冏等发兵讨伐司马伦，帮助惠帝司马衷复位"]},{"id":41676,"word":"貂狗相属","pinyin":"diāo gǒu xiāng shǔ","abbr":"dgxs","explanation":"指真伪或优劣混杂在一起。","source":{"text":"倬自幼学慕习鲁公书法……惜奇高踪堙没，遂命攻治其伤残，补续其次，虽真赝悬越，貂狗相属，且复瞻仰鲁公遗文，昭示于后矣。","book":"唐·崔倬《叙石幢事》"},"similar":["狗尾续貂"],"usage":"作宾语、定语；同“狗尾续貂”"},{"id":41677,"word":"貂蝉满座","pinyin":"diāo chán mǎn zuò","abbr":"dcmz","explanation":"貂蝉：汉代侍从官员帽上的装饰物，旧用作达官贵人的代称。旧指官爵多而滥。","source":{"text":"武冠，一曰武弁大冠，诸武官冠之。侍中，中常侍加黄金珰，附蝉为文，貂尾为饰，谓之‘赵惠文冠’。","book":"《后汉书·舆服志下》"},"similar":["狗尾续貂"],"usage":"作谓语、定语；指官多"},{"id":41678,"word":"貂裘换酒","pinyin":"diāo qiú huàn jiǔ","abbr":"dqhj","explanation":"貂裘：貂皮做的大衣。用貂皮大衣换酒喝。形容宝贵者放荡不羁的生活。","source":{"text":"且趁霜天鲈鱼好，把貂裘换酒长安市。","book":"宋·张辑《贺新郎·乙未冬别冯可久》"},"example":{"text":"不惜千金买宝刀，～也堪豪。","book":"清·秋瑾《对酒》诗"},"similar":["金龟换酒"],"usage":"作宾语、定语；指风流豪放","story":["晋朝时期，“竹林七贤”的阮咸的儿子阮孚特别好酒，在做安东参军时，整天在军中饮酒作乐，醉眼朦胧，丝毫不把军务放在心上，皇帝派他去作车骑将军的长史，劝他少喝酒，他更是纵情狂饮，经常是烂醉如泥，有时甚至用他的金饰貂皮大衣去换酒喝"]},{"id":41679,"word":"貊乡鼠壤","pinyin":"mò xiāng shǔ rǎng","abbr":"mxsr","explanation":"旧指民风浇薄、宵小横行的地区。同“貊乡鼠攘”。","example":{"text":"在这～中能有什么好人？"},"similar":["貊乡鼠攘"],"usage":"作宾语、定语；指坏人聚集的地方"},{"id":41680,"word":"貊乡鼠攘","pinyin":"mò xiāng shǔ rǎng","abbr":"mxsr","explanation":"旧指民风浇薄、宵小横行的地区。","source":{"text":"今之世，有穷陬荒滨，貊乡鼠攘。","book":"清·龚自珍《自序》"},"similar":["貊乡鼠壤"],"usage":"作宾语、定语；指坏人聚集的地方"},{"id":41681,"word":"貌不惊人","pinyin":"mào bù jīng rén","abbr":"mbjr","explanation":"指相貌平常，没有什么引人注意的地方。","source":{"text":"看你这般人不出众，貌不惊人，有何本事，要想做状元么？","book":"清·钱彩《说岳全传》第11回"},"example":{"text":"他虽然～，可本事很大。"},"similar":["其貌不扬"],"usage":"作谓语、定语；用于人"},{"id":41682,"word":"貌似强大","pinyin":"mào sì qiáng dà","abbr":"msqd","explanation":"表面好像强大，实际却很虚弱。","source":{"text":"我相信，几天之内，这个～的敌人必然要土崩瓦解，你说我们该不该这样来估计形势？ ★罗广斌、杨益言《红岩》第十二七章"},"example":{"text":"敌人看起来～，实际上是纸老虎"},"similar":["外强中干"],"usage":"作谓语、定语、状语；指空架子"},{"id":41683,"word":"貌似有理","pinyin":"mào sì yǒu lǐ","abbr":"msyl","explanation":"貌：表面。表面上看好像有道理。形容实际上没有道理，表面却像很有道理的样子。","example":{"text":"这派议论～，其实也是错的。","book":"毛泽东《湖南农民运动考察报告》"}},{"id":41684,"word":"貌合形离","pinyin":"mào hé xíng lí","abbr":"mhxl","explanation":"貌：表面上。表面上很合得来，而行动上却又差异很大。","source":{"text":"口亲心离，貌合形离。","book":"晋·葛洪《抱朴子·勤求》"}},{"id":41685,"word":"貌合心离","pinyin":"mào hé xīn lí","abbr":"mhxl","explanation":"表面上关系很密切，实际上是两条心。","source":{"text":"貌合心离者孤，亲谗远忠者亡。","book":"汉·黄石公《素书·遵义》"},"example":{"text":"我们不要做～的夫妻。"},"similar":["貌合神离","同床异梦"],"opposite":["心心相印"],"usage":"作谓语、定语、状语；指同床异梦"},{"id":41686,"word":"貌合情离","pinyin":"mào hé qíng lí","abbr":"mhql","explanation":"指两个人表面合得来，实际上感情不合。","source":{"text":"虽克竭敬爱，而貌合情离，与从夫之义悖矣。","book":"清·夏敬渠《野叟曝言》第115回"},"example":{"text":"他们是一对～的夫妻。"},"similar":["同床异梦","貌合神离"],"opposite":["心心相印"],"usage":"作谓语、定语、状语；指感情不合"},{"id":41687,"word":"貌合神离","pinyin":"mào hé shén lí","abbr":"mhsl","explanation":"貌：外表；神：内心。表面上关系很密切，实际上是两条心。","source":{"text":"貌合心离者孤，亲谗远忠者亡。","book":"《素书·遵义》"},"example":{"text":"但一从我做了他的党代表之后，便由“志同道合”一变而为“～”。","book":"郭沫若《涂家埠》"},"similar":["同床异梦","貌合心离"],"opposite":["心心相印","同心同德","情投意合"],"usage":"作谓语、定语、状语；指不一致"},{"id":41688,"word":"貌合行离","pinyin":"mào hé xíng lí","abbr":"mhxl","explanation":"表面上关系很密切，实际上是两条心。同“貌合神离”。","source":{"text":"口亲心疏，貌合行离。","book":"晋·葛洪《抱朴子·勤求》"},"similar":["貌合神离"],"opposite":["貌离神合"],"usage":"作谓语、定语、状语；指不一致"},{"id":41689,"word":"貌如其心","pinyin":"mao ru qi xin","abbr":"mrqx","explanation":"外貌长得象他的心一样宽厚老实。"},{"id":41690,"word":"貌是心非","pinyin":"mào shì xīn fēi","abbr":"msxf","explanation":"表面做的与心里想的完全两样。比喻表里不一。同“貌是情非”。","source":{"text":"表面做的与心里想的完全两样。比喻表里不一。同“貌是情非”。"},"similar":["貌是情非"],"opposite":["表里如一"],"usage":"作谓语、定语；指表里不一"},{"id":41691,"word":"貌是情非","pinyin":"mào shì qíng fēi","abbr":"msqf","explanation":"表面做的与心里想的完全两样。比喻表里不一。","source":{"text":"信可谓心与事背，貌是情非。","book":"《与僧正教》"},"similar":["表里不一","貌是心非"],"opposite":["表里如一"],"usage":"作谓语、定语；指表里不一"},{"id":41692,"word":"貌离神合","pinyin":"mào lí shén hé","abbr":"mlsh","explanation":"指表面上不同而实质上一致。","source":{"text":"夫六朝虽尚文采，然其健者则缓急疾徐，纵送激射，同符《史》、《汉》，貌离神合，精彩夺人。","book":"清·包世臣《再与杨季子书》"},"example":{"text":"也许你有時会觉得远离过去，这只是～，这意味着你更加接近过去了。","book":"余华《往事与刑罚》"},"opposite":["貌合神离"],"usage":"作谓语、定语；用于两者之间"},{"id":41693,"word":"贝联珠贯","pinyin":"bèi lián zhū guàn","abbr":"blzg","explanation":"贝与珠联贯在一起非常齐整漂亮。形容排列非常整齐。","source":{"text":"贝联珠贯拱北辰，三五纵横此何夕。","book":"宋·司马光《华星篇》"}},{"id":41694,"word":"贝锦萋斐","pinyin":"bèi jǐn qī fěi","abbr":"bjqf","explanation":"比喻谗言。","source":{"text":"萋兮斐兮，成是贝锦。","book":"《诗经·小雅·巷伯》"}},{"id":41695,"word":"贝锦萋菲","pinyin":"bèi jǐn qī fēi","abbr":"bjqf","explanation":"贝锦：指锦文，比喻诬陷人的谗言；萋菲：通“萋斐”，文采相错杂。比喻谗言。","source":{"text":"萋兮菲兮，成是贝锦。","book":"《诗经·小雅·巷伯》"},"example":{"text":"若陛下忘先臣大造之功，信～之说，臣等自当奉还三封，受戮市朝。","book":"《晋书·桓玄传》"},"similar":["流言蜚语","谗言佞语"],"usage":"作宾语、定语；指谗言"},{"id":41696,"word":"贝阙珠宫","pinyin":"bèi què zhū gōng","abbr":"bqzg","explanation":"用珍珠宝贝做的宫殿。形容房屋华丽。","source":{"text":"鱼鳞屋兮龙堂，紫贝阙兮朱宫。","book":"战国·楚·屈原《九歌·河伯》"},"example":{"text":"你看那香焚宝鼎，紫雾漾漾，玉楼金殿，～，便如天宫之景也。","book":"明·无名氏《庆长生》第四折"},"similar":["珠宫贝阙"],"usage":"作宾语、定语；比喻瑶台仙境"},{"id":41697,"word":"贞下起元","pinyin":"zhēn xià qǐ yuán","abbr":"zxqy","explanation":"用以表示天道人事的循环往复，周流不息。","source":{"text":"元亨利贞，即春夏秋冬，即东南西北，震元离亨兑利坎贞，往来循环，不忒不穷。","book":"《易·乾》：“元亨利贞。”尚秉和注"},"example":{"text":"好一篇囫囵文字，～，如环无端，后世文人，胸中原无无气，如何到此。","book":"明李贽《四书评·论语·子罕》"},"usage":"作宾语、定语；用于书面语"},{"id":41698,"word":"贞不绝俗","pinyin":"zhēn bù jué sú","abbr":"zbjs","explanation":"谓品性高洁而不与世俗隔绝。","source":{"text":"或问汝南范滂曰：‘郭林宗何如人？’滂曰：‘隐不违亲，贞不绝俗，天子不得臣，诸侯不得友，吾不知其它。","book":"《后汉书·郭太传》"},"example":{"text":"～，以忘机为心。","book":"唐独孤及《唐故河南府法曹参军张公墓表》"},"usage":"作谓语、定语；用于书面语"},{"id":41699,"word":"贞元会合","pinyin":"zhēn yuán huì hé","abbr":"zyhh","explanation":"指新旧更迭。","source":{"text":"元鸥阳玄《魏国文正公许先生神道碑》：“论许先生之为臣，而推世祖之为君，则见我元国家之初，当贞元会合之气运，故善言先生，必以道统为先，而后及功业。"},"usage":"作宾语、定语；用于书面语"},{"id":41700,"word":"贞夫烈妇","pinyin":"zhēn fū liè fù","abbr":"zflf","explanation":"贞：坚贞。封建社会对保持操守贞节而宁死不屈的男子和妇女的美称。","source":{"text":"我闻贞夫烈妇，自古至今耳闻，今日目前交见。","book":"《敦煌变文集·秋胡变文》"},"usage":"作主语、宾语、定语；用于夸奖封建礼教的人"},{"id":41701,"word":"贞松劲柏","pinyin":"zhēn sōng jìng bǎi","abbr":"zsjb","explanation":"以松柏的坚贞劲直，比喻人的高尚节操。","source":{"text":"贞松劲柏四时春，霁月光风一色新。","book":"金元好问《题石裕卿郎中所居四咏·雪岩》"},"example":{"text":"世当危乱，而后著忠臣烈士之名，岁寒霜雪，而后知～之操。","book":"明陆树声《耄馀杂识》"},"usage":"作宾语、定语；多用于比喻句"},{"id":41702,"word":"贞节牌坊","pinyin":"zhēn jié pái fāng","abbr":"zjpf","explanation":"古时用来表彰女性从一而终的门楼。指坚贞不二的标志。","source":{"text":"为儿子挣座贞节牌坊，还有点意思，没有儿子，没有希望。","book":"高阳《胡雪岩全传·平步青云》中册"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":41703,"word":"贞风亮节","pinyin":"zhēn fēng liàng jié","abbr":"zflj","explanation":"犹言高风亮节。","source":{"text":"高明远德，系轨于时；贞风亮节，流声累叶。","book":"南朝宋傅亮《故安成太守傅府君铭》"},"example":{"text":"他的～值得我们学习"},"similar":["高风亮节"],"usage":"作主语、宾语、定语；形容道德和行为"},{"id":41704,"word":"贞高绝俗","pinyin":"zhēn gāo jué sú","abbr":"zgjs","explanation":"高尚坚贞的节操超出普通人。","source":{"text":"窃见故冀州刺史南阳朱穆，前乌桓校尉臣同郡李膺，皆履正清平，贞高绝俗。","book":"《后汉书·刘陶传》"},"usage":"作谓语、定语；用于书面语"},{"id":41705,"word":"负义忘恩","pinyin":"fù yì wàng ēn","abbr":"fywe","explanation":"忘记别人对自己的恩德和好处，做出对不起别人的事。","source":{"text":"一个个背槽抛粪，一个个负义忘恩。","book":"元·关汉卿《调风月》第一折"},"example":{"text":"有这等事！不杀这～的孽畜，空做人间好汉！ ★明·方汝浩《禅真逸史》第十一","book":"苗龙离座大怒道"},"similar":["忘恩负义"],"opposite":["以德报怨"],"usage":"作谓语、定语；用于谴责"},{"id":41706,"word":"负乘斯夺","pinyin":"fù chéng sī duó","abbr":"fcsd","explanation":"指才德不称其职会招致祸患。","source":{"text":"小人而乘君子之器，盗思夺之矣。","book":"语出《易·系辞上》"},"example":{"text":"兼招讨使，权不为不重，若更加以甚高非常之宠，必起～之悔，所有宣抚副使恩命，实难祗受。","book":"宋·岳飞《辞宣抚副使札》"},"similar":["负乘致寇"],"usage":"作宾语、定语；用于书面语"},{"id":41707,"word":"负乘致寇","pinyin":"fù chéng zhì kòu","abbr":"fczk","explanation":"指居非其位，才不称职，就会招致祸患。","source":{"text":"六三：负且乘，致寇至，贞吝。《象》曰：‘负且乘，亦可丑也。自我致戎，又谁咎也。’","book":"典出《易·解》"},"example":{"text":"城峻冲生，～，惟陛下图之。","book":"《晋书·张祚传》"},"similar":["负乘斯夺"],"usage":"作宾语、定语；用于书面语"},{"id":41708,"word":"负任蒙劳","pinyin":"fù rèn méng láo","abbr":"frml","explanation":"指担负重任，承受劳苦。","source":{"text":"人君自任，而务为善以先下，则是代下负任蒙劳也，臣反逸矣。","book":"战国·赵·慎则《慎子·民杂》"},"example":{"text":"徒以无国会之故，代彼等～，凡百偾张，凡百丛脞。","book":"梁启超《为国会期限问题敬告国人》"},"usage":"作谓语、定语；用于为人"},{"id":41709,"word":"负俗之累","pinyin":"fù sú zhī lèi","abbr":"fszl","explanation":"负俗：指受到世俗的讥讽和批评；累：牵连，累及。受到世俗讥讽等事情的累及。","source":{"text":"马或奔踶而致千里，士或有负俗之累而立功名。","book":"汉·袁康《越绝书·越绝外传记范伯》：“有高世之材，必有负俗之累。”《汉书·武帝纪》"},"example":{"text":"东汉·班固《汉书·武帝纪》：“马或奔騠而致千里，士或有～而立功名。”"},"similar":["负俗之讥"],"usage":"作宾语；用于书面语"},{"id":41710,"word":"负俗之讥","pinyin":"fù sú zhī jī","abbr":"fszj","explanation":"因不谐于流俗而受到的讥议。同“负俗之累”。"},{"id":41711,"word":"负债累累","pinyin":"fù zhài lěi lěi","abbr":"fzll","explanation":"累累：沉重，繁多。欠别人的债务非常沉重。","source":{"text":"却说谭绍闻负债累累，……每日索欠填门，少不得典宅卖地，一概徐尝。","book":"清·李绿园《歧路灯》第六十七回"},"example":{"text":"他曾经为买书而～。","book":"吴玉章《从甲午战争前后到辛亥革命前后的加快》二"},"similar":["债台高筑"],"usage":"作谓语、定语；用于处境"},{"id":41712,"word":"负刍之祸","pinyin":"fù chú zhī huò","abbr":"fczh","explanation":"负：背着；刍：干草；负刍：指背草的人，代指纵火。纵火的灾祸。","source":{"text":"沈犹行曰：‘是非汝所知也。昔沈犹有负刍之祸，从先生者七十人，未有与焉。’","book":"《孟子·离娄下》"}},{"id":41713,"word":"负固不宾","pinyin":"fù gù bù bīn","abbr":"fgbb","explanation":"依恃险阻而不臣服。同“负固不服”。","source":{"text":"自负固不宾，干纪放命，肆逆滔天，窃据万里。","book":"《宋书·武帝记中》"},"similar":["负固不服","负固不悛"],"usage":"作谓语、定语；用于书面语"},{"id":41714,"word":"负固不悛","pinyin":"fù gù bù quān","abbr":"fgbq","explanation":"负固：依仗地势险固；悛：改悔。倚恃险阻而不臣服。","source":{"text":"若负固不悛，执迷不返，则命将遣师剿平诸国。","book":"《全相秦并六国平话》下卷"},"similar":["负固不服"],"usage":"作谓语、定语；用于书面语"},{"id":41715,"word":"负固不服","pinyin":"fù gù bù fú","abbr":"fgbf","explanation":"依恃险阻而不臣服。","source":{"text":"负，犹恃也，固，险可依以固者也；不服，不事大也。","book":"《周礼夏官大司马》：“野荒民散则削之，负固不服则侵之。”郑玄注"},"example":{"text":"张维等今被大兵围困，～。","book":"《水浒传》第九九回"},"similar":["负固不悛","负固不宾"],"usage":"作谓语、定语；用于书面语"},{"id":41716,"word":"负图之托","pinyin":"fù tú zhī tuō","abbr":"ftzt","explanation":"承受辅佐幼君的嘱托。","source":{"text":"吾身受顾命，辅相幼主，窃自揆度，才非博陆，而受姬公负图之托。","book":"《后汉书·郑弘传》：“周章身非负图之托，德乏万夫之望。”《三国志·吴志·诸葛恪传》"},"example":{"text":"晋·陈寿《三国志·吴志·诸葛恪传》：“吾身受顾命，辅相幼主，窃自揆度，才非博陆，而受姬公～。”"},"usage":"作宾语；用于托付等"},{"id":41717,"word":"负土成坟","pinyin":"fù tǔ chéng fén","abbr":"ftcf","explanation":"背土筑坟。古代认为是一种孝义的行为。","source":{"text":"会朱普卒，荣奔丧九江，负土成坟。","book":"《后汉书·醒荣传》"},"example":{"text":"王冕～，三年苫块。","book":"《儒林外史》第一回"},"usage":"作谓语、定语；用于称颂孝行"},{"id":41718,"word":"负地矜才","pinyin":"fù dì jīn cái","abbr":"fdjc","explanation":"指以其才能、出身而自负骄矜。","source":{"text":"他日，后主谓吏部尚书蔡徵曰：‘蔡凝负地矜才，无所用也。’","book":"《南史·蔡凝传》"},"similar":["负材矜地"],"usage":"作谓语、定语；用于为人"},{"id":41719,"word":"负坚执锐","pinyin":"fù jiān zhí ruì","abbr":"fjzr","explanation":"负：以背载物；坚：铠甲；执：拿着；锐：兵器。穿着坚固的盔甲，拿着锐利的武器。","source":{"text":"君等久负坚执锐，卫驾远征。","book":"宋·文莹《玉壶清话》第七卷"},"similar":["披坚执锐"],"usage":"作谓语、宾语、状语；指装备精良"},{"id":41720,"word":"负屈含冤","pinyin":"fù qū hán yuān","abbr":"fqhy","explanation":"负：遭受；含：衔在嘴里，比喻忍受。遭受委曲，忍受冤枉。","source":{"text":"他只待强拆开我长搀搀的连理枝，生摆断我颤巍巍的并头莲。其实负屈衔冤。","book":"元·关汉卿《望江亭》第四折"},"example":{"text":"把药酒酖死宋江、卢俊义，使他们～而死。","book":"清·陈忱《水浒后传》第二十七回"},"similar":["沉冤莫白"],"opposite":["报仇雪恨"],"usage":"作谓语、宾语、定语、状语；指蒙受委曲"},{"id":41721,"word":"负屈衔冤","pinyin":"fù qū xián yuān","abbr":"fqxy","explanation":"衔：用嘴含，这里指心里怀着。身上背着委屈，心里怀着冤枉。指蒙受冤屈，得不到昭雪。","source":{"text":"今日个勘成了因奸致命一凶贼，还了报了这负屈衔冤两怨鬼。","book":"元·无名氏《后庭花》第四折"},"example":{"text":"恩相明镜，念林冲～。","book":"明·施耐庵《水浒全传》第八回"},"similar":["负屈含冤"],"opposite":["报仇雪恨"],"usage":"作谓语、宾语、定语；指蒙受委曲"},{"id":41722,"word":"负山戴岳","pinyin":"fù shān dài yuè","abbr":"fsdy","explanation":"岳：高大的山。背负高大的山岳。比喻担负重任。","source":{"text":"一得奉见慈颜，永毕生愿。生死骨肉，岂过今恩，负山戴岳，未足胜苛。","book":"《周书·晋荡公护传》"},"usage":"作谓语、定语；用于比喻句"},{"id":41723,"word":"负嵎依险","pinyin":"fù yú yī xiǎn","abbr":"fyyx","explanation":"负、依：依靠，凭借；嵎：山弯；阻：险阻地带。指作战时占据有利地形。","source":{"text":"负隅依阻，莫敢婴御。","book":"汉·马融《广成颂》"}},{"id":41724,"word":"负弩前驱","pinyin":"fù nǔ qián qū","abbr":"fnqq","explanation":"弩：弓箭。背着弓箭走在前面。表示极为尊敬。","source":{"text":"至蜀，蜀太守以下郊迎，县令负弩矢前驱，蜀人以为宠。","book":"西汉·司马迁《史记·司马相如列传》"},"example":{"text":"但我们的斗士，只有对于外敌却是两样的：近的，是‘不抵抗’，远的，是‘～’云。","book":"鲁迅《伪自由书·观斗》"},"usage":"作谓语；表示尊敬"},{"id":41725,"word":"负德孤恩","pinyin":"fù dé gū ēn","abbr":"fdge","explanation":"指缺少恩义。","source":{"text":"安知愚下鬼，负德孤恩难制指，弄天之权侮人命。","book":"宋·李觏《闵雨诗》"},"example":{"text":"不走了，斯觑者，神天报应无虚设。休，休，休，～的见去也。","book":"金·董解元《西厢记诸宫调》卷四"},"usage":"作谓语、定语、状语；用于为人"},{"id":41726,"word":"负德背义","pinyin":"fù dé bèi yì","abbr":"fdby","explanation":"犹言负恩背义。","source":{"text":"[申侯]今又以国媚楚，使子之君，负德背义，自召干戈，祸及民社。","book":"《东周列国志》第二四回"},"similar":["负恩背义","负恩忘义"],"usage":"作谓语、定语；指做出对不起别人的事"},{"id":41727,"word":"负德辜恩","pinyin":"fù dé gū ēn","abbr":"fdge","explanation":"辜负了别人对自己的恩德。","source":{"text":"陵虽孤恩，汉亦负德。","book":"汉·李陵《答苏武书》"},"example":{"text":"学士怎肯似那等穷酸恶醋，得一个及第成名，却又早～。","book":"元·戴善夫《风光好》第三折"},"similar":["忘恩负义"],"opposite":["知恩图报"],"usage":"作谓语、宾语；指辜负了别人的恩德"},{"id":41728,"word":"负心违愿","pinyin":"fù xīn wéi yuàn","abbr":"fxwy","explanation":"负：辜负。辜负和违背自己的心愿。","source":{"text":"浩不能忘旧情，乃遣惠寂密告莺曰：‘浩非负心，实被季父所逼，复与孙氏结亲，负心违愿，痛彻心髓。","book":"明·冯梦龙《警世通言》第二十九卷"},"usage":"作谓语、定语；指辜负和违背自己的心愿"},{"id":41729,"word":"负恩忘义","pinyin":"fù ēn wàng yì","abbr":"fewy","explanation":"忘记别人对自己的恩德和好处，做出对不起别人的事。同“负恩背义”。","source":{"text":"紧降阶，释缚扶将起，是兄弟负恩忘义。","book":"元·施惠《幽闺记·虎头遇旧》"},"similar":["忘恩负义","负恩背义"],"usage":"作谓语、定语；指做出对不起别人的事"},{"id":41730,"word":"负恩昧良","pinyin":"fù ēn mèi liáng","abbr":"feml","explanation":"昧：隐藏；良：良心。辜负恩情，泯灭良心。","source":{"text":"不意今日群芳大放，彼独无花。负恩昧良，莫此为甚。","book":"清·李汝珍《镜花缘》第四回"},"usage":"作谓语、定语；用于处事"},{"id":41731,"word":"负恩背义","pinyin":"fù ēn bèi yì","abbr":"feby","explanation":"负：违背，背弃。忘记别人对自己的恩德和好处，做出对不起别人的事。","source":{"text":"今负恩背义，自为身谋，可若何？","book":"《新唐书·列女传·杨庆妻王氏》"},"example":{"text":"～，人弗戮，鬼斯戮之矣。","book":"明·宋濂《燕书》"},"similar":["忘恩负义"],"opposite":["知恩图报"],"usage":"作谓语、定语；指做出对不起别人的事"},{"id":41732,"word":"负手之歌","pinyin":"fù shǒu zhī gē","abbr":"fszg","explanation":"喻指临终前的咏歌。","source":{"text":"《礼记·檀弓上》：“孔子蚤作，负手曳杖，消摇於门，歌曰： ‘泰山其颓乎？梁木其坏乎？哲人其萎乎？’既歌而入，当户而坐。子贡闻之曰：‘泰山其颓，则吾将安仰；梁木其坏，哲人其萎，则吾将安放。夫子殆将病也。’遂趋而入。 [下续示例]"},"example":{"text":"[上接出处] 夫子曰：‘赐，尔来何迟也……夫明王不兴，而天下其孰能宗予，予殆将死也。’盖寝疾七日而没。”"}},{"id":41733,"word":"负才任气","pinyin":"fù cái rèn qì","abbr":"fcrq","explanation":"才：才能；气：意气。自恃有才能，纵任意气。","source":{"text":"负才尚气满朝知，高卧闲吟见客稀。","book":"唐·孙元晏《咏史诗·宋·袁粲》"},"example":{"text":"简宪之为人也，万事王侯，～。","book":"《梁书·张缵传》"},"similar":["负才使气"],"usage":"作谓语、定语；用于处世"},{"id":41734,"word":"负才使气","pinyin":"fù cái shǐ qì","abbr":"fcsq","explanation":"才：才能；气：意气。自恃有才能，纵任意气。","source":{"text":"负才尚气满朝知，高卧闲吟见客稀。","book":"唐·孙元晏《咏史诗·宋·袁粲》"},"example":{"text":"憕既羁旅，不被擢用。然～，未尝趣世禄之门 。","book":"《周书·薛憕传》"},"similar":["负才任气"],"usage":"作谓语、定语；用于处世"},{"id":41735,"word":"负才傲物","pinyin":"fù cái ào wù","abbr":"fcaw","explanation":"指依恃才学，骄傲而看不起旁人。","source":{"text":"王凤池彦章殂于龙游官署，貌癯猥琐；陈思洛殂于湖广学院署；张自服于徽州馆，皆负才傲物者也。","book":"清·许洽《眉叟年谱·康熙五十八年》"},"usage":"作谓语、定语；指人骄傲自大"},{"id":41736,"word":"负才尚气","pinyin":"fù cái shàng qì","abbr":"fcsq","explanation":"才：才能；气：意气。自恃有才能，纵任意气。","source":{"text":"负才尚气满朝知，高卧闲吟见客稀。","book":"唐·孙元晏《咏史诗·宋·袁粲》"}},{"id":41737,"word":"负担舍舟","pinyin":"fu dan she zhou","abbr":"fdsz","explanation":"身背行囊,离船上岸."},{"id":41738,"word":"负暄之献","pinyin":"fù xuān zhī xiàn","abbr":"fxzx","explanation":"暄：温暖。原指冬天晒太阳取暖当成一种好方法献给国君。后用来谦称自己的贡献很微小。也比喻所献出的东西并不贵重难得。","source":{"text":"宋国有田夫，常衣缦缊黂，仅以过冬。暨春东作，自曝于日，不知天下之有广厦隩室，绵纩狐狢。顾谓妻曰：‘负日之暄，人莫知之，以献吾君。’","book":"《列子·杨朱》"},"similar":["田父献曝"],"usage":"作宾语；用于自谦","story":["战国时期，宋国有一个没有见过世面的农夫，由于家贫终日穿一件粗麻衣，勉强过冬。第二年春天，天气晴朗，他就脱光衣服在太阳下曝晒，觉得十分舒服，由于没有见过漂亮的皮衣和高大的房子，就对妻子说将把这取暖的办法进献给国王"]},{"id":41739,"word":"负材任气","pinyin":"fù cái rèn qì","abbr":"fcrq","explanation":"指依恃才学，任性使气。","source":{"text":"涉猎书史，负材任气。","book":"《南史·陈宜黄侯慧纪传》"},"similar":["负才任气","负才使气"],"usage":"作谓语、定语；用于处世"},{"id":41740,"word":"负材矜地","pinyin":"fù cái jīn dì","abbr":"fcjd","explanation":"指以其才能、出身而自负骄矜。","source":{"text":"[孝标]负材矜地，自谓坐致云霄，岂图逡巡十稔而荣惭一命。","book":"《文选·刘孝标〈辩命论〉》作者“刘孝标”唐·李善注"},"similar":["负地矜才"],"usage":"作谓语、定语；用于为人"},{"id":41741,"word":"负气仗义","pinyin":"fù qì zhàng yì","abbr":"fqzy","explanation":"凭借正气，主持正义。","source":{"text":"小娥虽小，身体健壮如男子形。父亲把他许了历阳一个侠士，姓段名居贞，那人负气仗义，交游豪俊，却也在江湖上做大贾。","book":"明·凌濛初《初刻拍案惊奇》第十九卷"},"usage":"作谓语、定语；指人仗义"},{"id":41742,"word":"负气含灵","pinyin":"fù qì hán líng","abbr":"fqhl","explanation":"指有生气和灵性的人。","source":{"text":"此则普天率土，感切同雠；负气含灵，无非共愤。","book":"清·陈维崧《平滇颂》"},"usage":"作谓语、定语；用于人或事物等"},{"id":41743,"word":"负气斗狠","pinyin":"fù qì dǒu hěn","abbr":"fqdh","explanation":"负气：赌气；斗狠：发狠。恃其意气，发狠而为。","source":{"text":"却怕是负气斗狠，逃了出来的。","book":"清·吴敬梓《儒林外史》第四十一回"},"similar":["感情用事"],"usage":"作谓语、宾语；指人感情冲动"},{"id":41744,"word":"负石赴河","pinyin":"fù shí fù hé","abbr":"fsfh","explanation":"河：指黄河。背着石头跳进黄河。比喻人以死明志。","source":{"text":"故怀负石而赴河，是行之难为者也。","book":"《荀子·不苟》"},"usage":"作谓语、定语；用于人或处事"},{"id":41745,"word":"负石赴渊","pinyin":"fù shí fù yuān","abbr":"fsfy","explanation":"渊：深涧。背着石头跳进深渊。比喻人以死明志。","source":{"text":"故君子慎言出己，负石赴渊，行之难也。","book":"汉·刘向《说苑·说丛》"}},{"id":41746,"word":"负笈担簦","pinyin":"fù jí dān dēng","abbr":"fjdd","explanation":"笈：书箱；簦：古代有柄的笠，形似伞。背着书箱，扛着有柄的笠，奔走求学。","source":{"text":"有朋自远，无用栖凭，皆负笈担簦，栉风沐露。","book":"南朝·梁·任昉《求为刘瓛立馆启》"},"usage":"作谓语、定语；用于比喻句"},{"id":41747,"word":"负笈游学","pinyin":"fù jí yóu xué","abbr":"fjyx","explanation":"笈：书箱；游学：到外地求学。背着书箱，去外地求学。形容不知劳苦的求知态度。","source":{"text":"北海炳春，少立志操，寒苦自居，负笈游学。","book":"《晋书·王裒传》"}},{"id":41748,"word":"负类反伦","pinyin":"fù lèi fǎn lún","abbr":"flfl","explanation":"和同类事物所具有的特性相悖逆。","source":{"text":"负，犹背也。类，同也。","book":"《列子·仲尼》：“龙诳魏王曰：‘有意不心，有指不至，有物不尽，有影不移，发引千钧，白马非马，孤犊未尝有母。’其负类反伦，不可胜言也。”张湛注"},"example":{"text":"《山海经》有兽，以其尾飞；有鸟，以其须飞。则覆载之间，～，何所不有。","book":"《埤雅·释虫》"},"usage":"作谓语、定语；用于不合理的事"},{"id":41749,"word":"负罪引慝","pinyin":"fù zuì yǐn tè","abbr":"fzyt","explanation":"指引咎自责。","source":{"text":"负罪，自负其罪，不敢以为父母之罪；引慝，自引其慝，不敢以为父母之慝也。","book":"《书·大禹谟》：“[舜]负罪引慝，祇载见瞽螋。”蔡沈集传"},"example":{"text":"～，思古无訧，际人伦之穷者，何厚于自责也？","book":"清·沈德潜《说诗晬语》卷下"},"similar":["引咎自责"],"usage":"作谓语、宾语；用于处事"},{"id":41750,"word":"负老提幼","pinyin":"fù lǎo tí yòu","abbr":"flty","explanation":"背着老人，带着孩子。形容百姓全体出动，流离失所的悲惨情景。","source":{"text":"邠人父子兄弟相帅负老携幼揭釜甑而归。","book":"汉·赵晔《吴越春秋·吴太伯传》"},"example":{"text":"当期之世，水旱蝗虫，五谷饥贵，兵革并起，人民疾疫，道路不通，～，流散地方。","book":"宋·张君房《云笈七签》卷十九"},"similar":["负老携幼","扶老携幼"],"usage":"作谓语、宾语、状语；用于出行"},{"id":41751,"word":"负老携幼","pinyin":"fù lǎo xié yòu","abbr":"flxy","explanation":"背着老人，带着孩子。形容百姓全体出动，流离失所的悲惨情景。","source":{"text":"邠人父子兄弟相帅负老携幼揭釜甑而归。","book":"汉·赵晔《吴越春秋·吴太伯传》"},"example":{"text":"至被诏书当出，民感其恩，以忘恋土，～，甘心景从，众无携一式，为烦兵卫。","book":"《三国志·吴志·陆凯传》"},"similar":["扶老携幼"],"usage":"作谓语、定语；形容全体出动"},{"id":41752,"word":"负芒披苇","pinyin":"fù máng pī wěi","abbr":"fmpw","explanation":"犹言披荆斩棘。","source":{"text":"王有事于越，敖，敖子弟出死力，负芒披苇，入海望潮，拨棹，蒙虎皮以冒锋镝。","book":"清·陈梦雷《解介士传》"},"similar":["披荆斩棘"],"usage":"作谓语、宾语、状语；形容创业的艰苦"},{"id":41753,"word":"负荆请罪","pinyin":"fù jīng qǐng zuì","abbr":"fjqz","explanation":"负：背着；荆：荆条。背着荆条向对方请罪。表示向人认错赔罪。《史记·廉颇蔺相如列传》：“廉颇闻之，肉袒负荆，因宾客至蔺相如门谢罪。”","source":{"text":"廉颇闻之，肉袒负荆，因宾客至蔺相如门谢罪。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"我今特来寻贤弟，～。","book":"明·施耐庵《水浒全传》第四十六回"},"similar":["引咎自责"],"opposite":["兴师问罪"],"usage":"作谓语、定语；用于赔礼道歉的场合","story":["战国时期，赵国有两位重臣蔺相如与廉颇，因蔺相如多次立功，赵王封他为相国，廉颇不服气，认为自己的武功盖过他的嘴，蔺相如为了社稷，对廉颇多次避让。廉颇得知他的良苦用心后惭愧不已，便背负荆条向蔺相如请罪"]},{"id":41754,"word":"负荆谢罪","pinyin":"fù jīng xiè zuì","abbr":"fjxz","explanation":"背着荆条向对方请罪。表示向人认错赔罪。同“负荆请罪”。","source":{"text":"追悔无由，不免放效廉颇。专专负荆谢罪，望吾师、痛挞则个。","book":"金·马钰《满庭芳·谢咸阳王法师》词"},"similar":["负荆请罪"],"usage":"作谓语、定语；用于赔礼道歉的场合"},{"id":41755,"word":"负薪之忧","pinyin":"fù xīn zhī yōu","abbr":"fxzy","explanation":"意指背柴劳累，体力还未恢复。有病的谦词。","source":{"text":"君使士射，不能，则辞以疾，言曰：‘某有负薪之忧。’","book":"《礼记·曲礼下》"},"example":{"text":"刘子闲居，有～，食精良弗知其旨，血气交诊，断然焚如。","book":"唐·刘禹锡《论中》"},"similar":["负薪之病"],"usage":"作宾语；借指生病"},{"id":41756,"word":"负薪之才","pinyin":"fù xīn zhī cái","abbr":"fxzc　","explanation":"负：背，薪：柴。只有背柴草的才能。旧时比喻地位低微的人。","source":{"text":"举负薪之才，升君子之器。","book":"《后汉书·东平宪王苍传》"}},{"id":41757,"word":"负薪之疾","pinyin":"fù xīn zhī jí","abbr":"fxzj","explanation":"负薪：指有病。指背柴劳累，体力还未恢复。","source":{"text":"其明年七月，有负薪之疾，退休于居。","book":"唐·韩愈《复志赋并序》"},"example":{"text":"属有～，未倏敛版之恭，敢彻书函，冒干齐斧。","book":"宋·张孝祥《王枢密》"},"similar":["负薪之病","负薪之忧"],"usage":"作宾语；借指生病"},{"id":41758,"word":"负薪之病","pinyin":"fù xīn zhī bìng","abbr":"fxzb","explanation":"负薪：指有病。指背柴劳累，体力还未恢复。","source":{"text":"臣弘行能不足以称，素有负薪之病，恐先狗马填沟壑。","book":"西汉·司马迁《史记·平津侯主父列传》"},"similar":["负薪之忧","负薪之疾"],"usage":"作宾语；借指生病"},{"id":41759,"word":"负薪之言","pinyin":"fù xīn zhī yán","abbr":"fxzy","explanation":"负薪：背柴草，旧指地位低微的人。地位低微的人说的话。","source":{"text":"《文子》曰：‘圣人不让负薪之言，以广其名。’","book":"《史记·李斯列传》：“王者不却众庶，故能明其德。”司马贞索隐"},"similar":["负薪之议"],"usage":"作主语、宾语；用于口语"},{"id":41760,"word":"负薪之议","pinyin":"fù xīn zhī yì","abbr":"fxzy","explanation":"负薪：背柴草，旧指地位低微的人。地位低微的人的言论。","source":{"text":"采择狂夫之言，不逆负薪之议。","book":"《后汉书·班固传》"},"similar":["负薪之言"],"usage":"作主语、宾语；用于口语"},{"id":41761,"word":"负薪之资","pinyin":"fù xīn zhī zī","abbr":"fxzz","explanation":"负薪：背柴草，旧指地位低微的人；资：资质，指智慧，能力。指卑贱者的资质。","source":{"text":"臣以负薪之资，拔于陪隶之中，奉职宪台，擢授戎校。","book":"《后汉书·袁绍传》"},"usage":"作主语、宾语；用于书面语"},{"id":41762,"word":"负薪挂角","pinyin":"fù xīn guà jiǎo","abbr":"fxgj","explanation":"负薪：背着柴草，汉代朱买臣背着柴草读书；挂角：把备读的书挂在牛角上，隋代李密骑在牛背上读书。指边劳动边读书，不畏辛苦。","source":{"text":"如负薪，如挂角，身虽劳，犹苦卓。","book":"宋·王应璘《三字经》"}},{"id":41763,"word":"负薪救火","pinyin":"fù xīn jiù huǒ","abbr":"fxjh","explanation":"背着柴草去救火。比喻用错误的方法去消除灾祸，结果使灾祸反而扩大。","source":{"text":"譬犹抱薪救火，薪不尽，火不灭。","book":"《韩非子·有度》：“其国乱弱矣，又皆释国法而私其外，则是负薪而救火也，乱弱甚矣。”《史记·魏世家》"},"example":{"text":"若听诸葛亮之言，妄动甲兵，此所谓～也。","book":"明·罗贯中《三国演义》第四十三回"},"similar":["适得其反"],"opposite":["抽薪止沸"],"usage":"作谓语、定语、宾语；同“抱薪救火”"},{"id":41764,"word":"负薪构堂","pinyin":"fù xīn gòu táng","abbr":"fxgt","explanation":"指继承先人德业。","source":{"text":"以作室喻治政也。父已致法，子乃不肯为堂基，况肯构立屋乎？","book":"《书·大诰》：“若考作室，既厎法，厥子乃弗肯堂，矧肯构？”孔传"},"example":{"text":"慎守太君之命，免讥世禄之家，～，勿忘古训。","book":"宋·王禹偁《恩赐宰臣一子可尚书水部员外郎制》"},"usage":"作谓语、定语；用于书面语"},{"id":41765,"word":"负衡据鼎","pinyin":"fù héng jù dǐng","abbr":"fhjd","explanation":"指身居高位，肩负重任。","source":{"text":"负衡据鼎，指处丞相位。衡，秤，表持平；鼎，三足，喻三公。","book":"南朝·梁·刘勰《文心雕龙·程器》：“孔光负衡据鼎，而仄媚董贤；况班马之贱职，潘岳之下位哉！”周振甫注"},"usage":"作谓语、定语；用于人的地位"},{"id":41766,"word":"负诟忍尤","pinyin":"fù gòu rěn yóu","abbr":"fgry","explanation":"忍受指责和怨恨。","source":{"text":"责备之严，诚不足怪。庸讵知当局之负诟忍尤，艰难应付，有非楮墨所能罄者。","book":"陈夔龙《梦蕉亭杂记》卷一"},"usage":"作谓语、宾语；用于处世"},{"id":41767,"word":"负贵好权","pinyin":"fù guì hào quán","abbr":"fghq","explanation":"负：凭恃，倚仗；贵：有势力。倚仗豪门贵族，喜欢玩弄权术。","source":{"text":"武安负贵而好权。","book":"《史记·魏其武安侯列传》"}},{"id":41768,"word":"负郭穷巷","pinyin":"fù guō qióng xiàng","abbr":"fgqx","explanation":"负郭：背靠外城；穷巷：简陋的小巷。比喻家居僻陃，出身贫寒。","source":{"text":"至其家，家乃负郭穷巷。","book":"《史记·陈丞相世家》"},"usage":"作宾语、定语；用于人的出身"},{"id":41769,"word":"负重吞污","pinyin":"fù zhòng tūn wū","abbr":"fztw","explanation":"犹言忍辱负重。","source":{"text":"仁人志士，椎心泣血，负重吞污，图其所志。","book":"严复·夏曾佑《国闻报馆附印说部缘起》"},"similar":["负重含污"],"usage":"作谓语、定语；用于为人"},{"id":41770,"word":"负重含污","pinyin":"fù zhòng hán wū","abbr":"fzhw","explanation":"犹言忍辱负重。","source":{"text":"胸劈众流，曾不出口。负重含污，浩如山薮。险趋人先，利居众后。","book":"清·曾国藩《李忠武公神道碑铭》"},"similar":["忍辱负重","负重吞污"],"usage":"作谓语、定语；用于为人"},{"id":41771,"word":"负重涉远","pinyin":"fù zhòng shè yuǎn","abbr":"fzsy","explanation":"背着重东西走远路。比喻能够负担艰巨任务。同“负重致远”。","source":{"text":"不辞负重涉远，不避经险履危。","book":"晋·葛洪《抱朴子·勤求》"},"example":{"text":"吾闻～，不择地而休；累重家贫，不择禄而仕。","book":"清·各邦额《夜谭随录·崔秀才》"},"similar":["负重致远"],"usage":"作谓语、宾语；比喻能够负担艰巨任务"},{"id":41772,"word":"负重致远","pinyin":"fù zhòng zhì yuǎn","abbr":"fzzy","explanation":"负：背着；致：送到。背着重东西走远路。比喻能够负担艰巨任务。","source":{"text":"陆子可谓驽马有逸足之力，顾子可谓驽牛能负重致远也。","book":"《周易·系辞下》：“服牛乘马，引重致远，以利天下，盖取诸随。”《三国志·蜀志·庞统传》"},"example":{"text":"健犊须走车破辕，良马须逸鞭泛驾，然后能～。","book":"宋·王谠《唐语林·文学》"},"similar":["任重道远"],"usage":"作谓语、补语；比喻能够负担艰巨任务","story":["三国时期，东吴大都督周瑜去世，庞统前去吊唁，东吴名士陆绩、顾劭、全琮等人为庞统设宴饯行，他们向庞统请教如何识别人才，庞统认为陆绩是一匹千里马，顾劭是吃苦耐劳能负重的牛，全琮也是一代人才。他们认为这比喻风趣贴切"]},{"id":41773,"word":"负阻不宾","pinyin":"fù zǔ bù bīn","abbr":"fzbb","explanation":"犹言负固不服。","source":{"text":"亮毗佐危国，负阻不宾。","book":"《三国志·蜀志·诸葛亮传》"},"similar":["负固不宾","负固不服"],"usage":"作谓语、定语；用于书面语"},{"id":41774,"word":"负险不宾","pinyin":"fù xiǎn bù bīn","abbr":"fxbb","explanation":"犹言负固不服。","source":{"text":"夷帅范熊世为逋寇，自称为王，数攻百姓；且连接扶南，种类猥多，朋党相倚，负险不宾。","book":"《晋书·陶璜传》"},"similar":["负险不臣","负固不服"],"usage":"作谓语、宾语；用于处事"},{"id":41775,"word":"负险不臣","pinyin":"fù xiǎn bù chén","abbr":"fxbc","explanation":"犹言负固不服。","source":{"text":"龙文卜筑深山，乘轩衣蟒，有负险不臣之心。","book":"《明史·林润传》"},"similar":["负险不宾","负固不服"],"usage":"作谓语、宾语、定语；用于处事"},{"id":41776,"word":"负隅依阻","pinyin":"fù yú yī zǔ","abbr":"fyyz","explanation":"负：靠着；隅：同“嵎”，指山弯；阻：险阻地带。凭借地形的险阻，进行抵抗或固守。","source":{"text":"负隅依阻，莫敢婴御。","book":"汉·马融《广成颂》"},"usage":"作谓语、宾语；用于处事"},{"id":41777,"word":"负隅顽抗","pinyin":"fù yú wán kàng","abbr":"fywk","explanation":"负：依靠；隅：山势弯曲险阻的地方。凭借险阻，顽固抵抗。指依仗某种条件，顽固进行抵抗。","source":{"text":"有众逐虎。虎负嵎，莫之敢撄。","book":"《孟子·尽心下》"},"example":{"text":"最后牛元峰逃到镇东头的小寨里，指挥着一个多营～，死不投降。","book":"徐海东《奠基礼》"},"similar":["负险固守"],"opposite":["束手待毙","束手就擒"],"usage":"作谓语、定语；指垂死挣扎","story":["战国时期，齐国发生饥荒，饿死了许多人。孟子的弟子陈臻要孟子再次劝说齐王开仓放粮，孟子说他不想再做冯妇，于是讲一个众人赶虎，虎负隅顽抗，冯妇前去打死老虎，虽然为民除了害，但很多读书人去讥笑冯妇的故事"]},{"id":41778,"word":"负驽前驱","pinyin":"fù nǔ qián qū","abbr":"fnqq","explanation":"背着弓箭在前面开道。比喻迎接的礼度极为尊敬。","source":{"text":"至蜀，蜀太守以下郊迎，县令负驽矢先驱。","book":"《史记·司马相如列传》"},"example":{"text":"我们的斗士，只有对于外敌却是两样的：近的，是“不抵抗”，远的，是“～”云。","book":"鲁迅《伪自由书·观斗》"}},{"id":41779,"word":"负鼎之愿","pinyin":"fù dǐ zhī yuàn","abbr":"fdzy","explanation":"希图担负辅佐君王大任的愿望。","source":{"text":"伊尹故有莘氏僮也，负鼎操俎调五味，而立为相，其遇汤也。","book":"汉·韩婴《韩诗外传》卷七"},"example":{"text":"及定节立谋，以干时主，将怀～，盖为千载之遇焉。","book":"《后汉书·马援传》"},"usage":"作宾语；用于人的理想"},{"id":41780,"word":"贡禹弹冠","pinyin":"gòng yǔ tán guān","abbr":"gytg","explanation":"指贡禹与王吉（字子阳）友善，见其在位，亦愿为官。比喻乐意辅佐志向相同的人。","source":{"text":"吉与贡禹为友，世称‘王阳在位，贡公弹冠’。言其取舍同也。","book":"《汉书·王吉传》"},"example":{"text":"人之相知，贵相知心。王阳在位，～。","book":"清黄宗羲《与陈介眉庶常书》"},"similar":["弹冠相庆"],"usage":"作宾语、定语；指志趣相投","story":["汉宣帝时，琅琊人王吉和贡禹是很好的朋友，贡禹多次被免职，王吉在官场也很不得志。汉元帝时，王吉被召去当谏议大夫，贡禹听到这个消息很高兴，就把自己的官帽取出，弹去灰尘，准备戴用。果然没多久贡禹也被任命为谏议大夫"]},{"id":41781,"word":"财不露白","pinyin":"cái bù lù bái","abbr":"cblb","explanation":"露：显露；白：银子的代称。旧指有钱财不能泄露给别人看。现指随身携带的钱财不在人前显露。","source":{"text":"使客谓有此官银也，廪粮夫马，百计折乾。俗谓财不露白，今露白矣，孰能保群盗仗戈夺之？","book":"明·海瑞《驿传议·无策》"},"example":{"text":"俗话说，～。","book":"清·李绿园《歧路灯》第72回"},"opposite":["财大气粗"],"usage":"作宾语、定语；指随身携带的钱财不显露"},{"id":41782,"word":"财匮力绌","pinyin":"cái kuì lì chù","abbr":"cklc","explanation":"指钱财缺乏，力量不足。","source":{"text":"浙罹兵燹久，又当宗宪汰侈后，财匮力绌。","book":"《明史·赵炳然传》"},"similar":["财竭力尽"],"usage":"作谓语、定语；用于局面"},{"id":41783,"word":"财取为用","pinyin":"cái qǔ wéi yòng","abbr":"cqwy","explanation":"财：通“裁”。裁度取用。","source":{"text":"所赐金，陈廊庑下，军吏过，辄令财取为用。","book":"《汉书·窦婴传》"}},{"id":41784,"word":"财多命殆","pinyin":"cái duō mìng dài","abbr":"cdmd","explanation":"殆：危险。钱财多了，易招致盗贼，生命就有危险。","source":{"text":"况今位尊身危，财多命殆，鄙人知之，何疑君子。","book":"《后汉书·冯衍传》"},"usage":"作宾语、定语；用于劝诫人"},{"id":41785,"word":"财大气粗","pinyin":"cái dà qì cù","abbr":"cdqc","explanation":"①指富有财产，气派不凡。②指仗着钱财多而气势凌人。","source":{"text":"花婶子的这项收入十分可观。财大气粗，盖起这座青堂瓦舍的大宅院。","book":"刘绍棠《小荷才露尖尖角》五"},"example":{"text":"那时他～，大进大出。","book":"张周《步履艰难的中国》第二章"},"similar":["腰缠万贯"],"usage":"作谓语、定语；指有钱人"},{"id":41786,"word":"财殚力尽","pinyin":"cái dān lì jìn","abbr":"cdlj","explanation":"钱财和力量全部用尽。比喻生活陷入困窘的境地。","source":{"text":"当今天下黔黎，久经寇贼……财殚力尽，无以卒岁。","book":"《辛雄传》"},"similar":["财殚力竭"],"usage":"作谓语、定语；指生活困境"},{"id":41787,"word":"财殚力痡","pinyin":"cái dān lì pū","abbr":"cdlp","explanation":"殚：竭尽；痡：过度疲劳。钱财枯竭，民力疲困。","source":{"text":"汉倾天下，财殚力痡。","book":"唐·李华《吊古战场文》"},"example":{"text":"鏖斗历四五年，肝脑涂地，～。","book":"蔡东藩、许廑父《民国通俗演义》第四十四回尾注"},"similar":["财竭力尽"],"opposite":["国富民强"],"usage":"作谓语、定语；指社会局面"},{"id":41788,"word":"财殚力竭","pinyin":"cái dān lì jié","abbr":"cdlj","explanation":"钱财和力量全部用尽。比喻生活陷入困窘的境地。","source":{"text":"自桓玄以来，驱蹙残败，至乃男不被养，女无匹对，逃亡去就，不避幽深，自非财殚力竭，无以至此。","book":"《晋书·刘毅传》"},"example":{"text":"自冯氏数终，余烬奔窜，丑类渐盛，遂见陵逼，构怨连祸，三十余载，～，转自孱踧。","book":"《魏书·百济传》"},"similar":["财竭力尽","财殚力尽"],"usage":"作谓语、定语；指生活困境"},{"id":41789,"word":"财竭力尽","pinyin":"cái jié lì jìn","abbr":"cjlj","explanation":"钱财和力量全部用尽。比喻生活陷入困窘的境地。","source":{"text":"百姓财竭力尽，愁恨感天。","book":"汉·谷永《黑龙见东莱对》"},"example":{"text":"朝廷以诸道十五万众，裴度元臣宿望，乌重嗣、李光颜当时名将，屯守逾年，竟无成功，～。","book":"宋·洪迈《容斋随笔·长庆表章》"},"similar":["财殚力竭"],"usage":"作谓语、定语；指生活困境"},{"id":41790,"word":"财运亨通","pinyin":"cái yùn hēng tōng","abbr":"cyht","explanation":"亨：通达，顺利。发财的运道好，赚钱很顺利。","source":{"text":"谁知财运亨通，飘到长人国，那酒坛竟大获其利。","book":"清·李汝珍《镜花缘》第70回"},"example":{"text":"冯大少爷的老子死了，恭喜老兄～。","book":"洪深《冯大老爷·电影字幕》"},"similar":["日进斗金"],"opposite":["时乖运蹇","穷困潦倒"],"usage":"作谓语、定语；形容赚钱顺利"},{"id":41791,"word":"财迷心窍","pinyin":"cái mí xīn qiào","abbr":"cmxq","explanation":"指由于一心爱财而心中糊涂。","source":{"text":"如果当时这位作者，明达冷静一些，不财迷心窍，天下原可以平安无事的。","book":"孙犁《秀露集·耕堂读书记》"},"example":{"text":"你不能～误了大事。"},"similar":["见钱眼开"],"opposite":["拾金不昧"],"usage":"作谓语、定语、宾语；指贪财"},{"id":41792,"word":"责人以详，待己以廉","pinyin":"zé rén yǐ xiáng，dài jǐ yǐ lián","abbr":"zryxdjyl","explanation":"详：周密；廉：低，少。对别人要求很多，对自己却要求很少。","source":{"text":"今之君子则不然。其责人也详，其待己也廉。详，故人难于为善。廉，故自取也少。","book":"唐·韩愈《原毁》"},"opposite":["责己重，待人轻"],"usage":"作宾语、定语；用于处事"},{"id":41793,"word":"责先利后","pinyin":"zé xiān lì hòu","abbr":"zxlh","explanation":"尽职责、尽义务在他人之前，分离利益在他人之后。形容品德高尚。","source":{"text":"面丑心妍，利居众后，责在人先。","book":"唐·韩愈《送穷文》"},"similar":["先人后己"],"usage":"作谓语、定语；用于处事"},{"id":41794,"word":"责备求全","pinyin":"zé bèi qiú quán","abbr":"zbqq","explanation":"犹言求全责备。","source":{"text":"仅有某某数字，于四声未合，即姑置而过存之，亦孰为责备求全者。","book":"况周颐《蕙风词话》卷一"},"example":{"text":"～论已苛，阳秋贬笔未宜多。","book":"柳亚子《偕蕴山谈时事感赋蒹示燕叟》诗"},"similar":["求全责备"],"usage":"作谓语、定语；指过分要求"},{"id":41795,"word":"责备贤者","pinyin":"zé bèi xián zhě","abbr":"zbxz","explanation":"责备：批评指摘；贤者：有才德的人。对好人的要求指摘。指出有才德有声望的人的缺点","example":{"text":"你在～，让人难以接受"},"usage":"作谓语、宾语；用于婉辞"},{"id":41796,"word":"责实循名","pinyin":"zé shí xún míng","abbr":"zsxm","explanation":"按其名而求其实。","source":{"text":"自非责实循名，不能彰善瘅恶。","book":"唐·元稹《戒励风俗德音》"},"example":{"text":"观者依检先后，～，语无褒贬，而意具抑扬。","book":"清·章学诚《文史通义·永清县志政略序例》"},"similar":["循名责实","循名考实","求名责实"],"usage":"作谓语、宾语、定语；指要名实相符"},{"id":41797,"word":"责己以周，待人以约","pinyin":"zé jǐ yǐ zhōu，dài rén yǐ yuē","abbr":"zjyzdryy","explanation":"责己：要求自己；周：完备；约：简单。严格地要求自己，宽厚地对待别人。","source":{"text":"古之君子，其责己也重以周，其待人也轻以约。重以周，故不怠；轻以约，故人乐为善。","book":"唐·韩愈《原毁》"},"similar":["责己重以周，待人轻以约"],"opposite":["责人以详，待己以廉"],"usage":"作谓语、定语；用于处事"},{"id":41798,"word":"责己重以周，待人轻以约","pinyin":"zé jǐ zhòng yǐ zhōu，dài rén qīng yǐ yuē","abbr":"zjzyzdrqyy","explanation":"周：周到，引申为严格；约：简单，引申为不苛求。要求自己严格，对待别人要宽厚","source":{"text":"古之君子，其责己也重以周，其待人也轻以约。重以周，故不怠；轻以约，故人乐为善。","book":"唐·韩愈《原毁》"},"example":{"text":"曲树程《注评译析古文百篇》：“‘～’，用今天的话说，就是‘责己严，责人宽’，这是一种正确的处世态度。”"},"similar":["责己以周，待人以约"],"opposite":["责人以详，待己以廉"],"usage":"作宾语、定语；用于处事"},{"id":41799,"word":"责己重，待人轻","pinyin":"zé jǐ zhòng，dài rén qīng","abbr":"zjzdrq","explanation":"要求自己严格，对待别人要宽厚","source":{"text":"古之君子，其责己也重以周，其待人也轻以约。重以周，故不怠；轻以约，故人乐为善。","book":"唐·韩愈《原毁》"},"similar":["责己重以周，待人轻以约"],"opposite":["责人以详，待己以廉"],"usage":"作宾语、定语；用于处事"},{"id":41800,"word":"责无旁贷","pinyin":"zé wú páng dài","abbr":"zwpd","explanation":"贷：推卸。自己应尽的责任，不能推卸给旁人。","source":{"text":"讲到护送，除了自己一身之外，责堪旁贷者再无一人。","book":"清·文康《儿女英雄传》第十回"},"example":{"text":"农民向国家交售征购粮是～的任务。"},"similar":["义不容辞","当仁不让","在所不辞"],"opposite":["推三阻四"],"usage":"作谓语、定语、状语；指应该这样"},{"id":41801,"word":"责有所归","pinyin":"zé yǒu suǒ guī","abbr":"zysg","explanation":"指责任有所归属。","source":{"text":"二司掌印官并该道分巡官，不时巡视闸点，毋得视常虚应故事，傥致疏失，责有所归。","book":"明·王守仁《行江西布按二司看守宁府库藏》"},"example":{"text":"那堪中途脱夘，旋且待罪军门，～，难委之某甲某乙。","book":"清·徐述夔《快士传》第十三卷"},"similar":["责有攸归"],"usage":"作宾语、定语；用于书面语"},{"id":41802,"word":"责有攸归","pinyin":"zé yǒu yōu guī","abbr":"zyyg","explanation":"攸：所；归：归属。是谁的责任，就该归谁承担。指份内的责任不容推卸。","source":{"text":"先有司，然后纲纪立，到责有所归。","book":"宋·朱熹《答陈允夫》"},"example":{"text":"至于疆臣守土，～，等马尾开仗的情形，有了详细奏报，必得要论是非，定功罪。","book":"高阳《清宫外史》下册"},"similar":["责无旁贷","责有所归"],"opposite":["漠不相关"],"usage":"作谓语、分句；用于书面语"},{"id":41803,"word":"责躬引咎","pinyin":"zé gōng yǐn jiù","abbr":"zgyj","explanation":"躬：自身；引咎：承认过失。主动承担错误的责任并作自我批评。","source":{"text":"权信任校事吕壹，壹性苛惨，用法深刻。太子登数谏，权不纳，大臣由是莫敢言。后壹奸罪发露伏诛，权引咎自躬。","book":"《三国志·吴志·吴主传》"},"example":{"text":"臣等不能燮理阴阳，而上烦陛下～，愿守散秩以避贤路。","book":"《宋史·五行志》"}},{"id":41804,"word":"责躬省过","pinyin":"zé gōng xǐng guò","abbr":"zgsg","explanation":"躬：自身。责问自身的所作所为，反省过失。","source":{"text":"是年夏，河南四县，雨雹如棬杯，大者如斗，杀禽畜雉兔，折树木，秋苗尽，于是天子责躬自省。","book":"《孔丛子·连丛子》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":41805,"word":"责躬罪己","pinyin":"zé gōng zuì jǐ","abbr":"zgzj","explanation":"责躬：责备自己；罪：归罪。责备自己并归罪于自己。","source":{"text":"壬申，集百寮于大德殿，帝责躬罪己，问以治政得失。","book":"《周书·武帝纪》"},"example":{"text":"伏乞皇上近法列圣，远法禹、汤，时下明诏，～，深痛切至，激厉天下，同雪国耻。（清·康有　《上清帝第二书》）"},"usage":"作谓语、定语、宾语；用于处事"},{"id":41806,"word":"责重山岳","pinyin":"zé zhòng shān yuè","abbr":"zzsy","explanation":"指责任之重如山岳。形容责任重大。","source":{"text":"臣知不惬，物谁谓宜，但命轻鸿毛，责重山岳。","book":"南朝·梁·任昉《为齐明帝让宣城郡公第一表》"},"usage":"作谓语、定语；用于书面语"},{"id":41807,"word":"贤人君子","pinyin":"xián rén jūn zǐ","abbr":"xrjz","explanation":"指有才有德的人。","source":{"text":"凡贤人君子，未尝不思效用，但无其类获进，所以湮没于时。","book":"唐·陈子昂《明必得贤科》"},"similar":["贤才君子"],"usage":"作主语、宾语、定语；指有才有德的人"},{"id":41808,"word":"贤否不明","pinyin":"xián pǐ bù míng","abbr":"xfbm","explanation":"贤否：好坏。好和坏不能分辨。指不明是非好坏。","source":{"text":"虽说施恩不望报，却也不可这般贤否不明。","book":"清·吴敬梓《儒林外史》第三十二回"}},{"id":41809,"word":"贤妻良母","pinyin":"xián qī liáng mǔ","abbr":"xqlm","explanation":"丈夫的好妻子，孩子的好母亲。","source":{"text":"道地的贤妻良母，她是；这里可以看见中国那老味儿。","book":"朱自清《房东太太》"},"example":{"text":"她是一个典型的～。"},"similar":["良母贤妻"],"opposite":["恶妇毒母"],"usage":"作宾语、定语；用于女性"},{"id":41810,"word":"贤才君子","pinyin":"xián cái jūn zǐ","abbr":"xcjz","explanation":"指有才有德的人。","source":{"text":"当今天下之贤才君子，不问少长，皆愿从其游而为之死。","book":"晋·陈寿《三国志·魏志·陈思王植传》裴松之注引《魏略》"},"similar":["贤人君子"],"usage":"作主语、宾语、定语；指有才有德的人"},{"id":41811,"word":"贤母良妻","pinyin":"xián mǔ liáng qī","abbr":"xmlq","explanation":"对丈夫是贤惠的妻子，对子女是慈善的母亲。","source":{"text":"在女子教育，则那里候最时行，常常听到嚷着的，是贤母良妻主义。","book":"鲁迅《坟·寡妇主义》"},"similar":["贤妻良母"],"usage":"作宾语、定语；用于女性"},{"id":41812,"word":"贤者在位，能者在职","pinyin":"xián zhě zài wèi，néng zhě zài zhí","abbr":"xzzwnzzz","explanation":"贤德的人居于掌权的地位，有才干的人担当合适的职务。","source":{"text":"贤者在位，能者在职；国家闲暇，及是时，明其政刑。虽大国，必畏之矣。","book":"《孟子·公孙丑上》"},"example":{"text":"古者明王不宝远物，所宝惟贤，如使～，此皆一人之睿知，贤王之辅成也。","book":"《元史·刘秉忠传》"},"similar":["任贤使能"],"usage":"作定语、分句；用于政务等"},{"id":41813,"word":"贤良方正","pinyin":"xián liáng fāng zhèng","abbr":"xlfz","explanation":"贤良：才能，德行好；方正：正直。汉武帝时推选的一种举荐官吏后备人员的制度，唐宋沿用，设贤良方正科。指德才兼备的好人品。","source":{"text":"当是之时，招尊方正贤良文学之士，或至公卿大夫。","book":"《史记·平准书》"},"example":{"text":"门首都竖着金字匾额，也有写着“～”的，也有写着“孝悌力田”的。","book":"清·李汝珍《镜花缘》第二十三回"},"similar":["贤才君子"],"usage":"作宾语、定语；指有才有德的人"},{"id":41814,"word":"贤贤易色","pinyin":"xián xián yì sè","abbr":"xxys","explanation":"本指对妻子要重品德，不重容貌。后多指尊重贤德的人，不看重女色。","source":{"text":"贤贤易色，事父母能竭其力，事君能致其身。","book":"语出《论语·学而》"},"example":{"text":"公子此时，一来心里不安，二来有些发讪，三来也未免动了点儿～，满面周身闹开了个难的神情儿，共总没得什么话。","book":"《儿女英雄传》"},"usage":"作谓语、宾语；用于处事"},{"id":41815,"word":"贤身贵体","pinyin":"xián shēn guì tǐ","abbr":"xsgt","explanation":"指身分高贵。","source":{"text":"虽有贤身贵体，毋其爵不敢服其服；虽有富家多资，毋其禄有敢用其财。","book":"《管子·立政》"},"usage":"作宾语、定语；用于书面语"},{"id":41816,"word":"败不旋踵","pinyin":"bài bù xuán zhǒng","abbr":"bbxz","explanation":"形容很快就遭到失败。旋踵，转动一下脚后跟。","source":{"text":"然而丧师失律，败不旋踵，奔波谦瓒之间，羁旅袁曹之手，岂拙于用武，将遇非常敌乎？","book":"唐·卢照邻《三国论》"},"example":{"text":"未议致身，先图问鼎，假称伊霍之事，将肆莽卓之心，人神同疾，～。","book":"《北史·杨敷传》"},"similar":["一触即溃"],"opposite":["旗开得胜"],"usage":"作谓语、定语；指很快就失败"},{"id":41817,"word":"败事有余，成事不足","pinyin":"bài shì yǒu yú，chéng shì bù zú","abbr":"bsyycsbz","explanation":"指非但办不好事情，反而常常把事情搞坏。","source":{"text":"此等聚众骚扰的行径，分明是没有教育的人民一时间的冲动罢了！败事有余，成事不足。","book":"茅盾《子夜》九"},"similar":["成事不足，败事有余"],"usage":"作宾语、分句；指事情越来越糟"},{"id":41818,"word":"败于垂成","pinyin":"bài yú chuí chéng","abbr":"bycc","explanation":"指临近成功时遭到失败。参见：“功败垂成”。","source":{"text":"凡事欲成却不成，谓之败于垂成。","book":"宋·无名氏《释常谈·败于垂成》"},"similar":["功败垂成"],"usage":"作谓语、定语；表示惋惜"},{"id":41819,"word":"败井颓垣","pinyin":"bài jǐng tuí yuán","abbr":"bjty","explanation":"犹言房毁墙坍。形容村舍荒凉。","source":{"text":"奔霆飞熛歼人子，败井颓垣剩饿鸠。","book":"鲁迅《集外集·诗》"},"example":{"text":"地震过后，到处都是～。"},"similar":["残垣断壁"],"usage":"作宾语、定语；指破败凄凉的景象"},{"id":41820,"word":"败俗伤化","pinyin":"bài sú shāng huà","abbr":"bssh","explanation":"指败坏社会道德风气。","source":{"text":"侯服玉食，败俗伤化。","book":"《汉书·叙传下》"},"example":{"text":"王夷甫方以盛名处大位，然～，必此人也。","book":"《晋书·羊祜传》"},"similar":["败俗伤风","伤风败俗","毁风败俗"],"usage":"作谓语、定语；多用来遣责道德败坏的行为"},{"id":41821,"word":"败俗伤风","pinyin":"bài sú shāng fēng","abbr":"bssf","explanation":"指败坏社会道德风气。","source":{"text":"参见“败俗伤化”。"},"example":{"text":"行者道：“菩萨，虽是这般故事，奈何他玷污了皇后，～，坏伦乱法，却是该他死罪。”","book":"《西游记》第七一回"},"similar":["败化伤风","伤风败俗","败俗伤化"],"usage":"作谓语、定语；多用来遣责道德败坏的行为"},{"id":41822,"word":"败兴而归","pinyin":"bài xìng ér guī","abbr":"bxeg","explanation":"败兴：遇到和想象不一致的事而情绪低落。扫兴地归来。","source":{"text":"各军士未及领赏，草草而散。正是：乘兴而来，败兴而返。","book":"明·冯梦龙《东周列国志》第一回"},"similar":["败兴而返"],"opposite":["乘兴而来"],"usage":"作谓语、宾语；常与乘兴而来连用"},{"id":41823,"word":"败兵折将","pinyin":"bài bīng zhé jiàng","abbr":"bbzj","explanation":"折：损失。军士和将领都遭到损失。","source":{"text":"袁本初败兵折将。","book":"明·罗贯中《三国演义》第26回"},"similar":["损兵折将","损军折将"],"opposite":["兵不血刃","大获全胜"],"usage":"作谓语、定语；指打了败仗"},{"id":41824,"word":"败军之将","pinyin":"bài jūn zhī jiàng","abbr":"bjzj","explanation":"打了败仗的将领。现多用于讽刺失败的人。","source":{"text":"臣闻败军之将，不可以言勇；亡国之大夫，不可以图存。","book":"《吴越春秋·勾践入臣外传》：“臣闻……败军之将，不敢语勇。”《史记·淮阴侯列传》"},"example":{"text":"～，荷蒙厚恩，无可以报，愿施犬马之劳，不须张弓只箭，径取成都。","book":"明·罗贯中《三国演义》第六十三回"},"similar":["手下败将"],"opposite":["常胜将军"],"usage":"作主语、宾语；指失败之人","story":["楚汉相争时期，汉将韩信率军进攻赵王歇。赵王不听参谋李左车的计策，让韩信用背水列阵的战术大败赵军，并俘虏了李左车。韩信对他特别优待，向他讨教攻燕伐齐的策略。李左车说自己是败军之将不言勇。韩信更加谦虚终于得到他的辅助"]},{"id":41825,"word":"败化伤风","pinyin":"bài huà shāng fēng","abbr":"bhsf","explanation":"指败坏社会道德风气。","source":{"text":"参见“败俗伤化”。"},"example":{"text":"笑你个齐人太妄，可正是～轻薄郎。","book":"明·孙仁孺《东郭记·钻穴隙》"},"similar":["伤化败俗","伤风败俗"],"opposite":["高风亮节"],"usage":"作谓语、定语；指道德败坏的行为"},{"id":41826,"word":"败国丧家","pinyin":"bài guó sàng jiā","abbr":"bgsj","explanation":"使国家沦亡，家庭败落。","source":{"text":"自古败国丧家，未始不由妇人者也。","book":"《晋书·列女传·刘聪妻刘氏》"},"example":{"text":"盖三人皆元戚机臣，其残膏积侈，～，帝特恶焉。","book":"陈衍《元诗纪事·黄菜叶谣》"},"similar":["国破家亡","丧家败国"],"opposite":["民富国强"],"usage":"作谓语、定语；指国破家亡"},{"id":41827,"word":"败国亡家","pinyin":"bài guó wáng jiā","abbr":"bgwj","explanation":"使国家沦亡，家庭败落。","source":{"text":"参见“败国丧家”。"},"example":{"text":"自古以来，因为奸臣陷害忠良，以致～，这种例子也不少。","book":"欧阳予情《忠王李秀成》第一幕"},"similar":["败国丧家"],"opposite":["民富国强"],"usage":"作谓语、定语；指国破家亡"},{"id":41828,"word":"败子回头","pinyin":"bài zǐ huí tóu","abbr":"bzht","explanation":"败家子回心转意，翻然悔悟。","source":{"text":"败子回头便作家，你如今莫去花柳流荡，收心守分。","book":"明·冯梦龙《警世通言》卷三十一"}},{"id":41829,"word":"败子回头金不换","pinyin":"bài zǐ huí tóu jīn bù huàn","abbr":"bzhtjbh","explanation":"指不干正事的人改邪归正比金子还可贵。","source":{"text":"常言道：败子回头金不换。","book":"京剧《粉妆楼》第六本"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“‘～金不换！’胡雪岩举杯相敬，‘罗老爷，一个人就怕不发愤。’”"},"similar":["浪子回头金不换"],"usage":"作宾语、定语；用于夸奖有过失改正的人"},{"id":41830,"word":"败家子","pinyin":"bài jiā zǐ","abbr":"bjz","explanation":"指任意挥霍家产的不成器的子弟或任意浪费国家财物的人。","source":{"text":"你们这些败家子！只顾自己往上爬，弄虚作假，瞒上欺下！","book":"陈登科《破壁记》"},"example":{"text":"你这个～竟干这等事来。"},"usage":"作主语、宾语、定语；指极其浪费的人"},{"id":41831,"word":"败寇成王","pinyin":"bài kòu chéng wáng","abbr":"bkcw","explanation":"失败者沦为草寇，成功的人称王称帝。","source":{"text":"败寇成王谁定论？恩牛怨李此旁观。","book":"柳亚子《题莽男儿‘说部’为陈巢男作》"},"similar":["成王败寇"],"usage":"作宾语、定语；用于人"},{"id":41832,"word":"败将残兵","pinyin":"bài jiàng cán bīng","abbr":"bjcb","explanation":"指战败后剩余的兵将。同“残兵败将”。","source":{"text":"你虽然杀了我一阵，你的军兵可也尽皆折损了，则剩下这一枝败将残兵。","book":"明·无名氏《开诏救忠》楔子"},"similar":["残兵败将"],"opposite":["常胜将军"],"usage":"作宾语、定语；用于指被击溃的军队或势力"},{"id":41833,"word":"败德辱行","pinyin":"bài dé rǔ xíng","abbr":"bdrx","explanation":"败坏道德和操守。","example":{"text":"从古到今，人们总是唾弃那些～的人。"},"usage":"作谓语、定语；用于责备人"},{"id":41834,"word":"败材伤锦","pinyin":"bài cái shāng jǐn","abbr":"bcsj","explanation":"比喻用非其人，伤害国家。","source":{"text":"子有美锦，不使人学制焉。大官大邑，……而使学者制焉。其为美锦，不亦多乎？","book":"《孟子·梁惠王下》：“工师得大木，则王喜，以为能胜其任也。匠人斫而小之，则王怒，以为不胜其任矣。”《左传·襄公三十一年》"},"example":{"text":"今公卿大位莫非戎陈，尚书显官皆出庸伍……臣非有憎疾以求进也，但为陛下惜此举厝。～，所宜至虑。","book":"《后汉书·刘玄传》"},"usage":"作宾语、定语；用于劝谏"},{"id":41835,"word":"败柳残花","pinyin":"bài liǔ cán huā","abbr":"blch","explanation":"败：衰败。残：凋残。凋残的柳树，残败了的花。旧时用以比喻生活放荡或被蹂躏遗弃的女子。","source":{"text":"他是个女孩儿家，你索将性儿温存……休猜做败柳残花。","book":"元·王实甫《西厢记》第三本第三折"},"example":{"text":"元·王实甫《西厢记》第三本第三折：“他是个女孩儿家，你索将性儿温存……休猜做败柳残花。”"},"similar":["残花败柳"],"opposite":["金枝玉叶"],"usage":"作宾语；用于女性"},{"id":41836,"word":"败法乱纪","pinyin":"bài fǎ luàn jì","abbr":"bflj","explanation":"败坏法令，扰乱纪律。","source":{"text":"便放志专行，威劫省禁，卑侮王僚，败法乱纪，坐召三台，专制朝政。","book":"南朝·宋·范晔《后汉书·袁绍传》"},"example":{"text":"我们要严厉打击那些～之徒。"},"similar":["违法乱纪"],"opposite":["遵纪守法"],"usage":"作谓语、定语；指不守法"},{"id":41837,"word":"败笔成丘","pinyin":"bài bǐ chéng qiū","abbr":"bbcq","explanation":"用坏的笔堆得象小山丘一样。形容书法精良或著述甚多。","source":{"text":"君子此艺亦云至，堆墙败笔如山得。","book":"宋·苏轼《石苍舒醉墨堂》"}},{"id":41838,"word":"败绩失据","pinyin":"bài jì shī jù","abbr":"bjsj","explanation":"指事业失败而无所凭依。","source":{"text":"历数世，未尝有败绩失据之过。","book":"宋·叶绍翁《四朝闻见录贤良续刻第三则》"},"example":{"text":"及今年内几经～，犹复漠然无所动于中。","book":"梁启超《敬告国中之说实业者》"},"usage":"作谓语、定语；指失败"},{"id":41839,"word":"败鳞残甲","pinyin":"bài lín cán jiǎ","abbr":"blcj","explanation":"败：毁坏。残败零碎的鳞甲，比喻满空飞舞的雪花。","source":{"text":"战退玉龙三百万，败鳞残甲满空飞。","book":"宋·张元《咏雪》"},"usage":"作宾语；比喻纷飞的雪花"},{"id":41840,"word":"败鼓之皮","pinyin":"bài gǔ zhī pí","abbr":"bgzp","explanation":"败：破旧。破鼓皮可作药材。比喻虽微贱，却是有用的东西。","source":{"text":"牛溲马勃，败鼓之皮，俱收并蓄，待用无遗者，医师之良也。","book":"唐·韩愈《进学解》"},"example":{"text":"～，物尽其用。"},"similar":["牛溲马勃"],"usage":"作宾语；指不起眼的小东西"},{"id":41841,"word":"货真价实","pinyin":"huò zhēn jià shí","abbr":"hzjs","explanation":"货物不是冒牌的，价钱也是实在的。形容实实在在，一点不假。","source":{"text":"但不知可有‘货真价实，童叟无欺’的字样没有？","book":"清·吴趼人《二十年目睹之怪现状》第五回"},"example":{"text":"她现在要求再念一遍时的不笑倒是～的热心。","book":"茅盾《无题》"},"similar":["名副其实","名不虚传"],"opposite":["货次价高","徒有虚名"],"usage":"作宾语、定语；用于人或事物"},{"id":41842,"word":"货而不售","pinyin":"huò ér bù shòu","abbr":"hebs","explanation":"想卖却卖不出去。货：卖。","source":{"text":"丘之小不能一亩，可以笼而有之。问其主，曰：‘唐氏之弃地，货而不售。’问其价，曰：‘止四百。’予怜而售之。","book":"唐·柳宗元《永州八记·钴姆潭西小丘记》"}},{"id":41843,"word":"货贿公行","pinyin":"huò huì gōng xíng","abbr":"hhgx","explanation":"指公开行贿受赂。同“贿赂公行”。","source":{"text":"货贿公行，帑藏损耗，神怒民怨，众叛亲离。","book":"《魏书·刑罚志》：“天平后，迁移草创，百司多不奉法，货贿公行。”《陈书·傅縡传》"},"example":{"text":"时盗贼蜂起，百姓饥馑，玄竟不能救恤，而官方坏乱，～。","book":"《隋书·卫玄传》"},"similar":["货赂公行"],"usage":"作谓语、宾语、定语；指公开以货财进行行贿"},{"id":41844,"word":"货赂公行","pinyin":"huò lù gōng xíng","abbr":"hlgx","explanation":"赂：贿赂；公行：公开。公开用金钱、财物收买别人进行不正当的活动。","source":{"text":"三公倾邪，皆希世见用，货赂并行，强者为怨，不见举奏，弱者守道，多被陷毁。","book":"《魏书》"},"example":{"text":"～，帑藏损耗，神怒民怨，众叛亲离。","book":"《陈书·傅縡传》"},"similar":["贿赂公行"],"usage":"作谓语、宾语；指公开以货财进行行贿"},{"id":41845,"word":"货赂大行","pinyin":"huò lù dà xíng","abbr":"hldx","explanation":"指公开行贿受赂。同“贿赂公行”。","source":{"text":"不贵礼义，故士无风节；货赂大行，故俗尚倾夺。","book":"宋·刘攽、刘恕等《〈魏书〉目录序》"},"similar":["货贿公行","货赂公行"],"usage":"作谓语、宾语、定语；指公开以货财进行行贿"},{"id":41846,"word":"质伛影曲","pinyin":"zhì yǔ yǐng qū","abbr":"zyyq","explanation":"身体伛偻影子也就弯曲。比喻有因必有果。","source":{"text":"质伛影曲，报应宜然。","book":"《太平广记》卷第三百八十八引唐·李玫《纂异记·齐君房》"},"usage":"作宾语、定语；用于书面语"},{"id":41847,"word":"质妻鬻子","pinyin":"zhì qī yù zǐ","abbr":"zqyz","explanation":"质：抵押。因生活极端贫困而把妻子抵押，儿子出卖。","source":{"text":"隳家破产，质妻鬻子，仅以自免。","book":"宋·陆子渊《与辛幼安书》"},"usage":"作谓语、定语；用于书面语"},{"id":41848,"word":"质木无文","pinyin":"zhì mù wú wén","abbr":"zmww","explanation":"指诗文质朴而少文采。也用以形容人品朴实无华。","source":{"text":"东京二百载中，惟班固《咏史》，质木无文。","book":"南朝·梁·钟嵘《诗品·总论》"}},{"id":41849,"word":"质朴无华","pinyin":"zhì pǔ wú á","abbr":"zpwh","explanation":"质朴：朴实；华：浮华。朴实而不浮夸。","example":{"text":"可是他一招一式全是平平无奇，于～之中现极大能耐。（金庸《天龙八部》第二十回）"},"similar":["朴实无华"],"usage":"作谓语、定语；用于书面语"},{"id":41850,"word":"质疑辨惑","pinyin":"zhì yí biàn huò","abbr":"zybh","explanation":"指提出疑问，请人解答并加以研究、辨析。","source":{"text":"［张彦清］初从朱子游，得其大旨，后与李公吕质疑辨惑，造谐益深。","book":"明·朱衡《道南源委》卷三"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":41851,"word":"质疑问难","pinyin":"zhì yí wèn nàn","abbr":"zywn","explanation":"质疑：请人解答疑难；癌难：对于疑问反复讨论、分析或辩论。提出疑难，请教别人或一起讨论。","source":{"text":"竦居贫，无宾客，时有好事者从之质疑问事，论道经书而已。","book":"《汉书·陈遵传》"},"example":{"text":"我们数学老师讲课生动活泼，常常采用～和方法。"},"similar":["质疑辨惑"],"usage":"作谓语、定语；用于人好思"},{"id":41852,"word":"质直浑厚","pinyin":"zhì zhí hún hòu","abbr":"zzhh","explanation":"质朴厚重。常用以形容诗文书画的笔力、风格。","source":{"text":"语多质直浑厚，计应似其为人。","book":"宋·胡仔《苕溪渔隐丛话前集·韩吏部下》"},"usage":"作谓语、定语；用于书面语"},{"id":41853,"word":"质而不俚","pinyin":"zhì ér bù lǐ","abbr":"zebl","explanation":"质：朴素、单纯。俚：粗俗。质朴而不粗俗。亦作“质而不野”。","source":{"text":"然自刘向、扬雄博极群书，皆称迁有良史之材，服其善序事理，辨而不华，质而不俚，其文直，其事核，不虚美，不隐恶，故谓之实录。","book":"《汉书·司马迁传赞》"},"example":{"text":"《孔雀东南飞》～，乱而能整，叙事如画，叙情若诉，长篇之圣也。","book":"明·王世贞《艺苑卮言》卷二"},"similar":["质而不野"],"usage":"作谓语、定语；用于书面语"},{"id":41854,"word":"质而不野","pinyin":"zhì ér bù yě","abbr":"zeby","explanation":"质：朴素、单纯。野：粗俗。质朴而不粗俗。同“质而不俚”。","source":{"text":"然善述序事理，辩而不华，质而不野，文质相称，盖良史之才也。","book":"《后汉书·班彪传上》"},"similar":["质而不俚"],"usage":"作谓语、定语；用于书面语"},{"id":41855,"word":"质非文是","pinyin":"zhì fēi wén shì","abbr":"zfws","explanation":"徒有华美的外表，而无相应的实质。","source":{"text":"其文是也，其质非也……羊质而虎皮，见草而说，见豺而战，忘其皮之虎矣。","book":"汉·扬雄《法言·吾子》"},"example":{"text":"～终难久，脱冠还作扶犁叟。","book":"宋·苏轼《又一首答二犹子与王郎见和》"},"similar":["华而不实"],"usage":"作谓语、定语；指虚有其表"},{"id":41856,"word":"贩交买名","pinyin":"fàn jiāo mǎi míng","abbr":"fjmm","explanation":"指卖友求荣。","source":{"text":"贩交买名之薄，吮痈舐痔之卑。","book":"南朝·宋·鲍照《瓜步山楬文》"},"similar":["卖友求荣"],"usage":"作谓语、定语；用于比喻句"},{"id":41857,"word":"贩夫俗子","pinyin":"fàn fū sú zǐ","abbr":"ffsz","explanation":"贩夫：指贩卖货物的小商人。泛指商贩等下层平民。","source":{"text":"况且刘员外是个为客的人，贩夫俗子，教我怎生伴着他。","book":"明·顾大典《青衫记·茶客娶兴》"},"similar":["贩夫皂隶"],"usage":"作宾语、定语；指平民"},{"id":41858,"word":"贩夫皁隶","pinyin":"fàn fū yě lì","abbr":"ffzl","explanation":"泛指社会地位低下的人。"},{"id":41859,"word":"贩夫皂隶","pinyin":"fàn fū zào lì","abbr":"ffzl","explanation":"泛指社会地位低下的人。","source":{"text":"金的所以腰斩《水浒》修改《水浒》，为的是不愿‘贩夫皂隶都看’。","book":"王古鲁《本书的介绍》"},"similar":["贩夫走卒","平民百姓"],"opposite":["达官贵人"],"usage":"作宾语、定语；指一般老百姓"},{"id":41860,"word":"贩夫贩妇","pinyin":"fàn fū fàn fù","abbr":"ffff","explanation":"旧称小商小贩。","source":{"text":"夕市，夕时而市，贩夫贩妇为主。","book":"《周礼·地官·司市》"},"example":{"text":"夫一忍一朝之诟，而以收功于数稔之后者，斯哲人所以异于～之智也。","book":"章炳麟《上李鸿章书》"},"similar":["小商小贩"],"usage":"作主语、宾语、定语；指小商小贩"},{"id":41861,"word":"贩夫走卒","pinyin":"fàn fū zǒu zú","abbr":"ffzz","explanation":"旧指小贩和差役。泛指旧社会里地位低下者。","source":{"text":"通国无不识字的百姓，即贩夫走卒也都通晓天下大势。","book":"曾朴《孽海花》第18回"},"example":{"text":"向来眼高于顶，岂可与这些～为伍？","book":"徐兴业《金殴缺》第25章"},"similar":["贩夫贩妇","贩夫驺卒"],"opposite":["达官贵人"],"usage":"作宾语、定语；指社会地位低下的人"},{"id":41862,"word":"贩夫驺卒","pinyin":"fàn fū zōu zú","abbr":"ffzz","explanation":"小商贩和隶役。泛指地位低下的人。","source":{"text":"以故大江之南，大河之北，南至闽粤，北至山海关、热河，贩夫驺卒，皆知王举人。","book":"清·龚自珍《王仲瞿墓表铭》"},"example":{"text":"～的生活一样也很踏实。"},"similar":["贩夫走卒"],"opposite":["达官贵人"],"usage":"作宾语、定语；指社会地位低下的人"},{"id":41863,"word":"贩官鬻爵","pinyin":"fàn guān yù jué","abbr":"fgyj","explanation":"鬻：卖；爵：爵位，官爵。出卖官爵，以敛取财物。","source":{"text":"国命朝权，尽移近习，贩官鬻爵，贿货公行。","book":"《梁书·武帝纪》"},"example":{"text":"兵食资储，敛为私积；～，威恣百城。","book":"《魏书·司马叡传》"},"usage":"作谓语、宾语、定语；用于官场"},{"id":41864,"word":"贩贱卖贵","pinyin":"fàn jiàn mài guì","abbr":"fjmg","explanation":"指低价买进而高价卖出。同“买贱卖贵”。","source":{"text":"吕不韦者，阳崔大贾人也，往来贩贱卖贵，家累千金。","book":"《史记·吕不韦列传》"},"similar":["贱买贵卖"],"usage":"作宾语、定语；指经商"},{"id":41865,"word":"贪人败类","pinyin":"tān rén bài lèi","abbr":"trbl","explanation":"败：毁坏。贪婪的人当政，危及整个国家、民族。","source":{"text":"大风有遂，贪人败类。","book":"《诗经·大雅·桑柔》"},"example":{"text":"臣闻天吏逸德，烈于猛火；～，取兴大风。","book":"《旧唐书·魏知古传》"}},{"id":41866,"word":"贪位取容","pinyin":"tān wèi qǔ róng","abbr":"twqr","explanation":"贪图权位，讨好上司。","source":{"text":"不料姚、宋亡后，满朝臣宰，一味贪位取容。","book":"清·洪昇《长生殿·献饭》"},"usage":"作谓语、定语；用于处事"},{"id":41867,"word":"贪位慕禄","pinyin":"tān wèi mù lù","abbr":"twml","explanation":"贪恋权位，羡慕俸禄。","source":{"text":"兵部尚书王镇，保邦致治，有拨乱反正之才，解组归闲，无贪位慕禄之行。","book":"元·施惠《幽闺记·洛珠双合》"},"example":{"text":"清·褚人获《隋唐演义》第87回：“这些～趋炎附势之徒，奔走其门如市。”"},"similar":["贪权慕禄"],"usage":"作谓语、定语、宾语；用于处世等"},{"id":41868,"word":"贪冒荣宠","pinyin":"tān mào róng chǒng","abbr":"tmrc","explanation":"贪冒：贪图。贪图荣耀和恩宠。","source":{"text":"任经十有三年，竟无一阶升录，臣之驽劣，于此可见。而贪冒荣宠，尚不知归。","book":"唐·陈子昂《为程处弼辞放流表》"},"similar":["贪荣冒宠"],"usage":"作谓语、定语；用于处世"},{"id":41869,"word":"贪利忘义","pinyin":"tān lì wàng yì","abbr":"tlwy","explanation":"贪求财利，忘却道义。","source":{"text":"我是此间良人家女儿，在姜秀才家为妾，大娘不容。后来连秀才贪利忘义，竟把来卖与这郑妈妈家了。","book":"明·凌濛初《初刻拍案惊奇·姚滴珠避羞惹羞》"},"example":{"text":"清·褚人获《隋唐演义》第53回：“邴醒元真～小人，反置之左右。”"},"similar":["见利忘义"],"opposite":["见利思义","仗义疏财"],"usage":"作谓语、宾语、定语；指人见钱眼开"},{"id":41870,"word":"贪功起衅","pinyin":"tān gōng qǐ xìn","abbr":"tgqx","explanation":"贪图功绩，有意挑起事端。","source":{"text":"孟明等贪功起衅，妄动干戈，使两国恩变为怨。","book":"明·冯梦龙《东周列国志》第四十五回"},"example":{"text":"《清史稿·属国·缅甸》：“鄂宁复奏应琚～，为朱仑等讳饰，又不令汤聘。”"},"usage":"作谓语、定语；用于书面语"},{"id":41871,"word":"贪吃懒做","pinyin":"tān chī lǎn zuò","abbr":"tclz","explanation":"好吃而不肯好好工作。","source":{"text":"看他如此今吃懒做，真象有磨子在肚子里牵的一般。","book":"清·张南庄《何典》第七回"},"example":{"text":"胡祖德《沪谚外遍·新妇歌》：“～搬嘴舌，登在婆家淘气过时光。”"},"similar":["好吃懒做"],"usage":"作谓语、定语、宾语；形容嘴馋身懒"},{"id":41872,"word":"贪名图利","pinyin":"tān míng tú lì","abbr":"tmtl","explanation":"贪图好的名声，追逐个人私利。","source":{"text":"贪名图利世间人，不修因果恁痴心。","book":"明·徐元《八义记》第二十四出"},"example":{"text":"世人～，至死不休。","book":"清·陈忱《水浒后传》第三十回"},"similar":["贪名逐利"],"usage":"作谓语、定语；用于处世"},{"id":41873,"word":"贪名逐利","pinyin":"tān míng zhú lì","abbr":"tmzl","explanation":"贪图好的名声，追逐个人私利。","source":{"text":"老夫当初也只道你贪名逐利，撇了父母妻室，不肯还家。","book":"明·高明《琵琶记·旌表》"},"similar":["贪名图利"],"usage":"作谓语、定语；用于处世"},{"id":41874,"word":"贪吏猾胥","pinyin":"tān lì huá xū","abbr":"tlhx","explanation":"猾胥：狡诈的小官。贪财狡诈的小官吏。","source":{"text":"先帝本意使民产率出钱专力于农，虽有贪吏猾胥，无所施其虐。","book":"宋·苏轼《辩试馆策问札子》之二"},"usage":"作宾语、定语；用于书面语"},{"id":41875,"word":"贪图安逸","pinyin":"tān tú ān yì","abbr":"ttay","explanation":"追求个人享受。","example":{"text":"我们不能～而放弃追求。"},"opposite":["吃苦耐劳"],"usage":"作谓语、宾语；指追求个人享受"},{"id":41876,"word":"贪墨之风","pinyin":"tān mò zhī fēng","abbr":"tmzf","explanation":"贪墨：贪财。贪图财利的风气。形容吏治腐败。","source":{"text":"贪以败官为墨。","book":"春秋·鲁·左丘明《左传·昭公十四年》"},"example":{"text":"四方习～，而闾阎曰以愁困。","book":"《明史·赵锦传》"},"usage":"作宾语；指吏治腐败"},{"id":41877,"word":"贪墨成风","pinyin":"tān mò chéng fēng","abbr":"tmcf","explanation":"墨：不洁；贪墨：官吏受贿。官吏贪污受贿的风气盛行。形容吏治腐败。","source":{"text":"贪以败官为墨。","book":"《左传·昭公十四年》"},"usage":"作谓语、定语；用于书面语"},{"id":41878,"word":"贪墨败度","pinyin":"tān mò bài dù","abbr":"tmbd","explanation":"贪图财利，败坏法度。","source":{"text":"田敏屡有战功，而贪墨败度，幸容于时。","book":"《宋史·田敏等传论》"},"usage":"作谓语、定语；用于书面语"},{"id":41879,"word":"贪声逐色","pinyin":"tān shēng zhú sè","abbr":"tszs","explanation":"贪恋歌舞，追逐女色。形容生活放荡。","source":{"text":"始从怀妊至孾孩，长得身躯六尺才。弃德背恩行不孝，贪声逐色纵心怀。","book":"《敦煌变文集·父母恩重经讲经文》"},"usage":"作谓语、宾语、定语；用于生活"},{"id":41880,"word":"贪多务得","pinyin":"tān duō wù dé","abbr":"tdwd","explanation":"贪：求多；务：务必。原指学习上务求尽多地获得知识。后泛指对其他事物贪多并务求取得。","source":{"text":"贪多务得，细大不捐。","book":"唐·韩愈《进学解》"},"example":{"text":"而泛观古人之文，则又博而寡要，且惧夫～，而遂溺于文。","book":"清·方宗诚《古文简要序》"},"similar":["欲速不达"],"usage":"作谓语；指贪求多而志在必得","story":["唐朝散文家韩愈24岁中进士到京城长安做官，他在官场不得志，45岁时被贬回长安任国子监博士。他给学生讲课旁征博引，出口成章，很有欢迎。他在《进学解》中强调：“业精于勤荒于嬉，行成于思毁于随。”对待学业不能贪多务得"]},{"id":41881,"word":"贪多嚼不烂","pinyin":"tān duō jiáo bù làn","abbr":"tdjbl","explanation":"贪图多吃，消化不了。比喻工作或学习，图多而做不好或吸收不了。","source":{"text":"而今孩子何在？正是贪多嚼不烂了。","book":"明·凌濛初《二刻拍案惊奇》卷五"},"example":{"text":"虽说是奋志要强，那工课宁可少些，一则～，二则身子也要保重。（清·曹雪芹《红楼梦》第九回）"},"similar":["大包大揽"],"opposite":["适可而止"],"usage":"作宾语、分句；用于工作或学习","story":["贾宝玉起来要去上学，袭人服侍好他梳洗，宝玉故意逗袭人开心。袭人劝他好好读书，说不读书会潦倒一辈子，要他念书时好好想着书本，但不要过分发奋图强，功课不能贪多，一则贪多嚼不烂，二则累坏了身子，宝玉有口无心地答应她"]},{"id":41882,"word":"贪大求全","pinyin":"tān dà qiú quán","abbr":"tdqq","explanation":"过分地贪图规模大而全面。","example":{"text":"我们选择上项目时，不能盲目～。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":41883,"word":"贪大求洋","pinyin":"tān dà qiú yáng","abbr":"tdqy","explanation":"洋：指外国的。贪图大的和外国的。指不根据实际情况而追求规模大的或国外的做法。"},{"id":41884,"word":"贪天之功","pinyin":"tān tiān zhī gōng","abbr":"ttzg","explanation":"贪：贪图。把天所成就的功绩说成是自己的力量。现指抹杀群众或领导的力量，把功劳归于自己。","source":{"text":"窃人之财，犹谓之盗，况贪天之功，以为己力乎？","book":"《左传·僖公二十四年》"},"example":{"text":"岂敢～，遂尔僭妄。","book":"清·陈忱《水浒后传》第三十四回"},"usage":"作宾语；指攘夺他人的功劳","story":["晋国公子重耳流亡19年后重新回国执政，成为晋文公。他对跟随他流亡的人论功行赏。唯独把割大腿肉熬汤给他喝的介子推给忘了。介子推很有气节，他称病回家隐居，侍奉老母，靠编草鞋为生，他认为那些受到奖赏的人是在贪上天的功劳"]},{"id":41885,"word":"贪天之功以为己力","pinyin":"tān tiān zhī gōng yǐ wéi jǐ lì","abbr":"ttzgywjl","explanation":"贪：把别人的东西占为己有。把自然成功的事作为自己的功劳。现指攘夺他人的功劳。","source":{"text":"窃人之财，犹谓之盗，况贪天之功以为己力乎。","book":"春秋·鲁·左丘明《左传·僖公二十四年》"},"similar":["贪天之功以为己有"],"usage":"作宾语、定语；用于处事","story":["晋国公子重耳流亡19年后重新回国执政，成为晋文公。他对跟随他流亡的人论功行赏。唯独把割大腿肉熬汤给他喝的介子推给忘了。介子推很有气节，他称病回家隐居，侍奉老母，靠编草鞋为生，他认为那些受到奖赏的人是在贪上天的功劳"]},{"id":41886,"word":"贪天之功以为己有","pinyin":"tān tiān zhī gōng yǐ wéi jǐ yǒu","abbr":"ttzgywjy","explanation":"贪：把别人的东西占为己有。把自然成功的事作为自己的功劳。现指攘夺他人的功劳。","source":{"text":"然则光贪天之功以为己有，与夫日僤之割爱，邴吉之让位，德不侔矣。","book":"宋·王禹偁《霍光论》"},"usage":"作宾语、定语；用于处事"},{"id":41887,"word":"贪天之功，以为己力","pinyin":"tān tiān zhī gōng，yǐ wéi jǐ lì","abbr":"ttzgywjl","explanation":"贪：贪图。把天所成就的功绩说成是自己的力量。现指抹杀群众或领导的力量，把功劳归于自己。","source":{"text":"窃人之财，犹谓之盗，况贪天之功，以为己力乎？","book":"《左传·僖公二十四年》"},"example":{"text":"这数语是言清廷必亡，袁项城只～耳。","book":"蔡东藩、许廑父《民国通俗演义》第一回"}},{"id":41888,"word":"贪夫徇利","pinyin":"tān fū xùn lì","abbr":"tfxl","explanation":"徇：通“殉”，以身从物。贪财的人为财利送命。形容人爱财如命。","source":{"text":"尝市大木筑室，将伐，贪夫徇利，造辞以争，因以让之，不以为弱。","book":"元·揭傒斯《逸士徐君墓志铭》"},"similar":["贪夫殉利","贪夫徇财"],"usage":"作宾语、定语；用于书面语"},{"id":41889,"word":"贪夫徇财","pinyin":"tān fū xùn cái","abbr":"tfxc","explanation":"徇：通“殉”。徇财：不顾性命以求财。爱财的人愿意为了钱财而死。形容人爱财如命。","source":{"text":"烈士徇名，贪夫徇财，至博不给，知时何羞。","book":"《鹖冠子·世兵》"},"example":{"text":"～，有死无二。","book":"唐·李商隐《太仓箴》"},"similar":["人为财死","爱财如命"],"usage":"作宾语；指爱财如命"},{"id":41890,"word":"贪夫殉利","pinyin":"tān fū xùn lì","abbr":"tfxl","explanation":"形容人爱财如命。同“贪夫狥利”。","source":{"text":"贪夫殉利，箪豆见色。春秋争弑，不顾骨肉。”","book":"明·冯梦龙《东周列国志》第73回"},"similar":["贪夫徇利","贪夫徇财"],"usage":"作宾语、定语；用于书面语"},{"id":41891,"word":"贪夫狥利","pinyin":"tān fū yě lì","abbr":"tfxl","explanation":"形容人爱财如命。同“贪夫徇财”。"},{"id":41892,"word":"贪夫狥财","pinyin":"tān fū huái cái","abbr":"tfxc","explanation":"形容人爱财如命。同“贪夫徇财”。"},{"id":41893,"word":"贪夫猣利","pinyin":"tān fū yě lì","abbr":"tfyl","explanation":"形容人爱财如命。同贪夫徇财”。"},{"id":41894,"word":"贪夫猣财","pinyin":"tān fū huái cái","abbr":"tfhc","explanation":"形容人爱财如命。同贪夫徇财”。"},{"id":41895,"word":"贪如虎狼","pinyin":"tān rú hǔ láng","abbr":"trhl","explanation":"像猛虎恶狼一般贪得无厌。","source":{"text":"心行贪如虎狼。","book":"宋·释道原《景德传灯录》卷二十九"},"similar":["贪得无厌","贪如饕餮"],"usage":"作谓语、定语；用于比喻句"},{"id":41896,"word":"贪如饕餮","pinyin":"tān rú tāo tiè","abbr":"trtt","explanation":"饕餮：传说中一种贪食的恶兽。比喻贪婪凶恶的人。","source":{"text":"而缙绅贪如饕餮，以百姓为鱼肉；官兵凶逾虎狼，视良民为仇敌。","book":"姚雪垠《李自成》第一卷第29回"},"example":{"text":"而缙绅～，以百姓为鱼肉；官兵凶逾虎狼，视良民为仇敌。","book":"姚雪垠《李自成》第一卷第二十九章"},"similar":["贪如虎狼"],"usage":"作谓语、定语；用于比喻句"},{"id":41897,"word":"贪婪无厌","pinyin":"tān lán wú yàn","abbr":"tlwy","explanation":"厌：满足。贪心永远没有满足的时候。","source":{"text":"贪婪无餍，忿类无期。","book":"《左传·昭公二十八年》"},"example":{"text":"明·程登吉《幼学琼林》第三卷：“贤否罹害，如玉石俱焚；～，虽锱铢必较。”"},"similar":["贪婪无餍","贪得无厌","贪残无厌"],"opposite":["知足常乐"],"usage":"作谓语、定语；形容人的贪婪"},{"id":41898,"word":"贪婪无餍","pinyin":"tān lán wú yàn","abbr":"tlwy","explanation":"贪婪：贪得无厌；餍：满足。贪心永远没有满足的时候。","source":{"text":"贪婪无餍，忿类无期。","book":"春秋·鲁·左丘明《左传·昭公28年》"},"similar":["贪婪无厌","贪得无厌","贪残无厌"],"usage":"作谓语、定语；形容人的贪婪"},{"id":41899,"word":"贪官污吏","pinyin":"tān guān wū lì","abbr":"tgwl","explanation":"贪赃枉法的官吏。","source":{"text":"一应贪官污吏，准许先斩后闻。","book":"元·无名氏《鸳鸯被》第四折"},"example":{"text":"如有真正～，破戒和尚，秽行道士，方许下击。","book":"明·罗贯中《平妖传》第十七回"},"similar":["奸官污吏","赃官污吏"],"opposite":["清正廉明"],"usage":"作主语、宾语、定语；指贪赃枉法的官吏"},{"id":41900,"word":"贪官蠹役","pinyin":"tān guān dù yì","abbr":"tgdy","explanation":"蠹：蛀虫，引申指侵吞公共财物的人。贪图财物的小官及吏役。","source":{"text":"世祖严治贪官蠹役，特立严法，如非官役不用此例。","book":"《清史稿·朱之弼传》"},"similar":["贪官污吏"],"usage":"作宾语、定语；用于书面语"},{"id":41901,"word":"贪小失大","pinyin":"tān xiǎo shī dà","abbr":"txsd","explanation":"因为贪图小便宜而失掉大的利益。比喻只谋求眼前的好处而不顾长远的利益。","source":{"text":"达子……使人请金于齐王，齐王怒曰：‘若残竖子之类，恶能给若金？’与燕人战，大败，达子死，齐王走莒。燕人逐北入国，相与争金于美唐甚多。此贪于小利以失大利者也。","book":"《吕氏春秋·权勋》"},"example":{"text":"这叫做“～”，所以为人切不可做那讨便宜苟且之事！","book":"明·凌濛初《初刻拍案惊奇》卷十六"},"similar":["得不偿失"],"opposite":["乞浆得酒"],"usage":"作谓语、定语；指人不懂算计","story":["战国时期，秦惠文王想吞并物产丰富的蜀国，有人献计造能下金粪的石牛送给蜀侯。蜀侯中计，下令民工开山填谷，铺筑道路迎接石牛，秦惠文王让大军跟在运送石牛的队伍后灭了蜀国。人们嘲笑蜀侯是贪小利而失大利"]},{"id":41902,"word":"贪得无厌","pinyin":"tān dé wú yàn","abbr":"tdwy","explanation":"厌：满足。贪心永远没有满足的时候。","source":{"text":"贪婪无厌，忿类无期。","book":"《左传·昭公二十八年》"},"example":{"text":"他～的性子，随着年岁的增长，更加残忍了。","book":"梁斌《红旗谱》八"},"similar":["得寸进尺","贪心不足"],"opposite":["一尘不染","知足常乐"],"usage":"作谓语、定语；形容人的贪婪","story":["春秋末年，晋国内部六个上卿相互吞并扩充实力。智伯是一个野心勃勃的人，总是处心积虑想扩展自己的势力范围。他想吞并赵襄子，将他围困在晋阳城。赵襄子派人去向韩康子和魏桓子求援。他们都知道智伯贪得无厌就联合出兵攻击他"]},{"id":41903,"word":"贪心不足","pinyin":"tān xīn bù zú","abbr":"txbz","explanation":"贪得无厌，永不满足。","source":{"text":"汝贪心不足！既得吴郡，而又强并吾界！","book":"明·罗贯中《三国演义》第十五回"},"example":{"text":"一个人活到九十岁了，要还有这些忌讳，那就叫～，不知好歹了。","book":"清·文康《儿女英雄传》第三十九回"},"similar":["贪得无厌","贪心无厌"],"opposite":["心满意足"],"usage":"作谓语、定语；指人的需求"},{"id":41904,"word":"贪心妄想","pinyin":"tān xīn wàng xiǎng","abbr":"txwx","explanation":"一心贪求着无法实现的事。","source":{"text":"我看你人生在世不久长，贪心妄想何时用。","book":"明·胡文焕《群音类选·升仙记·设计害愈》"},"usage":"作谓语、宾语、状语；用于处事"},{"id":41905,"word":"贪心无厌","pinyin":"tān xīn wú yàn","abbr":"txwy","explanation":"厌：满足。贪心没有满足的时候。","source":{"text":"同恶相帮，调之助桀为虐；贪心无厌，谓之得陇望蜀。","book":"清·程允升《幼学琼林·人事》"},"example":{"text":"那知霍氏果然觖望，虽得一门三侯，意中尚嫌未足，第一个～的人物，就是光妻霍显。","book":"蔡东藩《前汉演义》第八十二回"},"similar":["贪心不足","贪得无厌"],"usage":"作谓语、定语；指人的需求"},{"id":41906,"word":"贪惏无餍","pinyin":"tān lín wú yàn","abbr":"tlwy","explanation":"贪心永远没有满足的时候。同“贪得无厌”。"},{"id":41907,"word":"贪权慕禄","pinyin":"tān quán mù lù","abbr":"tqml","explanation":"贪恋权位，羡慕俸禄。","source":{"text":"若不能然，则是贪位慕禄而已矣。","book":"宋·朱熹《孟子集注·万章下》"},"similar":["贪位慕禄"],"usage":"作谓语、定语、宾语；用于处世等"},{"id":41908,"word":"贪权窃柄","pinyin":"tān quán qiè bǐng","abbr":"tqqb","explanation":"贪图权势，窃取权位。","source":{"text":"侈心一萌，邪道并进。贪权窃柄者则曰：‘德如尧舜矣，焉用劳神。’","book":"唐·陆贽《奉天论延访朝臣表》"},"usage":"作谓语、定语；用于处事"},{"id":41909,"word":"贪欢逐乐","pinyin":"tān huān zhú lè","abbr":"thzl","explanation":"逐：追逐。无休止地寻欢作乐。形容生活放荡。","source":{"text":"贪欢逐乐无时歇，批论摴蒲。","book":"《敦煌变文集·父母恩重经讲经文》"},"example":{"text":"频频满酌醉如泥，轻轻更换金卮，尽日～。此是富不归。","book":"《敦煌曲子词·长相思》"},"similar":["寻欢作乐"],"usage":"作谓语、定语；用于处世"},{"id":41910,"word":"贪欲无厌","pinyin":"tān yù wú yàn","abbr":"tywy","explanation":"犹言贪得无厌。贪心永远没有满足的时候。","source":{"text":"夫高，故贱人也，无识于理，贪欲无厌，求利不止，列势次主，求欲无穷，臣故曰殆。","book":"西汉·司马迁《史记·李斯列传》"},"example":{"text":"蒲韧《二千年间》：“他们又终于成为从内部来腐蚀整个统治集团的～的蛀虫。”"},"similar":["贪欲无艺"],"usage":"作谓语、定语；用于书面语"},{"id":41911,"word":"贪欲无艺","pinyin":"tān yù wú yì","abbr":"tywy","explanation":"欲：欲望；艺：标准、准则，引申为法度、限度。贪求财物的欲望没有限度。指反动的统治阶级无限制地搜刮民财。","source":{"text":"及桓子，骄泰奢侈，贪欲无艺，略则行志，假贷居贿，宜及于难。","book":"《国语·晋语八》"},"similar":["贪贿无艺"],"usage":"作谓语、宾语；用于书面语","story":["春秋时期，晋国人叔向去拜访卿韩宣子。韩宣子说他名义上是卿而实际上财富很少，叔向向他祝贺，他感到奇怪。叔向说以前栾武子做上卿时家里只有一个仆人和百十顷田，人们都尊敬他，而他的儿子桓子继卿位贪财受贿，差一点招来杀身之祸"]},{"id":41912,"word":"贪残无厌","pinyin":"tān cán wú yàn","abbr":"tcwy","explanation":"厌：满足。贪心永远没有满足的时候。","source":{"text":"而罔思寅畏，速此悔尤，贪残无厌，杀戮非罪，稽于偃革，职而玩兵。","book":"《宋史·王全斌传》"},"similar":["贪得无厌","贪婪无厌","贪婪无餍"],"usage":"作谓语、定语；形容人的贪婪"},{"id":41913,"word":"贪求无厌","pinyin":"tān qiú wú yàn","abbr":"tqwy","explanation":"厌：满足。贪图获得好处而没有满足的时候。","source":{"text":"及桓子骄泰奢侈，贪欲无艺。","book":"春秋·鲁·左丘明《国语·晋语八》"},"example":{"text":"他～，最终会没好下场。"},"similar":["贪得无厌","贪求无已"],"opposite":["两袖清风","廉洁奉公"],"usage":"作谓语、定语；指贪得无厌","story":["春秋时期，晋国人叔向去拜访卿韩宣子。韩宣子说他名义上是卿而实际上财富很少，叔向向他祝贺，他感到奇怪。叔向说以前栾武子做上卿时家里只有一个仆人和百十顷田，人们都尊敬他，而他的儿子继卿位贪财受贿，差一点招来杀身之祸"]},{"id":41914,"word":"贪求无已","pinyin":"tān qiú wú yǐ","abbr":"tqwy","explanation":"贪图利益，无满足的时候。同“贪求无厌”。","source":{"text":"鞭捶驿吏，贪求无已。","book":"《旧唐书·李载义传》"},"similar":["贪求无厌"],"usage":"作谓语、定语；用于处事"},{"id":41915,"word":"贪污受贿","pinyin":"tān wū shòu huì","abbr":"twsh","explanation":"利用职权非法取得钱财。","source":{"text":"盗窃国家财产，贪污受贿，这是现钱买卖，清清楚楚，不容易搞错。","book":"邓小平《坚决打击经济犯罪活动》"},"usage":"作谓语、宾语、定语；用于官场等"},{"id":41916,"word":"贪污狼藉","pinyin":"tān wū láng jí","abbr":"twlj","explanation":"谓贪财纳贿，行为不检，声名败坏。","source":{"text":"敦兄含时为庐江郡，贪污狼藉。","book":"《晋书·何充传》"},"usage":"作谓语、定语；用于处事"},{"id":41917,"word":"贪污腐化","pinyin":"tān wū fǔ huà","abbr":"twfh","explanation":"利用职权，非法取得财物，过着奢侈糜烂的生活。","source":{"text":"一切高傲的出头的空谈的恶习，以至贪污腐化的生活，必须克服与排除。","book":"周恩来《抗战军队的政治工作》"},"example":{"text":"自私自利，消极怠工，～，风头主义等等，是最可鄙。","book":"毛泽东《中国共产党在民族战争中的地位》"},"similar":["贪赃枉法"],"opposite":["清正廉洁"],"usage":"作谓语、宾语、定语；用于官员"},{"id":41918,"word":"贪滥无厌","pinyin":"tān làn wú yàn","abbr":"tlwy","explanation":"厌：满足。乱贪永远没有满足的时候。","source":{"text":"谁想这伙官员，贪滥无厌，徇私作弊，克减酒肉。","book":"明·施耐庵《水浒传》第83回"},"similar":["贪得无厌"],"usage":"作谓语、定语；形容人的贪婪"},{"id":41919,"word":"贪猥无厌","pinyin":"tān wěi wú yàn","abbr":"twwy","explanation":"贪心永远没有满足的时候。同“贪得无厌”。","source":{"text":"又苏州嘉兴令杨廷玉，则天之表侄也，贪猥无厌。","book":"《太平广记·夏文荣》"},"similar":["贪得无厌","贪残无厌"],"usage":"作谓语、定语；形容人的贪婪"},{"id":41920,"word":"贪生害义","pinyin":"tān shēng hài yì","abbr":"tshy","explanation":"贪恋生命，危害道义。","source":{"text":"贪生害义，即非烈丈夫；杀身成仁，才是奇男子。","book":"明·王世贞《鸣凤记·灯前修本》"}},{"id":41921,"word":"贪生怕死","pinyin":"tān shēng pà sǐ","abbr":"tsps","explanation":"贪：舍不得。贪恋生存，畏惧死亡。指对敌作战畏缩不前。","source":{"text":"今立自知贼杀中郎曹将，冬月迫促，贪生畏死，即诈僵仆阳（佯）病，徼幸得逾于须臾。","book":"《汉书·文三王传》"},"example":{"text":"他们没有一个～而逃跑的，他们知道多一个人多一分力量。","book":"曲波《林海雪原》二"},"similar":["贪图享受","贪生畏死"],"opposite":["舍生忘死","视死如归"],"usage":"作谓语、定语、宾语；指人没有骨气","story":["西汉末年，诸侯国梁王刘立不把朝廷放在眼里，任意杀害手下中郎曹将。汉哀帝大怒，派钦差到梁国捉拿刘立。刘立感觉到事态严重，就脱去王冠跪地请罪，说自己贪生怕死并非对抗朝廷，只是等待朝廷每年的新春大赦"]},{"id":41922,"word":"贪生恶死","pinyin":"tān shēng wù sǐ","abbr":"tses","explanation":"贪恋生存，害怕死亡。同“贪生畏死”。","source":{"text":"夫人情莫不贪生恶死，念亲戚，顾妻子，至激于义理者不然，乃有不得已也。","book":"《汉书·司马迁传》"},"example":{"text":"明·焦竑《玉堂丛语·行谊》：“～，固人常情，然吾终不为不义屈。”"},"usage":"作谓语、定语；用于处事"},{"id":41923,"word":"贪生畏死","pinyin":"tān shēng wèi sǐ","abbr":"tsws","explanation":"贪：舍不得。贪恋生存，畏惧死亡。指对敌作战畏缩不前。","source":{"text":"今立自知贼杀中郎曹将，冬月迫促，贪生畏死，即诈僵仆阳（佯）病，徼幸得逾于须臾。","book":"《汉书·文三王传》"},"example":{"text":"明·许仲琳《封神演义》第71回：“弟子不得已纳降，不过救此一郡生灵耳，岂是～之故。”"},"similar":["贪生怕死"],"usage":"作谓语、定语、宾语；用于处事"},{"id":41924,"word":"贪生舍义","pinyin":"tān shēng shě yì","abbr":"tssy","explanation":"为了活命，可以不要道义。","source":{"text":"临难苟免，贪生舍义，在国为乱臣，即在家为逆子，此知孝而不知忠之弊也。","book":"清·夏敬渠《野叟曝言》第六十四回"},"usage":"作谓语、定语；用于处事"},{"id":41925,"word":"贪而无信","pinyin":"tān ér wú xìn","abbr":"tewx","explanation":"贪婪而又不守信用。","source":{"text":"以为鲜卑隔在漠北，犬羊为群，无君长帅庐落之居，又其天性，贪而无信。","book":"汉·应劭《鲜卑胡市议》"},"example":{"text":"明·冯梦龙《东周列国志》第16回：“楚王为人，～。”"},"usage":"作谓语、定语；用于处世"},{"id":41926,"word":"贪脏枉法","pinyin":"tān zāng wǎng fǎ","abbr":"tzwf","explanation":"贪污受贿，违犯法纪。"},{"id":41927,"word":"贪花恋酒","pinyin":"tān huā liàn jiǔ","abbr":"thlj","explanation":"贪恋女色和美酒。","source":{"text":"某奉圣人的命，因牧之贪花恋酒，本当谪罚，姑念他才识过人，不拘细行，赦其罪责。","book":"元·乔吉《扬州梦》第四折"},"example":{"text":"明·冯梦龙《警世通言》第20卷：“在路～，迁延程途，直是怏怏。”"},"usage":"作谓语、定语、宾语；用于处世"},{"id":41928,"word":"贪荣冒宠","pinyin":"tān róng mào chǒng","abbr":"trmc","explanation":"贪：贪图。贪图荣耀和恩宠。","source":{"text":"贪荣冒宠，僭滥无厌，败俗伤风，贤愚共鄙。","book":"《旧唐书·崔昭纬传》"},"example":{"text":"夫嗜色淫声，～，流转生死，何由自出？","book":"宋·释普济《五灯会元》卷二"},"similar":["贪冒荣宠"],"usage":"作谓语、定语；用于处世"},{"id":41929,"word":"贪荣慕利","pinyin":"tān róng mù lì","abbr":"trml","explanation":"贪图荣耀，羡慕财利。","source":{"text":"夫顾亲戚，惧诛夷，贪荣慕利，此生人常也。","book":"《周书·柳带韦传》"},"example":{"text":"为了～，她也牺牲了不少东西。"},"usage":"作谓语、定语、宾语；指人贪慕虚荣"},{"id":41930,"word":"贪蛇忘尾","pinyin":"tān shé wàng wěi","abbr":"tsww","explanation":"比喻只图眼前利益而不考虑后果。","source":{"text":"贪蛇前行，必忘其尾。","book":"宋·文莹《玉壶清话》"},"usage":"作宾语、定语；用于比喻句"},{"id":41931,"word":"贪财好利","pinyin":"tān cái hào lì","abbr":"tchl","explanation":"指贪恋钱财和利益。","source":{"text":"愚男原在快活林中做些买卖，非为贪财好利，实为壮观孟州，增添豪侠气象。","book":"明·施耐庵《水浒传》第29回"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第20卷：“只为世人～，见了别人钱钞，昧着心就要起发了。”"},"similar":["自私自利"],"usage":"作谓语、定语、宾语；用于处世"},{"id":41932,"word":"贪财好色","pinyin":"tān cái hào sè","abbr":"tchs","explanation":"贪图私利，喜好女色。","source":{"text":"沛公居山东时，贪财好色。","book":"《汉书·高帝纪》"},"example":{"text":"廖永安数出多人，俱是～的，那里是英雄出世之主。 ◎明·郭勋《英烈传》第十三回"}},{"id":41933,"word":"贪财好贿","pinyin":"tān cái hào huì","abbr":"tchh","explanation":"贪图财物和贿赂。","source":{"text":"差小官体察民情，因傅彬贪财好贿，犯刑宪负累忠臣。","book":"元·关汉卿《裴度还带》第四折"},"example":{"text":"明·无名氏《桃园结义》第一折：“因本州官吏～，酷害黎民，常有不忿之意。”"},"usage":"作谓语、定语、宾语；用于处事"},{"id":41934,"word":"贪财慕势","pinyin":"tān cái mù shì","abbr":"tcms","explanation":"贪图财物，羡慕权势。","source":{"text":"贪财而慕势，故犯法者众，奸邪不止。","book":"汉·荀悦《汉纪·元帝纪》"},"example":{"text":"她～，十分虚荣。"},"similar":["爱势贪财"],"usage":"作谓语、定语；指贪好钱财，仰慕权贵"},{"id":41935,"word":"贪财无义","pinyin":"tān cái wú yì","abbr":"tcwy","explanation":"贪求财物没有限度。指反动的统治阶级无限制地搜刮民财。","source":{"text":"及桓子，骄泰奢侈，贪欲无艺，略则行志，假贷居贿，宜及于难。","book":"《国语·晋语八》"},"example":{"text":"十娘因见鸨儿～，久有从良之志，又见李公子忠厚志诚，甚有心向他。","book":"明·冯梦龙《警世通言》卷三十二"},"similar":["贪财贱义"],"usage":"作谓语、定语；用于处事"},{"id":41936,"word":"贪财无厌","pinyin":"tān cái wú yàn","abbr":"tcwy","explanation":"厌：满足。贪求财物没有满足的时候。指反动的统治阶级无限制地搜刮民财。","source":{"text":"贪婪无餍，忿类无期。","book":"《左传·昭公二十八年》"}},{"id":41937,"word":"贪财贱义","pinyin":"tān cái jiàn yì","abbr":"tcjy","explanation":"贱：轻视；义：道义。贪图钱财，轻视道义。","source":{"text":"今天下俗，贪财贱义，好声色，上侈靡。","book":"宋·司马光《资治通鉴·汉纪·元帝永光二年》"},"similar":["贪财无义"],"usage":"作谓语、定语；用于处事"},{"id":41938,"word":"贪贿无艺","pinyin":"tān huì wú yì","abbr":"thwy","explanation":"贿：财物；艺：标准、准则，引伸为法度、限度。贪求财物没有限度。指反动的统治阶级无限制地搜刮民财。","source":{"text":"及桓子，骄泰奢侈，贪欲无艺，略则行志，假贷居贿，宜及于难。","book":"《国语·晋语八》"},"example":{"text":"彼辈不注意敌人而以对内为能事，杀人如麻，～，实谣言之大本营，奸邪之制造所。","book":"毛泽东《向国民党的十点要求》"},"similar":["贪欲无艺"],"usage":"作谓语、定语；指贪得无厌","story":["春秋时期，晋国人叔向去拜访卿韩宣子。韩宣子说他名义上是卿而实际上财富很少，叔向向他祝贺，他感到奇怪。叔向说以前栾武子做上卿时家里只有一个仆人和百十顷田，人们都尊敬他，而他的儿子继卿位贪财受贿，差一点招来杀身之祸"]},{"id":41939,"word":"贪赃坏法","pinyin":"tān zāng huài fǎ","abbr":"tzhf","explanation":"赃：赃物；坏：败坏。贪污受贿，违犯法纪。","source":{"text":"谁想那两个到的陈州，贪赃坏法饮酒非为。","book":"元·无名氏《陈州粜米》第二折"},"example":{"text":"清·黄宗羲《子刘子行状》：“即皇上欲问～，欺君罔上者；亦不可不付之法司也。”"},"similar":["贪赃枉法"],"usage":"作谓语、定语；形容人的贪欲"},{"id":41940,"word":"贪赃枉法","pinyin":"tān zāng wǎng fǎ","abbr":"tzwf","explanation":"赃：赃物；枉：歪曲，破坏。贪污受贿，违犯法纪。","source":{"text":"谁想那两个到的陈州，贪赃坏法饮酒非为。","book":"元·无名氏《陈州粜米》第二折"},"example":{"text":"陈绛在福建，据说～，声名狼籍。","book":"马南邨《陈绛和五耿的案件》"},"similar":["徇私枉法","贪赃舞弊","贪污腐化"],"opposite":["清正廉明","廉洁奉公"],"usage":"作谓语、定语；形容人的贪欲"},{"id":41941,"word":"贪赃纳贿","pinyin":"tān zāng nà huì","abbr":"tznh","explanation":"贪赃：利用职权非法占有公家或他人的财物；纳：接受；贿：贿赂。指利用职权，贪污受贿。","example":{"text":"已而国用不足，又复思融，意欲再行召入，会有飞状告融，～，隐没官钱，乃再流巖州，病死途中。","book":"蔡东藩《南北史演义》四十四回"}},{"id":41942,"word":"贪饵丧生","pinyin":"tān ěr sàng shēng","abbr":"tess","explanation":"指鱼类因贪图饵食而招致灾祸。","source":{"text":"鳏虽难得，贪以死饵；士虽怀道，贪以死禄也。","book":"《孔丛子·抗志第十》"}},{"id":41943,"word":"贫不失志","pinyin":"pín bù shī zhì","abbr":"pbsz","explanation":"失：丧失。贫困中不丧失志气。"},{"id":41944,"word":"贫不学俭","pinyin":"pín bù xué jiǎn","abbr":"pbxj","explanation":"指穷人不必学俭而不得不俭。","source":{"text":"贫不学俭，富不学奢。","book":"《三国志·魏志·任城陈萧王彰传论》：“其此之谓欤”裴松之注引三国·魏·鱼豢曰：“谚言：‘贫不学俭，俾不学恭’，非人性分也，势使然耳。”《旧唐书·马周传》"},"example":{"text":"～，而俭自来；富不学奢，而奢自至。","book":"清·蒋超伯《南漘楛语·名言》"},"usage":"作宾语、定语；用于书面语"},{"id":41945,"word":"贫不学俭，富不学奢","pinyin":"pín bù xué jiǎn，fù bù xué shē","abbr":"pbxjfbxs","explanation":"贫穷的人不学节俭也会节俭，富有的人不学奢侈也会奢侈。形容环境、习惯对人的思想行为有很大的影响。","source":{"text":"曰：‘贫不学俭，富不学奢’，言自然也。","book":"唐·马周《请崇节俭及制诸王疏》"},"usage":"作宾语、定语、分句；用于书面语"},{"id":41946,"word":"贫于一字","pinyin":"pín yú yī zì","abbr":"pyyz","explanation":"贫：贫乏。贫乏得找不到一个适当的字。形容苦心作文，炼字艰难。","source":{"text":"故善为文者，富于万篇，贫于一字，一字非少，相避为难也。","book":"南朝·梁·刘勰《文心雕龙·练字》"}},{"id":41947,"word":"贫儿曝富","pinyin":"pín ér pù fù","abbr":"pepf","explanation":"曝：通“暴”，显露。穷人炫耀财富。比喻稍微有点成绩就炫耀。","source":{"text":"抄得《唐书》一部，又借得《前汉》一部，若了此二书，便得贫儿曝富也。","book":"宋·苏轼《与程全父书》"},"usage":"作宾语、定语；用于为人"},{"id":41948,"word":"贫嘴恶舌","pinyin":"pín zuǐ è shé","abbr":"pzes","explanation":"指话多而尖酸刻薄，使人厌恶。同“贫嘴贱舌”。","source":{"text":"这东西亏他托生在诗书大宦名门之家做小姐，出了嫁又是这样，他还是这么着，若是生在贫寒小户人家，作个小子，还不知怎么下作贫嘴恶舌的呢！","book":"清·曹雪芹《红楼梦》第四十五回"},"example":{"text":"忘了讽刺，相声便失去了威严，而一味～。搞错讽刺的对象，便黑白不分，很难成为宣传的工具。","book":"老舍《出口成章·谈相声的改造》"},"similar":["贫嘴薄舌","贫嘴贱舌"],"opposite":["沉默寡言"],"usage":"作定语、宾语；指说话油滑尖酸"},{"id":41949,"word":"贫嘴滑舌","pinyin":"pín zuǐ huá shé","abbr":"pzhs","explanation":"指话多而尖酸刻薄，使人厌恶。同“贫嘴贱舌”。","source":{"text":"打明天清早起，不许你再跟大姑娘小媳妇儿贫嘴滑舌。","book":"刘绍棠《蒲柳人家》"},"example":{"text":"我们不跟你这样～的人说话。"},"similar":["贫嘴薄舌"],"usage":"作谓语、定语、宾语；指人的嘴多"},{"id":41950,"word":"贫嘴薄舌","pinyin":"pín zuǐ bó shé","abbr":"pzbs","explanation":"指话多而尖酸刻薄，使人厌恶。","source":{"text":"什么诙谐！不过是贫嘴贱舌的讨人厌罢了！","book":"清·曹雪芹《红楼梦》第二十五回"},"example":{"text":"恐怕大抵要以为这是作者～，随意捏造，以挖苦他所不满的人们的罢。","book":"鲁迅《花边文学·奇怪》"},"similar":["唠唠叨叨","贫嘴贱舌","能说会道"],"opposite":["沉默寡言"],"usage":"作定语、宾语；指人的嘴多"},{"id":41951,"word":"贫嘴贱舌","pinyin":"pín zuǐ jiàn shé","abbr":"pzjs","explanation":"指话多而尖酸刻薄，使人厌恶。","source":{"text":"黛玉道：‘什么诙谐！不过是贫嘴贱舌的讨人厌罢了。’","book":"清·曹雪芹《红楼梦》第25回"},"example":{"text":"自己也很伶俐的贾母，像凤姐那样‘～’，长于‘世俗取笑’。","book":"王朝闻《凤姐的个性与共性》"},"similar":["唠唠叨叨","能说会道"],"opposite":["沉默寡言"],"usage":"作定语、宾语；指说话油滑尖酸"},{"id":41952,"word":"贫嘴饿舌","pinyin":"pín zuǐ è shé","abbr":"pzes","explanation":"形容人话多令人讨厌。","example":{"text":"～的女人让人敬而远之。"},"similar":["贫嘴恶舌"],"usage":"作谓语、定语、宾语；用于说话等"},{"id":41953,"word":"贫困潦倒","pinyin":"pín kùn liáo dǎo","abbr":"pkld","explanation":"生活贫困，精神失意颓丧。","source":{"text":"张三失业已久，又无亲友可依靠，生活十分～。"}},{"id":41954,"word":"贫士市瓜","pinyin":"pín shì shì guā","abbr":"pssg","explanation":"市：买。穷苦读书人买瓜只挑个大的。比喻以言谈和外貌取人。","source":{"text":"然取士多以言貌，时致谤言，以为愔之用人，似贫士市瓜，取其大者。","book":"《北齐书·杨愔传》"},"usage":"作宾语、定语；用于处世"},{"id":41955,"word":"贫女分光","pinyin":"pín nǚ fēn guāng","abbr":"pnfg","explanation":"分：分享。贫女分享了富女的烛光。比喻不需破费的照顾。","source":{"text":"臣闻贫人女与富人女会绩，贫人女曰：‘我无以买烛，而子之光幸有余，子可以分我余光，无损子明而得一斯便焉。’","book":"《史记·樗里子甘茂列传》"}},{"id":41956,"word":"贫富不均","pinyin":"pín fù bù jūn","abbr":"pfbj","explanation":"均：平均。贫穷和富裕很不平均。","source":{"text":"百姓勤劳，废失农业，遭离水旱，致使生民贫富不均，未得家给人足。","book":"《魏书·世祖纪上》"},"example":{"text":"～是产生社会动荡的重要原因。"},"similar":["贫富悬殊"],"usage":"作主语、宾语、定语；指社会状况"},{"id":41957,"word":"贫富悬殊","pinyin":"pín fù xuán shū","abbr":"pfxs","explanation":"贫的和富的相差极大。","source":{"text":"现在的贫富悬殊是史无前例的。","book":"朱自清《论且顾眼前》"},"example":{"text":"我们要尽量消灭～。"},"usage":"作主语、宾语、定语；指贫穷和富裕"},{"id":41958,"word":"贫无担石","pinyin":"pín wú dàn dàn","abbr":"pwds","explanation":"担：古代重量单位，1担＝100市斤；石：容量单位：1石＝10斗。家里穷得连一担的粮食也没有。形容没什么储备。","source":{"text":"理本荒也，而剽窃二氏之皮肤，如贫无担石之人，指富家之囷，以夸示乡里也。","book":"明·袁宏道《叙四子稿》"},"usage":"作谓语、定语；用于生活"},{"id":41959,"word":"贫无立锥","pinyin":"pín wú lì zhuī","abbr":"pwlz","explanation":"穷得连插下锥子那样小的地方都没有。","source":{"text":"富者田连阡伯，贫者亡立锥之地。","book":"东汉·班固《汉书·食货志》"},"example":{"text":"媪夫姓殷，一子名富，善博，～。","book":"清·蒲松龄《聊斋志异·薛慰娘》"},"similar":["一文不名","一贫如洗","家徒四壁"],"opposite":["腰缠万贯","金玉满堂"],"usage":"作谓语、定语；指十分贫穷","story":["春秋时期，楚国王宫艺人优孟听说前相国孙叔敖死后儿子过着十分清贫的生活，觉得过意不去，就穿戴孙叔敖的衣冠，模仿他的音容笑貌去见楚王，楚王即景生情，优孟趁机讲述孙叔敖儿子贫无立锥之地，楚王深受感动，就重封孙叔敖的儿子"]},{"id":41960,"word":"贫无立锥之地","pinyin":"pín wú lì zhuī zhī dì","abbr":"pwlzzd","explanation":"穷得连可以插下锥子那样小的地方都没有。形容穷困之极。","source":{"text":"富者田连仟佰，贫者亡立锥之地。","book":"汉·韩婴《韩诗外传》第四卷：“十子者，不能亲也，无置锥之地，而王公不能与争名，则是圣人之未得志者也。”《汉书·食货志》"},"example":{"text":"他落到～的地步。"},"similar":["贫无立锥"],"opposite":["腰缠万贯"],"usage":"作分句；指非常贫困","story":["春秋时期，楚国王宫艺人优孟听说前相国孙叔敖死后儿子过着十分清贫的生活，觉得过意不去，就穿戴孙叔敖的衣冠，模仿他的音容笑貌去见楚王，楚王即景生情，优孟趁机讲述孙叔敖儿子贫无立锥之地，楚王深受感动，就重封孙叔敖的儿子"]},{"id":41961,"word":"贫无置锥","pinyin":"pín wú zhì zhuī","abbr":"pwzz","explanation":"穷得连插下锥子那样小的地方都没有。同“贫无立锥”。","source":{"text":"尧舜有天下，子孙无置锥之地。","book":"语出《庄子·盗跖》"},"example":{"text":"～人所怜，穷到无锥不属天。","book":"宋·黄庭坚《赠陈师道》诗"},"similar":["贫无立锥"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；指十分贫穷"},{"id":41962,"word":"贫病交侵","pinyin":"pín bìng jiāo qīn","abbr":"pbjq","explanation":"贫穷和疾病一起压在身上。同“贫病交迫”。","source":{"text":"椐闻抗战中，何（何海鸣）陷身南京，贫病交侵，坚不出任伪职。","book":"石三友《金陵野史·南京报坛旧事》"},"similar":["贫病交攻","贫病交迫"],"usage":"作谓语、状语；形容生活境况非常艰难"},{"id":41963,"word":"贫病交加","pinyin":"pín bìng jiāo jiā","abbr":"pbjj","explanation":"交：一起，同时；加；压上。贫穷和疾病一起压在身上。","source":{"text":"入春以来，贫病交攻，更无一日好况。","book":"宋·陈亮《与王季海丞相书》"},"example":{"text":"病弱的妻子和幼女，因为无依无靠，～，看着要饿毙，为了孩子的命，忍痛割情另嫁别人。","book":"刘流《烈火金钢》第十七回"},"similar":["饥寒交迫","啼饥号寒"],"opposite":["心广体胖","丰衣足食","人给家足"],"usage":"作谓语、状语；形容生活境况非常艰难"},{"id":41964,"word":"贫病交攻","pinyin":"pín bìng jiāo gōng","abbr":"pbjg","explanation":"交：同时。贫穷和疾病同时压过来","source":{"text":"入春以来，贫病交攻，更无一日好况。","book":"宋·陈亮《与王季海丞相书》"},"example":{"text":"清·曹雪芹《红楼梦》第一回：“暮年之人，那禁得～。”"},"similar":["贫病交迫","贫病交加"],"usage":"作谓语、定语；指贫穷和疾病"},{"id":41965,"word":"贫病交迫","pinyin":"pín bìng jiāo pò","abbr":"pbjp","explanation":"贫穷和疾病一起压在身上。","source":{"text":"入春以来，贫病交攻，更无一日好况。","book":"宋·陈亮《与王季海丞相书》"},"example":{"text":"热忱爱国的文化人不仅被逼得～，更甚而家破人亡。这到底是谁的罪呢？（郭沫若《洪波曲》第三章）"},"similar":["贫病交加","贫病交侵","贫病交攻"],"usage":"作谓语、状语；形容生活境况非常艰难"},{"id":41966,"word":"贫穷潦倒","pinyin":"pín qióng liáo dǎo","abbr":"pqld","explanation":"家境很穷、衣着破烂、精神状态很差。","example":{"text":"他落到～的地步。"},"similar":["穷困潦倒"],"usage":"作谓语、定语；指贫困"},{"id":41967,"word":"贫而乐道","pinyin":"pín ér lè dào","abbr":"peld","explanation":"家境贫穷，却以获得知识、懂得道理为乐事。","source":{"text":"子贡曰：‘贫而无谄，富而无骄，何如？’子曰：‘可也，未若贫而乐，富而好礼者也。’","book":"《论语·学而》"},"example":{"text":"自行其道，自得其乐，行于所当行，止于所当止，富而有德，～，这些当然与计谋无关，乃大智无谋也。","book":"王蒙《我的人生哲学》二一"},"similar":["安贫乐道"],"usage":"作谓语；指安贫乐道"},{"id":41968,"word":"贫而无谄","pinyin":"pín ér wú chǎn","abbr":"pewc","explanation":"虽贫穷而不去巴结奉承人。","source":{"text":"贫而无谄，富而无骄，何如？","book":"春秋·鲁·孔丘《论语·学而》"},"example":{"text":"自古道～，肯贪荣忘恩失义、附热趋炎？","book":"元·柯丹邱《荆钗记·分别》"},"usage":"作谓语、定语；用于人的性格"},{"id":41969,"word":"贫而无谄，富而无骄","pinyin":"pín ér wú chǎn，fù ér wú jiāo","abbr":"pewcfewj","explanation":"谄：巴结，讨好。贫穷却不巴结奉承，富有却不骄傲自大。","source":{"text":"子贡曰：‘贫而无谄，富而无骄，何如？’子曰：‘可也，未若贫而乐，富而好礼者也。’","book":"《论语·学而》"}},{"id":41970,"word":"贫贱不移","pinyin":"pín jiàn bù yí","abbr":"pjby","explanation":"移：改变。不因生活贫困、社会地位低下而改变自己的志向。形容意志坚定。","source":{"text":"富贵不能淫，贫贱不能移，威武不能屈，此之谓大丈夫。","book":"《孟子·滕文公下》"}},{"id":41971,"word":"贫贱不能移","pinyin":"pín jiàn bù néng yí","abbr":"pjbny","explanation":"不会因生活贫困，地位卑微而改变自己的志向。","source":{"text":"富贵不能淫，贫贱不能移，威武不能屈，此之谓大丈夫。","book":"战国·邹·孟轲《孟子·滕文公下》"},"usage":"作宾语、定语；指人的性格"},{"id":41972,"word":"贫贱之交","pinyin":"pín jiàn zhī jiāo","abbr":"pjzj","explanation":"贫困时结交的知心朋友。","source":{"text":"（光武帝）谓弘曰：‘谚言贵易交，富易妻，人情乎？’弘曰：‘臣闻贫贱之知不可忘，糟糠之妻不下堂。’","book":"《后汉书·宋弘传》"},"example":{"text":"你也算～了。”（清·曹雪芹《红楼梦》第四回","book":"雨村笑道"},"similar":["贫贱之知"],"opposite":["富贵之交"],"usage":"作宾语；指知心朋友","story":["东汉初年，刘秀起用西汉时期的侍中宋弘，并升他为“太中大夫”。刘秀的姐姐守寡并看上了宋弘，刘秀想把姐姐嫁给宋弘，问宋弘对“贵易交，富易妻”的看法，宋弘回答道：“贫贱之交不可忘，糟糠之妻不下堂”，刘秀只好放弃"]},{"id":41973,"word":"贫贱之交不可忘","pinyin":"pín jiàn zhī jiāo bù kě wàng","abbr":"pjzjbkw","explanation":"贫贱之交：贫困时的知心朋友。指人富贵时不要忘记贫贱时的朋友。","source":{"text":"夫贫贱之交不可忘，珠玉满堂而不足贵，薛大夫其人也。","book":"唐·陈子昂《薛大夫山亭宴序》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“你是绝顶聪明的人，总该晓得这两句话：‘糟糠之妻不下堂，～。”"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":41974,"word":"贫贱之交不可忘，糟糠之妻不下堂","pinyin":"pín jiàn zhī jiāo bù kě wàng,zāo kāng zhī qī bù xià táng","abbr":"pjzjbkwzkzqbxt","explanation":"贫贱之交：贫困时的知心朋友；糟糠：酒糟和糠麸。富贵时不要忘记贫贱时的朋友，不要抛弃共同患难过的妻子。","source":{"text":"后悛从驾登蒋山，上数叹曰：‘贫贱之交不可忘，糟糠之妻不下堂。’顾谓悛曰：‘此况卿也。’","book":"《南齐书·刘悛传》"},"example":{"text":"古人云～，似这等畜类这行止，着小老婆尽都丢了也。","book":"元·无名氏《渔樵闲话》第二折"},"similar":["贫贱之知不可忘，糟糠之妻不下堂"],"usage":"作宾语、定语、分句；用于劝诫人","story":["东汉初年，刘秀起用西汉时期的侍中宋弘，并升他为“太中大夫”。刘秀的姐姐守寡并看上了宋弘，刘秀想把姐姐嫁给宋弘，问宋弘对“贵易交，富易妻”的看法，宋弘回答道：“贫贱之交不可忘，糟糠之妻不下堂”，刘秀只好放弃"]},{"id":41975,"word":"贫贱之知","pinyin":"pín jiàn zhī zhī","abbr":"pjzz","explanation":"贫困时结交的知心朋友。","source":{"text":"（光武帝）谓弘曰：‘谚言贵易交，富易妻，人情乎？’弘曰：‘臣闻贫贱之知不可忘，糟糠之妻不下堂。’","book":"《后汉书·宋弘传》"},"similar":["贫贱之交"],"usage":"作宾语；指知心朋友","story":["东汉初年，刘秀起用西汉时期的侍中宋弘，并升他为“太中大夫”。刘秀的姐姐守寡并看上了宋弘，刘秀想把姐姐嫁给宋弘，问宋弘对“贵易交，富易妻”的看法，宋弘回答道：“贫贱之交不可忘，糟糠之妻不下堂”，刘秀只好放弃"]},{"id":41976,"word":"贫贱之知不可忘，糟糠之妻不下堂","pinyin":"pín jiàn zhī zhī bù kě wàng,zāo kāng zhī qī bù xià táng","abbr":"pjzzbkwzkzqbxt","explanation":"贫贱之知：贫困时的知心朋友；糟糠：酒糟和糠麸。富贵时不要忘记贫贱时的朋友，不要抛弃共同患难过的妻子。","source":{"text":"臣闻贫贱之知不可忘，糟糠之妻不下堂。","book":"南朝·宋·范晔《后汉书·宋弘传》"},"similar":["贫贱之交不可忘，糟糠之妻不下堂"],"usage":"作宾语、定语、分句；用于劝诫人","story":["东汉初年，刘秀起用西汉时期的侍中宋弘，并升他为“太中大夫”。刘秀的姐姐守寡并看上了宋弘，刘秀想把姐姐嫁给宋弘，问宋弘对“贵易交，富易妻”的看法，宋弘回答道：“贫贱之交不可忘，糟糠之妻不下堂”，刘秀只好放弃"]},{"id":41977,"word":"贫贱亲戚离","pinyin":"pín jiàn qīn qī lí","abbr":"pjqql","explanation":"一个人贫贱时，亲戚也会离开他。形容人与人之间的亲疏关系以金钱多少和地位高低为转移。","source":{"text":"富贵他人合，贫贱亲戚离。廉蔺门易轨，田窦相夺移。","book":"晋·曹摅《感旧》诗"}},{"id":41978,"word":"贫贱亲戚离，富贵他人合","pinyin":"pín jiàn qīn qī lí，fù guì tā rén hé","abbr":"pjqqlfgtrh","explanation":"他人：外人；合：聚合。贫贱时亲朋戚友都疏远你，富贵时素不相识的人都会来巴结你。指人情冷暖，世态炎凉。","source":{"text":"有句古诗说得好，道是：‘贫贱亲戚离，富贵他人合。’贾似道做了国戚，朝廷恩宠曰隆，那一个不趋奉他？","book":"明·冯梦龙《古今小说》第22卷"},"usage":"作宾语、定语、分句；用于人生"},{"id":41979,"word":"贫贱糟糠","pinyin":"pín jiàn zāo kāng","abbr":"pjzk","explanation":"指贫贱时一起过患难生活的妻子。","source":{"text":"弘曰：‘臣闻贫贱之知不可忘，糟糠之妻不下堂。’","book":"语出《后汉书·宋弘传》"},"example":{"text":"呀！下官已有早年结发，乃～。","book":"明·王玉峰《焚香记·辞婚》"},"usage":"作宾语、定语；指妻子","story":["东汉初年，刘秀起用西汉时期的侍中宋弘，并升他为“太中大夫”。刘秀的姐姐守寡并看上了宋弘，刘秀想把姐姐嫁给宋弘，问宋弘对“贵易交，富易妻”的看法，宋弘回答道：“贫贱之交不可忘，糟糠之妻不下堂”，刘秀只好放弃"]},{"id":41980,"word":"贫贱骄人","pinyin":"pín jiàn jiāo rén","abbr":"pjjr","explanation":"身处贫贱，但很自豪。指贫贱的人蔑视权贵。","source":{"text":"富贵者骄人乎？且贫贱者骄人乎？","book":"《史记·魏世家》"},"example":{"text":"还有一班不长进的，并没有人赏识过他，也学着他去瞎狂，说什么“～”。","book":"清·吴趼人《二十年目睹之怪现状》第二十二回"},"opposite":["富贵骄人"],"usage":"作谓语、补语；指对富贵权势持轻蔑鄙视态度","story":["战国时期，魏文侯攻占中山国，派太子击去驻守。太子击在路上碰见了文侯的老师田子方就上前打招呼，田子方不予理睬。太子击问他是富贵还是贫贱值得骄傲，田子方认为贫贱应该骄傲，诸侯骄傲就失国，贫贱之士的意见不被采纳还可以到别国去"]},{"id":41981,"word":"贯彻始终","pinyin":"guàn chè shǐ zhōng","abbr":"gcsz","explanation":"贯彻：彻底的实行或体现。从始到终地实行下去或体现出来。","source":{"text":"对于内学相宗各法门，尤能贯彻始终。","book":"清·曾朴《孽海花》第三十四回"},"example":{"text":"它便有一种～和普及各地的绝对的主动权。","book":"毛泽东《论持久战》"},"similar":["自始至终"],"usage":"作谓语、定语；指自始至终"},{"id":41982,"word":"贯微动密","pinyin":"guàn wēi dòng mì","abbr":"gwdm","explanation":"贯、洞：贯通，通达；微、密：事物最微小、最细密之处。能看到事物的最小最隐密之处。形容对事物观察认识得非常透彻深入。","source":{"text":"于是乎孕大含深，贯微洞密，上下通面一气泰，忧乐合而百志熙。","book":"唐·白居易《与元九书》"}},{"id":41983,"word":"贯斗双龙","pinyin":"guàn dòu shuāng lóng","abbr":"gdsl","explanation":"形容才能拔萃超群。","source":{"text":"据《晋书·张华传》载：“晋张华善望气，见斗牛间常有紫气， 固命雷焕为丰城令访之。焕到县，掘狱屋基，得龙泉、太阿两宝剑，华与焕各佩其一。后华死，失剑所在。焕死，焕子持剑行经延平津，剑忽跃出堕水，使人没水取之， [下续示例]"},"example":{"text":"[上接出处] 但见两龙各长数丈，蟠萦有文章，光彩照水，波浪惊沸，于是失剑。”"}},{"id":41984,"word":"贯朽粟红","pinyin":"guàn xiǔ sù hóng","abbr":"gxsh","explanation":"穿钱的绳子朽断，仓库的粮食发霉变红。形容非常富有。","source":{"text":"汉兴七十余年之间……京师之钱，累巨万，贯朽而不可校。太仓之粟，陈陈相因，充溢露积于外，至腐败不可食。","book":"《史记·平准书》"},"example":{"text":"～，是皮囊内装不尽的臭汗粪土。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"similar":["贯朽粟陈","贯朽粟腐"],"usage":"作谓语、定语、宾语；形容财粮富足"},{"id":41985,"word":"贯朽粟腐","pinyin":"guàn xiǔ sù fǔ","abbr":"gxsf","explanation":"穿钱的绳子朽断，仓库的粮食腐烂。形容富有之极。","source":{"text":"京师之钱累巨万，贯朽而不可校；太仓之粟陈陈相因，充溢露积于外，至腐败不可食。","book":"西汉·司马迁《史记·平准书》"},"example":{"text":"故其承文帝富庶之后，～。","book":"宋·陆九渊《问汉文武之治》"},"similar":["贯朽粟陈","贯朽粟红"],"usage":"作谓语、定语；形容财粮富足","story":["西汉初年，刘邦采取一系列措施恢复经济，使得农业生产突飞猛进。汉文帝和汉景帝仍坚持这个既定的国策，国库里钱币堆成山，穿钱的线都腐朽了，粮库里积压的粮食无数，仓库容纳不下，只好露天堆放，很多谷子腐烂不能再食用了"]},{"id":41986,"word":"贯朽粟陈","pinyin":"guàn xiǔ sù chén","abbr":"gxsc","explanation":"钱串子断了，谷子烂了。比喻极富有。","source":{"text":"钱串子断了，谷子烂了。比喻极富有。"},"example":{"text":"钱串子断了，谷子烂了。比喻极富有。"},"similar":["贯朽粟腐","贯朽粟红"],"usage":"作谓语、定语；形容财粮富足","story":["西汉初年，刘邦采取一系列措施恢复经济，使得农业生产突飞猛进。汉文帝和汉景帝仍坚持这个既定的国策，国库里钱币堆成山，穿钱的线都腐朽了，粮库里积压的粮食无数，仓库容纳不下，只好露天堆放，很多谷子腐烂不能再食用了"]},{"id":41987,"word":"贯甲提兵","pinyin":"guàn jiǎ tí bīng","abbr":"gjtb","explanation":"贯甲：穿着盔甲；兵：兵器。身穿盔甲，手持兵器。形容充满杀气的样子。","source":{"text":"兄长既来赶席，如何又劳师动众？不入水府，扎营在此，不贯甲提兵，何也。","book":"明·吴承恩《西游记》第四十三回"},"usage":"作谓语、定语；用于书面语"},{"id":41988,"word":"贯盈恶稔","pinyin":"guàn yíng è rěn","abbr":"gyer","explanation":"犹言恶贯满盈。形容罪大恶极，到受惩罚的时候了。","source":{"text":"土崩鱼烂，贯盈恶稔，普天之下，莫非仇雠，左右之人，皆为敌国。","book":"《隋书·炀帝纪下》"},"similar":["恶贯满盈"],"usage":"作谓语、定语；用于坏人"},{"id":41989,"word":"贯穿今古","pinyin":"guàn chuān jīn gǔ","abbr":"gcjg","explanation":"把现在和古代联系起来。","source":{"text":"杜诗最多，可传者千余首，至于贯穿今古，覙缕格律，尽工尽善，又过于李。","book":"唐·白居易《与元九书》"},"example":{"text":"至于～，精炼吏事，于天下文官实为第一。","book":"宋·洪迈《夷坚丙志·赵和尚》"},"similar":["贯穿古今"],"usage":"作谓语、定语；指把现在和古代联系起来"},{"id":41990,"word":"贯穿古今","pinyin":"guàn chuān gǔ jīn","abbr":"gcgj","explanation":"贯穿：贯通，通达。把现在和古代联系起来。","source":{"text":"至于贯穿古今，精练吏事，于天下文官实为第一。","book":"宋·洪迈《夷坚丙志·赵和尚》"},"similar":["贯穿今古"],"usage":"作谓语、定语；指把现在和古代联系起来"},{"id":41991,"word":"贯穿融会","pinyin":"guàn chuān róng huì","abbr":"gcrh","explanation":"把各方面的知识和道理融化汇合，得到全面透彻的理解。同“贯通融会”。","source":{"text":"清·戴名世《方舟传》；“年十四五，尽通六经诸史及百家之书，贯穿融会，发挥为义理之文，穷微阐幽，务明其所以然之故。”"},"similar":["贯通融会"],"usage":"作谓语、定语、宾语；用于学习或思想"},{"id":41992,"word":"贯穿驰骋","pinyin":"guàn chuān chí chěng","abbr":"gccc","explanation":"贯穿：穿过，连通；驰骋：骑马奔跑。能很快地把有联系的事物融会贯通，加以理解。","source":{"text":"宗旦喜学《易》，所为注，有可采者，家不能有书，而人或质问以《易》，则贯穿驰骋至数十家，皆能言其意。","book":"宋·曾巩《与孙司封书》"},"usage":"作谓语、定语；用于书面语"},{"id":41993,"word":"贯虱穿杨","pinyin":"guàn shī chuān yáng","abbr":"gscy","explanation":"能射中小小的虱子，能穿过杨树叶子。形容箭术高超。","example":{"text":"他有～的绝技。"},"similar":["百步穿杨"],"usage":"作宾语、定语；指箭术高明","story":["从前纪昌去拜射箭高手飞卫为师学射箭，飞卫让他练眼睛的基本功，他回家看妻子织布，练就圆睁眼睛一点也不眨。飞卫让他练把小东西看成大东西，纪昌把头发上的小虱子看成车轮，飞卫教他射箭，他终于练就贯虱穿杨的射箭本领"]},{"id":41994,"word":"贯通融会","pinyin":"guàn tōng róng huì","abbr":"gtrh","explanation":"犹言融会贯通。把各方面的知识和道理融化汇合，得到全面透彻的理解。","source":{"text":"自始知学，讲求大道，弗得弗措，久而寝明，又久而大明，此心此理，贯通融会，美在其中，不劳外索。","book":"宋·袁燮《〈象山先生文集〉序》"},"example":{"text":"泥法而不知变，非算之胜也，盖有～、神而明之者存焉。","book":"明·吴承恩《〈诸史将略〉序》"},"similar":["融会贯通"],"usage":"作谓语、定语、宾语；用于学习或思想"},{"id":41995,"word":"贯颐备戟","pinyin":"guàn yí bèi jǐ","abbr":"gybj","explanation":"颐：腮，颊。两手捧着腮直冲入敌阵。形容勇猛异常。"},{"id":41996,"word":"贯颐奋戟","pinyin":"guàn yí fèn jǐ","abbr":"gyfj","explanation":"颐：下巴。两手捧颐而直入敌阵。形容英勇无畏。","source":{"text":"虎贲之士跣跔科头贯颐奋戟者，至不可胜计。","book":"《史记·张仪列传》"},"usage":"作谓语、定语；指人勇敢"},{"id":41997,"word":"贯鱼之序","pinyin":"guàn yú zhī xù","abbr":"gyzx","explanation":"贯鱼：成串的鱼。比喻前后有次序或前后相关联。","source":{"text":"今猬以轻鄙，超伦逾等，上乱圣朝贯鱼之序，下违群士准平之论。","book":"《晋书·蔡谟传》"}},{"id":41998,"word":"贯鱼之次","pinyin":"guàn yú zhī cì","abbr":"gyzc","explanation":"宫中的女官依次受到宠爱。","source":{"text":"慎贯鱼之次，无令丑女有四殆之叹，遐迩有愤怨之声。","book":"《后汉书·杨赐传》"},"similar":["贯鱼承宠"],"usage":"作宾语；指宫中的女官依次受到宠爱"},{"id":41999,"word":"贯鱼成宠","pinyin":"guàn yú chéng chǒng","abbr":"gycc","explanation":"贯鱼：穿成一串的鱼；宠：宠幸。指宫中的女官依次受到宠爱。","source":{"text":"一时龚、孔二贵嫔，王、李二美人，张、薛二淑媛，袁昭仪、何婕妤、江修容，并得贯鱼成宠。","book":"清·褚人获《隋唐演义》第一回"},"similar":["贯鱼之次"],"usage":"作宾语；指宫中的女官依次受到宠爱"},{"id":42000,"word":"贯鱼成次","pinyin":"guàn yú chéng cì","abbr":"gycc","explanation":"贯鱼：穿成一串的鱼，比喻众多而有秩序；序：次序。形容有次序，不紊乱。","source":{"text":"本立格之体，将谓人伦有序，若贯鱼成次也。","book":"《晋书·刘毅传》"},"usage":"作宾语、定语；用于事物等"},{"id":42001,"word":"贯鱼承宠","pinyin":"guàn yú chéng chǒng","abbr":"gycc","explanation":"宫中的女官依次受到宠爱。","source":{"text":"慎贯鱼之次，无令丑女有四殆之叹，遐迩有愤怨之声。","book":"《后汉书·杨赐传》"},"example":{"text":"一时龚、孔二贵嫔，王、李二美人，张、薛二淑媛，袁昭仪、何婕妤、江修容，并得～。","book":"清·褚人获《隋唐演义》第一回"}},{"id":42002,"word":"贱买贵卖","pinyin":"jiàn mǎi guì mài","abbr":"jmgm","explanation":"低价买进，高价售出。","source":{"text":"吏受所监临，以饮食免，重；受财物，贱买贵卖，论轻。","book":"汉·班固《汉书·景帝纪》"},"example":{"text":"若做经纪，贱心便起，～，损人利己。","book":"明·沈受先《三元记·饯行》"},"similar":["贱入贵出"],"usage":"作宾语、定语；指经商"},{"id":42003,"word":"贱入贵出","pinyin":"jiàn rù guì chū","abbr":"jrgc","explanation":"低价买进，高价卖出。","source":{"text":"至于涉险履危，梯山航海，贱入贵出，贸易开张，能思善算。","book":"明·方汝浩《禅真逸史》第一回"},"example":{"text":"做生意就是要靠～赚钱。"},"similar":["贱买贵卖"],"usage":"作宾语、定语；指经商"},{"id":42004,"word":"贱敛贵出","pinyin":"jiàn liǎn guì chū","abbr":"jlgc","explanation":"低价卖进，高价卖出。","source":{"text":"恒平物估，贼敛贵出。","book":"唐·韩愈《曹成王碑》"},"similar":["低进高出","贱买贵卖","贱敛贵发"],"usage":"作谓语、定语；指古代平抑粮价的措施"},{"id":42005,"word":"贱敛贵发","pinyin":"jiàn liǎn guì fā","abbr":"jlgf","explanation":"低价卖进，高价卖出。同“贱敛贵出”。","source":{"text":"既至河南，清净惠下，贱敛贵发，以便民。","book":"《新唐书·郑珣瑜传》"},"similar":["贱敛贵出"],"usage":"作谓语、定语；指古代平抑粮价的措施"},{"id":42006,"word":"贱目贵耳","pinyin":"jiàn mù guì ěr","abbr":"jmge","explanation":"指轻视眼前所见，重视远道传闻。比喻舍近求远。","source":{"text":"世人舍此而求补药于远域，岂非贱目贵耳乎？","book":"明·李时珍《本草纲目·草三·蛇床》"},"example":{"text":"而～者，顾谓今不如古，方隅之别也。","book":"清·李调元《序》"},"similar":["贵耳贱目"],"opposite":["眼见为实"],"usage":"作谓语、宾语；指相信传闻"},{"id":42007,"word":"贱骨头","pinyin":"jiàn gǔ tóu","abbr":"jgt","explanation":"指不自尊、不知羞耻或不知好歹的人。","source":{"text":"人太生娇俏了，可知心就嫉妒。凤丫头倒好意待他，他倒这样争锋吃醋的。可是个贱骨头。","book":"清·曹雪芹《红楼梦》第69回"},"example":{"text":"他就是～的命。"},"opposite":["金枝玉叶"],"usage":"作主语、宾语、定语；骂人的话","story":["贾琏私自娶了尤二姐，王熙凤将她接回荣国府，正准备想办法来算计尤二姐时，贾赦将身边丫头秋桐赏给贾琏为妾。这秋桐眼中容不下尤二姐，到贾母那里告状，贾母没有核实就感慨说：“凤丫头倒好意待他，他倒这样争锋吃醋的。可是个贱骨头。”"]},{"id":42008,"word":"贲军之将","pinyin":"bēn jūn zhī jiàng","abbr":"bjzj","explanation":"贲：覆败。打了败仗的将领。","source":{"text":"贲军之将，亡国之大夫。","book":"西汉·戴圣《礼记·射仪》"},"example":{"text":"我们不要笑话～。"},"similar":["败军之将"],"opposite":["常胜将军"],"usage":"作主语、宾语；指败将"},{"id":42009,"word":"贲育之勇","pinyin":"bēn yù zhī yǒng","abbr":"byzy","explanation":"贲：孟贲；育：夏育。二人都是秦武王时的壮士。孟贲、夏育的勇气。泛指壮士的勇气。","source":{"text":"力称乌获，捷言庆志，勇期贲育。","book":"东汉·班固《汉书·司马相如传下》"},"example":{"text":"愿抑～，怀王霸之计。","book":"明·罗贯中《三国演义》第53回"},"usage":"作宾语；指勇士"},{"id":42010,"word":"贵不凌贱","pinyin":"guì bù líng jiàn","abbr":"gblj","explanation":"凌：欺侮，逼迫。富贵的人不欺侮贫贱的人。","source":{"text":"昔吾先君桓公能任用贤，国有什伍，治偏细民，贵不凌贱，富不傲贫，功不遗罢，佞不吐愚。","book":"《晏子春秋·内篇问上》"},"usage":"作宾语、定语；用于处世"},{"id":42011,"word":"贵不召骄","pinyin":"guì bù zhào jiāo","abbr":"gbzj","explanation":"指显贵的人尽管不希望自己染上骄恣专横的习气，但它仍然在不知不觉中滋长起来了。","source":{"text":"贵不召骄，富不期移，是此四者，倏相首尾。","book":"唐·杜牧《岐阳公主墓志铭》"},"similar":["贵不期骄"],"usage":"作宾语、定语；用于书面语"},{"id":42012,"word":"贵不可言","pinyin":"guì bù kě yán","abbr":"gbky","explanation":"极其高贵，以至无法用语言来表达。旧时相面的人卜测人的前程时常说的话。","source":{"text":"老父曰：‘向者夫人、婴儿皆似君，君相贵不可言。’高祖乃谢曰：‘诚如父言，不敢忘德。’","book":"《史记·高祖本纪》"},"example":{"text":"仆相君之面，不过封侯，相君之背，～也。","book":"明·沈采《千金记·游说》"},"usage":"作谓语、定语；指很富贵"},{"id":42013,"word":"贵不期骄","pinyin":"guì bù qī jiāo","abbr":"gbqj","explanation":"指显贵的人尽管不希望自己染上骄恣专横的习气，但它仍然在不知不觉中滋长起来了。","source":{"text":"贵不与骄期，而骄自至；富不与侈期，而侈自来，骄侈以行己，所以速亡。","book":"语本《书·周官》：“位不期骄，禄不期侈。”孔传"},"example":{"text":"魏微上疏，以为：陛下欲善之志不及于昔时，闻过必改少亏于曩日，谴罚积多，威怒微厉，乃知～，富不期移，非虚言也。","book":"《资治通鉴·唐太宗贞观十一年》"},"similar":["贵不召骄"],"usage":"作宾语、定语；用于书面语"},{"id":42014,"word":"贵人善忘","pinyin":"guì rén shàn wàng","abbr":"grsw","explanation":"用来嘲讽人善忘。","source":{"text":"就是大帅前日，也曾推举项城，难道是贵人善忘吗？","book":"蔡东藩《民国通俗演义》第64回"},"example":{"text":"钱教授上了年纪，又身兼多项要职，难怪他～，把我们的要求抛到九霄云外了。"},"similar":["贵人多忘"],"usage":"作定语、宾语；用于讥笑人"},{"id":42015,"word":"贵人多忘","pinyin":"guì rén duō wàng","abbr":"grdw","explanation":"贵人：地位贵显的人。指地位显赫的人往往不念旧交或讥笑人健忘。","source":{"text":"倘也贵人多忘，国士难期，使仆一朝出其不意，与君并肩内阁，侧眼相视，公始悔而谢仆，仆安能有色于君乎？","book":"五代·王定保《唐摭言·恚恨》"},"example":{"text":"我怎敢恰为官～。","book":"元·宫大用《范张鸡黍》第四折"},"similar":["贵人多忘事","贵人善忘"],"usage":"作定语、宾语；用于讥笑人","story":["唐朝时王泠然虽然中进士但没有授官职，他日夜思索如何跻身于官场，想起自己曾与御史大夫高昌宇有过交往，只是当官后把他给忘了，于是提笔给他写信，信中用威胁的口吻说如果因做官成贵人而把朋友忘记，将来朋友做官也会以牙还牙的"]},{"id":42016,"word":"贵人多忘事","pinyin":"guì rén duō wàng shì","abbr":"grdws","explanation":"高贵者往往善忘。原指高官态度傲慢，不念旧交，后用于讽刺人健忘。","source":{"text":"倘也贵人多忘，国士难期，使仆一朝出其不意，与君并肩台阁，侧眼相视，公始悔而谢仆，仆安能有色于君乎？","book":"五代·王定保《唐摭言》卷二"},"example":{"text":"你老是～了，那里还记得我们？","book":"清·曹雪芹《红楼梦》第四回"},"similar":["贵人多忘"],"usage":"作定语、宾语；用于讽刺人健忘","story":["唐朝时王泠然虽然中进士但没有授官职，他日夜思索如何跻身于官场，想起自己曾与御史大夫高昌宇有过交往，只是当官后把他给忘了，于是提笔给他写信，信中用威胁的口吻说如果因做官成贵人而把朋友忘记，将来朋友做官也会以牙还牙的"]},{"id":42017,"word":"贵人眼高","pinyin":"guì rén yǎn gāo","abbr":"gryg","explanation":"贵人：地位显贵的人；眼高：藐视一切。指地位高贵的人瞧不起他人。","source":{"text":"忘了？这真是贵人眼高……","book":"鲁迅《故乡》"},"usage":"作宾语、定语；用于讥笑等"},{"id":42018,"word":"贵人贱己","pinyin":"guì rén jiàn jǐ","abbr":"grjj","explanation":"认为自己不如别人，表示谦虚。","source":{"text":"君子贵人而贱己，先人而后己。","book":"《礼记·坊记》"},"usage":"作谓语、定语、宾语；用于自谦"},{"id":42019,"word":"贵冠履轻头足","pinyin":"guì guān lǚ qīng tóu zú","abbr":"gglqtz","explanation":"比喻主次或轻重颠倒。","source":{"text":"今重法而弃义，是贵其冠而忘其头足也。","book":"《淮南子·泰族训》"},"similar":["本末倒置"],"usage":"作谓语、定语；指轻重颠倒"},{"id":42020,"word":"贵古贱今","pinyin":"guì gǔ jiàn jīn","abbr":"ggjj","explanation":"只看重古代的事，而看不起当代的事。","source":{"text":"自古体大而思精，未有此也，恐世人不能尽之，多贵古贱今，所以称情狂言耳。","book":"南朝·宋·范晔《狱中与诸甥侄书以自序》"},"example":{"text":"《宋书·范晔传》：“恐世人不能尽之，多～，所以称情狂言耳。”"},"similar":["今非古是"],"usage":"作谓语、定语；指对待古今的态度"},{"id":42021,"word":"贵在知心","pinyin":"guì zài zhī xīn","abbr":"gzzx","explanation":"以知心交心为贵，指朋友之间心心相印。","example":{"text":"年轻人交朋友，～。"},"similar":["心心相印"],"usage":"作宾语；指朋友之间","story":["管仲年少生与鲍叔牙是好朋友，管仲经常骗取鲍叔牙的财物，后因鲍叔牙跟随齐国公子小白，管仲侍奉公子纠，小白和纠争位，管仲射中小白。小白即位后为齐桓公，鲍叔牙推荐管仲为丞相，管仲感叹：“知我者鲍叔牙也。”"]},{"id":42022,"word":"贵壮贱弱","pinyin":"guì zhuàng jiàn ruò","abbr":"gzjr","explanation":"看重年轻力壮者而轻视年老体弱者。同“贵壮贱老”。","source":{"text":"贵壮贱弱，母拜子，子倔父，出入前少而后老。","book":"《新唐书·吐蕃传上》"},"similar":["贵壮贱老","贵少贱老"],"usage":"作谓语、定语；指对待老年与青年的态度"},{"id":42023,"word":"贵壮贱老","pinyin":"guì zhuàng jiàn lǎo","abbr":"gzjl","explanation":"看重年轻力壮者而轻视年老体弱者。","source":{"text":"看重年轻力壮者而轻视年老体弱者。"},"example":{"text":"看重年轻力壮者而轻视年老体弱者。"},"similar":["贵壮贱弱","贵少贱老"],"usage":"作谓语、定语；指对待老年与青年的态度"},{"id":42024,"word":"贵官显宦","pinyin":"guì guān xiǎn huàn","abbr":"ggxh","explanation":"显：显要，显赫。指官职很高，爵位显赫。","source":{"text":"凡是湖北省里的贵官显宦……他没有一个不认得。","book":"清·李宝嘉《官场现形记》第38回"},"similar":["高官显宦","高官尊爵","高爵显位"],"usage":"作谓语、宾语、定语；指官位高"},{"id":42025,"word":"贵少贱老","pinyin":"guì shǎo jiàn lǎo","abbr":"gsjl","explanation":"看重年轻力壮者而轻视年老体弱者。同“贵壮贱老”。","source":{"text":"壮者食肥美，老者食其馀。贵壮健，贱老弱。","book":"《史记·匈奴列传》"},"example":{"text":"“乌桓、鲜卑即古所谓东胡也”裴松之注引晋·王沈《魏书》：“乌丸者，东胡也……～，其性悍骜。”","book":"《三国志·魏志·乌桓鲜卑东夷传》"},"similar":["贵壮贱老","贵壮贱弱"],"usage":"作谓语、定语；指对待老年与青年的态度"},{"id":42026,"word":"贵德贱兵","pinyin":"guì dé jiàn bīng","abbr":"gdjb","explanation":"贵德：重视德行；贱兵：轻视武力。比喻重德行感化，不重强制刑罚。","source":{"text":"古者贵以德而贱用兵。","book":"汉·桓宽《盐铁论·本议》"}},{"id":42027,"word":"贵戚权门","pinyin":"guì qī quán mén","abbr":"gqqm","explanation":"高贵的皇亲国戚和有权势的豪门世族。","source":{"text":"皆交游贵戚，奉趋权门。","book":"《汉书·息夫躬传》"},"example":{"text":"～得笔迹，始觉屏障生光辉。","book":"唐·杜甫《韦风录事宅观曹将军画马图引》"},"similar":["豪门贵族","名门望族"],"usage":"作主语、宾语、定语；用于书面语"},{"id":42028,"word":"贵手高抬","pinyin":"guì shǒu gāo tái","abbr":"gsgt","explanation":"贵：敬辞。向人乞求原谅的话。","source":{"text":"望乞公子贵手高抬，开一线之恩，饶他们去罢。","book":"清·石玉昆《三侠五义》第44回"},"similar":["高抬贵手"],"usage":"作谓语、定语；用于求人等"},{"id":42029,"word":"贵无常尊","pinyin":"guì wú cháng zūn","abbr":"gwcz","explanation":"人不可能永远处在尊贵的地位。","source":{"text":"贵无常尊，贱不指卑。不明厥德，国用颠危。","book":"晋·傅玄《吏部尚书箴》"},"usage":"作宾语、定语；用于劝诫人"},{"id":42030,"word":"贵极人臣","pinyin":"guì jí rén chén","abbr":"gjrc","explanation":"君主时代指大臣中地位最高的人。","source":{"text":"贵极人臣，富兼山海，居止第宅，匹于帝宫。","book":"北魏·杨衒之《洛阳伽蓝记·高阳王寺》"},"example":{"text":"～，独不可见其子为卿监法从乎！","book":"宋·陈亮《祭王道甫母太宜人文》"},"similar":["位极人臣"],"usage":"作谓语；指高官"},{"id":42031,"word":"贵游子弟","pinyin":"guì yóu zǐ dì","abbr":"gyzd","explanation":"游：游闲，即无官职的。没有官职的贵族子弟。","source":{"text":"凡国之贵游子弟学焉。","book":"《周礼·地官·师氏》"},"example":{"text":"～，生乎深宫之中，长乎妇人之手，忧惧之劳，未尝经心。","book":"《抱朴子·崇教》"},"similar":["公子哥儿","纨绔子弟"],"usage":"作主语、宾语、定语；用于书面语"},{"id":42032,"word":"贵而贱目","pinyin":"guì ér jiàn mù","abbr":"gejm","explanation":"比喻相信传说，不重视事实。","source":{"text":"若客所谓，末学肤受，贵耳而贱目者也。","book":"汉·张衡《东京赋》"}},{"id":42033,"word":"贵耳贱目","pinyin":"guì ěr jiàn mù","abbr":"gejm","explanation":"重视传来的话，轻视亲眼看到的现实。比喻相信传说，不重视事实。","source":{"text":"若客所谓，末学肤受，贵耳而贱目者也。","book":"汉·张衡《东京赋》"},"example":{"text":"太守何得～。","book":"宋·释普济《五灯会元》卷五"},"usage":"作谓语、定语；比喻相信传说，不重视事实"},{"id":42034,"word":"贵贱无二","pinyin":"guì jiàn wú èer","abbr":"gjwe","explanation":"对高贵和卑贱的人态度一样。","source":{"text":"敬遇宾客，贵贱无二。","book":"周·吕尚《金匮》"},"similar":["一视同仁"],"usage":"作谓语、定语；指对人的态度"},{"id":42035,"word":"贵贱无常","pinyin":"guì jiàn wú cháng","abbr":"gjwc","explanation":"人的身份地位并不是永恒不变的。","source":{"text":"《前汉·艺文志》有《鹖冠子》一篇，今所行四卷十五篇。如所谓‘中流失般，一壶千金’、‘贵贱无常，物使之然’皆出于是。","book":"宋·王楙《野客丛书·鹖冠子》"},"usage":"作谓语、宾语；指贵贱可以转变"},{"id":42036,"word":"贵贱高下","pinyin":"guì jiàn gāo xià","abbr":"gjgx","explanation":"指人的社会地位高低不同。","source":{"text":"王曰：‘风者，天地之气，溥畅而不至，不择贵贱高下而加焉。","book":"战国·楚·宋玉《风赋》"},"similar":["高低贵贱"],"usage":"作宾语、定语；用于比较等"},{"id":42037,"word":"贵远贱近","pinyin":"guì yuǎn jiàn jìn","abbr":"gyjj","explanation":"以为与当世相隔久远的就珍贵，相隔近的就低贱。","source":{"text":"杨班俦也，常人贵远贱近，向声背实，又患瘖于自见。","book":"三国·魏·曹丕《论文》"},"example":{"text":"论“文变”的人，对于“时”多少持着平等观，但也还不免～或“竞今疏古”的偏见。","book":"朱自清《正变》"},"similar":["厚古薄今","贵远鄙近"],"opposite":["远攻近交"],"usage":"作谓语、定语；指人看不见眼前的东西"},{"id":42038,"word":"贵远鄙近","pinyin":"guì yuǎn bǐ jìn","abbr":"gybj","explanation":"以为与当世相隔久远的就珍贵，相隔近的就低贱。同“贵远贱近”。","source":{"text":"楚人发语之辞曰羌曰蹇，平语之辞曰些，一经屈宋采用，后世遂为佳句，但世俗常情，不能无贵远鄙近耳。","book":"胡仔《苕溪渔隐丛话前集·香山居士》引宋·蔡宽夫《诗话》"},"similar":["贵远贱近"],"usage":"作谓语、定语；指人看不见眼前的东西"},{"id":42039,"word":"贵阴贱璧","pinyin":"guì yīn jiàn bì","abbr":"gyjb","explanation":"贵重光阴甚于玉璧。比喻时间的宝贵。","source":{"text":"故圣人不贵尺之璧，而重寸之阴，时难得而易失也。","book":"西汉·刘安《淮南子·原道训》"},"example":{"text":"夫～，圣所约也；颠倒衣裳，明所箴也。","book":"《晋书·皇甫谧传》"},"usage":"作谓语；比喻时间的宝贵"},{"id":42040,"word":"贸迁有无","pinyin":"mào qiān yǒu wú","abbr":"mqyw","explanation":"买卖货物。指商业上货物买卖，互通有无。","source":{"text":"贸迁有无，各得其所。","book":"《晋书·食货志》"},"example":{"text":"～，和其众寡。","book":"唐·陈子昂《临邛县令封君遗爱碑》"},"similar":["懋迁有无"],"usage":"作谓语、宾语；指买卖"},{"id":42041,"word":"贸首之仇","pinyin":"mào shǒu zhī chóu","abbr":"mszc","explanation":"贸首：要得到对方的头颅。指不共戴天的深仇大恨。","source":{"text":"甘茂与樗里疾，贸首之仇也。","book":"《战国策·楚策二》"},"example":{"text":"嗟呼，妒之欺善，抑亦～也。","book":"晋·潘岳《马汧督诔》"},"similar":["深仇大恨","贸首之雠"],"usage":"作宾语；指深仇大恨"},{"id":42042,"word":"贸首之雠","pinyin":"mào shǒu zhī chóu","abbr":"mszc","explanation":"形容仇恨极深，乃欲谋取对方的头颅才甘心。贸，通“牟”。","source":{"text":"甘茂与樗里疾，贸首之雠也。","book":"西汉·刘向《战国策·楚策二》"},"example":{"text":"民吾之赤子，有害我赤子者，此～也，孰能宽？","book":"明·赵南星《送胡清宇老先生令介休序》"},"similar":["贸首之仇"],"usage":"作宾语；指深仇大恨"},{"id":42043,"word":"费力不讨好","pinyin":"fèi lì bù tǎo hǎo","abbr":"flbth","explanation":"指白费功夫，没有取得成效，相反带来坏的影响。","example":{"text":"这真是～的事情。"},"similar":["吃力不讨好"],"usage":"作宾语、定语；指白费功夫"},{"id":42044,"word":"费力劳心","pinyin":"fèi lì láo xīn","abbr":"fllx","explanation":"耗费气力和心思。","source":{"text":"吾为汝御敌，费力劳心。汝今积财吝赏，何以使士卒效命乎？","book":"明·罗贯中《三国演义》第62回"},"example":{"text":"我不想干这～的事。"},"similar":["费心劳力"],"usage":"作谓语、定语；指操心"},{"id":42045,"word":"费力劳神","pinyin":"fèi lì láo shén","abbr":"flls","explanation":"耗费力量和精神。","source":{"text":"若不肯投降，必当擒来，奉献兄长，亦不须用众头领张弓挟矢，费力劳神。","book":"明·施耐庵《水浒传》第67回"},"usage":"作谓语、定语；用于处事"},{"id":42046,"word":"费尽心思","pinyin":"fèi jìn xīn sī","abbr":"fjxs","explanation":"心思：计谋。挖空心思，想尽办法。","source":{"text":"而近年一种议论，乃欲周旋于二者之间，问互委曲，费尽心机。","book":"宋·朱熹《朱文公文集·与杨子直书》"},"example":{"text":"后儒牵强附会，～，不知都是古今学不分明的缘故。","book":"清·曾朴《孽海花》第十一回"},"similar":["费尽心机"],"usage":"作谓语、宾语、状语；用于人思虑谋划"},{"id":42047,"word":"费尽心机","pinyin":"fèi jìn xīn jī","abbr":"fjxj","explanation":"心机：计谋。挖空心思，想尽办法。","source":{"text":"而近年一种议论，乃欲周旋于二者之间，问互委曲，费尽心机。","book":"宋·朱熹《朱文公文集·与杨子直书》"},"example":{"text":"若不投其所好，怎得重用？因此～，访得今日是他生日，预差人浇成一对寿烛。","book":"明·王世贞《鸣凤记》第四出"},"similar":["煞费苦心","冥思苦想"],"opposite":["无所用心"],"usage":"作谓语、宾语；用于人思虑谋划"},{"id":42048,"word":"费心劳力","pinyin":"fèi xīn láo lì","abbr":"fxll","explanation":"耗费气力和心思。","source":{"text":"三个妖魔，也费心劳力的来报遭信。","book":"明·吴承恩《西游记》第74回"},"example":{"text":"这是～的事情。"},"similar":["费力劳心"],"usage":"作谓语、定语；指操心"},{"id":42049,"word":"费舌劳唇","pinyin":"fèi shé láo chún","abbr":"fslc","explanation":"说了很多很多的话。","source":{"text":"那过善本来病势已有八九分了，却又勉强料理这事，喉长气短，费舌劳唇，劳碌这半日，到晚上愈加沉重。","book":"明·冯梦龙《醒世恒言》卷十七"},"similar":["白费口舌"],"usage":"作谓语、宾语、定语；用于说话等"},{"id":42050,"word":"费财劳民","pinyin":"fèi cái láo mín","abbr":"fclm","explanation":"耗费财物，劳苦百姓。","source":{"text":"诚费财劳民以为无功，又从而怨之，是寡人之罪也。","book":"《晏子春秋·内篇谏下》"},"similar":["劳民伤财"],"usage":"作宾语、定语；用于不利的事情"},{"id":42051,"word":"贻人口实","pinyin":"yí rén kǒu shí","abbr":"yrks","explanation":"贻：遗留；口实：话柄。指做事或说话不小心，给人家留下了话柄。","source":{"text":"若能相与有成，将来为人传诵，则后来人人发愤向学，其父母亦尊师重傅；倘不能有成，后来反贻他人口实。","book":"《尚书·仲虺之诰》：“于恐来世以台为口实。”明·朱之瑜《与东守约书二十五首》"},"example":{"text":"世续知其隐，言于光绪帝，谓庆宽为醇贤亲王赏识之人，父功之，子罪之，未免～。（清·李宝嘉《南亭笔记》卷二）"},"similar":["授人口实","遗人口实","予人口实"],"opposite":["无懈可击","无瑕可击"],"usage":"作谓语、宾语；指留下话柄"},{"id":42052,"word":"贻厥孙谋","pinyin":"yí jué sūn móu","abbr":"yjsm","explanation":"贻：遗留；厥：其，他的；谋：计谋，打算。为子孙的将来作好安排。","source":{"text":"明明我祖，万邦之君，有典有则，贻厥子孙。","book":"《尚书·五子之歌》"},"example":{"text":"曾不知防虑于此，岂所谓～乎？","book":"晋·习凿齿《襄阳记》"},"similar":["诒厥孙谋","诒厥之谋"],"usage":"作谓语、定语；指长远安排"},{"id":42053,"word":"贻害无穷","pinyin":"yí hài wú qióng","abbr":"yhwq","explanation":"贻：遗留。留下无穷的祸患。","source":{"text":"炉鼎铅汞，皆是寓言，非言炼烧。方士转向附会，遂贻害无穷。","book":"汉·魏伯阳《参同契》"},"example":{"text":"弄到今日国穷民困，～，思想起来，实实令人可恨。","book":"清·李宝嘉《文明小史》第十七回"},"similar":["后患无穷","遗祸无穷","遗患无穷"],"opposite":["斩草除根"],"usage":"作谓语、定语；用于劝诫人"},{"id":42054,"word":"贻患无穷","pinyin":"yí huàn wú qióng","abbr":"yhwq","explanation":"贻：遗留。留下无穷的祸患。","source":{"text":"炉鼎铅汞，皆是寓言，非言炼烧。方士转向附会，遂贻害无穷。","book":"汉·魏伯阳《参同契》"},"example":{"text":"要是给旁人盗去传之于外，辗转落入狂妄自大、心胸狭窄之辈手中，那未免～，决非武林之福。","book":"金庸《天龙八部》第三十九章"},"similar":["贻害无穷","遗患无穷"],"usage":"作谓语、定语；用于劝诫人"},{"id":42055,"word":"贻燕之训","pinyin":"yí yàn zhī xùn","abbr":"yyzx","explanation":"燕：通“宴”，安闲。给后人留下谋求安乐的话。","source":{"text":"呜呼吾家世以清简，垂为贻燕之训。","book":"唐·白居易《许昌县令新厅壁记》"},"usage":"作宾语；用于书面语"},{"id":42056,"word":"贻玷阀阅","pinyin":"yí diàn fá yuè","abbr":"ydfy","explanation":"贻：遗留；玷：污；阀阅：古代官宦人家门前立的两根柱子，后为名门贵族的代称。指玷污了官家门户。","source":{"text":"失节贪生，贻玷阀阅，妾且就死，以谢蔡氏之宗于地下。","book":"明·冯梦龙《醒世恒言》卷三十六"}},{"id":42057,"word":"贻笑万世","pinyin":"yí xiào wàn shì","abbr":"yxws","explanation":"贻笑：见笑。让千秋万代的人见笑。","source":{"text":"何况宗庙大礼，至尊至重，岂可以一时之宠，独决圣心，义有僭失，贻笑万世，亏损盛明，悔不可追。","book":"宋·刘敞《论温成立忌》"},"similar":["贻笑千秋","贻笑千古"],"usage":"作谓语、定语；用于书面语"},{"id":42058,"word":"贻笑千古","pinyin":"yí xiào qiān gǔ","abbr":"yxqg","explanation":"贻笑：让人笑话；千古：久远的年代。不光彩的行为，让千秋万代的人讥笑。","source":{"text":"不然，则流遁忘反，为风波之行，自驱以物，自诳以伪，外眩嚣华，内丧道实，以矜尚夺其真主，以尘垢翳其天正，贻笑千载，可不慎欤！","book":"《晋书·戴逵传》"},"example":{"text":"古之赵括，蜀汉马谡，都曾烂读兵书，狂言知兵，却兵败身死，～。","book":"二月河《康熙大帝》十五"},"similar":["贻笑千秋","贻笑万世"],"usage":"作谓语、定语；用于书面语"},{"id":42059,"word":"贻笑千秋","pinyin":"yí xiào qiān qiū","abbr":"yxqq","explanation":"贻笑：让人笑话；千秋：久远的年代。不光彩的行为，让千秋万代的人讥笑。","source":{"text":"不然，则流遁忘反，为风波之行，自驱以物，自诳以伪，外眩嚣华，内丧道实，以矜尚夺其真主，以尘垢翳其天正，贻笑千载，可不慎欤！","book":"《晋书·戴逵传》"},"example":{"text":"到底甘尽苦来，一身不保，落得～。","book":"清·褚人获《隋唐演义》第四十七回"},"similar":["贻笑千古","贻笑万世"],"usage":"作谓语、定语；用于书面语"},{"id":42060,"word":"贻笑千载","pinyin":"yí xiào qiān zǎi","abbr":"yxqz","explanation":"贻笑：让人笑话；千载：久远的年代。不光彩的行为，让千秋万代的人讥笑。","source":{"text":"不然，则流遁忘反，为风波之行，自驱以物，自诳以伪，外眩嚣华，内丧道实，以矜尚夺其真主，以尘垢翳其天正，贻笑千载，可不慎欤！","book":"《晋书·戴逵传》"},"example":{"text":"故求之不得，则伪造以欺人；得之则君臣色喜，以夸示于天下。是皆～。","book":"《明史·舆服志》"}},{"id":42061,"word":"贻笑后人","pinyin":"yí xiào hòu rén","abbr":"yxhr","explanation":"贻：留下；后人：后世的人。因为荒唐，而让后人耻笑，给后代留下话柄。","source":{"text":"刘钧忍耻事虏，效尤石敬瑭故智也。怎不诒笑后人哉？","book":"宋·无名氏《新编五代史平话·周史》卷下"}},{"id":42062,"word":"贻笑大方","pinyin":"yí xiào dà fāng","abbr":"yxdf","explanation":"贻笑：让人笑话；大方：原指懂得大道的人，后泛指见识广博或有专长的人。指让内行人笑话。","source":{"text":"吾长见笑于大方之家。","book":"《庄子·秋水》"},"example":{"text":"去岁路过贵邦，就要登堂求教；但愧知识短浅，诚恐～，所以不敢冒昧进谒。","book":"清·李汝珍《镜花缘》第五十二回"},"similar":["见笑大方","遗笑大方"],"usage":"作谓语、宾语、定语；用于自谦"},{"id":42063,"word":"贻臭万年","pinyin":"yí chòu wàn nián","abbr":"ycwn","explanation":"犹言遗臭万年。","source":{"text":"桓玄子恒言‘不能流芳百世，亦当贻臭万年’，至今为书生骂端。","book":"明·王世贞《艺苑卮言》卷三"},"example":{"text":"瞿琰道：‘观尔等一貌堂堂，足称伟士，若能改恶从善，归顺天朝，为国家干功立业，流芳百世，煞胜似陷身不义，～。’","book":"明·清溪道人《禅真后史》第四十七回"},"similar":["遗臭万年"],"opposite":["流芳百世"],"usage":"作谓语、定语、宾语；用于坏人"},{"id":42064,"word":"贻范古今","pinyin":"yí fàn gǔ jīn","abbr":"yfgj","explanation":"贻：遗留。给世世代代的人留下榜样。","source":{"text":"今则公之教可以精通显晦，贻范古今。","book":"唐·孙揆《灵应传》"},"usage":"作谓语、定语；用于书面语"},{"id":42065,"word":"贻诮多方","pinyin":"yí qiào duō fāng","abbr":"yqdf","explanation":"受到各方面的责备。","source":{"text":"尘污近辅，贻诮多方，绩效不扬，讥议上彻。","book":"宋·苏舜钦《杜公谢官表》"},"usage":"作谓语、定语；用于书面语"},{"id":42066,"word":"贻误军机","pinyin":"yí wù jūn jī","abbr":"ywjj","explanation":"贻：贻害。耽误了作战大事。","source":{"text":"二十一年春正月庚本，以额附科尔沁亲王色布腾巴勒珠尔贻误军机，褫爵禁锢。","book":"《清史稿·高家本纪三》"},"similar":["贻误战机"],"usage":"作谓语、宾语；指误了大事"},{"id":42067,"word":"贻误后学","pinyin":"yí wù hò xué","abbr":"ywhx","explanation":"后学：后来的学习者。错误遗留下去，使后来学习的人受到不好的影响。","source":{"text":"邕以经籍去圣久远，文字多谬，俗儒穿凿，贻误后学。","book":"《后汉书·蔡邕传》"},"example":{"text":"我现在要给他刻集子，看见里头很多不通的、欺人的、错误的，我要给他大大改削，免得～。","book":"清·曾朴《孽海花》第三回"}},{"id":42068,"word":"贼不空手","pinyin":"zéi bù kōng shǒu","abbr":"zbks","explanation":"贼：偷东西的人。偷东西的人不会空手而回，一定要有所得。","source":{"text":"拔众而归，盖所以全之，非贼人讳空手谓也。","book":"宋·朱熹《答何叔京》"},"usage":"作宾语、定语；用于比喻句"},{"id":42069,"word":"贼人心虚","pinyin":"zéi rén xīn xū","abbr":"zrxx","explanation":"指做了坏事的人，时刻胆战心惊，怕坏事败露。","source":{"text":"自古道贼人心虚，那赵昂因有旧事在心上，比王员外更是不同，吓的魂魄俱无。","book":"明·冯梦龙《醒世恒言》第二十卷"},"example":{"text":"忽见建德县差人拿片子来请他进城，说是有话面谈，究竟～，不觉吓了一跳。","book":"清·李宝嘉《官场现形记》第十六回"},"similar":["做贼心虚","贼人胆虚"],"usage":"作宾语、定语；用于书面语"},{"id":42070,"word":"贼人胆虚","pinyin":"zéi rén dǎn xū","abbr":"zrdx","explanation":"比喻做了坏事的人心里总是不踏实。","source":{"text":"自古道，贼人心虚。那赵昂因有旧事在心上，比王员外更是不同，吓得魂魄俱无。","book":"明·冯梦龙《醒世恒言》卷十六"},"example":{"text":"这本是鸳鸯戏语，叫他出来，谁知他～，只当鸳鸯已看见他的首尾了。","book":"清·曹雪芹《红楼梦》第七十一回"},"similar":["做贼心虚"],"usage":"作宾语、定语；指小偷、坏人等"},{"id":42071,"word":"贼出关门","pinyin":"zéi chū guān mén","abbr":"zcgm","explanation":"贼偷了东西走后才去关门。比喻事故发生之后才采取防范措施。","source":{"text":"僧问曰：‘若不遇于师，几成走作。’师曰：‘贼去后关门。’","book":"宋·释道原《景德传灯录》卷二十一"}},{"id":42072,"word":"贼去关门","pinyin":"zéi qù guān mén","abbr":"zqgm","explanation":"贼偷了东西走后才云关门。比喻事故发生之后才采取防范措施。","source":{"text":"僧问曰：‘若不遇于师，几成走作。’师曰：‘贼去后关门。’","book":"宋·释道原《景德传灯录》卷二十一"},"example":{"text":"这里～，众人更加小心，不敢睡觉。","book":"清·曹雪芹《红楼梦》第一一二回"},"similar":["亡羊补牢"],"usage":"作谓语、定语；指事后防范"},{"id":42073,"word":"贼喊捉贼","pinyin":"zéi hǎn zhuō zéi","abbr":"zhzz","explanation":"做贼的人喊捉贼。比喻坏人为了自己逃脱，故意制造混乱，转移目标，把别人说成是坏人。","source":{"text":"魏武少时，尝与袁绍好为游侠，观人新婚，因潜入主人园中，夜叫呼云：‘有偷儿贼。’青庐中人皆出现……绍遑迫自掷出，遂以俱免。","book":"南朝·宋·刘义庆《世说新语·假谲》"},"example":{"text":"这个狡滑的小偷，偷了人家的钱后，还～，嫁祸于人。"},"similar":["倒打一耙","颠倒黑白"],"usage":"作谓语、定语、分句；指混淆视听"},{"id":42074,"word":"贼夫人之子","pinyin":"zéi fū rén zhī zǐ","abbr":"zfrzz","explanation":"贼：毁坏；夫：这，那。害了人家的儿子。对引导别人犯错误者的斥责","source":{"text":"子路使子羔为费宰。子曰：‘贼夫人之子！’","book":"春秋·鲁·孔丘《论语·先进》"},"example":{"text":"晋·孙盛《魏氏春秋》：“盛以此为美谈，无乃～与？”"},"usage":"作宾语；用于书面语"},{"id":42075,"word":"贼头狗脑","pinyin":"zéi tóu gǒu nǎo","abbr":"ztgn","explanation":"偷偷摸摸、鬼鬼祟祟的样子。同“贼头鼠脑”。","source":{"text":"今天楼上家中老少和一班女眷都在看，刘奎璧对着楼上贼头狗脑，以致第三箭失手。","book":"《再生缘》第一回"},"example":{"text":"刘仁兄，我看那押解的官儿～，不是个好人，我们要提防一二。","book":"欧阳予倩《木兰从军》第四场"},"similar":["贼头贼脑","贼头鬼脑","贼头鼠脑"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":42076,"word":"贼头贼脑","pinyin":"zéi tóu zéi nǎo","abbr":"ztzn","explanation":"形容举动偷偷摸摸，不光明正大。","source":{"text":"哥啊，我晓得，你贼头鼠脑的，一定又变作个甚么东西儿。","book":"明·吴承恩《西游记》第三十一回"},"example":{"text":"他们大凡吃物，不肯大大方方，总是～，躲躲藏藏，背人而食。","book":"清·李汝珍《镜花缘》第十四回"},"similar":["贼眉鼠眼","贼头鼠脑"],"opposite":["光明正大"],"usage":"作定语、宾语；指人的长相"},{"id":42077,"word":"贼头鬼脑","pinyin":"zéi tóu guǐ nǎo","abbr":"ztgn","explanation":"偷偷摸摸、鬼鬼祟祟的样子。同“贼头鼠脑”。","source":{"text":"太太，这个外国人贼头鬼脑，我总疑着他。","book":"清·曾朴《孽海花》第二十四回"},"example":{"text":"景藩便皱着眉喝道：‘在那儿～的干什么？滚出去！’","book":"张爱玲《小艾》"},"similar":["贼头狗脑","贼头鼠脑"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":42078,"word":"贼头鼠脑","pinyin":"zéi tóu shǔ nǎo","abbr":"ztsn","explanation":"偷偷摸摸、鬼鬼祟祟的样子。","source":{"text":"八戒道:‘哥啊，我晓得。你贼头鼠脑的，一定又变作个甚么东西儿跟着我听的。’","book":"明·吴承恩《西游记》第三十一回"},"example":{"text":"妇人道:‘我这屋里再有谁来？敢是你～，偷了我这只鞋去了？’","book":"明·兰陵笑笑生《金瓶梅词话》第二十八回"},"similar":["贼头鬼脑","贼头狗脑","贼头贼脑"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":42079,"word":"贼子乱臣","pinyin":"zéi zǐ luàn chén","abbr":"zzlc","explanation":"指心怀异志、为奸作恶的人。","source":{"text":"国恶虽讳，君举必书，故贼子乱臣，天下大惧，元龟明镜，昭然可察。","book":"唐·魏徵寿《隋书·许善心传》"},"example":{"text":"忠臣义士，尽陷罗网之中；～，咸置庙廊之上。","book":"清·钱彩《说岳全传》第七十三回"},"similar":["乱臣贼子","贼臣乱子","贼臣逆子"],"usage":"作宾语、定语；用于书面语"},{"id":42080,"word":"贼心不死","pinyin":"zéi xīn bù sǐ","abbr":"zxbs","explanation":"不放弃坏念头，而继续做下去。","example":{"text":"尽管警方一再通缉，他仍然～继续作案，终于难逃法网被捕入狱。"},"usage":"作谓语、定语；指坏主意"},{"id":42081,"word":"贼皮贼骨","pinyin":"zéi pí zéi gǔ","abbr":"zpzg","explanation":"指贼人肉体久受责罚，耐受性强。","source":{"text":"李彪终久是衙门人手段，走到灶下取一根劈柴来，先把李旺打一个下马威，问道：‘银子那里去了？’李旺是贼皮贼骨，一任打着，只不开口。","book":"明·凌濛初《二刻拍案惊奇》卷二十一"},"usage":"作宾语、定语；用于书面语"},{"id":42082,"word":"贼眉溜眼","pinyin":"zéi méi liū yǎn","abbr":"zmly","explanation":"形容非常狡猾的样子。","example":{"text":"他那～的样子让人看不顺眼。"},"similar":["贼眉鼠眼"],"usage":"作谓语、定语；指人狡猾"},{"id":42083,"word":"贼眉贼眼","pinyin":"zéi méi zéi yǎn","abbr":"zmzy","explanation":"形容神情鬼鬼祟祟。","source":{"text":"正说话间，只见小和尚左手拿一只灯，右手提一壶茶，走进来贼眉贼眼，将灯放下，又将茶壶放在桌上，两只贼眼东瞧西看，连话也不说，回头就走。","book":"清·石昆玉《三侠五义》第三回"},"similar":["贼眉鼠眼"],"usage":"作谓语、定语；形容坏人"},{"id":42084,"word":"贼眉鼠眼","pinyin":"zéi méi shǔ yǎn","abbr":"zmsy","explanation":"形容神情鬼鬼祟祟。","source":{"text":"‘你没看见李景纯吗？’武端贼眉鼠眼的问：‘他来，她就不能来！’","book":"老舍《赵子曰》"},"example":{"text":"看这个～的家伙的态势，就像他觉着这个屋门口如老虎口一样可怕。","book":"郭澄清《大刀记》第12章"},"similar":["贼眉贼眼"],"usage":"作谓语、定语；形容坏人"},{"id":42085,"word":"贼臣乱子","pinyin":"zéi chén luàn zǐ","abbr":"zclz","explanation":"指心怀异志、为奸作恶的人。","source":{"text":"臣窃惟太祖、高宗之孝子忠臣，而昏主之贼臣乱子者，江夏王与陛下，先臣与镇军是也。","book":"南朝·梁·萧子显《南齐书·崔慧景传》"},"similar":["贼臣逆子","乱臣贼子"],"opposite":["孝子忠臣"],"usage":"作宾语、定语；用于书面语"},{"id":42086,"word":"贼臣逆子","pinyin":"zéi chén nì zǐ","abbr":"zcnz","explanation":"指心怀异志、为奸作恶的人。同“贼臣乱子”。","source":{"text":"贼臣逆子设阴谋，虑恐国破人消灭。","book":"《敦煌变文·降魔变文》"},"example":{"text":"且闻之，自古代有屯剥，～，无世无之。","book":"唐·魏徵寿《隋书·炀三子传》"},"similar":["贼臣乱子","贼子乱臣"],"usage":"作宾语、定语；用于书面语"},{"id":42087,"word":"贼走关门","pinyin":"zéi zǒu guān mén","abbr":"zzgm","explanation":"比喻事故发生后才采取措施。","example":{"text":"我们要杜绝～的现象再次发生。"},"similar":["贼去关门","亡羊补牢"],"usage":"作宾语、定语；指事后行为"},{"id":42088,"word":"贿货公行","pinyin":"huì huò gōng xíng","abbr":"hhgx","explanation":"指公开行贿受赂。同“贿赂公行”。","source":{"text":"政刑弛紊，贿货公行。","book":"《梁书·武帝纪上》：“贩官鬻爵，贿货公行。”《隋书·炀帝纪下》"},"example":{"text":"督领既多，且所部军人，富于财物，遂～。","book":"《北史·元景安传》"},"similar":["贿赂公行"],"usage":"作谓语、定语；指公开行贿受贿"},{"id":42089,"word":"贿赂公行","pinyin":"huì lù gōng xíng","abbr":"hlgx","explanation":"贿赂：因请托而私赠财物；公行：公开做。指公开行贿受赂。","source":{"text":"前在赵州，暗于职务，政由群小，贿赂公行。","book":"晋·常璩《华阳国志·李特雄寿势志》：“货贿公行，惩劝不明。”《北史·柳彧传》"},"example":{"text":"言路阻而宵人得志，径窦开而～。","book":"清·黄宗羲《子刘子行状》"},"similar":["贿赂并行"],"usage":"作谓语、定语；指公开行贿受贿"},{"id":42090,"word":"贿赂并行","pinyin":"huì lù bìng xíng","abbr":"hlbx","explanation":"贿赂：因请托而私赠财物。指行贿受贿的事情到处都有。","source":{"text":"乱狱滋丰，贿赂并行，终予之世，郑其败乎？。","book":"《左传·昭公六年》"},"similar":["贿赂公行"],"usage":"作谓语、定语、补语；指官场黑暗"},{"id":42091,"word":"赁耳佣目","pinyin":"lìn ěr yōng mù","abbr":"leym","explanation":"指借助于所见所闻。","source":{"text":"流浪壮齿，记滥俗学，侵寻四十，赁耳佣目，乃稍知古学之由来。","book":"清·钱谦益《覆徐巨源书》"},"usage":"作谓语；指借助于所见所闻"},{"id":42092,"word":"赃官污吏","pinyin":"zāng guān wū lì","abbr":"zgwl","explanation":"犹贪官污吏。","source":{"text":"谁知被赃官污吏，淫妇奸夫，通情陷害，监在死囚牢里。","book":"《水浒传》第六二回"},"example":{"text":"[焦面鬼]口里喊叫：“杀了～，替民除害，要性命的，各自回避！”","book":"《禅真后史》第二一回"},"similar":["贪官污吏","奸官污吏"],"usage":"作主语、宾语、定语；指贪赃枉法的官吏"},{"id":42093,"word":"赃心烂肺","pinyin":"zāng xīn làn fèi","abbr":"zxlf","explanation":"形容心肠肮脏卑劣","source":{"text":"……那样赃心烂肺的，爱管闲事嚼舌头的人，吵嚷到那府里去，背地嚼舌，说咱们这边混帐。","book":"清·曹雪芹《红楼梦》第63回"},"usage":"作宾语、定语；用于书面语"},{"id":42094,"word":"赃污狼籍","pinyin":"zāng wū láng jí","abbr":"zwlj","explanation":"指贪污受贿，行为不检，名声败坏。","source":{"text":"要束木之党八人为道州路总管，败政害民，赃污狼籍。","book":"元黄氏《湖广等处行中书省平章故事刘公神道碑》"},"similar":["赃私狼藉","赃贿狼藉","赃货狼藉"],"usage":"作谓语、定语；用于书面语"},{"id":42095,"word":"赃污狼藉","pinyin":"zāng wū láng jí","abbr":"zwlj","explanation":"指贪污受贿，行为不检，名声败坏。","source":{"text":"长吏多阿附贵戚，赃污狼藉。","book":"《三国志·魏志武帝纪》"},"example":{"text":"中书舍人于尹躬，其弟皋谟，～。","book":"唐白居易《败于尹躬洋州刺史制》"},"similar":["赃污狼籍","赃贿狼藉","赃私狼藉"],"usage":"作谓语、定语；指人的名声等"},{"id":42096,"word":"赃盈恶贯","pinyin":"zāng yíng è guàn","abbr":"zyeg","explanation":"指贪赃甚多，罪恶滔天。","source":{"text":"甚而台省之胥，赃盈恶贯，以置典宪，亦曰：‘为内侍泄冤也。’","book":"宋周密《齐东野·洪君畴》"},"usage":"作谓语、定语；用于官吏"},{"id":42097,"word":"赃私狼籍","pinyin":"zāng sī láng jí","abbr":"zslj","explanation":"指贪污受贿，行为不检，名声败坏。","source":{"text":"温得盛笺遣从事重案之，赃私狼籍，槛车收盛到州，舍而不罪。","book":"《晋书·孙盛传》"},"similar":["赃货狼藉","赃私狼藉","赃贿狼藉"],"usage":"作谓语、定语；用于书面语"},{"id":42098,"word":"赃私狼藉","pinyin":"zāng sī láng jí","abbr":"zslj","explanation":"指贪污受贿，行为不检，名声败坏。","source":{"text":"[茹千秋]其子寿龄为乐安令，赃私狼藉，畏法奔逃，竟无罪恶罚，傲然还县。","book":"《晋书·会稽文孝王道子传》"},"similar":["赃私狼籍","赃污狼籍","赃贿狼籍"],"usage":"作谓语、定语；用于书面语"},{"id":42099,"word":"赃秽狼藉","pinyin":"zāng huì láng jí","abbr":"zhlj","explanation":"指贪污受贿，行为不检，名声败坏。","source":{"text":"一到京师，看见严家赃秽狼藉，心中甚怒。","book":"《古今小说·沈小霞相会出师表》"},"similar":["赃贿狼藉","赃货狼藉","赃私狼藉"],"usage":"作谓语、定语；用于书面语"},{"id":42100,"word":"赃货狼藉","pinyin":"zāng huò láng jí","abbr":"zhlj","explanation":"指贪污受贿，行为不检，名声败坏。","source":{"text":"穆之中子式之字延叔，通易好士……在任赃货狼藉，扬州刺史王弘遣从事检校。","book":"《宋书·刘穆之传》"},"similar":["赃秽狼藉","赃私狼籍","赃污狼籍"],"usage":"作谓语、定语；用于书面语"},{"id":42101,"word":"赃贿狼籍","pinyin":"zāng huì láng jí","abbr":"zhlj","explanation":"指贪污受贿，行为不检，名声败坏。","source":{"text":"中书侍郎兼知吏部侍郎同平章事崔湜、吏部侍郎同平章事郑愔俱掌铨衡，倾附势要，赃贿狼籍，数外留人，授拟不中，逆用三年阙，选法大坏。","book":"宋·司马光《资治通鉴·唐中宗景龙三年》"},"similar":["赃贿狼藉","赃私狼藉","赃秽狼藉"],"usage":"作谓语、定语；用于书面语"},{"id":42102,"word":"赃贿狼藉","pinyin":"zāng huì láng jí","abbr":"zhlj","explanation":"指贪污受贿，行为不检，名声败坏。亦作“赃贿狼籍”。","source":{"text":"天嘉之世，赃贿狼藉，圣恩录用，许以更鸣，裂壤崇阶，不远斯复。","book":"《陈书·蔡景历传》"},"example":{"text":"……崔湜、……郑愔俱掌铨衡，倾附势要，赃贿狼籍，数外留人，授拟不足，逆用三年阙，选法大坏。","book":"《资治通鉴·唐中宗景龙三年》"},"similar":["赃贿狼籍","赃秽狼藉","赃私狼藉"],"usage":"作谓语、定语；用于书面语"},{"id":42103,"word":"资怨助祸","pinyin":"zī yuàn zhù huò","abbr":"zyzh","explanation":"助长怨恨，促使祸患到来。","source":{"text":"夫行危欲求安，造祸而求福，计浅而怨深，连结一人之后交，不顾国家之大害，此所谓资怨而助矣。","book":"《史记·刺客列传》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":42104,"word":"资斧困竭","pinyin":"zī fǔ kùn jié","abbr":"zfkj","explanation":"资斧：旅费，盘缠。指盘缠很少或已经用完","source":{"text":"旅于处，得其资斧。","book":"《易经·旅》"},"example":{"text":"明·冯梦龙《警世通言》第32卷：“公子自知手中只有五十金，此时费去大半，说到～，进退两难，不觉点头道是。”"},"usage":"作谓语、定语；用于书面语"},{"id":42105,"word":"资浅望轻","pinyin":"zī qiǎn wàng qīng","abbr":"zqwq","explanation":"资历浅，名望小。常用作自谦之辞。","source":{"text":"伏念臣自去岁误蒙圣恩，擢置近列，使侍讲筵，即以迂疏寡陋，资浅望轻，恳辞四五，而不获命，遂已不敢复辞讲职。","book":"宋·朱熹《乞追还待制奏状六》"},"opposite":["资深望重"],"usage":"作谓语、定语；用于自谦"},{"id":42106,"word":"资浅齿少","pinyin":"zī qiǎn chǐ shǎo","abbr":"zqcs","explanation":"资历浅，年纪轻。","source":{"text":"某戆愚不学，资浅齿少，而今兹除授，乃先众俊，朝夕惴惧。","book":"宋·张孝祥《严守朱新仲》"},"usage":"作谓语、定语；多用于自谦"},{"id":42107,"word":"资深望重","pinyin":"zī shēng wàng zhòng","abbr":"zswz","explanation":"资格老，声望高。","source":{"text":"非独使之业广而材成，抑将待其资深而望重。","book":"宋·苏轼《答试馆职人启》"},"example":{"text":"曾朴《孽海花》第25回：“差不多有将无帅，必须另简～的宿将，如刘益焜、刘瞻民等。”"},"opposite":["资浅望轻"],"usage":"作谓语、定语；指人声望高"},{"id":42108,"word":"资藉豪富","pinyin":"zī jiè háo fù","abbr":"zjhf","explanation":"资藉：家产。指家财产业极为富有","source":{"text":"伪资藉豪富，厚自奉养，供一身，一月十万。","book":"《南史·到伪传》"},"similar":["家财万贯"],"opposite":["家徒四壁"],"usage":"作谓语、定语；用于书面语"},{"id":42109,"word":"赈穷济乏","pinyin":"zhèn qióng jì fá","abbr":"zqjf","explanation":"赈求和帮助穷困的人。","source":{"text":"有机辩，颇窥书籍，家富于财，赈穷济乏，人亦称之。","book":"《旧唐书·李轨传》"}},{"id":42110,"word":"赈贫济乏","pinyin":"zhèn pín jì fá","abbr":"zpjf","explanation":"赈：救济。救济和帮助穷困的人","source":{"text":"李轨字处则，武威姑臧人也。有机辩，颇窥书籍，家富于财，赈贫济乏，人亦称之。","book":"《旧唐书·李轨传》"},"similar":["赈贫贷乏"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":42111,"word":"赈贫贷乏","pinyin":"zhèn pín dài fá","abbr":"zpdf","explanation":"救济穷人。","source":{"text":"赈贫贷乏，劝课耕种，为立官社，民皆安其所。","book":"《新唐书·刘仁轨传》"},"similar":["赈贫济乏"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":42112,"word":"赋食行水","pinyin":"fù shí xíng shuǐ","abbr":"fsxs","explanation":"赋：给与；行：奉，酌酒或水敬奉客人。送饭送水。","source":{"text":"或亲为众僧赋食行水，世颇以为失宰相礼。","book":"《资治通鉴·梁纪》"},"usage":"作谓语、宾语、定语；指送饭送水"},{"id":42113,"word":"赌咒发誓","pinyin":"dǔ zhòu fā shì","abbr":"dzfs","explanation":"庄严地说出表示决心的话或对某事提出保证。","source":{"text":"众小丫头慌了，都跪下赌咒发誓，说：‘自来也不敢多说一句话。有人凡问什么，都答应不知道。这事如何敢多说。’","book":"清·曹雪芹《红楼梦》第74回"},"example":{"text":"陈书农他们～，声明自己决无二心。","book":"温靖邦《将星在狼烟中升起》"},"similar":["赌誓发愿","赌神发咒"],"usage":"作谓语、宾语、定语、状语；指发誓"},{"id":42114,"word":"赌彩一掷","pinyin":"dǔ cǎi yī zhì","abbr":"dcyz","explanation":"犹言孤注一掷。","source":{"text":"相公此举，有万全之策乎？亦赌彩一掷也。","book":"宋·罗大经《鹤林玉露》第16卷"},"example":{"text":"～的做法未免不可。"},"similar":["孤注一掷"],"usage":"作谓语、宾语；指冒险"},{"id":42115,"word":"赌物思人","pinyin":"dǔ wù sī rén","abbr":"dwsr","explanation":"看见死去或离去的人所遗下的物品，就想起该人。","example":{"text":"进入革命烈士纪念馆，大家～，想起烈士们生前的英雄事迹，不禁肃然起敬。"}},{"id":42116,"word":"赌神发咒","pinyin":"dǔ shén fā zhòu","abbr":"dsfz","explanation":"犹言对天发誓。","source":{"text":"于是急的经济赌神发咒，继之以哭。","book":"《金瓶梅词话》第八二回"},"example":{"text":"你会不会假装～，说你蚀了本？这你都不会的！","book":"艾芜《都市的忧郁》"},"similar":["赌咒发誓"],"usage":"作谓语、宾语、定语、状语；指发誓"},{"id":42117,"word":"赌誓发原","pinyin":"dǔ shì fā yuán","abbr":"dsfy","explanation":"犹言赌咒发誓。庄严地说出表示决心的话或对某事提出保证。"},{"id":42118,"word":"赌誓发愿","pinyin":"dǔ shì fā yuàn","abbr":"dsfy","explanation":"犹言赌咒发誓。庄严地说出表示决心的话或对某事提出保证。","source":{"text":"江湖上客商，赌誓发愿便说：‘若有欺心，必定遭遇吾剥皮。’","book":"《石点头·贪婪汉六院卖风流》"},"similar":["赌咒发誓"],"usage":"作谓语、定语、状语、宾语；用于发誓"},{"id":42119,"word":"赌长较短","pinyin":"dǔ cháng jiào duǎn","abbr":"dcjd","explanation":"指比优劣。","source":{"text":"若止与《南西厢》赌长较短，则犹恐屑而不屑。","book":"清·李渔《闲情偶寄·词曲·音律》"},"usage":"作谓语、宾语、定语；用于比较"},{"id":42120,"word":"赍志以殁","pinyin":"jī zhì yǐ mò","abbr":"jzym","explanation":"指怀抱着未遂的志愿而死去。同“赍志而殁”。","source":{"text":"议既格沮，兵不复出……而卒赍志以殁，义士所为悼叹者也。","book":"宋·范浚《徐忠壮传》"},"example":{"text":"《中国的西北角·贺兰山的四边》：“岳飞《满江红》有‘驾长车，踏破贺兰山缺’之志，可惜他～，未能率军直捣贺兰。”"},"similar":["赍志而殁","赍志没地"],"usage":"作谓语、定语；指志愿没有实现就死了"},{"id":42121,"word":"赍志以没","pinyin":"jī zhì yǐ mò","abbr":"jzym","explanation":"指怀抱着未遂的志愿而死去。同“赍志而殁”。","source":{"text":"赍志没地，长怀无已。","book":"南朝·梁·江淹《恨赋》"},"example":{"text":"庚子之变，～。","book":"陈夔龙《梦蕉亭杂记》第一卷"},"similar":["赍志而殁","赍志以殁","赍志没地"],"usage":"作谓语、定语；指志愿没有实现就死了"},{"id":42122,"word":"赍志没地","pinyin":"jī zhì mò dì","abbr":"jzmd","explanation":"赍：怀抱着，带着；没：死。志愿没有实现就死了。","source":{"text":"赍志没地，长怀无已。","book":"南朝·梁·江淹《恨赋》"},"similar":["赍志而殁","赍志以殁","赍志以没"],"usage":"作谓语、定语；指志愿没有实现就死了"},{"id":42123,"word":"赍志而殁","pinyin":"jī zhì ér mò","abbr":"jzem","explanation":"赍：怀抱着，带着；殁：死。指怀抱着未遂的志愿而死去。","source":{"text":"赍志没地，长怀无已。","book":"南朝·梁·江淹《恨赋》"},"example":{"text":"岂意阳运告终，～。","book":"明·许仲琳《封神演义》第99回"},"similar":["赍志而没"],"usage":"作谓语、定语；指怀抱着未遂的志愿而死去"},{"id":42124,"word":"赍志而没","pinyin":"jī zhì ér mò","abbr":"jzem","explanation":"赍：怀抱着，带着；殁：死。志愿没有实现就死了。","source":{"text":"赍志没地，长怀无已。","book":"南朝·梁·江淹《恨赋》"},"example":{"text":"林文忠公经世之才，可惜鞠躬尽瘁，～。","book":"高阳《玉座珠帘》上册"},"similar":["赍志而殁","赍志以殁"],"usage":"作谓语、定语；指志愿没有实现就死了"},{"id":42125,"word":"赍盗粮，借贼兵","pinyin":"jī dào liáng，jiè zéi bīng","abbr":"jdljzb","explanation":"赍：以物送人；兵：兵器，武器。送给盗贼粮食，借给盗贼武器。比喻帮助敌人或坏人。","source":{"text":"非其人而教之，赍盗粮，借贼兵。","book":"战国·赵·荀况《荀子·大略》"},"similar":["赍粮藉寇","借寇兵，赍盗粮"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42126,"word":"赍粮藉寇","pinyin":"jī liáng jiè kòu","abbr":"jljk","explanation":"赍：资助；藉：同“借”；寇：贼寇。借给敌寇兵器，送给盗贼粮食。比喻做有利于敌人、坏人的事。","source":{"text":"非其人而教之，赍盗粮，借贼兵也。","book":"《荀子·大略》"},"example":{"text":"是国家正供之入，适足为～之资。","book":"清·夏燮《中西纪事》卷十六"},"similar":["赍盗粮，借贼兵"],"usage":"作谓语、定语；指做蠢事"},{"id":42127,"word":"赏一劝众","pinyin":"shǎng yī quàn zhòng","abbr":"syqz","explanation":"奖励一个人的先进事迹而鼓励好多人。","source":{"text":"杀一以惩万，赏一而劝众，此明君之威福也。","book":"周·吕尚《阴谋》"},"similar":["赏一劝百"],"usage":"作宾语、定语；用于处事"},{"id":42128,"word":"赏一劝百","pinyin":"shǎng yī quàn bǎi","abbr":"syqb","explanation":"奖励一个人的先进事迹而鼓励好多人。","source":{"text":"赏一以劝百，罚一以惩众。","book":"《文中子·立命》"},"similar":["赏一劝众"],"usage":"作宾语、定语；用于处事"},{"id":42129,"word":"赏不当功","pinyin":"shǎng bù dāng gōng","abbr":"sbdg","explanation":"指赏赐与功劳不相称。","source":{"text":"德不称位，能不称官，赏不当功，刑不当罪，不祥莫大焉。","book":"《荀子·正论》"},"example":{"text":"致朝廷之上，用者不贤，贤者不用；～，罚不当罪。","book":"《明史·赵锦传》"},"usage":"作宾语、定语；用于处事"},{"id":42130,"word":"赏不逾日","pinyin":"shǎng bù yú rì","abbr":"sbyr","explanation":"指及时行赏。同“赏不逾时”。","source":{"text":"其有微功，赏不逾日。","book":"《晋书·慕容垂载记》：“乱法者军有常刑，奉命者赏不逾日。”又《祖逖传》"},"similar":["赏不逾时"],"usage":"作谓语、定语；用于处事"},{"id":42131,"word":"赏不逾时","pinyin":"shǎng bù yú shí","abbr":"sbys","explanation":"指及时行赏。","source":{"text":"赏不逾时，欲民速得为善之利也。罚不迁列，欲民速睹为不善之害也。","book":"《司马法·天子之义》"},"similar":["赏不逾日"],"usage":"作谓语、定语；用于处事"},{"id":42132,"word":"赏不遗贱","pinyin":"shǎng bù yí jiàn","abbr":"sbyj","explanation":"奖赏时不要遗留地位低下的人。","source":{"text":"诛不避贵，赏不遗贱，不淫于乐，不遁于哀，尽智导民而不伐焉。","book":"《晏子春秋·内篇问上》"},"example":{"text":"功者～，罪者刑不避亲，虽宠爱之，终不亏法。","book":"《北史·魏本纪》"},"usage":"作宾语、定语；用于处事"},{"id":42133,"word":"赏信必罚","pinyin":"shǎng xìn bì fá","abbr":"sxbf","explanation":"信：真实不欺。有功劳的一定奖赏，有罪过的一定惩罚。形容赏罚严明。","source":{"text":"信赏必罚，其足以战。","book":"《韩非子·外储说右上》"}},{"id":42134,"word":"赏信罚必","pinyin":"shǎng xìn fá bì","abbr":"sxfb","explanation":"指该赏一定赏，该罚一定罚。","source":{"text":"太公曰：‘凡用赏者贵信，用罚者贵必，赏信罚必，于耳目之所见闻，则所不见闻者莫不阴化矣。","book":"《六韬·赏罚》"},"similar":["赏信罚明","赏立诛必"],"opposite":["赏罚不明"],"usage":"作宾语、定语；用于处事"},{"id":42135,"word":"赏信罚明","pinyin":"shǎng xìn fá míng","abbr":"sxfm","explanation":"形容处理事情严格而公正。同“赏罚分明”。","source":{"text":"遭禄山变，拔任兵柄，其策敌制胜不世出，赏信罚明，士卒争奋，毅然有古良将风。","book":"《新唐书·李光弼传赞》"},"similar":["赏信罚必","赏立罚必","赏罚分明"],"opposite":["赏罚不明"],"usage":"作宾语、定语；用于处事"},{"id":42136,"word":"赏功罚罪","pinyin":"shǎng gōng fá zuì","abbr":"sgfz","explanation":"奖赏有功的人，惩罚犯罪的人。","source":{"text":"是故王者之职，在于量材任人，赏功罚罪而已。","book":"宋·司马光《上体要疏》"},"example":{"text":"雪耻酬恩中始快，～政无偏。","book":"《东周列国志》第四四回"},"similar":["赏高罚下","赏劳罚罪"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42137,"word":"赏劳罚罪","pinyin":"shǎng láo fá zuì","abbr":"slfz","explanation":"奖赏有功的人，惩罚犯罪的人。同“赏功罚罪”。","source":{"text":"吾人奉命讨之，诸君幸皆努力向前。大军到处，不得扰民。赏劳罚罪，并不徇纵。","book":"《三国演义》第四四回"},"similar":["赏高罚下","赏功罚罪"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42138,"word":"赏同罚异","pinyin":"shǎng tóng fá yì","abbr":"stfy","explanation":"指奖赏和自己的意见相同的，惩罚和自己的意见不同的。","source":{"text":"故赏贤罚暴，举善之至者也：赏暴罚贤，举恶之至者也：是谓赏同罚异。","book":"《韩非子·八经》"},"usage":"作宾语、定语；用于处事"},{"id":42139,"word":"赏善罚否","pinyin":"shǎng shàn fá fǒu","abbr":"ssff","explanation":"指赏赐善人善事，惩罚恶人恶事。同“赏善罚恶”。","source":{"text":"赏善罚否，宽猛协中。","book":"《隶释·汉平都相蒋君碑》"},"similar":["赏善罚恶"],"usage":"作谓语、宾语、定语；指奖赏好的惩罚坏的"},{"id":42140,"word":"赏善罚恶","pinyin":"shǎng shàn fá è","abbr":"ssfe","explanation":"指赏赐善人善事，惩罚恶人恶事。","source":{"text":"《瞻彼洛矣》，刺幽王也。思古明王能爵命诸侯，赏善罚恶焉。","book":"《诗·小雅·瞻彼洛矣序》"},"example":{"text":"我能在大众面前，冠冕堂皇地阅看的，是《文昌帝君阴骘文图说》和《玉历钞传》，都画着冥冥之中～的故事。","book":"鲁迅《朝花夕拾·〈二十四孝图〉》"},"similar":["褒善惩恶","赏善罚否"],"usage":"作谓语、宾语、定语；指奖赏好的惩罚坏的"},{"id":42141,"word":"赏善罚淫","pinyin":"shǎng shàn fá yín","abbr":"ssfy","explanation":"赏：奖赏；善：善良的；罚：处罚；淫：邪恶。奖赏好人，惩罚坏人。也形容做善事有好报，做坏事有恶报。","source":{"text":"单子知陈必亡，天道赏善而罚淫。","book":"《国语·周语中》"}},{"id":42142,"word":"赏奇析疑","pinyin":"shǎng qí xī yí","abbr":"sqxy","explanation":"欣赏奇文而析其疑义。","source":{"text":"奇文共欣赏，疑义相与析。","book":"晋·陶潜《移居》诗之一"},"example":{"text":"海内贤达，不非吾说，相与激清扬浊，～，其事颇乐。","book":"柳亚子《序》"},"usage":"作谓语；指欣赏奇文而析其疑义"},{"id":42143,"word":"赏心乐事","pinyin":"shǎng xīn lè shì","abbr":"sxls","explanation":"赏心：心情欢畅。欢畅的心情，快乐的事情。","source":{"text":"天下良辰、美景、赏心、乐事，四者难并。","book":"南朝宋·谢灵运《拟魏太子邺中集诗八首序》"},"example":{"text":"你看这郊外人稠物穰，都是～，真个好热闹也。","book":"元·武汉臣《玉壶春》第一折"},"usage":"作宾语；指欢畅的心情和快乐的事情"},{"id":42144,"word":"赏心悦目","pinyin":"shǎng xīn yuè mù","abbr":"sxym","explanation":"悦目：看了舒服。指看到美好的景色而心情愉快。","source":{"text":"长篇短章，不为不多，然半属套语，半属陈言，求一言清新俊逸，赏心悦目者，迥然可得。","book":"明·无名氏《人中画·风流配》一"},"example":{"text":"两人到山脚下一看，只见新叶嫩碧，土地金黄，野草开着些红红白白的小花，真是连看看也～。","book":"鲁迅《故事新编·采薇》"},"similar":["心旷神怡","欢欣鼓舞"],"opposite":["怵目惊心","触目惊心"],"usage":"作谓语、定语；指看到美好的景色而心情愉快"},{"id":42145,"word":"赏立诛必","pinyin":"shǎng lì zhū bì","abbr":"slzb","explanation":"指该赏的立即赏，该罚的一定罚。","source":{"text":"卫嗣君曰：‘赏立诛必，虽失十左伤氏无伤也；诛不必，虽得十左氏无益也。’","book":"清·侯方域《豫省试策五》"},"similar":["赏信罚必"],"usage":"作宾语、定语；用于处事"},{"id":42146,"word":"赏罚不信","pinyin":"shǎng fá bù xìn","abbr":"sfbx","explanation":"赏赐与惩罚不按规定执行。","source":{"text":"号令不治，赏罚不信，地形不便，下不能尽其民力，彼固亡国之形也。","book":"《韩非子·初见秦》"},"opposite":["赏罚信明"],"usage":"作谓语、定语；用于处事"},{"id":42147,"word":"赏罚不当","pinyin":"shǎng fá bù dàng","abbr":"sfbd","explanation":"奖赏或惩罚与功过不相当。","source":{"text":"繁刑严诛，吏治刻深，赏罚不当，赋敛无度。","book":"汉·贾谊《新书·过秦中》"},"example":{"text":"唐·赵蕤《反经·臣行》：“使主～，号令不行，如此者，奸臣也。”"},"similar":["赏罚不明"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42148,"word":"赏罚不明","pinyin":"shǎng fá bù míng","abbr":"sfbm","explanation":"赏罚不清楚不明白。该奖赏的不奖赏，该惩罚的不惩罚。","source":{"text":"敞为人敏疾，赏罚不明，见恶辄取，时时越法纵舍，不足大者。","book":"《汉书·张敞传》"},"example":{"text":"可见做上宪的人，又要～，又要记性好，夫然后叫人心服。","book":"《官场现形记》第四五回"},"similar":["赏罚不当"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42149,"word":"赏罚严明","pinyin":"shǎng fá yán míng","abbr":"sfym","explanation":"指该赏的赏，该罚的罚，处理清楚明白。","source":{"text":"赏罚严明，治之材也。","book":"汉·王符《潜夫论·实贡》"},"example":{"text":"可见做上宪的人，又要～，又要记性好，夫然后叫人心服。《官场现形记》第四五回"},"similar":["赏罚分明","赏罚信明","赏罚分审"],"opposite":["赏罚不明"],"usage":"作谓语、定语；指处理问题界限分明","story":["汉宣帝时期，渤海、胶东一带盗贼十分猖獗，他们四处作恶。汉宣帝派大臣张敞前去治理，张敞向宣帝请求必须奖赏那些追捕盗贼有功人员，严惩盗贼，得到宣帝的支持。到任后，他赏罚严明，差吏们个个奋勇追捕，社会迅速恢复安定"]},{"id":42150,"word":"赏罚信明","pinyin":"shǎng fá xìn míng","abbr":"sfxm","explanation":"形容处理事情严格而公正。同“赏罚分明”。","source":{"text":"孝宣皇帝赏罚信明，施与有节，记人之功，忽于小过，以致治平。","book":"《汉书·王嘉传》"},"similar":["赏罚分明","赏罚分审","赏罚严明"],"opposite":["赏罚不明"],"usage":"作谓语、定语；指处理问题界限分明"},{"id":42151,"word":"赏罚分审","pinyin":"shǎng fá fēn shěn","abbr":"sffs","explanation":"形容处理事情严格而公正。同“赏罚分明”。","source":{"text":"赏罚分审，白黑著明。","book":"《隶释·汉成阳令唐扶颂》"},"similar":["赏罚分明"],"opposite":["赏罚不明"],"usage":"作谓语、定语；指处理问题界限分明"},{"id":42152,"word":"赏罚分明","pinyin":"shǎng fá fēn míng","abbr":"sffm","explanation":"该赏的赏，该罚的罚。形容处理事情严格而公正。","source":{"text":"敞为人敏疾，赏罚分明。","book":"汉·王符《潜夫论·实贡》：“赏罚严明，治之材也。”《汉书·张敞传》"},"example":{"text":"可见做上宪的人，又要～，又要记性好，夫然后叫人心服。","book":"清·李宝嘉《官场现形记》第四十五回"},"similar":["赏罚严明","赏罚分审"],"opposite":["赏罚不当","赏罚不明"],"usage":"作谓语、定语；指处理问题界限分明","story":["汉宣帝时期，渤海、胶东一带盗贼十分猖獗，他们四处作恶。汉宣帝派大臣张敞前去治理，张敞向宣帝请求必须奖赏那些追捕盗贼有功人员，严惩盗贼。到任后，他赏罚分明，差吏们个个奋勇追捕，社会迅速恢复安定"]},{"id":42153,"word":"赏罚无章","pinyin":"shǎng fá wú zhāng","abbr":"sfwz","explanation":"奖赏和惩罚无章法可依。","source":{"text":"逐我者出，纳我者死，赏罚无章，何以沮劝，君失其信，而国无刑，不亦难乎？","book":"《左传·襄公二十七年》"},"example":{"text":"《周书·尉迟迥传》：“杨坚以凡庸之材，藉后父之势，挟幼主而令天下，威福自己，～，不臣之迹，暴于行路。”"},"usage":"作谓语、定语；用于处事"},{"id":42154,"word":"赏罚黜陟","pinyin":"shǎng fá chù zhì","abbr":"sfcz","explanation":"黜陟：官吏的进退升降。指官吏的赏赐、惩罚和官职的升降。","source":{"text":"赏罚黜陟，岂或有不得其所者乎？","book":"《晋书·挚虞传》"},"usage":"作宾语、定语；用于官场等"},{"id":42155,"word":"赏贤使能","pinyin":"shàng xián shǐ néng","abbr":"sxsn","explanation":"尊崇并重用贤能之士。赏，通“尚”。","source":{"text":"赏当为尚。","book":"《荀子·王霸》：“致忠心以爱之，赏贤使能以次之。”杨倞注"},"usage":"作谓语、宾语、定语；指尊崇贤能"},{"id":42156,"word":"赏贤罚暴","pinyin":"shǎng xián fá bào","abbr":"sxfb","explanation":"犹赏善罚恶。指赏赐善人善事，惩罚恶人恶事。","source":{"text":"故赏贤罚暴，举善之至者也。","book":"《韩非子·八经》"},"usage":"作宾语、定语；用于处事"},{"id":42157,"word":"赏赐无度","pinyin":"shǎng cì wú dù","abbr":"scwd","explanation":"赏赐没有限度。","source":{"text":"时贤以爱居大位，赏赐无度，骄嫚不敬，大失臣道，见戒不改。","book":"《汉书·五行志》"},"example":{"text":"土颇饶珍产，武穷极奢靡，～，或由一言赏至百万。","book":"《旧唐书·严武传》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":42158,"word":"赏高罚下","pinyin":"shǎng gāo fá xià","abbr":"sgfx","explanation":"奖赏有功的人，惩罚犯罪的人。同“赏功罚罪”。","source":{"text":"臣民有功为高，有罪为下，所以等于说赏功罚罪。","book":"《商君书·禁使》：“夫赏高罚下，而上无必知，其道也与无道同也。”高亨注"},"similar":["赏功罚罪","赏劳罚罪"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42159,"word":"赐墙及肩","pinyin":"cì qiáng jí jiān","abbr":"cqjj","explanation":"比喻才学浅陋。","source":{"text":"叔孙武叔语大夫于朝曰：‘子贡贤于仲尼。’子服景伯以告子贡，子贡曰：‘譬之宫墙，赐之墙也及肩，窥见室家之好。夫子之墙数仞，不得其门而入。","book":"春秋·鲁·孔丘《论语·子张》"},"example":{"text":"～人得见，公才槃槃一都会。","book":"宋·陈师道《次韵苏公西湖徙鱼》"},"similar":["才疏学浅"],"usage":"作谓语、定语；比喻才学浅陋","story":["春秋时期，叔孙武叔语大夫在朝廷上夸耀子贡比孔子要贤明，子服景伯将此事告诉子贡。子贡听说后，哈哈大笑道：“人的才能可以用宫墙的高低打比方，端木赐的墙只有肩膀高，孔子的墙有千尺高，而且还找不到门，我们都不如他。”"]},{"id":42160,"word":"赐茅授土","pinyin":"cì máo shòu tǔ","abbr":"cmst","explanation":"封建社会帝王分封诸侯的一种礼仪。帝王以五色土为太社，分封诸侯时，各授以他们相应的某方某色土，如东方青土，南方赤土等，并包以白茅，使归以立社。"},{"id":42161,"word":"赒穷恤匮","pinyin":"zhōu qióng xù kuì","abbr":"zqxk","explanation":"赒：周济，救济；恤：抚恤；匮：缺乏，不足。接济救助鳏寡孤独及其他贫困的人。","source":{"text":"少私寡欲，忌盈恶满，赒穷恤匮。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["扶危济困"],"usage":"作谓语、定语、宾语；指帮助弱势人群"},{"id":42162,"word":"赔了夫人又折兵","pinyin":"péi le fū rén yòu zhé bīng","abbr":"plfryzb","explanation":"赔：蚀本；折：亏损。比喻想占便宜，反而受到双重损失。","source":{"text":"周瑜周瑜，休夸妙计高天下，只教你赔了夫人又折兵。","book":"元·无名氏《隔江斗智》第二折"},"example":{"text":"周郎妙计安天下，～。","book":"明·罗贯中《三国演义》第五十五回"},"similar":["损兵折将"],"opposite":["大获全胜","毫发未损"],"usage":"作谓语、补语；指损兵折将","story":["东汉末年孙权想取回荆州，周瑜献计“假招亲扣人质”。诸葛亮识破，安排赵云陪伴前往，先拜会周瑜的岳父乔玄，乔玄说动吴国太在甘露寺见面，吴国太真的将孙尚香嫁给刘备。孙权与周瑜被人嘲笑“周郎妙计安天下，赔了夫人又折兵”"]},{"id":42163,"word":"赔本买卖","pinyin":"péi běn mǎi mài","abbr":"pbmm","explanation":"亏损的生意。泛指吃亏的事。","example":{"text":"别取笑了，我已经做了～。"},"similar":["折本买卖"],"opposite":["一本万利","无本生意"],"usage":"作主语、宾语、定语；指亏本"},{"id":42164,"word":"赔身下气","pinyin":"péi shēn xià qì","abbr":"psxq","explanation":"谦躬屈节，低声下气。","source":{"text":"宝玉又是天生成惯能作小服低，赔身下气，情性体贴，话语绵缠。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["低声下气"],"usage":"作谓语、定语、状语；指人谦卑的样子"},{"id":42165,"word":"赖有此耳","pinyin":"lài yǒu cǐ ěr","abbr":"lyce","explanation":"赖：依赖、倚靠。幸亏有一着（才得解救）。","source":{"text":"石勒不知书，使人读汉书。闻郦食其劝立六国后，刻印将授之，大惊曰：‘此法当失，云何得遂有天下？’至留侯谏，乃曰：‘赖有此耳！’","book":"南朝·宋·刘义庆《世说新语·识鉴》"},"example":{"text":"文足安邦，武能御侮，清之不亡，赖有此耳。","book":"蔡东藩《清史演义》第六十七回"},"usage":"作谓语、分句；用于庆幸"},{"id":42166,"word":"赖骨顽皮","pinyin":"lài gǔ wán pí","abbr":"lgwp","explanation":"形容蛮横倔强，不肯认罪或服输。","source":{"text":"这媳妇年纪儿虽小，极是个赖骨顽皮不怕打的。","book":"元·关汉卿《窦娥冤》第二折"}},{"id":42167,"word":"赘食太仓","pinyin":"zhuì shí tài cāng","abbr":"zstc","explanation":"指无功受禄。","source":{"text":"予年过七十，法当致仕……乡衮赵子直不妨使绝禄粟，俾之因任，方用赘食太仓为愧，而亲朋谓予爵位不逮二兄，以为耿耿。","book":"宋洪迈《容斋三笔人当知足》"},"usage":"作谓语、宾语、定语；用于自谦"},{"id":42168,"word":"赛雪欺霜","pinyin":"sài xuě qī shuāng","abbr":"sxqs","explanation":"欺：超过。比雪冷，比霜寒。比喻表情冷漠、严峻。","source":{"text":"姑娘因作了那等一个梦，这一提起儿，又把他好斩钢截铁的心肠，～的面孔给提回来，更打了紧板了。","book":"清·文康《儿女英雄传》第十二三回"},"usage":"作谓语、定语；用于比喻句"},{"id":42169,"word":"赜探隐索","pinyin":"zé tàn yǐn suǒ","abbr":"ztys","explanation":"指探索事物的奥妙。","source":{"text":"［程篁墩］赜探隐索，注释经传，旁引曲证，而才与力又足以达之。","book":"明·李东阳《〈篁墩文集〉序》"},"example":{"text":"明·李东阳《序》：“～，注释经传，旁引曲证，而才与力又足以达之。”"},"similar":["探赜索隐"],"usage":"作谓语、定语；用于书面语"},{"id":42170,"word":"赞不容口","pinyin":"zàn bù róng kǒu","abbr":"zbrk","explanation":"赞美的话口里已容纳不下。","source":{"text":"圣公待其书完，接过风咏，觉情文交至，于无可形容处形容出来，与历来名人所题另是一付杼轴，不禁赞不容口。","book":"清·夏敬渠《野叟曝言》第一百三十九回"},"similar":["赞不绝口"],"usage":"作谓语、状语；用于书面语"},{"id":42171,"word":"赞不绝口","pinyin":"zàn bù jué kǒu","abbr":"zbjk","explanation":"不住口地称赞。","source":{"text":"宝玉看了，赞不绝口。","book":"清·曹雪芹《红楼梦》第六十四回"},"example":{"text":"他常常在我面前把秋桐的文章捧上了天，～。","book":"邹韬奋《经历·新闻记者的作品》"},"similar":["誉不绝口","赞口不绝"],"opposite":["骂不绝口"],"usage":"作谓语、定语；指很好"},{"id":42172,"word":"赞口不绝","pinyin":"zàn kǒu bù jué","abbr":"zkbj","explanation":"不住口地称赞。","source":{"text":"丁大爷听了，越想越是，不由的赞口不绝。","book":"清·石玉昆《三侠五义》第六十一回"},"similar":["赞不绝口","赞声不绝","交口称誉"],"usage":"作谓语、定语；指很好"},{"id":42173,"word":"赞叹不已","pinyin":"zàn tàn bù yǐ","abbr":"ztby","explanation":"已：止，完。连声赞赏不止。","source":{"text":"庄绍光看了，赞叹不已。","book":"清·吴敬梓《儒林外史》第34回"},"example":{"text":"看了这次《鹿回头》演出，观众～。"},"similar":["赞不绝口"],"usage":"作谓语、状语；指称赞"},{"id":42174,"word":"赞叹不置","pinyin":"zàn tàn bù zhì","abbr":"ztbz","explanation":"赞叹：称赞；置：停止。不停地称赞。形容对人或事物非常赞赏。","source":{"text":"时虽隆冬，而花木绮馥，无异三春。生大奇之，赞叹不置。","book":"清·王韬《淞隐漫录·鹃红女史》"},"example":{"text":"修甫把秋谷这一首诗翻来覆去的看了几遍，～。（清·张春帆《九尾龟》第十一回）"},"similar":["赞叹不已"],"usage":"作谓语、状语；指称赞"},{"id":42175,"word":"赞声不绝","pinyin":"zàn shēng bù jué","abbr":"zsbj","explanation":"连续不断地称赞。形容对人或事物非常赞赏。","source":{"text":"字势飞舞，魏生赞不绝口。","book":"明·冯梦龙《警世通言》卷二十七"},"example":{"text":"素臣把《左传》上大小战伐之事，细细讲解，指点出许多兵法，把众人喜得欢声如雷，～。","book":"清·夏敬渠《野叟曝言》第七十六回"},"similar":["赞不绝口","赞口不绝"],"usage":"作谓语、定语；指很好"},{"id":42176,"word":"赢奸卖俏","pinyin":"yíng jiān mài qiào","abbr":"yjmq","explanation":"指风流调情。"},{"id":42177,"word":"赢粮景从","pinyin":"yǐng liáng jǐng cóng","abbr":"yljc","explanation":"赢粮：携带充足的粮食；景从：如影子跟随形体。携带充足的粮食去追随他人。","source":{"text":"斩木为兵，揭竿为旗，天下云集响应，赢粮而景从，山东豪俊遂并起而亡秦族矣。","book":"《史记·陈涉世家》"},"example":{"text":"敌骑往还，猋驰鸟逝，～，万两方行，迨乎我来，寇已遁去。","book":"《宋史·孙何传》"}},{"id":42178,"word":"赢金一经","pinyin":"yíng jīn yī jīng","abbr":"yjyj","explanation":"指留下满筐的金银，不如传授一经。赢，通“籝”。","source":{"text":"今书本籝字或作盈，又是盈满之义。","book":"《汉书·韦贤传》：“贤四子；长子方山为高寝令，早终；次子弘，至东海太守；次子舜，留鲁守坟墓；少子玄成，复以明经历位至丞相。故邹鲁谚曰：‘遗子黄金满籝，不如一经。’”颜师古注"}},{"id":42179,"word":"赤体上阵","pinyin":"chì tǐ shàng zhèn","abbr":"ctsz","explanation":"阵：指战场。光着膀子上阵交战。比喻不顾一切，勇敢战斗。也比喻公然跳出来干坏事。","source":{"text":"许褚性起，飞回阵中，卸下盔甲，浑身筋突，赤体提刀，翻身上马，来与马超决战。","book":"明·罗贯中《三国演义》第59回"},"example":{"text":"许褚～，也就很中了好几箭。","book":"鲁迅《华盖集续编·空谈》"},"similar":["赤膊上阵"],"usage":"作谓语、宾语；由于处事"},{"id":42180,"word":"赤县神州","pinyin":"chì xiàn shén zhōu","abbr":"cxsz","explanation":"中国的别称。","source":{"text":"中国名曰赤县神州。赤县神州内自有九州。","book":"《史记·孟子荀卿列传》"},"example":{"text":"凭着短剑长琴，游遍～。","book":"元·范子安《竹叶舟》第二折"},"similar":["神州大地"],"usage":"作主语、宾语；指中原或中国"},{"id":42181,"word":"赤口毒舌","pinyin":"chì kǒu dú shé","abbr":"ckds","explanation":"赤：火红色。形容言语恶毒，出口伤人。","source":{"text":"鸟为居停主人不觉察，贪向何人家，行赤口毒舌，毒虫头上却吃月，不啄杀。","book":"唐·卢仝《月蚀》诗"},"similar":["恶言恶语","出口伤人"],"usage":"作宾语、定语；指言语恶毒"},{"id":42182,"word":"赤口烧城","pinyin":"chì kǒu shāo chéng","abbr":"cksc","explanation":"赤舌：指谗言。比喻谗言为害极其严重。","source":{"text":"谮有国兮，赤口烧城；烦言喷兮，积毁销骨。","book":"明·杨慎《后蚊赋》"},"similar":["赤舌烧城"],"usage":"作谓语、定语；比喻谗言危害很大"},{"id":42183,"word":"赤口白舌","pinyin":"chì kǒu bái shé","abbr":"ckbs","explanation":"赤：火红色。形容言语恶毒，出口伤人。","source":{"text":"鸟为居停主人不觉察，贪向何人家，行赤口毒舌，毒虫头上却吃月，不啄杀。","book":"唐·卢仝《月蚀》诗"},"example":{"text":"今日祭祖哩，休得～的，罚那毒誓。","book":"清·夏敬渠《野叟曝言》第二十八回"},"similar":["赤口毒舌"],"usage":"作宾语、定语；指言语恶毒"},{"id":42184,"word":"赤地千里","pinyin":"chì dì qiān lǐ","abbr":"cdql","explanation":"赤：空。形容天灾或战争造成大量土地荒凉的景象。","source":{"text":"晋国大旱，赤地千里。","book":"《韩非子·十过》"},"example":{"text":"说者谓当兵燹之余，污菜遍野，版籍荡然，人民死亡，～。","book":"清·阮葵生《茶余客话》卷三"},"similar":["寸草不留","不毛之地"],"opposite":["郁郁葱葱","蓊蓊郁郁"],"usage":"作谓语、定语；形容旱灾、虫灾等严重","story":["春秋时期，卫灵公到晋国去途中夜宿濮水上游，夜半听到神秘琴声，他命乐官师涓记录下来，会见时给晋平公演奏。晋国乐官师旷说这是亡国之音，晋平公还意犹未尽。第二次演奏时大风大雨相随，后来发生大旱，三年之内造成赤地千里"]},{"id":42185,"word":"赤壁鏖兵","pinyin":"chì bì áo bīng","abbr":"cbab","explanation":"鏖：激战。汉献帝建安十三年，曹操大军伐吴，孙权联合刘备军队联合抗曹，联军于赤壁用火攻大破曹兵的一次激战。泛指激烈的战斗。","source":{"text":"叵耐刘备那厮，暗地夺取荆州，想他赤壁鏖兵，全仗我东吴力气。","book":"元·无名氏《隔江斗智》第一折"},"example":{"text":"～用火攻，运筹决策尽皆同。","book":"明·罗贯中《三国演义》第47回"},"usage":"作主语、宾语；比喻经过艰苦奋斗取得胜利"},{"id":42186,"word":"赤子之心","pinyin":"chì zǐ zhī xīn","abbr":"czzx","explanation":"赤子：初生的婴儿。比喻人心地纯洁善良。","source":{"text":"大人者，不失其赤子之心者也。","book":"《孟子·离娄下》"},"example":{"text":"尧、舜、禹、汤、周、孔，时刻以救民济世为心，所谓～，原不过是“不忍”二字。","book":"清·曹雪芹《红楼梦》第一一八回"},"similar":["赤胆忠心","耿耿忠心"],"opposite":["蛇蝎心肠","狼心狗肺"],"usage":"作主语、宾语；指报国之心","story":["战国时期，孟子与齐宣王谈论君臣之间的关系而一般正直人应有的态度。孟子说：所谓大人就是通达事理的人并没有奇特的地方，其可贵的地方就是在任何时候都没有失掉孩提时代的一片真心，像小孩子那样纯朴、真诚、热烈"]},{"id":42187,"word":"赤心奉国","pinyin":"chì xīn fèng guó","abbr":"cxfg","explanation":"赤：火红色，比喻真纯；赤心：忠心。形容赤胆忠心，为国效力。","source":{"text":"莫不赤心奉国，忠孝全身。","book":"《敦煌变文集·佛说阿弥陀经讲经文》"},"example":{"text":"我～，何罪之有。"},"similar":["赤心报国"],"usage":"作谓语、宾语、定语；指为国效力"},{"id":42188,"word":"赤心报国","pinyin":"chì xīn bào guó","abbr":"cxbg","explanation":"赤：火红色，比喻真纯；赤心：忠心；报国：为国家效劳。旧指为帝王尽忠效劳。现亦形容赤胆忠心，为国效力。","source":{"text":"赤心报国无片赏，白首还家有几人。","book":"唐·刘长卿《疲兵篇》"},"example":{"text":"如今归顺万岁，就是唐家的臣子，自当要～。","book":"《说唐》第57回"},"similar":["精忠报国","赤心奉国"],"opposite":["卖国求荣"],"usage":"作谓语、宾语、定语；指为国效力"},{"id":42189,"word":"赤心相待","pinyin":"chì xīn xiāng dài","abbr":"cxxd","explanation":"赤心：真诚的心。真心诚意对待别人。","source":{"text":"做了一程夫妻，彼此赤心相待，白首相期。","book":"元·乔梦符《两世姻缘》第一折"},"similar":["坦诚相待"],"opposite":["虚情假意"],"usage":"作谓语、定语；指处世"},{"id":42190,"word":"赤手光拳","pinyin":"chì shǒu guāng quán","abbr":"csgq","explanation":"赤手：空手。两手空空，一无所有。比喻无任何凭借或一无所有。","source":{"text":"你赤手光拳，做成偌大家计，虽然无子，尚还可图。","book":"明·伏雌教主《醋葫芦》第五回"},"similar":["赤手空拳"],"usage":"作谓语、定语、状语；比喻办事缺乏物质基础"},{"id":42191,"word":"赤手空拳","pinyin":"chì shǒu kōng quán","abbr":"cskq","explanation":"赤手：空手。两手空空。比喻没有任何依靠。","source":{"text":"争奈他赤手空拳。","book":"元·马致远《任风子》第一折"},"example":{"text":"老人没了主意，日本兵有枪，他自己～。","book":"老舍《四世同堂》三十五"},"similar":["手无寸铁","赤手光拳"],"opposite":["兵强马壮","坚甲利兵"],"usage":"作谓语、定语、状语；比喻办事缺乏物质基础"},{"id":42192,"word":"赤手起家","pinyin":"chì shǒu qǐ jiā","abbr":"csqj","explanation":"空手发家。","source":{"text":"君虽亦赤手起家，而好施出其性。岁饥，发粟给其比邻二百户，能损殖以自损。","book":"宋·文天祥《邹仲翔墓志铭》"},"similar":["白手起家"],"usage":"作谓语、宾语、定语；用于生活"},{"id":42193,"word":"赤绳系足","pinyin":"chì shéng jì zú","abbr":"csjz","explanation":"赤绳：红绳；系：结、扣。旧指男女双方经由媒人介绍而成亲。","source":{"text":"固问囊中何物，曰：‘赤绳子耳！以系夫妻之足，及其生则潜用相系，虽仇敌之家，贵贱悬隔，天涯从宦，吴楚异乡，此绳一系，终不可绾。’","book":"唐·李复言《续玄怪录》"},"example":{"text":"从来说月下老人～，虽千里之外，到底相合。","book":"明·凌濛初《初刻拍案惊奇》卷五"},"similar":["赤绳绾足"],"usage":"作宾语、定语；指男女结成婚姻","story":["古代杜陵少年韦固，一天在路上遇到一个靠着红布囊席地而坐的老人，觉得奇怪，就去问老人。老人说他是主管天下婚姻的，囊中的红绳是用来将夫妻的脚系在一起的，不管他们两人相隔多远，终究会走到一起的，如果断裂就夫妻离散"]},{"id":42194,"word":"赤绳绾足","pinyin":"chì shéng wǎn zú","abbr":"cswz","explanation":"赤绳：红绳；绾：系。指男女结成婚姻。","source":{"text":"想赤绳绾足再难逃，只愿得同谐到老，历天长地久，永把琴瑟调。","book":"明·张景《飞丸记·盟寻泉石》"},"similar":["赤绳系足"],"usage":"作谓语、定语；指男女结成婚姻"},{"id":42195,"word":"赤胆忠心","pinyin":"chì dǎn zhōng xīn","abbr":"cdzx","explanation":"赤：比喻真纯。形容十分忠诚。","source":{"text":"贼子豪雄是李全，忠心赤胆向胡天，靴尖踢倒长天堑，却笑江南土不坚。","book":"明·汤显祖《还魂记·淮警》"},"example":{"text":"又有公子一个嬷嬷爹，这人姓华名忠，年纪五十岁光景，一生耿直，～。","book":"清·文康《儿女英雄传》第一回"},"similar":["忠心耿耿","披肝沥胆","耿耿此心"],"opposite":["阳奉阴违","口是心非"],"usage":"作谓语、宾语、状语；指对集体的忠诚"},{"id":42196,"word":"赤胆忠肝","pinyin":"chì dǎn zhōng gān","abbr":"cdzg","explanation":"赤：赤诚，真诚；忠：忠诚。形容十分忠诚。","source":{"text":"我这一个丹心碧血扶周主，那一个赤胆忠肝助纣王。","book":"明·许仲琳《封神演义》第95回"},"example":{"text":"你坏得了我的清名，坏不了我的～。"},"similar":["赤胆忠心"],"opposite":["阳奉阴违"],"usage":"作谓语、宾语、状语；指对集体的忠诚"},{"id":42197,"word":"赤膊上阵","pinyin":"chì bó shàng zhèn","abbr":"cbsz","explanation":"光着膀子上阵。比喻亲身上场，不加掩饰地进行活动。","source":{"text":"许褚性起，飞回阵中，卸下盔甲，浑身筋突，赤体提刀，翻身上马，来与马超决战。","book":"明·罗贯中《三国演义》第五十九回"},"example":{"text":"他终于～，亲自出马了。"},"similar":["赤手上阵","轻装上阵"],"opposite":["披挂上阵","披坚执锐"],"usage":"作谓语、宾语；用于处事","story":["东汉末年，军阀割据，马超为报杀父之仇率军在渭河一带与曹操激战。曹操大将许褚一时杀得性起，干脆脱掉盔甲赤膊上阵，与马超大战一天，还不分胜负"]},{"id":42198,"word":"赤舌烧城","pinyin":"chì shé shāo chéng","abbr":"cssc","explanation":"赤：火红色。赤舌如火，足以烧城。比喻毁谤或挑拔离间的话非常伤害人。","source":{"text":"赤舌烧城，吐水于瓶。","book":"汉·扬雄《太玄经·干》"},"example":{"text":"～，犹众口烁金之意。小人架辞诬害君子，其舌赤若火，势欲烧城。","book":"清·陈本礼《太玄阐秘》"},"similar":["赤口烧城"],"usage":"作谓语、定语；比喻谗言危害很大"},{"id":42199,"word":"赤诚相待","pinyin":"chì chéng xiāng dài","abbr":"ccxd","explanation":"赤诚：极真诚、忠诚。以至诚之心待人。","source":{"text":"这所剩的数千饥饿疲惫之师因感学生一片忠君爱国之心和平日赤诚相待，暂时不忍离去，勉强可以一战。","book":"姚雪垠《李自成》第一卷第二十三章"},"example":{"text":"我们～，彼此没有二心。"},"similar":["赤心相待","赤诚相见"],"opposite":["虚情假意"],"usage":"作谓语、定语；用于人际交往"},{"id":42200,"word":"赤贫如洗","pinyin":"chì pín rú xǐ","abbr":"cprx","explanation":"赤贫：穷得一无所有。形容极其贫穷。","source":{"text":"初卜居于芝街，时赤贫如洗，古耕殆不给衣食。","book":"《先哲丛谈物茂卿》"},"example":{"text":"他老人家两个儿子，四个孙子，家里仍然～。","book":"清·吴敬梓《儒林外史》第三十一回"},"similar":["一无所有","不名一文","家道壁立"],"opposite":["家财万贯","金玉满堂","堆金叠玉"],"usage":"作谓语、定语；形容极端贫穷"},{"id":42201,"word":"赤身裸体","pinyin":"chì shēn luǒ tǐ","abbr":"cslt","explanation":"赤：光着。大部分身体或全身裸露。","source":{"text":"耀武扬威，辱骂不绝；多有解衣卸甲，赤身裸体，或谁或坐。","book":"明·罗贯中《三国演义》第84回"},"example":{"text":"公共场所不能～。"},"similar":["一丝不挂","赤身露体"],"opposite":["衣冠楚楚"],"usage":"作谓语、宾语、定语、状语；指全身裸露"},{"id":42202,"word":"赤身露体","pinyin":"chì shēn lù tǐ","abbr":"cslt","explanation":"指光着身子，衣不蔽体。也指赤祼全身，不穿衣服。","source":{"text":"吴班引兵到关前搦战，耀武扬威，辱骂不绝，多有解衣卸甲，赤身裸体，或睡或坐。","book":"明·罗贯中《三国演义》第八十四回"},"example":{"text":"～，走到人前，成何体面？","book":"清·文康《儿女英雄传》第八回"},"similar":["一丝不挂","赤身裸体"],"opposite":["衣冠楚楚"],"usage":"作谓语、定语、状语；指全身裸露，一丝不挂"},{"id":42203,"word":"赦不妄下","pinyin":"shè bù wàng xià","abbr":"sbwx","explanation":"赦：赦令；妄：胡乱。不胡乱下达赦令。形容赏罚严明。","source":{"text":"故亮时，军旅属兴，赦不妄下也。","book":"晋·常璩《华阳国志·刘后主传》"},"usage":"作谓语、定语；指赏罚严明"},{"id":42204,"word":"赦事诛意","pinyin":"shè shì zhū yì","abbr":"sszy","explanation":"赦：赦免；事：指罪恶事实；诛：惩罚；意：指不良意图。赦免有罪的人而惩罚只是图谋不轨却并无具体行动的人。","source":{"text":"谞闻春秋之义，原情定过，赦事诛意，故许止虽弒君而不罪，赵盾以纵贼而见书。","book":"《后汉书·霍谞传》"}},{"id":42205,"word":"赦过宥罪","pinyin":"shè guò yòu zuì","abbr":"sgyz","explanation":"指赦免过错，宽恕罪行。","source":{"text":"雷雨作，解，君子以赦过宥罪。","book":"《易·解》"},"example":{"text":"思所以议狱缓死，～，庶因大变，与之更始。","book":"《晋书·孝武帝纪》"},"usage":"作谓语、定语；用于处事等"},{"id":42206,"word":"赧颜汗下","pinyin":"nǎn yán hàn xià","abbr":"nyhx","explanation":"脸发红，额头流汗。形容羞愧到了极点。","source":{"text":"公子誉过之情，令人赧颜汗下。","book":"明·明教中人《好逑传》第七回"},"example":{"text":"一见到她的到来，他不觉就～"},"usage":"作谓语；用于处事"},{"id":42207,"word":"赧颜苟活","pinyin":"nǎn yán gǒu huó","abbr":"nygh","explanation":"苟活：苟且偷生地活着。含羞带愧，苟且偷生地活着。","example":{"text":"洪承畴叹了口气，几乎说出来自己是“～”，但是话到口边就赶快咽了下去。","book":"姚雪垠《李自成》第三卷第二十九章"}},{"id":42208,"word":"赫斯之威","pinyin":"hè sī zhī wēi","abbr":"hszw","explanation":"赫：显耀；斯：语助词；威：威严。指帝王或显耀人物威武奋发的样子。","source":{"text":"陛下宜奋赫斯之威，臣等当得负戈前驱，庶凭宗庙之灵，有征无战。","book":"《晋书·应詹传》"},"usage":"作宾语；用于帝王等"},{"id":42209,"word":"赫斯之怒","pinyin":"hè sī zhī nù","abbr":"hszn","explanation":"赫：怒意。形容帝王盛怒。","source":{"text":"王赫斯怒，爰整其旅。","book":"《诗经·大雅·皇矣》"},"example":{"text":"而人君有～，芟夷之诛。","book":"《抱朴子·论仙》"},"usage":"作宾语；用于帝王等"},{"id":42210,"word":"赫然有声","pinyin":"hè rán yǒu shēng","abbr":"hrys","explanation":"赫然：显著盛大的样子；声：名声。形容名声很大。","source":{"text":"其后一二年，所与及第者，皆赫然有声。","book":"唐·韩愈《与祠部陆员外书》"},"example":{"text":"阁下又且～，烈于天下，复得位于朝，见用于天子。","book":"宋·石介《上孔中丞书》"}},{"id":42211,"word":"赫然而怒","pinyin":"hè rán ér nù","abbr":"hren","explanation":"形容大怒。火冒三丈的样子。","source":{"text":"若闻义不服，天子赫然震怒。","book":"《汉书·枚乘传》：“汉知吴之有吞天下之心也，赫然加怒。”《后汉书·张皓传》"},"example":{"text":"监戎者以闻。上赫然大怒，命大将职正其罪。","book":"唐·皮日休《白门表》"},"similar":["赫然震怒"],"usage":"作谓语；用于人发怒"},{"id":42212,"word":"赫然耸现","pinyin":"hè rán sǒng xiàn","abbr":"hrsx","explanation":"显示出一种给人印象深刻的或夸大的形像。","example":{"text":"他的光辉形象～在我的作品中。"},"usage":"作谓语；用于书面语"},{"id":42213,"word":"赫赫之光","pinyin":"hè hè zhì guāng","abbr":"hhzg","explanation":"赫赫：显著貌。原指太阳的光明亮清晰。后比喻人享有很高的威望和声势。","source":{"text":"赫赫乎日之光，群目之用也。","book":"汉·杨雄《法言·五百》"},"example":{"text":"高材多戚戚之穷，盛位无～。","book":"唐·韩愈《与于襄阳书》"},"usage":"作宾语；指人的威势和声望"},{"id":42214,"word":"赫赫之功","pinyin":"hè hè zhì gōng","abbr":"hhzg","explanation":"赫赫：盛大显著貌。显赫的业绩。形容功劳极大。","source":{"text":"无绵绵之事者，无赫赫之功。","book":"《大戴礼记·劝学》"},"example":{"text":"无惛惛之事者，无～。","book":"战国·赵·荀况《荀子·劝学》"},"usage":"作宾语；指人的功劳"},{"id":42215,"word":"赫赫之名","pinyin":"hè hè zhì míng","abbr":"hhzm","explanation":"赫赫：显著盛大的样子。声名非常显赫。","source":{"text":"其所居亦无赫赫名，去后常见思。","book":"《汉书·何武传》"},"example":{"text":"临州郡虽无～，及去，民思之。","book":"晋·常璩《华阳国志·先贤士女》"},"similar":["赫赫声名"],"usage":"作宾语、定语；指名声大"},{"id":42216,"word":"赫赫声名","pinyin":"hè hè shēng míng","abbr":"hhsm","explanation":"及其显赫的声名。同“赫赫之名”。","source":{"text":"赫赫声名三十春，高情人独出尘埃。","book":"唐·张籍《送白宾客分司东都》"},"example":{"text":"我不想有～，只求平安过日子。"},"similar":["赫赫之名"],"usage":"作宾语、定语；指名声大"},{"id":42217,"word":"赫赫巍巍","pinyin":"hè hè wēi wēi","abbr":"hhww","explanation":"显赫高大的样子。","source":{"text":"众美备具，名实相当，赫赫巍巍，超今冠古。","book":"唐·韩愈《贺册尊号表》"},"example":{"text":"～，及时纯熙。昊天成命，后则受之。","book":"《宋史·乐志七》"},"similar":["赫赫魏魏"],"usage":"作谓语、定语；用于书面语"},{"id":42218,"word":"赫赫扬扬","pinyin":"hè hè yáng yáng","abbr":"hhyy","explanation":"赫赫：显赫的样子。①光明盛大的样子。②形容兴旺显赫。","source":{"text":"赫赫扬扬，日出东方。","book":"明·汤显祖《牡丹亭·诊崇》"},"example":{"text":"如今我们家～，已将百载。","book":"清·曹雪芹《红楼梦》第十三回"},"usage":"作谓语、定语；用于势头等"},{"id":42219,"word":"赫赫时名","pinyin":"hè hè shí míng","abbr":"hhsm","explanation":"及其显赫的声名。同“赫赫之名”。","source":{"text":"悠悠往事杯中物，赫赫时名扇外尘。","book":"唐·戴叔伦《暮春感怀》诗之二"},"similar":["赫赫声名","赫赫之名","赫赫有声"],"usage":"作宾语、定语；指名声大"},{"id":42220,"word":"赫赫有名","pinyin":"hè hè yǒu míng","abbr":"hhym","explanation":"赫赫：显著盛大的样子。声名非常显赫。","source":{"text":"赫赫师尹，民具尔瞻。","book":"《诗经·小雅·节南山》"},"example":{"text":"况且他罗家也是著名的盐商，不过近年稍为疲了点罢了，在外面还是～的，怕没人知道么？","book":"清·吴趼人《二十年目睹之怪现状》"},"similar":["举世闻名","大名鼎鼎","扬名天下"],"opposite":["不见经传","默默无闻","无声无息"],"usage":"作谓语、定语；指人的声名等","story":["西汉时期，扬州刺史何武为人仁厚，喜欢举荐有才能的人，他反对结党营私、任人唯亲。如果要任命下属时，均采用公开公证的方式选择，因此选拔的人大都没有赫赫的名声与靠山。他的上司大司农何寿要他推荐他的侄子扬州长史，他没有推荐这个平庸的人"]},{"id":42221,"word":"赫赫有声","pinyin":"hè hè yǒu shēng","abbr":"hhys","explanation":"赫赫：显耀盛大的样子；声：名声。非常显赫的名声。","source":{"text":"赫赫有声屋间。","book":"清·汪琬《宋既庭五十寿序》"},"example":{"text":"曾朴《孽海花》第十回：“～的世界大都会圣彼德堡，方方百里地，变成皇帝百姓相杀的大战场了。”"},"similar":["赫赫声名","赫赫有名","赫赫之名"],"usage":"作宾语、定语；指名声大"},{"id":42222,"word":"赫赫炎炎","pinyin":"hè hè yán yán","abbr":"hhyy","explanation":"形容势焰炽盛。","source":{"text":"胜、广熛起，梁、籍扇烈，赫赫炎炎，遂焚咸阳。","book":"《诗经·大雅·云汉》：“旱既大甚，则不可沮，赫赫炎炎，云我无所。”《汉书·叙传下》"},"example":{"text":"乍认是花终不是，跋扈飞扬，～地。","book":"赵朴初《蝶恋花·杨花》词"},"usage":"作谓语、定语；用于天气等"},{"id":42223,"word":"赫赫英名","pinyin":"hè hè yīng míng","abbr":"hhym","explanation":"赫赫：显著盛大的样子。英雄的大名，非常显耀，人人知晓。","source":{"text":"其所居亦无赫赫名，去后常见思。","book":"《汉书·何武传》"}},{"id":42224,"word":"赫赫魏魏","pinyin":"hè hè wèi wèi","abbr":"hhww","explanation":"赫赫：显耀盛大的样子；魏：通“巍”。显赫高大的样子。","source":{"text":"神其精而杰其质兮，赫赫魏魏以昂昂。","book":"唐·欧阳詹《回鸾赋》"},"similar":["赫赫巍巍"],"usage":"作谓语、定语；用于书面语"},{"id":42225,"word":"赭衣半道","pinyin":"zhě yī bàn dào","abbr":"zybd","explanation":"赭衣：古代囚犯穿的衣服，赤褐色。穿囚服的人很多。形容犯罪的人多。","source":{"text":"至秦则不然。贵为天子，富有天下，赋敛重数，百姓任罢，赭衣半道，群盗满山，使天下之人戴目而视，倾耳而听。","book":"《汉书·贾山传》"},"example":{"text":"天子斋居，日夜祷祠，相公宿直，争献青词，～，断首满稽。（清·王士禛《池北偶谈》卷十八）"}},{"id":42226,"word":"赭衣塞路","pinyin":"zhě yī sàī lù","abbr":"zysl","explanation":"穿囚服的人挤满了道路。形容罪犯很多。","source":{"text":"而奸邪并生，赭衣塞路。","book":"《汉书·刑法志》"},"example":{"text":"昔商俗未移，民散久矣，婴网陷辟，日夜相寻，若悉加正法，则～。","book":"《梁书·武帝纪中》"},"similar":["赭衣满道"],"usage":"作宾语、定语；指社会不稳"},{"id":42227,"word":"赭衣满道","pinyin":"zhě yī mǎn dào","abbr":"zymd","explanation":"赭衣：古代囚犯穿的衣服，赤褐色。穿囚服的人很多，充满了道路。形容犯罪的人多。","source":{"text":"昔秦任狱吏，赭衣满道。汉革其风，矫枉过正，禁网疏阔，遂漏吞舟。","book":"《隋书·酷吏传序》"},"example":{"text":"从此秦人不能有为，动罹法网，～，黑狱丛冤。（蔡东藩《前汉演义》第二回）"},"similar":["赭衣塞路"],"usage":"作宾语、定语；指社会不稳"},{"id":42228,"word":"走下坡路","pinyin":"zǒu xià pō lù","abbr":"zxpl","explanation":"下坡路：由高处通向低处的道路。比喻向衰落或坏的方向发展","example":{"text":"人过了四十，身体就开始～了"},"similar":["每况愈下"],"opposite":["蒸蒸日上"],"usage":"作谓语、宾语、定语；用于口语"},{"id":42229,"word":"走丸逆坂","pinyin":"zǒu wán nì bǎn","abbr":"zwnb","explanation":"走丸：滚弹丸；坂：同“阪”，山坡。逆着山坡滚弹丸。比喻所求与所行相背离，难偿所愿","source":{"text":"芳饵之下，必有悬鱼，惜其重赏，求人死力，走丸逆坂，匹此非难。凡百骁雄，谁不雠怨。","book":"《旧唐书·李密传》"},"similar":["阪上走丸"],"usage":"作宾语、定语；用于书面语"},{"id":42230,"word":"走为上着","pinyin":"zǒu wèi shàng zhaō","abbr":"zwsz","explanation":"指遇到强敌或陷于困境时，以离开回避为最好的策略。","source":{"text":"娘道：‘我儿，‘三十六着，走为上着’。只恐没处走。’","book":"明·施耐庵《水浒传》第二回"},"example":{"text":"钱江道：“黑暗官吏擅威作福，为足下计，倒是～。”","book":"《洪秀全演义》第十回"},"similar":["走为上策","走为上计"],"usage":"作谓语、定语；指离开"},{"id":42231,"word":"走为上策","pinyin":"zǒu wéi shàng cè","abbr":"zwsc","explanation":"指遇到强敌或陷于困境时，以离开回避为最好的策略。","source":{"text":"李助道：‘事已如此，三十六策，走为上策！’","book":"明·施耐庵《水浒传》第一百四回"},"example":{"text":"他感到，内心的一些想法摆到桌面上是站不住脚的，还是～。","book":"蒋子龙《机电局长的一天》"},"similar":["走为上计","走为上着"],"usage":"作谓语、定语；指离开"},{"id":42232,"word":"走为上计","pinyin":"zǒu wèi shàng jì","abbr":"zwsj","explanation":"遇到强敌或陷于困境时，以离开回避为最好的策略。","source":{"text":"檀公三十六策，走是上计。","book":"《南齐书·王敬则传》"},"example":{"text":"却才宋押司也教我们～，却是走那里去好？","book":"明·施耐庵《水浒传》第18回"},"similar":["走为上策","走为上着"],"usage":"作谓语、定语；指离开"},{"id":42233,"word":"走乡随乡","pinyin":"zǒu xiāng suí xiāng","abbr":"zxsx","explanation":"走到哪里就顺随哪里的民情习俗。","example":{"text":"我们～就能很快适应新的环境。"},"similar":["入乡随俗"],"usage":"作谓语、宾语、定语；同“入乡随俗”"},{"id":42234,"word":"走了和尚走不了庙","pinyin":"zǒu lé hé shàng zǒu bù liǎo miào","abbr":"zlhszblm","explanation":"人虽然走了，家却无法搬走。比喻难以逃脱。","source":{"text":"溜了你就别回来！走了和尚走不了庙，看你有本事守得住那点地。","book":"丁玲《太阳照在桑乾河上》"},"example":{"text":"你可以放心，她～的。"},"similar":["跑了和尚跑不了庙"],"usage":"作谓语、分句；指难以逃脱"},{"id":42235,"word":"走伏无地","pinyin":"zǒu fú wú dì","abbr":"zfwd","explanation":"比喻没有藏匿容身的地方。","source":{"text":"蹊路断绝，走伏无地。","book":"《三国志·魏书·钟会传》"},"usage":"作谓语、定语；指没有容身的地方"},{"id":42236,"word":"走南闯北","pinyin":"zǒu nán chuǎng běi","abbr":"zncb","explanation":"指走过南方北方不少地方。也泛指闯荡。","source":{"text":"这年月呀，女人尊贵啦，跟男人一样可以走南闯北的。","book":"老舍《龙须沟》第二幕"},"example":{"text":"他自小～，见过许多大世面。"},"similar":["南征北战"],"opposite":["足不出户","深居简出"],"usage":"作谓语、定语；泛指闯荡"},{"id":42237,"word":"走及奔马","pinyin":"zǒu jí bēn mǎ","abbr":"zjbm","explanation":"走：跑。跑的速度可及得上马的奔跑。形容走路飞快。","source":{"text":"震宇猛略，少骁勇，便骑射，走及奔马，臂力过人。","book":"《周书·达奚武传》"},"usage":"作谓语、定语；用于书面语"},{"id":42238,"word":"走后门","pinyin":"zǒu hòu mén","abbr":"zhm","explanation":"比喻通过托情或利用职权等不正当的途径谋取通融或利益。","source":{"text":"违反党的原则，闹派性，搞特殊化，走后门，铺张浪费，损公肥私。","book":"邓小平《坚持四项基本原则》"},"example":{"text":"路遥《平凡的世界》第四卷第54章：“～就～！为了给少平办成这事，她甚至故意让‘关口’上的人知道她是谁的女儿！”"},"similar":["走捷径"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42239,"word":"走回头路","pinyin":"zǒu huí tóu lù","abbr":"zhtl","explanation":"比喻倒退或按已经不合时宜的老规矩办事。","source":{"text":"我鬼迷昏了头，却不过高松年的情面，吃了许多苦，还要半途而废，走回头路！","book":"钱钟书《围城》"},"example":{"text":"中央的政策说得那么明白，不会再～了。"},"usage":"作谓语、宾语；指墨守成规"},{"id":42240,"word":"走壁飞檐","pinyin":"zǒu bì fēi yán","abbr":"zbfy","explanation":"在墙壁上走，在屋雄上飞。形容武艺高强","source":{"text":"我虽不会长枪大戟，不知走壁飞檐，也颇颇有些肝胆。","book":"清·文康《儿女英雄传》第17回"},"example":{"text":"粤剧《搜书院》第四幕：“非也！只怕仁兄不会～，难入镇台府上。”"},"similar":["飞檐走壁"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":42241,"word":"走头无路","pinyin":"zǒu tóu wú lù","abbr":"ztwl","explanation":"无路可走，已到绝境。比喻处境极困难，找不到出路","source":{"text":"徐宁妻子并两个娅孉，如热鏊子上蚂蚁，走头无路。不茶不饭，慌做一团。","book":"明·施耐庵《水浒传》第56回"},"example":{"text":"清·李宝嘉《官场现形记》第八回：“把个陶子尧真正弄的～，只得又打一个电报给姊夫。”"},"similar":["走投无路","走头没路","走投无计"],"usage":"作谓语、定语、状语；指遇到绝境"},{"id":42242,"word":"走头没路","pinyin":"zǒu tóu méi lù","abbr":"ztml","explanation":"无路可走，已到绝境。比喻处境极困难，找不到出路","source":{"text":"火器一齐发作，杀得他走头没路，大败亏输。","book":"明·冯梦龙《喻世明言》第18卷"},"similar":["走投无路","走头无路","走投无计"],"usage":"作谓语、定语、状语；指遇到绝境"},{"id":42243,"word":"走山泣石","pinyin":"zǒu shān qì shí","abbr":"zsqs","explanation":"山在变动，石头在哭泣。原指桀施暴政即将灭亡。后泛指暴虐的政权即将灭亡。","source":{"text":"桀时泰山，山走石泣。先儒曰：‘桀之所将亡，泰山三日泣，今泰山山石远望之若人泣，盖是也。’周武谓周公曰：‘桀为不道，走山泣石。’","book":"南朝·梁·任昉《述异记》卷上"}},{"id":42244,"word":"走投无计","pinyin":"zǒu tóu wú jì","abbr":"ztwj","explanation":"无路可走，已到绝境。比喻处境极困难，找不到出路","source":{"text":"似这雪呵教冻苏秦走投无计，王子猷也曾访戴空回。","book":"元·无名氏《杀狗劝夫》第二折"},"similar":["走投无路","走头没路","走投没路"],"usage":"作谓语、定语、状语；指遇到绝境"},{"id":42245,"word":"走投无路","pinyin":"zǒu tóu wú lù","abbr":"ztwl","explanation":"投：投奔。无路可走，已到绝境。比喻处境极困难，找不到出路。","source":{"text":"淋的我走投无路，知他这沙门岛是何处鄷都？","book":"元·杨显之《潇湘雨》第三折"},"example":{"text":"她真是～了，只好来求老主人。","book":"鲁迅《彷徨·祝福》"},"similar":["山穷水尽","穷途末路","日暮途穷"],"opposite":["左右逢源","如愿以偿","天从人愿"],"usage":"作谓语、定语、状语；指遇到绝境","story":["明朝末年，李自成率大军打到北京城外，崇祯召来太监曹化淳及几个大臣来商量对策，由于国库空虚，叫大臣及富商出银子组建军队对抗义军。大臣们个个不愿出钱出力，崇祯走投无路，只好杀妻杀子，然后自己到景山上吊自杀"]},{"id":42246,"word":"走投没路","pinyin":"zǒu tóu méi lù","abbr":"ztml","explanation":"没路可走。比喻陷入绝境，没有出路。","source":{"text":"你如今走投没路。我和你去李家叔叔讨口饭儿吃咱。","book":"元·秦简夫《东堂老》第三折"},"example":{"text":"话说当时石秀和卢俊义两个，在城内～，四下里人马合来，众做公的把挠钩搭住，套索绊翻，可怜悍勇英雄，方信寡不敌众。","book":"《水浒传》第六十三回"},"similar":["走投无路","穷途末路","日暮途穷"],"opposite":["左右逢源","如愿以偿","天从人愿"],"usage":"作谓语、定语、状语；指遇到绝境"},{"id":42247,"word":"走斝传觞","pinyin":"zǒu jiǎ chuán shāng","abbr":"zjcs","explanation":"斝、觞：古代酒器。形容宴饮气氛热烈","source":{"text":"日逐讲文论武，走斝传觞，弦歌吹舞，朝去暮回，无般儿不乐。","book":"明·吴承恩《西游记》第三回"},"similar":["走斝飞觥","走斝飞觞"],"usage":"作谓语、定语；用于书面语"},{"id":42248,"word":"走斝飞觞","pinyin":"zǒu jiǎ fēi shāng","abbr":"zjfs","explanation":"斝、觥：古代酒器。形容宴饮气氛热烈","source":{"text":"泛羽流商，走斝飞觞。","book":"元·张可久《寨儿令·秋日宫词》"},"similar":["走斝飞觥","走斝传觞"],"usage":"作谓语、定语；用于书面语"},{"id":42249,"word":"走斝飞觥","pinyin":"zǒu jiǎ fēi gōng","abbr":"zjfg","explanation":"斝、觥：古代酒器。形容宴饮气氛热烈。","source":{"text":"我这里便亲手高擎碧玉锺，走斝飞觥，咱两个兴正浓。","book":"元·无名氏《锁魔镜》第一折"},"similar":["走斝传觞","走斝飞觞"],"usage":"作谓语、定语；用于书面语"},{"id":42250,"word":"走杀金刚坐杀佛","pinyin":"zǒu shā jīn gāng zuò shā fó","abbr":"zsjgzsf","explanation":"杀：程度深；金刚：佛的侍从力士；佛：佛教徒对释迎牟尼的简称。比喻劳逸苦乐不均","source":{"text":"不然，头里就赖他那两个，正是‘走杀金刚坐杀佛。’","book":"明·兰陵笑笑生《金瓶梅词话》第31回"},"usage":"作宾语、定语；用于书面语"},{"id":42251,"word":"走漏天机","pinyin":"zǒu lòu tiān jī","abbr":"zltj","explanation":"走漏：泄漏。泄漏秘密。","source":{"text":"这件事，心知腹知。口里言，心中计，休得便走漏天机。","book":"元·曾瑞《留鞋记》第一折"},"usage":"作谓语、定语；用于书面语"},{"id":42252,"word":"走漏风声","pinyin":"zǒu lòu fēng shēng","abbr":"zlfs","explanation":"消息被透漏出去。","source":{"text":"原来是一家人，决不走漏风声的。","book":"清·钱彩《说岳全传》第六十五回"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“七姑奶奶为怕～，特意约在那里相会。”"},"opposite":["守口如瓶"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42253,"word":"走火入魔","pinyin":"zǒu huǒ rù mó","abbr":"zhrm","explanation":"走火：过头。对某种事物迷恋到失去理智的地步。","source":{"text":"这样下去，只怕他会走火入魔，专动些歪脑筋。","book":"高阳《胡雪岩全传·红顶商人》"},"usage":"作谓语、定语、状语；用于处事"},{"id":42254,"word":"走着瞧","pinyin":"zǒu zhe qiáo","abbr":"zzq","explanation":"等着瞧。等过一段时间再下结论，再见分晓。","source":{"text":"这个叫田福军的人会有多少能耐呢？骑驴看唱本，走着瞧吧！","book":"路遥《平凡的世界》第三卷第四章"},"example":{"text":"～，我不会就此罢休的。"},"similar":["等着瞧"],"usage":"作谓语；用于口语"},{"id":42255,"word":"走石飞沙","pinyin":"zǒu shí fēi shā","abbr":"zsfs","explanation":"沙土飞扬，石块滚动。形容风势狂暴。","source":{"text":"苍梧、南海，岁有风瘴气之害，风则折木，飞沙转石，气则雾郁，飞鸟不经。","book":"《三国志·吴志·陆凯传》"},"example":{"text":"椿岩念动品评，霎时间天昏地暗，～。","book":"明·无名氏《杨家将演义》第三十二"},"similar":["飞沙走石","走石飞砂","飞砂转石"],"usage":"作谓语、宾语、定语；指气候恶劣"},{"id":42256,"word":"走石飞砂","pinyin":"zǒu shí fēi shā","abbr":"zsfs","explanation":"沙土飞扬，石块滚动。形容风势狂暴。","source":{"text":"走石飞砂势更凶，推云拥雾乱行踪。暗藏妖孽来窥户，又送孤帆过楚峰。","book":"明·许仲琳《封神演义》第87回"},"similar":["走石飞沙","飞砂走石"],"usage":"作谓语、宾语、定语；指气候恶劣"},{"id":42257,"word":"走笔成文","pinyin":"zǒu bǐ chéng wén","abbr":"zbcw","explanation":"一下笔就很快写成了文章。形容文思敏捷，才华横溢。","source":{"text":"都要可便吟诗和韵，题着这新建瀛洲，则要个字意相关，走笔成文。","book":"明·无名氏《登瀛洲》第二折"},"similar":["走笔成章","下笔成章","下笔便就"],"opposite":["搜索枯肠"],"usage":"作谓语、定语；用于作文等"},{"id":42258,"word":"走笔成章","pinyin":"zǒu bǐ chéng zhāng","abbr":"zbcz","explanation":"一下笔就很快写成了文章。形容文思敏捷，才华横溢。","source":{"text":"况此妇人走笔成章，吟诗谓赋。","book":"元·关汉卿《谢天香》第四折"},"example":{"text":"胸藏锦绣，口吐珠玑，～，无不通晓。","book":"明·无名氏《浣花溪》第二折"},"similar":["走笔成文","下笔成文","下笔成章"],"opposite":["江郎才尽","搜索枯肠"],"usage":"作谓语、定语；用于作文等"},{"id":42259,"word":"走笔疾书","pinyin":"zǒu bǐ jí shū","abbr":"zbjs","explanation":"走笔：笔行得很快；疾书：快速地写。形容写字熟练、快速。也形容文思敏捷，文章写起来很快","example":{"text":"他～，很快完成一篇大作"},"usage":"作谓语；用于书面语"},{"id":42260,"word":"走笔题诗","pinyin":"zǒu bǐ tí shī","abbr":"zbts","explanation":"走笔：笔划得很快，指快速地写；题：写。形容才思敏捷","source":{"text":"……爱他那走笔题诗，出口成章。","book":"元·马致远《青山泪》第四折"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":42261,"word":"走肉行尸","pinyin":"zǒu ròu xíng shī","abbr":"zrxs","explanation":"走肉：会走动而没有灵魂的躯壳；行尸：可以走动的尸体。比喻不动脑筋，不起作用，糊里糊涂过日子的人。","source":{"text":"夫人好学，虽死若存；不学者，虽存，谓之行尸走肉耳。","book":"晋·王嘉《拾遗记》卷六"},"example":{"text":"这纷纷的四万万～，你们还相信是你们的血裔？","book":"闻一多《长城下之哀歌》"},"similar":["行尸走骨","行尸走肉","走骨行尸"],"usage":"作宾语、定语；指没有思想的人"},{"id":42262,"word":"走胡走越","pinyin":"zǒu hú zǒu yuè","abbr":"zhzy","explanation":"胡：古代北方和西方各民族的泛称；越：古国名，在今江浙一带。比喻智能之士被迫逃亡，为敌国所用","source":{"text":"今上始得天下，独以己之私怨求一人，何示天下之不广也！且以季布之贤而汉求之急如此，此不北走胡即南走越耳。","book":"西汉·司马迁《史记·季布栾布列传》"},"example":{"text":"梁启超《中国学术思想变迁之大势》第三章第一节：“盖得之则可以为雄，失之且恐其～，以为吾患也。”"},"usage":"作谓语、定语；用于书面语"},{"id":42263,"word":"走花溜冰","pinyin":"zǒu huā liū bīng","abbr":"zhlb","explanation":"比喻吹牛，说大话。","source":{"text":"你莫象才来的那个和尚，走花溜冰的胡缠。","book":"明·吴承恩《西游记》第七十四回"}},{"id":42264,"word":"走花溜水","pinyin":"zǒu huā liū bīng","abbr":"zhls","explanation":"比喻吹牛，说大话。","source":{"text":"你莫象才来的那个和尚，走花溜水的胡缠。","book":"明·吴承恩《西游记》第七十四回"},"usage":"作谓语、宾语、定语、状语；指说大话"},{"id":42265,"word":"走蚓惊蛇","pinyin":"zǒu yǐn jīng shé","abbr":"zyjs","explanation":"蚓：蚯蚓。跑着的蚯蚓，惊走的蛇。形容矫健迅捷的笔势","source":{"text":"锦绣额赠新题走蚓惊蛇，丹青帧摸巧样回莺舞鹤。","book":"元·汤式《一枝花·赠明时秀》套曲"},"example":{"text":"明·陈大声《北伴读书·富文堂宴赏》曲：“简书文半逼苏，诗律法全学杜，～，写一笔唐怀素。”"},"usage":"作宾语、定语；用于书面语"},{"id":42266,"word":"走街串巷","pinyin":"zǒu jiē chuàn xiàng","abbr":"zjcx","explanation":"走遍城市的大街小巷或各个角落。","source":{"text":"那些天，我正好有钱，带着于晶走街串巷吃雨后春笋般在北京开张的各帮菜馆。","book":"王朔《浮出海面》"},"example":{"text":"她～，到处叫卖也没卖出几件。"},"similar":["走南闯北"],"usage":"作谓语、宾语；指走遍细小的角落"},{"id":42267,"word":"走身无路","pinyin":"zǒu shēn wú lù","abbr":"zswl","explanation":"无路可走。比喻身陷绝境","source":{"text":"公子道：‘今走身无路，只得所天命，早晚是死，不得见你了。’","book":"明·凌濛初《二刻拍案惊奇》第22卷"},"similar":["走投无路"],"usage":"作谓语、定语；用于书面语"},{"id":42268,"word":"走过场","pinyin":"zǒu guò chǎng","abbr":"zgc","explanation":"形容办事只在形式上过一下，却不实干。","source":{"text":"把领导干部要带头的问题突出地加以强调，对于防止对照检查走过场，是十分必要的。","book":"《红旗》1984年第7期"},"example":{"text":"我们做事不能～。"},"similar":["敷衍了事"],"opposite":["脚踏实地"],"usage":"作谓语、宾语、定语；指应付"},{"id":42269,"word":"走遍天涯","pinyin":"zǒu biàn tiān yá","abbr":"zbty","explanation":"天涯：天边，指极边远的地方。哪儿都走过了。形容到过的地方很多","source":{"text":"笑我尘踪，走遍天涯。","book":"元·鲜于必仁《折桂令·游玉隆宫》"},"usage":"作谓语、定语；用于书面语"},{"id":42270,"word":"走马上任","pinyin":"zǒu mǎ shàng rèn","abbr":"zmsr","explanation":"走马：骑着马跑；任：职务。旧指官吏到任。现比喻接任某项工作。","source":{"text":"先以陈公走马赴任，乃树一魁妖，共翼佐之。","book":"宋·孙光宪《北梦琐言》卷四"},"example":{"text":"你看他那种～的神气，你就可以知道他是一位全然不懂教育的外行乃至老腐败。","book":"郭沫若《少年时代·反正前后》"},"similar":["下车伊始","加官晋爵","走马之任"],"opposite":["削职为民"],"usage":"作谓语、宾语、定语；用于讽刺"},{"id":42271,"word":"走马之任","pinyin":"zǒu mǎ zhī rèn","abbr":"zmzr","explanation":"骑着马去上任。指官员出任新的职位。","source":{"text":"先以陈公走马赴任，乃树一魁妖，共翼佐之。","book":"宋·孙光宪《北梦琐言》卷四"},"example":{"text":"目今主上图治心切，不尚浮藻，将某左迁江州司马，刻日走马之任。","book":"元·马致远《表青泪》楔子"},"similar":["走马上任","走马赴任","走马到任"],"usage":"作谓语；同“走马上任”"},{"id":42272,"word":"走马到任","pinyin":"zǒu mǎ dào rèn","abbr":"zmdr","explanation":"指新委官员急速到任。后亦泛指接任新职。同“走马上任”。","source":{"text":"今奉上帝之命封为游天使者，走马到任去也。","book":"清·孔尚任《桃花扇·入道》"},"example":{"text":"我觉得空气很好，财政总长的背后有了银行家帮忙，也就不妨～了。","book":"刘复《也算发刊词》"},"similar":["走马上任","走马赴任","走马之任"],"usage":"作谓语、宾语、定语；用于当官"},{"id":42273,"word":"走马灯","pinyin":"zǒu mǎ dēng","abbr":"zmd","explanation":"比喻来往穿梭不停的事物。","source":{"text":"炀帝看了这些佳人的态度，不觉心荡神怡，忍不住立起身来，好像元宵走马灯，团团的在中间转。","book":"清·褚人获《隋唐演义》第30回"},"example":{"text":"清·褚人获《隋唐演义》第30回：“炀帝看了这些佳人的态度，不觉心荡神怡，忍不住立起身来，好像元宵～，团团的在中间转。”"},"usage":"作宾语、定语；多用于比喻句"},{"id":42274,"word":"走马看花","pinyin":"zǒu mǎ kàn huā","abbr":"zmkh","explanation":"走马：骑着马跑。骑在奔跑的马上看花。原形容事情如意，心境愉快。后多指大略地观察一下。","source":{"text":"春风得意马蹄疾，一日看尽长安花。","book":"唐·孟郊《登科后》诗"},"example":{"text":"一个高中文科的学生，与其囫囵吞枣或～地读十部诗集，不如仔仔细细背诵三百首诗。","book":"朱自清《论诗学门径》"},"similar":["走马观花","浮光掠影","蜻蜓点水"],"usage":"作谓语、状语、宾语；指应付","story":["传说一个叫贵良是跛子，想娶一个漂亮的妻子。一个鼻子有缺陷的姑娘叶青，想找一个英俊的丈夫。两人都找到华汉做媒。华汉准备把他们促成一对，在相亲的那天，让贵良骑马，让叶青拿着花到鼻子边上闻，双方都很满意对方"]},{"id":42275,"word":"走马章台","pinyin":"zǒu mǎ zhāng tái","abbr":"zmzt","explanation":"章台：汉长安章台下街名，旧为妓院的代称。原指骑马经过章台。后指涉足妓间。","source":{"text":"然倘无威仪，时罢朝会，过走马章台街，使御吏驱，自以便面拊马。","book":"《汉书·张敞传》"},"example":{"text":"我不曾流水出天台，你怎么走马到章台。","book":"元·马致远《青衫泪》第一折"},"usage":"作谓语；指涉足妓院"},{"id":42276,"word":"走马观花","pinyin":"zǒu mǎ guān huā","abbr":"zmgh","explanation":"走马：骑着马跑。骑在奔跑的马上看花。原形容事情如意，心境愉快。后多指大略地观察一下。","source":{"text":"春风得意马蹄疾，一日看尽长安花。","book":"唐·孟郊《登科后》诗"},"example":{"text":"看这部书也不过～。","book":"清·文康《儿女英雄传》第二十三回"},"similar":["浮光掠影","蜻蜓点水"],"opposite":["下马看花","入木三分","鞭辟入里"],"usage":"作谓语、状语、宾语；指走过场","story":["唐朝诗人孟郊年轻时隐居嵩山，过着清贫闲淡的生活，在母亲的鼓励下，他多次进京赶考没有考中，直到41岁时才考取进士，他写诗“昔日龌龊不足夸，今朝放荡思无涯。春风得意马蹄疾，一日看尽长安花”来抒发自己的喜悦心情"]},{"id":42277,"word":"走马赴任","pinyin":"zǒu mǎ fù rèn","abbr":"zmfr","explanation":"走马：骑着马跑；任：职务。旧指官吏到任。现比喻接任某项工作。","source":{"text":"先以陈公走马赴任，乃树一魁妖，共翼佐之。","book":"宋·孙光宪《北梦琐言》卷四"},"example":{"text":"明·冯梦龙《醒世恒言》第25卷：“仍着～，无得迟误。”"},"similar":["走马上任","走马之任","走马到任"],"usage":"作谓语、宾语、定语；指去当官"},{"id":42278,"word":"走骨行尸","pinyin":"zǒu gǔ xíng shī","abbr":"zgxs","explanation":"走骨：会走动而没有灵魂的骨骼；行尸：可以走动的尸体。比喻不动脑筋，不起作用，糊里糊涂过日子的人。","source":{"text":"夫人好学，虽死若存；不学者，虽存，谓之行尸走肉耳。","book":"晋·王嘉《拾遗记》卷六"},"example":{"text":"改头换面人难悟，～我不忧。","book":"元·丘处机《报师恩五首》其一"},"similar":["行尸走肉","行尸走骨","走肉行尸"],"usage":"作宾语、定语；指没有思想的人"},{"id":42279,"word":"走鸾飞凤","pinyin":"zǒu luán fēi fèng","abbr":"zlff","explanation":"莺：古作传说中的一种神鸟；凤：凤凰，古代传说中的鸟王。疾走着的鸾，飞舞着的凤。形容建筑物雕梁画栋，富丽堂皇","source":{"text":"见楼台三四重，势磋峨走鸾飞凤，晃分明金碧玲珑。","book":"元·王子一《误入桃源》第二折"},"usage":"作宾语、定语；用于比喻句"},{"id":42280,"word":"赳赳武夫","pinyin":"jiū jiū wǔ fū","abbr":"jjwf","explanation":"赳赳：勇武矫健的样子。武夫：武人，从军之人。勇武矫健的军人。后多含贬义，意指虽身强体壮，却头脑简单的军士。","source":{"text":"赳赳武夫，公侯干城。","book":"《诗经·周南·兔罝》"},"example":{"text":"看不出这么一个～，倒是一个旖旎多情的男子。","book":"清·吴趼人《二十年目睹之怪现状》第八十三回"},"similar":["彪形大汉"],"opposite":["文弱书生","文质彬彬"],"usage":"作宾语；指武士"},{"id":42281,"word":"赳赳雄断","pinyin":"jiū jiū xióng duàn","abbr":"jjxd","explanation":"赳赳：勇武矫健的样子。指威武雄壮，善于决断。","source":{"text":"明明庙谟，赳赳雄断。","book":"《后汉书·光武纪赞》"}},{"id":42282,"word":"赴东海而死","pinyin":"fù dōng hǎi ér sǐ","abbr":"fdhes","explanation":"跳进东海淹死。形容人所下的决心极大。","source":{"text":"彼则肆然而为帝，则连有赴东海而死耳，吾不忍为之民也。","book":"《战国策·赵策三》"},"example":{"text":"不然，臣有～，宁能处小朝廷求活耶？","book":"宋·胡铨《戊午上高宗封事》"},"usage":"作谓语；用于人的决心"},{"id":42283,"word":"赴死如归","pinyin":"fù sǐ rú guī","abbr":"fsrg","explanation":"形容不怕牺牲。","source":{"text":"栾布哭彭越，田叔随张敖，赴死如归，彼诚知所处，虽古烈士，何以加哉！","book":"东汉·班固《汉书·季布栾布田叔传赞》"},"example":{"text":"……真可谓～者矣。","book":"明·归有光《王烈妇墓碣》"},"similar":["视死如归"],"usage":"作谓语、定语；用于人不怕死"},{"id":42284,"word":"赴汤投火","pinyin":"fù tāng tóu huǒ","abbr":"ftth","explanation":"赴：去，走向；汤：开水。沸水敢蹚，烈火敢跳。比喻奋不顾身，不避艰险。","source":{"text":"小人受侯爷大恩，别说行刺，就是赴汤投火也是情愿的。","book":"清·石玉昆《三侠五义》第12回"},"example":{"text":"清·无名氏《刘公案》第44回：“小的蒙爷高抬举，～亦甘心。”"},"similar":["赴汤蹈火","赴汤跳火"],"usage":"作谓语、状语；比喻奋不顾身"},{"id":42285,"word":"赴汤跳火","pinyin":"fù tāng tiào huǒ","abbr":"ftth","explanation":"赴：去，走向；汤：开水。沸水敢蹚，烈火敢跳。比喻奋不顾身，不避艰险。","source":{"text":"小夫人说那里话！若肯在老爷前，抬举小人一二，便消受不了。虽赴汤跳火，敢说不去？","book":"明·兰陵笑笑生《金瓶梅词话》第88回"},"similar":["赴汤蹈火","赴汤投火"],"usage":"作谓语、状语；比喻奋不顾身"},{"id":42286,"word":"赴汤蹈火","pinyin":"fù tāng dǎo huǒ","abbr":"ftdh","explanation":"赴：走往；汤：热水；蹈：踩。沸水敢蹚，烈火敢踏。比喻不避艰险，奋勇向前。","source":{"text":"长而见羁，则狂顾顿缨，赴汤蹈火。","book":"《荀子·议兵》：“以桀诈尧，譬之若以卵投石，以指挠沸，若赴水火，入焉焦没耳。”晋·稽康《与山巨源绝交书》"},"example":{"text":"有三个人，义胆包身，武艺出众，敢～，同死同生。","book":"明·施耐庵《水浒全传》第十五回"},"similar":["出生入死"],"opposite":["贪生怕死"],"usage":"作谓语、状语；比喻奋不顾身","story":["汉景帝时，御史大夫晁错看到各地诸侯势力日益膨胀，威胁中央政权，建议汉景帝削减他们的势力，防止他们作乱，因此得罪了诸侯。晁错父亲劝晁错注意明哲保身，晁错说：“只有大家赴汤蹈火，才能保家卫国。”"]},{"id":42287,"word":"赴火蹈刃","pinyin":"fù huǒ dǎo rèn","abbr":"fhdr","explanation":"冲入火海，踏上尖刃。形容奋勇向前，不惜生命。","source":{"text":"墨子服役者百八十人，皆可使赴火蹈刃，死不还踵，化之所教也。","book":"《淮南子·泰族训》"},"example":{"text":"西汉·刘向《说苑·指武》：“军之法令，赏罚之数，使士～，陷阵取将，死不旋踵者。”"},"similar":["赴汤蹈火"],"usage":"作谓语、定语；用于书面语"},{"id":42288,"word":"赴蹈汤火","pinyin":"fù dǎo tāng huǒ","abbr":"fdth","explanation":"赴：前往；蹈：踩；汤：热水。形容不畏艰难险阻，奋不顾身。","source":{"text":"禽鹿少见驯育，则服从教制，长而见羁，则狂顾顿缨，赴蹈汤火。","book":"三国·魏·嵇康《与山巨源绝交书》"},"example":{"text":"臣是顾命大臣，义当以死报国，虽～，皆所不避。","book":"明·张居正《乞鉴别忠邪以定国是疏》"},"similar":["赴汤蹈火"],"usage":"作谓语、定语；指人勇敢"},{"id":42289,"word":"赴险如夷","pinyin":"fù xiǎn rú yí","abbr":"fxry","explanation":"赴：投身进去；险：危险；如：像；夷：平坦。走向危险的道路，看作像平坦的大道。形容不避艰险。","source":{"text":"史臣曰：‘于什门等或临危不挠，视死如归；或赴险如夷，惟义所在。’","book":"《魏书·于什门等传论》"},"similar":["履险如夷"],"usage":"作谓语、宾语；形容不避艰险"},{"id":42290,"word":"赶不上趟","pinyin":"gǎn bù shàng tàng","abbr":"gbst","explanation":"落在后面或错过时机。","source":{"text":"中国的这类政策常常说变就变，往往一夜之间赶不上趟，就把人的命运改变了。","book":"路遥《平凡的世界》第四卷第36章"},"example":{"text":"每次公司的好事，我都～。"},"usage":"作谓语；用于口语"},{"id":42291,"word":"赶尽杀绝","pinyin":"gǎn jìn shā jué","abbr":"gjsj","explanation":"驱除干净，彻底消灭。比喻残忍狠毒，不留余地。","source":{"text":"黄天禄上马，提枪出营，见余化曰：‘匹夫赶尽杀绝，但不知你可有造化受其功禄！’","book":"明·许仲琳《封神演义》第三十三回"},"example":{"text":"杀戮是对待他们的最简截的办法，正如同要消灭蝗灾只有去～了蝗虫。","book":"老舍《四世同堂》三十三"},"similar":["杀人如麻","灭绝人性","斩尽杀绝"],"opposite":["慈悲为怀"],"usage":"作谓语、宾语、状语；指非常残忍"},{"id":42292,"word":"赶时髦","pinyin":"gǎn shí máo","abbr":"gsm","explanation":"采用时兴的方式或时髦的款式，指追上潮流的特性或性格，迎合当时最流行的风尚。","source":{"text":"我想，要说时髦，公安局的便衣最赶时髦。","book":"王朔《玩儿的就是心跳》"},"similar":["赶浪头"],"opposite":["赶不上趟"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42293,"word":"赶浪头","pinyin":"gǎn làng tóu","abbr":"glt","explanation":"指跟在大众后面做一些适应当前形势的事。","example":{"text":"她最喜欢～。"},"similar":["赶时髦"],"usage":"作谓语、宾语；指赶时髦"},{"id":42294,"word":"赶潮流","pinyin":"gǎn cháo liú","abbr":"gcl","explanation":"追上潮流的特性或性格；迎合当时最流行的风尚。","example":{"text":"现代人都喜欢～。"},"similar":["赶时髦"],"opposite":["赶不上趟"],"usage":"作谓语、宾语、定语；用于口语"},{"id":42295,"word":"赶鸭子上架","pinyin":"gǎn yā zī shàng jià","abbr":"gyzsj","explanation":"比喻强迫去做能力达不到的事情。","source":{"text":"说着一把将我拖了起来，要我去看看。这是硬赶鸭子上架，我向她解释，去看也是没用。","book":"茹志鹃《高高的白杨树》"},"example":{"text":"你不要～、强人所难。"},"similar":["打鸭子上架","强人所难"],"usage":"作宾语、分句；比喻强迫去做能力达不到的事"},{"id":42296,"word":"起例发凡","pinyin":"qǐ lì fā fán","abbr":"qlff","explanation":"发凡：提示全书的通例。指说明全书要旨，拟定编写体例。","source":{"text":"其发凡以言例，皆经国之常制。","book":"晋·杜预《春秋左传序》"}},{"id":42297,"word":"起偃为竖","pinyin":"qǐ yǎn wéi shù","abbr":"qyws","explanation":"偃：卧躺。竖：立，站着。使躺着的人站起来。比喻给予减轻刑罚的恩惠。","source":{"text":"繇欲轻减大辟之条，以增益刖刑之数，此即起偃为竖，化尸为人矣。","book":"《三国志·魏志·钟繇传》"},"similar":["起死回生"],"usage":"作谓语、定语；指医术高明"},{"id":42298,"word":"起兵动众","pinyin":"qǐ bīng dòng zhòng","abbr":"qbdz","explanation":"众：大队人马。旧指大规模出兵。现多指动用很多人力做某件事。","source":{"text":"不可以兴土功，不可以会诸侯，不可以起兵动众，举大事，必有大殃。","book":"晋·陈寿《三国志·吴志·华敷传》"},"similar":["兴师动众","起师动众","起师动众"],"opposite":["小打小闹","单枪匹马"],"usage":"作谓语、宾语、状语；指大规模行动"},{"id":42299,"word":"起凤腾蛟","pinyin":"qǐ fèng téng jiāo","abbr":"qftj","explanation":"宛如蛟龙腾跃、凤凰起舞。形容人很有文采。","source":{"text":"腾蛟起凤，孟学士之词宗。","book":"唐·王勃《滕王阁序》"},"example":{"text":"但说维新气象，已经～。","book":"清·遁庐《童子军·插旗》"},"similar":["腾蛟起凤"],"usage":"作宾语、定语；指景象壮观"},{"id":42300,"word":"起居万福","pinyin":"qǐ jū wàn fú","abbr":"qjwf","explanation":"问安祝福的意思。晚辈致书尊长时多用此语。","source":{"text":"首冬初寒，伏惟相公尊体起居万福。","book":"唐·李白《为赵宣城与杨右相书》"},"example":{"text":"某惶恐再拜上启小娘子妆前：即日孟春初时，恭惟懿处～。","book":"明·冯梦龙《喻世明言》卷三十五"}},{"id":42301,"word":"起居无时","pinyin":"qǐ jū wú shí","abbr":"qjws","explanation":"起居：作息，日常生活。形容日常生活没有规律。","source":{"text":"起居无时，惟适之安。","book":"唐·韩愈《送李愿归盘谷序》"},"example":{"text":"～对身体健康不利。"},"similar":["废寝忘食"],"usage":"作谓语、定语；指生活没有规律"},{"id":42302,"word":"起师动众","pinyin":"qǐ shī dòng zhòng","abbr":"qsdz","explanation":"众：大队人马。旧指大规模出兵。现多指动用很多人力做某件事。","source":{"text":"夫起师动众，必参之天人，苟非其时，圣贤所不为。","book":"《晋书·吕纂传》"},"similar":["起兵动众","行师动众","兴师动众"],"opposite":["小打小闹","单枪匹马"],"usage":"作谓语、宾语、状语；指大规模行动"},{"id":42303,"word":"起承转合","pinyin":"qǐ chéng zhuǎn hé","abbr":"qczh","explanation":"起：开头；承：承接上文加以申述；转：转折；合：结束。泛指文章的做法。也比喻固定呆板的形式。","source":{"text":"有此许多起承转合，便令题目透出文字。","book":"清·金圣叹《西厢记读法》"},"example":{"text":"然而不得已，也只好～，上台去说几句。","book":"鲁迅《而已集·通信》"},"similar":["承上启下"],"usage":"作谓语、宾语；泛指文章的做法"},{"id":42304,"word":"起早挂晚","pinyin":"qǐ zǎo guà wǎn","abbr":"qzgw","explanation":"起得早，睡得晚。形容人很勤劳。","source":{"text":"逃荒到这村来，又从头干起，吃糠咽菜，起早挂晚，租人家地种，养羊、打鱼、搓麻绳，只要是赚钱的道儿，就得走一走。","book":"秦兆阳《刘老济》"},"example":{"text":"她～为的是想让儿子有钱上大学。"},"similar":["起早睡晚","起早贪黑"],"usage":"作谓语、宾语；指日常生活起居"},{"id":42305,"word":"起早摸黑","pinyin":"qǐ zǎo mō hēi","abbr":"qzmh","explanation":"起早睡晚，指辛勤劳动。","source":{"text":"天还没有亮，起早摸黑赶着上前方。","book":"《送军粮》"},"example":{"text":"她～静悄悄地干活。"},"similar":["起早贪黑"],"usage":"作谓语、定语、状语；指辛勤劳动"},{"id":42306,"word":"起早睡晚","pinyin":"qǐ zǎo shuì wǎn","abbr":"qzsw","explanation":"起得早，睡得晚。早晨起床，晚上睡觉，指日常生活起居。","source":{"text":"以至起早睡晚，无不调停的周到。","book":"清·文康《儿女英雄传》第四回"},"example":{"text":"我一心秉正，～，劳心淘神，都是为了你们。","book":"老舍《四世同堂》"},"similar":["起早贪黑"],"usage":"作谓语、宾语；指日常生活起居"},{"id":42307,"word":"起早贪黑","pinyin":"qǐ zǎo tān hēi","abbr":"qzth","explanation":"起得早，睡得晚。形容辛勤劳动。","source":{"text":"咱们命苦的人，起早贪黑，翻土拉块，吃柳树叶子。","book":"周立波《暴风骤雨》第一部"},"example":{"text":"他为了早日完成他的软件编制工作～，不辞辛劳。"},"similar":["夙兴夜寐","起早摸黑"],"opposite":["无所事事","饱食终日"],"usage":"作谓语、宾语；指辛勤劳动"},{"id":42308,"word":"起根发由","pinyin":"qǐ gēn fā yóu","abbr":"qgfy","explanation":"比喻指出事物的根源。","source":{"text":"这件异事，却是妹子因到海外寻亲，亲自所睹的。今日既要细谈，必须起根发由说起，诸位姐姐才明白。","book":"清·李汝珍《镜花缘》第六十九回"}},{"id":42309,"word":"起模画样","pinyin":"qǐ mó huà yàng","abbr":"qmhy","explanation":"形容装模作样。","source":{"text":"问：‘德山入门便棒，犹是起模画样。临济入门便喝，未免捏目生花。离此二途，未审洞山如何为人？’师曰：‘天晴久无雨，近日有云腾。’","book":"宋·释普济《五灯会元》卷十五"}},{"id":42310,"word":"起死人而肉白骨","pinyin":"qǐ sǐ rén ér ròu bái gǔ","abbr":"qsrerbg","explanation":"把死人救活，使白骨再长出肉来。比喻给人以再造之恩。也比喻言词委婉动听，将死的也说活了。","source":{"text":"君王之于越也，繄起死人而肉白骨也。","book":"《国语·吴语》"},"example":{"text":"真正的好比作‘吹泥絮上青云，～。’","book":"清·文康《儿女英雄传》第19回"},"similar":["起死回生"],"usage":"作分句、定语；比喻给人极大的恩德"},{"id":42311,"word":"起死人肉白骨","pinyin":"qǐ sǐ rén ròu bái gǔ","abbr":"qsrrbg","explanation":"把死人救活，使白骨再长出肉来。比喻给人极大的恩德。","source":{"text":"君王之于越也，医起死人而肉白骨也。","book":"《国语·吴语》"},"example":{"text":"先生之来，实出天赐。如起死人而肉白骨，孤敢不奉教！","book":"明·冯梦龙《东周列国志》第八十一回"}},{"id":42312,"word":"起死人，肉白骨","pinyin":"qǐ sǐ rén，ròu bái gǔ","abbr":"qsrrbg","explanation":"把死人救活，使白骨再长出肉来。比喻给人极大的恩德。","source":{"text":"君王之于越也，医起死人而肉白骨也。","book":"《国语·吴语》"},"example":{"text":"先生之来，实出天赐。如起死人而肉白骨，孤敢不奉教！","book":"明·冯梦龙《东周列国志》第八十一回"}},{"id":42313,"word":"起死回生","pinyin":"qǐ sǐ huí shēng","abbr":"qshs","explanation":"把快要死的人救活。形容医术高明。也比喻把已经没有希望的事物挽救过来。","source":{"text":"医不经师，方不袭古，每以劫剂肊见起死回生。","book":"明·张岱《鲁云谷传》"},"example":{"text":"对于时人那虚弱的感情，这真有～的力量。","book":"闻一多《宫体诗的自赎》"},"similar":["妙手回春","死而复生","起死回骸"],"opposite":["不可救药","病入膏肓"],"usage":"作谓语、定语；指医术高明","story":["春秋时期，齐国神医扁鹊经过虢国听说虢太子猝死，就问术士中庶子太子的症状，认为虢太子只是假死可以救活。经虢君同意后，叫弟子子阳磨好针，在太子的穴位上扎了几针，不一会太子就苏醒过来，再经汤药调解，20天后就完全康复"]},{"id":42314,"word":"起死回骸","pinyin":"qǐ sǐ huí hái","abbr":"qshh","explanation":"使死人或死东西复活。形容医术高明。比喻挽救了看来没有希望的事情。","source":{"text":"窃闻大神，天医之王。范围堪舆，运平阴阳；起死回骸，斡旋天藏。","book":"宋·范成大《问天医赋》"},"similar":["起死回生"],"usage":"作谓语、定语；指医术高明"},{"id":42315,"word":"趁人之危","pinyin":"chèn rén zhī wēi","abbr":"crzw","explanation":"利用别人有困难时加以要挟或陷害。","source":{"text":"金城扭头瞪他一眼：‘去你妈的！君子不趁人之危。’","book":"蒋子龙《开拓者，开拓者》"},"example":{"text":"我不能～逼她嫁给我。"},"similar":["趁火打劫"],"usage":"作谓语、宾语、定语；同乘人之危","story":["东汉凉州刺史梁鸿的属官苏正和不畏强权，依法查办武威太守。梁鸿担心会牵连朝廷高官，想杀了苏正和灭口，就找好友盖勋商量对策。虽然盖勋和苏正和是死对头，但他还是认为不能趁别人危难时候去害别人，这是不仁的表现"]},{"id":42316,"word":"趁势收篷","pinyin":"chèn shì shōu péng","abbr":"cssp","explanation":"篷：船帆。比喻乘机歇手，见好就收。","source":{"text":"马老爷见瞿太太一面已经软了下来，不至生变，便也趁势收篷。","book":"清·李宝嘉《官场现形记》第40回"},"similar":["趁势落篷","见好就收"],"usage":"作谓语、宾语；指见好就收"},{"id":42317,"word":"趁势落篷","pinyin":"chèn shì luò péng","abbr":"cslp","explanation":"比喻乘机歇手。","source":{"text":"如今果然半途解缆，这明明是预定的布置，她也落得趁势落篷，省了许多周折。","book":"曾朴《孽海花》第31回"},"example":{"text":"这不叫半途而废，而叫～。"},"similar":["见好就收","趁势收篷"],"usage":"作谓语、宾语；指见好就收"},{"id":42318,"word":"趁哄打劫","pinyin":"chèn hōng dǎ jié","abbr":"chdj","explanation":"犹言在混乱中劫掠。","source":{"text":"他也不救火，他也不叫水，拿着那袈裟，趁哄打劫，拽回云步，径转山洞而去。","book":"明·吴承恩《西游记》第十六回"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第12卷：“今因见有客，～的逃去了。”"},"similar":["趁火打劫"],"usage":"作谓语、定语；同乘人之危"},{"id":42319,"word":"趁夥打劫","pinyin":"chèn huǒ dǎ jié","abbr":"chdj","explanation":"趁火打劫。","source":{"text":"我晓得，都是那褚敬桥寄个甚么鸟信！是他趁夥打劫，用计拐去了。","book":"明·凌濛初《初刻拍案惊奇》第八卷"},"similar":["趁火打劫"],"usage":"作谓语、定语；同乘人之危"},{"id":42320,"word":"趁心像意","pinyin":"chèn xīn xiàng yì","abbr":"cxxy","explanation":"犹言称心如意。指完全合乎心意。趁：满足，遂。趁，通“称”。","source":{"text":"若论起吴衙内，只算做半饥半饱，未能趁心像意。","book":"明·冯梦龙《醒世恒言》第二十八卷"}},{"id":42321,"word":"趁心如意","pinyin":"chèn xīn rú yì","abbr":"cxry","explanation":"称心如意。指符合心意，满足愿望。趁，通“称”。","source":{"text":"俗语说，‘老健春寒秋后热’，倘或老太太一时有个好歹，那时虽也完事，只怕耽误了时光，还不得趁心如意呢。","book":"清·曹雪芹《红楼梦》第五十七回"},"similar":["称心如意"],"opposite":["大失所望"],"usage":"作谓语、宾语、定语；指合符心意"},{"id":42322,"word":"趁水和泥","pinyin":"chèn shuǐ huò ní","abbr":"cshn","explanation":"利用现成的水来搅泥。比喻乘机行事。","source":{"text":"这母货不早不晚，来的恰好。趁水和泥，趁热打铁，捎带着把她收拾啦吧。","book":"姚雪垠《李自成》第三卷第11章"},"example":{"text":"我们～，联系实际，现场教育。"},"similar":["趁热打铁"],"usage":"作谓语、定语、宾语；指乘机行事"},{"id":42323,"word":"趁波逐浪","pinyin":"chèn bō zhú làng","abbr":"cbzl","explanation":"犹随波逐流。形容奔波；颠沛。","source":{"text":"谁想并头莲情断藕丝长，搬调的俺趁波逐浪，正是相逢没话说，不见却思量。","book":"元·尚仲贤《柳毅传书》第四折"},"example":{"text":"师父也我再不想～利名牵。","book":"明·无名氏《锁白猿》第四折"},"similar":["趁浪逐波","随波逐流"],"opposite":["坚定不移"],"usage":"作谓语、定语；指人没主见"},{"id":42324,"word":"趁浪逐波","pinyin":"chèn làng zhú bō","abbr":"clzb","explanation":"趁着波浪漂流。比喻没有一定的主意，随大流。","source":{"text":"不是我自间阔，趁浪逐波，落落托托。","book":"元·关汉卿《鲁斋郎》第四折"},"example":{"text":"你伴着狂朋怪友同相聚，～情意舒，凶暴营生不可趋，薄幸情怀不似初。","book":"明·无名氏《孟母三移》第二折"},"similar":["随波逐流"],"usage":"作谓语、定语；指人没主见"},{"id":42325,"word":"趁火打劫","pinyin":"chèn huǒ dǎ jié","abbr":"chdj","explanation":"趁：乘机。趁人家失火时去抢劫。比喻乘人之危谋取私利。","source":{"text":"正是财动人心，他也不救火，他也不叫水，拿着那袈裟，趁哄打劫，拽回云步，经转山洞而去。","book":"明·吴承恩《西游记》第十六回"},"example":{"text":"等警察赶到时，那几个～的流氓早已逃走了。"},"similar":["浑水摸鱼","顺手牵羊","打家劫舍"],"opposite":["抚危济贫","除暴安良"],"usage":"作谓语、定语；同乘人之危"},{"id":42326,"word":"趁火抢劫","pinyin":"chèn huǒ qiǎng jié","abbr":"chqj","explanation":"趁着别人紧张时去捞取私利或害人。","source":{"text":"兵队来了，有钱的请外人的红十字会来贴张保护的封条，没有钱的便趁火抢劫。","book":"郭沫若《尚儒村》"},"example":{"text":"你不能～，这是违法犯罪的事情。"},"similar":["趁火打劫"],"opposite":["除暴安良"],"usage":"作谓语、宾语；指乘人之危干坏事"},{"id":42327,"word":"趁热打铁","pinyin":"chèn rè dǎ tiě","abbr":"crdt","explanation":"铁要趁烧红的时候打。比喻要抓紧有利的时机和条件去做。","source":{"text":"是的，我们要趁热打铁，一举攻破南阳。","book":"姚雪垠《李自成》第34章"},"example":{"text":"要干就～，明天就开大会。","book":"陆地《美丽的南方》二八"},"similar":["事不宜迟","时不可失","不可或缓"],"opposite":["坐失良机","拖泥带水"],"usage":"作谓语、宾语、状语；比喻做事要抓住时机"},{"id":42328,"word":"趁虚而入","pinyin":"chèn xū ér rù","abbr":"cxer","explanation":"趁：乘着；虚：空虚。趁力量虚弱时侵入。","source":{"text":"将至所居，自后垣乘虚而入，径及庭中。","book":"《去笈七签》卷一二０"},"example":{"text":"如今百病～。","book":"清·石玉昆《三侠五义》第四十回"},"similar":["乘虚而入"],"usage":"作谓语、宾语；指找对时机"},{"id":42329,"word":"趁风使柁","pinyin":"chèn fēng shǐ duò","abbr":"cfsd","explanation":"犹看风使舵。比喻随机应变或迎合别人行事。","source":{"text":"那没廉耻的，假哭佯啼；你呵卵脬的，不要趁风使柁。","book":"明·冯梦龙《万事足·筵中治妒》"},"similar":["见风使舵"],"usage":"作谓语、宾语、定语、状语；指见机行事"},{"id":42330,"word":"趁风转帆","pinyin":"chèn fēng zhuǎn fān","abbr":"cfzf","explanation":"趁：乘便；帆：船桅上的布篷。比喻根据情势的变化行事。","source":{"text":"嗟尔欲上无由，亦惟有趁风转帆，临崖勒马而已。","book":"柴萼《梵天庐丛录·妙判》"},"similar":["趁风转篷"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42331,"word":"趁风转篷","pinyin":"chèn fēng zhuǎn péng","abbr":"cfzp","explanation":"趁：乘便；篷：船帆。比喻根据情势的变化行事。","source":{"text":"丘德奎眼看势头不对，立刻趁风转篷。","book":"艾明之《火种》第12章"},"similar":["趁风转帆"],"usage":"作谓语、宾语、定语；用于处事"},{"id":42332,"word":"超世之功","pinyin":"chāo shì zhī gōng","abbr":"cszg","explanation":"超越世间的功勋。指功勋卓著。","source":{"text":"显忠贞之节，立超世之功。","book":"《后汉书·冯衍传》"}},{"id":42333,"word":"超世之才","pinyin":"chāo shì zhī cái","abbr":"cszc","explanation":"有超越世人的才能。","source":{"text":"古之大事者，不唯有超世之才，亦必有坚忍不拔之志。","book":"宋·苏拭《晁错论》"},"opposite":["女流之辈"],"usage":"作宾语；指有真本事"},{"id":42334,"word":"超世拔俗","pinyin":"chāo shì bá sú","abbr":"csbs","explanation":"超出当代，不同凡俗。形容人的思想、品德、言行等境界极高，当世罕见。","source":{"text":"盖登太山而小天下，观于海者难为水也。企而慕者，高而远虽其不逮，犹足以超世拔俗矣。","book":"宋·黄庭坚《与王周彦书》"},"example":{"text":"自从这亭子造了，游人都要到亭子上息足片时，说些～的话。","book":"清·古吴墨浪子《西湖佳话·灵隐诗迹》"},"similar":["超尘拔俗"],"usage":"作谓语、宾语、定语；用于人或事物"},{"id":42335,"word":"超世绝伦","pinyin":"chāo shì jué lún","abbr":"csjl","explanation":"超出世人和同辈。","source":{"text":"群僚贺之，皆举手曰，颍川陈君，超世绝伦。","book":"汉·蔡邕《陈寔碑》"},"example":{"text":"自非坚刚不拔之志，～之人，其遇忧患，遭废绌而不变易者，鲜关哉！","book":"元·刘祁《归潜志》第12卷"},"similar":["超群拔类","轶群绝类"],"opposite":["平平庸庸"],"usage":"作谓语、定语；指人出众"},{"id":42336,"word":"超世绝俗","pinyin":"chāo shì jué sú","abbr":"csjs","explanation":"超出当代，冠绝尘俗。","source":{"text":"及乘兴一寓于挥洒，自然有超世绝俗之态矣。","book":"宋·赵佶《宣和书谱·送先辈诗》"},"example":{"text":"其所得如此，想当时必有～之论，惜不传也。","book":"元·刘壎《南轩契合》"},"similar":["超俗绝世"],"usage":"作谓语、宾语、定语；用于人或事物"},{"id":42337,"word":"超乎寻常","pinyin":"chāo hū xún cháng","abbr":"chxc","explanation":"在合理或可以接受的限度以外，极不公平、极粗鲁或极不正义。","example":{"text":"这件事情的影响～。"},"similar":["非同一般"],"opposite":["平平常常"],"usage":"作谓语、定语；指超出以前的"},{"id":42338,"word":"超今冠古","pinyin":"chāo jīn guàn gǔ","abbr":"cjgg","explanation":"冠：超出众人。超越古今。","source":{"text":"众美备具，名实相当，赫赫巍巍，超今冠古。","book":"唐·韩愈《贺册尊号表》"},"example":{"text":"夫子美诗～，一人而已。","book":"宋·张戒《岁寒堂诗话》下卷"},"similar":["超今越古","空前绝后"],"opposite":["比比皆是","司空见惯"],"usage":"作谓语、定语；用于夸奖人"},{"id":42339,"word":"超今绝古","pinyin":"chāo jīn jué gǔ","abbr":"cjjg","explanation":"指超越古今。形容古今少有。","source":{"text":"众美备具，名实相当，赫赫巍巍，超今冠古。","book":"唐·韩愈《贺册尊号表》"},"example":{"text":"细读佳刻，字字句句皆从神识中模写，雄健博达，真足以～。","book":"明·李贽《焚书·与管登之书》"},"similar":["超今冠古","超今越古","空前绝后"],"opposite":["司空见惯"],"usage":"作谓语、定语；用于夸奖人"},{"id":42340,"word":"超今越古","pinyin":"chāo jīn yuè gǔ","abbr":"cjyg","explanation":"指超越古今。","source":{"text":"凭着我壮志能，胆气粗，博一个黄阁标名，超今越古。","book":"明·无名氏《桃园结义》二折"},"similar":["超今绝古","超今冠古"],"opposite":["比比皆是"],"usage":"作谓语、宾语；用于夸奖人"},{"id":42341,"word":"超以象外","pinyin":"chāo yǐ xiàng wài","abbr":"cyxw","explanation":"以：用法等同“于”。超脱于物象之外。形容诗文意境雄浑、超脱。也比喻置身世外，脱离现实的空想。","source":{"text":"超以象外，得其环中。","book":"唐·司空图《诗品·雄浑》"},"example":{"text":"人倘能够“超然象外”，看看报章，倒也是一种清福。","book":"鲁迅《华盖集续编·马上支日记》"},"similar":["超然象外"],"usage":"作谓语、定语；形容诗文意境雄浑"},{"id":42342,"word":"超伦轶群","pinyin":"chāo lún yì qún","abbr":"clyq","explanation":"伦：同类；轶：超过。形容超群出众。","source":{"text":"于谋成事遂，睡足饭饱之余，三月炼字，半年锻句，将来会做出超伦轶群的古奥漂亮作品。","book":"鲁迅《华盖集·并非闲话》"},"similar":["超群出众","出类拔萃"],"opposite":["平平庸庸"],"usage":"作谓语、定语；用于人或事物"},{"id":42343,"word":"超俗绝世","pinyin":"chāo sú jué shì","abbr":"csjs","explanation":"指超出世俗，无人可比。","source":{"text":"夫杜崔张之，皆有超俗绝世之才，博学余暇游手于斯。","book":"汉·赵壹《非草书》"},"similar":["超世绝俗"],"usage":"作谓语、宾语、定语；用于人或事物"},{"id":42344,"word":"超凡入圣","pinyin":"chāo fán rù shèng","abbr":"cfrs","explanation":"凡：指凡人，普通人。超越平常人而达到圣贤的境界。形容学识修养达到了高峰。","source":{"text":"举世若能知所寓，超凡入胜弗为难。","book":"唐·吕岩《七言之二》"},"example":{"text":"今日弟幸会芝范，想领教一番～的道理，从此可以洗尽俗肠，重开眼界。","book":"清·曹雪芹《红楼梦》第一一五回"},"similar":["超群绝伦","出类拔萃"],"opposite":["无名小卒","芸芸众生"],"usage":"作谓语、宾语；用于否定句"},{"id":42345,"word":"超凡出世","pinyin":"chāo fán chū shì","abbr":"cfcs","explanation":"超越凡俗，离开尘世。","source":{"text":"厮是非，讲闲气。岂悟修行，超凡出世。","book":"元·马钰《清心镜·叹世》"},"example":{"text":"若论着这九老星修真道德，更和他这福禄寿～，请着这八洞仙传宣奉敕。","book":"明·无名氏《长生会》第一折"},"similar":["超尘出俗"],"usage":"作谓语、定语；指不同一般"},{"id":42346,"word":"超凡脱俗","pinyin":"chāo fán tuō sú","abbr":"cfts","explanation":"指摆脱世俗的高雅境界。","source":{"text":"很自然的在疏书　朗朗的八行笺中表现出来，给人一种超凡脱俗的美的享受。","book":"郑逸梅《我与文史掌故·集札》"},"example":{"text":"王朔《给我顶住》：“是你把她抬到了～的境界与尘世欢乐绝了缘。”"},"similar":["超尘脱俗"],"opposite":["俗不可耐","平淡无奇"],"usage":"作谓语、定语、状语；用于处事"},{"id":42347,"word":"超前绝后","pinyin":"chāo qián jué hòu","abbr":"cqjh","explanation":"指超越前人，以后也无一可相比。","source":{"text":"元功盛德，超前绝后。","book":"南朝·梁·沈约《齐故安陆昭王碑文》“绝后光前”李善注引《晋起居注·安帝诏》曰"},"example":{"text":"飞娘咋舌惊叹道：‘天下有这等奇烈女子，守节不变，犹人所能，至宁死而不显，婆婆之失，则真可～矣。’","book":"《野叟曝言》六九回"},"similar":["空前绝后","超前轶后"],"opposite":["比比皆是","司空见惯"],"usage":"作谓语、定语；指无与伦比"},{"id":42348,"word":"超前轶后","pinyin":"chāo qián yì hòu","abbr":"cqyh","explanation":"轶：超出。超过前辈，冠绝后世。形容独一无二，无与伦比。","source":{"text":"仰见天朝制度维新，超前轶后，洵为万万年不易良规。","book":"《太平天国·钦定士阶条例》"},"example":{"text":"神州五号飞船上天是中国～的壮举。"},"similar":["超前绝后","空前绝后"],"opposite":["司空见惯"],"usage":"作谓语、定语；指无与伦比"},{"id":42349,"word":"超古冠今","pinyin":"chāo gǔ guàn jīn","abbr":"cggj","explanation":"超：超出；冠：位居第一。古今第一，无人能比。","source":{"text":"弈棋之妙，超古冠今。","book":"《宋书·羊玄保传》"},"similar":["超今冠古","越古超今"],"usage":"作谓语；用于夸奖人"},{"id":42350,"word":"超尘出俗","pinyin":"chāo chén chū sú","abbr":"cccs","explanation":"尘、俗：指尘世、人间；出：超出。原指佛教徒功夫深，已超出尘世。后多形容才德远远超过平常人。","source":{"text":"徐穉，字儒子，豫章南昌人，清妙高跱，超世绝俗。","book":"南朝·宋·刘义庆《世说新语·德行》刘孝标注引谢承《后汉书》"},"example":{"text":"孟明登太华山，至明星岩下，果见一人羽冠鹤氅，玉貌丹唇，飘飘然有～之姿。","book":"明·冯梦龙《东周列国志》第四十七回"},"similar":["超尘拔俗"],"opposite":["芸芸众生"],"usage":"作谓语、宾语、定语；指不同凡响"},{"id":42351,"word":"超尘拔俗","pinyin":"chāo chén bá sú","abbr":"ccbs","explanation":"尘、俗：指尘世、人间；拔：超出。原指佛教徒功夫深，已超出尘世。后多形容才德远远超过平常人。","source":{"text":"徐穉，字儒子，豫章南昌人，清妙高跱，超世绝俗。","book":"南朝·宋·刘义庆《世说新语·德行》刘孝标注引谢承《后汉书》"},"example":{"text":"在明天的《新川南日刊》发表出来，让全个卢州城开开眼界，知道新人物的行径是怎样的～能够异想天开尊重女性的。","book":"茅盾《虹》"},"similar":["超凡入圣","出类拔萃"],"opposite":["芸芸众生","无名小卒"],"usage":"作谓语、宾语、定语；用于否定句"},{"id":42352,"word":"超尘逐电","pinyin":"chāo chén zhú diàn","abbr":"cczd","explanation":"超：跃登；逐：追逐。腾空而行，追逐电光。形容奔驰的速度很快。","source":{"text":"长安少年多驰骤车马以为兵，超尘逐电，劳瘁不辞。","book":"清·富察敦崇《燕京岁时记·大钟寺》"},"similar":["风驰电掣"],"usage":"作谓语、定语、状语；指速度快"},{"id":42353,"word":"超度众生","pinyin":"chāo dù zhòng shēng","abbr":"cdzs","explanation":"佛教用语。用念经来使死人脱离苦海。也泛指做善事。","source":{"text":"昨晚道场圆满，正要回来，女众们都劝我道：‘千难万难出来一次，夜间钟法上放焰口超度众生，极有功德，怎的不看看去？’因此在寺里念了这一夜佛。却有甚事谈论？","book":"明·方汝浩《禅真逸史》第七回"},"example":{"text":"他想成佛好～。"},"similar":["普度众生"],"usage":"作谓语、宾语；指为民做好事"},{"id":42354,"word":"超然不群","pinyin":"chāo rán bù qún","abbr":"crbq","explanation":"超脱于世俗之外。不与众人合群。","source":{"text":"[吴文溥]其为人有韬略，超然不群，能作苏门长啸。","book":"《清史稿·吴文溥传》"},"similar":["超群出众"],"usage":"作谓语、定语；指与众不同"},{"id":42355,"word":"超然物外","pinyin":"chāo rán wù wài","abbr":"crww","explanation":"超：高超脱俗；物外：世外。超出世俗生活之外。引申为置身事外。","source":{"text":"予弟子由适在济南，闻而赋之，且名其台曰‘超然’。以见予之无所往而不乐者，盖游于物之外也。","book":"宋·苏轼《超然台记》"},"example":{"text":"这一种仪式既经举行，即倘有后患，各部都该负责，不能～，说风凉话了。","book":"鲁迅《而已集·谈所谓大内档案》"},"similar":["超然象外","置身事外","超然事外"],"opposite":["投身其中","厕身其间"],"usage":"作谓语、定语；形容置身事外"},{"id":42356,"word":"超然独处","pinyin":"chāo rán dú chǔ","abbr":"crdc","explanation":"指超出世事离群独居。","source":{"text":"宋玉曰：‘夫圣人瑰意琦行，超然独处，世俗之民又安知臣之所为哉!’","book":"《文选·宋玉＜对楚王问＞》"},"similar":["超然独立","超群出众","出类拔萃"],"usage":"作谓语、定语；指人杰出"},{"id":42357,"word":"超然独立","pinyin":"chāo rán dú lì","abbr":"crdl","explanation":"指超出世事离群独居。","source":{"text":"君子……超然独立，卓然离世。","book":"《淮南子·修务训》"},"similar":["超然独处","超然不群"],"usage":"作谓语、定语；指人杰出"},{"id":42358,"word":"超然绝俗","pinyin":"chāo rán jué sú","abbr":"crjs","explanation":"高超得完全不同凡俗。指远过于寻常之辈。","source":{"text":"方之古贤，实有伦序，采之于今，超然绝俗，诚社稷之蓍龟，大汉之栋甍。","book":"汉·班固《为第五伦荐谢夷吾疏》"},"example":{"text":"《茧庵记》及《初营》、《落成》二诗，大老手笔，～。","book":"宋·陆游《与姜特立书》：“"},"usage":"作谓语、定语；用于人或事物等"},{"id":42359,"word":"超然自引","pinyin":"chāo rán zì yǐn","abbr":"crzy","explanation":"指超脱世事，自动引退。","source":{"text":"借使伊人，颇览天道。知尽不可益，盈难久持。超然自引，高揖而退。","book":"晋·陆机《豪士赋序》"},"similar":["超然远引"],"usage":"作谓语、定语；用于处世"},{"id":42360,"word":"超然自得","pinyin":"chāo rán zì dé","abbr":"crzd","explanation":"超脱世事，自觉快乐和满足。","source":{"text":"光自幼志气不群，博涉诗书，尤精玄理，而不事家产，好游山水，后览佛书，超然自得。","book":"宋·释普济《五灯会元·东土祖师》"},"example":{"text":"他的小日子过得～。"},"similar":["逸然自得","超然自逸"],"usage":"作谓语、定语、状语；指人洒脱"},{"id":42361,"word":"超然自逸","pinyin":"chāo rán zì yì","abbr":"crzy","explanation":"超脱世事，安闲快乐。","source":{"text":"故为荐书恳恻，冀可改悔，而足下超然自逸，矜其威诈，谓天罔可吞，豪雄可灭。","book":"汉·袁绍《与公孙瓒书》"},"similar":["超然自得"],"usage":"作谓语、定语、状语；指人安闲快乐"},{"id":42362,"word":"超然象外","pinyin":"chāo rán xiàng wài","abbr":"crxw","explanation":"以：用法等同“于”。超脱于物象以外。指诗文的意境雄浑、超脱。也比喻置身世外，脱离现实的空想。","source":{"text":"超以象外，得其环中。","book":"唐·司空图《诗品·雄浑》"},"example":{"text":"人倘能够“～”，看看报章，倒也是一种清福。","book":"鲁迅《华盖集续编·马上支日记》"},"similar":["超然物外","超然事外"],"opposite":["厕身其间"],"usage":"作谓语、定语、宾语；形容置身事外"},{"id":42363,"word":"超然迈伦","pinyin":"chāo rán mài lún","abbr":"crml","explanation":"伦：同辈。超越同辈，无人可比。","source":{"text":"东坡《海南诗》、荆公《钟山诗》，超然迈伦，能追逐李杜陶谢。","book":"宋·许顗《彦周诗话》"},"similar":["超迈绝伦"],"usage":"作谓语、定语；用于夸奖人"},{"id":42364,"word":"超然远举","pinyin":"chāo rán yuǎn jǔ","abbr":"cryj","explanation":"为超脱世事，远由而去。","source":{"text":"偷俗如此，安可久居其间，遂超然远举，羁泊于江湖之上，不惟衣食之累，实亦少避其机阱也。","book":"宋·苏舜钦《答韩持国书》"},"similar":["超然远引"],"usage":"作谓语、定语；用于处世"},{"id":42365,"word":"超然远引","pinyin":"chāo rán yuǎn yǐn","abbr":"cryy","explanation":"为了超脱世事而远离而去。","source":{"text":"偷俗如此，安可久居其间，遂超然远举，羁泊于江湖之上，不惟衣食之累，实亦少避其机阱也。","book":"宋·苏舜钦《答韩持国书》"},"example":{"text":"于是毅然～，而子胥乃恋恋不去，终以谏死于吴。","book":"清·姚鼐《伍子胥论》"},"similar":["超然远举"],"usage":"作谓语、定语；用于处世"},{"id":42366,"word":"超然避世","pinyin":"chāo rán bì shì","abbr":"crbs","explanation":"超越人世，隐避人间。","source":{"text":"范蠡知之，趋避世，长为陶朱。","book":"《战国策·秦策》"}},{"id":42367,"word":"超神入化","pinyin":"chāo shén rù huà","abbr":"csrh","explanation":"神：神妙；化：化境，极高的境界。形容文艺、技艺达到极高的境界。","source":{"text":"观者苟非穷精阐微，超神入化，玲珑透彻之悟，则莫能得其门。","book":"明·高棅《唐诗品汇》总序"},"similar":["出神入化"],"usage":"作谓语、定语、状语；形容文艺或技艺高超"},{"id":42368,"word":"超类绝伦","pinyin":"chāo lèi jué lún","abbr":"cljl","explanation":"指超出寻常，无与伦比。","source":{"text":"故使克明即不中举……亦当为天地间有数奇品，超类绝伦，而可以公眼前蹊径限之欤？","book":"明·李贽《答耿司寇书》"},"similar":["超群绝伦","出类拔萃"],"opposite":["平平庸庸"],"usage":"作谓语、定语；形容很不平凡"},{"id":42369,"word":"超绝尘寰","pinyin":"chāo jué chén huán","abbr":"cjch","explanation":"超：高超；绝：无比；尘寰：红尘寰宇，指人世之间。指在人世间高超无缘。形容某种造诣的高妙。"},{"id":42370,"word":"超绝非凡","pinyin":"chāo jué fēi fán","abbr":"cjff","explanation":"智力或精神道德状况或力量超群或超过常人。","example":{"text":"她的口才～，没有人能辩过她。"},"similar":["超群拔类"],"usage":"作谓语、定语；指超过一般人"},{"id":42371,"word":"超群出众","pinyin":"chāo qún chū zhòng","abbr":"cqcz","explanation":"指超出众人。","source":{"text":"超群出众太虚玄。","book":"宋·释道原《景德传灯录》卷二十七"},"example":{"text":"你道生得如何？……即非倾国倾城色，自是～人。","book":"明·凌濛初《初刻拍案惊奇》卷十"},"similar":["出类拔萃","超群拔类"],"opposite":["平平庸庸"],"usage":"作谓语、定语；指胜过众人"},{"id":42372,"word":"超群拔类","pinyin":"chāo qún bá lèi","abbr":"cqbl","explanation":"超出众人，在同辈中拔尖。","source":{"text":"这骕郎文艺固是超群轶类，怜与素臣天生神力仿佛。","book":"清·夏敬渠《野叟曝言》第一百三十八回"},"example":{"text":"我是把《诗经》上反复咏叹的笔法神而化之的，你想，不是一个～的美中之后女主角活现在你眼前么！","book":"茅盾《无题》"},"similar":["出类拔萃","超群拔萃"],"opposite":["平平庸庸"],"usage":"作谓语、定语；指人杰出"},{"id":42373,"word":"超群拔萃","pinyin":"chāo qún bá cuì","abbr":"cqbc","explanation":"超群：超出众人；拔：超出；拔萃：才具特出。出类拔萃，形容超越寻常，杰出。","source":{"text":"至于歧阳有凤，则超群拔萃，其动物中之至文者欤？","book":"明·宋濂《灵隐大师复公文集》序"},"example":{"text":"又于领袖团体之中，必有一二人有～之威德。","book":"梁启超《中国史叙论》第七节"},"similar":["超群拔类","超群轶类"],"opposite":["碌碌无能"],"usage":"作谓语、定语；指人杰出"},{"id":42374,"word":"超群绝伦","pinyin":"chāo qún jué lún","abbr":"cqjl","explanation":"伦：同辈。超出一般人，没有可以相比的。","source":{"text":"亮知羽护前，乃答之曰：‘孟起兼资文武，雄烈过人，一世之杰，黥、彭之徒，当与益德并驱争先，犹未及髯之绝伦逸群也。’","book":"《三国志·蜀书·关羽传》"},"example":{"text":"陈景润在数学上的贡献说明他数学才能～。"},"similar":["出类拔萃","超凡入圣","超群出众"],"opposite":["碌碌无能","无名小卒","芸芸众生"],"usage":"作谓语、定语、补语；形容很不平凡","story":["三国时期蜀国“过五关斩六将”的大将关羽，受命驻守荆州，听到诸葛亮在四川用计收降了勇将马超，心中不平，写信询问诸葛亮马超是何许人也。诸葛亮明白关羽的嫉妒心理，就在信中夸关羽超群绝伦，马超不如他，关羽大喜"]},{"id":42375,"word":"超群越辈","pinyin":"chāo qún yuè bèi","abbr":"cqyb","explanation":"超越众人和同辈。","source":{"text":"臣山东孤子，朝无亲故。性识愚鲁，非有才能。陛下超群越辈，崇以荣宠。","book":"唐·陈子昂《为将军程处弼谢放流表》"},"similar":["超群轶类","出类拔萃"],"opposite":["碌碌无能"],"usage":"作谓语、定语；指人杰出"},{"id":42376,"word":"超群轶类","pinyin":"chāo qún yì lèi","abbr":"cqyl","explanation":"超出众人，在同辈中拔尖。同“超群拔类”。","source":{"text":"这骕郎文艺固是超群轶类，怜与素臣天生神力仿佛。","book":"清·夏敬渠《野叟曝言》第一百三十八回"},"similar":["出类拔萃","超群拔萃"],"opposite":["碌碌无能"],"usage":"作谓语、定语；指人杰出"},{"id":42377,"word":"超超玄箸","pinyin":"chāo chāo xuán zhù","abbr":"ccxz","explanation":"超超：高超；玄：微妙；箸：通“著”，明显。指言论文辞高妙又明切。","source":{"text":"我与王安丰说延陵、子房，亦超超玄箸。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"读此诗而思此景，即不必有此景。而但读此诗已令人～矣。","book":"清·无名氏《杜诗言志》第十卷"},"similar":["超超玄著"],"usage":"作谓语、定语；用于言词与文章"},{"id":42378,"word":"超超玄著","pinyin":"chāo chāo xuán zhù","abbr":"ccxz","explanation":"超超：形容高超；玄：微妙；著：明显。言论、文辞高妙明切。","source":{"text":"我与王安丰说延陵、子房，亦超超玄箸。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"读此诗而思此景，即不必有此景。而但读此诗已令人～矣。","book":"清·无名氏《杜诗言志》卷十"},"similar":["超超玄箸"],"usage":"作谓语、定语；用于言词与文章"},{"id":42379,"word":"超轶绝尘","pinyin":"chāo yì jué chén","abbr":"cyjc","explanation":"轶：车辙；超轶：指后车超过前车；绝尘：脚不沾尘土。形容奔跑得极快。","source":{"text":"天下马有成材，若恤若失，若丧其一，若是超轶绝尘，不知其所。","book":"《庄子·徐无鬼》"},"example":{"text":"兰亭刻石，虽佳本皆不免有可恨。此唐人响拓，乃独纵横放肆，不为法度拘窘，犹可想见茧纸故书之～。","book":"宋·陆游《跋兰亭序》"},"similar":["出类拔萃"],"opposite":["平平庸庸"],"usage":"作谓语、定语；形容很不平凡"},{"id":42380,"word":"超迈绝伦","pinyin":"chāo mài jué lún","abbr":"cmjl","explanation":"伦：同辈。超越同辈，无人可比。","source":{"text":"出入穷奇，纵横逸笔，力遵韵雅，超迈绝伦。","book":"南朝齐·谢赫《毛惠远》"},"similar":["超然迈伦","出类拔萃"],"opposite":["平平庸庸"],"usage":"作谓语、定语；用于夸奖人"},{"id":42381,"word":"超逸绝伦","pinyin":"chāo yì jué lún","abbr":"cyjl","explanation":"超：超过；绝：没有；伦：同辈。超出众人，同辈中没有可以相比的。","source":{"text":"刘希夷学梁简文，而超逸绝伦，居然青出。","book":"清·王闿运《湘绮楼论唐诗》"},"similar":["超类绝伦","超群绝伦"],"usage":"作谓语、定语、补语；形容很不平凡"},{"id":42382,"word":"超逸绝尘","pinyin":"chāo yì jué chén","abbr":"cyjc","explanation":"指不拘滞于世俗，超然物外。","source":{"text":"往昔字学之流，其初笔法安在？惟其胸次笔端超逸绝尘，暗合法度，则其草创便为一物之宗。","book":"《宣和书谱·空鲙帖》"},"similar":["超轶绝尘"],"usage":"作谓语、定语；形容很不平凡"},{"id":42383,"word":"超阶越次","pinyin":"chāo jiē yuè cì","abbr":"cjyc","explanation":"指越过原有的等级顺序，多指越级提升官吏。同“不次之迁”。","source":{"text":"其余同谋者咸超阶越次，不可胜纪，至于奴卒厮役亦加以爵位。","book":"《晋书·赵五伦传》"},"similar":["连升三级"],"usage":"作谓语、宾语；用于官场"},{"id":42384,"word":"越人肥瘠","pinyin":"yuè rén féi jí","abbr":"yrfj","explanation":"瘠：瘦。不在乎越人的肥与瘦。比喻痛痒与己无关","source":{"text":"越人肥瘠由他罢，秦人各自一关中。","book":"清·李绿园《歧路灯》第44回"},"similar":["越瘠秦视","越瘦秦肥","越瘦吴肥"],"usage":"作宾语、定语；用于比喻句"},{"id":42385,"word":"越俎代庖","pinyin":"yuè zǔ dài páo","abbr":"yzdp","explanation":"越：跨过；俎：古代祭祀时摆祭品的礼器；庖：厨师。主祭的人跨过礼器去代替厨师办席。比喻超出自己业务范围去处理别人所管的事。","source":{"text":"庖人虽不治庖，尸祝不越樽俎而代之矣。","book":"《庄子·逍遥游》"},"example":{"text":"孩子能做的事，父母不要～。"},"similar":["包办代替"],"opposite":["自力更生"],"usage":"作谓语、定语；指包办","story":["传说上古时期，尧在让位给舜之前，听说许由道德十分高尚，便想让位给他。许由坚决不同意，说你把天下治理得很好，让我来替代你享受现成的名声，我不想占用你的名声。他还说：“庖人虽不治庖，尸、祝不越樽俎而代之矣。”"]},{"id":42386,"word":"越俎代谋","pinyin":"yuè zǔ dài móu","abbr":"yzdm","explanation":"俎：古代祭祀时用的盛祭品的器具。管祭祀的人放下祭器去代替别人出谋划策。比喻越权办事或包办代替","source":{"text":"同者彼此通行，异者各行其是，无庸越俎代谋。","book":"郑观应《盛世危言·公法》"},"example":{"text":"柳亚子《纪梦诗序》：“友邦领袖，老谋深算，成竹在胸，岂外人所宜～？”"},"usage":"作谓语、定语；用于处事"},{"id":42387,"word":"越凡遗世","pinyin":"yuè fán yí shì","abbr":"yfys","explanation":"超越凡俗，脱离世俗社会","source":{"text":"每进一卮，侍女们八音齐奏，音调清和，令人有越凡遗世之想。","book":"明·凌濛初《二刻拍案惊奇》第37卷"},"usage":"作谓语、定语；用于处事"},{"id":42388,"word":"越凫楚乙","pinyin":"yuè fú chǔ yǐ","abbr":"yfcy","explanation":"同一只飞鸿，有人以为野鸭，有人以为燕子。比喻由于主观片面，对于事物认识不清而判断错误。","source":{"text":"昔有鸿飞天道，积远难亮。越人以为凫，楚人以为乙。人自楚越耳，鸿常一鸿乎？","book":"南朝·齐·张融《门论》"},"example":{"text":"～休题品，识字何曾为近名。","book":"柴萼《李纫兰》"},"usage":"作宾语、定语；指看法不一"},{"id":42389,"word":"越分妄为","pinyin":"yuè fèn wàng wéi","abbr":"yfww","explanation":"越：超越；分：本分；妄：胡乱。超越本分而胡作非为。形容不按一定的职责范围和规定办事。","source":{"text":"且洞主向来谨慎从不越分妄为，岂有违旨之理！","book":"清·李汝珍《镜花缘》第四回"}},{"id":42390,"word":"越古超今","pinyin":"yuè gǔ chāo jīn","abbr":"ygcj","explanation":"超越古今。同“超今冠古”。","source":{"text":"这功名富贵，有也寻常，管做得、越古超今神妙。","book":"宋·朱敦儒《洞仙歌·赠太易》词"},"example":{"text":"伏睹魏王，自登位以来，德布四方，仁及万物，～，虽唐、虞无以过此。","book":"明·罗贯中《三国演义》第八十回"},"similar":["超今越古"],"usage":"作谓语、宾语；用于夸奖人"},{"id":42391,"word":"越女齐姬","pinyin":"yuè nǚ qí jī","abbr":"ynqj","explanation":"相传古代越国和齐国出美女，后泛指美女。","source":{"text":"越女侍前，齐姬奉后。","book":"汉·枚乘《七发》"},"usage":"作宾语、定语；指美女"},{"id":42392,"word":"越扶越醉","pinyin":"yuè fú yuè zuì","abbr":"yfyz","explanation":"对喝醉了酒的人，越搀扶他，越是撒酒疯。比喻越迁就对方，则其行为越变本加厉。","source":{"text":"那洋人的脾气，是越扶越醉的，不理他倒也罢了；理了他，他倒跳上架子了。","book":"清·李宝嘉《官场现形记》第三十一回"},"example":{"text":"甚么是肯罢兵！象酗酒的凶徒一般，～。（清·西周生《醒世姻缘传》第四十四回）"},"usage":"作宾语、定语；用于口语"},{"id":42393,"word":"越次超伦","pinyin":"yuè cì chāo lún","abbr":"yccl","explanation":"次：次序。伦：次序。超越原来的等级次序。","source":{"text":"臣有何功德，有何才能？越次超伦，忽承此命。","book":"唐·白居易《为宰相〈让官表〉》"},"similar":["越次躐等"],"usage":"作谓语、定语；用于书面语"},{"id":42394,"word":"越次躐等","pinyin":"yuè cì liè děng","abbr":"ycld","explanation":"躐：逾越。指超越原有的等级顺序。","source":{"text":"今陛下之所震怒而赐谴者，何人也？合于圣意诱而进之者，何人也？所与朝夕论议深言者，何人也？越次躐等召而问讯之者，何人也？四者，臣皆未之闻焉。","book":"宋·苏轼《御侍制科策一道》"},"similar":["越次超伦"],"usage":"作谓语、定语；用于书面语"},{"id":42395,"word":"越畔之思","pinyin":"yuè pàn zhī sī","abbr":"ypzs","explanation":"畔：田地的界限。考虑问题不越界限。指严守自己的职责，不侵扰他人的权限。","source":{"text":"行无越思，如农之有畔。","book":"《左传·襄公二十五年》"},"example":{"text":"三思后行，～，不出位之思，循理之思也。（宋·曾巩《思政堂记》沈德潜评）"}},{"id":42396,"word":"越瘠秦视","pinyin":"yuè jí qín shì","abbr":"yjqs","explanation":"瘠：瘦。看待他人的得失，就像秦国人看待越国人的肥瘦一样。比喻痛痒与己无关","source":{"text":"嗟哉闾里遭颠连，越瘠秦视人胡然。","book":"清·张永铨《海啸行》"},"similar":["越瘦秦肥"],"usage":"作宾语、定语；用于比喻句"},{"id":42397,"word":"越瘦吴肥","pinyin":"yuè shòu wú féi","abbr":"yswf","explanation":"不在乎越国人瘦和吴国人肥胖。比喻痛痒与己无关","source":{"text":"图求谋，多只为一身之计；纵奸贪，那里管越瘦吴肥。","book":"明·兰陵笑笑生《金瓶梅词话》第70回"},"similar":["越瘦秦肥","越瘠秦视","越人肥瘠"],"usage":"作宾语、定语；用于比喻句"},{"id":42398,"word":"越瘦秦肥","pinyin":"yuè shòu qín féi","abbr":"ysqf","explanation":"比喻痛痒与己无关。","source":{"text":"视政之得失，若越人之视秦人之肥瘠，忽焉不加喜戚于其心。","book":"唐·韩愈《争臣论》"},"example":{"text":"将焉用彼过谁欤，那知～？","book":"元·施惠《幽闺记·罔害皤良》"},"similar":["越人肥瘠","越瘠秦视"],"usage":"作宾语、定语；比喻痛痒与己无关"},{"id":42399,"word":"越罗蜀锦","pinyin":"yuè luó shǔ jǐn","abbr":"ylsj","explanation":"越：古代越国，今浙江一带；蜀：指今四川一带；罗、锦：都是精美的丝织品。越地的罗，蜀地的锦。比喻均为特产，各有所长。","source":{"text":"缫丝须长不须白，越罗蜀锦金粟尺。","book":"唐·杜甫《白丝行》"},"example":{"text":"～吾何用，且备豳人卒岁衣。（宋·陆游《初夏》）"}},{"id":42400,"word":"越鸟南栖","pinyin":"yuè niǎo nán qī","abbr":"ynnq","explanation":"从南方飞来的鸟，筑巢时一定在南边的树枝上。比喻难忘故乡情。","source":{"text":"葫马依北风，越鸟巢南枝。","book":"南朝·梁·萧统《古诗十九首》"},"example":{"text":"但闻～，狐死首丘，万里亲戚坟墓，俱在南朝，早暮思想，食不甘味。","book":"明·冯梦龙《醒世恒言》"},"similar":["狐死首丘","月是故乡明"],"opposite":["数典忘祖"],"usage":"作谓语、宾语；比喻难忘故乡情"},{"id":42401,"word":"越鸟巢南枝","pinyin":"yuè niǎo cháo nán zhī","abbr":"yncnz","explanation":"越鸟来自于南方，故故巢宿于南枝。比喻不忘根本。","source":{"text":"胡马依北风，越鸟巢南枝。","book":"汉·无名氏《古诗十九首》"},"similar":["狐死首丘","越鸟南栖"],"usage":"作宾语、定语；用于比喻句"},{"id":42402,"word":"趋之如鹜","pinyin":"qū zhī rú wù","abbr":"qzrw","explanation":"趋：快走；鹜：野鸭。像鸭子一样成群跑过去。比喻很多人竞相追逐某一事物。","source":{"text":"京外的官员，那个不趋之若鹜呢！","book":"曾朴《孽海花》第27回"},"example":{"text":"早上起来还没吃东西，自然大家～。","book":"茅盾《脱险杂记》"},"similar":["趋之若鹜"],"usage":"作谓语、定语；指竞相追逐"},{"id":42403,"word":"趋之若骛","pinyin":"qū zhī ruò wù","abbr":"qzrw","explanation":"鹜：鸭。像鸭子一样成群跑过去。比喻很多人争着赶去。","source":{"text":"白云观就是他纳贿的机关，高道士就是他作恶的心腹，京外的官员，那个不趋之若骛呢！","book":"清·曾朴《孽海花》第27回"},"example":{"text":"为民上者，以名利二字驰使天下，而天下之民～。","book":"清·郑观应《盛世危言·技艺》"}},{"id":42404,"word":"趋之若鹜","pinyin":"qū zhī ruò wù","abbr":"qzrw","explanation":"趋：快走；鹜：野鸭。象鸭子一样成群跑过去。比喻很多人争着赶去。","source":{"text":"如薰亦能诗，士趋之若鹜，宾客常满。","book":"《明史·萧如薰传》"},"example":{"text":"京外的官员，那个不～呢！（清·曾朴《孽海花》第二十七回）"},"similar":["如蝇逐臭","如蚁附膻","趋之如骛"],"opposite":["敬而远之","无人问津"],"usage":"作谓语、定语；指竞相追逐"},{"id":42405,"word":"趋人之急","pinyin":"qū rén zhī jí","abbr":"qrzj","explanation":"热心主动帮助别人解决困难。","source":{"text":"家无余财，衣不完采，食不重味，乘不过軥牛。专趋人之急，甚已之私。","book":"《诗经·小雅·常棣》：“脊令在原，兄弟急难。”《史记·游侠列传》"}},{"id":42406,"word":"趋利避害","pinyin":"qū lì bì hài","abbr":"qlbh","explanation":"趋向有利的一面，避开有害的一面。","source":{"text":"至于趋利避害，畏死乐生，亦复均也。","book":"汉·霍谞《奏记大将军梁商》"},"example":{"text":"同什么人都可以打交道，在打交道的过程中～。","book":"邓小平《解放思想，独立思考》"},"similar":["避害就利"],"usage":"作谓语、宾语；用于处事"},{"id":42407,"word":"趋前退后","pinyin":"qū qián tuì hòu","abbr":"qqth","explanation":"形容犹豫害怕欲进又退的样子。","source":{"text":"我见他趋前退后，待言语却又早紧低头。","book":"元·曾瑞《留鞋记》楔子"},"example":{"text":"那小娘子抬头观省，远远的也认得是乐小舍人，见他～，神情不定，心上也觉可怜。","book":"明·冯梦龙《警世通言》卷二十三"},"usage":"作谓语、定语；用于处事"},{"id":42408,"word":"趋势附热","pinyin":"qū shì fù rè","abbr":"qsfr","explanation":"趋：奔走，投靠。奉承和依附有权有势的人。","example":{"text":"～的人往往丢失的是人格。"},"similar":["趋炎附势","趋炎附热"],"usage":"作谓语、宾语、定语；指人势利"},{"id":42409,"word":"趋吉逃凶","pinyin":"qū jí táo xiōng","abbr":"qjtx","explanation":"趋：趋向。趋向吉祥避开灾难。","source":{"text":"即墨近城东，不须忧恐，趋吉逃凶，仗剑当陪奉，管取平安保我宗。","book":"明·张凤翼《灌园记·田单铁笼》"},"similar":["趋吉避凶"],"usage":"作谓语、宾语；用于处事"},{"id":42410,"word":"趋吉避凶","pinyin":"qū jí bì xiōng","abbr":"qjbx","explanation":"谋求安吉，避开灾难。","source":{"text":"吾等问于高明之人，当趋吉避凶。","book":"明·罗贯中《三国演义》第62回"},"example":{"text":"谁都想～。"},"similar":["趋吉逃凶"],"usage":"作谓语、宾语；用于处事"},{"id":42411,"word":"趋名逐利","pinyin":"qū míng zhú lì","abbr":"qmzl","explanation":"趋：奔向；逐：追逐。比喻自私自利，只追求个人的名誉和利益。","source":{"text":"趋名逐利身，终日走风尘。","book":"唐·唐求《山居偶作》"},"example":{"text":"我自都中起身，觉得人生世上，～，毫无趣味。","book":"清·李百川《绿野仙踪》第五回"}},{"id":42412,"word":"趋时奉势","pinyin":"qū shí fèng shì","abbr":"qsfs","explanation":"迎合时尚，依附权势。多用作贬义。同“趋时附势”。","source":{"text":"若是他得了官时去看他，教人道我趋时奉势。","book":"明·冯梦龙《警世通言》第六卷"},"similar":["趋时附势"],"usage":"作谓语、定语；用于处事"},{"id":42413,"word":"趋时附势","pinyin":"qū shí fù shì","abbr":"qsfs","explanation":"迎合时尚，依附权势。多用作贬义。","source":{"text":"盖趋时附势人情则然，古今所同也。何责于薄俗哉？","book":"宋·朱熹《朱子语类》卷七十：“如此人趋时附势以得富贵而自为乐者也。”元·刘壎《隐居通议·经史二》"},"example":{"text":"指亲托故厮还，～故相干。","book":"元·无名氏《渔樵记》第二折"},"similar":["趋时奉势"],"usage":"作谓语、定语；用于处事"},{"id":42414,"word":"趋权附势","pinyin":"qū quán fù shì","abbr":"qqfs","explanation":"趋：奔走；权：权势。奉承和依附有权有势的人。","source":{"text":"注鄙人，然而有志于圣贤之术，心铭足下之道，故发此书以闻，非今之趋炎附势辈，闻足下有大名而沽相知之幸，足下其以为是非。","book":"宋·李觏《名公手书·萧注》"},"example":{"text":"我只要～，那里管杀人媚人。","book":"明·杨珽《龙膏记·罗织》"},"similar":["趋炎附势","趋炎奉势"],"usage":"作谓语、宾语、定语；指人势利"},{"id":42415,"word":"趋炎奉势","pinyin":"qū yán fèng shì","abbr":"qyfs","explanation":"趋：奔走，投靠。奉承和依附有权有势的人。","source":{"text":"且说外面这些趋炎奉势的朋友，先前贾宅有事都远避不来，今儿贾政袭职，知圣眷尚好，大家都来贺喜。","book":"清·曹雪芹《红楼梦》第107回"},"similar":["趋炎附势","趋炎附热"],"usage":"作谓语、宾语、定语；指人势利"},{"id":42416,"word":"趋炎慕势","pinyin":"qū yán mù shì","abbr":"qyms","explanation":"趋：奔走，投靠；炎：热。奉承和依附有权有势的人。","source":{"text":"至于冷祝夫妻、都飙母子，一味不过利其所有，趋炎慕势，奴颜婢膝，昏夜乞怜，与那街坊上的花子何异？","book":"明·伏雌教主《醋葫芦》第三回"},"similar":["趋炎附势"],"usage":"作谓语、宾语、定语；指人势利"},{"id":42417,"word":"趋炎赶热","pinyin":"qū yán gǎn rè","abbr":"qygr","explanation":"趋：奔走，投靠。奉承和依附有权有势的人。","source":{"text":"稍觉冷落，却便别处去趋炎赶热，把那穷交故友撇在脑后。","book":"明·康海《中山狼》第四折"},"similar":["趋炎附热","趋炎附势"],"usage":"作谓语、宾语、定语；指人势利"},{"id":42418,"word":"趋炎附势","pinyin":"qū yán fù shì","abbr":"qyfs","explanation":"趋：奔走；炎：热，比喻权势。奉承和依附有权有势的人。","source":{"text":"今已老大，见大臣不公，常欲面折之。焉能趋炎附热，看人眉睫，以冀推挽乎？","book":"《宋史·李垂传》"},"example":{"text":"所有朋谊及那些～的，男男女女，都拥挤望周府来。","book":"清·黄小配《廿载繁华梦》第十五回"},"similar":["曲意逢迎","如蚁附膻","趋炎慕势"],"opposite":["刚正不阿"],"usage":"作谓语、宾语、定语；指人势利","story":["宋真宗时馆阁校理李垂上书治理黄河水灾，特著书《导河形胜图》，由于宰相丁谓的阻拦没有得到实施，好心人劝他去拜访丁谓，李垂不但不去巴结，反而抨击他，被贬出京。后来回京，李伯康劝他去拜见新宰相，他说他不会去趋炎附势的"]},{"id":42419,"word":"趋炎附热","pinyin":"qū yán fù rè","abbr":"qyfr","explanation":"趋：奔走；热：比喻权势。奉承和依附有权有势的人。","source":{"text":"今已老大，见大臣不公，常欲面折之。焉能趋炎附热，看人眉睫，以冀推挽乎？","book":"《宋史·李垂传》"},"example":{"text":"止有白长吉一味～，说妹子是穷骨头，要跟恁样饿莩，坏他体面。","book":"明·冯梦龙《醒世恒言》卷二十五"},"similar":["趋炎附势","趋炎赶热"],"usage":"作谓语、宾语、定语；指人势利"},{"id":42420,"word":"趋舍异路","pinyin":"qū shě yì lù","abbr":"qsyl","explanation":"趋舍：趋向或舍弃，进取或退止。指遵循和舍弃的道路不同。","source":{"text":"仆与李陵趋舍异路，素非相善也。","book":"汉·荀悦《汉纪·武帝纪》"},"example":{"text":"科举不改，聪明之士，皆务习帖括，以取富贵，～，能俯就乎？","book":"清·梁启超《论变法不知本原之害》"},"usage":"作谓语、定语；用于书面语"},{"id":42421,"word":"趋舍有时","pinyin":"qū shě yǒu shí","abbr":"qsys","explanation":"趋舍：趋向或舍弃，进取或后退。比喻人的得失、升降有一定的时机。","source":{"text":"伯夷、叔齐虽贤，得夫子而名益彰。颜渊虽笃学，附骥尾而行益显。岩穴之士，趋舍有时若此，类名湮灭而不称，悲夫。","book":"《史记·伯夷列传》"}},{"id":42422,"word":"趑趄不前","pinyin":"zī jū bù qián","abbr":"zjbq","explanation":"趑趄：迟疑不敢前进。形容犹豫畏缩不敢前进。","source":{"text":"足将进而趑趄，口将言而嗫嚅。","book":"《周易·夬》：“臀无肤，其行次且。”唐·韩愈《送李愿归盘谷序》"},"example":{"text":"不由自主的便上了包车，仍回到鸿仁里，望着自己门口，倒有点～之态。","book":"清·吴趼人《近十年之怪现状》第七回"},"similar":["瞻前顾后","举棋不定","首鼠两端"],"opposite":["勇往直前","一往无前"],"usage":"作谓语、定语；指人胆小怕事"},{"id":42423,"word":"趑趄嗫嚅","pinyin":"zī jū niè rú","abbr":"zjnr","explanation":"欲进又退，欲言又止。形容奴颜婢膝，畏缩不前的样子。","source":{"text":"伺候于公卿之门，奔走于形势之途，足将进而趑趄，口将言而嗫嚅，处秽汙而不羞，触刑辟而诛戮，侥幸于万一，老死而后止者，其于为人贤不肖何如也？","book":"语出唐·韩愈《送李愿归盘谷序》"},"example":{"text":"肯效～徼名势，坐令尘土凋朱颜。","book":"明·方孝孺《游峨嵋》诗"},"usage":"作宾语、定语；用于书面语"},{"id":42424,"word":"趔趄而行","pinyin":"liè qiè ér xíng","abbr":"lqex","explanation":"身子歪斜不稳地走路。","example":{"text":"她～，十分艰难。"},"usage":"作谓语；用于老人或小孩"},{"id":42425,"word":"趔趔趄趄","pinyin":"liè liè qiè qiè","abbr":"llqj","explanation":"身子歪斜，行路不稳的样子。","source":{"text":"两个人共提着一桶水，一手撩着衣裳，趔趔趄趄，泼泼撒撒的。","book":"清·曹雪芹《红楼梦》第24回"},"example":{"text":"路遥《平凡的世界》第一卷第一章：“所有打了饭菜的人，都用草帽或胳膊肘护着碗，～穿过烂泥塘般的院坝，跑回自己的宿舍去了。”"},"similar":["颤颤巍巍","踉踉跄跄"],"usage":"作定语、状语；用于人的走路形态","story":["贾宝玉从外边回来，见袭人不在，晴雯也不在，要喝茶与洗澡，小红立即上前献殷勤。宝玉觉得奇怪，但没有别的使唤的丫鬟只好将就。这时秋纹、碧痕两个人共提着一桶水嘻嘻哈哈的说笑着进来，走路趔趔趄趄的，小红只好知趣地走开"]},{"id":42426,"word":"趣舍有时","pinyin":"qù shě yǒu shí","abbr":"qsys","explanation":"趣舍：趣向或舍弃；进取或退让。指人的得失、进退有一定的时机。","source":{"text":"伯夷、叔齐虽贤，得夫子而名益彰。颜渊虽笃学，附骥尾而行益显。岩穴之士，趣舍有时若此，类名堙灭而不称，悲夫！","book":"《史记·伯夷列传》"},"usage":"作谓语；指人的得失进退有时机"},{"id":42427,"word":"趦趄却顾","pinyin":"zī jū què gù","abbr":"zjqg","explanation":"却顾：回头看。欲进而犹豫不前回头观望。","source":{"text":"各国王国妃，俱贪看园中奇景，临别时，趦趄却顾，十步九回。","book":"清·夏敬渠《野叟曝言》第一百四十六回"},"usage":"作谓语、定语；用于书面语"},{"id":42428,"word":"足上首下","pinyin":"zú shàng shǒu xià","abbr":"zssx","explanation":"脚在上，头在下。比喻长幼尊卑相互颠倒","source":{"text":"足反居上，首顾居下，倒县如此，犹为国有人乎？","book":"东汉·班固《汉书·贾谊传》"},"usage":"作宾语、定语；用于比喻句"},{"id":42429,"word":"足不出户","pinyin":"zú bù chū hù","abbr":"zbch","explanation":"脚不跨出家门。","source":{"text":"却说苏盼奴自赵司户去后，足不出门，一客不见，只等襄阳来音。","book":"明·凌濛初《初刻拍案惊奇》卷二十五"},"example":{"text":"据我个人的经验，我们那里的土话，和苏州很不同，但一部《海上花列传》，却教我“～”懂了白。","book":"鲁迅《花边文学·汉字和拉丁化》"},"similar":["深居简出"],"opposite":["走南闯北"],"usage":"作谓语、宾语；指不常出门"},{"id":42430,"word":"足不出门","pinyin":"zú bù chū mén","abbr":"zbcm","explanation":"不出大门一步。指闭门自守。","source":{"text":"却说苏盼奴自赵司户去后，足不出门，一客不见，只等襄阳来音。","book":"明·凌濛初《初刻拍案惊奇》卷二十五"},"similar":["足不窥户","足不出户"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42431,"word":"足不履影","pinyin":"zú bù lǚ yǐng","abbr":"zbly","explanation":"比喻循规蹈矩。","source":{"text":"自见孔子，出入于户，未尝越礼，往来过之，足不履影。","book":"《孔子家语·弟子行》"},"usage":"作宾语、定语；用于书面语"},{"id":42432,"word":"足不窥户","pinyin":"zú bù kuī hù","abbr":"zbkh","explanation":"不出大门一步。指闭门自守。","source":{"text":"他那二十多年足不窥户的生活简直是不折不扣的坟墓生活！","book":"茅盾《子夜》一"},"similar":["足不出门","足不出户"],"usage":"作谓语、定语、宾语；用于处事"},{"id":42433,"word":"足不逾户","pinyin":"zú bù yú hù","abbr":"zbyh","explanation":"不出大门一步。指闭门自守。","source":{"text":"仍住吴，居波若寺，足不逾户，人莫见其面。","book":"《南齐书·高逸传·何求》"},"similar":["足不出户"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":42434,"word":"足兵足食","pinyin":"zú bīng zú shí","abbr":"zbzs","explanation":"粮食、军备充足。","source":{"text":"秉戈执耒，宜为足兵足食之思；牧马饭牛，盍讲且战且耕之政。","book":"宋·胡錡《耕禄稿·代田万顷到任谢表》"},"example":{"text":"～，严罚从其后，而人自为守矣。","book":"王闿运《与曽侍郎言兵事书》"},"similar":["足食足兵"],"usage":"作主语、宾语；指军备"},{"id":42435,"word":"足尺加二","pinyin":"zú chǐ jiā èr","abbr":"zcje","explanation":"比喻过分、过头。","source":{"text":"在恭王自己接见的贺客中，有人说要请大格格出来，以公主的身份，接受叩贺；只这原是足尺加二的趋奉，但正如俗话所说的，‘马屁拍在马脚上’，惹得恭王大为不悦。","book":"高阳《慈禧前传》十"},"usage":"作宾语、定语；用于书面语"},{"id":42436,"word":"足履实地","pinyin":"zú lǚ shí dì","abbr":"zlsd","explanation":"履：踩踏。脚踏实地。比喻实事求是，平实而不虚浮","source":{"text":"生平常谓：吾无他长，惟足履实地。","book":"《宋史·刘甲传》"},"similar":["足踏实地"],"usage":"作谓语、定语、状语；用于处事"},{"id":42437,"word":"足智多谋","pinyin":"zú zhì duō móu","abbr":"zzdm","explanation":"足：充实，足够；智：聪明、智慧；谋：计谋。富有智慧，善于谋划。形容人善于料事和用计。","source":{"text":"此人足智多谋，可与共事。","book":"元·无名氏《连环计》第一折"},"example":{"text":"～之士，能征惯战之将，何止一二千人。","book":"明·罗贯中《三国演义》第四十三回"},"similar":["智谋过人","大智若愚","诡计多端"],"opposite":["愚昧无知","愚不可及","束手无策"],"usage":"作谓语、宾语、定语；指人的计谋多"},{"id":42438,"word":"足茧手胝","pinyin":"zú jiǎn shǒu zhī","abbr":"zjsz","explanation":"指由于辛劳而使手和脚上生了老茧。","source":{"text":"行役之劳曰足茧手胝。","book":"明·王志坚《表异录·言动》"},"usage":"作宾语、定语；用于书面语"},{"id":42439,"word":"足衣足食","pinyin":"zú yī zú shí","abbr":"zyzs","explanation":"衣食丰足。指生活富裕。","source":{"text":"我佛当日为救门徒六道轮回，犹如舟船，般运众生，达于彼岸。此时总得见佛，今世足衣足食。","book":"《敦煌变文集·丑女缘起》"},"example":{"text":"清·曹雪芹《红楼梦》第120回：“我们还打听打听，若果然～，女婿长的象个人儿，然后叫他出去。”"},"similar":["丰衣足食","足食丰衣"],"usage":"作谓语、定语；指生活富足"},{"id":42440,"word":"足足有余","pinyin":"zú zú yǒu yú","abbr":"zzyy","explanation":"形容充足、宽裕，支用不完。","source":{"text":"家庭生活足足有余。","book":"《新华日报》1954.10.31"},"example":{"text":"按照现在的用水量，我们的存水用到目的港是～的。","book":"陆俊超《惊涛骇浪万里行》"},"similar":["绰绰有余"],"usage":"作谓语、定语；指十分富足"},{"id":42441,"word":"足趼舌敝","pinyin":"zú jiǎn shé bì","abbr":"zjsb","explanation":"指费了许多力气和口舌。","source":{"text":"至汉槎赐环之事，桭臣言同社诸公，如宋右之相国……固不忘故旧，而其中足趼舌敝，以成兹举者，则大冯三兄之力居多。","book":"清·叶廷琯《吹网录·宁古塔纪略》"},"usage":"作定语、状语；用于书面语"},{"id":42442,"word":"足踏实地","pinyin":"zú tà shí dì","abbr":"ztsd","explanation":"犹言脚踏实地。","source":{"text":"所有有灵魂的人，都应足踏实地，奋发自雄。","book":"徐铸成《报海旧闻》五一"},"similar":["脚踏实地","足履实地"],"usage":"作谓语、定语、状语；用于处事"},{"id":42443,"word":"足蹈手舞","pinyin":"zú dǎo shǒu wǔ","abbr":"zdsw","explanation":"犹言手舞足蹈。形容喜悦到极点时的样子。","source":{"text":"闻之者足蹈手舞，睹之者目骇心惕。","book":"唐·陆贽《圣人苑中射落飞雁赋》"},"example":{"text":"闻者欠伸屡作，欲睡欲遁，而诵者～，茫不自觉。","book":"清·蒲松龄《聊斋志异·苗生》"},"similar":["手舞足蹈"],"usage":"作谓语、定语、状语；用于处事"},{"id":42444,"word":"足音空谷","pinyin":"zú yīn kōng gǔ","abbr":"zykg","explanation":"比喻难得的人物或言论。","source":{"text":"眼底浮云成变幻，足音空谷到沈幽。","book":"明·汤显祖《答王相如书》：“足音空谷，乃有相如。”胡熊锷《粲如到问偕隐内子目疾代赋以谢之》诗"},"example":{"text":"胡熊愕《粲如到问偕隐内子目疾代赋以谢之》诗：“眼底浮云成变幻，～到沈幽。”"},"similar":["空谷足音"],"usage":"作宾语、定语；用于书面语"},{"id":42445,"word":"足音跫然","pinyin":"zú yīn qióng rán","abbr":"zyqr","explanation":"跫：脚步声。原指长期住在荒凉寂寞的地方，对别人的突然来访感到欣悦。后常比喻难得的来客。","source":{"text":"夫逃虚空者，藜藋柱乎鼪鼬之径，踉位其空，闻人足音跫然而喜矣。","book":"《庄子·徐无鬼》"},"similar":["跫然足音"],"usage":"作宾语、定语；比喻难得的来客"},{"id":42446,"word":"足食丰衣","pinyin":"zú shí fēng yī","abbr":"zsfy","explanation":"丰衣足食。形容生活富裕。","source":{"text":"从早起，到晚夕，上下唇并不曾粘着水米，甚的是足食丰衣。","book":"元·石君宝《秋胡戏妻》第二折"},"example":{"text":"太平年有祥瑞，庄家每乐雍熙，端的五谷收成，～。","book":"明·无名氏《浣花溪》第一折"},"similar":["丰衣足食","足衣足食","衣丰食足"],"usage":"作谓语、定语；指生活富足"},{"id":42447,"word":"足食足兵","pinyin":"zú shí zú bīng","abbr":"zszb","explanation":"食：粮食；兵：武器。粮食充足，武备修整。","source":{"text":"子贡问政。子曰：‘足食足兵，民信之矣。’","book":"春秋·鲁·孔丘《论语·颜渊》"},"example":{"text":"何以能之？曰：～。","book":"清·龚自珍《御试安边绥远疏》"},"similar":["足兵足食"],"usage":"作主语、宾语；指军备"},{"id":42448,"word":"足高气强","pinyin":"zú gāo qì qiáng","abbr":"zgqq","explanation":"犹言趾高气扬。","source":{"text":"妾望君之人也，足高气强，有伐国之志也。","book":"明·冯梦龙《智囊补·明智·伐卫》"},"similar":["足高气扬"],"usage":"作谓语、定语、状语；用于处事"},{"id":42449,"word":"足高气扬","pinyin":"zú gāo qì yáng","abbr":"zgqy","explanation":"犹言趾高气扬。","source":{"text":"公孙戍趋而去。 未出，至中闺，君召而返之，曰：‘子教文无受象床，甚善。今何举足之高，志之扬也？’","book":"《战国策·齐策三》"},"example":{"text":"若初进者～，凌轹前辈。","book":"明·沈德符《野获编·谐谑·术艺》"},"similar":["志高气扬","趾高气扬"],"usage":"作谓语、定语、状语；指人的神态"},{"id":42450,"word":"趾踵相接","pinyin":"zhǐ zhǒng xiāng jiē","abbr":"zzxj","explanation":"形容人数之多。亦作“趾踵相错”。","source":{"text":"此外握风气之权者，为书院山长，为蒙馆学究，车载斗量，趾踵相接。","book":"梁启超《变法通议·论师范》"},"similar":["趾踵相错"],"usage":"作谓语、定语；用于书面语"},{"id":42451,"word":"趾踵相错","pinyin":"zhǐ zhǒng xiāng cuò","abbr":"zzxc","explanation":"形容人数之多。 同“趾踵相接”。","source":{"text":"弃家逃威，望门投止者，趾踵相错。","book":"《辛亥革命前十年间时论选集·革命制造厂》"},"similar":["趾踵相接"],"usage":"作谓语、定语；用于书面语"},{"id":42452,"word":"趾高气扬","pinyin":"zhǐ gāo qì yáng","abbr":"zgqy","explanation":"趾高：走路时脚抬得很高；气扬：意气扬扬。走路时脚抬得很高，神气十足。形容骄傲自满，得意忘形的样子。","source":{"text":"意气扬扬，甚自得也。","book":"《左传·桓公十三年》：“举趾高，心不固矣。”《史记·管晏列传》"},"example":{"text":"但是那种～的神情总嫌有些不够大方罢。","book":"闻一多《复古的空气》"},"similar":["得意忘形","不可一世","目空一切"],"opposite":["卑躬屈膝","奴颜婢膝","妄自菲薄"],"usage":"作谓语、状语；指人的神态","story":["战国时期，齐国孟尝君出使楚国，楚王送他珍贵的象床，负责送象床的登徒去游说孟尝君的门人公孙戍，希望能劝止这项差使。公孙戍说动孟尝君不接受这件宝物。孟尝君见他出门时趾高气扬的样子觉得奇怪，原来他得到登徒的一把宝剑"]},{"id":42453,"word":"跂予望之","pinyin":"qì yǔ wàng zhī","abbr":"qywz","explanation":"跂：抬起。抬起脚跟远望。","source":{"text":"吾尝跂而望矣。","book":"战国·赵·荀况《荀子·劝学》"},"example":{"text":"他～，希望她能早日回来。"},"usage":"作谓语；用于书面语"},{"id":42454,"word":"跂行喙息","pinyin":"qí xíng huì xī","abbr":"qxhx","explanation":"跂行：虫爬行，喻指有足能行者；喙：鸟嘴，指动物的嘴；喙息：用口呼吸。指含有人在内的各种动物。","source":{"text":"跂行喙息蠕之类，莫不就安利而辟危殆。","book":"《史记·匈奴列传》"},"example":{"text":"舟车所至，人迹所及，～，咸得其意。","book":"《汉书·公孙弘传》"}},{"id":42455,"word":"跃然纸上","pinyin":"yuè rán zhǐ shàng","abbr":"yrzs","explanation":"活跃地呈现在纸上。形容文学作品叙述描写真实生动。","source":{"text":"如此体会，则诗神诗旨，跃然纸上。","book":"清·薛雪《一瓢诗话》三三"},"example":{"text":"虽然象通不通似的，但是对于抗日救国的热烈和对于我们被捕的义愤，也已～。","book":"邹韬奋《经历·同情和厚意》"},"similar":["绘声绘色","栩栩如生","绘影绘声"],"opposite":["刻鹄类鹜","画虎类犬"],"usage":"作谓语、定语；指作品生动"},{"id":42456,"word":"跃跃欲试","pinyin":"yuè yuè yù shì","abbr":"yyys","explanation":"跃跃：急于要行动的样子；欲：要。形容急切地想试试。","source":{"text":"一席话说得唐二乱子心痒难抓，跃跃欲试。","book":"清·李宝嘉《官场现形记》第三十五回"},"example":{"text":"运动会即将举行，同学们个个磨拳擦掌，～。"},"similar":["蠢蠢欲动","摩拳擦掌"],"opposite":["无动于衷"],"usage":"作谓语、定语；用于工作、学习等"},{"id":42457,"word":"跃跃纸上","pinyin":"yuè yuè zhǐ shàng","abbr":"yyzs","explanation":"跃跃：生动形象地呈现。生动形象地呈现在纸上。形容文学作品叙述描写真实生动。","source":{"text":"结句‘恨向东风满’，饶有沉雄郁勃之致，跃跃纸上。","book":"清·黄氏《蓼园词评》"},"example":{"text":"即劣如秃僮，傻如跛婢，戆如屠户，懒如酒徒，淫如碧桃，狠如肇受，亦各有真面目，～。（清·魏子安《花月痕》第一回）"},"similar":["跃然纸上","跳跃纸上"],"usage":"作谓语、定语；用于写作等"},{"id":42458,"word":"跃马弯弓","pinyin":"yuè mǎ wān gōng","abbr":"ymwg","explanation":"驰马盘旋，张弓要射。形容摆开架势，准备作战。后比喻故做惊人的姿态，实际上并不立即行动。","source":{"text":"将军欲以巧伏人，盘马弯弓惜不发。","book":"唐·韩愈《雉带箭》诗"},"example":{"text":"其来戍者，又岂不能蓄数十辈建儿，～，以自为功名封殖计耶。","book":"清·侯方域《为司徒公赠万将军序》"},"similar":["盘马弯弓"],"usage":"作谓语、定语；用于书面语"},{"id":42459,"word":"跃马扬鞭","pinyin":"yuè mǎ yáng biān","abbr":"ymyb","explanation":"跃：跳。跳上骏马，举起马鞭。形容扬鞭催马急驰而去的样子。也比喻热火朝天地进行建设。","source":{"text":"一个个跃马扬鞭，插箭弯弓。","book":"元·王实甫《丽春堂》第一折"},"example":{"text":"亲承顾命赈饥荒，～到此方。","book":"明·高则诚《琵琶记·义仓赈济》"},"usage":"作谓语、状语；用于书面语"},{"id":42460,"word":"跅幪不羁","pinyin":"tuò méng bù jī","abbr":"tmbj","explanation":"放荡不受拘束。同“跅弛不羁”。"},{"id":42461,"word":"跅弛不羁","pinyin":"tuò chí bù jī","abbr":"tcbj","explanation":"放荡不受拘束。","source":{"text":"夫泛驾之马，跅弛之士，亦在御之而已。","book":"《汉书》"},"example":{"text":"章士钊《赵伯先事略》：“又激于意气，～，被酒大言，无所避就。”"},"similar":["放荡不羁"],"usage":"作谓语、定语；用于书面语"},{"id":42462,"word":"跅弢不羁","pinyin":"tuò tāo bù jī","abbr":"ttbj","explanation":"放荡不受拘束。同“跅弛不羁”。"},{"id":42463,"word":"跅驰之士","pinyin":"tuò chí zhī shì","abbr":"tczs","explanation":"跅驰：放逸不羁。指行为放纵，不受约束的人。","source":{"text":"夫泛驾之马，跅驰之士，亦在御之而已。","book":"《汉书·武帝纪》"},"example":{"text":"若必狂走叫号，挟其所贵，而希心于～以为奇者，非奇也。","book":"明·归有光《朱钦甫字说》"},"usage":"作主语、宾语；用于不受约束的人"},{"id":42464,"word":"跅驰之材","pinyin":"tuò chí zhī cái","abbr":"tczc","explanation":"跅驰：放逸不羁。指行为放纵，不受约束的人。","source":{"text":"夫泛驾之马，跅驰之士，亦在御之而已。","book":"《汉书·武帝纪》"}},{"id":42465,"word":"跋前疐后","pinyin":"bá qián zhì hòu","abbr":"bqzh","explanation":"同“跋胡疐尾”。比喻进退两难。","source":{"text":"直情径行，视毁誉如风而不恤；跋前疐后，方进退惟谷以堪惊。","book":"宋·陈亮《谢罗尚书启》"},"example":{"text":"其稍畏名义者，则包羞闵默而有～之忧。《续资治通鉴·宋理宗嘉熙元年》"},"similar":["跋前踬后","进退跋疐"],"usage":"作谓语、定语；指进退维谷"},{"id":42466,"word":"跋前痜后","pinyin":"bá qián zhì hòu","abbr":"bqzh","explanation":"同跋胡痜尾”。比喻进退两难。","source":{"text":"直情径行，视毁誉如风而不恤；跋前痜后，方进退惟谷以堪惊。","book":"宋·陈亮《谢罗尚书启》"}},{"id":42467,"word":"跋前踕后","pinyin":"bá qián jié hòu","abbr":"bqjh","explanation":"同“跋胡疐尾”。比喻进退两难。","source":{"text":"元·辛文房《唐才子传·罗邺》：“而跋前踕后，绝域无聊，独奈其命薄何？”一本作“跋前疐后”。"},"similar":["跋胡疐尾","跋前疐后"],"usage":"作谓语、定语；指进退维谷"},{"id":42468,"word":"跋前踬后","pinyin":"bá qián zhì hòu","abbr":"bqzh","explanation":"跋：踩；踬：被绊倒。本指狼向前进就踩住了自己的颈肉，向后退又会被自己的尾巴绊倒。比喻进退两难。","source":{"text":"《诗经·豳风·狼跋》：“狼跋其胡，载疐其尾。”唐·韩愈《昌黎集·卷十二·近学解》：“然而公不见信于人，私不见助于友。跋前踬后，动辄得咎”。"},"example":{"text":"无事之时，望影藏匿，～，日不聊生。","book":"清·纪昀《阅微草堂笔记·滦阳续录"},"similar":["进退维谷","进退两难","左右为难"],"usage":"作谓语；比喻进退两难"},{"id":42469,"word":"跋履山川","pinyin":"bá lǚ shān chuān","abbr":"blsc","explanation":"形容远道奔波之苦。参见“跋山涉水”。","source":{"text":"文公躬擐甲胄，，逾越险阻，征东之诸之侯。","book":"《左传·成公十三年》"},"example":{"text":"夫齐之去周二千余里，而使其已化之骨，～，触冒寒暑，自东徂西，以葬于封守之外，于死者为不仁。”","book":"清·顾炎武《日知录·太公五世反葬于周》"},"similar":["跋山涉水"],"usage":"作谓语、宾语；指长途旅行"},{"id":42470,"word":"跋山涉川","pinyin":"bá shān shè chuān","abbr":"bssc","explanation":"形容远道奔波之苦。参见“跋山涉水”。","source":{"text":"大夫跋涉，我心则忧。","book":"《诗经·鄘风·载驰》"},"example":{"text":"～任敢辞于艰险。","book":"宋·吴曾《能改斋漫录·龙尾道》"},"similar":["跋山涉水"],"usage":"作谓语、宾语、定语；形容旅途生活"},{"id":42471,"word":"跋山涉水","pinyin":"bá shān shè shuǐ","abbr":"bsss","explanation":"跋山：翻过山岭；涉水：用脚趟着水渡过大河。翻山越岭，趟水过河。形容走远路的艰苦。","source":{"text":"跋山涉水，蒙犯霜露。","book":"《诗经·鄘风·载驰》：“大夫跋涉，我心则忧。”《左传·襄公二十八年》"},"example":{"text":"同样的青春，同样的年龄，有人～，为改变祖国一穷二白的面貌而感到莫大的幸福。","book":"魏巍《路标》"},"similar":["翻山越岭","风尘仆仆"],"opposite":["朝发夕至","一路顺风"],"usage":"作谓语、状语；用于翻山过海走长路"},{"id":42472,"word":"跋扈恣睢","pinyin":"bá hù zì suī","abbr":"bhzs","explanation":"指专横强暴，为所欲为。","source":{"text":"参见“跋扈自恣”。"},"example":{"text":"特别是进入残酷卑鄙的剥削阶级最上层的统治生活之后，早已经陶冶出一副狠毒乖戾，～的性格。","book":"秦牧《长街灯语·逛东陵》"},"similar":["跋扈自恣"],"usage":"作谓语、定语；指人很专横"},{"id":42473,"word":"跋扈自恣","pinyin":"bá hù zì zì","abbr":"bhzz","explanation":"形容为所欲为，无所忌惮。","source":{"text":"于是长昂益跋扈自恣，东勾土蛮，西结婚白洪大，以扰诸边。","book":"《明史·朵颜传》"},"example":{"text":"缘道设关隘，垄断公私。涡河、浍、颖之间，～。","book":"《清史稿·袁甲三传》"},"similar":["骄横跋扈","为所欲为"],"usage":"作谓语、定语；形容人专横强暴"},{"id":42474,"word":"跋扈飞扬","pinyin":"bá hù fēi yáng","abbr":"bhfy","explanation":"指骄横放肆。","source":{"text":"百姓以安平无事之时，而未免流离饿莩；四夷以衰弱仅存之势，而犹能跋扈飞扬。","book":"宋·王安石《辞拜相表》"},"example":{"text":"纵容军人，使他们～、横暴无耻的，不正是日本资本家吗？郭沫若《归去来·到浦东去来》"},"similar":["飞扬跋扈"],"opposite":["平易近人"],"usage":"作谓语、定语、宾语；形容人很骄横"},{"id":42475,"word":"跋来报往","pinyin":"bá lái fù wǎng","abbr":"blbw","explanation":"匆匆地跑来跑去。跋，通“拔”。","source":{"text":"报读为赴疾之赴，拨、赴皆疾也。","book":"语出《礼记·少仪》：“毋拔来，毋报往。”郑玄注"},"example":{"text":"一众乡人，～的来领吃。","book":"《情变》第一回"},"similar":["拔来报往"],"usage":"作谓语、状语；指来往"},{"id":42476,"word":"跋涉山川","pinyin":"bá shè shān chuān","abbr":"bssc","explanation":"形容远道奔波之苦。参见“跋山涉水”。","source":{"text":"必使而君弃而封守，跋涉山川，蒙犯霜露，以逞君心。","book":"《左传·襄公二十八年》"},"example":{"text":"每岁十一月，天下贡举人于含元殿前，见四方馆舍人当直者，宣曰：“卿等学富雄词，远随乡荐，～，当甚劳止。”","book":"宋·钱易《南部新书》丙"},"similar":["跋山涉川"],"usage":"作谓语、定语；指旅途"},{"id":42477,"word":"跋涉长途","pinyin":"bá shè cháng tú","abbr":"bsct","explanation":"跋涉：登山涉水。指远距离的翻山渡水。形容走长路的艰辛。","source":{"text":"救我等于虎口之中，又不惮跋涉长途，送我们至万国通商文明之地。","book":"清·李宝嘉《文明小史》第12回"},"similar":["长途跋涉"],"usage":"作谓语、宾语；指远距离奔走"},{"id":42478,"word":"跋胡疐尾","pinyin":"bá hú zhì wěi","abbr":"bhzw","explanation":"比喻进退两难。","source":{"text":"狼跋其胡，载疐其尾。","book":"《诗·豳风·狼跋》"},"example":{"text":"惟信古太过，而欲为曲突徙薪之谋，故与物多违而每致～之患。","book":"宋·李纲《谢复观文殿大学士表》"},"similar":["跋前疐后","进退两难"],"usage":"作谓语、定语；指进退维谷"},{"id":42479,"word":"跋胡痜尾","pinyin":"bá hú zhì wěi","abbr":"bhzw","explanation":"比喻进退两难。","source":{"text":"狼跋其胡，载痜其尾。","book":"《诗·豳风·狼跋》"},"quote":{"text":"惟信古太过，而欲为曲突徙薪之谋，故与物多违而每致～之患。","book":"宋·李纲《谢复观文殿大学士表》"}},{"id":42480,"word":"跌宕不拘","pinyin":"diē dàng bù jū","abbr":"ddbj","explanation":"跌宕：放纵无拘束；拘：束缚。心志放逸无拘无束。","example":{"text":"他就是～的性格。"},"similar":["跌宕不羁","跌荡不羁"],"usage":"作谓语、定语；比喻不受拘束"},{"id":42481,"word":"跌宕不羁","pinyin":"dié dàng bù jī","abbr":"ddbj","explanation":"跌宕：放纵无拘束；羁：马笼头，比喻束缚。心志放逸无拘无束。","source":{"text":"殿试第三人，跌宕不羁，傲侮一世。","book":"宋·周密《齐东野语·王迈潘妨》"},"example":{"text":"毓蓍，字元趾，会稽人。为诸生，～。","book":"《明史·王毓蓍传》"},"similar":["跌宕放言","跌荡不羁"],"opposite":["谨小慎微","循规蹈矩"],"usage":"作谓语、定语；比喻不受拘束"},{"id":42482,"word":"跌宕放言","pinyin":"diē dàng fàng yán","abbr":"ddfy","explanation":"跌宕：放纵不拘；放言：任性而言，不受拘束。行为放纵，言语不拘。","source":{"text":"又与前与白衣祢衡跌宕放言。","book":"南朝·宋·范晔《后汉书·孔融传》"},"similar":["跌荡放言"],"usage":"作谓语、定语；用于为人"},{"id":42483,"word":"跌宕昭彰","pinyin":"dié dàng zhāo zhāng","abbr":"ddzz","explanation":"跌宕：放纵不拘；昭彰：昭著，明显。指气势放纵不拘，文意显明。","source":{"text":"其文章不群，辞彩精拔，跌宕昭彰，独超众类。","book":"南朝·梁·萧统《序》"},"example":{"text":"先生则波澜益壮，～。","book":"清·曾国藩《邓湘皋先生墓表》"},"usage":"作谓语、定语；用于作文"},{"id":42484,"word":"跌宕遒丽","pinyin":"diē dàng qiú lì","abbr":"ddql","explanation":"跌宕：放纵不拘；遒：刚劲。形容文辞、书法粗放，不拘谨，刚劲逸丽。","source":{"text":"植之，道光十九年举人，能经，以诗鸣，世臣尤称其书。谓跌宕遒丽，煅炼旧搨，血脉精气，奔赴腕下，熙载未之敢先。","book":"《清史稿·梅植之传》"},"usage":"作谓语、定语、宾语；用于书法等"},{"id":42485,"word":"跌宕风流","pinyin":"diē dàng fēng liú","abbr":"ddfl","explanation":"潇洒放逸而富有才华风情。","source":{"text":"诸君子跌宕风流，自是佳话。","book":"清·纪昀《阅微草堂笔记·滦阳续录二》"},"example":{"text":"羽侯道：‘～，我要贺三钟哩。’","book":"《花月痕》第四三回"},"similar":["跌荡风流"],"usage":"作谓语、定语；用于形容人"},{"id":42486,"word":"跌弹斑鸠","pinyin":"diē dàn bān jiū","abbr":"ddbj","explanation":"指中弹落地的斑鸠。喻指失意落寞或受挫神伤的人。"},{"id":42487,"word":"跌打损伤","pinyin":"diē dǎ sǔn shāng","abbr":"ddss","explanation":"泛指人因跌、打、磕、碰等原因而受的伤。","source":{"text":"老夫于歧黄虽不深知，向来祖上传有济世良方，凡跌打损伤，立时起死回生。","book":"清·李汝珍《镜花缘》第29回"},"example":{"text":"这药主治～。"},"usage":"作主语、宾语；指外伤"},{"id":42488,"word":"跌磕蹭蹬","pinyin":"diē kē cèng dèng","abbr":"dkcd","explanation":"跌：跌到；磕：磕碰；蹭蹬：路途险阻难行。指人倒霉，不顺利。","example":{"text":"人生难免会有～的时候。"},"similar":["磕磕碰碰"],"usage":"作谓语、宾语、定语；指人的境遇"},{"id":42489,"word":"跌脚拌手","pinyin":"diē jiǎo bàn shǒu","abbr":"djbs","explanation":"受到阻碍或牵制，不能放手去干事。","source":{"text":"自从第一步踏上了社会的战线，只觉得面前跌脚拌手的布满了敌军，第二步再也跨不出去。","book":"曾朴《孽海花》第28回"},"similar":["跌脚绊手"],"usage":"作定语、状语；用于处事等"},{"id":42490,"word":"跌脚捶胸","pinyin":"diē jiǎo chuí xiōng","abbr":"djcx","explanation":"以足跺地，以拳敲胸。表示气愤、着急、悲痛等感情。","source":{"text":"我这里牵肠割肚把你个孩儿舍，跌脚捶胸，自叹嗟。","book":"元·关汉卿《五侯宴》第二折"},"example":{"text":"赵六老～，哭了一回。","book":"《初刻拍案惊奇》卷十三"},"similar":["顿足捶胸"],"usage":"作谓语、状语；指悲伤"},{"id":42491,"word":"跌脚搥胸","pinyin":"diē jiǎo chuī xiōng","abbr":"djcx","explanation":"以足跺地，以拳敲胸。表示气愤、着急、悲痛等感情。"},{"id":42492,"word":"跌脚槌胸","pinyin":"diē jiǎo chuí xiōng","abbr":"djcx","explanation":"以足跺地，以拳敲胸。表示气愤、着急、悲痛等感情。","source":{"text":"众人跌脚槌胸，好似掀翻了鸡窠，弄出许多慌来。","book":"《水浒传》第一○四回"},"similar":["跌脚捶胸"],"usage":"作谓语、状语；指悲伤"},{"id":42493,"word":"跌脚绊手","pinyin":"diē jiǎo bàn shǒu","abbr":"djbs","explanation":"指受到阻碍或牵制。","source":{"text":"自从第一步踏上了社会的战线，只觉得面前跌脚绊手的布满了敌军，第二步再也跨不出。","book":"《孽海花》第二八回"},"example":{"text":"虽然有人从中协调，我依然感觉到～的。"},"similar":["跌脚拌手"],"usage":"作宾语、定语、状语；用于处事等"},{"id":42494,"word":"跌荡不拘","pinyin":"diē dàng bù jū","abbr":"ddbj","explanation":"指心志放逸无拘无束。同“跌宕不羁”。","source":{"text":"八月，宋主杀中书令王僧达，僧达幼聪警能文，而跌荡不拘。","book":"明·袁黄、王世贞《纲鉴合编·宋纪·武帝》"},"similar":["跌荡不羁","跌宕不拘"],"usage":"作谓语、定语；比喻不受拘束"},{"id":42495,"word":"跌荡不羁","pinyin":"diē dàng bù jī","abbr":"ddbj","explanation":"指心志放逸无拘无束。同“跌宕不羁”。","source":{"text":"遂入馆，然跌荡不羁，剧饮尚气节，视天下无复难事，不为小廉曲谨以投苟合。","book":"《宣和书谱·石延年》"},"similar":["跌荡不拘","跌宕不拘"],"usage":"作谓语、定语；比喻不受拘束"},{"id":42496,"word":"跌荡放言","pinyin":"diē dàng fàng yán","abbr":"ddfy","explanation":"跌荡：放纵不拘；放：粗放，豪放。行为放纵，语言豪放。","source":{"text":"又前与白衣祢衡跌荡放言。","book":"《后汉书·孔融传》"}},{"id":42497,"word":"跌荡风流","pinyin":"diē dàng fēng liú","abbr":"ddfl","explanation":"潇洒放逸而富有才华风情。同“跌宕风流”。","source":{"text":"白门娟娟静美，跌荡风流，能度曲，善画兰。","book":"清·余怀《板桥杂记·珠市名妓附见》"},"similar":["跌宕风流"],"usage":"作谓语、定语；用于形容人"},{"id":42498,"word":"跌跌撞撞","pinyin":"diē diē zhuàng zhuàng","abbr":"ddzz","explanation":"形容走路不稳的样子。","source":{"text":"脚底下不晓得高低，跌跌撞撞，进了右首房间。","book":"清·韩邦庆《海上花列传》第42回"},"example":{"text":"他～地走了过来。"},"similar":["踉踉跄跄","磕磕碰碰"],"opposite":["顺顺利利","一帆风顺"],"usage":"作状语；指不顺畅"},{"id":42499,"word":"跌跌滚滚","pinyin":"diē diē gǔn gǔn","abbr":"ddgg","explanation":"跌交打滚的样子。","example":{"text":"猪八戒～地来到孙悟空面前讨好求饶。"},"usage":"作谓语、定语、状语；用于处事等"},{"id":42500,"word":"跌跌爬爬","pinyin":"diē diē pá pá","abbr":"ddpp","explanation":"连跌带爬。","source":{"text":"蓦然抬头见了主人，猛吃大惊，跌跌爬爬，一哄四散。","book":"清·韩邦庆《海上花列传》第51回"},"example":{"text":"他～地回到了家。"},"similar":["连跌带爬","跌跌撞撞"],"usage":"作谓语、定语、状语；用于处事等"}]
