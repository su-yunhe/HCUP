+[{"id":7501,"word":"兵挫地削","pinyin":"bīng cuò dì xuē","abbr":"bcdx","explanation":"挫：失败；削：割。军队战败，土地被分割。","source":{"text":"疏屈平而信上官大夫，令尹子兰，兵挫地削，亡其六郡。","book":"《史记·屈原贾生列传》"}},{"id":7502,"word":"兵无常势","pinyin":"bīng wú cháng shì","abbr":"bwcs","explanation":"常：不变；势：形势。用兵无一成不变的形势。用以说明办事要因时、因地制宜，具体问题要用具体办法去解决。","source":{"text":"夫兵形象水，水之形，避高而趋下；兵之形，避实而击虚。水因地而制流，兵因敌而制胜。故兵无常势，水无常形；能因敌变化而取胜者，谓之神。","book":"春秋·齐·孙武《孙子·虚实》"},"example":{"text":"～，我们要灵活机动随时改变战略方针。"},"similar":["兵无常形"],"usage":"作宾语、定语；指具体问题具体对待","story":["春秋时期，孙武把自己的用兵方法写成一部书《孙子兵法》，他的名言为“夫兵形象水，水之形，避高而趋下；兵之形，避实而击虚。水因地而制流，兵因敌而制胜。故兵无常势，水无常形；能因敌变化而取胜者，谓之神。”"]},{"id":7503,"word":"兵无常形","pinyin":"bīng wú cháng xíng","abbr":"bwcx","explanation":"用兵无一成不变的形势。指办事要因时、因地制宜，具体问题要用具体办法去解决。","source":{"text":"兵无常形，以诡诈为道。","book":"《孙子·计》“兵者，诡道也”三国·魏·曹操注"},"similar":["兵无常势"],"usage":"作宾语、定语；指具体问题具体对待"},{"id":7504,"word":"兵无斗志","pinyin":"bīng wú dòu zhì","abbr":"bwdz","explanation":"士兵缺乏作战的决心和勇气。","example":{"text":"敌人的队伍～，一触即溃。"},"opposite":["斗志昂扬"],"usage":"作宾语、定语；用于军事或团体士气"},{"id":7505,"word":"兵无血刃","pinyin":"bīng wú xuè rèn","abbr":"bwxr","explanation":"指战事顺利，未经交锋或激战而取得胜利。","source":{"text":"昭王以纬世之量。为群雄扬奉，兵无血刃，遂启霸业，乃修敦煌旧塞。","book":"《北史·序传·凉武昭王李暠》"},"example":{"text":"制胜以谋，～。","book":"唐·陆贽《诛李怀光后原宥河中将吏并招谕淮西诏》"},"similar":["兵不血刃","兵未血刃","兵不接刃"],"opposite":["血流成河"],"usage":"作定语、状语；形容未经交战就取得胜利"},{"id":7506,"word":"兵未血刃","pinyin":"bīng wèi xuě rèn","abbr":"bwxr","explanation":"犹兵不血刃。指战事顺利，未经交锋或激战而取得胜利。","source":{"text":"高適是肃宗所任命的统帅，永王为地方兵力所击败身死之后，高適兵未血刃而罢。","book":"郭沫若《李白与杜甫·杜甫与严武》"},"similar":["兵不污刃","兵不血刃"],"opposite":["血流成河"],"usage":"作定语、状语；形容未经交战就取得胜利"},{"id":7507,"word":"兵来将挡，水来土掩","pinyin":"bīng lái jiàng dǎng，shuǐ lái tǔ yǎn","abbr":"bljdslty","explanation":"指根据具体情况，采取灵活的对付办法。","source":{"text":"主公，便好这兵来将挡，水来土掩。","book":"元·无名氏《大战邳彤》"},"example":{"text":"常言道：“～”，事到其间，道在人为。少不得你我打点礼物，早差人上东京，央及老爷那里去。","book":"《金瓶梅词话》第四十八回"},"similar":["兵来将敌，水来土堰"],"opposite":["束手无策"],"usage":"作主语、定语、分句；指根据具体情况处理"},{"id":7508,"word":"兵来将敌，水来土堰","pinyin":"bīng lái jiàng dí，shuǐ lái tǔ yàn","abbr":"bljdslty","explanation":"指根据具体情况，采取灵活的对付办法。","source":{"text":"兵来将敌，水来土堰，兄弟也，你领兵就随着我来，不可延迟也。","book":"元·无名氏《云台门》第一折"},"similar":["兵来将挡，水来土掩"],"usage":"作宾语、定语、分句；指根据具体情况对付"},{"id":7509,"word":"兵来将迎，水来土堰","pinyin":"bīng lái jiàng yíng，shuǐ lái tǔ yàn","abbr":"bljyslty","explanation":"指根据具体情况，采取灵活的对付办法。","source":{"text":"自古道兵来将迎，水来土堰，他若领兵前来，俺这里领兵与他交锋。","book":"元·高文秀《渑池会》楔子"},"similar":["兵来将敌，水来土堰"],"usage":"作宾语、定语、分句；指根据具体情况对付"},{"id":7510,"word":"兵燹之祸","pinyin":"bīng xiǎn zhī huò","abbr":"bxzh","explanation":"兵燹：战乱所造成的破坏。指因战乱而遭受焚烧破坏的灾祸。","source":{"text":"诏岷州界经鬼章兵燹者赐钱。","book":"《宋史·神宗纪二》"}},{"id":7511,"word":"兵犹火也，不戢自焚","pinyin":"bīng yóu huǒ yě，bù jí zì fén","abbr":"byhybjzf","explanation":"戢：停止。战争就象玩火，不在适当情况下及时止息，就会把自己烧掉。","source":{"text":"夫兵，犹火也，弗戢，将自焚也。","book":"《左传·隐公四年》"},"example":{"text":"～，古人之所以三致意者在此。","book":"蔡东藩、许廑父《民国通俗演义》第十四回"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7512,"word":"兵疲意阻","pinyin":"bīng pí yì zǔ","abbr":"bpyz","explanation":"疲：劳累，懈怠；意阻：情绪低落沮丧。士兵劳累懈怠，将帅情绪低落沮丧。","source":{"text":"诸公不知兵法，备乃世之枭雄，更多智谋，其兵始集，法度精专，今守之久矣，不得我便，兵疲意阻，取之正在今日。","book":"明·罗贯中《三国演义》第八十四回"}},{"id":7513,"word":"兵相骀藉","pinyin":"bīng xiāng tái jí","abbr":"bxdj","explanation":"骀藉：践踏。军队在混乱中互相践踏。","source":{"text":"兵相骀藉，不可胜数。","book":"《史记·天官书》"}},{"id":7514,"word":"兵精粮足","pinyin":"bīng jīng liáng zú","abbr":"bjlz","explanation":"兵士精壮，粮草充足。形容军力强盛，战备充分。","source":{"text":"今江东兵精粮足，且有长江之险。","book":"明·罗贯中《三国演义》第四十三回"},"example":{"text":"他久镇河北，～，自立旗号，不服隋朝所管。","book":"清·无名氏《说唐》第二十回"},"opposite":["弹尽粮绝"],"usage":"作谓语、宾语、定语；形容军队十分强盛"},{"id":7515,"word":"兵老将骄","pinyin":"bīng lǎo jiàng jiāo","abbr":"bljj","explanation":"老：衰。士兵疲惫，将领骄傲。","source":{"text":"我想子胥深入敌境，兵老将骄，可不战而破。","book":"元·郑廷玉《楚昭王》第四折"},"usage":"作宾语、定语；指战争已经很久"},{"id":7516,"word":"兵荒马乱","pinyin":"bīng huāng mǎ luàn","abbr":"bhml","explanation":"荒、乱：指社会秩序不安定。形容战争期间社会混乱不安的景象。","source":{"text":"那兵荒马乱，定然遭驱被掳。","book":"元·无名氏《梧桐叶》第四折"},"example":{"text":"此时四处～，朝秦暮楚，我勉强做了一部《旧唐书》，那里还有闲情逸致弄这笔墨。”","book":"清·李汝珍《镜花缘》第一回"},"similar":["兵连祸结","内忧外患","鸡犬不宁"],"opposite":["太平盛世","天下太平","国泰民安"],"usage":"作谓语、定语；形容战争时期，社会动荡不安","story":["春秋时期，孔子带领弟子们周游列国，在陈国闲居等待封官。吴王夫差灭了越国后，势力强大，带领披发左衽的吴兵乘机攻打陈国，陈君连夜潜逃，孔子还是按计划去主持祭祀仪式，外面兵荒马乱，乐工继续奏乐，弟子们强拉他上车，逃出陈国前往蔡国"]},{"id":7517,"word":"兵藏武库，马入华山","pinyin":"bīng cáng wǔ kù，mǎ rù huà shān","abbr":"bcwkmrhs","explanation":"兵器藏进武库，军马放入华山。指天下太平。","source":{"text":"当今鹿台已散，离宫已遗，兵藏武库，马入华山。","book":"北周·庚信《贺平邺都表》"},"similar":["刀枪入库，马放南山"],"usage":"作宾语、定语；指天下太平"},{"id":7518,"word":"兵行诡道","pinyin":"bīng xíng guǐ dào","abbr":"bxgd","explanation":"兵：用兵；行：使用；诡：欺诈；道：方法。用兵可以运用诡异和诈伪的战法。","source":{"text":"兵者，诡道也。","book":"春秋·齐·孙武《孙子·计》"},"example":{"text":"高太尉道：‘非也！自古兵书有云：～。岂可用得正大？’","book":"明·施耐庵《水浒传》第79回"},"similar":["兵不厌诈"],"usage":"作宾语、定语、分句；指使用诡计来打仗"},{"id":7519,"word":"兵败如山倒","pinyin":"bīng bài rú shān dǎo","abbr":"bbrsd","explanation":"兵：军队。形容军队溃败就像山倒塌一样，一败涂地。","source":{"text":"由于主将首先逃走，江西全线孙（传芳）军俄然出现了兵败如山倒的局面。","book":"陶菊隐《北洋军阀统治时期史话》第73章"},"example":{"text":"～，你已经没有挽回的余地了。"},"similar":["一败涂地"],"usage":"作宾语、定语、分句；指失败"},{"id":7520,"word":"兵败将亡","pinyin":"bīng bài jiàng wáng","abbr":"bbjw","explanation":"兵：军队。军队打败仗，将官阵亡。形容作战失败。","example":{"text":"趁还没有～的时候，我们赶快改变战术。"},"opposite":["出师大捷"],"usage":"作宾语、定语、状语；指失败"},{"id":7521,"word":"兵贵先声","pinyin":"bīng guì xiān shēng","abbr":"bgxs","explanation":"指用兵贵在先以自己的声势镇慑敌人。","source":{"text":"兵固有先声而后实者，此之谓也。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"况～。今发半天下之兵属王，安危成败，在百日之内，何可轻以为寻常！","book":"唐·卢藏用《陈子昂别传》"},"similar":["先声夺人"],"usage":"作谓语；用于军事方面"},{"id":7522,"word":"兵贵神速","pinyin":"bīng guì shén sù","abbr":"bgss","explanation":"神速：特别迅速。用兵贵在行动特别迅速。","source":{"text":"太祖将征袁尚及三郡乌丸。……嘉言曰：‘兵贵神速。’","book":"《孙子·九地》：“兵之情主速。”《三国志·魏书·郭嘉传》"},"example":{"text":"～，今夜分四路去劫大寨，杀得他只轮不返。","book":"清·陈忱《水浒后传》第七回"},"similar":["速战速决","事不宜迟"],"opposite":["犹豫不决","优柔寡断"],"usage":"作谓语、宾语、定语；用于军事等","story":["东汉末年，天下大乱，曹操在官渡之战消灭了袁绍。袁绍的儿子袁熙、袁尚带领残部投奔北方的单于蹋顿。曹操为尽早巩固北方，采纳郭嘉的建议，亲率精兵日夜兼程、出其不意地消灭蹋顿的部队。袁熙兄弟被辽东太守公孙康所杀"]},{"id":7523,"word":"兵车之会","pinyin":"bīng chē zhī huì","abbr":"bczh","explanation":"春秋时齐桓公争霸，屡次与诸侯会盟，其中在鲁僖公年间的四次，齐国带有军队，你为“兵车之会”。","source":{"text":"请君以兵车之会往宋。","book":"《公羊传·僖公二十一年》"},"example":{"text":"寡人用～三，衣裳之会六，九合诸侯，一匡天下。","book":"明·冯梦龙《东周列国志》第二十四回"},"usage":"作宾语；指武装会盟"},{"id":7524,"word":"兵连祸接","pinyin":"bīng lián huò jiē","abbr":"blhj","explanation":"指战事、灾祸连续不断。","source":{"text":"数年以来，闽、粤、湘生民涂炭，曹吴二贼，实为祸首，近复启衅浙奉，兵连祸接，本大元帅已明令诸将出师北伐。","book":"孙中山《诰诫东江叛军通令》"},"similar":["兵连祸结","兵连祸深"],"opposite":["国泰民安"],"usage":"作谓语、定语、分句；用于持久的战争"},{"id":7525,"word":"兵连祸深","pinyin":"bīng lián huò shēn","abbr":"blhs","explanation":"兵：指战争。战争连年不断，灾祸持续相结。","source":{"text":"兵连祸深，变起都邑，六师播荡，九服震惊。","book":"唐·陆贽《冬至大礼大赦制》"},"similar":["兵连祸结","兵连祸接"],"opposite":["国泰民安"],"usage":"作谓语、定语、分句；用于持久的战争"},{"id":7526,"word":"兵连祸结","pinyin":"bīng lián huò jié","abbr":"blhj","explanation":"兵：战争；连：接连；结：相联。战争接连不断，带来了无穷的灾祸。","source":{"text":"虽有克获之功，胡辄报之，兵连祸结，三十余年。","book":"《汉书·匈奴传》"},"example":{"text":"～，涂炭平民，耗损国内，悔之晚矣。","book":"明·刘基《前江淮都转运盐使宋公政绩纪》"},"similar":["兵荒马乱","内忧外患","天下大乱"],"opposite":["安居乐业","物阜民丰","国泰民安"],"usage":"作谓语、定语、分句；用于持久的战争"},{"id":7527,"word":"兵销革偃","pinyin":"bīng xiāo gé yǎn","abbr":"bxgy","explanation":"销毁兵器，放下甲盾。指太平无战事。","source":{"text":"垂回凶度厄之慈，开辍死上生之路，使一境之兵销革偃，四时之雨顺风调。","book":"前蜀·杜光庭《本命醮南斗词》"},"usage":"作宾语、定语；指天下太平"},{"id":7528,"word":"兵闻拙速","pinyin":"bīng wén zhuō sù","abbr":"bwzs","explanation":"指用兵打仗当求速胜而不计战法的巧拙。","source":{"text":"故兵闻拙速，未睹巧之久也。","book":"《孙子·作战》"},"example":{"text":"足下若能卷甲电赴，犹或有济；若其狐疑，求我枯鱼之肆矣。～，未睹工迟。","book":"《晋书·闵王承传》"},"usage":"作宾语、定语；指作战策略"},{"id":7529,"word":"兵革之祸","pinyin":"bīng gé zhī huò","abbr":"bgzh","explanation":"兵革：兵器战甲，引申为战争。指发生战争。","source":{"text":"将有急怒之谋，以生兵革之祸。","book":"东汉·班固《汉书·五行志中之下》"},"usage":"作宾语；指战争"},{"id":7530,"word":"兵革互兴","pinyin":"bīng gé hù xīng","abbr":"bghx","explanation":"兵革：兵器衣甲，比喻战争；兴：发起，发动。互相发动战争，战乱相继发生。形容时局不安定，战乱频繁。","source":{"text":"春秋迄于战国，战国至于秦时，攻争纷乱，兵革互兴。","book":"南朝·梁·江淹《铜剑赞序》"}},{"id":7531,"word":"兵革满道","pinyin":"bīng gé mǎn dào","abbr":"bgmd","explanation":"兵：兵器；革：甲胄。战乱中军用的武器装备散乱地遗弃，塞满了道路。形容战祸伤亡惨重。","source":{"text":"六国亡时，秦汉之际，诸侯相伐，兵革满道。","book":"汉·王充《论衡·寒温》"},"usage":"作谓语、定语；指战乱"},{"id":7532,"word":"兵马不动，粮草先行","pinyin":"bīng mǎ bù dòng，liáng cǎo xiān xíng","abbr":"bmbdlcxx","explanation":"作战时兵马还没出动，军用粮草的运输要先行一步。后泛指行动前须作好准备工作。","source":{"text":"兵马不动，粮草先行。年年防歉，夜夜防贼。","book":"《南皮县志·风土志下·歌谣》"}},{"id":7533,"word":"兵马未动，粮草先行","pinyin":"bīng mǎ wèi dòng，liáng cǎo xiān xíng","abbr":"bmwdlcxx","explanation":"指出兵之前，先准备好粮食和草料。比喻在做某件事情之前，提前做好准备工作。","source":{"text":"兵马未动，粮草先行”，这是自古以来用兵的老规矩，你们没有粮食怎么走这么远的路！","book":"林占财《森林中的远征》：“他很同情地说道：‘是的"},"example":{"text":"～！千万人民除了保证前线军需弹药粮草的供应处，还不顾一切艰苦，热情地转运与看护伤员。","book":"张震《英明的预见，正确的战役方针》"},"usage":"作宾语、分句；指提前做好准备"},{"id":7534,"word":"兵骄将傲","pinyin":"bīng jīng jiàng ào","abbr":"bjja","explanation":"骄：骄纵；傲：傲慢。士兵骄纵，将官傲慢。","source":{"text":"高傑镇守扬、通，兵骄将傲，那黄、刘三镇，每发不平之恨。","book":"清·孔尚任《桃花扇·争位》"}},{"id":7535,"word":"其乐不穷","pinyin":"qí lè bù qióng","abbr":"qlbq","explanation":"其中的乐趣没有穷尽。指进行某一工作，感到乐在其中。","source":{"text":"故玄之所在，其乐不穷","book":"晋·葛洪《抱朴子·畅玄》"},"example":{"text":"脱衣服，浴凉风，～，这叫作‘席卷天下’。","book":"鲁迅《花边文学·安贫乐道法》"},"similar":["其乐无穷"],"usage":"作谓语；指十分有趣"},{"id":7536,"word":"其乐无涯","pinyin":"qí lè wú yá","abbr":"qlwy","explanation":"其中的乐趣没有穷尽。指进行某一工作，感到乐在其中。","source":{"text":"故玄之所在，其乐不穷。","book":"《抱扑子·畅玄》"},"example":{"text":"早子收心波竹杖芒鞋，游山玩水，吟风弄月，～。","book":"元·张养浩《普天乐》曲"}},{"id":7537,"word":"其乐无穷","pinyin":"qí lè wú qióng","abbr":"qlwq","explanation":"其中的乐趣没有穷尽。指进行某一工作，感到乐在其中。","source":{"text":"家给人足时和岁丰；筋骸康健，里闬乐从；君子饮酒，其乐无穷。","book":"《抱扑子·畅玄》：“故玄之所在，其乐不穷。”宋·邵雍《伊川击壤集·君子饮酒吟》"},"example":{"text":"穷人却挟了一条破席，铺在路上，脱衣服，浴凉风，～。","book":"鲁迅《花边文学·安贫乐道法》"},"similar":["乐不可支","大喜过望"],"opposite":["痛不欲生","悲不自胜"],"usage":"作谓语、定语、状语；指十分有趣"},{"id":7538,"word":"其乐融融","pinyin":"qí lè róng róng","abbr":"qlrr","explanation":"其：代词，其中的；融融：和乐的样子。形容十分欢乐、和睦。","source":{"text":"公入而赋：‘大隧之中，其乐也融融。’","book":"《左传·隐公元年》"},"example":{"text":"尽管家人极力制造天伦之乐、～的氛围，蒋介石却怎么也笑不起来。","book":"马辂《国共和谈演义》第三部第十五回"},"usage":"作谓语；用于欢乐时"},{"id":7539,"word":"其势汹汹","pinyin":"qí shì xiōng xiōng","abbr":"qsxx","explanation":"汹汹：形容水声大，引申为声势大。形容来势凶猛。","source":{"text":"君子不为小人之汹汹也辍其行。","book":"《荀子·天论》"},"example":{"text":"有的～走来干涉我们，问我们是什么机关；有的更不管三七二十一，拿着枪托子去撞各家人家的门。","book":"郭沫若《洪波曲》第十五章"},"similar":["气势汹汹","威风凛凛"],"opposite":["和颜悦色","心平气和"],"usage":"作谓语、定语、状语；用于人"},{"id":7540,"word":"其味无穷","pinyin":"qí wèi wú qióng","abbr":"qwwq","explanation":"其中的味道没有穷尽。形容含义深刻，使人回味不尽。","source":{"text":"放之则弥六合，卷之则退藏于密，其味无穷，皆实学也。","book":"宋·朱熹《四书集注·中庸》"},"example":{"text":"学中斋长与那能言的秀才，多赴些“春茗候光”的厚扰，这就～了。（清·李绿园《歧路灯》第五回）"},"similar":["意味深长","回味无穷"],"opposite":["味同嚼蜡"],"usage":"作谓语、宾语；指使人回味不尽"},{"id":7541,"word":"其命维新","pinyin":"qí mìng wéi xīn","abbr":"qmwx","explanation":"命：天命；维：乃。指承受的天命是新的。比喻国运昌盛，气象一新。","source":{"text":"周虽旧邦，其命维新。","book":"《诗经·大雅·文王》"},"example":{"text":"若今之政府，则帝制自为也久矣，更安有所谓“～”者？","book":"清·章炳麟《论承用“维新”二字之荒谬》"},"usage":"作谓语；用于书面语"},{"id":7542,"word":"其奈我何","pinyin":"qí nài wǒ hé","abbr":"qnwh","explanation":"奈：如何。能把我怎么样？。","source":{"text":"夫寿夭者天也，先生其奈我何！","book":"《汉书·王莽传下》：“天生德于予，汉兵其如予何。”宋·李昉《太平广记·报应十六》"},"example":{"text":"我不自动辞职，总统～。","book":"陶菊隐《北洋军阀统治时期史话》第二十六章"},"usage":"作谓语、分句；用于疑问句"},{"id":7543,"word":"其应如响","pinyin":"qí yìng rú xiǎng","abbr":"qyrx","explanation":"比喻对答迅速，反应极快。","source":{"text":"如以匙勘钥也，如以玺印涂也，必以其类，其应如响。","book":"《子华子·晏子》"},"example":{"text":"王曰：‘寡人好世俗之乐。’孟子又曰：‘王之好乐甚，则齐国其庶几乎！’所谓～，其实阳开而阴翕之也。","book":"宋·陈善《扪虱新话·辨孟子言悦乐鼓乐之异》"},"similar":["其应若响"],"usage":"作谓语、宾语；指回声很大"},{"id":7544,"word":"其应若响","pinyin":"qí yìng ruò xiǎng","abbr":"qyrx","explanation":"比喻对答迅速，反应极快。","source":{"text":"其动若水，其静若镜，其应若响。","book":"《庄子·天下》"},"similar":["一呼百应","其应如响"],"usage":"作谓语、宾语；指回声很大"},{"id":7545,"word":"其来有自","pinyin":"qí lái yǒu zì","abbr":"qlyz","explanation":"自：从……出来的地方。指事情的发生、发展有其来由，并非偶然。","source":{"text":"诸侯之有冠礼也，有自来矣。","book":"《孔子家语·冠颂》"},"example":{"text":"岂知逾岁，遂离在忧，乃司尔日之悲，～。","book":"清·李慈铭《越缦堂诗话》卷上"},"usage":"作宾语、定语；用于书面语"},{"id":7546,"word":"其貌不扬","pinyin":"qí mào bù yáng","abbr":"qmby","explanation":"不扬：不好看。形容人容貌难看。","source":{"text":"尔才不长，尔貌不扬。","book":"《左传·昭公二十八年》：“今子少不扬，子若无言，吾几失子矣。”杜预注：“颜貌不显扬。”唐·裴度《自题写真赞》"},"example":{"text":"别看他～，可学习特别好。"},"similar":["贼眉鼠眼","獐头鼠目"],"opposite":["眉清目秀","一表人才"],"usage":"作谓语、定语；指人的长相","story":["公元866年，32岁的皮日休去京城长安考进士，由于他不愿奉承权贵，结果没考上。第二年他又进京应试，主考官礼部侍郎郑愚很欣赏他的文章，还没发榜就叫他到府上，见他其貌不扬，眼睛不对称就讥笑他，皮日休立即反唇相讥回敬"]},{"id":7547,"word":"其道亡繇","pinyin":"qí dào wáng yáo","abbr":"qdwy","explanation":"找不到门径；无法办到。亦作“其道无由”。","source":{"text":"虽后欲改过自新，其道亡繇也。","book":"东汉·班固《汉书·刑法志》"},"similar":["其道无由"],"usage":"作谓语、定语；用于处事"},{"id":7548,"word":"其道无由","pinyin":"qí dào wú yóu","abbr":"qdwy","explanation":"找不到门径；无法办到。同“其道亡繇”。","source":{"text":"因愚夫愚妇，识字知书者少，劝使为善，诫使勿恶，其道无由。","book":"清·李渔《闲情偶寄·词曲·结构》"},"similar":["其道亡繇"],"usage":"作谓语、定语；用于处事"},{"id":7549,"word":"其验如响","pinyin":"qí yàn rú xiǎng","abbr":"qyrx","explanation":"其：他的；验：效果，效验；响：回声。指效验立即可以看到。","source":{"text":"高行真人精练刚气之所化也。试之，其验如响。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录五》"},"usage":"作谓语、宾语；用于书面语"},{"id":7550,"word":"具一只眼","pinyin":"jù yī zhī yǎn","abbr":"jyzy","explanation":"指有独到的眼光和见解。","source":{"text":"僧云：‘若问某甲见处。和尚放下手中物。’师云：‘许你具一只眼。’","book":"宋·释道原《景德传灯录》卷八"},"example":{"text":"如此见，方许～。","book":"宋·严羽《沧浪诗话·诗评》"}},{"id":7551,"word":"具体而微","pinyin":"jù tǐ ér wēi","abbr":"jtew","explanation":"具体：各部分已大体具备；微：微小。指事物的各个组成部分大体都有了，不过形状和规模比较小些。","source":{"text":"冉牛、闵子、颜渊，则具体而微。","book":"《孟子·公孙丑上》"},"example":{"text":"所居有池五六亩，竹数千竿，乔木数十株，台榭舟桥，～。","book":"唐·白居易《醉吟先生传》"},"opposite":["硕大无朋"],"usage":"作宾语、定语；指内容大体都有"},{"id":7552,"word":"具瞻所归","pinyin":"jù zhān suǒ guī","abbr":"jzsg","explanation":"具：同“俱”，全；瞻：视；所归：所向。为众人所敬慕、瞻仰。","source":{"text":"三公，俱瞻所归，不可用非其人。","book":"《三国志·魏志·贾诩传》裴松之注引《荀勖别传》"},"example":{"text":"王位兼台辅，亲懿莫二，朝野属赖，～。","book":"《魏书·北海王传》"},"usage":"作谓语、定语；用于书面语"},{"id":7553,"word":"具自陈道","pinyin":"ju zhi cheng dao","abbr":"jzcd","explanation":"自己详尽地述说。"},{"id":7554,"word":"具食与乐","pinyin":"ju shi yu le","abbr":"jsyl","explanation":"备办了酒饭和歌舞。"},{"id":7555,"word":"典册高文","pinyin":"diǎn cè gāo wén","abbr":"dcgw","explanation":"指封建朝廷的重要文书、诏令。","source":{"text":"《五代史》：‘黄……。’则典册高文亦用之矣。","book":"清·梁绍壬《两般秋雨庵随笔》第二卷"},"example":{"text":"～的文物价值不可轻视。"},"similar":["高文典册"],"opposite":["断烂朝报"],"usage":"作主语、宾语；指文书"},{"id":7556,"word":"典则俊雅","pinyin":"diǎn zé jùn yǎ","abbr":"dzjy","explanation":"端庄高雅而标致。","source":{"text":"一切张罗款待，都是凤姐一人周全承应……[凤姐]洒爽风流，典则俊雅，真是‘万绿丛中一点红’了，——那里还把众人放在眼里，挥霍指示，任其所为。","book":"《红楼梦》第十四回"},"usage":"作谓语、定语；用于人或事物"},{"id":7557,"word":"典妻鬻子","pinyin":"diǎn qī yù zǐ","abbr":"dqyz","explanation":"典：典当；鬻：卖。典卖妻子。形容生活极其贫困。","source":{"text":"亩亩穷民何能堪此？势必倾家荡产，典妻鬻子以偿其用矣。","book":"清·黄六鸿《福惠全书·刑名·设便民房》"},"example":{"text":"旧社会穷苦人民只有～才能维持生活。"},"similar":["卖儿卖女"],"usage":"作谓语、定语；指生活极其困苦"},{"id":7558,"word":"典章文物","pinyin":"diǎn zhāng wén wù","abbr":"dzww","explanation":"指法令、礼乐、制度以及历代遗留下来的有价值的东西。","source":{"text":"幸而天历间虞集六典法，纂《经世大典》，一代典章文物粗备。","book":"《明史·文苑传·徐一夔》"},"example":{"text":"关于秦代的～，我也茫然无知，耳目所涉，也未知有专门的学者。","book":"鲁迅《书信·致姚克》"},"usage":"作宾语、定语；指文化遗产"},{"id":7559,"word":"典谟训诰","pinyin":"diǎn mó xùn gào","abbr":"dmxg","explanation":"①《尚书》中《尧典》、《大禹谟》、《汤诰》、《伊训》等篇的并称。②泛指经典之文。","source":{"text":"典谟训诰誓命之文，凡百篇。","book":"《书序》"},"example":{"text":"尧、舜、汤之道在～之间。","book":"唐·康骈《剧谈录·宣宗夜召翰林学士》"},"usage":"作主语、宾语、定语；指经典"},{"id":7560,"word":"典身卖命","pinyin":"diǎn shēn mài mìng","abbr":"dsmm","explanation":"典当身体，出卖性命。指奉献出自己的一切。","source":{"text":"就典身卖命，也酬谢师恩。","book":"明·吴承恩《西游记》第40回"},"example":{"text":"我不需要你“～”的承诺。"},"similar":["粉身碎骨"],"usage":"作谓语、定语；指不顾一切"},{"id":7561,"word":"兹事体大","pinyin":"zī shì tǐ dà","abbr":"zstd","explanation":"兹：此；体：体制，规模。这件事性质重要，关系重大。","source":{"text":"兹事体大而允，寤寐次于圣心。","book":"汉·班固《典引》"},"example":{"text":"然～，万一生意清淡，则影响于生计，故尚在彷徨中也。","book":"鲁迅《书信集·致台静农》"},"similar":["事关重大"],"usage":"作谓语、分句；指关系重大"},{"id":7562,"word":"养乱助变","pinyin":"yǎng luàn zhù biàn","abbr":"ylzb","explanation":"纵容和帮助动乱。","source":{"text":"天子曰：‘毋养乱，毋助变。","book":"宋·苏洵《张益州画像记》"}},{"id":7563,"word":"养儿代老，积谷防饥","pinyin":"yǎng ér dài lǎo，jī gǔ fáng jī","abbr":"yedljgfj","explanation":"指养育儿子以防老年无依靠，保存谷物为防备饥荒。同“养儿防老，积谷防饥”。","source":{"text":"［贴］爹爹，正是养儿代老，积谷防饥。","book":"元本高明《琵琶记·牛小姐谏父》"},"similar":["养儿待老，积谷防饥"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7564,"word":"养儿备老","pinyin":"yǎng ér bèi lǎo","abbr":"yebl","explanation":"养育儿子是为了防备自己年老时有人赡养。","source":{"text":"嫁夫恨不早，养儿将备老。","book":"唐书·张元稹《忆远曲》"}},{"id":7565,"word":"养儿待老，积谷防饥","pinyin":"yǎng ér dài lǎo，jī gǔ fáng jī","abbr":"yedljgfj","explanation":"指养育儿子以防老年无依靠，保存谷物为防备饥荒。同“养儿防老，积谷防饥”。","source":{"text":"养儿待老，积谷防饥。”你我年过四旬，尚无子嗣。光阴似箭，眨眼头白。百年之事，靠着何人？’","book":"明·冯梦龙《警世通言》第二十二卷：“宋敦一日对浑家说：‘自古道"},"example":{"text":"常言道：“～。”","book":"《平妖传》第十六回"},"similar":["养儿防老，积谷防饥"],"usage":"作宾语、定语、分句；可分开使用"},{"id":7566,"word":"养儿防老","pinyin":"yǎng ér fáng lǎo","abbr":"yefl","explanation":"养育儿子是为了防备年老。亦泛指养育子女以防老年无依靠。","source":{"text":"养儿防老，积谷防饥。","book":"宋·陈元靓《事林广记》"},"example":{"text":"～的观念应该改变了。"},"similar":["有备无患","积谷防饥","未雨绸缪"],"opposite":["养痈贻患","养虎遗患"],"usage":"作宾语、定语；常与“积谷防饥”连用"},{"id":7567,"word":"养儿防老，积谷防饥","pinyin":"yǎng ér fáng lǎo，jī gǔ fáng jī","abbr":"yefljgfj","explanation":"指养育儿子以防老年无依靠，保存谷物为防备饥荒。","source":{"text":"婺源詹惠明乞代父偿命，临刑无惧色，曰‘养儿防老，积谷防饥。’太守曾天游奏之，乃免死。","book":"《里语徴实》卷下引宋·左圭《百川学海》"},"example":{"text":"你对孩子一般儿爱，不问男的女的，大的小的，也不想到什么：‘～’，只拼命的爱去。","book":"朱自清《给亡妇》"},"similar":["养儿待老，积谷防饥"],"usage":"作宾语、定语、分句；可分开使用"},{"id":7568,"word":"养兵千日，用兵一时","pinyin":"yǎng bīng qiān rì，yòng bīng yī shí","abbr":"ybqrybys","explanation":"平时供养、训练军队，以便到关键时刻用兵打仗。指平时积畜力量，在必要时一下用出来。","source":{"text":"兵可千日而不用，不可一日而不备。","book":"《南史·陈暄传》"},"example":{"text":"这意思很明白：～；大敌压境，你们不说打仗，反到逃跑，好，留下枪支，交给我们，看我们的吧。","book":"孙犁《光荣》"},"similar":["有备无患","养儿防老"],"opposite":["养虎伤身","养虎遗患","养痈成患"],"usage":"作宾语、定语、分句；可分开使用"},{"id":7569,"word":"养兵千日，用在一时","pinyin":"yǎng bīng qiān rì，yòng zài yī shí","abbr":"ybqryzys","explanation":"养兵：指供养训练士兵；千日：指长时间。平时供养、训练军队，以便到关键时用兵打仗","source":{"text":"朝廷养兵千日，用在一时，汝安敢出怨言，以慢军心！","book":"明·罗贯中《三国演义》第100回"},"similar":["养兵千日，用在一朝"],"usage":"作宾语、定语、分句；用于军事等"},{"id":7570,"word":"养兵千日，用在一朝","pinyin":"yǎng bīng qiān rì，yòng zài yī zhāo","abbr":"ybqryzyz","explanation":"指长期供养、训练军队，以备一旦用兵打仗。同“养军千日，用在一朝”。","source":{"text":"卢俊义听了大怒道：‘养兵千日，用在一朝！我要你跟我去走一遭，你便有许多推故。’","book":"明·施耐庵《水浒传》第六十一回"},"example":{"text":"夏十道：‘国家～。别的不要讲，这两句话是人所共知的。’","book":"清·李宝嘉《官场现形记》第二十八回"},"similar":["养兵千日，用兵一时"],"usage":"作宾语、定语、分句；用于军事等"},{"id":7571,"word":"养军千日，用军一时","pinyin":"yǎng jūn qiān rì，yòng jūn yī shí","abbr":"yjqryjys","explanation":"指长期供养、训练军队，以备一旦用兵打仗。同“养军千日，用在一朝”。","source":{"text":"我养军千日，用军一时。空有满朝文武，那一个与我退的番兵！都是些畏刀避箭的。","book":"元·马致远《汉宫秋》第二折"},"example":{"text":"尝言‘～’。俺们不替朝廷出力，竟是一伙禽兽了。","book":"清·孔尚任《桃花扇·誓师》"},"similar":["养军千日，用在一时"],"usage":"作宾语、定语、分句；用于书面语"},{"id":7572,"word":"养军千日，用在一时","pinyin":"yǎng jūn qiān rì，yòng zài yī shí","abbr":"yjqryzys","explanation":"平时供养、训练军队，以便到关键时刻用兵打仗。指平时积畜力量，在必要时一下用出来。","source":{"text":"兵可千日而不用，不可一日而不备。","book":"《南史·陈暄传》"},"example":{"text":"～，到了关键时刻，我们应该拿出全部力量来拼搏。"},"similar":["有备无患","养儿防老"],"opposite":["养虎遗患","养痈贻患"],"usage":"作主语、分句；指关键时刻起作用"},{"id":7573,"word":"养军千日，用在一朝","pinyin":"yǎng jūn qiān rì，yòng zài yī zhāo","abbr":"yjqryzyz","explanation":"指长期供养、训练军队，以备一旦用兵打仗。","source":{"text":"主公，可不道，养军千日，用在一朝。为臣子要尽忠报国也呵！","book":"《秦并六国平话》卷上：“王贲启奏曰：‘告陛下，养军千日，用在一朝。’”元·高文秀《渑池会》第三折"},"example":{"text":"自古～。臣等呵，无能灭虎狼，无能灭虎狼，空愧熊罴将。","book":"清·洪昇《长生殿·献饭》"},"similar":["养兵千日，用在一朝"],"usage":"作宾语、定语、分句；用于军事等"},{"id":7574,"word":"养力蓄锐","pinyin":"yǎng lì xù ruì","abbr":"ylxr","explanation":"养：休养；蓄：积蓄；锐：锐气。保养精神，蓄集锐气。","source":{"text":"且待半年，养精畜锐，刘表、孙权可一鼓而下也。","book":"明·罗贯中《三国演义》第三十四回"}},{"id":7575,"word":"养威蓄锐","pinyin":"yǎng wēi xù ruì","abbr":"ywxr","explanation":"培植威力，积蓄锐气。","source":{"text":"养威蓄锐，直殄元凶。","book":"唐·于公异《李晟收复西京露布》"},"example":{"text":"殿下自领精锐，速据成皋，～，以逸待劳，出奇计一鼓而即可破建德。","book":"清·褚人获《隋唐演义》第五十八回"},"similar":["养锐蓄威","蓄锐养威"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":7576,"word":"养子防老，积谷防饥","pinyin":"yǎng zǐ fáng lǎo，jī gǔ fáng jī","abbr":"yzfljgfj","explanation":"指养育儿子以防老年无依靠，保存谷物为防备饥荒。同“养儿防老，积谷防饥”。","source":{"text":"儿也，可不道养子防老，积谷防饥，抬举的你成人长大，剗的说这等言语那！","book":"元·无名氏《认金梳》第一折"},"similar":["养儿防老，积谷防饥"],"usage":"作宾语、定语、分句；用于处事"},{"id":7577,"word":"养家活口","pinyin":"yǎng jiā huó kǒu","abbr":"yjhk","explanation":"维持一家人的生活。","source":{"text":"那些书吏衙役，都是花了钱买着粮道的衙门，那个不想发财？俱要养家活口。","book":"清·曹雪芹《红楼梦》第九十九回"},"example":{"text":"你是费了我八十两元丝银子的，全靠你～哩。","book":"清·夏敬渠《野叟曝言》第三十三回"},"similar":["养家糊口"],"usage":"作主语、谓语、宾语；指维持一家人的生活"},{"id":7578,"word":"养家糊口","pinyin":"yǎng jiā hú kǒu","abbr":"yjhk","explanation":"指勉强养活家人，使不饿肚。","source":{"text":"父亲李守忠是一个庄稼人，为着养家糊口，每到农闲时候就自己做些瓦盆瓦罐放在土窑中烧熟，挑着走乡窜村叫卖。","book":"姚雪垠《李自成》第一卷第二四章"},"example":{"text":"我高兴极了，从此我就和大人一样当了工人，等我挣了工钱，就可以帮助～啦！","book":"南新宙《黄浦江的激流》"},"similar":["养家活口"],"usage":"作谓语、定语、宾语；用于生活"},{"id":7579,"word":"养尊处优","pinyin":"yǎng zūn chǔ yōu","abbr":"yzcy","explanation":"养：指生活。指生活在有人伺候、条件优裕的环境中。","source":{"text":"天子者，养尊而处优，树恩而收名，与天下为喜乐者也。","book":"宋·苏洵《上韩枢密书》"},"example":{"text":"父亲孤身在外，无人侍奉，甥女却在家中～，一经想起，更是坐立不宁。","book":"清·李汝珍《镜花缘》第五十四回"},"similar":["纸醉金迷","花天酒地","娇生惯养"],"opposite":["含辛茹苦","节衣缩食","艰苦卓绝"],"usage":"作谓语、定语；指处于尊贵地位"},{"id":7580,"word":"养小防老，积谷防饥","pinyin":"yǎng xiǎo fáng lǎo，jī gǔ fáng jī","abbr":"yxfljgfj","explanation":"积：聚，储蓄。生养儿子是为了方便老年生活，储存谷物是为了防备荒年挨饿","source":{"text":"‘哀哀父母，生我劬劳。’养小防老，积谷防饥。","book":"元·关汉卿《裴度还带》第三折"},"similar":["养儿防老，积谷防饥"],"usage":"作宾语、定语、分句；用于处事"},{"id":7581,"word":"养晦韬光","pinyin":"yǎng huì tāo guāng","abbr":"yhtg","explanation":"指隐藏行迹和才能，不露锋芒。","source":{"text":"苟能养晦韬光，始许了却前缘，重联仙侣。","book":"清·王韬《凇滨琐话·罗浮幻迹》"},"similar":["韬光养晦"],"usage":"作谓语、定语；用于处事"},{"id":7582,"word":"养生丧死","pinyin":"yǎng shēng sàng sǐ","abbr":"ysss","explanation":"子女对父母的赡养和殡葬。同“养生送死”。丧，治丧。","source":{"text":"养生丧死无憾，王道之始也。","book":"《孟子·梁惠王上》"},"similar":["养生送终","养生送死"],"usage":"作谓语、定语；用于书面语"},{"id":7583,"word":"养生之道","pinyin":"yǎng shēng zhī dào","abbr":"yszd","explanation":"指修养身心，以期保健延年的方法。","source":{"text":"它不仅是养生之道，长寿之星，而且是探讨与研究生命奥秘。","book":"《中国气功四大经典·总序》"},"example":{"text":"中年人应该开始学习～。"},"usage":"作主语、宾语；指保养身体"},{"id":7584,"word":"养生送死","pinyin":"yǎng shēng sòng sǐ","abbr":"ysss","explanation":"子女对父母的赡养和殡葬。","source":{"text":"养生者不足以当大事，惟送死可以当大事。","book":"《孟子·离娄下》"},"example":{"text":"一夫之力，所耕百亩，～，与夫出赋税给公上者，皆取具焉。","book":"宋·曾巩《劝农诏》"},"similar":["养老送终"],"usage":"作谓语、定语；指子女对父母的赡养和殡葬"},{"id":7585,"word":"养生送终","pinyin":"yǎng shēng sòng zhōng","abbr":"yssz","explanation":"子女对父母的赡养和殡葬。同“养生送死”。","source":{"text":"陇蜀之丹漆旄羽，荆扬之皮革骨象，江南之楠梓竹箭，燕齐之鱼盐旃裘，兖豫之漆丝絺纻，养生送终之具也。","book":"汉·桓宽《盐铁论·本议》"},"similar":["养生丧死","养生送死"],"usage":"作谓语、定语；用于书面语"},{"id":7586,"word":"养疥成疮","pinyin":"yǎng jiè chéng chuāng","abbr":"yjcc","explanation":"疥：一种轻微皮肤病；疮：皮肤上肿烂溃疡的病。由疥变成大疮。比喻小事处理不好就会酿成大祸患","source":{"text":"倘若倭贼残破浙江，趁势长驱江南，岂非我们养疥成疮之过？","book":"清·李百川《绿野仙踪》第73回"},"opposite":["防微杜渐"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":7587,"word":"养痈成患","pinyin":"yǎng yōng chéng huàn","abbr":"yych","explanation":"留着毒疮不去医治，就会成为后患。比喻纵容包庇坏人坏事，结果会遭受祸害。","source":{"text":"养痈长疽，自生祸殃。","book":"《后汉书·冯衍传》李贤注引冯衍《与妇弟任武达书》"},"example":{"text":"我们对待缺点错误的态度，应是做坚决的斗争，决不能～。"},"similar":["养痈贻患","后患无穷","养痈致患"],"opposite":["斩尽杀绝","不留余地"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":7588,"word":"养痈畜疽","pinyin":"yǎng yōng xù jū","abbr":"yycj","explanation":"生了毒疮不去医治。比喻庇护宽容坏人坏事。","source":{"text":"若彼小人，便始而互相依托，后则互相忌嫉；始而养痈畜疽，后则纵虎放鹰，只顾巧言惑主，利己害人，哪顾国家后患，真可痛可恨也。","book":"清·褚人获《隋唐演义》第八十三回"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":7589,"word":"养痈自患","pinyin":"yǎng yōng zì huàn","abbr":"yyzh","explanation":"痈：毒疮。留着毒疮不去医治，就会成为后患。比喻纵容包庇坏人坏事，结果会遭受祸害。","source":{"text":"养痈长疽，自生祸殃。","book":"《后汉书·冯衍传》李贤注引冯衍《与妇弟任武达书》"},"example":{"text":"不意姜尚作难肆横，竟克朕之四关也。今不早治，是～也。","book":"明·许仲琳《封神演义》第八十五回"},"similar":["养痈成患","养痈致患"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":7590,"word":"养痈自祸","pinyin":"yǎng yōng zì huò","abbr":"yyzh","explanation":"痈：毒疮。留着毒疮不去医治，就会成为祸害。比喻纵容包庇坏人坏事，结果会遭受祸害。","source":{"text":"养痈长疽，自生祸殃。","book":"《后汉书·冯衍传》李贤注引冯衍《与妇弟任武达书》"}},{"id":7591,"word":"养痈致患","pinyin":"yǎng yōng zhì huàn","abbr":"yyzh","explanation":"痈：毒疮。留着毒疮不去医治，就会成为后患。比喻纵容包庇坏人坏事，结果会遭受祸害。","source":{"text":"养痈长疽，自生祸殃。","book":"《后汉书·冯衍传》李贤注引冯衍《与妇弟任武达书》"},"similar":["养痈成患","养痈自患"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":7592,"word":"养痈贻害","pinyin":"yǎng yōng yí hài","abbr":"yyyh","explanation":"痈：毒疮。留着毒疮不去医治，就会成为祸害。比喻纵容包庇坏人坏事，结果会遭受祸害。","source":{"text":"养痈长疽，自生祸殃。","book":"《后汉书·冯衍传》李贤注引冯衍《与妇弟任武达书》"},"example":{"text":"若专务持重，～，弊不可胜言也。","book":"《清史稿·杨廷璋传》"}},{"id":7593,"word":"养痈贻患","pinyin":"yǎng yōng yí huàn","abbr":"yyyh","explanation":"痈：毒疮；患：祸害。留着毒疮不去医治，就会成为后患。比喻纵容姑息坏人坏事，结果自己遭殃。","source":{"text":"博善化之虚名，溃败决裂乃至此。养痈贻患，我之谓也夫！","book":"清·纪昀《阅微草堂笔记·槐西杂志一》"},"example":{"text":"我们不能～，应当当机立断。"},"similar":["养虎遗患","后患无穷","养痈成患"],"opposite":["斩尽杀绝","不留余地"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":7594,"word":"养痈遗患","pinyin":"yǎng yōng yí huàn","abbr":"yyyh","explanation":"留着毒疮不去医治，就会成为后患。比喻纵容包庇坏人坏事，结果会遭受祸害。","source":{"text":"养痈长疽，自生祸殃。","book":"《后汉书·冯衍传》李贤注引冯衍《与妇弟任武达书》"},"example":{"text":"博善化之虚名，溃败决裂乃至此，～，我之谓也夫。","book":"清·纪昀《阅微草堂笔记·槐西杂志一》"},"similar":["养虎遗患","后患无穷","养痈成患"],"opposite":["斩尽杀绝","不留余地","斩草除根"],"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":7595,"word":"养精储锐","pinyin":"yǎng jīng chǔ ruì","abbr":"yjcr","explanation":"养：休养；储：积蓄；锐：锐气。保养精神，蓄集锐气。","source":{"text":"且待半年，养精畜锐，刘表、孙权可一鼓而下也。","book":"明·罗贯中《三国演义》第三十四回"}},{"id":7596,"word":"养精畜锐","pinyin":"yǎng jīng xù ruì","abbr":"yjxr","explanation":"养：休养；蓄：积蓄；锐：锐气。保养精神，蓄集锐气。","source":{"text":"且待半年，养精畜锐，刘表、孙权可一鼓而下也。","book":"明·罗贯中《三国演义》第三十四回"},"example":{"text":"队员们正在～，准备迎接最后的冠亚军决赛。"}},{"id":7597,"word":"养精蓄锐","pinyin":"yǎng jīng xù ruì","abbr":"yjxr","explanation":"养：保养；精：精神；蓄：积蓄；锐：锐气。保养精神，蓄集力量。","source":{"text":"且待半年，养精蓄锐，刘表，孙权可一鼓而下也。","book":"明·罗贯中《三国演义》第34回"},"example":{"text":"他们个个像跑道上的选手，～，伸足擦腿，准备显身手。","book":"叶圣陶《四三集·得失》"},"similar":["休养生息"],"opposite":["劳民伤财"],"usage":"作谓语、定语、宾语；用于军力、比赛等"},{"id":7598,"word":"养老送终","pinyin":"yǎng lǎo sòng zhōng","abbr":"ylsz","explanation":"指子女对父母身前的赡养和死后的殡葬。","source":{"text":"生了奴奴，欲扳门第，配嫁他人，又恐老来无倚，只得将奴招了一个女婿，养老送终。","book":"明·吴承恩《西游记》第二十七回"},"example":{"text":"凤娇道：‘我母年老，要你～。’马迪道：‘你嫁了我，那养老送终之事，何须说得。’","book":"清·如莲居士《薛刚反唐》第四十四回"},"similar":["养生送死"],"usage":"作谓语、定语、宾语；指照顾老人"},{"id":7599,"word":"养虎为患","pinyin":"yǎng hǔ wéi huàn","abbr":"yhwh","explanation":"比喻纵容敌人，留下后患，自己反手其害。","example":{"text":"这个人很不可靠，你却给与高位，怕会～哩。"}},{"id":7600,"word":"养虎伤身","pinyin":"yǎng hǔ shāng shēn","abbr":"yhss","explanation":"饲养老虎，自伤其身。比喻纵敌留患。","source":{"text":"大王，你只宜乘早击之，若迟便有养虎伤身之害矣。","book":"明·沈采《千金记·入关》"},"example":{"text":"兀术听了，大叫道：‘罢了，罢了！此乃～也！’","book":"《说岳全传》第五七回"},"usage":"作谓语、定语；指自己害了自己"},{"id":7601,"word":"养虎留患","pinyin":"yǎng hǔ liú huàn","abbr":"yhlh","explanation":"比喻纵容敌人，自留后患。同“养虎自遗患”。","source":{"text":"今其子乃欲见逐，岂非养虎留患耶？","book":"《东周列国志》第五六回"},"similar":["养虎贻患","养虎遗患"],"usage":"作谓语、定语、宾语；指纵容敌人"},{"id":7602,"word":"养虎自啮","pinyin":"yǎng hǔ zì niè","abbr":"yhzn","explanation":"啮：咬。养老虎，咬伤自己。比喻纵容敌人而自受其害。","source":{"text":"养虎自啮，长虺成蛇。","book":"《洛阳伽蓝记·建中寺》"},"similar":["养虎自残","养虎自毙"],"usage":"作谓语、定语、宾语；用于处事"},{"id":7603,"word":"养虎自残","pinyin":"yǎng hǔ zì cán","abbr":"yhzc","explanation":"比喻纵容敌人而自受其害。同“养虎自啮”。","source":{"text":"丞相便相凌蹈，恐国祚之灭不复久矣。真可谓养虎自残者也。","book":"《魏书·羯胡石虎传》"},"similar":["养虎自毙","养虎自啮"],"usage":"作谓语、定语、宾语；用于处事"},{"id":7604,"word":"养虎自毙","pinyin":"yǎng hǔ zì bì","abbr":"yhzb","explanation":"比喻纵容敌人而自受其害。同“养虎自啮”。","source":{"text":"你们养虎自毙，作茧自缠。","book":"郭沫若《星空·孤竹君子二子》"},"similar":["养虎自残","养虎自啮"],"usage":"作谓语、定语、宾语；用于处事"},{"id":7605,"word":"养虎自贻灾","pinyin":"yǎng hǔ zì yí zāi","abbr":"yhzyz","explanation":"比喻纵容敌人，自留后患。同“养虎自遗患”。","source":{"text":"今日里亡猿殃及木，谁待肯养虎自贻灾。","book":"明·康海《中山狼》第二折"},"similar":["养虎自遗患"],"usage":"作宾语、定语；用于书面语"},{"id":7606,"word":"养虎自遗患","pinyin":"yǎng hǔ zì yí huàn","abbr":"yhzyh","explanation":"比喻纵容敌人，自留后患。","source":{"text":"汉欲西归，张良、陈平说曰：‘汉有天下太半，而诸侯皆附之。楚兵罢食尽，此天亡楚之时也，不如因其机而遂取之。今释弗击，此所谓‘养虎自遗患’也。’","book":"《史记·项羽本纪》"},"example":{"text":"前日饵贼降，明日纵贼叛。武臣怯战斗，文臣主羁绊。驯致国破亡，～。","book":"清·宋儒醇《甲申春三月》诗"},"similar":["养虎遗患"],"usage":"作谓语、定语、宾语；指纵容敌人","story":["秦朝被推翻后，楚军与汉军订立和约，以鸿沟为界，西边归汉，东边归楚，宣布停战。项羽领兵东归，刘邦西进。张良和陈平对刘邦说：“目前汉军势力日益强大，诸侯也支持，可抓住时机消灭楚军，不能养虎遗患。”"]},{"id":7607,"word":"养虎自齧","pinyin":"yǎng hǔ zì niè","abbr":"yhzn","explanation":"比喻姑息敌人，终致损害自己。齧，同“啮”。"},{"id":7608,"word":"养虎贻患","pinyin":"yǎng hǔ yí huàn","abbr":"yhyh","explanation":"比喻纵容敌人，自留后患。同“养虎自遗患”。","source":{"text":"此所谓引贼入家，养虎贻患，是何等计策乎？","book":"明·张居正《答宣大巡抚计处黄把二虏》"},"example":{"text":"与其～，还不如——算了。","book":"孔厥《新儿女英雄传》第七章"},"similar":["养虎留患","养虎遗患"],"usage":"作谓语、定语、宾语；指纵容敌人"},{"id":7609,"word":"养虎遗患","pinyin":"yǎng hǔ yí huàn","abbr":"yhyh","explanation":"遗：留下；患：祸患。留着老虎不除掉，就会成为后患。比喻纵容坏人坏事，留下后患。","source":{"text":"楚兵罢食尽，此天亡楚之时也，不如因其机而遂取之。今释弗击，此所谓养虎遗患也。","book":"《史记·项羽本纪》"},"example":{"text":"他非常恨陕西地方文武大员的糊涂无用，竟敢长期不明“贼情”，～。","book":"姚雪垠《李自成》第一卷第三十二章"},"similar":["养痈贻患","放虎归山","后患无穷"],"opposite":["除恶务尽","斩草除根"],"usage":"作谓语、定语、宾语；指纵容敌人","story":["秦朝被推翻后，楚军与汉军订立和约，以鸿沟为界，西边归汉，东边归楚，宣布停战。项羽领兵东归，刘邦西进。张良和陈平对刘邦说：“目前汉军势力日益强大，诸侯也支持，可抓住时机消灭楚军，不能养虎遗患。”"]},{"id":7610,"word":"养虺成蛇","pinyin":"yǎng huǐ chéng shé","abbr":"yhcs","explanation":"比喻纵容敌人，听任其强大起来。","source":{"text":"为虺弗摧，为蛇将若何？","book":"春秋·鲁·左丘明《国语·吴语》"},"example":{"text":"令颢重完守具，可谓～，悔无及矣。","book":"《北史·高道穆传》"},"usage":"作谓语、定语；指养虎遗患"},{"id":7611,"word":"养贤纳士","pinyin":"yǎng xián nà shì","abbr":"yxns","explanation":"招养收容有才德的人。","source":{"text":"养贤纳士，修德治民。","book":"明·无名氏《孟母三移》第一折"},"example":{"text":"古代君子靠～才取得大的功业。"},"similar":["招贤纳士"],"opposite":["嫉贤妒能"],"usage":"作谓语、宾语；指爱惜人才"},{"id":7612,"word":"养锐蓄威","pinyin":"yǎng ruì xù wēi","abbr":"yrxw","explanation":"培植威力，积蓄锐气。同“养威蓄锐”。","source":{"text":"我军亦得养锐蓄威，居中制外。","book":"《清史稿·洪承畴传》"},"similar":["蓄锐养威","养威蓄锐"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":7613,"word":"养音九皋","pinyin":"yǎng yīn jiǔ gāo","abbr":"yyjg","explanation":"比喻贤才隐居修德。","source":{"text":"鹤鸣于九皋，声闻于天。","book":"语出《诗·小雅·鹤鸣》"},"example":{"text":"南朝·宋·王韶之《赠潘综吴逵举孝廉》：“育翮幽林，～。”"},"usage":"作宾语、定语；用于书面语"},{"id":7614,"word":"养鹰扬去","pinyin":"yǎng yīng yáng qù","abbr":"yyyq","explanation":"喂养老鹰，老鹰吃饱后就飞走。比喻心怀野心的人不易控制，当其得势之时就不再为主人所用。","source":{"text":"不如卿言，譬如养鹰，饥即为用，饱则飏去。","book":"《后汉书·吕布传》"}},{"id":7615,"word":"养鹰飏去","pinyin":"yǎng yīng zǒu qù","abbr":"yyyq","explanation":"比喻怀有野心的人不易控制，当其得意之时就不再为主人所用。","source":{"text":"譬如养鹰，饥即为用，饱则飏去。","book":"语出《后汉书·吕布传》"},"example":{"text":"宋·胡梦昱《嘉定壬午六月五日轮对第二札子》：“当其归附之初，国论哗然，或有～之疑，或有养虎遗患之惧。”"},"usage":"作宾语、定语；用于比喻句"},{"id":7616,"word":"兼人之勇","pinyin":"jiān rén zhī yǒng","abbr":"jrzy","explanation":"兼人：一人抵多人；勇：勇敢。抵得上几个人的勇气。形容十分勇敢。","source":{"text":"受辱于胯下，无兼人之勇，不足畏也。","book":"《汉书·韩信传》"},"example":{"text":"欲差官赍礼前去，天下慌乱，盗贼生发，恐中途疏虞，你却有～，可当此任么？","book":"清·禇人获《隋唐演义》第十五回"},"usage":"作宾语；指人很勇敢"},{"id":7617,"word":"兼人之材","pinyin":"jiān rén zhī cái","abbr":"jrzc","explanation":"一个人具备两个人的才能。形容才力过人。","source":{"text":"一天到晚，忙了东又忙西，就是有兼人之材，恐怕亦办不了。","book":"清·李宝嘉《官场现形记》第四十八回"},"similar":["兼人之才"],"usage":"作宾语；用于称赞人"},{"id":7618,"word":"兼人之量","pinyin":"jiān rén zhī liàng","abbr":"jrzl","explanation":"量：饭量，食量。一个人抵得上两个人或几个人的饭量。形容饭量很大。","source":{"text":"官人饮食有兼人之量，必有兼人之才、兼人之福。小僧看你气宇，定是非常之人。","book":"清·徐述夔《快士传》卷一"}},{"id":7619,"word":"兼人好胜","pinyin":"jiān rén hào shèng","abbr":"jrhs","explanation":"兼人：超过别人。非常好胜，总想超过别人。","source":{"text":"由也兼人，故退之。","book":"《论语·先进》"},"example":{"text":"你看十三妹那侠气雄心，～的一个人。","book":"清·文康《儿女英雄传》第十七回"},"usage":"作谓语、定语；用于为人"},{"id":7620,"word":"兼功自厉","pinyin":"jiān gōng zì lì","abbr":"jgzl","explanation":"兼：加倍；功：用功；厉：同“励”，勉励。加倍用功，自相勉励。","source":{"text":"每岁农时，辄载酒肴于田间，候勤者而劳之，其堕懒者耻不致丹，皆兼功自厉。","book":"《后汉书·王丹传》"},"similar":["兼功自励"],"usage":"作谓语；用于处事"},{"id":7621,"word":"兼包并容","pinyin":"jiān bāo bìng róng","abbr":"jbbr","explanation":"把各个方面全都容纳包括进来。同“兼容并包”。","source":{"text":"苟无大害于我军事者，一切均当兼包并容，有违节制，悉以军律治罪。","book":"章炳麟《讨满洲檄文》"},"similar":["兼容并包","兼包并畜"],"usage":"作谓语、定语、分句；把各个方面全都容纳包"},{"id":7622,"word":"兼包并畜","pinyin":"jiān bāo bìng xù","abbr":"jbbc","explanation":"把不同内容、不同性质的东西收下来，保存起来。同“兼收并蓄”。","source":{"text":"这样便能够兼包并畜以成其大。","book":"郭沫若《十批判书·稷下黄老学派的批判》"},"similar":["兼收并蓄"],"opposite":["不可得兼"],"usage":"作谓语、定语、宾语、状语；指兼容性大"},{"id":7623,"word":"兼听则明，偏信则暗","pinyin":"jiān tīng zé míng，piān xìn zé àn","abbr":"jtzmpxza","explanation":"指要同时听取各方面的意见，才能正确认识事物；只相信单方面的话，必然会犯片面性的错误。","source":{"text":"君之所以明者，兼听也；其所以暗者，偏信也。","book":"汉·王符《潜夫论·明暗》"},"example":{"text":"唐朝人魏徵说过：“～。”","book":"毛泽东《矛盾论》"},"similar":["兼听则明，偏听则暗"],"usage":"作主语、谓语、宾语；用于领导者","story":["唐太宗李世民任命魏征做谏议大夫，他问魏征怎样成为贤明皇帝。魏征说尧舜善于听取多方面的意见，所以就贤明，能保住天下；他又说秦二世、梁武帝和隋炀帝只相信少数人的话，不去了解真实情况，所以国家就灭亡了"]},{"id":7624,"word":"兼善天下","pinyin":"jiān shàn tiān xià","abbr":"jstx","explanation":"兼善：使大家都有好处。使天下人都得到好处。","source":{"text":"穷则独善其身，达则兼善天下。","book":"《孟子·尽心上》"}},{"id":7625,"word":"兼官重绂","pinyin":"jiān guān chóng fú","abbr":"jgzf","explanation":"指兼任很多显耀官职。","source":{"text":"昔窦邓之宠，倾动四方，兼官重绂，盈金积货，至使议弄神器，更改社稷。","book":"《后汉书·翟酺传》"},"similar":["兼朱重紫"],"usage":"作谓语、定语；用于官场"},{"id":7626,"word":"兼容并包","pinyin":"jiān róng bìng bāo","abbr":"jrbb","explanation":"容：容纳；包：包含。把各个方面全都容纳包括进来。","source":{"text":"故驰骛乎兼容并包，而勤思乎参天贰地。","book":"《史记·司马相如列传》"},"example":{"text":"贫僧岂不知，圣贤学问，～，释氏左道旁门，难于抗衡。","book":"清·夏敬渠《野叟曝言》第二回"},"similar":["兼收并蓄","兼包并容"],"opposite":["爬梳剔抉"],"usage":"作谓语、定语、分句；把各个方面全都容纳包"},{"id":7627,"word":"兼容并蓄","pinyin":"jiān róng bìng xù","abbr":"jrbx","explanation":"把不同内容、不同性质的东西收下来，保存起来。同“兼收并蓄”。","source":{"text":"所贵乎君子者以能兼容并蓄，使才智者有以自见，而愚不肖者有以自全。","book":"明·方孝孺《复郑好义书》之三"},"example":{"text":"王朔《一半是火焰，一半是海水》：“这种～的大度精神还表现在庵里僧尼共存。”"},"similar":["兼收并蓄","兼收并畜"],"opposite":["水火不容"],"usage":"作谓语、定语、宾语、状语；指兼容性大"},{"id":7628,"word":"兼年之储","pinyin":"jiān nián zhī chǔ","abbr":"jnzc","explanation":"兼年：两年或两年以上；储：储备。有两年以上的储备。","source":{"text":"广农积谷，有兼年之储。","book":"《三国志·魏志·胡质传》"},"usage":"作宾语；用于书面语"},{"id":7629,"word":"兼弱攻昧","pinyin":"jiān ruò gōng mèi","abbr":"jrgm","explanation":"兼：兼并；昧：昏昧。兼并弱国，讨伐昏聩糊涂的君主。","source":{"text":"兼弱攻昧，取乱侮亡。","book":"《尚书·仲虺之诰》"},"example":{"text":"且～、逆取顺守，汤武之道也。","book":"明·罗贯中《三国演义》第六十回"},"usage":"作谓语；指兼并弱国和攻取政治昏乱之国"},{"id":7630,"word":"兼收博采","pinyin":"jiān shōu bó cǎi","abbr":"jsbc","explanation":"犹兼收并采。广泛收罗采用。","source":{"text":"仁宗皇帝照知其弊，公听并观，兼收博采，无南北之异。","book":"宋·陆游《论选用西北士大夫札子》"},"similar":["兼收并采"],"usage":"作谓语、定语；用于处事等"},{"id":7631,"word":"兼收并容","pinyin":"jiān shōu bìng róng","abbr":"jsbr","explanation":"收：收罗；容：容纳。把不同性质的东西收罗，保存起来。","source":{"text":"凡七略所录，分科所肄，以及艺术之微，稗官之说，靡不兼收并容。","book":"章炳麟《华国月刊发刊词》"},"similar":["兼收并蓄","兼收并畜","兼包并畜"],"usage":"作谓语、定语、宾语、状语；指兼容性大"},{"id":7632,"word":"兼收并录","pinyin":"jiān shōu bìng lù","abbr":"jsbl","explanation":"把不同的说法都一并载录下来。","source":{"text":"传闻异辞，记载别出不能兼收并录以待作者之抉择，而私作聪明，自定去取，则此次之业难于凭藉者四矣。","book":"清·章学诚《文史通义·答客问下》"},"usage":"作谓语、定语、宾语；用于记事等"},{"id":7633,"word":"兼收并畜","pinyin":"jiān shōu bìng xù","abbr":"jsbc","explanation":"把不同内容、不同性质的东西收下来，保存起来。同“兼收并蓄”。","source":{"text":"古来藏书者，亦不乏兼收并畜。","book":"清·黄宗羲《传是楼藏书记》"},"similar":["兼收并蓄","兼收并容","兼包并畜"],"opposite":["格格不入"],"usage":"作谓语、定语、宾语、状语；指兼容性大"},{"id":7634,"word":"兼收并蓄","pinyin":"jiān shōu bìng xù","abbr":"jsbx","explanation":"收：收罗；蓄：储藏，容纳。把不同内容、不同性质的东西收下来，保存起来。","source":{"text":"玉札丹砂，赤箭青芝，牛溲马勃，败鼓之皮，俱收并蓄，待用无遗者，医师之良也。","book":"唐·韩愈《进学解》"},"example":{"text":"古来藏书家，亦不乏～。","book":"清·阮葵生《茶余客话》卷十六"},"similar":["兼容并包","兼而有之"],"opposite":["不可兼得"],"usage":"作谓语、定语、宾语、状语；指兼容性大"},{"id":7635,"word":"兼收并采","pinyin":"jiān shōu bìng cǎi","abbr":"jsbc","explanation":"广泛收罗采用。","source":{"text":"兼收并采，不遗偏材一曲之人者，此所以无弃材也。","book":"宋·曾巩《谢章学士书》"},"example":{"text":"凡此诸书，皆当～，不可以其不列学官而偏废之。","book":"清·王士禛《分甘余话》卷上"},"similar":["兼收并蓄","兼收博采"],"usage":"作谓语、定语、宾语；用于学术等"},{"id":7636,"word":"兼朱重紫","pinyin":"jiān zhū chóng zǐ","abbr":"jzzz","explanation":"指兼任很多显耀官职。朱，朱衣；紫，紫绶。","source":{"text":"服冕乘轺，兼朱重紫，则若固有之，常如布衣。此至人之用怀也。","book":"晋·葛洪《抱朴子·任命》"},"similar":["兼官重绂"],"usage":"作谓语、定语；用于官场"},{"id":7637,"word":"兼权尚计","pinyin":"jiān quán shàng jì","abbr":"jqsj","explanation":"指全面衡量，深思熟虑。","source":{"text":"兼权之，孰计之，然后定其欲恶取舍。","book":"荀况《荀子·不苟》"},"example":{"text":"然而～，明于任使，恭俭忧人，则其始之所以兴。","book":"宋·曾巩《陈书目录序》"},"similar":["深思熟虑"],"usage":"作谓语；指多方面衡量，深入考虑"},{"id":7638,"word":"兼权熟计","pinyin":"jiān quán shú jì","abbr":"jqsj","explanation":"兼：涉及的不止一方面；权：衡量、比较；熟：深入细致；计：考虑。指多方面衡量，深入考虑。","source":{"text":"见其可利也，则必前后虑其可害也者；而兼权之，熟计之，然后定其欲恶取舍。","book":"《荀子·不苟》"},"similar":["兼权尚计"],"usage":"作谓语；指多方面衡量，深入考虑"},{"id":7639,"word":"兼爱无私","pinyin":"jiān ài wú sī","abbr":"jaws","explanation":"泛爱大众，对人没有私心。","source":{"text":"中心物恺，兼爱无私，此仁义之情也。","book":"先秦·庄周《庄子·天道》"},"example":{"text":"致利除害，～谓之仁。","book":"东汉·班固《汉书·公孙弘传》"},"similar":["大公无私"],"usage":"作谓语；指泛爱大众"},{"id":7640,"word":"兼程前进","pinyin":"jiān chéng qián jìn","abbr":"jcqj","explanation":"兼：两倍的；并：合并。加快步伐，一天走两天的路程。","source":{"text":"乃兼道进军，多设旗鼓为疑兵。","book":"《三国志·贾逵传》"},"example":{"text":"司令员命令部队～，在天亮前赶到目的地。"},"similar":["兼程而进"],"usage":"作谓语、宾语；指加速前进"},{"id":7641,"word":"兼程并进","pinyin":"jiān chéng bìng jìn","abbr":"jcbj","explanation":"兼两倍的；并合并。加快步伐，一天走两天的路程。","source":{"text":"乃兼道进军，多设旗鼓为疑兵。","book":"《三国志·贾逵传》"}},{"id":7642,"word":"兼程而进","pinyin":"jiān chéng ér jìn","abbr":"jcej","explanation":"兼：两倍的。加快步伐，一天走两天的路程。","source":{"text":"贾琏这番进京，若按站走时，本该出月到家，因听见元春喜信，遂昼夜兼程而进，一路俱各平安。","book":"清·曹雪芹《红楼梦》第16回"},"example":{"text":"清·李宝嘉《官场现形记》第23回：“在路无分昼夜，～。”"},"similar":["兼程前进"],"usage":"作谓语、宾语；形容加快步伐"},{"id":7643,"word":"兼而有之","pinyin":"jiān ér yǒu zhī","abbr":"jeyz","explanation":"指同时占有或具有几种事物。","source":{"text":"奚以知天兼而爱之，兼而利之也？以其兼而有之，兼而食之也。","book":"《墨子·法仪》"},"example":{"text":"在科学研究方面，基础科学知识和应用科学知识应该～。"},"similar":["同时兼备","兼收并蓄"],"usage":"作谓语；指同时占有或具有有关的各方面"},{"id":7644,"word":"兼葭倚玉","pinyin":"jiān jiā yǐ yù","abbr":"jjyy","explanation":"蒹葭：初生的芦苇。玉：仙树。芦苇倚在仙树上。①比喻两个品貌极为悬殊的人在一起，显得很不协调。②比喻地位卑微的人依附高贵的人。亦作“蒹葭倚玉树”、“蒹葭"},{"id":7645,"word":"兼葭秋水","pinyin":"jiān jiā qiū shuǐ","abbr":"jjqs","explanation":"比喻思慕的人。兼，同“蒹”。","source":{"text":"蒹葭苍苍，白露为霜。所谓伊人，在水一方。","book":"《诗·秦风·蒹葭》"},"example":{"text":"～，相失交臂，我劳如何？","book":"梁启超《新中国未来记》第四回"},"similar":["蒹葭秋水"],"usage":"作宾语、定语；用于比喻句"},{"id":7646,"word":"兼覆无遗","pinyin":"jiān fù wú yí","abbr":"jfwy","explanation":"兼：同时；覆：盖；遗：遗漏。原指天穹覆盖万物。后用来比喻恩泽宏大，所施无一遗漏。","source":{"text":"五疾，上收而养之，材而事之，官施而衣食之，兼覆无遗。","book":"《荀子·王制》"},"usage":"作谓语、定语；用于书面语"},{"id":7647,"word":"兼览博照","pinyin":"jiān lǎn bó zhào","abbr":"jlbz","explanation":"犹言明察四方。","source":{"text":"君以兼览博照为德，臣以献可替否为忠。","book":"《后汉书·胡广传》"},"similar":["明察四方"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":7648,"word":"兼资文武","pinyin":"jiān zī wén wǔ","abbr":"jzww","explanation":"兼：兼有；资：才能。既有文才，又有武略。形容文武双全。","source":{"text":"平陵朱云，兼资文武。","book":"《汉书·朱云传》"},"similar":["文武兼备"],"usage":"作谓语、定语；用于书面语"},{"id":7649,"word":"兽困则噬","pinyin":"shòu kùn zé shì","abbr":"skzs","explanation":"兽陷困境要咬人。比喻人陷于绝境要竭力反抗。","source":{"text":"然归死难图，兽困则噬，是以爰整其旅，用为过防。","book":"《宋史·谢晦传》"},"similar":["兽穷则啮"],"usage":"作宾语、定语；用于书面语"},{"id":7650,"word":"兽心人面","pinyin":"shòu xīn rén miàn","abbr":"sxrm","explanation":"面貌虽是人，心却如野兽。形容人凶恶残暴。","source":{"text":"时台中谓之语曰：侯知一不伏致仕，张琮自请起复……皆非名教中人，并是王化外物。兽心人面，不其然乎！","book":"唐·张鷟《朝野佥载》卷四"},"example":{"text":"洵是～，问袁公此意能知？","book":"清·洪楝园《悬嶴猿·诫猿》"},"similar":["人面兽心"],"usage":"作宾语、定语；指人的品行"},{"id":7651,"word":"兽穷则啮","pinyin":"shòu qióng zé niè","abbr":"sqzn","explanation":"指野兽陷于绝境必然进行搏噬反扑。亦喻人陷入困窘之境，便会竭力反击。","source":{"text":"兽穷则啮，鸟穷则啄，人穷则诈。自古及今，穷其下能不危者，未之有也。","book":"《韩诗外传》卷二"},"example":{"text":"～，于是奸苗倡言逐客民，复故地，而群寨争杀百姓响应矣。","book":"清·魏源《圣武记》卷七"},"similar":["兽困则噬"],"usage":"作宾语、定语；用于书面语"},{"id":7652,"word":"兽穷则齧","pinyin":"shòu qióng zé niè","abbr":"sqzn","explanation":"指野兽陷于绝境必然进行搏噬反扑。亦喻人陷入困窘之境，便会竭力反击。"},{"id":7653,"word":"兽聚鸟散","pinyin":"shòu jù niǎo sàn","abbr":"sjns","explanation":"像鸟兽一样时聚时散。比喻聚散无常。也比喻乌合之众。","source":{"text":"无匈奴之性，兽聚而鸟散，从之如搏影。","book":"《史记·平津侯主父列传》"},"example":{"text":"孰不知羌氐之俗，居不常处，兽聚鸟散，本无聚积。","book":"宋·苏舜钦《论西事状》"},"similar":["鸟散兽聚"],"usage":"作谓语、状语；比喻乌合之众"},{"id":7654,"word":"兽迒鸟迹","pinyin":"shòu hàn niǎo jì","abbr":"shnj","explanation":"指鸟兽之迹。","example":{"text":"猎人一般都会辨别～的。"},"usage":"作宾语、定语；用于书面语"},{"id":7655,"word":"冀北空群","pinyin":"jì běi kōng qún","abbr":"jbkq","explanation":"冀：河北的简称。伯乐一过冀北，冀北的良马就被挑选殆尽。比喻优秀的人才或珍贵的物品被接待一空。","source":{"text":"伯乐一过冀北之野，而马群遂空。","book":"唐·韩愈《送温处士赴河阳军序》"}},{"id":7656,"word":"冁然一笑","pinyin":"chǎn rán yī xiào","abbr":"cryx","explanation":"冁然：笑的样子。高兴地笑起来。","source":{"text":"然后徐展此图，以校其人物风景相似与否，夫也将为之冁然一笑也。","book":"清·汪琬《序》"},"example":{"text":"高阳《胡雪岩全传·萧瑟洋场》：“‘我保险不会再遇到。’说罢～。”"},"similar":["冁然而笑"],"opposite":["号啕大哭"],"usage":"作谓语；指笑"},{"id":7657,"word":"冁然而笑","pinyin":"chǎn rán ér xiào","abbr":"crex","explanation":"冁然：笑的样子。高兴地笑起来。","source":{"text":"桓公……冁然而笑。","book":"《庄子·达生》"},"example":{"text":"桓公～，不觉起立曰：“此正寡人之报见也！”","book":"明·冯梦龙《东周列国志》第二十一回"},"similar":["冁然一笑"],"usage":"作谓语；指笑"},{"id":7658,"word":"内举不失其子，外举不失其仇","pinyin":"nèi jǔ bù shī qí zǐ，wài jǔ bù shī qí chóu","abbr":"njbsqzwjbsqc","explanation":"举：推荐。举荐身边的人，即使是亲属也不回避；举荐外面的人，即使是仇敌也不躲开。形容办事公正无私。","source":{"text":"荀慈明曰：‘昔者祁奚内举不失其子，外举不失其仇，以为至公。’","book":"南朝·宋·刘义庆《世说新语·言语》"},"similar":["内举不避亲，外举不避怨"],"opposite":["任人唯亲"],"usage":"作宾语、定语、分句；用于处事","story":["春秋时期，晋国贵族之间权力斗争十分激烈，范宣子赶跑了他的外孙栾盈，并杀了他的同党羊舌虎。大夫祁奚向晋侯请求告老还乡，晋侯问他谁可以接任，他推荐了他的仇敌解狐。晋侯问谁可以担任中军尉，祁奚推荐了自己的儿子祁午"]},{"id":7659,"word":"内举不避亲，外举不避怨","pinyin":"nèi jǔ bù bì qīn，wài jǔ bù bì yuàn","abbr":"njbbqwjbby","explanation":"举：推荐。举荐身边的人，即使是亲属也不回避；举荐外面的人，即使是仇敌也不躲开。形容办事公正无私。","source":{"text":"内举不避亲，外举不避怨，仁者之于善也，无择也，无恶也，唯善之所在。","book":"战国·鲁·尸佼《尸子》上卷"},"similar":["内举不失其子，外举不失其仇"],"opposite":["任人唯亲"],"usage":"作宾语、定语、分句；用于处事"},{"id":7660,"word":"内亲外戚","pinyin":"nèi qīn wài qī","abbr":"nqwq","explanation":"指帝王的母族或妻族。"},{"id":7661,"word":"内仁外义","pinyin":"nèi rén wài yì","abbr":"nrwy","explanation":"内心很仁慈，待人重情义。","source":{"text":"伏以阁下内仁而外义，行高而德巨，尚贤而兴能，哀穷而悼屈。","book":"唐·韩愈《上兵部李侍郎书》"},"usage":"作谓语、定语；指为人"},{"id":7662,"word":"内修外攘","pinyin":"nèi xiū wai rǎng","abbr":"nxwr","explanation":"对内整治国政，对外抵御敌人。修亦作“修”。","source":{"text":"顾惟礼耕义种之贤，足副内修外攘之志。","book":"宋·胡锜《拟力田诏》"},"example":{"text":"观于《垂拱》《奏札》二篇及《戊午谠议序》，反复以天经地义～不可逆为言。","book":"明·张纶《林泉随笔》"},"usage":"作宾语、定语；用于治政等"},{"id":7663,"word":"内修政治，外治武备","pinyin":"nèi xiū zhèng zhì，wài zhì wǔ bèi","abbr":"nxzzwzwb","explanation":"修：修治；政治：政策；治：管理；武备：军备。对内修明政治，对外做好军事准备。","source":{"text":"明主鉴兹，必内修文德，外治武备。","book":"战国·吴起《吴子·图国篇》卷一"}},{"id":7664,"word":"内助之贤","pinyin":"nèi zhù zhī xián","abbr":"nzzx","explanation":"妻子能够帮助丈夫，使丈夫的事业、学业、品格方面有了进展，增加丈夫在社会上的地位。","source":{"text":"内助之贤，母范之正，盖有以开宋世之基业者焉。","book":"《宋史·后妃传上·序》"},"example":{"text":"鲍宣之妻，提瓮出汲，雅得顺从之道；齐御之妻，窥御激夫，可称～。","book":"明·程登吉《幼学琼林·夫妇》"}},{"id":7665,"word":"内圣外王","pinyin":"nèi shèng wài zhǔ","abbr":"nsww","explanation":"指一方面具有圣人的才德，一方面又能施行王道。这是道家的政治思想。","source":{"text":"是故内圣外王之道暗而不明，郁而不发，天下之人各为其所欲焉，以自为方。","book":"《庄子·天下》"},"example":{"text":"尧夫～之学也。 ★《宋史·邵雍传》","book":"河南程颢初侍其父，识雍，议论终日，退而叹"},"usage":"作宾语、定语；指古代修身为政的最高理想"},{"id":7666,"word":"内外交困","pinyin":"nèi wài jiāo kùn","abbr":"nwjk","explanation":"交：同时；困：困境。里里外外都处于困难的境地。","source":{"text":"它给陷于内外交困的美帝国主义以沉重的打击。","book":"毛泽东《支持美国黑人抗暴斗争的声明》"},"example":{"text":"他现在已经是～，日子很不好过。"},"similar":["内忧外患","走投无路","山穷水尽"],"opposite":["左右逢源","万事亨通"],"usage":"作谓语、宾语、定语；指生活窘泰"},{"id":7667,"word":"内外勾结","pinyin":"nèi wài gōu jié","abbr":"nwgj","explanation":"内部与外部暗中相互配合来达到某种目的。","example":{"text":"他们～，终于搞垮了这个企业。"},"similar":["里应外合"],"usage":"作谓语、宾语、定语；同“里应外合”"},{"id":7668,"word":"内外夹击","pinyin":"nèi wài jiā jī","abbr":"nwjj","explanation":"夹：从两方面来的。从里、外两方面配合同时进攻。","source":{"text":"台儿庄正面之敌，经我军于六日夜开始总攻，内外夹击……尚据险顽抗，战况之烈，空前未有。","book":"郭沫若《洪波曲》第五章"},"similar":["内外夹攻"],"usage":"作谓语、宾语、定语；指同时进攻"},{"id":7669,"word":"内外夹攻","pinyin":"nèi wài jiā gōng","abbr":"nwjg","explanation":"从里、外两方面配合同时进攻。","source":{"text":"那其间内外夹攻，方能取胜。","book":"元·郑廷玉《楚昭公》第一折"},"example":{"text":"这件事情，须得我同你两个～。","book":"郭沫若《屈原》第二幕"},"similar":["内外夹击","里应外合"],"usage":"作谓语、宾语、定语；指同时进攻"},{"id":7670,"word":"内外感佩","pinyin":"nèi wài gǎn pèi","abbr":"nwgp","explanation":"疏：疏远；亲：亲密。内心疏远，表面亲近。指不是真心待人。","source":{"text":"曾子曰：‘内疏而外亲。’","book":"汉·韩婴《韩诗外传》卷二"},"example":{"text":"不受谏喻是一病，～是一病。","book":"宋·张君房《云笈七签》卷四十"}},{"id":7671,"word":"内外有别","pinyin":"nèi wài yǒu bié","abbr":"nwyb","explanation":"内部、外部应该有严格的区别。","source":{"text":"故男女授受不亲，家庭内外有别，此王制也，此古礼也。","book":"清·明教中人《好逑传》第十七回"},"example":{"text":"古人说～，道理各各不同，丈夫叫“外子”，妻叫“内子”。","book":"鲁迅《内外"}},{"id":7672,"word":"内峻外和","pinyin":"nèi jùn wai hé","abbr":"njwh","explanation":"内心严厉而外貌和蔼。","source":{"text":"公内峻外和，相对者如登泰、华、坐春风，非不阳和熙熙，贮在颜间，而业已置人于青云上。","book":"清·昭梿《啸亭杂录·孙文定公》"},"usage":"作谓语、定语；用于为人"},{"id":7673,"word":"内应外合","pinyin":"nèi yīng wài hé","abbr":"nywh","explanation":"应：接应；合：配合。外面攻打，里面接应。","source":{"text":"忽报有内应外合之兵，蜀军溃散。","book":"《三国志通俗演义·姜维祁山战邓艾》"},"example":{"text":"我等不若密通无知，～，事可必济。","book":"明·冯梦龙《东周列国志》第14回"},"similar":["里应外合"],"opposite":["孤立无援"],"usage":"作谓语、宾语、定语；指相互配合"},{"id":7674,"word":"内忧外侮","pinyin":"nèi yōu wài wǔ","abbr":"nyww","explanation":"多指国内不安定和外敌侵略。有时也比喻个人的情况。同“内忧外患”。","source":{"text":"霸踞关中卅二年，如何豆釜竟相煎！内忧外侮侵寻日，莫怪姚宗不再延。","book":"蔡东藩《两晋演义》第九十九回"}},{"id":7675,"word":"内忧外患","pinyin":"nèi yōu wài huàn","abbr":"nywh","explanation":"多指国内不安定和外敌侵略。有时也比喻个人的情况。","source":{"text":"君外舍而不鼎馈，非有内忧，必有外患。","book":"《管子·戒》"},"example":{"text":"摆着那些七零八落的人才，要支撑这个～的天下，越想越觉危险。","book":"清·曾朴《孽海花》第二十一回"},"similar":["内外交困"],"opposite":["国泰民安"],"usage":"作主语、宾语、定语；指国内不安定和外敌侵","story":["春秋时期，鲁国大乱，大权被季孙氏、孟孙氏和叔孙氏三家控制，鲁定公成为一个傀儡，他听说孔子开坛讲学，主张“君君臣臣”以及“仁政”，召见孔子，与孔子分析鲁国的内忧外患。孔子建议他外联齐国，内部重振君威，制定了一系列措施"]},{"id":7676,"word":"内无怨女，外无旷夫","pinyin":"nèi wú yuàn nǚ，wài wú kuàng fū","abbr":"nwynwwkf","explanation":"怨女：到了出嫁年龄而未嫁的女子；旷夫：成年而未娶妻的男子。指人们都能找到配偶，成家立业。","source":{"text":"当是时也，内无怨女，外无旷夫。","book":"战国·邹·孟轲《孟子·梁惠王下》"},"example":{"text":"现代社会重男轻女思想十分严重，～的局面难以实现。"},"usage":"作谓语、定语；用于社会局面"},{"id":7677,"word":"内柔外刚","pinyin":"nèi róu wai gāng","abbr":"nrwg","explanation":"内心柔弱，外表刚强。亦作“外刚内柔”。","source":{"text":"内阴而外阳，内柔而外刚。","book":"《周易·否》"},"example":{"text":"她是一个～的女子。"},"similar":["刚柔并济"],"usage":"作定语、状语；指人的个性"},{"id":7678,"word":"内查外调","pinyin":"nèi chá wài diào","abbr":"ncwd","explanation":"指在单位内外调查事情的真实情况。","source":{"text":"经过一个星期的内查外调，掌握了大量证据，很快就挖出了这个由八人组成的贪污盗窃团伙。","book":"《人民日报》1983.11.29"},"usage":"作主语、宾语；指调查真实情况"},{"id":7679,"word":"内清外浊","pinyin":"nèi qīng wài zhuó","abbr":"nqwz","explanation":"清：清白；浊：污浊。内心清白，外表污浊。比喻本质很好而外表极普通。","source":{"text":"内清外浊，敝衣裹玉。","book":"晋·杨泉《太玄经》"}},{"id":7680,"word":"内疏外亲","pinyin":"nèi shū wài qīn","abbr":"nswq","explanation":"疏：疏远；亲：亲密。内心疏远，表面亲近。指不是真心待人。","source":{"text":"曾子曰：‘内疏而外亲。’","book":"汉·韩婴《韩诗外传》卷二"},"similar":["虚情假意"],"usage":"作谓语、定语；指为人处世"},{"id":7681,"word":"内疚神明","pinyin":"nèi jiù shén míng","abbr":"njsm","explanation":"内疚：内心感到惭愧不安；神明：聪明正直的神祗。指良心受到责备。","source":{"text":"许衡灭宋，死后犹不欲请谥立碑，盖内疚神明，不无惭德。","book":"清·黄小配《洪秀全演义》第三十回"},"example":{"text":"后虽亦自省：～，外惭清议，盖饰词耳。","book":"孙犁《耕堂读书记》八"},"usage":"作谓语、宾语、定语；用于处事"},{"id":7682,"word":"内省不疚","pinyin":"nèi xǐng bù jiù","abbr":"nxbj","explanation":"指自我反省，内心并不感到惭愧不安，即没有做有愧于心的事。","source":{"text":"内省不疚，夫何忧何惧？","book":"春秋·鲁·孔丘《论语·颜渊》"},"example":{"text":"不仅‘～，夫何忧何惧’，而且有无穷的兴味。","book":"谢觉哉《“此心光光地”》"},"similar":["问心无愧"],"opposite":["问心有愧"],"usage":"作谓语、宾语；指问心无愧"},{"id":7683,"word":"内省无愧","pinyin":"nèi xǐng wú kuì","abbr":"nxwk","explanation":"经过反省而问心无愧。","source":{"text":"方兹恋庭闱，旋已对狱吏，试言其所由，内省亦无愧。","book":"宋·李觏《寄祖秘丞》"}},{"id":7684,"word":"内称不避亲，外举不避怨","pinyin":"nèi chēng bù bì qīn，wài jǔ bù bì yuàn","abbr":"ncbbqwjbby","explanation":"举：推荐。举荐身边的人，即使是亲属也不回避；举荐外面的人，即使是仇敌也不躲开。形容办事公正无私。","source":{"text":"儒有内称不避亲，外举不避怨，程功积事，推贤而进达之，不望其报。","book":"西汉·戴圣《礼记·儒行》"},"similar":["内举不避亲，外举不避怨"],"opposite":["任人唯亲"],"usage":"作宾语、定语、分句；用于处事"},{"id":7685,"word":"内紧外松","pinyin":"nèi jǐn wài sōng","abbr":"njws","explanation":"指政策的收紧与放宽或指人的心情，即内心紧张，态度镇静。","example":{"text":"我们采用的～的策略。"},"usage":"作定语、状语；用于人、政策等"},{"id":7686,"word":"内视反听","pinyin":"nèi shì fǎn tīng","abbr":"nsft","explanation":"内视：向内看；反听：听外面的。指既能反省自己的言行，也能听取别人的意见。","source":{"text":"反听之谓聪，内视之谓明，自胜之谓强。","book":"西汉·司马迁《史记·商君列传》"},"example":{"text":"夫～，则忠臣竭诚；宽贤矜能，则义士厉节。","book":"南朝·宋·范晔《后汉书·王允传》"},"similar":["自我反省"],"usage":"作谓语、定语；指自我反省"},{"id":7687,"word":"内重外轻","pinyin":"nèi zhòng wài qīng","abbr":"nzwq","explanation":"内：京都；外；外省。形容京官权大，外官权小。","source":{"text":"乙亥，以内重外轻，命省台寺监及监司守令居职及二年者，许更迭出入除擢。","book":"《宋史·高宗纪》"},"example":{"text":"将来兵权饷权，俱在朝廷，～，不为疆臣所牵制矣。","book":"高阳《慈禧全传》四十八"},"usage":"作宾语、定语；指政局等"},{"id":7688,"word":"内顾之忧","pinyin":"nèi gù zhī yōu","abbr":"ngzy","explanation":"旧时形容没有妻子，身在外又要顾虑家事。现形容有内部的忧虑。","source":{"text":"外望无寸禄，内顾无斗储。","book":"晋·左思《咏史》诗"},"example":{"text":"今南方已平，可无～。","book":"明·罗贯中《三国演义》第九十一回"},"similar":["后院起火","后顾之忧"],"usage":"作宾语；指来自内部的忧虑"},{"id":7689,"word":"再三再四","pinyin":"zài sān zài sì","abbr":"zszs","explanation":"重复好几次。","source":{"text":"我其实不回来了，两脚车上装七个人，也不必再三再四的了。","book":"元·无名氏《刘弘嫁婢》第一折"},"example":{"text":"～拉他丛，他又跪下告了坐，方敢在底下一个凳子上坐了。","book":"清·吴敬梓《儒林外史》第二十五回"},"similar":["屡次三番"],"usage":"作状语；指重复好几次"},{"id":7690,"word":"再不其然","pinyin":"zài bù qí rán","abbr":"zbqr","explanation":"犹言再不然。","source":{"text":"我不怕人笑话！你的小老婆治我害我，我倒怕人笑话了！再不然，留下他，就卖了我。谁还不知道你薛家有钱，行动拿钱垫人，又有好亲戚挟制着别人。你不趁早施为，还等什么？","book":"清·曹雪芹《红楼梦》第八十回"},"example":{"text":"原有的提议大家都不同意，～这样好了，我们取消这次的郊游。"}},{"id":7691,"word":"再作冯妇","pinyin":"zài zuò féng fù","abbr":"zzff","explanation":"再作：重做；冯妇：人名。比喻再干旧行业。","source":{"text":"晋人有冯妇者，善搏虎，卒为善士；则之野，有众逐虎，虎负嵎，莫之敢撄；望见冯妇，趋而迎之，冯妇攘臂下车，众皆悦之，其为士者笑之。","book":"《孟子·尽心下》"},"example":{"text":"曾经有位总长，听说，他的出来就职，是因为某公司要来立案，表决时可以多一个赞成者，所以～的。","book":"鲁迅《而已集·反“漫谈”》"},"similar":["重操旧业","下马冯妇"],"opposite":["金盆洗手"],"usage":"作谓语；指重操旧业","story":["战国时期晋国勇士冯妇敢赤手空拳打老虎，后来他宣布再也不打老虎从此专心读书。一天他与朋友去郊外玩，看见很多人在围攻一只老虎，但不敢上前。冯妇走上前去抓住老虎一摔就把老虎摔死了，他的朋友说：“你又重操旧业了。”"]},{"id":7692,"word":"再作道理","pinyin":"zài zuò dào lǐ","abbr":"zzdl","explanation":"指另行打算或另想办法。同“再做道理”。","source":{"text":"桂娘一定在里头，只作三不知闯将进去，见他时再作道理。","book":"明·凌濛初《二刻拍案惊奇》卷三"},"example":{"text":"还是二姐不去，自己相伴着还妥当，且～。","book":"清·曹雪芹《红楼梦》第六十九回"}},{"id":7693,"word":"再做道理","pinyin":"zài zuò dào lǐ","abbr":"zzdl","explanation":"指另行打算或另想办法。","source":{"text":"我且有尺水行尺船，等什么鹰神再来，我再做道理。","book":"清·西周生《醒世姻缘传》第六十五回"}},{"id":7694,"word":"再合余烬","pinyin":"zài hé yú jìn","abbr":"zhyj","explanation":"《左传·成公二年》：“请收合余烬，背城借一。”","source":{"text":"及窦建德吞噬山东，叔父全军覆没；刘黑闼～，叔父望风奔北。（《资治通鉴·唐纪·高祖武德九年》）"},"example":{"text":"宋·司马光《资治通鉴·唐记·太宗贞观元年》：“刘黑闼～，叔父望风奔北。”"},"usage":"作谓语、定语；用于比喻句"},{"id":7695,"word":"再实之木根必伤","pinyin":"zài shí zhī mù gēn bì shāng","abbr":"zszmgbs","explanation":"一年之内再度结果的树，根必受伤。比喻过度幸运，反而招致灾祸。","source":{"text":"再实之木根必伤，掘藏之家必有殃。","book":"《淮南子·人间训》"},"similar":["再实之根必伤"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7696,"word":"再实之木，其根必伤","pinyin":"zài shí zhī mù，qí gēn bì shāng","abbr":"zszmqgbs","explanation":"一年之内再度结果的树，根必受伤。比喻过度幸运，反而招致灾祸。","source":{"text":"再实之木根必伤，掘藏之家必有殃。","book":"《淮南子·人间训》"},"example":{"text":"常观富贵之家，禄位重叠，～。（《后汉书·马皇后纪》）"}},{"id":7697,"word":"再实之根必伤","pinyin":"zài shí zhī gēn bì shāng","abbr":"zszgbs","explanation":"一年之内再度结果的树，根必受伤。比喻过度幸运，反而招致灾祸。","source":{"text":"再实之根必伤，掘藏之家必有殃。","book":"《淮南子·人间训》"},"similar":["再实之木根必伤"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7698,"word":"再当冯妇","pinyin":"zài dāng féng fù","abbr":"zdff","explanation":"冯妇：人名。比喻再干旧行业。","source":{"text":"晋人有冯妇者，善搏虎，卒为善士；则之野，有众逐虎，虎负嵎，莫之敢撄；望见冯妇，趋而迎之，冯妇攘臂下车，众皆悦之，其为士者笑之。","book":"《孟子·尽心下》"},"similar":["再作冯妇","重作冯妇"],"usage":"作谓语、宾语、定语；指重操旧业"},{"id":7699,"word":"再拜稽首","pinyin":"zài bài qī shǒu","abbr":"zbqs","explanation":"再拜：拜两次。古代的一种跪拜礼。亦指旧时信札中常用作向对方表示敬意的客套语","source":{"text":"宾少进，礼辞。反命，又命之。宾再拜稽首，许诺。","book":"《仪礼·燕礼》"},"example":{"text":"蕃主旋，北面～。使者宣制，蕃主进受命，退，复位，以币授左右，又～。（《新唐书·礼乐志》）"}},{"id":7700,"word":"再接再历","pinyin":"zài jiē zài lì","abbr":"zjzl","explanation":"用以指继续努力，坚持不懈。同“再接再砺”。"},{"id":7701,"word":"再接再厉","pinyin":"zài jiē zài lì","abbr":"zjzl","explanation":"接：接战；厉：磨快，引伸为奋勉，努力。指公鸡相斗，每次交锋以前先磨一下嘴。比喻继续努力，再加一把劲。","source":{"text":"一喷一醒然，再接再厉乃。","book":"唐·韩愈《斗鸡联句》"},"example":{"text":"取得好成绩也不能自满，要～，不断进取。"},"similar":["再接再砺"],"opposite":["得过且过"],"usage":"作定语、状语；用于鼓励"},{"id":7702,"word":"再接再捷","pinyin":"zài jiē zài jié","abbr":"zjzj","explanation":"接：接战。交锋一次战胜一次。比喻屡战屡胜。","source":{"text":"观其始以步卒，深人虏廷，而能以寡击众，以劳破逸，再接再捷，功孰大焉及乎兵尽力掸，摧锋败绩，不能死战，卒就生降。","book":"唐·白居易《汉将李建论》"}},{"id":7703,"word":"再接再砺","pinyin":"zài jiē zài lì","abbr":"zjzl","explanation":"接：交战；砺：磨快，引申为奋勉。指继续努力奋斗，坚持不懈，一次比一次更英勇顽强","source":{"text":"一喷一醒然，再接再砺乃。","book":"唐·韩愈《斗鸡联句》"},"similar":["再接再厉"],"usage":"作定语、状语；用于鼓励"},{"id":7704,"word":"再生之德","pinyin":"zài shēng zhī dé","abbr":"zszd","explanation":"德：恩惠。使自己再生的恩德。","source":{"text":"大元皇帝再生之德，则赵氏子孙世世有赖，不敢弭忘。","book":"《元史·世祖纪》"},"example":{"text":"感救死之恩，日再造；诵～，曰二天。（明·程登吉《幼学琼林·天文》）"},"similar":["再造之恩"],"usage":"作主语、宾语；指恩情"},{"id":7705,"word":"再生父母","pinyin":"zài shēng fù mǔ","abbr":"zsfm","explanation":"指对自己有重大恩情的人，多指救命的恩人。","source":{"text":"夹路香花迎拜了，见说家家举酒，道公是再生父母。","book":"宋·曾晞颜《贺新郎·贺耐轩周府尹》"},"example":{"text":"他认为党是他的～。"},"similar":["恩重如山","恩同再造"],"opposite":["切骨之仇","血海深仇"],"usage":"作宾语；多指救命的恩人"},{"id":7706,"word":"再衰三涸","pinyin":"zài shuāi sān hé","abbr":"zssh","explanation":"形容士气越来越低落，不能再振作。","source":{"text":"病根（指不平等条约）不除……我们国民的民气，再衰三涸，将要永远沦为外人的奴隶而不能振拔。","book":"郭沫若《为“五卅”惨案怒吼》"},"similar":["再衰三竭"],"usage":"作定语；指每况愈下"},{"id":7707,"word":"再衰三竭","pinyin":"zài shuāi sān jié","abbr":"zssj","explanation":"竭：尽。指力量一再消耗，已经衰减耗竭。","source":{"text":"夫战，勇气也。一鼓作气，再而衰，三而竭。","book":"《左传·庄公十年》"},"example":{"text":"希特勒已到～之时，他对斯大林格勒、高加索两处的进攻已经失败。","book":"毛泽东《第二次世界大战的转折点》"},"similar":["一蹶不振","大势已去","再衰三涸"],"opposite":["盛极一时","方兴未艾"],"usage":"作定语；指每况愈下"},{"id":7708,"word":"再蹈覆辙","pinyin":"zài dǎo fù zhé","abbr":"zdfz","explanation":"再：重复；蹈：踩、踏；辙：车迹、道路。重复走翻车的道路，指不接受教训","source":{"text":"这也是一种经验呢，我们都是年青人，将来还有生育的机会，我们可以不再蹈覆辙了。","book":"郭沫若《抱箭集·第二辑·曼陀罗华》"},"similar":["重蹈覆辙"],"usage":"作谓语、宾语；用于劝说等"},{"id":7709,"word":"再造之恩","pinyin":"zài zào zhī ēn","abbr":"zzze","explanation":"再造：再生。象救了自己性命那样大的恩德。","source":{"text":"再造之恩，不可妄属。","book":"《宋书·王僧达传》"},"example":{"text":"～，恨无所报。","book":"清·蒲松龄《聊斋志异·西湖主》"},"similar":["再生父母"],"usage":"作主语、宾语；指恩情"},{"id":7710,"word":"冒冒失失","pinyin":"mào mào shī shī","abbr":"mmss","explanation":"过分地随便对待。","source":{"text":"妹妹，回来见了老太太，别象刚才那样冒冒失失的了。","book":"清·曹雪芹《红楼梦》第83回"},"example":{"text":"不到决战的时机，没有决战的力量，不能～地去进行决战。","book":"毛泽东《论反对日本帝国主义的策略》"},"similar":["鲁鲁莽莽","莽莽撞撞","冒里冒失"],"opposite":["认认真真","毕恭毕敬"],"usage":"作定语、状语；指人莽撞"},{"id":7711,"word":"冒功邀赏","pinyin":"mào gōng yāo shǎng","abbr":"mgys","explanation":"冒：假充；邀：求。假报功劳，求得奖赏。","source":{"text":"王俊！你冒功邀赏，克减军粮，本应斩首！今因是奉旨前来，饶你死罪，捆打四十，发回临安，听凭秦丞相处治。","book":"清·钱彩《说岳全传》第五十七回"},"example":{"text":"独自民国成立以来，法律已处于无权，～者，实繁有徒。","book":"蔡东藩、许廑父《民国通俗演义》第一百十九回"}},{"id":7712,"word":"冒名接脚","pinyin":"mào míng jiě jiǎo","abbr":"mmjj","explanation":"假冒别人的名，接替他。","source":{"text":"后为吏部侍郎，常病选人冒名接脚，阙员既少，取士良难。","book":"《旧唐书·韦陟传》"},"similar":["冒名顶替","偷梁换柱"],"usage":"作谓语；指假冒"},{"id":7713,"word":"冒名顶替","pinyin":"mào míng dǐng tì","abbr":"mmdt","explanation":"冒：冒充，以假充真。为了达到自己的某种目的，假冒别人的姓名，代他去干事或窃取他的权力、地位。","source":{"text":"你走了便也罢，却怎么绑些柳树在此，冒名顶替。","book":"明·吴承恩《西游记》第二十五回"},"example":{"text":"《古文尚书》的运气真够坏的，不但没有能够露头角，还一而在的遭到了些～的事儿。","book":"朱自清《经典常谈·尚书第三》"},"similar":["偷梁换柱"],"opposite":["名副其实"],"usage":"作谓语、宾语、定语；指假冒"},{"id":7714,"word":"冒大不韪","pinyin":"mào dà bù wěi","abbr":"mdbw","explanation":"指不顾舆论的遣责而去干坏事。同“冒天下之大不韪”。","source":{"text":"严谕集议，尚未裁决遵行，则后人孰肯冒大不韪？","book":"《清史稿·礼志二》"},"similar":["冒天下之大不韪"],"usage":"作宾语、定语；指做最大错误的事情"},{"id":7715,"word":"冒天下之大不韪","pinyin":"mào tiān xià zhī dà bù wéi","abbr":"mtxzdbw","explanation":"冒：冒犯；不韪：不是，错误。去干普天下的人都认为不对的事情。指不顾舆论的遣责而去干坏事。","source":{"text":"犯五不韪而以伐人，其丧师也，不亦宜乎？","book":"《左传·隐公十一年》"},"example":{"text":"因为发令者敢于公开发此反革命命令，～，必已具有全面破裂和彻底投降的决心。","book":"毛泽东《为皖南事变发表的命令和谈话》"},"similar":["冒大不韪"],"usage":"作谓语、宾语、定语；指做最大错误的事情","story":["公元前712年，同为周宗室姬姓的郑国与息国因为一些小事发生了矛盾，势力弱小的息国很不冷静，竟派兵攻打强大的郑国，结果大败被实力强大的楚国渔翁得利给灭掉。人们分析息国是冒天下之大不韪，贸然出兵而导致灭亡"]},{"id":7716,"word":"冒失鬼","pinyin":"mào shī guǐ","abbr":"msg","explanation":"言语、举动鲁莽、轻率的人。","source":{"text":"就算我是个冒失鬼，闹了个烟雾尘天，一概不管，甩手走了，你们想想，难道炕上那个黄布包袱我就含含糊糊的丢下不成?","book":"清·文康《儿女英雄传》"},"example":{"text":"他是一个典型的～。"},"usage":"作主语、宾语、定语；指鲁莽的人"},{"id":7717,"word":"冒昧陈辞，有辱清听","pinyin":"mào mèi chén cí，yǒu rǔ qīng tīng","abbr":"mmccyrqt","explanation":"清听：是对听话者的敬词。书信中常用的谦辞，表示自己出言直率，请收信人谅解、采纳。"},{"id":7718,"word":"冒牌货","pinyin":"mào pái huò","abbr":"mph","explanation":"伪造或假造的某些东西。","source":{"text":"那个人确实是个冒牌货，但他网罗的一些事实又是那么不容置疑，我们不得不慎重对待而不能一笑了之。","book":"王朔《我是“狼”》"},"example":{"text":"我们坚决不买～，让造假者没有市场。"},"usage":"作主语、宾语；指假冒产品"},{"id":7719,"word":"冒里冒失","pinyin":"mào lǐ mào shī","abbr":"mlms","explanation":"过分地随便对待。","source":{"text":"这粉嫩的手，怎的冒里冒失，捏他一把！","book":"清·钱彩《说岳全传》第二回"},"similar":["冒冒失失"],"usage":"作定语、状语；指人莽撞"},{"id":7720,"word":"冒险主义","pinyin":"mào xiǎn zhǔ yì","abbr":"mxzy","explanation":"靠投机取巧冒险行事的一种行为方式。","source":{"text":"目前的时局，要求我们勇敢地抛弃关门主义，采取广泛的统一战线，防止冒险主义。","book":"毛泽东《论反对日本帝国主义的策略》"},"example":{"text":"我们不需要～。"},"opposite":["脚踏实地"],"usage":"作主语、宾语、定语；用于投机处世"},{"id":7721,"word":"冗不见治","pinyin":"rǒng bù jiàn zhì","abbr":"rbjz","explanation":"冗：繁杂；治：治绩。事务繁杂，无所建树。","source":{"text":"三年博士，冗不见治。","book":"唐·韩愈《进学解》"},"usage":"作谓语；用于书面语"},{"id":7722,"word":"冗词赘句","pinyin":"rǒng cí zhuì jù","abbr":"rczj","explanation":"冗：繁杂；赘：多余无用的。指诗文中多余无用的话。","example":{"text":"这篇文章思想明确，语言简练，没有冗词赘句。"},"similar":["废话连篇"],"usage":"作宾语、定语；指废话"},{"id":7723,"word":"写经换鹅","pinyin":"xiě jīng huàn é","abbr":"xjhe","explanation":"以书写经文来换鹅。形容书法高超。","example":{"text":"你听说过王羲之～的故事吗？"},"usage":"作宾语、定语；指人的书法好","story":["晋朝时期，大书法家王羲之特别喜欢鹅，也想自己养鹅当宠物。一天他去山阴一座寺庙烧香，见道士鹅养得好，想买几只回去。道士知道他是大书法家，坚决不卖，便让他抄写《道德经》。王羲之抄好后，道士将鹅送给他"]},{"id":7724,"word":"军不厌诈","pinyin":"jūn bù yàn zhà","abbr":"jbyz","explanation":"厌：厌弃，排斥；诈：蒙骗。用兵作战时当尽量使用欺诈等计谋来迷惑敌人。","source":{"text":"军不厌诈。","book":"春秋·楚·孙武《孙子兵法·计篇》：“兵者，诈道也。”李筌注"},"similar":["兵不厌诈"],"usage":"作主语、宾语；用于采用迷惑敌人的方法作战"},{"id":7725,"word":"军不血刃","pinyin":"jūn bù xuè rèn","abbr":"jbxr","explanation":"兵器上没有血。谓未交锋就取得胜利。","source":{"text":"故鸣条之役，军不血刃，牧野之师，商人倒戈。","book":"三国·蜀·诸葛亮《为后帝伐魏诏》"},"similar":["兵不血刃"],"opposite":["血流成河"],"usage":"作定语、状语；形容未经交战就取得胜利"},{"id":7726,"word":"军临城下","pinyin":"jūn lín chéng xià","abbr":"jlcx","explanation":"敌军已来到自己的城墙下面。比喻情势十分危急。","source":{"text":"齐必举兵伐梁，梁、齐之兵连于城下不能去，王以其间伐韩。","book":"《战国策·齐策二》"},"example":{"text":"元帅～，将至壕边，觑南唐一鼓而下也。","book":"明·无名氏《曹影下江南》第三折"},"similar":["兵临城下"],"usage":"作谓语、定语；比喻情势十分危急"},{"id":7727,"word":"军令如山","pinyin":"jūn lìng rú shān","abbr":"jlrs","explanation":"军事命令象山一样不可动摇。旧时形容军队中上级发布的命令，下级必须执行，不得违抗。","source":{"text":"云长曰：‘愿依军法。’孔明曰：‘如此，立下文书。’云长便与了军令状。","book":"明·罗贯中《三国演义》第49回"},"example":{"text":"汝等只知刁明忠来襄阳原为探母，情有可原，却忘记～，凡不听约束者斩无赦。","book":"姚雪垠《李自成》第二卷第22章"},"similar":["岿然不动"],"usage":"作谓语、状语；用于军事"},{"id":7728,"word":"军令状","pinyin":"jūn lìng zhuàng","abbr":"jlz","explanation":"指接受军令后写的保证书，如不能完成任务，愿依军法受惩。泛指接受某项重大任务后写的保证书。","source":{"text":"既各分任，就叫军政司立了军令状，倘中军有失，妾身之罪。","book":"清·钱彩《说岳全传》第44回"},"example":{"text":"我立一张～在你这里。","book":"高阳《胡雪岩全传·红顶商人》"},"usage":"作主语、宾语、定语；用于处事"},{"id":7729,"word":"军法从事","pinyin":"jūn fǎ cóng shì","abbr":"jfcs","explanation":"按照军法严办。","source":{"text":"敢有趁灌犯法，辄以军法从事。","book":"东汉·班固《汉书·王莽传》"},"example":{"text":"吴七一本正经回答：‘三天交不出船来，请～。’","book":"高云览《小城春秋》第40章"},"similar":["依法办事","依法惩处"],"usage":"作谓语、宾语；指按照军法严办"},{"id":7730,"word":"冠上加冠","pinyin":"guān shàng jiā guān","abbr":"gsjg","explanation":"同画蛇添足，比喻多余的举动。","source":{"text":"画蛇添足、冠上加冠，二皆陈轸说楚令尹昭阳之言。","book":"清·赵翼《陔馀丛考·成语》"},"similar":["画蛇添足","多此一举"],"usage":"作谓语、补语；形容多此一举"},{"id":7731,"word":"冠上履下","pinyin":"guān shàng lǚ xià","abbr":"gslx","explanation":"比喻上下分明，尊卑有别。","source":{"text":"冠虽敝，必加于首；履虽新，必关于足。何者，上下之分也。","book":"《史记·儒林列传》"},"opposite":["冠履倒置"],"usage":"作宾语、定语；用于人或事物"},{"id":7732,"word":"冠冕堂皇","pinyin":"guān miǎn táng huáng","abbr":"gmth","explanation":"冠冕：古代帝王、官吏的帽子；堂皇：很有气派的样子。形容外表庄严或正大的样子。","source":{"text":"他自己也就把那回身就抱的旖旎风情藏起来，换一幅冠冕堂皇的面目了。","book":"清·吴趼人《二十年目睹之怪现状》第八十四回"},"example":{"text":"少说些～的话，多做些实实在在的事情。"},"similar":["堂皇冠冕"],"usage":"作状语、宾语、定语；多用于讥讽"},{"id":7733,"word":"冠履倒施","pinyin":"guān lǚ dào shī","abbr":"glds","explanation":"冠：帽子；履：鞋子。比喻上下颠倒，尊卑不分。","source":{"text":"盖自宋室不竞，冠履倒施，大贤处下，不肖处上。","book":"明·李贽《序》"},"similar":["冠履倒易","冠履倒置"],"usage":"作宾语、定语；用于处事"},{"id":7734,"word":"冠履倒易","pinyin":"guān lǚ dào yì","abbr":"gldy","explanation":"比喻上下位置颠倒，尊卑不分。","source":{"text":"亡损沟壑，不见逮及，冠履倒易，陵谷代处。","book":"汉·刘珍《东观汉记·杨赐传》"},"example":{"text":"～，陵谷代处。","book":"南朝·宋·范晔《后汉书·杨赐传》"},"similar":["本末倒置","主客不分"],"usage":"作宾语、定语；比喻上下位置颠倒，尊卑不分"},{"id":7735,"word":"冠履倒置","pinyin":"guān lǚ dào zhì","abbr":"gldz","explanation":"冠：帽子；履：鞋子。帽子和鞋的位置换了。比喻上下位置颠倒，尊卑不分。","source":{"text":"冠履倒易，陵谷代处。","book":"《史记·辕固生列传》：“冠虽敝，必加于首，履虽新，必关于足。何者，上下之分也。”《后汉书·杨赐传》"},"example":{"text":"以堂堂中国，与之互市，～。","book":"《明史·杨继盛传》"},"similar":["冠履倒易"],"usage":"作宾语、定语；比喻上下位置颠倒，尊卑不分"},{"id":7736,"word":"冠屦倒施","pinyin":"guàn jù dǎo shī","abbr":"gjds","explanation":"比喻上下位置颠倒，尊卑不分。同“冠履倒易”。","source":{"text":"盖自宋室不竞，冠屦倒施，大贤处下，不肖处上。","book":"明·李贽《〈忠义水浒传〉序》"},"example":{"text":"请不要闹～的笑话"},"similar":["冠履倒施"],"opposite":["冠上履下"],"usage":"作宾语、定语；用于处事"},{"id":7737,"word":"冠山戴粒","pinyin":"guàn shān dài lì","abbr":"gsdl","explanation":"冠山：把山当帽子，比喻大。戴粒：用头顶粒，比喻小。形容大小虽异，但各适其适。","source":{"text":"彼之冠山，何异乎我之戴粒也。","book":"《文艺类聚》卷九七引《苻子》"},"usage":"作宾语、定语；用于书面语","story":["传说古代时，东海有大鳌能顶着蓬莱仙山到沧海到处游玩，这事传到一群红蚂蚁那里，他们非常惊奇，相约到东海边去观摩。在东海边见到海中的蓬莱仙山时隐时现，时而东时而西。蚂蚁见后觉得没有什么神奇的，说与他们头顶饭粒没有什么差别"]},{"id":7738,"word":"冠带之国","pinyin":"guān dài zhī guó","abbr":"gdzg","explanation":"冠带：帽子，带子。指讲礼仪的国家和习于礼教的人民。","source":{"text":"兵布于天下，威行于冠带之国。","book":"《韩非子·有度》"}},{"id":7739,"word":"冠盖云集","pinyin":"guān gài yún jí","abbr":"ggyj","explanation":"冠盖：指仁宦的冠服和车盖，用作官员代称。形容官吏到的很多。","source":{"text":"绂冕所兴，冠盖如云，七相五公。","book":"汉·班固《西都赋》"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“一时福州城内‘～’，热闹非凡。”"},"similar":["冠盖如云","冠盖如市"],"usage":"作定语、谓语；形容到会的官吏很多"},{"id":7740,"word":"冠盖如云","pinyin":"guān gài rú yún","abbr":"ggry","explanation":"冠盖：指仁宦的冠服和车盖，用作官员代称。形容官吏到的很多。","source":{"text":"绂冕所兴，冠盖如云，七相五公。","book":"汉·班固《西都赋》"},"example":{"text":"～，急侦之，乃一吏部郎经过也。","book":"明·沈德符《万历野获编·记前生》"},"similar":["冠盖如市","冠盖云集"],"usage":"作定语、补语；形容到会的官吏很多"},{"id":7741,"word":"冠盖如市","pinyin":"guān gài rú shì","abbr":"ggrs","explanation":"冠：礼帽；盖：车蓬；冠盖：借指官吏。形容到会的官吏很多。","source":{"text":"有力官绅‘视为利薮，群思攘夺……门前冠盖如市’。","book":"范文澜《中国近代史》上册第五章"},"similar":["冠盖如云","冠盖云集"],"usage":"作定语、谓语；形容到会的官吏很多"},{"id":7742,"word":"冠盖往来","pinyin":"guān gài wǎng lái","abbr":"ggwl","explanation":"冠：礼帽；盖：车蓬；冠盖：借指官吏。指官吏们经常来往。","source":{"text":"长安城中，乃冠盖往来之地。","book":"清·名教中人《好逑传》第14回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第32回：“那水鸥小榭，就终年都是～，日积月累的，就闹得亏空起来。”"},"usage":"作宾语、定语；用于交往等"},{"id":7743,"word":"冠盖相属","pinyin":"guān gài xiāng zhǔ","abbr":"ggxz","explanation":"冠盖：古代官吏的冠服和车盖，代指官吏；属：接连。形容政府的使节或官员，一路上往来不绝。也指世代仕宦，相继不断。","source":{"text":"遣使冠盖相属于道，护之，下巴蜀粟以振之。","book":"西汉·司马迁《史记·平准书》"},"similar":["冠盖相望"],"usage":"作谓语；形容政府的使节或官员往来不绝"},{"id":7744,"word":"冠盖相望","pinyin":"guān gài xiāng wàng","abbr":"ggxw","explanation":"冠盖：指仁宦的冠服和车盖，用作官员代称；相望：互相看得见。形容政府的使节或官员往来不绝。","source":{"text":"齐楚约而欲攻魏，魏使人求救于秦，冠盖相望，秦救不出。","book":"《战国策·魏策四》"},"example":{"text":"～催入相，待将功德格皇天。","book":"唐·韩愈《次潼关上都统相公》诗"},"similar":["冠盖相属"],"usage":"作谓语；形容政府的使节或官员往来不绝"},{"id":7745,"word":"冠绝一时","pinyin":"guàn jué yī shí","abbr":"gjys","explanation":"冠绝：遥遥领先，位居第一。形容在某一时期内超出同辈，首屈一指。","source":{"text":"十王习击刺，猿臂善射，弯弓三百斤，膂力骁捷，冠绝一时。","book":"《晋书·刘聪载记》"},"example":{"text":"凝古辞学精敏，义理该通，凡数千言，～，天下仰风。","book":"五代·五王保《唐摭言》卷十"},"similar":["冠绝时辈"],"usage":"作谓语、定语；指首屈一指"},{"id":7746,"word":"冠绝当时","pinyin":"guàn jué dāng shí","abbr":"gjds","explanation":"冠绝：遥遥领先，位居第一。形容在某一时期内超出同辈，首屈一指。","source":{"text":"文章之美，冠绝当时。","book":"《宋书·颜延之传》"}},{"id":7747,"word":"冠绝时辈","pinyin":"guàn jué shí bèi","abbr":"gjsb","explanation":"冠绝：遥遥领先；辈：同一类人。形容在某一时期内超出同辈，首屈一指。","source":{"text":"时征虏将军石崇河南金谷涧中别庐，冠绝时辈，引致宾客，日以赋诗。","book":"《晋书·刘琨传》"},"similar":["冠绝一时"],"usage":"作谓语、定语；指首屈一指"},{"id":7748,"word":"冠袍带履","pinyin":"guān páo dài lǚ","abbr":"gpdl","explanation":"帽子、袍子、带子、鞋子。原指旧时帝王官宦上朝时或聚会时穿的服装。现泛指随身的必须用品。","source":{"text":"一个捧着文房四宝，一个捧着冠袍带履。","book":"清·曹雪芹《红楼梦》第78回"},"example":{"text":"昌平王～穿戴好了，起身走出来上了轿。","book":"陈荫荣《兴唐传·闹花灯》第15回"},"usage":"作主语、宾语；泛指随身的必须用品"},{"id":7749,"word":"冠鸡佩猳","pinyin":"guàn jī pèi jiā","abbr":"gjpj","explanation":"冠：头上戴着；猳：公猪。指古代武士的服饰和装束。","source":{"text":"冠以雄鸡，佩以猳豚，二物皆勇，子路好勇，故冠带之。","book":"《史记·仲尼弟子列传》：“子路性鄙，好勇力，志伉直；冠雄鸡，佩骃豚。”南朝·裴骃集解"},"usage":"作宾语、定语；用于人的装束等"},{"id":7750,"word":"冢中枯骨","pinyin":"zhǒng zhōng kū gǔ","abbr":"zzkg","explanation":"冢：坟墓。坟墓里的枯骨。比喻没有力量的人。","source":{"text":"袁公路岂忧国忘家者邪？冢中枯骨，何足介意？","book":"《三国志·蜀书·先主传》"},"example":{"text":"～，吾早晚必擒之。","book":"明·罗贯中《三国演义》第二十一回"},"usage":"作宾语、定语；指无能之人"},{"id":7751,"word":"冢木已拱","pinyin":"zhǒng mù yǐ gǒng","abbr":"zmyg","explanation":"坟墓上的树木以很高大。比喻老死多年。","source":{"text":"子之辈皆已老死矣……言其老无知。","book":"《毂梁传·僖公三十三年》：“泰伯将袭郑，百里子与蹇叔子谏曰：‘千里而袭人，未有不亡者也。’泰伯曰：‘子之冢木已拱矣，何知！’”范宁注"},"usage":"作谓语、定语；用于书面语"},{"id":7752,"word":"冤仇可解不可结","pinyin":"yuān chóu kě jiě bù kě jié","abbr":"yckjbkj","explanation":"有仇恨的双方应该解除旧仇，不要弓弦不放，继续结仇。常用作规劝之辞。","source":{"text":"自古道：冤仇可解不可结。他和你是同僚官，又不合活生世，亦且他是个文墨的人，你如何不谏他。","book":"明·施耐庵《水浒全传》第三十三回"},"example":{"text":"舅！～，我送你回家吧。","book":"姚雪垠《长夜》第十二章"},"similar":["冤家可解不可结","冤家宜解不宜结"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7753,"word":"冤假错案","pinyin":"yuān jiǎ cuò àn","abbr":"yjca","explanation":"冤案、假案、错案的合称。","source":{"text":"就按你们人制造冤假错案那个标准，我这点毛病也不够捕的吧？","book":"王朔《谁比谁傻多少》"},"example":{"text":"我们力争没有～的出现。"},"usage":"作主语、宾语、定语；指判决不公"},{"id":7754,"word":"冤冤相报","pinyin":"yuān yuān xiāng bào","abbr":"yyxb","explanation":"冤：冤仇；报：报复，报应。佛家语，认为冤仇总会有报应。","source":{"text":"汝既有冤，吾不汝治，但曩事岁月已久，冤冤相报，宁有穷期，吾今令李宅作善缘荐汝，俾汝尽释前愤，以安生天，如何？","book":"宋·洪迈《夷坚丙志·安氏冤》"},"example":{"text":"又谁知苍天有眼，偏争他来早来迟，到今日～，解愁眉顿作欢眉。","book":"元·无名氏《货郎担》第四折"},"opposite":["以德报怨"],"usage":"作谓语；指报复"},{"id":7755,"word":"冤各有头，债各有主","pinyin":"yuān gè yǒu tóu，zhai gè yǒu zhǔ","abbr":"ygytzgyz","explanation":"比喻处理事情必寻负主要责任的人。","source":{"text":"武松捋起双袖，握着尖刀，指何九叔道：‘小子粗疏，还晓得冤各有头，债各有主。你休惊怕，只要实说，对我一一说知武大死的缘故，便不干涉你！’","book":"明·施耐庵《水浒传》第二十六回"},"example":{"text":"说得出这种无赖话的，未必懂得‘～’的道理。","book":"叶圣陶《倪焕之》十二"},"similar":["冤有头，债有主"],"usage":"作主语、宾语；用于口语"},{"id":7756,"word":"冤天屈地","pinyin":"yuān tiān qū dì","abbr":"ytqd","explanation":"形容非常冤枉委屈。","source":{"text":"真是冤天屈地，要好成歉。吾好意为你寄信，你妻子自不曾到，今日这话，却不知祸从天上来！","book":"明·凌濛初《初刻拍案惊奇》卷八"},"usage":"作宾语、定语；用于书面语"},{"id":7757,"word":"冤如巷伯","pinyin":"yuān rú xiàng bó","abbr":"yrxb","explanation":"巷伯：周幽王时人，遭谗被刑。如同巷伯一样的冤屈。指蒙受不白之冤。","source":{"text":"虽忠如鬻拳，信如卞和，智如孙膑，冤如巷伯，才如史迁，达如子政，一离刀锯，没世不齿。","book":"《后汉书·孔融传》"},"similar":["不白之冤"],"usage":"作谓语、定语；用于书面语"},{"id":7758,"word":"冤家债主","pinyin":"yuān jiā zhài zhǔ","abbr":"yjzz","explanation":"冤家：仇人；债主：收债的人。指与我结怨欠债的人。","source":{"text":"怨家债主，焚漂劫夺。","book":"《无量寿经》卷下"},"example":{"text":"张善友不觉惊醒，乃是睡倒在神案前，做的梦，明明白白，才省悟多是宿世的～。","book":"明·凌濛初《初刻拍案惊奇》卷三十五"}},{"id":7759,"word":"冤家可解不可结","pinyin":"yuān jiā kě jiě bù kě jié","abbr":"yjkjbkj","explanation":"佛教主张结下冤仇的双方最好是化解冤仇，不要结仇不放","source":{"text":"但冤家可解不可结，莫若只早早的做了亲，使他空费了一番心机，强似挞之于市。","book":"清·名教中人《好逑传》第15回"},"similar":["冤家宜解不宜结","冤仇可解不可结"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7760,"word":"冤家宜解不宜结","pinyin":"yuān jiā yí jiě bù yí jié","abbr":"yjyjbyj","explanation":"有仇恨的双方应该解除旧仇，不要弓弦不放，继续结仇。常用作规劝之辞。","source":{"text":"冤家宜解不宜结，各自回头看后头。","book":"明·唐寅《警世》"},"example":{"text":"贤弟不知，他是秦桧差来的。秦桧现掌相位，～。","book":"清·钱彩《说岳全传》第五十七回"},"similar":["冤家可解不可结","冤仇可解不可结"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":7761,"word":"冤家对头","pinyin":"yuān jia duì tóu","abbr":"yjdt","explanation":"指仇人，仇敌。","source":{"text":"谁想才学之才与钱财之财两下里是冤家对头，从来不肯见面的。","book":"清·李渔《慎鸾交·狠图》"},"example":{"text":"还争什么强，要结下下一辈的～吗！","book":"骆宾基《胶东的“暴民”》"},"similar":["对头冤家"],"opposite":["至亲好友"],"usage":"作主语、宾语、定语；指仇人"},{"id":7762,"word":"冤家路狭","pinyin":"yuān jia lù xiá","abbr":"yjlx","explanation":"指仇人或不愿意相见的人，偏偏容易碰见，来不及回避。","source":{"text":"啊！她不就是……天哪！这真是冤家路狭啊！","book":"《花城》1981年第1期"},"similar":["冤家路窄"],"usage":"作谓语、定语、宾语；指仇人相见"},{"id":7763,"word":"冤家路窄","pinyin":"yuān jiā lù zhǎi","abbr":"yjlz","explanation":"仇敌相逢在窄路上。指仇人或不愿意见面的人偏偏相遇。","source":{"text":"真是冤家路窄，今日一命讨了一命。","book":"明·凌濛初《初刻拍案惊奇》卷三十"},"example":{"text":"却不防～，倒被阳伯偷看了去。","book":"清·曾朴《孽海花》第二十二回"},"similar":["萍水相逢","狭路相逢","不期而遇"],"opposite":["失之交臂"],"usage":"作谓语、定语、宾语；指仇人相见"},{"id":7764,"word":"冤有头，债有主","pinyin":"yuān yǒu tóu，zhài yǒu zhǔ","abbr":"yytzyz","explanation":"冤有冤头，债有债主。比喻要了解事情，必须找主事的人。","source":{"text":"上堂，众集定，喝一喝曰：‘冤有头，债有主。’","book":"宋·释普济《五灯会元·法云本禅师法嗣》"},"example":{"text":"～，愿大众莫结恶缘。","book":"清·魏子安《花月痕》第一回"},"similar":["冤各有头，债各有主"],"usage":"作主语、宾语；用于口语"},{"id":7765,"word":"冤沉海底","pinyin":"yuān chén hǎi dǐ","abbr":"ychd","explanation":"形容所受的冤屈很难得到昭雪。","source":{"text":"我指望忍辱偷生，还图个报仇雪耻，不道这贼原放我不过。我死也罢了，但是冤沉海底，安能瞑目！","book":"明·冯梦龙《醒世恒言》第三十六卷"}},{"id":7766,"word":"冥冥之志","pinyin":"míng míng zhī zhì","abbr":"mmzz","explanation":"冥冥：专默精诚。专默精诚的意志。形容有远大理想和坚定信念。","source":{"text":"无冥冥之志者，无昭昭之明。","book":"战国·赵·荀况《荀子·劝学》"},"usage":"作主语、宾语；指人的志向"},{"id":7767,"word":"冥室椟棺","pinyin":"míng shì dú guān","abbr":"msdg","explanation":"冥：昏暗；椟：匣子。房间昏暗，如同棺材一样。","source":{"text":"拘圉其叔父，寊者冥室椟棺之中。","book":"《古文苑·秦诅楚文》"},"usage":"作宾语、定语；用于房屋等"},{"id":7768,"word":"冥思苦想","pinyin":"míng sī kǔ xiǎng","abbr":"mskx","explanation":"深沉地思索；尽力思索。","source":{"text":"这会儿你在这儿瞑思苦想，脑子里一定在盘算：怎么样再？","book":"《十月》1981年第2期"},"example":{"text":"我～了很久，还是得不到答案。"},"similar":["冥思苦索"],"usage":"作谓语、宾语、状语；指绞尽脑汁"},{"id":7769,"word":"冥思苦索","pinyin":"míng sī kǔ suǒ","abbr":"msks","explanation":"冥：深。绞尽脑汁，苦思苦想。","source":{"text":"灵运诸佳句，多出深思苦索。","book":"明·胡应鳞《诗薮·外编二》"},"example":{"text":"只有蠢才，才是他一个人，或者凑集一堆人，不作调查，而只是～地“想办法”，打主意。（毛泽东《反对本本主义》）"},"similar":["冥思苦想","深思熟虑"],"usage":"作谓语、宾语、状语；用于书面语"},{"id":7770,"word":"冥昭瞢暗","pinyin":"míng zhāo méng àn","abbr":"mzma","explanation":"冥：昏暗；昭：明；瞢暗：昼夜未分。指昼夜未分时的混沌状态。","source":{"text":"冥昭瞢暗，谁能极之？","book":"战国·楚·屈原《楚辞·天问》"},"example":{"text":"中国古说，谓盘古辟地，女娲死而遗骸为天地，则上下未形，人类已现，～，安所措足乎？","book":"鲁迅《坟·人之历史》"},"usage":"作宾语、定语；用于书面语"},{"id":7771,"word":"冥昭瞢闇","pinyin":"míng zhāo méng àn","abbr":"mzma","explanation":"指昼夜未分的混沌状态。闇，同“暗”。"},{"id":7772,"word":"冥漠之乡","pinyin":"míng mò zhī xiāng","abbr":"mmzx","explanation":"指天庭或地府。也比喻最高境界。同“冥漠之都”。","source":{"text":"方其数尽，何有于老，同返于冥漠之乡。","book":"明·归有光《祭妻祖父母文》"},"example":{"text":"缥兮缈兮，直摩苍穹之极，而抵乎～。","book":"蔡寅《变雅楼三十年诗证序》"},"similar":["冥漠之都"],"usage":"作宾语；多用于迷信说法"},{"id":7773,"word":"冥漠之都","pinyin":"míng mò zhī dōu","abbr":"mmzd","explanation":"①指天庭或地府。②比喻最高境界。亦称“冥漠之乡”。","source":{"text":"洗心依冥漠之都，潜希忏罪；稽首仰鸿蒙之境，冀涤前非。","book":"前蜀·杜光庭《马尚书南斗醮词》"},"similar":["冥漠之乡"],"usage":"作宾语；多用于迷信说法"},{"id":7774,"word":"冥然兀坐","pinyin":"míng rán wù zuò","abbr":"mrwz","explanation":"冥然：沉寂的样子；兀坐：端坐。静静地独自端坐着。","source":{"text":"借书满架，偃仰啸歌，冥然兀坐，万籁有声。","book":"明·归有光《项脊轩志》"},"usage":"作谓语；指静思"},{"id":7775,"word":"冥眗亡见","pinyin":"míng shùn wáng jiàn","abbr":"mjwj","explanation":"眗：视。指看不见，看不清楚。","source":{"text":"抑挢首以高视兮，目冥眗而亡见。","book":"《汉书·扬雄传》"}},{"id":7776,"word":"冥行擿埴","pinyin":"míng xíng zhì zhí","abbr":"mxzz","explanation":"冥：昏暗；冥行：夜间行路；擿：点；埴：地。夜间摸黑走路，如同盲人拿着手杖点地而行。比喻研求学问，不识门径，暗中探索。","source":{"text":"擿埴索涂，冥行而已矣。","book":"汉·扬雄《法言·修身》"},"example":{"text":"先生之言出，学者凡读汉儒经子汉书之注，如梦得觉，如醉得醒，不至如～。","book":"清·阮元《周礼汉读考序》"},"similar":["暗中探索"],"usage":"作谓语；比喻研求学问不识门径，暗中探索"},{"id":7777,"word":"冥行盲索","pinyin":"míng xíng máng suǒ","abbr":"mxms","explanation":"比喻不明情况而工作。","source":{"text":"擿埴索涂，冥行而已矣。","book":"汉·扬雄《法言·修身》"}},{"id":7778,"word":"冥顽不化","pinyin":"míng wán bù huà","abbr":"mwbh","explanation":"冥：昏昧；顽：愚蠢；不化：不接受教化。愚昧顽固，不接受教化。形容人非常顽固，不通情达理。","source":{"text":"孙玉亭一看侄儿冥顽不化，干脆一拧身回家去了。","book":"路遥《平凡的世界》第二卷第53章"},"example":{"text":"既然他～，死不肯降，那就稍缓时日，俟剿灭献贼之后，再分兵将他围歼不迟。","book":"姚雪垠《李自成》第三卷第四章"},"opposite":["聪明绝顶"],"usage":"作谓语、定语、状语；用于骂人"},{"id":7779,"word":"冥顽不灵","pinyin":"míng wán bù líng","abbr":"mwbl","explanation":"冥顽：愚钝无知；不灵：不聪明。形容愚昧无知。","source":{"text":"不然则是鳄鱼冥顽不灵，刺史虽有言，不闻不知也。","book":"唐·韩愈《祭鳄鱼文》"},"example":{"text":"～藐王章，羊狠狼贪性狂恣。","book":"清·叶廷琯《鸥陂渔话·严戊卿捕鳄行纪诛潮匪事》"},"similar":["愚不可及"],"opposite":["聪明睿智"],"usage":"作谓语、宾语、定语；指顽固不化","story":["唐朝大文学家韩愈因为《谏迎佛骨表》得罪了唐宪宗，被贬到潮州当刺史。他上任后，听说当地的恶溪里有鳄鱼伤害人畜，就写一篇《祭鳄鱼文》去警告鳄鱼7日内迁往南海。如果继续冥顽不灵的话将遭到捕杀，正好一场暴雨赶走鳄鱼"]},{"id":7780,"word":"冬夏青青","pinyin":"dōng xià qīng qīng","abbr":"dxqq","explanation":"指松柏的颜色无论冬夏都是青色的。比喻人的节操终生不变。","source":{"text":"受命于地，唯松柏独也正，在冬夏青青。受命于天，唯尧舜独也正，在万物之首。","book":"《庄子·德充符》"}},{"id":7781,"word":"冬寒抱冰，夏热握火","pinyin":"dōng hán bào bīng，xià rè wò huǒ","abbr":"dhbbxrwh","explanation":"冬天寒冷却要抱冰，夏天炎热却要握火。形容刻苦自勉。","source":{"text":"越王念复吴，仇非上旦也。苦身劳心，夜以继日。……冬常抱冰，夏还握火。","book":"《吴越春秋·勾践归国外传》"}},{"id":7782,"word":"冬山如睡","pinyin":"dōng shān rú shuì","abbr":"dsrs","explanation":"冬天的山林象睡着了一样。形容冬天山林寂静的景象。","source":{"text":"真山水之烟岚，四时不同，春山澹冶而如笑，夏山苍翠而如滴，秋山明净而如妆，冬山惨淡而如睡。","book":"宋·郭熙《林泉高致·山水训》"}},{"id":7783,"word":"冬扇夏炉","pinyin":"dōng shàn xià lú","abbr":"dsxl","explanation":"冬天的扇子，夏天的火炉。比喻不合时宜。也比喻毫无用处的东西。","source":{"text":"作无益之能，纳无补之说，以夏进炉，以冬奏扇，为所不欲得之事，献所不欲闻之语，其不遇祸，幸矣，何福佑之有乎。","book":"东汉·王充《论衡·逢遇》"},"example":{"text":"他经常干～般的蠢事。"},"similar":["不合时宜"],"usage":"作主语、宾语、定语；比喻无用的东西"},{"id":7784,"word":"冬日之温","pinyin":"dōng rì zhī wēn","abbr":"drzw","explanation":"冬天城太阳的温暖。封建时代比喻君主的恩惠。","source":{"text":"君垂冬日之温，臣尽秋霜之戒。","book":"南朝·齐·王俭《褚渊碑文》"}},{"id":7785,"word":"冬日之阳","pinyin":"dōng rì zhī yáng","abbr":"drzy","explanation":"冬天里太阳的光和热。比喻人民所向往的仁政。","source":{"text":"王若欲求天下民，先设其利而自至，譬之若冬日之阳，夏日之阴，不召而民自来，此谓归德。","book":"《逸周书·大聚解》"}},{"id":7786,"word":"冬日可爱","pinyin":"dōng rì kě ài","abbr":"drka","explanation":"如同冬天里的太阳那样使人感到温暖、亲切。比喻人态度温和慈爱，使人愿意接近。","source":{"text":"赵衰，冬日之日也；赵盾，夏日之日也。”杜预注“冬日可爱，夏日可畏。","book":"春秋·鲁·左丘明《左传·文公七年》"},"example":{"text":"他一向给人以～的态度。"},"similar":["和蔼可亲"],"usage":"作谓语、定语；比喻人态度温和慈爱","story":["春秋时期，晋襄公死后，公子雍即位，太子夷皋是婴儿，他母亲就找大臣赵盾论理。赵盾担心秦国会出兵干预，结果还是引发两国战争。赵盾独断专行引起大夫贾季的不满。狄国侵犯鲁国，赵盾叫贾季去责问酆舒。酆舒说赵衰是冬日，赵盾是夏日"]},{"id":7787,"word":"冬日夏云","pinyin":"dōng rì xià yún","abbr":"drxy","explanation":"冬天的太阳，夏天的云层。比喻人态度温和可亲，使人愿意接近。","source":{"text":"本以正身，改德温温，如冬之日，如夏之云。","book":"宋·陈恬《程伯淳赞》"},"similar":["冬日可爱"],"usage":"作宾语、定语；指人的态度"},{"id":7788,"word":"冬日黑裘","pinyin":"dōng rì hēi qiú","abbr":"drhq","explanation":"裘：皮袄。冬天穿黑皮袄。比喻仅能御寒，不尚奢华。","source":{"text":"孙叔敖冬日黑裘，夏日葛衣。","book":"《礼记·檀弓》"}},{"id":7789,"word":"冬暖夏凊","pinyin":"dōng nuǎn xià jìng","abbr":"dnxq","explanation":"凊：凉。冬天使温暖，夏天使凉爽。比喻适合时用。","source":{"text":"古圣人制衣服也冬轻而暖，夏轻而凊。","book":"《晏子春秋·内篇·谏下》"}},{"id":7790,"word":"冬月无复衣","pinyin":"dōng yuè wú fù yī","abbr":"dywfy","explanation":"冬天没有第二件衣服可穿。形容家境贫寒。","source":{"text":"冬月无复衣，戴颙闻而迎之，为作衣服，并与钱一万。","book":"《宋书·沈道虔传》"}},{"id":7791,"word":"冬温夏凊","pinyin":"dōng wēn xià qìng","abbr":"dwxq","explanation":"凊：凉。冬天使父母温暖，夏天使父母凉爽。本指人子孝道。现亦泛称冬暖夏凉。","source":{"text":"凡为人子之礼，冬温而夏凊。","book":"《礼记·曲礼上》"},"example":{"text":"一望琼花争怒放。飞越群山，人喜从天降。宫阙常年观白浪，～真佳况。","book":"陈毅《蝶恋花·访问亚洲三国（一）》词"},"similar":["冬温夏清"],"usage":"作宾语、补语；指冬暖夏凉"},{"id":7792,"word":"冬温夏清","pinyin":"dōng wēn xià qīng","abbr":"dwxq","explanation":"冬天使父母温暖，夏天使父母凉爽。指人子孝道。亦泛称冬暖夏凉。","source":{"text":"冬温夏清，晓夕承奉。","book":"北魏《张猛龙碑》"},"similar":["冬温夏凊"],"usage":"作宾语、补语；指冬暖夏凉"},{"id":7793,"word":"冬烘先生","pinyin":"dōng hōng xiān shēng","abbr":"dhxs","explanation":"指昏庸浅陋的知识分子。","source":{"text":"主司头脑太冬烘，错认颜标作鲁公。","book":"五代·王定宝《唐摭言》卷八"},"example":{"text":"三家村的～，一年到头，一早到夜教村童。","book":"鲁迅《华盖集·并非闲话（三）》"},"similar":["冬烘学究"],"usage":"作宾语、定语；指知识分子","story":["唐朝时期，主考官郑薰先生在评卷时，见到颜标的卷子，他看了一遍觉得没有什么特别的地方，他想颜标是颜真卿的后代，应该让这个忠烈的后代作状元。谢恩的那天，郑薰才发现错认了颜标。后来人们评论：“主司头脑太冬烘，错认颜标作鲁公。”"]},{"id":7794,"word":"冬烘头脑","pinyin":"dōng hōng tóu nǎo","abbr":"dhtn","explanation":"冬烘：迂腐，浅陋。指头脑糊涂，迂腐，不明事理的人。","source":{"text":"主司头脑太冬烘，错认颜标作鲁公。","book":"五代·王定宝《唐摭言》卷八"},"example":{"text":"惨淡风云怜入彀，～怕当场。","book":"清·查慎行《残冬展假病榻消寒聊当呻吟语无伦次录存十六首》"}},{"id":7795,"word":"冬烘学究","pinyin":"dōng hōng xué jiū","abbr":"dhxj","explanation":"冬烘：形容懵懂，浅陋。指昏庸浅陋的知识分子。","source":{"text":"无奈应试者大抵是那一类脚色——冬烘学究，衙门蛀虫，又不能剥夺他们的考试权，只好让他们来考。","book":"茅盾《幻灭》"},"similar":["冬烘先生"],"usage":"作宾语、定语；指知识分子"},{"id":7796,"word":"冬箑夏炉","pinyin":"dōng zhá xià lú","abbr":"dsxl","explanation":"箑：扇子。冬天搧扇子，夏天生火炉。比喻做事不符合当时的需要，费了力气而得不到好处。","source":{"text":"知冬日之箑，夏日之裘，无用于己，则万物之变为尘埃矣。","book":"《淮南子·精神训》"},"example":{"text":"左春右秋，冰虫之见，生今反古，是～，乌乎能。","book":"清·张祥龄《词论》"}},{"id":7797,"word":"冬箑夏裘","pinyin":"dōng zhá xià qiú","abbr":"dsxq","explanation":"比喻不合时宜。","source":{"text":"知冬日之箑，夏日之裘，无用於己，则万物之变为尘埃矣。","book":"语出《淮南子·精神训》"},"similar":["冬扇夏炉"],"usage":"作主语、宾语、定语；用于处事"},{"id":7798,"word":"冬裘夏葛","pinyin":"dōng qiú xià gě","abbr":"dqxg","explanation":"裘：皮衣；葛：葛麻衣。泛指美服。","source":{"text":"士不及兹四者，则冬不裘，夏不葛。","book":"《公羊传·桓公七年》"},"example":{"text":"举得起，放得下，以便～的同它换衣服。","book":"清·吴趼人《痛史》第一回"},"usage":"作宾语、定语；泛指美服"},{"id":7799,"word":"冯唐头白","pinyin":"féng táng tóu bái","abbr":"fttb","explanation":"汉朝冯唐身历三朝，到武帝时，举为贤良，但年事已高不能为官。感慨生不逢时或表示年寿老迈。同“冯唐易老”。","source":{"text":"冯唐头白偏多感，倚遍天南百尺楼。","book":"明·汪广洋《登南海驿楼》诗"}},{"id":7800,"word":"冯唐已老","pinyin":"féng táng yǐ lǎo","abbr":"ftyl","explanation":"汉朝冯唐身历三朝，到武帝时，举为贤良，但年事已高不能为官。感慨生不逢时或表示年寿老迈。同“冯唐易老”。","source":{"text":"扬子《解嘲》徒自遣，冯唐已老复何论。","book":"唐·王维《重酬苑郎中》诗"},"example":{"text":"谢朓每篇堪讽诵，～听吹嘘。","book":"唐·杜甫《寄岑嘉州》诗"},"similar":["冯唐易老","冯唐白首"],"usage":"作宾语、定语；用于感慨人生","story":["西汉时期，书生冯唐饱读诗书，一生最大的愿望就是想当官，他亲历汉文帝、汉景帝、汉武帝三朝，都没有如他所愿。直到汉武帝时期，冯唐被推举为贤良，汉武帝也认为他有才学，但是他时年90岁了，白发斑斑，已经不能再任职了"]},{"id":7801,"word":"冯唐易老","pinyin":"féng táng yì lǎo","abbr":"ftyl","explanation":"汉朝冯唐身历三朝，到武帝时，举为贤良，但年事已高不能为官。感慨生不逢时或表示年寿老迈。","source":{"text":"嗟乎！时运不齐，命运多舛，冯唐易老，李广难封。","book":"唐·王勃《秋日登洪府滕王阁饯别序》"},"example":{"text":"～双蓬鬓，殷浩难投一纸书。","book":"元·吴景奎《寄苏伯夔诗》"},"similar":["冯唐已老"],"usage":"作宾语、定语；用于感慨人生","story":["“初唐四杰”的王勃因《檄英王鸡》得罪了唐高宗而被放逐，他到交趾探望父亲路经洪州，恰逢重阳节，洪州都督阎伯屿大宴宾客，吟诗作乐，王勃在席上即兴作《滕王阁序》感慨自己：“时运不齐，命运多舛，冯唐易老，李广难封。”"]},{"id":7802,"word":"冯唐白首","pinyin":"féng táng bái shǒu","abbr":"ftbs","explanation":"汉朝冯唐身历三朝，到武帝时，举为贤良，但年事已高不能为官。感慨生不逢时或表示年寿老迈。同“冯唐易老”。","source":{"text":"以孝文之明也，本朝之治，百寮之贤，而贾谊见逐，张释之十年不见省用，冯唐白首，屈于郎署，岂不惜哉！","book":"汉·荀悦《汉纪文帝纪下》"},"example":{"text":"庆孟光齐眉，～，镇同欢笑。","book":"宋·晁补之《引驾行·永嘉郡君生日》词"},"similar":["冯唐易老"],"usage":"作宾语、定语；用于感慨人生","story":["西汉时期，书生冯唐饱读诗书，一生最大的愿望就是想当官，他亲历汉文帝、汉景帝、汉武帝三朝，都没有如他所愿。直到汉武帝时期，冯唐被推举为贤良，汉武帝也认为他有才学，但是他时年90岁了，白发斑斑，已经不能再任职了"]},{"id":7803,"word":"冯妇下车","pinyin":"féng fù xià chē","abbr":"ffxc","explanation":"冯妇下车来，重新干捉虎的事。比喻重操旧业的人。","source":{"text":"晋人有冯者，善搏虎，卒为善士。则之野，有从逐虎。虎负嵎，莫之敢撄。望见冯妇，趋而迎之。冯妇攘而下车，众皆悦之，其为士者笑之。","book":"《孟子·尽心下》"},"example":{"text":"笠翁不拾唾余，今于饮食之中，现增一副依样葫芦矣！～，请戒其始。","book":"清·李渔《闲情偶寄·饮馔部·糕饼》"}},{"id":7804,"word":"冯河暴虎","pinyin":"féng hé bào hǔ","abbr":"fhbh","explanation":"犹言暴虎冯河。比喻有勇无谋，鲁莽冒险。","source":{"text":"抱头鼠窜者胆裂之不暇，冯河暴虎者虚骄而无实。","book":"清·魏源《道光洋艘征抚记》"},"similar":["暴虎冯河"],"usage":"作谓语、定语、分句；比喻有勇无谋"},{"id":7805,"word":"冯生弹铗","pinyin":"féng shēng dàn jiá","abbr":"fsdj","explanation":"指怀才不遇或有才华的人希望得到恩遇。","source":{"text":"参见“冯驩弹铗”。"},"example":{"text":"张掾秋风频怅望，～未归来。","book":"清·钱芳标《击鲜行》"},"similar":["冯驩弹铗"],"usage":"作宾语、定语；用于书面语","story":["战国时期，齐国相国孟尝君的门客冯驩因不受重视，三次弹其铗而唱歌：“长铗归来乎！食无鱼！出无车！无以为家！”孟尝君听后，深受感动，一一满足他的要求。冯驩借去薛地收债的机会为孟尝君谋划，营造三窟，使孟尝君在失势后也能立于不败之地"]},{"id":7806,"word":"冯谖三窟","pinyin":"féng xuān sān kū","abbr":"fxsk","explanation":"冯谖：冯驩，战国时孟尝君的门客；窟：窝。比喻为安全设置多处藏身之地或采取多种避祸之策。","source":{"text":"深蒙薛公折节之礼，而无冯谖三窟之效。","book":"三国·魏·吴质《答东阿王书》"},"similar":["狡兔三窟"],"usage":"作宾语、定语；用于口语","story":["战国时期，齐国相国孟尝君叫门客冯谖去薛地收债。冯谖假借他的命令把债契全部烧毁，借债的百姓对孟尝君感激涕零。冯谖回来说：“狡兔有三窟，仅得免其死耳；今君有一窟，未得高枕而卧也。”他为孟尝君经营三窟，使孟尝君受到齐王的重用"]},{"id":7807,"word":"冯驩弹铗","pinyin":"féng xuān dàn jiá","abbr":"fhdj","explanation":"指怀才不遇或有才华的人希望得到恩遇。冯驩，即齐人冯谖。驩，在此念xuān，不念huān。","source":{"text":"据《战国策·齐策四》载，齐人冯谖（《史记·孟尝君列传》引作“冯驩”）为孟尝君门客，不受重视。冯三弹其铗而歌，一曰：“长铗归来乎！食无鱼！”二曰：“长铗归来乎！出无车！”三曰：“长铗归来乎！无以为家！”孟尝君一一满足……。"},"example":{"text":"博士乘车依鄠杜，～老平原。","book":"清·蒲松龄《赠毕子韦仲》诗"},"similar":["冯生弹铗"],"usage":"作宾语、定语；用于书面语","story":["战国时期，齐国相国孟尝君的门客冯驩因不受重视，三次弹其铗而唱歌：“长铗归来乎！食无鱼！出无车！无以为家！”孟尝君听后，深受感动，一一满足他的要求。冯驩借去薛地收债的机会为孟尝君谋划，营造三窟，使孟尝君在失势后也能立于不败之地"]},{"id":7808,"word":"冯髈弹铗","pinyin":"féng huān dàn jiá","abbr":"fhdj","explanation":"指怀才不遇或有才华的人希望得到恩遇。","quote":{"text":"博士乘车依鄠杜，～老平原。","book":"清·蒲松龄《赠毕子韦仲》诗"}},{"id":7809,"word":"冰冻三尺，非一日之寒","pinyin":"bīng dòng sān chǐ，fēi yī rì zhī hán","abbr":"bdscfyrzh","explanation":"比喻一种情况的形成，是经过长时间的积累、酝酿的。","source":{"text":"冰厚三尺，非一日之寒。","book":"明·兰陵笑笑生《金瓶梅词话》第九十二回"},"example":{"text":"～，大局坏到如此，也不是一个人，两个人的错。","book":"高阳《胭脂井》"},"similar":["滴水穿石","铁杵磨针"],"opposite":["浅尝辄止"],"usage":"作宾语、定语、分句；比喻事态的严重不是一"},{"id":7810,"word":"冰厚三尺，非一日之寒","pinyin":"bīng hòu sān chǐ，fēi yī rì zhī hán","abbr":"bhscfyrzh","explanation":"非：不是；寒：冷。冰冻到三尺厚，不是一天冷造成的。比喻某一种情况的形成，是经过长时间酝酿、积累的结果。","source":{"text":"故夫河冰结合，非一日之寒；积土成山，非斯须之作。","book":"东汉·王充《论衡·壮留》"},"example":{"text":"这中原天气十分冷，～也。","book":"明·朱有燉《赛娇容》第四折"},"similar":["冰冻三尺，非一日之寒"],"opposite":["浅尝辄止"],"usage":"作宾语、定语、分句；用于比喻句"},{"id":7811,"word":"冰壑玉壶","pinyin":"bīng hè yù hú","abbr":"bhyh","explanation":"壑：深沟。像冰那样清澈的深山沟里的水，盛在晶莹的玉壶里。比喻人节操高尚，品性高洁。","source":{"text":"窦侍御，骥之子，凤之雏，年未三十，忠义俱，骨绠绝代无，炯如一段清水出万壑，置在迎风露寒之玉壶。","book":"唐·杜甫《入奏行赠西山检察窦侍御》"},"example":{"text":"一闻～之韵。","book":"宋·胡继宗《书言故事·颜貌类》"}},{"id":7812,"word":"冰壶玉尺","pinyin":"bīng hú yù chǐ","abbr":"bhyc","explanation":"玉尺：玉制的尺。比喻高尚纯洁的人品。","source":{"text":"君子称其清风高节，如冰壶玉尺，纤尘弗污。","book":"《元史·黄溍传》"},"similar":["冰壶玉衡"],"usage":"作宾语、定语；用于夸奖人"},{"id":7813,"word":"冰壶玉衡","pinyin":"bīng hú yù héng","abbr":"bhyh","explanation":"冰壶：冰心玉壶；玉衡：用宝石装饰的天文仪器。比喻高尚的品质，优雅的气质。","source":{"text":"金钟大镛往东序，冰壶玉衡县清秋。","book":"唐·杜甫《寄裴施州》"},"similar":["冰壶玉尺"],"usage":"作宾语、定语；用于夸奖人"},{"id":7814,"word":"冰壶秋月","pinyin":"bīng hú qiū yuè","abbr":"bhqy","explanation":"冰壶：盛水的玉壶，比喻洁白。比喻洁白明净。多指人的品格。","source":{"text":"布衫漆黑手如龟，未害冰壶贮秋月。","book":"宋·苏轼《赠潘谷》诗"},"example":{"text":"愿中如～，莹彻无瑕，非吾曹所及。","book":"《宋史·李侗传》"},"similar":["冰清玉洁"],"opposite":["雕心雁爪"],"usage":"作宾语、定语；比喻品德高尚"},{"id":7815,"word":"冰壸秋月","pinyin":"bīng kǔn qiū yuè","abbr":"bkqy","explanation":"比喻人品德清白廉洁。","source":{"text":"布衫漆黑手如龟，未害冰壶贮秋月。","book":"宋·苏轼《赠潘谷》诗"},"example":{"text":"愿中如～，莹彻无瑕，非吾曹所及。","book":"《宋史·李侗传》"}},{"id":7816,"word":"冰天雪地","pinyin":"bīng tiān xuě dì","abbr":"btxd","explanation":"形容冰雪漫天盖地。","source":{"text":"冰天雪地风如虎，裸而泣者无栖所。","book":"清·蒋士铨《鸡毛房》"},"example":{"text":"你就在这儿吧，～的上哪儿去？","book":"老舍《骆驼祥子》十二"},"similar":["天寒地冻","千里冰封"],"opposite":["冰雪消融","大地回春"],"usage":"作定语、宾语；用于严冬季节"},{"id":7817,"word":"冰天雪窑","pinyin":"bīng tiān xuě jiào","abbr":"btxy","explanation":"到处是冰和雪。指严寒地区。","source":{"text":"叹马角之未生，魂消雪窑；攀龙髯而莫逮，泪洒冰天。","book":"《宋史·朱弁传》"},"similar":["冰天雪窖"],"usage":"作定语、宾语；形容极为寒冷"},{"id":7818,"word":"冰天雪窖","pinyin":"bīng tiān xuě jiào","abbr":"btxj","explanation":"形容极为寒冷。","source":{"text":"公子编修汝舟随侍，劝以节劳暂息。公慨然曰：‘二万里冰天雪窖，只身荷戈，未尝言苦，此时反惮劳乎？’","book":"清·陈康祺《郎潜纪闻》第四卷"},"example":{"text":"在这～的寒冷天气里，任何细菌是难以生存的。"},"similar":["冰天雪地"],"opposite":["冰雪消融"],"usage":"作定语、宾语；形容极为寒冷"},{"id":7819,"word":"冰寒于水","pinyin":"bīng hán yú shuǐ","abbr":"bhys","explanation":"冰比水冷。指后来居上。比喻学生胜过老师。","source":{"text":"冰，水为之，而寒于水。","book":"荀子《劝学》"},"example":{"text":"蘧（道愍）始师章（继伯），～。","book":"唐·张彦远《历代名画记·七·南齐》：“”"},"similar":["后来居上","青胜于蓝"],"usage":"作谓语、宾语；用于劝诫人"},{"id":7820,"word":"冰寒雪冷","pinyin":"bīng hán xuě lěng","abbr":"bhxl","explanation":"像冰雪一样寒冷。比喻冷酷无情。","source":{"text":"今日公竟然做出这件事来，可知天下男子之心真是冰雪寒冷，令人切齿的。","book":"清·曹雪芹《红楼梦》第九十七回"}},{"id":7821,"word":"冰山一角","pinyin":"bīng shān yī jiǎo","abbr":"bsyj","explanation":"比喻暴露出来的部分只是事物的一小部分，大部分还隐藏着。"},{"id":7822,"word":"冰山易倒","pinyin":"bīng shān yì dǎo","abbr":"bsyd","explanation":"冰山遇到太阳就消溶，容易倒塌。比喻不能长久依赖的靠山。","source":{"text":"那越公虽待我不薄，奈他年寿无多，冰山易倒，未可久留。","book":"《蝴蝶媒》第十三回"},"example":{"text":"人们纷纷投靠宰相杨国忠，张彖却认为～，决不依附权贵。"}},{"id":7823,"word":"冰山难靠","pinyin":"bīng shān nán kào","abbr":"bsnk","explanation":"比喻不能长久的权势，难于依靠。","source":{"text":"君辈倚杨右相如泰山，吾以为冰山耳！若皎日既出，君辈得无失所恃乎？","book":"宋·司马光《资治通鉴·唐玄宗天宝十一年》"},"example":{"text":"依靠他的权势就等于～。"},"similar":["冰山易倒"],"opposite":["泰山可倚"],"usage":"作宾语、定语；用于劝诫人","story":["唐玄宗李隆基十分宠爱杨贵妃，杨玉环的族兄杨钊（杨国忠）被任命为宰相，很多官吏纷纷给杨国忠送礼，投靠他。有人劝说陕西进士张彖去投靠杨国忠，张彖说：“杨国忠只不过是一座冰山，总有一天会化掉的。”就去嵩山隐居"]},{"id":7824,"word":"冰弦玉柱","pinyin":"bīng xián yù zhù","abbr":"bxyz","explanation":"筝和美称。","source":{"text":"冰弦玉柱声嘹亮，鸾笙象管音飘荡。","book":"清·洪昇《长生殿·舞盘》"}},{"id":7825,"word":"冰心一片","pinyin":"bīng xīn yī piàn","abbr":"bxyp","explanation":"冰心：清洁的心。形容性情淡泊，不求名利。","source":{"text":"洛阳亲友如相问，一片冰心在玉壶。","book":"唐·王昌龄《芙蓉楼送辛渐》诗"},"example":{"text":"钓鱼钓晴还钓雪，～已忘机。","book":"清·陈壁《题钓台四绝》"}},{"id":7826,"word":"冰散瓦解","pinyin":"bīng sàn wǎ jiě","abbr":"bswj","explanation":"比喻完全消失或彻底崩溃。","source":{"text":"比及三年，左提右挈，虏必冰散瓦解，安受其弊，可坐算而得也。","book":"《三国志魏志傅嘏传》“嘏对曰”裴松之注引晋司马彪《战略》"},"similar":["冰消瓦解"],"usage":"作谓语、定语；指消失"},{"id":7827,"word":"冰柱雪车","pinyin":"bīng zhù xuě chē","abbr":"bzxc","explanation":"原为唐朝刘义的两首诗名。后用以赞美别人的诗文优美。","source":{"text":"闻愈接天下士，步归之，作冰柱、雪车二诗，出卢仝、孟郊右。","book":"《新唐书·韩愈传附刘义传》"},"example":{"text":"称人诗好，曰～之句。","book":"宋·胡继宗《书言故事·诗词赋类》"},"usage":"作宾语、定语；指好诗"},{"id":7828,"word":"冰洁渊清","pinyin":"bīng jié yuān qīng","abbr":"bjyq","explanation":"犹冰清玉洁。","source":{"text":"君禀乾纲之正性，蹈高世之殊轨，冰洁渊清，介然特立。","book":"汉·孔融《卫尉张俭碑》"},"example":{"text":"太中大夫管宁，应二仪之中和，总九德之纯懿，含章素质，～。","book":"《三国志·魏志·管宁传》"},"similar":["冰清玉洁"],"usage":"作谓语、定语；形容人品高尚"},{"id":7829,"word":"冰洁玉清","pinyin":"bīng jié yù qīng","abbr":"bjyq","explanation":"比喻德行高洁。","source":{"text":"猗猗茂才，执节云停，志励秋霜，冰洁玉清。","book":"《初学记》卷宗十七引《吴先贤传·故扬州别驾从事戴矫传赞》"},"similar":["冰清玉洁"],"usage":"作谓语、状语；形容人品高尚、操行清白"},{"id":7830,"word":"冰消云散","pinyin":"bīng xiāo yún sàn","abbr":"bxys","explanation":"比喻事物消失瓦解。","source":{"text":"我看当时的情况，好像阎长官满肚子的勇气，被郭宗汾的这一席话，说得冰消云散了。","book":"续范亭《三年不言之言》"},"similar":["冰消雾散"],"usage":"作谓语、定语、状语；指事物消失"},{"id":7831,"word":"冰消冻解","pinyin":"bīng xiāo dòng jiě","abbr":"bxdj","explanation":"比喻完全消失或彻底崩溃。","source":{"text":"见得大处分明，这许多小小病痛，都是冰消冻解，无有痕迹矣。","book":"《朱子全书》卷四"},"example":{"text":"昨见公，令我两个月心事顿然～也。乃知向之劝我者，只为我添油炽薪耳。","book":"明·李贽《与曾中野书》"},"similar":["冰解冻释"],"usage":"作谓语、定语；形容困难与障碍得以解决"},{"id":7832,"word":"冰消冻释","pinyin":"bīng xiāo dòng shì","abbr":"bxds","explanation":"比喻困难或障碍像冰融化那样消释。","source":{"text":"而此数十年深锢牢结之弊，一旦豁然，冰消冻释。","book":"宋·朱熹《论差役利害状》"},"similar":["冰消冻解"],"usage":"作谓语、定语；形容困难与障碍得以解决"},{"id":7833,"word":"冰消气化","pinyin":"bīng xiāo qì huà","abbr":"bxqh","explanation":"消：消融。冰冻消融，化为乌有。形容事物消失化解，不复存在。","example":{"text":"这事就让它～吧，不要再提了。"},"similar":["冰消雾散"],"usage":"作谓语、定语；指事物消失"},{"id":7834,"word":"冰消瓦解","pinyin":"bīng xiāo wǎ jiě","abbr":"bxwj","explanation":"冰一样地消融，瓦一样地分解。比喻完全消失或彻底崩溃。","source":{"text":"于是玄气仰散，归云四聚；冰消瓦解，奕奕翩翩。","book":"晋·成公绥《云赋》"},"example":{"text":"韩夫人喜不自胜，将一天愁闷，已～了。","book":"明·冯梦龙《醒世恒言》卷十三"},"similar":["土崩瓦解","烟消云散"],"opposite":["重起炉灶","东山再起"],"usage":"作谓语；用于误会、矛盾迅速消除"},{"id":7835,"word":"冰消雪释","pinyin":"bīng xiāo xuě shì","abbr":"bxxs","explanation":"比喻事物消失瓦解。","source":{"text":"父亲已经在楼梯口那里等她，好像原想申斥她几句，看到她便什么都冰消雪释的样子，只在急急地问她是不是医院出了什么事。","book":"靳以《被煎熬的心》"},"example":{"text":"至此，我们已经获得了充分的谅解，并从心底深处感到在一起谈一谈是件很愉快的事。最初的对立早已～了。","book":"《十月》1981年第1期"},"similar":["冰消雾散"],"usage":"作谓语、定语；指事物消失"},{"id":7836,"word":"冰消雾散","pinyin":"bīng xiāo wù sàn","abbr":"bxws","explanation":"比喻事物消失瓦解。","source":{"text":"遂得谷静山空，冰消雾散。","book":"北周·庾信《周大将军琅邪定公司马裔墓志铭》"},"example":{"text":"在这～的时刻，我们赶紧拍照吧。"},"similar":["冰解云散","冰消云散","冰销雾散"],"usage":"作谓语、定语；指事物消失"},{"id":7837,"word":"冰清水冷","pinyin":"bīng qīng shuǐ lěng","abbr":"bqsl","explanation":"指冷冷清清。","source":{"text":"这冰清水冷的苦楚，如何捱得过？","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"example":{"text":"我们这个番禺县，又是有各的好缺，衙门里却是～。","book":"《九命奇冤》第20回"},"similar":["冷冷清清"],"usage":"作定语、补语；指生活清寒"},{"id":7838,"word":"冰清玉洁","pinyin":"bīng qīng yù jié","abbr":"bqyj","explanation":"象冰那样清澈透明，象玉那样洁白无瑕。比喻人的操行清白（多用于女子）。","source":{"text":"伏唯伯陵材能绝人，高尚其志，以善厥身，冰清玉洁，不以细行。","book":"汉·司马迁《与挚伯陵书》"},"example":{"text":"我这一去～，干事回还，管着你们喝采他。","book":"元·无名氏《陈州粜米》楔子"},"similar":["冰清玉润","水洁冰清"],"opposite":["浅尝辄止"],"usage":"作谓语、状语；形容人品高尚、操行清白"},{"id":7839,"word":"冰清玉润","pinyin":"bīng qīng yù rùn","abbr":"bqyr","explanation":"润：滋润。象冰一样晶莹，如玉一般润泽。原指晋乐广卫玠翁婿俩操行洁白。后常比喻人的品格高洁。","source":{"text":"妻父有冰清之姿，婿有璧润之望。","book":"南朝·宋·刘义庆《世说新语·言语》刘孝标注引《卫玠别传》：“裴叔道曰"},"example":{"text":"南朝·宋·刘义庆《世说新语·言语》刘孝标注引《卫玠别传》：“裴叔道曰：“妻父有冰清之姿，婿有璧润之望。”"},"similar":["冰清玉洁"],"usage":"作谓语、定语；指人品"},{"id":7840,"word":"冰清玉粹","pinyin":"bīng qīng yù cuì","abbr":"bqyc","explanation":"比喻德行高洁。","source":{"text":"原宪玄默，冰清玉粹。志逸九霄，身安陋术。","book":"《初学记》卷十七引晋孙绰《原宪赞》"},"similar":["冰清玉洁"],"usage":"作谓语、状语；形容人品高尚"},{"id":7841,"word":"冰炭不同器","pinyin":"bīng tàn bù tóng qì","abbr":"btbtq","explanation":"冰和炭火不能放在同一个器具里。比喻性质不同的事物彼此排斥，不能相容。","source":{"text":"夫冰炭不同器而久，寒暑不兼时而至。杂反之学不两立而治。","book":"《韩非子·显学》"},"example":{"text":"岂不闻～，也似咱愚不并居。","book":"《元曲选·渔樵记》一折"},"similar":["水火不容","势不两立"],"opposite":["和睦相处","和平共处"],"usage":"作宾语、定语、分句；形容两种对立的事物"},{"id":7842,"word":"冰炭不同炉","pinyin":"bīng tàn bù tóng lú","abbr":"btbtl","explanation":"比喻两种对立的事物不能同处。","source":{"text":"休把我衣服扯住，情知咱冰炭不同炉。","book":"元·关汉卿《鲁斋郎》第三折"},"example":{"text":"你深思虑，因何难共处？岂不闻～。","book":"明·贾仲名《对玉梳》第三折"},"similar":["势不两立","冰炭不同器"],"opposite":["和平共处"],"usage":"作宾语、定语、分句；形容两种对立的事物"},{"id":7843,"word":"冰炭不投","pinyin":"bīng tàn bù tóu","abbr":"btbt","explanation":"比喻彼此合不来。","source":{"text":"夫冰炭不同器而久，寒暑不兼时而至。杂反之学不两立而治。","book":"《韩非子·显学》"},"example":{"text":"《韩非子·显学》：“夫冰炭不同器而久，寒暑不兼时而至。杂反之学不两立而治。”"},"similar":["冰炭不同器"],"opposite":["水乳交融"],"usage":"作谓语、宾语；指彼此不相容"},{"id":7844,"word":"冰炭不相容","pinyin":"bīng tàn bù xiāng róng","abbr":"btbxr","explanation":"冰：冰块；炭：炭火。比喻两种对立的事物不能并存。","source":{"text":"君不见，牛奇章与李卫公，一生冰炭不相容。","book":"宋·陆游《寄题李季章侍郎石林堂》诗"},"example":{"text":"有一派人说：革命和文学是～的，这两个东西根本不能并立。","book":"郭沫若《革命与文学》"},"similar":["冰炭不同器","水火不容"],"opposite":["和平共处"],"usage":"作分句、宾语、定语；形容对立的事物"},{"id":7845,"word":"冰炭不言，冷热自明","pinyin":"bīng tàn bù yán，lěng rè zì míng","abbr":"btbylrzm","explanation":"比喻内心的诚意不用表白，必然表现在行动上。","source":{"text":"尧、舜、周公所以能致忠谏者，以其款诚之心者也，冰炭不言，而冷热之质自明者，以其有实也。","book":"《晋书·王沈传》"},"usage":"作宾语、定语、分句；用于口语"},{"id":7846,"word":"冰炭同器","pinyin":"bīng tàn tóng qì","abbr":"bttq","explanation":"比喻两种人或两类事物虽然存在于一个地方，但性情各异。","source":{"text":"禽鱼之结侣，冰炭之同器，欲其久合，安可得乎？","book":"晋·葛洪《抱朴子》"}},{"id":7847,"word":"冰炭相爱","pinyin":"bīng tàn xiāng ài","abbr":"btxa","explanation":"爱：亲近。冰和炭互相接近。比喻互相救助。","source":{"text":"天下莫相憎于胶漆，而莫相爱于冰炭，胶漆相贼，冰炭相息也。","book":"《淮南子·说山训》"}},{"id":7848,"word":"冰瓯雪椀","pinyin":"bīng ōu xuě wǎn","abbr":"boxw","explanation":"瓯：水盂；椀：水碗。晶莹透亮的水盂，纯净洁白的水碗。指质地纯净的洗涤毛笔的工具。","source":{"text":"杨徽之诗，太宗写其警句十联于御屏上，僧文宝云：‘必以天池浩露，涤笔于冰瓯雪椀中，方与此诗相副。’","book":"《有宋嘉话》"},"usage":"作宾语、定语；指笔洗"},{"id":7849,"word":"冰肌玉骨","pinyin":"bīng jī yù gǔ","abbr":"bjyg","explanation":"冰：晶莹。肌骨如同冰玉一般。形容女子肌肤莹洁光滑。","source":{"text":"冰肌玉骨，自清凉无汗。","book":"《庄子·逍遥游》：“藐姑射之山，有神人居焉，肌肤若冰雪，绰约若处子。”宋·苏轼《洞仙歌》词"},"example":{"text":"换却～胎，丹心吐出异香来。","book":"元·张寿卿《红梨花》第二折"},"similar":["玉骨冰肌","冰姿玉骨"],"usage":"作谓语、定语；形容梅、水仙、荷花等鲜艳"},{"id":7850,"word":"冰肌雪肠","pinyin":"bīng jī xuě cháng","abbr":"bjxc","explanation":"比喻身心洁白，没有污点。","source":{"text":"［玉交枝］东林伯仲，俺青楼皆知敬重。干儿冰肌雪肠原自同，铁心石腹何愁冻。吐不尽鹃血满胸。吐不尽鹃血满胸。","book":"清·孔尚任《桃花扇·筵席》"},"example":{"text":"她有一颗～般的心。"},"similar":["冰魂雪魄"],"usage":"作谓语、定语、宾语；指人的身心"},{"id":7851,"word":"冰肌雪肤","pinyin":"bīng jī xuě fū","abbr":"bjxf","explanation":"像冰一样的肌肤。形容女子洁美的体肤。","source":{"text":"鼓罢复出其二子，长者九岁，冰肌雪肤，瞳翦秋水，中原未之见也。","book":"清·魏源《澳门花园听夷女洋琴歌·序》"},"similar":["冰肌玉骨"],"usage":"作谓语、定语；多用于女性"},{"id":7852,"word":"冰解云散","pinyin":"bīng jiě yún sàn","abbr":"bjys","explanation":"比喻事物消失瓦解。","source":{"text":"虽分四总管以固捍御，委长安、建康之守以募勤王，天下冰解云散，一城之地，劫制于虏，而号令不能及矣。","book":"宋·叶適《纪纲三》"},"similar":["冰消雾散"],"usage":"作谓语、定语；指事物消失"},{"id":7853,"word":"冰解冻释","pinyin":"bīng jiě dòng shì","abbr":"bjds","explanation":"如同冰冻融化一般。比喻困难或障碍消除。","source":{"text":"是乃所谓冰释冻释者能乎？","book":"《庄子·庚桑楚》"},"example":{"text":"复取程氏书虚心平气而读之，未乃数行，～。","book":"《朱子全书·中庸》"},"similar":["土崩瓦解","烟消云散","冰消冻释"],"usage":"作谓语、定语；形容困难与障碍得以解决"},{"id":7854,"word":"冰解壤分","pinyin":"bīng jiě rǎng fēn","abbr":"bjrf","explanation":"冰冻消融，土壤分解。比喻障碍消除。","source":{"text":"高邮王氏，以其绝学释姬汉古书，冰解壤分，无所凝滞，信哉千五百年未有其人也。","book":"章炳麟《正名杂义》"},"similar":["冰解的破"],"usage":"作谓语、定语；指解决问题"},{"id":7855,"word":"冰解的破","pinyin":"bīng jiě dì pò","abbr":"bjdp","explanation":"冰冻融解，箭靶射中。比喻问题解决，障碍消除。","source":{"text":"惟校雠之学，我朝独为卓绝，乾嘉间巨儒辈出，讲求音声故训，校勘疑误，冰解的破，度越前世矣。","book":"清·曾国藩《序》"},"similar":["冰解壤分"],"usage":"作谓语、定语；指解决问题"},{"id":7856,"word":"冰释理顺","pinyin":"bīng shì lǐ shùn","abbr":"bsls","explanation":"释：消化；顺：通顺。冰层消融，理路通顺。比喻疑问都解开了，道理也讲通了。","source":{"text":"焕然冰释，怡然理顺，然后为得也。","book":"晋·杜预《春秋左氏传序》"}},{"id":7857,"word":"冰销叶散","pinyin":"bīng xiāo yè sàn","abbr":"bxys","explanation":"比喻事物消失瓦解。","source":{"text":"若王师一临，旧章暂睹，自应解甲倒戈，冰销叶散。","book":"《隋书·越王侗传》"},"similar":["冰消雾散"],"usage":"作谓语、定语；指事物消失"},{"id":7858,"word":"冰销雾散","pinyin":"bīng xiāo wù sàn","abbr":"bxws","explanation":"比喻事物消失瓦解。","source":{"text":"鄩复问云：‘彼之聚敛丰盈，何以遽令散去？’云：‘先得计于安品子，其余冰销雾散。’","book":"唐·康骈《剧谈录·郭鄩见穷鬼》"},"similar":["冰消雾散"],"usage":"作谓语、定语；指事物消失"},{"id":7859,"word":"冰雪严寒","pinyin":"bīng xuě yán hán","abbr":"bxyh","explanation":"严寒：极度寒冷。冰天雪地，天气寒冷。","source":{"text":"吴伯箫《菜园小记》“虽然按照时令季节，各种蔬菜种得有早有晚，有时收了这种菜才种那种菜；但是除了冰雪严寒的冬天，一年里春夏秋三季，菜园里总是经常有几种蔬菜在竞肥争绿的。”"}},{"id":7860,"word":"冰雪聪明","pinyin":"bīng xuě cōng míng","abbr":"bxcm","explanation":"比喻人聪明非凡。","source":{"text":"冰雪净聪明，雷霆走精锐。","book":"唐·杜甫《送樊二十三侍御赴汉中判官》诗"},"example":{"text":"以～的文章，写雷霆精锐的思想，这种议论，就容易动人听闻了。","book":"清·曾朴《孽海花》第十回"},"similar":["聪明伶俐"],"opposite":["愚昧无知"],"usage":"作谓语、定语；形容人很纯洁聪明"},{"id":7861,"word":"冰魂素魄","pinyin":"bīng hún sù pò","abbr":"bhsp","explanation":"形容清白纯洁的品质。","source":{"text":"俺本是广寒宫冰魂素魄，怎比那阎浮世浊骨凡胎。","book":"元·吴昌龄《张天师》第四折"},"similar":["冰魂雪魄"],"usage":"作定语、宾语；形容人品纯洁"},{"id":7862,"word":"冰魂雪魄","pinyin":"bīng hún xuě pò","abbr":"bhxp","explanation":"冰、雪：如冰的透明，雪的洁白。比喻人品质高尚纯洁。","source":{"text":"忍苦为诗身到此，冰魂雪魄已难招。","book":"五代·王定保《唐摭言》卷十"},"example":{"text":"广寒宫里长征药，医得～回。","book":"宋·陆游《北坡梅》诗"},"similar":["冰清玉洁","冰壶秋月"],"usage":"作定语、宾语；形容人品纯洁"},{"id":7863,"word":"冲云破雾","pinyin":"chōng yún pò wù","abbr":"cypw","explanation":"冲破云层，突破迷雾。比喻突破重重障碍和困难。"},{"id":7864,"word":"冲冠发怒","pinyin":"chōng guàn fā nù","abbr":"cgfn","explanation":"形容极为愤怒。","source":{"text":"凡献艺者，岂自疑于无必。冲冠发怒，扬鞭气逸，引满雷砰，腾凌飙疾，皆穷百中之妙，尽由一孔而出，乃知来者之艺，盖亦前人之匹。","book":"唐·元稹《观兵部马射赋》"},"similar":["冲冠怒发"],"usage":"作谓语、定语；用于愤怒时"},{"id":7865,"word":"冲冠怒发","pinyin":"chōng guàn nù fà","abbr":"cgnf","explanation":"形容极为愤怒。","source":{"text":"而畋冲冠怒发，投袂冶兵，罗剑戟于樽前，练貔貅于阃外。","book":"《旧唐书·郑畋传》"},"similar":["怒发冲冠"],"usage":"作谓语、定语；用于愤怒时"},{"id":7866,"word":"冲冠眦裂","pinyin":"chōng guàn zì liè","abbr":"cgzl","explanation":"形容愤怒到极点。眦裂，睁裂眼眶。","source":{"text":"哙即带剑拥盾入军门……瞋目视项王，头发上指，目眦尽裂。","book":"语出《史记·项羽本纪》"},"example":{"text":"见先将军呈谏割地之案，不觉～。","book":"明·刘若愚《酌中志·辽左弃地》"},"usage":"作谓语、定语、状语；用于愤怒时"},{"id":7867,"word":"冲口而出","pinyin":"chōng kǒu ér chū","abbr":"ckec","explanation":"冲口：脱口，一下子说出。形容不加思索地说出来。","source":{"text":"此数十纸，皆文公冲口而出，纵手而成，初不加意者也。","book":"宋·苏轼《跋欧阳公书》"},"example":{"text":"无如他此时是满怀的遂心快意，满面的吐气扬眉，话挤话不由得～。","book":"清·文康《儿女英雄传》第三十七回"},"similar":["脱口而出","心直口快"],"opposite":["守口如瓶"],"usage":"作谓语；形容说话随便"},{"id":7868,"word":"冲口而发","pinyin":"chōng kǒu ér fā","abbr":"ckef","explanation":"不加思索地说出口来。","source":{"text":"滑稽排调，冲口而发，既能解颐，亦可刺骨。","book":"明·李贽《焚书·李温陵传》"},"similar":["冲口而出"],"usage":"作谓语；形容说话随便"},{"id":7869,"word":"冲坚毁锐","pinyin":"chōng jiān huǐ ruì","abbr":"cjhr","explanation":"冲破敌人坚固的营垒，摧毁敌人精锐的部队。形容军队锐不可当。也形容攻克难关。","source":{"text":"锥行者，所以冲坚毁锐也。","book":"《孙膑兵法·威王问》"},"similar":["冲锋陷阵"],"usage":"作谓语、定语；指力量大"},{"id":7870,"word":"冲坚陷阵","pinyin":"chōng jiān xiàn zhèn","abbr":"cjxz","explanation":"冲：冲击；陷：攻陷；陷阵：攻破，深入敌阵。向敌人冲锋，深入敌人阵地。形容作战勇猛。","source":{"text":"景宗为偏将，每冲坚陷阵，辄有所获，以勋除游击将军。","book":"《梁书·曹景宗传》"},"similar":["冲锋陷阵"],"usage":"作谓语、宾语、定语；形容作战勇敢"},{"id":7871,"word":"冲州撞府","pinyin":"chōng zhōu zhuàng fǔ","abbr":"czzf","explanation":"冲到州里，撞到府里。指在外到处奔走。","source":{"text":"冲州撞府妆旦色，走南投北俏郎君。","book":"宋·古杭才人《宦门子弟错立身·题目》"},"example":{"text":"他们是～，逢场作戏，陪了多少小心得来的钱物。","book":"明·施耐庵《水浒会传》第二十七回"},"similar":["冲州过府"],"usage":"作谓语；指漂泊"},{"id":7872,"word":"冲州过府","pinyin":"chōng zhōu guò fǔ","abbr":"czgf","explanation":"指跑码头，闯江湖。也形容经历丰富，见过世面。","source":{"text":"夫妻一世，冲州过府，在江湖上赶营生。","book":"《天花雨》第二回"},"similar":["冲州撞府"],"usage":"作谓语；指漂泊"},{"id":7873,"word":"冲弱寡能","pinyin":"chōng ruò guǎ néng","abbr":"crgn","explanation":"冲弱：幼小。幼稚而缺乏才能。","source":{"text":"吾冲弱寡能，未明理道。","book":"南朝·梁·萧纲《复临丹阳教》"}},{"id":7874,"word":"冲昏头脑","pinyin":"chōng hūn tóu nǎo","abbr":"chtn","explanation":"因胜利而头脑发热，不能总冷静思考和谨慎行事。","source":{"text":"胜利之后，也不‘万事大吉’，不可冲昏头脑，否则还可能丧失胜利的果实。","book":"李欣《“无限风光在险峰”》"},"example":{"text":"你不能被胜利～。"},"opposite":["头脑清醒"],"usage":"作谓语；指头脑不清醒"},{"id":7875,"word":"冲锋陷坚","pinyin":"chōng fēng xiàn jiān","abbr":"cfxj","explanation":"犹言冲锋陷阵。","source":{"text":"所部多收录亡命，藉为冲锋陷坚。","book":"清·王韬《瓮牖馀谈·贼中悍酋记》"},"similar":["冲锋陷锐","冲锋陷阵"],"usage":"作谓语、宾语、定语；形容作战勇敢"},{"id":7876,"word":"冲锋陷锐","pinyin":"chōng fēng xiàn ruì","abbr":"cfxr","explanation":"犹言冲锋陷阵。","source":{"text":"前队二千人皆用洋枪，冲锋陷锐，发无不中，号之曰：‘此张家背嵬军也。’","book":"清·王韬《瓮牖馀谈·张秉中事》"},"similar":["冲锋陷坚","冲坚陷阵"],"usage":"作谓语、宾语、定语；形容作战勇敢"},{"id":7877,"word":"冲锋陷阵","pinyin":"chōng fēng xiàn zhèn","abbr":"cfxz","explanation":"陷：攻破，深入。不顾一切，攻入敌人阵地。形容作战勇猛。","source":{"text":"冲锋陷阵，大有其人。","book":"《北齐书·崔暹传》"},"example":{"text":"头一晚醉得倒下马来，第二天照样～。不能喝酒，还能当军人吗？","book":"白先勇《岁除》"},"similar":["出生入死","赴汤蹈火","冲锋陷坚"],"opposite":["临阵脱逃","望风而逃"],"usage":"作谓语、宾语、定语；形容作战勇敢","story":["北魏末年，政权分裂为西魏和东魏。东魏掌握军政大权的是高欢父子。为官清廉正直的崔暹忠于高欢，经常上书弹劾那些贪官污吏，让他们一一入狱。高欢对此十分高兴，称赞他敢于冲锋陷阵，不徇私情，使国家吏治变得严明"]},{"id":7878,"word":"冲风之末","pinyin":"chōng fēng zhī mò","abbr":"cfzm","explanation":"冲风：疾风。强风吹到了尽头。比喻原来很强的力量已经衰弱，不可能发挥什么作用。","source":{"text":"且强弩之极，矢不能穿橹缟。冲风之末，力不能漂鸿毛。","book":"《史记·韩安国列传》"}},{"id":7879,"word":"冲风冒雨","pinyin":"chōng fēng mào yǔ","abbr":"cfmy","explanation":"指不避风雨之苦。","source":{"text":"‘头年给你干一整年活，冲风冒雨，起早贪黑的。’郭全海说，气急眼了。","book":"周立波《暴风骤雨》第一部九"},"similar":["风雨无阻"],"usage":"作谓语、状语；指顶风冒雨"},{"id":7880,"word":"冲风破浪","pinyin":"chōng fēng pò làng","abbr":"cfpl","explanation":"形容在水道中迅猛前进。","source":{"text":"昔日之艟楼船，不敌今日之铁甲飞轮冲风破浪也。","book":"郑观应《盛世危言·海防上》"},"example":{"text":"郑观应《盛世危言·海防上》：“昔日之艟艨楼船，不敌今日之铁甲飞轮～也。”"},"similar":["乘风破浪"],"usage":"作谓语；多用于船"},{"id":7881,"word":"决一死战","pinyin":"jué yī sǐ zhàn","abbr":"jysz","explanation":"决：决定；死：拼死。对敌人拼死决战。","source":{"text":"来日尽驱百姓当先，以军继其后，与曹操决一死战。","book":"明·罗贯中《三国演义》第三十三回"},"example":{"text":"周天爵素称勇敢，所保臧纡青练勇可当一面，独不能与贼～耶？","book":"《清史稿·文宗本纪》"},"similar":["决一雌雄"],"opposite":["不分胜负"],"usage":"作谓语；形容不怕牺牲"},{"id":7882,"word":"决一胜负","pinyin":"jué yī shèng fù","abbr":"jysf","explanation":"决：决定；胜负：胜败。进行决战，判定胜败。","source":{"text":"天下匈奴数岁者，徒以吾两人耳，愿与汉王挑战，决雌雄，毋徒苦天下之民父子为也。","book":"《史记·项羽本纪》"},"example":{"text":"……若不听我良言，只是与你～。","book":"清·钱彩《说岳全传》第四十七回"},"similar":["决一雌雄"],"usage":"作谓语、定语；指较量一下胜败高低"},{"id":7883,"word":"决一雌雄","pinyin":"jué yī cí xióng","abbr":"jycx","explanation":"雌雄：比喻高低、胜负。指较量一下胜败高低。","source":{"text":"天下匈奴数岁者，徒以吾两人耳，愿与汉王挑战，决雌雄，毋徒苦天下之民父子为也。","book":"《史记·项羽本纪》"},"example":{"text":"吾与汝～，汝若能胜，吾誓不为大将。","book":"明·罗贯中《三国演义》第一百回"},"similar":["决一胜负","鹿死谁手"],"opposite":["不分胜负"],"usage":"作谓语、定语；指较量一下胜败高低","story":["秦朝末年，楚霸王项羽和汉王刘邦争夺天下，两军在广武对阵，双方的军士和当地的百姓都怨声载道。项羽急于要消灭刘邦，他对刘邦说：“天下争雄只有你我二人，我不想兴师动众，单独与你决一雌雄。”刘邦笑着谢绝，表示愿意斗智而不是斗力"]},{"id":7884,"word":"决不待时","pinyin":"jué bù dài shí","abbr":"jbds","explanation":"指对已判死刑的重犯不待秋后而立即执行。封建时代处决死囚多在秋后，但案情重大者可立即处决，故谓。"},{"id":7885,"word":"决命争首","pinyin":"jué mìng zhēng shǒu","abbr":"jmzs","explanation":"拼命争先而战。","source":{"text":"疲兵再战，一以当千，然犹扶乘创痛，决命争首。","book":"汉·李陵《答苏武书》"},"example":{"text":"安能～，慷慨大节，死生以之乎？","book":"唐·王维《与工部李诗郎书》"},"usage":"作谓语；用于书面语"},{"id":7886,"word":"决断如流","pinyin":"jué duàn rú liú","abbr":"jdrl","explanation":"决策、断事犹如流水。形容决策迅速、顺畅。","source":{"text":"汉善尺牍，尤便簿领，理识明赡，决断如流。","book":"《周书·斐汉传》"},"example":{"text":"穆之内总朝政，外供军旅，～，事无拥滞。","book":"《宋书·刘穆之传》"},"similar":["应付裕如"],"opposite":["优柔寡断"],"usage":"作谓语；形容处理问题果断敏捷"},{"id":7887,"word":"决狱断刑","pinyin":"jué yù duàn xíng","abbr":"jydx","explanation":"受理诉讼，决断刑令。","source":{"text":"躬家世掌法，务在宽平，及典礼官，决狱断刑，多依矜恕。","book":"《后汉书·郭躬传》"},"usage":"作谓语、宾语；用于官吏等"},{"id":7888,"word":"决疣溃痈","pinyin":"jué yóu kuì yōng","abbr":"jyky","explanation":"比喻腐败之极。","source":{"text":"况夫益之以保举，加之以捐班，决疣溃痈，靡知所届。","book":"严复《救亡决论》"},"similar":["决痈溃疽"],"usage":"作宾语、定语；用于比喻句"},{"id":7889,"word":"决痈溃疽","pinyin":"jué yōng kuì jū","abbr":"jykj","explanation":"痈：疮；溃：破；疽：痈疽。疮痈破开了。比喻事情的症结得到解决。","source":{"text":"今乃举兵内侮，奸回外炽，斯实恶熟罪成之辰，决痈溃疽之日。","book":"《南齐书·柳世隆传》"},"similar":["决疣溃痈"],"usage":"作宾语、定语；用于比喻句"},{"id":7890,"word":"决策千里","pinyin":"jué cè qiān lǐ","abbr":"jcql","explanation":"决定千里外战役的胜利，形容卓越的军事运筹才能。","source":{"text":"萧相立功于万代，留侯决策千里。","book":"唐·杨炯《泸州都督王湛神道碑》"},"similar":["决胜千里"],"usage":"作谓语、定语、宾语；用于决策"},{"id":7891,"word":"决胜之机","pinyin":"jué shèng zhī jī","abbr":"jszj","explanation":"机：时机，机会。决定胜负的电动机。指关系到最终成败的关键时刻。","source":{"text":"此天赞我决胜之机也，彼必无备。","book":"宋·无名氏《新编五代史平话·唐史》卷下"},"usage":"作主语、宾语；用于事情等"},{"id":7892,"word":"决胜于千里之外","pinyin":"jué shèng yú qiān lǐ zhī wài","abbr":"jsyqlzw","explanation":"坐镇指挥千里之外的战局。形容将帅雄才大略，指挥若定。","source":{"text":"运筹帷帐中，决胜千里外，子房功也。","book":"《史记·留侯世家》"},"example":{"text":"明·冯梦龙《喻世明言》第22卷：“不如居中以运天下，运筹帷幄之中，方能～。”"},"similar":["决胜千里"],"usage":"作宾语、定语；用于书面语","story":["刘邦当皇帝后在都城洛阳南宫摆酒宴，招待文武百官。他问百官他与项羽的区别，百官纷纷夸赞他大仁大义。刘邦说运筹帷幄与决胜千里不如张良，安抚百姓不如萧何，率军打仗不如韩信，但他能合理地使用他们三位俊杰，所以能得天下"]},{"id":7893,"word":"决胜千里","pinyin":"jué shèng qiān lǐ","abbr":"jsql","explanation":"坐镇指挥千里之外的战局。形容将帅雄才大略，指挥若定。","source":{"text":"运筹帷帐中，决胜千里外，子房功也。","book":"《史记·留侯世家》"},"example":{"text":"东夏克平，南国底定，参谋帷幄，～。","book":"《隋书·苏威传》"},"similar":["稳操胜券"],"usage":"作谓语、定语、宾语；用于决策","story":["刘邦当皇帝后在都城洛阳南宫摆酒宴，招待文武百官。他问百官他与项羽的区别，百官纷纷夸赞他大仁大义。刘邦说运筹帷幄与决胜千里不如张良，安抚百姓不如萧何，率军打仗不如韩信，但他能合理地使用他们三位俊杰，所以能得天下"]},{"id":7894,"word":"决胜庙堂","pinyin":"jué shèng miào táng","abbr":"jsmt","explanation":"庙堂：指古代帝王祭祀、议事的场所。指文官儒将在庙堂中制定出决定胜改的策略。","source":{"text":"古人先决胜庙堂，然后攻战。","book":"《晋书·慕容德传》"},"example":{"text":"儒将者，～者也。武将者，折冲千里者也。","book":"明·无名氏《投笔肤谈》"},"usage":"作定语；用于书面语"},{"id":7895,"word":"决蹯之兽","pinyin":"jué fán zhī shòu","abbr":"jfzs","explanation":"决：断；蹯：指兽的脚掌。脚掌断裂的野兽。比喻被击败过的敌人。","source":{"text":"魏魀谓建信君曰：‘人有置系蹄者而得虎。虎怒，决蹯而去。’","book":"《战国策·赵策三》"},"example":{"text":"～，可以惊奔。","book":"明·无名氏《投笔肤谈》"}},{"id":7896,"word":"冶叶倡条","pinyin":"yě yè chàng tiáo","abbr":"yyct","explanation":"倡：通‘娼’；冶：妖艳。原形容杨柳的枝叶婀娜多姿，后比喻任人玩赏攀折的花草枝叶，借指妓女。","source":{"text":"蜜房羽客类芳心，冶叶倡条遍相识。","book":"唐·李商隐《燕春台》诗"},"example":{"text":"～俱相识，仍惯见珠歌翠舞。","book":"宋·周邦彦《尉迟杯》词"},"similar":["野草闲花"],"usage":"作宾语、定语；指妓女"},{"id":7897,"word":"冶容诲淫","pinyin":"yě róng huì yín","abbr":"yrhy","explanation":"冶容：打扮得容貌妖艳；诲：诱导，招致；淫：淫邪。指女子装饰妖艳，容易招致奸淫的事。","source":{"text":"慢藏诲盗，冶容诲淫。","book":"《周易·系辞上》"},"example":{"text":"是知女子修道，亦似一段障难，而况～者哉。","book":"宋·孙光宪《北梦琐言》卷四"},"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":7898,"word":"冷冷淡淡","pinyin":"lěng lěng dàn dàn","abbr":"lldd","explanation":"不关注人或冷漠无情。","example":{"text":"我受不了他～的目光。"},"similar":["冷漠无情"],"opposite":["亲亲热热"],"usage":"作定语；指冷漠无情"},{"id":7899,"word":"冷冷清清","pinyin":"lěng lěng qīng qīng","abbr":"llqq","explanation":"死气沉沉，冷落、凄凉、寂寞。","source":{"text":"紫鹃到了这里，我从没合他说句知心的话儿，冷冷清清撂着他，我心里甚不过意。","book":"清·曹雪芹《红楼梦》第113回"},"example":{"text":"红军每到一地，群众～，经过宣传之后，才慢慢地起来。","book":"毛泽东《井冈山的斗争》"},"similar":["死气沉沉"],"opposite":["热热闹闹"],"usage":"作谓语、定语、状语；指清静","story":["自从林黛玉病死后，贾宝玉一直处于神志恍惚之中，虽与薛宝钗结婚，自己在清醒后觉得对不起黛玉。黛玉的丫鬟紫鹃见了宝玉故意回避，并不理睬他。宝玉特地去向紫鹃解释，紫鹃就是不开门让他有机会，宝玉觉得自己过去冷冷清清对待她，心中后悔"]},{"id":7900,"word":"冷嘲热讽","pinyin":"lěng cháo rè fěng","abbr":"lcrf","explanation":"冷：不热情，引伸为严峻；热：温度高，引伸为辛辣。用尖刻辛辣的语言进行讥笑和讽刺。","source":{"text":"楚公子围为虢之会，其时子围篡国之状，人人知之，皆有不平之意，故晋大夫七嘴八舌，冷讥热嘲，皆由于心之大公也。","book":"清·袁枚《牍外余言》"},"example":{"text":"见了老徐，说了几句～的话儿。","book":"蔡东藩、许廑父《民国通俗演义》第一一六回"},"similar":["冷言冷语","冷语冰人"],"opposite":["诚心诚意","真诚以待","赤诚相见"],"usage":"作谓语、定语、状语；指人的言语"},{"id":7901,"word":"冷嘲热骂","pinyin":"lěng cháo rè mà","abbr":"lcrm","explanation":"尖刻的嘲笑和谩骂。","source":{"text":"他一进一出要受学生们的冷嘲热骂，然而也不能不忍耐着装聋卖哑。","book":"郭沫若《反正前后》第一篇"},"example":{"text":"请不要理会他的～。"},"similar":["冷嘲热讽"],"opposite":["赤诚以待"],"usage":"作谓语、定语、宾语；指人的言语"},{"id":7902,"word":"冷如霜雪","pinyin":"lěng rú shuāng xuě","abbr":"lrsx","explanation":"冷得象霜雪一样。比喻待人接物毫无感情，象霜雪一样冷。也比喻态度严正，不可接近。","source":{"text":"俺老夫人治家严肃，凛若冰霜。","book":"汉·王逸《正部论》：“谚曰：政如冰霜，奸宄消亡；威如雷霆，寇贼不生。”元·王实甫《西厢记》第一本第二折"},"example":{"text":"为人不言，亦不笑，艳如桃李，而～。","book":"清·蒲松龄《聊斋志异·侠女》"}},{"id":7903,"word":"冷心冷面","pinyin":"lěng xīn lěng miàn","abbr":"lxlm","explanation":"态度冷淡，对人没有感情。","source":{"text":"妾痴情待君五年，不期君果‘冷心冷面’，妾以死报此痴情。","book":"清·曹雪芹《红楼梦》第六十六回"},"example":{"text":"况且听他那番～，早同枯木死灰，把生死关头看破，这大事已完，还有甚的依恋？","book":"清·文康《儿女英雄传》第十六回"},"similar":["冷酷无情"],"usage":"作谓语、宾语、定语；指人冷酷"},{"id":7904,"word":"冷暖自知","pinyin":"lěng nuǎn zì zhī","abbr":"lnzz","explanation":"水的冷暖，只有饮者自己知道。佛教禅宗用以比喻自己证悟的境界。也比喻学习心得深浅，只有自己知道。","source":{"text":"如饮水者，冷热自知。","book":"唐·善无畏《大日经疏》卷十二"},"example":{"text":"今蒙指授入处，如人饮水，～。今行者即是某人师也。","book":"宋·释道原《景德传灯录》卷四"},"opposite":["麻木不仁"],"usage":"作谓语、宾语；比喻体会深浅，心中自明"},{"id":7905,"word":"冷板凳","pinyin":"lěng bǎn dèng","abbr":"lbd","explanation":"比喻清苦、冷落的职务或位置。常指担任乡村塾师或受到冷遇。也指清唱。","source":{"text":"郭信不胜感激，捧了几百钱，就象获了珍宝一般，紧紧收藏，只去守那冷板凳了。","book":"明·凌濛初《二刻拍案惊奇》卷三十二"},"example":{"text":"清唱，俗语谓之～，不比戏场借锣鼓之势。","book":"明·魏良辅《曲律》"},"usage":"作宾语、定语；用于比喻句"},{"id":7906,"word":"冷水浇头","pinyin":"lěng shuǐ jiāo tóu","abbr":"lsjt","explanation":"冷水从背上浇下来。比喻因突然遭受意外的打击或刺激，思想为之一震或希望为之幻灭。同“冷水浇背”。","source":{"text":"忽然听得说太太来了，好一似——天雷霹雳，冷水浇头。","book":"清·丁耀亢《续金瓶梅》第四十三回"},"example":{"text":"他一看，像一瓢～，不禁浑身一颤，颓然靠在椅背上。","book":"姚雪垠《李自成》第一卷第二十二章"}},{"id":7907,"word":"冷水浇背","pinyin":"lěng shuǐ jiāo bèi","abbr":"lsjb","explanation":"冷水从背上浇下来。比喻因突然遭受意外的打击或刺激，思想为之一震或希望为之幻灭。亦作“冷水浇头”。","source":{"text":"红玉听了，总如冷水浇背一般，唇也青了，面也白了，做声不得。","book":"清·吴趼人《二十年目睹之怪现状》第六十五回"},"example":{"text":"自辰入见，及戌始退，～，当头一棒，一旦尽失其故垒，惘惘然不知所从事，且惊且喜，且怨且艾，且疑且惧，与通甫联床竟夕不能寐。","book":"梁启超《三十自述》"}},{"id":7908,"word":"冷灰爆豆","pinyin":"lěng huī bào dòu","abbr":"lhbd","explanation":"在冷灰中爆豆。比喻方法不对，白费力气。或比喻事情凭空突然发生。亦作“冷锅中豆爆”。","source":{"text":"各梦同床，不妨殊调；冷灰爆豆，聊为解嘲云耳。","book":"宋·黄庭坚《翠岩真禅师语录序》"}},{"id":7909,"word":"冷热病","pinyin":"lěng rè bìng","abbr":"lrb","explanation":"疟疾。比喻情绪高低不定。","example":{"text":"干工作不能犯～。"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":7910,"word":"冷眉冷眼","pinyin":"lěng méi lěng yǎn","abbr":"lmly","explanation":"形容冷淡或鄙视的神情。","example":{"text":"他～地瞪了我一眼。"},"similar":["横眉冷对"],"usage":"作宾语、状语、定语；指人的态度"},{"id":7911,"word":"冷眼旁观","pinyin":"lěng yǎn páng guān","abbr":"lypg","explanation":"冷眼：冷静或冷漠的眼光。指不参与其事，站在一旁看事情的发展。","source":{"text":"故其后复申炎所陈，荐举之说，乃是首尾专为王地，冷眼旁观，手足俱露，甚可笑也。","book":"唐·徐夤《上卢三拾遗以言见黜》：“冷眼静看真好笑，倾怀与说却为冤。”宋·朱熹《答黄直卿》"},"example":{"text":"诗云：“一局输赢料不真，香销茶尽尚逡巡。欲知目下兴衰兆，顺问傍观冷眼人。”","book":"《脂砚斋评红楼梦》第二回"},"similar":["漠不关心","袖手旁观","漠然置之"],"opposite":["另眼相看","刮目相待","热情洋溢"],"usage":"作谓语、定语、状语；指人的态度"},{"id":7912,"word":"冷眼相待","pinyin":"lěng yǎn xiāng dài","abbr":"lyxd","explanation":"用冷淡的态度接待。比喻不欢迎或看不起。","source":{"text":"哪知太祖反冷眼相待，并不升赏。","book":"蔡东藩《明史演义》第二十回"},"example":{"text":"请不要对我们～，我们没有敌意"},"usage":"作谓语、定语、宾语；用于处事"},{"id":7913,"word":"冷眼静看","pinyin":"lěng yǎn jìng kàn","abbr":"lyjk","explanation":"形容从旁冷静而仔细地观察。","source":{"text":"疾危必厌神明药，心惑多嫌正直言，冷眼静看真可笑，倾怀与说却为冤。","book":"唐·徐夤《上卢三拾遗以言见黜》"},"usage":"作谓语、宾语；用于处事"},{"id":7914,"word":"冷窗冻壁","pinyin":"lěng chuāng dòng bì","abbr":"lcdb","explanation":"形容贫寒。","source":{"text":"冷窗冻壁更成眠？也腾疏蓬仰见天！","book":"宋·陈师道《谢赵使君送乌薪》诗：“老身曲直不足言，冷窗冻壁作春温。”宋·杨万里《除夕前一日归舟夜泊曲涡市宿治平寺》诗"},"example":{"text":"他回到家里，面对～发愣"},"usage":"作宾语、定语；用于生活"},{"id":7915,"word":"冷若冰霜","pinyin":"lěng ruò bīng shuāng","abbr":"lrbs","explanation":"冷得象冰霜一样。比喻待人接物毫无感情，象冰霜一样冷。也比喻态度严正，不可接近。","source":{"text":"俺老夫人治家严肃，凛若冰霜。","book":"汉·王逸《正部论》：“谚曰：政如冰霜，奸宄消亡；威如雷霆，寇贼不生。”元·王实甫《西厢记》第一本第二折"},"example":{"text":"笑起来一双眼又秀又媚，却是不笑起来又～。","book":"清·刘鹗《老残游记·续集》第二回"},"similar":["冷酷无情","冷眼旁观"],"opposite":["满腔热情","和颜悦色"],"usage":"作谓语、定语、状语；形容人的态度"},{"id":7916,"word":"冷血动物","pinyin":"lěng xuè dòng wù","abbr":"lxdw","explanation":"体温随环境温度的改变而变化的动物。比喻缺乏感情、对人对事冷漠的人。","source":{"text":"李先生本来像冬蛰的冷血动物，给顾先生当众恭维得春气入身，蠕蠕欲活。","book":"钱钟书《围城》"},"example":{"text":"我不喜欢～。"},"usage":"作宾语、定语；指对人对事冷漠的人"},{"id":7917,"word":"冷言冷语","pinyin":"lěng yán lěng yǔ","abbr":"lyly","explanation":"冷：意含讥讽。带讥讽意味的冷冰冰的话。","source":{"text":"只这冷言冷语，带讥带讪的，教人怎么当得！","book":"《宝林禅师语录》：“山门疏：关着门，尽是自家屋里，何须冷言冷语，暗地敲人？”明·冯梦龙《醒世恒言》卷三十七"},"example":{"text":"朱老忠一问，严志和又火呛起来，～说：“那谁又知道呢？”","book":"梁斌《红旗谱》三十六"},"similar":["反唇相讥","冷嘲热讽"],"opposite":["诚心诚意","真诚以待"],"usage":"作定语、状语；指人的言语"},{"id":7918,"word":"冷言热语","pinyin":"lěng yán rè yǔ","abbr":"lyry","explanation":"犹冷言冷语。带讥讽意味的冷冰冰的话。","source":{"text":"三官说：‘欲待回家，难见父母兄嫂；待不去，又受不得亡八冷言热语。’","book":"明·冯梦龙《警世通言》第二十四卷"},"example":{"text":"妇人心肠褊窄浅露，便把晋王好，太子歹，一齐搬将出来。杨素又加上些～。","book":"清·褚人获《隋唐演义》第二回"},"similar":["冷言冷语"],"usage":"作主语、宾语、定语；指讽刺话语"},{"id":7919,"word":"冷讥热嘲","pinyin":"lěng jī rè cháo","abbr":"ljrc","explanation":"尖刻的嘲笑和讥讽。","source":{"text":"楚公子围为虢之会，其时子围篡国之状，人人知之，皆有不平之意，故晋大夫七嘴八舌，冷讥热嘲，皆由于心之大公也。","book":"清·袁枚《牍外余言》"},"example":{"text":"他们的责任不仅仅是～地发表一点“不满于现状”的杂感而已。","book":"鲁迅《二心集·“好政府主义”》"},"similar":["冷嘲热讽"],"usage":"作谓语、定语、状语；指人的言语"},{"id":7920,"word":"冷语冰人","pinyin":"lěng yǔ bīng rén","abbr":"lybr","explanation":"冷语：冷冰冰的话。用冷酷的话伤人。","source":{"text":"潘柱迎，孟蜀时，以财结权要，或戒之，乃日：‘非是求愿，不欲以冷语冰人耳。’","book":"宋·曾造《类说·〈外史梼杌〉》"},"example":{"text":"日频来，时相遇，并不假以词色。少游戏之，则～。","book":"清·蒲松龄《聊斋志异·侠女》"},"similar":["出口伤人"],"usage":"作谓语、宾语；指用冷酷的话伤人"},{"id":7921,"word":"冷酷无情","pinyin":"lěng kù wú qíng","abbr":"lkwq","explanation":"冷漠苛刻，没有感情。","source":{"text":"看明白了大部分的字，都是责难他的！她的形影与一切都消逝了，他眼前只是那张死板板的字，与一些冷酷无情的字！","book":"老舍《一封家信》"},"example":{"text":"斤澜反映现实生活，有时像不是用笔，而是用解剖刀。在给人以深刻感的同时，也带来一些～的压抑感。","book":"孙犁《读作品记（三）》"},"similar":["无情无义"],"opposite":["有情有意","仁至义尽"],"usage":"作谓语、定语；指人的性格"},{"id":7922,"word":"冷锅里爆豆","pinyin":"lěng guō lǐ bào dòu","abbr":"lglbd","explanation":"比喻本已平息的纠纷，口舌等忽然又发作起来。","source":{"text":"各梦同床，不妨殊调，冷灰爆豆，聊为解嘲耳。","book":"宋·黄庭坚《翠岩真禅师语录序》"},"example":{"text":"沉默了仿佛一个黑夜，～般说道：“我不上学了。”","book":"林斤澜《满城飞花》"},"usage":"作宾语、定语；用于口语"},{"id":7923,"word":"冷面寒铁","pinyin":"lěng miàn hán tiě","abbr":"lmht","explanation":"比喻公正廉洁，不怕权贵的官员。","source":{"text":"永乐初，拜监察御史，弹劾敢言，人目为‘冷面寒铁’。","book":"明·张岱《城隍庙》"},"example":{"text":"敢言词多所弹颏，贵戚震惧，目为～。","book":"《明史·周新传》"},"usage":"作宾语、定语；用于比喻句"},{"id":7924,"word":"冻浦鱼惊","pinyin":"dòng pǔ yú jīng","abbr":"dpyj","explanation":"指晋王祥卧冰求鲤事。后为孝亲之典。","source":{"text":"王祥字休徵，琅邪临沂人……父母有疾，衣不解带，汤药必亲尝。母常欲生鱼，时天寒冰冻，祥解衣将剖冰求之，冰忽自解，双鲤跃出，持之而归。","book":"《晋书·王祥传》"},"example":{"text":"温席扇枕，承颜悦膝；～，寒林笋出。","book":"北周·庚信《周柱国大将军拓跋俭神道碑》"},"usage":"作宾语、定语；指孝顺父母","story":["晋朝时期，有名的孝子琅邪临沂人王祥特别孝敬父母。父母生病的时候，他一直都衣不解带地伺候在父母身边，汤药要自己先尝后给父母喝。有一次母亲想吃活鱼，正值冬天，王祥脱衣刨冰，突然河上的冰融化，鲤鱼自己跳上来"]},{"id":7925,"word":"冻解冰释","pinyin":"dòng jiě bīng shì","abbr":"djbs","explanation":"如同冰冻融化一般。比喻困难或障碍消除。","source":{"text":"是乃所谓冰释冻释者能乎？","book":"《庄子·庚桑楚》"},"example":{"text":"则复取程氏书虚心平气而徐读之，未及数行，～。","book":"《朱子全书·中庸》"},"similar":["冰释冻解"],"usage":"作谓语；比喻困难或障碍消除"},{"id":7926,"word":"净几明窗","pinyin":"jìng jǐ míng chuāng","abbr":"jjmc","explanation":"净：干净；几：小桌子。形容房间干净明亮。","source":{"text":"素妆才罢，款步书堂下，对净几明窗潇洒。","book":"明·汤显祖《牡丹亭·闺垫》"},"example":{"text":"明·冯梦龙《醒世恒言》第32卷：“～不染尘，图书镇日与相亲。”"},"similar":["窗明几净"],"usage":"作宾语、定语、状语；指干净"},{"id":7927,"word":"净盘将军","pinyin":"jìng pán jiāng jūn","abbr":"jpjj","explanation":"盘：盘子。指十分贪吃的人。","source":{"text":"你道因何封我做净盘将军，若有人请我到的酒席上，且不吃酒，将各样好下饭，狼餐虎噬，则一顿都噻了，方才吃酒，以此号为净盘将军。","book":"元·无名氏《小尉迟》第一折"},"similar":["尽盘将军"],"usage":"作宾语、定语；用于比喻句"},{"id":7928,"word":"凄入肝脾","pinyin":"qī rù gān pí","abbr":"qrgp","explanation":"形容非常悲伤。","source":{"text":"咏北狄之遐征，奏胡马之长思，凄入肝脾，哀感顽艳。","book":"三国魏·繁休伯《与魏文帝笺》"},"usage":"作谓语、定语；指非常悲伤"},{"id":7929,"word":"凄凄楚楚","pinyin":"qī qī chǔ chǔ","abbr":"qqcc","explanation":"指十分凄凉悲哀。","source":{"text":"凄凄楚楚又哭起来；独有薛冶儿捧着朱贵儿石栏，把当初分别的话，一一诉将出来。","book":"清·褚人获《隋唐演义》第67回"},"usage":"作定语、状语；用于书面语"},{"id":7930,"word":"凄怆流涕","pinyin":"qī chuàng liú tì","abbr":"qclt","explanation":"凄怆：伤感悲痛。悲伤得流泪。","source":{"text":"未知后会何期，凄怆流涕。","book":"《孔丛子·儒服》"},"usage":"作谓语、定语、状语；用于悲伤时"},{"id":7931,"word":"凄然泪下","pinyin":"qī rán lèi xià","abbr":"qrlx","explanation":"凄然：寒凉。形容凄凉悲伤。","source":{"text":"玄德听罢，蓦然想起在吴繁华之事，不觉凄然泪下。","book":"明·罗贯中《三国演义》第五十五回"},"example":{"text":"在路非止一日，回到东都，见了妻子，好生惭赧，终日只在书房里发愤攻书。每想起落第的光景，便～。","book":"明·冯梦龙《醒世恒言》第二十五卷"}},{"id":7932,"word":"凄风冷雨","pinyin":"qī fēng lěng yǔ","abbr":"qfly","explanation":"凄风：寒冷的风；冷雨：冰冷的雨。形容天气恶劣。后用来比喻境遇悲惨凄凉。","source":{"text":"春无凄风，秋无苦雨。","book":"《左传·昭公四年》"},"example":{"text":"时遇秋天，怎当那～，过雁吟虫，眼前景物，无一件不是牵愁触闷的。","book":"元·杨显之《潇湘雨》第三折"},"similar":["凄风寒雨"],"usage":"作主语、宾语、定语；指境遇悲惨"},{"id":7933,"word":"凄风寒雨","pinyin":"qī fēng hán yǔ","abbr":"qfhy","explanation":"形容天气恶劣，或比喻境况的凄凉悲惨。同“凄风苦雨”。","source":{"text":"方其凄风寒雨，杏褪桃残，山路萧条，愁云千里，苔荒藓败，情扬魂销，不可谓无忧也。","book":"清·葆光子《物妖志·木类·柳》"},"similar":["凄风苦雨","凄风冷雨"],"usage":"作主语、宾语、定语；指境遇悲惨"},{"id":7934,"word":"凄风楚雨","pinyin":"qī fēng chǔ yǔ","abbr":"qfcy","explanation":"形容天气恶劣，或比喻境况的凄凉悲惨。同“凄风苦雨”。","source":{"text":"［女］每于凄风楚雨之时，常思归去。","book":"清·程麟《此中人语·田螺妖》"},"example":{"text":"清·程麟《此中人语·田螺妖》：“每于～之时，常思归去。”"},"similar":["凄风苦雨","凄风寒雨"],"usage":"作主语、宾语、定语；指境遇悲惨"},{"id":7935,"word":"凄风苦雨","pinyin":"qī fēng kǔ yǔ","abbr":"qfky","explanation":"凄风：寒冷的风；苦雨：久下成灾的雨。形容天气恶劣。后用来比喻境遇悲惨凄凉。","source":{"text":"春无凄风，秋无苦雨。","book":"《左传·昭公四年》"},"example":{"text":"我们住在这里，总不了局，不如趁这颜色未衰，再去混他几年，何苦在这里，受这些～。","book":"清·禇人获《隋唐演义》第六十二回"},"similar":["风雨交加","风雨如晦"],"opposite":["风和日丽","和风细雨"],"usage":"作主语、宾语、定语；指境遇悲惨"},{"id":7936,"word":"准情酌理","pinyin":"zhǔn qíng zhuó lǐ","abbr":"zqzl","explanation":"准：依据，按照。指依据情况，斟酌事理。形容从实际情况出发，对已发生的事情或问题作出合乎情理的处理。"},{"id":7937,"word":"凉了半截","pinyin":"liáng le bàn jié","abbr":"llbj","explanation":"比喻非常失望。","source":{"text":"黛玉听了，凉了半截。看紫鹃推门进来时，尚拿手帕拭眼。","book":"清·曹雪芹《红楼梦》第82回"},"example":{"text":"他听了，一下～。"},"similar":["心灰意冷"],"opposite":["信心百倍"],"usage":"作谓语；比喻非常失望","story":["林黛玉听薛宝钗的下人说薛家正张罗宝琴的事，心中特别敏感，和衣而睡。在梦中见到南京派人来接她回去结婚，宝玉也催她回去，惊梦醒来就吐鲜血，心里凉了半截。紫鹃在旁边劝她保重身体，留得青山在，依旧有柴烧。黛玉又昏昏躺下做梦"]},{"id":7938,"word":"凋零磨灭","pinyin":"diāo líng mó miè","abbr":"dlmm","explanation":"凋谢零落以至灭绝。形容事物衰败灭亡。","source":{"text":"凋零磨灭，亦不可胜数。","book":"《新唐书·艺文志论》"}},{"id":7939,"word":"凌上虐下","pinyin":"líng shàng nüè xià","abbr":"lsnx","explanation":"凌：欺负。欺侮在上的人，虐待在下的人。","source":{"text":"昔项籍总一强众，跨州兼土，所务者大，然卒败垓下，死于东城，为笑千载，皆不以义，凌上虐下故也。","book":"《三国志·魏书·后主传》裴松之注引诸葛亮集"},"example":{"text":"而长恶不悛，志为奸宄，～，纵逸无度。","book":"《晋书·刘毅传》"},"usage":"作谓语、定语、宾语；用于处世"},{"id":7940,"word":"凌乱无章","pinyin":"líng luàn wú zhāng","abbr":"llwz","explanation":"凌：侵犯，引申为交错。形容杂乱而无秩序。","source":{"text":"其为言也，杂乱而无章。","book":"唐·韩愈《送孟东野序》"},"example":{"text":"好容易回到家里，又看见那～的家政，儿啼女哭的声音，真是加上我百倍的不痛快。","book":"冰心《两个家庭》"},"similar":["杂乱无章"],"opposite":["井井有条","有条不紊"],"usage":"作谓语、定语、状语；形容思想等"},{"id":7941,"word":"凌云之志","pinyin":"líng yún zhī zhì","abbr":"lyzz","explanation":"凌云：高入云霄的志气。形容远大的志向。","source":{"text":"往时武帝好神仙，相如上《大人赋》欲以风帝，反缥缥有陵（凌）云之志。","book":"《汉书·扬雄传》"},"example":{"text":"鲁编修飘飘有～。","book":"清·吴敬梓《儒林外史》第十回"},"similar":["壮志凌云","凌霄之志"],"usage":"作宾语；指人的志向"},{"id":7942,"word":"凌云意气","pinyin":"líng yún yì qì","abbr":"lyyq","explanation":"凌云：高入云霄的志气。形容远大的志向。","source":{"text":"往时武帝好神仙，相如上《大人赋》欲以风帝，反缥缥有陵（凌）云之志。","book":"《汉书·扬雄传》"},"example":{"text":"～谈天口，仿佛音容尚眼前。","book":"清·赵翼《心余诗已刻于京师，谢蕴山观察觅以寄示，展阅累日，为题三律》其一"}},{"id":7943,"word":"凌弱暴寡","pinyin":"líng ruò bào guǎ","abbr":"lrbg","explanation":"凌：侵犯；暴：欺负、践踏。侵犯弱小的，欺侮孤单的。","source":{"text":"神农既没，以强胜弱，以众暴寡。","book":"《商君书·画策》"},"example":{"text":"君当传与世人，广行方便，切不可～，利己损人。","book":"明·冯梦龙《醒世恒言》卷一"},"similar":["陵弱暴寡"],"usage":"作谓语、定语、宾语；指欺侮弱小的"},{"id":7944,"word":"凌杂米盐","pinyin":"líng zá mǐ yán","abbr":"lzmy","explanation":"凌杂：错杂零乱；米盐：形容细碎。形容零乱琐碎。","source":{"text":"近世十二诸侯七国相王，言从衡者继踵，而皋、唐、甘、石因时务论其书传，故其占验凌杂为盐。","book":"西汉·司马迁《史记·天官书》"},"example":{"text":"～的事让人烦心。"},"usage":"作宾语、定语；形容零乱琐碎"},{"id":7945,"word":"凌波微步","pinyin":"líng bō wēi bù","abbr":"lbwb","explanation":"形容女子步履轻盈。","source":{"text":"凌波微步，罗袜生尘。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"我新拜的师父本事却非同小可，不说别的，单是一套“～”，相信世上便无第二个会得。","book":"金庸《天龙八部》第十八章"}},{"id":7946,"word":"凌迟重辟","pinyin":"líng chí zhòng pì","abbr":"lczp","explanation":"凌迟：即剐刑，古代的一种酷刑；重辟：即大辟，古指死刑。先砍断罪犯的肢体，然后再割断咽喉，使犯人受尽痛苦而死。也泛指死刑。","source":{"text":"具疏奏闻，刑部以为人妖败俗，律所不载，拟成凌迟重辟，决不待时。","book":"明·冯梦龙《醒世恒言》卷十"}},{"id":7947,"word":"凌霄之志","pinyin":"líng xiāo zhī zhì","abbr":"lxzz","explanation":"凌霄：高入云霄的志气。形容远大的志向。","source":{"text":"遇风尘之会，必有凌霄之志，惟宜急其羁绊。","book":"《晋书·慕容垂载记》"},"example":{"text":"道乎落西极，走东海，千回百折不堕～；闳其中，肆其外，秋盈春虚常抒善利之怀。","book":"金辉《长江源碑记》"},"similar":["凌云之志"],"usage":"作宾语；指人的志向"},{"id":7948,"word":"减师半德","pinyin":"jiǎn shī bàn dé","abbr":"jsbd","explanation":"谓只学到老师的一半。","source":{"text":"若乃学退之而不至者为孙樵；学渊明而不至者为白乐天，则以所谓减师半德也耶。","book":"宋陈善《扪虱新话·右军书东坡字鲁直诗》"},"similar":["赐墙及肩"],"opposite":["青出于蓝"],"usage":"作宾语；指只学到老师的一半水平"},{"id":7949,"word":"减灶之计","pinyin":"jiǎn zào zhī jì","abbr":"jzzj","explanation":"在战争中隐瞒自己军队的实力来麻痹敌人。","source":{"text":"入魏地为十万灶，明日为五万灶，又明日为三万灶。","book":"西汉·司马迁《史记·孙子吴起列传》"},"usage":"作主语、宾语；用于军事","story":["战国时期，韩国受到魏国的攻击向齐国求救，齐王派田忌为大将，孙膑为军师率军进攻魏国都城大梁。魏军主帅庞涓急忙撤军救援。孙膑得知师兄庞涓撤军，就建议田忌采用减灶计来麻痹魏军。庞涓狂妄自大而轻敌，进入孙膑的包围圈被逼自杀"]},{"id":7950,"word":"凛不可犯","pinyin":"lǐn bù kě fàn","abbr":"lbkf","explanation":"凛：严肃可敬畏的样子。形容严正而令人敬畏，不容侵犯。","source":{"text":"青松守节见临危，正色凛凛不可犯。","book":"宋·欧阳修《新霜二首》其二"},"example":{"text":"康熙的脸色突然变得神情冷峻，～。","book":"二月河《康熙大帝》十八"}},{"id":7951,"word":"凛凛不可犯","pinyin":"lǐn lǐn bù kě fàn","abbr":"llbkf","explanation":"凛凛：严肃可敬畏的样子。形容严正而令人敬畏，不容侵犯。","source":{"text":"青松守节见临危，正色凛凛不可犯。","book":"宋·欧阳修《新霜二首》其二"},"example":{"text":"凤举看看他那情形，刚才对柴贾二人那一番～的威风，完全没有了。","book":"张恨水《金粉世家》第八十七回"}},{"id":7952,"word":"凛凛威风","pinyin":"lǐn lǐn wēi fēng","abbr":"llwf","explanation":"凛凛：可敬畏的样子。形容声势气派令人敬畏。","source":{"text":"有一个守旗壮士，冠簪鱼尾，甲皱龙鳞，身长一丈，凛凛威风，便是险道神郁保四。","book":"明·施耐庵《水浒传》第108回"},"similar":["威风凛凛"],"usage":"作谓语、宾语；用于人"},{"id":7953,"word":"凛凛有生气","pinyin":"lǐn lǐn yǒu shēng qì","abbr":"llysq","explanation":"凛凛：严正的样子。形容令人敬畏而又充活力。多指崇高的人或业绩永远流传。","source":{"text":"蔺相如虽千载死人，凛凛恒如有生气。","book":"晋·郭澄之《郭子》"},"example":{"text":"余谓前辈名节之重，身蹈危机，不复小顾，申省公牍，百载而下，读之～。","book":"宋·岳珂《桯史·陈了翁始末》"}},{"id":7954,"word":"凛如霜雪","pinyin":"lǐn rú shuāng xuě","abbr":"lrsx","explanation":"比喻待人接物毫无感情，象冰霜一样冷。也比喻态度严正，不可接近。同“凛若冰霜”。","source":{"text":"俺老夫人治家严肃，凛若冰霜。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"只见他那艳如桃李之中，却又～。","book":"清·文康《儿女英雄传》第四回"},"similar":["凛若冰霜","凛若秋霜"],"usage":"作谓语、定语；比喻人态度严肃"},{"id":7955,"word":"凛有生气","pinyin":"lǐn yǒu shēng qì","abbr":"lysq","explanation":"凛：严正的样子。形容令人敬畏而又充活力。多指崇高的人或业绩永远流传。","source":{"text":"蔺相如虽千载死人，凛凛恒如有生气。","book":"晋·郭澄之《郭子》"},"example":{"text":"用公直而掌朝论，昂然直上，～。","book":"唐·王勃《平台秘略论十首·益政》"}},{"id":7956,"word":"凛然不可犯","pinyin":"lǐn rán bù kě fàn","abbr":"lrbkf","explanation":"凛然：严肃可敬畏的样子。形容严正而令人敬畏，不容侵犯。","source":{"text":"青松守节见临危，正色凛凛不可犯。","book":"宋·欧阳修《新霜二首》其二"},"example":{"text":"其御将帅也，～，而四方之士归之者，礼遇勤至。","book":"明·陶宗仪《辍耕录·军中礼士》"}},{"id":7957,"word":"凛然正气","pinyin":"lǐn rán zhèng qì","abbr":"lrzq","explanation":"凛然：整肃而又可敬又可怕；正气：正直的气概。形容极威严的英雄气概，使人敬畏。","source":{"text":"您当时神态是那样地严肃，坦然，眉宇间凛然正气，使我仅有的一点疑问如烟消云散了。","book":"陶斯亮《一封终于发出的信》"},"similar":["浩然正气"],"usage":"作宾语、定语；用于人的气概"},{"id":7958,"word":"凛若冰霜","pinyin":"lǐn ruò bīng shuāng","abbr":"lrbs","explanation":"凛：冷。冷得象冰霜一样。比喻待人接物毫无感情，象冰霜一样冷。也比喻态度严正，不可接近。","source":{"text":"洞无畦畛心常坦，凛若冰霜节最高。","book":"宋·曾巩《酬柳国博》诗"},"example":{"text":"李太太虽然是露着笑容，对方仍然是～的样子。","book":"靳以《群鸦》"},"similar":["冷若冰霜","凛如霜雪"],"usage":"作谓语、定语；比喻态度严肃，不易接近"},{"id":7959,"word":"凛若秋霜","pinyin":"lǐn ruò qiū shuāng","abbr":"lrqs","explanation":"比喻待人接物毫无感情，象冰霜一样冷。也比喻态度严正，不可接近。同“凛若冰霜”。","source":{"text":"谈恩惠则煦如春日，纪严切则凛若秋霜。","book":"唐·刘知幾《史通·杂说上》"},"similar":["凛若冰霜"],"usage":"作谓语、定语；比喻人态度严肃"},{"id":7960,"word":"凝瞩不转","pinyin":"níng zhǔ bù zhuǎn","abbr":"nzbz","explanation":"指目不转睛。","source":{"text":"复叙有为之教、栖神道气之术以观之，彼犹如前，凝瞩不转。","book":"南朝·宋·刘义庆《世说新语·栖逸》"}},{"id":7961,"word":"凝神定气","pinyin":"níng shén dìng qì","abbr":"nsdq","explanation":"聚精会神，专心致志。","source":{"text":"敬亭退而凝神定气，简练揣摩，期月而诣莫生。","book":"清·黄宗羲《柳敬亭传》"},"usage":"作谓语、状语；指人的思想集中"},{"id":7962,"word":"凝脂点漆","pinyin":"níng zhī diǎn qī","abbr":"nzdq","explanation":"形容人皮肤白，眼睛明亮。","source":{"text":"面如凝脂，眼如点漆。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"其人也，～，琼树瑶林，学富文史，言成准的。","book":"唐·杨炯《李舍人山亭诗序》"},"usage":"作谓语、定语；用于书面语","story":["晋朝时期，王右军长相英俊秀美，一次他见到杜弘治，见他脸象凝固的白脂，眼珠如同点染的黑漆，赞叹说他是神仙中人。当时有人称赞王右军的长相秀美，认为他很美，蔡公说：“遗憾诸位没有见到过杜弘治呀。”"]},{"id":7963,"word":"几不欲生","pinyin":"jī bù yù shēng","abbr":"jbys","explanation":"几：几乎；欲：想。几乎都不想活了。","source":{"text":"其恻怛之心、痛疾之意不欲生。","book":"宋·吕大钧《吊说》"},"example":{"text":"凤姐本是贪得无厌的人，如今被抄净尽，自然愁苦，又恐人埋怨，正是～的时候。","book":"清·曹雪芹《红楼梦》第一○七回"},"similar":["痛不欲生"],"usage":"作谓语、定语；指几乎绝望"},{"id":7964,"word":"几尽一刻","pinyin":"ji jing yi ke","abbr":"jjyk","explanation":"几乎占了一刻的时间."},{"id":7965,"word":"几次三番","pinyin":"jǐ cì sān fān","abbr":"jcsf","explanation":"番：次。一次又一次。形容次数之多。","source":{"text":"本官到任以来，就几次三番的传谕董事，出过告示。","book":"清·顾琐《黄绣球》第四回"},"example":{"text":"但一位先生却以为这客店也包办囚人的饭食，我住在那里不相宜，几次三番，几次三番地说。","book":"鲁迅《朝花夕拾·滕野先生》"},"similar":["屡次三番"],"usage":"作状语；表示重复"},{"id":7966,"word":"几而不征","pinyin":"jī ér bù zhēng","abbr":"jebz","explanation":"几：稽查，查看；征：征税。指在关卡、市场等处只稽查而不征税。","source":{"text":"通齐国之鱼盐于东莱，使关市几而不征，以为诸侯利。","book":"《国语·齐语》"}},{"id":7967,"word":"凡事豫则立，不豫则废","pinyin":"fán shì yù zé lì，bù yù zé fèi","abbr":"fsyzlbyzf","explanation":"豫：通“预”，事先准备。指做任何事情，事先有准备，就能得到成功，不然就会失败。","source":{"text":"凡事豫则立，不豫则废。","book":"西汉·戴圣《礼记·中庸》"},"similar":["凡事预则立，不预则废"],"usage":"作分句；指有准备就会成功"},{"id":7968,"word":"凡事预则立，不预则废","pinyin":"fán shì yù zé lì，bù yù zé fèi","abbr":"fsyzlbyzf","explanation":"预：预先，指事先作好计划或准备；立：成就；废：败坏。不论做什么事，事先有准备，就能得到成功，不然就会失败。","source":{"text":"凡事预则立，不预则废。","book":"《礼记·中庸》"},"example":{"text":"“～”，没有事先的计划和准备，就不能获得战争的胜利。","book":"《毛泽东选集·论持久战》"},"similar":["凡事豫则立，不豫则废"],"usage":"作分句；指有准备就会成功"},{"id":7969,"word":"凡偶近器","pinyin":"fán ǒu jìn qì","abbr":"fojq","explanation":"指平庸之辈；普通人才。","source":{"text":"使让生在唐虞，则元凯之次，运值仲尼，则颜冉之亚，岂徒俗之凡偶近器已者哉！","book":"《后汉书·文苑传下·边让》"},"example":{"text":"先公语人曰：‘是三子者，非～也。’","book":"宋·葛立方《韵语阳秋》卷十八"},"usage":"作宾语、定语；用于书面语"},{"id":7970,"word":"凡圣不二","pinyin":"fán shèng bù èr","abbr":"fsbe","explanation":"佛家语。指凡人与圣人虽然有所区别，但本性是一样的。","source":{"text":"凡圣不二，一切圆满。","book":"《宝藏论·本际虚玄品》"}},{"id":7971,"word":"凡夫俗子","pinyin":"fán fū sú zǐ","abbr":"ffsz","explanation":"泛指平庸的人。","source":{"text":"吾等又不是凡夫俗子，恃强斗勇，皆非仙体。","book":"明·许仲琳《封神演义》第四十三回"},"example":{"text":"瞧我这～，不能交通神明，所以梦都没有一个儿。","book":"清·曹雪芹《红楼梦》第一○九回"},"similar":["平常百姓"],"opposite":["神仙中人"],"usage":"作宾语；指平庸的人"},{"id":7972,"word":"凡夫肉眼","pinyin":"fán fū ròu yǎn","abbr":"ffry","explanation":"比喻缺乏观察人的眼光。也比喻平凡的见识。","source":{"text":"凡夫肉眼未曾识，为现千尺一金躯。","book":"《法华经》：“凡夫浅识，深著五欲。”  唐·玄奘译《赞弥勒四礼文》"},"similar":["凡夫俗子"],"usage":"作宾语、定语；比喻平凡的见识"},{"id":7973,"word":"凡才浅识","pinyin":"fán cái qiǎn shí","abbr":"fcqs","explanation":"才能平庸，识见肤浅。","source":{"text":"用光凡才浅识，无所比数。","book":"清·陈用光《上翁学士书》"},"usage":"作谓语、定语；用于自谦"},{"id":7974,"word":"凡桃俗李","pinyin":"fán táo sú lǐ","abbr":"ftsl","explanation":"平凡、普通的桃花和李花。比喻庸俗的人或平常的事物。","source":{"text":"凡桃俗李争芬芳，只有老梅心自常。","book":"明·王冕《题墨梅图》"},"usage":"作主语、宾语；指平常的事物"},{"id":7975,"word":"凡百一新","pinyin":"fán bǎi yī xīn","abbr":"fbyx","explanation":"凡：全部；百：指事物多。所有的事物都有了新气象。","source":{"text":"瞬届发暮，凡百一新，弟之处境，亦同鸡肋矣。","book":"鲁迅《书信集·致陈濬》"}},{"id":7976,"word":"凡胎俗骨","pinyin":"fán tāi sú gǔ","abbr":"ftsg","explanation":"指人世间普通、平庸的人。","source":{"text":"我和这等愚眉肉眼难相瞅，凡胎浊骨难相守。","book":"元·无名氏《村乐堂》第一折"},"example":{"text":"向来偏觅多人，皆系～，无可下手。","book":"明·无名氏《蕉帕记》第三出"},"similar":["凡胎浊骨","凡胎浊体"],"usage":"作宾语、定语；指平庸的人"},{"id":7977,"word":"凡胎浊体","pinyin":"fán tāi zhuó tǐ","abbr":"ftzt","explanation":"指人间普通的，平庸的人。同“凡胎浊骨”。","source":{"text":"念小生凡胎浊体，怎敢和仙子陪奉？","book":"元·昊昌龄《张天师》第一折"},"similar":["凡胎浊骨","凡夫俗子"],"usage":"作宾语、定语；指平庸的人"},{"id":7978,"word":"凡胎浊骨","pinyin":"fán tāi zhuó gǔ","abbr":"ftzg","explanation":"指人间普通的，平庸的人。","source":{"text":"我和这等愚眉肉眼难相瞅，凡胎浊骨难相守。","book":"元·无名氏《村乐堂》第一折"},"example":{"text":"师傅说了这些炼金丹之道，奴家～，尚不深晓。","book":"明·朱有敦《神仙会》第三折"},"similar":["凡夫俗子","凡胎俗骨"],"usage":"作宾语、定语；指平庸的人"},{"id":7979,"word":"凡胎肉眼","pinyin":"fán tāi ròu yǎn","abbr":"ftry","explanation":"凡人的只能看见尘俗世界的眼睛。","source":{"text":"你每凡胎肉眼，怎得见国色天香？","book":"明·汪道昆《洛水悲》"},"example":{"text":"似乎我就是那来无影去无踪的仙人，～是看不见的。","book":"《人民文学》1981年第3期"},"similar":["肉眼凡夫"],"usage":"作主语、宾语、定语；指凡夫俗子"},{"id":7980,"word":"凤仪兽舞","pinyin":"fèng yí shòu wǔ","abbr":"fysw","explanation":"表示圣贤教化的功效极大，能使神异的鸟兽奋然起舞。","source":{"text":"《箫韶》九成，凤皇来仪……击石拊石，百兽率舞。","book":"《书·益稷》"},"example":{"text":"而国子之教，乐乃专精。乐之至者，能使～。","book":"清·曾国藩《复刘霞仙中丞书》"},"usage":"作谓语、定语；用于时局"},{"id":7981,"word":"凤冠霞帔","pinyin":"fèng guān xiá pèi","abbr":"fgxp","explanation":"旧时富家女子出嫁时的装束，以示荣耀。也指官员夫人的礼服。","source":{"text":"解下了这金花八宝凤冠儿，解下了这云霞五彩帔肩儿，都送与张家小姐妆台次，我甘心倒做了梅香听使。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"择了吉日迎娶，一般的鼓乐彩舆，～，花烛拜堂，成了好事。","book":"清·吴趼人《二十年目睹之怪现状》第五十八回"},"similar":["珠光宝气","珠围翠绕"],"opposite":["荆钗布裙","鹑衣百结"],"usage":"作主语、宾语、定语；指女子的装束"},{"id":7982,"word":"凤凰于飞","pinyin":"fèng huáng yú fēi","abbr":"fhyf","explanation":"本指凤和凰相偕而飞。比喻夫妻和好恩爱。常用以祝人婚姻美满。","source":{"text":"前许州司马宋公，蕴冰清之姿，重傅侯玉润之德，妻以其子。凤凰于飞，潘杨之好，斯为睦矣。","book":"唐·李白《早夏于将军叔宅与诸昆季送傅八之江南序》"},"example":{"text":"～，梧桐是依。噰噰喈喈，福禄攸归。","book":"唐·颜真卿《和政公主神道碑》"},"similar":["凤皇于飞"],"usage":"作谓语；比喻夫妻相亲相爱"},{"id":7983,"word":"凤凰在笯","pinyin":"fèng huáng zài nú","abbr":"fhzn","explanation":"笯：鸟笼。凤凰被关在笼中。比喻有才能者不能施展报负。","source":{"text":"凤凰在笯兮，鸡鹜翔舞。","book":"战国·楚·屈原《九章·怀沙》"},"similar":["笼中之鸟"],"usage":"作宾语、定语；指怀才不遇"},{"id":7984,"word":"凤凰来仪","pinyin":"fèng huáng lái yí","abbr":"fhly","explanation":"仪：容仪。凤凰来舞，仪表非凡。古代指吉祥的征兆。","source":{"text":"有百兽率舞，凤凰来仪，于变时雍之美，故其人至于今和而不怒。","book":"唐·柳宗元《晋问》"},"example":{"text":"自魏即位以来，麒麟降生，～。","book":"明·罗贯中《三国演义》第八十回"},"similar":["凤皇来仪"],"usage":"作宾语、定语；指吉祥的征兆"},{"id":7985,"word":"凤协鸾和","pinyin":"fèng xié luán hé","abbr":"fxlh","explanation":"形容夫妻和睦，感情融洽。"},{"id":7986,"word":"凤友鸾交","pinyin":"fèng yǒu luán jiāo","abbr":"fylj","explanation":"①比喻有情男女结成的夫妇。②比喻男女间情投意合。","source":{"text":"烘散燕子莺儿，拆散凤友鸾交。","book":"元·汤式《集贤宾·友人爱姬为权豪所夺》套曲"},"example":{"text":"昨夜谁侍陛下寝来？可怎生般～。到日三竿犹不临朝？","book":"清·洪昇《长生殿·絮阁》"},"similar":["凤友鸾谐"],"usage":"作宾语、定语；用于男女之间"},{"id":7987,"word":"凤友鸾谐","pinyin":"fèng yǒu luán xié","abbr":"fylx","explanation":"比喻男女间情投意合。同“凤友鸾交”。","source":{"text":"曲榭幽廊，皆凤友鸾谐之所也。","book":"清·黄六鸿《福惠全书·刑名·强奸》"},"similar":["凤友鸾交"],"usage":"作宾语、定语；用于男女之间"},{"id":7988,"word":"凤只鸾孤","pinyin":"fèng zhī luán gū","abbr":"fzlg","explanation":"只：单独。凤和鸾比喻夫妻。单只的凤，孤独的鸾。比喻夫妻离散。","source":{"text":"从来我意，镇有心，便欲求伊姻契，谁知到此，情一似凤孤鸾只。","book":"宋·无名氏《张协状元》第二十九出"},"example":{"text":"你原来好模样倒有这般心歹处，便待要拆散妻夫，～。","book":"元·武汉臣《生金阁》第一折"},"usage":"作宾语、定语；用于夫妻之间"},{"id":7989,"word":"凤叹虎视","pinyin":"fèng tàn hǔ shì","abbr":"fths","explanation":"形容谈吐文雅，器宇轩昂。","source":{"text":"凤以喻文也，虎以喻武也。叹犹歌也。取美壮之意。","book":"《文选·曹植〈与吴季重书〉》：“足下鹰扬其体，凤叹虎视，谓萧曹不足俦，卫霍不足侔也。”李善注"},"usage":"作谓语、定语；用于人的气质"},{"id":7990,"word":"凤吟鸾吹","pinyin":"fèng yín luán chuī","abbr":"fylc","explanation":"比喻极为美妙的歌声。","source":{"text":"忽听得歌声嘹亮，凤吟鸾吹，不足喻其美。","book":"《警世通言·杜十娘怒沉百宝箱》"},"usage":"作宾语、定语；用于音乐"},{"id":7991,"word":"凤子龙孙","pinyin":"fèng zǐ lóng sūn","abbr":"fzls","explanation":"帝王或贵族的后代。","source":{"text":"真个是凤子龙孙，遭着不幸，流落到这个地位。","book":"《二刻拍案惊奇》卷七"},"similar":["龙子龙孙"],"usage":"作主语、宾语、定语；用于口语"},{"id":7992,"word":"凤孤鸾只","pinyin":"fèng gū luán zhī","abbr":"fglz","explanation":"比喻夫妻离散。也比喻人失偶孤居。","source":{"text":"从来我意，镇有心，便欲求伊姻契，谁知到此，情一似凤孤鸾只。","book":"宋·无名氏《张协状元》第二十九出"}},{"id":7993,"word":"凤寡鸾孤","pinyin":"fèng guǎ luán gū","abbr":"fglg","explanation":"比喻夫妻离散。也比喻人失偶孤居。","source":{"text":"从来我意，镇有心，便欲求伊姻契，谁知到此，情一似凤孤鸾只。","book":"宋·无名氏《张协状元》第二十九出"},"example":{"text":"即或偶才其夫，亦复散多聂少，不数年而兰摧玉折，不则～，求其白首和鸣者，百不得一。","book":"清·李渔《和鸣集序》"}},{"id":7994,"word":"凤引九雏","pinyin":"fèng yǐn jiǔ chú","abbr":"fyjc","explanation":"为天下太平、社会繁荣的吉兆。","source":{"text":"（升平四年）二月，凤凰将九雏见于丰城。","book":"《晋书·穆帝纪》"},"example":{"text":"龙吟四泽欲兴雨，～警宿乌。","book":"唐·顾况逸句"},"usage":"作宾语、定语；用于时局"},{"id":7995,"word":"凤彩鸾章","pinyin":"fèng cǎi luán zhāng","abbr":"fclz","explanation":"形容诗文的文采华丽。","source":{"text":"凤彩鸾章，霞鲜锦缛。","book":"南朝·梁·沈约《谢齐竟陵王示永明乐歌启》"},"usage":"作宾语、定语；用于文章等"},{"id":7996,"word":"凤愁鸾怨","pinyin":"fèng chóu luán yuàn","abbr":"fcly","explanation":"比喻夫妻间因思念而生的愁怨。","source":{"text":"无奈分离一旦，你功名傥万全，也思恩爱有三年。苦只为鹗荐鹏骞，博得凤愁鸾怨。","book":"明·王玉峰《梦香记·饯别》"},"usage":"作宾语、定语、状语；用于夫妻之间"},{"id":7997,"word":"凤枭同巢","pinyin":"fèng xiāo tóng cháo","abbr":"fxtc","explanation":"凤：凤凰，吉祥的象征；枭：恶鸟的象征。神鸟与恶鸟同在一个窝里。比喻好和坏混在一起不分。","source":{"text":"我们处理事情时不能～，好坏不分。"},"example":{"text":"我们处理事情时不能～，好坏不分"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":7998,"word":"凤楼龙阙","pinyin":"fèng lóu lóng què","abbr":"fllq","explanation":"形容华美的宫阙楼台。","source":{"text":"洛岸秋晴夕照长，凤楼龙阙倚清光。","book":"唐·韦庄《和集贤侯学士分司丁侍御秋日雨霁之作》诗"},"example":{"text":"万里飘零南越，山引泪、酒添愁。不见～、又惊秋。","book":"宋·朱敦儒《沙塞子》词"},"similar":["凤阁龙楼"],"usage":"作主语、宾语、定语；用于建筑物等"},{"id":7999,"word":"凤歌鸾舞","pinyin":"fèng gē luán wǔ","abbr":"fglw","explanation":"神鸟歌舞。比喻美妙的歌舞。","source":{"text":"桂子兰孙，凤歌鸾舞，介我公眉寿。","book":"宋·陈亮《点绛唇》词：“凤歌鸾舞。玉斝飞香醑。”宋·赵善括《醉蓬莱》词"},"example":{"text":"我们欣赏了一段高水准的～"},"similar":["凤舞鸾歌"],"usage":"作宾语、定语；用于比喻句"},{"id":8000,"word":"凤毛济美","pinyin":"fèng máo jì měi","abbr":"fmjm","explanation":"旧时比喻父亲做官，儿子能继承父业。","source":{"text":"你不听见说他们世兄即日也要保道台？真正是凤毛济美，可钦可敬。","book":"清·李宝嘉《官场现形记》第三十四回"},"example":{"text":"清·李宝嘉《官场现形记》第34回：“你不听见说他们世兄即日也要保道台？真正是～，可钦，可敬！”"},"usage":"作谓语；指儿子能继承父业"},{"id":8001,"word":"凤毛鸡胆","pinyin":"fèng máo jī dǎn","abbr":"fmjd","explanation":"凤的羽毛，鸡的胆子。比喻外表英武而实际怯弱。","source":{"text":"羊质虎皮功不就，凤毛鸡胆事难成。","book":"明·罗贯中《三国演义》第三十二回"},"similar":["外强中干","羊质虎皮"],"usage":"作宾语、定语；用于比喻句"},{"id":8002,"word":"凤毛麟角","pinyin":"fèng máo lín jiǎo","abbr":"fmlj","explanation":"凤凰的羽毛，麒麟的角。比喻珍贵而稀少的人或物。","source":{"text":"学者如牛毛，成者如麟角。","book":"南朝·宋·刘义庆《世说新语·容止》：“大奴固自有凤毛。”《南史·谢超宗传》：“超宗殊有凤毛。”《北史·文苑传序》"},"example":{"text":"全县只考上你一个，无论如何是～。","book":"梁斌《红旗谱》二十"},"similar":["百里挑一"],"opposite":["俯拾即是","多如牛毛"],"usage":"作宾语、定语；指稀有之物","story":["南朝时期著名的诗人谢灵运的孙子谢超宗很有才学，他担任新安王刘子鸾的常侍，他写各种文告十分精彩，孝武帝夸奖他有凤毛。右卫将军刘道隆听孝武帝夸他有凤毛，以为有稀罕之物，于是到谢家寻找，找了半天也没找到"]},{"id":8003,"word":"凤毛龙甲","pinyin":"fèng máo lóng jiǎ","abbr":"fmlj","explanation":"凤的羽毛，龙的鳞甲。比喻珍贵之物。","source":{"text":"旧有传奇二种，置于笥中，为鼠子嚼坏，凤毛龙甲，竟不存于世。","book":"明·袁中道《石浦先生传》"},"similar":["凤毛麟角"],"usage":"作主语、宾语；用于稀有事物"},{"id":8004,"word":"凤泊鸾漂","pinyin":"fèng bó luán piāo","abbr":"fblp","explanation":"飘、泊：随流飘荡。原形容书法笔势潇洒飘逸，后比喻夫妻离散或文人失意。","source":{"text":"科斗拳身薤倒披，鸾飘凤泊拏虎螭。","book":"唐·韩愈《峋嵝山》诗"},"example":{"text":"神清骨冷何由俗，～信可哀。","book":"清·黄景仁《失题》"},"similar":["凤泊鸾飘"],"usage":"作宾语、定语；用于飘浮不定的人"},{"id":8005,"word":"凤泊鸾飘","pinyin":"fèng bó luán piāo","abbr":"fblp","explanation":"比喻有才之人不得志，飘泊无定。","source":{"text":"然而凤泊鸾飘，漫漶怀中之刺。","book":"清·全祖望《序》"},"example":{"text":"～吾辈事，未须憔悴诉生平。","book":"柳亚子《重题》诗"},"similar":["鸾飘凤泊"],"usage":"作宾语、定语；指怀才不遇，飘浮不定的人"},{"id":8006,"word":"凤狂龙躁","pinyin":"fèng kuáng lóng zào","abbr":"fklz","explanation":"形容心情烦躁，精神失常。","source":{"text":"炉炭烧人百疾生，凤狂龙躁减心情。","book":"唐·韩偓《喜凉》诗"},"example":{"text":"海枯石烂愁仍在，～转多病。","book":"清·金农《问颜大懋伦疾》诗"},"usage":"作宾语、定语；指精神失常"},{"id":8007,"word":"凤皇于蜚","pinyin":"fèng huáng yú fēi","abbr":"fhyf","explanation":"比喻夫妻和好恩爱。常用以祝人婚姻美满。同“凤凰于飞”。","source":{"text":"齐懿仲欲妻完，卜之，占曰：‘是谓凤凰于蜚，和鸣锵锵。’","book":"《史记·田敬仲完世家》"},"similar":["凤凰于飞","凤皇于飞"],"usage":"作谓语、宾语；比喻夫妻相亲相爱"},{"id":8008,"word":"凤皇于飞","pinyin":"fèng huáng yú fēi","abbr":"fhyf","explanation":"比喻夫妻和好恩爱。常用以祝人婚姻美满。同“凤凰于飞”。","source":{"text":"凤凰于飞，刿刿其羽。","book":"《诗经·大雅·卷阿》"},"similar":["凤皇于蜚","凤凰于飞"],"usage":"作谓语、宾语；比喻夫妻相亲相爱"},{"id":8009,"word":"凤皇来仪","pinyin":"fèng huáng lái yí","abbr":"fhly","explanation":"凤凰来舞，仪表非凡。古代指吉祥的征兆。同“凤凰来仪”。","source":{"text":"《箫韶》九成，凤皇来仪。","book":"《书·益稷》"},"example":{"text":"百兽率舞而抃足，～而拊翼。","book":"晋·成公绥《啸赋》"},"similar":["凤凰来仪","有凤来仪"],"usage":"作宾语、定语；指吉祥的征兆"},{"id":8010,"word":"凤管鸾笙","pinyin":"fèng guǎn luán shēng","abbr":"fgls","explanation":"笙箫之乐的美称。","source":{"text":"歌儿舞女朝朝醉，凤管鸾笙步步随。","book":"明·廷讷《狮吼记·访友》"},"example":{"text":"清·褚人获《隋唐演义》第27回：“在院中铺设起琴棋书画，打点下～。”"},"similar":["凤管鸾箫"],"usage":"作宾语、定语；用于音乐"},{"id":8011,"word":"凤管鸾箫","pinyin":"fèng guǎn luán xiāo","abbr":"fglx","explanation":"笙箫之乐的美称。","source":{"text":"听一派凤管鸾箫，见一簇翠围珠绕。","book":"明·兰陵笑笑生《金瓶梅词话》第四十六回"},"similar":["凤管鸾笙"],"usage":"作宾语、定语；用于音乐"},{"id":8012,"word":"凤箫鸾管","pinyin":"fèng xiāo luán guǎn","abbr":"fxlg","explanation":"笙箫之类的吹奏乐。","source":{"text":"歌动迎仙，声袅凤箫鸾管。","book":"明·谢谠《四喜记·大宋毕姻》"},"similar":["凤箫龙管"],"usage":"作宾语、定语；用于音乐"},{"id":8013,"word":"凤箫龙管","pinyin":"fèng xiāo lóng guǎn","abbr":"fxlg","explanation":"指笙箫一类管乐的吹奏声。","source":{"text":"凤箫龙管穿云去，锦缆牙樯映日月。","book":"清·黄永《龙衣舟行》诗"},"similar":["凤管鸾箫"],"usage":"作宾语、定语；用于音乐"},{"id":8014,"word":"凤翥鸾回","pinyin":"fèng zhù luán huí","abbr":"fzlh","explanation":"翥：高飞。比喻书法笔势飞动舒展。","source":{"text":"鸾翔凤翥，鸿惊鹤飞，鲸鲵溯波，鲛鳄冲道。","book":"晋·陆机《浮云赋》"},"example":{"text":"今观圣迹，兼绝二王，～，实古今书圣。","book":"宋·王溥《唐会要》"},"similar":["龙飞凤舞"],"usage":"作宾语、定语；指书法"},{"id":8015,"word":"凤翥鸾翔","pinyin":"fèng zhù luán xiáng","abbr":"fzlx","explanation":"像凤凰高飞。比喻女子婚姻美满得意。","source":{"text":"我女之嫁，凤翥鸾翔。我女之行，山遥水长。","book":"明·李东阳《祭孔氏女文》"},"usage":"作谓语、定语；用于祝福等"},{"id":8016,"word":"凤翥鹏翔","pinyin":"fèng zhù péng xiáng","abbr":"fzpx","explanation":"形容奋发有为。","source":{"text":"吾婿英年有志，前程远大，苟发愤力学，将来凤翥鹏翔，何可限量。","book":"清·陆陇其《与李枚吉婿书》"},"usage":"作谓语、定语；用于祝福等"},{"id":8017,"word":"凤翥龙翔","pinyin":"fèng zhù lóng xiáng","abbr":"fzlx","explanation":"翥：鸟向上飞；翔：盘旋飞翔。龙飞凤舞，形容气势非凡。","source":{"text":"山趋水会，凤翥龙翔，信乾坤之……","book":"明·张居正《陵寝纪》"},"example":{"text":"美彼之态度兮，～。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["龙飞凤舞"],"usage":"作宾语、定语；指人的气度"},{"id":8018,"word":"凤翥龙蟠","pinyin":"fèng zhù lóng pán","abbr":"fzlp","explanation":"像凤凰飞舞，蛟龙盘曲。比喻体势的飞扬劲建，回旋多姿。","source":{"text":"观其点曳之工，裁成之妙，烟霏露结，状若断而还连；凤翥龙蟠，势如斜而反直。","book":"《晋书·王羲之传论》"},"example":{"text":"～势作环，浮青不断太行山。","book":"清·纳兰性德《扈驾西山》诗"},"similar":["龙蟠凤翥"],"usage":"作谓语、宾语、定语；用于书法等"},{"id":8019,"word":"凤翥龙骧","pinyin":"fèng zhù lóng xiāng","abbr":"fzlx","explanation":"形容奋发有为。","source":{"text":"新筑沙堤行宰相，喜今朝凤翥龙骧，燕友逢春，莺朋出谷。","book":"明·孙柚《琴心记·牛酒交欢》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":8020,"word":"凤臆龙鬐","pinyin":"fèng yì lóng qí","abbr":"fylq","explanation":"凤凰的胸脯，龙的颈毛。比喻骏马的雄奇健美。","source":{"text":"凤臆龙鬐未易识，侧身注目长风生。","book":"唐·杜甫《李鄠县丈人胡马行》"}},{"id":8021,"word":"凤臆龙鬵","pinyin":"fèng yì lóng qí","abbr":"fylq","explanation":"凤凰的胸脯，龙的颈毛。比喻骏马的雄奇健美。"},{"id":8022,"word":"凤舞鸾歌","pinyin":"fèng wǔ luán gē","abbr":"fwlg","explanation":"①形容美妙的歌舞。②仙舞的两支曲名。","source":{"text":"凤舞鸾歌兮俨欲飞，披烟弄月兮宵未归。","book":"唐·宋之问《太平公主山池赋》"},"similar":["凤歌鸾舞"],"usage":"作宾语、定语；用于比喻句"},{"id":8023,"word":"凤舞龙盘","pinyin":"fèng wǔ lóng pán","abbr":"fwlp","explanation":"凤凰飞舞，蛟龙盘曲。形容相配得当。同“凤舞龙蟠”。","source":{"text":"郡城正值江湖之间，委蛇曲折，左右映带，屋宇鳞次，竹木云蓊，郁郁葱葱，凤舞龙盘，真有王气蓬勃。","book":"明·张岱《西湖梦寻·北高峰》"}},{"id":8024,"word":"凤舞龙蟠","pinyin":"fèng wǔ lóng pán","abbr":"fwlp","explanation":"凤凰飞舞，蛟龙盘曲。形容相配得当。","source":{"text":"不想这一拜，恰恰的合成一个‘名花并蒂’，俨然是金厢玉琢，凤舞龙蟠！","book":"清·文康《儿女英雄传》第二十四回"}},{"id":8025,"word":"凤舞龙飞","pinyin":"fèng wǔ lóng fēi","abbr":"fwlf","explanation":"形容书法笔势有力，灵活舒展。","source":{"text":"只这书法也写得这等凤舞龙飞，真令人拜服。","book":"《儿女英雄传》第十回"},"similar":["龙飞凤舞"],"usage":"作谓语、宾语、定语；形容书法笔势有力"},{"id":8026,"word":"凤表龙姿","pinyin":"fèng biǎo lóng zī","abbr":"fblz","explanation":"形容英俊的仪表。","source":{"text":"瞥然一见，凤表龙姿自出群，雌雄胜负隐然分。","book":"明·张凤翼《红拂记·俊杰知时》"},"usage":"作主语、宾语；指人的外表"},{"id":8027,"word":"凤采鸾章","pinyin":"fèng cǎi luán zhāng","abbr":"fclz","explanation":"形容诗文的文采华丽。","source":{"text":"凤采鸾章，霞鲜锦缛。","book":"南朝·梁·沈约《谢齐竟陵王示永明乐歌启》"}},{"id":8028,"word":"凤阁龙楼","pinyin":"fèng gé lóng lóu","abbr":"fgll","explanation":"帝王居住的楼阁。","source":{"text":"我们参观了故宫的～，惊叹古代的建筑艺术。"},"example":{"text":"我们参观了故宫的～，惊叹古代的建筑艺术"},"similar":["凤楼龙阙"],"usage":"作宾语、定语；用于建筑物等"},{"id":8029,"word":"凤附龙攀","pinyin":"fèng fù lóng pān","abbr":"fflp","explanation":"指依附帝王权贵建功立业。","source":{"text":"攀龙鳞，附凤翼。","book":"汉·扬雄《法言·渊骞》"},"example":{"text":"我明载兴，公值其际，～，风飞雷厉。","book":"《宛署杂记·志遗三》引用明·李东阳《敕封崇安侯谭公神道碑铭》"},"similar":["攀龙附凤"],"usage":"作谓语、宾语、定语；用于处事"},{"id":8030,"word":"凤雏麟子","pinyin":"fèng chú lín zǐ","abbr":"fclz","explanation":"比喻贵族子孙或称誉佳子弟。","source":{"text":"比喻贵族子孙或称誉佳子弟。"},"example":{"text":"比喻贵族子孙或称誉佳子弟。"},"similar":["麟子凤雏"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":8031,"word":"凤靡鸾吪","pinyin":"fèng mǐ luán é","abbr":"fmle","explanation":"靡：指凤死；吪：指鸾死。比喻人死。旧时多作挽辞。","source":{"text":"凤靡鸾吪，百鸟瘗之。","book":"《禽经》"},"example":{"text":"～易，王图霸业轻。","book":"明·袁中郎《过华清宫汤泉》"},"usage":"作谓语；比喻贤人去世"},{"id":8032,"word":"凤食鸾栖","pinyin":"fèng shí luán qī","abbr":"fslq","explanation":"鸾凤非竹实不食，非悟桐不栖。比喻高位或帝位。","source":{"text":"我想起那李公子呵，所事撑达，与他争甚么凤食鸾栖。我自向碧梧中别寻支节。","book":"明·张凤翼《红拂记·髯客海归》"},"usage":"作宾语、定语；用于比喻句"},{"id":8033,"word":"凤骨龙姿","pinyin":"fèng gǔ lóng zī","abbr":"fglz","explanation":"形容超凡的体格和仪态。","source":{"text":"今视子之质，实霄景高焕，圆精重照，凤骨龙姿，脑色宝曜。","book":"《云笈七签》卷四"},"usage":"作宾语、定语；用于比喻句"},{"id":8034,"word":"凤髓龙肝","pinyin":"fèng suǐ lóng gān","abbr":"fslg","explanation":"比喻珍奇美味。","source":{"text":"他故人情蔼，消受他凤髓龙肝；我寸舌应嚼坏，愧没归遗两女子。","book":"明·孙仁孺《东郭记·吾将瞷良人之所也》"},"example":{"text":"老孙五百年前大闹天宫时，吃老君丹、玉皇酒，王母桃，及～——那样东西我不曾吃过？","book":"《西游记》第七五回"},"similar":["龙肝凤髓"],"usage":"作宾语、定语；用于比喻句"},{"id":8035,"word":"凤鸟不至","pinyin":"fèng niǎo bù zhì","abbr":"fnbz","explanation":"凤鸟：指凤凰，吉祥的象征。凤凰不来。比喻天下不太平，政治不清明，无希望。","source":{"text":"凤鸟不至，河不出图，吾已矣夫。","book":"《论语·子罕》"}},{"id":8036,"word":"凤鸣朝阳","pinyin":"fèng míng zhāo yáng","abbr":"fmzy","explanation":"朝阳：早晨的太阳。凤凰在早晨的阳光中鸣叫。比喻有高才的人得到发挥的机会。","source":{"text":"凤凰鸣矣，于彼高冈；梧桐生矣，于彼朝阳。","book":"《诗经·大雅·卷阿》"},"example":{"text":"首劾大学士和珅。疏语援据经义，天下比之～。","book":"《清儒学案》卷一百"},"similar":["朝阳鸣凤"],"usage":"作谓语；比喻有能力的人得到发挥的机会"},{"id":8037,"word":"凤鸣鹤唳","pinyin":"fèng míng hè lì","abbr":"fmhl","explanation":"形容优美的声音。"},{"id":8038,"word":"凤鸣麟出","pinyin":"fèng míng lín chū","abbr":"fmlc","explanation":"凤凰鸣唱，麒麟出现。比喻贤人出现。"},{"id":8039,"word":"凫居雁聚","pinyin":"fú jū yàn jù","abbr":"fjyj","explanation":"指群聚一处。","source":{"text":"然而天下之人，凫居雁聚，散而之四方而无禁也者，数千百年矣。","book":"宋·王安石《上五事书》"},"usage":"作谓语、定语；用于比喻句"},{"id":8040,"word":"凫短鹤长","pinyin":"fú duǎn hè cháng","abbr":"fdhc","explanation":"凫胫短鹤胫长。长短不齐。泛指馀缺不齐。","source":{"text":"算到天明走到黑，赤紧的是衣食。凫短鹤长不能走。","book":"元·关汉卿《乔牌儿》套曲"},"usage":"作宾语、定语；用于事物比较"},{"id":8041,"word":"凫胫鹤膝","pinyin":"fú jìng hè xī","abbr":"fjhx","explanation":"指事物各有长短。","source":{"text":"是故凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"战国·宋·庄周《庄子·骈拇》"},"example":{"text":"冠卿年亦有～之诮。","book":"清·无名氏《帝城花样·琯霞传》"},"usage":"作宾语、定语；指事物各有长短"},{"id":8042,"word":"凫趋雀跃","pinyin":"fú qū què yuè","abbr":"fqqy","explanation":"凫：野鸭。象野鸭那样快跑，象鸟雀那样跳跃。形容十分欢欣的样子。","source":{"text":"渔者观焉，乃具竿索，集朋党，凫趋雀跃，风驰电往，竞下任公之钓，争陈豫且之网。","book":"唐·卢照邻《穷鱼赋》"},"example":{"text":"闻之者～，见之者足蹈手舞，非测日之表可俦，非凌云之梯足数。","book":"唐·梁涉《长竿赋》"},"usage":"作谓语、定语；比喻欢欣鼓舞"},{"id":8043,"word":"凫鹤从方","pinyin":"fú hè cóng fāng","abbr":"fhcf","explanation":"指野鸭和鹤各从其所属的品类。比喻顺其自然行事。","source":{"text":"伏愿天明照其心请，乞改今局，授以闲曹，则凫鹤从方，所忧去矣。","book":"《宋书·孔觊传》"},"usage":"作宾语、定语；用于书面语"},{"id":8044,"word":"凭几之诏","pinyin":"píng jǐ zhī zhào","abbr":"pjzz","explanation":"指皇帝临终遗诏。","source":{"text":"方奉凭几之诏，遽卒，士论惜之。","book":"明·沈德符《野获编·礼部·宗伯执持》"},"usage":"作宾语；用于书面语"},{"id":8045,"word":"凭几据杖","pinyin":"píng jī jù zhàng","abbr":"pjjz","explanation":"形容傲慢不以礼待客。","source":{"text":"冯几据杖，眄视指使，则厮役之人至。","book":"西汉·刘向《战国策·燕策一》"},"example":{"text":"～，以令召焉，则厮役之才至矣。","book":"唐·白居易《策林·尊贤》"},"similar":["目指气使"],"usage":"作谓语；指傲慢待客"},{"id":8046,"word":"凭城借一","pinyin":"píng chéng jiè yī","abbr":"pcjy","explanation":"背城借一。指与敌决一死战。","source":{"text":"负塞残孽，阻山烬党，收险窃命，凭城借一，则当因威席卷，乘机芟剿。","book":"《宋书·袁淑传》"},"similar":["背城借一"],"usage":"作谓语、定语；形容作最后一搏"},{"id":8047,"word":"凭山负海","pinyin":"píng shān fù hǎi","abbr":"psfh","explanation":"凭：依靠；负：背倚。依凭山峦，背倚大海。形容十分优越的地理条件。","source":{"text":"福州凭山负海，东南都会，富庶之邦。","book":"明·冯梦龙《警世通言》第12卷"},"usage":"作谓语、定语；用于地形"},{"id":8048,"word":"凭河暴虎","pinyin":"píng hé bào hǔ","abbr":"phbh","explanation":"凭：从水中走过去；暴：空手搏斗；暴虎：空手打虎。比喻冒险行事，有勇无谋。也比喻勇猛果敢。","source":{"text":"漫夸他陆地行舟，也何用凌空举鼎，凭河暴虎皆亡命，蝇头蜗角纷争。","book":"明·胡文焕《群音类选·》"},"similar":["暴虎冯河"],"usage":"作谓语、定语、分句；比喻有勇无谋"},{"id":8049,"word":"凭白无故","pinyin":"píng bái wú gù","abbr":"pbwg","explanation":"犹言无缘无故。没有一点原因。","source":{"text":"后来他走过来问我叫甚么名字，我不理他，为什么凭白无故问名字呢？","book":"高缨《达吉和她的父亲》"},"example":{"text":"他没想到会～遇到这样的一场难堪"},"similar":["平白无故"],"usage":"作状语；指无缘无故"},{"id":8050,"word":"凭空捏造","pinyin":"píng kōng niē zào","abbr":"pknz","explanation":"毫无根据的擅加伪做。","source":{"text":"近世作伪者多凭空捏造 ，苟得金钱，兵部武选司吏胥概为准行。","book":"明·沈德符《万历野获编补遗·土司·土官承袭》"},"example":{"text":"天女如何下降，不知与天孙织女作何称呼？小子尚不敢～，是从史籍上翻阅得来。","book":"蔡东藩《清史演义》第一回"},"similar":["凭空臆造","凭空想像"],"usage":"作谓语、宾语；指虚构"},{"id":8051,"word":"凭空臆造","pinyin":"píng kōng yì zào","abbr":"pkyz","explanation":"臆：主观。毫无根据地编造、虚构。","source":{"text":"凭空臆造，蔑古又熟甚哉！","book":"清·江藩《经解入门》"},"example":{"text":"不要～一些证据。"},"similar":["凭空捏造"],"opposite":["有凭有据"],"usage":"作谓语、宾语；指虚构"},{"id":8052,"word":"凭虚公子","pinyin":"píng xū gōng zǐ","abbr":"pxgz","explanation":"凭：依托。比喻假设的人或事。","source":{"text":"有凭虚公子者，心奓体忲。","book":"汉·张衡《西京赋》"},"example":{"text":"～就是子虚先生。"},"similar":["子虚公子"],"usage":"作宾语、定语；指假设的人或事","story":["西汉时期，司马相如写的《子虚赋》深得汉武帝的喜爱。《子虚赋》讲楚王派子虚去访问齐王。齐王率全国游猎能手陪同子虚外出打猎。子虚竭力向陪同的乌有先生吹嘘楚王的游猎盛况，故意贬低齐王。乌有先生立即替齐王辩驳，向子虚发难"]},{"id":8053,"word":"凭轼旁观","pinyin":"píng shì páng guān","abbr":"pspg","explanation":"靠在车前横木上旁观。比喻置身事外。","source":{"text":"土人自此以为俄不足为战，诸国皆凭轼旁观。","book":"清·王韬《土胜俄不足恃》"},"similar":["袖手旁观"],"usage":"作谓语、定语；用于书面语"},{"id":8054,"word":"凭轼结辙","pinyin":"píng shì jié zhé","abbr":"psjz","explanation":"凭轼：靠着车前扶手；结辙：车轮的辙迹相迭，形容车马络绎。驾车奔走，不绝于道。","source":{"text":"游士无所植其足，则凭轼结辙而违之。","book":"《子华子·晏子问党》"},"usage":"作谓语、定语；形容车马络绎"},{"id":8055,"word":"凭险作守","pinyin":"píng xiǎn zuò shǒu","abbr":"pxzs","explanation":"凭：靠着。凭依地势险要而坚守。","source":{"text":"凭险作守，兵食兼资，风激电骇，莫不震叠。","book":"《南史·梁武帝纪·封梁公策》"},"usage":"作谓语、定语；用于书面语"},{"id":8056,"word":"凯旋而归","pinyin":"kǎi xuán ér guī","abbr":"kxeg","explanation":"打仗得胜后返回。","example":{"text":"我们打了胜仗，～，受到表彰。"},"similar":["得胜回朝"],"usage":"作谓语；指胜利归来"},{"id":8057,"word":"凯风寒泉","pinyin":"kǎi fēng hán quán","abbr":"kfhq","explanation":"凯风：和风，比喻母爱；寒泉：比喻劳苦、忧患。表示子女对母亲的深切思念。","source":{"text":"凯风自南，吹彼棘心，棘心夭夭，母氏劬劳……爰有寒泉，在滩之下。有子七人，母氏劳苦。","book":"《诗经·邶风·凯风》"},"example":{"text":"有光少不能事先孺人，迨外祖之春秋高，又不能养，至今每念外家，不胜～之思。","book":"明·归有光《六母舅后江周翁寿序》"}},{"id":8058,"word":"凶喘肤汗","pinyin":"xiōng chuǎn fū hàn","abbr":"xcfh","explanation":"形容疲乏到极点。","source":{"text":"胸喘肤汗，人极马倦。","book":"《汉书·王褒传》"}},{"id":8059,"word":"凶多吉少","pinyin":"xiōng duō jí shǎo","abbr":"xdjs","explanation":"凶：不幸；吉：吉利。指估计事态的发展趋势不妙，凶害多，吉利少。","source":{"text":"你去后多凶少吉，干这般尽忠竭力。","book":"元·无名氏《赚蒯通》第二折"},"example":{"text":"主公抱病半月，被奸臣隔绝内外，声息不通。世子此梦，～。","book":"明·冯梦龙《东周列国志》第三十二回"},"similar":["九死一生"],"opposite":["吉星高照"],"usage":"作谓语、定语；指形势不妙"},{"id":8060,"word":"凶年恶岁","pinyin":"xiōng nián è suì","abbr":"xnes","explanation":"凶年：年成很坏。指饥荒的年头","source":{"text":"凶年恶岁，则行货物，流有余而调不足也。","book":"汉·桓宽《盐铁论·力耕》"},"similar":["凶年饥岁"],"usage":"作主语、宾语、定语；指荒年"},{"id":8061,"word":"凶年饥岁","pinyin":"xiōng nián jī suì","abbr":"xnjs","explanation":"凶年：年成很坏。指荒年。","source":{"text":"凶年饥岁，君之民，老弱转乎沟壑，壮者散而之四方者，几千人矣。","book":"《孟子·梁惠王下》"},"example":{"text":"夫为令之职，必使境内之民～免于死亡。","book":"宋《二程全书·外书十二》"},"similar":["凶年恶岁"],"usage":"作主语、宾语、定语；指荒年"},{"id":8062,"word":"凶恣挠法","pinyin":"xiōng zì náo fǎ","abbr":"xznf","explanation":"挠：扰乱。任意凶横，扰乱法令。","source":{"text":"将军沙吒利凶恣挠法，凭恃微功，驱有志之妾，干无为之政。","book":"唐·许尧佐《柳氏传》"}},{"id":8063,"word":"凶残成性","pinyin":"xiōng cán chéng xìng","abbr":"xccx","explanation":"凶恶残暴成了本性。形容极其凶狠残暴。","example":{"text":"我们遇到了一伙～的歹徒，必须以暴制暴。"},"usage":"作谓语、定语；用于为人"},{"id":8064,"word":"凶相毕露","pinyin":"xiōng xiàng bì lù","abbr":"xxbl","explanation":"毕：完全。凶恶的面目完全暴露了出来。","source":{"text":"吴丙治向他征收税款时，他凶相毕露地威胁：‘谁有钱给你，小心你的脑袋吧！’","book":"柯岩《追赶太阳的人》"},"example":{"text":"此时，他～，完全是一个流氓。"},"similar":["面目狰狞"],"opposite":["笑容可掬"],"usage":"作谓语、宾语、状语；指人的恶态"},{"id":8065,"word":"凶短折","pinyin":"xiōng duǎn zhé","abbr":"xdz","explanation":"短：短寿；折：死亡。指夭折，早死。","source":{"text":"六极，一曰凶短折。","book":"《尚书·洪范》"},"example":{"text":"厥咎雾，厥罚常风，厥极～。","book":"《新唐书·五行志二》"}},{"id":8066,"word":"凶神恶煞","pinyin":"xiōng shén è shà","abbr":"xses","explanation":"原指凶恶的神。后用来形容非常凶恶的人。","source":{"text":"又犯着金神七煞上路，又犯着太岁，遭这般凶神恶煞，必然板僵身死了也。","book":"元·无名氏《桃花女》第三折"},"example":{"text":"大家一看见金四和那些～的家丁，就知道是怎么一回事了。","book":"马忆湘《朝阳花》第一章"},"similar":["妖魔鬼怪","混世魔王","如狼似虎"],"opposite":["慈眉善目","良师益友"],"usage":"作宾语、定语、状语；指凶恶的人"},{"id":8067,"word":"凶竖得志","pinyin":"xiōng shǔ dé zhì","abbr":"xsdz","explanation":"凶竖：凶恶的小人。凶恶的小人得行其志。","source":{"text":"当是时，凶竖得志，士大夫皆丧其志矣。","book":"《后汉书·窦武传》"},"similar":["小人得志"],"usage":"作谓语、宾语；用于书面语"},{"id":8068,"word":"凶终隙未","pinyin":"xiōng zhōng xì wèi","abbr":"xzxw","explanation":"指交道不永，朋友最终变成仇人。隙，嫌隙，仇恨。"},{"id":8069,"word":"凶终隙末","pinyin":"xiōng zhōng xì mò","abbr":"xzxm","explanation":"凶：杀人；隙：嫌隙，仇恨；终、末：最后，结果。指彼此友谊不能始终保持，朋友变成了仇敌。","source":{"text":"张、陈凶其终，萧、朱隙其末，故知全之者鲜矣。","book":"《后汉书·王丹传》"},"usage":"作谓语、定语；指朋友变成了仇敌","story":["汉朝时期，有管鲍之交的张耳与陈余两人特别要好，曾经发誓要为刎颈至交，后来张耳成为汉朝的将领，与陈余产生了矛盾，最终在泜水边杀了陈余。同样萧育与朱博两位至交好友，也同样因为各自利益而反目成仇，最后自相残杀"]},{"id":8070,"word":"凶饥妖孽","pinyin":"xiōng jī yāo niè","abbr":"xjyn","explanation":"凶：谷物不收，年成不好。指饥荒灾害。","source":{"text":"故无水旱昆虫之灾，民无凶饥妖孽之疾。","book":"《礼记·礼运》"}},{"id":8071,"word":"凸凹不平","pinyin":"tū āo bù píng","abbr":"tabp","explanation":"指凹进与凸出，不在同一水平面。","source":{"text":"路面凸凹不平，车行其上，忽高忽低。","book":"《中国的西北角·陕甘形势片断》"},"similar":["凹凸不平","坎坷不平"],"usage":"作谓语、定语；指不平坦"},{"id":8072,"word":"凹凸不平","pinyin":"āo tū bù píng","abbr":"atbp","explanation":"形容平面上有凸出和凹进的地方。","source":{"text":"道路是凹凸不平的，柴屑粪渣，零零散散地散布在路上。","book":"方志敏《我从事革命斗争的略述》"},"example":{"text":"方志敏《我从事革命斗争的略述》：“道路是凹凸不平的，柴屑粪渣，零零散散地散布在路上。”"},"similar":["坎坷不平"],"opposite":["平平坦坦"],"usage":"作谓语、定语；形容物体的表面"},{"id":8073,"word":"出一头地","pinyin":"chū yī tóu dì","abbr":"cytd","explanation":"指当避开此人让其高出众人一头之地。后以之比喻高人一着。","source":{"text":"读轼（苏轼）书，不觉汗出。快哉快哉！老夫当避路，放他出一头地也。","book":"宋·欧阳修《与梅圣俞书》"},"example":{"text":"钱文敏尚书虽师之而为黄子久一派，其气象雄迈，固自另～。","book":"清·沈初《西清笔记·纪文献》"},"similar":["出人头地"],"usage":"作谓语、定语；指超出别人"},{"id":8074,"word":"出丑扬疾","pinyin":"chū chǒu yáng jí","abbr":"ccyj","explanation":"暴露丑恶。","source":{"text":"这一场出丑扬疾，安排下佯小心，妆大胆，丹方一味。","book":"元·关汉卿《玉镜台》第三折"},"example":{"text":"你既主张了罢，也免的～，也见我祖宗家门清洁。","book":"明·贾仲名《萧淑兰》第四折"},"usage":"作谓语、宾语；指暴露丑行"},{"id":8075,"word":"出丑放乖","pinyin":"chū chǒu fàng guāi","abbr":"ccfg","explanation":"犹言出乖露丑。","source":{"text":"窃以达磨昔年，莽卤截鹤续凫；天宁今日，颟顸证龟作鳖，可怜弄七成拙，不免出丑放乖。","book":"元·耶律楚材《为石壁寺请信公庵主开堂疏》"},"similar":["出乖露丑"],"usage":"作谓语、宾语；用于人的言行等"},{"id":8076,"word":"出丑狼籍","pinyin":"chū chǒu láng jí","abbr":"cclj","explanation":"出丑：丢脸。丢脸丢得不成样子。","source":{"text":"你这些无情没福的和尚，我也没功夫出丑狼籍与你打官司，待几日饿死了，出我这口恶气罢。","book":"《后西游记》第二十五回"}},{"id":8077,"word":"出世离群","pinyin":"chū shì lí qún","abbr":"cslq","explanation":"指脱离人世。","source":{"text":"他只顾把这些出世离群的话当作一件正经事，终久不妥！","book":"《红楼梦》第一一八回"},"opposite":["同流合污"],"usage":"作谓语、定语；指避世"},{"id":8078,"word":"出世超凡","pinyin":"chū shì chāo fán","abbr":"cscf","explanation":"超出尘世和凡俗。旧指脱离世俗生活，上升到仙界。","source":{"text":"你有那出世超凡神仙分，系一条一抹绦，带一顶九阳巾，君敢着你做真人。","book":"元·马致远《黄梁梦》第一折"},"similar":["超凡出世"],"usage":"作谓语、定语；指不同凡俗"},{"id":8079,"word":"出乎其类，拔乎其萃","pinyin":"chū hū qí lèi，bá hū qí cuì","abbr":"chqlbhqc","explanation":"出：超过；类：同类；拔：超出；萃：草丛生的样子，引申为同类聚集。指人的品德才能超出同类之上。","source":{"text":"圣人之于民，亦类也。出于其类，拔乎其萃，自生民以来，未有盛于孔子也。","book":"战国·邹·孟轲《孟子·公孙丑上》"},"example":{"text":"～者，不可胜记。","book":"明·罗贯中《三国演义》第60回"},"similar":["出类拔萃","出类拔群"],"usage":"作谓语、定语、分句；用于书面语"},{"id":8080,"word":"出乎反乎","pinyin":"chū hū fǎn hū","abbr":"chfh","explanation":"犹言出尔反尔。指翻悔或说了不照着做。","source":{"text":"怕只怕你，出乎反乎，一旦之间，把奴就撇。我的天哪，叫我依靠何人？","book":"《白雪遗音·起字呀呀哟·闷坐牙床》"},"example":{"text":"谁料尔～，辜负我一片同仁同义之心矣。","book":"太平天国·李秀成《谕李昭寿书》"},"usage":"作谓语、状语；用于口语"},{"id":8081,"word":"出乎意外","pinyin":"chū hū yì wài","abbr":"chyw","explanation":"用于意想、预料之外。","source":{"text":"不想姑娘闹了个皮子，蔫蔫儿的受了，自己倒出乎意外，一时抓不着话岔儿。","book":"清·文康《儿女英雄传》第25回"},"example":{"text":"几天之后，果然遇见了，在他们可算是～了。","book":"郭沫若《洪波曲》第一章三"},"similar":["出人意表","出人意料"],"opposite":["防患未然","严阵以待"],"usage":"作谓语、定语、状语；用于“出乎……意外”"},{"id":8082,"word":"出乎意料","pinyin":"chū hū yì liào","abbr":"chyl","explanation":"指出人意料。","source":{"text":"准备对付可能的突然事变，使党和革命不在可能的突然事变中遭受出乎意料的损失。","book":"毛泽东《发刊词》"},"example":{"text":"老朋友劝他出去一下调理也好，～的是学校竟然不准。","book":"吴晗《清华杂议》"},"similar":["出乎意外"],"opposite":["意料之中"],"usage":"作谓语、定语、状语；指意想不到"},{"id":8083,"word":"出乎意表","pinyin":"chū hū yì biǎo","abbr":"chyb","explanation":"指出于意料之外。","source":{"text":"我想只要离开这里，子君便如还在我的身边；至少，也如还在城中，有一天，将要出乎意表地访我，像住在会馆时侯似的。","book":"鲁迅《彷徨·伤逝》"},"similar":["出人意表","出人望外"],"usage":"作谓语、定语、状语；指出乎人们意料之外"},{"id":8084,"word":"出乎预料","pinyin":"chū hū yù liào","abbr":"chyl","explanation":"指出人意料。","source":{"text":"白莎轻微地一怔，她对丁猛的平淡反应出乎预料。","book":"柯云路《三千万》"},"example":{"text":"这件事我真～。"},"similar":["出人意料","出乎意料"],"opposite":["意料之中"],"usage":"作谓语、定语；指意料之外"},{"id":8085,"word":"出乖弄丑","pinyin":"chū guāi nòng chǒu","abbr":"cgnc","explanation":"出丑，丢脸。","source":{"text":"已恁地出乖弄丑，泼水再难收。","book":"金·董解元《西厢记诸宫调》卷下"},"example":{"text":"[络丝娘]不争和张解元参辰卯酉，便是与崔相国～。到底干连着自己骨肉，夫人索穷究。","book":"元·王实甫《西厢记》第四本第二折"},"similar":["出乖露丑"],"usage":"作谓语、宾语、定语；指出丑"},{"id":8086,"word":"出乖露丑","pinyin":"chū guāi lù chǒu","abbr":"cglc","explanation":"乖：荒谬的；丑：可耻的。指在人前出丑。","source":{"text":"已恁地出乖弄丑，泼水再难收。","book":"金·董解元《西厢记诸宫调》卷下"},"example":{"text":"象我娄家表叔结交了多少人，一个个～，若听见这样话，岂不羞死！","book":"清·吴敬梓《儒林外史》第十四回"},"similar":["丑态百出","出乖弄丑"],"opposite":["威风凛凛","绰约多姿"],"usage":"作谓语、宾语、定语；指出丑"},{"id":8087,"word":"出于意外","pinyin":"chū yú yì wài","abbr":"cyyw","explanation":"指出乎人的意料之外。","source":{"text":"自想这件事真出于意外，必须自家投到，中诉明白，不能平白地叫妻子良受诬辱。","book":"《黄绣球》第四回"},"example":{"text":"钱钟书《围城》：“方鸿渐表示不知道汪太太会画，～。”"},"similar":["出人意料","出自意外"],"usage":"作谓语、定语、状语；指出乎人们意料之外"},{"id":8088,"word":"出于意表","pinyin":"chū yú yì biǎo","abbr":"cyyb","explanation":"指出乎人的意料之外。","source":{"text":"一夕，风月晴莹，有扣门者，出视之，见一丈夫，衣冠甚伟，仪状秀逸。乔延入与坐，谈议朗畅，出于意表。乔重之，以为人无及者。","book":"唐·张读《宣室志》卷四"},"similar":["出乎意表","出于意外"],"usage":"作谓语、定语、状语；指出乎人们意料之外"},{"id":8089,"word":"出于无奈","pinyin":"chū yú wú nài","abbr":"cywn","explanation":"指实在没有办法而不得不这样。无奈：无可奈何。","source":{"text":"本待砍你狗头，怜你也是贫民，出于无奈，饶你去罢！","book":"《隋史遗文》四回"},"example":{"text":"他～才答应退休的。"},"similar":["无可奈何"],"usage":"作谓语、状语；指被迫"},{"id":8090,"word":"出于水火，登之衽席","pinyin":"chū yú shuǐ huǒ，dēng zhī rèn xí","abbr":"cyshdzrx","explanation":"登：加上；衽席：床席。把人从水火中拉出来放到床上。比喻解救危难中的人们。","source":{"text":"国维四固，安于泰山，出于水火而登之衽席，则其幸耳。","book":"章炳麟《致南京参议会论建都书》"},"similar":["拔诸水火，登于衽席"],"usage":"作宾语、定语；指为别人解困"},{"id":8091,"word":"出云入泥","pinyin":"chū yún rù ní","abbr":"cyrn","explanation":"指自己一旦青云直上，便不惜将旧时朋友踩入泥中。比喻人情浇薄，世态炎凉。","source":{"text":"及一旦势位崇，名誉盛，畴昔知交，贫贱潦倒，伏处田里，不足引援，往往尽削其酬酢诗文，不使一篇登之集中，出云入泥，良可浩叹。","book":"清·王韬《徐古春耆旧诗存序》"},"usage":"作宾语、定语；用于处世"},{"id":8092,"word":"出人口，入人耳","pinyin":"chū rén kǒu，rù rén ěr","abbr":"crkrre","explanation":"原指两人私下谈话，第三者不会知道。后多指话一说出口，就会为人们传开。","source":{"text":"言出于余口，入于尔耳，谁告建也。","book":"《左传·昭公二十年》"}},{"id":8093,"word":"出人头地","pinyin":"chū rén tóu dì","abbr":"crtd","explanation":"指高人一等。形容德才超众或成就突出。","source":{"text":"老夫当避路，放他出一头地也。","book":"宋·欧阳修《与梅圣俞书》"},"example":{"text":"孙俊英见人家看得起，能～，一呼百应，好不威风自在。","book":"冯德英《迎春花》第八章"},"similar":["高人一等","崭露头角"],"opposite":["相形见绌","庸庸碌碌"],"usage":"作谓语、宾语、定语；指人的前途","story":["北宋嘉佑年间，四川的苏轼到京城汴梁参加进士考试，主考官欧阳修看到苏轼的试卷以为是自己朋友的，将本应取第一名的只给其第二名。苏轼考取进士后给欧阳修写了一封感谢信，欧阳修感叹他的才华，说应该给他出人头地的机会"]},{"id":8094,"word":"出人意外","pinyin":"chū rén yì wài","abbr":"cryw","explanation":"出于人们的意料之外，都没想到的。","source":{"text":"所以天下事往往有出人意外的。","book":"清·吴趼人《二十年目睹之怪现状》第九回"},"example":{"text":"向来就不讲什么道理，两面的斗争，大约总要开始的，或者还会酿成一种～的奇观。","book":"鲁迅《彷徨·孤独者》"},"similar":["出人意表"],"opposite":["意料之中"],"usage":"作谓语、定语；指意料之外的事情"},{"id":8095,"word":"出人意料","pinyin":"chū rén yì liào","abbr":"cryl","explanation":"出乎人们意料之外。","source":{"text":"宪常招引诸生与之谈论新义，出人意表，同辈咸嗟服焉。","book":"《南史·袁宪传》"},"example":{"text":"才貌却相当，缘合未堪奇赏，～，在那错联鸾凰。","book":"明·无名氏《赠书记·奉诏团圆》"},"similar":["出乎意料","出其不意"],"opposite":["防患未然"],"usage":"作谓语、定语、状语；指出乎人们意料之外","story":["薛姨妈怕黛玉寂寞就到潇湘馆去看她，宝钗也随去。她们与黛玉聊“千里姻缘一线牵”与月下老人的事。薛姨妈说：“这一件事，都是出人意料之外，凭父母本人都愿意了，或是年年在一处的，以为是定了的亲事，若月下老人不用红线拴的，再不能到一处。"]},{"id":8096,"word":"出人意表","pinyin":"chū rén yì biǎo","abbr":"cryb","explanation":"表：外。出乎人们意料之外。","source":{"text":"其论历代所以废兴成败，皆出人意表。","book":"《南史·袁宪传》：“宪常招引诸生与之谈论新义，出人意表，同辈咸嗟服焉。”宋·苏轼《举何去非换文资状》"},"example":{"text":"惟宋苏东坡学士有题秦穆公墓诗，～。","book":"明·冯梦龙《东周列国志》第四十七"},"similar":["出乎意外","出人意外"],"opposite":["预料之中"],"usage":"作谓语、定语、状语；指出乎人们意料之外","story":["南朝陈时袁宪从小聪明伶俐，十分好学。14岁时就被召为国子正言生，为陈后主陈叔宝的骨鲠之臣。他经常把有识之士请到家里叙谈，经常提出一些出人意表的新见解，准确而精辟，让人信服，认为他不是书本的俘虏，而是书本的主人"]},{"id":8097,"word":"出人望外","pinyin":"chū rén wàng wài","abbr":"crww","explanation":"犹出人意表。超出人们的意料。","source":{"text":"每族里计较家事，极为退懦卑约，示若无有，人或颇忽易，逮其一旦张丰大，出人望外数等，人皆惊不意，以为何术能然，直以为勉强然尔；至其久无不然。","book":"宋·叶適《高夫人墓志铭》"},"similar":["出人意表","出人意外"],"usage":"作谓语、定语、状语；指出乎人们意料之外"},{"id":8098,"word":"出以公心","pinyin":"chū yǐ gōng xīn","abbr":"cygx","explanation":"指考虑事情以国家和集体的利益为出发点。","example":{"text":"虽然事情没办好，但他是～，还是可以原谅的。"},"usage":"作宾语、定语；用于处事"},{"id":8099,"word":"出众超群","pinyin":"chū zhòng chāo qún","abbr":"czcq","explanation":"超群：超出众人之上。胜过众人。","source":{"text":"右手那个对立的壮士，打扮得出众超群，人中罕有。","book":"明·施耐庵《水浒传》第76回"},"similar":["超群出众"],"usage":"作谓语、定语；指胜过众人"},{"id":8100,"word":"出位僭言","pinyin":"chū wèi jiàn yán","abbr":"cwjy","explanation":"出位：超位；僭：越分，僭越。超越自己的低微地位，说了无权说或不应说的话。指超越本人身价的言论。","source":{"text":"出位僭言，惶战交积。","book":"唐·柳宗元《上裴晋公度献唐雅诗启》"},"usage":"作宾语、定语；用于口语"},{"id":8101,"word":"出何典记","pinyin":"chū hé diǎn jì","abbr":"chdj","explanation":"指无稽之谈。","source":{"text":"寐与周公通梦，静与孔子同意，师而可嘲，出何典记。","book":"《后汉书·边韶传》"},"similar":["无稽之谈","出何经典"],"opposite":["言之有据"],"usage":"作谓语；指诘问有何根据"},{"id":8102,"word":"出何经典","pinyin":"chū hé jīng diǎn","abbr":"chjd","explanation":"指不知所说出自何书，有无根据。","source":{"text":"融与操书，称武王伐纣以姐己赐周公，操不悟其嘲己，问：‘出何经典？’","book":"《后汉书·孔融传》"},"similar":["出何典记"],"usage":"作谓语；指诘问有何根据"},{"id":8103,"word":"出作入息","pinyin":"chū zuò rù xī","abbr":"czrx","explanation":"太阳一出来就开始工作，太阳落山就休息。指日常生活。","source":{"text":"日用饭食，出作入息，便是乐尧舜之道。","book":"宋·朱熹《朱子语类·孟子》"}},{"id":8104,"word":"出入人罪","pinyin":"chū rù rén zuì","abbr":"crrz","explanation":"指法庭裁判错误，把有罪的人认为无罪，把无罪的人认为有罪。","source":{"text":"然见其用刑与古相戾，何者？今法吏所禁之切者曰：‘故出入人罪而已。’","book":"宋·王禹偁《用刑论》"},"example":{"text":"有依此律～者，以故论。","book":"《明史·刑法志一》"},"similar":["故入人罪"],"usage":"作谓语、宾语；指妄自给人加罪名"},{"id":8105,"word":"出入将相","pinyin":"chū rù jiāng xiāng","abbr":"crjx","explanation":"犹出将入相。","source":{"text":"故能出入将相，勤劳王家。","book":"宋·欧阳修《相州尽锦堂记》"},"example":{"text":"[潞公]～五十年，以太师致仕，年逾九十。","book":"宋·邵伯温《闻见前录》卷八"},"similar":["出将入相"],"usage":"作谓语、定语；指文武双全，官居高位"},{"id":8106,"word":"出入无常","pinyin":"chū rù wú cháng","abbr":"crwc","explanation":"出：出现；没：隐没。出现与隐没没有规律，捉摸不定。","source":{"text":"常以十月入太微，受制而出行列宿，司无道，出入无常。","book":"西汉·司马迁《史记·天官书》：“以处荧惑”司马贞索隐引晋灼云"},"similar":["出没不常"],"usage":"作谓语、定语；用于神秘的人或事物"},{"id":8107,"word":"出入无时","pinyin":"chū rù wú shí","abbr":"crws","explanation":"进出没有一定的时间。","source":{"text":"操则存，舍则亡，出入无时，莫知其乡，惟心之谓与？","book":"《孟子·告子上》"}},{"id":8108,"word":"出入无间","pinyin":"chū rù wú jiān","abbr":"crwj","explanation":"出入无间隔。犹言进出自由。","source":{"text":"建谓左右曰：‘吾为神策将军时，宿卫禁中，见天子夜召学士，出入无间，恩礼亲厚如寮，非将相可比也。’","book":"《新五代史·前蜀世家·王建》"},"similar":["畅通无阻"],"usage":"作谓语；用于人或事物等"},{"id":8109,"word":"出入生死","pinyin":"chū rù shēng sǐ","abbr":"crss","explanation":"犹出生入死。","source":{"text":"吾常亲锋刃，冒矢石，出入生死，与子同之。","book":"唐·韩偓《海山记》"},"similar":["出生入死","出死入生"],"usage":"作谓语、定语；同“出生入死”"},{"id":8110,"word":"出入相友","pinyin":"chū rù xiāng yǒu","abbr":"crxy","explanation":"出去做工，回家休息，大家都是同伴，应彼此互助，和睦相处。","source":{"text":"乡田同井，出入相友，守望相助，疾病相扶持。","book":"《孟子·滕文公上》"}},{"id":8111,"word":"出入神鬼","pinyin":"chū rù shén guǐ","abbr":"crsg","explanation":"犹言神出鬼没。","source":{"text":"今其书论奇权密机，出入神鬼，自古以兵著书者罕所及。","book":"宋·苏洵《权书下·孙武》"},"similar":["神出鬼没"],"usage":"作谓语、定语；同“神出鬼没”"},{"id":8112,"word":"出入起居","pinyin":"chū rù qǐ jū","abbr":"crqj","explanation":"泛指生活上的行为。","source":{"text":"出入起居，罔有不饮权。","book":"《尚书·冏》"}},{"id":8113,"word":"出公忘私","pinyin":"chū gōng wàng sī","abbr":"cgws","explanation":"出于公心忘掉私情。","source":{"text":"非出公忘私、尽扫刮同异恩怨、屏置城府外，不足称朝廷委任、寄耳目之意。","book":"清·梅曾亮《送周石生序》"},"usage":"作宾语、定语；用于忘掉私情"},{"id":8114,"word":"出其不备","pinyin":"chū qí bù bèi","abbr":"cqbb","explanation":"指行动出乎人的意料。","source":{"text":"这倒不是道家法术，倒是用兵最精的所谓‘守如处女，出如脱兔’，‘出其不备’的妙策。","book":"清·曹雪芹《红楼梦》第73回"},"example":{"text":"做事取胜之道就是～。"},"similar":["出其不意"],"opposite":["不出所料"],"usage":"作谓语；指乘人不备"},{"id":8115,"word":"出其不意","pinyin":"chū qí bù yì","abbr":"cqby","explanation":"其：代词，对方；不意：没有料到。趁对方没有意料到就采取行动。","source":{"text":"攻其无备，出其不意。","book":"《孙子·计篇》"},"example":{"text":"今日是年晚，此老必定在家，须乘此时调兵围住，～，方无走失。","book":"明·凌濛初《二刻拍案惊奇》卷四"},"similar":["攻其不备","出人意外"],"opposite":["意料之中","不出所料"],"usage":"作谓语、宾语、定语；指乘人不备突然行动","story":["东汉末年，曹操打败了袁绍，平定了北方，高干在并州据地称王，河东卫固、范先表面要求任太守，实际与高干暗通，曹操没有让他们任太守，由杜畿担任河东太守。杜畿说自己孤身前去赴任，让卫固感到出乎意料，然后分化他们来巩固地位"]},{"id":8116,"word":"出其不意，掩其不备","pinyin":"chū qí bù yì，yǎn qí bù bèi","abbr":"cqbyyqbb","explanation":"原指出兵攻击对方不防备的地方。后亦指行动出乎人的意料。","source":{"text":"攻其无备，出其不意。","book":"语出《孙子·计》"},"example":{"text":"罕之料吾不敢渡九鼎，以吾兵少而来远，且不虞吾之速至也。～者，兵家之胜策也。","book":"《新五代史·杂传六·丁会》"},"similar":["出其不意，攻其不备"],"usage":"作宾语、定语、状语；用于处事"},{"id":8117,"word":"出其不意，攻其不备","pinyin":"chū qí bù yì，gōng qí bù bèi","abbr":"cqbygqbb","explanation":"原指出兵攻击对方不防备的地方。后亦指行动出乎人的意料。","source":{"text":"攻其无备，出其不意。","book":"语出《孙子·计》"},"example":{"text":"畜精锐，乘懈沮，～，则边人之仇报，奔北之耻雪矣。","book":"《后汉书·庞参传》"},"similar":["出其不意，攻其无备"],"usage":"作宾语、定语、状语；用于处事"},{"id":8118,"word":"出其不意，攻其无备","pinyin":"chū qí bù yì，gōng qí wú bèi","abbr":"cqbygqwb","explanation":"原指出兵攻击对方不防备的地方。后亦指行动出乎人的意料。","source":{"text":"攻其无备，出其不意。","book":"语出《孙子·计》"},"example":{"text":"苗子们今日过年，正好～。","book":"《儒林外史》第四三回"},"similar":["出其不意，掩其不备"],"usage":"作宾语、定语、状语；用于处事"},{"id":8119,"word":"出其不虞","pinyin":"chū qí bù yú","abbr":"cqby","explanation":"犹言出其不意。指行动出乎人的意料。","source":{"text":"若星驰电发，出其不虞，精骑五百，自足平殄。","book":"《周书·段永传》"},"similar":["出其不意"],"usage":"作谓语、定语、状语；同“出其不意”"},{"id":8120,"word":"出内之吝","pinyin":"chū nèi zhī lìn","abbr":"cnzl","explanation":"舍不得拿出去，出手小气。同“出纳之吝”。","source":{"text":"子曰：‘不教而杀谓之虐；不戒视成谓之暴；慢令致期谓之贼；犹之与人也，出内之吝谓之有司。’","book":"《论语·尧白》"}},{"id":8121,"word":"出凡入胜","pinyin":"chū fán rù shèng","abbr":"cfrs","explanation":"指超出了一般，进入了极高的境界。形容造诣精深，也指超脱世俗进入仙界。","source":{"text":"点化的长生出凡入胜，这便是俺仙家百世功能。","book":"《雍熙乐府·第三卷·端正好（我恰才出尘寰）》"},"similar":["超凡入胜"],"usage":"作谓语、定语；指超出一般"},{"id":8122,"word":"出出律律","pinyin":"chū chū lǜ lǜ","abbr":"ccll","explanation":"象声词。"},{"id":8123,"word":"出力不讨好","pinyin":"chū lì bù tǎo hǎo","abbr":"clbth","explanation":"指白费功夫，没有取得成效，相反带来坏的影响。","source":{"text":"我们没必要去干这～的事情。"},"example":{"text":"我们没必要去干这～的事情"},"similar":["费力不讨好"],"usage":"作宾语、定语；指白费功夫"},{"id":8124,"word":"出卖灵魂","pinyin":"chū mài líng hún","abbr":"cmlh","explanation":"比喻以一个人的灵魂去换取荣誉、地位等。","example":{"text":"覆巢之下无完卵，岂可为一时的私利，～，而置国家民族存亡于不顾。"},"usage":"作谓语、定语；用于谴责人"},{"id":8125,"word":"出口伤人","pinyin":"chū kǒu shāng rén","abbr":"cksr","explanation":"说出话来污辱人；说出的话有损人的尊严。","source":{"text":"好妖道：‘焉敢如此出口伤人，欺吾太甚。","book":"明·许仲琳《封神演义》第四十八回"},"example":{"text":"何世清也用手一指他：“你不能～！”","book":"刘流《烈火金刚》第十一回"},"similar":["出言不逊","血口喷人"],"opposite":["彬彬有礼","谦厚有礼"],"usage":"作谓语、宾语；指言语攻击别人"},{"id":8126,"word":"出口入耳","pinyin":"chū kǒu rù ěr","abbr":"ckre","explanation":"指品德、才能超出同类之上。","source":{"text":"王曰：‘言出于余口，入于尔耳，谁告建也？’","book":"春秋·鲁·左丘明《左传·昭公二十年》"},"example":{"text":"子忠于我，我不能用，是吾罪也，子何为当然！且～之言，谁今知之！","book":"南朝·宋·范晔《后汉书·张玄传》"},"usage":"作定语；指不为外人知道的言论","story":["春秋时期，费无极向楚王诬告太子建与伍奢要在方城反叛，楚王立即把伍奢父子抓了起来，派城父与司马奋扬去捕杀太子。奋扬暗中派人通报太子。楚王奇怪这个机密只从自己口里出进奋扬的耳怎么会泄密呢？奋扬说自己护主忠心不二"]},{"id":8127,"word":"出口成章","pinyin":"chū kǒu chéng zhāng","abbr":"ckcz","explanation":"说出话来就成文章。形容文思敏捷，口才好。","source":{"text":"彼都人士，狐裘黄黄，其容不改，出言成章。","book":"《诗经·小雅·都人士》"},"example":{"text":"人皆言子建～，臣未深信。主上可召入，以才试之。","book":"明·罗贯中《三国演义》第七十九回"},"similar":["下笔成章","锦心绣口"],"opposite":["语无伦次","不知所云"],"usage":"作谓语、状语、定语；与“下笔成文”连用","story":["远古时期，舜生下时眼睛就和一般人不同，每只眼睛有两个瞳孔，所以看东西比一般人看得透，看得远。一只眼睛实际就是两只眼睛重叠，光亮强烈，对人对事都看得清楚明白，做起事来都合乎道义，说出话来就是一篇文章"]},{"id":8128,"word":"出圣入神","pinyin":"chū shèng rù shén","abbr":"csrs","explanation":"指神奇高妙。","source":{"text":"中问六语最吃紧，正是出圣入神真口诀，凡具善信根基者佩服之。","book":"明·李贽《四书评·孟子·尽心下》"},"example":{"text":"至于窦氏《璇玑》，以八寸之锦，八百余言，纵横反覆，皆成文章，夺真宰之秘，泄造化之工，可谓～，亘古一人而已。","book":"明 ·谢肇淛《五杂俎·人部四》"},"usage":"作宾语、定语；形容高妙神奇"},{"id":8129,"word":"出处殊涂","pinyin":"chū chǔ shū tú","abbr":"ccst","explanation":"指出仕与隐居的态度各不相同。亦作“出处殊途”。"},{"id":8130,"word":"出处殊途","pinyin":"chū chǔ shū tú","abbr":"ccst","explanation":"指出仕与隐居的态度各不相同。","source":{"text":"出处殊途，俯仰异容。瞻叹古烈，思迈高踪。","book":"三国·魏·阮籍《咏怀》之八"},"example":{"text":"～听所安，山林何得贱衣冠。","book":"金·元好问《论诗》之十四"},"similar":["出处殊涂"],"usage":"作宾语、定语；用于书面语"},{"id":8131,"word":"出处语默","pinyin":"chū chǔ yǔ mò","abbr":"ccym","explanation":"出仕和隐退，发言和沉默。","source":{"text":"君子之道，或出或处，或默或语。","book":"语出《易·系辞上》"},"example":{"text":"一能之士，各贡所长，～，勿强相兼。","book":"汉·王符《潜夫论·实贡》"},"usage":"作宾语、定语；用于书面语"},{"id":8132,"word":"出处进退","pinyin":"chū chǔ jìn tuì","abbr":"ccjt","explanation":"指出仕或隐退。","source":{"text":"功名成就，不居而去，其出处进退，又庶乎英魄灵气，不随异物腐散，而长在乎箕山之侧与颖水之湄。","book":"宋·王安石《祭欧阳文忠公文》"},"example":{"text":"惟一钱莫名，无所运动，～，颇令此心难决耳！","book":"清黄辅辰《戴经堂日钞》"},"usage":"作宾语、定语；用于人的处境等"},{"id":8133,"word":"出头之日","pinyin":"chū tóu zhī rì","abbr":"ctzr","explanation":"出头：摆脱困境等。指从困厄、冤屈、压抑的处境中摆脱出来的日子。","source":{"text":"如今佯推风疾举发，白日里与儿童作戏，到晚间共羊犬同眠。不知几时才得个出头之日。","book":"元·无名氏《庞娟夜走马陵道》第三折"},"example":{"text":"照此下去，我要躲到何年何月方有～！","book":"清·李宝嘉《官场现形记》第二十八回"},"usage":"作宾语；指翻身的日子"},{"id":8134,"word":"出头无日","pinyin":"chū tóu wú rì","abbr":"ctwr","explanation":"日：日子。没有出头的日子，指没有指望了","source":{"text":"也许得些师尊并西海老龙的消息，强如闷在海中，弄得出头无日。","book":"清·无垢道人《八仙全传》第五回"},"opposite":["出头有日"],"usage":"作谓语、宾语；用于期望"},{"id":8135,"word":"出头有日","pinyin":"chū tóu yǒu rì","abbr":"ctyr","explanation":"摆脱受压制的困境，已经为期不远。","source":{"text":"前年和去年的国民革命，客籍表示欢迎，以为出头有日。","book":"毛泽东《井冈山的斗争》"},"opposite":["暗无天日","出头无日"],"usage":"作谓语、宾语；用于期望"},{"id":8136,"word":"出头椽儿先朽烂","pinyin":"chū tóu chuán ér xiān xiǔ làn","abbr":"ctcexxl","explanation":"椽：屋顶上的木条；朽：腐烂。露在屋檐外的椽子先腐烂。比喻抢先出头的人先遭受挫折。","source":{"text":"张弓专等南来雁，马行崖畔收疆晚，出头椽儿先朽烂。","book":"《雍熙乐府·点绛唇》"},"similar":["枪打出头鸟"],"usage":"作宾语、定语；用于劝诫人"},{"id":8137,"word":"出头露脸","pinyin":"chū tóu lù liǎn","abbr":"ctll","explanation":"露：显露。具体显示出来，指在公开场合出现。","source":{"text":"伯伯不守戒律，伯母何必出头露脸，送与官打，被他燥皮，又要吃惊吃吓。","book":"明·伏雌教主《醋葫芦》第九回"},"similar":["出头露面"],"usage":"作谓语、宾语、定语；用于在公共场合活动"},{"id":8138,"word":"出头露面","pinyin":"chū tóu lù miàn","abbr":"ctlm","explanation":"指在公开场合出现。也指出风头。","source":{"text":"众僧们听说认亲，就把他圈子阵围将上来，一个个出头露面，咳嗽打响，巴不得要认出去。","book":"明·吴承恩《西游记》第四十四回"},"example":{"text":"甥女虽然年幼，也觉不好～。","book":"清·李汝珍《镜花缘》第四十三回"},"similar":["抛头露面","出人头地","出头露脸"],"opposite":["销声匿迹","隐姓埋名"],"usage":"作谓语、宾语、定语；用于在公共场合活动"},{"id":8139,"word":"出头鸟","pinyin":"chū tóu niǎo","abbr":"ctn","explanation":"飞在鸟群前面或把头先从窝里伸出来的鸟。比喻表现突出或领头的人。","source":{"text":"什么时候才能把那些诸如‘人怕出名猪怕壮’、‘枪打出头鸟’、‘出头椽先烂’等等‘经典哲学’从我们的生活词典中剔除了呢？","book":"路遥《平凡的世界》第四卷第51章"},"example":{"text":"王朔《千万别把我当人》：“我是‘全总’负责人，～自然应该是我。”"},"usage":"作宾语、定语；用于比喻句"},{"id":8140,"word":"出夷入险","pinyin":"chū yí rù xiǎn","abbr":"cyrx","explanation":"出入于安危之中。","source":{"text":"由此更践内外，出夷入险，择而守中，劳而有成，干方举德，而莫有助之者也。","book":"宋·叶適《故运副龙图侍郎孟公墓志铭》"},"usage":"作谓语、定语；用于书面语"},{"id":8141,"word":"出奇不穷","pinyin":"chū qí bù qióng","abbr":"cqbq","explanation":"指多出奇兵，多用奇计。比喻变化多端，使人难以捉摸。","source":{"text":"指多出奇兵，多用奇计。比喻变化多端，使人难以捉摸。"},"similar":["出奇无穷"],"usage":"作谓语、定语；用于人或事物等"},{"id":8142,"word":"出奇划策","pinyin":"chū qí huá cè","abbr":"cqhc","explanation":"犹言出谋划策。","source":{"text":"他就经常替他们出奇划策，为着种种吃人害人的事情准备堂皇的理由。","book":"沙汀《淘金记》十二"},"similar":["出谋划策"],"usage":"作谓语；指为人想办法，出主意"},{"id":8143,"word":"出奇制胜","pinyin":"chū qí zhì shèng","abbr":"cqzs","explanation":"出奇兵战胜敌人。比喻用对方意料不到的方法取得胜利。","source":{"text":"[刘仁甫]在嵩山少林寺学拳棒。学了些时，觉得徒有虚名，无甚出奇致胜处，于是奔走江湖，将近十年。","book":"《老残游记》第七回"},"example":{"text":"孙犁《秀露集·进修二题》：“文学语言，包括好的比喻，有力的生发，美妙的联想和～的描写。”"},"similar":["六出奇计","出奇致胜"],"opposite":["按兵不动"],"usage":"作谓语、宾语、定语；用于军事或其他","story":["战国时期，齐国的田单在燕国乐毅将军攻齐时，运用计谋成功逃到即墨城，被即墨城推举为守城长官。燕国还在继续侵占齐国的土地，田单利用反间计，离间燕惠王与乐毅的感情，用燕兵割齐兵的鼻子激起齐兵的士气收复齐国的失地"]},{"id":8144,"word":"出奇取胜","pinyin":"chū qí qǔ shèng","abbr":"cqqs","explanation":"出奇兵战胜敌人。比喻用对方意料不到的方法取得胜利。","source":{"text":"今用兵岁久，生民疲弊，苟非出奇取胜，大功何由可成！","book":"《资治通鉴·后唐庄宗同光元年》"},"similar":["出奇制胜","出奇致胜"],"usage":"作谓语、宾语、定语；用于军事或其他"},{"id":8145,"word":"出奇无穷","pinyin":"chū qí wú qióng","abbr":"cqwq","explanation":"指多出奇兵，多用奇计。比喻变化多端，使人难以捉摸。","source":{"text":"兵以正合，以奇胜。善之者，出奇无穷。","book":"《史记·田单列传论》"},"example":{"text":"臣闻兵家之所以取胜者，非特将良而士卒劲也，必有精深敏悟之士，料敌合变，～者为之谋主焉。","book":"宋·秦观《谋主》"},"similar":["出奇不穷"],"usage":"作谓语、定语；用于人或事物等"},{"id":8146,"word":"出奇用诈","pinyin":"chū qí yòng zhà","abbr":"cqyz","explanation":"奇：出人意外；诈：欺骗。指军事上使用奇兵和设置陷井以奇制敌的办法。","source":{"text":"凡城内器械已备，守御已得，当出奇用诈，以战代守，以击解围。","book":"明·唐顺之《纂辑武编·守》"}},{"id":8147,"word":"出奇致胜","pinyin":"chū qí zhì shèng","abbr":"cqzs","explanation":"奇：奇兵，计。用奇兵计战胜对方。比喻用对方意料不到的方法、手段来取得胜利","source":{"text":"学了些时，觉得徒有虚名，无甚出奇致胜处，于是奔走江湖，将近十年。","book":"清·刘鹗《老残游记》第七回"},"similar":["出奇制胜","出奇取胜"],"usage":"作谓语、宾语、定语；用于军事或其他"},{"id":8148,"word":"出奴入主","pinyin":"chū nú rù zhǔ","abbr":"cnrz","explanation":"指挟门户成见。","source":{"text":"其言道德仁义者，不入於杨，则入於墨，不入於老，则入於佛；入於彼，必出於此，入者主之，出者奴之。","book":"唐·韩愈《原道》"},"example":{"text":"乐府至有明而丛杂，～，三百年来，迄无定论。","book":"清·冯班《钝吟杂录》"},"usage":"作宾语、定语；用于人的观点"},{"id":8149,"word":"出家弃俗","pinyin":"chū jiā qì sú","abbr":"cjqs","explanation":"弃：放弃；俗：尘俗。弃舍俗家去做僧尼或道士。","source":{"text":"我已出家弃俗，家中之事，公主自为主之，我何苦又去管他？","book":"清·褚人获《隋唐演义》第62回"},"similar":["弃俗出家"],"usage":"作谓语、定语、宾语；用于处世"},{"id":8150,"word":"出将入相","pinyin":"chū jiàng rù xiàng","abbr":"cjrx","explanation":"出征可为将帅，入朝可为丞相。指兼有文武才能的人，也指文武职位都很高。","source":{"text":"两朝出将复入相，五世迭鼓乘朱轮。","book":"唐·崔颢《江畔老人愁》诗"},"example":{"text":"当下姑娘脸上的那番得意，漫说～，八座三台，大约立刻叫她出将入相，升成佛天，她也不换。","book":"清·文康《儿女英雄传》第七回"},"similar":["文武双全"],"opposite":["不文不武"],"usage":"作谓语、定语；指文武双全，官居高位","story":["唐朝时期，书生卢生遇到吕道翁，两人聊得很投机，卢生叹息自己不得志，只不过是苟且偷生，他认为读书人活在世上应当建功树名，出将入相，使子孙荣华富贵。吕道翁送他一个枕头，他做了一个梦，在梦中享尽了荣华富贵"]},{"id":8151,"word":"出尔反尔","pinyin":"chū ěr fǎn ěr","abbr":"cefe","explanation":"尔：你；反：通“返”，回。原意是你怎样做，就会得到怎样的后果。现指人的言行反复无常，前后自相矛盾。","source":{"text":"出乎尔者，反乎尔者也。","book":"《孟子·梁惠王下》"},"example":{"text":"倘若不肯，也只好由他，我们不能做～的事。","book":"清·李宝嘉《官场现形记》第五十九回"},"similar":["反复无常","翻云覆雨"],"opposite":["说一不二","言行一致","一言为定"],"usage":"作谓语、定语、状语；用于责备反复无常","story":["战国时期，邹国与鲁国发生一场战争，邹国失败，战死了不少官吏，邹穆公为此请教孟子，孟子告诉他“曾子说过：‘你怎样对待别人，将来别人会怎样回报你。’”邹穆公回想当年邹国闹灾荒的情形就明白其中的道理，就在全国推行仁政"]},{"id":8152,"word":"出尘不染","pinyin":"chū chén bù rǎn","abbr":"ccbr","explanation":"比喻身处污浊的环境而能保持纯洁的节操。","source":{"text":"予独爱莲之出淤泥而不染，濯清莲而不妖。","book":"宋·周敦颐《周濂溪集·爱莲说》"},"example":{"text":"秋影主人，中年却扫，炉熏茗盌，拥髻微吟，花社灵光，出尘不染。","book":"清·陈裴之《香畹楼忆记》第十五节"},"similar":["出污泥而不染"],"usage":"作谓语、定语；用于人的节操等"},{"id":8153,"word":"出尘之姿","pinyin":"chū chén zhī zī","abbr":"cczz","explanation":"超出尘俗的姿态。比喻丰姿清奇潇洒。","source":{"text":"尝见《看云图》，画一高僧，抱膝而坐石岸，昂首伫目，萧然有出尘之姿，使人敬仰不暇。","book":"宋·邓椿《画继·五·贺源》"}},{"id":8154,"word":"出尘之想","pinyin":"chū chén zhī xiǎng","abbr":"cczx","explanation":"尘：世俗。超出世俗之外的思想境界。也形容诗文字画的意境、风格不同流俗。","source":{"text":"夫以耿介拔俗之标，萧洒出尘之想，度白雪以言絜，干青云而直上，吾方知之矣。","book":"南齐·孔稚珪《北山移文》"},"example":{"text":"王子京使君遂，蜀人，不以画名，偶然落笑，便有～。","book":"清·周亮工《读画录·二·王子京》"}},{"id":8155,"word":"出尘之表","pinyin":"chū chén zhī biǎo","abbr":"cczb","explanation":"超出尘俗的仪表。比喻丰姿清奇潇洒。","source":{"text":"生得丰姿潇洒，气宇轩昂，飘飘有出尘之表。","book":"明·冯梦龙《醒世恒言》卷二十九"}},{"id":8156,"word":"出山小草","pinyin":"chū shān xiǎo cǎo","abbr":"csxc","explanation":"出山：从山里出来；小草：植物。比喻隐士出来做官。","source":{"text":"此甚易解，处则为远志，出则为小草。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"他只不过是～罢了。"},"similar":["东山再起"],"usage":"作宾语、定语；用于自谦","story":["东晋时期，谢安从隐居的东山出来在司马桓温那里做小官，一个人送草药给桓温。桓温拿出远志草问谢安为什么它有两个名字。谢安一时没有回答。参军郝隆说该药在山里叫“远志”，出山就是“小草”，谢安听了，十分惭愧"]},{"id":8157,"word":"出山泉水","pinyin":"chū shān quán shuǐ","abbr":"csqs","explanation":"出山：比喻出仕。旧指做了官的人，就不象未做官时那样清白了。","source":{"text":"在山泉水清，出山泉水浊。","book":"唐·杜甫《佳人》诗"},"example":{"text":"他已不像～般清澈了。"},"usage":"作宾语；指不再纯洁"},{"id":8158,"word":"出山济世","pinyin":"chū shān jì shì","abbr":"csjs","explanation":"济世：做有益于人间的事。原指隐士出来参与政事。后泛指有才能的人出来工作。"},{"id":8159,"word":"出师不利","pinyin":"chū shī bù lì","abbr":"csbl","explanation":"师：军队。利：顺利。出战不顺利。形容事情刚开始，就遭受败绩。","source":{"text":"‘出师不利出师不利。’马青探头探脑往前后胡同口张望，见确实没有作家追杀而来，这才放下心，对于观说，‘谁想到今儿作家全出街了。’","book":"王朔《顽主》续篇二"},"example":{"text":"这真是～。"},"opposite":["旗开得胜"],"usage":"作谓语、宾语、状语；指不顺"},{"id":8160,"word":"出师无名","pinyin":"chū shī wú míng","abbr":"cswm","explanation":"指没有正当理由而出兵征伐。","source":{"text":"莫离支杀君，虐用其下如檴阱，怨痛溢道，我出师无名哉？","book":"《新唐书·东夷传·高丽》"},"similar":["师出无名"],"opposite":["出师有名"],"usage":"作宾语、谓语；用于军事或处事等"},{"id":8161,"word":"出师有名","pinyin":"chū shī yǒu míng","abbr":"csym","explanation":"有正当理由进行征伐。","source":{"text":"赵若献璧，乃惧怕我邦，不难臣服；若是不献，再去征讨，方算出师有名。","book":"京剧《将相和》第一场"},"similar":["师出有名"],"opposite":["出师无名"],"usage":"作宾语、谓语；用于军事或处事等"},{"id":8162,"word":"出幽升高","pinyin":"chū yōu shēng gāo","abbr":"cysg","explanation":"犹言出谷迁乔。比喻人的境遇好转或职位升迁。","source":{"text":"出于幽谷，升于乔木。","book":"《后汉书·儒林传上·杨伦》：“帝乃下诏曰：‘伦出幽升高，宠以藩傅，稽留王命，擅止道路，托疾自从，苟肆狷志。’”李贤注引《诗》"},"similar":["出幽迁乔"],"usage":"作谓语、宾语；用于祝贺"},{"id":8163,"word":"出幽迁乔","pinyin":"chū yōu qiān qiáo","abbr":"cyqq","explanation":"比喻人的境遇好转或职位升迁。","source":{"text":"出自幽谷，迁于乔木。","book":"语出《诗·小雅·伐木》"},"example":{"text":"光光段生，～。资忠履信，武烈文昭。","book":"晋·刘琨《答卢谌诗》之八"},"similar":["出幽升高","出谷迁乔"],"usage":"作谓语、宾语；用于祝贺"},{"id":8164,"word":"出手得卢","pinyin":"chū shǒu dé lú","abbr":"csdl","explanation":"卢：古时樗蒲戏一掷五子皆黑，为最胜采。比喻一下子就取得胜利。","source":{"text":"献捷，太祖以告领军张冲，冲曰：‘瓌以百口一掷，出手得卢矣。’","book":"《南齐书·张瓌传》"},"example":{"text":"我们～，旗开得胜。"},"similar":["旗开得胜"],"opposite":["出师不利"],"usage":"作谓语、定语；比喻事情进展很顺利"},{"id":8165,"word":"出敌不意","pinyin":"chū dí bù yì","abbr":"cdby","explanation":"指行动出于敌方意料。","source":{"text":"不如让我去，出敌不意，拦腰插一拳，也许能够把敌阵冲乱。","book":"姚雪垠《李自成》第一卷第八章"},"example":{"text":"我们要～、出奇制胜。"},"similar":["出其不意","出敌意外"],"opposite":["意料之中"],"usage":"作谓语、定语；指出乎预料"},{"id":8166,"word":"出敌意外","pinyin":"chū dí yì wài","abbr":"cdyw","explanation":"指行动出于敌方意料之外。","source":{"text":"此种计划出敌意外，在你们最后完成部署以前，敌人是很难觉察出来的。","book":"毛泽东《关于平津战役的作战方针》"},"similar":["出人意外","出敌不意"],"usage":"作谓语、定语；用于意外的事"},{"id":8167,"word":"出文入武","pinyin":"chū wén rù wǔ","abbr":"cwrw","explanation":"指文武兼备。","source":{"text":"好著櫜鞬莫惆怅，出文入武是全才。","book":"唐·刘禹锡《寄毗陵杨给事》诗之一"},"similar":["文武兼备"],"usage":"作谓语、主语、宾语；同“文武兼备”"},{"id":8168,"word":"出有入无","pinyin":"chū yǒu rù wú","abbr":"cyrw","explanation":"出入于有无之中。","source":{"text":"或与众仙，策空驾虚，出有入无，分形散影，处处游集。","book":"《云笈七签》卷一○四"},"usage":"作谓语、宾语；指进出自如"},{"id":8169,"word":"出林乳虎","pinyin":"chū lín rǔ hǔ","abbr":"clrh","explanation":"乳虎：尚在吃奶的小虎。走出树林的小老虎。比喻勇猛的小将。","source":{"text":"兀术哪里敌得住这三个出林乳虎，直杀得两肩酸麻，浑身流汗。","book":"清·钱彩《说岳全传》"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":8170,"word":"出榜安民","pinyin":"chū bǎng ān mín","abbr":"cbam","explanation":"榜：旧指官府的告示。贴出告示，安抚人民。","source":{"text":"请后主还宫，出榜安民，交割仓库。","book":"明·罗贯中《三国演义》第一百一十八回"},"example":{"text":"胡林翼大虑，只得～：居民一概免罪。","book":"清·黄小配《洪秀全演义》第三十二回"},"usage":"作谓语、定语；用于政府行为"},{"id":8171,"word":"出死入生","pinyin":"chū sǐ rù shēng","abbr":"csrs","explanation":"①从死亡里获救。②犹出生入死。","source":{"text":"夫如是大雄之力，出死入生；至诚之神，感天动地。","book":"唐·黄滔《大唐福州报恩定光多宝塔碑记》"},"example":{"text":"我们该追随丞相～，为国尽力。","book":"郑振铎《桂公塘》"},"similar":["出生入死"],"usage":"作谓语、定语；同“出生入死”"},{"id":8172,"word":"出死断亡","pinyin":"chū sǐ duàn wáng","abbr":"csdw","explanation":"指效死捐生。","source":{"text":"故仁人在上，百姓贵之如帝，亲之如父母，为之出死断亡而愉者，无它故焉；其所是焉诚美，其所得焉诚大，其所利焉诚多。","book":"《荀子·富国》"},"usage":"作谓语、定语；指为效死献身"},{"id":8173,"word":"出气筒","pinyin":"chū qì tǒng","abbr":"cqt","explanation":"指没有恰当的由头而被人当作发泄怨恨的对象。","source":{"text":"甚至在他苦闷至极，无端地向她发火的时候，她也心甘情愿当他的出气筒。","book":"路遥《平凡的世界》第五卷第24章"},"example":{"text":"我又不是你的～。","book":"王朔《过把瘾就死》"},"similar":["受气包"],"usage":"作宾语、定语；用于口语"},{"id":8174,"word":"出水芙蓉","pinyin":"chū shuǐ fú róng","abbr":"csfr","explanation":"芙蓉：荷花。刚开放的荷花。比喻诗文清新不俗。也形容天然艳丽的女子。","source":{"text":"谢诗如芙蓉出水，颜如错彩镂金。","book":"南朝·梁·钟嵘《诗品》卷中"},"example":{"text":"马娇字婉容，姿首清丽，濯濯如春月柳，滟滟如～，真不愧娇之一字也。","book":"清·余怀《板桥杂记·马娇》"},"similar":["花容月貌"],"opposite":["残花败柳"],"usage":"作宾语、定语；形容年轻女子","story":["我国文学史上著名的诗人谢灵运开创了山水诗的新局面，是山水诗的鼻祖，他描绘出山水质朴的自然美，给人以清新可爱的感受，他酷爱自然，纵情山水，把自然景物写活。文学批评家钟嵘评价谢灵运的诗像出水芙蓉一样纯朴清新"]},{"id":8175,"word":"出污泥而不染","pinyin":"chū wū ní ér bù rǎn","abbr":"cwnebr","explanation":"比喻生于污浊的环境却不受污染，依然保持纯洁的品格。","source":{"text":"予独爱莲之出淤泥而不染，濯清涟而不妖。","book":"宋·周敦颐《爱莲说》"},"example":{"text":"你看它～，光明磊落，象征了一种崇高的品德。","book":"陶斯亮《一封终于发出的信》"},"similar":["出淤泥而不染"],"opposite":["同流合污"],"usage":"作谓语、定语；指人的品格","story":["北宋时期，理学开创者周敦颐定居到庐山莲花峰下的濂溪边著书立说，他著有《太极图说》和《通书》，提出简单而有系统的宇宙构成论。他认为菊花像人间的隐士，牡丹像人间的富贵人，出淤泥而不染的莲花像人间的君子"]},{"id":8176,"word":"出没不常","pinyin":"chū mò bù cháng","abbr":"cmbc","explanation":"出现隐没都无规律，捉摸不定。","source":{"text":"盖此贼非陆地群盗之比，据重湖环千里，出没不常。","book":"宋·李纲《与宰相论捍贼札子》"},"example":{"text":"湖故有寇，～。","book":"清·戴名世《诰封光禄大夫张公墓志铭》"},"similar":["出没无常"],"usage":"作谓语、定语；用于神秘的人或事物"},{"id":8177,"word":"出没无常","pinyin":"chū mò wú cháng","abbr":"cmwc","explanation":"忽而出现，忽而隐没，没有一定，使人无法捉摸。","source":{"text":"海寇出没无常，尤为濒海州县之患。","book":"宋·王十朋《论广海二寇札子》"},"example":{"text":"又西北平行者一里，下眺岭西深坠而下，而杳不可见；岭东屏峙而上，而～。","book":"明·徐宏祖《徐霞客游记·滇游日记》"},"similar":["变化无常","变化多端"],"opposite":["循规蹈矩"],"usage":"作谓语、定语；用于神秘的人或事物"},{"id":8178,"word":"出没无际","pinyin":"chū mò wú jì","abbr":"cmwj","explanation":"没：隐没；际：时候。出现和隐藏都没有一定的时候。","source":{"text":"若真伪遁瀛涨，出没无际。","book":"宋·袁淑《防御索虏议》"}},{"id":8179,"word":"出洋相","pinyin":"chū yáng xiàng","abbr":"cyx","explanation":"露出令人作笑的丑相;略带幽默的失态。","source":{"text":"露出令人作笑的丑相;略带幽默的失态。"},"similar":["当众出丑"],"usage":"作谓语、宾语、定语；用于口语"},{"id":8180,"word":"出浅入深","pinyin":"chū qiǎn rù shēn","abbr":"cqrs","explanation":"犹言深入浅出。","source":{"text":"军长报告遂临时改题为《整风问题》……出浅入深，依具体事实，详加诠释。","book":"阿英《敌后日记·摘抄停翅小撷》"},"similar":["深入浅出"],"usage":"作谓语、状语；用于处事等"},{"id":8181,"word":"出淤泥而不染","pinyin":"chū yū ní ér bù rǎn","abbr":"cynebr","explanation":"淤泥：水底的污泥；染：沾。生长在淤泥中，而不被污泥所污染。","source":{"text":"予独爱莲之出淤泥而不染，濯清涟而不妖。","book":"宋·周敦颐《爱莲说》"},"example":{"text":"我就是喜欢荷花～的精神。"},"similar":["洁身自好","出污泥而不染"],"opposite":["同流合污"],"usage":"作定语、宾语、分句；指处于污浊环境保持纯","story":["北宋时期，理学开创者周敦颐定居到庐山莲花峰下的濂溪边著书立说，他著有《太极图说》和《通书》，提出简单而有系统的宇宙构成论。他认为菊花像人间的隐士，牡丹像人间的富贵人，出淤泥而不染的莲花像人间的君子"]},{"id":8182,"word":"出生入死","pinyin":"chū shēng rù sǐ","abbr":"csrs","explanation":"原意是从出生到死去。后形容冒着生命危险，不顾个人安危。","source":{"text":"出生入死，生之徒十有三，死之徒十有三。","book":"《老子》第五十章"},"example":{"text":"这一层，不烦圣虑，他们是～的老兄弟，何况国家如此，不至于还闹义气。","book":"高阳《清宫外史》上册"},"similar":["赴汤蹈火","舍生忘死"],"opposite":["贪生怕死"],"usage":"作谓语、定语、状语；用于赞扬人英勇","story":["春秋时期，哲学家老子认为人出现世上就是生，进入坟墓就是死。人有七情六欲这13项，可以养生，也可以致死，将出生入死归并为这13项。他反对统治者放纵自己的七情六欲，那样就会走向死亡，所以他主张要保护身体，避免危险，控制七情六欲"]},{"id":8183,"word":"出疆载质","pinyin":"chū jiāng zài zhì","abbr":"cjzz","explanation":"疆：边界；质：古代初次见面的礼物。带头见面礼到国外去。后指出卖民族利益，投靠外国。","source":{"text":"孔子三月无君，则皇皇如也，出疆必载质。","book":"《孟子·滕文公下》"},"usage":"作谓语、定语；用于卖国"},{"id":8184,"word":"出神入化","pinyin":"chū shén rù huà","abbr":"csrh","explanation":"神、化：指神妙的境域。极其高超的境界。形容文学艺术达到极高的成就。","source":{"text":"我不曾出声，他连忙答应。金圣叹：‘真正出神入化之笔’。","book":"元·王实甫《西厢记》第二本第二折"},"example":{"text":"不知道这位老画师是观察了多少的活虾，才能够画虾画得这样～的。","book":"秦牧《虾趣》"},"similar":["炉火纯青"],"opposite":["平淡无奇"],"usage":"作谓语、定语、状语；形容文艺或技艺高超","story":["张君瑞与崔莺莺一见钟情，互相爱慕，强人孙飞虎来围攻普救寺抢莺莺为妻。崔夫人答应将莺莺许给退贼有功之人。张君瑞请故人杜确解了普救寺之围。崔夫人备酒致谢，叫红娘请张君瑞。金圣叹评论王实甫描写张君瑞的心情是出神入化之笔"]},{"id":8185,"word":"出神入定","pinyin":"chū shén rù dìng","abbr":"csrd","explanation":"形容聚精会神。","source":{"text":"杨殿山和刘成旺都对这件事十分注意，一定要大家详细介绍那每一户、每个人的种种缘由，并且出神入定一般默默地听得十分严肃。","book":"康濯《东方红》第十章"},"similar":["聚精会神"],"usage":"作谓语、状语、定语；用于人的状态"},{"id":8186,"word":"出类拔群","pinyin":"chū lèi bá qún","abbr":"clbq","explanation":"出：超过；类：同类；拔：超出。指人的品德才能超出同类之上。","source":{"text":"窃痛友人沛国刘显，韫椟艺文，研精覃奥，聪明特达，出类拔群。","book":"《梁书·刘显传》"},"similar":["出类拔萃","出类超群"],"usage":"作谓语、宾语、定语；用于人或事物"},{"id":8187,"word":"出类拔萃","pinyin":"chū lèi bá cuì","abbr":"clbc","explanation":"拔：超出；类：同类；萃：原为草丛生的样子，引伸为聚集。超出同类之上。多指人的品德才能。","source":{"text":"出于其类，拔乎其萃，自生民以来，未有盛于孔子也。","book":"《孟子·公孙丑上》"},"example":{"text":"而在那海一样的人民当中，到处都有～的劳动英雄，这些英雄本身就是人民当中开出的鲜艳花朵。","book":"杨朔《迎春词》"},"similar":["鹤立鸡群","超群绝伦"],"opposite":["滥竽充数","碌碌无能"],"usage":"作谓语、宾语、定语；用于人或事物","story":["公孙丑向老师孟子请教孔子与伯夷、伊尹的人格问题，孟子告诉他。孔子足以使天下太平，因为他看到一个国家的礼制就明白它的政治，圣人的能力要大大超出平民的，孔子的道理可以千古流传，德行可以与天地相比"]},{"id":8188,"word":"出类超群","pinyin":"chū lèi chāo qún","abbr":"clcq","explanation":"出：超过；类：同类。指人的品德才能超出同类之上。","source":{"text":"两个夫荣妻贵，一双出类超群。","book":"明·无名氏《误失金环》第四折"},"example":{"text":"清·李汝珍《镜花缘》第16回：“小子素闻天朝为万国之首，乃圣人之邦，人品学问，莫不～。”"},"similar":["出类拔萃","出群拔萃"],"usage":"作谓语、宾语、定语；用于人或事物"},{"id":8189,"word":"出纳之吝","pinyin":"chū nà zhī lìn","abbr":"cnzl","explanation":"舍不得拿出去，出手小气。","source":{"text":"子曰：‘不教而杀谓之虐；不戒视成谓之暴；慢令致期谓之贼；犹之与人也，出内之吝谓之有司。’","book":"《论语·尧白》"},"example":{"text":"河北诸路并系灾伤，内定州一路，虽只是雨水为害，然其实亦及五分以上。只缘有司～，不与尽实检放，秋税内定州只放二分。","book":"宋·苏轼《乞减价粜常平米赈济状》"},"opposite":["大手大脚","挥金如土"],"usage":"作宾语；用于为人处世"},{"id":8190,"word":"出群拔萃","pinyin":"chū qún bá cuì","abbr":"cqbc","explanation":"拔，超出；萃，原为草丛生的样子。指卓越出众，非同一般。","source":{"text":"诚知足下出群拔萃，无谓仆何从而得之也。","book":"唐·韩愈《与崔群书》"},"example":{"text":"但当以理为主，理得而辞顺，文章自然～。","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵八》"},"similar":["出类拔萃","拔萃出类"],"usage":"作谓语、宾语、定语；用于人或事物"},{"id":8191,"word":"出自意外","pinyin":"chū zì yì wài","abbr":"czyw","explanation":"出于意料之外。","source":{"text":"丘之小不能一亩……余怜惜而售之。李深源、元克己时同游，皆大喜，出自意外。","book":"唐·柳宗元《鈷鉧潭西小丘记》"},"similar":["出于意外"],"usage":"作谓语、定语、状语；指出乎人们意料之外"},{"id":8192,"word":"出舆入辇","pinyin":"chū yú rù niǎn","abbr":"cyrn","explanation":"指动必乘车。","source":{"text":"且夫出舆入辇，命曰蹷痿之机。","book":"汉·枚乘《七发》"},"example":{"text":"前代人君虽在宫禁，～。","book":"《宋史·吕大防传》"},"opposite":["安步当车"],"usage":"作谓语、定语；用于生活"},{"id":8193,"word":"出言不逊","pinyin":"chū yán bù xùn","abbr":"cybx","explanation":"逊：谦让，有礼貌。说话粗暴无礼。","source":{"text":"郃快军败，出言不逊。","book":"《三国志·魏书·张郃传》"},"example":{"text":"八岁纵笔成文，本郡举他神童，起送至京。因～，冲突了试官，打落下去。","book":"明·冯梦龙《喻世明言》卷三十一"},"similar":["出口伤人","血口喷人","出言无状"],"opposite":["谦厚有礼","彬彬有礼"],"usage":"作谓语、定语、状语；指说话傲慢无礼","story":["汉献帝建安五年，曹操亲率精兵攻打袁绍的粮仓乌巢，袁绍不听大将张郃的援粮仓守军的建议，采用谋士郭图的取曹大本营的建议，结果兵败，郭图借机诬陷张郃对袁绍出言不逊，造成张郃投奔曹操，助曹统一北方"]},{"id":8194,"word":"出言吐气","pinyin":"chū yán tǔ qì","abbr":"cytq","explanation":"犹言谈吐。指说话。","source":{"text":"[魏公]与国夫人卢氏偶坐于堂，公忽微笑不已，夫人讶而讯之，曰：‘此中有乐人孙子，多出言吐气，甚令人笑。’","book":"南唐·刘崇远《金华子杂编》卷上"},"example":{"text":"王庆听他两个人～，也猜着是黄达了，假意上前来劝，只一枷，望黄达膀上打去。","book":"《水浒传》第一○三回"},"similar":["出言吐词","出言吐语"],"usage":"作谓语、宾语；指人的说话等"},{"id":8195,"word":"出言吐词","pinyin":"chū yán tǔ cí","abbr":"cytc","explanation":"犹言谈吐。指说话。","source":{"text":"无论生为衣冠仕宦，旦为小姐夫人，出言吐词，当有隽雅雍容之度。","book":"清·李渔《闲情偶寄·词曲·词采》"},"similar":["出言吐气"],"usage":"作谓语、宾语；指人的说话等"},{"id":8196,"word":"出言吐语","pinyin":"chū yán tǔ yǔ","abbr":"cyty","explanation":"犹言谈吐。指说话。","source":{"text":"宋信见冷绛雪出言吐语伶牙利齿，先有三分惧怯，不敢多言，只喏喏而已。","book":"《平山冷燕》第六回"},"example":{"text":"清·荻岸山人《平山冷燕》第六回：“宋信见冷绛雪～伶牙利齿，先有三分惧怯，不敢多言，只诺诺而已。”"},"similar":["出言吐气"],"usage":"作谓语、宾语；指人的说话等"},{"id":8197,"word":"出言成章","pinyin":"chū yán chéng zhāng","abbr":"cycz","explanation":"本意是出言便成为规范，后多用以形容文思敏捷。","source":{"text":"彼都人士，狐裘黄黄，其容不改，出言成章。","book":"《诗经·小雅·都人士》"},"example":{"text":"（舜）作事成法，出言成章。","book":"《淮南子·破修务》"},"similar":["出口成章","文思敏捷"],"usage":"作谓语、定语；指文思敏捷"},{"id":8198,"word":"出言无忌","pinyin":"chū yán wú jì","abbr":"cywj","explanation":"出言：说话；忌：忌惮。说话没有忌讳。","source":{"text":"司马貌虽然出言无忌，但此人因才高远蹇，抑郁不平。","book":"明·冯梦龙《喻世明言》第31卷"},"similar":["直言不讳","口无遮拦"],"usage":"作谓语、宾语；用于说话"},{"id":8199,"word":"出言无状","pinyin":"chū yán wú zhuàng","abbr":"cywz","explanation":"说话放肆，没有礼貌。","source":{"text":"这泼猴头，出方无状。","book":"明·吴承恩《西游记》第三十三回"},"example":{"text":"这样满脸胡子的东西，也敢～么？","book":"鲁迅《呐喊·阿Ｑ正传》"},"similar":["出言不逊"],"opposite":["彬彬有礼"],"usage":"作谓语；指说话放肆，没有礼貌"},{"id":8200,"word":"出言有章","pinyin":"chū yán yǒu zhāng","abbr":"cyyz","explanation":"说话有条理。","source":{"text":"彼都人士，狐裘黄黄，其容不改，出言有章。行归于周，万民所望。","book":"《诗经·小雅·都人士之什》"},"example":{"text":"温文俊雅，～，和而不流，婉而有致，要算香畹。","book":"清·陈森《品花宝鉴》第十三回"},"usage":"作谓语、定语；用于说话"},{"id":8201,"word":"出警入跸","pinyin":"chū jǐng rù bì","abbr":"cjrb","explanation":"警：警戒；跸：帝王出行时，开路清道，禁止通行。指旧时帝王外出和回来时，路过的地方严加戒备。","source":{"text":"出称警，入言跸。","book":"《汉书·梁孝王传》"},"example":{"text":"可戴十二旒冠冕，建天子旌旗，～，乘金根车。","book":"明·罗贯中《三国演义》第一百一十九回"}},{"id":8202,"word":"出词吐气","pinyin":"chū cí tǔ qì","abbr":"cctq","explanation":"犹谈吐。","source":{"text":"水丘仙夫，治六经百家说为歌诗，与扬州豪俊交游，头骨硗然，有古丈夫风。其出词吐气，亦往往惊世俗。","book":"宋·苏轼《送水丘秀才序》"},"example":{"text":"高赞又问起家世，钱青一一对答，～，十分温雅。","book":"《醒世恒言·钱秀才错占凤凰俦》"},"similar":["出词吐语"],"usage":"作主语、宾语、定语；用于说话"},{"id":8203,"word":"出语成章","pinyin":"chū yǔ chéng zhāng","abbr":"cycz","explanation":"说出话来就成文章。形容文思敏捷，口才好。","source":{"text":"玄奘精通汉梵文，又深探佛学，译经出语成章，笔人随写，即可披玩。","book":"范文澜《唐代佛教·佛教各宗派》"},"similar":["出口成章","出言成章"],"usage":"作谓语、状语、定语；与“下笔成文”连用"},{"id":8204,"word":"出谋划策","pinyin":"chū móu huà cè","abbr":"cmhc","explanation":"谋：计谋；划：筹划。制定计谋策略。指为人出主意。","source":{"text":"汝依违观望其间，并不见出奇画策，无非因人成事。","book":"明·冯梦龙《东周列国志》"},"example":{"text":"其余的人，连老贺在内，也都～，各有贡献。","book":"孔厥《新儿女英雄续传》第九章"},"similar":["运筹帷幄"],"usage":"作谓语、定语、宾语；指为人想办法，出主意"},{"id":8205,"word":"出谋献策","pinyin":"chū móu xiàn cè","abbr":"cmxc","explanation":"出主意、想对策来帮助解决问题。","example":{"text":"刘备得力于诸葛亮的～，而取得了赤壁之战的胜利。"},"similar":["出谋划策"],"usage":"作谓语；指为人想办法，出主意"},{"id":8206,"word":"出谋画策","pinyin":"chū móu huà cè","abbr":"cmhc","explanation":"谋：谋略。画：筹划。制定计谋策略。常指为人出主意。","source":{"text":"汝依违观望其间，并不见出奇画策，无非因人成事。","book":"明·冯梦龙《东周列国志》第六十九回"}},{"id":8207,"word":"出谷迁乔","pinyin":"chū gǔ qiān qiáo","abbr":"cgqq","explanation":"从幽深的溪谷出来，迁上了高大的乔木。比喻地位上升。","source":{"text":"出自幽谷，迁于乔木。","book":"《诗经·小雅·伐木》"},"example":{"text":"黄鹂休叹青春暮，～旧家句，天意从人还许诉。","book":"宋·王之道《青玉案·有怀轩车山旧隐》词"},"similar":["出幽迁乔"],"usage":"作谓语；形容地位升迁"},{"id":8208,"word":"出豕败御","pinyin":"chū shǐ bài yù","abbr":"csby","explanation":"出：突然出来；御：马车。突然冲出一头野猪使马车翻车。比喻受到意外事故发生使事情失败。","source":{"text":"王子于期齐辔而进之，彘突出于沟中，马惊驾败。","book":"战国·韩·韩非《韩非子·外储说右下》"},"example":{"text":"做事要充分考虑，避免～的事情发生。"},"usage":"作宾语、定语；用于意外事故","story":["战国时期，善于驾车的造父因为没给马带辔筴到了河边而翻车。王子期接受造父的驾车教训，在为赵简子驾车时就取道而行，改走山路。快到山沟时，突然钻出一头野山猪，马受到惊吓，车子立即翻下山崖"]},{"id":8209,"word":"出锋头","pinyin":"chū fēng tóu","abbr":"cft","explanation":"出：显露。表现自己，自鸣得意地显示自己比别人行。","source":{"text":"壮心欲驰步辄跚，试出锋头官已瘝。","book":"宋·沈辽《云巢编》"},"similar":["出风头"],"opposite":["不露锋芒"],"usage":"作宾语、定语；指表现自己"},{"id":8210,"word":"出门合辙","pinyin":"chū mén hé zhé","abbr":"cmhz","explanation":"按同一规格，闭门造车子，用起来自然合辙。比喻才学适合社会需要。","source":{"text":"问：‘如何是闭门造车？’师曰：‘活计一物无。’曰：‘如何是出门合辙？’师曰：‘坐地进长安。’","book":"《景德传灯录·匡悟禅师》"},"example":{"text":"有～之通才，为闭门养高之时贤。","book":"明·李开先《自赞》"},"similar":["出门应辙"],"usage":"作宾语、定语；用于事理等"},{"id":8211,"word":"出门如宾","pinyin":"chū mén rú bīn","abbr":"cmrb","explanation":"出外做事象接待贵宾那样认真谨慎。","source":{"text":"臣闻之：出门如宾，承事如祭，仁之则也。","book":"《左传·僖公三十三年》"},"usage":"作谓语、宾语；用于处事"},{"id":8212,"word":"出门应辙","pinyin":"chū mén yīng zhé","abbr":"cmyz","explanation":"犹出门合辙。比喻才学适合社会需要。","source":{"text":"中国则地大物博，交通未盛。学者每闭门造车，出门应辙，常非有所承而后起者也。故其学界为无数平行线形。","book":"梁启超《中国学术思想变迁之大势》第三章第四节"},"similar":["出门合辙"],"usage":"作宾语、定语；用于事理等"},{"id":8213,"word":"出陈易新","pinyin":"chū chén yì xīn","abbr":"ccyx","explanation":"犹吐故纳新。去掉旧的换成新的。","source":{"text":"仓谷与库银并重，今年有常平捐谷，照地亩劝输谷，各有款项。且每年出陈易新，或粜或贷，俱秋收时还仓。","book":"清·黄六鸿《福惠全书·莅任·查交代》"},"example":{"text":"往者湛恩下南国，俱槽十万防灾凶。～有良法，要今江左无疲癃。","book":"清·沈德潜《旱》诗"},"similar":["吐故纳新"],"usage":"作谓语、定语；同“吐故纳新”"},{"id":8214,"word":"出震继离","pinyin":"chū zhèn jì lí","abbr":"czjl","explanation":"指帝王登基即位。"},{"id":8215,"word":"出风头","pinyin":"chū fēng tóu","abbr":"cft","explanation":"出：显露。表现自己，自鸣得意地显示自己比别人行。","source":{"text":"近来有人以为新诗人的做诗发表，是在出风头。","book":"鲁迅《坟·论睁了眼看》"},"example":{"text":"路遥《平凡的世界》第六卷第45章：“常务副县长马国雄又只爱搞些花花哨哨的～事，也给他撑不上劲。”"},"similar":["出锋头"],"opposite":["不露锋芒"],"usage":"作宾语、定语；指表现自己"},{"id":8216,"word":"出鬼入神","pinyin":"chū guǐ rù shén","abbr":"cgrs","explanation":"指变化多端，不可捉摸。","source":{"text":"松移岫转，左变而右易；风生云起，出鬼而入神。","book":"唐·宋之问《嵩山天门歌》"},"example":{"text":"《蜀道难》、《远别离》等篇，～，惝恍莫测。","book":"明·胡应麟《诗薮古体中》"},"usage":"作谓语、定语；指变化大"},{"id":8217,"word":"击中要害","pinyin":"jī zhòng yào hài","abbr":"jzyh","explanation":"要害：易于致命的部位，引伸为重要部门或问题的关键。正打中致命的部位。","source":{"text":"臣夜入定后为何人所贼伤，中臣要害。","book":"南朝·宋·范晔《后汉书·来歙传》"},"example":{"text":"他被这话～后，垂头丧气。"},"similar":["正中要害"],"opposite":["无的放矢"],"usage":"作谓语、宾语；指打中致命的部位"},{"id":8218,"word":"击其不意","pinyin":"jī qí bù yì","abbr":"jqby","explanation":"在敌人没有预料到的情况下进行攻击。","source":{"text":"出空击虚，避其所守，击其不意。","book":"《孙子·虚实》：“行千里而不劳者，行于无人之地也。”三国·魏·曹操注"},"example":{"text":"是时，世宗新即位，以谓旻幸周有大丧，而天子新立，必不能出兵，宜自将以～。","book":"《新五代史·东汉世家·刘旻》"},"usage":"作谓语、宾语、定语；用于处事等"},{"id":8219,"word":"击其犹犹，陵其与与","pinyin":"jī qí yóu yóu，líng qí yǔ yǔ","abbr":"jqyylqyy","explanation":"犹犹：犹豫不决的样子；与与：进退不定的样子。趁其犹豫不决的时候进行突然袭击。","source":{"text":"击其犹犹，陵其与与，疾雷不及寒暑耳，疾霆不暇掩目。","book":"《淮南子·兵略训》"}},{"id":8220,"word":"击壤而歌","pinyin":"jī rǎng ér gē","abbr":"jreg","explanation":"击壤：古代的一种游戏。打击土堆而唱歌。比喻太平盛世，人人丰衣足食。","source":{"text":"上古之时，未有音乐，鼓腹击壤，乐在其间。","book":"《隋书·儒林传·何妥》"},"example":{"text":"百姓都盼望～的生活。"},"similar":["鼓腹击壤"],"usage":"作谓语、定语；指太平盛世","story":["上古时期，帝尧治国50年，他十分虚心，不敢自信自满，经常穿上平民的服装，亲自到民间察访，了解自己政绩的好坏，在康衢见到一个老人吃饱饭在玩抛石子游戏，并唱道：“日出而作，日入而息；凿井而饮，耕日而食。”"]},{"id":8221,"word":"击壤鼓腹","pinyin":"jī rǎng gǔ fù","abbr":"jrgf","explanation":"击壤：古代的一种投掷游戏；鼓腹：鼓起肚子，意即饱食。形容天下太平，百姓安居乐业。","source":{"text":"夫赫胥氏之时，民居不知所为，行不知所之，含哺而熙，鼓腹而游。","book":"晋·皇甫谧《帝王世纪》：“天下大和，百姓无事，有五十老人，击壤于道。”《庄子·马蹄》"},"example":{"text":"晋·皇甫谧《帝王世纪》：“天下大和，百姓无事，有五十老人，击壤于道。”《庄子·马蹄》：“夫赫胥氏之时，民居不知所为，行不知所之，含哺而熙，鼓腹而游。”"},"similar":["鼓腹击壤"],"usage":"作谓语、定语；指太平盛世"},{"id":8222,"word":"击排冒没","pinyin":"jī pái mào mò","abbr":"jpmm","explanation":"指攻击排斥，轻率而不顾一切。","source":{"text":"秉觚牍，焦思虑，以为论注疏说者百千人矣。攻讦很怒，以辞气相击排冒没者，其为书，处则充栋宇，出则汗牛马。","book":"唐·柳宗元《唐故给事中皇太子侍读陆文通先生墓表》"},"usage":"作谓语、定语；用于为人"},{"id":8223,"word":"击搏挽裂","pinyin":"jī bó wǎn liè","abbr":"jbwl","explanation":"攻打撕裂。形容争斗激烈。","source":{"text":"则有觜铍爪戟劲立直视者，击搏挽裂图膻腥。","book":"唐·陆龟蒙《五歌·水鸟》"},"example":{"text":"上古之时，人物杂处，其间～，人与禽兽争命者，不知更几何年。","book":"勇立《论排外不宜有形迹》"},"usage":"作宾语、定语；用于书面语"},{"id":8224,"word":"击楫中流","pinyin":"jī jí zhōng liú","abbr":"jjzl","explanation":"比喻立志奋发图强。","source":{"text":"中流击楫而誓曰：‘祖逖不能清中原而复济者，有如大江。’","book":"《晋书·祖逖传》"},"example":{"text":"～，着祖生之鞭；下濑横戈，成汉武之志。","book":"《晚清文学丛钞·童子军·草檄》"},"similar":["中流击楫","中流击枻"],"opposite":["萎靡不振"],"usage":"作谓语、定语；比喻立志奋发图强","story":["晋元帝在江南建立东晋，北方及中原的大部分土地被外族所占。祖逖准备率军收复中原，朝廷只给他奋威将军的虚名，祖逖率领他的100多家人渡江北伐，在江中中流击楫，发誓收复中原。后来他果真收复大片失地，但东晋根本无心抗战"]},{"id":8225,"word":"击毂摩肩","pinyin":"jī gǔ mó jiān","abbr":"jgmj","explanation":"形容车马众多。","source":{"text":"临淄之涂，车毂击，人肩摩。","book":"《战国策·齐策一》"},"example":{"text":"故得填郊溢郭，～。","book":"清·俞樾《春在堂随笔》"},"similar":["摩肩击毂"],"usage":"作谓语、定语；用于书面语"},{"id":8226,"word":"击玉敲金","pinyin":"jī yù qiāo jīn","abbr":"jyqj","explanation":"如金玉被撞击而发出的声音。形容言辞铿然有声，正确无误。","source":{"text":"兄弟也，不知师傅所言，句句斩钉截铁，言言击玉敲金。","book":"明·杨慎《洞天玄记》第一折"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":8227,"word":"击电奔星","pinyin":"jī diàn bēn xīng","abbr":"jdbx","explanation":"形容快速。","source":{"text":"天兵有限，不可久停，马乃击电奔星，行至子胥妻舍。拟迎妇归吴国。","book":"《敦煌变文集·伍子胥变文》"},"usage":"作谓语、宾语；用于书面语"},{"id":8228,"word":"击石弹丝","pinyin":"jī rǎng gǔ fù","abbr":"jsts","explanation":"击壤：古代的一种投掷游戏；鼓腹：鼓起肚子，意即饱食。形容天下太平，百姓安居乐业。","source":{"text":"夫赫胥氏之时，民居不知所为，行不知所之，含哺而熙，鼓腹而游。","book":"晋·皇甫谧《帝王世纪》：“天下大和，百姓无事，有五十老人，击壤于道。”《庄子·马蹄》"},"example":{"text":"长使仆辈为匪人耶？其终无以见明，而不得～乐尧、舜之道耶？（唐·柳宗元《与裴埙书》）"},"usage":"作谓语、宾语；用于音乐等"},{"id":8229,"word":"击碎唾壶","pinyin":"jī suì tuò hú","abbr":"jsth","explanation":"唾壶：古代的痰盂。形容对文学作品的高度赞赏。","source":{"text":"以如意打唾壶为节，壶边尽缺。","book":"《晋书·王敦传》"},"example":{"text":"有客虬髯醉咽呜，～小酒唱。","book":"清·魏源《秦淮灯船引》"},"similar":["唾壶击碎"],"usage":"作谓语；形容对文学作品的高度赞赏","story":["晋朝时期，大将军王敦每次喝完酒后总是吟咏曹操的诗句：“老骥伏枥，志在千里。烈士暮年，壮心不已。”一边吟咏一边用如意敲打唾壶，壶口都给敲破了"]},{"id":8230,"word":"击筑悲歌","pinyin":"jī zhù bēi gē","abbr":"jzbg","explanation":"击：敲击；筑：古乐器名。敲击着筑，唱着悲壮的歌。形容慷慨悲歌。","source":{"text":"高渐离击筑，荆轲和而歌。","book":"《战国策·燕策》"},"similar":["悲歌击筑"],"usage":"作谓语、定语；描写悲壮的气氛","story":["公元前227年，秦国打败赵国，迫近燕国。燕国太子丹请勇士荆轲去刺杀秦王。荆轲带上秦王的仇人樊于期的人头及督亢地地图。太子丹把他送到易水河边，高渐离为荆轲奏乐，荆轲怒发冲冠高唱：“风萧萧兮易水寒，壮士一去兮不复还。”"]},{"id":8231,"word":"击缺唾壶","pinyin":"jī quē tuò hú","abbr":"jqth","explanation":"唾壶：古代的痰盂。形容对文学作品的高度赞赏。后也用以形容有志之士的愤慨之情。","source":{"text":"以如意打唾壶，壶口尽缺。","book":"晋·裴启《语林》：“以铁如意击唾壶为节，壶尽缺。”南朝·宋·刘义庆《世说新语·豪爽》"}},{"id":8232,"word":"击节叹赏","pinyin":"jī jié tàn shǎng","abbr":"jjts","explanation":"节：节拍；赏：赞赏。形容对诗文、音乐等的赞赏。","source":{"text":"巴姬弹弦，汉女击节。","book":"晋·左思《蜀都赋》"},"example":{"text":"人常咬得菜根，则百事可做。”故安国康侯闻之，～。 ★宋·吕本中《东莱吕紫微师友杂志》","book":"汪信民尝"},"similar":["击节称赏","击节称叹"],"usage":"作谓语、定语；形容对诗文、音乐等的赞赏"},{"id":8233,"word":"击节称叹","pinyin":"jī jié chēng tàn","abbr":"jjct","explanation":"节：节拍；击节：打拍子；叹：赞叹。指打着拍子欣赏诗文或艺术作品。","source":{"text":"公期望基切，闱后索文读之，击节称叹，不意时数限人，文章憎命，及放榜时，依然铩羽。","book":"清·蒲松龄《聊斋志异·叶生》"},"similar":["击节称赏","击节叹赏"],"usage":"作谓语、定语；形容对诗文、音乐等的赞赏"},{"id":8234,"word":"击节称赏","pinyin":"jī jié chēng shǎng","abbr":"jjcs","explanation":"节：节拍；赏：赞赏。形容对诗文、音乐等的赞赏。","source":{"text":"巴姬弹弦，汉女击节。","book":"晋·左思《蜀都赋》"},"example":{"text":"宋白为时闻人，一见～。","book":"宋·赵佶《宣和画谱·龙鱼·董羽》"},"similar":["击节叹赏","击节称叹"],"usage":"作谓语、定语；指对诗文、音乐等的赞赏"},{"id":8235,"word":"击辕之歌","pinyin":"jī yuán zhī gē","abbr":"jyzg","explanation":"辕：车前驾牲口的长木。敲着车辕时所唱的歌。后指劳动人民自己创作并演唱的歌曲。","source":{"text":"夫街谈巷说，必有可采；击辕之声，有应风雅，匹夫之思未易轻弃也。","book":"三国·魏·曹植《与杨德祖书》"},"usage":"作宾语；用于书面语"},{"id":8236,"word":"击钟陈鼎","pinyin":"jī zhōng chén dǐng","abbr":"jzcd","explanation":"钟：古代乐器；鼎：古代炊器。击钟列鼎而食。形容贵族的豪华排场。","source":{"text":"洒削，薄技也，而郅氏鼎食。马医浅方，张里击钟。","book":"《史记·货殖列传》"},"example":{"text":"～者，喷水爽人口也。","book":"唐·崔尚《唐天台山新桐柏观之颂序》"},"similar":["击钟鼎食"],"usage":"作谓语、定语；用于生活"},{"id":8237,"word":"击钟鼎食","pinyin":"jī zhōng dǐng shí","abbr":"jzds","explanation":"打钟列鼎而食。形容贵族或富人生活奢华。","source":{"text":"宁聚货千亿，击钟鼎食；枕藉芬芳，婉脔美色乎？","book":"汉·张衡《西京赋》：“击钟鼎食，连骑相过。”三国·魏·嵇康《卜疑》"},"similar":["击钟陈鼎"],"usage":"作谓语、定语；用于生活"},{"id":8238,"word":"击钵催诗","pinyin":"jī bō cuī shī","abbr":"jbcs","explanation":"指限时成诗。比喻诗才敏捷。","source":{"text":"七步八叉，具有成例，古人击钵催诗，我要击钵了。","book":"清·文康《儿女英雄传》第37回"},"example":{"text":"我们偶尔也玩～的游戏。"},"usage":"作谓语、定语；指限时成诗","story":["南朝时期，齐竟陵王萧子良常于夜间邀文人学士饮酒赋诗，刻烛限时，规定烛燃一寸，诗成四韵。萧文琰认为这不是难事，就与丘令楷、江洪二人改为击铜钵催诗，要求钵声一止就做成一首诗"]},{"id":8239,"word":"击鞭锤镫","pinyin":"jī biān chuí dèng","abbr":"jbcd","explanation":"指驱马疾行。指急行军。","source":{"text":"破釜焚舟，击鞭锤镫，休怕风寒雪冷。","book":"清·李渔《奈何天·攒羊》"},"usage":"作谓语、定语；用于骑马等"},{"id":8240,"word":"击鼓鸣金","pinyin":"jī gǔ míng jīn","abbr":"jgmj","explanation":"古时两军作战时用鼓和金发号施令，击鼓则进，鸣金则退。","source":{"text":"张辽可使击鼓鸣金，许褚可使牧羊放马。","book":"明·罗贯中《三国演义》第23回"},"example":{"text":"～的做法在现代战争中已经不用了。"},"usage":"作宾语、定语；用于古代军事"},{"id":8241,"word":"函牛之鼎","pinyin":"hán niú zhī dǐng","abbr":"hnzd","explanation":"函：包含，包容。能容纳一头牛的大鼎。形容气势宏大。","source":{"text":"夫函牛之鼎沸，而蝇蚋不敢入。","book":"西汉·刘安《淮南子·诠言训》"},"example":{"text":"其危犹举～，絓纤枯之末。","book":"南朝·宋·范晔《后汉书·刘陶传》"},"usage":"作宾语；用于比喻句"},{"id":8242,"word":"函电交驰","pinyin":"hán diàn jiāo chí","abbr":"hdjc","explanation":"函：信件；电：电报；交：交错。信件和电报来来往往，数量特别多。","source":{"text":"请了英、俄、法、德各国出来，竭力调停，口舌焦敝，函电交驰。","book":"清·曾朴《孽海花》第二十四回"},"usage":"作谓语、宾语；指信件交往"},{"id":8243,"word":"函盖乾坤","pinyin":"hán gài qián kūn","abbr":"hgqk","explanation":"佛教语。原指泯合无间。后指言语诗文契理或一心专志而绝无杂念。","source":{"text":"我有三句语示汝诸人：一句函盖乾坤，一句截断众流，一句随波逐浪。","book":"《五灯会元·云门偃禅师法嗣·德山缘密禅师》"},"example":{"text":"性珠穿透方，信葆光、～，自通神。","book":"元·姬翼《瑶台第一层》词"},"usage":"作谓语、定语；用于比喻句"},{"id":8244,"word":"函盖充周","pinyin":"hán gài chōng zhōu","abbr":"hgcz","explanation":"指包容一切。","source":{"text":"先生于书，无所不读，函盖充周，不见涯涘。","book":"清·戴名世《〈野香亭诗集〉序》"},"similar":["无所不包"],"usage":"作谓语；指包含的东西非常多"},{"id":8245,"word":"函矢相攻","pinyin":"hán shǐ xiāng gōng","abbr":"hsxg","explanation":"指自相矛盾。","source":{"text":"矢人唯恐不伤人，函人唯恐伤人。","book":"先秦·孟轲《孟子·公孙丑上》"},"example":{"text":"今夫儒者～，蜩螗相喧。","book":"唐·刘禹锡《答容州窦中丞书》"},"similar":["自相矛盾"],"usage":"作谓语、宾语；指自相矛盾"},{"id":8246,"word":"凿凿可据","pinyin":"záo záo kě jù","abbr":"zzkj","explanation":"凿凿：确实。确实可作依据。","source":{"text":"龚起潜为余谈之甚晰，皆凿凿可据。","book":"明·徐宏祖《徐霞客游记·滇游日记》"},"example":{"text":"按此器除孙雨人处现存一具，合之富海帆处一具，皆～。","book":"清·梁章钜《浪迹丛谈·官僚雅集杯》"},"similar":["凿凿有据"],"usage":"作谓语、定语；用于书面语"},{"id":8247,"word":"凿凿有据","pinyin":"záo záo yǒu jù","abbr":"zzyj","explanation":"凿凿：确实。有确实的证据。","source":{"text":"龚起潜为余谈之甚晰，皆凿凿可据。","book":"明·徐宏祖《徐霞客游记·滇游日记》"},"example":{"text":"小弟之言，～。","book":"清·孔尚任《桃花扇·辞院》"},"similar":["言之凿凿","凿凿可据"],"usage":"作谓语；指有确实的证据"},{"id":8248,"word":"凿凿言之","pinyin":"záo záo yán zhī","abbr":"zzyz","explanation":"凿凿：确实。形容说得非常确实。","source":{"text":"言之凿凿，确可信据。","book":"清·蒲松龄《聊斋志异·段氏》"},"example":{"text":"入朝之后，或至尊顾问；或因事敷陈；或九卿会议，当尽力～。","book":"高阳《清官册》五"}},{"id":8249,"word":"凿四方眼儿","pinyin":"záo sì fāng yǎn er","abbr":"zsfye","explanation":"形容呆板固执，不会变通。","source":{"text":"这么大人了，要撒尿倒底说呀，怎么憋着不言语呢！还这么凿四方眼儿，一定要使个净桶。","book":"清·文康《儿女英雄传》第九回"},"example":{"text":"这话不必这等～，他纵不曾读过史书，难道连《天雨花》上的左仪贞他也不知道不成？（清·文康《儿女英雄传》第二十八回）"}},{"id":8250,"word":"凿圆枘方","pinyin":"záo yuán ruì fāng","abbr":"zyrf","explanation":"比喻不调协，扞格不入。同“方枘圆凿”。","source":{"text":"圆凿而方枘兮，吾固知其鉏鋙而难入。","book":"语本《楚辞·宋玉·九辩》"},"example":{"text":"比迫于衣食，强勉万一之遇，而寸长尺短各有所施，～卒以不合。","book":"宋·秦观《与苏公先生简》"},"similar":["圆凿方枘"],"usage":"作宾语、定语；用于比喻句"},{"id":8251,"word":"凿坏以遁","pinyin":"záo pī yǐ dùn","abbr":"zpyd","explanation":"指隐居不仕。","source":{"text":"颜阖，鲁君欲相之而不肎，使人以币先焉，凿培而遁之。","book":"《淮南子·齐俗训》"}},{"id":8252,"word":"凿坏而遁","pinyin":"záo pī ér dùn","abbr":"zped","explanation":"坏：没有烧过的砖瓦、陶器等。遁：逃避。谓隐居不仕。","source":{"text":"颜阖，鲁君欲相之而不肎，使人以币先焉，凿培而遁之。","book":"《淮南子·齐俗训》"},"example":{"text":"宫保一定要先生出来做宫，先生却半夜里跑了，一定要出来摇串铃。试问，与那～，洗耳不听的，有何分别呢？","book":"清·刘鹗《老残游记》第六回"}},{"id":8253,"word":"凿坯而遁","pinyin":"záo pī ér dùn","abbr":"zped","explanation":"指隐居不仕。同“凿坏以遁”。","source":{"text":"颜阖，鲁君欲相之而不肯，使人以币先焉，凿培而遁之，为天下显武。","book":"语出《淮南子·齐俗训》"}},{"id":8254,"word":"凿壁借光","pinyin":"záo bì jiè guāng","abbr":"zbjg","explanation":"凿：挖。在墙上凿一小孔，借邻居的灯光读书。形容家贫刻苦读书。","source":{"text":"匡衡字稚圭，勤学而无烛，邻舍有烛而不逮，衡乃穿壁引其光，以书映光而读之。","book":"晋·葛洪《西京杂记》第二卷"},"similar":["凿壁偷光"],"opposite":["不学无术"],"usage":"作谓语、定语、状语；指人勤学","story":["西汉宰相匡衡从小因为家贫，没有条件进学堂，他白天为藏书很多的文不识家干活，晚上没钱买灯油，就只好在土墙上凿一个洞，借隔壁的灯光来读书，甚至到有书的人家去免费帮工换取书本，他刻苦学习终于在汉元帝时期当上太子少傅"]},{"id":8255,"word":"凿壁偷光","pinyin":"záo bì tōu guāng","abbr":"zbtg","explanation":"原指西汉匡衡凿穿墙壁引邻舍之烛光读书。后用来形容家贫而读书刻苦。","source":{"text":"匡衡字稚圭，勤学而无烛，邻舍有烛而不逮。衡乃穿壁引其光，以书映光而读之。","book":"《西京杂记》卷二"},"example":{"text":"一个说要用功，古时候曾有“囊萤照读”“～”的志士。","book":"鲁迅《且介亭杂文·难行和不信》"},"similar":["囊虫映雪","穿壁引光","废寝忘食"],"opposite":["不学无术"],"usage":"作谓语、定语、状语；指人勤学","story":["西汉宰相匡衡从小因为家贫，没有条件进学堂，他白天帮人干活，晚上没钱买灯油，就只好在家里土墙上凿一个洞，借隔壁的灯光来读书，甚至到有书的人家去免费帮工换取书本，他刻苦学习终于在汉元帝时期当上太子少傅"]},{"id":8256,"word":"凿壁悬梁","pinyin":"záo bì xuán liáng","abbr":"zbxl　","explanation":"形容刻苦读书。","source":{"text":"孙敬字文宝，好学，展夕不休。乃至睡眠疲寝，以绳系头，悬屋梁。","book":"晋·葛洪《西京杂记》第二卷：“匡衡字稚圭，勤学而无烛……衡乃穿壁引其光，以书映光而读之。”《汉书》"},"example":{"text":"效先儒入室升堂，淑诸人～。","book":"明·徐霖《绣襦记·正学求君》"},"similar":["凿壁偷光","悬梁刺股"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":8257,"word":"凿枘圆方","pinyin":"záo ruì yuán fāng","abbr":"zryf","explanation":"凿：榫眼；枘：榫头。圆榫眼，方榫头，两下里合不来。比喻格格不入。","source":{"text":"圆凿而方枘兮，吾固知其龃龉而难入。","book":"战国·楚·宋玉《九辩》"},"example":{"text":"比迫于衣食，强勉万一之遇，而寸长尺短各有所施，～卒以不合。","book":"宋·秦观《与苏公先生简》"}},{"id":8258,"word":"凿柱取书","pinyin":"záo zhù qǔ shū","abbr":"zzqs","explanation":"指秉承先人的遗训。","source":{"text":"公体山川之醇气，禀玉石之上灵，凿柱取书，安弦习礼。","book":"王闿运《常公神道碑》"},"usage":"作谓语、定语；用于书面语"},{"id":8259,"word":"凿楹纳书","pinyin":"záo yíng nà shū","abbr":"zyns","explanation":"指藏守书籍以传久远。","source":{"text":"晏子病，将死，凿楹纳书焉。谓其妻曰：‘楹语也，子壮而示之。’","book":"《晏子春秋·杂下三十》"},"usage":"作宾语、定语；用于书面语"},{"id":8260,"word":"凿石索玉","pinyin":"záo shí suǒ yù","abbr":"zssy","explanation":"凿：打孔；索：求。为了找到玉而凿石头。比喻只顾眼前利益而忽视长远利益。","source":{"text":"甫欲凿石索玉，剖蚌求珠，今乃随、和炳然，有如皎日，复何疑哉！","book":"《三国志·镯志·秦宓传》"}},{"id":8261,"word":"凿破浑沌","pinyin":"záo pò hùn dùn","abbr":"zphd","explanation":"浑沌：传说中的中央之帝。指违反自然，致成祸害。也指开通耳目，增长人的知识","source":{"text":"倏与忽谋报浑沌之德，曰：‘人皆有七窍以视听食息，此独无有，尝试凿之。’是凿一窍，七日而浑沌死。","book":"战国·宋·庄周《庄子·应帝王》"},"usage":"作宾语、定语；用于书面语","story":["传说南海之帝为倏，北海之帝为忽，中央之帝为浑沌。倏与忽约好去浑沌之地，浑沌十分友善招待他们。倏与忽计划回报浑沌的好处说：“人皆有七窍以视听食息，此独无有，尝试凿之。”于是帮浑沌凿一孔，七日后浑沌就死了"]},{"id":8262,"word":"凿穴为居","pinyin":"záo xué wéi jū","abbr":"zxwj","explanation":"凿：打孔，挖洞。开凿山洞用作居住的地方。比喻隐士生活","source":{"text":"佟隐于武安山，凿穴为居，采药自业。","book":"南朝·宋·范晔《后汉书·台佟传》"},"usage":"作谓语、定语；用于书面语"},{"id":8263,"word":"凿空之论","pinyin":"záo kōng zhī lùn","abbr":"zkzl","explanation":"凿空：缺乏根据。空泛而没有根据的言论。","source":{"text":"固不可凿空立论，然读书有疑有所见，自不容不立论。","book":"宋·朱熹《朱子语类·学五》卷十一"}},{"id":8264,"word":"凿空取办","pinyin":"záo kōng qǔ bàn","abbr":"zkqb","explanation":"指巧立名目，勒索榨取。","source":{"text":"间有赋人实窄，凿空取办，郡县不相通融，鲜不受督趣。","book":"宋·俞文豹《吹剑录》：“薛寺正季宣谓州县凿空取办，虽有奉法吏，欲宽弛而不得骋。”宋·丘珂《愧郯录·作邑之制》"},"usage":"作谓语、宾语；用于书面语"},{"id":8265,"word":"凿空投隙","pinyin":"záo kōng tóu xì","abbr":"zktx","explanation":"指寻找时机、捏造罪名。","source":{"text":"推劾之吏，以嶮责痛诋为功，凿空投隙，相矜以残。","book":"《新唐书·酷吏传序》"},"usage":"作谓语、定语；用于处事"},{"id":8266,"word":"凿空指鹿","pinyin":"záo kōng zhǐ lù","abbr":"zkzl","explanation":"指凭空有意颠倒黑白，混淆是非。","source":{"text":"赵高欲为乱，恐群臣不听，乃先设验，持鹿献于二世，曰：‘马也。’二世笑曰：‘丞相误邪？谓鹿为马。’问左右，左右或默，或言马以阿顺赵高。","book":"《史记·秦始皇本纪》"},"example":{"text":"上怒下诏，自旬日三贬公至循州长史，～，四海之士盛冤之。","book":"唐·李钰《唐丞相太子少师赠太尉牛公神道碑铭序》"},"similar":["指鹿为马"],"usage":"作谓语、定语；用于处事","story":["秦末宦官赵高在秦始皇病故后假传圣旨命扶苏自杀，立胡亥为太子，他还想篡夺帝位，特地把一匹鹿当马送给秦二世胡亥，胡亥说是鹿，赵高叫胡亥问群臣。群臣有些迫于丞相赵高的势力违心说是鹿，只有部分说是鹿的大臣后被赵高所害"]},{"id":8267,"word":"凿空立论","pinyin":"záo kōng lì lùn","abbr":"zkll","explanation":"凿空：缺乏根据，牵强附会。比喻本来缺乏根据，却挖空心思穿凿附会地作出论断。","source":{"text":"固不可凿空立论，然读书有疑有所见，自不容不立论。","book":"宋·朱熹《朱子全书·学》"},"usage":"作谓语、定语；用于写作等"},{"id":8268,"word":"凿隧入井","pinyin":"záo suì rù jǐng","abbr":"zsrj","explanation":"比喻费力多而收效少。","source":{"text":"凿隧而入井，抱瓮而出灌。","book":"《庄子·天地》"},"usage":"作宾语、定语；指收效甚微"},{"id":8269,"word":"凿饮耕食","pinyin":"záo yǐn gēng shí","abbr":"zygs","explanation":"指百姓乐业，天下太平。","source":{"text":"尧时五十之民击壤于涂，观者曰：‘大哉尧之德也！’击壤者曰：‘吾日出而作，日入而息，凿井而饮，耕田而食，尧何等力！’","book":"汉·王充《论衡·感虚》"},"example":{"text":"臣亦遭逢，生此嘉运，～，自幸唐年。","book":"《南齐书·王融传》"},"usage":"作谓语、定语；指社会局面"},{"id":8270,"word":"凿骨捣髓","pinyin":"záo gǔ dǎo suǐ","abbr":"zgds","explanation":"形容十分刻毒。","source":{"text":"若得那先生凿骨捣髓的臭骂了一场，即刻收拾了书箱去了。","book":"清·西周生《醒世姻缘传》第十六回"},"usage":"作谓语、定语；指人恶毒"},{"id":8271,"word":"凿龟数策","pinyin":"záo guī shǔ cè","abbr":"zgsc","explanation":"凿龟：钻灼龟甲，看灼开的裂纹推测吉凶；数策：数蓍草的茎，从分组计数中判断吉凶。指古人用龟甲蓍草来卜筮吉凶。","source":{"text":"赵又尝凿龟数策而北伐燕，将劫燕以逆秦，兆曰大吉。","book":"《韩非子·饰邪》"},"usage":"作谓语、宾语、定语；指占卜"},{"id":8272,"word":"刀下留人","pinyin":"dāo xià liú rén","abbr":"dxlr","explanation":"为营救将被斩首的人而向主持或执行斩首的人发出的留人一命的紧急呼吁。","source":{"text":"刀下留人！哥哥息怒。","book":"元·李文蔚《燕青捕鱼》"},"example":{"text":"内中有人嚷道：‘～！’","book":"《小五义》第17回"},"similar":["刀下留情","刀上超生"],"opposite":["斩尽杀绝"],"usage":"作谓语、宾语、定语；指救人"},{"id":8273,"word":"刀俎余生","pinyin":"dāo zǔ yú shēng","abbr":"dzys","explanation":"犹虎口余生。","source":{"text":"余刀俎余生，受君恩乃不死，今得以马革裹尸幸矣！","book":"清·昭槤《啸亭杂记录·记辛亥败兵事》"},"similar":["虎口余生"],"usage":"作定语、宾语；比喻逃脱危险的境地"},{"id":8274,"word":"刀光剑影","pinyin":"dāo guāng jiàn yǐng","abbr":"dgjy","explanation":"隐约显现出刀剑的闪光和影子。形容环境充满了凶险的气氛。","source":{"text":"剑光挥夜电，马汗昼夜泥。","book":"南朝·梁·吴筠《战城南四首》"},"example":{"text":"多年阔别，一旦重逢尤其在此～的北中国一隅聚首，使人发生无限的感喟。","book":"范长江《塞上行·从嘉峪关到山海关》"},"similar":["剑拔弩张","杀气腾腾","磨刀霍霍"],"opposite":["风平浪静","歌舞升平","相安无事"],"usage":"作主语、宾语、定语；指血腥冲突"},{"id":8275,"word":"刀光血影","pinyin":"dāo guāng xuè yǐng","abbr":"dgxy","explanation":"形容血腥的杀戮。","source":{"text":"武汉三镇，自北伐以来，在刀光血影之下已经窒息了整整十年。","book":"郭沫若《洪波曲》第五章一"},"example":{"text":"在～面前，他昂然直视。","book":"胡旷《短促而光辉的生命》"},"similar":["刀光剑影"],"usage":"作主语、宾语、定语；指血腥冲突"},{"id":8276,"word":"刀刀见血","pinyin":"dāo dāo jiàn xuè","abbr":"ddjx","explanation":"比喻说话厉害。","source":{"text":"口尖舌利，刀刀见血，把人们的火都拱起来了。","book":"古立高《隆冬》"},"example":{"text":"这样做真是～，直指要害。"},"similar":["切中要害","针针见血"],"usage":"作宾语、定语；比喻说话厉害"},{"id":8277,"word":"刀切豆腐两面光","pinyin":"dāo qiē dòu fu liǎng miàn guāng","abbr":"dqdflmg","explanation":"比喻为人圆滑，两面讨好。","source":{"text":"像那些‘刀切豆腐两面光’……一类的俗谚，——总之，这一切直译起来，外国人不大好懂。","book":"秦牧《艺海拾贝·京剧译名》"}},{"id":8278,"word":"刀头剑首","pinyin":"dāo tóu jiàn shǒu","abbr":"dtjs","explanation":"极喻危险的境遇。","source":{"text":"刀头剑首度冬春，欲杀何当有百身。","book":"清·钱谦益《苕上吴子德舆作丁丑纪闻诗六首盖悲余之逮系而喜其狱之渐解也感而和之》之五"},"similar":["刀山剑林"],"usage":"作宾语、定语；用于处境"},{"id":8279,"word":"刀头活鬼","pinyin":"dāo tóu huó guǐ","abbr":"dthg","explanation":"指任人宰割的人。","source":{"text":"尔本是刀头活鬼难逃，那时节长跪阶前哀告。","book":"清·洪昇《长生殿·权閧》"}},{"id":8280,"word":"刀头燕尾","pinyin":"dāo tóu yàn wěi","abbr":"dtyw","explanation":"比喻笔锋刚劲有力。","source":{"text":"工僵佛道，兼精蕃马，笔锋劲力，名刀头燕尾。","book":"宋·郭若虚《图画见闻志·赵光辅》"},"usage":"作宾语、定语；用于书法等"},{"id":8281,"word":"刀头舔蜜","pinyin":"dāo tóu tiǎn mì","abbr":"dttm","explanation":"舔：用舌头接触东西或取东西。比喻利少害多。也指贪财好色，不顾性命。","source":{"text":"只怕你刀头舔蜜将人害。想多藏他，是祸胎，拼乱挥他，如土块。","book":"清·杨潮观《吟风阁杂剧·穷阮籍醉骂财神》"},"example":{"text":"～的危险可想而知。"},"similar":["虎口拔牙"],"usage":"作宾语、定语；指危险大"},{"id":8282,"word":"刀子嘴豆腐心","pinyin":"dāo zǐ zuǐ dòu fǔ xīn","abbr":"dzzdfx","explanation":"形容人说话尖刻，但心肠很软弱","source":{"text":"我们这些人呐，也都是刀子嘴豆腐心，如果不是身在这个岗位上，感情要服从需要，要考虑到全局的利益，哪会这么人面兽心？","book":"王朔《千万别把我当人》"},"usage":"作宾语、定语；用于为人处事"},{"id":8283,"word":"刀山剑林","pinyin":"dāo shān jiàn lín","abbr":"dsjl","explanation":"比喻险恶的境地。","source":{"text":"慢说是开封府，就是刀山剑林，也是要走走的。","book":"清·石玉昆《三侠五义》第57回"},"example":{"text":"为了得到她的爱，就是～，他也敢去。"},"similar":["刀山火海"],"usage":"作宾语；比喻险恶的境地"},{"id":8284,"word":"刀山剑树","pinyin":"dāo shān jiàn shù","abbr":"dsjs","explanation":"佛教所说的地狱之刑。形容极残酷的刑罚。","source":{"text":"至第三重门，入见镬汤及刀山剑树。","book":"《太平广记》卷三八二《裴则子》引《冥报拾遗》"},"example":{"text":"我本来不大喜欢下地狱，因为不但是满眼只有～，看得太单调，痛苦也怕很难当。","book":"鲁迅《华盖集续编·厦门通信（二）》"},"similar":["刀山火海","龙潭虎穴"],"opposite":["风平浪静"],"usage":"作主语、宾语、定语；比喻极其危险的地方","story":["五代时期，南汉君主刘鋹昏庸无能，把朝政交给宦官龚澄枢处理。龚澄枢为人刁滑，生性残暴。文武百官被他认为是门外汉。官吏们一旦犯错就被强迫爬上刀山剑树或者被赶进兽场与虎象格斗，弄得人们怨声载道，不久就让赵匡胤灭了南汉"]},{"id":8285,"word":"刀山火海","pinyin":"dāo shān huǒ hǎi","abbr":"dshh","explanation":"比喻极其危险和困难的地方。","source":{"text":"我一生已来，或登刀山剑树地狱，或堕火坑……","book":"汉·高安世泽《佛说鬼问目连经》"},"example":{"text":"前面就是～，我也决不退缩。","book":"峻青《黎明的河边》"},"similar":["龙潭虎穴","刀山剑树"],"opposite":["风平浪静"],"usage":"作主语、宾语；表示无所畏惧"},{"id":8286,"word":"刀山血海","pinyin":"dāo shān xuè hǎi","abbr":"dsxh","explanation":"比喻极其危险和艰难的地方。","source":{"text":"有等恶人，受罪如刀山血海，拔舌油锅……诸般罪孽。","book":"明·冯梦龙《喻世明言》第37卷"},"similar":["刀山火海"],"usage":"作主语、宾语；表示无所畏惧"},{"id":8287,"word":"刀折矢尽","pinyin":"dāo zhé shǐ jìn","abbr":"dzsj","explanation":"折：断；矢：箭。刀也断了，箭也用尽了。形容战斗到最后，无力再战了。","source":{"text":"下马大战，至日中，刀折矢尽，虏亦引退。","book":"《后汉书·段颖传》"}},{"id":8288,"word":"刀枪不入","pinyin":"dāo qiāng bù rù","abbr":"dqbr","explanation":"刀杀不进枪刺不死。比喻一个人的思想僵化，批评、鼓励都不起作用。","source":{"text":"五百年来刀枪不入，水火不侵的城墙，毕竟还敌不过西洋的炸药。","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"她有～的本事。"},"usage":"作宾语、定语；指人的思想等"},{"id":8289,"word":"刀枪入库","pinyin":"dāo qiāng rù kù","abbr":"dqrk","explanation":"没有战争，不用武备；和平麻痹，解除武装，不作戒备。","source":{"text":"其时天下太平已久，真个是：马放南山，刀枪入库，五谷丰登，万民乐业。","book":"清·钱彩《说岳全传》"},"example":{"text":"人民群众都希望～。"},"similar":["天下太平","国泰民安","安家立业"],"opposite":["兵荒马乱","狼烟遍地","鸡犬不宁"],"usage":"作谓语、宾语、定语；常与“马放南山”连用"},{"id":8290,"word":"刀枪剑戟","pinyin":"dāo qiāng jiàn jǐ","abbr":"dqjj","explanation":"戟：古代一种兵器，合戈、矛为一体，既能直刺，又能横击。古代用于砍、刺的四种常用兵器。亦用于泛指兵器。","source":{"text":"却教帐中排开七重刽子手，刀枪剑戟，灿若霜雪。","book":"明·罗贯中《三国演义》第八十七回"},"example":{"text":"曾朴《孽海花》第六回：“精的枪，快的炮，黄旗军里夹洋操，～如何当得了！如何当得了！”"},"similar":["枪刀剑戟"],"usage":"作宾语、定语；指兵器"},{"id":8291,"word":"刀笔之吏","pinyin":"dāo bǐ zhī lì","abbr":"dbzl","explanation":"刀笔：古时在竹简上用刀削改字。指代办文书的小吏。","source":{"text":"且广年六十余矣，终不能复对刀笔之吏。","book":"西汉·司马迁《史记·李将军列传》"},"example":{"text":"～，寡识大方。","book":"唐·陈子昂《谏用刑书》"},"similar":["刀笔吏","刀笔老手"],"usage":"作宾语；指文书"},{"id":8292,"word":"刀笔吏","pinyin":"dāo bǐ lì","abbr":"dbl","explanation":"刀笔：古时在竹简上用刀削改字。指代办文书的小吏。","source":{"text":"萧相国何于秦时为刀笔吏，录录未有奇节。","book":"西汉·司马迁《史记·萧相国世家》"},"example":{"text":"废人饮美酒，对名胜，安能作～番故纸乎？","book":"宋·孔平仲《续世说·任诞》"},"similar":["刀笔老手","刀笔之吏"],"usage":"作主语、宾语、定语；指文痞"},{"id":8293,"word":"刀笔老手","pinyin":"dāo bǐ lǎo shǒu","abbr":"dbls","explanation":"刀笔：古人在竹简上写字，错了用刀削去重写。旧指撰写公文或诉状有经验的人。","source":{"text":"你老兄是刀笔老手，所以非请你帮助不可了。","book":"《动摇》"},"example":{"text":"他是小镇有名的～。"},"similar":["刀笔之吏"],"usage":"作主语、宾语、定语；指文痞"},{"id":8294,"word":"刀笔贾竖","pinyin":"dāo bǐ gǔ shù","abbr":"dbjs","explanation":"刀笔：古人在竹简上写字，错了用刀削去重写；贾竖：相当于“小子”。是对刀笔吏的蔑称。","source":{"text":"吏部惟杂职多弊，臣乡吴羽文竭力釐惕，致刀笔贾竖哄然而起，羽文略不为挠。","book":"《明史·汤开远传》"}},{"id":8295,"word":"刀耕火种","pinyin":"dāo gēng huǒ zhòng","abbr":"dghz","explanation":"古时一种耕种方法，把地上的草烧成灰做肥料，就地挖坑下种。","source":{"text":"梁汉之间，刀耕火耨。","book":"《旧唐书·严震传》"},"example":{"text":"随着农业机械化的普及，～的那种原始的农业耕作技术已逐渐消失了。"},"similar":["火耨刀耕","刀耕火耨"],"usage":"作谓语、宾语、定语；指原始农业耕作"},{"id":8296,"word":"刀耕火耘","pinyin":"dāo gēng huǒ yún","abbr":"dghy","explanation":"犹刀耕火种。","source":{"text":"三峡之民，刀耕火耘，与鹿豕杂居。","book":"宋·苏轼《王公仪夔州路转运使程高夔州路判官制》"},"similar":["刀耕火耨","刀耕火种"],"usage":"作定语、宾语；指原始农业"},{"id":8297,"word":"刀耕火耨","pinyin":"dāo gēng huǒ nòu","abbr":"dghn","explanation":"耨：除草。古人播种前先伐去树木烧掉野草，以灰肥田。泛指原始的耕作技术。","source":{"text":"梁汉之间，刀耕火耨。","book":"《旧唐书·严震传》"},"similar":["火耨刀耕","刀耕火种","刀耕火耘"],"usage":"作定语、宾语；指原始农业"},{"id":8298,"word":"刀过竹解","pinyin":"dāo guò zhú jiě","abbr":"dgzj","explanation":"刀一劈下去，竹子立即分开。形容事情顺利解决。","source":{"text":"后来，果然办得水到渠成，刀过竹解。","book":"清·李绿园《歧路灯》第五回"},"similar":["迎刃而解"],"usage":"作宾语、定语、状语；用于处事"},{"id":8299,"word":"刀锯之余","pinyin":"dāo jù zhī yú","abbr":"djzy","explanation":"刀锯：古代刑具，代指刑罚。受刑之余。指阉人。","source":{"text":"宦者曰：‘臣刀锯之余，不敢以二心事君背主，故得罪于君。’","book":"《史记·晋世家》"}},{"id":8300,"word":"刀锯斧钺","pinyin":"dāo jù fǔ yuè","abbr":"djfy","explanation":"古代四种刑具。借指酷刑。","source":{"text":"大刑用甲兵，其次用斧钺，中刑用刀锯，其次用钻凿。","book":"《汉书·刑法志》"},"example":{"text":"翁无烦怒！有新妇在，～，妇自受之，必不令贻害双亲。","book":"清·蒲松龄《聊斋志异·小翠》"},"similar":["刀锯鼎镬"],"usage":"作宾语、定语；指酷刑"},{"id":8301,"word":"刀锯鼎镬","pinyin":"dāo jù dǐng huò","abbr":"djdh","explanation":"刀、锯：古刑具，也指割刑和刖刑；鼎镬：古炊具，也指烹刑。指古代刑具。也泛指各种酷刑。","source":{"text":"丽生自匿监门，待主然后出，犹不免鼎镬。","book":"《汉书·刑法志》：“大刑用甲兵，其次用斧钺，中刑用刀锯，其次用钻凿。”又，《汉书·郦陆朱刘叔孙传赞》"},"example":{"text":"如果臣言虚谬，～，即加臣身。","book":"清·蒲松龄《聊斋志异·续黄梁》"},"similar":["刀锯斧钺"],"usage":"作宾语、定语；指刑具"},{"id":8302,"word":"刁声浪气","pinyin":"diāo shēng làng qì","abbr":"dslq","explanation":"形容说话装腔作势，语调轻浮。","example":{"text":"她习惯用～的语调说话。"},"similar":["撒泼放刁"],"usage":"作谓语、定语；用于说话等"},{"id":8303,"word":"刁天决地","pinyin":"diāo tiān jué dì","abbr":"dtjd","explanation":"形容大吵大闹。","source":{"text":"言不谙典，话不投机。看不得乔所为，歹见识，刁天决地。","book":"《元曲选·误入桃园》"}},{"id":8304,"word":"刁斗森严","pinyin":"diāo dǒu sēn yán","abbr":"ddsy","explanation":"刁斗：古时行军，在晚上敲击以报时或报警的用具。森严：整肃，整饬。防卫严密。形容军队的营地戒备森严。"},{"id":8305,"word":"刁滑奸诈","pinyin":"diāo huá jiān zhà","abbr":"dhjz","explanation":"刁钻、油滑、奸邪、诡诈。极其阴险狡猾。","example":{"text":"我们要严厉打击那些趁机作乱～之徒。"},"usage":"作谓语、定语；用于为人"},{"id":8306,"word":"刁钻促搯","pinyin":"diāo zuàn cù chāo","abbr":"dzct","explanation":"狡猾而好捉弄人。同“刁钻促狭”。"},{"id":8307,"word":"刁钻促狭","pinyin":"diāo zuàn cù xiá","abbr":"dzcx","explanation":"狡猾而好捉弄人。亦作“刁钻促搯”。","example":{"text":"他是一个～的人。"},"usage":"作谓语、定语；用于为人"},{"id":8308,"word":"刁钻刻薄","pinyin":"diāo zuān kè bó","abbr":"dzkb","explanation":"刁钻：狡猾奸诈。形容人狡猾奸诈，待人苛刻薄情。","source":{"text":"一则里头有贵妃照应，二则故旧好亲戚多，三则你家自老太太起至于少爷们，没有一个刁钻刻薄的。","book":"清·曹雪芹《红楼梦》第92回"},"usage":"作谓语、定语、状语；用于人的为人"},{"id":8309,"word":"刁钻古怪","pinyin":"diāo zuān gǔ guài","abbr":"dzgg","explanation":"刁钻：狡诈；古怪：怪僻，不同寻常。形容为人行事狡猾怪僻，和别人不一样。","source":{"text":"你看古人中，那里有那些刁钻古怪的题目和那极险的韵？","book":"清·曹雪芹《红楼梦》第三十七回"},"example":{"text":"弄这～的，教我一个也猜不着，你还只管说闲话。","book":"清·李汝珍《镜花缘》第八十一回"},"similar":["怪里怪气","稀奇古怪"],"opposite":["朴素大方","平易近人"],"usage":"作谓语、定语；指人的性格"},{"id":8310,"word":"刁风弄月","pinyin":"diāo fēng nòng yuè","abbr":"dfny","explanation":"偷情的隐语。","example":{"text":"他们又在～。"},"similar":["偷香窃玉"],"usage":"作宾语、定语；指偷情"},{"id":8311,"word":"刃树剑山","pinyin":"rèn shù jiàn shān","abbr":"rsjs","explanation":"刃：利刃，刀。原是指佛教中的地狱酷刑。后比喻极其艰难危险的地方。","source":{"text":"刃树剑山，焦汤猛火。","book":"《南齐书·高逸传论》"}},{"id":8312,"word":"刃没利存","pinyin":"rèn mò lì cún","abbr":"rmlc","explanation":"刃：刀口；没：隐没，消失；利：刀口锋利处。刀口没有了，它的锋利之处尤在。比喻根本不存在的事。","source":{"text":"神之于质，犹利之于刃，形之于用，犹刃之于利，利之名非刃也，刃之名非利也。然而舍利无刃，舍刃无利，未闻刃没而利存，岂容形亡而神在。","book":"南朝·梁·范缜《神灭论》"}},{"id":8313,"word":"刃迎缕解","pinyin":"rèn yíng lǚ jiě","abbr":"rylj","explanation":"比喻顺利解决。","source":{"text":"刿目怵心，刃迎缕解，钩章棘句，掐擢胃肾。","book":"唐·韩愈《贞曜先生墓志铭》"},"usage":"作谓语、定语；比喻顺利解决"},{"id":8314,"word":"分一杯羹","pinyin":"fēn yī bēi gēng","abbr":"fybg","explanation":"羹：肉汁。分给我一杯肉汁。指分享利益。","source":{"text":"吾翁即若翁，必欲烹而翁，则幸分我一杯羹。","book":"西汉·司马迁《史记·项羽本纪》"},"similar":["分我杯羹"],"usage":"作谓语、宾语；指分享","story":["楚汉相争时期，项羽担心长期对峙下去对他不利，于是抓了刘邦的父亲，扬言刘邦不投降就杀了他父亲炖成肉羹吃，刘邦听说后说我们两人是结拜兄弟，我的父亲也是你的父亲，如果杀了的话就分一杯羹给他。项羽听从项伯的劝告没有动手杀人"]},{"id":8315,"word":"分三别两","pinyin":"fēn sān bié liǎng","abbr":"fsbl","explanation":"详细分说；清楚，明白。同“分星擘两”。","source":{"text":"更使他惭愧的是，他分三别两，谁的是谁的。","book":"老舍《牛天赐传》二十"},"similar":["分星擘两","分星劈两"],"usage":"作谓语、定语；用于人或事等"},{"id":8316,"word":"分丝析缕","pinyin":"fēn sī xī lǚ","abbr":"fsxl","explanation":"比喻明察入微。","source":{"text":"分丝析缕，不以善小而弗旌。","book":"明·徐渭《代江北事平赐金币谢表》"},"usage":"作谓语、状语；用于书面语"},{"id":8317,"word":"分久必合，合久必分","pinyin":"fēn jiǔ bì hé，hé jiǔ bì fēn","abbr":"fjbhhjbf","explanation":"指人或事物变化无常，分合无定。","source":{"text":"话说天下大势，分久必合，合久必分。","book":"《三国演义》第一回"},"example":{"text":"这也是～的天下定理。","book":"《雪岩外传》第十二回"},"usage":"作谓语、宾语、定语；用于局势等"},{"id":8318,"word":"分兵把守","pinyin":"fēn bīng bǎ shǒu","abbr":"fbbs","explanation":"分散兵力，到处防守。","example":{"text":"我们～各个路口。"},"usage":"作谓语、宾语；指处处设防"},{"id":8319,"word":"分内之事","pinyin":"fèn nèi zhī shì","abbr":"fnzs","explanation":"分内：自己，本分。本分之内的事情。指自己应负责任的事情。","source":{"text":"皆子分内之事也。","book":"《圣谕广训·孝训》"},"example":{"text":"这些属于我们～。"},"opposite":["额外负担"],"usage":"作宾语；指应负责任的事情"},{"id":8320,"word":"分别部居","pinyin":"fēn bié bù jū","abbr":"fbbj","explanation":"分别：分辨，区分；部居：按部归类。分类排列。","source":{"text":"罗列诸物名姓字，分别部居不杂厕。","book":"汉·史游《急就篇》卷一"},"similar":["分门别类"],"opposite":["杂乱无章"],"usage":"作谓语；指分门别类"},{"id":8321,"word":"分别门户","pinyin":"fēn bié mén hù","abbr":"fbmh","explanation":"指在学术上根据各自的格调或见解划清派别，各立门户。同“分门别户”。","source":{"text":"其于古人之诗，多能议论长短，分别门户。","book":"清·戴名世《自序》"},"similar":["分门别户"],"usage":"作谓语、状语；指按事物性质分类"},{"id":8322,"word":"分劳赴功","pinyin":"fēn láo fù gōng","abbr":"flfg","explanation":"分担劳苦，尽职建功。","source":{"text":"而一部之中，有二尚书、四侍郎，又加以管部之亲王大学士，则以一部而有七主任官矣。绝无分劳赴功之效，惟有推诿牵掣之能。","book":"清·端方《请改定官制以为立宪预折》"},"usage":"作谓语、定语；用于书面语"},{"id":8323,"word":"分化瓦解","pinyin":"fēn huà wǎ jiě","abbr":"fhwj","explanation":"分化：分裂；瓦解：比喻分解、崩溃。使对方的力量分裂离散。","source":{"text":"则以政策攻心，分化瓦解，迫使他们投降。","book":"秦牧《湘阴热浪记》"},"example":{"text":"我们利用敌人的内部矛盾去～他们。"},"similar":["土崩瓦解","分崩离析"],"opposite":["精诚团结","戮力同心"],"usage":"作谓语、定语；使对方的力量分裂、离散"},{"id":8324,"word":"分厘毫丝","pinyin":"fēn lí háo sī","abbr":"flhs","explanation":"形容极细微。","example":{"text":"公家的利益，分厘毫丝都不能侵犯。"},"usage":"作主语、宾语；指细小的东西"},{"id":8325,"word":"分外之物","pinyin":"fèn wài zhī wù","abbr":"fwzw","explanation":"自己名分之外的事物。指本不属于自己所有的东西，或薪俸外的收入。","source":{"text":"皆有分外之物。","book":"《前言往行录·清白监司》"},"example":{"text":"《前言往行录·清白鉴司》：“皆有～。”"},"similar":["身外之物"],"usage":"作主语、宾语；指额外的东西"},{"id":8326,"word":"分外妖娆","pinyin":"fèn wài yāo ráo","abbr":"fwyr","explanation":"分外：格外；妖娆：妖媚艳丽。形容景色异常艳丽。","source":{"text":"须晴日，看红妆素裹，分外妖娆。","book":"毛泽东《沁园春·雪》词"},"example":{"text":"这里的春色～。"},"usage":"作谓语、定语；形容景色异常娇媚"},{"id":8327,"word":"分守要津","pinyin":"fēn shǒu yào jīn","abbr":"fsyj","explanation":"要：重要；津：渡口。分别把守交通要道。","source":{"text":"以寡击众，务于隘塞，必于暮夜，伏于丛茂，要于险阴；以众击寡，务于广漫，利于旦辰，分守要津，绝彼运道。","book":"明·何良臣《阵纪·战机》"},"usage":"作谓语、定语；用于战争等"},{"id":8328,"word":"分宵达曙","pinyin":"fēn xiāo dá shǔ","abbr":"fxds","explanation":"犹通宵达旦。","source":{"text":"时复与沙门讲论，或分宵达曙，而心力无怠。","book":"《北史·恩幸传徐纥》"},"usage":"作定语、状语；用于书面语"},{"id":8329,"word":"分家析产","pinyin":"fēn jiā xī chǎn","abbr":"fjxc","explanation":"指分家。分割财产，各自过活。同“分烟析产”。","source":{"text":"周善腾想：‘现在社会上因分家析产引起矛盾激化的事例很多，这起纠纷若不及时解决，后果不堪设想。’","book":"《文汇报》1984.9.19"},"similar":["分烟析产"],"usage":"作谓语、宾语、定语；用于家庭内部等"},{"id":8330,"word":"分寸之功","pinyin":"fēn cùn zhī gōng","abbr":"fczg","explanation":"分寸：比喻微小。指微小的功劳。","source":{"text":"苏秦见燕王曰：‘臣，东周之鄙人也，无有分寸之功。’","book":"西汉·司马迁《史记·苏秦列传》"},"example":{"text":"几遣加半之戍，竟无～，是则师不在众又明矣。","book":"唐·陆贽《论两河及淮西利害状》"},"usage":"作主语、宾语；指小功劳"},{"id":8331,"word":"分寸之末","pinyin":"fēn cùn zhī mò","abbr":"fczm","explanation":"比喻微少、细小。","source":{"text":"宁当争分寸之末，竞锥刀之利哉？","book":"南朝·梁·江淹《诣建平王上书》"},"usage":"作宾语；指微小"},{"id":8332,"word":"分居异劈","pinyin":"fēn jū yì pī","abbr":"fjyp","explanation":"居：居住；劈：劈柴。分开居住，分别劈柴。指兄弟分家过日子。"},{"id":8333,"word":"分居异爨","pinyin":"fēn jū yì cuàn","abbr":"fjyc","explanation":"指兄弟分家过日子。","example":{"text":"他们兄弟已经～了。"},"usage":"作谓语；指兄弟分家过日子"},{"id":8334,"word":"分崩离析","pinyin":"fēn bēng lí xī","abbr":"fblx","explanation":"崩：倒塌；析：分开。崩塌解体，四分五裂。形容国家或集团分裂瓦解。","source":{"text":"远人不服而不能来也，邦分崩离析而不能守也。","book":"《论语·季氏》"},"example":{"text":"战争使全国～的局面变成了比较团结的局面。","book":"毛泽东《和英国记者贝特兰的谈话》"},"similar":["土崩瓦解","四分五裂"],"opposite":["坚如磐石","坚不可摧"],"usage":"作谓语、定语；形容国家或集团分裂瓦解","story":["春秋时期，鲁国大夫季康子为巩固自己的统治权力，想攻打附近的颛臾国。季康子的谋臣冉有和子路都是孔子的学生，他们问孔子该如何处理。孔子说：“治理一国不能使百姓安居乐业，国内处于分崩离析的状态，恐怕要祸起萧墙了。”"]},{"id":8335,"word":"分工合作","pinyin":"fēn gōng hé zuò","abbr":"fghz","explanation":"众人各司其责，共同从事工作。","source":{"text":"有些家中人说不定还留在县里，经营一种不必要本钱的职业，分工合作，都不闲散。","book":"沈从文《常德的船》"},"example":{"text":"整个的社会是～，各司所职。"},"usage":"作谓语、宾语；指各司其责"},{"id":8336,"word":"分床同梦","pinyin":"fēn chuáng tóng mèng","abbr":"fctm","explanation":"比喻虽所做之事不同，但打算一样。","source":{"text":"余见今之亡国大夫，大略三等：或龌龊治生，或丐贷诸侯，或法乳济洞。要皆胸中扰扰，不胜富贵利达之想，分床同梦。","book":"清·黄宗羲《宪副郑平子先生七十寿序》"},"opposite":["同床异梦"],"usage":"作谓语、定语、宾语；用于口语"},{"id":8337,"word":"分庭伉礼","pinyin":"fēn tíng kàng lǐ","abbr":"ftkl","explanation":"比喻平起平坐，彼此对等的关系。同“分庭抗礼”。","source":{"text":"万乘之主，千乘之君，见夫子未尝不分庭伉礼。","book":"《庄子·渔父》"},"similar":["分庭抗礼"],"usage":"作谓语、宾语；用于双方"},{"id":8338,"word":"分庭抗礼","pinyin":"fēn tíng kàng lǐ","abbr":"ftkl","explanation":"庭：庭院；抗礼：平等行礼。原指宾主相见，分站在庭的两边，相对行礼。现比喻平起平坐，彼此对等的关系。","source":{"text":"（子贡）所至，国君无不分庭与之抗礼。","book":"《史记·货殖列传》"},"example":{"text":"知县此番便和他～，留着吃了饭，叫他拜做老师。","book":"清·吴敬梓《儒林外史》第十七回"},"similar":["平起平坐","平分秋色"],"opposite":["和衷共济","同心协力","齐心协力"],"usage":"作谓语、宾语；用于双方","story":["春秋时期，孔子与弟子在树林中弹琴，一个白发老翁专心倾听，老翁向子路、子贡打听孔子的情况。老翁说孔子偏行仁爱。孔子十分虚心接受，并恭送老翁，孔子说遇到贤人必须真诚礼遇，不能分庭抗礼，那就失礼了"]},{"id":8339,"word":"分形共气","pinyin":"fēn xíng gòng qì","abbr":"fxgq","explanation":"形容父母与子女的关系十分密切。后亦用于兄弟间。","source":{"text":"友于兄弟，分形共气。","book":"《梁书·武陵王纪传》"},"similar":["分形同气","分形连气"],"usage":"作谓语、定语；用于父母与子女的关系等"},{"id":8340,"word":"分形同气","pinyin":"fēn xíng tóng qì","abbr":"fxtq","explanation":"形容父母与子女的关系十分密切。","source":{"text":"父母之于子也，子之于父母也，一体而两分，同气而异息。","book":"战国·卫·吕不韦《吕氏春秋·精通》"},"example":{"text":"而臣敢陈闻于陛下者，诚与国～，忧患共之者也。","book":"三国·魏·曹植《求自试表》"},"similar":["分形共气","分形连气"],"usage":"作谓语、定语；用于父母与子女的关系等"},{"id":8341,"word":"分形连气","pinyin":"fēn xíng lián qì","abbr":"fxlq","explanation":"形容父母与子女的关系十分密切。后亦用于兄弟间。","source":{"text":"兄弟者，分形连气之人也。","book":"北齐·颜之推《颜氏家训·兄弟》"},"similar":["分形同气","分形共气"],"usage":"作谓语、定语；用于父母与子女的关系等"},{"id":8342,"word":"分心劳神","pinyin":"fēn xīn láo shén","abbr":"fxls","explanation":"劳：费。分散心力和耗费精神。","source":{"text":"展爷在家一天，倒觉的分心劳神。定于次日起身上杭州。","book":"清·石玉昆《三侠五义》第27回"},"usage":"作谓语、宾语；用于做事"},{"id":8343,"word":"分心挂腹","pinyin":"fēn xīn guà fù","abbr":"fxgf","explanation":"形容十分挂念。","source":{"text":"山川险阻，吉凶路塞……分心挂腹，实亦私苦。","book":"《宋书·王僧达传》"},"similar":["牵肠挂肚"],"usage":"作谓语、宾语；用于牵挂"},{"id":8344,"word":"分忧代劳","pinyin":"fēn yōu dài láo","abbr":"fydl","explanation":"分担忧愁，代替操劳。"},{"id":8345,"word":"分情破爱","pinyin":"fēn qíng pò ài","abbr":"fqpa","explanation":"指对原所爱之人不忠，移情于新欢。","source":{"text":"须听，我没奈何分情破爱，谁下得亏心短行。","book":"明·高明《琵琶记·南浦嘱别》"},"similar":["移情别恋"],"usage":"作谓语、宾语；用于男女之间"},{"id":8346,"word":"分我杯羹","pinyin":"fēn wǒ bēi gēng","abbr":"fwbg","explanation":"羹：肉汁。楚、汉相争时，刘邦答项羽的话。比喻从别人那里分享一分利益。","source":{"text":"吾翁即若翁，必欲烹而翁，则幸分我一杯羹。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"咱们情同兄弟，你在此危难面前得～。"},"similar":["分一杯羹"],"usage":"作谓语、状语；比喻从他人那里分享一分利益","story":["楚汉相争时期，项羽担心长期对峙下去对他不利，于是抓了刘邦的父亲，扬言刘邦不投降就杀了他父亲炖成肉羹吃，刘邦听说后说我们两人是结拜兄弟，我的父亲也是你的父亲，如果杀了的话就分一杯羹给他。项羽听从项伯的劝告没有动手杀人"]},{"id":8347,"word":"分房减口","pinyin":"fēn fáng jiǎn kǒu","abbr":"ffjk","explanation":"指旧时荒年，为减轻家庭负担，维持生计，人口多者每使部分外出逃荒。","source":{"text":"如今为这六料不收，上司言语，着俺分房减口。兄弟你守着祖业，俺两口儿到他邦外府，赶熟去来。","book":"元·无名氏《合同文字》楔子"},"similar":["分身减口"],"usage":"作宾语、定语；用于灾荒年"},{"id":8348,"word":"分所应为","pinyin":"fèn suǒ yīng wéi","abbr":"fsyw","explanation":"指本分以内所应该做的事。"},{"id":8349,"word":"分损谤议","pinyin":"fēn sǔn bàng yì","abbr":"fsby","explanation":"分：分担；损：损坏；谤：诽谤。同受别人的非难指责，分担责任。","source":{"text":"楚师方壮，若萃于我，吾师必尽。不如收而去之，分谤生民，不亦可乎？","book":"《左传·宣公十二年》"}},{"id":8350,"word":"分文不值","pinyin":"fēn wén bù zhí","abbr":"fwbz","explanation":"形容毫无价值。","source":{"text":"有人赞叹此事如虎戴角；有人轻毁此事分文不值。","book":"宋·释普济《五灯会元·漳州保福院从展禅师》"},"example":{"text":"这个东西～。"},"similar":["分文不直","毫无价值"],"opposite":["价值连城"],"usage":"作谓语、定语；指没有价值"},{"id":8351,"word":"分文不取","pinyin":"fēn wén bù qǔ","abbr":"fwbq","explanation":"一个钱也不要。比喻不计报酬。","source":{"text":"又且一清如水，分文不取。","book":"明·冯梦龙《醒世恒言·一文钱小隙造奇冤》"},"example":{"text":"有的是荒山地，山价地租，我～。","book":"清·文康《儿女英雄传》第二十一回"},"similar":["分文不受"],"opposite":["按劳取酬","斤斤计较"],"usage":"作谓语、定语；比喻不计报酬"},{"id":8352,"word":"分文不受","pinyin":"fēn wén bù shòu","abbr":"fwbs","explanation":"分：指银子计量的最小单位；文：指制钱的最小单位。一个钱也不接受。比喻不计报酬。","source":{"text":"供了素斋，又具白银一两为谢。三藏分文不受。","book":"明·吴承恩《西游记》第13回"},"similar":["分文不取"],"usage":"作谓语、定语；比喻不计报酬"},{"id":8353,"word":"分文不名","pinyin":"fēn wén bù míng","abbr":"fwbm","explanation":"名：占有。一分钱一个铜板也没有。比喻非常贫困。","example":{"text":"我现在是～。"},"similar":["分文不值"],"usage":"作谓语、定语；指贫穷"},{"id":8354,"word":"分文不少","pinyin":"fēn wén bù shǎo","abbr":"fwbs","explanation":"丝毫没有短少。","example":{"text":"打开失而复得的钱包，～，让我感动万分。"},"similar":["一文不差"],"usage":"作谓语、定语；用于不短少"},{"id":8355,"word":"分文不直","pinyin":"fēn wén bù zhí","abbr":"fwbz","explanation":"直：同“值”。一分钱一文钱也不值。形容没有任何价值。","source":{"text":"有人赞叹此事，如虎带角；有人轻毁此事，一文不值，一等是恁么事，因什么毁赞不是。","book":"宋·释普济《五灯会元》卷十八"},"similar":["分文不值"],"opposite":["价值连城"],"usage":"作谓语、定语；形容没有任何价值"},{"id":8356,"word":"分文未取","pinyin":"fēn wén wèi qǔ","abbr":"fwwq","explanation":"一个钱也不要。比喻不计报酬。同“分文不取”。"},{"id":8357,"word":"分斤拨两","pinyin":"fēn jīn bō liǎng","abbr":"fjbl","explanation":"比喻过分计较。同“分斤掰两”。","source":{"text":"可是俺们那组，都说大家既是合适，才组到一块，不愿意分斤拨两的，显着薄气。","book":"孙犁《村歌》上篇"},"similar":["分斤掰两","分金掰两"],"usage":"作谓语、定语；比喻过分计较"},{"id":8358,"word":"分斤掰两","pinyin":"fēn jīn bāi liǎng","abbr":"fjbl","explanation":"比喻过分计较。","source":{"text":"真真泥腿光棍，专会打算盘、分斤掰两的。","book":"清·曹雪芹《红楼梦》第四十五回"},"example":{"text":"不是我说句～的话咧，舅爷有什么高亲贵友，该请他到华府上去。","book":"清·文康《儿女英雄传》第十五回"},"similar":["斤斤计较","分斤拨两","分金掰两"],"opposite":["宽宏大量"],"usage":"作谓语、定语；比喻过分计较"},{"id":8359,"word":"分斤较两","pinyin":"fēn jīn jiào liǎng","abbr":"fjjl","explanation":"比喻为人小气，过分计较。","source":{"text":"不是我说句分斤较两的话咧，舅爷有什么高亲贵友该请到他华府上去？","book":"清·文康《儿女英雄传》第15回"},"similar":["分斤掰两","斤斤计较"],"usage":"作谓语、定语；比喻过分计较"},{"id":8360,"word":"分星劈两","pinyin":"fēn xīng pī liǎng","abbr":"fxpl","explanation":"指详细分说。","source":{"text":"不要你狂言诈语，花唇巧舌，信口支持；则要你依头缕当，分星劈两，责状招实。","book":"元·孟汉卿《魔合罗》第四折"},"similar":["分星擘两","分三别两"],"usage":"作谓语、定语；用于人或事等"},{"id":8361,"word":"分星拨两","pinyin":"fēn xīng bō liǎng","abbr":"fxbl","explanation":"犹言斤斤计较。","source":{"text":"我两个跟着你们背后接坐碗儿吃也罢，你怎么这般分星拨两的。","book":"明·无名氏《十样锦》第三折"},"similar":["斤斤计较","分星掰两"],"usage":"作谓语、定语；指人仔细"},{"id":8362,"word":"分星掰两","pinyin":"fēn xīng bāi liǎng","abbr":"fxbl","explanation":"一点一滴，详详细细。","source":{"text":"则要你依头缕当，分星掰两，责状招实。","book":"元·孟汉卿《魔合罗》"},"similar":["掰两分星","斤斤计较"],"usage":"作谓语、定语；指人仔细"},{"id":8363,"word":"分星擘两","pinyin":"fēn xīng bò liǎng","abbr":"fxbl","explanation":"详细分说；清楚，明白。","source":{"text":"便分星百（擘）两，道俺不姓慕容。","book":"《刘知远诸宫调·知远走慕家庄沙佗村入舍》"},"example":{"text":"今日个辞却宋公明，我又索行色添凄怆，何须要～。","book":"元·高文秀《大劫牢》头折"},"similar":["分星劈两","分三别两"],"usage":"作谓语、定语；用于人或事等"},{"id":8364,"word":"分朋引类","pinyin":"fēn péng yǐn lèi","abbr":"fpyl","explanation":"分成派别，招引同类。","source":{"text":"鄂张二相国秉政，嗜好不齐，门下士互相推奉，渐至分朋引类，阴为角斗。","book":"清·昭槤《啸亭杂录·不喜朋党》"},"usage":"作谓语、宾语；用于书面语"},{"id":8365,"word":"分朋树党","pinyin":"fēn péng shù dǎng","abbr":"fpsd","explanation":"区分开朋友党羽，树立起帮派。"},{"id":8366,"word":"分期分批","pinyin":"fēn qī fēn pī","abbr":"fqfp","explanation":"分阶段分成组，不同时期一组接一组。","example":{"text":"我们～地把这些东西搬走。"},"usage":"作状语、定语；指分阶段分成组"},{"id":8367,"word":"分条析理","pinyin":"fēn tiáo xī lǐ","abbr":"ftxl","explanation":"形容言谈有条有理，深刻精辟。","source":{"text":"守亮既至，卫公初见，未之敬。及与言论，分条析理，出没幽赜，公凡欲质疑，亮已演其意，公大惊，不觉前席。","book":"宋·王谠《唐语林·文学》"},"usage":"作谓语、定语；用于言谈等"},{"id":8368,"word":"分桃断袖","pinyin":"fēn táo duàn xiù","abbr":"ftdx","explanation":"借指男宠。","source":{"text":"异日，与君游于果园，食桃而甘，不尽，以其半啖君。","book":"《汉书·董贤传》：“常与上卧起。尝昼寝，偏藉上袖，上欲起，贤未觉，不欲动贤，乃断袖而起。”《韩非子·说难》"}},{"id":8369,"word":"分毫不值","pinyin":"fēn háo bù zhí","abbr":"fhbz","explanation":"形容没有任何价值。同“分文不直”。","source":{"text":"人间信佛者多，谤佛者少，惟左丞相不信虚无，专辟佛教，说我等寂灭门中，分毫不值。","book":"《天雨花》第二七回"},"similar":["分文不值"],"usage":"作谓语、定语；指没有价值"},{"id":8370,"word":"分毫不取","pinyin":"fēn háo bù qǔ","abbr":"fhbq","explanation":"一个钱也不要。比喻不计报酬。同“分文不取”。"},{"id":8371,"word":"分毫不差","pinyin":"fēn háo bù chà","abbr":"fhbc","explanation":"分毫：数量单位，十丝为一毫，十毫为一厘，十厘为一分。比喻没有丝毫差错。","source":{"text":"便是心中许多道理，光明鉴照，毫发不差。","book":"宋·朱熹《朱子语类》卷十四"},"example":{"text":"大尹将所报伤处将卷对看，～。","book":"明·冯梦龙《醒世恒言·一文钱小隙造奇冤》"},"similar":["丝毫不差"],"opposite":["天差地别"],"usage":"作谓语、定语；指十分准确"},{"id":8372,"word":"分毫不爽","pinyin":"fēn háo bù shuǎng","abbr":"fhbs","explanation":"分毫：数量单位，十丝为一毫，十毫为一厘，十厘为一分。比喻没有丝毫差错。","source":{"text":"便是心中许多道理，光明鉴照，毫发不差。","book":"宋·朱熹《朱子语类》卷十四"},"example":{"text":"凡客货在船，都是他记账，出入～。","book":"明·冯梦龙《警世通言》卷二十二"},"similar":["丝毫不差","分毫无爽"],"usage":"作谓语、定语、状语；形容没有丝毫差错"},{"id":8373,"word":"分毫无爽","pinyin":"fēn háo wú shuǎng","abbr":"fhws","explanation":"比喻没有丝毫差错。同“分毫不爽”。","source":{"text":"孙富喜甚，即将白银一千两，送到公子船中，十娘亲自检看，足色足数，分毫无爽。","book":"《警世通言·杜十娘怒沉百宝箱》"},"similar":["分毫不爽"],"usage":"作谓语、定语、状语；形容没有丝毫差错"},{"id":8374,"word":"分毫析厘","pinyin":"fēn háo xī lí","abbr":"fhxl","explanation":"毫、厘：都是细小的单位名称；析：剖析。分析一毫一厘。形容分析细微。","source":{"text":"世之作者，或好烦文博採，深沉其旨者；或好离言辨白，分毫析厘者。","book":"南朝·梁·刘勰《文心雕龙·定势》"},"usage":"作谓语、宾语；形容分析细微深入"},{"id":8375,"word":"分浅缘悭","pinyin":"fèn qiǎn yuán qiān","abbr":"fqyq","explanation":"旧时称缘分浅薄。","source":{"text":"张君瑞，想是你分浅缘悭，雨打梨花深闭门。","book":"明·崔时佩《西厢记·回春柬药》"},"similar":["分薄缘悭","分浅缘薄"],"usage":"作谓语、定语；用于人之间"},{"id":8376,"word":"分浅缘薄","pinyin":"fèn qiǎn yuán bó","abbr":"fqyb","explanation":"旧时称缘分浅薄。","source":{"text":"身未到，心先到，分浅缘薄，有上梢没下梢。","book":"元·王子一《误入桃源》第四折"},"similar":["分浅缘悭","分薄缘悭"],"usage":"作谓语、定语；用于人之间"},{"id":8377,"word":"分烟析产","pinyin":"fēn yān xī chǎn","abbr":"fyxc","explanation":"指分家。分割财产，各自过活。","source":{"text":"其分烟析产，典卖割移，官给契，县置簿，皆以今所方之田为正。","book":"《宋史·食贷志上二》"},"example":{"text":"现在社会上因～引起矛盾激化的事例很多，这起纠纷若不及时解决，后果不堪设想。","book":"《文汇报》1984.9.19"},"similar":["分家析产","分烟析生"],"usage":"作谓语、宾语、定语；用于家庭内部等"},{"id":8378,"word":"分烟析生","pinyin":"fēn yān xī shēng","abbr":"fyxs","explanation":"指分家。分割财产，各自过活。同“分烟析产”。","source":{"text":"如本地分内人户分烟析生，即各据户眼定差，或外来人户典买到本社田地，亦许收入差充弓箭社户。","book":"宋·苏轼《乞增修弓箭社条约状》之一"},"similar":["分烟析产","分家析产"],"usage":"作谓语、宾语、定语；用于家庭内部等"},{"id":8379,"word":"分甘共苦","pinyin":"fēn gān gòng kǔ","abbr":"fggk","explanation":"同享幸福，分担艰苦。","source":{"text":"詹与分甘共苦，情若兄弟。","book":"《晋书·应詹传》"},"example":{"text":"对于她的日夜的操心，使我也不能不一同操心，来算作～。","book":"鲁迅《彷徨·伤逝》"},"similar":["同甘共苦","分甘同苦"],"usage":"作谓语、定语；同“同甘共苦”"},{"id":8380,"word":"分甘同苦","pinyin":"fēn gān tóng kǔ","abbr":"fgtk","explanation":"同享幸福，分担艰苦。同“分甘共苦”。","source":{"text":"俨犹申令将士，信赏必罚，分甘同苦，生死以之。","book":"《北齐书·慕容俨传》"},"similar":["分甘共苦","同甘共苦"],"usage":"作谓语、定语；同“同甘共苦”"},{"id":8381,"word":"分甘绝少","pinyin":"fēn gān jué shǎo","abbr":"fgjs","explanation":"绝：拒绝，引伸为不享受；甘：好吃的。好吃的东西让给人家，不多的东西与人共享。形容自己刻苦，待人优厚。","source":{"text":"母之于子也，鞠养殷勤，推燥央湿，绝少分甘。","book":"汉·司马迁《报任少卿书》：“愚以为李陵素与士大夫绝甘分少，能得人之死力，虽古名将不过也。”《孝经援神契》"},"similar":["舍己为人"],"usage":"作谓语、定语；指苦自己，厚待他人"},{"id":8382,"word":"分秒必争","pinyin":"fēn miǎo bì zhēng","abbr":"fmbz","explanation":"一分一秒也一定要争取。形容充分利用一切时间。","source":{"text":"常语人曰：‘大禹圣者，乃惜寸阴，至于众人，当惜分阴。’","book":"《晋书·陶侃传》"},"example":{"text":"我决心以～的速度，争取十二年来已失去的光阴。","book":"陶菊隐《记者生活三十年·序言》"},"similar":["争分夺秒","只争朝夕"],"opposite":["因循坐误","坐失良机"],"usage":"作谓语、定语、状语；指珍惜时间"},{"id":8383,"word":"分章析句","pinyin":"fēn zhāng xī jù","abbr":"fzxj","explanation":"指雕琢推敲文章。","source":{"text":"至拙无能，下愚不肖，分章析句于蓬枢瓮牖之下。","book":"宋·陆游《谢参政启》"},"usage":"作谓语、宾语；用于作文等"},{"id":8384,"word":"分而治之","pinyin":"fēn ér zhì zhī","abbr":"fezz","explanation":"①分别治理。②利用手段使国家、民族或宗教等产生分裂，然后对其进行控制和统治。","source":{"text":"凡邦之有疾病者，疕疡者造焉，则使医分而治之，是亦不自医也。","book":"清·俞樾《群经平议·周官二》“巫马下士二人医四人”"},"example":{"text":"维护国与国之间友爱关系，互利与和平事业，反对民族奴役，反对～的策略。","book":"宋庆龄《人民团结起来是不可战胜的》"},"usage":"作谓语、宾语、定语；指分开管理"},{"id":8385,"word":"分花拂柳","pinyin":"fēn huā fú liǔ","abbr":"fhfl","explanation":"形容女子走路姿态美好。同“分花约柳”。"},{"id":8386,"word":"分花约柳","pinyin":"fēn huā yuē liǔ","abbr":"fhyl","explanation":"形容女子走路姿态美好。亦作“分花拂柳”。"},{"id":8387,"word":"分茅列土","pinyin":"fēn máo liè tǔ","abbr":"fmlt","explanation":"指分封侯位和土地。","source":{"text":"大圣大后，炼石补天，有王母之神器；分茅列土，启弄孙之美色。","book":"唐·张说《延州豆卢使君万泉县主薛氏神道碑》"},"example":{"text":"此次曹锟大封功臣，～，产出了三个大巡阅使来。","book":"仲平《三巡阅发表后的吴佩孚》"},"similar":["分茅赐土","分茅锡土","分茅裂土"],"usage":"作谓语、定语；指分封诸侯"},{"id":8388,"word":"分茅胙土","pinyin":"fēn máo zuò tǔ","abbr":"fmzt","explanation":"指分封侯位和土地。","source":{"text":"数公皆人杰，无不望分茅胙土如姚广孝，岂止富贵终其身而已乎！","book":"明·刘若愚《酌中志·忧危议后纪》"},"similar":["分茅锡土","分茅裂土","分茅赐土"],"usage":"作谓语、定语；指分封诸侯"},{"id":8389,"word":"分茅裂土","pinyin":"fēn máo liè tǔ","abbr":"fmlt","explanation":"原指古代帝王分封诸侯时举行的仪式。后称分封诸侯。","source":{"text":"厥贡惟土五色。","book":"《尚书·禹贡》"},"example":{"text":"朕自当～，以爵卿等。","book":"明·许仲琳《封社演义》第九十四回"},"similar":["分茅列土"],"usage":"作谓语、定语；指分封诸侯"},{"id":8390,"word":"分茅赐土","pinyin":"fēn máo cì tǔ","abbr":"fmct","explanation":"指分封侯位和土地。","source":{"text":"不止分茅赐土，允宜并位于中宫。","book":"清·李渔《夺锦楼》"},"similar":["分茅列土","分茅裂土","分茅锡土"],"usage":"作谓语、定语；指分封诸侯"},{"id":8391,"word":"分茅锡土","pinyin":"fēn máo xī tǔ","abbr":"fmxt","explanation":"指分封侯位和土地。","source":{"text":"只要你忙上紧赶得那人近至尊，便是分茅锡土也非吾吝。","book":"清·李渔《玉搔头飞舸》"},"similar":["分茅列土","分茅赐土","分茅胙土"],"usage":"作谓语、定语；指分封诸侯"},{"id":8392,"word":"分薄缘悭","pinyin":"fèn bó yuán qiān","abbr":"fbyq","explanation":"旧时称缘分浅薄。","source":{"text":"身未到，心先到，分浅缘薄，有上梢没下梢。","book":"元·王子一《误入桃源》第四折"},"similar":["分浅缘悭","分浅缘薄"],"usage":"作谓语、定语；用于人之间"},{"id":8393,"word":"分贫振穷","pinyin":"fēn pín zhèn qióng","abbr":"fpzq","explanation":"分财物救助穷困的人。","source":{"text":"且抚其民，分贫振穷，长孤幼，养老疾。","book":"《左传·昭公四年》"},"usage":"作谓语、宾语；用于救济"},{"id":8394,"word":"分路扬镳","pinyin":"fēn lù yáng biāo","abbr":"flyb","explanation":"扬镳：指驱马前进。分路而行。比喻目标不同，各走各的路或各干各的事。","source":{"text":"洛阳我之丰沛，自应分路扬镳。自今以后，可分路而行。","book":"《魏书·河间公齐传》"},"example":{"text":"我们彼此之间感情不和，早已～了。"},"similar":["分道扬镳"],"usage":"作谓语、定语；用于书面语","story":["北魏孝文帝迁都洛阳，洛阳县官元志与御史中尉李彪在路上相遇，双方都认为自己的官职比对方的高而互不相让，就去找孝文帝评理。孝文帝说：“洛阳是寡人的京城，应该分路扬镳。你们各走各的道就是。”"]},{"id":8395,"word":"分身减口","pinyin":"fēn shēn jiǎn kǒu","abbr":"fsjk","explanation":"指旧时荒年，为减轻家庭负担，维持生计，人口多者每使部分外出逃荒。同“分房减口”。","source":{"text":"今有迫于人口多者，每有分身减口之语。","book":"孙锦标《通俗常言疏证·家族》"},"example":{"text":"太尉颖川庾亮，以帝舅民望，受～，镇武昌，并领江州。","book":"晋·陶潜《晋故征西大将军长史孟府君传》"},"similar":["分房减口"],"usage":"作宾语、定语；用于灾荒年"},{"id":8396,"word":"分身无术","pinyin":"fēn shēn wú shù","abbr":"fsws","explanation":"分身：分出精力照顾其他方面。没有一身同时兼顾几个方面的法术。","example":{"text":"可惜他～，否则就让他得逞了。"},"similar":["分身乏术"],"usage":"作谓语；指无法兼顾的事情"},{"id":8397,"word":"分进合击","pinyin":"fēn jìn hé jī","abbr":"fjhj","explanation":"军队从几个方向前进，协同围击同一目标。","source":{"text":"将敌军对我军的战略上的分进合击，改为我军对敌军的战役或战斗上的分进合击。","book":"毛泽东《中国革命战争的战略问题》第五章第六节"},"example":{"text":"这份电报全部暴露了敌人对我‘～’的战役企图和敌人各路兵力的部署。","book":"曹丹辉《在一九三一年间》"},"usage":"作宾语、定语；用于作战策略等"},{"id":8398,"word":"分道扬镳","pinyin":"fēn dào yáng biāo","abbr":"fdyb","explanation":"分路而行。比喻目标不同，各走各的路或各干各的事。","source":{"text":"洛阳我之丰沛，自应分路扬镳。自今以后，可分路而行。","book":"《魏书·河间公齐传》"},"example":{"text":"第二军总司令李烈钧，亦向广西进发，～，为国效力去了。","book":"蔡东藩、许廑父《民国通俗演义》第五十九回"},"similar":["各奔前程","风流云散"],"opposite":["志同道合","并驾齐驱"],"usage":"作谓语、定语、宾语；用于书面语","story":["北魏孝文帝迁都洛阳，洛阳县官元志与御史中尉李彪在路上相遇，双方都认为自己的官职比对方的高而互不相让，就去找孝文帝评理。孝文帝说：“洛阳是寡人的京城，应该分路扬镳。你们各走各的道就是。”"]},{"id":8399,"word":"分金掰两","pinyin":"fēn jīn bāi liǎng","abbr":"fjbl","explanation":"比喻过分计较。同“分斤掰两”。","source":{"text":"真真泥腿光棍，专会打细算盘、‘分金掰两’的。","book":"清·曹雪芹《红楼梦》第45回"},"example":{"text":"请不能～，我们得宽宏大量些。"},"similar":["分斤拨两"],"usage":"作谓语、定语；比喻过分计较"},{"id":8400,"word":"分钗劈凤","pinyin":"fēn chāi pī fèng","abbr":"fcpf","explanation":"比喻夫妻的离别。同“分钗断带”。","source":{"text":"[县令]乃赋一诗刻诸墓上云：‘分钗劈凤已联年，就义何妨晚慨愆。’","book":"清·钱泳《履园丛话·杂记下·刘王氏》"},"similar":["分钗断带"],"usage":"作谓语；比喻夫妻的离异"},{"id":8401,"word":"分钗断带","pinyin":"fēn chāi duàn dài","abbr":"fcdd","explanation":"钗分开，带断了。比喻夫妻的离别。","source":{"text":"自怜断带日，偏恨分钗时。","book":"南朝·梁·陆罩《闺怨》诗"},"similar":["覆水难收","各奔东西"],"opposite":["破镜重圆"],"usage":"作谓语；比喻夫妻的离异"},{"id":8402,"word":"分钗破镜","pinyin":"fēn chāi pò jìng","abbr":"fcpj","explanation":"比喻夫妻失散或分离。","source":{"text":"镜与人俱去，镜归人未归，当复姮娥影，空留明月辉。","book":"南朝·陈·徐德言《破镜》诗"}},{"id":8403,"word":"分门别户","pinyin":"fēn mén bié hù","abbr":"fmbh","explanation":"分、别：分辨、区别；门：一般事物的分类；户：门户。指在学术上根据各自的格调或见解划清派别，各立门户。","source":{"text":"不认忘名默悟，只解分门别户一朝合眼见前程，悔恨不圆成。","book":"金、元·尹志平《巫山一段云·劝世》"},"example":{"text":"灵牙仙、毗芦仙、金箍仙气概昂昂；七香车坐金灵圣母，～。","book":"明·许仲琳《封神演义》第八十二回"},"similar":["分门别类"],"usage":"作谓语、状语；指按事物性质分类"},{"id":8404,"word":"分门别类","pinyin":"fēn mén bié lèi","abbr":"fmbl","explanation":"分、别：分辨、区别；门：一般事物的分类；类：许多相似或相同事物的综合。把一些事物按照特性和特征分别归入各种门类。","source":{"text":"生平不事著述，今惟存《临证指南医案》十卷，亦其门人取其方药治验，分门别类，集为一书。","book":"清·梁章钜《浪迹丛谈·叶天士遗事》"},"example":{"text":"我只要现在的时务书，～的便好。","book":"清·李宝嘉《文明小史》第三十四回"},"similar":["甲乙丙丁"],"opposite":["杂乱无章","乱七八糟"],"usage":"作谓语、状语；指按事物性质分类"},{"id":8405,"word":"分陕之重","pinyin":"fēn shǎn zhī zhòng","abbr":"fszz","explanation":"陕：古地名，今河南省三门峡市一带；重：重任。指周成王时，周公、召公分陕而治。后指朝廷对守土重臣的委任","source":{"text":"其在成王时，召公为三公。自陕以西，召公主之；自陕以东，召公主之。","book":"西汉·司马迁《史记·燕召公世家》"},"example":{"text":"晋·陶潜《晋故征西大将军长史孟府君传》：“太尉颖川庾亮，以帝舅民望，受～，镇武昌，并领江州。”"},"usage":"作宾语；用于官场等"},{"id":8406,"word":"分鞋破镜","pinyin":"fēn xié pò jìng","abbr":"fxpj","explanation":"比喻夫妻分离。","source":{"text":"唐·孟棨《本事诗·情感》载，南朝陈徐德言娶陈后主妹乐昌公主为妻，公主有才貌。陈亡之际，德言料不能夫妻相守，于是破一镜，夫妻各执一半，相约日后合镜相会。（分鞋，见示例）"},"example":{"text":"明·陶宗仪《辍耕录·贤妻致贵》载，宋程鹏举被虏于张万户家为奴，……娶张所虏宦家女某氏为妻。……妻临行，脱绣鞋一只换程鞋一只，期望日后执此相见。"},"similar":["分钗破镜"],"opposite":["破镜重圆"],"usage":"作宾语、定语；用于夫妻之间","story":["宋人程怀鹏举被掳到张万户家作奴隶，娶张所掳宦家女某氏作妻。某氏见程怀鹏举才貌非凡，不是久居人下的人，多次劝程逃跑。程怀疑妻子受张唆使试探自己，向张报告，某氏因此被逐。某氏临行，脱下绣鞋一只与程交换，期望日后相见"]},{"id":8407,"word":"分风劈流","pinyin":"fēn fēng pǐ liú","abbr":"ffpl","explanation":"比喻说话干脆而有力量。","source":{"text":"燕公真爽快，真是分风劈流的话，我们就算决定了。","book":"清·张鸿《续孽海花》第四十二回"},"usage":"作谓语、定语；指说话干脆而有力量"},{"id":8408,"word":"分香卖履","pinyin":"fēn xiāng mài lǚ","abbr":"fxml","explanation":"旧时比喻人临死念念不忘妻儿。","source":{"text":"余香可分与诸夫人，不命祭。诸舍中无所为，可学作组履卖也。","book":"汉·曹操《遗令》"},"example":{"text":"取笔作诗，绝笔而终，殊无～之意。","book":"宋·李清照《金石录后序》"},"usage":"作谓语；指临死不忘妻妾"},{"id":8409,"word":"切中时弊","pinyin":"qiè zhòng shí bì","abbr":"qzsb","explanation":"切：切合；中：恰好对上；弊：害处。指发表的言论正好击中当时社会的弊病。","source":{"text":"彦光时主丽水簿，慨然上疏陈十弊，皆切中时病。","book":"宋·龚明之《中吴纪闻·王彦光》"},"example":{"text":"这些杂文旗帜鲜明、爱憎分明、～而又短小精炼、妙趣横生、富有寓意，博得了广大读者的欢迎和支持。","book":"丁一岚《不单是为了纪念》"},"similar":["切中时病"],"opposite":["空谈误国"],"usage":"作宾语、定语；指批评时事能击中要害"},{"id":8410,"word":"切中时病","pinyin":"qiè zhòng shí bìng","abbr":"qzsb","explanation":"切：切合；中：恰好对上；病：害处。指发表的言论正好击中当时社会的弊病。","source":{"text":"彦光时主丽水簿，慨然上疏陈十弊，皆切中时病。","book":"宋·龚明之《中吴纪闻·王彦光》"},"example":{"text":"旬日间颇有言事者，其间岂无～？","book":"清·毕沅《续资治通鉴》卷四十一"},"similar":["切中时弊"],"usage":"作宾语、定语；指批评时事能击中要害"},{"id":8411,"word":"切中要害","pinyin":"qiē zhōng yào hài","abbr":"qzyh","explanation":"指批评恰到事物的紧要处。","source":{"text":"彼此默喻，用以试探，月如抓住机会说了一句切中要害的话。","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"这篇批评北京市交通的文章，字字珠玑，正是～。"},"similar":["击中要害"],"usage":"作谓语、定语；用于口语"},{"id":8412,"word":"切切于心","pinyin":"qiè qiè yú xīn","abbr":"qqyx","explanation":"切切：比喻情真意切。牢牢记在心里。形容殷切的思念。","source":{"text":"自从父母亡过，那郑彩鸾也不知所何，小生常切切于心，不能见面。","book":"元·石子章《竹坞听琴》第一折"},"example":{"text":"公子少年心性，道此等是好言语，～。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["切切在心"],"usage":"作谓语、定语；用于思念等"},{"id":8413,"word":"切切在心","pinyin":"qiè qiè zài xīn","abbr":"qqzx","explanation":"切切：形容情意恳切真挚。牢牢地记在心里。形容殷切的思念。","source":{"text":"自从父母亡过，那郑彩鸾也不知所何，小生常切切于心，不能见面。","book":"元·石子章《竹坞听琴》第一折"},"example":{"text":"行者闻言，把功曹叱退，～，按云头，径来山上。","book":"明·吴承恩《西游记》第三十二回"},"similar":["切切于心"],"usage":"作谓语、定语；用于思念等"},{"id":8414,"word":"切切实实","pinyin":"qiè qiè shí shí","abbr":"qqss","explanation":"踏踏实实，确实具体。","source":{"text":"人民的觉悟不是容易的，要去掉人民脑子里的错误思想，需要我们做很多切切实实的工作。","book":"毛泽东《抗日战争胜利后的时局和我们的方针》"},"example":{"text":"光空讲不行，还要给他们创造条件，～地帮助他们解决一些具体问题。","book":"邓小平《关于科学和教育工作的几点意见》"},"similar":["踏踏实实","确确实实"],"usage":"作定语、状语；用于处事等"},{"id":8415,"word":"切切此布","pinyin":"qiè qiè cǐ bù","abbr":"qqcb","explanation":"旧时布告末尾的套语。","source":{"text":"本使为维持地方安宁计，决不能稍示姑容，仰商民人等，各安生业，勿得轻听谣言，自相惊扰，切切此布！","book":"丁中江《北洋军阀史话·黎元洪被迫下台》"},"example":{"text":"以上三章，如有违反者，嚼杀无赦，管叫它血溅十尺，片骨无存。～！","book":"王蒙《成语新编·狐假虎威》"},"usage":"作分句；用于布告"},{"id":8416,"word":"切切私议","pinyin":"qiè qiè sī yì","abbr":"qqsy","explanation":"切：通“窃”；切切：暗中，私下。指私下小声说话。","source":{"text":"满学校的人早已在那里切切私议。","book":"《追求》"},"example":{"text":"《追求》：“满学校的人早已在那里～。”"},"similar":["切切私语"],"usage":"作谓语；指私下小声说话"},{"id":8417,"word":"切切私语","pinyin":"qiè qiè sī yǔ","abbr":"qqsy","explanation":"指私下小声说话。","source":{"text":"大弦嘈嘈如急雨，小弦切切如私语。","book":"唐·白居易《琵琶行》"},"example":{"text":"条子发了出去，又和子迁、仲英～了一回。","book":"清·吴趼人《近十年之怪现状》第三回"},"similar":["窃窃私语"],"usage":"作谓语；指私下小声说话"},{"id":8418,"word":"切切细语","pinyin":"qiè qiè xì yǔ","abbr":"qqxy","explanation":"切：通“窃”；切切：暗中，私下。低声交谈。","source":{"text":"虽判两使事，未尝以簿书为意，日引其党屏人切切细语。","book":"唐·韩愈《顺宗实录·永贞元年》"},"similar":["切切私语"],"usage":"作谓语；指私下小声说话"},{"id":8419,"word":"切合实际","pinyin":"qiē hé shí jì","abbr":"qhsj","explanation":"指想法或做事合乎实际情况。","source":{"text":"我们今后订计划，一定要切合实际，并且留有余地。","book":"邓小平《在扩大的中央工作会议上的讲话》"},"opposite":["不切实际"],"usage":"作谓语、定语；用于事情等"},{"id":8420,"word":"切合时宜","pinyin":"qiè hé shí yí","abbr":"qhsy","explanation":"十分符合当时的需要或潮流。","example":{"text":"这样的打扮～。"},"opposite":["不合时宜"],"usage":"作谓语、定语；用于事物等"},{"id":8421,"word":"切响浮生","pinyin":"qiè xiǎng fú shēng","abbr":"qxfs","explanation":"切响：仄声；浮声：平声。指古汉语中的平仄声。也泛指音韵的纤细低沉和洪亮高亢。","source":{"text":"夫五色相宣，八音协畅，由乎玄黄律吕，各物宜。欲使宫羽相变，低昂互节，若前有浮生，则后须切响。","book":"《宋书·谢灵运传论》"},"example":{"text":"～发巧深，研摩虽苦果何心。","book":"金·元好问《论诗三十首》第十七"}},{"id":8422,"word":"切树倒根","pinyin":"qiē shù dǎo gēn","abbr":"qsdg","explanation":"比喻彻底。"},{"id":8423,"word":"切理会心","pinyin":"qiē lǐ huì xīn","abbr":"qlhx","explanation":"犹切理厌心。指切合事理而令人心满意足。","source":{"text":"江淮士人零落，既闻君讲说，切理会心，坐席皆满。","book":"宋·叶适《太学博士主君墓志铭》"},"similar":["切理厌心"],"usage":"作谓语、定语；用于书面语"},{"id":8424,"word":"切理厌心","pinyin":"qiē lǐ yàn xīn","abbr":"qlyx","explanation":"指切合事理而令人心满意足。","source":{"text":"显附者，辞直义畅，切理厌心者也。","book":"南朝·梁·刘勰《文心雕龙·体性》"},"similar":["切理会心","切理餍心"],"usage":"作谓语、定语；用于书面语"},{"id":8425,"word":"切理餍心","pinyin":"qiē lǐ yàn xīn","abbr":"qlyx","explanation":"指切合事理而令人心满意足。同“切理厌心”。","source":{"text":"道通天地之外，思入风云之中，批隙导窾，切理餍心。","book":"太平天国·洪仁玕《叙》"},"similar":["切理厌心","切理会心"],"usage":"作谓语、定语；用于书面语"},{"id":8426,"word":"切瑳琢磨","pinyin":"qiē cùn zhuó mó","abbr":"qczm","explanation":"比喻学习或研究问题时彼此商讨，互相吸取长处，改正缺点。同“切磋琢磨”。","source":{"text":"今世人相识，未见有功有切瑳琢磨如古之朋友者，盖能受善言者少。","book":"宋·王安石《与孙莘老书》"},"similar":["切磋琢磨"],"usage":"作谓语、定语；用于学术研究"},{"id":8427,"word":"切磋琢磨","pinyin":"qiē cuō zhuó mó","abbr":"qczm","explanation":"将骨、角、玉、石加工制成器物。比喻学习或研究问题时彼此商讨，互相吸取长处，改正缺点。","source":{"text":"有匪君子，如切如磋，如琢如磨。","book":"《诗经·卫风·淇奥》"},"example":{"text":"盖以朋友之臧否，文艺之优劣，～，匪朝伊夕，抑扬去就，与众共之。","book":"五代·王定保《唐摭言》卷一"},"similar":["取长补短","推本溯源"],"opposite":["不求甚解","浅尝辄止"],"usage":"作谓语、定语；用于学术研究"},{"id":8428,"word":"切磨箴规","pinyin":"qiè mó zhēn guī","abbr":"qmzg","explanation":"切：切磋；箴规：规谏，劝戒。互相批评，互相帮助。","source":{"text":"交友投分，切磨箴规。","book":"南朝·梁·周兴嗣《千字文》"},"example":{"text":"南朝·梁·周兴嗣《千字文》：“交友投分，切磨箴规。”"},"similar":["箴规磨切"],"usage":"作谓语、宾语、定语；指互相帮助"},{"id":8429,"word":"切肤之痛","pinyin":"qiè fū zhī tòng","abbr":"qfzt","explanation":"切肤：切身，亲身。亲身经受的痛苦。比喻感受深切。","source":{"text":"带一名于纸尾，遂成附骨之疽，受万罪于公门，竞属切肤之痛。","book":"清·蒲松龄《聊斋志异·冤狱》"},"example":{"text":"对日本帝国主义的暴行，他有着～。"},"similar":["同感身受","痛定思痛"],"opposite":["不关痛痒"],"usage":"作主语、宾语；比喻感受深切"},{"id":8430,"word":"切要关头","pinyin":"qiè yào guān tóu","abbr":"qygt","explanation":"关头：关口，引申为关键，转折点。指关键时刻。","source":{"text":"臣才识浅陋，惟自念受恩深重，备职封圻，睹此利害切要关头，窃恐筑室道谋，一纵即不可复挽，不揣冒昧，谨再沥忱附片密陈。伏乞圣鉴。","book":"清·林则徐《钱票无甚关碍宜重禁吃烟以杜弊源片》"},"similar":["紧要关头"],"usage":"作宾语、定语；指关键时刻"},{"id":8431,"word":"切身体会","pinyin":"qiē shēn tǐ huì","abbr":"qsth","explanation":"指自身遇到的经验。","source":{"text":"很多诸如‘认贼作父’、‘不稂不莠’等成语我都是那时学会准确运用的，并对‘闻风丧胆’、‘不打自招’之类的成语有了切身体会。","book":"王朔《过把瘾就死》"},"example":{"text":"只有～的经验才是真实而深刻的。"},"similar":["切身感受"],"usage":"作谓语、宾语；用于口语"},{"id":8432,"word":"切近的当","pinyin":"qiē jìn de dāng","abbr":"qjdd","explanation":"①恰切得当。②指意浅语实。"},{"id":8433,"word":"切鈇之疑","pinyin":"qiè fū zhī yí","abbr":"qfzy","explanation":"鈇：通“斧”。比喻凭主观臆断而产生的疑心或成见。","source":{"text":"身自贻于吏议，虽丹书幸免，宁无窃鈇之疑？而白简仍裁，终有吹齑之戒。","book":"宋·张守《再乞罢言职求外状》"}},{"id":8434,"word":"切问近思","pinyin":"qiè wèn jìn sī","abbr":"qwjs","explanation":"切：恳切；近思：想当前的问题。恳切地问询，多考虑当前的问题。","source":{"text":"博学而笃志，切问而近思。","book":"《论语·子张》"},"example":{"text":"故就其所及而语之，是乃所以使之～，而渐进于高远也。","book":"宋·朱熹《论语集注·雍也第六》"}},{"id":8435,"word":"切骨之仇","pinyin":"qiè gǔ zhī chóu","abbr":"qgzc","explanation":"形容仇恨极深。","source":{"text":"文秀当初谋他命时，还是一个小厮，如今顶冠束带，换了一番气象，如何便认得出。文秀乃切骨之仇，日夜在心，故此一经眼，即便认得。","book":"明·冯梦龙《醒世恒言》卷二十"},"example":{"text":"你若要起他的钱来，比要他的命更加刻毒，万一浪费了他一文半钞，更是一生的～。","book":"清·张春帆《九尾龟》第二十六回"},"similar":["深仇大恨","刻骨仇恨"],"usage":"作宾语；指不共戴天的仇"},{"id":8436,"word":"切骨之寒","pinyin":"qiè gǔ zhī hán","abbr":"qgzh","explanation":"切骨：彻骨，渗透到骨头里。形容冷得刺骨。","source":{"text":"酌醇酒而据切骨之寒。","book":"南朝·梁·萧统《黄钟十一月启》"},"usage":"作主语、宾语；用于天气或心情"},{"id":8437,"word":"切骨之恨","pinyin":"qiè gǔ zhī hèn","abbr":"qgzh","explanation":"形容怨恨极深。","example":{"text":"但在那些身受明朝重录，而又靦颜事清，好官自为的大老来说，却有刺心之痛，～。","book":"高阳《清官册·节母之子》"}},{"id":8438,"word":"切齿咬牙","pinyin":"qiè chǐ yǎo yá","abbr":"qcyy","explanation":"切齿：咬紧牙关，表示痛恨。形容极端仇视或痛恨。","source":{"text":"徐晃睁眉怒目，许褚切齿咬牙，各有相斗之意。","book":"明·罗贯中《三国演义》第56回"},"similar":["咬牙切齿","咬牙恨齿"],"usage":"作谓语、定语、状语；指极端仇视或痛恨"},{"id":8439,"word":"切齿嚼牙","pinyin":"qiè chǐ jiáo yá","abbr":"qcjy","explanation":"切齿：咬紧牙齿，表示痛恨。形容极端仇视或痛恨。也形容把某种情绪或感觉竭力抑制住。","source":{"text":"你可为甚么切齿嚼牙恨？这是你自做的来有家难奔。","book":"元·秦简夫《东堂老》第四折"}},{"id":8440,"word":"切齿愤盈","pinyin":"qiè chǐ fèn yíng","abbr":"qcfy","explanation":"切齿：齿相磨切，愤恨。紧咬牙齿十分愤怒。形容非常愤怒。","source":{"text":"中官世盛，暴恣数十年，四海之内，莫不切齿愤盈。","book":"东汉·班固《汉书·张奂传论》"},"similar":["切齿愤恨"],"usage":"作谓语、定语、状语；用于愤怒"},{"id":8441,"word":"切齿拊心","pinyin":"qiè chǐ fǔ xīn","abbr":"qcfx","explanation":"咬牙捶胸。极端痛恨的样子。","source":{"text":"此臣日夜切齿腐心也，乃今得闻教。","book":"《战国策·燕策三》"},"example":{"text":"此月五日，被驿使追命骑还朝，～，辄已钟疾，虽百口在都，一非所顾。","book":"南朝·梁·沈约《宋书·萧思话传》"},"similar":["切齿腐心"],"usage":"作谓语、定语；指痛恨"},{"id":8442,"word":"切齿痛心","pinyin":"qiè chǐ tòng xīn","abbr":"qctx","explanation":"切齿：咬紧牙齿；痛心：形容心中极恨。形容愤恨到极点。","source":{"text":"此臣之日夜切齿腐心也。","book":"《战国策·燕策三》：“此臣日夜切齿腐心也。”《史记·刺客列传》"},"example":{"text":"有心之人，方～，恨不得即剖其心，食其心；亏他还哄人说是赤心。","book":"鲁迅《中国小说史略·元明传来之讲史（上）》"},"similar":["切齿痛恨"],"usage":"作谓语、定语、状语；用于愤恨"},{"id":8443,"word":"切齿痛恨","pinyin":"qiè chǐ tòng hèn","abbr":"qcth","explanation":"形容愤恨到极点。","source":{"text":"此臣之日夜切齿腐心也。","book":"《战国策·燕策三》：“此臣日夜切齿腐心也。”《史记·刺客列传》"},"example":{"text":"饱经战争创作的人，对侵略者是～的。"},"similar":["咬牙切齿","恨之入骨"],"opposite":["关心倍至"],"usage":"作谓语；用于坏人"},{"id":8444,"word":"切齿腐心","pinyin":"qiè chǐ fǔ xīn","abbr":"qcfx","explanation":"切齿：咬紧牙齿；腐心：形容心中极恨。形容愤恨到极点。","source":{"text":"此臣之日夜切齿腐心也。","book":"西汉·司马迁《史记·刺客列传》"},"example":{"text":"寡人念先王之仇，～！","book":"明·冯梦龙《东周列国志》第97回"},"similar":["切齿痛恨"],"usage":"作谓语、定语；指痛恨"},{"id":8445,"word":"刈蓍亡簪","pinyin":"yì shī wáng zān","abbr":"yswz","explanation":"比喻能勾起人们怀旧之情的故物。","source":{"text":"妇人曰：‘乡者、刈蓍薪，亡吾蓍簪，吾是以哀也。’弟子曰：‘刈蓍薪而亡蓍簪，有何悲焉！’妇人曰：‘非伤亡簪也，盖不忘故也。’","book":"汉·韩婴《韩诗外传》卷九"}},{"id":8446,"word":"刊心刻骨","pinyin":"kān xīn kè gǔ","abbr":"kxkg","explanation":"指印象深刻，令人难忘。","source":{"text":"也没有一篇不刊心刻骨，博大精深。只要你肯埋着头，咬着牙，在岩石里边寻求金子。","book":"闻一多《邓以蛰题记》"},"similar":["铭心刻骨"],"usage":"作谓语、定语；指印象很深"},{"id":8447,"word":"刍荛之见","pinyin":"chú ráo zhī jiàn","abbr":"crzj","explanation":"刍荛：割草打柴的人。认为自己的意见很浅陋的谦虚说法。","source":{"text":"先民有言，询于刍荛。","book":"《诗经·大雅·板》"},"example":{"text":"但军旅之事，容当陆续奉献，～，供将军斟酌可否。","book":"姚雪垠《李自成》第二卷第三十七章"},"similar":["刍荛之言"],"opposite":["远见卓识"],"usage":"作宾语；用于自谦"},{"id":8448,"word":"刍荛之言","pinyin":"chú ráo zhī yán","abbr":"crzy","explanation":"刍荛：割草打柴的人。割草打柴人的话。指普遍百姓的浅陋言辞。也用作讲话者的谦词。","source":{"text":"先民有言，询于刍荛。","book":"《诗经·大雅·板》"},"example":{"text":"巧匠何曾弃樗栎，～或有益。","book":"宋·李清照《上枢密韩肖胄》诗"},"similar":["刍荛之见"],"opposite":["远见卓识"],"usage":"作宾语；用作讲话者的谦词"},{"id":8449,"word":"刎颈之交","pinyin":"wěn jǐng zhī jiāo","abbr":"wjzj","explanation":"刎颈：割脖子；交：交情，友谊。比喻可以同生死、共患难的朋友。","source":{"text":"卒相与欢，为刎颈之交。","book":"《史记·廉蔺相如列传》"},"example":{"text":"他有个闺中谈禅的密友，却是个～的娇妻。","book":"清·曾朴《孽海花》第十三回"},"similar":["患难之交","刎颈至交"],"usage":"作宾语；指共患难的朋友","story":["战国时期，赵国宦者令缪贤的门客蔺相如受赵王的派遣，带和氏璧出使秦国，而能完璧归赵，被赵王重用，拜为上卿。武将廉颇受不了，多次想找蔺相如的茬，蔺相如以国事为重避免了矛盾。廉颇负荆请罪，两人后来成为刎颈之交"]},{"id":8450,"word":"刎颈交","pinyin":"wěn jǐng jiāo","abbr":"wjj","explanation":"刎颈：割脖子；交：交情，友谊。比喻可以同生死、共患难的朋友。","source":{"text":"卒相与欢，为刎颈之交。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"～，相如与廉颇；总角好，孙策与周瑜。","book":"清·程允升《幼学琼林·朋友宾主》"}},{"id":8451,"word":"刎颈至交","pinyin":"wěn jǐng zhì jiāo","abbr":"wjzj","explanation":"刎颈：割脖子；交：交情。比喻情谊深厚，可以同生死、共患难的朋友。","source":{"text":"倘若将他首发，岂不是把那刎颈至交，做成一个负心贼子么？","book":"清·遯庐《童子军·卖友》"},"similar":["刎颈之交"],"usage":"作宾语；指共患难的朋友"},{"id":8452,"word":"刑不上大夫","pinyin":"xíng bù shàng dà fū","abbr":"xbsdf","explanation":"大夫：官名，商周有大夫、乡大夫、遂大夫、朝大夫、冢大夫五级爵。原指五级爵犯罪免受肉刑。后比喻刑法对官僚阶级不起作用。","source":{"text":"礼不下庶人，刑不上大夫。","book":"《礼记·曲礼上》"},"example":{"text":"古时～，张珪身为平章，乃遭幸臣仗责，可叹可恨！","book":"蔡东藩《元史演义》第三十一回"}},{"id":8453,"word":"刑于之化","pinyin":"xíng yú zhī huà","abbr":"xyzh","explanation":"指以礼法对待。后用以指夫妇和睦。","source":{"text":"文王以礼法接待其妻。","book":"《诗·大雅·思齐》：“刑于寡妻，至于兄弟，以御于家邦。”郑玄笺"},"example":{"text":"若论～，卑人其实不让文王，但恐娘子未如淑女。","book":"明汪廷讷《狮吼记·奇妒》"},"usage":"作宾语、定语；用于书面语"},{"id":8454,"word":"刑仁讲让","pinyin":"xíng rén jiǎng ràng","abbr":"xrjr","explanation":"以仁爱为典型，讲求礼让。","source":{"text":"以著其义，以考其信，著有过，刑仁讲让，示民有常。","book":"《礼记·礼运》"},"usage":"作宾语、定语；用于书面语"},{"id":8455,"word":"刑余之人","pinyin":"xíng yú zhī rén","abbr":"xyzr","explanation":"余：以后。指太监或受过宫刑的人。也指其他受刑致残的人。","source":{"text":"齐威王欲将孙膑，膑辞谢曰：‘刑余之人不可。’","book":"《史记·孙子吴起列传》"},"example":{"text":"～，心狠手辣，自古然也。","book":"燕谷老人《续孽海花》第五十六回"},"usage":"作宾语；用于书面语"},{"id":8456,"word":"刑天争神","pinyin":"xíng tiān zhēng shén","abbr":"xtzs","explanation":"刑天：古代神话中的人物。刑天敢于和天帝争夺神位。后比喻大无畏的精神。","source":{"text":"奇肱之国之北，其人一臂三目，有阴有阳，乘文马。有鸟焉，两头，赤黄色，在其旁。刑天与帝至此争神。帝断其首，葬之常羊之山。乃以乳为目，以脐为口，操干戚以舞。","book":"《山海经·海外西经》"},"usage":"作宾语、定语；用于比喻句"},{"id":8457,"word":"刑措不用","pinyin":"xíng cuò bù yòng","abbr":"xcby","explanation":"措：设置，设施。刑法放置起来而不用。形容政治清平。","source":{"text":"汉文帝竟不登封，而躬行俭约，刑措不用。","book":"《北史·循吏传·王伽》：“若使官尽王伽之俦，人皆李参之辈，刑措不用，其何远哉！”《旧唐书·礼仪志三》"},"example":{"text":"夫古之所谓至治极盛者，曰‘家给人足’，曰‘比户可封’，曰‘～’。","book":"严复《原强》"},"usage":"作谓语、定语；指太平盛世"},{"id":8458,"word":"刑无等级","pinyin":"xíng wú děng jí","abbr":"xwdj","explanation":"对犯人用刑不考虑其地位的尊贵和卑贱。","source":{"text":"所谓壹刑者，刑无等级。","book":"《商君书·赏刑》"}},{"id":8459,"word":"刑期无刑","pinyin":"xíng qī wú xíng","abbr":"xqwx","explanation":"刑罚在于教育人恪守法律，从而达到不用开的目的。","source":{"text":"刑期于无刑。","book":"语出《书·大禹谟》"},"example":{"text":"～，古有明训。","book":"孙中山《大总统令内务司法两部通饬所属禁止刑讯文》"},"usage":"作宾语、定语；用于书面语"},{"id":8460,"word":"刑马作誓","pinyin":"xíng mǎ zuò shì","abbr":"xmzs","explanation":"古代结盟，杀马饮血，立誓为信。比喻庄重的誓言。","source":{"text":"并刑马之誓，传之子孙。","book":"《战国策·齐策三》：“且臣闻齐、卫先君，刑马压羊，盟曰：‘齐、卫后世无相攻伐，有相攻伐者，令其命如此。’”南朝·梁·丘迟《与陈伯之书》"},"example":{"text":"南朝·梁·丘迟《与陈伯之书》：“并～，传之子孙。”"},"usage":"作谓语、宾语；用于处事"},{"id":8461,"word":"划一不二","pinyin":"huà yī bù èr","abbr":"hybe","explanation":"指按照定价卖出，不打折扣。形容做事刻板。","source":{"text":"萧何为法，讲若画一。","book":"《汉书·曹参传》"},"example":{"text":"于是文章也就不能～，可说之处说一点，不能说之处便罢休。","book":"鲁迅《南腔北调集·题记》"},"similar":["说一不二","言行一致"],"usage":"作谓语、定语；指言行一致"},{"id":8462,"word":"划地为牢","pinyin":"huà dì wéi láo","abbr":"hdwl","explanation":"牢：牢狱。在地上画一个圈当做监狱。比喻只许在指定的范围内活动，不得逾越","source":{"text":"自己认真做去就可以了，何必因为别人另有选择，自己就划地为牢，限制自己？","book":"孙犁《澹定集·关于乡土文学》"},"similar":["画地为牢","画地为狱","画地成牢"],"usage":"作谓语、宾语；用于处事"},{"id":8463,"word":"划粥割齑","pinyin":"huà zhōu gē jīu","abbr":"hzgj","explanation":"把粥划成若干块，咸菜切成碎末。"},{"id":8464,"word":"刓方为圆","pinyin":"shū fāng wéi yuán","abbr":"wfwy","explanation":"把方的削成圆的。比喻改变忠直之性，随俗俯仰。","source":{"text":"《楚辞·九章·怀沙》：“刓方以为圜兮，常度未替。”王逸注：“言人刓削方木，欲以为圜，……以言谗人谮逐放己，欲使改行。”圜，同“圆”。"}},{"id":8465,"word":"刓方为圆，常度未替","pinyin":"wán fāng wéi yuán，cháng dù wèi tì","abbr":"wfwycdwt","explanation":"刓：削；常度：平时的状态；替：更换。把方的削成圆的，但平时的状态没有改变。比喻正常的法则不会因奸人颠倒是非而改变。","source":{"text":"刓方以为圜兮，常度未替。","book":"战国·楚·屈原《九章·怀沙》"}},{"id":8466,"word":"刖足适履","pinyin":"yuè zú shì lǚ","abbr":"yzsl","explanation":"因为鞋小脚大，就把脚削去一块来凑和鞋的大小。比喻不合理的牵就凑合或不顾具体条件，生搬硬套。","source":{"text":"刖趾适屦，刻肌伤骨，反更称说，自以为能。","book":"《三国志·魏书·明帝纪》裴松之注引《魏略》"}},{"id":8467,"word":"刖足适屦","pinyin":"yuè zú shì jù","abbr":"yzsj","explanation":"刖：截断；屦：鞋。鞋小脚大，就把脚削去一块来凑和鞋的大小。比喻不合理的牵就凑合或不顾具体条件，生搬硬套","example":{"text":"～的做法太低劣"},"similar":["刖趾适屦"],"usage":"作谓语、定语；指不知变通"},{"id":8468,"word":"刖趾适履","pinyin":"yuè zhǐ shì lǚ","abbr":"yzsl","explanation":"鞋小脚大，把脚削去一块来凑和鞋的大小。比喻不合实际，勉强迁就，生搬硬套。","source":{"text":"刖趾适履，刻肌伤骨，反更称说，自以为能。","book":"三国·魏·鱼豢《魏略》"},"similar":["削足适履","生搬硬套"],"usage":"作谓语、定语；指不知变通"},{"id":8469,"word":"刖趾适屦","pinyin":"yuè zhǐ shì jù","abbr":"yzsj","explanation":"因为鞋小脚大，就把脚削去一块来凑和鞋的大小。比喻不合理的牵就凑合或不顾具体条件，生搬硬套。","source":{"text":"刖趾适屦，刻肌伤骨，反更称说，自以为能。","book":"《三国志·魏书·明帝纪》裴松之注引《魏略》"},"similar":["刖趾适履"],"usage":"作谓语、定语；指不知变通"},{"id":8470,"word":"列功覆过","pinyin":"liè gōng fù guò","abbr":"lgfg","explanation":"罗列功绩，掩盖过错。","source":{"text":"言威武勤劳则大于方叔、吉甫，列功覆过则优于齐桓、贰师。","book":"东汉·班固《汉书·陈汤传》"},"similar":["将功补过"],"usage":"作谓语；指掩饰自己的过错"},{"id":8471,"word":"列土分茅","pinyin":"liè tǔ fēn máo","abbr":"ltfm","explanation":"指受封为诸侯。古代天子分封诸侯时，用白茅裹着社坛上的泥土授予被封者，象征土地和权力，称为“列土分茅”。","source":{"text":"军前累立功劳大，列土分茅受大封。","book":"元·郑光祖《三战吕布》第一折"},"similar":["裂土分茅"],"usage":"作谓语、定语；指分封土地"},{"id":8472,"word":"列土封疆","pinyin":"liè tǔ fēng jiāng","abbr":"ltfj","explanation":"列：同“裂”；封疆：划定疆界。帝王将土地分封给大臣。","source":{"text":"方制海内非为王子，列土封疆非为诸候，皆以为民也。","book":"《汉书·谷永传》"},"similar":["列土分茅"],"usage":"作谓语、宾语；指帝王将土地分封给大臣"},{"id":8473,"word":"列祖列宗","pinyin":"liè zǔ liè zōng","abbr":"lzlz","explanation":"指历代祖先。","source":{"text":"自然株连着化为妄想，理合不分首从，全踏在朝靴底下，以列祖列宗的成规。","book":"鲁迅《热风·随感录三十九》"},"example":{"text":"我们要对得起～。"},"usage":"作宾语、定语；指历代祖先"},{"id":8474,"word":"列风淫雨","pinyin":"liè fēng yín yǔ","abbr":"lfyy","explanation":"列：烈；淫：过量。本指狂风暴雨。后比喻错别字连篇。","source":{"text":"南朝梁·刘勰《文心雕龙·练字》：“《尚书大传》有‘别风淮雨’，《帝王世纪》云‘列风淫雨’；‘别’、‘列’、‘淮’、‘淫’，字似潜移；‘淫’‘列’义当而不奇，‘淮’‘别’理乖而新异。"}},{"id":8475,"word":"列鼎而食","pinyin":"liè dǐng ér shí","abbr":"ldes","explanation":"列：陈列；食：吃。形容豪门贵族的奢侈生活。","source":{"text":"累茵而坐，列鼎而食。","book":"汉·刘向《说苑·建本》"},"example":{"text":"今日个～，煞强如淡饭黄齑。","book":"元·马致远《荐福碑》第四折"},"similar":["大吃大喝","食前方丈"],"usage":"作谓语、定语；形容豪门贵族的奢侈生活"},{"id":8476,"word":"列鼎重裀","pinyin":"liè dǐng chóng yīn","abbr":"ldzy","explanation":"鼎裀：垫子，褥子。指吃得很好，睡得十分舒适。形容高官贵族的豪华生活。。也泛指达官显宦。","source":{"text":"他他他只将那会谄谀的着列鼎重裀，害忠良的便加官请俸。","book":"元·纪君祥《赵氏孤儿》第二折"},"example":{"text":"官居极品姓名高，～满腹学，为臣正直安天下，保祚吾皇立国朝。","book":"明·无名氏《单刀劈四寇》第一折"},"usage":"作宾语、定语；用于生活"},{"id":8477,"word":"刘毅答诏","pinyin":"liú yì dá zhào","abbr":"lydz","explanation":"指敢于谏诤。","source":{"text":"帝尝南郊，礼毕，喟然问毅曰：‘卿以朕方汉何帝也？’对曰：‘可方桓灵。’……‘桓灵卖官，钱入官库，陛下卖官，钱入私门。以此言之，殆不如也。’帝大笑曰：‘桓灵之世，不闻此言。今有直臣，故不同也。’","book":"《晋书·刘毅传》"},"example":{"text":"郭钦上书见大计，～惊群臣。","book":"唐·杜甫《暮秋枉裴道州札率尔遗兴寄呈苏涣待御》诗"},"usage":"作宾语、定语；指敢于谏诤","story":["晋朝时期，皇帝带刘毅到南郊巡游，皇帝问刘毅他与汉朝哪个皇帝齐名。刘毅回答说只能与桓帝灵帝齐名。皇帝感慨说自己不如古人，但自己克己为政，尽力为天下一统。刘毅立即说桓灵买官为充实国库，陛下卖官钱入自己腰包，这点还不如古人"]},{"id":8478,"word":"刘郎前度","pinyin":"liú láng qián dù","abbr":"llqd","explanation":"诗文中以之称去而复来的人。","source":{"text":"南朝·宋·刘义庆《幽明录》载：东汉刘晨阮肇在天台山遇仙，归来已是晋代。后刘等重访天台山，旧踪渺然。"},"example":{"text":"浑无绪！～，空记来时路。","book":"宋·周紫芝《点绛唇》词"},"similar":["前度刘郎"],"usage":"作宾语；泛指去了又来的人","story":["传说东汉永平年间，刘晨、阮肇两人上山砍柴，在天台山桃源洞里见到几个仙人在下棋，他们就在旁边仔细观看，看了一整天，仙人下罢后就离开，他们两人也就下山。还乡后已经到了晋朝。后来他们又重新回到天台山"]},{"id":8479,"word":"刚中柔外","pinyin":"gāng zhōng róu wài","abbr":"gzrw","explanation":"刚：刚硬，坚强；中：里，内心；柔：软弱，柔和。表面柔顺，内里刚强。指人外柔而内刚的性格。也指外表和好，内藏杀机的策略。","source":{"text":"信而安之，阴以图之，备而后动，勿使有变，刚中柔外也。","book":"《三十六计·笑里藏刀》"},"similar":["内柔外刚"],"usage":"作定语、状语；指人的个性"},{"id":8480,"word":"刚亦不吐，柔亦不茹","pinyin":"gāng yì bù tǔ，róu yì bù rú","abbr":"gybtrybr","explanation":"刚：硬、强；柔：软、弱；茹：吃。对强硬的不害怕，对软弱的不欺侮。形容不欺软怕硬。","source":{"text":"维仲山甫，柔亦不茹，刚亦不吐。","book":"《诗经·大雅·烝民》"}},{"id":8481,"word":"刚克柔克","pinyin":"gāng kè róu kè","abbr":"gkrk","explanation":"铡：刚强；克：制伏，克服；柔：柔和。以刚强制胜或以柔和制胜。指根据不同的情况而采用不同的办法来解决。","source":{"text":"三德：一曰正直，一曰刚克，一曰柔克。","book":"《尚书·洪范》"},"usage":"作宾语、定语；用于处事方法"},{"id":8482,"word":"刚克消亡","pinyin":"gang ke xiao wang","abbr":"gkxw","explanation":"刚正的人就不能存在了。"},{"id":8483,"word":"刚愎自用","pinyin":"gāng bì zì yòng","abbr":"gbzy","explanation":"愎：任性；刚愎：强硬回执；自用：自以为是。十分固执自信，不考虑别人的意见。","source":{"text":"好问则裕，自用则小。","book":"《左传·宣公十二年》：“其佐先穀，刚愎不仁，未肯用命。”《尚书·仲虺之诰》"},"example":{"text":"他想起李玉亭所说荪甫的～来了。他决定了主意不跟着荪甫跑了。","book":"茅盾《子夜》十"},"similar":["我行我素"],"opposite":["虚怀若谷","从善如流"],"usage":"作谓语、定语；十分固执自信","story":["春秋时期，晋楚因宋国发生战争，楚军打得宋国要投降了就撤军。晋军将领先不听统帅荀林父的命令擅自进攻楚军。楚国大夫伍参对楚庄王说晋军将领先刚愎自用，内部不团结，可以消灭晋军而出兵。结果，楚国大获全胜"]},{"id":8484,"word":"刚戾自用","pinyin":"gāng lì zì yòng","abbr":"glzy","explanation":"十分固执自信，不考虑别人的意见。同“刚愎自用”。","source":{"text":"始皇为人，天性刚戾自用，起诸侯，并天下，意得欲从，以为自古莫及己。","book":"《史记·秦始皇本纪》"},"similar":["刚愎自用"],"usage":"作谓语、定语；十分固执自信"},{"id":8485,"word":"刚柔相济","pinyin":"gāng róu xiāng jì","abbr":"grxj","explanation":"刚强的和柔和的互相调剂。","source":{"text":"刚柔节也。","book":"《周易·蒙》"},"example":{"text":"凡为将者，当以～，不可徒恃其勇。","book":"明·罗贯中《三国演义》第七十一回"},"opposite":["以柔克刚"],"usage":"作谓语、定语；指刚强的和柔和的互相配合"},{"id":8486,"word":"刚正不阿","pinyin":"gāng zhèng bù ē","abbr":"gzbe","explanation":"阿：迎合，偏袒。刚强正直，不逢迎，无偏私。","source":{"text":"有正大不阿，不行私谒者，便以为不贤。","book":"明·余继登《典故纪闻》卷十四"},"example":{"text":"济南同知吴公，～。","book":"清·蒲松龄《聊斋志异·一员官》"},"similar":["坚强不屈"],"opposite":["阿谀奉承"],"usage":"作谓语、定语；指刚强正直，不逢迎","story":["宋朝包拯是一个刚正不阿的清官，赴任扬州天长知县时写诗自勉：“清心为治本，直道是身谋。”他一生敢于犯颜直谏，不谋私利，执法如山，铁面无私，不畏权贵，不循私情，为民除害，成为百姓心中的“包青天”"]},{"id":8487,"word":"刚正无私","pinyin":"gāng zhèng wú sī","abbr":"gzws","explanation":"刚：刚直；正：正直。刚直方正而没有私心。","source":{"text":"为人刚正无私，不轻一笑。","book":"明·罗贯中《平妖传》第27回"},"similar":["刚正不阿","刚直不阿"],"usage":"作谓语、定语；指刚强正直，不逢迎"},{"id":8488,"word":"刚毅木讷","pinyin":"gāng yì mù nè","abbr":"gymn","explanation":"刚：坚强；毅：果决；木：质朴；讷：说话迟钝，此处指言语谨慎。孔子称颂人的四种品质。","source":{"text":"子曰：‘刚、毅、木、讷，近仁。’","book":"《论语·子路》"},"example":{"text":"巧言令色，世之所说也；～，世之所恶也。","book":"宋·苏辙《论语拾遗》"},"usage":"作谓语；指坚毅质朴而不善辞令"},{"id":8489,"word":"刚直不阿","pinyin":"gāng zhí bù ē","abbr":"gzbe","explanation":"阿：迎合，偏袒。刚强正直，不逢迎，无偏私。","source":{"text":"并一生宦迹，刚直不阿之志，具表奏闻。","book":"明·周楫《西湖二集·救金鲤海龙王报德》"},"example":{"text":"您是那样满怀激情地给我讲汉朝的范滂如何～，挺身就险……","book":"陶斯亮《一封终于发出的信》"},"similar":["刚正不阿"],"opposite":["卑躬屈膝"],"usage":"作谓语、定语；指刚强正直，不逢迎"},{"id":8490,"word":"刚肠嫉恶","pinyin":"gāng cháng jí è","abbr":"gcje","explanation":"刚肠：性情刚直；嫉：憎恨。性情刚直，憎恨邪恶。","source":{"text":"刚肠嫉恶，轻肆直方，遇事便发，此甚不可二也。","book":"晋·稽康《与山巨源绝交书》"},"example":{"text":"下走～，近郅都为人，观今弊俗，非言论所能正，独有刀锯桁杨，弹治之耳。","book":"章炳麟《致杨救炎书》"},"similar":["疾恶如仇"],"usage":"作谓语、宾语；指人很正直"},{"id":8491,"word":"刚褊自用","pinyin":"gāng biǎn zì yòng","abbr":"gbzy","explanation":"褊：器量狭小。独断固执，自以为是。","source":{"text":"伏念臣才不逮人，性多忤物，刚褊自用，可谓小忠；猖狂妄行，乃蹈大难。","book":"宋·苏轼《提举玉局观谢表》"},"similar":["刚戾自用","刚愎自用"],"usage":"作谓语、定语；十分固执自信"},{"id":8492,"word":"创业垂统","pinyin":"chuàng yè chuí tǒng","abbr":"cyct","explanation":"创业：创建功业；垂：流传；统：指一脉相承的系统。创立功业，传给后代子孙。","source":{"text":"《孟子·梁惠王下》“君子创业垂统，为可继也。”"},"example":{"text":"自古帝王～，必有成宪，以贻子孙，子孙能谨守之，足以保天下。","book":"明·余纪登《典故纪闻》卷十"},"usage":"作谓语、定语；指开创基业，传之子孙"},{"id":8493,"word":"创业维艰","pinyin":"chuàng yè wéi jiān","abbr":"cywj","explanation":"开创事业是艰难的。","source":{"text":"古应春追随胡雪岩多年，当初创业维艰的经过大多熟悉。","book":"高阳《胡雪岩全传·灯火楼台》"},"example":{"text":"谁都明白～的道理。"},"usage":"作宾语、定语；用于处事"},{"id":8494,"word":"创剧痛深","pinyin":"chuàng jù tòng shēn","abbr":"cjts","explanation":"指创伤大、痛苦深。","source":{"text":"斯大林城市可云创剧痛深，全市无一家完整房屋。","book":"郭末若《苏联游记·七月十日》"},"similar":["创巨痛深","创深痛巨"],"usage":"作谓语、定语；用于极大的损伤和痛苦"},{"id":8495,"word":"创家立业","pinyin":"chuàng jiā lì yè","abbr":"cjly","explanation":"立业：建立事业。成立家庭，建立家业。","source":{"text":"要做一个安分守己的农民，眼下这社会正是创家立业的好时候。","book":"路遥《平凡的世界》第三卷第12章"},"similar":["成家立业"],"usage":"作谓语、宾语、定语；用于生活"},{"id":8496,"word":"创巨痛仍","pinyin":"chuàng jù tòng réng","abbr":"cjtr","explanation":"指创伤深重而悲痛长久。亦作“创钜痛仍”。","source":{"text":"创巨痛仍，号于穹旻。","book":"唐·柳宗元《寿州安丰县孝门铭》"},"example":{"text":"风停树静，空悲一命于下泉；～，长感孤生于万里。","book":"清·钱谦益《母罗氏加赠夫人制》"},"similar":["创巨痛深"],"opposite":["乐不可支"],"usage":"作谓语、定语；比喻遭受极大的损伤和痛苦"},{"id":8497,"word":"创巨痛深","pinyin":"chuāng jù tòng shēn","abbr":"cjts","explanation":"创：创伤；痛：疼痛。受了很大创伤，痛苦很深。原指哀痛父母之丧，犹如体受重创。后多比喻遭受很大的伤害和痛苦。","source":{"text":"创巨者其日久，痛甚者其愈迟；三年者，称情而立文，所以为至痛极也。","book":"《礼记·三年问》"},"example":{"text":"臣父遭遇无道，～，无以仰答明诏。","book":"南朝·宋·刘义庆《世说新语·纰漏》"},"similar":["痛不欲生","五内俱裂"],"opposite":["欣喜若狂","乐不可支"],"usage":"作谓语、定语；比喻遭受极大的损伤和痛苦"},{"id":8498,"word":"创意造言","pinyin":"chuàng yì zào yán","abbr":"cyzy","explanation":"犹立意遣词。","source":{"text":"六经之词也，创意造言，皆不相师。","book":"唐·李翱《答朱载言书》"},"example":{"text":"及其营之于口而书之于纸也，～，导气扶理，雄深骏远，瑰奇宏杰，蟠空直达，无一字不自己出。","book":"清·方东树《答叶溥求论古文书》"},"usage":"作主语、宾语、定语；用于作文等"},{"id":8499,"word":"创深痛巨","pinyin":"chuāng shēn tòng jù","abbr":"cstj","explanation":"创：创伤。创伤大，痛苦深。比喻遭受很大的伤害和痛苦。","source":{"text":"于是自己率领一群民贼来制造‘创深痛巨’，教军官放火烧城。","book":"范文澜《中国近代史》上册第三章"},"similar":["创深痛巨"],"usage":"作谓语、定语；比喻遭受极大的损伤和痛苦"},{"id":8500,"word":"创痍未瘳","pinyin":"chuāng yí wèi chōu","abbr":"cywc","explanation":"创痍：创伤；瘳：病愈，康复。比喻战后的残迹还没有复原。","source":{"text":"秦以事于胡，陈胜等起，于今创痍未瘳。","book":"《史记·季布列传》"}},{"id":8501,"word":"创钜痛仍","pinyin":"chuàng jù tòng réng","abbr":"cjtr","explanation":"指创伤深重而悲痛长久。同“创巨痛仍”。"},{"id":8502,"word":"创钜痛深","pinyin":"chuàng jù tòng shēn","abbr":"cjts","explanation":"比喻受到巨大的创伤，痛苦之极。钜。同“巨”，大。","example":{"text":"我国八年抗战～，绝不愿见帝国主义在日本复活。"}},{"id":8503,"word":"初写黄庭","pinyin":"chū xiě huáng tíng","abbr":"cxht","explanation":"黄庭：指《黄庭经》，为道家经典。恰到好处的意思。","source":{"text":"魏晋时人所写《黄庭经》帖，为后世学写小楷的范本，相传有“初写黄庭，恰到好处”之语。"},"example":{"text":"元倡如～，恰到好处，诸名士和作皆不能及。","book":"清·王士慎《带经堂诗知》卷八"}},{"id":8504,"word":"初出茅庐","pinyin":"chū chū máo lú","abbr":"ccml","explanation":"茅庐：草房。原比喻新露头脚。现比喻刚离开家庭或学校出来工作。缺乏经验。","source":{"text":"直须惊破曹公胆，初出茅庐第一功。","book":"明·罗贯中《三国演义》第三九回"},"example":{"text":"那傻小子是“～”，我们准可以扫光他！","book":"鲁迅《彷惶·高老夫子》"},"similar":["初露头角","乳臭未干","初露锋芒"],"opposite":["老成持重","老马识途"],"usage":"作谓语、宾语、定语；用于刚出道","story":["东汉末年，刘备三顾茅庐请出在河南南阳的诸葛亮作军师。曹操派大将夏侯淳领兵十万进军新野，诸葛亮派关羽、张飞领兵埋伏在博望坡一带，叫赵云、刘备引兵诱敌。夏侯淳中诸葛亮的火攻围剿计大败而逃，诸葛亮取得首场胜利"]},{"id":8505,"word":"初发芙蓉","pinyin":"chū fā fú róng","abbr":"cffr","explanation":"芙蓉：荷花。刚开放的荷花。比喻诗文清新不俗。也形容天然艳丽的女子。","source":{"text":"谢诗如芙蓉出水，颜如错彩镂金。","book":"南朝梁·钟嵘《诗品》卷中"},"example":{"text":"五言如～，自然可爱。","book":"《南史·颜延之传》"},"similar":["出水芙蓉"],"opposite":["老生常谈"],"usage":"作宾语；指新鲜的诗文或少女"},{"id":8506,"word":"初学涂鸦","pinyin":"chū xué tú yā","abbr":"cxty","explanation":"涂鸦：比喻书法拙劣或写作水平不高，涂抹修改的地方很多。形容刚开始研究学问。","source":{"text":"小子初学涂鸦，勿以友故，行辈视之也。","book":"清·蒲松龄《聊斋志异·娇娜》"}},{"id":8507,"word":"初度之辰","pinyin":"chū dù zhī chén","abbr":"cdzc","explanation":"初生之时。自称生日的意思。","source":{"text":"皇揽揆余初度兮，肇锡余以嘉名。","book":"战国·楚·屈原《离骚》"},"example":{"text":"自称生日曰～。","book":"宋·胡继宗《书言故事·庆诞类》"},"similar":["母难之日"],"usage":"作宾语；指生日"},{"id":8508,"word":"初来乍到","pinyin":"chū lái zhà dào","abbr":"clzd","explanation":"刚刚来到。","source":{"text":"行走在大城市五光十色的街道上，少平倒不像初来乍到时那般缩手缩脚。","book":"路遥《平凡的世界》第五卷第19章"},"example":{"text":"我～这里，人生地不熟。"},"opposite":["土生土长"],"usage":"作谓语、宾语；指刚刚来到"},{"id":8509,"word":"初生之犊","pinyin":"chū shēng zhī dú","abbr":"cszd","explanation":"刚出生的小牛，比喻单纯或勇猛的青年人。","source":{"text":"德将为汝美，道将为汝居，汝瞳焉如新生之犊而无求其故！","book":"先秦·庄周《庄子·知北游》"},"example":{"text":"以～的勇气，站在一切战斗的前列。","book":"夏衍《戏剧抗战三年间》"},"similar":["初生之犊不怕虎"],"usage":"作宾语；指人勇猛","story":["东汉末年，刘备利用曹操与孙权的矛盾，就命关羽率军北上，进攻襄阳与樊城。曹操派曹仁领兵出战，被关羽的部将廖化打败。庞德率军指名要与关羽决战，双方难分胜负。关羽对部下说庞德是初生之犊不怕虎，必须用计才能制伏他"]},{"id":8510,"word":"初生之犊不惧虎","pinyin":"chū shēng zhī dú bù jù hǔ","abbr":"cszdbjh","explanation":"比喻阅世不深的青年人敢说敢干，无所畏惧。","source":{"text":"俗云：‘初生之犊不惧虎。’父亲纵然斩了此人，只是西羌一小卒耳；倘有疏虞，非所以重伯父之托也。","book":"《三国演义》第七四回"},"example":{"text":"真是～，我刘国栋就是一只虎，哼，连虎也得惧我三分的！","book":"靳以《众神》"},"similar":["初生之犊不畏虎"],"opposite":["谨小慎微"],"usage":"作宾语、定语、分句；指年轻人"},{"id":8511,"word":"初生之犊不畏虎","pinyin":"chū shēng zhī dú bù wèi hǔ","abbr":"cszdbwh","explanation":"比喻阅世不深的青年人敢说敢干，无所畏惧。","source":{"text":"刚吃过早饭，人马全都汇齐，有些人震于闯王和李过的威名，不免惊惶，但有些人好像初生之犊不畏虎，磨拳擦掌地等待厮杀。","book":"姚雪垠《李自成》第一卷第十四章"},"example":{"text":"我看你二人，也真是～！","book":"粤剧《搜书院》"},"similar":["无所畏惧","初生牛犊不怕虎"],"opposite":["胆小怕事"],"usage":"作宾语、定语、分句；指年轻人","story":["东汉末年，刘备利用曹操与孙权的矛盾，就命关羽率军北上，进攻襄阳与樊城。曹操派曹仁领兵出战，被关羽的部将廖化打败。庞德率军指名要与关羽决战，双方难分胜负。关羽对部下说庞德是初生之犊不怕虎，必须用计才能制伏他"]},{"id":8512,"word":"初生牛犊不怕虎","pinyin":"chū shēng niú dú bù pà hǔ","abbr":"csndbph","explanation":"犊：小牛。刚生下来的小牛不怕老虎。比喻青年人思想上很少顾虑，敢作敢为。","source":{"text":"德将为汝美，道将为汝居，汝瞳焉如新出之犊，而无求其故。","book":"《庄子·知北游》"},"example":{"text":"天禅年方十七岁，正所谓“～”，催开战马，摇枪冲杀过来。","book":"明·许仲琳《封神演义》第七十三回"},"similar":["无所畏惧","敢作敢为"],"opposite":["胆小怕事"],"usage":"作定语、补语、分句；一般形容年轻人","story":["东汉末年，刘备利用曹操与孙权的矛盾，就命关羽率军北上，进攻襄阳与樊城。曹操派曹仁领兵出战，被关羽的部将廖化打败。庞德率军指名要与关羽决战，双方难分胜负。关羽对部下说庞德是初生之犊不怕虎，必须用计才能制伏他"]},{"id":8513,"word":"初试啼声","pinyin":"chū shì tí shēng","abbr":"csts","explanation":"本指初生婴儿啼声宏大，将来一定不凡。后也比喻音乐会歌唱者初次登台。"},{"id":8514,"word":"初试锋芒","pinyin":"chū shì fēng máng","abbr":"csfm","explanation":"比喻刚开始显示出力量或才能。","source":{"text":"他正支着腮微笑着，听参谋报告无座力炮初试锋芒的战果。","book":"魏巍《前进吧，祖国》"},"similar":["初露锋芒"],"usage":"作谓语、定语、宾语；比喻刚显露出来"},{"id":8515,"word":"初露头角","pinyin":"chū lù tóu jiǎo","abbr":"cltj","explanation":"比喻刚刚显示出能力或才干。","source":{"text":"相传洛阳牡丹在隋前还是默默无闻的，到唐朝初露头角。","book":"周得京《花城洛阳赏牡丹》"},"example":{"text":"我们这支球队～就打败了国家一级球队。"},"similar":["初露锋芒"],"usage":"作谓语；指第一次显露本事"},{"id":8516,"word":"初露锋芒","pinyin":"chū lù fēng máng","abbr":"clfm","explanation":"比喻刚开始显示出力量或才能。","source":{"text":"舒同的墨海生涯从他十四岁在乡间初露锋芒时算起，已有六十五个年头了。","book":"《人民日报》1984.2.25"},"example":{"text":"他在这次活动中只不过是～而已。"},"similar":["崭露头角","初试锋芒"],"opposite":["大器晚成"],"usage":"作谓语、定语、宾语；比喻刚显露出来"},{"id":8517,"word":"删华就素","pinyin":"shān huá jiù sù","abbr":"shjs","explanation":"放弃荣华富贵而过简朴生活。","source":{"text":"孟光（梁鸿妻）桓少君（鲍宜妻）得同心为匹，皆能删华就素，遂夫之高。","book":"明·冯梦龙《智囊补·闺智·陈子仲妻》"},"usage":"作谓语、定语；用于处事"},{"id":8518,"word":"删繁就简","pinyin":"shān fán jiù jiǎn","abbr":"sfjj","explanation":"删：除去；就：趋向。去掉繁杂部分，使它趋于简明。","source":{"text":"删繁就简三秋树，领异标新二月花。","book":"清·郑燮《楹联》"},"example":{"text":"本文内容很好，如果再～就更好了。"},"similar":["简明扼要","言简意赅"],"opposite":["拖泥带水","连篇累牍"],"usage":"作谓语、宾语；指简单化"},{"id":8519,"word":"删芜就简","pinyin":"shān wú jiù jiǎn","abbr":"swjj","explanation":"删：除去；就：趋向。去掉繁杂部分，使它趋于简明。","source":{"text":"绝句之法，要婉曲回环，删芜就简。","book":"《尚书·纬》：“删夷繁乱。”宋·严羽《历代诗话·诗法家数》"},"similar":["删繁就简","芟繁就简"],"usage":"作谓语、宾语；指简单化"},{"id":8520,"word":"判冤决狱","pinyin":"pàn yuān jué yù","abbr":"pyjy","explanation":"判：评判；决：判决；狱：案件。评判冤案，判决官司。","source":{"text":"投鼠忌器宝玉瞒赃，判冤决狱平儿行权。","book":"清·曹雪芹《红楼梦》第61回回目"},"example":{"text":"你要做一个～的好法官。"},"usage":"作谓语、定语；用于法官等"},{"id":8521,"word":"判然不同","pinyin":"pàn rán bù tóng","abbr":"prbt","explanation":"判：显然的区别。区分的清清楚楚，完全不一样。","source":{"text":"若不先见得此人，由心术上言仁，与事物上言仁，判然不同了。","book":"宋·朱熹《朱子语类》卷二十"},"example":{"text":"比五代之君，～。","book":"明·罗贯中《风云会》第二折"}},{"id":8522,"word":"判然两途","pinyin":"pàn rán liǎng tú","abbr":"prlt","explanation":"指两者有明显的区别。","source":{"text":"人之所以责官，人之所以责士，判然两途矣。","book":"明·海瑞《凡廖锦台膺首荐序》"},"example":{"text":"自经前岁战事，始悉局外空谈与局中实际，～。","book":"《清史稿·交通志一》"}},{"id":8523,"word":"判若两人","pinyin":"pàn ruò liǎng rén","abbr":"prlr","explanation":"形容某人前后的言行明显不一致，象两个人一样。","source":{"text":"须晓得柳知府于这交涉上头，本是何等通融、何等迁就；何以如今判若两人？","book":"清·李宝嘉《文明小史》第五回"},"example":{"text":"他与另三人作一献上之报告，毁左翼惟恐不至，和先前之激昂慷慨～。(《鲁迅书信集·致郑振铎》)"},"similar":["判若鸿沟","迥然不同"],"opposite":["一如既往","半斤八两"],"usage":"作谓语；形容在不同场合的表现不同"},{"id":8524,"word":"判若两途","pinyin":"pàn ruò liǎng tú","abbr":"prlt","explanation":"判：区别。指两者有明显的区别。","source":{"text":"人之所以责官，人之所以责士，判然两途矣。","book":"明·海瑞《凡廖锦台膺首荐序》"},"example":{"text":"若谓其串同土棍，则彼此～，拒之惟恐不平，避之惟恐不远。","book":"清·林则徐《覆奏查办灾赈情形折》"}},{"id":8525,"word":"判若云泥","pinyin":"pàn ruò yún ní","abbr":"pryn","explanation":"高低差别就象天上的云彩和地下的泥土那样悬殊。","source":{"text":"夫子歘通贵，云泥相望悬。","book":"唐·杜甫《送韦书记赴西安》诗"},"example":{"text":"今见老兄有志竟成，转战千里，为民除害，旧时同学今已～。","book":"茅盾《霜叶红于二月花·续稿》"},"similar":["判若天渊"],"opposite":["相差无几"],"usage":"作谓语、定语；指相差悬殊"},{"id":8526,"word":"判若天渊","pinyin":"pàn ruò tiān yuān","abbr":"prty","explanation":"高低差别就象天空和深渊那样悬殊。","source":{"text":"不过用心于一两字间，斟酌而出，即判若天渊，个中分寸所争，毫厘千里。","book":"清·朱庭珍《筱园诗话》"},"example":{"text":"弄堂里的叫卖声，说也奇怪，竟也和古代～。","book":"鲁迅《且介亭杂文·弄堂生意古今谈》"},"similar":["判若云泥","天差地别","截然不同"],"opposite":["大同小异","相去无几","等量齐观"],"usage":"作谓语；指相差悬殊"},{"id":8527,"word":"判若水火","pinyin":"pàn ruò shuǐ huǒ","abbr":"prsh","explanation":"判：区别。比喻两者显然相反，互不相容。","source":{"text":"沈归愚宗伯与袁简斋太史论诗，判若水火。","book":"清·钱泳《履园丛话·谭诗·总论》"},"example":{"text":"若各存意见，则依附之小人，遂至妄为揣摩，群相附和，渐至～。","book":"《清朝野史大观》卷三"},"similar":["水火不容","截然不同"],"opposite":["水乳交融"],"usage":"作谓语、定语；指水火不容"},{"id":8528,"word":"判若鸿沟","pinyin":"pàn ruò hóng gōu","abbr":"prhg","explanation":"判：区别；鸿沟：古代运河，在今河南省，秦末是楚汉分界的一条河，比喻事物的界线。形容界限很清楚，区别很明显。","source":{"text":"项羽恐，乃与汉王约，中分天下，割鸿沟而西者为汉，鸿沟而东者为楚。","book":"《史记·高祖本纪》"},"example":{"text":"从此之后，中国文坛新旧的界限，～。","book":"鲁迅《伪自由书·后记》"},"similar":["判若黑白"],"usage":"作谓语；形容界限很清楚，区别很明显"},{"id":8529,"word":"判若黑白","pinyin":"pàn ruò hēi bái","abbr":"prhb","explanation":"判：区别。像黑白那样区分得清清楚楚。形容界限清楚，不易混淆。","source":{"text":"夫文之高下雅俗，判若黑白，学者犹安于习见，而莫知别择。","book":"清·方苞《书祭裴太常文后》"},"example":{"text":"唐肃宗未奉明皇之命，今殿下系亲受皇上之命，～，岂可混同。","book":"清·夏敬渠《野叟曝言》第一百十四回"},"similar":["黑白分明"],"opposite":["黑白不分"],"usage":"作谓语、定语；形容界限分明"},{"id":8530,"word":"刨树搜根","pinyin":"páo shù sōu gēn","abbr":"pssg","explanation":"比喻追究底细。","source":{"text":"至于列公，听这部书，也不过逢场作戏，看这部书，也不过走马观花。真个的，还把有用精神置之无用之地，费这闲心去刨树搜根不成？","book":"清·文康《儿女英雄传》第二十三回"},"similar":["追根溯源"],"usage":"作谓语、宾语、定语；用于探究问题"},{"id":8531,"word":"刨根究底","pinyin":"páo gēn jiū dǐ","abbr":"pgjd","explanation":"比喻追究底细。同“刨根问底”。","source":{"text":"我从来不喜欢打听姑娘们的事，也懒得为此去刨根究底。","book":"《收获》1981年第4期"},"similar":["刨根问底"],"usage":"作谓语、定语；比喻追究底细"},{"id":8532,"word":"刨根问底","pinyin":"páo gēn wèn dǐ","abbr":"pgwd","explanation":"比喻追究底细。","source":{"text":"一辆汽车碰在一株老树上，并没伤人……谁能刨根问底的要证据。","book":"老舍《老张的哲学》第三二"},"example":{"text":"你～，是啥意思？你既不是治安组长，又不是民兵队长！","book":"柳青《创业史》第一部第九章"},"similar":["寻根究底","刨根究底","盘根问底"],"usage":"作谓语、定语；比喻追究底细"},{"id":8533,"word":"利不亏义","pinyin":"lì bù kuī yì","abbr":"lbky","explanation":"有利在前，能够不亏损正义。","source":{"text":"委之以货财，淹之以乐好，见利不亏义。","book":"《礼记·儒行》"},"similar":["见利思义"],"opposite":["见利忘义"],"usage":"作宾语、定语；用于处事"},{"id":8534,"word":"利令志惛","pinyin":"lì lìng zhì zào","abbr":"llzh","explanation":"因贪图私利而失去理智，把什么都忘了。同“利令智昏”。","source":{"text":"及至利到跟前，就把‘害’字忘了，所谓‘利令志惛’能不浩叹！","book":"《镜花缘》第九二回"}},{"id":8535,"word":"利令智惛","pinyin":"lì lìng zhì hūn","abbr":"llzh","explanation":"利：利益，私利；令：使；智：理智。形容因贪图私利而失去理智。","source":{"text":"心以利倾，智以势惛。","book":"《晋书·王沉传》"},"example":{"text":"及至利到跟前，就把‘害’字忘了，所谓‘～’，能不浩叹！","book":"清·李汝珍《镜花缘》第92回"},"similar":["利令智昏"],"opposite":["见利思义"],"usage":"作谓语、定语；指贪财"},{"id":8536,"word":"利令智昏","pinyin":"lì lìng zhì hūn","abbr":"llzh","explanation":"令：使；智：理智；昏：昏乱，神智不清。因贪图私利而失去理智，把什么都忘了。","source":{"text":"鄙谚曰：‘利令智昏。’平原君（赵胜）负冯亭邪说，使赵陷长平四十余万众，邯郸几亡。","book":"《史记·平原君虞卿列传》"},"example":{"text":"独苦国人无识者，～，则不免受其饵矣。","book":"章炳麟《敬告对待间谍者》"},"similar":["见利忘义","利欲熏心","利令智惛"],"opposite":["见利思义","舍生取义"],"usage":"作谓语、定语；指贪财","story":["公元前262年，秦昭王派大将白起率军攻打韩国，秦军攻占了野王。上党守将冯亭将上党奉献给赵国换取保护，赵孝成王听信平原君赵胜的意见接纳了上党，结果秦昭王派白起进攻赵国，在长平歼灭赵军40万。司马迁评论平原君是利令智昏"]},{"id":8537,"word":"利以平民","pinyin":"lì yǐ píng mín","abbr":"lypm","explanation":"平：治理。用对百姓有利的事情，来治理百姓。"},{"id":8538,"word":"利傍倚刀","pinyin":"lì bàng yǐ dāo","abbr":"lbyd","explanation":"倚：靠着。“利”的偏旁是刀字，意指追求私利犹如倚在刀口上。比喻贪利常得祸。","source":{"text":"甘瓜抱苦蒂，美枣生荆棘，利傍有倚刀，贪人还自贼。","book":"《古诗源·古诗二首》"},"usage":"作宾语、定语；用于比喻句"},{"id":8539,"word":"利出一孔","pinyin":"lì chū yī kǒng","abbr":"lcyk","explanation":"给予利禄赏赐只有一条途径，那是从事耕战。","source":{"text":"利出一孔，则国多物。","book":"《管子·国蓄》：“利出于一孔者，其国无敌。”《商君书·弱民》"},"example":{"text":"为国之道，～者王，二孔者强，三孔者弱，四孔者亡。","book":"《新唐书·柳冲传》"},"usage":"作宾语、定语；用于书面语"},{"id":8540,"word":"利利索索","pinyin":"lì lì suǒ suǒ","abbr":"llss","explanation":"干脆利落。","source":{"text":"可是他又听爱云说，润叶还没有利利索索答应这门亲事。","book":"路遥《平凡的世界》第二卷第39章"},"example":{"text":"她办事～的，招人喜爱。"},"similar":["干脆利落"],"usage":"作定语、状语；用于处事"},{"id":8541,"word":"利口喋喋","pinyin":"lì kǒu dié dié","abbr":"lkdd","explanation":"喋喋：形容说话多。能言善辩，滔滔不绝。","source":{"text":"夫绛侯、东阳侯称为长者，此两人言事曾不能出口，岂效此啬夫喋喋利口捷给哉。","book":"《史记·张释之列传》"}},{"id":8542,"word":"利口巧辞","pinyin":"lì kǒu qiǎo cí","abbr":"lkqc","explanation":"利口：锋利的口才；巧辞：善于言辞。形容能言善辩。","source":{"text":"子贡利口巧辞。","book":"《史记·仲尼弟子列传》"}},{"id":8543,"word":"利口捷给","pinyin":"lì kǒu jié jǐ","abbr":"lkjj","explanation":"给：言辞敏捷。能说会道、言辞敏捷、善于应对。","source":{"text":"夫绛侯、东阳侯称为长者，此两人言事曾不能出口，岂敩此啬夫谍谍利口捷给哉。","book":"《史记·张释之冯唐列传》"},"similar":["伶牙俐齿","巧舌如簧"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；用于书面语"},{"id":8544,"word":"利口辩给","pinyin":"lì kǒu biàn jǐ","abbr":"lkbg","explanation":"利口：锋利的口才。形容能言善辩。","source":{"text":"夫绛侯、东阳侯称为长者，此两人言事曾不能出口，岂效此啬夫喋喋利口捷给哉。","book":"《史记·张释之列传》"},"example":{"text":"你这不过是～，强词夺理罢了。","book":"清·吴趼人《痛史》第二十一回"}},{"id":8545,"word":"利喙赡辞","pinyin":"lì huì shàn cí","abbr":"lhsc","explanation":"指口齿伶俐，辞令优美。","source":{"text":"睹其利喙赡辞，不觉前席。","book":"唐·皇甫枚《三水小牍·王知古》"},"similar":["伶牙俐齿"],"usage":"作谓语、宾语；指人口才好"},{"id":8546,"word":"利害得失","pinyin":"lì hài dé shī","abbr":"lhds","explanation":"好处和坏处，得益和损失。","source":{"text":"我虽然素有是志，可恨自己学问太浅，不能够把那利害得失，详详密密说将出来，感动大众，所以稽延至今，甚为憾事。","book":"清·岭南羽衣女士《东欧豪杰传》第四回"},"example":{"text":"这其中的～你是最清楚的。"},"similar":["成败得失"],"usage":"作主语、宾语；用于劝诫人"},{"id":8547,"word":"利害攸关","pinyin":"lì hài yōu guān","abbr":"lhyg","explanation":"利害所关。指有密切的利害关系。","source":{"text":"周知其利害。","book":"《周礼·夏宫·职方氏》"},"example":{"text":"解决环境污染问题，是与人民健康～的一件大事。"},"similar":["利害相关"],"opposite":["互不相干"],"usage":"作谓语、定语、宾语；指有密切的利害关系"},{"id":8548,"word":"利害相关","pinyin":"lì hài xiāng guān","abbr":"lhxg","explanation":"利害：好处和害处；关：相关。指有密切的利害关系。","source":{"text":"周知其利害。","book":"《周礼·夏宫·职方氏》"},"example":{"text":"平时酒杯往来如兄若弟；一虱大的事，才有些～，便尔我不相顾了。","book":"明·冯梦龙《喻世明言·吴保安弃家赎友》"},"similar":["利害攸关"],"usage":"作谓语、宾语；指有密切的利害关系"},{"id":8549,"word":"利尽交疏","pinyin":"lì jìn jiāo shū","abbr":"ljjs","explanation":"到了无利可图的时候交情就疏远了。","source":{"text":"语有之：‘以权利合者，权利尽而交疏’，甫瑕是也。","book":"《史记·郑世家》"}},{"id":8550,"word":"利己损人","pinyin":"lì jǐ sǔn rén","abbr":"ljsr","explanation":"为了使自己得到好处而损害别人利益。参见“损人利己”。","source":{"text":"深耕浅种尚有天灾，利己损人岂无果报。","book":"宋·陈元靓《事林广记·警世格言》"},"example":{"text":"宋·陈元靓《事林广记·警世格言》：“深耕浅种尚有天灾，利己损人岂无果报。”"},"similar":["损人利己"],"opposite":["大公无私"],"usage":"作谓语、宾语、定语；指损害别人"},{"id":8551,"word":"利市三倍","pinyin":"lì shì sān bèi","abbr":"lssb","explanation":"利市：利润；三倍：几倍。形容买卖得到的利润极多。","source":{"text":"为近利，市三倍。","book":"《周易·说卦》"},"example":{"text":"《周易·说卦》：“为近利，市三倍。”"},"usage":"作谓语、定语；形容买卖得到的利润极多"},{"id":8552,"word":"利惹名牵","pinyin":"lì rě míng qiān","abbr":"lrmq","explanation":"指为名利所诱惑羁绊。亦作“利绾名牵”。","source":{"text":"相当年利惹名牵。","book":"元·张可久《湘妃怨·乐闲》曲"},"similar":["利绾名牵"],"usage":"作宾语、定语；用于书面语"},{"id":8553,"word":"利时及物","pinyin":"lì shí jí wù","abbr":"lsjw","explanation":"指救世济物。","source":{"text":"幸以古人自勉，以利时及物为己任，俾孤陋者有所企效而取法焉。","book":"明·方孝孺《与卢编修希鲁书》"},"usage":"作宾语、定语；用于书面语"},{"id":8554,"word":"利析秋毫","pinyin":"lì xī qiū háo","abbr":"lxqh","explanation":"析：分析；秋毫：鸟兽在秋天新长出的细毛。形容管理财务极细心、精明。","source":{"text":"故三人言利，事析秋毫矣。","book":"《史记·平准书》"},"example":{"text":"又有一个桑弘羊，尤工心计，～，初为大农中丞，嗣迁治粟都尉。","book":"蔡东藩《前汉演义》第七十回"},"usage":"作谓语；指很细心"},{"id":8555,"word":"利欲熏心","pinyin":"lì yù xūn xīn","abbr":"lyxx","explanation":"贪财图利的欲望迷住了心窍。","source":{"text":"利欲熏心，随人翕张，国好骏马，尽为王良。","book":"宋·黄庭坚《赠别李次翁》诗"},"example":{"text":"故凡进此阵内，为其蛊惑，若稍操持不定，～，无不心荡神迷，因而失据。","book":"清·李汝珍《镜花缘》第一百回"},"similar":["唯利是图","见利忘义"],"opposite":["克己奉公","大公无私"],"usage":"作谓语、定语、分句；指惟利是图"},{"id":8556,"word":"利深祸速","pinyin":"lì shēn huò sù","abbr":"lshs","explanation":"获利愈多，灾祸来得愈快。","source":{"text":"任重道悠，利深祸速。","book":"《后汉书·皇后纪上》"},"example":{"text":"虽邪正殊途，而咸至诛戮，岂非时艰政紊，～者乎！","book":"《晋书·张方传》"},"usage":"作宾语、定语；用于处事"},{"id":8557,"word":"利灾乐祸","pinyin":"lì zāi lè huò","abbr":"lzlh","explanation":"见到别人遭受灾祸反而高兴。","source":{"text":"至晚，北兵绕山后薄赣军，尹玉当之。曾全、胡遇、谢云、曾玉先遁走，尹玉死焉。张提军隔岸，不发一矢，有利灾乐祸之心。","book":"宋·文天祥《吊五木》诗序"},"similar":["幸灾乐祸"],"usage":"作谓语、定语、状语；指人缺乏善意"},{"id":8558,"word":"利用厚生","pinyin":"lì yòng hòu shēng","abbr":"lyhs","explanation":"利用：尽物之用；厚：富裕；生：民众。充分发挥物的作用，使民众富裕。","source":{"text":"正德，利用，厚生，惟和。","book":"《尚书·大禹漠》"},"example":{"text":"科学的基本要求是～，为人民服务。","book":"郭沫若《学术工作展望》"},"usage":"作谓语、宾语；充分发挥物的作用，使民众富"},{"id":8559,"word":"利益均沾","pinyin":"lì yì jūn zhān","abbr":"lyjz","explanation":"有好处，大家都有一份。指平等合理地取得各自应有的利益。","source":{"text":"以各用法律治本国人民、特援最惠国利益均沾之例载入约中，迄未行。","book":"《清史稿·邦交志》"},"example":{"text":"还包括瑞典、挪威、奥地利、意大利，都来谋求“～”。","book":"霍达《补天裂》第五章"}},{"id":8560,"word":"利绾名牵","pinyin":"lì wǎn míng qiān","abbr":"lwmq","explanation":"指为名利所诱惑羁绊。同“利惹名牵”。","source":{"text":"一举螯头，再婚牛氏。利绾名牵竟不归。","book":"明·高明《琵琶记·副末开场》"},"similar":["利惹名牵"],"usage":"作宾语、定语；用于书面语"},{"id":8561,"word":"利缰名锁","pinyin":"lì jiāng míng suǒ","abbr":"ljms","explanation":"缰：缰绳。锁：锁链。名和利像缰绳和锁链一样把人束缚住了。","source":{"text":"向此免名缰利锁，虚费光阴。","book":"汉·东方朔《与友人书》：“不可使尘网名韁拘锁，怡然长笑。”宋·柳永《夏云峰》词"},"example":{"text":"～休贪恋，韶华迅速如流箭。","book":"元·王喆《转调丑奴儿》"},"similar":["利锁名缰"],"usage":"作谓语、宾语、定语；比喻名利束缚人"},{"id":8562,"word":"利诱威胁","pinyin":"lì yòu wēi xié","abbr":"lywx","explanation":"利诱：用利益诱惑；威胁：恐吓。形容软硬兼施，使别人顺从。","source":{"text":"但是他们经不起帝国主义的利诱威胁。","book":"陶菊隐《北洋军阀统治时期史话》第68章"},"example":{"text":"我能抵御他们的～。"},"similar":["软硬兼施"],"opposite":["软硬不吃"],"usage":"作谓语、宾语、定语；指软硬兼施"},{"id":8563,"word":"利路名场","pinyin":"lì lù míng chǎng","abbr":"llmc","explanation":"名场：旧指读书人求功名的场所。泛指寻求名利的道路和竞夺声名的场所。","source":{"text":"教我无为礼乐拘，利路名场名忌讳。","book":"唐·李咸用《临川逢陈百年》"},"example":{"text":"～多忌讳，松声草色共忘机。","book":"唐·徐寅《韵沩山》"}},{"id":8564,"word":"利锁名牵","pinyin":"lì suǒ míng qiān","abbr":"lsmq","explanation":"牵：牵制。名和利就象锁链一样把人牵制束缚住了。","source":{"text":"向此免名缰利锁，虚费光阴。","book":"汉·东方朔《与友人书》：“不可使尘网名韁拘锁，怡然长笑。”宋·柳永《夏云峰》词"},"example":{"text":"眼底天涯，～；一曲离歌，三迭阳光。","book":"明·高濂《玉簪记·促试》"}},{"id":8565,"word":"利锁名缰","pinyin":"lì suǒ míng jiāng","abbr":"lsmj","explanation":"比喻名利束缚人就象缰绳和锁链一样。","source":{"text":"向此免名缰利锁，虚费光阴。","book":"宋·柳永《夏云峰》词"},"example":{"text":"再休被～相缠住。","book":"元·范子安《竹叶舟》第一折"},"similar":["名缰利锁"],"usage":"作谓语、宾语；比喻名利束缚人"},{"id":8566,"word":"利齿伶牙","pinyin":"lì chǐ líng yā","abbr":"lcly","explanation":"伶：通“灵”，灵活，乖巧。能说会道。","source":{"text":"你休听那厮说短论长，那般的利齿伶牙。","book":"元·张国宾《合汗衫》第二折"},"example":{"text":"不要长枪大剑，真个杀人手段高强；生得～，端的吃人脑髓不恕。","book":"明·陆采《明珠记·奸谋》"},"similar":["利齿能牙","伶牙俐齿"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语、状语；指人口才好"},{"id":8567,"word":"利齿能牙","pinyin":"lì chǐ néng yá","abbr":"lcny","explanation":"口齿伶俐，能说会道。","source":{"text":"这妮子使着呵，早妆聋做哑。泼贱才，堪人骂，再休来利齿能牙。","book":"元·张寿卿《红梨花》第一折"},"similar":["伶牙俐齿"],"opposite":["笨嘴拙舌"],"usage":"作谓语、宾语；指人口才好"},{"id":8568,"word":"别作一眼","pinyin":"bié zuò yī yǎn","abbr":"bzyy","explanation":"指另眼（相看）。","source":{"text":"柴长者是个豪富的人，他贪图相士道郭威他日做天子，别作一眼觑他。","book":"《新编五代史平话·周史》卷上"}},{"id":8569,"word":"别作良图","pinyin":"bié zuò liáng tú","abbr":"bzlt","explanation":"另作好的打算。","source":{"text":"愿陛下纳秦宓金石之言，以养士卒之力，别作良图，则社稷幸甚！天下幸甚！","book":"明·罗贯中《三国演义》第八十一回"},"example":{"text":"我和你去姜丞相报知所以，令他～，宁死刀下，庶几减少此不忠不智之罪。","book":"明·许仲琳《封神演义》第四十五回"},"similar":["别作他图"],"usage":"作谓语、宾语；用于处事"},{"id":8570,"word":"别具一格","pinyin":"bié jù yī gé","abbr":"bjyg","explanation":"别：另外。另有一种独特的风格。","source":{"text":"别：另外。另有一种独特的风格。"},"example":{"text":"这个画家的人物画拙中见巧，～。"},"similar":["标新立异","别开生面","别有风味"],"opposite":["如出一辙","千篇一律","依样葫芦"],"usage":"作谓语、定语；用于文学、艺术、书法等"},{"id":8571,"word":"别具匠心","pinyin":"bié jù jiàng xīn","abbr":"bjjx","explanation":"匠心：巧妙的心思。指在技巧和艺术方面具有与众不同的巧妙构思。","source":{"text":"文不按古，匠心独妙。","book":"唐·王士源《孟浩然集序》"},"example":{"text":"《蕃锦集》运用成语，～。","book":"清·陈廷焯《白雨斋词话》"},"similar":["别具一格","匠心独运","独辟蹊径"],"opposite":["拾人牙慧","老生常谈","平淡无奇"],"usage":"作谓语、定语；同“独具匠心、匠心独运”"},{"id":8572,"word":"别具只眼","pinyin":"bié jù zhī yǎn","abbr":"bjzy","explanation":"具有独到的眼光和见解。比喻有独到的见解。","source":{"text":"近来别具一只眼，要踏唐人最上关。","book":"宋·杨万里《送彭元忠县丞北归》诗"},"example":{"text":"然而陈克明教授之所以能～，最主要的原因还在黄梦英有一位“表亲”乔张。","book":"茅盾《清明前后》"},"similar":["别具慧眼"],"opposite":["人云亦云"],"usage":"作谓语、定语；指见解独特"},{"id":8573,"word":"别具心肠","pinyin":"bié jù xīn cháng","abbr":"bjxc","explanation":"指另有打算和企图。","source":{"text":"全国抗日高潮必然要走向抗战。……唯独蒋介石先生别具心肠，硬要在日寇进攻绥东之际，拒绝东北军请缨抗日，强迫张学良、杨虎城两将军继续进行内战。","book":"周恩来《在延安各界举行的“双十二”纪念会上的讲演》"},"similar":["别有肺肠"],"usage":"作谓语、定语；指另有打算"},{"id":8574,"word":"别具慧眼","pinyin":"bié jù huì yǎn","abbr":"bjhy","explanation":"慧：聪明，有才智。具有独到眼光，高明的见解。","source":{"text":"（杨万里）又有《送彭元忠》诗：‘近来别具一只眼，要踏唐人最上关。’","book":"宋·叶寘《爱日斋丛钞》"},"example":{"text":"他～，一眼就看出她的企图。"},"similar":["远见卓识","自出机杼"],"opposite":["人云亦云","拾人牙慧"],"usage":"作谓语、定语、宾语；比喻具有独到的眼光"},{"id":8575,"word":"别具手眼","pinyin":"bié jù shǒu yǎn","abbr":"bjsy","explanation":"指具有独到的眼光和手法。","source":{"text":"德水于杜，别具手眼。","book":"清·钱谦益《序》"},"example":{"text":"他在这个问题上～。"},"similar":["别出手眼"],"usage":"作谓语、定语；指人有手段"},{"id":8576,"word":"别具炉锤","pinyin":"bié jù lú chuí","abbr":"bjlc","explanation":"炉锤：冶炼锻造的工具。形容具有独特的造诣。","source":{"text":"妙在从君实口角中讨出神情，此于移商换羽外，别具锤炉，即在元曲，亦称上乘。","book":"明·祁彪佳《远山堂品·妙品·独乐园》"},"example":{"text":"笔墨间无非香气，町畦外～。","book":"清·龚炜《巢林笔谈续编·陆孙评湖山记游》"},"similar":["别具一格"],"usage":"作谓语、定语；指文章或艺术品等"},{"id":8577,"word":"别具肺肠","pinyin":"bié jù fèi cháng","abbr":"bjfc","explanation":"比喻人动机不良，故意提出一些与众不同的的奇特的主张。","source":{"text":"自有肺肠，俾民卒狂。","book":"《诗经·大雅·桑柔》"},"example":{"text":"那老太太却～，非但不惊不吓，还要赶到房里，把席面扫个一空，骂了个无了无休。","book":"清·吴趼人《二十年目睹之怪现状》第七十七回"},"similar":["别有肺肠"],"usage":"作谓语、定语；用于处事"},{"id":8578,"word":"别出心裁","pinyin":"bié chū xīn cái","abbr":"bcxc","explanation":"别：另外；心裁：心中的设计、筹划。另有一种构思或设计。指想出的办法与众不同。","source":{"text":"今别出心裁，不依旧样，或特标于目外，或叠采于回中。","book":"明·李贽《水浒全书发凡》"},"example":{"text":"只好～，鼓吹女人自杀。","book":"鲁迅《坟·我之节烈观》"},"similar":["别开生面","标新立异","独出心裁"],"opposite":["千篇一律","鹦鹉学舌","如法炮制"],"usage":"作谓语、定语、状语；表示与众不同的新观念"},{"id":8579,"word":"别出手眼","pinyin":"bié chū shǒu yǎn","abbr":"bcsy","explanation":"指具有独到的眼光和手法。","source":{"text":"卓吾所著书，于上下数千年之间，别出手眼，在思想界上势力甚大。","book":"郑振铎《插图本中国文学史》第六章二"},"similar":["别具手眼"],"usage":"作谓语、定语；用于人的见解"},{"id":8580,"word":"别出新意","pinyin":"bié chū xīn yì","abbr":"bcxy","explanation":"指独创一格，与众不同。","source":{"text":"大抵所利不能补其所伤，所得不能偿其所亡，徒欲别出新意，以自为功名耳。","book":"宋·司马光《与王介甫书》"},"example":{"text":"泰西诸国，研精器数，创造火轮舟车……又于古圣新制车舟外，～，以夺造化之工。","book":"清·薛福成《代李伯相议请试办铁路疏》"},"similar":["别出心裁","标新立异"],"opposite":["老生常谈","习以为常"],"usage":"作谓语、定语、宾语；指与众不同"},{"id":8581,"word":"别出新裁","pinyin":"bié chū xīn cái","abbr":"bcxc","explanation":"别：另外；裁：安排取舍。独创一格，与众不同","source":{"text":"敖继公释《仪礼》，屏弃古注，别出新裁。","book":"清·顾观光《武陵山人杂著·杂说》"},"similar":["别出心裁"],"usage":"作谓语、定语、状语；表示与众不同"},{"id":8582,"word":"别出机杼","pinyin":"bié chū jī zhù","abbr":"bcjz","explanation":"别：另外；机杼：织布机，比喻诗文的构思和布局。指写作另辟途径，能够创新。","source":{"text":"文章须自出机杼，成一家风骨。","book":"《魏书·祖莹传》"},"example":{"text":"词人务以相胜，似不若别出机杼。","book":"宋·楼钥《跋李伯和所藏书画薄薄酒二篇》"},"similar":["别出心裁","别具一格"],"usage":"作补语、定语；形容思维独特"},{"id":8583,"word":"别创一格","pinyin":"bié chuàng yí gé","abbr":"bcyg","explanation":"指开创一种新的风格或形式。","source":{"text":"仅存的三首，从内容来说，实在是别创一格。","book":"郭沫若《李白与杜甫·杜甫与苏涣》"},"similar":["别开一格","自成一家"],"usage":"作谓语、定语；指自成一家"},{"id":8584,"word":"别别扭扭","pinyin":"biè biè niǔ niǔ","abbr":"bbnn","explanation":"说话、作文不通顺，彼此意见不投合。亦指争执之事。","source":{"text":"最后实在躲不过去，胀红了脸，别别扭扭，声音还没蚊子大地叫了一声。","book":"王朔《过把瘾就死》"},"example":{"text":"他们觉得在一起总是～的。"},"opposite":["顺顺当当"],"usage":"作定语、状语；指不顺畅"},{"id":8585,"word":"别妇抛雏","pinyin":"bié fù pāo chú","abbr":"bfpc","explanation":"别：离别；妇：妻子；抛：丢下；雏：幼儿。离别妻子，丢下幼儿。"},{"id":8586,"word":"别居异财","pinyin":"bié jū yì cái","abbr":"bjyc","explanation":"指另立门户，各蓄家产。","source":{"text":"清·薛福成《出使四国日记·光绪十六年十二月初十日》；“子既娶妇，与父母别居异财，甚者不相闻问。”"},"similar":["别籍异财","别籍异居"],"usage":"作谓语、定语；指兄弟、父子等分家"},{"id":8587,"word":"别开一格","pinyin":"bié kāi yí gé","abbr":"bkyg","explanation":"指开创一种新的风格或形式。","source":{"text":"是役事迹，冯自由同志之《开国前革命史》已将大略记录，故本篇别开一格。将当日香港《中国日报》纪录及由各方面采集之资料，详细排叙，不厌求详。","book":"陈春华《丙午萍醴起义记》"},"similar":["别创一格"],"usage":"作谓语、定语；指自成一家"},{"id":8588,"word":"别开生面","pinyin":"bié kāi shēng miàn","abbr":"bksm","explanation":"生面：新的面目。原意是凌烟阁里的功臣画像本已褪色，经曹将军重画之后才显得有生气。比喻另外创出一种新的形式或局面。","source":{"text":"凌烟功臣少颜色，将军下笔开生面。","book":"唐·杜甫《丹青诗》"},"example":{"text":"今日林妹妹这五首诗，亦可谓命意新奇，～了。","book":"清·曹雪芹《红楼梦》第六十四回"},"similar":["面目一新","别具一格"],"opposite":["规行矩步","千篇一律"],"usage":"作谓语、定语；形容不同一般","story":["唐代著名画家曹霸特别擅长画人物和马，唐玄宗经常召他进宫作画，因为他为唐朝24位开国功臣的肖像重新绘制，被封为左武卫将军。安史之乱后，曹霸流落到成都靠替人画像为生，杜甫特为他作诗：“凌烟功臣少颜色，将军下笔开生面。”"]},{"id":8589,"word":"别开蹊径","pinyin":"bié kāi xī jìng","abbr":"bkxj","explanation":"另辟新路；独创一格。","source":{"text":"同时也更富有革新精神，突破旧韵书的束缚，别开蹊径，编制了一部具有革命意义的《中原音韵》。","book":"赵诚《中国古代韵书》第六章"},"example":{"text":"他～，自成一家。"},"similar":["别辟蹊径"],"opposite":["墨守成规"],"usage":"作谓语、定语；指标新立异"},{"id":8590,"word":"别张一军","pinyin":"bié zhāng yī jūn","abbr":"bzyj","explanation":"张：设立；军：军队。另外建立一支军队。也比喻另外开辟新的领域。"},{"id":8591,"word":"别径奇道","pinyin":"bié jìng qí dào","abbr":"bjqd","explanation":"别径：小道。旧指军事上不被敌人发现的奇径小道。","source":{"text":"车贵知地形，骑贵知别径奇道。","book":"《六韬·犬韬·战车》"}},{"id":8592,"word":"别恨离愁","pinyin":"bié hèn lí chóu","abbr":"bhlc","explanation":"分离前后惜别、相思的愁苦情绪。","source":{"text":"离情别恨多少，条条结向垂杨缕。","book":"五代·毛熙震《临江仙》词：“几回偷看寄来书，离情别恨，相隔欲何如。”宋·欧阳修《梁州令》"},"example":{"text":"～，满肺腑难掏泄。","book":"清·刘鹗《老残游记·自序》"}},{"id":8593,"word":"别抱琵琶","pinyin":"bié bào pí pá","abbr":"bbpp","explanation":"指改嫁。亦指移情他人。","source":{"text":"故人情重，实不忍别抱琵琶。","book":"清·纪昀《阅微草堂笔记·槐西杂志四》"},"example":{"text":"归至横水洋，陡遇飓风，六舟尽没，无一生者。家中诸妇闻之，瓜分所有，均～去。","book":"清·陈其元《庸闲斋笔记·盐枭行劫》"},"similar":["琵琶别抱","移情别恋"],"opposite":["从一而终"],"usage":"作谓语、定语；用于女性"},{"id":8594,"word":"别无二致","pinyin":"bié wú èr zhì","abbr":"bwez","explanation":"指区分不出两者的差别。","source":{"text":"江西境内的风物，太平淡无奇了。这儿和长江沿岸所见到的别无二致。","book":"郭沫若《海涛集·徐家埠》"},"example":{"text":"两件作品～，让人难以区分。"},"similar":["完全一致"],"usage":"作谓语、定语；指完全相同"},{"id":8595,"word":"别无他物","pinyin":"bié wú tā wù","abbr":"bwtw","explanation":"除此之外没有多余的东西。同“别无长物”。","source":{"text":"伯桃视之，止有一塌，塌上堆积书卷，别无他物。","book":"明·冯梦龙《喻世明言》第七卷"},"example":{"text":"偌大的个戏台，空空洞洞，～，看了不觉有些好笑。","book":"清·刘鹗《老残游记》第二回"},"similar":["别无长物"],"opposite":["应有尽有"],"usage":"作谓语、定语；形容贫困"},{"id":8596,"word":"别无出路","pinyin":"bié wú chū lù","abbr":"bwcl","explanation":"指除了某一种解决问题的方法外，没有其他办法。","source":{"text":"现在是～，只好如此。"},"example":{"text":"现在是～，只好如此"},"similar":["别无它法"],"usage":"作谓语、宾语；指唯一方法"},{"id":8597,"word":"别无它法","pinyin":"bié wú tā fǎ","abbr":"bwtf","explanation":"没有任何别的办法。","example":{"text":"～，只好立马去请医生。"},"similar":["别无出路","别无他法"],"usage":"作谓语、分句；指只好如此"},{"id":8598,"word":"别无所求","pinyin":"bié wú suǒ qiú","abbr":"bwsq","explanation":"其他什么要求也没有。","similar":["一无所求"],"opposite":["欲壑难填"]},{"id":8599,"word":"别无选择","pinyin":"bié wú xuǎn zé","abbr":"bwxz","explanation":"没有别的选择余地。","source":{"text":"除此之外，危难中的双水村别无选择。","book":"路遥《平凡的世界》第一卷第26章"},"example":{"text":"现在，我们～，只有拼搏到底。"},"similar":["别无他法","仅此而已"],"usage":"作谓语、分句；指只好如此"},{"id":8600,"word":"别无长物","pinyin":"bié wú cháng wù","abbr":"bwcw","explanation":"长物：多余的东西。除一身之外再没有多余的东西。原指生活俭朴。现形容贫穷。","source":{"text":"丈人不悉恭，恭作人无长物。","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"他们除双手外，～，其经济地位和产业工人相似。","book":"毛泽东《中国社会各阶级的分析》"},"similar":["空空如也","软囊羞涩","家徒四壁"],"opposite":["一应俱全","应有尽有","腰缠万贯"],"usage":"作谓语、定语；形容贫困","story":["东晋时读书人王恭生活俭朴，不图享受，他随父亲从会稽来到都城建康，他的朋友王忱去看望他，两人相谈甚欢，王忱觉得身下的竹席很好，王恭就转手相送，自己改用草席。王忱得知后过意不去，王恭说：“吾平生无长物。”"]},{"id":8601,"word":"别易会难","pinyin":"bié yì huì nán","abbr":"byhn","explanation":"分别容易，相会却难。常用来表示不忍离别的深情或别后的无限思念。","source":{"text":"别易会难，古人所重。","book":"北齐·颜之推《颜氏家训·风操篇》"}},{"id":8602,"word":"别有人间","pinyin":"bié yǒu rén jiān","abbr":"byrj","explanation":"犹别有天地。","source":{"text":"清凉山之畔，竹径数转，别有人间。","book":"清·卓发之《裓园嫘史》诗序"},"similar":["别有天地"],"usage":"作谓语、宾语、定语；用于风景或艺术创作等"},{"id":8603,"word":"别有企图","pinyin":"bié yǒu qǐ tú","abbr":"byqt","explanation":"另外有别的打算或谋划。","example":{"text":"他这样做是～的。"},"similar":["别有用心"],"usage":"作谓语、宾语；用于处事等"},{"id":8604,"word":"别有匠心","pinyin":"bié yǒu jiàng xīn","abbr":"byjx","explanation":"别：独特的；匠心：巧妙的心思。构思巧妙，与众不同。","example":{"text":"这篇文章～，有其独到的观点。"},"similar":["别具匠心"],"opposite":["老生常谈"],"usage":"作谓语、定语；同“独具匠心”"},{"id":8605,"word":"别有天地","pinyin":"bié yǒu tiān dì","abbr":"bytd","explanation":"天地：境界。比喻另有一番境界。形容风景或艺术创作的境界引人入胜。","source":{"text":"桃花流水窅然去，别有天地非人间。","book":"唐·李白诗《山中问答》"},"example":{"text":"出了山洞口，只见小桥流水，竹篱茅舍，真是～。"},"similar":["别有洞天","引人入胜","流连忘返"],"opposite":["索然寡味"],"usage":"作谓语、宾语、定语；用于风景或艺术创作等","story":["唐朝著名诗人李白爱好剑术，轻财仗义，25岁那年出外远游，漫游了湖南、江苏等地。42岁那年被唐玄宗授官，但他不想当朝廷的御用文人，3年后辞官归隐，特作诗：“问余何意栖碧山，笑而不答心自闲，桃花流水窅然去，别有天地非人间。”"]},{"id":8606,"word":"别有天地非人间","pinyin":"bié yǒu tiān dì fēi rén jiān","abbr":"bytdfrj","explanation":"天地：境界。比喻另有一番境界。形容风景或艺术创作的境界引人入胜。","source":{"text":"桃花流水窅然去，别有天地非人间。","book":"唐·李白《山中问答》诗"},"example":{"text":"如入瑯環福地，痴龙护门，人迹罕到，大父称之谓～也。","book":"明·张岱《快园记》"},"similar":["别有天地"],"usage":"作谓语、定语、宾语；指另有一番境界","story":["唐朝著名诗人李白爱好剑术，轻财仗义，25岁那年出外远游，漫游了湖南、江苏等地。42岁那年被唐玄宗授官，但他不想当朝廷的御用文人，3年后辞官归隐，特作诗：“问余何意栖碧山，笑而不答心自闲，桃花流水窅然去，别有天地非人间”"]},{"id":8607,"word":"别有心肝","pinyin":"bié yǒu xīn gān","abbr":"byxg","explanation":"指另有打算和企图。犹别有肺肠。","source":{"text":"尽管你那么说，我总以为做标金做公债的人们别有心肝！","book":"茅盾《子夜》三"},"similar":["别有肺肠"],"usage":"作谓语；指另有打算"},{"id":8608,"word":"别有心肠","pinyin":"bié yǒu xīn cháng","abbr":"byxc","explanation":"指另有打算和企图。犹别有肺肠。","source":{"text":"可是一班别有心肠的人们，便竭力来阻遏它，要使孩子的世界中，没有一丝乐趣。","book":"鲁迅《朝花夕拾·》"},"example":{"text":"鲁迅《朝花夕拾·》：“可是一班～的人们，便竭力来阻遏它，要使孩子的世界中，没有一丝乐趣。”"},"similar":["别有肺肠","别有用心"],"usage":"作谓语、定语；指另有想法"},{"id":8609,"word":"别有洞天","pinyin":"bié yǒu dòng tiān","abbr":"bydt","explanation":"洞中另有一个天地。形容风景奇特，引人入胜。","source":{"text":"桃花流水窅然去，别有天地非人间。","book":"唐·李白《山中问答》诗"},"example":{"text":"各处尽是画栋雕梁，珠帘绮户，那派艳丽光景，竟是～。","book":"清·李汝珍《镜花缘》第九十八回"},"similar":["别有天地"],"usage":"作谓语、定语；形容另有一种境界"},{"id":8610,"word":"别有滋味","pinyin":"bié yǒu zī wèi","abbr":"byzw","explanation":"原意是另有一种别人无法体会的离愁别恨的滋味，指亡国之痛。后泛指文学艺术的情调、意蕴另有种动人的美感和趣味。","source":{"text":"剪不断，理还乱，是离愁，别是一番滋味在尽头。","book":"南唐·李煜《乌夜啼》词"},"example":{"text":"会场空气本尴尬，经此一事，益觉～矣！（朱自清《异邦之行日记》）"},"similar":["别有风味"],"usage":"作谓语、定语；用于人的心情或事物等"},{"id":8611,"word":"别有用心","pinyin":"bié yǒu yòng xīn","abbr":"byyx","explanation":"用心：居心，打算。心中另有算计。指言论或行动另有不可告人的企图。","source":{"text":"方别寻得一头绪，似差简约端的，始终文字语言之处，真别有用心处。","book":"宋·朱熹《与刘子澄书》"},"example":{"text":"王太尊也是说他办事可靠，那里知道他是～的呢。","book":"清·吴趼人《二十年目睹之怪现状》第九十九回"},"similar":["居心叵测","包藏祸心","心怀叵测"],"opposite":["襟怀坦白","光明磊落","光明正大"],"usage":"作谓语、定语、宾语；用于处事"},{"id":8612,"word":"别有肺肠","pinyin":"bié yǒu fèi cháng","abbr":"byfc","explanation":"别有：另有；肺肠：指思想。比喻人动机不良，故意提出一些与众不同的的奇特的主张。","source":{"text":"自有肺肠，俾民卒狂。","book":"《诗经·大雅·桑柔》"},"example":{"text":"那老太太却～，非但不惊不吓，还要赶到房里，把席面扫个一空，骂了个无了无休。","book":"清·吴趼人《二十年目睹之怪现状》第七十七回"},"similar":["别具肺肠","另有所图"],"usage":"作谓语、定语；用于另有所图"},{"id":8613,"word":"别有风味","pinyin":"bié yǒu fēng wèi","abbr":"byfw","explanation":"风味：原指美好的口味，引伸为事物的特色。另有一种美好的口味。比喻事物所另外具有的特殊色彩或趣味。","source":{"text":"此时只觉四处焦香扑鼻，倒也别有风味。","book":"清·李汝珍《镜花缘》第五回"},"example":{"text":"酣眠固不可少，小睡也～的。","book":"朱自清《荷塘月色》"},"similar":["地方风味","家乡风味","别饶风趣"],"opposite":["千篇一律","如出一辙"],"usage":"作谓语、定语；用于事物"},{"id":8614,"word":"别有风趣","pinyin":"bié yǒu fēng qù","abbr":"byfq","explanation":"形容事物（多指文艺作品）具有特殊的情调或趣味。","source":{"text":"损之此幅，别有风趣，反恐清言未必臻此。","book":"清·周亮工《读画录·张损之》"},"similar":["别有风味"],"opposite":["枯燥乏味"],"usage":"作谓语、定语；多指文艺作品"},{"id":8615,"word":"别来无恙","pinyin":"bié lái wú yàng","abbr":"blwy","explanation":"恙：病。分别以来一直都很好吗？常用作别后通信或重逢时的问候语。","source":{"text":"莺莺坐夫人之侧，生问曰：‘别来无恙否？’莺莺不言而心会。","book":"金·董解元《西厢记》卷四"},"example":{"text":"公瑾～？”（明·罗贯中《三国演义》第四十五回","book":"（蒋）干曰"},"usage":"作谓语、分句；用作别后通信或重逢时问候"},{"id":8616,"word":"别树一帜","pinyin":"bié shù yī zhì","abbr":"bsyz","explanation":"树：立；帜：旗帜。比喻另创一家或另创局面。","source":{"text":"元、白在唐朝所以能独树一帜者，正为其不袭盛唐窠臼也。","book":"清·袁枚《随园诗话》卷三"},"example":{"text":"Gastev是主张善用时间，～的，本集只收了一幅。","book":"鲁迅《集外集拾遗·〈新俄画选〉小引》"},"similar":["独树一帜","独辟蹊径","标新立异"],"opposite":["亦步亦趋","千篇一律","如出一辙"],"usage":"作谓语、定语；形容另创局面，自成一家"},{"id":8617,"word":"别树一旗","pinyin":"bié shù yī qí","abbr":"bsyq","explanation":"比喻与众不同，加成一家。","source":{"text":"唐义山、香山、牧之、昌黎，同学杜者；今年内其诗集，都有是别树一旗。","book":"清·袁枚《随园诗话》卷七"},"similar":["别树一帜"],"usage":"作谓语、定语；指另创局面"},{"id":8618,"word":"别生枝节","pinyin":"bié shēng zhī jié","abbr":"bszj","explanation":"比喻另起事端或平添麻烦。","source":{"text":"现在人心皆惑，稍一宣扬，诚恐别生枝节，当遵谕格外秘密。","book":"中国近代史资料丛刊《辛亥革命·徐锡麟安庆起义清方档案》"},"example":{"text":"我前信的所谓‘怕闹出麻烦’，先生误会了意思，我是说怕刊物因为我而～。","book":"鲁迅《书信集·致陶亢德》"},"similar":["横生枝节"],"usage":"作谓语、宾语；指意外事件"},{"id":8619,"word":"别籍异居","pinyin":"bié jí yì jū","abbr":"bjyj","explanation":"指另立门户，彼此分居。","source":{"text":"法律禁止兄弟在父母生存时别籍异居……朝廷宁愿放免丁役，不许无故析户分居。","book":"范文澜蔡美彪等《中国通史》第三编第二章第四节"},"similar":["别籍异财"],"usage":"作谓语、定语；指兄弟、父子等分家"},{"id":8620,"word":"别籍异财","pinyin":"bié jí yì cái","abbr":"bjyc","explanation":"指另立门户，各蓄家产。","source":{"text":"诸祖父母、父母在而子孙别籍异财者，徒三年。","book":"《唐律·户婚》"},"example":{"text":"诏川陕诸州，察民有父母在而～者，论死。","book":"《宋史·太祖纪二》"},"similar":["别籍异居","别财异居"],"usage":"作谓语、定语；指兄弟、父子等分家"},{"id":8621,"word":"别类分门","pinyin":"bié lèi fān mén","abbr":"blfm","explanation":"按一定标准分成门类。参见“分门别类”。","source":{"text":"将江浙许多穷老名士，养在家中，寻章摘句，别类分门，凑成各样新书刻板出卖。","book":"清·蒋士铨《临川梦·隐奸》"},"similar":["分门别类"],"opposite":["杂乱无章"],"usage":"作谓语、状语；指按事物性质分类"},{"id":8622,"word":"别置一喙","pinyin":"bié zhì yī huì","abbr":"bzyh","explanation":"插一句嘴。比喻提出不同意见。","source":{"text":"此等书不知出于何伧之手，乃托文章巨公之名，以诳世之聋瞽。人家子弟，辄奉以为圣经贤传，不敢别置一喙，闻人出一议，辄摇手闭目，以为侮圣人之言。","book":"清·刘献廷《广阳杂记》卷四"},"opposite":["人云亦云"],"usage":"作谓语；指不加评论"},{"id":8623,"word":"别财异居","pinyin":"bié cái yì jū","abbr":"bcyj","explanation":"指各蓄家产，另立门户。","source":{"text":"癸亥，诏：荆蜀民祖父母、父母在者，子孙不得别财异居。","book":"《宋史·太祖纪二》"},"similar":["别籍异财"],"usage":"作谓语、定语；指兄弟、父子等分家"},{"id":8624,"word":"别风淮雨","pinyin":"bié fēng huái yǔ","abbr":"bfhy","explanation":"这是“列风淫雨”的误写，因“别”和“列”、“淮”与“淫”字殂相似。后称书籍中因错别字而以讹传讹为“别风淮雨”。","source":{"text":"《尚书大传》有‘别风淮雨’，……云‘列风淫雨’。‘别’‘列’‘淮’‘淫’，字似潜移。‘淫’‘列’，义当而不奇，‘淮’‘别’。","book":"南朝·梁·刘勰《文心雕龙·练字》"},"example":{"text":"《周书·王会》‘东越海盒’，或误为‘侮食’，而王元长《曲水诗序》用之，其‘～’之类乎？","book":"宋·王应麟《困学纪闻》第19卷"},"similar":["鲁鱼帝虎"],"usage":"作宾语、定语、分句；比喻故意写错字求新意"},{"id":8625,"word":"别饶风致","pinyin":"bié ráo fēng zhì","abbr":"brfz","explanation":"别有一番风趣。","example":{"text":"这地方山清水秀，～。"},"similar":["别有风味"],"usage":"作谓语、定语；指风景或文章等"},{"id":8626,"word":"别鹤孤鸾","pinyin":"bié hè gū luán","abbr":"bhgl","explanation":"别：离别；鸾：凤凰一类的鸟。离别的鹤，孤单的鸾。比喻远离的夫妻。","source":{"text":"上弦惊别鹤，下弦操孤鸾。","book":"三国魏·稽康《琴赋》：“王昭、楚妃，千里别鹤。”晋·陶潜《拟古》诗"},"similar":["别鹤离鸾"],"usage":"作主语、宾语、定语；指离散的夫妻"},{"id":8627,"word":"别鹤离鸾","pinyin":"bié hè lí láun","abbr":"bhll","explanation":"比喻离散的夫妻。","source":{"text":"君百计营求，归吾妻子，恒耿耿不忘。今君别鹤离鸾，自合为君料理。","book":"清·纪昀《阅微草堂笔记·槐西杂志四》"},"similar":["别鹤孤鸾"],"usage":"作主语、宾语、定语；指离散的夫妻"},{"id":8628,"word":"刬恶锄奸","pinyin":"chǎn è chú jiān","abbr":"cecj","explanation":"铲除凶恶奸邪之人。","source":{"text":"他杀人污佛地，我救苦下云端，刬恶锄奸。","book":"《儿女英雄传》第十回"}},{"id":8629,"word":"刬旧谋新","pinyin":"chǎn jiù móu xīn","abbr":"cjmx","explanation":"犹除旧图新。革除旧的，谋求新的。","source":{"text":"范仲淹入参宰政，富弼继秉枢轴。二人以天下之务为己任，谓朝政因循日久，庶事隳敝，志欲刬旧谋新，振兴时治，其气锐不可折。","book":"宋·田况《儒林公议》卷上"}},{"id":8630,"word":"刬草除根","pinyin":"chǎn cǎo chú gēn","abbr":"cccg","explanation":"犹斩草除根。比喻除去祸根，以免后患。","source":{"text":"为国家者，见恶，如农夫之务去草焉，芟夷蕰崇之，绝其本根，勿使能殖。","book":"语出《左传·隐公六年》"},"example":{"text":"半世连枝带叶，算从前，历尽虚花，一朝～，到此际方成结果。","book":"明·陶宗仪《辍耕录连枝秀》"}},{"id":8631,"word":"刮刮杂杂","pinyin":"guā guā zá zá","abbr":"ggzz","explanation":"形容火势旺盛的样子。","source":{"text":"林冲跳起身来，就壁缝里看时，只见草料场里火起，刮刮杂杂地烧着。","book":"明·施耐庵《水浒传》"},"similar":["刮刮匝匝","刮刮拶拶"],"usage":"作定语、状语；用于书面语"},{"id":8632,"word":"刮地以去","pinyin":"guā dì yǐ qù","abbr":"gdyq","explanation":"把地皮都刮走了。比喻贪官污吏千方百计地搜刮人民的财产。","source":{"text":"马瘠士饥死，刺史不弃毫发恤吾急，今刮地以去，吾等何望。","book":"《新唐书·程晔传》"},"usage":"作谓语、定语；用于贪官等"},{"id":8633,"word":"刮地皮","pinyin":"guā dì pí","abbr":"gdp","explanation":"比喻贪官污吏千方百计地搜刮人民的财产。","source":{"text":"马瘠士饥死，刺史不弃毫发恤吾急，今刮地以去，吾等何望。","book":"《新唐书·程日华传》"},"example":{"text":"这些老爷们平时～，都是发财发足的了。","book":"清·李宝嘉《官场现形记》第二十一回"},"similar":["刮地以去"],"usage":"作谓语、定语；指搜刮人民的财产"},{"id":8634,"word":"刮垢磨光","pinyin":"guā gòu mó guāng","abbr":"ggmg","explanation":"刮去污垢，磨出光亮。比喻使事物重显光辉。也比喻仔细琢磨，精益求精。","source":{"text":"占小善者率以录，名一艺者无不庸，爬罗剔抉，刮垢磨光盖有幸而获选，孰云多而不扬？","book":"唐·韩愈《劝学解》"},"example":{"text":"暗想小生莹窗雪案，～，学成满腹文章。","book":"元·王实甫《西厢记》第一本第一折"},"usage":"作谓语；比喻使事物重显光辉"},{"id":8635,"word":"刮垢磨痕","pinyin":"guā gòu mó hén","abbr":"ggmh","explanation":"涤除污垢，磨除伤痕。比喻仔细琢磨，精益求精。","source":{"text":"贵文则丧质，近质则太秃，刮垢磨痕，卒不能到史。","book":"唐·孙樵《与高锡望书》"},"similar":["刮垢磨光"],"usage":"作谓语、宾语、定语；用于做事"},{"id":8636,"word":"刮摩淬励","pinyin":"guā mó cuì lì","abbr":"gmcl","explanation":"刮摩：磋商，磨炼兵器。比喻在学术上商讨研究，刻苦钻研。","source":{"text":"仍幡然有志于为己之学，刮摩淬励，日长月益。","book":"《元史·吴师道传》"}},{"id":8637,"word":"刮楹达乡","pinyin":"guā yíng dá xiāng","abbr":"gydx","explanation":"楹：堂屋前部的柱子；乡：窗户。用密石磨柱，使精细有光泽，每室四户八窗，使光亮通达。指宽敞华丽的屋子。","source":{"text":"复庙重檐，刮楹达乡。","book":"《礼记·明堂位》"}},{"id":8638,"word":"刮毛龟背","pinyin":"guā máo guī bèi","abbr":"gmgb","explanation":"想从乌龟的背上刮下毛来。比喻事情难以办到。","source":{"text":"刮毛龟背上，何晨得成毡？","book":"宋·苏轼《东坡》"},"example":{"text":"往事回头尽黯然，～不成毡。","book":"邓雅声《口号·简漱渠》"},"usage":"作宾语、定语；用于处事"},{"id":8639,"word":"刮目相待","pinyin":"guā mù xiāng dài","abbr":"gmxd","explanation":"刮目：擦眼睛，表示用新眼光看人。比喻去掉旧日的看法，用新的眼光来看待人或事物。","source":{"text":"士别三日，即更刮目相待。","book":"《三国志·吴志·吕蒙传》注引《江表传》"},"example":{"text":"君举亦甚别，皆应～。","book":"宋·陈亮《与吴益恭安抚书》"},"similar":["刮目相看","拭目以待"],"opposite":["视同一律"],"usage":"作谓语、宾语；用于取得显著成绩","story":["三国时期，东吴能武不能文的武将吕蒙听了孙权的劝告后，发奋读书。一段时间后，都督鲁肃来视察吕蒙的防地。吕蒙就对蜀防备的事情讲得有条有理，还写份建议书给鲁肃，鲁肃很惊讶。吕蒙说道：“士别三日，就要刮目相看。”"]},{"id":8640,"word":"刮目相看","pinyin":"guā mù xiāng kàn","abbr":"gmxk","explanation":"指别人已有进步，不能再用老眼光去看他。","source":{"text":"士别三日，即更刮目相待。","book":"《三国志·吴志·吕蒙传》注引《江表传》"},"example":{"text":"世界也～，东亚病夫居然奋起了，睡狮果然醒了。","book":"朱自清《这一天》"},"similar":["另眼相看","另眼看待"],"opposite":["视同一律"],"usage":"作谓语、宾语；用于取得显著成绩","story":["三国时期，东吴能武不能文的武将吕蒙听了孙权的劝告后，发奋读书。一段时间后，都督鲁肃来视察吕蒙的防地。吕蒙就对蜀防备的事情讲得有条有理，还写份建议书给鲁肃，鲁肃很惊讶。吕蒙说道：“士别三日，就要刮目相看。”"]},{"id":8641,"word":"刮目相见","pinyin":"guā mù xiāng jiàn","abbr":"gmxj","explanation":"比喻去掉旧日的看法，用新的眼光来看待人或事物。同“刮目相待”。","source":{"text":"士别三日，刮目相见。况时阅数载，诸君较昔当必长足之进步矣。","book":"蔡元培《就任北京大学校长之演说》"},"similar":["刮目相看","刮目相待","刮目而视"],"usage":"作谓语、宾语；用于取得显著成绩"},{"id":8642,"word":"刮目而视","pinyin":"guā mù ér shì","abbr":"gmes","explanation":"刮目：擦拭眼睛，指去掉老看法。去掉旧的看法，用新眼光去看待。","source":{"text":"田老兄那么亲切的拍着他的膀膊道：‘士三日不见，当刮目而视，吾子有焉！’","book":"李脃人《暴风雨前》第五部分"},"similar":["刮目相看","刮目相待","刮目相见"],"usage":"作谓语、宾语；用于取得显著成绩"},{"id":8643,"word":"刮肠洗胃","pinyin":"guā cháng xǐ wèi","abbr":"gcxw","explanation":"比喻痛改前非，重新做人。","source":{"text":"若许某自新，必吞刀刮肠，饮灰洗胃。","book":"《南史·荀伯玉传》"},"similar":["刮腹湔肠"],"usage":"作谓语、宾语；指重新做人"},{"id":8644,"word":"刮腹湔肠","pinyin":"guā fù jiān cháng","abbr":"gfjc","explanation":"腹：肚子；湔：洗。剖开肚子清洗肠子。比喻痛改前非。","source":{"text":"若许某自新，必吞刀刮肠，饮灰洗胃。","book":"《南史·荀伯玉传》"},"example":{"text":"不晓要怎样改头换面，～，才能博得美人欢心。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十六回"},"similar":["刮肠洗胃"],"usage":"作谓语、宾语；指重新做人"},{"id":8645,"word":"刮野扫地","pinyin":"guā yě sǎo dì","abbr":"gysd","explanation":"大风吹扫野地。比喻杀获无余。","source":{"text":"言杀获皆尽，野地似乎扫刮也。","book":"《文选·扬雄〈羽猎赋〉》：“鸟不及飞，兽不得过。军惊师骇，刮野扫地。”李善注"},"usage":"作宾语、定语；用于比喻句"},{"id":8646,"word":"刮骨去毒","pinyin":"guā gǔ qù dú","abbr":"ggqd","explanation":"刮去深入至骨的毒性，彻底医治。比喻从根本上解决问题。","source":{"text":"矢镞有毒，毒入于骨，当破肩作创，刮骨去毒，然后此患乃除耳。","book":"《三国志·蜀志·关羽传》"},"usage":"作谓语、定语；指从根本上解决问题"},{"id":8647,"word":"刮骨吸髓","pinyin":"guā gǔ xī suǐ","abbr":"ggxs","explanation":"刮开骨头来吸骨髓。比喻剥削压迫极其残酷。","example":{"text":"～的贪官污吏实在可恶。"},"similar":["敲骨吸髓"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":8648,"word":"刮骨抽筋","pinyin":"guā gǔ chōu jīn","abbr":"ggcj","explanation":"比喻极力搜刮、榨取民财。","source":{"text":"清室二百七十余年间的统治在官场中已经凝集成了一个牢不可破的贪婪恶习。一般的官府均以贪赃枉法为能，在上的鬻爵收贿，在下的刮骨抽筋。‘官官相卫’，让你受苦的民间硬是呼天无路，吁地无门。","book":"郭沫若《反正前后》第二篇四"},"similar":["敲骨吸髓"],"usage":"作谓语、宾语、定语；用于贪官污吏等"},{"id":8649,"word":"到什么山上唱什么歌","pinyin":"dào shén me shān shàng chàng shén me gē","abbr":"dsmsscsmg","explanation":"比喻按照实际情况变化而做出相应的变化。","source":{"text":"俗话说：‘到什么山上唱什么歌。’……我们无论做什么事都要看情形办理，文章和演说也是这样。","book":"毛泽东《反对党八股》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":8650,"word":"到处碰壁","pinyin":"dào chù pèng bì","abbr":"dcpb","explanation":"比喻遇受阻碍或遭到拒绝。也指事情行不通或达不到目的。","example":{"text":"我这几天～，真是流年不利。"},"similar":["四处碰壁","六面碰壁"],"usage":"作谓语、定语、状语；用于人的处境"},{"id":8651,"word":"到此为止","pinyin":"dào cǐ wéi zhǐ","abbr":"dcwz","explanation":"以这里为界限。","example":{"text":"我们的友谊就～。"},"usage":"作谓语、分句；指到这里为止"},{"id":8652,"word":"刳形去皮","pinyin":"kū xíng qù pí","abbr":"kxqp","explanation":"指忘却形体和家国，而任乎自然。"},{"id":8653,"word":"刳心雕肾","pinyin":"kū xīn diāo shèn","abbr":"kxds","explanation":"犹言刻骨铭心。表示强烈的情感。"},{"id":8654,"word":"刳精呕血","pinyin":"kū jīng ǒu xuè","abbr":"kjox","explanation":"极言用心劳苦。同“刳精鉥心”。"},{"id":8655,"word":"刳精鉥心","pinyin":"kū jīng jiū xīn","abbr":"kjsx","explanation":"极言用心劳苦。"},{"id":8656,"word":"刳肝沥胆","pinyin":"kū gān lì dǎn","abbr":"kgld","explanation":"犹言披肝沥胆。比喻竭诚相见。","source":{"text":"烦读圣听至于四五，刳肝沥胆，盈卷溢幅。","book":"宋·司马光《辞修起居注第五状》"},"similar":["披肝沥胆"],"usage":"作谓语、定语、状语；指说真心话"},{"id":8657,"word":"刳胎杀夭","pinyin":"kū tāi shā yāo","abbr":"ktsy","explanation":"指凶残不义。同“刳胎焚夭”。","source":{"text":"刳胎杀夭则麒麟不至郊，竭泽涸渔则蛟龙不合阴阳，覆巢毁卵则凤凰不翔。","book":"西汉·司马迁《史记·孔子世家》"},"example":{"text":"～，麒麟不游，覆巢毁卵，凤凰不翔。","book":"西汉·刘安《淮南子·本经训》"},"similar":["刳胎焚夭"],"usage":"作宾语、定语；用于为人"},{"id":8658,"word":"刳胎焚夭","pinyin":"kū tāi fén yāo","abbr":"ktfy","explanation":"剖挖母胎，残害幼体。指凶残不义。","source":{"text":"夫士不可妄致也，覆巢破卵，则凤凰不至焉；刳胎焚夭，则麒麟不往矣。","book":"《尸子·明堂》"},"example":{"text":"臣闻之，有巢毁卵，而凤凰不翔；～，而麒麟不至。","book":"《战国策·赵策四》"},"similar":["刳胎杀夭"],"usage":"作谓语、宾语、定语；用于残暴的人"},{"id":8659,"word":"刳脂剔膏","pinyin":"kū zhī tī gāo","abbr":"kztg","explanation":"比喻残酷地剥削。","example":{"text":"在旧社会，由于地主豪绅无休止的～，人民的生活十分困苦。"}},{"id":8660,"word":"制锦操刀","pinyin":"zhì jǐn cāo dāo","abbr":"zjcd","explanation":"比喻出仕从政。","source":{"text":"遂使纡青拖紫，非以学优，制锦操刀，类多墙面。","book":"《隋书·炀帝纪上》"}},{"id":8661,"word":"刺上化下","pinyin":"cì shàng huà xià","abbr":"cshx","explanation":"讽谕国君，教化下民。"},{"id":8662,"word":"刺举无避","pinyin":"cì jǔ wú bì","abbr":"cjwb","explanation":"刺举：侦察揭发；避：回避。侦察揭发不法行为，不回避权势。形容敢于同坏人坏事做斗争。","source":{"text":"擢为司隶校尉，刺举无所回避。","book":"《汉书·盖宽饶传》"}},{"id":8663,"word":"刺促不休","pinyin":"cì cù bù xiū","abbr":"ccbx","explanation":"刺促：劳碌、繁忙。繁忙劳碌，不肯停息。旧多用于形容勤于公务。","source":{"text":"和峤刺促不得休。","book":"南朝·宋·刘义庆《世说新语·政事》：“山公以器重朝望。”注引王隐《晋书》"}},{"id":8664,"word":"刺刺不休","pinyin":"cì cì bù xiū","abbr":"ccbx","explanation":"刺刺：多话的样子。形容说话唠叨，没完没了。","source":{"text":"持被入直三省，丁宁顾婢子，语刺刺不能休。","book":"唐·韩愈《送殷员外序》"},"example":{"text":"你只听他昨日那一片“但行好事，莫问前程”的话，也不怕人厌，～，就知他素日行为之谬。","book":"清·李汝珍《镜花缘》第八十四回"},"similar":["唠唠叨叨","喋喋不休"],"opposite":["言简意赅"],"usage":"作谓语；形容多言的样子"},{"id":8665,"word":"刺心切骨","pinyin":"cì xīn qiè gǔ","abbr":"cxqg","explanation":"指内心极其悲愤。","source":{"text":"古今人臣死于忠，未有如臣父之惨烈也。臣之痛愤，刺心切骨，何时可已。","book":"明·于晃《乞恩疏》"},"example":{"text":"他们的是非，往往和我们的颠倒。往往我们所以为～的，他们却雍容谈笑的不理。","book":"冰心《寄小读者》"},"similar":["刺心刻骨"],"usage":"作谓语、定语；用于人的内心"},{"id":8666,"word":"刺心刻骨","pinyin":"cì xīn kè gǔ","abbr":"cxkg","explanation":"①犹刻骨铭心。指感念至深。②亦作“刺心切骨”。内心极其悲愤。","source":{"text":"遵教及此，直是刺心刻骨，弟诚多言矣。","book":"清·陈确《答恽促升书》"},"example":{"text":"他们的是非，往往和我们的颠倒。往往我们所以为～的，他们却雍容谈笑的不理。","book":"冰心《寄小读者》六"},"similar":["铭心刻骨","刺心切骨"],"usage":"作谓语、定语、状语；指印象深刻"},{"id":8667,"word":"刺心裂肝","pinyin":"cì xīn liè gān","abbr":"cxlg","explanation":"指悲痛至极。","source":{"text":"三十年生死之交，一旦遂成永隔，刺心裂肝，痛何可言。","book":"明·张居正《答参军高梅庵》"},"usage":"作谓语、定语；用于心痛"},{"id":8668,"word":"刺股悬头","pinyin":"cì gǔ xuán tóu","abbr":"cgxt","explanation":"形容刻苦学习。同“刺股悬梁”。","source":{"text":"孙敬字文宝，好学，晨夕不休，及至眠睡疲寝，以绳系头，悬屋梁。","book":"《战国策·秦策一》：“（苏秦）读书欲睡，引锥自刺其股。”《太平御览》卷三百六十三引《汉书》"},"example":{"text":"萱堂淑贤齐孟母，谆谆教子读诗书。～曾努力，引光夜凿匡衡壁。","book":"元·柯丹丘《荆钗记·会讲》"}},{"id":8669,"word":"刺股悬梁","pinyin":"cì gǔ xuán liáng","abbr":"cgxl","explanation":"形容刻苦学习。","source":{"text":"孙敬字文宝，好学，晨夕不休，及至眠睡疲寝，以绳系头，悬屋梁。","book":"西汉·刘向《战国策·秦策》：“秦读书欲睡，引锥自刺其股。”东汉·班固《汉书》"},"example":{"text":"从今后～，专心致义献光明，雁塔争看姓字扬。","book":"清·袁于令《西楼记·检课》"},"similar":["悬梁刺骨","秉烛夜读"],"opposite":["不学无术"],"usage":"作谓语、定语、状语；形容勤奋苦读","story":["汉朝时儒学大师孙敬小时候读书十分刻苦，经常读到深夜，怕自己睡着就把头发用绳子系在屋梁上。战国时纵横家苏秦到秦国游说失败，为博取功名就发愤读书，每天读书到深夜，每当要打瞌睡时，他就用铁锥子刺一下大腿来提神"]},{"id":8670,"word":"刺股读书","pinyin":"cì gǔ dú shū","abbr":"cgds","explanation":"比喻刻苦攻读。","source":{"text":"（苏秦）读书欲睡，引锥自刺其股。","book":"《战国策·秦策一》"}},{"id":8671,"word":"刺虎持鹬","pinyin":"cì hǔ chí yù","abbr":"chcy","explanation":"比喻待机行事，一举两得。","source":{"text":"《战国策·秦策二》及《史记·张仪列传》载：刺虎，战国时，陈畛说秦惠王，引卞庄子刺虎为喻，先待齐楚交战，乘其两败俱伤时进兵。持鹬，用“鹬蚌相持”之典。"},"example":{"text":"臣是以反复于前代以蛮攻蛮之成效，而知～，功在乘时。固不在勤天之力以求之也。","book":"清·魏源《圣武记》卷六"},"similar":["鹬蚌相争，渔翁得利"],"usage":"作宾语、定语；用于书面语"},{"id":8672,"word":"刺骨悬梁","pinyin":"cì gǔ xuán liáng","abbr":"cgxl","explanation":"悬梁：以绳子系头挂在屋梁上。形容刻苦学习。","source":{"text":"可怜刺骨悬梁志，险作离乡背井魂。","book":"元·王实甫《西厢记》第二本第三折"},"similar":["刺股悬梁"],"usage":"作谓语、定语、状语；形容勤奋苦读"},{"id":8673,"word":"刻不可缓","pinyin":"kè bù kě huǎn","abbr":"kbkh","explanation":"刻：片刻；缓：延缓，耽搁。比喻情势紧迫，一刻也不允许拖延","source":{"text":"这是刻不可缓的时候，还要拿死人取笑哩。","book":"清·李百川《绿野仙踪》第60回"},"similar":["刻不容缓"],"usage":"作谓语、定语、状语；形容非常紧迫"},{"id":8674,"word":"刻不容松","pinyin":"kè bù róng sōng","abbr":"kbrs","explanation":"片刻也不能松懈。","source":{"text":"犹恐内海匪船，潜赴外洋勾结，是杜绝售私之劲，实属刻不容松。","book":"清·林则徐《体察洋面堵截情形析》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":8675,"word":"刻不容缓","pinyin":"kè bù róng huǎn","abbr":"kbrh","explanation":"刻：指短暂的时间；缓：延迟。指形势紧迫，一刻也不允许拖延。","source":{"text":"帝王即位，即是好日，兼官历又吉，何疑？事不容缓。","book":"宋·周密《齐东野语》"},"example":{"text":"胎前产后以及难产各症，不独～，并且两命攸关。","book":"清·李汝珍《镜花缘》第四十回"},"similar":["迫不及待","火烧眉毛","迫在眉睫"],"opposite":["绰绰有余","悠闲自得"],"usage":"作谓语、定语、状语；形容非常紧迫"},{"id":8676,"word":"刻不待时","pinyin":"kè bù dài shí","abbr":"kbds","explanation":"谓时间紧迫。","source":{"text":"刻不待时遭大祸，叫我三人那里奔。","book":"《天雨花》第21回"},"similar":["刻不容缓"],"usage":"作定语、状语；用于处事"},{"id":8677,"word":"刻己自责","pinyin":"kè jǐ zì zé","abbr":"kjzz","explanation":"严格要求自己，能够自我批评。","source":{"text":"归咎于身，刻己自责。","book":"《汉书·杜周传》附杜钦"}},{"id":8678,"word":"刻意求工","pinyin":"kè yì qiú gōng","abbr":"kyqg","explanation":"工：精致、完好。用尽心思使文章或工艺品更精巧。","source":{"text":"此等词语浅情深，妙在字句之表，便觉刻意求工，是无端多费气力。","book":"清·况周颐《蕙风词话》第二卷"},"example":{"text":"他写文章～、一丝不苟。"},"opposite":["敷衍塞责"],"usage":"作谓语、宾语；指用尽心思写文章或做工艺品"},{"id":8679,"word":"刻意经营","pinyin":"kè yì jīng yíng","abbr":"kyjy","explanation":"刻意：用尽心思；经营：计划管理。指用心筹画。","source":{"text":"此事定须霞思云想，刻意经营，奈何颓唐落墨，便布人间？","book":"清·王晫《今世说·规箴》"},"similar":["苦心经营"],"usage":"作谓语；指用心筹划"},{"id":8680,"word":"刻木为吏","pinyin":"kè mù wéi lì","abbr":"kmwl","explanation":"意思是不能受狱吏的污辱，即使是木头做的狱吏也不能见他。形容狱吏的凶暴可畏。","source":{"text":"刻木为吏，期不对。","book":"《汉书·司马迁传》：“故士有画地为牢势不入，削木为吏议不对，定计于鲜也。”《汉书·路温舒传》"},"example":{"text":"画地为狱议不入，～期不对。","book":"宋·王楙《野客丛书·汉狱吏不恤》"},"similar":["削木为吏"],"usage":"作谓语；形容狱吏的凶暴可畏"},{"id":8681,"word":"刻木为鹄","pinyin":"kè mù wéi hú","abbr":"kmwh","explanation":"比喻仿效虽不逼真，但还相似。","source":{"text":"扬氏《法言》、王氏《中说》，所谓刻木为鹄者也。","book":"明·郑瑗《井观琐言》第一卷"},"similar":["刻鹄类鹜"],"usage":"作宾语、定语；用于比喻句"},{"id":8682,"word":"刻楮功巧","pinyin":"kè chǔ gōng qiǎo","abbr":"kcgq","explanation":"楮：一种树木。比喻技艺巧妙高超。","source":{"text":"宋人有为其君以象为楮叶者，三年而成。丰杀茎柯，毫芒繁泽，乱之楮叶之中而不可别也。","book":"《韩非子·喻老》"}},{"id":8683,"word":"刻烛成诗","pinyin":"kè zhú chéng shī","abbr":"kzcs","explanation":"刻：用硬物划；烛：蜡烛；诗：诗句。用刀在蜡烛上刻痕，同时提笔作诗。形容才思敏捷。","source":{"text":"《南史·王僧孺传》载：南齐竟陵王萧子良，曾夜集学士作诗，刻烛计时，作四韵诗的，刻烛一寸为标准。"}},{"id":8684,"word":"刻画入微","pinyin":"kè huà rù wēi","abbr":"khrw","explanation":"微：细小。精心细致地描摹，连极小之处也不大意。形容认真细致，一丝不苟。","source":{"text":"本来就是最好的话题，胡雪岩又有意刻画入微，所以把王有龄夫妇听得津津有味。","book":"高阳《胡雪岩全传·平步青云》中册"},"example":{"text":"人物栩栩如生，器物～，简直是梁亦清又复活了！","book":"霍达《穆斯林的葬礼》第五章"},"similar":["栩栩如生"],"usage":"作谓语、定语；用于写作等"},{"id":8685,"word":"刻画唐突","pinyin":"kè huà táng tū","abbr":"khtt","explanation":"刻画：精细的描绘。比喻为了突出丑的而贬低了美的。","source":{"text":"何乃刻画无盐，以唐突西子也。","book":"南朝·宋·刘义庆《世说新语·轻底》"},"example":{"text":"虽不免～，然亦具见其有雅致。","book":"清·龚炜《巢林笔谈》"}},{"id":8686,"word":"刻画无盐","pinyin":"kè huà wú yán","abbr":"khwy","explanation":"无盐：传说中的古代丑女。精细地描摹丑女无盐。比喻以丑比美，引喻比拟得不恰当。","source":{"text":"何乃刻画无盐，唐突西施也。","book":"《晋书·周凯传》"},"example":{"text":"仿数珠儿，～唐突。","book":"宋·陈亮《桂香枝》词"},"similar":["刻画无盐，唐突西施"],"usage":"作谓语、宾语；比喻比拟得不恰当","story":["东晋初年，很有名望的尚书仆射周顗为人特别谦虚。人们总喜欢把他与当时同样有名望的尚书令乐广相提并论，说他们两人都是才学过人、德高望重。周顗谦虚地说：“把我与他相比，是亵渎了他，那是刻画无盐、唐突西施了。”"]},{"id":8687,"word":"刻画无盐，唐突西子","pinyin":"kè huà wú yán，táng tū xī zǐ","abbr":"khwyttxz","explanation":"刻画：精细的描绘；无盐：传说中的古代丑女；西子：即西施，美女。比喻为了突出丑的而贬低了美的。","source":{"text":"何乃刻画无盐，以唐突西子也。","book":"南朝·宋·刘义庆《世说新语·轻底》"}},{"id":8688,"word":"刻画无盐，唐突西施","pinyin":"kè huà wú yán，táng tū xī shī","abbr":"khwyttxs","explanation":"刻画：描绘；无盐：战国时齐国的丑女；唐突：冒犯；西施：春秋时越国美女。比喻拿丑的和美的比较，冒犯与贬低了美的。","source":{"text":"庚亮尝谓顗曰：‘诸人咸以君方乐广。’顗曰：‘何乃刻画无盐，唐突西施也。’","book":"《晋书·周顗传》"},"similar":["刻画无盐"],"usage":"作宾语、定语；用于处事","story":["东晋初年，很有名望的尚书仆射周顗为人特别谦虚。人们总喜欢把他与当时同样有名望的尚书令乐广相提并论，说他们两人都是才学过人、德高望重。周顗谦虚地说：“把我与他相比，是亵渎了他，那是刻画无盐、唐突西施了。”"]},{"id":8689,"word":"刻章琢句","pinyin":"kè zhāng zhuó jù","abbr":"kzzj","explanation":"修饰琢磨文章的细节。","source":{"text":"刻章琢句献天子，钓取薄禄欢庭闱。","book":"宋·王安石《忆昨诗示诸外弟》"},"example":{"text":"写文章不必去～。"},"similar":["雕章琢句"],"usage":"作谓语、定语；指文章刻意修饰"},{"id":8690,"word":"刻翠裁红","pinyin":"kè cuì cái hóng","abbr":"kcch","explanation":"比喻极力修饰词藻。","source":{"text":"毛会侯《浣雪词》，刻翠裁红，务求新颖。","book":"清·陈廷焯《白雨斋词话》第三卷"},"usage":"作谓语、宾语；用于比喻句"},{"id":8691,"word":"刻肌刻骨","pinyin":"kè jī kè gǔ","abbr":"kjkg","explanation":"形容感受极深刻。","source":{"text":"刻肌刻骨，追思罪戾，昼分而食，夜分而寝。","book":"三国·魏·曹植《上责躬应绍诗表》"},"example":{"text":"此事真可为～者也。","book":"唐·吴兢《开元升平源》"},"similar":["刻骨铭心"],"usage":"作谓语、定语；形容感受极为深刻"},{"id":8692,"word":"刻舟求剑","pinyin":"kè zhōu qiú jiàn","abbr":"kzqj","explanation":"比喻不懂事物已发展变化而仍静止地看问题。","source":{"text":"楚人有涉江者，其剑自舟中坠于水，遽契其舟曰：‘是吾剑之所从坠。’舟止，从其所契者入水求之。舟已行矣，而剑不行，求剑若此，不亦惑乎？","book":"《吕氏春秋·察今》》"},"example":{"text":"似你这样寻根究底，便是～，胶柱鼓瑟了！","book":"清·曹雪芹《红楼梦》第一百二十回"},"similar":["守株待兔","墨守成规"],"opposite":["看风使舵","见机行事"],"usage":"作谓语、定语、状语；指头脑不灵活","story":["战国时期，一个楚国人坐船渡长江，船行至江山时他不小心将身上佩带的宝剑掉到水中，但没能及时抓住，于是就在掉剑的地方船舷作了一个记号，船靠岸后就在刚做记号的地方下水去摸他的宝剑，结果一无所获"]},{"id":8693,"word":"刻船求剑","pinyin":"kè chuán qiú jiàn","abbr":"kcqj","explanation":"死守教条，比喻拘泥成法，固执不知变通。","source":{"text":"夫事有贸迁，而言无变革，此所谓胶柱而调瑟，刻船以求剑也。","book":"唐·刘知畿《史通·因习》"},"similar":["刻舟求剑"],"opposite":["看风使舵"],"usage":"作谓语、定语、状语；指头脑不灵活"},{"id":8694,"word":"刻苦耐劳","pinyin":"kè kǔ nài láo","abbr":"kknl","explanation":"刻苦：很能吃苦；耐：禁得起、受得住。工作勤奋，经得住繁重的劳累。","example":{"text":"他是一个～的好小伙，值得我们胜任。"},"usage":"作谓语、定语；用于为人"},{"id":8695,"word":"刻苦钻研","pinyin":"kè kǔ zuān yán","abbr":"kkzy","explanation":"刻苦：下苦功。下苦功，深入研究。","source":{"text":"敢于推翻前人的错结论，表现了古今杰出科学家所共有的刻苦钻研、坚持真理的精神。","book":"《祖冲之》"},"usage":"作谓语、定语；用于学习等"},{"id":8696,"word":"刻薄寡思","pinyin":"kè bó guǎ sī","abbr":"kbgs","explanation":"寡：少。待人说话冷酷无情，不厚道。","source":{"text":"党同伐异，刻薄寡思在朱先生写的文字里是读不到的。","book":"冯至《朱自清先生》"},"similar":["冷酷无情","尖酸刻薄"],"opposite":["宽厚仁慈"],"usage":"作主语、宾语；指人说话"},{"id":8697,"word":"刻薄寡恩","pinyin":"kè bó guǎ ēn","abbr":"kbge","explanation":"刻薄：冷酷无情；寡：少。冷酷无情，极少施恩于人。形容极为冷酷。","source":{"text":"我们乡党中刻薄寡恩，再没有出胡监生之右者。","book":"清·李百川《绿野仙踪》第十八回"},"example":{"text":"雍正帝本是个刻薄寡恩的主子，喜怒不时，刑赏不测。","book":"蔡东藩《清史演义》第三十二回"}},{"id":8698,"word":"刻薄成家","pinyin":"kè bó chéng jiā","abbr":"kbcj","explanation":"刻薄：冷酷无情。用残忍刻薄的手段发家致富。","source":{"text":"刻薄成家，理无久享。","book":"清·朱柏庐《治家格言》"},"example":{"text":"那些商人平日之间寸铢积累，～，看得那银钱十分郑重。","book":"清·张春帆《九尾龟》第二十六回"},"usage":"作谓语、宾语；指发不义之财"},{"id":8699,"word":"刻足适屦","pinyin":"kè zú shì jù","abbr":"kzsj","explanation":"屦：麻制的单底鞋。按照鞋的大小来削自己的脚。比喻主次颠倒。","source":{"text":"昔人亦有言，刻足以适屦。","book":"宋·陆游《读何斯举黄州秋居杂咏次其韵》"},"similar":["削足适屦"],"usage":"作宾语、定语；指主次颠倒"},{"id":8700,"word":"刻雾裁风","pinyin":"kè wù cái fēng","abbr":"kwcf","explanation":"比喻擅长山水风光描写。","source":{"text":"五言七言信手成，刻雾裁风好饥骨。","book":"明·袁宏道《和丘长孺》"},"usage":"作宾语；指善于描写风光"},{"id":8701,"word":"刻骨仇恨","pinyin":"kè gǔ chóu hèn","abbr":"kgch","explanation":"永记心头的深仇大恨。","source":{"text":"战士们热血沸腾，跃出战壕，怀着对阶级敌人的刻骨仇恨，杀声震天，与数倍于我之敌展开白刃格斗。","book":"穆欣《北线凯歌》三十"},"example":{"text":"战士们怀着对敌人的～，冲向敌阵。"},"similar":["血海深仇","不共戴天","恨之入骨"],"opposite":["以德报怨","满腔热情"],"usage":"作谓语、宾语；形容仇恨极深"},{"id":8702,"word":"刻骨崩心","pinyin":"kè gǔ bēng xīn","abbr":"kgbx","explanation":"指仇恨极深。","source":{"text":"朕所以刻骨崩心，饮胆尝血，瞻天视地，无处自容。","book":"《北史·隋越王侗传》"},"usage":"作宾语、定语；用于比喻句"},{"id":8703,"word":"刻骨相思","pinyin":"kè gǔ xiāng sī","abbr":"kgxs","explanation":"形容思念之深，历久难移。","source":{"text":"井底点灯深烛伊，共郎长行莫围棋。玲珑骰子安红豆，入骨相思知不知？","book":"唐·温庭筠《新添声杨柳枝·二》词"},"example":{"text":"得诗中毛病倒没有，只是太俗大浅了一些，不足以描画～。","book":"高阳《状元娘子》五"},"usage":"作主语、宾语；用于书面语"},{"id":8704,"word":"刻骨铭心","pinyin":"kè gǔ míng xīn","abbr":"kgmx","explanation":"铭刻在心灵深处。形容记忆深刻，永远不忘。","source":{"text":"深荷王公之德，铭刻心骨。","book":"唐·李白《上安州李长史书》"},"example":{"text":"万望太尉慈悯，救拔深陷之人，得瞻天日，～，誓图死保。","book":"明·施耐庵《水浒全传》第八十回"},"similar":["刻饥刻骨","念念不忘","铭心刻骨"],"opposite":["浮光掠影","过眼烟云"],"usage":"作谓语、定语、状语；指印象深刻"},{"id":8705,"word":"刻骨镂心","pinyin":"kè gǔ lòu xīn","abbr":"kglx","explanation":"铭刻在心灵深处。形容记忆深刻，永远不忘。","source":{"text":"深荷王公之德，铭刻心骨。","book":"唐·李白《上安州李长史书》"},"example":{"text":"虽～，难报万一。","book":"明·吴承恩《西游记》第八十七回"},"similar":["刻骨铭心"],"usage":"作谓语、定语；指记忆深刻"},{"id":8706,"word":"刻鹄不成","pinyin":"kè hú bù chéng","abbr":"kgbc","explanation":"刻：刻画；鹄：天鹅。刻画天鹅不像倒像鸭子。比喻模仿失败，劝诫人不要好高骛远。","source":{"text":"将来工匠一门，不用聘请外国人，就是有人开造机器的厂，也有内行人指点，不至于刻鹄不成了。","book":"《市声》第31回"},"example":{"text":"《市声》第31回：“将来工匠一门，不用聘请外国人，就是有人开造机器的厂，也有内行人指点，不至于～了。”"},"similar":["刻鹄不成尚类鹜","刻鹄类鹜"],"usage":"作宾语、定语；用于比喻句"},{"id":8707,"word":"刻鹄不成尚类鹜","pinyin":"kè hú bù chéng shàng lèi wù","abbr":"kgbcslw","explanation":"刻：刻画；鹄：天鹅；鹜：鸭子。刻画天鹅不像倒像鸭子。比喻模仿失败，劝诫人不要好高骛远。","source":{"text":"效伯高不得，犹为谨敕之士，所谓刻鹄不成尚类鹜者也。","book":"南朝·宋·范晔《后汉书·马援传》"},"similar":["刻鹄不成","刻鹄类鹜"],"usage":"作宾语、定语；用于劝诫人"},{"id":8708,"word":"刻鹄成鹜","pinyin":"kè hú chéng wù","abbr":"kgcw","explanation":"比喻模仿的虽然不逼真，但还相似。同“刻鹄类鹜”。","source":{"text":"又或食古如鲠，刻鹄成鹜。","book":"清·卷鑫《序》"},"similar":["刻鹄类鹜","刻鹄不成"],"usage":"作宾语、补语；比喻仿效失真，适得其反"},{"id":8709,"word":"刻鹄类鹜","pinyin":"kè hú lèi wù","abbr":"kglw","explanation":"刻：刻画；鹄：天鹅；类：似，象；鹜：鸭子。画天鹅不成，仍有些象鸭子。比喻模仿的虽然不逼真，但还相似。","source":{"text":"效伯高不得，犹为谨敕之士，所谓刻鹄不成尚类鹜者也。效季良不成，陷为天下轻薄子，所为画虎不成反类狗者也。","book":"《后汉书·马援传》"},"example":{"text":"故比类虽繁，以切至为贵，若～，则无所取焉。","book":"南朝·梁·刘勰《文心雕龙·比兴》"},"similar":["画虎类犬","刻鹄类鹜"],"usage":"作宾语、补语；比喻仿效失真，适得其反","story":["东汉时期，大将军马援在给侄子的信中说，希望你学习谨慎廉洁的龙述，不要学习豪侠仗义的杜保。学龙述不成还可以成谨慎的人，就像刻天鹅不成还能像鸭子。学杜保不成却可能成为轻薄子弟，这就像画虎不成反而像狗了"]},{"id":8710,"word":"刿心刳肺","pinyin":"guì xīn kū fèi","abbr":"gxkf","explanation":"形容费尽心思，刻意为之。","source":{"text":"夫文亦第期各适一世之用而已，而必刿心刳肺，断断焉以师乎古人若此者，何也？以为不如是，则不足以为文也。","book":"清·方东树《答叶溥求论古文书》"},"similar":["刿心刳腹"],"usage":"作谓语、定语；用于书面语"},{"id":8711,"word":"刿心刳腹","pinyin":"guì xīn kū fù","abbr":"gxkf","explanation":"形容费尽心思，刻意为之。同“刿心刳肺”。","source":{"text":"同一有物之语，不刿心刳腹以出之，则不成为文。","book":"郭绍虞《中国文学批评史》第四章七九"},"similar":["刿心刳肺"],"usage":"作谓语、定语；用于书面语"},{"id":8712,"word":"刿心怵目","pinyin":"guì xīn chù mù","abbr":"gxcm","explanation":"指触目惊心。见“刿目怵心”。","source":{"text":"狄平子以所著《平等阁笔记》见寄，记述两年来都中近事，字字令人刿心怵目。","book":"梁启超《饮冰室诗话》七"},"similar":["刿目怵心"],"usage":"作谓语、宾语；指触目惊心"},{"id":8713,"word":"刿心鉥目","pinyin":"guì xīn shù mù","abbr":"gxsm","explanation":"刿：伤，割；鉥：长针，指用针刺。眼睛被割，心被刺。形容触目惊心。","source":{"text":"及其为诗，刿目鉥心，刃迎缕解。","book":"唐·韩愈《贞曜先生墓志》"},"example":{"text":"见外洋舟车之利，火器之精，～，震悼失图，谓今之天下，虽孔子不治。","book":"清·谭嗣同《治言》"}},{"id":8714,"word":"刿心鉥肾","pinyin":"guì xīn xù shèn","abbr":"gxss","explanation":"形容穷思苦索，刻意为之。同“刿鉥心腑”。","source":{"text":"仆之马齿长矣，下上今古，刿心鉥肾，亦不啻三折肱矣。","book":"清·钱谦益《复徐巨源书》"},"similar":["刿鉥心腑"],"usage":"作谓语、宾语；用于书面语"},{"id":8715,"word":"刿目怵心","pinyin":"guì mù chù xīn","abbr":"gmcx","explanation":"刿：刺伤；怵：惊动。指触目惊心。","source":{"text":"至于秦汉之文，莫不洞达駘宕，刿目怵心。","book":"清·包世臣《再与杨季子书》"},"example":{"text":"至于其他骨肉之间，眈眈逐逐之态，随事随处一一标而出之，足令人～者，不一而足。","book":"季新《新评》"},"similar":["触目惊心","刿心怵目"],"usage":"作谓语、宾语；指触目惊心"},{"id":8716,"word":"刿目鉥心","pinyin":"guì mù xù xīn","abbr":"gmsx","explanation":"犹言呕心沥血。比喻用尽心思。","source":{"text":"及其为诗，刿目鉥心。","book":"唐·韩愈《贞曜先生墓志铭》"},"example":{"text":"他形容孟郊的苦吟，竟至使用一‘～’、‘搯擢胃肾’的辞句，这也就是后人所说的‘呕心滴血’了。","book":"郭沫若《李白与杜甫·李白与杜甫在诗歌上的交往》"},"similar":["呕心沥血"],"usage":"作谓语、定语；用于书面语"},{"id":8717,"word":"刿鉥心腑","pinyin":"guì xù xīn fǔ","abbr":"gsxf","explanation":"形容穷思苦索，刻意为之。","source":{"text":"夫刿鉥心腑，指摘造化，如探大海出珊瑚。","book":"明·王世贞《艺苑卮言》卷八"},"similar":["刿鉥肝肾"],"usage":"作谓语、宾语；用于书面语"},{"id":8718,"word":"刿鉥肝肾","pinyin":"guì xù gān shèn","abbr":"gsgs","explanation":"形容穷思苦索，刻意为之。同“刿鉥心腑”。","source":{"text":"江橙里词清远而蕴藉，沈沃田称其‘刿鉥肝肾，磨濯心志，苦心孤诣以为词’。","book":"清·陈廷焯《白雨斋词话》卷四"},"similar":["刿鉥心腑"],"usage":"作谓语、宾语；用于书面语"},{"id":8719,"word":"削发为僧","pinyin":"xuē fà wéi sēng","abbr":"xfws","explanation":"剃除须发，出家为僧。","source":{"text":"我也想：死里逃生，不如图个清闲自在。因此依了他，削发为僧。","book":"明·吴承恩《西游记》第二十回：“老者道：‘你家居何处？因甚事削发为僧？’”明·冯梦龙《醒世恒言》第二十七卷"},"example":{"text":"而今听见人说不在江南，已到四川山里～去了。","book":"清·吴敬梓《儒林外史》第三十七回"},"similar":["削发为尼","削发披缁"],"usage":"作谓语、定语；指出家"},{"id":8720,"word":"削发披缁","pinyin":"xuē fà pī zī","abbr":"xfpz","explanation":"缁：黑色，借指僧人穿的黑色衣服。剃光头发，穿上僧衣。表示出家为僧。","source":{"text":"戴了儒衣儒冠，便是孔子；削发披缁，便是释牟尼佛。","book":"明·周楫《西湖二集·党阇黎一念错投胎》"},"example":{"text":"分别去后，王惠另觅了船入到太湖，自此更姓改名，～去了。","book":"清·吴敬梓《儒林外史》第八回"},"similar":["披缁削发","削发为僧"],"usage":"作谓语、定语、宾语；指出家"},{"id":8721,"word":"削尖脑袋","pinyin":"xiāo jiān nǎo dài","abbr":"xjnd","explanation":"形容一个人伪装，粉饰，拚命钻营的丑态。","example":{"text":"他～想望上爬。"},"similar":["想方设法"],"usage":"作谓语、状语；指拚命钻营的丑态"},{"id":8722,"word":"削方为圆","pinyin":"xuē fāng wéi yuán","abbr":"xfwy","explanation":"把方的削成圆的。比喻把有个性的人改变成圆通的人。","source":{"text":"遂使世人削方为圆，挠直为曲。","book":"《晋书·熊远传》"},"example":{"text":"要为兄图个出身，但怕兄性气不好，托我相劝，若得～，便引去拜在安相名下，不日就可进身。","book":"清·夏敬渠《野叟曝言》第十一回"},"similar":["刓方为圆","削觚为圆"],"usage":"作谓语、定语；用于书面语"},{"id":8723,"word":"削木为吏","pinyin":"xuē mù wéi lì","abbr":"xmwl","explanation":"意思是不能受狱吏的侮辱，即使是木头做的狱吏也不能见他。形容狱吏的凶暴可畏。","source":{"text":"故士有画地为牢势不入，削木为吏议不对，定计于鲜也。","book":"东汉·班固《汉书·司马迁传》"},"example":{"text":"上古时～，今日之淳风安在？","book":"清·程允升《幼学琼林·讼狱》"},"similar":["刻木为吏"],"usage":"作谓语；指狱吏的凶暴可畏"},{"id":8724,"word":"削株掘根","pinyin":"xuē zhū jué gēn","abbr":"xzjg","explanation":"株：露出地面的的树桩。形容彻底铲除。也比喻除恶务尽。","source":{"text":"削株掘根，无与祸邻，祸乃不存。","book":"《战国策·秦策一》"},"similar":["除恶务尽","斩草除根"],"usage":"作谓语、宾语、定语；形容彻底铲除"},{"id":8725,"word":"削职为民","pinyin":"xuē zhí wéi mín","abbr":"xzwm","explanation":"撤掉官职，降为平民。","source":{"text":"王黼大怒，将宋昭削职为民。","book":"清·陈忱《水浒后传》第十九回"},"similar":["革职为民"],"usage":"作谓语；指撤掉官职"},{"id":8726,"word":"削肩细腰","pinyin":"xuē jiān xì yāo","abbr":"xjxy","explanation":"低垂的肩，纤细的腰。形容女子身材秀美。","source":{"text":"第二个削肩细腰，长挑身材，鸭蛋脸面，俊眼修眉，顾盼神飞，文彩精华，见之忘俗。","book":"清·曹雪芹《红楼梦》第三回"},"example":{"text":"一般的都是长条身材，～，华彩飞扬，丰神流丽。","book":"清·张春帆《九尾龟》第一百五十四回"}},{"id":8727,"word":"削草除根","pinyin":"xuē cǎo chú gēn","abbr":"xccg","explanation":"犹斩草除根。指从根本上消除祸患。","source":{"text":"破巢完卵从来少，削草除根势或然。可惜忠良遭屈死，又将家属媚当权。","book":"元·纪君祥《赵氏孤儿》第一折：“不争晋公主怀孕在身，产孤儿是我仇人，待满月钢刀铡死，才称我削草除根。”明·冯梦龙《喻世明言》第四十卷"},"example":{"text":"用了第二计，可以焚巢捣穴，～，不留一个余贼。","book":"清·李渔《比目鱼·办贼》"},"similar":["斩草除根"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":8728,"word":"削衣贬石","pinyin":"xuē yī biǎn shí","abbr":"xybs","explanation":"削：减轻；贬：降低。削减衣服，降低饮食标准。比喻省吃俭用。","source":{"text":"时公私有余，削衣贬食，不立资遗，以班亲旧朋友为义。","book":"唐·韩愈《清河郡公房公墓志铭》"}},{"id":8729,"word":"削衣贬食","pinyin":"xuē yī biǎn shí","abbr":"xybs","explanation":"削：削减；贬：降低。削减衣服，降低饮食水准。比喻省吃俭用，节衣缩食","source":{"text":"时公私有余，削衣贬食，不立资遗，以班亲旧朋友为义。","book":"唐·韩愈《清河郡公房公墓碣铭》"},"similar":["节衣缩食"],"usage":"作谓语、定语、宾语；用于生活"},{"id":8730,"word":"削觚为圆","pinyin":"xuē gū wéi yuán","abbr":"xgwy","explanation":"觚：方。把方的削成圆的。比喻把有个性的人改变成圆通的人。","source":{"text":"盖在于乘均轴之枢，握刀尺之要，划邪为正，削觚为圆，能使善之必迁，不谓恶之尽无。","book":"唐·白居易《为人上宰相书一首》"},"similar":["削方为圆","刓方为圆"],"usage":"作谓语、定语；用于书面语"},{"id":8731,"word":"削足适履","pinyin":"xuē zú shì lǚ","abbr":"xzsl","explanation":"适：适应；履：鞋。因为鞋小脚大，就把脚削去一块来凑和鞋的大小。比喻不合理的牵就凑合或不顾具体条件，生搬硬套。","source":{"text":"夫所以养而害所养，譬犹削足而适履，杀头而便冠。","book":"《淮南子·说林训》"},"example":{"text":"是借用，就难免有“～”和“挂一漏万”的毛病了。","book":"闻一多《四杰》"},"similar":["生搬硬套","杀头便冠","刻足适屦"],"opposite":["因地制宜","量体裁衣"],"usage":"作谓语、宾语、定语；指人做事机械","story":["春秋时期，楚灵王灭掉蔡国，派其弟弃疾管理蔡国。楚灵王又发兵攻打徐国，大臣朝吴怂恿弃疾乘机夺取王位。弃疾杀死太子禄。弃疾让哥哥子比及子哲做国君和令尹，得知楚灵王上吊自杀，弃疾杀死子比和子哲，自立为王"]},{"id":8732,"word":"削足适屦","pinyin":"xuē zú shì jù","abbr":"xzsj","explanation":"适：适应；屦：鞋。因为鞋小脚大，就把脚削去一块来凑和鞋的大小。比喻不合理的牵就凑合或不顾具体条件，生搬硬套。","source":{"text":"夫所以养而害所养，譬犹削足而适履，杀头而便冠。","book":"《淮南子·说林训》"}},{"id":8733,"word":"削趾适履","pinyin":"xuē zhǐ shì lǚ","abbr":"xzsl","explanation":"适：适应；履：鞋。因为鞋小脚大，就把脚削去一块来凑和鞋的大小。比喻不合理的牵就凑合或不顾具体条件，生搬硬套。","source":{"text":"夫所以养而害所养，譬犹削足而适履，杀头而便冠。","book":"《淮南子·说林训》"},"example":{"text":"自日本归来之民党，略读法政诸书，罕留意于本国史籍，以求因革之宜，锐意步趋他国，不恤～。","book":"章太炎《论读史之利益》"}},{"id":8734,"word":"削趾适屦","pinyin":"xuē zhǐ shì jù","abbr":"xzsj","explanation":"比喻不合理的牵就凑合或不顾具体条件，生搬硬套。同“削足适履”。","source":{"text":"姊妹作奇想，便强人削趾适屦。","book":"清·和邦额《夜谭随录·董如彪》"},"similar":["削足适履","刻足适屦"],"usage":"作谓语、宾语、定语；指人做事机械"},{"id":8735,"word":"削迹捐势","pinyin":"xuē jù juān shì","abbr":"xjjs","explanation":"削迹：匿迹；捐：舍弃。隐匿踪迹，舍弃权势。旧指隐居。","source":{"text":"削迹捐势，不为功名。","book":"《庄子·山木》"}},{"id":8736,"word":"削铁如泥","pinyin":"xuē tiě rú ní","abbr":"xtrn","explanation":"切削铁器如同斩剁泥土一样。形容兵刃极其锋利。","source":{"text":"那青釭剑砍铁如泥，锋利无比。","book":"明·罗贯中《三国演义》第四十一回"},"example":{"text":"这口剑虽不能说～，也似花马剑一般锋利。","book":"姚雪垠《李自成》第一卷第五章"},"similar":["新发于硎","吹发可断"],"usage":"作谓语、定语；指极其锋利"},{"id":8737,"word":"削铁无声","pinyin":"xuē tiě wú shēng","abbr":"xtws","explanation":"形容刀剑锋利。","source":{"text":"刃儿薄，尖儿长，靶儿短，削铁无声，吹毛过刃。","book":"清·文康《儿女英雄传》第六回"},"usage":"作谓语、定语；用于兵器等"},{"id":8738,"word":"前不巴村，后不巴店","pinyin":"qián bù bā cūn，hòu bù bā diàn","abbr":"qbbchbbd","explanation":"指走远道处在无处落脚的境地。也比喻处境尴尬或生活无依靠。","source":{"text":"来到这里，前不巴村，后不巴店，欲投贵庄借宿一宵，明日早行。","book":"明·施耐庵《水浒传》第二回"},"example":{"text":"我们来到一个～的地方露营。"},"similar":["前不巴村，后不着店"],"usage":"作谓语、定语；指左右无靠"},{"id":8739,"word":"前不巴村，后不着店","pinyin":"qián bù bā cūn，hòu bù zháo diàn","abbr":"qbbchbzd","explanation":"巴：靠近。着：挨着。前面没有村子，后面没有旅店。形容走远路走到野外荒郊，找不到歇脚住宿的地方。","source":{"text":"三个商量道：‘没来由看使枪棒，恶了这厮！如今闪得前不巴村，后不着店，却是投那里去宿是好？’","book":"明·施耐庵《水浒全传》第三十七回"},"example":{"text":"清·西周生《醒世姻缘传》：“宝光哇出一肚子水，～……穿了精湿的裤子，垂头丧气，走了四五里路。”"},"similar":["前不巴村，后不巴店"],"usage":"作谓语、定语；指左右无靠"},{"id":8740,"word":"前不着村，后不着店","pinyin":"qián bù zhāo cūn，hòu bù zhāo diàn","abbr":"qbzchbzd","explanation":"指走远道处在无处落脚的境地。比喻处境尴尬或生活无依靠。","source":{"text":"弄得我前不着村，后不着店，有上梢没下梢。","book":"明·兰陵笑笑生《金瓶梅词话》第86回"},"example":{"text":"清·吴璿《飞龙全传》第19回：“一口气竟走了十余里路，看看天色晚了，～。”"},"similar":["前不巴村，后不巴店"],"usage":"作谓语、定语；指左右无靠"},{"id":8741,"word":"前不见古人，后不见来者","pinyin":"qián bù jiàn gǔ rén，hòu bù jiàn lái zhě","abbr":"qbjgrhbjlz","explanation":"指空前绝后。亦用作讽刺。","source":{"text":"前不见古人，后不见来者。","book":"唐·陈子昂《登幽州台歌》"},"similar":["前无古人","空前绝后"],"usage":"作宾语、定语；用于书面语","story":["唐朝著名的文学家陈子昂很有才学，受到武则天的赏识，被任命为随军参谋，遭到将军武攸宜的排斥，在燕地他登上古老的幽州台，想起古代燕昭王重用大将乐毅的故事，就写诗：“前不见古人，后不见来者。念天地之悠悠，独怅然而涕下。"]},{"id":8742,"word":"前事不忘，后事之师","pinyin":"qián shì bù wàng，hòu shì zhī shī","abbr":"qsbwhszs","explanation":"师：借鉴。记取从前的经验教训，作为以后工作的借鉴。","source":{"text":"前世之不忘，后事之师。","book":"《战国策·赵策一》"},"example":{"text":"～，我们要记取这次失败的教训，争取下次实验成功。"},"similar":["前车之覆，后车之鉴"],"opposite":["掉了疮疤忘了痛"],"usage":"作谓语、定语；用于人","story":["战国初，晋国大臣智伯掌握了大权，他派人向赵襄子、魏桓子、韩康子索要土地。赵襄子拒绝，智伯联合魏、韩出兵围困赵，赵派谋士张孟谈去游说魏、韩，他们三家联合消灭了智伯，要封赏张孟谈，张不要并说：“前事不忘，后事之师”"]},{"id":8743,"word":"前人失脚，后人把滑","pinyin":"qián rén shī jiǎo，hòu rén bǎ huá","abbr":"qrsjhrbh","explanation":"比喻吸取人家失败的教训，小心谨慎，免得再失事。","source":{"text":"仁庙素苦足疾，中官翼之，犹或时失足。汉顾赵曰：‘前人失脚，后人把滑。’","book":"明·叶盛《水东日记》卷七"},"similar":["前车之鉴"],"usage":"作宾语，分句；指前人的教训"},{"id":8744,"word":"前人栽树，后人乘凉","pinyin":"qián rén zāi shù，hòu rén chéng liáng","abbr":"qrzshrcl","explanation":"比喻前人为后人造福。","source":{"text":"那晓得三纲五常，只知道七青八黄，圆鸭蛋里棹桨，竹竿空长，肚里无粮，前人栽树，后人乘凉。","book":"明·胡文焕《群音类选·清腔类·桂枝香》"},"example":{"text":"～。”我们守着祖宗的遗产，过了一生，后来儿孙，自有儿孙之福。 ★清·颐琐《黄绣球》第一回","book":"俗语说得"},"similar":["前人修路后人行"],"opposite":["重蹈覆辙"],"usage":"作宾语、定语、分句；用于给后辈造福"},{"id":8745,"word":"前人种德后人收","pinyin":"qián rén zhòng dé hòu rén shōu","abbr":"qrzdhrs","explanation":"比喻前人为后人造福。","source":{"text":"恰才个绕蜗居编菊篱，又报道步蟾宫折桂手，端的是前人种德后人收。","book":"明·冯惟敏《商调集贤宾·归田自寿》"},"usage":"作宾语、定语；用于劝诫人"},{"id":8746,"word":"前人种树，后人乘凉","pinyin":"qián rén zhòng shù，hòu rén chéng liáng","abbr":"qrzshrcl","explanation":"比喻前人为后人造福。亦作“前人栽树，后人乘凉”。","source":{"text":"前人种树，后人乘凉。反把那种树的人杀了，还有甚么公理呢！","book":"陆士谔《续孽海花》第32回"},"example":{"text":"～是为后代造福。"},"similar":["前人栽树，后人乘凉"],"usage":"作宾语、定语、分句；用于给后辈造福"},{"id":8747,"word":"前仆后继","pinyin":"qián pū hòu jì","abbr":"qphj","explanation":"仆：倒下；继：接着，跟上。前面的倒下了，后面的紧跟上去。形容斗争的英勇壮烈。","source":{"text":"跛马愠仆，前仆后踣。","book":"唐·孙樵《祭梓潼神君文》"},"example":{"text":"～人应在，如君不愧轩辕孙！","book":"清·秋瑾《吊吴烈士樾》"},"similar":["前赴后继","勇往直前"],"opposite":["苟且偷生","贪生怕死","畏首畏尾"],"usage":"作谓语、定语、状语；用于战争"},{"id":8748,"word":"前仆后起","pinyin":"qián pū hòu qǐ","abbr":"qphq","explanation":"仆：倒下；起：接着，跟上。前面的倒下了，后面的紧跟上去。形容斗争的英勇壮烈。","source":{"text":"跛马愠仆，前仆后踣。","book":"唐·孙樵《祭梓潼神君文》"},"example":{"text":"可怜志士死社稷，～形影从。","book":"清·梁启超《去国行》诗"},"similar":["前仆后继","前仆后踣"],"usage":"作谓语、定语、状语；用于战争"},{"id":8749,"word":"前仆后踣","pinyin":"qián pú hòu bó","abbr":"qphb","explanation":"形容斗争的英勇壮烈。同“前仆后继”。","source":{"text":"跛马愠仆，前仆后踣。","book":"唐·孙樵《祭梓潼神君文》"},"similar":["前仆后继"],"usage":"作谓语、定语、状语；用于战争"},{"id":8750,"word":"前仰后合","pinyin":"qián yǎng hòu hé","abbr":"qyhh","explanation":"身体前后晃动。形容大笑或困倦得直不起腰的样子。","source":{"text":"把李瓶儿笑的前仰后合。","book":"明·兰陵笑笑生《金瓶梅词话》第四十回"},"example":{"text":"众人听了，越发哄然大笑的～。","book":"清·曹雪芹《红楼梦》第四十二回"},"similar":["前合后仰","东倒西歪","前合后偃"],"opposite":["饮泣吞声","呼天抢地"],"usage":"作状语、定语；形容站立不稳的样子"},{"id":8751,"word":"前俯后仰","pinyin":"qián fǔ hòu yǎng","abbr":"qfhy","explanation":"身体前后晃动。形容大笑或困倦得直不起腰的样子。","example":{"text":"他一个笑话让大伙笑得～。"},"similar":["前仰后合","前俯后合"],"usage":"作状语；形容大笑的样子"},{"id":8752,"word":"前俯后合","pinyin":"qián fǔ hòu hé","abbr":"qfhh","explanation":"身体前后晃动。形容大笑得直不起腰的样子。","example":{"text":"他们笑得～。"},"similar":["前仰后合","前俯后仰"],"usage":"作状语；形容大笑的样子"},{"id":8753,"word":"前倨后卑","pinyin":"qián jù hòu bēi","abbr":"qjhb","explanation":"倨：傲慢；卑：谦卑，恭敬。以前傲慢，后来恭敬。形容对人的态度改变。","source":{"text":"苏秦曰：‘嫂何前倨而后卑也。’","book":"《战国策·秦策一》"},"similar":["前倨后恭"],"usage":"作谓语、状语、定语；指人的前后态度","story":["战国时期，纵横家苏秦求父亲给他新皮袍和百两黄金，前去秦国游说他的政治主张，没有成功只好灰溜溜地回家，嫂子连饭都不给他吃。他并没灰心，闭门读书，甚至用锥刺股来提醒自己，后来他成为六国的丞相，回家时嫂子跪地不敢抬头"]},{"id":8754,"word":"前倨后恭","pinyin":"qián jù hòu gōng","abbr":"qjhg","explanation":"倨：傲慢；恭：恭敬。以前傲慢，后来恭敬。形容对人的态度改变。","source":{"text":"苏秦笑谓其嫂曰：‘何前倨而后恭也？’","book":"《战国策·秦策一》：“苏秦曰：‘嫂何前俾而后卑也。’”《史记·苏秦列传》"},"example":{"text":"帝有葛仙翁笑诞：“猴子是何～？”","book":"明·吴承恩《西游记》第五十一回"},"similar":["前倨后卑"],"usage":"作谓语、状语、定语；指人的前后态度","story":["战国时期，纵横家苏秦求父亲给他新皮袍和百两黄金，前去秦国游说他的政治主张，没有成功只好灰溜溜地回家，嫂子连饭都不给他吃。他并没灰心，闭门读书，甚至用锥刺股来提醒自己，后来他成为六国的丞相，回家时嫂子跪地不敢抬头"]},{"id":8755,"word":"前前后后","pinyin":"qián qián hòu hòu","abbr":"qqhh","explanation":"详情，细节，里里外外。","source":{"text":"周得胜便把他那年寻邓九公遇着十三妹的始末原由，前前后后，据实说了一遍。","book":"清·文康《儿女英雄传》第21回"},"example":{"text":"请把这件事情的～说一遍。"},"similar":["里里外外"],"usage":"作宾语、定语、状语；指事情的详情"},{"id":8756,"word":"前功尽废","pinyin":"qián gōng jìn fèi","abbr":"qgjf","explanation":"以前的一切努力完全白费。","example":{"text":"你尚差一年大学毕业，若现在辍学，岂非～。"}},{"id":8757,"word":"前功尽弃","pinyin":"qián gōng jìn qì","abbr":"qgjq","explanation":"功：功劳；尽：完全；弃：丢失。以前的功劳全部丢失。也指以前的努力全部白费。","source":{"text":"公之功甚多，今公又以秦兵出塞，过两周，践韩，而以攻梁，一攻而不得，前功尽灭。","book":"《战国策·西周策》"},"example":{"text":"皇上叫你去带兵，或是打土匪，或是打洋人，打赢了还好，打输了，岂非～，自寻苦恼。","book":"清·李宝嘉《官场现形记》第四十九回"},"similar":["功亏一篑","功败垂成","前功尽灭"],"opposite":["大功告成"],"usage":"作谓语、宾语；指白忙","story":["战国末年纵横家苏厉去游说周郝王去阻止秦国的大将白起进攻魏国都城大梁，如果大梁不保，周王朝就危险了。并举楚国名将养由基百发百中的例子，前边99次都中了，只要一箭不中就前功尽弃了。白起没有理会苏厉的话，继续进行兼并战"]},{"id":8758,"word":"前功尽灭","pinyin":"qián gōng jìn miè","abbr":"qgjm","explanation":"功：功劳；尽：完全；灭：废弃。以前的功劳全部废弃。也指以前的努力全部白费。","source":{"text":"公之功甚多，今公又以秦兵出塞，过两周，践韩，而以攻梁，一攻而不得，前功尽灭。","book":"《战国策·西周策》"},"similar":["前功尽弃"],"opposite":["大功告成"],"usage":"作谓语、宾语；指白忙","story":["战国末年，纵横家苏厉去游说周郝王去阻止秦国的大将白起进攻魏国都城大梁，如果大梁不保，周王朝就危险了。并举楚国名将养由基百发百中的例子，前边99次都中了，只要一箭不中就前功尽弃了。白起没有理会苏厉的话，继续进行兼并战"]},{"id":8759,"word":"前功皆弃","pinyin":"qián gōng jiē qì","abbr":"qgjq","explanation":"功：功绩。皆：全部。弃：丢掉。以前取得的功劳全部丢掉了。亦作“前功尽弃”、“前功尽灭”。","source":{"text":"公之功甚多，今公又以秦兵出塞，过两周，践韩，而以攻梁，一攻而不得，前功尽灭。","book":"《战国策·西周策》"},"example":{"text":"不如少息，若弓拨矢钩，～。","book":"《新唐书·李德裕传》"}},{"id":8760,"word":"前危后则","pinyin":"qián wēi hòu zé","abbr":"qwhz","explanation":"前人的危亡，后人应引以为戒。犹言前车之覆，后车之鉴。","source":{"text":"地列酒泉，天垂酒池，杜康妙识，仪狄先知。纣丧殷邦，桀倾夏国，由此言之，前危后则。","book":"宋·司马光《资治通鉴·晋孝武帝太元三年》"},"similar":["前车之覆，后车之鉴"],"usage":"作宾语、定语；用于书面语","story":["晋朝时期，前秦国国王苻坚召集群臣饮酒，席间要求尽兴而醉，并行酒令。以秘书监朱彤为正，秘书侍郎赵整应酒令作《酒德之歌》：“地列酒泉，天垂酒池，杜康妙识，仪狄先知。纣丧殷邦，桀倾夏国，由此言之，前危后则。”"]},{"id":8761,"word":"前古未有","pinyin":"qián gǔ wèi yǒu","abbr":"qgwy","explanation":"自古以来未曾有过。","source":{"text":"而邓枢密洵武真以少保领院而不兼节钺，前所未有也。","book":"宋·徐度《却扫编》卷下"},"example":{"text":"太祖长子术赤遂于其地即可汗位，可谓破～之纪载矣。","book":"鲁迅《三闲集·“吾国征俄战史之一页”》"},"similar":["前所未有"],"usage":"作谓语、定语；同“前所未有”"},{"id":8762,"word":"前古未闻","pinyin":"qián gǔ wèi wén","abbr":"qgww","explanation":"指从来没有听说过。","source":{"text":"惟太素脉、揣骨二家，前古未闻。","book":"清·纪昀《阅微草堂笔记·滦阳续录》"},"example":{"text":"清·纪昀《阅微草堂笔记·滦阳续录》：“惟太素脉、揣骨二家，～。”"},"similar":["前所未闻"],"opposite":["史不绝书"],"usage":"作谓语、定语；指从来没有听说过"},{"id":8763,"word":"前合后仰","pinyin":"qián hé hòu yǎng","abbr":"qhhy","explanation":"合：曲身俯地；仰：仰面朝天。身体前后晃动。形容大笑或困倦得直不起腰的样子。","source":{"text":"东倒西歪，后合前仰，离席上。这酒兴颠狂，醉魂儿望家往。","book":"元·高文秀《遇上皇》第一折"},"example":{"text":"李小兰怀抱朝阳，轻轻～，轻轻算起那一大篇细细碎碎的家庭帐，顽皮小姑娘的影子一点没有。","book":"池莉《太阳出世》十二"},"similar":["前合后偃","前仰后合"],"usage":"作状语、定语；形容站立不稳的样子"},{"id":8764,"word":"前合后偃","pinyin":"qián hé hòu yǎn","abbr":"qhhy","explanation":"形容身体前后晃动的样子。","source":{"text":"则被这枷纽的我左侧右偏，人拥的我前合后偃。","book":"元·关汉卿《窦娥冤》第三折"},"example":{"text":"立不定～，行不动东倒西歪。折倒的我身体儿尪赢，忧愁的髭发斑白。","book":"元·张国宾《衣锦还乡》第二折"},"similar":["前仰后合","前合后仰"],"usage":"作状语、定语；形容站立不稳的样子"},{"id":8765,"word":"前呼后应","pinyin":"qián hū hòu yìng","abbr":"qhhy","explanation":"前面呼叫，后面应和。也指写文章时结构紧凑，上下文相呼应。","similar":["首尾相应"]},{"id":8766,"word":"前呼后拥","pinyin":"qián hū hòu yōng","abbr":"qhhy","explanation":"前面有人吆喝开路，后面有人围着保护。旧时形容官员出行，随从的人很多。","source":{"text":"想为官的前呼后拥，衣轻乘肥，有多少荣耀！","book":"元·无名氏《赚蒯通》第二折"},"example":{"text":"放学了，同学们～地走出了校园。"},"similar":["前呼后应","一呼百诺"],"opposite":["轻车简从"],"usage":"作谓语、宾语、状语；用于权贵等"},{"id":8767,"word":"前因后果","pinyin":"qián yīn hòu guǒ","abbr":"qyhg","explanation":"起因和结果。泛指事情的整个过程。","source":{"text":"今树以前因，报以后果。","book":"《南齐书·高逸传论》"},"example":{"text":"振德说完～，深叹一声。","book":"冯德英《迎春花》第二十一章"},"similar":["来龙去脉"],"opposite":["一支半截"],"usage":"作主语、宾语；用于人或事物的来历与线索"},{"id":8768,"word":"前尘影事","pinyin":"qián chén yǐng shì","abbr":"qcys","explanation":"指从前的尚留在记忆中的事。","source":{"text":"觉明虚静犹如晴空，无复麤重前尘影事，观诸世间大地河山如镜鉴明。","book":"《楞严经》卷十"},"example":{"text":"我们对于这三年半来的追溯回忆，其意义不只是叙述～而已，其实也含有积极的作用。","book":"邹韬奋《经历·抗战以来》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":8769,"word":"前度刘郎","pinyin":"qián dù liú láng","abbr":"qdll","explanation":"度：次，回。上次去过的刘郎又到了。泛指去了又来的人。","source":{"text":"种桃道士今何处，前度刘郎今又来。","book":"唐·刘禹锡《再游玄都观》诗"},"example":{"text":"安公子是～，何小姐是司空见惯，倒也用不着十分羞涩，便举案齐眉，同吃了一顿饭。","book":"清·文康《儿女英雄传》第二十八回"},"similar":["刘郎前度"],"usage":"作宾语；泛指去了又来的人","story":["唐朝诗人刘禹锡因“紫陌红尘拂面来，无人不道看花回。玄都观里桃千树，尽是刘郎去后栽”而被贬播州。14年后被调回京城作《再游玄都观》诗：“百亩庭中半是苦，桃花净尽菜花开。种桃道士归何处，前度刘郎今又来。”"]},{"id":8770,"word":"前庭悬鱼","pinyin":"qián tíng xuán yú","abbr":"qtxy","explanation":"比喻不吃请，不受贿。","source":{"text":"续敝衣薄食，车马蠃败，府丞尝献其生鱼，续乃出前所县者，以杜其意。","book":"《后汉书·羊续传》"},"similar":["羊续悬鱼"],"usage":"作宾语、定语；用于为人","story":["东汉时期，汉灵帝派羊续担任南阳太守。羊续只带一名随从前往，微服私访后上任。他决心以自己的清廉树立官场榜样，府丞焦俭送来一条他爱吃的鲜鲤鱼，推辞不掉，就只好让仆人将鱼挂在屋外，晒成鱼干，从此就没人敢给他送礼了"]},{"id":8771,"word":"前徒倒戈","pinyin":"qián tú dǎo gē","abbr":"qtdg","explanation":"前面的部队投降敌方，反过来打自己人。","source":{"text":"会于牧野，罔有敌于我师，前徒倒戈，攻于后以北，血流漂杵。","book":"《尚书·武成》"},"example":{"text":"甲子昧爽会牧野，～反回旋。","book":"明·许仲琳《封神演义》第一回"},"similar":["反戈一击"],"usage":"作谓语、定语；用于书面语"},{"id":8772,"word":"前怕狼，后怕虎","pinyin":"qián pà láng，hòu pà hǔ","abbr":"qplhph","explanation":"比喻胆小怕事，顾虑太多。","source":{"text":"磊落英雄，清修人物，前怕狼后怕虎。设谋，使毒，只待把忠良妒。","book":"明·冯惟敏《朝天子·感述》"},"example":{"text":"他明白，上了年级的人都是～，事事有顾虑。","book":"周立波《暴风骤雨》一"},"similar":["胆小如鼠"],"opposite":["胆大妄为"],"usage":"作宾语、分句；指顾虑重重"},{"id":8773,"word":"前怕龙，后怕虎","pinyin":"qián pà lóng，hòu pà hǔ","abbr":"qplhph","explanation":"比喻胆小怕事，顾虑太多。","source":{"text":"磊落英雄，清修人物，前怕狼后怕虎。设谋，使毒，只待把忠良妒。","book":"明·冯惟敏《朝天子·感述》"},"example":{"text":"要改革就不能～，要大胆创新，努力实践，才能取得成功。"},"similar":["前怕狼，后怕虎"],"usage":"作宾语、分句；指顾虑重重"},{"id":8774,"word":"前思后想","pinyin":"qián sī hòu xiǎng","abbr":"qshx","explanation":"往前想想，再退后想想。形容一再考虑。","source":{"text":"他既得失心重，未有不前思后想。","book":"清·李汝珍《镜花缘》第六十六回"},"example":{"text":"正在～，一筹莫展的时候，忽见九姨太的一个贴身大丫头进房有事。","book":"清·李宝嘉《官场现形记》第三十六回"},"similar":["左思右想"],"usage":"作谓语、定语；指一再考虑"},{"id":8775,"word":"前慢后恭","pinyin":"qián màn hòu gōng","abbr":"qmhg","explanation":"慢：傲慢。以前态度傲慢，后来恭敬有礼。形容前后态度截然不同。","source":{"text":"知制诰与翰林学士，相去几何？此而谓其前慢后恭见利忘义，何深文之甚？","book":"梁启超《王荆公传》第16章"},"similar":["前倨后恭","后恭前倨"],"usage":"作谓语、状语、定语；指人的前后态度"},{"id":8776,"word":"前所未有","pinyin":"qián suǒ wèi yǒu","abbr":"qswy","explanation":"从来没有过的。","source":{"text":"而邓枢密洵武真以少保领院而不兼节钺，前所未有也。","book":"宋·徐度《却扫编》卷下"},"example":{"text":"如此好令，真是酒席宴～的，妹子恭逢其盛，能不浮一大白。","book":"清·李汝珍《镜花缘》第八十四回"},"similar":["前无古人","史无前例","前所未闻"],"opposite":["史不绝书","司空见惯"],"usage":"作谓语、定语；指从来没有过的"},{"id":8777,"word":"前所未知","pinyin":"qián suǒ wèi zhī","abbr":"qswz","explanation":"新经历或重新经历，以前不知或未经验过。","example":{"text":"她发现了许多～的丈夫的秘密。"},"similar":["前所未闻"],"usage":"作谓语、定语；指以前不知道的"},{"id":8778,"word":"前所未闻","pinyin":"qián suǒ wèi wén","abbr":"qsww","explanation":"前：先前。从来没有听说过。","source":{"text":"此事前所未闻，是知穷荒绝徼，天奇地怪，亦何所不有。","book":"宋·周密《齐东野语·黄婆》"},"example":{"text":"这是～的事。"},"similar":["前无古人","史无前例","前所未有"],"opposite":["史不绝书","司空见惯"],"usage":"作谓语、定语；指从来没有听说过"},{"id":8779,"word":"前挽后推","pinyin":"qián wǎn hòu tuī","abbr":"qwht","explanation":"形容前后都有人帮助。","source":{"text":"卫君必入，夫二子者，或挽之，或推之，欲无入得乎？","book":"《左传·襄公十四年》"},"example":{"text":"慈禧太后好奇曾坐过一回，但为怕出事，不准用机车拖带，只是找了些太监～，走了十来丈远便即停止。","book":"高阳《慈禧全传》九十"},"usage":"作宾语、定语；用于处事"},{"id":8780,"word":"前无古人","pinyin":"qián wú gǔ rén","abbr":"qwgr","explanation":"指以前的人从来没有做过的。也指空前的。","source":{"text":"前不见古人，后不见来者。","book":"唐·陈子昂《登幽州台歌》"},"example":{"text":"二者皆句语雄峻，～。","book":"宋·洪迈《容斋四笔》卷二"},"similar":["前所未有"],"opposite":["司空见惯"],"usage":"作谓语、定语；指以前从来没人做过的","story":["唐朝著名的文学家陈子昂很有才学，受到武则天的赏识，被任命为随军参谋，遭到将军武攸宜的排斥，在燕地他登上古老的幽州台，想起古代燕昭王重用大将乐毅的故事，就写诗：“前不见古人，后不见来者。念天地之悠悠，独怅然而涕下。"]},{"id":8781,"word":"前无古人，后无来者","pinyin":"qián wú gǔ rén，hòu wú lái zhě","abbr":"qwgrhwlz","explanation":"指空前绝后。亦用作讽刺。同“前不见古人，后不见来者”。","source":{"text":"前不见古人，后不见来者。","book":"唐·陈子昂《登幽州台歌》"},"example":{"text":"文惠喜堆墨书，深自矜负，号～。","book":"宋·刘攽《中山诗话》"},"similar":["空前绝后"],"usage":"作宾语、定语；用于独一无二"},{"id":8782,"word":"前朝后代","pinyin":"qián cháo hòu dài","abbr":"qchd","explanation":"前后各个朝代。喻指历代。","source":{"text":"量那些一陀儿寰土，经了些前朝后代战争余。","book":"元·范子安《竹叶舟》第一折"}},{"id":8783,"word":"前歌后舞","pinyin":"qián gē hòu wǔ","abbr":"qghw","explanation":"原指武王伐纣，军中士气旺盛，后用作对正义而战的军队的颂辞。","source":{"text":"师乃慆，前歌后舞。","book":"《尚书大传·大誓》"},"example":{"text":"云南革命军，自河口至蒙自、江那，市井不惊，民安其业，庶几孟津观兵，～。","book":"章炳麟《革命军约法问答》"},"usage":"作谓语、定语；指军队的士气"},{"id":8784,"word":"前生注定","pinyin":"qián shēng zhù dìng","abbr":"qszd","explanation":"指今生的命运是前生所注定的，无法改变。","source":{"text":"若还不是，前生注定，甚得许多摧挫。","book":"宋·晁元礼《柳村新》词"},"example":{"text":"这分明是～，命合使然。","book":"清·西周生《醒世姻缘传》第六十一回"},"similar":["命中注定"],"usage":"作谓语、宾语、分句；指宿命论"},{"id":8785,"word":"前目后凡","pinyin":"qián mù hòu fán","abbr":"qmhf","explanation":"目：细目；凡：概略。《春秋》的一种笔法，一件事在文中重复出现，对前者详加说明，后者概略叙述。","source":{"text":"秋八月，诸侯盟于首戴。诸侯何以不序？一事而再见者，前目而后凡也。","book":"《公羊传·僖公五年》"},"similar":["起例发凡"],"usage":"作宾语、定语；用于作文著书等"},{"id":8786,"word":"前瞻后顾","pinyin":"qián zhān hòu gù","abbr":"qzhg","explanation":"看看前再看看后。有时形容顾虑过多，犹豫不决。同“瞻前顾后”。","source":{"text":"死期将至，尚留金紫之班，而必至日暮途远，夜行不休，前瞻后顾，无所栖归，不亦太可怜乎！","book":"清·梁章钜《归田琐记·七十致仕》"},"example":{"text":"斗争下去！不要～！","book":"杨沫《青春之歌》第一部第29章"},"similar":["瞻前顾后"],"usage":"作谓语、宾语、定语、状语；指顾虑太多"},{"id":8787,"word":"前程万里","pinyin":"qián chéng wàn lǐ","abbr":"qcwl","explanation":"前程：前途。比喻前途远大，不可限量。","source":{"text":"此儿可谓前程万里也。","book":"唐·尉迟枢《南楚新闻》"},"example":{"text":"哥哥荣任是美事，家中自有兄弟支持，不必挂怀。～，须自保重！","book":"明·冯梦龙《东周列国志》卷十一"},"similar":["前途无量","前程似锦"],"opposite":["死路一条","碌碌无为"],"usage":"作谓语、定语；指人的前途"},{"id":8788,"word":"前程似锦","pinyin":"qián chéng sì jǐn","abbr":"qcsj","explanation":"前程象锦绣那样。形容前途十分美好。","source":{"text":"想着咱锦片前程，十分恩爱。","book":"元·贾仲名《对玉梳》第四折"},"example":{"text":"女儿已经开始了真正属于自己的人生，她的面前～，任何人也无法改变这一轨道了。","book":"霍达《穆斯林的葬礼》第六章"}},{"id":8789,"word":"前程远大","pinyin":"qián chéng yuǎn dà","abbr":"qcyd","explanation":"前程：前途。比喻前途远大。","source":{"text":"先生前程远大，宣择高枝棲止，以图上进；若埋没大才于此，枉自可惜。","book":"明·冯梦龙《喻世明言》卷五"},"example":{"text":"在他那一代人中，算是～之辈，有多少青年男女对他羡慕不已。","book":"路遥《平凡的世界》第三部第二十六章"},"similar":["前程万里"],"opposite":["死路一条"],"usage":"作谓语、定语；指人的前途"},{"id":8790,"word":"前脚后脚","pinyin":"qián jiǎo hòu jiǎo","abbr":"qjhj","explanation":"比喻紧跟着。","example":{"text":"他们是～地进门。"},"usage":"作状语；比喻紧跟"},{"id":8791,"word":"前虑不定，后有大患","pinyin":"qián lǜ bù dìng，hòu yǒu dà huàn","abbr":"qlbdhydh","explanation":"比喻做事之前考虑不成熟，到后来就可能发生大灾祸。","source":{"text":"前虑不定，后有大患，将奈之何？","book":"《战国策·魏策一》"}},{"id":8792,"word":"前街后巷","pinyin":"qián jiē hòu xiàng","abbr":"qjhx","explanation":"指各处的街巷。","source":{"text":"［董卓］方欲兴兵，忽听得城内大喊声，闭了城门，急点军数千余人，前街后巷，罗纹结角，军兵都把了。","book":"《三国志平话》卷上"},"example":{"text":"林冲大怒，离了李小二家。先去街上买把解腕尖刀，带在身上。～，一地里去寻。","book":"明·施耐庵《水浒传》第十回"},"similar":["大街小巷"],"usage":"作主语、宾语；用于城镇等"},{"id":8793,"word":"前襟后裾","pinyin":"qián jīn hòu jū","abbr":"qjhj","explanation":"形容年幼时兄弟间关系密切。","source":{"text":"方其幼也，父母左提右挈，前襟后裾，食则同案，衣则传服，学则连业，游则共方，虽有悖乱之人，不能不相爱也。","book":"北齐·颜之推《颜氏家训·兄弟》"}},{"id":8794,"word":"前覆后戒","pinyin":"qián fù hòu jiè","abbr":"qfhj","explanation":"比喻先前的失败，可以做为以后的教训。","source":{"text":"前车覆，后车戒。","book":"汉·刘向《说苑·善说》"},"usage":"作宾语、定语；用于处事等"},{"id":8795,"word":"前言不搭后语","pinyin":"qián yán bù dā hòu yǔ","abbr":"qybdhy","explanation":"说的话前后连接不上。多形容思想混乱，不能自圆其说。","source":{"text":"四科长急得前言不搭后语地说：‘701，不是我！’","book":"杜鹏程《保卫延安》第六章"},"example":{"text":"他的话说得～。"},"similar":["前言不答后语"],"opposite":["自圆其说"],"usage":"作谓语、状语；指不能自圆其说"},{"id":8796,"word":"前言不答后语","pinyin":"qián yán bù dā hòu yǔ","abbr":"qybdhy","explanation":"说得话前后连接不上。多形容思想混乱，不能自圆其说。","source":{"text":"你们白想想，那些人都是管什么的，可是前言不答后语？","book":"清·曹雪芹《红楼梦》第54回"},"similar":["前言不搭后语"],"usage":"作谓语、状语、宾语；指不能自圆其说"},{"id":8797,"word":"前言往行","pinyin":"qián yán wǎng xíng","abbr":"qywx","explanation":"指前代圣贤的言行。","source":{"text":"君子以多识前言往行，以畜其德。","book":"《周易·大畜》"},"example":{"text":"八十时，明已损目聪去耳，前言往行不复纪。辞官致禄归桑梓，安车驷马入旧里，乐事告终忧事始。","book":"晋·陆机《百年诗十首》其八"},"similar":["先言往行"],"usage":"作宾语、定语；用于书面语"},{"id":8798,"word":"前赴后继","pinyin":"qián fù hòu jì","abbr":"qfhj","explanation":"前面的冲上去了，后面的紧跟上来。形容不断投入战斗，奋勇冲杀向前。","source":{"text":"跛马愠仆，前仆后踣。","book":"唐·孙樵《祭梓潼神君文》"},"example":{"text":"波涛汹涌的海浪，奔腾着，咆哮着，没有尽头。"},"similar":["前仆后继","一往无前"],"opposite":["临阵脱逃","畏首畏尾","瞻前顾后"],"usage":"作谓语、定语、状语；指不断投入"},{"id":8799,"word":"前跋后疐","pinyin":"qián bá hòu máo","abbr":"qbhz","explanation":"比喻进退两难。","source":{"text":"跋，躐；疐，跲也。老狼有胡，进则躐其胡，退则疐其尾，进退有难。","book":"《诗·豳风·狼跋》：“狼跋其胡，载疐其尾。”毛传"},"example":{"text":"这是一件～的事，不知如何是好！"},"similar":["进退两难","跋前疐后"],"usage":"作谓语、定语、宾语；用于进退两难"},{"id":8800,"word":"前跋后痜","pinyin":"qián bá hòu máo","abbr":"qbhm","explanation":"比喻进退两难。","source":{"text":"狼跋其胡，载痜其尾。毛传跋，躐；痜，踥也。老狼有胡，进则躐其胡，退则痜其尾，进退有难。","book":"《诗·豳风·狼跋》"}},{"id":8801,"word":"前车之鉴","pinyin":"qián chē zhī jiàn","abbr":"qczj","explanation":"鉴：镜子，为教训。前面车子翻倒的教训。比喻先前的失败，可以做为以后的教训。","source":{"text":"前车覆，后车戒。","book":"《荀子·成相》：“前车已覆，后未知更何觉时！”汉·刘向《说苑·善说》"},"example":{"text":"～，请自三思。","book":"清·陈忱《水浒后传》第二十五回"},"similar":["前车可鉴","殷鉴不远"],"opposite":["重蹈覆辙"],"usage":"作主语、宾语；用于劝告人","story":["西汉时期，洛阳人贾谊从小就有天才儿童的美誉，汉文帝听说他很有才学，请他进京担任博士，问他治理国家的看法。贾谊主张要以秦朝灭亡作为镜子，时刻提醒自己要施行仁政，让老百姓休养生息，重视农业生产才能使国家强大"]},{"id":8802,"word":"前车可鉴","pinyin":"qián chē kě jiàn","abbr":"qckj","explanation":"鉴：引申为教训。指用前人的失败作为教训。","source":{"text":"洋人在粤，曾经就抚，迨给银后，滋扰不休，反覆性成，前车可鉴。","book":"《清史稿·刘韵珂传》"},"example":{"text":"有时句法也大约受些影响，而且～。","book":"鲁迅《二心集·译本序五》"},"similar":["前车之鉴","殷鉴不远"],"opposite":["重蹈覆辙"],"usage":"作谓语、定语、分句；用于人","story":["西汉时期，洛阳人贾谊从小就有天才儿童的美誉，汉文帝听说他很有才学，请他进京担任博士，问他治理国家的看法。贾谊主张要以秦朝灭亡作为镜子，时刻提醒自己要施行仁政，让老百姓休养生息，重视农业生产才能使国家强大"]},{"id":8803,"word":"前车已覆，后车当戒","pinyin":"qián chē yǐ fù，hòu chē dāng jiè","abbr":"qcyfhcdj","explanation":"鉴：教训。比喻从前人的失败中得到的教训。","source":{"text":"前车已覆，后车当戒，仁兄不可……堕其术中，迷而不悟。","book":"明·周楫《西湖二集·邢君瑞二载幽期》"},"similar":["前车之鉴"],"usage":"作宾语、定语；用于劝告人"},{"id":8804,"word":"前车覆，后车戒","pinyin":"qián chē fù，hòu chē jiè","abbr":"qcfhcj","explanation":"覆：翻；戒：警惕，前面的车翻了，后面的车要引以为戒。","source":{"text":"《周书》曰：‘前车覆，后车戒。’盖言其危。","book":"汉·刘向《说苑·善说》"}},{"id":8805,"word":"前辙可鉴","pinyin":"qián zhé kě jiàn","abbr":"qzkj","explanation":"比喻先前的失败，可以做为以后的教训。同“前车之鉴”。","source":{"text":"惟兄勉之，无失朋友之望，前辙可鉴。","book":"宋·陈亮《与石应之书》"},"similar":["前车可鉴","前车之鉴"],"opposite":["重蹈覆辙"],"usage":"作谓语、定语、分句；用于人"},{"id":8806,"word":"前进无路，后退无门","pinyin":"qián jìn wú lù，hòu tuì wú mén","abbr":"qjwlhtwm","explanation":"指一个人的前途没有限量。","source":{"text":"鸿渐还低头不响——‘我只希望方先生前途无量。’","book":"钱钟书《围城》"},"example":{"text":"我相信你会～的。"},"similar":["前程远大"],"opposite":["前途渺茫"],"usage":"作谓语、定语；指前途看好"},{"id":8807,"word":"前途未卜","pinyin":"qián tú wèi bǔ","abbr":"qtwb","explanation":"将来的光景如何难以预测。","example":{"text":"他觉得～就只好放弃。"},"similar":["前途渺茫"],"opposite":["前途无量"],"usage":"作宾语、定语；指看不到希望"},{"id":8808,"word":"前途渺茫","pinyin":"qián tú miǎo máng","abbr":"qtmm","explanation":"不知将来采取什么行动。","example":{"text":"她感到～就不寒而栗。"},"similar":["前途未卜"],"opposite":["前途无量","远大前程"],"usage":"作宾语、定语；指看不到未来前景"},{"id":8809,"word":"前遮后拥","pinyin":"qián zhē hòu yōng","abbr":"qzhy","explanation":"形容十分拥挤、喧闹的样子。","source":{"text":"你这里齐臻臻前遮后拥，美甘甘笑口欢容。","book":"元·吴昌龄《东坡梦》第三折"},"example":{"text":"梁中书早饭己罢，带领杨志上马，～，往东郭门来。","book":"明·施耐庵《水浒全传》第十一回"},"similar":["后拥前遮"],"usage":"作定语、状语；指十分拥挤"},{"id":8810,"word":"前门去虎，后门进狼","pinyin":"qián mén qù hǔ，hòu mén jìn láng","abbr":"qmqhhmjl","explanation":"比喻赶走了一个敌人，又来了一个敌人。同“前门拒虎，后门进狼”。","source":{"text":"你想，那样多的草莽英雄又闯进了成都城，这不正是‘前门去虎，后门进狼’？","book":"郭沫若《反正前后》第二篇"},"similar":["前门拒虎，后门进狼"],"usage":"作宾语、定语、分句；指一害接一害"},{"id":8811,"word":"前门拒虎，后门进狼","pinyin":"qián mén jù hǔ，hòu mén jìn láng","abbr":"qmjhhmjl","explanation":"比喻赶走了一个敌人，又来了一个敌人。","source":{"text":"窦氏虽除，而寺人之权从兹盛矣！谚曰：‘前门拒虎，后门进狼。’此之谓也。","book":"元·赵雪航《评史》"},"example":{"text":"“秦败三晋之师于石门。赐以黼黻之服。”～，未知是祸是福。","book":"明·李贽《史纲评要·周纪》"},"similar":["顾此失彼","前门去虎，后门进狼"],"usage":"作宾语、分句；指一害接一害"},{"id":8812,"word":"剑及履及","pinyin":"jiàn jí lǚ jí","abbr":"jjlj","explanation":"形容行动坚决迅速。同“剑及屦及”。","source":{"text":"社会上各界领袖，能以身作则，剑及履及的来做，则移风易俗，也绝不是挟泰山以超北海的难事。","book":"《新华日报》1943.1.31"},"similar":["剑及屦及"],"usage":"作谓语、定语；形容行动坚决迅速"},{"id":8813,"word":"剑及屦及","pinyin":"jiàn jí jù jí","abbr":"jjjj","explanation":"屦：鞋；及：赶上。形容行动坚决迅速。","source":{"text":"楚子闻之，投袂而起，屦及于窒皇，剑及于寝门之外，车及于蒲胥之市。秋九月，楚子围宋。","book":"春秋·鲁·左丘明《左传·宣公十四年》"},"example":{"text":"滇军师长张开儒、方声涛等，尤摩拳擦掌，大有～之势。","book":"邹鲁《督军称兵与复辟》"},"similar":["剑及履及"],"usage":"作谓语、定语；形容行动坚决迅速","story":["春秋时期，楚庄王派申舟去齐国访问，申舟没有经得宋国同意而路过宋国，被宋人所杀。楚王听说此事后，就调集军队，当年9月派兵围攻宋国，他迫不及待要为申舟报仇，快速跑出去，捧鞋的人追到寝门，捧剑的人追到寝门外才追上他"]},{"id":8814,"word":"剑头一吷","pinyin":"jiàn tóu yī xuè","abbr":"jtyx","explanation":"剑头：指剑环头小孔；吷：象声词，形容声音微小。比喻言论无足轻重。","source":{"text":"夫吹筦也，犹有嗃也；吹剑首者，吷而已矣。尧舜，人之所誉也；道尧舜于戴晋人之前，譬犹一吷也。","book":"《庄子·则阳》"},"example":{"text":"榻上双痕凛然在，～何须角。","book":"宋·苏轼《再游径山》诗"},"similar":["剑首一吷"],"usage":"作宾语、定语；比喻言论无足轻重"},{"id":8815,"word":"剑履上殿","pinyin":"jiàn lǚ shàng diàn","abbr":"jlsd","explanation":"履：鞋。佩着剑，穿着鞋上朝。指受到极大的优待。","source":{"text":"乃令萧何第一，赐带剑履上殿，入朝不趋。","book":"《史记·萧相国世家》"},"example":{"text":"董卓为相国，赞拜不名，入朝不趋，～，威福莫比。","book":"明·罗贯中《三国演义》第四回"},"usage":"作宾语、定语；用于书面语"},{"id":8816,"word":"剑态箫心","pinyin":"jiàn tai xiāo xīn","abbr":"jtxx","explanation":"比喻既有情致，又有胆识（旧小说多用来形容能文能武的才子）。同“剑气箫心”。","source":{"text":"剑态箫心不可羁，已教终古负初期。","book":"柳亚子《自题磨剑室诗词后》"},"similar":["剑气箫心"],"usage":"作宾语；指人刚柔相济"},{"id":8817,"word":"剑戟森森","pinyin":"jiàn jǐ sēn sēn","abbr":"jjss","explanation":"比喻人心机多，很厉害。","source":{"text":"剑戟森森李义深。","book":"《北史·李义深传》"},"usage":"作谓语；比喻人心机多，很厉害"},{"id":8818,"word":"剑拔弩张","pinyin":"jiàn bá nǔ zhāng","abbr":"jbnz","explanation":"比喻形势紧张，一触即发。","source":{"text":"大部分的时候是含精养锐的，必要时才一用力，正不必面红耳赤，箭拔弩张的。","book":"洪深《电影戏剧表演术》第六章"},"example":{"text":"冯永祥看他们～，形势不妙，赶紧站起来，走到他们当中。","book":"周而复《上海的早晨》第四部"},"similar":["一触即发","千钧一发","箭在弦上"],"opposite":["销兵洗甲"],"usage":"作谓语、定语、状语；形容双方冲突"},{"id":8819,"word":"剑树刀山","pinyin":"jiàn shù dāo shān","abbr":"jsds","explanation":"佛教所说的地狱之刑。形容极残酷的刑罚。","source":{"text":"至第三重门，入见镬汤及刀山剑树。","book":"《太平广记》卷三八二《裴则子》引《冥报拾遗》"},"example":{"text":"那怕她一把刀，就是～，我也不怕。","book":"清·文康《儿女英雄传》第七回"},"similar":["刀山剑树"],"usage":"作宾语、定语；指危险的境地"},{"id":8820,"word":"剑气箫心","pinyin":"jiàn qì xiāo xīn","abbr":"jqxx","explanation":"犹剑胆琴心。比喻既有情致，又有胆识（旧小说多用来形容能文能武的才子）。","source":{"text":"少年击剑更吹箫，剑气箫心一例消。","book":"清·龚自珍《已亥杂诗》"},"example":{"text":"尘寰从此知音稀，～谁与抗。","book":"周实《哭洗醒》诗"},"similar":["剑胆琴心","剑态箫心"],"usage":"作宾语；指人刚柔相济"},{"id":8821,"word":"剑老无芒，人老无刚","pinyin":"jiàn lǎo wú máng，rén lǎo wú gāng","abbr":"jlwmrlwg","explanation":"芒：锋芒。剑用久了就会失去锋芒，人衰老之时也失去刚性。","source":{"text":"桓公虽然是个英主，却不道剑老无芒，人老无刚。","book":"明·冯梦龙《东周列国志》第三十二回"},"usage":"作宾语、定语；用于劝诫人"},{"id":8822,"word":"剑胆琴心","pinyin":"jiàn dǎn qín xīn","abbr":"jdqx","explanation":"比喻既有情致，又有胆识（旧小说多用来形容能文能武的才子）。","source":{"text":"小榻琴心展，长缨剑胆舒。","book":"元·吴莱《寄董与几》诗"},"example":{"text":"说实在话，简直是出类拔萃，～。","book":"欧阳山《三家巷》二十"},"similar":["侠骨柔肠","剑气箫心"],"usage":"作宾语；指人刚柔相济"},{"id":8823,"word":"剑首一吷","pinyin":"jiàn shǒu yī guī","abbr":"jsyx","explanation":"吷：象声词，形容声音微小。比喻言论无足轻重。同“剑头一吷”。","source":{"text":"栎园天才绝世，其诗文皆卓然大家；即以杂著，此其剑首一吷也，而富如此。","book":"清·徐芳《序》"},"similar":["剑头一吷"],"usage":"作宾语、定语；比喻言论无足轻重"},{"id":8824,"word":"剔抽禿刷","pinyin":"tī chōu tū shuā","abbr":"tcts","explanation":"形容着急时眼睛迅速转动，或仔细打量别人的样子。亦作“剔抽禿揣”。","source":{"text":"休惊吓着他，你看这小厮到这开封府里，吓的他眼脑剔抽秃刷的。","book":"元·郑廷玉《后庭花》第四折"}},{"id":8825,"word":"剔抽秃揣","pinyin":"tī chōu tū chuǎi","abbr":"tctc","explanation":"形容着急时眼睛迅速转动，或仔细打量别人的样子。同“剔抽禿刷”。","source":{"text":"为什么獐獐狂狂便待要急张拒遂的褪，眼脑又剔抽秃揣的慌？","book":"元·李直夫《虎头牌》第一折"}},{"id":8826,"word":"剔肤见骨","pinyin":"tī fū jiàn gǔ","abbr":"tfjg","explanation":"剔：从骨头上把肉刮下来；肤：肌肤。把肉剔下来，一直剔到了骨头。比喻对事物分析和解剖得非常深刻、彻底。"},{"id":8827,"word":"剔蝎撩蜂","pinyin":"tī xiē liáo fēng","abbr":"txlf","explanation":"比喻惹事生非。","source":{"text":"常是个争龙斗虎，剔蝎撩蜂。","book":"元·纪君祥《赵氏孤儿》第二折：“偏你这罢职归田一老农，公然敢剔蝎撩蜂。”元·无名氏《小尉迟》第一折"},"example":{"text":"明·无名氏《四马投唐》第二折：“你待要～惹战斗，劝着对越不瞅，你待要与唐家做对头。”"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":8828,"word":"剔透玲珑","pinyin":"tī tòu líng lóng","abbr":"ttll","explanation":"形容灵巧可爱。亦比喻人的聪明伶俐。","source":{"text":"且是娘剔透玲珑不放闲，不枉了唤声妆旦。","book":"元·张养浩《最高歌兼喜春来·咏玉簪》曲：“诗磨的剔透玲珑，酒灌得痴呆懵懂。”元·乔吉《斗鹌鹑·歌姬》曲"},"example":{"text":"真是花团锦簇，～。","book":"清·曹雪芹《红楼梦》第十七回"},"similar":["玲珑剔透"],"usage":"作定语、状语；用于书面语"},{"id":8829,"word":"剖决如流","pinyin":"pōu jué rú liú","abbr":"pjrl","explanation":"剖决：分析、解决；如流：如同流水一般。形容分析、解决问题明快、敏捷。","source":{"text":"簿案盈几，剖决如流。","book":"《隋书·裴政传》"},"example":{"text":"元璋后至趋左，提议军事，诸将皆瞠目相顾，独元璋～，屈服众人，诸将方稍稍敬服。","book":"蔡东蕃《明史演义》第四回"},"similar":["剖断如流"],"usage":"作谓语、定语；指处理问题"},{"id":8830,"word":"剖幽析微","pinyin":"pōu yōu xī wēi","abbr":"pyxw","explanation":"犹剖玄析微。剖辨玄奥，分析细微。","source":{"text":"使读者剖幽析微，深刺腧髓，渠不开其智。","book":"宋·叶适《序》"},"similar":["剖玄析微"],"usage":"作谓语、宾语；用于探索"},{"id":8831,"word":"剖心坼肝","pinyin":"pōu xīn chè gān","abbr":"pxcg","explanation":"比喻忠诚不二。","source":{"text":"两主二臣，剖心坼肝相信，岂移于浮辞哉！","book":"《史记·鲁仲连邹阳传》"},"similar":["剖心析肝"],"usage":"作谓语、定语；用于书面语"},{"id":8832,"word":"剖心析肝","pinyin":"pōu xīn xī gān","abbr":"pxxg","explanation":"形容掬诚相示。亦作“剖心坼肝”。","source":{"text":"两主二臣，剖心析肝想念，岂移于浮辞哉？","book":"《史记·鲁仲连邹阳列传》"},"example":{"text":"敢～，论举身之事，便当谈笑，以明其心。而粗陈其大纲，一快愤懑，惟君侯察焉。","book":"唐·李白《上安州裴长史书》"},"similar":["推心置腹"],"usage":"作谓语、定语；用于书面语"},{"id":8833,"word":"剖心析胆","pinyin":"pōu xīn xī dǎn","abbr":"pxxd","explanation":"犹剖心析肝。形容掬诚相示。","source":{"text":"且臣前后所陈，剖心析胆，莫非恳到，而朝廷弃置其言，曾不之省，是不以情实待臣也。","book":"宋·司马光《辞修起居第三状》"},"similar":["剖心析肝"],"usage":"作谓语、定语；用于书面语"},{"id":8834,"word":"剖心泣血","pinyin":"pōu xīn qì xuè","abbr":"pxqx","explanation":"形容非常悲伤。同“剖肝泣血”。","source":{"text":"故我剖心泣血，劝列位总要把从前的意见捐除。","book":"清·陈天华《警世钟》"},"similar":["剖肝泣血"],"usage":"作谓语、定语；形容非常悲伤"},{"id":8835,"word":"剖析入微","pinyin":"pōu xī rù wēi","abbr":"pxrw","explanation":"剖析：分解辨析。形容分析事理深入细致。","source":{"text":"街谈巷议，弹射臧否，剖析毫厘，擘肌分理。","book":"汉·张上《西京赋》"},"example":{"text":"论说话艺术的文字，从前著名的似乎只有韩非的《说难》，那是一篇～的文字。","book":"朱自清《说话》"}},{"id":8836,"word":"剖析肝胆","pinyin":"pōu xī gān dǎn","abbr":"pxgd","explanation":"犹剖心析肝。形容掬诚相示。","source":{"text":"臣不胜愤懑，敢复剖析肝胆，陈布以闻，虽抵罪万死，亦无怨悔。","book":"宋·司马光《请建储副或进用宗室弟第三状》"},"usage":"作谓语、定语；用于书面语"},{"id":8837,"word":"剖毫析芒","pinyin":"pōu háo xī máng","abbr":"phxm","explanation":"指分析判别得至细至精。","source":{"text":"远则甫侯子羔，近则于公释之，探情审罚，剖毫析芒。","book":"晋·葛洪《抱朴子·诘鲍》"},"usage":"作谓语、宾语；用于书面语"},{"id":8838,"word":"剖烦析滞","pinyin":"pōu fán xī zhì","abbr":"pfxz","explanation":"指剖析和解决烦杂疑难的问题。","source":{"text":"卿等清而不通，专守绳墨，终不能为国家度长絜大，剖烦析滞。","book":"《宋史·陈恕传》"}},{"id":8839,"word":"剖玄析微","pinyin":"pōu xuán xī wēi","abbr":"pxxw","explanation":"剖辨玄奥，分析细微。","source":{"text":"直取其清谈雅论，剖玄析微，宾主往复，娱心悦耳，非济世成俗之要也。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["剖幽析微"],"usage":"作谓语、宾语；用于探索"},{"id":8840,"word":"剖肝沥胆","pinyin":"pōu gān lì dǎn","abbr":"pgld","explanation":"比喻开诚相待。","source":{"text":"百辟庶尹，四方岳牧，稽图谶之文，顺亿兆之请，披肝沥胆，昼歌夜吟。","book":"《史记·淮阴侯列传》：“臣愿披腹心，输肝胆，效愚材。”《隋书·李德林传》"},"example":{"text":"公乃汉室皇叔，故～以相告。","book":"明·罗贯中《三国演义》第二十一回"},"similar":["披肝沥胆"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":8841,"word":"剖肝泣血","pinyin":"pōu gān qì xuè","abbr":"pgqx","explanation":"形容非常悲伤。","source":{"text":"臣出身为国，破家立事，至乃怀忠获衅，抱信见疑，昼夜长吟，剖肝泣血。","book":"南朝·宋·范晔《后汉书·袁绍传》"},"example":{"text":"故我～，劝列位总要把从前的意见捐除。","book":"清·陈天华《警世钟》"},"similar":["剖心泣血"],"usage":"作谓语、定语；形容非常悲伤"},{"id":8842,"word":"剖胆倾心","pinyin":"pōu dǎn qīng xīn","abbr":"pdqx","explanation":"比喻真心相见，倾吐心里话。也形容非常忠诚。","source":{"text":"臣愿披腹心，输肝胆，效愚材。","book":"《史记·淮阴侯列传》"},"example":{"text":"说着民风土俗、钱粮政务，无一不～，津津不已。","book":"明·凌濛初《二刻拍案惊奇》卷三十九"},"similar":["披肝沥胆","破脑刳心"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":8843,"word":"剖腹明心","pinyin":"pōu fù míng xīn","abbr":"pfmx","explanation":"剖：破开；明：表明。破开胸膛，表明心迹。"},{"id":8844,"word":"剖腹藏珠","pinyin":"pōu fù cáng zhū","abbr":"pfcz","explanation":"破开肚子把珍珠藏进去。比喻为物伤身，轻重颠倒。","source":{"text":"吾闻西域贾胡得美珠，剖身以藏之，有诸？","book":"《资治通鉴·唐纪·太宗贞观元年》"},"example":{"text":"就失了手也有限的，怎么忽然又变出这“～”和脾气来。","book":"清·曹雪芹《红楼梦》第四十五回"},"similar":["本末倒置"],"usage":"作谓语、宾语；比喻为物伤身，轻重颠倒","story":["唐太宗统治时期，经常深入了解民间生活，并把一些典型事例对照自己的施政。一次他听说西域胡人为了过关逃避关税把珠宝藏在自己肚子里，过关后开肚取出珠宝，认为可笑，就告诫魏征要教育好文武百官不能用如此高的关税对待百姓"]},{"id":8845,"word":"剖蚌得珠","pinyin":"pōu bàng dé zhū","abbr":"pbdz","explanation":"比喻求取贤良良的人材。同“剖蚌求珠”。","source":{"text":"易若剖蚌得珠，难如破石求玉。","book":"明·谢榛《四溟诗话》第四卷"},"similar":["剖蚌求珠"],"usage":"作宾语、定语；指求才"},{"id":8846,"word":"剖蚌求珠","pinyin":"pōu bàng qiú zhū","abbr":"pbqz","explanation":"将蚌壳剖开，以取里面的珍珠。比喻求取贤良良的人材。","source":{"text":"将蚌壳剖开，以取里面的珍珠。比喻求取贤良良的人材。"},"similar":["剖蚌得珠"],"usage":"作宾语、定语；指求才"},{"id":8847,"word":"剗恶锄奸","pinyin":"chǎn è chú jiān","abbr":"cecj","explanation":"铲除凶恶奸邪之人。","source":{"text":"他杀人污佛地，我救苦下云端，剗恶锄奸。","book":"《儿女英雄传》第十回"},"similar":["铲恶锄奸"],"usage":"作谓语、宾语；用于为民除害"},{"id":8848,"word":"剗旧谋新","pinyin":"chǎn jiù móu xīn","abbr":"cjmx","explanation":"犹除旧图新。","source":{"text":"范仲淹入参宰政，富弼继秉枢轴。二人以天下之务为己任，谓朝政因循日久，庶事隳敝，志欲剗旧谋新，振兴时治，其气锐不可折。","book":"宋·田况《儒林公议》卷上"},"example":{"text":"我们～，迎接新局面。"},"similar":["铲旧谋新"],"usage":"作谓语、宾语；同“除旧布新”"},{"id":8849,"word":"剗草除根","pinyin":"chǎn cǎo chú gēn","abbr":"cccg","explanation":"犹斩草除根。比喻除去祸根，以免后患。","source":{"text":"半世连枝带叶，算从前，历尽虚花，一朝剗草除根，到此际方成结果。","book":"语出《左传·隐公六年》：“为国家者，见恶，如农夫之务去草焉，芟夷蕰崇之，绝其本根，勿使能殖。” 明·陶宗仪《辍耕录连枝秀》"},"example":{"text":"自古道杀人见血，～。","book":"明·沈鲸《双珠记·协谋诬讼》"},"similar":["斩草除根"],"opposite":["放虎归山"],"usage":"作谓语、定语；指做事彻底"},{"id":8850,"word":"剜心裂胆","pinyin":"wān xīn liè dǎn","abbr":"wxld","explanation":"剜：用刀挖；裂：撕开。挖掉心，撕破胆。形容无法忍受的痛苦。"},{"id":8851,"word":"剜肉做疮","pinyin":"wān ròu zuò chuāng","abbr":"wrzc","explanation":"犹剜肉成疮。比喻行事只顾一面，结果与预想适得其反。","source":{"text":"欲于静坐时，将好名好货等根，逐一搜寻扫除廓清，恐是剜肉做疮否？","book":"明·王守仁《传习录》下卷"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第15卷：“若我不允女儿之事，他又～，别寻道路谢我，反为不美。”"},"similar":["剜肉成疮","剜肉生疮"],"usage":"作宾语、定语；多用于比喻句"},{"id":8852,"word":"剜肉医疮","pinyin":"wān ròu yī chuāng","abbr":"wryc","explanation":"比喻只顾眼前，用有害的方法来救急。","source":{"text":"二月卖新丝，五月粜新谷；医得眼前疮，剜却心头肉。","book":"唐·聂夷中《伤田家》诗"},"example":{"text":"是犹～，疮未瘳而肉先溃。","book":"《明史·魏承润传》"},"similar":["剜肉补疮","挖肉补疮"],"usage":"作谓语、定语；指用有害的方法来救急"},{"id":8853,"word":"剜肉成疮","pinyin":"wān ròu chéng chuāng","abbr":"wrcc","explanation":"本想割肉医疮，但被割之处反成新疮。比喻行事只顾一面，结果与预想适得其反。","source":{"text":"剜肉成疮，有根本先拨之虑；张颐待哺，有樵苏后爨之忧。","book":"宋·崔与之《辞免除四川制置使札子》"},"similar":["剜肉补疮","剜肉做疮"],"usage":"作宾语、定语；多用于比喻句"},{"id":8854,"word":"剜肉生疮","pinyin":"wān ròu shēng chuāng","abbr":"wrsc","explanation":"犹剜肉成疮。比喻行事只顾一面，结果与预想适得其反。","source":{"text":"大抵宋人好矜博雅，又好穿凿；故此种剜肉生疮之说，不一而足。","book":"清·袁枚《随园诗话》第一卷"},"similar":["剜肉成疮","剜肉做疮"],"usage":"作宾语、定语；多用于比喻句"},{"id":8855,"word":"剜肉补疮","pinyin":"wān ròu bǔ chuāng","abbr":"wrbc","explanation":"剜：用刀挖去。挖下身上的好肉来补伤口。比喻只顾眼前，用有害的方法来救急。","source":{"text":"二月卖新丝，五月粜新谷。医得眼前疮，剜却心头肉。","book":"唐·聂夷中《伤田家》诗"},"example":{"text":"那只有用～的方法拼命放盘卖贱货，且捞几个钱来渡过了眼前再说。","book":"茅盾《林家铺子》"},"similar":["杀鸡取卵","补疮剜肉"],"opposite":["事半功倍"],"usage":"作谓语、宾语、定语；指用有害的方法来救急"},{"id":8856,"word":"剥复之机","pinyin":"bō fù zhī jī","abbr":"bfzj","explanation":"剥复：《周易》的二卦名，剥落与来复；机：时机。盛衰、消长的时机。","source":{"text":"剥，烂也；复，反也。","book":"《周易·杂卦》"},"example":{"text":"极论世运～及人主当法天者。","book":"《宋史·程元风传》"},"usage":"作宾语；指变化时机"},{"id":8857,"word":"剥床以肤","pinyin":"bō chuáng yǐ fū","abbr":"bcyf","explanation":"剥：六十四卦之一，指伤害；床：卧具。损害到肌肤。形容迫切的灾害或深切的痛苦。","source":{"text":"剥床以肤，凶。","book":"《周易·剥》"},"similar":["剥床及肤"],"usage":"作宾语、定语；指痛苦之深"},{"id":8858,"word":"剥床及肤","pinyin":"bō chuáng jí fū","abbr":"bcjf","explanation":"剥：六十四卦之一，坤下艮上，意即剥落、烂；及：到。原指损害及于肌肤。后形容迫切的灾害或深切的痛苦。","source":{"text":"剥床以肤，凶。","book":"《周易·剥》"},"example":{"text":"～，其忧岂不在民乎！","book":"宋·陈亮《义乌县减酒额记》"},"similar":["剥床以肤"],"usage":"作宾语、定语；指痛苦之深"},{"id":8859,"word":"剥极则复","pinyin":"bō jí zé fù","abbr":"bjzf","explanation":"剥卦阴盛阳衰，复卦阴极而阳复。比喻物极必反，否极泰来。","source":{"text":"抑闻大《易》之义，剥极则复，否极则泰。吾中国今日之弱，岂犹未极耶？思之思之。","book":"梁启超《中国积弱溯源论》"},"similar":["剥极必复","物极必反"],"usage":"作宾语、定语；指事物相互转化"},{"id":8860,"word":"剥极将复","pinyin":"bō jí jiāng fù","abbr":"bjjf","explanation":"剥卦阴盛阳衰，复卦阴极而阳复。比喻物极必反，否极泰来。","source":{"text":"隋炀帝艳情篇什，同符后主，而边塞诸作，铿然独异，剥极将复之候也。","book":"清·沈德潜《说诗晬语》卷上"},"similar":["剥极必复","物极必反"],"usage":"作宾语、定语；指事物相互转化"},{"id":8861,"word":"剥极必复","pinyin":"bō jí bì fù","abbr":"bjbf","explanation":"剥卦阴盛阳衰，复卦阴极而阳复。比喻物极必反，否极泰来。","source":{"text":"剥极必复，否极必泰，循环之理，不减毫发。","book":"陈其美《致黄克强书》"},"similar":["乐极生悲","盛极必衰","物极必反"],"usage":"作宾语、定语；指事物相互转化"},{"id":8862,"word":"剥皮抽筋","pinyin":"bō pí chōu jīn","abbr":"bpcj","explanation":"形容恨之入骨或极端凶残。","source":{"text":"梅山猴头，焉敢弄术！拿住你定要剥皮抽筋！","book":"明·许仲琳《封神演义》第92回"},"example":{"text":"他最怕的就是～。"},"usage":"作谓语、定语；指残忍"},{"id":8863,"word":"剥肤之痛","pinyin":"bō fū zhī tòng","abbr":"bfzt","explanation":"剥：剥去。肤：皮肤。指受害极深而引起的痛苦。","source":{"text":"剥床以肤，凶。","book":"《周易·剥》"},"example":{"text":"我不想再有～。"},"similar":["切肤之痛"],"usage":"作宾语；同“切肤之痛”"},{"id":8864,"word":"剥肤及髓","pinyin":"bō fū jí suǐ","abbr":"bfjs","explanation":"比喻盘剥深重。","source":{"text":"拥兵者第馆豆街陌，奴婢厌酒肉，而贫人羸饿就役，剥肤及髓。","book":"《新唐书·独孤及传》"},"example":{"text":"民生困苦，谓私派倍于官征，杂项浮于正额；分外诛求，入名赔补；种种朘刻，～。","book":"《天讨·豕韦之裔》"},"similar":["剥床以肤"],"usage":"作谓语、定语；指盘剥之深"},{"id":8865,"word":"剥肤椎髓","pinyin":"bō fū chuí suǐ","abbr":"bfcs","explanation":"剥：剥去；肤：皮肤；椎：捶击。剥人皮肤，敲人骨髓。比喻极其残酷地压榨和剥削。","source":{"text":"而公承死亡之后，掇拾之余，剥肤椎髓，公私扫地赤立。","book":"唐·韩愈《郓州溪堂诗》序"},"example":{"text":"世方以阿意顺旨为贤，～为能。","book":"明·焦竑《玉堂丛语·政事》"},"similar":["剥肤锥髓"],"usage":"作谓语；指残酷敲诈"},{"id":8866,"word":"剥肤锤髓","pinyin":"bō fū chuí suǐ","abbr":"bfcs","explanation":"剥：剥去；肤：皮肤；锤：敲击。剥人皮肤，敲人骨髓。比喻极其残酷地压榨和剥削。","example":{"text":"侵略者对被占领土的居民进行～的残酷统治。"},"similar":["剥肤椎髓"],"usage":"作谓语、宾语、定语；指残酷敲诈"},{"id":8867,"word":"剥肤锥髓","pinyin":"bō fū chuí suǐ","abbr":"bfzs","explanation":"剥人皮肤，敲人骨髓。比喻极其残酷地压榨和剥削。同“剥肤椎髓”。","source":{"text":"百姓亦曰：我辈剥肤锥髓，以供赋敛，而浩浩入群臣之家，如泥沙不惜，其心安得？","book":"宋·司马光《遗留物第二札子》"},"similar":["剥肤椎髓"],"usage":"作谓语；指残酷敲诈"},{"id":8868,"word":"剥茧抽丝","pinyin":"bō jiǎn chōu sī","abbr":"bjcs","explanation":"比喻根据顺序寻求事物的发生发展过程。","source":{"text":"疑难是思想的起点与核心，思想由此出发，根据有关事实资料，寻求关系条理，逐渐剥茧抽丝，披沙拣金。","book":"朱光潜《艺文杂谈·谈对话体》"},"example":{"text":"这整个过程，犹如～，写得很细致，很有层次。","book":"《人民日报》1974.11.2"},"similar":["顺藤摸瓜","披沙拣金"],"opposite":["本末倒置"],"usage":"作谓语、宾语；比喻按事物发展规律办事"},{"id":8869,"word":"剩山残水","pinyin":"shèng shān cán shuǐ","abbr":"sscs","explanation":"残破的山河。多形容亡国后的或经过变乱后的土地景物。也比喻未被消除而剩下来的事物。","source":{"text":"收回那十八省剩山残水，洗尽这二百年藏污纳垢。","book":"清·孙雨林《皖江血·定计》"},"similar":["剩水残山"],"usage":"作主语、宾语；指残破的山河"},{"id":8870,"word":"剩水残山","pinyin":"shèng shuǐ cán shān","abbr":"sscs","explanation":"残破的山河。多形容亡国后的或经过变乱后的土地景物。也比喻未被消除而剩下来的事物。","source":{"text":"剩水沧江破，残山碣石开。","book":"唐·杜甫《游何将军山林》诗"},"example":{"text":"～无太度，被誉为疏梅，料理成风月。","book":"宋·辛弃疾《贺新郎》词"},"similar":["残山剩水","剩山残水"],"usage":"作主语、宾语；指残破的山河"},{"id":8871,"word":"剩汤腊水","pinyin":"shèng tāng là shuǐ","abbr":"stls","explanation":"吃剩下来的饭菜。","source":{"text":"做菜做饭全托付给了小福子，自然那些剩汤腊水的就叫小福子拿去给弟弟们吃。","book":"老舍《骆驼祥子》"},"similar":["残羹冷炙","剩菜残羹"],"usage":"作主语、宾语、定语；用于生活"},{"id":8872,"word":"剩菜残羹","pinyin":"shèng cài cán gēng","abbr":"sccg","explanation":"吃剩的食物。比喻弃余无用之物。","source":{"text":"这是一沟绝望的死水，清风吹不起半点漪沦；不如多扔些破铜烂铁，爽性泼你的剩菜残羹。","book":"闻一多《死水》诗"},"similar":["残羹冷炙"],"usage":"作宾语、定语；形容吃剩的食物"},{"id":8873,"word":"剩蕊残葩","pinyin":"shèng ruǐ cán pā","abbr":"srcp","explanation":"蕊：花蕊；葩：花。比喻已被摧残蹂躏的女子。","source":{"text":"虽然一霎之情，义坚金石，他日勿使剩蕊残葩，空随流水。","book":"明·凌濛初《初刻拍案惊奇》第32卷"},"similar":["残花败柳"],"usage":"作宾语、定语；多用于比喻句"},{"id":8874,"word":"剩馥残膏","pinyin":"shèng fù cán gāo","abbr":"sfcg","explanation":"女子妆后所剩的脂粉。指闺中之作。","source":{"text":"铜琶铁板声声恨，剩馥残膏字字哀。","book":"《二十年目睹之怪现状》第四九回"},"usage":"作主语、宾语、定语；用于书面语"},{"id":8875,"word":"剪发待宾","pinyin":"jiǎn fà dài bīn","abbr":"jfdb","explanation":"待：招待。原指晋代大诗人陶侃的母亲将头发剪下来卖掉，以招待客人。比喻真心实意地招待客人。","source":{"text":"湛头发委地，下为二发，卖得觯米。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"想当日孟母教子，居必择邻，陶母教子，～。","book":"元·关汉卿《蝴蝶梦》第二折"}},{"id":8876,"word":"剪发披缁","pinyin":"jiǎn fā pī zī","abbr":"jfpz","explanation":"削发，身着僧尼服装。指出家为僧尼。亦作“剪发被褐”。","source":{"text":"妾便舍弃人事，剪发披缁，夙昔之愿。","book":"唐·蒋防《霍小玉传》"},"similar":["削发为僧"],"usage":"作谓语、宾语；指出家为僧尼"},{"id":8877,"word":"剪发披褐","pinyin":"jiǎn fà pī hè","abbr":"jfph","explanation":"剪发：剪掉头发，指削发为僧；褐：兽毛或粗麻制成的短衣。比喻剪发为僧。","source":{"text":"里中豪族争求聘，娥誓心不嫁。遂剪发被褐，访道于牛头山。","book":"唐·李公佐《谢小娥传》"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第19卷：“复仇已毕，其时即～，访道于牛头山。”"},"similar":["剪发披缁","剪发被褐"],"usage":"作谓语、宾语；指出家为僧尼"},{"id":8878,"word":"剪发杜门","pinyin":"jiǎn fà dù mén","abbr":"jfdm","explanation":"剪发：剪掉头发，指削发为僧；杜门：闭门。剪发为僧，闭门不出。","source":{"text":"由是以之，则今之高爵显位，一旦抵罪，或脱身以逃，不能容于远近，而又有剪发杜门，佯狂不知所之者，其辱人贱行，视五人之死，轻重固何如哉？","book":"明·张溥《五人墓碑记》"},"usage":"作谓语、定语；用于处事"},{"id":8879,"word":"剪发被褐","pinyin":"jiǎn fā bèi hè","abbr":"jfbh","explanation":"指出家为僧尼。同“剪发披缁”。","source":{"text":"里中豪族争求聘，娥誓心不嫁。遂剪发被褐，访道于牛头山。","book":"唐·李公佐《谢小娥传》"},"similar":["剪发披褐"],"usage":"作谓语、宾语；指出家为僧尼"},{"id":8880,"word":"剪恶除奸","pinyin":"jiǎn è chú jiān","abbr":"jecj","explanation":"剪、除：扫除。扫除恶人与奸人。","source":{"text":"似你我行侠尚义，理应济困扶危，剪恶除奸。","book":"清·石玉昆《三侠五义》第六十回"},"example":{"text":"你我行侠仗义，本应当济困扶危，～。","book":"伍心铭《包青天》第八章"},"usage":"作谓语、定语、宾语；指扫除恶人"},{"id":8881,"word":"剪枝竭流","pinyin":"jiǎn zhī jié liú","abbr":"jzjl","explanation":"比喻不从根本上解决问题。","source":{"text":"堰水先塞其源，伐木必拔其本，源不塞，本不拔，虽剪枝竭流，终不可绝矣。","book":"《魏书·高闾传》"},"usage":"作宾语、定语；用于处事"},{"id":8882,"word":"剪烛西窗","pinyin":"jiǎn zhú xī chuāng","abbr":"jzxc","explanation":"原指思念远方妻子，盼望相聚夜语。后泛指亲友聚谈。","source":{"text":"何当共剪西窗烛，却话巴山夜雨时。","book":"唐·李商隐《夜雨寄北》诗"},"example":{"text":"今视之殆如梦寐，与谈诗文，慧黠可爱。～，如得良友。","book":"清·蒲松龄《聊斋志异·连琐》"},"similar":["西窗剪烛"],"usage":"作宾语、定语；泛指亲友灯下聚谈","story":["唐朝时期，诗人李商隐任东川节度使柳仲郢幕僚，四川一向多雨多雾，阴雨绵绵。他身处异乡，面对秋雨夜深人静，勾起对妻子的怀念，作诗《夜雨寄北》诗：“君问归期未有期，巴山夜雨涨秋池。何当共剪西窗烛，却话巴山夜雨时。”"]},{"id":8883,"word":"剪草除根","pinyin":"jiǎn cǎo chú gēn","abbr":"jccg","explanation":"除草时要连根除掉，使草不能生长。比喻除去祸根，以免后患。","source":{"text":"为国家者，见恶，如农夫之务去草焉，芟夷蕰崇之，绝其本根，勿使能殖。","book":"《左传·隐公六年》"},"example":{"text":"当局为了～，下令解散学校，把学生和教职员一律轰出来。","book":"梁斌《红旗谱》四十九"},"similar":["斩尽杀绝","斩草除根"],"opposite":["放虎归山"],"usage":"作谓语、宾语；比喻除去祸根，不留后患"},{"id":8884,"word":"剪莽拥彗","pinyin":"jiǎn mǎng yōng huì","abbr":"jmyh","explanation":"莽：草；彗：扫帚。剪除杂草，手持扫帚。指辛勤劳动。","source":{"text":"乃剪莽拥彗，类男子操作。","book":"清·蒲松龄《聊斋志异·红玉》"}},{"id":8885,"word":"剪虏若草","pinyin":"jiǎn lǔ ruò cǎo","abbr":"jlrc","explanation":"剪：剪除；虏：敌人。消灭敌人就象割除杂草一样。形容勇不可挡。","source":{"text":"尔随汉将出门去，剪虏若草收奇功。","book":"唐·李白《送族弟绾从军安西》"}},{"id":8886,"word":"剪须和药","pinyin":"jiǎn xū huò yào","abbr":"jxhy","explanation":"剪：剪掉；须：胡须；和：调制。剪下胡须调制配药。比喻体恤下属。","source":{"text":"勣既忠力，帝谓可托大事，尝暴疾，毉曰：‘用须灰可治。’帝乃自剪须以和药，及愈入谢，顿首流血。帝曰：‘吾为社稷计，何谢之。’","book":"《新唐书·李勣传》"},"usage":"作宾语、定语；用于处事","story":["唐朝初年，李勣忠心效力朝廷，皇帝认为他是一个可托付大事的人。一次李勣生了重病，医生说要用胡须作药引。皇帝立即自剪胡须给他当药引和药，不久李勣病愈入朝拜谢，磕头磕到流血。皇帝说：“这没什么，我是在为江山社稷考虑。”"]},{"id":8887,"word":"割剥元元","pinyin":"gē bō yuán yuán","abbr":"gbyy","explanation":"割剥：残害，掠夺；元元：老百姓。指掠夺人民。","source":{"text":"割剥元元，残贤害良。","book":"《汉书·匈奴传》：“割剥百姓，以奉寇仇。”《三国志·魏志·袁绍传》裴松之注引《魏氏春秋·檄州郡文》"},"example":{"text":"而操遂承资跋扈，恣行凶忒，～，残贤害善。","book":"明·罗贯中《三国演义》第二十二回"}},{"id":8888,"word":"割地求和","pinyin":"gē dì qiú hé","abbr":"gdqh","explanation":"割让土地，求得和平。","source":{"text":"故不如亟割地求和，以疑天下，而慰秦之心。","book":"《史记·平原君列传》"},"example":{"text":"打了胜仗，反而～，……就是外国人也觉得诧异。","book":"李劼人《暴风雨前》第三部分"},"similar":["割地称臣"],"usage":"作谓语、宾语、定语；用于处事"},{"id":8889,"word":"割地称臣","pinyin":"gē dì chēng chén","abbr":"gdcc","explanation":"割让土地，臣服于对方。","source":{"text":"若放我南归，愿为金邦细作。侥幸一朝得志，必当主持和议，使南朝割地称臣。","book":"明·冯梦龙《喻世明言》第32卷"},"example":{"text":"～的做法是十分不明智的。"},"similar":["割地求和"],"usage":"作谓语、宾语、定语；指投降"},{"id":8890,"word":"割席分坐","pinyin":"gē xí fēn zuò","abbr":"gxfz","explanation":"席：坐席。把席割断，分开坐。比喻朋友绝交。","source":{"text":"又尝同席读书，有乘轩冕过门者，宁读书如故，歆废书出看。宁割席分坐，曰：‘子非吾友也。’","book":"南朝·宋·刘义庆《世说新语·德行》"},"similar":["割席断交"],"usage":"作谓语、定语；比喻朋友绝交","story":["汉朝末年，读书人管宁与华歆从小在一起读书，是非常要好的朋友。但两人性格不一样，管宁读书刻苦，不贪慕富贵，华歆行事浮躁，羡慕荣华富贵，渐渐地管宁厌恶他，就把两人共坐的席子割成两半，分席而坐，从此两人断绝交情"]},{"id":8891,"word":"割席断交","pinyin":"gē xí duàn jiāo","abbr":"gxdj","explanation":"席：坐席，草席。把席割开分别坐。比喻朋友绝交。","source":{"text":"又尝同席读书，有乘轩冕过门者，宁读书如故，歆废书出看。宁割席分坐，曰：‘子非吾友也。’","book":"南朝·宋·刘义庆《世说新语·德行》"},"similar":["割席分坐"],"usage":"作谓语、定语；比喻朋友绝交","story":["汉朝末年，读书人管宁与华歆从小在一起读书，是非常要好的朋友。但两人性格不一样，管宁读书刻苦，不贪慕富贵，华歆行事浮躁，羡慕荣华富贵，渐渐地管宁厌恶他，就把两人共坐的席子割成两半，分席而坐，从此两人断绝交情"]},{"id":8892,"word":"割恩断义","pinyin":"gē ēn duàn yì","abbr":"gedy","explanation":"舍弃恩德，断绝道义。","source":{"text":"自桃园缔盟，誓以同死；今何中道相违，割恩断义？","book":"明·罗贯中《三国演义》第二十六回"},"example":{"text":"你难道舍得～吗？"},"usage":"作谓语、宾语、定语；用于交往等"},{"id":8893,"word":"割据一方","pinyin":"gē jù yī fāng","abbr":"gjyf","explanation":"割据：割地占据。凭借武力割占一个地区，与中央政权对立。","source":{"text":"方今朝政颠倒，宦官弄权，官家威令不行，天下英雄皆有割据一方之意。","book":"明·冯梦龙《古今小说·临安里钱婆留发迹》"},"example":{"text":"茅盾《关于长篇小说的通信》：“而献忠却低一头，最多只能乘天下扰攘，～而已。”"},"similar":["各霸一方"],"usage":"作谓语、宾语、定语；用于地方势力等"},{"id":8894,"word":"割据称雄","pinyin":"gē jù chēng xióng","abbr":"gjcx","explanation":"割据：割地占据。以武力割占部分地区，在一国之内形成对抗的局面，以称雄一方。","source":{"text":"皓将败，与舅何植书曰：‘昔大皇帝以神武之略，奋三千之卒，割据江南。’","book":"《三国志·吴志·孙皓传》裴松之注引《江表传》"}},{"id":8895,"word":"割爱见遗","pinyin":"gē ài jiàn yí","abbr":"gajy","explanation":"割：割舍；爱：自己喜爱的；遗：赠送。将自己喜爱的东西送给别人。"},{"id":8896,"word":"割肉补疮","pinyin":"gē ròu bǔ chuāng","abbr":"grbc","explanation":"比喻不计后果以救燃眉之急。","source":{"text":"老师相不必犹这些，依我看，不是‘割肉补疮’，而是‘调度有方’。","book":"谷斯范《新桃花扇》第三一回"},"similar":["挖肉补疮"],"usage":"作谓语、宾语、定语；用于处事"},{"id":8897,"word":"割肉饲虎","pinyin":"gē ròu sì hǔ","abbr":"grsh","explanation":"饲：喂。割下身上的肉喂老虎。比喻既舍弃生命也无法满足对方的贪欲。","source":{"text":"公子喜士，名闻天下，今有难，无他端而欲赴秦军，譬若以肉投馁虎，何功之有哉。","book":"《史记·魏公子列传》"},"example":{"text":"尽管采取了“～”的政策，但是军阀们的野心是永远没有止境的。","book":"陶菊隐《北洋军阀统治时期史话》第六十九章"},"usage":"作谓语、宾语、定语；用于处事"},{"id":8898,"word":"割肚牵肠","pinyin":"gē dù qiān cháng","abbr":"gdqc","explanation":"形容非常牵挂，很不放心。","source":{"text":"想人生最苦是离别，可怜是千里关山，独自跋涉。似这般割肚牵肠，倒不如义断恩绝。","book":"元·王实甫《西厢记》第四本第四折"},"example":{"text":"吾想汝等父母、兄弟、妻子必倚六而望；若知阵败，必然～，眼中流血。","book":"明·罗贯中《三国演义》第八十七回"},"similar":["牵肠挂肚"],"usage":"作谓语、定语；形容非常牵挂，很不放心"},{"id":8899,"word":"割股之心","pinyin":"gē gǔ zhī xīn","abbr":"ggzx","explanation":"割股：割下自己的大腿肉。为了治好病人，不惜牺牲自己的精神。原是封建阶级所宣扬的一种愚孝行为。后泛指医家全心全意为病人诊治。","source":{"text":"医家有割股之心。","book":"清·吴敬梓《儒林外史》第二十四回"}},{"id":8900,"word":"割股疗亲","pinyin":"gē gǔ liáo qīn","abbr":"gglq","explanation":"股：大腿。旧指孝子割舍自己腿上的肉来治疗父母的疾病。","example":{"text":"～的故事感人，但行为不可取。"},"usage":"作宾语、定语；用于孝子等"},{"id":8901,"word":"割臂之盟","pinyin":"gē bì zhī méng","abbr":"gbzm","explanation":"割臂：刺破胳臂；盟：盟约。原指春秋战国时鲁庄公与孟任割破胳臂，订下婚约。后泛指用割破手臂立誓宁约（指男女秘订婚约）。","source":{"text":"初，公筑台，临党氏，见孟任，从之。閟。而以夫人言，许之，割臂盟公。生子般焉。","book":"《左传·庄公三十二年》"},"example":{"text":"如昭公讳孟子之姓，庄公强～，是婚姻之礼废了，那淫僻之乱莫不从此而生。","book":"清·李汝珍清《镜花缘》第五十二回"},"similar":["割臂盟公"],"usage":"作宾语；指男女秘订婚约"},{"id":8902,"word":"割臂盟公","pinyin":"gē bì méng gōng","abbr":"gbmg","explanation":"割臂：刺破胳臂；盟：盟约。原指春秋战国时鲁庄公与孟任割破胳臂，订下婚约。后泛指用割破手臂立誓宁约（指男女秘订婚约）。","source":{"text":"初，公筑台，临党氏，见孟任，从之。閟。而以夫人言，许之，割臂盟公。生子般焉。","book":"《左传·庄公三十二年》"},"similar":["割臂之盟"],"usage":"作谓语、定语；指男女秘订婚约"},{"id":8903,"word":"割襟之盟","pinyin":"gē jīn zhī méng","abbr":"gjzm","explanation":"割襟：指腹为婚时，各自割下衣襟，彼此珍藏作为信物。指男女在未出生前就由其父母订立下婚约。","source":{"text":"诸男女议婚，有以指腹割衿为定婚者，禁之。","book":"《元史·刑法志·二·户婚》"},"example":{"text":"这两家～，果是有之，但工部举家已绝，郎君所遇，乃其幽官，想是夙愿了。","book":"明·凌濛初《二刻拍案惊奇》第三十回"},"similar":["指腹为婚"],"usage":"作主语、宾语；用于约定等"},{"id":8904,"word":"割须弃袍","pinyin":"gē xū qì pào","abbr":"gxqp","explanation":"割掉胡须，丢掉外袍。形容战败落魄的样子。","source":{"text":"超遂令人叫拏短髯者是曹操。操闻之，即扯旗角包颈而逃。","book":"明·罗贯中《三国演义》第58回"},"example":{"text":"曹操“～”的事迹广为流传。"},"similar":["丢盔弃甲"],"usage":"作谓语、定语；指战败","story":["三国时期，曹操派大将钟繇攻蜀未成，退守潼关，就改派曹洪、徐晃驻守潼关，才九天时间曹洪丢了潼关。曹操率军亲自攻打潼关，结果被马超打得大败，为了逃命，曹操割掉自己的胡须，丢掉自己的战袍，化装逃回到自己的大本营"]},{"id":8905,"word":"割须换袍","pinyin":"gē xū huàn páo","abbr":"gxhp","explanation":"须：胡须。形容打了败仗狼狈逃跑。","source":{"text":"超遂令人叫拏短髯者是曹操。操闻之，即扯旗角包颈而逃。","book":"明·罗贯中《三国演义》第58回"},"example":{"text":"请不要笑曹操～的事。"},"similar":["割髯换袍"],"usage":"作谓语、定语；指战败狼狈样","story":["三国时期，曹操派大将钟繇攻蜀未成，退守潼关，就改派曹洪、徐晃驻守潼关，才九天时间曹洪丢了潼关。曹操率军亲自攻打潼关，结果被马超打得大败，为了逃命，曹操割掉自己的胡须，丢掉自己的战袍，化装逃回到自己的大本营"]},{"id":8906,"word":"割骨疗亲","pinyin":"gē gǔ liáo qīn","abbr":"gglq","explanation":"股：大腿。旧指孝子割舍自己腿上的肉来治疗父母的疾病。"},{"id":8907,"word":"割鸡焉用牛刀","pinyin":"gē jī yān yòng niú dāo","abbr":"gjyynd","explanation":"杀只鸡何必用宰牛的刀。比喻办小事情用不着花大气力。","source":{"text":"杀只鸡何必用宰牛的刀。比喻办小事情用不着花大气力。"},"example":{"text":"杀只鸡何必用宰牛的刀。比喻办小事情用不着花大气力。"},"similar":["大材小用","小题大作"],"usage":"作宾语、分句；指不值得小题大作"},{"id":8908,"word":"剸繁决剧","pinyin":"shí fán jué jù","abbr":"tfjj","explanation":"指裁处繁剧的政务。亦作“剸繁治剧”。"},{"id":8909,"word":"剸繁治剧","pinyin":"shí fán zhì jù","abbr":"tfzj","explanation":"指裁处繁剧的政务。同“剸繁决剧”。"},{"id":8910,"word":"剽疾轻悍","pinyin":"piāo jí qīng hàn","abbr":"pjqh","explanation":"剽：轻捷；悍：勇敢。作战勇猛，动作迅捷，而性格急躁轻敌。","source":{"text":"剽疾轻悍，勇敢轻敌。","book":"西汉·刘安《淮南子·兵略讯》"},"usage":"作谓语、定语；指人勇敢"},{"id":8911,"word":"剿抚兼施","pinyin":"jiǎo fǔ jiān shī","abbr":"jfjs","explanation":"剿：剿灭，讨伐；抚：安抚；兼施：同时使用。剿灭与安抚同时进行。","source":{"text":"百龄乘闽、浙殄贼之后，剿抚兼施，遂如摧枯拉朽。","book":"《清史稿·许廷桂传》"},"example":{"text":"原来拖雷军北往呼罗珊，沿阿母河西岸进发，所过城寨，～，倒也觉得顺手。","book":"蔡东藩《元史演义》第十三回"}},{"id":8912,"word":"劈两分星","pinyin":"pǐ liǎng fēn xīng","abbr":"plfx","explanation":"劈：分开；星：秤杆上的小点子。指过分计较微薄小利。","source":{"text":"那时昧己瞒心，劈两分星，细切薄批。","book":"元·马致远《任风子》第三折"},"similar":["分星劈两"],"usage":"作谓语、定语；指斤斤计较"},{"id":8913,"word":"劈劈啪啪","pinyin":"pī pī pā pā","abbr":"pppp","explanation":"形容爆裂、拍打的声音。","source":{"text":"碎石头顿时劈劈啪啪落在了院子里！","book":"路遥《平凡的世界》第一卷第50章"},"example":{"text":"路遥《平凡的世界》第一卷第50章：“碎石头顿时～落在了院子里！”"},"similar":["劈里啪啦","噼里啪啦"],"usage":"作定语、状语；用于声音"},{"id":8914,"word":"劈天盖地","pinyin":"pī tiān gài dì","abbr":"ptgd","explanation":"划破天空，笼罩着大地，形容声势浩大。","example":{"text":"大雨倾盆泻下，雷声闪电～地掠过。"},"usage":"作状语；形容声势浩大"},{"id":8915,"word":"劈头劈脑","pinyin":"pī tóu pī nǎo","abbr":"ptpn","explanation":"正对着头部。","source":{"text":"杨志拿着藤条，劈头劈脑打去。","book":"明·施耐庵《水浒传》"},"example":{"text":"他～给人打了一顿。"},"similar":["劈头盖脸"],"usage":"作状语；指正对着头部"},{"id":8916,"word":"劈头劈脸","pinyin":"pī tóu pī liǎn","abbr":"ptpl","explanation":"劈：正对着，冲着。正对着头和脸盖下来。形容来势很猛，不容躲避。","source":{"text":"夺过士兵手里的棍棒，劈头劈脸便打。","book":"明·施耐庵《水浒全传》第十四回"},"example":{"text":"金二员外来亲近他时，被他～，抓有几个血痕。","book":"明·冯梦龙《醒世恒言》卷三"},"similar":["劈头盖脸","劈头劈脑","披头盖脑"],"usage":"作定语、状语；形容态度不好"},{"id":8917,"word":"劈头盖脑","pinyin":"pī tóu gài nǎo","abbr":"ptgn","explanation":"劈：正对着，冲着；盖：压。正对着头和脸盖下来。形容来势很猛，不容躲避。","source":{"text":"夺过士兵手里的棍棒，劈头劈脸便打。","book":"明·施耐庵《水浒全传》第十四回"},"example":{"text":"雨呀，～地浇下来，顺脖子灌下去。","book":"杜鹏程《保卫延安》第五章"}},{"id":8918,"word":"劈头盖脸","pinyin":"pī tóu gài liǎn","abbr":"ptgl","explanation":"劈：正对着，冲着；盖：压。正对着头和脸盖下来。形容（打击、冲击、批评等）来势很猛。","source":{"text":"晃盖喝道：‘你既不做贼，如何拿你在这里？’夺过士兵手里棍棒，劈头盖脸便打。","book":"明·施耐庵《水浒传》第14回"},"example":{"text":"他一进门～便骂小孩。"},"similar":["气势汹汹","铺天盖地"],"opposite":["和风细雨"],"usage":"作宾语、状语；形容态度不好"},{"id":8919,"word":"劈空扳害","pinyin":"pī kōng pān hài","abbr":"pkbh","explanation":"劈空：什么都没有；扳：通“攀”，牵扯。毫无根据地栽赃陷害。","source":{"text":"与众人不曾识面，不知何人仇恨，指使劈空扳害。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"usage":"作谓语、宾语；指栽赃"},{"id":8920,"word":"劈荆斩棘","pinyin":"pī jīng zhǎn jí","abbr":"pjzj","explanation":"①砍伐荆棘。②比喻扫除前进中的困难和障碍。","source":{"text":"你可曾望到啊，灯光下：好像举起南泥湾劈荆斩棘的镢头？","book":"贺敬之《西去列车的窗口》"},"example":{"text":"～开新路，社会主义展宏图。"},"similar":["披荆斩棘","斩荆披棘"],"usage":"作谓语、宾语、状语；形容创业的艰苦"},{"id":8921,"word":"劈里啪啦","pinyin":"pī lǐ pā lā","abbr":"plpl","explanation":"象声词，形容爆裂、拍打等的连续声音。","source":{"text":"彩娥说着，就用手摇了摇地畔上的一棵枣树，熟透的红枣子就劈里啪啦在少安周围落了许多。","book":"路遥《平凡的世界》第二卷第29章"},"example":{"text":"外面鞭炮～地响。"},"similar":["噼里啪啦"],"usage":"作状语；指爆裂的声音"},{"id":8922,"word":"劈风斩浪","pinyin":"pī fēng zhǎn làng","abbr":"pfzl","explanation":"指冲破风浪。","source":{"text":"在西沙保卫战中，一批刚刚穿上海军服的青年战士，驾着战舰，劈风斩浪，无所畏惧地同敌舰格斗，为保卫祖国的宝岛立下了不朽的功勋。","book":"《人民日报》1976.6.25"},"example":{"text":"她驾驶一条小船～地来到这个小岛。"},"similar":["乘风破浪"],"usage":"作谓语、状语、定语；指克服困难"},{"id":8923,"word":"劚山觅玉","pinyin":"zhú shān mì yù","abbr":"zsmy","explanation":"比喻深入推究，求得事物真谛。","source":{"text":"如披沙拣金，劚山觅玉，不格到十分真处，怎知到十分至处？","book":"明·吕坤《答孙冢宰立亭论格物第二书》"},"usage":"作宾语、定语；用于书面语"},{"id":8924,"word":"劚玉如泥","pinyin":"zhú yù rú ní","abbr":"zyrn","explanation":"形容刀刃极其锋利。","source":{"text":"董卓少时耕野，得一刀，无文字，四面隐起作山云文，劚玉如泥。","book":"南朝·梁·陶弘景《古今刀剑录》"},"usage":"作谓语、定语；用于书面语"},{"id":8925,"word":"力不从心","pinyin":"lì bù cóng xīn","abbr":"lbcx","explanation":"心里想做，可是力量够不上。","source":{"text":"今使者大兵未能得出，如诸国力不从心，东西南北自在也。","book":"《后汉书·西域传》"},"example":{"text":"按我的政治思想水平、斗争阅历和知识能力，担当编选陈毅同志诗词的工作确是～。","book":"张茜《陈毅诗词选集·序言》"},"similar":["无能为力","心有余而力不足"],"opposite":["得心应手","力所能及"],"usage":"作谓语、宾语；用于谦辞","story":["东汉时期，班超为平定匈奴作乱，70多岁还在西域作战，他身体日渐衰弱，上书汉和帝要求回中原养老。他的妹妹班昭也上书奏请说班超老了，再有战事就力不从心了，汉和帝看了二人的奏折，不断地点头，于是下诏让班超回京"]},{"id":8926,"word":"力不从愿","pinyin":"lì bù cóng yuàn","abbr":"lbcy","explanation":"从：依从、顺从。心里想做，但是力量够不上。","source":{"text":"徒怀愤踊，力不从愿，惭怖征营，痛心疾首，形留所在，神驰寇庭。","book":"《晋书·刘琨传》"},"example":{"text":"勒据襄国，与臣隔山，朝发夕至，城坞骇惧，虽怀忠愤，～耳！","book":"《资治通鉴·晋纪十一》"},"similar":["力不从心","力不副心"],"usage":"作谓语、宾语；用于谦辞"},{"id":8927,"word":"力不副心","pinyin":"lì bù fù xīn","abbr":"lbfx","explanation":"副：符合。心里想做，但是力量够不上。","source":{"text":"何幸明灵俯降，但揣微贱，力不副心，荀可施于区区，敢不从命。","book":"唐·无名氏《阴德传·韦判官》"},"similar":["力不从心","力不从愿"],"opposite":["得心应手"],"usage":"作谓语、宾语；用于谦辞"},{"id":8928,"word":"力不同科","pinyin":"lì bù tóng kē","abbr":"lbtk","explanation":"科：等第。力量的大小不一样。","source":{"text":"射不主皮，为力不同科，古之道也。","book":"《论语·八佾》"},"usage":"作宾语、定语；用于书面语"},{"id":8929,"word":"力不胜任","pinyin":"lì bù shèng rèn","abbr":"lbsr","explanation":"胜任：能担当得起。能力担当不了。","source":{"text":"德薄而位尊，知小而谋大，力小而任重，鲜不及矣。","book":"《周易·系辞下》"},"example":{"text":"如不具限状，即系才力不能胜任，立予撤参，不使恋栈贻误。","book":"清·林则徐《江苏阴雨连绵田稻歉收情情形片》"},"similar":["力所不及","无能为力"],"opposite":["得心应手","力所能及"],"usage":"作谓语、定语；用于谦辞"},{"id":8930,"word":"力不能及","pinyin":"lì bù néng jí","abbr":"lbnj","explanation":"力量达不到。","source":{"text":"一城百姓见城自摧破，自来搜捉纣王，纣王见兵势甚大，力不能及。","book":"元·无名氏《武王伐纣平话》下卷"},"example":{"text":"我们不能让孩子干～的事情。"},"similar":["力不能支"],"opposite":["力所能及"],"usage":"作定语；指力量达不到"},{"id":8931,"word":"力不能支","pinyin":"lì bù néng zhī","abbr":"lbnz","explanation":"力量不能支撑。","source":{"text":"大厦将倾，非一木所支也。","book":"隋·王通《文中子·事君》"},"example":{"text":"南宫适大战黄元济，未及三十回合，元济非南宫适敌手，～。","book":"明·许仲琳《封神演义》第二十八回"},"similar":["力所不及","无能为力"],"opposite":["游刃有余","力挽狂澜"],"usage":"作谓语、定语、宾语；指力量所不能支撑"},{"id":8932,"word":"力不自胜","pinyin":"lì bù zì shèng","abbr":"lbzs","explanation":"胜：经得住。由于力量不够而使得自己经受不起。","source":{"text":"无饮实可实口，无窟穴可庇身，饥窘困迫，力不自胜。","book":"宋·张敦颐《六朝事迹·郗民化蛇》"},"example":{"text":"对一位正难过着的女大学生，有时候显然是～的事。","book":"梁晓声《表弟》二"},"similar":["力不胜任"],"usage":"作谓语、定语；用于处事"},{"id":8933,"word":"力争上游","pinyin":"lì zhēng shàng yóu","abbr":"lzsy","explanation":"上游：河的上流，比喻先进的地位。努力奋斗，争取先进再先进。","source":{"text":"所以才智人，不肯自弃暴，力欲争上游，性灵乃其要。","book":"清·赵翼《瓯北诗话·五言古·闲居读书作之五》"},"example":{"text":"那是～的一种树，笔直的干，笔直的枝。","book":"茅盾《白杨礼赞》"},"similar":["奋发图强","再接再厉"],"opposite":["故步自封","安于现状","踌躇不前"],"usage":"作谓语、宾语、定语；指努力上进"},{"id":8934,"word":"力倍功半","pinyin":"lì bèi gōng bàn","abbr":"lbgb","explanation":"指工作费力大，收效小。","source":{"text":"盖得之，则不啻乎事半而功倍也；失之，则不啻乎事倍而功半也。","book":"唐·白居易《为人上宰相书》"},"example":{"text":"防微遏几，百病不生，几动形见，～。","book":"明·刘基《赠陈伯光诗序》"},"similar":["事倍功半"],"opposite":["事半功倍"],"usage":"作谓语；指劳而无功"},{"id":8935,"word":"力分势弱","pinyin":"lì fēn shì ruò","abbr":"lfsr","explanation":"分：分开。力量分散势力就减弱。","source":{"text":"今同若隋政，各兴大义，力分势弱，常恐见擒，何不合以为强。","book":"《旧唐书·杜伏威传》"},"usage":"作谓语、定语；用于局势"},{"id":8936,"word":"力可拔山","pinyin":"lì kě bá shān","abbr":"lkbs","explanation":"力气大得可以拔起山来，形容勇力过人。","source":{"text":"力拔山兮气盖世，时不利兮骓不逝。","book":"楚·项羽《垓下歌》"},"similar":["力敌千钧","拔山抗鼎"],"usage":"作谓语、定语；用于人"},{"id":8937,"word":"力困筋乏","pinyin":"lì kùn jīn fá","abbr":"lkjf","explanation":"用尽了全身力气，已经筋疲力尽。","source":{"text":"如今容颜瘦，倒不如受辛勤还家罢，我如今力困筋乏。","book":"元·贾仲名《开仙梦》第三折"},"similar":["筋疲力尽"],"opposite":["精神抖擞"],"usage":"作谓语、定语、状语；指非常辛苦"},{"id":8938,"word":"力均势敌","pinyin":"lì jūn shì dí","abbr":"ljsd","explanation":"双方力量相等，不分高低。","source":{"text":"两智不能相使，两贤不能相临，两辨不能相屈。力均势敌故力。","book":"马总《意林》引《尹文子》"},"example":{"text":"夫～，则进德者胜。","book":"《周书·儒林传·乐逊》"},"similar":["势均力敌","力钧势敌"],"opposite":["天差地别"],"usage":"作谓语、定语；用于矛盾冲突的双方"},{"id":8939,"word":"力士捉蝇","pinyin":"lì shì zhuō yíng","abbr":"lszy","explanation":"比喻做小事也不能轻视。","source":{"text":"犹如力士捉蝇太急，蝇即便死；捉蝇太缓，蝇便飞去。","book":"《中阿含经》"}},{"id":8940,"word":"力大无比","pinyin":"lì dà wú bǐ","abbr":"ldwb","explanation":"形容力量巨大。","source":{"text":"这兄弟两个各使一根铁棍，力大无比。","book":"清·钱彩《说岳全传》第17回"},"example":{"text":"形容力量巨大。"},"similar":["拔山扛顶"],"opposite":["软弱无力"],"usage":"作谓语；形容力量巨大"},{"id":8941,"word":"力大无穷","pinyin":"lì dà wú qióng","abbr":"ldwq","explanation":"形容力量很大。","source":{"text":"这些宫娥都是力大无穷，就如鹰拿燕雀一般，那里由他作主。","book":"清·李汝珍《镜花缘》第三十三回"},"example":{"text":"清·李汝珍《镜花缘》第三十三回：“这些宫娥都是力大无穷，就如鹰拿燕雀一般，那里由他作主。”"}},{"id":8942,"word":"力学不倦","pinyin":"lì xué bù juàn","abbr":"lxbj","explanation":"力学：努力学习。倦：疲倦。勤勉学习而不知疲倦。","source":{"text":"以其警悟异常，泌之故人为宰相，左右援拯，后得累居郡守，而力学不倦。","book":"《旧唐书·子繁传》"}},{"id":8943,"word":"力学笃行","pinyin":"lì xué dǔ xíng","abbr":"lxdx","explanation":"力学：努力学习。笃行：切实地实行。勤勉学习且确切实践所学。","source":{"text":"伯政家世为儒，力学笃行，至老不少衰。","book":"宋·陆游《陆伯政山堂稿序》"},"example":{"text":"孝孺有兄孝闻，～，先孝孺死。","book":"《明史·方孝孺传》"},"usage":"作谓语、定语；用于书面语"},{"id":8944,"word":"力小任重","pinyin":"lì xiǎo rèn zhòng","abbr":"lxrz","explanation":"能力小，负担重。犹言力不胜任。","source":{"text":"今浚之罪乃在于志广才疏，力小任重，不能谘诹良策，而专于自用。","book":"《易·系辞下》：“德薄而位尊，知小而谋大，力小而任重，鲜不及矣。”宋·李纲《奏陈利害札子》"},"example":{"text":"本之德薄位尊，～，其见诋诬非不幸也。","book":"明·张居正《答松谷陈相公》"},"similar":["力微任重"],"usage":"作谓语、定语；多用于自谦"},{"id":8945,"word":"力尽神危","pinyin":"lì jìn shén wēi","abbr":"ljsw","explanation":"危：危急。气力用尽，神色危急。形容用心用力过度，体力不支的样子。","source":{"text":"话说宝玉见晴雯将雀裘补完，已使得力尽神危，忙命小丫头替他捶着。","book":"清·曹雪芹《红楼梦》第五十三回"},"example":{"text":"看到他～的模样，我们很同情他"},"similar":["筋疲力尽","精疲力竭"],"usage":"作定语、状语；用于人境况"},{"id":8946,"word":"力尽筋疲","pinyin":"lì jìn jīn pí","abbr":"ljjp","explanation":"尽：完；筋：筋骨。形容非常疲乏，一点力气也没有了。","source":{"text":"虽时侵掠，小有所得，力尽筋疲，不偿其费。","book":"唐·韩愈《论淮西事宜状》"},"example":{"text":"驾犁，驾犁！老农呆气！拉牛耕田，～。","book":"刘大白《驾犁》"},"similar":["筋疲力尽"],"opposite":["精力充沛"],"usage":"作谓语、定语；形容非常疲乏","story":["宋高宗时宰相李纲对国家赤胆忠心，一贯主张抗金，反对抗金割地求和，当了70天的宰相就被贬，在金兵围困时，他亲自指挥作战。他的《病牛》诗感慨自己：“耕犁千亩实千箱，力尽筋疲谁复伤？但得众生皆得饱，不辞羸病卧残阳。”"]},{"id":8947,"word":"力屈势穷","pinyin":"lì qū shì qióng","abbr":"lqsq","explanation":"力量和势力都已穷尽。","source":{"text":"亡家徇国，方寸不乱。力屈势穷，排空落翰。","book":"唐·吕温《凌烟阁勋臣赞·屈突蒋公通》"},"example":{"text":"皇宋受命，四方僭乱，以次削平，而蜀、江南负其嶮远，兵至城下，～，然后束手。","book":"宋·苏轼《钱氏表忠观碑》"},"usage":"作谓语、定语；用于处境"},{"id":8948,"word":"力屈计穷","pinyin":"lì qū jì qióng","abbr":"lqjq","explanation":"屈：穷尽。力量智谋都已用完。","source":{"text":"吾今在厄，力屈计穷。","book":"《太平广记》卷一六六引《纪闻·吴保安》"},"example":{"text":"吾想此辈鼠窃狗偷，岂有深谋远计，连日被我敌败，～。","book":"明·吾邱瑞《运甓记·平蛮奏凯》"},"similar":["力屈道穷"],"usage":"作谓语、定语；用于人的处境"},{"id":8949,"word":"力屈道穷","pinyin":"lì qū dào qióng","abbr":"lqdq","explanation":"道：途径、办法；屈：穷尽。力量办法都已用完。","source":{"text":"吾受国重任，本望平难立功。精诚无感，遂辱王命。今力屈道穷，计无所出。唯当效死，以谢朝恩。","book":"《周书·王思政传》"},"example":{"text":"贞阳以犹子之亲，当戎首之任，非但～，亦将路无还蜀。","book":"唐·欧阳洵《艺文类聚》卷五十八"},"similar":["力屈计穷"],"usage":"作谓语、定语；用于人的处境"},{"id":8950,"word":"力征经营","pinyin":"lì zhēng jīng yíng","abbr":"lzjy","explanation":"力征：用武力相争夺；经营：筹划营谋。指用武力征伐来平治天下。","source":{"text":"自矜功伐，奋其私智而师古，始霸王之国，欲以力征经营天下，五年卒亡其国，身死东城，尚的觉寤，不自责过失，乃引‘天亡我，非用兵之罪’，岂不谬哉！","book":"《汉书·陈胜项籍传》"},"example":{"text":"欲以～天下，卒之一败涂地而不可收拾。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十六回"}},{"id":8951,"word":"力微任重","pinyin":"lì wēi rèn zhòng","abbr":"lwrz","explanation":"能力小而任务重。","source":{"text":"若志小谋大，力微任重，岂敢顾惜微躯。","book":"唐·张说《让平章事表》"},"example":{"text":"～久神疲，再竭衰庸定不支。","book":"清·林则徐《赴戍登程口占示家人》其二"},"similar":["力小任重"],"usage":"作谓语、定语；多用于自谦"},{"id":8952,"word":"力所不及","pinyin":"lì suǒ bù jí","abbr":"lsbj","explanation":"及：达到。凭自己的力量不能做到。","source":{"text":"平生所未见之文，公力所不及之义，备聚其中。","book":"宋·释惠洪《石门文字禅》"},"example":{"text":"～的事情我们也要想办法去做。"},"similar":["力不能支","力不从心","无能为力"],"opposite":["得心应手","力所能及","为所欲为"],"usage":"作谓语、定语、宾语；同“力不能及”"},{"id":8953,"word":"力所不逮","pinyin":"lì suǒ bù dǎi","abbr":"lsbd","explanation":"逮：到，及。指能力达不到。","source":{"text":"非厚夫本志也，奈何力有所不逮，技术有所不及，故不暇择地之美恶近远焉。","book":"宋·连文凤《百正集·送苟厚夫学正之昌国序》"},"example":{"text":"李鸿章认为备战议和，只能顾到一面，两面为敌，～。","book":"高阳《慈禧全传》五十四"}},{"id":8954,"word":"力所可及","pinyin":"lì suǒ kě jí","abbr":"lskj","explanation":"力：体力，能力；及：达到。在自己力量的限度内所能做到的。","source":{"text":"今之职位，谬恩之加耳，非吾力所能致也。","book":"晋·羊佑《诫子书》"},"example":{"text":"秋厓贡士嗣之，周旋世变间，～，施惠不少，亦不使其人知。","book":"宋·刘将孙《茶陵州谭氏孚善仓记》"}},{"id":8955,"word":"力所能任","pinyin":"lì suǒ néng rèn","abbr":"lsnr","explanation":"力：体力，能力；任：胜任。在自己力量的限度内所能做到的。","source":{"text":"今之职位，谬恩之加耳，非吾力所能致也。","book":"晋·羊佑《诫子书》"},"example":{"text":"余谓二千缗价本不昂，但修理之费亦非二千缗不办，非～，因置之。","book":"清·梁章钜《浪迹丛谈·多衙庄》"}},{"id":8956,"word":"力所能及","pinyin":"lì suǒ néng jí","abbr":"lsnj","explanation":"力：体力，能力；及：达到。在自己力量的限度内所能做到的。","source":{"text":"今之职位，谬恩之加耳，非吾力所能致也。","book":"晋·羊佑《诫子书》"},"example":{"text":"特别是要用实例、用典型示范去告诉他们组织起来的好处，这种好处是超出单干户～的。","book":"郭小川《十字路口》"},"similar":["力挽狂澜","得心应手","为所欲为"],"opposite":["力不能支","无能为力"],"usage":"作谓语、定语；指能够办到"},{"id":8957,"word":"力所能致","pinyin":"lì suǒ néng zhì","abbr":"lsnz","explanation":"力：体力，能力；致：做到。在自己力量的限度内所能做到的。","source":{"text":"今之职位，谬恩之加耳，非吾力所能致也。","book":"晋·羊佑《诫子书》"},"example":{"text":"今大字本已影印新出，非～，对此乃倍加珍视而装修焉。","book":"孙犁《戚序石头记》"}},{"id":8958,"word":"力挽狂澜","pinyin":"lì wǎn kuáng lán","abbr":"lwkl","explanation":"挽：挽回；狂澜：猛烈的大波浪。比喻尽力挽回危险的局势。","source":{"text":"障百川而东之，回狂澜于既倒。","book":"唐·韩愈《进学解》"},"example":{"text":"乾坤苍莽正风尘，～仗要人。","book":"清·丘逢甲《岭云每日楼诗钞·村居书感次崧甫韵二首》"},"similar":["扭转乾坤","砥柱中流"],"opposite":["力不能支","力不从心"],"usage":"作谓语、定语；指挽回险恶的局势"},{"id":8959,"word":"力挽颓风","pinyin":"lì wǎn tuí fēng","abbr":"lwtf","explanation":"挽：挽回；颓：败落。比喻尽力挽回危险的局势。","source":{"text":"李献吉何仲默二学宪气象弘阔，词彩精确。力挽颓风，复臻古雅。","book":"明·顾起纶《士品三》"},"example":{"text":"智欲萌芽，权尤未复，期君～，化痼学应隆。","book":"清·秋瑾《望海潮》词"}},{"id":8960,"word":"力排众议","pinyin":"lì pái zhòng yì","abbr":"lpzy","explanation":"力：竭力；排：排队；议：议论、意见。竭力排除各种意议论，使自己的意见占上风。","source":{"text":"诸葛亮舌战群儒，鲁子敬力排众议。","book":"明·罗贯中《三国演义》第四十三回"},"example":{"text":"他在这次会议上～，终于使自己的观点得到了与会代表的支持。"},"similar":["无可争辩","一言为定","一手包办"],"opposite":["心猿意马","人云亦云","三心二意"],"usage":"作谓语、宾语、定语；指使自己观点占上风"},{"id":8961,"word":"力敌万夫","pinyin":"lì dí wàn fū","abbr":"ldwf","explanation":"形容勇力超人。","source":{"text":"长男仁睿，中男仁楷，少男仁护、仁昉等，或体穷三变，潘陆不足以升堂；或力敌万夫，关张不足以挟毂。","book":"唐·杨炯《唐上骑都尉高君神道碑》"},"example":{"text":"可是尊大人呢？照你刚才所说那种～的气概，应该可以保护尊大人出险。","book":"茅盾《子夜》六"},"usage":"作谓语、定语；用于书面语"},{"id":8962,"word":"力敌势均","pinyin":"lì dí shì jūn","abbr":"ldsj","explanation":"双方力量相等，不分高低。同“力均势敌”。","source":{"text":"力敌势均，终相吞咀。","book":"《宋书·刘穆之传》"},"example":{"text":"兵连祸结，～，疆场之事，一彼一此。","book":"《周书·武帝纪下》"},"similar":["势均力敌"],"usage":"作定语、宾语；形容双方力量相等"},{"id":8963,"word":"力敌千钧","pinyin":"lì dí qiān jūn","abbr":"ldqj","explanation":"敌：抵挡；钧：古代重量单位，合当时三斤。形容力气大，能抵挡住几万斤。","source":{"text":"良乐轶能于相，驭乌获抗力于千钧。","book":"《汉书·叙传上》"},"example":{"text":"先人一个个身高八尺，～。哪像现在，生出那号小杂种。","book":"韩少功《爸爸爸》"},"similar":["力敌万夫","力大无比"],"usage":"作谓语、定语；用于书面语"},{"id":8964,"word":"力有未逮","pinyin":"lì yǒu wèi dǎi","abbr":"lywd","explanation":"指能力做不到。","example":{"text":"他一直希望能化解这两家的仇恨，但～，他们仍然争吵不休。"}},{"id":8965,"word":"力殚财竭","pinyin":"lì dān cái jié","abbr":"ldcj","explanation":"殚：尽。力量和财物都已耗尽。","source":{"text":"及秦之时，厚献以竭人财，远役以殚人力；力殚财竭，尽为完贼，群盗满山，赭衣塞路；故每岁断罪，数至十万。","book":"唐·白居易《止狱措刑》"},"usage":"作谓语、定语；指力量和财物都已耗尽"},{"id":8966,"word":"力济九区","pinyin":"lì jì jiǔ qū","abbr":"ljjq","explanation":"济：帮助；九区：指全国。凭自己的力量周济全国民众。","source":{"text":"有大贤而不能用，睹长策而不能施，便谓力济九区，智周万物，天下可指麾而定，宇宙可大呼而致也。呜呼，悲夫。","book":"唐·卢照邻《三国论》"},"usage":"作宾语、定语；用于书面语"},{"id":8967,"word":"力疾从事","pinyin":"lì jí cóng shì","abbr":"ljcs","explanation":"力疾：带病坚持。形容克服病痛，坚持工作。","source":{"text":"臣辄力疾，将兵屯洛水浮桥，伺察非常。","book":"《三国志·魏志·曹爽传》"},"example":{"text":"无奈这个时候国事紧急，不得偷安，没奈何只得～。","book":"清·张春帆《九尾龟》第一百七十五回"}},{"id":8968,"word":"力疾从公","pinyin":"lì jí cóng gōng","abbr":"ljcg","explanation":"力疾：带病坚持；从公：从事公务。形容克服病痛，坚持工作。","source":{"text":"臣辄力疾，将兵屯洛水浮桥，伺察非常。","book":"《三国志·魏志·曹爽传》"},"example":{"text":"袁世凯便先用电报回复奕劻，说屈永秋告了病假，～，自是分所当为。","book":"高阳《慈禧全传》九十四"}},{"id":8969,"word":"力穷势孤","pinyin":"lì qióng shì gū","abbr":"lqsg","explanation":"力量耗尽，势力孤单。常形容受挫后得不到援助的窘迫处境。","source":{"text":"孙桓折了李异、谢旌、谭雄等许多将士，力穷势孤，不能抵敌，即差人回吴求救。","book":"明·罗贯中《三国演义》第八十二回"}},{"id":8970,"word":"力竭声嘶","pinyin":"lì jié shēng sī","abbr":"ljss","explanation":"嗓子喊哑了，力气用尽了。形容拼命地叫喊。","source":{"text":"度未有不索然气沮，力竭声嘶，一蹶再蹶，而吾丧我者。","book":"梁启超《意大利建国三杰传·结论》"},"example":{"text":"并不集中在一处地方，也不再有～的大吵大闹。","book":"沙汀《烦恼》"},"similar":["声嘶力竭"],"usage":"作谓语、定语；形容拼命地叫喊"},{"id":8971,"word":"力能扛鼎","pinyin":"lì néng gāng dǐng","abbr":"lngd","explanation":"扛：用双手举起沉重的东西；鼎：三足两耳的青铜器。形容气力特别大。亦比喻笔力雄健。","source":{"text":"籍（项羽）长八尺余，力能扛鼎，才气过人。","book":"《史记·项羽本纪》"},"example":{"text":"昔人评米元晖画云：虎儿笔～，五百年来无此君。","book":"清·顾复《平生壮观·米芾》"},"usage":"作谓语、定语；用于比喻句"},{"id":8972,"word":"力能胜贫","pinyin":"lì néng shèng pín","abbr":"lnsp","explanation":"力：力气，引申为勤劳。勤劳肯出力气可免于贫穷。","source":{"text":"语曰：‘力能胜贫，谨能胜祸。盖言勤力可以不贫，谨身可以避祸。’","book":"北魏·贾思勰《齐民要术·序》"}},{"id":8973,"word":"力薄才疏","pinyin":"lì bó cái shū","abbr":"lbcs","explanation":"力量和才能都很有限。多用于谦词。","source":{"text":"初世为人，便要结识天下好汉，奈缘力薄才疏，不能接待，以遂平生之愿。","book":"明·施耐庵《水浒全传》第四十一回"},"usage":"作谓语、定语；用于自谦"},{"id":8974,"word":"力蹙势穷","pinyin":"lì cù shì qióng","abbr":"lcsq","explanation":"蹙：局促。力量穷尽而无法进展。","source":{"text":"率皆纵诞而不克，踯躅而不进，力蹙势穷，吞志而没。","book":"唐·柳宗元《答人求文章书》"},"usage":"作谓语、定语；用于处事"},{"id":8975,"word":"力软筋疲","pinyin":"lì ruǎn jīn pí","abbr":"lrjp","explanation":"筋疲力尽","source":{"text":"此时蒋金花力软筋疲，满心只望尚诏救应，被军门右哨下一马兵丁熙趁空一枪，刺于马下。","book":"清·李百川《绿野仙踪》第33回"},"example":{"text":"一场登山比赛下来，我已经累得～了"},"similar":["筋疲力尽"],"usage":"作定语、状语；用于人境况"},{"id":8976,"word":"力软筋麻","pinyin":"lì ruǎn jīn má","abbr":"lrjm","explanation":"力尽筋疲，筋疲力尽。","example":{"text":"一场登山比赛下来，我已经累得～了。"}},{"id":8977,"word":"力透纸背","pinyin":"lì tòu zhǐ bèi","abbr":"ltzb","explanation":"透：穿过。形容书法刚劲有力，笔锋简直要透到纸张背面。也形容诗文立意深刻，词语精练。","source":{"text":"当其用锋，常欲使其透过纸背，此成功之极也。","book":"唐·颜真卿《张长史十二意笔法意记》"},"example":{"text":"意在笔先，～。","book":"清·赵翼《瓯北诗话》卷六"},"similar":["大笔如椽","笔力千钧"],"opposite":["轻描淡写"],"usage":"作谓语、定语、分句；用于书法及文章等","story":["南宋陆游是一位才华横溢的诗人，他留下了9000多首诗，内容极为丰富，抒发政治抱负，代表作有《关山月》、《农家叹》、《示儿》等。清代诗人赵翼在《瓯北诗话》中评论陆游的诗：“陆游的诗才气豪健，意境清新，立意深刻，语句精练，力透纸背。”"]},{"id":8978,"word":"力钧势敌","pinyin":"lì jūn shì dí","abbr":"ljsd","explanation":"双方力量相等，不分高低。同“力均势敌”。","source":{"text":"昔有南氏，有二臣贵宠，力钧势敌，竞进争权，下争朋党，君弗能禁，南氏以分。","book":"《逸周书·史记》"},"similar":["力均势敌"],"usage":"作谓语、定语；用于矛盾冲突的双方"},{"id":8979,"word":"劝善惩恶","pinyin":"quàn shàn chéng è","abbr":"qsce","explanation":"劝：勉励；惩：责罚。惩罚坏人，奖励好人。","source":{"text":"《春秋》之称，微而显，志而晦，婉而成章，尽而不污，惩恶而劝善，非圣人谁能修之。","book":"《左传·成公四十年》"},"example":{"text":"其于～之意，片言只字之奇，或可取焉。","book":"明·赵弼《效颦集后序》"},"similar":["劝善戒恶"],"usage":"作谓语、定语；指惩罚坏人，勉励好人"},{"id":8980,"word":"劝善戒恶","pinyin":"quàn shàn jiè è","abbr":"qsje","explanation":"惩罚坏人，奖励好人。同“劝善惩恶”。","source":{"text":"《春秋》之称，微而显，志而晦，婉而成章，尽而不污，惩恶而劝善，非圣人谁能修之。","book":"《左传·成公四十年》"},"example":{"text":"生有善行，死有善谥，所以～也。","book":"唐·欧阳洵《艺文类聚》卷四十引《五经通义》"},"similar":["劝善惩恶"],"usage":"作谓语、定语；指惩罚坏人，勉励好人"},{"id":8981,"word":"劝善规过","pinyin":"quàn shàn guī guò","abbr":"qsgg","explanation":"比喻勉励学好，规劝改正错误。","source":{"text":"朋友之交，至于劝善规过足矣。","book":"清·刘开《问说》"},"example":{"text":"我望先生～，奈何亦作此俗谈？","book":"蔡东蕃《后汉演义》二十一回"}},{"id":8982,"word":"劝善黜恶","pinyin":"quàn shàn chù è","abbr":"qsce","explanation":"鼓励贤能，斥退邪恶。","source":{"text":"夫附下罔上者死，附上罔下者刑，与闻国政而无益于民者斥，在上位而不能进贤者退，此所以劝善黜恶也。","book":"《汉书·武帝纪》"},"example":{"text":"～，经国茂典。","book":"《魏书·肃宗纪"},"similar":["劝善惩恶","劝善戒恶"],"usage":"作谓语、定语；指惩罚坏人，勉励好人"},{"id":8983,"word":"劝百讽一","pinyin":"quàn bǎi fěng yī","abbr":"qbfy","explanation":"形容规讽正道的言辞远远及不上劝诱奢靡的言辞。意在使人警戒，但结果却适得其反。","source":{"text":"扬雄以为靡丽之赋，劝百而讽一，犹骋郑卫之声，曲终而奏雅，不已亏乎？","book":"西汉·司马迁《史记·司马相如列传》"},"example":{"text":"视庄言危论，往往有过，殆未可以～而轻薄之也。","book":"梁启超《译印政治小说序》"},"similar":["讽一劝百"],"usage":"作谓语、定语；指方法不对头"},{"id":8984,"word":"功一美二","pinyin":"gōng yī měi èr","abbr":"gyme","explanation":"功：细线。做一方面的事情却取得两方面的美名。","source":{"text":"彼君子知自损之为益，故功一而美二。","book":"三国·魏·刘劭《人物志·释争》"}},{"id":8985,"word":"功不唐捐","pinyin":"gōng bù táng juān","abbr":"gbtj","explanation":"功：功夫；唐：徒然，空；捐：舍弃。佛家语，功夫不会白白地抛弃。","source":{"text":"功不唐捐。","book":"《法华经·普门品》"}},{"id":8986,"word":"功不成，名不就","pinyin":"gōng bù chéng，míng bù jiù","abbr":"gbcmbj","explanation":"成：成功；就：达到。功业没有成功，名利也没有得到。比喻事情没做好，什么也没有得到。","source":{"text":"若是老爷就是这样做去，到了功不成，名不就的时候，老爷说奴才没良心……不告诉老爷。","book":"清·曹雪芹《红楼梦》第九十九回"},"opposite":["功成名就"],"usage":"作谓语、宾语、定语；用于人的处境等"},{"id":8987,"word":"功不补患","pinyin":"gōng bù bǔ huàn","abbr":"gbbh","explanation":"功：功绩；补：替，添充；患：祸患。所取得的功绩，抵不过所带来的祸患。","source":{"text":"汉击匈奴，虽得阴山，枕骸遍野，功不补患。","book":"唐·李华《吊古战场文》"},"example":{"text":"姚安公尝言，饮沧酒，禁忌百端。劳苦万状，始能得花前月下之一酌，实～。","book":"清·纪昀《阅微草堂笔记·滦阳续录五》"},"usage":"作宾语、定语；用于评论人的功过"},{"id":8988,"word":"功亏一篑","pinyin":"gōng kuī yī kuì","abbr":"gkyk","explanation":"亏：欠缺；篑：盛土的筐子。堆九仞高的山，只缺一筐土而不能完成。比喻作事情只差最后一点没能完成。","source":{"text":"为山九仞，功亏一篑。","book":"《尚书·旅獒》"},"example":{"text":"倘朝廷内外不和，动辄掣肘，必将使剿贼大事，～。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["功败垂成","前功尽弃","山亏一篑"],"opposite":["大功告成","善始善终"],"usage":"作谓语、定语；指功败垂成","story":["周武王灭商建周之后，各地诸侯纷纷朝贡给他。太保召公对周武王说：“他们把珍宝、玉器贡献给你，你也要封赏他们，治理国家要时刻思想自己的德行，大德从小德积累起来的，否则就会功亏一篑的。”周武王从此专心治理朝政"]},{"id":8989,"word":"功到自然成","pinyin":"gōng dào zì rán chéng","abbr":"gdzrc","explanation":"下了足够功夫，事情自然就会取得成效。","source":{"text":"这师父原来只是思乡难息！若要那三三行满，有何难哉！常言道：‘功到自然成’哩！","book":"明·吴承恩《西游记》第43回"},"example":{"text":"～，雕刻家一边研究，一边想像，石像的模型在他心里渐渐完成了。","book":"叶圣陶《古代英雄的石像》"},"opposite":["前功尽弃"],"usage":"作宾语、分句；用于劝诫人"},{"id":8990,"word":"功劳汗马","pinyin":"gōng láo hàn mǎ","abbr":"glhm","explanation":"汗马：战马奔驰出汗。指在战场上建立了很大的战功。","source":{"text":"俺子父全忠不到头，功劳汗马一时休。","book":"元·无名氏《昊天塔》第一折"},"similar":["汗马功劳"],"usage":"作宾语；形容战功"},{"id":8991,"word":"功参造化","pinyin":"gōng cān zào huà","abbr":"gczh","explanation":"功：器物精美完好；参：加入；造化：自然，天工。器物精美巧妙，天工之巧。"},{"id":8992,"word":"功同赏异","pinyin":"gōng tóng shǎng yì","abbr":"gtsy","explanation":"功：功绩；赏：赏赐；异：不同。功绩相同但赏赐却不一样。","source":{"text":"臣闻功同赏异则劳臣疑，罪均刑别则百姓惑。","book":"汉·荀悦《汉纪·元帝纪》"},"usage":"作宾语、定语；用于书面语"},{"id":8993,"word":"功名利禄","pinyin":"gōng míng lì lù","abbr":"gmll","explanation":"指名利地位。","source":{"text":"只因功名利禄得不到保障，所以他们便想到要和流寇苟合，铤而走险。","book":"郭沫若《南冠草》第一幕"},"example":{"text":"牛启东素不喜章句之学，认为那是腐儒伪装道学的幌子，驵侩谋求～的阶梯，无关乎国计民生。","book":"姚雪垠《李自成》第一卷第十九章"},"similar":["功名富贵"],"usage":"作主语、宾语、定语；指名利地位"},{"id":8994,"word":"功名富贵","pinyin":"gōng míng fù guì","abbr":"gmfg","explanation":"指升官发财。","source":{"text":"功名富贵，直从灭处观究竟，则贪恋自轻；横逆困穷，直从起处究由来，则怨尤自息。","book":"唐·李白《江上吟》：“功名富贵若长在，汉水亦应西北流。”明·洪应明《菜根谭·应酬》"},"example":{"text":"单道着人生～，总有天数，不如图一个见的怜活。","book":"明·凌濛初《初刻拍案惊奇》卷之一"},"similar":["功名利禄"],"usage":"作主语、宾语、定语；指名利地位"},{"id":8995,"word":"功名蹭蹬","pinyin":"gōng míng cèng dèng","abbr":"gmcd","explanation":"功名：指封建时代科举得中而走仕途之路；蹭蹬：遭遇挫折，失意潦倒。指科考不顺利。","source":{"text":"谁知这样一个好人，偏偏叫他功名蹭蹬。","book":"清·李汝珍《镜花缘》第四十六回"},"usage":"作谓语、定语；用于科举等"},{"id":8996,"word":"功在漏刻","pinyin":"gōng zài lòu kè","abbr":"gzlk","explanation":"漏：古代计时用的器具；漏刻：顷刻之间。在极短的时间，就可以获得成功。","source":{"text":"寻、邑自以为功在漏刻，意气甚逸。","book":"《后汉书·光武纪》"}},{"id":8997,"word":"功均天地","pinyin":"gōng jūn tiān dì","abbr":"gjtd","explanation":"均：等同。功业与天地等同。极言功业之大。","source":{"text":"功均天地，明并日月。","book":"南朝·梁·陆倕《石阙铭》"},"similar":["功盖天地"],"usage":"作谓语、定语；指功劳大"},{"id":8998,"word":"功垂竹帛","pinyin":"gōng chuí zhú bó","abbr":"gczb","explanation":"垂：流传；竹帛：古代写字用的竹简和白绢，借指典籍史册。建立伟大功勋，名载青史。","source":{"text":"故使庄王功迹著乎竹帛，传乎后世。","book":"战国·卫·吕不韦《吕氏春秋·情欲》"},"example":{"text":"宫保若能行此上策，岂不是贾让二千年后得一知己？～，万世不朽！","book":"清·刘鹗《老残游记》第14回"},"similar":["功标青史"],"usage":"作谓语、定语、宾语；用于人的功绩"},{"id":8999,"word":"功堕垂成","pinyin":"gōng duò chuí chéng","abbr":"gdcc","explanation":"功：成功；堕：通“隳”，毁坏；垂：接近，将近；成：成功。指事情接近成功的时候却遭到了失败。","source":{"text":"侵地无方，攻城记屈，遭回转觉难发，功堕垂成，怎能勾冲击唐突？","book":"明·张凤翼《红拂记·棋决雌雄》"},"similar":["功败垂成","败于垂成"],"usage":"作谓语、定语、宾语；表示惋惜"},{"id":9000,"word":"功完行满","pinyin":"gōng wán xíng mǎn","abbr":"gwxm","explanation":"功：功德；行：道行。指出家功德修炼已成，道行圆满。","source":{"text":"功完行满朝金阙，见性明心返故乡。","book":"明·吴承恩《西游记》第23回"},"similar":["功成行满"],"usage":"作谓语、宾语；指成功"},{"id":9001,"word":"功就名成","pinyin":"gōng jiù míng chéng","abbr":"gjmc","explanation":"功：功业。就：达到。指成就了功业，也有了名声。","source":{"text":"当初一个布衣人，到如今功就名成，加封匪轻。","book":"明·沈采《千金记·游仙》"},"similar":["功成名就"],"usage":"作谓语、宾语、定语；指功绩与名利都得到"},{"id":9002,"word":"功崇德钜","pinyin":"gōng chóng dé jù","abbr":"gcdj","explanation":"功：功绩；崇：崇高；德：德行；钜：巨大。功绩崇高，德行弘大。","source":{"text":"以陛下功崇德钜，天成地平。","book":"唐·韩愈《贺册尊号表》"}},{"id":9003,"word":"功德兼隆","pinyin":"gōng dé jiān lóng","abbr":"gdjl","explanation":"功；功勋；德：德行；隆：大。功绩和德行都非常突出。","source":{"text":"自古功德兼隆，由汉以来未之有也。","book":"《旧唐书·太宗纪》"}},{"id":9004,"word":"功德圆满","pinyin":"gōng dé yuán mǎn","abbr":"gdym","explanation":"功德：佛教用语，指诵经、布施等。多指诵经等佛事结束。比喻举办事情圆满结束。","source":{"text":"奉五月二日诲，用慰驰结，仰承衡岳，功德圆满，便致荆巫。","book":"隋·隋炀帝《入朝遣使参书》"},"example":{"text":"兄弟算是原经手，了此一事，～。","book":"茅盾《清明前后》"},"similar":["大功告成"],"usage":"作状语、定语；指某件事情已经圆满结束"},{"id":9005,"word":"功德无量","pinyin":"gōng dé wú liàng","abbr":"gdwl","explanation":"功德：功业和德行；无量：无法计算。旧时指功劳恩德非常大。现多用来称赞做了好事。","source":{"text":"所以拥全神灵，成育圣躬，功德已无量矣。","book":"《汉书·丙吉传》"},"example":{"text":"现在先生既然得到原文，我的希望是给他们彻底的修改一下，虽然牺牲太大，然而～。","book":"《鲁迅书信集·致孟十还》"},"similar":["劳苦功高","广结善缘"],"opposite":["作恶多端","罪大恶极"],"usage":"作谓语、定语；用来称赞做了好事","story":["汉武帝时期，武帝的孙子刘洵因受卫太子事件牵连入狱，狱吏丙吉竭力保护。武帝要杀掉狱中所有的囚犯，丙吉冒死相救，后来刘洵即位为汉宣帝，丙吉把这段历史隐瞒，宣帝对他倍加敬重。长安人伍尊称赞丙吉尽心保护宣帝，功德无量"]},{"id":9006,"word":"功成不居","pinyin":"gōng chéng bù jū","abbr":"gcbj","explanation":"居：承当，占有。原意是任其自然存在，不去占为己有。后形容立了功而不把功劳归于自己。","source":{"text":"生而不有，为而不恃，功成而不居。","book":"《老子》第二章"},"example":{"text":"看他前九首，便是一位努力从王之人，而以～终之。","book":"清·无名氏《杜诗言志》卷六"},"similar":["功成弗居"],"opposite":["居功自傲"],"usage":"作谓语、定语；指不居功自傲","story":["春秋时期，老子提出辨证的政治主张，他认为天下人知道美与丑对立，有和无对立相生。圣人治国知道有为和有所不为，采取无为政策；知识有教则有不教，行不言的教育。万物各有所为，圣人不去掌握，事功告成，圣人功成不居，人们归功于他"]},{"id":9007,"word":"功成业就","pinyin":"gōng chéng yè jiù","abbr":"gcyj","explanation":"成：成功；业：事业。建立了功绩，事业有成就。指功绩与名利都得到。","source":{"text":"岳飞功成业就之时，即高宗寝时不安之日。","book":"范长江《塞上行·行纪·忆西蒙》"},"similar":["功成名遂","功成名立","功成事立"],"usage":"作谓语、宾语、定语；指功绩与名利都得到"},{"id":9008,"word":"功成事立","pinyin":"gōng chéng shì lì","abbr":"gcsl","explanation":"功业成就，事业建立。","source":{"text":"然后功成事立，臣等退伏矫罪，虽死无恨。","book":"《老子》第十七章：“功成事遂，百姓皆曰：我自然。”《三国志·蜀志·先主传》"},"similar":["功成名立","功成业就","功成名遂"],"usage":"作谓语、宾语、定语；指功绩与名利都得到"},{"id":9009,"word":"功成名就","pinyin":"gōng chéng míng jiù","abbr":"gcmj","explanation":"功：功业。就：达到。功绩取得了，名声也有了。","source":{"text":"功成名遂，名誉不可虚假。","book":"《墨子·修身》"},"example":{"text":"你则说做官的～，我则说出家的延年益寿。","book":"元·范子安《陈季卿误上竹叶舟》第二折"},"similar":["功成名遂"],"opposite":["身败名裂"],"usage":"作谓语、宾语、定语；指功绩与名利都得到"},{"id":9010,"word":"功成名立","pinyin":"gōng chéng míng lì","abbr":"gcml","explanation":"成：成功；名：名利。建立了功绩，名声也有了。指功绩与名利都得到。","source":{"text":"功成名立，偕老林泉，这是我的夙愿。","book":"蔡东藩《民国通俗演义》第54回"},"similar":["功成名遂","功成业就","功成事立"],"usage":"作谓语、宾语、定语；指功绩与名利都得到"},{"id":9011,"word":"功成名遂","pinyin":"gōng chéng míng suì","abbr":"gcms","explanation":"遂：成就。功绩建立了，名声也有了。","source":{"text":"功成名遂，名誉不可虚假。","book":"《墨子·修身》"},"example":{"text":"～会归老，请向东山为近邻。","book":"唐·刘禹锡《将赴汝州途出浚下留辞李相公》"},"similar":["功成名就"],"opposite":["身败名裂"],"usage":"作谓语、宾语、定语；指功绩与名利都得到"},{"id":9012,"word":"功成弗居","pinyin":"gōng chéng fú jū","abbr":"gcfj","explanation":"形容立了功而不把功劳归于自己。同“功成不居”。","source":{"text":"功成弗居，贤将所难。","book":"明·李贽《史纲评要·周纪·赧王》"},"example":{"text":"明·李贽《史纲评要·周纪·赧王》：“～，贤将所难。”"},"similar":["功成不居"],"usage":"作谓语、定语；指不居功自傲"},{"id":9013,"word":"功成愿遂","pinyin":"gōng chéng yuàn suì","abbr":"gcys","explanation":"事情已经完成，心愿已经了结","source":{"text":"今已功成愿遂，我复何求，当速去修道，汝不必留我也。","book":"清·如莲居士《薛刚反唐》第100回"},"usage":"作谓语、定语；用于书面语"},{"id":9014,"word":"功成行满","pinyin":"gōng chéng xíng mǎn","abbr":"gcxm","explanation":"功：世界各地；行：善行。封建迷信指功德成就，道行圆满。","source":{"text":"今日个功成行满，驾青鸾证果朝元。","book":"元·杨景贤《刘行首》第四折"},"example":{"text":"直待～，方许你归山，再成正果。","book":"清·钱彩《说岳全传》第一回"},"similar":["功完行满","行成功满"],"usage":"作谓语、宾语；指成功"},{"id":9015,"word":"功成身退","pinyin":"gōng chéng shēn tuì","abbr":"gcst","explanation":"身：自身，自己。指大功告成之后，自行隐退，不再复出。","source":{"text":"功成、名遂、身退、天之道。","book":"春秋·楚·李耳《老子》"},"example":{"text":"蔡京这个左仆射更是难处，还是以‘～’为佳。","book":"郁雯《李清照》"},"similar":["功遂身退"],"usage":"作谓语、定语；指大功告成之后自行隐退"},{"id":9016,"word":"功成骨枯","pinyin":"gōng chéng gǔ kū","abbr":"gcgk","explanation":"比喻为了一己私利，让其他许多人为之付出巨大的牺牲。","source":{"text":"凭君莫话封侯事，一将功成万骨枯。","book":"语出唐·曹松《己亥岁》诗之一"},"example":{"text":"而今又孳孳然以奖励资本家为务，至不惜牺牲他部分人利益以为殉，～，在所不计。","book":"《中国近代思想史参考资料简编·告非难民生主义者》"},"usage":"作宾语、定语；用于书面语"},{"id":9017,"word":"功标青史","pinyin":"gōng biāo qīng shǐ","abbr":"gbqs","explanation":"标：写明；青史：古代在竹简上记事，因称史书为青史。功劳记在史书上。指建立了巨大功绩。","source":{"text":"古人日以远，青史自不泯。","book":"唐·杜甫《赠郑十八贲》诗"},"example":{"text":"愿诸公善事使君，以图名垂竹帛，～，切勿效庶之无始终也。","book":"明·罗贯中《三国演义》第三十六回"},"similar":["功垂竹帛"],"usage":"作谓语、定语、宾语；用于人的功绩"},{"id":9018,"word":"功烈震主","pinyin":"gōng liè zhèn zhǔ","abbr":"glzz","explanation":"功：功劳，功勋；震：震动、威震；主：君主。指臣下功劳太大，使君主受到震动而心有疑虑。","source":{"text":"功烈震主者，闻命而释兵。","book":"宋·李觏《袁州州学记》"},"similar":["功高震主"],"usage":"作宾语、定语；指功劳太大，使君主受到震动"},{"id":9019,"word":"功狗功人","pinyin":"gōng gǒu gōng rén","abbr":"gggr","explanation":"功狗：比喻立功的战将；功人：比喻立功的军事指挥官。用来比喻立功的将士。","source":{"text":"夫猎，追杀兽兔者，狗也，而发纵指示兽处者，人也。今诸君徒能走得兽耳，功狗也；至如萧何发踪指示，功人也。","book":"《史记·萧相国世家》"},"example":{"text":"从前古人有个～的比方：出兵打仗的人就比方他是只狗，这发号令的却是个人。","book":"清·李宝嘉《官场现形记》第十六回"},"usage":"作宾语、定语；用于比喻句","story":["秦朝末年，刘邦起兵被封为沛公后，萧何成为他的得力助手，帮助保存秦朝的各种文献档案，留守关中，提供军粮和新兵，引荐大将韩信。刘邦论功行赏时，萧何获头功，其他将领不服。刘邦说：你们只是功狗，萧何是发踪指示的功人，功劳最大"]},{"id":9020,"word":"功盖天下","pinyin":"gōng gài tiān xià","abbr":"ggtx","explanation":"功劳天下第一。","source":{"text":"勇略震主者身危，功盖天下者不赏，正此之谓也。","book":"唐·李复言《续玄怪录·李卫公靖》：“其后竟以兵权静寇难，功盖天下。”元·无名氏《赚蒯通》第二折"},"example":{"text":"如今秦王～，四海扬名，英雄豪杰，莫不归附。","book":"明·方汝浩《禅真逸史》第四十回"},"similar":["功盖天地"],"usage":"作谓语、定语；指功劳大"},{"id":9021,"word":"功盖天地","pinyin":"gōng gài tiān dì","abbr":"ggtd","explanation":"功；功绩；盖：压倒，胜过。功绩大，胜过天地。形容功劳极大。","source":{"text":"陵先将军，功略盖天地，义勇冠三军。","book":"汉·李陵《答苏武书》"},"similar":["功盖天下"],"usage":"作谓语、定语；指功劳大"},{"id":9022,"word":"功者难成而易败","pinyin":"gōng zhě nán chéng ér yì bài","abbr":"gznceyb","explanation":"功；功业、事业。事业的成功非常难，但失败却很容易。","source":{"text":"功者难成而易败，时者难得而易失。","book":"《史记·淮阴侯列传》"}},{"id":9023,"word":"功臣自居","pinyin":"gōng chén zì jū","abbr":"gczj","explanation":"功臣：有功的人；居：任，当。做了一定有益的事情，认为自己是功臣而了不起。","source":{"text":"这些功臣自居，骄傲自满的将军们都不把焦都督放在眼下。","book":"陶菊隐《北洋军阀统治时期史话》第三章"},"example":{"text":"陶菊隐《北洋军阀统治时期史话》第三章：“这些～，骄傲自满的将军们都不把焦都督放在眼下。”"},"usage":"作宾语、定语；用于处事"},{"id":9024,"word":"功若丘山","pinyin":"gōng ruò qiū shān","abbr":"grqs","explanation":"功：功绩；若：象。功绩象山一样。比喻劳绩非常大。","source":{"text":"所俗必得，功若丘山，海内定，国家安，是遇其时者也。","book":"汉·东方朔《答客难》"}},{"id":9025,"word":"功薄蝉翼","pinyin":"gōng bó chán yì","abbr":"gbcy","explanation":"功劳象蝉的翅膀那样微薄。形容功劳很小。常用作谦词。","source":{"text":"功劳象蝉的翅膀那样微薄。形容功劳很小。常用作谦词。"},"example":{"text":"汉·蔡邕《让高阳乡侯章》：“臣事轻葭莩，功薄蝉翼。”"},"opposite":["功高盖世"],"usage":"作谓语、宾语；常用作谦词"},{"id":9026,"word":"功行圆满","pinyin":"gōng xíng yuán mǎn","abbr":"gxym","explanation":"功：世界各地；行：善行。封建迷信指功德成就，道行圆满。","source":{"text":"等他功成行满，贫道再去点化他。","book":"元·岳伯川《铁拐李》楔子"},"example":{"text":"女菩萨，你要晓得一经观光之后，也就算～，一天大事都完了。","book":"清·李汝珍《镜花缘》第五十一回"},"usage":"作宾语、定语；用于口语"},{"id":9027,"word":"功败垂成","pinyin":"gōng bài chuí chéng","abbr":"gbcc","explanation":"垂：接近，快要。事情在将要成功的时候遭到了失败。","source":{"text":"庙算有余，良图不果；降龄何促，功败垂成。","book":"《三国志·杨阜传》：“弃垂成之功，陷不义之名，阜以死守之。”《晋书·谢玄传论》"},"example":{"text":"况且十二道金牌，他未必不知道是假的，何必就班师回去，以致～。","book":"清·吴趼人《二十年目睹之怪现状》第六十一回"},"similar":["功亏一篑","前功尽弃"],"opposite":["大功告成"],"usage":"作谓语、定语、宾语；表示惋惜","story":["东晋大将谢玄在叔叔谢安的指挥下取得了淝水大战的全面胜利，迫使前秦王苻坚逃回关中，谢玄乘胜追击，收复了北方的大片领土，就在北方快要统一的时候，东晋皇帝听信谗言令其收兵驻守淮阴。统一北方未遂，人们感叹他是功败垂成"]},{"id":9028,"word":"功过是非","pinyin":"gōng guò shì fēi","abbr":"ggsf","explanation":"功绩与过错，正确和谬误。","source":{"text":"实事求是地、恰如其分地评价‘文化大革命’，评价毛泽东同志的功过是非。","book":"邓小平《对起草的意见》"},"usage":"作主语、宾语、定语；用于人"},{"id":9029,"word":"功遂身退","pinyin":"gōng suí shēn tuì","abbr":"gsst","explanation":"指功成名就之后就退隐不再做官。同“功成身退”。","source":{"text":"金玉满堂，莫之能守，富贵而骄，自遗其咎，功遂身退天之道。","book":"《老子》"},"example":{"text":"～，不祁荣满。","book":"《梁书·武帝纪上》"},"similar":["功成身退"],"usage":"作谓语、定语；指大功告成之后，自行隐退"},{"id":9030,"word":"功首罪魁","pinyin":"gōng shǒu zuì kuí","abbr":"gszk","explanation":"功：功绩；首：首先；罪：罪责，罪行；魁：为首的，居第一位的。功绩数最大，罪责也数第一。","source":{"text":"有功者未有大于五霸，有过者亦未有大于五霸，故五霸者，功之首，罪之魁也。","book":"《孟子·告子下》：“五霸者，三王之罪人也。”宋·朱熹集注"},"example":{"text":"～非两人，遗臭流芳本一身。","book":"明·罗贯中《三国演义》第七十八回"},"usage":"作宾语、定语；用于感慨"},{"id":9031,"word":"功高不赏","pinyin":"gōng gāo bù shǎng","abbr":"ggbs","explanation":"功：功勋；赏：赏赐。功劳极大，无法赏赐。形容功劳之大。","source":{"text":"功高不赏，震主身危，二事既有，将军岂得无虑？","book":"《梁书·陈庆之传》"},"example":{"text":"持节抚黔阳，～。","book":"清·朱彝尊《禹蜂文集序》"},"similar":["不赏之功"],"usage":"作谓语、定语；指功劳大"},{"id":9032,"word":"功高望重","pinyin":"gōng gāo wàng zhòng","abbr":"ggwz","explanation":"望：名望，声望。指功劳大而名望高。","source":{"text":"将军不必怨怅，你功高望重，不久自明。","book":"明·孙梅锡《琴心记·相如受世》"},"example":{"text":"殿下～，岂臣下所敢措辞。","book":"清·褚人获《隋唐演义》第六回"},"similar":["德高望重"],"usage":"作谓语、定语；指功劳大而名望高"},{"id":9033,"word":"功高盖世","pinyin":"gōng gāo gài shì","abbr":"gggs","explanation":"功劳极大，当代没人能比。","source":{"text":"小人在江湖上，到处听说将军功高盖世。","book":"唐浩明《曾国藩》二部二章"},"similar":["功盖天下"],"usage":"作谓语、定语；指功劳大"},{"id":9034,"word":"功高震主","pinyin":"gōng gāo zhèn zhǔ","abbr":"ggzz","explanation":"功：功劳，功勋；震：震动、威震；主：君主。功劳太大，使君主受到震动而心有疑虑。","source":{"text":"臣闻勇略震主者身危，而功盖天下者不赏。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"袁既然准备做皇帝，就不能不在正大位之前扭转这种‘～’，尾大不掉的趋势。","book":"陶菊隐《北洋军阀统治时期史话》第14章"},"similar":["功烈震主"],"usage":"作宾语、定语；指功劳太大，使君主受到震动"},{"id":9035,"word":"加人一等","pinyin":"jiā rén yī děng","abbr":"jryd","explanation":"加：超过。超过别人一等。比喻学问才能超过一般人。也指争强好胜。","source":{"text":"献子加于人一等矣。","book":"《礼记·檀弓上》"},"example":{"text":"你这见解，一定～，这等玄妙高超法，我两个怎能帮助你得来","book":"清·文康《儿女英雄传》第三十回"},"similar":["高人一等"],"usage":"作谓语；比喻学问才能等超过一般人"},{"id":9036,"word":"加减乘除","pinyin":"jiā jiǎn chéng chú","abbr":"jjcc","explanation":"算术的四则运算，借指事物的消长变化。","source":{"text":"算术的四则运算，借指事物的消长变化。"},"example":{"text":"算术的四则运算，借指事物的消长变化。"},"usage":"作主语、宾语；指事物的变化"},{"id":9037,"word":"加叶添枝","pinyin":"jiā yè tiān zhī","abbr":"jytz","explanation":"为了夸张或渲染的需要，在叙述或转述时，增添原来没有的内容。","example":{"text":"请尊重事实，别～了。"},"similar":["添枝加叶","加油添醋","加油添酱"],"usage":"作谓语、定语、状语；指夸张"},{"id":9038,"word":"加官晋爵","pinyin":"jiā guān jìn jué","abbr":"jgjj","explanation":"加封官阶，晋升爵位。晋：晋升。","source":{"text":"征聘吴与弼进京，加官进爵，将隆以伊傅之礼。","book":"明·周楫《西湖二集》"},"example":{"text":"清·姜振名《永庆升平前传》第91回：“如功成之日，定然～。”"},"similar":["加官进爵"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":9039,"word":"加官进位","pinyin":"jiā guān jìn wèi","abbr":"jgjw","explanation":"加官：指官阶晋升；进：增加。晋升官职，增加俸禄。","source":{"text":"怎消的加官进位，怎消的荫子封妻。","book":"元·高文秀《渑池会》第二折"},"similar":["加官进禄"],"usage":"作谓语、定语；指晋升官职，增加俸禄"},{"id":9040,"word":"加官进爵","pinyin":"jiā guān jìn jué","abbr":"jgjj","explanation":"爵：爵位，君主国家封贵族的等级。旧时指官职提升。","source":{"text":"……征聘吴与弼进京，加官进爵，将隆以伊傅之礼。","book":"《金史·章宗元妃李氏传》：“向里飞则加官进禄。”明·周楫《西湖二集·巧书生金銮失对》"},"example":{"text":"恭王因为皇帝的告诫，记忆犹新，在这些～事上，要避把持的嫌疑。","book":"高阳《玉座珠帘》下册"},"similar":["飞黄腾达","金榜题名"],"opposite":["时乖命蹇","削职为民"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":9041,"word":"加官进禄","pinyin":"jiā guān jìn lù","abbr":"jgjl","explanation":"提升官职，增加俸禄。","source":{"text":"向外飞则四国来朝，向里飞则加官进禄。","book":"《金史·后妃传下·章宗元妃李氏》"},"example":{"text":"老爷一向～，八九年来，就忘了我了？","book":"清·曹雪芹《红楼梦》第四回"},"similar":["加官进爵"],"opposite":["削职为民","时乖命蹇"],"usage":"作谓语、定语；指晋升官职，增加俸禄"},{"id":9042,"word":"加枝添叶","pinyin":"jiā zhī tiān yè","abbr":"jzty","explanation":"在叙事或转述时，于主要事件外，添上原来没有的内容。","source":{"text":"汤裱褙道：‘不是奴才夸口，敢怕时日久时，便是王抒亲看，也难辨真伪。 ’遂又加枝添叶，把如何拿王抒欺君误国罪唬她，唬得她当场晕死过去。","book":"《金瓶梅传奇》第十三回"},"example":{"text":"心中虽然欢喜，二哥可也没敢～，故意刺激定大爷。","book":"老舍《正红旗下》十"},"similar":["添枝加叶"],"usage":"作谓语、定语、状语；指夸张"},{"id":9043,"word":"加油加醋","pinyin":"jiā yóu jiā cù","abbr":"jyjc","explanation":"为夸张或渲染的需要，在叙事或说话时增添原来没有的内容。","source":{"text":"有创作才能的人，也把现实中的特殊人物、特殊事件加以表扬或抨击，加油加醋说给人听。","book":"赵树理《写作前后》"},"example":{"text":"他说话总爱～的。"},"similar":["添油加醋"],"usage":"作宾语、状语；指夸张或渲染"},{"id":9044,"word":"加油添酱","pinyin":"jiā yóu tiān jiàng","abbr":"jytj","explanation":"为夸张或渲染的需要，在叙事或说话时增添原来没有的内容。同“加油添醋”。","source":{"text":"太后方要开言，又是泪珠直滚，觉得心中一股又酸又苦的闷气，把个喉咙抵住，要想说一个字，都说不出来。刚好周选待加油添酱的，便说皇上怎样不孝，怎样把懿旨吊销。","book":"清·坑余生《续济公传》第九十七回"},"example":{"text":"要是这恶棍～地告诉张俊呢？","book":"陆文夫《小巷深处》"},"similar":["加叶添枝","加油添醋","加油加醋"],"opposite":["实事求是"],"usage":"作状语、定语、宾语；指夸张"},{"id":9045,"word":"加油添醋","pinyin":"jiā yóu tiān cù","abbr":"jytc","explanation":"为夸张或渲染的需要，在叙事或说话时增添原来没有的内容。同“加油加醋”。","source":{"text":"有种人并不怀着什么恶意，却专喜欢探究人家的隐秘，然后再加油添醋，偷偷地、热衷地广播出去。","book":"克非《春潮急》二六"},"example":{"text":"她说话爱～，不尊重事实"},"similar":["添油加醋","加油加醋","加油添酱"],"usage":"作状语、定语、宾语；指夸张"},{"id":9046,"word":"加绪含容","pinyin":"jiā xù hán róng","abbr":"jxhr","explanation":"绪：功绩。增加功绩，包含宽容。","source":{"text":"他努力学会～，以赢得民心。"},"example":{"text":"他努力学会～，以赢得民心"},"usage":"作谓语、定语；用于书面语"},{"id":9047,"word":"加膝坠泉","pinyin":"jiā xī zhuì quán","abbr":"jxzq","explanation":"喜欢就抱在膝上，不喜欢就推到深水里。比喻用人爱憎无常。同“加膝坠渊”。","source":{"text":"公辅一言悟主，骤及台司；一言不合，礼遽疏薄，则加膝坠泉之间，君道可知矣！","book":"《旧唐书·姜公辅传》"},"example":{"text":"《旧唐书·姜公辅传》：“公辅一言悟主，骤及台司，一言不合，礼遽疏薄，则～之间，君道可知矣。”"},"similar":["加膝坠渊"],"usage":"作谓语、定语；比喻用人爱憎无常"},{"id":9048,"word":"加膝坠渊","pinyin":"jiā xī zhuì yuān","abbr":"jxzy","explanation":"加膝：抱在膝上；坠渊：推下深渊。喜欢就抱在膝上，不喜欢就推到深水里。比喻用人爱憎无常。","source":{"text":"今之君子，进人若将加诸膝，退人若将坠诸渊。","book":"《礼记·檀弓下》"},"example":{"text":"世之惜季木者，以谓意气太盛，肺肠太热，善善恶恶，或溢而为～，以贻小人口实。","book":"清·钱谦益《王季木墓表》"},"similar":["喜怒无常","加膝坠泉"],"usage":"作谓语、定语；比喻用人爱憎无常"},{"id":9049,"word":"务农息民","pinyin":"wù nóng xī mín","abbr":"wnxm","explanation":"甸：勉力从事。努力发展家业生产，让百姓休养生息。","source":{"text":"近讨公孙瓒，师出历年，百姓疲敝，仓库无积，未可动也。宜务农息民，先遣使献捷天子。","book":"《资治通鉴·汉纪·献帝建安四年》"},"example":{"text":"珪嫌牛川地僻，不足有为，因徙居盛乐，作为都城，～，众情大悦。","book":"蔡东藩《两晋演义》第七十三回"}},{"id":9050,"word":"务去陈言","pinyin":"wù qù chén yán","abbr":"wqcy","explanation":"务：务必；陈言：陈旧的言辞。陈旧的言辞一定要去掉。指写作时务必要去掉陈旧的言辞。","source":{"text":"休宁戴生锜，从余游，其为词，务去陈言。","book":"清·朱彝尊《鱼计庄词》序"},"similar":["陈言务去"],"usage":"作谓语；指必须去掉陈旧的语言"},{"id":9051,"word":"务实去华","pinyin":"wù shí qù huá","abbr":"wsqh","explanation":"讲究实际，除掉浮华。","source":{"text":"务实去华，育德之方斯在；反听收视，养恬之义相应。","book":"宋·范仲淹《蒙以养正赋》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":9052,"word":"务本力穑","pinyin":"wù běn lì qiáng","abbr":"wbls","explanation":"本：指农业；穑：收割谷物，这里泛指农业劳动。指努力从事农业劳动。","source":{"text":"秦之所以富强者，孝公务本力穑力效，非鞅流血刻骨之功也。","book":"宋·苏轼《商鞅论》"},"usage":"作谓语、定语；用于书面语"},{"id":9053,"word":"务本抑末","pinyin":"wù běn yì mò","abbr":"wbym","explanation":"从事农业生产，抑制工商业。","source":{"text":"务本抑末，毋与天下争利。","book":"东汉·班固《汉书·郑弘传》"},"example":{"text":"～的做法已经过时。"},"usage":"作宾语、定语；指农工商关系"},{"id":9054,"word":"劣倦罢极","pinyin":"liè juàn pí jí","abbr":"ljbj","explanation":"劣倦：疲倦之极；罢：通“疲”。形容疲倦到了极点。","source":{"text":"颜氏之子，已曾驰过孔子于涂矣，劣倦罢极，发白齿落。","book":"汉·王充《论衡·效力》"}},{"id":9055,"word":"劣迹昭着","pinyin":"liè jì zhāo zhe","abbr":"ljzz","explanation":"劣：恶劣；昭著：明显。恶劣的事迹非常明显。"},{"id":9056,"word":"劣迹昭著","pinyin":"liè jì zhāo zhù","abbr":"ljzz","explanation":"劣：恶劣；昭著：明显。恶劣的事迹非常明显。","source":{"text":"对于国民党的旧工作人员，只要有一技之长而不是反动有据或劣迹昭著的分子，一概予以维持，不要裁减。","book":"毛泽东《唯心历史观的破产》"},"example":{"text":"他～，臭名远扬。"},"similar":["臭名远扬"],"usage":"作谓语、定语；指坏事太多"},{"id":9057,"word":"动不失时","pinyin":"dòng bù shī shí","abbr":"dbss","explanation":"时：时宜，时机。行动不失时机。指不做不切合时宜的事。","source":{"text":"圣人敬小慎微，动不失机。","book":"汉·刘安《淮南子·人间训》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":9058,"word":"动中窾要","pinyin":"dòng zhòng kuǎn yào","abbr":"dzky","explanation":"动：常常；中：切中；窾：空处；要：要害。常常切中要害或抓住问题的关键。","source":{"text":"依乎天理，批大卻郤导大窾。","book":"《庄子·养生主》"},"example":{"text":"云南自界连英法领土，交涉尤繁，文书往复，惟家铭随方应付，～，历任总督皆倚重之，以县丞擢知府。","book":"《清史稿·世增传》"},"similar":["动中肯綮"],"usage":"作谓语、定语；用于书面语"},{"id":9059,"word":"动中竨要","pinyin":"dòng zhōng zhe yào","abbr":"dzzy","explanation":"动常常，动不动。中切中，打中。竨空处、中空。要要害。要引申为要害、关键。常常切中要害或抓住问题的关键。"},{"id":9060,"word":"动中肯綮","pinyin":"dòng zhòng kěn qǐng","abbr":"dzkq","explanation":"动：常常；中：切中，打中；肯綮：引申为要害或关键。比喻常常切中要害或抓住问题的关键。","source":{"text":"技经肯綮之未尝。","book":"战国·宋·庄周《庄子·养生主》"},"example":{"text":"都中遇事剖析，～。","book":"《元史·王都中传》"},"similar":["动中窾要","洞中肯綮","切中时弊"],"usage":"作谓语、定语；用于书面语"},{"id":9061,"word":"动之以情","pinyin":"dòng zhī yǐ qíng","abbr":"dzyq","explanation":"用感情来打动他的心。","source":{"text":"随便他如何导之以理，动之以情，一个只是不肯松口。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"我们对他采取～、晓之以理的劝说方式。"},"similar":["晓之以理"],"usage":"作谓语、定语；常与“晓之以理”连用"},{"id":9062,"word":"动人心弦","pinyin":"dòng rén xīn xián","abbr":"drxx","explanation":"把心比作琴，拨动了心中的琴弦。形容事物激动人心。","source":{"text":"许多动人心弦的建筑物呢？还只在蓝图上。","book":"徐迟《长江大桥的美是社会主义的美》"},"example":{"text":"这些～的赠礼，使得另一些战士们难熬了。","book":"魏巍《依依惜别的深情》"},"similar":["扣人心弦"],"opposite":["平淡无奇","黯然失色"],"usage":"作补语、定语；同“扣人心弦”"},{"id":9063,"word":"动人心脾","pinyin":"dòng rén xīn pí","abbr":"drxp","explanation":"形容使人感动与震惊。","source":{"text":"他们的长处，在于能够度察天下的大势而出之以引人入胜的妙喻好句，出之以动人心脾的危辞险语。","book":"郑振铎《插图本中国文学史·先秦的散文》"},"similar":["动人心魄","动人心弦"],"usage":"作谓语、定语；形容使人感动与震惊"},{"id":9064,"word":"动人心魄","pinyin":"dòng rén xīn pò","abbr":"drxp","explanation":"魄：迷信者指依附人形体而存在的精神。形容使人感动或令人震惊。","source":{"text":"那秦淮到了有月色的时候，越是夜色已深，更有那细吹细唱的船来，凄清委婉，动人心魄。","book":"清·吴敬梓《儒林外史》第24回"},"example":{"text":"那振激精神，～的事情，必然是愈演愈急，愈来愈速。","book":"洪深《戏剧导演的初步知识》"},"similar":["令人震惊","动人心脾"],"usage":"作谓语、定语；形容使人感动与震惊"},{"id":9065,"word":"动地惊天","pinyin":"dòng dì jīng tiān","abbr":"ddjt","explanation":"惊：惊动；动：震撼。使天地惊动。形容某个事件的声势或意义极大。","source":{"text":"可怜荒冢穷泉骨，曾有惊天动地文。","book":"唐·白居易《李白墓》诗"},"example":{"text":"夺魁喊声竟起，～怒似雷，天赛比。","book":"明·无名氏《阴山破虏》第三折"},"similar":["惊天动地"],"opposite":["风平浪静"],"usage":"作谓语、定语；形容声势极大"},{"id":9066,"word":"动天地，感鬼神","pinyin":"dòng tiān dì，gǎn guǐ shén","abbr":"dtdggs","explanation":"动：感动；感：感动。使天地鬼神受到感动。形容事迹或作品十分感人。","source":{"text":"诗之极致，可以动天地，感鬼神。","book":"金·元好问《陶然集诗序》"},"example":{"text":"诗之为教，其效至于～。","book":"清·朱彝尊《高舍人诗序》"},"similar":["动天地，泣鬼神"],"usage":"作谓语、定语；用于感人的事迹等"},{"id":9067,"word":"动天地，泣鬼神","pinyin":"dòng tiān dì，qì guǐ shén","abbr":"dtdqgs","explanation":"动：感动；泣：低声哭。使天地鬼神受到感动。形容事迹或作品十分感人。","source":{"text":"然则匹妇虽微，及其精诚所激，往往动天地，泣鬼神，何可忽也？","book":"清·汪琬《烈妇周氏墓表》"},"example":{"text":"虽至全体殉职，也不肯退后一步，这种作战精神，真是可以～！","book":"邹韬奋《抗战以来·震动寰宇的民族战士》"},"similar":["动天地，感鬼神"],"usage":"作谓语、定语；用于感人的事迹等"},{"id":9068,"word":"动如参商","pinyin":"dòng rú shēn shāng","abbr":"drcs","explanation":"参、商：均是二十八宿之一，二星此出彼没，不同时在天空中出现。比喻人分离后不能再见面。","source":{"text":"人生不相见，动如参与商。","book":"唐·杜甫《赠卫八处士》"},"usage":"作谓语、定语；用于书面语"},{"id":9069,"word":"动如脱兔","pinyin":"dòng rú tuō tù","abbr":"drtt","explanation":"比喻行动敏捷。","source":{"text":"是故始如处女，敌人开户；后如脱兔，敌不及拒。","book":"春秋·齐·孙武《孙子·九地》"},"example":{"text":"“～”常与“静若处女”连用。"},"similar":["静如处女，动如脱兔"],"opposite":["静若处女"],"usage":"作谓语、定语；指人行动灵活"},{"id":9070,"word":"动如雷霆","pinyin":"dòng rú léi tíng","abbr":"drlt","explanation":"行动像雷霆一样迅猛。","source":{"text":"难知如阴，动如雷霆。","book":"《孙子·军争》"}},{"id":9071,"word":"动循矩法","pinyin":"dòng xún jǔ fǎ","abbr":"dxjf","explanation":"循：遵循；矩：规矩；法：法则，礼法。举动遵循规矩礼法。形容一举一动都符合道德规范。","source":{"text":"襄城公主，下嫁萧锐，性孝睦，动循矩法。","book":"《新唐书·诸帝公主传》"}},{"id":9072,"word":"动心娱目","pinyin":"dòng xīn yú mù","abbr":"dxym","explanation":"打动人心并使人感到快乐。多指声色享乐之事。","source":{"text":"及凡世间可动心娱目之事，皆斥去弗愿，若将浼我者。","book":"宋·陈亮《跋朱晦庵送写照郭秀才序后》"},"similar":["赏心悦目"],"usage":"作谓语、定语；用于声色享乐之事"},{"id":9073,"word":"动心忍性","pinyin":"dòng xīn rěn xìng","abbr":"dxrx","explanation":"动心：使内心惊动；忍性：使性格坚韧。指不顾外界阻力，坚持下去。","source":{"text":"所以动心忍性，曾（增）益其所不能。","book":"《孟子·告子下》"},"example":{"text":"古之贤哲，孰不病贫？苦其心志，空乏其身，～，方为志人。","book":"明·赵弼《疥鬼对》"},"similar":["坚持不懈"],"usage":"作谓语、定语；指有耐心"},{"id":9074,"word":"动心怵目","pinyin":"dòng xīn chù mù","abbr":"dxcm","explanation":"怵目：使人看了感到恐惧。看了使人感到内心恐惧。形容感受很深，震动非常大。","source":{"text":"虽才俊比肩，可喜可愕，至于动心怵目，无所不有，然其厚德伟度，要不复前人比。","book":"宋·陈亮《祭宗成志文》"},"example":{"text":"我遇到一件让我～的事。"},"similar":["动心骇目","惊心怵目"],"usage":"作谓语、定语、状语；指感动很大"},{"id":9075,"word":"动心骇目","pinyin":"dòng xīn hài mù","abbr":"dxhm","explanation":"骇目：使人看了感到惊骇。看了使人感到心动惊骇。形容感受很深，震动非常大。","source":{"text":"王遗墨藏家庙者，今虽仅存，某尝获观，皆奇丽超绝，动心骇目。","book":"宋·陆游《跋兰亭乐毅论并赵岐王帖》"},"example":{"text":"这事让他～。"},"similar":["动心怵目"],"opposite":["无动于衷"],"usage":"作谓语、定语、状语；指感触大"},{"id":9076,"word":"动必缘义","pinyin":"dòng bù yuán yì","abbr":"dbyy","explanation":"缘：顺着，沿着；义：道义。行动必定遵循公正合理的原则。","source":{"text":"君子之自行也，动必缘义，和必诚义，俗虽谓之穷，通也。","book":"《吕氏春秋·高义》"}},{"id":9077,"word":"动手动脚","pinyin":"dòng shǒu dòng jiǎo","abbr":"dsdj","explanation":"指男女间不庄重、挑逗一类的举动。也指打人。","source":{"text":"你这个鸟头陀，好不依本分，却怎地便动手动脚。","book":"明·施耐庵《水浒全传》第三十二回"},"example":{"text":"那老妈见老爷～，真实性赖着不起来。","book":"清·李宝嘉《官场现形记》第四十四回"},"similar":["捞捞搭搭","拉拉扯扯"],"opposite":["彬彬有礼"],"usage":"作宾语、状语；指动手打架，用于口语","story":["史湘云病了，贾宝玉经常去看望她，这让林黛玉的丫鬟紫鹃不满。贾宝玉看完史湘云后去拜访林黛玉，恰好黛玉在午休。宝玉便与紫鹃在外说笑，紫鹃劝宝玉不要动手动脚避免闲话，借机考验宝玉对黛玉的感情，她编的一段谎话让宝玉病了一场"]},{"id":9078,"word":"动罔不吉","pinyin":"dòng wǎng bù jí","abbr":"dwbj","explanation":"罔：无；吉：吉利。所作所为没有不吉利的。形容非常顺利。","source":{"text":"德惟一，动罔不吉。德二三，动罔不凶。","book":"《尚书·咸有一德》"}},{"id":9079,"word":"动而若静","pinyin":"dòng ér ruò jìng","abbr":"derj","explanation":"动：行动；若：象。行动却象静止一样。指军队或某种事情虽已行动，由于隐蔽等原因，使人感到象没有行动一样。","source":{"text":"动而若静，则疑我之休兵。","book":"清·陈光宪《历代名将事略》"}},{"id":9080,"word":"动荡不安","pinyin":"dòng dàng bù ān","abbr":"ddba","explanation":"荡：摇动。动荡摇摆，不安定。形容局势不稳定，不平静。","source":{"text":"他和陈文婷谈起，两人都觉得纵然社会上动荡不安，革命的前途还是光明的，乐观的。","book":"欧阳山《三家巷》第十八章"},"example":{"text":"路遥《平凡的世界》第四卷第36章：“～的大自然也煽起了他内心的风暴。”"},"similar":["动荡不定"],"opposite":["平平稳稳"],"usage":"作谓语、定语、状语；用于社会、局势等"},{"id":9081,"word":"动荡不定","pinyin":"dòng dàng bù dìng","abbr":"ddbd","explanation":"荡：摇动。动荡摇摆，不安定。形容局势不稳定，不平静。","source":{"text":"粤系军队又侵入湘南，两湖局势也在动荡不定中。","book":"陶菊隐《北洋军阀统治时期史话》第77章"},"example":{"text":"在～的岁月里，他始终保持这个良好习惯。"},"similar":["动荡不安"],"opposite":["纹丝不动","风平浪静"],"usage":"作谓语、定语；指局势"},{"id":9082,"word":"动辄得咎","pinyin":"dòng zhé dé jiù","abbr":"dzdj","explanation":"辄：即；咎：过失，罪责。动不动就受到指摘或责难。","source":{"text":"跋前踬后，动辄得咎。","book":"唐·韩愈《进学解》"},"example":{"text":"小厮因～，只得说道：“请问主人：前引也不好，后随也不好，并行也不好，究竟怎样才好呢？”","book":"清·李汝珍《镜花缘》第七十八回"},"similar":["跋前踬后"],"opposite":["八面圆通"],"usage":"作谓语、定语；指做事往往获罪","story":["唐朝时期，韩愈学识渊博，被任命监察御史，因反对宦官利用“宫市”敲诈百姓，触怒了唐德宗被贬，后在唐宪宗时调回京城任吏部员外郎，他又因华州刺史之事被贬为国子监博士，他作《进学解》感慨自己：“跋前踬后，动辄得咎。”"]},{"id":9083,"word":"动静有常","pinyin":"dòng jìng yǒu cháng","abbr":"djyc","explanation":"常：常规，法则。行动和静止都有一定常规。指行动合乎规范。","source":{"text":"动静有常，刚柔断矣。","book":"《周易·系辞上》"},"similar":["动静有法"],"usage":"作定语、宾语；指行动合乎规范"},{"id":9084,"word":"动静有法","pinyin":"dòng jìng yǒu fǎ","abbr":"djyf","explanation":"法：常规，法则。行动和静止都有一定常规。指行动合乎规范。","source":{"text":"动静有常，刚柔断矣。","book":"《周易·系辞上》"},"example":{"text":"清闲贞静，守节整齐，行己有耻，～，是谓妇德。","book":"《金史·后妃传赞》"},"similar":["动静有常"],"usage":"作定语、宾语；指行动合乎规范"},{"id":9085,"word":"动魄惊心","pinyin":"dòng pò jīng xīn","abbr":"dpjx","explanation":"使人神魂震惊。原指文辞优美，意境深远，使人感受极深，震动极大。后常形容使人十分惊骇紧张到极点。","source":{"text":"文温以丽，意悲而远。惊心动魄，可谓几乎一字千金！","book":"南朝·梁·钟嵘《诗品》卷上"},"example":{"text":"其事至险　计至毒。道路相告，～。","book":"毛泽东《为皖南事变发表的命令和谈话》"},"similar":["惊心动魄"],"usage":"作定语；指震动很大"},{"id":9086,"word":"助人下石","pinyin":"zhù rén xià shí","abbr":"zrxs","explanation":"帮助别人去作害人的事。","source":{"text":"对于他们，攻击的人又正多，我何必再来助人下石呢。","book":"鲁迅《三闲集·通信》"},"similar":["为虎作伥"],"usage":"作谓语、定语、宾语；用于处事"},{"id":9087,"word":"助人为乐","pinyin":"zhù rén wéi lè","abbr":"zrwl","explanation":"帮助人就是快乐。","source":{"text":"在我们的新社会里，这种助人为乐的新风尚，可以说是天天在发生，处处在发生。","book":"冰心《咱们的五个孩子》"},"example":{"text":"他一向都是～。"},"opposite":["乘人之危","助桀为虐"],"usage":"作谓语、宾语、状语；指帮助别人"},{"id":9088,"word":"助天为虐","pinyin":"zhù tiān wéi nüè","abbr":"ztwn","explanation":"趁有天灾的时候害人。","source":{"text":"无助天为虐，助天为虐者不祥。","book":"《国语·越语下》"},"similar":["助纣为虐"],"usage":"作谓语、定语；指天灾人祸"},{"id":9089,"word":"助我张目","pinyin":"zhù wǒ zhāng mù","abbr":"zwzm","explanation":"张目：睁大眼睛，比喻张扬气势。比喻得到别人的赞助，声势更加壮大。","source":{"text":"墨翟不好伎，何为过朝歌而回车乎？足下好伎，值墨翟回车之县，想足下助我张目也。","book":"三国魏·曹植《与吴季重书》"},"example":{"text":"留学生中～的人，较从前增加百倍，才晓得人心进化，是实有的。","book":"章炳麟《东京留学生欢迎会演说辞》"},"usage":"作谓语、定语；指得到帮助"},{"id":9090,"word":"助桀为恶","pinyin":"zhù jié wéi è","abbr":"zjwe","explanation":"比喻帮着坏人做坏事。","source":{"text":"因为无条件的生存，同流合污助桀为恶的生存，虽生犹死，乃至生不如死。","book":"邹韬奋《信箱期望》"},"example":{"text":"至少我不能～，我不能同流合污！","book":"巴金《雪》"},"similar":["助桀为虐","为虎作伥"],"usage":"作谓语、定语、宾语；指为虎作伥"},{"id":9091,"word":"助桀为暴","pinyin":"zhù jié wéi bào","abbr":"zjwb","explanation":"桀，夏末暴君。比喻帮助恶人做坏事。同“助桀为虐”。","source":{"text":"国既破亡，吾不能存；今有劫之以兵为君将，是助桀为暴也。","book":"《史记·田单列传》"},"similar":["助桀为恶","助桀为虐"],"usage":"作谓语、定语；指为虎作伥"},{"id":9092,"word":"助桀为虐","pinyin":"zhù jié wéi nüè","abbr":"zjwn","explanation":"桀：即夏桀，夏朝最后一个君主，相传是暴君；虐：残暴。帮助夏桀行暴虐之事。比喻帮助坏人干坏事。","source":{"text":"今始入秦，即安其乐，此所谓助桀为虐。","book":"《史记·留侯世家》"},"example":{"text":"又加上他那次子纪成文，～，作的那些侵冒贪黩，忌刻残忍的事，一时也道不尽许多。","book":"清·文康《儿女英雄传》第十八回"},"similar":["为虎作伥","为虎添翼","助纣为虐"],"opposite":["助人为乐","除暴安良"],"usage":"作谓语、定语；指为虎作伥","story":["秦朝末年，刘邦率军攻入长安，接受秦王子婴的投降，面对奢华的宫廷生活，刘邦想占据皇宫就此享受起来，樊哙认为现在不是时候，张良也认为如果占据就是助桀为虐，人们就不再支持了。刘邦认为有道理就率军退居灞上等候项羽"]},{"id":9093,"word":"助画方略","pinyin":"zhu hua fang lue","abbr":"zhfl","explanation":"协助规划作战的方针策略."},{"id":9094,"word":"助纣为虐","pinyin":"zhù zhòu wéi nüè","abbr":"zzwn","explanation":"纣是商朝的最后一个王，据传是暴君。比喻帮助坏人干坏事。","source":{"text":"今始入秦，即安其乐，此所谓助桀为虐。","book":"《史记·留侯世家》"},"example":{"text":"后又助着薛蟠图些银钱酒肉，一任薛蟠横行霸道，他不但不去管约，反～讨好儿。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["为虎作伥","为虎添翼"],"opposite":["助人为乐","除暴安良"],"usage":"作谓语、定语；指为虎作伥","story":["秦朝末年，刘邦率大军攻占京都咸阳，秦王子婴见大势已去就投降。刘邦进入咸阳后，见秦宫壮丽宏伟，有无数金银财宝和妙龄少女，他想留守咸阳。大将樊哙与谋士张良认为这是助纣为虐，会失去天下人心，刘邦就退守霸上"]},{"id":9095,"word":"助边输财","pinyin":"zhù biān shū cái","abbr":"zbsc","explanation":"边：边防；输：捐献。捐献财物作巩固边防的费用。","source":{"text":"时汉方事匈奴，式上书，愿输家财半助边。","book":"《汉书·卜式传》"},"example":{"text":"夫赈饥出粟，犹是游侠之风；～，不遗忠爱之末。","book":"清·欧阳巨源《官场现形记序》"},"similar":["输财助边"],"usage":"作谓语、宾语、定语；指为国分忧"},{"id":9096,"word":"努力加餐","pinyin":"nǔ lì jiā cān","abbr":"nljc","explanation":"尽量多吃些饭。常用作勉励保重之语。","source":{"text":"弃捐勿复道，努力加餐饭。","book":"《古诗十九首》之一"},"example":{"text":"窦妃本来可去可不去，但她一则为要看一看皇上的神情，二则要使皇上心情愉快，劝他～。","book":"姚雪垠《李自成》第四卷第二十一章"},"usage":"作谓语、定语；用于勉励保重"},{"id":9097,"word":"努唇胀嘴","pinyin":"nǔ chún zhàng zuǐ","abbr":"nczz","explanation":"努：用力伸出或突出；胀：膨胀。形容不欢喜的样子。","source":{"text":"连这等一个刚毅不屈的仲由老官，尚且努唇胀嘴，使性旁气。","book":"清·蒲松龄《醒世姻缘》第33回"},"usage":"作谓语、定语；指不高兴"},{"id":9098,"word":"努牙突嘴","pinyin":"nǔ yá tū zuǐ","abbr":"nytz","explanation":"努：凸出。形容愤怒的样子。","source":{"text":"早努牙突嘴，拳椎脚踢，打的你哭啼啼。","book":"元·关汉卿《救风尘》第一折"},"usage":"作谓语、状语、定语；用于人的神态"},{"id":9099,"word":"努目撑眉","pinyin":"nǔ mù chēng méi","abbr":"nmcm","explanation":"努目：怒目。竖眉瞪眼。形容愤怒、生气的样子。","source":{"text":"他见我早揎拳捋袖，努目撑眉。","book":"元·萧德祥《杀狗劝夫》第二折"}},{"id":9100,"word":"努筋拔力","pinyin":"nǔ jīn bá lì","abbr":"njbl","explanation":"努：用力伸出；拔：超过。凸出青筋，使尽力气。形容竭尽全力。","source":{"text":"混话的！买了人家孩子来，数九的天不与棉衣裳穿，我看拉不上，努筋拔力的替他做了衣裳，不自家讨愧，还说长道短的哩！","book":"清·西周生《醒世姻缘传》第七十九回"},"example":{"text":"十几岁上，他就～，耕种他家剩下的那几亩土地了。","book":"孙犁《乡里旧闻》二"},"usage":"作谓语、状语；指竭尽全力"},{"id":9101,"word":"劫制天下","pinyin":"jié zhì tiān xià","abbr":"jztx","explanation":"劫：强迫；制：制服。以武力制服天下。","source":{"text":"武后乘唐中衰，操杀生柄，劫制天下，而攘神器。","book":"《新唐书·狄仁杰传》"}},{"id":9102,"word":"劫后余生","pinyin":"jié hòu yú shēng","abbr":"jhys","explanation":"劫：灾难；余生：侥幸保全的生命。经历灾难以后幸存下来的生命。","source":{"text":"归飞越鸟恋南枝，劫后余生叹数奇。","book":"清·丘逢甲《岭云海日楼诗钞》"},"example":{"text":"和这季节极不相称的是，我的心境总有一种‘～’的悲凉。","book":"李准《飘来的生命》"},"similar":["九死一生","死里逃生"],"opposite":["吉人天相","洪福齐天"],"usage":"作谓语、定语、宾语；指灾后幸存"},{"id":9103,"word":"劫富救贫","pinyin":"jié fù jiù pín","abbr":"jfjp","explanation":"劫：强取；救：救助。夺取富人的财产，救助穷苦百姓。","source":{"text":"天地会和饥民纷纷起义，揭‘官逼民反’……‘劫富救贫’等旗号，攻占城市，诛戮官吏。","book":"范文澜《中国近代史》上册第三章"},"example":{"text":"老百姓盼望有～的英雄出现。"},"similar":["劫富济贫"],"opposite":["助纣为虐"],"usage":"作谓语、定语、宾语；指均贫富"},{"id":9104,"word":"劫富济贫","pinyin":"jié fù jì pín","abbr":"jfjp","explanation":"劫：强取；济：救济。夺取富人的财产，救济穷人。","source":{"text":"老汉平生最喜欢劫富济贫，抑强扶弱，打抱不平。","book":"清·曾朴《孽海花》第三十五回"},"example":{"text":"会因南北统一，所谋未遂，乃想学王天纵的行为，～，自张一帜。","book":"蔡东藩、许厪父《民国通俗演义》第二十五回"},"similar":["除暴安良","杀富济贫"],"opposite":["为虎作伥","助纣为虐"],"usage":"作谓语、定语、宾语；指均贫富"},{"id":9105,"word":"劫数难逃","pinyin":"jié shù nán táo","abbr":"jsnt","explanation":"佛家用语，命中注定的灾祸。命中注定的灾祸难以逃脱。","source":{"text":"正所谓神仙难到；削去顶上叁花；那怕你佛祖亲来，也消了胸中五气。逢此阵劫数难逃，遇他时真人怎躲。","book":"明·许仲琳《封神演义》第五十回"},"example":{"text":"宗敏闻言，即与自成一同叩祷，三卜三吉。神明亦助剧贼，想是～。","book":"蔡东藩《明史演义》第九十六回"},"similar":["在劫难逃"],"usage":"作宾语、定语；用于迷信说法"},{"id":9106,"word":"劬劳之恩","pinyin":"qú láo zhī ēn","abbr":"qlze","explanation":"指父母辛劳养育子女之恩。","source":{"text":"在京师图个荫子封妻，光耀祖宗，报答父母劬劳之恩。","book":"明·施耐庵《水浒传》第119回"},"usage":"作宾语；指父母的养育之恩"},{"id":9107,"word":"劬劳顾复","pinyin":"qú láo gù fù","abbr":"qlgf","explanation":"劬劳：劳累，操劳。顾复：照顾抚育。","source":{"text":"钦为先皇太后，夙明壶则，克嗣徽音，辅佐先朝，有恭俭节用之实，诞育眇质，有劬劳顾复之思。","book":"《元史·后妃传一》"},"usage":"作宾语、定语；用于父母的恩情"},{"id":9108,"word":"励兵秣马","pinyin":"lì bīng mò mǎ","abbr":"lbmm","explanation":"励：磨利；兵：兵器；秣：喂。磨好兵器，喂饱马匹。指准备战斗","source":{"text":"请都督励兵秣马，以待此期。","book":"唐·陈子昂《为建安王与辽东书》"},"example":{"text":"明·施耐庵《水浒传》第94回：“山士奇到壶关，知盖州失守，料宋兵必来取关，日日～，准备迎敌。”"},"similar":["厉兵秣马","砺兵秣马","厉兵粟马"],"opposite":["马放南山"],"usage":"作谓语；指准备战斗"},{"id":9109,"word":"励志冰檗","pinyin":"lì zhì bīng bò","abbr":"lzbb","explanation":"形容在清苦的生活环境中激励自己的意志。","source":{"text":"臣祖父以来，世守清白，束发入官，励志冰檗。","book":"宋·郑兴裔《忠肃集》"}},{"id":9110,"word":"励志如冰","pinyin":"lì zhì rú bīng","abbr":"lzrb","explanation":"指激励意志使身心如同晶莹的冰一样清白。","source":{"text":"臣祖父以来，世守清白，束发入官，励志冰檗。","book":"宋·郑兴裔《忠肃集》"},"example":{"text":"何况这位姑娘守身若玉，～。","book":"清·文康《儿女英雄传》第二十三回"}},{"id":9111,"word":"励志竭精","pinyin":"lì zhì jié jīng","abbr":"lzjj","explanation":"指坚定意志，竭尽全力。","source":{"text":"定以天下布衣励志竭精，以赴延阙。","book":"《汉书·梅福传》"},"usage":"作谓语、状语；用于处事"},{"id":9112,"word":"励精图治","pinyin":"lì jīng tú zhì","abbr":"ljtz","explanation":"图：谋求，设法。厉：奋勉。治：治理。振奋精神，设法把国家治理好。亦作“励精图治”、“厉精求治”、“厉精为治”。","source":{"text":"厉精图治，将大有为。","book":"《宋史·神宗纪赞》"},"example":{"text":"请一月三朝，以副～至意。","book":"《清史稿·礼志七》"},"similar":["雄才大略"],"opposite":["丧权辱国","祸国殃民"],"usage":"作主语、谓语、宾语；用于统治者","story":["公元前68年，大司马大将军霍光病死，御史大夫魏相建议汉宣帝刘询采取措施削弱霍氏权力。霍氏假借太后命令欲杀魏相，汉宣帝先发制人将霍氏满门抄斩，从此亲自处理朝政，振作精神，力图把国家治理得繁荣富强"]},{"id":9113,"word":"励精图进","pinyin":"lì jīng tú jìn","abbr":"ljtj","explanation":"励精：振奋精神；图：指谋求。挂历精神，力求前进。","example":{"text":"那梁洪却是个勤俭之人，～，经营有方。","book":"高罗佩《铜钟案》第十四章"}},{"id":9114,"word":"励精更始","pinyin":"lì jīng gēng shǐ","abbr":"ljgs","explanation":"振作精神，从事革新。","source":{"text":"其赦天下，与士大夫厉精更始。","book":"《汉书·宣帝纪》"}},{"id":9115,"word":"励精求治","pinyin":"lì jīng qiú zhì","abbr":"ljqz","explanation":"励：同“厉”，振作，振奋；治：治理国家。振奋精神，想办法治理好国家","source":{"text":"擢御史中丞，帝方励精求治。","book":"宋·邵伯温《闻见前录》第十卷"},"example":{"text":"《新唐书·元稹传》：“以陛下睿博洪深，～，岂言而不用哉？”"},"similar":["厉精求治","励精图治"],"usage":"作谓语、宾语；用于统治者"},{"id":9116,"word":"劲骨丰肌","pinyin":"jìng gǔ fēng jī","abbr":"jgfj","explanation":"劲：强有力；丰：丰满美好。形容书法笔势有力而丰润。","source":{"text":"然张劲骨丰肌，德冠诸贤之首。","book":"唐·张怀雚《书断》"},"usage":"作宾语、定语；形容书法等"},{"id":9117,"word":"劳什子","pinyin":"láo shí zi","abbr":"lsz","explanation":"指讨厌的东西。","source":{"text":"什么罕物！人的高下不识，还说灵不灵呢！我也不要这劳什子。","book":"清·曹雪芹《红楼梦》第三回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第71回：“我只插镑了这一点～，还觉着怪寒碜的。”"},"similar":["牢什古子"],"usage":"作宾语；用于方言"},{"id":9118,"word":"劳力费心","pinyin":"láo lì fèi xīn","abbr":"llfx","explanation":"指耗用力气，苦费心思。","source":{"text":"末将启太师，东伯侯姜文焕，年年不息兵戈，使游魂关窦荣劳力费心。","book":"明·许仲琳《封神演义》第三十五回"},"example":{"text":"可见保存名目，全不必～。","book":"鲁迅《随感录》三十六"}},{"id":9119,"word":"劳师动众","pinyin":"láo shī dòng zhòng","abbr":"lsdz","explanation":"劳：疲劳，辛苦；师、众：军队；动：出动，动员。原指出动大批军队。现指动用很多人力。","source":{"text":"长兄，不必劳师动众，他自然尽绝，也使旁人知我等妙法无边。——不动声色，令周兵六十万余人自然灭绝。","book":"明·许仲琳《封神演义》第八十一回"},"example":{"text":"为了这一点点小么魔，便闹的～，未免过于荒唐了。","book":"清·吴趼人《二十年目睹之怪现状》第六十八回"},"similar":["劳民伤财","大动干戈"],"opposite":["按兵不动"],"usage":"作谓语、补语；指小题大作"},{"id":9120,"word":"劳师废财","pinyin":"láo shī fèi cái","abbr":"lsfc","explanation":"师：军队。劳顿军队，浪费军饷。","source":{"text":"旷日绵岁，劳师废财。","book":"唐·陆贽《收河东后请兵状》"}},{"id":9121,"word":"劳师糜饷","pinyin":"láo shī mí xiǎng","abbr":"lsmx","explanation":"指徒劳兵力，空费军饷。","source":{"text":"旷日绵岁，劳师废财。","book":"唐·陆贽《收河东后请兵状》"},"example":{"text":"正因为军粮来之不易，所以皇上才急着要解锦州之围，免得～。","book":"姚雪垠《李自成》第三卷第十五章"},"usage":"作谓语、定语、宾语；用于处事"},{"id":9122,"word":"劳师袭远","pinyin":"láo shī xí yuǎn","abbr":"lsxy","explanation":"发动军队袭击远方的敌人，多指冒险的军事活动。","source":{"text":"劳师以袭远，非所闻也。","book":"《左传·僖公三十二年》"},"example":{"text":"剿贼于既聚之余，何如蹙贼以难聚之势？又而无～之危，轻进损威之失，所谓不战而屈人之兵者是也。","book":"《清史稿·毛昶熙传》"},"usage":"作谓语、定语；用于军事","story":["春秋时期，秦国在郑国的留守官员杞子派人告诉秦穆公他已负责郑国京城北门的防务，要是派兵来偷袭一定成功。秦穆公不听蹇叔劳师袭远不会成功的主张，派大将孟明视、西乞术、白乙丙率军攻郑，结果中了伏击，三人被俘"]},{"id":9123,"word":"劳形苦心","pinyin":"láo xíng kǔ xīn","abbr":"lxkx","explanation":"身体疲劳，精神困乏。","source":{"text":"劳形苦心，扶危济急，是贱人的东西，大人们不取的。","book":"鲁迅《故事新编·非攻》"},"example":{"text":"这事让我～。"},"usage":"作主语、宾语；指身体疲劳，精神困乏"},{"id":9124,"word":"劳形苦神","pinyin":"láo xíng kǔ shén","abbr":"lxks","explanation":"形：形体；神：精神。劳累形体，费尽精神。指用心用力，认真干事。","source":{"text":"若夫终日暴露驰骋，劳神苦形，罢车马之用，抏士卒之精，费府库之财，而无德厚之恩，务在独乐，不顾众庶，忘国家之政，而贪雉兔之获，则仁者不由也。","book":"《史记·司马相如列传》"}},{"id":9125,"word":"劳心忉忉","pinyin":"láo xīn dāo dāo","abbr":"lxdd","explanation":"忉忉：忧念的样子。形容极度忧心的样子。","source":{"text":"无思远人，劳心忉忉。","book":"《诗经·齐风·甫田》"}},{"id":9126,"word":"劳心焦思","pinyin":"láo xīn jiāo sī","abbr":"lxjs","explanation":"劳：费；焦：焦急。形容人为某事忧心苦思。","source":{"text":"张后不乐上为忙，至令今上犹拨乱，劳心焦思补四方。","book":"唐·杜甫《忆昔二首》一"},"example":{"text":"本大总统～，几废寝食。","book":"蔡东藩、许廑父《民国通俗演义》第十五回"},"similar":["苦思苦想","冥思苦想"],"usage":"作谓语、宾语；指冥思苦想"},{"id":9127,"word":"劳心苦思","pinyin":"láo xīn kǔ sī","abbr":"lxks","explanation":"费尽心机，苦思焦虑。","source":{"text":"非至圣达奥，不能御世；非劳心苦思，不能原事。","book":"《鬼谷子·忤合第六》"},"example":{"text":"竞虚名，夺浮利，日夜劳心苦焦思。","book":"明·赵弼《梦游番阳彭蠡传》"},"similar":["冥思苦想","劳心焦思"],"usage":"作谓语、宾语；指冥思苦想"},{"id":9128,"word":"劳思逸淫","pinyin":"láo sī yì yín","abbr":"lsyy","explanation":"逸：安逸。指参加实际劳动，才能想到爱惜物力，知道节俭；贪图安逸就容易放荡堕落。","source":{"text":"劳则思，思则善心生；逸则淫，淫则忘善，忘善则恶心生。","book":"春秋·鲁·左丘明《国语·鲁语》"},"example":{"text":"我们得～，不能忘本。"},"usage":"作宾语、定语；用于劝诫人","story":["春秋时期，鲁国贵族子弟公父文伯继承祖上大夫的爵位，他退朝回家见母亲敬姜正在渍麻，看到母亲辛苦的样子，让她不要干这下人干的活，母亲告诫他要经常参加劳动，才会认真思考问题，善良待人，贪图安逸的人只会荒淫奢侈"]},{"id":9129,"word":"劳民伤财","pinyin":"láo mín shāng cái","abbr":"lmsc","explanation":"既使人民劳苦，又耗费钱财。现也指滥用人力物力。","source":{"text":"不伤财，不害民。","book":"《周易·节》"},"example":{"text":"天下闻风皆争进奇巧，则～自此始矣。","book":"明·余继登《典故纪闻》卷二"},"similar":["事倍功半","舍本求末","因小失大"],"opposite":["一举两得","事半功倍","一箭双雕"],"usage":"作谓语、定语；指无益的劳动"},{"id":9130,"word":"劳民动众","pinyin":"láo mín dòng zhòng","abbr":"lmdz","explanation":"动用众多民力去做某件事。","source":{"text":"纪年之挽粟飞刍，继日而劳民动众，常烦漕运，不给供须。","book":"《旧五代史·晋书·高祖纪》"},"example":{"text":"能使西夏叛卒不敢逞，能使叛卒一起即扑灭，不至～。","book":"明·李贽《复麻城人书》"},"similar":["兴师动众","劳师动众"],"opposite":["亲历亲为"],"usage":"作谓语、定语、宾语；用于处事"},{"id":9131,"word":"劳民费财","pinyin":"láo mín fèi cái","abbr":"lmfc","explanation":"既使人民劳苦，又耗费钱财。现也指滥用人力物力。亦作“劳民伤财”。","source":{"text":"唐之治不能过两汉，而地广于三代，劳民费财，祸所繇生。","book":"《新唐书·南诏传赞》"},"example":{"text":"信狂狡之人，妄之人，妄兴水利，～。","book":"宋·司马光《应诏言朝政阙失事》"},"similar":["劳民伤财"],"opposite":["事半功倍"],"usage":"作谓语、定语；指无益的劳动"},{"id":9132,"word":"劳燕分飞","pinyin":"láo yàn fēn fēi","abbr":"lyff","explanation":"劳：伯劳。伯劳、燕子各飞东西。比喻夫妻、情侣别离。","source":{"text":"东飞伯劳西飞燕，黄姑织女时相见。","book":"《乐府诗集·东飞伯劳歌》"},"example":{"text":"其谓他日～，各自西东，在天之涯地之角耶？（清·王韬《淞隐漫录·尹瑶仙》）"},"similar":["生离死别","风流云散"],"opposite":["济济一堂","鸾翔凤集"],"usage":"作谓语、宾语；比喻人离别"},{"id":9133,"word":"劳神苦形","pinyin":"láo shén kǔ xíng","abbr":"lskx","explanation":"神：精神；形：形体。劳累形体，费尽精神。指用心用力，认真干事。","source":{"text":"若夫终日暴露驰骋，劳神苦形，罢车马之用，抏士卒之精，费府库之财，而无德厚之恩，务在独乐，不顾众庶，忘国家之政，而贪雉兔之获，则仁者不由也。","book":"《史记·司马相如列传》"},"example":{"text":"每事皆自决断，虽则～，未能尽合于理。","book":"唐·吴竞《贞观政要·君道》"}},{"id":9134,"word":"劳神苦思","pinyin":"láo shén kǔ sī","abbr":"lsks","explanation":"劳：费。形容人为某事忧心苦思。","source":{"text":"禹伤先人父鲧功之不成受诛，乃劳身焦思，居外十三年，过家门不敢入。","book":"《史记·夏本纪》"},"example":{"text":"何必～，代百司之职役哉。","book":"唐·魏征《谏太宗十思疏》"}},{"id":9135,"word":"劳筋苦骨","pinyin":"láo jīn kǔ gǔ","abbr":"ljkg","explanation":"指劳动繁重，使筋骨疲劳痛苦。","source":{"text":"故工之用钝器也，劳筋苦骨。","book":"东汉·班固《汉书·王褒传》"},"example":{"text":"早晨要打柴，日里要挑水，晚要舂谷簸米，～，没一刻得安闲。","book":"明·凌濛初《二刻拍案惊奇》第22卷"},"usage":"作谓语、宾语；用于体力劳动"},{"id":9136,"word":"劳而不怨","pinyin":"láo ér bù yuàn","abbr":"leby","explanation":"劳：劳苦，劳累。虽然很辛苦、很劳累，却没有怨言。形容孝子精心侍奉父母。也指当政者使民勤劳而民无埋怨。","source":{"text":"君子惠而不费，劳而不怨，欲而不贪，泰而不骄，威而不猛。","book":"《论语·里仁》：“事父母几谏，见志不从，又敬不违，劳而不怨。”《论语·尧曰》"},"example":{"text":"谏之不从，又敬不违，～，此大舜所以“只载见瞽瞍，瞽瞍底豫，而天下之为父子者定”也。","book":"清·文康《儿女英雄传》第三十七回"}},{"id":9137,"word":"劳而不获","pinyin":"láo ér bù huò","abbr":"lebh","explanation":"获：收获。付出了劳动，但没有得到应有的报酬。"},{"id":9138,"word":"劳而少功","pinyin":"láo ér shǎo gōng","abbr":"lesg","explanation":"少：不多。花了力气却只收到微小的效果。","source":{"text":"儒者博而寡要，劳而少功，是以其事难尽从；然其序君臣父子之礼，列夫妇长幼之别，不可易也。","book":"《史记·太史公自序》"},"example":{"text":"此其所以博而寡要，～者也。","book":"《隋书·经籍志一》"}},{"id":9139,"word":"劳而无功","pinyin":"láo ér wú gōng","abbr":"lewg","explanation":"花费了力气，却没有收到成效。","source":{"text":"与不可，强不能，告不知，谓之劳而无功。","book":"《管子·形势篇》"},"example":{"text":"不注意科学，一味地蛮干，结果必定是～。"},"similar":["水中捞月","枉费心机"],"opposite":["坐享其成","不劳而获"],"usage":"作谓语、宾语、定语；用于评价一个人做事","story":["春秋末期，孔子极力主张用仁义道德来治理国家，恢复过去的礼制，主张统治阶级用仁义来感化百姓，可惜没人欢迎他的政治主张。他去卫国游说前，鲁国太师金说他这样做无疑是把船弄到陆地上去运货一样劳而无功"]},{"id":9140,"word":"劳苦功高","pinyin":"láo kǔ gōng gāo","abbr":"lkgg","explanation":"出了很多力，吃了很多苦，立下了很大的功劳。","source":{"text":"劳苦而功高如此。","book":"《史记·项羽本纪》"},"example":{"text":"这是决战的最后五分钟了！这一班～的“英雄”，手颤颤地举着“胜利之杯”，心头还不免有些怔忡不定。","book":"茅盾《子夜》十五"},"similar":["功德无量","公垂竹帛"],"opposite":["劳而无功","徒劳无益"],"usage":"作谓语、定语；指人功劳大","story":["秦朝末年，刘邦率军攻占秦都咸阳后驻守函谷关，项羽听说刘邦攻占咸阳，就气急败坏在鸿门摆宴席请刘邦。席间项庄舞剑助兴想借机杀刘邦。樊哙赶紧拔剑上前对项羽说：“沛公恭候大王的到来，没有封侯，你却要杀如此劳苦功高的人？”"]},{"id":9141,"word":"劳身焦思","pinyin":"láo shēn jiāo sī","abbr":"lsjs","explanation":"劳：费；焦：焦急。形容人为某事忧心苦思。","source":{"text":"禹伤先人父鲧功之不成受诛，乃劳身焦思，居外十三年，过家门不敢入。","book":"《史记·夏本纪》"},"example":{"text":"张后不乐上为忙，至令今上犹拨乱，～补四方。","book":"唐·杜甫《忆昔二首》之一"},"usage":"作谓语、宾语；指人很辛苦"},{"id":9142,"word":"劳逸不均","pinyin":"láo yì bù jūn","abbr":"lybj","explanation":"逸：安逸、安乐。有的人过于辛劳，有的人过于安乐。","source":{"text":"丰州旧不居民中，赋役参集，劳逸不均。","book":"《北史·令狐整传》"},"example":{"text":"若教我终日在家静坐，未免～。","book":"清·李汝珍《镜花缘》第六十四回"}},{"id":9143,"word":"劳逸结合","pinyin":"láo yì jié hé","abbr":"lyjh","explanation":"逸：安乐、休息。工作与休息相结合。","source":{"text":"搞好劳逸结合，不仅不会降低而且有助于提高教学质量。","book":"邓小平《关于科学和教育工作的几点意见》"},"example":{"text":"我们工作中要注意～提高工作效率。"},"similar":["有劳有逸"],"usage":"作谓语、宾语；用于规劝"},{"id":9144,"word":"劳问不绝","pinyin":"láo wèn bù jué","abbr":"lwbj","explanation":"劳问：慰问。慰问的人接连不断。","source":{"text":"永始、元延间，比年日蚀，故久不还放，玺书劳问不绝。","book":"《汉书·张延寿传》"},"example":{"text":"其居西洛也，时～，书成，除资政殿学士，于是四方称美，遂以司马相公呼之。","book":"清·毕沅《续资治通鉴》卷一百十一"}},{"id":9145,"word":"势不两全","pinyin":"shì bù liǎng quán","abbr":"sblq","explanation":"势：情势；两全：双方均得益。指敌对的双方不能同时存在。比喻矛盾不可调和。","source":{"text":"今兄弟遘恶，此势不两全。","book":"《韩非子·人主》：“故有术不必用，而势不两立，法术之士焉能无危。”《三国志·魏志·荀攸传》"},"example":{"text":"～，弃儿救姑，此天理之正，而人心之所安也。","book":"清·纪昀《阅微草堂笔记·隗西杂志二》"},"similar":["势不两立","势不两存","势不并立"],"opposite":["亲密无间"],"usage":"作谓语、宾语、定语；用于人与事物"},{"id":9146,"word":"势不两存","pinyin":"shì bù liǎng cún","abbr":"sblc","explanation":"指敌对的事物不能同时并存。","source":{"text":"故资必不胜而势不两存，法术之士焉得不危？","book":"《韩非子·孤愤》"},"example":{"text":"得报恳恻，知与休久结嫌隙，～。","book":"《三国志·吴志·陆逊传》"},"similar":["势不两立","势不两全","势不并立"],"opposite":["亲密无间"],"usage":"作谓语、宾语、定语；用于人与事物"},{"id":9147,"word":"势不两立","pinyin":"shì bù liǎng lì","abbr":"sbll","explanation":"两立：双方并立。指敌对的双方不能同时存在。比喻矛盾不可调和。","source":{"text":"秦之所害于天下莫如楚，楚强则秦弱，楚弱则秦强，此其势不两立。","book":"《战国策·楚策一》"},"example":{"text":"这饮马川贼人这等可恶！几番来搅扰，与他～！","book":"清·陈忱《水浒后传》第二十回"},"similar":["你死我活","誓不两立"],"opposite":["情投意合","亲密无间"],"usage":"作谓语、宾语、定语；用于人与事物","story":["东汉末年，曹操率数十万大军进攻孙权和刘备。孙权召集大臣商讨对策，张昭等主张投降，而周瑜认为要联合刘备，利用曹军不能打持久战的特点抗击曹军。孙权采纳了周瑜的建议，挥剑砍断案桌并发誓说要与曹操势不两立"]},{"id":9148,"word":"势不两雄","pinyin":"shì bù liǎng xióng","abbr":"sblx","explanation":"势：情势。指敌对的双方不能同时存在。比喻矛盾不可调和。","source":{"text":"夫秦齐雄雌之国，秦强则齐弱矣，此势不两雄之国。","book":"《史记·孟尝君列传》"},"example":{"text":"秦与齐～，其雄者，乃得天下。","book":"明·冯梦龙《东周列国志》第九十四回"}},{"id":9149,"word":"势不俱栖","pinyin":"shì bù jù qī","abbr":"sbjq","explanation":"俱：在一起；栖：居住。互相对立，不能共容。","source":{"text":"暹、奉与术，卒合之军耳，策谋不素定，不能相维持，子登策之，比于连鸡，势不俱栖，可解离也。","book":"《三国志·魏志·吕布传》"}},{"id":9150,"word":"势不可为","pinyin":"shì bù kě wéi","abbr":"sbkw","explanation":"为：做，干。大势已去，无能为力。","source":{"text":"督相史忠烈公知势不可为，俦诸将而语之。","book":"清·全祖望《梅花岭记》"},"example":{"text":"我们不能干～的事情。"},"similar":["大势已去"],"opposite":["势在必行"],"usage":"作谓语、定语、宾语；指无能为力"},{"id":9151,"word":"势不可当","pinyin":"shì bù kě dāng","abbr":"sbkd","explanation":"当：抵挡。形容来势十分迅猛，不能抵挡。","source":{"text":"山上数处精兵杀下，势不可当，前军大败。","book":"《晋书·郗鉴传》：“群逆纵逸，其势不可当，可以算屈，难以力竞。”明·罗贯中《三国演义》第一百十九回"},"example":{"text":"擒兵捉将，～。","book":"清·吴璿《飞龙全传》第十一回"},"similar":["势如破竹","锐不可当"],"opposite":["日薄西山","大势已去","望风而逃"],"usage":"作谓语、定语；指来势迅猛"},{"id":9152,"word":"势不可挡","pinyin":"shì bù kě dǎng","abbr":"sbkd","explanation":"来势迅猛，不可抵挡。","source":{"text":"群逆纵逸，其势不可当，可以算屈，难以力竞。","book":"《晋书·郗鉴传》"},"example":{"text":"众将见西岐士马英雄，～，并无一筹可展，半策可施。","book":"明·许仲琳《封神演义》第二十八回"},"similar":["势不可当"],"opposite":["大势已去"],"usage":"作谓语、定语；指来势迅猛"},{"id":9153,"word":"势不可遏","pinyin":"shì bù kě è","abbr":"sbke","explanation":"犹势不可当。形容来势十分迅猛，不能抵挡。","source":{"text":"自东不顾，仗剑奋衣而往，势不可遏。","book":"唐·裴鉶《传奇·韦自东》"},"example":{"text":"后来白话渐渐通行了，～，有些人便一转而引为自己之功，美其名曰：‘新文化运动’。","book":"鲁迅《坟·写在〈坟〉后面》"},"similar":["势不可挡"],"usage":"作谓语、定语；指来势迅猛"},{"id":9154,"word":"势不容缓","pinyin":"shì bù róng huǎn","abbr":"sbrh","explanation":"势：情势；容：容许；缓：延缓，耽搁。比喻情势紧迫，一刻也不允许拖延。","source":{"text":"殿下可知东宫图谋，势不容缓，恐臣等不能终事殿下奈何？","book":"清·褚人获《隋唐演义》第66回"},"similar":["刻不容缓"],"usage":"作谓语、定语、状语；形容非常紧迫"},{"id":9155,"word":"势不并立","pinyin":"shì bù bìng lì","abbr":"sbbl","explanation":"势：情势；并立：同时存在。指敌对的双方不能同时存在。比喻矛盾不可调和。","source":{"text":"今楚、赵所起，其与秦势不并立，安危之机，呼吸成变，进则定功，退则受祸。","book":"《韩非子·人主》：“故有术不必用，而势不两立，法术之士焉能无危。”《汉纪·太祖高皇帝上》"},"example":{"text":"臣与二虏，～，聪勒不枭，臣无归志，比者秋谷既登，胡马已肥，前锋诸军，当有至者。","book":"蔡东藩《两晋演义》第二十七回"},"similar":["势不两立","势不两全","势不两存"],"opposite":["亲密无间"],"usage":"作谓语、宾语、定语；用于人与事物"},{"id":9156,"word":"势不得已","pinyin":"shì bù dé yǐ","abbr":"sbdy","explanation":"由于形势所迫而不得不如此。","source":{"text":"彼岂好为艰难哉？势不得已也。","book":"汉·扬雄《解嘲》"},"example":{"text":"他对于各地镇将宽容，并非他真心宽容，而是因为他～，害怕激起兵变。","book":"姚雪垠《李自成》第二卷第二十四章"}},{"id":9157,"word":"势位至尊","pinyin":"shì wèi zhì zūn","abbr":"swzz","explanation":"势：权势；位：地位。权势和地位极其尊贵。旧指帝王权势地位至高无上。","source":{"text":"天子者势位至尊，无知于天下。","book":"《荀子·正论》"}},{"id":9158,"word":"势倾天下","pinyin":"shì qīng tiān xià","abbr":"sqtx","explanation":"形容权势极大，压倒一切人。","source":{"text":"高祖父安，为汉司徒，自安以下四世，居三公位，由是势倾天下。","book":"《三国志·魏书·袁绍传》"},"similar":["势倾朝野"],"usage":"作谓语、定语；指权势极大"},{"id":9159,"word":"势倾朝野","pinyin":"shì qīng cháo yě","abbr":"sqcy","explanation":"形容权势极大，压倒一切人。","source":{"text":"时灵太后临朝，黄门侍郎李神轨势倾朝野，求结婚姻。","book":"《魏书·卢玄传》"},"example":{"text":"丹阳尹卞范之～，欲以女嫁方明。","book":"《南史·谢方明传》"},"similar":["势倾天下"],"usage":"作谓语、定语；指权势极大"},{"id":9160,"word":"势利之交","pinyin":"shì lì zhī jiāo","abbr":"slzj","explanation":"势：权势；利：利益。为权势和利益进行的交往。指趋炎附势的朋友。","source":{"text":"势利之交，古人羞之，盖谓是矣。","book":"《汉书·张耳陈余传赞》"},"example":{"text":"然弃本要末之徒，知进忘退之士，莫不饰才锐智，抽锋擢颖，倾侧乎～，驰骋乎当涂之务。","book":"《晋书·潘尼传》"}},{"id":9161,"word":"势利眼","pinyin":"shì lì yǎn","abbr":"sly","explanation":"待人势利，势利的人。","source":{"text":"鸿渐才买了些回去，进旅馆时，遮遮掩掩的深怕落在掌柜或伙计的势利眼里。","book":"钱钟书《围城》"},"example":{"text":"他是一个～。"},"usage":"作宾语、定语；指待人势利"},{"id":9162,"word":"势力之交","pinyin":"shì lì zhī jiāo","abbr":"slzj","explanation":"势：权势；交：交往。为权势利益进行的交往。指趋炎附势的朋友。","source":{"text":"势力之交，古人羞之。","book":"东汉·班固《汉书·张耳陈余传赞》"},"example":{"text":"我们的交往不是～。"},"similar":["小人之交"],"opposite":["君子之交"],"usage":"作主语、宾语；指利益往来的朋友"},{"id":9163,"word":"势合形离","pinyin":"shì hé xíng lí","abbr":"shxl","explanation":"势：形状；形：形体。形体各自独立，结构完整不分。","source":{"text":"桁梧复迭，势合形离。","book":"三国魏·何晏《景福殿赋》"},"similar":["貌合神离"],"usage":"作谓语、定语；同“貌合神离”"},{"id":9164,"word":"势在必行","pinyin":"shì zài bì xíng","abbr":"szbx","explanation":"行：做。从事情发展的趋势看，必须采取行动。","source":{"text":"光景是办不到的，却是保证全加倍一说，势在必行。","book":"茅盾《子夜》"},"example":{"text":"我们顺应潮流的变化～。"},"similar":["大势所趋"],"usage":"作谓语、定语；指必然的"},{"id":9165,"word":"势均力敌","pinyin":"shì jūn lì dí","abbr":"sjld","explanation":"均：平；敌：相当。双方力量相等，不分高低。","source":{"text":"力敌势均，终相吞咀。","book":"《南史·刘穆之传》"},"example":{"text":"这场比赛对阵的双方～，最终以平局收场。"},"similar":["不相上下","棋逢对手"],"opposite":["天差地别","寡不敌众"],"usage":"作谓语、定语；用于矛盾冲突的双方","story":["北宋时期，王安石推行新法，吕惠卿极力巴结他，帮助推行新法，参与有关重要的变革措施，受到王安石的器重。吕惠卿鼓动王安石倡导暴虐的政策。王安石被罢相时，吕惠卿与他势均力敌，就想方设法倾轧与陷害他"]},{"id":9166,"word":"势如冰炭","pinyin":"shì rú bīng tàn","abbr":"srbt","explanation":"就像冰块和炭火一样。形容两者不能相容。","source":{"text":"夫冰炭不同器而久，寒暑不兼时而至。杂反之学不两立而治。","book":"《韩非子·显学》"}},{"id":9167,"word":"势如劈竹","pinyin":"shì rú pī zhú","abbr":"srpz","explanation":"比喻节节胜利，毫无阻碍。见“势如破竹”。","source":{"text":"曹操将得胜之兵，杀入城中，势如劈竹。","book":"明·罗贯中《三国演义》第十二回"},"similar":["势如破竹","破竹之势"],"usage":"作谓语、定语、状语；指来势凶猛"},{"id":9168,"word":"势如彍弩","pinyin":"shì rú kuò nǔ","abbr":"srgn","explanation":"势：情势；彍：把弓拉满；弩：弩弓。情势如同拉满的弩弓一样。形容形势极其紧张。","source":{"text":"势如彍弩，节如发机。","book":"《孙子·兵势篇》"}},{"id":9169,"word":"势如水火","pinyin":"shì rú shuǐ huǒ","abbr":"srsh","explanation":"形容双方就像水火一样互相对立，不能相容。","source":{"text":"惟杨仪不假借延，延以为至忿，有如水火。","book":"《三国志·蜀志·魏延传》"}},{"id":9170,"word":"势如破竹","pinyin":"shì rú pò zhú","abbr":"srpz","explanation":"势：气势，威力。形势就象劈竹子，头上几节破开以后，下面各节顺着刀势就分开了。比喻节节胜利，毫无阻碍。","source":{"text":"今兵威已振，譬如破竹，数节之后，皆迎刃而解。","book":"《晋书·杜预传》"},"example":{"text":"关胜等众，乘势长驱，～，又克大谷县。","book":"明·施耐庵《水浒全传》第九十九回"},"similar":["势不可当","所向披靡","势如劈竹"],"opposite":["坚不可摧"],"usage":"作谓语、定语、状语；指来势凶猛","story":["西晋武帝司马炎时期，人称“杜武库”大将杜预支持司马炎统一中国，被晋武帝任命为“镇南大将军”统领大军进攻吴国，先后夺取吴国大部分土地，有人建议暂停进攻。他说：“今兵威已振，譬如破竹，数节之后，皆迎刃而解。”"]},{"id":9171,"word":"势如累卵","pinyin":"shì rú lěi luǎn","abbr":"srll","explanation":"势：情势；累卵：把蛋累起来。比喻形势非常危险，如同堆起来的蛋，随时都有塌下打碎的可能。","source":{"text":"其君之危，犹累卵也。","book":"《韩非子·十过》"},"example":{"text":"如今关外，松锦已失，～，比中原尤为可虑。","book":"姚雪垠《李自成》第三卷第四十六章"}},{"id":9172,"word":"势孤力薄","pinyin":"shì gū lì báo","abbr":"sglb","explanation":"势力孤单，力量薄弱。指人少马微，不足以抗拒困境。","example":{"text":"此刻他们的心忘掉了世界上的一切，也根本不存在～的顾虑。","book":"曲波《林海雪原》第三十三章"}},{"id":9173,"word":"势孤计穷","pinyin":"shì gū jì qióng","abbr":"sgjq","explanation":"孤：孤单；计：计谋；穷：尽。势力孤单，计谋用尽。","source":{"text":"此是势孤计穷，故尽带百姓逃窜去了。","book":"明·罗贯中《三国演义》第四十四回"}},{"id":9174,"word":"势成水火","pinyin":"shì chéng shuǐ huǒ","abbr":"scsh","explanation":"形容双方就像水火一样互相对立，不能相容。","source":{"text":"惟杨仪不假借延，延以为至忿，有如水火。","book":"《三国志·蜀志·魏延传》"},"example":{"text":"正大门派和本教积怨成仇，更是～。","book":"金庸《倚天屠龙记》第十九回"}},{"id":9175,"word":"势成骑虎","pinyin":"shì chéng qí hǔ","abbr":"scqh","explanation":"骑在老虎背上，要下来不能下来。比喻事情中途遇到困难，但迫于形势，想停止也停止不了。","source":{"text":"骑虎不敢下，攀龙忽堕天。","book":"唐·李白《留别广陵诸公》诗"},"example":{"text":"高阳《胡雪岩全传·灯火楼台》：“但这三家新式缫丝厂，～。”"},"similar":["骑虎难下"],"opposite":["得心应手","一帆风顺"],"usage":"作宾语、分句；指骑虎难下"},{"id":9176,"word":"势欲熏心","pinyin":"shì yù xūn xīn","abbr":"syxx","explanation":"势：权势；欲：欲望；熏：侵袭。贪财权势的欲望迷住了心窍。","source":{"text":"宝玉听到这里，觉得不甚入耳，因想黛玉从来不是这样人，怎么也这样势欲熏心起来？","book":"清·曹雪芹《红楼梦》第82回"},"similar":["权欲熏心"],"usage":"作谓语、定语；指人势力"},{"id":9177,"word":"势焰可畏","pinyin":"shì yàn kě wèi","abbr":"sykw","explanation":"势：权势；焰：气焰；畏：畏惧。权势和气焰很盛，让人望而生畏。形容权贵气焰嚣张，仗势作恶，使人畏惧。","source":{"text":"时，秦会之当国，数以言罪人，势焰可畏。","book":"宋·陆游《老学庵笔记》一"},"example":{"text":"士诒捻着几根胡髭微微笑道：“不是士诒夸口，士诒要举老沈，会员敢另举他人么？”～。","book":"蔡东藩、许廑父《民国通俗演义》四七回"}},{"id":9178,"word":"势焰熏天","pinyin":"shì yàn xūn tiān","abbr":"syxt","explanation":"形容势力大，气焰高，很可怕。","source":{"text":"只是人在势在，人亡势亡，当多尔衮在日，势焰熏天，免不得有饮恨的王大臣，此次正思乘间报复，适值顺治帝亲政，下诏求言。","book":"蔡东藩《清史演义》第十八回"},"example":{"text":"他虽然～，终归要失败"},"usage":"作谓语、定语；用于书面语"},{"id":9179,"word":"势物之徒","pinyin":"shì wù zhī tú","abbr":"swzt","explanation":"势物：权势和钱财。指追求名利的人。","source":{"text":"钱财不积则贪者忧，权势不尤则夸者悲，势物之徒乐变。","book":"《庄子·徐无鬼》"}},{"id":9180,"word":"势穷力尽","pinyin":"shì qióng lì jìn","abbr":"sqlj","explanation":"指已经没有什么势力与本事了。","source":{"text":"宋江道：‘这厮势穷力尽，有何良策可施？正好乘此机会。’","book":"明·施耐庵《水浒传》第86回"},"usage":"作谓语、定语；用于处境"},{"id":9181,"word":"势穷力屈","pinyin":"shì qióng lì qū","abbr":"sqlq","explanation":"形势窘迫，力量衰竭。","source":{"text":"俟其势穷力屈，然后可招抠也。","book":"宋·司马光《户部侍郎周公神道碑》"},"example":{"text":"至于～而后就缚者，盖可保其无谋矣。","book":"宋·陈亮《酌古论·李愬》"},"similar":["势穷力竭"],"opposite":["势如破竹"],"usage":"作谓语、宾语；指惨败后的处境"},{"id":9182,"word":"势穷力极","pinyin":"shì qióng lì jí","abbr":"sqlj","explanation":"大势已去，力量已用到极限。指惨败后的困难处境。","source":{"text":"前则项籍刘戊，后则光弼建封，战马成群，猛士成林，振臂长啸，风动云兴，朱阁青楼，舞女歌童，势穷力竭，化为虚空。","book":"宋·苏辙《黄楼赋》"},"example":{"text":"尚军大溃，退走五十里，～，只得遣豫州刺史阴夔至操营请降。","book":"明·罗贯中《三国演义》第三十二回"}},{"id":9183,"word":"势穷力竭","pinyin":"shì qióng lì jié","abbr":"sqlj","explanation":"大势已去，力量用尽。指惨败后的困难处境。","source":{"text":"凶乘祸鸠，势穷力竭，而投诸囚，以伏于幽。","book":"金·王若虚《复之纯交说》"},"example":{"text":"即使～，也该把身殉封疆。","book":"清·李渔《比目鱼·骇聚》"},"similar":["势穷力屈"],"opposite":["势如破竹"],"usage":"作谓语、宾语；指惨败后的处境"},{"id":9184,"word":"势穷力蹙","pinyin":"shì qióng lì cù","abbr":"sqlc","explanation":"形势窘迫，力量衰竭。同“势穷力屈”。","source":{"text":"招盗贼以官，出于不得已，今既两路有兵，势穷力蹙，不擒即降，似不须此。","book":"宋·李纲《与吕安老提刑书》"},"example":{"text":"部众离心，～，必致一败涂地而后已，此天将亡虏之征也。","book":"明·张居正《答甘肃巡抚侯》"},"similar":["势穷力屈"],"usage":"作谓语、定语、状语；用于书面语"},{"id":9185,"word":"势若脱兔","pinyin":"shì ruò tuō tù","abbr":"srtt","explanation":"势：攻势。脱：脱逃。对敌人攻击的速度极快，就像脱逃的兔子奔跑那样。","source":{"text":"攻如饿鸱叫，势若脱兔急。","book":"唐·陆龟蒙《杂讽》"},"similar":["动若脱兔"],"usage":"作定语；用于书面语"},{"id":9186,"word":"势钧力敌","pinyin":"shì jūn lì dí","abbr":"sjld","explanation":"双方力量相等，不分高低。同“势均力敌”。","source":{"text":"吕惠卿始谄事王安石，倡行虐政以害天下。及势钧力敌，则倾陷安石，甚于仇雠，世尤恶之。","book":"《宋史·苏辙传》"},"similar":["势均力敌"],"opposite":["天壤之别","天差地别"],"usage":"作谓语、定语；用于矛盾冲突的双方"},{"id":9187,"word":"势高益危","pinyin":"shì gāo yì wēi","abbr":"sgyw","explanation":"势：权势；益危：更加危险。指旧时官宦，权势越高，危险就越大。","source":{"text":"道高益安，势高益危，居赫赫之势，失身且有日矣。","book":"《史记·日者列传》"}},{"id":9188,"word":"勃然不悦","pinyin":"bó rán bù yuè","abbr":"brby","explanation":"勃然：突然地；悦：高兴。形容人突然不高兴的样子。","source":{"text":"慎子勃然不悦曰：‘必则滑厘所不识也。’","book":"战国·邹·孟轲《孟子·告子下》"},"example":{"text":"他～，让我们感到莫明其妙。"},"similar":["勃然大怒"],"usage":"作谓语；用于人突然生气变脸色"},{"id":9189,"word":"勃然作色","pinyin":"bó rán zuò sè","abbr":"brzs","explanation":"作色：变脸色。因恼怒或惊怕而变脸色。","source":{"text":"谓己道人，则勃然作色。","book":"战国·宋·庄周《庄子·天地》"},"example":{"text":"其人～曰：‘天下生仲尼，万古如长夜。’","book":"明·李贽《赞刘谐》"},"similar":["忿然作色"],"usage":"作谓语；指突然变脸"},{"id":9190,"word":"勃然变色","pinyin":"bó rán biàn sè","abbr":"brbs","explanation":"勃然：突然地。变色：变了脸色。突然生气，变了脸色。","source":{"text":"（孟子）曰：‘君有大过谏；反复之而不听，则易位。’王勃然变乎色。","book":"《孟子·万章下》"},"example":{"text":"重耳～，搁杯不饮。","book":"明·冯梦龙《东周列国志》第三十四回"},"similar":["勃然大怒"],"opposite":["转嗔为喜"],"usage":"作谓语、状语；指发怒"},{"id":9191,"word":"勃然大怒","pinyin":"bó rán dà nù","abbr":"brdn","explanation":"勃然：突然。突然变脸大发脾气。","source":{"text":"是故皇天勃然发怒，甲乙之间，暴风三溱拔树折木。","book":"汉·班固《汉书·谷永传》"},"example":{"text":"周瑜听罢，～。","book":"明·罗贯中《三国演义》第四十四回"},"similar":["雷霆大发","暴跳如雷","怒发冲冠"],"opposite":["和颜悦色"],"usage":"作谓语；用于人突然生气变脸色"},{"id":9192,"word":"勃然奋励","pinyin":"bó rán fèn lì","abbr":"brfl","explanation":"勃然：奋发的样子；奋：奋发；励：激励。奋发起来，激励自己。","source":{"text":"勃然奋励，不可恐慑也。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作谓语、定语；指人上进"},{"id":9193,"word":"勃谿相向","pinyin":"bó xī xiāng xiàng","abbr":"bxxx","explanation":"bó  xī  xiāng  xiàng","source":{"text":"室无空虚，则妇姑勃谿。","book":"《庄子·外物》"}},{"id":9194,"word":"勇于私斗，怯于公愤","pinyin":"yǒng yú sī dòu，qiè yú gōng fèn","abbr":"yysdqygf","explanation":"私：私利；怯：畏缩。为了争取个人私利很勇敢，为了大家的利益在行动上则畏缩不前。"},{"id":9195,"word":"勇于自责","pinyin":"yǒng yú zì zé","abbr":"yyzz","explanation":"敢于承认错误并自我批评。","example":{"text":"男子汉要知错就该，～。"},"usage":"作谓语；指敢于承认错误","story":["春秋时期，秦国人札子在郑国掌握了都城北门的钥匙，派人要秦穆公攻打郑国。秦穆公不听蹇叔的劝告，派大将孟明视等率军出征。郑国商人弦高发现，假装送礼迎接秦军，背后通风报信。晋国乘机出兵打败秦军。秦穆公承认是他的罪过"]},{"id":9196,"word":"勇冠三军","pinyin":"yǒng guàn sān jūn","abbr":"ygsj","explanation":"冠：位居第一；三军：军队的统称。指勇敢或勇猛是全军第一。","source":{"text":"陵先将军功略盖天地，义勇冠三军。","book":"汉·李陵《答苏武书》"},"example":{"text":"延伯单马入阵，旁若无人，～。","book":"北魏·杨炫之《洛阳伽兰记·法云寺》"},"similar":["勇者无惧"],"opposite":["畏敌如虎"],"usage":"作补语、宾语；形容人的英勇"},{"id":9197,"word":"勇动多怨","pinyin":"yǒng dòng duō yuàn","abbr":"yddy","explanation":"勇动：鲁莽妄动。鲁莽妄动必招致很多怨恨。","source":{"text":"智慧外通，勇动多怨，仁义多贵。","book":"战国·宋·庄周《庄子·列御寇》"},"usage":"作谓语、宾语；用于劝诫人"},{"id":9198,"word":"勇夫悍卒","pinyin":"yǒng fū hàn zú","abbr":"yfhz","explanation":"勇猛凶悍的武士与兵卒。","source":{"text":"五代之君，皆武人崛起，其所与俱夫悍卒，各裂土地封侯王，何异豺狼之牧斯人也。","book":"《新五代史·周书·王进传》"},"usage":"作宾语、定语；用于书面语"},{"id":9199,"word":"勇往直前","pinyin":"yǒng wǎng zhí qián","abbr":"ywzq","explanation":"勇敢地一直向前进。","source":{"text":"不顾旁人是非，不计自己得失，勇往直前，说出人不敢说的道理。","book":"宋·朱熹《朱子全书·道统一·周子书》"},"example":{"text":"人人惧摩拳擦掌，个个～。","book":"明·许仲琳《封神演义》第七十三回"},"similar":["一往无前","奋勇向前","昂首阔步"],"opposite":["畏缩不前","畏首畏尾","趑趄不前"],"usage":"作谓语、定语、状语；用于人的勇敢"},{"id":9200,"word":"勇猛果敢","pinyin":"yǒng měng guǒ gǎn","abbr":"ymgg","explanation":"形容处事勇敢决断。","source":{"text":"勇猛果敢，处事不疑。","book":"《汉书·翟方进传》"},"usage":"作谓语、定语；指人的处世方式"},{"id":9201,"word":"勇猛直前","pinyin":"yǒng měng zhí qián","abbr":"ymzq","explanation":"勇敢地一直向前进。","source":{"text":"若勇猛直前，便以头目脑髓布施，亦无不可也。","book":"宋·朱熹《答刘智夫书》"},"example":{"text":"朱自清《论气节》：“知识阶级开头凭着集团的力量～，打倒种种传统，那时候是敢作敢为一股气。”"},"similar":["勇往直前"],"usage":"作谓语、定语、状语；用于处事"},{"id":9202,"word":"勇猛精进","pinyin":"yǒng měng jīng jìn","abbr":"ymjj","explanation":"原意是勤奋修行。现指勇敢有力地向前进。","source":{"text":"勇猛精进，志愿无倦。","book":"《无量寿经》卷上"},"example":{"text":"是僧闻言，即对佛发愿，～，自是宴然无梦矣。","book":"清·纪昀《阅微草堂笔记》卷四"},"usage":"作谓语、定语；指人的学习"},{"id":9203,"word":"勇男蠢妇","pinyin":"yǒng nán chǔn fù","abbr":"yncf","explanation":"粗野无知，笨手笨脚的男女。","source":{"text":"宝玉素昔最厌勇男蠢妇的，今日却如何又命这两个婆子进来?其中原来有个原故。","book":"清·曹雪芹《红楼梦》第三十五回"},"usage":"作宾语、定语；用于书面语"},{"id":9204,"word":"勇者不惧","pinyin":"yǒng zhě bù jù","abbr":"yzbj","explanation":"惧：害怕。有胆量的人无所畏惧。","source":{"text":"子曰：‘知者不惑，仁者不忧，勇者不惧。’","book":"《论语·子罕》"},"usage":"作宾语、定语；指有胆识","story":["春秋时期，孔子带领弟子们周游列国，在陈国闲居无事，与弟子讨论修身之事。孔子认为做“士”要做到“仁者不忧、知者不惑、勇者不惧”三好，士分三类：“不辱君命，为国效力；孝悌兼备，乡邻模范；言信行果，千金一诺。”"]},{"id":9205,"word":"勇而无谋","pinyin":"yǒng ér wú móu","abbr":"yewm","explanation":"谋：计谋。虽然勇敢，但没有智谋。","source":{"text":"（王）武俊蕃种，有勇无谋。","book":"唐·陆贽《论两河及淮西利害状》"},"example":{"text":"吕布，豺狼也，～，轻于去就，宜早图之。","book":"明·罗贯中《三国演义》第十六回"},"similar":["愣头愣脑","有勇无谋"],"opposite":["有勇有谋"],"usage":"作谓语、定语；指人缺乏头脑"},{"id":9206,"word":"勇贯三军","pinyin":"yǒng guàn sān jūn","abbr":"ygsj","explanation":"贯：通“冠”，第一；三军：军队的总称。指勇敢或勇猛是全军第一。","source":{"text":"吾想黑身有异术，勇贯三军，吾非敌手。","book":"明·许仲琳《封神演义》第三回"},"similar":["勇冠三军","气冠三军"],"usage":"作谓语、宾语；形容人的英勇"},{"id":9207,"word":"勇退急流","pinyin":"yǒng tuì jí liú","abbr":"ytjl","explanation":"勇：果敢；退：退却，离去。比喻在官场得意时及时隐退，以明哲保身","source":{"text":"勇退急流，虽具衲子参寻之眼；旁观袖手，要非邦人向慕之诚。","book":"宋·陆游《福州请仁王坚老疏》"},"similar":["急流勇退"],"usage":"作谓语、宾语；指及时引退"},{"id":9208,"word":"勇退激流","pinyin":"yǒng tuì jí liú","abbr":"ytjl","explanation":"在急流中勇敢地立即退却。比喻在得意顺遂时，见机引退，以求明哲保身。","source":{"text":"火色上腾虽有数，急流勇退岂无人。","book":"宋·苏轼《赠善相程杰》诗"},"example":{"text":"她在当红之际～，离开影坛，令影迷怀念不已。"}},{"id":9209,"word":"勉为其难","pinyin":"miǎn wéi qí nán","abbr":"mwqn","explanation":"勉：勉强；为：做。勉强去做能力所不及或不愿去做的事。","source":{"text":"处贫难，处富易，人之常情，然人当勉为其难，而不可忽其易。","book":"《论语·宪问》宋·朱熹注"},"example":{"text":"可是，情况尚不分明，我怎样迎敌？好吧，～吧。","book":"梁信《从奴隶到将军》下集第四章"},"opposite":["游刃有余"],"usage":"作谓语、定语、状语；常作自谦词"},{"id":9210,"word":"勉勉强强","pinyin":"miǎn miǎn qiǎng qiǎng","abbr":"mmqq","explanation":"刚好能凑合着。","source":{"text":"胡镜孙说有公事面回，然后勉勉强强见的。","book":"清·李宝嘉《官场现形记》第21回"},"example":{"text":"那余大人出其不意，只得～答道：‘读过。’","book":"曾朴《孽海花》第21回"},"usage":"作谓语、定语、状语；多用于口语"},{"id":9211,"word":"勒索敲诈","pinyin":"lè suǒ qiāo zhà","abbr":"lsqz","explanation":"勒索：强行索取财物。利用别人的把柄或自己的权势，以威胁强迫手段向人索取财物。","source":{"text":"当时捐税重重，而且还派了许多宦官为专使到全国各地去开矿，勒索敲诈，胡作非为。","book":"徐朔方《校注·前言》"},"similar":["敲诈勒索"],"usage":"作谓语、宾语、定语；指强行敲诈"},{"id":9212,"word":"勒马悬崖","pinyin":"lè mǎ xuán yá","abbr":"lmxy","explanation":"勒：收住缰绳；悬崖：高悬的山崖。在高高的山崖边上勒住马。比喻到了危险的边缘及时清醒回头。","source":{"text":"幸道力原深，故忽迷忽悟，能勒马悬崖耳。","book":"清·纪昀《阅微草堂笔记·姑妄听之二》"},"similar":["悬崖勒马","临崖勒马"],"usage":"作谓语、定语、分句；用于劝诫人"},{"id":9213,"word":"勖以大义","pinyin":"xù yǐ dà yì","abbr":"xydy","explanation":"勖：勉励。指以大义相勉励。","source":{"text":"予乃招集当地华侨同志会议，勖以大义，一夕之间，则醵资八千有奇。","book":"孙中山《心理建设》第八章"},"usage":"作谓语、定语；用于书面语"},{"id":9214,"word":"勖勉有加","pinyin":"xù miǎn yǒu jiā","abbr":"xmyj","explanation":"勖勉：勉励。指一再加以勉励。","example":{"text":"他对我～。"},"usage":"作谓语；指勉励"},{"id":9215,"word":"勤以立身","pinyin":"qín yǐ lì shēn","abbr":"qyls","explanation":"勤俭才能生存下去。","example":{"text":"我们要学习宋濂～的精神。"},"usage":"作宾语、定语；指勤俭才能生存下去","story":["明朝时期，宋濂小时候因为家贫无法买书，只有向有藏书的人家借抄，不管天寒地冻，他都要坚持抄书好按时还给别人，还经常到百里之外向人求教。读书十分勤奋，生活十分节俭，学业进步很快。后来官至学士主修《元史》始终如此勤俭"]},{"id":9216,"word":"勤俭持家","pinyin":"qín jiǎn chí jiā","abbr":"qjcj","explanation":"以勤劳节约的精神操持家务。","source":{"text":"钱不够花，也不想勤俭持家，却仍然置身在亲戚中间充硬汉。","book":"巴金《谈》"},"example":{"text":"～是中华民族的美德。"},"opposite":["奢侈浪费"],"usage":"作主语、谓语、宾语；用于生活"},{"id":9217,"word":"勤俭节约","pinyin":"qín jiǎn jié yuē","abbr":"qjjy","explanation":"勤劳而节俭。形容工作勤劳，生活节俭。","source":{"text":"因而形成了既敢山吃海喝，又能勤俭节约的双重生活方式。","book":"路遥《平凡的世界》第五卷第一章"},"example":{"text":"章诒和《往事并不如烟·正在有情无思间》：“那年月提倡的是艰苦朴素、～。”"},"usage":"作谓语、定语、状语；用于生活"},{"id":9218,"word":"勤兵黩武","pinyin":"qín bīng dú wǔ","abbr":"qbdw","explanation":"黩：轻率。滥用武力，肆意发动战争。形容极端好战。","source":{"text":"他终于采纳范文程和汤若望的政见，放弃了徒恃军威的‘勤兵黩武’，采取了招降弭乱的‘文德绥怀’。","book":"凌力《少年天子》第一章"},"similar":["穷兵黩武"],"usage":"作谓语、宾语、定语；指好战"},{"id":9219,"word":"勤则不匮","pinyin":"qín zé bù kuì","abbr":"qzbk","explanation":"匮：不足。只要勤劳就不会缺少物资。","source":{"text":"民生在勤，勤则不匮。","book":"《左传·宣公十二年》"},"example":{"text":"到底自己的“为政在勤、～”的训旨见了成效。关于“勤”字之义，看来朕不仅讲透了，而且大臣也能遵守。","book":"刘德贵《嘉庆皇帝》一"},"usage":"作宾语、定语；用于劝诫人"},{"id":9220,"word":"勤劳勇敢","pinyin":"qín láo yǒng gǎn","abbr":"qlyg","explanation":"勤奋劳动，有勇气，有胆量。","source":{"text":"我们的人民勤劳勇敢，坚韧不拔，有智慧，有理想，热爱祖国，热爱社会主义。","book":"邓小平《在中国文学艺术工作者第四次代表大会上的祝词》"},"usage":"作谓语、定语；用于人"},{"id":9221,"word":"勤勤恳恳","pinyin":"qín qín kěn kěn","abbr":"qqkk","explanation":"形容勤劳踏实。也形容勤恳的样子。","source":{"text":"曩者辱赐书，教以顺于接物，推贤进士为务，意气勤勤恳恳。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"邓小平《克服目前西南党内的不良倾向》：“遇事共同商议，共同决定，工作～，结果事情办得很好，也得到人家的尊重。”"},"similar":["认认真真"],"usage":"作谓语、状语；指做事认真"},{"id":9222,"word":"勤学好问","pinyin":"qín xué hǎo wèn","abbr":"qxhw","explanation":"勤奋学习，不懂的就问。比喻善于学习。","source":{"text":"它而今是勤学好问，便谥之以文。","book":"宋·朱熹《朱子语类·论语》"},"example":{"text":"他习惯～，进步很快。"},"usage":"作谓语、宾语；指虚心好学"},{"id":9223,"word":"勤学苦练","pinyin":"qín xué kǔ zh","abbr":"qxkl","explanation":"认真学习，刻苦训练。","source":{"text":"他的儿子听后，再不敢妄图侥幸走上捷径，经过真正的勤学苦练，终于也成为书法家。","book":"秦牧《秘诀》"},"example":{"text":"他经过～，终于成为书法家。"},"usage":"作谓语、宾语；指认真学习"},{"id":9224,"word":"勤工俭学","pinyin":"qín gōng jiǎn xué","abbr":"qgjx","explanation":"利用学习以外的时间参加劳动，而以劳动所得维持生活。泛指在学习期间参加劳动。","source":{"text":"我这时一面在交涉条约的事情，一面又进行第二个任务，就是办留法勤工俭学。","book":"吴玉章《回忆“五四”前后我的思想转变》"},"example":{"text":"她每年都要靠～来交学费。"},"similar":["半工半读"],"usage":"作谓语、宾语、定语；指求学期间劳动"},{"id":9225,"word":"勤慎肃恭","pinyin":"qín shèn sù gōng","abbr":"qssg","explanation":"肃：严肃；恭：谦逊。勤劳、谨慎、恭敬、谦虚。指做人的美德。","source":{"text":"贵妃切勿以政夫妇残年为念，更祈自加珍爱，惟勤慎肃恭以侍上，庶不负上眷顾隆恩也。","book":"清·曹雪芹《红楼梦》第18回"},"usage":"作宾语、定语；指人的美德"},{"id":9226,"word":"勤王之师","pinyin":"qín wáng zhī shī","abbr":"qwzs","explanation":"勤王：起兵救援君王；师：军队。古时君主受到内乱外患的威胁，其臣子前来救援的军队。","source":{"text":"求诸侯，莫如勤王。","book":"《左传·僖公二十五年》"},"example":{"text":"热河～三十万，旦夕可至。众位放心去做！","book":"二月河《康熙大帝》四十七"}},{"id":9227,"word":"勤能补拙","pinyin":"qín néng bǔ zhuō","abbr":"qnbz","explanation":"勤奋能够弥补不足。","source":{"text":"弄假像真终是假，将勤补拙总输勤。","book":"宋·邵雍《弄笔吟》"},"example":{"text":"～，熟能生巧。","book":"理由《高山与平原》"},"similar":["功在不舍","勤学苦练"],"opposite":["锲而舍之"],"usage":"作宾语；用于劝诫人","story":["公元825年，唐敬宗将杭州刺史白居易调任苏州刺史，苏州是唐东南地区最大的州，地方事务繁杂。白居易上任谢绝所有的宴请，一心处理政务，很快就熟悉当地的情况，整顿吏治，赢得老百姓的好评。他认为自己生来笨拙只有靠勤奋来弥补"]},{"id":9228,"word":"勺水一脔","pinyin":"sháo shuǐ yī luán","abbr":"ssyl","explanation":"一勺水，一块肉。比喻量少。","source":{"text":"又以书院田四十有一亩有奇，籍入盗田五十亩有奇，为膏火资，由县发敛。勺水一脔不足言，冀后之人增其式廓。","book":"清·冯桂芬《重建吴江松陵书院记》"},"usage":"作主语、宾语、定语；指数量少"},{"id":9229,"word":"勾元提要","pinyin":"gōu yuán tí yào","abbr":"gyty","explanation":"提：摘出，提出；提要：摘出纲要。探取精微，摘抉要义。","source":{"text":"故撰录事迹，诠次法程，钩元提要，庶有取尔。","book":"章炳麟《缘起·例言》"},"example":{"text":"讲经学问题的几篇，勾元提要，内容坚实。","book":"刘大年《序》"},"similar":["钩玄提要","钩元提要"],"usage":"作谓语；指探取精微，摘出纲要"},{"id":9230,"word":"勾勾搭搭","pinyin":"gōu gōu dā dā","abbr":"ggdd","explanation":"引诱或串通做不正经的事。","source":{"text":"不积极地反汪反汉奸，有时还向日本的和平使者勾勾搭搭。","book":"毛泽东《关于打退第二次反共高潮的总结》"},"example":{"text":"你少与她～的。"},"similar":["狼狈为奸"],"opposite":["泾渭分明"],"usage":"作谓语、宾语；指相互串通干坏事"},{"id":9231,"word":"勾心斗角","pinyin":"gōu xīn dòu jiǎo","abbr":"gxdj","explanation":"原指宫室建筑结构的交错和精巧。后比喻用尽心机，明争暗斗。","source":{"text":"各报地势，钩心斗角。","book":"唐·杜牧《阿房宫赋》"},"example":{"text":"在这件事上，他们最是赤祼祼地毫无～的意思。","book":"茅盾《虹》九"},"similar":["明争暗斗","钩心斗角"],"opposite":["开诚相见","肝胆相照"],"usage":"作谓语、定语；指明争暗斗","story":["唐朝诗人杜牧有感于晚唐帝王的大兴土木、骄奢淫逸，十分感慨，就写一篇《阿房宫赋》来讽喻当时的统治者，文章描写阿房宫的雄伟壮丽，原文如下：“五步一楼，十步一阁。廊腰缦回，檐牙高啄。各抱地势，钩心斗角。”"]},{"id":9232,"word":"勾爪居牙","pinyin":"gōu zhǎo jū yá","abbr":"gzjy","explanation":"勾：同“钩”，悬挂器物的用具；居：同“锯”，切割材料的刀具。钩子般的爪牙，锯子般的牙齿。形容爪牙的锐利。","source":{"text":"凤凰不下勾爪、居牙、戴角、出距之兽于是鸷矣。","book":"西汉·刘安《淮南子·本经训》"},"usage":"作比喻、定语；用于比喻句"},{"id":9233,"word":"勾肩搭背","pinyin":"gōu jiān dā bèi","abbr":"gjdb","explanation":"搭背：搭腰。指相互亲密拥抱或并行。","source":{"text":"于是两人勾肩搭背，同至祥春里张蕙贞家，向老娘姨说了，叫他传话上去。","book":"清·韩邦庆《海上花列传》第五回"},"example":{"text":"可眼睛又不由挨个观察那些～、没完没了亲嘴的男男女女；直看得他浑身筛糠般发抖，直巴咂嘴。","book":"路遥《平凡的世界》第六卷第48章"},"usage":"作谓语、定语、状语；用于口语"},{"id":9234,"word":"勾魂摄魄","pinyin":"gōu hún shè pò","abbr":"ghsp","explanation":"勾取灵魂，形容事物有极大的吸引力。","source":{"text":"那仆人一听，乡音入耳，已是关心；更兼那燕语莺声，勾魂摄魄，要走哪里走得过去？","book":"清·彭养鸥《黑籍冤魂》第15回"},"example":{"text":"鲁迅《后记》：“因为他帮同～，大家就称之为‘无常’；又以其本是生魂也，则别之曰‘阳’，但从此便和‘活无常’隐然相混了。”"},"opposite":["平淡无奇"],"usage":"作谓语；比喻事物极具吸引力"},{"id":9235,"word":"勿为左右袒","pinyin":"wù wèi zuǒ yòu tǎn","abbr":"wwzyt","explanation":"左右袒：原意是露出左臂或右臂，偏护某一方面。指对哪一方面都不偏袒。","source":{"text":"《史记·吕后本纪》"}},{"id":9236,"word":"勿以恶小而为之，勿以善小而不为","pinyin":"wù yǐ è xiǎo ér wéi zhī,wù yǐ shàn xiǎo ér bù wéi","abbr":"wyexewzwysxebw","explanation":"勿：不要；为：做。不要以为是微小的坏事就可以做，不要以为是不大的好事就不去做。","source":{"text":"勿以恶小而为之，勿以善小而不为。惟贤惟德，能服于人。","book":"《诸葛亮集》"},"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":9237,"word":"勿剪之惠","pinyin":"wù jiǎn zhī huì","abbr":"wjzh","explanation":"惠：恩惠。比喻使人难忘的恩惠。","source":{"text":"体公刘之德，行勿剪之惠。","book":"《三国志·志·彭羕传》"}},{"id":9238,"word":"勿剪之欢","pinyin":"wù jiǎn zhī huān","abbr":"wjzh","explanation":"本指周朝人民思慕如公奭的德行，互相勉励，不要剪伐召公曾在下面休憩过的甘棠树。后用来比喻不遗弃友人的遗物。","source":{"text":"分陕流勿剪之欢，来仕允克施之誉。","book":"汉·王融《三月三日曲水诗序》"}},{"id":9239,"word":"勿忘在莒","pinyin":"wù wàng zài jǔ","abbr":"wwzj","explanation":"比喻不忘本。","source":{"text":"使公毋忘出奔于莒也。","book":"《吕氏春秋·直谏》"},"usage":"作谓语；比喻不忘本","story":["春秋时期，齐桓公小白曾经因为内乱逃到莒国避难，后来在鲍叔牙的帮助下，终于回到齐国执政，任命管仲为相国辅佐国政。一次他有些得意忘形，大夫鲍叔牙在旁提醒他：“使公毋忘出奔于莒也。”齐桓公立即意识到自己的错误"]},{"id":9240,"word":"勿念旧恶","pinyin":"wù niàn jiù è","abbr":"wnje","explanation":"勿：不要；念：记着。指不要总是对别人原来的不好之处念念不忘。","source":{"text":"伯夷、叔齐不念旧恶，怨是用希。","book":"《论语·公冶长》"},"example":{"text":"只有明明暗暗，吸血吃肉的凶手或其帮闲们，这才赠人以“犯而勿校”或“～”的格言。","book":"鲁迅《且介亭杂文附集·女吊》"}},{"id":9241,"word":"勿怠勿忘","pinyin":"wù dài wù wàng","abbr":"wdww","explanation":"勿：不要；怠：懈怠；忘：忘记。告诫不要懈怠，不要忘记。","source":{"text":"卿与丞相从事，事之如父，勿待勿忘！","book":"明·罗贯中《三国演义》第八十五回"}},{"id":9242,"word":"勿药有喜","pinyin":"wù yào yǒu xǐ","abbr":"wyyx","explanation":"用以祝贺人病愈，恢复健康的话","source":{"text":"无妄之灾，勿药有喜。","book":"《周易·无妄》"},"usage":"作谓语；用于书面语"},{"id":9243,"word":"勿谓言之不预","pinyin":"wù wèi yán zhī bù yù","abbr":"wwyzby","explanation":"不要说事先没有说过，表示事前已讲明白。","source":{"text":"一经觉察，白简无情，勿谓言之不预也。","book":"清·李宝嘉《官场现形记》第19回"},"example":{"text":"必以纵匪论处，决不姑宽，～。","book":"毛泽东《中共发言人关于国民党政府逮捕冈村宁次和内战罪犯的谈话》"},"similar":["勿谓言之不预也"],"usage":"作谓语；指提前警示"},{"id":9244,"word":"勿谓言之不预也","pinyin":"wù wèi yán zhī bù yù yě","abbr":"wwyzbyy","explanation":"勿谓：不要说；预：预先。以后不要说没有跟你事先说过。指把话说在前面。","source":{"text":"凡所属官吏，有仍蹈故辙，以及有意逢迎，希图尝试者，一经察觉，白简无情，勿谓言之不预也。","book":"清·李宝嘉《官场现形记》第十九回"},"example":{"text":"倘有不法之徒，胆敢阴谋捣乱，本府本处言出法随，勿谓言之不预。（毛泽东《陕甘宁边区政府第八路军后方留守处布告》）"},"similar":["勿谓言之不预"],"usage":"作谓语；指提前警示"},{"id":9245,"word":"匀红点翠","pinyin":"yún hóng diǎn cuì","abbr":"yhdc","explanation":"指涂脂画眉。","source":{"text":"匀红点翠。取次梳妆谁得似。风柳腰枝。尽日纤柔属阿谁。","book":"宋·陈师道《减字木兰花》词"},"usage":"作谓语、宾语；指涂脂画眉"},{"id":9246,"word":"匀脂抹粉","pinyin":"yún zhī mǒ fěn","abbr":"yzmf","explanation":"指妇女用脂粉装饰打扮。","source":{"text":"每到春三二月天气，那些姊妹们都匀脂抹粉，站在前门花柳之下，彼此邀伴顽耍。","book":"清·吴敬梓《儒林外史》第五十三回"},"similar":["涂脂抹粉"],"usage":"作谓语、定语；用于书面语"},{"id":9247,"word":"包举宇内","pinyin":"bāo jǔ yǔ nèi","abbr":"bjyn","explanation":"包举：统括；宇内：天地之间，即天下。并吞天下，占有一切。","source":{"text":"有席卷天下，包举宇内，囊括四海之意。","book":"汉·贾谊《过秦论》"},"usage":"作谓语、定语；用于政治等"},{"id":9248,"word":"包元履德","pinyin":"bāo yuán lǚ dé","abbr":"byld","explanation":"元：善。指心怀善意，行为具有高尚的品德。是古代对帝王的谀词。","source":{"text":"陛下包元履德，权时拨乱。功踰文武，德侔高皇。","book":"《后汉书·梁统传》"}},{"id":9249,"word":"包办代替","pinyin":"bāo bàn dài tì","abbr":"bbdt","explanation":"指应该和有关的人一起商量或一起做的事，却独自办理，不让旁人参与。","source":{"text":"媒婆真是包办代替的老祖宗，可真是把人坑害死了。","book":"周立波《暴风骤雨》第二部二三"},"example":{"text":"我们工作同志作好参谋，不要指手划脚，～。","book":"陈残云《山谷风烟》第三四章"},"similar":["越俎代庖"],"opposite":["包而不办"],"usage":"作谓语、宾语、定语；形容所有工作独揽"},{"id":9250,"word":"包打天下","pinyin":"bāo dǎ tiān xià","abbr":"bdtx","explanation":"包：承担全部任务，负责完成。将打天下的整个任务承担下来。常指人逞强争胜。","source":{"text":"这类机构并不影响各个公司、企业实施光彩事业项目，更不能包打天下。","book":"《求是》1996年第17期"},"example":{"text":"她喜欢个人～。"},"similar":["包揽一切"],"opposite":["漠不关心"],"usage":"作谓语、定语；指独揽一切重任"},{"id":9251,"word":"包揽词讼","pinyin":"bāo lǎn cí sòng","abbr":"blcs","explanation":"指招揽承办别人的诉讼，从中谋利。","source":{"text":"那参的京官就是大老爷，说的是包揽词讼，所以火上浇油。","book":"《红楼梦》第一○五回"},"example":{"text":"钱文贵在村子上～，出出歪主意，一定是可能的。","book":"丁玲《太阳照在桑干河上》三五"},"usage":"作谓语、宾语；指招揽官司"},{"id":9252,"word":"包罗万有","pinyin":"bāo luó wàn yǒu","abbr":"blwy","explanation":"犹包罗万象。","source":{"text":"他所关心的事，真是包罗万有。","book":"郭沫若《浪漫主义和现实主义》"},"similar":["包罗万象"],"opposite":["一无所有"],"usage":"作谓语、定语；形容内容丰富"},{"id":9253,"word":"包罗万象","pinyin":"bāo luó wàn xiàng","abbr":"blwx","explanation":"包罗：包括；万象：宇宙间的一切景象，指各种事物。形容内容丰富，应有尽有。","source":{"text":"所以包罗万象，举一千从，运变无形而能化物，大矣哉，阴阳之理也。","book":"《黄帝宅经》卷上"},"example":{"text":"你怎言～，迟早飞升。","book":"明·许仲琳《封神演义》第十三回"},"similar":["应有尽有","无所不包"],"opposite":["一无所有","空空如也","挂一漏万"],"usage":"作谓语、定语；形容内容丰富，无所不有"},{"id":9254,"word":"包羞忍耻","pinyin":"bāo xiū rěn chǐ","abbr":"bxrc","explanation":"包：包容，藏；忍：容忍，忍耐。容忍羞愧与耻辱。","source":{"text":"胜败兵家事不期，包羞忍耻是男儿。","book":"唐·杜牧《题乌江亭》"},"example":{"text":"女子能留身后名，～漫公卿。","book":"宋·吴曾《贤女浦》"},"similar":["包羞忍辱"],"usage":"作主语、谓语、宾语；指人气量大"},{"id":9255,"word":"包羞忍辱","pinyin":"bāo xiū rěn rǔ","abbr":"bxrr","explanation":"包：包容。形容人有忍辱含垢的大气量。","source":{"text":"在家做小伏低，好似哑子吃了黄连在心里苦，到人前包羞忍辱。","book":"明·王廷讷《狮吼记》"},"similar":["包羞忍耻"],"usage":"作定语、宾语；指人的气量大"},{"id":9256,"word":"包而不办","pinyin":"bāo ér bù bàn","abbr":"bebb","explanation":"包：包揽。把事情包揽下来却不办理。","source":{"text":"一种是国民党的包而不办的办法，一种是共产党的发动群众奋起抗战的路线。","book":"杨植霖《若飞同志在绥远狱中》"},"example":{"text":"我不喜欢那些爱吹牛、～不干实事的人。"},"opposite":["包办代替"],"usage":"作谓语、定语；指人不讲信誉"},{"id":9257,"word":"包胥之哭","pinyin":"bāo xū zhī kū","abbr":"bxzk","explanation":"包胥：春秋时楚国大臣申包胥。比喻到别国哀求援兵。","source":{"text":"立依于庭墙而哭，日夜不绝声，勺饮不入口。","book":"春秋·鲁·左丘明《左传·定公四年》"},"example":{"text":"平西王吴三桂，介在东陲，独效～。","book":"《清史稿·睿忠亲王多尔衮传》"},"similar":["秦庭之哭"],"usage":"作宾语、定语；指求外援","story":["春秋时期，诸侯混战，吴国进攻楚国，楚国大败。楚国大臣申包胥前往秦国求救，秦哀公举棋不定，迟迟不发兵救楚。申包胥“立依于庭墙而哭，日夜不绝声，勺饮不入口。”哭了七天七夜，秦哀公深受感动，就答应出兵救援楚国"]},{"id":9258,"word":"包荒匿瑕","pinyin":"bāo huāng nì xiá","abbr":"bhnx","explanation":"包荒：本指度量宽洪，能容忍。包含污秽，藏匿缺点。","source":{"text":"包荒匿瑕，蓄此烦丑。","book":"唐·李白《雪谗诗赠友人》"}},{"id":9259,"word":"包藏奸心","pinyin":"bāo cáng jiān xīn","abbr":"bcjx","explanation":"犹言包藏祸心。","source":{"text":"刘表自以为宗室外，包藏奸心，乍前乍却，以观世事。","book":"三国·魏·曹操《让县自明本志令》"},"similar":["包藏祸心"],"opposite":["胸怀坦荡"],"usage":"作谓语、宾语；形容外表不露声色暗中害人"},{"id":9260,"word":"包藏祸心","pinyin":"bāo cáng huò xīn","abbr":"bchx","explanation":"包藏：隐藏，包含；祸心：害人之心。心里怀着害人的恶意。","source":{"text":"小国无罪，恃实其罪；将恃大国之安靖已，而无乃包藏祸心以图之。","book":"《左传·昭公元年》"},"example":{"text":"初与我为客侣，不意～，隐我血赀，悍不还，今愿得而甘心，何父之有？","book":"清·蒲松龄《聊斋志异·柳氏子》"},"similar":["佛口蛇心","居心叵测"],"opposite":["菩萨心肠","胸怀坦荡"],"usage":"作谓语、宾语；形容外表不露声色暗中害人","story":["春秋时期郑国王穆公的孙子公孙段想把女儿嫁给楚国高官公子围，以达到联盟的目的。在迎亲的时候，公子围带很多人马到郑国都城外，让郑国大夫子产识破其中的诡计，用计迫使公子围单独进都城迎娶，让郑国避免亡国"]},{"id":9261,"word":"匆匆忙忙","pinyin":"cōng cōng máng máng","abbr":"ccmm","explanation":"指做事匆促忙碌。","source":{"text":"仿佛看见那写真师的面貌和先生一样，匆匆忙忙，不敢认真，到底是先生不是？","book":"曾朴《孽海花》第13回"},"example":{"text":"这一天下午，田晓霞突然～到宿舍来找他，让他跟她到外面走一趟。","book":"路遥《平凡的世界》第二卷第37章"},"similar":["急急忙忙","仓仓促促"],"opposite":["从从容容"],"usage":"作定语、状语；用于处事"},{"id":9262,"word":"匍匐之救","pinyin":"pú fú zhī jiù","abbr":"pfzj","explanation":"蹑手蹑脚地走动或慢慢地走动。","source":{"text":"凡民有丧，匍匐救之。","book":"《诗经·邶风·谷风》"},"example":{"text":"这段路十分难走，我们只好～。"},"usage":"作谓语；指慢慢地走动"},{"id":9263,"word":"匏瓜徒悬","pinyin":"páo guā tú xuán","abbr":"pgtx","explanation":"匏瓜：似葫芦而稍大，成熟后可以做水瓢。比喻有才能的人不为世所用。","source":{"text":"惧匏瓜之徒悬兮，畏井渫之莫食。","book":"《论语·阳货》：“吾岂匏瓜也哉？焉能系而不食。”三国·魏·王粲《登楼赋》"}},{"id":9264,"word":"匏瓜空悬","pinyin":"páo guā kōng xuán","abbr":"pgkx","explanation":"孔子比喻自己无法像匏瓜那样系悬着而不让人食用，应该出仕为官，有所作为。后用以比喻有才能的人却不为世所用。","source":{"text":"吾岂匏瓜也哉？焉能系而不食。","book":"《论语·阳货》"},"usage":"作宾语、定语；指怀才不遇"},{"id":9265,"word":"匕首投枪","pinyin":"bǐ shǒu tóu qiāng","abbr":"bstq","explanation":"匕首：短剑。比喻短小犀利击中要害的文章。","source":{"text":"除了匕首、投枪，也还有发聋振聩的木铎，有悠然发人深思的静夜钟声。","book":"茅盾《联系实际·学习鲁迅》"},"usage":"作宾语、定语；指击中要害的东西"},{"id":9266,"word":"匕鬯不惊","pinyin":"bǐ chàng bù jīng","abbr":"bcbj","explanation":"匕：古代的一种勺子；鬯：香酒；匕和鬯都是古代宗庙祭祀用物。形容军纪严明，所到之处，百姓安居，宗庙祭祀，照常进行。","source":{"text":"震惊百里，不丧匕鬯。","book":"《周易·震》"},"example":{"text":"赣、宁之乱，坐镇上游，～，指挥若定。","book":"蔡东藩、许廑父《民国通俗演义》第三十六回"},"similar":["纪律严明","秋毫无犯","鸡犬不宁"],"opposite":["兵匪不分"],"usage":"作谓语、定语；形容镇定自若，纪律严明"},{"id":9267,"word":"匕鬯无惊","pinyin":"bǐ chàng wú jīng","abbr":"bcwj","explanation":"形容法纪严明，无所惊扰。同“匕鬯不惊”。","source":{"text":"吾曹固甚望此震烁中外，匕鬯无惊之新阁出现者也。","book":"黄远庸《弹劾案与新内阁》"},"similar":["匕鬯不惊","秋毫无犯"],"opposite":["惊师动众"],"usage":"作谓语、定语；形容镇定自若，纪律严明"},{"id":9268,"word":"化为乌有","pinyin":"huà wéi wū yǒu","abbr":"hwwy","explanation":"乌有：哪有，何有。变得什么都没有。指全部消失或完全落空。","source":{"text":"楚使子虚使于齐，王悉发车骑，与使者出畋。畋罢，子虚过姹乌有先生，亡是公存焉。","book":"汉·司马相如《子虚赋》"},"example":{"text":"岂意青州六从事，～一先生。","book":"宋·苏轼《章质夫送酒六壶，书至而酒不达，戏作小诗问之》诗"},"similar":["化为泡影","子虚乌有"],"opposite":["无中生有"],"usage":"作谓语、宾语；形容一下子丧失或全部落空"},{"id":9269,"word":"化为异物","pinyin":"huà wéi yì wù","abbr":"hwyw","explanation":"变成另外的东西。指死亡。","source":{"text":"千变万化兮，未始有极；忽然为人兮，何足控抟；化为异物兮，又何足患。","book":"汉·贾谊《鹏鸟赋》"},"example":{"text":"今果分别，各在一方，元瑜长逝，～。每一念至，何时可言。","book":"三国·魏·曹丕《与朝歌令吴质书》"},"usage":"作谓语、定语；指死亡"},{"id":9270,"word":"化为泡影","pinyin":"huà wéi pāo yǐng","abbr":"hwpy","explanation":"泡：水泡。变成像水泡和影子那样，很快就消失。","source":{"text":"由于六月十一日的黄河决堤，使豫东成为泽国，也就化为了泡影。","book":"郭沫若《洪波曲》第七章"},"example":{"text":"这个计划只能～了。"},"similar":["化为乌有"],"usage":"作谓语；指希望落空"},{"id":9271,"word":"化为灰烬","pinyin":"huà wéi huī jìn","abbr":"hwhj","explanation":"变成一堆灰土。多指被彻底烧光。"},{"id":9272,"word":"化公为私","pinyin":"huà gōng wéi sī","abbr":"hgws","explanation":"指以不法手段侵吞公物。","source":{"text":"舍二弟又说我弃了许多祖业，背地里化公为私，所瞒并不止这两项。","book":"清·李绿园《歧路灯》第七十回"},"example":{"text":"邓小平《一靠理想二靠纪律才能团结起来》：“有的党政机关设了许多公司，把国家拨的经费拿去做生意，以权谋私，～。”"},"similar":["据为己有"],"opposite":["大公无私","公私分明"],"usage":"作谓语、定语、宾语；用于公私关系"},{"id":9273,"word":"化及冥顽","pinyin":"huà jí míng wán","abbr":"hjmw","explanation":"冥顽：愚昧。教化普及到愚昧无知的人，使他们受到教育。形容教化普及，世风良好。"},{"id":9274,"word":"化及豚鱼","pinyin":"huà jí tún yú","abbr":"hjty","explanation":"比喻教化普及而深入。","source":{"text":"中孚，柔在内而刚得中，说而巽，孚，乃化邦也；豚鱼吉，信及豚鱼也。","book":"语出《易·中孚》"},"example":{"text":"退居于洛，四海是仪，～，名闻乳儿。","book":"宋·苏轼《祭司马君实文》"},"usage":"作宾语、定语；用于书面语"},{"id":9275,"word":"化外之民","pinyin":"huà wài zhī mín","abbr":"hwzm","explanation":"化：开化；民：民众。文明地区以外的民众，即没有开化的民众。旧时统治阶级的偏见，指中国教化达不到、法律管不着的少数民族。","source":{"text":"诸化外之人同类自相犯者，各依本俗法。","book":"《唐律疏义·名例》"},"usage":"作主语、宾语；用于书面语"},{"id":9276,"word":"化干戈为玉帛","pinyin":"huà gān gē wéi yù bó","abbr":"hggwyb","explanation":"干戈：指打仗；玉帛：玉器和丝织品，指和好。比喻使战争转变为和平。","source":{"text":"昔者夏鲧作三仞之城，诸侯背之，海外有狡心。禹知天下之叛也，乃坏城平池，散财物，焚甲兵，施之以德，海外宾服，四夷纳职，合诸侯于涂山，执玉帛者万国。","book":"《淮南子·原道训》"},"example":{"text":"三五十口子打手，经调人东说西说，便都喝碗茶，吃碗烂肉面，就可以～了。","book":"老舍《茶馆》第一幕"},"similar":["转危为安"],"usage":"作谓语；比喻使战争转变为和平"},{"id":9277,"word":"化性起伪","pinyin":"huà xìng qǐ wěi","abbr":"hxqw","explanation":"指变化先天的本性，兴起后天的人为。","source":{"text":"言圣人能变化本性，而兴起矫伪也。","book":"《荀子·性恶》：“故圣人化性而起伪，伪起而生礼义，礼义生而制法度。”杨倞注"},"example":{"text":"元定简学者刘砺曰：‘～，乌得无罪！’未几，果谪道州。","book":"《宋史·蔡元定传》"},"usage":"作谓语、定语；用于书面语"},{"id":9278,"word":"化悲痛为力量","pinyin":"huà bēi tòng wéi lì liàng","abbr":"hbtwll","explanation":"化：变。把内心的痛苦转化为前进的动力。","source":{"text":"闻号召，意深长：‘化悲痛为力量！’","book":"赵朴初《永难忘（自度曲）》"},"example":{"text":"请你～。"},"usage":"作谓语、宾语；用于吊唁等"},{"id":9279,"word":"化敌为友","pinyin":"huà dí wéi yǒu","abbr":"hdwy","explanation":"把敌人转化为自己的朋友。","source":{"text":"此去是要收服一个张秀才，化敌为友，做个内应。","book":"高阳《胡雪岩全传·红顶商人》"},"usage":"作谓语、定语；用于处事与交往等"},{"id":9280,"word":"化整为零","pinyin":"huà zhěng wéi líng","abbr":"hzwl","explanation":"把一个整体分成许多零散部分。","source":{"text":"上海成为孤岛之后，他们化整为零，装着难民的孩子逃了出来。","book":"郭沫若《洪波曲》第四章"},"example":{"text":"一般地说来，游击队当分散使用，即所谓‘～’时。","book":"毛泽东《抗日游击战争的战略问题》第四章"},"opposite":["化零为整"],"usage":"作谓语、宾语、定语；用于军事方面"},{"id":9281,"word":"化日光天","pinyin":"huà rì guāng tiān","abbr":"hrgt","explanation":"①指太平盛世。②比喻众目昭彰、是非分明的场合。同“光天化日”。","source":{"text":"尧舜化日光天，由为君能正；禹稷身显后狂，由为臣能正。","book":"太平天国《太平诏书》"},"example":{"text":"在昔文成五利之徒，虽卒以诡诞见诛，而忝窃崇封，耗土木金银至无算，傥生际圣朝，其能一日姑容于～之下与。","book":"清·陈康祺《郎潜纪闻》卷七"},"similar":["光天化日"],"usage":"作主语、宾语、定语；用于书面语"},{"id":9282,"word":"化枭为鸠","pinyin":"huà xiāo wéi jiū","abbr":"hxwj","explanation":"比喻变凶险为平安。枭即猫头鹰，旧时认为是凶鸟，鸠是吉祥之鸟。","source":{"text":"额捐赀集勇，谨守疆场，绝济匪之源，挫触藩之锐，卒能化枭为鸠，闾阎安堵。","book":"清·昭梿《啸亭杂录·朱白泉狱中上百朱二公书》"},"similar":["化险为夷"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":9283,"word":"化民成俗","pinyin":"huà mín chéng sú","abbr":"hmcs","explanation":"化：教育，感化；俗：风俗习惯。教育感化民众，使之形成良好文明的风俗习惯。","source":{"text":"君子如欲化民成俗，其必由学乎！","book":"《礼记·学记》"},"example":{"text":"奖以劝惩其下，～，则必有道焉。","book":"清·朱彝尊《送汤潜菴先生巡抚江南序》"},"usage":"作宾语、定语；用于书面语"},{"id":9284,"word":"化民易俗","pinyin":"huà mín yì sú","abbr":"hmys","explanation":"教化百姓，改变风俗。","source":{"text":"九年知类通达，强立而不反，谓之大成。夫然后足以化民易俗，近者说而远者怀之。","book":"《礼记·学记》"},"usage":"作谓语、定语；用于书面语"},{"id":9285,"word":"化腐为奇","pinyin":"huà fǔ wéi qí","abbr":"hfwq","explanation":"指变坏为好，变死板为灵巧或变无用为有用。同“化腐成奇”。","source":{"text":"臭腐复化为神奇，神奇复化为臭腐。","book":"战国·宋·庄周《庄子·知北游》"},"example":{"text":"古人诗词，不尽可法，善于运用，何难～。","book":"清·陈廷焯《白雨斋词话》"},"similar":["化腐朽为神奇","化腐成奇"],"usage":"作谓语、宾语、定语；指变坏为好"},{"id":9286,"word":"化腐成奇","pinyin":"huà fǔ chéng qí","abbr":"hfcq","explanation":"指变坏为好，变死板为灵巧或变无用为有用。","source":{"text":"是其所美者为神奇，所恶者为腐朽。臭腐复化为神奇，神奇复化为臭腐。","book":"语出《庄子·知北游》"},"example":{"text":"观此真可谓～，岂直雕虫小技而已耶！","book":"明·郎瑛《七修类稿·诗文·集句》"},"similar":["化腐为奇"],"usage":"作谓语、宾语、定语；指变坏为好"},{"id":9287,"word":"化腐朽为神奇","pinyin":"huà fǔ xiǔ wéi shén qí","abbr":"hfxwsq","explanation":"神奇：神妙奇特的东西。变坏为好，变死板为灵巧，变无用为有用。","source":{"text":"腐朽复化为神奇。","book":"《庄子·知北游》"},"usage":"作谓语、宾语、定语；用于做事等"},{"id":9288,"word":"化若偃草","pinyin":"huà ruò yǎn cǎo","abbr":"hryc","explanation":"指教化推行如风吹草伏。形容教化之易推行。","source":{"text":"子为政焉用杀，子欲善而民善矣。君子之德风，小人之德草，草上之风必偃。","book":"语出《论语·颜渊》"},"example":{"text":"《晋书·潘尼传》：“学犹萌苗，～。”"},"usage":"作宾语、定语；用于书面语"},{"id":9289,"word":"化被万方","pinyin":"huà bèi wàn fāng","abbr":"hbwf","explanation":"华：德化，用恩德来感化；被：到，及；万方：四面八方。恩德感化达到四面八方。","source":{"text":"恩覃九有，化被万方。","book":"唐·柳宗元《为李谏议贺赦表》"},"usage":"作宾语；用于夸奖人"},{"id":9290,"word":"化铁为金","pinyin":"huà tiě wéi jīn","abbr":"htwj","explanation":"化：变。神话传说仙人将石头变为黄金。比喻修改文章，化腐朽为神奇。","source":{"text":"郁离子学道于藐乾罗子冥，授化铁为金之术。","book":"明·刘基《郁离子·化铁之术》"},"similar":["点铁成金"],"usage":"作谓语、定语；用于文章等"},{"id":9291,"word":"化险为夷","pinyin":"huà xiǎn wéi yí","abbr":"hxwy","explanation":"险：险阻；夷：平坦。化危险为平安。比喻转危为安。","source":{"text":"变氛沴为阳煦，化险阻为夷途。","book":"唐·韩云卿《平蛮颂序》"},"example":{"text":"除夕遇险的一幕，自然又回忆起来，但我们这一次是～了，虽然费了一些周折。","book":"郭沫若《革命春秋·南昌之一夜》"},"similar":["转危为安"],"opposite":["得而复失","如履薄冰","千钧一发"],"usage":"作谓语、定语；指危险的处境变成平安"},{"id":9292,"word":"化零为整","pinyin":"huà líng wéi zhěng","abbr":"hlwz","explanation":"把零散的部分集中为一个整体。","source":{"text":"集中使用兵力，即所谓‘化零为整’的办法，多半是在敌人进攻之时为了消灭敌人而采取的。","book":"毛泽东《抗日游击战争的战略问题》第四章"},"example":{"text":"一有时间就写，～，许多零碎时间妥善地利用起来，不就是一个大整数。","book":"吴晗《前言》"},"opposite":["化整为零"],"usage":"作谓语、宾语、定语；用于军事方面"},{"id":9293,"word":"化驰如神","pinyin":"huà chí rú shén","abbr":"hcrs","explanation":"化：以恩德感化；驰：疾速奔走。旧时比喻道德教化深受百姓欢迎，施行极为迅速。","source":{"text":"令虽未出，化驰如神，心有所怀，感动万里。","book":"《史记·淮南衡山列传》"}},{"id":9294,"word":"化鸱为凤","pinyin":"huà chī wéi fèng","abbr":"hcwf","explanation":"比喻能以德化民，变恶为善。鸱，猫头鹰，古人以为凶鸟。","source":{"text":"时考城令河内王涣，政尚严猛，闻览以德化人，署为主簿。谓览曰：‘主簿闻陈元之过，不罪而化之，得少鹰鹯之志邪？’览曰：‘以为鹰鹯不若鸾凤。’","book":"语出《后汉书·循吏传·仇览》"},"example":{"text":"但知私财不入，公事夙办，便函云我能治民，不知诚己刑物，执辔如组，反风灭火，～之术也。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":9295,"word":"北去南来","pinyin":"běi qù nán lái","abbr":"bqnl","explanation":"有的从北往南，有的从南往北。也泛指来来往往。","source":{"text":"北去南来无定居，此生生计竟何如。","book":"唐·杜荀鹤《秋宿临江驿》：“南来北去二三年，年去年来两鬓斑。”唐·罗隐《早发》"},"example":{"text":"两岸舟船各背驰，波痕交涉亦难为。只余鸥鹭无拘管，～自在飞。","book":"宋·杨万里《初入淮河》"}},{"id":9296,"word":"北叟失马","pinyin":"běi sǒu shī mǎ","abbr":"bssm","explanation":"比喻祸福没有一定。","source":{"text":"太宗尝从容谓房玄龄曰：‘萧瑀大业之日，进谏隋主，出为河池郡守。应遭剖心之祸，翻见太平之日，北叟失马，事亦难常。","book":"《旧唐书·萧瑀传》"},"example":{"text":"～的事情也未必不发生。"},"similar":["塞翁失马","因祸得福"],"usage":"作谓语、定语；同“塞翁失马”","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":9297,"word":"北宫婴儿","pinyin":"běi gōng yīng ér","abbr":"bgye","explanation":"北宫：古代王后所居之宫；婴儿：指齐国孝女婴儿子。用作孝女的代称。","source":{"text":"北宫之女婴儿子无恙耶？彻其环瑱，至老不嫁，以养父母，是皆率民而出于孝情者也，胡为至今不朝也。","book":"《战国策·齐策四》"},"usage":"作宾语；用作孝女的代称"},{"id":9298,"word":"北斗之尊","pinyin":"běi dǒu zhī zūn","abbr":"bdzz","explanation":"北斗星的位置近于天的中心。比喻地位非常尊贵。","source":{"text":"地出南关远，天回北斗尊。","book":"唐·李又《沙门弘景道俊玄奘还荆州应制》"}},{"id":9299,"word":"北窗之友","pinyin":"běi chuāng zhī yǒu","abbr":"bczy","explanation":"指琴、诗、酒。","source":{"text":"今日北窗下，自问何所为，欣然得三友，三友者为谁？琴罢辄举酒，酒罢辄吟诗。","book":"唐·白居易《北窗三友》"}},{"id":9300,"word":"北窗高卧","pinyin":"bēi chuāng gāo wò","abbr":"bcgw","explanation":"比喻悠闲自得。","source":{"text":"老来曾识渊明词：问北窗高卧，东篱自醉，应有别、归来意。","book":"晋·陶渊明《与子俨等书》：“常言五六月中，北窗下卧，遇凉风暂至，自谓是羲皇上人。”宋·辛弃疾《水龙吟》"}},{"id":9301,"word":"北芒垒垒","pinyin":"běi máng lěi lěi","abbr":"bmll","explanation":"北芒：也作邙山，在今河南洛阳市东北，汉魏时，王侯公卿多葬于此；垒垒：坟冢一个挨一个。形容坟墓很多。","source":{"text":"北芒何垒垒，高陵有四五，借问谁家坟，皆云汉世主。","book":"晋·张载《七哀》"}},{"id":9302,"word":"北走胡，南走越","pinyin":"běi zǒu hú，nán zǒu yuè","abbr":"bzhnzy","explanation":"胡：古代北方少数民族；越：古代南方少数民族。比喻有才能的人得不到重用而投奔异国。","source":{"text":"今上始得天下，独以己之私怨求一人，何示天下之不广也！且以季布之贤而汉求之急如此，此不北走胡即南走越耳。","book":"《史记·季布栾布列传》"}},{"id":9303,"word":"北辕适楚","pinyin":"běi yuán shì chǔ","abbr":"bysc","explanation":"北辕：车子向北行驶；适：到。楚在南方，赶着车往南走。比喻行动与目的相反。","source":{"text":"先民有言：适楚而北辕者，曰：‘吾马良，用多，御善。’此三者益侈，其去楚亦远矣。","book":"《战国策·魏策四》：“犹至楚而北行也。”汉·荀悦《申鉴·杂言下》"},"example":{"text":"欲望凤来百兽舞，何异北辕将适楚。","book":"唐·白居易《新乐府·立部伎》"},"similar":["南辕北辙","适得其反"],"opposite":["有的放矢"],"usage":"作谓语、宾语、定语；形容做事荒唐","story":["战国时期，魏安王决定攻打赵国都城邯郸，大臣们都反对他，季梁给他讲一个故事：太行山的一个人驾车准备到楚国去，但他却坚持往北走，这样越走越远。争霸不是靠打仗，而是靠赢得民心，靠打仗就像南辕北辙一样。魏安王决定不打仗了"]},{"id":9304,"word":"北辕适粤","pinyin":"běi yuán shì yuè","abbr":"bysy","explanation":"犹北辕适楚。粤在南方。","source":{"text":"北辕适粤，徒劳何为？","book":"明·刘基《顺斋箴为夏仲珍作》"},"similar":["北辕适楚"],"opposite":["有的放矢"],"usage":"作谓语、宾语、定语；形容做事荒唐"},{"id":9305,"word":"北辙南辕","pinyin":"běi zhé nán yuán","abbr":"bzny","explanation":"①想往南却驾车向北行驶。比喻行为和目的相反。②车子北往南来。喻人行无定迹。","source":{"text":"见“北辕适楚”。"},"example":{"text":"数十年以来，～，风樯篷底，有所见即借钞，或录草稿以归。","book":"清·陆以湉《冷庐杂识·徐敬斋明经》"},"similar":["南辕北辙"],"usage":"作宾语、定语；指行动和目的正好相反"},{"id":9306,"word":"北辰星拱","pinyin":"bēi chén xīng gǒng","abbr":"bcxg","explanation":"北辰：北极星；拱：环绕。北极星高悬不动，群星四面环绕。旧时比喻治理国家施行德政，天下便会归附。后也比喻受众人拥戴的人。","source":{"text":"譬如北辰居其所而众星共之。","book":"《论语·为政》"},"similar":["众星拱北"],"usage":"作宾语、定语；指受人尊重"},{"id":9307,"word":"北道主人","pinyin":"běi dào zhǔ rén","abbr":"bdzr","explanation":"北道上接待过客的主人。与“东道主人”同义。","source":{"text":"更始北都洛阳，以晨为常山太守。会王郎反，光武自蓟走信都，晨亦间行会于巨鹿下，自请从击邯郸。光武曰：‘伟卿（邓晨）以一从我，不如以一郡为我北道主人。’","book":"《后汉书·邓晨传》"},"similar":["东道主"],"usage":"作主语、宾语、定语；指东道主"},{"id":9308,"word":"北郭先生","pinyin":"běi guō xiān shēng","abbr":"bgxs","explanation":"用以指隐居不仕的人。","source":{"text":"《韩诗外传》卷九载，北郭先生却楚庄王之聘不仕。《后汉书·方术传·廖扶》载，廖扶感父以法丧身，惮为吏，终身不仕，时人因号为北郭先生。"},"example":{"text":"劳劳下马自披帷，～隐几时。","book":"清·周亮工《重过前岳太守李灿辰思鹤亭》诗"},"opposite":["南郭先生"],"usage":"作主语、宾语、定语；指隐士"},{"id":9309,"word":"北鄙之声","pinyin":"bēi bǐ zhī shēng","abbr":"bbzs","explanation":"指殷纣时的音乐。后世视为亡国之声。","source":{"text":"见“北鄙之音”。"},"example":{"text":"纣为～，其废也忽焉，至今王公以为笑。","book":"汉刘向《说苑·修文》"},"similar":["北鄙之音"],"usage":"作主语、宾语；指亡国的音乐"},{"id":9310,"word":"北鄙之音","pinyin":"bēi bǐ zhī yīn","abbr":"bbzy","explanation":"指殷纣时的音乐。后世视为亡国之声。亦作“北鄙之声”。","source":{"text":"纣为朝歌北鄙之音，身死国亡……夫朝歌者不时也，北者败也，鄙者陋也，纣乐好之，与万国殊心，诸侯不附，百姓不亲，天下畔之，枚身死国亡。","book":"《史记·乐书》"},"similar":["北鄙之声","靡靡之音"],"usage":"作主语、宾语；指亡国的音乐"},{"id":9311,"word":"北门之叹","pinyin":"běi mén zhī tàn","abbr":"bmzt","explanation":"北门：《诗经》中的一篇，有怀才不遇之意；叹：叹息。指怀才不遇而发出的叹息。","source":{"text":"北门之叹，久已上闻，穷猿奔林，岂暇择木乎。","book":"南朝·宋·刘义庆《世说新语·言语》"}},{"id":9312,"word":"北门之寄","pinyin":"běi mén zhī jì","abbr":"bmzj","explanation":"指负军事重任。","source":{"text":"德宗以河东密迩胡戎，难于择帅，翌日，自良谢，上谓之曰：‘卿与马燧存军中事分，诚为得礼；然北门之寄，无易于卿。’","book":"《旧唐书·李自良传》"},"example":{"text":"上方勤西顾之忧，公特任～。宋·岳珂《桯史·吴畏斋谢贽启》"},"similar":["北门之管"],"usage":"作宾语；用于军事"},{"id":9313,"word":"北门之管","pinyin":"běi mén zhī guǎn","abbr":"bmzg","explanation":"用以喻军事要地或守御重任。","source":{"text":"管，钥也。","book":"《左传·僖公三十二年》：“杞子自郑使告于秦曰：‘郑人使我掌其北门之管，若潜师以来，国可得也。’”杜预注"},"example":{"text":"泥城者，佛山之要路，～寄焉。","book":"《三元里搞英斗争史料·广州城坊志》"},"similar":["北门锁钥"],"usage":"作宾语；指军事要塞","story":["春秋时期，秦国人杞子在郑国掌握了都城北门的钥匙，派人要秦穆公攻打郑国。秦穆公不听蹇叔的劝告，派大将孟明视等率军出征。郑国商人弦高发现，假装送礼迎接秦军，背后通风报信。晋国乘机出兵打败秦军。秦穆公承认是他的罪过"]},{"id":9314,"word":"北门南牙","pinyin":"běi mén nán yá","abbr":"bmny","explanation":"北门：指羽林诸将；南牙：指宰相。指文武重臣。","source":{"text":"今天诱其衷北门南牙，同心协力，以诛凶竖，复李氏社稷。","book":"《资治通鉴·唐纪中宗神龙元年》"},"similar":["文武百官"],"usage":"作宾语、定语；泛指文武重臣"},{"id":9315,"word":"北门管钥","pinyin":"běi mén guǎn yuè","abbr":"bmgy","explanation":"犹北门之管。","source":{"text":"北门管钥赖将军，虎节重臣亲拜疏。","book":"清·黄遵宪《冯将军歌》"},"similar":["北门之管","北门锁钥"],"usage":"作宾语、定语；指军事要地","story":["春秋时期，秦国人杞子在郑国掌握了都城北门的钥匙，派人要秦穆公攻打郑国。秦穆公不听蹇叔的劝告，派大将孟明视等率军出征。郑国商人弦高发现，假装送礼迎接秦军，背后通风报信。晋国乘机出兵打败秦军。秦穆公承认是他的罪过"]},{"id":9316,"word":"北门锁钥","pinyin":"běi mén suǒ yuè","abbr":"bmsy","explanation":"原指北城门上的锁和钥匙。后借指北方的军事要地。","source":{"text":"杞子自郑使告于秦，曰：‘郑人使我掌其北门之管，若潜师以来，国可得也。’","book":"《左传·僖公三十二年》"},"example":{"text":"宋·朱熹《五朝名臣言行录》：“皇上以朝廷无事，北门锁钥，非准不可。”"},"similar":["北门之管"],"usage":"作宾语、定语；指军事要地","story":["春秋时期，秦国人杞子在郑国掌握了都城北门的钥匙，派人要秦穆公攻打郑国。秦穆公不听蹇叔的劝告，派大将孟明视等率军出征。郑国商人弦高发现，假装送礼迎接秦军，背后通风报信。晋国乘机出兵打败秦军。秦穆公承认是他的罪过"]},{"id":9317,"word":"北面称臣","pinyin":"běi miàn chēng chén","abbr":"bmcc","explanation":"古代君主面南而北，臣子拜见君主则面北，指臣服于人。","source":{"text":"君主宜郊迎，北面称臣。","book":"《史记·郦生陆贾列传》"},"example":{"text":"追慕南越，婴齐入侍，～，伏听告策。","book":"晋·孙楚《为石仲容与孙皓书》"},"similar":["俯首称臣"],"usage":"作谓语、宾语；指投降"},{"id":9318,"word":"北风之恋","pinyin":"běi fēng zhī liàn","abbr":"bfzl","explanation":"比喻对故土的怀念之情。","source":{"text":"胡马依北风，越鸟巢南枝。","book":"南朝·梁·萧统《古诗十九首·行行重行行》"},"example":{"text":"长湖公军人等虽筑馆处之，然恐不能无～。王褒、庾信之徒既羁旅关中，亦当有南枝之思耳。","book":"《周书·杜杲传》"},"similar":["越鸟南栖","狐死首丘"],"usage":"作宾语；指思念家乡"},{"id":9319,"word":"匝地烟尘","pinyin":"zā dì yān chén","abbr":"zdyc","explanation":"匝地：遍地；烟尘：烽烟和战场上扬起的尘土。到处都能看到烽烟和战场上扬起的尘土。形容兵荒马乱的混乱景象。","source":{"text":"从此谈今论古日倾倒，风雨开怀抱。你那苏张舌辩高，我的巧射惊羿奡，只愁那匝地烟尘何日扫。","book":"清·孔尚任《桃花扇·投辕》"}},{"id":9320,"word":"匠心独具","pinyin":"jiàng xīn dú jù","abbr":"jxdj","explanation":"工巧独特的艺术构思。","source":{"text":"编导和演员门匠心独具地从生活出发……成功地刻划了以小强为主角的一代少年儿童形象。","book":"柯岩《奇异的书简·阳光和风雨谱写的歌》"},"similar":["匠心独运"],"usage":"作定语、宾语、状语；指独特"},{"id":9321,"word":"匠心独出","pinyin":"jiàng xīn dú chū","abbr":"jxdc","explanation":"匠心：工巧的心思；独：独自。形容巧妙而独特的艺术构思。","source":{"text":"故其为诗，如嗔如笑，如水鸣峡，如种出土，如寡妇之夜哭，羁人之寒起，虽其体格时有卑者，然匠心独出，有王者气。","book":"明·袁宏道《徐文长传》"},"similar":["匠心独妙"],"usage":"作谓语、定语、宾语；用于思想或构思等"},{"id":9322,"word":"匠心独妙","pinyin":"jiàng xīn dú miào","abbr":"jxdm","explanation":"匠心：精巧的构思。独妙：独到的巧妙。形容巧妙而独具一格的艺术构思。亦作“匠心独出”、“匠心独运”。","source":{"text":"文不按古，匠心独妙。","book":"唐·王士源《孟浩然集序》"},"example":{"text":"学不考儒，务掇精华；文不按古，～。","book":"宋·计有功《唐诗纪事》卷二三"},"similar":["匠心独出"],"usage":"作谓语、定语、宾语；用于思想或构思等"},{"id":9323,"word":"匠心独运","pinyin":"jiàng xīn dú yùn","abbr":"jxdy","explanation":"匠心：工巧的心思。独创性地运用精巧的心思。","source":{"text":"文不按古，匠心独妙。","book":"唐·王士源《孟浩然集序》"},"example":{"text":"至～之作，色韵古雅，掌故淹通。","book":"清·平步青《霞外捃屑》卷七"},"similar":["独具匠心","独树一帜","匠心独具"],"opposite":["因循守旧","墨守成规"],"usage":"作定语、宾语、状语；指独特"},{"id":9324,"word":"匠石运斤","pinyin":"jiàng shí yùn jīn","abbr":"jsyj","explanation":"匠：匠人；石：人名；运：抡；斤：斧子。指木匠石抡斧砍掉郢人鼻尖上的白灰，而没有碰伤郢人的鼻子。形容技艺精湛超群。","source":{"text":"郢人垩慢其鼻端，若蝇翼。使匠石斫之。匠石运斤成风，听而斫之，尽垩而鼻不伤。郢人立不失容。","book":"战国·宋·庄周《庄子·徐无鬼》"},"similar":["庖丁解牛"],"usage":"作宾语、定语；技艺精湛超群","story":["传说很久以前有一个技艺很精湛超群的匠人石，他善于使用斧头削东西。一天一个楚国都城郢人干活时鼻子上沾上了一层像苍蝇翅膀那样的白灰，不太好擦掉，就跑去找匠人石。匠人石抡起斧子一阵狂削，白灰掉了，而郢人的鼻子完好无损"]},{"id":9325,"word":"匠石运金","pinyin":"jiàng shí yùn jīn","abbr":"jsyj","explanation":"匠：匠人；石：人名；运：抡；斤：斧子。原指木匠石抡斧砍掉郢人鼻尖上的白灰，而没有碰伤郢人的鼻子。后用以形容技艺精湛。","source":{"text":"郢人垩漫其鼻端，若蝇翼。使匠石斫之。匠石运斤成风，听而斫之，尽垩而鼻不伤。郢人立不失容。","book":"《庄子·徐无鬼》"}},{"id":9326,"word":"匠遇作家","pinyin":"jiàng yù zuò jiā","abbr":"jyzj","explanation":"匠：有专长的技工；作家：能手，行家。比喻双方本领不相上下。","source":{"text":"今日棋逢对手，匠遇作家也，你是好武艺为魁，我和你再战几百合。","book":"元·无名氏《定时捉将》"},"example":{"text":"我们真是棋逢对手，～。"},"similar":["棋逢对手"],"usage":"作宾语、定语；指旗鼓相当"},{"id":9327,"word":"匠门弃材","pinyin":"jiàng mén qì cái","abbr":"jmqc","explanation":"能工巧匠废弃的材料。比喻无用的人。","source":{"text":"公驰驱绝域，犹手笺酬答无间。匠门弃材，累公之明。","book":"清·冯桂芬《林文忠公祠记》"},"usage":"作宾语；用于自谦"},{"id":9328,"word":"匡乱反正","pinyin":"kuāng luàn fǎn zhèng","abbr":"klfz","explanation":"消除混乱局面，恢复正常秩序。","source":{"text":"仲尼悼礼废乐崩，追修经术，以达王道，匡乱世反之于正。","book":"西汉·司马迁《史记·太史公自序》"},"example":{"text":"其意诸侯之得世其家者，以其知有天子而能～也。","book":"清·袁枚《随园随笔·诸史上》"},"similar":["拨乱反正"],"usage":"作谓语；指消除混乱局面，恢复正常秩序"},{"id":9329,"word":"匡俗济时","pinyin":"kuāng sú jì shí","abbr":"ksjs","explanation":"匡：纠正；济：救助。拯救社会时局和风气，使之归于正道。","source":{"text":"王公卿尹，群僚庶官，其有嘉谋直献，匡俗济时，咸切事陈奏，无或依隐。","book":"《宋书·明帝纪》"},"similar":["匡时济俗"],"usage":"作谓语、定语；指挽救动荡的局势"},{"id":9330,"word":"匡其不逮","pinyin":"kuāng qí bù dǎi","abbr":"kqbd","explanation":"匡：纠正。逮：及，达到。不逮：达不到的地方。对于达不到的地方给予纠正或帮助。亦作“匡所不逮”。","source":{"text":"乃举贤良方正能直言极谏者，以匡朕之不逮。","book":"《汉书·文帝纪》"},"example":{"text":"足下云，幸在后死，尚须仆～，共成不朽。","book":"清·侯方域《答张尔公书》"},"similar":["匡所不逮"],"usage":"作谓语、定语；用于书面语"},{"id":9331,"word":"匡合之功","pinyin":"kuāng hé zhī gōng","abbr":"khzg","explanation":"匡：纠正；匡合：把天下纳入正轨。指治理国家的功劳。","source":{"text":"齐桓设庭燎之礼，故有匡合之功。","book":"汉·王褒《圣主得贤臣颂》"},"example":{"text":"峤虽无管张之才，而明公有桓文之志，欲建～，岂敢辞命。","book":"《晋书·温峤传》"},"usage":"作宾语；用于大功劳"},{"id":9332,"word":"匡国济时","pinyin":"kuāng guó jì shí","abbr":"kgjs","explanation":"匡正国家，挽救时局。","source":{"text":"玄龄初与杜如晦为友，属隋室丧乱，未尝不慨然相顾，有匡国济时之心。","book":"《隋书·帝纪第一·高祖上》：“匡国济时，除凶拨乱。”唐·李翱《卓异记·三十二年居相位》"},"example":{"text":"[郑相国] ～，终始一致，文经武纬，何谢古人！","book":"唐·康骈《剧谈录·凤翔府举兵》"},"usage":"作谓语、定语；用于挽救时局"},{"id":9333,"word":"匡床蒻席","pinyin":"kuāng chuáng ruò xí","abbr":"kcrx","explanation":"匡：方正；蒻：嫩的香蒲。标准的床，柔软的席子。形容床铺非常舒适。","source":{"text":"匡床蒻席，非不宁也。","book":"《淮南子·主术训》"}},{"id":9334,"word":"匡救弥缝","pinyin":"kuāng jiù mí fèng","abbr":"kjmf","explanation":"指纠正错误，弥补过失。","source":{"text":"纠合诸侯，而谋其不协，弥缝其阙，而匡救其灾。","book":"春秋·鲁·左丘明《左传·僖公二十六年》"},"example":{"text":"秕政日闻，赖诸公～。","book":"明·沈德符《野获编·内阁·阁部离合》"},"usage":"作谓语；指纠正错误，弥补过失"},{"id":9335,"word":"匡时济世","pinyin":"kuāng shí jì shì","abbr":"ksjs","explanation":"匡：纠正。济：救助。挽救动荡的局势。使其转危为安。","source":{"text":"平运则弘道以求志，陵夷则濡迹以匡时。","book":"《后汉书·荀淑传》"},"similar":["匡时济俗"],"usage":"作谓语、定语；指挽救动荡的局势"},{"id":9336,"word":"匡时济俗","pinyin":"kuāng shí jì sú","abbr":"ksjs","explanation":"匡：纠正；济：救助。拯救社会时局和风气，使之归于正道。","source":{"text":"故禹拜昌言而嘉猷罔伏，汉征极谏而文学稍进，匡时济俗，罔不率繇。","book":"唐·元稹《才识兼茂明于体用策一道》"},"similar":["匡时济世"],"usage":"作谓语、定语；指挽救动荡的局势"},{"id":9337,"word":"匡正纲纪","pinyin":"kuāng zhèng gāng jì","abbr":"kzgj","explanation":"指纠正法度。","source":{"text":"上当匡正纲纪，下当济安元元。","book":"南朝·宋·范晔《后汉书·何敞传》"},"usage":"作谓语、宾语；指纠正法度"},{"id":9338,"word":"匡衡凿壁","pinyin":"kuāng héng záo bì","abbr":"khzb","explanation":"后以之为刻苦读书的典实。","source":{"text":"匡衡，字稚圭。勤学而无烛，邻舍有烛而不逮，衡乃穿壁引其光，以书映光而读之。","book":"《西京杂记》卷二"},"example":{"text":"因效～之义，于墙上穴一小孔，置灯彼屋而光射此房。","book":"清·李渔《闲情偶寄·居室·书房壁》"},"similar":["凿壁偷光"],"usage":"作宾语、定语；指人勤学","story":["西汉时期，宰相匡衡从小因为家贫，没有条件进学堂，他白天帮人干活，晚上没钱买灯油，就只好在家里土墙上凿一个洞，借隔壁的灯光来读书，甚至到有书的人家去免费帮工换取书本，他刻苦学习终于在汉元帝时期当上太子少傅"]},{"id":9339,"word":"匡谬正俗","pinyin":"kuāng miù zhèng sú","abbr":"kmzs","explanation":"纠正错误，矫正陋习。","source":{"text":"嗟呼！后人之于古人，人誉亦誉，人毁亦毁，因其一节之长，遗其全体之短，习非胜是，好恶不公，有起而匡谬正俗者，辄谓伤忠厚焉。","book":"唐·颜师古有《匡谬正俗》八卷。田北湖《与某生论韩文书》"},"usage":"作宾语、定语；用于书面语"},{"id":9340,"word":"匡鼎解颐","pinyin":"kuāng dǐng jiě yí","abbr":"kdjy","explanation":"指讲诗清楚明白，非常动听。","source":{"text":"如淳曰：‘使人笑不能不止也。’","book":"《汉书·匡衡传》：“无说《诗》，匡鼎来；匡说《诗》，解人颐。”颜师古注"},"example":{"text":"故诗至人妙，有言下未尝毕露，其情则已跃然者。使善说者代为指点，无不亹亹动人，即～是已。","book":"清·李重华《贞一斋诗说·诗谈杂录》"},"usage":"作宾语；指非常动听"},{"id":9341,"word":"匣剑何时跃","pinyin":"xiá jiàn hé shí yuè","abbr":"xjhsy","explanation":"匣剑：藏在匣子里的宝剑。比喻未被重用的人才，感慨什么时候才能施展本领。","source":{"text":"未知匣剑何时跃，但恐铅刀不再铦。","book":"唐·韦庄《冬日长安感志》"},"usage":"作宾语、定语、分句；用于书面语"},{"id":9342,"word":"匣剑帷灯","pinyin":"xiá jiàn wéi dēng","abbr":"xjwd","explanation":"帷：帐幕。匣里的宝剑，帐里的明灯，剑气灯光，若隐若现。比喻事情无法掩藏，或故意露出消息引人注意。","source":{"text":"高帝斩白蛇剑，剑上有七采珠，九华玉以为饰，杂厕五色琉璃为剑匣，剑在室中，光景犹照於外，与挺剑不殊。","book":"《西京杂记》卷一"},"example":{"text":"～法。","book":"清·唐文治《国文经纬贯通大法》"},"usage":"作宾语、定语；用于写景状物的文章"},{"id":9343,"word":"匣里龙吟","pinyin":"xiá lǐ lóng yīn","abbr":"xlly","explanation":"宝剑在匣中发出龙吟般的声响。原指剑的神通，后比喻有大材的人希望见用。","source":{"text":"帝颛顼有曳影之剑，腾空而舒，若四方有兵，此剑则飞起，指其方则剋伐。未用之时，常于匣里如龙虎之吟。","book":"晋·王嘉《拾遗记》卷一"},"usage":"作谓语、定语；指名声在外"},{"id":9344,"word":"匪伊朝夕","pinyin":"fěi yī zhāo xī","abbr":"fyzx","explanation":"匪：不是；伊：文言助词。不止一个早晨一个晚上。","source":{"text":"今若召悦授以内官，臣列旆东辕，匪朝伊夕。","book":"《周书·文帝纪上》"},"example":{"text":"我有志，～。","book":"清·蒲松龄《聊斋志异·婴宁》"},"similar":["匪朝伊夕"],"usage":"作状语；指时间长"},{"id":9345,"word":"匪匪翼翼","pinyin":"féi féi yì yì","abbr":"ffyy","explanation":"匪匪：马行走不停的样子；翼翼：有次序的样子。形容车马行走时阵容整齐、威武。","source":{"text":"车马之美，匪匪翼翼。","book":"《诗经·小雅·四牡》：“四牡匪匪。”《诗经·小雅·采芑》：“四骐翼翼。”《礼记·少仪》"},"similar":["整整齐齐"],"usage":"作谓语；指整齐有序"},{"id":9346,"word":"匪夷匪惠","pinyin":"fěi jí fěi huì","abbr":"fyfh","explanation":"夷：殷末周初的伯夷；惠：春秋时鲁国的柳下惠。既不是伯夷，又不是柳下惠；不具备这两位贤人的品德。形容才德不高而又驾驭的人。","source":{"text":"匪夷匪惠，难居公正之明；载省载思，当徇栖衡之志，可放还山。","book":"《旧唐书·司空图传》"},"similar":["不夷不惠"],"usage":"作谓语；形容才德不高的人"},{"id":9347,"word":"匪夷所思","pinyin":"fěi yí suǒ sī","abbr":"fyss","explanation":"匪：不是；夷：平常。指言谈行动离奇古怪，不是一般人根据常情所能想象的。","source":{"text":"涣有丘，匪夷所思。","book":"《周易·涣》"},"example":{"text":"孙莱山入枢廷，是在意中，乌少云则～了。","book":"高阳《清宫外史》下册"},"similar":["想入非非","异想天开","胡思乱想"],"usage":"作谓语、宾语、定语；形容事情离奇复杂"},{"id":9348,"word":"匪异人任","pinyin":"fěi yì rén rèn","abbr":"fyrr","explanation":"异人：别人；任：承担。表示责任不能推诿，要自己负责。","source":{"text":"吾四万万同胞乎！诸君固民国之主人也，唤起天下，驱除此丑类者，匪异人任。","book":"孙中山《救国之急务》"},"example":{"text":"何不趁此机会，揽握重兵，反手齐王，～。","book":"蔡东藩《民国通俗演义》第二回"},"similar":["非异人任"],"usage":"作谓语；表示某事应由自己负责"},{"id":9349,"word":"匪朝伊夕","pinyin":"fěi zhāo yī xī","abbr":"fcyx","explanation":"匪：不是；伊：文言助词。不止一个早晨一个晚上。","source":{"text":"今若召悦授以内官，臣列旆东辕，匪朝伊夕。","book":"《周书·文帝纪上》"},"example":{"text":"～，不可胜记。","book":"唐·李林甫《嵩阳观纪胜德感应颂》"},"similar":["匪伊朝夕"],"usage":"作定语、状语；指时间长"},{"id":9350,"word":"匪石之心","pinyin":"fěi shí zhī xīn","abbr":"fszx","explanation":"比喻坚贞不渝。","source":{"text":"我心匪石，不可转也。","book":"《诗经·邶风·柏舟》"},"example":{"text":"遂将～，冀伸藻镜之用。","book":"五代·王定保《唐摭言·主司失意》"},"similar":["柏舟之誓"],"usage":"作宾语；比喻意志坚定，永不变心","story":["春秋时期，卫世子共伯夫妇感情十分恩爱，曾经山盟海誓他们的爱情至死不变。后来共伯去世，其父母想要他妻子共姜改嫁。共姜坚决不答应，就做一首诗《柏舟》来证明他们匪石匪席的爱情，让其父母打消这个念头"]},{"id":9351,"word":"匪石匪席","pinyin":"fěi shí fěi xí","abbr":"fsfx","explanation":"不是石，不是席。意为石可转而心不可转，席可卷而心不可卷。比喻意志坚定，永不变心。","source":{"text":"我心匪石，不可转也；我心匪席，不可卷也。","book":"《诗经·邶风·柏舟》"},"similar":["柏舟之誓"],"usage":"作谓语、定语；指意志坚定","story":["春秋时期，卫世子共伯夫妇感情十分恩爱，曾经山盟海誓他们的爱情至死不变。后来共伯去世，其父母想要他妻子共姜改嫁。共姜坚决不答应，就做一首诗《柏舟》来证明他们匪石匪席的爱情，让其父母打消这个念头"]},{"id":9352,"word":"匪躬之操","pinyin":"fěi gōng zhī cāo","abbr":"fgzc","explanation":"躬：自身；匪躬：指为君主尽忠而不顾自身。指不顾自家性命而尽忠王室的节操。","source":{"text":"臣亡祖先臣隗，昔荷殊宠，匪躬之操，犹存旧史，有志无时，怀恨黄泉。","book":"《晋书·刘隗传》"},"similar":["匪躬之节"],"usage":"作宾语；用于人的节操"},{"id":9353,"word":"匪躬之节","pinyin":"fěi gōng zhī jié","abbr":"fgzj","explanation":"躬：指自身利益；节：节操。指不顾自身利益而尽忠王室的节操。","source":{"text":"六二，王臣蹇蹇，匪躬之故。","book":"《周易·蹇》"},"example":{"text":"诏以胤忠允高亮，有～，使领司隶校尉。","book":"《晋书·李胤传》"},"similar":["匪躬之操"],"usage":"作宾语；用于人的节操"},{"id":9354,"word":"匹夫不可夺志","pinyin":"pǐ fū bù kě duó zhì","abbr":"pfbkdz","explanation":"匹夫：古指平民中的男子，后泛指一般人。比喻即使对一个普通的人，也不能随意改变他的志向。形容意志坚定，不可动摇。","source":{"text":"三军可夺帅也，匹夫不可夺志也。","book":"《论语·子罕》"}},{"id":9355,"word":"匹夫之勇","pinyin":"pǐ fū zhī yǒng","abbr":"pfzy","explanation":"指不用智谋单凭个人的勇力。","source":{"text":"此匹夫之勇，敌一人者也。","book":"《孟子·梁惠王下》"},"example":{"text":"你说尽一孤忠，上有寡母，下有娇妻，倚托何人？不可使～，懊悔无及。","book":"清·陈忱《水浒后传》第三十三回"},"similar":["一夫之勇"],"opposite":["深谋远虑"],"usage":"作宾语；指个人的勇气","story":["春秋时期，越王勾践在吴国被囚三年，受尽耻辱，他决心自励图强，立志复国。十年后，越国国富民强，兵强马壮。将士们向勾践请求出兵吴国报仇雪恨，勾践在出师动员上鼓励将士们不要逞匹夫之勇，要步调一致，共同进退"]},{"id":9356,"word":"匹夫之谅","pinyin":"pǐ fū zhī liàng","abbr":"pfzl","explanation":"指普通老百姓所抱守的小节小信。同“匹夫小谅”。","source":{"text":"箕子岂固欲自经于沟渎，而为匹夫之谅哉？","book":"宋·朱熹《答董叔重》"},"example":{"text":"宋·朱熹《答董叔重》：“箕子岂固欲自经于沟渎，而为～哉？”"},"similar":["匹夫小谅"],"usage":"作宾语、定语；用于为人"},{"id":9357,"word":"匹夫匹妇","pinyin":"pǐ fū pǐ fù","abbr":"pfpf","explanation":"平民男女。泛指平民。","source":{"text":"岂若匹夫匹妇之为谅也，自经于沟渎而莫知之也。","book":"《尚书·咸有一德》：“匹夫匹妇，不获自尽。”《论语·宪问》"},"example":{"text":"其名节又必如泰山大河，磊落汪洋，可信于天下后世之～方为善耳。","book":"清·恽敬《徐恭人墓志铭》"},"similar":["平民百姓"],"usage":"作主语、宾语、定语；泛指平民","story":["战国时期，万章问孟子商汤的贤臣伊尹从陪嫁奴隶做到宰相是不是事实。孟子说伊尹原是莘国郊外种地人，商汤派人去请他，他觉得匹夫匹妇应该为国做贡献，于是接受聘请，辅佐商汤灭掉夏桀，是真正的圣人"]},{"id":9358,"word":"匹夫小谅","pinyin":"pǐ fū xiǎo liàng","abbr":"pfxl","explanation":"指普通老百姓所抱守的小节小信。","source":{"text":"故梁衍献规，山东连盟，而舍格天之大业，蹈匹夫之小谅，卒狼狈虎口，为智士笑。","book":"语出《论语·宪问》：“岂若匹夫匹妇之为谅也，自经于沟渎而莫之知也。”《后汉书·皇甫嵩硃俊传论》"},"example":{"text":"[祝举人]情极自缢死。遗笔嘱其子曰：‘……含冤自经，虽类～，实出万不得已。’","book":"清·无名氏《王氏复仇记》"},"similar":["匹夫沟渎","匹夫之谅"],"usage":"作宾语、定语；用于为人"},{"id":9359,"word":"匹夫怀璧","pinyin":"pǐ fū huái bì","abbr":"pfhb","explanation":"比喻有才能、有理想而受害。同“匹夫无罪，怀璧其罪”。","source":{"text":"匹夫怀璧死，百鬼瞰高明。","book":"宋·黄庭坚《薄薄酒二章》"},"example":{"text":"书画之癖，往往沽祸，古今皆然，亦～之义。","book":"清·叶廷琯《鸥陂渔话藏书画沽祸》"},"similar":["匹夫无罪，怀璧其罪"],"usage":"作宾语、定语；指因有才能而受害"},{"id":9360,"word":"匹夫无罪","pinyin":"pǐ fū wú zuì","abbr":"pfwz","explanation":"匹夫：古指平民中的男子，后泛指一般人。一般人是没有罪过的。","source":{"text":"匹夫无罪，怀璧其罪。","book":"《左传·桓公十年》"},"usage":"作宾语、定语；常与“怀璧其罪”连用"},{"id":9361,"word":"匹夫无罪，怀璧其罪","pinyin":"pǐ fū wú zuì，huái bì qí zuì","abbr":"pfwzhbqz","explanation":"百姓本没有罪，因身藏璧玉而获罪。原指财宝能致祸。后亦比喻有才能、有理想而受害。","source":{"text":"初，虞叔有玉，虞公求旃。弗献。既而悔之，曰：‘周谚有之：‘匹夫无罪，怀璧其罪。’吾焉用此，其贾害也。’乃献之。","book":"《左传·桓公十年》"},"example":{"text":"天之苍苍，正色何色？～？万能的真理你为什么无动于衷？","book":"中英杰《罗浮山血泪祭》"},"similar":["匹夫怀璧"],"usage":"作分句、宾语；指因有才能而受害","story":["古代有个虞国民夫得到一块宝玉，当时朝廷虞王想搜罗天下的奇珍异宝。民夫不想贡献上去，后来人家劝他，说有谚语“匹夫无罪，怀璧其罪”，如果不交上去就会招致杀身之祸。民夫觉得有理，后悔当初，就赶忙把璧玉献给虞王"]},{"id":9362,"word":"匹夫有责","pinyin":"pǐ fū yǒu zé","abbr":"pfyz","explanation":"国家大事每个人都有责任。","source":{"text":"保天下者，匹夫之贱，与有责焉耳矣。","book":"清·顾炎武《日知录· 正始》"},"example":{"text":"余深有味其言，～之说，今人以为常谈，不悟其所重者，乃在保持道德，而非政治经济之云云。","book":"章炳麟《革命之道德》"},"similar":["责无旁贷","义不容辞"],"opposite":["敷衍塞责"],"usage":"作宾语、分句；常与“天下兴亡”连用","story":["明末清初，顾炎武从小爱读忠臣义士的故事，他参加图谋革新的复社，在昆山组织守将抗清，城破后他牢记继母王氏的教诲不做清朝的臣子，就化装成商人游走各地，联合各地抗清人士。他在《日知录》中写道：“保天下者，匹夫之贱，与有责焉耳矣。”"]},{"id":9363,"word":"匹夫沟渎","pinyin":"pǐ fū gōu dú","abbr":"pfgd","explanation":"指拘守普通人的小信小节。","source":{"text":"岂若匹夫匹妇之为谅也，自经于沟渎而莫之知也。","book":"《论语·宪问》"},"example":{"text":"江之所恃者堤，安有伯起不知以石代薪之便，功未及成，效～之为。","book":"宋·绍翁《四朝闻见录·张司封庙》"},"similar":["匹妇沟渠","匹夫小谅"],"usage":"作宾语、定语；用于为人"},{"id":9364,"word":"匹妇沟渠","pinyin":"pǐ fù gōu qú","abbr":"pfgq","explanation":"指拘守普通妇女的小节。","source":{"text":"微管仲，吾其被发左衽矣！岂若匹夫匹妇之为谅也，自经于沟渎而莫之知也。","book":"《论语·宪问》"},"example":{"text":"我偷生不为求瓦全，念玉碎，须明声价，怎肯做个～没帐查。","book":"清·李渔《蜃中楼·望洋》"},"similar":["匹夫沟渎"],"usage":"作宾语、定语；用于为人"},{"id":9365,"word":"匹练飞空","pinyin":"pǐ liàn fēi kōng","abbr":"plfk","explanation":"匹练：一匹白绢。一匹白绢在空中飞舞。形容倾泻的瀑布。","source":{"text":"遥观似匹练飞空，远听如千军驰噪。","book":"明·冯梦龙《警世通言》第23卷"},"usage":"作宾语、定语；形容瀑布"},{"id":9366,"word":"匹马一麾","pinyin":"pǐ mǎ yī huī","abbr":"pmyh","explanation":"一匹马一杆旗。形容勇敢善战。","source":{"text":"辽太祖匹马一麾，斥地万里，经营四方，末尝宁居，所至乐从，用此道也。","book":"元·脱脱《辽史》卷五十八"}},{"id":9367,"word":"匹马单枪","pinyin":"pǐ mǎ dān qiāng","abbr":"pmdq","explanation":"原指打仗时一个人上阵。现比喻行动没有人帮助。","source":{"text":"兵散弓残挫虎威，单枪匹马突重围。","book":"五代·楚·汪遵《乌江》诗"},"example":{"text":"汝州南院和尚问：“～来时如何？”师曰：“待我斫棒。”","book":"宋·释道元《景德传灯录》卷十二"},"similar":["单枪匹马"],"opposite":["人多势众"],"usage":"作主语、宾语、定语；比喻独自行动"},{"id":9368,"word":"匹马只轮","pinyin":"pǐ mǎ zhī lún","abbr":"pmzl","explanation":"一匹战马，一只车轮。微不足道的一点兵马装备。","source":{"text":"然而晋人与姜戎要之殽而击之，匹马只轮无反者。","book":"《公羊传·僖公三十三年》"},"example":{"text":"杀得血污溪流，尸横山径，～，一些不曾走漏。","book":"明·冯梦龙《东周列国志》第四十五回"},"usage":"作宾语、主语；指装备少"},{"id":9369,"word":"匹马当先","pinyin":"pǐ mǎ dāng xiān","abbr":"pmdx","explanation":"一马当先。指冲锋在前。","source":{"text":"刀横宇宙三军丧，匹马当先战百合。","book":"元·关汉卿《五侯宴》第三折"},"example":{"text":"呼延灼挺着双鞭，～，众贼军大呼振天，奋勇冲杀。","book":"清·俞万春《荡寇志》第一百三十三回"},"similar":["一马当先"],"usage":"作谓语、宾语、定语；指带头"},{"id":9370,"word":"区区之众","pinyin":"qū qū zhī zhòng","abbr":"qqzz","explanation":"区区：形容少。很少的几个人。","source":{"text":"以区区之众，居二敌之间。","book":"《孔丛子·论势》"},"example":{"text":"吴将军，我等弟兄虽身为大明臣子，奈何大势已去，以我等～，岂能力挽狂澜。","book":"三月夫《吴三贵》八"},"usage":"作宾语；指很少的几个人"},{"id":9371,"word":"区区之心","pinyin":"qū qū zhī xīn","abbr":"qqzx","explanation":"区区；微小。微不足道的一点看法或观点。","source":{"text":"昔范蠡不殉会稽之耻，曹沫不死三败之辱，卒复句践之仇，报鲁国之羞，区区之心，窥慕此耳。","book":"汉·李陵《答苏武书》"},"example":{"text":"微臣今日在此暂避冤仇，～实不敢忘陛下也。","book":"清·俞万春《荡寇志》第八十四回"},"similar":["区区此心"],"usage":"作主语、宾语；用于观点或心意"},{"id":9372,"word":"区区之数","pinyin":"qū qū zhī shù","abbr":"qqzs","explanation":"区区：很少。小小的数目。多用于自谦，比喻数目极少，微不足道。","example":{"text":"～，本人尚可向朋友张罗，不用兄台费心。","book":"姚雪垠《李自成》第二卷第十八章"}},{"id":9373,"word":"区区之见","pinyin":"qū qū zhī jiàn","abbr":"qqzj","explanation":"区区：微小。狭隘的见识。","source":{"text":"前者是备录区区之语，或未尽区区之心，此册乃直述仕鸣所得，反不失区区之见，可见学贵乎自得也。","book":"明·王阳明《与杨仕鸣》"},"example":{"text":"～，算不了啥。","book":"周而复《上海的早晨》四十九"},"usage":"作主语、宾语；用于观点"},{"id":9374,"word":"区区小事","pinyin":"qū qū xiǎo shì","abbr":"qqxs","explanation":"区区：小，少。形容很小很少的小事。","source":{"text":"宋国区区。","book":"《左传·襄公十七年》"},"example":{"text":"～，何足挂齿。"},"usage":"作主语、宾语；指不值一提的小事"},{"id":9375,"word":"区区此心","pinyin":"qū qū cǐ xīn","abbr":"qqcx","explanation":"区区：微小，微薄。常作用谦词。用来形容微不足道的一点心意或想法。亦作“区区之心”。","source":{"text":"昔范蠡不殉会稽之耻，曹沫不死三败之辱，卒复句践之仇，报鲁国之羞，区区之心，窥慕此耳。","book":"汉·李陵《答苏武书》"},"example":{"text":"太子存亡，良玉万难袖手不问。～，想大人十分清楚。","book":"姚雪垠《李自成》第五卷第二十章"},"similar":["区区之心"],"usage":"作主语、宾语；用于观点或心意"},{"id":9376,"word":"区宇一清","pinyin":"qū yǔ yī qīng","abbr":"qyyq","explanation":"区宇：疆土境域。天下一统，国家太平。","source":{"text":"始干戈于爰及，迄文轨之会同，区宇一清，普天均庆。","book":"《元史·伯颜传》"},"usage":"作谓语、定语；指天下太平"},{"id":9377,"word":"区闻陬见","pinyin":"qū wén zōu jiàn","abbr":"qwzj","explanation":"区、陬：角落。见闻不广，学识浅陋。","source":{"text":"目察区陬，司执遗鬼。","book":"汉·张衡《东京赋》"},"example":{"text":"后学小生，～，不得而妄议已。","book":"清·江藩《汉学师承记·朱笥河》"},"similar":["孤陋寡闻"],"usage":"作宾语、主语；用于自谦"},{"id":9378,"word":"医时救弊","pinyin":"yī shí jiù bì","abbr":"ysjb","explanation":"匡正时政的弊病。","source":{"text":"及唐元宗时，宰相姚元崇直奏十事，可以坐销患害，立致升平，惟虑至尊，未能留意。医时救弊 ，无出于斯！","book":"宋·邵伯温·《闻见前录》卷六"},"usage":"作谓语、定语；指治理国家"},{"id":9379,"word":"匿名揭帖","pinyin":"nì míng jiē tiě","abbr":"nmjt","explanation":"揭帖：旧指张贴的启事。指不写自己的名字或不写真实姓名的告人启事。","source":{"text":"凤姐因那一夜不好，悷悷的总没精神，正是惦记铁槛寺的事情。听见外头帖了匿名揭帖的一句话，吓了一跳。","book":"清·曹雪芹《红楼梦》第九十三回"},"example":{"text":"大略一瞧，乃是～，内中所说，无非是刘瑾不法情事，当即饬交刘瑾自阅。","book":"蔡东藩《明史演义》第四十五回"}},{"id":9380,"word":"匿影藏形","pinyin":"nì yǐng cáng xíng","abbr":"nycx","explanation":"隐藏形迹，不露真相。也比喻躲藏起来，不公开活动。","source":{"text":"为君者，藏形匿影，群下无私，掩目塞耳，万民恐震。","book":"《邓析子·无厚篇》"},"example":{"text":"若夫暗藏之汪精卫，则招摇过市，窃据要津；～，深入社会。","book":"毛泽东《向国民党的十点要求》"},"similar":["销声匿迹","无影无踪","鬼鬼祟祟"],"opposite":["出头露面","招摇过市"],"usage":"作谓语、定语；指躲藏起来"},{"id":9381,"word":"匿瑕含垢","pinyin":"nì xiá hán gòu","abbr":"nxhg","explanation":"比喻为长远利益而能包容大度。","source":{"text":"瑾瑜匿瑕，国君含垢。","book":"春秋·鲁·左丘明《左传·宣公十五年》"},"example":{"text":"是以违陛下～之仁，顺皇天震曜杀戮之用。","book":"唐·元稹《论讨贼表》"},"usage":"作谓语、定语；指人大度"},{"id":9382,"word":"匿迹潜形","pinyin":"nì jì qián xíng","abbr":"njqx","explanation":"潜：隐藏。隐藏形迹，不使人知。","source":{"text":"持法清峻，犯之者无宥，有严张之风也。狡吏奸豪，潜形匿迹。","book":"宋·王谠《唐语林·豪爽》"},"example":{"text":"却又喜孜孜～出玉关。","book":"明·徐复祚《红梨记·诛奸》"},"similar":["匿迹隐形","匿影藏形"],"usage":"作谓语、宾语、定语；指隐身"},{"id":9383,"word":"匿迹销声","pinyin":"nì jì xiāo shēng","abbr":"njxs","explanation":"指隐藏起来或不公开露面。","source":{"text":"家生避地，亦到锦江，然畏颖川知之，遂旅游资中郡，销声匿迹，惟恐人知。","book":"宋·孙光宪《北梦琐言》卷十一"},"example":{"text":"黑八歌一干人也劝他，叫他暂时～，等避过风头再作道理。","book":"清·李宝嘉《官场现形记》第二十八回"},"similar":["销声匿迹"],"usage":"作谓语；指隐藏"},{"id":9384,"word":"匿迹隐形","pinyin":"nì jì yǐn xíng","abbr":"njyx","explanation":"隐：隐藏。隐藏形迹，不使人知。","source":{"text":"那厮口内顽涎望着我面上零，再不和他亲折征，我只是吞声忍气，匿迹潜形。","book":"元·高文秀《黑旋风》第一折"},"example":{"text":"师徒们～，不知何日寻得取经人。","book":"明·杨志和《四游记·西游记·观音路降猴妖》"},"similar":["匿迹潜形"],"usage":"作谓语、宾语、定语；指隐身"},{"id":9385,"word":"十万八千里","pinyin":"shí wàn bā qiān lǐ","abbr":"swbql","explanation":"形容相距极远。也形容差距很大。","source":{"text":"问：‘如何是西来意？’师曰：‘十万八千里。’","book":"宋·释道原《景德传灯灵》卷十三"},"example":{"text":"编著历史的人，说那是老袁有意指使的，固有事实相去～。（冯玉祥《我的生活》第十四章）"},"similar":["天差地别"],"opposite":["近在咫尺"],"usage":"作宾语；形容相距极远"},{"id":9386,"word":"十万火急","pinyin":"shí wàn huǒ jí","abbr":"swhj","explanation":"形容事情紧急到了极点（多用于公文、电报等）。","source":{"text":"赵子曰的脑府连发十万火急的电报警告全国。","book":"老舍《赵子曰》"},"example":{"text":"启奏陛下！鸡鹿寨～，羽书传到长安，请圣裁。","book":"曹禺《王昭君》第二幕"},"similar":["急如星火","迫不及待"],"opposite":["慢条斯理"],"usage":"作谓语、宾语、定语；形容事情紧急到了极点"},{"id":9387,"word":"十万火速","pinyin":"shí wàn huǒ sù","abbr":"swhs","explanation":"形容在紧急情况下动作极快地行事。","source":{"text":"我立刻收拾着行李，十万火速地准备出发，就深怕有人要捉拿我的一样。","book":"郭沫若《洪波曲》第二章六"},"usage":"作定语、状语；用于处事"},{"id":9388,"word":"十不当一","pinyin":"shí bù huò yī","abbr":"sbdy","explanation":"十个不抵一个。谓人虽多但不顶用。","source":{"text":"土山平陵，漫衍相属，平原广野，此车骑之地也，步兵十不当一。","book":"汉·荀悦《汉纪·文帝纪下》"},"example":{"text":"后诮杨再思、李峤、姚元崇等曰：‘休璟练知边事，卿辈～。","book":"《新唐书·唐休璟传》"},"opposite":["一以当十"],"usage":"作谓语、定语；用于状态等"},{"id":9389,"word":"十不得一","pinyin":"shí bù dé yī","abbr":"sbdy","explanation":"十件事中，没有一件是成功的。比喻费很大力气也没有收获。","source":{"text":"汉武因恭俭富庶之后，建置朔方，孙弘沮之，十不得一。","book":"《旧唐书·张濬传》"},"example":{"text":"出知单通知所有的翰林，照常办事，但奉召而至的，～。","book":"高阳《慈禧全传》八十三"}},{"id":9390,"word":"十不离九","pinyin":"shí bù lí jiǔ","abbr":"sblj","explanation":"十成中已有了九成。比喻把握很大。","source":{"text":"不然，那厮趋西门最便，何苦绕道过南山，来此关下乎？小弟此请当十不离九。","book":"清·俞万春《荡寇志》第一百六回"}},{"id":9391,"word":"十世单传","pinyin":"shí shì dān chuán","abbr":"ssdc","explanation":"连续十代独子相传。形容极其宝贵。","source":{"text":"他的精神，现在只在一个包上，仿佛抱着一个十世单传的婴儿，别的事情，都已置之度外了。","book":"鲁迅《呐喊·药》"},"usage":"作谓语、定语；用于人等"},{"id":9392,"word":"十世宥之","pinyin":"shí shì yòu zhī","abbr":"ssyz","explanation":"宥：赦罪。指为国立下功绩的人，其千百年后，还要饶恕其犯罪的子孙。","source":{"text":"社稷之固也，犹将十世宥之，以劝能者。","book":"《左传·成公十五年》"},"example":{"text":"固宜世祚大帅，遂荒西土，长为籓镇，誓以河山，后裔纵有栾黡之汰，犹当～。","book":"清·毕沅《续资治通鉴》卷一百五十七回"}},{"id":9393,"word":"十个指头有长短","pinyin":"shí gè zhǐ tóu yǒu cháng duǎn","abbr":"sgztycd","explanation":"比喻人和人是有判别的，不能要求一致。","example":{"text":"当然，～，不能说每一个干部都很好。","book":"周而复《上海的早晨》四十九"}},{"id":9394,"word":"十之八九","pinyin":"shí zhī bā jiǔ","abbr":"szbj","explanation":"比喻有极大的可能性。","source":{"text":"十之八九皆守之以僧，名不正，言不顺，莫此为甚。","book":"清·刘献廷《广阳杂记》第二卷"},"similar":["十有八九"],"usage":"作定语；指有极大的可能性"},{"id":9395,"word":"十二万分","pinyin":"shí èr wàn fēn","abbr":"sewf","explanation":"形容程度极深。","source":{"text":"我们这种倾向十二万分的坚定，例如那布告上也说：‘如有奸民流痞受人诱买勾串，或直受驱使，或假托名义，以图破坏秩序安宁，与构成其他不利于我国家社会之重大犯行者，杀无赦。’","book":"鲁迅《伪自由书·伸冤》"},"example":{"text":"我～的抱歉！不过，小姐的事，我一定帮忙！","book":"老舍《面子问题》第二幕"},"usage":"作定语、状语；用于口语"},{"id":9396,"word":"十二道金牌","pinyin":"shí èr dào jīn pái","abbr":"sedjp","explanation":"宋代凡传递赦书及军事上最紧急的命令，皆用金字牌。后以之作为紧急命令的代称。","source":{"text":"巧了，景王府里堂会戏，贞贝子贞大爷一定要叫他和敷二爷合串《四杰村》，十二道金牌似的把他调了去。","book":"《孽海花》第三十回"},"example":{"text":"昨天从北京传来了～，勒令她火速回去揭发交代问题。","book":"《新华文摘》1982年第1期"},"similar":["十二金牌"],"usage":"作宾语、状语；指十万火急的事情","story":["南宋抗金名将岳飞率领岳家军奋勇北伐，力图恢复宋朝的国土，岳家军奋勇善战，在即将攻进汴京时，被以秦桧为首的投降派一天之内以十二道金牌命令撤军。岳飞深知乘胜追击绝无可能，只好撤军。回京城后被秦桧以“莫须有”的罪名害死"]},{"id":9397,"word":"十二金牌","pinyin":"shí èr jīn pái","abbr":"sejp","explanation":"金牌：宋代敕书及紧急军命，用金字牌，由内侍省派人速送。比喻紧急的命令。","source":{"text":"言飞孤军不可久留，乞令班师。一日奉十二金字牌，飞愤惋泣下。","book":"《宋史·岳飞传》"},"example":{"text":"是人呵，怕他气概。只当得亲捧出～。","book":"明·茅维《闹门神》"},"similar":["十二道金牌","十万火急"],"usage":"作主语、宾语、定语；比喻紧急的命令","story":["南宋抗金名将岳飞率领岳家军奋勇北伐，力图恢复宋朝的国土，岳家军奋勇善战，在即将攻进汴京时，被以秦桧为首的投降派一天之内以十二道金牌命令撤军。岳飞深知乘胜追击绝无可能，只好撤军。回京城后被秦桧以“莫须有”的罪名害死"]},{"id":9398,"word":"十二金钗","pinyin":"shí èr jīn chāi","abbr":"sejc","explanation":"本用以形容美女头上金钗之多，后喻指众多的妃嫔或姬妾。","source":{"text":"头上金钗十二行，足下丝履五文章。","book":"南朝·梁武帝《河中之水歌》"}},{"id":9399,"word":"十五个吊桶打水，七上八下","pinyin":"shí wǔ gè diào tǒng dǎ shuǐ，qī shàng bā xià","abbr":"swgdtdsqsbx","explanation":"比喻心情不安。","source":{"text":"这句话却叫她怎的个答法？所以只急得她心里好像十五个吊桶打水，七上八下。","book":"清·文康《儿女英雄传》第40回"},"example":{"text":"清·文康《儿女英雄传》第40回：“这句话却叫她怎的个答法？所以只急得她心里好像～。”"},"similar":["十五个吊桶打水，七上八落"],"usage":"作宾语、定语；用于口语"},{"id":9400,"word":"十五个吊桶打水，七上八落","pinyin":"shí wǔ gè diào tǒng dǎ shuǐ，qī shàng bā luò","abbr":"swgdtdsqsbl","explanation":"落：下降。比喻心情不安。","source":{"text":"自实心里好像十五个吊桶打水，七上八落似的，身子好像墽盘上蚂蚁，一霎也站脚不住。","book":"明·凌濛初《二刻拍案惊奇》第24卷"},"similar":["十五个吊桶打水，七上八下"],"usage":"作宾语、定语、状语；用于口语"},{"id":9401,"word":"十亲九故","pinyin":"shí qīn jiǔ gù","abbr":"sqjg","explanation":"故：老朋友。形容亲戚朋友很多。","source":{"text":"受千辛万苦，想十亲九故。","book":"元·尚仲贤《柳毅传书》第一折"},"similar":["沾亲带故"],"opposite":["非亲非故"],"usage":"作宾语；形容亲戚朋友很多"},{"id":9402,"word":"十亲九眷","pinyin":"shí qīn jiǔ juàn","abbr":"sqjj","explanation":"指众多亲戚。","source":{"text":"梅氏和善述到来，见十亲九眷都在眼前，一一相见了，也不免说几句求情的话儿。","book":"明·冯梦龙《喻世明言》第十卷"},"example":{"text":"只那刘家～，也就够他周流列国，辙环天下，传食于诸侯了。","book":"《醒世姻缘传》第八回"},"similar":["三姑六婆"],"usage":"作主语、宾语、定语；指亲戚"},{"id":9403,"word":"十人九慕","pinyin":"shí rén jiǔ mù","abbr":"srjm","explanation":"慕：羡慕。十个人见了有九个人羡慕。形容才貌出众，人人羡慕。","source":{"text":"外宅妇十人，见者九人慕。","book":"元·朱德润《乐府》"}},{"id":9404,"word":"十光五色","pinyin":"shí guāng wǔ sè","abbr":"sgws","explanation":"形容景象纷繁，色彩绚丽。","source":{"text":"玉台问字，料理吾乡去。海东云起，十光五色争睹。","book":"清·归懋仪《百字令·答龚璱人公子即和原韵》词"},"similar":["五光十色"],"usage":"作谓语、定语、状语；指色彩丰富"},{"id":9405,"word":"十全十美","pinyin":"shí quán shí měi","abbr":"sqsm","explanation":"十分完美，毫无欠缺。","source":{"text":"岁终，则稽其医事，以制其事，十全为上，十失一次之。","book":"《周礼·天官冢宰下·医师》"},"example":{"text":"新生事物在刚产生时，并不都是～，但总是不断发展壮大，最终是要取代旧事物的。"},"similar":["尽善尽美","完美无缺"],"opposite":["一无是处","一无可取"],"usage":"作谓语、宾语、定语、补语；指完美"},{"id":9406,"word":"十全大补","pinyin":"shí quán dà bǔ","abbr":"sqdb","explanation":"药名，其中含有十种名贵的滋补药物。比喻某项办法、方案对事情有巨大补益。","source":{"text":"这有甚干系，小产不过是气血虚了，‘十全大补汤’一帖下去，补旺了气血，自然好了。","book":"清·西周生《醒世姻缘传》第四回"},"example":{"text":"劝人安贫乐道是古今治国平天下的大经络，开过的方子也很多，但都没有～的功效。","book":"鲁迅《花边文学·安贫乐道法》"},"usage":"作宾语、定语；用于医药等"},{"id":9407,"word":"十八层地狱","pinyin":"shí bā céng dì yù","abbr":"sbcdy","explanation":"层：重。地狱：佛教、基督教等指死后灵魂受苦的地方。迷信认为人在生时为非作恶，死后进入十八层地狱，不得翻身。比喻悲惨的报应。","source":{"text":"分明是十八层地狱的苦鬼，直升到三十三天去了。","book":"明·凌濛初《初刻拍案惊奇》卷三十五：“我赖了你的，我堕十八层地狱。”明·冯梦龙《喻世明言》第九卷"},"example":{"text":"我听斋公们说：打了天上的星宿，阎王就要拿去打一百铁棍，发在～，永不得翻身。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["一十八层地狱"],"usage":"作宾语、定语；指最坏的处境"},{"id":9408,"word":"十八般兵器","pinyin":"shí bā bān bīng qì","abbr":"sbbbq","explanation":"本指刀枪剑戟等十八种古式兵器。后泛指多种武器。亦比喻多种技能。","source":{"text":"若论十八般兵器，我［十三妹］都算拿得起。","book":"清·郭小亭《济公全传》第六十回：“马静一瞧，大殿前摆着家伙，十八般兵器，一应俱全。”清·文康《儿女英雄传》第八回"},"example":{"text":"光靠生产队长一个人就是能耍～，也玩儿不转。","book":"骆宾基《关于饲养员给狗咬伤的问题》一"},"similar":["十八般武艺"],"usage":"作主语、宾语、定语；指多种武器"},{"id":9409,"word":"十八般武艺","pinyin":"shí bā bān wǔ yì","abbr":"sbbwy","explanation":"①使用十八般兵器的本领。亦泛指多种武艺。②比喻多种技能。","source":{"text":"史进每日求王教头点拨十八般武艺，一一从头指教。那十八般武艺？矛锤弓弩铳，鞭锏剑链挝，斧钺并戈戟，牌棒与枪叉。","book":"元·杨梓《敬德不伏老》第一折：“凭着俺十八般武艺，定下了六十四处征尘。”明·施耐庵《水浒传》第二回"},"example":{"text":"假如有人以为我是老作家，必定～样样精通……那就难免捧得越高摔得越疼了。","book":"老舍《学习当先》"},"similar":["十八般兵器"],"usage":"作主语、宾语；指各种技能","story":["梁山泊好汉史进每天求王教头点拨十八般武艺，一一从头学起，这些功夫是矛锤弓弩铳、鞭简剑链挝、斧钺并戈戟、牌棒与枪叉等，经过半年多时间的学习，史进打这十八般武艺从新学得十分精熟。王进把其中的奥妙都全部教给了他"]},{"id":9410,"word":"十八重地狱","pinyin":"shí bā chóng dì yù","abbr":"sbzdy","explanation":"重：层。迷信认为人在生前作恶，死后就要堕入十八重地狱，永民不得翻身。比喻最黑暗、最苦难的境地。","source":{"text":"其后西河离石县有胡人刘萨何遇疾暴亡，而心下犹暖，其家未敢便殡，经十日更苏。说云：‘有两吏见录，向西北行，不测远近，至十八地狱，随报重轻，受诸楚毒。’","book":"《梁书·诸夷传》"},"example":{"text":"又有～，虽然名目各别，总之受罪无私。","book":"元·岳伯川《铁拐李》第三折楔子"}},{"id":9411,"word":"十冬腊月","pinyin":"shí dōng là yuè","abbr":"sdly","explanation":"指阴历十月、十一、十二月天气寒冷的季节。","source":{"text":"头年炕没扒，老冒烟，烧不热，十冬腊月睡着乍凉乍凉的，我那老伴一夜哆嗦到天明，老睡不着……","book":"周立波《暴风骤雨》三"},"example":{"text":"我姐，七岁卖给人家当童养媳，挨打受骂，～只穿一条单裤片，也给折磨死了。","book":"姚雪垠《李自成》第二卷第四十六章"},"usage":"作宾语、定语；指冬天"},{"id":9412,"word":"十十五五","pinyin":"shí shí wǔ wǔ","abbr":"ssww","explanation":"形容分别聚合，多少不等。","source":{"text":"飞来双白鹄，乃从西北来，十十五五，罗列成行。","book":"《乐府诗集·艳歌·何尝行》"},"example":{"text":"清·金农《吴中春雨泊舟入夜寒甚被酒作歌》：“～长短亭，好山对面失洞庭。”"},"usage":"作宾语、定语；用于书面语"},{"id":9413,"word":"十发十中","pinyin":"shí fā shí zhōng","abbr":"sfsz","explanation":"射十次皆中的。形容善射。","source":{"text":"弥善射，常以堋的太阔，曰：‘终日射侯，何难之有。’乃取甘蔗插地，百步射之，十发十中。","book":"《南史·齐高帝诸子传下·宜都王铿传》"},"example":{"text":"《南史·宜都王铿传》：“乃取甘蔗插地，百步射之，～。”"},"similar":["百发百中"],"usage":"作谓语、定语、状语；形容射击技术高明"},{"id":9414,"word":"十变五化","pinyin":"shí biàn wǔ huà","abbr":"sbwh","explanation":"指变化多端。","source":{"text":"世有祝师及诸幻术，犹能履火蹈刃，种瓜移井，倏忽之间，十变五化。","book":"北齐·颜之推《颜氏家训·归心》"},"similar":["变化多端","千变万化"],"opposite":["一成不变"],"usage":"作谓语、宾语、定语；用于变化等"},{"id":9415,"word":"十口相传","pinyin":"shí kǒu xiāng chuán","abbr":"skxc","explanation":"许多人辗转相传。","source":{"text":"于是接连地来了许多十口相传的‘战报’。日本海军司令部已经被我方占领了，上海义勇军下紧急命令了……记也记不清的许多可信可疑的消息。","book":"茅盾《第二天》"},"usage":"作谓语、定语；用于消息等"},{"id":9416,"word":"十命可受","pinyin":"shí mìng kě shòu","abbr":"smks","explanation":"十命：皇帝赐给权臣的九种器物叫九赐，在九赐之外再加一物，称十命，是皇帝对臣下的最高奖赏。比喻功勋卓著，可以领受最高奖赏。","source":{"text":"若灭魏斩叡，帝还故居，与诸子并升，虽十命可受，况于九邪！","book":"《三国志·蜀志·李严传》注引诸葛亮答言书"}},{"id":9417,"word":"十围之木，始生如蘖","pinyin":"shí wéi zhī mù，shǐ shēng rú niè","abbr":"swzmssrn","explanation":"十围：形容极其粗大；蘖：树木的嫩芽。十围粗的大树，初生时只是一棵嫩芽。比喻事物是由小到大逐渐发展起来的。","source":{"text":"夫十围之木，始生如蘖。","book":"《汉书·枚乘传》"}},{"id":9418,"word":"十围五攻","pinyin":"shí wén wǔ gōng","abbr":"swwg","explanation":"兵力超过敌人十倍就可以包围它，超过五倍就可以攻击它。","source":{"text":"故用兵之法，十则围之，五则攻之。","book":"《孙子·谋攻》"},"example":{"text":"兵书之法，～，敌则能战。","book":"《后汉书·袁绍传上》"},"similar":["什围伍攻"],"usage":"作宾语、定语；用于军事"},{"id":9419,"word":"十夫揉椎","pinyin":"shí fū róu zhuī","abbr":"sfrc","explanation":"揉：来回擦或搓；椎：指尖状器具。十个人就把木棒搓成针椎。比喻夸大不实的传闻。","source":{"text":"闻‘三人成虎，十夫揉椎，众口所移，毋翼而飞。’","book":"《战国策·秦策三》"}},{"id":9420,"word":"十夫桡椎","pinyin":"shí fū ráo chuí","abbr":"sfrz","explanation":"比喻人多力大，足以改变原状。同“十夫楺椎”。","source":{"text":"夫众煦漂山，聚蚊成雷，朋党执虎，十夫桡椎。是以文王拘于牖里，孔子厄于陈、蔡。此乃烝庶之风成，增积之生害也。","book":"《汉书·中山靖王刘胜传》"},"similar":["十夫楺椎"],"usage":"作宾语、定语；指人力气大"},{"id":9421,"word":"十夫楺椎","pinyin":"shí fū róu chuí","abbr":"sfrz","explanation":"指十个人的力量能使椎弯曲。椎，槌。比喻人多力大，足以改变原状。","source":{"text":"闻三人成虎，十夫楺椎，众抽所移，毋翼而飞。","book":"《战国策·秦策三》"},"similar":["十夫桡椎"],"usage":"作宾语、定语；指人力气大"},{"id":9422,"word":"十夫榪椎","pinyin":"shí fū zhī zhuī","abbr":"sfzz","explanation":"指十个人的力量能使椎弯曲。椎，槌。比喻人多力大，足以改变原状。"},{"id":9423,"word":"十字打开","pinyin":"shí zì dǎ kāi","abbr":"szdk","explanation":"比喻话说的很清楚或道理讲的很明白。","source":{"text":"孟子十字打开更无隐遁，盖时不同也。","book":"宋·陆九渊《象山集·象山语录上》"},"similar":["八字打开"],"usage":"作谓语、定语；比喻简单明了"},{"id":9424,"word":"十字街口","pinyin":"shí zì jiē kǒu","abbr":"szjk","explanation":"十字街头。","source":{"text":"当下去十字街口，不问军官百姓，杀得尸横遍野，血流成渠。","book":"明·施耐庵《水浒传》第四十回"},"example":{"text":"他急急的跳下车，拉着牲口笼头，赶忙踅过这～，向自己家里走去。","book":"丁玲《太阳照在桑干河上》一"},"similar":["十字路头","十字街头"],"usage":"作主语、宾语；形容大众谋生场所"},{"id":9425,"word":"十字街头","pinyin":"shí zì jiē tóu","abbr":"szjt","explanation":"指纵横交叉、繁华热闹的街道。也借指人世间，现实社会。","source":{"text":"一人在孤峰顶上无出身路，一人在十字街头亦无向背，且道那个在前，那个在后。","book":"宋·释普济《五灯会元·黄檗运禅师法嗣》"},"example":{"text":"其实世界上你所深恶的和期望的，走到～，还不是一样么？（鲁迅《两地书》七八）"},"similar":["十字路口","十字路头"],"opposite":["穷乡僻壤"],"usage":"作主语、宾语；形容大众谋生场所"},{"id":9426,"word":"十字路口","pinyin":"shí zì lù kǒu","abbr":"szlk","explanation":"两条道路交叉的地方。比喻处在对重大事情需要决定怎样选择的境地。","source":{"text":"何以不待其末年，执十字路口，痛与百掴，方为快意。","book":"宋·叶梦得《避暑录话·下·旧说崔慎为瓦棺寺僧后身》"},"example":{"text":"站在歧路上是几乎难于举足，站在～，是可走的道路很多。（鲁迅《华盖集·北京通信》）"},"similar":["十字街头"],"usage":"作主语、宾语；指两条道路交叉的地方"},{"id":9427,"word":"十字路头","pinyin":"shí zì lù tóu","abbr":"szlt","explanation":"道路横直交叉的地方。","source":{"text":"刽子手叫起恶杀都来，恰好午时三刻，将王庆押到十字路头，读罢犯由，如法凌迟处死。","book":"明·施耐庵《水浒传》第一百十回"},"similar":["十字街口","十字街头"],"usage":"作主语、宾语；形容大众谋生场所"},{"id":9428,"word":"十室之邑，必有忠信","pinyin":"shí shì zhī yì，bì yǒu zhōng xìn","abbr":"sszybyzx","explanation":"即使是十户人家的地方，也一定有忠诚信实的人。指处处都有贤人。","source":{"text":"子曰：‘十室之邑，必有忠信如丘者焉，不如丘之好学也。’","book":"语出《论语·公治长》"},"example":{"text":"夫～；三人并行，厥有我师。","book":"《汉书·武帝纪》"},"similar":["十室之邑，必有忠士"],"usage":"作宾语、定语；用于书面语"},{"id":9429,"word":"十室之邑，必有忠士","pinyin":"shí shì zhī yì，bì yǒu zhōng shì","abbr":"sszybyzs","explanation":"指处处都有贤人。同“十室之邑，必有忠信”。","source":{"text":"十步之泽，必有芳草；十室之邑，必有忠士。","book":"汉·刘向《说苑·谈丛》"},"similar":["十室之邑，必有忠信"],"usage":"作宾语、定语；用于书面语"},{"id":9430,"word":"十室九匮","pinyin":"shí shì jiǔ kuì","abbr":"ssjk","explanation":"匮，指财物匮乏。形容因各种自然或社会的原因而造成百姓贫困的景象。","source":{"text":"今高昌诛灭，威动四夷，然自王师始征，河西供役，飞米转刍，十室九匮，五年未可复。","book":"宋·欧阳修《新唐书·西域传上·高昌》"},"similar":["十室九空"],"usage":"作宾语、定语；指灾害、战乱或苛征暴敛"},{"id":9431,"word":"十室九空","pinyin":"shí shì jiǔ kōng","abbr":"ssjk","explanation":"室：人家。十家有九家一无所有。形容人民大量死亡或逃亡后的荒凉景象。","source":{"text":"徐福出而重号淘之仇，赵高入而屯豺狼之党，天下欲反，十室九空。","book":"《抱朴子·用刑》"},"example":{"text":"～，百姓怨嗟，如出一口。","book":"唐·韩愈《黄家贼事宜状》"},"similar":["颠沛流离","家破人亡","流离失所"],"opposite":["人烟稠密","安居乐业"],"usage":"作宾语、定语；指灾害、战乱或苛征暴敛","story":["北宋时期，革新派范仲淹因上书言事而遭贬斥，余靖上书说情也被降职。到了庆历年间，宋仁宗赵祯又任命余靖为右正言谏官。开宝寺灵感塔发生了火灾，有人借机鼓吹迷信而重修灵感塔，余靖上书说：当前西部战事不断，百姓流离失所，十室九空需要安抚"]},{"id":9432,"word":"十室容贤","pinyin":"shí shì róng xián","abbr":"ssrx","explanation":"只有十户人家的小地方也有贤人。","source":{"text":"且十室容贤，而况万里广之！重华生于东夷，文命出乎西羌，圣哲所兴，岂有常地？","book":"《弘明集·正诬论》"},"usage":"作宾语、定语；用于书面语"},{"id":9433,"word":"十家锅灶九不同","pinyin":"shí jiā guō zào jiǔ bù tóng","abbr":"sjgzjbt","explanation":"比喻各有各的想法，各有各的做法，很难求得一致。","source":{"text":"你姓张，他姓李，人多心多，十家锅灶九不同。","book":"李茂荣《人望幸福树望春》"},"similar":["众口难调"],"opposite":["万众一心"],"usage":"作宾语、定语、分句；指很难求得一致"},{"id":9434,"word":"十寒一暴","pinyin":"shí hán yī pù","abbr":"shyb","explanation":"冻十天，晒一天。比喻做事时而抓紧，时而懈怠，进展不快。","source":{"text":"又况人君与宦官宫妾相处之时多，与士大夫相接之时少，十寒一暴，其能自免于过耶？","book":"南宋·葛洪《涉史随笔·齐邹忌讽威王求谏》"},"example":{"text":"就中此宅尤费手，官给工材半佣顾。～半载强，才得安床置铛釜。","book":"金·元好问《戏题新居二十韵》"},"similar":["一暴十寒"],"opposite":["持之以恒"],"usage":"作谓语、定语、宾语；指没有恒心"},{"id":9435,"word":"十年不制衣","pinyin":"shí nián bù zhì yī","abbr":"snbzy","explanation":"十年没有做新衣服。比喻极其贫困。","source":{"text":"曾子居卫，缊袍无表，颜色肿哙，手足胼胝，三日不举火，十年不制衣。","book":"《庄子·让王》"}},{"id":9436,"word":"十年九不遇","pinyin":"shí nián jiǔ bù yù","abbr":"snjby","explanation":"比喻很少有，多年也难遇到一次。","example":{"text":"这是～的机会，你绝不能错过。"},"similar":["千载难逢"],"usage":"作定语；指机会难得"},{"id":9437,"word":"十年九涝","pinyin":"shí nián jiǔ lào","abbr":"snjl","explanation":"形容连年遭水灾。","source":{"text":"禹之时，十年九潦而水弗为加益；汤之时，八年七旱而崖不为加损。","book":"《庄子·秋水》"},"example":{"text":"而～，公私凋弊，深可愍惜。","book":"宋·苏轼《进单锷吴中水利书状》"}},{"id":9438,"word":"十年寒窗","pinyin":"shí nián hán chuāng","abbr":"snhc","explanation":"形容长年刻苦读书。","source":{"text":"古人谓十年窗下无人问，一举成名天下知。","book":"元·刘祁《归潜志》第七卷"},"example":{"text":"那边一个人却愁眉苦脸，发出‘～’付流水的慨叹。","book":"魏巍《路标》"},"similar":["十年窗下","十载寒窗"],"usage":"作宾语、定语；指十年时间闭门苦读"},{"id":9439,"word":"十年树木，百年树人","pinyin":"shí nián shù mù，bǎi nián shù rén","abbr":"snsmbnsr","explanation":"树：培植，培养。比喻培养人才是长久之计。也表示培养人才很不容易。","source":{"text":"一年之计，莫如树谷；十年之计，莫如树木；终身之计，莫如树人。","book":"《管子·权修》"},"example":{"text":"西人都知道～，我们应该把培养人才这件大事抓好。"},"usage":"作宾语、分句；表示培养人才很不易","story":["春秋时期政治家管仲任齐国丞相40多年，帮助齐桓公在经济、政治、军事等方面进行改革，使齐国成为“春秋五霸”之首。他的人才观是：“一年之计，莫如树谷；十年之计，莫如树木；终身之计，莫如树人。”"]},{"id":9440,"word":"十年生聚","pinyin":"shí nián shēng jù","abbr":"snsj","explanation":"比喻培养实力，为报仇雪耻作长期的准备。","source":{"text":"越十年生聚，而十年教训，二十年之外，吴其为沼乎！","book":"春秋·鲁·左丘明《左传·哀公元年》"},"example":{"text":"这个倍受战火摧残的小国，的确需要～，才能谈到复国。"},"similar":["十年生聚，十年教训"],"usage":"作宾语、定语；用于书面语","story":["春秋时期，吴越两国交战，吴王夫差活捉了越王勾践，让勾践到吴国为奴，勾践给吴王进贡美女西施。自己则卧薪尝胆，采用文种的“十年生聚，十年教训”的策略，增加人口，聚积财物，同时勾践还积极发展农业与军事，一举攻占吴国"]},{"id":9441,"word":"十年生聚，十年教训","pinyin":"shí nián shēng jù，shí nián jiào xùn","abbr":"snsjsnjx","explanation":"生聚：繁殖人口，聚积物力；教训：教育，训练。指军民同心同德，积聚力量，发愤图强，以洗刷耻辱。","source":{"text":"越十年生聚，而十年教训，二十年之外，吴其为沼乎！","book":"《左传·哀公元年》"},"similar":["生聚教训"],"usage":"作宾语、分句；用于劝诫人","story":["春秋时期，吴越两国交战，吴王夫差活捉了越王勾践，让勾践到吴国为奴，勾践给吴王进贡美女西施。自己则卧薪尝胆，采用文种的“十年生聚，十年教训”的策略，增加人口，聚积财物，同时勾践还积极发展农业与军事，一举攻占吴国"]},{"id":9442,"word":"十年磨一剑","pinyin":"shí nián mó yī jiàn","abbr":"snmyj","explanation":"用十年时间磨一把好剑。比喻多年刻苦磨练。","source":{"text":"十年磨一剑，霜刃未曾试。今日把似君，谁为不平事？","book":"唐·贾岛《剑客》诗"}},{"id":9443,"word":"十年磨剑","pinyin":"shí nián mó jiàn","abbr":"snmj","explanation":"比喻多年刻苦磨练。","source":{"text":"十年磨一剑，霜刃未曾试。今日把似君，谁为不平事？","book":"唐·贾岛《剑客》诗"},"example":{"text":"～，五陵结客，把平生涕泪都飘尽。","book":"清·朱彝尊《解珮令·自题词集》"},"usage":"作谓语、定语；指刻苦磨练"},{"id":9444,"word":"十年窗下","pinyin":"shí nián chuāng xià","abbr":"sncx","explanation":"科举时代，读书人要取得功名，终年埋头在书本里。形容十年时间闭门苦读。","source":{"text":"古人谓十年窗下无人问，一举成名天天下知。","book":"元·刘祁《归潜志》卷七"},"example":{"text":"虽是～无人比，稳情取一举成名天下知。（元·关汉卿《裴度还带》第二折）"},"similar":["十年寒窗"],"usage":"作宾语、定语；指十年时间闭门苦读"},{"id":9445,"word":"十年读书","pinyin":"shí nián dú shū","abbr":"snds","explanation":"指长期努力于学业。","source":{"text":"攸之晚好读书，手不释卷，《史》、《汉》多所谙忆，常叹曰：‘早知穷达有命，恨不十年读书。’","book":"《宋书·沈攸之传》"},"example":{"text":"他发奋“～”，长期钻研学问。"},"similar":["十年寒窗"],"usage":"作谓语、宾语；指刻苦读书","story":["南北朝时期，刘宋朝廷内部发生争斗，导致骨肉相残，忠良贤臣被害，人们整天提心吊胆。大臣沈攸之时受信任为忠臣，时而遭排挤成逆贼。他心灰意冷，就潜心攻读《史记》、《汉书》，经常感慨地说：“早知穷达有命，恨不十年读书。”"]},{"id":9446,"word":"十恶不赦","pinyin":"shí è bù shè","abbr":"sebs","explanation":"指罪恶极大，不可饶恕。","source":{"text":"这药死公公的罪名，犯在十恶不赦。","book":"《隋书·刑法志》：“又列重罪十条：……其犯此十者，不在八议论赎之限。”元·关汉卿《窦娥冤》第四折"},"example":{"text":"这个暴徒，拦路抢劫，谋财害命，真是～。"},"similar":["罪大恶极","罪该万死"],"opposite":["罚不当罪","立功赎罪"],"usage":"作谓语、定语；指罪恶极大"},{"id":9447,"word":"十恶五逆","pinyin":"shí è wǔ nì","abbr":"sewn","explanation":"指种种不可赦免的大罪。","source":{"text":"嫂嫂也，我不曾犯十恶五逆，这一个家缘儿都被你收拾。","book":"元·无名氏《杀狗劝夫》第二折"},"example":{"text":"乃至见他～，亦将我心置他胸魁祸首。","book":"清·龚自珍《发大心文》"},"similar":["大逆不道","罪大恶极"],"usage":"作主语、宾语、定语；指罪名"},{"id":9448,"word":"十成九稳","pinyin":"shí chéng jiǔ wěn","abbr":"scjw","explanation":"指相当稳妥可靠。","source":{"text":"我则道嫁良人十成九稳，今日个越不见末尾三稍。","book":"元·李行道《灰阑记》第二折"},"example":{"text":"这件事情已经是～的了。"},"similar":["十拿九稳"],"usage":"作宾语、定语；指有很大的把握"},{"id":9449,"word":"十战十胜","pinyin":"shí zhàn shí shèng","abbr":"szss","explanation":"指每战必胜。","source":{"text":"以能击不能，以教卒、教士击驱众、白徒，故十战十胜，百战百胜。","book":"《管子·七法》"},"example":{"text":"先得此龟者为天子，且十言十当，～。","book":"《史记·龟策列传》"},"similar":["百战百胜"],"usage":"作谓语、定语；形容善于作战，所向无敌"},{"id":9450,"word":"十手争指","pinyin":"shí shǒu zhēng zhǐ","abbr":"sszz","explanation":"指人如有不善，众人则争相指责。","source":{"text":"十目所视，十手所指，其严乎！","book":"语出《礼记·大学》"},"example":{"text":"《新唐书·柳沘传》：“实艺懿行，人未必信；纤瑕微累，～矣。”"},"usage":"作谓语、定语；用于处事"},{"id":9451,"word":"十拏九稳","pinyin":"shí mù jiǔ wěn","abbr":"snjw","explanation":"比喻很有把握。同“十拿九稳”。"},{"id":9452,"word":"十拷九棒","pinyin":"shí kǎo jiǔ bàng","abbr":"skjb","explanation":"指严刑拷打。","source":{"text":"待要你十拷九棒，万死千生，打杀这个射粮军，哥也，你可甚么那得甚福。","book":"元·郑廷玉《包待制》第二折"},"usage":"作谓语、宾语；用于书面语"},{"id":9453,"word":"十拿九准","pinyin":"shí ná jiǔ zhǔn","abbr":"snjz","explanation":"比喻很有把握。","source":{"text":"此是十拿九稳，必中的计较。","book":"明·阮大铖《燕子笺·购幸》"},"example":{"text":"要是他当面应承喽，就～啦。","book":"李英儒《野火春风斗古城》第二十二章"}},{"id":9454,"word":"十拿九稳","pinyin":"shí ná jiǔ wěn","abbr":"snjw","explanation":"比喻很有把握。","source":{"text":"此是十拿九稳，必中的计较。","book":"明·阮大铖《燕子笺·购幸》"},"example":{"text":"他的学习成绩非常好，考大学应当是～的事。"},"similar":["万无一失","稳操胜券","稳拿把纂"],"opposite":["漏洞百出","破绽百出"],"usage":"作谓语、定语、宾语、状语；指很有把握"},{"id":9455,"word":"十拿十稳","pinyin":"shí ná shí wěn","abbr":"snsw","explanation":"比喻完全有把握。","source":{"text":"既是天尊显圣，将来生子是十拿十稳的了。","book":"清·张南庄《何典》第一回"},"example":{"text":"如果自己能把这差使弄到手，请这位老将随军参议，那还不是～的大功一件！","book":"二月河《乾隆皇帝》八"},"similar":["十拿九稳"],"usage":"作谓语、定语、宾语、状语；指很有把握"},{"id":9456,"word":"十指不沾泥","pinyin":"shí zhǐ bù zhān ní","abbr":"szbzn","explanation":"十个指头没有沾泥土。意思是从来没干过农活。","source":{"text":"陶尽门前土，屋上无片瓦。十指不沾泥，鳞鳞居大厦。","book":"宋·梅圣俞《陶者》"},"example":{"text":"吾生～，毛锥便得傲蓑衣。","book":"宋·杨万里《晚春行田南原》"}},{"id":9457,"word":"十指如椎","pinyin":"shí zhǐ rú chuí","abbr":"szrc","explanation":"形容手指粗笨不纤巧。","source":{"text":"今日舟中无他事，十指如悬椎。","book":"宋·苏轼《答贾耘老四首》"}},{"id":9458,"word":"十指有长短","pinyin":"shí zhǐ yǒu cháng duǎn","abbr":"szycd","explanation":"形容十指作用灵巧。亦比喻同出的子女各不相同。","source":{"text":"寸心十指有长短，妙入神处无人知。","book":"唐·顾况《李湖州孺人弹筝歌》"},"example":{"text":"莫以胡儿可羞耻，恩情亦各言其子；手中～，截之痛惜皆相似。","book":"唐·刘商《胡笳十八拍》诗"},"usage":"作宾语、定语；用于口语"},{"id":9459,"word":"十指纤纤","pinyin":"shí zhǐ xiān xiān","abbr":"szxx","explanation":"十指：指双手；纤纤：细巧。旧时形容妇女的手细巧而柔美。","source":{"text":"娥娥红粉妆，纤纤出素手。","book":"《古诗十九首》之三"},"example":{"text":"～玉笋红，雁行轻遏翠弦中。","book":"唐·张祜《题宋州田大夫家乐丘家筝》"}},{"id":9460,"word":"十指连心","pinyin":"shí zhǐ lián xīn","abbr":"szlx","explanation":"十个指头连着心。表示身体的每个小部分都跟心有不可分的关系。比喻亲人跟自身休戚相关。","source":{"text":"十指连心，可怜昏死在地。","book":"明·许仲琳《封神演义》第七回"},"example":{"text":"焚烧～痛，图得三生见面圆。（明·汤显祖《南柯记·情尽》）"},"similar":["休戚相关"],"usage":"作定语、宾语；比喻亲人跟自身休戚相关"},{"id":9461,"word":"十指露缝","pinyin":"shí zhǐ lù fèng","abbr":"szlf","explanation":"北方口语，意思是毛病露出来，掩盖不住了。","example":{"text":"他这一来，大伙心里有仰仗，坏蛋都～了。","book":"周立波《暴风骤雨》第二部四"}},{"id":9462,"word":"十捉九着","pinyin":"shí zhuō jiǔ zháo","abbr":"szjz","explanation":"比喻十分有把握。","source":{"text":"端的强如孙武子教女兵，十捉九着。","book":"明·施耐庵《水浒全传》第二十四回"},"similar":["十拿九稳"],"usage":"作谓语、定语、宾语、状语；指很有把握"},{"id":9463,"word":"十斛量珠","pinyin":"shí hú liáng zhū","abbr":"shlz","explanation":"斛：口小底大的方形量器，容量本为十斗，后改为五斗。指以重金购买美女为妾。","source":{"text":"侯门枉说深于海，繁花此时何处？十斛量珠，千丝结网，选得闲房如许。","book":"清·丁兆宽《台城路》"},"example":{"text":"纵然你对这位嫂夫人，不免～，你所得的，恐怕也不止一副泪痕。","book":"张恨水《金粉世家》第一百三回"}},{"id":9464,"word":"十日一水，五日一石","pinyin":"shí rì yī shuǐ，wǔ rì yī shí","abbr":"sryswrys","explanation":"比喻作画构思精密，不轻易下笔。","source":{"text":"十日画一水，五日画一石，能事不受相促迫，王宰始肯留真迹。","book":"唐·杜甫《戏题王宰画山水图歌》"},"example":{"text":"画家一般都讲究～的画风。"},"usage":"作定语、宾语、分句；用于绘画"},{"id":9465,"word":"十日之饮","pinyin":"shí rì zhī yǐn","abbr":"srzy","explanation":"比喻朋友连日尽情欢聚。","source":{"text":"寡人闻君之高义，愿与君为布衣之友，君幸过寡人，寡人愿与君为十日之饮。","book":"西汉·司马迁《史记·范雎蔡泽列传》"},"example":{"text":"新年略有俗务，三四日后，自当敬造高斋，为平原～。","book":"清·吴敬梓《儒林外史》第11回"},"usage":"作宾语；指朋友聚会"},{"id":9466,"word":"十日并出","pinyin":"shí rì bìng chū","abbr":"srbc","explanation":"①古代神话传说天本有十个同时出现的太阳。②比喻暴乱并起。","source":{"text":"逮至尧之时，十日并出，焦禾稼，杀草木，而民无所食。","book":"《庄子·齐物论》：“昔者十日并出，万物皆照，而况德之进乎日这乎！”《淮南子·本经训》"},"example":{"text":"九婴暴起，～。心穷填海，力尽移山。原轸之归元如生，霁云之断指犹动。","book":"清·钱谦益《〈陈乔山诗集〉序》"},"usage":"作宾语、定语；用于比喻句"},{"id":9467,"word":"十日饮","pinyin":"shí rì yǐn","abbr":"sry","explanation":"比喻朋友连日尽情欢聚。","source":{"text":"寡人闻君之高义，愿与君为布衣之友，君幸过寡人，寡人愿与君为十日饮。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"相呼～，不负百年身。","book":"宋·陆游《对酒作》诗"}},{"id":9468,"word":"十旬四职","pinyin":"shí xún sì zhí","abbr":"sxsz","explanation":"旬：十天。一百天高升了四次。形容仕途非常顺利。","source":{"text":"曾未十旬，遂迁四职，缙绅以为荣。","book":"《周书·周瑾传》"}},{"id":9469,"word":"十月怀胎","pinyin":"shí yuè huái tāi","abbr":"syht","explanation":"比喻事情成熟需要足够的时间。","source":{"text":"调查就像‘十月怀胎’，解决问题就像‘一朝分娩’。调查就是解决问题。","book":"毛泽东《反对本本主义》"},"example":{"text":"我们要理解女性～的辛苦。"},"similar":["身怀六甲"],"usage":"作宾语、定语；用于母亲"},{"id":9470,"word":"十有八九","pinyin":"shí yǒu bā jiǔ","abbr":"sybj","explanation":"指绝大多数，大致不差，差不离。","source":{"text":"土风坐男使女立，男当门户女出入。十有八九负薪归，卖薪得钱应供给。","book":"唐·杜甫《负薪行》"},"example":{"text":"阿爷，此猜～，姐姐只为许了个盲子，心中不乐，时时流泪。","book":"明·凌濛初《初刻拍案惊奇》第12卷"},"similar":["十之八九"],"usage":"作定语；指有极大的可能性"},{"id":9471,"word":"十样锦","pinyin":"shí yàng jǐn","abbr":"syj","explanation":"原指十种锦绣。后指杂取各种不同样式、颜色的物品搭配在一起。也用以形容十不全。","source":{"text":"蜀时制十样锦，名：长安竹、天下乐、雕团、宜男、宝界地、方胜、狮团、象眼、八搭韵、铁梗蘘荷。","book":"元·戚辅之《佩楚轩客谈》"},"example":{"text":"我有一方大红～缎子，也照依姐姐描恁一双儿。","book":"明·兰陵笑笑生《金瓶梅词话》第二十九回"}},{"id":9472,"word":"十步之内，必有芳草","pinyin":"shí bù zhī nèi，bì yǒu fāng cǎo","abbr":"sbznbyfc","explanation":"比喻处处都有人才。","source":{"text":"汉·刘向《说苑·谈丛》：“十步之泽，必有香草；十室之邑，必有忠士。”《隋书·炀帝纪上》：“方今宇宙平一，文轨攸同，十步之内，必有芳草，四海之中，岂无奇秀！”。"},"example":{"text":"‘～’，广大群众是人才的源泉。","book":"《解放日报》1942.8.26"},"similar":["十步芳草","十步之内，自有芳草"],"usage":"作宾语、定语；指处处都有人才"},{"id":9473,"word":"十步之内，自有芳草","pinyin":"shí bù zhī nèi，zì yǒu fāng cǎo","abbr":"sbznzyfc","explanation":"比喻处处都有人才。同“十步之内，必有芳草”。","source":{"text":"老将军，岂不知，十步之内，自有芳草。","book":"京剧《将相和》第五场"},"example":{"text":"京剧《将相和》第五场：“老将军，岂不知，～。”"},"similar":["十步芳草","十步之内，必有芳草"],"usage":"作宾语、定语；指处处都有人才"},{"id":9474,"word":"十步之泽，必有芳草","pinyin":"shí bù zhī zé，bì yǒu fāng cǎo","abbr":"sbzzbyfc","explanation":"芳草：比喻人才。十步之内，就有芳香的花草。比喻处处都有人才。","source":{"text":"十步之泽，必有香草，十室之邑，必有忠士。","book":"汉·刘向《说苑·谈丛》"}},{"id":9475,"word":"十步九回头","pinyin":"shí bù jiǔ huí tóu","abbr":"sbjht","explanation":"形容恋恋不舍。后用于比喻犹豫不定。","source":{"text":"他那里，谩骂凝眸，正是马行十步九回头。","book":"元·高明《琵琶记·伯喈夫妻分别》"},"example":{"text":"先前那样～的作文法是很不对的，之就是在不断的不相住自己——结果一定做不成。","book":"鲁迅《书信集·致叶紫》"},"usage":"作谓语、定语；用于处事等"},{"id":9476,"word":"十步芳草","pinyin":"shí bù fāng cǎo","abbr":"sbfc","explanation":"芳草：香草。十步之内，就有芳香的花草。比喻处处都有人才。","source":{"text":"夫十步之间，必有茂草；十室之邑，必有俊士。","book":"汉·刘向《说苑·谈丛》：“十步之泽，必有香草；十室之邑，必有忠士。”汉·王符《潜夫论·实贡》"},"example":{"text":"方今宇宙平一，文轨攸同，～，四海之中，岂无奇秀。","book":"《隋书·断帝纪上》"},"similar":["十步之内，必有芳草"],"usage":"作宾语、定语；指处处都有人才","story":["唐朝初年，唐太宗十分重视选拔人才，他吩咐右仆射封德彝推荐人才，封德彝没有完成使命。唐太宗教诲他：十步之内，必有芳草，关键看你能否发现他们，用人就要用他们的长处。封德彝点头称是，于是给唐太宗推荐了很大人才"]},{"id":9477,"word":"十步香草","pinyin":"shí bù xiāng cǎo","abbr":"sbxc","explanation":"比喻处处都有人才。","source":{"text":"十步之泽，必有香草，十室之邑，必有忠士。","book":"汉·刘向《说苑·谈丛》"},"similar":["十步芳草"],"usage":"作宾语、定语；指处处都有人才"},{"id":9478,"word":"十步香车","pinyin":"shí bù xiāng chē","abbr":"sbxc","explanation":"比喻处处都有人才。"},{"id":9479,"word":"十死一生","pinyin":"shí sǐ yī shēng","abbr":"ssys","explanation":"形容生命非常危险。","source":{"text":"爱好有实，已诺可期，十死一生，彼必将至。","book":"汉·贾谊《新书·匈奴》"},"example":{"text":"臣老矣，今向岭南，～。","book":"宋·司马光《资治通鉴·唐则天后长安三年》"},"similar":["九死一生"],"usage":"作谓语、定语；形容生命非常危险"},{"id":9480,"word":"十死不问","pinyin":"shí sǐ bù wèn","abbr":"ssbw","explanation":"指即使犯十次死罪也予宽恕。","source":{"text":"孝昭赐赵郡王十死不问，王喜曰：‘皇甫玉相臣，云当恶死，今复何虑？’","book":"《北史·艺术上·皇甫玉》"},"usage":"作宾语、定语；用于书面语"},{"id":9481,"word":"十死之地","pinyin":"shí sǐ zhī dì","abbr":"sszd","explanation":"处于极其危险的境地。","source":{"text":"武王曰：‘十死之地，奈何？’","book":"《六韬·犬韬·战车》"}},{"id":9482,"word":"十死九活","pinyin":"shí sǐ jiǔ huó","abbr":"ssjh","explanation":"形容难以幸存。","source":{"text":"降者三万人，除那逃走脱的，其余都是十死九活，七损八伤，颠翻在地，被人马践踏，骨肉如泥的，不计其数。","book":"明·施耐庵《水浒传》第一百九回"},"similar":["十死九生"],"usage":"作宾语、定语；用于书面语"},{"id":9483,"word":"十死九生","pinyin":"shí sǐ jiǔ shēng","abbr":"ssjs","explanation":"犹十死一生。形容生命非常危险。","source":{"text":"褒衣大带，掌幄中之论，无十死九生冒之危。","book":"宋·叶適《厉领卫墓志铭》"},"example":{"text":"小姐已是～，只多得一口气了。","book":"《二刻拍案惊奇》卷二九"}},{"id":9484,"word":"十法九例","pinyin":"shí fǎ jiǔ lì","abbr":"sfjl","explanation":"十种法律倒有九种是民间的成例。","source":{"text":"那是个例子，常言道：十法九例，无例不成法。","book":"明·罗懋登《三保太监下西洋记》第二十一回"}},{"id":9485,"word":"十浆五馈","pinyin":"shí jiāng wǔ kuì","abbr":"sjwk","explanation":"十家卖浆者之中有五家争先送来。本指卖浆者争利，后用以比喻争相设宴款待。","source":{"text":"子列子之齐，中道而反，遇伯昏瞀人。伯昏瞀人曰：‘奚方而反？’曰：‘吾惊焉。’‘恶乎惊？’‘吾食于十浆，而五浆先馈。’","book":"典出《列子·黄帝》"},"example":{"text":"宋·苏轼《祭徐君猷文》：“争席满前，无复～；中流获济，实赖一壶之千金。”"},"usage":"作宾语、定语；用于书面语","story":["战国时期，子列子去齐国，到中途就折返，遇到伯昏瞀人。伯昏瞀人问他为什么这么快就返回了？子列子说他受惊了。伯昏瞀人问为什么受惊，子列子说他到一个地方十家酒店有五家争相宴请他，只好返回了"]},{"id":9486,"word":"十清九浊","pinyin":"shí qīng jiǔ zhuó","abbr":"sqjz","explanation":"指混乱不堪。","source":{"text":"随你有万分不是处，也只得依顺了他。所以那家庭间每每被这等人，吵得十清九浊。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"usage":"作定语、状语；用于书面语"},{"id":9487,"word":"十生九死","pinyin":"shí shēng jiǔ sǐ","abbr":"ssjs","explanation":"形容历尽艰险。","source":{"text":"十生九死到官所，幽居默默如藏逃。","book":"唐·韩愈《八月十五赠张功曹》诗"},"example":{"text":"只怕象前番哄他，那张生被你哄得～。","book":"明·崔时佩《西厢记·回春柬药》"},"similar":["九死一生"],"usage":"作谓语、宾语；形容历尽艰险"},{"id":9488,"word":"十病九痛","pinyin":"shí bìng jiǔ tòng","abbr":"sbjt","explanation":"形容身体衰弱，浑身病痛。","source":{"text":"便是老身十病九痛，怕有些山高水低，预先要制办些送终衣服。","book":"明·施耐庵《水浒全传》第二十四回"},"example":{"text":"如今我的身子是～的，你二嫂子也是三日好两日不好。","book":"清·曹雪芹《红楼梦》第一百二回"},"similar":["七病八痛"],"usage":"作宾语、定语；指身体衰弱"},{"id":9489,"word":"十目十手","pinyin":"shí mù shí shǒu","abbr":"smss","explanation":"十个人看着你，十只手指着你。形容一个人的言行举止，离不开众人的监督。","source":{"text":"曾子曰：‘十目所视，十手所指，其严乎。’","book":"《礼记·大学》"},"example":{"text":"一死一生，足累久长之福；～，具知来历之非。","book":"宋·陈亮《谢郑侍郎启》"}},{"id":9490,"word":"十目所视","pinyin":"shí mù suǒ shì","abbr":"smss","explanation":"指个人的言论行动总是在群众的监督之下，不允许做坏事，做了也不可能隐瞒。同“十目所视，十手所指”。","source":{"text":"十目所视，十手所指，其严乎。","book":"西汉·戴圣《礼记·大学》"},"example":{"text":"‘～，十手所指’，大家都学习了，了解了，就不容许干部乱干了，对整个领导都有好处。","book":"邓小平《在西南区新闻工作会议上的报告》"},"similar":["十目所视，十手所指"],"usage":"作宾语、定语；用于口语"},{"id":9491,"word":"十目所视，十手所指","pinyin":"shí mù suǒ shì，shí shǒu suǒ zhǐ","abbr":"smsssssz","explanation":"很多眼看着，很多只手在指着。指个人的言论行动总是在群众的监督之下，不允许做坏事，做了也不可能隐瞒。","source":{"text":"曾子曰：‘十目所视，十手所指，其严乎。’","book":"《礼记·大学》"},"example":{"text":"这谭绍闻也觉得今日～，心中老大的不安。","book":"清·李绿园《歧路灯》第二十一回"},"similar":["十目所视"],"usage":"作宾语、分句；指在众人的监察之下"},{"id":9492,"word":"十相俱足","pinyin":"shí xiàng jù zú","abbr":"sxjz","explanation":"形容妇女姿色极佳。","source":{"text":"假如譬喻说，一个财主家，虽然十相俱足，一日有多少闲事恼心，夜间又被钱物挂念。","book":"明·施耐庵《水浒全传》第四十五回"},"example":{"text":"好个～的小娘子，恨不曾访问他居止姓名。","book":"明·冯梦龙《警世通言》卷三十"}},{"id":9493,"word":"十眠九坐","pinyin":"shí mián jiǔ zuò","abbr":"smjz","explanation":"时躺时坐。形容病体难支。","source":{"text":"初时父子坐店甚好，后因十老得了腰痛的病，十眠九坐，劳碌不得，另招个伙计，叫做邢权，在店相帮。","book":"明·冯梦龙《醒世恒言》第三卷"}},{"id":9494,"word":"十磨九难","pinyin":"shí mó jiǔ nàn","abbr":"smjn","explanation":"指不断遭受的磨难。","example":{"text":"要想成功大都要经过～的。"},"opposite":["一帆风顺"],"usage":"作宾语、定语；指不断遭受的磨难"},{"id":9495,"word":"十米九糠","pinyin":"shí mǐ jiǔ kāng","abbr":"smjk","explanation":"饭食中多糠。形容穷苦。","source":{"text":"拚着个十米九糠，问甚么两妇三妻，受了些万苦千辛。","book":"元·关汉卿《救风尘》第三折"},"usage":"作宾语、定语；用于生活等"},{"id":9496,"word":"十羊九牧","pinyin":"shí yáng jiǔ mù","abbr":"syjm","explanation":"十头羊倒用九个人放牧。比喻官多民少，赋税剥削很重。也比喻使令不一，无所适从。","source":{"text":"所谓民少官多，十羊九牧。","book":"《隋书·杨尚希传》"},"example":{"text":"杨伭公则云必须直词，宗尚书则云宜多隐恶，～，其令难行。","book":"唐·刘知几《史通·叙事》"},"similar":["僧多粥少","人浮于事"],"usage":"作定语、补语；指多头领导","story":["北周后期，隋文帝取代北周政权后，恢复汉制，把国土重新划分成很小的郡县进行管辖，造成官员成倍地增加。杨尚希对此忧心忡忡，看到每年开销急剧增加就上书隋文帝要改变这十羊九牧的局面。隋文帝采纳了建议，取得了很好的效果"]},{"id":9497,"word":"十荡十决","pinyin":"shí dàng shí jué","abbr":"sdsj","explanation":"形容多次冲击，每次都能冲破敌阵。","source":{"text":"丈八蛇矛左右盘，十荡十决无当前。","book":"《乐府诗集·杂歌谣辞·陇上歌》"},"usage":"作谓语、宾语；用于书面语"},{"id":9498,"word":"十行俱下","pinyin":"shí háng jù xià","abbr":"shjx","explanation":"眼睛一瞥就能看下十行文字。形容读书极快。","source":{"text":"读书十行俱下，九流百氏，经目必记。","book":"《梁书·简文帝纪》"},"example":{"text":"兼爱文学，读书敏速，～。","book":"《北齐书·河南康舒王孝瑜传》"},"similar":["一目十行"],"usage":"作谓语、定语；形容读书极快","story":["南朝梁武帝萧衍的第三个儿子萧纲从小聪明伶俐，记忆力很强。他读书的速度相当快，能够十行同时阅读下去，而且能够做到过目不忘。11岁时就博览群书，写诗赋文章得心应手。因此被任命为宣惠将军，丹阳尹"]},{"id":9499,"word":"十袭珍藏","pinyin":"shí xí zhēn cáng","abbr":"sxzc","explanation":"十袭：把物件一层层裹起来。形容很珍重地收藏。","source":{"text":"十袭珍藏，但誓传家而永宝。","book":"宋·欧阳修《庙赐汉书表》"},"example":{"text":"宣义大骇，晓得件奇宝，唤将银匠来，把白金铸了外层，将锦绮做了包袱～。","book":"明·凌濛初《二刻拍案惊奇》卷十九"}},{"id":9500,"word":"十谒朱门九不开","pinyin":"shí yè zhū mén jiǔ bù kāi","abbr":"syzmjbk","explanation":"谒：拜见；朱门：权贵之门。指向权贵人家求助，经常被拒绝。","source":{"text":"又不会巧言令色，况兼今日十谒朱门九不开。","book":"元·马致远《荐福碑》第三折"},"example":{"text":"眼见得一家受尽千般苦，可怎么～，委实难捱。","book":"明·凌濛初《初刻拍案惊奇》卷三十五"}},{"id":9501,"word":"十转九空","pinyin":"shí zhuǎn jiǔ kōng","abbr":"szjk","explanation":"十次去九次空着手回来。形容赌博经常输钱。","source":{"text":"岂知家私有数，经不得十转九空，似此三年，渐渐凋耗。","book":"明·凌濛初《初刻拍案惊奇》卷十二"},"usage":"作宾语、定语；用于口语"},{"id":9502,"word":"十载寒窗","pinyin":"shí zǎi hán chuāng","abbr":"szhc","explanation":"载：年。指长期苦读。","source":{"text":"十载寒窗积雪余，读得人间万卷书。","book":"元·石子章《竹坞听琴》第三折"},"example":{"text":"有些人也算～，铁砚都磨穿了，哪样圣贤的话，没有读到四五百遍？","book":"艾芜《手》"},"similar":["十年寒窗"],"usage":"作宾语、定语；指十年时间闭门苦读"},{"id":9503,"word":"十部从事","pinyin":"shí bù cóng shì","abbr":"sbcs","explanation":"形容辅助官吏很多。","source":{"text":"得刘公一纸书，贤于十部从事也。","book":"《三国志·魏志·刘馥传》裴松之注引《晋阳秋》"}},{"id":9504,"word":"十里无真言","pinyin":"shí lǐ wú zhēn yán","abbr":"slwzy","explanation":"远处传来的消息不可轻信。","source":{"text":"十里无真言，总是越传越玄。","book":"黎汝青《叶秋红》"},"usage":"作定语、分句；指不要盲目轻信"},{"id":9505,"word":"十里洋场","pinyin":"shí lǐ yáng chǎng","abbr":"slyc","explanation":"旧指洋人较多的地方。多形容旧时的上海。","source":{"text":"我们这十里洋场实在还不过是畸形的殖民地化的资本主义社会。","book":"茅盾《健美》"},"example":{"text":"茅盾《健美》：“我们这～实在还不过是畸形的殖民地化的资本主义社会。”"},"usage":"作宾语、定语；指上海"},{"id":9506,"word":"十里长亭","pinyin":"shí lǐ cháng tíng","abbr":"slct","explanation":"秦汉时每十里设置一亭，以后每五里有一短亭，供行人何处，亲友远行常在此话别。","source":{"text":"十里一长亭，五里一短亭。","book":"《白孔六帖》卷九"},"example":{"text":"今日送张生赴京，红娘，快催小姐，同去～。","book":"元·王实甫《西厢记》第四本第三折"},"usage":"作宾语、定语；指送别"},{"id":9507,"word":"十雨五风","pinyin":"shí yǔ wǔ fēng","abbr":"sywf","explanation":"十天下一场雨，五天刮一次风。谓风调雨顺。","source":{"text":"上扶邦国，傍祐黎元。调十雨五风以登稼穑，普九州六合以致雍熙。","book":"前蜀·杜光庭《画五岳诸神醮词》"},"example":{"text":"南丰诗将驻灵江。下明光。惹天香。～，连岁致丰穰。","book":"宋·曹勋《江神子/江城子》诗"},"similar":["十风五雨","风调雨顺"],"usage":"作定语、宾语；形容风调雨顺"},{"id":9508,"word":"十面埋伏","pinyin":"shí miàn mái fú","abbr":"smmf","explanation":"设伏兵于十面以围歼敌军。指周围布置了重重埋伏。","source":{"text":"从今后跳出了九重围子连环寨，脱离了十面埋伏大会垓。","book":"元·无名氏《抱妆盒》第二折"},"example":{"text":"操与诸将商议破绍之策，程昱献～之计。","book":"明·罗贯中《三国演义》第三十一回"},"similar":["四面楚歌"],"usage":"作谓语、定语；指设伏兵于十面以围歼","story":["楚汉相争时期，汉王刘邦重用淮阴人韩信，先后活捉魏王豹、赵王歇、燕王藏荼、齐王田广。他被刘邦封为齐王后率30万大军和彭越的军队会师，把项羽围困在垓下，他采取十面埋伏的战术，逼使项羽在乌江自刎，取得决定性的胜利"]},{"id":9509,"word":"十风五雨","pinyin":"shí fēng wǔ yǔ","abbr":"sfwy","explanation":"十天一刮风，五天一下雨。形容风调雨顺，气候适宜。","source":{"text":"风不鸣条，雨不破块，五日一风，十日一雨。","book":"汉·王充《论衡·是应》"},"example":{"text":"斗酒只鸡人笑乐，～岁丰穰。","book":"宋·陆游《村居初夏》诗"},"similar":["风调雨顺","五风十雨"],"usage":"作定语、宾语；形容风调雨顺"},{"id":9510,"word":"十鼠争穴","pinyin":"shí shǔ zhēng xué","abbr":"sszx","explanation":"穴：洞。十只老鼠争夺洞穴。比喻坏人聚在一起互相争斗。","source":{"text":"侯景奔窜，十鼠争穴，郭默清夷，晋熙附义。","book":"《梁书·元帝纪》"},"similar":["十鼠同穴"],"usage":"作谓语、定语；用于书面语"},{"id":9511,"word":"十鼠同穴","pinyin":"shí shǔ tóng xué","abbr":"sstx","explanation":"比喻使集中在一起，一网打尽。","source":{"text":"勋无活分，而汝等敢纵之！收三官已下付刺奸，当令十鼠同穴。","book":"晋·陈寿《三国志·魏志·鲍勋传》"},"example":{"text":"我们等待～的时机。"},"similar":["一网打尽"],"usage":"作谓语、定语；用于书面语","story":["三国时期，魏文帝曹丕身边侍从官鲍勋为人恪守正道，经常规劝曹丕在守孝期间加强军备、发展农业，不能外出打猎。文帝十分不满，因鲍勋私自放陈留太守孙邕到军营而把他投入监狱，同时把说情的三官也投入大牢，说让他们十鼠同穴"]},{"id":9512,"word":"千万买邻","pinyin":"qiān wàn mǎi lín","abbr":"qwml","explanation":"指好邻居的难得可贵。","source":{"text":"一百万买宅，千万买邻。","book":"《南史·吕僧珍传》"},"similar":["千钱买邻"],"usage":"作宾语；指好邻居的难得可贵","story":["南朝梁萧衍时期，平固侯吕僧珍非常有学问，对人谦虚诚恳，很多人愿意与他交往。南康郡太守宋季雅任期已到回京城等待安排，就花1100万钱买下吕僧珍旁边的宅子。吕僧珍问他为什么出此高价，宋说“一百万买宅，千万买你这个邻居。”"]},{"id":9513,"word":"千不该，万不该","pinyin":"qiān bù gāi，wàn bù gāi","abbr":"qbgwbg","explanation":"比喻再三表示不应该。","source":{"text":"只是昨儿千不该，万不该，铰上那玉上的穗子。","book":"清·曹雪芹《红楼梦》第二十九回"},"example":{"text":"这都是我的不好。我～把她一个人儿留在车上！","book":"林语堂《京华烟云》第二章"}},{"id":9514,"word":"千丝万缕","pinyin":"qiān sī wàn lǚ","abbr":"qswl","explanation":"千条丝，万条线。原形容一根又一根，数也数不清。现多形容相互之间种种密切而复杂的联系。","source":{"text":"道旁杨柳依依，千丝万缕，拧不住一分愁绪。","book":"宋·戴石屏《怜薄命》词"},"example":{"text":"长叹罢罗帕频掩，都揾尽～。","book":"元·无名氏《一枝花》"},"similar":["盘根错节","牵丝挂藤"],"opposite":["一刀两断"],"usage":"作谓语、定语、状语；用于人或事物之间"},{"id":9515,"word":"千乘万骑","pinyin":"qiān chéng wàn qí","abbr":"qcwq","explanation":"形容车马之盛。","source":{"text":"侯非侯，王非王，千乘万骑走北芒。","book":"《三国志·魏志·董卓传》注引《献帝春秋》"},"example":{"text":"九重城阙烟尘生，～西南行。","book":"唐·白居易《长恨歌》"},"similar":["千军万马"],"usage":"作宾语、定语；用于书面语"},{"id":9516,"word":"千乘之国","pinyin":"qián shèng zhī guó","abbr":"qszg","explanation":"拥有一千辆兵车的国家。春秋时指中等诸侯国。","source":{"text":"千乘之国。","book":"春秋·鲁·孔丘《论语·先进》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第61回：“说来说去都是～，不知支那之外，更有五洲万国的了。”"},"usage":"作主语、宾语、定语；指中等诸侯国","story":["春秋时期，孔子年轻时开坛讲学，听者纷纭。休息时，他与弟子们谈论各自的理想，子路说：“给我一个千乘之国，即使有内忧外患，只要三年我就能让它全民皆兵，有勇有谋。”孔子笑他使勇好斗，转而问冉求，冉求则提倡礼乐兴邦"]},{"id":9517,"word":"千乘之王","pinyin":"qián shèng zhī wáng","abbr":"qczw","explanation":"千：极言其多。指天子。","source":{"text":"夫千乘之王。","book":"西汉·司马迁《史记·货殖列传》"},"similar":["孤家寡人"],"usage":"作主语、宾语、定语；指天子"},{"id":9518,"word":"千了万当","pinyin":"qiān le wàn dàng","abbr":"qlwd","explanation":"比喻妥帖、有着落。同“千了百当”。","source":{"text":"一切两断，千了万当。","book":"宋·朱熹《朱子语类》第97卷"},"similar":["千了百当"],"usage":"作谓语、定语；指妥当"},{"id":9519,"word":"千了百了","pinyin":"qiān le bǎi le","abbr":"qlbl","explanation":"了：完了，结束。比喻一切都非常妥贴。"},{"id":9520,"word":"千了百当","pinyin":"qiān liǎo bǎi dàng","abbr":"qlbd","explanation":"了：完了，结束；当：恰当。比喻妥帖、有着落。","source":{"text":"不道你不是千了百当底人，此语只似先师下底语。","book":"宋·释普济《五灯会元》卷十九"},"example":{"text":"直是一刀两段，～。","book":"《朱子全书·论语十六》"},"similar":["千了万当"],"usage":"作谓语、定语；指妥当"},{"id":9521,"word":"千人一状","pinyin":"qiān rén yī zhuàng","abbr":"qryz","explanation":"所有人都是一个面孔。比喻都是老一套，没有变化。","source":{"text":"至于才子佳人等书，则又开口‘文君’，满篇‘子建’，千部一腔，千人一面，且终不能不涉淫滥。","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"这些衙役鬼魅伎俩，～，原也不必挂齿。","book":"清·李绿园《歧路灯》第九十五回"}},{"id":9522,"word":"千人一面","pinyin":"qiān rén yī miàn","abbr":"qrym","explanation":"众多人一个脸谱。多用以讥讽文艺创作上的雷同。","source":{"text":"至于才子佳人等书，则又开口‘文君’，满篇‘子建’，千部一腔，千人一面，且终不能不涉淫滥。","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"由于时尚的风气，两地的女人都走向潮流化，有点～，即使有变，也是万变不离其宗，终是落入案自。","book":"王安忆《长恨歌》第一部三章"},"similar":["千篇一律"],"usage":"作谓语、定语；用于写作等"},{"id":9523,"word":"千人唱，万人和","pinyin":"qiān rén chàng，wàn rén hè","abbr":"qrcwrh","explanation":"和：应声随唱。领唱的人多，应声随唱的人更多。形容响应的人极多。","source":{"text":"千人唱，万人和。山林为之震动，川谷为之荡波。","book":"汉·司马相如《上林赋》"},"example":{"text":"奏陶唐氏之舞，听葛天氏之歌，～，巴俞宋蔡，淮南千遮，文成颠歌，族居递奏，金鼓迭起。","book":"唐·欧阳洵《艺文类聚》卷六十六"}},{"id":9524,"word":"千人所指","pinyin":"qiān rén suǒ zhǐ","abbr":"qrsz","explanation":"千人：众人，许多人；指：指责。为众人所拇，。","source":{"text":"里谚曰：‘千人所指，无病而死。’臣常为之寒心。","book":"东汉·班固《汉书·王嘉传》"},"example":{"text":"～，无疾将死，穷败之念无时不萦于心。","book":"清·蒲松龄《聊斋志异·云翠仙》"},"similar":["十手所指","千夫所指"],"opposite":["有口皆碑"],"usage":"作谓语、定语；指遭众人唾弃","story":["西汉末年，汉哀帝刘欣是个贪图酒色的荒淫无耻的皇帝，他贪图男色，看上侍御史董恭的儿子董贤，因为他漂亮，就让他做大司马，封高安侯，百官通过他才能奏事，董贤动不动就赏人1000两黄金。御史大夫王嘉上书指责他是千夫所指的罪人"]},{"id":9525,"word":"千人诺诺，不如一士谔谔","pinyin":"qiān rén nuò nuò，bù rú yī shì è è","abbr":"qrnnbrysee","explanation":"指众多唯唯诺诺之人，不如一名诤谏之士可贵。","source":{"text":"千羊之皮，不如一狐之掖；千人之诺诺，不如一士之谔谔。武王谔谔以昌，殷纣墨墨以亡。","book":"《史记·商君列传》"},"example":{"text":"不知～，盈廷谐媚，而独得吴主事之力谏，风厉一世，岂不足令人起敬乎？","book":"蔡东蕃《清史演义》第八十回"},"similar":["千夫诺诺，不如一士谔谔"],"usage":"作宾语、定语、分句；用于处事"},{"id":9526,"word":"千仇万恨","pinyin":"qiān chóu wàn hèn","abbr":"qcwh","explanation":"千、万：形容多。指数不清的仇恨。形容仇恨极深。","source":{"text":"与君一把无名火，烧尽千愁万恨。","book":"明·陶宗仪《南村辍耕录》"},"similar":["苦大仇深"],"usage":"作主语、宾语、定语；指仇恨深"},{"id":9527,"word":"千仓万库","pinyin":"qiān cāng wàn kù","abbr":"qcwk","explanation":"形容因年成好，储存的粮食非常多。","source":{"text":"千仓万箱，百一耕所得。","book":"《诗经·小雅·甫田》：“乃求千斯仓，乃求万斯箱。”《抱朴子·极言》"},"example":{"text":"收尽历年盐钞，做成一等人家，～实堪夸，不在陶朱之下。","book":"明·王世贞《鸣凤记·鄢赵争宠》"}},{"id":9528,"word":"千仓万箱","pinyin":"qiān cāng wàn xiāng","abbr":"qcwx","explanation":"形容因年成好，储存的粮食非常多。","source":{"text":"乃求千斯仓，乃求万斯箱。","book":"《诗经·小雅·甫田》"},"example":{"text":"～，非一耕所得；干天之木，非旬日所长。","book":"晋·葛洪《抱朴子·极言》"},"usage":"作谓语、定语；指粮食储备丰富"},{"id":9529,"word":"千仞无枝","pinyin":"qiān rèn wú zhī","abbr":"qrwz","explanation":"比喻人品正直。","source":{"text":"松枞高千仞而无枝，非忧王室之无柱也。","book":"《水经注·汶水》"},"usage":"作谓语、定语；用于比喻句"},{"id":9530,"word":"千伶百俐","pinyin":"qiān líng bǎi lì","abbr":"qlbl","explanation":"形容非常机灵。","source":{"text":"自小服侍小姐，生得千伶百俐，才一十五岁。","book":"清·无名氏《玉娇梨》第八回"},"example":{"text":"他有～的头脑。"},"similar":["聪明伶俐"],"usage":"作谓语、定语、状语；指头脑聪明"},{"id":9531,"word":"千依万顺","pinyin":"qiān yī wàn shùn","abbr":"qyws","explanation":"形容非常顺从。同“千依百顺”。","source":{"text":"忽有一对侍儿跪在面前，请大王娘娘赴宴，行者暗想道：‘我还不要千依万顺。’","book":"明·董说《西游补》第六回"},"example":{"text":"第三，但是潘侯爷来了，不论什么客人在房间里头，都要让他。沉二宝如何不肯？～，满口应承。","book":"清·张春帆《九尾龟》第一百六十七回"},"similar":["百依百顺"],"usage":"作谓语、定语、状语、宾语；用于处世"},{"id":9532,"word":"千依百顺","pinyin":"qiān yī bǎi shùn","abbr":"qybs","explanation":"形容非常顺从。","source":{"text":"凡是船家教他做些什么，他千依百顺。","book":"明·凌濛初《初刻拍案惊奇》卷二十七"},"example":{"text":"苟太太此时，自是～，连忙请姨妈来，悄悄说知，姨妈自无不依之理。","book":"清·吴研人《二十年目睹之怪现状》第八十九回"},"similar":["百依百顺","千依万顺"],"usage":"作谓语、定语、状语、宾语；用于处世"},{"id":9533,"word":"千儿八百","pinyin":"qiān ér bā bǎi","abbr":"qebb","explanation":"一千左右。","source":{"text":"老婆娃娃吃穿不缺，家里的木箱里面，还常压着千儿八百的积蓄。","book":"路遥《平凡的世界》第四卷第36章"},"example":{"text":"这东西没有～是买不来的。"},"usage":"作定语、宾语；指一千左右，用于口语"},{"id":9534,"word":"千兵万马","pinyin":"qiān bīng wàn mǎ","abbr":"qbwm","explanation":"犹千军万马。","source":{"text":"李翰言文章，当如千兵万马而无人声。","book":"《南史·陈庆之传》：“先是洛阳谣曰：‘名师大将莫自牢，千兵万马避白袍。’”明·陈继儒《珍珠船》卷四"},"example":{"text":"不怕将勇兵强，唯这萨头陀妖法，虽有～，也抵当不住。","book":"清·陈忱《水浒后传》第三十三回"},"similar":["千军万马"],"opposite":["单枪匹马"],"usage":"作主语、宾语；指声势浩大"},{"id":9535,"word":"千军万马","pinyin":"qiān jūn wàn mǎ","abbr":"qjwm","explanation":"形容雄壮的队伍或浩大的声势。","source":{"text":"名军大将莫自牢，千兵万马避白袍。","book":"《南史·陈庆之传》"},"example":{"text":"各方面竟如～地围困拢来，实在说，我是有被这班箭手底乱箭所射死的可能性的。","book":"柔石《二月》二四"},"similar":["波澜壮阔","万马奔腾"],"opposite":["一兵一卒","一成一旅"],"usage":"作主语、宾语；指声势浩大","story":["南北朝时期，梁武帝命大将陈庆之率军伐北魏，陈庆之一路所向披靡，一直攻打荥阳城下，他鼓舞士气，以7000人战胜魏军30万人，直向洛阳。他的将士身着白色战袍，十分威武。魏人感慨：“名师大将莫自牢，千兵万马避白袍。”"]},{"id":9536,"word":"千军易得，一将难求","pinyin":"qiān jūn yì dé，yī jiàng nán qiú","abbr":"qjydyjnq","explanation":"指将才难得。","source":{"text":"陡恁的千军易得，一将难求。","book":"元·马致远《汉宫秋》第二折"},"example":{"text":"史臣论秦事，以为～。穆公信孟明之贤，能始终任用，所以卒成霸业。","book":"明·冯梦龙《东周列国志》第四十六回"},"usage":"作宾语、定语；用于书面语"},{"id":9537,"word":"千凑万挪","pinyin":"qiān còu wàn nuó","abbr":"qcwn","explanation":"凑：凑集。千方百计筹集挪借资金。比喻尽力筹资。","source":{"text":"通共一二十两银子，还不够三五天使用的呢，若不是我千凑万挪的，早不知过到什么破窑里去了。","book":"清·曹雪芹《红楼梦》第72回"},"similar":["东挪西借"],"usage":"作谓语、宾语；用于筹资"},{"id":9538,"word":"千刀万剁","pinyin":"qiān dāo wàn duò","abbr":"qdwd","explanation":"本指古代凌迟的酷刑，后亦常用为咒骂语。","source":{"text":"干着你六问三推，生将我千刀万剁。","book":"元·无名氏《争报恩》第三折"},"example":{"text":"却有十二分恨狄希陈的做弄，～，咒死骂生，茶饭中不住口，睡梦中不歇声。","book":"清·西周生《醒世姻缘传》第六十三回"},"similar":["千刀万剐"],"usage":"作谓语、宾语、定语；常用咒骂语"},{"id":9539,"word":"千刀万剐","pinyin":"qiān dāo wàn guǎ","abbr":"qdwg","explanation":"剐：割肉离骨。一刀一刀将罪犯身上的肉割下处死。形容罪恶重大，死也不能抵罪。","source":{"text":"即日押赴市曹，将他万剐千刀，凌迟处死。","book":"元·无名氏《盆儿鬼》第四折"},"example":{"text":"谁敢再有二心，俺便拿送辕门，听元帅千刀万剐。","book":"清·孔尚任《桃花扇·誓师》"},"similar":["万剐千刀","杀人如麻"],"opposite":["体贴入微"],"usage":"作谓语、宾语、定语；常用咒骂语"},{"id":9540,"word":"千千万万","pinyin":"qiān qiān wàn wàn","abbr":"qqww","explanation":"形容为数极多。","source":{"text":"千千万万之状容兮，不可得而状也。","book":"唐·杜牧《晚晴赋》"},"example":{"text":"大爷，你可～见了这二个人的面再商量走的话！","book":"清·文康《儿女英雄传》第三回"},"similar":["万万千千"],"opposite":["三三两两","零零碎碎"],"usage":"作谓语、定语；形容数量极多"},{"id":9541,"word":"千变万化","pinyin":"qiān biàn wàn huà","abbr":"qbwh","explanation":"形容变化极多。","source":{"text":"千变万化兮，未始有极。","book":"《列子·周穆王》：“乘虚不坠，触实不硋，千变万化，不可穷极。”《史记·贾谊列传》"},"example":{"text":"官场中的事，～，那里说得定呢。","book":"清·吴趼人《二十年目睹之怪现状》第七回"},"similar":["变化莫测","瞬息万变"],"opposite":["一成不变","依然如故"],"usage":"作谓语、定语；用于景物","story":["周穆王到西部去巡视，途中遇到技艺高超的工匠偃师，问能造什么，偃师回答说：“君王要什么就造什么。”第二天他带上一个能唱会跳的假人来晋见。穆王叫他当场卸装，见完全是人工所为就赞叹说：“人工是多么灵巧神妙和千变万化。”"]},{"id":9542,"word":"千变万状","pinyin":"qiān biàn wàn zhuàng","abbr":"qbwz","explanation":"变化繁多，呈现出各种情状。","source":{"text":"后殿又为温室、凝缸室、浴兰室，曲房连槛，饰黄金白玉，以壁为表里，千变万状。","book":"汉·伶玄《赵飞燕外传》"},"example":{"text":"～，不可殚记。","book":"唐·白居易《庐山草堂记》"},"similar":["千变万化"],"opposite":["一成不变"],"usage":"作谓语、宾语；形容变化多端"},{"id":9543,"word":"千变万轸","pinyin":"qiān biàn wàn zhěn","abbr":"qbwz","explanation":"指千变万化。轸，转。","source":{"text":"圣人之接物，千变万轸，必有不化而应化者。","book":"西汉·刘安《淮南子·诠言训》"},"similar":["千变万化"],"opposite":["一成不变"],"usage":"作谓语、定语；用于景物"},{"id":9544,"word":"千古一律","pinyin":"qiān gǔ yī lǜ","abbr":"qgyl","explanation":"指从来如此。","source":{"text":"杀子产，谤仲尼，千古一律，何足怪哉？","book":"明·李贽《史纲评要·周记·敬王》"},"similar":["千古一辙","千年一律"],"usage":"作谓语、定语、状语；指从来如此"},{"id":9545,"word":"千古一时","pinyin":"qiān gǔ yī shí","abbr":"qgys","explanation":"喻指难得的机会。","source":{"text":"今天下之机杼在王，王若出兵以临中原，天下响应，此千古一时也。","book":"清·刘献廷《广阳杂记》卷四"},"similar":["千载一时"],"usage":"作宾语、定语；用于书面语"},{"id":9546,"word":"千古一辙","pinyin":"qiān gǔ yī zhé","abbr":"qgyz","explanation":"指自古相同。","source":{"text":"后村所谓‘谄谀以求悦，揣摩以幸中’，千古一辙也。","book":"清·周亮工《书影》卷六"},"similar":["千古一律"],"usage":"作谓语、定语、状语；指自古相同"},{"id":9547,"word":"千古不朽","pinyin":"qiān gǔ bù xiǔ","abbr":"qgbx","explanation":"指永远流传，不会磨灭。","source":{"text":"谁肯以千古不朽之名人，抑之使出时流下。","book":"清·李渔《闲情偶寄·词曲》"},"example":{"text":"此地有一白虎山，极好风水，若葬于此，～。","book":"清·如莲居士《薛刚反唐》第一回"},"similar":["永垂不朽","千古不磨"],"usage":"作谓语、定语；用于功绩等"},{"id":9548,"word":"千古不磨","pinyin":"qiān gǔ bù mó","abbr":"qgbm","explanation":"流传千万年也不会磨灭。犹千古不朽。","source":{"text":"《汉书》、《史记》，千古不磨，尚矣。","book":"清·李渔《闲情偶寄·词曲》"},"example":{"text":"周代的变风、变雅和屈子的《离骚》，都是在革命时期中所产生的～的文学。","book":"郭沫若《革命与文学》"},"similar":["千古不朽"],"usage":"作谓语、定语；用于功绩等"},{"id":9549,"word":"千古兴亡","pinyin":"qiān gǔ xīng wáng","abbr":"qgxw","explanation":"千年的兴盛衰亡。","source":{"text":"千古兴亡，百年悲笑，一时登览。","book":"宋·辛弃疾《水龙吟·过南剑双溪楼》"},"example":{"text":"～多少事，悠悠，不尽长江滚滚流。","book":"宋·辛弃疾《南乡子·登京口北固亭有怀》"},"usage":"作宾语、定语；用于书面语"},{"id":9550,"word":"千古卓识","pinyin":"qiān gǔ zhuó shí","abbr":"qgzs","explanation":"卓：卓越，高超。指流传千古而迄今未见超过其说法的卓越见识。","source":{"text":"何仲默云：‘陆诗体俳语不俳，谢则体语俱俳。’可谓千古卓识。","book":"明·胡应麟《诗薮·内篇》卷二"},"usage":"作宾语、定语；用于夸奖人"},{"id":9551,"word":"千古同慨","pinyin":"qiān gǔ tóng kǎi","abbr":"qgtk","explanation":"古往今来的人都是同一种感慨。","example":{"text":"李广数奇，～。","book":"蔡东蕃《明史演义》第九十三回"}},{"id":9552,"word":"千古奇冤","pinyin":"qiān gǔ qí yuān","abbr":"qgqy","explanation":"千百年来最奇特的冤案。","source":{"text":"千古奇冤，江南一叶；同室操戈，相煎何急！","book":"周恩来《千古奇冤》诗"},"example":{"text":"王朔《过把瘾就死》：“我认什么错？我有什么错？我～应该昭雪的。”"},"usage":"作主语、宾语、定语；指特冤"},{"id":9553,"word":"千古奇逢","pinyin":"qiān gǔ qí féng","abbr":"qgqf","explanation":"千古：长久。千年才遇到的事情。","source":{"text":"老爷隆恩旷典，着众婢子出来择配，以了终身，也是千古奇逢，难得的快事。","book":"清·褚人获《隋唐演义》第16回"},"example":{"text":"清·褚人获《隋唐演义》第16回：“老爷隆恩旷典，着众婢子出来择配，以了终身，也是～，难得的快事。”"},"similar":["千古奇遇","千载难逢","千古奇闻"],"usage":"作主语、宾语、定语；指惊人的事物"},{"id":9554,"word":"千古奇闻","pinyin":"qiān gǔ qí wén","abbr":"qgqw","explanation":"奇闻：惊奇动听的事情。少有的使人惊奇的事情。","source":{"text":"今朕作主，准赐婚配。花之慈母亦无不俯依之理，况又与前四少将御侄等撮合，如出一辙。更见姻缘相配出于千古奇闻也。","book":"好古主人《赵太祖三下南唐》第四十五回"},"example":{"text":"一个信洋教的恶霸，敢说拿孔门弟子开刀，真乃～！奇闻！","book":"老舍《神拳》第二幕"},"similar":["旷古奇闻","亘古奇闻"],"usage":"作主语、宾语、定语；指惊人的事物"},{"id":9555,"word":"千古独步","pinyin":"qiān gǔ dú bù","abbr":"qgdb","explanation":"指独具风格，无与伦比。形容造诣之深。","source":{"text":"颜鲁公之书，雄姿杰出，千古独步，可仰而不可及耳。","book":"宋·张戒《岁寒堂诗话》卷上"},"example":{"text":"但今日我们所行之令，并非我要自负，实系前无古人，后无来者，竟可算得～。","book":"清·李汝珍《镜花缘》第九十三回"},"similar":["独步一时"],"usage":"作谓语、定语；用于书面语"},{"id":9556,"word":"千古笑端","pinyin":"qiān gǔ xiào duān","abbr":"qgxd","explanation":"千古：年代久远；笑端：笑柄。长时期被人取笑的笑柄。","source":{"text":"中原常虎视于此，一旦真主出，江南弃甲不暇，吾不能为千古笑端。","book":"明·何良俊《世说新语补·识鉴》"}},{"id":9557,"word":"千古绝唱","pinyin":"qiān gǔ jué chàng","abbr":"qgjc","explanation":"指从来少有的绝妙佳作。","source":{"text":"‘茶龟’对‘酒鳖’，真千古绝唱也。","book":"明·李贽《与汪鼎甫书》：“所谓水中盐味，可取不可得，是为千古绝唱，当与古文远垂不朽者也。”清·采蘅子《虫鸣漫录》卷二"},"example":{"text":"一物而兼三名，原不为奇，最难得都是叠韵。古人命名之巧，无出其右，这可算得～了。","book":"清·李汝珍《镜花缘》第九十二回"},"similar":["千古绝调"],"usage":"作宾语、定语；用于作品等"},{"id":9558,"word":"千古绝调","pinyin":"qiān gǔ jué diào","abbr":"qgjd","explanation":"犹千古绝唱。指从来少有的绝妙佳作。","source":{"text":"阮亭专以神韵为主，如《仪征柳耆卿墓》云：‘残月晓风仙掌路，何人为吊柳屯田？’酝藉含蓄，实是千古绝调。","book":"清·赵翼《瓯北诗话·查初白诗》"},"example":{"text":"屈原将投汨罗而作《离骚》，李陵降胡不归而赋别苏武诗，蔡琰被掠失身而赋〈悲愤〉诸诗，～，必成于失意不可解之诗。","book":"清·费锡璜《汉诗总说》"},"similar":["千古绝唱"],"usage":"作宾语、定语；用于作品等"},{"id":9559,"word":"千古罪人","pinyin":"qiān gǔ zuì rén","abbr":"qgzr","explanation":"形容犯的罪永远被人记着。","source":{"text":"不独老杨禽兽，作千古罪人，即弟辈以小人之心推测君子，亦应抱愧。","book":"清·荑荻散人《玉娇梨》第三回"},"example":{"text":"这个卖国求荣的无耻汉奸终将成为～，遗臭万年。"},"usage":"作宾语、定语；指人罪大"},{"id":9560,"word":"千古骂名","pinyin":"qiān gǔ mà míng","abbr":"qgmm","explanation":"千古：永远。永世被人唾骂的名声。","source":{"text":"只是一场冷落败坏根基，都藏在里边，不做千古骂名，定是一番笑话。","book":"清·褚人获《隋唐演义》第一回"},"usage":"作宾语、定语；用于书面语"},{"id":9561,"word":"千叮万嘱","pinyin":"qiān dīng wàn zhǔ","abbr":"qdwz","explanation":"再三再四地嘱咐。表示对嘱咐的事情极重视。","source":{"text":"我将你千叮万嘱，你偏放人长号短哭。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"当下爷儿娘们依依不舍，公子只是垂泪，太太也是～，沾眼抹泪的说个不了。","book":"清·文康《儿女英雄传》第二回"},"similar":["千叮咛，万嘱咐"],"opposite":["寡言少语"],"usage":"作宾语、定语；用于长辈对晚辈的叮嘱"},{"id":9562,"word":"千叮咛，万嘱咐","pinyin":"qiān dīng níng，wàn zhǔ fù","abbr":"qdnwzf","explanation":"再三再四地嘱咐。表示对嘱咐的事情极重视。","source":{"text":"我将你千叮万嘱，你偏放人长号短哭。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"宝二爷今儿～的，什么花姑娘草姑娘的，我们自然有道理。","book":"清·曹雪芹《红楼梦》第五十二回"},"similar":["千叮万嘱"],"usage":"作宾语、定语；用于长辈对晚辈的叮嘱"},{"id":9563,"word":"千呼万唤","pinyin":"qiān hū wàn huàn","abbr":"qhwh","explanation":"形容再三催促。","source":{"text":"千呼万唤始出来，犹抱琵琶半遮面。","book":"唐·白居易《琵琶行》诗"},"example":{"text":"朦胧的月色呢？岂独鸟呢？但是咫尺天涯，教我如何耐得？我拼命～，你能够出来么？（朱自清《温州的踪迹》）"},"similar":["呼天喊地","千唤万唤"],"usage":"作谓语；比喻多次呼唤，再三催促","story":["唐朝大诗人白居易用诗歌为民请命，得罪了当时的权贵。因此被贬到江州做司马。他来到浔阳江边与即将离别的朋友送行，风吹着芦苇传来阵阵凄凉。他们上船喝起了酒来，江面上传来一阵琵琶声。他们驱船靠近，千呼万唤才见到那位犹抱琵琶半遮面的佳人"]},{"id":9564,"word":"千唤万唤","pinyin":"qiān huàn wàn huàn","abbr":"qhwh","explanation":"唤：呼唤。比喻多次呼唤，再三催促。","source":{"text":"师曰：‘却须吃棒，上堂啰舌沸，千唤万唤露柱因甚么不回头？’良久曰：‘美食不中饱，人吃便下座。’","book":"宋·释普济《五灯会元·智门祚禅师法嗣》"},"similar":["千呼万唤"],"usage":"作谓语；比喻多次呼唤，再三催促"},{"id":9565,"word":"千回万转","pinyin":"qiān huí wàn zhuǎn","abbr":"qhwz","explanation":"形容经过很多曲折或反复考虑。","source":{"text":"我这里千回右转自彷徨，撇不下多情数桩。","book":"元·范居中《秋思》"},"example":{"text":"宝钗～，想了一个主意。（清·曹雪芹《红楼梦》第九十八回）"},"similar":["千回百转"],"usage":"作谓语、定语；形容经过很多曲折或反复考虑"},{"id":9566,"word":"千回百折","pinyin":"qiān huí bǎi zhé","abbr":"qhbz","explanation":"形容文艺作品或歌声、乐曲跌宕婉转。也形容事态的发展、前进的历程弯弯曲曲，很不顺利。","source":{"text":"百川时文，精粹湛深，抽心苗，发奥旨，绘物态，状人情，千回百折，而卒造乎浅近。","book":"清·郑燮《潍县署中与舍弟书·五》"},"example":{"text":"牺牲几许生命，耗费几许金钱，～，始达到实行帝制之目的。","book":"蔡东藩、许厪父《民国通俗演义》第六十七回"},"similar":["千回万转"],"opposite":["一帆风顺"],"usage":"作宾语、状语；指文艺作品或歌声乐曲"},{"id":9567,"word":"千回百转","pinyin":"qiān huí bǎi zhuǎn","abbr":"qhbz","explanation":"形容反复回旋或进程曲折。","source":{"text":"我这里千回右转自彷徨，撇不下多情数桩。","book":"元·范居中《秋思》"},"example":{"text":"那知桃花岛上道路～，别说救人，连自己也陷了三日三夜，险些饿死。","book":"金庸《射雕英雄传》第三十一回"},"similar":["千回万转","千回百折"],"usage":"作谓语、定语；用于书面语"},{"id":9568,"word":"千夫所指","pinyin":"qiān fū suǒ zhǐ","abbr":"qfsz","explanation":"为众人所指责。形容触犯众怒。","source":{"text":"千人所指，无病而死。","book":"《汉书·王嘉传》"},"example":{"text":"～，其倾覆可立而期。","book":"章炳麟《联省自治虚置政府议》"},"similar":["众矢之的"],"usage":"作定语、宾语；形容触犯众怒","story":["西汉末年，汉哀帝刘欣是个贪图酒色的荒淫无耻的皇帝，他贪图男色，看上侍御史董恭的儿子董贤，因为他漂亮，就让他做大司马，封高安侯，百官通过他才能奏事，董贤动不动就赏人1000两黄金。御史大夫王嘉上书指责他是千夫所指的罪人"]},{"id":9569,"word":"千夫所指，无疾将死","pinyin":"qiān fū suǒ zhǐ，wú jí jiāng sǐ","abbr":"qfszwjjs","explanation":"指：指责。被众人所指责将没什么好下场。","source":{"text":"迨于身无襦，妇无袴，千夫所指，无疾将死，穷败之念无时不萦于心。","book":"清·蒲松龄《聊斋志异·云翠仙》"},"similar":["千夫所指，无疾而死"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":9570,"word":"千夫所指，无疾而死","pinyin":"qiān fū suǒ zhǐ，wú jí ér sǐ","abbr":"qfszwjes","explanation":"指：指责。被众人所指责将没什么好下场。","source":{"text":"语云：‘千夫所指，无疾而死’……愿诸公深思熟虑之。","book":"《中国工农红军1936年5月5日电》"},"similar":["千夫所指，无病而死"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":9571,"word":"千夫所指，无病而死","pinyin":"qiān fū suǒ zhǐ，wú bìng ér sǐ","abbr":"qfszwbes","explanation":"指：指责。被众人所指责将没什么好下场。","source":{"text":"里谚曰：‘千夫所指，无病而死。’臣常为之寒心。","book":"东汉·班固《汉书·王嘉传》"},"similar":["千夫所指，无疾而死"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":9572,"word":"千夫所指，无病自死","pinyin":"qiān fū suǒ zhǐ，wú bìng zì sǐ","abbr":"qfszwbzs","explanation":"千夫：很多人；指：指责。为众人所指责和反对的，必然趋向灭亡。","source":{"text":"千夫所指，无病自死，不其然欤？","book":"《汉书·王嘉传》：“里谚曰：‘千人所指，无病而死。’臣常为之寒心。”唐·柳泽《论时政书》"}},{"id":9573,"word":"千夫所言如一喙","pinyin":"qiān fū suǒ yán rú yī huì","abbr":"qfsyryh","explanation":"喙：鸟嘴。形容众口一辞或文章模式划一。","source":{"text":"然其欲连盟中国，以措亚洲舄础之安，则千夫所言如一喙也。","book":"章炳麟《上李鸿章书》"},"similar":["千形一貌，百喙一声"],"usage":"作宾语、定语；用于书面语"},{"id":9574,"word":"千夫诺诺，不如一士谔谔","pinyin":"qiān fū nuò nuò，bù rú yī shì è è","abbr":"qfnnbrysee","explanation":"指众多唯唯诺诺之人，不如一名诤谏之士可贵。同“千人诺诺，不如一士谔谔”。","source":{"text":"韩城田益，字迁之。黄庭坚以谓不足以配名，更之曰友直……何独取诸此？某曰：夫直者，刚者之长也。千夫诺诺，不如一士之谔谔。","book":"宋·苏轼《讲田友直字序》"},"similar":["千人诺诺，不如一士谔谔"],"usage":"作宾语、定语、分句；用于处事","story":["宋朝时期，韩城人田益，字迁之，他敢于直言进谏，言辞锋利。黄庭坚认为他的名字与为人不相符，帮他改名为田直，这样才能名实相符。朋友在旁边解释道：“夫直者，刚者之长也。千夫诺诺，不如一士谔谔。”"]},{"id":9575,"word":"千头万序","pinyin":"qiān tóu wàn xù","abbr":"qtwx","explanation":"形容事情杂，头绪多。同“千头万绪”。","source":{"text":"火宅驱牵常煎炒，千头万序何时了。","book":"《敦煌变文集·无常经讲经文》"},"similar":["千头万绪"],"usage":"作谓语、宾语；用于事物"},{"id":9576,"word":"千头万绪","pinyin":"qiān tóu wàn xù","abbr":"qtwx","explanation":"绪：丝头。比喻事情的开端，头绪非常多。也形容事情复杂纷乱。","source":{"text":"机等吹毛求疵，千端万绪，然终无可言者。","book":"三国魏·曹植《自试令》"},"example":{"text":"一时间，～，让他无从谈起。"},"similar":["错综复杂","纷然杂陈","千丝万缕"],"opposite":["一目了然","洞若观火","井井有条"],"usage":"作谓语、宾语；用于事物"},{"id":9577,"word":"千头木奴","pinyin":"qiān tóu mù nú","abbr":"qtmn","explanation":"奴：拟人化的说法。指可以维持生计的家产。","source":{"text":"汝母恶我治家，故穷如是。然吾州里有千头木奴，不责汝衣食，岁上一匹绢，亦可足用耳。","book":"《三国志·吴志·孙休传》裴松之注引《襄阳记》"},"example":{"text":"家徒四壁求扬意，树少千头槐木奴。","book":"明·汤显祖《牡丹亭·寻梦》"}},{"id":9578,"word":"千头桔奴","pinyin":"qiān tóu jú nú","abbr":"qtjn","explanation":"上千棵桔树就像上千个家奴。指前人为后人创造财富。","example":{"text":"我也想父母能给我留下～。"},"usage":"作主语、宾语、定语；指前人为后人创造财富","story":["古代地方小官李衡由于妻子专横霸道，而且好吃懒做，家道日益衰落，儿子都是读书人没有什么谋生的本事，就背着妻子在武陵购置田地修建房屋，并种上千棵桔树，请人管理。待到临死前才告诉儿子给他们留下活命的千头桔奴"]},{"id":9579,"word":"千头橘奴","pinyin":"qiān tóu jú nú","abbr":"qtjn","explanation":"奴：拟人化的说法。指可以维持生计的家产。","source":{"text":"汝母恶我治家，故穷如是。然吾州里有千头木奴，不责汝衣食，岁上一匹绢，亦可足用耳。","book":"《三国志·吴志·孙休传》裴松之注引《襄阳记》"}},{"id":9580,"word":"千奇百怪","pinyin":"qiān qí bǎi guài","abbr":"qqbg","explanation":"形容各种各样奇怪的事物。","source":{"text":"杀人竟不偿命，不杀人到要偿命，死者生者，怨气冲天，纵然官府不明，皇天自然鉴察，千奇百怪的，巧生出机会来了此公案。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"example":{"text":"海洋里的生物～，非常迷人。"},"similar":["稀奇古怪","奇形怪状"],"opposite":["千篇一律","毫无二致"],"usage":"作谓语、定语、宾语；指稀奇古怪的事物"},{"id":9581,"word":"千妥万妥","pinyin":"qiān tuǒ wàn tuǒ","abbr":"qtwt","explanation":"十分妥当。","source":{"text":"到底是太太有智谋，这是千妥万妥。别说是鸳鸯，凭他是谁，那一个不想巴高望上、不想出头的？","book":"清·曹雪芹《红楼梦》第四十六回"},"example":{"text":"告诉当太太的女士，你们如果去人工受孕，～之计，别让任何一个人知道，也别让别的女人知道。","book":"柏杨《婚恋物语·压舱》"},"similar":["千妥万当"],"usage":"作宾语、定语、状语；指极为妥当"},{"id":9582,"word":"千妥万当","pinyin":"qiān tuǒ wàn dāng","abbr":"qtwd","explanation":"非常妥当。","source":{"text":"兄弟这里，却有一个千妥万当的人。","book":"清·文康《儿女英雄传》"},"example":{"text":"我已经安排得～，你可放心去吧。"},"similar":["千妥万妥"],"usage":"作定语、状语；指极为妥当"},{"id":9583,"word":"千姿万态","pinyin":"qiān zī wàn tai","abbr":"qzwt","explanation":"形容姿态多种多样。同“千姿百态”。","source":{"text":"望不尽，千姿万态独秀峰。","book":"贺敬之《桂林山水歌》"},"example":{"text":"长江三日，～，现在已不是前天那样大雾迷蒙，也不是昨天‘巫山巫峡色萧森’，而是：‘楚地阔无边，苍茫万顷连’了。","book":"刘白羽《长江三日》"},"similar":["千姿百态"],"opposite":["千篇一律"],"usage":"作谓语、定语、宾语；形容姿态之多"},{"id":9584,"word":"千姿百态","pinyin":"qiān zī bǎi tài","abbr":"qzbt","explanation":"形容姿态多种多样。","source":{"text":"食客五花八门，论服饰千姿百态，论肤色黄白都有。","book":"蒋子龙《好景门》"},"example":{"text":"当然，～的生活本身又为这种竞赛提供了根本的条件。","book":"秦牧《艺海拾贝·鲜花百态和艺术风格》"},"similar":["千态万状","绰约多姿"],"opposite":["千人一面","千篇一律"],"usage":"作谓语、定语、宾语；形容姿态之多"},{"id":9585,"word":"千娇万态","pinyin":"qiān jiāo wàn tài","abbr":"qjwt","explanation":"娇：妩媚可爱。形容女性容貌极其美好。","source":{"text":"何人不爱牡丹花，占断城中好物华。疑是洛川神女作，千娇万态破朝霞。","book":"唐·徐凝《牡丹》诗"},"similar":["千娇百态"],"usage":"作宾语、定语；用于女性"},{"id":9586,"word":"千娇百媚","pinyin":"qiān jiāo bǎi mèi","abbr":"qjbm","explanation":"娇、媚：美好。形容女子姿态美好。","source":{"text":"千娇百媚，造次无可比方；弱体轻身，谈之不能备尽。","book":"南朝·陈·徐陵《杂曲》诗：“绿黛红颜两相发，千娇百态情无歇。”唐·张文成《游仙窟》"},"example":{"text":"吴衙内在灯下把贺小姐仔细一观，更觉～。","book":"明·冯梦龙《醒世恒言》卷二十八"},"similar":["婀娜多姿","花枝招展"],"opposite":["其貌不扬","面目可憎"],"usage":"作谓语、定语；形容貌美可爱"},{"id":9587,"word":"千娇百态","pinyin":"qiān jiāo bǎi tài","abbr":"qjbt","explanation":"娇：妩媚可爱。形容女性容貌极其美好","source":{"text":"绿黛红颜两相发，千娇百态情无歇。","book":"南朝·陈·徐陵《徐孝穆集·杂曲》"},"example":{"text":"你不要被她的～所迷惑"},"similar":["千娇百媚","千娇万态"],"usage":"作宾语、定语；用于女性"},{"id":9588,"word":"千家万户","pinyin":"qiān jiā wàn hù","abbr":"qjwh","explanation":"指众多人家。","source":{"text":"师曰：‘长安城里。’问：‘如何领会？’师曰：‘千家万户’。","book":"宋·释道原《景德传灯录》"},"example":{"text":"每生出一个儿子都要封一个王，就有～倾家破产，妻离子散，受不尽的糟践。","book":"姚雪垠《李自成》"},"similar":["家家户户"],"usage":"作主语、宾语、定语；指众多人家"},{"id":9589,"word":"千山万壑","pinyin":"qiān shān wàn hè","abbr":"qswh","explanation":"壑：山沟。山峦连绵，高低重迭。","source":{"text":"群山万壑赴京门，生长明妃尚有村。","book":"唐·杜甫《咏怀古迹五首》"},"example":{"text":"课堂，在闽赣的～！（梁信《从奴隶到将军》上集第五十一）"},"similar":["千山万水","群山万壑","千岩万壑"],"opposite":["一马平川"],"usage":"作主语、宾语；形容地势险峻"},{"id":9590,"word":"千山万水","pinyin":"qiān shān wàn shuǐ","abbr":"qsws","explanation":"万道河，千重山。形容路途艰难遥远。","source":{"text":"离别河边绾柳条，千山万水玉人遥。","book":"唐·张乔《寄维阳故人》诗"},"example":{"text":"都则为一官半职，阻隔得～。","book":"元·王实甫《西厢记》第四本第四折"},"similar":["千山万壑"],"opposite":["一马平川"],"usage":"作宾语、定语；形容路途的艰难"},{"id":9591,"word":"千岁一时","pinyin":"qiān suì yī shí","abbr":"qsys","explanation":"犹千载一时。一千年才有这么一个时机。形容机会极其难得。","source":{"text":"机运难邀，千岁一时，公焉得辞也。","book":"《晋书·慕容云载记》"},"similar":["千载一时"],"usage":"作谓语、定语、宾语；指机会难得"},{"id":9592,"word":"千岁流芳","pinyin":"qiān suì liú fāng","abbr":"qslf","explanation":"芳：香：引申为好的名声。好的名声永远流传。","source":{"text":"子欲为名高也，则当如许由、子威、卞随、务光，洗耳逃禄，千岁流芳。","book":"晋·张敏《头责子羽文》"}},{"id":9593,"word":"千岁鹤归","pinyin":"qiān suì hè guī","abbr":"qshg","explanation":"指对故乡的眷恋之情。","source":{"text":"丁令威，本辽东人，学道于灵虚山。后化鹤归辽，集城门华表柱。时有少年，举弓欲射之。鹤乃飞，徘徊空中而言曰：‘有鸟有鸟丁令威，去家千年今始归，城郭如故人民非，何不学仙冢累累。’遂高上冲天。","book":"晋·陶潜《搜神后记》卷一"}},{"id":9594,"word":"千岩万壑","pinyin":"qiān yán wàn hè","abbr":"qywh","explanation":"形容山峦连绵，高低重迭。","source":{"text":"况当霁景凉风后，如在千岩万壑间。","book":"南朝宋·刘义庆《世说新语·言语》：“顾长康从会稽还，人问山川之美，顾云：‘千岩竞秀，万壑争流。’”唐·白居易《题歧王旧山池石壁》诗"},"example":{"text":"～供野宿，羊肠鸟道笑津迷。","book":"陈毅《乐安宜黄道中闻捷》诗"},"similar":["千山万水","千山万壑"],"opposite":["一马平川"],"usage":"作定语、宾语；形容地形险峻","story":["晋朝时期，著名的书画家顾恺之在大将军桓温手下当大司马参军，两人感情十分要好。桓温死后，顾恺之作诗纪念：“山崩溟海竭，鱼鸟将何依。”很多人佩服他的文才，要他描写会稽景色，他评价为：“千岩竞秀，万壑争流。”"]},{"id":9595,"word":"千岩万谷","pinyin":"qiān yán wàn gǔ","abbr":"qywg","explanation":"形容峰峦、山谷极多。","source":{"text":"宫有五洞交扃，九峰回挹千岩万谷，秀聚其中。","book":"宋·吴自牧《梦梁录》"},"similar":["千岩万壑","千山万壑"],"usage":"作定语、宾语；形容地形险峻"},{"id":9596,"word":"千岩竞秀","pinyin":"qiān yán jìng xiù","abbr":"qyjx","explanation":"岩：山崖；竞：竞赛。重山叠岭的风景好像互相比美。形容山景秀丽。","source":{"text":"千岩竞秀，万壑争流，草木蒙笼其上，若云兴霞蔚。","book":"南朝宋·刘义庆《世说新语·言语》"},"example":{"text":"万壑争流，～。鸟啼人不见，花落树尤香。","book":"明·吴承恩《西游记》第十七回"},"usage":"作谓语、定语；形容山景秀丽"},{"id":9597,"word":"千峰万壑","pinyin":"qiān fēng wàn hè","abbr":"qfwh","explanation":"犹千岩万壑。形容山峦连绵，高低重迭。","source":{"text":"每大雪初霁，千峰万壑，积素凝华，若图画然，为京师八景之一。","book":"明·沈榜《宛署杂记·山川》"},"similar":["千岩万壑"],"usage":"作宾语、定语；指地势险峻"},{"id":9598,"word":"千峰百嶂","pinyin":"qiān fēng bǎi zhàng","abbr":"qfbz","explanation":"形容山峦重迭。","source":{"text":"身游万死一生地，路入千峰百嶂中。","book":"宋·陆游《晚泊》"},"example":{"text":"～转芝城，添作山厨鲎尾羹。","book":"清·梁章钜《附谢辰和韵》诗"},"similar":["层峦叠嶂"],"usage":"作宾语、定语；用于山势等"},{"id":9599,"word":"千差万别","pinyin":"qiān chā wàn bié","abbr":"qcwb","explanation":"形容各类多，差别大。","source":{"text":"僧问：‘如何是无异底事？’师曰：‘千差万别。’","book":"宋·释道原《景德传灯录·文遂导师》"},"example":{"text":"有什么大画家能区别这～的绿和红么？","book":"于敏《西湖即景》"},"similar":["天壤之别","天差地别"],"opposite":["半斤八两","千篇一律"],"usage":"作谓语、定语、宾语；形容有很多的不同"},{"id":9600,"word":"千差万错","pinyin":"qiān chà wàn cuò","abbr":"qcwc","explanation":"指差错很多或很大。","source":{"text":"我脚何似佛脚，隐显千差万错；豁开金刚眼睛，看取目前善恶。","book":"宋·黄龙慧南禅师《真净文颂》"},"example":{"text":"千差万错阴差阳错总之列位爷大人大量一笑了之的罢！","book":"二月河《乾隆皇帝》第一章"},"usage":"作宾语、定语；指错误多"},{"id":9601,"word":"千帆竞发","pinyin":"qiān fāng jìng fā","abbr":"qfjf","explanation":"竞：竞争。数不尽的船只竞相出发。形容事物蓬勃向上，生机勃勃地向前发展。","source":{"text":"沉舟侧畔千帆过，病树前头万木春。","book":"唐·刘禹锡《酬乐天扬州初逢席上见赠》"}},{"id":9602,"word":"千年一律","pinyin":"qiān nián yī lǜ","abbr":"qnyl","explanation":"犹言千古一律。指从来如此。","source":{"text":"万口一词，不可破也；千年一律，不自知也。","book":"明·李贽《题孔子像于芝佛院》"},"similar":["千古一律"],"usage":"作谓语、定语、状语；指从来如此"},{"id":9603,"word":"千年万载","pinyin":"qiān nián wàn zǎi","abbr":"qnwz","explanation":"形容年代非常久远。","source":{"text":"谁不知道庞居士误放了来生债，我则待显名儿千年万载。","book":"元·无名氏《来生债》第三折"},"example":{"text":"就是过了～，他的思想也不会落伍。"},"similar":["千秋万代"],"usage":"作宾语、定语；形容久远的年代"},{"id":9604,"word":"千式百样","pinyin":"qiān shì bǎi yàng","abbr":"qsby","explanation":"各种各样。","example":{"text":"五指山区的蝴蝶～，应有尽有。"},"similar":["各种各样"],"usage":"作谓语、定语；形容种类多"},{"id":9605,"word":"千形一貌，百喙一声","pinyin":"qiān xíng yī mào，bǎi huì yī shēng","abbr":"qxymbhys","explanation":"喙：鸟嘴。形容众口一辞或文章模式划一。","source":{"text":"引绳墨，立橅型，如村塾之训蒙，如琐院之课士，俾千形一貌，百喙一声。","book":"黄人《序》"},"similar":["千夫所言如一喙"],"usage":"作宾语、定语；用于书面语"},{"id":9606,"word":"千形万态","pinyin":"qiān xíng wàn tài","abbr":"qxwt","explanation":"形：形状。多种多样的形状。","source":{"text":"各自占一世界，而各自谓世界之大，已尽于是，此外千形万态，非所见也。","book":"梁启超《慧观》"},"similar":["千形万状"],"usage":"作谓语、定语、宾语；用于事物等"},{"id":9607,"word":"千形万状","pinyin":"qiān xíng wàn zhuàng","abbr":"qxwz","explanation":"各式各样的形状。形容变化多。","source":{"text":"摩拟肖似，而极于变化，千形万状，不可窥测。","book":"明·李东阳《题枯苍陈氏画》"},"similar":["千形万态","千姿百态"],"usage":"作谓语、定语、宾语；用于事物等"},{"id":9608,"word":"千态万状","pinyin":"qiān tai wàn zhuàng","abbr":"qtwz","explanation":"极言状态之多。","source":{"text":"于高堂素壁放手作长松巨木，回溪断崖，岩岫纔绝，峰峦秀起，云烟变灭晻霭之间，千态万状。","book":"南朝·梁武帝《龙教寺碑》：“浮屠涌现，千态万状。”《宣和画谱·山水》"},"example":{"text":"人情愈伪，～，劫运承之，圣人亦救不得。","book":"明·朱国桢《涌幢小品·吴建》"},"similar":["千状万态","千状万端"],"usage":"作谓语、定语、宾语；用于事物形态"},{"id":9609,"word":"千思万想","pinyin":"qiān sī wàn xiǎng","abbr":"qswx","explanation":"无数遍的思索、考虑。犹言千思万虑。形容用心极苦。","source":{"text":"千思万想，惟有乞休归田一节，可以慰此朝夕悬望之情而已耳。","book":"明·袁宏道《去吴七牍·乞归稿一》"},"example":{"text":"此事我已～，但你已许人，我已聘妇，没甚计策挽回，如之奈何。","book":"明·冯梦龙《醒世恒言》卷八"},"similar":["左思右想","千思万虑"],"usage":"作谓语、状语；形容反复思考"},{"id":9610,"word":"千思万虑","pinyin":"qiān sī wàn lǜ","abbr":"qswl","explanation":"形容反复思考或多方面思考。","source":{"text":"千思万虑尽如空，一笑一言真可贵。","book":"唐·刘禹锡《将赴汝州途出浚下留辞李相公》诗"},"example":{"text":"学者用功，虽～，只是要复他本来体用而已，不是以私意去安排思索出来。","book":"明·王守仁《传习录》卷中"},"similar":["千思百虑","千思万想"],"usage":"作谓语、宾语、状语；指反复思考"},{"id":9611,"word":"千思百虑","pinyin":"qiān sī bǎi lǜ","abbr":"qsbl","explanation":"虑：思考。形容反复思考。","source":{"text":"一空下来，他还要为你千思百虑的操心，替你想这样想那样。","book":"《傅雷家书·1954年7月29日》"},"example":{"text":"《傅雷家书·1954年7月29日》：“一空下来，他还要为你～的操心，替你想这样想那样。”"},"similar":["千思万虑"],"usage":"作谓语、宾语、状语；指反复思考"},{"id":9612,"word":"千恩万谢","pinyin":"qiān ēn wàn xiè","abbr":"qewx","explanation":"一再表示感恩和谢意。","source":{"text":"李助是个星卜家，得了银子，千恩万谢的辞了范全、王庆，来到段家庄回复。","book":"明·施耐庵《水浒全传》第一百四回"},"example":{"text":"三荷包听了此言，～，感激不尽。","book":"清·李宝嘉《官场现形记》第六回"},"similar":["感恩戴德"],"opposite":["恩将仇报"],"usage":"作谓语、宾语、状语；指十分感谢"},{"id":9613,"word":"千愁万恨","pinyin":"qiān chóu wàn hèn","abbr":"qcwh","explanation":"千、万：形容多。极言愁苦怨恨之多。","source":{"text":"依欲与君子归去来，千愁万恨付一杯。","book":"宋·杨万里《行路难》"},"example":{"text":"受尽了～废眠餐，捱至此夕偿心愿。","book":"明·陆采《怀香记·佳会赠香》"},"usage":"作宾语、定语；用于愁恨多"},{"id":9614,"word":"千愁万绪","pinyin":"qiān chóu wàn xù","abbr":"qcwx","explanation":"许许多多忧愁和思绪。","source":{"text":"好天良夜，无端惹起千愁万绪。","book":"宋·柳永《女冠子》"},"example":{"text":"这屋里是无边的空虚，空虚，～，都从晓枕上提起。","book":"冰心《南归》"},"usage":"作宾语、定语；用于人的心绪"},{"id":9615,"word":"千推万阻","pinyin":"qiān tuī wàn zǔ","abbr":"qtwz","explanation":"推：推拖。阻：阻拦。多次推拖阻拦。形容百般推辞、拒绝。","source":{"text":"邓尚书说亲，直恁千推万阻，见王太守乐意，却不顾五典三纲。","book":"元·柯丹丘《荆钗记·责婢》"},"example":{"text":"那两个童儿，见～不吃，只得拿着盘子，转回本房。","book":"明·吴承恩《西游记》第二十四回"},"usage":"作谓语、宾语、状语；用于推阻"},{"id":9616,"word":"千斤重担","pinyin":"qiān jīn zhòng dàn","abbr":"qjzd","explanation":"比喻重要的工作与任务。","source":{"text":"本是乖巧不过的人，落得把千斤重担卸在他身上。","book":"曾朴《孽海花》第六回"},"example":{"text":"这～只有你能挑。"},"similar":["重任在肩"],"usage":"作主语、宾语、定语；比喻重要的工作"},{"id":9617,"word":"千方万计","pinyin":"qiān fāng wàn jì","abbr":"qfwj","explanation":"想尽或用尽一切办法。同“千方百计”。","source":{"text":"譬如捉贼相似，须是着起气力精神，千方百计去赶他。","book":"宋·朱熹《朱子语类·论语十七》"},"example":{"text":"若论肯卖，不争价之高低；若死腰楔，方便直须下脱。～，不得不休。","book":"《敦煌煌文集·降魔变文》"},"similar":["千方百计"],"usage":"作状语、宾语；指想尽一切办法"},{"id":9618,"word":"千方百计","pinyin":"qiān fāng bǎi jì","abbr":"qfbj","explanation":"想尽或用尽一切办法。","source":{"text":"譬如捉贼相似，须是着起气力精神，千方百计去赶他。","book":"《朱子语类·论语十七》"},"example":{"text":"这个老匪开初～想收买这支已经武装了的工人队伍，可是工人们坚决拒绝加入匪股。","book":"曲波《林海雪原》十四"},"similar":["想方设法"],"opposite":["无计可施","束手无策"],"usage":"作状语、宾语；指想尽一切办法"},{"id":9619,"word":"千日打柴一日烧","pinyin":"qiān rì dǎ chái yī rì shāo","abbr":"qrdcyrs","explanation":"比喻持久奋斗而一旦成功。也比喻平时积攒，一朝花费。同“千日斫柴一日烧”。","example":{"text":"俗话说：～，我们还是充分准备吧。"},"usage":"作宾语、定语、分句；用于处事"},{"id":9620,"word":"千日斫柴一日烧","pinyin":"qiān rì zhuó chái yī rì shāo","abbr":"qrzcyrs","explanation":"①比喻持久奋斗而一旦成功。②比喻平时积攒，一朝花费。亦作“千日打柴一日烧”。"},{"id":9621,"word":"千日酒","pinyin":"qiān rì jiǔ","abbr":"qrj","explanation":"醉倒一千日的酒。形容有名的美酒。","source":{"text":"狄希，中山人也，能造千日酒，饮之千日醉。","book":"晋·干宝《搜神记》卷十九"},"example":{"text":"青布旗夸～，白头浪吼半江风。","book":"唐·韩偓《江岸闲步》"}},{"id":9622,"word":"千日醉酒","pinyin":"qiān rì zuì jiǔ","abbr":"qrzj","explanation":"喝了能醉一千天的酒。比喻好酒。","example":{"text":"你敢喝这～吗？"},"usage":"作宾语、定语；比喻好酒","story":["传说古代中山人狄希能够酿造一种“千日醉”酒，正在酿的过程中被刘玄石喝了一小口。刘玄石回到家里就一醉不醒，家人以为他死了，就把他埋葬。三年后，狄希去刘家看刘玄石酒醒了没有，一起开棺验看，刘玄石刚刚酒醒"]},{"id":9623,"word":"千村万落","pinyin":"qiān cūn wàn luò","abbr":"qcwl","explanation":"形容众多的村落。","source":{"text":"君不闻汉家山东二百州，千村万落生荆杞。","book":"唐·杜甫《兵车行》"},"example":{"text":"征戍诛求空轴杼，～无砧杵。","book":"明·刘基《渔家傲》词"},"usage":"作宾语、定语；指许许多多的村落"},{"id":9624,"word":"千条万端","pinyin":"qiān tiáo wàn duān","abbr":"qtwd","explanation":"犹言千言万语。形容说得话很多。","source":{"text":"帝闻大惊，让汉曰：‘比敕公千条万端，何意临事勃乱！’","book":"《后汉书·吴汉传》"},"example":{"text":"万一可往，不知老兄能一乘兴相过否？所欲扣者～，非面不能究，但恐不成行，即此会又未可知耳。","book":"宋·朱熹《答王南卿》"},"similar":["千头万绪"],"usage":"作谓语、宾语；用于人的心绪或事物等"},{"id":9625,"word":"千条万绪","pinyin":"qiān tiáo wàn xù","abbr":"qtwx","explanation":"犹千端万绪。形容事情杂，头绪多。","source":{"text":"千条万绪，贯通来只是一个道理。夫子所以说‘吾道一以贯之’，曾子曰‘忠恕而已矣’，是也。","book":"《朱子语类》卷四一"},"example":{"text":"说到‘民生主义’，因这里头～，成为一种科学，不是十分研究，不得清楚。","book":"孙中山《三民主义与中国前途》"},"similar":["千头万绪"],"usage":"作谓语、宾语；用于事物"},{"id":9626,"word":"千条万缕","pinyin":"qiān tiáo wàn lǚ","abbr":"qtwl","explanation":"形容条缕繁多。","source":{"text":"天与多情丝一把，谁厮惹，千条万缕萦心下。","book":"宋·欧阳修《渔家傲》词之十"},"example":{"text":"长干桥边杨柳枝，～郁金丝。","book":"明·刘基《杨柳枝》词之五"},"similar":["千条万端"],"usage":"作谓语、宾语、定语；用于心情或事物"},{"id":9627,"word":"千枝万叶","pinyin":"qiān zhī wàn yè","abbr":"qzwy","explanation":"树的枝叶很多。形容关系错综复杂。","source":{"text":"辟若伐树而引其本，千枝万叶，则莫得弗从也。","book":"《淮南子·缪称训》"},"example":{"text":"西岭松声落日秋，～风飕飗。","book":"唐·皎然《琴曲歌辞·风入松歌》"},"similar":["千丝万缕"],"usage":"作宾语、定语；用于树木等"},{"id":9628,"word":"千棰打锣，一棰定声","pinyin":"qiān chuí dǎ luó，yī chuí dìng shēng","abbr":"qcdlycds","explanation":"比喻在众说纷纭的情况下发表决定性的意见。同“千锤打锣，一锤定音”。"},{"id":9629,"word":"千欢万喜","pinyin":"qiān huān wàn xǐ","abbr":"qhwx","explanation":"非常欢喜。","source":{"text":"二十年没了父亲，今日见说爹在他乡，孩儿千欢万喜。","book":"明·范受益《寻亲记·报捷》"},"example":{"text":"那白氏是个记德不记仇的贤妇，念着同胞分上，将前情一笔都勾。相见之间，～。","book":"明·冯梦龙《醒世恒言》卷二十五"},"similar":["高高兴兴","欣喜若狂"],"opposite":["郁郁寡欢"],"usage":"作谓语、状语；指人高兴"},{"id":9630,"word":"千水万山","pinyin":"qiān shuǐ wàn shān","abbr":"qsws","explanation":"形容路途艰难遥远。同“千山万水”。","source":{"text":"我只道轻魂弱魄飞能去，又谁知千水万山途转修。","book":"清·洪昇《长生殿·尸解》"},"similar":["千山万水"],"usage":"作宾语、定语；形容路途的艰难"},{"id":9631,"word":"千汇万状","pinyin":"qiān huì wàn zhuàng","abbr":"qhwz","explanation":"种类纷繁，形态多样。","source":{"text":"逮至子美之诗，周情孔思，千汇万状，茹古涵今，无有涯也。","book":"宋·蔡梦弼《草堂诗话》第一卷"},"example":{"text":"明·叶蕃《序》：“其盖世之姿，雄伟之志，用天下国家之心，得不发为～之奇，而龙翔虎跃也。”"},"usage":"作宾语、定语；用于事物等"},{"id":9632,"word":"千沟万壑","pinyin":"qiān gōu wàn hè","abbr":"qgwh","explanation":"①形容沟壑极多。②比喻道路坎坷不平。","source":{"text":"面前，还有望不断的千沟万壑。","book":"贺敬之《放声歌唱》"},"example":{"text":"这太行山里是～。"},"usage":"作宾语、定语；指地势不平"},{"id":9633,"word":"千灾百病","pinyin":"qiān zāi bǎi bìng","abbr":"qzbb","explanation":"指大大小小的各种疾病。","source":{"text":"老老，我的命交给你了。我的巧姐儿也是千灾百病的，也交给你了。","book":"清·曹雪芹《红楼梦》第一百十三回"}},{"id":9634,"word":"千灾百难","pinyin":"qiān zāi bǎi nàn","abbr":"qzbn","explanation":"指多灾多难。","source":{"text":"自从逃难以来，这位在千灾百难中，宁死也要把小王抚养成人的母亲，这位……没吃过一顿饱饭。","book":"周立波《暴风骤雨》第一部"},"similar":["多灾多难"],"usage":"作宾语、定语；用于灾难多"},{"id":9635,"word":"千状万态","pinyin":"qiān zhuàng wàn tai","abbr":"qzwt","explanation":"极言状态之多。同“千态万状”。","source":{"text":"及徐而定视，则千状万态，笔简而意足，是不亦为难哉。","book":"《宣和画谱·道释》：“至于鹰犬驰突，云龙出没，千状万态，势若飞动。”宋·欧阳修《题薛公期画》"},"example":{"text":"朝暮雨暘云烟出没之变，～，不可名模。","book":"宋·陆九渊《与王谦仲》"},"similar":["千态万状","千状万端"],"usage":"作谓语、定语、宾语；用于事物形态"},{"id":9636,"word":"千状万端","pinyin":"qiān zhuàng wàn duān","abbr":"qzwd","explanation":"形容极为愁苦。","source":{"text":"某忧痛愁苦，千状万端，书所以不能具。","book":"宋·王安石《与孙侔书》"},"similar":["千状万态"],"usage":"作谓语、定语、宾语；用于事物形态"},{"id":9637,"word":"千生万劫","pinyin":"qiān shēng wàn jié","abbr":"qswj","explanation":"指世世代代，永久。","source":{"text":"千生万劫难得见，如何一旦皆相亲。","book":"《剪灯余话·慢亭遇仙录》"},"similar":["世世代代"],"usage":"作主语、宾语；指世世代代"},{"id":9638,"word":"千生万死","pinyin":"qiān shēng wàn sǐ","abbr":"qsws","explanation":"指历尽艰险。","source":{"text":"吾等千生万死，身冒血战，夺得城池。","book":"明·罗贯中《三国演义》第33回"},"example":{"text":"她～，立下汗马功劳。"},"similar":["九死一生"],"usage":"作谓语、宾语、定语；用于人的经历"},{"id":9639,"word":"千疮百孔","pinyin":"qiān chuāng bǎi kǒng","abbr":"qcbk","explanation":"形容漏洞、弊病很多，或破坏的程度严重。","source":{"text":"汉室以来，群儒区区修补，百孔千疮，随乱随失，其危如一发引千钧。","book":"唐·韩愈《与孟尚书书》"},"example":{"text":"让他们都显显身手，谁能把这个～的中国从热火里救出来，算谁有本事。","book":"梁斌《红旗谱》四十九"},"similar":["满目疮痍"],"usage":"作谓语、宾语、定语；指漏洞多"},{"id":9640,"word":"千疮百痍","pinyin":"qiān chuāng bǎi yí","abbr":"qcby","explanation":"犹千疮百孔。形容漏洞、弊病很多，或破坏的程度严重。","source":{"text":"‘中农公司’留下的是千疮百痍的烂摊子。","book":"刘先煌《飞翔吧，上海机床厂》"},"similar":["千疮百孔"],"usage":"作谓语、宾语、定语；指漏洞多"},{"id":9641,"word":"千百为群","pinyin":"qiān bǎi wéi qún","abbr":"qbwq","explanation":"成百上千聚集成群。","source":{"text":"且西海北垂，即是大碛，野兽所聚，千百为群，正是蠕蠕射猎之处。","book":"《魏书·袁翻传》"},"example":{"text":"从峡转北，得中央平洼一围，牛千百为群，散处其内，名为牛陇。","book":"明·徐弘祖《徐霞客游记·粤西游日记二》"},"usage":"作宾语、定语；指数量多"},{"id":9642,"word":"千真万实","pinyin":"qiān zhēn wàn shí","abbr":"qzws","explanation":"形容情况非常确实。","source":{"text":"据叔叔说得千真万实，则是天地生人之性情，皆不灵矣，则是圣贤之名教，皆假设矣。","book":"清·名教中人《好逑传》第九回"},"similar":["千真万确"],"usage":"作谓语、定语、状语；指非常确实"},{"id":9643,"word":"千真万真","pinyin":"qiān zhēn wàn zhēn","abbr":"qzwz","explanation":"形容情况非常确实。","source":{"text":"提起姐妹，不是我当着姨太太的面奉承，千真万真，从我们家四个女孩儿算起，都不如宝丫头。","book":"清·曹雪芹《红楼梦》第35回"},"example":{"text":"清·曹雪芹《红楼梦》第35回：“提起姐妹，不是我当着姨太太的面奉承，～，从我们家四个女孩儿算起，都不如宝丫头。”"},"similar":["千真万确"],"usage":"作谓语、定语、状语；指非常确实"},{"id":9644,"word":"千真万确","pinyin":"qiān zhēn wàn què","abbr":"qzwq","explanation":"形容情况非常确实。","source":{"text":"这个南乡人，还说这个新闻是千真万确的。","book":"应修人《金字塔银宝塔》一"},"example":{"text":"我是从何营长的小公馆里得来的。营长的姨太太已经避到县里去了。还是雇的王麻子的船，～！","book":"茅盾《子夜》四"},"similar":["无可置疑","不容置疑","千真万实"],"opposite":["半信半疑","将信将疑"],"usage":"作谓语、定语、状语；指非常确实"},{"id":9645,"word":"千磨百折","pinyin":"qiān mó bǎi shé","abbr":"qmbs","explanation":"形容受磨难、遭曲折之多。","source":{"text":"人怀忠愤，如报私仇，千磨百折，有进无休。","book":"清·曾国藩《江忠烈公神道碑铭》"},"example":{"text":"矧在玉麟辈身经～图谋革命，武汉血战之苦，诸君与有何功。","book":"黄远庸《陆总理演说后之政界》"},"usage":"作宾语、定语；用于比喻句"},{"id":9646,"word":"千秋万世","pinyin":"qiān qiū wàn shì","abbr":"qqws","explanation":"①千年万年，形容岁月长久。②婉言帝王之死。","source":{"text":"今巫祝之祝人曰：‘使若千秋万岁。’千秋万岁之声恬耳，而一日之寿无征于人，此人所以简巫祝也。","book":"《韩非子·显学》"},"example":{"text":"～之下，便做鬼也还羞耻不过哩。","book":"明·周楫《西湖二集·徐君宝节义双圆》"},"similar":["千龄万代","千秋万代"],"usage":"作谓语、定语、状语；多指世世代代"},{"id":9647,"word":"千秋万代","pinyin":"qiān qiū wàn dài","abbr":"qqwd","explanation":"一千年，一万代。指世世代代，时间久长。","source":{"text":"千秋万古葬平原，素业清风及子孙。","book":"唐·刘长卿《哭陈歙州》"},"example":{"text":"幸福花开人人爱，～开不败。","book":"任德耀《马兰花》第一幕第一场"},"similar":["天长日久","世世代代"],"opposite":["弹指之间","指日可待"],"usage":"作定语、状语；指世世代代"},{"id":9648,"word":"千秋万古","pinyin":"qiān qiū wàn gǔ","abbr":"qqwg","explanation":"犹言千秋万代，形容岁月长久。","source":{"text":"百年同谢西山日，千秋万古北邙尘。","book":"唐·刘希夷《公子行》"},"example":{"text":"醉捧句吴匣中剑，斫断～愁。","book":"元·范楟《王氏能远楼诗》"},"similar":["万代千秋","千秋万代"],"usage":"作宾语、定语；指时间久长"},{"id":9649,"word":"千秋万岁","pinyin":"qiān qiū wàn suì","abbr":"qqws","explanation":"千年万年。形容岁月长久。","source":{"text":"今巫祝之祝人曰：‘使若千秋万岁。’千秋万岁之声恬耳，而一日之寿无征于人，此人所以简巫祝也。","book":"《韩非子·显学》"},"example":{"text":"～后，荣名安所之？乃误羡门子，噭噭今自蚩。","book":"汉·阮籍《咏怀诗·十九》"},"similar":["千秋万代"],"usage":"作宾语、状语；形容岁月长久","story":["战国时期，楚王与宠臣安陵君巡游云梦，随行有几千人。楚王兴起就打猎，一箭射死一只野狐。他十分高兴地说：“等到千秋万岁之后，谁能陪我一起快乐？”安陵君立即跪拜说：“我愿意与大王一道去黄泉，为大王驱赶蝼蚁，侍侯在你的左右。”"]},{"id":9650,"word":"千秋万载","pinyin":"qiān qiū wàn zǎi","abbr":"qqwz","explanation":"千秋：千年。形容经历的时间极为久远。","source":{"text":"今巫祝之祝人曰：‘使若千秋万岁。’千秋万岁之声恬耳，而一日之寿无征于人，此人所以简巫祝也。","book":"《韩非子·显学》"},"example":{"text":"我们大家勤勤俭俭，在积攒一份大家当——～的家当呢。","book":"欧阳山《金牛和笑女》"}},{"id":9651,"word":"千秋之后","pinyin":"qiān qiū zhī hòu","abbr":"qqzh","explanation":"人死后的婉称。","source":{"text":"千秋之后，传梁王。","book":"西汉·司马迁《史记》"},"example":{"text":"待我～，你可以为所欲为了。"},"similar":["百年之后"],"usage":"作谓语、定语；指人死后"},{"id":9652,"word":"千秋人物","pinyin":"qiān qiū rén wù","abbr":"qqrw","explanation":"指名垂后世的人物。","source":{"text":"千秋人物三分国，一片山河百战场。","book":"清·赵翼《赤壁》诗"},"example":{"text":"～谈燕赵，万劫河山吊吴越。"},"usage":"作主语、宾语；用于大人物"},{"id":9653,"word":"千秋大业","pinyin":"qiān qiū dà yè","abbr":"qqdy","explanation":"长久的、伟大的功业或事业。","source":{"text":"千秋大业真吾事，临别叮咛不敢忘。","book":"清·陈确《平水东岳庙谢别先生》"},"example":{"text":"认为北京城在二三日内必定不攻自破，然后传檄而定江南，～从此奠定。","book":"姚雪垠《李自成》第四卷第六章"},"usage":"作主语、宾语、定语；用于事业等"},{"id":9654,"word":"千章万句","pinyin":"qiān zhāng wàn jù","abbr":"qzwj","explanation":"犹千言万语。指书面文字。","source":{"text":"千章万句卒非我，急走投君应已迟。","book":"宋·苏轼《次韵孔毅甫集古人句见赠》"},"example":{"text":"宋·苏轼《次韵孔毅甫集古人句见赠》：“～卒非我，急走投君应已迟。”"},"similar":["千言万语"],"usage":"作主语、宾语；同“千言万语”"},{"id":9655,"word":"千端万绪","pinyin":"qiān duān wàn xù","abbr":"qdwx","explanation":"形容事情杂，头绪多。","source":{"text":"求道益命，千端万绪，皆须五帝六甲灵飞之术。","book":"《汉武帝内传》"},"example":{"text":"经济学之概说，～，分类周详。","book":"孙中山《社会主义之派别及方法》"},"similar":["千头万绪","万绪千端"],"usage":"作宾语；形容事情杂，头绪多"},{"id":9656,"word":"千篇一律","pinyin":"qiān piān yī lǜ","abbr":"qpyl","explanation":"一千篇文章都一个样。指文章公式化。也比喻办事按一个格式，非常机械。","source":{"text":"今程试文字，千人一律，考官亦厌之。","book":"南朝梁·钟嵘《诗品》卷中：“张公虽复千篇，犹一体耳。”宋·苏轼《答王庠书》"},"example":{"text":"她又开始说起～的恳求的话语来了。","book":"沙汀《磁力》"},"similar":["千人一面","如出一辙"],"opposite":["千差万别","形形色色"],"usage":"作谓语、宾语、状语；指一个模式","story":["晋朝时期，司空张华经常模仿东汉时期著名诗人王粲的作品作诗，他的诗多叙写儿女柔情，讲究绮丽的辞藻和修辞。在当时小有名气。但真正内行人并不十分欣赏他的作品。南朝诗人谢灵运评价他的诗是千篇一律没有新意"]},{"id":9657,"word":"千红万紫","pinyin":"qiān hóng wàn zǐ","abbr":"qhwz","explanation":"形容百花齐放，色彩艳丽。也比喻事物丰富多彩。","source":{"text":"人间得意，千红万紫，转头春尽。","book":"宋·辛弃疾《水龙吟》词"},"example":{"text":"～随春去，独立溪头看荔花。","book":"元·赵文《意行》诗"},"similar":["万紫千红","万红千紫"],"usage":"作谓语、定语；指事物丰富多彩"},{"id":9658,"word":"千绪万端","pinyin":"qiān xù wàn duān","abbr":"qxwd","explanation":"犹千端万绪。形容事情杂，头绪多。","source":{"text":"终日敛膝危坐，阃外多事，千绪万端，罔有遗漏。","book":"《晋书·陶侃传》"},"example":{"text":"为今日中国之民，离今日中国之境，应当有多少感想齐攒心头？不过虱多不痒，债多不愁，～，何从讲起？","book":"林语堂《自传拾遗》第五辑一"},"similar":["千端万绪","万绪千端"],"usage":"作宾语、定语；形容事情杂，头绪多"},{"id":9659,"word":"千羊之皮，不如一狐之腋","pinyin":"qiān yáng zhī pí，bù rú yī hú zhī yè","abbr":"qyzpbryhzy","explanation":"比喻众愚不如一贤。","source":{"text":"大夫无罪，吾闻千羊之皮，不如一狐之腋。诸大夫朝，徒闻唯唯，不闻周舍之谔谔，是以忧也。","book":"西汉·司马迁《史记·赵世家》"},"usage":"作宾语、定语、分句；用于书面语","story":["战国时期，赵国赵简子手下大臣周舍，为人正直，喜欢直言不讳，深受赵简子的喜爱。周舍死后，简子每次上朝都不高兴，下面的大夫马上请罪。简子说：“大夫无罪，吾闻千羊之皮，不如一狐之腋。诸大夫朝，徒闻唯唯，不闻周舍之谔谔，是以忧也。”"]},{"id":9660,"word":"千胜将军","pinyin":"qiān shèng jiāng jūn","abbr":"qsjj","explanation":"形容善于用兵，屡战屡胜的将领。","source":{"text":"张巡守睢阳时，善出奇败贼，亦名千胜将军。","book":"宋·陈善《志》"}},{"id":9661,"word":"千虑一失","pinyin":"qiān lǜ yī shī","abbr":"qlys","explanation":"失：错误。指聪明人的考虑，也会有不周到的地方。","source":{"text":"婴闻之：圣人千虑，必有一失； 愚人千虑，必有一得。","book":"春秋·齐·晏婴《晏子春秋·内篇杂下十八》"},"example":{"text":"著书之家，～，往往有之。","book":"清·俞樾《春在堂随笔》第五卷"},"opposite":["千虑一得"],"usage":"作宾语；指聪明人的考虑，也会有不周","story":["春秋时期，齐国相国晏婴为人正直为官清廉，生活非常俭朴。齐景公手下人亲眼目睹晏婴的贫困生活，就向齐景公汇报。齐景公派人送去千金给他接待宾客用。晏婴百般推辞不受说“圣人千虑，必有一失；","愚人千虑，必有一得。”"]},{"id":9662,"word":"千虑一得","pinyin":"qiān lǜ yī dé","abbr":"qlyd","explanation":"即使愚笨的人，在很多次考虑中也总会有些可取的地方。多用来表示自谦。","source":{"text":"婴闻之：圣人千虑，必有一失； 愚人千虑，必有一得。","book":"《晏子春秋·杂下十八》"},"example":{"text":"寄虽疾侵耄及，言无足采，～，请陈愚算。","book":"《南史·虞寄传》"},"similar":["引玉之砖","抛砖引玉"],"opposite":["千虑一失"],"usage":"作宾语、定语；多用来表示自谦","story":["春秋时期，齐国相国晏婴为人正直为官清廉，生活非常俭朴。齐景公手下人亲眼目睹晏婴的贫困生活，就向齐景公汇报。齐景公派人送去千金给他接待宾客用。晏婴百般推辞不受说“圣人千虑，必有一失；","愚人千虑，必有一得。”"]},{"id":9663,"word":"千补百衲","pinyin":"qiān bǔ bǎi nà","abbr":"qbbn","explanation":"形容衣服很破，补了又补。","source":{"text":"戴一顶十花九裂遮尘帽，穿一件千补百衲藏形袄。","book":"元·无名氏《醉太平·叹子弟》"},"example":{"text":"炕上坐着一个五十来岁的老婆子，两眼瞎了，发鬓白了，穿着一件～的蓝布大衫子。","book":"周立波《暴风骤雨》第一部"},"usage":"作谓语、定语；用于人的衣服"},{"id":9664,"word":"千言万语","pinyin":"qiān yán wàn yǔ","abbr":"qywy","explanation":"形容说得话很多。","source":{"text":"千言万语无人会，又逐流莺过短墙。","book":"唐·郑谷《燕》诗"},"example":{"text":"两人对望着，好像没有话说了，其实心里正有着～。","book":"巴金《家》三十六"},"similar":["滔滔不绝","千语万言"],"opposite":["只言片语","三言两语"],"usage":"作谓语、宾语；形容说话很多"},{"id":9665,"word":"千言万说","pinyin":"qiān yán wàn shuō","abbr":"qyws","explanation":"犹千言万语。形容说得话很多。","source":{"text":"千言万说，卒赏谓何。","book":"《鹖冠子·世兵》"},"similar":["千言万语"],"usage":"作谓语、宾语；形容说话很多"},{"id":9666,"word":"千语万言","pinyin":"qiān yǔ wàn yán","abbr":"qywy","explanation":"形容说得话很多。同“千言万语”。","source":{"text":"千语万言劝解太子，如风过耳，不肯回朝。","book":"《四游记·太子被戏下武当》"},"example":{"text":"就费尽了～，有时只不过是激起冷笑的猛潮，反抗的烈火罢了。","book":"郭沫若《落叶·第十信》"},"similar":["千言万语"],"opposite":["三言两语"],"usage":"作谓语、宾语；形容说话很多"},{"id":9667,"word":"千载一会","pinyin":"qiān zǎi yī huì","abbr":"qzyh","explanation":"一千年才有一次机会。形容机会难得。","source":{"text":"千载一会，论说无疑。","book":"汉·王褒《圣主得贤臣颂》"},"example":{"text":"诸事具长史所见，将军所知。王者迭兴，～。","book":"《后汉书·窦融传》"},"similar":["千载一合","千载一逢"],"opposite":["司空见惯"],"usage":"作谓语、定语、宾语；指机会极其难得"},{"id":9668,"word":"千载一合","pinyin":"qiān zài yī hé","abbr":"qzyh","explanation":"一千年才有这么一个时机。形容机会极其难得。同“千载一时”。","source":{"text":"上下俱欲，欢然交欣，千载一合，论说无疑。","book":"《汉书·王襃贾传》"},"similar":["千载一会","千载一遇"],"opposite":["司空见惯"],"usage":"作谓语、定语、宾语；指机会极其难得"},{"id":9669,"word":"千载一圣","pinyin":"qiān zǎi yī shèng","abbr":"qzys","explanation":"千年出一圣人。指圣人不常有。","source":{"text":"若干载一圣，不复作起，则泉源混浊，谁能征之？","book":"《后汉书·儒林传》"}},{"id":9670,"word":"千载一弹","pinyin":"qiān zǎi yī dàn","abbr":"qzyd","explanation":"极言彼此交情深厚，甚为难得。","source":{"text":"典出《汉书·王吉传》：“吉与财禹为友，世称‘王阳在位，财公弹冠’，言其取舍同也。”吉，字子阳。"},"example":{"text":"人亦有言，交道实难。有頍者弁，～。今我与子，旷世齐欢。","book":"晋·陆机《赠冯文罴迁斥丘令》诗之四"},"usage":"作宾语、定语；用于知音"},{"id":9671,"word":"千载一日","pinyin":"qiān zǎi yī rì","abbr":"qzyr","explanation":"犹千载一时。一千年才有这么一个时机。形容机会极其难得。","source":{"text":"龟龙剥兮皇象书，千载一日兮传赤乌。","book":"元·寿宁《静安八咏·赤乌碑》"},"similar":["千载一时","千岁一时"],"opposite":["习以为常"],"usage":"作谓语、定语、宾语；指机会难得"},{"id":9672,"word":"千载一时","pinyin":"qiān zǎi yī shí","abbr":"qzys","explanation":"一千年才有这么一个时机。形容机会极其难得。","source":{"text":"遇千载一时之运，顾智力屈于当年。","book":"晋·王羲之《与会稽王笺》"},"example":{"text":"圣天子赫然有意～之治，删弃文法，捐除科条，裁损吏议，亲总其大纲大纪，以进退一世。","book":"清·龚自珍《明良论》"},"similar":["千载难逢","百年不遇","铁树开花"],"opposite":["习以为常","俯拾即是"],"usage":"作谓语、定语、宾语；指机会难得"},{"id":9673,"word":"千载一逢","pinyin":"qiān zǎi yī féng","abbr":"qzyf","explanation":"一千年里也难碰到一次。形容机会极其难得。同“千载一遇”。","source":{"text":"千载一逢，再造难答。","book":"《梁书·任昉传》"},"example":{"text":"此又～之机会，于此举尤宜者也。","book":"清·冯桂芬《致姚衡堂书》"},"similar":["千载一遇"],"opposite":["司空见惯"],"usage":"作谓语、定语、宾语；指机会极其难得"},{"id":9674,"word":"千载一遇","pinyin":"qiān zǎi yī yù","abbr":"qzyy","explanation":"一千年才可遇到一次。形容机会难得。","source":{"text":"耿况彭宠，俱遭际会，顺时乘风，列为藩辅，忠孝之策，千载一遇也。","book":"《东观汉记·耿况传》"},"similar":["千载一逢","千载一合"],"opposite":["司空见惯"],"usage":"作谓语、定语、宾语；指机会极其难得"},{"id":9675,"word":"千载奇遇","pinyin":"qiān zǎi qí yù","abbr":"qzqy","explanation":"形容极其难得遇到。","source":{"text":"自有那样一个肯受教的儿子，也算得个千载奇遇了。","book":"清·文康《儿女英雄传》第38回"},"example":{"text":"这真是～。"},"similar":["千载难逢"],"usage":"作宾语、定语；指很难遇到"},{"id":9676,"word":"千载流芳","pinyin":"qiān zǎi liú fāng","abbr":"qzlf","explanation":"芳：香，引申为好名声。好名声永远流传。","source":{"text":"子欲为名高也，则当如许由、子威、卞随、务光，洗耳逃禄，千岁流芳。","book":"晋·张敏《头责子羽文》"},"example":{"text":"燕昭没后多卿士，～郭隗台。","book":"唐·徐夤《草》诗"}},{"id":9677,"word":"千载独步","pinyin":"qiān zǎi dú bù","abbr":"qzdb","explanation":"独步：独一无二。形容古往今来绝无仅有，独一无二。","source":{"text":"自三代已来，风骚之后，驰驱屈宋，鞭挞扬马，千载独步，唯公一人。","book":"唐·李阳冰《草堂集序》"},"usage":"作谓语、定语；指杰出的人"},{"id":9678,"word":"千载难逢","pinyin":"qiān zǎi nán féng","abbr":"qznf","explanation":"一千年里也难碰到一次。形容机会极其难得。","source":{"text":"当此之际，所谓千载一时不可逢之嘉会。","book":"《南齐书·瘐杲之传》：“臣以凡庸，谬徼（侥）昌运，奖擢之厚，千载难逢。”唐·韩愈《潮州刺史谢上表》"},"example":{"text":"天下竟有如此奇事！怪不得叔叔说是我们闺中～际遇，真是旷古少有。","book":"清·李汝珍《镜花缘》第四十一回"},"similar":["千载一时","百年不遇"],"opposite":["唾手可得","司空见惯","家常便饭"],"usage":"作谓语、定语、分句；指机会极其难得","story":["唐朝著名文学家韩愈因一篇《谏迎佛骨表》得罪了唐宪宗，差点被杀头，幸得宰相裴度相救，才贬为潮州刺史。韩愈在潮州给唐宪宗上《潮州刺史谢上表》，鼓动唐宪宗去泰山封禅，希望自己也能参加这千载难逢的盛会"]},{"id":9679,"word":"千载难遇","pinyin":"qiān zǎi nán yù","abbr":"qzny","explanation":"一千年里也难碰到一次。形容机会极其难得。同“千载难逢”。","source":{"text":"卖力气挣钱既是那么不容易，人人盼望发点邪财；邪财既是那么千载难遇，所以有些彩气的必定是与众不同，福大命大。","book":"老舍《骆驼祥子》五"},"example":{"text":"老舍《骆驼祥子》：“邪财既是那么～，所以有些彩气的必定是与众不同。”"},"similar":["千载难逢","百年不遇"],"opposite":["司空见惯","习以为常"],"usage":"作谓语、定语、宾语；指机会极其难得"},{"id":9680,"word":"千辛万苦","pinyin":"qiān xīn wàn kǔ","abbr":"qxwk","explanation":"各种各样的艰难困苦。","source":{"text":"千辛万苦都尝遍，只有吴淞水最甘。","book":"元·张之翰《元日》"},"example":{"text":"侨胞的金钱不是容易得到的，是由于他们胼手胝足，～，省吃俭用，积累起来的。","book":"邹韬奋《抗战以来·热烈爱国的千万侨胞》"},"similar":["含辛茹苦","饱经风霜"],"opposite":["娇生惯养"],"usage":"作状语、宾语；指经历艰苦","story":["战国时期，秦晋两国交战，晋军军师先轸俘虏了秦军统帅孟明。晋襄公准备杀他祭祖庙，然后他的母夫人嬴氏求情放人。他考虑两国的交情就把孟明放了。先轸气得火冒三丈说：“我们这些士兵历尽千辛万苦才把他捉住，你却放虎归山。”"]},{"id":9681,"word":"千辛百苦","pinyin":"qiān xīn bǎi kǔ","abbr":"qxbk","explanation":"辛：劳苦。许许多多的艰难困苦。","source":{"text":"如今说一个妓家故事，虽比不得李亚仙、梁夫人恁般大才，却也在千辛百苦中熬炼过来，助夫成家。","book":"明·冯梦龙《警世通言》第31卷"},"similar":["千辛万苦","千难万苦"],"usage":"作状语、定语、宾语；指经历艰苦"},{"id":9682,"word":"千遍万遍","pinyin":"qiān biàn wàn biàn","abbr":"qbwb","explanation":"形容次数很多。","example":{"text":"我不止～地告戒你不能胡来。"},"similar":["屡次三番"],"usage":"作状语；形容次数很多，用于口语"},{"id":9683,"word":"千部一腔","pinyin":"qiān bù yī qiāng","abbr":"qbyq","explanation":"部：唐代管音乐的机构，按所管音乐的性质，区分为若干部。演奏的都是一个声调。比喻都是老一套，没有变化。","source":{"text":"至于才子佳人等书，则又开口‘文君’，满篇‘子建’，千部一腔，千人一面，且终不能不涉淫滥。","book":"清·曹雪芹《红楼梦》第一回"}},{"id":9684,"word":"千部一腔，千人一面","pinyin":"qiān bù yī qiāng，qiān rén yī miàn","abbr":"qbyqqrym","explanation":"成千部书都是一种写法，成千个人都是一个面孔。比喻都是老一套，没有变化（多指创作）。","source":{"text":"至于才子佳人等书，则又开口‘文君’，满篇‘子建’，千部一腔，千人一面，且终不能不涉淫滥。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["千篇一律"],"usage":"作宾语、定语、分句；指文艺创作或戏曲表演"},{"id":9685,"word":"千里一曲","pinyin":"qiān lǐ yī qǔ","abbr":"qlyq","explanation":"比喻举止随便，不拘小节。","source":{"text":"曷为以水地？河曲疏矣，河千里而一曲也。","book":"《公羊传·文公十二年》"},"example":{"text":"吾若万里长江，何能～。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"usage":"作谓语；比喻举止随便，不拘小节"},{"id":9686,"word":"千里不同风，百里不同俗","pinyin":"qiān lǐ bù tóng fēng，bǎi lǐ bù tóng sú","abbr":"qlbtfblbts","explanation":"指各地各有各的风俗习惯。","source":{"text":"百里而异习，千里而殊俗。","book":"《晏子春秋·问上》"},"example":{"text":"中国地大物博，～"},"usage":"作宾语、定语；用于书面语"},{"id":9687,"word":"千里不绝","pinyin":"qiān lǐ bù jué","abbr":"qlbj","explanation":"绝：断，断绝。千里不断。比喻道路绵延不断，非常漫长。","source":{"text":"今胡数涉北河之外，上覆飞鸟，下不见伏菟，斗城不休，救兵不止，死者相随，辇车相属，转粟流输，千里不绝。","book":"《汉书·邹阳传》"},"example":{"text":"金川地方山高林密，河湖纵横，烟瘴～。","book":"二月河《乾隆皇帝》二十四"}},{"id":9688,"word":"千里之任","pinyin":"qiān lǐ zhī rèn","abbr":"qlzr","explanation":"指远行千里的重任。后亦比喻重任。","source":{"text":"今处此而求大功，犹绊良骥之足，而责以千里之任。","book":"三国·魏·吴质《答东阿王书》"},"usage":"作主语、宾语；指责任大"},{"id":9689,"word":"千里之堤，毁于蚁穴","pinyin":"qiān lǐ zhī dī，huǐ yú yǐ xué","abbr":"qlzdhyyx","explanation":"一个小小的蚂蚁洞，可以使千里长堤溃决。比喻小事不注意会造成大乱子。","source":{"text":"知丈之堤，以蝼蚁之穴溃；百尺之室，以突隙之炽焚。","book":"《韩非子·喻老》"},"similar":["千里之堤，溃于蚁穴"],"usage":"作谓语、定语；用于劝诫方面"},{"id":9690,"word":"千里之堤，溃于蚁穴","pinyin":"qiān lǐ zhī dī，kuì yú yǐ xuè","abbr":"qlzdkyyx","explanation":"堤：堤坝；溃：崩溃；蚁穴：蚂蚁洞。一个小小的蚂蚁洞，可以使千里长堤溃决。比喻小事不慎将酿成大祸。","source":{"text":"千丈之堤，溃于蚁穴，以蝼蚁之穴溃；百尺之室，以突隙之烟焚。","book":"先秦·韩非《韩非子·喻老》"},"similar":["因小失大"],"opposite":["坚如磐石"],"usage":"作谓语、定语；用于劝诫方面","story":["战国时期，魏国相国白圭在防洪方面很有成绩，他善于筑堤防洪，并勤查勤补，经常巡视，一发现小洞即使是极小的蚂蚁洞也立即派人填补，不让它漏水，以免小洞逐渐扩大、决口，造成大灾害。白圭任魏相期间，魏国没有闹过水灾"]},{"id":9691,"word":"千里之志","pinyin":"qiān lǐ zhī zhì","abbr":"qlzz","explanation":"指远大的志向。","source":{"text":"与一举则有千里之志，德不盛，义不大则不至其郊。","book":"战国·卫·吕不韦《吕氏春秋·长利》"},"similar":["鸿鹄之志"],"usage":"作主语、宾语；用于志向"},{"id":9692,"word":"千里之行，始于足下","pinyin":"qiān lǐ zhī xíng，shǐ yú zú xià","abbr":"qlzxsyzx","explanation":"走一千里路，是从迈第一步开始的。比喻事情的成功，是从小到大逐渐积累起来的。","source":{"text":"合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。","book":"《老子》第六十四章"},"example":{"text":"九层之台，起于累土；～。圣人无常心，以百姓心为心。","book":"明·赵弼《两教辨》"},"similar":["积少成多","集腋成裘"],"opposite":["好高骛远"],"usage":"作谓语、定语；用于劝诫人","story":["春秋时期，著名的哲学家老子根据事物的发展规律提出谨小慎微和慎终如始的主张，他主张：处理问题要在它未发生以前。治理国家要在未乱之前。合抱的大树是细小的幼苗长成，九层的高台是一筐一筐泥土砌成的，千里远的行程是从脚下开始的"]},{"id":9693,"word":"千里之足","pinyin":"qiān lǐ zhī zú","abbr":"qlzz","explanation":"原指千里马。后也用以比喻英俊的人才。","source":{"text":"使骥不得伯乐，安得千里之足。造父亦无千里之手矣。","book":"汉·韩婴《韩诗外传》卷七"},"example":{"text":"延叔坚有王佐之才，奈何屈～乎？","book":"《后汉书·延笃传》"},"similar":["千里马"],"opposite":["无能之辈"],"usage":"作宾语；指有用之才"},{"id":9694,"word":"千里之路，不可直以绳","pinyin":"qiān lǐ zhī lù，bù kě zhí yǐ shéng","abbr":"qlzlbkzys","explanation":"千里长的路，不能够要求它像绳子一样直。形容人和事物各有不同，有优点也有缺点，不能用一个标准来衡量。","source":{"text":"千里之路，不可直以绳；万家之都，不可干以准。言大人之行，不必以先，帝常义立之谓资。","book":"《管子·宙合》"}},{"id":9695,"word":"千里之驹","pinyin":"qiān lǐ zhī jū","abbr":"qlzj","explanation":"驹：少壮马。比喻英俊的少年。","source":{"text":"宁昂昂若千里之驹乎？将泛泛若水之凫乎？","book":"战国·楚·屈原《楚辞·卜居》"},"example":{"text":"清·荑荻散人《玉娇梨》第14回：“我看贤侄英英器宇，自是～，异日当光吾宗，劣叔可免门户忧矣。”"},"usage":"作主语、宾语；用于比喻句"},{"id":9696,"word":"千里借筹","pinyin":"qiān lǐ jiè chóu","abbr":"qljc","explanation":"筹：策划。和远方朋友进行商量。","source":{"text":"受君恩，爵封列侯；镇江淮，千里借筹。","book":"清·孔尚任《桃花扇》"},"usage":"作谓语、宾语；用于书面语"},{"id":9697,"word":"千里共婵娟","pinyin":"qiān lǐ gòng chán juān","abbr":"qlgcj","explanation":"婵娟：指月亮。千里范围内的人共享明月。比喻不同地域的人共同享受同一样的良辰美景。","source":{"text":"婵娟：指月亮。千里范围内的人共享明月。比喻不同地域的人共同享受同一样的良辰美景。"}},{"id":9698,"word":"千里同风","pinyin":"qiān lǐ tóng fēng","abbr":"qltf","explanation":"比喻天下太平。","source":{"text":"夫千里不同风，百里不共雷。","book":"汉·王充《论衡·雷虚》"},"usage":"作宾语、定语；指天下太平"},{"id":9699,"word":"千里命驾","pinyin":"qiān lǐ mìng jià","abbr":"qlmj","explanation":"命驾：命令车夫驾车。指路远的好友造访。多形容友情深厚。","source":{"text":"东平吕安服康高致，每一相思，辄千里命驾，康友而善之。","book":"《晋书·嵇康传》"},"example":{"text":"你～来看我，我真是感激不尽。"},"usage":"作宾语、定语；指乘车去远方","story":["三国末期，“竹林七贤”的嵇康与吕安十分要好，两人的文风十分对路。虽然他们相距很远，吕安经常来拜访嵇康，有一次遇到嵇康不在家，他的哥哥嵇喜在。吕安不喜欢他，就在门上写一个“凤”字讥笑他。嵇康亲自千里命驾去拜访吕安"]},{"id":9700,"word":"千里始足下","pinyin":"qiān lǐ shǐ zú xià","abbr":"qlszx","explanation":"走一千里路，是从迈第一步开始的。比喻事情的成功，是从小到大逐渐积累起来的。","source":{"text":"合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。","book":"《老子》第六十四章"},"example":{"text":"～，高山起微尘。吾道亦如此，行知贵日新。","book":"唐·白居易《续座右铭》"}},{"id":9701,"word":"千里姻缘","pinyin":"qiān lǐ yīn yuán","abbr":"qlyy","explanation":"很远的婚姻缘分。","source":{"text":"自古道：‘千里姻缘一线牵’管姻缘的有一位月下老儿，预先注定，暗里只用一根红线，把这两个人的脚绊住。","book":"清·曹雪芹《红楼梦》第57回"},"example":{"text":"这～是靠谁来牵的。"},"usage":"作主语、宾语；指婚姻缘分等"},{"id":9702,"word":"千里姻缘一线牵","pinyin":"qiān lǐ yīn yuán yī xiàn qiān","abbr":"qlyyyxq","explanation":"指婚姻是由月下老人暗中用一红线牵连而成。","source":{"text":"唐·李复言《续玄怪录·定婚店》"},"example":{"text":"自古道：～。管姻缘的有一位月下老儿，预先注定，暗里只用一根红丝，把个人的脚绊住。","book":"清·曹雪芹《红楼梦》第五十七回"},"similar":["千里姻缘使线牵"],"usage":"作宾语、分句；指婚姻是命中注定","story":["唐朝时期，年轻的韦固路过宋城，遇一老人在月光下倚着一个布袋坐着，翻阅一本书。韦固问是什么书，老人回答说是天下人的婚姻簿，并说袋中有“赤绳”，如果把赤绳暗系在男女双方的腿上，他们不管相距多远就会结为夫妻，这叫千里姻缘一线牵"]},{"id":9703,"word":"千里姻缘使线牵","pinyin":"qiān lǐ yīn yuán shǐ xiàn qiān","abbr":"qlyysxq","explanation":"指婚姻是由月下老人暗中用一红线牵连而成。同“千里姻缘一线牵”。","source":{"text":"二诸葛说是个便宜，先问了一下生辰八字，掐算了半天说：‘千里姻缘使线牵’，就替小二黑收作童养媳。","book":"赵树理《小二黑结婚》"},"similar":["千里姻缘一线牵"],"usage":"作宾语、分句；指婚姻是命中注定"},{"id":9704,"word":"千里寄鹅毛","pinyin":"qiān lǐ jì é máo","abbr":"qljem","explanation":"比喻礼物虽然微薄，却含有深厚的情谊。同“千里送鹅毛”。","source":{"text":"且同千里寄鹅毛，何用孜孜饮麋鹿。","book":"宋·苏轼《扬州以土物寄少游》"},"similar":["千里鹅毛","千里送鹅毛"],"usage":"作宾语、定语；用于送礼等"},{"id":9705,"word":"千里投名，万里投主","pinyin":"qiān lǐ tóu míng，wàn lǐ tóu zhǔ","abbr":"qltmwltz","explanation":"旧时比喻慕名投靠。","source":{"text":"三位头领容复：小人‘千里投名，万里投主’，凭托柴大官人面皮，径投大寨入伙。林冲虽然不才，望赐收录。","book":"明·施耐庵《水浒全传》第十一回"}},{"id":9706,"word":"千里无烟","pinyin":"qiān lǐ wú yān","abbr":"qlwy","explanation":"指广大地区粮尽炊断。","source":{"text":"当今千里无烟，遗民困苦。","book":"《三国志·魏志·卫觊传》"},"example":{"text":"目断平野，～。万民剥落，不保朝昏。","book":"明·冯梦龙《醒世恒言》卷二十四"},"similar":["荒无人烟"],"usage":"作谓语、定语；指十分荒凉"},{"id":9707,"word":"千里犹面","pinyin":"qiān lǐ yóu miàn","abbr":"qlym","explanation":"比喻传达事情清楚确实。","source":{"text":"此人深识机宜，足堪委任，每为我儿陈事，必会人心，千里之外犹对面语耳。","book":"《旧唐书·房玄龄传》"},"usage":"作谓语、定语；指传达事情清楚","story":["隋朝末年，李渊在太原起兵，房玄龄立即投奔李世民，在李世民手下供职十多年，掌管各种文书的起草，他的文字功夫好，善于揣摩李世民的心意，深得李世民的喜爱。连李渊也夸奖他：“足堪委任，每为我儿陈事，必会人心，千里之外犹对面语耳。”"]},{"id":9708,"word":"千里眼","pinyin":"qiān lǐ yǎn","abbr":"qly","explanation":"眼睛能看清一千里外的东西。形容目光敏锐，看得极远。","source":{"text":"虽在暗室，终不进，咸言‘杨使君有千里眼，那可欺之’。","book":"《魏书·杨播传》"},"example":{"text":"公公，你定有～，否则小玄子那些手法，你怎能知道得清清楚楚。","book":"金庸《鹿鼎记》第四回"}},{"id":9709,"word":"千里神交","pinyin":"qiān lǐ shén jiāo","abbr":"qlsj","explanation":"相隔千里，精神契合。指友情深厚。"},{"id":9710,"word":"千里移檄","pinyin":"qiān lǐ yí xí","abbr":"qlyx","explanation":"移：传送；檄：是时指一种公文。","source":{"text":"上奏南阳太守高赐等臧秽。赐等惧罪，遂共重赂大将军梁冀，冀为千里移檄，而固持之愈急。","book":"《后汉书·李固传》"},"example":{"text":"冀爱财如命，悉数收受，即替他～，嘱固从宽。","book":"蔡东藩《后汉演义》第四十六回"}},{"id":9711,"word":"千里结言","pinyin":"qiān lǐ jié yán","abbr":"qljy","explanation":"指与远方朋友相约之言。","source":{"text":"母曰：‘三年之别，千里结言，尔何相信之审邪？","book":"南朝·宋·范晔《后汉书·独行传·范式》"},"usage":"作宾语、定语；用于约定"},{"id":9712,"word":"千里莼羹","pinyin":"qiān lǐ chún gēng","abbr":"qlcg","explanation":"千里湖里莼菜做的汤，味道鲜美，不必用盐豉做调味品。泛指有地方风味的土特产。","source":{"text":"有千里莼羹，但未下盐豉耳。","book":"南朝宋·刘义庆《世说新语·言语》"},"example":{"text":"百年蓬鬓关心切，～与愿违","book":"金·王渥《驿口桥看白莲》诗"},"usage":"作主语、宾语；泛指有地方风味的土特产","story":["西晋时期，东吴大将陆抗的儿子陆机在老家隐居读书多年，后到首都洛阳去拜访当时很有权势的驸马王济。王济接见他时问他东吴有什么好吃的东西，陆机不卑不亢地回答道千里湖产的莼菜做的汤是十分出名的，与北方的奶酪不相上下"]},{"id":9713,"word":"千里迢迢","pinyin":"qiān lǐ tiáo tiáo","abbr":"qltt","explanation":"迢迢：遥远。形容路途遥远。","source":{"text":"辞亲别弟到山阳，千里迢迢客梦长。岂为友朋轻骨肉，只因信义迫中肠。","book":"明·冯梦龙《古今小说·范巨卿鸡黍死生交》"},"example":{"text":"李少荃要讲和，曾国荃只主战，派了唐景崧，～来把将军见。","book":"清·曾朴《孽海花》第六回"},"similar":["不远千里","天南海北"],"opposite":["一墙之隔","朝发夕至","近在咫尺"],"usage":"作谓语、定语、状语、分句；形容路途遥远","story":["传说汉明帝时期，汝州南城秀才张邵与楚州山阳秀才范式，两人结伴到洛阳应试。他们结为莫逆之交，相约来年重阳在张邵家聚会。范式因经商误了约期，便自刎而死。他的灵魂千里迢迢去会张邵。张邵也千里迢迢去拜谒范式的尸体，之后也自刎而死"]},{"id":9714,"word":"千里迢遥","pinyin":"qiān lǐ tiáo yáo","abbr":"qlty","explanation":"形容路途非常遥远。","source":{"text":"不惮千里迢遥，寻兄长，存节孝。","book":"明·胡文焕《群音类选·桃园记·独行千里》"},"similar":["千里迢迢"],"usage":"作谓语、定语、状语、分句；形容路途遥远"},{"id":9715,"word":"千里送鹅毛","pinyin":"qiān lǐ sòng é máo","abbr":"qlsem","explanation":"比喻礼物虽然微薄，却含有深厚的情谊。","source":{"text":"鹅毛赠千里，所重以其人。","book":"宋·欧阳修《梅圣俞寄银杏》诗"},"example":{"text":"千里鹅毛意不轻，瘴衣腥腻北归客。","book":"宋·黄庭坚《谢陈适用惠送吴南雄所赠纸》诗"},"similar":["千里寄鹅毛","千里鹅毛"],"usage":"作宾语、定语；常与“礼轻人意重”连用","story":["唐朝一地方官为表达对皇帝的敬意，派缅伯高给皇上进贡一只天鹅。缅伯高爬山涉水，经过沔阳湖时给天鹅洗澡，天鹅逃跑，只剩下一根鹅毛，只好写诗“上复唐天子，可饶缅伯高。礼轻人意重，千里送鹅毛。”皇帝没有怪罪并奖赏他"]},{"id":9716,"word":"千里送鹅毛，礼轻情意重","pinyin":"qiān lǐ sòng é máo，lǐ qīng qíng yì zhòng","abbr":"qlsemlqqyz","explanation":"比喻礼物虽然微薄，却情谊深重。","source":{"text":"千里送鹅毛，礼轻情意重！大家不要客气，吃一点！","book":"吴强《红日》第15章"},"usage":"作宾语、定语；用于送礼等"},{"id":9717,"word":"千里餽粮，士有饥色","pinyin":"qiān lǐ kuì liáng，shì yǒu jī sè","abbr":"qlklsyjs","explanation":"指远粮不解近饥。"},{"id":9718,"word":"千里馈粮，士有饥色","pinyin":"qiān lǐ kuì liáng，shì yǒu jī sè","abbr":"qlklsyjs","explanation":"馈：赠送。缺粮时从千里之外送来，难免士兵挨饿。比喻远粮不解近饥，远水不解近渴。","source":{"text":"千里馈粮，士有饥色，虽有精兵名将，又岂能不饮不食。","book":"郑观应《盛世危言·恳荒》"},"similar":["远水不解近渴"],"usage":"作宾语、定语、分句；用于书面语"},{"id":9719,"word":"千里骏骨","pinyin":"qiān lǐ jùn gǔ","abbr":"qljg","explanation":"比喻贤才。","source":{"text":"若计此时有具眼人能破格欲求千里骏骨，难矣！","book":"明·李贽《复梅客生》"},"usage":"作宾语、定语；指贤才"},{"id":9720,"word":"千里鹅毛","pinyin":"qiān lǐ é máo","abbr":"qlem","explanation":"比喻礼物虽然微薄，却含有深厚的情谊。","source":{"text":"鹅毛赠千里，所重以其人。","book":"宋·欧阳修《梅圣俞寄银杏》诗"},"example":{"text":"～意不轻，瘴衣腥腻北归客。","book":"宋·黄庭坚《谢陈适用惠送吴南雄所赠纸》诗"},"similar":["千里寄鹅毛","千里送鹅毛"],"usage":"作宾语、定语；用于送礼等"},{"id":9721,"word":"千金一刻","pinyin":"qiān jīn yī kè","abbr":"qjyk","explanation":"形容时间非常宝贵。","source":{"text":"春宵一刻值千金，花有清香月有阴。","book":"宋·苏轼《春夜》诗"},"example":{"text":"他飞琼伴侣，上元班辈，回廊月射幽晖，～。","book":"明·汤显祖《紫钗记·堕钗灯影》"},"usage":"作宾语；用于时间"},{"id":9722,"word":"千金一壶","pinyin":"qiān jīn yī hú","abbr":"qjyh","explanation":"壶：通“瓠”，葫芦。比喻物虽轻贱，关键时得其所用，却十分珍贵。","source":{"text":"以千金一壶之身，当大厦一木之任。","book":"清·钱谦益《太子太保吏部尚书王公墓志铭》"},"similar":["千金一瓠"],"usage":"作定语；用于比喻句"},{"id":9723,"word":"千金一壸","pinyin":"qiān jīn yī kǔn","abbr":"qjyk","explanation":"比喻物虽轻贱，关键时得其所用，却十分珍贵。同“千金一瓠”。"},{"id":9724,"word":"千金一掷","pinyin":"qiān jīn yī zhì","abbr":"qjyz","explanation":"赌徒以千金为一注投掷。形容生活奢侈，用钱没有节制。","source":{"text":"莫惜连船沽美酒，千金一掷买春芳。","book":"唐·李白《寄王明府》诗"},"example":{"text":"～，百万十都。","book":"宋·李清照《打马赋》"},"similar":["一掷千金"],"usage":"作谓语、定语；形容生活奢华"},{"id":9725,"word":"千金一瓠","pinyin":"qiān jīn yī hù","abbr":"qjyh","explanation":"比喻物虽轻贱，关键时得其所用，却十分珍贵。","source":{"text":"当其乱之难讫，天且萦纡以延衍之；极乎其终，天为尽，天情且息，犹未尝无千金一瓠之几。","book":"清·王夫之《读书后》"},"similar":["千金一壶"],"usage":"作定语；用于比喻句"},{"id":9726,"word":"千金一笑","pinyin":"qiān jīn yī xiào","abbr":"qjyx","explanation":"犹言千金买笑。花费千金，买得一笑。旧指不惜重价，博取美人欢心。","source":{"text":"道千金一笑相逢夜，似近蓝桥那般欢惬。","book":"宋·张孝祥《虞美人》词之六：“倩人传语更商量，只得千金一笑也甘当。”明·汤显祖《紫钗记》第六出"},"example":{"text":"～，花柳空自来争；十斛片时，风月何曾肯让。","book":"《西湖佳话·西泠韵迹》"},"similar":["千金买笑"],"usage":"作宾语、定语；指纵情声色","story":["周幽王的妃子褒姒不爱笑，周幽王便命令点燃了告警的烽火，于是各诸侯王带领人马匆匆来救，结果并没有敌人。褒姒看到这种情况，开心大笑。周幽王说：“爱妃一笑，百媚俱生，这是虢石父的功劳。”于是赏给虢石父千两黄金"]},{"id":9727,"word":"千金一诺","pinyin":"qiān jīn yī nuò","abbr":"qjyn","explanation":"诺：许诺。一个诺言价值千金。指守信用，不轻易许诺。","source":{"text":"得黄金百斤，不如得季布一诺。","book":"《史记·季布栾布列传》"},"example":{"text":"酒后一言，就果然相赠，又不惮千里送来，你员外真可谓～矣。","book":"明·兰陵笑笑生《金瓶梅词话》第五十六回"},"similar":["一诺千金"],"opposite":["言而无信"],"usage":"作谓语、定语；指极守信用"},{"id":9728,"word":"千金不换","pinyin":"qiān jīn bù huàn","abbr":"qjbh","explanation":"指物品十分宝贵。","source":{"text":"这八个字，就是治阋墙病的千金不换的一剂妙药。","book":"清·李绿园《歧路灯》第96回"},"example":{"text":"这就是我～的东西。"},"similar":["千金不移"],"opposite":["一文不值"],"usage":"作谓语、定语；指十分宝贵"},{"id":9729,"word":"千金之体","pinyin":"qiān jīn zhī tǐ","abbr":"qjzt","explanation":"形容富贵女子的娇贵身体。","source":{"text":"况且姑娘这病，原是素日忧虑过度，伤了血气。姑娘的千金贵体，也别自己看轻了。","book":"清·曹雪芹《红楼梦》第六十七回"},"example":{"text":"我是当今名将之女，千金之体，决不落入流贼之手！","book":"姚雪垠《李自成》第三卷第二十一章"},"similar":["千金贵体"],"usage":"作主语、宾语；用于女性"},{"id":9730,"word":"千金之堤，溃于蚁壤","pinyin":"qiān jīn zhī dī，kuì yú yǐ rǎng","abbr":"qjzdkyyr","explanation":"堤：堤坝；溃：崩溃。一个小小的蚂蚁洞，可以使千里长堤溃决。比喻小事不慎将酿成大祸。","source":{"text":"乃举国家之事，不属之名义自持之清流，而委之以鄙贱干没之宵小，岂非千金之堤，溃于蚁壤哉？","book":"清·王夫之《读通鉴论·隋炀帝》"},"similar":["千金之堤，溃于蚁漏"],"usage":"作谓语、定语；用于劝诫方面"},{"id":9731,"word":"千金之堤，溃于蚁漏","pinyin":"qiān jīn zhī dī，kuì yú yǐ lòu","abbr":"qjzdkyyl","explanation":"堤：堤坝；溃：崩溃。一个小小的蚂蚁洞，可以使千里长堤溃决。比喻小事不慎将酿成大祸。","source":{"text":"堤：堤坝；溃：崩溃。一个小小的蚂蚁洞，可以使千里长堤溃决。比喻小事不慎将酿成大祸。"},"similar":["千里之堤，溃于蚁穴"],"usage":"作谓语、定语；用于劝诫方面"},{"id":9732,"word":"千金之子","pinyin":"qiān jīn zhī zǐ","abbr":"qjzz","explanation":"旧指富贵人家的子弟。","source":{"text":"臣闻千金之子坐不垂堂。","book":"西汉·司马迁《史记·袁盎晁错列传》"},"example":{"text":"合抱之木，不生于步仞之丘；～，不出于三家之市。","book":"宋·苏轼《仁宗皇帝御飞白记》"},"similar":["纨绔子弟","公子哥儿"],"usage":"作宾语；指富贵人家的子弟","story":["春秋末年，楚国人范蠡因助越王勾践复国有功，他担心勾践会借故杀他，就逃到定陶改名换姓就地经商。他的小儿子在楚国杀人被捕，他认为千金之子不应暴尸于大庭广众，于是派大儿子带千金去请庄生向楚王求情，事成后要回金子，楚王生气就杀了他弟弟"]},{"id":9733,"word":"千金之子，不死于市","pinyin":"qiān jīn zhī zǐ，bù sǐ yú shì","abbr":"qjzzbsys","explanation":"市：众人聚集的地方。指富贵人家子弟犯了死罪，可以免除服刑。","source":{"text":"谚曰：‘千金之子，不死于市。’此非空言也。","book":"西汉·司马迁《史记·货殖列传序》"},"usage":"作宾语、定语；用于书面语"},{"id":9734,"word":"千金之子，坐不垂堂","pinyin":"qiān jīn zhī zǐ，zuò bù chuí táng","abbr":"qjzzzbct","explanation":"垂堂：靠近屋檐的地方。家有千金的人不在屋檐下停留。形容有钱人非常看中自己的身体。","source":{"text":"臣闻千金之子，坐不垂堂。","book":"西汉·司马迁《史记·袁盎晁错列传》"},"example":{"text":"向在张因，尝以～昭示大众。","book":"章炳麟《与吴君遂书》"},"usage":"作宾语、定语；用于书面语"},{"id":9735,"word":"千金之家","pinyin":"qiān jīn zhī jiā","abbr":"qjzj","explanation":"指富豪之家。","source":{"text":"颠倒是非，飞片纸能丧数人之命；变乱黑白，造一言可破千金之家。","book":"《庄子·列御寇》：“朱泙漫学屠龙于支离益，单千金之家，三年技成而无所用其巧。”明·方汝浩《禅真逸史》第二十五回"},"example":{"text":"收纳逋逃，已干国纪；况此女入门，日费无度，即～，何能久也？","book":"清·蒲松龄《聊斋志异·霍女》"},"usage":"作主语、宾语；指富贵之家"},{"id":9736,"word":"千金之裘，非一狐之腋","pinyin":"qiān jīn zhī qiú，fēi yī hú zhī yè","abbr":"qjzqfyhzy","explanation":"价值千金的皮衣，决非一只狐狸的腋皮所能做成。比喻积小才能成大，集合大家的力量才能做成事情。","source":{"text":"太史公曰：语曰‘千金之裘，非一狐之腋也；台榭之榱，非一木之枝也；三代之际，非一代之智也。’","book":"《史记·刘敬叔孙通列传》"},"example":{"text":"～；绮罗之辈，非养蚕之人。","book":"明·程登吉《幼学琼林·衣服》"},"usage":"作宾语、定语；用于书面语"},{"id":9737,"word":"千金之诺","pinyin":"qiān jīn zhī nuò","abbr":"qjzn","explanation":"诺：许诺。许下的一个诺言有千金的价值。比喻说话算数，极有信用。","source":{"text":"得黄金百斤，不如得季布一诺。","book":"《史记·季布栾布列传》"},"example":{"text":"季布无朱家之藏，则～莫显。","book":"清·徐述夔《快士传·序》"}},{"id":9738,"word":"千金买笑","pinyin":"qiān jīn mǎi xiào","abbr":"qjmx","explanation":"花费千金，买得一笑。旧指不惜重价，博取美人欢心。","source":{"text":"齐讴秦吹卢女弦，千金雇笑买芳年。","book":"南朝宋·鲍照《代白纻曲》"},"example":{"text":"苏小小，张好好，～，今何在玉容花貌？","book":"元·张可久《春思》"},"similar":["千金一笑"],"usage":"作谓语、定语；指纵情声色","story":["周幽王的妃子褒姒不爱笑，周幽王便命令点燃了告警的烽火，于是各诸侯王带领人马匆匆来救，结果并没有敌人。褒姒看到这种情况，开心大笑。周幽王说：“爱妃一笑，百媚俱生，这是虢石父的功劳。”于是赏给虢石父千两黄金"]},{"id":9739,"word":"千金买赋","pinyin":"qiān jīn mǎi fù","abbr":"qjmf","explanation":"花一千金买一篇散文。指文章值钱。","source":{"text":"孝武皇帝、陈皇后，时得幸，颇妒，别在长门宫，愁闷悲思。闻蜀郡成都司马相如，天下工为文，奉黄金百斤……","book":"汉·司马相如《长门赋》序"},"example":{"text":"～的故事让人回味无穷。"},"similar":["量金买赋"],"usage":"作宾语、定语；指文章值钱","story":["西汉时期，汉武帝立表妹阿娇为皇后，陈皇后十年来没有生育儿子，嫉妒卫子夫妃子生儿子，被打入“长门宫”，失去了宠爱。她看了辞赋家司马相如的《子虚赋》，就送去一千金请他为自己写一篇《长门赋》，汉武帝看后就重新宠她"]},{"id":9740,"word":"千金买骨","pinyin":"qiān jīn mǎi gǔ","abbr":"qjmg","explanation":"花费千金，买千里马的骨头。比喻招揽人才的迫切。","source":{"text":"《战国策·燕策一》载：战国时，燕国昭王励精图治，决心广纳人才的典故。"},"example":{"text":"只需～，不怕没有人才。"},"similar":["千金市骨"],"usage":"作宾语、定语；指爱惜人才","story":["从前有一个嗜好玩马的国君想用千金征求千里马，三年没有买到。一个小侍臣自告奋勇担当寻找千里马的重任，不到三个月他找到一匹千里马，可要交钱时，马却死了。他仍用500金购回马骨。国君不解，侍臣说马就会来，国君果然如愿以偿"]},{"id":9741,"word":"千金小姐","pinyin":"qiān jīn xiǎo jiě","abbr":"qjxj","explanation":"古时对大户人家未婚女儿的敬称。","source":{"text":"你乃是官宦人家的千金小姐，请自稳便。","book":"元·张国宾《薛仁贵荣归故里》第四折"},"example":{"text":"据这诗句看来，此女实是～。我今给你十贯酒资，你也发个善心，把这小姐放了，积些阴功。","book":"清·李汝珍《镜花缘》第十三回"},"opposite":["村姑田妇"],"usage":"作主语、宾语、定语；多用于蔑视口吻"},{"id":9742,"word":"千金市骨","pinyin":"qiān jīn shì gǔ","abbr":"qjsg","explanation":"花费千金，买千里马的骨头。比喻罗致人才的迫切。","source":{"text":"千金市骨今何有，士或不价五羖皮。","book":"宋·黄庭坚《咏李伯时摹韩幹三马次苏子由韵》"},"example":{"text":"三品席珍虚鹿币，～上燕台。","book":"程善之《革命后感事和怀霜作即次其韵》"},"similar":["千金买骨"],"opposite":["怀才不遇","骥伏盐车"],"usage":"作宾语；比喻招揽人才的迫切","story":["从前有一个嗜好玩马的国君想用千金征求千里马，三年没有买到。一个小侍臣自告奋勇担当寻找千里马的重任，不到三个月他找到一匹千里马，可要交钱时，马却死了。他仍用500金购回马骨。国君不解，侍臣说马就会来，国君果然如愿以偿"]},{"id":9743,"word":"千金弊帚","pinyin":"qiān jīn bì zhǒu","abbr":"qjbz","explanation":"弊帚：破扫帚。一把破扫帚，看得同千金一样贵重。比喻东西虽然微贱，却十分珍惜重视。","source":{"text":"帝闻之，下诏让吴汉副将刘禹曰：‘城降，婴儿老母，口以万数，一旦放兵纵火，闻之可谓酸鼻。家有弊帚，享之千金。禹宗室子孙，故尝更职，何忍行此！’","book":"汉·班固《东观汉记·光武帝纪》"},"example":{"text":"千金弊帚那堪换，我亦淹留岂长算。","book":"宋·苏轼《次韵秦观……将入京应举》诗"}},{"id":9744,"word":"千金敝帚","pinyin":"qiān jīn bì zhǒu","abbr":"qjbz","explanation":"比喻自己的东西虽然微贱，却是十分珍贵的。","source":{"text":"千金敝帚那堪换，我亦淹留岂长算。","book":"宋·苏轼《次韵秦观秀才将入京应举》诗"},"example":{"text":"因念昔之好事，有什袭碔趺～者。","book":"明·胡应麟《少室山房笔丛·史书占毕引》"},"similar":["敝帚千金","敝帚自珍"],"usage":"作谓语、定语；指敝帚自珍"},{"id":9745,"word":"千金比屋","pinyin":"qian jing bi wu","abbr":"qjbw","explanation":"有千金财产的人家一家连着一家。"},{"id":9746,"word":"千金用兵，百金求间","pinyin":"qiān jīn yòng bīng，bǎi jīn qiú jiàn","abbr":"qjybbjqj","explanation":"极言用兵时离间对方的重要。"},{"id":9747,"word":"千金贵体","pinyin":"qiān jīn guì tǐ","abbr":"qjgt","explanation":"形容富贵女子的娇贵身体。","source":{"text":"况且姑娘这病，原是素日忧虑过度，伤了血气。姑娘的千金贵体，也别自己看轻了。","book":"清·曹雪芹《红楼梦》第六十七回"},"example":{"text":"姑娘跟夫人是～，莫理会旁人。","book":"金庸《雪山飞狐》第六章"},"similar":["千金之体"],"usage":"作主语、宾语、定语；用于女性"},{"id":9748,"word":"千金难买","pinyin":"qiān jīn nán mǎi","abbr":"qjnm","explanation":"形容某物的珍贵，不能用金钱买到。","source":{"text":"好弟兄宦业成，老夫妻福寿全，喜的是千金难买子孙贤。","book":"明·冯惟敏《商调·集贤宾·题长春园》"},"example":{"text":"一寸光阴一寸金，～寸光阴。"},"similar":["价值连城"],"opposite":["一文不值"],"usage":"作谓语、定语；形容珍贵"},{"id":9749,"word":"千钧一发","pinyin":"qiān jūn yī fà","abbr":"qjyf","explanation":"比喻情况万分危急。","source":{"text":"其危如一发引千钧。","book":"《汉书·枚乘传》：“夫以一缕之任，系千钧之重，上悬无极之高，下垂不测之渊，虽甚愚之人，犹知哀其将绝也。”唐·韩愈《与孟尚书书》"},"example":{"text":"正在～的时刻，一位不知名的解放军战士奋不顾身跳进冰冷的河水中，救起了落水儿童。"},"similar":["危在旦夕"],"opposite":["安然无恙","安如磐石"],"usage":"作谓语、定语；用于人或事十分危急","story":["西汉时期著名文学家枚乘，他擅长辞赋，他在吴王刘濞手下作郎中，刘濞想反叛朝廷，枚乘劝阻他说：“用一根头发系上千钧重的东西，上面悬在没有尽头的高处，下边是无底的深渊，这种情景就是再愚蠢的人都知道是极其危险的。”"]},{"id":9750,"word":"千钧重负","pinyin":"qiān jūn zhòng fù","abbr":"qjzf","explanation":"钧：古代的重量单位，合三十斤。比喻很沉重的负担。也比喻非常重大的责任。","source":{"text":"乌获举千钧之重，而不能以多力易人。","book":"《商君书·错法》"},"example":{"text":"如果继续不变的话，那就将给美国政府和美国人民以～和无穷祸害。","book":"毛泽东《评赫尔利政策的危险》"},"similar":["千斤重担"],"usage":"作宾语、定语；指非常重大的责任"},{"id":9751,"word":"千钱买邻","pinyin":"qiān qián mǎi lín","abbr":"qqml","explanation":"邻：邻居。花千万钱去买一个好邻居。指好邻居的难得可贵。","source":{"text":"秀才不必忧虑，自古道千钱买邻，八百买舍，老汉忝在邻居，你但放心前去。","book":"明·高明《琵琶记·蔡公逼试》"},"similar":["千万买邻"],"usage":"作宾语；指好邻居的难得可贵"},{"id":9752,"word":"千锤成利器","pinyin":"qiān chuí chéng lì qì","abbr":"qcclq","explanation":"形容人要经过长期的艰苦锻炼，才能成为有用之材。","source":{"text":"何意百炼刚，化为绕指柔。","book":"晋·刘琨《重赠卢谌》诗"}},{"id":9753,"word":"千锤打锣，一锤定声","pinyin":"qiān chuí dǎ luó，yī chuí dìng shēng","abbr":"qcdlycds","explanation":"比喻在众说纷纭的情况下发表决定性的意见。","source":{"text":"千锤打锣，一锤定声，最后还是中祥开了腔。","book":"李文亢《婚事》"},"similar":["千锤打锣，一锤定音"],"usage":"作宾语、定语、分句；用于总结等"},{"id":9754,"word":"千锤打锣，一锤定音","pinyin":"qiān chuí dǎ luó，yī chuí dìng yīn","abbr":"qcdlycdy","explanation":"比喻在众说纷纭的情况下发表决定性的意见。","source":{"text":"千锤打锣，一锤定音——队长，你就决定吧。","book":"郭澄清《大刀记》第十章"},"similar":["千锤打锣，一锤定声"],"usage":"作宾语、定语、分句；用于总结等"},{"id":9755,"word":"千锤百炼","pinyin":"qiān chuí bǎi liàn","abbr":"qcbl","explanation":"比喻经历多次艰苦斗争的锻炼和考验。也指对文章和作品进行多次精心的修改。","source":{"text":"百锻为字，千炼成句。","book":"晋·刘琨《重赠卢谌》诗：“何意百炼刚，化为绕指柔。”宋·尤袤《全唐诗话》卷三"},"example":{"text":"诗家好作奇句警语，必～而后能成。","book":"清·赵翼《瓯北诗话》卷一"},"similar":["精益求精","精雕细刻"],"opposite":["粗制滥造"],"usage":"作谓语、定语、状语；指经历考验","story":["晋朝时期，大将军刘琨一心想匡扶晋室，见到晋室内部争斗激烈，内心十分痛苦，他在《重赠卢湛》诗中抒发自己的感慨：“时哉不我与，去乎若云浮。朱实陨劲风，繁英落素秋。狭路倾华盖，骇驷摧双辀。何意百炼钢，化为绕指柔！”"]},{"id":9756,"word":"千镒之裘，非一狐之白","pinyin":"qiān yì zhī qiú，fēi yī hú zhī bái","abbr":"qyzqfyhzb","explanation":"镒：古时重量单位，合二十两；白：狐狸腋下的白毛皮。价值千金的皮衣，不是用一只狐狸的毛制成的。比喻治国需要众多人才的力量。","source":{"text":"是故江河之水，非一源之水也；千镒之裘，非一狐之白也。","book":"《墨子·亲士》"},"usage":"作宾语、定语、分句；用于书面语"},{"id":9757,"word":"千门万户","pinyin":"qiān mén wàn hù","abbr":"qmwh","explanation":"形容房屋广大或住户极多。","source":{"text":"于是作建章宫，度为千门万户。","book":"《史记·孝武本纪》"},"example":{"text":"不须迎向东郊去，春在～中。","book":"清·卢道悦《迎春》诗"},"similar":["万户千门"],"opposite":["单门独户"],"usage":"作定语、宾语；形容房屋广大或住户众多","story":["西汉时期，汉武帝苦心经营的柏梁殿遭到火灾焚毁，他十分伤心这座香气扑鼻的宫殿，就召集群臣商议再建宫室，勇之献策要建一座更大的房子来制服灾魔。于是继续用香柏建造章宫，宫内设置千门万户，规格远远超过未央宫，气势非常宏伟"]},{"id":9758,"word":"千闻不如一见","pinyin":"qiān wén bù rú yī jiàn","abbr":"qwbryj","explanation":"指听得再多还不如亲见更为可靠。","source":{"text":"安都谓摩诃曰：‘卿骁勇有名，千闻不如一见。’","book":"《陈书·萧摩诃传》"},"example":{"text":"王氏想道：“‘～。’虽说丈夫已死，在几千里之外，不知端的。”","book":"明·冯梦龙《警世通言》第五卷"},"similar":["百闻不如一见"],"usage":"作宾语、定语；形容了解事物不如亲自观察"},{"id":9759,"word":"千随百顺","pinyin":"qiān suí bǎi shùn","abbr":"qsbs","explanation":"随：追随；顺：顺从。形容完全顺随别人，别人要怎么样就怎么样。","source":{"text":"欲要见五祖七真，先受些千随百顺。","book":"元·杨景贤《刘行首》第一折"},"similar":["千依百随","百依百顺"],"usage":"作谓语、宾语、状语；用于处事"},{"id":9760,"word":"千难万苦","pinyin":"qiān nán wàn kǔ","abbr":"qnwk","explanation":"犹千辛万苦。各种各样的艰难困苦。","source":{"text":"因为有党的领导，中国人民经过千难万苦的奋斗，终于建立了中华人民共和国。","book":"邓小平《目前的形势和任务》"},"example":{"text":"在解放战争中，度过了～，战胜了死亡的威胁，换取了伟大胜利。","book":"胡采《序》"},"similar":["千辛万苦"],"usage":"作状语、定语、宾语；指经历艰苦"},{"id":9761,"word":"千难万险","pinyin":"qiān nán wàn xiǎn","abbr":"qnwx","explanation":"形容困难和危险极多。","source":{"text":"火焰山千难万险。","book":"元·杨景贤《西游记》第五本第四折"},"example":{"text":"他历尽了～终于回到了阔别五十年的老家。"},"similar":["山高水险"],"opposite":["畅通无阻","一帆风顺"],"usage":"作谓语、宾语；形容困难和危险极多"},{"id":9762,"word":"千难万难","pinyin":"qiān nán wàn nán","abbr":"qnwn","explanation":"犹言好不容易。","source":{"text":"干功名千难万难，求身仕两次三番。","book":"元·金仁杰《追韩信》第二折"},"example":{"text":"小生来这里走一遭，～。","book":"明·施耐庵《水浒传》第十五回"},"similar":["千难万险"],"usage":"作宾语、定语；用于口语"},{"id":9763,"word":"千顷陂","pinyin":"qiān qǐng bēi","abbr":"qqb","explanation":"顷：百亩；陂：池塘。形容度量宽广。","source":{"text":"叔度汪汪若千顷陂，澄之不清，淆之不浊，不可量也。","book":"《后汉书·黄宪传》"}},{"id":9764,"word":"千龄万代","pinyin":"qiān líng wàn dài","abbr":"qlwd","explanation":"犹千秋万代。极言岁月长久。","source":{"text":"天长地久时相忆，千龄万代一来游。","book":"唐·卢照邻《怀仙引》"},"similar":["千秋万代","千秋万世"],"usage":"作定语、状语；指世世代代"},{"id":9765,"word":"升堂入室","pinyin":"shēng táng rù shì","abbr":"strs","explanation":"升：登上；堂：厅堂；室：内室。古代宫室，前为堂，后为室。比喻学识或技能由浅入深，循序渐进，逐步达到很高的成就。","source":{"text":"子曰：‘由也升堂矣，未入于室也。’","book":"《论语·先进》"},"example":{"text":"娱心黄老，游志六艺，～，究其阃奥。","book":"《三国志·魏志·管宁传》"},"similar":["登堂入室"],"usage":"作谓语、定语；指人的学问等","story":["春秋时期，孔子的弟子子路为人直率，喜欢弹瑟，不爱读书，孔子开导他，他决定认真读书与弹瑟。他弹瑟的声音充满杀气，孔子给予纠正并表扬他：“子路弹瑟的本领已经登上厅堂，但尚未进入内室，已经有一定成就，但没到最高境界。”"]},{"id":9766,"word":"升堂拜母","pinyin":"shēng táng bài mǔ","abbr":"stbm","explanation":"升：登上；堂：古代指宫室的前屋。拜见对方的母亲。指互相结拜为友好人家。","source":{"text":"坚子策，与瑜同年，独相友善，瑜推道南大宅以舍策，升堂拜母，有无通共。","book":"《三国志·吴志·周瑜传》"},"usage":"作谓语；指结拜为友好人家"},{"id":9767,"word":"升堂有余","pinyin":"shēng táng yǒu yú","abbr":"styy","explanation":"升堂和入室是孔子用来比喻学问所达到的两种境界。比喻学问已经达到精深的境地。","source":{"text":"使贾谊见孔子，升堂有余矣。","book":"宋·苏轼《答谢民师书》"}},{"id":9768,"word":"升天入地","pinyin":"shēng tiān rù dì","abbr":"strd","explanation":"升：上升。上到天上，钻入地下。","source":{"text":"排空驭气奔如电，升天入地求之遍。","book":"唐·白居易《长恨歌》"},"usage":"作宾语、定语；指人的决心"},{"id":9769,"word":"升官发财","pinyin":"shēng guān fā cái","abbr":"sgfc","explanation":"指提升了官职，同时就能获得更多的物质财富。","source":{"text":"人家做官是升官发财，谁晓得我们做官是越做越穷，眼前当都没得当了！照此一天一天的下去，叫我怎么样呢！","book":"清·李宝嘉《官场现形记》第四十四回"},"example":{"text":"常四爷 再见吧，二位，盼着你们快快～！","book":"老舍《茶馆》第二幕"},"usage":"作宾语、定语；指官职提升，财源广进"},{"id":9770,"word":"升山采珠","pinyin":"shēng shān cǎi zhū","abbr":"sscz","explanation":"到山上去采珍珠。比喻办事的方向、方法错误，一定达不到目的。","source":{"text":"兴化致理，譬犹缘木求鱼，升山采珠。","book":"《后汉书·刘玄传》"},"similar":["缘木求鱼"],"usage":"作宾语、定语；指办事方法不对头"},{"id":9771,"word":"升斗之禄","pinyin":"shēng dǒu zhī lù","abbr":"sdzl","explanation":"一升一斗的俸禄。形容微薄的俸禄。","source":{"text":"言可采取者，秩以升斗之禄，赐以一束之帛。","book":"《汉书·梅福传》"},"example":{"text":"是则朝廷名器重，则～足以鼓舞豪杰，滥则日拜卿相而人不劝矣。","book":"清·毕沅《续资治通鉴》卷一百九十八"}},{"id":9772,"word":"升斗小民","pinyin":"shēng dǒu xiǎo mín","abbr":"sdxm","explanation":"家里没有多存粮食。比喻贫穷的老百姓。","source":{"text":"升斗小民，却立刻就感到了威胁，米店在闭城之前，就已歇业。","book":"高阳《胡雪岩全传·红顶商人》"},"example":{"text":"你怎么会看得上那些～呢？"},"opposite":["富商巨贾","达官贵人"],"usage":"作宾语、定语；指贫穷的人"},{"id":9773,"word":"升沉荣辱","pinyin":"shēng chén róng rǔ","abbr":"scrr","explanation":"指仕途中提升、贬谪、荣耀、屈辱等种种境遇。","source":{"text":"下官苏轼，自被谗谮，远贬遐荒，谁想得复天日，我想升沉荣辱，好无定啊。","book":"元·费唐臣《贬黄州》第四折"},"similar":["升迁荣辱"],"usage":"作主语、宾语、定语；用于书面语"},{"id":9774,"word":"升迁荣辱","pinyin":"shēng qiān róng rǔ","abbr":"sqrr","explanation":"升：上升；荣辱：显荣与耻辱。指宦途上的升迁与降职、荣显与失意。","source":{"text":"升迁荣辱，身外事耳，吾岂为此？所以然者，我心自有病也。","book":"《西湖佳话·白堤政迹》"},"similar":["升沉荣辱"],"usage":"作主语、宾语、定语；用于书面语"},{"id":9775,"word":"升高能赋","pinyin":"shēng gāo néng fù","abbr":"sgnf","explanation":"赋：写作。登得高，看得远，能够描绘形状，铺陈事势。指国家的有用人才。","source":{"text":"升高能赋，师旅能誓，……，君子能此九者，可谓有德音，可以为大夫。","book":"《诗经·鄘风·定之方中》：“终然允臧。”毛亨传"}},{"id":9776,"word":"升高自下","pinyin":"shēng gāo zì xià","abbr":"sgzx","explanation":"比喻事情的进行有一定的顺序。","source":{"text":"今王嗣有令绪，尚监兹哉。若升高，必自下，若陟遐，必自迩。","book":"《尚书·太甲下》"},"usage":"作定语；用于书面语"},{"id":9777,"word":"半三不四","pinyin":"bàn sān bù sì","abbr":"bsbs","explanation":"指心神不定，无精打采。","source":{"text":"勾引得官家一心在你身上，就在我身边，也是半三不四。","book":"《西湖二集·李凤娘酷妒遭天谴》"},"usage":"作谓语、定语；指人的心情"},{"id":9778,"word":"半上半下","pinyin":"bàn shàng bàn xià","abbr":"bsbx","explanation":"指两可之间。","source":{"text":"微子去却易，比干则索性死，他（箕子）在半上半下处，最是难。","book":"《朱子全书》卷十：“三年无改，谓是半上半下底事，在所当改者，但不可匆遽急改之。”又卷十九"},"similar":["进退维谷","上下两难"],"usage":"作定语；指出于中间位置"},{"id":9779,"word":"半上落下","pinyin":"bàn shàng luò xià","abbr":"bslx","explanation":"犹半途而废。","source":{"text":"人各有个知识，须是推致而极其至，不然半上落下，终不济事。","book":"《朱子全书》卷十五：“圣人不肯半上落下，直是做到底。”又卷九"},"similar":["半途而废"],"opposite":["自始至终"],"usage":"作宾语、定语；指半途而废"},{"id":9780,"word":"半丝半缕","pinyin":"bàn sī bàn lǜ","abbr":"bsbl","explanation":"缕：线。半根丝，半缕线。形容数量少，价值极其微小的东西。","source":{"text":"一粥一饭，当思来处不易；半丝半缕，恒念物力维艰。","book":"清·朱柏庐《治家格言》"},"example":{"text":"我们要爱惜家里的～。"},"similar":["一针一线"],"usage":"作宾语、定语；形容价值低微的东西"},{"id":9781,"word":"半亩方塘","pinyin":"bàn mǔ fāng táng","abbr":"bmft","explanation":"半亩池塘，形容很小的地方。","source":{"text":"宋·朱熹《观书有感》:“半亩方塘一鉴开。”"},"example":{"text":"竟不得～为立身之地","book":"清·李渔《闲情偶寄》"},"usage":"作宾语、定语；形容很小的地方"},{"id":9782,"word":"半价倍息","pinyin":"bàn jià bèi xī","abbr":"bjbx","explanation":"倍息：加倍的利息。指出一半价钱，获得成倍的利息。","source":{"text":"当其有者，半价而买，取倍称之息。","book":"《汉书·食货志》"}},{"id":9783,"word":"半伪半真","pinyin":"bàn wěi bàn zhēn","abbr":"bwbz","explanation":"伪：虚假；真：真实。一半虚伪，一半真实。指真假混杂，难以分辨。","source":{"text":"但其间半伪半真，尤为淆乱惑人，此深可叹，然具眼者，自默识耳。","book":"宋·严羽《沧浪诗话》"}},{"id":9784,"word":"半低不高","pinyin":"bàn dī bù gāo","abbr":"bdbg","explanation":"中等；不高不矮。","source":{"text":"我们行户人家，到是养成个半低不高的丫头。","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"她的身材～，还算不错。"}},{"id":9785,"word":"半信不信","pinyin":"bàn xìn bù xìn","abbr":"bxbx","explanation":"指不完全相信。","source":{"text":"苟卜筮所以成相，虎可卜而地可择，何为半信而半不信耶？","book":"三国·魏·嵇康《答释难宅无吉凶摄生论》"},"example":{"text":"定～，心中犹豫。","book":"《三国演义》第八七回"},"similar":["半信半疑","将信将疑"],"opposite":["难以置信","确信无疑"],"usage":"作谓语、定语、状语；形容似信非信"},{"id":9786,"word":"半信半疑","pinyin":"bàn xìn bàn yí","abbr":"bxby","explanation":"有点相信，又有点怀疑。表示对真假是非不能肯定。","source":{"text":"苟卜筮所以成相，虎可卜而地可择，何为半信而半不信耶？","book":"三国·魏·嵇康《答释难宅无吉凶摄生论》"},"example":{"text":"众人听了，也都～。","book":"清·曹雪芹《红楼梦》第九十四回"},"similar":["将信将疑","疑信参半"],"opposite":["坚信不疑","自信不疑","无可置疑"],"usage":"作谓语、定语、状语；形容似信非信"},{"id":9787,"word":"半半拉拉","pinyin":"bàn bàn lā lā","abbr":"bbll","explanation":"不完整或未全部完成的。","source":{"text":"最麻烦的是人多的时候，说得半半拉拉的，大家或者交头接耳说他们自己的私话，或者打盹儿，或者东看看西看看，轻轻敲着指头想别的，或者勉强打起精神对付着你。","book":"朱自清《论说话的多少》"},"example":{"text":"徐象谦读书的年头，不算少了，从私塾算起，按年头说，他比六年级生读的书还多。只是书读的～，很难说到了高小毕业。","book":"张麟 马长志《中国元帅徐向前》第四章"},"opposite":["完完全全"],"usage":"作谓语、定语、状语；用于口语"},{"id":9788,"word":"半半路路","pinyin":"bàn bàn lù lù","abbr":"bbll","explanation":"事物进行的过程中间。","example":{"text":"做任何事都要有恒心，不要～的。"}},{"id":9789,"word":"半吊子","pinyin":"bàn diào zǐ","abbr":"bdz","explanation":"肤浅的人。形容不通情理，说话随便，举止不沉稳的人。","source":{"text":"不必理会那个～。"},"example":{"text":"不必理会那个～"},"similar":["半瓶醋"],"usage":"作宾语、定语；用于骂人"},{"id":9790,"word":"半吐半露","pinyin":"bàn tǔ bàn lù","abbr":"btbl","explanation":"形容说话含糊不清，不直截了当。","source":{"text":"因贾母尚未说明，自已也不好拟定，遂半吐半露告诉贾母道：‘可惜了这孩子没福！前年他父亲就没了。’","book":"《红楼梦》第五十回"},"similar":["半吞半吐"],"opposite":["直截了当"],"usage":"作状语、定语；形容说话含糊"},{"id":9791,"word":"半吞半吐","pinyin":"bàn tūn bàn tǔ","abbr":"btbt","explanation":"形容说话含糊不清，不直截了当。","source":{"text":"参见“半吐半露”。"},"example":{"text":"你这大汉毕竟为甚杀他？从实说来！你莫～，俺不明白。","book":"《镜花缘》第二十八回"},"similar":["吞吞吐吐","半吐半露"],"opposite":["直截了当"],"usage":"作谓语、定语；形容说话含糊"},{"id":9792,"word":"半壁山河","pinyin":"bàn bì shān hé","abbr":"bbsh","explanation":"指国土的一部或大部分。","source":{"text":"半壁山河话战争，布衣空负鲁连名。","book":"李光《集诗述感》"},"example":{"text":"从此，革命的烈焰，迅速蔓延开去，不公燃遍了祖国～，而且转战大江南北约二十年之久。","book":"《前言》"},"similar":["半壁山河"],"opposite":["金瓯无缺"],"usage":"作主语、宾语；指保存丧失的部分国土"},{"id":9793,"word":"半壁江山","pinyin":"bàn bì jiāng shān","abbr":"bbjs","explanation":"半壁：半边；江山：比喻国家疆土。指在敌人入侵后残存或丧失的部分国土。","source":{"text":"半壁江山，比五季朝廷尤小。","book":"清·蒋士诠《冬青树·提纲》"},"example":{"text":"军声壮，阵法多，～全仗我。","book":"清·吴梅《风洞山·阅兵》"},"similar":["半壁河山","山河破碎","残山剩水"],"opposite":["一统天下","一统河山","金瓯无缺"],"usage":"作主语、宾语；指保存丧失的部分国土"},{"id":9794,"word":"半壁河山","pinyin":"bàn bì hé shān","abbr":"bbhs","explanation":"指国土的一部或大部分。","source":{"text":"昊《怀古》四首《咏岳忠武》云：‘将军野战最知名，半壁河山一力撑。’","book":"清·钮琇《觚剩·虎林军营唱和》"},"example":{"text":"～沉血海，几多知友化沙虫。","book":"陈毅《三十五岁生日寄怀》诗"},"similar":["半壁江山"],"opposite":["金瓯无缺"],"usage":"作主语、宾语；指保存丧失的部分国土"},{"id":9795,"word":"半夜三更","pinyin":"bàn yè sān gēng","abbr":"bysg","explanation":"一夜分为五更，三更是午夜十二时。指深夜。","source":{"text":"这船上是什么人，半夜三更，大呼小叫的。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"他常常工作到～。"},"similar":["深更半夜","三更半夜"],"opposite":["青天白日","大天白日"],"usage":"作谓语、定语、状语；泛指深夜"},{"id":9796,"word":"半夜敲门不吃惊","pinyin":"bàn yè qiāo mén bù chī jīng","abbr":"byqmbcj","explanation":"比喻没有做亏心的事。","source":{"text":"平生不作亏心事，半夜敲门不吃惊。","book":"元·无名氏《玎玎珰珰盆儿鬼》第二折"},"similar":["半夜敲门心不惊"],"usage":"作宾语、定语、分句；指心里踏实"},{"id":9797,"word":"半夜敲门心不惊","pinyin":"bàn yè qiāo mén xīn bù jīng","abbr":"byqmxbj","explanation":"比喻没有做过什么亏心的事，心里很踏实。","source":{"text":"日间不做亏心事，半夜敲门不吃惊。","book":"元·无名氏《陈州粜米》"},"example":{"text":"为人不做亏心事，～"},"similar":["半夜敲门不吃惊"],"usage":"作谓语、分句；指心里踏实"},{"id":9798,"word":"半天朱霞","pinyin":"bàn tiān zhū xiá","abbr":"btzx","explanation":"半天：空中；朱：红色。半空中的红霞。比喻人品高尚，超凡脱俗。","source":{"text":"訏超超越俗，如半天朱霞，敲矫矫出尘，如云中白鹤。皆俭岁之梁稷，寒年之纤纩。","book":"《南史·刘怀珍传附刘訏传》"}},{"id":9799,"word":"半子之谊","pinyin":"bàn zǐ zhī yì","abbr":"bzzy","explanation":"半子：女婿。半个儿子的情分。","source":{"text":"昔为兄弟，今为子婿，半子也。","book":"《旧唐书·回纥传》"},"example":{"text":"蘧公孙哀毁骨立，极尽～。","book":"清·吴敬梓《儒林外史》第12回"},"usage":"作主语、宾语；指女婿情分"},{"id":9800,"word":"半子之靠","pinyin":"bàn zǐ zhī kào","abbr":"bzzk","explanation":"半子：女婿。指以女婿为生活或养老的依靠。","source":{"text":"爹妈单生你一人，并无兄弟。你嫁得着人时，爹妈也得半子之靠。","book":"明·冯梦龙《醒世恒言》卷五"}},{"id":9801,"word":"半工半读","pinyin":"bàn gōng bàn dú","abbr":"bgbd","explanation":"一面劳动一面学习的个人学习方案。","source":{"text":"职业中学搞半工半读是肯定的，城市中还应该发展一批职业中学。","book":"邓小平《办教育一要普及二要提高》"},"similar":["勤工俭学"],"usage":"作谓语、宾语、定语；用于生活"},{"id":9802,"word":"半心半意","pinyin":"bàn xīn bàn yì","abbr":"bxby","explanation":"指对人或事物缺乏诚心，只是敷衍应付。","source":{"text":"要全心全意为人民服务，不要半心半意或者三分之二的心三分之二的意为人民服务。","book":"毛泽东《坚持艰苦奋斗，密切联系群众》"},"example":{"text":"咱们做事不要～。"},"similar":["敷衍应付","三心二意"],"opposite":["全心全意"],"usage":"作谓语、宾语、状语；指应付"},{"id":9803,"word":"半懂不懂","pinyin":"bàn dǒng bù dǒng","abbr":"bdbd","explanation":"不十分懂。","source":{"text":"他对人说话，总是满口之乎者也，教人～的。 ★初三教案《孔乙己》"},"example":{"text":"我听起来～的"},"similar":["似懂非懂"],"usage":"作谓语、状语、定语；指人技艺不精"},{"id":9804,"word":"半截入土","pinyin":"bàn jié rù tǔ","abbr":"bjrt","explanation":"截：段。半段身子埋入土内。比喻人在世不久了。","source":{"text":"汝已半截入土，犹争高下呼？","book":"宋·苏轼《东坡志林》卷十二"},"example":{"text":"差多了，差多了！人到三十五，就半截入土了。","book":"老舍《谁先到了重庆》第一幕"},"similar":["人近黄昏","人到中年"],"usage":"作谓语、定语；指人老快死"},{"id":9805,"word":"半推半就","pinyin":"bàn tuī bàn jiù","abbr":"btbj","explanation":"推：抵拒，推托；就：靠拢，迎上去。一面推辞，一面靠拢上去。形容装腔作势假意推辞的样子。","source":{"text":"半推半就，又惊又爱，檀口揾香腮。","book":"元·王实甫《西厢记》第四本第一折"},"example":{"text":"与其学那俗态，～，耽搁工夫；据俺主意，不如从实收了，倒也爽快。","book":"清·李汝珍《镜花缘》第三回"},"similar":["虚情假意","装模作样","半真半假"],"opposite":["拒人千里","闭门谢客","婉言谢绝"],"usage":"作定语、状语；指心里愿意，表面推辞"},{"id":9806,"word":"半文不值","pinyin":"bàn wén bù zhí","abbr":"bwbz","explanation":"比喻毫无价值或无能、品格卑下。","source":{"text":"倘若事事让他，他一定拿你看得半文不值。","book":"清·李宝嘉《官场现形记》第12回"},"example":{"text":"这个东西～。"},"similar":["不直一文","一文不值"],"usage":"作谓语、定语；用于价值"},{"id":9807,"word":"半文不白","pinyin":"bàn wén bù bái","abbr":"bwbb","explanation":"文言和白话夹杂。同“半文半白”。","source":{"text":"半文不白，半死不活的语言，对于大众仍旧是不顺的。","book":"鲁迅《关于翻译的通信·来信》"},"example":{"text":"我们写文章不能～。"},"similar":["半文半白"],"usage":"作谓语、定语；指说话或文章"},{"id":9808,"word":"半文半白","pinyin":"bàn wén bàn bái","abbr":"bwbb","explanation":"文言和白话夹杂。亦作“半文不白”。","source":{"text":"要言简意赅，因而得半文半白。","book":"萧乾《一本褪色的相册》"},"example":{"text":"这篇文章……唯一的缺点，是“～，似通非通”","book":"琼瑶《匆匆太匆匆》"},"similar":["半文不白"],"usage":"作谓语、定语；指说话或文章"},{"id":9809,"word":"半斤八两","pinyin":"bàn jīn bā liǎng","abbr":"bjbl","explanation":"八两：即半斤。一个半斤，一个八两。比喻彼此一样，不相上下。","source":{"text":"踏着秤锤硬似铁，八两元来是半斤。","book":"宋·释普济《五灯会元》卷十一：“问：‘来时无物去时空，二路俱迷，如何得不迷去？’师曰：‘秤头半斤，秤尾八两。’”宋·释惟白《建中靖国续灯录》"},"example":{"text":"众将看他两个本事，都是～的，打扮也差不多。","book":"明·施耐庵《水浒全传》第一百七回"},"similar":["旗鼓相当","不相上下","平分秋色"],"opposite":["截然不同","大相径庭","天差地远"],"usage":"作谓语、分句；比喻彼此一样，不相上下"},{"id":9810,"word":"半斤八面","pinyin":"bàn jīn bā miàn","abbr":"bjbm","explanation":"旧制一斤合十六两，半斤等于八两。一个半斤，一个八两，重量相等。比喻彼此一样，不分上下。亦作“一个半斤，一个八两”、“半斤对八两”。","example":{"text":"林寒青仗着手中短剑锋利，把一个蓝衣武士手中长剑削去了一截，使两人不敢和他剑势硬接，保持个～之局。","book":"李凉《天涯侠侣》第三十三章"}},{"id":9811,"word":"半新不旧","pinyin":"bàn xīn bù jiù","abbr":"bxbj","explanation":"犹言半新半旧。","source":{"text":"参见“半新半旧”。"},"example":{"text":"邓秀梅看他头上戴一顶浅灰绒帽子，上身穿件～的青布棉袄。","book":"周立波《山乡巨变》上二"},"similar":["半新半旧"],"usage":"作谓语、定语；指不新不旧"},{"id":9812,"word":"半新半旧","pinyin":"bàn xīn bàn jiù","abbr":"bxbj","explanation":"指不新不旧。","source":{"text":"次日，宝玉贾兰换了半新半旧的衣服，欣然过来见了王夫人。","book":"清·曹雪芹《红楼梦》第119回"},"example":{"text":"他总是穿着那件～的衣服。"},"similar":["半新不旧"],"usage":"作谓语、定语；指不新不旧"},{"id":9813,"word":"半明半暗","pinyin":"bàn míng bàn àn","abbr":"bmba","explanation":"光线不充足。","source":{"text":"灯光在他脸上一闪一闪，那张脸半明半暗，他弓着背咳嗽连连。","book":"余华《活着》"},"example":{"text":"在这～的房间里不适合看书。"},"similar":["忽明忽暗"],"usage":"作谓语、定语；指光线不充足"},{"id":9814,"word":"半晴半阴","pinyin":"bàn qíng bàn yīn","abbr":"bqby","explanation":"又晴又阴，阴晴不定。形容春天至初夏季节阴晴不定的天气。","source":{"text":"漠漠复霭霭，半晴将半阴。","book":"唐·刘禹锡《洛中早春》"}},{"id":9815,"word":"半梦半醒","pinyin":"bàn mèng bàn xǐng","abbr":"bmbx","explanation":"指睡眠尚未清醒。","example":{"text":"说来说去，我究竟在半梦半醒之间，做了些甚么呢？","book":"倪匡《卖命·半梦半醒》"},"similar":["迷迷糊糊","糊里糊涂"],"usage":"作定语、状语；用于人的状态"},{"id":9816,"word":"半死不活","pinyin":"bàn sǐ bù huó","abbr":"bsbh","explanation":"指没有生机和活力。死又死不了，活着又受罪。","source":{"text":"参见“半死半生”。"},"example":{"text":"想跑，水裹住他的脚，他就那么～的，低着头一步一步的往前曳。","book":"老舍《骆驼祥子》十八"},"similar":["死气沉沉","委靡不振","筋疲力尽"],"opposite":["生气勃勃","朝气勃勃","生龙活虎"],"usage":"作谓语、定语、状语；指人或事物没有生气"},{"id":9817,"word":"半死半活","pinyin":"bàn sǐ bàn huó","abbr":"bsbh","explanation":"半死：接近死亡。不死不活，形容被折磨得很惨或死气沉沉，没有生气。","source":{"text":"听说停刊的头一日，即是昨日，站笼上还有几个半死半活的人，都收监了。","book":"清·刘鹗《老残游记》"},"example":{"text":"他被打得～。"},"similar":["半死不活"],"opposite":["生龙活虎"],"usage":"作谓语、定语、状语；指人或事物没有生气"},{"id":9818,"word":"半死半生","pinyin":"bàn sǐ bàn shēng","abbr":"bsbs","explanation":"①未全死。②比喻无意义、无生气的苟且的生活。","source":{"text":"龙门之桐，高百尺而无枝……其根半死半生。","book":"汉·枚乘《七发》"},"example":{"text":"惟独～的苟活，是全盘失错的。因为他挂了生活的招牌，其实却引人到死路上去！”","book":"鲁迅《华盖集·北京通信》"},"similar":["半死半活"],"opposite":["生机勃勃"],"usage":"作谓语、定语、状语；指人或事物没有生气"},{"id":9819,"word":"半死梧桐","pinyin":"bàn sǐ wú tóng","abbr":"bswt","explanation":"比喻丧失配偶。","source":{"text":"半死梧桐老病身。","book":"唐·白居易《为薛台悼亡》"}},{"id":9820,"word":"半死辣活","pinyin":"bàn sǐ là huó","abbr":"bslh","explanation":"指死又死不了，活着又受罪。","source":{"text":"参见“半死半生”。"},"example":{"text":"忙跑几步，好失了脚步掉得下去，好跌得烂酱如泥，免得～，常驻苦常驻罪。","book":"《醒世姻缘传》第七五回"},"similar":["半死不活"],"opposite":["生机勃勃"],"usage":"作谓语、宾语；指不死不活"},{"id":9821,"word":"半济而击","pinyin":"bàn jì ér jī","abbr":"bjej","explanation":"半济：渡河渡过一半。当敌人渡河渡过一半的时候再去攻击。指善于捕捉有利时机攻击敌人。","source":{"text":"客绝水而来，勿迎之于水内，令半济而击之，利。","book":"《孙子·行军篇》"}},{"id":9822,"word":"半涂而废","pinyin":"bàn tú ér fèi","abbr":"btef","explanation":"半路上终止。比喻做事情有始无终。","source":{"text":"参见“半途而废”。"},"example":{"text":"臣等查该三厂开采，虽尚未见成效，然总须该地方官激励厂民，奋勉从事，不可任其～。","book":"清·林则徐《查勘矿厂情形试行开采折》"},"similar":["半途而废"],"opposite":["持之以恒"],"usage":"作谓语、状语、定语；比喻做事有始无终"},{"id":9823,"word":"半涂而罢","pinyin":"bàn tú ér bà","abbr":"bteb","explanation":"半路上终止。比喻做事情有始无终。同“半涂而废”。","source":{"text":"陛下持之不坚，半涂而罢，伤威损费，为弊必深。","book":"唐·韩愈《论淮西事宜状》"},"similar":["半途而废"],"opposite":["有始有终"],"usage":"作谓语、状语、定语；比喻做事有始无终"},{"id":9824,"word":"半瓶子醋","pinyin":"bàn píng zǐ cù","abbr":"bpzc","explanation":"比喻稍有一点知识而知识并不丰富，略有一点本领而本领并不高强的人。","source":{"text":"可是作为一个知识分子的我，这些年转弯抹角的，直到现在还是个半瓶子醋。","book":"杨朔《我的改造》"},"example":{"text":"你听他夸夸其谈，其实只是个～。"},"similar":["半瓶醋"],"usage":"作宾语、定语；指人不精通"},{"id":9825,"word":"半瓶醋","pinyin":"bàn píng cù","abbr":"bpc","explanation":"比喻对某一门知识只是一知半解却好在人前卖弄的人。","source":{"text":"如今那街上常人，粗读几句书，咬文嚼字，人叫他做半瓶醋。","book":"《古今杂剧·无名氏〈司马相如题桥记〉》"}},{"id":9826,"word":"半生不熟","pinyin":"bàn shēng bù shú","abbr":"bsbs","explanation":"没有完全成熟或未烹煮至可食用的程度。比喻不熟悉；不熟练。","source":{"text":"参见“半生半熟”。"},"example":{"text":"五个中间的老徐能说几句～的广府话。","book":"茅盾《过封锁线》"},"similar":["半生半熟"],"usage":"作谓语、定语；指不熟练"},{"id":9827,"word":"半生半熟","pinyin":"bàn shēng bàn shú","abbr":"bsbs","explanation":"没有完全成熟或未烹煮至可食用的程度。比喻不熟悉；不熟练。","source":{"text":"君为北道生张八，我是西州熟魏三，莫怪尊前无笑语，半生半熟未相谙。","book":"元·元怀《拊掌录》"},"example":{"text":"这～的牛肉不能吃。"},"similar":["半生不熟"],"opposite":["滚瓜烂熟"],"usage":"作谓语、定语；指没成熟"},{"id":9828,"word":"半生尝胆","pinyin":"bàn shēng cháng dǎn","abbr":"bscd","explanation":"半生：半辈子；胆：苦胆。尝了半辈子苦胆。比喻受了半辈子的苦。","source":{"text":"自叹劳苦曰半生尝胆。","book":"宋·胡继宗《书言故事·志气类·尝胆》"},"opposite":["甜甜美美"],"usage":"作谓语、宾语；指受苦"},{"id":9829,"word":"半疑半信","pinyin":"bàn yí bàn xìn","abbr":"bybx","explanation":"有点怀疑，又有点相信。表示对真假是非不能肯定。","source":{"text":"因兹请休和，虏往骑来过。半疑兼半信，筑城犹嵯峨。","book":"唐·元稹《古筑城曲》"},"example":{"text":"若他人听过了，～，若存若亡，安得不惰。","book":"《朱子全书》卷十六"},"similar":["半信半疑","半信不信"],"opposite":["坚信不疑","确信无疑"],"usage":"作谓语、定语、状语；形容似信非信"},{"id":9830,"word":"半痴不颠","pinyin":"bàn chī bù diān","abbr":"bcbd","explanation":"痴：呆傻；颠：同“癲”，疯癲。装疯卖傻的意思。","source":{"text":"这婆子俐齿伶牙，能言快语，又半痴不颠的惯与丫环们打诨，所以上下都喜欢他。","book":"明·冯梦龙《古今小说·蒋兴歌重会珍珠衫》"},"similar":["装疯卖傻"],"usage":"作定语、状语；指装疯卖傻"},{"id":9831,"word":"半真半假","pinyin":"bàn zhēn bàn jiǎ","abbr":"bzbj","explanation":"一半真情，一半假意。不是完全真实的。","source":{"text":"我这里千回右转自彷徨，撇不下多情数桩。半真半假乔摸样，宜嗔宜喜娇情况，知疼知热俏心肠。","book":"元·范居中《金殿喜重重·秋思》套曲"},"example":{"text":"刘老义们～地喊叫着不让他们逃，还故意打了几枪，然后带着余下的一部分转回大庙。","book":"姚雪垠《长夜》第二十六章"},"similar":["半推半就","故作姿态","半真半伪"],"opposite":["婉言谢绝","拒人千里"],"usage":"作谓语、宾语、定语；形容人不是真心实意的"},{"id":9832,"word":"半瞋半喜","pinyin":"bàn chēn bàn xǐ","abbr":"bcbx","explanation":"瞋：通“嗔”，发怒。一半生气，一半欢喜。形容又怒又喜。","source":{"text":"方太太的回答是半瞋半喜的一笑。","book":"《动摇》"},"similar":["喜怒参半"],"usage":"作谓语、定语；指又喜又怒"},{"id":9833,"word":"半筹不纳","pinyin":"bàn chóu bù nà","abbr":"bcbn","explanation":"筹：古代计算工具，引伸为计策；纳：缴纳。半条计策也拿不出来。比喻一点办法也没有。","source":{"text":"往常时我习武艺学兵法，到如今半筹也不纳。","book":"元·李文蔚《燕青博鱼》第一折"},"example":{"text":"万骑交驰，两军相见，咱手里～。","book":"元·朱凯《昊天塔》第二折"},"similar":["一筹莫展"],"opposite":["足智多谋"],"usage":"作谓语、定语；指一点办法都想不出"},{"id":9834,"word":"半筹莫展","pinyin":"bàn chóu mò chǎn","abbr":"bcmz","explanation":"半条计策也拿不出来。比喻一点办法也没有。","source":{"text":"周瑜虽能用计，岂能出诸葛亮之料乎？略用小谋，使周瑜半筹不展。","book":"明·罗贯中《三国演义》第五十四回"},"example":{"text":"惟自民国成立之日，则予三主张建设反致～，一败涂地。","book":"孙中山《建国方略自序》"},"similar":["半筹不纳","一筹莫展"],"usage":"作谓语、定语；指一点办法都想不出"},{"id":9835,"word":"半老徐娘","pinyin":"bàn lǎo xú niáng","abbr":"blxn","explanation":"徐娘：指梁元帝妃徐氏。指尚有风韵的中年妇女。","source":{"text":"萧溧阳马虽老犹骏，徐娘虽老犹尚多情。","book":"《南史·后妃传下·梁元帝徐妃》"},"example":{"text":"虽是～，皮肤白皙，显得很年轻。","book":"李六如《六十年的变迁》第九章"},"similar":["徐娘半老"],"opposite":["风烛残年"],"usage":"作谓语、宾语、定语；用于人","story":["南朝时期，梁朝湘东王萧绎的妃子徐昭佩由于得不到宠爱，先后与荆州瑶光寺的智远道人，贺徽以及暨季江勾搭成奸。暨季江感慨地说：“没想到徐娘半老，竟风韵犹存，是如此风流多情。”萧绎忍无可忍责令她自杀"]},{"id":9836,"word":"半解一知","pinyin":"bàn jiě yī zhī","abbr":"bjyz","explanation":"指理解得不深，知道得很少。同“一知半解”。","source":{"text":"半解一知天下士，千歧百辙釜中鱼。","book":"宁调元《燕京杂诗》"},"similar":["一知半解"],"opposite":["真知灼见"],"usage":"作谓语、宾语、定语；用于否定句"},{"id":9837,"word":"半路修行","pinyin":"bàn lù xiū xíng","abbr":"blxx","explanation":"原指成年后才出家做和尚或尼姑。比喻中途改行，从事另一工作。","source":{"text":"参见“半路出家”。"},"example":{"text":"茅鹿门先生，文章擅海内……晚喜作诗，自称～，语多率易。","book":"明·朱国祯《晚幢小品·俚诗有本》"},"similar":["半路出家"],"opposite":["科班出身"],"usage":"作宾语、定语；形容中途开始干某事"},{"id":9838,"word":"半路出家","pinyin":"bàn lù chū jiā","abbr":"blcj","explanation":"原指成年后才出家做和尚或尼姑。比喻中途改行，从事另一工作。","source":{"text":"先前读书，后来看看不济，却去改业做生意。便是半路出家的一般。","book":"《京本通俗小说·错斩崔宁》"},"example":{"text":"他不理会内行的嗤笑，写啊改啊，改啊写啊，终于写出了好作品，成了一个颇有希望的～的作家。","book":"公今度《长短录》"},"similar":["半道出家"],"opposite":["科班出身","训练有素"],"usage":"作宾语、定语；形容中途开始干某事","story":["宋朝皇帝在昊天寺上香敬佛遇辽兵围困，杨令公率七个儿子前来救驾，其中三个儿子战亡，一个下落不明。后在伐辽战争中遭元帅潘仁美陷害，杨家只杨六郎幸存，在归途中，杨五郎因当年战败出家当和尚挺身而出救了杨六郎"]},{"id":9839,"word":"半身不摄","pinyin":"bàn shēn bù shè","abbr":"bsbs","explanation":"摄：引持。指半边身体不能随意转动或半边肢体瘫痪。","source":{"text":"素被病，面常黯黑，于九殿下暴疾，半身不摄，扶载归家，其夜亡。","book":"《魏书·孟鸾传》"},"similar":["半身不遂"],"usage":"作谓语、宾语、定语；指人半身瘫痪"},{"id":9840,"word":"半身不遂","pinyin":"bàn shēn bù suí","abbr":"bsbs","explanation":"遂：通“随”，顺从。原为医学病症名，指半边身体不能随意转动。有时比喻诗文部分好，部分不好，不够匀称。","source":{"text":"无风之为病，当半身不遂，或但臂不遂者，此为痹脉微而数中风使然。","book":"汉·张仲景《金匮要略·中风历节》"},"example":{"text":"蒋百里在宜山的南边路上，汽车坏了，他受了一下子凉，就有一点～的样子。","book":"冯玉祥《我所认识的蒋介石》第三十一章"},"similar":["半身不摄"],"opposite":["身强体壮","八面玲珑","生龙活虎"],"usage":"作谓语、宾语、定语；指人患病，半身瘫痪"},{"id":9841,"word":"半途而废","pinyin":"bàn tú ér fèi","abbr":"btef","explanation":"废：停止。指做事不能坚持到底，中途停顿，有始无终。","source":{"text":"君子遵道而行，半途而废，吾弗难已矣。","book":"《礼记·中庸》"},"example":{"text":"如果就此请假回国，这里的事～，将来保举弄不到，白吃一趟辛苦。","book":"清·李宝嘉《官场现形记》第五十六回"},"similar":["功亏一篑","有始无终","浅尝辄止"],"opposite":["坚持不懈","持之以恒","锲而不舍"],"usage":"作谓语、状语、定语；用于处事","story":["东汉时期书生乐羊子一次拾到一块金子回家交给妻子，妻子告诫他不要贪图意外之财。他从那以后就外出求学，一年后回家，妻子用剪刀剪织布机上的绸子来打比方，希望他要持之以恒，不能前功尽弃。他坚持了七年终于学成归来"]},{"id":9842,"word":"半部论语","pinyin":"bàn bù lún yǔ","abbr":"bbly","explanation":"旧时对儒学经典之一《论语》的夸赞之辞，掌握半部《论语》，人的能力就会提高，就能治理国家。","source":{"text":"参见“半部论语治天下”。"},"example":{"text":"况且从前古人以～治天下，就是半部亦何妨。","book":"清·李宝嘉《官场现形记》第六十四回"},"similar":["半部论语治天下"],"usage":"作宾语；强调学习儒学的重要","story":["北宋时期著名政治家赵普为太祖出谋划策，发动兵变，拥立太祖赵匡胤，被任命为宰相。宋太祖死后，赵匡义当皇帝，别人认为赵普一生只读《论语》，不学无术，当宰相不恰当。赵匡义问是不是，赵普说我是以半部《论语》帮助治天下的"]},{"id":9843,"word":"半部论语治天下","pinyin":"bàn bù lún yǔ zhì tiān xià","abbr":"bblyztx","explanation":"旧时用来强调学习儒家经典的重要。","source":{"text":"臣平生所知，诚不出此，昔以其半辅太祖（赵匡胤）定天下，今欲以其半辅陛下致太平。","book":"典出宋·罗大经《鹤林玉露》卷七：宋初宰相赵普，人言所读仅只《论语》而已。太宗赵匡义因此问他。他说"},"example":{"text":"每决大事，启文观书，乃《论语》也，此时称小官以～。","book":"元·高文秀《遇上皇》第三折"},"similar":["半部论语"],"usage":"作宾语、定语；强调学习儒学的重要","story":["北宋时期著名政治家赵普为太祖出谋划策，发动兵变，拥立太祖赵匡胤，被任命为宰相。宋太祖死后，赵匡义当皇帝，别人认为赵普一生只读《论语》，不学无术，当宰相不恰当。赵匡义问是不是，赵普说我是以半部《论语》帮助治天下的"]},{"id":9844,"word":"半间不界","pinyin":"bàn gān bù gà","abbr":"bjbj","explanation":"间、界：今作：“尴尬”。比喻肤浅、不深刻，或做事不彻底。","source":{"text":"‘发愤忘食，乐以忘忧，不知老之将至云尔。’泛说若是谦辞。然圣人之为人，自有不可及处，直要做到底，不做个半间不界底人。","book":"宋·朱熹《朱子语类》第34卷"},"example":{"text":"其所引援，皆是～无状之人，弄得天下之事日入于昏乱。","book":"宋·朱熹《朱子语类》第129卷"},"similar":["半间半界","不三不四"],"usage":"作谓语、定语；指不彻底"},{"id":9845,"word":"半间半界","pinyin":"bàn gān bàn gà","abbr":"bjbj","explanation":"①不彻底，不深透。②不明确。③犹言不上不下。④谓平庸。","source":{"text":"①不彻底，不深透。②不明确。③犹言不上不下。④谓平庸。"},"example":{"text":"①不彻底，不深透。②不明确。③犹言不上不下。④谓平庸。"},"similar":["半间不界"],"usage":"作谓语、定语；指不彻底"},{"id":9846,"word":"半零不落","pinyin":"bàn líng bù luò","abbr":"blbl","explanation":"半：不完整；零：零碎；落：破败。破旧不堪的意思。","source":{"text":"把四爷脸上一抹，身上手上各花花答答的抹了，然后拿出一顶半零不落的开花儿的帽子，与四爷戴上。","book":"清·石玉昆《三侠五义》第十回"}},{"id":9847,"word":"半青半黄","pinyin":"bàn qīng bàn huáng","abbr":"bqbh","explanation":"农作物还没有长好，青黄相接。比喻时机还没有成熟。","source":{"text":"只为明得不尽，若明得尽，私意自然留不得。若半青半黄，未能透彻，便是尚有渣滓，非所谓真知也。","book":"宋·朱熹《朱子全书》第一卷"},"example":{"text":"今既要理会，也须理会取透，莫要～，下梢都不济事。","book":"宋·朱熹《朱子全书·学》"},"similar":["青黄不接"],"usage":"作定语；指事物未完全成熟"},{"id":9848,"word":"半面不忘","pinyin":"bàn miàn bù wàng","abbr":"bmbw","explanation":"见过面就不遗忘。形容记忆力极强。","source":{"text":"其聪记强识，半面不忘。","book":"《后汉书·应奉传》李贤注引谢承《后汉书》：“造车匠于内开扇出半面视奉，奉即委去。后数十年于路见车匠，识而呼之。”《北齐书·杨愔传》"},"similar":["半面之交"],"opposite":["莫逆之交"],"usage":"作谓语；形容记忆力极强","story":["东汉时期才子应奉记忆力惊人，在他20岁那年，他去拜访彭城官员袁贺，在袁家做马车的匠人打开半扇门露出半边脸来告诉他袁贺不在家。几十年后的一天，应奉在路上认出了这个车匠，车匠十分惊叹他的记忆力"]},{"id":9849,"word":"半面之交","pinyin":"bàn miàn zhī jiāo","abbr":"bmzj","explanation":"同别人只见过一面的交情。意谓交情不深。","source":{"text":"且观世人之相论也，徒以一面之交，定臧否之决。","book":"晋·袁彦伯《三国名人序赞》"},"example":{"text":"我与道友未～，此语从何而来。","book":"明·许仲琳《封神演义》第六十二回"},"similar":["一面之交"],"opposite":["莫逆之交"],"usage":"作宾语；形容交情很浅","story":["东汉时期才子应奉记忆力惊人，在他20岁那年，他去拜访彭城官员袁贺，在袁家做马车的匠人打开半扇门露出半边脸来告诉他袁贺不在家。几十年后的一天，应奉在路上认出了这个车匠，车匠十分惊叹他的记忆力"]},{"id":9850,"word":"半面之旧","pinyin":"bàn miàn zhī jiù","abbr":"bmzj","explanation":"意指只见过一面的人。","source":{"text":"且观世人之相论也，徒以一面之交，定臧否之决。","book":"晋·袁彦伯《三国名人序赞》"},"example":{"text":"初应进士时，中朝无缌麻之亲，达官无～。","book":"唐·白居易《与元九书》"},"similar":["半面之交","一面之缘"],"opposite":["莫逆之交"],"usage":"作宾语、定语；指一面之缘"},{"id":9851,"word":"半面妆","pinyin":"bàn miàn zhuāng","abbr":"bmz","explanation":"比喻事物零落，不完整。","source":{"text":"妃以帝眇一目，每知帝将至，必为半面妆以俟，帝见则大怒而出。","book":"《南史·后妃传》"},"example":{"text":"休夸此地分天下，只得徐妃～。","book":"唐·李商隐《南朝》诗"}},{"id":9852,"word":"半饥半饱","pinyin":"bàn jī bàn bǎo","abbr":"bjbb","explanation":"指不求甚饱或吃不饱饭。","source":{"text":"若论起吴衙内，只算做半饥半饱，未能趁心像意。","book":"明·冯梦龙《醒世恒言》第二十八卷"},"example":{"text":"老百姓都过着～的生活。"},"opposite":["丰衣足食"],"usage":"作定语、状语；用于饮食等"},{"id":9853,"word":"华不再扬","pinyin":"huá bù zài yáng","abbr":"hbzy","explanation":"已开过的花，在一年里不会再开。比喻时间过去了不再回来。","source":{"text":"时无重至，华不再扬。","book":"晋·陆机《短歌行》"},"usage":"作宾语、定语；用于书面语"},{"id":9854,"word":"华亭鹤唳","pinyin":"huá tíng hè lì","abbr":"hthl","explanation":"华亭谷的鹤叫声。指遇害者生前所恋之景物，有伤痛惋惜之意。","source":{"text":"今日欲闻华亭鹤唳，不可复得。","book":"南朝·宋·刘义庆《世说新语·尤梅》：“ 临刑叹曰：‘欲闻华亭鹤唳，可复得呼？’”《艺文类聚》卷九十引《八王故事》"},"example":{"text":"陆机雄才岂自保，李斯税驾苦不早。～讵可闻，上蔡苍鹰何足道。","book":"唐·李白《行路难三首》其三"},"similar":["鹤唳华亭"],"usage":"作宾语；表示对过去生活的留恋"},{"id":9855,"word":"华冠丽服","pinyin":"huá guān lì fú","abbr":"hglf","explanation":"冠：帽子。形容衣着华丽。","source":{"text":"又行了半日，忽见街北蹲着两全大石狮子，三间兽头大门，门前列坐着十来个华冠丽服之人，正门不开，只东西两角门有人出入。","book":"清·曹雪芹《红楼梦》第三回"},"usage":"作宾语、定语；形容衣着华丽"},{"id":9856,"word":"华发苍颜","pinyin":"huá fà cāng yán","abbr":"hfcy","explanation":"颜：容颜。头发花白，面容苍老。形容老年人的相貌。","source":{"text":"平生塞北江南，归来华发苍颜。","book":"宋·辛弃疾《清平乐·独宿博山王氏庵》"},"usage":"作谓语、定语；用于老年人"},{"id":9857,"word":"华如桃李","pinyin":"huá rú táo lǐ","abbr":"hrtl","explanation":"形容容颜非常美丽。","source":{"text":"何彼秾矣，华如桃李，平王之孙，齐侯之子。","book":"《诗经·召南·何彼秾矣》"}},{"id":9858,"word":"华实相称","pinyin":"huá shí xiāng chèn","abbr":"hsxc","explanation":"比喻外表与实质相当。","source":{"text":"衡阳王须文学，当使华实相称，不得止取贵游子弟而已。","book":"《南史·齐衡阳王钧传》"}},{"id":9859,"word":"华封三祝","pinyin":"huá fēng sān zhù","abbr":"hfsz","explanation":"华：古地名。封：疆界，范围。华封：华州这个地方。华州人对上古贤者唐尧的三个美好祝愿。即：祝寿、祝富、祝多男子，合称三祝。","source":{"text":"尧观乎华。华封人曰：嘻，圣人！请祝圣人寿…圣人富…圣人多男子。","book":"《庄子外篇·天地篇》"},"example":{"text":"明·汪廷讷《种玉记·赠玉》：“怎能勾～，继美千秋。”"},"usage":"作谓语；用于祝寿等","story":["尧统治时期，唐尧的功德可以与天地相匹敌，他经常巡视边疆，与守疆人打成一片。华州守疆人称他为圣人，对上头祈祝唐尧长寿，祝他富贵，祝他多子多福"]},{"id":9860,"word":"华屋丘墟","pinyin":"huá wū qiū xū","abbr":"hwqx","explanation":"壮丽的建筑化为土丘。比喻兴亡盛衰的迅速。","source":{"text":"生在华屋处，零落归山丘。","book":"三国·魏·曹植《箜篌引》"},"example":{"text":"这个艳传，那个步韵，比对于～，生民涂炭之惨的大事情还起劲。","book":"鲁迅《且介亭杂文·病后杂谈》"},"similar":["华屋山丘"],"usage":"作宾语、定语；比喻兴亡盛衰的迅速"},{"id":9861,"word":"华屋山丘","pinyin":"huá wū shān qiū","abbr":"hwsq","explanation":"壮丽的建筑化为土丘。比喻兴亡盛衰的迅速。","source":{"text":"生在华屋处，零落归山丘。","book":"三国·魏·曹植《箜篌引》"},"example":{"text":"～不可期，岘山依旧绿参差。","book":"元·黄溍《感旧》诗"},"similar":["华屋丘墟"],"usage":"作谓语、分句；比喻兴亡盛衰的迅速","story":["晋朝时期，博学多才的谢安特别钟爱他的外甥羊昙。羊昙非常聪明，十分尊敬谢安。谢安死了，羊昙非常悲痛，他尽量避免走西门（谢安的坟墓所在地），怕引起悲伤。一次他喝醉酒走西门，就念曹植的诗句：“生在华屋处，零落归山丘。”"]},{"id":9862,"word":"华屋秋墟","pinyin":"huá wū qiū xū","abbr":"hwqx","explanation":"壮丽的建筑化为土丘。比喻兴亡盛衰的迅速。","source":{"text":"生在华屋处，零落归山丘。","book":"三国·魏·曹植《箜篌引》"},"example":{"text":"这个艳传，那个步韵，比对于～，生民涂炭之惨的大事情还起劲。","book":"鲁迅《且介亭杂文·病后杂谈》"}},{"id":9863,"word":"华星秋月","pinyin":"huá xīng qiū yuè","abbr":"hxqy","explanation":"像星星那样闪闪发光，如秋月那样清澈明朗。形容文章写得非常出色。","source":{"text":"两章对秋月，一字偕华星。","book":"唐·杜甫《同元使君春陵行》"}},{"id":9864,"word":"华朴巧拙","pinyin":"huá pǔ qiǎo zhuō","abbr":"hpqz","explanation":"华丽、朴实、奇巧、古拙。指各种不同的文风。","source":{"text":"也不仅据文意的华朴巧拙定时代，因为作者是文人还是市民，于作品是大有分别的。","book":"鲁迅《关于〈唐三藏取经诗话〉的版本》"}},{"id":9865,"word":"华而不实","pinyin":"huá ér bù shí","abbr":"hebs","explanation":"华：开花。花开得好看，但不结果实。比喻外表好看，内容空虚。","source":{"text":"且华而不实，怨之所聚也。","book":"《晏子春秋·外篇·不合经术者》：“东海之中，有水而赤，其中有枣，华而不实，何也。”《左传·文公五年》"},"example":{"text":"～，脆而不坚。","book":"毛泽东《改造我们的学习》"},"similar":["金玉其表","虚有其表","败絮其中"],"opposite":["表里如一"],"usage":"作谓语、定语；指内容空虚","story":["晋国大夫阳处父从卫国回来，经过宁邑住在一家旅店，店主赢见阳处父长得端庄伟岸，动作优雅，以为他是一个品德高尚的人物，就辞别妻子投奔阳处父。没多久，店主赢认为他没本事，不值得追随，就毅然回到妻子身边"]},{"id":9866,"word":"华而失实","pinyin":"huā ér shī shí","abbr":"hess","explanation":"华：通“花”，开花；实：果实，结果。花开得好看，但不结果实。比喻外表好看，内容空虚。","source":{"text":"华而失实，过莫大焉。","book":"唐·刘知畿《史通·言语》"},"similar":["华而不实"],"opposite":["表里如一"],"usage":"作谓语、定语；指内容空虚"},{"id":9867,"word":"华胥之国","pinyin":"huá xù zhī guó","abbr":"hxzg","explanation":"华胥：传说中的国名。用以指梦境。","source":{"text":"昼寝而梦，游于华胥氏之国。","book":"《列子·黄帝》"}},{"id":9868,"word":"华胥之梦","pinyin":"huá xù zhī mèng","abbr":"hxzm","explanation":"华胥：传说中的国名。指黄帝梦游华胥国，而后天下大治的传说。","source":{"text":"昼寝而梦，游于华胥氏之国。……又二十有八年，天下大治，几若华胥之国，而帝登假。","book":"《列子·黄帝》"}},{"id":9869,"word":"华衮之赠","pinyin":"huá gǔn zhī zèng","abbr":"hgzz","explanation":"华衮：古代皇帝的礼服。形容极为贵重的礼物。","source":{"text":"一字之褒，宠逾华衮之赠；一言之贬，辱过市井之挞。","book":"晋·范宁《谷梁传序》"},"example":{"text":"一字所嘉，有同～；一言所黜，无异萧斧之诛。","book":"唐·孔颖达《春秋正义序》"},"usage":"作主语、宾语；用于书面语"},{"id":9870,"word":"华颠老子","pinyin":"huá diān lǎo zǐ","abbr":"hdlz","explanation":"华：花白；颠：头顶。指头发花白的老人。","source":{"text":"最难得的，仍是原班，不弱一个，不过绿鬓少年，都换了华颠老子了。","book":"清·曾朴《孽海花》第十八回"},"opposite":["绿鬓少年"],"usage":"作主语、宾语、定语；指老人"},{"id":9871,"word":"协力同心","pinyin":"xié lì tóng xīn","abbr":"xltx","explanation":"心：思想；协：合。团结一致，共同努力。","source":{"text":"然后与宇文行台，同心协力，电讨不庭，则桓文之勋，复兴于兹日矣。","book":"汉·贾谊《过秦论》：“且天下尝同心并力攻秦矣，然困于险阻而不能进者，岂勇力智慧不足哉？”《周书·崔谦传》"},"example":{"text":"我三人结为兄弟，～，然后可图大事。","book":"明·罗贯中《三国演义》第一回"},"similar":["同心协力"],"opposite":["一盘散沙"],"usage":"作谓语、状语；指齐心协力"},{"id":9872,"word":"协力齐心","pinyin":"xié lì qí xīn","abbr":"xlqx","explanation":"思想一致，共同努力。亦作“协心同力”、“协力同心”。","source":{"text":"然后与宇文行台，同心协力，电讨不庭，则桓文之勋，复兴于兹日矣。","book":"汉·贾谊《过秦论》：“且天下尝同心并力攻秦矣，然困于险阻而不能进者，岂勇力智慧不足哉？”《周书·崔谦传》"},"example":{"text":"为此牌仰本官上紧亲行督谕各头目及土兵人等，俱要～，竭忠报效，务图剿灭，以绝祸根。","book":"明·王阳明《知行录·戒谕土目》"},"similar":["齐心协力","协力同心","协心同力"],"opposite":["貌合神离"],"usage":"作谓语、定语、状语；指共同努力"},{"id":9873,"word":"协心同力","pinyin":"xié xīn tóng lì","abbr":"xxtl","explanation":"思想一致，并同努力。同“协心戮力”。","source":{"text":"然后与宇文行台，同心协力，电讨不庭，则桓文之勋，复兴于兹日矣。","book":"汉·贾谊《过秦论》：“且天下尝同心并力攻秦矣，然困于险阻而不能进者，岂勇力智慧不足哉？”《周书·崔谦传》"},"example":{"text":"鹤鸣责经、抚协心同力，而枢臣与经臣独不当～乎？","book":"《明史·王化贞传》"},"similar":["齐心协力","协力齐心","协力同心"],"opposite":["貌合神离"],"usage":"作谓语、定语、状语；指共同努力"},{"id":9874,"word":"协心戮力","pinyin":"xié xīn lù lì","abbr":"xxll","explanation":"思想一致，并同努力。","source":{"text":"若不斋盟质信，以示四方，知吾等协心戮力，则无以成功。","book":"《新唐书·韦陟传》"},"example":{"text":"宋·周密《齐东野语·嘉定宝玺》：“我辈当念祖父沦亡之痛，～，仰扣庙堂。”"},"similar":["协心同力"],"usage":"作谓语、定语、状语；指共同努力"},{"id":9875,"word":"协私罔上","pinyin":"xié sī wǎng shàng","abbr":"xsws","explanation":"怀抱私情，欺骗君上。协，通“挟”。"},{"id":9876,"word":"卑不足道","pinyin":"bēi bù zú dào","abbr":"bbzd","explanation":"指卑微藐小，不值得一谈。","source":{"text":"见“卑卑不足道”。"},"example":{"text":"我是一个～的人。","book":"巴金《家》二七"},"similar":["微不足道"],"opposite":["举足轻重"],"usage":"作谓语、定语；用于自谦"},{"id":9877,"word":"卑之无甚高论","pinyin":"bēi zhī wú shèn gāo lùn","abbr":"bzwsgl","explanation":"表示只就浅易的说，没有什么过高难行的意见。","source":{"text":"释之既朝毕，因前言便宜事。文帝曰：‘卑之，毋甚高论，令今可行也。’","book":"《汉书·张释之传》"},"example":{"text":"～，严绝宋元明，而取法乎唐，亦足自立矣。","book":"清·吴乔《答万季野诗问·七》"},"usage":"作谓语、分句；指一般的看法，没有新意"},{"id":9878,"word":"卑以自牧","pinyin":"bēi yǐ zì mù","abbr":"byzm","explanation":"指以谦卑自守。","source":{"text":"余谓牧犹守也，卑以自牧谓以谦卑自守也。","book":"语出《易·谦》：“谦谦君子，卑以自牧也。”王弼注：“牧，养也。”高亨注"},"example":{"text":"普天下的男子凡是在恋爱的时侯，他的“～”的情怀都不亚于张生。","book":"郭沫若《断断集·旋转乾坤论》"},"similar":["卑己自牧"],"usage":"作宾语、定语；指自身修养"},{"id":9879,"word":"卑卑不足道","pinyin":"bēi bēi bù zú dào","abbr":"bbbzd","explanation":"指卑微藐小，不值得一谈。","source":{"text":"而世人不知。懵懵然以为崇德报功，向龟蛇而叩首，对木石而鞠躬，此多是猾聃诡谲，妖佛妄为，卑卑不足道也。","book":"太平天国·洪仁玕《英杰归真》"},"example":{"text":"但这所谓酒馆，是和肥肠汤锅比较说的，它只贩卖烧酒，猪头、猪尾等等不成材料的货色的卤味。因此倘若同镇子上的酒巴馆一比，那便～了。","book":"沙汀《淘金记》二"},"similar":["微不足道","卑不足道"],"opposite":["举足轻重"],"usage":"作谓语、定语、宾语；用于自谦"},{"id":9880,"word":"卑宫菲食","pinyin":"bēi gōng fěi shí","abbr":"bgfs","explanation":"指宫室简陋，饮食菲薄。旧时用以称美朝廷自奉节俭的功德。","source":{"text":"禹，吾无间然矣！菲饮食，而致孝乎鬼神；恶衣服，而致美乎黻冕；卑宫室，而尽力乎沟洫。","book":"语出《论语·泰伯》"},"example":{"text":"～，以丰功臣之赏；披怀虚己，以纳谟士之算。","book":"晋·陆机《辩亡论下》"},"similar":["菲食卑宫"],"usage":"作宾语、定语；指不讲究享受"},{"id":9881,"word":"卑己自牧","pinyin":"bēi jǐ zì mù","abbr":"bjzm","explanation":"卑：谦；牧：养。以谦逊的态度修身养性。","source":{"text":"鲁迅的韧，闻一多的刚，郁达夫的卑己自牧，我认为是文坛的三绝。","book":"郭沫若《再谈郁达夫》"},"similar":["卑以自牧"],"usage":"作宾语、定语；指自身修养"},{"id":9882,"word":"卑礼厚币","pinyin":"bēi lǐ hòu bì","abbr":"blhb","explanation":"卑礼：谦恭的礼节；厚币：厚重的币帛。比喻聘请人员的郑重殷切。","source":{"text":"惠王数败于军旅，卑礼厚币以招贤。","book":"《史记·魏世家》"},"example":{"text":"朝廷～来延聘他，他在宋朝有多大的前程，要装模作样，高蹈远引，这便是不中抬举了。","book":"清·吴趼人《痛史》第二十回"},"similar":["卑辞重币"],"usage":"作补语、定语；形容人的态度很隆重"},{"id":9883,"word":"卑论侪俗","pinyin":"bēi lùn chái sú","abbr":"blcs","explanation":"侪俗：指俗人之流。降低言论的格调、情趣以混同于一般俗人。指降低对自己的要求，迁就流俗。","source":{"text":"今拘学或抱咫尺之义，久孤于世，岂若卑论侪俗，与世沉浮而取荣名哉。","book":"《史记·游侠列传》"}},{"id":9884,"word":"卑谄足恭","pinyin":"bēi chǎn jǜ gōng","abbr":"bczg","explanation":"卑：低下；谄：巴结奉承；足：音“巨”，过分；恭：恭顺。低声下气，阿谀逢迎，过分恭顺，取媚于人。","source":{"text":"彭祖为人巧佞、卑谄足恭，而心刻深。","book":"《史记·五宗世家》"},"usage":"作谓语、定语；指过分恭顺"},{"id":9885,"word":"卑身屈体","pinyin":"bēi shēn qū tǐ","abbr":"bsqt","explanation":"指弯腰俯首，屈从奉迎。","source":{"text":"参见“卑身贱体”。"},"example":{"text":"方其人之未得出乎此也，～以求之，仆隶贱人之所耻者而不耻也。","book":"宋·叶適《荐举》"},"similar":["卑身贱体"],"usage":"作宾语、定语；指人"},{"id":9886,"word":"卑身贱体","pinyin":"bēi shēn jiàn tǐ","abbr":"bsjt","explanation":"①谓俭约勤苦。②弯腰俯首，屈从奉迎。","source":{"text":"皆夙兴夜寐，卑身贱体……以事其君。","book":"《韩非子·说疑》"},"example":{"text":"故～，说色微辞，愉愉煦煦，终无益于主上之治。","book":"汉·东方朔《非有先生论》"},"similar":["卑身屈体"],"usage":"作宾语、定语；指人"},{"id":9887,"word":"卑躬屈膝","pinyin":"bēi gōng qū xī","abbr":"bgqx","explanation":"卑躬：低头弯腰；屈膝：下跪。形容没有骨气，低声下气地讨好奉承。","source":{"text":"公卿大臣皆卑躬屈膝唯后，虽谢安石之贤也，而犹不能免。","book":"宋·魏了翁《江陵州丛兰精舍记》"},"example":{"text":"不管有多大困难也不能向朝廷～，用变节投降的办法，苟安一时。","book":"姚雪垠《李自成》第一卷第十四章"},"similar":["阿谀奉承","阿谀奉迎","奴颜婢膝"],"opposite":["不亢不卑","宁死不屈","刚正不阿"],"usage":"作谓语、定语、状语；用于没有骨气"},{"id":9888,"word":"卑躬屈节","pinyin":"bēi gōng qū jié","abbr":"bgqj","explanation":"卑躬：低头弯腰；屈节：屈辱节操。形容没有骨气，低声下气地讨好奉承。","source":{"text":"公卿大臣皆卑躬屈膝唯后，虽谢安石之贤也，而犹不能免。","book":"宋·魏了翁《江陵州丛兰精舍记》"},"example":{"text":"小兔子～，拿了愚表弟萧慎的名片。","book":"清·李宝嘉《官场现形记》第四十二回"},"similar":["卑躬屈膝"],"opposite":["不卑不亢","刚正不阿"],"usage":"作谓语、定语、状语；用于没有骨气"},{"id":9889,"word":"卑辞厚币","pinyin":"bēi cí hòu bì","abbr":"bchb","explanation":"指言辞谦恭，礼物丰厚。参见“卑辞重币”。","source":{"text":"抱真喜士，闻世贤者，必欲与之游，虽小善，皆卑辞厚币数千里邀致之。","book":"《新唐书·李抱真传》"},"example":{"text":"若木由是名闻江南，凡两江总督到任，必～，敦请入幕，为上宾者数十年。","book":"清·薛福成《庸庵笔记·裕靖节公殉难》"},"similar":["卑辞重币"],"usage":"作状语、定语；形容人委曲求全"},{"id":9890,"word":"卑辞厚礼","pinyin":"bēi cí hòu lǐ","abbr":"bchl","explanation":"指言辞谦恭，礼物丰厚。参见“卑辞重币”。","source":{"text":"曹操微时，常卑辞厚礼求为己目。","book":"《后汉书·许劭传》"},"example":{"text":"器以道术深远，使人赍璧帛，～聘顺，欲以为师。","book":"晋·皇甫谧《高士传·韩顺》"},"similar":["卑辞厚币"],"usage":"作谓语、定语；指对人的态度"},{"id":9891,"word":"卑辞重币","pinyin":"bēi cí zhòng bì","abbr":"bczb","explanation":"卑：谦恭；重：厚；币：礼物。说谦虚的话，送厚重的礼。形容对人有所求。","source":{"text":"楚赵附则齐必惧，惧必卑辞重币以事秦。","book":"《战国策·秦策三》"},"example":{"text":"君诚不惜～，以求诸侯于楚，楚必许之。","book":"明·冯梦龙《东周列国志》第三十三回"},"similar":["卑辞厚币"],"usage":"作状语、定语；形容人委曲求全"},{"id":9892,"word":"卑鄙无耻","pinyin":"bēi bǐ wú chǐ","abbr":"bbwc","explanation":"形容品质恶劣，不顾羞耻。","source":{"text":"办你个‘胆大钻营，卑鄙无耻！’下去候着吧。","book":"清·李宝嘉《官场现形记》第三十五回"},"example":{"text":"世界上的事就是这样：越是～、自私自利的人，越是得势，横行霸道。","book":"茅盾《霜叶红似二月花》"},"similar":["下流至极","厚颜无耻","卑鄙下作"],"opposite":["正气凛然","高风亮节","德高望重"],"usage":"作谓语、定语；用于品质恶劣的个人或集团"},{"id":9893,"word":"卑鄙龌龊","pinyin":"bēi bǐ wò chuò","abbr":"bbwc","explanation":"龌龊：肮脏。形容品质恶劣，居心不正，言行肮脏。","source":{"text":"拿着别人的功名性命来博自己的一时富贵，这位术师老爷的卑鄙龌龊也就可想而知的了。","book":"清·张春帆《宦海》第十一回"},"example":{"text":"他们里面的坏人，的确是天地间最坏的东西。背信弃义，杀人放火，横抢武夺，～，什么都干得出来。","book":"郭沫若《郑成功》第五章"},"similar":["卑鄙无耻","卑鄙下流"],"opposite":["众人敬仰","德高望重","一身正气"],"usage":"作谓语、定语；形容坏人毫无人格"},{"id":9894,"word":"卑陋龌龊","pinyin":"bēi lòu wò chuò","abbr":"blwc","explanation":"龌龊：肮脏。形容品质恶劣。亦作“卑鄙龌龊”。","source":{"text":"他们那种卑陋龌龊的性质，终久是改不了的！","book":"清·华伟生《开国奇冤·追悼》"},"similar":["卑鄙龌龊"],"usage":"作谓语、定语；指人品"},{"id":9895,"word":"卑陬失色","pinyin":"bēi zōu shī sè","abbr":"bzss","explanation":"卑陬：惭愧的样子。表示十分惭愧，面失常态。","source":{"text":"子贡卑陬失色，顼顼然不自得，行三十里而后愈。","book":"《庄子·天地篇》"}},{"id":9896,"word":"卒卒鲜暇","pinyin":"cù cù xiǎn xiá","abbr":"zzxx","explanation":"卒卒：很匆忙的样子；鲜：少；暇：空闲时间。匆匆忙忙地没有空闲时间。形容事情多，忙得不可开交。","source":{"text":"卒卒无须臾之间，得竭旨意。","book":"《汉书·司马迁传》"},"example":{"text":"仆今年在校，～，事皆琐末猥杂，足浊脑海。","book":"鲁迅《书信集·致许寿裳》"}},{"id":9897,"word":"卒岁穷年","pinyin":"zú suì qióng nián","abbr":"zsqn","explanation":"卒：终了，岁：年；穷：完了。指整年。","source":{"text":"虽卒岁穷年，无有透彻之期。","book":"宋·朱熹《朱子语类》第11卷"},"usage":"作宾语、定语；指整年"},{"id":9898,"word":"卒擅天下","pinyin":"zú shàn tiān xià","abbr":"zstx","explanation":"卒：终于；擅：独揽，据有。指终于得到天下","source":{"text":"故文王果收功于吕尚，卒擅天下，而身立为帝王。","book":"西汉·刘向《战国策·秦策》"},"usage":"作谓语、定语；用于书面语"},{"id":9899,"word":"卒极之事","pinyin":"cù jí zhī shì","abbr":"zjzs","explanation":"卒：通“猝”，突然，出乎意外。指仓促紧急的事情。","source":{"text":"今若有卒极之事，韩不可信也。","book":"《韩非子·存韩》"}},{"id":9900,"word":"卒然","pinyin":"cu ran","abbr":"cr","explanation":"形容很短暂的时间。"},{"id":9901,"word":"卓乎不群","pinyin":"zhuó hū bù qún","abbr":"zhbq","explanation":"指超出常人。","source":{"text":"意其劲挺坚确，卓乎不群，举世皆怯而我独勇，众人既屈而我独伸。","book":"金·王若虚《揖翠轩赋》"},"similar":["卓尔不群","卓然不群","卓逸不群"],"usage":"作谓语、定语；指与众不同"},{"id":9902,"word":"卓伟之才","pinyin":"zhuó wěi zhī cái","abbr":"zwzc","explanation":"卓伟：卓越伟大。指杰出的人才","source":{"text":"戴赫烈之宠，体卓伟之才。","book":"晋·陈寿《三国志·吴志·张温传》"},"usage":"作宾语；用于书面语"},{"id":9903,"word":"卓尔不群","pinyin":"zhuó ěr bù qún","abbr":"zebq","explanation":"卓尔：特出的样子；不群：与众不同。指才德超出寻常，与众不同。","source":{"text":"夫唯大雅，卓尔不群，河间献王近之矣。","book":"东汉·班固《汉书·景十三王传赞》"},"example":{"text":"陈言务去，人耳皆新，其命名亦～矣。","book":"明·金中淳《跋》"},"similar":["卓乎不群","出类拔萃"],"usage":"作谓语、定语；指与众不同"},{"id":9904,"word":"卓尔出群","pinyin":"zhuó ěr chū qún","abbr":"zecq","explanation":"卓尔：特出的样子。指才德超出常人，与众不同","source":{"text":"晚生后学，匪无墙面，卓尔出群，斯人而已。","book":"《陈书·陆瑜传》"},"similar":["卓尔不群","卓然不群","卓逸不群"],"usage":"作谓语、定语；指与众不同"},{"id":9905,"word":"卓尔独行","pinyin":"zhuó ěr dú xíng","abbr":"zedx","explanation":"指超越众人，不随俗浮沉。","source":{"text":"《前书》曰：‘卓尔不群者，河间献王近之矣。’","book":"《后汉书·东海恭王彊珙传》：“王恭谦好礼，以德自终，遣送之物，务从约省，衣足敛形，茅车瓦器，物减于制，以彰王卓尔独行之志。”李贤注"},"usage":"作谓语、定语；用于书面语"},{"id":9906,"word":"卓有成效","pinyin":"zhuó yǒu chéng xiào","abbr":"zycx","explanation":"卓：卓越，高超。有突出的成绩和效果。","source":{"text":"若巡访劝谕著有成效者，县官备礼亲造其庐，重加奖励。","book":"明·王守仁《申行十家牌法》"},"example":{"text":"我们要奋发地工作，～地完成上级交给我们的任务。"},"similar":["立竿见影","行之有效"],"opposite":["无济于事","杯水车薪","劳而无功"],"usage":"作谓语、定语；指效果明显"},{"id":9907,"word":"卓然不群","pinyin":"zhuó rán bù qún","abbr":"zrbq","explanation":"指超出常人。","source":{"text":"其能历行饬身，卓然不群者，或未闻焉。","book":"《后汉书·刘虞传论》"},"example":{"text":"苟有～之士，不出户庭，潜志味道，诚宜优访以兴谦退也。","book":"晋·葛洪《抱朴子·逸民》"},"similar":["卓尔不群","卓逸不群","卓荦不群"],"usage":"作谓语、定语；指与众不同"},{"id":9908,"word":"卓立鸡群","pinyin":"zhuó lì jī qún","abbr":"zljq","explanation":"象鹤站在鸡群中一样。比喻一个人的仪表或才能在周围一群人里显得很突出。","source":{"text":"嵇延祖卓卓如野鹤之在鸡群。","book":"晋·戴逵《竹林七贤论》：“嵇绍入洛，或谓王戎曰：‘昨于稠人中始见嵇绍，昂昂然若野鹤之在鸡群。’”南朝梁·刘义庆《世说新语·容止》"},"similar":["鹤立鸡群"],"usage":"作谓语、定语；指人很突出"},{"id":9909,"word":"卓绝千古","pinyin":"zhuó jué qiān gǔ","abbr":"zjqg","explanation":"卓绝：程度达到极点，超过一切。超过以往的一切人。","source":{"text":"子胥始东奔勾吴，月涉星遁。或七日不火，伤弓于飞。逼迫于昭关，匍匐于濑者。舍车而徒，告穷此女。目色以臆，授之壶浆。全人自沉，形与口灭。卓绝千古，声凌浮云。激节必报之仇，雪诚无疑之地。难乎哉！","book":"唐·李白《溧阳濑水贞义女碑铭》"},"example":{"text":"况我大唐万乘之君，～之上，岂得下行选事，顿取怪于朝野乎？","book":"唐·杜佑《通典·选举六》"},"usage":"作谓语、定语；用于书面语"},{"id":9910,"word":"卓而出群","pinyin":"zhuó ěr chū qún","abbr":"zecq","explanation":"卓尔：特出的样子；出群：与众不同。指才德超出寻常，与众不同。","source":{"text":"夫唯大雅，卓尔不群，河间献王近之矣。","book":"《汉书·河间献王传赞》"},"example":{"text":"晚生后学，匪无墙面，～，斯人而已。","book":"《陈书·陆瑜传》"}},{"id":9911,"word":"卓荦不凡","pinyin":"zhuó luò bù fán","abbr":"zlbf","explanation":"卓荦：特出。指才德超出常人，与众不同","source":{"text":"君家兄弟皆卓荦不凡，正合用着，寻人实在不难。","book":"《洪秀全演义》第15回"},"similar":["卓荦不群","卓尔不群","卓然不群"],"usage":"作谓语、定语；指与众不同"},{"id":9912,"word":"卓荦不羁","pinyin":"zhuó luò bù jī","abbr":"zlbj","explanation":"指卓越超群，不甘受拘束。","source":{"text":"徽之卓荦不羁，欲为傲达，放肆声色，颇过度，时人钦其才，秽其行也。","book":"南朝·宋·刘义庆《世说新语·任诞》：“何可一日无此君？”刘孝标注引南朝·宋·何法盛《中兴书》"},"example":{"text":"而自少～，善辨说。","book":"宋·王安石《泰州海陵县主簿许君墓志铭》"},"usage":"作谓语、定语；用于书面语"},{"id":9913,"word":"卓荦不群","pinyin":"zhuó luò bù qún","abbr":"zlbq","explanation":"卓荦：特出；不群：跟一般人不一样。指才德超出常人，与众不同","source":{"text":"子一风神杰出，少受学于子敬，卓荦不群。","book":"清·黄宗羲《翰林院庶吉士子——魏先生墓志铭》"},"similar":["卓尔不群","卓荦不凡","卓逸不群"],"usage":"作谓语、定语；指与众不同"},{"id":9914,"word":"卓荦为杰","pinyin":"zhuó luò wéi jié","abbr":"zlwj","explanation":"卓荦：超绝，特出。指超绝出众的杰出人才","source":{"text":"纡余为妍，卓荦为杰，较短量长，唯器是适者，宰相之方也。","book":"唐·韩愈《进学解》"},"usage":"作谓语、定语；用于书面语"},{"id":9915,"word":"卓荦大者","pinyin":"zhuó luò dà zhě","abbr":"zldz","explanation":"卓荦：清楚、分明的样子。指主要的项目，明显的要点。","source":{"text":"此其荦荦大者，若至委曲小变，不可胜道。","book":"《史记·天官书》"}},{"id":9916,"word":"卓荦强识","pinyin":"zhuó luò qiáng zhì","abbr":"zlqs","explanation":"卓荦：超绝，特出；识：通“志”，记住。指聪明颖慧，记忆力很强","source":{"text":"虽学不沾洽，然卓荦强识。","book":"晋·陈寿《三国志·蜀志·许慈传》"},"usage":"作谓语、定语；用于书面语"},{"id":9917,"word":"卓荦超伦","pinyin":"zhuó luò chāo lún","abbr":"zlcl","explanation":"卓荦：超绝。伦：类。才能突出，超出一般人。","source":{"text":"夫欲救危抚乱，脩己以安人，则宜卓荦超伦，与时殊趣，震惊邻国，骇动四方，上当天心，下合人意。","book":"《文选·孔融·荐弥衡表》：“叔质贞亮，英才卓跞。”《三国志·蜀书·秦宓传》"},"similar":["出类拔萃"],"usage":"作谓语、定语；用于书面语"},{"id":9918,"word":"卓著成效","pinyin":"zhuó zhù chéng xiào","abbr":"zzcx","explanation":"卓著：突出。形容有突出的成绩或效果","source":{"text":"则知当时青苗法，实卓著成效，而民之涵濡其泽者既久，虽欲强没其美而有所不可得也。","book":"梁启超《王荆公传》第十章"},"similar":["卓有成效"],"usage":"作谓语、定语；指效果明显"},{"id":9919,"word":"卓识远见","pinyin":"zhuó shí yuǎn jiàn","abbr":"zsyj","explanation":"卓：高超；识：见识。有远大的眼光和卓越的见解。","source":{"text":"去年我们两国领导人在东京作出了一个具有卓识远见的决策，就是把中日关系放在长远的角度来考虑，来发展。","book":"邓小平《发展中日关系要看得远些》"},"similar":["远见卓识"],"usage":"作主语、定语、宾语；指人眼光长远"},{"id":9920,"word":"卓诡不伦","pinyin":"zhuó guǐ bù lún","abbr":"zgbl","explanation":"卓：高明；诡：奇异。高明独特，不一般。","source":{"text":"少为书生，性卓诡不伦。","book":"《后汉书·独行传·向栩》"},"usage":"作谓语、定语；用于书面语"},{"id":9921,"word":"卓诡变幻","pinyin":"zhuó guǐ biàn huàn","abbr":"zgbh","explanation":"卓诡：卓异，卓越。指超绝特异，变幻莫测","source":{"text":"世之学佛者徒求卓变诡幻，可喜可愕之迹。","book":"明·黄淳耀《李龙眠画罗汉记》"},"usage":"作谓语、定语；用于书面语"},{"id":9922,"word":"卓越俊逸","pinyin":"zhuó yuè jùn yì","abbr":"zyjy","explanation":"卓越：优秀突出。指才华风度超出一般人","source":{"text":"以八纮之广，兆庶之众，岂当无卓越俊逸之才乎？","book":"《晋书·严谭传》"},"usage":"作谓语、定语；用于书面语"},{"id":9923,"word":"卓逸不群","pinyin":"zhuó yì bù qún","abbr":"zybq","explanation":"不群：跟一般人不一样。指才德超出常人，与众不同","source":{"text":"才艺言行，卓逸不群。","book":"汉·蔡邕《荐边让书》"},"similar":["卓尔不群，卓然不群","卓荦不群"],"usage":"作谓语、定语；指与众不同"},{"id":9924,"word":"单丁之身","pinyin":"dān dīng zhī shēn","abbr":"ddzs","explanation":"丁：成年男子；单丁：独子。指没有兄弟的成年男子。","source":{"text":"凡单丁之身及茕独而秩养孤者，并蠲今年田租。","book":"《南齐书·武帝纪》"}},{"id":9925,"word":"单丝不成线","pinyin":"dān sī bù chéng xiàn","abbr":"dsbcx","explanation":"一根丝绞不成线。比喻个人力量单薄，难把事情办成。","source":{"text":"说甚么单丝不线，我着你缺月再圆。","book":"元·无名氏《连环计》第二折"},"example":{"text":"你放心闹吧，先还“～，独树不成林”，如今有了个对子了。","book":"清·曹雪芹《红楼梦》第五十六回"},"similar":["势单力薄"],"opposite":["人多势众"],"usage":"作宾语、分句；指力量单薄"},{"id":9926,"word":"单丝不线","pinyin":"dān sī bù xiàn","abbr":"dsbx","explanation":"一根丝绞不成线。比喻个人力量单薄，难把事情办成。","source":{"text":"说甚么单丝不线，我着你缺月再圆。","book":"元·无名氏《连环计》第二折"},"example":{"text":"我要回救沙僧，诚然是～，孤掌难鸣。","book":"明·吴承恩《西游记》第三十回"}},{"id":9927,"word":"单人匹马","pinyin":"dān rén pǐ mǎ","abbr":"drpm","explanation":"单枪匹马，单独行动。","source":{"text":"我初次单人匹马的出门，就遇了这等事，以后见了萍水相逢的人，倒要留心呢。","book":"清·吴趼人《二十年目睹之怪现状》第二回"},"similar":["单人独马","单枪匹马"],"usage":"作定语、状语；指单独行动"},{"id":9928,"word":"单人独马","pinyin":"dān rén dú mǎ","abbr":"drdm","explanation":"单枪匹马，单独行动。","source":{"text":"你这等单人独马，又无个伴侣，又无个徒弟，你如何去得！","book":"明·吴承恩《西游记》第14回"},"example":{"text":"自古来哪见过～的姑娘往外闯。"},"similar":["单枪匹马","单人匹马"],"opposite":["人多势众"],"usage":"作定语、状语；指单独行动"},{"id":9929,"word":"单传心印","pinyin":"dān chuán xīn yìn","abbr":"dcxy","explanation":"佛教禅宗，不依经纶、语言、文字传教，以心传心，触机而发，故称其单传心印。泛指单线秘传，口授心记。"},{"id":9930,"word":"单兵孤城","pinyin":"dān bīng gū chéng","abbr":"dbgc","explanation":"单兵：寡弱无援的军队；孤城：孤立无依的城池。形容军队及其驻军的城池孤立无依，势力单薄，没有外援。","source":{"text":"耿恭以单兵固守孤城，当匈奴之冲，对数万之众。","book":"《后汉书·耿恭传》"},"usage":"作宾语、定语；用于战争等"},{"id":9931,"word":"单刀直入","pinyin":"dān dāo zhí rù","abbr":"ddzr","explanation":"用短柄刀直接刺入。原比喻认定目标，勇猛精进。后比喻说话直接了当，不绕弯子。","source":{"text":"若是作家战将，便请单刀直入，更莫如何若何。","book":"宋·释道元《景德传灯录》卷十二"},"example":{"text":"上面一篇“嗣汉六十二代天师正一真人张元旭”的序文，尤为～。","book":"鲁迅《热风》三十三"},"similar":["直截了当","开门见山","直言不讳"],"opposite":["拐弯抹角","指桑骂槐","藏头露尾"],"usage":"作定语、状语；多用于比喻句"},{"id":9932,"word":"单刀赴会","pinyin":"dān dāo fù huì","abbr":"ddfh","explanation":"单刀：一把刀，指一个人。原指蜀将关羽只带一口刀和少数随从赴东吴宴会。后泛指一个人冒险赴约。有赞扬赴会者的智略和胆识之意。","source":{"text":"肃邀羽相见，各驻兵马百步上，但请将军单刀赴会。","book":"《三国志·吴书·鲁肃传》"},"example":{"text":"吾来日独驾小舟，只用亲随十余人，～，看鲁肃如何近我。","book":"明·罗贯中《三国演义》第六十六回"},"similar":["大智大勇","孤军深入"],"opposite":["群策群力"],"usage":"作谓语、定语；指独往"},{"id":9933,"word":"单刀趣入","pinyin":"dān dāo cù rù","abbr":"ddqr","explanation":"单：单独。佛教语，比喻认定目标，勇猛精进。后比喻说话直接了当，不绕弯子。","source":{"text":"单刀趣入，则凡圣情尽，休露真常，理事不二，即如如佛。","book":"宋·释道元《景德传灯录·灵佑禅师》"},"similar":["单刀直入"],"opposite":["转弯抹角","含沙射影"],"usage":"作定语、状语；多用于比喻句"},{"id":9934,"word":"单则易折，众则难摧","pinyin":"dān zé yì zhé，zhòng zé nán cuī","abbr":"dzyzzznc","explanation":"势孤力单，容易受人欺负；从多气壮，别人不敢欺侮。","source":{"text":"单则易折，众则难摧。戮力一心，然后社稷可固也。","book":"《北史·吐谷浑传》"},"usage":"作定语、宾语、分句；用于劝诫人"},{"id":9935,"word":"单复之术","pinyin":"dān fù zhī shù","abbr":"dfzs","explanation":"单复：短长、纵横、单数和复数；术：战术。原指战国时期合纵连横之术。后泛指正规作战及出奇制胜的战略战术。","source":{"text":"臣知无古人单复之术，如卒奉大略，伀曚狼狈，惧以轻愚，忝负特施，豫怀忧灼。","book":"《三国志·吴志·周鲂传》"},"usage":"作宾语；用于战争"},{"id":9936,"word":"单夫只妇","pinyin":"dān fū zhī fù","abbr":"dfzf","explanation":"单、只：一个。只有夫妇两人。也比喻仅有一男一女。","source":{"text":"是以单夫只妇，亦得多种。","book":"北朝·魏·贾思勰《齐民要术·种红花蓝花梔子》"},"similar":["一夫一妻"],"usage":"作主语、宾语、定语；指夫妻"},{"id":9937,"word":"单孑独立","pinyin":"dān jié dú lì","abbr":"djdl","explanation":"单孑：单身一人。只身一人，独立自持。","source":{"text":"惟会稽盛孝章尚存，其人困于孙氏，妻孥湮没，单孑独立，孤危愁苦。","book":"汉·孔融《论盛孝章书》"}},{"id":9938,"word":"单家独户","pinyin":"dān jiā dú hù","abbr":"djdh","explanation":"指单独一家一户。","source":{"text":"农村已经全部单家独户种庄稼，剩余劳力越来越多。","book":"路遥《平凡的世界》第四卷第34章"},"similar":["单门独户","独门独户"],"usage":"作宾语、定语、状语；用于口语"},{"id":9939,"word":"单忧极瘁","pinyin":"dān yōu jí cuì","abbr":"dyjc","explanation":"指极尽忧虑辛劳之苦。单，通“殚”。","source":{"text":"安人单忧极瘁，衣不解带者四十余日。","book":"清·曾国藩《陈岱云易安人墓志铭》"},"usage":"作谓语、定语；用于人"},{"id":9940,"word":"单文孤证","pinyin":"dān wén gū zhèng","abbr":"dwgz","explanation":"仅有的证据。意指不足凭信。","source":{"text":"考服虔之说，又与俗符，贤于杜氏单文孤证矣。","book":"北魏·郦道元《水经注·涑水》"},"example":{"text":"录寄贵刊，希为刊载，一以略助多闻，二以见～，是难以‘必定’一种史实而常有‘什么疑义’的。","book":"鲁迅《二心集·关于的版本》"},"usage":"作宾语、定语；指不足为凭"},{"id":9941,"word":"单枪匹马","pinyin":"dān qiāng pí mǎ","abbr":"dqpm","explanation":"原指打仗时一个人上阵。比喻行动没人帮助。","source":{"text":"兵散弓残挫虎威，单枪匹马突重围。","book":"五代·楚·汪遵《乌江》诗"},"example":{"text":"冯寡妇大骂那些女人是熊包，自己～，趁人们在街上歇晌的当儿，故意在大街上向村西头走。","book":"冯德英《迎春花》第十三章"},"similar":["孤家寡人","孤军奋战","无依无靠"],"opposite":["人多势众","千军万马"],"usage":"作主语、定语、状语；指独立作战"},{"id":9942,"word":"单枪独马","pinyin":"dān qiāng dú mǎ","abbr":"dqdm","explanation":"比喻孤身一人或单独行动。","source":{"text":"他横竖是单枪独马，一无牵挂，当下由杭赴苏，寻找了那位帮带。","book":"清·蘧园《负曝闲谈》第二回"},"example":{"text":"清·钱彩《说岳全传》第13回：“我儿好生固守，待为父的～，杀入贼营。”"},"similar":["单枪匹马","单人独马"],"usage":"作主语、定语、状语；指独立作战"},{"id":9943,"word":"单根独苗","pinyin":"dān gēn dú miáo","abbr":"dgdm","explanation":"比喻独生子或唯一的子孙。","example":{"text":"现代人提倡只生一个，因此～的现象很普遍。"},"usage":"作主语、宾语、定语；多用于人"},{"id":9944,"word":"单椒秀泽","pinyin":"dān jiāo xiù zé","abbr":"djxz","explanation":"单椒：孤立的山峰；秀泽：秀丽的水泽。形容山明水秀，风景优美。","source":{"text":"华不注山，单椒秀泽，不连丘陵以自高。","book":"北魏·郦道元《水经注·济水》"}},{"id":9945,"word":"单步负笈","pinyin":"dān bù fù jí","abbr":"dbfj","explanation":"单步：徒步；笈：书箱。背着书箱，徒步外出求学。形容不怕吃苦，勤奋求学。","source":{"text":"单步负笈，苦身持力。","book":"《三国志·魏志·邴原传》注引《原别传》"},"usage":"作谓语；指只身求学"},{"id":9946,"word":"单特孑立","pinyin":"dān tè jié lì","abbr":"dtjl","explanation":"孑立：独立。形容独特超群，才华出众。","source":{"text":"岂如苏子单特孑立，靡因靡资。","book":"《后汉书·苏章传》附苏不韦"}},{"id":9947,"word":"单相思","pinyin":"dān xiāng sī","abbr":"dxs","explanation":"男女之间只有单方面的爱恋思慕。也比喻双方中只有一方有愿望或热情。","source":{"text":"只见些花落东风点绿苔，佩环声，归仙宅，单相思今空害。","book":"明·高濂《玉簪记·村郎闹会》"},"example":{"text":"她一味在～，根本不敢主动表达爱慕之情。"},"opposite":["两情相悦"],"usage":"作主语、宾语、定语；指单恋"},{"id":9948,"word":"单见浅闻","pinyin":"dān jiàn qiǎn wén","abbr":"djqw","explanation":"指见识短浅。","source":{"text":"其末年所以为天下后世虑者，未易为单见浅闻者道也。","book":"宋邵博《闻见后录》卷二四"},"similar":["孤陋寡闻"],"opposite":["远见卓识","见多识广"],"usage":"作宾语、定语；用于人的见识"},{"id":9949,"word":"单身只手","pinyin":"dān shēn zhī shǒu","abbr":"dszs","explanation":"指独自一人。形容人单势孤。","source":{"text":"剩俺单身只手，怎去恢复中原。","book":"清·孔尚任《桃花扇·草檄》"}},{"id":9950,"word":"单车之使","pinyin":"dān chē zhī shǐ","abbr":"dczs","explanation":"单车：一辆车，指一个人。单独一个人出使的使臣。","source":{"text":"足下之以单车之使，适万乘之虏。","book":"汉·李陵《答苏武书》"}},{"id":9951,"word":"单车就路","pinyin":"dān chē jiù lù","abbr":"dcjl","explanation":"单车：一辆车；就路：上路。只有一辆车上路。比喻人单势孤。","source":{"text":"陇蜀即平，河西守令，咸被征召，财货连毂，弥竟川泽，唯奋无资，单车就路。","book":"《后汉书·孔奋传》"}},{"id":9952,"word":"单门独户","pinyin":"dān mén dú hù","abbr":"dmdh","explanation":"旧指孤寒门第。现指没有亲友，人少势孤的家庭。","source":{"text":"故法禁挠于势族，恩泽不逮于单门。","book":"汉·赵壹《刺世疾邪赋》"},"example":{"text":"我喜欢住～，不受外界干扰。"},"similar":["独门独户","单家独户"],"usage":"作宾语、定语；指一院一户的住宅"},{"id":9953,"word":"单鹄寡凫","pinyin":"dān hú guǎ fú","abbr":"dhgf","explanation":"鹄：天鹅；凫：罢鸭。孤单的天鹅，独居的野鸭。原是古代的琴曲名。后比喻失去配偶的人。","source":{"text":"齐人刘道强善弹琴，能作单鹄寡凫之弄。听者皆悲，不能自摄。","book":"《西京杂记》卷五"},"similar":["鳏夫寡妇"],"usage":"作宾语、定语；指丧偶的人"},{"id":9954,"word":"卖主求荣","pinyin":"mài zhǔ qiú róng","abbr":"mzqr","explanation":"指出卖主人的利益以换取个人的荣华富贵。","source":{"text":"得势则聚若蝇蚊，失势则散若鸟兽，甚至卖主求荣者颇多。","book":"清·夏敬渠《野叟曝言》第59回"},"example":{"text":"这位黄先生我看枉为人师！劝学生～，他当的什么老师？","book":"温靖邦《将星在狼烟中升起》"},"usage":"作谓语、定语、宾语；指出卖主子"},{"id":9955,"word":"卖乖弄俏","pinyin":"mài guāi nòng qiào","abbr":"mgnq","explanation":"形容卖弄聪明，故作媚态。","source":{"text":"对于德国军国主义的胜利，不是联合国的胜利，更不是我国徒事内争托名参战的军人和那投机取巧、卖乖弄俏的政客的胜利。","book":"李大钊《Bolshevism的胜利》"},"example":{"text":"他在那儿～为的是哗众取宠。"},"similar":["装疯卖傻"],"usage":"作谓语、定语；指故作媚态"},{"id":9956,"word":"卖人情","pinyin":"mài rén qíng","abbr":"mrq","explanation":"故意表现出给人好处，使对方感激自己。","example":{"text":"料想二人必有渊源，唇焦舌烂～，何庚金是个老实人，只唯唯答应鞠躬不迭。","book":"二月河《乾隆皇帝》十一"}},{"id":9957,"word":"卖俏倚门","pinyin":"mài qiào yǐ mén","abbr":"mqym","explanation":"旧时形容妓女的生活。","source":{"text":"你看人似桃李春风墙外枝，卖俏倚门儿。","book":"元·王实甫《西厢记》第三本第一折"},"similar":["倚门卖俏"],"usage":"作谓语、定语；指妓女生活"},{"id":9958,"word":"卖俏营奸","pinyin":"mài qiào yíng jiān","abbr":"mqyj","explanation":"俏：容态轻盈美好。卖弄媚态，以便做坏事。","source":{"text":"止不过席上尊前，卖俏营奸，退后趋前。","book":"明·胡文焕《群音类选·海神记·花鸨训女》"},"similar":["卖俏营奸"],"usage":"作谓语、定语、宾语；用于处事"},{"id":9959,"word":"卖俏行奸","pinyin":"mài qiào xíng jiān","abbr":"mqxj","explanation":"指卖弄媚态诱惑人，搞不正当男女关系。","source":{"text":"俺好意的张筵置酒，你走将来卖俏行奸。","book":"元·无名氏《连环计》第二折"},"example":{"text":"难道你～，认我做桃花墙外柯？","book":"明·梁辰鱼《浣纱记·捧心》"},"similar":["卖俏迎奸","卖俏营奸"],"usage":"作谓语、定语、宾语；用于处事"},{"id":9960,"word":"卖俏迎奸","pinyin":"mài qiào yíng jiān","abbr":"mqyj","explanation":"指卖弄媚态诱惑人，搞不正当男女关系。同“卖俏行奸”。","source":{"text":"俺好意的张筵置酒，你走将来卖俏行奸，畅好是厮蹅蹅，厮蹅蹅也。","book":"元·无名氏《连环记》第二折"},"example":{"text":"这阎婆惜被那张三小意儿百依百随，轻怜重惜，～，引乱这婆娘的心，如何肯恋宋江？","book":"明·施耐庵《水浒全传》第二十一回"},"similar":["卖俏行奸","卖俏营奸"],"usage":"作谓语、定语、宾语；用于处事"},{"id":9961,"word":"卖儿贴妇","pinyin":"mài ér tiē fù","abbr":"metf","explanation":"指因生活所迫，把妻子儿女卖给别人。","source":{"text":"陛下起此寺，皆是百姓卖儿贴妇钱，佛若有知，当悲哭哀愍。","book":"《南齐书·良政传·虞愿》"},"example":{"text":"～竭膏血，一塔岂有功德缘！","book":"清·黄遵宪《南汉修慧寺千佛塔歌》"},"usage":"作谓语、定语；指生活贫困"},{"id":9962,"word":"卖儿鬻女","pinyin":"mài ér yù nǚ","abbr":"meyn","explanation":"鬻：卖。指生活无依，被迫卖掉自己的女儿。","source":{"text":"破家荡产，鬻儿卖女，时有所闻。","book":"清·李宝嘉《官场现形记》第四十七回"},"example":{"text":"洛阳饥民～。","book":"姚雪垠《李自成》第二卷第三十六章"},"similar":["背井离乡","哀鸿遍野","家破人亡"],"opposite":["丰衣足食","四海升平","饱食暖衣"],"usage":"作谓语、定语、状语；指生活所迫而卖掉儿女"},{"id":9963,"word":"卖公营私","pinyin":"mài gōng yíng sī","abbr":"mgys","explanation":"指出卖公众利益以谋求个人私利。","source":{"text":"高官禄厚，足以自给，卖公营私，本非情愿。","book":"《魏书·赵黑传》"},"example":{"text":"他很想～，可惜做不到。"},"similar":["损公肥私"],"opposite":["一心为公","大公无私"],"usage":"作谓语、定语；指损公肥私"},{"id":9964,"word":"卖关子","pinyin":"mài guān zi","abbr":"mgz","explanation":"原指说书人说到故事的关键处突然停止，借以吸引听众。后比喻说话做事在紧要关头，故弄玄虚，让对方着急，从而答应自己的要求。","example":{"text":"你的话，我又不懂了。你就别～了吧！","book":"高阳《慈禧全传》八十四"}},{"id":9965,"word":"卖刀买牛","pinyin":"mài dāo mǎi niú","abbr":"mdmn","explanation":"刀：武器。指卖掉武器，从事农业生产。","source":{"text":"刘昆宰江陵，昔日反风灭火；龚遂守渤海，卖刀买牛。","book":"明·程登吉《幼学琼林》第一卷"},"similar":["卖剑买牛","卖刀买犊"],"usage":"作谓语、定语、宾语；指停战","story":["西汉时期，渤海一带农民因饥荒被迫当上了强盗，汉宣帝刘询派70多岁的龚遂任渤海太守。他上任后大力宣传只要从事农业生产不再做强盗的一律不咎既往，他开仓借粮，救济饥民，于是这些百姓纷纷卖剑买牛从事农业生产，安居乐业"]},{"id":9966,"word":"卖刀买犊","pinyin":"mài dāo mǎi dú","abbr":"mdmd","explanation":"刀：武器；犊：牛犊。指卖掉武器，从事农业生产。","source":{"text":"三川顿使气象清，卖刀买犊消忧患。","book":"唐·武元衡《兵行褒斜谷作》诗"},"example":{"text":"丢下兵器，拿把锄儿，学那古人‘～’的故事，岂不是绿林中一段佳话。","book":"清·文康《儿女英雄传》第21回"},"similar":["卖剑买牛","卖剑买犊"],"opposite":["南征北战","穷兵黩武","卖犊买刀"],"usage":"作谓语、定语、宾语；指停战"},{"id":9967,"word":"卖剑买牛","pinyin":"mài jiàn mǎi niú","abbr":"mjmn","explanation":"原指放下武器，从事耕种。后比喻改业务农或坏人改恶从善。","source":{"text":"民有持刀剑者，使卖剑买牛，卖刀买椟。","book":"《汉书·龚遂传》"},"example":{"text":"惟有躬耕差可为，～悔不早。","book":"宋·陆游《贫甚作短歌排闷》诗"},"similar":["偃武修文","马放南山","刀枪入库"],"opposite":["投笔从戎","南征北战","东征西讨"],"usage":"作谓语、定语；指停止战争","story":["西汉时期，渤海一带农民因饥荒被迫当上了强盗，汉宣帝刘询派70多岁的龚遂任渤海太守。他上任后大力宣传只要从事农业生产不再做强盗的一律不咎既往，他开仓借粮，救济饥民，于是这些百姓纷纷卖剑买牛从事农业生产，安居乐业"]},{"id":9968,"word":"卖剑买犊","pinyin":"mài jiàn mǎi dú","abbr":"mjmd","explanation":"原指放下武器，从事耕种。后比喻改业务农或坏人改恶从善。同“卖剑买牛”。","source":{"text":"抚民愿焚械归籍，此即古人卖剑买犊之化也。","book":"明·张居正《答殷石汀言宜终功名答知遇书》"},"similar":["卖剑买牛","买牛卖剑"],"opposite":["南征北战","穷兵黩武","卖犊买刀"],"usage":"作谓语、定语；指停止战争"},{"id":9969,"word":"卖剑买琴","pinyin":"mài jiàn mǎi qín","abbr":"mjmq","explanation":"指没有功名意识，志在归隐。","source":{"text":"卖剑买琴，斗瓦输铜。","book":"清·龚自珍《能令公少年行》"},"example":{"text":"他～，退出江湖。"},"usage":"作谓语；指归隐"},{"id":9970,"word":"卖友求荣","pinyin":"mài yǒu qiú róng","abbr":"myqr","explanation":"出卖朋友以谋求名利、地位。","source":{"text":"卖友求荣事可羞，靦颜枉自附清流。","book":"柳亚子《咏史》之二"},"example":{"text":"我不能见利忘义，～，变成利禄之小人！","book":"《人民日报》1984.4.18"},"similar":["损人利己"],"usage":"作谓语、定语、宾语；指出卖朋友谋利"},{"id":9971,"word":"卖国求利","pinyin":"mài guó qiú lì","abbr":"mgql","explanation":"勾结投靠敌人，出卖国家的权益，谋求个人的富贵。同“卖国求荣”。","source":{"text":"苏循及其子楷自谓有功于梁，当不次擢用。全忠薄其为人，以其为唐鸱枭，卖国求利，勒循致仕，斥楷归田里。","book":"宋·洪迈《容斋随笔》卷六"},"similar":["卖国求荣","求荣卖国"],"usage":"作谓语、定语；指人谋求个人的名利"},{"id":9972,"word":"卖国求荣","pinyin":"mài guó qiú róng","abbr":"mgqr","explanation":"勾结投靠敌人，出卖国家的权益，谋求个人的富贵。","source":{"text":"苏循及其子楷自谓有功于梁，当不次擢用。全忠薄其为人，以其为唐鸱枭，卖国求利，勒循致仕，斥楷归田里。","book":"宋·洪迈《容斋随笔》卷六"},"example":{"text":"贾似道～，请速正法。","book":"清·吴趼人《痛史》第六回"},"similar":["里通外国","媚外求荣"],"opposite":["忧国忘家","为国捐躯","赤心报国"],"usage":"作谓语、定语；指人谋求个人的名利","story":["楚灵王准备侵略蔡国，陈国使臣报告先君病死公子留即位。陈侯的三子公子胜与太子偃师的儿子公孙吴前来报告公子过与司徒招合谋杀害太子偃师而立公子留。楚灵王立即派兵去讨伐公子过，司徒招杀了公子过，卖国求荣献陈，结果被发配东海"]},{"id":9973,"word":"卖头卖脚","pinyin":"mài tóu mài jiǎo","abbr":"mtmj　","explanation":"犹言抛头露面。原指妇女出现在大庭广众之中。现指公开露面。","source":{"text":"我们姑娘年轻的媳妇，也难卖头卖脚的，倒还是舍着我这付老脸去碰碰。","book":"清·曹雪芹《红楼梦》第六回"},"similar":["抛头露面"],"opposite":["隐姓埋名"],"usage":"作谓语、定语、宾语；同“抛头露面”"},{"id":9974,"word":"卖妻鬻子","pinyin":"mài qī yù zǐ","abbr":"mqyz","explanation":"指因生活所迫，把妻子儿女卖给别人。","source":{"text":"男女等也是良家儿女，只因命运淹蹇，又值恶薄时年，卖妻鬻子，家业凋零。","book":"明·清溪道人《禅真逸史》第五回"},"example":{"text":"可怜百姓已～，啼饥号寒，还有甚么钱财，上应征求？","book":"蔡东藩《五代史演义》第十九回"},"usage":"作谓语、宾语、定语；用于生活"},{"id":9975,"word":"卖官卖爵","pinyin":"mài guān mài jué","abbr":"mgmj","explanation":"收受钱财，出卖官爵。","source":{"text":"现今社会也有～的现象。"},"example":{"text":"现今社会也有～的现象"},"similar":["卖官鬻爵"],"usage":"作谓语、定语；指官场腐败"},{"id":9976,"word":"卖官贩爵","pinyin":"mài guān fàn jué","abbr":"mgfj","explanation":"形容政治腐败，统治阶级靠出卖官职来搜刮财富。同“卖官鬻爵”。","source":{"text":"千秋卖官贩爵，聚资货累亿。","book":"《晋书·会稽文孝王道子传》"},"similar":["卖官卖爵","卖官鬻爵","卖爵鬻官"],"usage":"作谓语、定语；指官场腐败"},{"id":9977,"word":"卖官鬻爵","pinyin":"mài guān yù jué","abbr":"mgyj","explanation":"鬻：卖。形容政治腐败，统治阶级靠出卖官职来搜刮财富。","source":{"text":"父子并卖官鬻爵。","book":"《宋书·邓琬传》"},"example":{"text":"昔黄巾造反，其原皆由十常侍～，非亲不用，非仇不诛，以致天下大乱。","book":"明·罗贯中《三国演义》第二回"},"similar":["卖官卖爵","卖官贩爵"],"usage":"作谓语、定语；指官场腐败"},{"id":9978,"word":"卖官鬻狱","pinyin":"mài guān yù yù","abbr":"mgyy","explanation":"汉·崔寔《政论》：“自非夷齐，孰能饿死，于是则有卖官鬻狱，盗贼主守之奸生矣。”","source":{"text":"今任使非人，～，囚系非辜者多。 ★《元史·耶律楚材传》"},"example":{"text":"明·兰陵笑笑生《金瓶梅词话》第30回：“高、杨、童、蔡，四个奸党在朝中，～，贿赂公行。”"},"similar":["卖狱鬻官"],"usage":"作谓语、定语、宾语；用于官场等"},{"id":9979,"word":"卖富差贫","pinyin":"mài fù chà pín","abbr":"mfcp","explanation":"指对于富人，得钱便予以免除差役；对于穷人，便任意征派劳役。","source":{"text":"我只道只有阳世间贪官污吏受财枉法，卖富差贫，岂知阴间也自如此！","book":"明·凌濛初《二刻拍案惊奇》第16卷"},"example":{"text":"《清史稿·食货志》：“请饬抚臣通行两府，按田起役，毋得凭空佥报，以滋～之弊。”"},"usage":"作谓语、定语、宾语；用于社会现象"},{"id":9980,"word":"卖履分香","pinyin":"mài lǚ fēn xiāng","abbr":"mlfx","explanation":"旧时比喻人临死念念不忘妻儿。","source":{"text":"余香可分与诸夫人，不命祭。诸舍中无所为，可学作组履卖也。","book":"汉·曹操《遗令》"},"example":{"text":"苟广其术，则～，可以不是也。","book":"清·蒲松龄《聊斋志异·祝翁》"}},{"id":9981,"word":"卖弄俊俏","pinyin":"mài nòng jùn qiào","abbr":"mnjq","explanation":"指妇女故意卖弄容貌美丽的轻佻行为。","source":{"text":"扭捏着身子儿百般做作，来往向人前卖弄俊俏。","book":"元·王实甫《西厢记》第一本第四折"},"example":{"text":"滕生～，连忙趋到跟前，劈面拜下去。","book":"明·凌濛初《初刻拍案惊奇》卷六"},"usage":"作谓语、宾语；用于女性"},{"id":9982,"word":"卖弄国恩","pinyin":"mài nòng guó ēn","abbr":"mnge","explanation":"旧指官僚恃恩弄权。","source":{"text":"君以阉宦之隶，刀锯之残，越从洿泥，扶侍日月，卖弄国恩，阶贱为贵，劫迫帝主，荡覆王室，假息漏刻，游魂河津。","book":"《后汉书·孝灵帝纪》"}},{"id":9983,"word":"卖弄学问","pinyin":"mài nòng xué wèn","abbr":"mnxw","explanation":"指故意显示自己有文化水平。","example":{"text":"年轻人不要在老年人面前～了。"}},{"id":9984,"word":"卖弄才学","pinyin":"mài nòng cái xué","abbr":"mncx","explanation":"指故意显示自己有文化水平","source":{"text":"贡生志在卖弄才学，如何肯去？","book":"清·李百川《绿野仙踪》第85回"},"example":{"text":"年轻人不要在老年人面前～了"},"usage":"作谓语、定语、宾语；用于骄傲的人"},{"id":9985,"word":"卖弄玄虚","pinyin":"mài nòng xuán xū","abbr":"mnxx","explanation":"玄虚：玄妙虚无的道理。指故意耍花招，使人理解不透。","source":{"text":"吴素来爱卖弄玄虚，说话每说到重要的地方便住了口。","book":"巴金《复仇集·亚丽安娜》"},"example":{"text":"别～了，我们没有时间奉陪。"},"similar":["故弄玄虚"],"usage":"作谓语、宾语；指故意耍花招"},{"id":9986,"word":"卖弄风情","pinyin":"mài nòng fēng qíng","abbr":"mnfq","explanation":"故意装出娇媚的姿态诱惑人。","source":{"text":"又见金钟儿不住的卖弄风情，将全副精神都用在何公子身上，毫无一点照应到自己，那里还坐得住？","book":"清·李百川《绿野仙踪》第47回"},"example":{"text":"他决不要娶一个～的轻佻女子为妻。"},"similar":["卖弄俊俏","搔首弄姿"],"usage":"作谓语、宾语、定语；用于女性"},{"id":9987,"word":"卖弄风骚","pinyin":"mài nòng fēng sāo","abbr":"mnfs","explanation":"卖弄：显耀；风骚：举止轻狂放荡。故意向人家炫耀自己的轻狂放荡。一般指轻浮的女子向男人挑逗。","source":{"text":"近朱者赤，近墨者黑，跟着贝夫人这样的一个尤物，今天看戏，明日烧香，到处卖弄风骚，招蜂引蝶。","book":"清·张春帆《九尾龟》第四十九回"},"example":{"text":"有时眼角留情，有时眉梢传语，有时轻颦巧笑，～，惹得陶穀支持不定，未免与她问答数语。","book":"蔡东藩《五代史演义》第五十九回"}},{"id":9988,"word":"卖恶于人","pinyin":"mài è yú rén","abbr":"meyr","explanation":"把坏事推给别人。","source":{"text":"与人共计议，云何裁转背便卖恶于人。","book":"《宋书·蔡廓传》"}},{"id":9989,"word":"卖文为生","pinyin":"mài wén wéi shēn","abbr":"mwws","explanation":"指以出卖诗文所得来维持生计。","source":{"text":"故人南郡去，云索作碑钱。本卖文为活，翻令室倒悬。","book":"唐·杜甫《闻斛斯六官未归》"},"example":{"text":"内行人都说他的文笔极有功力，文风别具一格，他淡然一笑，并不放在心上，不想～。","book":"刘绍棠《孤村》"},"usage":"作谓语、定语；用于文人等"},{"id":9990,"word":"卖李钻核","pinyin":"mài lǐ zuān hé","abbr":"mlzh","explanation":"先钻李核，然后出卖，免得别人得到良种。形容极端自私。","source":{"text":"王戎有好李，卖之恐人得其种，恒钻其核。","book":"南朝·宋·刘义庆《世说新语·俭啬》"},"example":{"text":"王戎～，不胜鄙吝；成王剪桐封弟，因无戏言。","book":"清·程允升《幼学琼林·花木》"},"usage":"作宾语、定语；用于比喻句","story":["晋朝时期，王戎是出名的吝啬鬼。他家里种了许多优良的李子树，李子又大又甜。他怕别人得到他这样好的种子，所以在卖李子前，把所有李子的核都挖出来"]},{"id":9991,"word":"卖法市恩","pinyin":"mài fǎ shì ēn","abbr":"mfse","explanation":"市：买。指玩忽法律而随意宽恕罪犯以求得好处。","source":{"text":"某也惜你骁勇，但国有定法，某不敢卖法市恩。送你上京，取圣断，如何？","book":"元·白仁甫《梧桐雨》楔子"},"similar":["徇私枉法"],"usage":"作谓语、宾语、定语；用于徇私枉法"},{"id":9992,"word":"卖浆屠狗","pinyin":"mài jiāng tú gǒu","abbr":"mjtg","explanation":"浆：酒浆。以卖酒、杀狗为业的人。过去指职业卑贱的阶层。","source":{"text":"以屠狗为事。","book":"《史记·信陵君列传》：“公子闻赵有处士毛公藏于博徒，薛公藏于卖浆家。”《史记·樊哙列传》"},"example":{"text":"到了燕国，整天和～之辈相交，与击筑者高渐离成为知音，和歌于闹市，痛饮于长街，其乐无穷！","book":"白桦《击筑者》"}},{"id":9993,"word":"卖爵赘子","pinyin":"mài jué zhuì zǐ","abbr":"mjzz","explanation":"爵：爵位；赘：抵押。因生活所迫，靠出卖爵位，抵押子女来维持生活。","source":{"text":"数年岁比不登，民待待卖爵赘子以接衣食。","book":"《汉书·严助传》"},"similar":["卖爵鬻子"],"usage":"作谓语、定语、宾语；用于生活"},{"id":9994,"word":"卖爵鬻子","pinyin":"mài jué yù zǐ","abbr":"mjyz","explanation":"鬻：卖。因生活所迫，出卖爵位和子女。","source":{"text":"岁恶不入，卖爵鬻子，既或闻耳矣。","book":"汉·贾谊《新书·无蓄》"},"example":{"text":"汉·贾谊《新书·无蓄》：“岁恶不入，卖爵鬻子，既或闻耳矣。”"},"similar":["卖爵赘子"],"usage":"作谓语、定语；用于生活"},{"id":9995,"word":"卖爵鬻官","pinyin":"mài jué yù guān","abbr":"mjyg","explanation":"买卖官爵来收取钱财。","source":{"text":"还说不朦蔽，你卖爵鬻官多少？贪财货竭脂膏。","book":"清·洪昇《长生殿·权哄》"},"example":{"text":"靠～发财的贪官终究被判极刑。"},"similar":["卖官卖爵","卖官鬻爵","鬻官卖爵"],"usage":"作谓语、定语；指官场腐败"},{"id":9996,"word":"卖犊买刀","pinyin":"mài dú mǎi dāo","abbr":"mdmd","explanation":"指出卖耕牛，购买武器去从军。","source":{"text":"又何必劳民动众，卖犊买刀？","book":"宋·邵伯温《闻见前录》第六卷"},"opposite":["卖刀买犊"],"usage":"作谓语、宾语、定语；用于备战"},{"id":9997,"word":"卖狗悬羊","pinyin":"mài gǒu xuán yáng","abbr":"mgxy","explanation":"犹言挂羊头卖狗肉。意指名不副实。","source":{"text":"悬羊头，卖狗肉，坏后进，初几灭。","book":"《晏子春秋·内篇杂下》：“君使服之于内，而禁之于外，犹悬牛首于门而卖马脯于内也。”宋·释普济《五灯会元》卷十六"},"example":{"text":"一个个蛇吞象，一个个兔赶獐，一个个～。","book":"明·薛论道《水仙子·愤世》曲"},"similar":["悬羊头，卖狗肉"],"usage":"作宾语、定语；用于处事"},{"id":9998,"word":"卖狗皮膏药","pinyin":"mài gǒu pí gāo yào","abbr":"mgpgy","explanation":"比喻说得很动听，实际上在骗人。","source":{"text":"再往下说，那就是信口开河，不如到庙会上卖狗皮膏药去！","book":"刘复《自序》"},"example":{"text":"我们不能相信他～。"},"usage":"作谓语、宾语；用于口语"},{"id":9999,"word":"卖狱鬻官","pinyin":"mài yù yù guān","abbr":"myyg","explanation":"狱：讼事；鬻：卖。收受贿赂，出卖官职爵位，徇私枉法。","source":{"text":"虽禄厚位尊，贪求滋甚，卖狱鬻官，不知纪极。","book":"《北史·魏咸阳王坦传》"},"example":{"text":"～，溪壑难满。","book":"《北齐书·后主纪论》"},"similar":["卖官鬻狱"],"usage":"作谓语、定语、宾语；用于官场等"},{"id":10000,"word":"卖男鬻女","pinyin":"mài nán yù nǚ","abbr":"mnyn","explanation":"指因生活所迫而出卖自己的儿女。","source":{"text":"况且如此荒年，那家不卖男鬻女来度命。","book":"明·天然痴叟《石点头·卢梦仙江上寻妻》"},"example":{"text":"旧社会，老百姓～还是勉强糊口。"},"similar":["卖儿鬻女"],"opposite":["丰衣足食"],"usage":"作谓语、宾语、定语、状语；指贫困"}]
