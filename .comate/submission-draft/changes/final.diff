+[{"id":25001,"word":"智尽能索","pinyin":"zhì jìn néng suǒ","abbr":"zjns","explanation":"索：竭尽。智慧和能力都已用尽。","source":{"text":"此有知尽能索耳，终不余力而让财矣。","book":"《史记·货殖列传》"},"example":{"text":"中国专使陆征祥等，～，不得已再向和会中提出抗议，申明意见。","book":"蔡东藩、许廑父《民国通俗演义》第一０三回"},"similar":["江郎才尽","知尽能索"],"usage":"作谓语、定语；指没办法了"},{"id":25002,"word":"智昏菽麦","pinyin":"zhì hūn shū mài","abbr":"zhsm","explanation":"指智力不能辨认豆麦。形容无知。","source":{"text":"朝秀晨终，龟鹤千岁，年之殊也。闻言如响，智昏菽麦，神之辨也。","book":"南朝·梁·刘孝标《辩命论》"},"example":{"text":"裴让之、张宴之……皆不著本贯郡县，盖校书者单知写《北史》以补足卷数，而不及检其先世郡望，几于～矣。","book":"清·钱大昕《廿二史考异·北齐书·裴让之传》"},"usage":"作谓语、定语；用于书面语"},{"id":25003,"word":"智欲圆而行欲方，胆欲大而心欲小","pinyin":"zhì yù yuán ér xíng yù fāng，dǎn yù dà ér xīn yù xiǎo","abbr":"zyyexyfdydexyx","explanation":"考虑问题要变通灵活，行为则须端方不苟；胆量要大，心思要缜密","source":{"text":"凡人之论，心欲小而志欲大，智欲圆而行欲方，能欲多而事欲鲜。","book":"西汉·刘安《淮南子·主术训》"},"similar":["智圆行方"],"usage":"作宾语、分句；用于书面语"},{"id":25004,"word":"智珠在握","pinyin":"zhì zhū zài wò","abbr":"zzzw","explanation":"智珠：佛教指本性的智慧。比喻具有高深的智慧并能应付任何事情。","source":{"text":"愿为尘外契，一就智珠明。","book":"唐·张祜《题赠志凝上人》"},"example":{"text":"然阁下～，或小试其使贪诈之才，而仍有毅然不惑之见，恐非香亭之所能知也。","book":"清·袁枚《与刘介石太守》"},"usage":"作谓语、定语；用于书面语"},{"id":25005,"word":"智穷才尽","pinyin":"zhì qióng cái jìn","abbr":"zqcj","explanation":"智能与才能已经穷尽。","example":{"text":"经过几番与诸葛亮较量的失败，周瑜已是～了。"}},{"id":25006,"word":"智者乐水，仁者乐山","pinyin":"zhì zhě yuè shuǐ,rén zhě yuè shān","abbr":"zzlsrzls","explanation":"智慧的人喜爱山，仁义的人喜爱水。比喻各人的爱好不同。","source":{"text":"知者乐山，仁者乐水。","book":"《论语·雍也》"},"usage":"作宾语、定语；用于书面语"},{"id":25007,"word":"智者千虑，必有一失","pinyin":"zhì zhě qiān lǜ，bì yǒu yī shī","abbr":"zzqlbyys","explanation":"不管多聪明的人，在很多次的考虑中，也一定会出现个别错误。","source":{"text":"臣闻智者千虑，必有一失；愚者千虑，必有一得。","book":"《晏子春秋·内篇杂下》：“圣人千虑，必有一失；愚者千虑，必有一得。”《史记·淮阴侯列传》"},"example":{"text":"再聪明的人，也不应该骄傲，因为～。"},"similar":["愚者千虑，必有一得"],"usage":"作宾语、定语、分句；指不要过分自信","story":["楚汉相争时期，韩信活捉赵王歇后，同时活捉他的参谋李左车。韩信十分谦虚地向李左车求取燕齐之道。李左车建议他暂时休整，同时加强伐燕的舆论攻势，可以不战而胜。他说：“智者千虑，必有一失；愚者千虑，必有一得。这些仅供参考。”"]},{"id":25008,"word":"智者千虑，或有一失","pinyin":"zhì zhě qiān lǜ，huò yǒu yī shī","abbr":"zzqlhyys","explanation":"指聪明人对问题深思熟虑，也难免出现差错。","source":{"text":"臣闻智者千虑，或有一失；愚夫千计，亦有一得。","book":"《旧唐书·宇文融传》"},"similar":["智者千虑，必有一失"],"usage":"作宾语、定语、分句；指不要过分自信"},{"id":25009,"word":"智者所见略同","pinyin":"zhì zhě suǒ jiàn lüè tóng","abbr":"zzsjlt","explanation":"所见：所见到的，指见解；略：大略，大致。聪明人的见解基本相同。这是对意见相同的双方表示赞美的话。","source":{"text":"天下智谋之士所见略同耳。","book":"《三国志·蜀志·庞统传》裴松之注引《江表传》"},"example":{"text":"明·冯梦龙《东周列国志》第59回：“韩厥先以病辞。匄曰：‘～也。’”"},"similar":["英雄所见略同"],"usage":"作宾语、定语；对意见相同的表示赞美的话"},{"id":25010,"word":"智者见智，仁者见仁","pinyin":"zhì zhě jiàn zhì，rén zhě jiàn rén","abbr":"zzjzrzjr","explanation":"指对待同一问题，其见解因人而异，各有道理。","source":{"text":"仁者见之谓之仁，智者见之谓之智。","book":"语出《易·系辞上》"},"example":{"text":"她这样做正说明她无比高尚！～。","book":"《花城》1981年第6期"},"similar":["仁者见仁，智者见智"],"usage":"作宾语、定语；用于书面语"},{"id":25011,"word":"智藏瘝在","pinyin":"zhì cáng guān zài","abbr":"zcgz","explanation":"指贤人隐遁，病民之臣在位。","source":{"text":"纣政不善，贤者藏匿，病民者在位。","book":"《书·召诰》：“厥终智藏瘝在。”周秉钧易解"},"usage":"作宾语、定语；用于书面语"},{"id":25012,"word":"智贵免祸","pinyin":"zhì guì miǎn huò","abbr":"zgmh","explanation":"智：智慧。人的聪明智慧，正当使用，可以使他避免灾祸。","source":{"text":"夫智贵免祸，明尚夙达，仆揆汉中王虑定于内疑生于外矣；虑定则心固，疑生则心惧，乱祸之兴作，未曾不由废立之间也。","book":"《三国志·蜀志·刘封传》"}},{"id":25013,"word":"智足以拒谏，言足以饰非","pinyin":"zhì zú yǐ jù jiàn,yá zú yǐ shì fēi","abbr":"zzyjjyzysf","explanation":"智谋足以使人拒绝规劝，言辞足以使人拒绝过错。","source":{"text":"帝纣资辨捷疾，闻见甚敏；材力过人，手格猛兽；知足以距谏，言足以饰非；矜人臣以能，高天下以声，以为皆出己之下。","book":"《史记·殷本纪》"},"example":{"text":"海陵～。欲为君则弑其君，欲伐国则弑其母，欲夺人之妻则使之杀其夫。三纲绝矣，何暇他论。（《金史·海陵纪赞》）"},"similar":["智足以饰非，辩足以行说"],"usage":"作宾语、定语；用于书面语"},{"id":25014,"word":"智足以饰非，辩足以行说","pinyin":"zhì zú yǐ shì fēi，biàn zú yǐ xíng shuì","abbr":"zzysfbzyxs","explanation":"智：智谋，指巧诈，诡辩。巧诈足够拒绝别人的规劝，言辞足够掩饰自己的过失","source":{"text":"四曰智足以饰非，辩足以行说，反言易辞而成文章，内离骨肉之亲，外妒乱朝廷，如此者谗臣也。","book":"汉·刘向《说苑·臣术》"},"similar":["智足以拒谏，言足以饰非"],"usage":"作宾语、定语；用于书面语"},{"id":25015,"word":"智过万人","pinyin":"zhì guò wàn rén","abbr":"zgwr","explanation":"智：才智。形容才智极高","source":{"text":"智过万人者谓之英，千人者谓之俊，百人者为之豪，十人者谓之杰。","book":"西汉·刘安《淮南子·修务训》"},"usage":"作谓语、定语；用于书面语"},{"id":25016,"word":"暂劳永逸","pinyin":"zàn láo yǒng yì","abbr":"zlyy","explanation":"犹一劳永逸。指以一时的辛劳，换取长久的安逸。","source":{"text":"暂劳永逸，无为而治。","book":"汉·张衡《西京赋》"},"example":{"text":"乞依古制，调丁夫修叠石翣，可得数十年不挠，所谓～矣。","book":"《宋史·河渠志四》"},"similar":["一劳永逸"],"opposite":["劳而无功"],"usage":"作谓语、定语；指一劳永逸"},{"id":25017,"word":"暑去寒来","pinyin":"shǔ qù hán lái","abbr":"sqhl","explanation":"盛夏已过，寒冬将至。泛指时光流逝。","source":{"text":"寒往则暑来，暑往则寒来，寒暑相推，而岁成焉。","book":"《周易·系辞下》"}},{"id":25018,"word":"暑往寒来","pinyin":"shǔ wǎng hán lái","abbr":"swhl","explanation":"夏天过去，冬天到来。泛指时光流逝。","source":{"text":"草茂故辙，松插新枚。月明泉暗，暑往寒来。","book":"南朝·梁简文帝《中书令临汝灵侯墓志铭》"},"example":{"text":"～春复秋，夕阳西下水东流，将军战马今何在？野草闲花满地愁。","book":"明·汤显祖《南柯记·系帅》"},"similar":["寒来暑往"],"usage":"作状语、分句；指时光流逝"},{"id":25019,"word":"暑来寒往","pinyin":"shǔ lái hán wǎng","abbr":"slhw","explanation":"夏天过去，冬天到来。泛指时光流逝。","source":{"text":"暑来寒往，地久天长，神哉华观，永配无疆。","book":"南朝·梁·陆倕《石阙铭》"},"example":{"text":"乍见灵妃含笑往，复闻游女怨歌来。～运洄洑，潭生水落移陵谷。","book":"唐·张说《同赵侍御乾湖作》诗"},"similar":["暑往寒来"],"usage":"作状语、分句；指时光流逝"},{"id":25020,"word":"暑雨祁寒","pinyin":"shǔ yǔ qí hán","abbr":"syqh","explanation":"夏大雨，冬大寒。后以之为怨嗟生计艰难之典。","source":{"text":"祁，大也。暑雨祁寒，小民怨咨，自伤其生之艰难也。","book":"《书·君牙》：“夏暑雨，小民惟曰怨咨，冬祁寒，小民亦惟曰怨咨，厥惟艰哉！”蔡沉集传"},"example":{"text":"《梁书·萧昱传》：“臣闻～，小人犹怨；荣枯宠辱，谁能忘怀！”"},"usage":"作宾语、定语；用于书面语"},{"id":25021,"word":"暖暖姝姝","pinyin":"xuán xuán shū shū","abbr":"nnss","explanation":"自满，沾沾自喜的样子。","source":{"text":"所谓暖姝者，学一先生之言，则暖暖姝姝而私自说也，自以为足矣，而未知未始有物也。","book":"《庄子·徐无鬼》"},"example":{"text":"无他，～，守一先生之言，其有稍在此范围外者，非惟不敢言之，抑亦不敢思之。","book":"清·梁启超《保教非所以尊孔论》"}},{"id":25022,"word":"暖衣饱食","pinyin":"nuǎn yī bǎo shí","abbr":"nybs","explanation":"形容生活宽裕，衣食丰足。","source":{"text":"百姓皆得暖衣饱食。","book":"战国·宋·墨翟《墨子·天志中》"},"example":{"text":"也亏做了这事，尤员外尽心供奉，～。","book":"清·褚人获《隋唐演义》第24回"},"similar":["丰衣足食"],"opposite":["饥寒交迫"],"usage":"作谓语、定语；指丰衣足食"},{"id":25023,"word":"暗中作乐","pinyin":"àn zhōng zuò lè","abbr":"azzy","explanation":"暗中：背后，偷偷地。暗地里寻找快乐。","example":{"text":"她常常～，自得其乐。"},"usage":"作谓语、宾语；用于口语"},{"id":25024,"word":"暗中作梗","pinyin":"àn zhōng zuò gěng","abbr":"azzg","explanation":"作梗：阻挠。背地里阻挠。","source":{"text":"平时守着用夏变夷的古训，把新政新学驳得一钱不值，彼要奏阻，此要撤销，暗中作梗。","book":"蔡东藩《慈禧太后演义》第十三回"},"opposite":["明打明敲"],"usage":"作谓语、宾语、定语；用于处事"},{"id":25025,"word":"暗中倾轧","pinyin":"àn zhōng qīng yà","abbr":"azqy","explanation":"倾轧：互相排挤。暗地里互相排挤打击。","source":{"text":"表面上卖个虚名，粉饰大局，其实暗中倾轧，入主出奴。","book":"蔡东藩、许廑父《民国通俗演义》第一百十一回"},"usage":"作谓语、宾语；指人背地斗争"},{"id":25026,"word":"暗中摸索","pinyin":"àn zhōng mō suǒ","abbr":"azms","explanation":"摸索：寻求，探索。在黑暗中寻找。后比喻没有人指导，独自钻研。","source":{"text":"许敬宗性轻傲，见人多忘之。或谓其不聪。曰：‘卿自难记，若遇何（何逊）、刘（刘孝绰）、沈（沈约）、谢（谢眺），暗中摸索者亦可识之。’","book":"唐·刘餗《隋唐嘉话》"},"example":{"text":"先生有志于木刻，是极好的事，但访木刻家是无益的，因为就是已有成绩的木刻家，也还在～。","book":"《鲁迅书信集·致沈振黄》"},"opposite":["豁然开朗","老马识途"],"usage":"作谓语、定语；形容只靠自己力量去摸索探求","story":["唐朝时期，文人许敬宗为人傲慢，新交的朋友经人介绍后往往立刻忘记人家的姓名。有人说他记性太坏，他辩解说：“像你这种人，我当然记不住，倘若遇到何逊、刘孝标、沈约、谢朓他们，即使是暗中摸索，我也不难辨认。”"]},{"id":25027,"word":"暗中盘算","pinyin":"àn zhōng pán suàn","abbr":"azps","explanation":"指暗自在心中计算自己的得失等。","example":{"text":"我～自己能否渡过这个难关。"},"similar":["暗中算计"],"usage":"作谓语、宾语；指暗自计算"},{"id":25028,"word":"暗室不欺","pinyin":"àn shì bù qī","abbr":"asbq","explanation":"在没有人看见的地方，也不做见不得人的事。","source":{"text":"类君子之有道，入暗室而不欺。","book":"唐·骆宾王《萤火赋》"},"example":{"text":"知县生平～，既读孔、孟之书，怎敢行盗跖之事？","book":"明·冯梦龙《醒世恒言》卷十三"},"similar":["不欺暗室"],"opposite":["暗箭伤人","暗室欺心"],"usage":"作谓语、定语；比喻自觉不作亏心事","story":["春秋时期，卫国贤臣蘧伯玉一贯遵守朝中礼制，夜间乘车经过卫灵公的宫殿前，按照朝中礼制得下马车步行。他从来就不因夜晚没人看见而不遵守宫廷礼节，卫灵公因此十分器重他，并经常在朝会上夸他暗室不欺"]},{"id":25029,"word":"暗室亏心","pinyin":"àn shì kuī xīn","abbr":"askx","explanation":"在暗中做见不得人的亏心事。","source":{"text":"暗室亏心，纵然致富，天意何如。","book":"元·张养浩《折桂令》曲"},"example":{"text":"我想来今生不报，来世偿还，正所谓～，神目如电。","book":"明·范受益《寻亲记·托梦》"},"similar":["暗室欺心"],"opposite":["暗室不欺"],"usage":"作谓语、定语；比喻暗中做坏事"},{"id":25030,"word":"暗室屋漏","pinyin":"àn shì wū lòu","abbr":"aswl","explanation":"指别人看不见的地方；隐私之室。","source":{"text":"至于发人隐恶，虽亏雅道，亦使暗室屋漏之下有所警是亦小道之可观者。","book":"宋·张世南《游宦纪闻》卷四"},"example":{"text":"瓜田李下，明侠女之志；～，窥君子之心。","book":"《好逑传》第六回"},"similar":["不愧屋漏"],"usage":"作宾语、定语；指别人看不见的地方"},{"id":25031,"word":"暗室欺心","pinyin":"àn shì qī xīn","abbr":"asqx","explanation":"在黑暗的屋子里昧着良心做坏事。指偷偷地做坏事。","source":{"text":"人间私语，天闻若雷，暗室欺心，神目如电。","book":"宋·陈元靓《事林广记·卷九·警世格言》"},"example":{"text":"方信道暗室亏心，难逃他神目如电。","book":"《元曲选·无名氏三》"},"similar":["暗室亏心"],"opposite":["暗室不欺"],"usage":"作谓语；指暗中作坏事"},{"id":25032,"word":"暗室求物","pinyin":"àn shì qiú wù","abbr":"asqw","explanation":"在没有光亮的房间寻找东西。比喻读书不得要领，难见成效。","source":{"text":"如暗室求物，把火来便照见；若只管去摸索，费尽心力，只是搜索不见。","book":"《朱子语类辑略·总论为学之方》"},"example":{"text":"这样做下去就如同～一样没有成效。"},"usage":"作宾语、定语；指没有目的"},{"id":25033,"word":"暗室私心","pinyin":"àn shì sī xīn","abbr":"assx","explanation":"指在暗中做见不得人的亏心事。同“暗室亏心”。","source":{"text":"丈夫然诺重如山，暗室私心鬼神见。","book":"明·陆采《明珠记·却婚》"},"example":{"text":"我一向光明磊落，从没有～。"},"similar":["暗室亏心"],"usage":"作宾语、定语；比喻暗中做坏事"},{"id":25034,"word":"暗室逢灯","pinyin":"àn shì féng dēng","abbr":"asfd","explanation":"比喻在危难或困惑中，忽然遇人援救或指点引导。","source":{"text":"比喻在危难或困惑中，忽然遇人援救或指点引导。"},"example":{"text":"你的指点让我有～之感。"},"similar":["雪中送炭","绝渡逢舟"],"usage":"作谓语、定语；比喻在绝处得到别人的帮助"},{"id":25035,"word":"暗察明访","pinyin":"àn chá míng fǎng","abbr":"acmf","explanation":"察：细看，详审；访：寻访。指用各种方法调查了解情况。","source":{"text":"此辈暗察明访，皆著政声。","book":"《金史·世宗纪中》"},"example":{"text":"经过～，我们终于发现了问题的症结所在。"},"similar":["明察暗访"],"usage":"作谓语、定语；用于颂扬"},{"id":25036,"word":"暗度金针","pinyin":"àn dù jīn zhēn","abbr":"adjz","explanation":"度：通“渡”，过渡，引申为传授。后用于比喻秘诀。又借指幕后交易。","source":{"text":"见唐·冯翊子休《桂苑丛谈·史遗》。传说有名叫郑采珠的姑娘，七夕祭织女，织女送她一根金针，从此她刺绣的技能更为精巧。"},"example":{"text":"日本政府，向来主张～，我国虽尚守中立，未曾加入协约团体，但日本如此举动，本使也很不赞成。","book":"蔡东藩《民国演义》第六十回"},"usage":"作宾语、定语；指暗中做事"},{"id":25037,"word":"暗度陈仓","pinyin":"àn dù chén cāng","abbr":"adcc","explanation":"指正面迷惑敌人，而从侧翼进行突然袭击。亦比喻暗中进行活动。陈仓，古县名，在今陕西省宝鸡市东，为通向汉中的交通孔道。","source":{"text":"《史记·高祖本纪》：“……项王使卒三万人从，楚与诸侯之慕从者数万人，从杜南入蚀中。去辄烧绝栈道，以备诸侯盗兵袭之，亦示项羽无东意……八月，汉王用韩信之计，从故道还，袭雍王章邯。邯迎击汉陈仓，雍兵败，…"},"example":{"text":"臣已算定今番诸葛亮必效韩信～之计。","book":"《三国演义》第九六回"},"similar":["暗送秋波"],"opposite":["明目张胆","明火执杖"],"usage":"作谓语、定语；比喻暗中活动","story":["秦末项羽灭了秦以后，自封西楚霸王，背叛谁先攻入咸阳的人为王的约定，刘邦极为不满，领兵进入四川，沿途烧了巴蜀的栈道，封为汉王，刘邦得到韩信的帮助，明里在修栈道，背地绕道轻取项羽的大将章邯，进而取得中原为王"]},{"id":25038,"word":"暗弱无断","pinyin":"àn ruò wú duàn","abbr":"arwd","explanation":"愚昧软弱，没有决断。","source":{"text":"《资治通鉴·卷九十一·晋元帝太兴三年》：“(司马保)好读书而暗弱无断，故及于难”。"},"similar":["犹豫不决"],"opposite":["干脆利索"],"usage":"作谓语、定语；指人没有决断能力"},{"id":25039,"word":"暗斗明争","pinyin":"àn dòu míng zhēng","abbr":"admz","explanation":"暗里明里都在进行斗争。常形容尽力争权夺利。","source":{"text":"南方的桂滇黔等小军阀，暗斗明争，弄得全中国民不聊生。","book":"李六如《六十年的变迁》第二卷第七章"},"example":{"text":"～对双方都没有好处。"},"similar":["明争暗斗"],"opposite":["肝胆相照"],"usage":"作谓语、宾语、定语；指内部争斗"},{"id":25040,"word":"暗无天日","pinyin":"àn wú tiān rì","abbr":"awtr","explanation":"昏暗得看不到天上的日光。形容在反动势力统治下社会的黑暗。","source":{"text":"剖腹沉石，惨冤已甚，而木雕之有司，绝不少关痛痒，岂特粤东之暗无天日哉！","book":"清·蒲松龄《聊斋志异·老龙船户》"},"example":{"text":"上自王后，下至弄臣，骇得凝结着的神色也应声活动起来，似乎感到～的悲哀。","book":"鲁迅《故事新编·铸剑》"},"similar":["不见天日","漆黑一团"],"opposite":["重见天日","大放光明"],"usage":"作谓语、定语；形容反动势力的黑暗统治"},{"id":25041,"word":"暗昧之事","pinyin":"àn mèi zhī shì","abbr":"amzs","explanation":"指见不得人的丑事。","source":{"text":"庞吉你乃堂堂国戚，如何行此小人暗昧之事？","book":"清·石玉昆《三侠五义》第32回"},"example":{"text":"我们不能做～。"},"usage":"作宾语；指见不得人的丑事"},{"id":25042,"word":"暗气暗恼","pinyin":"àn qì àn nǎo","abbr":"aqan","explanation":"受了气闷在心里。","source":{"text":"又着了那暗气暗恼在心里，就是铁石人也禁不的。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"},"usage":"作谓语、状语；指人的心情"},{"id":25043,"word":"暗淡无光","pinyin":"àn dàn wú guāng","abbr":"adwg","explanation":"暗淡：不明亮，昏暗。形容失去光彩。","source":{"text":"头上戴一个黯淡无光的亮蓝顶儿，那枝俏摆春风的孔雀瓴已经虫蛀的剩了光杆儿了。","book":"清·文康《儿女英雄传》第三十四回"},"example":{"text":"太阳过了，整个天空又显得～，北风在头项上呼呼地嚎叫着。","book":"欧阳山《苦斗》五八"},"similar":["黯然失色","黯淡无光"],"opposite":["金光灿烂"],"usage":"作定语、状语；指没有光彩"},{"id":25044,"word":"暗渡陈仓","pinyin":"àn dù chén cāng","abbr":"adcc","explanation":"渡：越过；陈仓：古县名，在今陕西省宝鸡市东。比喻用造假象的手段来达到某种目的或暗中进行活动","source":{"text":"就是韩信暗渡陈仓道，有贼兵来犯着，杀得他怎生逃。","book":"明·胡文焕《群音类选·》"},"example":{"text":"清·如莲居士《薛刚反唐》第54回：“这日马周正与众将计议一个～之计，去湘州接取唐王夫妇。”"},"similar":["暗度陈仓"],"opposite":["明目张胆"],"usage":"作谓语、定语；比喻暗中活动","story":["秦末项羽灭了秦以后，自封西楚霸王，背叛谁先攻入咸阳的人为王的约定，刘邦极为不满，领兵进入四川，沿途烧了巴蜀的栈道，封为汉王，刘邦得到韩信的帮助，明里在修栈道，背地绕道轻取项羽的大将章邯，进而取得中原为王"]},{"id":25045,"word":"暗牖空梁","pinyin":"àn yǒu kōng liáng","abbr":"aykl","explanation":"牖：窗户。窗户昏暗，房子空无一人。虎穴门庭冷落。","source":{"text":"暗牖悬蛛网，空梁落燕泥。","book":"隋·薛道衡《昔昔盐》"}},{"id":25046,"word":"暗礁险滩","pinyin":"àn jiāo xiǎn tān","abbr":"ajxt","explanation":"暗藏的礁石，不易通过的河滩。比喻隐藏的祸患或危险的障碍。","example":{"text":"这河段特别复杂，到处都是～。"},"similar":["艰难险阻"],"usage":"作主语、宾语、定语；指危险"},{"id":25047,"word":"暗箭中人","pinyin":"àn jiàn zhòng rén","abbr":"ajzr","explanation":"暗：暗中；箭：放箭；中：中伤。放冷箭伤害人。比喻暗中用阴险的手段攻击或陷害别人。","source":{"text":"暗箭中人，其深次骨，人之怨之，亦必次骨，以其掩人所不备也。","book":"宋·刘炎《迩言》卷六"},"example":{"text":"你休想～。"},"similar":["暗箭伤人"],"opposite":["光明正大"],"usage":"作谓语、定语；形容在背地里耍手段伤害人"},{"id":25048,"word":"暗箭伤人","pinyin":"àn jiàn shāng rén","abbr":"ajsr","explanation":"放冷箭伤害人。比喻暗地里用某种手段伤害人。","source":{"text":"暗箭中人，其深次骨，人之怨之，亦必次骨，以其掩人所不备也。","book":"宋·刘炎《迩言》卷六"},"example":{"text":"有荼毒生灵的强盗，有～的强盗。","book":"清·李汝珍《镜花缘》第五十八回"},"similar":["冷箭伤人","笑里藏刀","暗箭中人"],"opposite":["光明正大","明火执杖","襟怀坦荡"],"usage":"作谓语、定语；形容在背地里耍手段伤害人"},{"id":25049,"word":"暗箭明枪","pinyin":"àn jiàn míng qiāng","abbr":"ajmq","explanation":"比喻各种公开的攻击和暗地里的中伤。","source":{"text":"忽心痴撞入他迷魂阵图里，暗箭明枪难躲避。","book":"明·胡文焕《群音类选·清腔类》"},"example":{"text":"我们抵挡了敌人的～，控制了局面。"},"similar":["明枪暗箭"],"opposite":["开诚布公"],"usage":"作主语、宾语；用于较量的场合"},{"id":25050,"word":"暗箭难防","pinyin":"àn jiàn nán fáng","abbr":"ajnf","explanation":"冷箭最难防范。比喻阴谋诡计难以预防。","source":{"text":"暗箭中人，其深次骨，人之怨之，亦必次骨，以其掩人所不备也。","book":"宋·刘炎《迩言》卷六"},"example":{"text":"孩儿也，一了说明枪好躲，～。","book":"元·无名氏《独角牛》"},"similar":["暗箭伤人"],"opposite":["正大光明"],"usage":"作谓语、宾语；比喻阴谋手段令人难以防备"},{"id":25051,"word":"暗约偷期","pinyin":"àn yuē tōu qī","abbr":"aytq","explanation":"暗地里私自定约。指男女间相爱或勾搭。","source":{"text":"又不是月下星前，暗约偷期。","book":"元·元名氏《符金锭》第一折"},"example":{"text":"周得与梁姐姐～，街坊邻里，哪一个不晓得？","book":"明·冯梦龙《古今小说·任孝子烈性为神》"},"similar":["暗约私期"],"usage":"作谓语；多用于男女之间"},{"id":25052,"word":"暗约私期","pinyin":"àn yuē sī qī","abbr":"aysq","explanation":"约、期：约定。暗地里私自互相定约。旧指青年男女相爱，暗定下婚约。也指男女不正当交往。","source":{"text":"则为我暗约私期，致令得离乡背井。","book":"元·无名氏《云窗梦》第三折"},"similar":["暗约偷期"],"usage":"作谓语；指暗中约定"},{"id":25053,"word":"暗绿稀红","pinyin":"àn lǜ xī hóng","abbr":"alxh","explanation":"犹言绿肥红瘦。形容叶盛花稀的暮春景象。","source":{"text":"况当残春初夏之时，正值暗绿稀红之候，顿起愁绪，怎生消闷怀？","book":"明·陈汝元《金莲记·归田》"},"example":{"text":"明·陈汝元《金莲记·归田》：“况当残春初夏之时，正值暗绿稀红之候，顿起愁绪，怎生消闷怀？”"},"usage":"作宾语、定语；指暮春景象"},{"id":25054,"word":"暗藏杀机","pinyin":"àn cáng shā jī","abbr":"acsj","explanation":"隐藏杀人的念头。比喻潜在危险。","example":{"text":"从他的话中，我隐约感觉到有些～。"},"usage":"作谓语、定语、宾语；指潜在危险"},{"id":25055,"word":"暗送秋波","pinyin":"àn sòng qiū bō","abbr":"asqb","explanation":"旧时比喻美女的眼睛象秋天明净的水波一样。指暗中眉目传情。","source":{"text":"佳人未肯回秋波，幼舆欲语防飞梭。","book":"宋·苏轼《百步洪》诗之二"},"example":{"text":"对张（作霖）则～，对曹（锟）尤密切勾结。","book":"蔡东藩、许廑父《民国通俗演义》第一二四回"},"similar":["眉目传情","脉脉传情"],"opposite":["明目张胆"],"usage":"作谓语、定语；比喻献媚取宠，暗中勾搭"},{"id":25056,"word":"暗里使劲","pinyin":"àn lǐ shǐ jìn","abbr":"alsj","explanation":"指人暗中用力干什么事。","example":{"text":"他们都在～，争夺这个处长职位。"},"usage":"作谓语；用于较劲或竞争的场合"},{"id":25057,"word":"暗锤打人","pinyin":"àn chuí dǎ rén","abbr":"acdr","explanation":"比喻暗中对人进行攻击。","source":{"text":"暗锤打人，是土行孙出身！","book":"《人民文学》1977年第7期"},"example":{"text":"为人不能使出～的卑劣手段。"},"similar":["暗箭伤人"],"usage":"作宾语、定语；指暗中攻击"},{"id":25058,"word":"暗香疏影","pinyin":"àn xiāng shū yǐng","abbr":"axsy","explanation":"暗香：清幽的香气；疏影：稀疏的枝影。原形容梅花的香味和姿态，后被用为梅花的代称。","source":{"text":"疏影横斜水清浅，暗香浮动月黄昏","book":"宋·林逋《林和靖集·卷二·山园小梅》诗"},"example":{"text":"两个站在小桥上，疏影暗香，自甘清冷，屋后山冈积雪如银，背着手玩赏。","book":"清·陈忱《水浒后传》第十四回"},"similar":["疏影暗香"],"usage":"作谓语、定语；形容梅花","story":["北宋时期著名的隐士林逋曾在江淮一带漫游，后隐居杭州西湖孤山，一生无妻无子，特别酷爱梅花与白鹤，人称梅妻鹤子，他的著名诗篇《山园小梅》表现出他那超凡脱俗的气质：“众芳摇落都暄妍，占尽风情向小园。疏影横斜水清浅，暗香浮动月黄昏。”"]},{"id":25059,"word":"暧昧不明","pinyin":"ài mèi bù míng","abbr":"ambm","explanation":"暧昧：含糊，不清楚。指不清不楚，不明不白。形容态度不明朗，关系不鲜明。","source":{"text":"又把你姑娘一片侠肠，埋没得暧昧不明，我安龙媒真真的愧悔无地！","book":"清·文康《儿女英雄传》第八回"},"example":{"text":"武汉国民政府和当权军人对于这叛变采取了～的态度，办求“化大事为小事”。","book":"陶菊隐《北洋军阀统治时期史话》"},"similar":["含糊不清","不明不白"],"opposite":["泾渭分明"],"usage":"作谓语、状语；指人的态度"},{"id":25060,"word":"暧昧之事","pinyin":"ài mèi zhī shì","abbr":"amzs","explanation":"行为不光明，内有不可告人的隐情。也指男女互相爱悦可能有的私事。","source":{"text":"岂有暧昧之事，疑其君父者。","book":"清·梁绍壬《两般秋雨庵随笔》卷三"}},{"id":25061,"word":"暧昧之情","pinyin":"ài mèi zhī qíng","abbr":"amzq","explanation":"行为不光明，内有不可告人的隐情。也指男女互相爱悦可能的私事。","source":{"text":"做知县时，便能剖人间暧昧之情，断天下狐疑之狱。","book":"明·冯梦龙《警世通言·三现身包龙图断冤》"},"example":{"text":"而孤男寡女并外一室，不无～。","book":"清·明教中人《好逑传》第十五回"},"usage":"作宾语；用于男女之间"},{"id":25062,"word":"暮乐朝欢","pinyin":"mù lè zhāo huān","abbr":"mlch","explanation":"指终日欢乐，整天寻欢作乐。","source":{"text":"唱道暮乐朝欢，须有更阑管弦息。","book":"元·朱庭玉《点绛唇·中秋月》套曲"},"example":{"text":"一个溺爱河而罔悟，只图～，一个沉宦海而久迷，空自南奔北走。","book":"明·陈汝元《金莲记》第十二出"}},{"id":25063,"word":"暮云亲舍","pinyin":"mù yún qīn shě","abbr":"myqs","explanation":"亲：父母，亲人；舍：居所。比喻客居他乡，思念亲人。","source":{"text":"他那里眼巴巴望不见暮云亲舍，想人生最苦离别，他可也官差不自由。","book":"明·康海《王兰卿》第二折"},"similar":["白云亲舍"],"usage":"作主语、定语；指思念亲人"},{"id":25064,"word":"暮云春树","pinyin":"mù yún chūn shù","abbr":"mycs","explanation":"傍晚的云，春天的树。表示对远方友人的思念。","source":{"text":"渭北春天树，江东日暮云。","book":"唐·杜甫《春日忆李白》诗"},"example":{"text":"落月屋梁，相思颜色；～，想望丰仪。","book":"清·程允升《幼学故事琼林·朋友宾主》"},"similar":["春树暮云"],"usage":"作宾语、定语；表示对远方友人的思念"},{"id":25065,"word":"暮云朝雨","pinyin":"mù yún zhāo yǔ","abbr":"mycy","explanation":"指男女之间的情爱与约会。","source":{"text":"愿人间天下，暮云朝雨长相见。","book":"宋·柳永《洞仙歌》"},"similar":["暮云朝雨"],"usage":"作宾语、定语；用于比喻句"},{"id":25066,"word":"暮去朝来","pinyin":"mù qù zhāo lái","abbr":"mqcl","explanation":"黄昏过去，清晨又到来。形容时光流逝。","source":{"text":"弟走从军阿姨死，暮去朝来颜色故。","book":"唐·白居易《琵琶行》"},"example":{"text":"萧娘劝我金卮，殷勤更唱新词。～即老，人生不饮何为？","book":"宋·晏殊《清平乐》词"},"similar":["朝来暮去"],"usage":"作状语、分句；用于时间流逝"},{"id":25067,"word":"暮史朝经","pinyin":"mù shǐ zhāo jīng","abbr":"mscj","explanation":"史：指历史书籍；经：指旧时奉为经典的书籍。一天到晚诵读经史。形容勤奋读书。","source":{"text":"小圣在生之日，萤窗雪案，暮史朝经。","book":"元·无名氏《刘弘嫁婢》第一折"},"usage":"作宾语、定语；用于学习等"},{"id":25068,"word":"暮四朝三","pinyin":"mù sì zhāo sān","abbr":"mscs","explanation":"①原指说法、做法有所变换而实质不变。②比喻反复无常。","source":{"text":"《庄子·齐物论》：“狙公赋芧，曰：‘朝三而暮四。’众狙皆怒。曰：‘然则朝四而暮三。’众狙皆悦。名实未亏而喜怒为用，亦因是也”。"},"example":{"text":"婚姻簿中应细览，俺姐姐只解清谈，陪不得寻常俗物胡淫滥，使不得～。","book":"明·孙仁孺《东郭记·媒妁之言》"},"similar":["朝三暮四","朝四暮三"],"usage":"作谓语、定语、状语；比喻反复无常的人"},{"id":25069,"word":"暮夜先容","pinyin":"mù yè xiān róng","abbr":"myxr","explanation":"指事先暗中行贿，以求宽容。","source":{"text":"今未试之前，采访居其半，请托居其半，甚而暮夜先容，纸上之语，仅免曳白，便足入彀。","book":"明·沈德符《野获编·科场·阁试》"},"usage":"作谓语、定语；用于书面语"},{"id":25070,"word":"暮夜怀金","pinyin":"mù yè huái jīn","abbr":"myhj","explanation":"比喻暗中行贿。","source":{"text":"王密为昌邑令，谒见，至夜怀金十斤以遗震。震曰：‘故人知君，君不知故人，何也？’密曰：‘暮夜无知者。’震曰：‘天知，神知，我知，子知。何谓无知。’密愧而出。","book":"《后汉书·杨震传》"},"usage":"作宾语、定语；用于书面语","story":["东汉时期，太守杨震为人正直，清正廉洁，从来不收受别人的贿赂。受他举荐的昌邑县令王密趁着夜色，给他送去10斤黄金。杨震十分不高兴，王密说夜深人静没人知晓的。杨震说：“天知、地知、你知、我知，我不能收这不义之财。”"]},{"id":25071,"word":"暮夜无知","pinyin":"mù yè wú zhī","abbr":"mywz","explanation":"黑夜无人知晓。","source":{"text":"所举荆州茂才王密为昌邑令，谒见，至夜怀金十斤以遗震。震曰：‘故人知君，君不知故人，何也？’密曰：‘暮夜无知者。’震曰：‘天知、神知、我知、子知。何谓无知。’","book":"《后汉书·杨震传》"},"example":{"text":"你不要以为～就可以为所欲为。"},"usage":"作宾语、定语；指暗中做事，无人知道","story":["东汉时期，太守杨震为人正直，清正廉洁，从来不收受别人的贿赂。受他举荐的昌邑县令王密趁着夜色，给他送去10斤黄金。杨震十分不高兴，王密说夜深人静没人知晓的。杨震说：“天知、地知、你知、我知，我不能收这不义之财。”"]},{"id":25072,"word":"暮想朝思","pinyin":"mù xiǎng zhāo sī","abbr":"mxcs","explanation":"形容时时刻刻都在想念。","source":{"text":"形只影单添凄楚，暮想朝思愈困苦。","book":"元·柯丹邱《荆钗记·遣仆》"},"example":{"text":"明·周履靖《锦笺记·遥访》：“小生向与淑娘，既不得谐姻好，又不得尽别情，以故～，顿忘山遥水远。”"},"similar":["朝思暮想"],"usage":"作谓语、状语；用于男女情爱方面"},{"id":25073,"word":"暮景桑榆","pinyin":"mù jǐng sāng yú","abbr":"mjsy","explanation":"夕阳斜照在桑树和榆树顶端，一派黄昏景象。比喻晚年的时光。桑榆，古人以为是日所入处。","source":{"text":"愿垂薄暮景，照妾桑榆时。","book":"三国·魏·曹植《赠白马王彪》诗：“年在桑榆间，影响不能追。”南朝·梁·萧统《文选·刘铄〈拟古二首〉》"},"example":{"text":"人都道～，合有些峥嵘气象。可正是乐极生悲，今日个泰来否往。","book":"元·宫大用《范张鸡黍》第四折"},"similar":["桑榆暮景","桑榆末景","桑榆暮影"],"usage":"作宾语、定语；用于比喻句"},{"id":25074,"word":"暮景残光","pinyin":"mù yǐng cán guāng","abbr":"mjcg","explanation":"景：能“影”，日光。指夕阳残照。比喻风烛残年，余日无多。","source":{"text":"窃以暮景残光，能余几日，酬恩报义，正在今时。","book":"宋·邵伯温《闻见前录》卷六"},"similar":["暮景桑榆"],"usage":"作宾语、定语；指晚年等"},{"id":25075,"word":"暮暮朝朝","pinyin":"mù mù zhāo zhāo","abbr":"mmzz","explanation":"犹言日日夜夜。形容延续的时间长。","source":{"text":"自言身在此山中，暮暮朝朝看不足。","book":"宋·李纲《访李道士》诗"},"example":{"text":"［赤壁江］，汇集万二千峰的溪流，～，带着哀怨的声音，被那狂暴的日本海潮吞吸而去。","book":"郭沫若《残春及其他·牧羊哀话一》"},"usage":"作宾语、定语、状语；用于书面语"},{"id":25076,"word":"暮来朝去","pinyin":"mù lái zhāo qù","abbr":"mlcq","explanation":"暮：傍晚；朝：早晨。清晨过去黄昏来临。形容时光流逝。","source":{"text":"少年国足们来到巴西训练，暮来朝去，寒来暑往，两个年头过去了。","book":"《中国体育报》"},"similar":["朝来暮去","寒来暑往"],"usage":"作状语、分句；用于时间流逝"},{"id":25077,"word":"暮楚朝秦","pinyin":"mù chǔ cháo qín","abbr":"mccq","explanation":"①战国时期，秦楚两大强国对立，有些弱小国家时而事秦，时而事楚。后以之比喻反复无常或主意不定。②比喻事物的归属变换不定。","source":{"text":"平泉木石，多暮楚朝秦，故园亭亦聊且为之，如传舍衙署焉。","book":"明·张岱《陶庵梦忆·日月湖》"},"example":{"text":"痴珠自幼本系娇养，弱冠在第，文章丰采，倾动一时。兼之内国无忧，仅来常有，以此轻裘肥马，～，名宿倾心，美人解佩。","book":"清·魏秀仁《花月痕》第八回"},"similar":["朝秦暮楚"],"usage":"作谓语、定语；比喻反复无常"},{"id":25078,"word":"暮气沉沉","pinyin":"mù qì chén chén","abbr":"mqcc","explanation":"暮气：黄昏时的烟霭；沉沉：低沉。形容精神萎靡不振，缺乏朝气。","source":{"text":"楼堞参差暮气昏。","book":"宋·陆游《访毛平仲问疾与其子适同游柯山》"},"example":{"text":"宋朝选拔官员一向总是选所谓老成稳健之士，所以朝廷中就充满了须发苍苍、～的人。","book":"蒲韧《二千年间》九"},"similar":["死气沉沉"],"opposite":["朝气蓬勃"],"usage":"作谓语、补语；指缺乏朝气"},{"id":25079,"word":"暮爨朝舂","pinyin":"mù cuàn cháo chōng","abbr":"mccc","explanation":"早晨舂米晚上烧火煮饭，形容生活清苦。","source":{"text":"楼上墙头无一物，暮爨朝舂一生足。","book":"金·元好问《后平湖曲》"},"usage":"作宾语、定语；用于书面语"},{"id":25080,"word":"暮礼晨参","pinyin":"mù lǐ chén cān","abbr":"mlcc","explanation":"早晚参拜。形容心地虔诚。","source":{"text":"我每日家暮礼晨参。","book":"元·戴善夫《玩江亭》第三折"},"similar":["朝参暮礼"],"usage":"作谓语、宾语、定语；用于交往"},{"id":25081,"word":"暮翠朝红","pinyin":"mù cuì cháo hóng","abbr":"mcch","explanation":"形容爱情不专一。","source":{"text":"余非登徒子，誓不效杂情奴态，暮翠朝红。","book":"清·徐瑶《太恨生传》"},"similar":["朝三暮四"],"usage":"作谓语、定语；用于感情不专一"},{"id":25082,"word":"暮色苍茫","pinyin":"mù sè cāng máng","abbr":"mscm","explanation":"指时已傍晚，天色昏暗，眼前的景物已模糊不清。","source":{"text":"海参崴在冬季白昼时间极短。上午八时天还未大亮，下午五时，已经暮色苍茫。","book":"《茅盾散文·旅踪屐痕·海参崴印象》"},"example":{"text":"座间谈笑风声，不觉已是～。","book":"《卓越的科学家竺可桢》"},"usage":"作宾语、定语；指黄昏"},{"id":25083,"word":"暮虢朝虞","pinyin":"mù guó zhāo yú","abbr":"mgzy","explanation":"春秋时晋国假道虞国去打虢国，打下虢国之后，在归途中又把虞国灭了。比喻覆灭变迁的迅速。","source":{"text":"《左传·僖公五年》"},"example":{"text":"洛阳城阙变灰烟，～只眼前。（金·元好问《俳体雪香亭杂咏诗》之二）"},"usage":"作定语、宾语；比喻覆灭变迁的迅速"},{"id":25084,"word":"暮雨朝云","pinyin":"mù yǔ zhāo yún","abbr":"myzy","explanation":"指男女间的情爱与欢会。","source":{"text":"妾在巫山之阳，高丘之阻，旦为朝云，暮为行雨。朝朝暮暮，阳台之下。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"暮雨迎，朝云送，～去无踪。","book":"元·马致远《四块玉·巫山庙（暮雨迎）》"},"similar":["暮云朝雨"],"usage":"作宾语、定语；用于比喻句","story":["传说古代楚襄王游览高唐地区，十分疲倦就在白天小睡了一会，在梦中看见一个仙女说：“我是高唐人，听说你来了，愿意给你当枕席。”楚襄王临幸了她。临别她说：“妾在巫山之阳，高丘之阻。旦为朝云，暮为行雨，朝朝暮暮，阳台之下。”"]},{"id":25085,"word":"暮鼓晨钟","pinyin":"mù gǔ chén zhōng","abbr":"mgcz","explanation":"佛教规矩，寺里晚上打鼓，早晨敲钟。比喻可以使人警觉醒悟的话。","source":{"text":"朝钟暮鼓不到耳，明月孤云长挂情。","book":"唐·李咸中《山中》诗"},"example":{"text":"我委实的捱不彻～。","book":"元·纪君祥《赵氏孤儿》第二折"},"similar":["暮鼓朝钟"],"usage":"作主语、宾语、定语；指使人警觉醒悟的话","story":["洛阳附近龙门石窟始建于北魏孝文帝，在长约一公里山崖上，共雕刻佛像近十万尊，艺术水平最高的是奉先寺，寺内供奉的是卢舍那佛，高17米。杜甫作《游龙门奉先寺》描写僧侣的晨钟暮鼓生活：“天阙象纬逼，云卧衣裳冷。欲觉闻晨钟，令人发深省。”"]},{"id":25086,"word":"暮鼓朝钟","pinyin":"mù gǔ zhāo zhōng","abbr":"mgcz","explanation":"比喻可以使人警觉醒悟的话。同“暮鼓晨钟”。","source":{"text":"暮鼓朝钟自击撞，闭门孤枕对残釭。","book":"宋·苏轼《书双竹湛师房》"},"similar":["暮鼓晨钟"],"usage":"作主语、宾语、定语；指使人警觉醒悟的话"},{"id":25087,"word":"暴不肖人","pinyin":"bào bù xiāo rén","abbr":"bbxr","explanation":"暴：凶暴；不肖：不贤。凶暴而不贤的人。","source":{"text":"以此说观之，则必非莫三代圣善人也，心暴不肖人也。","book":"《墨子·非命下》"}},{"id":25088,"word":"暴内陵外","pinyin":"bào nèi líng wài","abbr":"bnlw","explanation":"暴：残害；陵：同“凌”，侵犯，凌侮。对内残害百姓，对外欺压弱小。","source":{"text":"贼贤害民，则伐之，暴内陵外，则壇之。","book":"《周礼·夏官·司马上》"},"usage":"作谓语、定语；指非常霸道"},{"id":25089,"word":"暴厉恣睢","pinyin":"bào lì zí suī","abbr":"blzs","explanation":"暴：残暴；恣睢：横行霸道，任意妄为。形容残暴凶狠，恣意横行。","source":{"text":"这位新官，或是慈祥恺恻，叫人感恩，或是暴厉恣睢，叫人畏惧。","book":"清·李宝嘉《文明小史》第12回"},"similar":["暴戾恣睢"],"opposite":["慈眉善目"],"usage":"作谓语、定语；形容为人凶恶残暴"},{"id":25090,"word":"暴发户","pinyin":"bào fā hù","abbr":"bfh","explanation":"指突然发了财得了势的人。","source":{"text":"城里的大官大府，翰林、尚书，咱伺候过多少，没瞧过他这囚攘的暴发户，在咱面上混充老爷！","book":"清·李宝嘉《官场现形记》第一回"},"example":{"text":"这种鄙吝势利的～，咱们不希罕和他们做亲家。","book":"钱钟书《围城》"},"usage":"作主语、宾语、定语；用于口语"},{"id":25091,"word":"暴取豪夺","pinyin":"bào qǔ háo duó","abbr":"bqhd","explanation":"豪：强横。用暴力劫夺。","source":{"text":"国用不足，则加赋于民，加赋而不已，则凡暴取豪夺之法，不得不施于今世矣。","book":"宋·苏轼《策断上》"},"similar":["巧取豪夺"],"usage":"作谓语、宾语；指抢劫"},{"id":25092,"word":"暴富乞儿","pinyin":"bào fù qǐ ér","abbr":"bfqe","explanation":"暴：突然；乞儿：乞丐。乞丐突然间富裕了。指非常规的地突然变得富有。","source":{"text":"暴富乞儿休说梦，谁家窖里火无烟。","book":"宋·释惟白《续传灯录》卷三十五"}},{"id":25093,"word":"暴戾恣睢","pinyin":"bào lì zì suī","abbr":"blzs","explanation":"暴戾：凶恶、残暴；恣睢：任意做坏事。形容凶残横暴，想怎么干就怎么干。","source":{"text":"暴戾恣雎，聚党数千人，横行天下。","book":"《史记·伯夷列传》"},"example":{"text":"这位新官，或是慈祥恺恻，叫人感恩；或是暴戾瓷睢，叫人畏惧，做书的人，都不暇细表。","book":"清·李宝嘉《文明小史》第十二回"},"similar":["穷凶极恶","横行霸道","为所欲为"],"opposite":["慈眉善目"],"usage":"作谓语、定语；形容为人凶恶残暴","story":["春秋时期，齐鲁交界的柳下村成为诸侯战争的兵源地，展跖为逃避兵役而组织人马攻占启阳城，而后又占领鄫城，队伍扩大到9000人，官僚贵族们闻风丧胆，把展跖视为眼中钉、肉中刺，污蔑他为盗跖，说他“日杀不辜，肝人之肉，暴戾恣雎”"]},{"id":25094,"word":"暴敛横征","pinyin":"bào liǎn héng zhēng","abbr":"blhz","explanation":"指强征捐税，搜刮人民财富。","source":{"text":"一经我设立领事，彼不免喧宾夺主之嫌，以碍其暴敛横征之举，所以始必坚拒，继则宕延。","book":"清·薛福成《通筹南洋各岛添设领事官保护华民疏》"},"example":{"text":"甚至一地两科，以重税病民。～，于斯可验。","book":"朱小璋《安微讨满洲檄》"},"similar":["横征暴敛"],"opposite":["轻徭薄赋"],"usage":"作谓语、定语、宾语；指残酷剥削"},{"id":25095,"word":"暴殄天物","pinyin":"bào tiǎn tiān wù","abbr":"bttw","explanation":"暴：损害，糟蹋；殄：灭绝；天物：指自然生物。原指残害灭绝天生万物。后指任意糟蹋东西，不知爱惜。","source":{"text":"今商王受无道，暴殄天物，害虐烝民。","book":"《尚书·武成》"},"example":{"text":"既有许多值钱有东西，任人作践了，也似乎～。","book":"清·曹雪芹《红楼梦》第五十六回"},"similar":["挥霍无度","挥金如土"],"opposite":["克勤克俭","精打细算","节衣缩食"],"usage":"作谓语、宾语；表示不爱惜财物，随意糟蹋"},{"id":25096,"word":"暴殒轻生","pinyin":"bào yǔn qīng shēng","abbr":"byqs","explanation":"暴：突然；殒：死亡；轻生：把生命看得很轻。指突然间自杀身死。","source":{"text":"大约我近年于家务疏懒，自然执事人操克夺之权，致使弄出这暴殒轻生的祸来。","book":"清·曹雪芹《红楼梦》第三十三回"},"usage":"作谓语、定语；指突然自杀"},{"id":25097,"word":"暴腮龙门","pinyin":"pù sāi lóng mén","abbr":"pslm","explanation":"象鱼仰望龙门而不得上一样。科举时代比喻应进士试不第，后也比喻生活遭遇挫折，处境窘迫。","source":{"text":"河津一名龙门，巨灵迹犹在，去长安九百里。江海大鱼洎集门下数千，不得上，上则为龙，故云暴腮龙门。","book":"《太平御览》卷四十引《辛氏三秦记》"},"example":{"text":"江海大鱼集门下，不得上；上即为龙。故云：‘～，垂耳辕下。’","book":"明·李贽《初潭集·师友六》"},"similar":["曝腮龙门"],"opposite":["飞黄腾达"],"usage":"作宾语、定语；指科举落榜"},{"id":25098,"word":"暴虎冯河","pinyin":"bào hǔ píng hé","abbr":"bhph","explanation":"暴虎：空手搏虎；冯河：涉水过河。比喻有勇无谋，鲁莽冒险。","source":{"text":"暴虎冯河，死而无悔者，吾不与也。","book":"《诗经·小雅·小旻》：“不敢暴虎，不敢冯河；人知其一，莫知其他。”《论语·述而》"},"example":{"text":"俺张孔目怎还肯缘木求鱼，鲁斋郎他可敢～？","book":"元·关汉卿《鲁斋郎》第四折"},"similar":["有勇无谋","贸然行事"],"opposite":["有勇有谋","谨言慎行","深谋远虑"],"usage":"作谓语、定语、分句；比喻有勇无谋","story":["春秋时期，孔子外出讲学，子路佩剑前往接近孔子。孔子想收他为徒，子路说自己像箭不用读书，孔子说读书可以让他有勇有谋。子路于是拜孔子为师，他问孔子统率三军时愿意与谁共事，孔子说不愿与那些空手打虎及徒步过河的有勇无谋的人共事"]},{"id":25099,"word":"暴虐无道","pinyin":"bào nüè wú dào","abbr":"bnwd","explanation":"残暴狠毒，丧尽道义。","source":{"text":"遂肆意酒色，暴虐无道，多所残害。","book":"《晋书·桓彝传》"},"example":{"text":"到九传厉王，～，为国人所杀。","book":"明·冯梦龙《东周列国志》第一回"},"similar":["荒淫无度","暴戾恣睢"],"usage":"作谓语、定语；形容人很残暴","story":["晋朝时期，朝廷内部争权夺利的战争日趋激烈，江州刺史桓玄起兵攻占建康以西的土地，桓玄的侄子桓振被任命为淮南太守，他横征暴敛，扩充军备。桓玄教育他要培养仁义之师。他在桓玄被杀后更加肆意酒色，暴虐无道，滥杀无辜"]},{"id":25100,"word":"暴衣露冠","pinyin":"pù yī lù guàn","abbr":"pylg","explanation":"日晒衣裳，露湿冠冕。形容奔波劳碌。暴，晒。","source":{"text":"今宗室子孙，曾无暴衣露冠之劳，裂地而王之，分财而赐之，父死子继，兄终弟及。","book":"《汉书·燕刺王刘旦传》"},"example":{"text":"足下甚苦，～，将兵助楚讨不义，足不何不自喜也？臣原以事见，而曰‘吾方以天下为事，未暇见儒人也’。","book":"《史记·郦生陆贾列传》"},"usage":"作宾语、定语；用于人生"},{"id":25101,"word":"暴衣露盖","pinyin":"pù yī lù gài","abbr":"pylg","explanation":"日晒衣裳，露湿车盖。形容奔波劳碌。暴，晒。","source":{"text":"鲍生谓丞相曰：‘王暴衣露盖，数使使劳苦君者，有疑君心也。’","book":"《史记·萧相国世家》"},"example":{"text":"陛下～，栉风沐雨，曾不顾惜此。","book":"明·杨慎《丁丑封事》"},"usage":"作谓语；用于奔波"},{"id":25102,"word":"暴跳如雷","pinyin":"bào tiào rú léi","abbr":"btrl","explanation":"暴：暴烈，急躁。急怒叫跳，象打雷一样猛烈。形容又急又怒，大发脾气的样子。","source":{"text":"我有亲父兄，性行暴如雷。","book":"《古诗为焦仲卿妻作》"},"example":{"text":"他哥哥知道了，气得～。叫了他去骂。","book":"清·吴趼人《二十年目睹之怪现状》第二十三回"},"similar":["大发雷霆","火冒三丈","气急败坏"],"opposite":["心平气和","奴不变容","和颜悦色"],"usage":"作谓语、状语、定语；形容人盛怒时的样子","story":["刘兰芝嫁给焦仲卿为妻，她在焦家任劳任怨，可刁怪的婆婆容不下她，硬要休她回家。焦仲卿只好与她约定男不再娶、女不再嫁，彼此从一而终。刘兰芝回家后，性情暴如雷的长兄逼她再嫁。她只有投水自尽，焦仲卿得知后也自缢身亡"]},{"id":25103,"word":"暴躁如雷","pinyin":"bào zào rú léi","abbr":"bzrl","explanation":"暴：暴烈，急躁。急怒叫跳，象打雷一样猛烈。形容又急又怒，大发脾气的样子。","source":{"text":"我有亲父兄，性行暴如雷。","book":"《古诗为焦仲卿妻作》"},"example":{"text":"严贡生越发恼得～。","book":"清·吴敬梓《儒林外史》第六回"},"similar":["暴跳如雷"],"usage":"作谓语、定语、状语；指人的情绪"},{"id":25104,"word":"暴露无遗","pinyin":"bào lù wú yí","abbr":"blwy","explanation":"暴露：显露，显现；遗：遗漏。全都暴露出来。","source":{"text":"只要在这里发现敌人主力，那敌人一切诡计就暴露无遗。","book":"杜鹏程《保卫延安》第二章"},"example":{"text":"蒋介石政府的卖国外交政策～。"},"similar":["图穷匕见","原形毕露","水落石出"],"opposite":["滴水不漏","秘而不宣","深藏若虚"],"usage":"作谓语；形容坏人坏事或社会的黑暗显露出来"},{"id":25105,"word":"暴风疾雨","pinyin":"bào fēng jí yǔ","abbr":"bfjy","explanation":"指来势急遽而猛烈的风雨。","source":{"text":"[同治]三年六月初十日，定海暴风疾雨，坏各埠船，溺死兵民无数。","book":"《清史稿·灾异志三》"},"example":{"text":"小小的燕子，浩莽的大海，飞着飞着，不会觉得倦么？不会遇着～么？我们真替它们担心呢！","book":"郑振铎《海燕》"},"similar":["暴风骤雨"],"opposite":["和风细雨"],"usage":"作主语、宾语；形容雨很大"},{"id":25106,"word":"暴风骤雨","pinyin":"bào fēng zhòu yǔ","abbr":"bfzy","explanation":"暴、骤：急速，突然。又猛又急的大风雨。比喻声势浩大，发展急速而猛烈。","source":{"text":"故飘风不终朝，骤雨不终日。","book":"《老子》第二十三章"},"example":{"text":"有雌雄二鸟，原在一处同飞，忽被～惊散。","book":"明·吴承恩《西游记》第六十九回"},"similar":["狂风暴雨","急风暴雨"],"opposite":["和风细雨","东风化雨"],"usage":"作主语、宾语；形容迅疾而猛烈的风雨"},{"id":25107,"word":"暴饮暴食","pinyin":"bào yǐn bào shí","abbr":"bybs","explanation":"又猛又急地大量吃喝，使身体失调。","source":{"text":"长得单薄这可不是一朝一夕能改变的，即使从现在起就牛肉牛奶地暴饮暴食，换出一身牛力气也得寒暑几载。","book":"王朔《我是你爸爸》"},"example":{"text":"～对人身体不利。"},"similar":["大吃大喝"],"usage":"作主语、宾语、定语；指不注意饮食卫生"},{"id":25108,"word":"曙后孤星","pinyin":"shǔ hòu gū xīng","abbr":"shgx","explanation":"旧称仅遗孤女。同“曙后星孤”。","source":{"text":"十三妹者，盖曙后孤星。","book":"《儿女英雄传》第三九回"},"similar":["曙后星孤"],"usage":"作宾语、定语；指遗孤女"},{"id":25109,"word":"曙后星孤","pinyin":"shǔ hòu xīng gū","abbr":"shxg","explanation":"曙：破晓时光。旧称仅遗孤女。","source":{"text":"崔曙进士作《明堂火珠诗试帖》曰：‘夜来双月满，曙后一星孤。’当时以为警句。及来年，曙卒，唯一女名星星。人始悟其自谶也。","book":"唐·孟棨《本事计·征咎》"},"example":{"text":"～，留得传家一砚无？","book":"清·朱祖谋《减字木兰花·八哀》词"},"similar":["曙后孤星"],"usage":"作宾语、定语；指遗孤女","story":["唐朝时期，崔曙进士作《明堂火珠》诗：“夜来双月满，曙后一星孤。”当时被人认为是警句，广为传诵。及到第二年，他因病去世，留下唯一的女儿星星孤单生活，人们这才明白他是在感慨自己的身后事"]},{"id":25110,"word":"曝书见竹","pinyin":"pù shū jiàn zhú","abbr":"psjz","explanation":"指睹物思人。","source":{"text":"网搜佣钞，敦复力最勤，未卒事病亡，每一展卷，不胜曝书见竹之感。","book":"清·浦起龙《序》"},"similar":["睹物思人"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":25111,"word":"曝背食芹","pinyin":"pù bèi shí qín","abbr":"pbsq","explanation":"谦言微薄之献。","source":{"text":"乡豪取而尝之，蜇于口，惨于腹。","book":"战国·郑·列御寇《列子·杨朱》：“负日之暄，人莫知者，以献吾君，将有重赏。”又《列子·杨朱》"},"example":{"text":"臣力耕朽壤，勤凿枯泉，空有胼手胼足之劳，曾无～之献。","book":"宋·叶适《谢除宝谟阁直学士提举凤翔府上清太平宫表》"},"usage":"作宾语、定语；用于微薄的贡献"},{"id":25112,"word":"曝腮之鱼","pinyin":"pù sāi zhī yú","abbr":"pszy","explanation":"晒着腮的鱼。比喻处在困顿的境遇之中。","source":{"text":"且曝腮之鳞，不念杯杓之水，云霄之翼，岂顾笼樊之粮。","book":"《梁书·何敬容传》"}},{"id":25113,"word":"曝腮龙门","pinyin":"pù sāi lóng mén","abbr":"pslm","explanation":"曝：晒；龙门：河津。鲤鱼在龙门下晒它的两腮。比喻科举落榜。","source":{"text":"江海大鱼洎集门下数千，不得上，上则为龙。故云曝腮龙门。","book":"《辛氏三秦记》"},"similar":["名落孙山"],"opposite":["鲤鱼跳龙门"],"usage":"作宾语、定语；指科举落榜"},{"id":25114,"word":"曝骨履肠","pinyin":"pù gǔ lǚ cháng","abbr":"pglc","explanation":"暴露尸骨，踩踏肠子。极言所酿战祸之惨烈。","source":{"text":"佐斗嫁祸，纷若猬毛，曝骨履肠，间不容砺。","book":"《隋书·李德林传》"},"usage":"作宾语、定语；用于书面语"},{"id":25115,"word":"曲不离口","pinyin":"qǔ bù lí kǒu","abbr":"qblk","explanation":"意指曲子要天天唱，才会熟练精妙。比喻熟能生巧。","source":{"text":"但是诵读总得多读熟读，才有效用；‘曲不离口’，诵读也是一样道理。","book":"朱自清《论诵读》"},"similar":["拳不离手"],"usage":"作宾语、定语；常与“拳不离手”连用"},{"id":25116,"word":"曲为之防","pinyin":"qū wéi zhī fáng","abbr":"qwzf","explanation":"形容周密而详审的防备。","source":{"text":"周监于二代，礼文尤具，事为之制，曲为之防，故称礼经三百，威仪三千。","book":"《汉书·礼乐志》"},"example":{"text":"今将创设议院，若不严定规则，事为之制，～，流弊不可胜言。","book":"《清史稿·选举志》"}},{"id":25117,"word":"曲学多辨","pinyin":"qū xué duō biàn","abbr":"qxdb","explanation":"曲学：知识不广泛且头脑顽固的人；辨：通“辩”，争论。比喻学识浅薄的人喜欢毫无意义的争辩。","source":{"text":"远近之服，贤圣不能同。穷乡多异，曲学多辨。","book":"《战国策·赵策二》"},"example":{"text":"孝公曰：“善，吾闻穷巷多诐，～。”","book":"南朝·宋·范晔《商君书·更法》"}},{"id":25118,"word":"曲学诐行","pinyin":"qū xué bì xíng","abbr":"qxbx","explanation":"曲：弯曲不直；诐：斜歪不正。做学问不入正道，行为奸邪不正派。","source":{"text":"古之所谓曲学诐行者，不必少、淫邪放僻，显显狼狈，如流俗人不肖子者也。","book":"宋·陆九渊《与张辅之书》"},"usage":"作宾语、定语；用于为人"},{"id":25119,"word":"曲学阿世","pinyin":"qū xué ē shì","abbr":"qxas","explanation":"曲：弯曲不直；阿：迎合。指学些邪门歪道的东西，以迎合时尚。","source":{"text":"务正学以言，无曲学以阿世。","book":"《史记·儒林列传》"},"example":{"text":"南京礼部尚书黄绾～，虚谈肱人。","book":"《明史·陆粲传》"},"usage":"作谓语、宾语、定语；用于做学问"},{"id":25120,"word":"曲尽人情","pinyin":"qū jìn rén qíng","abbr":"qjrq","explanation":"委婉周到地把人之常情或世态充分体现出来。","source":{"text":"爱君难得似当时，曲尽人情莫若诗。","book":"宋·邹雍《观诗吟》"},"example":{"text":"前往松江打一条五彩大绒单，铺在他楼上，实为～。","book":"明·无名氏《鸣凤记·严嵩庆寿》"},"usage":"作谓语、定语；用于文章等"},{"id":25121,"word":"曲尽其妙","pinyin":"qū jìn qí miào","abbr":"qjqm","explanation":"曲：委婉，细致；尽：全部表达。把其中微妙之处委婉细致地充分表达出来。形容表达能力很强。","source":{"text":"故作《文赋》以述先士之盛藻，因论作文之利害所由，他日殆可谓曲尽其妙。","book":"晋·陆机《文赋序》"},"example":{"text":"无何，～，虽长安无有伦此。","book":"唐·白行简《李娃传》"},"similar":["出神入化","跃然纸上"],"opposite":["直来直去"],"usage":"作谓语、状语；形容表达能力强","story":["西晋文学家陆机一生写过许多诗，但大多数是内容空虚，感情贫乏，过分追求文字技巧。不过他的《文赋》是古代重要的文学论文，他在《文赋序》中讲希望把前辈才士丰茂华美的文章集中起来讨论，可以把事物的妙处全部生动细致地表现出"]},{"id":25122,"word":"曲尽其巧","pinyin":"qū jìn qí qiǎo","abbr":"qjqq","explanation":"曲：委婉细致。曲折而委婉地将其中的奥妙之处充分表达出来。","source":{"text":"昔祖宗之朝，崇尚辞律，则诗赋之工，曲尽其巧。","book":"宋·苏轼《拟进士对御试策引状》"},"similar":["曲尽其妙"],"usage":"作谓语、状语；形容表达能力强"},{"id":25123,"word":"曲尽其态","pinyin":"qū jìn qí tài","abbr":"qjqt","explanation":"曲：委婉细致。曲折委婉地充分表达其姿态。形容表达技巧非常高明。","source":{"text":"画之为用大矣，盈天地间者万物，悉皆含豪运思，曲尽其态。","book":"明·陶宗仪《辍耕录·叙画》"},"usage":"作谓语、定语；用于文章或绘画"},{"id":25124,"word":"曲尽奇妙","pinyin":"qǔ jìn qí miào","abbr":"qjqm","explanation":"形容表达的技巧很高明。","example":{"text":"这篇小说写一个青年的心理变化，真可算是～。"}},{"id":25125,"word":"曲尽情伪","pinyin":"qū jìn qíng wěi","abbr":"qjqw","explanation":"曲：细致；情伪：真假。比喻细致地搞清楚事情的真假。","source":{"text":"欲知治狱之士，，是视其曲尽情伪，无所冤抑，斯为善治狱矣。","book":"《资治通鉴·魏纪·明景帝初元年》"}},{"id":25126,"word":"曲径通幽","pinyin":"qū jìng tōng yōu","abbr":"qjty","explanation":"曲：弯曲；径：小路；幽：指深远僻静之处。弯曲的小路，通到幽深僻静的地方。","source":{"text":"曲径通幽处，禅房花木深。","book":"唐·常建《题破册寺后禅院》诗"},"example":{"text":"～处，园林无俗情。","book":"清·俞樾《曲园楹联》"},"similar":["幽静山谷"],"opposite":["繁华闹市"],"usage":"作定语、分句；用于园林建筑","story":["唐朝诗人常建作的《题破山寺后禅院》：“曲径通幽处，禅房花木深。”虽然写禅房僧境但道出一个曲折前进的哲理，是客观辩证法的体现。禅房坐落在深山花木丛中，通往禅房僧院的道路是起伏不平、曲曲折折，经过艰苦跋涉才能到达"]},{"id":25127,"word":"曲意奉迎","pinyin":"qǔ yì fèng yíng","abbr":"qyfy","explanation":"想方设法奉承讨好别人。同“曲意逢迎”。","source":{"text":"虽曲意奉迎，动辄得咎，人咸不平。","book":"清·采蘅子《虫鸣漫录》"},"similar":["曲意承迎","曲意迎合"],"usage":"作谓语、定语；指违心讨好人"},{"id":25128,"word":"曲意承奉","pinyin":"qū yì chéng fèng","abbr":"qycf","explanation":"曲意：违心。违背自己的心意去奉承讨好别人。","source":{"text":"明宗不豫，秦王讽义诚为助，义诚曲意承奉，亦非真诚。及朱宏昭、冯赟等惧祸，谋于义诚。","book":"《旧五代史·康义诚传》"},"example":{"text":"徐武公、李文达当国，～，徐则以为狂生，李见其有大志，且通文墨，亦重之也。","book":"明·郎瑛《七修类稿》卷三十九"},"similar":["曲意逢迎","曲意承迎"],"usage":"作谓语、定语；指违心讨好人"},{"id":25129,"word":"曲意承迎","pinyin":"qǔ yì chéng yíng","abbr":"qycy","explanation":"想方设法奉承讨好别人。同“曲意逢迎”。","source":{"text":"生曲意承迎，笑问所来。","book":"清·蒲松龄《聊斋志异·黄九郎》"},"similar":["曲意逢迎","曲意奉迎"],"usage":"作谓语、定语；指违心讨好人"},{"id":25130,"word":"曲意迎合","pinyin":"qǔ yì yíng hé","abbr":"qyyh","explanation":"想方设法奉承讨好别人。同“曲意逢迎”。","source":{"text":"又有一等巧于钻营，专工窥探上司之性情嗜好，曲意迎合。","book":"清·郑观应《盛世危言·吏治》"},"example":{"text":"有些人，一味窥测自己的心理，～，却阴怀二心，特别地可恶！","book":"徐懋庸《鸡肋》"},"similar":["曲意奉迎","曲意逢迎","曲意承奉"],"usage":"作谓语、定语；指违心讨好人"},{"id":25131,"word":"曲意逢迎","pinyin":"qū yì féng yíng","abbr":"qyfy","explanation":"曲意：违心。违背自己的心意去奉承讨好别人","source":{"text":"如用兵之茉，不惟不能沮止，乃从而附合，曲意逢迎，贻害生民，恬不知恤。","book":"宋·叶绍翁《四朝见闻录》"},"example":{"text":"郑振铎《桂公塘》：“天祥暗地里着急非凡，只好虚与敷衍，～。”"},"similar":["低三下四","趋炎附势","曲意奉迎"],"opposite":["刚正不阿","直言不讳"],"usage":"作谓语、定语；指违心讨好人"},{"id":25132,"word":"曲曲弯弯","pinyin":"qū qū wān wān","abbr":"qqww","explanation":"形容很多曲弯之处。","source":{"text":"曲曲弯弯，越过前面山头，四处一看，果是无穷美景，一望无际。","book":"清·李汝珍《镜花缘》第八回"},"example":{"text":"小河～流向远方。"},"similar":["弯弯曲曲","曲曲折折"],"usage":"作谓语、定语、状语；指十分弯曲"},{"id":25133,"word":"曲曲折折","pinyin":"qū qū zhé zhé","abbr":"qqzs","explanation":"形容弯曲。也形容事情进行得不顺利，有阻碍或受到挫折。","source":{"text":"沿着荷塘，是一条曲曲折折的小煤屑路。","book":"朱自清《荷塘月色》"},"example":{"text":"即所谓《对张杨的训词》，内容含含糊糊，～，实为中国政治文献中一篇有趣的文章。","book":"毛泽东《关于蒋介石声明的声明》"},"similar":["弯弯曲曲"],"opposite":["一帆风顺"],"usage":"作定语、状语；指不直"},{"id":25134,"word":"曲水流觞","pinyin":"qū shuǐ liú shāng","abbr":"qsls","explanation":"古民俗，每年农历三月在弯曲的水流旁设酒杯，流到谁面前，谁就取下来喝，可以除去不吉利。","example":{"text":"～的习俗现在难以见到了。"},"usage":"作宾语、定语；指风俗习惯之一"},{"id":25135,"word":"曲眉丰颊","pinyin":"qǔ méi fēng jiá","abbr":"qmfj","explanation":"曲：弯曲。丰：丰满。弯弯的眉毛，丰润的脸颊。形容相貌美丽富态。","source":{"text":"曲眉丰颊，清声而便体。","book":"唐·韩愈《送李归盘谷序》"},"usage":"作谓语、定语；用于人的外表"},{"id":25136,"word":"曲突徙薪","pinyin":"qū tū xǐ xīn","abbr":"qtxx","explanation":"曲：弯；突：烟囱；徒：迁移；薪：柴草。把烟囱改建成弯的，把灶旁的柴草搬走。比喻事先采取措施，才能防止灾祸。","source":{"text":"臣闻客有过主人者，见其灶直突，傍有积薪。客谓主人，更为曲突，远徙其薪，不者且有火患，主人嘿然不应。俄而家果失火，邻里共救之，幸而得息。","book":"《汉书·霍光传》"},"example":{"text":"～广恩泽，愿亟靖海安天骄。","book":"清·黄遵宪《福州大水行同张樵野丈龚蔼人丈作》"},"similar":["防患未然","枉突徙薪","徙薪曲突"],"opposite":["临渴掘井"],"usage":"作谓语、定语；用于事先预防","story":["从前有个人去拜访他的朋友，看见朋友家的烟囱竖在灶前，灶前还堆着不少干柴，就建议主人把烟囱改成弯曲的，把干柴移开。主人没有采纳。不久真的发生火灾，幸亏邻居及时救火。主人杀牛来谢这些邻居，邻居说该请的是那位提意见的人"]},{"id":25137,"word":"曲突移薪","pinyin":"qǔ tū yí xīn","abbr":"qtyx","explanation":"比喻事先采取措施，才能防止灾祸。同“曲突徙薪”。","source":{"text":"曲突移薪计未忠，焦头烂额敢居功。","book":"清·李渔《玉搔头·媲美》"},"similar":["曲突徙薪"],"usage":"作谓语、定语；用于事先预防"},{"id":25138,"word":"曲终奏雅","pinyin":"qǔ zhōng zòu yǎ","abbr":"qzzy","explanation":"乐曲到终结处奏出了典雅纯正的乐音。后比喻文章或艺术表演在结尾处特别精采。也比喻结局很好。","source":{"text":"扬雄以为靡丽之赋，劝百而风一，犹骋郑卫之声，曲终而奏雅，不已戏乎？","book":"《汉书·司马相如传赞》"},"example":{"text":"这真是“～”，令人如释重负，觉得天皇毕竟圣明，好人也终于得救。","book":"鲁迅《且介亭杂文·病后杂谈》"},"usage":"作宾语、宾语；用于文章或乐曲"},{"id":25139,"word":"曲肱而枕","pinyin":"qǔ gōng ér zhěn","abbr":"qgez","explanation":"肱：胳膊由肘到肩的部分，泛指胳膊。枕：枕着。枕着弯曲的胳膊睡。形容人生活恬淡，无忧无虑。","source":{"text":"饭疏食饮水，曲肱而枕之，乐亦在其中矣。","book":"《论语·述而》"},"example":{"text":"归来饭饱黄昏后，～，鼓腹而游。","book":"明·冯惟敏《中吕粉蝶儿·五岳游褒杂咏》"}},{"id":25140,"word":"曲里拐弯","pinyin":"qū lǐ guǎn wān","abbr":"qlgw","explanation":"形容弯曲多。","source":{"text":"但这族人中，也不乏几条汉子，不服气田福堂，常常曲里拐弯地向他挑战。","book":"路遥《平凡的世界》第一卷第八章"},"example":{"text":"但这族人中，也不乏几条汉子，不服气田福堂，常常～地向他挑战。","book":"路遥《平凡的世界》第一部第八章"},"usage":"作定语、状语；用于口语"},{"id":25141,"word":"曲高和寡","pinyin":"qǔ gāo hè guǎ","abbr":"qghg","explanation":"曲调高深，能跟着唱的人就少。旧指知音难得。现比喻言论或作品不通俗，能了解的人很少。","source":{"text":"引商刻羽，杂以流徵，国中属而和者，不过数人而已。是其曲弥高，其和弥寡。","book":"战国楚·宋玉《对楚王问》"},"example":{"text":"我在省城，只听人称赞靓云，从没有人说起逸云，可知道～呢！","book":"清·刘鹗《老残游记·续篇》第五回"},"similar":["阳春白雪"],"opposite":["下里巴人"],"usage":"作谓语、定语、分句；含讽刺意味","story":["战国时期，楚襄王问文学家宋玉为什么那么多人对宋玉有意见，怎么没有附和的人？宋玉回答道：有一个唱歌的人在郢都街上唱《下里》《巴人》，很多人跟唱，唱《阳春》《白雪》，附和的人就少了，可见“其曲弥高，其和弥寡。”"]},{"id":25142,"word":"曳兵之计","pinyin":"yè bīng zhī jì","abbr":"ybzj","explanation":"指佯败而逃，把敌人引入埋伏圈。","source":{"text":"伯英进兵甚猛，谨防中敌曳兵之计。","book":"郭希仁《从戎纪略》"},"usage":"作宾语；用于书面语"},{"id":25143,"word":"曳兵弃甲","pinyin":"yè bīng qì jiǎ","abbr":"ybqj","explanation":"拖着兵器，丢掉铠甲。形容打败仗逃跑时的狼狈相。","source":{"text":"丘貉古今同一概，曳兵弃甲暗投降。","book":"陈毅《过汾河平原》诗"},"similar":["丢盔弃甲"],"usage":"作谓语、定语、宾语、状语；用于战败"},{"id":25144,"word":"曳尾泥涂","pinyin":"yè wěi ní tú","abbr":"ywnt","explanation":"①比喻在污浊的环境里苟且偷生。同“曳尾涂中”。②比喻卑鄙龌龊的行为。","source":{"text":"叶伯芬的曳尾泥涂，大都如此，这回事情，不过略表一二。","book":"清·吴趼人《二十年目睹之怪现状》第九十一回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第91回：“叶伯芬的～，大都如此，这回事情，不过略表一二。”"},"similar":["曳尾涂中"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":25145,"word":"曳尾涂中","pinyin":"yè wěi tú zhōng","abbr":"ywtz","explanation":"原意是与其位列卿相，受爵禄、刑罚的管束，不如隐居而安于贫贱。后也比喻在污浊的环境里苟且偷生。","source":{"text":"宁其生而曳尾于涂中乎？","book":"战国·宋·庄周《庄子·秋水》"},"example":{"text":"欲返江东无面目，～当死。","book":"郁达夫《毁家诗纪·词》"},"similar":["苟且偷生"],"usage":"作谓语、定语；用于书面语","story":["战国时期著名的思想家庄子很有才学，楚威王想请他来辅佐朝政，派两个使者带上许多珍珠玉帛，在濮水岸边见到隐居在此钓鱼的庄子，庄子对使者打比方说他愿意像保全性命曳尾涂中的乌龟，过着隐居生活。使者只好悻悻而去"]},{"id":25146,"word":"曳居侯门","pinyin":"yè jū hóu mén","abbr":"yjhm","explanation":"曳：拉；裾：衣服的大襟。比喻在权贵的门下做食客。","source":{"text":"饰固陋之心，则何王之门不可曳长裾乎？","book":"汉·邹阳《上吴王书》"}},{"id":25147,"word":"曳裾王门","pinyin":"yè jū wáng mén","abbr":"yjwm","explanation":"曳：拉；裾：衣服的大襟。比喻在权贵的门下做食客。","source":{"text":"饰固陋之心，则何王之门不可曳长裾乎？","book":"汉·邹阳《上吴王书》"},"example":{"text":"弹剑作歌奏苦声，～不称请。","book":"唐·李白《行路难》诗"},"usage":"作谓语；比喻在权贵的门下做食客"},{"id":25148,"word":"更上一层楼","pinyin":"gèng shàng yī céng lóu","abbr":"gsycl","explanation":"原意是要想看得更远，就要登得更高。后比喻使已取得的成绩再提高一步。","source":{"text":"欲穷千里目，更上一层楼。","book":"唐·王之涣《登鹳雀楼》诗"},"example":{"text":"既道尼山出世，又召东山入梦，镜里是真木。炯炯明看汝，～。","book":"清·王夫之《水调歌头·放言》词"},"similar":["更进一竿"],"opposite":["江河日下"],"usage":"作宾语、分句；用于祝福语","story":["唐朝著名诗人王之涣，他性格豪放，擅长做诗，经常与王昌龄、高适等在一块切磋诗技。王之涣被免职后，游遍黄河南北，他到薄州登鹳鹤楼，作诗一首：“白日依山尽，黄河入海流；欲穷千里目，更上一层楼。”"]},{"id":25149,"word":"更仆未罄","pinyin":"gēng pú wèi qìng","abbr":"gpwq","explanation":"换了几班侍者，谈话仍没有结束。","source":{"text":"此真是非邪正，深言之即更仆未罄。","book":"明·徐光启《刻紫阳朱子全集序》"}},{"id":25150,"word":"更仆难尽","pinyin":"gèng pú nán jìn","abbr":"gpnj","explanation":"形容人或事物很多，数也数不过来。同“更仆难数”。","source":{"text":"如奈端因苹实坠地而悟吸力之理；瓦特因沸水蒸腾而悟汽机之理；如此类者，更仆难尽。","book":"梁启超《近世文明初祖二大家之学说》上篇"},"similar":["更仆难数","更难仆数","更仆难终"],"usage":"作谓语、定语；形容人或事物很多"},{"id":25151,"word":"更仆难数","pinyin":"gēng pú nán shǔ","abbr":"gpns","explanation":"原意是儒行很多，一下子说不完，一件一件说就需要很长时间，即使中间换了人也未必能说完。后形容人或事物很多，数也数不过来。","source":{"text":"遽数之不能终其物，悉数之乃留，更仆未可终也。","book":"《礼记·儒行》"},"example":{"text":"四五里，直抵五峰南，则乱峰尖叠，什伯为伍，横变侧移，殆～。","book":"明·徐宏祖《徐霞客游记·粤西游日记》"},"similar":["数不胜数"],"usage":"作谓语、定语；形容人或事物很多"},{"id":25152,"word":"更仆难终","pinyin":"gēng pú nán zhōng","abbr":"gpnz","explanation":"终：终结，完了。换了几班侍者，谈话仍没有结束。","source":{"text":"此真是非邪正，深言之即更仆未罄。","book":"明·徐光启《刻紫阳朱子全集序》"},"example":{"text":"到任以来，讲求访问，因知堆料积弊，～。","book":"清·林则徐《查验豫东各厅垛完竣折》"},"similar":["更仆难尽","更仆难数","更难仆数"],"usage":"作谓语、定语；形容人或事物很多"},{"id":25153,"word":"更令明号","pinyin":"gēng lìng míng hào","abbr":"glmh","explanation":"重新申明号令。说明贤明君主应当取信于民。","source":{"text":"居数月，有警，击鼓而民不赴。乃更令明号而民信之。","book":"《韩非子·外储说左上》"},"usage":"作谓语、宾语；指贤明君主应当取信于民"},{"id":25154,"word":"更名改姓","pinyin":"gèng míng gǎi xìng","abbr":"gmgx","explanation":"改换了原来的姓名。同“变名易姓”。","source":{"text":"诈传着阿妈将令，着存孝更名改姓，调唆的父亲生嗔，要了头也是干净。","book":"元·关汉卿《哭存孝》第二折"},"example":{"text":"清·荻岸山人《平山冷燕》第18回：“圣上说学臣荐举，朝廷钦召，都违悖不赴，却～，潜匿京师，调引钦赐才女，这个罪名便大了。”"},"similar":["改姓更名","改名换姓","更姓改名"],"usage":"作谓语、定语；指改换了原来的姓名"},{"id":25155,"word":"更唱叠和","pinyin":"gēng chàng dié hé","abbr":"gcdh","explanation":"指相互以诗词酬答。同“更唱迭和②”。","source":{"text":"吾昔在中州文物府中更唱叠和者，为何如耶？","book":"明·宋濂《寄和右丞温迪罕诗卷序》"},"similar":["更唱叠和"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":25156,"word":"更唱迭和","pinyin":"gēng chàng dié hé","abbr":"gcdh","explanation":"①彼此唱和。②指相互以诗词酬答。③指互相呼应配合。","source":{"text":"太史之女曰蕴玉者，自号生香居士，亦能诗，与在山更唱迭和。","book":"战国·楚·宋玉《高唐赋》：“当年邀游，更唱迭和，赴曲随流。”清·钱泳《履园丛话·园林·逸园》"},"example":{"text":"陛下听其所说，更访于近臣，私相计会，～，蔽惑聪明。","book":"《旧唐书·裴度传》"},"similar":["更唱叠和"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":25157,"word":"更姓改名","pinyin":"gēng xìng gǎi míng","abbr":"gxgm","explanation":"更：改变。指改换原来的姓名。","source":{"text":"自此更姓改名，削发披淄去了。","book":"清·吴敬梓《儒林外史》第八回"},"similar":["改名换姓","更名改姓"],"usage":"作谓语、定语、宾语；指改换了原来的姓名"},{"id":25158,"word":"更姓改物","pinyin":"gēng xìng gǎi wù","abbr":"gxgw","explanation":"指王朝更迭，改正朔，易服色。","source":{"text":"更姓，易姓也。改物，改正朔、易服色也。","book":"《国语·周语中》：“叔父若能光裕大德，更姓改物，以创制天下，自显庸也。”韦昭注"},"example":{"text":"曹操阶祸，窃执天衡，残剥海内，怀无君之心。子丕孤竖，敢寻乱阶，盗据神器，～，世济其凶。","book":"三国·蜀·刘禅《出军诏》"},"similar":["改朝换代","改步改玉"],"usage":"作宾语、定语；指政权更替"},{"id":25159,"word":"更弦改辙","pinyin":"gēng xián gǎi zhé","abbr":"gxgz","explanation":"比喻改变方法或态度。同“更弦易辙”。","source":{"text":"揆于大义，必讨无赦。如或更弦改辙，择日臤亲贤命而立之，庶几可赎前罪。","book":"明·宋濂《谕安南国诏》"},"similar":["更弦易辙"],"usage":"作谓语、宾语、定语；用于处事"},{"id":25160,"word":"更弦易辙","pinyin":"gēng xián yì zhé","abbr":"gxyz","explanation":"比喻改变方法或态度。","source":{"text":"今春秋已盛，更弦易辙，此其时也。","book":"《明史·潘埙传》"},"example":{"text":"要以学力为浅深，其大旨罔有不同，固无俟于～也。","book":"清·黄宗羲《〈明文案〉序下》"},"similar":["更弦改辙"],"usage":"作谓语、宾语、定语；用于处事"},{"id":25161,"word":"更待何时","pinyin":"gèng dà hé shí","abbr":"gdhs","explanation":"更：再，复。指不必再等待，已到了该说该做的时候。","source":{"text":"我将手向伊面前横两横，到这里却去不得，似这般瞎汉不打更待何时？","book":"宋·释普济《五灯会元·临济玄禅师法嗣》"},"example":{"text":"此时不乐，～？"},"usage":"作谓语；指不必等待"},{"id":25162,"word":"更待干罢","pinyin":"gèng dài gàn bà","abbr":"gdgb","explanation":"意指怎肯干休。"},{"id":25163,"word":"更新换代","pinyin":"gēng xīn huàn dài","abbr":"gxhd","explanation":"以新换旧。","source":{"text":"不管我们受到多名大的损失，不管如何更新换代，我们这个军队永远是党领导下的军队。","book":"邓小平《在接见首都戒严部队军以上干部时的讲话》"},"example":{"text":"现在科学技术～很快。"},"usage":"作谓语、宾语；指变化快"},{"id":25164,"word":"更无长物","pinyin":"gèng wú cháng wù","abbr":"gwcw","explanation":"长物：多余的东西。除一身之外再没有多余的东西。原指生活俭朴。现形容贫穷。","source":{"text":"丈人不悉恭，恭作人无长物。","book":"南朝·宋·刘义庆《世说新语·德行》"},"similar":["别无长物"],"usage":"作谓语、定语；形容贫困"},{"id":25165,"word":"更深人静","pinyin":"gēng shēn rén jìng","abbr":"gsrj","explanation":"深夜没有人声，非常寂静。","source":{"text":"师曰：‘更深人静，共伊商量。’","book":"宋·释道原《景德传灯录》卷十一"},"example":{"text":"这个时候已经～，况且衙门里头的门户都是一重一重关闭得十分严紧，料想他生了翅膀也飞不出去。","book":"清·张春帆《宦海》第十四回"},"similar":["夜深人静"],"usage":"作谓语、定语；指深夜没有人声，非常寂静"},{"id":25166,"word":"更深夜静","pinyin":"gēng shēn yè jìng","abbr":"gsyj","explanation":"更：旧时夜间计时单位。一夜分五更，每更约两个小时。夜已很深，没有一点声响。形容夜深处于一片寂静之中。","source":{"text":"山高地阔兮，见汝无期；更深夜阑兮，梦汝来斯。","book":"汉·蔡琰《胡笳十八拍·第十四拍》"},"example":{"text":"～，共伊商量。”（宋·释道原《景德传灯录》卷十一","book":"师有时蓦唤侍者，侍者应诺，师曰"},"similar":["更深人静","更深夜阑"],"usage":"作状语；指深夜寂静"},{"id":25167,"word":"更若役","pinyin":"geng ruo yu","abbr":"gry","explanation":"更换你的差使."},{"id":25168,"word":"更进一竿","pinyin":"gèng jìn yī gān","abbr":"gjyg","explanation":"更：再，又；竿：竹竿。又前进了一步。","source":{"text":"师示一偈曰：‘百丈竿头不动人，虽然得入未为真，百尺竿头须进步，十方世界是全身。’","book":"宋·释道原《景德传灯录》卷十"},"example":{"text":"后人见了这本传奇，亦曾题过四句谒语，为作者缘起之言～。","book":"清·曹雪芹《红楼梦》第一二○回"},"similar":["更上一层楼"],"usage":"作谓语；用于学问、事业等","story":["宋朝时期长沙高僧景岑佛学造诣高深，时常到各地去传道讲经，他讲得深入浅出，娓娓动听，听众与他谈论有关佛教的最高境界。他拿出偈帖给大家念道：“百丈竿头不动人，虽然得人未为真。百丈竿头须进步，十方世界是全身。”"]},{"id":25169,"word":"更长梦短","pinyin":"gēng cháng mèng duǎn","abbr":"gcmd","explanation":"更：旧时夜间计时单位，一夜分五更，每更约两个小时；更长：指漫漫长夜；梦短：指睡眠不踏实，极易醒。形容思绪烦乱，很难入眠。","source":{"text":"可怜正凄凉正眠，冷清清把纱窗半掩，更长梦短使人愁闷添。","book":"明·胡文焕《群音类选〈清腔类·步步娇〉》"},"usage":"作宾语、分句；形容思绪烦乱"},{"id":25170,"word":"更长漏永","pinyin":"gēng cháng lòu yǒng","abbr":"gzly","explanation":"漏：漏壶，古代的计时工具。形容漫漫的长夜。","source":{"text":"我为你呵捱了些更长漏永，受了些衾寒枕冷，我巴到你黄昏盼到你明，思旧约，想归程，可着我久等。","book":"元·石子章《竹坞听琴》第三折"},"example":{"text":"一字字～，一声声衣宽带松。","book":"明·崔时佩《西厢记·琴心写恨》"},"usage":"作宾语、定语；指深夜"},{"id":25171,"word":"更阑人静","pinyin":"gēng lán rén jǐng","abbr":"glrj","explanation":"更：旧时夜间计时单位，一夜分五更，每更约两小时；阑：将尽；人静：没有人的吵杂声，一片寂静。夜已很深，没有人声，一片寂静。","source":{"text":"白日苍蝇满饭盘，夜间蚁子又成团；每到更深人静后，定来头人咬杨鸾。","book":"宋·蔡绦《西清诗话》引杨鸾诗"},"example":{"text":"听漏声沉，须提心自警，早又是～。","book":"清·玩花主人《缀白裘·雁瓴甲·盗甲》"},"similar":["夜深人静"],"usage":"作定语、状语；指深夜"},{"id":25172,"word":"更难仆数","pinyin":"gēng nán pú shù","abbr":"gnps","explanation":"形容人或事物很多，数也数不过来。同“更仆难数”。","source":{"text":"遽数之不能终其物，悉数之乃留，更仆未可终也。","book":"《礼记·儒行》"},"example":{"text":"婚姻之事……或无意中立成佳耦，或极稳处卒致落空，聚散变迁，～。","book":"清·孙郁《双鱼珮·巧佑》"},"similar":["更仆难尽","更仆难数","更仆难终"],"usage":"作谓语、定语；形容人或事物很多"},{"id":25173,"word":"曷克致此","pinyin":"hé kè zhì cǐ","abbr":"hkzc","explanation":"曷：文言疑问词，为什么；克：能够；致：达到。怎么能够弄到这种地步呢？"},{"id":25174,"word":"曹社之谋","pinyin":"cáo shè zhī móu","abbr":"cszm","explanation":"社：曹之国社。后指灭亡他人国家的阴谋。","source":{"text":"初，曹人或梦众君子立于社宫，而谋亡曹。","book":"《左传·哀公七年》"},"example":{"text":"鬼同～，人有秦庭之哭。","book":"北周·庚信《哀江南赋》"},"usage":"作宾语；指灭亡别国的阴谋"},{"id":25175,"word":"曼衍鱼龙","pinyin":"màn yǎn yú lóng","abbr":"myyl","explanation":"曼衍：亦作“漫衍”、“曼延”，巨兽名，古代仿照它排演百戏节目。鱼龙：古代百戏节目。古代演出的杂戏名。比喻事物的离奇变幻。亦作“鱼龙曼衍”。","source":{"text":"作巴俞都卢。海中砀极。漫衍鱼龙角抵之戏，以观视之。","book":"《汉书·西域传赞》"},"example":{"text":"绕金堤，～戏，簇娇春罗绮，喧天丝管。","book":"宋·柳永《破阵乐》"}},{"id":25176,"word":"曾不惨然","pinyin":"céng bù cǎn rán","abbr":"zbcr","explanation":"竟不觉得惨痛。","source":{"text":"古者以天下为主，君为客，凡君之所毕世而经营者，为天下也；今也以君为主，天下为客，凡天下之无地而得安宁者，为君也。是以其未得之也，屠毒天下之肝脑，离散天下之子女，以博我一人之产业，曾不惨然。","book":"清·黄宗羲《明夷待访录·原君》"}},{"id":25177,"word":"曾几何时","pinyin":"céng jǐ hé shí","abbr":"cjhs","explanation":"曾：曾经；几何：若干、多少。才有多少时候。指没过多久。","source":{"text":"补官扬州，公得谢归。曾几何时，讣者来门。","book":"宋·王安石《祭盛侍郎文》"},"example":{"text":"～，他自己去做了一个小小的官儿回来，而他又劝我去学法政了。","book":"郭沫若《少年时代·反正前后》"},"similar":["稍纵即逝","转瞬之间","弹指之间"],"opposite":["遥遥无期","久而久之","天长地久"],"usage":"作分句；指时间过去不久"},{"id":25178,"word":"曾参杀人","pinyin":"zēng shēn shā rén","abbr":"zssr","explanation":"比喻流言可畏。","source":{"text":"人告曾子母曰：‘曾参杀人。’曾子之母曰：‘吾子不杀人。’织自若。……其母惧，投杼逾墙而走。夫以曾参之贤与母之信也，而三人疑之，则慈母不能信也。","book":"《战国策·秦策二》"},"example":{"text":"这冤怎申，硬叠成～。","book":"清·孔尚任《桃花扇·辞院》"},"similar":["流言可畏"],"usage":"作宾语；指流言","story":["春秋时期，鲁国有一个与大思想家曾参同名的人在外杀了人，有好事者跑到曾参的母亲那里说：“曾参杀了人。”曾母回答说：“我儿不会杀人。”照常织布。没多久又有人跑来误传曾参杀了人，这时曾母害怕，就投杼逾墙而走"]},{"id":25179,"word":"曾子杀彘","pinyin":"zēng zǐ shā zhì","abbr":"czsz","explanation":"彘：猪。曾子杀猪。比喻教育子女要以身作则。","source":{"text":"《韩非子·外储说左上》"},"similar":["杀彘教子"],"usage":"作宾语、定语；指父母说话算数","story":["春秋时期，曾子的妻子要去市场，她的儿子哭闹着要跟她去。妻子要他回去并许诺回来就杀猪给他吃。妻子从市场回来，曾子抓住一头猪就要杀，妻子说那只是骗小孩的话。曾子说：“父母的言行直接影响孩子的一生，说到要做到。”"]},{"id":25180,"word":"曾无与二","pinyin":"céng wú yǔ èr","abbr":"cwye","explanation":"独一无二，没有比得上的。","source":{"text":"亿兆攸归，曾无与二。","book":"晋·刘琨《劝进表》"},"example":{"text":"于时武皇之胤，惟有建兴，众望攸归，～。","book":"《晋书·贾胥传》"},"similar":["独一无二","空前绝后"],"opposite":["比比皆是"],"usage":"作谓语、定语；指独一无二"},{"id":25181,"word":"曾母投杼","pinyin":"zēng mǔ tóu zhù","abbr":"zmtz","explanation":"指曾参的母亲听到“曾参杀人”的传闻接连三次，便信以为真，投杼而走，谓流言可畏。","source":{"text":"人告曾子母曰：‘曾参杀人。’曾子之母曰：‘吾子不杀人。’织自若。……其母惧，投杼逾墙而走。夫以曾参之贤与母之信也，而三人疑之，则慈母不能信也。","book":"《战国策·秦策二》"},"example":{"text":"联以不明，虽有～之疑，犹冀言者不信，以为国福。","book":"《三国志·吴书·孙权传》"},"similar":["曾参杀人"],"usage":"作宾语、定语；指流言可畏","story":["春秋时期，鲁国有一个与大思想家曾参同名的人在外杀了人，有好事者跑到曾参的母亲那里说：“曾参杀了人。”曾母回答说：“我儿不会杀人。”照常织布。没多久又有人跑来误传曾参杀了人，这时曾母害怕，就投杼逾墙而走"]},{"id":25182,"word":"曾经沧海","pinyin":"céng jīng cāng hǎi","abbr":"cjch","explanation":"曾经：经历过；沧海：大海。比喻曾经见过大世面，不把平常事物放在眼里。","source":{"text":"曾经沧海难为水，除却巫山不是云。","book":"《孟子·尽心上》：“故观于海者难为水，游于圣人之门者难为言。”唐·元稹《离思》诗"},"example":{"text":"老兄是～，车皮底下也呆过三天三夜，这一点挤，而且不过两个钟头，不算什么，算不了什么。","book":"茅盾《一个够程度的人》"},"similar":["见多识广","饱经沧桑","饱经风霜"],"opposite":["初出茅庐","乳臭未干","孤陋寡闻"],"usage":"作谓语、定语；比喻见识广"},{"id":25183,"word":"替古人担忧","pinyin":"tì gǔ rén dān yōu","abbr":"tgrdy","explanation":"为古人所遇到的困难、危险担忧、发愁。比喻不必要的担心和忧愁。","source":{"text":"我不信，打谈的吊眼泪，替古人耽忧，这些都是虚，他若唱的我眼泪出来，我才算他好戏子。","book":"明·兰陵笑笑生《金瓶梅词话》第二十回"},"example":{"text":"只要那一个答应的下，要你～做什么呢。","book":"清·李宝嘉《官场现形记》第十八回"},"similar":["替古人耽忧"],"usage":"作谓语、宾语；指瞎操心"},{"id":25184,"word":"替古人耽忧","pinyin":"tì gǔ rén dān yōu","abbr":"tgrdy","explanation":"指不必要的忧虑。","source":{"text":"他伤的是他的子民，与你何干！且来宽衣服睡觉，莫替古人耽忧。","book":"明·吴承恩《西游记》第78回"},"example":{"text":"你不要～了。"},"similar":["替古人担忧"],"usage":"作谓语、宾语；指瞎操心"},{"id":25185,"word":"替天行道","pinyin":"tì tiān xíng dào","abbr":"ttxd","explanation":"代上天主持公道。封建社会里农民起义多以此作为动员、组织群众的口号。","source":{"text":"你山上头领，都是替天行道的好汉。","book":"元·康进之《李逵负荆》第一折"},"example":{"text":"有个公道大王牛皋，聚众在此山中，称孤道寡，～。","book":"清·钱彩《说岳全传》第二十五回"},"similar":["为民除害"],"usage":"作谓语、宾语；指运动的幌子"},{"id":25186,"word":"替死鬼","pinyin":"tì sǐ guǐ","abbr":"tsg","explanation":"指代人受难或承担罪责的人。","source":{"text":"盛宣怀等人的原意是，金蝉脱壳，将叶廷春当作‘替死鬼’。","book":"高阳《胡雪岩全传·灯火楼台》"},"example":{"text":"你就不会多找几个～为你服务。"},"similar":["替罪羊"],"usage":"作宾语、定语；用于口语"},{"id":25187,"word":"替罪羊","pinyin":"tì zuì yáng","abbr":"tzy","explanation":"古代犹太教祭礼是替人承担罪过的羊。比喻代人受过。","example":{"text":"我不想成为你的～。"},"similar":["替罪羔羊"],"usage":"作宾语、定语；指代人受过"},{"id":25188,"word":"最可觞客","pinyin":"zhui ke shang ke","abbr":"zksk","explanation":"这里最适宜于请客喝酒赏景."},{"id":25189,"word":"月下星前","pinyin":"yuè xià xīng qián","abbr":"yxxq","explanation":"指清爽幽静的环境。借指谈情说爱的地方。","source":{"text":"爱黄昏月下星前，怕青宵风吹日炙。","book":"元·宋方壶《南吕·一枝花·蚊虫》"},"example":{"text":"征云笼地户，杀气锁天关。天昏地暗排兵，～布阵。（明·许仲琳《封神演义》第二回）"},"similar":["星前月下"],"usage":"作宾语、定语；用于书面语"},{"id":25190,"word":"月下老","pinyin":"yuè xià lǎo","abbr":"yxl","explanation":"唐·李复言《续幽怪录·定婚店》记载：唐朝韦固路过宋城，遇一老人在月光下翻检婚姻簿子。指媒人。","source":{"text":"你权做个撮合山主亲的月下老，俺两个衔环之报，成就了碧桃花下凤鸾交。","book":"明·无名氏《女真观》第三折"},"similar":["月下老人","月下老儿"],"usage":"作主语、宾语、定语；指媒人"},{"id":25191,"word":"月下老人","pinyin":"yuè xià lǎo rén","abbr":"yxlr","explanation":"原指主管婚姻的神仙。后泛指媒人。简称“月老”。","source":{"text":"唐·李复言《续幽怪录》记载传说故事：唐朝的韦固路过宋城，遇一老人在月光下翻检一本书。询问后，知道老人是专管人间婚姻的神，翻检的书是婚姻簿子。"},"example":{"text":"正是一对佳人才子。虽在海外，也是一国驸马，富贵无穷。况天缘是～赤绳系定的，不必多疑。","book":"清·陈忱《水浒后传》第十二回"},"similar":["媒妁之言","天配良缘","月老冰人"],"usage":"作主语、宾语、定语；指媒人","story":["唐朝时期，年轻的韦固路过宋城，遇一老人在月光下倚着一个布袋坐着，翻阅一本书。韦固问是什么书，老人回答说是天下人的婚姻簿，并说袋中有“赤绳”，如果把赤绳暗系在男女双方的腿上，他们就会结为夫妻"]},{"id":25192,"word":"月下老儿","pinyin":"yuè xià lǎo ér","abbr":"yxle","explanation":"神话传说中掌管婚姻之神。借指媒人。","source":{"text":"管姻缘的有一位月下老儿，预先注定，暗里只用一根红丝，把这两个人的脚绊住……若是月下老人不用红线栓的，再不能到一处。","book":"清·曹雪芹《红楼梦》第五十七回"},"example":{"text":"反正千里姻缘一线牵，～已经把你们拴成一对了，今晚上就入洞房。","book":"刘绍棠《蛾眉》二"},"similar":["月下老","月下老人"],"usage":"作主语、宾语、定语；指媒人"},{"id":25193,"word":"月下花前","pinyin":"yuè xià huā qián","abbr":"yxhq","explanation":"本指游乐休息的环境。后多指谈情说爱的处所。","source":{"text":"尽听笙歌夜醉眠，若非月下即花前。","book":"唐·白居易《老病》诗"},"example":{"text":"想着他锦心绣腹那才能，怎教我～不动情。","book":"元·乔孟符《两世姻缘》第二折"},"similar":["花前月下"],"usage":"作宾语、定语；指谈恋爱的地方"},{"id":25194,"word":"月下风前","pinyin":"yuè xià fēng qián","abbr":"yxfq","explanation":"月光下微风轻拂的地方。多指男女幽会之处。","source":{"text":"月下风前，天长地久，自在乘鸾鹤。","book":"元·丘处机《无俗念·乐道》词"},"similar":["月下花前"],"usage":"作宾语、定语；指谈恋爱的地方"},{"id":25195,"word":"月中折桂","pinyin":"yuè zhōng shé guì","abbr":"yzsg","explanation":"在月亮中折桂树枝。比喻科举及第。","source":{"text":"但愿此去，名标金榜，折取月中桂。","book":"宋·无名氏《张协状元·张协辞亲》"},"similar":["蟾宫折桂"],"opposite":["名落孙山"],"usage":"作谓语、定语；用于考试、比赛等"},{"id":25196,"word":"月中聚雪","pinyin":"yuè zhōng jù xuě","abbr":"yzjx","explanation":"月亮里堆积着白雪。形容女子洁白而美丽。","source":{"text":"蜀先主置甘后于白绡帐中，望之如月中聚雪。","book":"宋·叶廷珪《海录碎事·帝王·后妃》"},"usage":"作宾语、定语；用于女性"},{"id":25197,"word":"月书赤绳","pinyin":"yuè shū chì shéng","abbr":"yscs","explanation":"月书：月下老人的婚书；赤绳：月下老人用以牵系婚姻的红绳。指已定下的婚约。","source":{"text":"幸蓝桥玉杵先投，信月书赤绳难换。","book":"明·胡文焕《群音类选·四喜记·大宋毕姻》"},"similar":["月下老人"],"usage":"作宾语、定语；用于书面语"},{"id":25198,"word":"月值年灾","pinyin":"yuè zhí nián zāi","abbr":"yznz","explanation":"指时运不济而遭灾祸。","source":{"text":"元·武汉臣《玉壶春》第三折：“问甚么撞着丧们，管甚么逢着吊客，怕甚么月值年灾，拼死在莺花寨。” 元·白朴《墙头马上》第二折：早是抱闲怨時乖运蹇，又添这害相思月值年灾。"},"example":{"text":"料应他衣绝禄尽，時乖运拙，～。","book":"元·无名氏《小尉迟》第二折"},"usage":"作宾语、定语；用于书面语"},{"id":25199,"word":"月儿弯弯照九州，几家欢乐几家愁","pinyin":"yuè ér wān wān zhào jiǔ zhōu，jī jiā huān lè jī jiā chóu","abbr":"yewwzjzjjhljjc","explanation":"九州：指全中国。月亮普照全中国，而人间苦乐不同，少数人过着吃喝玩乐奢侈豪华的生活，好多人却过着饥寒交迫的苦日子","source":{"text":"月儿弯弯照九州，几家欢乐几家愁？几家夫妻同罗帐，几家飘散在他州？","book":"《京本通俗小说·冯玉梅团圆》"},"usage":"作宾语、定语、分句；用于书面语"},{"id":25200,"word":"月光如水","pinyin":"yuè guāng rú shuǐ","abbr":"ygrs","explanation":"月光皎洁柔和，如同闪光而缓缓流动的清水。形容月色美好的夜晚。","source":{"text":"独上江楼思渺然，月光如水水如天。","book":"唐·赵嘏《江楼感旧》诗"},"example":{"text":"清·褚人获《隋唐演义》第95回：“但见～，水光映月，放舟中流，如游空际。”"},"similar":["月明如水"],"usage":"作宾语、定语；用于景物描写"},{"id":25201,"word":"月圆花好","pinyin":"yuè yuán huā hǎo","abbr":"yyhh","explanation":"花儿正盛开，月亮正圆满。比喻美好圆满。多用于祝贺人新婚。","source":{"text":"幽期莫误香闺恨，罗带今朝褪。月圆花好一般春，触处总堪乘兴。","book":"宋·晁补之《御街行》词"},"example":{"text":"郭沫若《孤山的梅花》：“所以她要选着～的时候，叫我到西湖去和她相会。”"},"similar":["花好月圆"],"usage":"作宾语、定语、谓语；多用于祝贺人新婚"},{"id":25202,"word":"月地云阶","pinyin":"yuè dì yún jiē","abbr":"ydyj","explanation":"月做地，云做台阶。指天上。也比喻景物美好的境界。","source":{"text":"香风引到大罗天，月地云阶拜洞仙。","book":"唐·牛僧儒《周秦行纪》诗"},"example":{"text":"～漫一樽，玉奴终不负东昏。","book":"宋·苏轼《次韵杨公济奉议梅花》诗"},"similar":["云阶月地"],"usage":"作宾语、定语；指风景优美的地方"},{"id":25203,"word":"月坠花折","pinyin":"yuè zhuì huā zhé","abbr":"yzhz","explanation":"月亮落下，鲜花夭折。比喻美女死亡。","source":{"text":"誓世世生生休抛撇，不提防惨凄凄月坠花折，悄冥冥云收雨歇，恨茫茫只落得死断生绝。","book":"清·洪昇《长生殿·补恨》"},"usage":"作谓语、定语；多用于比喻句"},{"id":25204,"word":"月夕花晨","pinyin":"yuè xī huā chén","abbr":"yxhc","explanation":"借指良辰美景。","source":{"text":"程为人风雅绝伦，议论潇洒，李悦焉。越日折柬酬之，欢笑益洽。从此月夕花晨，未尝不相共也。","book":"清·蒲松龄《聊斋志异·局诈》"},"example":{"text":"奴家姓刘……只因父母早亡，流落在烟花行院，歌衫舞扇，也学些袅袅婷婷，～，总不免凄凄楚楚。","book":"清·魏秀仁《花月痕》第五十二回"},"similar":["月夕花朝","月夜花朝"],"usage":"作宾语、定语；指良辰美景"},{"id":25205,"word":"月夕花朝","pinyin":"yuè xī huā zhāo","abbr":"yxhz","explanation":"月明的夜晚，花开的早晨。形容良辰美景。","source":{"text":"每花朝月夕，与宾佐赋咏，甚有情致。","book":"《旧唐书·罗威传》"},"example":{"text":"空误了幽期密约，虚过了～，天缘配合，有分煎熬。","book":"元·郑德辉《迷青琐倩女离魂》第一折"},"similar":["月夕花晨","月夜花朝"],"usage":"作宾语、定语；指良辰美景"},{"id":25206,"word":"月夜花朝","pinyin":"yuè yè huā zhāo","abbr":"yyhz","explanation":"有鲜花的早晨，有明月的夜晚。指美好的时光和景物。旧时也特指农历二月十五和八月十五。","source":{"text":"每花朝月夕，与宾佐赋咏，甚有情致。","book":"《旧唐书·罗威传》"},"example":{"text":"不是我骋粗豪，强霸着～。","book":"元·周文质《赏花时·风情》"},"similar":["月夕花朝","月夕花晨"],"usage":"作宾语、定语；指良辰美景"},{"id":25207,"word":"月异日新","pinyin":"yuè yì rì xīn","abbr":"yyrx","explanation":"月月不同，日日更新。形容变化、发展很快。","source":{"text":"比见国家奋筹富强之术，月异日新，不遗余力，骎骎乎将与欧洲并驾矣。","book":"孙中山《上李鸿章书》"},"similar":["日新月异"],"usage":"作谓语、定语；用于书面语"},{"id":25208,"word":"月攘一鸡","pinyin":"yuè rǎng yī jī","abbr":"yryj","explanation":"攘：偷。比喻容忍错误，只肯逐步改正。","source":{"text":"今有人攘其邻之鸡者。或告之曰：‘是非君子之道。’曰：‘请损之，月攘一鸡，以待来年然后已。’如知其非义，斯速已矣，何待来年？","book":"《孟子·滕文公下》"},"example":{"text":"而青苗之事，乃犹因旧稍加损益，欲行抮臂徐徐～之道。（宋·苏辙《缴驳青苗法疏》）"}},{"id":25209,"word":"月旦春秋","pinyin":"yuè dàn chūn qiū","abbr":"ydcq","explanation":"比喻评论人物的好坏。","source":{"text":"初，劭与靖（劭从兄）俱有高名，好共核论乡党人物，每月辄更其品题，故汝南俗有，月旦评焉。","book":"《后汉书·许劭传》"},"similar":["臧否人物"],"usage":"作谓语；指评论人"},{"id":25210,"word":"月旦评","pinyin":"yuè dàn píng","abbr":"ydp","explanation":"指品评人物或诗文字画等。","source":{"text":"初，劭与靖俱有高名，好共核论乡党人物，每月辄更其品题，故汝南俗有，月旦评焉。","book":"《后汉书·许劭传》"},"example":{"text":"言辞不爽，谓之金石语；乡党公论，谓之～。","book":"明·程登吉《幼学琼林·身体》"}},{"id":25211,"word":"月明千里","pinyin":"yuè míng qiān lǐ","abbr":"ymql","explanation":"月光普照大地。后多用作友人或恋人相隔遥远，月夜倍增思念的典故。","source":{"text":"美人迈兮音尘阙，隔千里兮共明月。","book":"南朝宋·谢庄《月赋》"},"example":{"text":"今日个～故人来，镜鸾重整向妆台，这的是换人肌骨夺人胎。","book":"元·无名氏《碧桃花》第四折"},"usage":"作宾语、定语；指明月夜"},{"id":25212,"word":"月明如昼","pinyin":"yuè míng rú zhòu","abbr":"ymrz","explanation":"月亮照耀得像白天一样明亮。","source":{"text":"一鸟不鸣风又细，月明如昼天如水。","book":"金·丘处机《蝶恋花·述怀》词"},"example":{"text":"清·洪昇《长生殿·偷曲》：“不免袖了铁笛，来到骊山，趁此～，窃听一回。”"},"usage":"作宾语、定语；用于书面语"},{"id":25213,"word":"月明如水","pinyin":"yuè míng rú shuǐ","abbr":"ymrs","explanation":"月光皎洁柔和，如同闪光而缓缓流动的清水。形容月色美好的夜晚。","source":{"text":"月明如水山头寺，仰面看天石上行。","book":"唐·张祜《峰顶寺》诗"},"example":{"text":"你看～，正好演奏。我和你携了曲谱，先到阁中便了。","book":"清·洪昇《长生殿·偷曲》"},"similar":["月光如水"],"usage":"作宾语、定语；用于景物描写"},{"id":25214,"word":"月明星稀","pinyin":"yuè míng xīng xī","abbr":"ymxx","explanation":"月亮明亮时，星星就显得稀疏了。","source":{"text":"月明星稀，乌鹊南飞。绕树三匝，何枝可依？","book":"三国·魏·曹操《短歌行》"},"example":{"text":"河湾子修堰坝的工地，～，小河水静静流入水渠。","book":"李准《李双双》"},"similar":["月朗星疏"],"usage":"作宾语、定语；指夜晚"},{"id":25215,"word":"月明风清","pinyin":"yuè míng fēng qīng","abbr":"ymfq","explanation":"月光明朗，微风爽人。形容美好的月夜。","source":{"text":"太和中，处士萧旷，自洛东游至孝义馆，夜憩于双美亭。时月朗风清，旷善琴，遂取琴弹之。","book":"唐·无名氏《洛神传》"},"similar":["月朗风清"],"usage":"作谓语、宾语、定语；指夜色"},{"id":25216,"word":"月晕主风","pinyin":"yuè yùn zhǔ fēng","abbr":"yyzf","explanation":"晕：日光或月光通过云层时因折射作用而形成日、月周围的光圈。月亮周围出现晕圈，则是有风的预兆","source":{"text":"月晕主风，何方有阙，即此方风来。","book":"《田家五行·杂占论月》"},"usage":"作宾语、定语；用于书面语"},{"id":25217,"word":"月晕知风","pinyin":"yuè yùn zhī fēng","abbr":"yyzf","explanation":"月晕：月亮周围出现的光环。月亮出现光环就知道要刮风。比喻见到一点迹象就能知道它的发展趋向。","source":{"text":"月晕而风，础润而雨，人人知之。","book":"宋·苏洵《辨奸论》"},"example":{"text":"～，础润知雨，而况乎风雨之已来袭者耶！（清·梁启超《杂答某报》）"}},{"id":25218,"word":"月晕知风，础润知雨","pinyin":"yuè yūn zhī fēng，chǔ rùn zhī yǔ","abbr":"yyzfcrzy","explanation":"月晕出现，将要刮风；础石湿润，就要下雨。比喻从某些征兆可以推知将会发生的事情。","source":{"text":"月晕知风，础润知雨，窃恐踵莱阳而起者，祸变相寻而来未有已也。","book":"长舆《论莱阳民变事》"},"similar":["月晕础润","月晕而风，础润而雨"],"usage":"作宾语、定语；用于书面语"},{"id":25219,"word":"月晕础润","pinyin":"yuè yūn chǔ rùn","abbr":"yycr","explanation":"比喻事情将会发生的先兆。","source":{"text":"今日中国之现象，其月晕础润之几既动矣。若是乎，则智育将为德育之蠹；而名德育而实智育者，益且为德育之障也。","book":"梁启超《新民说》第十八节"},"similar":["月晕而风，础润而雨"],"usage":"作宾语、定语；用于书面语"},{"id":25220,"word":"月晕础雨","pinyin":"yuè yùn chǔ yǔ","abbr":"yycy","explanation":"月晕：月亮周围出现的光环；础：柱子底下的石墩。月亮出现光环就要刮风，础石潮湿就要下雨。比喻事物发生变化的前兆。","source":{"text":"月晕而风，础润而雨，人人知之。","book":"宋·苏洵《辨奸论》"}},{"id":25221,"word":"月晕而风","pinyin":"yuè yùn ér fēng","abbr":"yyef","explanation":"月晕：月亮周围出现的光环。月亮出现光环，就是要刮风的征候。比喻见到一点迹象就能知道它的发展趋向。","source":{"text":"月晕而风，础润而雨，人人知之。","book":"宋·苏洵《辨奸论》"},"example":{"text":"燥湿为天地自然之气，～，础润而雨，人以此测于几先者，固古今一致也。","book":"清·淮阴百一居士《壶天录》卷上"},"similar":["见微知著"],"usage":"作定语；指见微知著"},{"id":25222,"word":"月晕而风，础润而雨","pinyin":"yuè yūn ér fēng，chǔ rùn ér yǔ","abbr":"yyefcrey","explanation":"月晕出现，将要刮风；础石湿润，就要下雨。比喻从某些征兆可以推知将会发生的事情。","source":{"text":"事有必至，理有固然，惟天下之静者，乃能见微而知著。月晕而风，础润而雨，人人知之。","book":"宋·苏洵《辨奸论》"},"example":{"text":"燥湿为天地自然之气，～，人以此测于几先者，固古今一致也。","book":"清·百一居士《壶天录》卷上"},"similar":["月晕础润","月晕知风，础润知雨"],"usage":"作宾语、定语；用于书面语"},{"id":25223,"word":"月朗星稀","pinyin":"yuè lǎng xīng xī","abbr":"ylxx","explanation":"皓月当空，星星稀少。","source":{"text":"草地的气候就是怪，明明是月朗星稀的好天气，忽然一阵风吹来，浓云像从平地上冒出来的，把天遮得严严的，接着，就有一场暴雨。","book":"王愿坚《七根火柴》"},"example":{"text":"当天晚上，～。","book":"杨佐青《风起盘石·我们的旗帜》"},"usage":"作宾语、定语；用于天气描写"},{"id":25224,"word":"月朗风清","pinyin":"yuè lǎng fēng qīng","abbr":"ylfq","explanation":"月光明朗，微风清爽。形容宁静美好的月夜。","source":{"text":"地偏人静，月朗风清，窗户绝点尘埃。","book":"元·王实甫《西厢记》第一本第三折：“夜深人静，月朗风清，是好天气也呵！”元·姬翼《春从天上来》词"},"example":{"text":"一夕～，从人先自去睡了，李谟心中烦闷，且不即睡。","book":"清·褚人获《隋唐演义》第九十五回"},"similar":["风清月白","月明风清"],"usage":"作谓语、宾语、定语；指夜色"},{"id":25225,"word":"月殿嫦娥","pinyin":"yuè diàn cháng é","abbr":"ydce","explanation":"嫦娥：神话中月宫里的仙女，相传她是后羿的妻子，因偷吃不死之药而上了月宫。月中仙子。比喻风姿绰约的美丽女子。","source":{"text":"今日咱守定伊，休道近前使唤丫鬟辈，便有瑶池仙子无心觑，月殿嫦娥懒去窥。","book":"元·关汉卿《玉镜台》第三折"},"example":{"text":"容貌端丽，瑞彩翩跹，国色天姿，婉然如生；真是蕊宫仙子临凡，～下世。","book":"明·许仲琳《封神演义》第一回"}},{"id":25226,"word":"月没参横","pinyin":"yuè mò shēn héng","abbr":"ymsh","explanation":"月亮已落，参星横斜。形容夜深。","source":{"text":"月没参横，北斗阑干；亲友在门，饥不及餐。","book":"《乐府诗集·相和歌辞十一·善哉行》"},"example":{"text":"～画角哀，暗香消尽令人老。","book":"宋·秦观《和黄曹忆建溪梅花》"},"similar":["月落参横"],"usage":"作宾语、定语；用于书面语"},{"id":25227,"word":"月满则亏","pinyin":"yuè mǎn zé kuī","abbr":"ymzk","explanation":"月圆则缺。比喻事物发展到极点则开始衰退。","source":{"text":"语曰‘日中则移，月满则亏’。物盛则衰，天地之常数也。","book":"《史记·范雎蔡泽列传》"},"example":{"text":"你如何连两句俗语也不晓得？常言‘～，水满则溢。’又道是‘登高必跌重。’","book":"清·曹雪芹《红楼梦》第十三回"},"similar":["水满则溢","月盈则食"],"usage":"作宾语、定语；用于书面语"},{"id":25228,"word":"月满则亏，水满则溢","pinyin":"yuè mǎn zé kuī，shuǐ mǎn zé ì","abbr":"ymzksmzy","explanation":"月亮圆的时候就容易发生月蚀，水满了就会溢出来。比喻事物盛到极点就会衰落。","source":{"text":"日中则昃，月盈则食。","book":"《周易·丰》"},"example":{"text":"常言“～”，又道是“登高必跌重”。","book":"清·曹雪芹《红楼梦》第十三回"}},{"id":25229,"word":"月满花香","pinyin":"yuè mǎn huā xiāng","abbr":"ymhx","explanation":"明月正圆，百花飘香。指良辰美景。","source":{"text":"如今从网眼里拔出来，好容易遇着这等月满花香的时光，他如何肯轻易放过。","book":"清·文康《儿女英雄传》第二十九回"},"usage":"作宾语、定语；用于景物描写"},{"id":25230,"word":"月白风清","pinyin":"yuè bái fēng qīng","abbr":"ybfq","explanation":"形容幽静美好的夜晚。","source":{"text":"有客无酒，有酒无肴，月白风清，如此良夜何？","book":"宋·苏轼《后赤壁赋》"},"example":{"text":"是夜～，水天共碧，二人正在僧房里，睡至半夜，忽听得江上潮声雷响。","book":"明·施耐庵《水浒全传》第一百十九回"},"similar":["月明如镜","月光如水","月明星稀"],"opposite":["日月无光","月黑风高","天昏地暗"],"usage":"作定语、宾语、补语；指夜晚"},{"id":25231,"word":"月盈则食","pinyin":"yuè yíng zé shí","abbr":"yyzs","explanation":"盈：满；食：通“蚀”，缺。月亮圆的时候就容易发生月蚀。比喻事物盛到极点就会衰落。","source":{"text":"日中则昃，月盈则食。","book":"《周易·丰》"},"example":{"text":"～，心在日冲，以检日则宿度可辨，请据效以课疏密。","book":"《宋书·律历志下》"},"similar":["日中则昃","物极必反"],"usage":"作谓语、定语；用于劝诫人"},{"id":25232,"word":"月眉星眼","pinyin":"yuè méi xīng yǎn","abbr":"ymxy","explanation":"眉如弯月，眼似流星。形容女子容貌美丽。","source":{"text":"你说咱雪肌花貌常清静，桃腮杏脸行端正，月眉星眼天然性。","book":"明·无名氏《女贞观》第一折"},"usage":"作宾语、定语；用于女性"},{"id":25233,"word":"月章星句","pinyin":"yuè zhāng xīng jù","abbr":"yzxj","explanation":"形容文章优美，辞藻华丽。","source":{"text":"集词敬为先生寿，博得月章星句。","book":"元·马熙《摸鱼子八首》之六"},"example":{"text":"我被她的～迷住了。"},"usage":"作宾语、定语；指文章"},{"id":25234,"word":"月约星期","pinyin":"yuè yuē xīng qī","abbr":"yyxq","explanation":"月：指月光下；星：指星光下。星前月下的约会。多指男女幽会。","source":{"text":"海誓山盟，白玉连环，月约星期，泥金小简。","book":"元·乔吉《行香子·题情》曲"},"usage":"作宾语、定语；用于书面语"},{"id":25235,"word":"月缺花残","pinyin":"yuè quē huā cán","abbr":"yqhc","explanation":"形容衰败零落的景象。也比喻感情破裂，两相离异。","source":{"text":"月缺花残莫怆然，花须终发月须圆。","book":"唐·温庭筠《和王秀才伤歌妓》诗"},"example":{"text":"～人憔悴，冷落了鸳鸯被。","book":"元·商挺《潘妃曲》"},"similar":["花残月缺"],"usage":"作谓语；有惋惜的情绪"},{"id":25236,"word":"月缺重圆","pinyin":"yuè quē chóng yuán","abbr":"yqcy","explanation":"比喻夫妻失散或离婚后重新团聚。","source":{"text":"你诗中之意，我都晓得，若后来访得你前夫消息，定然使月缺重圆。","book":"明·天然智叟《石头点》第十回"},"example":{"text":"～，从容而去，始知仙人之情亦更深于流俗也！","book":"清·蒲松龄《聊斋志异·小翠》"},"similar":["破镜重圆"],"usage":"作宾语、定语；用于比喻句"},{"id":25237,"word":"月缺难圆","pinyin":"yuè quē nán yuán","abbr":"yqny","explanation":"比喻关系一旦破裂，就很难挽回。","source":{"text":"若不还我宝珠，我便放金蛟剪，那时月缺难圆。","book":"明·许仲琳《封神演义》第四十七回"},"usage":"作谓语、定语；用于比喻句"},{"id":25238,"word":"月色溶溶","pinyin":"yue se rong rong","abbr":"ysrr","explanation":"溶溶：形容月色柔和温润。","source":{"text":"○宋 晏殊《寓意》 月白风清，如此良夜何 意谓月色皎洁，微风清... 月色溶溶"}},{"id":25239,"word":"月落乌啼","pinyin":"yuè luò wū tí","abbr":"ylwt","explanation":"形容天色将明未明时的景象。","source":{"text":"月落乌啼霜满天，江枫渔火对愁眠。","book":"唐·张继《枫桥夜泊》诗"},"example":{"text":"清·黄宗羲《吴节母墓志铭》：“～，书声出牖。孤子当门，老姑回首。”"},"usage":"作宾语、定语；用于书面语"},{"id":25240,"word":"月落参横","pinyin":"yuè luò shēn héng","abbr":"ylsh","explanation":"月亮已落，参星横斜。形容天色将明。","source":{"text":"时东方已白，师雄起视，乃在大梅花树下，上有翠羽啾嘈，相须月落参横，但惆怅而尔。","book":"唐·柳宗元《龙城录·赵师雄醉憩梅花下》"},"example":{"text":"应为伊惆怅江南，～后。","book":"清·吴趼人《二十年目睹之怪现状》第四十回"},"similar":["月没参横"],"usage":"作宾语、定语；用于书面语"},{"id":25241,"word":"月落屋梁","pinyin":"yuè luò wū liáng","abbr":"ylwl","explanation":"比喻对朋友的怀念。","source":{"text":"落月满屋梁，犹疑照颜色。","book":"唐·杜甫《梦李白》诗"}},{"id":25242,"word":"月落星沉","pinyin":"yuè luò xīng chén","abbr":"ylxc","explanation":"月亮落山，星光暗淡了。指天将亮时。","source":{"text":"月落星沉，楼上美人春睡。","book":"五代蜀·韦庄《酒泉子》词"},"example":{"text":"直谈到～，我才依依不舍地起身告别。","book":"杨朔《生命在号召》"},"usage":"作宾语、定语；指凌晨"},{"id":25243,"word":"月衔半规","pinyin":"yuè xián bàn guī","abbr":"yxbg","explanation":"规：圆形。指农历初八、九或二十二、二十三，月亮上弦、下弦的日子。","source":{"text":"生至户外，不见朱。翘首西望。月衔半规，昏黄中犹认旧径。见南面一第，朱坐门石上。","book":"清·蒲松龄《聊斋志异·公孙九娘》"},"usage":"作宾语、定语；用于书面语"},{"id":25244,"word":"月貌花容","pinyin":"yuè mào huā róng","abbr":"ymhr","explanation":"如花似月的容貌。形容女子美貌。","source":{"text":"对月貌花庞，饮玉液琼浆。","book":"元·吴昌龄《东坡梦》第四折"},"example":{"text":"可惜了～，颠倒做败柳残花。","book":"明·胡文焕《群音类选·清腔类·李子花》"},"similar":["花容月貌"],"usage":"作宾语、定语；指美女"},{"id":25245,"word":"月貌花庞","pinyin":"yuè mào huā páng","abbr":"ymhp","explanation":"庞：脸庞。如花似月的容貌。形容女子美貌。","source":{"text":"对月貌花庞，饮玉液琼浆。","book":"元·吴昌龄《东坡梦》第四折"},"example":{"text":"清·洪昇《长生殿·哭象》：“掩面悲伤，救不得～。”"},"usage":"作宾语、定语；用于书面语"},{"id":25246,"word":"月过中秋","pinyin":"yuè guò zhōng qiū","abbr":"ygzq","explanation":"指错过时机。中秋节时月亮最圆、最亮、最美，故用以比喻良机。","source":{"text":"若遇那铅逢发发处须当采，若是那月过中秋下手迟。","book":"明·朱权《冲漠子》第二折"},"usage":"作宾语、定语；用于比喻句"},{"id":25247,"word":"月里嫦娥","pinyin":"yuè lǐ cháng é","abbr":"ylce","explanation":"嫦娥：神话中月宫里的仙女，相传她是后羿的妻子，因偷吃不死之药而上了月宫。比喻风姿绰约的美女。","source":{"text":"羿请不死之药于西王母，姮娥窃之奔月宫。","book":"《淮南子·览冥训》"},"example":{"text":"姐姐是～。","book":"元·无名氏《赚蒯通》第三折"},"usage":"作宾语、定语；指美女","story":["传说古代天空中有10个太阳同时出来，大地被烤成焦土，后羿为民除害射掉了9个太阳，西天的王母娘娘奖赏他长生不老的仙药。他的妻子嫦娥趁后羿不注意时偷吃了这些药，突然她就成仙飞向天宫，王母娘娘惩罚她，让她在广寒宫里思过"]},{"id":25248,"word":"月锻季炼","pinyin":"yuè duàn jì liàn","abbr":"ydjl","explanation":"锻、炼：加工锤炼。形容长时间地加工修改。","source":{"text":"如周朴者，构思尤艰，每有所得，必极其雕琢，故时人称朴诗‘月锻季炼，未及成篇，已播人口’。","book":"宋·欧阳修《六一诗话》"},"usage":"作谓语、定语；用于书面语"},{"id":25249,"word":"月闭花羞","pinyin":"yuè bì huā xiū","abbr":"ybhx","explanation":"闭：躲避；羞：害臊。闭月形容貂禅，羞花形容杨玉环。使月亮见了也躲避起来，花儿见了也自觉羞愧。形容女子貌美。","source":{"text":"芳容鱼沉雁落，美貌月闭花羞；肌骨天然自好，不搽脂粉风流。","book":"元·施惠《幽闺记·少不知愁》"},"example":{"text":"鱼沉雁落，～。","book":"明·冯梦龙《醒世恒言》第31卷"},"similar":["闭月羞花","沉鱼落雁"],"usage":"作谓语、定语；用于美女"},{"id":25250,"word":"月露之体","pinyin":"yuè lù zhī tǐ","abbr":"ylzt","explanation":"喻指辞藻华美而内容空乏的诗文。","source":{"text":"江左齐梁，其弊弥甚……竞一韵之奇，争一字之巧，连篇累牍，不出月露之形，积案盈箱，唯是风云之状。","book":"语本《隋书·李谔传》"},"example":{"text":"世所盛行宋元词曲，咸以昉于唐末，然实陈隋始之，盖齐梁～，矜华角丽，固已兆端。","book":"明·胡应麟《少室山房笔丛·庄岳委谈下》"},"usage":"作宾语；用于书面语"},{"id":25251,"word":"月露风云","pinyin":"yuè lù fēng yún","abbr":"ylfy","explanation":"比喻无用的文字。","source":{"text":"连篇累牍，不出月露之形；积案盈箱，唯是风云之状。","book":"《隋书·李谔传》"},"usage":"作宾语、定语；用于书面语"},{"id":25252,"word":"月黑风高","pinyin":"yuè hēi fēng gāo","abbr":"yhfg","explanation":"比喻没有月光风也很大的夜晚。比喻险恶的环境。","source":{"text":"欧阳公与人行令，各作诗两句，须犯徒以上罪者……一云：‘月黑杀人夜，风高放火天。’","book":"元·元怀《拊掌录》"},"example":{"text":"遇上～的晚上，飞砂走石，满地乱滚，长城就在咬牙切齿骂人了。","book":"杨朔《秋风萧瑟》"},"similar":["日月无光","天昏地暗"],"opposite":["月明如镜","月光如水","月明星稀"],"usage":"作定语、分句；指夜晚"},{"id":25253,"word":"有一利即有一弊","pinyin":"yǒu yī lì jì yǒu yī bì","abbr":"yyljyyb","explanation":"弊：弊病，害处。在这一方面有好处，在另一方面就会有坏处。","source":{"text":"天下事有一利即有一弊，那里有没有弊病的道理。","book":"清·吴趼人《二十年目睹之怪现状》第46回"},"similar":["有利有弊"],"usage":"作谓语、定语、宾语；指客观看待"},{"id":25254,"word":"有一利必有一弊","pinyin":"yǒu yī lì bì yǒu yī bì","abbr":"yylbyyb","explanation":"在这一方面有好处，在另一方面就会有坏处。","source":{"text":"天下事有一利必有一弊，那里有没有弊病的道理。","book":"清·吴趼人《二十年目睹之怪现状》第四十六回"},"example":{"text":"但是，真如先哲之谓“～”罢，同时也开始了火灾。（鲁迅《且介亭杂文·关于中国的二三件事》）"},"usage":"作谓语、宾语、定语；用于处事"},{"id":25255,"word":"有一得一","pinyin":"yǒu yī dé yī","abbr":"yydy","explanation":"不加也不减，有多少是多少。","example":{"text":"我一向是～。"},"usage":"作谓语、定语；指不贪求"},{"id":25256,"word":"有一手儿","pinyin":"yǒu yī shǒu ér","abbr":"yyse","explanation":"有专长。男女之间不正当的关系。","source":{"text":"那鲍二向来却就和厨子多浑虫的媳妇多姑娘有一手儿。","book":"清·曹雪芹《红楼梦》"},"similar":["有两下子"],"usage":"作谓语；指有专长，用于口语"},{"id":25257,"word":"有一搭没一搭","pinyin":"yǒu yī dā méi yī dā","abbr":"yydmyd","explanation":"表示故意找话说。也表示可有可无，无足轻重。","source":{"text":"宝玉有一搭没一搭的说些鬼话，黛玉总不理。","book":"清·曹雪芹《红楼梦》第十九回"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“一面收拾房间，一面～地与胡雪岩说闲话。”"},"usage":"作状语；指人说话或办事"},{"id":25258,"word":"有一无二","pinyin":"yǒu yī wú èr","abbr":"yywe","explanation":"只有一个，不会有第二个。指事物独特，极难得。","source":{"text":"似这等才调也算得有一无二的了。","book":"明·姚子翼《遍地锦传奇·劝主》"},"example":{"text":"等柳二弟一见，便知我这内娣的品貌是古今～的了。（清·曹雪芹《红楼梦》第六十六回）"},"similar":["独一无二"],"usage":"作谓语、定语；形容极难得"},{"id":25259,"word":"有三有俩","pinyin":"yǒu sān yǒu liǎng","abbr":"ysyl","explanation":"指有富余钱财。"},{"id":25260,"word":"有两下子","pinyin":"yǒu liǎng xià zǐ","abbr":"ylxz","explanation":"比喻有点本领。","example":{"text":"这个人不简单，真是～。"},"usage":"作谓语；用于口语"},{"id":25261,"word":"有为有守","pinyin":"yǒu wéi yǒu shǒu","abbr":"ywys","explanation":"有为：有作为；有守：有操守。既有作为，又有操节。形容人的完美。","source":{"text":"凡厥庶民，有猷有为有守。","book":"《尚书·洪范》"},"example":{"text":"思赞襄，日有孜孜。亮天工，庶绩咸熙。须将器识先文艺。～，汝翼汝为。","book":"《清史稿·乐志五》"},"usage":"作谓语、定语；用于书面语"},{"id":25262,"word":"有了存孝，不显彦章","pinyin":"yǒu le cún xiào，bù xiǎn yán zhāng","abbr":"ylcxbxyz","explanation":"存孝、彦章：李存孝、王彦章，五代时人，有勇力。有了李存孝，就显不出王彦章。比喻两雄不能并立。","source":{"text":"实合你说，如今我还多着李成名媳妇，李成名媳妇还多着我，再要挂搭上他，可说‘有了存孝，不显彦章’。","book":"清·西周生《醒世姻缘传》第十九回"},"usage":"作宾语、定语；用于处事"},{"id":25263,"word":"有事之秋","pinyin":"yǒu shì zhī qiū","abbr":"yszq","explanation":"指战争或多事故的年头。","source":{"text":"王思政驱驰有事之秋，慷慨功名之际。","book":"《北史·王罴王轨等传论》"},"example":{"text":"莫讲把何玉凤支使得眼花缭乱，连张金凤在淮安过门时，正值那～，也不似这番热闹。","book":"清·文康《儿女英雄传》第二十八回"},"similar":["多事之秋"],"usage":"作宾语；用于书面语"},{"id":25264,"word":"有仇不报非君子","pinyin":"yǒu chóu bù bào fēi jūn zǐ","abbr":"ycbbfjz","explanation":"有仇不报不算大丈夫。形容人气质刚毅。","example":{"text":"等大哥出来，咱夫妻伸手将这枝镖拾下来。～，那鬼镖头引人来捉大哥，岂能就此罢休？","book":"金庸《书剑恩仇录》第四回"}},{"id":25265,"word":"有仙则名","pinyin":"yǒu xiān zé míng","abbr":"yxzm","explanation":"山中有了仙人居住，山就成为名山","source":{"text":"山不在高，有仙则名。","book":"唐·刘禹锡《陋室铭》"},"similar":["有龙则灵"],"usage":"作谓语、定语；用于书面语"},{"id":25266,"word":"有以善处","pinyin":"yǒu yǐ shàn chǔ","abbr":"yysc","explanation":"指正确对待，妥善处理。"},{"id":25267,"word":"有以教我","pinyin":"yǒu yǐ jiāo wǒ","abbr":"yyjw","explanation":"提出问题，希望别人帮助解答。","source":{"text":"贤子远相问，幸有以教我；得报速是宜，翘企不容坐。","book":"《孟子·梁惠王上》：“吾惛，不能进于是矣；愿夫子辅吾志，明以教我，我虽不敏，请尝试之。”宋·王令《寄王正叔》"},"example":{"text":"君吴人，朝廷近臣，今虽去，宜～。","book":"《明史·黄钺传》"}},{"id":25268,"word":"有伤风化","pinyin":"yǒu shāng fēng huà","abbr":"ysfh","explanation":"伤：妨碍、败坏；风化：风俗教化。败坏、损害社会的风俗和教化。指对社会风俗、教育有不好影响的言行。","source":{"text":"你道做了有伤风化，谁就你那燕尔新婚。","book":"元·关汉卿《裴度还带》第四折"},"example":{"text":"王谓丘作《五伦全备传奇》，～，失文宗体。（明·杨仪《明良记》第十四节）"},"similar":["伤风败俗"],"opposite":["规规矩矩"],"usage":"作谓语、定语；多指男女关系方面"},{"id":25269,"word":"有何面目","pinyin":"yǒu hé miàn mù","abbr":"yhmm","explanation":"指没有脸见人。","source":{"text":"食禄而避难，非忠也，杀母而全义，非孝也，如是，有何面目立于天下。","book":"《后汉书·赵苞传》"},"usage":"作谓语；用于书面语"},{"id":25270,"word":"有作其芒","pinyin":"yǒu zuò qí máng","abbr":"yzqm","explanation":"干将在磨刀石上磨出的剑刃发出了光芒。","source":{"text":"干将发硎，有作其芒。","book":"梁启超《谭嗣同传》"},"usage":"作谓语、宾语；指人或事物"},{"id":25271,"word":"有你不多，无你不少","pinyin":"yǒu nǐ bù duō，wú nǐ bù shǎo","abbr":"ynbdwnbs","explanation":"指无关紧要的人，可有可无。","example":{"text":"你放心，～，地球照样转动。"},"similar":["可有可无"],"opposite":["必不可少"],"usage":"作定语、分句；用于口语"},{"id":25272,"word":"有例不兴，无例不灭","pinyin":"yǒu lì bù xīng，wú lì bù miè","abbr":"ylbxwlbm","explanation":"列：惯例，指旧有的常规；兴：提出；灭：废除。有惯例就不再起用新办法，无惯例也不能违背常规。指遵循旧的典章制度。","source":{"text":"回师老爷的话：‘有例不兴，无例不灭。’这两句俗语料想师老爷是晓得的。","book":"清·李宝嘉《官场现形记》第四十一回"}},{"id":25273,"word":"有例可援","pinyin":"yǒu lì kě yuán","abbr":"ylky","explanation":"有成例可以援引。","source":{"text":"惟生传则自古有之，如韩昌黎之于何蕃，司马温公子之于范镇，有例可援。","book":"清·袁枚《寄房师邓逊斋先生书》"},"example":{"text":"只要是～的事情，都可以答应。","book":"郭沫若《南冠草》第三幕"},"usage":"作谓语、宾语、定语；用于处事"},{"id":25274,"word":"有借无还","pinyin":"yǒu jiè wú huán","abbr":"yjwh","explanation":"指借别人东西耍赖不归还。","example":{"text":"他借东西向来是有借无还的。"},"opposite":["有借有还"],"usage":"作宾语；指借别人东西不归还","story":["东汉末年赤壁大战后，曹操败弃荆州、南郡、襄阳三城，刘备趁机派兵独占这三座城池，周瑜回师后大怒，派鲁肃去责问诸葛亮。诸葛亮说他是代荆州原主人刘琦管理。刘琦死后，鲁肃去讨还荆州，诸葛亮说待打下西川后再还，鲁肃无奈而返"]},{"id":25275,"word":"有其父必有其子","pinyin":"yǒu qí fù bì yǒu qí zǐ","abbr":"yqfbyqz","explanation":"有什么样的父亲一定会有什么样的儿子。形容父亲对子女的影响极大。","source":{"text":"有此父斯有此子，人道之常也。","book":"《孔丛子·居卫》"},"example":{"text":"想你父亲，也不曾弱了。常言道：～。","book":"元·白仁甫《东墙记》第三折"},"similar":["虎父无犬子"],"usage":"作谓语、宾语、分句；指父子"},{"id":25276,"word":"有典有则","pinyin":"yǒu diǎn yǒu zé","abbr":"ydyz","explanation":"典：法则；则：准则。指有法可供依据的准则或法度。","source":{"text":"惟宗惟祖，有典有则。大魏将军，隆周柱国。","book":"唐·杨炯《后周明威将军梁公神道碑》"},"usage":"作谓语、定语；用于书面语"},{"id":25277,"word":"有冤报冤，有仇报仇","pinyin":"yǒu yuān bào yuān，yǒu chóu bào chóu","abbr":"yybyycbc","explanation":"指让犯下罪过的人付出代价。","source":{"text":"武松虽是粗卤汉子，便死也不怕，还省得‘有冤报冤，有仇报仇’。","book":"明·施耐庵《水浒全传》第二十六回"},"example":{"text":"～。只杀知县，不伤百姓。让我者生，挡我者死！","book":"明·冯梦龙《醒世恒言》卷三十九"},"usage":"作谓语、定语、宾语；用于处事"},{"id":25278,"word":"有凤来仪","pinyin":"yǒu fèng lái yí","abbr":"yfly","explanation":"凤：凤凰，传说中的百鸟之王；仪：仪容。古时吉祥的征兆。","source":{"text":"箫韶九成，凤皇来仪。","book":"《尚书·益稷》"},"example":{"text":"宝玉道：“这太板了。莫若‘～’四字。”","book":"清·曹雪芹《红楼梦》第十七回"},"similar":["凤凰来仪","凤皇来仪"],"usage":"作宾语、定语；指吉祥征兆"},{"id":25279,"word":"有凭有据","pinyin":"yǒu píng yǒu jù","abbr":"ypyj","explanation":"既有凭证，又有依据。","source":{"text":"又且他家差老园公请你，有凭有据，须不是你自轻自贱。","book":"明·冯梦龙《喻世明言·陈御史巧勘金钗钿》"},"example":{"text":"明·冯梦龙《喻世明言·陈御史巧勘金钗钿》：“又且他家差老园公请你，有凭有据，须不是你自轻自贱。”"},"similar":["真凭实据"],"opposite":["无凭无据"],"usage":"作谓语、状语；指有凭证"},{"id":25280,"word":"有则改之","pinyin":"yǒu zé gǎi zhī","abbr":"yzgz","explanation":"则：就；加：加以。对别人给自己指出的缺点错误，如果有，就改正。","source":{"text":"曾子以此三者日省其身，有则改之，无则加勉，其自治诚切如此，可谓得为学之本矣。","book":"宋·朱熹《论语集注·学而》"}},{"id":25281,"word":"有则改之，无则加勉","pinyin":"yǒu zé gǎi zhī，wú zé jiā miǎn","abbr":"yzgzwzjm","explanation":"则：就；加：加以。对别人给自己指出的缺点错误，如果有，就改正，如果没有，就用来勉励自己。","source":{"text":"曾子以此三者日省其身，有则改之，无则加勉，其自治诚切如此，可谓得为学之本矣。","book":"《论语·学而》：“曾子曰：‘吾日三省吾身。’”宋·朱熹《集注》"},"example":{"text":"根据同学们所提的意见和批评，检查自己，～。"},"similar":["反躬自省","虚心纳谏"],"opposite":["文过饰非"],"usage":"作谓语、定语；用于劝诫人","story":["春秋时期，孔子的学生曾参勤奋好学，深得孔子的喜爱，同学问他为什么进步那么快。曾参说：“我每天都要多次问自己：替别人办事是否尽力？与朋友交往有没有不诚实的地方？先生教的学生是否学好？做到有则改之，无则加勉。”"]},{"id":25282,"word":"有则改之，无则嘉勉","pinyin":"yǒu zé gǎi zhī，wú zé jiā miǎn","abbr":"yzgzwzjm","explanation":"指凡有缺点错误被人指出应该改过，没缺点、错误就用以勉励自己。","example":{"text":"对于别人的意见，我们应该～。"}},{"id":25283,"word":"有初鲜终","pinyin":"yǒu chū xiǎn zhōng","abbr":"ycxz","explanation":"鲜：少。有开始却很少有结尾。指有始无终。","source":{"text":"靡不有初，鲜克有终。","book":"《诗经·大雅·荡》"},"example":{"text":"如顺帝此言，虽历代贤君无以过之，奈何～，行不顾言耶！","book":"蔡东藩《元史演义》第五十二回"},"similar":["有头无尾","有始无终"],"usage":"作谓语、定语；用于书面语"},{"id":25284,"word":"有利可图","pinyin":"yǒu lì kě tú","abbr":"ylkt","explanation":"图：谋取。有利益可谋求。","source":{"text":"等到有利可图，可否即允照办。","book":"清·无名氏《官场维新记》第六回"},"example":{"text":"只要政局上起点风潮，公债市场就受影响，我们做公债的就此～了。","book":"茅盾《子夜》八"},"opposite":["无利可图"],"usage":"作谓语、定语；指人或事情"},{"id":25285,"word":"有利无弊","pinyin":"yǒu lì wú bì","abbr":"ylwb","explanation":"只有好处，没有坏处。"},{"id":25286,"word":"有利有弊","pinyin":"yǒu lì yǒu bì","abbr":"ylyb","explanation":"有好的一面，也有坏的一面。","example":{"text":"凡事～，我们只须多加防范弊害的发生，不必因噎废食。"},"similar":["有一利必有一弊"],"usage":"作谓语、定语；用于处事"},{"id":25287,"word":"有功不赏，有劳不录","pinyin":"yǒu gōng bù shǎng，yǒu láo bù lù","abbr":"ygbsylbl","explanation":"功、劳：功劳，成绩；录：记录。对有的人，既不奖励，也不记录。形容赏罚不明。","example":{"text":"～，而搆陷愈急，毒谋愈肆。","book":"毛泽东《向国民党的十点要求》"}},{"id":25288,"word":"有功之臣","pinyin":"yǒu gōng zhī chén","abbr":"ygzc","explanation":"指有功劳的人。","source":{"text":"庶百姓知陛下宽仁大度，纳谏容流，而保护有功之臣。是一举两得之意，愿陛下准臣施行。","book":"明·许仲琳《封神演义》第二回"},"example":{"text":"他可是你的～。"},"usage":"作主语、宾语；指有功劳"},{"id":25289,"word":"有加无已","pinyin":"yǒu jiā wǔ yǐ","abbr":"yjwy","explanation":"已：停止。不断增加，没有停止。指不停地增加或事态发展越来越厉害。","source":{"text":"然而左右独以为不然，时以书相劳问，意有加而无已。","book":"《左传·昭公七年》：“寡君寝疾，于今三月矣，并走群望，有加而无瘳。”宋·陈亮《复杜伯高书》"},"example":{"text":"试想我们一年中生利之男子，应担负四十五元之人头税与外国，汝说可怕不可怕呢！这种人头税，还是～的。","book":"孙中山《民族主义》"},"similar":["与日俱增","有增无已"],"opposite":["每况愈下"],"usage":"作谓语、宾语；指只有超过"},{"id":25290,"word":"有加无损","pinyin":"yǒu jiā wǔ sǔn","abbr":"yjws","explanation":"损：减少。仍在增加，不见减少。","source":{"text":"又年疾日侵，有加无损，不任扶舆进路以塞元责。","book":"《三国志·魏志·管宁传》"},"example":{"text":"晛已避位，出居它所，病～，不能就位拜命，往复险远，非使者所宜往。","book":"清·毕沅《续资治通鉴》卷一百四十二"}},{"id":25291,"word":"有加无替","pinyin":"yǒu jiā wǔ tì","abbr":"yjwt","explanation":"替：止。只见不断增加，不见一刻停止。","source":{"text":"盖当时乃教授自署，毋亦选择而使以寓激劝与？抑因其亲爱，俾幼帅幼而入学者与？金氏因之，廪赐教育，有加无替。","book":"元·张中《庙学记》"},"example":{"text":"前中官尹庆还，言王恭待敕使，～。","book":"《明史·外国传》"}},{"id":25292,"word":"有加无瘳","pinyin":"yǒu jiā wǔ chōu","abbr":"yjwc","explanation":"瘳：减少。仍在增加，不见减少。","source":{"text":"寡君寝疾，于今三月矣，并走群望，有加而无瘳。","book":"《左传·昭公七年》"},"example":{"text":"经七日，王乃得疾。国医诊治，～。","book":"宋·释普济《五灯会元》卷一"}},{"id":25293,"word":"有劳有逸","pinyin":"yǒu láo yǒu yì","abbr":"ylyy","explanation":"工作与休息安排得合适恰当，劳逸均匀。","source":{"text":"歌发其所自和，舞发其所自乐，穷八荒，竭千钟，强发扬，课丝竹，则有劳有逸，岂合欢之意欤！","book":"唐·欧阳詹《鲁山令李胄宴僚吏序》"},"similar":["劳逸结合"],"usage":"作谓语、宾语；用于处事"},{"id":25294,"word":"有勇无谋","pinyin":"yǒu yǒng wú móu","abbr":"yywm","explanation":"只有勇气，没有计谋。指做事或打仗只是猛打猛冲，缺乏计划，不讲策略。","source":{"text":"（王）武俊蕃种，有勇无谋。","book":"唐·陆贽《论两河及淮西利害状》"},"example":{"text":"毕丰～，极贪酒色，不恤下人，喽罗尽皆离心。","book":"清·陈忱《水浒后传》第五回"},"similar":["匹夫之勇","暴虎冯河"],"opposite":["有勇有谋","大智大勇","智勇双全"],"usage":"作谓语、定语；指人莽撞"},{"id":25295,"word":"有勇有谋","pinyin":"yǒu yǒng yǒu móu","abbr":"yyym","explanation":"既勇敢，又有智谋。形容人智勇双全。","source":{"text":"黄文金见秀全议论不凡，从行的又皆有勇有谋的人物，更自叹服。","book":"清·黄小配《洪秀全演义》第八回"},"example":{"text":"肖飞虽然是心灵腿快，～，但是这个任务他总觉着有不小的困难。","book":"刘流《烈火金钢》第十二回"},"similar":["智勇双全","文武双全","大智大勇"],"opposite":["有勇无谋","无勇无谋"],"usage":"作谓语、定语；指人"},{"id":25296,"word":"有勇知方","pinyin":"yǒu yǒng zhī fāng","abbr":"yyzf","explanation":"有勇气且知道义。","source":{"text":"方，义方。","book":"语出《论语·先进》：“子路率尔而对曰：‘千乘之国……由也为之，比及三年，可使有勇，且知方也。’”何晏集解"},"example":{"text":"圣天子以大将嘱我，统尔三军，凡三军之士，各宜～，不负上意。","book":"《四游记·锺离将兵伐寇》"},"usage":"作谓语、定语；用于书面语"},{"id":25297,"word":"有去无回","pinyin":"yǒu qù wú huí","abbr":"yqwh","explanation":"只有出去的，没有回来的。","example":{"text":"我们叫你～。"},"similar":["有来无往"],"opposite":["有来有往"],"usage":"作宾语；指单程事物"},{"id":25298,"word":"有口无心","pinyin":"yǒu kǒu wú xīn","abbr":"ykwx","explanation":"嘴上说了，心里可没那样想。指不是有心说的。","source":{"text":"总属有口无心，安用设身处地。","book":"清·张南庄《何典·序》"},"example":{"text":"大爷快别动气，咱是个～的人，不会说话。","book":"清·李宝嘉《活地狱》第二回"},"similar":["信口开河"],"opposite":["言必有中"],"usage":"作谓语、定语、状语；带讽刺意味"},{"id":25299,"word":"有口无行","pinyin":"yǒu kǒu wú xíng","abbr":"ykwx","explanation":"有虚言而无德行。","source":{"text":"有其言无其行，君子耻之。","book":"《礼记·杂记下》"},"example":{"text":"内荒酒乐，出入无常，所与群居，皆～，或家之弃子，或朝之斥经，必有羊胜、伍被之变。","book":"《后汉书·史弼传》"},"similar":["言行不一"],"opposite":["言行一致"],"usage":"作谓语、定语；用于处事"},{"id":25300,"word":"有口皆碑","pinyin":"yǒu kǒu jiē bēi","abbr":"ykjb","explanation":"碑：指记功碑。所有人的嘴都是活的记功碑。比喻人人称赞。","source":{"text":"劝君不用镌顽石，路上行人口似碑。","book":"宋·释普济《五灯会元》卷十七"},"example":{"text":"宫保的政声，～，那是没有得说的。","book":"清·刘鹗《老残游记》第三回"},"similar":["口碑载道"],"opposite":["怨声载道","民怨沸腾"],"usage":"作谓语、宾语、定语；指人或事迹"},{"id":25301,"word":"有口莫辩","pinyin":"yǒu kǒu mò biàn","abbr":"ykmb","explanation":"虽然有嘴却不能分辨。指有冤难伸，或内情曲折复杂，难以说清楚。","source":{"text":"嗟予有口莫能辩，叹息但以两手扪。","book":"宋·欧阳修《菱溪大石》"},"example":{"text":"有手莫炙权门火，～荆山主。","book":"宋·黄庭坚《赠赵言》"}},{"id":25302,"word":"有口难分","pinyin":"yǒu kǒu nán fēn","abbr":"yknf","explanation":"分：分辩。虽然有嘴却难以分辩清楚。形容无法分辩清楚。","source":{"text":"直着我有口难分，进推无门。","book":"元·无名氏《杀狗劝夫》第一折"},"example":{"text":"钦派大臣查办，查了出来是他画的稿，此时～，不能说他不是通同作弊。","book":"清·李宝嘉《中国现在记》第一回"},"similar":["有口难辩"],"usage":"作谓语、宾语；指说不清"},{"id":25303,"word":"有口难开","pinyin":"yǒu kǒu nán kāi","abbr":"yknk","explanation":"有话不便开口说或不敢说。","source":{"text":"如今我们来拿你去见阎罗王，只教你有口难开。","book":"明·冯梦龙《喻世明言》第31卷"},"example":{"text":"我真是～，难以保持沉默吧。"},"similar":["有口难言","有口难张"],"usage":"作谓语、宾语、定语；指有难言之隐"},{"id":25304,"word":"有口难张","pinyin":"yǒu kǒu nán zhāng","abbr":"yknz","explanation":"有话不便开口说或不敢说。","example":{"text":"这事让我～。"},"similar":["有口难开"],"usage":"作谓语、宾语、定语；指有难言之隐"},{"id":25305,"word":"有口难言","pinyin":"yǒu kǒu nán yán","abbr":"ykny","explanation":"言：说。虽然有嘴，但话难以说出口。指有话不便说或不敢说。","source":{"text":"有道难行不如醉，有口难言不如睡。","book":"宋·苏轼《醉睡者》诗"},"example":{"text":"如今轮到你山阳县，这都是官吏每无心正法，使百姓～。","book":"元·关汉卿《窦娥冤》第三折"},"similar":["有口难分","有苦难言","难言之隐"],"usage":"作谓语、宾语、定语；指有难言之隐"},{"id":25306,"word":"有口难辩","pinyin":"yǒu kǒu nán biàn","abbr":"yknb","explanation":"虽然有口，却难以分辩清楚。常指含冤受屈但又无处申诉。","source":{"text":"孟夫人有口难辩，倒被他缠住身子，不好动身。","book":"明·冯梦龙《喻世明言》"},"example":{"text":"证据确凿，铁证如山，～，抓进牢去，判了十五年徒刑。","book":"张书绅《正气歌》"},"similar":["有口难言","有苦难言"],"usage":"作谓语、宾语、定语；指有难言之隐"},{"id":25307,"word":"有名亡实","pinyin":"yǒu míng wáng shí","abbr":"ymws","explanation":"光有空名，实际上并不是那样。同“有名无实”。","source":{"text":"臣敞非敢毁丞相也，诚恐群臣莫白，而长吏守丞畏指……并行伙貎，有名亡实。","book":"《汉书·循吏传·黄霸》"},"similar":["有名无实","盛名难副","徒有虚名"],"opposite":["名副其实"],"usage":"作谓语、宾语、定语；指名实不符"},{"id":25308,"word":"有名无实","pinyin":"yǒu míng wú shí","abbr":"ymws","explanation":"光有空名，实际上并不是那样。","source":{"text":"吾有卿之名而无其实。无以从二三子，吾是以忧，子贺我何故？","book":"《庄子·则阳》：“有名有实，是物之居；无名无实，在物之虚。”《国语·晋语八》"},"example":{"text":"多数政治，在将来或有做到的日子，但现在却是～的。","book":"清·梁启超《新中国未来记》第三回"},"similar":["名不副实","名过其实"],"opposite":["名不虚传","名副其实"],"usage":"作谓语、宾语、定语；指名实不符","story":["春秋时期，晋国大夫叔向去见韩宣子，韩宣子正为贫穷而犯愁。叔向祝贺他，他不解地说：“吾有卿之名，而无其实。”叔向将他比做晋国上卿栾武子那样不贪钱财坚持仁政，连北方的戎狄部族都来归顺他，贫穷也是财富。韩宣子十分感激"]},{"id":25309,"word":"有名有利","pinyin":"yǒu míng yǒu lì","abbr":"ymyl","explanation":"既有名誉又有利益。","example":{"text":"谁都想做～的事情。"},"similar":["名利双收"],"usage":"作谓语、定语；用于事情"},{"id":25310,"word":"有名有姓","pinyin":"yǒu míng yǒu xìng","abbr":"ymyx","explanation":"指事物有根据，可以考证。","source":{"text":"这个人有名有姓，姓武名松，排行第二。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"example":{"text":"这个容易，他们下山不久，一定追得上。那总兵～，一查便知。","book":"金庸《鹿鼎记》第二十三回"}},{"id":25311,"word":"有命无运","pinyin":"yǒu mìng wú yùn","abbr":"ymwy","explanation":"指命虽好，运气却不好。","example":{"text":"她感叹自己～，不再奢求了。"},"usage":"作谓语、定语；用于口语"},{"id":25312,"word":"有嘴无心","pinyin":"yǒu zuǐ wú xīn","abbr":"yzwx","explanation":"犹言有口无心。指不是有心说的。","source":{"text":"别是宝玉有嘴无心，傻子似的从没个忌讳，高兴了信嘴胡说也是有的。","book":"清·曹雪芹《红楼梦》第78回"},"example":{"text":"她是～的人，不要跟她别一般见识。"},"similar":["有口无心"],"opposite":["言必有中"],"usage":"作谓语、定语；指人嘴快"},{"id":25313,"word":"有嘴没心","pinyin":"yǒu zuǐ méi xīn","abbr":"yzmx","explanation":"指不是有心说的。同“有嘴无心”。"},{"id":25314,"word":"有嘴没舌","pinyin":"yǒu zuǐ méi shé","abbr":"yzms","explanation":"形容不善言辞。","example":{"text":"这孩子～的，不会说话。"},"similar":["笨嘴拙舌"],"opposite":["伶牙俐齿"],"usage":"作谓语、定语；指人说话"},{"id":25315,"word":"有国难投","pinyin":"yǒu guó nán tóu","abbr":"ygnt","explanation":"有国家却不能回去。","source":{"text":"我这里叫尽屈有谁来分剖，送的我眼睁睁有国难投。","book":"元·无名氏《马陵道》第二折"},"example":{"text":"则为我攀花折柳，致令的～。","book":"元·无名氏《百花亭》第二折"},"similar":["有家难奔"],"usage":"作谓语、定语；用于人的处境"},{"id":25316,"word":"有增无减","pinyin":"yǒu zēng wú jiǎn","abbr":"yzwj","explanation":"事物的量或程度只是增长、加深，而不减少、降低。","source":{"text":"而所患沈顿，有增无损。","book":"《晋书·谢安传》"},"example":{"text":"明·冯梦龙《醒世恒言》第七卷：“大官人休说满话！常言道：恶龙不斗地头蛇。你的从人虽多，怎比得坐地的～。”"},"similar":["有增无损"],"usage":"作谓语、状语、宾语；用于书面语"},{"id":25317,"word":"有增无已","pinyin":"yǒu zēng wú yǐ","abbr":"yzwy","explanation":"不断增加或不断扩展。","source":{"text":"首先是美国教士向驻京美使发电报告说‘抢劫纵火及暗杀之事，有增无已……’","book":"范文澜《中国近代史》上册第八章"},"similar":["有加无已"],"usage":"作谓语、宾语；指只有超过"},{"id":25318,"word":"有增无损","pinyin":"yǒu zēng wú sǔn","abbr":"yzws","explanation":"损：损害，减少。仍在增加，不见减少。指事物向着某个方面不断深化。","source":{"text":"而所患沈顿，有增无损。","book":"《晋书·谢安传》"},"similar":["有增无减"],"usage":"作谓语、状语、宾语；用于书面语"},{"id":25319,"word":"有声无实","pinyin":"yǒu shēng wú shí","abbr":"ysws","explanation":"犹言有名无实。光有空名，实际上并不是那样。","source":{"text":"今若基宇不修，仍同丘畎，即使高皇神享，阙于国阳，宗事之典，有声无实，此臣子所以匪宁，亿兆所以失望也。","book":"《魏书·李崇传》"},"similar":["有名无实","盛名难副"],"opposite":["名副其实"],"usage":"作谓语、定语；用于书面语"},{"id":25320,"word":"有声无气","pinyin":"yǒu shēng wú qì","abbr":"yswq","explanation":"①形容人气息奄奄。②形容说话无精打采。","source":{"text":"王禄多说了几句话，渐渐有声无气，挨到黄昏，只有出的气，没有入的气，呜呼哀哉，伏维尚飨。","book":"明·凌濛初《二刻拍案惊奇》卷二十一"},"example":{"text":"她往年说话，～；现在她一开口，隔巷也能听到她的声音。","book":"《花城》1981年第5期"},"usage":"作谓语、状语、定语；用于说话等"},{"id":25321,"word":"有声有情","pinyin":"yǒu shēng yǒu qíng","abbr":"ysyq","explanation":"形容其声感人至深。","source":{"text":"盖其得名，在《长恨歌》一篇。其事本易传，以易传之事，为绝妙之词，有声有情，可歌可泣，文人学士既叹为不可及，妇人女子亦喜闻而乐诵之。","book":"清·赵翼《瓯北诗话·白香崇山峻岭诗》"}},{"id":25322,"word":"有声有泪","pinyin":"yǒu shēng yǒu lèi","abbr":"ysyl","explanation":"形容表现得凄婉动人。","example":{"text":"昔人云：传神写照，在阿堵中。老莲写文姬，便令缣素～。","book":"宋祖谦《赖古堂名贤尺牍新钞·与陈章侯》"}},{"id":25323,"word":"有声有色","pinyin":"yǒu shēng yǒu sè","abbr":"ysys","explanation":"形容说话或表演精彩生动。","source":{"text":"写月有声有色如此，后人复何着笔耶？","book":"清·洪亮吉《北江诗话》卷一"},"example":{"text":"叙得头头是道，已经不易，叙得～，更难。","book":"朱自清《经典常谈·春秋三传第六》"},"similar":["绘声绘色"],"opposite":["无声无息"],"usage":"作定语、状语、补语；形容说话、表演等"},{"id":25324,"word":"有声没气","pinyin":"yǒu shēng méi qì","abbr":"ysmq","explanation":"形容说话无精打采。同“有声无气”。","source":{"text":"林先生叹了一口气，过了一会儿，方才有声没气地说道：‘让我死在那边就是了……’","book":"茅盾《林家铺子》六"},"similar":["有声无气"],"usage":"作状语；指有气无力"},{"id":25325,"word":"有备则制人，无备则制于人","pinyin":"yǒu bèi zé zhì rén，wú bèi zé zhì yú rén","abbr":"ybzzrwbzzyr","explanation":"有所准备就能控制别人，毫无准备就会被别人所控制。","source":{"text":"故龟猖有介，狐貉不能禽；蝮蛇有螫，人忌而不轻。故有备则制人，无备则制于人。","book":"汉·桓宽《盐铁论·险固》"}},{"id":25326,"word":"有备无患","pinyin":"yǒu bèi wú huàn","abbr":"ybwh","explanation":"患：祸患，灾难。事先有准备，就可以避免祸患。","source":{"text":"居安思危，思则有备，有备无患。","book":"《尚书·说命中》：“惟事事，乃其有备，有备无患。”《左传·襄公十一年》"},"example":{"text":"季斯预戒汶上百姓，修堤盖屋。不三日，果然天降大雨，汶水泛滥，鲁民～。","book":"明·冯梦龙《东周列国志》第七十八回"},"similar":["未雨绸缪","防患未然","有恃无恐"],"opposite":["措手不及","临阵磨枪","临渴掘井"],"usage":"作谓语、定语；用于劝诫人","story":["春秋时期，晋宋等12国联合攻打郑国，郑国只好向晋国求和。郑国给晋国送去金钱珠宝美女等。晋悼公就把贡品分给大臣享乐。大臣魏绛劝谏晋悼公不要只图享乐，要居安思危，有备无患。晋悼公认为他言之有理，就采纳他的建议"]},{"id":25327,"word":"有天无日","pinyin":"yǒu tiān wú rì","abbr":"ytwr","explanation":"比喻说话毫无畏惧和顾忌。也比喻十分黑暗，没有公理。","source":{"text":"元来个梁山泊有天无日。","book":"元·康进之《李逵负荆》第二折"},"example":{"text":"你们上自皇帝、藩王，下至文武百官……敲剥百姓，弄得～，世道不象世道。","book":"姚雪垠《李自成》第二卷第五十三章"},"similar":["有天没日","无法无天","暗无天日"],"opposite":["云开见日","乾坤朗朗"],"usage":"作谓语、定语；指人说话等","story":["焦大对贾府的祖辈有救命之恩，他曾出生入死保护主子，宁可自己喝马尿。焦大因此在贾府居功自傲，经常看不起其他奴才。他骂贾蓉他们每日偷鸡摸狗，贾府扒灰养小叔子。奴才们听到这些有天没日的话，吓得魂飞魄散，急忙把他捆起来"]},{"id":25328,"word":"有天无日头","pinyin":"yǒu tiān wú rì tóu","abbr":"ytwrt","explanation":"比喻横行不法，公理难行，一片黑暗。","source":{"text":"一朝撑出马前去，真个有天无日头。","book":"元·祖柏《赋盖》"},"example":{"text":"说话的，若如此，真是～的事了。","book":"明·凌濛初《初刻拍案惊奇》卷三十六"}},{"id":25329,"word":"有天没日","pinyin":"yǒu tiān méi rì","abbr":"ytmr","explanation":"比喻说话毫无畏惧和顾忌。也比喻十分黑暗，没有公理。","source":{"text":"元来个梁山泊有天无日。","book":"元·康进之《李逵负荆》第二折"},"example":{"text":"众小厮见说出来的话～的，吓得魂飞魄丧，把他捆起来。","book":"清·曹雪芹《红楼梦》第七回"},"similar":["口无遮拦","有天无日"],"usage":"作谓语、定语；指人说话等","story":["焦大对贾府的祖辈有救命之恩，他曾出生入死保护主子，宁可自己喝马尿。焦大因此在贾府居功自傲，经常看不起其他奴才。他骂贾蓉他们每日偷鸡摸狗，贾府扒灰养小叔子。奴才们听到这些有天没日的话，吓得魂飞魄散，急忙把他捆起来"]},{"id":25330,"word":"有天没日头","pinyin":"yǒu tiān méi rì tóu","abbr":"ytmrt","explanation":"比喻无稽言行。同“有天无日”。","source":{"text":"真个有天没日头，宋《神童诗》也。","book":"明·郎瑛《七修续稿·诗文·俗语本诗句》"},"example":{"text":"就屈杀了奴罢了，是那个不逢好死的……拿这～的事压枉奴。就是你与的簪子，都有数儿，一五一十都在。","book":"《金瓶梅词话》第十二回"},"similar":["有天没日","有天无日头","有天无日"],"usage":"作宾语、定语；多用于口语"},{"id":25331,"word":"有头无尾","pinyin":"yǒu tóu wú wěi","abbr":"ytww","explanation":"有开头没有收尾。指没有把事情做完。","source":{"text":"若是有头无尾底人，便是忠也不久。","book":"宋·释普济《五灯会元》卷五：“曰：‘有头无尾时如何？’师曰：‘吐得黄金堪作什么？’”《朱子语类》"},"example":{"text":"倘若不幸而至于～，你又有颁布者什么说？","book":"蔡东藩、许廑父《民国通俗演义》第一四五回"},"similar":["虎头蛇尾","有始无终"],"opposite":["自始至终"],"usage":"作谓语、定语、状语；指人办事"},{"id":25332,"word":"有头无脑","pinyin":"yǒu tóu wú nǎo","abbr":"ytwn","explanation":"形容蠢人。"},{"id":25333,"word":"有头有尾","pinyin":"yǒu tóu yuǒ wěi","abbr":"ytyw","explanation":"既有形状，又有结尾。形容结构很完整或办事有始有终。","source":{"text":"斐然一章，也是自成一家了，做得一章有头有尾。","book":"宋·朱熹《朱子语类·论语》卷二十九"},"example":{"text":"却才说不了，他便是真大丈夫，～，有始有终，我如今只等病好时，便去投奔他。","book":"明·施耐庵《水浒全传》第二十二回"},"similar":["有始有终","自始自终"],"opposite":["虎头蛇尾","有始无终"],"usage":"作谓语、定语、状语；用于处事"},{"id":25334,"word":"有头有脑","pinyin":"yǒu tóu yǒu nǎo","abbr":"ytyn","explanation":"比喻有头绪，有条理。"},{"id":25335,"word":"有头有脸","pinyin":"yǒu tóu yǒu liǎn","abbr":"ytyl","explanation":"有面子；头面人物。","source":{"text":"‘是！’有个‘有头有脸’的尖丁答应一声。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"他是一个～的人物。"},"similar":["有头有面"],"usage":"作谓语、定语；指头面人物"},{"id":25336,"word":"有头没尾","pinyin":"yǒu tóu méi wěi","abbr":"ytmw","explanation":"有开头没有收尾。指没有把事情做完。","source":{"text":"此人只事有头无尾，有始无终。","book":"唐·释慧然《临济慧照禅师语录》"},"example":{"text":"他内官性儿，～。等他性儿坦些，也都从轻处就是了。","book":"明·兰陵笑笑生《金瓶梅词话》第五十五回"}},{"id":25337,"word":"有头没脑","pinyin":"yǒu tóu méi nǎo","abbr":"ytmn","explanation":"形容心神不定，言行丢三落四。","source":{"text":"如痴如呆，有头没脑，说着东边，认着西边。","book":"明·凌濛初《二刻拍案惊奇》第38卷"},"similar":["有头无脑"],"usage":"作谓语、定语、状语；用于处事等"},{"id":25338,"word":"有女怀春","pinyin":"yǒu nǚ huái chūn","abbr":"ynhc","explanation":"指少女爱慕异性。","source":{"text":"野有死麇，白茅包之。有女怀春，吉士诱之。","book":"《诗·召南·野有死麇》"},"example":{"text":"也终须石见水清，今日且休猜～。","book":"明·梅鼎祚《玉合记·参成》"},"usage":"作宾语、定语；用于书面语"},{"id":25339,"word":"有奶便是娘","pinyin":"yǒu nǎi biàn shì niáng","abbr":"ynbsn","explanation":"比喻贪利忘义，谁给好处就投靠谁。","example":{"text":"他就是～的人。"},"similar":["见利忘义"],"usage":"作谓语、宾语、定语；指见利忘义的人"},{"id":25340,"word":"有如大江","pinyin":"yǒu rú dà jiāng","abbr":"yrdj","explanation":"指着长江起誓以显示自己的诚意和可信。","source":{"text":"若君必效忠节，以解疑议，登身朝到，夕召兵还，此言之诚，有如大江。","book":"《三国志·吴志·吴主传》"}},{"id":25341,"word":"有如白水","pinyin":"yǒu rú bái shuǐ","abbr":"yrbs","explanation":"指以黄河为誓，象滚滚的黄河水一样，永不改变初衷。","source":{"text":"公子曰：所不与舅氏同心者，有如白水！","book":"《左传·僖公二十四年》"},"example":{"text":"耿耿此心，～，特电布悃，诸希亮察。","book":"刘凤舞《民国春秋》第三十七章"}},{"id":25342,"word":"有如皎日","pinyin":"yǒu rú jiǎo rì","abbr":"yrjr","explanation":"皎日：白日。表示对天发誓，以显示自己可以信赖和一片诚意。","source":{"text":"穀则异室，死则同穴；谓予不信，有如皦日。","book":"《诗经·王风·大车》"},"example":{"text":"对遗民、～。行万里、依然故物。","book":"宋·陈亮《三部乐·七月送丘宗卿使虏》词"}},{"id":25343,"word":"有如皦日","pinyin":"yǒu rú jiǎo rì","abbr":"yrjr","explanation":"皦日：白日。表示对天发誓，以显示自己可以信赖和一片诚意。","source":{"text":"穀则异室，死则同穴；谓予不信，有如皦日。","book":"《诗经·王风·大车》"}},{"id":25344,"word":"有始无终","pinyin":"yǒu shǐ wú zhōng","abbr":"yswz","explanation":"有开始没有结尾。指做事不做到底。","source":{"text":"小人有始无终，不能如贯高之流也。","book":"《晋书·刘聪载记》"},"example":{"text":"我们做事情不要～，半途而废。"},"similar":["有头无尾","虎头蛇尾"],"opposite":["善始善终","有始有终"],"usage":"作谓语、定语、宾语；指人办事"},{"id":25345,"word":"有始有卒","pinyin":"yǒu shǐ yǒu zú","abbr":"ysyz","explanation":"指做事能贯彻始终，坚持到底。","source":{"text":"有始有卒者，其唯圣人乎？","book":"《论语·子张》"},"example":{"text":"后十余年，忽下山归其家，复与妻子如旧……嗟乎，～者难矣哉！","book":"元·刘祁《归潜志》卷五"},"similar":["有始有终","善始善终"],"opposite":["有头无尾","有始无终"],"usage":"作谓语、定语、状语；用于处事"},{"id":25346,"word":"有始有终","pinyin":"yǒu shǐ yǒu zhōng","abbr":"ysyz","explanation":"有开头也有收尾。指做事能坚持到底。","source":{"text":"伏愿天地成造，有始有终，矜臣疲病，乞臣骸骨。","book":"《论语·子张》：“有始有卒者，其惟圣人乎！”《魏书·袁翻传》"},"example":{"text":"同学之间要～地保持友好关系。"},"similar":["有头有尾","有始有卒"],"opposite":["有始无终","有头无尾","虎头蛇尾"],"usage":"作谓语、定语、宾语、状语；指人办事","story":["春秋时期，孔子的学生子游看不起子夏的门人，认为他们只会教最低等的学问。子夏叹息道：君子教人的道理应该有先后次序，好比草木必须一一分类清楚，不能随心所欲乱教？只有圣人才能做到说了开头就能知道末尾"]},{"id":25347,"word":"有子存焉","pinyin":"yǒu zǐ cún yān","abbr":"yzcy","explanation":"焉：表示陈述的语气词。有儿子在。","source":{"text":"虽我之死，有子存焉。","book":"战国·郑·列御寇《列子·汤问》"},"usage":"作谓语；指还有继承人"},{"id":25348,"word":"有害无利","pinyin":"yǒu hài wú lì","abbr":"yhwl","explanation":"只有坏处没有好处。","source":{"text":"子牙曰：‘尚占运命，主今日不好，有害无利，有凶无吉。’","book":"明·许仲琳《封神演义》第十七回"},"example":{"text":"明知～，讵敢轻於一试。","book":"《清史稿·徐广缙传》"},"similar":["有百害而无一利","有害无益"],"opposite":["有益无害"],"usage":"作谓语、定语、宾语；用于坏人坏事等"},{"id":25349,"word":"有害无益","pinyin":"yǒu hài wú yì","abbr":"yhwy","explanation":"有坏处没有好处。","source":{"text":"也必须经过民主斗争或合法手续，才能加以逮捕与处理，否则有害无益。","book":"邓小平《党与抗日民主政权》"},"similar":["有害无利"],"opposite":["有益无害"],"usage":"作谓语、定语、宾语；用于坏人坏事等"},{"id":25350,"word":"有家难奔","pinyin":"yǒu jiā nán bēn","abbr":"yjnb","explanation":"由于种种原因，有家却不能回去。","source":{"text":"你可为甚么切齿嚼牙根，这是你自做的来有家难奔。","book":"元·秦简夫《东堂老》第四折"},"example":{"text":"明·冯梦龙《醒世恒言》第37卷：“弄得我～，有国难投，叫我怎处？”"},"similar":["有国难投"],"usage":"作谓语、定语；用于人的处境"},{"id":25351,"word":"有尺水行尺船","pinyin":"yǒu chǐ shuǐ xíng chǐ chuán","abbr":"ycsxcc","explanation":"指量力而行。","source":{"text":"我且‘有尺水行尺船’，等什么鹰神再来，我再做道理。","book":"《醒世姻缘》第65回"},"example":{"text":"我们都明白～，不会乱来的。"},"usage":"作宾语、定语、分句；用于处事"},{"id":25352,"word":"有屈无伸","pinyin":"yǒu qū wú shēn","abbr":"yqws","explanation":"指蒙受冤枉而无从申诉。","source":{"text":"想当日酷刑害逢危遭困，您那一日便逼的我有屈无伸。","book":"明·无名氏《女姑姑》第四折"},"usage":"作谓语、定语；用于书面语"},{"id":25353,"word":"有己无人","pinyin":"yǒu jǐ wú rén","abbr":"yjwr","explanation":"自私自利，只顾自己，不顾别人。","source":{"text":"虽是小事，显见有己无人，贪心不死。","book":"清·无垢道人《八仙全传》第19回"},"example":{"text":"～的处事方式没人能接受"},"similar":["有我无人"],"usage":"作谓语、定语；用于处事"},{"id":25354,"word":"有年无月","pinyin":"yǒu nián wú yuè","abbr":"ynwy","explanation":"指日子拖得长久，没有确定的期限。","source":{"text":"百姓又怕当兵，最怕输粮……舟子车夫，又没有多少工资，统皆畏缩不前，眼见得有年无月，不能成事。","book":"蔡东藩《后汉演义》第二回"},"usage":"作定语、状语；用于书面语"},{"id":25355,"word":"有幸不幸","pinyin":"yǒu xìng bù xìng","abbr":"yxbx","explanation":"有幸运的，有不幸运的。指人和事物的遭遇各有不同。","source":{"text":"当时山林田亩，潜德隐行君子，不闻于世者多矣，而贱工末艺得所附托，乃垂于不朽，盖其各有幸不幸也。","book":"宋·欧阳修《六一诗话》"},"example":{"text":"而俚言俗说，猥有存者，亦其～者欤？","book":"《明史·艺文志》"}},{"id":25356,"word":"有幸有不幸","pinyin":"yǒu xìng yǒu bù xìng","abbr":"yxybx","explanation":"有幸运的时候，有不幸的时候。指人的遭遇不同","source":{"text":"仆韩愈《淮西碑》而用段文昌，韩遂以仆碑得名。人之有幸有不幸，亦文之有幸有不幸也。","book":"清·梁绍壬《两般秋雨庵随笔》第六卷"},"usage":"作谓语、定语；用于书面语"},{"id":25357,"word":"有度有识","pinyin":"yǒu dù yǒu shí","abbr":"ydys","explanation":"度：度量；识：见识。既有宽广的胸怀，能容纳别人的意见，又有广博的学识和主张。","source":{"text":"详审斟酌，斯为有度有识之将也。","book":"明·吴惟顺《兵镜吴子十三篇》"}},{"id":25358,"word":"有张有弛","pinyin":"yǒu zhāng yǒu chí","abbr":"yzyc","explanation":"意思是宽严相结合，是文王武王治理国家的方法。现用来比喻生活的松紧和工作的劳逸要合理安排。","source":{"text":"张而不弛，文武弗能也；弛而不张，文武弗为也。一张一弛，文武之道也。","book":"《礼记·杂记下》"},"example":{"text":"他也是个很会调整脑力的人，～，弦不绷得过紧。","book":"刘绍棠《二月梅》七"}},{"id":25359,"word":"有形可检，有数可推","pinyin":"yǒu xíng kě jiǎn，yǒu shù kě tuī","abbr":"yxkjyskt","explanation":"推：推求。有形迹可检验，有数据可推求","source":{"text":"迟疾之率，非出神怪，有形可检，有数可推。","book":"南朝·宋·祖冲之《辨戴法兴难新历》"},"usage":"作宾语、定语；用于书面语"},{"id":25360,"word":"有影无形","pinyin":"yǒu yǐng wú xíng","abbr":"yywx","explanation":"有影子而不见形迹。比喻没有实际根据的谣传。","source":{"text":"若是回廊下没揣的见俺可憎，将他来紧紧的搂定；只问你那会少离多，有影无形。","book":"元·王实甫《西厢记》第一本第三折"},"example":{"text":"才搬到这里来的时候，王福天天到道里去，回来之后，～，乱吹上一泡。","book":"清·李宝嘉《官场现形记》第五十回"}},{"id":25361,"word":"有影无踪","pinyin":"yǒu yǐng wú zōng","abbr":"yywz","explanation":"只有来的影子没有去的踪迹。","example":{"text":"这是～的事。"},"usage":"作谓语、定语；用于事情"},{"id":25362,"word":"有征无战","pinyin":"yǒu zhēng wú zhàn","abbr":"yzwz","explanation":"指不战而胜。","source":{"text":"言宣帝致讨吴方，有征无战也。","book":"《晋书·乐志下》"},"example":{"text":"圣母覆物仁慈，挽回和气，故能～。","book":"清·袁枚《为王太保贺平大金川表》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":25363,"word":"有心人","pinyin":"yǒu xīn rén","abbr":"yxr","explanation":"有某种想法，肯动脑筋的人。","source":{"text":"我看卢兄有心人，或别有深意亦未可知。","book":"清·荑荻散人《玉娇梨》第15回"},"example":{"text":"俗话说：世上无难事，只怕～。"},"usage":"作宾语、定语；用于口语"},{"id":25364,"word":"有心无力","pinyin":"yǒu xīn wú lì","abbr":"yxwl","explanation":"有愿望和打算，但没有力量付诸实现。","source":{"text":"贫道必当尽诚上答，正恐有心无力耳。","book":"南朝·梁·惠皎《高僧传·义解·竺法旷》"},"example":{"text":"李惠翁，你既然有这门路，就赶快去找保人罢，兄弟是～，对不起。","book":"茅盾《多角关系》"},"similar":["力不从心"],"usage":"作谓语、宾语、定语；用于处事"},{"id":25365,"word":"有心有意","pinyin":"yǒu xīn yǒu yì","abbr":"yxyy","explanation":"犹言诚心诚意。形容十分真挚诚恳。"},{"id":25366,"word":"有心没想","pinyin":"yǒu xīn méi xiǎng","abbr":"yxmx","explanation":"指没有情绪，心思不佳。","source":{"text":"所以做生意时，都有心没想，固执了些。","book":"明·东鲁古狂生《醉醒石》第十四回"}},{"id":25367,"word":"有志不在年高","pinyin":"yǒu zhì bù zài nián gāo","abbr":"yzbzng","explanation":"指年轻人只要有志向，成就不可限量，不在年纪大。也指只要有志向，岁数大了，也可以干出一番事业。","source":{"text":"樵子抚掌大笑不止，对子牙点头叹曰：‘有志不在年高，无谋空言百岁。’","book":"明·许仲琳《封神演义》第二十三回"},"example":{"text":"常言说得好：～。我那一桩赶得上姑奶奶？（清·李宝嘉《官场现形记》第三十八回）"},"usage":"作宾语、分句；指好少年"},{"id":25368,"word":"有志之士","pinyin":"yǒu zhì zhī shì","abbr":"yzzs","explanation":"士：对人的尊称。指有理想有抱负的人。","source":{"text":"惟其生于后世，学绝道丧，异端邪说充塞弥满，遂使有志之士罹此患害，乃与世间凡庸恣情纵欲之人均其陷溺，此岂非以学术杀天下哉。","book":"宋·陆九渊《与曾宅之书》"},"example":{"text":"此洪君是广东～，与弟莫逆交，都不用客气。","book":"清·黄小配《洪秀全演义》第五回"},"similar":["有识之士"],"usage":"作宾语；指有抱负的人"},{"id":25369,"word":"有志事竟成","pinyin":"yǒu zhì shì jìng chéng","abbr":"yzsjc","explanation":"只要有决心，有毅力，事情终究会成功。","source":{"text":"将军前在南阳，建此大策，常以为落落难合，有志者事竟成也。","book":"《后汉书·耿弇传》"}},{"id":25370,"word":"有志无时","pinyin":"yǒu zhì wú shí","abbr":"yzws","explanation":"有抱负而时运不济。","source":{"text":"汉有逸人，姓赵名嘉。有志无时，命也奈何！","book":"《后汉书·赵歧传》"},"similar":["怀才不遇"],"usage":"作谓语、定语；用于处事"},{"id":25371,"word":"有志竟成","pinyin":"yǒu zhì jìng chéng","abbr":"yzjc","explanation":"竟：终于。只要有决心，有毅力，事情终究会成功。","source":{"text":"将军前在南阳，建此大策，常以为落落难合，有志者事竟成也。","book":"《后汉书·耿弇传》"},"example":{"text":"改日须醵公分，畅谈一日，以贺素兄～也。","book":"清·夏敬渠《野叟曝言》第一百四十六回"},"similar":["有志者事竟成"],"usage":"作宾语、定语；用于夸奖人","story":["东汉初年，大将耿渰奉光武帝刘秀的命令去平定张步的叛乱，在战斗中不小心中了对方一箭。他咬紧牙关，带伤继续战斗，士兵们深受鼓舞，最终打败了张步。刘秀称赞他说：“你取得最终胜利，真是有志者事竟成啊！”"]},{"id":25372,"word":"有志者事竟成","pinyin":"yǒu zhì zhě shì jìng chéng","abbr":"yzzsjc","explanation":"只要有决心，有毅力，事情终究会成功。","source":{"text":"将军前在南阳，建此大策，常以为落落难合，有志者事竟成也。","book":"《后汉书·耿弇传》"},"example":{"text":"周老夫妻见了媳妇一表人物，两心快乐。方信国能起初不肯娶妻，毕竟寻出好姻缘来，所谓～也。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"similar":["有志竟成"],"usage":"作分句、宾语；指人","story":["东汉初年，大将耿渰奉光武帝刘秀的命令去平定张步的叛乱，在战斗中不小心中了对方一箭。他咬紧牙关，带伤继续战斗，士兵们深受鼓舞，最终打败了张步。刘秀称赞他说：“你取得最终胜利，真是有志者事竟成啊！”"]},{"id":25373,"word":"有志难酬","pinyin":"yǒu zhì nán chóu","abbr":"yznc","explanation":"胸中的抱负难以实现。","source":{"text":"有一等要读书的家私簿，更无钱办束脩，因此上有志难酬。","book":"元·无名氏《九世同居》第二折"},"usage":"作谓语、定语、宾语；用于处事"},{"id":25374,"word":"有忝祖德","pinyin":"yǒu tiǎn zǔ dé","abbr":"ytzd","explanation":"有愧于祖宗的德行，辱没了祖宗的声誉。","example":{"text":"孔乙己没有考上秀才，他认为自己～。"},"usage":"作谓语、定语；用于口语"},{"id":25375,"word":"有恃不恐","pinyin":"yǒu shì bù kǒng","abbr":"ysbk","explanation":"恃：倚仗。有所依靠而不害怕。","source":{"text":"君子有所恃而不恐，小人有所畏而不为。","book":"《左传·僖公二十六年》：“室如悬罄，野无青草，何恃而不恐？”宋·苏轼《祭欧阳文忠公文》"},"example":{"text":"后来这位瑞方伯到了任，他们从前在京都的时候是有交情的，因此～，就格外的放肆。","book":"清·王浚卿《冷眼观》第三回"}},{"id":25376,"word":"有恃无恐","pinyin":"yǒu shì wú kǒng","abbr":"yswk","explanation":"恃：倚仗，依靠；恐：害怕。因为有所依杖而毫不害怕，或毫无顾忌。","source":{"text":"室如悬罄，野无青草，何恃而不恐？","book":"《左传·僖公二十六年》"},"example":{"text":"我们实在还有一个更正大的理由使自己有恃而无恐。","book":"闻一多《演讲录·民盟的性质与作风》"},"similar":["仗势欺人","狗仗人势","有恃毋恐"],"opposite":["胆小怕事"],"usage":"作谓语、定语、宾语；指人仗势","story":["春秋时期，齐孝公想做霸主，趁鲁国发生灾荒出兵。鲁僖公派大臣展喜去边境劝阻，齐孝公讥笑鲁国是“室如悬罄，野无青草，何恃而不恐？”展喜晓之以理、动之以情说“恃先王之命”，希望齐孝公退兵，齐孝公自知理亏就退兵"]},{"id":25377,"word":"有恃毋恐","pinyin":"yǒu shì wú kǒng","abbr":"yswk","explanation":"因为有所依杖而毫不害怕，或毫无顾忌。同“有恃无恐”。","source":{"text":"临敌之时……地势、敌情了如指掌，绘图遍示，使一军谙悉情形，有恃毋恐，故战胜攻取如响应声。","book":"郑观应《盛世危言·练兵》"},"similar":["有恃无恐","有所恃而不恐"],"opposite":["瞻前顾后"],"usage":"作谓语、定语、宾语；指人仗势"},{"id":25378,"word":"有情人终成眷属","pinyin":"yǒu qíng rén zhōng chéng juàn shǔ","abbr":"yqrzcjs","explanation":"眷属：亲属。彼此有情爱的人终于结为夫妻。","source":{"text":"永老无别离，万古常完聚，愿天下有情的都成了眷属。","book":"元·王实甫《西厢记》第五本第四折"}},{"id":25379,"word":"有情有义","pinyin":"yǒu qíng yǒu yì","abbr":"yqyy","explanation":"对人有深厚感情和情义。","source":{"text":"后来细细访问，方知果然不是拐子，倒是一个有情有义的好人。","book":"清·名教中人《好逑传》第12回"},"example":{"text":"她是一个～的人。"},"similar":["情深义重"],"opposite":["无情无义"],"usage":"作谓语、定语；指人有情义"},{"id":25380,"word":"有情有意","pinyin":"yǒu qíng yǒu yì","abbr":"yqyy","explanation":"形容情义深厚。","source":{"text":"后来细细访问，方知果然不是拐子，倒是一个有情有意的拐子。","book":"清·明教中人《好逑传》第十二回"},"example":{"text":"虽是无根无凭，却是～。","book":"王安忆《长恨歌》第一部第一章"}},{"id":25381,"word":"有惊无险","pinyin":"yǒu jīng wú xiǎn","abbr":"yjwx","explanation":"虽受到惊吓但还是安全脱离险境。"},{"id":25382,"word":"有意无意","pinyin":"yǒu yì wú yì","abbr":"yywy","explanation":"又像是有意的，又像是无意的。存心与不经意。","source":{"text":"庾子嵩作意赋成，从子文康见，问曰：若有意邪？非赋之所尽，若无意邪？复何所赋？答曰：正在有意无意之间。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"若以～可解不可解间求之，不免此诗第一耳。”","book":"明·王世贞《艺苑卮言》卷四"},"usage":"作宾语、定语、状语；指人的意识"},{"id":25383,"word":"有意无意之间","pinyin":"yǒu yì wú yì zhī jiān","abbr":"yywyzj","explanation":"形容自然率真，不是曲意雕琢。","source":{"text":"庾子嵩作《意赋》成，从子文康见问曰：‘若有意邪，非赋之所尽，若无意邪，复何所赋？’答曰：‘正在有意无意之间。’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"又庾子嵩作《意赋》成，为文康所难，而云：“正在～。”","book":"明·王世贞《艺苑卮言》卷三"}},{"id":25384,"word":"有我无人","pinyin":"yǒu wǒ wú rén","abbr":"ywwr","explanation":"极言其自傲而轻视他人。","source":{"text":"[朱温]到了难星已过，依然趾高气扬，有我无人。","book":"蔡东藩《五代史演义》第二回"},"similar":["自私自利","有己无人"],"opposite":["大公无私"],"usage":"作谓语、定语；用于处事"},{"id":25385,"word":"有所不为","pinyin":"yǒu suǒ bù wéi","abbr":"ysbw","explanation":"指人的精力是有限的，只有放弃一些事情不做，才能在别的一些事情上做出成绩。","source":{"text":"得中行而与之，必也狂狷乎。狂者进取，狷者有所不为也。","book":"《论语·子路》"},"example":{"text":"当理而后进，审势而后动，～，为无不成，是以英雄之主常无敌于天下也。","book":"宋·陈亮《酌古论·先主》"},"similar":["有所不为，而后可以有为"],"usage":"作谓语、定语；用于处事"},{"id":25386,"word":"有所不为，而后可以有为","pinyin":"yǒu suǒ bù wéi，ér hòu kě yǐ yǒu wéi","abbr":"ysbwehkyyw","explanation":"指人的精力是有限的，只有放弃一些事情不做，才能在别的一些事情上做出成绩。","source":{"text":"人有所不为也，而后可以有为。","book":"《孟子·离娄下》"},"example":{"text":"夫人有所不忍，而后能及其所忍；～。","book":"《明史·刘同升传》"},"similar":["有所不为"],"usage":"作宾语、定语；用于处事"},{"id":25387,"word":"有所为而为","pinyin":"yǒu suǒ wéi ér wéi","abbr":"yswew","explanation":"做好了计划才去做。","source":{"text":"天子者，天地宗庙社稷之主，于郊社禘尝有事守焉，以其义存乎报本，非有所为而为之。","book":"《元史·祭祀志》"},"example":{"text":"朕闻凡事无所为而为者，谓之天理；～者，谓之人欲。","book":"姚雪垠《李自成》第二卷第三十二章"}},{"id":25388,"word":"有所作为","pinyin":"yǒu suǒ zuò wéi","abbr":"yszw","explanation":"可以做事情，并能取得较大的成绩。","source":{"text":"人有不为也，而后可以有为。","book":"战国·邹·孟轲《孟子·离娄下》"},"example":{"text":"对这个问题，苏联是能够～的。","book":"《邓小平文选》第三卷"},"similar":["大有作为","大有可为"],"opposite":["无所作为","碌碌无为"],"usage":"作谓语、定语；指人"},{"id":25389,"word":"有所恃而不恐","pinyin":"yǒu suǒ shì ér bù kǒng","abbr":"yssebk","explanation":"恃：倚仗；恐：害怕。有所倚仗而不害怕。","source":{"text":"民有父母，国有蓍龟；斯文有传，学者有师；君子有所恃而不恐，小人有所畏而不为。","book":"宋·苏轼《祭欧阳文忠公文》"},"example":{"text":"而二公在朝，天下望之，屹立若中流之底柱，～。","book":"宋·朱熹《与陈侍郎书》"},"similar":["有恃无恐","有恃毋恐"],"usage":"作谓语、定语、宾语；指人仗势"},{"id":25390,"word":"有才无命","pinyin":"yǒu cái wú mìng","abbr":"ycwm","explanation":"有才能但遭遇不好。指不得志。","source":{"text":"比看书父四十人，有才无命百寮底。","book":"唐·杜甫《寄狄明府博济》诗"},"example":{"text":"金羽妹子，绝世聪明，有胆有识，今年也是七岁，可怜～。","book":"清·夏敬渠《野叟曝言》第40回"},"similar":["怀才不遇"],"usage":"作谓语、定语；指怀才不遇"},{"id":25391,"word":"有损无益","pinyin":"yǒu sǔn wú yì","abbr":"yswy","explanation":"损：减少，损失；益：增加，益处。只有减少，没有增加。也指只有损害，没有益处。","source":{"text":"南北异宜，至必生疾，此有损无益也。","book":"《新唐书·张廷珪传》"},"example":{"text":"和此辈相处一两年，即能幸存，也还是～的。","book":"鲁迅《书信集·致郑振铎》"},"similar":["有害无利"],"opposite":["有益无害"],"usage":"作谓语、定语；指没有好处"},{"id":25392,"word":"有教无类","pinyin":"yǒu jiào wú lèi","abbr":"yjwl","explanation":"类：类别。不管什么人都可以受到教育。","source":{"text":"子曰：‘有教无类。’","book":"《论语·卫灵公》"},"example":{"text":"他的教书有一个特别的地方，就是“～”。","book":"朱自清《经典常谈·诸子第十》"},"usage":"作主语、定语、宾语；指教育","story":["春秋时期，孔子在鲁国受到排挤，带领几十个弟子开始周游列国。到达卫国后，当时的卫灵公年迈，太子蒯聩与卫夫人南子的斗争很激烈，孔子也不能插入卫国政坛，他们在子路妻兄颜浊邹家驻扎，本着有教无类的原则，还是收下颜浊邹这个粗俗的弟子"]},{"id":25393,"word":"有文无行","pinyin":"yǒu wén wú xíng","abbr":"ywwx","explanation":"虽有文才而人品不好。","source":{"text":"或有文无行，久而秽迹恶声，使人不屑齿录者，其势亦可以乞食。","book":"清·纪昀《阅微草堂笔记·如是我闻一》"},"example":{"text":"盖自居于圣贤，而訾毁其亲，可谓～，名教之罪也。","book":"清·钱大昕《十驾斋养新录·王充》"},"usage":"作谓语、定语；用于处事"},{"id":25394,"word":"有斧无柯","pinyin":"yǒu fǔ wú kē","abbr":"yfwk","explanation":"柯：木制的柄。有斧子头却没有斧柄。比喻有卓越的才能，却没有借以施展的条件。","source":{"text":"而并见驱迮，雨绝于天，有斧无柯，何以自济？","book":"三国·魏·陈琳《檄吴将校部曲文》"},"example":{"text":"余徒恨不在其位，～，无以为国家流秽浊於四裔，投畀于有北。","book":"《抱朴子·交际》"}},{"id":25395,"word":"有无相生","pinyin":"yǒu wú xiāng shēng","abbr":"ywxs","explanation":"有可以转化成无，无也可以转化成有。指有和无是可以相互转化的。","source":{"text":"天下皆知美之为美，斯恶已；皆知善之为善，斯不善矣。有无相生，难易相成，长短相形，高下相盈，音声相和，前后相随，恒也。","book":"《老子》第二章"}},{"id":25396,"word":"有无相通","pinyin":"yǒu wú xiāng tōng","abbr":"ywxt","explanation":"互通有无，互相接济。","source":{"text":"朋友有无相通，急难于我乎赴。","book":"宋·文天祥《刘定伯墓志铭》"},"example":{"text":"～，汉人与我们万世永和睦！","book":"老舍《青蛙骑手》第三场"},"similar":["互通有无"],"usage":"作谓语、定语；用于书面语"},{"id":25397,"word":"有朝一日","pinyin":"yǒu zhāo yī rì","abbr":"yzyr","explanation":"朝：日，天。将来有那么一天。","source":{"text":"有朝一日天崩地裂豺狼死，吾却云开复见天。","book":"唐·坎曼尔《诉豺狼》诗"},"example":{"text":"～，我出矛庐指点世人迷，凭着我剑挥星斗，我志逐风雷。","book":"元·无名氏《博望烧屯》第一折"},"usage":"作状语；指将来的某一天"},{"id":25398,"word":"有本有则","pinyin":"yǒu běn yǒu zé","abbr":"ybyz","explanation":"指一切事物都有一定的规律。","source":{"text":"冶天下有本，身之谓也；治天下有则，家之谓也。","book":"宋·周敦颐《家人睽复无妄》"}},{"id":25399,"word":"有本有原","pinyin":"yǒu běn yǒu yuán","abbr":"ybyy","explanation":"指有根源；源源本本。亦作“有本有源”。","source":{"text":"虽然，为是者有本有原，怠与忌之谓也。","book":"唐·韩愈《原毁》"},"similar":["有本有源"],"usage":"作谓语、定语；用于书面语"},{"id":25400,"word":"有本有源","pinyin":"yǒu běn yǒu yuán","abbr":"ybyy","explanation":"指有根源；源源本本。同“有本有原”。","source":{"text":"[十三妹]及至听他说的有本有源，有凭有据，不容不信。","book":"《儿女英雄传》第十八回"},"similar":["有本有原"],"usage":"作谓语、定语；用于书面语"},{"id":25401,"word":"有机可乘","pinyin":"yǒu jī kě chéng","abbr":"yjkc","explanation":"有空子可钻。","source":{"text":"今魏有隙可乘，不就此时伐之，更等何时？","book":"明·罗贯中《三国演义》第一百十回"},"example":{"text":"闻之窃喜其～。","book":"清·蒲松龄《聊斋志异·胭脂》"},"similar":["有隙可乘","无孔不入"],"opposite":["无懈可击","无隙可乘"],"usage":"作谓语、定语、宾语；指钻空子"},{"id":25402,"word":"有机可趁","pinyin":"yǒu jī kě chèn","abbr":"yjkc","explanation":"有机会可以利用，有空子可钻。","source":{"text":"公之有行，请益兵备，机有可乘，虽烹可畏。","book":"宋·楼钥《攻媿集》卷九十五"},"example":{"text":"从第一次见到素琴，查良钟便知道自己～。","book":"叶兆言《花影》第四章"},"similar":["有机可乘","有隙可乘"],"opposite":["无懈可击","无隙可乘"],"usage":"作谓语、定语、宾语；指钻空子"},{"id":25403,"word":"有权有势","pinyin":"yǒu quán yǒu shì","abbr":"yqys","explanation":"势：地位和权力。既有权力，又有地位。","source":{"text":"如今凡作地方官者，皆有一个私单，上面写的是本省最有权有势、极富极贵的大乡绅名姓，各省皆然。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"清·曹雪芹《红楼梦》第四回：“如今凡作地方官者，皆有一个私单，上面写的是本省最～、极富极贵的大乡绅名姓，各省皆然。”"},"similar":["有钱有势"],"usage":"作谓语、定语；指权势"},{"id":25404,"word":"有条不紊","pinyin":"yǒu tiáo bù wěn","abbr":"ytbw","explanation":"紊：乱。形容有条有理，一点不乱。","source":{"text":"若网在纲，有条而不紊。","book":"《尚书·盘庚上》"},"example":{"text":"听上去倒也是原原本本，～。","book":"清·李宝嘉《官场现形记》第五十六回"},"similar":["有条有理"],"opposite":["乱七八糟","千头万绪"],"usage":"作谓语、定语、状语；指整齐","story":["商朝时期，国都在黄河北岸，经常遭受水灾，商汤的第9代孙子盘庚为避免水灾，让老百姓安居乐业，他决心迁都到黄河以南的殷地去，贵族们担心迁都会引起社会的动荡，盘庚说只要听从他的命令就会有条不紊，经过努力终于迁都到殷"]},{"id":25405,"word":"有条有理","pinyin":"yǒu tiáo yǒu lǐ","abbr":"ytyl","explanation":"形容层次、脉络清楚。","source":{"text":"如网在纲，各有条理而不乱也。","book":"《尚书·盘庚上》：“若网在纲，有条而不紊。”孔安国传"},"example":{"text":"他那口齿的清白，措辞的简洁，思路的～，的确是名不虚传。","book":"郭沫若《革命春秋·创造十年续篇》"},"similar":["头头是道"],"opposite":["乱七八糟","杂乱无章"],"usage":"作定语、状语、补语；指人的思维、办事等","story":["商朝时期，国都在黄河北岸，经常遭受水灾，商汤的第9代孙子盘庚为避免水灾，让老百姓安居乐业，他决心迁都到黄河以南的殷地去，贵族们担心迁都会引起社会的动荡，盘庚说只要听从他的命令就会有条有理，经过努力终于迁都到殷"]},{"id":25406,"word":"有来无回","pinyin":"yǒu lái wú huí","abbr":"ylwh","explanation":"只要来了，就回不去。指彻底被消灭。","source":{"text":"有这玩艺儿，慢说他‘种殃军’，他洋爸爸鬼子来，也给他有来无回。","book":"周立波《暴风骤雨》第一部十三"},"example":{"text":"[如果]胆敢侵犯我们伟大的社会主义祖国，我们就一定叫他～。","book":"《解放军报》1970.9.30"},"opposite":["有来有往"],"usage":"作宾语；指单程事物"},{"id":25407,"word":"有来有往","pinyin":"yǒu lái yǒu wǎng","abbr":"ylyw","explanation":"指对等行动。所指因文而异。","source":{"text":"你既虚心的请教他，他也会虚心的请教你。最好的教育是有来有往。","book":"陶知行《怎样做小先生》"},"example":{"text":"人际交往最好是～。"},"usage":"作谓语、宾语；指交往"},{"id":25408,"word":"有板有眼","pinyin":"yǒu bǎn yǒu yǎn","abbr":"ybyy","explanation":"板：演奏民族音乐或戏曲时用来打拍子的乐器；眼：戏曲中的拍子。指唱腔合乎节拍。亦指言语行事有节奏、有条理。","source":{"text":"她的嗓子还不错，唱出的歌有板有眼，又洪亮又圆润。","book":"杨匡满 郭宝臣《命运》十"},"example":{"text":"可是他很不争气，通知没来的那一天，他还有说有笑，～，一接到通知，就变了卦了。","book":"方之《在泉边》"},"similar":["有条有理","有条不紊","有声有色"],"opposite":["乱七八糟","杂乱无章"],"usage":"作谓语、定语、状语；用于人的言行或做事"},{"id":25409,"word":"有枝有叶","pinyin":"yǒu zhī yǒu yè","abbr":"yzyy","explanation":"形容真切详尽。","source":{"text":"防御惊得呆了道：‘庆娘见在房中床上卧病，郎君不信可以去看得的。如何说得如此有枝有叶？又且这钗如何得出世？真是蹊跷的事。’","book":"明·凌濛初《初刻拍案惊奇》卷二十三"},"example":{"text":"清·名教中人《好逑传》第11回：“童子正说得～，忽被铁公子一把捉倒，只狠狠要打，吓得他魂都不在身上。”"},"usage":"作定语、状语；用于说话或作文等"},{"id":25410,"word":"有枝添叶","pinyin":"yǒu zhī tiān yè","abbr":"yzty","explanation":"比喻叙述事情或转述别人的话，为了夸大，添上原来没有的内容。","source":{"text":"桐芳回到家中，把这些话有枝添叶的告诉给高第，而被招弟偷偷听了去。","book":"老舍《四世同堂》十一"},"similar":["添枝加叶","添油加醋"],"usage":"作谓语；指人说话"},{"id":25411,"word":"有根有底","pinyin":"yǒu gēn yǒu dǐ","abbr":"ygyd","explanation":"犹言有根有据。","source":{"text":"为了证明他说的这些话有根有底，他又跟我翻起石山柏的历史。","book":"浩然《石山柏》"},"similar":["有根有据"],"usage":"作谓语、定语；用于口语"},{"id":25412,"word":"有根有据","pinyin":"yǒu gēn yǒu jù","abbr":"ygyj","explanation":"有根据，不是凭空捏造。","source":{"text":"郑恩听了这一席话，欲待不信，这卖油梆子现在，是他掐算出来的，似乎有根有据，怎么不信？","book":"清·吴璿《飞龙全传》第八回"},"example":{"text":"这事～，不容你抵赖。"},"similar":["有凭有据"],"opposite":["无凭无据"],"usage":"作谓语、定语、状语；指有凭证"},{"id":25413,"word":"有根有苗","pinyin":"yǒu gēn yǒu miáo","abbr":"ygym","explanation":"有根据，有线索。","source":{"text":"这事虽奇，却还有根有苗，想得起来。","book":"《石点头·郭挺之榜前认子》"},"similar":["有根有据"],"usage":"作谓语、定语；用于口语"},{"id":25414,"word":"有案可查","pinyin":"yǒu àn kě chá","abbr":"yakc","explanation":"案：案卷，文书。指有证据可查。","example":{"text":"～，我们不必担心他作弊。"},"similar":["有案可稽"],"usage":"作谓语、定语、宾语；指事情的根据"},{"id":25415,"word":"有案可稽","pinyin":"yǒu àn kě jī","abbr":"yakj","explanation":"案：案卷，文件；稽：查考。指有证据可查。","source":{"text":"尊重中国行政和领土的完整，以及反对任何外国控制中国等等，这是有案可稽的。","book":"毛泽东《“友谊”，还是侵略》"},"similar":["铁证如山","铁案如山","千真万确"],"opposite":["无凭无据","捕风捉影","流言蜚语"],"usage":"作谓语、定语、宾语；指事情的根据"},{"id":25416,"word":"有棱有角","pinyin":"yǒu léng yǒu jiǎo","abbr":"ylyj","explanation":"比喻为人方正。也形容脸色严峻。","source":{"text":"十分强调培养有棱有角的女接班人。","book":"古华《芙蓉镇》第四章"},"example":{"text":"冠先生的脸板得～的说。","book":"老舍《四世同堂》"},"similar":["棱角分明"],"opposite":["八面玲珑"],"usage":"作谓语、定语；形容脸色严峻"},{"id":25417,"word":"有模有样","pinyin":"yǒu mó yǒu yàng","abbr":"ymyy","explanation":"形容模仿得很像。","source":{"text":"赫德甩一甩马蹄袖，有模有样地在红毡条上跪了下去，磕完头起身。","book":"高阳《胡雪岩全传·萧瑟洋场》"},"usage":"作定语、状语；用于口语"},{"id":25418,"word":"有死无二","pinyin":"yǒu sǐ wú èr","abbr":"yswe","explanation":"表示意志坚定，虽死不变。","source":{"text":"必报德，有死无二。","book":"春秋·鲁·左丘明《左传·僖公十五年》"},"example":{"text":"诚贯神明，～。","book":"唐·白居易《淮南节度使李公家庙碑铭》"},"similar":["忠贞不渝"],"usage":"作谓语、定语；指人忠贞"},{"id":25419,"word":"有气无力","pinyin":"yǒu qì wú lì","abbr":"yqwl","explanation":"形容说话声音微弱，作事精神不振。也形容体弱无力。","source":{"text":"正不知舱中另有个替吃饭的，还饿得有气无力哩。","book":"明·冯梦龙《醒世恒言·吴衙内邻舟赴约》"},"example":{"text":"“糙米五块，谷三块。”米行里的先生～地回答他们。","book":"叶圣陶《多收了三五斗》"},"similar":["精疲力竭","精疲力尽","无精打采"],"opposite":["精神焕发","朝气勃勃"],"usage":"作谓语、状语；形容体弱无力"},{"id":25420,"word":"有气无烟","pinyin":"yǒu qì wú yān","abbr":"yqwy","explanation":"形容家中非常贫困，无米下锅。","source":{"text":"自从那李甲在此，混帐一年有余，莫说新客，连旧主顾都断了。分明接了个锺馗老，连小鬼也没得上门，弄得老娘一家人家，有气无烟，成什么模样！","book":"明·冯梦龙《警世通言》第三十二卷"},"usage":"作谓语、状语、定语；用于书面语"},{"id":25421,"word":"有气没力","pinyin":"yǒu qì méi lì","abbr":"yqml","explanation":"形容说话声音微弱，作事精神不振。也形容体弱无力。同“有气无力”。","source":{"text":"子春一心想着要那老者的银子，又怕他说谎，这两只脚虽则有气没力的，一步步荡到波斯馆来；一双眼却紧紧望那老者在也不在。","book":"明·冯梦龙《醒世恒言》第三十七卷"},"example":{"text":"“糙米五块，谷三块。”米行里的先生～地回答他们。","book":"叶圣陶《多收了三五斗》"},"similar":["有气无力"],"opposite":["朝气蓬勃"],"usage":"作谓语、状语；形容体弱无力"},{"id":25422,"word":"有求必应","pinyin":"yǒu qiú bì yìng","abbr":"yqby","explanation":"只要有人请求帮助，就一定答应。","source":{"text":"往日良朋密友，有求必应。","book":"清·袁枚《小仓山房尺牍·答鱼门》：“家中豪奢，业已出千进一矣，又性喜泛施，有求必应。”清·霁园主人《夜谭随录·崔秀才》"},"example":{"text":"弄到后来，书画虽还是～，差缺却有点来不及了。","book":"清·李宝嘉《官场现形记》第四十二回"},"similar":["来者不拒","有求斯应"],"opposite":["拒之门外"],"usage":"作谓语、定语；指人或神"},{"id":25423,"word":"有求必给","pinyin":"yǒu qiú bì jǐ","abbr":"yqbg","explanation":"给：供给。只要有人来求索，没有不供给的。","source":{"text":"其所起庐舍，皆有重堂高阁，陂渠灌注。又池鱼牧畜，有求必给。","book":"《后汉书·樊宏传》"}},{"id":25424,"word":"有求斯应","pinyin":"yǒu qiú sī yìng","abbr":"yqsy","explanation":"斯：尽。只要有要求都能答应。","source":{"text":"大乐和畅，殷荐明神。一降通感，八变必臻。有求斯应，无德不亲。降灵醉止，休征万人。","book":"唐·韩思复《祭汾阴乐章》"},"similar":["有求必应"],"usage":"作谓语、定语；用于处事"},{"id":25425,"word":"有求辄应","pinyin":"yǒu qiú zhé yìng","abbr":"yqzy","explanation":"辄：就，总是。只要提出要求，总是能答应。","source":{"text":"偶缺晨炊，仰屋无计。忽忆儿言，往启椟，果得米，赖以举火。自是有求辄应。","book":"清·蒲松龄《聊斋志异·苏仙》"},"example":{"text":"一班愚夫愚妇，共去拜祝，～，就是武帝外祖母臧儿，也曾往祷，果得子女贵显。","book":"蔡东藩《前汉演义》第七十二回"}},{"id":25426,"word":"有治人，无治法","pinyin":"yǒu zhì rén，wú zhì fǎ","abbr":"yzrwzf","explanation":"治理天下的人始终存在，但没有始终不变的法规。指人决定着法的施行。","source":{"text":"有乱君，无乱国；有治人，无治法。","book":"《荀子·君道》"},"example":{"text":"～，惟在督抚举措公明，而非立法所能限制。","book":"《清史稿·汤金钊传》"}},{"id":25427,"word":"有治法，无治人","pinyin":"yǒu zhì fǎ，wú zhì rén","abbr":"yzfwzr","explanation":"有治理天下的法，却没有治理天下的人。","source":{"text":"有乱君，无乱国；有治人，无治法。","book":"《荀子·君道》"},"example":{"text":"但～，天下患岂惟关津。","book":"清·赵怀玉《过关行》"}},{"id":25428,"word":"有滋有味","pinyin":"yǒu zī yǒu wèi","abbr":"yzyw","explanation":"指十分有味道，生动","source":{"text":"有许多话头做作，哄动这些血气未定的少年，其实有枝有叶，有滋有味。","book":"明·凌濛初《二刻拍案惊奇》第18卷"},"usage":"作宾语、状语；用于口语"},{"id":25429,"word":"有物有则","pinyin":"yǒu wù yǒu zé","abbr":"ywyz","explanation":"指天地间凡事物皆有其法则、规律。","source":{"text":"天生烝民，有物有则。","book":"《诗·大雅·烝民》"},"example":{"text":"木实之蠹者，必不沙烂……瓜至甘而不蠹者，以其沙也。～，若可穷矣。","book":"宋·陈郁《话谀》"},"usage":"作谓语、定语；用于书面语"},{"id":25430,"word":"有犯无隐","pinyin":"yǒu fàn wú yǐn","abbr":"yfwy","explanation":"指对上敢于无所隐讳地直言正谏，虽有冒犯也在所不顾。","source":{"text":"公有犯无隐，引经正辞，上是其言，刑为之省。","book":"唐·严郢《驳议吕湮》"},"example":{"text":"宋·范仲淹《上资政晏侍郎书》：“某又闻：事君～，有谏无讪，杀其身有益于君则为之。”"},"usage":"作谓语、定语；用于处事"},{"id":25431,"word":"有理不在声高","pinyin":"yǒu lǐ bù zài shēng gāo","abbr":"ylbzsg","explanation":"只要你占住了理，就用不着高声叫喊。"},{"id":25432,"word":"有理走遍天下","pinyin":"yǒu lǐ zǒu biàn tiān xià","abbr":"ylzbtx","explanation":"只要有道理，任何地方都行得通。","example":{"text":"俗话说：～，我怕什么。"},"usage":"作宾语、定语；用于口语"},{"id":25433,"word":"有理走遍天下，无理寸步难行","pinyin":"yǒu lǐ zǒu biàn tiān xià，wú lǐ cùn bù nán xíng","abbr":"ylzbtxwlcbnx","explanation":"有理到哪儿都行得通，无理到哪儿都不行。指人的言行必须有理可循。"},{"id":25434,"word":"有生之年","pinyin":"yǒu shēng zhī nián","abbr":"yszn","explanation":"一生之中最后的年月，即余年。","source":{"text":"俾臣得保蚁命，此后有生之年，莫非主上所赐，惟求格外垂怜。","book":"清·李汝珍《镜花缘》第68回"},"example":{"text":"只好用今后～的辛勤努力，来补偿过去的不足。","book":"秦牧《序》"},"similar":["耄耋之年"],"opposite":["豆蔻年华"],"usage":"作主语、宾语；用于老年人"},{"id":25435,"word":"有生以来","pinyin":"yǒu shēng yǐ lái","abbr":"ysyl","explanation":"从出生到现在。","source":{"text":"题目是‘藤文公为世子四章’，我有生以来，从没有做过这样长的题目。","book":"清·李宝嘉《文明小史》第14回"},"example":{"text":"我～从没有吃过这样的苦。"},"usage":"作状语；指出生以来"},{"id":25436,"word":"有生力量","pinyin":"yǒu shēng lì liàng","abbr":"ysll","explanation":"①原指军队中的兵员和马匹。亦泛指有战斗力的部队。②指充满活力的力量。","source":{"text":"集中兵力各个歼敌的原则，以歼灭敌军有生力量为主要目标，不以保守或夺取地方为主要目标。","book":"毛泽东《集中优势兵力，各个歼灭敌人》"},"example":{"text":"青年突击队始终紧紧地结合社会的生产，一直保持着生气勃勃的、内容丰富的活动，成为一支推动生产的～。","book":"《中国农村的社会主义高潮》"},"usage":"作主语、宾语；泛指军队"},{"id":25437,"word":"有病乱投医","pinyin":"yǒu bìng luàn tóu yī","abbr":"yblty","explanation":"患了病到处乱找医生。比喻人遇到事故胡乱地到处找人帮忙或出主意。","example":{"text":"麻太太此时的心理一定是～，便快速把嫦娥引至老人床前。","book":"铁凝《嫦娥》"}},{"id":25438,"word":"有百害而无一利","pinyin":"yǒu bǎi hài ér wú yī lì","abbr":"ybhewyl","explanation":"百害：泛指许多坏处。有许多坏处，没有一点好处","example":{"text":"吸毒～"},"similar":["一无是处"],"opposite":["有益无害"],"usage":"作谓语、定语；用于事物等"},{"id":25439,"word":"有的放矢","pinyin":"yǒu dì fàng shǐ","abbr":"ydfs","explanation":"的：箭靶子；矢：箭。放箭要对准靶子。比喻说话做事有针对性。","source":{"text":"论立于此，若射之有的也，或百步之外，或五十步之外，的必先立，然后挟弓注矢以从之。","book":"宋·叶适《水心别集·十五·终论》"},"example":{"text":"马克思列宁主义理论和中国革命实际，怎样互相联系呢？拿一句通俗的话来讲，就是“～”。","book":"毛泽东《整顿党的作风》"},"similar":["对症下药"],"opposite":["无的放矢"],"usage":"作谓语、定语、宾语、状语；指说话或做事"},{"id":25440,"word":"有目共睹","pinyin":"yǒu mù gòng dǔ","abbr":"ymgd","explanation":"睹：看见。指非常明显，谁都看得见。","source":{"text":"日月东出而西没，有目者所共睹。","book":"元·李翀《日闻录》"},"example":{"text":"世间文字茫然如前尘积劫，门下散花落彩如卿云在天，～。","book":"清·钱谦益《与王贻一之一》"},"similar":["众目睽睽"],"opposite":["有目无睹"],"usage":"作谓语、定语；形容事物非常明显"},{"id":25441,"word":"有目共见","pinyin":"yǒu mù gòng jiàn","abbr":"ymgj","explanation":"指人人都看见，极其明显。","source":{"text":"《大学》纷纷言先言后，有目共见。","book":"清·陈确《大学辨一·翠薄山房帖》"},"example":{"text":"他的思想根据之薄弱是～的。","book":"郭沫若《读任公〈墨子新社会之组织法〉》"},"similar":["有目共睹"],"usage":"作谓语、定语；形容事物非常明显"},{"id":25442,"word":"有目共赏","pinyin":"yǒu mù gòng shǎng","abbr":"ymgs","explanation":"赏：称赞。谁看见了都称赞。","source":{"text":"这人负一时盛名，而《湘军志》一书做的委实是好，有目共赏。","book":"清·刘鹗《老残游记》第十二回"},"example":{"text":"夫敷华掞藻，立意遣词，无一落前一窠臼，此固～，姑且具论。","book":"清·戚蓼生《石头记·序》"},"similar":["交口称赞"],"usage":"作谓语；指谁看见了都称赞"},{"id":25443,"word":"有目咸睹","pinyin":"yǒu mù xián dǔ","abbr":"ymxd","explanation":"咸：都；睹：看见。指非常明显，谁都看得见。","source":{"text":"日月东出而西没，有目者所共睹。","book":"元·李翀《日闻录》"}},{"id":25444,"word":"有目咸赏","pinyin":"yǒu mù xián shǎng","abbr":"ymxs","explanation":"咸：都；赏：称赞。谁看见了都称赞。","source":{"text":"这人负一时盛名，而《湘军志》一书做的委实是好，有目共赏。","book":"清·刘鹗《老残游记》第十二回"}},{"id":25445,"word":"有目如盲","pinyin":"yǒu mù rú máng","abbr":"ymrm","explanation":"虽然有眼睛却和瞎子一样。指对事物的识别能力差。","source":{"text":"子细寻思还传个什么？一向毁他经教有目如盲。","book":"《古尊宿语录》卷三十五"},"example":{"text":"于是李林甫、杨国忠二人，一齐上前取看，只落得～，也一字看不出来，局促无地。","book":"清·褚人获《隋唐演义》第八十二回"},"similar":["有眼如盲"],"usage":"作谓语、定语；指人缺乏见识"},{"id":25446,"word":"有目无睹","pinyin":"yǒu mù wú dǔ","abbr":"ymwd","explanation":"犹言有眼无珠。用来责骂人瞎了眼，看不见某人或某事物的伟大或重要。","source":{"text":"淮阴少年，有目无睹，不知将军，用之如虎。","book":"宋·苏轼《淮阴侯庙记》"},"similar":["有眼无珠","有眼无瞳"],"usage":"作谓语、定语；多用于骂人"},{"id":25447,"word":"有眼不识泰山","pinyin":"yǒu yǎn bù shí tài shān","abbr":"yybsts","explanation":"虽有眼睛，却不认识泰山。比喻见闻太窄，认不出地位高或本领大的人。","source":{"text":"师父如此高强，必是个教头。小儿有眼不识泰山。","book":"明·施耐庵《水浒全传》第二回"},"example":{"text":"他～，真是一个见识短浅的人。"},"similar":["有眼无珠","视而不见"],"usage":"作谓语、宾语；用于自谦的客套话","story":["宋朝时期，东京禁军拳棒教头王进的父亲王升曾经棒打小流氓高俅。10年后高俅官至殿帅府太尉，直接管辖王进。高俅为报一棒之仇把王进抓来打一顿。王进连夜携全家逃到史家庄，史进有眼不识泰山，还是史父识英雄，让史进拜王进为师"]},{"id":25448,"word":"有眼不识荆山玉","pinyin":"yǒu yǎn bù shí jīng shān yù","abbr":"yybsjsy","explanation":"荆山：山名，此山产宝玉，据传和氏璧就出自此山。比喻眼力差，识别不出贤人或珍品。","source":{"text":"我西门庆一时昏昧，不听你之良言，辜负你之好意。正是有眼不识荆山玉，拿着顽石一样看。过后方知君子，千万饶恕我则个。","book":"明·兰陵笑笑生《金瓶梅词话》第二十一回"},"example":{"text":"这么纯净的水晶，你竟然当成玻璃，真是～。"}},{"id":25449,"word":"有眼如盲","pinyin":"yǒu yǎn rú máng","abbr":"yyrm","explanation":"虽有眼睛，如同瞎子。指不认识著名人物，或不识大体。","source":{"text":"师父，弟子有眼如盲，只望师父救度咱。","book":"元·范子安《竹叶舟》第四折"},"example":{"text":"更怕我～，我从来性格玲珑。","book":"明·无名氏《广东子》第二折"},"similar":["有眼无珠","有目如盲"],"usage":"作谓语、定语；指人缺乏见识"},{"id":25450,"word":"有眼无珠","pinyin":"yǒu yǎn wú zhū","abbr":"yywz","explanation":"珠：眼珠。没长眼珠子。用来责骂人瞎了眼，看不见某人或某事物的伟大或重要。","source":{"text":"常言道，贤者自贤，愚者自愚，就似那薰莸般各别难同处，怎比你有眼却无珠。","book":"元·无名氏《举案齐眉》第一折"},"example":{"text":"师父，弟子～，不认得师父的尊容，多有冲撞，万望恕罪。","book":"明·吴承恩《西游记》第二十二回"},"similar":["视而不见","有目无睹","有眼无瞳"],"opposite":["心明眼亮"],"usage":"作谓语、定语；用于骂人"},{"id":25451,"word":"有眼无瞳","pinyin":"yǒu yǎn wú tóng","abbr":"yywt","explanation":"用来责骂人瞎了眼，看不见某人或某事物的伟大或重要。同“有眼无珠”。","source":{"text":"都只因气送了人，到底成何用。谁知你有眼无瞳。","book":"元·史九敬先《庄周梦》第一折"},"example":{"text":"清·褚人获《隋唐演义》第54回：“臣～，以致当年不识英雄之主，获罪难逃。”"},"similar":["有眼无珠","有目无睹"],"usage":"作谓语、定语；用于骂人"},{"id":25452,"word":"有碍观瞻","pinyin":"yǒu ài guān zhān","abbr":"yagz","explanation":"观瞻：外观以及对外观的反应。指不适合观看的事物或现象。","example":{"text":"凡是破损严重，～的，都严饬本宅住户连夜修缮。","book":"姚雪垠《李自成》第三卷第二十九章"}},{"id":25453,"word":"有福共享","pinyin":"yǒu fú gòng xiǎng","abbr":"yfgx","explanation":"幸福来共同分享。","source":{"text":"彼此兄弟，自应有福同享。","book":"清·黄小配《廿载繁华梦》第二十回"}},{"id":25454,"word":"有福同享","pinyin":"yǒu fú tóng xiǎng","abbr":"yftx","explanation":"幸福来共同分享。","source":{"text":"彼此兄弟，自应有福同享。","book":"清·黄小配《廿载繁华梦》第二十回"},"example":{"text":"我们约他做攻守同盟，本想彼此提携，～，有祸同当，不料他倒先来沾我们的光了。","book":"茅盾《子夜》十八"},"similar":["有福同享，有难同当"],"usage":"作谓语；指朋友、亲人等"},{"id":25455,"word":"有福同享，有祸同当","pinyin":"yǒu fú tóng xiǎng，yǒu huò tóng dāng","abbr":"yftxyhtd","explanation":"指患难与共，和衷共济。同“有福同享，有难同当”。","source":{"text":"我们约他做攻守同盟，本想彼此提携，有福同享，有祸同当，不料他倒先来沾我们的光了。”"},"example":{"text":"郭沫若《屈原》第三幕：“子兰：我们将来一定要～，你高兴不高兴？”"},"similar":["有福同享，有难同当"],"usage":"作谓语、定语；用于处事等"},{"id":25456,"word":"有福同享，有难同当","pinyin":"yǒu fú tóng xiǎng，yǒu nàn tóng dāng","abbr":"yftxyntd","explanation":"幸福共同分享，苦难共同分担。指患难与共，和衷共济。","source":{"text":"还有一件：从前老爷有过话，是‘有福同享，有难同当’。现在老爷有得升官发财，我们做家人的出了力、赔了钱，只落得一个半途而废。","book":"《官场现形记》第五回"},"example":{"text":"～，不要说只有这几个，就是再多些，我用了也不伤天理。","book":"《文明小史》第二十回"},"similar":["同甘共苦","有福同享，有祸同当"],"usage":"作宾语、分句；可分开使用"},{"id":25457,"word":"有章可循","pinyin":"yǒu zhāng kě xún","abbr":"yzkx","explanation":"章：章程、章法；循：遵守、依照。有章法可以依照","source":{"text":"总之，在决策过程的各个环节，都要做出切实可行的规定，使之有章可循。","book":"《新时期党的建设概论》"},"similar":["有法可依"],"usage":"作谓语、定语、宾语；用于处事"},{"id":25458,"word":"有约在先","pinyin":"yǒu yuē zài xiān","abbr":"yyzx","explanation":"已经约定好了。指事情的处理方案已事先定好。","source":{"text":"老夫人，这事本已有约在先，况兼孩儿又执意定要嫁他，也是他的缘分了。","book":"元·无名氏《举案齐眉》第一折"},"usage":"作谓语、定语；用于处事"},{"id":25459,"word":"有缘千里来相会","pinyin":"yǒu yuán qiān lǐ lái xiāng huì","abbr":"yyqllxh","explanation":"人与人之间只要有缘分，即使相离很远也会相见。","source":{"text":"正是‘有缘千里来相会，无缘对面不相逢。’","book":"明·施耐庵《水浒传》第14回"},"example":{"text":"俗话说：～，我们随缘吧。"},"usage":"作宾语、定语、分句；用于口语"},{"id":25460,"word":"有缘千里来相会，无缘对面不相逢","pinyin":"yǒu yuán qiān lǐ lái xiāng huì，wú yuán duì miàn bù xiāng féng","abbr":"yyqllxhwydmbxf","explanation":"缘：缘分。有缘分的人即使相隔千里，也会相聚在一起。没有缘分的人即使面对面走过，也聚不到一块","source":{"text":"有缘千里能相会，无缘对面不相逢。","book":"宋·无名氏《张协状元》第14出"},"example":{"text":"明·施耐庵《水浒传》第35回：“宋江听了大喜，向前拖住道：‘～’！只我便是黑三郎宋江。”"},"usage":"作宾语、定语、分句；用于书面语"},{"id":25461,"word":"有翅难展","pinyin":"yǒu chì nán zhǎn","abbr":"ycnz","explanation":"展：施展。即使有翅膀，也不能展开。比喻空有本领，却没有施展的地方。","example":{"text":"如今他看见咱们困在此地，～，他自然要另打主意，不肯回来。","book":"姚雪垠《李自成》第二卷第三章"}},{"id":25462,"word":"有翅难飞","pinyin":"yǒu chì nán fēi","abbr":"ycnf","explanation":"长着翅膀也飞不出去，形容陷入无法摆脱的困境。","source":{"text":"暗埋伏猛军四面围，纵然他有翅难飞。","book":"明·无名氏《杏林庄》第三折"},"example":{"text":"我们叫你～，逃不出我们的包围圈。"},"similar":["插翅难飞"],"usage":"作宾语、谓语；指陷入困境"},{"id":25463,"word":"有耻且格","pinyin":"yǒu chǐ qiě gé","abbr":"ycqg","explanation":"指人有知耻之心，则能自我检点而归于正道。","source":{"text":"道之以德，齐之以礼，有耻且格。","book":"先秦·孔子《论语·为政》"},"example":{"text":"天下有重典而不为酷者，惩一儆百，辟以止辟是也；有最轻之典而人莫敢犯者，～是也。","book":"清·魏源《军储篇一》"},"usage":"作谓语、定语；用于书面语"},{"id":25464,"word":"有职无权","pinyin":"yǒu zhí wú quán","abbr":"yzwq","explanation":"光有职位而没有实权。","example":{"text":"我不想过这～的清闲日子。"},"similar":["有名无实"],"usage":"作谓语、定语；用于官场"},{"id":25465,"word":"有胆有识","pinyin":"yǒu dǎn yǒu shí","abbr":"ydys","explanation":"既有胆量又有见识。","source":{"text":"金羽妹子，绝世聪明，有胆有识，今年也是七岁，可怜有才无命。","book":"清·夏敬渠《野叟曝言》第四十回"},"usage":"作谓语、定语；用于夸奖人"},{"id":25466,"word":"有脚书厨","pinyin":"yǒu jiǎo shū chú","abbr":"yjsc","explanation":"戏称记闻精确、知识渊博的人。","source":{"text":"［龚程］自幼读书于南峰山先都官墓庐，攻苦食淡，手未尝释卷。记问精确，经传子史，无不通贯。，乡人号为‘有脚书厨’。","book":"宋·龚明之《中吴纪闻·有脚书厨》"},"usage":"作主语、宾语、定语；指学者","story":["宋朝时期，龚程从小就在南峰山先都官墓庐旁读书，读书十分认真，生活很清苦，经常是手不释卷，他的记忆力相当好，凡是读过的经传子史等，能一字不差背诵出来，当时的乡人佩服他的记忆力，送他“有脚书厨”的外号"]},{"id":25467,"word":"有脚书橱","pinyin":"yǒu jiǎo shū chú","abbr":"yjsc","explanation":"比喻学识渊博的人。也指脱离实际食古不化的书呆子。","source":{"text":"程信民记闻精确，乡人号为有脚书厨（橱）。","book":"宋·龚明之《中吴记闻》"}},{"id":25468,"word":"有脚阳春","pinyin":"yǒu jiǎo yáng chūn","abbr":"yjyc","explanation":"承春：指春天。旧时称赞好官的话。","source":{"text":"宋璟爱民恤物，朝野归美，时人咸谓璟为有脚阳春，言所至之处，如阳春煦物也。","book":"五代·王仁裕《开元天宝遗事·有脚阳春》"},"example":{"text":"～司谳听，谩说道官清民靖。","book":"明·张景《飞丸记·全家配远》"},"similar":["阳春有脚"],"usage":"作宾语；指好官","story":["唐中宗时，谏议大夫宋璟因为直言劝谏被贬为刺史，他在地方当官，为政清廉，每到一处，都尽力为当地百姓做好事，家家户户都能安居乐业，人们称赞他是有脚阳春，给人们带来温暖，唐玄宗时，他又几次升贬，最后担任宰相"]},{"id":25469,"word":"有色有声","pinyin":"yǒu sè yǒu shēng","abbr":"ysys","explanation":"原形容既有声望，又有文采，看起来十分显耀。后也形容说话或表演精彩生动。","source":{"text":"其意以谓世之有声有色者，未有不争而得，亦未有不终磨灭者。","book":"宋·汪藻《浮溪集·翠微堂记》"},"example":{"text":"扬之则高华，抑之则沉实，～，有气有骨，有味有态，浓淡深浅，奇正开阖，各极其则。","book":"明·王世贞《艺苑卮言》卷四"}},{"id":25470,"word":"有色眼镜","pinyin":"yǒu sè yǎn jìng","abbr":"ysyj","explanation":"比喻看待人或事物所抱的成见。","source":{"text":"你们的报道一定要真实，不要加油加醋，不要戴有色眼镜。","book":"刘少奇《对华北记者团的谈话》"},"example":{"text":"老梁，假若你总是戴上～，看一切事物和一切人，假若你把你我之间的冲突当作是个人意气用事，那就是清清楚楚地毁你自己。","book":"杜鹏程《在和平的日子里》第三章"},"usage":"作主语、宾语、定语；指看问题有偏见"},{"id":25471,"word":"有蠙可乘","pinyin":"yǒu bīn kě chéng","abbr":"ypkc","explanation":"指事情有漏洞可以利用。同“有隙可乘”。"},{"id":25472,"word":"有血有肉","pinyin":"yǒu xuè yǒu ròu","abbr":"yxyr","explanation":"比喻富有生命的活力和内容。多用来形容文艺作品中人物形象生动。","source":{"text":"但是总觉得那种思想交锋并不是有声有色，有血有肉，语言独特，激动人心的。","book":"秦牧《艺海拾贝·核心》"},"example":{"text":"他是一个～的人。"},"similar":["栩栩如生"],"usage":"作定语、补语；指作品"},{"id":25473,"word":"有衅可乘","pinyin":"yǒu xìn kě chèng","abbr":"yxkc","explanation":"衅：间隙，破绽。指有破绽可以利用。","source":{"text":"迨夫黄池之会，有衅可乘，于是一举而败吴。","book":"宋·华岳《翠微北征录·治安药石·军国大计·和议》"},"example":{"text":"待至～，然后举事，方不致有负宿心，且可仗义执言，取服天下。","book":"蔡东藩《两晋演义》第六十七回"}},{"id":25474,"word":"有要于时","pinyin":"yǒu yào yú shí","abbr":"yyys","explanation":"对当时有需要。","source":{"text":"凡先王之法有要于时也。","book":"战国·卫·吕不韦《吕氏春秋·察今》"},"usage":"作谓语；指人或事物"},{"id":25475,"word":"有要没紧","pinyin":"yǒu yào méi jǐn","abbr":"yymj","explanation":"无关紧要。指做了没有意义、没有用的事。","source":{"text":"也没见这般没稍干的人，在家闲着膫子坐，平白有要没紧，来人家撞些什么。","book":"明·兰陵笑笑生《金瓶梅词话》第三十五回"},"example":{"text":"郑生好戏，手除下来，手里捏了看看，～的，把小槌敲他两下。","book":"明·凌濛初《初刻拍案惊奇》卷二十六"},"usage":"作谓语、定语、状语；用于口语"},{"id":25476,"word":"有触即发","pinyin":"yǒu chù jí fā","abbr":"ycjf","explanation":"触：碰；即：就。原指把箭扣在弦上，拉开弓等着射出去。比喻事态发展到了十分紧张的阶段，稍一触动就立即会爆发。","source":{"text":"言是伤春，意是忆别，此恨有触即发，全不注在澹翁也。","book":"清·陈洵《海绡说词·忆旧游送人犹未苦》"},"example":{"text":"讵合肥欲施其一网打尽之计，是以～，为徐树铮之故，为安福部之故。","book":"蔡东藩、许廑父《民国通俗演义》第一百十七回"}},{"id":25477,"word":"有言在先","pinyin":"yǒu yán zài xiān","abbr":"yyzx","explanation":"有话说在头里。指事先打了招呼。","source":{"text":"他有言在先，你今日不须惊怕。","book":"明·冯梦龙《醒世恒言》卷二十二"},"example":{"text":"况且你们已经～，又何得反悔？","book":"清·吴趼人《痛史》第七回"},"similar":["有言在前"],"usage":"作谓语、状语；指事先打了招呼"},{"id":25478,"word":"有言在前","pinyin":"yǒu yán zài qián","abbr":"yyzq","explanation":"已经把话说在前头。指事前打好了招呼。","source":{"text":"善继看着许多黄自之物，眼里都放出火来，恨不得抢他一锭；只是有言在前，一字也不敢开口。","book":"明·冯梦龙《喻世明言》卷十"},"example":{"text":"奴家～，与你同生同死。既然官人服毒，奴家义不独生。","book":"明·冯梦龙《醒世恒言》卷九"},"similar":["有言在先"],"usage":"作谓语、状语；指事先打了招呼"},{"id":25479,"word":"有识之士","pinyin":"yǒu shí zhī shì","abbr":"yszs","explanation":"具有才能和远见卓识的人。","source":{"text":"天下有识之士，无不为足下寒心酸鼻者，千秋万岁之后，庙堂必不血食矣。","book":"汉·刘向《说苑·善说》"},"example":{"text":"～皆谓陛下厌闻人言，意轻边事，其兆见于此矣。","book":"宋·苏轼《朝辞赴定州状》"},"usage":"作主语、宾语；指有见识的人"},{"id":25480,"word":"有话便长，无话便短","pinyin":"yǒu huà biàn cháng，wú huà biàn duǎn","abbr":"yhbzwhbd","explanation":"话多就长说，话少就短说。一般为说书人的套话，指故事多就多讲，故事少就少讲。","source":{"text":"有话便长，无话便短。转瞬间，便到了暖寿的那一天。","book":"清·李宝嘉《官场现形记》第四回"},"example":{"text":"～。不知不觉，早又过了新年，转瞬又是元宵佳节。","book":"清·吴趼人《二十年目睹之怪现状》第五十回"}},{"id":25481,"word":"有话便长，无话就短","pinyin":"yǒu huà biàn cháng，wú huà jiù duǎn","abbr":"yhbzwhjd","explanation":"唐代以后说书艺人用语，有话要说的话，就讲得长，没话要说的话，就简单讲几句","source":{"text":"想到哪里就写到哪里，有话便长，无话就短。","book":"巴金《谈自己的创作·小序》"},"similar":["有话则长，无话则短"],"usage":"作谓语、分句；用于说话等"},{"id":25482,"word":"有话则长，无话则短","pinyin":"yǒu huà zé cháng，wú huà zé duǎn","abbr":"yhzzwhzd","explanation":"有话说就多说，无话说就短说。","source":{"text":"有话即长，无话即短，不觉过了一月有余。看看是十一月天气，连日朔风紧起，四下里彤云密布，又早纷纷扬扬飞下一天瑞雪来。","book":"明·施耐庵《水浒全传》第二十四回"},"example":{"text":"～。一天、两天、三天、四天过去了。","book":"刘流《烈火金刚》第二十八回"},"similar":["有话即长，无话即短"],"usage":"作谓语、分句；用于说话等"},{"id":25483,"word":"有话即长，无话即短","pinyin":"yǒu huà jí cháng，wú huà jí duǎn","abbr":"yhjzwhjd","explanation":"讲的多就多讲，讲的少就短讲。","source":{"text":"有话即长，无话即短，不觉过了一月有余。看看是十一月天气，连日朔风紧起，四下里彤云密布，又早纷纷扬扬飞下一天瑞雪来。","book":"明·施耐庵《水浒全传》第二十四回"},"example":{"text":"～，不觉光阴似箭，日月如梭，又在王主人家住了半年之上。","book":"明·冯梦龙《警世通言》卷二十八"},"similar":["有话便长，无话就短"],"usage":"作谓语、分句；用于说话等"},{"id":25484,"word":"有说有笑","pinyin":"yǒu shuō yǒu xiào","abbr":"ysyx","explanation":"连说带笑。形容十分欢快。","source":{"text":"想起昨天晚上，还是有说有笑，相亲相爱的何等有趣，今天晚上变了这个情形。","book":"清·吴趼人《情变》第五回"},"example":{"text":"林边场园里，晒豆子的，打芝麻的，剥包米的，到处～，是一派热闹的丰收景象。","book":"《猎户》"},"similar":["说说笑笑"],"usage":"作谓语、定语、状语；用于处事"},{"id":25485,"word":"有负众望","pinyin":"yǒu fù zhòng wàng","abbr":"yfzw","explanation":"指辜负众人的期望。","example":{"text":"我没能完成任务，真是～。"},"usage":"作谓语、定语；用于口语"},{"id":25486,"word":"有财有势","pinyin":"yǒu cái yǒu shì","abbr":"ycys","explanation":"既有钱财，又有势力。同“有钱有势”。","source":{"text":"比如一边有财有势，那趋财慕势的多只向一边去。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"example":{"text":"计氏不肯降心，珍哥不肯逊让，晁大舍虽然～，如此家反宅乱，也甚不成人家。","book":"清·西周生《醒世姻缘传》第一回"},"similar":["有钱有势"],"usage":"作谓语、定语；用于书面语"},{"id":25487,"word":"有过之无不及","pinyin":"yǒu guò zhī wú bù jí","abbr":"ygzwbj","explanation":"过：超过；及：赶上。相比之下，只有超过而没有赶不上的。","source":{"text":"子曰：‘师也过，商也不及。","book":"先秦·孔子《论语·先进》"},"example":{"text":"刻一册稿，娶一个小，则甬东风气，较明末～。","book":"清·平步青《霞外捃屑·格言·刻稿娶小》"},"opposite":["过犹不及"],"usage":"作宾语、谓语、定语；用于人、事物的比较"},{"id":25488,"word":"有过之而无不及","pinyin":"yǒu guò zhī ér wú bù jí","abbr":"ygzewbj","explanation":"过：超过；及：赶上。相比之下，只有超过而不会不如。","source":{"text":"予时亦以省试官待罪廷中，目睹盛事，谓景伯十年凤池，名位视其父有过之无不及者。","book":"《论语·先进》：“子曰：‘师也过，商也不及。’”宋·杨万里《静庵记》"},"example":{"text":"自古以来，做官越做越富，教书越教越穷。到了中华民国，更是～。","book":"杨沫《青春之歌》第二部第二十七章"},"similar":["有过之无不及"],"usage":"作谓语、定语；多用于口语"},{"id":25489,"word":"有过之，无不及","pinyin":"yǒu guò zhī，wú bù jí","abbr":"ygzwbj","explanation":"过：超过；及：赶上。相比之下，只有超过而不会不如。","source":{"text":"予时亦以省试官待罪廷中，目睹盛事，谓景伯十年凤池，名位视其父有过之无不及者。","book":"《论语·先进》：“子曰：‘师也过，商也不及。’”宋·杨万里《静庵记》"},"example":{"text":"视子庸原作～，实文界革命一骁将也。（清·梁启超《饮冰室诗话》六十七）"}},{"id":25490,"word":"有进无退","pinyin":"yǒu jìn wú tuì","abbr":"yjwt","explanation":"只有前进，没有后退。","source":{"text":"军中无戏言！吾二人当亲冒矢石，昼夜攻之，有进无退。","book":"明·冯梦龙《东周列国志》第六十一回"},"example":{"text":"左右横排断后刀，～退则杀。","book":"清·黄遵宪《冯将军歌》"},"similar":["勇往直前"],"opposite":["临阵脱逃"],"usage":"作谓语、定语；指没有退路"},{"id":25491,"word":"有道之士","pinyin":"yǒu dào zhī shì","abbr":"ydzs","explanation":"明白事理的人。","source":{"text":"有道之士，贵以近知远，以今知古，以所见知所不见。","book":"战国·卫·吕不韦《吕氏春秋·察今》"},"example":{"text":"我们愿意结识～。"},"similar":["有识之士"],"usage":"作主语、宾语；指有识之士"},{"id":25492,"word":"有酒胆，无饭力","pinyin":"yǒu jiǔ dǎn，wú fàn lì","abbr":"yjdwfl","explanation":"形容表面上显得强大，实际上却很虚弱。","source":{"text":"薛蟠本是个怜新弃旧的人，且是有酒胆无饭力的，如今得了这样一个妻子，正在新鲜兴头上，凡事未免尽让他些。","book":"清·曹雪芹《红楼梦》第七十九回"},"usage":"作谓语、定语；多用于口语"},{"id":25493,"word":"有鉴于此","pinyin":"yǒu jiàn yú cǐ","abbr":"yjyc","explanation":"鉴：借鉴。指借鉴于这一点。","example":{"text":"鉴：借鉴。指借鉴于这一点。"}},{"id":25494,"word":"有钱买马，没钱置鞍","pinyin":"yǒu qián mǎi mǎ，wú qián zhì ān","abbr":"yqmmmqza","explanation":"置：买；鞍：骑马用的鞍子。花大钱买了马，却舍不得买个马鞍子。比喻钱财使用不当。","source":{"text":"你看这‘有钱买马，没钱置鞍’事么！有本儿开铺子，倒没有厨柜了。","book":"清·西周生《醒世姻缘传》第七十一回"},"usage":"作宾语、定语；多用于比喻句"},{"id":25495,"word":"有钱使得鬼推磨","pinyin":"yǒu qián shǐ dé guǐ tuī mò","abbr":"yqsdgtm","explanation":"俗语。形容有了钱，什么事情都可能办到，金钱万能。","source":{"text":"有钱可使鬼，而况人乎。","book":"晋·鲁褒《钱神论》"},"example":{"text":"正是官无三日紧，又道是～。","book":"明·冯梦龙《喻世明言》卷十五"},"similar":["有钱能使鬼推磨"],"usage":"作宾语、定语、分句；指金钱的作用"},{"id":25496,"word":"有钱有势","pinyin":"yǒu qián yǒu shì","abbr":"yqys","explanation":"既有钱财，又有势力。","source":{"text":"毛太公那厮，有钱有势。","book":"明·施耐庵《水浒传》第49回"},"example":{"text":"他有一个～的老爸。"},"similar":["有权有势"],"opposite":["无钱无势","穷困潦倒"],"usage":"作谓语、定语；指权势"},{"id":25497,"word":"有钱能使鬼推磨","pinyin":"yǒu qián néng shǐ guǐ tuī mò","abbr":"yqnsgtm","explanation":"俗语。形容有了钱，什么事情都可能办到，金钱万能。","source":{"text":"有钱可使鬼，而况人乎。","book":"晋·鲁褒《钱神论》"},"example":{"text":"～，一分钱钞一分货。（明·沈璟《义侠记·萌奸》）"},"similar":["钱能通神","金钱万能"],"usage":"作宾语、定语、分句；指金钱的作用"},{"id":25498,"word":"有长者风","pinyin":"yǒu zhǎng zhě fēng","abbr":"yzzf","explanation":"长者：年高望重之人。有长者的风度。形容人的品德高尚，待人大度。","source":{"text":"铨学涉有长者风，与卢玄、高允等同被征为中书博士。","book":"《魏书·杜铨传》"},"example":{"text":"荆州刘皇叔，与主公同宗，仁慈宽厚，～。","book":"明·罗贯中《三国演义》第六十回"},"usage":"作谓语、定语；用于处事"},{"id":25499,"word":"有问必答","pinyin":"yǒu wèn bì dá","abbr":"ywbd","explanation":"有什么问题都给以解答。","source":{"text":"他是陈国太史，兼宫中答应，也是满腹经纶，一肚子知识之人，博学得到了有问必答、不问也答的地步。","book":"钱宁《圣人》第17章"},"example":{"text":"老师对学生提出的问题应该有问必答。"},"similar":["一问一答","谆谆教诲"],"opposite":["问而不答","一问三不知","不耻下问"],"usage":"作谓语、定语、宾语；指解答"},{"id":25500,"word":"有间可乘","pinyin":"yǒu jiàn kě chéng","abbr":"yjkc","explanation":"间：空隙。有空子可钻。","source":{"text":"济、季安与承宗事体不殊，若物故之际，有间可乘，当临事图之。","book":"唐·李绛《论河北三镇及淮西事宜状》"},"example":{"text":"～，即便齐糗，衔枚连夜速发，当此之时，却须舍却身家，有死无生，有进无退。","book":"明·王守仁《剿捕漳寇方略牌》"}},{"id":25501,"word":"有闻必录","pinyin":"yǒu wén bì lù","abbr":"ywbl","explanation":"闻：听到的；录：记录。听到什么，不管对不对，全都记录下来。","source":{"text":"不过照着有闻必录的例儿，姑且的留资谈助。","book":"清·张春帆《宦海》第十一回"},"example":{"text":"小说的功效原来在借部分以暗示全体，既不是新闻纸的～，也不同于历史的不能放过巨奸大憝。","book":"茅盾《从牯岭到东京》"},"similar":["有案可稽"],"opposite":["听而不闻","充耳不闻"],"usage":"作谓语、定语；指记者"},{"id":25502,"word":"有隙可乘","pinyin":"yǒu xì kě chèng","abbr":"yxkc","explanation":"指事情有漏洞可以利用。","source":{"text":"公之有行，请益兵备，机有可乘，虽烹可畏。","book":"《秦并六国平话》卷中：“万一有隙可乘，如蚌鹬相持，只为渔者之利耳。”宋·楼钥《攻媿集》卷九十五"},"example":{"text":"今魏～，不就此时伐之，更等何时？（明·罗贯中《三国演义》第一百十回）"},"similar":["无孔不入","有机可乘","有隙可趁"],"opposite":["无隙可乘"],"usage":"作谓语、宾语；指有漏洞"},{"id":25503,"word":"有隙可趁","pinyin":"yǒu xì kě chèn","abbr":"yxkc","explanation":"隙：空隙。指事情有漏洞可以利用","source":{"text":"今既有隙可趁，这事是决意要做的！","book":"清·李百川《绿野仙踪》第76回"},"similar":["有隙可乘","有机可乘"],"usage":"作谓语、宾语；指有漏洞"},{"id":25504,"word":"有风方起浪","pinyin":"yǒu fēng fāng qǐ làng","abbr":"yffql","explanation":"比喻事情的发生总是有一定原因的。","source":{"text":"‘有风方起浪，无潮水自平。’你不惹我，我好寻你？只因你狐群狗党，结为一伙，算计吃我师父，所以来此施为。","book":"明·吴承恩《西游记》第七十五回"}},{"id":25505,"word":"有风有化","pinyin":"yǒu fēng yǒu huà","abbr":"yfyh","explanation":"指有教育意义。","source":{"text":"论《六经》，《诗经》最葩，闺门内许多风雅……有风有化，宜室宜家。","book":"明·汤显祖《牡丹亭·闺塾》"},"usage":"作谓语、定语；用于书面语"},{"id":25506,"word":"有首有尾","pinyin":"yǒu shǒu yǒu wěi","abbr":"ysyw","explanation":"首：头。有开头，有结尾。做事能坚持到底。指故事或文章结构完整","source":{"text":"做得一章有头有尾，与今日学者有头无尾底不同。","book":"宋·朱熹《朱子全书·论语四·公冶长》"},"example":{"text":"《哨遍·思考和练习》：“全套必须同一宫调，～，一韵到底。”"},"similar":["有头有尾"],"opposite":["有头无尾"],"usage":"作谓语、定语、状语；用于处事等"},{"id":25507,"word":"有鼻子有眼","pinyin":"yǒu bí zi yǒu yǎn","abbr":"ybzyy","explanation":"比喻把虚构的事物说得象真实的一样。","source":{"text":"计策的内容和保证是：要求每个前去执行任务的小伙子大胆说谎话，而且谎话要说得有鼻子有眼，真龙活现，毫不含糊。","book":"柳杞《好年胜景》四"},"example":{"text":"他把此事说得～。"},"similar":["神乎其神"],"opposite":["千真万确"],"usage":"作谓语、定语、状语；用于说谎话"},{"id":25508,"word":"有龙则灵","pinyin":"yǒu lóng zé líng","abbr":"ylzl","explanation":"水潭有了龙就成为灵异的水","source":{"text":"水不在深，有龙则灵。","book":"唐·刘禹锡《陋室铭》"},"example":{"text":"王一奇《中国文人传说故事·》：“写了一篇小屋陋室的赞文，正写到‘……水不在深，有龙则灵。斯是陋室，惟吾德馨’时……”"},"similar":["有仙则名"],"usage":"作谓语、定语；用于书面语"},{"id":25509,"word":"朋党之争","pinyin":"péng dǎng zhī zhēng","abbr":"pdzz","explanation":"朋党：同类的人为怎么目的而相勾结。指封建士大夫为争权夺利，排斥异己而结合起来的集团之间的互相斗争。","source":{"text":"朋党比周，以环主图私为务，是篡臣者也。","book":"《荀子·臣道》"},"example":{"text":"吴老总兵自从边关退役回京养老，就参与朝廷的～，东林与复社是朝中两个水火不相容的派别。","book":"三月夫《吴三贵》七"},"usage":"作主语、宾语；用于人"},{"id":25510,"word":"朋党执虎","pinyin":"péng dǎng zhí hǔ","abbr":"pdzh","explanation":"朋党：同类的人为怎么目的而相勾结；执：捉。比喻小人结党营私，危害正义事业。","source":{"text":"夫众煦漂山，聚蟁成雷，朋党执虎，十夫挠椎，是以文王拘于牖里，孔子厄于陈蔡。","book":"《汉书·中山靖王胜传》"}},{"id":25511,"word":"朋党比周","pinyin":"péng dǎng bǐ zhōu","abbr":"pdbz","explanation":"结党营私，排斥异己。","source":{"text":"朋党比周，以环主图私为务，是篡臣者也。","book":"《荀子·臣道》"},"example":{"text":"礼义廉耻，阙而不思，～，靡然成俗，任之以学斅，而败官以墨者方兴。","book":"宋·曾巩《相制二》"},"similar":["阿党比周","结党营私"],"usage":"作谓语、补语；指结党营私，排斥异己"},{"id":25512,"word":"朋坐族诛","pinyin":"péng zuò zú zhū","abbr":"pzzz","explanation":"坐：坐罪，判以罪名并给予惩罚；族：家族；诛：杀掉。有点朋友关系的人被判罪，整个家族都被杀掉。指株连治罪，残酷镇压。","source":{"text":"头会箕敛，欲壑靡穷，朋坐族诛，淫刑以逞；矿产鬻而国财空，民党戮而元气尽。","book":"孙中山《讨袁檄文》"},"similar":["株连九族"],"usage":"作宾语、定语；用于刑罚等"},{"id":25513,"word":"朋心合力","pinyin":"péng xīn hé lì","abbr":"pxhl","explanation":"朋：同。团结一致，共同努力。","source":{"text":"李杜司职，朋心合力。","book":"南朝·宋·范晔《后汉书·李固杜乔传赞》"},"similar":["同心合力"],"usage":"作谓语、定语、状语；指齐心协力"},{"id":25514,"word":"朋比为奸","pinyin":"péng bǐ wéi jiān","abbr":"pbwj","explanation":"朋比：依附。互相勾结。坏人勾结在一起干坏事。","source":{"text":"趋利之人，常为朋比，同其私也。","book":"《新唐书·李绛传》"},"example":{"text":"平时与古老三～，也非一次。","book":"清·姬文《市声》第二十三回"},"similar":["狼狈为奸","沆瀣一气","同流合污"],"opposite":["群策群力","同心协力"],"usage":"作谓语、定语；指狼狈为奸"},{"id":25515,"word":"朋比作奸","pinyin":"péng bǐ zuò jiān","abbr":"pbzj","explanation":"坏人勾结在一起干坏事。同“朋比为奸”。","source":{"text":"且君为臣之标率，君不向道，臣下将化之，而朋比作奸，天下事尚忍言哉？","book":"明·许仲琳《封神演义》第二回"},"example":{"text":"南京给事中陈嘉训等极论二人阴有所恃，～，当亟斥之，而听纯归，以全大臣之体。","book":"《明史·温纯传》"},"similar":["朋比为奸"],"usage":"作谓语、定语；指狼狈为奸"},{"id":25516,"word":"朋酒之会","pinyin":"péng jiǔ zhī huì","abbr":"pjzh","explanation":"朋酒：朋友聚会畅饮。朋友欢饮的聚会。","source":{"text":"性不解音，而畜素琴一张，弦徽不具，每朋酒之会，则抚而和之。","book":"《晋书·陶潜传》"},"usage":"作主语、宾语；用于聚会等"},{"id":25517,"word":"服低做小","pinyin":"fú dī zuò xiǎo","abbr":"fdzx","explanation":"形容低声下气，巴结奉承。","source":{"text":"我又索含容折节，屈脊躬身，伏低做小，跪膝在尘埃。","book":"元·李文蔚《圯桥进履》第二折"},"example":{"text":"她就是没有～的想法，这让他很为难。"},"similar":["做小服低"],"usage":"作谓语、定语；指甘愿处于低下的地位"},{"id":25518,"word":"服冕乘轩","pinyin":"fú miǎn chéng xuān","abbr":"fmcx","explanation":"冕：古代天子、诸侯及达官显宦戴的礼帽；轩：有车厢或帷幔的车。指做官后飞黄腾达。","source":{"text":"身登三阁，宦成两宫。服冕乘轩，仰齿贵游。振景拔迹，顾邈同列。","book":"《左传·哀公十五年》：“苟使我入获国，服冕乘轩，三死无与。”晋·陆机《谢平原内史表》"},"example":{"text":"子母经年分散，喜芸窗脱迹，～。","book":"明·高濂《玉簪记·合庆》"},"usage":"作谓语、定语、宾语；用于官场"},{"id":25519,"word":"服服帖帖","pinyin":"fú fú tiē tiē","abbr":"fftt","explanation":"指让人信服或物品平整。","source":{"text":"我们取得那么大的胜利，人家服服贴贴，敲锣打鼓。","book":"毛泽东《做革命的促进派》"},"example":{"text":"我把他治得～的。"},"similar":["心服口服"],"usage":"作谓语、定语；用于人或事"},{"id":25520,"word":"服服贴贴","pinyin":"fú fú tiē tiē","abbr":"fftt","explanation":"指让人信服或物品平整","source":{"text":"我们取得那么大的胜利，人家服服贴贴，敲锣打鼓。","book":"毛泽东《做革命的促进派》"},"example":{"text":"路遥《平凡的世界》第五卷第18章：“他就立刻～承认了他的‘拳威’。”"},"similar":["心服口服","服服帖帖"],"usage":"作定语、状语；指信服或平整","story":["蒋门神依仗张团练的势力霸占施恩的酒店，施恩向武松报告蒋门神在快活林中抢夺他的酒店，称王称霸，求武松去帮忙讨回酒店。武松十分气愤，就随施恩一起去快活林，痛打蒋门神，把蒋门神收拾得服服贴贴，乖乖将酒店退回给施恩"]},{"id":25521,"word":"服气吞露","pinyin":"fú qì tūn lù","abbr":"fqtl","explanation":"服气：导引之术，即气功。指修炼道术。","source":{"text":"若论道姑修养，服气吞露，搬离运坎，施仁布义，必有成仙之日也。","book":"明·无名氏《洞玄升仙》头折"},"similar":["服气餐霞"],"usage":"作谓语、宾语、定语；用于修道"},{"id":25522,"word":"服气餐霞","pinyin":"fú qì cān xiá","abbr":"fqcx","explanation":"服气：导引之术，即气功；餐霞：指不食人间烟火。指修炼道术。","source":{"text":"服气餐霞总是空，导引劳形枉费功。","book":"明·无名氏《女真观》第二折"},"similar":["服气吞露"],"usage":"作谓语、宾语、定语；用于修道"},{"id":25523,"word":"服牛乘马","pinyin":"fú niú chéng mǎ","abbr":"fncm","explanation":"役使牛马驾车。","source":{"text":"服牛乘马，引重致远，以利天下。","book":"《周易·系辞下》"},"example":{"text":"自轩辕以来，～，今辇以人负，则人代畜。","book":"《新唐书·王求礼传》"},"usage":"作谓语、分句；用于人"},{"id":25524,"word":"服田力穑","pinyin":"fú tián lì sè","abbr":"ftls","explanation":"服：从事；穑：收获谷物。指努力从事农业生产。","source":{"text":"若农服田力穑，乃亦有秋。","book":"《尚书·盘庚上》"},"usage":"作谓语；指努力从事农业生产"},{"id":25525,"word":"朗月清风","pinyin":"lǎng yuè qīng fēng","abbr":"lyqf","explanation":"明朗的月色，清新的和风。","source":{"text":"琳琅触目，朗月清风。","book":"唐·王勃《秋日游莲池序》"},"example":{"text":"桃花流水杳然去，～到处游。","book":"清·李汝珍《镜花缘》第四十八回"},"usage":"作主语、宾语、定语；用于风景描写"},{"id":25526,"word":"朗朗上口","pinyin":"lǎng lǎng shàng kǒu","abbr":"llsk","explanation":"指诵读诗文时的声音响亮而顺口。","source":{"text":"散文就不受这么多的限制，虽然散文也讲究声调铿锵，能朗朗上口。","book":"老舍《诗与快板》"},"example":{"text":"这篇文章读起来～"},"usage":"作定语、定语；用于诗文等"},{"id":25527,"word":"朗朗乾坤","pinyin":"lǎng lǎng qián kūn","abbr":"llqk","explanation":"朗朗：明朗、清亮；乾坤：原是《周易》中的两个卦名，这里指天地、世界等。形容政治清明，天下太平。","source":{"text":"清平世界，浪荡乾坤，你怎么当街里打人。","book":"元·李文慰《燕青博鱼》第一折"},"example":{"text":"清平世界，～，要都像他们家里死了人就来讹诈起来，那还了得！","book":"清·张春帆《九尾龟》第八十五回"},"similar":["清平世界"],"usage":"作宾语、定语；用于比喻句"},{"id":25528,"word":"朗目疏眉","pinyin":"lǎng mù shū méi","abbr":"lmsm","explanation":"朗：明亮；疏：疏朗。明亮的双目和疏朗的眉毛。形容眉目清秀。","source":{"text":"神仪明秀，朗目疏眉，细形长耳。","book":"《梁书·陶弘景传》"},"example":{"text":"他那～的模样让她心动。"},"similar":["眉清目秀"],"usage":"作谓语、定语；形容眉目清秀"},{"id":25529,"word":"朗若列眉","pinyin":"lǎng ruò liè méi","abbr":"lrlm","explanation":"朗：明亮；列眉：明白。形容非常明白。","source":{"text":"吾必不听众口与谗言，吾信汝也，犹列眉也。","book":"西汉·刘向《战国策·燕策》"},"example":{"text":"复有施子济群为之加评；～，固不待余之词费矣。","book":"赵苕狂《〈江湖奇侠传》原序〉"},"usage":"作谓语；指非常明白"},{"id":25530,"word":"望云之情","pinyin":"wàng yún zhī qíng","abbr":"wyzq","explanation":"比喻思念父母的心情。","source":{"text":"仁杰登奇太行山，反顾，见白云孤飞，谓左右曰：‘吾亲舍其下。’瞻怅久之。云移乃得去。","book":"《新唐书·狄仁杰传》"},"usage":"作宾语；指思念父母的心情"},{"id":25531,"word":"望其肩背","pinyin":"wàng qí jiān bèi","abbr":"wqjb","explanation":"犹望其肩项。形容赶得上或达得到。","source":{"text":"德器必能脱去凡近，所造日高，非弟所能望其肩背也。","book":"清·吕留良《与吴孟举书》"},"similar":["望其项背","望其肩项"],"usage":"作谓语、定语；用于书面语"},{"id":25532,"word":"望其肩项","pinyin":"wàng qí jiān xiàng","abbr":"wqjx","explanation":"形容赶得上或达得到。","source":{"text":"愚谓荆公古文，直逼昌黎，宋人不敢～。 ★清·袁枚《随园诗话》卷一"},"similar":["望其项背","望其肩背"],"usage":"作谓语、定语；用于书面语"},{"id":25533,"word":"望其项背","pinyin":"wàng qí xiàng bèi","abbr":"wqxb","explanation":"项：颈的后部。望见他的颈项和后背。比喻赶得上。","source":{"text":"言论之超卓雄伟，真有与诗书六艺相表里者，非后世能文章家所得望其肩项也。","book":"清·汪琬《与周处士书》"},"example":{"text":"他已窥破喜奎和小雀儿的深情密爱，万万不是本人所能～。","book":"蔡东藩、许厪父《民国通俗演义》第一百二十七回"},"similar":["望其肩项"],"usage":"作谓语、定语；用于书面语"},{"id":25534,"word":"望子成名","pinyin":"wàng zǐ chéng míng","abbr":"wzcm","explanation":"望：盼望。希望自己的子女能在学业和事业上有成就。","source":{"text":"无如望子成名，比自己功名念切，还加几倍。","book":"清·文康《儿女英雄传》第三十六回"},"similar":["望子成龙"],"usage":"作谓语、定语；指父母的期望"},{"id":25535,"word":"望子成龙","pinyin":"wàng zǐ chéng lóng","abbr":"wzcl","explanation":"望：盼望。希望自己的子女能在学业和事业上有成就。","source":{"text":"无如望子成名，比自己功名念切，还加几倍。","book":"清·文康《儿女英雄传》第三十六回"},"example":{"text":"家长要有～的愿望，更要有培养和教育孩子成材的行动。"},"similar":["望女成凤","望子成名"],"usage":"作谓语、定语；指父母的期望"},{"id":25536,"word":"望尘不及","pinyin":"wàng chén bù jí","abbr":"wcbj","explanation":"比喻远远落在后面。同“望尘莫及”。","source":{"text":"顿悟捷得……故朋昔类，望尘不及，皆靡弛而逝矣。","book":"《后汉书·赵咨传》：“［咨］复拜东海相，之官，道经荥阳，令敦煌曹暠，咨之故孝廉也，迎路谒候。咨不为留，暠送至亭次，望尘不及。”宋·叶適《周君南仲墓志铭》"},"example":{"text":"长洲乃是省会首县，较之吴江已占风气之先，而且贾家住的乃是乡间，更觉～。","book":"清·李宝嘉《文明小史》第十四回"},"similar":["望尘莫及","望尘靡及"],"opposite":["后来居上"],"usage":"作宾语、定语；同“望尘莫及”","story":["东汉时期，敦煌太守赵咨推荐曹暠任荥阳县令，赵咨调往东海任职经过荥阳时，曹暠等在路口迎候，想请他在荥阳暂住。赵咨不想惊动别人就没有停留，车子很快就过去。曹暠想送他到城外的十里长亭，可追到长亭，赵咨的车子早就望尘莫及"]},{"id":25537,"word":"望尘僄声","pinyin":"wàng chén piào shēng","abbr":"wcps","explanation":"比喻听见风就是雨，不辨事情的虚实真伪。","source":{"text":"且闾阎凡品，何独识哉？苟望尘僄声而已矣。观其论也，非能本闺闲之行迹，察臧否之虚实也。","book":"汉·王符《潜夫论·贤难》"},"similar":["见风是雨"],"usage":"作谓语、定语、宾语；用于处事"},{"id":25538,"word":"望尘僩声","pinyin":"wàng chén bù shēng","abbr":"wcbs","explanation":"比喻听见风就是雨，不辨事情的虚实真伪。"},{"id":25539,"word":"望尘奔北","pinyin":"wàng chén bēn běi","abbr":"wcbb","explanation":"形容军无斗志。同“望尘奔溃”。","source":{"text":"望尘奔北，闻敌失魄。","book":"晋·葛洪《抱朴子·行品》"},"similar":["望尘奔溃"],"usage":"作谓语、定语；多用于处事等"},{"id":25540,"word":"望尘奔溃","pinyin":"wàng chén bēn kuì","abbr":"wcbk","explanation":"指只看见敌方军马扬起的尘土便奔逃溃散。形容军无斗志。亦作“望尘奔北”。","source":{"text":"诸军同日皆监江，所过城邑，莫不望尘奔溃，其降附者不可胜数。","book":"《北史·魏纪二·太武帝》"},"similar":["望尘奔北"],"usage":"作谓语、定语；多用于处事等"},{"id":25541,"word":"望尘拜伏","pinyin":"wàng chén bài fú","abbr":"wcbf","explanation":"形容卑躬屈膝的神态。同“望尘而拜”。","source":{"text":"时高肇权重，天下之士望尘拜伏。","book":"《北史·魏任城王云传》"},"example":{"text":"神秀所到之处，王公士庶～，每天受上万人的礼拜。","book":"范文澜《〈唐代佛教〉引言》"},"similar":["望尘而拜"],"usage":"作谓语、定语；指敬畏的神态"},{"id":25542,"word":"望尘知敌","pinyin":"wàng chén zhī dí","abbr":"wczd","explanation":"尘：尘土；敌：敌人；知：知道。望见飞扬的尘土就知道敌兵的多少。形容经验非常丰富。","source":{"text":"周德威为人勇而多知，能望尘知敌。","book":"《新五代史·唐臣传》"},"example":{"text":"临军望尘知敌数，对垒嗅土识兵机。","book":"元·郑光祖《三战吕布》第三折"}},{"id":25543,"word":"望尘而拜","pinyin":"wàng chén ér bài","abbr":"wceb","explanation":"指迎候有权势的人，看见车扬起的尘土就下拜。形容卑躬屈膝的神态。","source":{"text":"与石崇等诌事贾谧，每侯其出，与崇辄望尘而拜。","book":"《晋书·潘岳传》"},"example":{"text":"士于兹时蕲一～，犹恐无因而至前。","book":"宋·张孝祥《刘西府》"},"similar":["望尘拜伏"],"usage":"作谓语、定语；指敬畏的神态","story":["西晋时期，著作郎潘岳与大富翁石崇一起巴结奉承后军将军贾谧。他们每次在路上望见贾谧车辆扬起的尘土就望尘而拜。因此潘岳成了给事黄门侍郎。他不听母亲的做正直人的教诲。“八王之乱”后贾后及贾谧倒台，潘岳被原幕僚现中书令孙秀所杀"]},{"id":25544,"word":"望尘莫及","pinyin":"wàng chén mò jí","abbr":"wcmj","explanation":"莫：不；及：赶上。望见前面骑马的人走过扬起的尘土而不能赶上。比喻远远落在后面。","source":{"text":"令敦煌曹暠，咨之故孝廉也，迎路谒候，咨不为留。暠送至亭次，望尘不及。","book":"《庄子·田子方》：“夫子奔逸绝尘，而回瞠若乎后矣。”《后汉书·赵咨传》"},"example":{"text":"闯王确实有许多非凡之处，为当今群雄所～。","book":"姚雪垠《李自成》第二卷第五十五章"},"similar":["不可企及","瞠乎其后","望尘不及"],"opposite":["后来居上"],"usage":"作谓语、定语；指远远落在后面","story":["东汉时期，敦煌太守赵咨推荐曹暠任荥阳县令，赵咨调往东海任职经过荥阳时，曹暠等在路口迎候，想请他在荥阳暂住。赵咨不想惊动别人就没有停留，车子很快就过去。曹暠想送他到城外的十里长亭，可追到长亭，赵咨的车子早就望尘莫及"]},{"id":25545,"word":"望尘追迹","pinyin":"wàng chén zhuī jì","abbr":"wczj","explanation":"比喻赶上别人的前进速度。","source":{"text":"唐虞三代甫由草昧而入文明，乃至成周，则文物已臻盛轨，其时之政治制度、道德文章、学术工艺，几与近代之欧美并驾齐驱，其进步之速，大非秦汉以后所能望尘追迹也。","book":"孙中山《建国方略·知行总论》"},"usage":"作谓语、定语；用于书面语"},{"id":25546,"word":"望尘靡及","pinyin":"wàng chén mí jí","abbr":"wcmj","explanation":"比喻远远落在后面。同“望尘莫及”。","source":{"text":"如厮隶之于贵官，负弩前驱望尘靡及耳。","book":"清·黄宗羲《移史馆熊公雨殷行状》"},"similar":["望尘不及","望尘莫及"],"usage":"作谓语、定语；指远远落在后面"},{"id":25547,"word":"望屋以食","pinyin":"wàng wū yǐ shí","abbr":"wwys","explanation":"指军行不带粮草，随处就食。同“望屋而食”。","source":{"text":"而绛灌之为丞相主国论者，故奋挺大呼望屋以食之人也，是亦安能知先王之意哉！","book":"宋·叶适《外论》"},"similar":["望屋而食"],"usage":"作谓语、定语；用于书面语"},{"id":25548,"word":"望屋而食","pinyin":"wàng wū ér shí","abbr":"wwes","explanation":"指军行不带粮草，随处就食。","source":{"text":"望屋而食，横行天下。","book":"汉·贾谊《新书·过秦》"},"example":{"text":"清·戴名世《抚盗论》：“～，创立名字，所过千里无鸡犬之声。”"},"similar":["望屋以食"],"usage":"作谓语、定语；用于书面语"},{"id":25549,"word":"望岫息心","pinyin":"wàng xiù xī xīn","abbr":"wxxx","explanation":"多指遁世隐居。亦喻知难而止息。同“望峰息心”。","source":{"text":"豫章王嶷命驾造点，点从后门遁去。司徒竟陵王子良闻之，曰：‘豫章王尚，吾当望岫息心。’","book":"《南史·何点传》"},"example":{"text":"猜嫌忽至，谤议遂成，足下深居避影，不肖亦～。","book":"明·袁宏道《与管东溟书》"},"similar":["望峰息心"],"usage":"作谓语、定语；用于处事"},{"id":25550,"word":"望峰息心","pinyin":"wàng fēng xī xīn","abbr":"wfxx","explanation":"遥望山峦巍峨而尘念随之平息。多指遁世隐居。亦喻知难而止息。","source":{"text":"鸢飞戾天者，望峰息心；经纶世务者，窥谷忘反。","book":"南朝·梁·吴均《与朱元思书》"},"similar":["望岫息心"],"usage":"作谓语、定语；用于处事"},{"id":25551,"word":"望帝啼鹃","pinyin":"wàng dì tí juān","abbr":"wdtj","explanation":"相传战国时蜀王杜宇称帝，号望帝，为蜀治水有功，后禅位臣子，退隐西山，死后化为杜鹃鸟，啼声凄切。后常指悲哀凄惨的啼哭。","source":{"text":"若没些儿灵圣与世人传，也不见得湛湛清天。我不要半星血红尘洒，都只在八尺旗枪素练悬。等他四下里皆瞧见，这就是咱苌弘化碧，望帝啼鹃。","book":"元·关汉卿《窦娥冤》"},"similar":["杜鹃啼血"],"usage":"作宾语、定语；指冤魂的悲鸣","story":["相传战国时期蜀王杜宇称帝，号望帝。他为蜀国治理水患立下大功，急流勇退后禅位给臣子，自己则退隐居住在西山，死后化为杜鹃鸟。到春天时昼夜不停地悲鸣，其啼声非常的凄切，直到口中吐血为止"]},{"id":25552,"word":"望影揣情","pinyin":"wàng yǐng chuāi qíng","abbr":"wycq","explanation":"指观察事物的表象即能测知其实质。"},{"id":25553,"word":"望文生义","pinyin":"wàng wén shēng yì","abbr":"wwsy","explanation":"文：文字，指字面；义：意义。不了解某一词句的确切涵义，光从字面上去牵强附会，做出不确切的解释。","source":{"text":"空谈臆说，望文生义，即或有理，亦所谓郢书燕说耳。","book":"清·张之洞《輶轩语·语学》"},"example":{"text":"不论一名一物，都要切实证据，才许你下论断，不能～。","book":"清·曾朴《孽海花》第四回"},"similar":["顾名思义","不求甚解"],"opposite":["精益求精"],"usage":"作谓语、定语、状语；用于说话或文章"},{"id":25554,"word":"望文生训","pinyin":"wàng wén shēng xùn","abbr":"wwsx","explanation":"不了解某一词句的确切涵义，光从字面上去牵强附会，做出不确切的解释。同“望文生义”。","source":{"text":"楚公子比字子干，王氏引之名字解诂以为本于牧誓‘比尔干’。此望文生训，盖亦取于批扞以为义也。","book":"汉·扬雄《法言义疏·吾子》"},"example":{"text":"若凿空悬解，～，鲜不为通人所笑。","book":"清·章太炎《小学略说》"},"similar":["望文生义"],"usage":"作谓语、定语、状语；用于说话或文章"},{"id":25555,"word":"望断白云","pinyin":"wàng duàn bái yún","abbr":"wdby","explanation":"形容想念父母。","source":{"text":"亲在河阳，仁杰在太行山，反顾，见白云孤飞，谓左右曰：‘吾亲舍其下。’瞻怅久之，云移乃得去。","book":"《新唐书·狄仁杰传》"},"similar":["白云孤飞"],"usage":"作宾语、定语；用于书面语"},{"id":25556,"word":"望杏瞻榆","pinyin":"wàng xìng zhān yú","abbr":"wxzy","explanation":"望、瞻：看。看着杏花开，看着榆钱落。比喻按耕作，不误农时。","source":{"text":"瞻榆束耒，望杏开田。","book":"《隋书·音乐志下》"},"similar":["望杏瞻蒲"],"usage":"作谓语、定语；用于书面语"},{"id":25557,"word":"望杏瞻蒲","pinyin":"wàng xìng zhān pǔ","abbr":"wxzp","explanation":"指按时令劝勉耕种。","source":{"text":"望杏敦耕，瞻蒲劝穑。","book":"南朝·陈·徐陵《徐州刺史侯安都德政碑》"},"similar":["望杏瞻榆"],"usage":"作谓语、定语；用于书面语"},{"id":25558,"word":"望梅止渴","pinyin":"wàng méi zhǐ kě","abbr":"wmzk","explanation":"原意是梅子酸，人想吃梅子就会流涎，因而止渴。后比喻愿望无法实现，用空想安慰自己。","source":{"text":"魏武行役失汲道，军皆渴，乃令曰：‘前有大梅林，饶子，甘酸可以解渴。’士卒闻之，口皆出水，乘此得及前源。","book":"南朝宋·刘义庆《世说新语·假谲》"},"example":{"text":"鸾拆书看了，虽然不曾定个来期，也当画饼充饥，～。","book":"明·冯梦龙《警世通言》卷三十四"},"similar":["画饼充饥"],"opposite":["名副其实"],"usage":"作谓语、宾语、定语；指自我安慰","story":["东汉末年，曹操带兵攻打张绣，行军途中没有水，带的水也早已喝完，士兵们渴得要命，纷纷停下乘凉，派出去找水的人也没发现水源，曹操急中生智，传令下去说前边有一梅林，时下正是产梅子的季节可以用梅子解渴，士气大振而快速前进"]},{"id":25559,"word":"望梅消渴","pinyin":"wàng méi xiāo kě","abbr":"wmxk","explanation":"原意是梅子酸，人想吃梅子就会流涎，因而止渴。后比喻愿望无法实现，用空想安慰自己。","source":{"text":"魏武行役失汲道，军皆渴，乃令曰：‘前有大梅林，饶子，甘酸可以解渴。’士卒闻之，口皆出水，乘此得及前源。","book":"南朝·宋·刘义庆《世说新语·假谲》"},"example":{"text":"玉鱼花露自清凉，涓涓在郎腹。犹胜～，对文君眉蹙。","book":"宋·赵长卿《限事近》词"},"similar":["望梅止渴"],"usage":"作谓语、宾语、定语；指自我安慰"},{"id":25560,"word":"望梅阁老","pinyin":"wàng méi gé lǎo","abbr":"wmgl","explanation":"比喻徒有虚名之官。","source":{"text":"望梅阁老无妨渴, 画饼尚书不救饥。","book":"唐·白居易《每见吕南二郎中新文辄窃有所叹惜因成长句以咏所怀》"},"similar":["画饼尚书"],"usage":"作宾语、定语；用于书面语"},{"id":25561,"word":"望洋兴叹","pinyin":"wàng yáng xīng tàn","abbr":"wyxt","explanation":"望洋：仰视的样子。仰望海神而兴叹。原指在伟大事物面前感叹自己的渺小。现多比喻做事时因力不胜任或没有条件而感到无可奈何。","source":{"text":"于是焉，河伯始旋其面目，望洋向若而叹。","book":"《庄子·秋水》"},"example":{"text":"佘念祖未到的时候，满心高兴，颇有跃跃欲试的意思，到过之后，大概情形看了一看，亦觉得～了。","book":"清·吴趼人《糊涂世界》卷六"},"similar":["无能为力","无可奈何"],"opposite":["妄自尊大"],"usage":"作谓语、宾语、定语；指叹息","story":["战国时期著名思想家庄周在一篇《秋水》的文章中讲一个河伯望洋兴叹的故事：黄河之神河伯看到秋天河水暴涨，黄河变得很宽阔，认为自己是天下最伟大的，他来到北海边，见到北海之神，感觉到自己的渺小，认为自己的想法是很可笑的"]},{"id":25562,"word":"望洋惊叹","pinyin":"wàng yáng jīng tàn","abbr":"wyjt","explanation":"望洋：仰视的样子。仰望海神而兴叹。原指在伟大事物面前感叹自己的渺小。现多比喻做事时因力不胜任或没有条件而感到无可奈何。","source":{"text":"于是焉，河伯始旋其面目，望洋向若而叹。","book":"《庄子·秋水》"},"similar":["望洋兴叹","望洋而叹"],"usage":"作谓语、宾语、定语；指叹息"},{"id":25563,"word":"望洋而叹","pinyin":"wàng yáng ér tàn","abbr":"wyet","explanation":"比喻做事时因力不胜任或没有条件而感到无可奈何。同“望洋而叹”。","source":{"text":"俟他日有持《后冈先生集》示我者，我当望洋而叹，或尾后作一二句跋语是则可耳。","book":"明·唐顺之《与陈后冈参议书》"},"example":{"text":"田北湖《论文章源流》：“太古之籍，一隙难窥，知宝不明，～，良足菲薄，盖有由来。”"},"similar":["望洋兴叹","望洋惊叹"],"usage":"作谓语、宾语、定语；指叹息","story":["战国时期著名思想家庄周在一篇《秋水》的文章中讲一个河伯望洋兴叹的故事：黄河之神河伯看到秋天河水暴涨，黄河变得很宽阔，认为自己是天下最伟大的，他来到北海边，见到北海之神，感觉到自己的渺小，认为自己的想法是很可笑的"]},{"id":25564,"word":"望然而去之","pinyin":"wàng rán ér qù zhī","abbr":"wreqz","explanation":"望：看；去：离去。形容看一眼就走开的情状。","source":{"text":"推恶恶之心，思与乡人立，其冠不正，望望然而去之，若将浼焉。","book":"《孟子·公孙丑上》"},"example":{"text":"应童子试，不售，觉呫嗫非丈夫事，望～，乃从事于长枪大戟，，驰马试剑。","book":"清·文康《儿女英雄传》第三十九回"}},{"id":25565,"word":"望眼将穿","pinyin":"wàng yǎn jiāng chuān","abbr":"wyjc","explanation":"眼睛都要望穿了。形容盼望殷切。同“望眼欲穿”。","source":{"text":"楼台簇簇疑蓬岛，野人只合其中老。别来已是二十年，东望眼将穿。","book":"唐·白居易《寄微之》诗：“白头吟处变，青眼望中穿。”宋·潘阆《酒泉子》词"},"example":{"text":"一连数日，潘生～，未得其便。","book":"明·冯梦龙《醒世恒言》卷二十八"},"similar":["望眼欲穿"],"usage":"作谓语、定语、状语；用于盼望人"},{"id":25566,"word":"望眼欲穿","pinyin":"wàng yǎn yù chuān","abbr":"wyyc","explanation":"眼睛都要望穿了。形容盼望殷切。","source":{"text":"饥望炊烟眼欲穿，可人最是一青帘。","book":"唐·白居易《寄微之》诗：“白头吟处变，青眼望中穿。”宋·杨万里《晨炊横塘桥酒家小窗》诗"},"example":{"text":"但他架上眼镜，仍旧接受了她的央告。正如他对付其他一批批～的抗属一样。","book":"沙汀《呼嚎》"},"similar":["望穿秋水","无能为力","力所不及"],"opposite":["左右逢源"],"usage":"作谓语、定语、状语；用于盼望人"},{"id":25567,"word":"望秋先陨","pinyin":"wàng qiū xiān yǔn","abbr":"wqxy","explanation":"指草木将近秋天即败落凋零。也比喻未老先衰。","source":{"text":"岭峤微草，凌冬不凋；并、汾乔木，望秋先陨；诸越则桃李冬实，朔漠则桃李夏荣。","book":"宋·沈括《梦溪笔谈·采草药》"},"similar":["望秋先零"],"usage":"作谓语、定语；指未老先衰"},{"id":25568,"word":"望秋先零","pinyin":"wàng qiū xiān líng","abbr":"wqxl","explanation":"零：凋零。望见秋天将到就先凋零了。比喻体质弱，经不起风霜。也比喻未老先衰。","source":{"text":"松柏之姿，经霜犹茂。臣蒲柳之质，望秋先零，受命之异也。","book":"南朝·宋·刘义庆《世说新语·语言》"},"example":{"text":"孱躯衰备，～，月来眠食起居，尚与南中无甚歧异。","book":"清·张集馨《道咸宦海见闻录·张安保来函》"},"similar":["未老先衰","望秋先陨"],"usage":"作谓语、定语；指未老先衰","story":["晋朝时期，尚书右丞顾悦与简文帝（司马昱）同岁，文帝头发全黑，而顾悦头发全白了。文帝问他为什么头发先白？顾悦回答道：“皇帝您是松柏之姿，经霜犹茂；臣是蒲柳之质，望秋先零。”文帝听后十分高兴"]},{"id":25569,"word":"望空捉影","pinyin":"wàng kōng zhuō yǐng","abbr":"wkzy","explanation":"犹言捕风捉影。比喻言论行动以似是而非的迹象为依据。","source":{"text":"只凭数句之话，望空捉影，以陷臣罪。","book":"明·冯梦龙《醒世恒言》第二十七卷"},"similar":["捕风捉影","系风捉影"],"usage":"作谓语、定语、宾语；多用于比喻句"},{"id":25570,"word":"望穿秋水","pinyin":"wàng chuān qiū shuǐ","abbr":"wcqs","explanation":"秋水：比喻人的眼睛。眼睛都望穿了。形容对远地亲友的殷切盼望。","source":{"text":"望穿他盈盈秋水，蹙损他淡淡春山。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"听蕉声一阵一阵细雨下，何处与人闲嗑牙？～，不见还家，潸潸泪似麻。","book":"清·蒲松龄这《聊斋志异·凤阳士人》"},"similar":["望眼欲穿"],"usage":"作谓语、宾语、定语；形容对远方亲友"},{"id":25571,"word":"望而却步","pinyin":"wàng ér què bù","abbr":"weqb","explanation":"却步：不敢前进，向后退。形容事物可怕或讨厌，使人一看就往后退缩。","source":{"text":"且以裕蛊所为，思之痛心，望之却步。","book":"明·徐光启《复周无逸学宪》"},"example":{"text":"使你自然而然的～。","book":"李劼人《天魔舞》第17章"},"similar":["望而生畏","畏葸不前"],"opposite":["勇往直前"],"usage":"作谓语、宾语；指知难而退"},{"id":25572,"word":"望而生畏","pinyin":"wàng ér shēng wèi","abbr":"wesw","explanation":"畏：恐惧，害怕。看见了就害怕。","source":{"text":"君子正其衣冠，尊其瞻视，俨然人望而畏之，斯不亦威而不猛乎？","book":"《论语·尧曰》"},"example":{"text":"加上他那黑而峻厉的面孔，颇使我～。","book":"孙犁《远的怀念》"},"similar":["望而却步","退避三舍"],"opposite":["无所畏惧"],"usage":"作谓语；用于人"},{"id":25573,"word":"望衡对宇","pinyin":"wàng héng duì yǔ","abbr":"whdy","explanation":"衡：用横木做门，引申为门；宇：屋檐下，引申为屋。形容住处相距很近，可以互相望见。","source":{"text":"司马德操宅洲之阳，望衡对宇，欢情自接。","book":"北魏·郦道元《水经注·沔水》"},"example":{"text":"适有锻铁者求彭信甫书门联，信甫戏出此二句与之。两家～，见者无不失笑。","book":"清·纪昀《阅微草堂笔记·滦阳续录五》"},"similar":["衡宇相望","门当户对"],"opposite":["千里迢迢","天南地北"],"usage":"作谓语；用于彼此之间特别近"},{"id":25574,"word":"望表知里","pinyin":"wàng biǎo zhī lǐ","abbr":"wbzl","explanation":"通过观察事物的表面现象推知本质。","source":{"text":"若夫神龙负卦，瑞雀衔书，安釐王汲冢之文，穆天子羽陵之籍，莫不因条报叶，望表知里。","book":"晋·潘岳《西征赋》：“或披发左衽，奋迅泥潭，或从容傅会，望表知里。”唐·杨炯《从甥梁锜墓志铭》"},"example":{"text":"斯皆言近而旨者，辞浅而义深。虽发语已殚，而含义未尽，使夫读者望表而知里，扪毛而辨骨，睹一事于句中，反三隅于字外。","book":"唐·刘知幾《史通·叙事》"},"usage":"作谓语、定语；用于处事"},{"id":25575,"word":"望门大嚼","pinyin":"wàng mén dà jiáo","abbr":"wmdj","explanation":"比喻心里想而得不到手，只好用不切实际的办法来安慰自己。","source":{"text":"人闻长安乐，则出门而向西笑；知肉味美，则对屠门而大嚼。","book":"汉·桓谭《新论》"},"example":{"text":"盈盈一水间，脉脉不得语。～，我劳如何！","book":"清·梁启超《过渡时代论》"}},{"id":25576,"word":"望门投止","pinyin":"wàng mén tóu zhǐ","abbr":"wmtz","explanation":"投止：投宿。在窘迫中见有人家就去投宿。比喻情况急迫，来不及选择存身的地方。","source":{"text":"俭得亡命，困迫遁走，望门投止。","book":"《后汉书·张俭传》"},"example":{"text":"你兄弟在外，隐姓埋名，或是找一个地方藏身，或是到处漂泊，～。","book":"姚雪垠《李自成》第二卷第四十章"},"similar":["急不择路","病急乱投医"],"usage":"作谓语、分句；指处境十分窘迫","story":["东汉时期，山阳督邮张俭上书告发汉桓帝身边得宠太监侯览。侯览则诬告张俭结党营私，企图叛乱。朝廷下令缉拿张俭。张俭连夜逃走，一路上，望门投止，人们都知道张俭是正人君子，纷纷冒生命危险去保护他逃难"]},{"id":25577,"word":"望门贵族","pinyin":"wàng mén guì zú","abbr":"wmgz","explanation":"望：声望；门：家族。有声望的豪门贵族。旧指富贵人家。","source":{"text":"夫名门右族，莫不由祖考忠孝勤俭以成立之，莫不由子孙顽率奢傲以覆坠之。","book":"《新唐书·柳玭传》"}},{"id":25578,"word":"望闻问切","pinyin":"wàng wén wèn qiē","abbr":"wwwq","explanation":"中医用语。望，指观气色；闻，指听声息；问；指询问症状；切；指摸脉象。合称四诊。","source":{"text":"望闻问切四字，诚为医之纲领。","book":"《古今医统》"},"example":{"text":"～是中医必经的步骤。"},"similar":["神圣工巧"],"usage":"作主语、宾语、定语；用于中医"},{"id":25579,"word":"望风响应","pinyin":"wàng fēng xiǎng yīng","abbr":"wfxy","explanation":"望：看。风：风声。看到对方有什么举动，就积极响应。","source":{"text":"是以立功之士，莫不翘足引领，望风响应。","book":"三国·魏·陈琳《檄吴将校部曲文》"},"example":{"text":"闯王起义至今，十有二载。自进人河南以来，义旗所指，百姓～，归顺如流。","book":"姚雪垠《李自成》第二卷第四十七章"},"usage":"作谓语、定语；用于处事"},{"id":25580,"word":"望风希指","pinyin":"wàng fēng xī zhǐ","abbr":"wfxz","explanation":"指说话行事见机迎合他人意旨。","source":{"text":"近司隶校尉孔羡辟大将军狂悖之弟，而有司默尔，望风希指，甚于受属。","book":"晋·陈寿《三国志·魏志·杜恕传》"},"similar":["望风希旨","望风承旨"],"usage":"作谓语、宾语；指说话行事迎合上面意旨"},{"id":25581,"word":"望风希旨","pinyin":"wàng fēng xī zhǐ","abbr":"wfxz","explanation":"指说话行事迎合上面和意旨。","source":{"text":"近司隶校尉孔羡辟大将军狂悖之弟，而有司嘿尔，望风希旨，甚于受属。","book":"《三国志·魏书·杜畿传》"},"similar":["望风希指","望风承旨"],"usage":"作谓语、宾语；用于处事"},{"id":25582,"word":"望风怀想","pinyin":"wàng fēng huái xiǎng","abbr":"wfhx","explanation":"望风：迎风；怀想：怀念。迎风远望而深切怀念。","source":{"text":"远托异国，昔人所悲，望风怀想，能不依依。","book":"汉·李陵《答苏武书》"},"example":{"text":"今之望风怀想，盖以天下大乱，亟须雄才。","book":"蔡东藩《两晋演义》第二十五回"}},{"id":25583,"word":"望风扑影","pinyin":"wàng fēng pū yǐng","abbr":"wfpy","explanation":"比喻做事没有把握，没有目标。也比喻毫无根据地盲目寻求。","source":{"text":"蒋平道：‘知道五弟向何方而去？不是望风扑影么？’","book":"清·石玉昆《三侠五义》第五十一回"},"example":{"text":"你不要～，妄加判断。"},"similar":["捕风捉影"],"usage":"作谓语、定语；指捕风捉影"},{"id":25584,"word":"望风承旨","pinyin":"wàng fēng chéng zhǐ","abbr":"wfcz","explanation":"指说话行事同机迎合他人意旨。见“望风希指”。","source":{"text":"骏戚属尊重，权要赫奕。内外有司，望风承旨。","book":"《后汉书·窦融传》：“由是朝臣震慑，望风承旨。”《晋书·石崇传》"},"example":{"text":"……因此便有些州、县～，借着应酬外国人以为巴结制台地步。","book":"清·李宝嘉《官场现形记》第五十四回"},"similar":["望风希指","望风希旨"],"usage":"作谓语、宾语；用于处事"},{"id":25585,"word":"望风披靡","pinyin":"wàng fēng pī mǐ","abbr":"wfpm","explanation":"披靡：草木随风倒伏。草一遇到风就倒伏了。比喻军队毫无斗志，老远看到对方的气势很盛，没有交锋就溃散了。","source":{"text":"天下莫不望风而靡，自尚书近臣皆结舌杜口，骨肉亲属莫不股粟。","book":"汉·司马相如《上林赋》：“应风披靡，吐芳扬烈。”《汉书·杜周传》"},"example":{"text":"我军所到之处，敌人～，人民欢声雷动。","book":"毛泽东《中国人民解放军宣言》"},"similar":["望风而逃","一触即溃"],"opposite":["所向披靡"],"usage":"作谓语、状语；指不堪一击","story":["西汉时期，文学家司马相如写《上林赋》虚设楚国的子虚和齐国乌有两人丰富的言论，极力铺陈太子上林苑的繁华。上林苑面积很大，有八条河流奔腾不息，各种珍奇禽兽无所不有。花草树木到处都是，草木随风摇荡起伏像大海中的波浪"]},{"id":25586,"word":"望风捕影","pinyin":"wàng fēng bǔ yǐng","abbr":"wfby","explanation":"比喻说话做事根据不可靠的传闻或表面现象。","source":{"text":"怎么能够身临其境，将水寨内探访明白，方好行事；似这等望风捕影，实在难以预料。","book":"清·石玉昆《三侠五义》第110回"},"example":{"text":"不论怎么不近情理，他都信以为真，并且～的把它们扩大，交给日本人。","book":"老舍《四世同堂》"},"similar":["捕风捉影"],"opposite":["有理有据"],"usage":"作谓语、定语；指捕风捉影"},{"id":25587,"word":"望风瓦解","pinyin":"wàng fēng wǎ jiě","abbr":"wfwj","explanation":"犹望风而溃。","source":{"text":"又令其众皆作中国歌，直趣贼垒。贼既不以为虞，谓有大军赴救，于是望风瓦解，郡境获宁。","book":"《周书·辛昂传》"},"example":{"text":"时太平日久，民不知兵，闻南蛮车马杀来，～。","book":"《杨家将演义》第四十一回"},"similar":["望风而溃"],"usage":"作谓语、状语；指不堪一击"},{"id":25588,"word":"望风破胆","pinyin":"wàng fēng pò dǎn","abbr":"wfpd","explanation":"望：向远看；风：风头；破胆：吓破了胆。远远地看见对方的威势，就把胆吓破了。形容军队毫无斗志，完全被敌方的气势所吓倒。","source":{"text":"今举汉中，蜀人望风破胆失守，推此而前，蜀可传檄而定。","book":"《三国志·魏志·刘晔传》"},"example":{"text":"兵法有言，围城必阙一角，宜使守兵出走，免得死斗，况有兵逃出，亦可使宛下伪主～，岂不更善？","book":"蔡东藩《后汉演义》第五回"}},{"id":25589,"word":"望风而溃","pinyin":"wàng fēng ér kuì","abbr":"wfek","explanation":"远望敌人踪影就已吓得溃散。形容军队毫无战斗力，还未接触，就已溃散。","source":{"text":"西川自唐刘辟构逆后，久无干戈，人不习战。每岁诸道差兵屯戍大渡河，蛮旗才举，望风而溃。","book":"宋·孙光宪《北梦琐言》卷五"},"example":{"text":"独乐毅自引燕军，长驱深入，所过宣谕威德，齐城皆～，势如破竹，大军直逼临淄。","book":"《东周列国志》第九十五回"},"similar":["望风而靡","望风瓦解"],"usage":"作谓语、状语；指不堪一击"},{"id":25590,"word":"望风而走","pinyin":"wàng fēng ér zǒu","abbr":"wfez","explanation":"远远望见对方的气势很盛，就吓得逃跑了。形容十分怯敌。同“望风而逃”。","source":{"text":"我直着他扑碌碌的望风而走。","book":"元·无名氏《独角牛》第一折"},"example":{"text":"曹操以百万之众，闻吾之名，～。","book":"明·罗贯中《三国演义》第六十四回"},"similar":["望风而遁"],"usage":"作谓语、状语；指望风而逃"},{"id":25591,"word":"望风而逃","pinyin":"wàng fēng ér táo","abbr":"wfet","explanation":"远远望见对方的气势很盛，就吓得逃跑了。形容十分怯敌。","source":{"text":"渊藻是萧衍骨肉至亲，必死无理，若克涪城，渊藻安肯城中坐而受困，必将望风而去。","book":"《资治通鉴·梁记·武帝天监四年》"},"example":{"text":"汝、颖、光、黄等处，有土寇王善作乱，聚兵五十万，抢掠子女玉帛，杀人放火，甚是猖獗，官兵～。","book":"清·陈忱《水浒后传》第十九回"},"similar":["望风破胆","逃之夭夭","闻风丧胆"],"opposite":["勇往直前","一往无前","临危不惧"],"usage":"作谓语、定语；指十分畏惧"},{"id":25592,"word":"望风而遁","pinyin":"wàng fēng ér dùn","abbr":"wfed","explanation":"远远望见敌人的踪影或强大气势，即行遁逃。","source":{"text":"贼识其旗帜，望风而遁。","book":"《太平广记》卷第一百九十引宋·孙光宪《北梦琐言》：“戎车未届，乃先以帛，书军号其上，仍书一符，于邮亭递之，以壮军声。蛮酋惩交阯之败，望风而遁。”《金史·温迪罕蒲里特传》"},"example":{"text":"这日离樊城不上十里，日早落了。对面忽来一游骑，车夫～。","book":"清·魏秀仁《花月痕》第四十五回"},"similar":["望风而逃","望风而走"],"usage":"作谓语、状语；指望风而逃"},{"id":25593,"word":"望风而降","pinyin":"wàng fēng ér jiàng","abbr":"wfej","explanation":"风：踪影。降：投降。看见敌人的影子便缴械投降。形容军队毫无士气。","source":{"text":"自起兵之后，所过城池望风而降。","book":"元·关汉卿《五侯宴》第三折"},"example":{"text":"使这些地面～，庶几三府十八州，都属大明。","book":"《英烈传》第七十回"},"similar":["望风披靡"],"usage":"作谓语、定语；用于军队等"},{"id":25594,"word":"望风而靡","pinyin":"wàng fēng ér mí","abbr":"wfem","explanation":"①见对方的威势就服服帖帖。形容畏惧之状。②望见对方就为之折服倾倒。形容钦敬之状。③形容军无斗志。同“望风披靡”。","source":{"text":"是以乡里长幼，望风而靡；邦国贤豪，闻名而悦服。","book":"《汉书·杜周传》：“天下莫不望风而靡，自尚书近臣皆结舌杜口，骨肉亲属莫不股栗。”唐·陈子昂《堂弟孜墓志铭》"},"example":{"text":"将士～，三四十万军马不剩得一二。","book":"明·邵璨《香囊记·败兀》"},"similar":["望风披靡"],"opposite":["所向无敌"],"usage":"作谓语、定语；指不堪一击"},{"id":25595,"word":"朝三暮二","pinyin":"zhāo sān mù èr","abbr":"zsme","explanation":"比喻主意多变。","source":{"text":"大圣听说，忍不住笑道：‘呆子莫乱谈！若论斯哈哩国，正好早哩。似师父朝三暮二的，这等担阁，就从小至老，老了又小，老小三生，也还不到。","book":"明·吴承恩《西游记》第五十九回"}},{"id":25596,"word":"朝三暮四","pinyin":"zhāo sān mù sì","abbr":"zsms","explanation":"原指玩弄手法欺骗人。后用来比喻常常变卦，反复无常。","source":{"text":"狙公赋芧，曰：‘朝三而暮四。’众狙皆怒。曰：‘然则朝四而暮三。’众狙皆悦。名实未亏而喜怒为用，亦因是也。","book":"《庄子·齐物论》"},"example":{"text":"厘定规则：怎样服役，怎样纳粮，怎样磕头，怎样颂圣。而且这规则是不象现在那样～的。","book":"鲁迅《坟·灯下漫笔》"},"similar":["朝秦暮楚","反复无常","见异思迁"],"opposite":["墨守成规","一成不变"],"usage":"作谓语、定语、状语；比喻反复无常的人","story":["传说宋国养猴人狙公养了很多猴子，猴子能够完全听懂他的话，他对猴子的生活习性与语言也完全了解，由于家境开始不济，就想限制猴子的食量，他对猴子说以后的栗子一律是“朝三暮四”，猴子不同意，就改口说“朝四暮三”，猴子满意"]},{"id":25597,"word":"朝不保夕","pinyin":"zhāo bù bǎo xī","abbr":"zbbx","explanation":"早晨不能知道晚上会变成什么样子或发生什么情况。形容形势危急，难以预料。","source":{"text":"人命危浅，朝不虑夕。","book":"晋·李密《陈情表》"},"example":{"text":"这通告示，轰动了整个固始城，津津乐道，竟似忘了身在危城，～。","book":"高阳《清宫外史》上册"},"similar":["危在旦夕","岌岌可危"],"opposite":["安然无恙","高枕无忧"],"usage":"作谓语、定语；形容形势危急","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母，尊重老人。他想启用西蜀尚书郎李密，就下诏书任命李密为郎中。李密不愿出来做官，就写《陈情表》上书，说自己与祖母相依为命，祖母的日子朝不保夕了，待伺候祖母后再出来做官"]},{"id":25598,"word":"朝不保暮","pinyin":"zhāo bù bǎo mù","abbr":"zbbm","explanation":"早晨保不住晚上会发生变化。极言情况危急或境遇窘迫。","source":{"text":"二千石长吏遇民如虏，或卖用田宅，或绝命捶楚，大小无聊，朝不保暮。","book":"晋·袁宏《后汉纪·质帝纪》"},"example":{"text":"彼恃多数之后援以执政者，时时皆有～之心，从皆怀五日京兆之想，其复何国利民福之能务也！","book":"梁启超《申论种族革命与政治革命之得失》"},"similar":["朝不保夕"],"usage":"作谓语、定语；形容形势危急"},{"id":25599,"word":"朝不及夕","pinyin":"zhāo bù jí xī","abbr":"zbjx","explanation":"形容情况危急。","source":{"text":"敝邑之急，朝不及夕。","book":"春秋·鲁·左丘明《左传·襄公十六年》"},"example":{"text":"吾侪小人，～，相时射利。","book":"宋·苏轼《三槐堂铭》"},"similar":["朝不保夕"],"usage":"作谓语、定语；指生活极端贫困"},{"id":25600,"word":"朝不图夕","pinyin":"zhāo bù tú xī","abbr":"cbtx","explanation":"图：图谋。早晨不能为晚上打算。形容形势危急或境况窘迫。","source":{"text":"某天罚深重，余息苟存，沉窜俟罪，朝不图夕，伏谒无路。","book":"唐·柳宗元《上广州赵宗儒尚书陈情启》"},"similar":["朝不谋夕"],"usage":"作谓语、定语；形容形势危急或境况窘迫"},{"id":25601,"word":"朝不继夕","pinyin":"zhāo bù jì xī","abbr":"cbjx","explanation":"不晨不能顾到晚上。形容情况危急，难以预料。","source":{"text":"今又十年，不改其养，饥寒所迫，衣食阙然，晨昏所奉，朝不继夕。","book":"唐·权德舆《奏孝子刘敦儒状》"}},{"id":25602,"word":"朝不虑夕","pinyin":"zhāo bù lǜ xī","abbr":"zblx","explanation":"早晨不能知道晚上会变成什么样子或发生什么情况。形容形势危急，难以预料。","source":{"text":"人命危浅，朝不虑夕。","book":"晋·李密《陈情表》"},"example":{"text":"这位老人病势垂危，已经气息奄奄，～。"},"similar":["朝不谋夕"],"opposite":["高枕无忧"],"usage":"作谓语、定语；形容形势危急或境况窘迫","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母，尊重老人。他想启用西蜀尚书郎李密，就下诏书任命李密为郎中。李密不愿出来做官，就写《陈情表》上书，说自己与祖母相依为命，祖母的日子朝不保夕了，待伺候祖母后再出来做官"]},{"id":25603,"word":"朝不谋夕","pinyin":"zhāo bù móu xī","abbr":"zbmx","explanation":"早晨不能知道晚上会变成什么样子或发生什么情况。形容形势危急，难以预料。","source":{"text":"吾侪偷食，朝不谋夕。","book":"《左传·昭公元年》"},"example":{"text":"这位老人病势垂危，已经气息奄奄，～。"},"similar":["朝不虑昔","朝不保夕"],"usage":"作谓语、定语；形容形势危急或境况窘迫"},{"id":25604,"word":"朝东暮西","pinyin":"zhāo dōng mù xī","abbr":"cdmx","explanation":"朝：早晨。早晨在东，晚上在西。指行踪不定。比喻变来变去，不专一。","source":{"text":"如今他在那里，朝东暮西，那有踪迹。","book":"明·徐霖《绣襦记·闻信增悲》"},"example":{"text":"十郎，奴家失身青楼，～，理当生受。","book":"明·汤显祖《紫箫记·托媒》"},"similar":["朝西暮东"],"usage":"作谓语、定语；用于生活"},{"id":25605,"word":"朝中有人好做官","pinyin":"cháo zhōng yǒu rén hǎo zuò guān","abbr":"czyrhzg","explanation":"朝：朝廷。指因有权势的人做靠山就能得到重用。","source":{"text":"恰恰的被一个旁不相干的有心人听见了，倒着实的在那里关切，正暗合了‘朝中有人好做官’那句俗语。","book":"清·文康《儿女英雄传》第33回"},"similar":["官官相卫"],"opposite":["朝里无人莫做官"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":25606,"word":"朝乾夕惕","pinyin":"zhāo qián xī tì","abbr":"zqxt","explanation":"乾：乾乾，即自强不息；惕：小心谨慎。形容一天到晚勤奋谨慎，没有一点疏忽懈怠。","source":{"text":"君子终日乾乾，夕惕若厉，无咎。","book":"《周易·乾》"},"example":{"text":"虽肝脑涂地，岂能报效万一？惟～，忠于厥职。","book":"清·曹雪芹《红楼梦》第十八回"},"similar":["朝兢夕惕"],"usage":"作谓语；指终日勤奋，不敢松懈"},{"id":25607,"word":"朝乾夕愓","pinyin":"zhāo qián xī dàng","abbr":"zqxd","explanation":"指终日勤奋谨慎，不敢懈怠。","source":{"text":"君子终日乾乾，夕惕若厉，无咎。","book":"语出《易·乾》"},"example":{"text":"惟～，忠于厥职。","book":"《红楼梦》第十八回"}},{"id":25608,"word":"朝云暮雨","pinyin":"zhāo yún mù yǔ","abbr":"zymy","explanation":"暮：傍晚。早上是云，晚上是雨。原指神女的早晚变化，旧时用以喻指男女的欢会。","source":{"text":"妾在巫山之阳，高丘之阻，旦为朝云，暮为行雨。朝朝暮暮，阳台之下。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"我想着香闺少女，但生的嫩色娇颜，都只爱～，那个肯凤只鸾单。","book":"元·关汉卿《望江亭》第一折"},"similar":["巫山云雨"],"usage":"作谓语、宾语；比喻男女的情爱与欢会","story":["传说古代襄王游览高唐地区，十分疲倦就在白天小睡了一会，在梦中看见一个仙女说：“我是高唐人，听说你来了，愿意给你当枕席。”襄王临幸了她。临别她说：“妾在巫山之阳，高丘之阻。旦为朝云，暮为行雨，朝朝暮暮，阳台之下。”"]},{"id":25609,"word":"朝令夕改","pinyin":"zhāo lìng xī gǎi","abbr":"zlxg","explanation":"早晨发布的命令，晚上就改了。比喻经常改变主张和办法，一会儿一个样。","source":{"text":"急政暴虐，赋敛不时，朝令而暮改。","book":"汉·鼌错《论贵粟疏》：“赋敛不时，朝令而暮改。”《汉书·食货志上》"},"example":{"text":"政策要力求相对地稳定，不能～。"},"similar":["朝三暮四","朝秦暮楚"],"opposite":["一如既往","一成不变"],"usage":"作谓语、定语、补语、分句；用于政策的变更"},{"id":25610,"word":"朝令夕更","pinyin":"zhāo lìng xī gēng","abbr":"clxg","explanation":"朝：早上；夕：黄昏。早晨下命令，晚上就改变。形容政令多变，让人无所适从。","source":{"text":"后来他只能置北京政府的威信于不顾，随着局势的变化而‘朝令夕更’。","book":"陶菊隐《北洋军阀统治时期史话》第23章"},"similar":["朝令夕改"],"usage":"作谓语、定语、宾语；用于政策的变更"},{"id":25611,"word":"朝令夜遁","pinyin":"zhāo lìng yè dùn","abbr":"clyd","explanation":"令：召。早上被征召，晚上就隐退。形容甘于隐居避世。","source":{"text":"臧丈人昧然而不应，泛然而辞，朝令而夜遁，终身无闻。","book":"战国·宋·庄周《庄子·田子方》"},"usage":"作谓语、定语；指为人"},{"id":25612,"word":"朝令暮改","pinyin":"zhāo lìng mù gǎi","abbr":"zlmg","explanation":"早晨发布的命令，晚上就改了。比喻经常改变主张和办法，一会儿一个样。","source":{"text":"赋敛不时，朝令而暮改。","book":"汉·鼌错《论贵粟疏》"},"example":{"text":"政策要力求相对地稳定，不能～。"},"similar":["朝令夕改"],"opposite":["一成不变"],"usage":"作谓语、定语、补语、分句；用于政策的变更","story":["西汉文帝时期，官僚地主等加重对农民的剥削，农民生活极其困苦，很多人破产逃亡，太子家令晁错写《论贵粟疏》上书给皇帝，提出打击商人投机倒把的行为，限制官僚地主对农民的盘剥，提出政策稳定，不能朝令暮改，注重发展农业生产"]},{"id":25613,"word":"朝兢夕惕","pinyin":"zhāo jīng xī tì","abbr":"cjxt","explanation":"惕：小心谨慎。形容一天到晚勤奋谨慎，不敢疏忽懈怠。","source":{"text":"尚当朝兢夕惕，居安虑危，而不可以少怠。","book":"宋·朱熹《戊申封事》"},"similar":["朝乾夕惕"],"usage":"作谓语、宾语；指终日勤奋，不敢松懈"},{"id":25614,"word":"朝出夕改","pinyin":"zhāo chū xī gǎi","abbr":"ccxg","explanation":"朝：早晨。早晨颁布的政令晚上就更改。形容政令无常，局势混乱。","source":{"text":"而景宣以任遇隆重，遂骄傲恣纵，多自矜伐，兼纳贿货，指麾节度，朝出夕改。","book":"《周书·权景宣传》"},"similar":["朝行夕改","朝令夕改"],"usage":"作谓语、定语、宾语；用于政策的变更"},{"id":25615,"word":"朝前夕惕","pinyin":"zhāo qiáng xī tì","abbr":"zqxt","explanation":"形容一天到晚勤奋谨慎，没有一点疏忽懈怠。","source":{"text":"君子终日干干，夕惕若厉，无咎。","book":"《易·干》"}},{"id":25616,"word":"朝升暮合","pinyin":"zhāo shēng mù gě","abbr":"zsmg","explanation":"零碎卖米。形容生活困难。","source":{"text":"若有得一两二两赢余，便也留着些做个根本，而今只好绷绷拽拽，朝升暮合过去，那得赢余。","book":"明·凌濛初《二刻拍案惊奇》第28卷"},"example":{"text":"他们一家过着～的日子。"},"usage":"作谓语、定语、状语；形容生活艰难"},{"id":25617,"word":"朝华夕秀","pinyin":"zhāo huá xī xiù","abbr":"zhxx","explanation":"比喻有新意的文章。","source":{"text":"谢朝华于已披，启夕秀于未振。","book":"晋·陆机《文赋》"},"usage":"作谓语、定语；指文章等"},{"id":25618,"word":"朝参暮礼","pinyin":"zhāo cān mù lǐ","abbr":"ccml","explanation":"参：参拜；礼：表敬意。早晚参拜。形容态度虔诚。","source":{"text":"朝参暮礼效精勤，金沼莲胎入梦频；粉骨碎身千万劫，未应容易报慈尊。","book":"金·中峰禅师《怀净土诗》六十四"},"example":{"text":"想咱人从幼年间出家，～，求慕至道，须有个成道的日子也。","book":"明·无名氏《洞玄升仙》第一折"},"similar":["暮礼晨参"],"usage":"作谓语、宾语、定语；用于交往"},{"id":25619,"word":"朝发夕至","pinyin":"zhāo fā xī zhì","abbr":"zfxz","explanation":"早上出发晚上就能到达。形容路程不远或交通方便。","source":{"text":"以生以食，鳄鱼朝发而夕至也。","book":"北魏·郦道元《水经注·注水》：“或王命急宣，有时朝发白帝，暮到江陵。”唐·韩愈《祭鳄鱼文》"},"example":{"text":"防边防海，转运枪炮，～。","book":"高阳《清宫外史》上册"},"similar":["一箭之地","朝发暮至"],"opposite":["千里迢迢"],"usage":"作谓语、定语；形容两地距离近"},{"id":25620,"word":"朝发暮至","pinyin":"zhāo fā mù zhì","abbr":"zfmz","explanation":"指早晨出发晚上就到达。形容路程很近或交通方便。","source":{"text":"居止近塞，朝发穹庐，暮至城郭，五郡民庶，家受其辜。","book":"语出《后汉书·乌桓传》"},"example":{"text":"今所幸宫，去京三百余里，銮舆动轫，俄经旬日，非可～。","book":"宋·王谠《唐语林·言语》"},"similar":["朝发夕至"],"usage":"作谓语、定语；形容两地距离近"},{"id":25621,"word":"朝名市利","pinyin":"cháo míng shì lì","abbr":"cmsl","explanation":"争名于朝，争利于市。","source":{"text":"臣闻争名者于朝，争利者于世，今山川周市，天下之市朝也。","book":"《战国策·秦策》"}},{"id":25622,"word":"朝四暮三","pinyin":"zhāo sì mù sān","abbr":"csms","explanation":"原指使用骗术欺骗人。后比喻经常变卦，反复无常。","source":{"text":"其后有以调停之说进者，吾见其朝四暮三，无关宏旨。","book":"梁启超《余之币制金融政策》"},"similar":["朝三暮四"],"usage":"作谓语、定语、状语；比喻反复无常的人"},{"id":25623,"word":"朝夕不保","pinyin":"zhāo xī bù bǎo","abbr":"zxbb","explanation":"朝：早上；夕：黄昏。早晨不能保证晚上的情况。形容形势危急，难以预料。","example":{"text":"他已经落到～的地步。"},"similar":["朝不保夕"],"usage":"作谓语、定语；形容形势危急"},{"id":25624,"word":"朝夕不倦","pinyin":"zhāo xī bù juàn","abbr":"zxbj","explanation":"朝：早晨。早晚都不懈怠。形容勤奋努力，孜孜不倦。","source":{"text":"寡人愿事君，朝夕不倦。","book":"春秋·鲁·左丘明《左传·昭公三年》"},"example":{"text":"虽年在耆老，～，跨鞍驱驰，与少壮者均其劳逸。","book":"《魏书·王遇传》"},"similar":["孜孜不倦"],"usage":"作谓语、状语；指勤奋"},{"id":25625,"word":"朝夕之策","pinyin":"zhāo xī zhī cè","abbr":"zxzc","explanation":"朝夕：一早一晚；策：计策。一早一晚的打算。形容只图眼前利益的计策。","source":{"text":"意者且运朝夕之策。","book":"汉·班固《答宾戏》"},"opposite":["万全之策"],"usage":"作主语、宾语；用于计谋"},{"id":25626,"word":"朝夕共处","pinyin":"zhāo xī gòng chǔ","abbr":"zxgc","explanation":"朝：早晨。从早到晚都在一起。形容关系密切。","example":{"text":"我们一帮～的同事在一起经常是笑声不断的。"},"similar":["朝夕相处"],"usage":"作谓语、定语；形容常生活在一起"},{"id":25627,"word":"朝夕相处","pinyin":"zhāo xī xiāng chǔ","abbr":"zxxc","explanation":"从早到晚都在一起。形容常生活在一起，关系密切。","source":{"text":"她之所以能‘青年作家’云云，不过是因为与我朝夕相处，耳闻目染的结果。","book":"孙犁《秀露集·序》"},"example":{"text":"我们同住一间房～，相爱如弟兄。"},"similar":["朝夕共处"],"usage":"作谓语、定语；形容常生活在一起"},{"id":25628,"word":"朝夷暮跖","pinyin":"zhāo yí mù zhí","abbr":"zymz","explanation":"早晨被誉为伯夷，晚上被贬作盗跖。形容时论毁誉多变。","source":{"text":"邵之两年昌言，其是非未可定，然一人之身，朝夷暮跖，亦可以观世变矣。","book":"明·沈德符《野获编·工部·邵上葵工部》"},"usage":"作宾语、定语；用于对人的态度"},{"id":25629,"word":"朝奏夕召","pinyin":"zhāo zòu xī zhào","abbr":"zzxz","explanation":"指早晨上书帝王，晚上就被召见。形容被朝廷任用之速。","source":{"text":"见“朝奏暮召”。"},"example":{"text":"布衣之人，怀奇抱策，而望～，岂易得哉？","book":"《新唐书·魏元忠传》"},"similar":["朝奏暮召"],"usage":"作宾语、定语；用于爱惜人才"},{"id":25630,"word":"朝奏暮召","pinyin":"zhāo zòu mù zhào","abbr":"zzmz","explanation":"指早晨上书帝王，晚上就被召见。形容被朝廷任用之速。","source":{"text":"扞主父偃呴资用乏，留久，诸公宾客多厌之，乃上书阙下。朝奏，暮召入见。所言九事，其八事为律令，一事谏伐匈奴。","book":"语出《史记·平津侯主父列传》"},"example":{"text":"公孙大廷之对，相如词赋之材，主父、严、徐之雄辩，少孺、曼倩之诙谐，或朝奏而暮召，或徒步而鼎台。","book":"元·陈植《金马门赋》"},"similar":["朝奏夕召"],"usage":"作宾语、定语；用于爱惜人才"},{"id":25631,"word":"朝客高流","pinyin":"cháo kè gāo liú","abbr":"ckgl","explanation":"朝：朝廷；流：品级。旧指职位高而声执势显赫的人物。","source":{"text":"洛中名士咸谒见之，李乃大开宴席。当时朝客高流，无不臻赴。","book":"唐·于邺《扬州梦》"}},{"id":25632,"word":"朝思夕想","pinyin":"zhāo sī xī xiǎng","abbr":"csxx","explanation":"朝：早晨。从早到晚思念不已。多用于男女恋情。","source":{"text":"青琐窥观生悒怏，苦杀也朝思夕想。","book":"明·陆采《怀香记·兰闺复命》"},"similar":["朝思暮想"],"usage":"作谓语、定语、状语；用于男女情爱方面"},{"id":25633,"word":"朝思夕计","pinyin":"zhāo sī xī jì","abbr":"csxj","explanation":"朝：早晨。早晚都在思考。形容集中精力思考问题。","source":{"text":"仆七十三岁，朝思夕计，并愿与诸贤为真善知识。","book":"南朝·陈·徐陵《答诸求官人书》"},"usage":"作谓语、宾语；用于思考"},{"id":25634,"word":"朝思暮念","pinyin":"zhāo sī mù niàn","abbr":"csmn","explanation":"朝：早晨。从早到晚思念不已。多用于男女恋情。","source":{"text":"一时未便，不好说得女子之事，闷闷随去任所，朝思暮念不题。","book":"明·凌濛初《初刻拍案惊奇》第12卷"},"similar":["朝思暮想","朝思夕想"],"usage":"作谓语、定语、状语；用于男女情爱方面"},{"id":25635,"word":"朝思暮想","pinyin":"zhāo sī mù xiǎng","abbr":"zsmx","explanation":"朝：早晨；暮：晚上。早晚都想念。形容非常想念或经常想着某一件事。","source":{"text":"再说沈洪自从中秋夜见了玉姐，到如今朝思暮想，废寝忘餐。","book":"明·冯梦龙《警世恒言》卷二十四"},"example":{"text":"他终于回到了阔别多年、～的故乡。"},"similar":["耿耿于怀","念念不忘"],"opposite":["置之脑后","抛于九霄云外"],"usage":"作谓语、定语、状语；用于男女情爱方面"},{"id":25636,"word":"朝成夕毁","pinyin":"zhāo chéng xī huǐ","abbr":"zcxh","explanation":"形容翻新之速。","source":{"text":"宋·苏轼《御试制科策》；“后宫之费不下一敌国，金玉锦绣之工，日作而不息，朝成夕毁，务以相新。”"},"similar":["朝成暮毁"],"usage":"作宾语、定语；指变化快"},{"id":25637,"word":"朝成暮徧","pinyin":"cháo chéng mù shí","abbr":"zcmb","explanation":"早晨刚写成，晚上就到处流传。形容文章流传迅速。"},{"id":25638,"word":"朝成暮毁","pinyin":"zhāo chéng mù huǐ","abbr":"zcmh","explanation":"形容翻新之速。","source":{"text":"穿池筑观，朝成暮毁，征发工匠，疲极兆民。","book":"《宋书·少帝记》"},"similar":["朝成夕毁"],"usage":"作宾语、定语；指变化快"},{"id":25639,"word":"朝成暮遍","pinyin":"zhāo chéng mù biàn","abbr":"zcmb","explanation":"早晨刚写成，晚上就到处流传。形容文章流传迅速。","source":{"text":"孝绰辞藻为后进所宗，时重其文，每作一篇，朝成暮遍，好事者咸诵传写，流闻河朔，亭苑柱壁莫不题之。","book":"《南史·刘孝绰传》"},"usage":"作谓语、定语；用于作品等"},{"id":25640,"word":"朝打暮骂","pinyin":"zhāo dǎ mù mà","abbr":"cdmm","explanation":"朝：早晨；暮：晚间。早晨打晚间骂。","source":{"text":"如今幸而卖到这个地方，吃穿和主子一样，又不朝打暮骂。","book":"清·曹雪芹《红楼梦》第19回"},"usage":"作宾语、定语；用于对人的态度"},{"id":25641,"word":"朝折暮折","pinyin":"zhāo shé mù shé","abbr":"zsms","explanation":"比喻时时遭摧残。","source":{"text":"唐·崔颢《行路难》诗：“我昔初在昭阳时，朝折暮折登王墀。”一本作“朝攀暮折”。"},"similar":["朝攀暮折"],"usage":"作宾语、定语；用于人或花木等"},{"id":25642,"word":"朝攀暮折","pinyin":"zhāo pān mù shé","abbr":"zpms","explanation":"指不断地攀折。比喻时时遭摧残。","source":{"text":"唐·崔颢《行路难》诗：“我昔初在昭阳时，朝攀暮折登王墀。”一本作“朝折暮折”。"},"example":{"text":"路人爱是风流树，无奈～何。","book":"金·元好问《结杨柳怨》诗"},"similar":["朝折暮折"],"usage":"作宾语、定语；用于人或花木等"},{"id":25643,"word":"朝斯夕斯","pinyin":"zhāo sī xī sī","abbr":"zsxs","explanation":"早上这样，晚上也这样。形容求学勤奋而有恒心。","source":{"text":"朝于斯，夕于斯。","book":"《三字经》"},"usage":"作谓语、宾语；指人读书"},{"id":25644,"word":"朝新暮敝","pinyin":"zhāo xīn mù bì","abbr":"cxmb","explanation":"敝：破。早上是新的到晚上就破了。指物件质量差。","source":{"text":"楚之郢都，车毂击，民肩攀，市路相排突，号为朝衣新而暮衣敝。","book":"汉·桓谭《新论》"},"usage":"作宾语、定语；用于生活"},{"id":25645,"word":"朝施暮戮","pinyin":"zhāo shī mù lù","abbr":"csml","explanation":"施：施行；戮：杀戮。早上发令晚上杀戮。形容实行高压手段。","source":{"text":"故政不常、令不一，则奸诈起而暴乱生焉，虽朝施暮戮，而法不行矣。","book":"《新唐书·柳泽传》"},"usage":"作宾语、定语；用于高压统治"},{"id":25646,"word":"朝晖夕阴","pinyin":"zhāo huī xī yīn","abbr":"zhxy","explanation":"晖：日光。早晚阴晴变化。","source":{"text":"朝晖夕阴，气象万千。","book":"宋·范仲淹《岳阳楼记》"},"usage":"作宾语；指早晚阴晴变化"},{"id":25647,"word":"朝更夕改","pinyin":"zhāo gēng xī gǎi","abbr":"cgxg","explanation":"早晨刚改过，晚上又变了。形容主意不定，一会儿一个样。同“朝更暮改”。","source":{"text":"适来又在王伯当面前，说他做人好，怎么朝更夕改，又说他不好？","book":"清·褚人获《隋唐演义》第九回"},"similar":["朝更暮改"],"usage":"作谓语、定语、宾语；用于政策的变更"},{"id":25648,"word":"朝更暮改","pinyin":"zhāo gèng mù gǎi","abbr":"zgmg","explanation":"早晨刚改过，晚上又变了。形容主意不定，一会儿一个样。亦作“朝更夕改”。","source":{"text":"战国来尚纵横朝更暮改，至楚汉诛暴秦大业归刘。","book":"明·无名氏《东篱赏菊》第一折"},"example":{"text":"三妹子他从不会～的，他已说了改悔，必是改悔的。","book":"清·曹雪芹《红楼梦》第六十六回"},"similar":["朝令夕改","朝更夕改"],"usage":"作谓语、定语、宾语；用于政策的变更"},{"id":25649,"word":"朝朝寒食，夜夜元宵","pinyin":"zhāo zhāo hán shí，yè yè yuán xiāo","abbr":"cchsyyyx","explanation":"寒食：清明节；元宵：元宵节。早晚都像过节一样。形容生活奢华，整天寻欢作乐。","source":{"text":"寡人自从得了杨妃，真所谓：‘朝朝寒食，夜夜元宵’也。","book":"元·白仁甫《梧桐雨》第一折"},"example":{"text":"好不受用！好不快乐！果然是～。","book":"明·凌濛初《初刻拍案惊奇》第15卷"},"usage":"作宾语、定语、分句；用于生活"},{"id":25650,"word":"朝朝暮夕","pinyin":"zhāo zhāo mù xī","abbr":"czmx","explanation":"每天的早晨和黄昏，指短暂的时间。","example":{"text":"我们要充分利用时间，那怕是～也不能放过。"},"similar":["朝朝暮暮"],"usage":"作主语、宾语、定语；指短时间"},{"id":25651,"word":"朝朝暮暮","pinyin":"zhāo zhāo mù mù","abbr":"zzmm","explanation":"每天的早晨和黄昏，指短暂的时间。","source":{"text":"妾在巫山之阳，高丘之阻，旦为朝云，暮为行雨。朝朝暮暮，阳台之下。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"银河碧落神仙配，地久天长，岂但～期。","book":"清·洪昇《长生殿·怂合》"},"similar":["朝朝暮夕"],"opposite":["天长地久"],"usage":"作主语、宾语、定语；指短时间","story":["传说古代襄王游览高唐地区，十分疲倦就在白天小睡了一会，在梦中看见一个仙女说：“我是高唐人，听说你来了，愿意给你当枕席。”襄王临幸了她。临别她说：“妾在巫山之阳，高丘之阻。旦为朝云，暮为行雨，朝朝暮暮，阳台之下。”"]},{"id":25652,"word":"朝来暮去","pinyin":"zhāo lái mù qù","abbr":"clmq","explanation":"朝：早晨；暮：傍晚。黄昏过去清晨来临。形容时光流逝。","source":{"text":"妾身裴兴奴，自从与白侍郎相伴，朝来暮去，又早半年光景。","book":"元·马致远《青衫泪》楔子"},"similar":["暮去朝来","暮来朝去"],"usage":"作状语、分句；用于时间流逝"},{"id":25653,"word":"朝梁暮周","pinyin":"zhāo liáng mù zhōu","abbr":"zlmz","explanation":"比喻人反复无常，没有节操。","source":{"text":"君不见中原将相夸男儿，朝梁暮周皆逆旅。","book":"明·李东阳《王凝妻》诗"},"similar":["朝梁暮晋"],"usage":"作谓语、定语；比喻反复无常没有节操"},{"id":25654,"word":"朝梁暮晋","pinyin":"zhāo liáng mù jìn","abbr":"zlmj","explanation":"比喻人反复无常，没有节操。","source":{"text":"亡国降臣固位难，痴顽老子几朝官。朝梁暮晋浑閒事，更舍残骸与契丹。","book":"五代冯道为相，历五朝八姓，于丧君亡国略不在意。自号长乐老，著《长乐老自叙》，历陈官爵以为荣，时论卑之。元刘因有《冯道》诗讽之曰"},"example":{"text":"～者谁子，段凝之辈真如蚁。","book":"清·梁清标《王铁枪》诗"},"similar":["朝梁暮陈","朝梁暮周"],"usage":"作谓语、定语；比喻反复无常没有节操"},{"id":25655,"word":"朝梁暮陈","pinyin":"zhāo liáng mù chén","abbr":"zlmc","explanation":"比喻人反复无常，没有节操。","source":{"text":"娼楼之本色也。六朝君臣，朝梁暮陈，何异于此。","book":"明·杨慎《升庵诗话·萧子显春别》"},"example":{"text":"现代人才跳槽也是～的。"},"similar":["朝秦暮楚"],"opposite":["持之以恒"],"usage":"作谓语、定语；比喻反复无常没有节操"},{"id":25656,"word":"朝欢暮乐","pinyin":"zhāo huān mù lè","abbr":"zhml","explanation":"指终日欢乐；日夜寻欢作乐。","source":{"text":"虽则如此，两下情好愈密，朝欢暮乐，终日相守，如夫妇一般。","book":"《警世通言·杜下娘怒沉百宝箱》"},"example":{"text":"要令小娘子时常省视，虽在～之际，不忘故乡恩义之情。","book":"明·梁辰鱼《浣纱记·别施》"},"usage":"作宾语、定语；用于生活"},{"id":25657,"word":"朝歌夜弦","pinyin":"zhāo gē yè xián","abbr":"zgyx","explanation":"形容整天沉迷于歌舞，逸乐无度。","source":{"text":"妃嫔媵嫱，王子皇孙，辞楼下殿，辇来于秦。朝歌夜弦，为秦宫人。","book":"唐·杜牧《阿房宫赋》"},"similar":["朝歌暮弦"],"usage":"作宾语、定语；用于生活"},{"id":25658,"word":"朝歌夜舞","pinyin":"zhāo gē yè wǔ","abbr":"cgyw","explanation":"朝：早晨；歌：唱歌；舞：跳舞。早晨唱歌，夜晚跳舞。形容沉迷于歌舞欢乐之中。","source":{"text":"妃嫔媵嫱，王子皇孙，辞楼下殿，辇来于秦，朝歌夜弦，为秦宫人。","book":"唐·杜牧《阿房宫赋》"},"example":{"text":"少年不知老境恶，意谓长如少年乐，～狂不休，逢人欲觅长生药。（宋·陆游《放歌行》）"}},{"id":25659,"word":"朝歌暮宴","pinyin":"zhāo gē mù yàn","abbr":"cgmy","explanation":"朝：早晨。从早到晚不是歌舞就是宴饮。形容欢娱无度的生活。","source":{"text":"寡人自从太真入宫，朝歌暮宴，无有虚日。","book":"元·白仁甫《梧桐雨》楔子"},"similar":["朝歌暮弦","醉生梦死"],"usage":"作宾语、定语；用于生活"},{"id":25660,"word":"朝歌暮弦","pinyin":"zhāo gē mù xián","abbr":"zgmx","explanation":"形容整天沉迷于歌舞，逸乐无度。","source":{"text":"外此诸处茶肆，清乐茶坊、八仙茶坊……各有等差，莫不靓妆迎门，争妍卖笑，朝歌暮弦，摇荡心目。","book":"宋·周密《武林旧事·歌馆》"},"similar":["朝歌夜弦"],"usage":"作宾语、定语；用于生活"},{"id":25661,"word":"朝气勃勃","pinyin":"zhāo qì bó bó","abbr":"zqbb","explanation":"朝：早上；勃勃：旺盛的样子。形容充满了生命和活力。","source":{"text":"在革命胜利……的一代，是朝气勃勃的，但是也有弱点。","book":"邓小平《在中国新民主主义青年团第三次全国代表大会上的祝词》"},"similar":["朝气蓬勃"],"opposite":["暮气沉沉"],"usage":"作谓语、定语、状语；形容生气勃勃"},{"id":25662,"word":"朝气蓬勃","pinyin":"zhāo qì péng bó","abbr":"zqpb","explanation":"朝气：早上的空气，引伸为新生向上，努力进取的气象；蓬勃：旺盛的样子。形容充满了生命和活力。","source":{"text":"党的最高领导层就能够实现新老合作和交替，成为更加朝气蓬勃的战斗指挥部。","book":"邓小平《中国共产党第十二次全国代表大会开幕词》"},"example":{"text":"青少年应该～，不能死气沉沉。"},"similar":["生气勃勃","生龙活虎"],"opposite":["老气横秋","死气沉沉","萎靡不振"],"usage":"作谓语、定语、状语；形容生气勃勃"},{"id":25663,"word":"朝生夕死","pinyin":"zhāo shēng xī sǐ","abbr":"zsxs","explanation":"①早晨刚生，晚上就死亡。②今亦形容事物生命短暂。","source":{"text":"[君子国]有薰华草，朝生夕死。","book":"《山海经·海外东经》"},"example":{"text":"王朔《人莫予毒》：“人生如梦，俱是宇宙过客，～，你先走一步，与我们又何尝不是五十步与百步至差？”"},"similar":["朝生暮死"],"usage":"作谓语、定语；形容短命"},{"id":25664,"word":"朝生暮死","pinyin":"zhāo shēng mù sǐ","abbr":"zsms","explanation":"①早晨刚生，晚上就死亡。②今亦形容事物生命短暂。","source":{"text":"朝生幕落花……生粪秽处，头如笔，紫色，朝生暮死。","book":"《重修政和证类本草·草下之上》"},"example":{"text":"任何一部文学作品，只要不是～的东西，总会让一些人喜欢，让另一些人讨厌。","book":"巴金《探索集·灌输和宣传》"},"similar":["朝生夕死"],"usage":"作谓语、定语；形容短命"},{"id":25665,"word":"朝盈夕虚","pinyin":"zhāo yíng xī xū","abbr":"cyxx","explanation":"盈：满；虚：空虚。早上充盈，晚上空虚。形容对人忽冷忽热，反复无常。","source":{"text":"愿君勿怨，请于市论，朝而盈焉，夕而虚焉，求在故往，亡故去。","book":"汉·应劭《风俗通·穷通》"},"usage":"作宾语、定语；用于对人的态度","story":["战国时期，齐国孟尝君被齐国驱逐楚国后，谭子亲自去迎接他，并问他怨恨齐国的大夫不？孟尝君直言不讳地说有。谭子安慰他说：“请不要怨恨他们，按照市侩的观点来看，对人朝盈夕虚的人大有人在，齐国是你的故国，不要理会他们。”"]},{"id":25666,"word":"朝益暮习","pinyin":"zhāo yì mù xí","abbr":"cymx","explanation":"朝：白天；益：增加；暮：晚上。白天学习新知识，晚上就温习。形容学习用功。","source":{"text":"朝益暮习。","book":"春秋·齐·管仲《管仲·弟子职》"},"usage":"作谓语、宾语；用于学习"},{"id":25667,"word":"朝真暮伪","pinyin":"zhāo zhēn mù wěi","abbr":"czmw","explanation":"朝：早晨。事情早上这样说晚上那样说，没有定说。","source":{"text":"朝真暮伪何人辨，古往今来底事无？","book":"唐·白居易《放言五首》诗"},"usage":"作宾语、定语；用于言论等"},{"id":25668,"word":"朝督暮责","pinyin":"zhāo dū mù zé","abbr":"cdmz","explanation":"朝：白天；暮：傍晚。从早到晚不停地督促检查。形容督促检查非常严格。","source":{"text":"虽朝督暮责，无益于事矣！","book":"唐·李靖《李卫公向对》"},"usage":"作谓语、定语；用于监督"},{"id":25669,"word":"朝种暮获","pinyin":"zhāo zhǒng mù hù","abbr":"zzmh","explanation":"①比喻收益迅速。②比喻时间短促。","source":{"text":"言世有仙人……览观县圃，浮游蓬莱，耕耘五德，朝种暮获。","book":"《汉书·郊祀志下》"},"example":{"text":"若必月旦，则颜回食埃，不免贪污；盗跖引少，则为清廉。～。善恶未定矣。","book":"《晋书·祖纳传》"},"usage":"作宾语、定语；用于书面语"},{"id":25670,"word":"朝秦暮楚","pinyin":"zhāo qín mù chǔ","abbr":"zqmc","explanation":"战国时期，秦楚两个诸侯大国相互对立，经常作战。有的诸侯小国为了自身的利益与安全，时而倾向秦，时而倾向楚。比喻人反复无常。","source":{"text":"托生理于四方，固朝秦而暮楚。","book":"宋·晁补之《鸡肋集·北渚亭赋》"},"example":{"text":"叹～，三载依刘。","book":"清·孔尚任《桃花扇》第二十九出"},"similar":["朝三暮四","三心二意","见异思迁"],"opposite":["始终不渝","始终如一"],"usage":"作谓语、定语；比喻反复无常","story":["战国时期，战国七雄齐、楚、燕、韩、赵、魏、秦内部之间的斗争十分激烈。七国中秦、楚势力强大，魏、韩、赵、燕、齐等国为了自身的利益，游离在这两国之间，时而靠近秦国，时而靠近楚国，一班政治说客奔走在这些诸侯国之间"]},{"id":25671,"word":"朝穿暮塞","pinyin":"zhāo chuān mù sāi","abbr":"zcms","explanation":"比喻频繁地兴建房屋。","source":{"text":"光筑缮造日夜不穷，晨构夕毁，朝穿暮塞，络以随珠。","book":"《南齐书·东昏侯纪》"},"example":{"text":"今天的房屋建设也是～。"},"usage":"作谓语、定语；比喻频繁地兴建房屋"},{"id":25672,"word":"朝章国典","pinyin":"cháo zhāng guó diǎn","abbr":"czgd","explanation":"朝廷与国家的典章制度。同“朝章国故”。","source":{"text":"晋秘书监荀勖定魏《内经》，更著《新簿》。虽古文旧简，犹云有缺，新章后录，鸠集已多，足得恢弘正道，训范当世。属刘、石凭陵，京华覆灭，朝章国典，从而失坠。","book":"《隋书·牛弘传》"}},{"id":25673,"word":"朝章国故","pinyin":"cháo zhāng guó gù","abbr":"czgg","explanation":"朝廷与国家的典章制度。","source":{"text":"日记或书信，是向来有些读者的。先前是在看朝章国故，丽句清词，如何抑扬，怎样请托，于是害得名人连写日记和信也不敢随随便便。","book":"鲁迅《且介亭杂文二集·孔另境编〈当代文人尺牍钞〉序》"}},{"id":25674,"word":"朝经暮史","pinyin":"zhāo jīng mù shǐ","abbr":"zjms","explanation":"经：指旧时奉为经典的书籍；史：指历史书籍。一天到晚诵读经史。形容勤奋读书。","source":{"text":"真个此人朝经暮史，昼览夜习，口不绝吟，手不停披。","book":"宋·无名氏《张协状元·开场》"},"example":{"text":"你若是～，那其间须有个称心时。","book":"明·无名氏《孟母三移》"},"usage":"作宾语、定语；指读书"},{"id":25675,"word":"朝耕暮耘","pinyin":"zhāo gēng mù yún","abbr":"cgmy","explanation":"耘：锄草。早上耕种晚上锄草。形容非常勤劳。","source":{"text":"初卖衣买得犁与锄，朝耕暮耘受辛苦，还要私债输官租。","book":"明·陶宗仪《辍耕录·检田吏》"},"usage":"作谓语、宾语；用于农事"},{"id":25676,"word":"朝荣夕悴","pinyin":"zhāo róng xī cuì","abbr":"crxc","explanation":"早晨开花傍晚凋谢。比喻生命短促，荣辱无常。","source":{"text":"然官位非常，有朝荣而夕悴。","book":"《魏书·韩显宗传》"},"similar":["朝荣夕毙","朝荣夕灭"],"usage":"作宾语、定语；用于人生短暂"},{"id":25677,"word":"朝荣夕毙","pinyin":"zhāo róng xī bì","abbr":"crxb","explanation":"毙：死亡。早晨开花傍晚凋谢。比喻生命短促，荣辱无常。","source":{"text":"奈何兮繁华，朝荣兮夕毙。","book":"晋·潘岳《朝菌赋》"},"similar":["朝荣暮落","朝荣夕悴"],"usage":"作宾语、定语；用于人生短暂"},{"id":25678,"word":"朝荣夕灭","pinyin":"zhāo róng xī miè","abbr":"zrxm","explanation":"早晨开花傍晚凋谢。比喻生命短促，荣辱无常。","source":{"text":"朝荣夕灭，旦飞暮沉。","book":"《晋书·王沈传》"},"similar":["朝荣夕毙"],"usage":"作宾语、定语；用于人生短暂"},{"id":25679,"word":"朝荣暮落","pinyin":"zhāo róng mù luò","abbr":"crml","explanation":"朝：早晨。早晨开的花晚上就凋落。比喻富贵无常。","source":{"text":"朝荣暮落，始富终贫，范卷箦而后荣，邓赐钱而饿死。","book":"五代·王定保《唐摭言·怨怒》"},"similar":["朝荣夕毙"],"usage":"作宾语、定语；用于人生"},{"id":25680,"word":"朝蝇暮蚊","pinyin":"zhāo yíng mù wén","abbr":"cymw","explanation":"早上的苍蝇晚上的蚊子。比喻坏人横行。","source":{"text":"朝蝇不须驱，暮蚊不可拍。","book":"唐·韩愈《杂诗》"},"usage":"作宾语、定语；用于时局等"},{"id":25681,"word":"朝行夕改","pinyin":"zhāo xíng xī gǎi","abbr":"cxxg","explanation":"朝：早晨。早晨颁布的政令晚上就更改。形容政令无常，局势混乱。","source":{"text":"白书青纸为诏，或朝行夕改者数四，百官转易如流矣。","book":"《晋书·赵王伦传》"},"similar":["朝令夕改"],"usage":"作谓语、定语、宾语；用于政策的变更"},{"id":25682,"word":"朝衣东市","pinyin":"zhāo yī dōng shì","abbr":"zyds","explanation":"指大臣等待被杀。","source":{"text":"上令晁错衣朝衣斩东市。","book":"典出《史记·袁盎晁错列传》"},"example":{"text":"～甘如饴，玉体须为美人惜。","book":"龚定盫"}},{"id":25683,"word":"朝西暮东","pinyin":"zhāo xī mù dōng","abbr":"cxmd","explanation":"朝：早晨。早晨在西，晚上在东。指行踪不定。比喻变来变去，不专一。","source":{"text":"朝西暮东，齐、梁、燕、宋，生涯不同。","book":"明·无名氏《四贤记·社会》"},"similar":["朝东暮西"],"usage":"作谓语、定语；用于生活"},{"id":25684,"word":"朝观夕览","pinyin":"zhāo guān xī lǎn","abbr":"cgxl","explanation":"朝：早晨。早晨看晚上也看。形容对宝贵的东西爱不释手。","source":{"text":"高平公进书画表曰：‘前代帝王多求遗逸，朝观夕览，收鉴于斯。","book":"唐·张彦远《名画记》"},"usage":"作谓语、宾语；用于学习等"},{"id":25685,"word":"朝观暮览","pinyin":"zhāo guān mù lǎn","abbr":"cgml","explanation":"观、览：看。早晨也看，夜晚也看。形容对珍贵的东西百看不厌。","source":{"text":"欲此礼之不愆，是以尽乎行道之先民。朝观夕览，何与书绅？","book":"三国·魏·何晏《景福殿赋》"},"example":{"text":"～常忘返，春华秋实总留连。"}},{"id":25686,"word":"朝趁暮食","pinyin":"zhāo chèn mù shí","abbr":"zcms","explanation":"白天挣了钱，晚上才有饭吃。形容生活十分贫困。","source":{"text":"人都叫我王小二……家中穷窘，朝趁暮食。","book":"元·孙仲章《勘头巾》第一折"},"example":{"text":"第三等，乃～，肩担之家。","book":"《醒世恒言·李玉英狱中讼冤》"},"usage":"作宾语、定语；用于生活"},{"id":25687,"word":"朝迁市变","pinyin":"cháo qiān shì biàn","abbr":"cqsb","explanation":"朝：朝廷；市：集市。朝廷改换，市肆变迁。形容改朝换代，社会动荡。","source":{"text":"虽国破家亡，朝迁市变，谱牒存录，守次可推。","book":"唐·王绩《重答杜君书》"},"similar":["改朝换代"],"usage":"作谓语、定语；指社会变化"},{"id":25688,"word":"朝过夕改","pinyin":"zhāo guò xī gǎi","abbr":"zgxg","explanation":"早上犯的过失，晚上就改正了。形容改正错误很快。","source":{"text":"朝过夕改，君子与之。","book":"《汉书·翟方进传》"},"example":{"text":"苟在适用，则无弃人，况黜免之人，沉郁既久，～，仁何远哉。","book":"唐·陆贽《奉天改元大赦制》"},"similar":["朝闻夕改"],"opposite":["死不改悔"],"usage":"作谓语、定语；形容迅速改正错误"},{"id":25689,"word":"朝里无人莫做官","pinyin":"cháo lǐ wú rén mò zuò guān","abbr":"clwrmzg","explanation":"旧时俗语。意思是，没有靠山，事办不成。","source":{"text":"俗语说的好，‘朝里无人莫做官’，大约这位洪观察是朝内有人的了。","book":"清·吴趼人《二十年目睹之怪现状》第38回"},"example":{"text":"俗话说“～”也不无道理。"},"similar":["官官相卫"],"opposite":["朝中有人好做官"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":25690,"word":"朝里有人好做官","pinyin":"cháo lǐ yǒu rén hǎo zuò guān","abbr":"clyrhzg","explanation":"与自己关系亲密的人掌了权，自己也能得到推荐和重用。","source":{"text":"恰恰的被一个旁不相干的有心人听见了，倒着实的在那里关切，正暗合了朝中有人好做官的那句俗话。","book":"清·文康《儿女英雄传》第三十三回"}},{"id":25691,"word":"朝野上下","pinyin":"cháo yě shàng xià","abbr":"cysx","explanation":"朝野：指朝廷和民间；上下：从中央到地方。指从中央到地方，从做官的到老百姓。","source":{"text":"其朝野上下，莫不玩细娱而苟近安，安其危而利其害。","book":"清·魏源《治篇十一》"},"example":{"text":"若其栋梁方颓，樽俎犹昔，～，犹嘤鸣娱乐，颜色无改，斯非意重辞复，难可曲喻。","book":"章炳麟《〈正学报〉缘起》"},"similar":["举国上下"],"usage":"作主语、宾语、定语；指全国上下的人"},{"id":25692,"word":"朝野侧目","pinyin":"cháo yě cè mù","abbr":"cycm","explanation":"朝野：旧指朝廷与民间，不论官吏还是平民，都不敢正眼相看。形容权势极大。","source":{"text":"权尊势重，朝野侧目。","book":"明·冯梦龙《古今小说·沈小霞相会出师表》"},"usage":"作谓语、定语；用于人或事物等"},{"id":25693,"word":"朝钟暮鼓","pinyin":"zhāo zhōng mù gǔ","abbr":"zzmg","explanation":"佛寺晨撞钟，暮击鼓以报时。","source":{"text":"朝钟暮鼓不到耳，明月孤云长挂情。","book":"唐·李咸用《山中》诗"},"example":{"text":"百尺高台面太湖，～宴姑苏。","book":"明·梁辰鱼《浣纱记·伐越》"},"usage":"作主语、宾语、定语；用于生活"},{"id":25694,"word":"朝锺暮鼓","pinyin":"zhāo zhōng mù gǔ","abbr":"zzmg","explanation":"佛寺晨撞锺，暮击鼓以报时。同“朝钟暮鼓”。"},{"id":25695,"word":"朝闻夕改","pinyin":"zhāo wén xī gǎi","abbr":"zwxg","explanation":"早晨闻过，晚上即改正。形容改正错误之迅速。","source":{"text":"背觉后尘，朝闻夕改，马劣猿颠难捉擒。","book":"金·侯善渊《沁园春》词"},"example":{"text":"我们要做到知错必改，～。"},"similar":["朝过夕改"],"usage":"作宾语、定语；指人有自知之明"},{"id":25696,"word":"朝闻夕死","pinyin":"zhāo wén xī sǐ","abbr":"zwxs","explanation":"早晨闻道，晚上死去。形容对真理或某种信仰追求的迫切。","source":{"text":"朝闻道，夕死可矣。","book":"《论语·里仁》"},"example":{"text":"古人贵朝闻夕死，况君前途尚可。","book":"南朝宋·刘义庆《世说新语·自新》"},"similar":["朝闻夕没"],"usage":"作宾语、定语；形容对真理的追求迫切","story":["晋朝时期，宜兴县有老虎与蛟龙及不务正业的周处为害当地，百姓议论纷纷。周处见人们恨他，就去把老虎与蛟龙都打死，然后就去找陆机、陆云兄弟请教如何做人。陆云说只要有心改过，哪怕是朝闻夕死也值得。周处真心改过，成为驰骋疆场的英雄"]},{"id":25697,"word":"朝闻夕没","pinyin":"zhāo wén xī mò","abbr":"cwxm","explanation":"早晨闻道，晚上可死去。形容对真理或某种信仰追求的迫切。","source":{"text":"朝闻夕没，先民所思，何用诔德？","book":"三国·魏·曹植《王仲宣诔并序》"},"similar":["朝闻夕死"],"usage":"作宾语、定语；形容对真理的追求迫切"},{"id":25698,"word":"朝闻道，夕死可矣","pinyin":"zhāo wén dào，xī sǐ kě yǐ","abbr":"cwdxsky","explanation":"早晨闻道，晚上死去。形容对真理或某种信仰追求的迫切。","source":{"text":"子曰：‘朝闻道，夕死可矣。’","book":"春秋·鲁·孔丘《论语·里仁》"},"example":{"text":"你既觉悟了～，却怎么刬地怕风涛。","book":"明·朱权《冲漠子》第三折"},"similar":["朝闻夕死","朝闻夕没"],"usage":"作宾语、定语；用于处世","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，孔子与弟子们谈起自己的经历，说他从30岁开始立志弘道，经历不惑之年以致现在，感慨自己“朝闻道，夕死可矣”，但是还是要将仁政推销出去"]},{"id":25699,"word":"朝阳丹凤","pinyin":"cháo yáng dān fèng","abbr":"cydf","explanation":"比喻贤才逢明时。","source":{"text":"凤凰鸣矣，于彼高冈。梧桐生矣，于彼朝阳。","book":"《诗经·大雅·卷阿》"}},{"id":25700,"word":"朝阳鸣凤","pinyin":"zhāo yáng míng fèng","abbr":"zymf","explanation":"比喻品德出众、正直敢谏之人。","source":{"text":"凤凰鸣矣，于彼高冈，梧桐生矣，于彼朝阳。","book":"语出《诗·大雅·卷阿》"},"example":{"text":"庚子八月，君果以身殉国耻。噫嘻！可不谓～耶！","book":"梁启超《饮冰室诗话》二十"},"similar":["鸣凤朝阳"],"usage":"作宾语；用于为人"},{"id":25701,"word":"朝露溘至","pinyin":"zhāo lù kè zhì","abbr":"zlkz","explanation":"形容人生短促好似朝露那样。","example":{"text":"人生如～，应该把握时机，贡献社会。"}},{"id":25702,"word":"朝飞暮卷","pinyin":"zhāo fēi mù juǎn","abbr":"cfmj","explanation":"朝：早晨；暮：傍晚。形容天气的变化和景色的优美。","source":{"text":"画栋朝飞南浦云，朱帘暮卷西山雨。","book":"唐·王勃《滕王阁》诗"},"example":{"text":"～，云霞翠轩。雨丝风片，烟波画船。","book":"明·汤显祖《牡丹亭·惊梦》"},"usage":"作宾语、定语；用于景色"},{"id":25703,"word":"朝饔夕飧","pinyin":"zhāo yōng xī sūn","abbr":"zyxs","explanation":"指才疏力薄，除吃饭外别无所能。","source":{"text":"吾侪细人，朝饔夕飧，观山而不穷其巅，望海而不极其源。","book":"明·李东阳《后东山草堂赋》"},"usage":"作谓语、定语；用于自谦"},{"id":25704,"word":"朝齑暮盐","pinyin":"zhāo jī mù yán","abbr":"zjmy","explanation":"齑：腌菜。早餐用腌菜下饭，晚饭蘸盐进餐。形容饮食简单，生活清苦。","source":{"text":"太学四年，朝齑暮盐，惟我保汝，人皆汝嫌。","book":"唐·韩愈《送穷文》"},"example":{"text":"太宜人～，黾勉佽助。","book":"清·钱谦益《秦母钱太宜人墓志铭》"},"similar":["粗茶淡饭"],"opposite":["山珍海味"],"usage":"作谓语、定语；形容生活极度清苦"},{"id":25705,"word":"期月有成","pinyin":"jī yuè yǒu chéng","abbr":"qyyc","explanation":"期：整月、整年。形容办事见效迅速，一个月便功效显著。","source":{"text":"苟有用我者，期月而已可也，三年有成。","book":"《论语·子路》"},"example":{"text":"若能人务退食，竞存约己，移风易俗，庶～。","book":"《梁书·武帝纪上》"},"usage":"作谓语、定语；用于书面语","story":["春秋时期，孔子自认为有才学，当权者会推行他的仁政，在鲁国任职期间，鲁君受到季氏的控制。他只有自己感叹：“苟有用我者，期月而已可也，三年有成。”鲁君始终没有重用他，他说：“邦有道，则仕；邦无道，则行。”于是只有周游列国了"]},{"id":25706,"word":"期期不可","pinyin":"qī qī bù kě","abbr":"qqbk","explanation":"指坚持不同意见。","source":{"text":"臣口不能言，然臣期期知其不可；陛下虽欲废太子，臣期期不奉诏。","book":"《史记·张丞相列传》"},"example":{"text":"而吾党同志，悉以此为不急之务，～，极端反对。","book":"孙中山《心理建设》第六章"}},{"id":25707,"word":"期期以为不可","pinyin":"qī qī yǐ wéi bù kě","abbr":"qqywbk","explanation":"指坚持不同意见。","source":{"text":"臣口不能言，然臣期期知其不可；陛下虽欲废太子，臣期期不奉诏。","book":"《史记·张丞相列传》"},"example":{"text":"数夕长谈，吾兄传位之意始终不改。然余连日详思，仍～。","book":"金庸《天龙八部》第十六章"},"usage":"作谓语；用于书面语"},{"id":25708,"word":"期期艾艾","pinyin":"qī qī ài ài","abbr":"qqaa","explanation":"形容口吃的人吐辞重复，说话不流利。","source":{"text":"邓艾口吃，语称艾艾。","book":"《史记·张丞相列传》：“臣口不能言，然臣期期知其不可；陛下虽欲废太子，臣期期不奉诏。”南朝宋·刘义庆《世说新语·言语》"},"example":{"text":"感情的激动使我说话～了。","book":"茅盾《腐蚀·十月十日》"},"similar":["支支吾吾"],"opposite":["油嘴滑舌"],"usage":"作谓语、状语；形容口吃","story":["汉朝初年，汾阳侯周昌跟随刘邦打天下，刘邦宠爱戚姬，想废太子立戚姬生的儿子赵王如意为太子。周昌不顾个人安危上殿晋见，结结巴巴不知说什么为好，就是阻止刘邦废太子。刘邦非常感动，再也不提废太子之事"]},{"id":25709,"word":"期颐之寿","pinyin":"qī yí zhī shòu","abbr":"qyzs","explanation":"期颐：百年。高寿的意思。","source":{"text":"百年曰期、颐。","book":"西汉·戴圣《礼记·典礼上》"},"example":{"text":"今送汝归，予以千金之产，～，于愿足乎？","book":"清·蒲松龄《聊斋志异·席方平》"},"usage":"作宾语；指高寿"},{"id":25710,"word":"朦朦胧胧","pinyin":"méng méng lóng lóng","abbr":"mmll","explanation":"指人意识不十分清晰或事物界限不清。","source":{"text":"夫人朦朦胧胧，尚不肯就走，早被几个宫人扶的扶，拽的拽，将他搀出宫来迎驾。","book":"清·褚人获《隋唐演义》第19回"},"example":{"text":"清·褚人获《隋唐演义》第19回：“夫人～，尚不肯就走，早被几个宫人扶的扶，拽的拽，将他搀出宫来迎驾。”"},"similar":["迷迷糊糊"],"usage":"作谓语、定语、状语；用于人或事物等"},{"id":25711,"word":"木人石心","pinyin":"mù rén shí xīn","abbr":"mrsx","explanation":"形容意志坚定，任何诱惑都不动心。","source":{"text":"统危坐如故，若无所闻。充等各散曰：‘此吴儿是木人石心也。’","book":"《晋书·夏统传》"},"example":{"text":"张生乃～也。使有情者见之，罪不容诛。","book":"宋·秦醇《谭意歌传》"},"similar":["木石心肠"],"usage":"作宾语、定语；形容意志坚定","story":["晋朝名士夏统很有名气，很多人想鼓动他出仕做官，他不动心。一次他到京城洛阳，太尉贾充请他乘华美的车子，穿漂亮的衣服，夏统不动心。贾充不死心，就用美女来引诱，他还是不动心。贾充感叹他是一个石头心、木头人"]},{"id":25712,"word":"木偶衣冠","pinyin":"mù ǒu yī guān","abbr":"moyg","explanation":"给木偶穿衣戴帽。比喻装模作样。","source":{"text":"木偶衣冠休嚇我，瓦伶口颊欲漫谁？","book":"金·元好问《马编修天来》"},"example":{"text":"致令天下成一木偶衣冠、官厨酒食之吏治，则唐之多能臣也，其初制固善也。","book":"明·王夫之《读通鉴论》卷二十"}},{"id":25713,"word":"木偶衣绣","pinyin":"mù ǒu yī xiù","abbr":"moyx","explanation":"给木头人穿上锦绣衣服。比喻庸人担任要职。","source":{"text":"今徒取富人子上之，又无智略，如木偶人衣之绮绣耳。","book":"《史记·田叔列传》"}},{"id":25714,"word":"木公金母","pinyin":"mù gōng jīn mǔ","abbr":"mgjm","explanation":"即仙人东王公和西王母。后用于祝寿，比喻庆寿之主人夫妇。","source":{"text":"昔汉初，小儿于道歌曰：‘著青裙，入天门，揖金母，拜木公。’时人皆不识，唯张子房知之。","book":"唐·杜光庭《仙传拾遗·木公》"},"example":{"text":"共喜～宴，正当浴佛饭僧时。","book":"清·赵翼《寿全惕庄鹾使六十》"},"usage":"作宾语、定语；用于祝寿"},{"id":25715,"word":"木坏山颓","pinyin":"mù huài shān tuí","abbr":"mhst","explanation":"木：梁木。山：指泰山。颓：倒下。梁木折坏，泰山崩倒。比喻德高望重的人死去。亦作“泰山梁木”。","source":{"text":"孔子蚤作，负手曳杖，消摇于门，歌曰：‘泰山其颓乎！梁木其坏乎！哲人其萎乎！’","book":"《礼记·檀弓上》"},"example":{"text":"～，江城付劫灰。","book":"清·孙雨林《皖江血·拒敌》"},"usage":"作宾语、定语；用于比喻句"},{"id":25716,"word":"木头木脑","pinyin":"mù tóu mù nǎo","abbr":"mtmn","explanation":"形容呆板、迟钝。","source":{"text":"而且变得木头木脑，竟连他母亲来看他也会显得冷冰冰的。","book":"沈虎根《小师弟》"},"example":{"text":"他有点～的。"},"similar":["呆头呆脑"],"opposite":["聪明伶俐"],"usage":"作谓语、定语、状语；指人迟钝"},{"id":25717,"word":"木居海处","pinyin":"mù jū hǎi chù","abbr":"mjhc","explanation":"木居：依树而居。指外族或少数民族居住在深山海岛。","source":{"text":"爱暨木居海处之酋，被发彫题之长，莫不忘其陋险，九泽来庭。","book":"《宋书·武帝纪中》"}},{"id":25718,"word":"木已成舟","pinyin":"mù yǐ chéng zhōu","abbr":"mycz","explanation":"树木已经做成了船。比喻事情已成定局，无法改变。","source":{"text":"如今木已成舟，也是林兄命定如此了。","book":"清·李汝珍《镜花缘》第三十四回"},"example":{"text":"事情到了这样，可说～。姑少爷再不好，大小姐也只得耐着好好活下去。","book":"巴金《春》二十"},"similar":["覆水难收"],"opposite":["变幻莫测"],"usage":"作谓语、定语、分句；指已成定局"},{"id":25719,"word":"木干鸟栖","pinyin":"mù gàn niǎo qī","abbr":"mgnq","explanation":"指鸟栖树上，至树干枯也不离去。比喻行事坚定不移。","source":{"text":"身不敢饮食，拥辕执轺，木干鸟栖，袒肉暴骸。","book":"春秋·齐·晏婴《晏子春秋·外篇》"},"usage":"作宾语、定语；指人的意志坚定"},{"id":25720,"word":"木强则折","pinyin":"mù qiáng zé zhé","abbr":"mqzz","explanation":"强：坚硬。质地硬的木材容易脆裂折断。比喻一味强硬反而会招致失败。","source":{"text":"是以兵强则灭，木强则折，坚强处下，柔弱处上。","book":"《老子》第七十六章"},"example":{"text":"故兵强则灭，～，革固则裂，齿坚于舌而先之弊。","book":"《淮南子·原道训》"}},{"id":25721,"word":"木强少文","pinyin":"mù jiàng shǎo wén","abbr":"mqsw","explanation":"木强：质朴而倔强；少文：缺少文采和礼教。形容人质朴倔强，不会文饰。","source":{"text":"勃为人木强敦厚，高帝以为可属大事……不好文学，每召诸生说士，东乡坐而责之：‘趣为我语。’其椎少文如此。","book":"《史记·绛侯周勃世家》"},"example":{"text":"汉祖所任用者，上自萧何、曹参，其下至于王陵、周勃、樊哙、夏侯婴之徒，大抵～，不识利害。","book":"章太炎《革命之道德》"},"usage":"作谓语、定语；用于书面语"},{"id":25722,"word":"木强敦厚","pinyin":"mù jiàng dūn hòu","abbr":"mqdh","explanation":"木强：质朴而倔强；敦厚：忠厚。比喻人品纯朴忠厚，性格倔强。","source":{"text":"勃为人木强敦厚，高帝以为可属大事。","book":"《史记·绛侯周勃世家》"}},{"id":25723,"word":"木形灰心","pinyin":"mù xíng huī xīn","abbr":"mxhx","explanation":"形：形体。比喻不受外物干扰，意志坚定。","source":{"text":"又或杜门隐己，块然自居，木形灰心，动逾旬月。","book":"唐·白居易《答户部崔侍郎书》"},"usage":"作谓语、宾语；指人意志坚定"},{"id":25724,"word":"木心石腹","pinyin":"mù xīn shí fù","abbr":"mxsf","explanation":"犹木人石心。形容意志坚定，任何诱惑都不动心。","source":{"text":"而君介然，不蒙顾盼，亦木心石腹之人也。","book":"宋·张邦基《墨庄漫录》第五卷"},"similar":["木石心肠","铁石心肠"],"usage":"作主语、宾语；指人心肠硬"},{"id":25725,"word":"木木樗樗","pinyin":"mù mù chū chū","abbr":"mmcc","explanation":"形容呆呆的样子。","source":{"text":"水蛇跳一跳，又变做一支花鸨，木木樗樗的立在蓼汀之上。","book":"明·吴承恩《西游记》第六回"}},{"id":25726,"word":"木本之谊","pinyin":"mù běn zhī yì","abbr":"mbzy","explanation":"指宗族情谊。","source":{"text":"并将近日桂兰乳讳，各命学名开示，庶异日不致互异。木本之谊，情切，情切。","book":"清·李绿园《歧路灯》第一回"}},{"id":25727,"word":"木本水源","pinyin":"mù běn shuǐ yuán","abbr":"mbsy","explanation":"木：树的根；源：水的源头。树的根本，水的源头。比喻事物的根本或事情的原因。","source":{"text":"我在伯父，犹衣服之有冠冕，水木之有本原，民人之有谋主也。","book":"《左传·昭公九年》"},"example":{"text":"以～而论，究竟我们天朝要算万邦根本了。","book":"清·李汝珍《镜花缘》第十六回"},"usage":"作宾语；比喻事物的根源"},{"id":25728,"word":"木朽不雕","pinyin":"mù xiǔ bù diāo","abbr":"mxbd","explanation":"朽：烂；雕：雕刻。朽坏的木头无法雕刻。比喻人不上进，不可造就。","source":{"text":"夫木朽不雕，世衰难佐，将军虽欲委忠难佐之朝，雕画朽败之木，犹逆坂而走丸，必不可也。","book":"《九州春秋》"},"similar":["朽木不雕"],"usage":"作定语、宾语；指人不可造就"},{"id":25729,"word":"木朽形秽","pinyin":"mù xiǔ xíng huì","abbr":"mxxh","explanation":"朽：腐朽，衰老。比喻内无才学，外观恶俗。"},{"id":25730,"word":"木朽蛀生","pinyin":"mù xiǔ zhù shēng","abbr":"mxzs","explanation":"朽：腐烂。木朽腐烂就会生虫子。比喻失去检点就会犯错误。","source":{"text":"信陵君不忌魏王，而径请之如姬，其素窥魏王之疎也；如姬不忌魏王而敢于窃符，其素恃魏王之宠也，木朽而蛀生之矣。","book":"明·唐顺之《信陵君救赵论》"},"example":{"text":"浙人无故逐吕，乃致段派乘间而入，～，非自取而何？","book":"蔡东藩、许廑父《民国通俗演义》第八十回"}},{"id":25731,"word":"木梗之患","pinyin":"mù gěng zhī huàn","abbr":"mgzh","explanation":"比喻客死他乡，不得复归故里。","source":{"text":"今秦，四塞之国也，有虎狼之心，恐其有木梗之患。","book":"汉·刘向《说苑·正谏》"},"usage":"作宾语；用于比喻句","story":["战国时期，孟尝君准备去西边的秦国，门客用寓言谏之说：在淄水听到土耦人与木梗人的对话，木梗人说土耦人前身是土，遇水必化。土耦人说木梗人是东园之桃，遇水漂泊异乡。秦国有虎狼之心，不能去。孟尝君才能门客的意见，不敢去秦国"]},{"id":25732,"word":"木牛流马","pinyin":"mù niú liú mǎ","abbr":"mnlm","explanation":"木制的牛马形体、可行走的运输器具。","source":{"text":"亮性长于巧思，损益连弩，木牛流马，皆出其意。","book":"晋·陈寿《三国志·蜀志·诸葛亮传》"},"usage":"作主语、宾语、定语；指运输工具","story":["三国时期，诸葛亮六出祁山与司马懿对阵，他偷偷在葫芦谷中制造出木牛流马，用这些木牛流马运送军粮，省去不少人力。司马懿派人抢去几匹，照样造成2000匹投入运送军粮，诸葛亮派王平率1000名精兵把这些木牛流马连同军粮抢回"]},{"id":25733,"word":"木犹如此，人何以堪","pinyin":"mù yóu rú cǐ，rén hé yǐ kān","abbr":"myrcrhyk","explanation":"堪：忍受。树林已长成这样，人又怎么能够忍受呢？表示对眼前事物发生的巨大变化，触景生情而发出的慨叹。","source":{"text":"桓公北面，经金城，见前为琅邪时种柳，皆已十围，慨然曰：‘木犹如此，人可以堪！’攀枝执条，泫然流泪。","book":"南朝·宋·刘义庆《世说新语·言语》"}},{"id":25734,"word":"木猴而冠","pinyin":"mù hóu ér guàn","abbr":"mheg","explanation":"猴子穿衣戴帽装扮成人样。比喻虚有其表而无真本领。用来讽刺投靠权势窃据权位的人。","source":{"text":"项王乃是木猴而冠，不足谋天下矣。","book":"明·沈采《千金记·会宴》"},"similar":["沐猴而冠","沐猴冠冕","沐猴衣冠"],"usage":"作谓语、定语、宾语；指人面兽心的人"},{"id":25735,"word":"木直中绳","pinyin":"mù zhí zhòng shéng","abbr":"mzzs","explanation":"中：符合、合乎；绳：木匠用以取直，浸满墨汁的线绳。木材直得合乎拉直的墨线。","source":{"text":"木直中绳，輮以为轮，其曲中规。","book":"战国·赵·荀况《劝学》"},"usage":"作谓语、定语；指木材很直"},{"id":25736,"word":"木石为徒","pinyin":"mù shí wéi tú","abbr":"mswt","explanation":"徒：同类。与树木石头为伴。指寄情山水，不问世事。","source":{"text":"用是更乐暗默，与木石为徒，不复致意。","book":"《新唐书·柳宗元传》"},"usage":"作宾语、定语；用于隐士"},{"id":25737,"word":"木石心肠","pinyin":"mù shí xīn cháng","abbr":"msxc","explanation":"形容人心肠硬，不为情感所动。","source":{"text":"虽木石心肠，亦为之动。","book":"清·洪楝园《后南柯·辞职》"},"example":{"text":"他这个人真是～。"},"similar":["铁石心肠"],"opposite":["心慈面软"],"usage":"作主语、宾语；指人心肠硬"},{"id":25738,"word":"木石鹿豕","pinyin":"mù shí lù shǐ","abbr":"msls","explanation":"豕：猪。形容无知无识。","source":{"text":"城北十里余许，有名康塘者，山川佳胜，木石鹿豕，可纵居游，诚高蹈之墟、君子之居也。","book":"宋·朱熹《康塘三瑞堂记》"},"example":{"text":"冤哉，谓我～耶！具有口鼻，岂有触香臭而不知者？","book":"清·蒲松龄《聊斋志异·珊瑚》"},"usage":"作宾语、定语；用于比喻句"},{"id":25739,"word":"木秀于林","pinyin":"mù xiù yú lín","abbr":"mxyl","explanation":"秀：出众，突出。高出森林的大树。比喻才能或品行出众的人。也措指新人新事刚刚出现。","source":{"text":"故木秀于林，风必摧之；堆出于岸，流必湍之；行高于人，众必非之。前鉴不远，覆车继轨。","book":"三国·魏·李康《运命论》"},"example":{"text":"～，风必摧之。辫亮于人，择而剪之。一场少年玩笑，因地位悬殊，便何其郑重。","book":"金庸《鹿鼎记》第十二一回"}},{"id":25740,"word":"木秀于林，风必摧之","pinyin":"mù xiù yú lín，fēng bì cuī zhī","abbr":"mxylfbcz","explanation":"秀：出众，突出；摧：摧残。高出森林的大树总是要被大风先吹倒。比喻才能或品行出众的人，容易受到嫉妒、指责。","source":{"text":"故木秀于林，风必摧之；堆出于岸，流必湍之；行高于人，众必非之。前鉴不远，覆车继轨。","book":"三国·魏·李康《运命论》"},"example":{"text":"～。辫亮于人，择而剪之。一场少年玩笑，因地位悬殊，便何其郑重。","book":"金庸《鹿鼎记》第十二一回"},"usage":"作宾语、定语、分句；用于书面语"},{"id":25741,"word":"木落归本","pinyin":"mù luò guī běn","abbr":"mlgb","explanation":"犹言叶落归根。比喻事物总有一定的归宿。多指作客他乡的人最终要回到本乡。","source":{"text":"翼氏《风角》曰：‘木落归本，水流归末’，故木利在亥，水利在辰，盛衰各得其所，故东也。","book":"东汉·班固《汉书·翼奉传》：“安乐奸邪，辰未主之。”颜师古注引三国·魏·孟康曰"},"similar":["叶落归根"],"usage":"作谓语、宾语、定语；比喻事物有一定的归宿"},{"id":25742,"word":"木讷寡言","pinyin":"mù nè guǎ yán","abbr":"mngy","explanation":"木讷：质朴而不善辞令。质朴而不善于说话。","source":{"text":"为人木讷，不好荣利，闭门却扫，未尝交游。","book":"《晋书·葛洪传》"},"example":{"text":"这一问，把～的景寿吓得有些心惊肉跳，显然的，皇后是拿康熙诛鳌拜的故事，作为警告。","book":"高阳《慈禧全传》四"}},{"id":25743,"word":"木雁之间","pinyin":"mù yàn zhī jiān","abbr":"myzj","explanation":"木雁：比喻有才与无才。指有才与无才之间。比喻才能或学问处于中间水平，能保全自己，远避祸害。","source":{"text":"弟子问庄子：‘昨日山中之木以不材得终其天年，今主人之雁，以不材死，先生将何处？’庄子笑曰：‘周将处乎材与不材之间。’","book":"《庄子·山木》"},"example":{"text":"此身何处著，从教容与，～。","book":"元·段克己《满庭芳》词"},"usage":"作宾语、定语；用于比喻句","story":["战国时期，有人问大思想家庄周：昨日山中的树木因为不能成材才得以终其天年，今日主人家里的大雁也因不成材而死，先生你感觉自己怎么样呢？庄子笑着说：“我将处于材与不材之间。”"]},{"id":25744,"word":"木雕泥塑","pinyin":"mù diāo ní sù","abbr":"mdns","explanation":"用木头雕刻或泥土塑造的偶像。形容人呆板不灵活或神情呆滞。","source":{"text":"两班文武，如泥塑木雕，无人敢应。","book":"明·冯梦龙《警世通言》卷九"},"example":{"text":"怡红院里的人吓的一个个象～一般。","book":"清·曹雪芹《红楼梦》第九十四回"},"similar":["泥塑木雕"],"usage":"作定语、宾语；指人的神情"},{"id":25745,"word":"木魅山鬼","pinyin":"mù mèi shān guǐ","abbr":"mmsg","explanation":"魅：物老成精。指山林的鬼怪。","source":{"text":"木魅山鬼，野鼠城狐。","book":"南朝·宋·鲍照《芜城赋》"},"usage":"作主语、宾语、定语；指山林的鬼怪"},{"id":25746,"word":"木鸡养到","pinyin":"mù jī yǎng dào","abbr":"mjyd","explanation":"木鸡：善斗的鸡，看上去象木头一样呆板。形容功夫到家。","source":{"text":"几矣。鸡虽有鸣者，已无变矣，望之似木鸡矣，其德全矣；异鸡无敢应者，反走矣。","book":"《庄子·达生》"}},{"id":25747,"word":"未与人接","pinyin":"wei yu ren jie","abbr":"wyrj","explanation":"和社会上的人没什么交往。"},{"id":25748,"word":"未为不可","pinyin":"wèi wéi bù kě","abbr":"wwbk","explanation":"不是不可以。委婉地肯定。","source":{"text":"各位所长，优则存之，劣则删之，未为不可。","book":"清·曹雪芹《红楼梦》第17回"},"usage":"作谓语；指婉转地肯定"},{"id":25749,"word":"未了公案","pinyin":"wèi liǎo gōng àn","abbr":"wlga","explanation":"公案：案件，问题。没有解决的案件或事情。","source":{"text":"时有僧问：‘如何是先师未了底公案？’师便打曰：‘祖祢不了，殃及儿孙。’","book":"宋·释普济《五灯会元·清凉泰饮灯禅师》"},"example":{"text":"文成公于‘思无邪’自为一说，前辈谓之～。","book":"元·方回《可言集考》"},"opposite":["盖棺论定"],"usage":"作宾语、定语；指没完的事情"},{"id":25750,"word":"未亡之人","pinyin":"wèi wáng zhī rén","abbr":"wwzr","explanation":"旧时寡妇的自称。","source":{"text":"夫人闻之，泣曰：‘先君以是舞也，习戒备也。今令尹不寻诸仇，而于未亡人之侧，不亦异乎？’","book":"《左传·庄公二十八年》"},"example":{"text":"小尼是个～，长发改妆何用？只为冤恨未伸，故此上求相公做主。","book":"明·凌濛初《初刻拍案惊奇》卷二十七"}},{"id":25751,"word":"未亡人","pinyin":"wèi wáng rén","abbr":"wwr","explanation":"旧时寡妇的自称。","source":{"text":"夫人闻之，泣曰：‘先君以是舞也，习戒备也。今令尹不寻诸仇，而于未亡人之侧，不亦异乎？’","book":"《左传·庄公二十八年》"},"example":{"text":"上海的寓公们为国家担惊受恐够了，现在国家并没有亡，不必做～，所以又照常热闹起来。","book":"钱钟书《围城》第二章"}},{"id":25752,"word":"未兆易谋","pinyin":"wèi zhī yì móu","abbr":"wzym","explanation":"兆：先兆；谋：谋划。还没露出破绽的时候容易谋划。","source":{"text":"其安易持，其未兆易谋。","book":"《老子》第六十四章"}},{"id":25753,"word":"未卜先知","pinyin":"wèi bǔ xiān zhī","abbr":"wbxz","explanation":"卜：占卜，打卦，古人用火灼龟甲，看灼开的裂纹推测未来的吉凶祸富。没有占卜便能事先知道。形容有预见。","source":{"text":"卖弄杀《周易》阴阳谁似你，还有个未卜先知意。","book":"元·无名氏《桃花女》第三折"},"example":{"text":"有这等事，真个～！","book":"明·许恒《二奇缘传奇》二"},"similar":["料事如神","先见之明"],"usage":"作谓语、定语；形容有预见"},{"id":25754,"word":"未卜生死","pinyin":"wèi bǔ shēng sǐ","abbr":"wbss","explanation":"指死活无法知道。","source":{"text":"徐郎辽海从戍，死生未卜，纵饶无恙，又安能至此而成姻乎？","book":"明·李祺昌《剪灯余话·琼奴传》"},"example":{"text":"我母亲、兄弟等一门家属俱流住云南，～。","book":"清·钱彩《说岳全传》第六十六回"}},{"id":25755,"word":"未可厚非","pinyin":"wèi kě hòu fēi","abbr":"wkhf","explanation":"厚非：过分责难、责备。不能过分责备。指说话做事虽有缺点，但还有可取之处，应予谅解。","source":{"text":"莽怒，免英官。后颇觉悟，曰：‘英亦未可厚非。’","book":"《汉书·王莽传中》"},"example":{"text":"但叶遂宁和梭波里是～的，他们先后给自己唱了挽歌，他们有真实。","book":"鲁迅《三闲集·在钟楼上》"},"similar":["无可非议","无可厚非"],"opposite":["一无是处"],"usage":"作谓语；指不能全面否定","story":["汉元帝皇后的侄子王莽篡夺皇位建立新朝，益州地方少数民族起兵反抗朝廷，王莽派重兵去镇压，向百姓征收重税作军费。太守冯英看到百姓苦不堪言就拒绝供粮。王莽大怒，下令罢免冯英的官职，假惺惺地对人说其实冯英也未可厚非"]},{"id":25756,"word":"未可同日而语","pinyin":"wèi kě tóng rì ér yǔ","abbr":"wktrey","explanation":"指两者相差很大，不能相提并论。","source":{"text":"由此观之，其为乐未可以同日而语也。","book":"宋·苏轼《放鹤亭记》"},"example":{"text":"孙中山《裁兵宣言》：“渐进之与顿改，其图功之利钝，收效之速缓，昭然～。”"},"similar":["不可同日而语"],"usage":"作谓语；形容不能相比"},{"id":25757,"word":"未定之天","pinyin":"wèi dìng zhī tiān","abbr":"wdzt","explanation":"比喻事情还没有着落或还没有决定。","source":{"text":"莫若此时趁事在成败未定之天，自己先留个地步。","book":"清·文康《儿女英雄传》第十回"},"example":{"text":"事情还在～，你们忙些啥？","book":"周立波《暴风骤雨》第二部"},"usage":"作宾语；指还未决定的时候"},{"id":25758,"word":"未尝不可","pinyin":"wèi cháng bù kě","abbr":"wcbk","explanation":"未尝：加在否定词前面，构成双重否定，使肯定的意思表达得委婉些。指不是不可以的。","source":{"text":"方今宽裕广大，有古之道，大臣之在内，有不便于京而求出，小臣之在外，有不便于身而求归，朝廷未尝不可，而士亦未有以此非之者也。","book":"宋·王安石《上执政书》"},"example":{"text":"说以前九年都是酝酿的时期，或是过渡的时期，也～。","book":"朱自清《时代与我》"}},{"id":25759,"word":"未形之患","pinyin":"wèi xíng zhī huàn","abbr":"wxzh","explanation":"尚未显露的祸患。","source":{"text":"若仓卒之际，得钱何用。不如先取为备，可以建事立功，消未形之患。","book":"宋·苏舜钦《咨目》五"},"usage":"作宾语；用于书面语"},{"id":25760,"word":"未必尽然","pinyin":"wèi bì jìn rán","abbr":"wbjr","explanation":"不一定全是这样。","source":{"text":"帝王之所以与天下为画一，不以亲疏贵贱而轻重者也。今之刑赏，未必尽然。","book":"《旧唐书·魏征传》"},"example":{"text":"这也～。你且出去，卷子待本道细细看。","book":"清·吴敬梓《儒林外史》第三回"}},{"id":25761,"word":"未成一篑","pinyin":"wèi chéng yī kuì","abbr":"wcyk","explanation":"犹功亏一篑。比喻功败垂成。","source":{"text":"譬如为山，未成一篑，止吾止也。","book":"《论语·子罕》"},"example":{"text":"元·方回《勉斋箴》：“并九仞而不及泉兮，山～而止，浚之深而崇之高兮，亦在乎匷之而已。”"},"similar":["功亏一篑"],"usage":"作谓语、定语；指功败垂成"},{"id":25762,"word":"未敢苟同","pinyin":"wèi gǎn gǒu tóng","abbr":"wggt","explanation":"不敢随便同意。","example":{"text":"请你原谅，你的意见，我～。"},"similar":["不敢苟同"],"usage":"作谓语；用于处事"},{"id":25763,"word":"未明求衣","pinyin":"wèi míng qiú yī","abbr":"wmqy","explanation":"天没有亮就穿衣起床。形容勤于政事。","source":{"text":"伏惟陛下未明求衣，思贤如渴，爰发明诏，各举所知。","book":"《汉书·邹阳传》：“始孝文皇帝据关入立，寒心销志，不明求衣。”《梁书·顾协传》"},"example":{"text":"《周书·乐运传》：“天子～，日旰忘食，犹恐万机不理，天下拥滞。”"},"usage":"作谓语、定语；用于处事"},{"id":25764,"word":"未易之才","pinyin":"wèi yì zhī cái","abbr":"wyzc","explanation":"指具有别人代替不了的才能。","source":{"text":"旬初辟大民掾，桓温至重之，常称王掾必为黑头公，未易才也。","book":"南朝·宋·檀道鸾《续晋阳秋》"}},{"id":25765,"word":"未有伦比","pinyin":"wèi yǒu lún bǐ","abbr":"wylb","explanation":"伦比：类比，匹敌。指事物非常完美，没有能跟它相比的。","source":{"text":"数千百年以来，未有伦比。","book":"唐·韩愈《论佛骨表》"}},{"id":25766,"word":"未焚徙薪","pinyin":"wèi fén xǐ xīn","abbr":"wfxx","explanation":"在火患之前就先将柴薪搬开。比喻防患于未然。","source":{"text":"这枢密院官都是怕事的，只晓得临渴掘井，那会得未焚徙薪？","book":"明·冯梦龙《喻世明言》卷三十九"},"similar":["曲突徙薪"],"usage":"作谓语、定语；用于事先预防"},{"id":25767,"word":"未知万一","pinyin":"wèi zhī wàn yī","abbr":"wzwy","explanation":"万分之一都不知道。形容学识肤浅。","source":{"text":"世之庸医，学方书未知万一，自以为足，吁！可惧哉。","book":"宋·洪迈《夷坚乙志·张锐医》"},"usage":"作谓语、定语；指人没文化"},{"id":25768,"word":"未知所措","pinyin":"wèi zhī suǒ cuò","abbr":"wzsc","explanation":"措：安置，处理。不知道怎么办才好。形容处境为难或心神慌乱。","source":{"text":"哀喜交并，不知所措。","book":"《论语·子路》：“则民无所措手足。”《三国志·吴志·诸葛恪传》"},"similar":["不知所措"],"usage":"作谓语、状语、定语；指处境很为难"},{"id":25769,"word":"未窥全豹","pinyin":"wèi kuī quán bào","abbr":"wkqb","explanation":"窥：从小孔或缝隙里看；全豹：比喻事物的全部。指没有看到事物的全部。","source":{"text":"适颌一艺，未窥全豹。","book":"清·蒲松龄《聊斋志异·司文郎》"},"example":{"text":"今日来到闯王军中，对闯王全军情况，～，仅见一斑。","book":"姚雪垠《李自成》第二卷第四十八章"}},{"id":25770,"word":"未竟之业","pinyin":"wèi jìng zhī yè","abbr":"wjzy","explanation":"竟：完成。还没有完成的事业。","example":{"text":"粤省匪氛未靖，尤在厉行军政，务使内地一律肃清，继续陈前都督所～。","book":"丁中江《北洋军阀史话》四十二"}},{"id":25771,"word":"未竟之志","pinyin":"wèi jìng zhī zhì","abbr":"wjzz","explanation":"没有完成的志向。","source":{"text":"今日之下，退守山林，却深望这个儿子，完我未竟之志。","book":"清·文康《儿女英雄传》第35回"},"example":{"text":"我希望能够实现他的～。"},"similar":["壮志未酬"],"usage":"作宾语；指尚未实现的志愿"},{"id":25772,"word":"未老先衰","pinyin":"wèi lǎo xiān shuāi","abbr":"wlxs","explanation":"年纪还不大就衰老了。多指由于精神或体力负担过重而导致过早衰老。","source":{"text":"琬殷忧（车感）轲，未老先衰。","book":"清·汪琬《与参议施先生书》"},"example":{"text":"北京老将军们的歌声，是应该使一切精神上～的“假老头儿”惭愧的吧！","book":"秦牧《不老》"},"similar":["望秋先零"],"opposite":["老当益壮"],"usage":"作主语、谓语；指过早衰老"},{"id":25773,"word":"未能免俗","pinyin":"wèi néng miǎn sú","abbr":"wnms","explanation":"没能够摆脱开自己不以为然的风俗习惯。","source":{"text":"未能免俗，聊复尔耳。","book":"南朝宋·刘义庆《世说新语·任诞》"},"example":{"text":"倘使揭穿了这谜底，便是所谓“杀风景”，也就是俗人，而且带累了雅人，使他雅不下去，“～”了。","book":"鲁迅《论俗人应避雅人》"},"opposite":["超凡入圣"],"usage":"作谓语、定语；指人俗气","story":["魏晋时期，“竹林七贤”经常在嵇康家附近竹林中饮酒谈诗赋。阮籍阮咸叔侄家道清贫，但很清高。根据当时的风俗，每年七月七日，家家户户都翻箱倒箧把衣服都拿出来晒一晒，阮咸也不例外，他表示不要脱俗"]},{"id":25774,"word":"未能免俗，聊复尔耳","pinyin":"wèi néng miǎn sú，liáo fù ěr ěr","abbr":"wnmslfee","explanation":"俗：习俗；聊：姑且；尔：如此；耳：而已，罢了。没能够摆脱开自己不以为然的风俗习惯。指行动受习惯的影响而不得不随俗。","source":{"text":"人或怪之，答曰：‘未能免俗，聊复尔耳。’","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":25775,"word":"未艾方兴","pinyin":"wèi ài fāng xīng","abbr":"wafx","explanation":"方兴未艾。指正在蓬勃向前发展。","source":{"text":"天下非有豪猾不可制之奸，虏人非有方兴未艾之势，而何必用此哉！","book":"宋·陈亮《戊申再上孝宗皇帝书》"},"example":{"text":"新年新气象，新事物～"},"similar":["方兴未艾"],"usage":"作谓语、定语；指事物正在发展"},{"id":25776,"word":"未视之狗","pinyin":"wèi shì zhī gǒu","abbr":"wszg","explanation":"刚刚生下还未睁开眼的小狗。比喻蒙昧无知的人。","source":{"text":"子之比我蒙蒙，如未视之狗耳。","book":"汉·刘向《说苑·杂言》"}},{"id":25777,"word":"未识一丁","pinyin":"wèi shí yī dīng","abbr":"wsyd","explanation":"丁：“个”的讹字。不认识一个字，指没有文化的人。亦作“目不识丁”、“不识一丁”。","source":{"text":"天下无事，汝辈挽得两石弓，不如识一丁字。","book":"《旧唐书·张弘靖传》"},"example":{"text":"文职有～，武阶亦未挟一矢。","book":"《明史·王端传》"},"similar":["目不识丁","不识一丁"],"usage":"作谓语、定语；指没有文化"},{"id":25778,"word":"未足为道","pinyin":"wèi zú wéi dào","abbr":"wzwd","explanation":"不值得一提。","source":{"text":"若与他作对，即是心境两洷能所双行，便有种种见解，亦是狂慧，未足为道。","book":"宋·释道元《五灯会元·长髭旷禅师法嗣》"},"similar":["不值一提"],"usage":"作谓语、定语；用于书面语"},{"id":25779,"word":"未足轻重","pinyin":"wèi zú qīng zhòng","abbr":"wzqz","explanation":"指无关紧要，不值得重视。","source":{"text":"王文成后日功名不必言，即扬廉亦至南礼部尚书，谥文恪，则言官白简，亦未足轻重也。","book":"明·沈德符《万历野获编·京考官劾》"},"similar":["无足轻重"],"usage":"作谓语、定语；用于书面语"},{"id":25780,"word":"未辨菽麦","pinyin":"wèi biàn shū mài","abbr":"wbsm","explanation":"菽：豆子。分不清哪是豆子，哪是麦子。形容愚笨无知。后形容缺乏实际生产知识。","source":{"text":"孙权小子，未辨菽麦，要领不足以膏齐斧，名字不足以洿简墨。","book":"《左传·成公十八年》：“周子有兄而无慧，不能辨菽麦，故不可立。”汉·陈琳《檄吴将校部曲文》"}},{"id":25781,"word":"未达一间","pinyin":"wèi dá yī jiān","abbr":"wdyj","explanation":"指未能通达，只差一点。","source":{"text":"颜渊亦潜心于仲尼矣，未达一间耳。","book":"汉·扬雄《法言·问神》"},"example":{"text":"这两件东西～。"},"similar":["相差无几"],"usage":"作谓语、定语；指相差不远"},{"id":25782,"word":"未雨绸缪","pinyin":"wèi yǔ chóu móu","abbr":"wycm","explanation":"绸缪：紧密缠缚。天还没有下雨，先把门窗绑牢。比喻事先做好准备工作。","source":{"text":"迨天之未阴雨，彻彼桑土，绸缪牖户。","book":"《诗经·豳风·鸱号》"},"example":{"text":"那是不关我教习的事，在乎你们自己～的。","book":"清·无名氏《官场维新记》第四回"},"similar":["有备无患","防患未然"],"opposite":["临渴掘井"],"usage":"作谓语、定语；形容事先准备","story":["周武王率军灭了商朝后，把有功之臣分封到各地去做诸侯，留下周公在朝辅政。武王死，年幼的成王在周公的扶持下管理朝政。有人散布谣言说周公要废成王，周公表示要像鸟儿那样未雨绸缪，整顿朝政，肃清叛乱，然后自己退隐"]},{"id":25783,"word":"未风先雨","pinyin":"wèi fēng xiān yǔ","abbr":"wfxy","explanation":"比喻未见事实先下结论。","source":{"text":"婆子家晓道什么？只管胡言乱语！那见得我不会做生意，弄坏了事，要你未风先雨。","book":"明·冯梦龙《醒世恒言》卷三十五"},"usage":"作谓语、定语；多用于口语"},{"id":25784,"word":"末作之民","pinyin":"mò zuò zhī mín","abbr":"mzzm","explanation":"末作：中国古代以农业为本业，工商各业为末业。指从事农业以外的经营者。","source":{"text":"耕作之士困，末作之民利者，可亡也。","book":"《韩非子·亡征》"},"example":{"text":"此三者农夫皆兼为之，而游惰～，亦不免于庸调。","book":"宋·苏辙《栾城应诏集》卷十"}},{"id":25785,"word":"末俗流弊","pinyin":"mò sú liú bì","abbr":"mslb","explanation":"末俗：末世的不良风气；流弊：相袭而成的弊端。末世的衰败习气和各种弊端。比喻末世动乱年代的不良社会风气。","source":{"text":"今末俗之弊，政事烦多，宰相之材，不能及古，而丞相独兼三公之事，所以久废而不治也。","book":"汉·董仲舒《士不则遇赋》：“生不丁三代之盛隆兮，而丁三季之末俗。”《汉书·朱博传》"}},{"id":25786,"word":"末大不掉","pinyin":"mò dà bù diào","abbr":"mdbd","explanation":"犹尾大不掉。比喻部属势力强大，难以驾驭。","source":{"text":"末大必折，尾大不掉，君所知也。","book":"《左传·昭公十一年》"},"example":{"text":"余以为周之丧久矣，徒建空名于诸侯之上耳！得非诸侯之强盛，～之咎欤？","book":"唐·柳完元《封建论》"},"similar":["尾大不掉"],"usage":"作谓语、定语；指难以驾驭"},{"id":25787,"word":"末大必折","pinyin":"mò dà bì zhé","abbr":"mdbz","explanation":"末：树梢，末梢。树木枝端粗大，必折其干。喻下属权重，危及上级。","source":{"text":"末大必折，尾大不掉，君所知也。","book":"《左传·昭公十一年》"},"example":{"text":"三国·魏·曹冏《六代论》：“所谓～，尾大难掉，尾同于体，犹或不从，况乎非体之尾，其可掉哉！”"},"usage":"作宾语、定语；用于劝诫人"},{"id":25788,"word":"末大必折，尾大不掉","pinyin":"mò dà bì zhé，wěi dà bù diào","abbr":"mdbzwdbd","explanation":"掉：摇动。树梢茂盛，主干就会折断，尾巴太大，掉转不灵。旧时比喻部下的势力很大，无法指挥调度。现比喻机构庞大，指挥不灵。","source":{"text":"末大必折，尾大不掉，君所知也。","book":"《左传·昭公十一年》"}},{"id":25789,"word":"末如之何","pinyin":"mò rú zhī hé","abbr":"mrzh","explanation":"犹言无法对付，莫可奈何。","source":{"text":"子曰：‘法语之言，能无从乎？改之为贵。巽与之言，能无说乎？绎之为贵。说而不绎，从而不改，吾末如之何也已矣。’","book":"《论语·子罕》"},"example":{"text":"人倚栏干，似曾相识；筵开玳瑁，～。","book":"清·魏子安《花月痕》第十五回"},"usage":"作谓语；用于处事"},{"id":25790,"word":"末学后进","pinyin":"mò xué hòu jìn","abbr":"mxhj","explanation":"学识肤浅的晚辈。","example":{"text":"教主美意，想我令狐冲乃～，如何敢和教主比肩称兄道弟？","book":"金庸《笑傲江湖》二十二"}},{"id":25791,"word":"末学肤受","pinyin":"mò xué fū shòu","abbr":"mxfs","explanation":"指学问没有从根本上下功夫，只学到一点皮毛。","source":{"text":"若客所谓末学肤受，贵耳而践目者也。","book":"汉·张衡《东都赋》"},"example":{"text":"而况乎～如鄙人者，偶有论述，不过演师友之口说，拾西哲余唾，寄他人之脑之舌于我笔端而已。","book":"清·梁启超《饮冰室文集》原序"},"similar":["肤浅末学"],"usage":"作宾语、定语；指学问"},{"id":25792,"word":"末学陋识","pinyin":"mò xué lòu shí","abbr":"mxls","explanation":"末学：学无根底；陋识：学识肤浅。指学问没有从根本上下功夫，只学到一点皮毛。","source":{"text":"若客所谓末学肤受，贵耳而践目者也。","book":"汉·张衡《东都赋》"},"example":{"text":"况上下数千年，贯串二十五代，而欲以～，操觚窜定其间。","book":"元·马端临《文献通考序》"}},{"id":25793,"word":"末由也已","pinyin":"mò yóu yě yǐ","abbr":"myyy","explanation":"末：没有；由：遵循。指无方可遵，无章可循。","source":{"text":"如有所立，卓尔，虽欲从之，末由也已。","book":"《论语·子罕》"},"example":{"text":"谓攻如攻人之恶之攻，已如～之已。","book":"明·郎瑛《七修类稿》卷十八"}},{"id":25794,"word":"末节细行","pinyin":"mò jié xì xíng","abbr":"mjxx","explanation":"指无关大体的细小行为。","source":{"text":"古之所为小人儒者，亦不过依据末节细行以自律，未知如今人有如许浮论虚说谬悠无根之甚。","book":"宋·陆九渊《与曾宅之书》"},"example":{"text":"我们得注意生活中的～，但不能处事谨小慎微"},"usage":"作主语、宾语；用于生活"},{"id":25795,"word":"末路之难","pinyin":"mò lù zhī nán","abbr":"mlzn","explanation":"末路：最后的一段路程。走最后一段路程是艰难的。比喻越到最后，工作越艰巨。也比喻保持晚节不易。","source":{"text":"‘行百里路，半于九十’，此言末路之难。","book":"《战国策·秦策五》"},"example":{"text":"既髦，犹患～。","book":"《宋史·赵蕃传》"},"usage":"作宾语；比喻做事越接近成功越困难"},{"id":25796,"word":"末路穷途","pinyin":"mò lù qióng tú","abbr":"mlqt","explanation":"穷途：处境困窘。无路可走。比喻处境极端困难。","source":{"text":"子胥曰：‘夫人赈穷途，少饭亦何嫌哉？","book":"《吴越春秋·王僚伎公子光传》"},"example":{"text":"至八十九年则一败涂地，而地拉涉氏竟至破产被刑，～，情殊可悯。","book":"孙中山《心理建设》第四章"},"similar":["穷途末路"],"opposite":["康庄大道"],"usage":"作宾语、定语；指陷入绝境"},{"id":25797,"word":"本乡本土","pinyin":"běn xiāng běn tǔ","abbr":"bxbt","explanation":"指本地，家乡。","source":{"text":"你老人家女儿多，不把来当事了。本乡本土少什么一夫一妇的，怎舍得与异乡人做小？","book":"明·冯梦龙《古今小说·蒋兴歌重会珍珠衫》"},"example":{"text":"就是～的人，除非不做官还使得，要是做官的，谁保的住总在一处。","book":"清·曹雪芹《红楼梦》第一百回"},"opposite":["异国他乡"],"usage":"作宾语、定语；指家乡"},{"id":25798,"word":"本位主义","pinyin":"běn wèi zhǔ yì","abbr":"bwzy","explanation":"为自己所在的小单位打算而不顾整体利益的思想作风。","source":{"text":"（六）本位主义，一切只知道为四军打算，不知道武装地方群众是红军的重要任务之一。","book":"毛泽东《关于纠正党内的错误思想》"},"example":{"text":"我们要放弃～，从全局看问题。"},"opposite":["大公无私"],"usage":"作主语、宾语、定语；指私心重"},{"id":25799,"word":"本同末异","pinyin":"běn tóng mò yì","abbr":"btmy","explanation":"本：本原。末：末流。比喻事物同一本原，而派生出来的末流则有所不同。","source":{"text":"夫文，本同而末异。","book":"三国·魏·曹丕《典论·论文》"},"example":{"text":"盖～，杨朱兴衰；始素终玄，墨翟垂涕。","book":"晋·卢谌《赠刘琨一首并书》"},"similar":["大同小异"],"opposite":["天壤之别"],"usage":"作宾语、定语；指大致相同"},{"id":25800,"word":"本同末离","pinyin":"běn tóng mò lí","abbr":"btml","explanation":"本旨相同而途径不同。","source":{"text":"……子谓余身死而名灭，仆亦笑子生死而无闻焉。本同末离，努力努力，夫复何言！","book":"《后汉书·臧洪传》"},"similar":["殊途同归"],"opposite":["本同末异"],"usage":"作宾语、定语；指大致相同"},{"id":25801,"word":"本固枝荣","pinyin":"běn gù zhī róng","abbr":"bgzr","explanation":"主干强固，枝叶才能茂盛。比喻事物的基础巩固了，其他部分才能发展。","source":{"text":"也有书写‘陶朱事业’及‘本固枝荣’等字，下款俱是士、农、工、商有名之人。","book":"清·姜振名《永庆升平前传》第一回"},"example":{"text":"要懂得～的道理。"},"usage":"作宾语、定语；用于劝诫人"},{"id":25802,"word":"本固邦宁","pinyin":"běn gù bāng níng","abbr":"bgbn","explanation":"指人民安居乐业则国家太平。","source":{"text":"言人君当固民以安国。","book":"《书·五子之歌》：“民惟邦本，本固邦宁。”孔传"},"example":{"text":"自古道，立国基，民为邦本；衣食足，知荣辱，～。","book":"京剧《串龙珠》"},"similar":["本固枝荣"],"usage":"作宾语、定语；用于劝谏","story":["夏朝时期，禹的孙子太康即位，他荒淫无度，百姓为之悲哀，他到洛水南面去打猎，穷国君主羿趁机篡夺了夏国的政权。太康的弟弟做《五子之歌》：“皇祖有训，民可近不可下。民惟邦本，本固邦宁。”","中康起兵恢复了夏国"]},{"id":25803,"word":"本地风光","pinyin":"běn dì fēng guāng","abbr":"bdfg","explanation":"形容眼前的景象或事物具有当地的特色。","source":{"text":"可知我井底之蛙，成日家只说现在的这几个人是有一无二的，谁知不必远寻，就是本地风光，一个赛似一个。","book":"清·曹雪芹《红楼梦》第四十九回"}},{"id":25804,"word":"本小利微","pinyin":"běn xiǎo lì wēi","abbr":"bxlw","explanation":"微：薄。本钱小，利润薄。指买卖很小，得利不多。","source":{"text":"小贩不论肩挑叫卖，或街畔摊售，总之本小利微，吃着不够。","book":"毛泽东《中国社会各阶级的分析》"},"example":{"text":"我们做的是～的买卖。"},"similar":["小本经营"],"usage":"作宾语、定语；指小本买卖"},{"id":25805,"word":"本性难移","pinyin":"běn xìng nán yí","abbr":"bxny","explanation":"移：改变。本质难于改变。","source":{"text":"想他每无恩义，本性难移，着我向野田衰草残红里。","book":"元·尚仲贤《柳毅传书》楔子"},"example":{"text":"你总是这样不爱收拾，屡次说你，你总不听。真是江山易改，～。","book":"巴金《家》二"},"similar":["积习难改","我行我素","依然故我"],"opposite":["染苍染黄","近朱者赤","近墨者黑"],"usage":"作谓语、分句；表示很难改变的坏习惯"},{"id":25806,"word":"本支百世","pinyin":"běn zhī bǒi shì","abbr":"bzbs","explanation":"指子孙昌盛，百代不衰。","source":{"text":"其子孙適为天子，庶为诸侯，皆百世。","book":"《诗·大雅·文王》：“文王孙子，本支百世。”毛传：“本，本宗也；支，支子也。”郑玄笺"},"example":{"text":"夫五代之臣，以道事君，泽及草木，仁被率土，是以福祚流行，～。","book":"《后汉书·五符传》"},"similar":["本枝百世"],"usage":"作谓语、宾语；指子孙很多"},{"id":25807,"word":"本末倒置","pinyin":"běn mò dào zhì","abbr":"bmdz","explanation":"本：树根；末：树梢；置：放。比喻把主次、轻重的位置弄颠倒了。","source":{"text":"然非知治之审，则未尝不本末倒置。","book":"金·无名氏《绥德州新学记》"},"example":{"text":"该简者你却详而不简，该详者你又简而不详。～，批评你还不愿意？乱弹琴！","book":"曲波《林海雪原》一二"},"similar":["轻重倒置","舍本求末"],"opposite":["以一持万","本末相顺"],"usage":"作谓语、宾语、定语；指弄错事物的轻重主次"},{"id":25808,"word":"本末源流","pinyin":"běn mò yuán liú","abbr":"bmyl","explanation":"源：水源。流：从水源向下游流去的水。比喻事物的主次、始末、先后。","source":{"text":"故禹十年水，汤七年旱，而天下无菜色者，十年之后，年谷复熟，而陈积有余。是无它故焉，知本末源流之谓也。","book":"《荀子·富国》"},"example":{"text":"本朝二百年之间，学问文章、政事术业，各有家法，其～，班班可考。","book":"宋·陈亮《与韩无咎尚书》"},"usage":"作主语、宾语；指事物的渊源和结局"},{"id":25809,"word":"本末相顺","pinyin":"běn mò xiāng shùn","abbr":"bmxs","explanation":"本：根本；末：梢；顺：指合于自然情势。由根到梢，次序不乱。比喻事物的发展合乎规律。","source":{"text":"本末相顺，终始相应。","book":"《史记·礼书》"}},{"id":25810,"word":"本末终终","pinyin":"běn mò zhōng shǐ","abbr":"bmzz","explanation":"本末：树根和树梢；终始：事情的结局和开头。指事物有本有末，有始有终的发展规律。","source":{"text":"物有本末，事有终始，知所先后，则近道矣。","book":"《礼记·大学》"}},{"id":25811,"word":"本本主义","pinyin":"běn běn zhǔ yì","abbr":"bbzy","explanation":"盲目地照搬书本或僵硬地凭上级指示办事，是一种脱离实际的教条主义作风。","source":{"text":"本本主义的社会科学研究法也同样是最危险的，甚至可能走上反革命的道路。","book":"毛泽东《反对本本主义》"},"example":{"text":"我们要坚决抛弃～的作风。"},"similar":["教条主义"],"usage":"作主语、宾语、定语；指死搬教条"},{"id":25812,"word":"本本分分","pinyin":"běn běn fèn fèn","abbr":"bbff","explanation":"非常本分诚实，说话做事不越轨。","source":{"text":"那亲家老爷倒也本本分分的说了几句谦虚话，又嘱咐了女儿一番。","book":"清·文康《儿女英雄传》"},"example":{"text":"她是一个～的人。"},"similar":["安安分分"],"opposite":["放浪形骸"],"usage":"作谓语、定语；指人守本分"},{"id":25813,"word":"本本源源","pinyin":"běn běn yuán yuán","abbr":"bbyy","explanation":"本本：根本；源源：源头。多用以指事情的始末。","source":{"text":"本本：根本；源源：源头。多用以指事情的始末。"},"similar":["源源本本"],"usage":"作宾语、定语；指事情的本源"},{"id":25814,"word":"本来面目","pinyin":"běn lái miàn mù","abbr":"blmm","explanation":"原为佛家语，指人的本性。后多比喻事物原来的模样。","source":{"text":"一任秋霜换鬓毛，本来面目长如故。","book":"唐·慧能《六祖坛经·行由品》：“不思善，不思恶，正与么时，那个是明上座本来面目。”宋·苏轼《老人行》诗"},"example":{"text":"这一润色，留传固然留传了，但可惜的是一定失去了许多～。","book":"鲁迅《且介亭杂文·门外文谈》"},"similar":["庐山真面目","真相大白"],"opposite":["涂脂抹粉","乔装打扮"],"usage":"作主语、宾语；用于人与事物","story":["佛教禅宗六代世祖慧能从小听人念诵佛经，心中有所觉悟，就到黄梅县东禅寺投奔禅宗五世弘忍大师学习佛法，被秘密授与祖师衣钵，连夜逃到南方，遇到僧人慧明，要求讲佛法。慧能说：“不思善，不思恶，这是一念不生的境界，就是你的本来面目。”"]},{"id":25815,"word":"本枝百世","pinyin":"běn zhī bǒi shì","abbr":"bzbs","explanation":"指子孙昌盛，百代不衰。","source":{"text":"见“本支百世”。"},"example":{"text":"据彼河洛，统四海焉，～，位天子焉。","book":"汉·张衡《南都赋》"},"similar":["本支百世"],"usage":"作谓语、宾语；指子孙很多"},{"id":25816,"word":"本深末茂","pinyin":"běn shēn mò mào","abbr":"bsmm","explanation":"本：树根；末：树梢。根深而枝叶茂盛。比喻事物根底深厚而富于生机，蓬勃茁壮。","source":{"text":"故君子慎其实，实之美恶，其发也不舍，本深而末茂。","book":"唐·韩愈《答尉迟生书》"}},{"id":25817,"word":"本盛末荣","pinyin":"běn shèng mò róng","abbr":"bsmr","explanation":"树根发达，枝叶才能繁盛。比喻对待事物要着重于根本。","source":{"text":"源清流洁，本盛末荣。","book":"汉·班固《泗水亭碑铭》"},"usage":"作宾语、定语；指要注重根本"},{"id":25818,"word":"本相毕露","pinyin":"běn xiàng bì lù","abbr":"bxbl","explanation":"原形完全显露了出来。","source":{"text":"‘第三种人’杜衡辈，标榜超然，实为群丑，不即本相毕露，知耻者皆羞称之，无待这里多说了；就令自觉不怀他意，屹然中立如张岱者，其实也还是偏倚的。","book":"鲁迅《且介亭杂文二集·“题未定”草》"},"example":{"text":"你终于～了。"},"similar":["原形毕露"],"opposite":["深藏不露"],"usage":"作谓语、定语、宾语；指本来面目"},{"id":25819,"word":"札手舞脚","pinyin":"zhá shǒu wǔ jiǎo","abbr":"zswj","explanation":"犹言动手动脚。形容不规矩、不稳重。","source":{"text":"好一个配猴儿日的，札手舞脚的，恰便似个活螃蟹。","book":"明·无名氏《双林坐化》第一折"},"similar":["扎手舞脚"],"usage":"作谓语、定语、状语；指动手动脚"},{"id":25820,"word":"朱丹其毂","pinyin":"zhū dān qí gǔ","abbr":"zdqg","explanation":"毂：车轮中心的圆木，代指车轮。红色车毂。形容古代高官所乘华丽的车","source":{"text":"吾闻上世之士，人纲人纪，不生则已，生必上尊人君，下荣父母。析人之珪，儋人之爵，怀人之符，分人之禄；纡青拖紫，朱丹其毂。","book":"汉·扬雄《解嘲》"},"usage":"作宾语、定语；用于书面语"},{"id":25821,"word":"朱云折槛","pinyin":"zhū yún shé jiàn","abbr":"zyzk","explanation":"朱云：汉代人名。折槛：折断栏杆。朱云折断了栏杆。形容敢于直言进谏。"},{"id":25822,"word":"朱口皓齿","pinyin":"zhū kǒu hào chǐ","abbr":"zkhc","explanation":"嘴唇红润，牙齿洁白。形容容貌美丽。","source":{"text":"魂乎归徕，听歌譔之。朱唇皓齿，嫭以姱只。","book":"战国·楚·屈原《大招》"},"example":{"text":"目波澄鲜，眉妩连娟，～，修耳悬鼻，辅靥颐颔，位置均适。（清·陈森《品花宝鉴》第三十八回）"},"similar":["朱唇皓齿"],"usage":"作主语、宾语、定语；指美女"},{"id":25823,"word":"朱唇榴齿","pinyin":"zhū chún liú chǐ","abbr":"zclc","explanation":"嘴唇红润，牙齿象石榴果实那样整齐。","source":{"text":"魂乎归徕，听歌譔之。朱唇皓齿，嫭以姱只。","book":"战国·楚·屈原《大招》"},"example":{"text":"两行尽是女人，年方二八，美貌轻盈，星眼柳眉，～，桃脸蝉发。","book":"《大唐三藏取经诗话》卷十"},"usage":"作宾语、定语；多用于女性"},{"id":25824,"word":"朱唇玉面","pinyin":"zhū chún yù miàn","abbr":"zcym","explanation":"指美女。","source":{"text":"宝钗翠鬓还相似，朱唇玉面非一行。","book":"隋·江总《杂曲》之三"},"similar":["朱唇粉面"],"usage":"作宾语、定语；多用于女性"},{"id":25825,"word":"朱唇皓齿","pinyin":"zhū chún hào chǐ","abbr":"zchc","explanation":"鲜红的双唇，雪白的牙齿。形容容貌美丽。","source":{"text":"朱唇皓齿，嫭以姱只。","book":"战国楚·屈原《大招》"},"example":{"text":"拜辞了翠裙红袖簇，～扶。","book":"元·张寿卿《金安寿》第三折"},"similar":["红唇皓齿","朱口皓齿"],"usage":"作主语、宾语、定语；指美女"},{"id":25826,"word":"朱唇粉面","pinyin":"zhū chún fěn miàn","abbr":"zcfm","explanation":"形容女子貌美。亦指美女。","source":{"text":"绣屏前品竹弹丝，摆列的是朱唇粉面。","book":"元·高明《琵琶记·牛氏归奴》"},"example":{"text":"看了春树，～，那相貌竟同大家闺秀一般，也觉脉脉无言，芳心自动。","book":"清·张春帆《九尾龟》第十五回"},"similar":["朱唇玉面"],"usage":"作宾语、定语；多用于女性"},{"id":25827,"word":"朱墨烂然","pinyin":"zhū mò làn rán","abbr":"zmlr","explanation":"朱墨：朱笔和墨笔；烂然：光明的样子。形容读书勒奋","source":{"text":"田祖好学，多所瞻涉，喜《左氏春秋》未尝去手，旁行斜上，朱墨烂然。","book":"清·江藩《国朝汉学师承记·贾田祖》"},"usage":"作谓语、定语；用于书面语"},{"id":25828,"word":"朱干玉戚","pinyin":"zhū gān yù qī","abbr":"zgyq","explanation":"干：盾；戚：斧。朱红的盾牌、玉饰的斧头。原为古时礼器。后也作为仪仗之用。","source":{"text":"朱干玉戚，冕而舞《大武》。","book":"《礼记·明堂位》"},"example":{"text":"～，森耸以相参；龙旗豹韬，抑扬而相错。","book":"明·冯梦龙《东周列国志》第四十一回"},"usage":"作主语、宾语、定语；指仪仗"},{"id":25829,"word":"朱弦三叹","pinyin":"zhū xián sān tàn","abbr":"zxst","explanation":"指称音乐的美妙。","source":{"text":"《清庙》之瑟，朱弦而疏越，壹倡而三叹，有遗音者矣。","book":"《礼记·乐记》"},"example":{"text":"清·查慎行《送陈泽州相国予告归》诗：“《流水》一弹真绝调，～有余音。”"},"usage":"作宾语；用于书面语"},{"id":25830,"word":"朱弦玉磬","pinyin":"zhū xián yù qìng","abbr":"zxyq","explanation":"弦：乐器上的丝弦；磬：一种打击乐器。借指用乐器演奏的优美音乐。","source":{"text":"两首新诗百字余，朱弦玉磬韵难知。","book":"唐·刘禹锡《令狐相公见示杨少尹赠答兼命继声》诗"},"usage":"作宾语、定语；用于书面语"},{"id":25831,"word":"朱弦疏越","pinyin":"zhū xián shū yuè","abbr":"zxsy","explanation":"形容诗文质朴而有余意。","source":{"text":"清庙之瑟，朱弦而疏越，壹倡而三叹，有遗音者也。","book":"《礼记·乐记》"},"example":{"text":"其他古体，若～，一倡三叹，读者当以意求之。","book":"宋·许顗《彦周诗话》"},"similar":["朱文之轸"],"usage":"作谓语、定语；用于书面语"},{"id":25832,"word":"朱文之轸","pinyin":"zhū wén zhī zhěn","abbr":"zwzz","explanation":"轸：古代车后的横木，代指车。绘有朱红色文饰的车子。形容高官所乘车的精美华贵","source":{"text":"晨门有抱关之夫，柱下无朱文之轸也。","book":"南朝·宋·范晔《后汉书·张皓王龚传论》"},"usage":"作宾语；用于书面语"},{"id":25833,"word":"朱朱白白","pinyin":"zhū zhū bái bái","abbr":"zzbb","explanation":"朱朱：花红的样子。红的红，白的白。指各色花木。","source":{"text":"晨游百花林，朱朱兼白白。","book":"唐·韩愈《感春三首》"},"example":{"text":"湖上花光何处寻？～自成林。","book":"宋·陆游《赏花》"},"similar":["白白朱朱"],"usage":"作谓语、定语；指花木"},{"id":25834,"word":"朱楼碧瓦","pinyin":"zhū lóu bì wǎ","abbr":"zlbw","explanation":"指华丽的楼房。","source":{"text":"朱楼碧瓦何年有，榱桷连空欲惊矫。","book":"宋·王安石《寄题郢州白雪楼》诗"},"usage":"作宾语、定语；用于书面语"},{"id":25835,"word":"朱楼绮户","pinyin":"zhū lóu qǐ hù","abbr":"zlqh","explanation":"富丽华美的楼阁。","source":{"text":"不见当年许史家，朱楼绮户青云逼。一朝宠失门祚衰，堂前一一生荆棘。","book":"明·张居正《赠国子马生行》"},"usage":"作宾语、定语；用于建筑等"},{"id":25836,"word":"朱楼翠阁","pinyin":"zhū lóu cuì gé","abbr":"zlcg","explanation":"红色和青色的楼阁。指华美精致的建筑。","source":{"text":"战马成群，猛士成林，振臂长啸，风动云兴；朱阁青楼，舞女歌童，势穷力竭，化为虚空。","book":"宋·苏辙《黄楼赋》"},"similar":["朱榭雕阑"],"usage":"作宾语、定语；用于书面语"},{"id":25837,"word":"朱榭雕阑","pinyin":"zhū xiè diāo lán","abbr":"zxdl","explanation":"朱：红色。形容楼阁漆红饰绿，建筑豪华富丽","source":{"text":"埋香瘗玉，残妆卸而翻飞；朱榭雕阑，杂佩纷其零落。","book":"清·蒲松龄《聊裔志异·绛妃》"},"similar":["朱楼翠阁"],"usage":"作宾语、定语；用于书面语"},{"id":25838,"word":"朱槃玉敦","pinyin":"zhū pán yù duì","abbr":"zpyd","explanation":"珠槃：用珍珠装饰的盘子；玉敦：玉制的盛器。特指古代天子、诸侯歃血为盟时所用的礼器。","source":{"text":"若合诸侯，则共珠槃玉敦。","book":"《周礼·天官·玉府》"},"example":{"text":"说不定国王还要歃血为盟呢，～的准备也是不可少的。","book":"郭沫若《屈原》第二幕"}},{"id":25839,"word":"朱甍碧瓦","pinyin":"zhū méng bì wǎ","abbr":"zmbw","explanation":"红色屋脊，青绿色的琉璃瓦。借指华丽的建筑。","source":{"text":"朱甍碧瓦，掩映着九级高堂；画栋雕梁，真乃是三微精舍。”明·冯梦龙《醒世恒言》第二十九卷“中间显出一座八角亭子，朱甍碧瓦，画栋雕梁。","book":"明·施耐庵《水浒传》第九回"},"example":{"text":"可知他～，总是血膏涂！","book":"清·洪昇《长生殿·疑谶》"},"usage":"作宾语、定语；用于建筑等"},{"id":25840,"word":"朱盘玉敦","pinyin":"zhū pán yù duì","abbr":"zpyd","explanation":"珠盘：用珍珠装饰的盘子；玉敦：玉制的盛器。特指古代天子、诸侯歃血为盟时所用的礼器。","source":{"text":"若合诸侯，则共珠盘玉敦。","book":"《周礼·天官·玉府》"},"example":{"text":"说不定国王还要歃血为盟呢，～的准备也是不可少的。","book":"郭沫若《屈原》第二幕"}},{"id":25841,"word":"朱紫难别","pinyin":"zhū zǐ nán biě","abbr":"zznb","explanation":"古人以朱色为正色，紫色为间色，因以朱紫比喻正邪、好坏。形容善恶不辨。","source":{"text":"丞相亮将北伐，住汉中，虑后主富于春秋，朱紫难别，以允秉心公亮，欲任以宫省之事。","book":"《三国志·蜀志·董允传》"},"usage":"作宾语、定语；用于书面语"},{"id":25842,"word":"朱衣使者","pinyin":"zhū yī shǐ zhě","abbr":"zysz","explanation":"指科举考试官。","source":{"text":"欧阳修知贡举日，每遇考试卷，坐后常觉一朱衣人时复点头，然后其文入格。……因语其事于同列，为之三叹。尝有句云：‘唯愿朱衣一点头。’","book":"明·陈耀文《天中记》卷三十八引《侯鲭录》"},"example":{"text":"～，宋人诗中屡见，亦言试官也。","book":"清·梁章钜《称谓录》"},"usage":"作宾语、定语；指考试官"},{"id":25843,"word":"朱衣点头","pinyin":"zhū yī diǎn tóu","abbr":"zydt","explanation":"旧称被考试官看中。","source":{"text":"欧阳修知贡举日，每遇考试卷，坐后常觉一朱衣人时复点头，然后其文入格。……因语其事于同列，为之三叹。尝有句云：‘唯愿朱衣一点头。’","book":"明·陈耀文《天中记》卷三十八引《侯鲭录》"},"similar":["朱衣点额"],"usage":"作宾语、定语；指考试高中"},{"id":25844,"word":"朱衣点额","pinyin":"zhū yī diǎn é","abbr":"zyde","explanation":"穿朱衣的人点头。旧称被考试官看中。","source":{"text":"须信赤绳系足，朱衣点额终在，休叹淹徊。","book":"宋·王之道《声声慢》词"},"example":{"text":"年年科学，岁岁观场，不能得～，黄榜标名。（明·冯梦龙《警世通言》卷十八）"},"similar":["朱衣点头"],"usage":"作宾语、定语；指考试高中"},{"id":25845,"word":"朱衣象笏","pinyin":"zhū yī xiàng hù","abbr":"zyxh","explanation":"朱衣：指主考官；笏：古代大臣朝见皇帝时拿的手板，用作记事。身着红袍，手执牙笏。形容仪态端庄肃敬","source":{"text":"殷侯侑，自太常博士迁尚书虞部员外郎兼侍御史，朱衣象笏，承命以行。","book":"唐·韩愈《送殷员外便回鹘序》"},"usage":"作宾语、定语；用于书面语"},{"id":25846,"word":"朱轓皁盖","pinyin":"zhū fān hǎi gài","abbr":"zfzg","explanation":"红色的车障，黑色的车盖。古代高官所乘的车子。亦借指高官。"},{"id":25847,"word":"朱轓皂盖","pinyin":"zhū fān zào gài","abbr":"zfzg","explanation":"红色的车障，黑色的车盖。古代高官所乘的车子。亦借指高官。","source":{"text":"朱轓皂盖，古无滥秩。","book":"南朝·梁·江淹《萧太尉上便宜表》"},"example":{"text":"～来托宿，不听灵君专此屋。","book":"宋·黄庭坚《宫亭湖》诗"},"usage":"作宾语、定语；用于书面语"},{"id":25848,"word":"朱轮华毂","pinyin":"zhū lún huá gǔ","abbr":"zlhg","explanation":"朱、华：形容装饰华丽；毂：车轮中心的圆木。指古代王侯贵族乘坐的装饰华丽的车子。比喻显贵。","source":{"text":"令范阳令乘朱轮华毂，使驱驰燕、赵郊。","book":"《史记·张耳陈余列传》"},"example":{"text":"～，拥旄万里。","book":"南朝梁·丘迟《与陈伯之书》"},"usage":"作主语、宾语、定语；比喻显贵"},{"id":25849,"word":"朱辬皁盖","pinyin":"zhū fān hǎi gài","abbr":"zfhg","explanation":"红色的车障，黑色的车盖。古代高官所乘的车子。亦借指高官。"},{"id":25850,"word":"朱辬皂盖","pinyin":"zhū fān zào gài","abbr":"zfzg","explanation":"红色的车障，黑色的车盖。古代高官所乘的车子。亦借指高官。","source":{"text":"朱辬皂盖，古无滥秩。","book":"南朝·梁·江淹《萧太尉上便宜表》"},"quote":{"text":"～来托宿，不听灵君专此屋。","book":"宋·黄庭坚《宫亭湖》诗"}},{"id":25851,"word":"朱门绣户","pinyin":"zhū mén xiù hù","abbr":"zmxh","explanation":"朱门：红漆大门；绣户：雕绘华美的门户。比喻富贵人家妇女的住处。也借指富贵人家。","source":{"text":"娘子朱门绣刻户，妾素无葭莩亲，虑致讥嫌。","book":"清·蒲松龄《聊斋志异·封三娘》"},"example":{"text":"清·贪梦道人《彭公案》第94回：“他下了边墙，见西边一带白墙，～。”"},"similar":["金门绣户"],"usage":"作主语、宾语、定语；指富贵人家"},{"id":25852,"word":"朱门酒肉臭，路有冻死骨","pinyin":"zhū mén jiǔ ròu chòu，lù yǒu dòng sǐ gǔ","abbr":"zmjrclydsg","explanation":"富贵人家酒肉多得吃不完而腐臭，穷人门却在街头因冻饿而死。形容贫富悬殊的社会现象。","source":{"text":"朱门酒肉臭，路有冻死骨。","book":"唐·杜甫《自京赴奉先咏怀五百字》诗"},"example":{"text":"希望不要出现～的局面。"},"usage":"作宾语、定语、分句；指社会贫富悬殊"},{"id":25853,"word":"朱阁青楼","pinyin":"zhū gé qīng lóu","abbr":"zgql","explanation":"指华美精致的建筑。","source":{"text":"掁臂长啸，风动云兴；朱阁青楼，舞女歌童。","book":"宋·苏辙《黄楼赋》"},"usage":"作宾语、定语；用于建筑等"},{"id":25854,"word":"朱陈之好","pinyin":"zhū chén zhī hǎo","abbr":"zczh","explanation":"表示两家结成姻亲。","source":{"text":"徐州古丰县，有村曰朱陈。……一村唯两姓，世世为婚姻。","book":"唐·白居易《朱陈村》诗"},"example":{"text":"两家爰亲作亲，男家是衣冠望族，女家是列宿名卿，既无齐郑之嫌，必契～。","book":"清·随缘下士《林兰香》"},"usage":"作宾语；指结亲"},{"id":25855,"word":"朱雀玄武","pinyin":"zhū què xuán wǔ","abbr":"zqxw","explanation":"朱雀：南方七星宿的总称。玄武：北方七星宿的总称。形容阵容整齐。","source":{"text":"苍龙，白虎，朱雀，玄武，天之四灵，以正四方，王者制宫阙殿阁取法焉。","book":"《三辅黄图·未央宫》"},"example":{"text":"元·无名氏《锁魔镜》第一折：“前后列～，左右列白虎青龙。”"},"usage":"作宾语、定语；用于书面语"},{"id":25856,"word":"朱颜粉面","pinyin":"zhū yán fěn miàn","abbr":"zyfm","explanation":"粉：白色。红颜白面。指涂脂傅粉的女子。","source":{"text":"金鼎爇凤脑龙肝，花烛映朱颜粉面。","book":"明·胡文焕《群音类选·八义记·驸马赏灯》"},"usage":"作宾语、定语；用于女性"},{"id":25857,"word":"朱颜绿发","pinyin":"zhū yán lǜ fā","abbr":"zylf","explanation":"指青春年少。","source":{"text":"宋江看那女童时，但见：朱颜绿发，皓齿明眸。","book":"宋·沈遘《送句谌通判颖川》诗：“朱颜绿发出尘土，长缨高盖生清风。”明·施耐庵《水浒传》第四十二回"},"example":{"text":"～况未老，才地何啻十倍予。","book":"清·唐孙华《送王诵侯之官成都》诗"},"similar":["朱颜绿鬓","朱颜翠发"],"usage":"作宾语、定语；用于书面语"},{"id":25858,"word":"朱颜绿鬓","pinyin":"zhū yán lǜ bìn","abbr":"zylb","explanation":"朱颜：红润的面容；绿鬓：黑鬓发。形容年轻时的容貌。","source":{"text":"见朱颜绿鬓，玉带金鱼。","book":"宋·辛弃疾《洞仙歌·寿叶丞相》"},"similar":["朱颜绿发","朱颜翠发"],"usage":"作宾语、定语；用于书面语"},{"id":25859,"word":"朱颜翠发","pinyin":"zhū yán cuì fā","abbr":"zycf","explanation":"指青春年少。同“朱颜绿发”。","source":{"text":"追念朱颜翠发，曾到处，故地使人嗟。","book":"宋·周邦彦《西平乐》词"},"similar":["朱颜绿发","朱颜绿鬓"],"usage":"作宾语、定语；用于书面语"},{"id":25860,"word":"朱颜鹤发","pinyin":"zhū yán hè fā","abbr":"zyhf","explanation":"朱颜：红润的脸。红润的脸和像鹤羽毛一样白的头发。形容老年人精神焕发的样子。","source":{"text":"天上姮娥元不老，人间紫府长春。朱颜鹤发更清新。","book":"宋·张伯寿《临江仙》词"},"similar":["童颜鹤发"],"usage":"作宾语、定语；用于书面语"},{"id":25861,"word":"朴实无华","pinyin":"pǔ shí wú huá","abbr":"pswh","explanation":"质朴实在而不浮华。","source":{"text":"它只是平铺直叙，朴实无华地讲会见的事情。","book":"巴金《后记》"},"example":{"text":"我很欣赏他那～的性格。"},"similar":["朴素无华"],"usage":"作谓语、定语、状语；指人的人品"},{"id":25862,"word":"朴斫之材","pinyin":"pǔ zhuó zhī cái","abbr":"pzzc","explanation":"加工治理而尚未成器之材。","source":{"text":"肤表或不可以论中，望貌或不可以核能，仲尼似丧家之狗，公旦类朴斫之材。","book":"晋·葛洪《抱朴子·博喻》"},"usage":"作宾语；用于书面语"},{"id":25863,"word":"朴素无华","pinyin":"pǔ sù wú huá","abbr":"pswh","explanation":"俭朴、不浮华。","source":{"text":"身一布袍数年，妻子朴素无华，人皆言之，泽不以为意也。","book":"《元史·乌古孙泽传》"},"example":{"text":"又得译者将丰神传达，而且～。","book":"鲁迅《二心集·夏娃日记》"},"similar":["朴实无华"],"usage":"作谓语、定语、状语；指人的人品"},{"id":25864,"word":"朴讷诚笃","pinyin":"pǔ nè chéng dǔ","abbr":"pncd","explanation":"为人朴实敦厚，不善言词。","source":{"text":"马生其名混，其业亵，蕙芳奚取哉？于此见仙人之贵朴讷诚笃也。","book":"《聊斋志异·蕙芳》"},"usage":"作谓语、定语；指为人"},{"id":25865,"word":"朵颐大嚼","pinyin":"duǒ yī dà jiáo","abbr":"dydj","explanation":"朵：动；颐：下巴。动嘴大吃。","source":{"text":"盖如久处灾区之民，草根木皮，冻雀腐鼠，罔不甘之，朵颐大嚼。","book":"梁启超《清代学术概论》第二十九章"},"similar":["大块朵颐"],"usage":"作谓语；指大口吃"},{"id":25866,"word":"机不可失","pinyin":"jī bù kě shī","abbr":"jbks","explanation":"机：机会；时：时机。好的时机不可放过，失掉了不会再来。","source":{"text":"须知机不可失，时不再来。","book":"五代·安重荣《上石敬瑭表》"},"example":{"text":"～，这正是革命力量重新振兴之时。","book":"耿可员《孙中山与宋庆龄》第五场"},"similar":["时不可失","时不我待"],"opposite":["丧失良机","错过良机"],"usage":"作宾语、分句；常与“时不再来”连用","story":["唐朝初年，东突厥人侵忧大唐北部边境，唐太宗命李靖前去征讨，李靖大胜，东突厥的首领不得不向唐求和。唐太宗表面答应他求和，李靖也认为要“兵贵神速，机不可失”，于是发起进攻，全歼东突厥的军队"]},{"id":25867,"word":"机不可失，失不再来","pinyin":"jī bù kě shī，shī bù zài lái","abbr":"jbkssbzl","explanation":"失：错过。指时机难得，必需抓紧。","source":{"text":"夫功者难成而易败，时者难得而易失也。时乎时，不再来。","book":"《史记·淮阴侯列传》"},"similar":["机不可失，时不再来"],"usage":"作宾语、定语、分句；用于处事"},{"id":25868,"word":"机不可失，时不再来","pinyin":"jī bù kě shī，shí bù zài lái","abbr":"jbkssbzl","explanation":"指时机难得，必需抓紧，不可错过。","source":{"text":"仰认睿智，深惟匿瑕，其如天道人心，难以违拒，须知机不可失，时不再来。","book":"《旧五代史·晋书·安重荣传》"},"example":{"text":"你们应该去，应该马上去，～啊！","book":"杨宗镜《话剧演员的怀念》"},"similar":["时不可失","时不我待"],"usage":"作宾语、分句；指时机难得，必需抓紧","story":["公元前203年，汉将韩信灭了齐国，被刘邦封为齐王，韩信的谋士蒯通分析天下形势后认为韩信是一个举足轻重的人物，劝他不要跟随刘邦而自立为王，可以与楚汉三分天下，认为是机不可失，时不再来。韩信没有采纳蒯通的意见"]},{"id":25869,"word":"机不容发","pinyin":"jī bù róng fā","abbr":"jbrf","explanation":"比喻时机紧迫。","source":{"text":"事变之来，机不容发，事后追悟，与不悟同。","book":"清·魏源《圣武记》卷八：“追数千出柙走险之兕虎，殴使归闲就勒，机不容发，计不反顾，，天也，非人也。”又《默觚下·治篇七》"},"usage":"作宾语、定语；用于处事"},{"id":25870,"word":"机不旋踵","pinyin":"jī bù xuán zhǒng","abbr":"jbxz","explanation":"形容时机短暂。旋踵，转过脚后跟。","source":{"text":"机不旋踵，时不再来，必发今宵，无贻后悔。","book":"唐·皇甫枚《三水小牍·宋柔》"},"usage":"作宾语、定语；用于处事等"},{"id":25871,"word":"机事不密","pinyin":"jī shì bù mì","abbr":"jsbm","explanation":"指泄漏机密。","source":{"text":"机事不密则害成。”按，今本《易·系辞上》作“几事","book":"《汉书·王莽传中》：“泄露省中及尚书事者，‘机事不密则害成’也。”颜师古注引《易·系辞上》"},"example":{"text":"时有宦官曹节等弄权，窦武、陈蕃谋诛之，～，反为所害。","book":"明·罗贯中《三国演义》第一回"},"opposite":["缄口不言"],"usage":"作谓语、宾语；指泄漏机密"},{"id":25872,"word":"机会主义","pinyin":"jī huì zhǔ yì","abbr":"jhzy","explanation":"利用机会或情况的技巧、策略或实践，特别是很少顾及原则或最后结果。","source":{"text":"这种空洞的唯心的政治估量和工作指导，是不是要产生机会主义错误，或者盲动主义错误呢？","book":"毛泽东《反对本本主义》"},"example":{"text":"你不要有～的侥幸。"},"similar":["投机取巧"],"usage":"作主语、宾语、定语；指利用机会"},{"id":25873,"word":"机关用尽","pinyin":"jī guān yòng jìn","abbr":"jgyj","explanation":"机关：周密、巧妙的计谋。比喻用尽心思。","source":{"text":"多少长安名利客，机关用尽不如君。","book":"宋·黄庭坚《牧童歌》诗"},"example":{"text":"得失枯荣总在天，～也徒然。","book":"明·凌濛初《初刻拍案惊奇》第33卷"},"similar":["机关算尽"],"opposite":["无计可施","束手无策"],"usage":"作主语、谓语；指费尽心机"},{"id":25874,"word":"机关算尽","pinyin":"jī guān suàn jìn","abbr":"jgsj","explanation":"机关：周密、巧妙的计谋。比喻用尽心思。","source":{"text":"多少长安名利客，机关用尽不如君。","book":"宋·黄庭坚《牧童歌》诗"},"example":{"text":"～太聪明，反算了卿卿性命。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["机关用尽","费尽心机"],"opposite":["无计可施","束手无策"],"usage":"作谓语、宾语；指费尽心机"},{"id":25875,"word":"机变如神","pinyin":"jī biàn rú shén","abbr":"jbrs","explanation":"机变：机智、权变。机智权变，神奇莫测。","source":{"text":"世言江南精兵十万，而长江天堑，可当十万；国老宋齐丘，机变如神，可当十万。","book":"宋·陆游《南唐书·宋齐丘传论》"},"example":{"text":"诸葛亮用兵～。"},"similar":["机智善变"],"opposite":["迟头顿脑"],"usage":"作谓语、定语；指机智权变，神妙莫测"},{"id":25876,"word":"机巧贵速","pinyin":"jī qiǎo guì sù","abbr":"jqgs","explanation":"机巧：机灵、巧妙。巧施心机，贵在迅速及时。","source":{"text":"定谋贵决，机巧贵速，机事贵密。","book":"明·吴惟顺《兵镜吴子十三篇》"}},{"id":25877,"word":"机心械肠","pinyin":"jī xīn xiè cháng","abbr":"jxxc","explanation":"机巧诈变的心计。","source":{"text":"非吾辈，真鄙儒，机心械肠全未除。","book":"清·李渔《意中缘·错怪》"},"usage":"作宾语、定语；用于书面语"},{"id":25878,"word":"机杼一家","pinyin":"jī zhù yī jiā","abbr":"jzyj","explanation":"指文章能独立经营，自成一家。","source":{"text":"文章须自出机杼，成一家风骨，何能共人生活焉？","book":"《魏书·祖莹传》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“文章全美，谓之文不加点；文章奇异，曰～。”"},"usage":"作谓语、定语；指文章自成一家"},{"id":25879,"word":"机深智远","pinyin":"jī shēn zhì yuǎn","abbr":"jszy","explanation":"机深：考虑周密；智远：见识深远。形容考虑问题深远，从长计议。","source":{"text":"荀彧、荀攸、郭嘉、程昱、机深智远，虽萧何、陈平不及也。","book":"明·罗贯中《三国演义》第二十三回"}},{"id":25880,"word":"机难轻失","pinyin":"jī nán qīng shī","abbr":"jnqs","explanation":"指机会难得，稍纵即失。","source":{"text":"况今豪杰向风，士卒用命，天时人事，强弱已见，功及垂成，时不再来，机难轻失，臣日夜料之熟矣。","book":"宋·岳飞《乞止班师诏奏略》"},"usage":"作宾语、定语；用于处事"},{"id":25881,"word":"朽戈钝甲","pinyin":"xiǔ gē dùn jiǎ","abbr":"xgdj","explanation":"比喻装备极劣的军队。","source":{"text":"朽戈钝甲，与胡人相持者十有七年。","book":"明·张煌言《答唐枚臣书》"},"usage":"作主语、宾语；指装备落后"},{"id":25882,"word":"朽木不可雕","pinyin":"xiǔ mù bù kě diāo","abbr":"xmbkd","explanation":"腐烂的木头无法雕刻。比喻人不可造就或事物和局势败坏而不可救药。亦作“朽木难彫”。亦作“朽木不雕”。","source":{"text":"朽木不可雕也，粪土之墙，不可圬也。","book":"春秋·鲁·孔丘《论语·公冶长》"},"example":{"text":"他便感到宋宝琦也并非～的烂树。","book":"刘心武《班主任》"},"similar":["朽木不雕"],"usage":"作定语、宾语；指人不可造就","story":["春秋时期，弟子宰予很会说漂亮话，孔子很喜欢他，以为他一定会有出息。不久孔子发现他经常不来上课，派人去找，发现他躲在房间睡大觉，孔子知道后很伤感地说：“腐烂的木头不能雕刻，粪土一样的墙壁不能粉刷。”"]},{"id":25883,"word":"朽木不雕","pinyin":"xiǔ mù bù diāo","abbr":"xmbd","explanation":"朽坏的木头无法雕刻。比喻人不上进，无法成材。","source":{"text":"朽木不可雕也，粪土之墙，不可圬也。","book":"春秋·鲁·孔丘《论语·公冶长》"},"example":{"text":"你这个人真是～。"},"similar":["朽木不可雕","朽木难雕","木朽不雕"],"usage":"作定语、宾语；指人不可造就","story":["春秋时期，孔子的弟子宰予很会说漂亮话，起初孔子很喜欢他，以为他一定会有出息。可是不久孔子就发现他经常不来上课，派人去找，发现他躲在房间睡大觉，孔子知道后很伤感地说：“腐烂的木头不能雕刻，粪土一样的墙壁不能粉刷。”"]},{"id":25884,"word":"朽木不雕，粪墙不圬","pinyin":"xiǔ mù bù diāo，fèn qiáng bū wū","abbr":"xmbdfqbw","explanation":"圬：抹灰等瓦工作。朽坏的木头无法雕刻，污秽的土墙无法粉刷。比喻没有培养前途的人。","source":{"text":"朽木不可雕也，粪土之墙不可圬也。","book":"《论语·公冶长》"}},{"id":25885,"word":"朽木之才","pinyin":"xiǔ mù zhī cái","abbr":"xmzc","explanation":"像烂木头的才能。比喻不堪造就或无用之人。","source":{"text":"量你何足道哉，斗筲之器，粪土之墙，精狗儿之人。","book":"元·无名氏《认金梳》第三折"},"usage":"作宾语；用于比喻句"},{"id":25886,"word":"朽木枯株","pinyin":"xiǔ mù kū zhū","abbr":"xmkz","explanation":"朽：腐烂；株：露出地面的树桩。枯木头，烂树根。比喻老弱无用的人或衰微的力量。","source":{"text":"故有人先谈，则枯木朽树功而不忘。","book":"汉·邹阳《狱中上梁王书》"},"similar":["朽株枯木"],"usage":"作宾语、定语；用于比喻句"},{"id":25887,"word":"朽木死灰","pinyin":"xiǔ mù sǐ huī","abbr":"xmsh","explanation":"腐朽的树木和火灭后的冷灰。比喻心情极端消沉，对任何事情无动于衷。","source":{"text":"形容固可使如槁木，而心固可使如死灰乎？","book":"《庄子·齐物论》"},"example":{"text":"小官已为～，若非你拯救吹嘘，安能到此。","book":"元·石君宝《曲池柳》第四折"},"similar":["槁木死灰"],"usage":"作宾语、定语；指没有生机"},{"id":25888,"word":"朽木生花","pinyin":"xiǔ mù shēng huā","abbr":"xmsh","explanation":"指由枯转荣，比喻事物得以新生。","source":{"text":"朽木生花，白骨生肌，都亏你再把鸿钧铸。","book":"清·李渔《比目鱼·假神》"},"usage":"作宾语、定语；多用于比喻句"},{"id":25889,"word":"朽木粪土","pinyin":"xiǔ mù fèn tǔ","abbr":"xmft","explanation":"朽木：烂木头；粪土：脏土臭泥。比喻不堪造就、对社会没有用处的人。","source":{"text":"宰予昼寝，子曰：‘朽木不可雕也，粪土之墙不可杇也，于予与何诛。’","book":"春秋·鲁·孔丘《论语·公冶长》"},"example":{"text":"如～矣，虽欲善治之，亡可奈何。","book":"东汉·班固《汉书·董仲舒传》"},"similar":["朽木粪墙"],"usage":"作宾语、定语；指不可救治的人","story":["春秋时期，孔子的弟子宰予很会说漂亮话，起初孔子很喜欢他，以为他一定会有出息。可是不久孔子就发现他经常不来上课，派人去找，发现他躲在房间睡大觉，孔子知道后很伤感地说：“腐烂的木头不能雕刻，粪土一样的墙壁不能粉刷。”"]},{"id":25890,"word":"朽木粪墙","pinyin":"xiǔ mù fèn qiáng","abbr":"xmfq","explanation":"朽坏的木头，污秽的土墙。比喻没有培养前途的人。","source":{"text":"朽木不可雕也，粪土之墙，不可圬也。","book":"春秋·鲁·孔丘《论语·公冶长》"},"example":{"text":"宰予昼寝，夫子有～之喻。","book":"金·王若虚《辨惑》"},"similar":["朽木粪土"],"usage":"作宾语、定语；指不可救治的人或事","story":["春秋时期，孔子的弟子宰予很会说漂亮话，孔子很喜欢他，以为他一定会有出息。可是不久孔子就发现他经常不来上课，派人去找，发现他躲在房间睡大觉，孔子知道后很伤感地说：“腐烂的木头不能雕刻，粪土一样的墙壁不能粉刷。”"]},{"id":25891,"word":"朽木难彫","pinyin":"xiǔ mù nán diāo","abbr":"xmnd","explanation":"比喻人不可造就或事物和局势败坏而不可救药。同“朽木不可雕”。"},{"id":25892,"word":"朽木难雕","pinyin":"xiǔ mù nán diāo","abbr":"xmnd","explanation":"比喻人不可造就或事物和局势败坏而不可救药。同“朽木不可雕”。","source":{"text":"尚之望见便阳眠，延之发帘熟视曰：‘朽木难雕’。","book":"《南史·颜延之传》"},"example":{"text":"你这个人真是～。"},"similar":["朽木不雕"],"opposite":["大有作为"],"usage":"作谓语、宾语；用于教训人","story":["春秋时期，孔子的弟子宰予很会说漂亮话，起初孔子很喜欢他，以为他一定会有出息。可是不久孔子就发现他经常不来上课，派人去找，发现他躲在房间睡大觉，孔子知道后很伤感地说：“腐烂的木头不能雕刻，粪土一样的墙壁不能粉刷。”"]},{"id":25893,"word":"朽条腐索","pinyin":"xiǔ tiáo fǔ suǒ","abbr":"xtfs","explanation":"指朽腐的绳索。","source":{"text":"朽条腐索，不堪施用，安静候时，以待亲知。","book":"汉·焦赣《易林·节之豫》"},"usage":"作宾语、定语；用于书面语"},{"id":25894,"word":"朽株枯木","pinyin":"xiǔ zhū kū mù","abbr":"xzkm","explanation":"比喻衰朽的力量或衰老无用的人。同“枯木朽株”。","source":{"text":"白发苍颜七十翁，朽株枯木略相同。","book":"宋·陆游《忽得京书有感》"},"example":{"text":"清·冯桂芬《公启曾协揆》：“大军一至，则～亦助声威；大军不至，则铁郭金城将沦灰烬。”"},"similar":["朽木枯株"],"usage":"作宾语、定语；用于比喻句"},{"id":25895,"word":"朽棘不彫","pinyin":"xiǔ jí bù diāo","abbr":"xjbd","explanation":"比喻人不可造就或事物和局势败坏而不可救药。同“朽木不可雕”。"},{"id":25896,"word":"朽棘不雕","pinyin":"xiǔ jí bù diāo","abbr":"xjbd","explanation":"比喻人不可造就或事物和局势败坏而不可救药。同“朽木不可雕”。","source":{"text":"小人难育、朽棘不雕，长恶不悛，岂容抚养。","book":"《魏书·赵修传》"},"similar":["朽木不雕"],"usage":"作宾语、定语；用于书面语"},{"id":25897,"word":"朽竹篙舟","pinyin":"xiǔ zhú gāo zhōu","abbr":"xzgz","explanation":"烂竹竿作篙推舟。比喻做事的工具或条件不佳，难能成就。","source":{"text":"元晖谓笔不可意者如朽竹篙舟、曲箸哺物，此最善喻。","book":"宋·周密《癸辛杂识前集·笔墨》"},"usage":"作宾语、定语；用于比喻句"},{"id":25898,"word":"朽索驭马","pinyin":"xiǔ suǒ yù mǎ","abbr":"xsym","explanation":"用腐烂的绳索驾驭奔驰的马。形容倾覆的危险十分严重。多含戒惧之意。亦作“腐索御马。”","source":{"text":"予临兆民，懔乎若朽索之驭六马。","book":"《尚书·五子之歌》"},"usage":"作宾语、定语；用于比喻句"},{"id":25899,"word":"朽骨重肉","pinyin":"xiǔ gǔ zhòng ròu","abbr":"xgzr","explanation":"比喻已经腐朽的东西得到了新生。","source":{"text":"时雨既至，靡物不蒙，遂使死灰再然，朽骨重肉。","book":"宋·苏辙《谢复官表》"},"usage":"作宾语、定语；用于书面语"},{"id":25900,"word":"杀一儆百","pinyin":"shā yī jǐng bǎi","abbr":"syjb","explanation":"儆：警告。处死一个人，借以警戒许多人。","source":{"text":"其有所取也，以一警百，吏民皆服，恐惧改行自新。","book":"《汉书·尹翁归传》"},"example":{"text":"如果遇到抗拒，就～。","book":"姚雪垠《李自成》第一卷第十四章"},"similar":["杀鸡儆猴","惩前毖后"],"opposite":["既往不咎","宽大为怀"],"usage":"作谓语、宾语；指警戒别人","story":["西汉时期，河东太守田延年巡视霍光的家乡平阳发现市场吏尹翁归是个难得的人才，于是奏请皇上任命他为东海太守。东海是一个强盗横行的地方，尹翁归决定采取杀一儆百的办法，处决豪强许仲孙，于是东海变得安定起来"]},{"id":25901,"word":"杀一利百","pinyin":"shā yī lì bǎi","abbr":"sylb","explanation":"处死一个人，借以警戒许多人。同“杀一砺百”。","source":{"text":"若有深奸巨猾，伤化败俗，悖乱人伦，不忠不孝，故为背道者，杀一利百，以清王化，重刑可也。","book":"《周书·苏绰传》"},"similar":["杀一警百","杀一砺百"],"usage":"作宾语、定语；用于处事"},{"id":25902,"word":"杀一砺百","pinyin":"shā yī lì bǎi","abbr":"sylb","explanation":"犹言杀一儆百。处死一个人，借以警戒许多人。","source":{"text":"《周书·苏绰传》：“若有深奸世猾，伤化败俗，悖乱人伦，不忠不孝，故为背道者，，以清王化。”一本作“杀一利百”。"},"similar":["杀一利百","杀一警百"],"usage":"作宾语、定语；用于处事"},{"id":25903,"word":"杀一警百","pinyin":"shā yī jǐng bǎi","abbr":"syjb","explanation":"处死一个人，借以警戒许多人。同“杀一儆百”。","source":{"text":"斩草除根，杀一警百，这正是根本的办法。","book":"郭沫若《孔雀胆》第三幕"},"example":{"text":"我们得想出一个～的办法。"},"similar":["杀一儆百","绳一戒百"],"usage":"作谓语、宾语、定语；指警戒别人","story":["西汉时期，河东太守田延年巡视霍光的家乡平阳发现市场吏尹翁归是个难得的人才，于是奏请皇上任命他为东海太守。东海郡是一个土豪称霸、强盗横行的地方，尹翁归决定采取杀一警百，处决豪强许仲孙，于是没人敢犯法了，东海变得安定起来"]},{"id":25904,"word":"杀人不用刀","pinyin":"shā rén bù yòng dāo","abbr":"srbyd","explanation":"比喻用嘴或笔陷害人于死地。","source":{"text":"问：‘如何是衲僧口？’师曰：‘杀人不用刀。’","book":"宋·释普济《五灯会元》卷十七"},"example":{"text":"手腕真高明，简直～。","book":"冯志《敌后武工队》第十八章"},"similar":["杀人不见血"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":25905,"word":"杀人不眨眼","pinyin":"shā rén bù zhǎ yǎn","abbr":"srbzy","explanation":"杀人时眼睛都不眨一下。形容极其凶狠残暴。","source":{"text":"问：‘如何是大善知识？’师曰：‘杀人不眨眼。’","book":"宋·释普济《五灯会元》卷十一"},"example":{"text":"杨林是个～的魔头，见了不觉毛发直竖，身子寒抖不定。","book":"清·陈忱《水浒后传》第二十四回"},"similar":["杀人不见血"],"opposite":["救死扶伤"],"usage":"作定语、分句；指十分凶残","story":["北宋初年，宋太祖派大将军曹翰率军进攻胡则，到九江庐山寺，寺里的和尚都躲了起来，只有缘德和尚坚守不出，曹翰问缘德听说“杀人不眨眼”的将军没有。缘德说他是不怕死的和尚，曹翰只好用缓和的语气请教，缘德这才召回所有的和尚"]},{"id":25906,"word":"杀人不见血","pinyin":"shā rén bù jiàn xuè","abbr":"srbjx","explanation":"杀人不露一点血迹。形容害人的手段非常阴险毒辣。","source":{"text":"堂堂八尺躯，莫听三寸舌，舌上有龙泉，杀人不见血。","book":"宋·罗大经《鹤林玉露》卷六"},"example":{"text":"那李林甫混名叫做李猫儿，平昔不知坏了多少大臣，乃是～的刽子手。","book":"明·冯梦龙《醒世恒言》卷三十五"},"similar":["杀人不眨眼"],"opposite":["与人为善"],"usage":"作定语、分句；指人很阴险"},{"id":25907,"word":"杀人偿命，欠债还钱","pinyin":"shā rén cháng mìng，qiàn zhài huán qián","abbr":"srcmqzhq","explanation":"指杀人者须抵命，欠债者要还钱，二者俱是一理。","source":{"text":"可知道杀人偿命，欠债还钱，你这般说才是。","book":"元·马致远《任风子》第二折"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第24回：“若要中时，便当～。”"},"usage":"作宾语、定语、分句；用于处事"},{"id":25908,"word":"杀人劫财","pinyin":"shā rén jié cái","abbr":"srjc","explanation":"害人性命，抢人财物。指盗匪的行为。","source":{"text":"及海洋大盗，出没彭湖，杀人劫财，不知坏了多少人的性命。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"similar":["杀人越货"],"usage":"作谓语、定语；指盗匪的行为"},{"id":25909,"word":"杀人如爇","pinyin":"shā rén rú yì","abbr":"srrr","explanation":"爇：通“刈”，割草。杀人如割草。形容随意杀人。","source":{"text":"观察使韦岫战不胜，弃城遁，贼入之，焚室庐，杀人如爇。","book":"《新唐书·黄巢传》"}},{"id":25910,"word":"杀人如艺","pinyin":"shā rén rú yì","abbr":"srry","explanation":"形容杀的人多得数不清。同“杀人如麻”。","source":{"text":"焚室庐，杀人如艺。","book":"《新唐书·逆臣传下·黄巢》"}},{"id":25911,"word":"杀人如芥","pinyin":"shā rén rú jiè","abbr":"srrj","explanation":"芥：小草。杀人像割草。形容杀人不当一回事。","source":{"text":"不断征云叆叆，鬼哭神号，到处里染腥风，杀人如芥。","book":"清·洪昇《长生殿·剿寇》"},"similar":["杀人如草"],"usage":"作谓语、定语；用于坏人等"},{"id":25912,"word":"杀人如草","pinyin":"shā rén rú cǎo","abbr":"srrc","explanation":"形容杀人多，极轻视人命。","source":{"text":"狭巷短兵相接处，杀人如草不闻声。","book":"明·沈明臣《凯歌》"},"example":{"text":"同胞张献忠～，而满洲兵的一箭，就钻进树丛中死掉了。","book":"鲁迅《坟·再论雷锋塔的倒掉》"},"similar":["杀人如蒿","杀人如芥","草菅人命"],"usage":"作谓语、定语；用于坏人等"},{"id":25913,"word":"杀人如蒿","pinyin":"shā rén rú hāo","abbr":"srrh","explanation":"形容杀的人多得数不清。同“杀人如麻”。","source":{"text":"世之勇夫，杀人如蒿，及其所难，或失其刀。","book":"宋·苏轼《朱亥墓志》"},"similar":["杀人如草","杀人如芥"],"usage":"作谓语、定语；用于坏人等"},{"id":25914,"word":"杀人如蓺","pinyin":"shā rén rú yì","abbr":"srry","explanation":"蓺：通“刈”，割草。杀人如割草。形容随意杀人。","source":{"text":"观察使韦岫战不胜，弃城遁，贼入之，焚室庐，杀人如蓺。","book":"《新唐书·黄巢传》"},"similar":["杀人如草","杀人如艺"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":25915,"word":"杀人如藨","pinyin":"shā rén rú biāo","abbr":"srrb","explanation":"杀人像割草一样。形容把杀人不当一回事。","source":{"text":"朝避猛虎，夕避长蛇，磨牙吮血，杀人如麻。","book":"唐·李白《蜀道难》诗"}},{"id":25916,"word":"杀人如麻","pinyin":"shā rén rú má","abbr":"srrm","explanation":"如麻：象乱麻一样数不清。杀死的人多得象乱麻。形容杀的人多得数不清。","source":{"text":"朝避猛虎，夕避长蛇，磨牙吮血，杀人如麻。","book":"《汉书·天文志》：“后秦遂以兵内兼六国，外攘四夷，死人如乱麻。”唐·李白《蜀道难》诗"},"example":{"text":"儿自幼随父出征，～，何曾有为祸之理？今杀妖人，正绝大祸，安得反为我祸？","book":"明·罗贯中《三国演义》第二十九回"},"similar":["嗜血成性","斩尽杀绝"],"opposite":["救死扶伤"],"usage":"作谓语、定语；指非常残暴"},{"id":25917,"word":"杀人放火","pinyin":"shā rén fàng huǒ","abbr":"srfh","explanation":"指无法无天的强暴行为。","source":{"text":"他本是杀人放火为生的主儿，被杨元帅收伏在麾下。","book":"元·无名氏《黄花峪》第二折：“听的道杀人放火偏精细，显出我些英雄神威。”清·钱彩《说岳全传》第五十五回"},"example":{"text":"也有钻穴逾垣在那里偷窃的，也有～在那里抢劫的。","book":"清·李汝珍《镜花缘》第九十九回"},"opposite":["治病救人"],"usage":"作谓语、宾语、定语；用于坏人"},{"id":25918,"word":"杀人灭口","pinyin":"shā rén miè kǒu","abbr":"srmk","explanation":"杀害证人以毁灭口供。","source":{"text":"杀人灭口，此生杀之柄，不自主出。","book":"《新唐书·王义方传》"},"example":{"text":"小心他要～。"},"usage":"作谓语、宾语、定语；指消灭证据"},{"id":25919,"word":"杀人盈野","pinyin":"shā rén yíng yě","abbr":"sryy","explanation":"被杀死的人布满原野。形容杀人极多。","source":{"text":"被杀死的人布满原野。形容杀人极多。"},"example":{"text":"被杀死的人布满原野。形容杀人极多。"},"similar":["杀人如麻"],"usage":"作谓语、定语；指杀人极多"},{"id":25920,"word":"杀人越货","pinyin":"shā rén yuè huò","abbr":"sryh","explanation":"越：抢劫。害人性命，抢人东西。指盗匪的行为。","source":{"text":"杀越人于货，暋不畏死，罔弗憝。","book":"《书·康诰》"},"example":{"text":"贫民变乘势闯入富家，～，抢劫至两昼夜。","book":"蔡东藩《五代史演义》"},"similar":["谋财害命","打家劫舍"],"opposite":["舍己为人"],"usage":"作谓语、定语；指盗匪的行为"},{"id":25921,"word":"杀人须见血","pinyin":"shā rén xū jiàn xiě","abbr":"srxjx","explanation":"比喻做事一定要彻底，要有结果。","source":{"text":"为人须为彻，杀人须见血，德册与岩头，万里一条铁。","book":"宋·释惟白《续传灯录》卷三十四"},"example":{"text":"～，救人须见彻。洒家放你不下，直送兄弟到沧州。","book":"明·施耐庵《水浒全传》第九回"}},{"id":25922,"word":"杀人须见血，救人须救彻","pinyin":"shā rén xū jiàn xiě，jiù rén xū jiù chè","abbr":"srxjxjrxjc","explanation":"杀人必须要看到流血，救人必须彻底。比喻做事要认真彻底。","source":{"text":"鲁智深道：‘杀人须见血，救人须救彻。洒家放你不下，直送兄弟到沧州。’","book":"明·施耐庵《水浒传》第九回"},"similar":["送佛送到西"],"usage":"作宾语、定语；用于处事"},{"id":25923,"word":"杀伐决断","pinyin":"shā fá jué duàn","abbr":"sfjd","explanation":"伐：讨伐，进攻。泛指处事作出决断的能力。","source":{"text":"若说料理不开，从小儿大妹妹玩笑时就有杀伐决断，如今出了阁，在那府里办事，越发历练老成了。","book":"清·曹雪芹《红楼梦》第十三回"},"example":{"text":"他带兵打过仗，又干过铜政司“银台”，出任巡抚又当总督，管钱管物又管人，一向雷雳风行～刚明。","book":"二月河《乾隆皇帝》十"},"usage":"作宾语、定语；用于书面语"},{"id":25924,"word":"杀回马枪","pinyin":"shā huí mǎ qiāng","abbr":"shmq","explanation":"比喻出其不意的回头一击。","example":{"text":"你要小心他～。"},"similar":["反戈一击"],"usage":"作谓语、宾语；指回头一击"},{"id":25925,"word":"杀妻求将","pinyin":"shā qī qiú jiàng","abbr":"sqqj","explanation":"春秋时，吴起杀掉妻子以求得到鲁国的信任和重用。比喻为了追求名利而不惜做灭绝人性的事。","source":{"text":"齐人攻鲁，鲁欲将吴起。吴起取齐女为妻，而鲁疑之。吴起于是欲就名，遂杀其妻，以明不与齐也，鲁卒以为将。将而攻齐，大破之。","book":"《史记·孙子吴起列传》"},"example":{"text":"吴起贪官，母死不归，～，不孝之甚。","book":"《晋书·段灼传》"},"usage":"作谓语、定语；指不顾一切追求功名利禄","story":["战国时期，卫国人吴起到鲁国拜曾子为师学习兵法，后做官负责为鲁国练兵。吴起当官后娶了齐国漂亮女子为妻。强大的齐国攻打鲁国，鲁国君想启用吴起为大将，但担心吴起不忠心，吴起听说后杀了自己妻子去拜见国君，后被任命为大将"]},{"id":25926,"word":"杀威棒","pinyin":"shā wēi bàng","abbr":"swb","explanation":"旧时为压倒犯人的气焰，用棍棒打刚抓到或解到的犯人的腿或臀部。借指灭人威风的工具或手段。","source":{"text":"先皇太祖武德皇帝圣旨事例，但凡新入流配的人，须先吃一百杀威棒。","book":"明·施耐庵《水浒传》第九回"},"example":{"text":"恐怕行伍中顽劣不遵约束，见面时要打一百棍，名～。","book":"清·褚人获《隋唐演义》第13回"},"usage":"作主语、宾语、定语；用于书面语"},{"id":25927,"word":"杀家纾难","pinyin":"shā jiā shū nàn","abbr":"sjsn","explanation":"杀：破坏，毁坏；纾：缓和，解除。捐献所有家产，帮助国家减轻困难。","source":{"text":"斗穀于菟为令尹，自毁其家以纾楚国之难。","book":"《左传·庄公三十年》"}},{"id":25928,"word":"杀富济贫","pinyin":"shā fù jì pín","abbr":"sfjp","explanation":"杀掉那些为富不仁的人，向穷人提供救济和帮助。","example":{"text":"武侠小说经常写一些～的英雄。"},"usage":"作谓语、定语、宾语；用于大侠等"},{"id":25929,"word":"杀彘教子","pinyin":"shā zhì jiào zǐ","abbr":"szjz","explanation":"彘：猪。父母说话算数，教子诚实无欺。","source":{"text":"曾子之妻之市，其子随之而泣，其母曰：‘女还顾反为女杀彘。’妻市来，曾子欲捕彘杀之。……曾子曰：‘……母欺子，子而不信其母，非所以成教也。’遂烹彘也。","book":"《韩非子·外诸说左上》"},"similar":["曾子杀彘"],"usage":"作谓语、定语；指父母说话算数","story":["春秋时期，曾子的妻子要去市场，她的儿子哭闹着要跟她去。妻子要他回去并许诺回来就杀猪给他吃。妻子从市场回来，曾子抓住一头猪就要杀，妻子说那只是骗小孩的话。曾子说：“父母的言行直接影响孩子的一生，说到要做到。”"]},{"id":25930,"word":"杀手锏","pinyin":"shā shǒu jiǎn","abbr":"ssj","explanation":"喻指取胜的绝招。","source":{"text":"这其中既有从一开始就积极投入的吴晗、邓初民，也有半路甩出杀手锏的史良。","book":"章诒和《往事并不如烟·正在有情无思间》"},"example":{"text":"每个技师都有自己的～。"},"similar":["撒手锏"],"usage":"作主语、宾语、定语；指绝招"},{"id":25931,"word":"杀敌致果","pinyin":"shā dí zhì guǒ","abbr":"sdzg","explanation":"致：使得到；果：果敢除敌。勇敢杀敌，建立战功。","source":{"text":"杀敌为果，致果为毅。","book":"《左传·宣公二年》"},"example":{"text":"要知道这种举动，和战士在战争时的～，功罪是绝对相反的。","book":"鲁迅《且介亭杂文附集·“立此存照”》"},"similar":["致果杀敌"],"usage":"作谓语；指杀敌建立战功","story":["春秋时期，郑国听从楚王的命令派公子归率军攻打宋国，宋国军队惨败，主将华元成为俘虏。交战中宋军士兵狂狡作战勇敢，心地善良。他营救郑军士卒却被沦为俘虏。宋国人评论狂狡自食恶果，打仗本来要杀敌致果的，不能讲仁慈"]},{"id":25932,"word":"杀气腾腾","pinyin":"shā qì téng téng","abbr":"sqtt","explanation":"杀气：凶恶的气势；腾腾：气势旺盛的样子。形容充满了要杀人的凶狠气势。","source":{"text":"杀气腾腾蔽远空，一声传语似金钟，两家赌战分成败，只在来人启口中。","book":"元·无名氏《气英布》第四折"},"example":{"text":"监狱内～，突然充满了火药气味。","book":"杨沫《青春之歌》第一部第七章"},"similar":["气势汹汹","凶相毕露"],"opposite":["心平气和","心慈手软"],"usage":"作谓语、定语、状语；指凶狠"},{"id":25933,"word":"杀父之仇","pinyin":"shā fù zhī chóu","abbr":"sfzc","explanation":"旧时指最大的仇恨。","source":{"text":"父之仇，弗与共戴天。","book":"《礼记·曲礼上》"},"example":{"text":"岳飞与孤家有～，休息日狭路相逢，要报昔日武场之恨。","book":"清·钱彩《说岳全传》第六十六回"}},{"id":25934,"word":"杀生与夺","pinyin":"shā shēng yǔ duó","abbr":"ssyd","explanation":"杀：处死；生：让人活；予：给予；夺：剥夺。指生死赏罚的大权。","source":{"text":"故丧祭、朝聘、师旅一也。贵贱、杀生、与夺一也。","book":"《韩非子·三守》：“使杀生之机，予夺之要在大臣，如是者侵。”《荀子·王制》"},"example":{"text":"《北史·穆提婆传》：“自外～，不可尽言。”"},"similar":["生死予夺","生杀予夺"],"usage":"作定语、宾语；指统治者的大权"},{"id":25935,"word":"杀生之权","pinyin":"shā shēng zhī quán","abbr":"sszq","explanation":"掌管生死大权。","source":{"text":"夫四豪者，又六国之罪人也，况于郭解之伦，以匹夫之细，窃杀生之权，其罪已不容于诛矣。","book":"汉·扬雄《法言义疏·渊骞》"},"example":{"text":"时叉执～，拜受之日，送者倾朝，有识者为之致惧。","book":"《北史·道武七王传》"},"similar":["杀生之柄"],"usage":"作宾语；用于书面语"},{"id":25936,"word":"杀生之柄","pinyin":"shā shēng zhī bǐng","abbr":"sszb","explanation":"柄：权力。掌管生死大权。","source":{"text":"术者，因任而授官，循名而责实，操杀生之柄，课群臣之能者也，此人主之所执也。","book":"《韩非子·定法》"},"example":{"text":"擅～，通壅塞之涂，权轻重之数，论得失之道，使远近情伪必见于上，谓之木。","book":"《汉书·公孙弘传》"},"similar":["杀生之权"],"usage":"作宾语；用于书面语"},{"id":25937,"word":"杀生害命","pinyin":"shā shēng hài mìng","abbr":"sshm","explanation":"杀害生命。","source":{"text":"则他那退猪汤，不热似俺那研浓墨；则他那杀猪刀，不快似俺那圆尖笔。杀生害命为活计，作业无知。","book":"元·岳伯川《铁拐李》第三折"},"example":{"text":"不想遇着许宣，春心荡漾，按纳不住一时冒犯天条，却不曾～。","book":"明·冯梦龙《警世通言》卷二十八"},"usage":"作谓语、定语、宾语；用于处事"},{"id":25938,"word":"杀衣缩食","pinyin":"shài yī suō shí","abbr":"syss","explanation":"犹节衣缩食。形容节约。","source":{"text":"家虽贫，杀衣缩食，葬宗党十余丧。","book":"明·宁濂《故丽水叶府君墓铭》"},"similar":["节衣缩食"],"usage":"作谓语、定语、宾语；用于生活"},{"id":25939,"word":"杀身之祸","pinyin":"shā shēn zhī huò","abbr":"sszh","explanation":"自身性命遭杀害的大祸。","source":{"text":"若遇此等人，敬而远之，以免杀身之祸。","book":"清·刘鹗《老残游记》第11回"},"example":{"text":"我不想招致～。"},"similar":["灭门之灾"],"usage":"作宾语；指危险的灾祸"},{"id":25940,"word":"杀身出生","pinyin":"shā shēn chū shēng","abbr":"sscs","explanation":"指舍弃生命。","source":{"text":"忠臣亦然，苟使于主利于国，无敢辞违，杀身出生以徇之。","book":"《吕氏春秋·忠廉》"},"usage":"作谓语、定语；用于书面语"},{"id":25941,"word":"杀身成义","pinyin":"shā shēn chéng yì","abbr":"sscy","explanation":"犹言杀身成仁。指为正义而牺牲生命。后泛指为了维护正义事业而舍弃自己的生命。","source":{"text":"《晋书·阎缵传》；“假令如今，吕后必谓昌已反，夷其三族，则谁敢复为杀身成义者哉。”"},"example":{"text":"模雄壮之烈，楷忠贞之操，～，临难如归，非大丈夫亦何能若此矣！","book":"《北史·崔鉴崔模等传论》"},"similar":["杀身成仁"],"usage":"作谓语、定语、宾语；指为正义而牺牲生命"},{"id":25942,"word":"杀身成仁","pinyin":"shā shēn chéng rén","abbr":"sscr","explanation":"成：成全；仁：仁爱，儒家道德的最高标准。指为正义而牺牲生命。后泛指为了维护正义事业而舍弃自己的生命。","source":{"text":"志士仁人，无求生以害仁，有杀身以成仁。","book":"《论语·卫灵公》"},"example":{"text":"若得着死难者的热情的全部，便可以追他们的踪迹，～了。","book":"闻一多《文艺与爱国——纪念三月十八》"},"similar":["视死如归","舍生取义"],"opposite":["苟且偷生","贪生怕死"],"usage":"作谓语、定语、宾语；指为正义而牺牲生命","story":["春秋时期，孔子的弟子问仁德忠义与生命发生冲突怎么办？孔子说：“真正的志士仁人都不会因为贪生怕死而损害仁义，为了成全仁德，可以不顾自己的生命。”子贡问怎样培养仁德，孔子回答必须从上面作起，带动百姓效仿"]},{"id":25943,"word":"杀身成名","pinyin":"shā shēn chéng míng","abbr":"sscm","explanation":"为正义捐弃生命而赢得美名。","source":{"text":"士固有杀身以成名，唯义之所在，虽死无所恨。","book":"《史记·范雎蔡泽列传》"},"example":{"text":"虽其陷于刑辟，自与～，若季路、仇牧，死而不悔也。","book":"《汉书·游侠传》"},"usage":"作谓语、宾语；用于处世"},{"id":25944,"word":"杀身报国","pinyin":"shā shēn bào guó","abbr":"ssbg","explanation":"不惜牺牲生命来报答国家。亦作“杀身救国”。","source":{"text":"臣又多幸天皇任之以股肱，誓期杀身报国，致一人于尧舜。","book":"唐·杨炯《中书令汾阴公薛振行状》"},"example":{"text":"舍命于家，就死成仁，～。","book":"元·曾瑞《哨遍·羊诉冤》套曲"},"similar":["杀身救国"],"usage":"作谓语、定语；用于为人"},{"id":25945,"word":"杀身救国","pinyin":"shā shēn jiù guó","abbr":"ssjg","explanation":"不惜牺牲生命以报答国家。","source":{"text":"夫料事能中，智也；尽心谋国，忠也；临难不避，勇也；杀身救国，仁也。","book":"明·冯梦龙《东周列国志》第44回"},"similar":["杀身报国"],"usage":"作谓语、定语；用于为人"},{"id":25946,"word":"杀青甫就","pinyin":"shā qīng fǔ jiù","abbr":"sqfj","explanation":"杀青：古时在竹简上书写，先以火炙青竹，可免虫蛀，称之为杀青，这里指著作；甫：才。指著作刚完成。","source":{"text":"弋钓书部，愿言注辑，合成六十卷，杀青甫就，轻用上闻。","book":"《后汉书·吴佑传》：“恢欲杀青简以写经书。”唐·李善《上文选注注表》"}},{"id":25947,"word":"杀风景","pinyin":"shā fēng jǐng","abbr":"sfj","explanation":"损坏美好的景色。比喻在大家高兴的时候，突然出现使人扫兴的事物。","source":{"text":"未向人间杀风景，更持醪醑醉花前。","book":"宋·晏殊《煮茶》诗"},"example":{"text":"不叫局也太～。","book":"曾朴《孽海花》"},"similar":["煞风景"],"usage":"作谓语、定语；指败坏兴致"},{"id":25948,"word":"杀马毁车","pinyin":"shā mǎ huǐ chē","abbr":"smhc","explanation":"比喻弃官归隐。","source":{"text":"［冯良］年三十，为尉从佐。奉檄迎督邮，即路慨然，耻在厮役，因坏车杀马，毁裂衣冠，乃遁至犍为，从杜抚学。","book":"《后汉书·周燮传》"},"example":{"text":"～从此逝，子来何处问行藏。","book":"宋·苏轼《捕蝗》诗之二"},"similar":["毁车杀马"],"usage":"作谓语、定语、宾语；用于处事","story":["汉朝时期，冯良30岁时担任尉从佐，他讨厌为官被人驱使。一次，他奉命去迎接督邮，一路感慨万千，因路不好，车子颠坏了，他干脆抛弃车子，连马也杀掉，脱下官袍，从此隐遁到犍为，从杜抚学，过着隐士的生活"]},{"id":25949,"word":"杀鸡为黍","pinyin":"shā jī wéi shǔ","abbr":"sjws","explanation":"指殷勤款待宾客。","source":{"text":"止子路宿，杀鸡为黍而食之。","book":"《论语·微子》"},"example":{"text":"张太太也‘～’的给他那位老爷备了顿饭。","book":"《儿女英雄传》第三五回"},"similar":["杀鸡炊黍"],"usage":"作谓语、定语；用于书面语"},{"id":25950,"word":"杀鸡儆猴","pinyin":"shā jī jǐng hóu","abbr":"sjjh","explanation":"杀鸡给猴子看。比喻用惩罚一个人的办法来警告别的人。","example":{"text":"他现在玩的就是～的把戏。"},"similar":["杀一儆百","杀鸡骇猴"],"usage":"作谓语、定语、宾语；指杀一儆百","story":["从前一个耍猴人买了一只不听话的猴子，艺人十分生气，就到市场买来一只公鸡，对它不断敲锣打鼓，公鸡吓呆了，艺人乘机拿刀杀了公鸡，坐在一旁的猴子也吓坏了，从此只要艺人说什么或敲锣打鼓，猴子就会毫不含糊地执行艺人的指令"]},{"id":25951,"word":"杀鸡取卵","pinyin":"shā jī qǔ luǎn","abbr":"sjql","explanation":"卵：蛋。为了要得到鸡蛋，不惜把鸡杀了。比喻贪图眼前的好处而不顾长远利益。","source":{"text":"《伊索寓言》"},"example":{"text":"请皇上勿再竭泽而渔，～，为小民留一线生机。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["引鸠止渴","因小失大"],"opposite":["高瞻远瞩","一举两得"],"usage":"作谓语、宾语、定语；指只顾眼前","story":["从前一个贪婪的人家里喂养一只母鸡，他靠卖鸡蛋的钱维持生计。一天母鸡下了一枚金蛋，他仔细端详这枚金蛋，认为母鸡肚内肯定还有很多，就把母鸡杀了，仔细搜索，什么也没找到。他这杀鸡取卵的做法太荒唐"]},{"id":25952,"word":"杀鸡取蛋","pinyin":"shā jī qǔ dàn","abbr":"sjqd","explanation":"比喻贪图眼前微小的好处而损害长久的利益。亦作“杀鸡取卵”。","source":{"text":"《伊索寓言》"},"example":{"text":"～的做法不可取"},"similar":["杀鸡取卵"],"usage":"作谓语、宾语、定语；指只顾眼前"},{"id":25953,"word":"杀鸡吓猴","pinyin":"shā jī xià hóu","abbr":"sjxh","explanation":"杀鸡给猴子看。比喻用惩罚一个人的办法来警告别的人。","source":{"text":"俗话说的好，叫做‘杀鸡骇猴’，拿鸡子宰了，那猴儿自然害怕。","book":"清·李宝嘉《官场现形记》第53回"},"example":{"text":"正在气头上，便采取‘～’的手段，传旨革去文悌的御史之职。","book":"《袁世凯演义》第二回"},"similar":["杀一儆百","杀鸡儆猴"],"usage":"作谓语、定语、宾语；指杀一儆百","story":["从前一个耍猴人买了一只不听话的猴子，艺人十分生气，就到市场买来一只公鸡，对它不断敲锣打鼓，公鸡吓呆了，艺人乘机拿刀杀了公鸡，坐在一旁的猴子也吓坏了，从此只要艺人说什么或敲锣打鼓，猴子就会毫不含糊地执行艺人的指令"]},{"id":25954,"word":"杀鸡哧猴","pinyin":"shā jī chī hóu","abbr":"sjch","explanation":"比喻惩罚一人以恐吓或警戒其他人。同“杀鸡骇猴”。"},{"id":25955,"word":"杀鸡扯脖","pinyin":"shā jī chě bó","abbr":"sjcb","explanation":"形容心里着急、发誓、赌咒的神态。","source":{"text":"跪在地上，杀鸡扯脖，口里姐姐长姐姐短。","book":"明·兰陵笑笑生《金瓶梅词话》第21回"},"similar":["杀鸡抹脖","杀鸡扯腿"],"usage":"作定语；指发誓、赌咒的神态"},{"id":25956,"word":"杀鸡抹脖","pinyin":"shā jī mǒ bó","abbr":"sjmb","explanation":"用手在脖子上比划。形容心里着急而无法可想的神态。","source":{"text":"一席话说的贾琏脸都黄了，在凤姐身背后，只望着平儿杀鸡抹脖，使眼色，求他遮盖。","book":"清·曹雪芹《红楼梦》第二十一回"},"similar":["杀鸡扯脖"],"usage":"作定语、状语；指赌咒的神态"},{"id":25957,"word":"杀鸡炊黍","pinyin":"shā jī chuī shǔ","abbr":"sjcs","explanation":"杀鸡作黍饭。引申为盛情款待宾客。","source":{"text":"止子路宿，杀鸡为黍而食之。","book":"《论语·微子》"},"example":{"text":"哥哥，您兄弟在家～等待哥哥相会。哥哥，你休失信也。","book":"元·宫大用《范张鸡黍》楔子"},"similar":["杀鸡为黍"],"usage":"作谓语、定语；用于生活"},{"id":25958,"word":"杀鸡焉用牛刀","pinyin":"shā jī yān yòng niú dāo","abbr":"sjyynd","explanation":"杀只鸡何必用宰牛的刀。比喻办小事情用不着花大气力。","source":{"text":"子之武城，闻弦歌之声。夫子莞尔而笑，曰：‘割鸡焉用牛刀。’","book":"《论语·阳货》"},"example":{"text":"“～”？不劳温侯亲往，吾斩众诸侯首级，如探囊取物耳。","book":"明·罗贯中《三国演义》第五回"},"opposite":["大材小用","小题大做"],"usage":"作谓语、分句；比喻办小事情用不着花大力","story":["春秋时孔子提倡以礼乐教化百姓，他的学生子游在武城做官时，提倡礼乐。孔子到武城听到乐器的弹奏和优雅的歌唱，就对子游说：“割鸡焉用牛刀！”子游解释说：“君子学礼乐就能爱人，百姓学礼乐便于管理。”孔子十分赞许他的做法"]},{"id":25959,"word":"杀鸡骇猴","pinyin":"shā jī hài hóu","abbr":"sjhh","explanation":"传说猴子怕见血，驯猴的人便杀鸡放血来恐吓猴子。比喻惩罚一人以恐吓或警戒其他人。","source":{"text":"俗话说得好，叫做‘杀鸡骇猴’，拿鸡子宰了，那猴儿自然害怕。","book":"清·李宝嘉《官场现形记》第53回"},"example":{"text":"这样做起到～的作用。"},"similar":["杀鸡吓猴","杀一儆百"],"usage":"作谓语、定语、宾语；指杀一儆百","story":["从前一个耍猴人买了一只不听话的猴子，艺人十分生气，就到市场买来一只公鸡，对它不断敲锣打鼓，公鸡吓呆了，艺人乘机拿刀杀了公鸡，坐在一旁的猴子也吓坏了，从此只要艺人说什么或敲锣打鼓，猴子就会毫不含糊地执行艺人的指令"]},{"id":25960,"word":"杂七杂八","pinyin":"zá qī zá bā","abbr":"zqzb","explanation":"形容东西非常混杂，或事情非常杂乱。","source":{"text":"不免又添些自己意思，杂七杂八，强为贯串，以为掩人耳目。","book":"清·李汝珍《镜花缘》第73回"},"example":{"text":"里面～堆得满满的，实在找不下个腾的地方！","book":"赵树理《三里湾》"},"similar":["杂乱无章"],"opposite":["井井有条","整整齐齐"],"usage":"作宾语、定语、状语；指事情非常杂乱"},{"id":25961,"word":"杂七碎八","pinyin":"zá qī suì bā","abbr":"zqsb","explanation":"形容十分混杂。","example":{"text":"请把这些～的东西整理好。"},"similar":["杂七杂八","零七碎八"],"usage":"作宾语、定语、状语；指事情非常杂乱"},{"id":25962,"word":"杂乱无序","pinyin":"zá luàn wú xù","abbr":"zlwx","explanation":"又多又乱，没有条理。","source":{"text":"其为言也，杂乱而无章。","book":"唐·韩愈《送孟东野序》"},"example":{"text":"汉治最为近古而荒略如此，又何怪乎后世之文章典故，杂乱而无序也哉？","book":"清·章学诚《文史通义·书教上》"}},{"id":25963,"word":"杂乱无章","pinyin":"zá luàn wú zhāng","abbr":"zlwz","explanation":"章：条理。乱七八糟，没有条理。","source":{"text":"其为言也，杂乱而无章。","book":"唐·韩愈《送孟东野序》"},"example":{"text":"救火车开不进狭窄的弄。水桶拿不出许多。往来取水只是～的一阵胡闹。","book":"叶圣陶《一桶水》"},"similar":["乱七八糟","千头万绪"],"opposite":["井井有条","有条不紊"],"usage":"作谓语、定语、状语；形容思想等"},{"id":25964,"word":"杂学旁收","pinyin":"zá xué páng shōu","abbr":"zxps","explanation":"杂：多种多样的；旁：广泛。广泛地学习，多方面地积累知识。","source":{"text":"宝兄弟，亏你每日家杂学旁收的，难道就不知道酒性最热，若热吃下去，发散的就快，若冷吃下去，便凝结在内，以五脏去暖他，岂不受害？","book":"清·曹雪芹《红楼梦》第八回"},"usage":"作谓语、定语；用于学习等"},{"id":25965,"word":"杂沓而至","pinyin":"zá tà ér zhì","abbr":"ztez","explanation":"杂沓：杂乱。指从四面纷纷而来。","source":{"text":"杭州自古繁华之处，骚人游客，往往慕西湖遗事，杂沓而至，不免到那里去访问，或者相逢也未可知。","book":"清·烟霞散人《凤凰池》第六回"},"example":{"text":"朋疑众难，～，自非雄杰独断如俄之大彼得者,固弗能胜是也。（清·章炳麟《驳康有为论革命书》）"},"usage":"作谓语、定语；用于书面语"},{"id":25966,"word":"杂然相许","pinyin":"zá rán xiāng xǔ","abbr":"zrxx","explanation":"杂：各种各样的。纷纷表示赞同。","source":{"text":"惩山北之塞，出入之迂也，聚室而谋曰：‘吾与汝毕力平险，指通豫南，达于汉阴，可乎？’杂然相许。","book":"《列子·汤问》"},"usage":"作谓语、定语；用于书面语"},{"id":25967,"word":"杂进巧拙","pinyin":"zá jìn qiǎo zhuō","abbr":"zjqz","explanation":"杂：混杂在一起。灵巧的和笨拙的人都能得到录用。","source":{"text":"登明选公，杂进巧拙，纡余为姘，卓荦为杰，校短量长，惟器是适者，宰相之方也。","book":"唐·韩愈《进学解》"}},{"id":25968,"word":"杂采众说","pinyin":"zá cǎi zhòng shuō","abbr":"zczs","explanation":"杂：多种多样地；采：采碑，采纳。广泛地采纳众家学说、说法","example":{"text":"要坚持自己的观点，不要～"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":25969,"word":"权倾中外","pinyin":"quán qīng zhōng wai","abbr":"qqzw","explanation":"权势压倒朝廷内外。形容权势极大。","source":{"text":"神策军使王驾鹤掌禁兵十余年，权倾中外，德宗初登极，将令白琇珪代之，惧其生变。","book":"《旧唐书·崔祐甫传》"},"example":{"text":"且说晋江州牧王敦，扼守长江，～。","book":"蔡东藩《两晋演义》第三十三回"},"similar":["权倾天下"],"usage":"作谓语、定语；用于官场"},{"id":25970,"word":"权倾天下","pinyin":"quán qīng tiān xià","abbr":"qqtx","explanation":"权力可以倾动于天下。形容权力极大。","source":{"text":"熙宁八年，吕惠卿为参知政事，权倾天下。","book":"宋·魏泰《东轩笔录·吕惠卿》"},"example":{"text":"杨氏～。贵妃进见之夕，奏《霓裳羽衣曲》，授金钗细盒。","book":"清·褚人获《隋唐演义》第79回"},"similar":["权倾中外"],"usage":"作谓语、定语；用于官场"},{"id":25971,"word":"权变锋出","pinyin":"quán biàn fēng chū","abbr":"qbfc","explanation":"指随机应变，锋芒毕露。形容言辞的辩捷锐利。","source":{"text":"此在其术中，吾不知也，此吾所不及苏君者，知深有术，权变锋出。","book":"汉·王充《论衡·答佞》"},"usage":"作谓语、定语；用于人的处世"},{"id":25972,"word":"权均力敌","pinyin":"quán jūn lì dí","abbr":"qjld","explanation":"双方权势相当，不相上下。同“权均力齐”。","source":{"text":"其有能以地与众降者，即以封之……不出一年必有权均力敌内自相疑者。","book":"宋·苏轼《代滕甫论西夏书》"},"similar":["权均力齐","势均力敌"],"usage":"作谓语、定语；用于矛盾冲突的双方"},{"id":25973,"word":"权均力齐","pinyin":"quán jūn lì qí","abbr":"qjlq","explanation":"双方权势相当，不相上下。","source":{"text":"不同心并力则不能自守，权均力齐又不相率，当推一人为将军，共全五郡，观世变动。","book":"晋·袁宏《后汉纪·光武帝纪》"},"similar":["权均力敌","权钧力齐"],"usage":"作谓语、定语；用于矛盾冲突的双方"},{"id":25974,"word":"权宜之策","pinyin":"quán yí zhī cè","abbr":"qyzc","explanation":"指为了应付某种情况而暂时采取的办法。同“权宜之计”。","source":{"text":"前者老舅不知详细，故用权宜之策，今已明白，岂有是理。","book":"明·冯梦龙《醒世恒言·张孝基陈留认舅》"},"example":{"text":"用夷固非常道，不失为～。","book":"清·冯桂芬《借兵俄法议》"},"similar":["权宜之计"],"usage":"作主语、宾语；用于事情"},{"id":25975,"word":"权宜之计","pinyin":"quán yí zhī jì","abbr":"qyzj","explanation":"权宜：暂时适宜，变通；计：计划，办法。指为了应付某种情况而暂时采取的办法。","source":{"text":"及在际会，每乏温润之色，杖正持重，不循权宜之计，是以群下不甚附之。","book":"《后汉书·王允传》"},"example":{"text":"自成心中认为成立娘子军只是一时～，往后怎么个办法，他还没有想妥当。","book":"姚雪垠《李自成》第二卷第十五章"},"similar":["缓兵之计","权宜之策"],"opposite":["百年大计"],"usage":"作主语、宾语；用于事情","story":["东汉时期，军阀董卓废汉少帝另立9岁的汉献帝，掌握朝政，胡作非为。司徒王允献美女貂禅，利用吕布杀死董卓，王允见祸害已除，做事也不循权宜之计，同手下人渐渐疏远，结果让董卓的部将李傕等杀回长安，赶走吕布，杀死王允"]},{"id":25976,"word":"权尊势重","pinyin":"quán zūn shì zhòng","abbr":"qzsz","explanation":"尊：地位或辈分高。权位高，势力大。","source":{"text":"自己代为首相，权尊势重，朝野侧目。","book":"明·冯梦龙《喻世明言》第40卷"},"example":{"text":"他在单位～，在我们这里行不通。"},"opposite":["人微权轻"],"usage":"作谓语、定语；指处于高官位置"},{"id":25977,"word":"权时制宜","pinyin":"quán shí zhì yí","abbr":"qszy","explanation":"斟酌形势随机应变。","source":{"text":"人操行无恒，权时制宜，信者欺人，直者曲挠。","book":"汉·王充《论衡·答佞》"},"similar":["因时制宜"],"usage":"作谓语、宾语；指根据形势来处理"},{"id":25978,"word":"权时救急","pinyin":"quán shí jiù jí","abbr":"qsjj","explanation":"权：称量。正确分析形势，挽救危急局面。","source":{"text":"伯通临入观职，爱惜仓库，而浮秉征伐之任，欲权时救急，二者皆为国耳。","book":"《后汉书·朱浮传》"},"example":{"text":"当下赵彦奉命，无法可施，不得已暮练乡勇，～。","book":"蔡东藩《明史演义》第八十六回"},"usage":"作谓语；用于处世"},{"id":25979,"word":"权欲熏心","pinyin":"quán yù xūn xīn","abbr":"qyxx","explanation":"权力的奢望迷住了心窍。","example":{"text":"他这个人～，为了权力不择手段。"},"similar":["官迷心窍"],"usage":"作谓语、定语；指人爱好权力"},{"id":25980,"word":"权知轻重，度知长短","pinyin":"quán zhī qīng zhòng，dù zhī cháng duǎn","abbr":"qzqzdzcd","explanation":"权：权衡，估计；度：量。称一下才知道轻重，量一下才知道长短。比喻要想对事物作出正确的判断，必须先查明情况。","source":{"text":"权，然后知轻重，度，然后知长短。物皆然，心为甚。","book":"《孟子·梁惠王上》"}},{"id":25981,"word":"权移马鹿","pinyin":"quán yí mǎ lù","abbr":"qyml","explanation":"指恃权专横跋扈，任意颠倒是非。","source":{"text":"语出秦·赵高指鹿为马事。"},"example":{"text":"口变淄素，～，山鬼昼舞，愁魂夜哭，如得其情，片言折狱。","book":"明·冯梦龙《智囊补·察智·得情》"},"similar":["指鹿为马"],"usage":"作宾语、定语；用于处事"},{"id":25982,"word":"权衡利弊","pinyin":"quán héng lì bì","abbr":"qhlb","explanation":"权：称砣。衡：称杆。权衡：比较，衡量。比较一下哪一个有利哪一个有害。","source":{"text":"在处理杂色武装问题时，要依据不同对象，权衡利弊，审慎处理。","book":"邓小平《贵州新区工作的策略》"},"usage":"作谓语、宾语；用于处事"},{"id":25983,"word":"权衡得失","pinyin":"quán héng dé shī","abbr":"qhds","explanation":"权：秤砣；衡：秤杆；权衡：比较，衡量；得失：所得和所失。比喻考虑办一件事的成果和损失。","source":{"text":"为之权衡以称之。","book":"《庄子·胠箧》"}},{"id":25984,"word":"权衡轻重","pinyin":"quán héng qīng zhòng","abbr":"qhqz","explanation":"权衡：衡量。衡量哪个轻，哪个重。比喻比较利害得失的大小。","source":{"text":"为之权衡以称之。","book":"《淮南子·泰族训》：“欲知轻重而无以，予之以权衡，则喜。”《庄子·胠箧》"},"example":{"text":"～，斟酌古今，和而能壮，丽而能典，焕乎若五色之成章，纷乎若八音之繁会。","book":"《周书·王褒庾信传论》"},"similar":["权衡利弊"],"usage":"作谓语、宾语；比喻比较事物主次得失"},{"id":25985,"word":"权豪势要","pinyin":"quán háo shì yào","abbr":"qhsy","explanation":"有权力的豪门，有势力的要人。","source":{"text":"只随朝小小的职名，被这大官人家子弟都占去了，赤紧的又有权豪势要之家，三座衙门，把的水泄不通。","book":"元·宫大用《范张鸡黍》第一折"},"example":{"text":"前元待士甚优，而～，每纳奔竞之人，夤缘阿附，辄窃仕禄。","book":"《明史·选举志》"},"usage":"作宾语、定语；用于权势"},{"id":25986,"word":"权贵显要","pinyin":"quán guì xiǎn yào","abbr":"qgxy","explanation":"旧时指身居高官地位的显赫人物。"},{"id":25987,"word":"权重望崇","pinyin":"quán zhòng wàng chóng","abbr":"qzwc","explanation":"指权力大而威望高。","source":{"text":"素骄贵，又以时乱，天下之权重望崇，莫我若也。","book":"前蜀·杜光庭《虬髯客传》"},"usage":"作宾语、定语；用于权势"},{"id":25988,"word":"权重秩卑","pinyin":"quán zhòng zhì bēi","abbr":"qzzb","explanation":"指权力大官品低。","source":{"text":"而后有殿阁大学士之设，官止五品，权重秩卑，殊不相称。","book":"清·俞樾《茶香室续钞·额外大学士》"},"usage":"作谓语、定语；用于官场"},{"id":25989,"word":"权钧力齐","pinyin":"quán jūn lì qí","abbr":"qjlq","explanation":"钧：通“均”，平均，平等；力齐：协力。齐心协力用权，不专权。","source":{"text":"今天下扰乱，未知所归。河西斗绝在羌胡中，不同心戮力则不能自守，权钧力齐，复无以相率。","book":"《后汉书·窦融传》"},"similar":["权均力齐","权均力敌"],"usage":"作谓语、定语；用于矛盾冲突的双方"},{"id":25990,"word":"杅杅富人","pinyin":"yú yú fù rén","abbr":"yyfr","explanation":"杅杅：广大。学问的渊博，就象富有的财产。","source":{"text":"是杅杅亦富人已，岂不贫而富矣哉！","book":"《荀子·儒效》"}},{"id":25991,"word":"杅穿皮蠹","pinyin":"yú chuān pí dù","abbr":"ycpd","explanation":"杅：饮水器。比喻事先充分准备，谋定而后行动。","source":{"text":"古者杅不穿，皮不蠹，则不出于四方。","book":"《公羊传·宣公十二年》"},"usage":"作宾语、定语；指可能发生的问题应该预计"},{"id":25992,"word":"李下无蹊径","pinyin":"lǐ xià wú xī jìng","abbr":"lxwqj","explanation":"蹊径：小路。李子树下没有小路。比喻诚实的人，心中没有伪诈。","source":{"text":"进吏部侍郎，仍知制诰。与宋璟等同典选事，请谒不行。时人语曰：‘李下无蹊径。’改黄门侍郎，封中山郡公。","book":"《新唐书·李义传》"}},{"id":25993,"word":"李下瓜田","pinyin":"lǐ xià guā tián","abbr":"lxgt","explanation":"比喻容易引起嫌疑的场合。","source":{"text":"瓜田李下，古人所慎。","book":"《北史·袁翻传》"},"example":{"text":"愚谓折柳樊圃，良士瞿瞿；～，君子所避。","book":"清·黄六鸿《福惠全书·莅任部》"},"similar":["瓜田李下"],"usage":"作主语、宾语；比喻容易引起嫌疑的场合"},{"id":25994,"word":"李代桃僵","pinyin":"lǐ dài táo jiāng","abbr":"ldtj","explanation":"僵：枯死。李树代替桃树而死。原比喻兄弟互相爱护互相帮助。后转用来比喻互相顶替或代人受过。","source":{"text":"桃生露井上，李树生桃旁。虫来啮桃根，李树代桃僵。树木深相待，兄弟还相忘。","book":"古乐府诗《鸡鸣》"},"example":{"text":"芝焚蕙叹嗟僚友，～泣弟兄。","book":"清·黄遵宪《感事》诗"},"similar":["代人受过"],"opposite":["嫁祸于人"],"usage":"作宾语、定语；多用于比喻句","story":["从前有兄弟五人都是游手好闲的浪荡子因为得到皇帝赏识，当上了侍中郎，过上奢华的生活。兄弟中一人犯法，其他的则互相倾轧。有人就用诗评判：“桃生露井上，李树在桃傍，虫来啮桃根，李树代桃僵。树木身相代，兄弟还相忘！”"]},{"id":25995,"word":"李广不侯","pinyin":"lǐ guǎng bù hòu","abbr":"lgbh","explanation":"以之慨叹功高不爵，命运乖舛。同“李广未封”。","source":{"text":"李广不侯身渐老，子山操赋恨何深！","book":"唐·徐夤《赠杨著》诗"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“～，是有本事没有运气，运气来了，没有本事，不过昙花一现，好景不长。”"},"similar":["李广未封"],"usage":"作宾语、定语；用于慨叹","story":["西汉时期，中郎将李广任边境上谷太守，他英勇善战，匈奴称他为飞将军，闻风丧胆。他一生不被重用，没有受到封侯的奖赏，最后被逼自杀。他的部将因军功而封侯的人很多，古人认为奇数不吉利，司马迁评价为“李广老，数奇。”"]},{"id":25996,"word":"李广未封","pinyin":"lǐ guǎng wèi fēng","abbr":"lgwf","explanation":"汉名将李广部下因军功而封侯的人很多，而李广本人抗击匈奴，战功显赫，却不见封侯。后因以“李广未封”、“李广不侯”、“李广难封”慨叹功高不爵，命运乖舛。","source":{"text":"但见文翁能化俗，焉知李广未封侯。","book":"唐·杜甫《将赴荆南寄别李剑州》诗"},"similar":["李广难封"],"usage":"作宾语、定语；用于慨叹","story":["西汉时期，中郎将李广任边境上谷太守，他英勇善战，匈奴称他为飞将军，闻风丧胆。他一生不被重用，没有受到封侯的奖赏，最后被逼自杀。他的部将因军功而封侯的人很多，他的堂兄弟李蔡才能不如他却官至丞相"]},{"id":25997,"word":"李广难封","pinyin":"lǐ guǎng nán fēng","abbr":"lgnf","explanation":"以之慨叹功高不爵，命运乖舛。同“李广未封”。","source":{"text":"嗟乎！时运不齐，命途多舛。冯唐易老，李广难封。","book":"唐·王勃《滕王阁序》"},"similar":["李广难封"],"usage":"作宾语、定语；用于慨叹","story":["西汉时期，中郎将李广任边境上谷太守，他英勇善战，匈奴称他为飞将军，闻风丧胆。他一生不被重用，没有受到封侯的奖赏，最后被逼自杀。他的部将因军功而封侯的人很多，他的堂兄弟李蔡才能不如他却官至丞相"]},{"id":25998,"word":"李白桃红","pinyin":"lǐ bái táo hóng","abbr":"lbth","explanation":"桃花红，李花白。指春天美好宜人的景色。","source":{"text":"李白桃红满城郭，马融闲卧望京师。","book":"唐·羊士谔《山阁闻笛》诗"},"example":{"text":"～未吐时，好个春消息。","book":"宋·汪莘《卜算子》词"},"usage":"作宾语、定语；用于描写春天"},{"id":25999,"word":"李郭仙舟","pinyin":"lǐ guō xiān zhōu","abbr":"lgxz","explanation":"常用为友人相亲之典。","source":{"text":"《后汉书·郭太传》载，李膺与郭泰同舟而济，从宾望之，以为神仙，故称“李郭仙舟”。"},"example":{"text":"直沽今日赋将归，～亦暂违。","book":"明·李贽《直沽送马诚所兼呈若翁历山并高张二居士》诗"},"similar":["李郭同舟","李郭同船"],"usage":"作宾语、定语；用于比喻句","story":["南朝时期，太原界休人郭太字林宗，出身贫寒，但他积极好学，到处游学。游学到洛阳见到河南尹李膺。李膺十分喜欢与他交往，一时传为佳话。后来郭太要回家，京师很多学者来送行，郭太只与李膺两人乘船而行，送行的人说他们像一对神仙"]},{"id":26000,"word":"李郭同舟","pinyin":"lǐ guō tóng zhōu","abbr":"lgtz","explanation":"以之比喻知已相处。","source":{"text":"郭太字林宗，太原界休人也。家世贫贱……乃游于洛阳。始见河南尹李膺，膺大奇之，遂相友善，于是名震京师。后归乡里，衣冠诸儒送至河上，车数千两。林宗唯与李膺同舟而济，众宾望之，以为神仙焉。","book":"《后汉书·郭太传》"},"example":{"text":"一时门外瞻望颜色，伺侯车骑者弱项肩累迹，几如荀陈会坐，～。东汉风流，再见今日也。","book":"清·陈康祺《郎潜纪闻》卷八"},"similar":["李郭同船","李郭仙舟"],"usage":"作宾语、定语；用于比喻句","story":["南朝时期，太原界休人郭太字林宗，出身贫寒，但他积极好学，到处游学。游学到洛阳见到河南尹李膺。李膺十分喜欢与他交往，一时传为佳话。后来郭太要回家，京师很多学者来送行，郭太只与李膺两人乘船而行，送行的人说他们像一对神仙"]},{"id":26001,"word":"李郭同船","pinyin":"lǐ guō tóng chuán","abbr":"lgtc","explanation":"以之比喻知已相处。同“李郭同舟”。","source":{"text":"闻道山阴回棹，相去都无百里，李郭可同船。","book":"宋·吕渭老《水调歌头·陈性孺不相见十年》词"},"similar":["李郭同舟","李郭仙舟"],"usage":"作宾语、定语；用于比喻句","story":["南朝时期，太原界休人郭太字林宗，出身贫寒，但他积极好学，到处游学。游学到洛阳见到河南尹李膺。李膺十分喜欢与他交往，一时传为佳话。后来郭太要回家，京师很多学者来送行，郭太只与李膺两人乘船而行，送行的人说他们像一对神仙"]},{"id":26002,"word":"杏林春满","pinyin":"xìng lín chūn mǎn","abbr":"xlcm","explanation":"满：充满。杏林春意盎然。赞扬医术高明。","example":{"text":"他送给医生“～”的锦旗。"},"similar":["誉满杏林"],"usage":"作宾语、定语；用于医生","story":["三国时期，著名医生董奉每天免费为人治病，医术十分高明，经常手到病除。病人要给他送礼，他坚决不收，只要求病人在他门前种一棵杏树，时间长了，他房子周围种上10万棵杏树，春天花开十分漂亮，他用杏树周济那些穷苦人家"]},{"id":26003,"word":"杏脸桃腮","pinyin":"xìng liǎn táo sāi","abbr":"xlts","explanation":"脸似杏花白，腮如桃花红。形容女子容貌美丽。","source":{"text":"杏脸桃腮，乘着月色，娇滴滴越显得红白。","book":"元·王实甫《西厢记》第四本第一折"},"example":{"text":"你想这～上面，加上两片黑黑的东西，有什么好看的？（清·吴趼人《二十年目睹之怪现状》第十一回）"},"similar":["杏腮桃脸"],"usage":"作宾语、定语；用于女性"},{"id":26004,"word":"杏腮桃脸","pinyin":"xìng sāi táo liǎn","abbr":"xstl","explanation":"形容女子容貌美丽。同“杏脸桃腮”。","source":{"text":"杏腮桃脸费铅华，终惯秋蟾影下。","book":"宋·辛弃疾《西江月·赋丹桂》词"},"similar":["杏腮桃颊"],"usage":"作主语、宾语；用于女性"},{"id":26005,"word":"杏腮桃颊","pinyin":"xìng sāi táo jiá","abbr":"xstj","explanation":"形容女子白里透红的秀丽的容颜","source":{"text":"柳眉星眼，杏腮桃颊，口儿小，脚儿弓，扮得蔚贴。","book":"金·董解元《西厢记诸宫调》第八卷"},"similar":["杏腮桃脸","杏脸桃腮"],"usage":"作主语、宾语；用于女性"},{"id":26006,"word":"杏花春雨","pinyin":"xìng huā chūn yǔ","abbr":"xhcy","explanation":"初春杏花遍地、细雨润泽的景象。","source":{"text":"展卷令人倍惆怅，杏花春雨隔江南。","book":"元·虞集《风入松》词：“为报先生归也，杏花春雨江南。”元·王冕《山水图》诗"},"example":{"text":"～，固然有诗，铁马金戈的英雄气概，更富有鼓舞人心的诗力。","book":"杨朔《〈东风第一枝〉小跋》"},"usage":"作宾语、定语；用于风景描写"},{"id":26007,"word":"杏花菖叶","pinyin":"xìng huā chāng yè","abbr":"xhcy","explanation":"花：开花；叶：长叶。杏树开花，菖蒲长叶的时候。指耕种的最好时期。后用以比喻不违农时，及时耕种，必多收获。","source":{"text":"将使杏花菖叶，耕获不愆。","book":"南朝·齐·王融《有明九年策秀才文》"},"example":{"text":"却欲载书寻旧路。烟深处，～耕春雨。","book":"宋·毛滂《渔家傲》词"},"usage":"作宾语、定语；用于农业"},{"id":26008,"word":"杏雨梨云","pinyin":"xìng yǔ lí yún","abbr":"xyly","explanation":"杏花如雨，梨花似云。形容春天景色美丽。","source":{"text":"慕虹霓盟心，蹉跎杏雨梨云，致蜂愁蝶昏。","book":"明·许自昌《水浒记·冥感》"},"usage":"作宾语、定语；用于书面语"},{"id":26009,"word":"材优干济","pinyin":"cái yōu gàn jǐ","abbr":"cygj","explanation":"指才能优异，有干练的办事能力。","source":{"text":"刘宗周、黄道周立朝守正，熊廷弼材优干济。","book":"《清史稿·高宗纪五》"},"usage":"作谓语、定语；指人的才能"},{"id":26010,"word":"材剧志大","pinyin":"cái jù zhì dà","abbr":"cjzd","explanation":"指才智多，志向大。","source":{"text":"略法先王而不知其统，犹然而材剧志大，闻见杂博。","book":"《荀子·非十二子》"},"usage":"作谓语、定语；用于人"},{"id":26011,"word":"材士练兵","pinyin":"cái shì liàn bīng","abbr":"cslb","explanation":"犹言勇士精兵。","source":{"text":"击此者，必将三分我兵，练我死士，二者延阵张翼，一者材士练兵，期其中极。","book":"银雀山·汉墓竹简《孙膑兵法十问》"},"similar":["精兵勇士"],"usage":"作宾语、定语；指精兵勇士"},{"id":26012,"word":"材大难用","pinyin":"cái dà nán yòng","abbr":"cdny","explanation":"原意是能力强难用于小事。后形容怀才不遇。","source":{"text":"原意是能力强难用于小事。后形容怀才不遇。"},"example":{"text":"志士幽人莫怨嗟，古来材大难为用。","book":"唐·杜甫《古柏行》"},"similar":["怀才不遇"],"usage":"作谓语、定语；指怀才不遇"},{"id":26013,"word":"材德兼备","pinyin":"cái dé jiān bèi","abbr":"cdjb","explanation":"材：通“才”。既有工作的才干和能力，又有好的思想品质。","source":{"text":"路上为民除害，以武艺高强、材德兼备，［林时茂］被荐为建康宝刹妙相寺副住持。","book":"《禅真逸史》前言"}},{"id":26014,"word":"材朽行秽","pinyin":"cái xiǔ xíng huì","abbr":"cxxh","explanation":"指无才无德。有时用为谦词。","source":{"text":"恽材朽行秽，文质无所底。","book":"汉·杨恽《报孙会宗书》"},"usage":"作谓语；用于自谦"},{"id":26015,"word":"材疏志大","pinyin":"cái shū zhì dà","abbr":"cszd","explanation":"指志向虽大而才能不足。有时用为谦词。","source":{"text":"材疏志大不自量，西家东家笑我狂。","book":"宋·陆游《大风登城诗》"}},{"id":26016,"word":"材能兼备","pinyin":"cái néng jiān bèi","abbr":"cnjb","explanation":"材：通“才”。才智和能力都具备。","source":{"text":"王焕也空学的文武双全，培养得材能兼备。","book":"元·无名氏《百花亭》第三折"},"example":{"text":"企业都需要～的人才。"},"similar":["德才兼备"],"usage":"作谓语、定语；指人的才智"},{"id":26017,"word":"材茂行洁","pinyin":"cái mào xíng jié","abbr":"cmxj","explanation":"才智丰茂，行为廉洁。","source":{"text":"窃见少府宣，材茂行洁，达于从政。","book":"《汉书·薛宣传》"},"usage":"作谓语、定语；指人的品行"},{"id":26018,"word":"材茂行絜","pinyin":"cái mào xíng jié","abbr":"cmxj","explanation":"絜，同“洁”，干净，廉洁。才智丰茂，行为廉洁。"},{"id":26019,"word":"材薄质衰","pinyin":"cái bó zhì shuāi","abbr":"cbzs","explanation":"指才情资质薄弱。有时用为谦词。","source":{"text":"敏树材薄质衰，不敢图附青云。","book":"清·吴敏树《上曾侍郎书》"},"usage":"作谓语、定语；用于自谦"},{"id":26020,"word":"材轻德薄","pinyin":"cái qīng dé bó","abbr":"cqdb","explanation":"指才德疏浅。有时用为谦词。","source":{"text":"熹委是材轻德薄，不足取信，岂复更敢臧否人物。","book":"宋·朱熹《论臧否所部守臣状》"},"similar":["才轻德薄"],"opposite":["德才兼备"],"usage":"作谓语、定语；用于自谦"},{"id":26021,"word":"材雄德茂","pinyin":"cái xióng dé mào","abbr":"cxdm","explanation":"指才德杰出。","source":{"text":"其监统中贵，必材雄德茂，荣耀宠光，能俯达人情，仰喻天意者，然后为之。","book":"唐·韩愈《送汴州监军俱文珍序》"},"similar":["才德兼备"],"opposite":["材轻德薄"],"usage":"作谓语、定语；指为人"},{"id":26022,"word":"材高知深","pinyin":"cái gāo zhì shēn","abbr":"cgzs","explanation":"材：通“才”。知：通“智”。才能出众，智慧高超。","source":{"text":"今世之将，材高知深，通达众凡，举纲持领，事无不定。","book":"汉·王充《论衡·程材》"},"usage":"作谓语、定语；指人的才学"},{"id":26023,"word":"村哥里妇","pinyin":"cūn gē lǐ fù","abbr":"cglf","explanation":"指平民百姓。里，里巷。","source":{"text":"今天下自衣冠以至村哥里妇，自七十老翁以至三尺童子，谈及刘季起丰沛，项羽不渡乌江，王莽篡位，光武中兴等事，无不能悉数颠末，详其姓氏里居。","book":"明·袁宏道《东西汉通俗演义序》"},"similar":["平民百姓"],"usage":"作主语、宾语、定语；指平民百姓"},{"id":26024,"word":"村夫俗子","pinyin":"cūn fū sú zǐ","abbr":"cfsz","explanation":"指粗野鄙俗的人。","source":{"text":"我虽然不识字，不晓得诗的好歹，只是写得这几行子出的，也不是个村夫俗子了。","book":"清·李渔《风筝误·鹞误》"},"example":{"text":"你不要跟这个～一般见识。"},"similar":["凡夫俗子","村夫野老"],"opposite":["达官贵人"],"usage":"作主语、宾语、定语；指粗俗人"},{"id":26025,"word":"村夫野老","pinyin":"cūn fū yě lǎo","abbr":"cfyl","explanation":"旧指生活在农村的农民和老人。","source":{"text":"周文襄公忱巡抚江南时，尝支驺从入田野间，与村夫野老相语，问疾苦。","book":"明·焦竑《玉堂丛语·行谊》"},"example":{"text":"他这样的～也有值得学习的地方。"},"similar":["村夫俗子","凡夫俗子"],"opposite":["达官贵人"],"usage":"作主语、宾语；指粗俗人"},{"id":26026,"word":"村姑田妇","pinyin":"cūn gū tián fù","abbr":"cgtf","explanation":"农村少女与种田的妇人。指乡下见识不多的女人。","source":{"text":"来你这地方，甚么村姑田妇，冤他拐带！","book":"清·名教中人《好逑传》第九回"},"similar":["妇道人家"],"opposite":["千金小姐","金枝玉叶"],"usage":"作主语、宾语、定语；多用于蔑视口吻"},{"id":26027,"word":"村学究语","pinyin":"cūn xué jiū yǔ","abbr":"cxjy","explanation":"指迂腐浅陋的言辞。","example":{"text":"这是一个严肃的问题，决不允许使用村学究语。"}},{"id":26028,"word":"村村势势","pinyin":"cūn cūn shì shì","abbr":"ccss","explanation":"土头土脑的意思。","source":{"text":"那跳鲍老的身躯扭得村村势势的，宋江看了，呵呵大笑。","book":"钱包明·施耐庵《水浒全传》第三十三回"}},{"id":26029,"word":"村歌社舞","pinyin":"cūn gē shè wǔ","abbr":"cgsw","explanation":"指民间歌舞。","source":{"text":"春光都在柳梢头，拣折长条插洒楼。便作在家寒食看，村歌社舞更风流。","book":"宋·杨万里《宿新市徐公店》诗"},"example":{"text":"～自真率，何用广乐张公侯。","book":"明·刘基《题富好礼所畜村乐图》诗"},"similar":["村歌社鼓"],"usage":"作主语、宾语、定语；用于音乐"},{"id":26030,"word":"村歌社鼓","pinyin":"cūn gē shè gǔ","abbr":"cgsg","explanation":"指民间的歌谣、鼓乐。","source":{"text":"为伍的是伴哥王留，受用的是村歌社鼓。","book":"元·姚守中《粉蝶儿·牛诉冤》套曲"},"example":{"text":"～，花灯影里竞喧阗。","book":"《水浒传》第三三回"},"similar":["村歌社舞"],"usage":"作主语、宾语、定语；用于音乐"},{"id":26031,"word":"村生泊长","pinyin":"cūn shēng bó cháng","abbr":"csbc","explanation":"指生长于村野。泊，水泊。","source":{"text":"他乃是公子人家子孙，强似您这等村生泊长，无指教的小厮每。","book":"明·无名氏《孟母三移》第一折"},"similar":["土生土长"],"usage":"作宾语、定语；用于人的出身"},{"id":26032,"word":"村筋俗骨","pinyin":"cūn jīn sú gǔ","abbr":"cjsg","explanation":"形容人的品格鄙俗。","source":{"text":"不解他粉黛蛾眉心上事，这才是村筋俗骨下场头。","book":"明·无名氏《苏九淫奔》第四折"},"usage":"作宾语、定语；用于低层人"},{"id":26033,"word":"村箫社鼓","pinyin":"cūn xiāo shè gǔ","abbr":"cxsg","explanation":"指民间鼓乐。","source":{"text":"被西风吹尽，村箫社鼓，青山留得，松盖云旗，吊古秋浓，怀人日暮，一片心从天外归。","book":"宋·辛弃疾《沁园春》词"},"example":{"text":"问造物何心，～，奔走儿童。","book":"金·元好问《木兰花慢》词"}},{"id":26034,"word":"村邻乡舍","pinyin":"cūn lín xiāng shě","abbr":"clxs","explanation":"指农村的左右邻居。","source":{"text":"若是让村邻乡舍都知道，他田福堂的脸都没处搁。","book":"路遥《平凡的世界》第一卷第21章"},"similar":["左邻右舍"],"usage":"作主语、宾语、定语；用于书面语"},{"id":26035,"word":"村酒野蔬","pinyin":"cūn jiǔ yě shū","abbr":"cjys","explanation":"乡村酿的酒，田野种的菜。形容酒食淡薄，生活清贫。","source":{"text":"守几亩田园，供养老母，村酒野蔬，亦可与知己谈心。","book":"清·无名氏《说唐》第三回"},"usage":"作宾语；形容酒食淡薄，生活清贫"},{"id":26036,"word":"村野匹夫","pinyin":"cūn yě pǐ fū","abbr":"cypf","explanation":"村野：荒村山野。匹夫：平民百姓。旧指没有知识、没有地位的人。","source":{"text":"马超曰：‘吾家屡世公侯，岂识村野匹夫！’","book":"明·罗贯中《三国演义》第65回"},"example":{"text":"请不要与这个～一般见识。"},"similar":["村夫野老"],"opposite":["达官贵人"],"usage":"作宾语、定语；指乡下人"},{"id":26037,"word":"杖化龙","pinyin":"zhàng huà lóng","abbr":"zhl","explanation":"竹杖化作一条龙。比喻得道成仙。","source":{"text":"忧不得到家，公以一竹杖与之曰：‘但骑此得到家耳。’房骑竹杖辞去，忽如睡觉，已到家……所骑竹杖弃葛陂中，视之，乃青龙耳。","book":"晋·葛洪《神仙传·壶公》"},"example":{"text":"鸟化双凫～，云山回首不知重。（宋·陆游《道室杂咏》）"}},{"id":26038,"word":"杖头木偶","pinyin":"zhàng tóu mù ǒu","abbr":"ztmo","explanation":"以木棍举托操纵木偶、做出各种造型动作的一种木偶戏。比喻受人操纵的人。","example":{"text":"他只不过是～，得抓住幕后黑手才成。"},"usage":"作宾语、定语；用于口语"},{"id":26039,"word":"杖履相从","pinyin":"zhàng lǚ xiāng cóng","abbr":"zlxc","explanation":"指追随左右。","source":{"text":"门生与儿子，杖履聊相从。","book":"宋苏轼《和》之七"},"example":{"text":"予虽不及识公，而有斯人在，会当同往，～，方公之故居，而蹑其遗踪。","book":"金王若虚《茅先生道院记》"},"usage":"作谓语、定语；用于书面语"},{"id":26040,"word":"杖履纵横","pinyin":"zhàng lǚ zòng héng","abbr":"zlzh","explanation":"形容游人来往不绝。"},{"id":26041,"word":"杖杜弄麞","pinyin":"zhàng dù nòng zhāng","abbr":"zdnz","explanation":"指人借读别字","source":{"text":"有用‘杕杜’二字者，林甫不识杕字，谓吏部侍郎韦陡曰：‘此云杖杜何也？’陡俯首不敢言。又太常少卿姜度诞子，林甫手书庆之曰：‘闻有弄麞之庆’","book":"《旧唐书·李林甫传》"},"usage":"作宾语、定语；用于书面语","story":["唐朝时期，不学无术的李林甫典选部时，选人严回判语，有用‘杕杜’二字者，林甫不识杕字，对吏部侍郎韦陡说：‘此云杖杜何也？’陡俯首不敢言。一次太常少卿姜度得子，林甫亲手书写：‘闻有弄麞之庆’，客人视之掩口而笑"]},{"id":26042,"word":"杖策窥园","pinyin":"zhǎng cè kuī yuán","abbr":"zcky","explanation":"杖策：拄杖。扶着拐杖，也要去园中看看。指不读死书，而是要观察、了解社会。","source":{"text":"杖策窥园日数巡，攀花弄草兴常新。董生只被公羊惑，肯信捐书一语真。","book":"宋·王安石《窥园》"},"usage":"作宾语、定语；用于书面语"},{"id":26043,"word":"杖节把钺","pinyin":"zhǎng jié bǎ yuè","abbr":"zjby","explanation":"杖节：古代大臣出使或大将出征时，皇帝授予的权杖；钺：古兵器。既有皇帝授予的符节，又有极大的兵权。形容权力很大。","source":{"text":"以太保甄邯为大将军，受钺高庙，领天下兵，左杖节，右把钺，屯城外。","book":"《汉书·王莽传》"},"usage":"作谓语、定语；用于书面语"},{"id":26044,"word":"杖莫如信","pinyin":"zhàng mò rú xìn","abbr":"zmrx","explanation":"杖：通“仗”，凭借。可仗恃的莫过于守信用。","source":{"text":"舍之闻之：‘杖莫如信’。完守以老楚，杖信以待晋，不亦可乎。","book":"春秋·鲁·左丘明《左传·襄公八年》"},"usage":"作宾语、定语；指人的信用好"},{"id":26045,"word":"杖钺一方","pinyin":"zhǎng yuè yī fāng","abbr":"zyyf","explanation":"钺：古兵器。在一方手持大钺。比喻掌握兵权或驻扎一方。","source":{"text":"遂推毂委诚，授以专征之任，握兵十万，杖钺一方。","book":"《尚书·牧誓》：“王左杖黄钺，右秉白旄以麾。”《魏书·慕容白曜传》"},"example":{"text":"今稚逆命，擅杀张辅，明公～，宜惩不恪，此亦《春秋》之义。（《晋书·张轨传》）"},"usage":"作谓语、定语；用于书面语"},{"id":26046,"word":"杜口吞声","pinyin":"dù kǒu tūn shēng","abbr":"dkts","explanation":"形容一句话也不说。","source":{"text":"群公卿士，杜口吞声，莫敢有言。","book":"《后汉书·曹节传》"},"similar":["忍气吞声","缄口不言"],"usage":"作谓语、定语；形容极度害怕"},{"id":26047,"word":"杜口无言","pinyin":"dù kǒu wú yán","abbr":"dkwy","explanation":"闭住嘴巴，不出一言。","source":{"text":"挹辞气慷慨，志在不辱，杖刃推戈，期之以陨，将吏持守，用不即毙，遂乃杜口无言，绝粒而死。","book":"《晋书·吉挹传》"},"similar":["杜口绝言","杜口结舌","杜口木舌"],"usage":"作谓语、宾语；指无言以对"},{"id":26048,"word":"杜口木舌","pinyin":"dù kǒu mù shé","abbr":"dkms","explanation":"杜口：闭口不言；木舌：结舌。闭着嘴说不出话来。比喻缄口不言，形容不敢说话。","source":{"text":"忠臣惧死而杜口，万夫怖祸而木舌。","book":"南朝·宋·范晔《后汉书·黄琼传》"},"similar":["杜口结舌","杜口绝舌"],"usage":"作谓语、宾语；指无言以对"},{"id":26049,"word":"杜口结舌","pinyin":"dù kǒu jié shé","abbr":"dkjs","explanation":"犹言杜口吞声。","source":{"text":"杜口结舌，心中拂郁，去灾患生，莫所告冤。","book":"汉·焦赣《易林·比之咸》"},"example":{"text":"而人主若不能虚心听纳，自古忠臣直士之所慷慨，至使～。","book":"《晋书·傅玄传》"},"similar":["张口结舌","杜口绝舌"],"usage":"作谓语、宾语；指无言以对"},{"id":26050,"word":"杜口绝舌","pinyin":"dù kǒu jué shé","abbr":"dkjs","explanation":"杜口：闭口不言；绝舌：不说话。闭着嘴说不出话来。形容理屈词穷，无言以对或指十分害怕。","source":{"text":"杜口绝舌，言为祸母。","book":"汉·焦赣《易林·否之簨》"},"similar":["杜口结舌","杜口绝言"],"usage":"作谓语、宾语；指无言以对"},{"id":26051,"word":"杜口绝言","pinyin":"dù kǒu jué yán","abbr":"dkjy","explanation":"犹言杜口无言。","source":{"text":"昔以舌毁大乘，今以舌赞大乘，补过自新，犹为善矣，杜口绝言，其利安在？","book":"唐·玄奘《大唐西域记·阿逾陀国》"},"similar":["杜口无言","杜口结舌","杜口绝舌"],"usage":"作谓语、宾语；指无言以对"},{"id":26052,"word":"杜口裹足","pinyin":"dù kǒu guǒ zú","abbr":"dkgz","explanation":"杜口：闭住嘴；裹足：止步不前。闭着嘴不敢说，停住脚不敢走。比喻有顾虑而不敢接近，远远避开。","source":{"text":"臣之所恐者，独恐臣死之后，天下见臣尽忠而身蹶也，是以杜口裹足，莫肯即秦耳。","book":"西汉·刘向《战国策·秦策三》"},"example":{"text":"她被吓得～不敢出门。"},"similar":["闭口不言"],"usage":"作谓语、状语；形容十分害怕"},{"id":26053,"word":"杜弊清源","pinyin":"dù bì qīng yuán","abbr":"dbqy","explanation":"杜绝弊端，廓清来源。","source":{"text":"臣等仍多派妥干员弁，于各口加倍严查，终期杜弊清源。","book":"清·林则徐《烧毁匪船以断英船接济折》"},"example":{"text":"他向上级进献～的报告。"},"usage":"作谓语、定语；指彻底阻断"},{"id":26054,"word":"杜微慎防","pinyin":"dù wēi shèn fáng","abbr":"dwsf","explanation":"杜：杜绝，断绝；慎：谨慎。杜绝细微，谨慎防备萌芽。即消灭祸患难与共于萌芽状态之中。","source":{"text":"松言边兵外也而内之，武库仗内也而外之，非所以重肘腋，杜微慎防也，执弗许。","book":"《明史·胡松传》"},"example":{"text":"对于禽流感，我们要采取～的方针来对付。"},"similar":["杜渐防萌","防微杜渐"],"usage":"作谓语、定语；指防微杜渐"},{"id":26055,"word":"杜断房谋","pinyin":"dù duàn fáng móu","abbr":"ddfm","explanation":"喻指多谋善断。同“房谋杜断”。","source":{"text":"每议事帝所，玄龄必曰：‘非如晦莫筹之。’及如晦至，卒用玄龄策也。盖如晦长於断，而玄龄善谋，两人深相知，故能同心济谋，以佐佑帝。","book":"《新唐书·杜如晦传》"},"example":{"text":"～劳午夜，江毫丘锦各名家。","book":"柳亚子《寄毛主席延安》诗"},"similar":["房谋杜断"],"usage":"作宾语、定语；形容能人之间的合作","story":["唐朝初年，唐太宗善于任用能人为之服务，经常听从大臣的意见。一次他与文昭商量事情，房玄龄感慨地说：“非如晦莫能筹之。”等到杜如晦来到时，杜如晦立即分析房玄龄的计谋做出决断。他们两人合作得十分融洽，人称房谋杜断"]},{"id":26056,"word":"杜渐防微","pinyin":"dù jiàn fáng wēi","abbr":"djfw","explanation":"杜：堵住；渐：指事物的开端；微：微小。错误或坏事刚冒头就及时制止，不让它发展。","source":{"text":"若敕政责躬，杜渐防萌，则凶妖销灭，害除福凑矣。","book":"晋·葛洪《抱朴子·明本》：“昔之达人，杜渐防微，色斯而逝，夜不待旦，睹几而作，不俟终日。”《后汉书·丁鸿传》"},"example":{"text":"～之责，舍我辈其谁堪任之！","book":"闻一多《给梁实秋、吴景超、翟毅夫、顾毓琇、熊佛西诸先生》"},"similar":["防微杜渐","杜渐防萌"],"opposite":["任其自然"],"usage":"作谓语、定语；同“杜渐防萌”","story":["汉和帝刘肇即位后，窦太后掌权，她的哥哥窦宪被封为武阳侯，权力越来越大。丁鸿直言不讳地对刘肇说大将军武阳侯窦宪仪仗太后的势力，包揽朝政，这是朝廷的隐患要及时清除。汉和帝采纳了丁鸿的意见，罢免了窦宪等人的官职"]},{"id":26057,"word":"杜渐防萌","pinyin":"dù jiàn fáng méng","abbr":"djfm","explanation":"杜：堵住；渐：指事物的开端；萌：萌芽。在事故或灾害尚未发生时就预防。","source":{"text":"若敕政责躬，杜渐防萌，则凶妖销灭，害除福凑矣。","book":"南朝·宋·范晔《后汉书·丁鸿传》"},"example":{"text":"～，古人所以远祸；以小喻大，先哲于焉取则。","book":"《旧唐书·王志宁传》"},"similar":["防微杜渐"],"opposite":["听之任之"],"usage":"作谓语；指在事故或灾害尚未发生就预防","story":["汉和帝刘肇即位后，窦太后掌权，其兄窦宪被封为武阳侯，权力越来越大。丁鸿直言不讳地对刘肇说大将军武阳侯窦宪仪仗太后的势力，包揽朝政，这是朝廷的隐患要及时清除。汉和帝采纳了丁鸿的意见，罢免了窦宪等人的官职"]},{"id":26058,"word":"杜渐除微","pinyin":"dù jiàn chú wēi","abbr":"djcw","explanation":"在事故或灾害尚未发生时就预防。同“杜渐防萌”。","source":{"text":"杜渐除微，古今所务，况祸机骤发，庸可忽乎。","book":"《宋书·彭城王义康传》"},"similar":["杜渐防微"],"usage":"作谓语、宾语；用于处事"},{"id":26059,"word":"杜绝人事","pinyin":"dù jué rén shì","abbr":"djrs","explanation":"杜绝：断绝；人事：人与人的交往。即断绝与别人的一切交往。","source":{"text":"圭出为贝州刺史，未几罢免，退归常山。由是闭门杜绝人事，虽亲戚故人造者不见其面。","book":"《旧五代史·晋书·史圭传》"},"example":{"text":"～的人不会有所成就的。"},"similar":["闭门却扫"],"usage":"作谓语、定语；指断绝与别人的一切交往"},{"id":26060,"word":"杜绝后患","pinyin":"dù jué hòu huàn","abbr":"djhh","explanation":"杜绝：堵塞、断绝；患：祸害、祸患。指彻底消除以后可能产生的祸患。","source":{"text":"那安放白玉炉的山峰崩将下来，恰好堵了洞门。雾幙白玉炉仍收回天上，从此白云洞再无人到。此是玉帝杜绝后患之意。","book":"明·罗贯中《平妖传》第四十回"},"example":{"text":"人无远虑，怕有近忧。不如到官处断开了，庶～。","book":"明·兰陵笑笑生《金瓶梅词话》第九十二回"},"opposite":["放虎归山"],"usage":"作谓语、宾语；指消除祸患的可能"},{"id":26061,"word":"杜绝言路","pinyin":"dù jué yán lù","abbr":"djyl","explanation":"杜绝：断绝，阻塞；言路：进言之路。堵塞和断绝一切进言之路，指不纳谏言。","source":{"text":"操欲迷夺时明，杜绝言路。","book":"《后汉书·袁绍传》"},"opposite":["广开言路"],"usage":"作谓语、宾语、定语；用于处事"},{"id":26062,"word":"杜耳恶闻","pinyin":"dù ěr è wén","abbr":"deew","explanation":"塞住耳朵不愿听。","source":{"text":"怀忠抱直之人，虚心谒见；便佞诡随之说，杜耳恶闻。","book":"《旧五代史·唐书·末帝纪中》"},"usage":"作谓语、宾语；用于处事"},{"id":26063,"word":"杜邮之戮","pinyin":"dù yóu zhī lù","abbr":"dyzl","explanation":"杜邮：古地名，在今陕西省咸阳市；戮：杀。指忠臣无辜被杀。","source":{"text":"武安君既行，出咸阳西门十里，至杜邮……秦王乃使使者赐之剑，自裁。","book":"西汉·司马迁《史记·白起王翦列传》"},"example":{"text":"夫孝子疑于屡至，市虎成于三夫，若不详察真伪，忠臣将复有～矣。","book":"南朝·宋·范晔《后汉书·傅燮传》"},"usage":"作宾语；用于书面语","story":["战国末期，武安君奉秦昭王之命出城巡视，到达咸阳西门十里远的杜邮时，昭王派使者前来赐武安君，让他用短剑自裁，武安君问他所犯何罪？迫于压力又不得不拔剑自杀。老百姓见他死于非罪，每年他的死期自发祭祀"]},{"id":26064,"word":"杜门不出","pinyin":"dù mén bù chū","abbr":"dmbc","explanation":"关闭门户，不外出与人交往接触。","source":{"text":"谗言益起，狐突杜门不出。","book":"《国语·晋语一》"},"example":{"text":"及党事起，[郑康成]乃与同郡孙嵩等四十余人俱被禁锢，随隐修经业，～。","book":"清·王鸣盛《蛾术编·说人八》"},"similar":["闭门不出"],"usage":"作谓语、宾语；指隐居"},{"id":26065,"word":"杜门却扫","pinyin":"dù mén què sǎo","abbr":"dmqs","explanation":"杜：堵塞；却扫：不再扫径迎客。关上大门，扫除车迹。指闭门谢客，不和外界往来。","source":{"text":"遂绝迹下帷，杜门却扫，弃产营书，手自删削。","book":"《北史·李谧传》"},"example":{"text":"归而～，不关人事。","book":"清·钱谦益《申比部诗序》"},"similar":["杜门谢客","闭门却扫"],"usage":"作谓语；指闭门谢客"},{"id":26066,"word":"杜门塞窦","pinyin":"dù mén sāi dòu","abbr":"dmsd","explanation":"窦：孔、洞。关上门，堵塞漏洞。指断绝一切通道。","source":{"text":"入夜，杜门塞窦，唯恐其亡。","book":"清·蒲松龄《聊斋志异·荷花三娘子》"}},{"id":26067,"word":"杜门屏迹","pinyin":"dù mén píng jì","abbr":"dmpj","explanation":"指隐居不出。同“杜门晦迹”。","source":{"text":"公杜门屏迹，心不自安，与门生故吏数百人归于后魏。","book":"唐·杨炯《后周宇文公神道碑》"},"usage":"作谓语、宾语；用于处事"},{"id":26068,"word":"杜门晦迹","pinyin":"dù mén huì jì","abbr":"dmhj","explanation":"晦：隐匿。关上门，隐匿自己的踪迹。指隐居起来，不让别人知道自己的踪迹或动态。","source":{"text":"显和具陈宣杜门晦迹，相时而动，孝武深纳焉。","book":"《周书·宇文神举传》"},"example":{"text":"我准备～，潜心向佛。"},"similar":["杜门绝迹"],"usage":"作谓语；指闭门隐居"},{"id":26069,"word":"杜门绝客","pinyin":"dù mén jué kè","abbr":"dmjk","explanation":"指不与人往来。同“杜门谢客”。","source":{"text":"韩世忠既罢，杜门绝客，口不言兵，时跨驴携酒，从一二奚童，纵酒西湖以自乐。","book":"明·冯梦龙《智囊补·术智·委蛇》"},"example":{"text":"[郑之惠]二年春告病，～，究心学问。","book":"明·刘若愚《酌中志·见闻琐事杂记》"},"similar":["杜门谢客"],"usage":"作主语、谓语、定语；指不与人往来"},{"id":26070,"word":"杜门绝迹","pinyin":"dù mén jué jì","abbr":"dmjj","explanation":"指隐居不出。","source":{"text":"后得赦出……诏拜中散大夫，遂杜门绝迹。","book":"南朝·宋·范晔《后汉书·党锢传·刘佑》"},"example":{"text":"我不想做～的人。"},"similar":["杜门晦迹"],"usage":"作谓语；指闭门隐居"},{"id":26071,"word":"杜门自守","pinyin":"dù mén zì shòu","abbr":"dmzs","explanation":"关闭大门，安分守已。","source":{"text":"光退闾里，杜门自守。","book":"《汉书·孔光传》"},"example":{"text":"是以～，遥望堂阶，茫如梯天。","book":"清·刘大槐《与吴阁学书》"},"similar":["杜门自绝","闭关自守"],"usage":"作谓语、宾语、定语；指人安分"},{"id":26072,"word":"杜门自绝","pinyin":"dù mén zì jué","abbr":"dmzj","explanation":"杜门：关门不出；绝：断绝。闭门不出，将自己与外界隔绝。","source":{"text":"及吕后时，事多故矣，平竟自免，以智终，王陵廷争，杜门自绝，亦各其智也。","book":"东汉·班固《汉书·张陈王周传赞》"},"example":{"text":"～的做法不可取。"},"similar":["杜门自守","杜门绝迹"],"usage":"作谓语、定语；指闭门不出"},{"id":26073,"word":"杜门谢客","pinyin":"dù mén xiè kè","abbr":"dmxk","explanation":"杜门：闭门不出；谢客：谢绝宾客。指不与人往来。","source":{"text":"以世乱，弃官居洛阳，杜门绝人事者五六年。","book":"《新五代史·赵光逢传》"},"example":{"text":"王瑞虹～，不与外事。","book":"清·王晫《今世说·言语》"},"similar":["与世隔绝"],"usage":"作主语、谓语、定语；指不与人往来"},{"id":26074,"word":"杜门面壁","pinyin":"dù mén mian bì","abbr":"dmmb","explanation":"指闭门修养。","source":{"text":"杜门面壁，安心静修。","book":"宋·苏轼《答王幼安宣德启》"},"example":{"text":"他只有回家～，才能洗却自己的罪责。"},"usage":"作谓语、宾语；用于隐居"},{"id":26075,"word":"杜隙防微","pinyin":"dù xī fāng wēi","abbr":"dxfw","explanation":"杜隙：杜绝疏失。杜绝疏失，防患于未然。","source":{"text":"择才望大臣素为都人信服者以统之，弹压维制，杜隙防微，亦不为无助也。","book":"明·陈子龙《整饬京营疏》"},"similar":["杜微慎防","杜渐防萌"],"opposite":["听之任之"],"usage":"作谓语、定语；指防微杜渐"},{"id":26076,"word":"杜鹃啼血","pinyin":"dù juān tí xuě","abbr":"djtx","explanation":"传说杜鹃昼夜悲鸣，啼至血出乃止。常用以形容哀痛之极。","source":{"text":"其间旦暮闻何物？杜鹃啼血猿哀鸣。","book":"唐·白居易《琵琶行》"},"example":{"text":"～的故事十分感人。"},"similar":["望帝啼鹃"],"usage":"作宾语、定语；指悲痛"},{"id":26077,"word":"杜默为诗","pinyin":"dù mò wéi shī","abbr":"dmws","explanation":"杜：杜撰，臆造；杜默：指孤陋寡闻。孤陋寡闻，随意杜撰之诗。","source":{"text":"杜默为诗多不合律，故言事不合格者为杜撰。","book":"宋·王楙《野客丛书》卷二十"}},{"id":26078,"word":"杞人之忧","pinyin":"qǐ rén zhī yōu","abbr":"qrzy","explanation":"比喻不必要的或缺乏根据的忧虑和担心。同“杞人忧天”。","source":{"text":"这是贤弟关心太切，所以有杞人之忧。","book":"曾朴《孽海花》第27回"},"similar":["杞人忧天"],"usage":"作主语、宾语；多用于劝诫人"},{"id":26079,"word":"杞人忧天","pinyin":"qǐ rén yōu tiān","abbr":"qryt","explanation":"杞：周代诸侯国名，在今河南杞县一带。杞国有个人怕天塌下来。比喻不必要的或缺乏根据的忧虑和担心。","source":{"text":"杞国有人，忧天地崩坠，身亡所寄，废寝食者。","book":"《列子·天瑞》"},"example":{"text":"～，伯虑愁眼。","book":"清·李汝珍《镜花缘》第二十七回"},"similar":["庸人自扰","杞人忧天"],"opposite":["无忧无虑","若无其事"],"usage":"作谓语、定语、状语；指缺乏根据的忧虑","story":["春秋时期，杞国一个爱瞎猜疑的人，总是疑神疑鬼，他担心天会踏下来，整天愁眉苦脸，担惊受怕，从此一病不起。朋友来看他，给他讲天是由气体组成是掉不下来的。他就放心了，后来又担心太阳、月亮、星星会掉下来，大地会陷下去"]},{"id":26080,"word":"杞国之忧","pinyin":"qǐ guó zhī yōu","abbr":"qgzy","explanation":"比喻不必要的或缺乏根据的忧虑和担心。同“杞人忧天”。","source":{"text":"士大夫皆有杞国之忧。","book":"宋·岳珂《桯史·岁星之祥》"},"example":{"text":"独以役重赋烦，人民凋蒺，识者不无～。","book":"明·范濂《云间据目抄》第五卷"},"similar":["杞天之虑","杞人忧天"],"usage":"作主语、宾语；多用于劝诫人"},{"id":26081,"word":"杞国忧天","pinyin":"qǐ guó yōu tiān","abbr":"qgyt","explanation":"比喻不必要的或缺乏根据的忧虑和担心。同“杞人忧天”。","source":{"text":"丹诚不回白日照，杞国忧天独劳苦。","book":"明·何景明《田子行》"},"similar":["杞人忧天","杞人之忧"],"usage":"作谓语、状语；指缺乏根据的忧虑"},{"id":26082,"word":"杞天之虑","pinyin":"qǐ tiān zhī lǜ","abbr":"qtzl","explanation":"比喻不必要的或缺乏根据的忧虑和担心。同“杞人忧天”。亦省作“杞虑”。","source":{"text":"我曾经也有过‘杞天之虑’，以为将来中国的学生出身的女性，恐怕要失去哺乳的能力，家家须雇乳娘。","book":"鲁迅《而已集·忧‘天乳’》"},"similar":["杞人忧天","杞人之忧"],"usage":"作主语、宾语；多用于劝诫人"},{"id":26083,"word":"杞宋无征","pinyin":"qǐ sòng wú zhēng","abbr":"qswz","explanation":"指资料不足，不能证明。","source":{"text":"夏礼吾能言之，杞不足征也；殷礼吾能言之，宋不足征也。文献不足故也。","book":"《论语·八佾》"},"usage":"作宾语；指资料不足，不能证明"},{"id":26084,"word":"杞梓之才","pinyin":"qǐ zǐ zhī cái","abbr":"qzzc","explanation":"杞、梓：两种优质的木材，指良材。比喻优秀的人才。","source":{"text":"晋卿不若楚，其大夫则贤。其大夫皆卿材也，若杞梓、皮革焉，楚实遗之。","book":"《国语·楚语上》"},"example":{"text":"戎衣而笼关塞，朝服而扫江湖，收～，辟康庄之馆。","book":"《隋书·潘徽传》"}},{"id":26085,"word":"杞梓之林","pinyin":"qǐ zǐ zhī lín","abbr":"qzzl","explanation":"比喻众多的人材。","source":{"text":"殷庙羞瑚琏之器，楚材惭杞梓之林。","book":"唐·李庾《西都赋》"},"usage":"作宾语；用于比喻句"},{"id":26086,"word":"杞梓连抱","pinyin":"qǐ zǐ lián bào","abbr":"qzlb","explanation":"杞、梓：两种优质的木材，指良材。比喻杰出的人才。","source":{"text":"子思曰：夫圣人之官人犹大匠之用木也，取其所长，弃其所短，故杞梓连抱，而有数尺之朽，良工不弃。何也 ，知其所妨者细也。","book":"秦·孔鲋《孔丛子·居卫》"}},{"id":26087,"word":"束上起下","pinyin":"shù shàng qǐ xià","abbr":"ssqx","explanation":"犹承上启下。多用于诗文评语。","source":{"text":"下半折遥承第十回，以碧桃起波，引起下六回文字，亦束上起下，必不可少之文。","book":"《花月痕》第四五回清·栖霞居士评阅"},"example":{"text":"‘江山’两句，折到人事，～，换头逆入。","book":"苏轼《念如娇·赤壁怀古》“江山如画”唐·圭璋释"},"similar":["承上启下"],"usage":"作谓语、定语；多用于诗文评论"},{"id":26088,"word":"束之高屋","pinyin":"shù zhī gāo wū","abbr":"szgw","explanation":"捆起来以后放在高高的架子上。比喻放着不用。同“束之高阁”。","source":{"text":"弃置莫读，束之高屋，怡性养神，辍歌送哭。","book":"明·李贽《读书乐》诗"},"similar":["束之高阁","束置高阁","束在高阁"],"usage":"作谓语、宾语、定语；指放着不用"},{"id":26089,"word":"束之高阁","pinyin":"shù zhī gāo gé","abbr":"szgg","explanation":"高阁：储藏器物的高架。捆起来以后放在高高的架子上。比喻放着不用。","source":{"text":"此辈宜束之高阁，俟天下太平，然后议其任耳。","book":"《晋书·庾翼传》"},"example":{"text":"如果有了正确的理论，只是把它空谈一阵，～，并不实行，那末，这种理论再好也是没有意义的。","book":"毛泽东《实践论》"},"similar":["置之不理","置之度外","束之高屋"],"opposite":["爱不释手","掌上明珠"],"usage":"作谓语、宾语、定语；指放着不用","story":["东晋著名将领庾翼很有学问，他奉旨驻守武昌，把武昌治理得社会安定、百姓富足。他带兵北伐，收复了北方部分领土，他对当时两个善辩的名人杜宏和殷浩看不惯，认为应该把他们束之高阁，等天下太平时，再考虑让他们做一些事情"]},{"id":26090,"word":"束修自好","pinyin":"shù xiū zì hǎo","abbr":"sxzh","explanation":"犹言束身自修。指约束自己，不与坏人坏事同流合污。","source":{"text":"夫束修自好者，岂无其人；经济自期，抗怀千古者，亦所在多有。","book":"清·郑燮《范县署中寄舍弟墨第四书》"},"similar":["束身自修"],"opposite":["同流合污"],"usage":"作谓语、宾语、定语；用于处事"},{"id":26091,"word":"束兵秣马","pinyin":"shù bīng mò mǎ","abbr":"sbmm","explanation":"犹厉兵秣马。形容准备战斗。","source":{"text":"后人有诗叹玄德曰：‘束兵秣马去匆匆，心念天言衣带中。撞破铁笼逃虎豹，顿开金锁走蛟龙。’","book":"《三国演义》第二一回"},"similar":["厉兵秣马"],"usage":"作谓语、定语；指准备战斗"},{"id":26092,"word":"束发封帛","pinyin":"shù fā fēng bó","abbr":"sffb","explanation":"指妇女忠贞不渝。","source":{"text":"直言坐事。贬岭南，以妻少，乃诀曰：‘生死不可期，吾去，可亟嫁，无须也。’董不答，引绳束发，封以帛，使直言署，曰：‘非君手不解。’直言贬二十年乃还，署帛宛然。乃汤沐，发堕无馀。","book":"《新唐书·列女传·贾直言妻董》"},"usage":"作宾语、定语；用于比喻句","story":["贾直言因为出事而被贬到岭南，临行前与妻子诀别，希望她不要为他守寡，遇到合适的人家也可以出嫁，妻子董氏流着泪而不回答，就用绳子把头发绑起来，再用丝帛包起来，对贾直言说：“非君手不解”。贾直言被贬20年后才会，董氏的头发已经堕地很长"]},{"id":26093,"word":"束发小生","pinyin":"shù fà xiǎo shēng","abbr":"sfxs","explanation":"束发：成童的代称。刚成童不久的少年。","example":{"text":"虽是特别种类，却究竟是“～”，所以当然不会有三头六臂的大神力。","book":"鲁迅《华盖集·补白》"}},{"id":26094,"word":"束在高阁","pinyin":"shù zài gāo gé","abbr":"szgg","explanation":"捆起来以后放在高高的架子上。比喻放着不用。同“束之高阁”。","source":{"text":"朱门豪家，积书万卷，束在高阁，尘暗签轴，蠹落帙帷。","book":"元·辛文房《唐才子传·汪遵》"},"similar":["束之高阁","束之高屋","束置高阁"],"usage":"作谓语、宾语、定语；指放着不用"},{"id":26095,"word":"束帛加璧","pinyin":"shù bó jiā bì","abbr":"sbjb","explanation":"束：一捆。帛：丝织品的总称；束帛：帛五匹；璧：指平圆正中有孔的玉器。五匹帛上面再加美玉。古时聘请或探问时奉送的贵重礼物。","source":{"text":"束帛加璧，尊德也。","book":"《礼记·礼器》"},"example":{"text":"武帝风闻申公重名，立即派遣使臣，用了安车蒲轮，～，迎聘申公。","book":"蔡东藩《前汉演义》第五十八回"},"usage":"作主语、宾语、定语；用于书面语"},{"id":26096,"word":"束带矜庄","pinyin":"shù dài jīn zhuāng","abbr":"sdjz","explanation":"束：扎束；带：玉带，朝廷服饰；庄：庄重。腰扎玉带，态度庄重。","source":{"text":"带束矜庄，徘徊瞻眺。","book":"南朝·梁·周字兴嗣《千字文》"}},{"id":26097,"word":"束带结发","pinyin":"shù dài jié fā","abbr":"sdjf","explanation":"束系衣带，挽起发髻。指出仕。","source":{"text":"庶岩穴之士闻而慕之，束带结发，愿进于阙下。","book":"唐·韩愈《争臣论》"},"usage":"作谓语、定语；用于书面语"},{"id":26098,"word":"束带蹑履","pinyin":"shù dài niè lǚ","abbr":"sdnl","explanation":"束带：扎紧衣服；蹑履：穿鞋。指穿戴整肃，用来表示恭敬。","source":{"text":"初，庾亮临江州，闻翟汤之风，束带蹑履而诣焉。","book":"《论语·公冶长》：“赤也，束带立于朝，可使与宾客言也。”南朝·宋·刘义庆《世说新语·栖逸》"}},{"id":26099,"word":"束广就狭","pinyin":"shù guǎng jiù xiá","abbr":"sgjx","explanation":"指把丰富的内容概括为极少的文字。","source":{"text":"荆公旧有诗云：‘我名公字偶相同，我屋公墩在眼中。公去我来墩属我，不应墩姓尚随公。’他人欲隐括此意，非累数十言不可，而公以二十八字尽之，真得束广就狭体。","book":"宋·韦居安《梅磵诗话》卷上"},"usage":"作宾语、定语；用于书面语"},{"id":26100,"word":"束戈卷甲","pinyin":"shù gē juàn jiǎ","abbr":"sgjj","explanation":"捆起兵器甲胄。指缴械投降。","source":{"text":"世忠单骑夜造其营，呼曰：‘大军至矣，亟束戈卷甲，吾能保全汝，共功名。’贼骇栗请命，因跪进牛酒。","book":"《宋史·韩世忠传》"},"usage":"作谓语、宾语；用于战争等"},{"id":26101,"word":"束手受戮","pinyin":"shù shǒu shòu lù","abbr":"sssl","explanation":"戮：杀。捆起自己，等待被杀。指不作任何抵抗，甘愿等死。","source":{"text":"臣将窜身草泽，不能留居大王左右，束手受戮也。","book":"清·褚人获《隋唐演义》第66回"},"similar":["束手待毙","束手待死","引颈受戮"],"usage":"作谓语、定语、宾语；指坐以待毙"},{"id":26102,"word":"束手听命","pinyin":"shù shǒu tīng mìng","abbr":"sstm","explanation":"拱手听从命令。","source":{"text":"三镇平，则淄青之胆破矣。命一辩士持天子之诏往谕之，彼安得不束手听命哉！","book":"宋·陈亮《酌古论·马燧》"},"similar":["俯首听命"],"usage":"作谓语、定语；用于处事"},{"id":26103,"word":"束手坐视","pinyin":"shù shǒu zuò shì","abbr":"sszs","explanation":"拱着手，坐着看。比喻对应当管的事无能为力或不管不问。","source":{"text":"京军一出，日费不赀，遇涨则束手坐视，无所施力。","book":"《明史·徐有贞传》"},"example":{"text":"添加军队，胁国民以服兵役，增征租赋，数倍于前。彼义侠之匈加利人，岂肯～此辜恩非礼之行哉！","book":"梁启超《匈加利爱国者噶苏士传》第三节"},"similar":["束手旁观","袖手旁观"],"usage":"作谓语、宾语、定语；指不过问"},{"id":26104,"word":"束手就困","pinyin":"shù shǒu jiù kùn","abbr":"ssjk","explanation":"指无法摆脱困境。","source":{"text":"元时亦输粟以供上都，其后兼之海运，然当群雄奸命之时，烽烟四起，运道梗绝，惟有束手就困耳。","book":"明·谢肇淛《五杂俎·地部一》"},"usage":"作谓语、定语；用于书面语"},{"id":26105,"word":"束手就擒","pinyin":"shù shǒu jiù qín","abbr":"ssjq","explanation":"束手：自缚其手，比喻不想方设法；就：受；擒：活捉。捆起手来让人捉住。指毫不抵抗，乖乖地让人捉住。","source":{"text":"与其束手就擒，曷若死战，然未必死。","book":"《宋史·苻彦卿传》"},"example":{"text":"宁王闹了两年，不想被新建伯王守仁一阵杀败，～。","book":"清·吴敬梓《儒林外史》第八回"},"similar":["坐以待毙","听天由命","束手就缚"],"opposite":["负隅顽抗"],"usage":"作谓语、宾语；指不抵抗","story":["公元945年，契丹军将后晋军队围困在阳城，后晋军队的供需被切断，内外隔绝，生活十分困难，军心不稳。晋将苻彦卿有勇有谋，向主将张彦泽、皇甫遇建议与其在此束手就擒还不如战死，就分析天时地利人和，出其不意绕到契丹军后方发起进攻取得胜利"]},{"id":26106,"word":"束手就死","pinyin":"shù shǒu jiù sǐ","abbr":"ssjs","explanation":"捆起手来等死。","source":{"text":"薛霸便提起水火棍来，望着林冲脑袋上劈将来，可怜豪杰束手就死。","book":"明·施耐庵《水浒传》第八回"},"similar":["束手就毙","束手就戮","束手待死"],"usage":"作谓语、定语；指等死"},{"id":26107,"word":"束手就殪","pinyin":"shù shǒu jiù yì","abbr":"ssjy","explanation":"比喻遇到困难不积极想办法，坐着等失败。同“束手待毙”。","source":{"text":"主逃将溃，无所一用其力，束手就殪，与国俱亡而已。","book":"《明史·黄得功传》"},"similar":["束手就擒","束手就死","束手就缚"],"usage":"作谓语、定语；用于处事"},{"id":26108,"word":"束手就毙","pinyin":"shù shǒu jiù bì","abbr":"ssjb","explanation":"毙：死。捆起手来等死。比喻遇到困难不积极想办法，坐着等失败。","source":{"text":"予顷修《靖康实录》，窃痛一时之祸，以堂堂大邦，中外之兵数十万，曾不能北向发一矢、获一胡，端坐都城，束手就毙。","book":"宋·洪迈《容斋续笔·靖康时事》"},"similar":["束手待毙","束手待死"],"usage":"作谓语、定语；指等死"},{"id":26109,"word":"束手就禽","pinyin":"shù shǒu jiù qín","abbr":"ssjq","explanation":"捆起手来让人捉住。指毫不抵抗，乖乖地让人捉住。见“束手就擒”。","source":{"text":"众如言，夜径入山寺，明先唯与徒党十数人居，束手就禽。","book":"王·闿运《桂阳陈侍郎行状》"},"similar":["束手就擒"],"opposite":["负隅顽抗"],"usage":"作谓语、宾语；指不抵抗"},{"id":26110,"word":"束手就缚","pinyin":"shù shǒu jiù fù","abbr":"ssjf","explanation":"比喻不加抵抗，甘愿被人擒捉。同“束身就缚”。","source":{"text":"吾计成矣：使刘备束手就缚，荆州反掌可得！","book":"明·罗贯中《三国演义》第五十四回"},"example":{"text":"这几个小南蛮，只算得个瓮中之鳖，不消费得僧家大刀，管教他一个个～。","book":"清·钱彩《说岳全传》第七十六回"},"similar":["束手就擒","束身就缚"],"opposite":["负隅顽抗"],"usage":"作谓语、宾语；指不抵抗"},{"id":26111,"word":"束手待死","pinyin":"shù shǒu dài sǐ","abbr":"ssds","explanation":"比喻遇到困难不积极想办法，坐着等失败。同“束手待毙”。","source":{"text":"曹兵既至，岂可束手待死，某愿助使君破之。","book":"明·罗贯中《三国演义》第十回"},"example":{"text":"愿先生早示良策，我必不肯～。","book":"清·褚人获《隋唐演义》第九十四回"},"similar":["束手待毙","束手就毙"],"usage":"作谓语、定语；指等死"},{"id":26112,"word":"束手待毙","pinyin":"shù shǒu dài bì","abbr":"ssdb","explanation":"毙：死。捆起手来等死。比喻遇到困难不积极想办法，坐着等失败。","source":{"text":"予顷修《靖康实录》，窃痛一时之祸，以堂堂大邦，中外之兵数十万，曾不能北向发一矢、获一胡，端坐都城，束手就毙。","book":"宋·洪迈《容斋续笔·靖康时事》"},"example":{"text":"兵临城下，将至壕边，岂可～！（明·罗贯中《三国演义》第七回）"},"similar":["束手无策","束手就擒"],"opposite":["应付自如"],"usage":"作谓语、定语；指等死"},{"id":26113,"word":"束手旁观","pinyin":"shù shǒu páng guān","abbr":"sspg","explanation":"犹袖手旁观。比喻置身事外，不加过问。","source":{"text":"咱们不得束手旁观，睁着眼叫他陷于不义。","book":"《歧路灯》第六二回"},"example":{"text":"梅因吐血而死。现在年轻的枚少爷又在吐血……又是一个悲剧，他们仍然只有～。","book":"巴金《秋》三九"},"similar":["袖手旁观","冷眼旁观","束手坐视"],"usage":"作谓语、宾语、定语；指不过问"},{"id":26114,"word":"束手无措","pinyin":"shù shǒu wú cuò","abbr":"sswc","explanation":"措：措施，办法。遇到问题，就象手被捆住一样，一点办法也没有。","source":{"text":"与其束手无措以委输于虏，孰若变通尽利，以庶几虏之可逐也。","book":"宋·文天祥《己未上皇帝书》"},"example":{"text":"《清史稿·讷尔经额传》：“讷尔经额回驻临牫关，素不知兵，～。”"},"similar":["束手无策","束手无计"],"usage":"作谓语、宾语、定语；指一点办法也没有"},{"id":26115,"word":"束手无术","pinyin":"shù shǒu wú shù","abbr":"ssws","explanation":"指捆住双手，无计可施。形容遇到问题没有解决的办法。","source":{"text":"乔道清束手无术，不能解救。","book":"明·施耐庵《水浒传》第九十七回"},"similar":["束手无计","束手无策"],"usage":"作谓语、宾语、定语；用于处事"},{"id":26116,"word":"束手无策","pinyin":"shù shǒu wú cè","abbr":"sswc","explanation":"策：办法。遇到问题，就象手被捆住一样，一点办法也没有。","source":{"text":"（秦）桧死而逆亮（金主完颜亮）南牧，孰不束手无策。","book":"元·无名氏《宋季三朝政要》"},"example":{"text":"梅飏仁正在～的时候，听了师爷的话说甚是中听，立刻照办。","book":"清·李宝嘉《官场现形记》第五十五回"},"similar":["无能为力","一筹莫展"],"opposite":["得心应手","左右逢源","急中生智"],"usage":"作谓语、宾语、定语；指一点办法也没有"},{"id":26117,"word":"束手无计","pinyin":"shù shǒu wú jì","abbr":"sswj","explanation":"遇到问题，就象手被捆住一样，一点办法也没有。同“束手无策”。","source":{"text":"即有缓急，外廷不得闻，宿卫不入，吾辈大臣束手无计。","book":"清·傅维鳞《明书·名臣传·申时行》"},"example":{"text":"登楼共视，则葛端系櫺上；欲解援之，则葛细不堪用力。遍索道人已杳矣。～，奏之鲁王。","book":"清·蒲松龄《聊斋志异·巩仙》"},"similar":["束手无策","束手无术"],"usage":"作谓语、宾语、定语；用于处事"},{"id":26118,"word":"束手束脚","pinyin":"shù shǒu shù jiǎo","abbr":"sssj","explanation":"捆住手脚。形容胆子小，顾虑多。","source":{"text":"按照法律办事，不等于束手束脚。","book":"毛泽东《在省市自治区党委书记会议上的讲话》"},"example":{"text":"不能～地干事。"},"similar":["束手缚脚","束手束足"],"opposite":["大刀阔斧"],"usage":"作谓语、定语；比喻做事过分小心，不敢放手"},{"id":26119,"word":"束手束足","pinyin":"shù shǒu shù zú","abbr":"sssz","explanation":"捆住手脚。形容胆子小，顾虑多。同“束手束脚”。","source":{"text":"就是该死的炉顶化了，限制了他，使他在调整煤气空气方面，简直束手束足，不敢随便动一下指头。","book":"艾芜《百炼成钢》第二章"},"similar":["束手束脚","束手缚脚"],"usage":"作谓语、定语；比喻做事过分小心，不敢放手"},{"id":26120,"word":"束手缚脚","pinyin":"shù shǒu fù jiǎo","abbr":"ssfj","explanation":"捆住手脚。形容胆子小，顾虑多。同“束手束脚”。","source":{"text":"冒失鬼一昧粗心浮气，目中无人，到处以强为胜，一遇鬼谷先生，早已束手缚脚，有力无用处。","book":"清·张南庄《何典》第八回"},"similar":["束手束脚","束手束足"],"usage":"作谓语、定语；比喻做事过分小心，不敢放手"},{"id":26121,"word":"束手自毙","pinyin":"shù shǒu zì bì","abbr":"sszb","explanation":"指捆住双手，自取灭亡。","source":{"text":"但使兵连不解，馈运不休，古犹忌之，矧今日兵无可连，馈无可运，徒束手自毙何益。","book":"清·刘献廷《广阳杂记》卷二"},"example":{"text":"清·吴璿《飞龙全传》第44回：“为人在世，岂可贪生怕死，～？”"},"similar":["束手待毙","束手就死","束手就毙"],"usage":"作谓语、宾语、定语；用于处事"},{"id":26122,"word":"束教管闻","pinyin":"shù jiào guǎn wén","abbr":"sjgw","explanation":"指学识浅陋，见闻不广。"},{"id":26123,"word":"束杖理民","pinyin":"shù zhàng lǐ mín","abbr":"szlm","explanation":"指治理百姓不滥用刑罚。形容为官宽仁爱民。束杖，收起刑具。","source":{"text":"有刑罚徒流绞斩，吊拷絣把。设而不用，束杖理民宽雅。","book":"金·董解元《西厢记诸宫调》卷八"},"example":{"text":"上圣自从隋炀帝封为嘉州太守，爱惜黎庶，～。","book":"明·无名氏《齐天大圣》第一折"},"usage":"作谓语、定语；用于书面语"},{"id":26124,"word":"束椽为柱","pinyin":"shù chuán wéi zhù","abbr":"scwz","explanation":"捆扎椽子当柱子用。比喻小材大用。","source":{"text":"委弃九鼎兮，烹饪瓦釡。截梁为杙，束椽为柱。","book":"明·刘基《吊祖豫州赋》"},"usage":"作宾语、定语；用于比喻句"},{"id":26125,"word":"束缊举火","pinyin":"shù yūn jǔ huǒ","abbr":"syjh","explanation":"比喻求助于人。也比喻为人排难解纷。同“束缊请火”。","source":{"text":"国破家亡，年衰岁暮，束缊举火，轹釡待炊，季臣意殊安之。","book":"清·钱谦益《吕季臣诗序》"},"similar":["束蕴乞火","束缊还妇","束缊请火"],"usage":"作谓语、宾语；指求人"},{"id":26126,"word":"束缊乞火","pinyin":"shù yùn qǐ huǒ","abbr":"syqh","explanation":"束缊：束一扎可烧的大麻为火把；乞火：借火。搓麻为引火绳，向邻家讨火。比喻求助于人。也比喻为人排难解纷。","source":{"text":"故里母非谈说之士也，束缊乞火非还妇之道也。","book":"《汉书·蒯通传》"}},{"id":26127,"word":"束缊请火","pinyin":"shù yùn qǐng huǒ","abbr":"syqh","explanation":"束缊：束一扎可烧的大麻为火把；请火：借火。搓麻为引火绳，向邻家讨火。比喻求助于人。也比喻为人排难解纷。","source":{"text":"即束缊请火于亡肉家。","book":"《汉书·蒯通传》"},"similar":["束缊还妇","束缊举火"],"usage":"作谓语、宾语；指求人","story":["从前有一个婆婆诬告儿媳偷家里的肉，儿媳百口莫辩被婆婆赶出家门，只好去找邻居大婶帮助伸冤。大婶深知她的为人，就想出一个办法，拿一团乱麻到那个婆婆家去借火，说是自家的狗因为争吃别人家的肉被咬死。婆婆知错就去追儿媳回家"]},{"id":26128,"word":"束缊还妇","pinyin":"shù yūn huán fù","abbr":"syhf","explanation":"比喻求助于人。也比喻为人排难解纷。同“束缊请火”。","source":{"text":"束缊还妇，虽蒙假借之私；惩羹吹虀，尚虑谴诃之及。","book":"宋·秦观《谢馆职启》"},"similar":["束缊请火","束缊举火","束蕴乞火"],"usage":"作谓语、宾语；指求人"},{"id":26129,"word":"束置高阁","pinyin":"shù zhì gāo gé","abbr":"szgg","explanation":"捆起来以后放在高高的架子上。比喻放着不用。同“束之高阁”。","source":{"text":"至于濂、洛、关、闽之学，不究礼乐之源，独标性命之旨，义疏诸书，束置高阁，视如糟粕。","book":"清·江藩《〈汉学师承记〉序》"},"similar":["束之高阁","束之高屋","束在高阁"],"usage":"作谓语、宾语、定语；指放着不用"},{"id":26130,"word":"束肩敛息","pinyin":"shù jiān liǎn xī","abbr":"sjlx","explanation":"缩肩屏息。形容恭顺的样子。"},{"id":26131,"word":"束蒲为脯","pinyin":"shù pú wéi pú","abbr":"spwp","explanation":"将捆束的蒲柳说成肉脯。指有意颠倒黑白，混淆是非。","source":{"text":"秦相赵高指鹿为马，束蒲为脯，二世不觉。","book":"《文选·潘岳〈西征赋〉》“野蒲变而成脯，苑鹿化以为马”李善注引汉·应劭《风俗通》"},"usage":"作谓语、定语、宾语；多用于比喻句"},{"id":26132,"word":"束蕴乞火","pinyin":"shù yùn qǐ huǒ","abbr":"syqh","explanation":"比喻求助于人。也比喻为人排难解纷。同“束缊请火”。","source":{"text":"故里母非谈说之士也，束蕴乞火非还妇之道也，然物存相感，事有适可。","book":"《汉书·蒯通传》"},"example":{"text":"打门声急谁氏子，～霜风寒；劝渠且宿不敢住，袒而示我催租瘢。","book":"宋·方岳《三虎行》"},"similar":["束缊举火","束缊请火","束缊还妇"],"usage":"作谓语、宾语；指求人","story":["从前有一个婆婆诬告儿媳偷家里的肉，儿媳百口莫辩被婆婆赶出家门，只好去找邻居大婶帮助伸冤。大婶深知她的为人，就想出一个办法，拿一团乱麻到那个婆婆家去借火，说是自家的狗因为争吃别人家的肉被咬死。婆婆知错就去追儿媳回家"]},{"id":26133,"word":"束蕴请火","pinyin":"shù yùn qǐng huǒ","abbr":"syqh","explanation":"比喻求助于人。也比喻为人排难解纷。同“束缊请火”。","source":{"text":"《汉书·蒯通传》：“即束缊请火于亡肉家。”《韩诗外传》卷七亦有此说，“缊”作“蕴”。"},"similar":["束缊请火","束缊举火","束缊还妇"],"usage":"作谓语、宾语；指求人","story":["从前有一个婆婆诬告儿媳偷家里的肉，儿媳百口莫辩被婆婆赶出家门，只好去找邻居大婶帮助伸冤。大婶深知她的为人，就想出一个办法，拿一团乱麻到那个婆婆家去借火，说是自家的狗因为争吃别人家的肉被咬死。婆婆知错就去追儿媳回家"]},{"id":26134,"word":"束装就道","pinyin":"shù zhuāng jiù dào","abbr":"szjd","explanation":"整好行装走上旅途。","source":{"text":"生素闻西湖名胜，思往一游，束装就道。","book":"清·王韬《淞隐漫录·燕剑秋》"},"example":{"text":"即叫倪忠～，来到杭州，刚一接任，就收了无数的词状。","book":"清·石玉昆《三侠五义》第七十二回"}},{"id":26135,"word":"束装盗金","pinyin":"shù zhuāng dào jīn","abbr":"szdj","explanation":"指无端见疑。","source":{"text":"为郎，事文帝。其同舍有告归，误持其同舍郎金去。已而同舍郎觉，亡意不疑，不疑谢有之，买金偿。后告归者至而归金，亡金郎大惭，以此称为长者。","book":"《汉书·直不疑传》"},"example":{"text":"嫌或疑心，诚亦难分。动容窃斧，～，又何足论也。","book":"南朝·宋·颜延之《庭诰》"},"usage":"作宾语、定语；用于书面语","story":["汉朝时期，郎官隽不疑侍奉汉文帝，他的同事请假回家，误把同宿舍的另一个的金钱带回家了。那个同事认为是隽不疑拿了。隽不疑知道不能分辩就拿自己的金子给丢金的人。后来误拿金子的人回来了，把金子还给丢金人，丢金人十分惭愧"]},{"id":26136,"word":"束贝含犀","pinyin":"shù bèi hán xī","abbr":"sbhx","explanation":"指牙齿如紧密排列的贝壳和瓠犀。形容牙齿整齐洁白。","source":{"text":"染一枝春色淡，攒两叶翠痕低，束贝含犀，另一种风流意。","book":"元·汤式《一枝花·赠妓素兰》套曲"},"usage":"作宾语、定语；多用于比喻句"},{"id":26137,"word":"束身修行","pinyin":"shù shēn xiū xíng","abbr":"ssxx","explanation":"约束自身，修养德行。","source":{"text":"往者群气争存，尤物死虑，支体不从，身为泥土，根拔枝殊，咸失其所，汝又焉得束身修行，磬折抱鼓。","book":"三国·魏·阮籍《大人先生传》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":26138,"word":"束身受命","pinyin":"shù shēn shòu mìng","abbr":"sssm","explanation":"束身：约束自身，不放纵。比喻投案。指投案归顺过去以后、听从命令。","source":{"text":"卫君之来也，卫国之半曰：‘不若朝于晋。’其半曰：‘不若朝于吴。’然卫君以为吴可以归骸骨也，故束身以受命。","book":"《淮南子·人间训》"}},{"id":26139,"word":"束身就缚","pinyin":"shù shēn jiù fù","abbr":"ssjf","explanation":"束：捆。束身：自缚。缚：捆绑。比喻不加抵抗，甘愿被人擒捉。","source":{"text":"艾被诏书，即遣强兵，束身就缚，不敢顾望。","book":"《晋书·段灼传》"},"similar":["束手就缚","束手就擒"],"usage":"作谓语、宾语；指不抵抗"},{"id":26140,"word":"束身自修","pinyin":"shù shēn zì xiū","abbr":"sszx","explanation":"指约束自己，不与坏人坏事同流合污。","source":{"text":"［光武帝］乃下诏曰：‘前密令卓茂，束身自修，执节淳固，诚能为人所不能为。’","book":"《后汉书·卓茂传》"},"similar":["束身自爱","洁身自爱","束修自好"],"opposite":["同流合污"],"usage":"作谓语、宾语；用于处事"},{"id":26141,"word":"束身自好","pinyin":"shù shēn zì hào","abbr":"sszh","explanation":"束身：约束自己，不使放纵；自好：要求自己好。指保持自身纯洁。","source":{"text":"束身自修，执节淳固。","book":"《后汉书·卓茂传》"},"example":{"text":"次即～，优游卒岁，以自处于朝隐。","book":"章炳麟《驳康有为论革命书》"},"similar":["洁身自好"],"usage":"作谓语；指保持自身纯洁"},{"id":26142,"word":"束身自爱","pinyin":"shù shēn zì ài","abbr":"ssza","explanation":"犹言束身自修。指约束自己，不与坏人坏事同流合污。","source":{"text":"稍束身自爱者，不敢逸于常轨，以蒙青史之诛。","book":"清·陈天华《中国革命史论》第一章"},"example":{"text":"诸君肄业大学，当能～。","book":"蔡元培《就任北京大学校长之演说》"},"similar":["洁身自爱","束身自修"],"opposite":["同流合污"],"usage":"作谓语、宾语；用于处事"},{"id":26143,"word":"束身自重","pinyin":"shù shēn zì zhòng","abbr":"sszz","explanation":"束：约束；重：尊重，看重。严格约束自己。","source":{"text":"束身自修，执节淳固。","book":"《后汉书·卓茂传》"}},{"id":26144,"word":"束马县车","pinyin":"shù mǎ xiàn chē","abbr":"smxc","explanation":"形容走山路的艰险情况。同“束马悬车”。"},{"id":26145,"word":"束马悬车","pinyin":"shù mǎ xuán chē","abbr":"smxc","explanation":"束马：把马蹄包起，防止马滑倒；悬车：把车子钩牢，以防脱落。把马脚裹起来，把车吊上山去。形容走山路的艰险情况。","source":{"text":"束马悬车，上卑耳之山。","book":"春秋·齐·管仲《管子·封禅》"},"example":{"text":"高上寻云霓，深谷肆无景，～，然后得济。","book":"《晋书·羊祜传》"},"usage":"作谓语、定语；形容走山路的艰险"},{"id":26146,"word":"条三窝四","pinyin":"tiáo sān wō sì","abbr":"tsws","explanation":"搬弄是非，挑拔离间。"},{"id":26147,"word":"条修叶贯","pinyin":"tiáo xiū yè guàn","abbr":"txyg","explanation":"枝长叶连。比喻有条理、有系统。","source":{"text":"下至介鳞，上及毛羽，条修叶贯，万物百族，由本至末，莫不有序。","book":"西汉·刘安《淮南子·兵略训》"},"usage":"作谓语、定语；用于书面语"},{"id":26148,"word":"条入叶贯","pinyin":"tiáo rù yè guàn","abbr":"tryg","explanation":"比喻深入精微，融会贯通。","source":{"text":"通人知士，虽博览古今，窥涉百家，条入叶贯，不知审知。","book":"汉·王充《论衡·薄葬》"},"usage":"作谓语；用于书面语"},{"id":26149,"word":"条分缕晰","pinyin":"tiáo fēn lǚ xī","abbr":"tflx","explanation":"缕：详尽，细致。形容分析得细密而有条理。","source":{"text":"书之门目，条分缕晰，由浅入深，由繁反约。","book":"梁启超《变法通议·论幼学》"},"similar":["条分缕析"],"usage":"作谓语、状语；指有条有理地细细分析"},{"id":26150,"word":"条分缕析","pinyin":"tiáo fēn lǚ xī","abbr":"tflx","explanation":"缕：线；析：剖析。有条有理地细细分析。","source":{"text":"说经之书甚多，以及文集说部，皆有可采。窃欲析缕分条，加以翦截。","book":"清·平步青《霞外捃屑》卷五"},"example":{"text":"凡译此类书，宜悉仿内典分析之例，～，庶易晓畅，省读者心力。","book":"清·梁启超《变法通议》"},"similar":["条分缕晰"],"usage":"作谓语、状语；指有条有理地细细分析"},{"id":26151,"word":"条分节解","pinyin":"tiáo fēn jié jiě","abbr":"tfjj","explanation":"指逐条逐节进行分析。","source":{"text":"义玄有章句学，先儒疑缪，或音故不通者，辄采诸家，条分节解，能是正之。","book":"《新唐书·崔义玄传》"},"similar":["条分缕析"],"usage":"作谓语、状语；用于书面语"},{"id":26152,"word":"条条大路通罗马","pinyin":"tiáo tiáo dà lù tōng luó mǎ","abbr":"ttdltlm","explanation":"比喻采用许多不同的方法办事，都可以收到同样的效果。","example":{"text":"～，我们不必着急。"},"similar":["殊途同归"],"usage":"作宾语、分句；指“殊途同归”"},{"id":26153,"word":"条条框框","pinyin":"tiáo tiáo kuàng kuàng","abbr":"ttkk","explanation":"被视为固定的、不能变通的条例规定。","source":{"text":"思想一僵化，条条框框就多起来了。","book":"邓小平《解放思想，实事求是，团结一致向前看》"},"example":{"text":"我们不能受这些～的束缚。"},"similar":["规规矩矩"],"usage":"作宾语、定语；指规矩"},{"id":26154,"word":"条解支劈","pinyin":"tiáo jiě zhī pī","abbr":"tjzp","explanation":"指细致部析。","source":{"text":"读书条解支劈，凿虚蹑空，旁扶曲导，必窥意理之所至。","book":"清·恽敬《舅氏清如先生墓志铭》"},"usage":"作谓语、宾语；用于书面语"},{"id":26155,"word":"条贯部分","pinyin":"tiáo guàn bù fēn","abbr":"tgbf","explanation":"指条理贯穿，部位分明。","source":{"text":"佛经说天地境界，高下阶级，悉条贯部分，叙而有章。","book":"《弘明集·正诬论》"},"usage":"作谓语、定语；用于书面语"},{"id":26156,"word":"来世不可待","pinyin":"lái shì bù kě dài","abbr":"lsbkd","explanation":"对于未来的事，不可期望等待。","source":{"text":"来世不可待，往世不可追也。","book":"《庄子·人间世》"},"usage":"作宾语、定语；用于劝诫人"},{"id":26157,"word":"来之不易","pinyin":"lái zhī bù yì","abbr":"lzby","explanation":"来之：使之来。得到它不容易。表示财物的取得或事物的成功是不容易的。","source":{"text":"一粥一饭，当思来处不易；半丝半缕，恒念物力维艰。","book":"明·朱柏庐《治家格言》"},"example":{"text":"我们活着的人都不要忘记，我们的红色江山～啊。","book":"何长工《红旗插上井冈山》"},"similar":["来处不易"],"opposite":["轻而易举"],"usage":"作主语、宾语、定语；用于事物、成绩等"},{"id":26158,"word":"来之坎坎","pinyin":"lái zhī kǎn kǎn","abbr":"lzkk","explanation":"坎：陷。比喻进退都很艰难。","source":{"text":"来之坎坎，险且枕。","book":"《周易·坎》"}},{"id":26159,"word":"来势汹汹","pinyin":"lái shì xiōng xiōng","abbr":"lsxx","explanation":"动作或事物到来的气势很厉害。","source":{"text":"那马夫一看来势汹汹，便有惧意。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"洪水虽然来势汹汹，但我们的抗洪工程安然无恙。"},"similar":["气势汹汹"],"usage":"作谓语、定语；形容气势等"},{"id":26160,"word":"来历不明","pinyin":"lái lì bù míng","abbr":"llbm","explanation":"来历：由来。人或事物的来历与经过不清楚。","source":{"text":"适新建县有阙氏者，雇一婢，来历不明。","book":"宋·周密《癸辛杂识·前集·郑仙姑》"},"example":{"text":"一时错把她认作了一个～之人，加上一番防范。","book":"清·文康《儿女英雄传》第五回"},"similar":["来路不明"],"usage":"作谓语、定语；指不清楚底细"},{"id":26161,"word":"来去分明","pinyin":"lái qù fēn míng","abbr":"lqfm","explanation":"形容手续清楚或为人在财物方面不含糊。","source":{"text":"那时叫世人知我冰清玉洁，来去分明，也原谅我这不守闺门是出于万分无奈，不曾玷辱门庭。","book":"清·文康《儿女英雄传》第二十一回"},"example":{"text":"不忘故主，～，真是天下第一义士。","book":"蔡东藩《后汉演义》第七十九回"},"usage":"作谓语、定语；指手续清楚"},{"id":26162,"word":"来去匆匆","pinyin":"lái qù cōng cōng","abbr":"lqcc","explanation":"形容来和去迅速。","source":{"text":"也许他们在那条街就曾见过面，但来去匆匆，或淡然一瞥或偶一回眸。","book":"王朔《许爷》"},"example":{"text":"我们只不过是世上～的过客罢了。"},"similar":["来去无踪"],"usage":"作定语；形容来和去迅速","story":["周国大将黄飞虎被敌将陈桐施放的火龙镖打死，青峰山紫阳洞的清虚道德真君命黄飞虎的儿子黄天化下山施救。黄天化赶到潼关救活父亲，用花篮收掉陈桐的兵器，用神剑杀死陈桐，然后就回青峰山，黄飞虎十分感激这个来去匆匆的儿子"]},{"id":26163,"word":"来去无踪","pinyin":"lái qù wú zōng","abbr":"lqwz","explanation":"踪：脚印。来时去时都看不见踪影。形容出没极为迅速或隐秘。","source":{"text":"拿着一条不短不长的金箍棒，来无影，去无踪。","book":"明·吴承恩《西游记》第八十一回"},"example":{"text":"他岂不又有枝添叶儿，必说这妖怪青脸红发，～。","book":"清·石玉昆《三侠五义》第六十一回"},"similar":["来无影，去无踪"],"usage":"作谓语、定语；指出没无常"},{"id":26164,"word":"来回来去","pinyin":"lái huí lái qù","abbr":"lhlq","explanation":"指动作或说话来回不断地重复。","example":{"text":"他～还是重复那几句话。"},"similar":["翻来覆去"],"usage":"作状语；用于口语"},{"id":26165,"word":"来因去果","pinyin":"lái yīn qù guǒ","abbr":"lyqg","explanation":"指事情的来龙去脉。","source":{"text":"领会是‘心领神会’，不仅懂得文件的意义，而且懂得文件的来因去果。","book":"谢觉哉《不惑集·领会》"},"example":{"text":"我们要弄清楚这件事情的～。"},"similar":["来龙去脉"],"usage":"作宾语；指事情的原委"},{"id":26166,"word":"来处不易","pinyin":"lái chù bù yì","abbr":"lcby","explanation":"表示事情的成功或财物的取得，经过了艰苦努力。","source":{"text":"一粥一饭，当思来处不易；半丝半缕，恒念物力维艰。","book":"清·朱柏庐《治家格言》"},"example":{"text":"年轻人对于今天的美好生活当思～。"},"similar":["来之不易"],"opposite":["召之即来"],"usage":"作宾语；用于劝诫人"},{"id":26167,"word":"来好息师","pinyin":"lái hǎo xī shī","abbr":"lhxs","explanation":"招致和好，停止战争。"},{"id":26168,"word":"来往如梭","pinyin":"lái wǎng rú suō","abbr":"lwrs","explanation":"梭：织布机上的梭子。来去不停，象织布机上的梭子似的。形容来往频繁。","source":{"text":"云何。当此去，人生底事，来往如梭。待闲看秋风，洛水清波。","book":"宋·苏轼《满庭芳》词"},"example":{"text":"对芳尊浅酌低唱，且酩酊。任他两轮日月，～。","book":"金·元好问《双调·骤雨打新荷》"}},{"id":26169,"word":"来情去意","pinyin":"lái qíng qù yì","abbr":"lqqy","explanation":"事情的内容和原因。","source":{"text":"当下戴院长与宋公明说罢了来情去意。","book":"明·施耐庵《水浒传》第38回"},"example":{"text":"请把事情的～说清楚。"},"similar":["来龙去脉"],"usage":"作宾语；指事情的内容和原因"},{"id":26170,"word":"来无影，去无踪","pinyin":"lái wú yǐng，qù wú zōng","abbr":"lwyqwz","explanation":"踪：脚印。来时去时都看不见踪影。形容出没极为迅速或隐秘。","source":{"text":"拿着一条不短不长的金箍棒，来无影，去无踪。","book":"明·吴承恩《西游记》第81回"},"similar":["来去无踪"],"usage":"作谓语、定语、分句；指出没无常"},{"id":26171,"word":"来日大难","pinyin":"lái rì dà nàn","abbr":"lrdn","explanation":"表示前途困难重重。","source":{"text":"来日大难，口燥唇干。","book":"南宋·郭茂倩《乐府诗集·善哉行》"},"example":{"text":"～居不易，痴聋须效阿家翁。","book":"李云夔《送李晦庵之燕》诗"},"usage":"作宾语；表示前途困难重重"},{"id":26172,"word":"来日方长","pinyin":"lái rì fāng cháng","abbr":"lrfc","explanation":"来日：未来的日子；方：正。将来的日子还长着呢。表示事有可为或将来还有机会。","source":{"text":"某到郡后，颇与郡人相安，日来四境无虞，早收中熟，觉风雪如期，晚稻亦可望，惟是力绵求牧，来日方长。","book":"宋·文天祥《与洪端明云岩书》"},"example":{"text":"前途似海，～。","book":"清·梁启超《少年中国说》"},"similar":["前途无量","鹏程万里"],"opposite":["日暮途穷","日薄西山"],"usage":"作谓语、定语；表示展望未来"},{"id":26173,"word":"来日正长","pinyin":"lái rì zhèng cháng","abbr":"lrzz","explanation":"将来的日子还长着呢。表示事有可为或将来还有机会。","source":{"text":"来日正长，不要贪图现在就卖掉了未来。","book":"巴金《雨》"},"similar":["来日方长"],"opposite":["日薄西山"],"usage":"作谓语、定语；表示展望未来"},{"id":26174,"word":"来是是非人，去是是非者","pinyin":"lái shì shì fēi rén，qù shì shì fēi zhě","abbr":"lssfrqssfz","explanation":"犹言解铃还是系铃人。指谁惹起的是非，还得由谁来了结。","source":{"text":"来是是非人，去是是非者，把那淫妇教他领了去，变卖嫁人。","book":"明·兰陵笑笑生《金瓶梅词话》第八十六回"},"example":{"text":"我还有个主意，～，这个还得我了才好。","book":"清·曹雪芹《红楼梦》第六十八回"},"usage":"作宾语、定语；用于书面语"},{"id":26175,"word":"来来去去","pinyin":"lái lái qù qù","abbr":"llqq","explanation":"来和去。指往来不断的样子。","source":{"text":"这里接连着亲戚族中的人来来去去，闹闹穰穰，车马填门，貂蝉满座，真是：花到正开蜂蝶闹，月逢十足海天宽。","book":"清·曹雪芹《红楼梦》第85回"},"example":{"text":"余华《活着》：“他坐在坑道外的土墩上吸着烟，看着那些～的黄皮大兵。”"},"similar":["来来往往"],"usage":"作谓语、定语、状语、宾语；用于来往"},{"id":26176,"word":"来来往往","pinyin":"lái lái wǎng wǎng","abbr":"llww","explanation":"指多次来和去交往。","source":{"text":"两个在阵前，来来往往，番番复复，搅做一团，扭做一块。","book":"明·施耐庵《水浒传》第13回"},"example":{"text":"只见街坊上～，许多人挤在间壁一个庵院门首，尉迟南问土人为着何事。","book":"清·褚人获《隋唐演义》第63回"},"similar":["来来去去"],"usage":"作定语、状语；多用于口语"},{"id":26177,"word":"来者不善","pinyin":"lái zhě bù shàn","abbr":"lzbs","explanation":"善：亲善，友好。强调来人不怀好意，要警惕防范。","source":{"text":"善者不辩，辩者不善。","book":"《老子》"},"example":{"text":"“～，善者不来”，亦本《老子》“善者不辩，辩者不善”句。","book":"清·赵翼《陔余丛考·成语》"},"similar":["来者不善，善者不来"],"usage":"作谓语、宾语；强调来人不怀好意"},{"id":26178,"word":"来者不善，善者不来","pinyin":"lái zhě bù shàn，shàn zhě bù lái","abbr":"lzbsszbl","explanation":"来的不怀善意，有善意的不会来。","source":{"text":"‘来者不善，善者不来’，亦本《老子》‘善者不辩，辩者不善’句。","book":"清·赵翼《陔余丛考·成语》"},"example":{"text":"纪颖川听说潘一豹来请他，心想：～。他连眼皮也没有抬。","book":"陈登科《赤龙与丹凤》"},"similar":["来者不善","一呼百应"],"usage":"作谓语、补语、分句；指来的人不是善良的"},{"id":26179,"word":"来者不拒","pinyin":"lái zhě bù jù","abbr":"lzbj","explanation":"拒：拒绝。对于有所求而来的人或送上门来的东西概不拒绝。","source":{"text":"夫子之设科也，往者不追，来者不拒。","book":"《孟子·尽心下》"},"example":{"text":"弟子就学者不知多少，先生来者不拒，去者不追。","book":"明·冯梦龙《东周列国志》第八十七回"},"similar":["有求必应"],"opposite":["拒之门外"],"usage":"作谓语、定语、状语；指收受礼品等"},{"id":26180,"word":"来者勿拒","pinyin":"lái zhě wù jù","abbr":"lzwj","explanation":"对于有所求而来的人或送上门来的东西概不拒绝。同“来者不拒”。","source":{"text":"来者勿拒，去者勿追。","book":"《公羊传·隐公二年》：“公会戎于潜”汉·何休注"},"similar":["来者不拒"],"opposite":["拒之门外"],"usage":"作谓语、定语；指收受礼品等"},{"id":26181,"word":"来者勿禁","pinyin":"lái zhě wù jìn","abbr":"lzwj","explanation":"对归来的人不禁止。表示听人自愿。","source":{"text":"来者勿禁，往者勿止。","book":"《庄子·山木》"}},{"id":26182,"word":"来者可追","pinyin":"lái zhě kě zhuī","abbr":"lzkz","explanation":"可追：可以补救。过去的事已无法挽回，但是未来的事还来得及赶上。","source":{"text":"往者不可谏，来者犹可追。","book":"春秋·鲁·孔丘《论语·微子》"},"example":{"text":"辨之不早，嗟已迫于桑榆；～，幸未填于沟壑。","book":"宋·秦观《代蕲州守谢上表》"},"similar":["亡羊补牢"],"usage":"作谓语；指以后的事还来得及补救"},{"id":26183,"word":"来者居上","pinyin":"lái zhě jū shàng","abbr":"lzjs","explanation":"后来居上。原指资格浅的新进反居资格老的旧臣之上。后亦用以称赞后起之秀超过前辈。","source":{"text":"陛下用群臣如积薪耳，后来者居上。","book":"语出《史记·汲郑列传》"},"example":{"text":"陈人束阁，让他～。","book":"宋·刘克庄《念奴娇·丙寅生日》词"},"similar":["后来居上"],"usage":"作谓语、定语；指后者胜前者"},{"id":26184,"word":"来而不往非礼也","pinyin":"lái ér bù wǎng fēi lǐ yě","abbr":"lebwfly","explanation":"表示对别人施加于自己的行动将作出反应。","source":{"text":"礼尚往来，往而不来，非礼也；来而不往，亦非礼也。","book":"西汉·戴圣《礼记·曲礼上》"},"example":{"text":"～，我们还是应该去看看他。"},"similar":["礼尚往来"],"usage":"作宾语、分句；用于人际交往"},{"id":26185,"word":"来苏之望","pinyin":"lái sū zhī wàng","abbr":"lszw","explanation":"苏：苏息。从疾苦中获得休养生息的希望。","source":{"text":"四海望中兴之美，群生怀来苏之望。","book":"《尚书·仲虺之诰》：“予后，后来其苏。”晋·刘琨《劝进表》"},"example":{"text":"吏无抚治之方，人鲜～。","book":"蔡东藩、许廑父《民国通俗演义》第九十八回"}},{"id":26186,"word":"来路不明","pinyin":"lái lù bù míng","abbr":"llbm","explanation":"来历未验明。","source":{"text":"据他说，他总爷这个钱来路很不明白。","book":"清·李宝嘉《官场现形记》第15回"},"example":{"text":"他们有～的情报。"},"similar":["来历不明"],"usage":"作谓语、定语；指不明的出处"},{"id":26187,"word":"来踪去路","pinyin":"lái zōng qù lù","abbr":"lzql","explanation":"指人的来去行踪。同“来踪去迹”。","source":{"text":"如今我竟要求你的大笔，把我的来踪去路，实打实有一句说一句，给我说这么一篇。","book":"清·文康《儿女英雄传》第三十二回"},"similar":["来踪去迹"],"usage":"作宾语；用于人或事物"},{"id":26188,"word":"来踪去迹","pinyin":"lái zōng qù jì","abbr":"lzqj","explanation":"指人的来去行踪。","source":{"text":"文武衙门都瞧了，来踪去迹也看了，尸也验了。","book":"清·曹雪芹《红楼梦》第一百十二回"},"example":{"text":"袁伯珍问明了他的～，才晓得他也是维新一派的人。","book":"清·无名氏《官场维新记》第二回"},"similar":["来龙去脉","来踪去路"],"usage":"作宾语；用于人或事物"},{"id":26189,"word":"来轸方遒","pinyin":"lái zhěn fāng qiú","abbr":"lzfq","explanation":"轸：古代车后的横木，指称车子；方：正；遒：健，有力。相继而来的车子正在有力地行进。比喻人事的先后相继不断。","source":{"text":"往车虽折，而来轸方遒。","book":"《后汉书·左雄等传论》"},"example":{"text":"则政府自必一秉夙诚，力图斡济，～，泯棼何极！","book":"蔡东藩、许廑父《民国通俗演义》第一百七回"},"usage":"作宾语、定语；用于比喻句"},{"id":26190,"word":"来迎去送","pinyin":"lái yíng qù sòng","abbr":"lyqs","explanation":"来者迎之，去者送之。","source":{"text":"长安东灞陵有桥，来迎去送皆至此桥，为离别之地，故人呼之‘销魂桥’。","book":"五代·王仁裕《开元天宝遗事·销魂桥》"},"example":{"text":"她在单位干～的工作。"},"similar":["迎来送往"],"usage":"作主语、宾语、定语；指接待"},{"id":26191,"word":"来鸿去燕","pinyin":"lái hóng qù yàn","abbr":"lhqy","explanation":"比喻行踪漂泊不定的人。","source":{"text":"来鸿去燕江干路，露宿风飞各朝暮。","book":"清·黄景仁《稚存从新安归作此寄之》诗"},"example":{"text":"如何窈窕如花女，也学～飞。","book":"清·魏秀仁《花月痕》第26回"},"usage":"作宾语、定语；指相互联系"},{"id":26192,"word":"来龙去脉","pinyin":"lái lóng qù mài","abbr":"llqm","explanation":"本指山脉的走势和去向。现比喻一件事的前因后果。","source":{"text":"此间前冈有块好地，来龙去脉，靠岭朝山，处处合格。","book":"明·吾邱瑞《运甓记·牛眠指穴》"},"example":{"text":"焦裕录严肃地说：“要弄清它的～，打垮它、制服它。”","book":"峻青《焦裕录的光辉》"},"similar":["有头有尾","前因后果","一脉相承"],"opposite":["有始无终","有头无尾"],"usage":"作主语、宾语；用于事件描述"},{"id":26193,"word":"杨朱泣岐","pinyin":"yáng zhū qì qí","abbr":"yzqq","explanation":"常引作典故，用来表达对世道崎岖，担心误入歧途的感伤忧虑，或在歧路的离情别绪。","source":{"text":"《荀子·王霸》：“杨朱哭衢途曰：‘此夫过举蹞步而觉跌千里者夫！’哀哭之。”谓在十字路口错走半步，到觉悟后就已经差之千里了，杨朱为此而哭泣。"}},{"id":26194,"word":"杨朱泣歧","pinyin":"yáng zhū qì qí","abbr":"yzqq","explanation":"杨朱：人名。杨朱在十字路口哭泣。指对别人误入歧途而感伤","source":{"text":"杨朱哭衢途：‘此夫过举蹞步而觉跌千里者夫！’","book":"战国·赵·荀况《荀子·王霸》"},"example":{"text":"五代·李瀚《蒙求》诗：“墨子悲丝，～。”"},"usage":"作宾语、定语；用于书面语"},{"id":26195,"word":"杨柳依依","pinyin":"yáng liǔ yī yī","abbr":"ylyy","explanation":"杨柳：古诗文中杨柳通用，泛指柳树。依依：轻柔的样子。古人送行，折柳相赠，表示依依惜别。比喻依依不舍的惜别之情。","source":{"text":"昔我往矣，杨柳依依。","book":"《诗经·小雅·采薇》"},"example":{"text":"～，何日文箫共驾归。","book":"宋·张孝祥《丑奴儿》词"}},{"id":26196,"word":"杨柳宫眉","pinyin":"yáng liǔ gōng méi","abbr":"ylgm","explanation":"细长秀美如柳叶的宫妆画眉。借指美女。","source":{"text":"杨柳宫眉，桃花人面，是平生未了缘。","book":"元·刘致《朝天子·同文子方邓永年泛洞庭湖宿凤凰台下》曲"},"usage":"作宾语、定语；指美女"},{"id":26197,"word":"杨生黄雀","pinyin":"yáng shēng huáng què","abbr":"yshq","explanation":"以之为报恩典实。同“杨雀衔环”。","source":{"text":"杨生黄雀，毛子白龟。","book":"唐·李瀚《蒙求》诗"},"similar":["杨雀衔环"],"usage":"作宾语、定语；用于书面语"},{"id":26198,"word":"杨穿三叶","pinyin":"yáng chuān sān yè","abbr":"ycsy","explanation":"原指射技高超。也比喻兄弟三人相继科举及第。","source":{"text":"楚有养由基者，善射，去柳叶者百步而射之，百发百中。","book":"《战国策·西周策》"},"example":{"text":"唐·白居易《喜敏中及第偶示所怀》诗：“自知群从为儒少，岂料词场中第频。桂折一枝先许我，～尽惊人。”"},"usage":"作宾语、定语；用于书面语"},{"id":26199,"word":"杨花心性","pinyin":"yáng huā xīn xìng","abbr":"yhxx","explanation":"比喻轻薄浪漫，用情不专。","source":{"text":"［富净］榆叶当不得钱使，那滚地杨花怎吃我当了锦褥眠。［净］虽则杨花心性，你也睡不稳些。","book":"明·孙柚《琴心记·当垆市中》"},"example":{"text":"为风流招愆惹眚，这来人言语难凭，你～浑无定。","book":"明·汪廷讷《狮吼记·奇妒》"},"similar":["杨花水性"],"usage":"作谓语、定语；多用于女性"},{"id":26200,"word":"杨花水性","pinyin":"yáng hu huǐ xìng","abbr":"yhsx","explanation":"柳絮飘扬，水性流动，因以“杨花水性”比喻轻薄女子等用情不专。","source":{"text":"不过瞿耐庵惧内得很，一直不敢接他上任。那爱珠又是堂子里出身，杨花水性。","book":"清·李宝嘉《官场现形记》第四十三回"},"example":{"text":"清·李宝嘉《官场现形记》第43回：“那爱珠又是堂子里出身，～。”"},"similar":["水性杨花"],"opposite":["忠贞不渝","从一而终"],"usage":"作谓语、宾语、定语；用于女性"},{"id":26201,"word":"杨虎围匡","pinyin":"yáng hǔ wéi kuāng","abbr":"yhwk","explanation":"杨，通“阳”。指因貌似而产生误会。","source":{"text":"扞孔子呴将适陈，过匡……匡人闻之，以为鲁之阳虎。阳虎尝暴匡人，匡人于是遂止孔子。孔子状类阳虎，拘焉五日。","book":"《史记·孔子世家》"},"example":{"text":"明·梅鼎祚《昆仑奴》第三折：“你见鬼了，是什么崔千牛与你家红绡，那些似～，空省识明妃画像。”"},"usage":"作宾语、定语；用于书面语"},{"id":26202,"word":"杨雀衔环","pinyin":"yáng què xián huán","abbr":"yqxh","explanation":"以之为报恩典实。","source":{"text":"南朝·梁·吴均《续齐谐记》载，东汉弘农人杨宝少时救了一只黄雀，后有一黄衣童子送白环四枚相报，谓当使其子孙显贵，位登三公。"},"similar":["杨生黄雀"],"usage":"作宾语、定语；用于书面语","story":["东汉弘农人杨宝少年时曾经救过一只受伤的小黄雀，小黄雀伤好后飞走了。后来有一个黄衣童子送来四枚白玉环给他，并对他说他的子孙将来会很有出息，登上三公之位"]},{"id":26203,"word":"杯中之物","pinyin":"bēi zhōng zhī wù","abbr":"bzzw","explanation":"杯子中的东西，指酒。同“杯中物”。","source":{"text":"有一顿，没一顿，都不计较，单少不得杯中之物。","book":"明·冯梦龙《古今小说·穷马周遭际卖塠媪》"},"example":{"text":"他最喜欢～。"},"similar":["杯中物"],"usage":"作主语、宾语、定语；指酒"},{"id":26204,"word":"杯中物","pinyin":"bēi zhōng wù","abbr":"bzw","explanation":"杯子中的东西，指酒。","source":{"text":"天运苟如此，且进杯中物。","book":"晋·陶潜《责子》诗"},"example":{"text":"赖有～，还同海上鸥。","book":"唐·杜甫《巴西驿亭观江涨》诗"},"similar":["杯中之物"],"usage":"作主语、宾语、定语；指酒"},{"id":26205,"word":"杯中蛇影","pinyin":"bēi zhōng shé yǐng","abbr":"bzsy","explanation":"比喻因疑神疑鬼而引起恐惧。同“杯弓蛇影”。","source":{"text":"杯中蛇影，自起猜疑；塞翁失马，难分祸福。龙驹凤雏，晋闵鸿夸吴中陆士龙之异；伏龙凤雏，司马徽称孔明庞士元之奇。","book":"明·程登吉《幼学琼林·鸟兽》"},"example":{"text":"～，《世说》以为乐广事，《风俗通》以为主簿杜宣事。","book":"清·袁枚《随园随笔·古书所载不同》"},"similar":["杯弓蛇影","杯影蛇弓"],"opposite":["安之若泰","谈笑自若"],"usage":"作宾语、定语；比喻把虚幻误作真实"},{"id":26206,"word":"杯圈之思","pinyin":"bēi quān zhī sī","abbr":"bqzs","explanation":"杯圈：古代指妇女所用的杯。指思念去世的母亲。","source":{"text":"母没而杯圈不能饮焉，口泽之气存焉尔。","book":"《礼记·玉藻》"},"usage":"作宾语；指思念亡母"},{"id":26207,"word":"杯弓市虎","pinyin":"bēi gōng shì hǔ","abbr":"bgsh","explanation":"指捕风捉影，疑虑重重，自相惊扰。参见“杯弓蛇影”、“三人成虎”。","source":{"text":"同时传来上海有罢市之说，以致杯弓市虎，危机伺伏，人心恐惶，险状万分。","book":"詧盦《学界风潮记·天津商学界之活动》"},"similar":["捕风捉影"],"usage":"作宾语、定语；指自相惊扰"},{"id":26208,"word":"杯弓蛇影","pinyin":"bēi gōng shé yǐng","abbr":"bgsy","explanation":"将映在酒杯里的弓影误认为蛇。比喻因疑神疑鬼而引起恐惧。","source":{"text":"时北壁上有悬赤弩照于杯，形如蛇。宣畏恶之，然不敢不饮。","book":"汉·应劭《风俗通义·世间多有见怪》"},"example":{"text":"金玦厖凉含隐痛，～负奇冤。","book":"清·黄遵宪《感事》诗"},"similar":["草木皆兵","疑神疑鬼","风声鹤唳"],"opposite":["处之泰然","安之若泰","谈笑自若"],"usage":"作宾语、定语；比喻把虚幻误作真实","story":["晋朝河南人乐广十分好客，见一朋友好久不来家里，十分奇怪，就去拜会他，朋友说上次在你家喝酒杯中有蛇，喝后回来后就生病。乐广不解，回到家便查原因，原来是挂在墙上的角弓影子倒射在酒杯所至，朋友闻知后就病愈"]},{"id":26209,"word":"杯影蛇弓","pinyin":"bēi yǐng shé gōng","abbr":"bysg","explanation":"比喻因疑神疑鬼而引起恐惧。同“杯弓蛇影”。","source":{"text":"杯影蛇弓魔人幻，帷灯匣剑鬼生疑。","book":"清·魏秀仁《花月痕》第四十五回"},"similar":["杯弓蛇影"],"opposite":["处之泰然"],"usage":"作谓语、定语；比喻把虚幻误作真实"},{"id":26210,"word":"杯残炙冷","pinyin":"bēi cán zhì lěng","abbr":"bczl","explanation":"炙：烤肉。指残剩的饭菜。也指权贵施舍的东西。","source":{"text":"杯残炙冷正悲辛，仗内斗鸡催赐锦。","book":"宋·陆游《题少陵画像》诗"},"similar":["残杯冷炙"],"opposite":["山珍海味"],"usage":"作主语、宾语、定语；指残剩的酒肉"},{"id":26211,"word":"杯水之敬","pinyin":"bēi shuǐ zhī jìng","abbr":"bszj","explanation":"犹言杯水之谢。","source":{"text":"孔耘轩道：‘小婿业师惠人老，原是弟说成的，今上学已经两月，弟尚无杯水之敬，所以（备筵）并请三位陪光。’","book":"《歧路灯》第三八回"},"similar":["杯水之谢"],"usage":"作宾语；指微薄的酬谢"},{"id":26212,"word":"杯水之谢","pinyin":"bēi shuǐ zhī xiè","abbr":"bszx","explanation":"比喻微薄的酬谢。","source":{"text":"次日，凤四老爹果然别了万中书，不曾受他杯水之谢，取路往杭州去了。","book":"《儒林外史》第五一回"},"similar":["杯水之敬"],"usage":"作宾语；指微薄的酬谢"},{"id":26213,"word":"杯水之饯","pinyin":"bēi shuǐ zhī jiàn","abbr":"bszj","explanation":"饯：送别。用一杯水为人送行。旧指官吏洁身自好，廉洁奉公。","source":{"text":"赵轨为齐州别驾，诏入朝，行之日，父老挥涕送之曰：‘公清如水，请酌一杯水以奉饯。’","book":"《隋史·赵轨传》"}},{"id":26214,"word":"杯水粒粟","pinyin":"bēi shuǐ lì sù","abbr":"bsls","explanation":"一杯水，一粒粟。指极少量的饮食。","source":{"text":"虽逾旬涉月，杯水粒粟无所须。喜饮酒，好作诗，行年六十，而颜色如壮者。","book":"宋·洪迈《夷坚丙志·张拱遇仙》"},"opposite":["山珍海味","大吃大喝"],"usage":"作主语、宾语、定语；指极少量的饮食"},{"id":26215,"word":"杯水舆薪","pinyin":"bēi shuǐ yú xīn","abbr":"bsyx","explanation":"比喻力量微小，无济于事。同“杯水车薪”。","source":{"text":"杯水舆薪，势且莫抗。","book":"宋·曹辅《唐颜文忠公新庙记》"},"similar":["杯水车薪"],"opposite":["绰绰有余"],"usage":"作谓语、宾语、分句；指力量小不能解决问题"},{"id":26216,"word":"杯水车薪","pinyin":"bēi shuǐ chē xīn","abbr":"bscx","explanation":"用一杯水去救一车着了火的柴草。比喻力量太小，解决不了问题。","source":{"text":"今之为人者，犹以一杯水救一车薪之火也。","book":"《孟子·告子上》"},"example":{"text":"有新债未动毫分的，除了承许夏鼎三十两外，大有～之状。","book":"清·李绿园《歧路灯》第七十四回"},"similar":["杯水救薪","无济于事"],"opposite":["力济九区","绰绰有余","立杆见影"],"usage":"作谓语、宾语、分句；指力量小不能解决问题","story":["从前有一个樵夫在山上打柴，听到救火声就跑去救火。后来他的柴车也着了火，正好看到路边有一个杯子，就拿杯子跑到河边去装水来救火，但火势太大，一杯水根本就是无济于事，一整车柴全部被烧毁"]},{"id":26217,"word":"杯盘狼籍","pinyin":"bēi pán láng jí","abbr":"bplj","explanation":"杯盘等放得乱七八糟。形容宴饮已毕或将毕时的情景","source":{"text":"乃入室阖户以窥之，而杯盘狼籍，不暇收拾。","book":"唐·无名氏《韦鲍二生传》"},"example":{"text":"清·俞万春《荡寇志》第84回：“万俟兄弟正同众宾客～，猜拳行令，吃得快活。”"},"similar":["杯盘狼藉"],"opposite":["井井有条"],"usage":"作谓语、定语；形容酒饭后的杂乱样子"},{"id":26218,"word":"杯盘狼藉","pinyin":"bēi pán láng jí","abbr":"bplj","explanation":"杯盘等放得乱七八糟。形容宴饮已毕或将毕时的情景。","source":{"text":"见“杯盘狼藉”。"},"example":{"text":"[美娘]醉眼朦胧，看见房中灯烛辉煌，～。","book":"《醒世恒言·卖油郎独占花魁》"},"similar":["杂乱无章","乱七八糟"],"opposite":["井然有序","井井有条"],"usage":"作谓语、定语；形容酒饭后的杂乱样子"},{"id":26219,"word":"杯羹之让","pinyin":"bēi gēng zhī ràng","abbr":"bgzr","explanation":"指受人挟持，惹人讥诮。","source":{"text":"吾与项羽俱北面受命怀王，曰‘约为兄弟’，吾翁即若翁，必欲烹而翁，则幸分我一桮羹。","book":"《史记·项羽本纪》载，楚汉相争，汉军断绝楚军粮草，项羽把刘邦的父亲放在高高的肉案上，对刘邦说：“今不急下，吾烹太公。”刘邦说"}},{"id":26220,"word":"杯茗之敬","pinyin":"bēi míng zhī jìng","abbr":"bmzj","explanation":"请人饮宴的谦辞。","source":{"text":"吴之和对唐敖、多九公道：‘二位大贤由天朝至此，小子谊属地主，意欲略展杯茗之敬，少叙片时，不知可肯枉驾？’","book":"《镜花缘》第十一回"},"usage":"作宾语；指请人喝茶"},{"id":26221,"word":"杯蛇幻影","pinyin":"bēi shé huàn yǐng","abbr":"bshy","explanation":"比喻疑神疑鬼，自相惊扰。同“杯弓蛇影”。","source":{"text":"杯蛇幻影，鬼蜮含沙。萦愁绪以回肠，蔓牵瓜落；拭泪珠而洗面，藕断丝长。","book":"《花月痕》第五回"},"similar":["杯弓蛇影"],"usage":"作宾语、定语；指自相惊扰"},{"id":26222,"word":"杯蛇鬼车","pinyin":"bēi shé guǐ chē","abbr":"bsgc","explanation":"指因疑虑、惊惧导致幻觉中产生的怪物。杯蛇，“杯弓蛇影”之省；鬼车，传说中的九头鸟。","source":{"text":"况我兵惊恐，凡杯蛇鬼车，风兵草甲，无往非撼志之物。","book":"《水浒传》第九五回"},"similar":["风兵草甲"],"usage":"作宾语、定语；指幻觉"},{"id":26223,"word":"杯觥交杂","pinyin":"bēi gōng jiāo zá","abbr":"bgjz","explanation":"觥：酒器；交：交织。形容酒宴中相互频频举杯畅饮的热烈气氛。","source":{"text":"满坐芳香，馥馥袭人，宾主酬酢，杯觥交杂。","book":"明·冯梦龙《醒世恒言》第四卷"},"similar":["杯觥交错"],"usage":"作定语、状语；形容聚餐热闹场面"},{"id":26224,"word":"杯觥交错","pinyin":"bēi gōng jiāo cuò","abbr":"bgjc","explanation":"比喻相聚饮酒时的欢乐。觥，酒器。","source":{"text":"射者中，弈者胜，觥筹交错，坐起而喧哗者，众宾欢也。","book":"宋·欧阳修《醉翁亭记》"},"example":{"text":"近30年未见的几个老同学齐聚一堂，～，乐不可支。"},"similar":["杯觥交杂"],"usage":"作定语、状语；形容聚餐热闹场面"},{"id":26225,"word":"杯酒戈矛","pinyin":"bēi jiǔ gē máo","abbr":"bjgm","explanation":"比喻在宴会上引起的仇恨。","source":{"text":"《负曝闲谈》第二十五回：“就是有天在吴侍郎席上他请教我我没有理他那个人，这真是杯酒戈矛了！"},"example":{"text":"三日倾轧性，彼此相阋，各欲得而甘心，～，顷刻倚伏也。","book":"梁启超《新民说·论私德》"},"usage":"作宾语、定语、补语；指酒桌上的纠纷"},{"id":26226,"word":"杯酒解怨","pinyin":"bēi jiǔ jiě yuàn","abbr":"bjjy","explanation":"解：消除，排解；怨：怨恨，怨仇。指饮酒言欢，消解仇怨。","source":{"text":"吾武夫虽有旧恶，杯酒间可解。","book":"《新唐书·张延赏传》"},"example":{"text":"～的方式现在还在使用。"},"similar":["杯酒言欢"],"usage":"作谓语、定语；指通过饮酒消除嫌隙"},{"id":26227,"word":"杯酒言欢","pinyin":"bēi jiǔ yán huān","abbr":"bjyh","explanation":"相聚饮酒，欢快地交谈。","source":{"text":"然而军阀们也不是自己亲身在斗争，是使兵士们相斗争，所以频年恶战，而头儿个个终于是好好的，忽而误会消释了，忽而杯酒言欢了，忽而共同御侮了，忽而立誓报国了，忽而……。","book":"鲁迅《伪自由书·观斗》"},"example":{"text":"我们还是～，重修旧好。"},"similar":["杯酒解怨"],"usage":"作谓语、宾语；用于交往"},{"id":26228,"word":"杯酒释兵权","pinyin":"bēi jiǔ shì bīng quán","abbr":"bjsbq","explanation":"释：解除。本指在酒宴上解除将领的兵权。泛指轻而易举地解除将领的兵权。","source":{"text":"宋太祖赵匡胤为了防止出现分裂割据的局面，加强中央集权统治，以高官厚禄为条件，解除将领们的兵权。"},"example":{"text":"你听说过赵匡胤的“～”的故事吗？"},"usage":"作宾语、定语；用于政治斗争","story":["公元961年，宋太祖赵匡胤与赵普商定计策，召集禁军将领石守信、王审琦等宴饮，以高官厚禄为条件，解除他们的兵权。969年，又用同样手段，罢王彦超等节度使，解除藩镇兵权，以加强中央集权的统治，防止分裂割据"]},{"id":26229,"word":"杳不可得","pinyin":"yǎo bù kě dé","abbr":"ybkd","explanation":"没有一点消息。","source":{"text":"岛忽吟曰：‘落叶满长安’，志重其冲口直致，求之一联，杳不可得，不知身之所从也。","book":"五代·王定保《唐摭言·无官受黜》"},"example":{"text":"不肖夜来望气，知有异人在于贵县。求之市中数日，～。","book":"明·冯梦龙《喻世明言》卷二十一"},"similar":["杳无音信","杳无信息","杳无消息"],"usage":"作谓语、定语；指没有一点儿音信"},{"id":26230,"word":"杳不可闻","pinyin":"yǎo bù kě wén","abbr":"ybkw","explanation":"再也听不到。形容声音断绝。","source":{"text":"谁知秦敬宇在家，这孙兰姬别要说见他的影响，你就再要听他声咳嗽也杳不可闻。","book":"清·西周生《醒世姻缘传》第五十回"},"usage":"作谓语、定语；用于书面语"},{"id":26231,"word":"杳如黄鹤","pinyin":"yǎo rú huáng hè","abbr":"yrhh","explanation":"杳：无影无声；黄鹤：传说中仙人所乘的鹤。原指传说中仙人骑着黄鹤飞去，从此不再回来。现比喻无影无踪或下落不明。","source":{"text":"黄鹤一去不复返，白云千载空悠悠。","book":"南朝梁·任昉《述异记》：“荀瓌憩江夏黄鹤楼上，望西南有物飘然降自云汉，乃驾鹤之宾也。宾主欢对辞去，跨鹤腾空，眇然烟灭。”唐·崔灏《黄鹤楼》诗"},"example":{"text":"“昨天局长到了没有？”“还是～。”","book":"鲁迅《彷徨·弟兄》"},"similar":["杳无音信","无影无踪","泥牛入海"],"opposite":["捷报频传"],"usage":"作谓语、定语；指下落不明","story":["传说读书人荀瑰游览武昌，到黄鹤楼上休息，迷迷糊糊看见飘然而下一个人，他骑着仙鹤落在黄鹤楼上，他很有儒雅风度，两人把酒论诗，谈得十分投机。不一会儿已是酒酣耳热，那人跨上黄鹤，黄鹤振翅飞上天空而去"]},{"id":26232,"word":"杳无人烟","pinyin":"yǎo wú rén yān","abbr":"ywry","explanation":"僻远无人居住。形容荒凉，偏僻。","source":{"text":"师兄差疑了，似这杳无人烟之处，又无个怪兽妖禽，怕他怎的。","book":"明·吴承恩《西游记》第64回"},"example":{"text":"这儿～，得提防动物来犯。"},"similar":["荒无人烟"],"usage":"作谓语、定语；指地方偏僻荒凉"},{"id":26233,"word":"杳无人迹","pinyin":"yǎo wú rén jì","abbr":"ywrj","explanation":"杳：不见踪影；迹：脚印。连一个人的脚印也看不到。形容地方非常荒凉、偏僻，从来没有人去过。","source":{"text":"至明年春，绍复至此，但见红花翠竹，流水青山，杳无人迹。绍乃号恸经日而返。","book":"唐·常沂《灵鬼志·郑绍》"},"example":{"text":"穿过小亭，有秋千一架，上与云齐；而罥索沉沉，～。","book":"清·蒲松龄《聊斋志异·西湖主》"},"similar":["荒无人烟"],"usage":"作谓语、定语；用于书面语"},{"id":26234,"word":"杳无信息","pinyin":"yǎo wú xìn xī","abbr":"ywxx","explanation":"一直得不到一点消息。","source":{"text":"一从卢郎征西，杳无信息，不知彼中征战若何。","book":"明·汤显祖《邯郸记》第十八出"},"example":{"text":"自这一去，～。","book":"明·凌濛初《二刻拍案惊奇》卷十四"},"similar":["杳无消息","杳无音信","杳无音讯"],"usage":"作谓语、定语；指没有一点儿音信"},{"id":26235,"word":"杳无影响","pinyin":"yǎo wú yǐng xiǎng","abbr":"ywyx","explanation":"没有踪影，没有音信。","source":{"text":"晁夫人起先等那官府有甚赈济的良方，杳无影响；又等那乡宦富室有什么捐输，又绝无音信。","book":"清·西周生《醒世姻缘传》第三十二回"},"usage":"作谓语、状语；用于书面语"},{"id":26236,"word":"杳无消息","pinyin":"yǎo wú xiāo xī","abbr":"ywxx","explanation":"杳：无影无踪。没有一点儿音信。","source":{"text":"微闻有浮海行者，踪迹可疑。乃南至闽广近海诸地，无不遍历，杳无消息。","book":"明·沈德符《野获编》"},"example":{"text":"我四处打听，也～。","book":"鲁迅《故事新编·铸剑》"},"similar":["杳无音信","杳无踪影","无影无踪"],"opposite":["捷报频传"],"usage":"作谓语、定语；指没有一点儿音信"},{"id":26237,"word":"杳无踪影","pinyin":"yǎo wú zōng yǐng","abbr":"ywzy","explanation":"一点踪迹都没有。指不知去向。同“杳无踪迹”。","source":{"text":"伊常常盼望佣妇到来，好问个究竟，却又杳无踪影。","book":"叶圣陶《潜隐的爱》"},"example":{"text":"她走到园子里，只看见那株玫瑰花上，非但不比昨天开得更大更美丽，而且连昨天所看见的那几朵将开的花，都～，不知去向了。","book":"倪贻德《初恋》"},"similar":["杳无踪迹"],"usage":"作谓语、定语；用于人或事物等"},{"id":26238,"word":"杳无踪迹","pinyin":"yǎo wú zōng jī","abbr":"ywzj","explanation":"一点踪迹都没有。谓不知去向。","source":{"text":"李逵叫娘吃水，杳无踪迹，叫了几声不应。","book":"明·施耐庵《水浒传》第四十三回"},"example":{"text":"四面搜寻，～。","book":"清·李宝嘉《文明小史》第二十二回"},"similar":["杳无踪影"],"usage":"作谓语、定语；用于人或事物等"},{"id":26239,"word":"杳无音信","pinyin":"yǎo wú yīn xìn","abbr":"ywyx","explanation":"音信：消息，回信。没有一点消息。","source":{"text":"惊鸿去后，轻抛素袜，杳无音信。","book":"宋·黄孝迈《咏水仙》词"},"example":{"text":"孔明一去东吴，～。","book":"明·罗贯中《三国演义》第四十五回"},"similar":["杳无消息","石沉大海"],"opposite":["指日可待"],"usage":"作谓语、定语；指没有一点儿音信"},{"id":26240,"word":"杳无音尘","pinyin":"yǎo wú yīn chén","abbr":"ywyc","explanation":"杳：不见踪影。没有一点消息。","source":{"text":"促召唐若水，与内臣赍诏，于江表海滨寻访，杳无音尘矣。","book":"宋·李昉《太平广记》卷二十七"}},{"id":26241,"word":"杳无音耗","pinyin":"yǎo wú yīn hào","abbr":"ywyh","explanation":"犹言杳无音信。没有一点消息。","source":{"text":"唯妻泣曰：‘汝投于海，杳无音耗……何得在此？’","book":"宋·无名氏《异闻总录》卷一"},"example":{"text":"刘母见子久出不归，～，即在任邱县控追车夫。","book":"清·袁枚《新齐谐·驴雪奇冤》"},"similar":["杳无音信","杳无消息"],"usage":"作谓语、定语；指没有一点儿音信"},{"id":26242,"word":"杳无音讯","pinyin":"yǎo wú yīn xùn","abbr":"ywyx","explanation":"没有一点消息。见“杳无音信”。","source":{"text":"前不久，总算熬到了国家建委来了调令，但是到了省里、局里，又几个月杳无音讯。","book":"柯云路《三千万》"},"example":{"text":"柯云路《三千万》：“前不久，总算熬到了国家建委来了调令，但是到了省里、局里，又几个月～。”"},"similar":["杳无音信"],"usage":"作谓语、定语；指没有一点儿音信"},{"id":26243,"word":"杳然黄鹄","pinyin":"yǎo rán huáng hú","abbr":"yrhg","explanation":"杳：无影无声；黄鹄：传说中仙人所乘的鹤。原指传说中仙人骑着黄鹤飞去，从此不再回来。现比喻无影无踪或下落不明。","source":{"text":"杳然黄鹄去，未负白云期。","book":"唐·钱起《送张五员外东归楚州》"}},{"id":26244,"word":"杵臼之交","pinyin":"chǔ jiù zhī jiāo","abbr":"cjzj","explanation":"杵：舂米的木棒；臼：石臼。比喻交朋友不计较贫富和身分。","source":{"text":"公沙穆来游太学，无资粮，乃变服客佣，为祐赁舂。祐与语大惊，遂共定交于杵臼之间。","book":"南朝·宋·范晔《后汉书·吴祐传》"},"example":{"text":"追忆乾隆丙辰荐鸿博入都，在赵横山阁学处见美少年张君名顾鉴者，彼此订～。","book":"清·袁枚《随园诗话补遗》第六卷"},"similar":["君子之交"],"opposite":["小人之交"],"usage":"作宾语；指不计贫贱的友谊","story":["东汉时山东胶东书生公沙穆隐居在东莱山求学，为筹集求学经费，穿上粗布衣服到陈留郡长官吴大人家做舂米雇工，吴大人见其谈吐非凡，就与他结交为好友，并资助他继续求学。后来公沙穆学成成为一个有作为的正义官员"]},{"id":26245,"word":"杵臼交","pinyin":"chǔ jiù jiāo","abbr":"cjj","explanation":"指不计贫贱的交谊。","source":{"text":"公沙穆来游太学，无资粮，乃变服客佣，为祐赁舂。祐与语大惊，遂共定交於杵臼之间。","book":"《后汉书·吴祐传》"},"example":{"text":"文登周生，与成生少共笔砚，遂订为～。而成贫，故终岁依周。","book":"清·蒲松龄《聊斋志异·成仙》"},"similar":["杵臼之交"],"usage":"作宾语；指不计贫贱的友谊"},{"id":26246,"word":"杷罗剔抉","pinyin":"pá luó tī jué","abbr":"pltj","explanation":"指搜罗挑选人材。","source":{"text":"占小善者率以录，名一艺者无不庸。杷罗剔抉，刮垢磨光盖有幸而获选，孰云多而不扬？","book":"《新唐书·韩愈传》"},"similar":["爬罗剔抉"],"usage":"作谓语；指广泛地搜罗"},{"id":26247,"word":"杼井易水","pinyin":"shū jǐng yì shuǐ","abbr":"zjys","explanation":"杼：通“抒”，取出；易：改变，变换。清除井中的淤泥，使水流通畅。","source":{"text":"钻燧易火，杼井易水所以去兹毒也。","book":"《管子·禁藏》"}},{"id":26248,"word":"杼柚之空","pinyin":"zhù zhóu zhī kōng","abbr":"zzzk","explanation":"形容生产废弛，贫无所有。","source":{"text":"言其政偏，失砥矢之道也。谭无他货，维丝麻尔，今尽杼柚不作也。","book":"语出《诗·小雅·大东》：“小东大东，杼柚其空。”郑玄笺"},"example":{"text":"及今而不为之计，必至忧～。","book":"清薛福成《请豁除旧禁招徕华民疏》"},"similar":["杼柚空虚","杼柚其空"],"usage":"作宾语；指社会局面"},{"id":26249,"word":"杼柚其空","pinyin":"zhù zhóu qí kōng","abbr":"zzqk","explanation":"形容生产废弛，贫无所有。","source":{"text":"言其政偏，失砥矢之道也。谭无他货，维丝麻尔，今尽杼柚不作也。","book":"语出《诗·小雅·大东》：“小东大东，杼柚其空。”郑玄笺"},"example":{"text":"盐城有才女者，不详其姓氏，嫁夫某，业儒，家甚贫……届天中节，～，几不能举火。","book":"清百一居士《壶天录》卷上"},"similar":["杼柚空虚"],"usage":"作谓语、定语；指社会局面"},{"id":26250,"word":"杼柚空虚","pinyin":"zhù zhóu kōng xū","abbr":"zzkx","explanation":"形容生产废弛，贫无所有。","source":{"text":"言其政偏，失砥矢之道也。谭无他货，维丝麻尔，今尽杼柚不作也。","book":"语出《诗·小雅·大东》：“小东大东，杼柚其空。”郑玄笺"},"example":{"text":"当斯之役，黔首陨于狼望之北，财币縻于庐山之壑，府库单竭，～ 。","book":"《后汉书·本域传序》"},"similar":["杼柚之空","杼柚其空"],"usage":"作谓语、定语；指社会局面"},{"id":26251,"word":"松乔之寿","pinyin":"sōng qiáo zhī shòu","abbr":"sqzs","explanation":"松、乔：古代传说中的仙人赤松子和王乔。指像仙人那样的长寿。","source":{"text":"大王诚留意如此，则心有尧舜之志，体有乔松之寿。","book":"《汉书·王吉传》"},"example":{"text":"愿王奉诏入朝，守臣子之节，必有～，累代之荣。","book":"《隋书·皇甫诞传》"},"similar":["长生不老"],"usage":"作宾语；比喻长寿"},{"id":26252,"word":"松形鹤骨","pinyin":"sōng xíng hè gǔ","abbr":"sxhg","explanation":"形容仪容清癯、轩昂。","source":{"text":"玄德视其人，松形鹤骨，器宇不凡。","book":"明·罗贯中《三国演义》第三十五回"},"usage":"作宾语、定语；用于比喻句"},{"id":26253,"word":"松心契","pinyin":"sōng xīn qì","abbr":"sxq","explanation":"松树苍劲挺拔，四季常青。用来比喻牢不可破的友谊。","source":{"text":"日托松心契，新交竹使符。","book":"唐·刘禹锡《酬喜相遇同州与乐天替代》"},"example":{"text":"蓬发颜空老，～独全。","book":"唐·李吉甫《癸巳岁吉甫圜丘摄事合于中书后阁……呈集贤院诸学士》"}},{"id":26254,"word":"松松垮垮","pinyin":"sōng sōng kuǎ kuǎ","abbr":"sskk","explanation":"懒散疲塌不紧张，也指不稳固。","source":{"text":"处理要及时，一般地要严，不能松松垮垮，不能处理太轻了。","book":"邓小平《坚决打击经济犯罪活动》"},"example":{"text":"路遥《平凡的世界》第一卷第九章：“在人圈外的民兵小分队，一个个都把枪～倒背在肩上，枪里面谁也不敢装子弹，怕走火把好人伤了。”"},"opposite":["稳稳固固"],"usage":"作谓语、定语、状语；用于人或事物"},{"id":26255,"word":"松枝挂剑","pinyin":"sōng zhī guà jiàn","abbr":"szgj","explanation":"比喻重信义的美德。","source":{"text":"《史记·吴太伯世家》：“季札之初使，北过徐君。徐君好季札剑，口弗敢言。季札心知之，为使上国，未献。还至徐，徐君已死。于是乃解其宝剑，系之徐君冢树而去。从者曰：‘徐君已死，尚谁予乎？’季子曰：‘不然。始吾心已许之，岂以死倍吾心哉！’"},"example":{"text":"唐·张九龄《大唐故光禄大夫徐文公神道碑》：“～，碑字生金。”"},"similar":["悬剑空垄"],"usage":"作宾语、定语；用于处事","story":["古代季札第一次出使北方，见到徐君结为好友。徐君喜欢季札的宝剑，口头虽没言明。季札心里明白这事，为了便于执行公务，就没有送给徐君。季札公务完毕路过徐地，见徐君已经去世，就到他的坟墓旁把宝剑挂在树上而离开"]},{"id":26256,"word":"松柏之寿","pinyin":"sōng bǎi zhī shòu","abbr":"sbzs","explanation":"比喻长寿。"},{"id":26257,"word":"松柏之志","pinyin":"sōng bǎi zhī zhì","abbr":"sbzz","explanation":"指坚贞不移的志节。","source":{"text":"后操作司空，总朝政，问宗曰：‘可以交禾？’答曰：‘松柏之志犹存。’","book":"宋·叶廷珪《海录碎事·人事》"},"usage":"作主语、宾语；用于比喻句","story":["东汉末年，宗世林看不起曹操的为人，总不想与他交往。曹操深为恼火，直到担任司空总揽朝政事务时，来问宗世林能否交往了吗？宗世林回答说：“松柏之志犹存。”后来曹操掌握政权后，以宗世林位不配德而治罪"]},{"id":26258,"word":"松柏之茂","pinyin":"sōng bǎi zhī mào","abbr":"sbzm","explanation":"松柏的枝叶繁茂常青，经冬不凋。比喻长久不衰，经得起考验。","source":{"text":"如松柏之茂，无不尔或承。","book":"《诗经·小雅·天宝》"},"example":{"text":"晋·陈寿《三国志·魏志·王昶传》：“朝华之草，夕而零落；～，隆寒不衰。”"},"usage":"作宾语；用于比喻句"},{"id":26259,"word":"松柏后凋","pinyin":"sōng bǎi hòu diāo","abbr":"sbhd","explanation":"寒冬腊月，方知松柏常青。比喻有志之士在艰险的环境中奋斗到最后。","source":{"text":"岁寒，然后知松柏之后凋也。","book":"《论语·子罕》"},"example":{"text":"惟公益坚尊奖，慎守规程，～，风雨如晦。","book":"唐·于竞《王审知德政碑铭》"},"similar":["松柏后雕"],"usage":"作谓语、定语；用于奋斗到最后"},{"id":26260,"word":"松柏寒盟","pinyin":"sōng bǎi hán méng","abbr":"sbhm","explanation":"比喻患难之交。","source":{"text":"虽则是梅花冷淡，也甘守松柏寒盟。","book":"清·李渔《怜香伴·斋访》"},"usage":"作宾语、定语；用于比喻句"},{"id":26261,"word":"松筠之节","pinyin":"sōng yún zhī jié","abbr":"sjzj","explanation":"松与竹材质坚韧，岁寒不凋。用以比喻坚贞的节操。","source":{"text":"梁主奕叶重光，委诚朝廷，而今已后，方见松筠之节。","book":"唐·魏征《隋书·柳庄传》"},"example":{"text":"他老人家德高望重，有～。"},"usage":"作宾语；指人的气节","story":["公元579年，北周宣帝宇文赟病死，年幼的静帝宇文阐即位，内史大夫郑泽和御史大夫刘昉伪造诏书召杨坚入宫总揽军政大权，后梁大臣柳庄奉明帝萧岿之意入关，杨坚召见他并夸梁明帝有松筠之节，缓和了双边关系，共同对付尉迟迥"]},{"id":26262,"word":"松茂竹苞","pinyin":"sōng mào zhú bāo","abbr":"smzb","explanation":"比喻兴盛繁荣。","source":{"text":"秩秩斯干，幽幽南山。如竹苞矣，如松茂矣。","book":"《诗·小雅·斯干》"},"example":{"text":"《清史稿·礼志》：“思媚嗣徽，～，神罔时恫，执豕酌匏。”"},"usage":"作宾语、定语；用于书面语"},{"id":26263,"word":"松萝共倚","pinyin":"sōng luó gòng yǐ","abbr":"slgy","explanation":"萝：寄生于松树上的能爬蔓的植物；倚：靠着。像松与萝那样相互依存。比喻夫妇和睦融洽。","source":{"text":"我等本待和他琴瑟相谐，松萝共倚，争奈尘缘未断，蓦地思归。","book":"元·王子一《误入桃源》第二折"},"usage":"作宾语、定语；多用于比喻句"},{"id":26264,"word":"松贞玉刚","pinyin":"sōng zhēn yù gāng","abbr":"szyg","explanation":"贞：坚贞；玉：玉石；刚：刚毅。形容人品质坚贞刚毅。","source":{"text":"松贞玉刚，千夫之业，篡文有光。","book":"唐·韩愈《祭张给事文》"}},{"id":26265,"word":"松风水月","pinyin":"sōng fēng shuǐ yuè","abbr":"sfsy","explanation":"松涛清风，流水明月。形容景色清幽。也用来形容人容貌清朗。","source":{"text":"松风水月未足比其清华，仙露明珠讵能方其朗润。","book":"唐·李世民《大唐三藏圣教序》"},"example":{"text":"知他故人甚处，晚霞明、断浦柳枝垂。唯有～，向人长似当时。","book":"宋·吕渭老《木兰花慢》词"},"usage":"作宾语、定语；用于书面语"},{"id":26266,"word":"板上砸钉","pinyin":"bǎn shàng zá dīng","abbr":"bszd","explanation":"比喻事情已定，不容变更或说话算数。","source":{"text":"参见“板上钉钉”。"},"example":{"text":"大英雄说话～，你既然还愿意给弟兄们办事，那就看你说的吧。","book":"苗培时《矿山烈火》"},"similar":["板上钉钉"],"opposite":["言而无信"],"usage":"作定语、状语；比喻已经定下的事情"},{"id":26267,"word":"板上钉钉","pinyin":"bǎn shàng dìng dīng","abbr":"bsdd","explanation":"在石板上钉上铁钉。比喻事情已经决定，不能改变。","source":{"text":"议亲之事，这三位老伯，并儿的外父一并说好，那就石板上钉钉，就如我爹订的一般。","book":"清·李绿园《歧路灯》第九十三回"},"example":{"text":"海云是已经定性、已经作了～的正式结论的阶级敌人。","book":"王蒙《蝴蝶》"},"similar":["铁板钉钉","板上砸钉"],"opposite":["言而无信"],"usage":"作定语、状语；比喻已经定下的事情"},{"id":26268,"word":"板板六十四","pinyin":"bǎn bǎn liù shí sì","abbr":"bblss","explanation":"宋时官铸铜钱，每板六十四文，不得增减。比喻刻板不知变通。板：即“版”，铸钱的模子。","source":{"text":"板板六十四，铸钱定例也，喻不活。","book":"清·范寅《越谚·数目之谚》"},"example":{"text":"这个人～，不通人情。","book":"王安忆《绕公社一周》"},"similar":["版版六十四"],"usage":"作定语、分句；比喻不会变通"},{"id":26269,"word":"极乐世界","pinyin":"jí lè shì jiè","abbr":"jlsj","explanation":"佛教指阿弥陀佛居住的地方。后泛指幸福安乐的地方。","source":{"text":"从是西方，过十万亿佛土，有世界名曰极乐。","book":"《阿弥陀经》"},"example":{"text":"细观此景，与我大唐何异！所为～，诚此之谓也。","book":"明·吴承恩《西游记》第八十八回"},"similar":["世外桃源","及时行乐"],"opposite":["不毛之地","乐极生悲"],"usage":"作主语、宾语、定语；用于书面语"},{"id":26270,"word":"极则必反","pinyin":"jí zé bì fǎn","abbr":"jzbf","explanation":"指事物发展到极端，就会向相反的方面转化。","source":{"text":"全则必缺，极则必反，盈则必污。","book":"《吕氏春秋·博志》"},"similar":["物极必反"],"usage":"作谓语、定语、分句；用于劝诫人"},{"id":26271,"word":"极口项斯","pinyin":"jí kǒu xiàng sī","abbr":"jkxs","explanation":"指满口赞誉。项斯、唐代诗人，为杨敬之所器重，敬之赠诗有“平生不解藏人善，到处逢人说项斯”之句。","source":{"text":"仆极口项斯久矣。茂元虽多士，当今无出公右者。","book":"明·袁宏道《与钱象先书》"},"usage":"作谓语、定语；用于赞誉"},{"id":26272,"word":"极古穷今","pinyin":"jí gǔ qióng jīn","abbr":"jgqj","explanation":"指穷尽古今。","source":{"text":"气质之秉，虽有善恶之不同，然极古穷今论之，则性未尝不善也。","book":"《朱子语类》卷九五"},"example":{"text":"～，以镒称铢。","book":"宋·叶適《祭薛子舒文》"},"usage":"作定语、状语；用于书面语"},{"id":26273,"word":"极天爬地","pinyin":"jí tiān pá dì","abbr":"jtpd","explanation":"用尽一切办法。","example":{"text":"他做事总想成功，～也要达到目的。"},"usage":"作定语、状语；用于口语"},{"id":26274,"word":"极天罔地","pinyin":"jí tiān wǎng dì","abbr":"jtwd","explanation":"指遍天下。","source":{"text":"听哀告，听哀告！贱躯流落谁知道，谁知道！极天罔地，罪恶难分颠倒。","book":"明·施耐庵《水浒传》第八十一回"},"usage":"作谓语、定语；用于书面语"},{"id":26275,"word":"极天蟠地","pinyin":"jí tiān pán dì","abbr":"jtpd","explanation":"指充塞天地之间。","source":{"text":"及夫礼乐之极乎天而蟠乎地，行乎阴阳而通乎鬼神。","book":"语出《礼记·乐记》"},"example":{"text":"非天下之至明，其孰能与于此？～之礼，周旋揖让之规，百神于是会昌，二仪以之同节。","book":"唐 杨炯《大唐益州大都督府新都县学先圣庙堂碑文序》"},"usage":"作谓语、定语；用于书面语"},{"id":26276,"word":"极天际地","pinyin":"jí tiān jì dì","abbr":"jtjd","explanation":"形容十分高大。","source":{"text":"及夫礼乐之极乎天而蟠乎地，行乎阴阳而通乎鬼神。","book":"《礼记·乐记》"},"example":{"text":"司马氏功德弥隆，～，可即皇帝正位，以绍魏统。","book":"明·罗贯中《三国演义》第一一九回"},"usage":"作谓语、定语；形容十分盛大"},{"id":26277,"word":"极奸巨恶","pinyin":"jí jiān jù è","abbr":"jjje","explanation":"指极坏的奸恶小人","source":{"text":"常见世间极奸巨恶，打爹骂娘的人，其存心比蛇蝎更不堪，怎么雷也不霹他？","book":"清·李百川《绿野仙踪》第46回"},"similar":["大奸巨恶"],"usage":"作宾语、定语；用于书面语"},{"id":26278,"word":"极寿无疆","pinyin":"jí shòu wú jiāng","abbr":"jswj","explanation":"指永存。","source":{"text":"声名魂魄施于虚，极寿无疆。","book":"汉·董仲舒《春秋繁露·三代改制质文》"},"similar":["万寿无疆"],"usage":"作谓语、定语；用于祝人长寿"},{"id":26279,"word":"极往知来","pinyin":"jí wǎng zhī lái","abbr":"jwzl","explanation":"通晓过去，预知未来。","source":{"text":"探赜索隐，得郊祀之元辰；极往知来，正邦家之大体。","book":"唐·柳宗元《迎长日赋》"},"usage":"作谓语、定语；用于书面语"},{"id":26280,"word":"极恶不赦","pinyin":"jí è bù shè","abbr":"jebs","explanation":"罪大恶极，不可饶恕。","source":{"text":"按《唐律》屠牛者，在极恶不赦内。","book":"清·龚炜《巢林笔谈续编·牛肉鳝鱼》"},"similar":["十恶不赦"],"usage":"作谓语、定语；指罪恶极大"},{"id":26281,"word":"极恶穷凶","pinyin":"jí è qióng xiōng","abbr":"jeqx","explanation":"指极端凶恶。","source":{"text":"逆贼华皎，极恶穷凶，遂树立萧岿，谋危社稷。","book":"《陈书·废帝纪》"},"similar":["穷凶极恶"],"usage":"作谓语、定语；指极端凶恶"},{"id":26282,"word":"极情尽致","pinyin":"jí qíng jìn zhì","abbr":"jqjz","explanation":"指将意趣风致表现得很充分。","source":{"text":"果然蒋玉函扮了秦小官伏侍花魁醉后神情，把那一种怜香惜玉的意思，做得极情尽致。","book":"清·曹雪芹《红楼梦》第九十三回"},"usage":"作定语、状语；用于书面语"},{"id":26283,"word":"极情纵欲","pinyin":"jí qíng zòng yù","abbr":"jqzy","explanation":"竭力满足自己的情感和贪欲而不加节制。","source":{"text":"又曰：‘我为天子，极情纵欲，有谏者辄杀之，不过杀数百人，众自定矣。’","book":"《资治通鉴·唐太宗贞观十五年》"},"example":{"text":"至秦有天下，遂杂采六国之仪，而尽废三代之礼，盖将～，凡势力之所能逞则恣焉。","book":"清·方苞《又书礼书序后》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":26284,"word":"极智穷思","pinyin":"jí zhì qióng sī","abbr":"jzqs","explanation":"竭尽才智和思虑。","source":{"text":"圣人所极智穷思而以为无奇者，乃就十数肉食之人而询焉，采焉……则亦徒见其劳民伤财而已矣。","book":"清·侯方域《豫省试策四》"},"usage":"作谓语、定语；用于书面语"},{"id":26285,"word":"极本穷源","pinyin":"jí běn qióng yuán","abbr":"jbqy","explanation":"指彻底地推究本源。","source":{"text":"伊川言极本穷源之性，乃是对气质之性而言。","book":"《朱子语类》卷九五"},"similar":["追根溯源"],"usage":"作谓语、定语；指追根溯源"},{"id":26286,"word":"极武穷兵","pinyin":"jí wǔ qióng bīng","abbr":"jwqb","explanation":"黩武。滥用武力。","source":{"text":"且君辅翼幼主，位重望隆，理宜调阴阳，抚百姓，焉用极武穷兵，构怨连祸！","book":"《周书·韦孝宽传》"},"similar":["黩武穷兵"],"usage":"作谓语、定语、宾语；指发动战争"},{"id":26287,"word":"极深研几","pinyin":"jí shēn yán jī","abbr":"jsyj","explanation":"研：研究，审查；几：细微。指探讨研究事物的深奥隐微之处。","source":{"text":"夫《易》，圣人之所以极深而研几也。","book":"《周易·系辞上》"},"example":{"text":"必使天下有志之士皆殚思竭精、～，以从事于制造而后可。","book":"清·郑观应《盛世危言·附录沪报》"},"usage":"作谓语；形容钻研深刻、细致"},{"id":26288,"word":"极深研幾","pinyin":"jí shēn yán jī","abbr":"jsyj","explanation":"研：研究，审查；幾：细微。形容钻研深刻、细致。","source":{"text":"夫易，圣人之所以极深而研幾也。唯深也，故能通天下之志，唯幾也，故能成天下之务。","book":"《周易·系辞上》"},"example":{"text":"作为文章，将及千余篇，皆～，尽意而为之者。","book":"明·瞿祐《剪灯新话·修文舍人传》"}},{"id":26289,"word":"极目四望","pinyin":"jí mù sì wàng","abbr":"jmsw","explanation":"极目：尽眼力之所及；四望：向四周眺望。形容企盼心切。","source":{"text":"子虽在裔土，想亦极目而迥望，侧耳而遐听，延颈而鹤立。","book":"三国·魏·王朗《与许靖书》"},"usage":"作谓语；指尽眼力所及眺望四方"},{"id":26290,"word":"极目远望","pinyin":"jí mù yuǎn wàng","abbr":"jmyw","explanation":"指用尽目力向远处眺望。","source":{"text":"子虽在裔土，想亦极目而迥望，侧耳而遐听，延颈而鹤立也。","book":"三国·魏·王朗《与许靖书》"},"similar":["极目远眺","极目四望"],"usage":"作谓语；指用尽目力向远处眺望"},{"id":26291,"word":"极目远眺","pinyin":"jí mù yuǎn tiào","abbr":"jmyt","explanation":"极：尽；眺：望。尽眼力之所及眺望远方。","source":{"text":"子虽在裔土，想亦极目而迥望，侧耳而遐听，延颈而鹤立。","book":"三国·魏·王朗《与许靖书》"},"similar":["极目远望"],"usage":"作谓语；指尽眼力所及眺望远方"},{"id":26292,"word":"极目迥望","pinyin":"jí mù jiǒng wàng","abbr":"jmjw","explanation":"极：尽；迥：远。尽眼力之所及眺望远方。","source":{"text":"子虽在裔土，想亦极目而迥望，侧耳而遐听，延颈而鹤立。","book":"三国·魏·王朗《与许靖书》"},"similar":["极目四望"],"usage":"作谓语、定语；用于书面语"},{"id":26293,"word":"极而言之","pinyin":"jí ér yán zhī","abbr":"jeyz","explanation":"从最极端的情况来说。指把话说到头。","source":{"text":"极而言之，亦是心形炼极所现之象。","book":"明·袁宏道《与仙人论性书》"},"example":{"text":"说这个话是～，把问题讲透。","book":"毛泽东《坚定地相信群众的大多数》"},"usage":"作宾语、分句；指把话说到头"},{"id":26294,"word":"极致高深","pinyin":"jí zhì gāo shēn","abbr":"jzgs","explanation":"形容造诣极深。","source":{"text":"若章草古逸，极致高深，则伯度第一。","book":"汉·何休《公羊解诂序》：“昔者孔子有云：‘吾志在《春秋》，行在《孝经》。’此二学者，圣人之极致，治世之要务也。”唐·张怀瓘《书断·能品》"}},{"id":26295,"word":"极重不反","pinyin":"jí zhòng bù fǎn","abbr":"jzbf","explanation":"指长期形成的风俗、习惯、弊端或某种局面难以改变。用于消极方面。同“极重难返”。","source":{"text":"今《大学》之为圣经，已成极重不反之势。","book":"清·陈确《答张考夫书》"},"similar":["极重难返","积重难返"],"usage":"作宾语、定语、分句；指习惯难改"},{"id":26296,"word":"极重难返","pinyin":"jí zhòng nán fǎn","abbr":"jznf","explanation":"犹积重难返。指长期形成的风俗、习惯、弊端或某种局面难以改变。用于消极方面。","source":{"text":"此固其极重难返之势，始于景定，讫于洪武，而征科之额，十倍于绍煕以前者也。","book":"清·顾炎武《日知录·苏松二府田赋之重》"},"example":{"text":"‘九一八’事变以来……形成了目前‘共赴国难’的团结抗战，这实在是国家民族的最大喜事。然而有许多事体～。","book":"郭沫若《羽羽集·武装民众之必要》"},"similar":["极重不反"],"usage":"作宾语、定语、谓语；指习惯难改"},{"id":26297,"word":"构会甄释","pinyin":"gòu huì zhēn shì","abbr":"ghzs","explanation":"构：组成；会：聚合；甄：审查鉴定；释：解释。将众说汇集到一起进行比较考核，择善而从。指妥善地进行解说。","source":{"text":"穷波讨源，构会甄释。","book":"《前汉书叙列》"}},{"id":26298,"word":"构怨伤化","pinyin":"gòu yuàn shāng huà","abbr":"gysh","explanation":"构：构成，造成；怨：怨恨；化：教化。指在民众中造成的怨恨，使对人民的教化受到伤害。","source":{"text":"苛暴吏多拘系犯法者亲属妇女老弱，构怨伤化，百姓苦之。","book":"《汉书·平帝纪》"},"usage":"作谓语、宾语；用于时局"},{"id":26299,"word":"构怨连兵","pinyin":"gòu yuàn lián bīng","abbr":"gylb","explanation":"构怨：结怨；连兵：交战。因结怨而发生战争。","source":{"text":"本朝与陈，日敦交睦，輶轩往返，积有多年。比为疆场之事，遂炎仇敌，构怨连兵，略无宁岁，鹬蚌狗兔，势不俱全。","book":"《周书·杜杲传》"},"usage":"作宾语、定语；指战争等"},{"id":26300,"word":"枇杷门巷","pinyin":"pí pá mén xiàng","abbr":"ppmx","explanation":"旧时指妓女居住的地方。","source":{"text":"万里桥边女校书，枇杷门里闭门居。","book":"唐·王建《寄蜀中薛涛校书》诗"},"example":{"text":"黛玉是风月场中的老手，应酬队里的能员，况且盛名之下，自然～，车马纷纷。","book":"清·张春帆《九尾龟》第二十二回"},"similar":["花街柳巷"],"usage":"作宾语；指妓女居住的地方"},{"id":26301,"word":"枉使心机","pinyin":"wǎng shǐ xīn jī","abbr":"wsxj","explanation":"枉：徒然。空用心计，白费力气。形容毫无收效。","source":{"text":"枉使心机闲计较，儿孙自有儿孙福。","book":"明·冯梦龙《喻世明言》第31卷"},"similar":["枉费心机","枉费心力"],"usage":"作宾语、定语；指毫无收效"},{"id":26302,"word":"枉勘虚招","pinyin":"wǎng kān xū zhāo","abbr":"wkxz","explanation":"刑讯逼供，屈打成招。","example":{"text":"在各种案件上都不能搞～。"},"usage":"作谓语、宾语、定语；用于逼供"},{"id":26303,"word":"枉口嚼舌","pinyin":"wǎng kǒu jiáo shé","abbr":"wkjs","explanation":"比喻肆意胡说。多指造谣生事。同“枉口拔舌”。","source":{"text":"是那个嘴舌根的，没空生有，枉口拔舌，调唆你来欺负老娘。","book":"明·兰陵笑笑生《金瓶梅词话》第二十五回"},"example":{"text":"见鬼的小忘八羔子！这一定是狄家小陈子的～！","book":"清·西周生《醒世姻缘传》第六十二回"},"similar":["枉口诳舌","枉口拔舌"],"usage":"作谓语、宾语；多指造谣生事"},{"id":26304,"word":"枉口拔舌","pinyin":"wǎng kǒu bá shé","abbr":"wkbs","explanation":"比喻肆意胡说。多指造谣生事。","source":{"text":"是那个嚼舌根的？没空生有，枉口拔舌，调唆你来欺负老娘！","book":"明·兰陵笑笑生《金瓶梅词话》第25回"},"example":{"text":"小孩儿家～，吃斋念佛的道友们，说是娼妇哩！你见谁是娼妇呀？","book":"清·西周生《醒世姻缘传》第74回"},"similar":["信口雌黄","挑拨是非","恶意中伤"],"usage":"作谓语、宾语；多指造谣生事"},{"id":26305,"word":"枉口诳舌","pinyin":"wǎng kǒu kuáng shé","abbr":"wkks","explanation":"比喻肆意胡说。多指造谣生事。同“枉口拔舌”。","source":{"text":"那张氏穿针儿枉口诳舌，陷害无辜。","book":"明·吴承恩《西游记》第九十七回"},"similar":["枉口嚼舌","枉口拔舌"],"usage":"作谓语、宾语；多指造谣生事"},{"id":26306,"word":"枉墨矫绳","pinyin":"wǎng mò jiǎo shéng","abbr":"wmjs","explanation":"比喻违背准绳、准则。","source":{"text":"箕赋深敛，毒被南郢；枉墨矫绳，害著西荆。","book":"南朝·梁·江淹《尚书符》"},"usage":"作宾语、定语；用于书面语"},{"id":26307,"word":"枉学屠龙","pinyin":"wǎng xué tú lóng","abbr":"wxtl","explanation":"枉：徒然，白白地；屠：杀。白白学习了杀龙的技术。比喻徒然学习毫无实用价值的技术。","source":{"text":"朱泙漫学屠龙于支离益，单千金之家，三年技成而无所用其巧。","book":"《庄子·列御寇》"}},{"id":26308,"word":"枉尺直寻","pinyin":"wǎng chǐ zhí xún","abbr":"wczx","explanation":"枉：弯曲；直：伸直；寻：古量名，八尺。屈折的只有一尺，伸直的却有一寻。比喻在小处委屈一些，以求得较大的好处。","source":{"text":"枉尺而直寻，宜若可为也。","book":"《孟子·滕文公下》"},"example":{"text":"然区区之事，于此犹不能忘言，更祝深以门户道学之传为念。幸甚，幸甚，～，素未尝以此奉疑也。","book":"宋·朱熹《答吕子约》"},"similar":["以小求大"],"opposite":["因小失大"],"usage":"作谓语、定语；指求得较大的好处"},{"id":26309,"word":"枉己正人","pinyin":"wǎng jǐ zhèng rén","abbr":"wjzr","explanation":"枉：弯曲，不正；正：纠正。自己立脚不正，却要去纠正别人。","source":{"text":"吾未闻枉己而正人者也。","book":"《孟子·万章上》"},"usage":"作谓语、宾语；指自己立场不正，却去纠正别"},{"id":26310,"word":"枉担虚名","pinyin":"wǎng dān xū míng","abbr":"wdxm","explanation":"枉：徒然。白白占有名位，形同虚设；空有其名并无实际内容。","source":{"text":"现在这两位姨娘，也是枉担虚名的。","book":"清·夏敬渠《野叟曝言》"},"similar":["徒有虚名"],"opposite":["名副其实"],"usage":"作谓语、宾语；指空有其名并无实际内容"},{"id":26311,"word":"枉曲直凑","pinyin":"wǎng qǔ zhí còu","abbr":"wqzc","explanation":"指在弯曲的路上却笔直地往前走。形容人笨拙死板而不知变通。"},{"id":26312,"word":"枉法取私","pinyin":"wǎng fǎ qǔ sī","abbr":"wfqs","explanation":"枉：歪曲，违反；法：法律；取：谋取；私：私利。曲解、破坏法律以谋取私利。指官吏违法乱纪，包庇坏人坏事。","source":{"text":"枉：歪曲，违反；法：法律；取：谋取；私：私利。曲解、破坏法律以谋取私利。指官吏违法乱纪，包庇坏人坏事。"}},{"id":26313,"word":"枉法徇私","pinyin":"wǎng fǎ xùn sī","abbr":"wfxs","explanation":"指官吏违法乱纪，包庇坏人坏事。","source":{"text":"使官吏一心奉公，而不敢为徇情枉法之私。","book":"元·五磐《中书右丞相史公神道碑》"},"example":{"text":"共产党员不能带头干～的事情"},"similar":["枉法营私","徇私枉法"],"usage":"作谓语、定语、宾语；用于处事"},{"id":26314,"word":"枉法营私","pinyin":"wǎng fǎ yíng sī","abbr":"wfys","explanation":"枉：歪曲，违反。指曲解破坏法律以谋私利。","source":{"text":"诚为枉法营私，原王章所不宥。","book":"清·文康《儿女英雄传》第35回"},"similar":["徇私枉法"],"usage":"作谓语、定语；指曲解破坏法律以谋私利"},{"id":26315,"word":"枉物难消","pinyin":"wǎng wù nán xiāo","abbr":"wwnx","explanation":"指不义之财难于消受，反而招灾惹祸。"},{"id":26316,"word":"枉用三尺","pinyin":"wǎng yòng sān chǐ","abbr":"wysc","explanation":"枉：歪曲；用：使用；三尺：古代用三尺长的的竹简记载法律。指为了达到个人不正当的目的而曲解使用法律。","source":{"text":"臧使者枉用三尺，以仇一言之憾，固贼戾之士哉！","book":"明·高启《书博鸡者事》"}},{"id":26317,"word":"枉用心机","pinyin":"wǎng yòng xīn jī","abbr":"wyxj","explanation":"指白费心思。同“枉费心机”。","source":{"text":"叹光阴，如流水。区区终日，枉用心机。","book":"宋·朱熹《答甘道士书》：“所云筑室藏书，此亦恐枉费心力。不如且学静坐，闲读旧书，涤去世俗尘垢之心。”元·滕斌《普天乐》词"},"example":{"text":"一经把眼闭了，这才晓得从前各事都是～，不过做了一场春梦。","book":"清·李汝珍《镜花缘》第十六回"},"similar":["枉费心机","枉费心思","枉费心计"],"usage":"作谓语、宾语；指白费心思"},{"id":26318,"word":"枉直同贯","pinyin":"wǎng zhí tóng guàn","abbr":"wztg","explanation":"指曲直不分。"},{"id":26319,"word":"枉直随形","pinyin":"wǎng zhí suí xíng","abbr":"wzsx","explanation":"指影子的曲直随形而定。","source":{"text":"形枉则影曲，形直则影正，然则枉直随形而不在影。","book":"《列子·说符》"},"usage":"作宾语、定语；用于书面语"},{"id":26320,"word":"枉矢哨壶","pinyin":"wǎng shǐ qiào hú","abbr":"wssh","explanation":"枉：曲；矢：箭；哨：不正；壶：古代投矢娱乐所用的器具。弯的箭，歪的壶。比喻不精致的器物，为主人自谦之辞。","source":{"text":"主人请曰：‘某有枉矢哨壶，请以乐宾。’","book":"《礼记·投壶》"},"usage":"作宾语、定语；多用于自谦"},{"id":26321,"word":"枉矫过激","pinyin":"wǎng jiǎo guò jī","abbr":"wjgj","explanation":"犹言矫枉过正。比喻纠正错误超过了应有的限度。","source":{"text":"昔刘器之不为枉矫过激之行，而耿挺特达，卓有建明。","book":"明·文征明《铁柯记》"},"similar":["矫枉过正"],"usage":"作谓语、宾语、定语；比喻纠正错误过度"},{"id":26322,"word":"枉突徙薪","pinyin":"wǎng tū xǐ xīn","abbr":"wtxx","explanation":"比喻防患于未然。","source":{"text":"据汉·刘向《说苑·权谋》载，有人见邻人烟囱直立且旁有积薪，劝其改为弯曲烟囱并移走积薪；邻人不从，后果失火。"},"similar":["曲突徙薪"],"usage":"作谓语、定语；用于事先预防","story":["从前有个人去拜访他的朋友，看见朋友家的烟囱竖在灶前，灶前还堆着不少干柴，就建议主人把烟囱改成弯曲的，把干柴移开。主人没有采纳。不久真的发生火灾，幸亏邻居及时救火。主人杀牛来谢这些邻居，邻居说该请的是那位提意见的人"]},{"id":26323,"word":"枉费口舌","pinyin":"wǎng fèi kǒu shé","abbr":"wfks","explanation":"白费口舌。","example":{"text":"他纵然声辩，也是～。"},"similar":["白费口舌"],"usage":"作谓语、宾语；指白费口舌"},{"id":26324,"word":"枉费唇舌","pinyin":"wǎng fèi chún shé","abbr":"wfcs","explanation":"白费言辞，不起作用。","source":{"text":"妹子在姐姐跟前，断说不进去，我也不必枉费唇舌，再求姐姐，磨姐姐，央给姐姐了。","book":"清·文康《儿女英雄传》第26回"},"example":{"text":"你这样说也是～徒劳无益。"},"similar":["白费口舌"],"usage":"作谓语、宾语；指白费口舌"},{"id":26325,"word":"枉费工夫","pinyin":"wǎng fèi gōng fū","abbr":"wfgf","explanation":"白白地耗费时间与精力。形容徒劳无益。","source":{"text":"如今要下功夫，且须端庄存养，独观昭旷之原，不须枉费工夫，钻在纸上语。","book":"宋·朱熹《朱子语类》第115卷"},"example":{"text":"你这样做是～的。"},"similar":["白费工夫"],"usage":"作谓语、宾语；指不必要的操劳"},{"id":26326,"word":"枉费心力","pinyin":"wǎng fèi xīn lì","abbr":"wfxl","explanation":"犹言枉费心机。指白费心思。","source":{"text":"所云筑室藏书，此亦恐枉费心力。","book":"宋·朱熹《答甘道士书》"},"example":{"text":"你不要～了。"},"similar":["枉费心思","枉使心机"],"opposite":["行之有效"],"usage":"作宾语、定语；指毫无收效"},{"id":26327,"word":"枉费心思","pinyin":"wǎng fèi xīn sī","abbr":"wfxs","explanation":"指白费心思。同“枉费心机”。","source":{"text":"萧先生实在可以佩服，不过枉费心思。","book":"柔石《二月》"},"similar":["枉费心计","枉费心机"],"usage":"作谓语、宾语；指白费心思"},{"id":26328,"word":"枉费心机","pinyin":"wǎng fèi xīn jī","abbr":"wfxj","explanation":"枉：白白地，徒然。白费心思。","source":{"text":"你使这般科段，敢可也枉用心机。","book":"元·无名氏《隔江斗智》第二折"},"example":{"text":"～空费力，雪消春水一场空。","book":"明·许仲琳《封神演义》第四十回"},"similar":["挖空心思","费尽心机","枉费心思"],"opposite":["行之有效"],"usage":"作谓语、宾语；指白费心思"},{"id":26329,"word":"枉费心计","pinyin":"wǎng fèi xīn jì","abbr":"wfxj","explanation":"指白费心思。同“枉费心机”。","source":{"text":"如今枉费心计，挣了一辈子的强，偏偏儿的落在人后头了。","book":"清·曹雪芹《红楼梦》第106回"},"similar":["枉费心机"],"usage":"作谓语、宾语；指白费心思"},{"id":26330,"word":"枉费日月","pinyin":"wǎng fèi rì yuè","abbr":"wfry","explanation":"枉：白白地。费：浪费。日、月：时间、光阴。白白地浪费时光。","source":{"text":"不惟重扰灾伤人户，亦恐枉费日月，不能了办。","book":"宋·朱熹《管下县相视约束》"},"similar":["枉费时日"],"usage":"作谓语、宾语、定语；用于处事"},{"id":26331,"word":"枉费时日","pinyin":"wǎng fèi shǐ rì","abbr":"wfsr","explanation":"枉：白白地；费：浪费；时、日：时间。白白地浪费时光。","source":{"text":"今之为时文者，无不望其速成，其肯 枉费时日于载籍乎。","book":"清·黄宗羲《李杲堂文钞序》"},"example":{"text":"而苟非有极敏之眼光、极高之学识，不能别择其某条有用、某条无用，徒～脑力。","book":"清·梁启超《中国之旧史》"},"similar":["枉费日月"],"usage":"作谓语、宾语、定语；用于处事"},{"id":26332,"word":"枉辔学步","pinyin":"wǎng pèi xué bù","abbr":"wpxb","explanation":"比喻错误地模仿别人。同“邯郸学步”。","source":{"text":"因利骋节，情采自凝；枉辔学步，力止寿陵。","book":"南朝·梁·刘勰《文心雕龙·定势》"},"similar":["邯郸学步"],"usage":"作宾语、定语；用于处事等","story":["战国时期，赵国国都邯郸人走路姿势非常优美，外地人很羡慕。燕国寿陵一个少年特迷恋邯郸人走路的姿态，竟专门到邯郸学习，他用心观摩、效仿、练习，后来他没学会他们走路的姿态，连自己的也全忘了，只好爬回了燕国"]},{"id":26333,"word":"枉道事人","pinyin":"wǎng dào shì rén","abbr":"wdsr","explanation":"枉：违背；道：正道；事：侍奉。原指不按正道事奉国君。后泛指不择手段取悦于人。","source":{"text":"柳下惠为士师，三黜。人曰：‘子未可以去乎？’曰：‘直道而事人，焉往而不三黜？枉道而事人，何必去父母之邦？’","book":"春秋·鲁·孔丘《论语·微子》"},"example":{"text":"～，曲学阿世，皆从此而始矣。","book":"清·顾炎武《日知录·不动心》"},"opposite":["直道事人","坦诚相待"],"usage":"作谓语、定语；泛指不择手段取悦与讨好别人"},{"id":26334,"word":"枉道速祸","pinyin":"wǎng dào sù huò","abbr":"wdsh","explanation":"枉道：邪门歪道；速：招致；祸：祸患。用不正当的手段谋取利益必然招致祸患。","source":{"text":"君子多欲则贪慕富贵，枉道速祸；小人多欲则多求妄用，败家丧身。","book":"宋·司光光《训俭示康》"}},{"id":26335,"word":"析交离亲","pinyin":"xī jiāo lí qīn","abbr":"xjlq","explanation":"指离间亲友。","source":{"text":"析交离亲谓之贼。","book":"《庄子·渔父》"},"usage":"作宾语、定语；用于处事"},{"id":26336,"word":"析圭儋爵","pinyin":"xī guī dān jué","abbr":"xgdj","explanation":"指任官受爵。","source":{"text":"言当分人君之珪，以为上列之诸侯，荷人君之重爵。","book":"《文选·扬雄》:“析人之珪，儋人之爵。”张铣注"},"example":{"text":"当金人陷蕲，士大夫～者，或纳款卖降之不暇，有若秀发者仅一丞耳，则不顾妻子，婴城固守。","book":"明宋濂《叶秀发传赞》"},"similar":["析圭担爵"],"usage":"作谓语、定语；用于书面语"},{"id":26337,"word":"析圭分组","pinyin":"xī guī fēn zǔ","abbr":"xgfz","explanation":"谓任官受印。组，组绶。","source":{"text":"至于析圭分组，跨壤连州，怀四术而自疑，见九重而失望。","book":"唐王维《魏郡太守河北采访处置使上党苗公德政碑》"},"usage":"作谓语、定语；用于书面语"},{"id":26338,"word":"析圭担爵","pinyin":"xī guī dān jué","abbr":"xgdj","explanation":"同“析圭儋爵”。指任官受爵。","source":{"text":"命将徂征，四年三学举，绝无寸功。或高卧而归，或安行以返。析圭担爵，优游朝行，辇帛舆金，充牣私室。","book":"《明史·倪岳传》"},"similar":["析圭儋爵"],"usage":"作谓语、定语；用于书面语"},{"id":26339,"word":"析律二端","pinyin":"xī lǜ èr duān","abbr":"xled","explanation":"割裂曲解法律条文，随意加重或减轻罪名。指官吏徇私枉法。","source":{"text":"用法或持巧心，析律贰端，深浅不平，增辞饰非，以成其罪。","book":"《汉书·宣帝纪》"}},{"id":26340,"word":"析律舞文","pinyin":"xī lǜ wǔ wēn","abbr":"xlww","explanation":"指故意玩弄文字，曲解法律条文。","source":{"text":"臣窃见州县之吏，多是狡恶之人……清白者必多方以误之，贪婪者则啖利以制之，然后析律舞文，鬻狱市令，上下其手，轻重厥刑。","book":"宋苏舜钦《论五事·景祐四年五月七日阁门下》"},"usage":"作谓语、定语；用于书面语"},{"id":26341,"word":"析律贰端","pinyin":"xī lǜ èr duān","abbr":"xled","explanation":"指曲解法律条文，妄生不实端绪，以加重人罪。","source":{"text":"用法或持巧心，析律贰端，深浅不平，增辞释非，以成其罪。","book":"《汉书·宣帝纪》"},"usage":"作谓语、定语；用于处事"},{"id":26342,"word":"析微察异","pinyin":"xī wēi chá yì","abbr":"xwcy","explanation":"指仔细观察、辨别。","source":{"text":"有木连理，草交茎兮；烈魂洁魄，孚女贞兮；析微察异，实此之类兮；附物著灵，见胸臆兮。","book":"明何景明《结肠赋》"},"usage":"作谓语、定语；用于处事等"},{"id":26343,"word":"析毫剖厘","pinyin":"xī háo pōu lí","abbr":"xhpl","explanation":"分解剖析极为细小的事物。形容分析仔细而透彻。","source":{"text":"穷幽极微，至纤无际，析毫剖厘，刀铗锋锐，不足言其细也。","book":"宋·张君房《云笈七签》卷一○二"},"similar":["析毫剖芒"],"usage":"作定语、状语；用于处事"},{"id":26344,"word":"析毫剖芒","pinyin":"xī háo pōu máng","abbr":"xhpm","explanation":"亦作“析毫剖厘”。分割剖析毫毛芒刺。形容剖析细微透彻。","source":{"text":"《文子·道原》：“夫道者陶冶万物，终始无形，寂然不动。大通混冥。深闳广大，不可为外，析毫剖芒，不可为内。无环堵之宇，而生有无之总名也”。"},"example":{"text":"穷幽极微，至纤无际，～，刀铗锋锐，不足言其细也。","book":"《云笈七签》卷一○二"},"similar":["析毫剖厘"],"usage":"作定语、状语；用于处事"},{"id":26345,"word":"析毫剖釐","pinyin":"xī háo pōu lí","abbr":"xhpl","explanation":"析、剖：分解。分割剖析毫毛芒刺。形容分析研究极其仔细透彻。","source":{"text":"穷幽极微，至纤无际，析毫剖厘，刀铗锋锐，不足言其细也。","book":"宋·张君房《云笈七签》卷一○二"}},{"id":26346,"word":"析珪判野","pinyin":"xī guī pàn yě","abbr":"xgpy","explanation":"谓封爵分土。","source":{"text":"今将军以藩戚之重，东南之众，尽力奉上，戮力勤王，岂不勋高窦融，宠过吴芮，析珪判野，南面称孤？","book":"《陈书·虞寄传》"},"similar":["析珪胙土"],"usage":"作谓语、定语；用于书面语"},{"id":26347,"word":"析珪胙土","pinyin":"xī guī zuò tǔ","abbr":"xgzt","explanation":"谓封爵分土。","source":{"text":"今我王析珪胙土，威镇南天，正宜续鸾戚里，谐凤侯门。","book":"清钮琇《觚剩·圆圆》"},"similar":["析珪判野"],"usage":"作谓语、定语；用于书面语"},{"id":26348,"word":"析疑匡谬","pinyin":"xī yí kuāng miù","abbr":"xykm","explanation":"解析疑义，纠正谬误。","source":{"text":"惜李集无有斐然继起者，爰合三家之注订之，芟柞繁芜，补增阙略，析疑匡谬，频有更定。","book":"清·王琦《李太白全集序》"},"usage":"作谓语、定语；用于书面语"},{"id":26349,"word":"析精剖微","pinyin":"xī jīng pōu wēi","abbr":"xjpw","explanation":"指剖析精微深奥的道理。","source":{"text":"盖知者至广极大，析精剖微不可端倪者也。","book":"清恽敬《读一》"},"usage":"作谓语、定语；用于书面语"},{"id":26350,"word":"析缕分条","pinyin":"xī lǚ fēn tiáo","abbr":"xlft","explanation":"析：剖析；缕：线。有条有理地细细分析。","source":{"text":"说经之书甚多，以及文集说部，皆有可采。窃欲析缕分条，加以翦截。","book":"清·平步青《霞外捃屑》卷五"},"example":{"text":"请～地讲解"},"similar":["条分缕析"],"usage":"作定语、状语；用于处事"},{"id":26351,"word":"析肝刿胆","pinyin":"xī gān guì dǎn","abbr":"xggd","explanation":"剖示肝胆。比喻赤诚。亦作“析肝吐胆”。","source":{"text":"其当上指与否，俱且和颜受之。有不析肝刿胆者，非夫也。","book":"明袁宗道《乞进疏》"},"example":{"text":"受顾命，辅冲圣，秉国十年，乃举其生平，～献之天子。","book":"明高以俭《太师张文公集跋》"},"similar":["析肝吐胆"],"usage":"作定语、状语；用于处事"},{"id":26352,"word":"析肝吐胆","pinyin":"xī gān tǔ dǎn","abbr":"xgtd","explanation":"剖示肝胆。比喻赤诚。","source":{"text":"受顾命，辅冲圣，秉国十年，乃举其生平，析肝吐胆献之天子。","book":"明·高以俭《〈太师张文公集〉跋》"},"similar":["析肝刿胆"],"usage":"作定语、状语；用于处事"},{"id":26353,"word":"析肝沥悃","pinyin":"xī gān lì kǔn","abbr":"xglk","explanation":"谓披露肝胆，倾吐至诚。","source":{"text":"盖以陛下开言路，塞讳门，采瞽说，纳愚虑，是以析肝沥悃而具述之。","book":"宋苏舜钦《投匦疏》"},"usage":"作定语、状语；用于处事"},{"id":26354,"word":"析言破律","pinyin":"xī yán pò lǜ","abbr":"xypl","explanation":"指巧说诡辨，曲解律令。","source":{"text":"析言破律，乱名改作，执左道以乱政，杀。","book":"《礼记·王制》"},"example":{"text":"尚书奏：‘……今楷（襄楷）不陈损益，而务～，违背经义，伪托神灵。’于是论楷司完寇。","book":"晋袁宏《后汉纪·桓帝纪下》"},"usage":"作谓语、定语；用于书面语"},{"id":26355,"word":"析辨诡词","pinyin":"xī biàn guǐ cí","abbr":"xbgc","explanation":"指巧言邪说。","source":{"text":"仲尼既没，析辨诡词，骊驾塞路。","book":"宋·曾巩《上欧阳学士第一书》"}},{"id":26356,"word":"析辨诡辞","pinyin":"xī biàn guǐ cí","abbr":"xbgc","explanation":"亦作“析辨诡词”。谓巧言邪说。","source":{"text":"雄见诸子各以其知舛驰，大氐诋訾圣人，即为怪迂，析辨诡辞，以挠世事，虽小辩，终破大道而或众，使溺于所闻而不自知其非也。","book":"《汉书·杨雄传下》"},"example":{"text":"仲尼既没，～，骊驾塞路。","book":"宋曾巩《上欧阳学士第一书》"},"similar":["析辩诡辞"],"usage":"作宾语、定语；指巧言邪说"},{"id":26357,"word":"析辩诡辞","pinyin":"xī biàn guǐ cí","abbr":"xbgc","explanation":"指巧言邪说。","source":{"text":"即为怪迂，析辩诡辞，以挠世事，虽小辩，终破大道而或众。","book":"东汉·班固《汉书·扬雄传下》"},"example":{"text":"仲尼既没，～，骊架塞路。","book":"宋·曾巩《上欧阳学士第一书》"},"similar":["巧言邪说","析辨诡词"],"usage":"作宾语、定语；指巧言邪说"},{"id":26358,"word":"析骨而炊","pinyin":"xī gǔ ér chuī","abbr":"xgec","explanation":"同“析骸以爨”。指被围日久，粮尽柴绝的困境。亦以形容战乱或灾荒时期百姓的悲惨生活。","source":{"text":"王问：‘城中何如？’曰：‘析骨而炊，易子而食。’","book":"《史记·宋微子世家》"},"similar":["析骸以爨"],"usage":"作谓语、定语；用于生活"},{"id":26359,"word":"析骸以爨","pinyin":"xī hái yǐ cuàn","abbr":"xhyc","explanation":"指被围日久，粮尽柴绝的困境。亦以形容战乱或灾荒时期百姓的悲惨生活。","source":{"text":"《左传·宣公十五年》载曰：敝邑易子而食，析骸以爨。"},"example":{"text":"巡握节而死，非亏教也，～，非本情也。","book":"《新唐书·李翰传》"},"similar":["析骨而炊","析骸易子"],"usage":"作谓语、定语；用于生活","story":["春秋时期，楚庄王因宋国杀了楚过境使臣申舟而出兵攻宋，围困宋都半年之久，并准备长久围困下去。宋王派元帅华元只身潜入楚国元帅子反的卧室，挟持子反说宋人就是易子而食、析骸而炊也不投降，请后退三十里，我们再行谈判解决"]},{"id":26360,"word":"析骸易子","pinyin":"xī hái yì zǐ","abbr":"xhyz","explanation":"拆尸骨为炊，交换孩子而食。形容粮尽援绝的极端困境。参见“析骸以爨”。","source":{"text":"昔宋执楚使，遂有析骸易子之祸。","book":"《后汉书·来歙传》"},"example":{"text":"援救无人，困宁孤城血泪喷。～民无怨，一志同仁。","book":"《胭脂血弹词》第八回"},"similar":["析骸以爨"],"usage":"作谓语、定语；用于生活"},{"id":26361,"word":"析骸而爨","pinyin":"xī hái ér cuàn","abbr":"xhec","explanation":"爨：烧火煮饭。劈开人的骨头来烧火做饭。形容战乱或灾荒时期百姓的悲惨生活。","source":{"text":"华元曰：‘敝邑易子而食，析骸以爨。’","book":"《左传·宣公十五年》"},"example":{"text":"沧州被围百余日，城中食尽，人自相食，～，或丸墐土而食，死者十六七。","book":"《新五代史·刘守光传》"}},{"id":26362,"word":"枕中鸿宝","pinyin":"zhěn zhōng hóng bǎo","abbr":"zzhb","explanation":"泛指珍秘的书籍。","source":{"text":"《鸿宝》、《苑秘书》，并道术篇名。臧在枕中，言常存录之不漏泄也。","book":"《汉书·刘向传》：“上（宣帝）复兴神仙方术之事，而淮南有枕中《鸿宝》、《苑秘书》。书言神仙使鬼物为金之术，及邹衍重道延命方，世人莫见。”颜师古注"},"example":{"text":"《叙事解疑》一帙，珍之五十一年矣，以为枕中《鸿宝》，足佐千秋秘籍。","book":"清·任安上《与吴拜经书》"},"usage":"作宾语、定语；用于书面语"},{"id":26363,"word":"枕典席文","pinyin":"zhěn diǎn xí wén","abbr":"zdxw","explanation":"指以典籍为伴，勤于读书学习。","source":{"text":"虚左致贤，设坐来宾。筵床对儿，盛养已陈。肴仁饭义，枕典席文。","book":"汉·李尤《床儿铭》"},"usage":"作谓语、定语；用于书面语"},{"id":26364,"word":"枕冷衾寒","pinyin":"zhěn lěng qīn hán","abbr":"zlqh","explanation":"枕被俱冷。形容独眠的孤寂凄凉。","source":{"text":"便枕冷衾寒，凤只鸾孤，月圆云遮，寻思来有甚伤嗟。","book":"元·王实甫《西厢记》第四本第四折"},"example":{"text":"我敢一上青山便化身，从今年内后～，索自温存。","book":"明·贾仲名《对玉梳》第一折"},"similar":["孤枕难眠"],"usage":"作宾语、定语；指孤单"},{"id":26365,"word":"枕善而居","pinyin":"zhěn shàn ér jū","abbr":"zsej","explanation":"指守善不移。","source":{"text":"故蘧瑷不以昏行变节，颜回不以夜浴改容……斯皆慎乎隐微，枕善而居，不以视之不见而移其心，听之不闻而变其情也。","book":"北齐·刘昼《新论·慎独》"},"usage":"作谓语、定语；用于处事"},{"id":26366,"word":"枕山栖谷","pinyin":"zhěn shān qī gǔ","abbr":"zsqg","explanation":"比喻过隐居生活。","source":{"text":"诚遂欲枕山栖谷，拟迹巢、由，斯则可矣。","book":"《后汉书·黄琼传》"},"similar":["枕流漱石"],"usage":"作谓语、宾语、定语；指隐居生活"},{"id":26367,"word":"枕山臂江","pinyin":"zhěn shān bì jiāng","abbr":"zsbj","explanation":"指依山傍水。","source":{"text":"庆元据会稽之东，枕山臂江，负溟渤，控扶桑。","book":"宋·王应麟《玉海·地理·州镇》"},"similar":["依山傍水"],"usage":"作谓语、定语；用于书面语"},{"id":26368,"word":"枕山襟海","pinyin":"zhěn shān jīn hǎi","abbr":"zsjh","explanation":"靠山依海。","source":{"text":"本朝武宁王徐达经略北边，谓是枕山襟海，实辽蓟咽喉，乃移关于此，连引长城为城之址。","book":"明·蒋一葵《长安客话·古榆关》"},"similar":["枕山负海"],"usage":"作谓语、定语；用于书面语"},{"id":26369,"word":"枕山负海","pinyin":"zhěn shān fù hǎi","abbr":"zsfh","explanation":"靠山依海。同“枕山襟海”。","source":{"text":"台之缑城，枕山负海。","book":"明·张煌言《山头重筑海塘碑记》"},"similar":["枕山襟海"],"usage":"作谓语、定语；用于书面语"},{"id":26370,"word":"枕岩漱流","pinyin":"zhěn yán shù liú","abbr":"zysl","explanation":"指隐居山林。同“枕石漱流”。","source":{"text":"俗议多云，欢足本在华堂，枕岩漱流者乏于大志，故保其枯槁。余谓不然。","book":"南朝·宋·谢灵运《游名山志》"},"similar":["枕石漱流","枕流漱石"],"usage":"作谓语、宾语、定语；指隐居生活"},{"id":26371,"word":"枕席过师","pinyin":"zhěn xí guò shī","abbr":"zxgs","explanation":"师：军队。军队从桥上渡河，如在枕席上通过那样安稳而容易。","source":{"text":"治湟陿中道桥，令可至鲜水，以制西域，信威千里，从枕席上过师，十一也。","book":"东汉·班固《汉书·赵充国传》"},"example":{"text":"若乃饮马天堑，欲渡狐疑，宜用浮桥，～。","book":"清·魏源《城守篇·制胜下》"},"similar":["枕席还师"],"usage":"作宾语、定语；用于军事等"},{"id":26372,"word":"枕席还师","pinyin":"zhěn xí huán shī","abbr":"zxhs","explanation":"形容行军道路极其平坦安稳。同“枕席过师”。","source":{"text":"必当樽俎制胜，枕席还师，势如风霆，功在刻漏。","book":"唐·李德裕《赠王茂元司徒制》"},"similar":["枕席过师"],"usage":"作宾语、定语；用于军事等"},{"id":26373,"word":"枕干之雠","pinyin":"zhěn gàn zhī chóu","abbr":"zgzc","explanation":"指不共戴天的仇恨。"},{"id":26374,"word":"枕干而寝","pinyin":"zhěn gān ér qǐn","abbr":"zgeq","explanation":"干：盾。枕着盾牌睡觉。形容时刻不忘复仇。","source":{"text":"子夏问于孔子曰：‘居父母之仇，如之何？’夫子曰：‘寝苫，枕干，不仕，弗与天下也。’","book":"《礼记·檀弓上》"},"example":{"text":"～，见星而行，号泣不绝声者千里，水浆不入口者数日。（唐·杨炯《泸川都督王湛神道碑》）"},"usage":"作谓语、定语；用于书面语"},{"id":26375,"word":"枕戈以待","pinyin":"zhěn gē yǐ dài","abbr":"zgyd","explanation":"枕着兵器，等待天亮。形容杀敌报国心切。同“枕戈待旦”。","source":{"text":"臣虽驽钝，亦当枕戈以待。","book":"明·张煌言《上行在陈南北机宜疏》"},"example":{"text":"［仁皇］与李文贞光地谈《易》，每至子夜，诸待从多～。","book":"清·昭梿《啸亭杂录·优容大臣》"},"similar":["枕戈达旦","枕戈待旦"],"usage":"作谓语、定语、状语；指提防"},{"id":26376,"word":"枕戈击楫","pinyin":"zhěn gē jī jí","abbr":"zgjj","explanation":"枕着兵器，拍击船桨。形容杀敌心切，志节慷慨。","source":{"text":"便凭着这肝胆轮囷，枕戈击楫，逐鞑虏早复神京也呵！","book":"清·浴日生《海国英雄记·坐朝》"},"similar":["枕戈待旦","击楫中流"],"usage":"作谓语、定语；用于书面语"},{"id":26377,"word":"枕戈剚刃","pinyin":"zhěn gē zì rèn","abbr":"zgzr","explanation":"指准备杀敌复仇。剚刃，用刀剑插入物体。","source":{"text":"此则枕戈剚刃之事，秦赵已不能施于白项，而汉族犹可施于满洲，章章明矣。","book":"章炳麟《驳康有为论革命书》"},"usage":"作谓语、定语；用于书面语"},{"id":26378,"word":"枕戈坐甲","pinyin":"zhěn gē zuò jiǎ","abbr":"zgzj","explanation":"唐·令狐德棻等《周书·文帝纪上》：“如其首鼠两端，不时奉诏，专戮违旨，国有常刑，枕戈坐甲，指日相见。”","source":{"text":"掖垣琐闼之地，皆～之人。 ★清·钱谦益《李遇知》"},"example":{"text":"清·钱谦益《李遇知》：“掖坦琐闼之地，皆～之人。”"},"similar":["枕戈披甲"],"usage":"作谓语、定语；用于书面语"},{"id":26379,"word":"枕戈寝甲","pinyin":"zhěn gē qǐn jiǎ","abbr":"zgqj","explanation":"枕着戈、穿着铠甲睡。形容经常生活在战争之中。","source":{"text":"朕无拔乱之才，不能弘济兆庶，自枕戈寝甲，十有二年，而四海未同。遗寇尚炽。","book":"《晋书·赫连勃勃载记》"},"similar":["枕戈待旦"],"opposite":["高枕无忧"],"usage":"作谓语、定语；形容常备不懈"},{"id":26380,"word":"枕戈尝胆","pinyin":"zhěn gē cháng dǎn","abbr":"zgcd","explanation":"头枕兵器，口尝苦胆。形容刻苦自励，发愤图强，或报仇雪耻心切。","source":{"text":"陛下英略纬天，沉明内断，横剑泣血，枕戈尝胆。","book":"南朝·梁·沈初明《劝进梁元帝第三表》"},"example":{"text":"今日之事，正当～，内修外攘，使刑政修而中国强，则二帝不俟迎请而自归。","book":"元·脱脱《宋史·李纲传》"},"similar":["枕戈饮胆"],"usage":"作谓语、定语、宾语；用于处事"},{"id":26381,"word":"枕戈待命","pinyin":"zhěn gē dài mìng","abbr":"zgdm","explanation":"枕着武器等待命令。形容时刻准备战斗。","source":{"text":"张统制现带有可靠军队数营，在汉口刘家庙枕戈待命。","book":"中国近代史资料丛刊《辛亥革命·武昌起义》"},"similar":["枕戈待敌"],"usage":"作谓语、定语；用于处事"},{"id":26382,"word":"枕戈待敌","pinyin":"zhěn gē dài dí","abbr":"zgdd","explanation":"枕着兵器等待迎敌。形容时刻准备杀敌。","source":{"text":"结垒新亭，枕戈待敌……锋镝初交，元恶送首。","book":"《南齐书·褚渊传》"},"similar":["枕戈待命"],"usage":"作谓语、定语；用于处事"},{"id":26383,"word":"枕戈待旦","pinyin":"zhěn gē dài dàn","abbr":"zgdd","explanation":"戈：古代的一种兵器；旦：早晨。意思是立志杀敌，枕着武器睡觉等天亮。形容时刻准备作战，。","source":{"text":"吾枕戈待旦，志枭逆虏。","book":"《晋书·刘琨传》"},"example":{"text":"我先前只知道武将大抵通文，当“～”的时候，就会做骈体电报，这回才明白虽是文官，也有深谙韬略的了。","book":"鲁迅《准风月谈·冲》"},"similar":["枕戈坐甲","枕戈以待"],"opposite":["醉生梦死","高枕无忧"],"usage":"作谓语、定语、状语；指提防","story":["晋朝时期，年轻有为的刘琨胸怀大志，想为国家出力，他的好友祖逖被选拔为官。他发誓要像祖逖那样为国分忧。后来他被选拔为官，从司隶一直做到尚书郎，领导晋阳灾区人民重建家园，用计巧退胡兵，实现了从前枕戈待旦时的远大理想"]},{"id":26384,"word":"枕戈披甲","pinyin":"zhěn gē pī jiǎ","abbr":"zgpj","explanation":"以戈为枕，披甲而坐。形容常备不懈，时刻准备战斗。 同“枕戈坐甲”。","source":{"text":"今日之事，将因一乡而累及一邑，因一邑而累及一省。此非有人维持调护之，则外军枕戈披甲之士，抑郁不扬。","book":"清·龙翰臣《复唐子实书》"},"similar":["枕戈坐甲"],"usage":"作谓语、定语；用于书面语"},{"id":26385,"word":"枕戈汗马","pinyin":"zhěn gē hàn mǎ","abbr":"zghm","explanation":"枕着武器，疾驰战马。形容时刻准备杀敌立功。","source":{"text":"念亲恩主德总来难报，须教，枕戈汗马，努力塞云边草，儿时得功成大漠，鹤归华表。","book":"明·屠隆《昙花记·公子受封》"},"example":{"text":"臣非不知兵凶战危，而～，切齿痛心有日矣。","book":"《明史·曾铣传》"},"usage":"作谓语、定语；用于书面语"},{"id":26386,"word":"枕戈泣血","pinyin":"zhěn gē qì xuè","abbr":"zgqx","explanation":"枕着兵器，哭泣见血。形容极度悲愤，矢志杀敌雪恨。","source":{"text":"枕戈泣血，志在复雠。","book":"唐·房玄龄《晋书·桓温传》"},"example":{"text":"君父变出非常，公专阃外，义当～，以激同雠。","book":"明·黄宗羲《子刘紫行状》"},"usage":"作谓语、定语；用于书面语"},{"id":26387,"word":"枕戈达旦","pinyin":"zhěn gē dá dàn","abbr":"zgdd","explanation":"枕着兵器，等待天亮。形容杀敌报国心切。同“枕戈待旦”。","source":{"text":"夜宿城楼，枕戈达旦。训将练兵，常如寇至。","book":"清·张廷玉《明史·吴良传》"},"example":{"text":"陛下当～，以报父兄之仇，不可听信庸人，狃于和议。","book":"清·陈忱《水浒后传》第三十七回"},"similar":["枕戈待旦","枕戈以待"],"usage":"作谓语、定语、状语；指提防"},{"id":26388,"word":"枕戈饮胆","pinyin":"zhěn gē yǐn dǎn","abbr":"zgyd","explanation":"头枕兵器，口尝苦胆。形容刻苦自励，发愤图强，或报仇雪耻心切。同“枕戈尝胆”。","source":{"text":"孤以不德，天降之灾，枕戈饮胆，扣心泣血。","book":"唐·姚思廉《梁书·元帝纪》"},"similar":["枕戈尝胆"],"usage":"作谓语、定语、宾语；用于处事"},{"id":26389,"word":"枕戈饮血","pinyin":"zhěn gē yǐn xuè","abbr":"zgyx","explanation":"枕着武器，咽着血泪。形容极度悲愤，矢志报仇杀敌。","source":{"text":"然所以如此披甲厉兵，～者，非好为首先发难，徒负光复汉家之虚誉，实以祖仇所在，人心所趋。 ★中国近代史资料丛刊《辛亥革命·武昌起义》"},"example":{"text":"《辛亥革命·武昌起义》：“然所以如此披甲厉兵，～者，非好为首先发难，徒负光复汉家之虚誉，实以祖仇所在，人心所趋。”"},"usage":"作谓语、定语；用于书面语"},{"id":26390,"word":"枕方寝绳","pinyin":"zhěn fāng qǐn shéng","abbr":"zfqs","explanation":"枕方石，睡绳床。","source":{"text":"寝绳谓织绳为床，人寝其上。","book":"《淮南子·览冥训》：“和春阳夏，杀秋约冬，枕方寝绳。”高诱注：“方，榘四寸也。寝绳，直身而卧也。”杨树达证闻"},"similar":["枕石寝绳"],"usage":"作谓语、定语；用于书面语"},{"id":26391,"word":"枕曲藉糟","pinyin":"zhěn qū jiè zāo","abbr":"zqjz","explanation":"枕着酒，垫着酒糟。指嗜酒，醉酒。","source":{"text":"先生于是方捧罂承糟，衔杯漱醪，奋髯箕踞，枕曲藉糟，无思无虑，其乐陶陶。","book":"《晋书·刘伶传》"},"example":{"text":"自饮一杯，仍要见～之态，对席者作雷声，左邻作蜂声，右邻作蠢蠢状。","book":"元·曹绍《安雅堂酒令》"},"usage":"作谓语、定语；用于比喻句"},{"id":26392,"word":"枕流漱石","pinyin":"zhěn liú shù shí","abbr":"zlss","explanation":"旧时指隐居生活。","source":{"text":"王曰：‘流可枕，石可漱乎？’孙曰：‘所以枕流，欲洗其耳；所以漱石，欲砺其齿。’","book":"南朝宋·刘义庆《世说新语·排调》"},"example":{"text":"～君家事，思与参军仔细论。","book":"清·严复《次韵答孙生》"},"similar":["枕山栖谷","枕石漱流"],"usage":"作谓语、宾语、定语；指隐居生活"},{"id":26393,"word":"枕石嗽流","pinyin":"zhěn shí shù liú","abbr":"zssl","explanation":"指隐居山林。同“枕石漱流”。","source":{"text":"故曰去就有二途而仕隐无两道，苟徒枕石嗽流，嘲弄烟月以为旷达，而曰世与我既相违矣，则余又何敢以此望君，且非君所以自待也。","book":"明·唐顺之《送彭通判致仕序》"},"similar":["枕石漱流","枕岩漱流","枕流漱石"],"usage":"作谓语、宾语；指隐居生活"},{"id":26394,"word":"枕石寝绳","pinyin":"zhěn shí qǐn shéng","abbr":"zsqs","explanation":"枕方石，睡绳床。同“枕方寝绳”。","source":{"text":"《文子·精诚》:“虑牺氏之王天下也，枕石寝绳，杀秋约冬，负方州，抱员天。”"},"example":{"text":"我们想象不出～生活是怎样的"},"similar":["枕方寝绳"],"usage":"作谓语、定语；用于书面语"},{"id":26395,"word":"枕石漱流","pinyin":"zhěn shí sòu liú","abbr":"zssl","explanation":"旧时指隐居生活。","source":{"text":"伏见处士緜竹秦宓，膺山甫之德，履隽生之直，枕石漱流，吟咏缊袍，偃息于仁义之途，恬淡于浩然之域，高概节行，守真不亏，虽古人潜遁，蔑以加旃。","book":"《三国志·蜀志·彭羕传》"},"example":{"text":"只如野逸高士，尚解～。","book":"宋·释道原《景德传灯录》卷二十八"},"similar":["枕流漱石","枕石漱流","枕岩漱流"],"usage":"作谓语、宾语；指隐居生活"},{"id":26396,"word":"枕稳衾温","pinyin":"zhěn wěn qīn wēn","abbr":"zwqw","explanation":"形容生活舒适安逸。","source":{"text":"枕稳衾温梦不回，闲居不怕漏声催。","book":"宋·楼钥《早起戏作》诗"},"usage":"作宾语、定语；用于书面语"},{"id":26397,"word":"枕籍经史","pinyin":"zhěn jí jīng shǐ","abbr":"zjjs","explanation":"枕着经典，垫着史书。形容专心一意读书。","source":{"text":"李彭家贫绩学，枕籍经史，诗文能兼诸家之长。","book":"清·张泰来《江西诗社宗派图录》"},"similar":["枕经籍书"],"usage":"作谓语、定语；用于书面语"},{"id":26398,"word":"枕籍诗书","pinyin":"zhěn jí shī shū","abbr":"zjss","explanation":"籍：通“藉”，铺垫。以经书、史书作为枕头和铺垫。形容沉湎于图书资料中。","source":{"text":"夫重怀古道，枕籍诗书，危不能安，乱不能治。","book":"汉·桓宽《盐铁论·殊路》"},"usage":"作谓语、定语；用于书面语"},{"id":26399,"word":"枕经籍书","pinyin":"zhěn jīng jí shū","abbr":"zjjs","explanation":"枕着经，垫着书。形容酷嗜读书，以书为伴。","source":{"text":"枕经典而卧，铺诗书而居也。","book":"《文选·班固〈答宾戏〉》“徒乐枕经籍书，纡体衡门，上无所蒂，下无所根。”吕向注"},"similar":["枕籍经史"],"usage":"作谓语、定语；用于书面语"},{"id":26400,"word":"枕麹藉糟","pinyin":"zhěn qū jiè zāo","abbr":"zqjz","explanation":"枕着酒，垫着酒糟。谓嗜酒，醉酒。","source":{"text":"奋髯踑踞，枕麹藉糟。","book":"语出《文选·刘伶〈酒德颂〉》"}},{"id":26401,"word":"枕黮藉糟","pinyin":"zhěn qū jiè zāo","abbr":"zqjz","explanation":"枕着酒，垫着酒糟。谓嗜酒，醉酒。"},{"id":26402,"word":"林下之风","pinyin":"lín xià zhī fēng","abbr":"lxzf","explanation":"林下：幽僻之境；风：风度。指女子态度娴雅、举止大方。","source":{"text":"王夫人神情散朗，故有林下风气。","book":"南朝·宋·刘义庆《世说新语·贤媛》"}},{"id":26403,"word":"林下清风","pinyin":"lín xià qīng fēng","abbr":"lxqf","explanation":"指女子态度娴雅、举止大方。同“林下风气”。","source":{"text":"我思女子之中，若通些文艺，必竟脱俗，就是不美，自有一种文雅可观，料不是油盐酱醋的恶气。必然言谈举止，都带些林下清风。","book":"《天雨花》第一回"},"similar":["林下高风"],"usage":"作宾语；用于女性"},{"id":26404,"word":"林下神仙","pinyin":"lín xià shén xiān","abbr":"lxsx","explanation":"林下：幽僻之境。指不问世事，潇洒处在的隐士。","source":{"text":"试问朝中为宰相，何如林下作神仙。","book":"唐·张令问《与杜光庭》"}},{"id":26405,"word":"林下风度","pinyin":"lín xià fēng dù","abbr":"lxfd","explanation":"称颂妇女娴雅飘逸的风采。","source":{"text":"岂古人所谓有林下风范的，就是这样吗？","book":"清·刘鹗《老残游记》第八回"},"example":{"text":"清·刘鹗《老残游记》第八回：“岂古人所谓有林下风范的，就是这样吗？”"},"similar":["林下风范"],"usage":"作宾语；用于女性"},{"id":26406,"word":"林下风气","pinyin":"lín xià fēng qì","abbr":"lxfq","explanation":"林下：幽僻之境；风气：风度。指女子态度娴雅、举止大方。","source":{"text":"王夫人神情散朗，故有林下风气。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"举目看十八姨，体态飘逸，言词泠泠，有～。","book":"明·冯梦龙《醒世恒言》"},"similar":["林下风范"],"usage":"作宾语；用于女性"},{"id":26407,"word":"林下风致","pinyin":"lín xià fēng zhì","abbr":"lxfz","explanation":"指女子态度娴雅、举止大方。同“林下风气”。","source":{"text":"妇人薛涛，成都倡妇也。以诗名当时，虽失身卑下，而有林下风致。","book":"《宣和书谱》卷十"},"example":{"text":"赵国夫人王氏，端献王妇，王审琦后，作篆隶有古法，为小诗有～。","book":"元·夏文彦《图绘宝鉴》卷三"},"similar":["林下风气"],"usage":"作宾语；用于女性"},{"id":26408,"word":"林下风范","pinyin":"lín xià fēng fàn","abbr":"lxff","explanation":"林下：幽僻之境；风范：风度。指女子态度娴雅、举止大方。","source":{"text":"王夫人神情散朗，故有林下风气。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"这女子何以如此大方？岂古人所谓有～的，就是这样吗？","book":"清·刘鹗《老残游记》第八回"},"similar":["林下风气"],"usage":"作宾语；指女子态度娴雅、举止大方"},{"id":26409,"word":"林下风韵","pinyin":"lín xià fēng yùn","abbr":"lxfy","explanation":"指女子态度娴雅、举止大方。同“林下风气”。","source":{"text":"谢道韫，虽是夫人，却有林下风韵，是谓秀中现雅。","book":"明·徐渭《跋书卷尾一》"},"similar":["林下风气","林下风致"],"usage":"作宾语；用于女性"},{"id":26410,"word":"林下高风","pinyin":"lín xià gāo fēng","abbr":"lxgf","explanation":"指女子态度娴雅、举止大方。同“林下风气”。","source":{"text":"王夫人神情散朗，故有林下风气。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"example":{"text":"因访之老先生令爱小姐，乃闺中名秀，又擅～，诚当今之淑女，愿以丝萝仰乔木久矣。","book":"清·明教中人《好逑传》第十三回"},"similar":["林下风气","林下清风"],"usage":"作宾语；用于女性"},{"id":26411,"word":"林寒洞肃","pinyin":"lín hán dòng sù","abbr":"lhds","explanation":"寒：寒冷；肃：肃杀。形容秋冬时林木萧疏，溪涧浅落的景象。","source":{"text":"每晴初霜旦，林寒涧肃，常有高猿长啸，属引凄异。","book":"北朝·后魏·郦道元《水经注·江水》"}},{"id":26412,"word":"林寒涧肃","pinyin":"lín hán jiàn sù","abbr":"lhjs","explanation":"指秋冬间林木凋零、涧水枯落的景象。","source":{"text":"每晴初霜旦，林寒涧肃，常有高猿长啸，属引凄异。","book":"北朝·后魏·郦道元《水经注·江水》"},"example":{"text":"每至晴初霜旦，～，常有高猿长啸，属引凄异，空谷传响，哀转久绝。","book":"宋·范仲淹《岳阳楼记》"},"usage":"作宾语、定语；用于景物描写"},{"id":26413,"word":"林林总总","pinyin":"lín lín zǒng zǒng","abbr":"llzz","explanation":"林林：众多的样子；总总：众多而杂乱的样子。形容众多。","source":{"text":"惟人之初，总总而生，林林而群。","book":"唐·柳宗元《贞符》"},"example":{"text":"在～的这类故事中，也有一个是说鲁班学习海龙王宫殿的建筑艺术。","book":"秦牧《鲁班的妙手》"},"similar":["丰富多采","形形色色"],"usage":"作谓语、定语；形容人或事物众多"},{"id":26414,"word":"林栖谷隐","pinyin":"lín qī gǔ yǐn","abbr":"lqgy","explanation":"指在山林隐居。亦指隐居的人。","source":{"text":"迩来林栖谷隐，栉比鳞差。","book":"五代·王定保《唐摭言·慈恩寺题名游赏赋咏杂纪》"}},{"id":26415,"word":"林籁泉韵","pinyin":"lín lài quán yùn","abbr":"llqy","explanation":"风吹林木和泉石相激而产生的悦耳声音。泛指天籁。","source":{"text":"故凡虎斑霞绮，林籁泉韵，俱为文章。","book":"鲁迅《汉文学史纲要·自文字至文章》"}},{"id":26416,"word":"枘凿冰炭","pinyin":"ruì záo bīng tàn","abbr":"rzbt","explanation":"比喻事物尖锐对立，互不相容。参见“枘凿方圆”。","source":{"text":"愚谓欢所引道经颇确，老子子即佛，本是一人，故无二法……惟与吾儒，则如枘凿冰炭之不相合耳。","book":"清王鸣盛《十七史商榷·南史合宋齐梁陈书十二·顾欢论道佛二家》"},"usage":"作宾语、定语；用于比喻句"},{"id":26417,"word":"枘凿方圆","pinyin":"ruì záo fāng yuán","abbr":"rzfy","explanation":"枘、凿，榫头与卯眼。一方一圆，则无法投合。比喻不调协，扞格不入。","source":{"text":"一官寥落误儒绅，枘凿方圆迕世情。","book":"明吾邱瑞《运甓记弃官就辟》"},"example":{"text":"毕箕风雨难凭准，～费弥缝。","book":"清钱谦益《续次敬仲韵》之二"},"usage":"作宾语、定语；用于书面语"},{"id":26418,"word":"枘圆凿方","pinyin":"rùi yuán záo fāng","abbr":"ryzf","explanation":"比喻不调协，扞格不入。参见“枘凿方圆”。","source":{"text":"圆凿而方枘兮，吾固知其龃龉而难入。","book":"战国·楚·宋玉《九辨》"},"example":{"text":"则日东月西，何缘相会，～，入于参差。","book":"清·名教中人《好逑传》第15回"},"similar":["方凿圆枘"],"usage":"作宾语、定语；指两不投合"},{"id":26419,"word":"枚速马工","pinyin":"mǎ gōng méi sù","abbr":"msmg","explanation":"工：工巧；速：速度快。原指枚皋文章写得多，司马相如文章写得工。后用于称赞各有长处。","source":{"text":"为文疾，受诏辄成，故所赋者多；司马相如善为文而迟，故所作少而善于皋。","book":"《汉书·枚乘传》"},"similar":["马工枚速"],"usage":"作宾语；用于称赞各有长处"},{"id":26420,"word":"果不其然","pinyin":"guǒ bù qí rán","abbr":"gbqr","explanation":"果然如此。指事物的发展变化跟预料的一样。","source":{"text":"昨日人去请我，我就说嫂子有个好意，果不其然。","book":"清·西周生《醒世姻缘传》第二十二回"},"example":{"text":"我说姑老爷今非昔比，少不得有人把银子送上门去给他用，只怕姑老爷还不稀罕哩，今日果不其然。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["果然如此","不出所料"],"usage":"作谓语、分句；指果然不出所料"},{"id":26421,"word":"果于自信","pinyin":"guǒ yú zì xìn","abbr":"gyzx","explanation":"果：果敢。形容过分自信。","source":{"text":"皇子果于自信，果于诬理哉？","book":"《列子·汤问》"},"usage":"作谓语；指过分自信"},{"id":26422,"word":"果出所料","pinyin":"guǒ chū suǒ liào","abbr":"gcsl","explanation":"果：果真，诚然。指对事物的发展变化判断准确，果真和预料一致。","example":{"text":"～，我们取得了冠军。"},"similar":["果如所料"],"usage":"作分句；用于口语"},{"id":26423,"word":"果刑信赏","pinyin":"guǒ xíng xìn shǎng","abbr":"gxxs","explanation":"指赏罚严明。"},{"id":26424,"word":"果如其言","pinyin":"guǒ rú qí yán","abbr":"grqy","explanation":"果然象他说的那样。指事情的变化和预想的一样。","source":{"text":"坐吕后逼蹴，从求安太子之计，良不得已，为画四皓之策。果如其言，吕后德之，而逼令强食之，故令其道不成耳。","book":"《抱朴子·至理》"},"similar":["果然如此"],"usage":"作谓语、分句；用于书面语"},{"id":26425,"word":"果如所料","pinyin":"guǒ rú suǒ liào","abbr":"grsl","explanation":"事物的发展趋向和结果同事先预料的相符合。","source":{"text":"始，上怒未已，两府窃议曰：‘必重贬介，则彦博不安；彦博去，即吾属递迁矣。’既而，果如所料。","book":"宋·胡仔《苕溪渔隐丛话前集·梅圣俞》"},"similar":["料事如神","果出所料"],"usage":"作谓语、分句；指料事如神"},{"id":26426,"word":"果然如此","pinyin":"guǒ rán rú cǐ","abbr":"grrc","explanation":"果真是这样。指不出所料。","source":{"text":"诸葛恪多辈耳！近张敬仲县论格，以为必见杀，今果然如此。","book":"晋·陈寿《三国志·魏志·张既传》南朝·宋·裴松之注引《魏略》"},"example":{"text":"侵略战争必定要失败，这一仗～。"},"similar":["果不其然"],"opposite":["事与愿违"],"usage":"作谓语、分句；指不出所料"},{"id":26427,"word":"果熟蒂落","pinyin":"guǒ shú dì luò","abbr":"gsdl","explanation":"指果实成熟，果蒂自然脱落。也比喻时机一旦成熟，事情自然成功。","source":{"text":"他们都是当时文坛上朵朵怒放的奇花，花褪残红后，结了硕大深红的果子，果熟蒂落，他们一个个地自己贡献出来。","book":"冰心《悼念茅公》"},"similar":["瓜熟蒂落"],"usage":"作谓语、宾语；指时机一旦成熟，事情自然成"},{"id":26428,"word":"果行育德","pinyin":"guǒ xíng yù dé","abbr":"gxyd","explanation":"以果断的行动培养高尚的道德。","source":{"text":"君子以果行育德。","book":"《易·蒙》"},"example":{"text":"何善不可为，何福不可致，～，孰大于是！","book":"清·冯桂芬《上海果育堂记》"},"usage":"作谓语、宾语；用于书面语"},{"id":26429,"word":"枝分叶散","pinyin":"zhī fēn yè sàn","abbr":"zfys","explanation":"比喻后裔支派分布甚广。同“枝布叶分”。","source":{"text":"唐杨炯《为薛令祭刘少监文》:“惟此陶唐，有此冀方。上天祚汉，人神攸赞。开国承家，枝分叶散。三貂赫赫于台省，驷马谖谖于里閈。”"},"similar":["枝流叶布","枝布叶分"],"usage":"作宾语、定语；用于比喻句"},{"id":26430,"word":"枝分缕解","pinyin":"zhī fēn lǚ jiě","abbr":"zflj","explanation":"指详尽而有条不紊地辨别分析。","source":{"text":"事至则剖晰毫厘，枝分缕解，辨穷万变，而断以片言。","book":"清曾国藩《户部员外郎彭君墓表》"},"usage":"作定语、状语；用于比喻句"},{"id":26431,"word":"枝别条异","pinyin":"zhī bié tiáo yì","abbr":"zbty","explanation":"比喻头绪纷乱。","source":{"text":"臣伏见陛下思光先绪，以典籍为本，而史书枝别异，不同一贯。","book":"汉张衡《求合正三史表》"},"usage":"作谓语、定语；用于书面语"},{"id":26432,"word":"枝叶扶疏","pinyin":"zhī yè fú shū","abbr":"zyfs","explanation":"①形容枝叶繁茂四布，高下疏密有致。②比喻分析事理详明缜密。③比喻兴旺发展。","source":{"text":"草木之生，始于萌芽，终于弥蔓，枝叶扶疏，荣华纷缛，末虽繁蔚，致诸根也。","book":"《后汉书·延笃传》"},"example":{"text":"顾默然而作《太玄》五千言，～，独说十余万言。","book":"汉扬雄《解嘲》"},"similar":["枝繁叶茂","子孙满堂"],"usage":"作主语、宾语；形容树木长势良好"},{"id":26433,"word":"枝叶扶苏","pinyin":"zhī yè fú sū","abbr":"zyfs","explanation":"形容枝叶繁茂四布，高下疏密有致。","source":{"text":"万目攒视，见有勾萌出，渐大；俄成树，枝叶扶苏，倏而花，倏而实，硕大芳馥，累累满树。","book":"清·蒲松龄《聊斋志异·种梨》"},"similar":["枝叶扶疏","支叶扶疏"],"usage":"作主语、宾语；形容树木长势良好"},{"id":26434,"word":"枝叶相持","pinyin":"zhī yè xīng chí","abbr":"zyxc","explanation":"比喻相互扶助。","source":{"text":"自幽平之后，日以陵夷，至虎厄沤河洛之间，分为二周围……既于王赧，降为庶人，用天年终。号位已绝于天下，沿犹枝叶相持，莫得居其虚位，海内无主，三十余年。","book":"《汉书诸侯王表序》"},"similar":["枝干相持"],"usage":"作宾语、定语；用于比喻句"},{"id":26435,"word":"枝叶硕茂","pinyin":"zhī yè shuò mào","abbr":"zysm","explanation":"硕：大；茂：茂盛。枝叶大而茂密。比喻子孙繁衍，家族兴旺。","source":{"text":"侯王之祉，祚及宗子，公族蕃滋，支叶硕茂。","book":"《汉书·叙传下》"}},{"id":26436,"word":"枝外生枝","pinyin":"zhī wài shēng zhī","abbr":"zwsz","explanation":"比喻派生、繁衍而出者。同“节外生枝”。","source":{"text":"善观场者，止于前数出所见，记其人之姓名。十出以后， 皆是枝外生枝，节中长节，如遇行路之人，非止不问姓字，并形体面目，皆可不必认矣。","book":"清李渔《闲情偶寄·词曲·格局》"},"similar":["节外生枝"],"usage":"作宾语、定语；用于书面语"},{"id":26437,"word":"枝大于本","pinyin":"zhī dà yù běn","abbr":"zdyb","explanation":"树枝比树干大。比喻臣下势力超过皇上。","source":{"text":"灌夫通奸猾，侵细民，家累巨万，横恣颖川，凌轹宗室，侵犯骨肉，此所谓‘枝大于本，胫大于股，不折必披。’","book":"《史记·魏其武安侯列传》"},"usage":"作宾语、定语；用于比喻句"},{"id":26438,"word":"枝对叶比","pinyin":"zhī duì yè bǐ","abbr":"zdyb","explanation":"枝叶相对并列。比喻骈体文对偶句式。","source":{"text":"及其大坏也，俪偶章句，使枝对叶比，以八病四声为梏拳，拳拳守之，如奉法令。","book":"唐独孤及《检校尚书吏部员外郎赵郡李公中集序》"},"usage":"作宾语、定语；用于书面语"},{"id":26439,"word":"枝布叶分","pinyin":"zhī bù yè fēn","abbr":"zbyf","explanation":"比喻后裔支派分布甚广。","source":{"text":"子孙繁衍，枝布叶分，始承其本，末取其别，故其流至于百姓万姓。","book":"《左传·隐公八年》“胙之土而命之氏”唐孔颖达疏"},"similar":["枝分叶散","枝流叶布"],"usage":"作宾语、定语；用于比喻句"},{"id":26440,"word":"枝干相持","pinyin":"zhī gàn xiāng xhí","abbr":"zgxc","explanation":"比喻相互扶持。同“枝叶相持”。","source":{"text":"暨乎战国，诸姬微矣……至于王赧，降为庶人，犹枝干相持，得居虚位。","book":"三国魏曹冏《六代论》"},"similar":["枝叶相持"],"usage":"作宾语、定语；用于比喻句"},{"id":26441,"word":"枝木之冠","pinyin":"zhī mù zhī guān","abbr":"zmzg","explanation":"冠：帽子。冠多华饰，好像树木的繁枝","source":{"text":"冠枝木之冠，带死牛之胁。","book":"战国·宋·庄周《庄子·盗跖》"},"usage":"作宾语；用于书面语"},{"id":26442,"word":"枝末生根","pinyin":"zhī mò shēng gēn","abbr":"zmsg","explanation":"树木的枝梢上生根。比喻不合事理，不可能。","source":{"text":"起承转收以诗……一篇之中，四起四收，非喏虫相衔成青竹蛇而何？两间万物之生，无有尻下出头，枝末生根之理。","book":"清王夫之《姜斋诗话》卷下"},"usage":"作宾语、定语；用于书面语"},{"id":26443,"word":"枝流叶布","pinyin":"zhī liú yè bù","abbr":"zlyb","explanation":"比喻后裔支派分布甚广。同“枝布叶分”。","source":{"text":"公讳咸，字元卓，汝南西平人。盖秦将李信之后，孝武大将军广之胄也。枝流叶布，家于兹土。","book":"汉·蔡邕《太尉汝南李公碑》"},"similar":["枝分叶散","枝布叶分"],"usage":"作宾语、定语；用于比喻句"},{"id":26444,"word":"枝源派本","pinyin":"zhī yuán pài běn","abbr":"zypb","explanation":"指寻根究源，寻求和追究事物的根本。","source":{"text":"天台陈耆卿生晚而又独学，奚遽笔之书？然观其简峻捷疾，会心切己，则非熟于其统要者不能入也；总括凝聚，枝源派本，则非博于其伦类者不能推也。","book":"宋·叶滴《题陈寿老论孟纪蒙》"},"similar":["寻根究源"],"usage":"作谓语、定语；用于书面语"},{"id":26445,"word":"枝繁叶茂","pinyin":"zhī fán yè mào","abbr":"zfym","explanation":"枝叶繁密茂盛。","source":{"text":"愿人间天上共效绸缪，贺郎君玉润水清，祝小姐枝繁叶茂。","book":"明·孙柚《琴心记》"},"example":{"text":"昔日的小树林现在已经是～了。"},"similar":["枝叶扶疏","生机勃勃","兴旺发达"],"opposite":["死气沉沉"],"usage":"作谓语、宾语、定语；指树木等"},{"id":26446,"word":"枝节横生","pinyin":"zhī jié héng shēng","abbr":"zjhs","explanation":"比喻在处理问题过程中意外地发生岔子。","source":{"text":"洋人每有人命债公等案，均有领事官自理，往往掣我地方官之肘，从前中国各口之枝节横生，亦实由于此。","book":"清薛福成《通筹南洋各岛添设领事官保护华民疏》"},"similar":["横生枝节"],"usage":"作宾语、定语；用于书面语"},{"id":26447,"word":"枝词蔓语","pinyin":"zhī cí màn yǔ","abbr":"zcmy","explanation":"指繁冗芜杂的言辞。亦作“枝辞蔓语”。","source":{"text":"或代书虽据事以书，不限定字格，枝词蔓语，反滋缠绕。","book":"清黄六鸿《福惠全书·刑名·词讼》"},"similar":["枝词蔓说","枝辞蔓语"],"usage":"作宾语、定语；用于书面语"},{"id":26448,"word":"枝词蔓说","pinyin":"zhī cí màn shuō","abbr":"zcms","explanation":"指繁冗芜杂的言论。","source":{"text":"元宗问昊筠以道法，对曰：‘道法之精无如五千言，其余枝词蔓说，徒费纸札耳。’","book":"宋孔平仲《续世说·言语》"},"similar":["枝词蔓语","枝辞蔓语"],"usage":"作宾语、定语；用于书面语"},{"id":26449,"word":"枝辞蔓语","pinyin":"zhī cí màn yǔ","abbr":"zcmy","explanation":"指繁冗芜杂的言辞。同“枝词蔓语”。","source":{"text":"吾驳论者之文，列举其主要之点，而一一辨之，未尝有枝辞蔓语。","book":"《中国近代思想史参考资料简编·〈民报〉驳〈新民丛报〉最近之非革命论》"},"similar":["枝词蔓语","枝词蔓说"],"usage":"作宾语、定语；用于书面语"},{"id":26450,"word":"枝附叶从","pinyin":"zhī fù yè cóng","abbr":"zfyc","explanation":"枝叶附从于树干。比喻依附的部属。","source":{"text":"丞相（指曹操）衔奉国威，为民除害，元恶大憝，必当枭夷，至于枝附叶从，皆非诏书所特禽疾。","book":"《文选·陈琳》"},"usage":"作宾语、定语；用于书面语"},{"id":26451,"word":"枝附叶着","pinyin":"zhī fù yiè zhuó","abbr":"zfyz","explanation":"比喻上下关系紧密。亦作“枝附叶连”。","source":{"text":"方今大汉洒埽群秽，夷险芟荒……是以六合之内，莫不同源共流，沐浴玄德，禀仰太和，枝附叶着。","book":"《文选·班固〈答宾戏〉》"}},{"id":26452,"word":"枝附叶著","pinyin":"zhī fù yiè zhuó","abbr":"zfyz","explanation":"比喻上下关系紧密。亦作“枝附叶连”。","source":{"text":"方今大汉洒埽群秽，夷险芟荒……是以六合之内，莫不同源共流，沐浴玄德，禀仰太和，枝附叶著。","book":"《文选·班固〈答宾戏〉》"},"similar":["枝附叶连"],"usage":"作谓语、定语；用于比喻句"},{"id":26453,"word":"枝附叶连","pinyin":"zhī fù yè lián","abbr":"zfyl","explanation":"比喻上下关系紧密。同“枝附叶著”。","source":{"text":"维恶黄皓恣擅，启后主欲杀之。后主曰：‘皓趋走小臣耳……君何足介意！’维见皓枝附叶连，惧于失言，逊辞而出。","book":"《三国志·蜀志·姜维传》：“［姜维］故自危惧，不复还成都”裴松之注引晋·常璩《华阳国志》"},"similar":["枝附叶著"],"usage":"作谓语、定语；用于比喻句"},{"id":26454,"word":"枝附影从","pinyin":"zhī fù yǐng cóng","abbr":"zfyc","explanation":"枝条附着树干，影子随从形体。比喻追随模访。","source":{"text":"自桓麟《七说》以下，左思《七讽》以上，枝附影从，十有余家。","book":"南朝梁刘勰《文心雕龙·杂文》"},"usage":"作宾语、定语；用于比喻句"},{"id":26455,"word":"枪刀剑戟","pinyin":"qiāng dāo jiàn jǐ","abbr":"qdjj","explanation":"戟：古代一种兵器，合戈、矛为一体，既能直刺，又能横击。古代四种常用兵器。泛指兵器。","source":{"text":"关前摆着枪刀剑戟，弓弩戈矛，四边都是檑木炮石。","book":"明·施耐庵《水浒传》第11回"},"similar":["刀枪剑戟"],"usage":"作主语、宾语、定语；指兵器"},{"id":26456,"word":"枪声刀影","pinyin":"qiāng shēng dāo yǐng","abbr":"qsdy","explanation":"指激烈厮杀的场面。","source":{"text":"梁建带着家破人亡的仇恨，带着年青人烫热的心，和战友驰骋在华北平原上的浓烟大火中，枪声刀影里。","book":"杜鹏程《在和平的日子里》第三章"},"usage":"作宾语、定语；用于战争场面"},{"id":26457,"word":"枪打出头鸟","pinyin":"qiāng dǎ chū tóu niǎo","abbr":"qdctn","explanation":"出头鸟：飞在鸟群前面或把头先从窝里伸出来的鸟，比喻表现突出或领头的人。比喻冒尖的人容易遭殃。","source":{"text":"什么时候才能把那些诸如‘人怕出名猪怕壮’、‘枪打出头鸟’、‘出头椽先烂’等等‘经典哲学’从我们的生活词典中剔除了呢？","book":"路遥《平凡的世界》第四卷第51章"},"example":{"text":"王朔《千万别把我当人》：“这是一道烧鸽子，叫做‘～’。”"},"usage":"作宾语、定语；用于劝诫人"},{"id":26458,"word":"枪林刀树","pinyin":"qiāng lín dāo shù","abbr":"qlds","explanation":"犹言刀枪林立。形容激烈战斗的场面。","source":{"text":"来见这，枪林刀树，杀人如麻。","book":"清·无名氏《木兰从军·陷阵》"},"similar":["枪林弹雨"],"usage":"作宾语、定语；形容战斗激烈"},{"id":26459,"word":"枪林弹雨","pinyin":"qiāng lín dàn yǔ","abbr":"qldy","explanation":"枪杆象树林，子弹象下雨。形容战斗激烈。","source":{"text":"营兵往捕，不知虎穴所在，后乃得知某姓空舍中，相聚燃击，枪林弹雨中，虎乃毙。","book":"清·百一居士《壶天录》下卷"},"example":{"text":"因为参加各种运动，是甚至于像这次一样，要‘冒～的险，受践踏死伤之苦’的。","book":"鲁迅《华盖集续编·空谈》"},"similar":["刀光剑影","烽火连天"],"opposite":["和平共处"],"usage":"作宾语、定语；形容战斗激烈"},{"id":26460,"word":"枪烟炮雨","pinyin":"qiāng yān pào yǔ","abbr":"qypy","explanation":"形容激烈的争战。","source":{"text":"北皖以处于南北战争必趋之地，故凤颖二府属地仍在枪烟炮雨之中。","book":"《辛亥革命·安徽光复记》"},"usage":"作宾语、定语；用于战争场面"},{"id":26461,"word":"枪烟砲雨","pinyin":"qiāng yān pào yǔ","abbr":"qypy","explanation":"形容激烈的争战。"},{"id":26462,"word":"枭俊禽敌","pinyin":"xiāo jùn qín dí","abbr":"xjqd","explanation":"犹言杀敌致胜。禽，同“擒”。","source":{"text":"今国家素无文帝累年节俭富饶之畜，又无武帝荐延枭俊禽敌之臣，独有一陈汤耳！","book":"《汉书·陈汤传》"},"similar":["杀敌致胜"],"usage":"作谓语、定语；用于书面语"},{"id":26463,"word":"枭心鹤貌","pinyin":"xiāo xīn hè mào","abbr":"xxhm","explanation":"比喻心恶貌善。","source":{"text":"有鸟有鸟毛似鹤，行步虽迟性灵恶……千年不死伴灵龟，枭心鹤貌何人觉。","book":"唐·元稹《有鸟》诗之二"},"usage":"作宾语、定语；用于比喻句"},{"id":26464,"word":"枭蛇鬼怪","pinyin":"xiāo shé guǐ guài","abbr":"xsgg","explanation":"比喻丑恶之徒。","source":{"text":"这即使是对头，是敌手，是枭蛇鬼怪，我都不问。","book":"鲁迅《两地书·致许广平112》"},"usage":"作宾语、定语；指丑恶之徒"},{"id":26465,"word":"枭视狼顾","pinyin":"xiāo shì láng gù","abbr":"xslg","explanation":"如枭盯视，如狼频顾。形容行动警惕，有所畏忌。","source":{"text":"今使一死贼伏于旷野，千人追之，莫不枭视狼顾。何者？忌其暴起害己也。","book":"《吴子·励士》"},"usage":"作谓语、定语；用于比喻句"},{"id":26466,"word":"枭首示众","pinyin":"xiāo shǒu shì zhòng","abbr":"xssz","explanation":"旧时酷刑，把人头砍下来并高挂起来，使众人都看到。","source":{"text":"汪革照律该凌迟处死，仍枭首示众，决不待时。","book":"明·冯梦龙《古今小说·汪信之一死救全家》"},"example":{"text":"遂于次日绑赴新站外～云。","book":"鲁迅《保留》"},"similar":["斩首示众"],"usage":"作谓语；指砍头示众"},{"id":26467,"word":"枭鸾并栖","pinyin":"xiāo luán bìng qī","abbr":"xlbq","explanation":"枭：猫头鹰；鸾：古代传说中的一种像凤凰的神鸟。比喻坏人和好人，或小人与君子混杂在一起。","source":{"text":"今朝廷选用忠信惟恐不及，而置惠卿于其间，譬此薰莸杂处，枭鸾并栖，不惟势不两立，兼以恶者必胜。","book":"宋·苏辙《论吕惠卿》"}},{"id":26468,"word":"枯井颓巢","pinyin":"kū jǐng tuí cháo","abbr":"kjtc","explanation":"枯：没有水；颓：坍塌。干枯的水井，坍塌的鸟窝。形容荒凉遭受破坏的样子。","source":{"text":"无非是枯井颓巢，不过些砖苔砌草。","book":"清·孔尚任《桃花扇·余韵》"}},{"id":26469,"word":"枯体灰心","pinyin":"kū tǐ huī xīn","abbr":"kthx","explanation":"身体像枯木心如同死灰。形容极端消极。同“枯形灰心”。","source":{"text":"形固可使如槁木，而心固可使加死灰也。","book":"《庄子·齐物论》"},"example":{"text":"所有计念，从忌心生；若～，则万病俱泯。","book":"宋·张君房《云笈七签》卷九十四"},"similar":["枯形灰心"],"usage":"作谓语、定语、宾语；指消极"},{"id":26470,"word":"枯形灰心","pinyin":"kū xíng huī xīn","abbr":"kxhx","explanation":"身体像枯木心如同死灰。形容极端消极。","source":{"text":"形固可使如槁木，而心固可使加死灰也。","book":"《庄子·齐物论》"},"example":{"text":"与人无竞，而好刺讥朋友之过；～，而喜为感时玩物不能忘情之语。","book":"宋·苏轼《参寥子真赞》"},"similar":["枯体灰心"],"usage":"作谓语、定语；指消极"},{"id":26471,"word":"枯木再生","pinyin":"kū mù zài shēng","abbr":"kmzs","explanation":"枯死的树木又恢复了生命力。比喻历经挫折又获得生机。","source":{"text":"岂谓圣恩未弃，见桑榆，枯木再生，重沾雨露。","book":"宋·苏辙《陈汝义学士南京谢表》"},"example":{"text":"寄语甬东贤太守，难教～，未几而终。","book":"宋·释惟白《续传灯录》卷十七"},"similar":["枯树开花","枯枝再春"],"opposite":["枯木朽株"],"usage":"作宾语、定语；指又获得生机"},{"id":26472,"word":"枯木发荣","pinyin":"kū mù fā róng","abbr":"kmfr","explanation":"枯萎的树木恢复生机。比喻衰亡的事物重获新生。","source":{"text":"夫辩言之艳，能使穷泽生流，枯木发荣。","book":"三国·魏·曹植《七启》"},"similar":["枯树开花","枯木逢春"],"usage":"作宾语、定语；用于垂死的事物得新生"},{"id":26473,"word":"枯木朽株","pinyin":"kū mù xiǔ zhū","abbr":"kmxz","explanation":"朽：腐烂；株：露出地面的树桩。枯木头，烂树根。比喻衰朽的力量或衰老无用的人。","source":{"text":"故有人先谈，则枯木朽树功而不忘。","book":"汉·邹阳《狱中上梁王书》"},"example":{"text":"白云山头云欲立，白云山下呼声急，～齐努力。","book":"毛泽东《渔家傲·反第二次大“围剿”》词"},"opposite":["枯木逢春","枯木生花","枯树开花"],"usage":"作宾语、状语；指老朽无用的人"},{"id":26474,"word":"枯木死灰","pinyin":"kū mù sǐ huī","abbr":"kmsh","explanation":"死灰：燃烧后余下的冷灰。身如枯木，心如死灰。比喻极其消极悲观。","source":{"text":"形固可使如杭木，而心固可使如死灰乎？","book":"《庄子·齐物论》"},"example":{"text":"若说他既看得入眼，这心就同～，丝毫不动，这心地也就太冷了，更不是情理。","book":"清·文康《儿女英雄传》第九回"},"similar":["心如死灰"],"usage":"作宾语、定语；比喻极其消极悲观"},{"id":26475,"word":"枯木生花","pinyin":"kū mù shēng huā","abbr":"kmsh","explanation":"枯树开了花。比喻绝处逢生。也比喻不可能实现的事情。","source":{"text":"起烟于寒灰之上，生花于已枯之木。","book":"《三国志·魏志·刘廙传》"},"example":{"text":"我一命如同草头露滴，今日得了这银子呵，一似～，阳春布泽。","book":"明·沈受三《三元记·完璧》"},"similar":["枯树开花"],"opposite":["枯木朽株"],"usage":"作宾语、定语；比喻绝处逢生"},{"id":26476,"word":"枯木逢春","pinyin":"kū mù féng chūn","abbr":"kmfc","explanation":"逢：遇到。枯干的树遇到了春天，又恢复了活力。比喻垂危的病人或事物重新获得生机。","source":{"text":"唐州大乘山和尚问：‘枯树逢春时如何？’师曰：‘世间希有。’","book":"宋·释道原《景德传灯录》卷二十三"},"example":{"text":"～，陈花重放，旧作再版，自然是值得高兴的。","book":"峻青《写在百花重放的时候》"},"similar":["枯树生花","绝处逢生"],"opposite":["暗无天日","生不逢时"],"usage":"作主语、谓语、定语；指重新获得生机","story":["梁武帝时，谏议大夫韦恕被贬为驷马监的判院。一天梁武帝的“照殿玉狮子”跑了，韦恕的手下沿着雪上的马蹄印找到张果老的瓜园，韦恕带全家去拜谢张果老。张果老看上韦恕的18岁的女儿，韦恕顺从天意将女儿嫁给80多岁的张果老"]},{"id":26477,"word":"枯本竭源","pinyin":"kū běn jié yuán","abbr":"kbjy","explanation":"枯：使枯死；本：根本；竭：竭尽；源：源头。指损害事物的根基。","source":{"text":"必须保护野生植物的生机，使之能够继续繁殖，不要枯本竭源。","book":"《人民日报》1959.10.12"},"similar":["斩尽杀绝"],"usage":"作谓语、宾语；指损害事物的根基"},{"id":26478,"word":"枯朽之余","pinyin":"kū xiǔ zhī yú","abbr":"kxzy","explanation":"指衰病残年。","source":{"text":"异日复得以枯朽之余，仰瞻天日之表。","book":"宋·苏轼《代滕甫辩谤乞郡书》"},"usage":"作主语、宾语；指残年"},{"id":26479,"word":"枯杨之稊","pinyin":"kū yáng zhī tí","abbr":"kyzt","explanation":"枯：枯槁；稊：植物的嫩芽。枯萎的杨树又长出了芽。比喻老夫娶少妻。","source":{"text":"余自伤年老，不欲为枯杨之稊。","book":"清·袁枚《随园诗话》第14卷"},"similar":["枯杨生稊"],"usage":"作宾语、定语；比喻老夫娶少妻"},{"id":26480,"word":"枯杨生华","pinyin":"kū yáng shēng huā","abbr":"kysh","explanation":"枯：干枯；华：同“花”。枯萎的杨树重新开花。比喻老年女子嫁了做官的丈夫，好景不长。","source":{"text":"九五，枯杨生华，老妇得其士夫。","book":"《周易·大过》"},"example":{"text":"～，曷惟其旧。横虽雄材，伏于海坞。","book":"东汉·班固《汉书·叙传》"},"similar":["枯树生花"],"usage":"作宾语、定语；用于比喻句"},{"id":26481,"word":"枯杨生稊","pinyin":"kū yáng shēng tí","abbr":"kyst","explanation":"稊：植物的嫩芽。枯萎有杨树又长出了芽。旧喻老人娶少妻。","source":{"text":"枯杨生稊，老夫得其女妻。","book":"《周易·大过》"},"example":{"text":"老年人聚此少艾，～，大非所宜。","book":"清·采蘅子《虫鸣漫录》"},"similar":["枯杨生华","枯杨之稊"],"usage":"作宾语、定语；比喻老夫娶少妻"},{"id":26482,"word":"枯枝再春","pinyin":"kū zhī zài chūn","abbr":"kzzc","explanation":"枯死的树木又恢复了生命力。比喻历经挫折又获得生机。","source":{"text":"岂谓圣恩未弃，见桑榆，枯木再生，重沾雨露。","book":"宋·苏辙《陈汝义学士南京谢表》"},"example":{"text":"姻缘本是前生定，故令个白兔来引，艰辛，今喜得～。","book":"明·无名氏《白兔记·团圆》"},"similar":["枯木再生"],"opposite":["枯木朽株"],"usage":"作宾语、定语；指又获得生机"},{"id":26483,"word":"枯枝败叶","pinyin":"kū zhī bài yè","abbr":"kzby","explanation":"败：衰败。干枯的树枝，衰败的花叶。形容荒凉、破坏的样子。","source":{"text":"鸽翎蝠粪满堂抛，枯枝败叶当阶罩。","book":"清·孔尚任《桃花扇·余韵》"},"example":{"text":"就这两句诗，确有新旧更张的意思，落木萧萧下，那不是～？","book":"二月河《乾隆皇帝》第五卷二十六"},"usage":"作主语、宾语、定语；用于书面语"},{"id":26484,"word":"枯枿朽株","pinyin":"kū niǎo xiǔ zhū","abbr":"knxz","explanation":"枯朽的枝干。形容事物死气沉沉。","source":{"text":"自宋以来，学杜者但刻意深沉，如枯枿朽株，无复生意。","book":"明·胡应麟《诗薮·近体》"},"similar":["枯木朽株"],"usage":"作宾语、定语；用于比喻句"},{"id":26485,"word":"枯树开花","pinyin":"kū shù kāi huā","abbr":"kskh","explanation":"已经枯死的树又开起花来。比喻绝处逢生获奇迹出现。","source":{"text":"起烟于寒灰之上，生华于已枯之木。","book":"晋·陈寿《三国志·魏志·刘廙传》"},"example":{"text":"我曾听得人说，寒波造酒，～，他便是大罗神仙。","book":"元·无名氏《玩江亭》第二折"},"similar":["枯木生花","枯木逢春"],"opposite":["枯木朽株"],"usage":"作宾语；指又获得生机"},{"id":26486,"word":"枯树生华","pinyin":"kū shù shēng huā","abbr":"kssh","explanation":"比喻在绝境中又找到了生路。","source":{"text":"臣罪应倾宗，祸应覆族……起烟于寒灰之上，生华于已枯之木。","book":"《三国志·魏志·刘廙传》"}},{"id":26487,"word":"枯树生花","pinyin":"kū shù shēng huā","abbr":"kssh","explanation":"枯树开起花来。比喻在绝境中又找到了生路。","source":{"text":"臣罪应倾宗，祸应覆族……起烟于寒灰之上，生华于已枯之木。","book":"《三国志·魏志·刘廙传》"},"similar":["枯树生华"],"usage":"作宾语、定语；用于比喻句"},{"id":26488,"word":"枯树逢春","pinyin":"kū shù féng chūn","abbr":"ksfc","explanation":"已枯之树又重获生机。比喻绝境逢生。","source":{"text":"问：‘枯树逢春时如何？’师曰：‘世间希有。’","book":"《景德传灯录·唐州大乘山和尚》"},"example":{"text":"我争些儿有家难奔，恰便似旱苗才得雨，枯树恰逢春。","book":"元·无名氏《冻苏秦》第四折"},"similar":["枯木逢春"],"opposite":["生不逢时"],"usage":"作宾语、谓语、定语；指重新获得生机"},{"id":26489,"word":"枯株朽木","pinyin":"kū zhū xiǔ mù","abbr":"kzxm","explanation":"株：露出地面的树根。朽：腐朽，腐烂。枯死的树桩，腐朽的树木。比喻衰朽的，没有多大用处的人或物。","source":{"text":"如亮已为枯株朽木，与一世并无所关涉，惟于秘书，不敢不致其区区耳。","book":"宋·陈亮《又癸卯秋书》"},"example":{"text":"我虽比他尊贵，但绫锦纱罗，也不过裹了我这～。","book":"清·曹雪芹《红楼梦》第七回"},"similar":["枯木朽株"],"usage":"作宾语；指无用的人或物"},{"id":26490,"word":"枯槁之士","pinyin":"kū gǎo zhī shì","abbr":"kgzs","explanation":"枯槁：瘦瘠。指隐居山林的隐士。","source":{"text":"兵革之士乐哉，枯槁之士宿名。","book":"《庄子·徐无鬼》"},"example":{"text":"方今山林～，要亦未可多得，去之奔走声利之场者则远矣。","book":"明·王阳明《寄希渊》"},"usage":"作主语、宾语；用于隐士"},{"id":26491,"word":"枯燥乏味","pinyin":"kū zào fá wèi","abbr":"kzfw","explanation":"枯燥：单调无趣。指单调缺乏情趣兴味。","source":{"text":"一个人开车真是枯燥乏味。如果润生在旁边坐着，他们还能说点什么。","book":"路遥《平凡的世界》第四卷第48章"},"similar":["枯燥无味"],"usage":"作谓语、定语、宾语；用于口语"},{"id":26492,"word":"枯燥无味","pinyin":"kū zào wú wèi","abbr":"kzww","explanation":"枯燥：单调。形容单调，没有趣味。","source":{"text":"因此，群众就不欢迎他们枯燥无味的宣传，我们也不需要这样憋脚的不中用的宣传家。","book":"毛泽东《反对党八股》"},"example":{"text":"钱钟书《围城》：“更可恨论理学开头最～，要讲到三段论法，才可以穿插点缀些笑话，暂时还无法迎合心理。”"},"similar":["索然无味","味同嚼蜡"],"opposite":["津津有味","妙趣横生"],"usage":"作谓语、定语；用于书面语"},{"id":26493,"word":"枯瘦如柴","pinyin":"kū shòu rú chái","abbr":"ksrc","explanation":"枯：干枯。形容非常瘦弱。","source":{"text":"那枯瘦如柴的大哥，庄严地跨出了牢门。","book":"罗广斌《红岩》第13章"},"similar":["骨瘦如柴"],"opposite":["膘肥体壮"],"usage":"作谓语、定语、状语；指人瘦弱"},{"id":26494,"word":"枯竹空言","pinyin":"kū zhú kōng yán","abbr":"kzky","explanation":"竹：竹简。干枯的竹简和空洞的言论。指毫无实用价值的古书和空泛的议论。","source":{"text":"诸生无能出奇计，远图匈奴安边境之策，抱空竹，守空言。","book":"汉·桓宽《盐铁论·利议》"}},{"id":26495,"word":"枯耕伤稼，枯耘伤岁","pinyin":"kū gēng shāng jià，kū yún shāng suì","abbr":"kgsjkyss","explanation":"枯：粗劣；耘：除草；岁：收成。粗糙不细致的耕耘会伤害庄稼，减少收成。","source":{"text":"人袄则可畏也，楛耕伤稼，楛耘失岁。","book":"《荀子·天论》"}},{"id":26496,"word":"枯耘伤岁","pinyin":"kū yún shāng suì","abbr":"kyss","explanation":"耘：除草；岁：年谷成熟。耕作不细致，会影响到一年的收成。","source":{"text":"枯耕伤稼，枯耘伤岁。","book":"《荀子·天论》：“楛耕伤稼，耘耨失薉。”汉·韩婴《韩诗外传》卷二"}},{"id":26497,"word":"枯肠渴肺","pinyin":"kū cháng kě fèi","abbr":"kckf","explanation":"枯：枯竭。形容人十分饥渴。","source":{"text":"开妒满饮相献酬，枯肠渴肺忘朝饥。","book":"《唐诗纪事》"},"usage":"作宾语、定语；用于饥渴"},{"id":26498,"word":"枯脑焦心","pinyin":"kū nǎo jiāo xīn","abbr":"knjx","explanation":"指竭尽心力。","source":{"text":"是留东同人枯脑焦心日夜经营者也。","book":"《辛亥革命前十年间时论选集·》"},"usage":"作谓语、定语、状语；用于比喻句"},{"id":26499,"word":"枯苗望雨","pinyin":"kū miáo wàng yǔ","abbr":"kmwy","explanation":"形容殷切盼望。","source":{"text":"寡君望蹇先生之临，如枯苗望雨。","book":"明·冯梦龙《东周列国志》"},"usage":"作宾语、定语；形容殷切盼望"},{"id":26500,"word":"枯茎朽骨","pinyin":"kū jìng xiǔ gǔ","abbr":"kjxg","explanation":"茎：草茎；骨：骨头。枯槁的草茎，腐烂的骨头。比喻腐朽的事物。","source":{"text":"蓍之与龟，本枯茎朽骨耳！灵从何来，圣从何起？今则能彰往察来也，上下无常也，枯茎朽骨，何其神哉。","book":"《关尹子》"},"example":{"text":"薛公、充国非有风角写占之胜、～之技，亦惟心定而虑审耳。","book":"宋·辛弃疾《美芹十论·察情》"}},{"id":26501,"word":"枯蓬断草","pinyin":"kū péng duàn cǎo","abbr":"kpdc","explanation":"干枯、断折的蓬草。因易随风飘散，故亦以喻不由自主，行踪难定。","source":{"text":"姑娘离家以后，像是枯蓬断草一样，到处漂流。","book":"《中国民间故事选·六弟兄》"},"usage":"作宾语、定语；用于比喻句"},{"id":26502,"word":"枯骨之余","pinyin":"kū gǔ zhī yú","abbr":"kgzy","explanation":"枯骨：白骨，引申为死人。比喻垂死的人。","source":{"text":"华存卑贱，枯骨之余。自处尘垢，久染浊秽。","book":"宋·张君房《云笈七签》"},"usage":"作主语、宾语；指垂死的人"},{"id":26503,"word":"枯骨之馀","pinyin":"kū gǔ zhī yú","abbr":"kgzy","explanation":"指将死之人。"},{"id":26504,"word":"枯骨生肉","pinyin":"kū gǔ shēng ròu","abbr":"kgsr","explanation":"犹言起死回生。形容医术高明。也比喻把已经没有希望的事物挽救过来。","source":{"text":"伏愿垂泣辜之恩，降云雨之施，追草昧之始，录涓滴之功，则寒灰更然，枯骨生肉。","book":"《隋书·于仲文传》"},"similar":["起死回生","生肉枯骨"],"usage":"作宾语、定语；用于挽救危局"},{"id":26505,"word":"枯鱼之肆","pinyin":"kū yú zhī sì","abbr":"kyzs","explanation":"枯鱼：干鱼；肆：店铺。卖干鱼的店铺。比喻无法挽救的绝境。","source":{"text":"吾得斗升之水然活耳，君乃此言，曾不如早索我于枯鱼之肆矣。","book":"《庄子·外物》"},"example":{"text":"使遇他鬼，则纵情冶荡，不出半载，索君于～矣。","book":"清·纪昀《阅微草堂笔记·姑妄听之四》"},"opposite":["绝处逢生"],"usage":"作宾语；指绝境"},{"id":26506,"word":"枯鱼得水","pinyin":"kū yú dé shuǐ","abbr":"kyds","explanation":"好像鱼得到水一样。比喻有所凭借。也比喻得到跟自己十分投合的人或对自己很合适的环境。","source":{"text":"孤之有孔明，犹鱼之有水也。","book":"《三国志·蜀志·诸葛亮传》"}},{"id":26507,"word":"枯鱼涸辙","pinyin":"kū yú hé zhé","abbr":"kyhz","explanation":"枯鱼：干鱼；涸辙：干的车辙沟。比喻陷入困境。","source":{"text":"周昨来，有中道而呼者，周顾视车辙中，有鲋鱼焉。","book":"《庄子·外物》"},"example":{"text":"～暂潜踪，大鹏何日天风送。","book":"明·汪廷讷《种玉记·奇术》"},"similar":["枯鱼病鹤"],"usage":"作宾语、定语；比喻陷入困境","story":["战国时期，思想家庄周在《庄子》中运用寓言故事，他在《外物》篇中讲到：庄周在旅行途中听到有声音叫他，他在车辙中发现一条鲋鱼，鲋鱼即将缺水请求帮助，庄周准备取一杯水救它，鲋鱼说他是东海的波臣，哪里是这斗升之水能够生活下去的"]},{"id":26508,"word":"枯鱼病鹤","pinyin":"kū yú bìng hè","abbr":"kybh","explanation":"干枯的鱼，有病的鹤。比喻处境困难，沦落不遇的人。","source":{"text":"似枯鱼病鹤，枯鱼病鹤，空怀霄汉，挨着寒鸡茅店。","book":"明·胡文焕《群音类选·玉簪记·必正投姑》"},"usage":"作主语、宾语、定语；用于人的境遇"},{"id":26509,"word":"枯鱼衔索","pinyin":"kū yú xián suǒ","abbr":"kyxs","explanation":"衔：含；索：绳子。穿在绳上的干鱼。形容事物存在的日子已经不多。","source":{"text":"枯鱼衔索，几何不蠹。二亲之寿，忽如过隙。","book":"西汉·韩婴《韩诗外传》第一卷"},"example":{"text":"～，疾风过牖。匪降自天，谁执其咎。","book":"唐·陈子昂《临邛县令封君遗爱碑》"},"usage":"作宾语、定语；形容存在的日子不多了"},{"id":26510,"word":"枵肠辘辘","pinyin":"xiāo cháng lù lù","abbr":"xcll","explanation":"枵：空虚；辘辘：车行声。肚子饿得辘辘作响。形容十分饥饿。","source":{"text":"枵肠辘辘，饥不可堪。","book":"清·蒲松龄《聊斋志异·西湖主》"},"similar":["饥肠辘辘"],"usage":"作定语、状语；用于饥饿时"},{"id":26511,"word":"枵腹从公","pinyin":"xiāo fù cóng gōng","abbr":"xfcg","explanation":"枵腹：空腹，肚饥。指饿着肚子办公家的事。形容一心为公。","source":{"text":"到了这个分上，要想他们毁家纾难，枵腹从公，恐怕走遍天涯，如此好人，也找不出一个。","book":"清·李宝嘉《活地狱》楔子"},"example":{"text":"则彼共和政府自大统领、国会议员，下之未入流之小吏，除～外更无他术。","book":"清·梁启超《驳某报之土地国有论》"},"similar":["废寝忘食","鞠躬尽瘁"],"opposite":["穷奢极侈","得过且过"],"usage":"作谓语、定语、状语；指饿着肚子办公事"},{"id":26512,"word":"枵腹终朝","pinyin":"xiāo fù zhōng zhāo","abbr":"xfzc","explanation":"指终日饿着肚子。","source":{"text":"一人入集，必不能枵腹终朝；数日一集，亦不能徒手而归。","book":"清·刘书年《刘贵阳说经残稿·沂水桑麻话》"},"usage":"作谓语、定语；用于书面语"},{"id":26513,"word":"枵腹重趼","pinyin":"xiāo fù zhòng jiǎn","abbr":"xfzj","explanation":"枵腹：空腹；重趼：手脚掌上因磨擦而生成的老茧。形容长途跋涉，忍饥挨饿的情状。","source":{"text":"岁与兄观永徙步至塞外营养，往来南北，枵腹重趼。","book":"《清史稿·方观承传》"},"usage":"作定语；用于书面语"},{"id":26514,"word":"架屋叠床","pinyin":"jià wū dié chuáng","abbr":"jwdc","explanation":"屋上架屋，床上叠床。比喻重复累赘。","source":{"text":"至如暴已从日，又加日而为曝，然已从火，又加火而为燃……架屋叠床，触目皆是。","book":"明·焦竑《焦氏笔乘续集·俗书之误》"},"example":{"text":"周、程、张、朱以后，土饭陈羹，～，转不如发为文章，见诸事业者，实而可征也。","book":"清·秦笃辉《平书·文艺上》"},"similar":["架屋迭床","床上迭床"],"usage":"作谓语、定语、宾语；指重复"},{"id":26515,"word":"架屋迭床","pinyin":"jià wū dié chuáng","abbr":"jwdc","explanation":"床上搁床，屋上架屋。比喻重复、累赘。","source":{"text":"架屋迭床，触目皆是。","book":"明·焦竑《焦氏笔乘续集·俗书之误》"},"example":{"text":"土饭陈羹，～，转不如发为文章。","book":"清·秦笃辉《平书·文艺上》"},"similar":["迭床架屋","架屋叠床"],"usage":"作谓语、宾语、定语；指重复累赘"},{"id":26516,"word":"架海擎天","pinyin":"jià hǎi qíng tiān","abbr":"jhqt","explanation":"架海：横跨大海；擎天：支撑上天。形容本领大，能力非凡。","source":{"text":"他是个架海擎天的玉柱，看承做提牌执戟小人哉。","book":"元·无名氏《衣锦还乡》第一折"},"example":{"text":"世间～柱，岳下降魔斩将人。","book":"明·施耐庵《水浒传》第74回"},"similar":["擎天架海"],"usage":"作谓语、定语；用于人的能力"},{"id":26517,"word":"架海金梁","pinyin":"jià hǎi jīn liáng","abbr":"jhjl","explanation":"梁：桥梁。架在海上的金桥。比喻能够身肩重任的栋梁之才。","source":{"text":"想周瑜破了百万曹兵，他正是擎天玉柱，架海金梁。","book":"元·无名氏《黄鹤楼》第一折"},"example":{"text":"四个将军，乃擎天玉柱，～，永安社稷，威镇边疆。","book":"元·无名氏《岳飞精忠》第四折"},"similar":["中流砥柱","擎天玉柱"],"usage":"作宾语；指杰出人物"},{"id":26518,"word":"架肩击毂","pinyin":"jià jiān jī gū","abbr":"jjjg","explanation":"肩膀相挨，车轮相撞。形容行人车辆拥挤。","source":{"text":"及赴任陕郊，洛阳自居守分司朝臣已下，互设祖筵，遮于行路，洛阳为之一空。都人观者架肩击毂。","book":"《太平广记》卷二百引唐·高彦休《唐阙史·卢渥》"},"similar":["驾肩接武","架肩接踵"],"usage":"作谓语、定语；形容人多"},{"id":26519,"word":"架肩接踵","pinyin":"jià jiān jiē zhǒng","abbr":"jjjz","explanation":"肩挨肩，脚碰脚。形容人拥挤。","source":{"text":"李相公珏镇扬日，夜梦长衢而行，见一金字牌屹于路左，观者架肩接踵而至，遂诣看焉。","book":"宋·无名氏《灯下闲谈·升斗得仙》"},"similar":["驾肩接武","驾肩接迹"],"usage":"作谓语、定语、状语；指人多"},{"id":26520,"word":"架谎凿空","pinyin":"jià huǎng záo kōng","abbr":"jhzk","explanation":"指扯谎作假。","source":{"text":"这杨大郎名唤杨光彦，绰号铁指甲，专一粜风卖雨，架谎凿空。","book":"明·兰陵笑笑生《金瓶梅词话》第九十二回"},"similar":["无中生有"],"usage":"作谓语、定语、宾语；用于口语"},{"id":26521,"word":"枷脰械手","pinyin":"jiā dòu xiè shǒu","abbr":"jdxs","explanation":"犹言枷颈铐手。指拘系囚犯。","source":{"text":"辟（叛将刘辟）穷见窘, 无地自处……取之江中，枷脰械手。","book":"唐·韩愈《元和圣德诗》"},"similar":["枷颈铐手"],"usage":"作谓语、定语；指被拘"},{"id":26522,"word":"柏舟之节","pinyin":"bǎi zhōu zhī jié","abbr":"bzzj","explanation":"指妇女丧夫后守节不嫁。同“柏舟之誓”。","source":{"text":"朋友传说，令女弟甚贤，必能养老抚孤，以全柏舟之节。","book":"宋·朱熹《与陈师中书》"},"similar":["柏舟之誓"],"usage":"作宾语；用于妇女"},{"id":26523,"word":"柏舟之誓","pinyin":"bǎi zhōu zhī shì","abbr":"bzzs","explanation":"指妇女丧夫后守节不嫁。亦作“柏舟之节”。","source":{"text":"《柏舟》，共姜自誓也。卫世子共伯早死，其妻守义，父母欲夺而嫁之，誓而弗许，故作是诗以绝之。","book":"《诗·鄘风·柏舟序》"},"example":{"text":"青松摧折，哀断女萝之心；丹节孤高， 终守～。","book":"唐陈子昂《唐故袁州参军李府君妻张氏墓志铭》"},"similar":["柏舟之节"],"usage":"作宾语；用于妇女","story":["春秋时期，卫世子共伯夫妇感情十分恩爱，曾经山盟海誓他们的爱情至死不变。后来共伯去世，其父母想要他妻子共姜改嫁。共姜坚决不答应，就做一首诗《柏舟》来证明他们的爱情，让其父母打消这个念头"]},{"id":26524,"word":"染丝之变","pinyin":"rǎn sī zhī biàn","abbr":"rszb","explanation":"比喻本来相同的人或事物因受环境影响而变得不同。","source":{"text":"［墨子］见染丝者而叹曰：‘染於苍则苍，染於黄则黄。所入者变，其色亦变。’","book":"《墨子·所染》"},"example":{"text":"故友之好，请于此辞：～，墨翟致怀；歧路之感，杨朱兴叹，况于将军游处少长，虽世誉先后而臭味同归也。","book":"《晋书·袁乔传》"},"usage":"作宾语；指环境影响人"},{"id":26525,"word":"染丝之叹","pinyin":"rǎn sī zhī tàn","abbr":"rszt","explanation":"把绸缎放在颜料里，颜色发生了变化。比喻本来相同的事物，因受环境影响而变成不同的事物。","source":{"text":"见染丝而叹曰：‘染于苍则苍，染于黄则黄，所入者变，其色亦变。’","book":"《墨子·所染》"}},{"id":26526,"word":"染化而迁","pinyin":"rǎn huà ér qiān","abbr":"rheq","explanation":"因为感受到教化而发生变化。","source":{"text":"是以妖灾因衅而作，民俗染化而迁。","book":"晋·范宁《春秋谷梁传序》"}},{"id":26527,"word":"染指于鼎","pinyin":"rǎn zhǐ yú dǐng","abbr":"rzyd","explanation":"鼎：古代用青铜制成的炊具，多为圆形，三足两耳。把手指伸到鼎里蘸点汤。比喻沾取非分的利益。","source":{"text":"及食大夫鼋，召子公而弗与也。子公怒，染指于鼎，尝之而出。","book":"《左传·宣公四年》"},"usage":"作宾语、定语；用于比喻句"},{"id":26528,"word":"染指垂涎","pinyin":"rǎn zhǐ chuí xián","abbr":"rzcx","explanation":"形容急欲攫取，十分贪馋。垂涎，流口水。","source":{"text":"至贵之无敌，至富之无伦，染指垂涎者至众也。","book":"宋·吕祖谦《东莱博议》卷三"},"example":{"text":"病民诸好各持两端，观望所立，莫不觊觎神器，～。","book":"《元史·郝经传》"},"usage":"作谓语、定语；用于为人"},{"id":26529,"word":"染旧作新","pinyin":"rǎn jiù zuò xīn","abbr":"rjzx","explanation":"指改头换面，以旧充新。","source":{"text":"今之学者……但诵得古文十数篇，拆南补北，染旧作新，尽为名士矣，何工拙之辨哉？","book":"宋·李斠《答黄著作书》"},"similar":["弄虚作假"],"usage":"作谓语、定语；指弄虚作假"},{"id":26530,"word":"染神乱志","pinyin":"rǎn shén luàn zhì","abbr":"rslz","explanation":"指思想受到迷惑扰乱。","source":{"text":"西山曰：‘此人大非端士，笔头虽写得数句诗，所谓本心不正，脉理皆邪，读之将恐染神乱志，非徒无益。’某佩服其言。","book":"宋·罗大经《鹤林玉露》卷十"},"usage":"作谓语、定语；用于作品的影响等"},{"id":26531,"word":"染神刻骨","pinyin":"rǎn shén kè gǔ","abbr":"rskg","explanation":"犹铭心刻骨。指感受深切。","source":{"text":"苏黄字迹，亦所矜赏，谓‘二公翰墨，片言只字，皆未名之宝，百不为多，一不为少。’是遗山之于苏黄，可谓染神刻骨矣。","book":"清·赵翼《瓯北诗话·南宋人著述未入金源》"},"similar":["铭心刻骨"],"usage":"作宾语、定语；用于书面语"},{"id":26532,"word":"染翰成章","pinyin":"rǎn hàn chéng zhāng","abbr":"rhcz","explanation":"指提笔成文。","source":{"text":"诗，适情之具。染翰成章，自然高妙，何必苦思以凿其真？","book":"明·谢榛《四溟诗话》卷二"},"similar":["染翰操觚"],"usage":"作谓语、宾语；用于书面语"},{"id":26533,"word":"染翰操纸","pinyin":"rǎn hàn cāo zhǐ","abbr":"rhcz","explanation":"染翰：以笔蘸墨；操纸：拿着纸头。指书写文章。","source":{"text":"譬犹池鱼笼鸟，有江湖山薮之思。于是染翰操纸，慨然而赋。","book":"晋·潘岳《秋兴赋》"}},{"id":26534,"word":"染翰操觚","pinyin":"rǎn hàn cāo gū","abbr":"rhcg","explanation":"翰：毛笔；操觚：拿木简写文章。指提笔作文。","source":{"text":"作文曰染翰操觚；从师曰执经问难。","book":"明·程登吉《幼学琼林》第四卷"},"similar":["染翰成章"],"usage":"作宾语、定语；用于书面语"},{"id":26535,"word":"染苍染黄","pinyin":"rǎn cāng rǎn huáng","abbr":"rcrh","explanation":"苍：青色。比喻变化不定，反复无常。","source":{"text":"见染丝者而叹曰：‘染于苍则苍，染于黄则黄。’","book":"《墨子·所染》"},"usage":"作谓语、定语；用于比喻句"},{"id":26536,"word":"染蓝涅皂","pinyin":"rǎn lán niè zǎo","abbr":"rlnz","explanation":"指胡乱涂抹。涅，染；皂，黑色。","source":{"text":"姚司马者，寄居汾州……经年，二女精神恍惚，夜常明灯挫针，染蓝涅皂，未尝暂息，然莫见其所取也。","book":"唐·段成式《酉阳杂俎续集·支诺皋中》"},"usage":"作宾语、定语；用于书面语"},{"id":26537,"word":"染须种齿","pinyin":"rǎn xū zhǒng chǐ","abbr":"rxzc","explanation":"染须发，镶假牙。以之掩饰衰老。","source":{"text":"卜冢治棺轮我快，染须种齿笑人痴。","book":"宋·陆游《岁晚幽兴》诗"},"usage":"作谓语、定语、宾语；用于老年人"},{"id":26538,"word":"染风习俗","pinyin":"rǎn fēng xí sú","abbr":"rfxs","explanation":"指受风俗影响而有所习染。","source":{"text":"五气者，随命成性，逐物意移，染风习俗，所以变化无穷，不惟万数。","book":"《云笈七签》卷五六"},"usage":"作谓语、定语；用于书面语"},{"id":26539,"word":"柔中有刚","pinyin":"róu zhōng yǒu gāng","abbr":"rzyg","explanation":"形容人的性格温柔中带有刚强。","example":{"text":"他的性格是～。"},"similar":["柔中带刚","刚柔并济"],"usage":"作谓语、定语；形容人的性格"},{"id":26540,"word":"柔刚弱强","pinyin":"róu gāng ruò qiáng","abbr":"rgrq","explanation":"柔：弱；刚：强。柔弱可以胜过刚强。","source":{"text":"柔之胜刚，弱之胜强。","book":"《老子》第三十六章"}},{"id":26541,"word":"柔声下气","pinyin":"róu shēng xià qì","abbr":"rsxq","explanation":"犹言低声下气。形容恭顺谦卑的样子。","source":{"text":"愿天下处闺房者，持予雄辩，压彼雌风，毋柔声下气，养同木鸡也。","book":"清·沈起凤《谐铎·鸡谈》"},"example":{"text":"令长子珍就傅……尝曰：‘妇人舍言、容、工，无所谓德。言只～，容只衣饰整洁，工则针黹、纺绩、酒浆、菹醢，终身不能尽。’","book":"《清史稿·列女传一·郑文清妻黎》"},"similar":["低声下气"],"usage":"作定语、状语；用于处事"},{"id":26542,"word":"柔媚娇俏","pinyin":"róu mèi jiāo qiào","abbr":"rmjq","explanation":"温柔和顺，妩媚俏丽。","example":{"text":"他带来一个～的女孩。"},"usage":"作谓语、定语；多用于女性"},{"id":26543,"word":"柔心弱骨","pinyin":"róu xīn ruò gǔ","abbr":"rxrg","explanation":"形容性情柔和。","source":{"text":"人性婉而从物，不竞不争，柔心而弱骨，不骄不忌。","book":"《列子·汤问》"},"usage":"作宾语、谓语；形容性情柔和"},{"id":26544,"word":"柔情似水","pinyin":"róu qíng sì shuǐ","abbr":"rqss","explanation":"柔：温柔。温柔的情感象水一样。形容男女之间情思缠绵不断。","source":{"text":"柔情似水，佳期如梦，忍顾鹊桥归路。","book":"宋·秦观《鹊桥仙》词"},"example":{"text":"见他穿一身白纱衫裤，头上只带着一排茉莉花条，趁着那杨柳纤腰，梨花白面，趁显得～，媚态如春。","book":"清·张春帆《九尾龟》六十二"},"usage":"作谓语、定语、状语；多用于女性"},{"id":26545,"word":"柔情侠骨","pinyin":"róu qíng xiá gǔ","abbr":"rqxg","explanation":"温柔的情态，侠义的性格。","source":{"text":"只有秋痕韵致天然，虽肌理莹洁，不及我那红卿，而一种柔情侠骨真与红卿一模一样。","book":"《花月痕》第七回"},"usage":"作宾语、定语；用于人的性格"},{"id":26546,"word":"柔情媚态","pinyin":"róu qíng mèi tài","abbr":"rqmt","explanation":"指柔美的情态。同“柔情绰态”。","source":{"text":"[陈生]见一女子，年仅及笄，殆天人也……遂患心疾，辗转昏愦中，忽忆柔情媚态，则哑然笑；又忆浮萍断梗，何处追寻，则啜以泣。","book":"清·李心衡《金川锁记·陈生》"},"similar":["柔情绰态"],"usage":"作宾语、定语；用于人或事物等"},{"id":26547,"word":"柔情密意","pinyin":"róu qíng mì yì","abbr":"rqmy","explanation":"指温柔亲密的情意。","source":{"text":"内中紫鹃也想起自己终身一无着落……如今穿悬在宝玉屋内，虽说宝玉仍是柔情密意，究竟算不得什么，于是更哭得哀切。","book":"《红楼梦》第一一一回"},"similar":["柔情似水","情意绵绵"],"opposite":["无情无义","冷酷无情"],"usage":"作主语、宾语；用于男女关系"},{"id":26548,"word":"柔情绰态","pinyin":"róu qíng chuō tai","abbr":"rqct","explanation":"指柔美的情态。","source":{"text":"其形也，翩若惊鸿，婉若游龙……瑰恣艳逸，仪静体闲，柔情绰态，媚于语言。","book":"三国·魏·曹植《洛神赋》"},"similar":["柔情媚态"],"usage":"作宾语、定语；用于人或事物等"},{"id":26549,"word":"柔情蜜意","pinyin":"róu qíng mì yì","abbr":"rqmy","explanation":"温柔甜蜜的情意。","source":{"text":"瞪得圆溜溜的眼珠里，流露出只有傅连山才看得出来的柔情蜜意。","book":"《收获》1981年第1期"},"example":{"text":"你的～让我难以忘怀。"},"similar":["情意绵绵"],"opposite":["冷酷无情"],"usage":"作主语、宾语；用于男女关系"},{"id":26550,"word":"柔懦寡断","pinyin":"róu nuò guǎ duàn","abbr":"rngd","explanation":"指软弱面不果断。","source":{"text":"语出《韩非子·亡徵》：“缓心面无成，柔茹而寡断，好恶无决，而无所定立者，可亡也。”茹，通“懦”。"},"example":{"text":"[边镐]及冠翘秀……后嗣主爱其博雅，累用之，然而～，惟好释氏。","book":"宋·文莹《玉壶清话》"},"similar":["柔茹寡断"],"opposite":["斩钉截铁"],"usage":"作谓语、定语、宾语；指人不果断"},{"id":26551,"word":"柔枝嫩叶","pinyin":"róu zhī nèn yè","abbr":"rzny","explanation":"柔软娇嫩的枝叶。比喻温柔美貌的妙龄女子。","source":{"text":"绿茵尽摘不留，且莫惜明年难茂，柔枝嫩叶，多应人采揪。轻舒手，罗裙宽褪腰肢瘦。","book":"明·郑若庸《玉玦记·忆夫》"},"example":{"text":"温香软玉世应稀，～谁能比？纤腰柳舞，翠裙影低，娇喉莺啭，《阳春》调低，谩夸西子多娇丽。","book":"明·谢谠《四喜记·花亭佳偶》"},"similar":["柔枝嫩条"],"opposite":["枯木朽株"],"usage":"作宾语、定语；用于比喻句"},{"id":26552,"word":"柔枝嫩条","pinyin":"róu zhī nèn tiáo","abbr":"rznt","explanation":"柔嫩的枝条。比喻温柔美貌的妙龄女子。","source":{"text":"如本是柔枝嫩条，休比做墙花路草。","book":"明·高濂《玉簪记·词媾》"},"similar":["柔枝嫩叶"],"opposite":["枯木朽株"],"usage":"作宾语、定语；用于比喻句"},{"id":26553,"word":"柔筋脆骨","pinyin":"róu jīn cuì gǔ","abbr":"rjcg","explanation":"柔弱的筋骨。比喻文章疲软无力。","source":{"text":"士之有志于文者夥矣，抽青媲白，组织文绣，柔筋脆骨，点缀形似，徒夸艳乎。","book":"明·宋濂《〈王君子与文集〉序》"},"usage":"作宾语、定语；用于人或文章等"},{"id":26554,"word":"柔而不犯","pinyin":"róu ér bù fàn","abbr":"rebf","explanation":"犯：侵犯。指性情柔和，但不容侵犯。","source":{"text":"柔而不犯，文而有礼，忠贞之性，忧公如家。","book":"《后汉书·胡广传》"},"usage":"作谓语、定语；用于人的性格等"},{"id":26555,"word":"柔肠寸断","pinyin":"róu cháng cùn duàn","abbr":"rccd","explanation":"柔软的心肠一寸一寸地断开。形容女子的忧愁苦闷。","source":{"text":"先夫之亡，妾柔肠寸断。","book":"清·沙张白《再来诗谶记》"},"example":{"text":"泪盈盈，只怕～，不忍来听。","book":"吴梅《风洞山·鸩媒》"},"similar":["肝肠痛断","柔肠百转"],"opposite":["心花怒放","喜形于色"],"usage":"作谓语、定语、状语；指非常愁闷"},{"id":26556,"word":"柔肠百结","pinyin":"róu cháng bǎi jié","abbr":"rcbj","explanation":"柔和的心肠打了无数的结；形容心中郁结着许多愁苦。","source":{"text":"秋痕给跛脚提醒这一句，柔肠百转，方觉一股刺骨的悲酸，非常沉痛！整整和跛脚对哭到天亮。","book":"《花月痕》二七回"},"example":{"text":"那姑娘终日闷闷不乐，一幅～的模样，让人看了心酸。"},"similar":["柔肠寸断","柔肠百转"],"usage":"作谓语、定语、状语；指人情意绵绵"},{"id":26557,"word":"柔肠百转","pinyin":"róu cháng bǎi zhuǎn","abbr":"rcbz","explanation":"柔和的心肠打了无数的结。形容心中郁结着许多愁苦。","source":{"text":"你若不依着我正道，我若不指与你迷途，柳呵，你便柔肠百结，巧计千般，浑身是眼，寻不见，花枝儿般美少年。","book":"元·谷子敬《城南柳》第三折"},"example":{"text":"秋痕给跛脚提醒这一句，～，方觉一股刺骨的悲酸，非常沉痛！整整和跛脚对哭到天亮。","book":"清·魏子安《花月痕》第二十七回"},"similar":["柔肠百结"],"usage":"作谓语、定语、状语；指人情意绵绵"},{"id":26558,"word":"柔肠粉泪","pinyin":"róu cháng fěn lèi","abbr":"rcfl","explanation":"指女子柔弱的心肠和含情的眼泪。形容女性的缠绵情意。","source":{"text":"寸寸柔肠，盈盈粉泪，楼高莫近危栏倚。","book":"宋·欧阳修《踏莎行》词"}},{"id":26559,"word":"柔肤弱体","pinyin":"róu fū ruò tǐ","abbr":"rfrt","explanation":"指柔弱的身体。","source":{"text":"且少小常苦被褥泰温，泰温则不能便柔肤弱体，是以难可防护，而易用感慨。","book":"《三国志·魏志·王朗传》"},"usage":"作主语、宾语、定语；用于人","story":["三国时期，魏国的王朗年少时，因为家贫，生得柔肤弱体。长大后，一次他与华歆一起坐船逃难，有一个人想搭船依附他们，华歆立刻表示为难，王朗表示同意。贼兵追上来了，王朗想抛掉搭船人，华歆认为救人要彻底，命令立刻开船"]},{"id":26560,"word":"柔胜刚克","pinyin":"róu shèng gāng kè","abbr":"rsgk","explanation":"柔：柔顺；克：胜。一个以柔顺取胜，一个以刚强取胜。比喻方法虽然各异，但是结果相同，都能取得成功。","source":{"text":"三德：一曰正直，二曰刚克，三曰柔克。","book":"《尚书·洪范》"}},{"id":26561,"word":"柔能克刚","pinyin":"róu néng kè gāng","abbr":"rnkg","explanation":"指以柔弱的手段能够制服刚强的人。同“柔能制刚”。","source":{"text":"某素知刘备宽以待人，柔能克刚，英雄莫敌。","book":"明·罗贯中《三国演义》第六十回"},"example":{"text":"你的性质，～，你好好地耐，将来总有出头露日的一天……","book":"端木蕻良《科尔沁旗草原》十三"},"usage":"作宾语、定语；用于劝诫人"},{"id":26562,"word":"柔能制刚","pinyin":"róu néng zhì gāng","abbr":"rnzg","explanation":"指以柔弱的手段能够制服刚强的人。亦作“柔能制刚，弱能制强。”","source":{"text":"黄石公记曰：‘柔能制刚，弱能制强。’柔者德也，刚者贼也，弱者仁之助也，强者怨之归也。","book":"《后汉书·臧宫传》"},"example":{"text":"看起来这兵法不过是～，弱能胜强，以逸待劳，能勇能怯之意。","book":"明·沈采《千金记》第五出"},"similar":["柔能克刚"],"usage":"作宾语、定语；指制服刚强者"},{"id":26563,"word":"柔茹刚吐","pinyin":"róu rú gāng tǔ","abbr":"rrgt","explanation":"软的吃下去，硬的吐出来。比喻欺软怕硬。","source":{"text":"人亦有言，柔则茹之，刚则吐之。","book":"《诗经·大雅·烝民》"},"similar":["欺软怕硬","吐刚茹柔"],"usage":"作谓语、定语；指欺软怕硬"},{"id":26564,"word":"柔茹寡断","pinyin":"róu rú guǎ duàn","abbr":"rrgd","explanation":"柔茹：柔软。指处事软弱不果断。","source":{"text":"缓心而无成，柔茹而寡断，好恶无决而无所定立者，可亡也。","book":"《韩非子·亡征》"},"similar":["柔懦寡断","优柔寡断"],"opposite":["当机立断"],"usage":"作谓语、定语、宾语；指人不果断"},{"id":26565,"word":"柔远怀来","pinyin":"róu yuǎn huái lái","abbr":"ryhl","explanation":"安抚边远地区，怀柔归附者。","source":{"text":"柔远怀来，在卿良算。","book":"唐·张九龄《敕剑南节度使王昱书》"},"usage":"作宾语、定语；用于政策等"},{"id":26566,"word":"柔远怀迩","pinyin":"róu yuǎn huái ěr","abbr":"ryhe","explanation":"怀柔远方，安抚内地。","source":{"text":"岂谓蜀国皇帝，柔远怀迩，居安虑危？","book":"后蜀·何光远《鉴诫录·诛利口》"},"similar":["柔远镇迩"],"usage":"作谓语、宾语、定语；用于政策等"},{"id":26567,"word":"柔远绥怀","pinyin":"róu yuǎn suí huái","abbr":"rysh","explanation":"安抚远方归顺者。怀，归附。","source":{"text":"虽以天朝柔远绥怀，亦不能任其藐玩，应即遵照新例，一体从重惩创。","book":"清·林则徐《谕各国商人呈缴烟土稿》"},"usage":"作谓语、宾语；用于书面语"},{"id":26568,"word":"柔远能迩","pinyin":"róu yuǎn néng ěr","abbr":"ryne","explanation":"怀柔远方，优抚近地。指安抚笼络远近之人而使归附。","source":{"text":"柔远能迩，惇德允元。","book":"《书·舜典》"},"example":{"text":"瞻龙颜而有喜，肃虎拜以扬休，伏愿居安虑危，～。","book":"明·张居正《拟唐回鹘嗢没斯率众内附贺表》"},"similar":["柔远怀迩"],"usage":"作谓语、宾语、定语；用于政策等"},{"id":26569,"word":"柔远镇迩","pinyin":"róu yuǎn zhèn ěr","abbr":"ryze","explanation":"安抚远方，安定内地。","source":{"text":"移帝伊洛，定都酆镐，柔远镇迩，实敬攸考。","book":"晋·陆机《汉高祖功臣颂》"},"similar":["柔远怀迩"],"usage":"作谓语、宾语、定语；用于政策等"},{"id":26570,"word":"柔风甘雨","pinyin":"róu fēng gān yǔ","abbr":"rfgy","explanation":"柔：温和。和煦的春风和及时的春雨。泛指和风细雨。","source":{"text":"然则柔风甘雨乃至，百姓百寿，百虫乃蕃。","book":"春秋·齐·管仲《管子·四时》"},"similar":["和风细雨"],"usage":"作主语、宾语、定语；用于天气"},{"id":26571,"word":"柙虎樊熊","pinyin":"xiá hǔ fán xióng","abbr":"xhfx","explanation":"柙中的虎，樊内的熊。比喻被囚的恶人。"},{"id":26572,"word":"柙龟烹不烂，贻祸到枯桑","pinyin":"xiá guī pēng bù làn，yí huò dào kū sāng","abbr":"xgpblyhdks","explanation":"比喻有罪过的人安然无事，转祸于无辜的人。","source":{"text":"南朝·宋·刘敬叔《异苑》载：三国时有人献大龟给孙权，孙权命人煮它，烧了一万车柴都煮不烂。诸葛恪建议砍老桑树来煮，结果一煮就烂了。"}},{"id":26573,"word":"查无实据","pinyin":"chá wú shí jù","abbr":"cwsj","explanation":"查究起来，没有确实的根据或证据。","source":{"text":"那两个差头，白白的又发了一注子大财，只以‘查无实据’，禀报县公完事。","book":"清·李绿园《歧路灯》第一百一回"},"example":{"text":"不过废纸簏如果难以检查，也就成了“事出有因，～”的疑案。","book":"鲁迅《做“杂文”也不易》"},"similar":["没根没据"],"opposite":["证据确凿"],"usage":"作谓语、定语；常与“事出有因”连用"},{"id":26574,"word":"查查胡胡","pinyin":"zhā zhā hú hú","abbr":"zzhh","explanation":"咋咋呼呼。指人说话爱炫耀自己。","example":{"text":"这个人～，他的话不能相信。"},"similar":["咋咋呼呼"],"usage":"作谓语、宾语、定语；用于口语"},{"id":26575,"word":"柱天踏地","pinyin":"zhù tiān tà dì","abbr":"zttd","explanation":"指顶天立地的事物。","source":{"text":"若尽得这道理，方成个人，方可以柱天踏地，方不负此生。","book":"宋·朱熹《朱子语类》第130卷"},"similar":["顶天立地"],"usage":"作定语、谓语；形容顶天立地的事物"},{"id":26576,"word":"柱小倾大","pinyin":"zhù xiǎo qīng dà","abbr":"zxqd","explanation":"喻指能力小者承担重任必出危险。","source":{"text":"言天下事重大，臣之任当得贤能者。","book":"《汉书·李寻传》：“屋大柱小，可为寒心。唯陛下亲求贤士。”颜师古注"},"example":{"text":"～，绠短绝泉。","book":"南朝宋谢灵运《陇西行》"},"usage":"作宾语、定语；用于比喻句"},{"id":26577,"word":"柱石之坚","pinyin":"zhù shí zhī jiān","abbr":"zszj","explanation":"像柱石一样坚硬。比喻大臣坚强可靠，能担负国家重任。"},{"id":26578,"word":"柱石之士","pinyin":"zhù shí zhī shì","abbr":"zszs","explanation":"柱石：支梁的柱和承柱的石。旧时指担负国家重任的人。","source":{"text":"当今柱石之士虽少，至于行称一州，智效一官，忠信竭命，各奉其职，可并驱策，不使圣明之朝有专吏之名也。","book":"《三国志·魏志·蒋济传》"},"example":{"text":"陛下千秋万岁之后，太孙幼冲，选置兵卫，宜得～如周昌者。","book":"《晋书·阎缵传》"},"usage":"作主语、宾语；用于比喻句"},{"id":26579,"word":"柱石之寄","pinyin":"zhù shí zhī jì","abbr":"zszj","explanation":"柱石：支梁的柱和承柱的石。旧时指担负国家重任的大臣。","source":{"text":"朝廷之于伯通，恩亦厚矣，委以大郡，任以威武，事有柱石之寄，情同子孙之亲。","book":"《后汉书·朱浮传》"},"example":{"text":"该巡阅使等相从宣力有年，为国家～，应知有所举动，民具尔瞻。（丁中江《北洋军阀史话》一百八十七）"},"usage":"作宾语；用于书面语"},{"id":26580,"word":"柱石之臣","pinyin":"zhù shí zhī chén","abbr":"zszc","explanation":"柱石：支梁的柱和承柱的石。旧时指担负国家重任的大臣。","source":{"text":"位历将相，国家柱石臣也。","book":"《汉书·元后传》"},"example":{"text":"卿等皆国家～也，若能同心辅朕之子，朕死亦瞑目矣！（明·罗贯中《三国演义》第九十一回）"},"usage":"作主语、宾语；用于书面语"},{"id":26581,"word":"柳下借阴","pinyin":"liǔ xià jiè yīn","abbr":"lxjy","explanation":"比喻请求别人的庇护。","source":{"text":"武王廕暍人于樾下，左拥而右扇之，而天下怀其德。","book":"《淮南子·人间训》"},"example":{"text":"他闯了大祸后就只有找人～了"},"usage":"作宾语、定语；用于比喻句"},{"id":26582,"word":"柳亸花娇","pinyin":"liǔ duǒ huā jiāo","abbr":"ldhj","explanation":"柳丝柔垂，花朵娇妍。比喻女子貌美。","source":{"text":"身本是，柳亸花娇一女娃；身本是，翠绕珠围一宦家。","book":"清·嬴宗季女《六月霜·负笈》"},"usage":"作宾语、定语；用于书面语"},{"id":26583,"word":"柳亸莺娇","pinyin":"liǔ duǒ yīng jiāo","abbr":"ldyj","explanation":"柳丝垂，莺声娇。形容春景之美。","source":{"text":"柳亸莺娇花复殷，红亭绿酒送君还。","book":"唐·岑参《暮春虢州东亭送李司马归扶风别庐》诗"},"usage":"作宾语、定语；用于书面语"},{"id":26584,"word":"柳啼花怨","pinyin":"liǔ tí huā yuàn","abbr":"lthy","explanation":"形容景象凄凉，心境凄恻。","source":{"text":"宋·卢祖皋《夜行船·暖入新梢风又起》词：却说当时，柳啼花怨，魂梦为君迢递。"},"similar":["柳泣花啼"],"usage":"作谓语、定语；指凄凉的景象"},{"id":26585,"word":"柳圣花神","pinyin":"liǔ shèng huā shén","abbr":"lshs","explanation":"喻指风流女子。","source":{"text":"[俺]本是个柳圣花神，又不犯寡辰孤运，将俺那爷娘恨，错配了婚姻，虚度青春尽。","book":"明·无名氏《苏九淫奔》第一折"},"usage":"作宾语、定语；用于女性"},{"id":26586,"word":"柳夭桃艳","pinyin":"liǔ yāo táo yèn","abbr":"lyty","explanation":"形容女子貌美。","source":{"text":"……楚腰蛴领团香玉，鬓叠深深绿。月蛾星眼笑微频，柳夭桃艳不胜春，晚妆匀¤","book":"唐·阎选《虞美人》"},"example":{"text":"看到那些～的美女，他动心了"},"usage":"作宾语、定语；用于女性"},{"id":26587,"word":"柳娇花媚","pinyin":"liǔ jiāo huā mèi","abbr":"ljhm","explanation":"形容女子娇娆妩媚。","source":{"text":"[炀帝]又选三百二十名风流潇洒、柳娇花媚的，充作美人。","book":"《隋唐演义》第二七回"},"usage":"作宾语、定语；多用于女性"},{"id":26588,"word":"柳媚花明","pinyin":"liǔ mèi huā míng","abbr":"lmhm","explanation":"媚：美好、可爱。绿柳成荫，繁花似锦。形容美好的春光。","source":{"text":"结此生欢娱境，倚玉偎香，柳媚花明，美景良辰，行乐意同情。","book":"明·朱有燉《神仙会》第一折"},"example":{"text":"～，燕语莺声浑是笑；松号柏舞，猿啼鹤唳总成哀。","book":"清·李渔《笠翁对韵》"},"similar":["柳绿花红"],"opposite":["残花败柳"],"usage":"作谓语、定语；指春天的美景"},{"id":26589,"word":"柳宠花迷","pinyin":"liǔ chǒng huà mí","abbr":"lchm","explanation":"形容媚人的春景。","source":{"text":"蛾眉，锁不住绿肥红瘦，柳宠花迷。","book":"明·张凤翼《红拂记·拜月同祈》"},"usage":"作宾语、定语；用于春色"},{"id":26590,"word":"柳巷花街","pinyin":"liǔ xiòng huā jiē","abbr":"lxhj","explanation":"旧指妓院或妓院聚集之处。","source":{"text":"初绾云鬟，才胜罗绮，便嫌柳巷花街。","book":"宋·黄庭坚《满庭芳·妓女》词"},"example":{"text":"却说姚家有个极密的内亲，叫做周少溪，偶然在浙江衢州做买卖，闲游～，只见一个娼妇，站在门首献笑，好生面善。","book":"《初刻折案惊奇》卷二"},"similar":["柳陌花街"],"usage":"作宾语；指妓院"},{"id":26591,"word":"柳市花街","pinyin":"liǔ shì huā jiē","abbr":"lshj","explanation":"指妓院云集的地方。","source":{"text":"多置狎邪门巷，遂作莺巢燕垒，顿成柳市花街。","book":"清·黄六鸿《福惠全书·邮政·逐娼妓》"},"similar":["花街柳巷"],"usage":"作宾语；指妓院云集的地方"},{"id":26592,"word":"柳弱花娇","pinyin":"liǔ ruò huā jiāo","abbr":"lrhj","explanation":"形容女子苗条妍美。","source":{"text":"贴鬓香云双绾绿，柳弱花娇，一点春心足。","book":"宋·李冠《蝶恋花·佳人》词"},"usage":"作宾语、定语；用于女性"},{"id":26593,"word":"柳影花阴","pinyin":"liǔ yǐng huā yīn","abbr":"lyhy","explanation":"指男女幽会之处。引申为男女情爱之事。","source":{"text":"心不存学海文林，梦不离柳影花阴，则去那窃玉偷香上用心，又不曾得甚，自从海棠开想到如今。","book":"元·王实甫《西厢记》第三本第四折"},"example":{"text":"休忒恁，莫沉吟，休辜负了～。","book":"元·王元鼎《柳叶儿》曲"},"similar":["墙头马上"],"usage":"作宾语；指男女情爱"},{"id":26594,"word":"柳户花门","pinyin":"liǔ hù huā mén","abbr":"lhhm","explanation":"旧时称妓院。","source":{"text":"柳户花门从潇洒，不再蹅，一任教人道情分寡。","book":"元·马致远《青杏子·司迷》套曲"},"example":{"text":"如今这蟠桃仙子，生在吴兴地面湖州城内，落于风尘之中。然此女子……每夜焚香告天，不愿居于～。","book":"明·朱有燉《神仙会》第一折"},"similar":["花街柳巷"],"usage":"作宾语；指妓院"},{"id":26595,"word":"柳折花残","pinyin":"liǔ zhé huā cán","abbr":"lzhc","explanation":"比喻女子死或伤。","source":{"text":"贼势猖獗不可敌，柳折花残血凝碧。","book":"《红楼梦》第七八回"},"similar":["香消玉陨"],"usage":"作宾语；指女子死或伤"},{"id":26596,"word":"柳昏花暝","pinyin":"liǔ hūn huā míng","abbr":"lhhm","explanation":"暝：日暮。形容暮色中花柳的朦胧景象。","source":{"text":"红楼归晚，看足柳昏花暝。","book":"宋·史达祖《双双燕·咏燕》词"},"example":{"text":"然‘～’，自是欧秦辈句法，前后有画工、化工之殊。","book":"王国维《人间词话删稿》"},"usage":"作宾语、定语；用于书面语"},{"id":26597,"word":"柳昏花螟","pinyin":"liǔ hūn huā míng","abbr":"lhhm","explanation":"形容暮色中花柳的朦胧情景。","source":{"text":"红楼归晚，看足柳昏花螟。","book":"宋·史达祖《双双燕·咏燕》词"},"example":{"text":"然‘～’，自是欧秦辈句法，前后有画工、化工之殊。","book":"王国维《人间词话删稿》"}},{"id":26598,"word":"柳暖花春","pinyin":"liǔ nuǎn huā chūn","abbr":"lnhc","explanation":"指花柳荣茂，春意正浓。","source":{"text":"谢家生日好风烟，柳暖花春二月天。","book":"唐·李郢《为妻作生日寄意》诗"},"usage":"作宾语、定语；用于描写景物等"},{"id":26599,"word":"柳暗花明","pinyin":"liǔ àn huā míng","abbr":"lahm","explanation":"垂柳浓密，鲜花夺目。形容柳树成荫，繁花似锦的春天景象。也比喻在困难中遇到转机。","source":{"text":"柳暗花明池上山，高楼歌洒换离颜。","book":"唐·王维《早朝》诗之二：“柳暗百花明，春深五凤城。”唐·武元衡《摩河池送李侍御之凤翔》"},"example":{"text":"十二月十三日之晨，我心酸肠断，以为从此要尝些人生失望与悲哀的滋味，谁知眼前有这种～的美景。","book":"冰心《寄小读者·通讯十一》"},"similar":["山清水秀","美不胜收"],"opposite":["穷途末路","走投无路","山穷水尽"],"usage":"作定语、宾语；指环境转变","story":["南宋时期，陆游被免职回到故乡山阴，在故乡闲居三年，靠读书打发日子。四月的一天，春光明媚，他独自一人到西山游览，经过一山又一山，终于找到一个绿柳成荫的山村，就作诗《游山西村》：“山重水复疑无路，柳暗花明又一村。”"]},{"id":26600,"word":"柳暗花明又一村","pinyin":"liǔ àn huā míng yòu yī cūn","abbr":"lahmyyc","explanation":"原形容前村的美好春光，后借喻突然出现新的好形势。","source":{"text":"山重水复疑无路，柳暗花明又一村。","book":"宋·陆游《游山西村》诗"},"example":{"text":"外交上有个消息……也许急转直下，来个惊人的变化。那时候，～了，今天的一些计划自然都成了陈迹。","book":"茅盾《锻炼》三"},"usage":"作宾语、定语、分句；用于转机时","story":["南宋时期，陆游被免职回到故乡山阴，在故乡闲居三年，靠读书打发日子。四月的一天，春光明媚，他独自一人到西山游览，经过一山又一山，终于找到一个绿柳成荫的山村，就作诗《游山西村》：“山重水复疑无路，柳暗花明又一村。”"]},{"id":26601,"word":"柳暗花遮","pinyin":"liǔ àn huā zhē","abbr":"lahz","explanation":"形容深夜花柳形影朦胧的景色。","source":{"text":"漏永更长烛影香，柳暗花遮曙色分。","book":"元·吴昌龄《端正好·美妓》套曲"},"usage":"作宾语、定语；用于朦胧的景色"},{"id":26602,"word":"柳树上着刀，桑树上出血","pinyin":"liǔ shù shàng zháo dāo，sāng shù shàng chū xiě","abbr":"lsszdssscx","explanation":"比喻代人受过。","source":{"text":"比喻代人受过。"},"example":{"text":"这就是～，你说我冤不冤？"},"similar":["李代桃僵"],"usage":"作宾语、定语；用于比喻句"},{"id":26603,"word":"柳泣花啼","pinyin":"liǔ qì huā tí","abbr":"lqht","explanation":"形容风雨中花柳憔悴、黯淡的情景。","source":{"text":"朝云漠漠散轻丝，楼阁澹春姿。柳泣花啼，九街泥重，门外燕飞迟。","book":"宋·周邦彦《少年游》词"},"similar":["柳啼花怨"],"usage":"作宾语；形容暗淡的心情"},{"id":26604,"word":"柳烟花雾","pinyin":"liǔ yān huā wù","abbr":"lyhw","explanation":"形容春色迷濛的景象。","source":{"text":"尚趁得、柳烟花雾。我亦故山猿鹤怨，问何时、归棹双溪渚。","book":"宋·吴潜《贺新郎·用赵用父左司韵送郑宗丞》词"},"example":{"text":"傍蔷薇，摇露点。衣润得香长远。双枕凤，一衾鸾。～间。","book":"宋·毛滂《更漏子·熏香曲》词"},"usage":"作宾语、定语；形容春色迷蒙的景象"},{"id":26605,"word":"柳眉倒竖","pinyin":"liǔ méi dào shù","abbr":"lmds","explanation":"形容女子发怒时耸眉之状。","source":{"text":"那女子不听犹可，听了之话，只见她柳眉倒竖，杏眼圆睁；腮边烘两朵红云，面上现一团煞气。","book":"《儿女英雄传》第五回"},"example":{"text":"两人抬头一看，却就是那非常标致的女洋人夏娃丽姑娘，～，凤眼圆睁。两人这一惊非同小可。","book":"《孽海花》第十回"},"similar":["柳眉剔竖","柳眉踢竖"],"usage":"作谓语、定语；用于女性"},{"id":26606,"word":"柳眉剔竖","pinyin":"liǔ méi tī shù","abbr":"lmts","explanation":"形容女子发怒时耸眉之状。","source":{"text":"登时柳眉剔竖，星眼圆睁，叫春梅拿着打，把角门闩了，拿大棍把那狗没高没低只顾打。","book":"明·兰陵笑笑生《金瓶梅词话》第五十八回"},"example":{"text":"月华仙子见了，～，星眼圆睁道：“你却将身嫁他，我却如何？”","book":"明·冯梦龙《醒世恒言》卷三十一"},"similar":["柳眉倒竖"],"usage":"作谓语、定语；用于女性"},{"id":26607,"word":"柳眉星眼","pinyin":"liǔ méi xīng yǎn","abbr":"lmxy","explanation":"形容女子细长的眉和明亮的眼。","source":{"text":"正当年，柳眉星眼芙蓉面，绛衣缥缈，麝兰琼树，花里遇神仙。","book":"《全元散曲·斗鹌鹑·元宵》"},"example":{"text":"杏脸桃腮，酝酿出十分春色；～，妆点就一段精神。","book":"《水浒传》第三八回"},"similar":["杏脸桃腮"],"usage":"作宾语、定语；形容女子"},{"id":26608,"word":"柳眉踢竖","pinyin":"liǔ méi tī shù","abbr":"lmts","explanation":"形容女子发怒时耸眉之状。踢竖，横竖。","source":{"text":"只见那婆惜柳眉踢竖，星眼圆睁，说道：‘老娘拿是拿了，只是不还你！’","book":"《水浒传》第二一回"},"similar":["柳眉倒竖"],"usage":"作谓语、定语；用于女性"},{"id":26609,"word":"柳絮才高","pinyin":"liǔ xù cái gāo","abbr":"lxcg","explanation":"表示人有卓越的文学才能。多指女子。","source":{"text":"兄女曰：‘未若柳絮因风起。’公大笑乐。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"～称谢咏，麻衣喻切有曹诗。","book":"明·李开先《闲居集·至后复夜雪》"},"usage":"作宾语、定语；用于女性","story":["东晋时期，尚书仆射谢安在大雪纷飞的冬天里把儿女辈召集在一起谈论诗文经义，要求子侄们用诗形容此时的大雪，侄儿谢朗作诗“撒盐空中差可拟”，侄女谢道韫说“未若柳絮因风起”。谢安大笑，欣赏侄女的诗才"]},{"id":26610,"word":"柳绿桃红","pinyin":"liǔ lǜ táo hóng","abbr":"llth","explanation":"桃花嫣红，柳枝碧绿。形容花木繁盛、色彩鲜艳的春景。","source":{"text":"桃红复含宿雨，柳绿更带春烟。","book":"唐·王维《田园》诗"},"example":{"text":"试看这～，佳人罗绮，更和这紫陌红尘，青山绿水，宝马香车，游人共喜。","book":"明·无名氏《大劫牢》第四折"},"similar":["桃红柳绿","青山绿水","春光明媚"],"opposite":["残花败柳","残花落红"],"usage":"作宾语、定语；形容春天"},{"id":26611,"word":"柳绿花红","pinyin":"liǔ lǜ huā hóng","abbr":"llhh","explanation":"形容明媚的春天景象。也形容颜色鲜艳纷繁。","source":{"text":"花红柳绿间晴空。","book":"五代·蜀·魏承班《生查子》词"},"example":{"text":"忆昔东风入芳草，～看总好。","book":"明·刘基《春思》诗"},"similar":["柳绿桃红"],"usage":"作定语、宾语；形容明媚的春天景象"},{"id":26612,"word":"柳腰花态","pinyin":"liǔ yāo huā tài","abbr":"lyht","explanation":"形容女子婀娜娇美的体态。","source":{"text":"饶心性，镇厌厌多病，柳腰花态娇无力。","book":"宋·柳永《法曲献仙音》词"},"usage":"作宾语、定语；用于女性"},{"id":26613,"word":"柳腰莲脸","pinyin":"liǔ yāo lián lián","abbr":"lyll","explanation":"腰如柳，脸似莲。形容女性之美。亦代指美女。","source":{"text":"药诀棋经思致论，柳腰莲脸本忘情。","book":"唐·韩偓《频访卢秀才》诗"},"usage":"作宾语、定语；用于女性"},{"id":26614,"word":"柳莺花燕","pinyin":"liǔ yīng huā yàn","abbr":"lyhy","explanation":"指柳上莺歌，花间燕语。指美好的春景。","source":{"text":"青山隐居心自远，放浪他柳莺花燕。","book":"元·张可久《落梅风·闲居》曲"},"usage":"作宾语、定语；指春景"},{"id":26615,"word":"柳营花市","pinyin":"liǔ yíng huā shì","abbr":"lyhs","explanation":"旧指妓院或妓院聚集之处。","source":{"text":"他迎头儿便说干戈事，待风流再莫追思。塌了酒楼，焚了茶肆，柳营花市、更说甚呼燕子，唤莺儿。","book":"元·汤式《小梁州·扬子江阻风》曲"},"similar":["柳营花阵"],"usage":"作宾语；指妓院"},{"id":26616,"word":"柳营花阵","pinyin":"liǔ yíng huā zhèn","abbr":"lyhz","explanation":"旧指妓院或妓院聚集之处。","source":{"text":"厮陪奉娇香腻粉，喜相逢柳营花阵。","book":"元·吴昌龄《端正好·美妓》套曲"},"example":{"text":"他卖词章在～里逞，不管人孤另。","book":"元·汤式《对玉环带清江引·闺怨》套曲"},"similar":["柳营花市"],"usage":"作宾语；指妓院"},{"id":26617,"word":"柳营试马","pinyin":"liǔ yíng shì mǎ","abbr":"lysm","explanation":"柳营：军营。比喻带兵的将领纪律严明。","example":{"text":"周亚夫～的故事广为流传。"},"usage":"作宾语、定语；指军纪严明","story":["西汉时期，由于诸侯势力强大，中央政权不能有效控制诸侯，晁错的削藩政策正式引发“七王之乱”，汉景帝命周亚夫出兵救梁。周亚夫柳营试马，切断叛军后路，断绝其粮草供应，使叛军不战自溃，周亚夫出兵乘胜追击"]},{"id":26618,"word":"柳街柳陌","pinyin":"liǔ jiē liǔ mò","abbr":"ljlm","explanation":"柳：旧指妓女；陌：田间小路。指妓院。","source":{"text":"花街柳陌，众多妖艳名姬；楚馆秦楼，无限风流歌妓。","book":"明·施耐庵《水浒全传》第六回"}},{"id":26619,"word":"柳街花巷","pinyin":"liǔ jiē huā xiòng","abbr":"ljhx","explanation":"旧指妓院或妓院聚集之处。同“柳巷花街”。","source":{"text":"清·李渔《蜃中楼·双订》；“收藏，情随物赠，休掷在柳街花巷；更莫向人前夸示，卖弄轻狂。”"},"similar":["花街柳巷"],"usage":"作宾语；指妓院"},{"id":26620,"word":"柳衢花市","pinyin":"liǔ qú huā shì","abbr":"lqhs","explanation":"旧指妓院或妓院聚集之处。","source":{"text":"你毕罢了柳衢花市笙歌阵，我准备着凤枕鸳帏锦绣裀。","book":"元·汤式《一枝花·劝妓女从良》套曲"},"similar":["柳陌花丛","柳陌花巷","柳陌花街"],"usage":"作宾语、定语；指妓院"},{"id":26621,"word":"柳门竹巷","pinyin":"liǔ mén zhú xiàng","abbr":"lmzx","explanation":"指幽静俭朴的住宅。柳门竹巷依依在，野草青苔日日多。","source":{"text":"……柳门竹巷依依在，野草青苔日日多。纵有邻人解吹笛，山阳旧侣更谁过","book":"唐·刘禹锡《伤愚溪三首》诗云"},"example":{"text":"《谢秋心院送菊》诗云：“～鬓飞鸦，翠柏天寒倚暮霞。”。","book":"魏秀仁《花月痕》"}},{"id":26622,"word":"柳陌花丛","pinyin":"liǔ mò huā cóng","abbr":"lmhc","explanation":"旧指妓院或妓院聚集之处。","source":{"text":"人生谁能料，堪悲处，身落柳陌花丛。","book":"宋·陆游《风流子》词"},"similar":["柳陌花巷","柳陌花街"],"usage":"作宾语、定语；指妓院"},{"id":26623,"word":"柳陌花巷","pinyin":"liǔ mò huā xiàng","abbr":"lmhx","explanation":"旧指妓院或妓院聚集之处。同“柳巷花街”。","source":{"text":"柳陌花巷快乐一辈子也是死，执固板样拘束一辈子也是死。","book":"清·李绿园《歧路灯》第二十一回"},"similar":["柳陌花街"],"usage":"作宾语；指妓院"},{"id":26624,"word":"柳陌花街","pinyin":"liǔ mò huā jiē","abbr":"lmhj","explanation":"旧指妓院或妓院聚集之处。","source":{"text":"多应浪游年少客，千金将笑买，柳陌花街。","book":"元·朱庭玉《祆神急·闺思》套曲"},"example":{"text":"红楼翠馆笙歌沸，～兰麝香。","book":"元·柯丹邱《荆钗记·见母》"},"similar":["柳街花巷","柳陌花衢","柳陌花丛"],"usage":"作宾语；指妓院"},{"id":26625,"word":"柳陌花衢","pinyin":"liǔ mò huā qú","abbr":"lmhq","explanation":"旧指妓院或妓院聚集之处。","source":{"text":"新声巧笑于柳陌花衢，按管调弦于茶坊酒肆。","book":"宋·孟元老《序》"},"example":{"text":"至今～，歌姬舞女凡吟咏讴唱，莫不以柳七官人为美谈。","book":"宋·罗烨《醉翁谈录·柳屯田耆卿》"},"similar":["柳陌花街"],"usage":"作宾语、定语；指妓院"},{"id":26626,"word":"柳骨颜筋","pinyin":"jiǔ gǔ yán jīn","abbr":"lgyj","explanation":"唐·柳公权的书法骨力遒健，结构劲紧；颜真卿的书法端庄雄伟，气势开张。后因以之称其书法的字体和法度。","source":{"text":"这的堪为字史，当为款识，有柳骨颜筋，张旭张颠，羲之献之。","book":"元·王实甫《西厢记》第五本第二折"}},{"id":26627,"word":"柴天改物","pinyin":"chái tiān gǎi wù","abbr":"ctgw","explanation":"指改朝换代。改物，改变前朝的文物制度。","source":{"text":"至于钟石变声，柴天改物，民已去晋，异于延康之初，功实静乱，又殊感熙之末。","book":"《宋书·武帝纪赞》"},"example":{"text":"伏愿陛下扫地升中，～。","book":"《梁书·元帝纪》"},"similar":["改朝换代","柴天改玉"],"usage":"作宾语、定语；用于政局变化等"},{"id":26628,"word":"柴天改玉","pinyin":"chái tiān gǎi yù","abbr":"ctgy","explanation":"柴：烧柴祭天；改玉：改变佩戴的玉石。指改朝换代","source":{"text":"柴天改玉之交，皇风未畅。","book":"清·黄宗羲《余恭人传》"},"similar":["柴天改物","改朝换代"],"usage":"作宾语、定语；用于政局变化等"},{"id":26629,"word":"柴毁灭性","pinyin":"chái huǐ miè xìng","abbr":"chmx","explanation":"柴毁：因极度哀痛而骨瘦如柴。旧指因居父母丧过度悲痛而身体消瘦衰弱，危及生命。","source":{"text":"文林卒，公至性纯孝，遂庐墓侧，杖而徐起，柴毁灭性，天下之人，莫不伤叹。","book":"唐·赵儋《右拾遗陈公旌德碑》"},"similar":["哀毁骨立"],"usage":"作宾语、定语；多用于丧亲时"},{"id":26630,"word":"柴毁骨立","pinyin":"chái huǐ gǔ lì","abbr":"chgl","explanation":"柴：如木柴一样；毁：哀毁；骨立：消瘦到仿佛只剩下骨架。形容因居父母丧过度哀痛，身体受到摧残，消瘦憔悴的样子。","source":{"text":"在郡菜食斋居，朝夕哀临，每一发声，未尝不绝倒，柴毁骨立，见者哀之。","book":"《北史·陈孝意传》"},"example":{"text":"及父母既殁，居忧泣血，～，躬自建冢，高数寻。","book":"唐·无名氏《唐吴郡张常洧纪孝行铭碑》"},"similar":["哀毁骨立","骨瘦如柴"],"usage":"作定语；指消瘦","story":["隋朝时期，鲁郡司法书佐陈孝意为人公平廉洁，在郡内声望很高，他是一个难得的孝子，父亲去世，他丁忧离职，在家守丧尽孝道，期满被朝廷封为雁门郡丞，他仍然坚持整天吃素，经常思念死去的父亲，弄得人柴毁骨立"]},{"id":26631,"word":"柴立不阿","pinyin":"chái lì bù ē","abbr":"clbe","explanation":"犹言刚直不阿。","source":{"text":"余谓果有其事，年罹严谴，而公以恩遇始终，正见公之柴立不阿，世宗之知人则哲。","book":"清·陈康祺《郎潜纪闻·初笔》第七卷"},"example":{"text":"他当官以来一向都～，因此仕途失意。"},"similar":["刚正不阿"],"opposite":["阿谀逢迎"],"usage":"作谓语、定语；用于为人"},{"id":26632,"word":"柴米夫妻","pinyin":"chái mǐ fū qī","abbr":"cmfq","explanation":"为柴米的需要而结合的夫妻。指物质生活条件低微的贫贱夫妻。","source":{"text":"柴米夫妻，酒肉朋友，盒儿亲戚。","book":"明·顾起元《客座赘语·谚语》"},"example":{"text":"他们是一对典型的～。"},"opposite":["露水鸳鸯"],"usage":"作宾语、定语；指两口子"},{"id":26633,"word":"柴米油盐","pinyin":"chái mǐ yóu yán","abbr":"cmyy","explanation":"泛指一日三餐的生活必需品。","source":{"text":"若要咱称了心，则除是要到家，学知些柴米油盐价，恁时节闷减愁消受用杀。","book":"元·兰楚芳《粉蝶儿·思情》套曲"},"example":{"text":"解决群众的穿衣问题，吃饭问题，住房问题，～问题，疾病卫生问题，婚姻问题。","book":"毛泽东《关心群众生活，注意工作方法》"},"similar":["油盐酱醋"],"usage":"作主语、宾语、定语；指生活必需品"},{"id":26634,"word":"柴米油盐酱醋茶","pinyin":"chái mǐ yóu yán jiàng cù chá","abbr":"cmyyjcc","explanation":"旧指开门七件事，指必备的生活用品。","source":{"text":"元曲：早晨起来七件事，柴米油盐酱醋茶。"}},{"id":26635,"word":"柴虎肆虐","pinyin":"chái hú sì nüè","abbr":"chsn","explanation":"豺、虎：两种凶残的野兽。比喻坏人像凶残的野兽一样横行不法。","source":{"text":"帝乱其政，豺虎肆虐，真人革命之秋也。","book":"汉·张衡《南都赋》"}},{"id":26636,"word":"柴车幅巾","pinyin":"chái chē fú jīn","abbr":"ccfj","explanation":"柴车：粗劣的车；幅巾：用一幅绢束头发。坐着柴车，不戴帽子，用绢束着头发。形容作风俭朴。","source":{"text":"亭长以韩徵君当过，方发人牛修道桥，及见柴车幅巾，以为田叟也。","book":"《后汉书·韩康传》"},"usage":"作宾语、定语；指人的作风俭朴"},{"id":26637,"word":"标同伐异","pinyin":"biāo tóng fá yì","abbr":"btfy","explanation":"标：标榜；伐：声讨。帮助意见相同的人，排斥意见不同的人。","source":{"text":"真长标同伐异，侠之大者。","book":"南朝·宋·刘义庆《世说新语·轻抵》"},"similar":["党同伐异"],"usage":"作谓语、宾语、定语；指打击持不同政见的人"},{"id":26638,"word":"标奇立异","pinyin":"biāo qí lì yì","abbr":"bqly","explanation":"标：检举；立：树立。提出新的见解，表示与众不同","source":{"text":"予本意实欲标奇立异，做古今人再不敢做之题。","book":"清·李百川《绿野仙踪》第七回"},"similar":["标新立异"],"usage":"作谓语、定语、状语；用于处事"},{"id":26639,"word":"标情夺趣","pinyin":"biāo qíng duó qù","abbr":"bqdq","explanation":"指传情逗趣。","source":{"text":"明·汤显祖《邯郸记·极欲》；“只有教坊之女，搅筝琶，舞《霓裳》，乔合生，大迓鼓，醉罗歌，调笑令，但是标情夺趣，他所事皆知。”"},"usage":"作谓语、定语；指传情逗趣"},{"id":26640,"word":"标新创异","pinyin":"biāo xīn chuàng yì","abbr":"bxcy","explanation":"指提出新奇的主张，表示与众不同。","source":{"text":"以构造园亭之胜事，上之不能自出手眼，如标新创异之文人。","book":"清·李渔《闲情偶寄·居室·房舍》"},"example":{"text":"我赞同她那～的观点。"},"similar":["标新立异"],"usage":"作谓语、宾语、定语；同“标新立异”"},{"id":26641,"word":"标新取异","pinyin":"biāo xīn qǔ yì","abbr":"bxqy","explanation":"标：检举；异：特别的。提出新的见解，表示与众不同，有创见。","source":{"text":"秦妃子既能标新取异，剪彩为花，与湖山增胜。","book":"清·褚人获《隋唐演义》第28回"},"similar":["标新竞异","标新立异"],"opposite":["人云亦云"],"usage":"作谓语、定语；形容故意显示与众不同"},{"id":26642,"word":"标新立异","pinyin":"biāo xīn lì yì","abbr":"bxly","explanation":"标：提出，写明；异：不同的，特别的。提出新奇的主张，表示与众不同。","source":{"text":"支道林在白马寺中，将冯太常共语，因及《逍遥》，支卓然标新理于二家之表，立异于众贤之外。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"其中典礼集会之词，～固不可，机械陈腐亦不可。","book":"朱自清《钟明〈呕心苦唇录〉序》"},"similar":["独树一帜","另起炉灶","别出心裁"],"opposite":["因循守旧","抱残守缺","人云亦云"],"usage":"作谓语、定语；形容故意显示与众不同","story":["东晋时期佛学家支道林对《庄子》很有研究，向秀与郭象曾经为《庄子》作注。《庄子》第一篇文章《逍遥游》是最难了，支道林谈到《逍遥游》说出一种标新立异的观点，远远超出郭象他们的认识为大家所接受并流传下来"]},{"id":26643,"word":"标新竖异","pinyin":"biāo xīn shù yì","abbr":"bxsy","explanation":"指提出新奇的主张，表示与众不同。","source":{"text":"近代之流而失正者有二：抽黄对白，肥皮厚肉，其失也靡；标新竖异，牛鬼蛇神，其失也纤。","book":"清·钱谦益《序》"},"similar":["标新立异"],"usage":"作谓语、定语、宾语；形容故意显示与众不同"},{"id":26644,"word":"标新竞异","pinyin":"biāo xīn jìng yì","abbr":"bxjy","explanation":"指提出新奇的主张，表示与众不同。","source":{"text":"清·平步青《霞外攟屑·杂觚·文人害国》；“魏大中答萧元恒云：……衡文者日阅数十百卷，皆束书不观，而荒于嬉者之文。得一二标新竞异之文，安得有亟赏之而亟拔之。”"},"similar":["标新立异"],"opposite":["因循守旧"],"usage":"作谓语、定语；形容故意显示与众不同"},{"id":26645,"word":"标新领异","pinyin":"biāo xīn lǐng yì","abbr":"bxly","explanation":"标：提出，写明；异：不同的，特别的。提出新奇的主张，表示与众不同。","source":{"text":"支道林在白马寺中，将冯太常共语，因及《逍遥》，支卓然标新理于二家之表，立异于众贤之外。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"文定因之以痛哭流涕之怀，发～之论，其去游夏之传，益以远矣。","book":"清·顾炎武《答俞右吉书》"},"similar":["标新立异","标新取异","标新竖异"],"opposite":["人云亦云","老生常谈"],"usage":"作宾语、谓语、定语；形容故意与众不同"},{"id":26646,"word":"标本兼治","pinyin":"biāo běn jiān zhì","abbr":"bbjz","explanation":"标本：事物的枝节和根本。从枝节和根本方面都得到治理","example":{"text":"这个～的方法值得推广"},"opposite":["治标不治本"],"usage":"作谓语、定语；用于处事"},{"id":26647,"word":"标枝野鹿","pinyin":"biāo zhī yě lù","abbr":"bzyl","explanation":"标枝，树梢之枝，比喻上古之世在上之君恬淡无为；野鹿，比喻在下之民放而自得。后指太古时代。","source":{"text":"至治之世，不尚贤，不使能，上如标枝，民如野鹿。","book":"《庄子·天地》"},"example":{"text":"况欲以过门不入、日昃不食之世，反诸～，其不为西晋者几希？","book":"清·魏源《默觚下·治篇二》"},"usage":"作宾语、定语；指太古时代"},{"id":26648,"word":"栈山航海","pinyin":"zhàn shān háng hǎi","abbr":"zshh","explanation":"指跋山涉水，逾越险阻。","source":{"text":"栈山航海，逾沙轶漠之贡，府无虚月。","book":"南朝宋颜延之《三月三日曲水诗序》"},"example":{"text":"今息警夷嶂，恬波河渚，～，响风慕义，化民成俗，兹焉时矣。","book":"《宋书·孝武帝纪》"},"similar":["梯山航海"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":26649,"word":"栉发耨苗","pinyin":"zhì fà nòu miáo","abbr":"zfnm","explanation":"栉：梳理；耨：除草。梳头发，除杂草。比喻事情利多害少","source":{"text":"圣人之用兵也，若栉发耨苗，所去者少，而所利者多。","book":"西汉·刘安《淮南子·兵略训》"},"usage":"作宾语、定语；多用于比喻句"},{"id":26650,"word":"栉垢爬痒","pinyin":"zhì gòu pá yǎng","abbr":"zgpy","explanation":"去脏抓痒。比喻清除邪恶。","source":{"text":"君随往改试大理评事摄监察御史观察判官，栉垢爬痒，民获苏醒。","book":"唐·韩愈《试大理评事王君墓志铭》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":26651,"word":"栉比鳞差","pinyin":"zhì bǐ lín cǐ","abbr":"zblc","explanation":"像梳子的齿和鱼的鳞，密密地排列着。同“栉比鳞次”。","source":{"text":"迩来林栖谷隐，栉比鳞差。","book":"五代·王定保《唐摭言·慈恩寺题名游赏赋咏杂纪》"},"similar":["栉比鳞次","栉比鳞臻"],"usage":"作定语、状语；用于书面语"},{"id":26652,"word":"栉比鳞次","pinyin":"zhì bǐ lín cì","abbr":"zblc","explanation":"像梳子的齿和鱼的鳞，密密地排列着。亦作“栉比鳞差”。亦作“栉比鳞臻”。","source":{"text":"岸善崩者，密筑江石以护之，上植杨柳，旁种蔓荆，栉比鳞次，赖以为固。","book":"《元史·河渠志三》"},"example":{"text":"万绿丛中的土屋，～的排列着。","book":"冰心《最后的安息》"},"similar":["栉比鳞差","栉比鳞臻"],"usage":"作定语、状语；用于书面语"},{"id":26653,"word":"栉比鳞臻","pinyin":"zhì bǐ lín zhēn","abbr":"zblz","explanation":"像梳子的齿和鱼的鳞，密密地排列着。同“栉比鳞次”。","source":{"text":"真娘者，吴国之佳人也，时人比于钱唐苏小小。死葬吴宫之侧，行客感其华丽，竞为诗题于墓树，栉比鳞臻。","book":"唐·范摅《云溪友议》卷六"},"similar":["栉比鳞次","栉比鳞差"],"usage":"作定语、状语；用于书面语"},{"id":26654,"word":"栉沐风雨","pinyin":"zhì mù fēng yǔ","abbr":"zmfy","explanation":"风梳发，雨洗头。形容奔波劳苦。同“栉风沐雨”。","source":{"text":"况将士等栉沐风雨，暴露郊原，披荆棘而刁斗夜严，逐豺狼而穹庐晓破。","book":"后晋·沈昫《旧唐书·宣宗纪》"},"example":{"text":"方今晋王亲当矢石，～，王殚供军之租赋，为不急之游盘，世道未夷，人心多梗，久虚府第，远出游从，如乐祸之徒，翻然起变，拒门不纳，则王欲何归！","book":"宋·薛居正"},"similar":["栉风沐雨","栉风酾雨"],"usage":"作谓语、状语；指旅途劳苦"},{"id":26655,"word":"栉霜沐露","pinyin":"zhì shuāng mù lù","abbr":"zsml","explanation":"迎着霜，顶着露。形容奔波劳苦。","source":{"text":"栉霜沐露多劳顿，喜借得一帆风顺。","book":"清·李渔《怜香伴·僦居》"},"usage":"作宾语、定语；用于书面语"},{"id":26656,"word":"栉风沐雨","pinyin":"zhì fēng mù yǔ","abbr":"zfmy","explanation":"栉：梳头发；沐：洗头发。风梳发，雨洗头。形容人经常在外面不顾风雨地辛苦奔波。","source":{"text":"沐甚雨，栉疾风。","book":"《庄子·天下》"},"example":{"text":"～三十余年，扫荡群凶，与百姓除害，使汉室复存。","book":"明·罗贯中《三国演义》第六十一回"},"similar":["餐风露宿","栉沐风雨","栉风酾雨"],"usage":"作谓语、定语、状语；指旅途劳苦"},{"id":26657,"word":"栉风酾雨","pinyin":"zhì fēng shī yǔ","abbr":"zfsy","explanation":"风梳发，雨洗头。形容奔波劳苦。同“栉风沐雨”。","source":{"text":"都兴阿诸公，忠贞朴劲，屡摧狂寇，栉风酾雨，始终戎幕。","book":"清·陈康祺《郎潜纪闻》卷一"},"similar":["栉风沐雨","栉沐风雨"],"usage":"作谓语、状语；指旅途劳苦"},{"id":26658,"word":"栋折榱坏","pinyin":"dòng shé cuī huài","abbr":"dsch","explanation":"犹栋折榱崩。比喻倾覆。","source":{"text":"举人等栋折榱坏，同受倾压，故不避斧钺之诛，犯冒越之罪，统筹大局，为我皇上陈上。","book":"康有为等《上清帝第二书》"},"similar":["栋朽榱崩","栋榱崩折"],"usage":"作谓语、定语；指房屋倒塌"},{"id":26659,"word":"栋折榱崩","pinyin":"dòng zhé cuī bēng","abbr":"dzcb","explanation":"榱：椽子。正梁和椽子都毁坏了。比喻当政的人倒台或死去。","source":{"text":"栋折榱崩，侨将厌焉。","book":"《左传·襄公三十一年》"},"example":{"text":"睹邪说暴行之日甚，觉～之堪虞。","book":"蔡东藩、许廑父《民国通俗演义》第一百三十一回"},"similar":["栋榱崩折"],"usage":"作谓语、定语；指房屋倒塌","story":["晋朝时期，庾亮将要出逃，回头向钟雅交代自己走后的事，把朝廷重任深切地托付给他。钟雅说：“栋折榱崩，谁之责邪？”庾亮说：“当前的事，不容许再谈论了，你应该期望取得收复京都的成效啊！”钟雅说：“想足下不愧荀林父耳。”"]},{"id":26660,"word":"栋朽榱崩","pinyin":"dòng xiǔ cuī bēng","abbr":"dxcb","explanation":"犹栋折榱崩。比喻倾覆。","source":{"text":"史舜元《哀王旦》一首云‘……昔闻陕右段忠烈，今见常山颜杲卿，栋朽榱崩人短气，平生况切同年羲。’","book":"宋·陈郁《话腴》"},"example":{"text":"宣圣庙……历岁换代，～。","book":"清·叶廷琯《吹网录·三河县辽碑》"},"similar":["栋朽榱坏","栋榱崩折"],"usage":"作谓语、定语；指房屋倒塌"},{"id":26661,"word":"栋梁之器","pinyin":"dòng liáng zhī qì","abbr":"dlzq","explanation":"栋：房屋正梁；梁：架在墙上或柱子上支撑房顶的横木。比喻能担当国家重任的人才。","source":{"text":"宰相之门，豫章栝柏虽小，已有栋梁之器。","book":"《南史·陆凯传》"},"example":{"text":"清·无名氏《说呼全传》第20回：“前日的金鞭得手，这是你令祖阴空默助，将来贤侄必作～。”"},"similar":["栋梁之材"],"usage":"作宾语；指有用之才"},{"id":26662,"word":"栋梁之才","pinyin":"dòng liáng zhī cái","abbr":"dlzc","explanation":"比喻能担当大事的人才。","example":{"text":"每个青年都应该努力向上，刻苦学习，使自己成为国家的～。"}},{"id":26663,"word":"栋梁之材","pinyin":"dòng liáng zhī cái","abbr":"dlzc","explanation":"栋：脊檩，正梁。能做房屋大梁的木材。比喻能担当国家重任的人才。","source":{"text":"庾子嵩目和峤，森森如千丈松，虽磊砢有节目，施之大厦，有栋梁之用。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"将来你们姑表兄弟，必是国家～，股肱膀臂，同时出在两府，前程真是无可限量呀！","book":"端木蕻良《曹雪芹》第十六章"},"similar":["出类拔萃"],"opposite":["庸碌之辈","斗筲之材"],"usage":"作宾语；指有用之才","story":["春秋时期，少年的孔子父母双亡，只有跟着异母兄弟孟皮一起生活，孟皮劝他学赶马车，孔子则坚持好学，他想当君子，想成为国家的栋梁之材，他说：“君子谋道不谋食。”也就是这种思想迫使他怀才不遇，到处受排挤"]},{"id":26664,"word":"栋榱崩折","pinyin":"dòng cuī bēng zhé","abbr":"dcbz","explanation":"栋：正梁；榱：椽子；崩：崩坏；折：折断。梁椽毁坏，指房屋倒塌，多比喻国家或政权倾覆。","source":{"text":"栋榱崩折，势莫能支。","book":"清·汪琬《前明兵科右给事中吴公墓志铭》"},"similar":["栋折榱崩","栋朽榱崩","栋折榱坏"],"usage":"作谓语、定语；指房屋倒塌"},{"id":26665,"word":"栎樗之材","pinyin":"lì chū zhī cái","abbr":"lczc","explanation":"栎：木名；樗：俗名“臭椿”。比喻无用之材或平庸无用的人。","example":{"text":"请接受我这个～的一点忠告。"},"similar":["樗栎庸材"],"usage":"作宾语；常用作谦词"},{"id":26666,"word":"栎阳雨金","pinyin":"lì yáng yǔ jīn","abbr":"lyyj","explanation":"比喻意外的恩赐。栎阳，地名，在中国陕西省。","source":{"text":"言雨金于秦国都，明金瑞见也。","book":"《史记·秦本纪》：“扞献公呴十八年，雨金栎阳。”张守节正义"},"example":{"text":"北周·庾信《谢赵王赍丝布等启》：“陈留下粟，有愧深恩；～，翻惭曲施。”"},"usage":"作宾语、定语；用于比喻句"},{"id":26667,"word":"树上开花","pinyin":"shù shàng kāi huā","abbr":"sskh","explanation":"“三十六计”之一。亦比喻将本求利，别有收获。","source":{"text":"应元道：‘前日卑职原说这点银子不够，此刻若回曹州，往返多日。不如想个树上开花的法子，安抚衙内当案王孔目，卑职与他厮熟，太尊只须立纸文书与他，待结案时交付，岂不省一番急迫。’","book":"清·俞万春《荡寇志》第九十四回"},"example":{"text":"总而言之：这件事参出去，胡统领一面多少总可以生法，还可以‘～’。","book":"清·李宝嘉《官场现形记》第十七回"},"usage":"作谓语、宾语；用于比喻句"},{"id":26668,"word":"树之风声","pinyin":"shù zhī fēng shēng","abbr":"szfs","explanation":"树：建立；风：教化；声：风声，风气。建立好的教化，宣扬好的风气。","source":{"text":"彰善瘅恶，树之风声。","book":"《尚书·毕命》"},"example":{"text":"天眷有属，后德惟明。君临万宇，昭事百灵。濯以江汉，～。","book":"《隋书·音乐志下》"}},{"id":26669,"word":"树俗立化","pinyin":"shù sú lì huà","abbr":"sslh","explanation":"树立风俗教化。","source":{"text":"世莫不言树俗立化，彼独何道之行以至于此？","book":"《鹖冠子·王鈇》"},"usage":"作谓语、宾语；用于处事"},{"id":26670,"word":"树倒根摧","pinyin":"shù dǎo gēn cuī","abbr":"sdgc","explanation":"树干倒下，树根毁坏。比喻人已到了年老体衰的地步。","source":{"text":"柳悴也，只怕你春归人老，花残月缺，树倒根摧。","book":"元·无名氏《度柳翠》第三折"},"usage":"作谓语、宾语；用于比喻句"},{"id":26671,"word":"树倒猢孙散","pinyin":"shù dǎo hú sūn sàn","abbr":"sdhss","explanation":"树倒了，树上的猴子就散去。比喻靠山一旦垮台，随从的人也就一哄而散。","source":{"text":"宋曹咏依附秦桧，官至侍郎，显赫一时。……咏百端威胁，德斯卒不屈。及秦桧死，德斯遣人致书於曹咏，启封，乃《树倒猢猻散赋》一篇。","book":"宋·庞元英《谈薮·曹咏妻》"},"example":{"text":"若应了那句～的俗语，岂不虚称了一世诗书旧族了。","book":"清·曹雪芹《红楼梦》第十三回"}},{"id":26672,"word":"树倒猢狲散","pinyin":"shù dǎo hú sūn sàn","abbr":"sdhss","explanation":"树倒了，树上的猴子就散去。比喻靠山一旦垮台，依附的人也就一哄而散。","source":{"text":"宋曹咏依附秦桧，官至侍郎，显赫一时。……咏百端威胁，德斯卒不屈。及秦桧死，德斯遣人致书于曹咏，启封，乃《树倒猢狲散赋》一篇。","book":"宋·庞元英《谈薮·曹咏妻》"},"example":{"text":"你要知道‘～’，现在树还没有倒呢！","book":"巴金《家》"},"usage":"作宾语、定语、分句；指社会现象","story":["南宋时期，奸臣秦桧做丞相，许多势利小人都依附于他作威作福，秦桧的亲戚曹咏因善于拍马屁而当官，十分得意，唯独曹咏的大舅子厉德斯不理他那套。秦桧死，曹咏被贬职，厉德斯写了一篇《树倒猢狲散赋》派人送给曹咏"]},{"id":26673,"word":"树元立嫡","pinyin":"shù yuán lì dí","abbr":"syld","explanation":"指立嫡长子为储君。","source":{"text":"王公卿士，咸以为树元立嫡，有邦所先，守器传统，于斯为重。","book":"南朝·梁·沈约《立太子恩诏》"},"usage":"作宾语、定语；用于书面语"},{"id":26674,"word":"树功扬名","pinyin":"shù gōng yáng míng","abbr":"sgym","explanation":"树：建立；扬：称颂。建立功名，流芳于世。","source":{"text":"凡为吏，太刚则折，太柔则废，威行施之以恩，然后树功扬名，永终天禄。","book":"《汉书·隽不疑传》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":26675,"word":"树功立业","pinyin":"shù gōng lì yè","abbr":"sgly","explanation":"建立功勋和业绩。","source":{"text":"未有不得多士之尽心，而得树功立业流于歌诗也，况于诸侯哉！","book":"唐·杜牧《上宣州崔大夫书》"},"example":{"text":"男子汉当～，成就一番事业。"},"similar":["建功立业"],"opposite":["毫无建树"],"usage":"作谓语、宾语；指建立功勋和业绩"},{"id":26676,"word":"树同拔异","pinyin":"shù tóng bá yì","abbr":"stby","explanation":"指提倡相同的，排斥不同的。","source":{"text":"下论孔墨，上述羲炎，树同拔异，辨是分非。","book":"宋·司马光《稷下赋》"},"similar":["党同伐异"],"usage":"作谓语、宾语；用于书面语"},{"id":26677,"word":"树大招风","pinyin":"shù dà zhāo fēng","abbr":"sdzf","explanation":"比喻人出了名或有了钱财就容易惹人注意，引起麻烦。","source":{"text":"这正是树大招风风撼树，人为名高名丧人。","book":"明·吴承恩《西游记》第三十三回"},"example":{"text":"再者～，土地、山峦多了容易显眼，惹人反对。","book":"冯德英《迎春花》第四章"},"similar":["众矢之的","树高招风"],"opposite":["不见经传","无名小卒"],"usage":"作宾语、定语；形容地位高易受到攻击"},{"id":26678,"word":"树大根深","pinyin":"shù dà gēn shēn","abbr":"sdgs","explanation":"比喻势力强大，根基牢固。","source":{"text":"参谋长树大根深，往后还求您多照应。","book":"京剧《沙家浜》第四场"},"similar":["根深蒂固"],"usage":"作谓语、定语；用于比喻句"},{"id":26679,"word":"树德务滋","pinyin":"shù dé wù zī","abbr":"sdwz","explanation":"树：立；德：德惠；务：必须；滋：增益，加多。向百姓施行德惠，务须力求普遍。","source":{"text":"树德务滋，除恶务本。","book":"《尚书·泰誓下》"},"example":{"text":"亦曰：‘除恶务尽，～’而已。","book":"章炳麟《致段祺瑞电》"},"usage":"作谓语、宾语；用于统治者"},{"id":26680,"word":"树欲息而风不停","pinyin":"shù yù xī ér fēng bù tíng","abbr":"syxefbt","explanation":"原比喻事情不能如人的心愿。现也比喻阶级斗争不以人们的意志为转移。同“树欲静而风不止”。","source":{"text":"树欲静而风不停，子欲养而亲不待。","book":"宋·陈亮《祭凌存仲母夫人文》"},"similar":["树欲静而风不停","树欲静而风不止"],"usage":"作宾语、分句；指身不由己"},{"id":26681,"word":"树欲静而风不停","pinyin":"shù yù jìng ér fēng bù tíng","abbr":"syjefbt","explanation":"原比喻事情不能如人的心愿。现也比喻阶级斗争不以人们的意志为转移。同“树欲静而风不止”。","source":{"text":"树欲静而风不停，子欲养而亲不待。往而不来者，年也；不可再见者，亲也。","book":"《孔子家语·致思》"},"similar":["树欲静而风不宁","树欲息而风不停"],"usage":"作宾语、分句；指身不由己"},{"id":26682,"word":"树欲静而风不宁","pinyin":"shù yù jìng ér fēng bù níng","abbr":"syjefbn","explanation":"原比喻事情不能如人的心愿。现也比喻阶级斗争不以人们的意志为转移。同“树欲静而风不止”。","source":{"text":"王爵道：‘敢问师父法号？’尼姑道：‘小尼贱名真静。’王爵笑道：‘只怕树欲静而风不宁，便动动也不妨。’尼姑道：‘相公休得取笑！’","book":"明·凌濛初《二刻拍案惊奇》卷二十一"},"similar":["树欲静而风不停","树欲静而风不止"],"usage":"作宾语、分句；指身不由己"},{"id":26683,"word":"树欲静而风不息","pinyin":"shù yù jìng ér fēng bù xī","abbr":"syjefbx","explanation":"原比喻事情不能如人的心愿。现也比喻阶级斗争不以人们的意志为转移。同“树欲静而风不止”。","source":{"text":"树欲静而风不息，子欲养而亲不在，皋鱼增感；与其椎牛而祭墓，不如鸡豚之逮存，曾子兴思。","book":"明·程登吉《幼学琼林·疾病死丧》"},"similar":["树欲静而风不宁","树欲静而风不停"],"usage":"作宾语、分句；指身不由己"},{"id":26684,"word":"树欲静而风不止","pinyin":"shù yù jìng ér fēng bù zhǐ","abbr":"syjefbz","explanation":"树想要静下来，风却不停地刮着。原比喻事情不能如人的心愿。现也比喻阶级斗争不以人们的意志为转移。","source":{"text":"树欲静而风不止，子欲养而亲不待也。","book":"西汉·韩婴《韩诗外传》第九卷"},"example":{"text":"‘～’嘛，你们当中肯定会有人跳出来表演的。","book":"张贤亮《土牢情话》第三章"},"similar":["树欲静而风不停","树欲静而风不宁"],"usage":"作宾语、分句；指身不由己"},{"id":26685,"word":"树犹如此，人何以堪","pinyin":"shù yóu rú cǐ，rén hé yǐ kān","abbr":"syrcrhyk","explanation":"堪：胜任。树木尚且凋落，人怎能不衰老。","source":{"text":"昔年移柳，依依江南，今看摇落，凄怆江潭，树犹如此，人何以堪。","book":"北周·庾信《枯树赋》"},"example":{"text":"岂赋命之理，得之自然，将资生之化，有所偏及。～？","book":"唐·卢照邻《病梨树赋》"},"usage":"作宾语、分句；用于慨叹"},{"id":26686,"word":"树碑立传","pinyin":"shù bēi lì zhuàn","abbr":"sblz","explanation":"树：树立；传：传记。原指把某人生平事迹刻在石碑上或写成传记，使他的名声世代流传下去。现比喻树立个人威信，抬高个人声望。","source":{"text":"蔡邕等共论序其志，佥以为彬有过人者四……乃共树碑而颂焉。","book":"南朝·宋·范晔《后汉书·桓彬传》"},"example":{"text":"为自己歌功颂德，～，又充当打手。","book":"刘梦溪《文学是战斗的》"},"similar":["歌功颂德"],"opposite":["口诛笔伐"],"usage":"作谓语、宾语、定语；指作传"},{"id":26687,"word":"树高千丈，叶落归根","pinyin":"shù gāo qiān zhàng，yè luò guī gēn","abbr":"sgqzylgg","explanation":"树长得再高，落叶还是要回到树根。比喻离开故土时间再长，最后还是要回归故土。","source":{"text":"常言道：‘树高千丈，叶落归根’，这小厮怕养不大。若还长大了，少不得寻根问蒂，怕不认我做外公么。","book":"《平妖传》第八回"},"example":{"text":"古人有言：‘～。’卿家若然思念家乡，某家差人送你回国。","book":"清·钱彩《说岳全传》第四十六回"},"similar":["落叶归根"],"usage":"作宾语、定语；用于书面语"},{"id":26688,"word":"树高千丈，落叶归根","pinyin":"shù gāo qiān zhàng，luò yè guī gēn","abbr":"sgqzlygg","explanation":"指树虽然高达千丈，但落叶还是要回到根里。比喻离开故乡多时，最后还是要返回故里。","source":{"text":"《老子》第十六章：“万物并作，吾以观复。夫物芸芸，各复归其根。"},"example":{"text":"最后，他把这种心境归为一句话：“中国有句古语曰：～。”","book":"马辂《国共和谈演义》第三十四回"}},{"id":26689,"word":"树高招风","pinyin":"shù gāo zhāo fēng","abbr":"sgzf","explanation":"树高了容易招风打击。比喻目标大了容易招致别人的嫉妒。","source":{"text":"问曰：‘牛头未见四祖时如何？’师曰：‘潭深鱼聚。’悟曰：‘见后如何？’师曰：‘树高招风。’","book":"宋·释普济《五灯会元·太平懃禅师法嗣》"},"similar":["树大招风"],"usage":"作宾语、定语；形容地位高易受到攻击"},{"id":26690,"word":"栖丘饮谷","pinyin":"qī qiū yǐn gǔ","abbr":"qqyg","explanation":"指隐逸山林。","source":{"text":"辟宗炳为主簿，不起。问其故，答曰：‘栖丘饮谷，三十余年。’高祖善其对。","book":"《宋书·隐逸传·宗炳》"},"similar":["饮谷栖丘"],"usage":"作谓语、定语；指隐居"},{"id":26691,"word":"栖冲业简","pinyin":"qī chōng yè jiǎn","abbr":"qcyj","explanation":"指安于淡泊简朴的生活。"},{"id":26692,"word":"栖栖惶惶","pinyin":"xī xī huáng huáng","abbr":"xxhh","explanation":"栖栖：忙碌的样子；惶惶：心不安定的样子。形容忙碌不安。","source":{"text":"及至衰世，栖栖惶惶，席不暇温。","book":"晋·葛洪《抱朴子·正郭》"},"similar":["栖栖遑遑"],"usage":"作定语、状语；指心神不定"},{"id":26693,"word":"栖栖遑遑","pinyin":"xī xī huáng huáng","abbr":"qqhh","explanation":"栖栖：不安定的样子；遑遑：匆忙不安的样子。形容忙碌、仓促、身心不安。","source":{"text":"圣哲之治，栖栖遑遑。孔席不暖，墨突不黔。","book":"汉·班固《答宾戏》"},"example":{"text":"不过～，总要一车两马，我看常肃先生去买了车马再去实行才行。","book":"燕谷老人《续孽海花》第三十三回"},"similar":["栖栖惶惶"],"usage":"作定语、状语；指心神不定"},{"id":26694,"word":"栖栖默默","pinyin":"xī xī mò mò","abbr":"xxmm","explanation":"栖：忙忙碌碌。忙碌而失意的样子。","example":{"text":"看到他～的样子，知道他为人不易。"},"usage":"作定语、状语；用于口语"},{"id":26695,"word":"栖遑之辱","pinyin":"qī huáng zhī rǔ","abbr":"qhzr","explanation":"栖遑：忙忙碌碌，奔波不定的样子。四处奔忙，不得安居的劳辱。","source":{"text":"利尽万物，不能睿童昏之心；德表生民，不能救栖遑之辱。","book":"晋·陆机《演连珠》"},"usage":"作宾语；指奔波劳苦"},{"id":26696,"word":"栖风宿雨","pinyin":"qī fēng xiǔ yǔ","abbr":"qfxy","explanation":"在风雨中止息。形容奔波辛劳。","source":{"text":"反抗侵略保卫祖国，栖风宿雨是平常。","book":"《东北人民抗日歌谣选》"},"usage":"作谓语、定语；指旅途劳苦"},{"id":26697,"word":"栖鸟于泉","pinyin":"qī niǎo yú quán","abbr":"qnyq","explanation":"栖：栖息。让鸟栖息在水里。比喻处理或用人不当。","source":{"text":"若欲见吏，则是蓄鱼于树，栖鸟于泉。","book":"《南史·吴庆之传》"},"usage":"作宾语、定语；用于处事"},{"id":26698,"word":"栗栗危惧","pinyin":"lì lì wēi jù","abbr":"llwj","explanation":"栗栗：发抖的样子。形容非常害怕。","source":{"text":"栗栗危惧，若将陨于深渊。","book":"《尚书·汤诰》"},"example":{"text":"夫以我一人所遭之无依著若此。而带累妻子，举世行乎～之涂，吾能无缺然哉！","book":"清·无名氏《杜诗言志》卷十"},"usage":"作谓语、定语；形容非常害怕"},{"id":26699,"word":"栗栗自危","pinyin":"lì lì zì wēi","abbr":"llzw","explanation":"栗栗：发抖的样子。自己感到恐惧和危险。","source":{"text":"栗栗危惧，若将陨于深渊。","book":"《尚书·汤诰》"},"example":{"text":"纵然杀得谢逊，只怕这广场上也非染满鲜血、伏尸遍地不可，不由得均有～之感。","book":"金庸《倚天屠龙记》第三十七章"}},{"id":26700,"word":"栗烈觱发","pinyin":"lì liè bì bō","abbr":"llbf","explanation":"栗烈：凛冽，寒风刺骨；觱发：形容风十分寒冷。比喻天气非常寒冷。","source":{"text":"一之日觱发，二之日栗烈，无衣无褐，何以卒岁。","book":"《诗经·豳风·七月》"},"example":{"text":"偏偏的苍云渐布，黄风徐起，～，竟有酿雪的意思。","book":"清·李绿园《歧路灯》第五十回"}},{"id":26701,"word":"校名责实","pinyin":"jiào míng zé shí","abbr":"xmzs","explanation":"责：要求。按着名称或名义去寻找实际内容，使得名实相符。","source":{"text":"举直斥伪，校名责实，朝有进贤，野无遗逸，违天即地，归幽去明，空谷传古，哀风送旍。","book":"南朝·梁·萧纲《仪同徐勉墓志铭》"}},{"id":26702,"word":"校短推长","pinyin":"xiào duǎn tuī cháng","abbr":"xdtc","explanation":"指衡量人物的长处和短处。同“校短量长”。","source":{"text":"楼伊侈谋，将易储皇。公陈不可，校短推长。","book":"唐·冯宿《魏府狄梁公祠堂碑》"},"similar":["校短量长"],"usage":"作谓语；用于衡量人"},{"id":26703,"word":"校短量长","pinyin":"jiào duǎn liáng cháng","abbr":"jdlc","explanation":"指衡量人物的长处和短处。","source":{"text":"婪伊侈谋，将易储皇。公陈不可，较短推长。","book":"唐·冯宿《魏府狄梁公祠堂碑》"}},{"id":26704,"word":"栩栩如生","pinyin":"xǔ xǔ rú shēng","abbr":"xxrs","explanation":"栩栩：活泼生动的样子。指艺术形象非常逼真，如同活的一样。","source":{"text":"昔者庄周梦为胡蝶，栩栩然胡蝶也，自喻适志与！不知周也。俄然觉，则茫茫然周也。","book":"《庄子·齐物论》"},"example":{"text":"这些画里的虾所以～，是由于他深刻观察过真正的虾的生活，笔墨变化、写照已经达到了极高境界的缘故。","book":"秦牧《虾趣》"},"similar":["呼之欲出","活龙活现","有血有肉"],"opposite":["奄奄一息","半死不活","死气沉沉"],"usage":"作谓语、定语、状语；指形象非常逼真","story":["战国时期著名的哲学家庄周，常在《庄子》中讲寓言故事，借以说明自己的哲学观点。其中《庄生梦蝶》寓言就描绘他自己梦见变成一只蝴蝶，欣然自得，轻松舒畅地自由飞翔，完全忘记人世间的烦恼。梦醒后一直栩栩如生浮现在眼前"]},{"id":26705,"word":"栩栩欲活","pinyin":"xǔ xǔ yù huó","abbr":"xxyh","explanation":"犹栩栩如生。指艺术形象非常逼真，如同活的一样。","source":{"text":"昔者庄周梦为胡蝶，栩栩然胡蝶也，自喻适志与！不知周也。俄然觉，则茫茫然周也。","book":"《庄子·齐物论》"},"example":{"text":"登时飞落七七四十九只鸟鹊，高高低低，上上下下，布成阵势，弯作桥形，张开两翅，兀自～。","book":"清·韩邦庆《海上花列传》第四十回"},"similar":["栩栩如生"],"usage":"作定语、状语；用于书面语"},{"id":26706,"word":"株连蔓引","pinyin":"zhū lián màn yǐn","abbr":"zlmy","explanation":"指广泛株连。","source":{"text":"帝发怒，肃清逆党，词所连及坐诛者三万余人。及为《昭示奸党录》，布告天下，株连蔓引，迄数年未靖云。","book":"《明史·奸臣传·胡惟庸》"},"example":{"text":"公言皇上御以来，丽丹书者多大臣朝士，即使尽皆情法允协，已是幽阴景色，而况威严之下，～，九死一生。","book":"清黄宗羲《徐公神道碑铭》"},"usage":"作谓语、定语；指广泛株连"},{"id":26707,"word":"样样俱全","pinyin":"yàng yàng jù quán","abbr":"yyjq","explanation":"俱：全。一切齐全，应有尽有。","example":{"text":"我们的装备～。"},"similar":["一应俱全"],"usage":"作谓语；用于口语"},{"id":26708,"word":"根壮叶茂","pinyin":"gēn zhuàng yè mào","abbr":"gzym","explanation":"树根强壮，树叶就繁茂。用以比喻事物如果基础扎实，其发展结果就能好。","source":{"text":"但能养精神，调元气，吞津液，液精内固，及生荣华，喻树根壮叶茂，开花结实，胞孕佳味，异殊常品。","book":"宋·张君房《云笈七签》卷五十六"},"similar":["根深叶茂"],"usage":"作宾语、定语；指根基坚牢"},{"id":26709,"word":"根孤伎薄","pinyin":"gēn gū jì báo","abbr":"ggjb","explanation":"势力孤单，才智浅薄。","source":{"text":"日晏途绕，块然自丧，加以无良，根孤伎薄，既同冯衍负困之累，复抱相如痟渴之疾。","book":"南朝·宋·鲍照《侍郎报满辞阁疏》"},"usage":"作谓语、定语；用于人的处境"},{"id":26710,"word":"根据槃互","pinyin":"gēn jù pán hù","abbr":"gjph","explanation":"指把持据守，互相勾结。","source":{"text":"殿中宿卫，历世旧人皆复斥出，欲置新人以树私计。根据槃互，纵恣日甚。","book":"《三国志·魏志·曹爽传》"},"similar":["根据盘互"],"usage":"作谓语、定语；用于书面语"},{"id":26711,"word":"根据盘互","pinyin":"gēn jù pán hù","abbr":"gjph","explanation":"指把持据守，互相勾结。同“根据槃互”。","source":{"text":"殿中宿卫，易以私人，根据盘互，纵恣日甚。","book":"《资治通鉴·魏邵陵厉公嘉平元年》"},"similar":["根据槃互"],"usage":"作谓语、定语；用于书面语"},{"id":26712,"word":"根朽枝枯","pinyin":"gēn xiǔ zhī kū","abbr":"gxzk","explanation":"树根腐烂枝叶就会枯萎。比喻事物的存在丧失了根本，就会衰亡。","source":{"text":"圣人喻引树为证也。此气是人之根本，根本若绝，则藏腑筋脉如枝叶，根朽枝枯，亦以明矣。","book":"宋·张君房《云笈七签》卷五十六"},"usage":"作宾语、定语；用于比喻句"},{"id":26713,"word":"根柢未深","pinyin":"gēn dǐ wèi shēn","abbr":"gdws","explanation":"根柢：树木的根。树根还没有扎得很深。比喻事业或学业的基础不牢，底子尚薄。","source":{"text":"当及其根柢未深而扑取之。","book":"《三国志·吴志·钟离牧传》"}},{"id":26714,"word":"根株牵连","pinyin":"gēn zhū qiān lián","abbr":"gzql","explanation":"指一方有祸，另一方如同根与株一般不可避免地受到牵累。","source":{"text":"身为名宰相，不能损所憎，显示挤以仇，使比周势成，根株牵连，贤智播奔，而王室亦衰，宁明有未哲欤？","book":"《新唐书·李德裕传赞》"},"example":{"text":"故元长父子与怀素书问往来尤密，惧其～，罪相及。","book":"宋·曾敏行《独醒杂志》卷九"},"usage":"作宾语、定语；用于比喻句"},{"id":26715,"word":"根株结盘","pinyin":"gēn zhū jié pán","abbr":"gzjp","explanation":"树木的根与干盘曲相结。比喻关系错综牢固。","source":{"text":"患失之心无所不至，根株结盘，牢不可脱。","book":"《宋史·奸臣传二·蔡京》"},"similar":["盘根错节","根结盘固"],"usage":"作谓语、宾语、定语；比喻事情复杂"},{"id":26716,"word":"根株附丽","pinyin":"gēn zhū fù lì","abbr":"gzfl","explanation":"比喻依附权势。","source":{"text":"又自罗翁当国，为缙绅所辐辏，而永嘉之人根株附丽，攫美官鼓声势者尤众。","book":"明·唐顺之《与周约庵中丞论项守》"},"usage":"作宾语、定语；用于处世"},{"id":26717,"word":"根椽片瓦","pinyin":"gēn chuán piàn wǎ","abbr":"gcpw","explanation":"①一根椽，一片瓦。②指简陋的房舍。","source":{"text":"将我这铜斗儿般大院深宅，苦也囉苦也囉，可怎生烧的来剩不下些根椽片瓦。","book":"元·张国宾《合汗衫》第二折"},"example":{"text":"想他们富家，杀羊也宰马……俺百姓每痛杀，无～，那里有调和的五味全，但得个充饥罢。","book":"元·秦简夫《赵礼让肥》第一折"},"usage":"作宾语、定语；指房舍"},{"id":26718,"word":"根浅门微","pinyin":"gēn qiǎn mén wēi","abbr":"gqmw","explanation":"根基浅，门第低微。","example":{"text":"像我们这些～的人只能如此而已。"},"usage":"作谓语、定语；用于人的出身"},{"id":26719,"word":"根深叶茂","pinyin":"gēn shēn yè mào","abbr":"gsym","explanation":"茂：繁茂。根扎得深，叶子就茂盛。比喻基础牢固，就会兴旺发展。","source":{"text":"若夫修德以降命，奉命以造邦，源浚者流长，根深者叶茂，天人报应，岂相远哉。","book":"唐·张说《起义堂颂》"},"example":{"text":"一些好人、好事、好话都能浸润在她的心灵里边，血液里边，使她～。","book":"丁玲《杜晚香·根深叶茂》"},"similar":["本固枝荣","根深蒂固"],"opposite":["墙上芦苇","枯木朽株"],"usage":"作谓语、定语；指事物很繁茂"},{"id":26720,"word":"根深固本","pinyin":"gēn shēn gù běn","abbr":"gsgb","explanation":"根基牢固，难以动摇。","source":{"text":"令之有渐，轨之有度，宠之有节，权不外授，威不下黩。所以杜其萌标，重其名器，根深固本，传之百世。","book":"《晋书·伏韬传》"},"similar":["根深本固"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":26721,"word":"根深固蒂","pinyin":"gēn shēn gù dì","abbr":"gsgd","explanation":"蒂：指瓜、果、茎、枝相连处。比喻基础深厚，不容易动摇。","source":{"text":"连路蟠结，根深固蒂，各部堂司大半皆其羽翼。","book":"《明史·杨继成传》"},"similar":["根深蒂固","根牢蒂固","根盘蒂结"],"usage":"作谓语、定语；比喻基础牢固"},{"id":26722,"word":"根深本固","pinyin":"gēn shēn běn gù","abbr":"gsbg","explanation":"指根基深厚牢固。","source":{"text":"不大其栋，不能任重。重莫若国，栋莫若德。国主之有民也，犹城之有基，木之有根。根深则本固，基美则上宁。五帝三王之道，天下之纲纪，治之仪表也。","book":"《淮南子·泰族训》"},"example":{"text":"令之有渐，轨之有度，宠之有节，权不外授，威不下黩，所以杜其萌际，重其名器，深根固本，传之百世。","book":"《晋书·伏滔传》"},"similar":["根深固本"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":26723,"word":"根深枝茂","pinyin":"gēn shēn zhī mào","abbr":"gszm","explanation":"比喻基础牢固，就会兴旺发展。同“根深叶茂”。","source":{"text":"根深枝茂，号曰乔木。","book":"《艺文类聚》卷六九引汉·刘安《屏风赋》"},"similar":["根深叶茂"],"usage":"作谓语、定语；指事物很繁茂"},{"id":26724,"word":"根深柢固","pinyin":"gēn shēn dǐ gù","abbr":"gsdg","explanation":"比喻基础深厚，不容易动摇。","source":{"text":"柢固则生长，根深则视久。","book":"战国·韩·韩非《韩非子·解老》"},"example":{"text":"你不看见在这个社会里旧势力还是那样～吗？","book":"巴金《家》"},"similar":["坚不可摧","积重难返"],"opposite":["摇摇欲坠"],"usage":"作谓语；比喻基础牢固"},{"id":26725,"word":"根深蒂固","pinyin":"gēn shēn dì gù","abbr":"gsdg","explanation":"比喻基础深厚，不容易动摇。","source":{"text":"柢固则生长，根深则视久。","book":"《老子》：“有国之母，可以长久，是谓深根固柢，长生久视之道。”《韩非子·解老》"},"example":{"text":"但我总还想对于～的所谓旧文明，施行袭击，令其动摇，冀将来有万一之希望。","book":"鲁迅《两地书·十一》"},"similar":["坚不可摧","积重难返"],"opposite":["摇摇欲坠"],"usage":"作谓语、定语；比喻基础牢固"},{"id":26726,"word":"根深蒂结","pinyin":"gēn shēn dì jié","abbr":"gsdj","explanation":"犹根深蒂固。指根基深厚牢固。","source":{"text":"某流落江湖二十年，兄弟异立，未能成家，重以场屋蹉跌，遂失身于介馆马慧，岁月滋久，根深蒂结，生育男女，于义有不可负者。","book":"宋·周煇《清波杂志》卷八"},"similar":["根深蒂固","根盘蒂结"],"usage":"作谓语、定语；比喻基础牢固"},{"id":26727,"word":"根牙盘错","pinyin":"gēn yá pán cuò","abbr":"gypc","explanation":"犹言盘根错节。比喻事情纷难复杂。"},{"id":26728,"word":"根牙磐错","pinyin":"gēn yá pán cuò","abbr":"gypc","explanation":"犹言盘根错节。比喻事情纷难复杂。"},{"id":26729,"word":"根牢蒂固","pinyin":"gēn láo dì gù","abbr":"gldg","explanation":"指根基牢固。","source":{"text":"从来说‘腊雪培元气’，把麦根培植得根牢蒂固。","book":"《醒世姻缘传》第九十回"},"similar":["根深蒂固","根盘蒂结"],"usage":"作谓语、定语；比喻基础牢固"},{"id":26730,"word":"根生土长","pinyin":"gēn shēn tǔ zhǎng","abbr":"gstz","explanation":"当地出生长大。也指世代居住。","source":{"text":"我可也从头识破，都将付与，冷笑孜孜，却不道一般儿根生土长，开花结子，带叶连枝。","book":"元·吴昌龄《张天师》第三折"},"example":{"text":"他又不是咱们家～的奴才，没受过咱们什么大恩典。","book":"清·曹雪芹《红楼梦》第五十四回"},"similar":["土生土长"],"usage":"作谓语；指世代居住"},{"id":26731,"word":"根盘蒂结","pinyin":"gēn pán dì jié","abbr":"gpdj","explanation":"犹言根深蒂固。比喻基础深厚，不容易动摇。","source":{"text":"惟公言正论，不可则止，而根盘蒂结于君心者，不可猝拔。","book":"明·李东阳《读唐史》"},"similar":["根深蒂固","根牢蒂固","根深柢固"],"usage":"作谓语、定语；比喻基础牢固"},{"id":26732,"word":"根究着实","pinyin":"gēn jiū zhuó shí","abbr":"gjzs","explanation":"根究：寻根穷究，追问到底。追根究底，打听清楚。","example":{"text":"请尽快～有关情况，以便作出正确的决策。"},"usage":"作谓语、定语；用于口语"},{"id":26733,"word":"根穷底究","pinyin":"gēn qióng dǐ jiū","abbr":"gqdj","explanation":"底：底细；究：查究。追求根底。一般指追问一件事的原由。","source":{"text":"逵读书数行俱下，尤好聚古书，考历代兴衰治乱之迹，与当代名人钜公出处大节，根穷底究，尚友其人。","book":"《宋史·赵逵传》"}},{"id":26734,"word":"根结盘固","pinyin":"gēn jié pán gù","abbr":"gjpg","explanation":"比喻关系错综牢固。","source":{"text":"根结盘固，牢不可脱。","book":"《续资治通鉴·宋钦宗靖康元年》"},"similar":["盘根错节","根结盘据"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":26735,"word":"根结盘据","pinyin":"gēn jié pán jù","abbr":"gjpj","explanation":"形容基础牢固，势力强大。盘，通“磐”。","source":{"text":"有如贼因江淮之资，兵广而财积，根结盘据，西向以拒，虽终歼灭，其旷日持久必矣。","book":"《新唐书·文艺传下·李翰》"},"similar":["根结盘固"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":26736,"word":"根蟠节错","pinyin":"gēn pán jié cuò","abbr":"gpjc","explanation":"犹言盘根错节。比喻事情纷难复杂。","source":{"text":"根蟠节错相纠缠，含风饱雪经炎寒。","book":"明·李东阳《灵寿杖歌》"},"similar":["盘根错节"],"usage":"作谓语、宾语、定语；比喻事情复杂"},{"id":26737,"word":"根连株拔","pinyin":"gēn lián zhū bá","abbr":"glzb","explanation":"指连根拔除。","source":{"text":"传闻二处所抄不及十四五，盖行赂于权要者十二三，顿寄于亲戚者十三四，郿坞久营，兔窟多术，安能根连株拔，风翦霆灭。","book":"明·田艺蘅《留青日札·严嵩》"},"usage":"作宾语、定语；用于比喻句"},{"id":26738,"word":"根连株逮","pinyin":"gēn lián zhū dǎi","abbr":"glzd","explanation":"犹株连。","source":{"text":"小有词诉，根连株逮，动至什伯，系累满途，囹圄成市。","book":"《元典章·刑部二·系狱》"},"usage":"作宾语、定语；用于比喻句"},{"id":26739,"word":"格不相入","pinyin":"gé bù xiāng rù","abbr":"gbxr","explanation":"犹言格格不入。形容彼此不协调，不相容。","source":{"text":"如果专是请教别人，则各人的嗜好不同，总是格不相入的。","book":"鲁迅《而已集·读书杂谈》"},"example":{"text":"从～，而成为视之懵然，结果即不免有些弄得乱七八糟，谁也莫明其妙。","book":"鲁迅《扣丝杂感》"},"similar":["格格不入"],"usage":"作谓语、宾语、定语；用于思想感情、言行"},{"id":26740,"word":"格于成例","pinyin":"gé yú chéng lì","abbr":"gycl","explanation":"为传统的惯例所限制。表示不能达到目的。","source":{"text":"内中只有安公子此时不但自知旗人格于成例，向来没个点鼎甲的，便是他在前十名也早密密的得了信儿了。","book":"《儿女英雄传》第三六回"},"example":{"text":"清·文康《儿女英雄传》第36回：“内中只有安公子此时自知旗人～，向来没有个点鼎甲的。”"},"usage":"作谓语、定语；用于处事"},{"id":26741,"word":"格其非心","pinyin":"gé qí fēi xīn","abbr":"gqfx","explanation":"格：正；非：不正确。纠正错误、不正确的思想。","source":{"text":"绳愆纪缪，格其非心，俾克绍先烈。","book":"《尚书·冏命》"}},{"id":26742,"word":"格古通今","pinyin":"gé gǔ tōng jīn","abbr":"ggtj","explanation":"穷究古代，通晓当代。指学富识广。","source":{"text":"贤才抱德隐田园，格古通今众所传。今番诏取为官后，保祚皇图亿万年。","book":"明·无名氏《东篱赏菊》第四折"},"similar":["博古通今"],"usage":"作谓语、定语；用于称颂人"},{"id":26743,"word":"格天彻地","pinyin":"gé tiān chè dì","abbr":"gtcd","explanation":"格：感通；彻：贯通，深透。感天动地。","source":{"text":"此种精诚，格天彻地，呕血剖心，能与龙比并忠，曾闵齐孝。","book":"清·冒襄《影梅庵忆语》第二卷"},"similar":["感天动地"],"usage":"作谓语、定语；用于书面语"},{"id":26744,"word":"格杀不论","pinyin":"gé shā bù lùn","abbr":"gsbl","explanation":"格：打；格杀：打死；不论：不论罪。指把拒捕、行凶或违反禁令的人当场打死而不以杀人论罪。","source":{"text":"诸卿皆老傭也。今日设君臣之礼，反更殽乱，儿戏尚不如此，皆可格杀。","book":"《后汉书·刘盆子传》"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“王履谦便下令包围活捉，～。”"},"similar":["格杀弗论","格杀无论","格杀勿论"],"usage":"作谓语；指可将拒捕的人当场打死"},{"id":26745,"word":"格杀勿论","pinyin":"gé shā wù lùn","abbr":"gswl","explanation":"格：打；格杀：打死；勿论：不论罪。指把拒捕、行凶或违反禁令的人当场打死而不以杀人论罪。","source":{"text":"诸卿皆老傭也。今日设君臣之礼，反更殽乱，儿戏尚不如此，皆可格杀。","book":"《后汉书·刘盆子传》"},"example":{"text":"如有白拒捕等事，～。","book":"《负曝闲谈》第三回"},"similar":["格杀无论","格杀不论","格杀弗论"],"usage":"作谓语、定语；指可将拒捕的人当场打死"},{"id":26746,"word":"格杀弗论","pinyin":"gé shā fú lùn","abbr":"gsfl","explanation":"指把拒捕、行凶或违反禁令的人当场打死而不以杀人论罪。同“格杀勿论”。","source":{"text":"洋人入其界者，登时格杀弗论。","book":"清·夏燮《中西纪事·粤民义师》"},"similar":["格杀不论","格杀勿论","格杀无论"],"usage":"作谓语；指可将拒捕的人当场打死"},{"id":26747,"word":"格杀无论","pinyin":"gé shā wú lùn","abbr":"gswl","explanation":"指把拒捕、行凶或违反禁令的人当场打死而不以杀人论罪。同“格杀勿论”。","source":{"text":"清政府以‘格杀无论’对付人民，人民也以‘格杀无论’对待卖国贼。","book":"郭沫若《中国史稿》第五编第三章第三节"},"similar":["格杀弗论","格杀勿论","格杀不论"],"usage":"作谓语、定语；指可将拒捕的人当场打死"},{"id":26748,"word":"格格不入","pinyin":"gé gé bù rù","abbr":"ggbr","explanation":"格格：阻碍，隔阂。形容彼此不协调，不相容。","source":{"text":"发然后禁，则扞格而不胜。","book":"《礼记·学记》"},"example":{"text":"我本不知“运动”的人，所以凡所讲演，多与该同盟～。","book":"《鲁迅书信集·致章廷谦》"},"similar":["方枘圆凿","水火不容"],"opposite":["水乳交融","融为一体"],"usage":"作谓语、宾语、定语；用于思想感情、言行"},{"id":26749,"word":"格格不吐","pinyin":"gē gē bù tǔ","abbr":"ggbt","explanation":"指有所格碍，不能尽情论述。","source":{"text":"《上欧阳舍人书》文弱而碎，其论事又格格不吐，此少作故也。","book":"清·何焯《义门读书记·元丰类稿》"},"example":{"text":"因为要推倒旧东西，就要着力，太着力，就要‘做’，太‘做’，便不但‘生涩’，有时简直是‘～’了。","book":"鲁迅《花边文学·做文章》"},"usage":"作谓语、宾语、定语；用于文章或说话等"},{"id":26750,"word":"格格不纳","pinyin":"gē gē bù nà","abbr":"ggbn","explanation":"指难以接受。","source":{"text":"其《新唐书》好用僻字涩句，以矜其博，使人读之，胸臆间格格不纳，殊不爽朗。","book":"清·昭槤《啸亭杂录·诗文涩体》"},"usage":"作谓语、定语；用于口语"},{"id":26751,"word":"格物穷理","pinyin":"gé wù qióng lǐ","abbr":"gwql","explanation":"穷究事物的道理。","source":{"text":"其无待于外，近之于复性正心，广之于格物穷理。","book":"明·方孝孺《答郑仲辩》"},"example":{"text":"偶阅近人《夜谈丛录》，见所载焚旱魃一事、狐避二事，因存记所疑，俟～者详之。","book":"清·纪昀《阅微草堂笔记·如是我闻一》"},"usage":"作谓语、宾语；用于处事"},{"id":26752,"word":"格物致知","pinyin":"gé wù zhì zhī","abbr":"gwzz","explanation":"格：推究；致：求得。穷究事物原理，从而获得知识。","source":{"text":"致知在格物，物格而后知至。","book":"《礼记·大学》"},"example":{"text":"顾彼西洋以～为学问本始，中国非不尔云也，独何以民智之相越乃如此耶？","book":"严复《原强》"},"similar":["致知格物"],"usage":"作谓语；指研究事物原理而获得知识"},{"id":26753,"word":"格高意远","pinyin":"gé gāo yì yuǎn","abbr":"ggyy","explanation":"指文章的格调高雅，含意深远。","source":{"text":"去年得富春生孙何文数十篇，格高意远，大得六经旨趣。","book":"宋·王禹偁《送丁谓序》"},"usage":"作谓语、定语；用于作品等"},{"id":26754,"word":"桀傲不恭","pinyin":"jié ào bù gōng","abbr":"jabg","explanation":"凶悍倔强，傲慢不顺从。同“桀骜不逊”。","source":{"text":"故虽桀傲不恭，见先生，莫不感悦而化服。","book":"宋·程颢、程颐《二程遗书》"},"example":{"text":"他自恃才高，一向～。"},"similar":["桀骜不恭","桀骜不逊"],"usage":"作谓语、定语；指性情倔强凶而无礼"},{"id":26755,"word":"桀傲不驯","pinyin":"jié ào bù xùn","abbr":"jabx","explanation":"桀：凶暴；傲：傲气；驯：驯服。性情倔强凶暴不驯顺","source":{"text":"历史上久享盛名的这条旷达、豪壮的、同时也是桀傲不驯的塔里木河。","book":"储安平《在塔里木河的下游》"},"example":{"text":"我们劝说他改变～的性格"},"similar":["桀骜不逊"],"usage":"作谓语、定语；指性情倔强凶暴不驯顺"},{"id":26756,"word":"桀敖不驯","pinyin":"jié áo bù xùn","abbr":"jabx","explanation":"凶悍倔强，傲慢不顺从。同“桀骜不逊”。","source":{"text":"学生们侮辱师长，如此桀敖不驯，即使现在不入‘西歪’，将来要做‘西歪’也是难免的。","book":"茅盾《追求》"},"similar":["桀骜不驯","桀骜难驯","桀骜不恭"],"opposite":["安分守己"],"usage":"作谓语、定语；指性情倔强凶暴不驯顺"},{"id":26757,"word":"桀犬吠尧","pinyin":"jié quǎn fèi yáo","abbr":"jqfy","explanation":"桀的犬向尧狂吠。比喻奴才一心为他的主了效劳。","source":{"text":"桀之狗可使吠尧，而跖之客可使刺由。","book":"《战国策·齐策》：“跖之狗吠尧，非贵跖而贱尧也，狗固吠非其它也。”汉·邹阳《狱中上吴王书》"},"example":{"text":"当初奉献公之命，去伐蒲城，又奉惠公所差，去刺重耳，这是～，各为其主。","book":"明·冯梦龙《东周列国志》第三十六回"},"similar":["各为其主"],"usage":"作宾语；比喻坏人攻击好人"},{"id":26758,"word":"桀贪骜诈","pinyin":"jié tān ào zhà","abbr":"jtaz","explanation":"凶暴贪婪而又傲慢狡诈。","source":{"text":"虽其桀贪骜诈若李世忠、陈国瑞之流，苟有一节可用，必给以函牍，殷勤讽勉，奖其长而指其过，劝令痛改前非。","book":"清·薛福成《代李伯相拟陈督臣忠勋事实疏》"},"usage":"作谓语、宾语、定语；用于为人"},{"id":26759,"word":"桀逆放恣","pinyin":"jié nì fàng zì","abbr":"jnfz","explanation":"桀：凶暴；放恣：放纵，任性。形容凶暴任性。","source":{"text":"窃闻领荆州牧刘表桀逆放恣，所为不轨。","book":"南朝·宋·范晔《后汉书·孔融列传》"},"example":{"text":"他～的个性是积习难改。"},"usage":"作谓语、定语；指为人凶残"},{"id":26760,"word":"桀骜不恭","pinyin":"jié ào bù gōng","abbr":"jabg","explanation":"凶悍倔强，傲慢不顺从。同“桀骜不逊”。","source":{"text":"围乃共王之庶子，年齿最长，为人桀骜不恭，耻居人下，恃其才器，阴畜不臣之志。","book":"《东周列国志》第六七回"},"similar":["桀傲不恭","桀骜不驯"],"usage":"作谓语、定语；指性情倔强凶而无礼"},{"id":26761,"word":"桀骜不逊","pinyin":"jié ào bù xùn","abbr":"jabx","explanation":"凶悍倔强，傲慢不顺从。","source":{"text":"胜者张势，败者阻险，桀骜不逊，以拒陛下。","book":"宋·陈亮《酌古论·先主》"},"example":{"text":"他一点也不～。"},"similar":["桀骜不驯","桀傲不驯"],"usage":"作谓语、定语；指性情倔强凶暴不驯顺"},{"id":26762,"word":"桀骜不驯","pinyin":"jié ào bù xùn","abbr":"jabx","explanation":"凶悍倔强，傲慢不顺从。同“桀骜不逊”。","source":{"text":"历史上久享盛名的这条旷达、豪壮的、同时也是桀傲不驯的塔里木河。","book":"储安平《在塔里木河的下游》"},"example":{"text":"我们劝说他改变～的性格。"},"similar":["横冲直撞","无法无天","桀敖不驯"],"opposite":["安分守己","俯首帖耳"],"usage":"作谓语、定语；指性情倔强凶暴不驯顺"},{"id":26763,"word":"桀骜自恃","pinyin":"jié ào zì shì","abbr":"jazs","explanation":"指强横自负。","source":{"text":"他在业务上有时固执，却不像沈巧说的那样桀骜自恃。","book":"《十月》1981年第3期"},"usage":"作谓语、宾语；用于书面语"},{"id":26764,"word":"桀骜难驯","pinyin":"jié ào nán xùn","abbr":"janx","explanation":"指凶悍倔强，难以驯服。","source":{"text":"其桀骜尚如斯，安肯以爱子而为质乎？","book":"《汉书·匈奴传赞》"},"example":{"text":"故土官易制，绝不类蜀、黔诸土司～也。","book":"《清史稿·土司六·甘肃》"},"similar":["桀骜不驯","桀敖不驯","桀骜不恭"],"usage":"作谓语、定语；指性情倔强凶暴不驯顺"},{"id":26765,"word":"桀黠擅恣","pinyin":"jié xiá shàn zì","abbr":"jxsz","explanation":"桀：凶悍；黠：狡猾；擅恣：独断，放纵。指凶悍狡猾，独断专横。","source":{"text":"匈奴桀黠擅恣，入塞犯厉中国。","book":"汉·桓谭《盐铁论·本议》"}},{"id":26766,"word":"桂子兰孙","pinyin":"guì zǐ lán sūn","abbr":"gzls","explanation":"对人子孙的美称。","source":{"text":"作夫妻天长地远，还愿取桂子兰孙满玉田。","book":"明·汤显祖《紫箫记·就婚》"},"example":{"text":"只愿你夫妻重相聚会，多生些～，与祖父增点光辉。","book":"《绿野仙踪》第三十回"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":26767,"word":"桂子飘香","pinyin":"guì zǐ piāo xiāng","abbr":"gzpx","explanation":"指中秋前后桂花开放，散发馨香。","source":{"text":"桂子月中落，天香云外飘。","book":"唐·宋之问《灵隐寺》诗"},"example":{"text":"芙蓉泣露坡头见，～月下闻。","book":"宋·虞俦《有怀汉老弟》诗"},"usage":"作宾语、定语；指中秋前后桂花开放"},{"id":26768,"word":"桂宫柏寝","pinyin":"guì gōng bǎi qǐn","abbr":"ggbq","explanation":"桂、柏：两种名贵的树。指壮美华贵的宫室。","source":{"text":"桂宫柏寝拟天居，朱爵文窗韬碧疏。象床瑶度镇犀渠，雕屏匼匝组帷舒。","book":"南朝·宋·鲍照《代白纻舞歌词》"},"usage":"作宾语、定语；用于书面语"},{"id":26769,"word":"桂折一枝","pinyin":"guì shé yī zhī","abbr":"gsyz","explanation":"比喻登科及第。","source":{"text":"自知群从为儒少，岂料词场中第频。桂折一枝先许我，杨穿三叶尽惊人。","book":"唐·白居易《喜敏中及第偶示所怀》诗"},"similar":["蟾宫折桂"],"usage":"作谓语、宾语、定语；比喻考中"},{"id":26770,"word":"桂折兰摧","pinyin":"guì shé lán cuī","abbr":"gslc","explanation":"比喻品德高尚的人亡故。","source":{"text":"山蟾斗仰名空在，桂折兰摧恨未休。","book":"元·曹之谦《吊王内翰从之》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":26771,"word":"桂林一枝","pinyin":"guì lín yī zhī","abbr":"glyz","explanation":"桂花林中的一枝花。原为晋时郤诜的自谦语。后称誉人才学出众。","source":{"text":"累迁雍州刺史。武帝于东堂会送，问诜曰：‘卿自以为何如？’诜对曰：‘臣举贤良对策，为天下第一，犹桂林之一枝，昆山之片玉。’","book":"《晋书·郤诜传》"},"example":{"text":"～定谁折，黄色上眉先报喜。","book":"清·赵翼《黄雨歌》"},"similar":["昆山片玉"],"usage":"作宾语；称誉人才学出众","story":["晋朝时期，晋武帝在各地大肆选拔人才，郤诜被选中，后来升为雍州刺史。武帝在东堂巡游时接见了郤诜，问他自己感觉如何。郤诜回答说：“臣举贤良对策，为天下第一，犹桂林之一枝，昆山之片玉。”"]},{"id":26772,"word":"桂林一枝，昆山片玉","pinyin":"guì lín yī zhī，kūn shān piàn yù","abbr":"glyzkspy","explanation":"昆山：昆冈，古代产玉的地方。桂花林中的一枝花，昆山中的一块玉。比喻科举考试中的出类拔萃的佼佼者。","source":{"text":"累迁雍州刺史。武帝于东堂会送，问诜曰：‘卿自以为何如？’诜对曰：‘臣举贤良对策，为天下第一，犹桂林之一枝，昆山之片玉。’","book":"《晋书·郤诜传》"},"similar":["桂林一枝","昆山片玉"],"usage":"作宾语、分句；可分开使用","story":["晋朝时期，晋武帝在各地大肆选拔人才，郤诜被选中，后来升为雍州刺史。武帝在东堂巡游时接见了郤诜，问他自己感觉如何。郤诜回答说：“臣举贤良对策，为天下第一，犹桂林之一枝，昆山之片玉。”"]},{"id":26773,"word":"桂林杏苑","pinyin":"guì lín xìng yuàn","abbr":"glxy","explanation":"古时乡试例在农历八月举行，考中称折桂；会试例在农历三月举行，考中称探杏。因以之指乡试、会试。","source":{"text":"桂林杏苑，空成魂梦之游；虎斗龙争，又见战征之事。","book":"《儒林外史》第四二回"},"usage":"作宾语、定语；用于科举考试"},{"id":26774,"word":"桂枝片玉","pinyin":"guì zhī piàn yù","abbr":"gzpy","explanation":"“桂林一枝、昆山片玉”的省言。指登科及第。","source":{"text":"唐·柳宗元《送苑论登第后归觐》诗序：“桂枝片玉，光生于家。”参见：“桂林一枝”。"},"similar":["桂林一枝，昆山片玉"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":26775,"word":"桂楫兰桡","pinyin":"guì jí lán náo","abbr":"gjlr","explanation":"楫、桡：都是用来划船的浆。形容船上用品精美名贵。","source":{"text":"桂棹兮兰绁。","book":"战国·楚·屈原《九歌》"},"example":{"text":"船上又有各种盆景，珠帘绣幕，～，自不必说了。","book":"清·曹雪芹《红楼梦》第十八回"},"usage":"作主语、宾语、定语；用于生活等"},{"id":26776,"word":"桂殿兰宫","pinyin":"guì diàn lán gōng","abbr":"gdlg","explanation":"建筑气派，设备华美的宫殿。","source":{"text":"桂殿兰宫，列风峦之体势。","book":"唐·王勃《滕王阁序》"},"example":{"text":"金门玉户神仙府，～妃子家。","book":"清·曹雪芹《红楼梦》第十八回"},"usage":"作宾语；形容建筑气派"},{"id":26777,"word":"桂玉之地","pinyin":"guì yù zhī dì","abbr":"gyzd","explanation":"指京师。","source":{"text":"马存字长游，谓子游京师，薪如束桂，米如裹玉，世以桂玉之地为京师。","book":"宋·戴埴《鼠璞·桂玉》"},"usage":"作主语、宾语；指京师"},{"id":26778,"word":"桂薪玉粒","pinyin":"guì xīn yù lì","abbr":"gxyl","explanation":"指柴米昂贵。","source":{"text":"典出《战国策·楚策三》：苏秦之楚，三日乃得见乎王。谈卒，辞而行。楚王曰：寡人闻先生，若闻古人。今先生乃不远千里而临寡人，曾不肯留，原闻其说。对曰：楚国之食贵於玉，薪贵於桂，谒者难得见如鬼，王难得见如天帝。今令臣食玉炊桂，因鬼见帝。"},"example":{"text":"公婆年迈，慈母身孤，兼之室似罄悬，谁办～。","book":"明·陈汝元《金莲记·惊讹》"},"similar":["米珠薪桂"],"usage":"作谓语、定语、宾语；指物价昂贵","story":["战国时期，纵横家苏秦擅长辩论，凭一张嘴到处游说。他去楚国要求见楚王，把守宫门的谒者索贿不成，故意陷害他，让他先住三天，卖给他的东西特别贵。楚王见苏秦后，谈得非常投机。苏秦说楚国的米像珍珠、柴火像桂木一样贵"]},{"id":26779,"word":"桂酒椒浆","pinyin":"guì jiǔ jiāo jiāng","abbr":"gjjj","explanation":"泛指美酒。","source":{"text":"桂酒，切桂置酒中也；椒浆，以椒置浆中也。言己供待弥敬，乃以惠草蒸肴，芳兰为藉，进桂酒椒浆，以备五味也。","book":"《楚辞·九歌·东皇太一》：“蕙肴蒸兮兰藉，奠桂酒兮椒浆。”王逸注"},"example":{"text":"～，侈列宾筵之品。","book":"刘师培《文说》"},"similar":["琼浆玉液"],"usage":"作宾语、定语；指美酒"},{"id":26780,"word":"桂馥兰香","pinyin":"guì fù lán xiāng","abbr":"gflx","explanation":"桂、兰：两种散发芳香的花；馥：香。形容气味芳香。","source":{"text":"只见堂里敷设的花团锦簇，桂馥兰香……一几一椅，全是紫榆水南的名手雕工。","book":"清·曾朴《孽海花》第五回"},"example":{"text":"乌飞兔走频来往，～岂暂移。","book":"郭沫若《〈孔雀胆〉的故事》"},"similar":["桂馥兰馨"],"usage":"作谓语、宾语；指气味芳香"},{"id":26781,"word":"桂馥兰馨","pinyin":"guì fù lán xīn","abbr":"gflx","explanation":"桂：桂花；馥：香气；兰：兰草；馨：芳香。形容气味芳香。","source":{"text":"还作了两首诗留别。其一云：……鸟飞兔走频来往，桂馥兰馨岂暂移？","book":"郭沫若《的故事》"},"similar":["桂馥兰香"],"usage":"作谓语、宾语、定语；指气味芳香"},{"id":26782,"word":"桃之夭夭","pinyin":"táo zhī yāo yāo","abbr":"tzyy","explanation":"喻事物的繁荣兴盛。亦形容逃跑。桃，谐音“逃”。有时含诙谐义。","source":{"text":"诗云，‘桃之夭夭，其叶蓁蓁，之子于归，宜其家人。’宜其家人，而后可以教国人。","book":"《诗经·周南·桃夭》：“桃之夭夭，灼灼其华。”毛传：“桃有华之盛者，夭夭，其少壮也。”《礼记·大学》"},"example":{"text":"那知卢才听见钮成死了，料道不肯干休，已先～，不在话下。","book":"明·冯梦龙《醒世恒言》第二十九卷"},"similar":["逃之夭夭"],"usage":"作谓语；是逃跑诙谐的说法"},{"id":26783,"word":"桃伤李仆","pinyin":"táo shāng lǐ pū","abbr":"tslp","explanation":"仆：向前跌倒。比喻兄弟休戚与共。","source":{"text":"终言桃伤而李仆，谕兄弟当相为表里。","book":"唐·吴兢《乐府古题要解·鸡鸣》"}},{"id":26784,"word":"桃僵李代","pinyin":"táo jiāng lǐ dài","abbr":"tjld","explanation":"原比喻兄弟友爱相助，后转用为互相顶替或代人受过。同“李代桃僵”。","source":{"text":"复社自有周之夔之案，奕琛自有薛国观之案，奕琛又欲纽而一之，而曰复社操戈，繇臣指授，此所谓桃僵李代也。","book":"清·钱谦益《遵旨回话疏》"},"example":{"text":"伤心极，恁～，鱼网鸿罹。","book":"清·伤时子《苍鹰击·株连》"},"similar":["李代桃僵"],"usage":"作宾语、定语；多用于比喻句"},{"id":26785,"word":"桃夭新妇","pinyin":"táo yāo xīn fù","abbr":"tyxf","explanation":"桃夭：比喻女子年轻貌美。形容年轻而漂亮的新婚女子。","source":{"text":"桃之夭夭，灼灼其华。之子于归，宜其室家。","book":"《诗经·周南·桃夭》"},"example":{"text":"赵五娘于归两月，即别蔡邕，是一～。","book":"清·李渔《闲情偶寄·演习部·变调》"},"usage":"作主语、宾语；用于女性"},{"id":26786,"word":"桃夭李艳","pinyin":"táo yāo lǐ yàn","abbr":"tyly","explanation":"桃李盛开。泛指春日美景。","source":{"text":"桃夭李艳清明近，惆怅当年意尽违。","book":"唐·罗邺《东归》诗"},"usage":"作定语；用于景物描写"},{"id":26787,"word":"桃夭柳媚","pinyin":"táo yāo liǔ mèi","abbr":"tylm","explanation":"形容女子年青貌美。","source":{"text":"锦帐添香睡，金炉换夕熏。懒结芙蓉带，慵拖翡翠裙。正是桃夭柳媚，那堪暮雨朝云。","book":"前蜀·毛文锡《赞浦子》词"},"usage":"作宾语、定语；多用于比喻句"},{"id":26788,"word":"桃弧棘矢","pinyin":"táo hú jí shǐ","abbr":"thjs","explanation":"桃木做的弓，棘枝做的箭，古人认为可辟邪。","source":{"text":"桃弧棘矢，以除其灾。","book":"《左传·昭公四年》"},"usage":"作状语、宾语；用于迷信"},{"id":26789,"word":"桃李不言，下自成行","pinyin":"táo lǐ bù yán，xià zì chéng háng","abbr":"tlbyxzch","explanation":"古谚语。比喻实至名归。","source":{"text":"桃李不言，下自成行；德之休明，没能弥彰。","book":"晋·潘岳《太宰鲁武公诔》"},"similar":["桃李不言，下自成蹊"],"usage":"作宾语、分句；指实至名归"},{"id":26790,"word":"桃李不言，下自成蹊","pinyin":"táo lǐ bù yán，xià zì chéng xī","abbr":"tlbyxzcq","explanation":"蹊：小路。原意是桃树不招引人，但因它有花和果实，人们在它下面走来走去，走成了一条小路。比喻人只要真诚、忠实，就能感动别人","source":{"text":"谚曰：‘桃李不言，下自成蹊。’此言虽小，可以谕大也。","book":"西汉·司马迁《史记·李将军列传论》"},"example":{"text":"～”，你不必过于急躁","book":"俗话说"},"similar":["桃李不言，下自成行"],"usage":"作宾语、分句；指实至名归","story":["西汉名将李广英勇善战，历经汉文帝、景帝、武帝，立下赫赫战功，匈奴单于都很敬佩他，对部下也很谦虚和蔼。西汉政府并没重用李广，60多岁被迫自杀，许多部下及不相识的人都自动为他痛哭，司马迁称赞他是“桃李不言，下自成蹊”"]},{"id":26791,"word":"桃李之教","pinyin":"táo lǐ zhī jiào","abbr":"tlzj","explanation":"指老师的教诲。","source":{"text":"今日吉辰，来拜了先生。学生自愧蒲柳之姿，敢烦桃李之教。","book":"明·汤显祖《牡丹亭·延师》"},"usage":"作宾语；用于书面语"},{"id":26792,"word":"桃李之馈","pinyin":"táo lǐ zhī kuì","abbr":"tlzk","explanation":"原指互赠礼品，后引申指送礼，贿赂。","source":{"text":"投之以桃，报之以李。","book":"《诗·大雅·抑》"},"example":{"text":"明·归有光《河南策问对二道》：“吹毛求疵，诋欺无限，～，集以成罪。”"},"usage":"作主语、宾语；指送礼"},{"id":26793,"word":"桃李争妍","pinyin":"táo lǐ zhēng yán","abbr":"tlzy","explanation":"桃花和李花竞相开放。用以形容春色美丽。","source":{"text":"春花艳艳，看红白桃李争妍。","book":"明·无名氏《万国来朝》第二折"},"example":{"text":"及登舟解缆，正当～之候。","book":"清·沈复《浮生六记·闺房记乐》"},"similar":["桃柳争妍","桃李争辉"],"usage":"作谓语、定语；指春天"},{"id":26794,"word":"桃李争辉","pinyin":"táo lǐ zhēng huī","abbr":"tlzh","explanation":"桃花和李花竞相开放。用以形容春色美丽。","source":{"text":"花也，则为你不与那繁花争媚，花也，则为你不同他桃李争辉。","book":"元·无名氏《東篱赏菊》第三折"},"similar":["桃李争妍","桃柳争妍"],"usage":"作谓语、定语；指春天"},{"id":26795,"word":"桃李年","pinyin":"táo lǐ nián","abbr":"tln","explanation":"桃李花争艳的年纪。比喻女子的青春时期。","source":{"text":"昔闻兰蕙月，独是桃李年。","book":"南朝·梁·萧衍《咏笔》诗"},"example":{"text":"自惜～，误身游侠子。","book":"唐·韦应物《拟古诗十二首》其二"}},{"id":26796,"word":"桃李成蹊","pinyin":"táo lǐ chéng qī","abbr":"tlcq","explanation":"“桃李不言，下自成蹊”的省语。比喻人只要真诚、忠实，就能感动别人。","source":{"text":"结交贤豪多杜陵，桃李成蹊卧落英。","book":"南朝·齐·谢朓《和徐都曹出新亭渚诗》：“桃李成蹊径，桑榆荫道周。”宋·黄庭坚《次韵答杨子闻见赠》诗"},"example":{"text":"迟日惠风柔，～绿渐稠。","book":"金·元好问《南乡子》词"},"similar":["桃李不言，下自成蹊"],"usage":"作宾语、分句；指实至名归"},{"id":26797,"word":"桃李无言，下自成蹊","pinyin":"táo lǐ wú yán，xià zì chéng xī","abbr":"tlwyxzcq","explanation":"古谚语。比喻实至名归。","source":{"text":"多情山鸟不须啼，桃李无言，下自成蹊。","book":"宋·辛弃疾《一剪梅·独立苍茫醉不归》词"},"similar":["桃李不言，下自成蹊"],"usage":"作宾语、分句；指实至名归"},{"id":26798,"word":"桃李春风","pinyin":"táo lǐ chūn fēng","abbr":"tlcf","explanation":"比喻学生受到良师的谆谆教诲。","source":{"text":"长成来奏三千牍，桃李春风冠集英。","book":"宋·杨万里《送刘童子》诗"},"example":{"text":"菖蒲夜雨平郊坰，～动学墙。","book":"清·金人瑞《吴明府生日》诗"},"usage":"作宾语、定语；多用于比喻句"},{"id":26799,"word":"桃李满天下","pinyin":"táo lǐ mǎn tiān xià","abbr":"tlmtx","explanation":"桃李：指培养的后辈或所教的学生。比喻学生很多，各地都有。","source":{"text":"天下桃李，悉在公门矣。","book":"《资治通鉴·唐纪·武后久视元年》"},"example":{"text":"而黄更是当代大儒，海内人望，不惟～，而且不少故旧门生身居显要。","book":"姚雪垠《李自成》第二卷第三十三章"},"similar":["遍布天涯","桃李遍天下"],"usage":"作谓语、宾语；用于教师","story":["唐朝时期，武则天夺权执政，她为了巩固政权，对外招贤纳士，网络人才。宰相狄仁杰，为人正直，心地无私，深受武则天的信任，他推荐几十名人才都受重用，有人对狄仁杰说：“天下桃李，悉在公门矣。”"]},{"id":26800,"word":"桃李精神","pinyin":"táo lǐ jīng shén","abbr":"tljs","explanation":"形容妖艳娇媚的神态。","source":{"text":"正是破瓜年几，含情惯得人饶。桃李精神鹦鹉舌，可堪虚度良宵。","book":"五代·和凝《河满子》词之一"},"usage":"作主语、宾语；用于比喻句"},{"id":26801,"word":"桃李遍天下","pinyin":"táo lǐ biàn tiān xià","abbr":"tlbtx","explanation":"桃李：桃树和李树，比喻培养的后辈或所教的学生。比喻学生很多，各地都有。","source":{"text":"天下桃李，悉在公门矣。","book":"《资治通鉴·唐纪·武后久视元年》"},"example":{"text":"而性阔大，不甚饰边幅，爱乐贤士大夫，与共功名，朝有所知，夕即登荐，以是～。","book":"明·焦竑《玉堂丛语·荐举》"},"similar":["桃李满天下"],"usage":"作宾语、分句；指教师","story":["唐朝时期，武则天夺权执政，她为了巩固政权，对外招贤纳士，网络人才。宰相狄仁杰，为人正直，心地无私，深受武则天的信任，他推荐几十名人才都受重用，有人对狄仁杰说：“天下桃李，悉在公门矣。”"]},{"id":26802,"word":"桃李门墙","pinyin":"táo lǐ mén qiáng","abbr":"tlmq","explanation":"门墙：指师门。指他人的学生或所栽培的后辈。","source":{"text":"你待打、打这哇哇，桃李门墙，险把负荆人唬煞。","book":"明·汤显祖《牡丹亭·闺塾》"},"example":{"text":"为代作一二首以实之，以夸其～之盛。","book":"清·钱泳《履园丛话·笑柄》"},"usage":"作宾语、定语；用于教师"},{"id":26803,"word":"桃来李答","pinyin":"táo lái lǐ dá","abbr":"tlld","explanation":"比喻互相酬赠。","source":{"text":"投我以桃，报之以李。","book":"语出《诗·大雅·抑》"},"example":{"text":"明·王錂《春芜记·构衅》：“况且～，一定也不折本。”"},"similar":["投桃报李"],"usage":"作宾语、定语；用于交往等"},{"id":26804,"word":"桃柳争妍","pinyin":"táo liǔ zhēng yán","abbr":"tlzy","explanation":"妍：美艳。桃花和柳树比美。用以形容春色美丽。","source":{"text":"桃柳争妍花开绽，见年年桃柳开残。","book":"元·张鸣善《套数·普天乐》曲"},"example":{"text":"五个人一同往沥泉山来。一路上春光明媚，～，不觉欣欣喜喜。","book":"清·钱彩《说岳全传》第四回"},"similar":["桃李争妍","桃李争辉"],"usage":"作谓语、定语；指春天"},{"id":26805,"word":"桃红柳绿","pinyin":"táo hóng liǔ lǜ","abbr":"thll","explanation":"桃花嫣红，柳枝碧绿。形容花木繁盛、色彩鲜艳的春景。","source":{"text":"桃红复含宿雨，柳绿更带春烟。","book":"唐·王维《田园》诗"},"example":{"text":"背着香袋来到西湖朝拜的善男信女，心中并无多少教义的踪影，眼角却时时关注着～、莼菜醋鱼。","book":"余秋雨《文化苦旅·西湖梦》"},"similar":["柳绿桃红"],"usage":"作定语、宾语；泛指春天的景色"},{"id":26806,"word":"桃羞李让","pinyin":"táo xiū lǐ ràng","abbr":"txlr","explanation":"桃和李都感到羞愧，只好退让。形容女子比花还要艳丽动人。","source":{"text":"更兼这些人打扮的桃羞杏让，燕妒莺惭。","book":"清·曹雪芹《红楼梦》第二十七回"}},{"id":26807,"word":"桃羞杏让","pinyin":"táo xiū xìng ràng","abbr":"txxr","explanation":"桃花和杏花都感到羞愧，只好退让。形容女子比花还要艳丽动人。","source":{"text":"更兼这些人打扮的桃羞杏让，燕妒莺惭。","book":"清·曹雪芹《红楼梦》第二十七回"},"similar":["沉鱼落雁"],"usage":"作定语、状语；用于比喻句"},{"id":26808,"word":"桃腮杏脸","pinyin":"táo sāi xìng liǎn","abbr":"tsxl","explanation":"形容女子容貌美丽。同“杏脸桃腮”。","source":{"text":"到得故园春正好。桃腮杏脸迎门笑。","book":"宋·吕胜己《蝶恋花》词"},"example":{"text":"当下揽袖近前，替她拂拭，一经去垢，露出庐山真面，端的是～，妖艳绝伦。","book":"蔡东藩《后汉演义》第八十一回"},"similar":["杏脸桃腮"],"usage":"作宾语、定语；用于女性"},{"id":26809,"word":"桃腮柳眼","pinyin":"táo sāi liǔ yǎn","abbr":"tsly","explanation":"形容初开的桃花和新绿的柳叶妩媚多姿。","source":{"text":"一转眼已到了春假。我再到韦君别墅的时候，水是绿绿的，桃腮柳眼，着意引人。","book":"朱自清《阿河》"},"usage":"作宾语、定语；多用于比喻句"},{"id":26810,"word":"桃腮粉脸","pinyin":"táo sāi fěn liǎn","abbr":"tsfl","explanation":"形容女子粉红色的面颊。","source":{"text":"桃腮粉脸，描两道细细春山。","book":"《金瓶梅词话》第六十二回"},"usage":"作宾语、定语；用于女性"},{"id":26811,"word":"桃花人面","pinyin":"táo huā rén miàn","abbr":"thrm","explanation":"形容女子貌美。亦借指意中人。同“人面桃花”。","source":{"text":"杨柳宫眉，桃花人面，是平生未了缘。","book":"元·刘致《朝天子·同文子方邓永年泛洞庭湖宿凤凰台下》曲"},"example":{"text":"鸭背斜阳闪闪红，～薄纱笼。","book":"清·黄遵宪《不忍池晚游》诗"},"similar":["人面桃花"],"usage":"作定语、宾语；用于忆念爱人"},{"id":26812,"word":"桃花流水","pinyin":"táo huā liú shuǐ","abbr":"thls","explanation":"形容春日美景。也比喻男女爱情。","source":{"text":"桃花流水窅然去，别有天地非人间。","book":"唐·李白《山中问答》诗"},"example":{"text":"～，不出人间。","book":"明·徐宏祖《徐霞客游记·盘江考》"},"similar":["流水桃花"],"usage":"作宾语、定语；用于书面语"},{"id":26813,"word":"桃花潭水","pinyin":"táo huā tán shuǐ","abbr":"thts","explanation":"比喻友情深厚。","source":{"text":"桃花潭水深千尺，不及汪伦送我情。","book":"唐·李白《赠汪伦》诗"}},{"id":26814,"word":"桃花薄命","pinyin":"táo huā bó mìng","abbr":"thbm","explanation":"桃花：借指女人；薄命：命多悲惨。比喻女子容貌美丽但命运不好。","source":{"text":"诸般不象，只是桃花薄命流终平康也，也与他出塞的苦没甚差别。","book":"明·阮大钺《燕子笺·写象》"},"similar":["红颜薄命"],"usage":"作宾语、定语；用于女性"},{"id":26815,"word":"桃花运","pinyin":"táo huā yùn","abbr":"thy","explanation":"指男子得到女子的特别爱恋。泛指好运气。","source":{"text":"现在正交着桃花运，难保不出乱子，让他回家给方乡绅严加管不也好。","book":"钱钟书《围城》"},"example":{"text":"他新近交了～，不再形只影单了。"},"usage":"作宾语、定语；多用于男性"},{"id":26816,"word":"桃蹊柳曲","pinyin":"táo qī liǔ qǔ","abbr":"tqlq","explanation":"指春景艳丽的地方。同“桃蹊柳陌”。","source":{"text":"桃蹊柳曲闲踪迹，俱曾是大堤客，解春衣贳酒城南陌。","book":"宋·周邦彦《迎春乐》词"},"similar":["桃蹊柳陌"],"usage":"作主语、宾语；用于书面语"},{"id":26817,"word":"桃蹊柳陌","pinyin":"táo qī liǔ mò","abbr":"tqlm","explanation":"指春景艳丽的地方。亦作“桃蹊柳曲”。","source":{"text":"桃蹊柳陌好经过，镫下妆成月下歌。","book":"唐·刘禹锡《蹋歌词》之二"},"similar":["桃蹊柳曲"],"usage":"作主语、宾语；用于书面语"},{"id":26818,"word":"案兵束甲","pinyin":"àn bīng shù jiǎ","abbr":"absj","explanation":"放下兵器，捆束铠甲。指停止作战。","source":{"text":"若不能当，何不案兵束甲，北面而事之！","book":"《三国志·蜀志·诸葛亮传》"},"similar":["案甲休兵","卷甲韬戈"],"usage":"作谓语、定语；指停止战事"},{"id":26819,"word":"案剑瞋目","pinyin":"àn jiàn chēn mù","abbr":"ajcm","explanation":"案：同“按”，握住；瞋：瞪眼。握住宝剑，瞪大双眼。","source":{"text":"案剑瞋目，声如乳虎。","book":"《庄子·盗跖》：“案剑瞋目，声如乳虎。”《庄子·盗跖》"},"similar":["瞋目案剑"],"usage":"作谓语；形容愤怒"},{"id":26820,"word":"案堵如故","pinyin":"àn dǔ rú gù","abbr":"adrg","explanation":"堵：墙壁，居所；故：原来的。像原来一样相安无事。","source":{"text":"诸吏人皆案堵如故。","book":"《史记·高祖本纪》"},"similar":["安堵如故","按堵如故"],"usage":"作谓语、宾语；指社会秩序"},{"id":26821,"word":"案无留牍","pinyin":"àn wú liú dú","abbr":"awld","explanation":"桌案上没有积压的公文。形容办理公务干练、及时。","source":{"text":"一十七年，国奢示之以俭，事烦行之以简，月要岁会，久而案无留牍。","book":"清·朱彝遵《商丘宋氏家乘》序"},"example":{"text":"一应公事，张令都听他决断。真是～，狱无冤刑，民心大悦。","book":"清·黄小配《洪秀全演义》"},"usage":"作宾语；指办理公务及时"},{"id":26822,"word":"案牍之劳","pinyin":"àn dú zhī láo","abbr":"adzl","explanation":"案牍：公文。办理公文的劳累。","source":{"text":"无丝竹之乱耳，无案牍之劳形。","book":"唐·刘禹锡《陋室铭》"},"example":{"text":"吾徒幸无～，且有休退之日，登高能赋，此其时乎？","book":"明·李桢《长安夜行录》"},"similar":["案牍劳形"],"usage":"作宾语；指办理公文事物的劳累"},{"id":26823,"word":"案牍劳形","pinyin":"àn dú láo xíng","abbr":"adlx","explanation":"案牍：公文。文书劳累身体。形容公事繁忙。","source":{"text":"无丝竹之乱耳，无案牍之劳形。","book":"唐·刘禹锡《陋室铭》"},"similar":["日理万机"],"usage":"作宾语；形容公事繁忙"},{"id":26824,"word":"案甲休兵","pinyin":"àn jiǎ xiū bīng","abbr":"ajxb","explanation":"指停止战事，休养士卒。","source":{"text":"方今为将军计莫如案甲休兵，镇赵抚其孤。","book":"《史记·淮阴侯列传》"},"similar":["按甲休兵"],"usage":"作谓语、宾语；指停战"},{"id":26825,"word":"案萤干死","pinyin":"àn yíng gān sǐ","abbr":"aygs","explanation":"书案上借以照明的萤火虫都干死了。形容正直的读书人做官被贬或死后，居处荒凉的景况。","source":{"text":"穷乡悄然车马绝，案头干死读书萤。","book":"唐·杜甫《题郑十八著作虔》"}},{"id":26826,"word":"桎辖之桎","pinyin":"zhì xiá zhī zhì","abbr":"zxzz","explanation":"桎辖：车辖。比喻重要的大臣或事情的关键。","source":{"text":"氏，当作桎鎋之桎，毗辅也，言尹氏作大师之官，为周之桎鎋。","book":"《诗经·小雅·节南山》：“尹氏大师，维周之氏。”郑玄笺"}},{"id":26827,"word":"桑中之喜","pinyin":"sāng zhōng zhī xǐ","abbr":"szzx","explanation":"指男女不依礼法的结合。","source":{"text":"此借用‘桑中’一词，暗指巫臣与夏姬私约。","book":"《左传·成公二年》：“申叔跪从其父，将适郢，遇之，曰：‘异哉！夫子有三军之惧，而又有桑中之喜，宜将窃妻以逃者也。’”杨伯峻"},"example":{"text":"[南北二帅]方其未败，锦衣玉食，倡优歌舞，其厮养贱纨绮，吸洋烟，莫不有～。","book":"《花月痕》第四六回"},"usage":"作主语、宾语；用于男女之间"},{"id":26828,"word":"桑中之约","pinyin":"sāng zhōng zhī yuē","abbr":"szzy","explanation":"桑中：桑林之间。指男女幽会的的密约。","source":{"text":"期我乎桑中，要我乎上宫，送我乎淇之上矣。","book":"《诗·鄘风·桑中》"},"example":{"text":"～，不可长也。日在帡幪之下，倘肯赐以姻好，父母必以为荣，当无不庇，宜速为计。","book":"清·蒲松龄《聊斋志异·窦氏》"},"similar":["桑间月下"],"usage":"作宾语；指男女幽会"},{"id":26829,"word":"桑中生李","pinyin":"sāng zhōng shēng lǐ","abbr":"szsl","explanation":"桑树上长李树。比喻少见多怪。","example":{"text":"～的事情在农村时有发生。"},"similar":["蜀犬吠日"],"usage":"作宾语、定语；指少见多怪","story":["从前在南顿农民张助捡到一颗李子核，拿回家种在空心的桑树上，很快就长成了一棵李子树，同时开始结李子。村民觉得奇怪，以为是神灵出现，就纷纷拿出贡品来李树下拜祭。张助感到诧异，干脆将李树砍了"]},{"id":26830,"word":"桑土之谋","pinyin":"sāng tǔ zhī móu","abbr":"stzm","explanation":"比喻勤于经营谋划，防患未然。同“桑土绸缪”。","source":{"text":"古者国家无事则预桑土之谋，有事则议金汤之策。","book":"《明史·赵世卿传》"},"similar":["桑土之防","桑土绸缪"],"usage":"作宾语、定语；用于书面语"},{"id":26831,"word":"桑土之防","pinyin":"sāng tǔ zhī fáng","abbr":"stzf","explanation":"比喻防患于未然。同“桑土绸缪”。","source":{"text":"至于桑土之防，戒备之虑，此自吾之常事，不容一日少懈者。","book":"明·张居正《答王鉴川计贡市利害》"},"similar":["桑土绸缪","桑土之谋"],"usage":"作宾语、定语；用于书面语"},{"id":26832,"word":"桑土绸缪","pinyin":"sāng tǔ chóu miù","abbr":"stcm","explanation":"比喻勤于经营，防患未然。","source":{"text":"土，音杜。桑土，桑根皮也……我及天未阴雨之时，而往取桑根以缠绵巢之隙穴，使之坚固，以备阴雨之患。","book":"《诗·豳风·鸱鸮》：“迨天之未阴雨，彻彼桑土，绸缪牖户。”朱熹集传"},"example":{"text":"明·张居正《门生为师相高公六十寿序》：“虽～，不劬如此矣。”"},"similar":["绸缪桑土","桑土之防"],"usage":"作宾语、定语；用于书面语"},{"id":26833,"word":"桑弧之志","pinyin":"sāng hú zhī zhì","abbr":"shzz","explanation":"旧时指男儿在四方干一番事业的志向。","source":{"text":"男子生，桑弧蓬矢六，射天地四方。天地四方者，男子之所有事也。","book":"《礼记·射义》"}},{"id":26834,"word":"桑弧蒿矢","pinyin":"sāng hú hāo shǐ","abbr":"shhs","explanation":"指行桑弧蓬矢之礼以励志。蒿，蓬蒿。同“桑弧蓬矢”。","source":{"text":"王莽世，教授弟子恒五百余人。每春秋飨射，常备列典仪，以素木瓠叶为俎豆，桑弧蒿矢，以射菟首。","book":"《后汉书·儒林传上·刘昆》"},"similar":["桑弧蓬矢"],"usage":"作谓语、定语、宾语；指男子的理想"},{"id":26835,"word":"桑弧蓬矢","pinyin":"sāng hú péng shǐ","abbr":"shps","explanation":"古代男子出生，射人用桑木做的弓，蓬草做的箭，射天地四方，表示有远大志向的意思。","source":{"text":"吉者宿齐，朝服寝门外，诗负之，射人以桑弧蓬矢六，射天地四方。","book":"西汉·戴圣《礼记·内则》"},"example":{"text":"男子初生，以～，射天地四方。","book":"清·龚自珍《与吴虹生书》"},"similar":["桑弧蒿矢"],"usage":"作谓语、定语、宾语；指男子的理想"},{"id":26836,"word":"桑户桊枢","pinyin":"sāng hù juàn shū","abbr":"shjs","explanation":"以桑枝为门，木条为枢。形容居处简陋，家境贫寒。"},{"id":26837,"word":"桑户棬枢","pinyin":"sāng hù juàn shū","abbr":"shjs","explanation":"以桑枝为门，木条为枢。形容居处简陋，家境贫寒。","source":{"text":"且夫苏秦特穷巷掘门、桑户棬枢之士耳。","book":"《战国策·秦策一》"},"similar":["桑户蓬枢"],"usage":"作宾语、定语；用于书面语"},{"id":26838,"word":"桑户蓬枢","pinyin":"sāng hù péng shū","abbr":"shps","explanation":"编桑枝为门，立蓬条为枢。形容家境贫穷。","source":{"text":"假如原宪是个善士，桑户蓬枢，颜渊是一个好人，簟食瓢饮。","book":"明·梁辰鱼《浣沙记·遗求》"},"similar":["桑户棬枢"],"usage":"作宾语、定语；用于书面语"},{"id":26839,"word":"桑枢瓮牖","pinyin":"sāng shū wěng yǒu","abbr":"sswy","explanation":"枢：门上的转轴；瓮牖：简陋的窗户。用桑树做门轴，用瓦罐做窗户，比喻贫苦之家。","source":{"text":"蓬户不完，桑以为枢机而瓮牖。","book":"《庄子·让王》"},"example":{"text":"我便是～，他也情愿的布袄荆钗。","book":"元·武汉臣《玉壶春》第三折"},"similar":["蓬门荜户"],"usage":"作谓语、宾语；指生活贫困"},{"id":26840,"word":"桑枢甕牖","pinyin":"sāng shū wèng yǒu","abbr":"sswy","explanation":"以桑木为门轴，以破甕为窗口。形容贫寒之家。","source":{"text":"原宪居鲁……蓬户不完，桑以为枢而甕牖，二室，褐以为塞。","book":"语出《庄子·让王》"}},{"id":26841,"word":"桑枢畒牖","pinyin":"sāng shū wèng yǒu","abbr":"sswy","explanation":"以桑木为门轴，以破畒为窗口。形容贫寒之家。","source":{"text":"原宪居鲁……蓬户不完，桑以为枢而畒牖，二室，褐以为塞。","book":"语出《庄子·让王》"}},{"id":26842,"word":"桑枢韦带","pinyin":"sāng shū wéi dài","abbr":"sswd","explanation":"桑枢，桑木的门轴。韦带，无饰的皮革腰带。后以之形容贫家寒士。","source":{"text":"夫布衣韦带之士，修身于内，成名于外。","book":"《庄子·让王》：“原宪居鲁……桑以为枢。”汉贾山《至言》"},"example":{"text":"唐·骆宾王《上司列太常伯启》：“某蓬庐布衣，～。”"},"usage":"作宾语、定语；用于生活"},{"id":26843,"word":"桑梓之地","pinyin":"sāng zǐ zhī dì","abbr":"szzd","explanation":"桑、梓：古时经常栽种在家宅旁边的树木，代称故乡。比喻故乡。","source":{"text":"那郢都乃是桑梓之地，少不得去看一看坟墓，会一会亲友。","book":"明·冯梦龙《警世通言》卷一"},"example":{"text":"他是河南永城县人，开封是河南的省会，也就是～，首府所在。","book":"姚雪垠《李自成》第三卷第二十二章"},"usage":"作宾语；指故乡"},{"id":26844,"word":"桑梓之念","pinyin":"sāng zǐ zhī niàn","abbr":"szzn","explanation":"指对故乡的思念。","source":{"text":"乡禽何事亦来此，令我心忆桑梓间。","book":"《诗经·小雅·小弁》：“维桑与梓，必恭敬止。”唐·柳宗元《闻黄鹂》诗"}},{"id":26845,"word":"桑榆之光，理无远照","pinyin":"sāng yú zhī guāng，lǐ wú yuǎn zhào","abbr":"syzglwyz","explanation":"形容人已到暮年，能做的事不多了。","source":{"text":"桑榆之光，理无远照，但愿朝阳之晖与时并明耳。","book":"南朝·宋·刘义庆《世说新语·规箴》"}},{"id":26846,"word":"桑榆之年","pinyin":"sāng yú zhī nián","abbr":"syzn","explanation":"形容人已到暮年。","source":{"text":"臣桑榆之年，钟鸣漏尽，蒙陛下之泽，首领获全，待尽私庭，下奉先帝、陛下大恩，臣之愿也。","book":"《魏书·游明根传》"}},{"id":26847,"word":"桑榆之景","pinyin":"sāng yú zhī jǐng","abbr":"syzj","explanation":"指晚年时光。","source":{"text":"虽迫桑榆之景，犹倾葵藿之心。","book":"唐·刘禹锡《谢分司东都表》"},"example":{"text":"吾辈风烛余年，正足自娱～，岂堪以粉黛重自斧斫耶。","book":"清·黄轩祖《游梁琐记·三麻子》"},"similar":["桑榆末景"],"usage":"作主语、宾语；比喻垂老之年"},{"id":26848,"word":"桑榆晚景","pinyin":"sāng yú wǎn jǐng","abbr":"sywj","explanation":"夕阳的余辉照在桑榆树梢上。指傍晚。比喻晚年的时光。","source":{"text":"年在桑榆间，影响不能追。","book":"《淮南子·天文训》：“日西垂，景在树端，谓之桑榆。”三国·魏·曹植《赠白马王彪》诗"},"example":{"text":"松柏节操，美其寿元之耐久；～，自谦老景之无多。","book":"明·程登吉《幼学求源·外戚》"},"similar":["桑榆暮景","桑榆末景","桑榆暮影"],"usage":"作主语、宾语、定语；比喻垂老之年"},{"id":26849,"word":"桑榆暮影","pinyin":"sāng yú mù yǐng","abbr":"symy","explanation":"桑榆；夕阳余光所在的地方。夕阳斜照桑榆树的黄昏景象，指傍晚。比喻垂老之年。","source":{"text":"年老云桑榆暮影。","book":"《书言故事·耆老类》"},"similar":["桑榆末景","桑榆暮景","桑榆晚景"],"usage":"作主语、宾语、定语；比喻垂老之年"},{"id":26850,"word":"桑榆暮景","pinyin":"sāng yú mù jǐng","abbr":"symj","explanation":"夕阳的余辉照在桑榆树梢上。指傍晚。比喻晚年的时光。","source":{"text":"年在桑榆间，影响不能追。","book":"三国魏·曹植《赠白马王彪》诗"},"example":{"text":"教子攻书志未酬，～且淹留。","book":"元·尚仲贤《柳毅传书》第一折"},"similar":["风烛残年","桑榆末景","桑榆暮影"],"usage":"作主语、宾语、定语；比喻垂老之年"},{"id":26851,"word":"桑榆末景","pinyin":"sāng yú mò jǐng","abbr":"symj","explanation":"夕阳的余辉照在桑榆树梢上。指傍晚。比喻晚年的时光。同“桑榆暮景”。","source":{"text":"桑榆末景，或可回三舍之戈。","book":"清·顾炎武《与李霖瞻书》"},"similar":["桑榆暮景","桑榆暮影","暮景桑榆"],"usage":"作主语、宾语、定语；比喻垂老之年"},{"id":26852,"word":"桑田沧海","pinyin":"sāng tián cāng hǎi","abbr":"stch","explanation":"桑田：农田。大海变成桑田，桑田变成大海。比喻世事变化很大。","source":{"text":"麻姑自说云，接待以来，已见东海三为桑田。","book":"晋·葛洪《神仙传·麻姑》"},"example":{"text":"～任更差，他自无惊无讶。","book":"明·吴承恩《西游记》第七回"},"similar":["沧海桑田"],"usage":"作宾语、分句；比喻世事变化很大","story":["从前仙人王远和麻姑，他们相约到蔡经家去饮酒，王远一行很快就到蔡经家，但没见到麻姑的到来，就派使者去请。麻姑到来说她奉命去巡视蓬莱，已经三次见到东海变成桑田，现在海水又退了一半。王远说那里又要扬起尘土来了"]},{"id":26853,"word":"桑田碧海","pinyin":"sāng tián bì hǎi","abbr":"stbh","explanation":"大海变成桑田，桑田变成大海。比喻世事变化很大。同“桑田沧海”。","source":{"text":"节物风光不相待，桑田碧海须臾改。","book":"唐·卢照邻《长安古意》诗"},"example":{"text":"～须臾改，歌舞流光不相待。","book":"明·夏完淳《翠华篇》"},"similar":["沧海桑田"],"usage":"作宾语、定语；用于书面语"},{"id":26854,"word":"桑荫不徙","pinyin":"sāng yīn bù xǐ","abbr":"sybx","explanation":"指人之意气相投，相知无须时日长久。亦指时间短暂。","source":{"text":"昔者尧见舜于草茅之中，席陇亩而荫庇桑，荫移而授天下传。","book":"语出《战国策·赵策四》"},"similar":["桑荫未移"],"usage":"作宾语、定语；用于书面语"},{"id":26855,"word":"桑荫未移","pinyin":"sāng yīn wèi yí","abbr":"sywy","explanation":"指人之意气相投，相知无须时日长久。亦指时间短暂。同“桑荫不徙”。","source":{"text":"昔者尧见舜于草茅之中，席陇亩而荫庇桑，荫移而授天下传。","book":"语出《战国策·赵策四》"},"example":{"text":"舜受大麓，～而已陟帝位，皆所以祗承天命，若此之速也。","book":"《三国志·魏志·文帝纪》“以肃承天命”裴松之注引《献帝传》"},"similar":["桑荫不徙"],"usage":"作宾语、定语；用于书面语"},{"id":26856,"word":"桑落瓦解","pinyin":"sāng luò wǎ jiě","abbr":"slwj","explanation":"象桑叶枯落，屋瓦解体。形容事势败坏到不可收拾的地步。","source":{"text":"桑落瓦解，其势可见。","book":"《后汉书·孔融传》"},"similar":["土崩瓦解","一败涂地"],"usage":"作谓语、宾语；指形势等"},{"id":26857,"word":"桑间之咏","pinyin":"sāng jiān zhī yǒng","abbr":"sjzy","explanation":"指描写男女情爱的诗歌。同“桑间濮上①”。","source":{"text":"其集多桑间之咏，不足传也。","book":"明·杨循吉《蓬轩吴记》卷上"},"usage":"作主语、宾语；用于书面语"},{"id":26858,"word":"桑间之约","pinyin":"sāng jiān zhī yuē","abbr":"sjzy","explanation":"指男女之间的约会。同“桑间濮上②”。","source":{"text":"美人者某挥使女也，慕伯虎才名，暗以手书订桑间之约，期以八月十五试毕赴之。","book":"清·唐仲冕《六如居士遗事》"},"similar":["桑间濮上","桑中之约"],"usage":"作主语、宾语；用于书面语"},{"id":26859,"word":"桑间之音","pinyin":"sāng jiān zhī yīn","abbr":"sjzy","explanation":"指淫靡的音乐。同“桑间濮上①”。","source":{"text":"世浊则礼烦而乐淫，郑卫之声，桑间之音，此乱国之所好，衰德之所说。","book":"《吕氏春秋·音初》"},"similar":["桑间濮上"],"usage":"作主语、宾语；用于书面语"},{"id":26860,"word":"桑间濮上","pinyin":"sāng jiān pú shàng","abbr":"sjps","explanation":"桑间在濮水之上，是古代卫国的地方。①古指淫靡的音乐。。②后也指男女幽会。","source":{"text":"桑间濮上之音，亡国之音也。","book":"《礼记·乐记》"},"example":{"text":"卫地有～之阻，男女亦亟聚会，声色生焉。","book":"《汉书·地理志下》"},"similar":["桑间濮上"],"usage":"作宾语、定语；指男女幽会的地方"},{"id":26861,"word":"桥归桥，路归路","pinyin":"qiáo guī qiáo，lù guī lù","abbr":"qgqlgl","explanation":"比喻互不相干的事应该严格区分开来。","source":{"text":"王老哥，我们做这件事的要诀是，桥归桥、路归路，切忌扯在一起，混杂不清。","book":"高阳《李鸿章》第八章"},"example":{"text":"我们还是～，不要扯在一块。"},"similar":["井水不犯河水"],"usage":"作宾语、状语；指互不相干"},{"id":26862,"word":"桥是桥，路是路","pinyin":"qiáo shì qiáo，lù shì lù","abbr":"qsqlsl","explanation":"比喻互不相干的事应该严格区分开来。同“桥归桥，路归路”。","source":{"text":"就是萧队长也得说个理。我姓韩的桥是桥，路是路，一清二白的，怕谁来歪我不成，倒要问问老赵哥？","book":"周立波《暴风骤雨》第一部七"}},{"id":26863,"word":"桴鼓相应","pinyin":"fú gǔ xiāng yìng","abbr":"fgxy","explanation":"桴：鼓槌。用鼓槌打鼓，鼓就响起来。比喻相互应和，配合得很紧密。","source":{"text":"“好！”慈禧太后～地说，“别的差缺慢慢商量吧！” ★高阳《清宫外史》上册"},"example":{"text":"郭沫若《洪波曲》第九章：“这些团体和三厅的工作是能够～的。”"},"opposite":["唱对台戏"],"usage":"作谓语；比喻相互应和，配合紧密"},{"id":26864,"word":"梁上君子","pinyin":"liáng shàng jūn zǐ","abbr":"lsjz","explanation":"梁：房梁。躲在梁上的君子。窃贼的代称。现在有时也指脱离实际、脱离群众的人。","source":{"text":"时岁荒民俭，有盗夜入其室，止于梁上。寔阴见，乃起自整拂，呼命子孙，正色训之曰：‘夫人不可以不自勉。不善之人未必本恶，習以性成，遂至于此。梁上君子者是矣！","book":"《后汉书·陈寔传》"},"example":{"text":"邑西某乙，故～也。","book":"清·蒲松龄《聊斋志异·某乙》"},"opposite":["正人君子"],"usage":"作主语、宾语；比喻小偷","story":["东汉灵帝时小官吏陈寔心地善良，做事公正无私。有天晚上一个小偷溜进他的屋里躲在屋梁上，他发现后并没有下令捉拿，而是把儿子、孙子叫到身边，给他们讲如何做人，不要学梁上的那位君子。小偷深受感动就下地求饶。陈寔给钱放他回"]},{"id":26865,"word":"梁园虽好，不是久恋之家","pinyin":"liáng yuán suī hǎo，bù shì jiǔ liàn zhī jiā","abbr":"lyshbsjlzj","explanation":"梁园：汉梁孝王修建的一座名园。指一切繁华快乐的场所，都不如自己的家乡那样值得留恋。","source":{"text":"却不道是：梁园虽好，不是久恋之家。","book":"清·江东老蟫《京本通俗小说·错斩崔宁》"}},{"id":26866,"word":"梁孟相敬","pinyin":"liáng mèng xiāng jìn","abbr":"lmxj","explanation":"原指东汉时期梁鸿与妻子孟光相互敬爱。后泛指夫妇相敬。","source":{"text":"每归，妻为具食，不敢于鸿前仰视，举案齐眉。伯通察而异之，曰：‘彼佣能使其妻敬之如此，非凡人也。’","book":"《后汉书·梁鸿传》"},"similar":["举案齐眉"],"usage":"作宾语、定语；用于夫妻间","story":["东汉时期，书生梁鸿读完太学回家务农，与县上孟财主的30岁女儿孟光结婚，婚后他们抛弃孟家的富裕生活，到霸陵山区隐居，后来帮皋伯通打短工。每次孟光给梁鸿送饭时把托盘举得跟眉毛一样高，眉来眼去，夫妻十分恩爱和睦"]},{"id":26867,"word":"梁木其坏","pinyin":"liáng mù qí huài","abbr":"lmqh","explanation":"原指孔子把自己的死比作像栋梁的损坏。后用为对众人所敬仰的人之死的哀悼之辞。","source":{"text":"孔子蚤作，负手曳杖，逍遥于门，歌曰：‘泰山其颓乎，梁木其坏乎，哲人其萎乎。","book":"《礼记·檀弓下》"}},{"id":26868,"word":"梅妻鹤子","pinyin":"méi qī hè zǐ","abbr":"mqhz","explanation":"以梅为妻，以鹤为子。比喻清高或隐居。宋·林逋隐居西湖孤山，植梅养鹤，终生不娶，人谓“梅妻鹤子”。","source":{"text":"林逋隐居杭州孤山，常畜两鹤，纵之则飞入云霄，盘旋久之，復入笼中。逋常泛小艇，游西湖诸寺。有客至逋所居，则一童子出应门，延客坐，为开笼纵鹤。良久，逋必棹小船而归。盖尝以鹤飞为验也。","book":"宋·沈括《梦溪笔谈·人事二》"},"example":{"text":"兆熊说：‘像是像，不过，有最重要的一点不像。人家和靖居士是～，你却是妻儿成群。’","book":"唐浩明《曾国藩第一部·血祭》第二章四"},"similar":["鹤子梅妻"],"usage":"作宾语、定语；指隐士的生活"},{"id":26869,"word":"梅林止渴","pinyin":"méi lín zhǐ kě","abbr":"mlzk","explanation":"看到梅林就可以止渴。比喻愿望无法实现，用空想安慰自己。","source":{"text":"梅林能止渴，复姓可防兵。","book":"北周·庾信《出自蓟北门行》"},"example":{"text":"阳焰充饥，～。（宋·释惟白《续传灯录》卷十三）"}},{"id":26870,"word":"梓匠轮舆","pinyin":"zǐ jiàng lún yú","abbr":"zjly","explanation":"梓匠：木工；轮舆：制车轮和木箱的人。泛指有手艺的人。","source":{"text":"梓匠轮舆能与人规矩，不能使人巧。","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"木之就规矩，在～。","book":"唐·韩愈《符读书城南》"},"similar":["能工巧匠"],"usage":"作主语、宾语、定语；指工匠"},{"id":26871,"word":"梗泛萍漂","pinyin":"gěng fàn píng piāo","abbr":"gfpp","explanation":"断梗、浮萍在水中漂浮。比喻漂泊流离。","source":{"text":"只为他孤身去梗泛萍漂，撇的俺三口儿梦断魂劳。","book":"元·张国宾《罗李郎》第二折"},"example":{"text":"经几番凶荒战斗，怎免得～。","book":"清·孔尚任《桃花扇·哭主》"}},{"id":26872,"word":"梗泛萍飘","pinyin":"gěng fàn píng piāo","abbr":"gfpp","explanation":"断梗、浮萍在水中漂浮。比喻漂泊流离。","source":{"text":"只为他孤身去梗泛萍飘，撇的俺三口儿梦断均魂劳","book":"元·张国宾《罗李郎》第二折"},"example":{"text":"经几番凶荒战斗，怎免得～。","book":"清·孔尚任《桃花扇·哭主》"},"similar":["萍踪浪迹","漂泊不定"],"usage":"作谓语、定语；比喻流离漂泊"},{"id":26873,"word":"梗迹萍踪","pinyin":"gěng jì píng zōng","abbr":"gjpz","explanation":"像断梗、浮萍在水中一样踪迹不定。","source":{"text":"休夸绣虎雕龙，那值时危国破，怎发付梗迹萍踪。","book":"明·单本《蕉帕记·寻春》"},"similar":["梗迹蓬飘"],"usage":"作谓语、宾语、定语；用于生活"},{"id":26874,"word":"梗迹蓬飘","pinyin":"gěng jì péng piāo","abbr":"gjpp","explanation":"比喻漂泊流离。梗，断梗；蓬，飞蓬。","source":{"text":"梗迹蓬飘，跋踄山川岂惮劳。","book":"明·范受益《寻亲记·相逢》"},"similar":["梗迹萍踪"],"usage":"作谓语、宾语、定语；用于生活"},{"id":26875,"word":"梗顽不化","pinyin":"gěng wán bù huà","abbr":"gwbh","explanation":"指十分顽固，无法感化。","source":{"text":"目下山东有名绿茶，可知道他们形状否；内中可有能劝化改行的，还有梗顽不化，本事十分利害的否？要一一请教。","book":"《续儿女英雄传》第一回"},"example":{"text":"孟遂奔还县城，投函咨议局，声称烟民～。","book":"中国近代史资料丛刊《辛亥革命·人民反清斗争资料·山西交城文水两县乡民暴动》"},"usage":"作谓语、定语；指为人"},{"id":26876,"word":"梦中相寻","pinyin":"mèng zhōng xiāng xún","abbr":"mzxx","explanation":"在睡梦中也去寻找。形容对亲友的殷切思念。","source":{"text":"梦中相寻，六国张敏与高惠为友，第相思不能得，便于梦中往寻。但行至半路，即迷不知路。","book":"宋·胡继宗《书言故事·朋友类》"}},{"id":26877,"word":"梦中说梦","pinyin":"mèng zhōng shuō mèng","abbr":"mzsm","explanation":"原为佛家语，比喻虚幻无凭。后也比喻胡言乱语。","source":{"text":"复次善勇猛，如人梦中说梦所见种种自性。如是所说梦境自性都无所有。何以故？善勇猛，梦尚非有，况有梦境自性可说。","book":"《大般若波罗蜜多经》卷五九六"},"example":{"text":"耳食之徒，如矮人观场，随声赞叹，更～。","book":"清·阮葵生《茶余客话》卷十一"},"similar":["胡言乱语"],"usage":"作谓语、宾语；指胡言乱语"},{"id":26878,"word":"梦兆熊罴","pinyin":"mèng zhào xióng pí","abbr":"mzxp","explanation":"生男孩之象。","source":{"text":"吉梦维何？维熊维罴。……大人占之，维熊维罴，男子之祥。","book":"《诗经·小雅·斯干》"}},{"id":26879,"word":"梦劳魂想","pinyin":"mèng láo hún xiǎng","abbr":"mlhx","explanation":"睡梦中也难以忘怀。形容思念深切。","source":{"text":"我媳妇孤身在哪方？痛杀我梦劳魂想。","book":"明·高濂《玉簪记·依亲》"},"similar":["梦断魂消","梦断魂劳"],"usage":"作宾语、定语；用于处事"},{"id":26880,"word":"梦喜三刀","pinyin":"mèng xǐ sān dāo","abbr":"mxsd","explanation":"指官吏升迁。","source":{"text":"濬夜梦悬三刀于卧梁上，须臾又益一刀，濬惊觉，意甚恶之。主簿李毅再拜贺曰：‘三刀为州字，又益一者，明府其临益州乎？’及贼张私杀益州刺史皇甫晏，果迁濬为益州刺史。","book":"《晋书·王濬传》"},"example":{"text":"～近，书嫌五载违。","book":"唐·柳宗元《奉和周二十二丈，酬郴州侍郎衡江夜泊得韶州》"}},{"id":26881,"word":"梦寐不忘","pinyin":"mèng mèi bù wàng","abbr":"mmbw","explanation":"梦寐：在睡梦中。在梦中也念念不忘。","source":{"text":"吾知我必有复与诸君握手戮力以成就我辈所梦寐不忘一大事之日，吾以是自信，吾以是自慰。","book":"清·梁启超《意大利建国三杰传》第十七节"},"example":{"text":"一个在这条船上，瞥见对面船舱的灯光里正是自己～的脸，没来得及叫唤，彼此早距离远了。","book":"钱钟书《围城》第五章"},"similar":["念念不忘"],"usage":"作谓语、定语；指永远记住"},{"id":26882,"word":"梦寐以求","pinyin":"mèng mèi yǐ qiú","abbr":"mmyq","explanation":"寐：睡着。做梦的时候都在追求。形容迫切地期望着。","source":{"text":"窈窕淑女，寤寐求之。","book":"《诗经·周南·关雎》"},"example":{"text":"这一切，也正是鲁迅所～并终生为之奋斗的！","book":"茅盾《联系实际，学习鲁迅》"},"similar":["朝思暮想"],"usage":"作谓语、定语；形容有着强烈的愿望"},{"id":26883,"word":"梦寐颠倒","pinyin":"mèng mèi diān dǎo","abbr":"mmdd","explanation":"梦寐：睡梦；颠倒：错乱。指人由于思念情切，心神恍惚，失去常态。","source":{"text":"公主女夜梦一人，被发流血，谓曰：‘温州将乱，宜速去之。不然，必将受祸。’及觉，说其事，公主云：‘梦想颠倒，复何足信。’","book":"唐·戴孚《广异记》"},"example":{"text":"所虑～，意况不佳，此当于吾心地上观之。","book":"宋·黄榦《答郑子羽书》"}},{"id":26884,"word":"梦寐魂求","pinyin":"mèng mèi hún qiú","abbr":"mmhq","explanation":"梦寐：睡梦。做梦的时候都在追求。形容迫切地期望着。","source":{"text":"思我亲戚之颜貌，寄梦寐而魂求。","book":"《诗经·周南·关雎》：“窈窕淑女，寤寐求之。”南朝·梁·沈炯《归魂赋》"}},{"id":26885,"word":"梦尸得官","pinyin":"mèng shī dé guān","abbr":"msdg","explanation":"旧时迷信说法，梦见死尸是得官的预兆。","source":{"text":"人有问殷中军：‘何以将得位而梦棺器，将得财而梦失秽？’殷曰：‘官本是臭腐，所以将得而梦棺尸；财本是粪土，所以将得而梦秽污。’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"居官死职战死绥，～真古语。","book":"宋·苏轼《秦少游梦发殡而葬之者云是刘发之柩是岁发首荐秦以诗贺之刘泾亦作因次其韵》"}},{"id":26886,"word":"梦幻泡影","pinyin":"mèng huàn pào yǐng","abbr":"mhpy","explanation":"佛教用语。认为世界上的事物都象梦境、幻术、水泡和影子一样空虚。后比喻空虚而容易破灭的幻想。","source":{"text":"一切有为法，如梦幻泡影，如露亦如电，应作如是观。","book":"《金刚般若波罗蜜经·应化非真分》"},"example":{"text":"但听得那长老将“～”四个字，已讲得天花乱坠，大众无不齐声念佛。","book":"清·钱彩《说岳全传》第六十一回"},"similar":["虚无飘渺"],"usage":"作宾语；比喻空虚而容易破灭的幻想"},{"id":26887,"word":"梦往神游","pinyin":"mèng wǎng shén yóu","abbr":"mwsy","explanation":"在做梦中前往交游。形容迫切的思念。","source":{"text":"言者，心之声也，欲代此一人立言，先宜代此一人立心，若非梦往神游，何谓设身处地？","book":"清·李渔《闲情偶寄·词曲部》之宾白第四"},"example":{"text":"以这个角色自居，～，设身处地，再考其关目，试其声音，然后把最准确，最传神的台辞“直书”下来。","book":"夏衍《也谈戏剧语言》"},"usage":"作谓语、定语；用于处事"},{"id":26888,"word":"梦想不到","pinyin":"mèng xiǎng bù dào","abbr":"mxbd","explanation":"做梦也想不到。","source":{"text":"现在母亲忽然端整了被褥一切，叫他住在校里，实在是梦想不到的。","book":"叶圣陶《义儿》"},"example":{"text":"这事让我～。"},"similar":["意想不到"],"usage":"作谓语、定语；指想不到"},{"id":26889,"word":"梦想为劳","pinyin":"mèng xiǎng wéi láo","abbr":"mxwl","explanation":"睡梦中也在想，致使疲劳。形容思念之深切，到了过分的程度。","source":{"text":"玉山青鸟，仙使难通。彩笔试操，香笺遂满；行云可托，梦想还劳。","book":"南朝·陈·伏知道《为王宽与妇义安主书》"},"example":{"text":"小生自见姐姐，～，谁料得有今日。","book":"明·孟称舜《花前一笑》第四折"}},{"id":26890,"word":"梦想神交","pinyin":"mèng xiǎng shén jiāo","abbr":"mxsj","explanation":"交：交遇。做梦也在思念，心神与之交融在一起。形容迫切的思念。","source":{"text":"恨得别人不中用，都积在狄希陈一人身上，梦想神交，只要算计报仇雪耻。","book":"清·西周生《醒世姻缘传》第九十四回"},"usage":"作谓语、宾语；用于处事"},{"id":26891,"word":"梦想颠倒","pinyin":"mèng xiǎng diān dǎo","abbr":"mxdd","explanation":"比喻心神恍惚，失去常态。","source":{"text":"卷做一团，塞在猪八戒耳朵里，口里乱嚷道：‘悟能，休得梦想颠倒。’","book":"《西游补》第一回"},"similar":["梦魂颠倒"],"usage":"作宾语；指失去常态"},{"id":26892,"word":"梦撒寮丁","pinyin":"mèng sā liáo dīng","abbr":"msld","explanation":"梦撒：丧失。寮丁：指钱。比喻没钱应酬。亦作“梦撒撩丁”。","source":{"text":"钟嗣成《全元散曲·哭皇天》：“近来论世态，世态有高低。有钱的高贵，无钱的低微。那里问风流子弟？折末颜如灌口，貌赛神仙，洞宾出世，宋玉重生，没答了镘的，梦撒寮丁。” 注释：没答：无（钱）以应酬。镘的：指钱。"}},{"id":26893,"word":"梦撒撩丁","pinyin":"mèng sā liáo dīng","abbr":"msld","explanation":"比喻没钱应酬。同“梦撒寮丁”。","source":{"text":"若是自家空藏瓶，梦撒撩丁，花姑不重女猱轻，任谁，见哽。","book":"《元人散曲·庆宣和》"}},{"id":26894,"word":"梦断魂劳","pinyin":"mèng duàn hún láo","abbr":"mdhl","explanation":"睡梦中也想着，弄得心神不宁。","source":{"text":"又不敢对着人明明道，只落的梦断魂劳。","book":"元·王元和《小桃红·题情》曲"},"example":{"text":"你这几日为李大姐一丝两气，茶饭少进，行思坐想，～，岂不是痴心汉子。","book":"明·无名氏《南牢记》第一折"},"similar":["梦断魂消","梦劳魂想"],"usage":"作宾语、定语；用于处事"},{"id":26895,"word":"梦断魂消","pinyin":"mèng duàn hún xiāo","abbr":"mdhx","explanation":"睡梦中也在思想着，弄得神魂不宁。同“梦断魂劳”。","source":{"text":"满目新红惊树杪，莺啼处梦断魂消。","book":"明·高濂《玉簪记》第二十七出"},"example":{"text":"［外］他如今似梦断方醒，［旦］只怕你要夜迢迢～。","book":"清·方成培《雷峰塔·水斗》"},"similar":["梦断魂劳","梦劳魂想"],"usage":"作宾语、定语；用于处事"},{"id":26896,"word":"梦梦查查","pinyin":"mèng mèng chá chá","abbr":"mmzz","explanation":"迷迷糊糊的样子。","example":{"text":"瞧你这个～的样子，让人倒胃口。"},"similar":["迷迷糊糊"],"usage":"作定语、状语；用于口语"},{"id":26897,"word":"梦梦铳铳","pinyin":"mèng mèng chòng chòng","abbr":"mmcc","explanation":"形容睡得迷迷糊糊。","example":{"text":"在我睡得～的时候，你就来了。"},"usage":"作定语、状语；用于口语"},{"id":26898,"word":"梦熊之喜","pinyin":"mèng xióng zhī xǐ","abbr":"mxzx","explanation":"梦熊：指生男孩。祝贺人生男孩的话。","source":{"text":"吉梦维何？维熊维罴。……大人占之，维熊维罴，男子之祥。","book":"《诗经·小雅·斯干》"},"example":{"text":"家妇身 体亦好，已有～，婢仆皆如故。","book":"清·曾国藩《曾国藩家书·修身篇》"}},{"id":26899,"word":"梦熟黄粱","pinyin":"mèng shú huáng liáng","abbr":"mshl","explanation":"黄粱：粟米。比喻美好的愿望如同梦幻一样。","source":{"text":"只见他一似宰予昼寝，孟轲隐几，梦熟黄粱，庄周梦蝶正颠狂，周公事业成何望！","book":"明·无名氏《鸣凤记·林公避兵》"},"similar":["一枕黄粱","黄粱梦"],"usage":"作宾语、定语；用于比喻句","story":["从前有一个穷困潦倒的书生卢生，在邯郸一个客店遇见道士吕翁。吕翁送他一个枕头，这时店主正开始做黄粱饭，卢生小睡一会，在梦中他中进士做宰相娶美妻，儿孙满堂，生活美满。梦醒后，主人的黄粱饭都还没做熟"]},{"id":26900,"word":"梦笔生花","pinyin":"mèng bǐ shēng huā","abbr":"mbsh","explanation":"比喻写作能力大有进步。也形容文章写得很出色。","source":{"text":"李太白少时，梦所用之笔头上生花，后天才赡逸，名闻天下。","book":"五代·王仁裕《开元天宝遗事·梦笔头生花》"},"example":{"text":"李太白～，特睡乡幻景耳！","book":"清·纪昀《阅微草堂笔记》卷五"},"similar":["生花妙笔"],"usage":"作谓语、补语；指文思丰富","story":["唐代大诗人李白少年时曾经做过一个奇特的梦，他梦见自己使用的笔尖头开出了鲜艳的花朵，一张张白纸自动飞到他眼前，他高兴极了，就抓起妙笔飞快地写了起来，落在纸上的却是一朵朵盛开的鲜花，他的许多著名的诗篇流传至今"]},{"id":26901,"word":"梦见周公","pinyin":"mèng jiàn zhōu gōng","abbr":"mjzg","explanation":"周公：西周初著名政治家，孔子心目中的理想人物。原为孔子哀叹自己体衰年老的辞句。后多作为瞌睡的代称。","source":{"text":"甚矣吾衰也，久矣吾不复梦见周公。","book":"春秋·鲁·孔丘《论语·述而》"},"example":{"text":"在门底铺了一条夏布裙子，头垫了门枕，在那里‘～’。","book":"清·西周生《醒世姻缘传》第23回"},"usage":"作谓语、宾语、定语；指打瞌睡"},{"id":26902,"word":"梦里南柯","pinyin":"mèng lǐ nán kē","abbr":"mlnk","explanation":"南柯：指槐树的南枝。比喻一场美梦。","source":{"text":"他实在咽不下玉液金波，谁承望月底西厢，变做了梦里南柯。","book":"元·王实甫《西厢记·夫人停婚》"},"similar":["南柯一梦"],"usage":"作宾语、定语；指美梦"},{"id":26903,"word":"梦里南轲","pinyin":"mèng lǐ nán kē","abbr":"mlnk","explanation":"形容一场大梦，或比喻一场空欢喜。","source":{"text":"为公唤觉荆州梦，可待南轲一梦成。","book":"唐·李公佐《南柯太守传》　宋·黄庭坚《戏答荆州王充道烹茶诗四首》之三"},"example":{"text":"他其实咽不下玉液金波，认承望月底西厢，变做了～。","book":"元·王实甫《西厢记·夫人停婚》"}},{"id":26904,"word":"梦里蝴蝶","pinyin":"mèng lǐ hú dié","abbr":"mlhd","explanation":"比喻虚幻之事。","source":{"text":"昔者庄周梦为蝴蝶，栩栩然蝴蝶也。自喻适志与，不知周也，俄然觉，由蘧蘧然周也。","book":"《庄子·齐物论》"},"example":{"text":"坐谈间早辨龙蛇，把袖里乾坤都做～，狠的人海沸山裂。","book":"明·张凤翼《红佛记·虬髯退步》"},"similar":["庄生梦蝶"],"usage":"作宾语、定语；用于比喻句","story":["战国时期，著名的哲学家庄周常在《庄子》中讲寓言故事，借以说明自己的哲学观点。其中《庄生梦蝶》寓言就描绘他自己梦见变成一只蝴蝶，欣然自得，轻松舒畅地自由飞翔，完全忘记人世间的烦恼。梦醒后一直栩栩如生浮现在眼前"]},{"id":26905,"word":"梦魂颠倒","pinyin":"mèng hún diān dǎo","abbr":"mhdd","explanation":"比喻心神恍惚，失去常态。","source":{"text":"只因财利迷心，身家念重，时时防贼发火起，自然梦魂颠倒。","book":"明·凌濛初《二刻拍案惊奇》第19卷"},"example":{"text":"合上眼还只～，满口胡话，惊怖异常。","book":"清·曹雪芹《红楼梦》第12回"},"similar":["梦想颠倒","失魂落魄"],"usage":"作谓语；指失去常态"},{"id":26906,"word":"梧丘之魂","pinyin":"wú qiū zhī hún","abbr":"wqzh","explanation":"用来比喻无辜的冤魂。","source":{"text":"仰惟大王少垂明白，则梧丘之魂，不愧于沉首；鹄亭之鬼，无恨于灰骨。","book":"南朝·梁·江淹《诣建平王上书》"}},{"id":26907,"word":"梧凤之鸣","pinyin":"wú fèng zhī míng","abbr":"wfzm","explanation":"比喻政教和协、天下太平。","source":{"text":"梧桐盛也，凤凰鸣也，臣竭其力，则地极其化；天下和洽，则凤凰乐德。","book":"《诗·大雅·卷阿》：“凤皇鸣矣，于彼高冈。梧桐生矣，于彼朝阳。”毛传"},"example":{"text":"古人听到～就认为是好兆头"},"usage":"作宾语；用于书面语"},{"id":26908,"word":"梧桐一叶落","pinyin":"wú tóng yī yè luò","abbr":"wtyyl","explanation":"梧桐落叶最早，故以之表示秋天来临。后亦以比喻事物衰落的征兆。"},{"id":26909,"word":"梧桐半死","pinyin":"wú tóng bàn sǐ","abbr":"wtbs","explanation":"比喻丧失配偶。","source":{"text":"半死梧桐老病身。","book":"唐·白居易《为薛台悼亡》"},"example":{"text":"～清霜后，头白鸳鸯失伴飞。","book":"宋·贺铸《鹧鸪天》词"}},{"id":26910,"word":"梧桐断角","pinyin":"wú tóng duàn jiǎo","abbr":"wtdj","explanation":"指梧桐虽是柔木而可以断坚硬之角。比喻柔能胜刚。","source":{"text":"两坚不能相和，两强不能引服。故梧桐断角， 马怤截玉，媒但者，非学谩也，但成而生不信；立慬者，非学斗争也，慬立而生不让。","book":"《淮南子·说山训》"}},{"id":26911,"word":"梧鼠之技","pinyin":"wú shǔ zhī jì","abbr":"wszj","explanation":"比喻技能多而不精，于事无益。同“梧鼠五技”。","source":{"text":"腾蛇无足而飞，梧鼠五技而穷。","book":"《荀子·劝学》"},"example":{"text":"而～，不过于五，亦有时而穷矣。","book":"清·章炳麟《驳康有为论革命书》"},"similar":["梧鼠五技"],"usage":"作宾语；指才能有限"},{"id":26912,"word":"梧鼠五技","pinyin":"wú shǔ wǔ jì","abbr":"wswj","explanation":"梧鼠：即“鼯鼠”，为鼣鼠之误；五技：据说鼫鼠有五种技能。比喻技能多而不精，于事无益。","source":{"text":"腾蛇无足而飞，梧鼠五技而穷。","book":"《荀子·劝学》"},"similar":["梧鼠技穷"],"usage":"作宾语；指才能有限"},{"id":26913,"word":"梧鼠学技","pinyin":"wú shǔ xué jì","abbr":"wsxj","explanation":"形容在学习中贪多而学得不精。","source":{"text":"腾蛇无足而飞，梧鼠五技而穷。","book":"《荀子·劝学》"}},{"id":26914,"word":"梧鼠技穷","pinyin":"wú shǔ jì qióng","abbr":"wsjq","explanation":"梧鼠：即“鼯鼠”，为鼣鼠之误。比喻才能有限。","source":{"text":"腾蛇无足而飞，梧鼠五技而穷。","book":"《荀子·劝学》"},"similar":["梧鼠五技"],"usage":"作宾语、定语；指才能有限"},{"id":26915,"word":"梨园子弟","pinyin":"lí yuán zǐ dì","abbr":"lyzd","explanation":"原指唐玄宗时梨园宫廷歌舞艺人的统称。后泛指戏曲演员。","source":{"text":"通省梨园子弟各班愿与者，书名画知，届时齐集湖亭，各演杂剧。","book":"清·吴敬梓《儒林外史》第三十回"},"example":{"text":"惟兹～，犹存汉官威仪。","book":"陈去病《论戏剧之有益》"},"similar":["梨园弟子"],"usage":"作主语、宾语、定语；指歌舞艺人","story":["唐玄宗十分喜欢音乐，大臣给他讲春秋时期宋王修筑练武场墙壁时请歌唱家癸与射稽伴唱，提高劳动效率的故事。唐玄宗想让音乐发挥更大的作用，就建立音乐学校梨园，经常演奏《霓裳羽衣曲》。唐玄宗还经常亲自去梨园看望这些梨园子弟"]},{"id":26916,"word":"梨园弟子","pinyin":"lí yuán dì zǐ","abbr":"lydz","explanation":"原指唐玄宗培训的歌伶舞伎。后泛指戏剧演员。","source":{"text":"梨园弟子白发新，椒房阿监青蛾老。","book":"唐·白居易《长恨歌》"},"example":{"text":"通省梨园子弟各班愿与者，书名画知，届时齐集湖亭，各演杂剧。","book":"清·吴敬梓《儒林外史》第三十回"},"similar":["梨园子弟"],"usage":"作主语、宾语；指戏剧演员","story":["唐玄宗十分喜欢音乐，大臣给他讲春秋时期宋王修筑练武场墙壁时请歌唱家癸与射稽伴唱，提高劳动效率的故事。唐玄宗想让音乐发挥更大的作用，就建立音乐学校梨园，经常演奏《霓裳羽衣曲》。唐玄宗还经常亲自去梨园看望这些梨园子弟"]},{"id":26917,"word":"梨眉艾发","pinyin":"lí méi ài fā","abbr":"lmaf","explanation":"眉发俱白。形容年高。","source":{"text":"其子后来镜下芙蓉人及第，祖母尚梨眉艾发寿而康。","book":"清·檗子《聊斋志异侠女篇弹词》"},"usage":"作宾语、定语；用于老年人"},{"id":26918,"word":"梨花带雨","pinyin":"lí hu ài yǔ","abbr":"lhdy","explanation":"象沾着雨点的梨花一样。原形容杨贵妃哭泣时的姿态。后用以形容女子的娇美。","source":{"text":"玉容寂寞泪阑干，梨花一枝春带雨。","book":"唐·白居易《长恨歌》"},"example":{"text":"纣王定睛观看，见妲己乌云叠鬓，杏脸桃腮，浅淡春山，娇柔柳腰，真似海棠醉日，～。","book":"明·许仲琳《封神演义》第四回"},"usage":"作谓语、宾语；用于女性"},{"id":26919,"word":"梭天摸地","pinyin":"suō tiān mō dì","abbr":"stmd","explanation":"指上窜下跳。比喻到处逃窜。","source":{"text":"素姐忘记了是猴，只道当真成了自己的老公，朝鞭暮扑，打得个猴精梭天摸地的着极。","book":"《醒世姻缘传》第七六回"},"similar":["上窜下跳"],"usage":"作谓语、定语、状语；指到处逃窜"},{"id":26920,"word":"梯山架壑","pinyin":"tī shān jià hè","abbr":"tsjh","explanation":"形容登山涉险历经艰辛。","source":{"text":"莫不梯山架壑，镪负来归。","book":"晋·陆机《晋平西将军孝侯周处碑》"},"similar":["翻山越岭"],"usage":"作谓语、定语；用于书面语"},{"id":26921,"word":"梯山栈谷","pinyin":"tī shān zhàn gǔ","abbr":"tszg","explanation":"指凿梯、修栈道以度高山深谷。泛指跋涉险阻。","source":{"text":"梯山栈谷绳行沙度之道，身热首痛风灾鬼难之域，莫不备写情形，审求根实。","book":"南朝·宋·范晔《后汉书·西域传论》"},"example":{"text":"宋·叶适《陈叔向墓志铭》：“乾道、淳熙中，问学日盛，士～，自力于善。”"},"similar":["梯山架壑"],"usage":"作谓语、宾语；用于书面语"},{"id":26922,"word":"梯山航海","pinyin":"tī shān háng hǎi","abbr":"tshh","explanation":"登山航海。比喻长途跋涉，经历险远的旅程。","source":{"text":"日月所照，梯山航海；风雨所均，削衽袭带。","book":"《宋书·明帝纪》"},"example":{"text":"几缩千程于咫尺，玩地球若股掌，～。","book":"清·谭嗣同《仁学》"},"similar":["登山渡海"],"usage":"作谓语；比喻长途跋涉"},{"id":26923,"word":"梯愚入圣","pinyin":"tī yú rù shèng","abbr":"tyrs","explanation":"指启迪引导凡夫俗子成为圣人。","source":{"text":"佛则不然，具缚为种，转暗成明，梯愚入圣。","book":"《南齐书·高逸传论》"},"usage":"作谓语、定语；用于书面语"},{"id":26924,"word":"梯荣阶禄","pinyin":"tī róng jiē lù","abbr":"trjl","explanation":"梯、阶：比喻达到某种目的的手段。爬样子取得荣耀，登台阶取得俸禄。","source":{"text":"而科、岁之试，乡、会之场，竟视为梯荣阶禄之地。","book":"清·李绿园《歧路灯》第九十三回"},"usage":"作定语；用于处事"},{"id":26925,"word":"梳云掠月","pinyin":"shū yún lüě yuè","abbr":"syly","explanation":"指妇女梳妆。“云”指发髻之形，“月”喻妇女容貌。","source":{"text":"枉蠢了他梳云掠月，枉羞了他惜玉怜香。","book":"元·王实甫《西厢记》第五本第三折"},"example":{"text":"懒设设～，意迟迟傅粉施朱。","book":"元·无名氏《举案齐眉》第一折"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":26926,"word":"梳妆打扮","pinyin":"shū zhuāng dǎ bàn","abbr":"szdb","explanation":"对容颜衣着进行修饰。","source":{"text":"张龙，将那李四的浑家，梳妆打扮的赏与张珪便了。","book":"元·关汉卿《鲁斋郎》第三折"},"example":{"text":"开慧平时生活朴素，从不讲究～。","book":"李淑一《忽报人间曾伏虎》"},"similar":["梳洗打扮"],"usage":"作谓语、宾语；多用于女性"},{"id":26927,"word":"梳文栉字","pinyin":"shū wén zhì zì","abbr":"swzz","explanation":"指训释文字。","source":{"text":"嘉道之际，学者承乾隆季年之流风，袭为一种破碎之学，辨物析名，梳文栉字，刺经典一二字，解说或至数千万言，繁称杂引，游衍而不得所归。","book":"清·曾国藩《朱慎甫遗书序》"},"usage":"作宾语、定语；用于书面语"},{"id":26928,"word":"梵册贝叶","pinyin":"fàn cè bèi yè","abbr":"fcby","explanation":"指佛经，佛经原本多用梵文写在贝多罗树叶上。","source":{"text":"梵册贝叶，以意增损，以意排比，以意合之分之，译者从而受之。","book":"清·龚自珍《正魏译》"},"usage":"作宾语；指佛经"},{"id":26929,"word":"梵呗圆音","pinyin":"fàn bài yuán yīn","abbr":"fbyy","explanation":"梵：清净，常用来表示与佛教有关的事物；呗：佛教中的赞歌。诵佛教经典，唱佛教赞歌，讲解佛教教义之音。表示举行法会。","source":{"text":"梵呗圆音，竟将为轻歌曼舞所‘加被’，岂不出乎意表也哉。","book":"鲁迅《社会和歌剧》"},"usage":"作宾语；指举行法会"},{"id":26930,"word":"梼杌饕餮","pinyin":"táo wù tāo tiè","abbr":"twtt","explanation":"梼杌、饕餮：古代传说中凶猛的野兽。比喻凶恶的人。","source":{"text":"远方之民，虽使盗跖为之郡守，梼杌饕餮为之县令，郡县之民，群嘲而聚骂者，虽百千为辈，朝廷不知也。","book":"明·邱濬《大学衍义补·固帮本·择民之长》"}},{"id":26931,"word":"棋布星罗","pinyin":"qí bù xīng luó","abbr":"qbxl","explanation":"像棋子般分布，像星星般罗列。形容多而密集。","source":{"text":"但内府二十四监棋布星罗，所设工匠厨役隶人圉人，以及诸珰僮奴家属，不下数十万人。","book":"明·沈德符《野获编·内市日期》"},"example":{"text":"远水近山，高坡大衢，洋房密如栉比，～，风景歧异。","book":"郑观应《盛世危言·交涉》"},"similar":["星罗棋布"],"usage":"作谓语、定语、状语；形容数量多分布广"},{"id":26932,"word":"棋布星陈","pinyin":"qí bù xīng chén","abbr":"qbxc","explanation":"形容多而密集。同“棋布星罗”。","source":{"text":"虽蜀道渐开，楚江咸顺，而貔貅之众，棋布星陈，资饷甚殷，所在告急。","book":"清·慕天颜《请开海疏禁》"},"similar":["棋布星罗","星罗棋布"],"usage":"作谓语、定语、状语；形容数量多分布广"},{"id":26933,"word":"棋布错峙","pinyin":"qí bù cuò zhì","abbr":"qbcz","explanation":"指如对弈双方所着棋子般交错对峙。","source":{"text":"陛下因而分裂之，即用其酋豪，命以爵秩，棋布错峙，务使相仇。","book":"宋·苏轼《代滕甫论西夏书》"},"usage":"作定语、分句；用于下棋等"},{"id":26934,"word":"棋输先着","pinyin":"qí shū xiān zhāo","abbr":"qsxz","explanation":"谓因被对方占了先手而输了棋。比喻功力稍逊于对方。"},{"id":26935,"word":"棋输先著","pinyin":"qí shū xiān zhuó","abbr":"qsxz","explanation":"指因被对方占了先手而输了棋。比喻功力稍逊于对方。"},{"id":26936,"word":"棋逢对手","pinyin":"qí féng duì shǒu","abbr":"qfds","explanation":"比喻争斗的双方本领不相上下。","source":{"text":"有时逢敌手，对局到深更。","book":"《晋书·谢安传》：“安常棋劣于玄，是日玄惧，便为敌手而又不胜。”唐·杜荀鹤《观棋》诗"},"example":{"text":"他两个在半空中，这场好杀：～，将遇良才。","book":"明·吴承恩《西游记》第三十四回"},"similar":["势均力敌","不相上下"],"opposite":["略胜一筹","棋高一着","众寡悬殊"],"usage":"作谓语、宾语、分句；指能手碰到能手"},{"id":26937,"word":"棋逢对手，将遇良才","pinyin":"qí féng duì shǒu，jiàng yù liáng cái","abbr":"qfdsjylc","explanation":"逢：遭遇，遇见。比喻交战或竞技的双方本领相当，不相上下。","source":{"text":"他两个在半空中，这场好杀。棋逢对手，将遇良才。","book":"明·吴承恩《西游记》第34回"},"similar":["棋逢敌手，将遇良才"],"usage":"作宾语、定语；用于两者比较"},{"id":26938,"word":"棋逢敌手","pinyin":"qí féng dí shǒu","abbr":"qfds","explanation":"比喻彼此本领不相上下。","source":{"text":"事免伤心否，棋逢敌手无。","book":"唐·尚颜《怀陆龟蒙处士》诗"},"example":{"text":"～难相胜，将遇良才不敢骄。","book":"明·罗贯中《三国演义》第100回"},"similar":["棋逢对手"],"usage":"作谓语、宾语；指碰到真正的对手"},{"id":26939,"word":"棋逢敌手，将遇良才","pinyin":"qí féng dí shǒu，jiàng yù liáng cái","abbr":"qfdsjylc","explanation":"逢：遭遇，遇见。比喻交战或竞技的双方本领相当，不相上下。","source":{"text":"正是棋逢敌手，将遇良才，两人大战三十余合。","book":"《说唐》第63回"},"similar":["棋逢对手，将遇良才"],"usage":"作宾语、定语；用于两者比较"},{"id":26940,"word":"棋高一着","pinyin":"qí gāo yī zhāo","abbr":"qgyz","explanation":"一着：下棋时下一子或走一步。棋艺高人一步。也比喻技高一等。","source":{"text":"你的见识是比我高，人家说我怕你，棋高一着，束手缚脚，真叫我怎么不怕呢？","book":"陆士谔《续孽海花》第55回"},"example":{"text":"老杨终究～，抢在众人之前将礼物巧妙地送去了。"},"similar":["技高一筹"],"usage":"作谓语、定语；指超出别人"},{"id":26941,"word":"棋高一着，束手缚脚","pinyin":"qí gāo yī zhāo，shù shǒu fù jiǎo","abbr":"qgyzssfj","explanation":"一着：下棋时走一步。跟棋艺比自己高的人下棋，自己显得笨拙。比喻技术高人一头，对方就无法施展本领。","source":{"text":"你的见识是比我高，人家说我怕你，棋高一着，束手缚脚，真叫我怎么不怕呢？","book":"陆士谔《续孽海花》第55回"},"similar":["棋高一着，缚手缚脚"],"usage":"作分句、定语；指遇到高手就不好发挥"},{"id":26942,"word":"棋高一着，缚手缚脚","pinyin":"qí gāo yī zhāo，fù shǒu fù jiǎo","abbr":"qgyzfsfj","explanation":"本指棋艺，后比喻技术高人一头，对方就无法施展本领。","source":{"text":"正所谓‘棋高一着，缚手缚脚’，况兼是心意不安的，把平日的力量一发减了，连败了两局。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"example":{"text":"他的五禽剑法，本是以攻势擅长，往时只因功力不如楚昭南，所谓“～。”","book":"梁羽生《七剑下天山》第十五回"},"similar":["棋高一着，束手缚脚"],"usage":"作分句、定语；指遇到高手就不好发挥"},{"id":26943,"word":"棒打不回头","pinyin":"bàng dǎ bù huí tóu","abbr":"bdbht","explanation":"比喻认定主意，在强大压力面前也不动摇。","source":{"text":"龙潭升座，谓众曰：‘可中有个汉，牙如剑树，口似血盆，一棒打不回头。’","book":"宋·释普济《五灯会元》卷十七"},"example":{"text":"夺得我机方肯往，从教～。","book":"宋·释惠洪《石门文字禅》卷十"}},{"id":26944,"word":"棒打鸳鸯","pinyin":"bàng dǎ yuān yāng","abbr":"bdyy","explanation":"用木棒打散一双鸳鸯。比喻拆散恩爱的夫妻或情侣。","source":{"text":"他一双儿女两情坚，休得棒打鸳鸯作话传。","book":"明·孟称舜《鹦鹉墓贞文记》"},"example":{"text":"啼痕界破残妆面，德言分镜几时圆？远水高山，眼睁睁～散。","book":"明·李开先《宝剑记》第十九出"},"opposite":["成人之美"],"usage":"作定语、宾语；指拆散别人夫妻"},{"id":26945,"word":"棘刺母猴","pinyin":"jí cì mǔ hóu","abbr":"jcmh","explanation":"棘：多刺的植物。在棘刺尖端雕刻的猕猴。形容欺骗的勾当或艰难的事业。","source":{"text":"宋人有请为燕王以棘刺之端为母猴者，必三月斋然后能观之。","book":"战国·韩·韩非《韩非子·外储说右上》"},"usage":"作宾语、定语；指骗人的勾当","story":["战国时期，燕国国君喜欢小玩艺，有一个宋国人说可以在棘刺上雕刻一只母猴，但必须要燕王斋戒三个月才能看到。燕王用三乘土地上的赋税给他作酬谢请他雕刻。右御手下的冶铁工匠认为这是一个骗局，因为根本不可能打制出这种雕刻刀"]},{"id":26946,"word":"棘地荆天","pinyin":"jí dì jīng tiān","abbr":"jdjt","explanation":"到处都是荆棘。形容变乱后的残破景象或困难重重的处境。","source":{"text":"千年辽鹤，望人民城郭以怆神；何处铜驼，向棘地荆天而长涕。","book":"梁启超《中国积弱溯源论》"},"example":{"text":"要从～里，还我金刚不坏身。","book":"周实《感事》诗之一"},"similar":["荆天棘地"],"usage":"作宾语、定语；指困难重重的处境"},{"id":26947,"word":"棘没铜驼","pinyin":"jí mò tóng tuó","abbr":"jmtt","explanation":"没：埋没，掩盖。荆棘掩盖没了洛阳宫外的铜驼。形容亡国后的残破景象。","source":{"text":"此生终遣英雄笑，棘没铜驼六十年。","book":"宋·陆游《囚山》诗"},"example":{"text":"～亡国恨，风吹铁马护身恩。","book":"姚平《寒梅阁三吟·寇白门》"},"similar":["故宫禾黍"],"usage":"作宾语、定语；用于比喻句"},{"id":26948,"word":"棚扒吊拷","pinyin":"péng bā diào kǎo","abbr":"pbdk","explanation":"扒：脱掉；吊：悬挂；拷：拷打。把人绳绑吊起，剥去衣服严刑拷打。","source":{"text":"棚扒吊拷，备受苦楚。","book":"明·凌濛初《二刻拍案惊奇》第五卷"},"similar":["吊拷棚扒"],"usage":"作宾语、定语；指古代刑罚"},{"id":26949,"word":"棣华增映","pinyin":"dì huá zēng yìng","abbr":"dhzy","explanation":"棣华：指兄弟；映：光辉。比喻兄弟友爱，互增光辉。","source":{"text":"载、协飞芳，棣华增映。","book":"《晋书·张载张协传》"}},{"id":26950,"word":"棨戟遥临","pinyin":"qǐ jǐ yáo lín","abbr":"qjyl","explanation":"棨戟：有缯衣的木戟，古代官吏出行作前导的一种仪仗。指达官贵人远道而来。后常用以称贵宾或好友远道光临。","source":{"text":"都督阎公之雅望，棨戟遥临。","book":"唐·王勃《滕王阁序》"},"example":{"text":"今幸～，快慰平生之愿。","book":"清·曹雪芹《红楼梦》第九十九回"},"usage":"作宾语、定语；用于客套话"},{"id":26951,"word":"森严壁垒","pinyin":"sēn yán bì lěi","abbr":"sybl","explanation":"森严：整齐，严肃；壁垒：古代军营四周的围墙。原指军事戒备严密。现也用来比喻彼此界限划得很分明。","source":{"text":"《兴州江运记》叙述议论，皆以典奥出之，可谓避垒森严，神采焕发。","book":"清·陈鸿墀《全唐文纪事·卷首》"},"example":{"text":"早已～，更加众志成城。","book":"毛泽东《西江月·井冈山》"},"similar":["戒备森严"],"usage":"作谓语、宾语；比喻防守严密"},{"id":26952,"word":"森罗万象","pinyin":"sēn luó wàn xiàng","abbr":"slwx","explanation":"森：众多；罗：罗列；万象：宇宙间各种事物和现象。指天地间纷纷罗列的各种各样的景象。形容包含的内容极为丰富。","source":{"text":"夫万象森罗，不离两仪所育；百法纷凑，无越三教之境。","book":"南朝梁·陶弘景《茅山长沙馆碑》"},"example":{"text":"乾坤大地，日月星辰，～。","book":"宋·释普济《五灯会元》卷十九"},"usage":"作谓语；指宇宙世界各种事物"},{"id":26953,"word":"棺材瓤子","pinyin":"guān cái ráng zǐ","abbr":"gcrz","explanation":"指快死的老年人。","source":{"text":"我问你，你是不是跟那个老棺材瓤子住在一起？","book":"王朔《橡皮人》"},"example":{"text":"别理他这～。"},"usage":"作宾语、定语；用于口语"},{"id":26954,"word":"植党自私","pinyin":"zhí dǎng zì sī","abbr":"zdzs","explanation":"谓拉帮结派以谋求私利。同“植党营私”。","source":{"text":"借多陵寡，植党自私，于是战斗以兴。","book":"鲁迅《坟·文化偏至论》"},"example":{"text":"要预防一个人～，就必须防微杜渐"},"similar":["植党营私"],"usage":"作谓语、宾语、定语；指结党营私"},{"id":26955,"word":"植党营私","pinyin":"zhí dǎng yíng sī","abbr":"zdys","explanation":"树立派别，谋取私利。","source":{"text":"时楚客（宗楚客）怀奸植党。","book":"《新唐书·萧至忠传》"},"example":{"text":"一边是认定孩提之童，一片天良，不肯去做罔人；一边是一味的向家庭～，去作那罔人勾当。","book":"清·文康《儿女英雄传》第三十四回"},"similar":["结党营私","拉帮结派","招降纳叛"],"opposite":["招贤纳士"],"usage":"作谓语、宾语、定语；指结党营私"},{"id":26956,"word":"植发冲冠","pinyin":"zhí fà chōng guàn","abbr":"zfcg","explanation":"头发直竖，顶起帽子。形容盛怒或踊跃之状。","source":{"text":"壮士之怒，赫然殊观，植发冲冠。","book":"三国·魏·嵇康《养生论》"},"similar":["植发穿冠"],"usage":"作谓语、定语；用于书面语"},{"id":26957,"word":"植发穿冠","pinyin":"zhí fà chuān guàn","abbr":"zfcg","explanation":"头发直竖，顶起帽子。形容盛怒或踊跃之状。犹植发冲冠。","source":{"text":"温公始入，姿形甚陋，合坐尽惊。既坐，陈说九服分崩，皇室弛绝，晋王君臣莫不歔欷。及言天下不可以无主，闻者莫不踊跃，植发穿冠。","book":"《世说新语·言语》“温峤初为刘琨使来过江”刘孝标注引晋·裴启《语林》"},"similar":["植发冲冠"],"usage":"作谓语、定语；用于书面语"},{"id":26958,"word":"植善倾恶","pinyin":"zhí shàn qīng è","abbr":"zsqe","explanation":"指培植善者，倾覆恶类。"},{"id":26959,"word":"椎埋屠狗","pinyin":"chuí mái tú gǒu","abbr":"cmtg","explanation":"杀人宰狗。指为非作歹和从事低贱的职业。","source":{"text":"谁谓百岁之后，椎埋屠狗之人见其亲戚乘势为帝王，而不欣然而从之邪！","book":"宋·苏洵《权书下·高祖》"},"example":{"text":"击筑悲歌、～之徒，其骨已朽，而燕赵之名，至今学士大夫饫闻而喜称之。","book":"清·刘大櫆《一掌园记》"},"similar":["椎埋狗窃"],"usage":"作谓语、定语；用于坏人"},{"id":26960,"word":"椎埋狗窃","pinyin":"chuí mái gǒu qiè","abbr":"cmgq","explanation":"指抢杀偷盗，不务正业。","source":{"text":"自绛灌至申屠嘉，皆向时棰埋狗窃之人。","book":"宋·赵彦卫《云麓漫钞》卷六"},"usage":"作谓语、定语；用于坏人"},{"id":26961,"word":"椎埋穿掘","pinyin":"chuí mái chuān jué","abbr":"cmcj","explanation":"杀人埋尸，发冢盗墓。泛指行凶作恶。","source":{"text":"椎埋，谓劫杀人而埋之；穿掘，谓发冢而取物。","book":"《文选·孙约〈齐故安陆昭王碑文〉》：“椎埋穿掘之党，阡陌成群。”张铣注"},"usage":"作谓语、定语；用于坏人"},{"id":26962,"word":"椎天抢地","pinyin":"chuí tiān qiǎng dì","abbr":"ctqd","explanation":"形容极度悲痛的样子。","source":{"text":"好教我负屈衔冤无申诉，只有个椎天抢地号咷哭。","book":"元·无名氏《冯玉兰》第二折"},"similar":["呼天抢地"],"usage":"作谓语、状语；用于悲伤等"},{"id":26963,"word":"椎心呕血","pinyin":"chuí xīn ǒu xuè","abbr":"cxox","explanation":"犹言椎心泣血。","source":{"text":"驱策代表等匍匐来京，作最后之请求，冀当途之觉悟，椎心呕血，谨为我大总统缕陈之。","book":"《“五四”爱国运动资料·上海罢市救亡史》"},"similar":["椎心泣血","椎心饮泣"],"usage":"作谓语、定语；形容悲恸到极点"},{"id":26964,"word":"椎心泣血","pinyin":"chuí xīn qì xuè","abbr":"cxqx","explanation":"椎心：捶胸脯；泣血：哭得眼中流血。捶拍胸膛，哭泣出血。形容非常悲痛。","source":{"text":"何图志未立而怨已成，计未从而骨肉受刑。此陵所以仰天椎心而泣血也。","book":"汉·李陵《答苏武书》"},"example":{"text":"百余年辛苦经营的圆明园，毁于一旦，更是令人～的莫大恨事。","book":"高阳《清宫外史》下册"},"similar":["捶胸顿足","痛心入骨"],"opposite":["眉开眼笑"],"usage":"作谓语、定语；形容悲恸到极点"},{"id":26965,"word":"椎心顿足","pinyin":"chuí xīn dùn zú","abbr":"cxdz","explanation":"形容人悲痛、悔恨等时的情状。同“椎胸顿足”。","source":{"text":"吾尝纵览本朝入主中夏以来二百余年之往事，若者为失机，若者为养痈，若者为种祸，若者为激变，每一循省未尝不椎心顿足，仰天而长恸也。","book":"梁启超《中国积弱溯源论》第四节"},"similar":["椎胸跌足"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":26966,"word":"椎心饮泣","pinyin":"chuí xīn yǐn qì","abbr":"cxyq","explanation":"犹言椎心泣血。捶拍胸膛，哭泣出血。形容非常悲痛。","source":{"text":"臣等原奏概归无效，拜命之余，不禁椎心饮泣。","book":"中国近代史资料丛刊《辛亥革命·清廷预备立宪》"},"similar":["椎心呕血"],"usage":"作谓语、定语；形容悲恸到极点"},{"id":26967,"word":"椎拍輐断","pinyin":"zhuī pāi wàn duàn","abbr":"cpwd","explanation":"輐：圆。用椎使不相合的物体拍合，圆转截断物体而不见裂状。指能适应事物，不露棱角","source":{"text":"椎拍輐断，与物宛转。","book":"战国·宋·庄周《庄子·天下》"},"usage":"作宾语、定语；用于书面语"},{"id":26968,"word":"椎牛发冢","pinyin":"chuí niú fā zhǒng","abbr":"cnfz","explanation":"杀牛盗墓。谓为盗无所不为，穷凶极恶。","source":{"text":"小者呼鸡逐狗，大者椎牛发冢，无所不至。","book":"宋·苏轼《策别》十七"},"example":{"text":"或至犯科作奸，～，聚为博弈，出为盗贼。","book":"清·戴名世《钱神问对》"},"usage":"作谓语、定语；用于坏人"},{"id":26969,"word":"椎牛歃血","pinyin":"chuí niú shà xuè","abbr":"cnsx","explanation":"古时聚众盟誓，杀牛取其血含于口中或以血涂嘴唇，表示诚意。","source":{"text":"河北二十四郡无复忠臣，独有一鲁公奋袂而起，椎牛歃血，号召连结，以横塞贼冲。","book":"清·侯方域《颜真卿论》"},"example":{"text":"或欲有所剽略，则潜结众誓于神，～，乃出所获者，集而瓜分之。","book":"清·戴名世《纪红苗事》"},"usage":"作谓语、宾语、定语；用于盟誓等"},{"id":26970,"word":"椎牛飨士","pinyin":"chuí niú xiǎng shì","abbr":"cnxs","explanation":"椎牛：杀牛；飨士：犒劳军士。指慰劳作战的官兵。","source":{"text":"汉将轻骑迎与之战，不利，堕马伤膝，还营。……诸将谓汉曰：‘大敌在前，而公伤卧，众心惧矣。’汉乃勃然裹伤而起，椎牛飨士……于是军士激怒，人倍其气。","book":"《后汉书·吴汉传》"},"example":{"text":"如今西凉平定，军中旧例，合该～，做出庆赏的筵席。","book":"元·无名氏《百花亭》第四折"},"usage":"作谓语、定语；指犒劳官兵"},{"id":26971,"word":"椎肤剥体","pinyin":"chuí fū bō tǐ","abbr":"cfbt","explanation":"形容残酷搜刮。同“椎肤剥髓”。","source":{"text":"帝曰：‘霖雨、地震之灾，岂非重兵久在蜀，调登供馈，椎肤剥体，民怨所致，当修德抚民以应之，又何祷乎！’","book":"《续资治通鉴·宋高宗绍兴四年》"},"similar":["椎肤剥髓"],"usage":"作谓语、定语；用于剥削"},{"id":26972,"word":"椎肤剥髓","pinyin":"chuí fū bō suǐ","abbr":"cfbs","explanation":"形容残酷搜刮。","source":{"text":"国家惩奸之法未及于亲手欺盗之人，而椎肤剥髓、鬻妻买子之苦已波毒于穷檐无告之小民矣。","book":"明·唐顺之《与郑户部书》"},"example":{"text":"有司奉行急于诏旨，胥吏缘为奸，～，民不堪命。","book":"《明史·方良永传》"},"similar":["椎肤剥体"],"usage":"作谓语、定语；用于剥削"},{"id":26973,"word":"椎胸跌足","pinyin":"chuí xiōng diē zú","abbr":"cxdz","explanation":"犹言椎胸顿足。形容人悲痛、悔恨等时的情状。","source":{"text":"■■■（扌蚩扌蚩扌蚩）扯碎俺姻缘簿，忽刺八掘断俺前程路，空没乱椎胸跌足，揉腮瞪目。","book":"明·贾仲名《金安寿》第三折"},"similar":["椎胸顿足"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":26974,"word":"椎胸顿足","pinyin":"chuí xiōng dùn zú","abbr":"cxdz","explanation":"形容人悲痛、悔恨等时的情状。","source":{"text":"及今岁到上海，正值联军入北平之日，而上海笙歌萧鼓，熙熙焉，融融焉，无以少异于平时，乃椎胸顿足，痛恨于我国民之心既已死尽也。","book":"梁启超《中国积弱溯源论》第二节"},"similar":["椎胸跌足","椎膺顿足"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":26975,"word":"椎膺顿足","pinyin":"chuí yīng dùn zú","abbr":"cydz","explanation":"形容人悲痛、悔恨等时的情状。同“椎胸顿足”。","source":{"text":"难怪个个中国青年读《女神》，没有不椎膺顿足，同《湘累》里的屈原同声叫道——哦，好悲切的歌词！唱的我也流起泪来了。","book":"闻一多《女神之时代精神》"},"similar":["椎胸顿足"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":26976,"word":"椎轮大辂","pinyin":"chuí lún dà lù","abbr":"cldl","explanation":"比喻事物由简到繁，由粗到精，逐步完善。亦用以称创始者。","source":{"text":"未知其事者，可以得其涯略；已知其事者，可以留备检查；其诸立宪之一助乎，吾知此为中国宪法史之椎轮大辂也。","book":"南朝·梁·萧统《〈文选〉序》：“若夫椎轮为大辂之始，大辂宁有椎轮之质？”别士《刊印〈宪政初纲〉缘起》"},"example":{"text":"病眼迷离感慨多，～竟如何。","book":"茅盾《重印〈中国神话研究ＡＢＣ〉感赋》"},"usage":"作宾语、定语；用于人或事物等"},{"id":26977,"word":"椎锋陷阵","pinyin":"chuí fēng xiàn zhèn","abbr":"cfxz","explanation":"犹冲锋陷阵。","source":{"text":"椎：捣也，直捣其锋也。","book":"《资治通鉴·晋海西公太和四年》：“将军孙盖等椎锋陷阵，应蒙殊赏。”胡三省注"},"similar":["冲锋陷阵"],"usage":"作谓语、宾语、定语；形容作战勇敢"},{"id":26978,"word":"椎锋陷陈","pinyin":"chuī fēng xiàn chén","abbr":"cfxc","explanation":"犹冲锋陷阵。形容作战勇猛。","source":{"text":"椎，捣也，直捣其锋也。","book":"《资治通鉴·晋海西公太和四年》：“将军孙盖等，应蒙殊赏。”胡三省注"}},{"id":26979,"word":"椎髻布衣","pinyin":"zhuī jì bù yī","abbr":"zjby","explanation":"椎形发髻，布制衣服。指妇女朴素的服饰。","source":{"text":"乃更为椎髻，著布衣，操作而前。","book":"《后汉书·梁鸿传》"},"usage":"作宾语、定语；用于女性"},{"id":26980,"word":"椒焚桂折","pinyin":"jiāo fén guì zhé","abbr":"jfgz","explanation":"比喻仁人志士被残害。","source":{"text":"椒焚桂折佳人老，独托幽岩展素心。","book":"鲁迅《集外集·诗》"},"usage":"作谓语；指好人被害"},{"id":26981,"word":"椿庭萱堂","pinyin":"chūn tíng xuān táng","abbr":"ctxt","explanation":"椿庭：指父亲；萱堂：指母亲。指父母双亲。","source":{"text":"不幸椿庭殒丧，深赖萱堂训诲成人。","book":"明·朱权《荆钗记传奇》第二回"},"usage":"作主语、宾语、定语；指父母"},{"id":26982,"word":"椿庭萱室","pinyin":"chūn tíng xuān shì","abbr":"ctxs","explanation":"指父母。","source":{"text":"望三五夜月对影而双天上人间齐焕采；占八千春秋百分之一～共遐龄。 ★见“八十双寿”联"}},{"id":26983,"word":"椿萱并茂","pinyin":"chūn xuān bìng mào","abbr":"cxbm","explanation":"椿：多年生落叶乔木；萱：古人以为可以使人忘忧的萱草。椿萱：喻父母，古称父为“椿庭”，母为“萱堂”。比喻父母健在。","source":{"text":"知君此去情偏切，堂上椿萱雪满头。","book":"汉·牟融《送徐浩》诗"},"example":{"text":"父母俱存，谓之～。","book":"清·程允升《幼学琼林·祖孙父子》"},"similar":["兰桂齐芳"],"usage":"作宾语、定语；与“兰桂齐芳”连用"},{"id":26984,"word":"椿龄无尽","pinyin":"chūn líng wú jìn","abbr":"clwj","explanation":"椿：古代传说有大椿树，寿命很长。像椿树一样长寿。常用做祝人长寿之词。","source":{"text":"椿龄无尽，罗图庆，常作乾坤主。","book":"《庄子·逍遥游》：“上古有大椿者，以八千岁为春，八千岁为秋。”宋·柳永《御街行》词"}},{"id":26985,"word":"楚云湘雨","pinyin":"chǔ yún xiāng yǔ","abbr":"cyxy","explanation":"比喻男女幽情。","source":{"text":"玉鞭杨柳春风陌，绣毂梨花夜月街，楚云湘雨梦阳台。休分外，花柳暗尘埃。","book":"荆干臣《全元散曲》"}},{"id":26986,"word":"楚人戎言","pinyin":"chǔ rén róng yán","abbr":"crry","explanation":"戎：西南少数民族的总称，在此作地名用。楚人生长在戎，就要说西戎人的话。比喻客观环境的影响要胜过主观条件与与自然的本能。","source":{"text":"戎人生乎戎，长乎戎，而戎言，不知其所受之，楚人生乎楚，长乎楚，而楚言，不知其所受之。今使楚人长乎戎，戎人长乎楚，则楚人戎言，戎人楚言矣。","book":"《吕氏春秋·用众》"}},{"id":26987,"word":"楚凤称珍","pinyin":"chǔ fèng chēng zhēn","abbr":"cfcz","explanation":"楚凤：楚国有人将山雉当作凤凰献给楚王，指赝品。比喻所赝品或伪物称为珍宝。","source":{"text":"虽古迹昭然，永不觉悟，而执燕石以为宝，玩楚凤而称珍，不亦谬哉？","book":"唐·张彦远《书品后》"}},{"id":26988,"word":"楚囊之情","pinyin":"chǔ náng zhī qíng","abbr":"cnzq","explanation":"指爱国之情。","source":{"text":"楚子囊还自伐吴，卒。将死，遗言谓子庚：‘必城郢！’君子谓子囊忠……将死，不忘卫社稷，可不谓忠乎！","book":"《左传·襄公十四年》"},"example":{"text":"公临危审正，载惟话言，～，惟几而弥固。","book":"南朝·梁·沈约《齐故安陆昭王碑文》"},"usage":"作宾语；指人爱国"},{"id":26989,"word":"楚囚对泣","pinyin":"chǔ qiú duì qì","abbr":"cqdq","explanation":"楚囚：原指被俘到晋国的楚国人，后泛指处于困境，无计可施的人。比喻在情况困难、无法可想时相对发愁。","source":{"text":"当共戮力王室，克复神州，何至作楚囚相对泣邪。","book":"《晋书·王导传》"},"example":{"text":"今日之行，荣于登仙，诸君何至作～耶？","book":"清·陈康祺《郎潜记闻》"},"similar":["悲观失望","束手无策"],"opposite":["谈笑自若","败而不馁"],"usage":"作谓语、宾语；指相对发愁","story":["公元316年，刘曜率军灭了西晋。司马睿在王导的拥护下在建康建立了东晋王朝。一些贵族及大臣每当天气晴朗时到建康城外的新亭饮酒，武城侯周凯发感慨引发大家都哭了起来，丞相王导说要收复神州，不能像楚囚那样相对哭泣"]},{"id":26990,"word":"楚囚相对","pinyin":"chǔ qiú xiāng duì","abbr":"cqxd","explanation":"形容人们遭遇国难或其他变故，相对无策，徒然悲伤。","source":{"text":"过江诸人，每至美日，辄相邀新亭，藉卉饮宴。周侯（周顗）中坐而叹曰：‘风景不殊，正自有山河之异！’皆相视流泪。唯王丞相（王导）愀然变色曰：‘当共戮力王室，克复神州，何至作楚囚相对！’","book":"南朝·宋刘·义庆《世说新语·言语》"},"example":{"text":"夫和妇～，血泪满襟臆。","book":"明·徐复祚《红梨记忆友》"},"similar":["楚囚对泣"],"opposite":["谈笑自若"],"usage":"作宾语、定语；指无法解脱","story":["公元316年，刘曜率军灭了西晋。司马睿在王导的拥护下在建康建立了东晋王朝。一些贵族及大臣每当天气晴朗时到建康城外的新亭饮酒，武城侯周凯发感慨引发大家都哭了起来，丞相王导说要收复神州，不能像楚囚那样相对哭泣"]},{"id":26991,"word":"楚天云雨","pinyin":"chǔ tiān yún yǔ","abbr":"ctyy","explanation":"指巫山神女，或男女欢情。","source":{"text":"妾在巫山之阳，高丘之阻，旦为朝云，暮为行雨。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"～都成幻，遗恨到如今。","book":"清·纳兰常安《眼儿媚·秋闺》词"},"similar":["楚云巫雨"],"usage":"作宾语、定语；指男女欢情","story":["传说古代襄王游览高唐地区，十分疲倦就在白天小睡了一会，在梦中看见一个仙女说：“我是高唐人，听说你来了，愿意给你当枕席。”襄王临幸了她。临别她说：“妾在巫山之阳，高丘之阻。旦为朝云，暮为行雨，朝朝暮暮，阳台之下。”"]},{"id":26992,"word":"楚尾吴头","pinyin":"chǔ wěi wú tóu","abbr":"cwwt","explanation":"古豫章一带位于楚地下游，吴地上游，如首尾相衔接，故称“楚尾吴头”。泛指长江中下游一带地方。","source":{"text":"猿惊鹤怨草三尺，楚尾吴头天一方。","book":"宋·朱熹《铅山立春》诗：“雪拥山腰洞口，春回楚尾吴头。”宋·王阮《秋日寄舍弟》诗"},"example":{"text":"金陵乃名胜之区，王气之钟也，倚钟阜，瞰长江，接天阙，枕后湖，龙蟠虎踞，～……其美利有不可胜言者。","book":"太平天国·宋溶生《建天京于金陵论》"},"similar":["吴头楚尾"],"usage":"作宾语；指边境"},{"id":26993,"word":"楚弓复得","pinyin":"chǔ gōng fù dé","abbr":"cgfd","explanation":"比喻失物复得。","source":{"text":"此图久已失去，乱后，里人于灰烬中得之，复归其家……楚弓复得，颇非偶然。","book":"清·俞樾《春在堂随笔》卷六"},"similar":["失而复得"],"usage":"作宾语、定语；同“失而复得”"},{"id":26994,"word":"楚弓楚得","pinyin":"chǔ gōng chǔ dé","abbr":"cgcd","explanation":"楚国人丢失弓，拾到的仍是楚国人。比喻自己的东西虽然丢了，拾到它的人并不是外人。","source":{"text":"楚人失弓，楚人得之，又何求焉？","book":"汉·刘向《说苑·至公》：“楚共王出猎而遗其弓，左右请求之。共王曰：‘止！楚人遗弓，楚人得之，又何求焉？’”《孔子世家·好生》"},"example":{"text":"如今恰恰的不曾动身，这个东西送上门来，～，岂有再容它已来复去的理？","book":"清·文康《儿女英雄传》第十七回"},"similar":["得失相当","一失一得"],"opposite":["楚才晋用"],"usage":"作宾语、分句；比喻利未外溢","story":["春秋时期楚共王经常带着随从骑马到山野里去打猎，有一次他骑马追逐几头野兽，眼看要追上了，但发现弓不知去向，随从说要沿路回去找。楚共王说：“不必找了，楚国人丢的弓还是会让楚国人拾到的，不会损失的。”"]},{"id":26995,"word":"楚弓遗影","pinyin":"chǔ gōng yí yǐng","abbr":"cgyy","explanation":"比喻因某事造成的疑惧心理。","source":{"text":"尝有亲客，久阔不复来，广问其故……客豁然意解，沉疴顿愈。","book":"《晋书·乐广传》"},"example":{"text":"～，～，虑祸甚关心。","book":"明·许自昌《水浒记·感愤》"},"similar":["杯弓蛇影"],"usage":"作宾语、定语；用于处事","story":["晋朝河南人乐广十分好客，见一朋友好久不来家里，十分奇怪，就去拜会他，朋友说上次在你家喝酒杯中有蛇，喝后回来后就生病。乐广不解，回到家便查原因，原来是挂在墙上的角弓影子倒射在酒杯所至，朋友闻知后就病愈"]},{"id":26996,"word":"楚得楚弓","pinyin":"chǔ dé chǔ gōng","abbr":"cdcg","explanation":"楚国人丢失弓，拾到的仍是楚国人。比喻虽有所失，而利未外溢。","source":{"text":"见“楚弓楚得”。"},"example":{"text":"喜～，免被傍人笑。","book":"明·苏复《金印记·金钗典卖》"},"similar":["楚弓楚得"],"usage":"作宾语、分句；比喻利未外溢"},{"id":26997,"word":"楚才晋用","pinyin":"chǔ cái jìn yòng","abbr":"ccjy","explanation":"比喻用才不当。","source":{"text":"既是天赋他聪敏的资质，要削足就履般来受这特殊环境的支配，楚才晋用，那是不可能的。","book":"邹韬奋《不能两全》引吴晓晨信"},"example":{"text":"邹韬奋《不能两全》引吴晓晨信：“既是天赋他聪敏的资质，要削足就履般来受这特殊环境的支配，～，那是不可能的。”"},"similar":["楚材晋用"],"usage":"作谓语、定语；比喻人才外流为人所用"},{"id":26998,"word":"楚材晋用","pinyin":"chǔ cái jìn yòng","abbr":"ccjy","explanation":"楚国的人才为晋国所用。比喻本国的人才外流到别的国家工作。","source":{"text":"晋卿不如楚，其大夫则贤，皆卿材也。如杞梓、皮革，自楚往也。虽楚有才，晋实用之。","book":"《左传·襄公二十六年》"},"example":{"text":"我花了钱，教出了人，却教外国人去用，这才是“～”呢。","book":"清·吴趼人《二十年目睹之怪现状》第三十回"},"similar":["楚才晋用"],"usage":"作谓语、定语；比喻人才外流为人所用","story":["春秋时期，楚国大夫伍举因岳丈犯事而偷逃到晋国，遇到蔡国大夫声子，声子答应帮他回到楚国，便到楚国与令尹子木就楚晋两国人才问题进行探讨，说楚国人跑到晋国得到重用，对楚国十分不利。子木认为有理就去晋国接回伍举"]},{"id":26999,"word":"楚梦云雨","pinyin":"chǔ mèng yún yǔ","abbr":"cmyy","explanation":"楚王梦，云雨情。后比喻男女亲昵。","source":{"text":"……王因幸之，去而辞曰：‘妾在巫山之阳，高丘之阴，旦为朝云，暮为行雨，朝朝暮暮，阳台之下。’","book":"战国·楚·宋玉《高唐赋序》"},"example":{"text":"院院宫妆金翠镜，朝朝～床。","book":"清·孔尚任《桃花扇·余韵》"},"similar":["楚天云雨"],"usage":"作宾语、定语；用于男女之间"},{"id":27000,"word":"楚棺秦楼","pinyin":"chǔ guān qín lóu","abbr":"cgql","explanation":"旧时指歌舞场所，也错指妓女居住的地方。","source":{"text":"这里是官府黄堂，又不是秦楼楚馆。","book":"元·关汉卿《谢天香》楔子"},"example":{"text":"周庸佑是广东数一数二的富户，自然招呼周到，每夜里就请到四马路～，达旦连宵。","book":"清·黄小配《廿载繁华梦》第十四回"}},{"id":27001,"word":"楚楚不凡","pinyin":"chǔ chǔ bù fán","abbr":"ccbf","explanation":"形容人才出众，不同寻常。","source":{"text":"幸为小女择得一婿，楚楚不凡，差强人意。","book":"清·袁枚《与何献葵明府书》"},"example":{"text":"他打扮得～。"},"similar":["风度翩翩"],"usage":"作谓语、定语、状语；指人的仪表"},{"id":27002,"word":"楚楚作态","pinyin":"chǔ chǔ zuò tài","abbr":"cczt","explanation":"犹言矫揉造作。","source":{"text":"凡人学词，功候有浅深，即浅亦非疵……楚楚作态，乃是大疵，最宜切忌。","book":"况周颐《蕙风词话》卷一"},"similar":["矫柔造作","装腔作势"],"usage":"作谓语、宾语、定语；指处事"},{"id":27003,"word":"楚楚动人","pinyin":"chǔ chǔ dòng rén","abbr":"ccdr","explanation":"楚楚：鲜明整洁的样子。形容美好的样子引人怜爱。","source":{"text":"诸郎楚楚皆玉立。","book":"《诗经·曹风·蜉蝣》：“蜉蝣之羽，衣裳楚楚。”金·元好问《杂言》"},"example":{"text":"有卖鱼阿土者，见一女从屋中出，年二十许，～。","book":"清·淮阴百一居士《壶天录》卷下"},"similar":["楚楚可人","楚楚可爱"],"usage":"作谓语、定语、状语；用于女性"},{"id":27004,"word":"楚楚可人","pinyin":"chǔ chǔ kě rén","abbr":"cckr","explanation":"形容姿容清秀，使人惬意。","source":{"text":"中多女郎，簪山花，浣衣溪口，坐溪石上。与语，了无惊猜，亦不作态，楚楚可人。","book":"清·袁枚《随园诗话》第12卷"},"example":{"text":"此数片小花，作金鱼红色者，亦～。","book":"苏曼殊《碎簪记》"},"similar":["楚楚动人"],"usage":"作谓语、宾语、定语；用于女性"},{"id":27005,"word":"楚楚可怜","pinyin":"chǔ chǔ kě lián","abbr":"cckl","explanation":"楚楚：植物丛生的样子，也形容痛苦的神情。本指幼松纤弱可爱，后形容女子娇弱的样子。","source":{"text":"松树子非不楚楚可怜，但永无栋梁之用耳。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"偶抱恙，抱闲泄子诊视，虽云鬓蓬松，而意态幽闲，大有～之致。","book":"清·许豫《白门新柳记·补礼·喜龄》"},"similar":["妩媚动人"],"opposite":["望而生畏","令人作呕"],"usage":"作谓语、定语；指非常可爱","story":["晋朝时期，孙绰作《遂初赋》明志，在畎川建房隐居，房前种一株松树，亲自浇灌。邻居高世远看见说：“松树子非不楚楚可怜，但永无栋梁用耳。”孙绰说：“枫树、柳树虽然长得合抱那么粗，又能派什么用场呢？”"]},{"id":27006,"word":"楚楚可爱","pinyin":"chǔ chǔ kě ài","abbr":"ccka","explanation":"形容陈设整齐，令人喜爱。","source":{"text":"庭内的假山如花草，布置得楚楚可爱。","book":"郁达夫《沉沦》"},"similar":["楚楚可怜"],"usage":"作谓语、定语、状语；用于人或事物"},{"id":27007,"word":"楚楚有致","pinyin":"chǔ chǔ yǒu zhì","abbr":"ccyz","explanation":"形容陈列整齐，富有情趣。","source":{"text":"所居曲房密室，帷帐尊彝，楚楚有致。","book":"清·余怀《板桥杂记·丽品》"},"usage":"作谓语、定语；用于事物等"},{"id":27008,"word":"楚楚谡谡","pinyin":"chǔ chǔ sù sù","abbr":"ccss","explanation":"形容风度清雅高迈。","source":{"text":"形容风度清雅高迈。"},"usage":"作谓语、定语、状语；用于人的气质等"},{"id":27009,"word":"楚歌之计","pinyin":"chǔ gē zhī jì","abbr":"cgzj","explanation":"指攻心之术。","source":{"text":"扞刘邦呴围羽垓下。羽夜闻汉军四面皆楚歌，知尽得楚地，羽与数百骑走，是以兵大败。","book":"《汉书·高帝纪下》"},"example":{"text":"待念头散了，就好去收他，也是个‘～’。","book":"清·袁于令《西楼记·集艳》"},"usage":"作宾语；用于用计","story":["楚汉相争时期，项羽攻占秦都以后，烧杀掳掠，人民怨声载道。汉王刘邦趁机出击想衣锦还乡的项羽，让大军把项羽围在垓下，并设下“四面楚歌”之计，项羽以为汉军已经攻占楚地，以为天要灭他，只好边饮酒边唱歌，悲壮自刎身亡"]},{"id":27010,"word":"楚歌四合","pinyin":"chǔ gē sì hé","abbr":"cgsh","explanation":"比喻四面被围，陷入孤立危急的困境。","source":{"text":"若乃项王虎斗，白日争辉。拔山力尽，盖世心违。闻楚歌之四合，知汉卒之重围。","book":"唐·李白《拟恨赋》"},"similar":["楚歌四面","楚歌四起"],"usage":"作宾语、定语；用于人的处境等"},{"id":27011,"word":"楚歌四起","pinyin":"chǔ gē sì qǐ","abbr":"cgsq","explanation":"比喻四面被围，陷入孤立危急的困境。","source":{"text":"帐前滴尽英雄泪，楚歌四起，乌骓漫嘶。","book":"元·马致远《庆东原·叹世》曲之二"},"similar":["楚歌四合"],"usage":"作宾语、定语；用于人的处境等"},{"id":27012,"word":"楚歌四面","pinyin":"chǔ gē sì miàn","abbr":"cgsm","explanation":"比喻四面被围，陷入孤立危急的困境。","source":{"text":"楚歌四面，战旗一片，岁岁江东。","book":"清·陈维崧《河传·虞美人花》词"},"similar":["楚歌四合","四面楚歌"],"usage":"作宾语、定语；用于人的处境等"},{"id":27013,"word":"楚毒备至","pinyin":"chǔ dú bèi zhì","abbr":"cdbz","explanation":"楚毒：古代炮硌之刑；备：尽，全。指使用各种刑罚。","source":{"text":"胤坐收下狱，楚毒备至，终无他辞。","book":"《三国志·吴志·陆胤传》"}},{"id":27014,"word":"楚氛甚恶","pinyin":"chǔ fēn shèn wù","abbr":"cfse","explanation":"恶：憎恨，讨厌。比喻俗恶之气令人可憎。","source":{"text":"伯夙谓赵孟曰：‘楚氛甚恶，惧难。’","book":"《左传·襄公二十七年》"}},{"id":27015,"word":"楚水吴山","pinyin":"chǔ shuǐ wú shān","abbr":"csws","explanation":"楚地的水，吴地的山。指古时吴、楚两国所属地域。后用以指长江中下游一带。","source":{"text":"故园望断欲何如，楚水吴山万里余。","book":"唐·白居易《江南送北客因凭寄徐州兄牙书》"},"example":{"text":"寄怀～外，得意唐诗恶帖中。","book":"宋·陆游《出游归鞍上口占》"},"usage":"作宾语；指南方一带"},{"id":27016,"word":"楚璧隋珍","pinyin":"chǔ bì suí zhēn","abbr":"cbsz","explanation":"指和氏璧与隋侯珠。比喻杰出的人才。","source":{"text":"想天朝罗网收豪儁，献皇家楚璧隋珍。","book":"明·陈汝元《金莲记·偕计》"},"similar":["和璧隋珠"],"usage":"作宾语、定语；指美好的东西"},{"id":27017,"word":"楚界汉河","pinyin":"chǔ jiè hàn hé","abbr":"cjhh","explanation":"楚、汉相争中双方控制地区之间的地界与河流。后常比喻战争的前线。","source":{"text":"霎时间烟焰冲霄……仿佛枪林弹雨，依稀楚界汉河。","book":"蔡东藩、许廑父《民国通俗演义》第16回"},"example":{"text":"我们要划清楚～。"},"similar":["楚河汉界"],"usage":"作宾语；比喻战争的前线"},{"id":27018,"word":"楚管蛮弦","pinyin":"chǔ guǎn mán xián","abbr":"cgmx","explanation":"泛指南方的管弦乐器。","source":{"text":"楚管蛮弦愁一概，空城舞罢腰支在。","book":"唐·李商隐《燕台·冬》诗"},"usage":"作宾语、定语；指南方乐器"},{"id":27019,"word":"楚腰卫鬓","pinyin":"chǔ yāo wèi bìn","abbr":"cywb","explanation":"指细腰秀发。借指美女。","source":{"text":"市南曲陌无秋凉，楚腰卫鬓四时芳。","book":"唐·李贺《洛姝真珠》诗"},"usage":"作宾语、定语；借指美女"},{"id":27020,"word":"楚腰纤细","pinyin":"chǔ yāo xiān xì","abbr":"cyxx","explanation":"楚腰：称妇人的细腰。形容美人的细腰，曲线玲珑。","source":{"text":"昔者先君灵王好小腰，楚子约食，凭而能立，式而能起。","book":"西汉·刘向《战国策·楚策》"},"example":{"text":"～掌中轻。","book":"唐·杜牧《遣怀诗》"},"usage":"作谓语、宾语、定语；借指美女"},{"id":27021,"word":"楚腰蛴领","pinyin":"chǔ yāo qí lǐng","abbr":"cyql","explanation":"指腰肢纤细，颈项洁白如蝤蛴。形容女子体态之美。","source":{"text":"楚腰蛴领团香玉，鬓叠深深绿。","book":"后蜀·阎选《虞美人》词"},"usage":"作宾语、定语；多用于女性"},{"id":27022,"word":"楚舞吴歌","pinyin":"chǔ wǔ wú gē","abbr":"cwwg","explanation":"泛指江南的轻歌曼舞。","source":{"text":"翡翠冠高罗袖阔，楚舞吴歌劝郎酌。","book":"元·萨都刺《江南乐》诗"},"usage":"作主语、宾语、定语；指南方歌舞"},{"id":27023,"word":"楚虽三户，亡秦必楚","pinyin":"chǔ suī sān hù，wáng qín bì chǔ","abbr":"csshwqbc","explanation":"三户：几户人家；亡：灭；秦：秦国。虽只几户人家，也能灭掉秦国。比喻虽小，决心大也能成功。","source":{"text":"故楚南公曰：‘楚虽三户，亡秦必楚’也。","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"然～，金元帝国之梦，岂久长哉？","book":"柳亚子《济南惨案纪念日感赋》序"},"similar":["三户亡秦"],"usage":"作宾语、定语；用于书面语","story":["秦朝末期，陈胜吴广起义，各路义军纷纷配合，项梁率军攻秦。范增去拜见项梁说：“秦灭六国，楚国最冤，楚南公说过楚国即使只剩下三户人家都会报仇雪恨消灭秦国的。”于是项梁立楚怀王的孙子米心为楚怀王，得到楚人的拥护而迅速壮大实力"]},{"id":27024,"word":"楚越之急","pinyin":"chǔ yuè zhī jí","abbr":"cyzj","explanation":"以之泛指面临外敌入侵，国事危急。","source":{"text":"春秋时楚越两国先后遭吴入侵。"}},{"id":27025,"word":"楚雨巫云","pinyin":"chǔ yǔ wū yún","abbr":"cywy","explanation":"楚地巫峡的云和雨。多比喻男女幽情。","source":{"text":"眼底情，心间恨，到多如楚雨巫云。","book":"元·孙周卿《沉醉东风·宫词》曲"},"example":{"text":"虽然是，锦衣玉食身安吉，却倒是，～意挂心。","book":"《再生缘》第六回"},"similar":["楚天云雨"],"usage":"作宾语、定语；指男女私情"},{"id":27026,"word":"楚馆秦楼","pinyin":"chǔ guǎn qín lóu","abbr":"cgql","explanation":"楚馆：楚灵王筑章华宫，选美人入宫；秦楼：秦穆公女弄玉善吹箫，穆公建楼给她居住。指歌舞妓院场所。","source":{"text":"也不知他在楚馆秦楼贪恋着谁，全不想养育的深恩义。","book":"元·张国宾《薛仁贵》第三折"},"example":{"text":"小小自十五而至二十，这四五年，～之福，俱已享尽。","book":"清·墨浪子《西湖佳话·西泠韵迹》"},"similar":["花街柳巷","秦楼楚馆"],"usage":"作宾语、定语；指歌榭妓院","story":["春秋时期，秦穆公的女儿弄玉特别擅长吹箫，秦穆公特地为她修建了一座凤楼，也叫秦楼，弄玉在此楼吹箫作乐。楚灵王特别好色，修建了章华宫，挑选全国最漂亮的女子住在那里，供他玩乐。后人称章华宫为楚馆"]},{"id":27027,"word":"楛耕伤稼","pinyin":"kǔ gēng shāng jià","abbr":"hgsj","explanation":"楛：粗劣，粗恶；稼：庄稼。耕田不细致，庄稼受损害。","source":{"text":"楛耕伤稼，耘耨失岁，政险失民。","book":"战国·赵·荀况《荀子·天论》"},"usage":"作宾语、定语；用于劝诫人"},{"id":27028,"word":"楛耕伤稼，楛耘失岁","pinyin":"kǔ gēng shāng jià，kǔ yún shī suì","abbr":"hgsjhyss","explanation":"楛：粗恶；稼：庄稼；耘：除草；岁：年谷成熟，收成。指耕作不细致，会影响到的收成。","source":{"text":"楛耕伤稼，楛耘失岁。","book":"战国·赵·荀况《荀子·天论》"},"example":{"text":"曰：何谓人妖？曰：～，政险失民，田秽稼恶。","book":"汉·韩婴《韩诗外传》第二卷"},"similar":["楛耕伤稼"],"usage":"作宾语、定语；用于书面语"},{"id":27029,"word":"楛耘伤岁","pinyin":"kǔ yún shāng suì","abbr":"kyss","explanation":"楛：粗恶；耘：除草；岁：年谷成熟。耕作不细致，会影响到一年的收成。","source":{"text":"枯耕伤稼，枯耘伤岁。","book":"《荀子·天论》：“楛耕伤稼，耘耨失薉。”汉·韩婴《韩诗外传》卷二"}},{"id":27030,"word":"楛耘失岁","pinyin":"kǔ yún shī suì","abbr":"hyss","explanation":"楛：粗恶；耘：除草；岁：年谷成熟，收成。指耕作不细致，会影响到的收成。","source":{"text":"楛耕伤稼，楛耘失岁。","book":"战国·赵·荀况《荀子·天论》"},"usage":"作宾语；指耕作不细致，会影响到的收成"},{"id":27031,"word":"楞头呆脑","pinyin":"léng tóu dāi nǎo","abbr":"ltdn","explanation":"形容发楞发呆的样子。同“楞头楞脑”。","source":{"text":"我完全没有听讲，当然不知道李老师提问了什么。现在几乎全班都举手了，这有我们这张桌子上楞头呆脑地坐着两个人。","book":"余辰《蚕》"},"similar":["楞头磕脑","楞头楞脑"],"usage":"作定语、状语；用于口语"},{"id":27032,"word":"楞头楞脑","pinyin":"léng tóu léng nǎo","abbr":"ltln","explanation":"①形容鲁莽冒失或傻呵呵的样子。②形容发楞发呆的样子。","source":{"text":"干妈，虎子傻，说话楞头楞脑，没分寸。","book":"曹禺《原野》第二幕"},"example":{"text":"调度员忽闪忽闪眨着眼，～地望着梁建。","book":"杜鹏程《在和平的日子里》第三章"},"similar":["楞头磕脑","楞头呆脑"],"usage":"作定语、状语；用于口语"},{"id":27033,"word":"楞头磕脑","pinyin":"léng tóu kē nǎo","abbr":"ltkn","explanation":"形容鲁莽冒失或傻呵呵的样子。也形容发楞发呆的样子。同“楞头楞脑”。","source":{"text":"一搁下了事，他心中不痛快，便有点楞头磕脑的。","book":"老舍《鼓书艺人》十五：“打头的是小刘，楞头磕脑地就撞了进来，站在一边，光哆嗦，不说话。” 又《骆驼祥子》一"},"similar":["楞头呆脑","楞头楞脑"],"usage":"作定语、状语；用于口语"},{"id":27034,"word":"楞手楞脚","pinyin":"lèng shǒu lèng jiǎo","abbr":"lslj","explanation":"形容动作鲁莽。","source":{"text":"她怕他，那家伙楞手楞脚，什么事都会干得出来。","book":"梁斌《红旗谱》"},"similar":["粗手粗脚"],"usage":"作谓语、状语；指动作鲁莽"},{"id":27035,"word":"楞眉横眼","pinyin":"lèng méi héng yǎn","abbr":"lmhy","explanation":"形容蛮横凶恶的样子。","source":{"text":"一个士兵走过来，楞眉横眼地说：‘滚开吧！’","book":"梁斌《红旗谱》"},"similar":["横眉冷眼"],"usage":"作谓语、定语、状语；指凶恶的样子"},{"id":27036,"word":"楶棁之材","pinyin":"jié zhuō zhī cái","abbr":"jzzc","explanation":"楶：斗拱；棁：梁上的短柱。比喻才能很小的人。","source":{"text":"楶棁之材，不荷栋梁之任。","book":"《汉书·叙传》"}},{"id":27037,"word":"楼台亭阁","pinyin":"lóu tái tíng gé","abbr":"lttg","explanation":"楼：多层建筑物；台：高而平，可供眺望的建筑物；亭：有顶无墙供游息建筑物；阁：楼房一种。统指多种供休息、游赏的建筑物。","source":{"text":"翠微寺本翠微宫，楼阁亭台数十重。","book":"宋·周煇《清波别志》中卷"},"example":{"text":"除了～之处，单是厅堂，就有三十八处。","book":"清·吴趼人《二十年目睹之怪现状》第45回"},"similar":["楼阁亭台"],"usage":"作宾语、定语；指建筑物"},{"id":27038,"word":"楼台殿阁","pinyin":"lóu tái diàn gé","abbr":"ltdg","explanation":"殿：古代泛指高大的堂屋。指帝王所居和供奉神佛之所。","source":{"text":"乃是一座大山，山中有楼台殿阁，唤做灵山大雷音寺。","book":"明·吴承恩《西游记》第八十七回"},"example":{"text":"海中造起三座山：一座蓬莱，一座方丈，一座瀛洲，像海上三神山一般。山上～，四围掩映。","book":"清·褚人获《隋唐演义》第二十七回"}},{"id":27039,"word":"楼台近水","pinyin":"lóu tái jìn shuǐ","abbr":"ltjs","explanation":"水边的楼台先得到月光。比喻能优先得到利益或便利的某种地位或关系。","source":{"text":"楼台近水涵明鉴，草树连空写素屏。","book":"宋·陈与义《寺居》诗"}},{"id":27040,"word":"楼堂馆所","pinyin":"lóu táng guǎn suǒ","abbr":"ltgs","explanation":"楼：高楼大厦；堂：殿堂；馆：宾馆；所：处所。泛指一切高档建筑物。","source":{"text":"有的部队请客送礼，修建楼堂馆所。","book":"邓小平《军队整顿的任务》"},"usage":"作主语、宾语、定语；指建筑物"},{"id":27041,"word":"楼船箫鼓","pinyin":"lóu chuán xiāo gǔ","abbr":"lcxg","explanation":"乘坐楼船，吹箫击鼓。楼船：有楼饰的游船。","source":{"text":"其一，楼船箫鼓，峨冠盛筵，灯火优傒，声光相乱，名为看月而实不见月者，看之。","book":"明·张岱《陶庵梦忆西湖七月半》"}},{"id":27042,"word":"楼阁亭台","pinyin":"lóu gé tíng tái","abbr":"lgtt","explanation":"泛指高大富丽的建筑群。亭，有顶无墙的建筑物。","source":{"text":"煇幼年亦得一诗云：‘翠微寺本翠微宫，楼阁亭台数十重。’","book":"宋·周煇《清波别志》卷中"},"example":{"text":"踟蹰无计，返而～，涉历几尽。","book":"清·蒲松龄《聊斋志异·西湖主》"},"similar":["楼台亭阁"],"usage":"作宾语、定语；指建筑物"},{"id":27043,"word":"楼阁台榭","pinyin":"lóu gé tái xiè","abbr":"lgtx","explanation":"楼：高楼；阁：架空的楼；台：土筑的高坛；榭：台上的房屋。泛指高大华丽的建筑群。","source":{"text":"楼阁台榭，转相连注，山池玩好，穷尽雕丽。","book":"晋·葛洪《西京杂志》第四卷"},"similar":["亭台楼阁"],"usage":"作主语、宾语；指建筑物"},{"id":27044,"word":"概不由己","pinyin":"gài bù yóu jǐ","abbr":"gbyj","explanation":"指一切不能由自己做主。","source":{"text":"公言固是有理，独不思君命所差，概不由己？","book":"明·许仲琳《封神演义》第二回"},"example":{"text":"～，我只好如此。"},"similar":["不由自主","身不由己"],"usage":"作谓语、定语；指不能自主"},{"id":27045,"word":"概日凌云","pinyin":"gài rì líng yún","abbr":"grly","explanation":"蔽日穿云，形容很高。","source":{"text":"槊动风霜，弩穿金石，高楼大舰，概日凌云。","book":"南朝·陈·徐陵《为陈武帝作相时与北齐广陵城主书》"},"example":{"text":"或穿池运石，为山学海；或层台累构，～。","book":"《周书·武帝纪下》"},"usage":"作谓语、定语；形容很高"},{"id":27046,"word":"概莫能外","pinyin":"gài mò néng wài","abbr":"gmnw","explanation":"概：全。一概不能除外。指都在所指范围之内。","source":{"text":"然好大不经，奇谲无已，虽邹衍谈天之辩，庄周蜗角之论，尚未足以概莫能外。","book":"《后汉书·西域传》"},"example":{"text":"这是共通的道理，古今中外，～。","book":"毛泽东《矛盾论》"},"usage":"作谓语；指都在所指范围之内"},{"id":27047,"word":"榆木圪垯","pinyin":"yú mù gē dá","abbr":"ymgd","explanation":"坚硬的榆树根。比喻思想顽固。"},{"id":27048,"word":"榆木疙瘩","pinyin":"yú mù gē da","abbr":"ymgd","explanation":"坚硬的榆树根。比喻思想顽固。","source":{"text":"人人都是封建迷信脑袋，像榆木疙瘩一样，三斧子五斧子劈不开。","book":"葛洛《卫生组长》"},"example":{"text":"罗心刚：“老夏？你认识？”夏雨：“岂止认识！是我爸爸，典型的～脑袋！”","book":"《新华文摘》1981年第2期"},"similar":["榆木脑壳","榆木脑袋"],"usage":"作宾语、定语；多用于比喻句"},{"id":27049,"word":"榆木脑壳","pinyin":"yú mù nǎo ké","abbr":"ymnk","explanation":"比喻思想顽固。同“榆木脑袋”。","source":{"text":"‘大叔，谢谢您老人家！’黄金印淌下了热泪，‘您敲开了我脖腔子上这颗榆木脑壳。’","book":"刘绍棠《柳伞》三"},"similar":["榆木脑袋","榆木疙瘩"],"usage":"作宾语、定语；多用于比喻句"},{"id":27050,"word":"榆木脑袋","pinyin":"yú mù nǎo dài","abbr":"ymnd","explanation":"比喻思想顽固。亦作“榆木脑壳”。","source":{"text":"你娘不是那榆木脑袋！娶亲不坐轿，这年头净这么办，俺也赞成。","book":"谷峪《新事新办》"},"example":{"text":"“大叔，谢谢您老人家！”黄金印淌上了热泪，“您敲开了我脖腔子上这颗榆木脑壳。”","book":"刘绍棠《柳伞》三"},"similar":["榆木脑壳"],"usage":"作主语、宾语、定语；指思想顽固"},{"id":27051,"word":"榆枋之见","pinyin":"yú fāng zhī jiàn","abbr":"yfzj","explanation":"榆枋，榆树与枋树。比喻狭小的天地。后用以比喻浅薄的见解。","source":{"text":"鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里……蜩与学鸠笑曰：‘我决起而飞，抢榆枋，时则不至而控于地而已矣，奚以之九万里而南为？’","book":"《庄子·逍遥游》"},"example":{"text":"及从栎园先生游，始信人之才分相越，真非意量所及，愧予犹～也。","book":"清姜承列《序》"},"usage":"作宾语；用于书面语"},{"id":27052,"word":"榆次之辱","pinyin":"yú cì zhī rǔ","abbr":"yczr","explanation":"用以指无故受辱之典。","source":{"text":"荆轲尝游过榆次，与盖聂论剑，盖聂怒而目之。","book":"《史记·刺客列传》"},"example":{"text":"性既迟缓，与人无伤，虽出胯下之负，～，不知贬毁之于己，犹蚊虻之一过也。","book":"《后汉书·孔融传》"},"usage":"作宾语；用于书面语"},{"id":27053,"word":"榆瞑豆重","pinyin":"yú míng dòu zhòng","abbr":"ymdz","explanation":"用以指身懒神昏。","source":{"text":"《博物志》云：‘食豆三年，则身重，行止难。’又曰：‘啖榆，则瞑不欲觉也。’","book":"语出《文选·嵇康》：“且豆令人重，榆令人瞑；合欢蠲忿，萱草忘忧，愚智所共知也。”李善注"},"example":{"text":"木朽石顽，雕镌莫就；～，性分难移。","book":"唐李商隐《为柳珪上京兆公谢辟启》"},"usage":"作宾语、定语；用于书面语"},{"id":27054,"word":"榛榛狉狉","pinyin":"zhēn zhēn pī pī","abbr":"zzpp","explanation":"榛榛：草木丛杂；狉狉：野兽乱跑。草木丛生，野兽出没。形容荒僻尚未开化的地方。","source":{"text":"草木榛榛，鹿豕狉狉。","book":"唐·柳宗元《封建论》"},"example":{"text":"章炳麟《读书后》：“向使地球凝结以来，迁延旁薄以至沛育新期，一循其～之俗，而无愈久愈侈，愈久愈靡者，则黄金弃于矿……”"},"usage":"作谓语、定语；用于书面语"},{"id":27055,"word":"榜上无名","pinyin":"bǎng shàng wú míng","abbr":"bswm","explanation":"张贴的名单上没有名字。泛指落选。","source":{"text":"谁知三场得意，榜上无名。自五岁进场，到今二十一岁，三科不中。","book":"明·冯梦龙《警世通言》第十七卷"},"example":{"text":"这话令兄也说过，若～，大家莫想他回来。","book":"清·李汝珍《镜花缘》第四十二回"},"similar":["名落孙山"],"opposite":["金榜题名","榜上有名"],"usage":"作谓语、分句；指考试不中"},{"id":27056,"word":"榱崩栋折","pinyin":"cuī bēng dòng shé","abbr":"cbds","explanation":"榱，古代指椽子，放在檩上支持屋面和瓦片的木条。比喻大局崩溃。","source":{"text":"况政府有榱崩栋折之忧，于两公有送袍推襟之素，其敢不罄所识虑，尽言于善人。","book":"《“五四”爱国运动资料·张季直致北京电》"},"usage":"作定语；指崩溃"},{"id":27057,"word":"榱栋崩折","pinyin":"cuī dòng bēng shé","abbr":"cdbs","explanation":"比喻大局崩溃。","source":{"text":"今有巨厦，更历千岁，瓦墁毁坏，榱栋崩折，非不枵然大也，风雨猝集，则倾圮必矣。","book":"清·梁启超《论不变法之害》"}},{"id":27058,"word":"榷酒征茶","pinyin":"què jiǔ zhēng chá","abbr":"qjzc","explanation":"征收酒茶税。亦泛指苛捐杂税。","source":{"text":"草野抒忠告，榷酒征茶太纷扰。","book":"明·陈汝元《金莲记·射策》"},"similar":["苛捐杂税"],"usage":"作宾语、定语；用于书面语"},{"id":27059,"word":"槁形灰心","pinyin":"gǎo xíng huī xīn","abbr":"gxhx","explanation":"形容身体衰弱，意志消沉。","source":{"text":"鹿门所见于吾者，殆故吾也，而未尝见夫槁形灰心之吾乎！","book":"明·唐顺之《答茅鹿门知县》"},"usage":"作谓语、定语；用于比喻句"},{"id":27060,"word":"槁木死灰","pinyin":"gǎo mù sǐ huī","abbr":"gmsh","explanation":"枯干的树木和火灭后的冷灰。比喻心情极端消沉，对一切事情无动于衷。","source":{"text":"形固可使如槁木，而心固可使如死灰乎？","book":"《庄子·齐物论》"},"example":{"text":"所以这李纨虽青春丧偶，且居处于膏梁锦绣之中，竟如“～”一般，一概不问不闻，惟知侍亲养子。","book":"清·曹雪芹《红楼梦》第四回"},"similar":["万念俱灰","灰心丧气"],"opposite":["生气勃勃","意气风发"],"usage":"作宾语、定语、状语；用于比喻句","story":["大观园内只有李纨一个寡妇，她原是贾珠的老婆，贾珠死后，她与五岁的儿子贾兰相依为命。她出身金陵名宦家庭，知书达理，她青春丧偶后，虽处于膏粱锦绣之中，竟如槁木死灰一般，对外界一概不问不闻，就知道侍亲养子，是一个贤妻良母"]},{"id":27061,"word":"槁苏暍醒","pinyin":"gǎo sū yē xǐng","abbr":"gsyx","explanation":"使枯槁者复苏，使中暑者苏醒。形容苦难者得救，重获生机。","source":{"text":"自吾令下车，赋役以平，刑罚以清……槁苏暍醒，民饱而嬉，相忘乎无事。","book":"金·王若虚《宁晋县令吴君遗爱碑》"},"usage":"作谓语、定语；用于比喻句"},{"id":27062,"word":"槁项没齿","pinyin":"gǎo xiàng méi chǐ","abbr":"gxmc","explanation":"颈枯齿落。年老貌。","source":{"text":"是时科第既益重，豪儁之士，槁项没齿，冀得当于一试。","book":"清·薛福成《代李伯相重锲洨滨遗书序》"},"usage":"作谓语、定语；用于老年人"},{"id":27063,"word":"槁项黄馘","pinyin":"gǎo xiàng huáng xù","abbr":"gxhg","explanation":"槁：枯干；项：颈项；馘：脸。颈项枯瘦，面色苍黄。形容不健康的容貌。","source":{"text":"夫处穷闾阨巷，困窘织屦，槁项黄馘者，商之所短也。","book":"《庄子·列御寇》"},"example":{"text":"贤者～而死于下，不贤者比肩接迹而显于世。","book":"明·瞿佑《剪灯新话·修文舍人传》"},"similar":["面黄肌瘦"],"usage":"作谓语、定语；形容不健康的容貌"},{"id":27064,"word":"槁项黧馘","pinyin":"gǎo xiàng lí guó","abbr":"gxlg","explanation":"形容不健康的容貌。同“槁项黄馘”。","source":{"text":"孰知夫二百年来，聪明才杰之资，迍邅场屋，槁项黧馘以老死牖下者，肩相至也。","book":"清·薛福成《选举论上》"},"similar":["槁项黄馘"],"usage":"作谓语、定语；形容不健康的容貌"},{"id":27065,"word":"槁骨腐肉","pinyin":"gǎo gǔ fǔ ròu","abbr":"ggfr","explanation":"槁：枯干；腐：腐烂。枯槁的骨头，腐烂的肉。指死者。","source":{"text":"非不能竭国糜民，虚府殚财，含珠麟施，纶组节束，追送死也，以为穷民绝业而无益无槁骨腐肉也。","book":"《淮南子·齐俗训》"}},{"id":27066,"word":"槃木朽株","pinyin":"pán mù xiǔ zhū","abbr":"pmxz","explanation":"不成材的曲木朽木。比喻劣材。槃，同“盘”。","source":{"text":"槃木朽株，为万乘用者，左右为之容耳。王者取士，宜拔众之所贵。","book":"《后汉书·循史传·孟尝》"},"similar":["蟠木朽株"],"usage":"作主语、宾语、定语；指劣材"},{"id":27067,"word":"槃根错节","pinyin":"pán gēn cuò jié","abbr":"pgcj","explanation":"树根盘曲，枝节交错。比喻繁维复杂不易解决的事情。","source":{"text":"志不求易，事不避难，臣之职也。不遇槃根错节，何以别利器乎？","book":"《后汉书·虞诩传》"},"similar":["盘根错节"],"usage":"作谓语、宾语、定语；比喻事情复杂"},{"id":27068,"word":"槊血满袖","pinyin":"shuò xuè mǎn xiù","abbr":"sxmx","explanation":"指奋槊进击，血染征袍。形容英勇战斗。","source":{"text":"至王劭《齐志》，述高季式破敌于韩陵，追奔逐北，而云‘夜半方归，槊血满袖’。","book":"唐·刘知畿《史通·模拟》"},"usage":"作宾语、状语；指战斗"},{"id":27069,"word":"槌仁提义","pinyin":"chuí rén tí yì","abbr":"crty","explanation":"槌：敲击，拍打；提：举出。抛弃仁义。","source":{"text":"周方槌仁提义，废礼绝乐，欲以一人私臆，扫百代名教而空之。","book":"明·胡应麟《少室山房笔丛·九流绪论》"},"example":{"text":"我们决不能槌仁提义，做一些伤天害理的事。"},"usage":"作谓语、宾语；用于书面语"},{"id":27070,"word":"槌牛酾酒","pinyin":"chuí niú shāi jiǔ","abbr":"cnsj","explanation":"杀牛滤酒。指备肴酒以燕享。","source":{"text":"槌牛酾酒，英雄千古谁吊。","book":"元·萨都刺《酬江月·过淮阴》词"},"usage":"作谓语；指请客"},{"id":27071,"word":"槌胸蹋地","pinyin":"chuí xiōng tà dì","abbr":"cxtd","explanation":"捶胸顿足。表示极度悲痛或悔恨。","source":{"text":"蓦逢老妪犹相识，槌胸蹋地说青溪。","book":"清·金人瑞《青溪行》"},"similar":["捶胸顿足"],"usage":"作谓语、状语；用于悲伤或痛愤时"},{"id":27072,"word":"槌骨沥髓","pinyin":"chuí gǔ lì suí","abbr":"cgls","explanation":"槌：敲打；沥：往下滴。敲碎骨头，沥干骨髓。形容残酷的剥削。","source":{"text":"贪吏并缘，侵欲无艺，槌骨沥贿，民不聊生。","book":"宋·陆九渊《与宋漕》"},"similar":["捶骨沥髓"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":27073,"word":"槐南一梦","pinyin":"huái nán yī mēng","abbr":"hnym","explanation":"比喻人生如梦，富贵得失无常。","source":{"text":"唐李公佐《南柯太守传》载，淳于棼饮酒古槐树下，醉后入梦，见一城楼题大槐安国。槐安国王招其为驸马，任南柯太守三十年，享尽富贵荣华。醒后见槐下有一大蚁穴，南枝又有一小穴，即梦中的槐安国和南柯郡。"},"example":{"text":"寡人适方饮酒之间，想起大夫所谭神女之事，不觉神睛恍惚，睡思懵腾……正是只将桑海千秋事，付与～中。","book":"明王錂《春芜记·宸游》"},"similar":["南柯一梦"],"usage":"作宾语；同“黄粱美梦”","story":["唐·李公佐《南柯太守传》小说中的故事，淳于棼在古槐树下酒醉入梦，梦见一城楼上写着大槐安国，槐安国王招其为驸马，任南柯太守三十年，享尽荣华富贵。醒后发现槐树下有蚂蚁穴和树穴，这就是梦中的槐安国和南柯郡"]},{"id":27074,"word":"槛猿笼鸟","pinyin":"jiàn yuán lóng niǎo","abbr":"kyln","explanation":"槛：关禽兽的木笼。槛中之猿，笼中之鸟。比喻受制于人，没有自由。","source":{"text":"神仙不难得，但尘俗多累，若槛猿笼鸟，徒有骞翔超腾之心，安可致乎？","book":"唐·张读《宣室志·石旻》"},"example":{"text":"听他言词多慨慷，想他不甚提防，只是～难亲傍。","book":"明·张凤翼《红拂记·相公完偶》"},"similar":["槛花笼鹤"],"usage":"作宾语、定语；指受到约束的人或物"},{"id":27075,"word":"槛花笼鹤","pinyin":"jiàn huā lóng hè","abbr":"jhlh","explanation":"栅栏中的花、笼中的鹤。比喻受到约束的人或物。","source":{"text":"倘然生小在侯家，天意转孤负。作了槛花笼鹤，怎笑狂如许！","book":"清·龚自珍《好事近·行箧中有像一幅以词为赞》"},"similar":["笼中之鸟"],"usage":"作宾语、定语；指受到约束的人或物"},{"id":27076,"word":"樗栎庸材","pinyin":"chū lì yōng cái","abbr":"clyc","explanation":"樗栎：不成材的树木。比喻平庸无用的人。常用作谦词。","source":{"text":"吾有大树，人谓之樗，其大本拥肿而不中绳墨，其小枝卷曲而不中规矩。立之涂，匠者不顾。","book":"《庄子·逍遥游》"},"example":{"text":"庶曰：“某～，何敢当此重誉。”","book":"明·罗贯中《三国演义》第三十六回"},"similar":["碌碌无为","平庸无奇"],"opposite":["才华出众"],"usage":"作宾语；比喻无用之材，常用作谦词"},{"id":27077,"word":"樗栎散材","pinyin":"chū lì sǎn cái","abbr":"clsc","explanation":"樗栎：不成材的树木。比喻平庸无用的人。常用作谦词。","source":{"text":"如某者，驽骀下乘，樗栎散材。","book":"《庄子·逍遥游》：“吾有大树，人谓之樗，其大本拥肿而不中绳墨，其小枝卷曲而不中规矩。立之涂，匠者不顾。”宋·杨时《谢太守启》"}},{"id":27078,"word":"模山范水","pinyin":"mó shān fàn shuǐ","abbr":"msfs","explanation":"用文字或图画描绘山水景物。","source":{"text":"及长卿之徒，诡势瑰声，模山范水，字必鱼贯，所谓诗人丽则而约言，辞人丽淫而繁句也。","book":"南朝·梁·刘勰《文心雕龙·物色》"},"example":{"text":"故纯粹之～、留连光景之作，自建安之前，大未之见。","book":"王国维《屈子文学之精神》"},"usage":"作谓语、宾语；用于书面语"},{"id":27079,"word":"模棱两可","pinyin":"mó léng liǎng kě","abbr":"mllk","explanation":"模棱：含糊，不明确；两可：可以这样，也可以那样。指不表示明确的态度，或没有明确的主张。","source":{"text":"处事不欲决断明白，若有错误，必贻咎谴，但模棱以持两端可矣。","book":"《旧唐书·苏味道传》"},"example":{"text":"他害怕事情一旦变化，他将有不测大祸，所以跪在地上回答了一句～的话。","book":"姚雪垠《李自成》第二卷第三十章"},"similar":["不置可否","模棱两端"],"opposite":["旗帜鲜明"],"usage":"作谓语、宾语、定语；指态度不明确","story":["唐朝宰相苏味道处世十分圆滑，从不表明自己的看法，他认为这样不会得罪人，他把这种圆滑的方法说成“决事不欲明白，误则有悔，模棱特两端可也。”人们送他一个外号叫“苏模棱”。后因犯错而降职到四川眉州"]},{"id":27080,"word":"模棱两端","pinyin":"mó léng liǎng duān","abbr":"mlld","explanation":"指不表示明确的态度，或没有明确的主张。同“模棱两可”。","source":{"text":"处事不欲决断明白，若有错误，必贻咎谴，但模棱以持两端可矣。","book":"《旧唐书·苏味道传》"},"example":{"text":"祁宫保～，怕事之极。","book":"《三元里人民抗英斗争史料·粤东纪事》"},"similar":["模棱两可"],"opposite":["旗帜鲜明"],"usage":"作谓语、宾语、定语；指态度不明确"},{"id":27081,"word":"模模糊糊","pinyin":"mó mó hū hū","abbr":"mmhh","explanation":"思想上不清晰。","source":{"text":"雪雁出来一看，模模糊糊认得是薛姨妈那边的人。","book":"清·曹雪芹《红楼梦》第82回"},"example":{"text":"我对老家的印象一直是～的。"},"similar":["朦朦胧胧"],"opposite":["清清楚楚"],"usage":"作谓语、定语、状语；指不清晰"},{"id":27082,"word":"横七竖八","pinyin":"héng qī shù bā","abbr":"hqsb","explanation":"有的横，有的竖，杂乱无章。形容纵横杂乱。","source":{"text":"一片瓦砾场上，横七竖八，杀死的男子妇人，不计其数。","book":"明·施耐庵《水浒全传》第三十四回"},"example":{"text":"床下～有几双花鞋。","book":"曹禺《日出》第三幕"},"similar":["乱七八糟","杂乱无章"],"opposite":["有条不紊","井井有条"],"usage":"作谓语、定语、状语；形容杂乱无章"},{"id":27083,"word":"横三竖四","pinyin":"héng sān shù sì","abbr":"hsss","explanation":"有的横着，有的竖着。形容杂乱无章，没有条理。","source":{"text":"横三竖四，乍离乍合。","book":"宋·释普济《五灯会元·越州姜山方禅师》"},"example":{"text":"宝钗便顺着游廊，来至房中，只见外间床上～，都是丫头们睡觉。","book":"清·曹雪芹《红楼梦》第三十六回"},"similar":["杂乱无章","横三顺四"],"opposite":["整整齐齐"],"usage":"作状语、定语；指杂乱无章"},{"id":27084,"word":"横三顺四","pinyin":"héng sān shùn sì","abbr":"hsss","explanation":"形容纵横杂乱。","source":{"text":"办公室的床上、桌子上、地上，横三顺四地睡着人。","book":"杜鹏程《在和平的日子里》第一章"},"similar":["横三竖四","杂乱无章"],"opposite":["井井有条","井然有序"],"usage":"作状语、定语；指杂乱无章"},{"id":27085,"word":"横从穿贯","pinyin":"héng cóng chuān guàn","abbr":"hccg","explanation":"指融会贯通。把各方面的知识和道理融化汇合，得到全面透彻的理解。","source":{"text":"以经世之学，自负其议论，证曏经史，横从穿贯，闻者莫不屈服。","book":"清·方苞《兄百川墓志铭》"},"similar":["融会贯通"],"usage":"作谓语、定语；用于书面语"},{"id":27086,"word":"横倒竖卧","pinyin":"héng dǎo shù wò","abbr":"hdsw","explanation":"躺卧凌乱的样子。","source":{"text":"满院横倒竖卧七长八短的一地死和尚。","book":"《儿女英雄传》第七回"},"example":{"text":"清·贪梦道人《彭公案》第21回：“见众人～，昏迷不醒，方要抡刀杀人。”"},"similar":["横躺竖卧"],"usage":"作谓语、定语、状语；用于口语"},{"id":27087,"word":"横僿不文","pinyin":"héng sài bù wén","abbr":"hsbw","explanation":"僿，粗鄙。粗鄙没有文化。","source":{"text":"当太平之世，地地相等，无有都会、乡邑之殊……无据乱世，学校全聚京都，而乡邑则皆横僿不文之俗。","book":"康有为《大同书》辛部第十三章"},"usage":"作谓语、定语；用于人没文化"},{"id":27088,"word":"横冲直撞","pinyin":"héng chōng zhí zhuàng","abbr":"hczz","explanation":"乱冲乱撞，蛮横无理。","source":{"text":"凡作文皆从外边攻进里去，我谓文章就时而攻打出来，就他城池，食他粮草，统率他兵马，直冲横撞，搅得他粉碎，故不费一毫气力而自然有余也。","book":"明·李贽《续焚书·与友人论文》"},"example":{"text":"只见三妖全身甲胄，～，左右厮杀。","book":"明·许仲琳《封神演义》第九十六回"},"similar":["横行无忌","横行霸道"],"opposite":["谦虚礼让"],"usage":"作谓语、定语、状语；形容肆意行动"},{"id":27089,"word":"横冲直闯","pinyin":"héng chōng zhí chuǎng","abbr":"hczc","explanation":"乱冲乱撞，蛮横无理。同“横冲直撞”。","source":{"text":"他有一种脾气，凡事只需听凭感情横冲直闯一阵……丝毫不管他所说的做的是不妥当。","book":"沙汀《困兽记》三"},"example":{"text":"路遥《平凡的世界》第四卷第53章：“他几乎是～地穿过人群，又顺着原路拐回到小南河边。”"},"similar":["横冲直撞","横行直撞","直冲横撞"],"usage":"作谓语、定语、状语；形容肆意行动"},{"id":27090,"word":"横刀揭斧","pinyin":"héng dāo jiē fǔ","abbr":"hdjf","explanation":"指持刀执斧。","source":{"text":"据说，茶贩的队伍往往是一个人担茶叶，两个人保卫，‘横刀揭斧，叫呼踊跃’。","book":"范文澜、蔡美彪等《中国通史》第四编第二章第八节"},"usage":"作谓语、定语；用于书面语"},{"id":27091,"word":"横刀跃马","pinyin":"héng dāo yuè mǎ","abbr":"hdym","explanation":"指手持武器，纵马驰骋。指在沙场作战。犹言横戈跃马。","source":{"text":"上元帅白从辉横刀跃马，望南阵冲来。樊爱能、何徽抵敌不住，弃战回马而走。","book":"清·吴璿《飞龙全传》第四十八回"},"example":{"text":"他[孙传庭]刚刚坐定，这一大群人已经跟了进来，用各种阿谀逢迎的言词称颂他神机妙算……还称颂他如何在战场上～，气吞河山。","book":"姚雪垠《李自成》第一卷第十一章"},"similar":["横戈跃马"],"usage":"作谓语、定语；形容在战场上作战的神态"},{"id":27092,"word":"横制颓波","pinyin":"héng zhì tuí bō","abbr":"hztb","explanation":"横：从上至下猛落；制：制止；颓：落下，水向下流。将河流截断，以制止往下奔流的洪水。比喻制止、扭转衰颓委靡的风气或趋势。","source":{"text":"君讳子昂，字伯玉，蜀人也。崛起江汉，虎视函夏，卓立千古，横制颓波，天下翕然，质文一变。","book":"唐·卢藏用《唐右拾遗陈子昂文集序》"},"example":{"text":"力祛陋习，～，与数子俪美争鸣，其有功于文教不小也。","book":"明·李开先《闲居集·海岱诗集序》"}},{"id":27093,"word":"横加干涉","pinyin":"héng jiā gān shè","abbr":"hjgs","explanation":"横：蛮横；干涉：不正当地过问或制止。蛮横地加以制止或过问。指不讲道理，非要管与自己无亲的事。"},{"id":27094,"word":"横加指责","pinyin":"héng jiā zhǐ zé","abbr":"hjzz","explanation":"横：蛮横。不讲道理地批评或挖苦别人。"},{"id":27095,"word":"横发逆起","pinyin":"hèng fā nì qǐ","abbr":"hfnq","explanation":"横：不测，意外。指出乎所料，突然兴起。","source":{"text":"吉凶祸福，横发逆起，有不可知，将合于道，其惟权乎。","book":"宋·岳珂《桯史·丹棱巽岩》"},"usage":"作谓语；用于书面语"},{"id":27096,"word":"横失","pinyin":"heng yi","abbr":"hs","explanation":"指纵横反复地放胆议论。"},{"id":27097,"word":"横头横脑","pinyin":"héng tóu héng nǎo","abbr":"hthn","explanation":"显得粗暴蛮横、自以为是的冒昧行为。","example":{"text":"他～地妄加评论。"},"usage":"作谓语、定语、状语；用于处事"},{"id":27098,"word":"横尸遍野","pinyin":"héng shī biàn yě","abbr":"hsby","explanation":"杀得到处都是尸体。","example":{"text":"这场战争杀得～，血流成河。"},"similar":["尸横遍野"],"usage":"作状语、定语；指战争等"},{"id":27099,"word":"横峰侧岭","pinyin":"héng fēng cè lǐng","abbr":"hfcl","explanation":"形容山势纵横交错，起伏重叠。","source":{"text":"横看成岭侧成峰，远近高低各不同，不识庐山真面目，只缘身在此山中。","book":"宋·苏轼《题西林壁》"},"example":{"text":"尝作《云山图》，峭壁圆峥，～，备极隐现浮沉之妙。","book":"清·陶元藻《越画见闻·明·刘鹏》"},"usage":"作宾语、定语；用于书面语"},{"id":27100,"word":"横征暴敛","pinyin":"héng zhēng bào liǎn","abbr":"hzbl","explanation":"敛：搜刮。指向人民强行征收苛捐杂税，进行残酷剥削。","source":{"text":"国家财用皆出人民，如有不节而用度有阙，则横赋暴敛必将有及于民，虽有爱人之心，而民不被其泽矣。","book":"宋·朱熹《已酉拟上封事》"},"example":{"text":"这些财富，都是蒋介石等利用其独裁权力～、假公济私而来的。","book":"毛泽东《中国人民解放军宣言》"},"similar":["敲骨吸髓","苛捐杂税"],"opposite":["轻徭薄赋"],"usage":"作谓语、定语、宾语；指残酷剥削"},{"id":27101,"word":"横征暴赋","pinyin":"hèng zhēng bào fù","abbr":"hzbf","explanation":"滥征捐税，强行搜刮民财。","source":{"text":"固合抚绥黎庶，上副天心，蠲减征徭，内荣乡里。而乃横征暴赋，不奉典常，擅破人家，自丰私室。","book":"唐·元稹《弹奏剑南东川节度使状》"},"similar":["横征苛敛","横征暴敛"],"usage":"作谓语、定语、宾语；指残酷剥削"},{"id":27102,"word":"横征苛役","pinyin":"hèng zhēng kē yì","abbr":"hzky","explanation":"指滥收捐税，徭役严酷。","source":{"text":"夫以始皇、二世之横征苛役，淫刑以逞，以汉高较之，仁暴自相天壤。","book":"清·陈天华《中国革命史论》第二章第四节"},"usage":"作谓语、定语、宾语；指残酷剥削"},{"id":27103,"word":"横征苛敛","pinyin":"hèng zhēng kē liǎn","abbr":"hzkl","explanation":"指滥收捐税，强行搜刮民财。","source":{"text":"犹恐不足制吾族死命也，于是横征苛敛，供其饕餮。","book":"黎元洪《布告山东人民文》"},"similar":["横征暴敛"],"usage":"作谓语、定语、宾语；指残酷剥削"},{"id":27104,"word":"横恩滥赏","pinyin":"hèng ēn làn shǎng","abbr":"hels","explanation":"不符合规定的赏赐。","source":{"text":"冗兵冗吏，所宜痛减；横恩滥赏，不可辄启。","book":"宋·叶適《宝谟阁直学士刘公墓志铭》"},"usage":"作宾语、定语；用于书面语"},{"id":27105,"word":"横戈盘马","pinyin":"héng gē pán mǎ","abbr":"hgpm","explanation":"犹横戈跃马。形容将士威风凛凛，准备冲杀作战的英勇姿态。","source":{"text":"忽记横戈盘马处，散关清渭应如故。","book":"宋·陆游《蝶恋花·离小益作》词"},"similar":["横戈跃马"],"usage":"作谓语、定语；形容在战场上作战的神态"},{"id":27106,"word":"横戈跃马","pinyin":"héng gē yuè mǎ","abbr":"hgym","explanation":"横持戈矛，策马腾跃。形容将士威风凛凛，准备冲杀作战的英勇姿态。","source":{"text":"见一人雄赳赳披袍擐甲，嗔忿忿横枪跃马。","book":"元·陈以仁《雁门关存孝打虎》"},"example":{"text":"平生纵有英雄血，无由一溅荆江水；荆江日落阵云低，～今何时。","book":"清·成德《送荪友》"},"similar":["横戈盘马"],"usage":"作谓语、定语；形容在战场上作战的神态"},{"id":27107,"word":"横扫千军","pinyin":"héng sǎo qiān jūn","abbr":"hsqj","explanation":"横扫：扫荡、扫除。把大量敌军象扫地似地一阵子扫除掉。","source":{"text":"词源倒流三峡水，笔阵独扫千人军。","book":"唐·杜甫《醉歌行》"},"example":{"text":"七百里驱十五日，赣水苍茫闽山碧，～如卷席。","book":"毛泽东《渔家傲·反第二次大围剿》词"},"similar":["风卷残云"],"opposite":["溃不成军","丢盔卸甲"],"usage":"作主语、宾语、定语；形容气势宏伟"},{"id":27108,"word":"横抢武夺","pinyin":"hèng qiǎng wǔ duó","abbr":"hqwd","explanation":"指用强力夺取。","source":{"text":"敌人看到我们的觉醒，因而发生了恐慌。假面具剥掉了，露出了它们的狰狞的面孔来横抢武夺。","book":"郭沫若《羽书集·我们失掉的只是奴隶的镣铐》"},"similar":["横抢硬夺"],"usage":"作谓语、宾语、定语；用于处事"},{"id":27109,"word":"横抢硬夺","pinyin":"hèng qiǎng yìng duó","abbr":"hqyd","explanation":"指用强力夺取。","source":{"text":"你瞧他们爷儿们、娘儿们，这阵横抢硬夺的，还了得了。","book":"《儿女英雄传》第三二回"},"similar":["横抢武夺"],"usage":"作谓语、宾语、定语；用于处事"},{"id":27110,"word":"横拖倒扯","pinyin":"héng tuō dào chě","abbr":"htdc","explanation":"犹横拖倒拽。","source":{"text":"［也先］谁知身子一侧，侧下马来，凑巧脚镫缠住了一只脚，被马横拖倒扯。","book":"明·罗贯中《三遂平妖传》第五回：“张千、李万见焦员外来问，不由分说，横拖倒扯捉进府门。”明·徐渭《英烈传》第十六回"},"example":{"text":"下面一声答应，可怜把王忠～，拉将下去。","book":"清·雪樵主人《双凤奇缘》第八回"},"similar":["横拖倒拽","横拖竖拉"],"usage":"作定语、状语；用于人的行动"},{"id":27111,"word":"横拖倒拽","pinyin":"héng tuō dào zhuāi","abbr":"htdz","explanation":"拽：用力拉扯。指用暴力强拖硬拉。","source":{"text":"众皂隶一齐动手，把娇娇嫩嫩的一个尼姑，横拖倒拽，捉将下来。","book":"明·凌濛初《初刻拍案惊奇》卷三十四"},"example":{"text":"玉大人叫把他们站起来，就有几个差人～将他三人拉下堂去。","book":"清·刘鹗《老残游记》第五回"},"similar":["横拖倒扯","横拖竖拉"],"usage":"作谓语、定语、状语；用于人的行动"},{"id":27112,"word":"横拖竖拉","pinyin":"héng tuō shù lā","abbr":"htsl","explanation":"犹横拖倒拽。指用暴力强拖硬拉。","source":{"text":"可是文教委员是个大块头，打篮球的一等好手，横拖竖拉地就把方巧珍顶到大礼堂门口。","book":"陆文夫《荣誉》"},"similar":["横拖倒拽","横拖倒扯"],"usage":"作定语、状语；用于人的行动"},{"id":27113,"word":"横拖竖曳","pinyin":"héng tuō shù yè","abbr":"htsy","explanation":"用暴力强拉硬拖。","source":{"text":"那差役便横拖竖曳，把他抓到轿前。","book":"清·吴趼人《二十年目睹之怪现状》第99回"},"similar":["横拖竖拉","横拖倒拽"],"usage":"作定语、状语；用于人的行动"},{"id":27114,"word":"横拦竖挡","pinyin":"héng lán shù dǎng","abbr":"hlsd","explanation":"指多方阻挡。","source":{"text":"不想舅太太只管这等横拦竖挡的说着，他一积伶，到底反底下那几个字商量出来了。","book":"《儿女英雄传》第四十回"},"similar":["横遮竖挡"],"usage":"作宾语、定语；用于处事"},{"id":27115,"word":"横挑鼻子竖挑眼","pinyin":"héng tiāo bí zi shù tiāo yǎn","abbr":"htbzsty","explanation":"比喻百般挑剔。","source":{"text":"他横挑鼻子竖挑眼，倒好像他立下汗马功劳，得由我跪接跪送才对。","book":"老舍《龙须沟》第三幕"},"example":{"text":"搞了这样一个方案。大家可以～，评头品足嘛。","book":"张天民《创业》第二章"},"similar":["百般挑剔"],"usage":"作谓语、定语；比喻百般挑剔"},{"id":27116,"word":"横无忌惮","pinyin":"hèng wú jì dàn","abbr":"hwjd","explanation":"任意妄为，无所顾忌。","source":{"text":"这种狂暴的行为，就是未开化的蛮人都是不能做出的，而日本军部横无忌惮地，在二十世纪开明的今日，不惜一演再演地引以为快意了。","book":"郭沫若《羽书集·告国际友人书》"},"similar":["肆无忌惮"],"usage":"作谓语、定语、状语；指一点没有顾忌"},{"id":27117,"word":"横枪跃马","pinyin":"héng qiāng yuè mǎ","abbr":"hqym","explanation":"指手持武器，纵马驰骋。指在沙场作战。犹横戈跃马。","source":{"text":"见一人雄赳赳披袍擐甲，嗔忿忿横枪跃马。","book":"元·陈以仁《雁门关存孝打虎》"},"example":{"text":"如果你没有为祖国～，你怎能认识她壮美的山河。","book":"李瑛《夜过珍珠河》诗"},"similar":["横戈跃马","横刀立马"],"usage":"作谓语、定语；用于战士等"},{"id":27118,"word":"横槊赋诗","pinyin":"héng shuò fù shī","abbr":"hsfs","explanation":"槊：长矛；赋：吟。横着长矛而赋诗。指能文能武的英雄豪迈气概。","source":{"text":"酾酒临江，横槊赋诗，固一世之雄也。","book":"唐·元稹《唐故工部员外郎杜君墓志铭》：“曹氏父子鞍马间为文，自言自语横槊赋诗。”宋·苏轼《前赤壁赋》"},"example":{"text":"宋营船上，灯球密布，甚是欢喜，不觉有曹公赤壁～的光景。","book":"清·钱彩《说岳全传》第四十四回"},"similar":["能文能武"],"usage":"作谓语；指能文能武的英雄豪迈气概","story":["宋朝时期，苏轼第一次与朋友游览黄冈赤壁，他们在船上高歌，一朋友吹起洞箫应和。苏轼问他为什么吹起这如怨如泣的乐曲，他说想起了当年曹操的豪壮情怀，“旌旗蔽空，鲡酒临江，横槊赋诗，固一世之雄也。”"]},{"id":27119,"word":"横殃飞祸","pinyin":"hèng yāng fēi huò","abbr":"hyfh","explanation":"横：意外的。指意外的、平白无故的灾祸。","source":{"text":"其经曰：家有三皇文，辟邪恶鬼、温疫气、横殃飞祸。","book":"晋·葛洪《抱朴子·遐览》"},"similar":["横祸飞灾"],"usage":"作主语、宾语；指灾祸"},{"id":27120,"word":"横灾飞祸","pinyin":"hèng zāi fēi huò","abbr":"hzfh","explanation":"指意外的、平白无故的灾祸。同“横祸飞灾”。","source":{"text":"好同志啊！我永远忘不了你！希望你坚强地安然无恙地度过这横灾飞祸之年。","book":"徐绍武《检察长人选》"},"example":{"text":"徐绍武《检察长人选》：“好同志啊！我永远忘不了你！希望你坚强地安然无恙地度过这～之年。”"},"similar":["飞灾横祸","横祸非灾"],"usage":"作宾语、定语；指意外的灾祸"},{"id":27121,"word":"横生枝节","pinyin":"héng shēng zhī jié","abbr":"hszj","explanation":"枝节：比喻细小或旁出的事情。比喻在解决问题过程中意外地发生了一些麻烦事。","source":{"text":"少詹既未能从人而舍己，又疑人之不相与，而以为外己，所以枝节横生，意见多疑。","book":"宋·叶适《水心文集·答少詹书》"},"example":{"text":"唯其有谣言，不宜～，反引起格外的猜疑。","book":"高阳《清宫外史》上册"},"similar":["节外生枝","好事多磨"],"opposite":["一帆风顺"],"usage":"作谓语、宾语、状语；比喻意外的问题"},{"id":27122,"word":"横眉冷对千夫指","pinyin":"héng méi lěng duì qiān fū zhǐ","abbr":"hmldqfz","explanation":"比喻以愤恨和轻蔑的态度对待敌人的攻击。","source":{"text":"横眉冷对千夫指，俯首甘为孺子牛。","book":"鲁迅《自嘲》"},"example":{"text":"他有最大的尊严，～。他有最大的谦虚，俯首甘为孺子牛。","book":"王蒙《布礼》"},"usage":"作定语、分句；指对人的态度"},{"id":27123,"word":"横眉冷对千夫指，俯首甘为孺子牛","pinyin":"héng méi lěng duì qiān fū zhǐ，fǔ shǒu gān wéi rú zǐ niú","abbr":"hmldqfzfsgwrzn","explanation":"横眉：怒目而视；千夫指：众人都指责；孺子牛：甘为为人服务的人。指对待敌人决不屈服，对人民大众甘愿服务。","source":{"text":"横眉冷对千夫指，俯首甘为孺子牛。","book":"鲁迅《自嘲》诗"},"usage":"作宾语、定语、分句；用于处世"},{"id":27124,"word":"横眉冷目","pinyin":"héng méi lěng mù","abbr":"hmlm","explanation":"愤怒、轻蔑的样子。同“横眉冷眼”。","source":{"text":"现在他又横眉冷目地喝了一声‘走’，更把个张温吓没了真魂。","book":"郭澄清《大刀记》第十三章"},"similar":["横眉冷眼"],"usage":"作定语、宾语；指愤怒的样子"},{"id":27125,"word":"横眉冷眼","pinyin":"héng méi lěng yǎn","abbr":"hmly","explanation":"愤怒、轻蔑的样子。","source":{"text":"横眉冷眼不怕鬼，心红胆壮看咱们谁怕谁？","book":"李季《周总理啊，大庆儿女想念你》诗"},"example":{"text":"我不喜欢他～的样子。"},"similar":["横眉冷目"],"usage":"作主语、定语、宾语；指愤怒的样子"},{"id":27126,"word":"横眉努目","pinyin":"héng méi nǔ mù","abbr":"hmnm","explanation":"耸眉瞪眼。形容怒目相视，态度凶狠的样子。","source":{"text":"后蜀·何光远《鉴戒录》卷十引陈裕诗：“横眉努目强干嗔，便作阎浮有力神。祸福岂由泥捏汉，烧香供养弄蛇人。”努，一本作“怒”。"},"similar":["横眉立眼","横眉怒视"],"usage":"作定语、谓语、状语；指怒目而视"},{"id":27127,"word":"横眉吐气","pinyin":"héng méi tǔ qì","abbr":"hmtq","explanation":"犹言扬眉吐气。形容摆脱了长期受压状态后高兴痛快的样子。","source":{"text":"玉鞭金镫骅骝蹄，横眉吐气如虹霓。","book":"五代·齐己《轻薄行》"},"similar":["扬眉吐气"],"usage":"作谓语、定语、状语；用于书面语"},{"id":27128,"word":"横眉怒目","pinyin":"héng méi nù mù","abbr":"hmnm","explanation":"五代·后蜀·何光远《监戒录》引陈裕诗：“横眉怒目强干嗔，便作阎浮有力神。祸福岂由泥捏汉，烧香代养弄蛇人。”","source":{"text":"三三两两的打手，都～，短打扮，随时进来，往后院去。 ★老舍《茶馆》第一幕"},"example":{"text":"鲁迅《故事新编·非攻》：“墨子拍着红铜的兽环，当当的敲了几下，不料开门出来的却是一个～的门丁。”"},"similar":["横眉竖眼","杀气腾腾"],"opposite":["慈眉善目","和颜悦色","和蔼可亲"],"usage":"作定语、谓语、状语；指怒目而视"},{"id":27129,"word":"横眉怒视","pinyin":"héng méi nù shì","abbr":"hmns","explanation":"犹言横眉努目。形容怒目相视，态度凶狠的样子。","source":{"text":"师飙等《金戈铁马少年时》第五章；“辛弃疾、贾瑞、飞烟、金福仗剑立于帐口，一个个横眉怒视，杀气逼人。”"},"similar":["横眉努目","横眉立目","横眉怒目"],"usage":"作谓语、定语；指人的神态"},{"id":27130,"word":"横眉瞪目","pinyin":"héng méi dèng mù","abbr":"hmdm","explanation":"形容怒目相视，态度凶狠的样子。同“横眉努目”。","source":{"text":"[废品]好像是唉声叹气，抱怨自己的主人，又好像是在横眉瞪目地指责自己的主人。","book":"南宁《检验工叶英》"},"similar":["横眉怒目","横眉努目","横眉瞪眼"],"opposite":["慈眉善目"],"usage":"作定语、谓语、状语；指怒目而视"},{"id":27131,"word":"横眉瞪眼","pinyin":"héng méi dèng yǎn","abbr":"hmdy","explanation":"犹言横眉努目。形容怒目相视，态度凶狠的样子。","source":{"text":"一个太平军冲到他身边，他以为是他的部下，还横眉瞪眼的叫：‘打、打、打！’","book":"《太平天国歌谣传说集·徐泰吉找死》"},"similar":["横眉瞪目","横眉怒目","横眉努目"],"usage":"作定语、谓语、状语；指怒目而视"},{"id":27132,"word":"横眉立目","pinyin":"héng méi lì mù","abbr":"hmlm","explanation":"犹言横眉努目。形容怒目相视，态度凶狠的样子。","source":{"text":"三三两两的打手，都横眉立目，短打扮，随时进来往后院去。","book":"老舍《茶馆》第一幕"},"example":{"text":"焦庆媳妇撩开门帘子，～地喊：‘走，走，马小辫，你给我滚出去！’","book":"浩然《艳阳天》第一○九章"},"similar":["横眉竖目","横眉怒目","横眉怒视"],"usage":"作谓语、定语；指人的外表"},{"id":27133,"word":"横眉立眼","pinyin":"héng méi lì yǎn","abbr":"hmly","explanation":"犹言横眉努目。形容怒目相视，态度凶狠的样子。","source":{"text":"白占魁横眉立眼，凶狠狠地要去赶车。","book":"柳青《创业史》第二部第二四章"},"example":{"text":"他～的冲着老教师说：‘她不来吗，这也只少得到她一个人啦，跟我们开不开会有好大关系呢？’","book":"沙汀《困兽记》二四"},"similar":["横眉立目","横眉努目","横眉怒目"],"usage":"作定语、谓语、状语；指怒目而视"},{"id":27134,"word":"横眉竖目","pinyin":"héng méi shù mù","abbr":"hmsm","explanation":"指耸眉瞪眼，形容怒目相视，态度凶狠的样子。","source":{"text":"原来他发现站在他面前的人群个个都横眉竖目，向他挥着拳头。","book":"李居民《四个小故事·铁山庙“拜神记”》"},"example":{"text":"李居民《四个小故事·铁山庙“拜神记”》：“原来他发现站在他面前的人群个个都～，向他挥着拳头。”"},"similar":["横眉怒目","横眉竖眼","横眉怒视"],"usage":"作谓语、定语；指耸眉瞪眼"},{"id":27135,"word":"横眉竖眼","pinyin":"héng méi shù yǎn","abbr":"hmsy","explanation":"指耸眉瞪眼，形容怒目相视，态度凶狠的样子。","source":{"text":"来了长安一个半月，在我面前，总看见你横眉竖眼，满脸的怨气。","book":"曹禺《王昭君》第二幕"},"example":{"text":"李准《李双双小传》：“回头～地对双双说：‘我算服了你了！’怒气冲冲，头也不回地走了。”"},"similar":["横眉怒目","横眉竖目","立眉竖眼"],"opposite":["和颜悦色"],"usage":"作谓语、定语、状语；指耸眉瞪眼"},{"id":27136,"word":"横祸非灾","pinyin":"hèng huò fēi zāi","abbr":"hhfz","explanation":"犹言横殃飞祸。指意外的、平白无故的灾祸。","source":{"text":"只为那当年认了个不良贼，送的俺一家儿横祸非灾。","book":"元·张国宾《合汗衫》第三折"},"example":{"text":"天哪，天哪，怎遭这场～！","book":"元·秦简夫《赵礼让肥》第三折"},"similar":["横祸飞灾","飞灾横祸","横殃飞祸"],"usage":"作宾语、定语；指意外的灾祸"},{"id":27137,"word":"横祸飞灾","pinyin":"hèng huò fēi zāi","abbr":"hhfz","explanation":"指意外的、平白无故的灾祸。同“横殃飞祸”。","source":{"text":"非是我假虚脾爱使乖，也只怕粉脸香腮，引动你密意幽怀，倒做了横祸飞灾。","book":"元·无名氏《碧桃花》第四折"},"example":{"text":"我院君贤达，人间没赛。真是家有贤妻，夫不遭～。","book":"明·徐臣《杀狗记·迎春私叹》"},"similar":["横祸非灾","横殃飞祸","飞灾横祸"],"usage":"作宾语、定语；指意外的灾祸"},{"id":27138,"word":"横科暴敛","pinyin":"hèng kē bào liǎn","abbr":"hkbl","explanation":"滥征捐税，强行搜刮民财。同“横征暴赋”。","source":{"text":"佥议司官不肯供报民户版籍，州县疆界，本国横科暴敛，民少官多，刑罚不一，若止依本俗行事，实难抚治。","book":"《元史·外夷传一·高丽》"},"example":{"text":"老百姓受不了～，纷纷揭竿而起"},"similar":["横赋暴敛","横征暴敛"],"usage":"作谓语、宾语；指残酷剥削"},{"id":27139,"word":"横翔捷出","pinyin":"héng xiáng jié chū","abbr":"hxjc","explanation":"指超逸特出。","source":{"text":"执五寸之翰，书方尺之简，而列于大夫之上，横翔捷出，冠压百吏。","book":"宋·苏轼《上刘侍读书》"},"example":{"text":"杜工部以‘知’、‘见’二字相配，～，奇绝殊甚。","book":"宋·孙奕《履斋示儿编·诗说·知见》"},"usage":"作谓语、定语；用于书面语"},{"id":27140,"word":"横草之功","pinyin":"héng cǎo zhī gōng","abbr":"hczg","explanation":"横草：把草踩倒。如同踩倒草那样的功劳。比喻功绩很小。","source":{"text":"军无横草之功，得列宿卫，食禄五年。","book":"《汉书·终军传》"},"example":{"text":"臣凭籍壑略，忝当戎政，神机密运，不待～。","book":"唐·张说《为河内郡王武懿宗平冀州贼契丹等露布》"},"similar":["尺寸之功"],"usage":"作主语、宾语；指小功"},{"id":27141,"word":"横蛮无理","pinyin":"hèng mán wú lǐ","abbr":"hmwl","explanation":"态度粗暴，不讲道理。","source":{"text":"罗广斌 杨益言《红岩》第十三章“余新江望着眼前这个横蛮无理，惯于装腔作势的敌人，气愤地握紧了拳头。”"},"example":{"text":"他一向对人～，很少有朋友"},"usage":"作谓语、定语、状语；用于处事态度"},{"id":27142,"word":"横行不法","pinyin":"héng xíng bù fǎ","abbr":"hxbf","explanation":"横行：行动蛮横。肆无忌惮，专做违法的事。","source":{"text":"福建漳浦县天主教民，平日横行不法，县令又极意袒护，故平民衔恨次骨。","book":"《辛亥革命》"},"example":{"text":"我们不能干～的事。"},"similar":["横行霸道"],"usage":"作谓语、定语；指肆无忌惮做违法的事"},{"id":27143,"word":"横行介士","pinyin":"héng xíng jiè shì","abbr":"hxjs","explanation":"介士：同“甲士”，披甲的士兵。螃蟹的别称。","source":{"text":"出师下寨之际，忽见蟹，则当呼为横行介士，权以安众。","book":"宋·傅肱《蟹谱·兵权》"}},{"id":27144,"word":"横行天下","pinyin":"héng xíng tiān xià","abbr":"hxtx","explanation":"横行：纵横驰骋，毫无阻挡。形容遍行天下，不受阻碍。也形容东征西战，到处称强，没有敌手。","source":{"text":"体恭敬而心忠信，术礼义而情爱人，横行天下，虽困四夷，人莫不贵。","book":"《荀子·修身》"},"example":{"text":"尝欲广求勇力之士，自为一队，亲率之以～。","book":"明·冯梦龙《东周列国志》第六十三回"},"similar":["所向无敌"],"usage":"作谓语、宾语；指所向无敌"},{"id":27145,"word":"横行奡桀","pinyin":"héng xíng ào jié","abbr":"hxaj","explanation":"横行：不遵守正道而行，指行动蛮横，依仗暴力干坏事；奡、桀：夏代的两个暴君。像奡和桀那样为所欲为，蛮横凶残，不讲人道。","source":{"text":"一任他横行奡桀，有谁人敢再弄唇舌。","book":"清·洪昇《长生殿·侦报》"},"usage":"作谓语、定语；用于处事"},{"id":27146,"word":"横行无忌","pinyin":"héng xíng wú jì","abbr":"hxwj","explanation":"横行：指行动蛮横；无忌：无所顾忌。指倚仗暴力，毫无顾忌地干坏事。","source":{"text":"横行无忌，朝廷无人敢言。","book":"明·罗贯中《三国演义》第十三回"},"example":{"text":"他倚了夫家之势，又会谄媚太后，得其欢心，因便骄奢淫佚，与太平公主一样～。","book":"清·禇人获《隋唐演义》第七十五回"},"similar":["为所欲为","蛮横无理","为非作歹"],"opposite":["奉公守法","安分守己"],"usage":"作谓语、定语、状语；用于坏人"},{"id":27147,"word":"横行直撞","pinyin":"héng xíng zhí zhuàng","abbr":"hxzz","explanation":"任意奔走，毫无顾忌。","source":{"text":"当先顾全武一骑马，一把刀，横行直撞，逢人便杀。","book":"《古今小说·临安里钱婆留发迹》"},"similar":["横冲直撞","直冲横撞","直撞横冲"],"usage":"作谓语、定语、状语；形容肆意行动"},{"id":27148,"word":"横行直走","pinyin":"héng xíng zhí zǒu","abbr":"hxzz","explanation":"任意奔走，毫无顾忌。","source":{"text":"当初金鞑子、元鞑子，在中国横行直走，没有一个敢挡住他。","book":"清·陈天华《警世钟》"},"similar":["横行直撞","横冲直撞"],"usage":"作谓语、定语、状语；形容肆意行动"},{"id":27149,"word":"横行逆施","pinyin":"héng xíng nì shī","abbr":"hxns","explanation":"指做事违反常道，行为不轨。","source":{"text":"我们知道北伐军为了援救江浙的民众起见，为了铲除帝国主义的工具起见，绝对不能容忍这班强盗军阀在江浙横行逆施。","book":"述之《怎样才能解决江浙目前的危急问题》"},"similar":["倒行逆施"],"usage":"作谓语、定语、宾语；用于处事"},{"id":27150,"word":"横行霸道","pinyin":"héng xíng bà dào","abbr":"hxbd","explanation":"横行：行动蛮横仗势做坏事；霸道：蛮不讲理。依仗权势为非作歹。","source":{"text":"一任薛蟠横行霸道，他不但不去管约，反‘助纣为虐’讨好儿。","book":"清·曹雪芹《红楼梦》第九回"},"example":{"text":"世界上的事就是这样：越是卑鄙无耻，自私自利的人，越是得势，～。","book":"茅盾《霜叶红似二月花》十四"},"similar":["专横跋扈","胡作非为","为所欲为"],"opposite":["安分守己","奉公守法"],"usage":"作谓语、定语、状语；指为非作歹","story":["贾府的亲戚薛蟠来贾府名义是他是典型的花花公子，学习是三天打鱼两天晒网，根本不在乎。目的是想结识些纨绔子弟，他结识“香怜”、“玉爱”两个风流学生，整天在外胡作非为，代管学生的贾瑞对他不闻不问，任他横行霸道"]},{"id":27151,"word":"横见侧出","pinyin":"héng jiàn cè chū","abbr":"hjcc","explanation":"指不自正面而从侧面表露出来。","source":{"text":"四面峰峦如花蕊，纤苞浓朵，横见侧出，二十里内，秀蒨阁眉，殆不可状。","book":"明·袁宏道《由水溪至水心崖记》"},"example":{"text":"释氏止因圣人之言平易正直，习之生厌，故更将其理，翻新换异，～，以使人鼓舞不倦耳。","book":"清·周亮工《书影》卷八"},"usage":"作谓语、定语；用于书面语"},{"id":27152,"word":"横说竖说","pinyin":"héng shuō shù shuō","abbr":"hsss","explanation":"指多方论说，反复喻解。","source":{"text":"且如四祖下牛头融大师，横说竖说，犹未知向上关棙子。","book":"《景德传灯录·希运禅师》"},"example":{"text":"卢学士曰：‘说须出自己之意，～，以抑扬详赡为上。","book":"明·郎瑛《七修类稿·诗文一·各文之始》"},"similar":["好说歹说"],"usage":"作分句、状语；用于口语"},{"id":27153,"word":"横赋暴敛","pinyin":"héng fù bào liǎn","abbr":"hfbl","explanation":"横、暴：残暴，强横，凶狠；赋、敛：征税，聚财。强横残暴地征收苛捐杂税。形容反动统治阶级贪婪凶狠、搜刮人民的罪行。","source":{"text":"国家财用皆出人民，如有不节而用度有阙，则横赋暴敛必将有及于民，虽有爱人之心，而民不被其泽矣。","book":"宋·朱熹《已酉拟上封事》"},"example":{"text":"[冉求]反替他取民米粟，比往日又加了一倍，～，日甚一日。","book":"明·李东阳《杂记·孟子直解》"},"similar":["横科暴敛"],"usage":"作谓语、宾语；指残酷剥削"},{"id":27154,"word":"横躺竖卧","pinyin":"héng tǎng shù wò","abbr":"htsw","explanation":"躺卧凌乱的样子。","source":{"text":"两个和尚反倒横躺竖卧血流满面的倒在地下丧了残生。","book":"《儿女英雄传》第六回"},"example":{"text":"一批批的小伙子，偏在石头上～。","book":"郭小川《拍石头》诗"},"similar":["横倒竖卧"],"usage":"作定语、状语；用于口语"},{"id":27155,"word":"横遮竖挡","pinyin":"héng zhē shù dǎng","abbr":"hzsd","explanation":"指多方阻挡。同“横拦竖挡”。","source":{"text":"守门的手足并用，横遮竖挡的不叫球攻入门内。","book":"老舍《赵子曰》第三"},"similar":["横拦竖挡"],"usage":"作宾语、定语；用于处事"},{"id":27156,"word":"横金拖玉","pinyin":"héng jīn tuō yù","abbr":"hjty","explanation":"指官服盛装。","source":{"text":"其犹子总戎弘玮、弘场及诸孙十二人，谋相与罗长筵，考钟鼓，横金拖玉，称百年之觞。","book":"清·钱谦益《杜大将军七十寿序》"},"usage":"作谓语、定语；指做官"},{"id":27157,"word":"横针竖线","pinyin":"héng zhēn shù xiàn","abbr":"hzsx","explanation":"指缝纫之事。","source":{"text":"说来不怕你大家笑话，我活了十九岁，不知横针竖线，你就叫我钉个纽襻子，我不知从那头儿钉起。","book":"《儿女英雄传》第八回"},"usage":"作宾语、定语；用于缝纫等"},{"id":27158,"word":"横驱别骛","pinyin":"héng qū bié wù","abbr":"hqbw","explanation":"指纵横奔驰。","source":{"text":"本朝魏叔子，多结交淡泊奇玮之士，为寿序抑扬抗坠，横驱别骛，力脱前人之所为。","book":"清·恽敬《与卫海峰先生同年书》"},"usage":"作谓语；用于书面语"},{"id":27159,"word":"樵村渔浦","pinyin":"qiáo cūn yú pǔ","abbr":"qcyp","explanation":"指山村水乡。泛指乡村。","source":{"text":"昨日樵村渔浦，今日琼川银渚。","book":"金·完颜亮《昭君怨·雪》"},"usage":"作主语、宾语、定语；指乡村"},{"id":27160,"word":"樵柯烂尽","pinyin":"qiáo kē làn jìn","abbr":"qklj","explanation":"砍柴的斧子手柄已经烂掉。比喻时间的长久和世事的变迁。","example":{"text":"到～的时候，你才想起要回家了。"},"usage":"作宾语、定语；比喻时间的长久","story":["晋朝时期，传说信安郡王质靠打柴为生。一天他拿了一把新斧子上石室山去砍柴，他爬到山顶见有几个小孩在下棋，觉得好奇就凑上前去观战。小童送给他青枣吃，他一直看到他们下完棋，发现他斧子手柄都烂了，回家发现已过去几十年了"]},{"id":27161,"word":"樵苏不爨","pinyin":"qiáo sū bù cuàn","abbr":"qsbc","explanation":"柴草做不成饭。比喻贫困。","source":{"text":"幸有袁生，时步玉趾，樵苏不爨，清淡而已，有似周党之过闵子。","book":"三国·魏·应璩《与侍郎曹长思书》"},"example":{"text":"仁卿固安贫，终日～，项无纤介见于容容。","book":"明·宋濂《桑仁卿传》"},"similar":["樵苏失爨"],"usage":"作谓语、定语；指生活贫困"},{"id":27162,"word":"樵苏后爨","pinyin":"qiáo sū hòu cuàn","abbr":"qshc","explanation":"樵苏：采集柴草；爨：炊。柴草做不成饭。比喻贫困。","source":{"text":"臣闻千里馈粮，士人有饥色，樵苏后爨，师不宿饱。","book":"《史记·准阴侯列传》"},"example":{"text":"但臣闻千里馈粮，士有饥色，～，师不宿饱，他敢远道至此，必利在速战。","book":"蔡东藩《前汉演义》第二十五回"}},{"id":27163,"word":"樵苏失爨","pinyin":"qiáo sū shī cuàn","abbr":"qssc","explanation":"虽有柴草，却无米为炊。指非常贫困。","source":{"text":"冠栉懒施高枕，樵苏失爨清淡。","book":"清·吴伟业《偶成》诗之十二"},"similar":["樵苏不爨"],"usage":"作谓语、定语；指生活贫困"},{"id":27164,"word":"樽俎折冲","pinyin":"zūn zǔ zhé chōng","abbr":"zzzc","explanation":"指不以武力而在宴席交谈中制胜敌人。后泛指外交谈判活动。折冲，使敌人战车后撤，指击退敌军。","source":{"text":"语出汉·刘向《新序·杂事一》"},"example":{"text":"今吾国以存亡关系而不签字，各国当能见谅，必可留作悬案，为他日～之馀地。","book":"《“五四”爱国运动资料·学界风潮记下编》"},"similar":["折冲樽俎","尊俎折冲","折冲尊俎"],"usage":"作谓语、定语；用于书面语"},{"id":27165,"word":"樽前月下","pinyin":"zūn qián yuè xià","abbr":"zqyx","explanation":"酒樽之前，月亮之下。指对酒赏月的悠闲情境。","source":{"text":"弟此节俗冗，焦头烂额，对月对酒皆不乐。樽前月下，尚有剥啄之声，如御十万敌，必须在家首先搪拒，竟无福前来望见颜色矣。","book":"清·龚自珍《与吴虹生书八》"},"usage":"作宾语、定语；指月下畅饮"},{"id":27166,"word":"樽酒论文","pinyin":"zūn jiǔ lùn wén","abbr":"zjlw","explanation":"一边喝酒，一边议论文章。","source":{"text":"何时一樽酒，重与细论文。","book":"唐·杜甫《春日忆李白》诗"},"example":{"text":"连年客里度初度，～第一遭。","book":"陈世宜《上巳社集是日值余初度》诗"},"similar":["尊酒论文"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":27167,"word":"橐甲束兵","pinyin":"tuó jiǎ shù bīng","abbr":"tjsb","explanation":"指脱去铠甲，收起兵器。同“櫜甲束兵”。","source":{"text":"过天子之城，宜橐甲束兵。","book":"战国·卫·吕不韦《吕氏春秋·悔过》"},"usage":"作谓语、宾语；指停战"},{"id":27168,"word":"橐驼之技","pinyin":"tuó tuó zhī jì","abbr":"ttzj","explanation":"指高明的栽培技艺。","source":{"text":"典出唐·柳宗元《种树郭橐驼传》。"},"example":{"text":"马塍艺花如艺粟，～名天下，往往发非时之品，真足以侔造化，通仙灵。","book":"明·田汝元《西湖游览志馀·术技名家》"},"usage":"作宾语；用于书面语"},{"id":27169,"word":"橘化为枳","pinyin":"jú huà wéi zhǐ","abbr":"jhwz","explanation":"比喻人由于环境的影响而变坏。","source":{"text":"婴闻之，橘生淮南则为橘，生于淮北则为枳，叶徒相似，其实味不同。所以然者何？水土异也。","book":"春秋·齐·晏婴《晏子春秋·杂下十》"},"example":{"text":"你知道“～”的道理吗？"},"usage":"作宾语、定语；比喻人由于环境的影响而变坏","story":["春秋时期齐国著名的外交家晏婴，因为个子矮小，相貌丑陋，经常遭到别人的歧视。有一次晏婴出使楚国，楚王故意羞辱说齐国人都是贼，晏婴认真地说：“橘树生长在淮南能结橘子，移到淮北结的果实就变成枳子了。”楚王无话可说"]},{"id":27170,"word":"橙黄桔绿","pinyin":"chéng huáng jú lǜ","abbr":"chjl","explanation":"橙子黄熟，桔子还绿。指秋天宜人的景色。","source":{"text":"一年好景君须记，最是橙黄桔绿时。","book":"宋·苏轼《赠刘景文》诗"},"example":{"text":"到了～的时候，到处都是丰收的景象。"},"similar":["橙黄橘绿"],"usage":"作定语；指秋季景物"},{"id":27171,"word":"橙黄橘绿","pinyin":"chéng huáng jú lǜ","abbr":"chjl","explanation":"指秋季景物。","source":{"text":"一年好景君须记，最是橙黄橘绿时。","book":"宋·苏轼《赠刘景文》诗"}},{"id":27172,"word":"橛守成规","pinyin":"jué shǒu chéng guī","abbr":"jscg","explanation":"拘守已有的规章制度。","source":{"text":"然则操斯文进退去取之枋者，其犹横分区域，橛守成规。","book":"黄人《序》"},"similar":["墨守成规"],"usage":"作谓语；指人守旧"},{"id":27173,"word":"橡皮钉子","pinyin":"xiàng pí dìng zǐ","abbr":"xpdz","explanation":"犹软钉子。比喻以婉转隐晦的方式进行斥责或拒绝。","source":{"text":"屠维岳第二次听出吴荪甫很挖苦他，也就回敬了一个橡皮钉子。","book":"茅盾《子夜》"},"example":{"text":"他碰了一个～就只好放弃了。"},"similar":["软钉子"],"usage":"作主语、宾语、定语；指软钉子"},{"id":27174,"word":"橡茹藿歠","pinyin":"xiàng rú huò chuò","abbr":"xrhc","explanation":"以橡实为饭，豆叶为羹。泛指饮食粗劣。","source":{"text":"贵而八珍九鼎之筵，贱而橡茹藿歠之室，莫不有待于味。","book":"明·方孝孺《味菜轩记》"},"similar":["橡饭菁羹"],"usage":"作宾语、定语；用于生活等"},{"id":27175,"word":"橡饭菁羹","pinyin":"xiàng fàn jīng gēng","abbr":"xfjg","explanation":"以橡实作饭，芜菁为羹。泛指饮食粗劣。","source":{"text":"或橡饭菁羹，惟日不足；或葭墙艾席，乐在其中。","book":"《梁书·安成王秀传》"},"example":{"text":"～，笑谋生之太简。","book":"唐·陆龟蒙《幽居赋》"},"similar":["橡茹藿歠"],"opposite":["山珍海味"],"usage":"作宾语、定语；用于生活等"},{"id":27176,"word":"檀郎谢女","pinyin":"tán láng xiè nǚ","abbr":"tlxn","explanation":"檀郎：晋代潘岳小名檀奴，姿仪美好；谢女：晋代谢道蕴，聪慧过人，代指才女。指才貌双全的夫妇或情侣。","source":{"text":"檀郎谢女眠何处，楼台月明燕夜语。","book":"唐·李贺《牡丹种曲》诗"},"similar":["郎才女貌"],"usage":"作宾语、定语；指才貌双全的夫妇"},{"id":27177,"word":"檄愈头风","pinyin":"xí yù tóu fēng","abbr":"xytf","explanation":"檄：檄文，古代官府用以征召、讨伐等的文书；愈：超过；头风：头痛病。比喻檄文尖锐辛辣。","source":{"text":"琳作诸书及檄，草成呈太祖，太祖先苦头风，是日疾发，卧读琳所作，翕然而起曰：‘此愈我病。’","book":"《典略》"},"usage":"作谓语、定语；指文章等"},{"id":27178,"word":"檠天架海","pinyin":"qíng tiān jià hǎi","abbr":"qtjh","explanation":"形容本领大，能力非凡。","source":{"text":"我是个出水金精兽，稳情取檠天架海梁。","book":"明·无名氏《大劫牢》第一折"},"similar":["擎天架海"],"usage":"作谓语、定语；用于人的能力"},{"id":27179,"word":"櫜弓卧鼓","pinyin":"gāo gōng wò gǔ","abbr":"ggwg","explanation":"藏弓息鼓。指战事停息，天下太平。","source":{"text":"弛使四夷，复其爵号。然后还师振旅，櫜弓卧鼓。申命百姓，各安其所。","book":"《后汉书·隗嚣传》"},"example":{"text":"群凶破殄，始有～之次，宜得名儒，典综礼纪。","book":"《后汉书·儒林传下·谢该》"},"similar":["櫜弓戢矢","櫜甲束兵"],"usage":"作谓语、宾语、定语；指休战"},{"id":27180,"word":"櫜弓戢戈","pinyin":"gāo gōng jí gē","abbr":"ggjg","explanation":"指收藏干戈弓矢。后指停息战事。","source":{"text":"载戢干戈，载櫜弓矢。","book":"《诗·周颂·时迈》"},"example":{"text":"是以未获从命，～。","book":"《后汉书·袁术传》"},"similar":["櫜弓戢矢"],"usage":"作谓语、宾语、定语；指休战"},{"id":27181,"word":"櫜弓戢矢","pinyin":"gāo gōng jí shǐ","abbr":"ggjs","explanation":"《诗·周颂·时迈》：“载戢干戈，载櫜弓矢。”","source":{"text":"比年各省用兵，胜负无常，得失互见，诸臣何不以事元把握为虑，而亟欲～耶？ ★清·夏燮《中西纪事·剿抚异同》"},"similar":["櫜弓戢戈"],"usage":"作谓语、宾语、定语；指休战"},{"id":27182,"word":"櫜甲束兵","pinyin":"gāo jiǎ shù bīng","abbr":"gjsb","explanation":"指脱去铠甲，收起兵器。","source":{"text":"《左传·僖公三十三年》“秦师轻而无礼”唐孔颖达疏：“《吕氏春秋》说此事云：‘师行过周，王孙满曰：过天子之城，宜櫜甲束兵，左右皆下。’”今本《吕氏春秋·悔过》作“橐甲束兵”。"},"similar":["櫜弓卧鼓","櫜弓戢戈"],"usage":"作谓语、宾语、定语；指休战"},{"id":27183,"word":"欠债还钱","pinyin":"qiàn zhài huán qián","abbr":"qzhq","explanation":"欠了债要还钱。","source":{"text":"既是不关亲，你岂不闻得‘杀人偿命，欠债还钱’？","book":"明·凌濛初《初刻拍案惊奇》卷三十三"},"example":{"text":"咱们也不用欺侮他。只不过杀人偿命，～，那是天公地道的事。","book":"金庸《鹿鼎记》第四十七回"}},{"id":27184,"word":"欢呼雀跃","pinyin":"huān hū qué yué","abbr":"hhqy","explanation":"高兴得象麻雀一样跳跃。形容非常欢乐。","source":{"text":"鸿蒙方将拊髀雀跃而游。","book":"庄周《庄子·在宥》"},"example":{"text":"消息传来，大家立刻～起来。"},"similar":["欢喜若狂","欢欣鼓舞","兴高采烈"],"opposite":["愁眉苦脸","肝肠寸断","黯然销魂"],"usage":"作谓语、定语、状语；指非常欢乐"},{"id":27185,"word":"欢呼雷动","pinyin":"huān hū léi dòng","abbr":"hhld","explanation":"欢呼的声音像雷一样响着。形容热烈欢乐的气氛。","source":{"text":"万民欢呼雷动，起于白骨，即未受灾之年，亦未能如此之一饱也。","book":"清·黄宗羲《大方伯马公救灾颂》"},"example":{"text":"曾朴《孽海花》第23回：“只听那梨花林边，一个大孩子领了八九个狂童，～。”"},"similar":["欢声雷动","欢声如雷"],"usage":"作谓语、定语；形容极其欢乐的气氛"},{"id":27186,"word":"欢呼鼓舞","pinyin":"huān hū gǔ wǔ","abbr":"hhgw","explanation":"形容欢乐兴奋之极。","source":{"text":"去岁扈从南郊，亲见百姓父老，瞻望圣颜，欢呼鼓舞，或至感泣。","book":"宋·苏轼《缴进免五谷力胜税钱议札子》"},"example":{"text":"诸州之民，～，始知有父子生聚之乐。","book":"元·张光祖《言行龟鉴·民政》"},"usage":"作谓语；指高兴"},{"id":27187,"word":"欢喜冤家","pinyin":"huān xǐ yuān jiā","abbr":"hxyj","explanation":"表示又爱又恨的意思。小说戏曲中多用作对情人或儿女的亲热称呼。","source":{"text":"五百年欢喜冤家，正好星前月下。","book":"元·乔吉《小令·赠朱翠英》"},"example":{"text":"～，惹得一向愚痴，恰如飞蛾投火，身焦烂，犹自迷迷。","book":"元·马钰《满庭芳·自咏》词"},"usage":"作主语、宾语；用作对情人或儿女的亲热称呼"},{"id":27188,"word":"欢喜若狂","pinyin":"huān xǐ ruò kuáng","abbr":"hxrk","explanation":"欢喜：高兴的样子。高举得象发狂一样。","source":{"text":"老人欢喜若狂，可是马上又有些失望地打量他们。","book":"冯德英《苦菜花》第19章"},"example":{"text":"申奥成功，人们～。"},"similar":["欢欣若狂","欢呼雀跃"],"opposite":["肝肠寸断","愁眉苦脸"],"usage":"作谓语、状语；指非常高兴"},{"id":27189,"word":"欢声如雷","pinyin":"huān shēng rú léi","abbr":"hsrl","explanation":"欢笑的声音象雷一样响着。形容热烈欢乎的场面。","source":{"text":"欢声雷动，喜气云腾。","book":"唐·令狐楚《贺敕表》"},"example":{"text":"军中感越王爱才之德，～。","book":"明·冯梦龙《东周列国志》第八十三回"},"similar":["欢声雷动","欢呼雷动"],"usage":"作谓语、定语；形容极其欢乐的气氛"},{"id":27190,"word":"欢声笑语","pinyin":"huān shēng xiào yǔ","abbr":"hsxy","explanation":"欢乐的说笑声。","example":{"text":"我们的课堂里洋溢着一片～。"},"similar":["欢歌笑语"],"usage":"作宾语、定语；指快乐的说笑声"},{"id":27191,"word":"欢声雷动","pinyin":"huān shēng léi dòng","abbr":"hsld","explanation":"欢笑的声音象雷一样响着。形容热烈欢乎的动人场面。","source":{"text":"欢声雷动，喜气云腾。","book":"唐·令狐楚《贺敕表》"},"example":{"text":"这里众位也有坐轿的，也有走的，见两边百姓，扶老携幼，挨挤着来看，～。","book":"清·吴敬梓《儒林外史》第三十七回"},"similar":["欢声如雷","喜气云腾"],"opposite":["鸦雀无声","怒气冲天","闷闷不乐"],"usage":"作谓语、定语；形容极其欢乐的气氛"},{"id":27192,"word":"欢天喜地","pinyin":"huān tiān xǐ dì","abbr":"htxd","explanation":"形容非常高兴。","source":{"text":"我现将著夫人诰欶，县君名称，怎生待欢天喜地，两只手儿亲付与他。","book":"元·王实甫《西厢记》第五本第四折"},"example":{"text":"刚才二奶奶从老太太屋里出来，不似往日～的，叫了平儿，唧唧咕咕的不知说了些什么。","book":"清·曹雪芹《红楼梦》第六十七回"},"similar":["欢欣鼓舞"],"opposite":["切肤之痛","哀痛欲绝","愁眉苦脸"],"usage":"作谓语、定语、状语；指非常高兴"},{"id":27193,"word":"欢娱嫌夜短","pinyin":"huán yú xián yè dǎn","abbr":"hyxyd","explanation":"形容欢乐之时，时间过得很快。","source":{"text":"须不是欢娱嫌夜短，早难道寂寞恨更长。","book":"明·罗贯中《风云会》第三折"},"example":{"text":"自古道：“～，寂寞恨更长。”","book":"清·曾朴《孽海花》第七回"},"opposite":["寂寞恨更长"],"usage":"作宾语、定语；用于感慨"},{"id":27194,"word":"欢忭鼓舞","pinyin":"huān biàn gǔ wǔ","abbr":"hbgw","explanation":"形容欢乐振奋，感情激动。同“欢忻鼓舞”。"},{"id":27195,"word":"欢忻踊跃","pinyin":"huān xīn yǒng yuè","abbr":"hxyy","explanation":"忻：同“欣”。欢乐热烈的样子。","source":{"text":"今天顺人应，诞登大宝，天下生民莫不欢忻踊跃，引领盛治。","book":"《元史·窦默传》"},"similar":["欢欣踊跃"],"usage":"作谓语、定语、状语；用于场面"},{"id":27196,"word":"欢忻鼓舞","pinyin":"huān xīn gǔ wǔ","abbr":"hxgw","explanation":"形容欢乐振奋，感情激动。","source":{"text":"因名以劝实，因文以全质，而天下欢忻鼓舞于敦实崇质之中，以不荡其心。","book":"清·王夫之《读通鉴论·三国十六》"},"example":{"text":"商民均～，启门照常营业。","book":"张难先《都督府之组织设施及人选》"},"similar":["欢欣鼓舞"],"usage":"作谓语、宾语、定语；指非常高兴"},{"id":27197,"word":"欢欢喜喜","pinyin":"huān huān xǐ xǐ","abbr":"hhxx","explanation":"指十分高兴与愉悦。","source":{"text":"众人仍又欢欢喜喜的入席饮酒，分外欢畅，说了几许时话，吃了几多时酒。","book":"清·褚人获《隋唐演义》第24回"},"example":{"text":"王朔《无人喝彩》：“不说八抬大轿，也得请几桌客放几挂鞭，然后～入洞房。”"},"similar":["高高兴兴"],"usage":"作定语、状语；用于人的情绪等"},{"id":27198,"word":"欢欣若狂","pinyin":"huān xīn ruò kuáng","abbr":"hxrk","explanation":"形容高兴到了极点。","source":{"text":"当变法的诏书一道道地传来的时候，我们这些赞成变法的人，真是欢欣若狂。","book":"吴玉章《辛亥革命》"},"example":{"text":"听到这个好消息，人们～。"},"similar":["欢喜若狂"],"usage":"作谓语、状语；指非常高兴"},{"id":27199,"word":"欢欣踊跃","pinyin":"huān xīn yǒng yuè","abbr":"hxyy","explanation":"形容欢乐热烈、积极参与的样子。","source":{"text":"外嘉郎君谦下之德，内幸顽才见诚知己，欢欣踊跃，情有无量。","book":"三国·魏·应璩《与满公琰书》"},"example":{"text":"今天顺人应，诞登大宝，天下生民莫不～，引领盛治。","book":"《元史·窦默传》"},"similar":["欢忻踊跃"],"usage":"作谓语、定语、状语；用于场面"},{"id":27200,"word":"欢欣鼓舞","pinyin":"huān xīn gǔ wǔ","abbr":"hxgw","explanation":"欢欣：欣喜；鼓舞：振奋。形容高兴而振奋。","source":{"text":"自公始至，释其重荷……是故莫不欢欣鼓舞之至。","book":"宋·苏轼《上知府王龙图书》"},"example":{"text":"但在革命成功了的当时，我们一般的人是怎样地～哟！","book":"郭沫若《少年时代·反正前后》"},"similar":["兴高采烈","欣喜若狂","喜气洋洋"],"opposite":["黯然销魂","肝肠寸断","愁眉苦脸"],"usage":"作谓语、宾语、定语；指非常高兴"},{"id":27201,"word":"欢眉大眼","pinyin":"huān méi dà yǎn","abbr":"hmdy","explanation":"形容眉开眼笑，十分高兴的样子。","source":{"text":"凤兰欢眉大眼的坐在贵德的旁边。","book":"谷峪《新事新办》"},"example":{"text":"凤兰～的坐在贵德的旁边。","book":"谷峪《新事新办》"},"similar":["眉开眼笑"],"usage":"作定语、状语；用于人喜悦时"},{"id":27202,"word":"欢聚一堂","pinyin":"huān jù yī táng","abbr":"hjyt","explanation":"欢乐地聚集在一起。","source":{"text":"如今众位仁兄贤弟欢聚一堂，把往日的豪强自雄，侮慢英贤，不觉的可耻又可笑了。","book":"清·石玉昆《三侠五义》第一百二十回"},"example":{"text":"人们～，庆祝春节。"},"opposite":["各奔东西"],"usage":"作谓语；指团聚"},{"id":27203,"word":"欢苗爱叶","pinyin":"huān miáo ài yè","abbr":"hmay","explanation":"欢：欢喜。指欢乐恩爱的感情。","source":{"text":"单则为一点情根，种出那欢苗爱叶。","book":"清·洪昇《长生殿·补恨》"},"usage":"作宾语、定语；指人的情感"},{"id":27204,"word":"欢若平生","pinyin":"huān ruò píng shēng","abbr":"hrps","explanation":"平生：平素，平常。形容久已相识的人在特殊的情况下见面，欢乐融洽的气氛就如往常一样。","source":{"text":"鲔在城上，彭在城下，相劳苦，欢语如平生。","book":"《后汉书·岑彭传》"},"example":{"text":"秦王一见，～，日日设宴相待。","book":"明·冯梦龙《东周列国志》第九十八回"},"usage":"作状语；指像平素久以相交一样地欢乐"},{"id":27205,"word":"欢蹦乱跳","pinyin":"huān bèng luàn tiào","abbr":"hblt","explanation":"形容健康活泼、快乐无忧的样子。","source":{"text":"匀出你们欢蹦乱跳这俩去买瓦；留下房上滚下来的和炉坑里掏出来的那俩，先把这院子破瓦拣开。","book":"清·文康《儿女英雄传》第三十二回"},"example":{"text":"大伙怀着～的尽情，迎接果实成熟的季节的到来。","book":"周立波《暴风骤雨》第一部十七"},"similar":["手舞足蹈"],"usage":"作谓语、定语；形容活泼欢乐的景象"},{"id":27206,"word":"欢迸乱跳","pinyin":"huān bèng luàn tiào","abbr":"hblt","explanation":"形容活泼、欢乐之极。","source":{"text":"匀出你们欢迸乱跳这俩去买瓦；留下房上滚下来的，合炉坑里掏出来的那俩，先把这院子破瓦拣开，院子给人家打扫干净了，也省得人家含怨。","book":"清·文康《儿女英雄传》第三十二回"},"similar":["欢蹦乱跳"],"usage":"作谓语、定语；形容活泼欢乐的景象"},{"id":27207,"word":"欣喜若狂","pinyin":"xīn xǐ ruò kuáng","abbr":"xxrk","explanation":"欣喜：快乐；若：好像；狂：失去控制。形容高兴到了极点。","source":{"text":"少年得其应答，惊喜若狂。","book":"清·霁园主人《夜谭随录·护军女》"},"example":{"text":"全班同学～，向取得第一名的同学庆祝。"},"similar":["欢天喜地","喜不自禁","喜出望外"],"opposite":["肝肠寸断","心如刀割","痛不欲生"],"usage":"作谓语、定语、状语；形容人的狂喜心情"},{"id":27208,"word":"欣喜雀跃","pinyin":"xīn xǐ què yuè","abbr":"xxqy","explanation":"喜悦得像鸟雀那样跳跃。","source":{"text":"宋江闻报，把那忧国家，哭兄弟的病症，退了九分九厘，欣喜雀跃，同众将拔寨都起。","book":"明·施耐庵《水浒全传》第一百八回"},"usage":"作谓语、状语；用于处事"},{"id":27209,"word":"欣欣向荣","pinyin":"xīn xīn xiàng róng","abbr":"xxxr","explanation":"欣欣：形容草木生长旺盛；荣：茂盛。形容草木长得茂盛。比喻事业蓬勃发展，兴旺昌盛。","source":{"text":"木欣欣以向荣，泉涓涓而始流。","book":"晋·陶潜《归去来辞》"},"example":{"text":"在其间～的，只有鲜花和绿草，这是比喻对于将来的希望。","book":"叶圣陶《搭班子》"},"similar":["朝气蓬勃","方兴未艾","蒸蒸日上"],"opposite":["日暮途穷","每况愈下","死气沉沉"],"usage":"作谓语、定语、状语；指事业等","story":["东晋大诗人陶渊明曾担任江州祭酒、彭泽县令等官职，他对当时朝廷的官场黑暗非常不满，表示不愿为五斗米而折腰。公元405年，他毅然辞官回乡，在回乡的途中，他把路途所见所闻写成《归去来辞》，描写欣欣向荣的春天的景象"]},{"id":27210,"word":"欣欣自得","pinyin":"xīn xīn zì dé","abbr":"xxzd","explanation":"犹言欣然自得。心情舒适、自觉得意的样子。","source":{"text":"朱源在灯下细观其貌，比前更加美丽，欣欣自得。","book":"明·冯梦龙《醒世恒言》卷三十六"},"similar":["忻忻得意"],"usage":"作谓语、定语、状语；用于人的心情等"},{"id":27211,"word":"欣然命笔","pinyin":"xīn rán mìng bǐ","abbr":"xrmb","explanation":"命笔：提笔书写。指高兴地提笔写作。","source":{"text":"微风拂煦，旭日临窗，遥望南天，欣然命笔。","book":"毛泽东《七律二首·送瘟神》序"},"example":{"text":"遥望南天，～。","book":"毛泽东《七律二首·送瘟神》序"},"usage":"作谓语、定语；指写作"},{"id":27212,"word":"欣然自乐","pinyin":"xīn rán zì lè","abbr":"xrzl","explanation":"欣然：愉悦，高兴。指高兴地自觉喜悦。","source":{"text":"而渔父避世隐身，钓鱼江滨，欣然自乐。","book":"汉·王逸《鱼父章句序》"},"similar":["欣然自得","欣然自喜"],"usage":"作谓语、定语、状语；用于人的心情等"},{"id":27213,"word":"欣然自喜","pinyin":"xīn rán zì xǐ","abbr":"xrzx","explanation":"欣然：愉悦，高兴。指高兴地自觉喜悦。","source":{"text":"秋水时至，百川灌河，泾流之大，两涘渚崖之间，不辨牛马，于是焉河伯欣然自喜，以天下之美为尽在己。","book":"《庄子·秋水》"},"similar":["欣然自得","欣然自乐"],"usage":"作谓语、定语、状语；用于人的心情等"},{"id":27214,"word":"欣然自得","pinyin":"xīn rán zì dé","abbr":"xrzd","explanation":"心情舒适、自觉得意的样子。","source":{"text":"遂杜绝交游，不荅候问之礼。士友常以此短之，而丕欣然自得。","book":"《后汉书·鲁丕传》"},"example":{"text":"交游，日晏未炊，～。","book":"《明史·郑善夫传》"},"similar":["欣然自乐","欣然自喜"],"usage":"作谓语、定语、状语；用于人的心情等"},{"id":27215,"word":"欣生恶死","pinyin":"xīn shēng wù sǐ","abbr":"xses","explanation":"欣：喜悦。贪恋生存，畏惧死亡。","source":{"text":"一切众生，贪着有为，欣生恶死。意虽求生，由造死业。不持戒行，假使长寿，犹如老树，有何殊别。","book":"宋·张君房《云笈七签》卷三十八"},"similar":["贪生怕死"],"usage":"作谓语、定语；用于书面语"},{"id":27216,"word":"欧风墨雨","pinyin":"ōu fēng mò yǔ","abbr":"ofmy","explanation":"比喻来自欧美的思想文化等方面的侵袭。","source":{"text":"欧风墨雨，凓摇吾室家者，旦夕且至矣，而何暇于从容立宪为？","book":"各生《利用中国之政教论》"},"similar":["欧风美雨"],"usage":"作宾语、定语；指欧美的侵略"},{"id":27217,"word":"欧风美雨","pinyin":"ōu fēng měi yǔ","abbr":"ofmy","explanation":"①比喻欧美的政治、经济和文化。②比喻欧美的侵略。","source":{"text":"乃天下弃此优秀众大之民族，其始也得欧风美雨之吹沫；其继也得东邻维新之唤起。","book":"孙中山《民族主义》第一讲"},"example":{"text":"嗟夫！～，咄咄逼人推原祸始，是谁之咎？","book":"清·秋瑾《自拟檄文》之二"},"similar":["欧风墨雨","美雨欧风"],"usage":"作宾语、定语；指欧美的侵略"},{"id":27218,"word":"欱野喷山","pinyin":"ē yě pēn shān","abbr":"hyps","explanation":"欱：吮进，吮吸；喷：吹气。将原野吸进，把山岳吹动。比喻气魄、声势极大。","source":{"text":"吐爓生风，欱野歕山。","book":"汉·班固《东都赋》"},"example":{"text":"荧惑先列，招摇在上，隐天而动地，欱野而歕山。","book":"唐·杨炯《少室山少姨庙碑》"}},{"id":27219,"word":"欱野歕山","pinyin":"hē yě pēn shān","abbr":"hyps","explanation":"欱：吮吸；歕：同“喷”，吹气。吮吸原野，吹动山岳。比喻气势盛大。","source":{"text":"吐焰生风，欱野歕山。","book":"汉·班固《东都赋》"},"usage":"作谓语、定语；用于书面语"},{"id":27220,"word":"欲不可纵","pinyin":"yù bù kě zòng","abbr":"ybkz","explanation":"欲：欲望；纵：放纵。欲望不可以放纵。","source":{"text":"敖不可长，欲不可从，志不可满，乐不可极。","book":"《礼记·曲礼上》"},"example":{"text":"乐不可极，极乐生哀；～，纵欲成灾。","book":"《旧唐书·文苑传·张蕴古》"},"usage":"作宾语、定语；用于劝诫人"},{"id":27221,"word":"欲人勿知，莫若勿为","pinyin":"yù rén wù zhī，mò ruò wù wéi","abbr":"yrwzmrww","explanation":"想要别人不知道，不如自己不去做（多指坏事）。","source":{"text":"谚曰：‘欲人勿知，莫若勿为。’声无细而弗闻，事未形而必彰者，其此之谓也。","book":"《汉书·枚乘传》：“欲人勿闻，莫若勿言；欲人勿知，莫若勿为。”《晋书·苻坚载记上》"},"example":{"text":"《晋书·符坚载记上》：“谚曰：‘～。’声无细而弗闻，事未形而必彰者，其此之谓也。”"},"similar":["要想人不知，除非己莫为"],"usage":"作宾语、定语；用于书面语"},{"id":27222,"word":"欲人勿闻，莫若勿言","pinyin":"yù rén wù wén，mò ruò wù yán","abbr":"yrwwmrwy","explanation":"想要别人不听见，不如自己不讲出口。","source":{"text":"欲人勿闻，莫若勿为；欲人勿知，莫若勿为","book":"汉·刘向《说苑·谈丛》：“欲人勿知，莫若勿为；欲人勿闻，莫若勿言。”汉·枚乘《上书谏吴王》"},"example":{"text":"语云：“～。”陛下诚宜翻然自省，加意培养。","book":"《明史·邹元标传》"},"usage":"作宾语、定语；用于书面语"},{"id":27223,"word":"欲令智昏","pinyin":"yù lìng zhì hūn","abbr":"ylzh","explanation":"欲：欲望，贪欲；令：使；智：理智；昏：昏乱，神智不清。因贪心太大而失去理智，把什么都忘了。","source":{"text":"自古道欲令智昏，贾琏只顾贪图二姐美色，听了贾蓉一篇话，遂为计出万全，将现今身上有服，并停妻再娶，严父妒妻种种不妥之处，皆置之度外了。","book":"清·曹雪芹《红楼梦》第六十四回"},"example":{"text":"这几句话传入耳中，不由得心如刀剜，自忖一时～，铸成大错。","book":"金庸《神雕侠侣》第二十七回"}},{"id":27224,"word":"欲加之罪","pinyin":"yù jiā zhī zuì","abbr":"yjzz","explanation":"欲：要。想要给人加上个罪名。指随心所欲地诬陷人。","source":{"text":"不有废也，君何以兴？欲加之罪，其无辞乎？","book":"《左传·僖公十年》"},"example":{"text":"僧孺数为德裕掎摭，～，但以僧孺贞方有素，人望式瞻，无以伺其隙。","book":"《旧唐书·牛僧孺传》"},"similar":["欲加之罪，何患无辞"],"usage":"作宾语；指给人强加罪名"},{"id":27225,"word":"欲加之罪，何患无辞","pinyin":"yù jiā zhī zuì，hé huàn wú cí","abbr":"yjzzhhwc","explanation":"欲：要；患：忧愁，担心；辞：言辞，指借口。要想加罪于人，不愁找不到罪名。指随心所欲地诬陷人。","source":{"text":"不有废也，君何以兴？欲加之罪，其无辞乎？","book":"《左传·僖公十年》"},"example":{"text":"“可是，老徐，李自成没有什么罪名，咱们收拾了他，对别人怎么说呀？”“～！”","book":"姚雪垠《李自成》第二卷第二十七章"},"similar":["欲加之罪"],"usage":"作宾语、分句；指给人强加罪名","story":["春秋时期，晋献公宠信骊姬造成申生自杀，重耳与夷吾出逃，国内大乱。夷吾借助秦穆公的兵力回国继位，他对曾经杀死两位国君的里克采取拉拢的策略，又担心他会谋反，就赐死他。里克自知罪责难逃，说这是欲加之罪，何患无辞"]},{"id":27226,"word":"欲取姑与","pinyin":"yù qǔ gū yǔ","abbr":"yqgy","explanation":"姑：暂且；与：给与。要想夺取他，得暂且先给他。指先付出代价以诱使对方放松警惕，然后找机会夺取。","source":{"text":"将欲夺之，必固与之。","book":"春秋·楚·李耳《老子》第36章"},"example":{"text":"高阳《胡雪岩全传·萧瑟洋场》：“这是～的手法，亦未尝不可用。”"},"similar":["欲取故与"],"usage":"作谓语、定语；指对付人的策略","story":["春秋时期，晋国当权贵族智伯倚仗权势向魏桓子强行索要土地。魏桓子的谋士献计，同意给土地，这样智伯就会更加贪婪，再向其他贵族要地，其他贵族就会联合对付他，这叫“将欲取之，必姑与之”。后来智伯被贵族联合打败，魏桓子得到更多的土地"]},{"id":27227,"word":"欲取姑予","pinyin":"yù qǔ gū yǔ","abbr":"yqgy","explanation":"姑：暂且；与：给与。要想夺取他些什么，得暂且先给他些什么。指先付出代价以诱使对方放松警惕，然后找机会夺取。","source":{"text":"将欲夺之，必固与之。","book":"《老子·三十六章》"}},{"id":27228,"word":"欲吐辄止","pinyin":"yù tǔ zhé zhǐ","abbr":"ytzz","explanation":"辄：就。想把话说出来，又感觉有不便的地方，把话又咽了回去。","source":{"text":"心之耿耿，每欲与侍郎剧谈一番，而坐有他客，欲吐辄止。","book":"宋·陈亮《与章德茂侍郎四首》"}},{"id":27229,"word":"欲壑难填","pinyin":"yù hè nán tián","abbr":"yhnt","explanation":"欲：欲望；壑：深谷。形容欲望象深谷一样，很难填满。指贪心重，没法满足。","source":{"text":"叔鱼生其母视之，曰：‘是虎目而豕喙，鸢肩而牛腹，谿壑可盈，是不可餍也，必以贿死。’","book":"《国语·晋语八》"},"example":{"text":"衙门口人～，也不好太懦弱了，尽着他们的口胃，他们得着口胃，就咽不满的馋涎了。","book":"清·颐琐《黄绣球》第四回"},"similar":["贪得无厌","贪心不足","唯利是图"],"opposite":["不饮盗泉","一身清白","一尘不染"],"usage":"作谓语、定语；指人的欲望"},{"id":27230,"word":"欲得而甘心","pinyin":"yù dé ér gān xīn","abbr":"ydegx","explanation":"想要弄到手才称心满意（多用于对人的报复或打击）。","source":{"text":"敌人早就视定远、镇远为眼中钉，‘其所欲得而甘心者，亦惟定、镇二船’。","book":"戚其章《甲午战争史》第三章第二节"},"example":{"text":"且即使陈炯明之对于文积不能平，至于倒戈，则所～者，文一人之生命而已，而人民何与？","book":"蔡东藩《民国演义》第一百三十八回"}},{"id":27231,"word":"欲扬先抑","pinyin":"yù yáng xiān yì","abbr":"yyxy","explanation":"要发扬、放开，先控制、压抑。","example":{"text":"写文章经常采用欲扬先抑的手法。"},"opposite":["欲抑先扬"],"usage":"作谓语、定语、状语；用于写作"},{"id":27232,"word":"欲擒故纵","pinyin":"yù qín gù zòng","abbr":"yqgz","explanation":"擒：捉；纵：放。故意先放开他，使他放松戒备，充分暴露，然后再把他捉住。","source":{"text":"大人这里还不要就答应他，放出一个欲擒故纵的手段，然后许其成事。","book":"清·吴趼人《二十年目睹之怪现状》第七十回"},"example":{"text":"那时不但安公子怀疑，大约连读者此时也不免发闷，无如他著书的要作这等～的文章。","book":"清·文康《儿女英雄传》第十三回"},"similar":["欲取故予","诱敌深入"],"opposite":["放虎归山","养虎为患"],"usage":"作谓语、定语、宾语；指战略战术"},{"id":27233,"word":"欲洁何洁","pinyin":"yù jié hé jié","abbr":"yjhj","explanation":"洁：佛家主张的脱离凡俗的“净”。指想弃绝尘世，超脱现实，实际上不可能实现。也指明明不清白而硬说清白。","source":{"text":"欲洁何曾洁，云空未必空。可怜金玉质，终陷淖泥中。","book":"清·曹雪芹《红楼梦》第五回"}},{"id":27234,"word":"欲益反弊","pinyin":"yù yì fǎn bì","abbr":"yyfb","explanation":"犹言欲益反损。想把事情做好，结果反而弄坏。","source":{"text":"元凯于此，不独诬经，而其于《左传》，亦所谓欲益而反弊也。","book":"金·王若虚《五经辨惑上》"},"similar":["欲益反损"],"usage":"作宾语、定语；用于书面语"},{"id":27235,"word":"欲益反损","pinyin":"yù yì fǎn sǔn","abbr":"yyfs","explanation":"益：得益；损：损害。原想有所得益，结果反受损害。形容事与愿违。","source":{"text":"动而见尤，欲益反损。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"陛下耻为守文之士君，欲希奇功于事表；臣恐～，取累于手载也。","book":"鲁迅《古小说钩沉·汉武故事》"},"similar":["事与愿违","欲益反弊"],"usage":"作谓语、定语；指事与愿违"},{"id":27236,"word":"欲盖名彰","pinyin":"yù gài míng zhāng","abbr":"ygmz","explanation":"盖：遮掩；彰：明显。想掩盖坏事的真相，结果反而更明显地暴露出来。","source":{"text":"或求名而不得，或欲盖而名章，惩不义也。","book":"《左传·昭公三十一年》"}},{"id":27237,"word":"欲盖弥彰","pinyin":"yù gài mí zhāng","abbr":"ygmz","explanation":"盖：遮掩；弥：更加；彰：明显。想掩盖坏事的真相，结果反而更明显地暴露出来。","source":{"text":"或求名而不得，或欲盖而名章，惩不义也。","book":"《左传·昭公三十一年》"},"example":{"text":"与其～，倒不如自己先认了。","book":"闻一多《画展》"},"similar":["适得其反","欲盖而彰"],"opposite":["相得益彰"],"usage":"作谓语、宾语、定语；指适得其反","story":["春秋时期，齐国大臣崔杼谋杀齐庄公，为掩盖自己的罪行，强令记载历史的太史把齐庄公的死写成病死的，正直的太史如实记下“弑君”事实，崔杼杀了太史，太史的两个弟弟也是如此被杀害，结果弑君之罪没有掩盖，反而非常清楚暴露出来"]},{"id":27238,"word":"欲盖弥著","pinyin":"yù gài mí zhù","abbr":"ygmz","explanation":"盖：遮掩；弥：更加；著：明显。想掩盖坏事的真相，结果反而更明显地暴露出来。","source":{"text":"或求名而不得，或欲盖而名章，惩不义也。","book":"《左传·昭公三十一年》"},"example":{"text":"貌退让而心贪竞，外包容而中忮刻。私伪萌生，～。","book":"《明史·蔡时鼎传》"}},{"id":27239,"word":"欲盖而彰","pinyin":"yù gài ér zhāng","abbr":"ygez","explanation":"犹欲盖弥彰。","source":{"text":"昔孔子修《春秋》，而乱臣贼子知惧，抑使之求名不得，欲盖而彰者也。","book":"《隋书·宇文化及司马德戡等传序》"},"example":{"text":"世人～，欲抑而扬。","book":"明·刘基《郁离子·玄豹》"},"similar":["欲盖弥彰"],"usage":"作谓语、宾语、定语；指适得其反"},{"id":27240,"word":"欲穷千里目，更上一层楼","pinyin":"yù qióng qiān lǐ mù，gèng shàng yī céng lóu","abbr":"yqqlmgsycl","explanation":"穷：尽。想看得更远，就要上得更高一层楼。比喻站得越高，看得越远。","source":{"text":"白日依山尽，黄河入海流。欲穷千里目，更上一层楼。","book":"唐·王之涣《登鹳雀楼》"},"usage":"作宾语、定语、分句；用于书面语"},{"id":27241,"word":"欲罢不能","pinyin":"yù bà bù néng","abbr":"ybbn","explanation":"欲：想；罢：停，歇。要停止也不能停止。","source":{"text":"夫子循循善诱人，博我以文，约我以礼，欲罢不能。","book":"《论语·子罕》"},"example":{"text":"设或命运坎坷，从中别生枝节，拖延日久，虽要将就了事，～。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["骑虎难下"],"usage":"作谓语、宾语；指处境艰难","story":["春秋时期，颜回对老师孔子崇拜得五体投地。他赞扬孔子：越是抬头看他，越觉得他高大；越是钻研他的学问，越觉得他高深莫测。他总是有步骤地诱导我们学习各方面的知识，同时用一些规章制度和礼节来约束我们，让我们欲罢不能"]},{"id":27242,"word":"欲要人不知，除非己莫为","pinyin":"yù yào rén bù zhī，chú fēi jǐ mò wéi","abbr":"yyrbzcfjmw","explanation":"要想人家不知道，除非自己不去做。指干了坏事终究要暴露","source":{"text":"焉知晓欲要人不知，除非己莫为。","book":"清·石玉昆《小五义》第54回"},"example":{"text":"常言道：～。你好自为之吧"},"similar":["若要人不知，除非己莫为"],"usage":"作宾语、分句；用于劝诫人"},{"id":27243,"word":"欲言又止","pinyin":"yù yán yòu zhǐ","abbr":"yyyz","explanation":"想说又停止不说。形容有难言的苦衷。","source":{"text":"事在两难，欲言而止。","book":"明·冯梦龙《醒世恒言》第八卷"},"example":{"text":"语甚凄楚，惊问之，～者再。","book":"清·蒲松龄《聊斋志异》"},"similar":["首鼠两端","举棋不定","迟疑不决"],"opposite":["快人快语","心直口快","一针见血"],"usage":"作谓语、定语；形容有难言的苦衷"},{"id":27244,"word":"欲言无声","pinyin":"yù yán wú shēng","abbr":"yyws","explanation":"想要说出来又说不出来。","source":{"text":"猛然看是惠姑，眉眼动了几动，只显出欲言无声欲哭无泪的样子。","book":"冰心《最后的安息》"},"example":{"text":"翠儿的眼睛，慢慢的睁开了，猛然看是惠姑，眉眼动了几动，只显出～欲哭无泪的样子。","book":"冰心《最后的安息》"},"usage":"作谓语、定语；用于处事"},{"id":27245,"word":"欲说还休","pinyin":"yù shuō huán xiū","abbr":"yshx","explanation":"想说又没有说出来。形容情意复杂而又难以表达。","source":{"text":"而今识得愁滋味，欲说还休，欲说还休，却道天凉也个秋。","book":"宋·辛弃疾《丑奴儿·书博山道中壁》词"},"similar":["欲言又止"],"usage":"作谓语、定语；用于说话"},{"id":27246,"word":"欲谁归罪","pinyin":"yù shuí guī zuì","abbr":"ysgz","explanation":"将要归罪于谁呢？"},{"id":27247,"word":"欲速不达","pinyin":"yù sù bù dá","abbr":"ysbd","explanation":"欲：想要。想求快速，反而不能达到目的。","source":{"text":"无欲速，无见小利。欲速则不达，见小利则大事不成。","book":"春秋·鲁·孔丘《论语·子路》"},"example":{"text":"你这样做是～。"},"similar":["欲速则不达"],"opposite":["一蹴而就"],"usage":"作谓语、定语；用于劝诫人","story":["从前有个农夫挑一担桔子进城，天快黑了，他怕赶不到城门关闭前到达，心里十分着急，问对面来人能不能赶到。来人说慢慢走就到了，他一气就加快脚步，不料他一不小心就摔了一跤，桔子掉了一地，他只好去捡，结果天黑了还是没有进城"]},{"id":27248,"word":"欲速则不达","pinyin":"yù sù zé bù dá","abbr":"yszbd","explanation":"速：快；达：达到。指过于性急图快，反而不能达到目的。","source":{"text":"无欲速，无见小利。欲速则不达，见小利则大事不成。","book":"春秋·鲁·孔丘《论语·子路》"},"example":{"text":"‘～’，这不是说不要速，而是说不要犯盲动主义。","book":"毛泽东《文化工作中的统一战线》"},"similar":["欲速不达"],"opposite":["一蹴而就"],"usage":"作定语、分句；用于劝诫人","story":["春秋时期，孔子在年轻时当过赶马的车夫，从御术中的“起乘转合”中悟出许多人生道理，如“无欲速，无见小利。欲速则不达，见小利则大事不成。”他在周游列国的途中给弟子们讲述这些道理，子路笑他政治上到处碰壁，他用欲速则不达来推诿"]},{"id":27249,"word":"欲速反迟","pinyin":"yù sù fǎn chí","abbr":"ysfc","explanation":"速：快；迟：慢。指过于性急图快，反而不能很快达到目的。","source":{"text":"老来怯酬唱，欲速反成迟。","book":"《论语·子路》：“无欲速，无见小利。欲速则不达，见小利则大事不成。”宋·刘克庄《答陈璘司户》"}},{"id":27250,"word":"欷歔叹息","pinyin":"xī xū tàn xī","abbr":"xxtx","explanation":"欷歔：抽咽声。指低声叹气。","source":{"text":"说时不住的欷歔叹息。","book":"清·吴趼人《二十年目睹之怪现状》第65回"},"usage":"作谓语、状语；用于书面语"},{"id":27251,"word":"欷歔流涕","pinyin":"xī xū liú tì","abbr":"xxlt","explanation":"欷歔：同“唏嘘”，叹息，抽泣的声音。哭泣后不由自主地急促呼吸，抽搭。","source":{"text":"为曰：‘为人臣而不能保其主保全境土，心实悲惭，无颜早见耳。’言讫，欷歔泫涕。","book":"明·罗贯中《三国演义》第四十一回"},"example":{"text":"但是前清遗老旧臣们都～地遣责冯玉祥“不近人情”。","book":"陶菊隐《北洋军阀统治时期史话》第六十四章"},"usage":"作谓语、定语、状语；用于处事"},{"id":27252,"word":"欹嵚历落","pinyin":"qī qīn lì luò","abbr":"qqll","explanation":"形容品格独特，心地光明。","source":{"text":"欹嵚历落从人笑，潦倒粗疏我自真。","book":"金·元好问《李进之迂轩》诗之一"},"similar":["嵚崎历落","崎嵚历落"],"usage":"作谓语、定语；用于人的神貌"},{"id":27253,"word":"欹嵚磊落","pinyin":"qī qīn lěi luò","abbr":"yqll","explanation":"欹嵚：山高俊的样子。形容品格特异，心地光明。","source":{"text":"欹嵚历落从人笑，潦倒粗疏我自真。","book":"金·元好问《李进之适轩》"},"example":{"text":"元朝末年，出曾出了一个～的人，这人姓王名冕。","book":"清·吴敬梓《儒林外史》第一回"}},{"id":27254,"word":"欺三瞒四","pinyin":"qī sān mán sì","abbr":"qsms","explanation":"一再欺骗隐瞒。","source":{"text":"一闻之时，心头火起，大骂尤辰无理，做这等欺三瞒四的媒人，说骗人家女儿。","book":"明·冯梦龙《醒世恒言》卷七"},"example":{"text":"是一是二，说得明白，还有个商量；休要～，我赵某不是与你和光同尘的！","book":"明·冯梦龙《警世通言》卷二十一"},"usage":"作谓语、宾语、定语；指一再欺骗隐瞒"},{"id":27255,"word":"欺上压下","pinyin":"qī shàng yā xià","abbr":"qsyx","explanation":"欺骗上级，压制下级。","example":{"text":"有些当官的就是靠～来榨取民脂民膏。"},"similar":["瞒上欺下"],"usage":"作谓语、宾语、定语；指欺骗"},{"id":27256,"word":"欺上瞒下","pinyin":"qī shàng mán xià","abbr":"qsmx","explanation":"对上欺骗，博取信任；对下隐瞒，掩盖真相。","source":{"text":"忝官尸禄，欺上罔下，是臣之罪。","book":"唐·元结《奏免科率状》"},"example":{"text":"公文旅行，互相推诿，以至官气十足，动辄训人，打击报复，压制民主，～，专横跋扈，徇私行贿，贪","book":"邓小平《党和国家领导制度的改革》"},"similar":["欺上罔下"],"opposite":["上下不欺"],"usage":"作谓语、定语；指欺骗"},{"id":27257,"word":"欺上罔下","pinyin":"qī shàng wǎng xià","abbr":"qswx","explanation":"对上欺骗，博取信任；对下隐瞒，掩盖真相。","source":{"text":"忝官尸禄，欺上罔下，是臣之罪。","book":"唐·元结《奏免科率状》"},"example":{"text":"卢相～，倚势害物。","book":"宋·王辟之《渑水燕谈录·卢多逊》"},"similar":["欺上瞒下"],"usage":"作谓语、定语；指欺骗"},{"id":27258,"word":"欺世之言","pinyin":"qī shì zhī yán","abbr":"qszy","explanation":"欺骗人的话。","source":{"text":"若谓神仙混物，非凡人所能识，此乃欺世之言。","book":"明·余继登《典故继闻》卷二"}},{"id":27259,"word":"欺世乱俗","pinyin":"qī shì luàn sú","abbr":"qsls","explanation":"欺骗世人，破坏习俗。","source":{"text":"给事中王时升似朴实诈，足以欺世乱俗。","book":"宋·陈亮《吏部侍郎章公德文行状》"},"similar":["欺世惑俗"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":27260,"word":"欺世惑众","pinyin":"qī shì huò zhòng","abbr":"qshz","explanation":"欺骗世人，迷惑大众。指坏人以欺骗手段博得信任。","example":{"text":"政治家大多都以动听的言词～。"},"usage":"作谓语、宾语、定语；指以欺骗手段获得信用"},{"id":27261,"word":"欺世惑俗","pinyin":"qī shì huò sú","abbr":"qshs","explanation":"欺骗世人，破坏习俗。","source":{"text":"在思想革命的时期，一种学论初出世时，谁不受人非难，被诋为非圣无法，离经畔道，欺世惑俗，乃至处于极刑呢？","book":"郭沫若《惠施的思想与性格》"},"similar":["欺世乱俗"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":27262,"word":"欺世盗名","pinyin":"qī shì dào míng","abbr":"qsdm","explanation":"欺骗世人，窃取名誉。","source":{"text":"夫富贵者则类傲之；夫贫贱者则求柔之。是非仁人之情也，是奸人将以盗名于暗世者也，险莫大焉。","book":"《荀子·不苟》"},"example":{"text":"不知平日所讲何学，居然～。","book":"清·阮葵生《茶余客话》卷十"},"similar":["盗名欺世","欺世惑众","沽名钓誉"],"opposite":["名副其实"],"usage":"作谓语、宾语、定语；指欺骗世人","story":["西晋时期，王衍精通老子和庄子的哲学，晋武帝的丈人杨骏慕名想把女儿嫁他。但王衍不愿攀附权贵。他自命清高，绝不谈世俗之事，更不谈钱字。后来他的女儿成了愍怀太子的妃子。宫廷发生变故，他令自己的女儿离婚，人称他是假清高"]},{"id":27263,"word":"欺世罔俗","pinyin":"qī shì wǎng sú","abbr":"qsws","explanation":"罔：祸害。欺骗世人，祸害习俗。","source":{"text":"至于永建复统，则不能知，此皆欺世罔俗，以睐势位，情伪较然，莫之纠禁。","book":"汉·张衡《请禁绝图谶疏》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":27264,"word":"欺世钓誉","pinyin":"qī shì diào yù","abbr":"qsdy","explanation":"欺：欺骗；世：世人；誉：名声。欺骗世人，窃取名誉。","source":{"text":"世主亦苟取其名而强起之，不如所闻，则曰：‘是欺世钓誉者也。’","book":"《元史·隐逸传》"},"similar":["欺世盗名"],"usage":"作谓语、宾语、定语；指欺骗世人"},{"id":27265,"word":"欺主罔上","pinyin":"qī zhǔ wǎng shàng","abbr":"qzws","explanation":"指蒙骗主人或上司。","source":{"text":"谓贩鬻威权，奸自不露，欺主罔上，好议可掩。","book":"南朝·齐·沈冲《奏劾江谧》"},"similar":["欺君罔上"],"usage":"作谓语、定语；指欺骗蒙蔽君主"},{"id":27266,"word":"欺人之论","pinyin":"qī rén zhī lù","abbr":"qrzl","explanation":"欺骗人的话。","source":{"text":"若谓神仙混物，非凡人所能识，此乃欺世之言。","book":"明·余继登《典故继闻》卷二"},"example":{"text":"列公中有温柔乡里的惯家，脂粉场中的老手，一定也晓得这种情形，须不是在下～。","book":"清·张春帆《九尾龟》第三十回"}},{"id":27267,"word":"欺人之谈","pinyin":"qī rén zhī tán","abbr":"qrzt","explanation":"骗人的鬼话。","source":{"text":"你可晓得老爷是讲理学的人，凡事有则有，无则无，从不作欺人之谈的。","book":"清·李宝嘉《官场现形记》第二十二回"},"example":{"text":"他那番话，都是～，你不要上当。"},"similar":["迷人眼目","弥天大慌"],"opposite":["肺腑之言","金玉良言"],"usage":"作宾语；指骗人的鬼话"},{"id":27268,"word":"欺人以方","pinyin":"qī rén yǐ fāng","abbr":"qryf","explanation":"方：方正，正直。比喻用合乎人情的方法来欺骗人。","source":{"text":"故君子可欺以其方，难罔以非其道。","book":"《孟子·万章上》"}},{"id":27269,"word":"欺人太甚","pinyin":"qī rén tài shèn","abbr":"qrts","explanation":"欺负人太过分了，令人不能容忍。","source":{"text":"主公着他做了盟府，又与他一口宝剑，筵前举鼎，欺人太甚。","book":"元·郑廷玉《楚昭公》第四折"},"example":{"text":"郑彩使劲把匣子摔到地上，撕裂的嗓声，疯狂地大叫：“你们不要～。”","book":"华而实《汉衣冠》六"},"similar":["仗势欺人","狗仗人势"],"opposite":["童叟无欺","与人为善"],"usage":"作谓语、宾语、定语；指太过分","story":["春秋时期，鲁国政权被季孙氏、孟孙氏和叔孙氏三家控制，鲁定公成为一个傀儡，他听说孔子主张“君臣纲常”，召见孔子说季平子欺人太甚，不把国君放在眼里。孔子分析鲁国的内忧外患，建议他外联齐国，内部重振君威，制定了一系列措施"]},{"id":27270,"word":"欺人忒甚","pinyin":"qī rén tè shèn","abbr":"qrts","explanation":"甚：过分。欺负人太过分了，令人不能容忍。","source":{"text":"公子，你你……不要欺人忒甚哪！","book":"《逼上梁山》第一幕"},"similar":["欺人太甚"],"opposite":["童叟无欺"],"usage":"作谓语、宾语、定语；指太过分"},{"id":27271,"word":"欺人眼目","pinyin":"qī rén yǎn mù","abbr":"qrym","explanation":"用欺骗的手段骗取别人的信任。","example":{"text":"你这种～的手段太不高明了。"},"similar":["欺人耳目"],"usage":"作谓语、宾语、定语；指欺骗人"},{"id":27272,"word":"欺人自欺","pinyin":"qī rén zì qī","abbr":"qrzq","explanation":"自欺：自我欺骗。欺骗自己，也欺骗别人。","source":{"text":"因说自欺欺人曰：欺人亦是自欺，此又是自欺之甚者。","book":"宋·朱熹《朱子语类》卷十八"},"example":{"text":"宋·朱熹《朱子语类》卷十八：“因说自欺欺人曰：欺人亦是自欺，此又是自欺之甚者。”"},"similar":["自欺欺人","掩耳盗铃"],"usage":"作谓语、定语、宾语；指相互欺骗"},{"id":27273,"word":"欺以其方","pinyin":"qī yǐ qí fāng","abbr":"qyqf","explanation":"欺：欺骗；其方：合乎情理的方法。比喻坏人用合乎情理的方法欺骗别人。","source":{"text":"故君子可欺以其方，难罔以非其道。","book":"战国·邹·孟轲《孟子·万章上》"},"usage":"作谓语；指欺骗人","story":["春秋时期，有人给郑国大夫子产送一条活蹦乱跳的大鱼，子产舍不得杀了吃，就叫人把鱼放到池里去养。管池人偷偷把鱼煮吃了，然后告诉子产鱼开始不灵活，慢慢地游动，最后一溜烟游走了。子产高兴地说得其所哉，管池人欺以其方，心里偷着乐"]},{"id":27274,"word":"欺公罔法","pinyin":"qī gōng wǎng fǎ","abbr":"qgwf","explanation":"欺骗公众，无视法律。","source":{"text":"这一班光棍奴才，敢如此欺公罔法。","book":"明·凌濛初《初刻拍案惊奇》卷十"},"similar":["徇私舞弊"],"usage":"作谓语、定语；指欺骗公众，无视法律"},{"id":27275,"word":"欺君之罪","pinyin":"qī jūn zhī zuì","abbr":"qjzz","explanation":"欺骗君主的罪行。","source":{"text":"且煌煌天语，谁敢有违，以自取欺君之罪。","book":"明·许仲琳《封神演义》第二回"},"usage":"作主语、宾语；用于封建社会背景"},{"id":27276,"word":"欺君罔上","pinyin":"qī jūn wǎng shàng","abbr":"qjws","explanation":"欺骗蒙蔽君主。","source":{"text":"他待学欺君罔上曹丞相，不如俺葛巾漉酒陶元亮。","book":"元·杨朝英《叨叨令·叹世》曲"},"example":{"text":"你明明在～，窝匪通敌。","book":"郭沫若《高渐离》第三幕"},"similar":["欺君犯上"],"usage":"作谓语、定语；指欺骗蒙蔽君主"},{"id":27277,"word":"欺君误国","pinyin":"qī jūn wù guó","abbr":"qjwg","explanation":"欺骗君主，祸害国家。","source":{"text":"刘震这厮索强，前日弹我欺君误国，要将枭首示众。","book":"明·陆采《明珠记·奸谋》"},"example":{"text":"～任专权，罪恶而今达帝天。","book":"清·钱彩《说岳全传》第70回"},"similar":["祸国殃民"],"usage":"作谓语、定语；指祸害国家"},{"id":27278,"word":"欺善怕恶","pinyin":"qī shàn pà è","abbr":"qspe","explanation":"欺侮善良者，惧怕凶恶者。","source":{"text":"水族痴暗，人轻杀之，或云不能尝冤，是乃欺善怕恶。","book":"宋·苏轼《东坡志林》卷六"},"example":{"text":"田舍翁住在山圪落，恃老无端多凶恶，我每反被相辱没，～，～。","book":"明·杨柔胜《玉环记·韦皋别妻》"},"similar":["欺弱怕强"],"usage":"作谓语、定语；指人的性格"},{"id":27279,"word":"欺大压小","pinyin":"qī dà yā xiǎo","abbr":"qdyx","explanation":"欺骗强大的，压迫弱小的。","source":{"text":"为人雕心雁爪，做事欺大压小，全凭谄佞奸贪。","book":"元·马致远《汉宫秋》楔子"},"similar":["欺弱怕强"],"usage":"作谓语、定语；指欺负人"},{"id":27280,"word":"欺天罔人","pinyin":"qī tiān wǎng rén","abbr":"qtwr","explanation":"欺骗苍天，蒙蔽人民。","source":{"text":"而旬日之间，又有造为国是之说以应之者，其欺天罔人，包藏险慝，抑又甚焉。","book":"宋·朱熹《与陈侍郎书》"},"example":{"text":"当国者奸谋诡计，谬论作忠，以荧惑朝廷，～，惟己是利，陛下信彼方深，任彼方笃。","book":"清·毕沅《续资治通鉴》卷一百九十七"},"usage":"作谓语、定语、宾语；用于处事"},{"id":27281,"word":"欺天罔地","pinyin":"qī tiān wǎng dì","abbr":"qtwd","explanation":"欺骗天地神明。形容欺诈的手段非常高。","source":{"text":"这等穷儿乍富，瞒心昧己，欺天诳地，只要损别人，安自己。","book":"元·无名氏《看钱奴》第一折"},"example":{"text":"董卓～，灭国弑君。","book":"明·罗贯中《三国演义》第五回"},"similar":["欺天诳地"],"usage":"作谓语、定语；指极端欺诈"},{"id":27282,"word":"欺天诳地","pinyin":"qī tiān kuāng dì","abbr":"qtkd","explanation":"欺骗天地神明。形容极其欺诈之能事。","source":{"text":"这等穷儿乍富，瞒心昧己，欺天诳地，只要损别人，安自己。","book":"元·无名氏《看钱奴》第一折"},"similar":["欺天罔地"],"usage":"作谓语、定语；指极端欺诈"},{"id":27283,"word":"欺心诳上","pinyin":"qī xīn kuáng à","abbr":"qxks","explanation":"欺心：昧心；诳：欺骗，迷惑。指弄虚作假，欺骗上级或长者。","source":{"text":"你怎么强占水神之宅，倚势行凶，欺心诳上，弄玄虚，骗我师父师弟？","book":"明·吴承恩《西游记》第四十三回"}},{"id":27284,"word":"欺瞒夹帐","pinyin":"qī mán jiá zhàng","abbr":"qmjz","explanation":"欺骗营私。","source":{"text":"这是众人众事的事，万一有甚差池，他众人们只说我里头有甚么欺瞒夹帐的勾当。","book":"清·西周生《醒世姻缘传》第六十四回"},"similar":["营私舞弊"],"usage":"作谓语、宾语、定语；同“营私舞弊”"},{"id":27285,"word":"欺硬怕软","pinyin":"qī yìng pà ruǎn","abbr":"qypr","explanation":"不惧怕强硬的。","source":{"text":"我从来欺硬怕软，吃苦不甘，你休只因亲事胡扑掩。","book":"元·王实甫《西厢记》第二本楔子"},"similar":["吃硬不吃软"],"opposite":["欺软怕硬","吃软不吃硬"],"usage":"作谓语、宾语、定语；用于为人"},{"id":27286,"word":"欺罔视听","pinyin":"qī wǎng shì tīng","abbr":"qwst","explanation":"罔：蒙骗。欺骗人们的耳目。","source":{"text":"贪财冒贿，欺罔视听。","book":"《南史·朱异传》"},"similar":["欺人耳目"],"usage":"作谓语、宾语、定语；用于欺骗"},{"id":27287,"word":"欺良压善","pinyin":"qī liáng yā shàn","abbr":"qlys","explanation":"欺：欺负。欺压善良的人。","source":{"text":"欺良压善没分晓，揎拳捋袖行凶暴。","book":"元·杨景贤《马丹阳度脱刘行首》第二折"},"usage":"作谓语、宾语、定语；用于坏人"},{"id":27288,"word":"欺行霸市","pinyin":"qī háng bà shì","abbr":"qhbs","explanation":"欺压同行，称霸市场。","source":{"text":"老林他们就是这路人，低买高卖，欺行霸市，小型的‘欧佩克’。","book":"王朔《橡皮人》"},"example":{"text":"严禁～，囤积居奇，哄抬物价。"},"similar":["强买强卖"],"opposite":["公平买卖"],"usage":"作谓语、宾语、定语；指市场恶霸"},{"id":27289,"word":"欺贫爱富","pinyin":"qī pín ài fù","abbr":"qpaf","explanation":"欺侮贫穷，喜爱富有。","source":{"text":"有那等嫌贫爱富的儿曹辈，将俺这贫傲慢，把他那富追陪，那个肯恤孤念寡存仁义。","book":"元·关汉卿《裴度还带》"},"example":{"text":"我们不能干～的事。"},"similar":["嫌贫爱富"],"opposite":["劫富济贫"],"usage":"作谓语、定语；指欺侮贫穷，喜爱富有"},{"id":27290,"word":"欺贫重富","pinyin":"qī pín zhòng fù","abbr":"qpzf","explanation":"欺：欺负。欺负贫穷的人，尊重富有的人。","source":{"text":"又有一诗，说欺贫重富，世情皆然，不止一买臣之妻也。","book":"明·冯梦龙《喻世明言》第27卷"},"similar":["嫌贫爱富"],"usage":"作谓语、宾语、定语；用于为人"},{"id":27291,"word":"欺软怕硬","pinyin":"qī ruǎn pà yìng","abbr":"qrpy","explanation":"欺负软弱的，害怕强硬的。","source":{"text":"点催首放富差贫，保上户欺软怕硬。","book":"明·高明《琵琶记·五娘请粮被抢》"},"example":{"text":"不公道，～！有好差事派了别人；这样黑更半夜送人，就派我。","book":"清·曹雪芹《红楼梦》第七回"},"similar":["重富欺贫","厚此薄彼","畏强欺弱"],"opposite":["一视同仁","不偏不倚","不卑不亢"],"usage":"作谓语、定语；指人畏强欺弱","story":["春秋时期，宋襄公很想学齐桓公那样成为诸侯霸王，先是扶植公子昭回国即位成齐孝公，然后召集曹等小国在宋国开会，杀掉公子子则，请出楚成王召集其他诸侯在宋国开衣裳之会。在会上楚成王凭着自己的武力当上霸主，欺软怕硬的宋襄公自认倒霉"]},{"id":27292,"word":"欺霜傲雪","pinyin":"qī shuāng ào xuě","abbr":"qsax","explanation":"形容不畏霜雪严寒，外界条件越艰苦越有精神。比喻经过长期磨练，面对冷酷迫害或打击毫不示弱、无所畏惧。傲，傲慢、蔑视。","source":{"text":"傲雪凌霜，平欺寒力，搀借春光。","book":"宋·杨无咎《柳梢青》"},"example":{"text":"俺端的～志清高，看岩前斗巧，不比蓬蒿。","book":"明·无名氏《长生会》第三折"},"similar":["傲雪欺霜"],"usage":"作谓语、定语、宾语；形容意志坚定"},{"id":27293,"word":"款启寡闻","pinyin":"kuǎn qǐ guǎ wén","abbr":"kqgw","explanation":"款启：见识狭小。形容学问浅、见识少。","source":{"text":"今休，款启寡闻之民也。","book":"《庄子·达生》"},"similar":["款学寡闻"],"usage":"作谓语、定语；形容学问浅、见识少"},{"id":27294,"word":"款学寡闻","pinyin":"kuǎn xué guǎ wén","abbr":"kxgw","explanation":"形容学问浅、见识少。","source":{"text":"今休，款启寡闻之民也。","book":"战国·宋·庄周《庄子·达生》"},"example":{"text":"诚不意～之夫，得相抵掌。","book":"清·黄宗羲《答万充质疑书》"},"similar":["款启寡闻"],"usage":"作谓语、定语；形容学问浅、见识少"},{"id":27295,"word":"款曲周至","pinyin":"kuǎn qǔ zhōu zhì","abbr":"kqzz","explanation":"款曲：殷勤。待人殷勤，照顾周到细致。","source":{"text":"淮辄先使人推问其亲理，男女多少，年岁长幼，乃见，一一知其款曲，讯问周至。","book":"《三国志·魏志·郭淮传》"},"example":{"text":"接对宾客，皆～。","book":"《南史·齐废帝郁林王纪》"},"usage":"作谓语、定语；用于人际交往等"},{"id":27296,"word":"款款之愚","pinyin":"kuǎn kuǎn zhī yú","abbr":"kkzy","explanation":"款款：诚实。见解虽不高明，却是真心诚意的。","source":{"text":"诚欲效其款款之愚。","book":"战国·楚·屈原《卜居》：“吾宁悃悃款款朴以忠乎？”汉·司马迁《报任少卿书》"},"example":{"text":"锷等辱承恩礼，感切私衷，用敢再效～，为最后之忠告。","book":"丁中江《北洋军阀史话》七十八"}},{"id":27297,"word":"款款深深","pinyin":"kuǎn kuǎn shēn shēn","abbr":"kkss","explanation":"指情意诚挚深切。","example":{"text":"他～地走下讲台，同听众亲密接触。"},"usage":"作定语、状语；用于口语"},{"id":27298,"word":"款款而谈","pinyin":"kuǎn kuǎn ér tán","abbr":"kket","explanation":"款：诚恳。诚恳而从容的谈话。","source":{"text":"又兼看着九公有个师徒分际，褚大娘子有个姐妹情肠，才得这样款款而谈。","book":"清·文康《儿女英雄传》第25回"},"example":{"text":"他们～。"},"similar":["促膝谈心"],"usage":"作谓语；指诚恳而从容的谈话"},{"id":27299,"word":"款言不听","pinyin":"kuǎn yán bù tīng","abbr":"kybt","explanation":"款：通“窾”，空。对于不真实的话不要听信。","source":{"text":"其实中其声者谓之端，实不中其声者谓之款；款言不听，奸乃不生。","book":"东汉·班固《汉书·司马迁传》"},"usage":"作宾语、定语；指不听虚话"},{"id":27300,"word":"款语温言","pinyin":"kuǎn yǔ wēn yán","abbr":"kywy","explanation":"指诚恳而温和的言辞。","source":{"text":"宝玉见了这样，知难挽回，打叠起千百样的款语温言来劝慰。","book":"清·曹雪芹《红楼梦》第二十回"},"usage":"作主语、宾语；指亲切的话语"},{"id":27301,"word":"歃血为盟","pinyin":"shà xuè wéi méng","abbr":"sxwm","explanation":"歃血：古代会盟，把牲畜的血涂在嘴唇上，表示诚意；盟：宣誓缔约。泛指发誓订盟。","source":{"text":"毛遂谓楚王之左右曰：‘取鸡狗马之血来。’毛遂奉铜槃而跪进之楚王，曰：‘王当歃血而定从，次者吾君，次者遂。’","book":"《史记·平原君虞卿列传》"},"example":{"text":"说不定国王还要～呢，珠槃玉敦的准备也是不可少的。","book":"郭沫若《屈原》第二幕"},"similar":["对天盟誓","歃血而盟"],"opposite":["口血未干"],"usage":"作谓语、定语；指结盟"},{"id":27302,"word":"歃血为誓","pinyin":"shà xuè wéi shì","abbr":"sxws","explanation":"以牲血涂于口旁起誓，表示决心。","source":{"text":"受金液，经投金人八两于东流水中，歃血为誓，乃告之。","book":"《云笈七签》卷六七"},"example":{"text":"我自愿漆身吞炭，尝胆卧薪，同心协力期雪耻，须～，～。","book":"明·朱鼎《玉镱台记·新亭流涕》"},"similar":["歃血为盟","歃血而盟"],"usage":"作谓语、定语；指结盟"},{"id":27303,"word":"歃血而盟","pinyin":"shà xuè ér méng","abbr":"sxem","explanation":"泛指发誓订盟。同“歃血为盟”。","source":{"text":"诸将与之歃血而盟，赤辞信之。","book":"《旧唐书·李道彥传》"},"similar":["歃血为盟","歃血为誓"],"usage":"作谓语、定语；指结盟"},{"id":27304,"word":"歇斯底里","pinyin":"xiē sī dǐ lǐ","abbr":"xsdl","explanation":"情绪异常激动，举止失常。","source":{"text":"他甚至歇斯底里骂孩子，神经质抱住老婆哭鼻子。","book":"路遥《平凡的世界》第六卷第45章"},"example":{"text":"情绪异常激动，举止失常。"},"usage":"作宾语、定语、状语；用于口语"},{"id":27305,"word":"歌于斯，哭于斯","pinyin":"gē yǘ sī，kū yú sī","abbr":"gyskys","explanation":"歌唱在这里，哭泣在这里。指安居的家宅。","source":{"text":"晋献文子成室。晋大夫发焉。张老曰：‘美哉轮焉，美哉奂焉。歌于斯，哭于斯。’","book":"《礼记·檀弓下》"},"usage":"作分句；指安居的家宅","story":["晋文子赵武家里新落成一所房屋，晋国大夫张老去祝贺说：“美哉轮焉，美哉奂焉！歌于斯，哭于斯，聚国族于斯！”旁人十分惊讶。晋文子接上：“武也得歌于斯，哭于斯，聚国族于斯，是全腰领以从先大夫于九原也！”人称晋文子善颂善祷"]},{"id":27306,"word":"歌功颂德","pinyin":"gē gōng sòng dé","abbr":"ggsd","explanation":"歌、颂：颂扬。颂扬功绩和德行。","source":{"text":"民皆歌乐之，颂其德。","book":"《史记·周本纪》"},"example":{"text":"保持艰苦奋斗作风，制止～现象。","book":"毛泽东《党委会的工作方法》"},"similar":["交口称誉","有口皆碑","树碑立传"],"opposite":["怨声载道"],"usage":"作谓语、宾语、定语；指赞扬人"},{"id":27307,"word":"歌台舞榭","pinyin":"gē tái wǔ xiè","abbr":"gtwx","explanation":"榭：建筑在高台上的房屋。演奏乐曲、表演歌舞的场所。","source":{"text":"歌台舞榭宜正月，柳岸梅洲胜往年。","book":"唐·蔡孚《享乐池乐章》第二章"},"example":{"text":"～之间常常可以看到他们的足迹。","book":"田汉《影事追怀录》"},"similar":["歌楼舞榭"],"usage":"作宾语、定语；泛指歌舞场所"},{"id":27308,"word":"歌吟笑呼","pinyin":"gē yín xiào hū","abbr":"gyxh","explanation":"高歌低吟，狂笑欢呼。用来形容饮酒之后豪情流露。","source":{"text":"当其极饮大醉，歌吟笑呼，以适天下之乐，何其壮也。","book":"宋·欧阳修《释必演诗令序》"}},{"id":27309,"word":"歌声绕梁","pinyin":"gē shēng rào liáng","abbr":"gsrl","explanation":"绕：回旋；梁：房屋的大梁。歌声回旋于房梁之间。形容歌声优美动听。","source":{"text":"昔韩娥东之齐，匮粮，过雍门，鬻歌假食，既去，而余音绕梁欐，三日不绝。","book":"战国·郑·列御寇《列子·汤问》"},"example":{"text":"谒乃闻王母歌声，而不见其形，歌声～三匝，乃上旁梁。","book":"《洞冥记》"},"similar":["余音绕梁"],"usage":"作宾语、定语；形容歌声优美动听","story":["战国时期韩国歌女韩娥以卖唱为生，一天她到一家客栈去投宿，被店家赶出来，她只好在店外唱着如泣如诉的曲子，客人们感动得不吃不喝，店主无奈，只好请她住店唱歌。离店前她唱了欢快的曲子，三天后那悦耳的歌声还在客栈房梁上萦绕"]},{"id":27310,"word":"歌扇舞衫","pinyin":"gē shàn wǔ shān","abbr":"gsws","explanation":"歌扇：唱歌的人所拿的扇子；舞衫：跳舞的人所穿的衣服。歌舞的装束、用具，即指歌舞。也指能歌善舞的人。","source":{"text":"舞衫回袖胜春风，歌扇当窗似秋月。","book":"南朝·陈·徐陵《杂曲》"}},{"id":27311,"word":"歌楼舞榭","pinyin":"gē lóu wǔ xiè","abbr":"glwx","explanation":"榭：建筑在高台上的房屋。为歌舞娱乐而设立的堂或楼台。泛指歌舞场所。","source":{"text":"歌台舞榭，月殿云堂。","book":"唐·吕令问《云中古城赋》"},"example":{"text":"凡昔日之～，弱柳妖桃，如洪水淹没，百不存一矣。","book":"明·张岱《西湖梦寻序》"},"similar":["歌台舞榭"],"usage":"作宾语、定语；泛指歌舞场所"},{"id":27312,"word":"歌楼舞馆","pinyin":"gē lóu wǔ guǎn","abbr":"glwg","explanation":"指演奏乐曲、表演歌舞的场所。","source":{"text":"是故碎瓦颓垣，昔日之歌楼舞馆也。","book":"明·刘基《郁离子·天道》"},"similar":["歌台舞榭","歌楼舞榭"],"usage":"作主语、宾语、定语；泛指歌舞场所"},{"id":27313,"word":"歌舞升平","pinyin":"gē wǔ shēng píng","abbr":"gwsp","explanation":"升平：太平。边歌边舞，庆祝太平。有粉饰太平的意思。","source":{"text":"躬自菲薄，治致升平之德。","book":"《左传·襄公三十一年》：“文王之初，天下诵而歌舞之。”汉·张衡《东京赋》"},"example":{"text":"但一班醉生梦死的达官贵人，却又个个兴高采烈，～起来。","book":"清·曾朴《孽海花》第六回"},"similar":["天下太平","歌舞太平"],"opposite":["兵荒马乱"],"usage":"作主语、宾语、定语；指社会安定"},{"id":27314,"word":"歌舞太平","pinyin":"gē wǔ tài píng","abbr":"gwtp","explanation":"边歌边舞，庆祝太平。指粉饰太平。","source":{"text":"须享尘一静，西迎大驾，歌舞太平，不亦佳哉！","book":"《南齐书·陈显达传》"},"example":{"text":"无奈我们的同胞沉迷不醒，依然～。","book":"陈天华《猛回头》"},"similar":["歌舞升平"],"opposite":["兵荒马乱"],"usage":"作主语、宾语、定语；指社会安定"},{"id":27315,"word":"歌莺舞燕","pinyin":"gē yíng wǔ yàn","abbr":"gywy","explanation":"歌声宛转如黄莺，舞姿轻盈如飞燕。亦形容景色宜人，形势大好。","source":{"text":"烟红露绿晓风香，燕舞莺啼春日长。","book":"宋·苏轼《锦被亭》词"},"example":{"text":"明眸皓齿，～，各逞温柔，人俊惜风流。","book":"元·曾瑞《青杏子·骋怀》"},"similar":["舞燕歌莺"],"usage":"作宾语、定语；形容一派太平景象"},{"id":27316,"word":"歔欷不已","pinyin":"xū xī bù yǐ","abbr":"xxby","explanation":"歔欷：哽咽，抽泣；已：止。抽抽噎噎的不断哭泣。","source":{"text":"奔者填衢，赴者塞庭，哀恸雷骇，流泪雨零。歔欷不已，若丧所生。","book":"《晋书·后妃传·左贵嫔》"},"example":{"text":"唯见山林土石，悢悢盈怀～。","book":"宋·释赞宁《宋高僧传》卷二十"}},{"id":27317,"word":"歙漆阿胶","pinyin":"shè qī ē jiāo","abbr":"sqej","explanation":"歙县的漆，东阿的胶，即指胶漆。比喻情意相投。","source":{"text":"歙漆阿胶忽纷解，清尘浊水何由逢？","book":"明·李昌祺《剪灯余话》卷二《田洙遇薛源联句记》"},"similar":["情投意合"],"usage":"联合式；作宾语；含褒义"},{"id":27318,"word":"歠菽饮水","pinyin":"pá shū yǐn shuǐ","abbr":"csys","explanation":"喝豆粥饮白水。比喻生活清苦。","source":{"text":"歠菽饮水，足以致其敬。","book":"汉·桓宽《盐铁论·孝养》"},"example":{"text":"晚节亦不复钓，端居筚门，～。","book":"《晋书·翟庄传》"},"similar":["啜菽饮水"],"usage":"作谓语、定语；指生活清苦"},{"id":27319,"word":"止于至善","pinyin":"zhǐ yú zhì shàn","abbr":"zyzs","explanation":"止：达到；至：最，极。达到极完美的境界。","source":{"text":"大学之道，在明明德，在亲民，在止于至善。","book":"《礼记·大学》"},"example":{"text":"革命无止境，倘使世上真有什么“～”，这人间世便同时变了凝固的东西了。","book":"鲁迅《而已集·黄花节的杂感》"},"similar":["至善至美","十全十美","白璧无瑕"],"opposite":["毫无是处","漆黑一团"],"usage":"作谓语、宾语；指至美"},{"id":27320,"word":"止循资序","pinyin":"zhǐ xún zī xù","abbr":"zxzx","explanation":"止：只；循：遵循；序：顺序。只是按顺序论资排辈。","source":{"text":"若专引知识，则嫌于私；若止循资序，未必皆才。","book":"《宋史·选举志》"},"usage":"作谓语、定语；用于书面语"},{"id":27321,"word":"止戈为武","pinyin":"zhǐ gē wéi wǔ","abbr":"zgww","explanation":"意思是“武”字是“止戈”两字合成的，所以要能止战，才是真正的武功。后也指不用武力而使对方屈服，才是真正的武功。","source":{"text":"非尔所知也。夫文，止戈为武。","book":"《左传·宣公十二年》"},"example":{"text":"然后除其苛令，与其约法，振旅而还，～。","book":"《北齐书·文苑传·樊逊》"},"similar":["止戈之武"],"usage":"作定语；指平息战乱"},{"id":27322,"word":"止戈之武","pinyin":"zhǐ gē zhī wǔ","abbr":"zgzw","explanation":"意思是“武”字是“止戈”两字合成的，所以要能止战，才是真正的武功。后也指不用武力而使对方屈服，才是真正的武功。","source":{"text":"退功臣而进文吏，戢弓矢而散马牛，虽道未方古，斯亦止戈之武焉。","book":"《左传·宣公十二年》：“非尔所知也。夫文，止戈为武。”《后汉书·光武帝纪》"},"example":{"text":"故有除暴禁淫之师，安人～，则神农黄帝尧舜禹汤之所不免也。（唐·代宗《命郭子仪等备边敕》）"},"similar":["止戈为武"],"usage":"作宾语；指平息战乱"},{"id":27323,"word":"止戈兴仁","pinyin":"zhǐ gē xīng rén","abbr":"zgxr","explanation":"止：停止。仁：仁政。停止战争，施行仁政。","source":{"text":"将欲止戈兴仁，为百姓请命。","book":"《三国志·吴志·孙皓传》：“陈事势利害，以申喻皓”裴松之注引《汉晋春秋》"},"usage":"作谓语、定语；用于书面语"},{"id":27324,"word":"止戈散马","pinyin":"zhǐ gē sàn mǎ","abbr":"zgsm","explanation":"停用兵戈，放还战马，意指结束战争。","source":{"text":"止戈散马，各事家业。","book":"《北齐书·神武帝纪下》"},"similar":["马放南山"],"usage":"作谓语、定语；用于书面语"},{"id":27325,"word":"止暴禁非","pinyin":"zhǐ bào jìn fēi","abbr":"zbjf","explanation":"止、禁：罅；暴、非：指种种坏事。制止种种坏事。","source":{"text":"使子路去其危冠，解其长剑，而受教于子。天下皆曰：‘孔丘能止暴禁非。’","book":"《庄子·盗跖》"},"usage":"作谓语、定语；指制止种种坏事"},{"id":27326,"word":"止沸益薪","pinyin":"zhǐ fèi yì xīn","abbr":"zfyx","explanation":"本欲止水沸腾，却反而在锅下加柴。比喻所做与本来愿望相反。","source":{"text":"对高洁人谈高洁，已为止沸益薪，况高洁十倍哉！","book":"明·李贽《为黄安二上人书》之三"},"similar":["抱薪救焚"],"usage":"作宾语、定语；用于书面语"},{"id":27327,"word":"止渴之梅","pinyin":"zhǐ kě zhī méi","abbr":"zkzm","explanation":"原意是梅子酸，人想吃梅子就会流涎，因而止渴。比喻不无小补。","source":{"text":"魏武行役失汲道，军皆渴，乃令曰：‘前有大梅林，饶子，甘酸可以解渴。’士卒闻之，口皆出水，乘此得及前源。","book":"南朝·宋·刘义庆《世说新语·假谲》"},"example":{"text":"邵注四库简明目亦未及见。然其词今皆为王张二刻所有，亦足为～矣。（清·叶德辉《书林清话》卷七）"}},{"id":27328,"word":"止渴思梅","pinyin":"zhǐ kě sī méi","abbr":"zksm","explanation":"犹望梅止渴。比喻用空想安慰自己。亦作“止渴望梅”。","source":{"text":"咱正是那止渴思梅。","book":"元·关汉卿《调风月》第三折：“到三更四更便似止渴思梅，充饥画饼。”元·无名氏《刘弘嫁婢》第二折"},"similar":["止渴望梅","画饼充饥"],"usage":"作宾语、定语；用于比喻句"},{"id":27329,"word":"止渴望梅","pinyin":"zhǐ kě wàng méi","abbr":"zkwm","explanation":"犹望梅止渴。比喻用空想安慰自己。同“止渴思梅”。","source":{"text":"止渴望梅，究有何益，此诚吾党大不幸了！","book":"清·孙雨林《皖江血·拒敌》"},"similar":["止渴思梅","望梅止渴"],"usage":"作宾语、定语；用于比喻句"},{"id":27330,"word":"止渴饮鸩","pinyin":"zhǐ kě yǐn zhèn","abbr":"zkyz","explanation":"鸩：传说中的毒鸟，用它的羽毛浸的酒喝了能毒死人。喝毒酒解渴。比喻用错误的办法来解决眼前的困难而不顾严重后果。","source":{"text":"譬犹疗饥于附子，止渴于鸩毒，未入肠胃，已绝咽喉。","book":"《后汉书·霍谞传》"},"example":{"text":"若虑迷信一破，道德堕落，必以保存为得计，此又何异欲止渴而饮鸩，欲疗疮而剜肉？（清·壮者《扫迷帚》第二十四回）"},"similar":["饮鸩止渴"],"usage":"作谓语、宾语、定语；指人的方法不对"},{"id":27331,"word":"止知其一，未知其二","pinyin":"zhǐ zhī qí yī，wèi zhī qí èr","abbr":"zzqywzqe","explanation":"只知道一方面的情况，不知其他。对情况没有全面了解","source":{"text":"兄止知其一，未知其二。小弟家乡还有些须田产。","book":"清·李百川《绿野仙踪》第18回"},"example":{"text":"～的人永远也不会看到全面"},"similar":["只知其一，不知其二"],"usage":"作宾语、定语、分句；指没有全面了解"},{"id":27332,"word":"止谈风月","pinyin":"zhǐ tán fēng yuè","abbr":"ztfy","explanation":"止：只，仅。只谈风、月等景物。隐指莫谈国事。","source":{"text":"今昔止可谈风月，不宜及公事。","book":"《南史·徐勉传》"},"similar":["只谈风月"],"usage":"作谓语；指不谈政事"},{"id":27333,"word":"止谤莫如自修","pinyin":"zhǐ bàng mò rú zì xiū","abbr":"zbmrzx","explanation":"止：阻止；谤：诽谤；修：修身。要阻止他人对自己的诽谤，最好的方法莫过于修身，提高自己的品德。","source":{"text":"且闻人毁己而忿者，恶丑声之加人也，人报者滋甚，不如默而自脩己也。谚曰：‘救寒莫如重裘，止谤莫如自修。’斯言信矣。","book":"《三国志·魏志·王昶传》"},"example":{"text":"连止谤之法，你都不知道吗？向来有一句极腐败的话，就是～。（张恨水《金粉世家》第六十二回）"},"similar":["止谤莫若自修"],"usage":"作宾语、定语；用于书面语"},{"id":27334,"word":"止谤莫若自修","pinyin":"zhǐ bàng mò ruò zì xiū","abbr":"zbmrzx","explanation":"止：停止，平息；谤：指责。要阻止别人毁谤，最好的方法是修身","source":{"text":"谚曰：‘止寒莫若重裘，止谤莫若自修。’惟陛下崇千载之盛德，去一旦之玩好。","book":"《新唐书·魏谟传》"},"similar":["止谤莫如自修"],"usage":"作宾语、定语；用于书面语"},{"id":27335,"word":"止足之分","pinyin":"zhǐ zú zhī fèn","abbr":"zzzf","explanation":"止：停止；分：本分。知道适可而止，知道满足的本分。","source":{"text":"于是览止足之分，庶浮云之志，筑室种树，逍遥自得。","book":"晋·潘岳《闲居赋》"},"example":{"text":"故范蠡、疏广之辈，知～，前史多之。（《旧唐书·姚崇传》）"}},{"id":27336,"word":"止足之戒","pinyin":"zhǐ zú zhī jiè","abbr":"zzzj","explanation":"止：停止；戒：戒心。知道满足，适可而止的戒心。","source":{"text":"因赠粲诗，要以岁暮之期，申以止足之戒。","book":"南朝·梁·任昉《王文宪集序》"},"example":{"text":"禹锡迂陋，不知～，取讥当世。（《宋史·聂冠卿传》）"},"usage":"作宾语；用于书面语"},{"id":27337,"word":"止足之计","pinyin":"zhǐ zú zhī jì","abbr":"zzzj","explanation":"止：停止；计：心计。知道满足，适可而止的心计。","source":{"text":"行止足之计，免辱殆之累。","book":"《汉书·疏广传赞》"}},{"id":27338,"word":"正中下怀","pinyin":"zhèng zhòng xià huái","abbr":"zzxh","explanation":"正合自己的心意。","source":{"text":"帝方对我饮，正用此时持事来乎！","book":"《后汉书·刘玄传》"},"example":{"text":"不想他那里来请，～。","book":"明·兰陵笑笑生《金瓶梅词话》第五十回"},"similar":["如愿以偿","心满意足","称心如意"],"opposite":["大失所望","出乎意料"],"usage":"作谓语、宾语；形容符合心意","story":["卢俊义从梁山泊回来后被妻子与李固诬陷入狱，燕青搭救没成功。梁山泊拼命三郎石秀在刀下救得卢俊义，也因寡不敌众而入狱。北京官府梁中书担心宋江出兵围城，只好将他们两人打入死牢暂不处死，老头蔡福正中下怀，设法保护两位好汉"]},{"id":27339,"word":"正中其怀","pinyin":"zhèng zhòng qí huái","abbr":"zzqh","explanation":"正：恰好；中：投合。正好符合自己的心意","source":{"text":"孝公闻‘伯术’二字，正中其怀。","book":"明·冯梦龙《东周列国志》第87回"},"example":{"text":"清·吴璿《飞龙全传》第27回：“那两个妇人欲思迷惑，～，各施伎俩，带舞随歌，做作起来。”"},"similar":["正中己怀","正中下怀"],"usage":"作谓语、宾语；形容符合心意"},{"id":27340,"word":"正中己怀","pinyin":"zhèng zhòng jǐ huái","abbr":"zzjh","explanation":"正合自己的心意。同“正中下怀”。","source":{"text":"正合自己的心意。同“正中下怀”。"},"similar":["正中其怀","正中下怀"],"usage":"作谓语、宾语；形容符合心意"},{"id":27341,"word":"正义凛然","pinyin":"zhèng yì lǐn rán","abbr":"zylr","explanation":"凛然：严肃、或敬畏的样子。由于胸怀正义而神态庄严，令人敬畏。","source":{"text":"大义凛然，奋裙首倡。","book":"宋·曹辅《唐颜文忠公新庙记》"},"example":{"text":"只是见群丐～，不禁大有所感，觉得前时戏弄丐帮弟子，倒是自己的不是了。（金庸《神雕侠侣》第十二回）"},"similar":["正气凛然"],"usage":"作定语、状语；用于人的态度等"},{"id":27342,"word":"正人先正己","pinyin":"zhèng rén xiān zhèng jǐ","abbr":"zrxzj","explanation":"正：正直，公正。要让别人做到公平正直就必须自己先做到。","source":{"text":"这也就是我自个，换别人这样儿我也早急了，要不怎么说正人先正己上梁不正下梁歪。","book":"王朔《永失我爱》"},"example":{"text":"我们做到～，就会有说服力。"},"similar":["以身作则"],"usage":"作宾语、分句；指以身作则"},{"id":27343,"word":"正人君子","pinyin":"zhèng rén jūn zǐ","abbr":"zrjz","explanation":"旧时指品行端正的人。现多作讽刺的用法，指假装正经的人。","source":{"text":"胤所悦者阘茸下辈，所恶者正人君子。人人悚惧，朝不保夕。","book":"《旧唐书·崔胤传》"},"example":{"text":"旬这样的才是斯文骨肉朋友，有意气，有肝胆，相与了这样～，也不枉了。","book":"清·吴敬梓《儒林外史》第十四回"},"similar":["志士仁人","跳梁小丑"],"opposite":["臧仓小人"],"usage":"作主语、宾语；用于讽刺人"},{"id":27344,"word":"正儿八经","pinyin":"zhèng ér bā jīng","abbr":"zebj","explanation":"正经，严肃而认真。","source":{"text":"‘这很难说。’我正儿八经地说，‘谁不喜欢有个响亮的名字。’","book":"王朔《玩儿的就是心跳》"},"example":{"text":"他是～的庄稼人。"},"similar":["正经八百"],"usage":"作定语、状语；指正经"},{"id":27345,"word":"正儿巴经","pinyin":"zhèng ér bā jīng","abbr":"zebj","explanation":"①正经的；严肃认真的。②真正的；确实的。亦作“正儿八经”。亦作“正二八摆”。"},{"id":27346,"word":"正其谊不谋其利","pinyin":"zhèng qí yì bù móu qí lì","abbr":"zqybmql","explanation":"正：合于法则的；谊：通“义”，合宜的道德、行为；谋：图谋。言行合乎正义，不谋个人私利","source":{"text":"夫仁人者，正其谊不谋其利，明其道不计其功，是以仲尼之门，五尺之童，羞称五霸，为其先诈力，而后仁义也。","book":"《汉书·董仲舒传》"},"usage":"作谓语、定语；用于书面语"},{"id":27347,"word":"正冠李下","pinyin":"zhèng guàn lǐ xià","abbr":"zglx","explanation":"在李树下不整帽子，以避免偷李的嫌疑。比喻做容易引起怀疑的事。","source":{"text":"君子防未然，不处嫌疑间。瓜田不纳履，李下不整冠。","book":"《乐府诗集·相和歌辞七·君子行》"},"example":{"text":"下官不能避溺山隅，而～，既贻疵辱，方致徽绳。","book":"《梁书·王僧孺传》"},"similar":["正冠纳履","整冠纳履"],"usage":"作宾语、定语；用于处事"},{"id":27348,"word":"正冠纳履","pinyin":"zhèng guàn nà lǚ","abbr":"zgnl","explanation":"端正帽子，穿好鞋子。古时讲李树下不要弄帽子，瓜田里不要弄鞋子，以避免有偷李摸瓜的嫌疑。亦作“正冠李下”。","source":{"text":"君子防未然，不处嫌疑间。瓜田不纳履，李下不整冠。","book":"《乐府诗集·相和歌辞七·君子行》"},"example":{"text":"久要心许之信，夷险不爽；～之嫌，终始不蹈。","book":"晋·李阐《右光禄大夫西平靖侯颜府君碑》"},"similar":["正冠李下"],"usage":"作宾语、定语；用于处事"},{"id":27349,"word":"正名定分","pinyin":"zhèng míng dìng fēn","abbr":"zmdf","explanation":"辨正名分，使名实相符。","source":{"text":"于是有些人又记起了翻译，试来译几篇。但这就又是‘批评家’的材料了，其实，正名定分，他是应该叫作‘唠叨家’的。","book":"鲁迅《且介亭杂文二集·非有复译不可》"},"example":{"text":"受了丈夫的权利当然～，该是她的丈夫，否则她为什么肯尽这些义务呢？","book":"钱钟书《围城》二"},"usage":"作谓语、定语；用于书面语"},{"id":27350,"word":"正名责实","pinyin":"zhèng míng zé shí","abbr":"zmzs","explanation":"辩证名称，使名实相符。","source":{"text":"庶得路分速归旧制，以称朝廷正名责实不忘中原之意。","book":"宋·岳飞《乞改襄阳路仍作京西南路札子》"},"usage":"作谓语、定语；用于书面语"},{"id":27351,"word":"正声雅音","pinyin":"zhèng shēng yǎ yīn","abbr":"zsyy","explanation":"纯正优雅的音乐。","source":{"text":"其正声雅音，笙师之吹竽，邠人之鼓籥，不能过也。","book":"唐·皮日休《通玄子栖宾亭记》"},"usage":"作宾语、定语；用于书面语"},{"id":27352,"word":"正复为奇","pinyin":"zhèng fù wéi qí","abbr":"zfwq","explanation":"复：翻过来。正常的翻过来就会变成奇特的。形容事物相对立的两个方面互相转化。","source":{"text":"正复为奇，善复为袄。","book":"《老子》第五十八章"},"usage":"作宾语、定语；用于书面语"},{"id":27353,"word":"正大不阿","pinyin":"zhèng dà bù ē","abbr":"zdba","explanation":"阿：迎合，偏袒。正直磊落，不逢迎，无偏私。","source":{"text":"有正大不阿，不行私谒者，便以为不贤。","book":"明·余继登《典故纪闻》卷十四"},"example":{"text":"他～形象是多么的伟大"},"similar":["刚直不阿"],"usage":"作谓语、定语；用于书面语"},{"id":27354,"word":"正大光明","pinyin":"zhèng dà guāng míng","abbr":"zdgm","explanation":"心怀坦白，言行正派。","source":{"text":"大抵圣贤之心，正大光明，洞然四达。","book":"宋·朱熹《答吕伯恭书》"},"example":{"text":"这会儿讲走门路，～大道儿，自然要让连公公，那是老牌子。","book":"清·曾朴《孽海花》第二十一回"},"similar":["光明磊落"],"opposite":["心怀叵测","偷偷摸摸"],"usage":"作谓语、定语；指人襟怀坦白"},{"id":27355,"word":"正大堂煌","pinyin":"zhèng dà táng huáng","abbr":"zdth","explanation":"犹言堂堂正正。亦作“正大堂皇”。","source":{"text":"其名衔之正大堂煌，尊荣已极，何谓名衔太新，实尔等听闻未久，觉以为新耳。","book":"太平天国·洪仁玕《英杰归真》"},"similar":["正大堂皇","堂堂正正"],"usage":"作定语、状语；用于书面语"},{"id":27356,"word":"正大堂皇","pinyin":"zhèng dà táng huáng","abbr":"zdth","explanation":"犹言堂堂正正。同“正大堂煌”。","source":{"text":"传旨不必誊正，即命内监将草稿取上御案观览，但见字字龙蛇，行行珠玉，铿锵金石之音，正大堂皇之体。","book":"清·陈朗《雪月梅》第三十七回"},"example":{"text":"他～地叙述了一番事情的经过。","book":"沙汀《淘金记》二五"},"similar":["正大堂煌","堂堂正正"],"usage":"作定语、状语；用于书面语"},{"id":27357,"word":"正大高明","pinyin":"zhèng dà gāo míng","abbr":"zdgm","explanation":"正大：正直，不存私心；高明：学问多。形容人知识广博，道德高尚。","source":{"text":"言子路之学，已造乎正大高明之域，特未深入精微之奥耳，未可以一事之失而遽忽之也。","book":"宋·朱熹《论语集注·先进》"},"usage":"作谓语、定语；用于书面语"},{"id":27358,"word":"正头香主","pinyin":"zhèng tóu xiāng zhǔ","abbr":"ztxz","explanation":"嫡传的子孙。引申以称事物的正主。","source":{"text":"张四，你休胡言乱语，我虽不才，是杨家正头香主。","book":"明·兰陵笑笑生《金瓶梅词话》第七回"},"example":{"text":"这魏大哥是～，指望着娶过媳妇去侍奉婆婆，生儿种女，当家理纪，不知那等的指望。（清·西周生《醒世姻缘传》第七十二回）"}},{"id":27359,"word":"正始之音","pinyin":"zhèng shǐ zhī yīn","abbr":"zszy","explanation":"①指魏晋玄谈风气。出现于三国魏正始年间。当时以何晏、王弼为首，以老庄思想糅合儒家经义，谈玄析理，放达不羁；名土风流，盛于洛下。②指纯正的乐声。","source":{"text":"昔王辅嗣吐金声于中朝，此子复玉振于江表，微言之绪，绝而复续。不意永嘉之末，复闻正始之音。","book":"《晋书·卫玠传》"},"example":{"text":"～其若何，朱弦疏越清庙歌。一弹一唱再三叹，曲淡节稀声不多。融融曳曳召元气，听之不觉心平和。（唐·白居易《五弦弹》诗）"},"usage":"作主语、宾语；用于书面语"},{"id":27360,"word":"正容亢色","pinyin":"zhèng róng kàng sè","abbr":"zrks","explanation":"zhèng  róng  kàng  sè","source":{"text":"谓神色严肃。"},"example":{"text":"茅盾《第一阶段的故事》五：“‘这就该说是‘上海的外国小姐’才对呀！’赵夫人正容亢色地说。”"},"usage":"作定语、状语；用于书面语"},{"id":27361,"word":"正己守道","pinyin":"zhèng jǐ shǒu dào","abbr":"zjsd","explanation":"道：道德。端正自己，严格遵守道德标准。","source":{"text":"以此知阴阳家不足深泥，唯正己守道为可恃耳。","book":"宋·庄季裕《鸡肋编》卷上"},"usage":"作宾语、定语；用于书面语"},{"id":27362,"word":"正心诚意","pinyin":"zhèng xīn chéng yì","abbr":"zxcy","explanation":"原是儒家提倡的一种修养方法，现也泛指心地端正诚恳。","source":{"text":"欲修其身者，先正其心；欲正其心者，先诚其意。","book":"《礼记·大学》"},"example":{"text":"今世之儒士，自以为得～之学者，皆风痹不知痛痒之人也。","book":"清·朱彝尊《朱文公文钞序》"},"usage":"作谓语、定语；指心术端正"},{"id":27363,"word":"正明公道","pinyin":"zhèng míng gōng dào","abbr":"zmgd","explanation":"指正大光明。","source":{"text":"你这话不怕熏的人慌！你要是正明公道的人，没的敢说你不是个大的们！人干不出来的事，你干出来了！还要卖人的老婆？你卖坟上的树，卖老婆使不得么？","book":"清·西周生《醒世姻缘传》第二十二回"}},{"id":27364,"word":"正本清源","pinyin":"zhèng běn qīng yuán","abbr":"zbqy","explanation":"正本：从根本上整顿；清源：从源头上清理。从根本上整顿，从源头上清理。比喻从根本上加以整顿清理。","source":{"text":"思与天下式明王度，正本清源。","book":"《汉书·刑法志》：“岂宜惟思所以清原正本之论，删定律令。”《晋书·武帝纪》"},"example":{"text":"～的工作是艰巨复杂的，必须下大力气抓好。"},"similar":["端本正源","正本澄源"],"opposite":["头痛医头，脚痛医脚"],"usage":"作谓语、宾语、定语；指人的态度"},{"id":27365,"word":"正本溯源","pinyin":"zhèng běn sù yuán","abbr":"zbsy","explanation":"从根本上整顿和寻找原因。","source":{"text":"孔子既不得位，不能垂诸制度礼乐，是以为之正本溯源。","book":"清·戴震《〈孟子字义疏证〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":27366,"word":"正本澄源","pinyin":"zhèng běn chéng yuán","abbr":"zbcy","explanation":"犹正本清源。","source":{"text":"欲使玉石区分，薰莸有辨，长存妙道，永固福田，正本澄源，宜从沙汰。","book":"《旧唐书·高祖纪》"},"example":{"text":"观《春秋》之所书，然后～之意可得而知矣。","book":"明·刘基《春秋明经·公朝于王所仲孙羯会晋韩不信云云城成周》"},"similar":["正本清源"],"usage":"作谓语、宾语、定语；用于处事"},{"id":27367,"word":"正枝正叶","pinyin":"zhèng zhī zhèng yè","abbr":"zzzy","explanation":"正：纯正。纯正的枝叶。比喻嫡系子孙。"},{"id":27368,"word":"正正之旗","pinyin":"zhèng zhèng zhī qí","abbr":"zzzq","explanation":"正正：整齐。排列整齐的军旗。借喻强盛整肃的军队。","source":{"text":"无要正正之旗，勿击堂堂之阵。","book":"《孙子·军争》"},"example":{"text":"看子牙兵按五方而出，左右顾盼，进退舒徐，纪律严肃，井井有条，兵威甚整，真堂堂之阵，～。","book":"明·许仲琳《封神演义》第十三回"},"similar":["正正堂堂"],"usage":"作宾语、定语；指军威"},{"id":27369,"word":"正正堂堂","pinyin":"zhèng zhèng táng táng","abbr":"zztt","explanation":"本指正正的旗号，堂堂的阵容。现形容正大光明。","source":{"text":"人家的话正正堂堂，料着一时驳不倒。","book":"《孙子·军争》：“无要正正之旗，勿击堂堂之阵。”清·文康《儿女英雄传》第三十回"},"example":{"text":"这就是‘裸体行动大写真’，虽然是～的‘人体美与健康美的表现’，然而又是‘小童挡驾’的，他们不配看这些‘美’。","book":"鲁迅《花边文学·“小童挡驾”》"},"similar":["正正之旗","堂堂正正"],"usage":"作状语、定语；用于书面语"},{"id":27370,"word":"正正当当","pinyin":"zhèng zhèng dāng dāng","abbr":"zzdd","explanation":"合情合理","source":{"text":"只要正正当当的事情可以赡得家，养得母妻……","book":"清·无垢道人《八仙全传》第18回"},"similar":["名正言顺","合情合理"],"usage":"作定语、状语；多用于口语"},{"id":27371,"word":"正正气气","pinyin":"zhèng zhèng qì qì","abbr":"zzqq","explanation":"正派。","source":{"text":"［程朝奉］虽是缠得熟分了，那陈氏也自正正气气，一时也勾搭不上。","book":"明·凌濛初《二刻拍案惊奇》卷二十八"},"usage":"作谓语、定语、状语；用于书面语"},{"id":27372,"word":"正正经经","pinyin":"zhèng zhèng jīng jīng","abbr":"zzjj","explanation":"①严肃而认真。②形容正大光明。","source":{"text":"哄我正正经经听了半日，只说当真，原来又是说笑。","book":"清·李渔《怜香伴·狂喜》"},"example":{"text":"你现在能～地当个新中国的人了，还不该高兴吗？","book":"海默《从城里来的姑娘》"},"usage":"作定语、状语；多用于口语"},{"id":27373,"word":"正气之歌","pinyin":"zhèng qì zhī gē","abbr":"zqzg","explanation":"形容无私无畏、刚正不屈的精神","source":{"text":"天地有正气，杂然赋流形。下则为诃岳，上则为日星。于人曰浩然，沛乎塞苍冥。","book":"宋·文天样《正气歌》诗"},"example":{"text":"穆青《为了周总理的嘱托……》：“在乌云密布、群魔乱舞的日子里，这个纯朴的老农，昂首挺立，用自己的行动为人们谱写了一首悲壮的～！”"},"usage":"作宾语；用于书面语"},{"id":27374,"word":"正气凛然","pinyin":"zhèng qì lǐn rán","abbr":"zqlr","explanation":"正气：刚正之气。凛然：可敬畏的样子。形容正气威严不可侵犯。","source":{"text":"许云峰把椅子一推，正气凛然地站在大厅当中，昂头命令道:‘送我回监狱！’","book":"罗广斌、杨益言《红岩》第十章"},"similar":["凛然正气","大义凛然","浩气凛然"],"usage":"作定语、状语；用于人的态度等"},{"id":27375,"word":"正法直度","pinyin":"zhèng fǎ zhí dù","abbr":"zfzd","explanation":"度：标准。严正法律，统一标准。","source":{"text":"正法直度，罪杀不赦，杀僇必信，民畏而惧。","book":"《管子·版法》"},"usage":"作宾语、定语；用于书面语"},{"id":27376,"word":"正法眼藏","pinyin":"zhèng fǎ yǎn cáng","abbr":"zfyc","explanation":"佛教语。禅宗用来指全体佛法（正法）。朗照宇宙谓眼，包含万有谓藏。相传释迦牟尼以正法眼藏付与大弟子迦叶，是为禅宗初祖，为佛教以“心传心”授法的开始。亦借","source":{"text":"盖修身事君，初非二事，不可作两般看，此是千圣相传正法眼藏。","book":"《景德传灯录·摩诃迦叶》：“佛告诸大弟子，迦叶来时，可令宣扬正法眼藏。”宋·朱熹《答陈同甫书》"},"example":{"text":"且如‘人生守定梅花死’，此句殊佳，何人辄用朱笔圈改，予窃谓朱笔之人未得所谓～也。","book":"元·方回《读张功父〈南湖集〉序》"},"usage":"作宾语、定语；用于书面语"},{"id":27377,"word":"正点背画","pinyin":"zhèng diǎn bèi huà","abbr":"zdbh","explanation":"元时供状文书，主管者用朱笔在书首作点，书尾作钩，表示无增减伪造，然后令供状人在书背画押。也指民间订立文书契约。","source":{"text":"扬州奴你近前来，这纸上你与我正点背画个字者。扬州奴曰：‘你着我正点背画，我又无罪过。’","book":"元·秦简夫《东堂老》楔子"},"usage":"作谓语、定语；用于书面语"},{"id":27378,"word":"正理平治","pinyin":"zhèng lǐ píng zhì","abbr":"zlpz","explanation":"指合乎正道的礼法规范，使社会安定有秩序。","source":{"text":"凡古今天下之所谓善者，正理平治也；所谓恶者，偏险悖乱也。","book":"《荀子·性恶》"},"usage":"作谓语、定语；指使社会安定"},{"id":27379,"word":"正直公平","pinyin":"zhèng zhí gōng píng","abbr":"zzgp","explanation":"指正直而又公道，不偏袒。","source":{"text":"我平日所行正直公平，所断之事并无冤枉。","book":"元·关汉卿《钱大尹智勘绯衣梦》第二折"},"example":{"text":"如今为官做吏的人，贪爱的是钱财，奉承的是富贵，把那“～”四字撇却东洋大海。（明·凌濛初《初刻拍案惊奇》卷十一）"},"similar":["正直无私"],"usage":"作谓语、定语；用于处事"},{"id":27380,"word":"正直无私","pinyin":"zhèng zhí wú sī","abbr":"zzws","explanation":"为人做事很正直，没有任何私心。","source":{"text":"襄七年传曰：‘正直为正，正曲为直。’言正者能自正，直者能正人曲，而壹者言其一心不二也。","book":"《左传·庄公三十二年》：“神，聪明正直而壹者也。”孔颖达疏"},"example":{"text":"朝内官员皆惧秦桧，无处与岳元帅伸冤，那阴间神道，～，必有报应。”","book":"清·钱彩《说岳全传》第六十九回"},"similar":["铁面无私","正直无邪"],"usage":"作谓语、定语；指为人正直"},{"id":27381,"word":"正直无邪","pinyin":"zhèng zhí wú xié","abbr":"zzwx","explanation":"公正而无私心。","source":{"text":"太中大夫宋汉清修雪白，正直无邪。","book":"汉顺帝《会葬宋汉策》"},"example":{"text":"清·李百川《绿野仙踪》第16回：“大概年愈久，则道益深，所行～，即可与天地同寿。”"},"similar":["正直无阿"],"usage":"作谓语、定语；用于处事"},{"id":27382,"word":"正直无阿","pinyin":"zhèng zhí wú ē","abbr":"zzwa","explanation":"阿：曲从，迎合。为人处事很正直，没有任何私心","source":{"text":"神，聪明正直而壹者也。","book":"春秋·鲁·左丘明《左传·庄公三十二年》"},"example":{"text":"明·冯梦龙《警世通言》第24卷：“姓刘名志仁，为人～。”"},"similar":["正直无邪"],"usage":"作谓语、定语；用于处事"},{"id":27383,"word":"正经八摆","pinyin":"zhèng jīng bā bǎi","abbr":"zjbb","explanation":"正经：端庄正派。指正正经经，严肃认真的样子。","example":{"text":"子女们没拉扯，可一个个孝顺！托祖宗的福，都是～儿的大学生！（冯苓植《虬龙爪——鸟如其主》一）"}},{"id":27384,"word":"正经八本","pinyin":"zhèng jīng bā běn","abbr":"zjbb","explanation":"正经的，严肃认真的。同“正经八百”。","source":{"text":"可是，我们干革命，只要正经八本地干，哪有不忙的时候儿？","book":"郭澄清《大刀记》第十八章"},"similar":["正经八百","正经八板"],"usage":"作定语、状语；用于口语"},{"id":27385,"word":"正经八板","pinyin":"zhèng jīng bā bǎn","abbr":"zjbb","explanation":"正经的，严肃认真的。同“正经八百”。","source":{"text":"铁娃把孩子塞给了秀娟，披着的棉衣也甩到了炕上，正经八板地坐了起来。","book":"陆星儿《北大荒人物速写》"},"example":{"text":"王朔《一点正经没有》：“我们的女排女篮女乒都是～的娘儿们。”"},"similar":["正儿八经","正经八百"],"opposite":["吊儿郎当"],"usage":"作定语、状语；用于口语"},{"id":27386,"word":"正经八百","pinyin":"zhèng jīng bā bǎi","abbr":"zjbb","explanation":"①正经的，严肃认真的。②犹名副其实。","source":{"text":"秦发愤却当了真，正经八百地说：‘抗美援朝的时候起的。’","book":"张天民《创业》第二章"},"example":{"text":"想想自己这一路上的表现，哪够上一个～儿的大庆人？","book":"李汉平《“吓一跳”的故事》"},"similar":["正经八板","正儿八经"],"usage":"作定语、状语；用于口语"},{"id":27387,"word":"正色危言","pinyin":"zhèng sè wēi yán","abbr":"zswy","explanation":"态度严肃，语言正直，能使人望而生畏。同“正色直言”。","source":{"text":"迪、曾正色危言，能使宦官近习，不敢窥觎。","book":"《宋史·杜衍等传论》"},"similar":["正色直言"],"usage":"作谓语、状语；用于处事"},{"id":27388,"word":"正色厉声","pinyin":"zhèng sè lì shēng","abbr":"zsls","explanation":"态度严正，言辞严厉。","source":{"text":"众情疑惧方若锋刃之迫肤，而能处之从容，正色厉声决以大事，非勇者不能也。","book":"明·方孝孺《王彪之》"},"usage":"作定语、状语；用于处事"},{"id":27389,"word":"正色敢言","pinyin":"zhèng sè gǎn yán","abbr":"zsgy","explanation":"态度严肃，敢于直言。","source":{"text":"健学问深粹，正色敢言，以身任天下之重。","book":"《明史·王竑传》：“十一年授户科给事中，豪迈负气节，正色敢言。”又《刘健传》"},"usage":"作谓语、定语；用于处事"},{"id":27390,"word":"正色直绳","pinyin":"zhèng sè zhí shéng","abbr":"zszs","explanation":"指严正执法。","source":{"text":"［孔休源］迁御史中丞，正色直绳，无所回避，百僚惮之。","book":"《南史·孔休源传》"},"usage":"作谓语、定语；用于书面语"},{"id":27391,"word":"正色直言","pinyin":"zhèng sè zhí yán","abbr":"zszy","explanation":"态度严肃，语言正直，能使人望而生畏。","source":{"text":"恭每正色直言，道子深惮而忿之。","book":"《晋书·王恭传》"},"similar":["正色危言"],"usage":"作谓语、定语；用于处事"},{"id":27392,"word":"正色立朝","pinyin":"zhèng sè lì cháo","abbr":"zslc","explanation":"正色：严肃或严厉的神色。在朝廷上态度严肃。比喻不阿谀逢迎。","source":{"text":"孔父正色而立于朝，则人莫敢过而致难于其君者，孔父可谓义形于色矣。","book":"《公羊传·桓公二年》"},"example":{"text":"秀夫～，尚日书大学章句，训导嗣君。（蔡东藩《宋史演义》第一百回）"},"usage":"作谓语、定语；用于处事"},{"id":27393,"word":"正襟危坐","pinyin":"zhèng jīn wēi zuò","abbr":"zjwz","explanation":"襟：衣襟；危坐：端正地坐着。整一整衣服，端正地坐着。形容严肃或拘谨的样子。","source":{"text":"宋忠、贾谊瞿然而悟，猎缨正襟危坐。","book":"《史记·日者列传》"},"example":{"text":"Ｒ先生把我请在一把上位的太师椅上坐下，～和我对话起来。","book":"郭沫若《学生时代·到宜兴去》"},"similar":["整衣危坐","肃然危坐","整襟危坐"],"opposite":["威义不肃"],"usage":"作谓语、定语、状语；形容恭敬严肃地坐着"},{"id":27394,"word":"正襟安坐","pinyin":"zhèng jīn ān zuò","abbr":"zjaz","explanation":"整理好衣服，端正地坐着。形容严肃或拘谨的样子。同“正襟危坐”。","source":{"text":"昔贬涪州，过汉江，中流船几覆，举舟之人皆号泣，伊川但正襟安坐，心存诚敬，已而船及岸。","book":"宋·邵伯温《闻见前录》卷十"},"similar":["正襟危坐","整襟危坐"],"usage":"作谓语、定语、状语；形容恭敬严肃地坐着"},{"id":27395,"word":"正视绳行","pinyin":"zhèng shì shéng xíng","abbr":"zssx","explanation":"谓言行正直。","source":{"text":"公有矩德，以蕝其外，正视绳行，无间其里，必能正其人心矣。","book":"清·龚自珍《送广西巡抚梁公序》三"},"usage":"作谓语、定语；用于书面语"},{"id":27396,"word":"正言不讳","pinyin":"zhèng yán bù huì","abbr":"zybh","explanation":"说话爽直，毫无忌讳。","source":{"text":"宁正言不讳以危身乎？","book":"战国·楚·屈原《卜居》"},"example":{"text":"微言高论，既已鄙陋汉、唐，而其反复论难，～，如先生之文者，世莫之贵矣。","book":"唐·苏试《〈凫绎先生文集〉叙》"},"similar":["直言不讳","直言无隐","自认不讳"],"usage":"作定语、状语；指直说"},{"id":27397,"word":"正言厉色","pinyin":"zhèng yán lì sè","abbr":"zyls","explanation":"正：严正；厉：严厉，严肃；色：脸色。形容板着脸，神情非常严厉。","source":{"text":"目见正容，耳闻正言。","book":"《汉书·王莽传》：“盱衡厉色，振扬武怒。”《后汉书·翟酺传》"},"example":{"text":"黛玉见他说的郑重，又且～，只当是真事。","book":"清·曹雪芹《红楼梦》第十九回"},"similar":["不苟言笑","冷若冰霜"],"opposite":["和颜悦色","和蔼可亲"],"usage":"作谓语、状语；指人的态度","story":["贾宝玉去探访林黛玉，正赶上她在睡觉，就去推醒她，黛玉故意不去理他。宝玉突然想出一个主意，一本正经地给她讲扬州黛山林子洞耗子精偷香芋的故事，黛玉见他正言厉色，以为真有其事，后来才发现原来是在取笑她"]},{"id":27398,"word":"正言厉颜","pinyin":"zhèng yán lì yán","abbr":"zyly","explanation":"话语严正，表情严肃。同“正言厉色”。","source":{"text":"钱典史听了这话，便正言厉颜的对他说道：‘世兄！用到这样管家，你做主人的总要有点主人的威势才好。’","book":"清·李宝嘉《官场现形记》第二回"},"similar":["正言厉色"],"usage":"作谓语、状语；指人的态度"},{"id":27399,"word":"正言直谏","pinyin":"zhèng yán zhí jiàn","abbr":"zyzj","explanation":"以正义之语，规劝皇帝、上级、长辈或朋友。","source":{"text":"今正言直谏，则近死辱而远荣宠，人情何好焉，此乃欲忠于主耳！","book":"三国·魏·桓范《谏争》"},"example":{"text":"臣幸逢陛下至圣大明，好忠爱直，每～，特见优容。","book":"唐·陈子昂《申宗人冤狱书》"},"usage":"作谓语、宾语；用于书面语"},{"id":27400,"word":"正言若反","pinyin":"zhèng yán ruò fǎn","abbr":"zyrf","explanation":"正言：正直的话。把正直的话当成反话。比喻误解他人的好意。","source":{"text":"正言若反。","book":"《老子》第六十四章"}},{"id":27401,"word":"正谏不讳","pinyin":"zhèng jiàn bù huì","abbr":"zjbh","explanation":"谏：劝谏；讳：避讳。正言相劝，毫不隐讳。","source":{"text":"寡人奉先君之宗庙，守社稷，闻先生直言正谏不讳。","book":"《战国策·齐策四》"},"similar":["直言不讳"],"usage":"作定语、状语；指直说"},{"id":27402,"word":"正身明法","pinyin":"zhèng shēn míng fǎ","abbr":"zsmf","explanation":"端正自身，严明法纪。","source":{"text":"二千石令长当袛奉旧宪，正身明法，抑齐豪强，存恤孤独，隐实户口，劝课农桑。","book":"《晋书·元帝纪》"},"usage":"作谓语、定语；用于书面语"},{"id":27403,"word":"正身清心","pinyin":"zhèng shēn qīng xīn","abbr":"zsqx","explanation":"端正自己的言行，清静内心。比喻修身养性。","source":{"text":"愿陛下体上天之仁爱，念祖宗之艰难，正身清心以立本而应务。","book":"《明史·邱濬传》"},"similar":["修身养性"],"usage":"作谓语、宾语；用于书面语"},{"id":27404,"word":"正身率下","pinyin":"zhèng shēn shuài xià","abbr":"zssx","explanation":"端正自身，为下属表率。","source":{"text":"仲舒正身率下，所居而治。","book":"汉·荀悦《汉纪·武帝纪三》"},"example":{"text":"任总内外，位兼台辅，不能～，以肃庶僚。","book":"南朝宋·刘义康《上表逊位》"},"similar":["以身作则","整躬率物"],"usage":"作谓语、定语；用于处事"},{"id":27405,"word":"正道坦途","pinyin":"zhèng dào tǎn tú","abbr":"zdtt","explanation":"正：正直；坦：平坦。直而平坦的大路。形容方向正确，前途光明。","source":{"text":"总之，再不走荆棘，这边就是茂林修竹；再不踏确荦，这边便是正道坦途。","book":"清·李绿园《歧路灯》第九十六回"},"usage":"作宾语、定语；用于书面语"},{"id":27406,"word":"正道直行","pinyin":"zhèng dào zhí xíng","abbr":"zdzx","explanation":"正道：正路。沿着直的道路走。比喻办事公正。","source":{"text":"斯民也，三代之所以直道而行也。","book":"《论语·卫灵公》"},"example":{"text":"虽怀内美，重以修能，～，而罹谗贼。（鲁迅《汉文学史纲要·屈原及宋玉》）"},"similar":["直道而行"],"usage":"作谓语、宾语、定语；比喻办事公正"},{"id":27407,"word":"正颜厉色","pinyin":"zhèng yán lì sè","abbr":"zyls","explanation":"颜：面容。形容板着脸，神情非常严厉。","source":{"text":"目见正容，耳闻正言。","book":"《汉书·王莽传》：“盱衡厉色，振扬武怒。”《后汉书·翟酺传》"},"example":{"text":"黛玉见他说的郑重，又且～，只当是真事，因问：“什么事？”","book":"《红楼梦》第十九回"},"similar":["正言厉色","声色俱厉","疾言厉色"],"opposite":["和颜悦色","和蔼可亲"],"usage":"作谓语、状语；指人的态度"},{"id":27408,"word":"此一时彼一时","pinyin":"cǐ yī shí bǐ yī shí","abbr":"cysbys","explanation":"指时间不同，情况亦异，不能相提并论。","source":{"text":"语出《孟子·公孙丑下》：“彼一时，此一时也。五百年必有王者兴，其间必有名世者”。"},"example":{"text":"那不是～，吗……谁又真心去捧老校长呢！","book":"老舍《赵子曰》弟六"}},{"id":27409,"word":"此一时，彼一时","pinyin":"cǐ yī shí，bǐ yī shí","abbr":"cysbys","explanation":"此：这；彼：那。那是一个时候，现在又是一个时候。表示时间不同，情况有了变化。","source":{"text":"彼一时，此一时也。五百年必有王者兴，其间必有名世者。","book":"《孟子·公孙丑下》"},"example":{"text":"～。他如今在天上，我得收拾门下，免死沟壑，便为万幸了，还敢妄言甚么。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["彼一时，此一时"],"opposite":["相提并论"],"usage":"作主语、分句；指情况发生了变化"},{"id":27410,"word":"此中三昧","pinyin":"cǐ zhōng sān mèi","abbr":"czsm","explanation":"三昧：佛教用语，梵文音译词，意思是“正定”，即屏绝杂念，使心神平静，是佛门修养之法。比喻这里面的奥妙之处。","source":{"text":"长沙僧怀素好草书，自言得草圣三昧。","book":"唐·李肇《国史补·中》"},"example":{"text":"好在九公已得～，看他不费吹灰之力，何不略将大概指教。","book":"清·李汝珍《镜花缘》第十九回"},"usage":"作宾语；指这其中的奥妙"},{"id":27411,"word":"此中多有","pinyin":"cǐ zhōng duō yǒu","abbr":"czdy","explanation":"心中有多种看法，却不能用言语表达出来。","source":{"text":"云与言，庄不能对，逡巡而去。拊心谓人曰：‘吾口不能剧谈，此中多有。’","book":"晋·葛洪《西京杂记》卷二"}},{"id":27412,"word":"此事体大","pinyin":"cǐ shì tǐ dà","abbr":"cstd","explanation":"体：体制，规模。这件事性质重要，关系重大。","source":{"text":"兹事体大而允，寤寐次于圣心。","book":"汉·班固《典引》"},"example":{"text":"～，乞垂圣鉴，特降中旨。","book":"宋·范仲淹《范文正公集》"},"similar":["斯事体大"],"usage":"作分句；用于书面语"},{"id":27413,"word":"此伏彼起","pinyin":"cǐ fú bǐ qǐ","abbr":"cfbq","explanation":"这里起来，那里下去。形容接连不断。","source":{"text":"因为政局的不安定，真是此起彼伏如转轮。","book":"鲁迅《坟·论‘费厄泼赖’应该缓行》"},"example":{"text":"各地的叛乱～。"},"similar":["此起彼伏"],"opposite":["风平浪静"],"usage":"作谓语；形容事物发展起伏不断"},{"id":27414,"word":"此动彼应","pinyin":"cǐ dòng bǐ yīng","abbr":"cdby","explanation":"这里发动，那里响应。","source":{"text":"君之于民，如脑筋于耳目手足，此动彼应，顷刻而成。","book":"裘廷梁《论白话为维新之本》"},"similar":["此发彼应"],"usage":"作宾语、定语；用于事物之间"},{"id":27415,"word":"此发彼应","pinyin":"cǐ fā bǐ yīng","abbr":"cfby","explanation":"这里发动，那里响应。","source":{"text":"各做各的，怎么行呢？一定是要互相联络，此发彼应才行。","book":"清·陈天华《警世钟》"},"similar":["此动彼应"],"usage":"作宾语、定语；用于事物之间"},{"id":27416,"word":"此呼彼应","pinyin":"cǐ hū bǐ yīng","abbr":"chby","explanation":"此：这里。彼：那里。这里呼唤，那里响应。形容联系紧密，互相配合行动。"},{"id":27417,"word":"此唱彼和","pinyin":"cǐ chàng bǐ hè","abbr":"ccbh","explanation":"彼：那里。这里唱，那里随声附和。比喻互相呼应。","source":{"text":"与前七子隔绝数十年，而此唱彼和，声应气求，若出一轨。","book":"清·陈田《明诗纪事·己签序》"},"example":{"text":"当下～，无不赞成。","book":"蔡东藩《慈禧太后演义》第九回"},"similar":["夫唱妇随","前呼后应"],"opposite":["前后矛盾","自相矛盾"],"usage":"作谓语、定语；指相互呼应"},{"id":27418,"word":"此地无银三十两","pinyin":"cǐ dì wú yín sān shí liǎng","abbr":"cdwyssl","explanation":"比喻想要隐瞒、掩盖真相，结果反而彻底暴露。","source":{"text":"里巷间有个笑话：……写道‘此地无银三十两’。……就在木板的那一面添上一句道：‘隔壁阿二勿曾偷’。","book":"鲁迅《伪自由书·推背图》"},"similar":["此地无银三百两"],"usage":"作主语、宾语、定语、分句；用于处事","story":["从前有个精于算计而又自作聪明的张三，辛辛苦苦攒了三百两银子，放在家里怕别人偷，就趁夜色在自家院中挖坑埋好，并在埋银处写上“此地无银三百两”的字牌。隔壁的小偷王二将银子偷走，并留下“隔壁王二不曾偷”的字牌"]},{"id":27419,"word":"此地无银三百两","pinyin":"cǐ dì wú yín sān bǎi liǎng","abbr":"cdwysbl","explanation":"比喻想要隐瞒掩饰，结果反而暴露。","source":{"text":"民间故事：有人把银子埋藏地下，上面留字写道：“此地无银三百两”。邻人阿二偷走了银子，也留字写道：“隔壁阿二不曾偷”。"},"example":{"text":"他们做贼心虚，所以总是发表～的声明。","book":"《人民文学》1976年第9期"},"similar":["欲盖弥彰","不打自招"],"usage":"作主语、宾语、定语、分句；用于处事","story":["从前有个精于算计而又自作聪明的张三，辛辛苦苦攒了三百两银子，放在家里怕别人偷，就趁夜色在自家院中挖坑埋好，并在埋银处写上“此地无银三百两”的字牌。隔壁的小偷王二将银子偷走，并留下“隔壁王二不曾偷”的字牌"]},{"id":27420,"word":"此处不留人，会有留人处","pinyin":"cǐ chǔ bù liú rén，huì yǒu liú rén chǔ","abbr":"ccblrhylrc","explanation":"指这里不可居留，自会有可居留的地方。","source":{"text":"留人不留人，不留人也去。此处不留人，会有留人处。","book":"《通俗编》第13卷引《平陈录》"},"example":{"text":"别伤心，～。"},"similar":["此处不留人，自有留人处"],"usage":"作宾语、分句；用于劝诫人","story":["南朝陈国时期，张贵妃得到皇帝的宠爱，沈皇后受到排斥，经常是半年以上得不到皇帝的临幸。一次皇帝临幸沈皇后，刚坐一会就要离开，皇后也不挽留，皇帝感到奇怪就作诗：“留人不留人，不留人也去。此处不留人，会有留人处。”"]},{"id":27421,"word":"此处不留人，自有留人处","pinyin":"cǐ chǔ bù liú rén，zì yǒu liú rén chǔ","abbr":"ccblrzylrc","explanation":"指这里不可居留，自会有可居留的地方。","source":{"text":"先生道：‘若要奉承人，卦就不准了；若说实话，又惹人怪。此处不留人，自有留人处！","book":"《警世恒言·三现身包龙图断冤》"},"similar":["此处不留人，会有留人处"],"usage":"作宾语、分句；用于劝诫人"},{"id":27422,"word":"此心耿耿","pinyin":"cǐ xīn gěng gěng","abbr":"cxgg","explanation":"耿耿：心有所思，有心事，也指明亮，忠诚。表示心里有事，老是放不下，一直牵挂。也形容内心十分忠诚。","source":{"text":"虽欲勉之而德不足取信，言不足以取重，徒使此心耿耿而止耳。","book":"宋·陈亮《复黄伯起》"},"example":{"text":"～，天日为诏。","book":"蔡东藩、许廑父《民国通俗演义》第八十七回"},"similar":["忠心耿耿"],"usage":"作宾语、定语；用于忠心"},{"id":27423,"word":"此恨绵绵","pinyin":"cǐ hèn mián mián","abbr":"chmm","explanation":"绵绵：延续不断的样子。这种遗恨缠绕心头，永远不能逝去。","source":{"text":"天长地久有时尽，此恨绵绵无绝期。","book":"唐·白居易《长恨歌》"},"example":{"text":"当是时，孤灯一盏，举目无亲……～，曷其有极！","book":"清·沈复《浮生六记》第三卷"},"usage":"作主语、谓语；指怨恨"},{"id":27424,"word":"此时无声胜有声","pinyin":"cǐ shí wú shēng shèng yǒu shēng","abbr":"cswssys","explanation":"胜：超过。原指没有声音时比有声音更能表达出内心深处的愁恨。引申指人的模范行为比言谈口号影响更大。","source":{"text":"别有幽情暗恨生，此时无声胜有声。","book":"唐·白居易《琵琶行》诗"}},{"id":27425,"word":"此界彼疆","pinyin":"cǐ jiè bǐ jiāng","abbr":"cjbj","explanation":"指划分疆界，彼此阻隔。","source":{"text":"痴珠也自欢喜，说道：‘此十年用兵，一误于士不用命，再误于此界彼疆。’","book":"《花月痕》第二一回"},"similar":["此疆尔界"],"usage":"作宾语、定语；用于界限"},{"id":27426,"word":"此疆尔界","pinyin":"cǐ jiāng ěr jiè","abbr":"cjej","explanation":"指划分疆界，彼此阻隔。","source":{"text":"无此疆尔界，陈常于时夏。","book":"《诗·周颂·思文》"},"example":{"text":"天子以四海为家……无～之限。","book":"宋·孙奕《履斋示儿编·冀州不言山川》"},"similar":["此疆彼界","此界彼疆"],"usage":"作宾语、定语；用于界限"},{"id":27427,"word":"此疆彼界","pinyin":"cǐ jiāng bǐ jiè","abbr":"cjbj","explanation":"此：这个；疆：疆界，边界。这个和那个之间的界限。","source":{"text":"致广大，谓心胸开阔，无此疆彼界之殊。","book":"宋·朱熹《朱子语类·中庸》"},"similar":["此疆尔界"],"usage":"作宾语、定语；用于界限"},{"id":27428,"word":"此而可忍，孰不可容","pinyin":"cǐ ér kě rěn，shú bù kě róng","abbr":"cekrsbkr","explanation":"此：这；孰：哪个；容：容忍。如果这能容忍，还有什么不能容忍的。","source":{"text":"履霜于开运之辰，坚冰于嗣业之世，此而可忍，孰不可容。","book":"《南齐书·张敬儿传》"},"similar":["此而可忍，孰不可忍"],"usage":"作宾语、分句；用于感叹"},{"id":27429,"word":"此而可忍，孰不可忍","pinyin":"cǐ ér kě rěn，shú bù kě rěn","abbr":"cekrsbkr","explanation":"这个如能容忍，还有什么不能容忍呢！","source":{"text":"[司马伦]怒曰：‘我于水中见蟹且恶之，况此人（解系）兄弟轻我邪！此而可忍，孰不可忍！","book":"《晋书·解系传》"},"similar":["此而可忍，孰不可容"],"usage":"作宾语、分句；用于感叹"},{"id":27430,"word":"此起彼伏","pinyin":"cǐ qǐ bǐ fú","abbr":"cqbf","explanation":"这里起来，那里下去。形容接连不断。","source":{"text":"鸟毕骇，兽咸作，草伏木栖，寓居穴托，起伏集此。","book":"汉·张衡《西京赋》"},"example":{"text":"在鼾声～中，领导人自己独独醒着。","book":"柳青《创业史》第一部第22章"},"similar":["此伏彼起"],"usage":"作谓语、定语；形容事物发展变化不断"},{"id":27431,"word":"此起彼落","pinyin":"cǐ qǐ bǐ luò","abbr":"cqbl","explanation":"这里起来，那里下去。形容接连不断。","source":{"text":"时大时小时缩时伸是经常的，此起彼落也往往发生。","book":"毛泽东《中国革命战争的战略问题》第五章第七节"},"example":{"text":"他们分成了两组，～地围在校长室外声嘶力竭地喊着叫着。","book":"杨沫《青春之歌》第二部第四章"},"similar":["此起彼伏","接连不断"],"usage":"作谓语、状语；形容接连不断"},{"id":27432,"word":"此路不通","pinyin":"cǐ lù bù tōng","abbr":"clbt","explanation":"指这种方法或途径行不通。","example":{"text":"～，我们还是想别的办法吧。"},"similar":["死路一条"],"usage":"作分句；指这种方法或途径行不通"},{"id":27433,"word":"此问彼难","pinyin":"cǐ wèn bǐ nàn","abbr":"cwbn","explanation":"难：驳诘。这个诘问那个责难。","source":{"text":"讨论问题，研究章程，此问彼难，风起云涌。","book":"鲁迅《华盖集续编·送灶日漫笔》"},"usage":"作谓语、定语；用于处事"},{"id":27434,"word":"此风不可长","pinyin":"cǐ fēng bù kě zhǎng","abbr":"cfbkz","explanation":"这种风气不能让它滋长发展。","source":{"text":"若到外面说了，人家就要说此风不可长了。","book":"清·吴趼人《二十年目睹之怪现状》四十七回"},"usage":"作宾语；用于口语"},{"id":27435,"word":"步人后尘","pinyin":"bù rén hòu chén","abbr":"brhc","explanation":"后尘：走路或行车时后面扬起的尘土。指跟在人家后面走。比喻追随模仿，学人家的样子，没有创造性。","source":{"text":"窃攀屈宋宜方驾，恐与齐梁作后尘。","book":"唐·杜甫《戏为六绝句》诗"},"example":{"text":"有科学上，我们要勇于走自己的路，绝不可～。"},"similar":["亦步亦趋","人云亦云","邯郸学步"],"opposite":["别开生面","标新立异","独辟蹊径"],"usage":"作谓语、宾语、定语；表示没有创新"},{"id":27436,"word":"步后尘","pinyin":"bù hòu chén","abbr":"bhc","explanation":"后尘：走路时扬起的尘土。指跟在别人后面追随模仿。","source":{"text":"副帅好当前队，老夫愿步后尘。","book":"明·屠隆《昙花记·讨贼立功》"},"similar":["步人后尘"],"usage":"作谓语、宾语；用于处事"},{"id":27437,"word":"步履如飞","pinyin":"bù lǚ rú fēi","abbr":"blrf","explanation":"形容脚步轻盈，走路快速如飞。","source":{"text":"弘玄先生老而贫，日以著述为事，出无舆从，一童子挟书自随，步履如飞。","book":"明·归有光《弘玄先生自序赞》"},"example":{"text":"公素服海参丸，老年体力轻健，～，年九十余始卒。","book":"清·昭涟《啸亭杂录·康方伯》"},"similar":["健步如飞"],"opposite":["步履维坚"],"usage":"作谓语、状语；指速度快"},{"id":27438,"word":"步履安详","pinyin":"bù lǚ ān xiáng","abbr":"blax","explanation":"步履：步行；安详：安稳。迈步走路，从容安稳。","source":{"text":"步履必安详，居处必正静。","book":"《小学·嘉言》"},"opposite":["手忙脚乱"],"usage":"作谓语、定语、状语；用于人的步态"},{"id":27439,"word":"步履维艰","pinyin":"bù lǚ wéi jiān","abbr":"blwj","explanation":"指行走困难行动不方便。","source":{"text":"念见刘，颈荷欠徽，手交木叶，颜色枯槁，步履艰难。","book":"《宋史·章宗经三》：“年高艰于步履者，并听策杖，仍令舍人护卫扶之。”明·邵景瞻《觅灯因话·桂迁梦感录》"},"example":{"text":"譬如祖母的脚是三角形，～的，小姑娘的却是天足，能飞跑。","book":"鲁迅《华盖集·这个与那个》"},"similar":["步履蹒跚","进退维谷","寸步难行"],"opposite":["昂首阔步","一帆风顺","健步如飞"],"usage":"作谓语；用于老年人或有病的人行动不便"},{"id":27440,"word":"步履艰难","pinyin":"bù lǚ jiān nán","abbr":"bljn","explanation":"指行走困难行动不方便。","source":{"text":"念见刘，颈荷欠徽，手交木叶，颜色枯槁，步履艰难。","book":"《宋史·章宗经三》：“年高艰于步履者，并听策杖，仍令舍人护卫扶之。”明·邵景瞻《觅灯因话·桂迁梦感录》"}},{"id":27441,"word":"步履蹒跚","pinyin":"bù lǚ pán shān","abbr":"blps","explanation":"蹒跚：走路一瘸一拐的样子。形容走路腿脚不方便，歪歪倒倒的样了。","source":{"text":"患脚谓之步履蹒跚。","book":"宋·龚熙正《释常谈·步履蹒跚》"},"example":{"text":"手里捧着一对大蜡烛，～的走了进来。","book":"清·吴趼人《二十年目睹之怪现状》第77回"},"similar":["一步一摇"],"opposite":["大步流星"],"usage":"作谓语、定语；指人走路缓慢"},{"id":27442,"word":"步态蹒跚","pinyin":"bù tài pán shān","abbr":"btps","explanation":"走路摇摆、缓慢的姿态。","example":{"text":"他～的样子让人发笑。"},"similar":["步履蹒跚"],"usage":"作谓语、定语、状语；指人走路缓慢的姿态"},{"id":27443,"word":"步斗踏罡","pinyin":"bù dǒu tà gāng","abbr":"bdtg","explanation":"道士礼拜星宿、召遣神灵的一种动作。其步行转折，宛如踏在罡星斗宿之上，故称。罡，北斗七星之柄。斗，北斗星。","source":{"text":"书符咒水，全无作用，步斗踏罡，专一胡躧。","book":"明·无名氏《李云卿》第四折"},"similar":["步罡踏斗"],"usage":"作谓语、宾语；用于迷信等"},{"id":27444,"word":"步月登云","pinyin":"bù yuè dēng yún","abbr":"bydy","explanation":"步上月亮，攀登云霄。形容志向远大。","source":{"text":"我劝你休带怜香借玉心，顿忘步月登云志。","book":"明·谢谠《四喜记·赴试秋闱》"},"usage":"作宾语、定语；用于人的志向"},{"id":27445,"word":"步步为营","pinyin":"bù bù wéi yíng","abbr":"bbwy","explanation":"步：古时以五尺为一步，“步步”表示距离短。军队每向前推进一步就设下一首营垒。形容防守严密，行动谨慎。","source":{"text":"可激劝士卒，拔寨前进，步步为营，诱渊来战而擒之。","book":"明·罗贯中《三国演义》第71回"},"example":{"text":"益中是抱的～的政策，虽然计划很大，眼前却用不到三百万的借款！","book":"茅盾《子夜》十七"},"similar":["稳扎稳打","谨言慎行","小心谨慎"],"opposite":["轻举妄动"],"usage":"作谓语、宾语；比喻做事谨慎"},{"id":27446,"word":"步步深入","pinyin":"bù bù shēn rù","abbr":"bbsr","explanation":"一步一步地进入事物的内部。","example":{"text":"经过我们～研究，终于发现了最佳解决方案。"},"usage":"作谓语、定语、状语；用于逐步进入"},{"id":27447,"word":"步步生莲花","pinyin":"bù bù shēng lián huā","abbr":"bbslh","explanation":"形容女子步态轻盈姿。","source":{"text":"（东昏侯）又凿金为莲华（花）以贴地，令潘妃行其上，曰：‘此步步生莲华（花）也。’","book":"《南史·齐纪下·废帝东昏侯》"},"example":{"text":"富翁在后面看去，真是～。","book":"明·凌濛初《初刻拍案惊奇》第18卷"},"similar":["莲花步步生"],"usage":"作谓语；形容女子步态轻盈"},{"id":27448,"word":"步步登高","pinyin":"bù bù dēng gāo","abbr":"bbdg","explanation":"登：升。一步步地升高。多形容仕途顺利，职位不断高升。","source":{"text":"曰：‘步步登高时如何？’师曰：‘云生足下。’","book":"宋·释普济《五灯会元》卷三十"},"example":{"text":"他只会从空放下，不会～。","book":"宋·释惟白《续传灯录》卷三十二"},"similar":["扶摇直上","一步登天","青云直上"],"opposite":["一落千丈"],"usage":"作谓语；比喻地位步步高升"},{"id":27449,"word":"步步紧逼","pinyin":"bù bù jǐn bī","abbr":"bbjb","explanation":"紧紧地逼近，毫不松懈。","example":{"text":"我们采取～的办法来对付。"},"similar":["步步为营","步步进逼"],"usage":"作谓语、定语；指紧紧地逼近"},{"id":27450,"word":"步步莲花","pinyin":"bù bù lián huā","abbr":"bblh","explanation":"原形容女子步态轻盈。后常比喻渐入佳境。","source":{"text":"又凿金为莲华以帖地，令潘妃行其上，曰：‘此步步生莲华也。’","book":"《南史·齐本纪下》"},"example":{"text":"若将曲直无颠倒，脚底莲花步步生。","book":"元·岳伯川《铁拐李》第二折"}},{"id":27451,"word":"步步进逼","pinyin":"bù bù jìn bī","abbr":"bbjb","explanation":"一步一步地逼进。","source":{"text":"有意制造事端，并在老师的再三忍让下步步进逼、得寸进尺，公然当着全班同学对老师采取极不恭敬的态度。","book":"王朔《我是你爸爸》"},"example":{"text":"我们采取～的方法迫使他就范。"},"similar":["步步为营","步步紧逼"],"usage":"作谓语、定语；指一步一步地逼进"},{"id":27452,"word":"步步高升","pinyin":"bù bù gāo shēng","abbr":"bbgs","explanation":"步步：表示距离很短；高升：往上升。指职位不断上升。","source":{"text":"并且事成之后，大人步步高升，扶摇直上，还望大人栽培呢！","book":"清·吴趼人《二十年目睹之怪现状》第88回"},"example":{"text":"祝你今年～。"},"similar":["步步登高"],"opposite":["每况愈下"],"usage":"作谓语；用于祝福"},{"id":27453,"word":"步线行针","pinyin":"bù xiàn xíng zhēn","abbr":"bxxz","explanation":"比喻周密布置。","source":{"text":"那怕你指天画地能瞒鬼，步线行针待哄谁？","book":"元·康进之《李逵负荆》二折"},"example":{"text":"那怕你指天画地能瞒鬼，～待哄谁？","book":"《元曲选·李逵负荆》"},"similar":["环环紧扣"],"usage":"作谓语；比喻周密安排设计"},{"id":27454,"word":"步罡踏斗","pinyin":"bù gāng tà dǒu","abbr":"bgtd","explanation":"道士礼拜星宿、召遣神灵的一种动作。其步行转折，宛如踏在罡星斗宿之上，故称。罡，北斗七星之柄。斗，北斗星。","source":{"text":"[孔明]日则计议军机，夜则步罡踏斗。","book":"《三国演义》第一○三回"},"similar":["步斗踏罡"],"usage":"作谓语、宾语；用于迷信等"},{"id":27455,"word":"步调一致","pinyin":"bù diào yī zhì","abbr":"bdyz","explanation":"步调：行进的步伐。比喻行动和谐一致。","source":{"text":"在这种种方面，都应该提高共产主义精神，防止宗派主义倾向，使我们的党达到队伍整齐，步调一致的目的，以利战斗。","book":"毛泽东《整顿党的作风》"},"example":{"text":"我们要～、统一行动。"},"similar":["同心同德","万众一心","志同道合"],"opposite":["分道扬镳","离心离德","各行其是"],"usage":"作谓语、定语、状语；比喻做事行动一致"},{"id":27456,"word":"步障自蔽","pinyin":"bù zhàng zì bì","abbr":"bzzb","explanation":"步障：用以遮蔽风尘或视线的一种屏幕。原指才女谢道韫设置屏幕与人辩辞。后多指自己给自己设置障碍。","source":{"text":"乃施青绫步障自蔽，申献之前议，客不能屈。","book":"《晋书·王凝之妻谢氏传》"}},{"id":27457,"word":"步雪履穿","pinyin":"bù xuě lǚ chuān","abbr":"bxlc","explanation":"形容人穷困潦倒。","source":{"text":"牵衣肘见，步雪履穿，获戾由中，是贫非病。","book":"唐·王维《送郑五赴任新都序》"}},{"id":27458,"word":"武不善作","pinyin":"wǔ bù shàn zuò","abbr":"wbsz","explanation":"意思是既动武就不能讲斯文。","source":{"text":"常言道：‘武不善作’，但只怕起手处不得留情，一时间伤了你的性命。","book":"《西游记》第六三回"},"example":{"text":"从来‘～’，邓九公合褚一官便都有摘了帽子，甩了大衣，盘上辫子，又在短衣上缩紧了腰，叫了四个人进来捆那绳扛。","book":"《儿女英雄传》第十七回"},"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":27459,"word":"武人不惜死","pinyin":"wǔ rén bù xī sǐ","abbr":"wrbxs","explanation":"指武将不怕死。","source":{"text":"文臣不爱财，武人不惜死，天下平矣！","book":"《宋史·岳飞传》"},"usage":"作宾语、定语；用于书面语"},{"id":27460,"word":"武偃文修","pinyin":"wǔ yǎn wén xiū","abbr":"wywx","explanation":"文治已实行，武备已停止。形容天下太平。亦作“文修武偃”。","source":{"text":"正此引奏，前日先生看定状元试卷，蒙圣旨武偃文修，今其时矣！","book":"明汤显祖《还魂记·榜下》"},"similar":["文修武偃"],"usage":"作宾语、定语；用于书面语"},{"id":27461,"word":"武断专横","pinyin":"wǔ duàn zhuān héng","abbr":"wdzh","explanation":"武断：只凭主观想象作判断。专横：专制强横。形容凭借权势独断专行，蛮横跋扈。","example":{"text":"以何者为教育大本，万国宪法，无此～之规定。","book":"陈独秀《宪法与孔教》"}},{"id":27462,"word":"武断乡曲","pinyin":"wǔ duàn xiāng qū","abbr":"wdxq","explanation":"指凭借势力在民间横行霸道。","source":{"text":"当此之时，网疏而民富，役财骄溢，或至兼并豪党之徒，以武断于乡曲。","book":"《史记·平准书》"},"example":{"text":"力之大者，则反持官府；力之小者，则～。","book":"清蒲松龄《上孙给谏书》"},"similar":["鱼肉乡里"],"usage":"作谓语、定语；用于书面语"},{"id":27463,"word":"武昌剩竹","pinyin":"wǔ chāng shèng zhú","abbr":"wcsz","explanation":"比喻尚可备用的材料。","source":{"text":"时造船，木屑及竹头悉令举掌之，咸不解所以。后正会，积雪始晴，听事前作雪犹湿，于是以屑布地。及桓温伐蜀，又以侃所贮竹头作丁（钉）装船。其综微密，皆此类也。","book":"《晋书·陶侃传》"},"example":{"text":"顾逸事新语可佐谈资者，乃先是所罗而未及付之于墨，其为柏梁余材，～，颇亦不少。意不能恝，聊复缀为四十则。","book":"明凌濛初《小引》"},"similar":["竹头木屑"],"usage":"作宾语、定语；用于书面语","story":["东晋时期，江西官吏陶侃秉公执法，诚恳待人，在担任武昌太守期间，处处以百姓的利益放在首位。他十分注重节约，把造船剩下的木屑用作冬天铺在雪上垫路之用，把剩下的竹头做成战船的竹钉又重新用到船上，人民纷纷称赞他"]},{"id":27464,"word":"武爵武任","pinyin":"wǔ jué wǔ rèn","abbr":"wjwr","explanation":"依据战功的大小给以爵位和官职。","source":{"text":"兴兵而伐，则武爵武任，必胜。","book":"《商君书·去强》"},"usage":"作谓语、定语；用于书面语"},{"id":27465,"word":"武艺超群","pinyin":"wǔ yì chāo qún","abbr":"wycq","explanation":"武艺：武术上的本领。也指军事、战斗的本领。形容武艺高强，超出一般人。","source":{"text":"兄武艺超群，兼通经史，不思共使君匡扶汉室，徒欲赴汤蹈火，以成匹夫之勇，安得为义？","book":"明·罗贯中《三国演义》第二十五回"},"example":{"text":"兹有程彪、程虎兄弟，～，向隶籍忠义军。","book":"明·冯梦龙《喻世明言》卷三十九"},"similar":["武艺高强"],"usage":"作谓语、定语；用于书面语"},{"id":27466,"word":"歧出歧入","pinyin":"qí chū qí rù","abbr":"qcqr","explanation":"歧：不相同。漂泊不定，没有固定的处所。","source":{"text":"以是知歧出歧入泛泛然而无所归者，皆失其家而家他人，不能以自立。","book":"清·李楷《序》"},"usage":"作定语、状语；用于漂泊"},{"id":27467,"word":"歧路亡羊","pinyin":"qí lù wáng yáng","abbr":"qlwy","explanation":"歧路：岔路；亡：丢失。因岔路太多无法追寻而丢失了羊。比喻事物复杂多变，没有正确的方向就会误入歧途。","source":{"text":"大道以多歧亡羊，学者以多方丧生。","book":"《列子·说符》"},"example":{"text":"而诸儒之言，故为纠纷，徒俾～。总以此等区处，一字不审，则入迷津。","book":"清·王夫之《读四书大全说》卷三"},"similar":["误入歧途"],"opposite":["改邪归正"],"usage":"作谓语、定语；比喻事理复杂多变","story":["从前杨朱的邻居请他派仆人帮他去找丢失的一只羊，杨子问他为什么要那么多的人去找，邻居说丢失羊的路上有很多岔道，所以要很多人去找。过了很久，派出去找羊的人回来说没有找到，邻居说岔道上又分许多岔道，根本没法找了"]},{"id":27468,"word":"歧路他乡","pinyin":"qí lù tā xiāng","abbr":"qltx","explanation":"歧路：岔路。指远离家乡的外地。多指关系亲密的两人分别流落在异地。","source":{"text":"某穷途异县，歧路他乡，非无阮籍之悲，诚有杨朱之泣。","book":"南朝·梁·萧统《昭明太子集三·锦带书·十二月启·中吕·四月》"}},{"id":27469,"word":"歧路徘徊","pinyin":"qí lù pái huái","abbr":"qlph","explanation":"歧路：岔路；徘徊：在一个地方来回地走，比喻犹豫。在岔道上走来走去。比喻犹豫观望，主意不定。","source":{"text":"动息无兼遂，歧路多徘徊。","book":"南朝·齐·谢眺《观朝雨》"},"example":{"text":"长途君怅望，歧路我徘徊，心赏风烟隔，容华岁月催。","book":"唐·骆宾王《饯郑安阳入蜀》"}},{"id":27470,"word":"歪七扭八","pinyin":"wāi qī niǔ bā","abbr":"wqnb","explanation":"歪歪扭扭，不直。","example":{"text":"请把这些～的桌子摆正。"},"similar":["歪七斜八","歪七竖八"],"opposite":["整整齐齐"],"usage":"作定语、状语；指不整齐"},{"id":27471,"word":"歪七竖八","pinyin":"wāi qī shù bā","abbr":"wqsb","explanation":"歪歪扭扭的。形容不正的样子。","source":{"text":"沿马路上的电灯柱上，里门口，都有些红纸小方块；烂疮膏药似的，歪七竖八贴着。","book":"茅盾《上海·我的二房东》"},"example":{"text":"你们～的样子让人恶心。"},"similar":["歪歪扭扭","歪七扭八"],"opposite":["整整齐齐"],"usage":"作谓语、定语、状语；指不正"},{"id":27472,"word":"歪不横楞","pinyin":"wāi bù héng léng","abbr":"wbhl","explanation":"歪斜不正的样子。","example":{"text":"面对～的桌椅，我的头都大了"},"similar":["歪歪扭扭"],"usage":"作定语、状语；用于口语"},{"id":27473,"word":"歪八竖八","pinyin":"wāi bā shù bā","abbr":"wbsb","explanation":"杂乱不整的样子。"},{"id":27474,"word":"歪嘴和尚","pinyin":"wāi zuǐ hé shàng","abbr":"wzhs","explanation":"比喻那些为自私的目的而乱搬教条的人。","example":{"text":"我最讨厌那些不干正事的～。"},"opposite":["正人君子"],"usage":"作主语、宾语、定语；指搬弄是非的人"},{"id":27475,"word":"歪嘴和尚瞎念经","pinyin":"wāi zuǐ hé shàng xiā niàn jīng","abbr":"wzhsxnj","explanation":"比喻为谋私利而乱搬教条。","example":{"text":"真是～，他纯粹在捣乱。"},"similar":["歪嘴念邪经"],"usage":"作宾语、定语、分句；指为谋私利而乱搬教条"},{"id":27476,"word":"歪嘴念邪经","pinyin":"wāi zuǐ niàn xié jīng","abbr":"wznxj","explanation":"比喻为谋私利故意搞歪曲事实的宣传。","example":{"text":"你不要干～的勾当。"},"usage":"作宾语、定语；指为谋私利而乱搬教条"},{"id":27477,"word":"歪心邪意","pinyin":"wāi xīn xié yì","abbr":"wxxy","explanation":"指心术不正。","source":{"text":"你总不听我的话，倒叫这些人教的你歪心邪意，狐媚魇道的。","book":"清·曹雪芹《红楼梦》第二十回"},"similar":["心术不正"],"opposite":["堂堂正正"],"usage":"作宾语、定语；用于处世等"},{"id":27478,"word":"歪打正着","pinyin":"wāi dǎ zhèng zháo","abbr":"wdzz","explanation":"比喻方法本来不恰当，却侥幸得到满意的结果。也比喻原意本不在此，却凑巧和别人的想法符合。","source":{"text":"将药煎中，打发晁大舍吃将下去。想歪打正着，又是杨太医运好的时节，吃了药就安稳睡了一觉。","book":"清·西周生《醒世姻缘传》第二回"},"example":{"text":"他有种非智慧的智慧，最善于～。（老舍《牛天赐传》）"},"similar":["瞎猫逮死耗子"],"opposite":["画蛇添足","弄巧成拙"],"usage":"作宾语、补语、分句；指凑巧"},{"id":27479,"word":"歪歪倒倒","pinyin":"wāi wāi dǎo dǎo","abbr":"wwdd","explanation":"不端正的样子，形容行动不稳的样子。","example":{"text":"他喝醉了，走起路来～的。"},"similar":["歪歪斜斜"],"usage":"作定语、状语；指不端正"},{"id":27480,"word":"歪歪扭扭","pinyin":"wāi wāi niǔ niǔ","abbr":"wwnn","explanation":"歪斜不正。","source":{"text":"那项链一经抖开，非常之长，上百个菱形树粒密密麻麻歪歪扭扭地摆列着，已完全失去光泽。","book":"王朔《无人喝彩》"},"example":{"text":"路旁的树没人整理，长得～的。"},"similar":["歪歪斜斜"],"opposite":["整整齐齐"],"usage":"作定语、状语；指歪斜不正"},{"id":27481,"word":"歪歪斜斜","pinyin":"wāi wāi xié xié","abbr":"wwxx","explanation":"由震颤的状态所引起的不整齐，或属于颤抖的人或物的特征的状态。","source":{"text":"面前摊一本青格子，歪歪斜斜写着草体字的书，书旁边供着一个已出椟的木主。","book":"曾朴《孽海花》第三回"},"example":{"text":"他的字写得～，让人难以辨认。"},"similar":["歪歪扭扭"],"opposite":["整整齐齐"],"usage":"作定语、状语；指不端正"},{"id":27482,"word":"歪谈乱道","pinyin":"wāi tán luàn dào","abbr":"wtld","explanation":"说话糊里糊涂，毫无见地。","source":{"text":"他也学些者也之乎，歪谈乱道，失却卑尊。","book":"明·无名氏《登瀛洲》"},"example":{"text":"你不要相信他的～。"},"similar":["胡说八道"],"usage":"作谓语、宾语、定语；指胡说"},{"id":27483,"word":"歪门邪道","pinyin":"wāi mén xié dào","abbr":"wmxd","explanation":"指不正当的门径。也比喻坏主意。","source":{"text":"当前在经济改革中出现了一些歪门邪道。","book":"邓小平《一靠理想二靠纪律才能团结起来》"},"example":{"text":"我们要致富不能搞～。"},"similar":["左道旁门","歪风邪气"],"opposite":["康庄大道","正人君子"],"usage":"作主语、宾语、定语；指不正当的门径"},{"id":27484,"word":"歪风邪气","pinyin":"wāi fēng xié qì","abbr":"wfxq","explanation":"歪、邪：不正当，不正派。指不良的作风和风气。","source":{"text":"只有王以信装得镇静，面不改色，还对高书记说：早应当整整社员里头的歪风邪气了。","book":"柳青《狠透铁》"},"example":{"text":"我们要狠狠打击这种～。"},"similar":["歪门邪道","不正之风"],"opposite":["康庄大道"],"usage":"作主语、宾语、定语；指不良的作风和风气"},{"id":27485,"word":"死不回头","pinyin":"sǐ bù huí tóu","abbr":"sbht","explanation":"指到死也不反悔，形容意志坚决。","example":{"text":"他有～的决心。"},"similar":["执迷不悟"],"opposite":["迷途知返"],"usage":"作谓语、定语；指执迷不悟"},{"id":27486,"word":"死不开口","pinyin":"sǐ bù kāi kǒu","abbr":"sbkk","explanation":"至死也不说话。指缄口不言。","example":{"text":"我们无论怎样问她，她就是～不肯表态。"},"similar":["死不吭声","缄口不言"],"usage":"作谓语、定语；指缄口不言"},{"id":27487,"word":"死不悔改","pinyin":"sǐ bù huǐ gǎi","abbr":"sbhg","explanation":"到死也不追悔、改正。形容非常顽固。","example":{"text":"你～的性格会害了你。"},"similar":["死不改悔"],"opposite":["翻然悔悟"],"usage":"作谓语、定语；指非常顽固"},{"id":27488,"word":"死不改悔","pinyin":"sǐ bù gǎi huǐ","abbr":"sbgh","explanation":"到死也不追悔、改正。形容非常顽固，坚持错误。","source":{"text":"对于‘四人帮’的死党和他们帮派体系里的人，毫无疑问要坚决打击。","book":"邓小平《在中央军委全体会议上的讲话》"},"example":{"text":"他～，始终坚持他的错误论调。"},"similar":["至死不变"],"opposite":["翻然悔悟"],"usage":"作谓语；指非常顽固"},{"id":27489,"word":"死不旋踵","pinyin":"sǐ bù xuán zhǒng","abbr":"sbxz","explanation":"旋踵：旋转足跟，即后退。比喻不畏艰险，坚决向前。亦比喻极短时间内即死去。","source":{"text":"当此之时，秦中士卒，以军中为家，将帅为父母，不约而亲，不谋而信，一心同功，死不旋踵。","book":"《战国策·中山策》"},"example":{"text":"酖入人之口，裂肝腐肠，～。","book":"宋·吕祖谦《管仲言宴安》"},"similar":["毫不畏惧"],"usage":"作宾语、状语；指奋勇向前","story":["东汉时期，司隶校尉李膺反对宦官专权，当着汉桓帝宠信宦官张让的面逮捕横行霸道的野王县令张朔，并将他斩首示众。张让在汉桓帝面前告李膺杀他弟弟。李膺理直气壮地说就是杀他也不会旋转脚后跟后退，也要杀尽大奸大恶"]},{"id":27490,"word":"死不死，活不活","pinyin":"sǐ bù sǐ，huó bù huó","abbr":"sbshbh","explanation":"陷于困境，不知怎么办才好。","source":{"text":"正是好不好恶不恶的姻缘，正撞着死不死活不活的时节。","book":"元·刘庭信《折枉令·忆别》曲"},"example":{"text":"若差些儿的人，听见了这话，吵嚷起来，把你丢在外头，～，你敢怎么着呢？","book":"清·曹雪芹《红楼梦》第68回"},"similar":["半死不活","不死不活"],"opposite":["生机勃勃"],"usage":"作谓语、定语、状语；指僵持状态"},{"id":27491,"word":"死不甘心","pinyin":"sǐ bù gān xīn","abbr":"sbgx","explanation":"就是死了也不甘心情愿或满足。","source":{"text":"只是一件，我死也不甘心的；我虽生的比别人略好些，并没有私情密意勾引你怎样，如何一口咬定了我是个狐狸精！","book":"清·曹雪芹《红楼梦》第77回"},"example":{"text":"你这样对我，我～。"},"similar":["死不瞑目"],"usage":"作谓语、定语；用于口语","story":["王夫人因发现男女性爱图腾手袋后，对大观园内所有丫鬟进行搜查，赶走了迎春的丫鬟司棋，同时把漂亮丫鬟晴雯也赶出大观园。宝玉偷偷摸摸去晴雯家探望她，晴雯觉得又惊又喜，同时很委屈，只因为长得漂亮就被一口咬定为狐狸精她死也不甘心"]},{"id":27492,"word":"死不瞑目","pinyin":"sǐ bù míng mù","abbr":"sbmm","explanation":"瞑目：闭眼。死了也不闭眼。原指人死的时候心里还有放不下的事。现常用来形容极不甘心。","source":{"text":"今不夷汝三族，悬示四海，则吾死不瞑目。","book":"《三国志·吴书·孙坚传》"},"example":{"text":"四患未除，吾～。","book":"宋·苏轼《司马温公行状》"},"similar":["抱恨终天","死不闭目"],"opposite":["心甘情愿","何乐不为"],"usage":"作谓语、宾语；指死得遗憾","story":["东汉末年，凉州军阀董卓进军洛阳，废汉少帝立汉献帝，自任相国。长沙太守孙坚与袁术联合共同讨伐董卓。董卓想嫁女给孙坚的儿子孙权来拉拢孙坚，孙坚气愤地对董卓的特使李傕说：“今不夷汝三族，悬示四海，则吾死不瞑目。”"]},{"id":27493,"word":"死不要脸","pinyin":"sǐ bù yào liǎn","abbr":"sbyl","explanation":"指没有害羞的意思。","example":{"text":"他就是～。"},"opposite":["死要面子"],"usage":"作谓语、宾语、定语；指不知羞耻"},{"id":27494,"word":"死不足惜","pinyin":"sǐ bù zú xī","abbr":"sbzx","explanation":"足：值得；惜：吝惜或可惜。形容不怕死或死得没有价值。","source":{"text":"善用兵者使之无所顾，有所恃。无所顾则知死之不足惜，有所恃则知不至于必败。","book":"《宋史·苏洵传》"},"example":{"text":"妾一身～，但自蒙爱幸，身怀六甲，已两月矣。","book":"明·冯梦龙《东周列国志》第二回"},"similar":["视死如归"],"opposite":["贪生怕死","苟且偷生"],"usage":"作谓语；形容不怕死"},{"id":27495,"word":"死不闭目","pinyin":"sǐ bù bì mù","abbr":"sbbm","explanation":"原指人死的时候心里还有放不下的事。现常用来形容极不甘心。同“死不瞑目”。","source":{"text":"穷思毕精，以赎前过，怀痛穷天，死不闭目。","book":"《旧唐书·韩愈传》"},"similar":["死不瞑目"],"opposite":["死而无憾","死而无悔"],"usage":"作谓语、宾语；指死得遗憾"},{"id":27496,"word":"死且不朽","pinyin":"sǐ qiè bù xiǔ","abbr":"sqbx","explanation":"指死而不忘恩德。","source":{"text":"以君之灵，累臣得归骨于晋，寡君之以为戮，死且不朽。","book":"《左传·成公三年》"},"example":{"text":"明·冯梦龙《东周列国志》第22回：“乞念先君一脉，愿留性命，长为匹夫，～！”"},"similar":["至死不忘"],"usage":"作谓语、定语；用于书面语"},{"id":27497,"word":"死中求活","pinyin":"sǐ zhōng qiú huó","abbr":"szqh","explanation":"指死中求生。","source":{"text":"今日刃侵于胸，火逼于肤，死中求活，法当寻出奇之计。","book":"宋·王质《上皇帝书》"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“不如去夺太平军的粮食，反倒是～的一条生路。”"},"similar":["死里求生","死中求生"],"usage":"作谓语、宾语；同“死里求生”"},{"id":27498,"word":"死中求生","pinyin":"sǐ zhōng qiú shēng","abbr":"szqs","explanation":"在极危险的境地中努力挣扎以求生路。","source":{"text":"述谓延岑曰：‘事当奈何？’岑曰：‘男儿当死中求生，可坐穷乎？’","book":"南朝·宋·范晔《后汉书·公孙述传》"},"example":{"text":"丈夫岂可临难苟免，当在～耳！","book":"《周书·李远传》"},"similar":["死里求生","死中求活"],"opposite":["坐以待毙","死路一条"],"usage":"作谓语、宾语；同“死里求生”"},{"id":27499,"word":"死乞白赖","pinyin":"sǐ qǐ bái lài","abbr":"sqbl","explanation":"形容纠缠不休。","source":{"text":"这可亏了他三个死乞白赖的拉住我，不叫我打他。","book":"清·西周生《醒世姻缘传》第三十二回"},"example":{"text":"王朔《玩儿的就是心跳》：“他一见我就～地拦住我，说他找我好几天了。”"},"similar":["死求白赖","死乞百赖"],"usage":"作定语、状语；用于书面语"},{"id":27500,"word":"死乞百赖","pinyin":"sǐ qǐ bǎi lài","abbr":"sqbl","explanation":"形容纠缠不休。同“死乞白赖”。","source":{"text":"他只好年有年礼，节有节礼，死乞百赖巴结上冯老兰。","book":"梁斌《播火记》"},"similar":["死乞白赖","死求白赖"],"usage":"作定语、状语；用于书面语"}]
