+[{"id":47501,"word":"飞粮挽秣","pinyin":"fēi liáng wǎn mò","abbr":"flwm","explanation":"指迅速运送粮草。同“飞刍挽粟”。","source":{"text":"既而一讨浑庭，三驾辽泽，天子亲伐，师兵大举，飞粮挽秣，水陆交至。","book":"《隋书·食货志》"},"similar":["飞刍挽粒","飞刍挽粟","飞刍挽粮"],"usage":"作谓语、宾语；指迅速运送粮草"},{"id":47502,"word":"飞苍走黄","pinyin":"fēi cāng zǒu huáng","abbr":"fczh","explanation":"指打猎。苍，苍鹰。黄，黄狗。","source":{"text":"其所营也，非荣即利，或飞苍走黄于中原，或留连杯觞以羹沸。","book":"晋·葛洪《抱朴子·金丹》"},"example":{"text":"[董桓]年四十馀，称雄一乡，性好武勇，所交游悉射皮饮胄、～之人。","book":"清·和邦额《夜谭随录·董如彪》"},"usage":"作谓语、宾语、定语；指打猎"},{"id":47503,"word":"飞蓬乘风","pinyin":"fēi péng chéng fēng","abbr":"fpcf","explanation":"枯蓬随风飞。比喻人没有主见，态度随着情势而转变。","source":{"text":"今夫飞蓬，遇飘风而行千里，乘风之势也。","book":"《商君书·禁使》"},"similar":["飞蓬随风"],"usage":"作宾语、定语；指人没主见"},{"id":47504,"word":"飞蓬随风","pinyin":"fēi péng suí fēng","abbr":"fpsf","explanation":"枯蓬随风飞。比喻人没有主见，态度随着情势而转变。","source":{"text":"飞蓬随风，微子所叹，永览前戒。","book":"南朝·宋·范晔《后汉书·明帝纪》"},"example":{"text":"你不能抱～的态度得过且过。"},"similar":["飞蓬乘风"],"usage":"作宾语、定语；指人没主见"},{"id":47505,"word":"飞蛾扑火","pinyin":"fēi é pū huǒ","abbr":"feph","explanation":"飞蛾扑到火上，比喻自取灭亡。","source":{"text":"如飞蛾之赴火，岂焚身之可吝。","book":"《梁书·到溉传》"},"example":{"text":"他今日自来投到，岂不是～，自讨死吃的。","book":"元·杨显之《潇湘雨》第二折"},"similar":["飞蛾赴火","自取灭亡"],"usage":"作谓语、状语、定语；指自取灭亡","story":["南朝梁时才子到荩是朝廷金紫光禄大夫到溉的孙子，深受皇帝萧衍的喜爱，经常在一块作诗，萧衍特地赐他祖父一首诗：“研磨墨以腾文，笔飞毫以书信，如飞蛾之赴火，岂焚身之可吝。必耄年其已及，可假之于少荩。”"]},{"id":47506,"word":"飞蛾投火","pinyin":"fēi é tóu huǒ","abbr":"feth","explanation":"象蛾子扑火一样。比喻自找死路、自取灭亡。","source":{"text":"如飞蛾之赴火，岂焚身之可吝。","book":"《梁书·到溉传》"},"example":{"text":"不然进入他家，如～一般，坑你上不上，下不下，那时悔之晚矣。","book":"明·兰陵笑笑生《金瓶梅词话》第十七回"},"similar":["自取灭亡","飞蛾赴火"],"usage":"作谓语、状语、定语；指自取灭亡","story":["南朝梁时才子到荩是朝廷金紫光禄大夫到溉的孙子，深受皇帝萧衍的喜爱，经常在一块作诗，萧衍特地赐他祖父一首诗：“研磨墨以腾文，笔飞毫以书信，如飞蛾之赴火，岂焚身之可吝。必耄年其已及，可假之于少荩。”"]},{"id":47507,"word":"飞蛾投焰","pinyin":"fēi é tóu yàn","abbr":"fety","explanation":"蛾：像蝴蝶似的昆虫。像蛾子扑火一样。比喻自找死路、自取灭亡。","source":{"text":"只因迷宿本，似飞蛾投焰，自取焚身。","book":"明·汪廷讷《狮吼记·住锡》"},"similar":["飞蛾赴焰","飞蛾投火","飞蛾扑火"],"usage":"作宾语、定语；指自取灭亡"},{"id":47508,"word":"飞蛾赴火","pinyin":"fēi é fù huǒ","abbr":"fefh","explanation":"象蛾子扑火一样。比喻自找死路、自取灭亡。","source":{"text":"如飞蛾之赴火，岂焚身之可吝。","book":"《梁书·到溉传》"},"example":{"text":"你这样做，无疑是～。"},"similar":["飞蛾投火","自取灭亡","飞蛾扑火"],"usage":"作宾语、定语；指自取灭亡","story":["南朝梁时才子到荩是朝廷金紫光禄大夫到溉的孙子，深受皇帝萧衍的喜爱，经常在一块作诗，萧衍特地赐他祖父一首诗：“研磨墨以腾文，笔飞毫以书信，如飞蛾之赴火，岂焚身之可吝。必耄年其已及，可假之于少荩。”"]},{"id":47509,"word":"飞蛾赴烛","pinyin":"fēi é fù zhú","abbr":"fefz","explanation":"比喻自找死路、自取灭亡。同“飞蛾赴火”。","source":{"text":"蛣蜣转丸贱苏合，飞蛾赴烛甘死祸。","book":"宋·黄庭坚《演雅》诗"},"similar":["飞蛾赴火","飞蛾赴焰"],"usage":"作宾语、定语；指自取灭亡"},{"id":47510,"word":"飞蛾赴焰","pinyin":"fēi é fù yàn","abbr":"fefy","explanation":"比喻自找死路、自取灭亡。同“飞蛾赴火”。","source":{"text":"既知四隅断绝，百计奔冲，如穷鸟触笼，似飞蛾赴焰。","book":"《旧唐书·僖宗纪》"},"similar":["飞蛾赴火","飞蛾赴烛"],"usage":"作宾语、定语；指自取灭亡"},{"id":47511,"word":"飞蝇垂珠","pinyin":"fēi yīng chuí zhū","abbr":"fycz","explanation":"眼前像有群蝇飞动，串珠垂挂。比喻眼睛昏花。","source":{"text":"既壮而肤革不丰盈，未老而齿发早衰白，瞀然如飞蝇垂珠在眸子中者，动以万数，盖以苦学力文之所致。","book":"《旧唐书·白居易传》"},"usage":"作宾语、定语；用于老年人"},{"id":47512,"word":"飞觞走斝","pinyin":"fēi shāng zǒu jiǎ","abbr":"fszj","explanation":"犹言飞觥献斝。指频频传杯。","source":{"text":"一个待咏月嘲风，一个待飞觞走斝，谈些古是今非，下学上达。","book":"元·马致远《青衫泪》第四折"},"similar":["飞觥走斝"],"usage":"作谓语、宾语、状语；用于聚饮"},{"id":47513,"word":"飞觥献斝","pinyin":"fēi gōng xiàn jiǎ","abbr":"fgxj","explanation":"觥、斝：皆古代酒器。指频频举杯。形容开怀畅饮。","source":{"text":"年年贺遐龄永固，岁岁赞万乘明君，玳瑁筵飞觥走斝，金殿内瑞气氤氲。","book":"元·无名氏《五龙朝圣》第四折"},"example":{"text":"二人归坐，先是款酌慢饮，渐次谈至兴浓，不觉～起来。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["飞觥走斝","传杯送盏"],"usage":"作谓语、宾语、状语；用于聚饮"},{"id":47514,"word":"飞觥走斝","pinyin":"fēi gōng zǒu jiǎ","abbr":"fgzj","explanation":"指宴饮的酒器。","source":{"text":"则为你诛夷了俺主公夺了天下，锯的他死尸骸做飞觥走斝。","book":"元·杨梓《豫让吞炭》第三折"},"similar":["飞觥献斝","飞觞走斝"],"usage":"作谓语、宾语、状语；用于聚饮"},{"id":47515,"word":"飞谋荐谤","pinyin":"fēi móu jiàn bàng","abbr":"fmjb","explanation":"以流言蜚语阴相攻讦。同“飞谋钓谤”。","source":{"text":"忌君者日以次骨飞谋荐谤，迭相污染。","book":"清·曾国藩《毕君殉难碑记》"},"similar":["飞谋钓谤"],"usage":"作谓语、宾语、定语；用于处世"},{"id":47516,"word":"飞谋钓谤","pinyin":"fēi móu diào bàng","abbr":"fmdb","explanation":"以流言蜚语阴相攻讦。","source":{"text":"二寇患公居间，为己不利……则飞谋钓谤，以间染我。","book":"唐·韩愈《司徒兼侍中中书令赠太尉许国公神道碑铭》"},"similar":["飞谋荐谤"],"usage":"作谓语、宾语、定语；用于处世"},{"id":47517,"word":"飞遁离俗","pinyin":"fēi dùn lí sú","abbr":"fdls","explanation":"飞遁：指隐退。指隐退而远离尘俗。","source":{"text":"隐居大荒之庭，飞遁离俗。","book":"三国·魏·曹植《七启》"},"example":{"text":"我羡慕那种～的隐居生活。"},"usage":"作谓语、定语；指隐居生活"},{"id":47518,"word":"飞遁鸣高","pinyin":"fēi dùn míng kāo","abbr":"fdmg","explanation":"飞遁：指隐退。远离尘俗，自鸣清高。","source":{"text":"飞遁离俗。","book":"三国·魏·曹植《七启》"},"example":{"text":"昨儿听先生鄙薄那肥遁鸣高的人，说道：天地生才有限，不宜妄自菲薄。","book":"清·刘鹗《老残游记》第六回"}},{"id":47519,"word":"飞金走玉","pinyin":"fēi jīn zǒu yù","abbr":"fjzy","explanation":"金：金乌，传说日中有三足乌，因指太阳；玉：玉兔，传说月中有玉兔，因指月亮。形容时光飞逝。","source":{"text":"看天边，飞金走玉难留。","book":"宋·曹勋《满庭芳》词"}},{"id":47520,"word":"飞针走线","pinyin":"fēi zhēn zǒu xiàn","abbr":"fzzx","explanation":"走：跑。形容缝纫技术非常熟练。","source":{"text":"问：‘孤灯不自照，室内事如何？’师云：‘飞针走线时人会，两边绣过却还稀。’","book":"《祖堂集·洛甫和尚》"},"example":{"text":"若提起女工一事，～，出人意表。","book":"明·冯梦龙《醒世恒言》卷三"},"similar":["走线飞针"],"usage":"作谓语、定语、状语；用于口语"},{"id":47521,"word":"飞阁流丹","pinyin":"fēi gé liú dān","abbr":"fgld","explanation":"飞阁：架空建造的阁道；流丹：彩饰的漆鲜艳欲流。凌空建造的阁道涂有鲜艳欲流的丹漆。形容建筑物的精巧美丽。","source":{"text":"层峦耸翠，上出重霄，飞阁流丹，下临无地。","book":"唐·王勃《滕王阁序》"},"usage":"作宾语、定语；用于建筑物"},{"id":47522,"word":"飞雁展头","pinyin":"fēi yàn zhǎn tóu","abbr":"fyzt","explanation":"比喻不了解情况，凭主观想象做事着。","source":{"text":"黄荃画飞雁，头足皆展。或曰飞鸟缩头则展足，缩足则展头，无两者展，验之信然。","book":"宋·苏轼《仇池笔记》"}},{"id":47523,"word":"飞霜六月","pinyin":"fēi shuāng liù yuè","abbr":"fsly","explanation":"旧时比喻有冤狱。","source":{"text":"匹夫结愤，六月飞霜。","book":"唐·张说《狱箴》"},"example":{"text":"你道是暑气暄，不是那下雪天，岂不闻～因邹衍。","book":"元·关汉卿《窦娥冤》第三折"},"similar":["六月飞霜"],"usage":"作宾语、定语；比喻有冤狱、冤情"},{"id":47524,"word":"飞鸟之景","pinyin":"fēi niǎo zhī yǐng","abbr":"fnzj","explanation":"景：通“影”。飞鸟的影子是不动的。比喻事物具有动中有静的的变动关系。","source":{"text":"飞鸟之景，未尝动也。","book":"《庄子·天下篇》"}},{"id":47525,"word":"飞鸟依人","pinyin":"fēi niǎo yī rén","abbr":"fnyr","explanation":"依：依恋。飞来的小鸟依偎在人的身边。比喻依附权贵。亦比喻小孩、少女娇小柔顺，可亲可受的情态。","source":{"text":"今嵩之父死如路人，方经营内引，摇尾乞怜，作飞鸟依人之态。","book":"宋·阙名《宋季三朝正要·二·理宗淳祐四年》"},"example":{"text":"善画兰，亦工诗；丰姿绰约，如～。","book":"清·冯仙湜《图绘宝鉴续篡·三·女史·叶文》"},"similar":["小鸟依人"],"usage":"作宾语、定语；用于女性"},{"id":47526,"word":"飞鸟惊蛇","pinyin":"fēi niǎo jīng shé","abbr":"fnjs","explanation":"像飞鸟入林，受惊的蛇窜入草丛一样。形容草书自然流畅。","source":{"text":"唐时一僧释亚楼善草书，曾自题一联：‘飞鸟入林，惊蛇入草。’","book":"《法书苑》"},"usage":"作宾语、定语；多用于比喻句"},{"id":47527,"word":"飞鸾翔凤","pinyin":"fēi luán xiáng fèng","abbr":"flxf","explanation":"指英俊才识之士。","source":{"text":"诸公飞鸾翔凤，望重时流。","book":"明·许三阶《节侠记·侠晤》"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":47528,"word":"飞鸿冥冥","pinyin":"fēi hóng míng míng","abbr":"fhmm","explanation":"冥冥：遥空。大雁飞向远空。比喻远走避祸。","source":{"text":"鸿飞冥冥，弋人何篡焉？","book":"汉·扬雄《法言·问明》"},"similar":["鸿飞冥冥"],"usage":"作谓语；比喻远走避祸"},{"id":47529,"word":"飞鸿印雪","pinyin":"fēi hóng yìn xuě","abbr":"fhyx","explanation":"鸿：大雁。大雁踩过的雪地。比喻事情经过所留下的痕迹。","source":{"text":"人生到处知何似？应似飞鸿踏雪泥。","book":"宋·苏轼《和子由渑池怀旧》"},"example":{"text":"生死去来兮不碍真圆，～兮爪趾宛然。","book":"明·宋濂《大天界寺住持白庵禅师行业碑铭》"},"similar":["飞鸿雪爪"],"usage":"作宾语、定语；比喻事情经过所留下的痕迹","story":["宋朝时期，苏轼与苏辙兄弟曾在渑池一寺院住过，与寺院老和尚关系很好，并在寺内墙上题诗。后苏轼故地重游作《和子由渑池怀旧》诗大发感慨：“人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。”"]},{"id":47530,"word":"飞鸿戏海","pinyin":"fēi hóng xì hǎi","abbr":"fhxh","explanation":"像飞翔的鸿雁在海上嬉戏。形容笔法矫健活泼。","source":{"text":"臣谓钟繇书意气密丽，若飞鸿戏海，舞鹤游天。","book":"《法书要录》卷二"}},{"id":47531,"word":"飞鸿羽翼","pinyin":"fēi hóng yǔ yì","abbr":"fhyy","explanation":"羽翼：翅膀，引申为辅佐。象飞翔的大雁有翅膀。比喻得力的辅佐之人。","source":{"text":"寡人之有仲父也，犹飞鸿之有羽翼也。","book":"《管子·霸形》"}},{"id":47532,"word":"飞鸿踏雪","pinyin":"fēi hóng tà xuě","abbr":"fhtx","explanation":"鸿：大雁。大雁踩过的雪地。比喻事情经过所留下的痕迹。","source":{"text":"人生到处知何似？应似飞鸿踏雪泥。","book":"宋·苏轼《和子由渑池怀旧》"},"similar":["飞鸿印雪"],"usage":"作宾语、定语；指往事留下的痕迹","story":["宋朝时期，苏轼与苏辙兄弟曾在渑池一寺院住过，与寺院老和尚关系很好，并在寺内墙上题诗。后苏轼故地重游作《和子由渑池怀旧》诗大发感慨：“人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。”"]},{"id":47533,"word":"飞鸿雪爪","pinyin":"fēi hóng xuě zhǎo","abbr":"fhxz","explanation":"比喻事情经过所留下的痕迹。同“飞鸿印雪”。","source":{"text":"人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。","book":"宋·苏轼《和子由渑池怀旧》诗"},"example":{"text":"浮世～，故山乱叶茅蓭。","book":"清·陈维菘《风入松·纳凉》词"},"similar":["飞鸿踏雪"],"usage":"作宾语、定语；指往事印痕","story":["宋朝时期，苏轼与苏辙兄弟曾在渑池一寺院住过，与寺院老和尚关系很好，并在寺内墙上题诗。后苏轼故地重游作《和子由渑池怀旧》诗大发感慨：“人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。”"]},{"id":47534,"word":"飞鹰奔犬","pinyin":"fēi yīng bēn quǎn","abbr":"fybq","explanation":"放出鹰和狗去追捕野兽。指打猎。同“飞鹰走狗”。","source":{"text":"或打球击鼓，比周伎艺；或飞鹰奔犬，盘游薮泽。","book":"唐·柳泽《上睿宗书》"},"similar":["飞鹰走马","飞鹰走狗","飞鹰走犬"],"usage":"作宾语、定语；指打猎"},{"id":47535,"word":"飞鹰走犬","pinyin":"fēi yīng zǒu quǎn","abbr":"fyzq","explanation":"指打猎游荡的生活。同“飞鹰走狗”。","source":{"text":"我如今欲待去消愁闷，则除是飞鹰走犬，逐逝追奔。","book":"元·李直夫《虎头牌》第一折"},"example":{"text":"却说曹爽正～之际，忽报城内有变，太傅有表。","book":"《三国演义》第一○七回"},"similar":["飞鹰走马","飞鹰走狗"],"usage":"作宾语、定语；指打猎"},{"id":47536,"word":"飞鹰走狗","pinyin":"fēi yīng zǒu gǒu","abbr":"fyzg","explanation":"放出鹰狗去追捕野兽。指打猎游荡的生活。","source":{"text":"少以侠气闻，数与诸公子飞鹰走狗。","book":"《东观汉记·耿恭传》：“将兵不忧，军士肆心放纵欲，飞鹰走狗，游戏道上。”《后汉书·袁术传》"},"example":{"text":"古者帝王端居九重之上，日与大臣宿儒讲求治道，至于～，非其事也。","book":"《元史·脱脱传》"},"similar":["飞鹰走犬"],"usage":"作宾语、定语；指打猎","story":["东汉末年，权臣袁术年轻时不务正业，经常飞鹰走狗，恣意享乐。他当南阳太守时，生活十分奢侈浪费，经常到民间哄抢财物。建安二年，他不顾部下的反对在寿春称帝，整天是山珍海味，而下属都处于饥饿贫困之中，百姓对他恨之入骨"]},{"id":47537,"word":"飞鹰走马","pinyin":"fēi yīng zǒu mǎ","abbr":"fyzm","explanation":"放鹰追捕和骑马追逐鸟兽。指打猎。","source":{"text":"沔今年虽七十，闻其心力不衰，飞鹰走马尚如平日。","book":"宋·欧阳修《乞奖用孙沔札子》"},"similar":["飞鹰走犬","飞鹰奔犬","飞鹰走狗"],"usage":"作宾语、定语；指打猎"},{"id":47538,"word":"飞黄腾踏","pinyin":"fēi huáng téng tà","abbr":"fhtt","explanation":"形容马的飞驰。后多比喻官职地位升得很快。","source":{"text":"飞黄腾踏去，不能顾蟾蜍。","book":"唐·韩愈《符读书城南》诗"},"example":{"text":"～有天倪，紫电转盼天山低。","book":"元·陈赓《武善夫桃源图》诗"},"similar":["飞黄腾达","蜚黄腾达"],"opposite":["江河日下"],"usage":"作谓语、定语；指地位升得快","story":["唐宋八大家之首韩愈的儿子韩符少年时十分贪玩，不喜欢读书，韩愈专门写诗教育儿子要立志飞黄腾达，诗文即：“两家各生子，孩提巧相如，少长聚嬉戏，不殊同队鱼……三十骨骼成，乃一龙一猪，飞黄腾踏去，不能顾蟾蜍。”"]},{"id":47539,"word":"飞黄腾达","pinyin":"fēi huáng téng dá","abbr":"fhtd","explanation":"飞黄：传说中神马名；腾达：上升，引伸为发迹，宦途得意。形容骏马奔腾飞驰。比喻骤然得志，官职升得很快。","source":{"text":"飞黄腾踏去，不能顾蟾蜍。","book":"唐·韩愈《符读书城南》诗"},"example":{"text":"他进过种种培植新政人才的讲习班和训练班，虽然结果没有一项使他～。","book":"沙汀《防空》"},"similar":["青云直上","平步青云"],"opposite":["江河日下","日暮途穷"],"usage":"作谓语、定语；指地位升得快","story":["唐宋八大家之首韩愈的儿子韩符少年时十分贪玩，不喜欢读书，韩愈专门写诗教育儿子要立志飞黄腾达，诗文即：“两家各生子，孩提巧相如，少长聚嬉戏，不殊同队鱼……三十骨骼成，乃一龙一猪，飞黄腾踏去，不能顾蟾蜍。”"]},{"id":47540,"word":"飞龙乘云","pinyin":"fēi lóng chéng yún","abbr":"flcy","explanation":"龙乘云而上天，比喻英雄豪杰乘时而得势。","source":{"text":"飞龙乘云，腾蛇游雾……夫有云雾之势而能乘游之者，龙蛇之材美之也。","book":"战国·韩·韩非《韩非子·难势》"},"example":{"text":"这对他来说就像～一样。"},"opposite":["虎落平川","龙游浅滩"],"usage":"作宾语；指得势"},{"id":47541,"word":"飞龙在天","pinyin":"fēi lóng zài tiān","abbr":"flzt","explanation":"比喻帝王在位。","source":{"text":"谓有圣德之人得居王位。","book":"《周易·乾》：“九五，飞龙在天，利见大人。”孔颖达疏"},"example":{"text":"～，方仰君临之德；流虹绕渚，宝开圣作之祥。","book":"宋·陆游《丞相率文武百僚请建重明节表》"},"usage":"作谓语、宾语、定语；用于帝王等"},{"id":47542,"word":"飞龙舞凤","pinyin":"fēi lóng wǔ fèng","abbr":"flwf","explanation":"原形容山势的蜿蜒雄壮。后也形容书法笔势有力，灵活舒展。","source":{"text":"飞龙舞凤，郁葱环拱吴越。","book":"宋·吴琚《念奴娇》词"},"example":{"text":"身穿一领～赭黄袍，足踏一双云头绣口无忧履，手执一柄列斗罗星白玉圭。","book":"明·吴承恩《西游记》第三十七回"}},{"id":47543,"word":"食不下咽","pinyin":"shí bù xià yàn","abbr":"sbxy","explanation":"食物虽在口中但咽不下去。形容忧心忡忡，不思饮食。","source":{"text":"霁云（南霁云）慷慨语曰：‘云来时，睢阳之人不食月余日矣！云虽欲独食，义不忍；虽食，且不下咽。’","book":"唐·韩愈《张中丞传后叙》"},"example":{"text":"这顿饭虽说也有鸡、鸭、鱼、肉，可是当伙计的都提心吊胆，～。","book":"欧阳山《苦斗》七三"},"similar":["食不甘味"],"usage":"作谓语、定语；指不思饮食"},{"id":47544,"word":"食不二味","pinyin":"shí bù èr wèi","abbr":"sbew","explanation":"吃饭不用两道菜肴。谓饮食节俭。","source":{"text":"食不二味，坐不重席。","book":"《左传·哀公元年》：“昔阖庐食不二味，居不重席，室不崇坛，器不彤镂，宫室不观，舟车不饰，衣服财用，择不取费。”《韩非子·外储说左下》"},"example":{"text":"食不贰味，以与民同利，昔之君子之行礼者如此。","book":"《大戴礼记·哀公问于孔子》"},"similar":["食不重味","食不兼味"],"opposite":["大吃大喝","食案方丈","食必方丈"],"usage":"作谓语、定语；指生活俭朴"},{"id":47545,"word":"食不充口","pinyin":"shí bù chōng kǒu","abbr":"sbck","explanation":"不能吃饱肚子。形容生活艰难困苦。同“食不糊口”。","source":{"text":"自来到黄州，举眼无亲，借得两间破房住着。衣不盖身，食不充口，无一个人来看顾。","book":"元·秦简夫《赵礼让肥》第一折：“兄弟，俺如今衣不遮身，食不充口，兀的不穷杀俺也！” 元·费唐臣《贬黄州》第三折"},"example":{"text":"真是衣不遮身，～，吃了早起的，无那晚夕的。","book":"明·凌蒙初《初刻拍案惊奇》卷三十五"},"similar":["食不糊口"],"usage":"作定语、状语；用于生活"},{"id":47546,"word":"食不充肠","pinyin":"shí bù chōng cháng","abbr":"sbcc","explanation":"形容艰难贫困，勉强维持生活。同“食不充饥”。","source":{"text":"臣八岁丧父，家贫无业，母兄乞丐以供资养，衣不布体，食不充肠。","book":"唐·元稹《同州刺史谢上表》"},"similar":["食不充饥"],"usage":"作谓语、定语；指生活艰难"},{"id":47547,"word":"食不充饥","pinyin":"shí bù chōng jī","abbr":"sbcj","explanation":"形容艰难贫困，勉强维持生活。","source":{"text":"而诸孙纩不温体，食不充饥，付之姆你之手。","book":"南朝·宋·刘或《立晋熙王嗣诏》"},"example":{"text":"我们再不想过那种～的日子。"},"similar":["食不果腹","食不充肠"],"usage":"作谓语、定语；指生活艰难"},{"id":47548,"word":"食不兼味","pinyin":"shí bù jiān wèi","abbr":"sbjw","explanation":"吃饭不用两道菜肴。指饮食节俭。同“食不二味”。","source":{"text":"大侵之礼，君食不兼味，台榭不饰，道路不除。","book":"《韩诗外传》卷八"},"example":{"text":"[江革]至镇，惟资公俸，～。","book":"《梁书·江革传》"},"similar":["食不二味","食不累味"],"opposite":["大吃大喝","食案方丈","食必方丈"],"usage":"作谓语、定语；指生活俭朴"},{"id":47549,"word":"食不兼肉","pinyin":"shí bù jiān ròu","abbr":"sbjr","explanation":"吃饭时无两种肉食。形容饮食俭朴。","source":{"text":"昔晋国苦奢，文公以俭矫之，乃衣不重帛，食不兼肉，无几时，人皆大布之衣，脱粟之饭。","book":"《尹文子·大道上》"},"similar":["食不重肉"],"usage":"作谓语、定语；用于生活"},{"id":47550,"word":"食不厌精，脍不厌细","pinyin":"shí bù yàn jīng，kuài bù yàn xì","abbr":"sbyjkbyx","explanation":"厌：满足；脍：细切的肉。粮食舂得越精越好，肉切得越细越好。形容食物要精制细做。","source":{"text":"斋必变食，居必迁坐。食不厌精，脍不厌细。","book":"《论语·乡党》"},"example":{"text":"“割不正不食”这是他老先生的古板规矩，但“～”的条令却有些稀奇。","book":"鲁迅《南腔北调集·由中国女人的脚……》"},"usage":"作宾语、定语、分句；形容食物要精制细做","story":["春秋时期，被人们称为“四体不勤，五谷不分”的孔子，在吃穿住行方面十分讲究，他的原则是食不厌精，脍不厌细。粮食陈旧或变味，鱼肉不新鲜了，他都不吃。席上吃肉的量不能超过米面的数量，酒可以随便喝但不能喝醉"]},{"id":47551,"word":"食不念饱","pinyin":"shí bù niàn bǎo","abbr":"sbnb","explanation":"吃饭不要求吃得很饱。","source":{"text":"居不求安，食不念饱。","book":"《后汉书·明德马皇后纪》"},"similar":["食不求饱","食无求饱"],"usage":"作宾语、定语；指饮食要有节制"},{"id":47552,"word":"食不暇饱","pinyin":"shí bù xiá bǎo","abbr":"sbxb","explanation":"没空好好吃饭。形容终日操劳忙碌。","source":{"text":"当是之时，食不暇饱，寝不遑安。","book":"宋·司马光《进五规状·保业》"},"example":{"text":"他每天都～，没日没夜。"},"similar":["废寝忘食"],"usage":"作谓语、定语；指终日操劳"},{"id":47553,"word":"食不果腹","pinyin":"shí bù guǒ fù","abbr":"sbgf","explanation":"果：充实，饱。指吃不饱肚子。形容生活贫困。","source":{"text":"適莽苍者，三餐而反，腹犹果然。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"人民生活更加贫困，衣不蔽体，～。","book":"郭沫若《中国史稿》第三编第三章第一节"},"similar":["饥肠辘辘"],"opposite":["酒足饭饱"],"usage":"作谓语、定语；形容生活艰难"},{"id":47554,"word":"食不求甘","pinyin":"shí bù qiú gān","abbr":"sbqg","explanation":"饮食不求甘美。形容生活俭朴。","source":{"text":"吾为天下母，而身服大练，食不求甘，左右但著帛布。","book":"南朝·宋·范晔《后汉书·明德马皇后纪》"},"example":{"text":"～的日子不堪回首。"},"usage":"作谓语、定语；指生活俭朴"},{"id":47555,"word":"食不求饱","pinyin":"shí bù qiú bǎo","abbr":"sbqb","explanation":"吃饭不要求吃得很饱。","source":{"text":"宽饶居不求安，食不求饱，进有忧国之心，退有死节之义。","book":"《汉书·盖宽饶传》"},"similar":["食不念饱","食无求饱"],"usage":"作宾语、定语；指饮食要有节制"},{"id":47556,"word":"食不甘味","pinyin":"shí bù gān wèi","abbr":"sbgw","explanation":"甘味：感到味道好。吃东西都觉得没有味道。形容心里有事，吃东西也不香。","source":{"text":"秦王恐之，寝不安席，食不甘味。","book":"《战国策·齐策五》"},"example":{"text":"只有我觍然面目，偷生人世。所以～，麻衣茹素，稍谢罪戾。","book":"清·吴趼人《痛史》第十一回"},"similar":["忐忑不安","如坐针毡","食不遑味"],"opposite":["泰然处之","心安理得"],"usage":"作谓语、定语；形容心神不安","story":["战国时期，纵横家苏秦用离间六国、各个击破的连横策略去游说秦惠文王，主意没被采纳，就改用六国联合抗秦的合纵策略去游说赵国，被封为武安君，然后游说楚威王说秦国强大对楚国十分不利。楚威王感慨万千说这正是他食不甘味的原因"]},{"id":47557,"word":"食不知味","pinyin":"shí bù zhī wèi","abbr":"sbzw","explanation":"形容心里有事，吃东西也不香。同“食不甘味”。","source":{"text":"臣所以授官已来，仅将十日：食不知味，寝不遑安；唯思粉身，以答殊宠，但未获粉身之所耳。","book":"唐·白居易《初授给遗献书》"},"similar":["食不遑味","食不终味","食不甘味"],"usage":"作定语、状语；用于处事"},{"id":47558,"word":"食不糊口","pinyin":"shí bù hú kǒu","abbr":"sbhk","explanation":"不能吃饱肚子。形容生活十分穷困。","source":{"text":"流亡初夏，贫鞠兼半，食不糊口，力未赡农。","book":"唐·陈子昂《汉州雒县令张君吏人颂德碑》"},"similar":["食不充口"],"usage":"作定语、状语；用于生活"},{"id":47559,"word":"食不累味","pinyin":"shí bù lèi wèi","abbr":"sblw","explanation":"吃饭不用两道菜肴。指饮食节俭。同“食不二味”。","source":{"text":"土阶三尺，茅茨不翦，食不累味，刑措而不用。","book":"《晋书·石季龙载记上》"},"similar":["食不兼味","食不二味"],"opposite":["大吃大喝","食案方丈","食必方丈"],"usage":"作谓语、定语；指生活俭朴"},{"id":47560,"word":"食不终味","pinyin":"shí bù zhōng wèi","abbr":"sbzw","explanation":"形容心里有事，吃东西也不香。同“食不甘味”。","source":{"text":"坐不安席，食不终味，遑遑汲汲，或惟或悴。","book":"三国·魏·曹植《释愁文》"},"similar":["食不知味","食不遑味","食不甘味"],"usage":"作定语、状语；用于处事"},{"id":47561,"word":"食不遑味","pinyin":"shí bù huáng wèi","abbr":"sbhw","explanation":"形容心里有事，吃东西也不香。同“食不甘味”。","source":{"text":"今臣居外，非不厚也，而寝不安席，食不遑味者，伏以二方未克为念！","book":"三国·魏·曹植《求自试表》"},"similar":["食不知味","食不甘味"],"usage":"作定语、状语；用于处事"},{"id":47562,"word":"食不重味","pinyin":"shí bù chóng wèi","abbr":"sbcw","explanation":"味：菜肴。吃饭不要两样菜肴。形容生活俭朴。","source":{"text":"越王勾践食不重味，衣不重采，吊死问疾，且欲有所用其众。","book":"《韩非子·外储说左下》：“食不二味，坐不重席。”《史记·吴太伯世家》"},"example":{"text":"清·石玉昆《小五义》第98回：“却安于节俭，茅茨不剪，采椽不斫，后宫妃妾，衣不重彩，～。”"},"similar":["食不二味","食不兼味"],"opposite":["大吃大喝","食案方丈","食必方丈"],"usage":"作谓语、定语；指生活俭朴"},{"id":47563,"word":"食不重肉","pinyin":"shí bù zhóng ròu","abbr":"sbcr","explanation":"吃饭不用两道肉食。指饮食节俭。同“食不兼肉”。","source":{"text":"[晏婴]既相齐，食不重肉，妾不衣帛。","book":"《史记·管晏列传》"},"similar":["食不兼肉"],"usage":"作谓语、定语；用于生活"},{"id":47564,"word":"食不餬口","pinyin":"shí bù hú kǒu","abbr":"sbhk","explanation":"不能吃饱肚子。形容生活艰难困苦。"},{"id":47565,"word":"食为民天","pinyin":"shí wéi mín tiān","abbr":"swmt","explanation":"指粮食是人民赖以生存的最为重要的东西。","source":{"text":"夫食为民天，民非食不生矣，三日不粒，父子不能相存。","book":"北齐·颜之推《颜氏家训·涉务》"},"example":{"text":"～，有食斯有民。","book":"清·冯桂芬《〈校邠庐抗议〉自序》"},"similar":["民以食为天"],"usage":"作宾语、定语；用于生活"},{"id":47566,"word":"食之无味，弃之不甘","pinyin":"shí zhī wú wèi，qì zhī bù gān","abbr":"szwwqzbg","explanation":"味：滋味。吃起来没有滋味，丢掉它又可惜。形容东西无大用处但又舍不得抛弃。","source":{"text":"这一种杂志，大约小峰是食之无味，弃之不甘也。","book":"鲁迅《书信集·致章廷谦》"},"similar":["食之无味，弃之可惜"],"usage":"作宾语、定语、谓语；用于处事"},{"id":47567,"word":"食之无味，弃之可惜","pinyin":"shí zhī wú wèi，qì zhī kě xī","abbr":"szwwqzkx","explanation":"吃起来没有什么味道，扔掉又有点可惜。比喻事情进行下去没多大必要，就此放手又舍不得。也形容进退两难，犹豫不决。","source":{"text":"夫鸡肋，弃之如可惜，食之无所得，以比汉中，知王欲还也。","book":"《三国志·魏志·武帝纪》裴松之注引《九州春秋》"},"similar":["食之无味，弃之不甘"],"usage":"作宾语、定语、谓语；用于处事","story":["公元217年，夏侯渊被刘备杀死，汉中失守。曹操率大军前去汉中，双方对峙几个月，曹军处境越来越不妙。一天晚上曹操吃饭发现汤中有鸡肋，随口说出“鸡肋”两字，被杨修误以为是退兵的意思。第二天曹操果然下令回师"]},{"id":47568,"word":"食亲财黑","pinyin":"shí qīn cái hēi","abbr":"sqch","explanation":"指人贪婪自私，爱占便宜。"},{"id":47569,"word":"食前方丈","pinyin":"shí qián fāng zhàng","abbr":"sqfz","explanation":"方丈：一丈见方。吃饭时面前一丈见方的地方摆满了食物。形容吃的阔气。","source":{"text":"食前方丈，侍妾数百人，我得志弗为也。","book":"《孟子·尽心下》"},"example":{"text":"见着老人家的～侍妾数百人的行径，不禁羡慕。","book":"清·李宝嘉《文明小史》第五十七回"},"similar":["食必方丈","食案方丈","食味方丈"],"opposite":["食不二味","食不重味"],"usage":"作谓语、定语；形容吃的阔气","story":["战国时期，孟子要求自己的学生积极宣传自己的政治主张，要学生不要气馁，不要被对方显赫威势所吓倒。面对这些王公大臣高堂大屋、食前方丈、侍妾数百，马上想到自己一旦得志，绝不像他们这样做，自己就不会心怯"]},{"id":47570,"word":"食古不化","pinyin":"shí gǔ bù huà","abbr":"sgbh","explanation":"指对所学的古代知识理解得不深不透，不善于按现在的情况来运用，跟吃不东西不消化一样。","source":{"text":"可见定欲为古人而食古不化，画虎不成、刻舟求剑之类也。","book":"清·陈撰《玉几山房画外录》卷下载恽向《题自作画册》"},"example":{"text":"如果不用辩证唯物主义观点去研究古代文化遗产，就会～。"},"similar":["泥古不化","墨守成规"],"opposite":["推陈出新"],"usage":"作谓语、定语；指人守旧"},{"id":47571,"word":"食古如鲠","pinyin":"shí gǔ rú gěng","abbr":"sgrg","explanation":"犹言食古不化。指对所学的古代知识理解得不深不透，不善于按现在的情况来运用，跟吃不东西不消化一样。","source":{"text":"卷盦《〈蔽庐丛志〉序》；“又或食古如鲠，刻鹄成鹜，崎錡训诂，恒迟回于‘秃伏禾’之文；墨守六书，复牵就于‘马头人’之义。”"},"similar":["食古不化"],"usage":"作宾语、定语；多用于比喻句"},{"id":47572,"word":"食味方丈","pinyin":"shí wèi fāng zhàng","abbr":"swfz","explanation":"形容吃的阔气。同“食前方丈”。","source":{"text":"昔吾先君桓公善饮酒穷乐，食味方丈。","book":"《晏子春秋·问下二》"},"similar":["食案方丈","食前方丈","食方于前"],"opposite":["食不二味","食不重味"],"usage":"作谓语、定语；形容吃的阔气"},{"id":47573,"word":"食子徇君","pinyin":"shí zǐ xùn jūn","abbr":"szxj","explanation":"谓吃自己儿子的肉以媚主邀功。"},{"id":47574,"word":"食宿相兼","pinyin":"shí sù xiāng jiān","abbr":"ssxj","explanation":"比喻幻想同时实现两个互相矛盾的目标。","source":{"text":"齐人有女，二人求之。……父母疑不能决，问其女：‘定所欲适，难指斥言者，偏袒令我知之。’女便两袒，怪问其故。云：‘欲东家食，西家宿。’","book":"汉·应劭《风俗通·两袒》"},"example":{"text":"盾矛互陷多奇疾，～乏好方。","book":"清·钱谦益《甲子秋北上渡淮寄里中游好》诗"},"similar":["东食西宿"],"usage":"作谓语、宾语；指两者兼顾","story":["齐国有一个年轻貌美的女子，东西两家公子同时来求婚，东家公子很富有但相貌丑陋，西家公子是一个英俊的穷书生，姑娘的父母很为难，叫姑娘自己定夺，她说两个都愿意嫁，白天在东家吃饭，晚上去西家睡觉，食宿兼顾"]},{"id":47575,"word":"食少事烦","pinyin":"shí shǎo shì fán","abbr":"sssf","explanation":"每日吃饭很少，可是处理的事务非常繁重。形容工作辛劳，身体不佳。","source":{"text":"先是，亮使至，帝问曰：‘诸葛公起居何如？食可几（许）米？’对曰：‘三四升。’次问政事，曰：‘二十罚已上皆自省览。’帝既而告人曰：‘诸葛孔明其能久乎！’","book":"《晋书·宣帝纪》"},"example":{"text":"既而又因感激三顾，许人驱弛，～，至死方已。","book":"清·金圣叹《西厢记序》"},"similar":["食少事繁"],"usage":"作谓语；形容身体衰弱，不堪承受繁重任务","story":["三国时期，蜀国丞相诸葛亮每天都是废寝忘食地工作，刘备关心他问他一天的起居饮食情况，能吃多少米，诸葛亮答道：“只吃三四升米。每天要亲自处理20多宗各种军事问题。”刘备逢人就夸诸葛亮吃得少而处理的时期很繁多"]},{"id":47576,"word":"食少事繁","pinyin":"shí shǎo shì fán","abbr":"sssf","explanation":"形容工作辛劳，身体不佳。同“食少事烦”。","source":{"text":"先是，亮（诸葛亮）使至，帝问曰：‘诸葛公起居何如？食可几（许）米？’对曰：‘三四升。’次问政事，曰：‘二十罚已上皆自省览。’","book":"《晋书·宣帝纪》"},"example":{"text":"他的‘～’使我为他忧虑。","book":"郭沫若《南京印象》"},"similar":["食少事烦"],"usage":"作谓语；形容身体衰弱，不堪承受繁重任务","story":["三国时期，蜀国丞相诸葛亮每天都是废寝忘食地工作，刘备关心他问他一天的起居饮食情况，能吃多少米，诸葛亮答道：“只吃三四升米。每天要亲自处理20多宗各种军事问题。”刘备逢人就夸诸葛亮吃得少而处理的时期很繁多"]},{"id":47577,"word":"食必方丈","pinyin":"shí bì fāng zhàng","abbr":"sbfz","explanation":"形容吃的阔气。同“食前方丈”。","source":{"text":"性奢豪，食必方丈，旦辄为十人馔。","book":"《宋书·刘穆之传》"},"similar":["食案方丈","食前方丈"],"opposite":["食不二味"],"usage":"作谓语、定语；形容吃的阔气"},{"id":47578,"word":"食指众多","pinyin":"shí zhǐ zhòng duō","abbr":"szzd","explanation":"食指：比喻家庭人口。家庭人口多。","source":{"text":"食指众多，赡畜非易。","book":"清·百一居士《壶天录》上卷"},"usage":"作谓语、定语；用于书面语"},{"id":47579,"word":"食指大动","pinyin":"shí zhǐ dà dòng","abbr":"szdd","explanation":"原指有美味可吃的预兆，后形容看到有好吃的东西而贪婪的样子。","source":{"text":"楚人献鼋于郑灵公，公子宋与子家将见，子公之食指动，以示子家，必尝异味。","book":"春秋·鲁·左丘明《左传·宣公四年》"},"example":{"text":"～的预兆不一定准。"},"usage":"作谓语、定语；指有美味可吃的预兆","story":["春秋时期，楚国人送给郑灵公几只大甲鱼，大夫子公听到消息，对公子归生说只要他食指大动就有美食可吃。公子归生与子公一起去赴甲鱼宴，郑灵公十分反感他，就让侍从故意不分给他甲鱼。子公扔掉盘子，用食指蘸点汤尝了尝"]},{"id":47580,"word":"食指浩繁","pinyin":"shí zhǐ hào fán","abbr":"szhf","explanation":"食指：手的第二指。古时以手指计人口，从此指家庭人口。比喻家庭人口很多。","source":{"text":"而女督课婢仆严，食指数百无冗口。","book":"清·蒲松龄《聊斋志异·小二》"},"example":{"text":"城中食指浩繁，履舄交错，乡下也地难养丁，人满为患……（李存葆《祖槐》八）"}},{"id":47581,"word":"食指繁多","pinyin":"shí zhǐ fán duō","abbr":"szfd","explanation":"食指：手的第二指。古时以手指计人口，从此指家庭人口。比喻家庭人口很多。","source":{"text":"而女督课婢仆严，食指数百无冗口。","book":"清·蒲松龄《聊斋志异·小二》"},"example":{"text":"小时候，我们俩在一个学塾里读过书，我家～，入不敷出，考了两场，也没能进得了学。","book":"吴越《括苍山记恩仇》第二十七回"}},{"id":47582,"word":"食方于前","pinyin":"shí fāng yú qián","abbr":"sfyq","explanation":"形容吃的阔气。同“食前方丈”。","source":{"text":"楚王聘陈子仲为相，仲谓妻曰：‘今日为相，明日结驷连骑，食方于前矣。’","book":"明·冯梦龙《智囊补·闺智·陈子仲妻》"},"similar":["食前方丈","食案方丈","食必方丈"],"opposite":["食不重味","食不兼味"],"usage":"作谓语、定语；形容吃的阔气"},{"id":47583,"word":"食无求饱","pinyin":"shí wú qiú bǎo","abbr":"swqb","explanation":"饮食不要求饱。指饮食要节制。","source":{"text":"君子食无求饱，居无求安。","book":"春秋·鲁·孔丘《论语·学而》"},"example":{"text":"我们要～，不能暴饮暴食。"},"similar":["食不求饱","食不念饱"],"usage":"作宾语、定语；指饮食要有节制","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，他们的生活十分拮据，经常是三月不知肉味，为此不得不用“君子食无求饱”来教育弟子跟他过苦行僧的生活"]},{"id":47584,"word":"食无求饱，居无求安","pinyin":"shí wú qiú bǎo，jū wú qiú ān","abbr":"swqbjwqa","explanation":"饮食不要求饱，居住不要求安逸舒适。指对生活要求不高。","source":{"text":"君子食无求饱，居无求安，敏于事而慎于言。","book":"《论语·学而》"}},{"id":47585,"word":"食日万钱","pinyin":"shí rì wàn qián","abbr":"srwq","explanation":"每天饮食要花费上万的钱。形容饮食极奢侈。","source":{"text":"食日万钱，犹曰无下箸处。","book":"《晋书·何曾传》"},"example":{"text":"他过着～的奢侈生活。"},"similar":["食前方丈","日食万钱"],"usage":"作谓语、定语；指饮食极奢侈","story":["西晋初年，位列三公号称孝子仁人的何曾标榜自己按礼法行事，他就是对自己的妻子说话也要衣冠整齐。他曾指责名士阮籍在守孝期间大吃大喝，大违孝道，而他自己却十分讲究吃喝，每顿饭要吃掉一万铜钱还感觉没可吃的东西"]},{"id":47586,"word":"食案方丈","pinyin":"shí àn fāng zhàng","abbr":"safz","explanation":"形容吃的阔气。同“食前方丈”。","source":{"text":"高台极望，食案方丈，而不可谓孝。","book":"汉·桓宽《盐铁论·孝养》"},"similar":["食必方丈","食前方丈"],"opposite":["食不二味"],"usage":"作谓语、定语；形容吃的阔气"},{"id":47587,"word":"食毛践土","pinyin":"shí máo jiàn tǔ","abbr":"smjt","explanation":"毛：指地面所生之谷物；贱：踩。原意是吃的食物和居住的土地都是国君所有。封建官吏用以表示感戴君主的恩德。","source":{"text":"封略之内，何非君土；食土之毛，谁非君臣？","book":"《左传·昭公七年》"},"example":{"text":"～偏知感，地厚天高乱颂扬。","book":"清·吴趼人《痛史》第二十一回"},"usage":"作谓语；用于感戴恩德"},{"id":47588,"word":"食淡衣粗","pinyin":"shí dàn yī cū","abbr":"sdyc","explanation":"吃清淡食物，穿粗布衣服。形容生活朴素。","source":{"text":"退居之后决不能食淡衣粗，杜门绝客。","book":"宋·苏轼《与蒲传正》"},"opposite":["锦衣玉食"],"usage":"作谓语、定语、宾语；用于生活"},{"id":47589,"word":"食玉炊桂","pinyin":"shí yù chuī guì","abbr":"sycg","explanation":"食品贵如油，燃料贵如桂。比喻物价昂贵。","source":{"text":"楚国之食贵于玉，薪贵于桂，谒者难得见如鬼，王难得见如天帝。今令臣食玉炊桂，因鬼见帝。","book":"西汉·刘向《战国策·楚策三》"},"example":{"text":"巫咸上天皋陶远，～不可居。","book":"清·陈梦雷《行路难》诗"},"similar":["米珠薪桂"],"usage":"作谓语、补语；指生活艰难","story":["战国时期，纵横家苏秦擅长辩论，凭一张嘴到处游说。他去楚国要求见楚王，把守宫门的谒者索贿不成，故意陷害他，让他先住三天，卖给他的东西特别贵。楚王见苏秦后，谈得非常投机。苏秦说楚国的米像玉石、柴火像桂木一样贵"]},{"id":47590,"word":"食甘寝宁","pinyin":"shí gān qǐn níng","abbr":"sgqn","explanation":"吃得香甜，睡得安稳。形容心绪宁静。","source":{"text":"患解忧除，然后食甘寝宁，居安游乐。","book":"《淮南子·诠言训》"},"similar":["食甘寝安"],"usage":"作谓语、定语；用于生活"},{"id":47591,"word":"食甘寝安","pinyin":"shí gān qǐn ān","abbr":"sgqa","explanation":"吃得香甜，睡得安稳。形容心绪宁静。同“食甘寝宁”。","source":{"text":"及訢将获罪，默因构成以诛之，然后食甘寝安，志于职事。","book":"《北史·恩幸传·赵默》"},"similar":["食甘寝宁"],"usage":"作谓语、定语；用于生活"},{"id":47592,"word":"食生不化","pinyin":"shí shēng bù huà","abbr":"ssbh","explanation":"指生吞活剥，不善灵活运用。","source":{"text":"惊人，恐其不根也；援古，恐其食生不化也。","book":"清·阎尔梅《〈破山和尚语录〉序》"},"example":{"text":"凡物之精者变……即如诗家临摹老杜，岂少名手，然～，反受其累。","book":"清·张谦宜《茧斋诗谈·统论上》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":47593,"word":"食租衣税","pinyin":"shí zū yī shuì","abbr":"szys","explanation":"依靠百姓缴纳的租税生活。","source":{"text":"县官当食租衣税而已，今弘羊令吏坐市列。","book":"东汉·班固《汉书·食货志下》"},"example":{"text":"～，王者之常赋。","book":"唐·于卲《送李员外入朝序》"},"similar":["衣租食税"],"usage":"作主语、宾语；指依靠收取百姓的租税生活"},{"id":47594,"word":"食箪浆壶","pinyin":"sì dān jiāng hú","abbr":"sdjh","explanation":"为欢迎所拥护的军队，用箪盛饭，用壶盛水，进行犒劳。","source":{"text":"以万乘之国伐万乘之国，箪食壶浆以迎王师，岂有他哉！","book":"战国·邹·孟轲《孟子·梁惠王上》"},"example":{"text":"黄金琐甲镇三缴，～骈父母。","book":"明·王逢《张武略》诗"},"similar":["箪食壶浆"],"usage":"作状语；指军民关系","story":["战国时期燕国相国子之暴政，大将子被、太子平率兵讨伐，国内大乱。齐宣王趁机出兵攻打燕国并控制大部分领土，燕国老百姓用箪送吃的，用壶装喝的欢迎齐军，齐宣王想侵吞了燕国咨询孟子，孟子说：“你会让他们生活在水深火热中的。”"]},{"id":47595,"word":"食而不化","pinyin":"shí ér bù huà","abbr":"sebh","explanation":"吃了没有消化。比喻对所学知识理解得不深不透，没有吸收成为自己的东西。","source":{"text":"然读书以明理，明理以致用也。食而不化，至昏愦僻谬，贻害无穷。","book":"清·纪昀《阅微草堂笔记·姑妄听之六》"},"example":{"text":"况且从幼童时代就开始，学生～，也徒然摧残了他们的精力和兴趣。","book":"朱自清《序》"},"similar":["食古不化","囫囵吞枣"],"opposite":["融会贯通"],"usage":"作谓语、定语；指囫囵吞枣"},{"id":47596,"word":"食而不知其味","pinyin":"shí ér bù zhī qí wèi","abbr":"sebzqw","explanation":"东西吃下去，却不知道它的味道。比喻读书不能理解其中的含义。","source":{"text":"心不在焉，视而不见，听而不闻，食而不知其味。","book":"《礼记·大学》"},"example":{"text":"这餐晚饭余楠简直～。他神情失常，呆呆地、机械地进食，话也不说。","book":"杨绛《洗澡》第一部第二章"}},{"id":47597,"word":"食肉之禄","pinyin":"shí ròu zhī lù","abbr":"srzl","explanation":"禄：官吏的薪俸。指在朝廷做官的人。","source":{"text":"食肉之禄，众皆与焉。","book":"《左传·昭公四年》"}},{"id":47598,"word":"食肉寝皮","pinyin":"shí ròu qǐn pí","abbr":"srqp","explanation":"割他的肉吃，剥他的皮睡。形容对敌人的深仇大恨。","source":{"text":"然二子者，譬于禽兽，臣食其肉而寝处其皮。","book":"《左传·襄公二十一年》"},"example":{"text":"却说殷小姐痛恨刘贼，恨不～。","book":"明·吴承恩《西游记》第九回"},"similar":["恨之入骨"],"opposite":["情深义重","一往情深"],"usage":"作谓语、宾语；形容仇恨很大"},{"id":47599,"word":"食荼卧棘","pinyin":"shí tú wò jí","abbr":"stwj","explanation":"吃苦菜，睡粗草。形容初民的生活艰苦。","source":{"text":"吾闻之汉文、景矣，其终远于圣人之治而不能合者，老庄乱之也，然而心犹人之心，天下则已异乎食荼卧棘之天下矣。","book":"清·王夫之《老庄申韩论》"},"usage":"作宾语、定语；用于生活"},{"id":47600,"word":"食藿悬鹑","pinyin":"shí huò xuán chún","abbr":"shxc","explanation":"指生活穷苦。食藿，以豆叶为食；悬鹑，衣衫褴褛，似鹑鸟悬垂的秃尾。","source":{"text":"臣今幸沾朱绂，而保安子天祐食藿悬鹑，臣窃愧之。","book":"《古今小说·吴保安弃家赎友》"},"usage":"作宾语、定语；用于书面语"},{"id":47601,"word":"食言而肥","pinyin":"shí yán ér féi","abbr":"syef","explanation":"食言：失信。指不守信用，只图自己占便宜。","source":{"text":"是食言多矣，能无肥乎？","book":"《左传·哀公二十五年》"},"example":{"text":"你们～，不承认这个原来答应承认的区域。","book":"毛泽东《评国民党十一中全会和三届二次国民参议会》"},"similar":["言而无信"],"opposite":["言而有信"],"usage":"作谓语、定语；指不守信用","story":["春秋时期，鲁国卿士孟武伯说话从来不算数，鲁哀公对他不满，就带胖子大夫郭重出访越国，孟武伯十分嫉妒孟武伯，在哀公设宴招待群臣时中伤郭重，说郭重很肥。鲁哀公回答他说：“食言太多，能不肥吗？”孟武伯知道哀公在讽刺他"]},{"id":47602,"word":"食辨劳薪","pinyin":"shí biàn láo xīn","abbr":"sblx","explanation":"形容见识卓越。","source":{"text":"荀勖尝在晋武帝坐上食笋进饭，谓在坐人曰：‘此是劳薪所炊也。’坐者未之信，密遣问之，实用故车脚。","book":"南朝·宋·刘义庆《世说新语·术解》"},"example":{"text":"～，人知有荀勖，而不知有师旷。","book":"清·沈廷文《广事同纂》"},"usage":"作谓语、定语；指见识卓越","story":["晋朝时期，荀勖曾经跟随晋武帝外出，当时条件十分艰苦，到处找不到柴火做饭，厨师只好把带去的旧车的车脚卸下烧火做饭。席间，荀勖对晋武帝说：“这饭是用腐朽的木柴烧出来的。”晋武帝不信，派人去询问，情况果然如此"]},{"id":47603,"word":"食饥息劳","pinyin":"sì jī xī láo","abbr":"sjxl","explanation":"指使饥饿者得食，疲劳者休息。","source":{"text":"内有以食饥息劳，持养其万民。","book":"《墨子·天志中》"},"usage":"作谓语、定语；用于书面语"},{"id":47604,"word":"食马留肝","pinyin":"shí mǎ liú gān","abbr":"smlg","explanation":"后反用其义，比喻未能吸取精华。","source":{"text":"案：《论衡》云：‘气热而毒盛，故食走马肝杀人。’","book":"《史记·封禅书》：“文成（少翁）食马肝死耳。”司马贞索隐"},"example":{"text":"前蜀·韦庄《序》：“但思其～，徒云染指，岂虑其烹鱼去已，或致伤鳞。”"},"usage":"作宾语、定语；用于处事"},{"id":47605,"word":"食骨在喉","pinyin":"shí gǔ zài hóu","abbr":"sgzh","explanation":"鱼骨头卡在喉咙里。比喻心里有话没有说出来，非常难受。","source":{"text":"韦曰：‘骨所以鲠，刺人也。’忠言逆耳，如食骨在喉，故云骨鲠之臣。《汉书》以下皆作骨鲠，字从鱼，谓留咽者鱼骨较多也。","book":"汉·许慎《说文解字》：“鲠，食骨留咽中也。”段玉裁注"},"usage":"作宾语、定语；多用于比喻句"},{"id":47606,"word":"食鱼遇鲭","pinyin":"shí yú yù qīng","abbr":"syyq","explanation":"比喻调换口味，使不单调。鲭，鱼肉合烧的美味。","source":{"text":"古风诗，编之文末，俾视之，粗俊于口也。亦由食鱼遇鲭，持肉偶（月巽）。","book":"唐·皮日体《〈文薮〉序》"},"usage":"作宾语、定语；用于比喻句"},{"id":47607,"word":"餐云卧石","pinyin":"cān yún wò shí","abbr":"cyws","explanation":"指超脱尘世的隐逸生活。","source":{"text":"始知伊吕萧曹辈，不及餐云卧石人。","book":"明·袁宏道《隆中偶述》诗"},"usage":"作谓语、定语、宾语；用于隐居生活"},{"id":47608,"word":"餐松啖柏","pinyin":"cān sōng dàn biǎ","abbr":"csdb","explanation":"以松柏的叶实充饥。形容修仙学道者超尘脱俗的生活。","source":{"text":"俺出家人闲来坐静，闷来游访，寻仙问道，餐松啖柏。","book":"元·无名氏《玩江亭》第二折"},"example":{"text":"你这出家人，止不过熬齑受淡，～，有何好处也。","book":"明·无名氏《广成子》第一折"},"similar":["餐葩饮露"],"usage":"作谓语、定语、宾语；用于生活"},{"id":47609,"word":"餐松饮涧","pinyin":"cān sōng yǐn jiàn","abbr":"csyj","explanation":"食松实，饮涧水。指过隐居生活。","source":{"text":"达人独往之事，志非易立，餐松饮涧之情，理难轻树。","book":"南朝·梁·沈约《善馆碑》"},"usage":"作谓语、定语、宾语；用于隐居生活"},{"id":47610,"word":"餐腥啄腐","pinyin":"cān xīng zhuó fǔ","abbr":"cxzf","explanation":"比喻追求功名利禄。","source":{"text":"夫鹓雏，发于南海而飞于北海，非梧桐不止，非练实不食，非醴泉不饮。于是鸱得腐鼠，鹓雏过之，仰而视之曰：‘吓！’今子欲以子之梁国而吓我邪？","book":"战国·宋·庄周《庄子·秋水》"},"example":{"text":"攀龙附凤有时辈，～非吾侪。","book":"清·高其倬《与熊敏思登蟠龙山顶望都城值大风有感呈敏思》诗"},"similar":["追名逐利"],"usage":"作谓语、定语；比喻追求名利"},{"id":47611,"word":"餐葩饮露","pinyin":"cān pā yǐn lù","abbr":"cpyl","explanation":"吞食百花，吸饮露水。形容超尘脱俗的神仙生活。","source":{"text":"子舆拔俗，餐葩饮露。","book":"汉·刘向《列仙传·赤将子舆》"},"similar":["餐风饮露"],"usage":"作谓语、宾语、定语；用于野外生活等"},{"id":47612,"word":"餐霞吸露","pinyin":"cān xiá xī lù","abbr":"cxxl","explanation":"餐食日霞，吸饮沆瀣。指超尘脱俗的仙家生活。","source":{"text":"翦雪披霜号九尾，餐霞吸露历千秋。","book":"明·单本《蕉帕记·幻形》"},"example":{"text":"清·李百川《绿野仙踪》第16回：“先生以呼息导引为第一，～次之。”"},"similar":["餐霞饮瀣"],"usage":"作谓语、定语、宾语；用于隐居生活"},{"id":47613,"word":"餐霞漱瀣","pinyin":"cān xiá shù xiè","abbr":"cxsx","explanation":"餐食日霞，吸饮沆瀣。指超尘脱俗的仙家生活。","source":{"text":"餐霞漱瀣寿千秋，世不求仙何所由。","book":"景耀月《长歌行》"},"similar":["餐霞饮瀣"],"usage":"作谓语、定语、宾语；用于隐居生活"},{"id":47614,"word":"餐霞饮景","pinyin":"cān xiá yǐn jǐng","abbr":"cxyj","explanation":"餐食日霞，吞饮日光。指超尘脱俗，修炼成仙。","source":{"text":"夫作道士，皆须知长生之要。尔既未能餐霞饮景，克己求真，徒在世上，无益于体。","book":"南朝·梁·陶弘景《冥通记》卷一"},"similar":["餐霞吸露"],"usage":"作谓语、定语、宾语；用于隐居生活"},{"id":47615,"word":"餐霞饮液","pinyin":"cān xiá yǐn yè","abbr":"cxyy","explanation":"指修炼长生不老之术。","source":{"text":"吾固久知太夫人，不必餐霞饮液，而自翛然出弢帙之外。","book":"明·袁宗道《李母寿序》"},"usage":"作谓语、定语、宾语；用于隐居生活"},{"id":47616,"word":"餐霞饮瀣","pinyin":"cān xiá yǐn xiè","abbr":"cxyx","explanation":"餐食日霞，吸饮沆瀣。指超尘脱俗的仙家生活。","source":{"text":"屈原忧极，故有轻举远游、餐霞饮瀣之赋。","book":"清·章学诚《文史通义·质性》"},"similar":["餐霞漱瀣","餐霞吸露"],"usage":"作谓语、定语、宾语；用于隐居生活"},{"id":47617,"word":"餐风吸露","pinyin":"cān fēng xī lù","abbr":"cfxl","explanation":"吃的是风，喝的是露水。形容超脱尘世的生活。","source":{"text":"武陵津傍，藐姑山上，餐风吸露乘云，那许尘眸相望。","book":"明·张景《飞丸记·意传飞稿》"},"similar":["餐葩饮露"],"usage":"作谓语、宾语、定语；用于野外生活等"},{"id":47618,"word":"餐风咽露","pinyin":"cān fēng yàn lù","abbr":"cfyl","explanation":"形容旅途或野外生活的艰苦。","source":{"text":"形容旅途或野外生活的艰苦。"},"similar":["餐风饮露"],"usage":"作谓语、宾语、定语；用于野外生活等"},{"id":47619,"word":"餐风啮雪","pinyin":"cān fēng niè xuě","abbr":"cfnx","explanation":"形容野外生活的艰苦。","source":{"text":"一痛爷娘，餐风啮雪；二伤姑妈，替死超生。","book":"明·张景《飞丸记·月下伤怀》"},"similar":["餐风茹雪"],"usage":"作谓语、宾语、定语；用于野外生活"},{"id":47620,"word":"餐风宿水","pinyin":"cān fēng sù shuǐ","abbr":"cfss","explanation":"形容旅途的辛苦。","source":{"text":"纵经营千倍利，不如家里安闲。餐风宿水，容颜易变。","book":"明·冯梦龙《挂枝儿·送别》"},"example":{"text":"且说天瑞带了妻子，一路～，无非是逢桥下马，遇渡登舟。","book":"《初刻拍案惊奇》卷三三"},"similar":["餐风宿露","水宿风餐"],"usage":"作谓语、宾语、定语；用于旅途生活"},{"id":47621,"word":"餐风宿草","pinyin":"cān fēng sù xuě","abbr":"cfsc","explanation":"形容旅途或野外生活的艰苦。","source":{"text":"木兰可怜父亲多病，扮女为勇，代父其役……餐风宿草，受了百般辛苦。","book":"《古今小说·李秀卿义结黄贞女》"},"similar":["餐风宿露"],"usage":"作谓语、宾语、定语；用于野外生活"},{"id":47622,"word":"餐风宿雨","pinyin":"cān fēng sù yǔ","abbr":"cfsy","explanation":"形容旅途或野外生活的艰苦。","source":{"text":"别后餐风宿雨，儿歌行路之难。而芳草斜阳，又来孤馆，自叹春光九十，不属劳人也。","book":"清·许思湄《谢清苑县李贺母寿并请追失银》"},"example":{"text":"唐宋以后，我先人以一往无前之概，航海而南，～，辟有蛮荒。","book":"苏曼殊《南洋话》"},"similar":["餐风宿露"],"usage":"作谓语、宾语、定语；用于旅途生活"},{"id":47623,"word":"餐风宿露","pinyin":"cān fēng sù lù","abbr":"cfsl","explanation":"形容旅途或野外生活的艰苦。","source":{"text":"师父力多般，餐风宿露忙投窜，宵衣旰食无撺断，受驱驰百万端。","book":"元·杨暹《西游记》第五本第二十出"},"example":{"text":"儿在程途，又怕～，求神问卜，把归期暗数。","book":"明·高明《琵琶记·寺中遗像》"},"similar":["风餐露宿","餐风露宿","栉风沐雨"],"usage":"作谓语、定语；指野外生活"},{"id":47624,"word":"餐风沐雨","pinyin":"cān fēng mù yǔ","abbr":"cfmy","explanation":"餐：吃；沐：洗。以风充饥，用雨水洗头。形容旅行或野外生活的艰辛。","source":{"text":"谁知着恁惯雌黄，惯使着猖狂，却不念餐风沐雨先皇创业多辛苦，到做个弃正趋邪没主张。","book":"明·许三阶《节侠记·忠忤》"},"example":{"text":"～，枕寒戈边疆御戎。","book":"明·张景《飞丸记·埋轮没产》"},"similar":["风餐露宿"],"usage":"作谓语、定语；形容旅途生活艰苦"},{"id":47625,"word":"餐风茹雪","pinyin":"cān fēng rú xuě","abbr":"cfrx","explanation":"形容野外生活的艰苦。","source":{"text":"作品热情地歌颂了这些搬山填谷、餐风茹雪的建设者的艰辛劳动，和他们对祖国社会主义建设事业的无限忠诚尽职。","book":"贺宜《<1958儿童文学选>序言》"},"similar":["餐风啮雪"],"usage":"作谓语、宾语、定语；用于野外生活"},{"id":47626,"word":"餐风露宿","pinyin":"cān fēng lù sù","abbr":"cfls","explanation":"风里吃饭，露天睡觉。形容旅途或野外工作的辛苦。","source":{"text":"露宿风餐六百里，明朝饮马南江水。","book":"宋·苏轼《将至筠先寄迟适远三犹子》诗"},"example":{"text":"他离开家后，～地赶路，十分辛苦。"},"similar":["跋山涉水","风尘仆仆","栉风沐雨"],"opposite":["席丰履厚","悠哉游哉"],"usage":"作谓语、定语；形容旅途生活艰辛"},{"id":47627,"word":"餐风饮露","pinyin":"cān fēng yǐn lù","abbr":"cfyl","explanation":"形容旅途或野外生活的艰苦。","source":{"text":"餐风饮露，无尔饥兮。","book":"明·王守仁《瘗旅文》"},"example":{"text":"但是野外勘测，～，地质工作也是艰苦卓绝的。","book":"徐迟《地质之光》"},"similar":["餐风咽露"],"usage":"作谓语、宾语、定语；用于野外生活等"},{"id":47628,"word":"餔糟啜漓","pinyin":"bǔ zāo chuò lí","abbr":"bzcl","explanation":"吃酒糟，喝薄酒。指追求一醉。亦比喻屈志从俗；随波逐流。亦比喻文字优美，令人陶醉。同“餔糟歠醨”。","source":{"text":"餔糟啜漓皆可以醉，果蔬草木皆可以饱。","book":"宋·苏轼《超然台记》"},"similar":["餔糟歠漓"],"usage":"作谓语、宾语、定语；用于处世"},{"id":47629,"word":"餔糟啜醨","pinyin":"tān zāo chuò lí","abbr":"bzcl","explanation":"吃酒糟，喝薄酒。指追求一醉。亦比喻屈志从俗；随波逐流。亦比喻文字优美，令人陶醉。同“餔糟歠醨”。","source":{"text":"众人皆醉，何不餔其糟而啜其醨。","book":"西汉·司马迁《史记·屈原贾生列传》"},"example":{"text":"我亦～者，独醒终古奈君何！","book":"傅蓴《过汨罗》诗"},"similar":["哺糟啜醨","餔糟歠醨"],"usage":"作谓语、宾语、定语；用于处世"},{"id":47630,"word":"餔糟歠漓","pinyin":"bǔ zāo huài lí","abbr":"bzcl","explanation":"吃酒糟，喝薄酒。指追求一醉。亦比喻屈志从俗；随波逐流。亦比喻文字优美，令人陶醉。同“餔糟歠醨”。","source":{"text":"咸曰：‘此酒魂也。’真餔糟歠漓之言。","book":"清·周亮工《书影》第四卷"},"similar":["餔糟歠醨","餔糟啜漓"],"usage":"作谓语、宾语、定语；用于处世"},{"id":47631,"word":"餔糟歠醨","pinyin":"bū zāo chuò lí","abbr":"bzcl","explanation":"①吃酒糟，喝薄酒。指追求一醉。②比喻屈志从俗；随波逐流。③比喻文字优美，令人陶醉。","source":{"text":"醨，薄酒也。","book":"语出《楚辞·渔父》：“众人皆醉，何不餔其糟而歠其酾？”《文选》酾作“醨”。吕向云：“餔糟歠醨，微同其事也。餔，食也。歠，饮也。糟、醨，皆酒滓。”洪兴祖补注"},"example":{"text":"闽酒深红，如汴梁酒。予常在临洺关，向李浦珠索洺酒以饮闽人。咸曰：‘此酒魂也。’真～之言。","book":"清·周亮工《书影》卷四"},"similar":["餔糟啜醨","餔糟歠漓"],"usage":"作谓语、宾语、定语；用于处世"},{"id":47632,"word":"餬口四方","pinyin":"hú kǒu sì fāng","abbr":"hksf","explanation":"餬口：勉强维持生活。为了生计，不得不四处奔波。","source":{"text":"寡人有弟，有能和协，而使餬其口于四方。","book":"《左传·隐公十一年》"},"example":{"text":"老夫虽忝列胶庠，素日～，未能博览。","book":"清·李汝珍《镜花缘》第十六回"},"usage":"作谓语、宾语；指谋生"},{"id":47633,"word":"餵糟啜漓","pinyin":"bǔ zāo chuò lí","abbr":"bzcl","explanation":"吃酒糟，喝薄酒。指追求一醉。亦比喻屈志从俗；随波逐流。亦比喻文字优美，令人陶醉。同餵糟歠醨”。"},{"id":47634,"word":"餵糟啜醨","pinyin":"tān zāo chuò lí","abbr":"tzcl","explanation":"吃酒糟，喝薄酒。指追求一醉。亦比喻屈志从俗；随波逐流。亦比喻文字优美，令人陶醉。同餵糟歠醨”。"},{"id":47635,"word":"餵糟歠漓","pinyin":"bǔ zāo huài lí","abbr":"bzhl","explanation":"吃酒糟，喝薄酒。指追求一醉。亦比喻屈志从俗；随波逐流。亦比喻文字优美，令人陶醉。同餵糟歠醨”。"},{"id":47636,"word":"餵糟歠醨","pinyin":"bū zāo chuò lí","abbr":"bzcl","explanation":"①吃酒糟，喝薄酒。指追求一醉。②比喻屈志从俗；随波逐流。③比喻文字优美，令人陶醉。","quote":{"text":"闽酒深红，如汴梁酒。予常在临洺关，向李浦珠索洺酒以饮闽人。咸曰‘此酒魂也。’真～之言。","book":"清·周亮工《书影》卷四"}},{"id":47637,"word":"饔飧不济","pinyin":"yōng sūn bù jì","abbr":"ysbj","explanation":"一日三餐不能自给。形容穷苦。同“饔飧不继”。","source":{"text":"今既饔飧不济，我这里有白银十两，暂且拿去使用。","book":"清·石玉昆《三侠五义》第十一回"},"similar":["饔飧不继","饔飧不给"],"usage":"作谓语、定语、宾语；用于生活"},{"id":47638,"word":"饔飧不给","pinyin":"yōng sūn bù jǐ","abbr":"ysbj","explanation":"一日三餐不能自给。形容穷苦。同“饔飧不继”。","source":{"text":"转大冶主簿，故苗地，长吏多不乐往，代行令事，多方抚恤，尽却例金，锱铢无所取，至饔飧不给，部民有馈白粲者。","book":"明·朱国帧《涌幢小品·天下策一》"},"example":{"text":"衰国之民，～，裋褐不完。","book":"清·谭嗣同《仁学》二四"},"similar":["饔飧不继","饔飧不济","饔飧不饱"],"usage":"作谓语、定语、宾语；用于生活"},{"id":47639,"word":"饔飧不继","pinyin":"yōng sūn bù jì","abbr":"ysbj","explanation":"饔：早饭；飧：晚饭。吃了上顿没有下顿。形容生活十分穷困。","source":{"text":"虽饔飧不继，犹有余欢。","book":"明·朱用纯《朱子家训》"},"example":{"text":"于是，衡门之下，环堵萧然，～，过日恒饥耳。","book":"清·无名氏《杜诗言志》卷七"},"similar":["饔飧不济","饔飧不给"],"usage":"作谓语、定语；指生活贫困"},{"id":47640,"word":"饔飧不饱","pinyin":"yōng sūn bù bǎo","abbr":"ysbb","explanation":"饔：早饭。飧：晚饭。终天吃不饱。形容生活十分贫困。亦作“饔飧不继”、“饔飧不给”。","source":{"text":"虽饔飧不继，犹有余欢。","book":"明·朱用纯《朱子家训》"},"example":{"text":"况且民穷财尽，百姓～，没闲钱去养马骡。","book":"《京本通俗小说·拗相公》"},"similar":["饔飧不给","饔飧不济"],"usage":"作谓语、定语、宾语；用于生活"},{"id":47641,"word":"饕口馋舌","pinyin":"tāo kǒu chán shé","abbr":"tkcs","explanation":"比喻贪吃的人。","source":{"text":"暖烘烘云蒸霞蔚而至；饕口馋舌，雄纠纠排山倒海而来。","book":"清·李绿园《歧路灯》第33回"},"similar":["饕餮之徒"],"usage":"作主语；指贪吃的人"},{"id":47642,"word":"饕风虐雪","pinyin":"tāo fēng nüè xuě","abbr":"tfnx","explanation":"指狂暴肆虐的风雪。","source":{"text":"岁弊寒凶，雪虐风饕。","book":"唐·韩愈《祭河南张员外文》"},"example":{"text":"～到家林，才喜春晴春已深。","book":"元·方回《春晴》"},"usage":"作宾语、定语；用于书面语"},{"id":47643,"word":"饕餮之徒","pinyin":"tāo tiè zhī tú","abbr":"ttzt","explanation":"比喻贪吃的人。","source":{"text":"多食不厌谓之饕餮之徒；见食垂涎谓有欲炙之色。","book":"明·程登吉《幼学琼林》第三卷"},"example":{"text":"我不是～。"},"similar":["饕口馋舌"],"usage":"作宾语；指贪吃的人"},{"id":47644,"word":"饥不择食","pinyin":"jī bù zé shí","abbr":"jbzs","explanation":"择：挑拣。不管什么都吃。比喻需要急迫，顾不得选择。","source":{"text":"问：‘如何是和尚家风？’师曰：‘饥不择食。’","book":"宋·释普济《五灯会元》卷三十"},"example":{"text":"自古有几般：～，寒不择衣，慌不择路，贫不择妻。","book":"明·施耐庵《水浒全传》第三回"},"similar":["慌不择路"],"opposite":["挑肥拣瘦"],"usage":"作宾语、定语；比喻需要急迫"},{"id":47645,"word":"饥不暇食","pinyin":"jī bù xiá shí","abbr":"jbxs","explanation":"肚子饿了也没空吃饭。形容全神贯注地忙于事务。","source":{"text":"饥不暇食，思不敢归，劳不敢息。","book":"《太平广记》卷八引晋·葛洪《神仙传·阴长生》"},"example":{"text":"日不为暑，风不为寒，渴不暇饮，～，孳孳焉从于王事者，赏使之然也。","book":"宋·李觏《强兵策八》"},"similar":["饥不遑食"],"usage":"作谓语、定语；用于处事"},{"id":47646,"word":"饥不遑食","pinyin":"jī bù huáng shí","abbr":"jbhs","explanation":"形容全神贯注地忙于事务。同“饥不暇食”。","source":{"text":"虽有餱粮，饥不遑食。","book":"《三国志·魏志·陈思王植传》"},"similar":["饥不暇食"],"usage":"作谓语、定语；用于处事"},{"id":47647,"word":"饥冻交切","pinyin":"jī dòng jiāo qiē","abbr":"jdjq","explanation":"饥饿与寒冷一齐逼来。形容无衣无食，生活极其贫困。","source":{"text":"父母欲其死，置于室一隅，饥冻交切，然竟不死。","book":"宋·洪迈《夷坚丙志·鱼肉道人》"},"similar":["饥寒交迫"],"usage":"作谓语、定语、宾语；形容生活极端贫困"},{"id":47648,"word":"饥则附人，饱便高扬","pinyin":"jī zé fù rén，bǎo biàn gāo yáng","abbr":"jzfrbbgy","explanation":"附：依附，归附；扬：飞扬。饿了就来归附，饱了就飞走了。比喻人不得志即来依附，得志时就远走高飞，忘恩负义。","source":{"text":"譬如养鹰，饥即为用，饱则扬去。","book":"南朝·宋·范晔《后汉书·吕布传》"},"example":{"text":"且垂犹鹰也～。","book":"唐·房玄龄《晋书·慕容垂载记》"},"similar":["饥附饱扬"],"usage":"作定语、宾语；用于处世"},{"id":47649,"word":"饥寒交凑","pinyin":"jī hán jiāo còu","abbr":"jhjc","explanation":"衣食无着，又饿又冷。形容生活极端贫困。同“饥寒交迫”。","source":{"text":"不敦其本，则末业滋章；饥寒交凑，则廉耻不立。","book":"《宋书·袁湛传》"},"similar":["饥寒交切","饥寒交迫"],"usage":"作谓语、定语、宾语；形容生活极端贫困"},{"id":47650,"word":"饥寒交切","pinyin":"jī hán jiāo qiē","abbr":"jhjq","explanation":"饥饿与寒冷一齐逼来。形容无衣无食，生活极其贫困。","source":{"text":"高祖时，严甘罗，武功人，剽劫，为吏所拘。上谓曰：‘汝何为作贼？’对曰：‘饥寒交切，所以为盗。’","book":"宋·王谠《唐语林·政事上》"},"similar":["饥寒交迫","饥寒交凑"],"opposite":["丰衣足食"],"usage":"作谓语、定语、宾语；形容生活极端贫困"},{"id":47651,"word":"饥寒交至","pinyin":"jī hán jiāo zhì","abbr":"jhjz","explanation":"衣食无着，又饿又冷。形容生活极端贫困。同“饥寒交迫”。","source":{"text":"宴安自逸，岁暮奚冀？担石不储，饥寒交至。","book":"晋·陶潜《劝农》诗"},"example":{"text":"他过着～的穷困生活。"},"similar":["饥寒交迫"],"opposite":["丰衣足食"],"usage":"作谓语、定语、宾语；形容生活极端贫困"},{"id":47652,"word":"饥寒交迫","pinyin":"jī hán jiāo pò","abbr":"jhjp","explanation":"交：一起，同时。衣食无着，又饿又冷。形容生活极端贫困。","source":{"text":"上谓曰：‘汝何为作贼？’对曰：‘饥寒交迫，所以为盗。’","book":"晋·陶潜《劝农》：“宴安自逸，岁暮奚冀？担石不储，饥寒交至。”宋·王谠《唐语林》卷一"},"example":{"text":"吾十数年来，～，不萌他念者，望汝成立室家，为尔父延一线也。","book":"清·袁枚《子不语》"},"similar":["啼饥号寒","饥寒交切"],"opposite":["丰衣足食"],"usage":"作谓语、定语、宾语；形容生活极端贫困","story":["唐朝初年，高祖李渊为人宽厚，经常亲自检阅囚犯的案卷，经常还亲自提审犯人。一次他发现严甘罗因抢劫犯了法，提审的时候，他见这个囚犯瑟瑟缩缩地跪在地上，显得很可怜，问他为什么要做强盗。严甘罗哆嗦地回答是饥寒交迫所致"]},{"id":47653,"word":"饥来吃饭","pinyin":"jī lái chī fàn","abbr":"jlcf","explanation":"饿了就吃饭。比喻随其常规，顺其自然。","source":{"text":"有源律师来问：‘和尚修道，还用功否？’师曰：‘用功。’曰：‘如何用功？’师曰：‘饥来吃饭，困来即眠。’","book":"宋·释道原《景德传灯录》卷六"}},{"id":47654,"word":"饥渴交攻","pinyin":"jī kě jiāo gōng","abbr":"jkjg","explanation":"饥渴同时袭来。形容饥渴交加。","source":{"text":"右边石池，荷花方烂漫，虽饥渴交攻，而花与水皆不可及。","book":"宋·洪迈《夷坚丁志·华阳洞门》"},"similar":["饥渴交迫"],"usage":"作谓语、定语；用于生活"},{"id":47655,"word":"饥渴交迫","pinyin":"jī kě jiāo pò","abbr":"jkjp","explanation":"饥渴同时袭来。形容饥渴交加。","source":{"text":"右边石池，荷花方烂漫，虽饥渴交攻，而花与水皆不可及。","book":"宋·洪迈《夷坚丁志·华阳洞门》"},"example":{"text":"昼伏夜行，窃瓜果为粮，幸无觉者，一夕～，遥望一灯荧然。","book":"清·纪昀《滦阳消夏录·齐舜庭》"},"similar":["饥渴交攻"],"usage":"作谓语、定语；用于生活"},{"id":47656,"word":"饥火烧肠","pinyin":"jī huǒ shāo cháng","abbr":"jhsc","explanation":"饥不可忍，如火烧肚肠。形容饥饿不堪，难以忍受。","source":{"text":"壮者不耐饥，饥火烧其肠。","book":"唐·白居易《旱热二首》"},"example":{"text":"～作牛吼，不知待得秋成否。","book":"宋·苏轼《和李邦直沂山祈雨有应》诗"},"similar":["饥肠辘辘","饥焰中烧"],"opposite":["饱吃饱喝"],"usage":"作谓语、定语；形容十分饥饿"},{"id":47657,"word":"饥焰中烧","pinyin":"jī yàn zhōng shāo","abbr":"jyzs","explanation":"犹饥火烧肠。形容饥饿难忍。","source":{"text":"日既暮，枵腹独行衢市间，饥焰中烧，无所为计。","book":"清·王韬《淞隐漫录·王蟾香》"},"example":{"text":"临近中午，我已经～了。"},"similar":["饥火烧肠"],"opposite":["吃饱喝足"],"usage":"作谓语、定语；形容十分饥饿"},{"id":47658,"word":"饥者易为食，渴者易为饮","pinyin":"jī zhě yì wéi shí，kě zhě yì wéi yǐn","abbr":"jzywskzywy","explanation":"饥饿的人什么食物都可以吃，口渴的人什么饮品都可以喝。比喻需要急迫的人容易满足。","source":{"text":"饥者易为食，渴者易为饮。","book":"《孟子·公孙丑上》"},"example":{"text":"兄能与协和交欢，此则～之会。","book":"章炳麟《与熊克武书》"},"usage":"作定语、分句；比喻需要急迫的人容易满足"},{"id":47659,"word":"饥而忘食","pinyin":"jī ér wàng shí","abbr":"jews","explanation":"食：吃饭。尽管很饥饿，但也忘记了吃饭。形容极其忧虑的样子。","source":{"text":"今吾忧之，夜而忘寝，饥而忘食。","book":"《史记·赵世家》"}},{"id":47660,"word":"饥肠辘辘","pinyin":"jī cháng lù lù","abbr":"jcll","explanation":"饥肠：饥饿的肚子；辘辘：车行声。肚子饿得咕咕直响。形容十分饥饿。","source":{"text":"而枵肠辘辘，饥不可堪。","book":"清·蒲松龄《聊斋志异·西湖主》"},"example":{"text":"这时已错了传膳的时刻，都是天色微明吃的早饭，至此无不～。","book":"高阳《玉座珠帘》上册"},"similar":["饥不择食"],"opposite":["丰衣足食"],"usage":"作谓语、状语；形容十分饥饿"},{"id":47661,"word":"饥肠雷动","pinyin":"jī cháng léi dòng","abbr":"jcld","explanation":"肚子饿得像打雷一样响。形容非常饥饿。","source":{"text":"饥肠雷动寻常事，但误生台两鹊来。","book":"宋·苏轼《次韵孔毅父久旱已而甚雨三首》：“夜来饥肠如转雷，旅愁非酒不可开。”宋·陆游《贫甚戏作绝句》"}},{"id":47662,"word":"饥虎不可为邻","pinyin":"jī hǔ bù kě wéi lín","abbr":"jhbkwl","explanation":"邻：邻居。比喻不要与穷凶极恶之人在一起。","source":{"text":"饥虎不可为邻，我提师远出，弟当留心防范。","book":"清·江日升《台湾外记》"},"usage":"作宾语、定语；用于比喻句"},{"id":47663,"word":"饥附饱扬","pinyin":"jī fù bǎo yáng","abbr":"jfby","explanation":"附：依附，归附；扬：飞扬。不得志时即来依附，得志时便远走高飞。","source":{"text":"譬如养鹰，饥即为用，饱则飏去。","book":"《后汉书·吕布传》"},"example":{"text":"满少卿～，焦文姬生仇死恨。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"similar":["饥附饱飏"],"opposite":["始终如一"],"usage":"作谓语、定语；指人很势利","story":["南北朝时期，前燕王的儿子慕容垂因受到排斥就去投奔亲秦王苻坚。苻坚十分隆重地迎接他。宰相王猛认为慕容垂有雄才大略，应该杀了他。苻坚不听。权翼认为慕容垂是饥饿的老鹰吃饱了就会离开。后来慕容垂成为后燕的第一位君主"]},{"id":47664,"word":"饥附饱飏","pinyin":"jī fù bǎo yáng","abbr":"jfby","explanation":"附：依附，归附；扬：飞扬。不得志时即来依附，得志时便远走高飞。","source":{"text":"譬如养鹰，饥即为用，饱则飏去。","book":"南朝·宋·范晔《后汉书·吕布传》"},"example":{"text":"满少卿～，焦文姬生雠死报。","book":"明·凌濛初《二刻拍案惊奇》第11卷"},"similar":["饥附饱扬"],"opposite":["忠贞不渝"],"usage":"作谓语、定语；指为人很势利","story":["南北朝时期，前燕王的儿子慕容垂因受到排斥就去投奔亲秦王苻坚。苻坚十分隆重地迎接他。宰相王猛认为慕容垂有雄才大略，应该杀了他。苻坚不听。权翼认为慕容垂是饥饿的老鹰吃饱了就会离开。后来慕容垂成为后燕的第一位君主"]},{"id":47665,"word":"饥飡渴饮","pinyin":"jī cān kě yǐn","abbr":"jcky","explanation":"饿了吃饭，渴了喝水。形容生活必需。同“饥餐渴饮”。"},{"id":47666,"word":"饥餐渴饮","pinyin":"jī cān kě yǐn","abbr":"jcky","explanation":"饿了吃饭，渴了喝水。形容生活必需。","source":{"text":"说得天花乱坠，争似饥餐渴饮。","book":"宋·释普济《五灯会元》卷十六"},"example":{"text":"少不得～，夜住晓行，不在话下。","book":"明·洪楩《清平山堂话本·杨温拦路虎传》"},"opposite":["饱吃饱喝"],"usage":"作宾语；形容生活必需"},{"id":47667,"word":"饥饱劳役","pinyin":"jī bǎo láo yì","abbr":"jbly","explanation":"指生活劳苦，食无定时。","source":{"text":"俺哥哥三朝的五日，可便忍饿耽饥，五六日不曾尝着水米，常言道饥饱劳役。","book":"元·高文秀《黑旋风》第三折"},"usage":"作宾语、定语；指人的生活"},{"id":47668,"word":"饥馑荐臻","pinyin":"jī jǐn jiàn zhēn","abbr":"jjjz","explanation":"饥馑：饥荒；荐臻：接连到来。连年灾荒不断。","source":{"text":"何辜今之人，天降丧乱，饥馑荐臻。","book":"《诗经·大雅·云汉》"},"example":{"text":"霜旱为灾，所在不稔，～，方成俭弊。","book":"《魏书·崔光传》"},"usage":"作谓语；指连年灾荒不断"},{"id":47669,"word":"饥驱叩门","pinyin":"jī qū kòu mén","abbr":"jqkm","explanation":"指为饥饿驱使，叩门求食。","source":{"text":"饥来驱我去，不知竟何之，行行至斯里，叩门拙言辞。","book":"语出晋·陶潜《乞食》诗"},"example":{"text":"先生晚食当肉，徐步当车，视渊明～，不亦彼困而此亨乎？","book":"清·钱谦益《吴封君七十序》"},"usage":"作宾语、定语；用于生活"},{"id":47670,"word":"饥鹰饿虎","pinyin":"jī yīng è hǔ","abbr":"jyeh","explanation":"比喻凶残贪婪。","source":{"text":"侍中卢昶，亦蒙恩眄，故时人号曰：‘饿虎将军，饥鹰侍中。’","book":"《魏书·宗室晖传》"},"usage":"作宾语、定语；用于比喻句"},{"id":47671,"word":"饫甘餍肥","pinyin":"yù gān yàn féi","abbr":"ygyf","explanation":"饫：饱食；餍：吃饱。饱食肥美的食品。形容生活优裕、奢侈。","source":{"text":"当此日，欲将已往所赖天恩祖德，锦衣纨裤之时，饫甘餍肥之日，背父兄教育之恩，负师友规训之德，以致今日一技无成、半生潦倒之罪，编述一集，以告天下。","book":"清·曹雪芹《红楼梦》第一回"},"usage":"作谓语、定语；指生活奢华"},{"id":47672,"word":"饫闻习见","pinyin":"yù wén xí jiàn","abbr":"ywxj","explanation":"饫闻：饱闻；习见：常见。指见闻甚多。","source":{"text":"宜其于山水饫闻而厌见也。","book":"唐·韩愈《燕喜亭记》"},"example":{"text":"若祗以平日之所～者为平常，而以其罕闻骤见者为怪异，则怪异平炽是两事，经世出世便是两心。","book":"明·李贽《焚书·答耿中丞论淡》"}},{"id":47673,"word":"饫闻厌见","pinyin":"yù wén yàn jiàn","abbr":"ywyj","explanation":"饫闻：饱闻；厌见：饱见。指见闻甚多。","source":{"text":"宜其于山水饫闻而厌见也。","book":"唐·韩愈《燕喜亭记》"},"usage":"作谓语、定语；指人的见闻"},{"id":47674,"word":"饭囊衣架","pinyin":"fàn náng yī jià","abbr":"fnyj","explanation":"囊：口袋。装饭的口袋，挂衣的架子。比喻无用之人。","source":{"text":"饭囊衣架，塞满长安乱似麻。","book":"元·王子一《误入桃源》第一折"},"example":{"text":"马氏听说，把子牙劈脸一口啐道：“不是你无用，反来怨我，真是～，惟知饮食之徒！”","book":"明·许仲琳《封神演义》第十五回"},"similar":["酒囊饭袋"],"usage":"作补语、补语；比喻无用之人"},{"id":47675,"word":"饭囊酒瓮","pinyin":"fàn náng jiǔ wèng","abbr":"fnjw","explanation":"比喻只会吃饭喝酒，不会做事的人。","source":{"text":"今世士大夫，但不读书，即称武夫儿，乃饭囊酒瓮也。","book":"北齐·颜之推《颜氏家训·诫兵》"},"example":{"text":"～纷纷是，谁赏蒙山紫笋香。","book":"宋·陆游《效蜀人煎茶戏作长句》"},"similar":["酒囊饭袋"],"usage":"作宾语、定语；指无能之辈"},{"id":47676,"word":"饭囊酒甕","pinyin":"fàn náng jiǔ wèng","abbr":"fnjw","explanation":"比喻只会吃饭喝酒，不会做事的人。","source":{"text":"今世上大夫，但有读书，即称武夫儿，乃饭囊酒甕也。","book":"北齐·颜之推《颜氏家训·诫兵》"},"example":{"text":"～纷纷是，谁赏蒙山紫笋香。","book":"宋·陆游《效蜀人煎茶戏作长句》"}},{"id":47677,"word":"饭囊酒畒","pinyin":"fàn náng jiǔ wèng","abbr":"fnjw","explanation":"比喻只会吃饭喝酒，不会做事的人。","source":{"text":"今世上大夫，但有读书，即称武夫儿，乃饭囊酒畒也。","book":"北齐·颜之推《颜氏家训·诫兵》"},"quote":{"text":"～纷纷是，谁赏蒙山紫笋香。","book":"宋·陆游《效蜀人煎茶戏作长句》"}},{"id":47678,"word":"饭坑酒囊","pinyin":"fàn kēng jiǔ náng","abbr":"fkjn","explanation":"比喻只会吃喝不会做事的人。","source":{"text":"饱食快饮，虑深求卧，腹为饭坑，肠为酒囊。","book":"汉·王充《论衡·别通》"},"similar":["酒囊饭袋"],"usage":"作宾语、定语；指无能之辈"},{"id":47679,"word":"饭来开口","pinyin":"fàn lái kāi kǒu","abbr":"flkk","explanation":"指吃现成饭。形容不劳而获，坐享其成。同“饭来张口”。","source":{"text":"饭来开口似神鸦。","book":"唐·元稹《放言》"},"example":{"text":"我们不能过～的日子。"},"similar":["饭来张口"],"usage":"作宾语、定语；指人坐享其成"},{"id":47680,"word":"饭来张口","pinyin":"fàn lái zhāng kǒu","abbr":"flzk","explanation":"指吃现成饭。形容不劳而获，坐享其成。","source":{"text":"那婆子道：‘我的奶奶，你饭来张口，水来湿手，这等插金带银，呼奴使婢，又惹什么气？’","book":"《金瓶梅词话》第七六回"},"example":{"text":"朱延年一辈子娇生惯养，做惯了大老板，～，衣来伸手，吃的好，穿得美，哪里吃过这样的苦头？","book":"周而复《上海的早晨》第三部二十"},"similar":["衣来伸手","不劳而获"],"usage":"作宾语、定语；指懒人"},{"id":47681,"word":"饭牛屠狗","pinyin":"fàn niú tú gǒu","abbr":"fntg","explanation":"①喻指从事低贱之事。②指从事贱业者。","source":{"text":"别来落魄吴楚间，饭牛屠狗俱无颜。","book":"明·陈子龙《酬吴次尾》诗"},"example":{"text":"黄金浪掷唱呼鹰，～皆知己。","book":"马骏声《醉题酒家壁》诗"},"usage":"作宾语、定语；用于人的工作"},{"id":47682,"word":"饭粝茹蔬","pinyin":"fàn lì rú shū","abbr":"flrs","explanation":"吃糙米和蔬菜。形容饮食粗劣。粝，糙米。","source":{"text":"乃欲使之饭粝茹蔬，被短褐，步走以供使令。","book":"明·刘基《郁离子·枸橼》"},"usage":"作谓语、宾语、定语；用于生活"},{"id":47683,"word":"饭糗茹草","pinyin":"fàn qiǔ rú cǎo","abbr":"fqrc","explanation":"饭、茹：吃；糗：干粮；草：指野菜。吃的是干粮、野菜。形容生活清苦。","source":{"text":"舜之饭糗茹草也，若将终身焉？","book":"《孟子·尽心上》"},"example":{"text":"舜之～，舜之居深山之中，皆古书所记。","book":"清·陈澧《东塾读书记·孟子》"},"similar":["清茶淡饭"],"opposite":["山珍海味"],"usage":"作宾语、定语；形容生活清苦"},{"id":47684,"word":"饭蔬饮水","pinyin":"fàn shū yǐn shuǐ","abbr":"fsys","explanation":"形容清心寡欲、安贫乐道的生活。","source":{"text":"子曰：‘饭疏食饮水，曲肱而枕之，乐亦在其中矣。不义而富且贵，於我如浮云。’","book":"《论语·述而》"},"example":{"text":"～，客莫嘲吾拙。高处看浮云，一丘壑，中间甚乐。","book":"宋·辛弃疾《蓦山溪·赵昌父赋一丘一壑格律高古因效其体》词"},"usage":"作主语、宾语、定语；指生活清贫"},{"id":47685,"word":"饮冰内热","pinyin":"yǐn bīng nèi rè","abbr":"ybnr","explanation":"形容十分惶恐焦灼。","source":{"text":"今吾朝受命而夕饮冰，我其内热与？","book":"战国·宋·庄周《庄子·人间世》"},"example":{"text":"强予不从，必有～之患矣。","book":"明·杨慎《送卞苏溪归叙州序》"},"similar":["内热饮冰"],"usage":"作谓语、定语；指人的心情"},{"id":47686,"word":"饮冰吞檗","pinyin":"yǐn bīng tūn bò","abbr":"ybtb","explanation":"指生活清苦，为人清白。同“饮冰食蘖”。","source":{"text":"务此大事，不怙小解，惟求实知，卧薪尝胆，饮冰吞檗。","book":"明·袁宗道《杂说》"},"similar":["饮冰食蘖","饮冰茹蘖"],"usage":"作谓语、定语；用于书面语"},{"id":47687,"word":"饮冰茹檗","pinyin":"yǐn bīng rú bò","abbr":"ybrb","explanation":"茹：吃；檗：俗称黄柏，味苦。喝冷水，吃苦味的东西。比喻处境困苦，心情抑郁。也形容生活清苦。","source":{"text":"三年为刺史，饮冰复食檗。","book":"唐·白居易《三年为刺史》诗"},"example":{"text":"节妇非素有定志，必不能～。","book":"清·纪昀《阅微草堂笔记》卷十三"},"similar":["饮冰食檗"],"usage":"作谓语、定语；形容生活清苦"},{"id":47688,"word":"饮冰茹蘖","pinyin":"yǐn bīng rú bò","abbr":"ybrn","explanation":"指生活清苦，为人清白。同“饮冰食蘖”。","source":{"text":"节妇非素有定志，必不能饮冰茹檗数十年。","book":"清·纪昀《阅微草堂笔记·槐西杂志三》"},"similar":["饮冰食蘖","饮冰吞檗"],"usage":"作谓语、定语；用于书面语"},{"id":47689,"word":"饮冰食檗","pinyin":"yǐn bīng shí bò","abbr":"ybsb","explanation":"檗：俗称黄柏，味苦。喝冷水，吃苦味的东西。比喻处境困苦，心情抑郁。也形容生活清苦。","source":{"text":"三年为刺史，饮冰复食檗。","book":"唐·白居易《三年为刺史》诗"},"example":{"text":"～坐穷阎，旋觉星星上鬃髯。","book":"宋·王迈《岁晚偶题》"},"similar":["饮冰茹檗"],"usage":"作谓语、定语；指生活清苦"},{"id":47690,"word":"饮冰食蘖","pinyin":"yǐn bīng shí bò","abbr":"ybsb","explanation":"指生活清苦，为人清白。亦作“饮冰吞檗”、“饮冰茹蘖”。","source":{"text":"三年为刺史，饮冰复食檗。唯向天竺山，取得两片石。此抵有千金，无乃伤清白。","book":"语出唐·白居易《三年为刺史》诗之二"},"example":{"text":"伏以尚书万顷包含，千寻峭拔，膺岳峻河清之数，切～，之诚。","book":"唐·黄滔《南海韦尚书启》"},"similar":["饮冰吞檗","饮冰茹蘖"],"usage":"作谓语、定语；用于书面语"},{"id":47691,"word":"饮啖兼人","pinyin":"yǐn dàn jiān rén","abbr":"ydjr","explanation":"啖：吃。喝酒、吃饭比常人多两倍或几倍以上。形容人酒量、饭量很大。","source":{"text":"好酒食，饮啖兼人，每赐食于前，大饮长歠，左右相属，数人益乃供，太祖壮之。","book":"《三国志·魏志·典韦传》"},"example":{"text":"只为他年已九十有馀，兀自精神健旺，～，步履如飞，不匡一夕五更睡去，就不醒了。","book":"明·冯梦龙《警世通言》卷二十五"}},{"id":47692,"word":"饮啖醉饱","pinyin":"yǐn dàn zuì bǎo","abbr":"ydzb","explanation":"啖：吃。指酒足饭饱。","source":{"text":"未杀之顷，牛解，径来至阶而拜，县令大笑，命左右宰之。饮啖醉饱，便卧檐下。","book":"北齐·颜之推《颜氏家训·归心》"},"example":{"text":"作布囊，容三四斗，～，便盛余肉饼以付螟蛉。","book":"《魏书·胡叟传》"}},{"id":47693,"word":"饮噉兼人","pinyin":"yǐn dàn jiān rén","abbr":"ydjr","explanation":"噉：吃饭。喝酒、吃饭比常人多两倍或几倍以上。形容人酒量、饭量很大。","source":{"text":"好酒食，饮啖兼人，每赐食于前，大饮长歠，左右相属，数人益乃供，太祖壮之。","book":"《三国志·魏志·典韦传》"}},{"id":47694,"word":"饮噉醉饱","pinyin":"yǐn dàn zuì bǎo","abbr":"ydzb","explanation":"噉：吃饭。指酒足饭饱。","source":{"text":"未杀之顷，牛解，径来至阶而拜，县令大笑，命左右宰之。饮啖醉饱，便卧檐下。","book":"北齐·颜之推《颜氏家训·归心》"}},{"id":47695,"word":"饮弹而亡","pinyin":"yǐn dàn ér wáng","abbr":"ydew","explanation":"饮弹：中弹。因中了枪弹而死亡。","example":{"text":"当八路的都是脑壳拴在裤带上，说不定哪天～，命丧黄泉，不能害得人家当寡妇。","book":"刘绍棠《孤村》一"}},{"id":47696,"word":"饮恨吞声","pinyin":"yǐn hèn tūn shēng","abbr":"yhts","explanation":"饮恨：强忍怨恨；吞声：哭泣而不敢出声。形容忍恨含悲，不敢表露。","source":{"text":"自古皆有死，莫不饮恨而吞声。","book":"南朝·梁·江淹《恨赋》"},"example":{"text":"良民善士，疾首蹙额，～，而无所控诉。","book":"宋·陆九渊《与徐子宜书》"},"similar":["饮气吞声"],"usage":"作谓语、定语、状语；指忍气吞声"},{"id":47697,"word":"饮恨而死","pinyin":"yǐn hèn ér sǐ","abbr":"yhes","explanation":"饮恨：心里怀着怨恨和冤屈。内心满怀着怨恨或冤屈死去。","source":{"text":"我为女子，薄命如斯。君是丈夫，负心如此。韶颜稚齿，饮恨而终。","book":"唐·蒋防《霍小玉传》"},"example":{"text":"他平日也常以岳少保自期，可是岳少保～，并未能挽既倒之狂澜！","book":"姚雪垠《李自成》第一卷第二章"},"similar":["饮恨而终"],"usage":"作谓语；用于书面语"},{"id":47698,"word":"饮恨而终","pinyin":"yǐn hèn ér zhōng","abbr":"yhez","explanation":"饮恨：心里怀着怨恨和冤屈。内心满怀着怨恨或冤屈死去。","source":{"text":"我为女子，薄命如斯。君是丈夫，负心如此。韶颜稚齿，饮恨而终。","book":"唐·蒋防《霍小玉传》"},"example":{"text":"小女兴娘薄命，为思念郎君成病，于两月前～，已殡在郊外了。","book":"明·凌濛初《初刻拍案惊奇》卷二十三"},"similar":["饮恨而死"],"usage":"作谓语；用于书面语"},{"id":47699,"word":"饮气吞声","pinyin":"yǐn qì tūn shēng","abbr":"yqts","explanation":"指不喘气，不做声。形容忧惧惶恐。","source":{"text":"关东英俊，河北雄才，痛桑梓沦芜，室家颠殒，饮气吞声，志申雠怨。","book":"南朝·梁·任孝恭《为汝南王檄魏文》"},"example":{"text":"元·张养浩《寨儿令·赴詹事丞》曲：“带行人所望无成，管伴使～。”"},"usage":"作谓语、状语；用于处事"},{"id":47700,"word":"饮水不迷源","pinyin":"yǐn shuǐ bù mí yuán","abbr":"ysbmy","explanation":"喝水的时候不会忘记水是从哪儿来的。比喻不忘本。","source":{"text":"问：‘如何是本？’师曰：‘饮水不迷源。’","book":"宋·释普济《五灯会元》卷五"}},{"id":47701,"word":"饮水啄食","pinyin":"yǐn shuǐ zhuó shí","abbr":"yszs","explanation":"原指鸟类饮水、啄食。现多比喻安居乐业，生活闲适。","source":{"text":"饮啄虽勤苦，不愿栖园林。","book":"《宋书·乐志》"}},{"id":47702,"word":"饮水啜菽","pinyin":"yǐn shuǐ chuò shū","abbr":"yscs","explanation":"饿了吃豆羹，渴了喝清水。形容生活清苦。","source":{"text":"孔子曰：啜菽饮水尽其欢，斯之谓孝。","book":"西汉·戴圣《礼记·檀弓下》"},"example":{"text":"独颜氏子～，居于陋巷，无假于外。","book":"宋·苏辙《答黄庭坚书》"},"similar":["饮水食菽"],"usage":"作谓语、定语；指生活清苦"},{"id":47703,"word":"饮水忘源","pinyin":"yǐn shuǐ wàng yuán","abbr":"yswy","explanation":"喝水的时候忘记了水是从哪儿来的。比喻人处境优越时忘其所由来。","source":{"text":"饮水忘源，并置汲者于不问，其心安乎？","book":"清·李渔《闲情偶寄·草本·菊》"}},{"id":47704,"word":"饮水思源","pinyin":"yǐn shuǐ sī yuán","abbr":"yssy","explanation":"喝水的时候想起水是从哪儿来的。比喻不忘本。","source":{"text":"落其实者思其树，饮其流者怀其源。","book":"北周·庾信《徵调曲》"},"example":{"text":"这也是他～的意思。","book":"清·吴趼人《二十年目睹之怪现状》第七十八回"},"similar":["追本穷源"],"opposite":["翻身忘本"],"usage":"作谓语、宾语；指不忘本"},{"id":47705,"word":"饮水曲肱","pinyin":"yǐn shuǐ qū gōng","abbr":"ysqg","explanation":"形容清心寡欲、安贫乐道的生活。","source":{"text":"子曰：‘饭疏食饮水，曲肱而枕之，乐亦在其中矣。不义而富且贵，于我如浮云。’","book":"春秋·鲁·孔丘《论语·述而》"},"example":{"text":"～，乐在其中，岂非厄穷而不悯乎！","book":"宋·邵博《闻见后录》第11卷"},"usage":"作定语；指人的清贫生活"},{"id":47706,"word":"饮水栖衡","pinyin":"yǐn shuǐ qī héng","abbr":"ysqh","explanation":"喝水充饥，住简陋房屋。形容生活清苦。","source":{"text":"属岁兵荒，至于绝食，弟兄采佀拾橡实，饮水栖衡，而讲诵不辍，怡然终日。","book":"《旧唐书·崔慎由传》"},"usage":"作宾语、定语；用于书面语"},{"id":47707,"word":"饮水知源","pinyin":"yǐn shuǐ zhī yuán","abbr":"yszy","explanation":"比喻明白事物的本源。","source":{"text":"口诵心惟，向慕而依归。饮水知源，自觉自悟，师岂远乎哉！","book":"宋·陈宗礼《广州光孝寺大鉴禅师殿记》"},"example":{"text":"清·洪亮吉《王隐后叙》：\"仲远一记，既导美于太康，彦季全编，殊有功于处叔，～，抚柯求叶，亦沈约、魏收之祖也。\""},"similar":["饮水辨源","饮水思源"],"usage":"作谓语、宾语、定语；用于处事"},{"id":47708,"word":"饮水辨源","pinyin":"yǐn shuǐ biàn yuán","abbr":"ysby","explanation":"比喻明白事物的本源。同“饮水知源”。","source":{"text":"而得体势于《韩非子》、《吕览》者尤深，徒以薄其为人，不欲形诸论说，然后世有识，饮水辨源，其可掩耶？","book":"清·包世臣《再与杨季子书》"},"similar":["饮水知源","饮水思源"],"usage":"作谓语、宾语、定语；用于处事"},{"id":47709,"word":"饮水食菽","pinyin":"yǐn shuǐ shí shū","abbr":"ysss","explanation":"形容生活清苦。同“饮水啜菽”。","source":{"text":"莞葭为墙，蓬蒿为室，枝木为床，蓍艾为席，饮水食菽，垦山播种。","book":"晋·皇甫谧《高士传·老莱子》"},"similar":["饮水啜菽"],"usage":"作谓语、定语；指生活清苦"},{"id":47710,"word":"饮河满腹","pinyin":"yǐn hé mǎn fù","abbr":"yhmf","explanation":"比喻人应知足，贪多无益。","source":{"text":"鹪鹩巢于深林，不过一枝；偃鼠饮河，不过满腹。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"巢林一枝，鸟见遗于丛苇；～，兽不吝于洪波。","book":"宋·张君房《云笈七签》第49卷"},"similar":["偃鼠饮河"],"usage":"作宾语；用于劝诫人"},{"id":47711,"word":"饮河鼹鼠","pinyin":"yǐn hé yǎn shǔ","abbr":"yhys","explanation":"比喻指所需求或所得极有限的人。","source":{"text":"饮河鼹鼠愧盈腹，止鲁鶢鶋惭厚享。","book":"语出《庄子·逍遥游》：“偃鼠饮河，不过满腹。”明·李昌祺《剪灯余话·洞天花烛记》"},"example":{"text":"每一个人在人类智慧的长河旁边，都不过像一只饮河的鼹鼠。","book":"秦牧《社稷坛抒情》"},"usage":"作宾语、定语；用于比喻句"},{"id":47712,"word":"饮泉清节","pinyin":"yǐn quán qīng jié","abbr":"yqqj","explanation":"指廉正清白的节操。","source":{"text":"《晋书·良吏传·吴隐之》载：隆安中，吴为广州刺史，经石门，“有水名贪泉，饮者怀无厌之欲”，吴“至泉所，酌而饮之，因赋诗：‘古人云此水，一歃怀千金。试使夷齐饮，终当不易心。’”抵任后，吴“清操逾厉”。"},"example":{"text":"突兀高台累土成，人言暴客此分赢。～今寥落，可但梁山独擅名！","book":"明·刘基《分赃台》诗"},"usage":"作宾语、定语；用于书面语","story":["晋隆安年间，吴隐之担任广州刺史，经过石门贪泉时，当地人告诉他喝了这水就会变得贪婪。吴隐之不信，喝下贪泉水后作诗：“古人云此水，一歃怀千金。试使夷齐饮，终当不易心。”他到任后始终保持清廉的节操"]},{"id":47713,"word":"饮泣吞声","pinyin":"yǐn qì tūn shēng","abbr":"yqts","explanation":"饮泣：忍住泪水；吞声：咽下哭声。眼泪只能往肚里流，不敢哭出声来。形容受压迫时，忍受痛苦，不敢公开表露。","source":{"text":"琼英知了这消息，如万箭攒心，日夜吞声饮泣，珠泪偷弹，思报父母之仇，时刻不忘。","book":"明·施耐庵《水浒全传》第九十八回"},"example":{"text":"她的～，为的是爱她的儿子。","book":"邹韬奋《我的母亲》"},"similar":["忍气吞声","委曲求全"],"usage":"作谓语、定语、状语；指能忍受"},{"id":47714,"word":"饮流怀源","pinyin":"yǐn liú huái yuán","abbr":"ylhy","explanation":"指喝水时应该想想水源。比喻不能忘本。","source":{"text":"落其实者思其树，饮其流者怀其源。","book":"北周·庾信《征调曲》"},"example":{"text":"奉着这等二位恩勤备至的翁姑，伴着这等一个才貌双全的夫婿；～，打算自己当日受了八两，此时定要还她半斤。","book":"清·文康《儿女英雄传》"},"similar":["饮水知源","饮水思源"],"usage":"作谓语、宾语；指不能忘本"},{"id":47715,"word":"饮灰洗胃","pinyin":"yǐn huī xǐ wèi","abbr":"yhxw","explanation":"灰：古代以草木灰作洗涤剂。比喻悔过自新。","source":{"text":"若许某自新，必吞刀刮肠，饮灰洗胃。","book":"《南史·荀伯玉传》"},"similar":["悔过自新"],"usage":"作谓语、定语、宾语；指改过自新"},{"id":47716,"word":"饮犊上流","pinyin":"yìn dú shàng liú","abbr":"ydsl","explanation":"指蔑视爵禄名位，风操高洁。","source":{"text":"尧又召为九州长，由不欲闻之，洗耳于颍水滨。时其友巢父牵犊欲饮之，见由洗耳，问其故。对曰：尧欲召我为九州长，恶闻其声，是故洗耳。巢父曰：……子故浮游俗间，求其名誉，污吾犊口。牵犊上流而饮之。","book":"晋·皇甫谧《高士传·许由》"},"example":{"text":"～奔轶者，何年来此结茆堂。","book":"元·张简《破山涧上听水》诗"},"similar":["许由洗耳"],"usage":"作宾语、定语；用于书面语","story":["远古时期，尧听说德高望重的贤士许由很有本事，就想让他当九州长。许由坚决不从，觉得耳朵被弄脏就跑到河边反复冲洗耳朵，他的好友巢父牵牛到河边饮水，问他为什么要洗耳，许由告诉了他，巢父怕污染了牛的口就牵到上游去饮水"]},{"id":47717,"word":"饮羊登垄","pinyin":"yǐn yáng dēng lǒng","abbr":"yydl","explanation":"形容商人偷工减料，欺诈谋利的行为。","source":{"text":"后本师死，稍有贵金，卷怀离寺，作负贩去，饮羊登垄，计最工。","book":"清·蒲松龄《聊斋志异·金和尚》"}},{"id":47718,"word":"饮胆尝血","pinyin":"yǐn dǎn cháng xuè","abbr":"ydcx","explanation":"指刻苦自励。","source":{"text":"苦心焦思，置胆于坐，坐卧即仰胆，饮食也尝胆也。","book":"西汉·司马迁《史记·越王勾践世家》"},"example":{"text":"《隋书·越王侗传》：“朕所以刻骨崩心，～。”"},"similar":["卧薪尝胆"],"usage":"作谓语、定语；用于书面语"},{"id":47719,"word":"饮至策勋","pinyin":"yǐn zhì cè xún","abbr":"yzcx","explanation":"饮至：古代诸侯朝、会、盟、伐毕，回到宗庙饮酒庆贺；策勋：把功勋记在简策上。古时诸侯在宗庙举行庆功祝捷的仪式。","source":{"text":"车驾还京，会百僚于宣极堂，行饮至策勋之礼。","book":"《左传·桓公二年》：“凡公行告于公庙，反行饮至，舍爵策勋焉。”《魏书·彭城王传》"},"example":{"text":"～，和乐且闲。","book":"唐·李华《吊古战场文》"},"usage":"作宾语、定语；用于书面语"},{"id":47720,"word":"饮血崩心","pinyin":"yǐn xuè bēng xīn","abbr":"yxbx","explanation":"血泪满面，心为之碎。形容极度悲痛。","source":{"text":"忽闻神京沦陷，先帝升遐，饮血崩心，呼号天地。","book":"明·陈子龙《兵垣奏议·募练水师疏》"},"usage":"作谓语、状语；用于书面语"},{"id":47721,"word":"饮血茹毛","pinyin":"yǐn xuè rú máo","abbr":"yxrm","explanation":"茹：吃。用来描绘原始人不会用火，连毛带血地生吃禽兽的生活。","source":{"text":"未有火化，食草木之实，鸟兽之肉，饮其血，茹其毛，未有麻丝，衣其羽皮。","book":"西汉·戴圣《礼记·礼运》"},"example":{"text":"啖鸟兽之肉，～，蠢然无闷。","book":"宋·张君房《云笈七签》第56卷"},"similar":["茹毛饮血"],"usage":"作宾语、定语；指原始生活"},{"id":47722,"word":"饮谷栖丘","pinyin":"yǐn gǔ qī qiū","abbr":"ygqq","explanation":"犹言栖丘饮谷。指隐逸山林。","source":{"text":"欲买溪山不用钱，倦来高枕白云眠。吾生此外无他愿，饮谷栖丘二十年。","book":"清·吴伟业《口占》"},"similar":["栖丘饮谷"],"usage":"作谓语、定语；指隐居"},{"id":47723,"word":"饮酒茹荤","pinyin":"yǐn jiǔ rú hūn","abbr":"yjrh","explanation":"茹：吃。指喝酒吃肉。","source":{"text":"纵一人之身恒尽诚洁，岂左右臣妾各竭虔仰？不可独升，必有扈侍，惧或忘慎，非饮酒茹荤而已。","book":"《魏书·崔光传》"},"example":{"text":"及崩，上深悼之，丧敛祭享有加礼，不～者逾月。","book":"《清史稿·后妃传》"}},{"id":47724,"word":"饮酒高会","pinyin":"yǐn jiǔ gāo huì","abbr":"yjgh","explanation":"高会：显赫人物的聚会。地位显赫的人们在一起饮酒聚会。","source":{"text":"乃遣其子宋襄相齐，身送之至无盐，饮酒高会。天寒大雨，士卒冻饥。","book":"《史记·项羽本纪》"},"example":{"text":"值端阳，～，忽一白兔跃入。","book":"清·蒲松龄《聊斋志异·褚遂良》"}},{"id":47725,"word":"饮醇自醉","pinyin":"yǐn chún zì zuì","abbr":"yczz","explanation":"醇：浓酒。比喻与宽厚人交，不觉心醉。","source":{"text":"与周公谨交，若饮醇醪，不觉自醉。","book":"《三国志·吴书·周瑜传》裴松之注引《江表传》"},"usage":"作谓语、宾语；指人际关系","story":["三国时期，吴国名将周瑜性格开朗，气度宽宏，待人接物谦虚和气，与朝中的官员相处很好。唯独程普对他不满，经常倚老卖老，给周瑜脸色看。周瑜不愿与他闹矛盾，处处克制与谦让。程普有所感动，感慨地说同他交往像饮醇自醉"]},{"id":47726,"word":"饮露餐风","pinyin":"yǐn lù cān fēng","abbr":"ylcf","explanation":"喝的是露水，吃的是风。形容超凡脱俗的生活。亦作“饮风餐露”。","source":{"text":"虽然形状不寻常，饮露餐风易隐藏。","book":"明·无名氏《破风诗》第三折"},"similar":["饮风餐露","餐风饮露"],"usage":"作谓语、定语；形容旅途艰辛"},{"id":47727,"word":"饮风餐露","pinyin":"yǐn fēng cān lù","abbr":"yfcl","explanation":"饮食风露。比喻远离世俗而生活。","source":{"text":"黄冠鹤氅，息气养神，导咽还丹，饮风餐露。","book":"明·无名氏《破天阵》"},"similar":["饮露餐风"],"usage":"作谓语、定语；形容旅途艰辛"},{"id":47728,"word":"饮食男女","pinyin":"yǐn shí nán nǚ","abbr":"ysnn","explanation":"饮食：食欲；男女：性欲。儒家的观点，泛指人的本性。","source":{"text":"饮食男女，人之大欲存焉。","book":"《礼记·礼运》"},"example":{"text":"天地之大，古今之变，万汇之赜，日星河岳，赋物象形，兵刑礼乐，～，于以发为文章，形为诗赋。","book":"清·叶燮《原诗·内篇上》"},"usage":"作宾语、定语；泛指人的本性"},{"id":47729,"word":"饮食起居","pinyin":"yǐn shí qǐ jū","abbr":"ysqj","explanation":"指人的日常生活。","source":{"text":"公为辅弼，饮食起居，如陋巷之士。","book":"宋·欧阳修《祭杜祁公文》"},"example":{"text":"劳航芥又喜欢架弄，一切都讲究，不要说是～了。","book":"清·李宝嘉《文明小史》第49回"},"similar":["生活起居"],"usage":"作主语、宾语、定语；指日常生活"},{"id":47730,"word":"饮马投钱","pinyin":"yìn mǎ tóu qián","abbr":"ymtq","explanation":"比喻为人廉洁，不损公肥私。","source":{"text":"安陵清者有项仲仙，饮马渭水，每投三钱。","book":"唐·徐坚《初学记》卷六引《三辅决录》"},"example":{"text":"明·程登吉《幼学琼林》第一卷：“汉刘宽责民，蒲鞭示辱；项仲山洁己，～。”"},"usage":"作宾语、定语；指不贪便宜","story":["汉朝时期，为人十分清廉的安陵人项仲山，清廉得让人发笑。每次在渭河给马喂水时，都要投入3枚铜钱，表示不敢妄取占便宜"]},{"id":47731,"word":"饮马长江","pinyin":"yǐn mǎ cháng jiāng","abbr":"ymcj","explanation":"在长江边给战马喝水。指渡江南下进行征伐。","source":{"text":"道济见收，愤怒气盛，目光如炬，俄尔间引饮一斛。乃脱帻投地，曰：‘乃坏汝万里长城。’魏人闻之，……自是频岁南伐，有饮马长江之志。","book":"《南史·檀道济传》"},"example":{"text":"明·张四维《双烈记·虏骄》：“神兵到来谁敢阻，～浒。”"},"usage":"作定语；用于书面语","story":["南朝宋国大将檀道济智勇双全，屡立战功，北魏军队对他惧怕三分。由于宋朝廷昏庸，檀道济被陷害，被捕时他愤恨得目光如炬，气愤地说：“长城坏矣。”魏军听说檀道济已死就加紧进攻，很快灭了宋国，实现了饮马长江的愿望"]},{"id":47732,"word":"饮鸩救渴","pinyin":"yǐn zhèn jiù kě","abbr":"yzjk","explanation":"鸩：传说中的毒鸟，用它的羽毛浸的酒喝了能毒死人。喝毒酒解渴。比喻用错误的办法来解决眼前的困难而不顾严重后果。","source":{"text":"见黄雀而忘深井，食钩吻以疗饥，饮鸩毒以救渴，智者所不为，仁者所不向。","book":"北齐·杜弼《为东魏檄梁文》"}},{"id":47733,"word":"饮鸩止渴","pinyin":"yǐn zhèn zhǐ kě","abbr":"yzzk","explanation":"鸩：传说中的毒鸟，用它的羽毛浸的酒喝了能毒死人。喝毒酒解渴。比喻用错误的办法来解决眼前的困难而不顾严重后果。","source":{"text":"譬犹疗饥于附子，止渴于鸩毒，未入肠胃，已绝咽喉。","book":"《后汉书·霍谞传》"},"example":{"text":"杨嗣昌的加征练饷办法是使朝廷～。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["饥不择食","急功近利"],"opposite":["从长计议"],"usage":"作谓语、宾语、定语；指人的方法不对","story":["东汉时期州郡长官宋光为人正直，秉公办案，得罪了皇亲国戚，被诬陷入狱，他的外甥霍决定为舅舅伸冤，就在申辩信中写道：“宋光不会冒死去篡改诏书，那样做无异于饮鸩止渴。”大将军梁商看中霍的才识就亲自向皇帝汇报救了宋光"]},{"id":47734,"word":"饮鸩解渴","pinyin":"yǐn zhèn jiě kě","abbr":"yzjk","explanation":"比喻用错误的办法来解决眼前的困难而不顾严重后果。同“饮鸩止渴”。","source":{"text":"此时危急情形，等于然眉，若再恃新军为保卫，无异饮鸩解渴，其危险有不忍言者。","book":"《辛亥革命·武昌起义清方档案·清吏条陈》"},"similar":["饮鸩止渴"],"usage":"作谓语、宾语、定语；指人的方法不对"},{"id":47735,"word":"饰垢掩疵","pinyin":"shì gòu yǎn cī","abbr":"sgyc","explanation":"粉饰掩盖污点和缺点。","source":{"text":"虽当时文簿，记其殿最，日久月深，驳落都尽……累年之后，方求追访声迹，立其考第。无不苟相悦附，共为唇齿，饰垢掩疵，妄加丹素，趣令得阶而已，无所顾惜。","book":"《魏书·萧宝夤传》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":47736,"word":"饰怪装奇","pinyin":"shì guài zhuāng qí","abbr":"sgzq","explanation":"指故为怪异。","source":{"text":"今之梨园，购得一新本，则因其新而愈新之，饰怪装奇，不遗余力。","book":"清·李渔《闲情偶寄·演习·变调》"},"usage":"作谓语、宾语；用于书面语"},{"id":47737,"word":"饰情矫行","pinyin":"shì qíng jiǎo xíng","abbr":"sqjx","explanation":"指掩饰自己的真心本意，行为矫揉造作。","source":{"text":"问有廉洁自好之人，反为众忌，不说是饰情矫行，定指是钓誉沽名，群口挤排，每每是非颠倒，沉沦不显。","book":"《石点头·贪婪汉六院卖风流》"},"usage":"作谓语、宾语；用于处事"},{"id":47738,"word":"饰智矜愚","pinyin":"shì zhì jīn yú","abbr":"szjy","explanation":"装作有智慧而在无知者面前夸耀。","source":{"text":"饰知以惊愚，修身以明污。","book":"战国·宋·庄周《庄子·山木》"},"example":{"text":"成汤伪让，仲尼～。斯数言者，战国有之。","book":"明·胡应麟《少室山房笔丛》"},"similar":["自作聪明"],"usage":"作谓语；指人自作聪明"},{"id":47739,"word":"饰词矫情","pinyin":"shì cí jiǎo qíng","abbr":"scjq","explanation":"饰：修饰。修饰言辞掩盖真相。","source":{"text":"都是汝等谗佞之徒，误国之辈，妒贤嫉能，闭塞贤路，饰词矫情，坏尽朝廷大事！","book":"明·施耐庵《水浒传》第83回"},"usage":"作谓语、定语；用于处事"},{"id":47740,"word":"饰非养过","pinyin":"shì fēi yǎng guò","abbr":"sfyg","explanation":"粉饰错误，养成过失。同“饰非遂过”。","source":{"text":"及其崛然自见者，犹皆自有为国之意，使其下无饰非养过之心。","book":"宋·叶適《法度总论二》"},"similar":["饰非遂过"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":47741,"word":"饰非拒谏","pinyin":"shì fēi jù jiàn","abbr":"sfjj","explanation":"饰：掩饰；非：错误；谏：直言规劝。拒绝劝告，掩饰错误。","source":{"text":"拒谏饰非，愚而上同，国必祸。","book":"《荀子·成相》"},"example":{"text":"～，断自己意。","book":"宋·孙光宪《北梦琐言》卷五"},"similar":["拒谏饰非"],"opposite":["拭面容言"],"usage":"作谓语、定语；指人不听劝告"},{"id":47742,"word":"饰非掩丑","pinyin":"shì fēi yǎn chǒu","abbr":"sfyc","explanation":"饰：掩饰；非：错误；丑：丑恶。掩饰错误和丑恶的行为。","source":{"text":"更可恨者，自古来多少轻薄浪子，皆以‘好色不淫’为解，又以‘情而不淫’作案，此皆饰非掩丑之语耳。","book":"清·曹雪芹《红楼梦》第五因"},"usage":"作谓语、宾语、定语；用于处事"},{"id":47743,"word":"饰非掩过","pinyin":"shì fēi yǎn guò","abbr":"sfyg","explanation":"粉饰掩盖过失、错误。同“饰非文过”。","source":{"text":"我虽然也被谥为‘土匪’之一，却并不想为前辈们饰非掩过。","book":"鲁迅《华而盖续编·学界的三魂》"},"similar":["饰非文过","文过饰非"],"usage":"作谓语、宾语；用于处事"},{"id":47744,"word":"饰非文过","pinyin":"shì fēi wén guò","abbr":"sfwg","explanation":"粉饰掩盖过失、错误。","source":{"text":"谓人有坚为辩言，不以诚质，学于非道，虽博无用，饰非文过，辞语顺泽，不听教命。","book":"《汉书·贾捐之传》颜师古注"},"example":{"text":"清·陈梦雷《绝交书》：“老年兄怙终迷复，羞于～。”"},"similar":["饰非掩过","文过饰非"],"usage":"作谓语、宾语；用于处事"},{"id":47745,"word":"饰非遂过","pinyin":"shì fēi suì guò","abbr":"sfsg","explanation":"明知错误而加以掩饰，于是就造成过失。","source":{"text":"公子食我之辩，适足以饰非遂过。","book":"《吕氏春秋·审应》"},"similar":["饰非养过"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":47746,"word":"饱人不知饿人饥","pinyin":"bǎo rén bù zhī è rén jī","abbr":"brbzerj","explanation":"比喻处境顺利、优越或个人愿望得到满足的人，不理解处境困难、恶劣或个人愿望不得实现的人的苦衷。","source":{"text":"误了差使钉子是我碰！你饱人不知饿人饥！","book":"清·李宝嘉《官场现形记》第45回"},"example":{"text":"你别～，我们需要他的帮助。"},"similar":["饱汉不知饿汉饥"],"opposite":["知暖知热"],"usage":"作宾语、分句；指不能理解别人的处境"},{"id":47747,"word":"饱以老拳","pinyin":"bǎo yǐ lǎo quán","abbr":"bylq","explanation":"饱：充分；以：用。痛打，尽情地揍。","source":{"text":"孤往日厌卿老拳，卿亦饱孤毒手。","book":"《晋书·石勒载记下》"},"example":{"text":"他随即把老婆痛打一顿。～是把男女生理上的共性消除不了的。","book":"李欣《从“男女有别”谈起》"},"similar":["饱飨老拳"],"usage":"作谓语、定语；指拳打别人"},{"id":47748,"word":"饱其私囊","pinyin":"bǎo qí sī náng","abbr":"bqsn","explanation":"饱：满足；囊：口袋。指非法侵吞钱财，装入自己腰包。","source":{"text":"他又并不将此款归入公家，一律饱其私囊。","book":"清·李宝嘉《官场现形记》第33回"},"similar":["中饱私囊"],"opposite":["大公无私"],"usage":"作谓语、定语；指人贪心"},{"id":47749,"word":"饱学之士","pinyin":"bǎo xué zhī shì","abbr":"bxzs","explanation":"饱学：学识渊博。指学识渊博的人。","source":{"text":"公等皆饱学之士，登此高台，可不进佳章以纪一时胜事乎？","book":"明·罗贯中《三国演义》第五十六回"},"example":{"text":"那位老先生也许是个～，一笔字也写得挺好。","book":"张天冀《新生》"},"similar":["经纶之才","学富五车"],"opposite":["胸无点墨"],"usage":"作主语、宾语；指学者"},{"id":47750,"word":"饱当知人饥","pinyin":"bǎo dāng zhī rén jī","abbr":"bdzrj","explanation":"自己吃饱了，应该知道还有人饿脖子。","source":{"text":"古之贤君，饱而知人之饥，温而知人之寒。","book":"《晏子春秋·内篇谏上》"}},{"id":47751,"word":"饱暖思淫欲","pinyin":"bǎo nuǎn sī yín yù","abbr":"bnsyy","explanation":"食饱衣暖之时，则生淫欲之心。","source":{"text":"参见“饱暖生淫欲”。"},"example":{"text":"自古道：“～”，王禄手头饶裕，又见财物易得，便思量淫荡起来。","book":"明·凌濛初《二刻拍案惊奇》卷二十一"},"similar":["饱暖生淫欲"],"usage":"作谓语、宾语；指人的邪念"},{"id":47752,"word":"饱暖生淫欲","pinyin":"bǎo nuǎn shēng yín yù","abbr":"bnsyy","explanation":"指生活安逸，易起淫念。","source":{"text":"[正旦唱]这厮只因饱暖生淫欲……[正旦唱]便休想似水如鱼。","book":"明·贾仲名《对玉梳》第三折"},"example":{"text":"这个程朝奉拥着巨万家私，所谓～，心里只喜欢的是女色。","book":"明·凌濛初《二刻拍案惊奇》卷二十八"},"similar":["饱暖思淫欲"],"usage":"作定语、宾语；指人的邪念，用于劝诫人"},{"id":47753,"word":"饱汉不知饿汉饥","pinyin":"bǎo hàn bù zhī è hàn jī","abbr":"bhbzehj","explanation":"饱：吃足；饥：饥饿。比喻处境好的人，不能理解别人的苦衷。","source":{"text":"误了差使，钉子是我碰！你饱人不知饿人饥。","book":"清·李宝嘉《官场现形记》第45回"},"example":{"text":"你这是‘～’。"},"similar":["饱人不知饿人饥"],"opposite":["知暖知热"],"usage":"作宾语、分句；指不能理解别人的处境"},{"id":47754,"word":"饱眼福","pinyin":"bǎo yǎn fú","abbr":"byf","explanation":"看到想看而又难以看到的东西，并看个充分","example":{"text":"这次国际展览让我大～"},"similar":["一饱眼福"],"usage":"作谓语、宾语；用于口语"},{"id":47755,"word":"饱练世故","pinyin":"bǎo liàn shì gù","abbr":"blsg","explanation":"指对世态人情有深刻感受或有丰富的处世经验。同“饱谙世故”。","source":{"text":"察江之言，皆饱练世故而不回挠，是足以继其父兄矣。","book":"宋·叶適《郭府君墓志铭》"},"similar":["饱谙世故"],"usage":"作谓语、定语；指经历丰富"},{"id":47756,"word":"饱经世变","pinyin":"bǎo jīng shì biàn","abbr":"bjsb","explanation":"指经历了许多人世变故。","source":{"text":"我这位表姊，本是家乡的名美人，现在他饱经世变，家庭生活的苦痛已经如狂风骤雨扫净了春意。","book":"瞿秋白《饿乡纪程》三"},"example":{"text":"他说着江西话，似乎很老成了，是～的样子。","book":"朱自清《白采》"},"similar":["饱经世故"],"usage":"作谓语、定语；指经历丰富"},{"id":47757,"word":"饱经世故","pinyin":"bǎo jīng shì gù","abbr":"bjsg","explanation":"指阅历多，积累了丰富的处世经验。","source":{"text":"占得溪山卜数椽，饱经世故气犹全。","book":"宋·陆游《书兴》诗"},"example":{"text":"女的红色透明女雨衣，内着华贵的颀袍，也挟着一个大型的女用手持皮包，像是一个～的妇人。","book":"洪深《鸡鸣早看天》第一幕"},"similar":["饱经世变"],"usage":"作谓语、定语；指经历丰富"},{"id":47758,"word":"饱经忧患","pinyin":"bǎo jīng yōu huàn","abbr":"bjyh","explanation":"指经历了许多困苦患难。","source":{"text":"盛太夫人，夏完淳之嫡母，年五十余，因饱经忧患，甚显衰老。","book":"郭沫若《南冠草》第二幕第一场"},"example":{"text":"他们说他是出身于贫苦的满族家庭，～。","book":"冰心《晚晴集·老舍和孩子们》"},"similar":["饱经风霜","饱经沧桑"],"opposite":["未经沧桑","入世未深"],"usage":"作谓语、宾语；形容经历长期忧愁患难的生活"},{"id":47759,"word":"饱经沧桑","pinyin":"bǎo jīng cāng sāng","abbr":"bjcs","explanation":"饱：充分。沧桑：沧海变桑田的简缩。泛指世事的变化。经历过多次的世事变化，生活经历极为丰富。","source":{"text":"而你是一个四十六岁的男人，饱经沧桑，眼角皱纹细密如网。","book":"王蒙《轮下》"},"example":{"text":"从她那～的脸上我读出了许多。"},"similar":["饱经风霜","曾经沧桑","饱经忧患"],"opposite":["初出茅庐","少不更事","乳臭未干"],"usage":"作谓语、定语；用于阅历深"},{"id":47760,"word":"饱经霜雪","pinyin":"bǎo jīng shuāng xuě","abbr":"bjsx","explanation":"饱：充分；经：经历；霜雪：比喻艰难困苦。形容经历过长期的艰难困苦的生活和斗争。","source":{"text":"鸡皮瘦损，看饱经霜雪，丝鬓如银。","book":"清·孔尚任《桃花扇·孤吟》"},"example":{"text":"～的他已经没有先前的威风了。"},"similar":["饱经风霜"],"opposite":["风调雨顺"],"usage":"作谓语、定语；形容经验丰富"},{"id":47761,"word":"饱经风雨","pinyin":"bǎo jīng fēng yǔ","abbr":"bjfy","explanation":"指经历过许多艰难困苦。同“饱经风霜”。","source":{"text":"我们的道路总算走得很长了吧，是坎坷不平的，也是饱经风雨的，终于走到现在。","book":"孙犁《秀露集·文学和生活的路》"},"similar":["饱经风霜"],"usage":"作谓语、定语；形容经验丰富"},{"id":47762,"word":"饱经风霜","pinyin":"bǎo jīng fēng shuāng","abbr":"bjfs","explanation":"饱：充分；经：经历；风霜：比喻艰难困苦。形容经历过长期的艰难困苦的生活和斗争。","source":{"text":"鸡皮瘦损，看饱经雪霜，丝鬓如银。","book":"清·孔尚任《桃花扇》第二十一出"},"example":{"text":"人们那被晒黑的～的脸上，显出严肃而紧张的神情。","book":"冯德英《苦菜花》第一章"},"similar":["饱经世故","曾经沧海"],"opposite":["一帆风顺","养尊处优"],"usage":"作谓语、定语；形容经验丰富"},{"id":47763,"word":"饱谙世故","pinyin":"bǎo ān shì gù","abbr":"basg","explanation":"指对世态人情有深刻感受或有丰富的处世经验。","source":{"text":"吴侯晚到东海滨，饱谙世故无戚欣。","book":"宋·楼钥《吴参议达观斋》诗"},"similar":["饱练世故"],"usage":"作谓语、定语；指为人处世"},{"id":47764,"word":"饱谙经史","pinyin":"bǎo ān jīng shǐ","abbr":"bajs","explanation":"饱谙：深知，极其熟悉。熟知经书史籍。形容学问渊博。","source":{"text":"此人饱谙经史，贯串百家。","book":"元·无名氏《竹叶舟》楔子"}},{"id":47765,"word":"饱食思淫欲","pinyin":"bǎo shí sī yín yù","abbr":"bssyy","explanation":"饱：吃足；食：吃；淫：邪恶。指生活安逸，容易起淫念。","source":{"text":"锦衣玉食，合着了俗语饱食思淫欲这句了。","book":"明·罗贯中《三遂平妖传》第35回"},"similar":["饱暖生淫欲"],"usage":"作定语、宾语；指人的邪念，用于劝诫人"},{"id":47766,"word":"饱食暖衣","pinyin":"bǎo shí nuǎn yī","abbr":"bsny","explanation":"饱食：吃得饱；暖衣：穿得暖。形容生活宽裕，衣食丰足。","source":{"text":"人之有道也：饱食暖衣，逸居而无教，则近于禽兽。","book":"《孟子·滕文公上》"},"example":{"text":"今为若计，欲舞文乱法，快意一时，而身陷刑戮乎？欲守公奉法，～，与妻子处乎？","book":"清·王晫《今世说·政事》"},"similar":["丰衣足食","暖衣饱食"],"opposite":["饥寒交迫","无衣无食"],"usage":"作谓语、定语、补语；形容吃穿不愁"},{"id":47767,"word":"饱食终日","pinyin":"bǎo shí zhōng rì","abbr":"bszr","explanation":"终日：整天。整天吃饱饭，不动脑筋，不干什么正经事。","source":{"text":"饱食终日，无所用心，难矣哉！","book":"《论语·阳货》"},"example":{"text":"人如果～，无所用心，那是最没有出息的。"},"similar":["无所事事","好逸恶劳","尸位素餐"],"opposite":["废寝忘食","夜以继日","事必躬亲"],"usage":"作谓语、定语；形容什么事都不做","story":["春秋时期，孔子经常教育他的学生向颜回学习，不要追慕富贵与享受，用心读书。孔子说如果一个人一天到晚吃得饱饱的没有事可干，不去用心思考问题，那就没有造就了。世上下棋的人虽然悠闲但也要用心，比起那些饱食终日的人来真是强多了"]},{"id":47768,"word":"饱食终日，无所事事","pinyin":"bǎo shí zhōng rì，wú suǒ shì shì","abbr":"bszrwsss","explanation":"饱：吃足；终日：整天。整天吃得饱饱的，什么事也不干。","source":{"text":"饱食终日，无所事事的地主阶级，品质却是最恶劣的。","book":"吕振羽《简明中国通史》第九章"},"example":{"text":"他们这些官僚主义～。"},"similar":["饱食终日，无所用心"],"usage":"作谓语、定语；指闲人"},{"id":47769,"word":"饱食终日，无所用心","pinyin":"bǎo shí zhōng rì，wú suǒ yòng xīn","abbr":"bszrwsyx","explanation":"终日：整天。整天吃饱饭，什么事也不关心。","source":{"text":"子曰：‘饱食终日，无所用心，难矣哉！’","book":"春秋·鲁·孔丘《论语·阳货》"},"example":{"text":"～，以与朋辈优游谑浪，炳麟亦不为也。","book":"章炳麟《与袁世凯书》"},"similar":["饱食终日，无所事事"],"usage":"作谓语、定语；指闲人","story":["春秋时期，孔子经常教育他的学生向颜回学习，不要追慕富贵与享受，用心读书。孔子说如果一个人一天到晚吃得饱饱的没有事可干，不去用心思考问题，那就没有造就了。下棋的人虽然悠闲但也要用心，比起饱食终日，无所用心的人来强多了"]},{"id":47770,"word":"饱飨老拳","pinyin":"bǎo xiǎng lào quán","abbr":"bxlq","explanation":"指挨一顿痛打。参见“饱以老拳”。","source":{"text":"[杜氏]怒将起来，几乎要打，这张类村只得学刘寄如饱飨老拳的本领。","book":"《歧路灯》第六七回"},"similar":["饱以老拳"],"usage":"作谓语、定语；指拳打别人"},{"id":47771,"word":"饱餐一顿","pinyin":"bǎo cān yī dùn","abbr":"bcyd","explanation":"指大吃一顿。","source":{"text":"士信觉得心中爽快，饱餐一顿，把手一拱，跨上马如飞的去了。","book":"清·褚人获《隋唐演义》第44回"},"example":{"text":"回到家后，我将～。"},"similar":["大饱口福"],"usage":"作谓语、宾语；指大吃一顿"},{"id":47772,"word":"饴含抱孙","pinyin":"yí hán bào sūn","abbr":"yhbs","explanation":"含着饴糖逗小孙子。形容老人自娱晚年，不问他事的乐趣。同“含饴弄孙”。","source":{"text":"饴含抱孙，亦止孝先一人。","book":"清·龚玉晨《紫姬小传》"},"similar":["含饴弄孙"],"usage":"作谓语、定语；用于书面语"},{"id":47773,"word":"饵名钓禄","pinyin":"ěr wén diào lù","abbr":"emdl","explanation":"饵、钓：诱取；禄：薪俸。指用不正当的手段谋求官职和薪俸。","source":{"text":"更有时文八股一道，因平素深恶，说这原非圣贤制撰，焉能阐发圣贤之奥，不过是后人饵名钓禄之阶。","book":"《清·曹雪芹《红楼梦》第七十三回"},"usage":"作谓语、定语；指谋取名利"},{"id":47774,"word":"饶有兴味","pinyin":"ráo yǒu xīng wèi","abbr":"ryxw","explanation":"饶：富裕、丰富；兴味：趣味，兴趣。形容事物和景物富有情趣。","source":{"text":"直应携去林泉好，转觉林泉兴味长。","book":"宋·蔡襄《漳州白莲僧宗要见遗纸扇》"}},{"id":47775,"word":"饶有兴趣","pinyin":"ráo yǒu xìng qù","abbr":"ryxq","explanation":"令人感到很有趣，并十分注意。","source":{"text":"看到米兰和留在亭子里的高家哥俩从容、饶有兴趣地聊起来，我感到欣慰。","book":"王朔《动物凶猛》"},"example":{"text":"我在钓鱼方面～。"},"similar":["饶有兴致"],"usage":"作谓语、定语；指十分有趣"},{"id":47776,"word":"饶有风趣","pinyin":"ráo yǒu fēng qù","abbr":"ryfq","explanation":"很有风趣。","source":{"text":"李二卯总是在热炕头上讲故事，故事一到他的嘴里人们都爱听，说得饶有风趣。","book":"《迷人的故事》"},"example":{"text":"他的谈吐幽默，～。"},"similar":["别有风趣"],"usage":"作谓语、状语；指很有风趣"},{"id":47777,"word":"饶舌调唇","pinyin":"ráo shé tiáo chún","abbr":"rstc","explanation":"饶舌，多嘴。调唇，耍嘴皮子。指多嘴多舌，搬弄是非。","source":{"text":"我恰待饶舌调唇，怎当他拔树寻根。","book":"明·无名氏《苏九淫奔》第一折"},"similar":["多嘴多舌"],"usage":"作谓语、定语、宾语；用于说话等"},{"id":47778,"word":"饾饤堆砌","pinyin":"dòu dǐng duī qì","abbr":"dddq","explanation":"饾饤：供陈设的食品。像供陈设的食品一样堆在一起。比喻文辞堆砌，罗列而无中心。","source":{"text":"词中所用典故，信手拈来，不露饾饤堆砌之痕。","book":"清·孔尚任《桃花扇》"},"usage":"作谓语、定语；用于文章或说话"},{"id":47779,"word":"饿死事大","pinyin":"è sǐ shì dà","abbr":"essd","explanation":"饿死人是大事。","source":{"text":"况贫能病人，饿死事大，不惟利禄之见，尽人难免也。","book":"清·田北湖《与某生论韩文书》"},"usage":"作宾语、定语；用于口语"},{"id":47780,"word":"饿死事小，失节事大","pinyin":"è sǐ shì xiǎo，shī jié shì dà","abbr":"essxsjsd","explanation":"失节：原为封建礼教指女子失去贞操，后泛指失去节操。贫困饿死是小事，失节事情就大了。","source":{"text":"又问：‘或有孤孀贫穷无托者，可再嫁否？’曰：‘只是后世怕寒饿死，故有是说。然饿死事极小，失节事极大！’","book":"《二程全书·遗书二十二》"},"example":{"text":"～之言，村儿井童，亦能耳熟，自此以后为男子者，率以妇人之失节为羞。","book":"清·方苞《赵氏贞烈传序》"},"usage":"作宾语、分句；旧时用于劝诫妇人"},{"id":47781,"word":"饿殍枕藉","pinyin":"è piǎo zhěn jí","abbr":"epzj","explanation":"饿殍：饿死的人；枕藉：交叠而卧。饿死的人纵横交叠，形容饥荒之年的悲惨景象。","source":{"text":"那个庄上不饿殍枕藉。","book":"清·西周生《醒世姻缘传》第32回"},"similar":["饿殍遍野"],"usage":"作谓语、定语；指饥荒之年的悲惨景象"},{"id":47782,"word":"饿殍满道","pinyin":"è piǎo mǎn dào","abbr":"epmd","explanation":"殍：饿死的人。满路都是因饥饿而死的人的尸体。形容饥荒灾祸严重，人民大量死于饥寒的惨状。","source":{"text":"坐视战士之蔬菜，立望饿殍之满道，如之何为君行此政也。","book":"汉·仲长统《昌言·损益篇》"},"similar":["饿殍载道"],"usage":"作谓语、定语、分句；指饥饿死人"},{"id":47783,"word":"饿殍载道","pinyin":"è piǎo zài dào","abbr":"epzd","explanation":"饿殍：饿死的人；载道：满路都是。形容到处都是饿死的人。","source":{"text":"道德沦丧，法度凌夷，匪党纵横，饿殍载道。","book":"蔡东藩《民国通俗演义》第85回"},"example":{"text":"～的灾后景象是不会再出现了。"},"similar":["饿殍遍野","饿莩载道"],"usage":"作宾语、定语；指到处都是饿死的人"},{"id":47784,"word":"饿殍遍野","pinyin":"è piǎo biàn yě","abbr":"epby","explanation":"殍：人饿死后的尸体。到处是饿死的人。形容老百姓因饥饿而大量死亡的悲惨景象。","source":{"text":"庖有肥肉，厩有肥马，民有饥色，野有饿莩，此率兽而食人也。","book":"先秦·孟轲《孟子·梁惠王上》"},"example":{"text":"是岁大荒百姓皆食枣菜，～。","book":"明·罗贯中《三国演义》"},"similar":["尸横遍野","十室九空"],"opposite":["人寿年丰","民康物阜"],"usage":"作谓语、定语、分句；指饥饿死人"},{"id":47785,"word":"饿莩载道","pinyin":"è piǎo zǎi dào","abbr":"epzd","explanation":"莩：饿死的人。载道：满路。满路都是因饥饿而死的人的尸体。形容饥荒灾祸严重，人民大量死于饥寒的惨状。同“饿殍载道”、“饿殍满道”。","source":{"text":"迨父殁未几，适当明季，蝗旱不登，饿莩载道。","book":"清·钱泳《履园丛话·旧闻·席氏多贤》"},"example":{"text":"沿途～，臭不可闻。","book":"《中国的西北角·成兰纪行》"},"similar":["饿殍载道"],"usage":"作宾语、定语；指到处都是饿死的人"},{"id":47786,"word":"饿莩遍野","pinyin":"è piǎo biàn yě","abbr":"epby","explanation":"莩：饿死的人。到处是饿死的人。形容人民因饥饿而大量死亡的悲惨景象。","source":{"text":"庖有肥肉，厩有肥马，民有饥色，野有饿莩，此率兽而食人也。","book":"《孟子·梁惠王上》"},"example":{"text":"是岁大荒，百姓皆食枣菜，～","book":"明·罗贯中《三国演义》第十三回"},"similar":["饿殍遍野"],"usage":"作谓语、定语、分句；指饥饿死人"},{"id":47787,"word":"饿虎之蹊","pinyin":"è hǔ zhī xī","abbr":"ehzq","explanation":"比喻非常危险的处所。","source":{"text":"是谓委肉当饿虎之蹊也。","book":"《史记·刺客列传》"},"usage":"作宾语；比喻非常危险的处所"},{"id":47788,"word":"饿虎吞羊","pinyin":"è hǔ tūn yáng","abbr":"ehty","explanation":"饥饿的老虎活吞一只羊羔。比喻迅猛贪婪。","source":{"text":"一个初侵女色，由如饿虎吞羊。","book":"明·洪楩《清平山堂话本·五戒禅师私红莲记》"},"example":{"text":"他的吃相就像～。"},"similar":["饿虎扑食","饿虎见羊"],"usage":"作定语、宾语；形容迅速凶猛贪婪"},{"id":47789,"word":"饿虎扑羊","pinyin":"è hǔ pū yáng","abbr":"ehpy","explanation":"象饥饿的老虎扑向食物一样。比喻动作猛烈而迅速。","source":{"text":"一个初侵女色，由（犹）如饿虎吞羊。","book":"明·洪楩《清平山堂话本·五戒禅师么红莲记》"},"example":{"text":"敌人像～一样扑向解放区。"},"similar":["饿虎见羊","饿虎扑食"],"usage":"作定语、宾语；形容迅速凶猛贪婪"},{"id":47790,"word":"饿虎扑食","pinyin":"è hǔ pū shí","abbr":"ehps","explanation":"象饥饿的老虎扑向食物一样。比喻动作猛烈而迅速。","source":{"text":"饿虎扑食最伤人，蛟龙戏水能凶恶。","book":"明·吴承恩《西游记》第五十一回"},"example":{"text":"那人刚到面前，便如～，猫儿捕鼠的一般，抱住叫道：“亲嫂子，等死我了。”","book":"清·曹雪芹《红楼梦》第十二回"},"similar":["气势汹汹","猛虎下山"],"opposite":["龙困浅滩","虎落平阳"],"usage":"作宾语、定语；形容动作凶猛的样子"},{"id":47791,"word":"饿虎擒羊","pinyin":"è hǔ qín yáng","abbr":"ehqy","explanation":"像饥饿的老虎捕食羔羊一样。比喻迅猛贪婪。","source":{"text":"兄听得索郎郎的叉盘声响，使个‘饿虎擒羊’势，叫道：‘你敢来么？’","book":"清·钱彩《说岳全传》第七回"},"example":{"text":"他做出一个～的动作让大家哄堂大笑。"},"similar":["饿虎扑食"],"usage":"作宾语、定语；指迅猛"},{"id":47792,"word":"饿虎攒羊","pinyin":"è hǔ cuán yáng","abbr":"ehzy","explanation":"攒：向一个目标簇拥。像饥饿的老虎向羊簇拥过去一样。形容动作而猛烈。","source":{"text":"可怜欧滁山被那大汉捉住，又有许多汉子来帮打，像饿虎攒羊一般，直打得个落花流水。","book":"清·无名氏《照世杯》第四回"},"similar":["饿虎吞羊","饿虎擒羊"],"usage":"作定语、宾语；形容迅速凶猛贪婪"},{"id":47793,"word":"饿虎见羊","pinyin":"è hǔ jiàn yáng","abbr":"ehjy","explanation":"饥饿的老虎见到一只羊羔。比喻迅猛贪婪。","source":{"text":"一见了，犹如饿虎见羊，不勾大嚼，顷刻吃个干净。","book":"明·冯梦龙《醒世恒言》第20卷"},"similar":["饿虎吞羊","饿虎擒羊","饿虎攒羊"],"usage":"作定语、宾语；形容迅速凶猛贪婪"},{"id":47794,"word":"饿虎逢羊","pinyin":"è hǔ féng yáng","abbr":"ehfy","explanation":"逢：碰到，遇到。饥饿的老虎遇到一只羊羔。比喻迅猛贪婪。","source":{"text":"他两个正是旷夫怨女，相见如饥虎逢羊，苍蝇见血。","book":"明·冯梦龙《喻世明言》第23卷"},"similar":["饿虎见羊"],"usage":"作定语、宾语；形容迅速凶猛贪婪"},{"id":47795,"word":"饿虎饥鹰","pinyin":"è hǔ jī yīng","abbr":"ehjy","explanation":"比喻凶残贪婪。","source":{"text":"侍中卢昶，亦蒙恩眄，故时人号曰：‘饿虎将军，饥鹰侍中。’","book":"《魏书·宗室晖传》"},"example":{"text":"衙门里的人，一个个是～，不叫他们敲诈百姓，敲诈哪个呢？","book":"清·李宝嘉《活地狱·楔子》"},"usage":"作宾语、定语；指贪婪"},{"id":47796,"word":"饿鬼投胎","pinyin":"è guǐ tóu tāi","abbr":"egtt","explanation":"比喻大量吃东西的人。旧时穷人用以指儿女对父母的拖累。","source":{"text":"咱们也不嫉妒他人，纵使不一定是个讨债的，也难免是个饿鬼投胎。","book":"欧阳山《苦斗》四十八"},"usage":"作宾语、定语；指儿女与父母的关系"},{"id":47797,"word":"馁殍相望","pinyin":"něi piǎo xiāng wàng","abbr":"npxw","explanation":"馁殍：饿死的人；相望：相互连接。形容饿死的人非常多。","source":{"text":"烟火殆绝，都市之内，馁殍相望。","book":"唐·陆贽《请减京东……粮事宜状》"},"similar":["饿殍遍野"],"usage":"作谓语、宾语；用于饥荒或战乱"},{"id":47798,"word":"馈贫之粮","pinyin":"zuò pín zhī liáng","abbr":"kpzl","explanation":"馈：赠送。广博的见闻是赠给知识贫乏者的宝贵的精神食粮。","source":{"text":"是以临篇缀虑，必有二患：理郁者苦贫，辞溺者伤乱，然则博见为馈贫之粮，贯一为拯乱之药。","book":"南朝·梁·刘勰《文心雕龙·神思》"},"usage":"作宾语；指知识"},{"id":47799,"word":"馋涎欲垂","pinyin":"chán xián yù chuí","abbr":"cxyc","explanation":"馋：嘴馋；涎：口水；欲：将要。馋得要往下滴口水。指人嘴馋，形容人眼红。","source":{"text":"顾渚茶芽白于齿，梅溪木瓜红胜颊。吴儿脍缕薄欲飞，未去先说馋涎垂。","book":"宋·苏轼《将之湖州莘老》"},"example":{"text":"她已经馋到了～的地步。"},"similar":["馋涎欲滴"],"usage":"作谓语、定语、状语；形容贪吃的样子","story":["宋朝时期，苏轼与吴兴太守孙觉交往很深，经常在一块吟诗作赋。苏轼在熙宁五年写《将之湖州戏赠莘老》：“顾渚茶芽白于齿，梅溪木瓜红胜颊。吴儿脍缕薄欲飞，未去先说馋涎垂。”称赞湖州的美食"]},{"id":47800,"word":"馋涎欲滴","pinyin":"chán xián yù dī","abbr":"cxyd","explanation":"涎：口水。馋得口水都要滴下来了。形容极其贪馋的样子。也形容非常眼红。","source":{"text":"吴儿鲙缕薄欲飞，未去先说馋涎垂。","book":"唐·柳宗元《招海贾文》：“垂涎闪舌兮，挥霍旁午。”宋·苏轼《将之湖州》诗"},"example":{"text":"此时听得子肃说有那样的好烟，不觉～。","book":"清·姬文《市声》第二十六回"},"similar":["垂涎三尺","口角流涎"],"opposite":["淡泊寡味"],"usage":"作谓语、定语、状语；形容贪吃的样子","story":["宋朝时期，苏轼与吴兴太守孙觉交往很深，经常在一块吟诗作赋。苏轼在熙宁五年写《将之湖州戏赠莘老》：“顾渚茶芽白于齿，梅溪木瓜红胜颊。吴儿脍缕薄欲飞，未去先说馋涎垂。”称赞湖州的美食"]},{"id":47801,"word":"馋獠生涎","pinyin":"chán liáo shēng xián","abbr":"clsx","explanation":"馋獠：骂贪食者。形容人之贪食。","source":{"text":"袁义，河南登丰人，方侍卫亲军，善画鱼，穷其变态，得噞喁游泳之状，非若世俗我画，作庖中物，特使馋獠生涎耳。","book":"宋·无名氏《宣和书谱·龙鱼》"},"similar":["垂涎欲滴"],"usage":"作宾语；指人贪食"},{"id":47802,"word":"馔玉炊珠","pinyin":"zhuàn yù chuī zhū","abbr":"zycz","explanation":"食品贵如玉，燃料贵似金。原形容物价昂贵，生活艰难；后形容生活奢华。","source":{"text":"楚国之食贵于玉，薪贵于桂。","book":"语出《战国策·楚策三》"},"example":{"text":"更置循王田租六十四万斛，听君～果其腹。","book":"清·赵翼《余既答稚存黄金之嘲乃又有诗来索战再作长句报之》"},"similar":["炊金馔玉"],"usage":"作谓语、定语、宾语；比喻饮食珍贵"},{"id":47803,"word":"馔玉炊金","pinyin":"zhuàn yù chuī jīn","abbr":"zycj","explanation":"炊：烧火做饭；馔：饮食，吃。形容丰盛的菜肴。","source":{"text":"平台戚里带崇墉，炊金馔玉待鸣钟。","book":"唐·骆宾王《帝京篇》"},"example":{"text":"焚香列鼎奉君王，～饱即妨。","book":"明·汤显祖《牡丹亭·劝农》"},"similar":["炊金馔玉"],"usage":"作谓语、定语；形容生活奢华"},{"id":47804,"word":"首下尻高","pinyin":"shǒu xià kāo gāo","abbr":"sxkg","explanation":"尻：屁股。脑袋向下，屁股翘起。形容磕头跪拜的样子。","source":{"text":"走官阶下，首下尻高。","book":"唐·韩愈《祭河南张员外文》"},"example":{"text":"清·王韬《择友说》：“若其猝逢显士，则～，偶遇寒丁，则颜骄色变。”"},"usage":"作谓语、定语、状语；用于人的神态"},{"id":47805,"word":"首丘之念","pinyin":"shǒu qiū zhī niàn","abbr":"sqzn","explanation":"首丘：头向着狐穴所在的土丘。传说狐狸将死时，头必朝向出生的山丘。比喻久有怀念故乡或归葬故土的愿望。","source":{"text":"夫周齐同在中土千里之间，况于远处绝域，小臣能无依风首丘之思哉？","book":"《后汉书·班超传》"},"example":{"text":"仆虽偷生寄食他国，～，未尝一日忘之。","book":"《金史·时青传》"},"similar":["首丘之思","首丘之情","首丘之望"],"usage":"作宾语；比喻不忘本"},{"id":47806,"word":"首丘之思","pinyin":"shǒu qiū zhī sī","abbr":"sqzs","explanation":"首丘：头向着狐穴所在的土丘。传说狐狸将死时，头必朝向出生的山丘。比喻久有怀念故乡或归葬故土的愿望。","source":{"text":"夫周齐同在中土千里之间，况于远处绝域，小臣能无依风首丘之　思哉？","book":"《后汉书·班超传》"},"example":{"text":"宋·孙光宪《北梦琐言》第13卷：“因有～，遂移军于荆州，用法平正，人皆附之。”"},"similar":["首丘之念","首丘之情","首丘之望"],"usage":"作宾语；比喻不忘本"},{"id":47807,"word":"首丘之情","pinyin":"shǒu qiū zhī qíng","abbr":"sqzq","explanation":"首丘：头向着狐穴所在的土丘。传说狐狸将死时，头必朝向出生的山丘。比喻不忘本。也比喻暮年思念故乡。","source":{"text":"鸟飞反故乡兮，狐死必首丘。","book":"战国·楚·屈原《九章·涉江》"},"example":{"text":"无以自别于世，不胜狐死～，营魂识路之怀。","book":"南朝·宋·范晔《后汉书·寇荣传》"},"similar":["首丘之思","首丘之望","首丘之念"],"usage":"作宾语；比喻不忘本"},{"id":47808,"word":"首丘之望","pinyin":"shǒu qiū zhī wàng","abbr":"sqzw","explanation":"首丘：头向着狐穴所在的土丘。传说狐狸将死时，头必朝向出生的山丘。比喻久有怀念故乡或归葬故土的愿望。","source":{"text":"夫周齐同在中土千里之间，况于远处绝域，小臣能无依风首丘之思哉？","book":"《后汉书·班超传》"},"example":{"text":"但以瘴疠之地，魑魅为邻；衰疾交攻，无复～。","book":"宋·苏轼《到惠州谢表》"},"similar":["首丘之思","首丘之情","首丘之念"],"usage":"作宾语；比喻不忘本"},{"id":47809,"word":"首丘夙愿","pinyin":"shǒu qiū sù yuàn","abbr":"sqsy","explanation":"首丘：头向着狐穴所在的土丘；夙愿：久已怀着的愿望。传说狐狸将死时，头必朝向出生的山丘。比喻久有怀念故乡或归葬故土的愿望。","source":{"text":"鸟飞反故乡兮，狐死必首丘。","book":"战国·楚·屈原《九章·涉江》"},"example":{"text":"臣自念受恩至渥，必远辟岩疆，始敢伸～，故毅然以粤西为请。","book":"《清史稿·孔有德传》"},"similar":["首丘之思","首丘之情","首丘之念"],"usage":"作宾语、定语；用于书面语"},{"id":47810,"word":"首倡义举","pinyin":"shǒu chàng yì jǔ","abbr":"scyj","explanation":"首倡：首先发动；义举：正义的举动。首先发动正义的行动。","source":{"text":"诏惟令臣以散补空缺，然沶乡令虞谭忠诚烈正，首倡义举，举善以教，不能者劝，臣辄特转潭补醴陵令。","book":"《晋书·刘弘传》"},"similar":["首唱义举"],"usage":"作谓语、定语；用于书面语"},{"id":47811,"word":"首倡义兵","pinyin":"shǒu chàng yì bīng","abbr":"scyb","explanation":"倡：带头发动。首先发动正义的行动。","source":{"text":"自天子播越，将军首唱义兵，徒以山东扰乱，未能远赴关右，然犹分遣将帅，蒙险通使，虽御难于外，乃心无不在王室，是将军医天下之素志也。","book":"《三国志·魏志·荀彧传》"},"example":{"text":"今天子蒙尘，将军诚因此时～，奉天子以从众望，不世之略也。","book":"明·罗贯中《三国演义》第十四回"}},{"id":47812,"word":"首唱义举","pinyin":"shǒu chàng yì jǔ","abbr":"scyj","explanation":"唱：通“倡”，带头；义举：正义的举动。首先发动正义的行动。","source":{"text":"诏惟令臣以散补空缺，然沐乡令虞潭忠诚烈正，首唱义举，举善以教，不能者劝，臣辄特转潭补醴陵令。","book":"《晋书·刘弘传》"},"similar":["首唱义兵","首倡义举"],"usage":"作谓语、定语；用于书面语"},{"id":47813,"word":"首唱义兵","pinyin":"shǒu chàng yì bīng","abbr":"scyb","explanation":"唱：通“倡”，带头；兵：战斗。首先发动正义的战争。","source":{"text":"自天子播越，将军首唱义兵，……虽御难于外，乃心无不在王室。","book":"晋·陈寿《三国志·魏志·荀彧传》"},"similar":["首唱义举"],"usage":"作谓语、定语；用于书面语"},{"id":47814,"word":"首善之区","pinyin":"shǒu shàn zhī qū","abbr":"sszq","explanation":"最好的地方。指首都。","source":{"text":"故教化之行也，建首善，自京师始。","book":"《汉书·儒林传序》"},"example":{"text":"当章氏势焰熏天时，我也曾环顾这～，寻求所谓“公理”、“道义”之类而不得。（鲁迅《华盖集·“公理”的把戏》）"},"similar":["首善之地"],"usage":"作主语、宾语；指首都"},{"id":47815,"word":"首善之地","pinyin":"shǒu shàn zhī dì","abbr":"sszd","explanation":"最好的地方。指首都。","source":{"text":"故教化之行也，建首善，自京师始。","book":"《汉书·儒林传序》"},"example":{"text":"学校为育材～，教化所从出，非行法之所。","book":"清·毕沅《续资治通鉴·宋哲宗元祐元年》"},"similar":["首善之区"],"usage":"作主语、宾语；指首都"},{"id":47816,"word":"首如飞蓬","pinyin":"shǒu rú fēi péng","abbr":"srfp","explanation":"首：指头发；飞蓬：飞散的蓬草。头发未经梳理，象飞散的蓬草一样乱。","source":{"text":"自伯之东，首如飞蓬。岂无膏沐，谁适为容。","book":"《诗经·卫风·伯兮》"},"example":{"text":"小艇有识翠姑者，招呼登舟。始见喜儿～，钗环俱无有。","book":"清·沈复《浮生六记》卷四"},"usage":"作谓语、定语；用于书面语"},{"id":47817,"word":"首尾不顾","pinyin":"shǒu wěi bù gù","abbr":"swbg","explanation":"顾不了首尾了。指人豁出去了。","example":{"text":"计划不周造成现今～的局面。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":47818,"word":"首尾两端","pinyin":"shǒu wěi liǎng duān","abbr":"swld","explanation":"两端：拿不定主意。在两者之间犹豫不决动摇不定。","source":{"text":"初，饥五同种大豪卢匆，忍良等千余户别留允街，而首尾两端。","book":"《后汉书·西羌传》"},"similar":["首施两端","首鼠两端","首鼠模棱"],"opposite":["当机立断"],"usage":"作谓语、定语；指左右摇摆"},{"id":47819,"word":"首尾乖互","pinyin":"shǒu wěi guāi hù","abbr":"swgh","explanation":"乖互：相互违背。前后自相矛盾。","source":{"text":"赍传之信，无有主名，所征之人，又已死没，首尾乖互，自为矛盾。","book":"《宋书·徐谌之传》"},"similar":["自相矛盾"],"opposite":["首尾贯通","自圆其说"],"usage":"作谓语、定语、状语；用于说话或做事等"},{"id":47820,"word":"首尾共济","pinyin":"shǒu wěi gòng jì","abbr":"swgj","explanation":"比喻相互支援。","source":{"text":"两人首尾共济，边境遂安。","book":"《明史·方逢时传》"},"usage":"作谓语、定语；用于处事"},{"id":47821,"word":"首尾受敌","pinyin":"shǒu wěi shòu dí","abbr":"swsd","explanation":"前后皆受到敌人的攻击。","source":{"text":"今逼以上命，悉令赴关，悦蹑其后，欢邀其前，首尾受敌，其势危矣。","book":"《周书·文帝纪上》"},"example":{"text":"明·冯梦龙《东周列国志》第75回：“彼水陆路绝，～，吴君臣之命，皆丧于吾手矣。”"},"similar":["腹背受敌"],"usage":"作谓语、定语、宾语；用于战争状态"},{"id":47822,"word":"首尾夹攻","pinyin":"shǒu wěi jiā gōng","abbr":"swjg","explanation":"前后两方面同时攻击。","source":{"text":"乾佑遣将，率精骑数万，从山南转出官军之后，首尾夹攻，官军骇乱，大败而奔。","book":"清·褚人获《隋唐演义》第九十回"},"similar":["前后夹攻"],"usage":"作谓语、定语、宾语；用于战争或处事"},{"id":47823,"word":"首尾狼狈","pinyin":"shǒu wěi láng bèi","abbr":"swlb","explanation":"形容处境困迫，进退为难。","source":{"text":"自守则稽聪之诛，进讨则勒袭其后，进退唯谷，首尾狼狈。","book":"《晋书·刘琨传》"},"usage":"作谓语、定语；用于书面语"},{"id":47824,"word":"首尾相卫","pinyin":"shǒu wěi xiāng wèi","abbr":"swxw","explanation":"比喻互相援救。","source":{"text":"至于首启戎行，不敢有辞，仆与仁公当如常山之蛇，首尾相卫，又唇齿之喻也。","book":"《晋书·温峤传》"},"similar":["首尾相应","首尾相救","首尾相援"],"usage":"作谓语、定语；用于处事或战争等"},{"id":47825,"word":"首尾相应","pinyin":"shǒu wěi xiāng yìng","abbr":"swxy","explanation":"头和尾相互接应。指作战相互接应。也形容诗文结构严谨。","source":{"text":"故善用兵者，譬如率然；率然者，常山之蛇也。击其首则尾至，击其尾则首至，击其中则首尾俱至。","book":"《孙子·九地》"},"example":{"text":"可将队伍摆成长蛇之势，～，循环无端：如此则不愁地理生疏。","book":"明·施耐庵《水浒全传》第八十四回"},"similar":["前呼后应","首尾相赴"],"opposite":["横冲直撞"],"usage":"作谓语、定语；形容诗文结构严谨"},{"id":47826,"word":"首尾相援","pinyin":"shǒu wěi xiāng yuán","abbr":"swxy","explanation":"指前后互相照应。","source":{"text":"惟首尾相援，则附会之体，固亦无以加于此矣。","book":"南朝·梁·刘勰《文心雕龙·附会》"},"similar":["首尾相应","首尾相救","首尾相卫"],"usage":"作谓语、定语；用于处事或战争等"},{"id":47827,"word":"首尾相救","pinyin":"shǒu wěi xiāng jiù","abbr":"swxj","explanation":"比喻互相救援。","source":{"text":"有蛇于此，击其尾，其首救，击其首，其尾救。击其中身，首尾皆救。","book":"《战国策·魏策四》"},"similar":["首尾相应","首尾相卫","首尾相援"],"usage":"作谓语、定语；用于处事或战争等"},{"id":47828,"word":"首尾相继","pinyin":"shǒu wěi xiāng jì","abbr":"swxj","explanation":"前后连接不断。","source":{"text":"贵平使其长子率众攻高阳，南青州刺史茹怀朗遣兵助之。时青州城人馈粮者首尾相继。","book":"《魏书·侯渊传》"},"similar":["首尾相连"],"usage":"作谓语、定语、状语；多用于事物"},{"id":47829,"word":"首尾相赴","pinyin":"shǒu wěi xiāng fù","abbr":"swxf","explanation":"头和尾相互接应。指作战相互接应。也形容诗文结构严谨。","source":{"text":"故善用兵者，譬如率然；率然者，常山之蛇也。击其首则尾至，击其尾则首至，击其中则首尾俱至。","book":"《孙子·九地》"},"similar":["首尾相应"],"usage":"作谓语、定语；用于书面语"},{"id":47830,"word":"首尾相连","pinyin":"shǒu wěi xiāng lián","abbr":"swxl","explanation":"前后连接不断。","source":{"text":"贵平使其长子率众攻高阳，南青州刺史茹怀朗遣兵助之。时青州城人馈粮者首尾相继。","book":"《魏书·侯渊传》"},"similar":["首尾相继"],"usage":"作谓语、定语、状语；多用于事物"},{"id":47831,"word":"首尾贯通","pinyin":"shǒu wěi guàn tōng","abbr":"swgt","explanation":"前后连续相通。","source":{"text":"左思作《三都赋序》曰：‘余既思摹《二京》而赋《三都》。’盖亦拟张衡《二京》而为《三都赋》……此赋首尾贯通，亦一赋也。","book":"宋·王观国《学林·古赋题》"},"opposite":["首尾乖互"],"usage":"作谓语、定语；用于书面语"},{"id":47832,"word":"首屈一指","pinyin":"shǒu qū yī zhǐ","abbr":"sqyz","explanation":"首：首先。扳指头计算，首先弯下大拇指，表示第一。指居第一位。引申为最好的。","source":{"text":"每论诗辄为首屈一指。","book":"清·颜光敏《颜氏家藏尽牍》卷二"},"example":{"text":"此校确系美国之～，我毕业于此后，纵欲继续研究，在此邦亦无处可去也。","book":"闻一多《家书——给父母亲》"},"similar":["名列前茅","鹤立鸡群"],"opposite":["名落孙山"],"usage":"作谓语、定语；指居第一位"},{"id":47833,"word":"首当其冲","pinyin":"shǒu dāng qí chōng","abbr":"sdqc","explanation":"当：承当，承受；冲：要冲，交通要道。比喻最先受到攻击或遭到灾难。","source":{"text":"郑当其冲，不能修德。","book":"《汉书·五行志下》"},"example":{"text":"高家是北门一带的首富，不免要～，所以还是早早避开的好。","book":"巴金《家》二十二"},"similar":["一马当先"],"opposite":["畏缩不前"],"usage":"作谓语、定语；指首先受到攻击"},{"id":47834,"word":"首战告捷","pinyin":"shǒu zhàn gào jié","abbr":"szgj","explanation":"第一仗就取得胜利。","source":{"text":"见到了人，人又还健康——母亲觉得朱静芳是首战告捷。","book":"章诒和《往事并不如烟·斯人寂寞》"},"example":{"text":"我们～，再接再厉。"},"similar":["旗开得胜"],"usage":"作谓语、宾语、定语；指第一仗就胜利"},{"id":47835,"word":"首施两端","pinyin":"shǒu shī liǎng duān","abbr":"ssld","explanation":"在两者之间犹豫不决又动摇不定。同“首鼠两端”。","source":{"text":"首施，犹首尾也。首尾两端，即今所云进退无据也。","book":"《后汉书·邓训传》：“先是小月氏胡分居塞内，胜兵者二三千骑，皆勇健富强，每与羌战，常以少制多，虽首施两端，汉亦时收其用。”王念孙曰"},"similar":["首鼠两端","首尾两端","首鼠模棱"],"opposite":["当机立断"],"usage":"作谓语、定语；指左右摇摆"},{"id":47836,"word":"首肯心折","pinyin":"shǒu kěn xīn zhé","abbr":"skxz","explanation":"心里佩服，点头同意。形容钦佩赞许之至。","source":{"text":"便一五一十，把谭孝移品行端方，素来的好处，说个不啻口出。东宿闻之，心折首肯。","book":"清·李绿园《歧路灯》第四回"}},{"id":47837,"word":"首足异处","pinyin":"shǒu zú yì chù","abbr":"szyc","explanation":"头和脚分开在不同的地方。指遭受杀戮而死亡。","source":{"text":"首足异处，四枝布裂，为天下戮。","book":"《吕氏春秋·顺民》"},"example":{"text":"唐·权德舆《酷吏传议》：“坐临江之嫌，当太后之怒，身死汉廷，～。”"},"similar":["头足异处","头足异所","身首异处"],"usage":"作谓语、定语；指被杀头"},{"id":47838,"word":"首身分离","pinyin":"shǒu shēn fēn lí","abbr":"ssfl","explanation":"首：头。头和身体分开了。指被砍头。","source":{"text":"刳腹折颐，首身分离。","book":"《战国策·秦策四》"},"similar":["身首分离"],"usage":"作谓语、宾语；指被砍头","story":["战国时期，秦军进攻魏国，魏国仓皇应战，上郡之战杀得血肉横飞、尸横遍野，3万魏军全部战死。秦军占领了上郡，把村庄洗劫一空，老百姓被掳走，秦国不断侵略六国，制造无数惨案。春申君评价为：“首身分离，暴骨草泽，头颅僵仆。”"]},{"id":47839,"word":"首鼠两端","pinyin":"shǒu shǔ liǎng duān","abbr":"ssld","explanation":"首鼠：鼠性多疑，出洞时一进一退，不能自决；两端：拿不定主意。在两者之间犹豫不决又动摇不定。","source":{"text":"武安已罢朝，出止车门，召韩御史大夫载，怒曰：‘与长孺共一老秃翁，何为首鼠两端。’","book":"《史记·魏其武安侯列传》"},"example":{"text":"何得～，坐待灭亡。","book":"清·陈忱《水浒后传》第十二回"},"similar":["瞻前顾后","犹豫不决","首尾两端"],"opposite":["当机立断","干脆利落"],"usage":"作谓语、定语、宾语；指左右摇摆","story":["西汉时期，丞相田汾娶小老婆，窦婴与灌天等去祝贺。田汾故意怠慢灌夫，灌夫气愤大骂，田汾立即拘捕灌夫及他全家准备操斩。窦婴求汉武帝过问此事并力保灌夫。御史大夫韩安国认为杀也可不杀也可。田汾抱怨韩安国的首鼠两端的态度"]},{"id":47840,"word":"首鼠模棱","pinyin":"shǒu shǔ mó léng","abbr":"ssml","explanation":"首鼠：踌躇，迟疑不决；模棱：含糊，不明确。形容犹豫不决，动摇不定的样子。","source":{"text":"士为知己者死，女为悦己者容，若首鼠模棱，负恩不报，汗颜人世者，非夫矣。","book":"明·邱吾瑞《运甓记·太真绝据》"},"similar":["首鼠两端","首尾两端"],"opposite":["当机立断"],"usage":"作谓语、定语、宾语；指左右摇摆"},{"id":47841,"word":"香喉玉口","pinyin":"xiāng hóu yù kǒu","abbr":"xhyk","explanation":"形容美丽女子的演唱。","source":{"text":"向绮窗深处，秘本翻誊。香喉玉口，亲将绝调教成。","book":"清·洪昇《长生殿·偷曲》"},"usage":"作宾语、定语；用于女性"},{"id":47842,"word":"香培玉琢","pinyin":"xiāng péi yù zhuó","abbr":"xpyz","explanation":"好像用香料造就，美玉雕成。","example":{"text":"描写美女的肌肤多用～来比喻"},"usage":"作宾语、定语；用于书面语"},{"id":47843,"word":"香娇玉嫩","pinyin":"xiāng jiāo yù nèn","abbr":"xjyn","explanation":"形容美女的肌肤的娇嫩温香。代指美女。","source":{"text":"恰便似落雁沉鱼，羞花闭月，香娇玉嫩。","book":"元·刘庭信《美色》"},"similar":["香肌玉体","香温玉软","香润玉温"],"usage":"作宾语、定语；指美女"},{"id":47844,"word":"香消玉减","pinyin":"xiāng xiāo yù jiǎn","abbr":"xxyj","explanation":"比喻美女日渐消瘦。","source":{"text":"则为他粉悴胭憔，端的是香消也那玉减。","book":"元·贾仲名《萧淑兰》第二折"},"example":{"text":"渐渐～，柳嚬花困，太医院诊脉，吃下药去，如水浇石一般。","book":"明·冯梦龙《醒世恒言》卷十三"},"usage":"作谓语、定语；用于女性"},{"id":47845,"word":"香消玉损","pinyin":"xiāng xiāo yù sǔn","abbr":"xxys","explanation":"比喻年轻美貌女子死亡。同“香消玉碎”。","source":{"text":"乃云所不堪为君告者，秀英香消玉损，已返方诸。","book":"清·缪艮《沈秀英传》"},"example":{"text":"鸨大疑，排闼入室，那知已～。","book":"蔡东藩、许廑父《民国通俗演义》第七十九回回"},"similar":["香消玉碎","香消玉殒"],"usage":"作谓语、定语；用于女性死亡等"},{"id":47846,"word":"香消玉殒","pinyin":"xiāng xiāo yù yǔn","abbr":"xxyy","explanation":"比喻美丽的女子死亡。","source":{"text":"香消玉碎佳人绝，粉骨残躯血染衣！","book":"明·许仲琳《封神演义》第30回"},"example":{"text":"尸体已经在下游打捞到了，虽然～，依旧面目娇好云云。","book":"徐迟《牡丹》"},"similar":["一命归天","一命呜呼"],"opposite":["健康长寿"],"usage":"作谓语、定语；用于女性"},{"id":47847,"word":"香消玉碎","pinyin":"xiāng xiāo yù suì","abbr":"xxys","explanation":"比喻年轻美貌女子死亡。","source":{"text":"可怜香消玉碎佳人绝，粉骨残躯血染衣。","book":"明·许仲琳《封神演义》第三十回"},"example":{"text":"那呼吸是一阵急促一阵，喉咙管里，一阵痰响，可怜一个青春少妇，就～了。","book":"张恨水《春明外史》第六十二回"},"similar":["香消玉殒","香消玉损"],"usage":"作谓语、定语；用于女性死亡等"},{"id":47848,"word":"香润玉温","pinyin":"xiāng rùn yù wēn","abbr":"xryw","explanation":"形容年轻女子肌肤的娇嫩温香。也代指美女。","source":{"text":"更香润玉温，似兰惠绝尘氛，繁英岂堪混。","book":"明·徐复祚《红梨记·豪宴》"},"similar":["香肌玉体","香娇玉嫩","香温玉软"],"usage":"作宾语、定语；指美女"},{"id":47849,"word":"香温玉软","pinyin":"xiāng wēn yù ruǎn","abbr":"xwyr","explanation":"形容年轻女子肌肤的娇嫩温香。也代指美女。","source":{"text":"吾家富比陶朱，独没个翠倚红偎，想香温玉软，凤枕鸳帏。","book":"明·王玉峰《焚香记》第六出"},"example":{"text":"就叫冶儿近身，用手在他身上一摸，却又～，柔媚可怜，就像连剑也拿不动的。","book":"清·褚人获《隋唐演义》第三十一回"},"similar":["香肌玉体","香娇玉嫩","香润玉温"],"usage":"作宾语、定语；指美女"},{"id":47850,"word":"香火不断","pinyin":"xiāng huǒ bù duàn","abbr":"xhbd","explanation":"信神者所供养的香烛永不断绝。","source":{"text":"立碑以记其事，至今香火不断。","book":"明·冯梦龙《喻世明言》卷七"},"example":{"text":"总之无论怎样，我一定还你个～的地方就是了。","book":"清·文康《儿女英雄传》第二十三回"},"similar":["香火不绝"],"usage":"作谓语、定语；指信奉者众多"},{"id":47851,"word":"香火不绝","pinyin":"xiāng huǒ bù jué","abbr":"xhbj","explanation":"指信神者所供养的香烛不断绝。亦作“香火不断”。","source":{"text":"民间各处，立起个‘虎媒之祠’，若是有婚姻求合的，虔诚祈祷，无有不应，至今黔陕之间，香火不绝。","book":"明·凌濛初《初刻拍案惊奇》第五卷"},"similar":["香火不断"],"usage":"作谓语；指信奉者众多"},{"id":47852,"word":"香火兄弟","pinyin":"xiāng huǒ xiōng dì","abbr":"xhxd","explanation":"焚香结拜的兄弟。","source":{"text":"坊吕诸女以气类相似，约为香火兄弟。","book":"唐·崔令钦《教坊记》"},"example":{"text":"清·孔尚任《桃花扇·访翠》：“相公不知，这院中各妓，结为手帕姊妹，就像～一般，每遇时节，便做盛会。”"},"similar":["结拜兄弟","拜把兄弟"],"usage":"作宾语、定语；指异姓兄弟"},{"id":47853,"word":"香火因缘","pinyin":"xiāng huǒ yīn yuán","abbr":"xhyy","explanation":"香火：供佛敬神时燃点的香和灯火。香和灯火都是供佛的，因此佛教称彼此意志相投为“香火因缘”。指彼此契合。","source":{"text":"法和是求佛之人，尚不希释梵天王坐处，岂规王位？但于空王佛所，与主上有香火因缘，且主上应有报至，故救援耳。","book":"《北史·陆法和传》"},"example":{"text":"～久愿同。","book":"唐·白居易《喜照密闲实四上人见过》诗"},"similar":["香火缘"],"usage":"作宾语；指彼此契合"},{"id":47854,"word":"香火姊妹","pinyin":"xiāng huǒ zǐ mèi","abbr":"xhzm","explanation":"焚香结拜的姊妹。","source":{"text":"儿家凡遇新郎君辈访蓬舍，曲中香火姊妹则必醵金来贺。","book":"宋·罗烨《醉翁谈录·潘琼儿家最繁盛》"},"usage":"作宾语、定语；用于女性"},{"id":47855,"word":"香火姻缘","pinyin":"xiāng huǒ yīn yuán","abbr":"xhyy","explanation":"香和灯火都用于供佛，因此佛教用来比喻彼此意志相投。","source":{"text":"法和是求佛之人，尚不希释梵天王坐处，岂规王位？但于空王佛所，与主上有香火因缘，且主上应有报至，故救援耳。","book":"《北史·陆法和传》"}},{"id":47856,"word":"香火缘","pinyin":"xiāng huǒ yuán","abbr":"xhy","explanation":"香火：供佛敬神时燃点的香和灯火。指彼此契合。","source":{"text":"能使南人敬，修持香火缘。","book":"唐·李嘉佑《送弘志上人归湖州》诗"},"similar":["香火因缘"],"usage":"作宾语；指彼此契合"},{"id":47857,"word":"香肌玉体","pinyin":"xiāng jī yù tǐ","abbr":"xjyt","explanation":"形容年轻女子肌肤的娇嫩温香。也代指美女。","source":{"text":"我这里自揣划，移步诀，换灵胎，尽平生手段神灵大，夺了你香肌玉体却归来。","book":"明·杨慎《洞天玄记》第四折"},"similar":["香娇玉嫩","香温玉软","香润玉温"],"usage":"作宾语、定语；指美女"},{"id":47858,"word":"香花供养","pinyin":"xiāng huā gòng yǎng","abbr":"xhgy","explanation":"供养：奉养。原为佛家语。指用香和花供养，是佛教的一种礼敬仪式。后比喻虔诚的敬礼。","source":{"text":"以诸花香，以散其处。","book":"《金刚经》"},"example":{"text":"倘得再生，香花供养有日耳。","book":"清·蒲松龄《聊斋志异·锺生》"},"usage":"作宾语；指用香和花供养"},{"id":47859,"word":"香草美人","pinyin":"xiāng cǎo měi rén","abbr":"xcmr","explanation":"旧时诗文中用以象征忠君爱国的思想。","source":{"text":"《离骚》之文，依《诗》取兴，引类譬谕，故善写香草、以配忠贞，……灵修善于美人，以譬于君。","book":"汉·王逸《离骚序》"},"example":{"text":"～吟未了，防有蛟听。","book":"清·龚自珍《浪淘沙·舟中夜起》"},"usage":"作宾语、定语；指忠贞贤良之士"},{"id":47860,"word":"香药脆梅","pinyin":"xiāng yào cuì méi","abbr":"xycm","explanation":"果脯名。"},{"id":47861,"word":"香象渡河","pinyin":"xiāng xiàng dù hé","abbr":"xxdh","explanation":"佛教用语。比喻悟道精深。也形容评论文字精辟透彻。","source":{"text":"如恒河水，三兽俱渡，兔、马、香象。兔不至底，浮水而过；马或至底，或不至底；象则尽底。","book":"《优婆塞戒经》卷一"},"example":{"text":"亦如～，截流而过，更无疑滞。","book":"宋·释普济《五灯会元》卷三"},"similar":["香象绝流"],"usage":"作宾语、定语；指评论文章等"},{"id":47862,"word":"香象绝流","pinyin":"xiāng xiàng jué liú","abbr":"xxjl","explanation":"佛教用语。比喻悟道精深。也形容评论文字精辟透彻。同“香象渡河”。","source":{"text":"至如般若缘深，灵根夙植，伽陵破卵，香象绝流。","book":"明·袁宗道《杂说》"},"similar":["香象渡河"],"usage":"作宾语、定语；指评论文章等"},{"id":47863,"word":"香车宝马","pinyin":"xiāng chē bǎo mǎ","abbr":"xcbm","explanation":"华丽的车子，珍贵的宝马。指考究的车骑。","source":{"text":"宝马横来下建章，香车却转避驰道。","book":"唐·韦应物《长安道》诗"},"example":{"text":"你看那～，来往交杂，正好赏心乐事也呵。","book":"元·武汉臣《玉壶春》第一折"},"similar":["宝马香车","香轮宝骑"],"usage":"作宾语、定语；指考究的车骑"},{"id":47864,"word":"香轮宝骑","pinyin":"xiāng lún bǎo qí","abbr":"xlbq","explanation":"华丽的车子，珍贵的宝马。指考究的车骑。同“香车宝马”。","source":{"text":"香轮宝骑竞繁华，可怜今夜宿倡家。","book":"唐·骆宾王《代女道士王灵妃赠道士李荣》"},"similar":["香车宝马"],"usage":"作宾语、定语；指考究的车骑"},{"id":47865,"word":"香销玉沉","pinyin":"xiāng xiāo yù chén","abbr":"xxyc","explanation":"香、玉：旧诗文中美女的代称。比喻美女死亡。","source":{"text":"他怨悠悠香销玉沉，乱纷纷碎滴珠囊迸。","book":"明·胡文焕《群音类选·官腔类·玉盆记·沙将逼柳》"},"similar":["香消玉碎","香消玉损","香消玉殒"],"usage":"作谓语、定语；用于女性死亡等"},{"id":47866,"word":"香闺绣户","pinyin":"xiāng guī xiù hù","abbr":"xgxh","explanation":"闺：女子住房。华美溢香的大家闺秀的居所","source":{"text":"且说展国栋去到姑娘香闺绣户，以比棍为名，把小姐诓将出来。","book":"清·石玉昆《小五义》第63回"},"similar":["香闺绣阁"],"usage":"作宾语、定语；用于女性的居所"},{"id":47867,"word":"香闺绣阁","pinyin":"xiāng guī xiù gé","abbr":"xgxg","explanation":"旧指女子的内室。","source":{"text":"［旦］自古道：人有贵贱，不可概论。夫人是香闺绣阁之名姝，奴家是裙布荆钗之贫妇。","book":"元·高明《琵琶记》第三十九出"},"example":{"text":"警幻便命撤去残席，送宝玉至一～之中。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["香闺绣户"],"usage":"作宾语、定语；用于女性的居所"},{"id":47868,"word":"香风毒雾","pinyin":"xiāng fēng dú wù","abbr":"xfdw","explanation":"比喻腐蚀人的思想、消磨人的意志的奢侈庸俗的生活方式。","example":{"text":"不是舍不得用，而是不敢用，怕因此散发资产阶级的～。","book":"陈建功《消费再记》"}},{"id":47869,"word":"香饵之下，必有死鱼","pinyin":"xiāng ěr zhī xià，bì yǒu sǐ yú","abbr":"xezxbysy","explanation":"指游鱼必为贪吃得饵而死。比喻引诱和会使人上当。","source":{"text":"香饵之下，必有死鱼；重赏之下，必有勇夫。","book":"汉·黄石公《三略·上略》"},"similar":["重赏之下，必有勇夫"],"usage":"作宾语、定语；用于处事等"},{"id":47870,"word":"香饵死鱼","pinyin":"xiāng ěr sǐ yú","abbr":"xesy","explanation":"指游鱼必为贪吃得饵而死。比喻引诱和会使人上当。","source":{"text":"香饵之下，必有死鱼；重赏之下，必有勇夫。","book":"汉·黄石公《三略·上略》"}},{"id":47871,"word":"馨香祷祝","pinyin":"xīn xiāng dǎo zhù","abbr":"xxdz","explanation":"馨香：烧香；祷祝：祷告祝愿。原指迷信的人虔诚地向神祈祷祝愿。后引申指真诚地期望。","source":{"text":"弗惟德馨香，祀登闻于天。","book":"《尚书·酒诰》"},"example":{"text":"这就是我们人类全体所～的世界大同。","book":"李大钊《联合主义与世界组织》"},"similar":["心向往之","心驰神往"],"opposite":["口是心非"],"usage":"作谓语；用于书面语"},{"id":47872,"word":"騃女痴儿","pinyin":"ái nǚ chī ér","abbr":"ance","explanation":"指迷恋于情爱的男女。","source":{"text":"百回过锦人间戏，騃女痴儿总未真。","book":"清·徐昂发《宫词》之五五"},"similar":["騃女痴男"],"usage":"作主语、宾语；指迷恋情爱之人"},{"id":47873,"word":"騃女痴男","pinyin":"ái nǚ chī nán","abbr":"ancn","explanation":"指迷恋于情爱的男女。","source":{"text":"乃有騃女痴男，朱颜稚齿，欣春物之骀荡，登春台之靡辷。","book":"宋·徐铉《新月赋》"},"example":{"text":"清·徐昂发《宫词》之五五：“百回过锦人间戏，～总未真。”"},"similar":["騃女痴儿"],"usage":"作主语、宾语；指迷恋情爱之人"},{"id":47874,"word":"騃童钝夫","pinyin":"ái tóng dùn fū","abbr":"atdf","explanation":"指愚昧笨拙的人。","source":{"text":"又善于诱掖，其言披豁畅朗，支分族解，騃童钝夫闻之，咸如梦寐惊觉。","book":"清刘大櫆《乌程闵君志铭》"},"usage":"作主语、宾语、定语；指愚昧笨拙的人"},{"id":47875,"word":"騣女痴儿","pinyin":"ái nǚ chī ér","abbr":"ance","explanation":"指迷恋于情爱的男女。","source":{"text":"之五五百回过锦人间戏，騣女痴儿总未真。","book":"清·徐昂发《宫词》"}},{"id":47876,"word":"騣女痴男","pinyin":"ái nǚ chī nán","abbr":"ancn","explanation":"指迷恋于情爱的男女。","source":{"text":"乃有騣女痴男，朱颜稚齿，欣春物之骀荡，登春台之靡辷。","book":"宋·徐铉《新月赋》"}},{"id":47877,"word":"騣童钝夫","pinyin":"ái tóng dùn fū","abbr":"atdf","explanation":"指愚昧笨拙的人。","source":{"text":"又善于诱掖，其言披豁畅朗，支分族解，騣童钝夫闻之，咸如梦寐惊觉。","book":"清刘大櫆《乌程闵君志铭》"}},{"id":47878,"word":"马上功成","pinyin":"mǎ shàng gōng chéng","abbr":"msgc","explanation":"指凭武功建国。","source":{"text":"马上功成不喜文，叔孙绵蕝共经纶。","book":"宋·王安石《嘲叔孙通》诗"},"example":{"text":"历史上～的朝代有好几个。"},"similar":["马上得天下"],"usage":"作主语、宾语、定语；指凭武功建国"},{"id":47879,"word":"马上墙头","pinyin":"mǎ shàng qiáng tóu","abbr":"msqt","explanation":"指男女青年相恋的地方。","source":{"text":"马上墙头，纵教瞥见，也难相认。","book":"宋·晁端礼《水龙吟》词"},"example":{"text":"遮莫～，桃花人面，忍令春无主。","book":"清·谢学崇《念奴娇》词"},"similar":["墙头马上","花前月下"],"usage":"作宾语；指男女青年相恋的地方"},{"id":47880,"word":"马上得之","pinyin":"mǎ shàng dé zhī","abbr":"msdz","explanation":"旧时比喻以武力夺取天下。","source":{"text":"陆生时时说称《诗》、《书》，高帝骂之曰：‘乃公马上而得之，安事《诗》、《书》？’陆生曰：‘居马上得之，宁可以马上治之乎？’","book":"《史记·郦生陆贾列传》"},"example":{"text":"陛下天下可以～，但是不可以马上治之。","book":"南怀瑾《历史的经验·长短纵横》"}},{"id":47881,"word":"马上得天下","pinyin":"mǎ shàng dé tiān xià","abbr":"msdtx","explanation":"喻指武功建国。","source":{"text":"陆生时时前说称《诗》《书》。高帝骂之曰：‘乃公居马上而得之，安事《诗》《书》！’陆生曰：‘居马上得之，宁可以马上治之乎？且汤武逆取而以顺守之，文武并用，长久之术也。’","book":"《史记·郦生陆贾列传》"},"example":{"text":"五年～，富贵乐在归故乡。","book":"元·萨都刺《登歌风台》诗"},"similar":["马上功成"],"usage":"作主语、宾语、定语；指凭武功建国","story":["西汉时期，陆生经常在人面前谈到《诗书》。高帝十分反感说：“乃公居马上得之。安事《诗》《书》！”陆生不服气说：“居马上得之，宁可以马上之乎？且汤武逆取而以顺守之，文武并用，长久之术也。”"]},{"id":47882,"word":"马上房子","pinyin":"mǎ shàng fáng zi","abbr":"msfz","explanation":"指当面赞成，背后反对。","source":{"text":"何谓‘马上房子’？只是眼前奉承过去，心中已不然其言。","book":"明·戚继光《练兵实纪杂集·登坛口授》"},"similar":["阳奉阴违"],"usage":"作宾语；指两面三刀"},{"id":47883,"word":"马上看花","pinyin":"mǎ shàng kàn huā","abbr":"mskh","explanation":"指粗略行事，走马看花。","source":{"text":"分明马上看花，但过眼即忘，何尝在意。","book":"明·天然痴叟《石点头·玉箫女再世玉杯缘》"},"example":{"text":"～的行为是极不负责的。"},"similar":["走马观花"],"usage":"作宾语、定语；指办事不细心","story":["传说一个叫贵良是跛子，想娶一个漂亮的妻子。一个鼻子有缺陷的姑娘叶青，想找一个英俊的丈夫。两人都找到华汉做媒。华汉准备把他们促成一对，在相亲的那天，让贵良骑马，让叶青拿着花到鼻子边上闻，双方都很满意对方"]},{"id":47884,"word":"马不停蹄","pinyin":"mǎ bù tíng tí","abbr":"mbtt","explanation":"比喻不停顿地向前走。","source":{"text":"赢的他急难措手，打的他马不停蹄。","book":"元·王实甫《丽春堂》第二折"},"example":{"text":"～的走至天色大明，看看追兵已远，方始勒住马。","book":"清·吴趼人《痛史》第三回"},"similar":["夜以继日","再接再厉","快马加鞭"],"opposite":["虚度光阴","岁月蹉跎","裹足不前"],"usage":"作谓语、定语、状语；指不间断"},{"id":47885,"word":"马不解鞍","pinyin":"mǎ bù jiě ān","abbr":"mbja","explanation":"比喻一刻也不停留，毫不间歇。","source":{"text":"马不解鞍连续战，一举解放大江南。","book":"郭小川《长江组歌·百万雄师过大江》"},"example":{"text":"我们～地日夜奋战，终于攻克了这个课题。"},"similar":["马不停蹄"],"usage":"作谓语、定语；指不间断"},{"id":47886,"word":"马中关五","pinyin":"mǎ zhōng guān wǔ","abbr":"mzgw","explanation":"犹言鲁鱼亥豕。指书籍在传写或刻印过程中的文字错误。","source":{"text":"唐·颜真卿《〈干禄字书〉序》：“史籀之兴，备存往制，笔削所误，抑有前闻，岂唯豕上加三，盖亦马中关五。”五，指许慎《五经异义》。谓将郑玄所著《驳五经异义》中的“驳”，以其形相似而误为“■（马中）”的舛谬。"},"similar":["鲁鱼亥豕"],"usage":"作宾语、定语；指文字错误"},{"id":47887,"word":"马仰人翻","pinyin":"mǎ yǎng rén fān","abbr":"myrf","explanation":"形容极忙乱或混乱的样子。","source":{"text":"武成王展放钢枪，似一条银蟒裹住余化，只杀的他马仰人翻。","book":"明·许仲琳《封神演义》第三十三回"},"example":{"text":"那巧姐儿是日夜哭母，也是病了。所以荣府中又闹得～。","book":"清·曹雪芹《红楼梦》第一百十五回"},"similar":["人仰马翻"],"usage":"作状语、定语；形容忙乱不堪或混乱的样子"},{"id":47888,"word":"马入华山","pinyin":"mǎ rù huá shān","abbr":"mrhs","explanation":"表示天下太平，不再打仗。","source":{"text":"乃偃武修文，归马于华山之阳，放牛于桃林之野，示天下弗服。","book":"《书·武成》"},"example":{"text":"当今鹿台已散，离宫已遣，兵藏武库，～。","book":"北周·庚信《贺平邺都表》"},"similar":["马放南山","归马放牛"],"usage":"作定语；用于社会局面","story":["商朝末年，商纣王荒淫无度，百姓怨声载道。周武王率领大军把商都包围起来，商纣王登上鹿台放火自杀。周武王建立周朝，定都镐京，让士兵回家从事农业生产，把征用的牛马全部退还，让全国老百姓过上安居乐业的日子"]},{"id":47889,"word":"马到功成","pinyin":"mǎ dào gōng chéng","abbr":"mdgc","explanation":"形容事情顺利，一开始就取得胜利。","source":{"text":"只愿你马到功成，奏凯而还。","book":"元·郑廷玉《楚昭公》第四折"},"example":{"text":"向使微臣督剿江、淮、豫、楚间，果能运筹制胜，～，各省抚臣岂易于为力？","book":"明·卢象昇《剿荡衍期听候处分并陈贼势兵情疏》"},"similar":["马到成功"],"usage":"作谓语、定语、宾语；用于处事"},{"id":47890,"word":"马到成功","pinyin":"mǎ dào chéng gōng","abbr":"mdcg","explanation":"形容工作刚开始就取得成功。","source":{"text":"那老尉迟这一去，马到成功。","book":"元·无名氏《小尉迟》第二折"},"example":{"text":"只要不轻敌，相信你们一定会～。"},"similar":["旗开得胜","水到渠成"],"opposite":["屡战屡败"],"usage":"作谓语、定语、宾语；常与“旗开得胜”连用","story":["唐朝时期，绎州龙门大黄庄农民薛仁贵，自幼喜欢武术，到20岁时已学成十八般武艺。他一心想投军报国，父母担心他并劝阻他。他对父母说：“今当国家用人之际，要扫除夷虎，肃靖边疆，凭你孩儿学成武艺，智勇双全，若在两阵之间，怕不马到成功。”"]},{"id":47891,"word":"马前卒","pinyin":"mǎ qián zú","abbr":"mqz","explanation":"旧时在马前吆喝开路的兵卒差役。现在比喻为人奔走效力的人。","source":{"text":"一为马前卒，鞭背生虫蛆。","book":"唐·韩愈《符读书城南》诗"},"example":{"text":"皇汉民族亡国后之二百六十年，岁次癸卯三月日革命军中～邹容记。","book":"邹容《革命军》"},"similar":["无名小卒"],"usage":"作宾语；比喻为人奔走效力的人"},{"id":47892,"word":"马前泼水","pinyin":"mǎ qián pō shuǐ","abbr":"mqps","explanation":"比喻夫妻离异，无法挽回。","source":{"text":"虽然‘马前泼水’，居然‘破镜重圆’。","book":"钱钟书《围城》"},"example":{"text":"他经常给我讲朱买臣～的故事。"},"similar":["覆水难收"],"opposite":["破镜重圆"],"usage":"作宾语、定语；指不可挽回","story":["汉朝书生朱买臣年轻时家里十分贫穷，每天靠打柴卖维持生计，但他坚持好学，经常边走边背诵书本。他的妻子以此为耻辱就离他而去。后来朱买臣考学当上太守，他的前妻要求复婚，他将水泼在马前，教她收回就复婚"]},{"id":47893,"word":"马勃牛溲","pinyin":"mǎ bó niú sōu","abbr":"mbns","explanation":"马勃：马屁菌；牛溲：车前草。借指不值钱的东西。","source":{"text":"马勃牛溲君受用，何须开口出而哇。","book":"清·褚人获《坚瓠十集·遗臭文词》"},"example":{"text":"鼠肝虫臂唯天命，～称异才。","book":"廖仲恺《壬戍六月禁锢中闻变有感》诗"},"similar":["牛溲马勃","马浡牛溲"],"opposite":["无价之宝"],"usage":"作宾语、定语；指不值钱的东西","story":["唐朝文学家韩愈在任国子监祭酒时，经常给太学生讲课，要求他们“业精于勤荒于嬉，行成于思毁于随”，同时要求他们注意社会实践，要兼收并蓄，“牛溲马勃、败鼓之皮”都有它们的用途，鼓励学生加强学习，灵活运用"]},{"id":47894,"word":"马去马归","pinyin":"mǎ qù mǎ guī","abbr":"mqmg","explanation":"比喻世事多变，得失无常。","source":{"text":"据《淮南子·人间训》载，边塞老翁失马，人以为祸，结果其马领胡人骏马同归，人皆贺之，而其子却因骑马摔伤致残，乡人吊之，不料胡人入塞，边塞丁壮战死者十九，其子却因腿跛而全。"},"example":{"text":"褐衣褐见，莫陈汉戍之便宜；～，敢计塞翁之倚伏。","book":"宋·陈鹄《耆旧续闻》卷六"},"similar":["塞翁失马，安知非福"],"usage":"作宾语、定语；用于书面语","story":["古代塞北的一老汉家的马跑到长城外面胡人那边去了，乡亲们安慰他，他说这不一定是坏事，几天后走失的马带回几匹烈马回来。老翁认为这不一定是好事，他的儿子因骑胡马摔断了腿，老翁认为不是坏事，后老汉儿子因腿伤而躲过战祸"]},{"id":47895,"word":"马后炮","pinyin":"mǎ hòu pào","abbr":"mhp","explanation":"象棋术语。比喻不及时的举动。","source":{"text":"今日军师升帐，大哥须要计较此事，不要做了马后炮，弄的迟了。","book":"元·无名氏《隔江斗智》第三折"},"example":{"text":"人已死了，在这里放那～，可是迟了。","book":"清·夏敬渠《野叟曝言》第29回"},"similar":["事后诸葛亮"],"usage":"作宾语、定语；比喻不及时的举动"},{"id":47896,"word":"马咽车阗","pinyin":"mǎ yān chē tián","abbr":"myct","explanation":"形容车马繁多，非常热闹。","source":{"text":"马咽车阗拉杂声，火光照火月光明。","book":"清·蒋仁锡《燕京上元竹枝词》"},"similar":["车水马龙"],"usage":"作宾语、定语；用于热闹场面"},{"id":47897,"word":"马壮人强","pinyin":"mǎ zhuàng rén qiáng","abbr":"mzrq","explanation":"犹言人强马壮。形容军队的战斗力很强或军容很盛。","source":{"text":"可不道马壮人强，父慈子孝，怕甚么主忧臣辱。","book":"元·纪君祥《赵氏孤儿》第四折"},"example":{"text":"说甚么天心帮孽子，旺气属番邦，都则是～。","book":"明·孟称舜《娇红记·番衅》"},"similar":["人强马壮"],"usage":"作谓语、定语；用于军事等"},{"id":47898,"word":"马大哈","pinyin":"mǎ dà hā","abbr":"mdh","explanation":"轻浮而粗心大意的人。","source":{"text":"我看我们家马锐才没准儿呢，整个一个马大哈，二百五，让人当枪使。","book":"王朔《我是你爸爸》"},"example":{"text":"他是一个十足的～。"},"similar":["粗心大意"],"usage":"作宾语、定语；指粗心人"},{"id":47899,"word":"马如流水","pinyin":"mǎ rú liú shuǐ","abbr":"mrls","explanation":"形容人马熙攘。","source":{"text":"关门两向当天开，马如流水车如雷。","book":"元·揭傒斯《居庸行》"},"similar":["车水马龙"],"usage":"作宾语、定语；用于热闹场面"},{"id":47900,"word":"马如游鱼","pinyin":"mǎ rú yóu yú","abbr":"mryy","explanation":"形容人马熙熙攘攘的景象。同“马如游龙”。","source":{"text":"日暮宴罢，车骑就衢，盖如飞鹤，马如游鱼。","book":"《初学记》卷四引汉·刘桢《鲁都赋》"},"similar":["马如游龙"],"usage":"作谓语、宾语；形容人多繁华"},{"id":47901,"word":"马如游龙","pinyin":"mǎ rú yóu lóng","abbr":"mryl","explanation":"形容人马熙熙攘攘的景象。","source":{"text":"见外家问起居者，车如流水，马如游龙。","book":"南朝·宋·范晔《后汉书·皇后纪上·明德马皇后》"},"example":{"text":"萧洒词人，往来游戏，～，车相接也。","book":"清·余怀《板桥杂记·轶事》"},"similar":["车水马龙"],"opposite":["稀稀拉拉"],"usage":"作谓语、宾语；形容人多繁华","story":["东汉章帝刘炟即位后，封其父王明帝刘庄的皇后马氏为太后。马太后亲自撰写《显宗起居注》，丝毫不提及父亲马援及兄长马防的功劳，还要章帝不要听信大臣的给马家封侯的建议，说：“我回家看他们门前车水马龙的，不能再封了。”"]},{"id":47902,"word":"马尘不及","pinyin":"mǎ chén bù jí","abbr":"mcbj","explanation":"比喻赶不上，跟不上。","source":{"text":"王行昔望吾舅马尘不及，何先友为？","book":"明·都穆《都公谭纂》卷上"},"similar":["望尘莫及"],"usage":"作宾语、定语；同“望尘莫及”"},{"id":47903,"word":"马屁精","pinyin":"mǎ pì jīng","abbr":"mpj","explanation":"阿谀奉迎的人，拍马者。","example":{"text":"我看不惯他那～的嘴脸。"},"usage":"作主语、宾语、定语；指拍马者"},{"id":47904,"word":"马工枚速","pinyin":"mǎ gōng méi sù","abbr":"mgms","explanation":"工：工巧；速：速度快。原指枚皋文章写得多，司马相如文章写得工。后用于称赞各有长处。","source":{"text":"为文疾，受诏辄成，故所赋者多；司马相如善为文而迟，故所作少而善于皋。","book":"《汉书·枚乘传》"},"similar":["马迟枚疾"],"usage":"作宾语；用于称赞各有长处"},{"id":47905,"word":"马捉老鼠","pinyin":"mǎ zhuō lǎo shǔ","abbr":"mzls","explanation":"比喻瞎忙乱。","source":{"text":"方言‘马捉老鼠’，盖讥人粗撞不了事也。","book":"明·田艺蘅《留青日札·马捉老鼠》"},"example":{"text":"～和狗拿耗子都是不务正业。"},"similar":["狗拿耗子"],"usage":"作宾语、定语；指不务正业"},{"id":47906,"word":"马放南山","pinyin":"mǎ fàng nán shān","abbr":"mfns","explanation":"比喻天下太平，不再用兵。现形容思想麻痹。","source":{"text":"王来自商，至于丰，乃偃武修文，归马于华山之阳，放牛于桃林之野，示天下弗服。","book":"《尚书·武成》"},"example":{"text":"其时天下太平已久，真个是～，刀枪入库；五谷丰登，万民乐业。","book":"清·钱彩《说岳全传》第一回"},"similar":["马入华山"],"opposite":["兵荒马乱"],"usage":"作定语；用于社会局面"},{"id":47907,"word":"马毛猬磔","pinyin":"mǎ máo wèi zhé","abbr":"mmwz","explanation":"形容狂风大作，气候恶劣。","source":{"text":"疾风冲塞起，沙砾自飘扬；马毛缩如猬，角弓不可张。","book":"南朝·宋·鲍照《代出自蓟北门行》"}},{"id":47908,"word":"马毛蝟磔","pinyin":"mǎ máo wèi zhé","abbr":"mmwz","explanation":"蝟，同“猬”。形容狂风大作，气候恶劣。","source":{"text":"疾风冲塞起，沙砾自飘扬；马毛缩如蝟，角弓不可张。","book":"南朝·宋·鲍照《代出自蓟北门行》"},"example":{"text":"朔风朴面吹尘沙，～人影斜。","book":"清·蒲松龄《归途大风》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":47909,"word":"马水车龙","pinyin":"mǎ shuǐ chē lóng","abbr":"mscl","explanation":"犹言车水马龙。形容来往车马很多，连续不断的热闹情景。","source":{"text":"即今马水车龙地，曾是青燐白骨场。","book":"清·黄瘦竹《〈凇南梦影录〉题词》"},"similar":["车水马龙"],"opposite":["门堪罗雀"],"usage":"作谓语、定语；形容繁华热闹的景象"},{"id":47910,"word":"马浡牛溲","pinyin":"mǎ bó niú sōu","abbr":"mbns","explanation":"借指不值钱的东西。同“马勃牛溲”","source":{"text":"杜子美出，而百家稗官都作雅音，马浡牛溲咸成郁致，于是诗之变极矣。","book":"明·王世懋《艺圃撷馀》"},"similar":["马勃牛溲"],"opposite":["连城之璧"],"usage":"作宾语、定语；指不值钱的东西"},{"id":47911,"word":"马牛其风","pinyin":"mǎ niú qí fēng","abbr":"mnqf","explanation":"指马、牛奔逸。后用以表示互不相干。","source":{"text":"僖四年《左传》云：‘唯是风马牛不相及也。’贾逵云：‘风，放也，牝牡相诱谓之风。’然则马牛风佚，因牝牡相逐，而逐至放佚远去也。","book":"《书·费誓》：“马牛其风，臣妾逋逃，勿敢越逐。”孔颖达疏"},"example":{"text":"我却不信你们两个通是～，不言而喻呢。","book":"《花月痕》第十五回"},"usage":"作宾语、定语；用于比喻句"},{"id":47912,"word":"马牛襟裾","pinyin":"mǎ niú jīn jū","abbr":"mnjj","explanation":"襟、裾：泛指人的衣服。马、牛穿着人衣。比喻人不懂得礼节。也比喻衣冠禽兽。","source":{"text":"潢潦无根源，朝满夕已除。人不通古今，马牛而襟裾。行身陷不义，况望多名誉。","book":"唐·韩愈《符读书城南》诗"},"example":{"text":"闻孝氏孝友之风而无兴起之志。诚～者也。","book":"明·赵弼《赵氏伯仲友义传》"},"similar":["衣冠禽兽"],"usage":"作宾语、定语；讥讽人不懂得礼节"},{"id":47913,"word":"马生角","pinyin":"mǎ shēng jiǎo","abbr":"msj","explanation":"乌鸦变白，马头生角。比喻不能实现之事。","source":{"text":"燕太子丹质于秦，秦王遇之无礼，不得意，欲求归。秦王不听，谬言曰：‘令乌白头，马生角，乃可许耳。’","book":"《燕丹子》上卷"},"example":{"text":"世言荆轲，其称太子丹之命，天雨粟，～也。","book":"西汉·司马迁《史记·荆轲列传》"},"similar":["马角乌白"],"usage":"作宾语、定语；比喻不能实现之事","story":["战国后期，秦国与燕国表面修好，互派王室的公子到对方国家去作人质。燕太子丹在秦国作人质，秦王嬴政对他十分无礼与蔑视。太子丹向秦王请求允许他回燕国，秦王说除非马生角乌鸦白头才成。太子丹逃回燕国，派荆轲去刺杀秦王"]},{"id":47914,"word":"马疲人倦","pinyin":"mǎ pí rén juàn","abbr":"mprj","explanation":"疲：疲劳；倦：劳倦。人马疲倦困乏。形容体力疲劳不堪。","source":{"text":"马疲人倦，而不解舍，所以不任其上。","book":"《吴子·治兵》"},"example":{"text":"还有几名女眷，个个人强马壮，袍甲鲜明，全不似预料中的受到袭击，衣甲不全，～的样子。","book":"梁羽生《萍踪侠影录》第三十回"},"similar":["人困马乏"],"usage":"作定语、状语；用于群体或个人"},{"id":47915,"word":"马瘦毛长","pinyin":"mǎ shòu máo cháng","abbr":"msmc","explanation":"比喻人穷志短。","source":{"text":"问祖意教意，是同是别，师曰人贫智短，马瘦毛长。","book":"宋·释普济《五灯会元·五祖法演禅师》"},"example":{"text":"他一幅～的模样。"},"similar":["人穷志短"],"usage":"作谓语、定语；比喻人境遇穷困，精神不佳"},{"id":47916,"word":"马空冀北","pinyin":"mǎ kōng jì běi","abbr":"mkjb","explanation":"伯乐将冀北之良马搜选一空。比喻执政者善选贤才，无所遗漏。","source":{"text":"伯乐一过冀北之野，而马群遂空。","book":"唐·韩愈《送石处士序》"},"example":{"text":"～的现象不会重现。"},"similar":["群空冀北"],"usage":"作定语；指善用人才"},{"id":47917,"word":"马翻人仰","pinyin":"mǎ fān rén yǎng","abbr":"mfry","explanation":"人马被打得仰翻在地。形容被打得惨败。也比喻乱得一塌糊涂，不可收拾。","source":{"text":"贾琏家下无人，请了王仁来在外帮着料理。那巧姐儿是日夜哭母，也是病了。所以荣府中又闹得马仰人翻。","book":"清·曹雪芹《红楼梦》第一百十五回"}},{"id":47918,"word":"马耳东风","pinyin":"mǎ ěr dōng fēng","abbr":"medf","explanation":"比喻把别人的话当作耳边风。","source":{"text":"世人闻此皆掉头，有如东风射马耳。","book":"唐·李白《答王十二寒夜独钓有怀》诗"},"example":{"text":"说向市朝公子，何殊～。","book":"宋·苏轼《和何长官六言》诗"},"similar":["耳边风","充耳不闻","无动于衷"],"usage":"作宾语；比喻把别人的话当作耳边风"},{"id":47919,"word":"马耳春风","pinyin":"mǎ ěr chūn fēng","abbr":"mecf","explanation":"比喻把别人的话当作耳边风。同“马耳东风”。","source":{"text":"纷纷世议何足道，尽付马耳春风前。","book":"金·元好问《谷圣灯》诗"},"similar":["马耳东风"],"usage":"作宾语；比喻把别人的话当作耳边风"},{"id":47920,"word":"马肥人壮","pinyin":"mǎ féi rén zhuàng","abbr":"mfrz","explanation":"壮：强壮。形容军威雄壮，精神抖擞。","source":{"text":"某麾下番兵浩大，猛将英雄，马肥人壮，不时在边抢掳。","book":"元·无名氏《射柳棰丸》第一折"},"similar":["人强马壮","兵强马壮"],"usage":"作谓语、定语；用于军事等"},{"id":47921,"word":"马腹逃鞭","pinyin":"mǎ fù táo biān","abbr":"mftb","explanation":"比喻躲脱惩罚。","source":{"text":"虽鞭之长，不及马腹。","book":"《左传·宣公十五年》"},"example":{"text":"岂谓～，榻侧容一隅之鼾睡？不知燕巢在幕，釜底得几日之游魂。","book":"清·蒲松龄《大捷二》"},"usage":"作宾语、定语；用于比喻句"},{"id":47922,"word":"马舞之灾","pinyin":"mǎ wǔ zhī zāi","abbr":"mwzz","explanation":"比喻火灾。","source":{"text":"黄平问紞曰：‘我昨夜梦舍中马舞，数十人向马拍手，此何详也？’紞曰：‘马者，火也，舞为火起。向马拍手，救火人也。’平未归而火起。","book":"《晋书·艺术传》"}},{"id":47923,"word":"马角乌头","pinyin":"mǎ jiǎo wū tóu","abbr":"mjwt","explanation":"乌鸦变白，马头生角。比喻不能实现之事。","source":{"text":"燕太子丹质于秦，秦王遇之无礼，不得意，欲求归。秦王不听，谬言曰：‘令乌白头，马生角，乃可许耳。’","book":"《燕丹子》上卷"},"example":{"text":"《燕丹子》上卷：“燕太子丹质于秦，秦王遇之无礼，不得意，欲求归。秦王不听，谬言曰：‘令乌白头，马生角，乃可许耳。’”"},"similar":["乌头马角","马角乌白"],"usage":"作宾语、定语；比喻不能实现之事","story":["战国后期，秦国与燕国表面修好，互派王室的公子到对方国家去作人质。燕太子丹在秦国作人质，秦王嬴政对他十分无礼与蔑视。太子丹向秦王请求允许他回燕国，秦王说除非马生角乌鸦白头才成。太子丹逃回燕国，派荆轲去刺杀秦王"]},{"id":47924,"word":"马角乌白","pinyin":"mǎ jiǎo wū bái","abbr":"mjwb","explanation":"乌鸦变白，马头生角。比喻不能实现之事。","source":{"text":"燕太子丹质于秦，秦王遇之无礼，不得意，欲求归。秦王不听，谬言曰：‘令乌白头，马生角，乃可许耳。’","book":"《燕丹子》卷上"},"similar":["马生角","马角乌头","蛇毛马角"],"usage":"作宾语、定语；比喻不能实现之事","story":["战国后期，秦国与燕国表面修好，互派王室的公子到对方国家去作人质。燕太子丹在秦国作人质，秦王嬴政对他十分无礼与蔑视。太子丹向秦王请求允许他回燕国，秦王说除非马生角乌鸦白头才成。太子丹逃回燕国，派荆轲去刺杀秦王"]},{"id":47925,"word":"马足车尘","pinyin":"mǎ zú chē chén","abbr":"mzcc","explanation":"比喻四处奔波，生活动荡不定。","source":{"text":"马足车尘知己少，繁弦急管正声希。","book":"清·秋瑾《申江题壁》诗"},"usage":"作宾语、定语；用于飘泊的生活"},{"id":47926,"word":"马足龙沙","pinyin":"mǎ zú lóng shā","abbr":"mzls","explanation":"指驰骋边疆，扬威域外。龙沙，塞北沙漠地方。","source":{"text":"虎头燕颔，人言万里之侯；马足龙沙，胸有千秋之业。","book":"曼殊室主人《班定远平西域》第一幕"},"usage":"作谓语、宾语；用于书面语"},{"id":47927,"word":"马迟枚疾","pinyin":"mǎ chí méi jí","abbr":"mcmj","explanation":"用于称赞各有长处。同“马工枚速”。","source":{"text":"鹤怨猿惊怀故地，马迟枚疾斗新篇。","book":"清·陈祖范《寄沈归愚》诗"},"similar":["马工枚速"],"usage":"作宾语；用于称赞各有长处"},{"id":47928,"word":"马迹蛛丝","pinyin":"mǎ jì zhū sī","abbr":"mjzs","explanation":"马蹄的痕迹，蜘蛛的细丝。比喻隐约可寻的痕迹和线索。","source":{"text":"明中之暗，正中之侧，侧中之正，草蛇灰线，马迹蛛丝。","book":"清·魏子安《花月痕》第五回"},"example":{"text":"我们要细心去寻找其中的～。"},"similar":["蛛丝马迹"],"opposite":["千丝万缕"],"usage":"作宾语；指线索"},{"id":47929,"word":"马面牛头","pinyin":"mǎ miàn niú tóu","abbr":"mmnt","explanation":"比喻各种各样凶恶的人。","source":{"text":"没慈心的马面牛头，两股叉，两条鞭，恶恶狠狠。","book":"《西湖二集·文昌司怜才慢注禄籍》"},"example":{"text":"两边站立的，活像是一群～。","book":"叶紫《乡寻》"},"similar":["牛头马面","妖魔鬼怪"],"usage":"作宾语、定语；指人的长相"},{"id":47930,"word":"马革盛尸","pinyin":"mǎ gé shèng shī","abbr":"mgss","explanation":"用马皮把尸体裹起来。指英勇牺牲在战场。同“马革裹尸”。","source":{"text":"马革盛尸每恨迟，西山饿踣更何辞。","book":"金·何宏中《述怀》诗"},"similar":["马革裹尸","裹尸马革"],"usage":"作谓语、定语、宾语；指作战英勇"},{"id":47931,"word":"马革裹尸","pinyin":"mǎ gé guǒ shī","abbr":"mggs","explanation":"马革：马皮。用马皮把尸体裹起来。指英勇牺牲在战场。","source":{"text":"男儿要当死于边野，以马革裹尸还葬耳，何能卧床上在儿女子手中邪？","book":"南朝·宋·范晔《后汉书·马援传》"},"example":{"text":"～当自誓，蛾眉伐杵休重说。","book":"宋·辛弃疾《满江红》"},"similar":["赴汤蹈火","决一死战"],"opposite":["临阵脱逃"],"usage":"作谓语、定语、宾语；指作战英勇","story":["东汉时期，北方匈奴发生动乱，大将军马援率军前去镇压骚乱，他英勇杀敌，大破匈奴，平定了边境的动乱，皇帝封他为伏波将军。他62岁时，匈奴又侵东汉，马援请求带兵出战说：“男儿当死于沙场，以马革裹尸还葬”，同年病死在军中"]},{"id":47932,"word":"马首是瞻","pinyin":"mǎ shǒu shì zhān","abbr":"mssz","explanation":"瞻：往前或向上看。看着我马头的方向，决定进退。比喻追随某人行动。","source":{"text":"鸡鸣而驾，塞井夷灶，唯余马首是瞻。","book":"《左传·襄公十四年》"},"example":{"text":"他近一年半以来虽常依大帅之“～”，然而他不是大帅部将，也不会屈居人下。","book":"姚雪垠《李自成》第二卷第二十七章"},"similar":["唯命是从","亦步亦趋"],"opposite":["背道而驰","南辕北辙"],"usage":"作谓语；比喻追随某人行动","story":["春秋时期，秦景公一举打败第二代霸主晋文公的后代晋悼公。晋国为了复仇就联合齐鲁卫郑曹等12国组成伐秦联军。联军一举进攻到秦国的咸阳北，遭到秦军的顽强抵抗，晋军统帅栾偃要求联军看他的马头指向行动，由于各有私心而败北"]},{"id":47933,"word":"马首欲东","pinyin":"mǎ shǒu yù dōng","abbr":"msyd","explanation":"指东归；返回。","source":{"text":"秦兵在西，东则归矣。","book":"语出《左传·襄公十四年》：“栾黡曰：'晋国之命，未是有也。余马首欲东。'乃归。”杨伯峻注"},"example":{"text":"今～，无可相赆，手制粗鞋一双，绫袜一緉，聊表微意。","book":"《西湖二集·洒雪堂巧结良缘》"},"usage":"作谓语、定语；用于书面语"},{"id":47934,"word":"马马虎虎","pinyin":"mǎ mǎ hǔ hǔ","abbr":"mmhh","explanation":"指还过得去。亦形容做事不认真，不仔细。","source":{"text":"单办那八个厂，四十多万也就马马虎虎混得过。","book":"茅盾《子夜》十二"},"example":{"text":"从此，我读什么书都不再～了。","book":"周晔《我的伯父鲁迅先生》"},"similar":["粗心大意"],"opposite":["一丝不苟"],"usage":"作谓语、定语、状语；指随便应付"},{"id":47935,"word":"马鹿异形","pinyin":"mǎ lù yì xíng","abbr":"mlyx","explanation":"用赵高指鹿为马的故事，比喻颠倒是非。","source":{"text":"反复欲钳塞士口，杜蔽主听。将使玄黄改色，马鹿易形乎？","book":"《后汉书·崔琦传》"}},{"id":47936,"word":"马鹿易形","pinyin":"mǎ lù yì xíng","abbr":"mlyx","explanation":"出自赵高指鹿为马的故事，比喻颠倒是非、混淆黑白。","source":{"text":"不能结纳贞良，以救祸败，反复欲钳塞士口，杜蔽主听，将欲使玄黄改色，马鹿易形乎？","book":"南朝·宋·范晔《后汉书·文苑传上·崔琦》"},"similar":["颠倒是非","指鹿为马","混淆黑白"],"usage":"作补语、宾语；比喻颠倒是非"},{"id":47937,"word":"马齿加长","pinyin":"mǎ chǐ jiā zhǎng","abbr":"mcjz","explanation":"马的牙齿有多少，就可以知道它的年龄有多大。比喻自己虚度年华，没有成就。","source":{"text":"荀息牵马操璧而前曰：‘璧则犹是也，而马齿加长矣。’","book":"《谷梁传·僖公二年》"},"example":{"text":"我比你～……而今两鬓星星，把昔日意兴，瓦解冰销。","book":"清·魏秀仁《花月痕》第16回"},"similar":["马齿徒长","马齿徒增"],"usage":"作宾语、定语；由于自谦语"},{"id":47938,"word":"马齿徒增","pinyin":"mǎ chǐ tú zēng","abbr":"mctz","explanation":"马的牙齿有多少，就可以知道它的年龄有多大。比喻自己年岁白白地增加了，学业或事业却没有什么成就。","source":{"text":"璧则犹是也，而马齿加长矣。","book":"《谷梁传·僖公二年》"},"example":{"text":"自妾识君，已四五年矣，蛾眉易老，～，尚未能择人而事，自拔出火炕。","book":"清·王韬《淞隐漫录·阿怜阿爱》"},"similar":["马齿徒长"],"opposite":["功成名就"],"usage":"作宾语；由于自谦语","story":["春秋时期，晋献公一心想吞并虢国，苦于没有路到达。大夫荀息建议用骏马和美玉作为交换条件，换取虞国借道。晋献公忍痛割爱拿出骏马和美玉。晋国轻而易举灭了虢国，荀息于是马上建议灭掉虞国，夺回了美玉和骏马，只是骏马多长了几颗牙齿而矣"]},{"id":47939,"word":"马齿徒长","pinyin":"mǎ chǐ tú zhǎng","abbr":"mctz","explanation":"谦称自己虚度年华，没有成就。","source":{"text":"荀息牵马操璧而前曰：‘璧则犹是也，而马齿加长矣。’","book":"《穀梁传·僖公二年》"},"example":{"text":"张太经说：‘今日承蒙垂青，得与将军联宗，不胜荣幸。大经碌碌半生，～，怎好僭居兄位！’","book":"姚雪垠《李自成》第一卷第二十九章"},"similar":["马齿徒增"],"usage":"作宾语；由于自谦语"},{"id":47940,"word":"马龙车水","pinyin":"mǎ lóng chē shuǐ","abbr":"mlcs","explanation":"马象游龙，车象流水。形容车马往来不绝。","source":{"text":"马龙车水，过者如云。","book":"清·捧花生《画舫余谭》"},"example":{"text":"～，倘徉驰骋于春江花月之宵。","book":"陈去病《论戏剧之有益》"},"similar":["车水马龙"],"opposite":["门可罗雀"],"usage":"作谓语、定语；形容繁华热闹的景象"},{"id":47941,"word":"驭凤骖鹤","pinyin":"yù fèng cān hè","abbr":"yfch","explanation":"驾凤骑鹤。传说中仙人多驾鹤升天，故用以比喻仙人或得道之士。今常作为哀挽妇女用语。","source":{"text":"鹤驭已从烟际下，凤膏还向月中焚。白云乡路看看到，好驻流年翊圣文。","book":"唐·吴融《和皮博士赴上京观中修灵》诗"},"example":{"text":"唐武宗嗣历改元会昌。爱～之仪。薄点黑降龙之教。乃下郡国毁庙塔令沙门复。","book":"《神僧传》卷九"}},{"id":47942,"word":"驰名中外","pinyin":"chí míng zhōng wài","abbr":"cmzw","explanation":"驰：传播。形容名声传播得极远。","source":{"text":"赀拟王公，驰名天下。","book":"北魏·郦道元《水经注·涑水》"},"example":{"text":"国民革命军新编第四军抗战有功，～。","book":"毛泽东《为皖南事变发表的命令和谈话》"},"similar":["举世闻名","名闻遐迩","扬名四海"],"opposite":["臭名昭著","默默无闻"],"usage":"作谓语；用于各地都知道的事物"},{"id":47943,"word":"驰名天下","pinyin":"chí míng tiān xià","abbr":"cmtx","explanation":"驰：传扬。形容名声传播得很远。","source":{"text":"赀拟王公，驰名天下。","book":"北魏·郦道元《水经注·涑水》"},"example":{"text":"中国的茶叶是～的。"},"similar":["驰名当世","举世闻名"],"opposite":["默默无闻"],"usage":"作谓语、定语；指有名"},{"id":47944,"word":"驰名当世","pinyin":"chí míng dāng shì","abbr":"cmds","explanation":"驰名：声名远扬；当世：当代，现今。声名在当代传播得很远。形容知名度极高。","source":{"text":"皆辞章灿烂，驰名当世。","book":"晋·常璩《华阳国志·后贤志（陈寿）》"},"example":{"text":"他想干一番～的事业。"},"similar":["天下闻名","举世闻名"],"opposite":["默默无闻"],"usage":"作谓语、定语；指出名"},{"id":47945,"word":"驰声走誉","pinyin":"chí shēng zǒu yù","abbr":"cszy","explanation":"指名声传扬。","source":{"text":"三代而下，尽是此一种人，驰声走誉，比善人有恒，更觉完美。","book":"明·袁宏道《钦叔阳秀才》"},"example":{"text":"我躺在床上～。"},"usage":"作谓语、定语；指名声传扬"},{"id":47946,"word":"驰志伊吾","pinyin":"chí zhì yī wú","abbr":"czyw","explanation":"伊吾，今新疆哈密。以之表示向往在边塞建功立业。","source":{"text":"臧宫、马武之徒，抚鸣剑而抵掌，志驰於伊吾之北矣。","book":"《后汉书·臧宫传论》"}},{"id":47947,"word":"驰思遐想","pinyin":"chí sī xiá xiǎng","abbr":"csxx","explanation":"自由地联想。","example":{"text":"我躺在床上～"},"usage":"作谓语、宾语；用于思想"},{"id":47948,"word":"驰风骋雨","pinyin":"chí fēng chěng yǔ","abbr":"cfcy","explanation":"犹言乘风驾雨。"},{"id":47949,"word":"驰马试剑","pinyin":"chí mǎ shì jiàn","abbr":"cmsj","explanation":"驰马：骑马飞跑；试：用。跑马舞剑。形容人骑马练剑习武。","source":{"text":"吾他日未尝学问，好驰马试剑。","book":"战国·邹·孟轲《孟子·滕文公上》"},"example":{"text":"因此终日教导琼英～。","book":"明·施耐庵《水浒传》第98回"},"usage":"作谓语、宾语；形容人骑马习武"},{"id":47950,"word":"驰骋疆场","pinyin":"chí chěng jiāng chǎng","abbr":"ccjc","explanation":"驰骋：奔驰。疆场：战场。骑着马奔驰在战场上，形容英勇作战，无可阻挡。","example":{"text":"他～大半生，立下了汗马功劳。"},"usage":"作谓语；指人很勇敢"},{"id":47951,"word":"驰高骛远","pinyin":"chí gāo wù yuǎn","abbr":"cgwy","explanation":"驰：追驰；骛：从事，追求。比喻不切实际地追求过高过远的目标。","source":{"text":"但其构思落笔之初，未免驰高骛远。","book":"清·李渔《闲情偶寄·器玩·制度》"},"similar":["好高骛远"],"usage":"作谓语、宾语、状语；指人不切实际"},{"id":47952,"word":"驰高鹜远","pinyin":"chí gāo wù yuǎn","abbr":"cgwy","explanation":"犹言好高骛远。","source":{"text":"但其构思落笔之初，未免驰高鹜远。","book":"清·李渔《闲情偶寄·器玩·制度》"}},{"id":47953,"word":"驰魂夺魄","pinyin":"chí hún duó pò","abbr":"chdp","explanation":"形容振撼心灵。","source":{"text":"各种印象，新鲜而又庄严，使他目不暇给，驰魂夺魄。","book":"徐迟《地质之光》"},"example":{"text":"望着～的钻塔群，想起这一切，耳边卷来了无边的战鼓和汽笛。","book":"李瑛《钻塔礼赞》诗"},"similar":["驰魂宕魄","惊心动魄"],"usage":"作谓语、定语；指震撼心灵的东西"},{"id":47954,"word":"驰魂宕魄","pinyin":"chí hún dàng pò","abbr":"chdp","explanation":"形容振撼心灵。","source":{"text":"还有吹不满旗的灵风推着云车，满载霓裳缥缈、彩佩玲珑的仙娥，给人们颂送着驰魂宕魄的天乐。","book":"闻一多《李白之死》诗"},"similar":["驰魂夺魄"],"usage":"作谓语、定语；指震撼心灵的东西"},{"id":47955,"word":"驱羊战狼","pinyin":"qū yáng zhàn láng","abbr":"qyzl","explanation":"比喻以弱击强。","source":{"text":"而以之抗燕代之劲骑，此驱羊战狼，则明皇与重兵选卒所不得行之也。","book":"宋·张耒《唐论中》"},"similar":["驱羊攻虎"],"usage":"作谓语、定语；指力量悬殊"},{"id":47956,"word":"驱羊攻虎","pinyin":"qū yáng gōng hǔ","abbr":"qygh","explanation":"驱：赶。驱赶羊群去进攻老虎。形容以弱敌强，力量悬殊，必遭覆灭。","source":{"text":"且夫为从者，无以异于驱群羊而攻猛虎，虎之与羊不格明矣。今王不与猛虎而与群羊，臣窃以为大王之计过也。","book":"《史记·张仪列传》"},"similar":["以卵击石"],"usage":"作谓语、定语；指力量悬殊"},{"id":47957,"word":"驱雷掣电","pinyin":"qū léi chè diàn","abbr":"qlcd","explanation":"比喻神通广大。","source":{"text":"把俺那移星换斗神通显，驱雷掣电灵光现。","book":"明·孟称舜《娇红记》"},"similar":["驱雷策电"],"usage":"作谓语、宾语、定语；用于人的本事"},{"id":47958,"word":"驱雷策电","pinyin":"qū léi cè diàn","abbr":"qlcd","explanation":"比喻神通广大。同“驱雷掣电”。","source":{"text":"驱雷策电驭水火，碎裂大地分全球。","book":"清·丘逢甲《长句赠许仙屏中丞时将归潮州》"},"similar":["驱雷掣电"],"usage":"作谓语、宾语、定语；用于人的本事"},{"id":47959,"word":"驱霆策电","pinyin":"qū tíng cè diàn","abbr":"qtcd","explanation":"比喻迅速奔驰。","source":{"text":"周王八骏行万里，朝游昆仑暮沧海。驱霆策电遍天地，虎骤龙驰倏烟霭。","book":"明·何景明《游猎篇》"},"similar":["驱雷策电"],"usage":"作谓语、宾语、定语；用于人的本事"},{"id":47960,"word":"驱骥捕鼠","pinyin":"qū jì bǔ shǔ","abbr":"qjbs","explanation":"驱使千里马去追捕老鼠。比喻任用有才能的人承担他所不能胜任的工作。","source":{"text":"命鸾凤兮逐雀，驱龙骥兮捕鼠，使掌事者校其巧兮，孰能与狸隼而齐举。","book":"唐·卢照邻《五悲·悲才难》"}},{"id":47961,"word":"驴前马后","pinyin":"lǘ qián mǎ hòu","abbr":"lqmh","explanation":"比喻一切受人支配。","source":{"text":"苦哉苦哉，今时人例皆如此，只是认得驴前马后将为自己，佛法平沉，此之是也。","book":"宋·释道原《景德传灯录·良价禅师》"},"example":{"text":"小人是个～之人。","book":"元·高文秀《遇上皇》第二折"},"similar":["鞍前马后"],"usage":"作定语、状语；比喻受人支配"},{"id":47962,"word":"驴唇不对马口","pinyin":"lǘ chún bù duì mǎ kǒu","abbr":"lcbdmk","explanation":"比喻说话写文章，前言不搭后语，两不相合。","source":{"text":"稍一疏神，便说的驴唇不对马口，那还有什么趣味呢！","book":"清·石玉昆《三侠五义》第94回"},"similar":["驴唇不对马嘴"],"usage":"作宾语、定语、分句、状语；指前后矛盾"},{"id":47963,"word":"驴唇不对马嘴","pinyin":"lǘ chún bù duì mǎ zuǐ","abbr":"lcbdmz","explanation":"比喻答非所问或两下不相合。","source":{"text":"驴唇马嘴夸我解问，十转五转饶你从朝。","book":"宋·释道原《景德传灯录》卷十九"},"example":{"text":"一段话说了个乱糟糟，～。","book":"清·文康《儿女英雄传》第二十五回"},"similar":["答非所问","前言不搭后语"],"usage":"作宾语、定语、分句、状语；指前后矛盾"},{"id":47964,"word":"驴唇马嘴","pinyin":"lǘ chún mǎ zuǐ","abbr":"lcmz","explanation":"比喻说话写文章，前言不搭后语，前后矛盾。","source":{"text":"驴唇马嘴夸我解问，十转五转饶你从朝。","book":"宋·释道原《景德传灯录》卷十九"},"example":{"text":"要是样样事情都照书本子上的说法去办理起来，难保有时候不会～，方圆凿枘，闹出笑话来。","book":"吴越《括苍山记恩仇》第二十七回"},"similar":["答非所问","前言不搭后语"],"opposite":["有板有眼"],"usage":"作宾语；指瞎扯，瞎说"},{"id":47965,"word":"驴唇马觜","pinyin":"lǘ chún mǎ zī","abbr":"lcmz","explanation":"指胡扯，瞎说。"},{"id":47966,"word":"驴头不对马嘴","pinyin":"lǘ tóu bù duì mǎ zuǐ","abbr":"ltbdmz","explanation":"比喻答非所问或两下不相合。同“驴唇不对马嘴”。","source":{"text":"只是一件：既是虞美人了，还有虞美人配头；倘或一时问及，驴头不对马嘴，就要弄出本色来了。","book":"明·董说《西游补》第五回"},"example":{"text":"陈正公听了这些话，～，急了一身的臭汗。","book":"清·吴敬梓《儒林外史》第五十二回"},"similar":["驴唇不对马嘴","驴唇不对马口"],"usage":"作宾语、定语、分句、状语；指前后矛盾"},{"id":47967,"word":"驴年马月","pinyin":"lǘ nián mǎ yuè","abbr":"lnmy","explanation":"不可知的年月。","source":{"text":"世界如许广阔不肯出，钻他故纸，驴年出得。","book":"宋·释道原《景德传灯录》卷九"},"example":{"text":"严志和听涛他娘说得也有理，又说：“吞了这口气吧！过个庄稼日子，什么也别扑摸了。即便有点希望，又在那个～呢？”","book":"梁斌《红旗谱》二九"},"similar":["猴年马月","牛年马月"],"usage":"作状语；指未来的岁月"},{"id":47968,"word":"驴心狗肺","pinyin":"lǘ xīn gǒu fèi","abbr":"lxgf","explanation":"比喻人心凶狠恶毒。","source":{"text":"何故苦苦贪私，思量独吃自疴，反把家里东西送与没些相干之人？不知驴心狗肺怎样生的！","book":"明·凌濛初《二刻拍案惊奇》卷四"},"example":{"text":"你这～的贼子，误国害民的蠢奴，罪恶深重！","book":"明·清溪道人《禅真逸史》第三十回"},"similar":["狼心狗肺"],"usage":"作宾语、定语；指人的心肠"},{"id":47969,"word":"驴生戟角","pinyin":"lǘ shēng jǐ jiǎo","abbr":"lsjj","explanation":"驴子本没有角，今长出了角。比喻不可能有的事。","source":{"text":"无钱的可要亲近，则除是驴生戟角瓮生根。","book":"元·关汉卿《金线池》第一折"},"similar":["驴生笄角"],"usage":"作宾语、定语；用于比喻句"},{"id":47970,"word":"驴生笄角","pinyin":"lǘ shēng jī jiǎo","abbr":"lsjj","explanation":"笄：古代盘头发或别住帽子用的簪子。驴子长角。比喻不可能发生的事。","source":{"text":"做哥的才入门便嗔便骂。做嫂嫂的又道是，你发迹，瓮生根驴生笄角。","book":"元·无名氏《冻苏秦》第二折"},"similar":["驴生戟角"],"usage":"作宾语、定语；用于比喻句"},{"id":47971,"word":"驴肝肺","pinyin":"lǘ gān fèi","abbr":"lgf","explanation":"狼心狗肺，坏心眼。","source":{"text":"你看我好心做了驴肝肺，你倒讪起我来，凭说我去罢。","book":"明·兰陵笑笑生《金瓶梅词话》第28回"},"example":{"text":"别把我的好心当作～。"},"similar":["狼心狗肺"],"usage":"作宾语、定语；用于口语"},{"id":47972,"word":"驴鸣犬吠","pinyin":"lǘ míng quǎn fèi","abbr":"lmqf","explanation":"如同驴叫狗咬一般。形容文字言语拙劣。","source":{"text":"惟有韩陵山一片石堪共语，自余驴鸣狗吠，聒耳而已。","book":"唐·张鷟《朝野佥载》"},"example":{"text":"生气值不当的，权当作听见驴鸣犬吠就是了！","book":"二月河《乾隆皇帝》一"},"similar":["驴鸣狗吠"],"usage":"作宾语、定语；形容文章低劣","story":["南北朝时期，温子升作《韩陵山寺碑》，庾信读其文而拓写其本，南朝人问庾信对北方的文士感觉如何？庾信回答说：“唯有韩陵山一片石堪共语，薛道衡、卢思道少解把笔，自余驴鸣犬吠，聒耳而已。”"]},{"id":47973,"word":"驴鸣狗吠","pinyin":"lǘ míng gǒu fèi","abbr":"lmgf","explanation":"如同驴叫狗咬一般。形容文字言语拙劣。","source":{"text":"惟有韩陵山一片石堪共语，自余驴鸣狗吠，聒耳而已。","book":"唐·张鷟《朝野佥载》"},"example":{"text":"先生曰，此乃～，何益于国家。","book":"周作人《道义之事功化》"},"similar":["驴鸣犬吠"],"usage":"作宾语、定语；形容文章低劣","story":["南北朝时期，温子升作《韩陵山寺碑》，庾信读其文而拓写其本，南朝人问庾信对北方的文士感觉如何？庾信回答说：“唯有韩陵山一片石堪共语，薛道衡、卢思道少解把笔，自余驴鸣犬吠，聒耳而已。”"]},{"id":47974,"word":"驷不及舌","pinyin":"sì bù jí shé","abbr":"sbjs","explanation":"驷：古时由四匹马拉的车；舌：指说的话。一句话说出口，四匹马拉的车也追不回。比喻一句话说出来，再也无法收回。","source":{"text":"夫子之说君子也，驷不及舌。","book":"《论语·颜渊》"},"example":{"text":"酒自外入，机繇内泄。悔从醒生，～。","book":"明·东鲁古狂生《醉醒石》第十二回"},"similar":["驷马难追"],"usage":"作谓语；指说一不二"},{"id":47975,"word":"驷之过蠙","pinyin":"sì zhī guò pín","abbr":"szgp","explanation":"用以比喻光阴飞逝。同“驷之过隙”。"},{"id":47976,"word":"驷之过隙","pinyin":"sì zhī guò xì","abbr":"szgx","explanation":"用以比喻光阴飞逝。","source":{"text":"人之生乎地上之无几何也，譬之犹驷驰而过隙也。","book":"语出《墨子·兼爱下》"},"similar":["白驹过隙"],"usage":"作宾语；用于比喻句"},{"id":47977,"word":"驷马不追","pinyin":"sì mǎ bù zhuī","abbr":"smbz","explanation":"指话说出口，就不能再收回，一定要算数。同“驷马难追”。","source":{"text":"何得非正刑书，施行四海。刑名一失，驷马不追。","book":"《邓析子·转辞》：“一言而非，驷马不能追；一言而急，驷马不能及。”《魏书·刑罚志》"},"similar":["驷马难追","驷马莫追"],"usage":"作谓语、分句；用于人说话算数"},{"id":47978,"word":"驷马仰秣","pinyin":"sì mǎ yǎng mò","abbr":"smym","explanation":"驾车的马驻足仰首，谛听琴声。形容音乐美妙动听。","source":{"text":"仰首而秣，听其声也。","book":"语出《荀子·劝学》：“昔者瓠巴鼓瑟而流鱼出听，伯牙鼓琴而六马仰秣。”杨倞注"},"example":{"text":"清·方履钱《拟嵇叔夜》：“～，游鱼叠浪。”"},"usage":"作宾语、定语；用于书面语"},{"id":47979,"word":"驷马莫追","pinyin":"sì mǎ mò zhuī","abbr":"smmz","explanation":"指话说出口，就不能再收回，一定要算数。同“驷马难追”。","source":{"text":"常泰道：‘大丈夫一言既出，驷马莫追，岂有变更！’","book":"明·方汝浩《禅真逸史》第二十八回"},"similar":["驷马不追","驷马难追"],"usage":"作谓语、分句；用于人说话算数"},{"id":47980,"word":"驷马轩车","pinyin":"sì mǎ xuān chē","abbr":"smxc","explanation":"套着四匹马的高盖车。旧时形容有权势的人出行时的阔绰场面。也形容显达富贵。同“驷马高车”。","source":{"text":"驷马轩车易倾覆，何如野老话桑麻。","book":"清·方文《为陈俞公五十初度》诗"},"similar":["驷马高车","驷马高盖"],"usage":"作宾语、定语；形容显达富贵"},{"id":47981,"word":"驷马难追","pinyin":"sì mǎ nán zhuī","abbr":"smnz","explanation":"一句话说出了口，就是套上四匹马拉的车也难追上。指话说出口，就不能再收回，一定要算数。","source":{"text":"一言而非，驷马不能追；一言而急，驷马不能及。","book":"《论语·颜渊》：“夫子之说君子也，驷不及舌。”《邓析子·转辞》"},"example":{"text":"大丈夫一言既出，～，岂有翻悔之理！","book":"元·李寿卿《伍员吹箫》第三折"},"similar":["驷不及舌","言而有信"],"opposite":["蜗行牛步","信口胡说","言而无信"],"usage":"作谓语、分句；用于人说话算数","story":["五代时期，石敬瑭起兵反唐被契丹王野律德光册立为晋国儿皇帝。石敬瑭死后由儿子石重光继位即出帝。944年，契丹进犯晋国，出帝率军抵抗失败，皇太后李氏写降书请求皇帝阿翁放他们一条生路，表示自己说过的话驷马难追"]},{"id":47982,"word":"驷马高盖","pinyin":"sì mǎ gāo gài","abbr":"smgg","explanation":"套着四匹马的高盖车。旧时形容有权势的人出行时的阔绰场面。也形容显达富贵。同“驷马高车”。","source":{"text":"吾黄金白璧，重礼也；驷马高盖，荣势也。","book":"《汉书·于定国传》：“少高大闾门，令容驷马高盖车。”《南史·隐逸传上·渔父》"},"example":{"text":"～之赫奕，呵者肩摩于前，骑者踵接于后，洋洋乎得志于一时。","book":"清·刘大櫆《贲耻堂记》"},"similar":["驷马高车","驷马轩车"],"usage":"作宾语、定语；形容显达富贵"},{"id":47983,"word":"驷马高车","pinyin":"sì mǎ gāo chē","abbr":"smgc","explanation":"驷马：一车所驾的四匹马。套着四匹马的高盖车。旧时形容有权势的人出行时的阔绰场面。也形容显达富贵。","source":{"text":"一旦高车驷马，旗旄导前，而骑卒拥后。","book":"《汉书·于定国传》：“少高大闾门，令容驷马高盖车。”宋·欧阳修《相州昼锦堂记》"},"example":{"text":"改家门做的个五花诰夫人，～锦绣裀。","book":"元·关汉卿《金线池》第一折"},"similar":["驷马高盖","驷马轩车"],"usage":"作宾语、定语；形容显达富贵","story":["西汉时期，东汉郡狱吏于公为人清正廉明，执法公正无私，他坚持为郡内孝妇鸣冤叫屈，终于在新任太守手中为她平反昭雪，老百姓为他建生祠，把门建得可以让驷马高车通过。他的儿子于定国后来官至廷尉，于家门庭更加荣耀"]},{"id":47984,"word":"驷马高门","pinyin":"sì mǎ gāo mén","abbr":"smgm","explanation":"指门第显赫。","source":{"text":"始定国父于公，其闾门坏，父老方共治之。于公谓曰：‘少高大闾门，令容驷马高盖车。我治狱多阴德，未尝有所冤，子孙必有兴者。’至定国为丞相，永为御史大夫，封侯传世云。","book":"《汉书·于定国传》"},"example":{"text":"元·姚燧《王思廉之祖沂赠恒山郡庄惠侯制》：“伍符尺籍，事专司六部之间，～，报顾在百年之后。”"},"usage":"作宾语、定语；用于书面语","story":["西汉时期，东汉郡狱吏于公为人清正廉明，执法公正无私，他坚持为郡内孝妇鸣冤叫屈，终于在新任太守手中为她平反昭雪，老百姓为他建生祠，把门建得可以让驷马高车通过。他的儿子于定国后来官至廷尉，于家门庭更加荣耀"]},{"id":47985,"word":"驹光过隙","pinyin":"jū guāng guò xì","abbr":"jggx","explanation":"指光阴易逝。","source":{"text":"先生，何必自苦！人生如驹光过隙，总要及时行乐，方是达人。","book":"清·吴趼人《痛史》第21回"},"similar":["白驹过隙"],"usage":"作宾语；形容时间过得快"},{"id":47986,"word":"驹留空谷","pinyin":"jū liú kōng gǔ","abbr":"jlkg","explanation":"比喻贤人在野。","source":{"text":"言有乘皎皎然白驹而去之贤人，今在彼大谷之中。","book":"《诗·小雅·白驹》：“皎皎白驹，在彼空谷。”孔颖达疏"},"example":{"text":"凤集高冈，～接英游。","book":"宋·史隽之《望海潮·浮远堂》词"},"usage":"作宾语、定语；用于书面语"},{"id":47987,"word":"驹窗电逝","pinyin":"jū chuāng diàn shì","abbr":"jcds","explanation":"比喻光阴消逝得很快。","source":{"text":"振衣世表，抗迹云间，悁驹窗电逝之劳，得鳌岭云行之趣。","book":"前蜀·杜光庭《封李真人告词》"},"similar":["光阴似箭"],"usage":"作谓语；形容时间过得很快"},{"id":47988,"word":"驹齿未落","pinyin":"jū chǐ wèi luò","abbr":"jcwl","explanation":"驹：小马。小马的乳齿尚未更换。比喻人尚年幼。","source":{"text":"此儿驹齿未落，忧心忡忡是我家龙文（骏马名），更十岁后，当求之千里外。","book":"《北史·杨愔传》"},"similar":["乳臭未干"],"usage":"作谓语；指人年幼"},{"id":47989,"word":"驻景挥戈","pinyin":"zhù jǐng huī gē","abbr":"zjhg","explanation":"驻：停留；景：同“影”，日光；戈：古代的一种兵器。挥舞长戈使太阳停止运行。比喻留住逝去的光阴","source":{"text":"鲁阳何德，驻景挥戈？","book":"唐·李白《李太白集·日出入行》"},"usage":"作宾语、定语；用于书面语","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":47990,"word":"驻红却白","pinyin":"zhù hóng què bái","abbr":"zhqb","explanation":"指保持青春，延迟衰老。红，红颜；白，白首。"},{"id":47991,"word":"驻跸","pinyin":"zhu bi","abbr":"zb","explanation":"皇帝后妃外出,途中暂停小住"},{"id":47992,"word":"驻颜有术","pinyin":"zhù yán yǒu shù","abbr":"zyys","explanation":"有方法保持青春，形容容颜不老。","example":{"text":"因为她～，所以虽然年过四十，看上去仍犹如少女。"}},{"id":47993,"word":"驻颜益寿","pinyin":"zhù yán yì shòu","abbr":"zyys","explanation":"保持容颜不衰老而增长寿命。","source":{"text":"丹成之后，鬼神难容。虽驻颜益寿，但到了五百年后，天降雷灾打你，须要见性明心，预先躲避。","book":"明·吴承恩《西游记》第二回"},"similar":["延年益寿"],"usage":"作谓语、定语；指能长寿"},{"id":47994,"word":"驼背羊髯","pinyin":"tuō bèi yáng rǎn","abbr":"tbyr","explanation":"脊背像骆驼，胡须像山羊。形容老头的形象。","source":{"text":"果然有五六个驼背羊髯的老民上前。","book":"清·李绿园《歧路灯》第九十四回"}},{"id":47995,"word":"驽箭离弦","pinyin":"nǔ jiàn lí xián","abbr":"njlx","explanation":"比喻非常迅速。","source":{"text":"我着你去呵，似驽箭离弦；叫你回来呵，便似毡上拖毛。","book":"元·纪君祥《赵氏孤儿》第一折"}},{"id":47996,"word":"驽蹇之乘","pinyin":"nú jiǎn zhī shèng","abbr":"njzc","explanation":"驽：劣马；蹇：跛驴。用劣马跛驴拉的车子。比喻才能低下。","source":{"text":"驽蹇之乘，不骋千里之途。","book":"《汉书·叙传上》"},"example":{"text":"朓闻潢汙之水，思朝宗而每竭，～，希沃若而中疲。","book":"《南史·谢朓传》"},"usage":"作宾语；用于比喻句"},{"id":47997,"word":"驽马十舍","pinyin":"nú mǎ shí shè","abbr":"nmss","explanation":"用马拉车，一天为一驾，十驾指十天路程。谓驽马奋力拉车，亦可至远。比喻能力低下的人只要奋勉从事，同样能达到目的。","source":{"text":"夫骐骥千里，一日而通；驽马十舍，旬亦至之。","book":"《淮南子·齐俗训》"},"similar":["驽马十驾"],"usage":"作谓语、定语、宾语；同笨鸟先飞"},{"id":47998,"word":"驽马十驾","pinyin":"nú mǎ shí jià","abbr":"nmsj","explanation":"原意是骏马一天的路程，驽马虽慢，但努力不懈，走十天也可以到达。比喻智力低的人只要刻苦学习，也能追上资质高的人。","source":{"text":"骐骥一跃，不能十步；驽马十驾，功在不舍。","book":"战国·赵·荀况《荀子·劝学》"},"example":{"text":"学习上要有～的精神。"},"similar":["驽马十舍"],"usage":"作谓语、定语、宾语；同笨鸟先飞"},{"id":47999,"word":"驽马恋栈","pinyin":"nú mǎ liàn zhàn","abbr":"nmlz","explanation":"驽马：劣马，跑不快的马；栈：指马棚。劣马惦着的只是马棚里的饲料。比喻无能的人只贪图安逸，无远大志向。","source":{"text":"爽与范内疏而智不及，驽马恋栈豆，必不能用也。","book":"《晋书·宣帝纪》"},"example":{"text":"象我，～，只恐真如涤相所说的，“名既裂矣，身败在即！”归去，归去！","book":"高阳《慈禧全传》二十九"},"similar":["驽马恋栈豆"],"usage":"作宾语、定语；指人眼光短浅"},{"id":48000,"word":"驽马恋栈豆","pinyin":"nú mǎ liàn zhàn dòu","abbr":"nmlzd","explanation":"劣马惦着的只是马棚里的饲料。比喻无能的人只贪图安逸，无远大志向。","source":{"text":"范则智矣，驽马恋栈豆，爽必不能用也。","book":"晋·干宝《魏书》"},"example":{"text":"她这是～，成不了气候的。"},"similar":["鼠目寸光"],"usage":"作宾语、定语；指人眼光短浅"},{"id":48001,"word":"驽马铅刀","pinyin":"nú mǎ qiān dāo","abbr":"nmqd","explanation":"铅刀：铅质的刀。蹩脚的马，不快的刀。比喻才力很弱。","source":{"text":"昔文王三分，犹服事殷。但驽马铅刀，不可强扶。","book":"《后汉书·隗嚣传》"},"usage":"作宾语、定语；指平庸之才"},{"id":48002,"word":"驽骥同辕","pinyin":"nú jì tóng yuán","abbr":"njty","explanation":"驽：劣马；骥：良马；辕：车前直木。劣马和良马同拉一辆车。比喻庸人与贤人混在一起。","source":{"text":"驽骥同辕，伯乐为之咨嗟；玉石相揉，和氏为之叹息。","book":"《孔丛子·对魏王》"},"usage":"作宾语、定语；指好坏混在一起"},{"id":48003,"word":"驾尘彍风","pinyin":"jià chén kuò fēng","abbr":"jcgf","explanation":"彍风：疾风。卷起尘土，掀起疾风。形容疾速迅猛。","source":{"text":"去故就新，驾尘彍风，与电争光。","book":"唐·韩愈《送穷文》"}},{"id":48004,"word":"驾肩接武","pinyin":"jià jiān jiē wǔ","abbr":"jjjw","explanation":"肩挨肩，脚碰脚。形容人多。","source":{"text":"有唐之兴，绵历年所，骨鲠清廉之士，怀忠抱义之臣，台省之间，驾肩接武。","book":"《旧唐书·伊思贞李杰等传论》"},"similar":["驾肩接迹"],"usage":"作谓语、定语；形容人多"},{"id":48005,"word":"驾肩接迹","pinyin":"jià jiān jiē jì","abbr":"jjjj","explanation":"形容人多。同“驾肩接武”。","source":{"text":"学徒依附，驾肩接迹；都人士女，向风而至。","book":"《景德传灯录·道悟禅师》"},"similar":["驾肩接武"],"usage":"作谓语、定语；形容人多"},{"id":48006,"word":"驾轻就熟","pinyin":"jià qīng jiù shú","abbr":"jqjs","explanation":"驾：赶马车。驾轻车，走熟路。比喻对某事有经验，很熟悉，做起来容易。","source":{"text":"若驷马驾轻车，就熟路，而王良、造父为之先后也。","book":"唐·韩愈《关石处士序》"},"example":{"text":"到了场期日迫，只得把功令所有条件略为照顾，以求风檐寸晷，有～之乐。","book":"清·李绿园《歧路灯》第一○二回"},"similar":["熟能生巧","得心应手","轻而易举"],"opposite":["半路出家"],"usage":"作谓语、宾语、定语、状语；比喻对事物很熟"},{"id":48007,"word":"驾雾腾云","pinyin":"jià wù téng yún","abbr":"jwty","explanation":"乘着云，驾着雾。原是传说中指会法术的人乘云雾飞行，后形容奔驰迅速或头脑发昏。","source":{"text":"恨不的驾雾腾云，臂生两翅，飞出狱院。","book":"元·郑德辉《老君堂》第二折"},"example":{"text":"马夫把鞭一晃，那车便如～一般的快。","book":"《负曝闲谈》第19回"},"similar":["腾云驾雾"],"usage":"作谓语、宾语、定语；形容在空中飞行"},{"id":48008,"word":"驾鹤成仙","pinyin":"jià hè chéng xiān","abbr":"jhcx","explanation":"指死的婉称。","source":{"text":"老爹，你驾鹤成仙了，嘿嘿。","book":"杨大群《关东传奇》第54章"},"example":{"text":"他的父亲已经～了。"},"similar":["驾鹤西游"],"usage":"作谓语；指死的婉称"},{"id":48009,"word":"驾鹤西游","pinyin":"jià hè xī yóu","abbr":"jhxy","explanation":"死的婉称。","source":{"text":"过老太太言而有信，这事办完不久就驾鹤西游了，紫云正式把家管了起来。","book":"邓友梅《那五》"},"example":{"text":"我现在还不想～。"},"similar":["驾鹤成仙"],"usage":"作谓语、宾语；指死的婉称"},{"id":48010,"word":"驿使梅花","pinyin":"yì shǐ méi huā","abbr":"ysmh","explanation":"表示对亲友的问候及思念。","source":{"text":"陆凯与范晔相善，自江南寄梅花一枝，诣长安与晔，并赠花诗曰：‘折花逢驿使，寄与陇头人。江南无所有，聊寄一枝春。’","book":"《太平御览》卷九七○引南朝宋·盛弘之《荆州记》"},"example":{"text":"清·李调元《青门画菊见赠余亦自画墨梅答之仍用前韵》：“～寄所思，老人特地写枯枝。”"},"similar":["驿路梅花","驿寄梅花"],"usage":"作宾语、定语；用于书面语","story":["南北朝时期，陆凯与范晔是很好的朋友，两人经常书信往来。一年早春，陆凯遇到去长安的驿使，就折下一枝盛开的梅花，托信使带给远在长安的范晔，并作诗：“折花逢驿使，寄与陇头人。江南无所有，聊寄一枝春。”"]},{"id":48011,"word":"驿寄梅花","pinyin":"yì jì méi huā","abbr":"yjmh","explanation":"请邮差寄送梅花。比喻向远方友人表达思念之情。","source":{"text":"折梅逢驿使，寄与陇头人。江南无所有，卿寄一枝春。","book":"三国·陆凯《赠范晔》诗"},"example":{"text":"～，鱼传尺素，砌成此恨无重数。","book":"宋·秦观《踏莎行》词"},"similar":["驿使梅花"],"usage":"作谓语；表示对亲友的问候及思念","story":["南北朝时期，陆凯与范晔是很好的朋友，两人经常书信往来。一年早春，陆凯遇到去长安的驿使，就折下一枝盛开的梅花，托信使带给远在长安的范晔，报道江南春天的消息"]},{"id":48012,"word":"驿路梅花","pinyin":"yì lù méi huā","abbr":"ylmh","explanation":"表示对亲友的问候及思念。","source":{"text":"官桥杨柳和愁折，驿路梅花带雪看。","book":"唐·牟融《送范启东还京》诗"},"similar":["驿使梅花","驿寄梅花"],"usage":"作宾语、定语；用于书面语"},{"id":48013,"word":"骀背鹤发","pinyin":"dài bèi hè fā","abbr":"dbhf","explanation":"鲐背白发。形容年老高寿。","source":{"text":"自竹马游戏，以至骀背鹤发，其相与周旋。","book":"明·陈继儒《读书镜》第四卷"},"example":{"text":"恍四皓之伟步，～，龙翔凤翥。","book":"清·蒲松龄《泰松赋》"},"usage":"作宾语、定语；指老年人"},{"id":48014,"word":"骁勇善战","pinyin":"xiāo yòng shàn zhàn","abbr":"xysz","explanation":"骁：勇猛。指矫健勇猛，善于作战。形容战将英勇出色。","source":{"text":"其党辅国将军孙昙瓘骁勇善战，每荡一合，辄大杀伤，官军死者百余人。","book":"《南齐书·戴僧静传》"},"example":{"text":"旋由粤军司令李烈钧，引众堵截，麾下都是锐卒，～，非龙军所能与敌。","book":"蔡东藩、许厪父《民国通俗演义》第九十四回"},"similar":["有勇有谋","大智大勇"],"opposite":["贪生怕死","胆小怕事"],"usage":"作谓语、定语；指善于战斗"},{"id":48015,"word":"骂不绝口","pinyin":"mà bù jué kǒu","abbr":"mbjk","explanation":"骂声不断。","source":{"text":"乃令经板夹而锯之，致死骂不绝口。","book":"《新编五代史平话·唐史》卷上"},"example":{"text":"有一部分人身带重伤，被俘之后，仍然～，直到被杀。","book":"姚雪垠《李自成》第三卷第二十七章"}},{"id":48016,"word":"骂天咒地","pinyin":"mà tiān zhòu dì","abbr":"mtzd","explanation":"不指明对象地诅咒漫骂。亦作“骂天扯地”。","source":{"text":"后村里纷纷传说谁家老祖宗的墓被盗了，骂天咒地，扎了纸人在村口槐树上吊着，满头满身插了针刺。","book":"贾平凹《妊娠》第二章"},"example":{"text":"李德才跟着老山头走回西锁井，一进冯家大院，听得冯大奶奶在内宅骂天扯地，正在吵闹。","book":"梁斌《播火记》七"},"similar":["骂天扯地"],"usage":"作谓语、状语；指漫骂"},{"id":48017,"word":"骂天扯地","pinyin":"mà tiān chě dì","abbr":"mtcd","explanation":"不指明对象地诅咒漫骂。同“骂天咒地”。","source":{"text":"李德才跟着老山头走回西锁井，一进冯家大院，听得冯大奶奶在内宅骂天扯地，正在吵闹。","book":"梁斌《播火记》七"},"similar":["骂天咒地"],"usage":"作谓语、状语；指漫骂"},{"id":48018,"word":"骂骂咧咧","pinyin":"mà mà liē liē","abbr":"mmll","explanation":"指在说话中夹杂着骂人的话。","source":{"text":"屋内又有徐庆，嘴里是骂骂咧咧的，手中这口刀是神出鬼入。","book":"清·石玉昆《小五义》第99回"},"example":{"text":"他一路～地数落没完。"},"similar":["恶语相向"],"usage":"作定语、状语；指人的神情"},{"id":48019,"word":"骄佚奢淫","pinyin":"jiāo yì shē yín","abbr":"jysy","explanation":"形容生活放纵奢侈，荒淫无度。同“骄奢淫逸”。","source":{"text":"道君骄佚奢淫极，讵料金人来运粮。","book":"《大宋宣和遗事》后集"},"similar":["骄泰淫泆"],"usage":"作谓语、宾语、定语；指人荒淫无度"},{"id":48020,"word":"骄侈暴佚","pinyin":"jiāo chǐ bào yì","abbr":"jcby","explanation":"形容生活放纵奢侈，荒淫无度。同“骄奢淫逸”。","source":{"text":"必是后辈儿孙骄侈暴佚，暴殄天物，以致合府抄、检。","book":"清·曹雪芹《红楼梦》第106回"},"similar":["骄奢淫佚","穷奢极欲","骄侈淫虐"],"usage":"作谓语、宾语、定语；指人荒淫无度"},{"id":48021,"word":"骄侈淫虐","pinyin":"jiāo chǐ yín nüè","abbr":"jcyn","explanation":"形容生活放纵奢侈，荒淫无度。同“骄奢淫逸”。","source":{"text":"徐知训为淮南节度使，骄侈淫虐，为朱瑾所杀，一方甚扰，主亟往代之，悉反其治，谦宽惇裕。","book":"宋·文莹《玉壶清话》第九卷"},"similar":["骄奢淫佚","骄侈暴佚","骄奢淫逸"],"usage":"作谓语、宾语、定语；指人荒淫无度"},{"id":48022,"word":"骄傲自大","pinyin":"jiāo ào zì dà","abbr":"jazd","explanation":"盛气凌人，过分抬高自己。","source":{"text":"而为了达到这个目的，就要特别提出谦虚，反对骄傲自大。","book":"邓小平《在中国新民主主义青年团第三次全国代表大会上的祝词》"},"example":{"text":"他～，自以为了不起。"},"similar":["骄傲自满"],"usage":"作谓语、定语、宾语；指人不谦虚"},{"id":48023,"word":"骄傲自满","pinyin":"jiāo ào zì mǎn","abbr":"jazm","explanation":"看不起别人，满足于自己已有的成绩。","source":{"text":"既登宥密，颇骄傲自满。","book":"宋·王明清《挥麈后录》卷八"},"example":{"text":"你得知道我并不是一个～的人。","book":"巴金《短简·病》"},"similar":["自命不凡","目空一切"],"opposite":["谦虚谨慎","功成不居"],"usage":"作谓语、宾语、定语；指人不谦虚"},{"id":48024,"word":"骄儿騃女","pinyin":"jiāo ér bā nǚ","abbr":"jesn","explanation":"指天真幼稚的儿童。骄，通“娇”。","source":{"text":"间有所存，其不为骄儿騃女为覆瓿之资者几何矣。","book":"明·文征明《耕渔轩倡酬名迹序》"},"usage":"作主语、宾语；用于书面语"},{"id":48025,"word":"骄儿騣女","pinyin":"jiāo ér bā nǚ","abbr":"jebn","explanation":"指天真幼稚的儿童。骄，通娇”。"},{"id":48026,"word":"骄兵之计","pinyin":"jiāo bīng zhī jì","abbr":"jbzj","explanation":"故意向敌军示弱，以助长其骄傲情绪，使其轻敌大意的计策。","source":{"text":"孟达暗暗发书，申报玄德，说‘黄忠连输数阵，现今退在关上。’玄德慌问孔明。孔明曰：‘此乃老将骄兵之计也。’","book":"明·罗贯中《三国演义》第七十回"},"usage":"作宾语；用于处事或军事等"},{"id":48027,"word":"骄兵必败","pinyin":"jiāo bīng bì bài","abbr":"jbbb","explanation":"骄兵：恃强轻敌的军队。骄傲的军队必定打败仗。","source":{"text":"恃国家之大，矜人民之众，欲见威于敌者，谓之骄兵，兵骄者灭。","book":"《汉书·魏相传》"},"example":{"text":"古人云：“～。”这就是少剑波致死的原因。","book":"曲波《林海雪原》二八"},"similar":["一败如水"],"opposite":["哀兵必胜"],"usage":"作主语、宾语、定语；含劝诫性质","story":["西汉时期，汉宣帝刘洵派郑吉率军攻打匈奴，并在车师附近屯田与驻军。匈奴举兵反击。汉宣帝召集群臣商议，丞相魏相不主张增兵，仗着国大人多就会成为骄横的军队，军队骄横必定灭亡。汉宣帝决定不再派兵攻打匈奴"]},{"id":48028,"word":"骄兵悍将","pinyin":"jiāo bīng hàn jiàng","abbr":"jbhj","explanation":"骄：骄横；悍：凶悍。骄横、凶悍的兵将。形容难以高度的军队。","source":{"text":"而间有骄兵悍将，不修军纪，为暴于民，贪官污吏，托名筹饷，因缘为利。","book":"蔡东藩、许廑父《民国通俗演义》第一百五十九回"},"example":{"text":"只要申明军纪，任何～都不敢不听从指挥。","book":"姚雪垠《李自成》第二卷第二十章"}},{"id":48029,"word":"骄奢放逸","pinyin":"jiāo shē fàng yì","abbr":"jsfy","explanation":"形容生活放纵奢侈，荒淫无度。同“骄奢淫逸”。","source":{"text":"孝言本以勋戚绪馀，致位通显，至此便骄奢放逸，无所畏惮。","book":"《北齐书·段孝言传》"},"similar":["骄奢淫佚","骄奢淫逸","骄奢淫泆"],"usage":"作谓语、宾语、定语；指人荒淫无度"},{"id":48030,"word":"骄奢淫佚","pinyin":"jiāo shē yín yì","abbr":"jsyy","explanation":"形容生活放纵奢侈，荒淫无度。同“骄奢淫逸”。","source":{"text":"是以《春秋》爱子教以义方，不纳入邪。骄奢淫佚，所自邪也。","book":"南朝·宋·范晔《后汉书·班彪传》"},"example":{"text":"他自从富贵起来，也忘却了少年时的贫困，总是～，尽情挥霍。","book":"清·黄小配《廿载繁华梦》第37回"},"similar":["骄侈暴佚","骄奢淫逸","骄奢放逸"],"usage":"作谓语、宾语、定语；指人荒淫无度"},{"id":48031,"word":"骄奢淫泆","pinyin":"jiāo shē yín yí","abbr":"jsyy","explanation":"形容生活放纵奢侈，荒淫无度。同“骄奢淫逸”。","source":{"text":"臣闻爱子，教之以义方，弗纳于邪。骄奢淫泆，所自邪也。四者之来，宠禄过也。","book":"春秋·鲁·左丘明《左传·隐公三年》"},"example":{"text":"攸罪不减乃父，燕山之役，祸及宗社，～，载籍所无。","book":"《宋史·蔡攸传》"},"similar":["骄奢淫佚","骄泰淫泆","骄奢淫逸"],"usage":"作谓语、宾语、定语；指人荒淫无度"},{"id":48032,"word":"骄奢淫逸","pinyin":"jiāo shē yín yì","abbr":"jsyy","explanation":"逸：放荡。原指骄横、奢侈、荒淫、放荡四种恶习。后形容生活放纵奢侈，荒淫无度。","source":{"text":"骄奢淫佚，所自邪也。","book":"《左传·隐公三年》"},"example":{"text":"况且是丰厚这之家，本有～之资；况且是寡妇之子，又有信惯纵放之端。","book":"清·李绿园《歧路灯》第二十一回"},"similar":["骄奢淫佚","穷奢极欲","骄侈暴佚"],"opposite":["节衣缩食"],"usage":"作谓语、宾语、定语；指人荒淫无度","story":["春秋时期，卫庄公十分溺爱他的儿子公子州吁，促使他固执放荡，为所欲为，横行霸道。大夫石腊劝告卫庄公不要把州吁培养成骄横跋扈、奢侈腐化的人。庄公死后，州吁杀死哥哥卫桓公，自己做国君，因为性情残暴，被石腊用计杀害"]},{"id":48033,"word":"骄横跋扈","pinyin":"jiāo hèng bá hù","abbr":"jhbh","explanation":"骄横：傲慢专横；跋扈：专横暴戾。形容为人专横暴戾，不可一世。","source":{"text":"为父的季平子，生前骄横跋扈，生下的儿子季桓子，却是孱弱窝囊。","book":"钱宁《圣人》第20章"},"similar":["飞扬跋扈","专横跋扈"],"opposite":["谦虚谨慎","彬彬有礼"],"usage":"作谓语、定语、状语；用于为人"},{"id":48034,"word":"骄泰淫泆","pinyin":"jiāo tai yín zhuàng","abbr":"jtyy","explanation":"形容生活放纵奢侈，荒淫无度。同“骄奢淫逸”。","source":{"text":"阜陵质王延，在国骄泰淫泆。","book":"《东观汉记·阜陵质王延传》"},"similar":["骄奢淫泆","骄佚奢淫","骄奢淫逸"],"usage":"作谓语、宾语、定语；指人荒淫无度"},{"id":48035,"word":"骄生惯养","pinyin":"jiāo shēng guàn yǎng","abbr":"jsgy","explanation":"骄：通“娇”。指娇生惯养。","source":{"text":"富贵家之小孩，骄生惯养，大半身体柔弱，时膺疾病。","book":"胡朴安《中华全国风物志·江苏·吴县之奇俗》"},"similar":["娇生惯养"],"usage":"作谓语、定语；指娇生惯养"},{"id":48036,"word":"骅骝开道","pinyin":"hua liu kai dao","abbr":"hlkd","explanation":"古代高级官僚出行，仪仗用马匹前导。"},{"id":48037,"word":"骆驿不绝","pinyin":"luò yì bù jué","abbr":"lybj","explanation":"骆驿：往来不断，前后相继。来来往往，接连不断，前后相继。形容或车马等前后相接，连续不断。","source":{"text":"无所归，窜逃入塞者骆驿不绝。","book":"南朝·宋·范晔《后汉书·南匈奴传》"},"example":{"text":"路上是～的行李车和人。","book":"鲁迅《且介亭杂文二集·萧红作序》"},"similar":["络绎不绝"],"opposite":["七零八落"],"usage":"作谓语、定语、状语；形容多"},{"id":48038,"word":"骇人听闻","pinyin":"hài rén tīng wén","abbr":"hrtw","explanation":"骇：震惊。使人听了非常吃惊、害怕。","source":{"text":"南通一巷，谓之界身，并是金银帛交易之所，屋宇雄壮，门面广阔，望之森然，每一交易，动即千万，骇人闻见。","book":"宋·孟元老《东京梦华录·东角楼街巷》"},"example":{"text":"任听部下逞艳于非时之候，献媚于世主之前，致令时序颠倒，～。","book":"清·李汝珍《镜花缘》第六回"},"similar":["危言耸听","耸人听闻"],"opposite":["司空见惯"],"usage":"作谓语、定语；指使人听了非常震惊","story":["隋朝时期，隋文帝杨坚任命曾在北齐、北周都作过官的王劭为“著作郎”。到隋炀帝杨广时，他还是“著作郎”，他靠的就是散布离奇故事，歪曲奇异现象，为皇帝散布永坐江山等离奇谣言，真是骇人听闻"]},{"id":48039,"word":"骇人视听","pinyin":"hài rén shì tīng","abbr":"hrst","explanation":"使人目见耳闻感到震惊。","source":{"text":"或文词鄙野，或不轨不物，骇人视听，大为有识所嗤鄙。","book":"《隋书·王劭传》"},"example":{"text":"唯府兵之设，敛千岁已散之民而系之兵，庶几得三代遗意，能不～以就其事，而效见于后世。","book":"宋·安焘等《〈周书〉序》"},"similar":["骇人听闻","骇人闻见"],"usage":"作谓语、定语；指使人震惊的事","story":["隋朝时期，隋文帝杨坚任命曾在北齐、北周都作过官的王劭为“著作郎”。到隋炀帝杨广时，他还是“著作郎”，他靠的就是散布离奇故事，歪曲奇异现象，为皇帝散布永坐江山等离奇谣言，那些故事真是骇人视听"]},{"id":48040,"word":"骇人闻听","pinyin":"hài rén wén tīng","abbr":"hrwt","explanation":"使人听了非常吃惊、害怕。同“骇人听闻”。","source":{"text":"[吴贤]忽一日仰天而叹，说出一句骇人闻听之言，道人生天地间，上不做玉皇大帝，下情愿做卑田乞儿，若做个世上不沉不浮，可有可无之人，有何用处？","book":"《豆棚闲话·小乞儿真心孝义》"},"example":{"text":"清·无垢道人《八仙全传》第12回：“这总是一件～的事情。”"},"similar":["骇人闻见","骇人视听","骇人听闻"],"usage":"作谓语、定语；指使人听了非常震惊"},{"id":48041,"word":"骇人闻见","pinyin":"hài rén wén jiàn","abbr":"hrwj","explanation":"使人目见耳闻感到震惊。同“骇人视听”。","source":{"text":"屋宇雄壮，门面广阔，望之森然，每一交易，动即千万，骇人闻见。","book":"宋·孟元老《东京梦华录·东角楼街巷》"},"similar":["骇人闻听","骇人视听","骇人听闻"],"usage":"作谓语、定语；指使人听了非常震惊"},{"id":48042,"word":"骇心动目","pinyin":"hài xīn dòng mù","abbr":"hxdm","explanation":"犹言惊心动目。","source":{"text":"传观左右，失手坠于江中，乃祷于神，愿复得之，当藏之庙中，为往来者骇心动目诡异之观。","book":"宋·苏轼《顺济王庙新获石砮记》"},"similar":["触目惊心","骇目惊心"],"usage":"作谓语、定语；形容事态严重"},{"id":48043,"word":"骇浪惊涛","pinyin":"hài làng jīng tāo","abbr":"hljt","explanation":"骇：使惊怕；涛：大波浪。汹涌吓人的浪涛。比喻险恶的环境或尖锐激烈的斗争。","source":{"text":"人当既静之时，每思及前经所履之惊涛骇浪，未尝不惕然。","book":"唐·田颖《玉山堂文集·海云楼记》"},"example":{"text":"年未及笄，遍历海外，走蛮烟瘴雨之乡，受～之险。","book":"清·李汝珍《镜花缘》第六回"},"similar":["惊涛骇浪","惊涛巨浪"],"usage":"作宾语、定语；指险恶的环境或尖锐激烈斗争"},{"id":48044,"word":"骇状殊形","pinyin":"hài zhuàng shū xíng","abbr":"hzsx","explanation":"犹言奇形怪状。","source":{"text":"阳侯拜，天吴舞，骇状殊形不可数。","book":"清·祝德麟《海啸》诗"},"similar":["奇形怪状"],"usage":"作谓语、宾语、状语；同“奇形怪状”"},{"id":48045,"word":"骇目惊心","pinyin":"hài mù jīng xīn","abbr":"hmjx","explanation":"使人见到非常震惊。","source":{"text":"平地水深数丈，树头牵夫藻荇，舵尾压于楼台，骇目惊心，声如万马。","book":"清·和邦额《夜谭随录·修鳞》"},"example":{"text":"[包兴]不觉～，失声道：‘哎哟……这是那里来的刀。’","book":"《三侠五义》第三八回"},"similar":["骇目振心","触目惊心"],"usage":"作谓语、定语；形容事态严重"},{"id":48046,"word":"骇目振心","pinyin":"hài mù zhèn xīn","abbr":"hmzx","explanation":"使人见到非常震惊。同“骇目惊心”。","source":{"text":"一以为霆惊电煜，骇目振心；一以为落日明霞，馀晖映远。","book":"陈田《明诗纪事丁签·何景明》"},"similar":["骇目惊心"],"usage":"作谓语、定语；形容事态严重"},{"id":48047,"word":"骇龙走蛇","pinyin":"hài lóng zǒu shé","abbr":"hlzs","explanation":"龙蛇被掠走。形容声势浩大。"},{"id":48048,"word":"骈兴错出","pinyin":"pián xīng cuò chū","abbr":"pxcc","explanation":"指不断涌现。","source":{"text":"上既立太学，以育才俊士，六七年间，奇能足用之人，骈兴错出，布列乎内外，为政咸有可称。","book":"明·宋濂《送王文冏序》"},"similar":["层出不穷"],"usage":"作谓语、定语；用于书面语"},{"id":48049,"word":"骈四俪六","pinyin":"pián sì lì liù","abbr":"psll","explanation":"骈：并列，对偶；俪：成双，成对。指多用四字、六字句对偶排比的骈体文。","source":{"text":"骈四俪六，锦心绣口。","book":"唐·柳宗元《乞巧文》"},"example":{"text":"现在还常有～，典丽堂皇的祭文、挽联、宣言、通电。","book":"鲁迅《南腔北调集·作文秘诀》"},"similar":["成双成对"],"usage":"作定语；用于写作"},{"id":48050,"word":"骈拇枝指","pinyin":"pián mǔ zhī zhǐ","abbr":"pmzz","explanation":"骈母：脚上的拇指与第二趾合成一趾；枝指：手上大拇指帝多生一指。比喻多余的、无用的东西。","source":{"text":"骈拇枝指，出乎性哉，而侈于德。","book":"《庄子·骈拇》"},"example":{"text":"此偶感异气耳，非妖也。～亦异于众，可曰妖乎哉？","book":"清·纪昀《阅微草堂笔记》卷十一"},"usage":"作主语、谓语、宾语；比喻多余无用的东西"},{"id":48051,"word":"骈枝俪叶","pinyin":"pián zhī lì yè","abbr":"pzly","explanation":"指偶句俪辞。","source":{"text":"吾少学为文，已知訾謷王李，愲愲然骈枝俪叶，从事于六朝，久而厌之，是亦王李之朋徒耳。","book":"清·钱谦益《序》"},"usage":"作宾语、定语；用于书面语"},{"id":48052,"word":"骈肩叠迹","pinyin":"pián jiān dié jì","abbr":"pjdj","explanation":"形容人多拥挤。同“骈肩累迹”。","source":{"text":"京师为四方之会，万民之所聚处，仕宦宾旅，骈肩叠迹。","book":"清·刘大櫆《乞捐输以待周急引》"},"similar":["骈肩累迹","骈肩接迹"],"usage":"作谓语、定语；形容人多拥挤"},{"id":48053,"word":"骈肩接迹","pinyin":"pián jiān jiē jì","abbr":"pjjj","explanation":"形容人多拥挤。同“骈肩累迹”。","source":{"text":"形容人多拥挤。同“骈肩累迹”。"},"similar":["骈肩叠迹","骈肩累迹"],"usage":"作谓语、定语；形容人多拥挤"},{"id":48054,"word":"骈肩累足","pinyin":"pián jiān lěi zú","abbr":"pjlz","explanation":"骈：两物并列；累：重迭；足：足迹。肩并肩，脚印合脚印。形容人多拥挤。","source":{"text":"夹道之人，相与骈肩累迹，瞻望咨嗟。","book":"宋·欧阳修《相州昼锦堂记》"},"similar":["骈肩累踵"],"usage":"作谓语、定语、状语；形容人多拥挤"},{"id":48055,"word":"骈肩累踵","pinyin":"pián jiān lèi zhǒng","abbr":"pjlz","explanation":"形容人多拥挤。同“骈肩累迹”。","source":{"text":"夹道之人，相与骈肩累迹，瞻望咨嗟。","book":"宋·欧阳修《相州昼锦堂记》"},"example":{"text":"二十八日为城隍夫人诞辰，城中热闹，无异于城外，几于倾邑若狂，士女往观者，～。","book":"清·王韬《瀛壖杂志》"},"similar":["骈肩累迹"],"usage":"作谓语、定语；形容人多拥挤"},{"id":48056,"word":"骈肩累迹","pinyin":"pián jiān lěi jì","abbr":"pjlj","explanation":"骈：两物并列；累：重迭；迹：脚印。肩并肩，脚印合脚印。形容人多拥挤。","source":{"text":"夹道之人相与骈肩累迹，瞻望咨嗟。","book":"宋·欧阳修《相州昼锦堂记》"},"example":{"text":"一时门外瞻望颜色，伺候车骑者，～。","book":"清·陈康祺《郎潜纪闻》第八卷"},"similar":["骈肩累足","骈肩累踵"],"usage":"作谓语、定语；形容人多拥挤"},{"id":48057,"word":"骈肩迭迹","pinyin":"pián jiān dié jì","abbr":"pjdj","explanation":"形容人多拥挤。同“骈肩累迹”。"},{"id":48058,"word":"骈门连室","pinyin":"pián mén lián shì","abbr":"pmls","explanation":"形容为数众多。","source":{"text":"自宋道无章，王风陵替，窃官假号，骈门连室。","book":"《南齐书·竟陵文宣王子良传》"},"usage":"作谓语、定语；用于书面语"},{"id":48059,"word":"骈首就僇","pinyin":"pián shǒu jiù guī","abbr":"psjl","explanation":"指一并被杀。同“骈首就戮”。"},{"id":48060,"word":"骈首就僯","pinyin":"pián shǒu jiù guī","abbr":"psjg","explanation":"指一并被杀。同骈首就戮”。"},{"id":48061,"word":"骈首就戮","pinyin":"pián shǒu jiù lù","abbr":"psjl","explanation":"指一并被杀。","source":{"text":"可怜周戴二兄，不听吾言，果然骈首就戮。","book":"明·徐复祚《投梭记·哭友》"},"example":{"text":"我偏师一出，即望风奔溃，～，曾未见有抗螳臂以当车辙者。","book":"清·宋学洙《张文忠公遗事》"},"similar":["骈首就僇"],"usage":"作谓语、定语；用于书面语"},{"id":48062,"word":"骈首就死","pinyin":"pián shǒu jiù sǐ","abbr":"psjs","explanation":"指一并被杀。同“骈首就戮”。","source":{"text":"呼其壮士出，以次斩戮，寂无一声，骈首就死。","book":"清·昭梿《啸亭杂录·西域用兵始末》"},"similar":["骈首就戮"],"usage":"作谓语、定语；用于书面语"},{"id":48063,"word":"骈首就系","pinyin":"pián shǒu jiù xì","abbr":"psjx","explanation":"指一并被拘禁。","source":{"text":"嫡庶诸子，骈首就系；后嫔贵主，受辱于人。","book":"清·唐甄《潜书·远谏》"},"similar":["骈首就逮"],"usage":"作谓语、定语；用于书面语"},{"id":48064,"word":"骈首就逮","pinyin":"pián shǒu jiù dǎi","abbr":"psjd","explanation":"指一并被拘禁。同“骈首就系”。","source":{"text":"翁以故相终老，未有显过闻于天下，而使其子骈首就逮，脱不幸有伤雾露之疾。","book":"清·宋学洙《张文忠公遗事》"},"similar":["骈首就系"],"usage":"作谓语、定语；用于书面语"},{"id":48065,"word":"骊黄牝牡","pinyin":"lí huáng pìn mǔ","abbr":"lhpm","explanation":"犹言牝牡骊黄。喻指事物的表面现象。","source":{"text":"每见一班按图索骥者，多失于骊黄牝牡。","book":"明·文徵明《跋米临禊帖》：“盖昔人论书，有脱墼之诮，米公得此意，故所作如此。观者当求之骊黄牝牡之外也。”明·赵汸《葬书问对》"},"example":{"text":"～谁能究，尘埃物色难参透。","book":"明·徐复祚《投梭记·应聘》"},"similar":["牝牡骊黄"],"usage":"作宾语、定语；比喻事物的表面现象","story":["春秋时期，秦穆公让孙阳（伯乐）挑选出很多千里马。伯乐老了，秦穆公问他有没有继承人，他推荐九方皋。九方皋出去找了三个月回来说在沙丘有匹黄色的母马，可派人牵回一匹纯黑的公马是匹好马。伯乐认为九方皋更能相出马的内在素质"]},{"id":48066,"word":"骊龙颌下取明珠","pinyin":"lí lóng hàn xià qǔ mí zhū","abbr":"llhxqmz","explanation":"骊龙：黑色的龙；颌：下巴。在黑龙的下巴底下掏取明珠。比喻冒险贪求，自取其祸。","source":{"text":"取石来锻之。夫千金之珠，必在九重之渊，而骊龙颔下，子能得珠者，必遭其睡也。使骊龙而寤，子尚奚微之有哉？","book":"《庄子·列御寇》"},"example":{"text":"遮莫去大虫口中夺脆骨，～。","book":"元·郑廷玉《后庭花》第二折"}},{"id":48067,"word":"骋嗜奔欲","pinyin":"chěng shì bēn yù","abbr":"csby","explanation":"指随自己的嗜欲而奔走求取。","source":{"text":"逮叔世骄荒，曾无戒惧，肆于人上，骋嗜奔欲，不可具载，请略陈之。","book":"《北史·房彦谦传》"},"similar":["骋耆奔欲"],"usage":"作谓语、宾语；指满足嗜好"},{"id":48068,"word":"骋怀游目","pinyin":"chěng huái yóu mù","abbr":"chym","explanation":"骋怀：放开胸怀，往远处想；游目：远眺。纵目四望，开阔心胸。","source":{"text":"仰观宇宙之大，俯察品类之盛，所以游目骋怀，足以极视听之娱，信可乐也。","book":"晋·王羲之《兰亭集序》"},"usage":"作宾语、定语；用于书面语"},{"id":48069,"word":"骋目流眄","pinyin":"chěng mù liú miǎn","abbr":"cmlm","explanation":"骋目：纵目四望；流眄：转动眼睛。纵目四处远望。","source":{"text":"临巽维而骋目，即堆冢而流眄，虽兹山这培楼，乃文靖之所宴。","book":"《梁书·沈约传》引《郊居赋》"},"usage":"作谓语；指远望"},{"id":48070,"word":"骋耆奔欲","pinyin":"chěng qí bēn yù","abbr":"cqby","explanation":"耆，同“嗜”。指随自己的嗜欲而奔走求取。","source":{"text":"若夫壮士慷慨，殊乡别趣，东西南北，骋耆奔欲。","book":"《汉书·扬雄传上》"},"similar":["骋嗜奔欲"],"usage":"作谓语、宾语；指满足嗜好"},{"id":48071,"word":"验明正身","pinyin":"yàn míng zhèng shēn","abbr":"ymzs","explanation":"验清楚确是其本人，而非冒名顶替者。","source":{"text":"只要‘验明正身’，不是冒充，他们陈家族长来不来，倒也不生关系。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"罪犯已经被～，执行死刑。"},"opposite":["冒名顶替"],"usage":"作谓语、定语；指打假"},{"id":48072,"word":"骏命不易","pinyin":"jùn mìng bù yì","abbr":"jmby","explanation":"骏：大；易：改变。旧指天命难以更改。","source":{"text":"宣鉴于殷，骏命不易。","book":"《诗经·大雅·文王》"},"example":{"text":"道光授受，谋深燕诒。～，子孙保之。","book":"《宋史·礼乐志》"}},{"id":48073,"word":"骏波虎浪","pinyin":"jùn bō hǔ làng","abbr":"jbhl","explanation":"形容迅猛汹涌的波浪。"},{"id":48074,"word":"骏骨牵盐","pinyin":"jùn gǔ qiān yán","abbr":"jgqy","explanation":"指才华遭到抑制。","source":{"text":"夫骥之齿至矣，服盐车而上大行，蹄申膝折。","book":"西汉·刘向《战国策·楚策四》"},"example":{"text":"悠悠人世，本少知音，～，玄文覆酱。","book":"清·袁枚《与汪可舟书》"},"similar":["骥服盐车"],"usage":"作谓语、定语；指才华遭到抑制"},{"id":48075,"word":"骐骥一毛","pinyin":"qí jì yī máo","abbr":"qjym","explanation":"比喻珍品的极小部分。","source":{"text":"此石刻在洛阳，本在洛宫前御史台中，年久摧散。洛人好事者时时得之，若骐骥一毛，虬龙片甲。","book":"宋·黄伯思《记石经与今文不同》"},"similar":["虬龙片甲"],"usage":"作宾语；比喻珍品的极小部分"},{"id":48076,"word":"骐骥困盐车","pinyin":"qí jì kùn yán chē","abbr":"qjkyc","explanation":"犹言骥伏盐车。指才华遭到抑制，处境困厄。","source":{"text":"未省孙阳身没后，几多骐骥困盐车。","book":"唐·胡曾《咏史诗·虞坂》"},"example":{"text":"只今～，落日长鸣漫昂首。","book":"元·陈深《书骏马图》诗"},"similar":["骥服盐车"],"usage":"作宾语、定语；用于人处于困境时"},{"id":48077,"word":"骐骥过隙","pinyin":"qí jì guò xì","abbr":"qjgx","explanation":"形容时间过得飞快。","source":{"text":"《庄子·知北游》“人生天地之间，若白驹之过卻，忽然而已。”"},"similar":["白驹过隙"],"usage":"作宾语；指时间过得飞快"},{"id":48078,"word":"骑上扬州鹤","pinyin":"qí shàng yáng zhōu hè","abbr":"qsyzh","explanation":"比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同“骑鹤上扬州”。"},{"id":48079,"word":"骑扬州鹤","pinyin":"qí yáng zhōu hè","abbr":"qyzh","explanation":"比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同“骑鹤上扬州”。"},{"id":48080,"word":"骑曹不记马","pinyin":"qí cáo bù jì mǎ","abbr":"qcbjm","explanation":"指有名士习气，不理事务。","source":{"text":"《晋书·王徽之传》载：“徽之字子猷。性卓荦不羁，为大 司马桓温参军，蓬首散带，不综府事。又为车骑桓冲骑兵参军，冲问：‘卿署何曹？’对曰：‘似是马曹。’又问：‘管几马？’曰：‘不知马，何由如数！’又问：‘马比死多少？’曰：‘未知生，"}},{"id":48081,"word":"骑牛觅牛","pinyin":"qí niú mì niú","abbr":"qnmn","explanation":"原比喻一面占着一个位置，一面去另找更称心的工作。现多比喻东西就在自己这里，还到处去找。同“骑驴觅驴”。","source":{"text":"师即造于百丈，礼而问曰：‘学人欲求识佛，何者即是？’百丈曰：‘大似骑牛觅牛。’","book":"宋·释道原《景德传灯录·福州大安禅师》"},"similar":["骑驴觅驴","骑马找马"],"usage":"作谓语、定语、分句；用于人"},{"id":48082,"word":"骑牛读汉书","pinyin":"qí niú dú hàn shū","abbr":"qndhs","explanation":"形容刻苦攻读。","source":{"text":"（李密）闻包恺的缑山，往从之。以蒲韀乘牛，挂《汉书》一帙角上，行且读。","book":"《新唐书·李密传》"}},{"id":48083,"word":"骑者善坠","pinyin":"qí zhě shàn zhuì","abbr":"qzsz","explanation":"常骑马的人总难免掉下马背。比喻擅长某一事物的人往往由于疏忽大意而失败。","example":{"text":"你明白～的道理吗？"},"similar":["骑者善堕"],"usage":"作宾语、定语；用于劝诫人","story":["春秋时期，吴王夫差灭掉越国之后更加得意忘形，他特别喜欢太宰伯憘拍马屁，大修姑苏台，杀了太师伍子胥，整天玩乐。一次叫术士公孙圣解梦，公孙圣说：“经常骑马的人往往会跌下来，大王不可好战。”夫差不听劝阻，反而杀了他"]},{"id":48084,"word":"骑者善堕","pinyin":"qí zhě shàn duò","abbr":"qzsd","explanation":"惯于骑马的人常常会从马上摔下来。比喻善长某一技艺的人，往往因大意而招致失败。","source":{"text":"悲哉，夫好船者溺，好骑者堕，君子各以所好为祸。","book":"汉·袁康《越绝书·外传记吴王占梦》"},"example":{"text":"旨哉古言！～。","book":"清·蒲松龄《聊斋志异·念秧》"},"similar":["骑者善坠"],"usage":"作宾语、定语；用于劝诫人","story":["春秋时期，吴王夫差灭掉越国之后更加得意忘形，他特别喜欢太宰伯憘拍马屁，大修姑苏台，杀了太师伍子胥，整天玩乐。一次叫术士公孙圣解梦，公孙圣说：“经常骑马的人往往会跌下来，大王不可好战。”夫差不听劝阻，反而杀了他"]},{"id":48085,"word":"骑虎难下","pinyin":"qí hǔ nán xià","abbr":"qhnx","explanation":"骑在老虎背上不能下来。比喻做一件事情进行下去有困难，但情况又不允许中途停止，陷于进退两难的境地。","source":{"text":"骑虎不敢下，攀龙忽堕天。","book":"《晋书·温峤传》：“今之事势，义无旋踵，骑猛兽安可中下哉。”唐·李白《留别广陵诸公》诗"},"example":{"text":"本月三日抛出的一百万公债，都成了～之势，我们只有硬着头皮干到那里是那里了！","book":"茅盾《子夜》十"},"similar":["进退两难","欲罢不能"],"opposite":["一帆风顺","势如破竹"],"usage":"作谓语、定语；指局面","story":["北周随州刺史杨坚娶了周明帝的皇后的妹妹独孤氏，周宣帝死后，年幼的周静帝即位，他以辅佐为名就入朝任相国，把持朝政，连周静帝事事都要请示他。独孤氏见时机成熟就劝杨坚篡位说：“骑兽之势，必不得下。”杨坚称帝改国号“隋”"]},{"id":48086,"word":"骑马乘舟","pinyin":"qí mǎ chéng zhōu","abbr":"qmcz","explanation":"形容生搬硬套，凭空想象的形而上学。","source":{"text":"有好乘马者，为人所欺，以五十金易一马，驽甚，不堪策。乃货舟载马，而身跨其上。","book":"《笑府》"},"usage":"作宾语、定语；指人形而上学","story":["有个好骑马的人上当受骗用五十两金子买了一匹劣马，无法骑得太快。他租了一条船把马载上，自己跨在马背上，走了一里多路嫌慢，就对船夫说：“我请你喝酒，请加把劲快点摇，我要放马驰骋，好好过把瘾。”"]},{"id":48087,"word":"骑马寻马","pinyin":"qí mǎ xún mǎ","abbr":"qmxm","explanation":"比喻已经有了好处，还要去谋另外的好处。","source":{"text":"如果收了我的实收，他自然照应我。彼时间骑马寻马，只要弄到一笔大大的银款，赚上百十两扣头，就有在里头了。","book":"清·李宝嘉《官场现形记》第二十一回"},"similar":["骑马找马","骑驴觅驴"],"usage":"作谓语、定语、分句；用于处事"},{"id":48088,"word":"骑马找马","pinyin":"qí mǎ zhǎo mǎ","abbr":"qmzm","explanation":"骑着马去找别的马。原比喻一面占着一个位置，一面去另找更称心的工作。现多比喻东西就在自己这里，还到处去找。","source":{"text":"诵经不不见有无义，真似骑驴更觅驴。","book":"宋·释道原《景德传灯录》卷二十八"},"example":{"text":"他得一边儿找事，还得一边儿拉散座；～，他不能闲起来。","book":"老舍《骆驼祥子》一"},"similar":["骑驴找驴"],"usage":"作谓语、定语、分句；用于人"},{"id":48089,"word":"骑马顶包","pinyin":"qí mǎ dǐng bāo","abbr":"qmdb","explanation":"包：包裹。骑着马顶着包。比喻分不清事物之间的关系。","source":{"text":"恐马负太沉，顶在头上，可省马力。","book":"《嘻谈续录》"},"usage":"作宾语、定语；指人机械","story":["从前有一个人头顶着被包，骑在马背上赶路，他在马上左右摇摆，十分吃力。路人见他这么狼狈，就问他为什么要顶着被包而不放在马背上呢？他回答说怕马负担太重，顶在头上可以为马省一些力。真是荒唐可笑"]},{"id":48090,"word":"骑驴倒堕","pinyin":"qí lǘ dǎo duò","abbr":"qldd","explanation":"形容太平之世。","source":{"text":"华山隐士陈抟……常乘白骡，从恶少年数百，欲入汴州。中途闻艺祖登极，大笑坠骡曰：‘天下于是定矣。’遂入华山为道士。","book":"典出宋·邵伯温《闻见前录》卷七"}},{"id":48091,"word":"骑驴吟灞上","pinyin":"qí lǘ yín bà shàng","abbr":"qlybs","explanation":"用为苦吟的典故。同“骑驴索句”。"},{"id":48092,"word":"骑驴索句","pinyin":"qí lǘ suǒ jù","abbr":"qlsj","explanation":"后用为苦吟的典故。","source":{"text":"唐相国郑綮虽有诗名，本无廊庙之望……或曰：‘相国近有新诗否？’对曰：‘诗思在灞桥雪中驴子上，此处何以得之？’盖言平生苦心也。","book":"宋·孙光宪《北梦琐言》卷七载"},"example":{"text":"宋·范成大《北门覆舟山道中》：“～当年事，岁暮骚人不自聊。”"},"usage":"作宾语、定语；用于写作等","story":["传说唐朝时期，相国郑启虽然有诗人的名气，但在诗坛上名望不高。他想提高自己的声望，于是他骑着驴在雪天到灞桥去寻找灵感。有人问他最近的新诗，他回答说：“诗思在灞桥雪中驴子上，此处何以得之。”"]},{"id":48093,"word":"骑驴觅驴","pinyin":"qí lǘ mì lǘ","abbr":"qlml","explanation":"骑着驴去找别的驴。原比喻一面占着一个位置，一面去另找更称心的工作。现多比喻东西就在自己这里，还到处去找。","source":{"text":"诵经不不见有无义，真似骑驴更觅驴。","book":"宋·释道原《景德传灯录》卷二十八"},"example":{"text":"～但可笑，非马喻马亦成痴。","book":"宋·黄庭坚《寄黄龙清老》诗"},"similar":["骑马找马","骑牛觅牛"],"usage":"作谓语、定语、分句；用于人","story":["从前一个叫王三的人赶五头毛驴到集市上去卖，自己骑上一头。半路上他想数一下驴子，发现只有四只，心里犯疑惑，再次数还是四头。于是下来再数，五头毛驴全在。他这才恍然大悟，原来自己是骑驴找驴，把骑的那头给忘了"]},{"id":48094,"word":"骑驴风雪中","pinyin":"qí lǘ fēng xuě zhōng","abbr":"qlfxz","explanation":"用为苦吟的典故。同“骑驴索句”。"},{"id":48095,"word":"骑鹤上扬","pinyin":"qí hè shàng yáng","abbr":"qhsy","explanation":"比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同“骑鹤上扬州”。"},{"id":48096,"word":"骑鹤上扬州","pinyin":"qí hè shàng yáng zhōu","abbr":"qhsyz","explanation":"后因以比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。","source":{"text":"有客相从，各言所志，或愿为扬州刺史，或愿多赀财，或愿骑鹤上升。其一人曰：‘腰缠十万贯，骑鹤上扬州。’欲兼三者。","book":"南朝·梁·殷芸《小说·吴蜀人》"},"example":{"text":"但我还想加上一个总结，以醒醒你的～的梦。","book":"郁达夫《扬州旧梦寄语堂》"},"similar":["骑鹤望扬州","骑鹤上维扬"],"usage":"作宾语、定语；用于人妄想贪婪","story":["传说古代赵钱孙李四公子在扬州痩西湖畔饮酒谈志向，赵某说自己有幸结识朋友，但愿能混个扬州刺史。孙某则想骑上红顶白羽的仙鹤去琼楼玉宇渡余生。李某说要腰缠十万贯，骑上仙鹤去扬州赴任。众人戏他性急喝不得热粥"]},{"id":48097,"word":"骑鹤上维扬","pinyin":"qí hè shàng wéi yáng","abbr":"qhswy","explanation":"比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同“骑鹤上扬州”。","source":{"text":"许谁骑鹤上维扬，温柔和醉乡。","book":"宋·孙惟信《阮郎归》"},"similar":["骑鹤望扬州","骑鹤维扬"],"usage":"作宾语、定语；用于人妄想贪婪"},{"id":48098,"word":"骑鹤扬州","pinyin":"qí hè yáng zhōu","abbr":"qhyz","explanation":"比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同“骑鹤上扬州”。","source":{"text":"有客相从，各言所志，或原为扬州刺史，或原多赀财，或原骑鹤上升。其一人曰：‘腰缠十万贯，骑鹤上扬州。’欲兼三者。","book":"南朝·梁·殷芸《小说》卷六"},"example":{"text":"如今～去，莫问腰缠有几星。","book":"明·冯梦龙《醒世恒言》卷三十七"},"similar":["骑鹤上扬州"],"usage":"作宾语、定语；用于人妄想贪婪"},{"id":48099,"word":"骑鹤望扬州","pinyin":"qí hè wàng yáng zhōu","abbr":"qhwyz","explanation":"比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同“骑鹤上扬州”。","source":{"text":"更求名与利，骑鹤望扬州。","book":"元·张宇《和李子微村居》"},"similar":["骑鹤上扬州","骑鹤上维扬"],"usage":"作宾语、定语；用于人妄想贪婪"},{"id":48100,"word":"骑鹤维扬","pinyin":"qí hè wéi yáng","abbr":"qhwy","explanation":"比喻欲集做官、发财、成仙于一身，或形容贪婪、妄想。同“骑鹤上扬州”。","source":{"text":"腰钱骑鹤维扬，分表事谁能预测。","book":"宋·刘克庄《沁园春·七和林卿韵》"},"similar":["骑鹤上维扬","骑鹤扬州"],"usage":"作宾语、定语；用于人妄想贪婪"},{"id":48101,"word":"骑龙弄凤","pinyin":"qí lóng nòng fèng","abbr":"qlnf","explanation":"①比喻成仙。②比喻腾达。","source":{"text":"骑龙弄凤之兆，这有何妨。","book":"明·陈与郊《义犬》第一出"},"usage":"作宾语、定语；指成仙","story":["春秋时期，秦穆公嬴任好的女儿爱上善于吹箫的箫史，跟他学起吹箫。秦穆公成全了他们的爱情，同时为他们建立一座宫殿凤台。弄玉很快学会了吹箫，他们在凤台吹箫，引来了一只凤凰前来倾听，并伴着优美的乐声飞舞，凤凰把他们两人接上天去"]},{"id":48102,"word":"骖风驷霞","pinyin":"cēn fēng sì xiá","abbr":"cfsx","explanation":"指仙道者云游四方。","source":{"text":"公诚能高卧空山，远引遐微，则为巢、许、务、涓之徒可，为严陵、鲁连之徒亦可，虽欲骖风驷霞，诙诡变眩如偓佺、安期、羡门、卢敖、徐福之徒亦可。","book":"元·揭傒斯《与萧维斗书》"},"usage":"作谓语、定语；用于隐者"},{"id":48103,"word":"骖鸾驭鹤","pinyin":"cān luán yù hè","abbr":"clyh","explanation":"驾驭鸾凤仙鹤。比喻成仙。"},{"id":48104,"word":"骗口张舌","pinyin":"piàn kǒu zhāng shé","abbr":"pkzs","explanation":"搬弄唇舌。亦作“片口张舌”。","source":{"text":"听了你骗口张舌无大小，卖弄美貌妖娆。","book":"元·无名氏《马陵道》第四折：“你道是同心共胆，还待要骗口张舌，我只问你三回两歇，怎送的我二足双瘸。”明·无名氏《南牢记》第二折"},"example":{"text":"有那等先生，自夸自会，盗听偷学，诓言诈语，～，世俗人。","book":"明·无名氏《李云卿》第二折"},"similar":["搬嘴递舌"],"usage":"作谓语、宾语；指搬弄口舌"},{"id":48105,"word":"骗吃混喝","pinyin":"piàn chī hùn hē","abbr":"pchh","explanation":"欺骗别人以求吃喝。","example":{"text":"他从小就会～。"},"similar":["骗吃骗喝"],"usage":"作谓语、宾语、定语；指混吃喝"},{"id":48106,"word":"骚人墨士","pinyin":"sāo rén mò shì","abbr":"srms","explanation":"指诗人、作家等风雅的文人。同“骚人墨客”。","source":{"text":"人知浙江为东南形胜，而不知吴越之奇观，自一二客帆渔艇而外，未尝有横画舫于烟波，负奚囊于邱壑者，今世之骚人墨士，不过侈谈西湖耳。","book":"明·李介《天香阁随笔》卷一"},"similar":["骚人韵士","骚人逸客","骚人雅士"],"usage":"作宾语、定语；指文人"},{"id":48107,"word":"骚人墨客","pinyin":"sāo rén mò kè","abbr":"srmk","explanation":"骚人：屈原作《离骚》，因此称屈原或《楚辞》的作者为骚人。墨客：文人。指诗人、作家等风雅的文人。","source":{"text":"墨客降席，再拜稽首。","book":"唐·李白《古风》诗：“正声何微茫，哀怨起骚人。”汉·扬雄《长杨赋》"},"example":{"text":"或因写物创意而运思高妙，如～，登高而赋。","book":"《宣和画谱》卷十二"},"similar":["一介书生","文章巨公","文人雅士"],"opposite":["胸无点墨"],"usage":"作宾语、定语；指文人"},{"id":48108,"word":"骚人词客","pinyin":"sāo rén cí kè","abbr":"srck","explanation":"指诗人、作家等风雅的文人。同“骚人墨客”。","source":{"text":"永嘉山水，秀绝寰区，曩者亦骚人词客之所萃也。","book":"清·戴名世《〈巢青阁集〉序》"},"similar":["骚人墨客","骚人墨士","骚人雅士"],"usage":"作宾语、定语；指文人"},{"id":48109,"word":"骚人逸客","pinyin":"sāo rén yì kè","abbr":"sryk","explanation":"指诗人、作家等风雅的文人。同“骚人墨客”。","source":{"text":"湖山幽境，风月邀游，实骚人逸客之常情。","book":"清·百一居士《壶天录》卷上"},"similar":["骚人雅士","骚翁墨客","骚人墨客"],"usage":"作宾语、定语；指文人"},{"id":48110,"word":"骚人雅士","pinyin":"sāo rén yǎ shì","abbr":"srys","explanation":"指诗人、作家等风雅的文人。同“骚人墨客”。","source":{"text":"公园里的牡丹芍药，邀来骚人雅士，缓步徘徊，摇着名贵的纸扇。","book":"老舍《骆驼祥子》二四"},"similar":["骚翁墨客","骚人墨士","骚人逸客"],"usage":"作宾语、定语；指文人"},{"id":48111,"word":"骚情赋骨","pinyin":"sāo qíng fù gǔ","abbr":"sqfg","explanation":"指文人的情调与风骨。","source":{"text":"小生沈约字休文……天生就骚情赋骨，随他半幅纸、半点黑，当值千金。","book":"清·徐士俊《络冰丝》"},"usage":"作宾语、定语；用于书面语"},{"id":48112,"word":"骚翁墨客","pinyin":"sāo wēng mò kè","abbr":"swmk","explanation":"指诗人、作家等风雅的文人。同“骚人墨客”。","source":{"text":"元和至今，骚翁墨客，代不乏人。","book":"元·刘壎《隐居通议·诗歌一》"},"similar":["骚人逸客","骚人墨客","骚人词客"],"usage":"作宾语、定语；指文人"},{"id":48113,"word":"骤不及防","pinyin":"zhòu bù jí fáng","abbr":"zbjf","explanation":"指事情来得突然，使人不及防备。","source":{"text":"清军骤不及防，退之二道桥。","book":"杨玉如《辛亥革命先著记》第六章"},"example":{"text":"事情来得太突然，让我们～。"},"similar":["猝不及防"],"usage":"作谓语、状语；指突然"},{"id":48114,"word":"骤雨不终日","pinyin":"zhòu yǔ bù zhōng rì","abbr":"zybzr","explanation":"骤：急速。急雨不会下一天。比喻坏人坏事不会长久。","source":{"text":"故飘风不终朝，骤雨不终日。","book":"《老子》第二十三章"},"usage":"作宾语、定语；用于比喻句"},{"id":48115,"word":"骤雨暴风","pinyin":"zhòu yǔ bào fēng","abbr":"zybf","explanation":"来势急遽而猛烈的风雨。","source":{"text":"初六日壬辰，阴晴不定……入夜骤雨暴风一阵。","book":"清·张德彝《随使法国记·归途记》"},"similar":["暴风骤雨","骤雨狂风","骤风暴雨"],"usage":"作主语、宾语；用于书面语"},{"id":48116,"word":"骤雨狂风","pinyin":"zhòu yǔ kuáng fēng","abbr":"zykf","explanation":"来势急遽而猛烈的风雨。","source":{"text":"自谓得草书三昧……当时名流如李白、戴叔伦、窦臯、钱起之徒皆有诗美之。状其势以谓若惊蛇走虺，骤雨狂风。","book":"《宣和书谱·释怀素》"},"example":{"text":"～随地卷，奔雷掣电走天神。","book":"《大唐秦王词话》第四十回"},"similar":["骤雨暴风","骤风暴雨","暴风骤雨"],"usage":"作主语、宾语；用于书面语"},{"id":48117,"word":"骤风急雨","pinyin":"zhòu fēng jí yǔ","abbr":"zfjy","explanation":"来势急遽而猛烈的风雨。同“骤雨狂风”。","source":{"text":"夏山雨过，浓云欲雨，骤风急雨，又曰飘风急雨。","book":"宋·郭熙淳《林泉高致·画诀》"},"example":{"text":"我看，虏骑行军甚疾，常如～，恐怕你们想助我一臂之力已经来不及了。","book":"姚雪垠《李自成》第一卷第二十三章"}},{"id":48118,"word":"骤风暴雨","pinyin":"zhòu fēng bào yǔ","abbr":"zfby","explanation":"来势急遽而猛烈的风雨。","source":{"text":"众人都担心这时正是下雷雨的节令，猛不防来一阵骤风暴雨，人们藏在地洞里难免遭水淹。","book":"柳青《铜墙铁壁》第八章"},"similar":["骤雨狂风","暴风骤雨","骤雨暴风"],"usage":"作主语、宾语；用于书面语"},{"id":48119,"word":"骥伏盐车","pinyin":"jì fú yán chē","abbr":"jfyc","explanation":"骥：千里马。指才华遭到抑制，处境困厄。","source":{"text":"夫骥之齿至矣，服盐车而上太行。","book":"西汉·刘向《战国策·楚策四》"},"example":{"text":"争奈尘埋，未逢鉴识，譬之剑沉丰狱，～。","book":"明·吾邱瑞《运甓记·辞亲赴任》"},"similar":["怀才不遇"],"opposite":["将遇良才"],"usage":"作宾语、定语；指怀才不遇","story":["有一匹千里马因为落在一个无能无知的主人手中，每天只能拉车与驮载重物，不能发挥他的专长，慢慢地衰老下去。碰巧在拉盐车的时候碰上了伯乐。伯乐花钱买下他，并经过精心喂养，半年后就成为真正的千里马"]},{"id":48120,"word":"骥子龙文","pinyin":"jì zǐ lóng wén","abbr":"jzlw","explanation":"骥子：千里马；龙文：骏马名，旧时多指神童。原为佳子弟的代称。后多比喻英才。","source":{"text":"延俊从父兄宣明二子景鸾、景鸿，并有逸才，河东呼景鸾为骥子，景鸿为龙文。","book":"《北史·裴延俊传》"},"usage":"作宾语、定语；比喻栋梁之才"},{"id":48121,"word":"骥服盐车","pinyin":"jì fú yán chē","abbr":"jfyc","explanation":"骥：骏马；服：驾驭。让骏马驾盐车。比喻使用人才不当。","source":{"text":"夫骥之齿至矣，服盐车而上大行，蹄申膝折，尾湛胕溃，漉法洒地，白汗交流，中阪迁延，负辕不能上。","book":"《战国策·楚策六》"},"example":{"text":"～不称情，轻裘肥马凤凰城。","book":"宋·黄庭坚《次韵晁补之廖正一赠答诗》"},"similar":["骥伏盐车"],"usage":"作宾语、定语；指怀才不遇"},{"id":48122,"word":"骨化形销","pinyin":"gǔ huà xíng xiāo","abbr":"ghxx","explanation":"指死亡。","source":{"text":"则当骨化形销，丹诚不泯，因风委露，犹托清尘。","book":"唐·元稹《莺莺传》"},"example":{"text":"只恨浮生短，忆当年邓尉（谓石瞿），～。","book":"《艺风堂友朋书札·刘炳照〈致缪荃孙〉（十二）》"},"usage":"作谓语、宾语；指死亡"},{"id":48123,"word":"骨化风成","pinyin":"gǔ huà fēng chéng","abbr":"ghfc","explanation":"指人的性情气质受感染而变化，一种新的社会风气已经形成。","source":{"text":"元既有江南，以豪侈粗戾，变礼文之俗，专数十年，薰渍狃狎，骨化风成，而宋之遗习，消灭尽矣。","book":"明·方孝孺《俞先生墓表》"},"usage":"作谓语、定语；用于风俗习惯等"},{"id":48124,"word":"骨寒毛竖","pinyin":"gǔ hán máo shù","abbr":"ghms","explanation":"形容十分害怕。","source":{"text":"后人书之，留传万代，可为骨寒毛竖也。","book":"北齐·颜之推《颜氏家训·名实》"},"example":{"text":"他被吓得～"},"similar":["毛骨悚然"],"usage":"作谓语、状语；指人害怕"},{"id":48125,"word":"骨瘦如柴","pinyin":"gǔ shòu rú chái","abbr":"gsrc","explanation":"形容消瘦到极点。","source":{"text":"瘦如豺。豺，柴也。豺体瘦，故谓之豺。","book":"宋·陆佃《埤雅·释兽》"},"example":{"text":"刘姥姥看着凤姐～，神情恍惚，心里也就悲惨起来。","book":"清·曹雪芹《红楼梦》第一一三回"},"similar":["瘦小枯干","骨瘦如豺"],"opposite":["肥头大耳","脑满肠肥"],"usage":"作谓语、定语、补语；形容极其消瘦"},{"id":48126,"word":"骨瘦如豺","pinyin":"gǔ shòu rú chái","abbr":"gsrc","explanation":"形容消瘦到极点。同“骨瘦如柴”。","source":{"text":"又曰：瘦如豺。豺，柴也。豺体细瘦，故谓之豺。","book":"《埤雅·释兽》"},"example":{"text":"腾咬看那章匪～。","book":"《荡寇志》第一○三回"},"similar":["骨瘦如柴","骨瘦形销"],"usage":"作谓语、定语、状语；形容极其消瘦"},{"id":48127,"word":"骨瘦形销","pinyin":"gǔ shòu xíng xiāo","abbr":"gsxx","explanation":"形容瘦削到极点。","source":{"text":"而芸终以受愚为恨，血疾大发，床席支离，刀圭无效，时发时止，骨瘦形销。","book":"清·沈复《浮生六记·坎坷记愁》"},"example":{"text":"清·李百川《绿野仙踪》第89回：“这几天将小儿迷乱的神魂颠倒，～。”"},"similar":["骨瘦如柴"],"usage":"作谓语、定语、状语；形容极其消瘦"},{"id":48128,"word":"骨肉之亲","pinyin":"gǔ ròu zhī qīn","abbr":"grzq","explanation":"骨肉：骨和肉，比喻至亲；亲：亲爱。比喻父母、兄弟、子女之间相亲相爱的关系。","source":{"text":"千不念万不念要念舅父，伊和娘亲姐弟骨肉之亲。","book":"闽剧《钗头凤》"},"similar":["骨肉相亲"],"usage":"作宾语；用于至亲等"},{"id":48129,"word":"骨肉之恩","pinyin":"gǔ ròu zhī ēn","abbr":"grze","explanation":"像骨头和肉那样亲密的的恩情。指亲人间的深厚感情。","source":{"text":"孤亦何不待卿以骨肉之情恩，委卿以兵马之重乎？","book":"明·罗贯中《三国演义》第六十八回"},"similar":["骨肉之情","骨肉私情"],"usage":"作主语、宾语；用于至亲"},{"id":48130,"word":"骨肉之情","pinyin":"gǔ ròu zhī qíng","abbr":"grzq","explanation":"情：感情，情谊。像骨头和肉那样亲密的的情谊。指亲人间的深厚感情。","source":{"text":"孤亦何不待卿以骨肉之情恩，委卿以兵马之重乎？","book":"明·罗贯中《三国演义》第六十八回"},"example":{"text":"介甫每言及～，酸恻鸣咽。","book":"清·刘熙载《艺概·文概》"},"similar":["骨肉私情","骨肉之恩"],"usage":"作主语、宾语；指至亲"},{"id":48131,"word":"骨肉分离","pinyin":"gǔ ròu fēn lí","abbr":"grfl","explanation":"骨肉：指父母兄弟等亲人。比喻亲人分散，不能团聚。","source":{"text":"害得我骨肉分离，死无葬身之地，我好苦也！我好恨也！","book":"明·冯梦龙《警世通言》第30卷"},"example":{"text":"谈起的时候也是叹气流泪，恨透了秦始皇，说他无缘无故筑什么万里长城，害得人家～。","book":"《孟姜女》"},"similar":["骨肉离散"],"opposite":["骨肉团聚"],"usage":"作谓语、宾语、定语；比喻亲人分散"},{"id":48132,"word":"骨肉团圆","pinyin":"gǔ ròu tuán yuán","abbr":"grty","explanation":"骨肉：比喻父母兄弟子女等亲人。指亲人离而复聚。","source":{"text":"待他长大成人后，须教骨肉再团圆。","book":"元·无名氏《合同文字》第一折"},"example":{"text":"哥哥嫂嫂此番幸遇唐伯伯，我们方能～。","book":"清·李汝珍《镜花缘》第五十六回"},"similar":["骨肉团圞"],"opposite":["骨肉离散"],"usage":"作谓语、宾语；指亲人离而复聚"},{"id":48133,"word":"骨肉团圞","pinyin":"gǔ ròu tuán luán","abbr":"grtl","explanation":"骨肉：比喻父母兄弟子女等亲人。指亲人离而复聚。","source":{"text":"骨肉团圞乐正浓，一封丹诏实相从，恩承淑女荣非愿，割爱双亲恨怎穷。","book":"明·谢谠《四喜记·琼英入宫》"},"similar":["骨肉团圆"],"opposite":["骨肉分离"],"usage":"作谓语、宾语；指亲人离而复聚"},{"id":48134,"word":"骨肉未寒","pinyin":"gǔ ròu wèi hán","abbr":"grwh","explanation":"寒：变冷。骨肉尚未冷透。指人刚死不久。","source":{"text":"晁天王临死时嘱咐：‘如有人捉得史文恭者，便立为梁山泊主。’此话众头领皆知。今骨肉未寒，岂可忘了？","book":"明·施耐庵《水浒全传》第六十回"},"example":{"text":"中年丧妻，大不幸也。～，安忍便议亲。","book":"明·罗贯中《三国演义》第五十四回"},"similar":["尸骨未寒"],"usage":"作宾语、定语；指人刚死不久"},{"id":48135,"word":"骨肉相亲","pinyin":"gǔ ròu xiāng qīn","abbr":"grxq","explanation":"骨肉：骨和肉，比喻至亲；亲：亲爱。比喻父母、兄弟、子女之间相亲相爱的关系。","source":{"text":"兄弟相戚，骨肉相亲。","book":"春秋·齐·管仲《管子·轻重》"},"similar":["骨肉之亲"],"usage":"作谓语、宾语；用于至亲等"},{"id":48136,"word":"骨肉相残","pinyin":"gǔ ròu xiāng cán","abbr":"grxc","explanation":"亲人间相互残杀。比喻自相残杀。","source":{"text":"仲弓曰：‘盗杀财主，何如骨肉相残？’","book":"南朝·宋·刘义庆《世说新语·政事》"},"example":{"text":"家门不幸，～，诚有愧于邻国。","book":"明·冯梦龙《东周列国志》第五回"},"similar":["自相残杀"],"usage":"作谓语；比喻自相残杀"},{"id":48137,"word":"骨肉相连","pinyin":"gǔ ròu xiāng lián","abbr":"grxl","explanation":"象骨头和肉一样互相连接着。比喻关系非常密切，不可分离。","source":{"text":"故桓公推仁立义，功臣之家，兄弟相戚，骨肉相亲，国无饥民。","book":"《管子·轻重丁》"},"example":{"text":"中国人民解放军是人民的子弟兵，和人民～。"},"similar":["血肉相连","血脉相连"],"opposite":["众叛亲离","背信弃义"],"usage":"作谓语、定语；形容关系密切"},{"id":48138,"word":"骨肉离散","pinyin":"gǔ ròu lí sàn","abbr":"grls","explanation":"骨肉：指父母兄弟子女等亲人。比喻亲人分散，不能团聚。","source":{"text":"《杕杜》刺时也。君不能亲其宗族，骨肉离散，独居而无兄弟，将为沃所并尔。","book":"《诗经·唐风·杕杜》小序"},"example":{"text":"“冲风夺佳气”，～也。","book":"清·无名氏《杜诗言志》卷八"},"similar":["妻离子散","家破人亡","骨肉分离"],"opposite":["骨肉团圆"],"usage":"作宾语、定语；比喻亲人分散"},{"id":48139,"word":"骨肉私情","pinyin":"gǔ ròu sī qíng","abbr":"grsq","explanation":"骨肉：指父母兄弟子女等亲人关系。比喻至亲之间的深厚感情。","source":{"text":"不妨启请内廷銮舆入其私第，庶可尽骨肉私情，共享天伦之乐事。","book":"清·曹雪芹《红楼梦》第16回"},"similar":["骨肉之情","骨肉之恩"],"usage":"作主语、宾语；用于至亲"},{"id":48140,"word":"骨肉至亲","pinyin":"gǔ ròu zhì qīn","abbr":"grzq","explanation":"指关系最密切的亲属。","source":{"text":"不如还我，我与汝是骨肉至亲，，岂与仇等。","book":"《三国志·魏书·鲜卑传》"},"example":{"text":"萧队长又说，贫雇是农是～，我才敢说话。","book":"孙立波《暴风骤雨》二十五"},"similar":["至亲骨肉"],"usage":"作宾语、定语；指亲人"},{"id":48141,"word":"骨腾肉飞","pinyin":"gǔ téng ròu fēi","abbr":"gtrf","explanation":"腾：跳跃。形容奔弛迅速。也形容神魂飘荡。","source":{"text":"走追奔兽，手接飞鸟，骨腾肉飞，拊膝数百里。","book":"汉·赵晔《吴越春秋·阖闾内传》"},"example":{"text":"庆忌～，走逾奔马，矫捷如神，万无莫当。","book":"明·冯梦龙《东周列国志》第七十四回"},"similar":["神魂颠倒"],"usage":"作谓语、状语；形容神魂颠倒"},{"id":48142,"word":"骨软筋酥","pinyin":"gǔ ruǎn jīn sū","abbr":"grjs","explanation":"骨头软了，肉也麻了。形容全身乏力，肢体瘫软的样子。","source":{"text":"那老魔闻得此言，吓得魂飞魄散，骨软筋麻，扑的跌倒在地。","book":"明·吴承恩《西游记》第三十五回"},"example":{"text":"贾环见了父亲，唬得～，忙低头站住。","book":"清·曹雪芹《红楼梦》第三十三回"},"similar":["骨软肉酥"],"usage":"作谓语、定语、状语；形容极其害怕"},{"id":48143,"word":"骨软筋麻","pinyin":"gǔ ruǎn jīn má","abbr":"grjm","explanation":"①形容精疲力尽的样子。②形容极其害怕的样子。","source":{"text":"众臣悚惧，骨软筋麻。战战兢兢，痴痴痖痖。","book":"明·凌濛初《二刻拍案惊奇》卷五：“王吉心慌撩乱，将身子尽力挨出，挨得骨软筋麻，才到得稀松之处。”明·吴承恩《西游记》第十一回"},"example":{"text":"警备队一听，吓得～，暗暗说道：‘碰上老八路了，快跑吧！’","book":"马烽 西戎《吕梁英雄传》第九回"},"similar":["骨软肉酥","骨软筋酥"],"usage":"作谓语、定语、状语；形容极其害怕"},{"id":48144,"word":"骨软肉酥","pinyin":"gǔ ruǎn ròu sū","abbr":"grrs","explanation":"形容全身乏力，肢体瘫软的样子。同“骨软筋酥”。","source":{"text":"只消‘心月狐’放一个屁，那‘井木犴’俯伏在地，骨软肉酥。","book":"《醒世姻缘传》第六一回"},"similar":["骨软筋酥"],"usage":"作谓语、定语、状语；形容极其害怕"},{"id":48145,"word":"骨颤肉惊","pinyin":"gǔ chàn ròu jīng","abbr":"gcrj","explanation":"形容惊恐万分。","source":{"text":"却说王甫在麦城中，骨颤肉惊，乃问周仓曰：‘昨夜梦见主公深奥血污……不知主何吉凶？’","book":"明·罗贯中《三国演义》第七十七回"},"usage":"作谓语、状语；指惊恐"},{"id":48146,"word":"骨鲠之臣","pinyin":"gǔ gěng zhī chén","abbr":"ggzc","explanation":"骨鲠：比喻刚直。刚正忠直的官员。","source":{"text":"方今吴外困于楚，而内无骨鲠之臣，是无如我何！","book":"《史记·刺客列传》"},"example":{"text":"君虽圣，必赖贤臣以调燮之。近虽有二三～，位卑禄薄，信任未专。","book":"《清史稿·李栖凤传》"},"usage":"作宾语；指正直的官员","story":["宋朝时期，鲁宗道参知政事，立朝刚正，嫉恶若仇，敢于直谏，对奸臣丝毫不留情面。权贵们因此纷纷害怕他，因他姓鲁，跟鱼字相近，因此说他是鱼头参政（刺多，难对付）。百姓则称他为“骨鲠之臣”"]},{"id":48147,"word":"骨鲠在喉","pinyin":"gǔ gěng zài hóu","abbr":"ggzh","explanation":"鲠：鱼刺。鱼骨头卡在喉咙里。比喻心里有话没有说出来，非常难受。","source":{"text":"韦曰：‘骨所以鲠，刺人也。’忠言逆耳，如食骨在喉，故云骨鲠之臣。《汉书》以下皆作骨鲠，字从鱼，谓留咽者鱼骨较多也。","book":"汉·许慎《说文解字》：“鲠，食骨留咽中也。”段玉裁注"},"example":{"text":"但近来作文，避忌已甚，有时如～，不得不吐，遂亦不免为人所憎。","book":"《鲁迅书信集·致黎烈文》"},"similar":["心直口快","直抒己见"],"usage":"作宾语、定语；与“若”、“如”连用"},{"id":48148,"word":"髀肉复生","pinyin":"bì ròu fù shēng","abbr":"brfs","explanation":"髀：大腿。因为长久不骑马，大腿上的肉又长起来了。形容长久过着安逸舒适的生活，无所作为。","source":{"text":"备曰：‘吾常身不离鞍，髀肉皆消；今不复骑，髀里肉生。’","book":"《三国志·蜀书·先主传》裴松之注引晋·司马彪《九州春秋》"},"example":{"text":"因见己身～，亦不觉潸然泪下。","book":"明·罗贯中《三国演义》第三十回"},"similar":["髀里肉生"],"usage":"作谓语、定语；形容虚度时光","story":["东汉末年，刘备在与曹操作战中丢失了地盘，就去投奔刘表。刘表设酒宴安慰他。席间两人谈得甚欢，刘备入厕摸自己的髀，发现上面的肉又长了起来，回座后不禁感慨，这样下去，光复汉室何时才能成功？刘表就送他地盘与军队"]},{"id":48149,"word":"髀里肉生","pinyin":"bì lǐ ròu shēng","abbr":"blrs","explanation":"髀：大腿。因为长久不骑马，大腿上的肉又长起来了。形容长久过着安逸舒适的生活，无所作为。","source":{"text":"备曰：‘吾常身不离鞍，髀肉皆消；今不复骑，髀里肉生。’","book":"《三国志·蜀书·先主传》裴松之注引晋·司马彪《九州春秋》"},"similar":["髀肉复生"],"usage":"作谓语、定语；形容虚度时光","story":["东汉末年，刘备在与曹操作战中丢失了地盘，就去投奔刘表。刘表设酒宴安慰他。席间两人谈得甚欢，刘备入厕摸自己的髀，发现上面的肉又长了起来，回座后不禁感慨，这样下去，光复汉室何时才能成功？刘表就送他地盘与军队"]},{"id":48150,"word":"高下任心","pinyin":"gāo xià rèn xīn","abbr":"gxrx","explanation":"形容能胸有成竹地处理事情。同“高下在心”。","source":{"text":"进人退士，高下任心，奸狡饕餮，未有隗（刘隗）比。","book":"《晋书·王敦传》"},"similar":["高下在心"],"usage":"作谓语；形容能胸有成竹地行事"},{"id":48151,"word":"高下其手","pinyin":"gāo xià qí shǒu","abbr":"gxqs","explanation":"犹言上下其手。比喻玩弄手法，串通做弊。","source":{"text":"五代以来，诸州马步军虞侯以衙校为之，太祖虑其任私，高下其手，乃置司寇参军，以进士、‘九经’及第人充之。","book":"宋·王辟之《渑水燕谈录·官制》"},"example":{"text":"相君纵欲市恩，而即此两端，已不得不～。","book":"清·和邦额《夜谭随录·某太守》"},"similar":["上下其手"],"usage":"作谓语、定语、宾语；用于处事"},{"id":48152,"word":"高下在口","pinyin":"gāo xià zài kǒu","abbr":"gxzk","explanation":"犹言信口雌黄。","source":{"text":"三班吏丛猥，老胥抱文书升堂取判者，皆高下在口，异时长官漫不省察，谨占署而已。","book":"《续资治通鉴·宋仁宗皇祐三年》"},"similar":["信口雌黄"],"usage":"作谓语、定语；用于人说话"},{"id":48153,"word":"高下在心","pinyin":"gāo xià zài xīn","abbr":"gxzx","explanation":"高下：比喻伸和屈。原意是做事要斟酌情况，采取适当办法。后形容能胸有成竹地处理事情。","source":{"text":"天方授楚，未可与争，虽晋之强，能违天乎？谚曰：高下在心。","book":"《左传·宣公十五年》"},"example":{"text":"今将军仗皇威，掌兵要，龙骧虎步，～，若欲诛宦官，如鼓洪炉燎毛发耳。","book":"明·罗贯中《三国演义》第二回"},"similar":["高下任心"],"usage":"作谓语；形容能胸有成竹地行事","story":["公元前594年，楚庄王率军攻打宋国。宋国派乐婴齐去晋国求救。晋景公看不惯楚国的恃强欺弱，准备出兵救宋。大夫伯宗认为晋国是鞭长莫及，他说：“谚曰‘高下在心’。川泽纳污，山薮藏疾，瑾瑜匿瑕，国君含垢，天之道也。”"]},{"id":48154,"word":"高下在手","pinyin":"gāo xià zài shǒu","abbr":"gxzs","explanation":"犹言上下其手。比喻玩弄手法，串通做弊。同“高下其手”。","source":{"text":"同列或二心二意，高下在手，必正色力争，宁亟去，无苟徇，亦以此见排于俗。","book":"宋·叶適《观文殿学士知枢密院事陈公文集序》"},"similar":["高下其手"],"usage":"作谓语、定语、宾语；用于处事"},{"id":48155,"word":"高不凑低不就","pinyin":"gāo bù còu dī bù jiù","abbr":"gbcdbj","explanation":"犹言高不成低不就。","source":{"text":"其间也就说过几家亲事，高不凑低不就，一家也不曾成得。","book":"《初刻拍案惊奇》卷九"},"example":{"text":"[丑]问：我偌大这个身子，却缘何～，落落度度的。先生，你看我该作什么勾当，拣什么最便宜与我做工？","book":"明·陈与郊《义犬》第一出"}},{"id":48156,"word":"高不凑，低不就","pinyin":"gāo bù còu，dī bù jiù","abbr":"gbcdbj","explanation":"就：成。高者无力得到，低者又不屑迁就。形容求职或婚姻上的两难处境。","source":{"text":"高不凑，低不就，打从帮闲的，处馆的两项人见了他，也就做鬼脸，把‘倒运’两字笑他，不在话下。","book":"明·凌濛初《初刻拍案惊奇》第一卷"},"similar":["高不辏，低不就"],"usage":"作谓语、宾语、定语；形容进退两难处境"},{"id":48157,"word":"高不可攀","pinyin":"gāo bù kě pān","abbr":"gbkp","explanation":"攀：抓住高处的东西向上爬。高得手也攀不到。形容难以达到。也形容人高高在上，使人难接近。","source":{"text":"高者难攀，卑者易陵，理势然也。","book":"汉·贾谊《陈政事疏·治安策》"},"example":{"text":"我们反对把创作说得～，但也反对把它说成不须付出心血就轻而易举地可以做到。","book":"茅盾《创作问题漫谈》"},"similar":["高不可登","高不可及"],"opposite":["平易近人"],"usage":"作谓语、定语、补语；形容很难达到"},{"id":48158,"word":"高不可登","pinyin":"gāo bù kě dēng","abbr":"gbkd","explanation":"形容难以达到。也形容人高高在上，使人难接近。同“高不可攀”。","source":{"text":"且夫墨子之守，萦带为垣，高不可登。","book":"汉·陈淋《为曹洪与魏文帝书》"},"similar":["高不可攀"],"usage":"作谓语、定语、补语；形容很难达到"},{"id":48159,"word":"高不成低不就","pinyin":"gāo bù chéng dī bù jiù","abbr":"gbcdbj","explanation":"高者无力得到，低者又不屑迁就。形容求职或婚姻上的两难处境。","source":{"text":"起倒不供聊应俗，高低莫可只随缘。","book":"宋·陈师道《宿柴城》诗"},"example":{"text":"其实我也早留心了，不过总是～的。","book":"冰心《冬儿姑娘》"}},{"id":48160,"word":"高不成，低不就","pinyin":"gāo bù chéng，dī bù jiù","abbr":"gbcdbj","explanation":"高而合意的，做不到或得不到；做得了、能得到的，又认为低而不肯做或不肯要（多指选择工作或配偶）。","source":{"text":"起倒不供聊应俗，高低莫可只随缘。","book":"宋·陈师道《宿柴城》诗"},"example":{"text":"那边顺娘却也红鸾不照，天喜未临，～，也不曾许得人家。","book":"明·冯梦龙《警世通言》卷二十三"},"similar":["高低不就","高不凑，低不就"],"usage":"作谓语、分句；形容进退两难处境"},{"id":48161,"word":"高不辏低不就","pinyin":"gāo bù còu dī bù jiù","abbr":"gbcdbj","explanation":"犹言高不成低不就。","source":{"text":"所以高不辏低不就，那些做工媒的见这两个老人家难理会，也有好些不耐火烦，所以亲事越迟了。","book":"《初刻拍案惊奇》卷二四"}},{"id":48162,"word":"高不辏，低不就","pinyin":"gāo bù còu，dī bù jiù","abbr":"gbcdbj","explanation":"就：成。高者无力得到，低者又不屑迁就。形容求职或婚姻上的两难处境。","source":{"text":"所以高不辏，低不就，那些做媒的，见这两个老人家难理会，也有好些不耐烦，所以亲事越迟了。","book":"明·凌濛初《初刻拍案惊奇》第24卷"},"similar":["高不凑，低不就"],"usage":"作谓语、宾语、定语；形容进退两难处境"},{"id":48163,"word":"高世之主","pinyin":"gāo shì zhī zhǔ","abbr":"gszz","explanation":"高世：超越当世的人；主：君主。世上最好的君主。","source":{"text":"高世之主，不尚尤物，故能正天下之俗，刑四方之尺。","book":"《晋书·江统传》"}},{"id":48164,"word":"高世之度","pinyin":"gāo shì zhī dù","abbr":"gszd","explanation":"高世：超出世人；度：气度，度量。具有超出世人的气度。","source":{"text":"时司徒袁粲，有高士之度，脱落尘俗。","book":"南朝·梁·任昉《王文宪集序》"}},{"id":48165,"word":"高世之德","pinyin":"gāo shì zhī dé","abbr":"gszd","explanation":"高世：超出世人；德：品德。具有超出一般人的德行。形容德行非常高尚。","source":{"text":"明公以高士之德，遭阳九之会。","book":"《三国志·魏志·司马朗传》"}},{"id":48166,"word":"高世之才","pinyin":"gāo shì zhī cái","abbr":"gszc","explanation":"高世：超出世人；才：才能。具有超出一般人的才干或才干超群的人。","source":{"text":"《易》曰：‘有高世之才，必有负俗之累；有至智之明者，必破庶众之议。’","book":"汉·袁康《越绝书·越绝外传记·范伯》"},"usage":"作主语、宾语；用于书面语"},{"id":48167,"word":"高世之智","pinyin":"gāo shì zhī zhì","abbr":"gszz","explanation":"高世：超过世人；智：智慧，才智。具有超出世人的才智。形容才智非凡。","source":{"text":"虽有绝伦之力，高世之智……","book":"《资治通鉴·周纪·威王二十三年》"},"usage":"作主语、宾语；用于书面语"},{"id":48168,"word":"高世之行","pinyin":"gāo shì zhī xíng","abbr":"gszx","explanation":"高世：超出尘俗；行：行为，德行。具有超出一般世人的德行。","source":{"text":"且陛下有高世之行者三，此不足以毁名。","book":"《史记·袁盎晁错列传》"},"usage":"作主语、宾语；用于书面语"},{"id":48169,"word":"高世骇俗","pinyin":"gāo shì hài sú","abbr":"gshs","explanation":"高世：超出世人；骇：惊吓，震惊。具有令一般人吃惊的才能。比喻才智超群。"},{"id":48170,"word":"高业弟子","pinyin":"gāo yè dì zǐ","abbr":"gydz","explanation":"高业：高才，对别人学生的敬称。学业优异的学生。","source":{"text":"马融门徒四百余人，升堂进者五十余生，融素骄贵，玄在门下三年，不得见，乃使高业弟子传授于玄。","book":"《后汉书·郑玄传》"},"similar":["高足弟子"],"usage":"作宾语；指成绩优异的学生"},{"id":48171,"word":"高举深藏","pinyin":"gāo jǔ shēn cáng","abbr":"gjsc","explanation":"高高地举起，深深地躲藏。指避世隐居。","source":{"text":"者莫他高举深藏，你看我驾天风定然赶上，则好去深渊中躲避灾殃。","book":"明·无名氏《拔宅飞升》第三折"},"usage":"作谓语、宾语；指人的行为"},{"id":48172,"word":"高举远去","pinyin":"gāo jǔ yuǎn qù","abbr":"gjyq","explanation":"意为隐居避世。","source":{"text":"阁下居长安，统于二人，不能明白立功名，将高举远去以自异。","book":"宋·苏舜钦《上范希文书》"},"similar":["高举远引","高蹈远引","高蹈远举"],"usage":"作谓语、宾语、定语；指退隐"},{"id":48173,"word":"高举远蹈","pinyin":"gāo jǔ yuǎn dǎo","abbr":"gjyd","explanation":"举：起飞；蹈：踩上。指远离官场，隐居起来。","source":{"text":"唯其高举远蹈，不受世纷，而至于躬耕乞食，其忠义亦足见矣。","book":"宋·胡仔《苕溪渔隐丛话前集·五柳先生上》"},"similar":["高蹈远举","高蹈远引"],"usage":"作谓语、宾语；指退隐"},{"id":48174,"word":"高义薄云","pinyin":"gāo yì bó yún","abbr":"gyby","explanation":"薄：迫近。原指文章表达的内容很有意义。后形容人很讲义气。","source":{"text":"英辞润金石，高义薄云天。","book":"《宋书·谢灵运传论》"},"example":{"text":"逾数日得君遂手书，并墨银三百元，资助讼费，～，感激无量。","book":"章炳麟《狱中与吴君遂、张伯纯书》"},"similar":["义薄云天"],"usage":"作谓语、补语；形容人很讲义气"},{"id":48175,"word":"高义薄云天","pinyin":"gāo yì báo yún tiān","abbr":"gybyt","explanation":"原指文章表达的内容很有意义。后形容人很讲义气。同“高义薄云”。","source":{"text":"英辞润金石，高义薄云天。","book":"《宋书·谢灵运传论》"},"example":{"text":"某官淡交如水，～。","book":"宋·魏了翁《回生日启》"},"similar":["高义薄云"],"usage":"作谓语、补语；形容人很讲义气"},{"id":48176,"word":"高亭大榭","pinyin":"gāo tíng dà xiè","abbr":"gtdx","explanation":"榭：建筑在高台上的房屋。指园林中供休息和四周景观的高大建筑物。","source":{"text":"非以高台厚榭邃野之居以为不安也。","book":"《墨子·非乐上》"},"similar":["高台厚榭"],"usage":"作主语、宾语、定语；用于建筑"},{"id":48177,"word":"高人一着","pinyin":"gāo rén yī zhāo","abbr":"gryz","explanation":"着：下棋时走一步。指比其他人高明一点。","source":{"text":"这两人会托外国人递条子，他的见解已经高人一着。","book":"清·李宝嘉《官场现形记》第56回"},"example":{"text":"梁公卓见，的是～。","book":"蔡东藩《民国通俗演义》第47回"},"usage":"作谓语、定语、宾语；用于口语"},{"id":48178,"word":"高人一等","pinyin":"gāo rén yī děng","abbr":"gryd","explanation":"比别人高出一个等级。指高过一般人。","source":{"text":"献子加于人一等矣。","book":"《礼记·檀弓上》"},"example":{"text":"我们只有使自己操练得～，才有战略胜利的可能。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["高人一筹","出人头地"],"opposite":["低人一等","低三下四"],"usage":"作补语、定语；指高过一般人"},{"id":48179,"word":"高人一筹","pinyin":"gāo rén yī chóu","abbr":"gryc","explanation":"高人：比一般人高；筹：筹码。比一般人高出一个筹码。指胜过别人。","source":{"text":"圹志、子建云亦似。但千古哭声未尝不同，何论前世有屈原，贾生耶？以发吾之愤愤而已！钦甫云：更似高人一筹也。","book":"明·归有光《震川集·别集·七·与沈敬甫七首》"},"example":{"text":"钱宁《圣人》第16章：“好在他立着矮人一头，行事～。”"},"similar":["胜人一筹"],"usage":"作谓语、定语；指胜过别人"},{"id":48180,"word":"高人胜士","pinyin":"gāo rén shèng shì","abbr":"grss","explanation":"高人：志趣、行为高尚的人；胜士：指隐居者。清高不慕名利的隐居者。","source":{"text":"梁君去年尝游庐阜，其谈山水之胜，诵高人逸士之文，亹亹不倦。","book":"宋·陆九渊《黄氏墓志铭》"},"example":{"text":"或有逸品，皆～寄兴寓意者，当求之笔墨之外，方为得趣。","book":"元·夏文彦《图绘宝鉴·制作楷模》"},"similar":["高人逸士"],"usage":"作宾语、定语；指人品清高脱俗"},{"id":48181,"word":"高人逸士","pinyin":"gāo rén yì shì","abbr":"grys","explanation":"逸：隐逸。指人品清高脱俗，不贪慕虚名利禄的人。","source":{"text":"梁君去年尝游庐阜，其谈山水之胜，诵高人逸士之文。","book":"宋·陆九渊《黄氏墓志铭》"},"example":{"text":"～之流风余韵，可以廉顽而立懦者。","book":"清·方宗诚《序》"},"similar":["高人胜士"],"usage":"作宾语、定语；指人品清高脱俗"},{"id":48182,"word":"高人雅士","pinyin":"gāo rén yǎ shì","abbr":"grys","explanation":"高人：志趣、行为高尚的人，多指隐士；雅：风雅，儒雅。志行高尚、风格儒雅的人。","source":{"text":"梁君去年尝游庐阜，其谈山水之胜，诵高人逸士之文，亹亹不倦。","book":"宋·陆九渊《黄氏墓志铭》"},"example":{"text":"他就是人们常说的～。"},"similar":["高人逸士"],"usage":"作宾语、定语；多指隐士"},{"id":48183,"word":"高人雅志","pinyin":"gāo rén yǎ zhì","abbr":"gryz","explanation":"高人：志行高尚的人，多指隐士；雅：风雅、儒雅。志行高尚，风格儒雅的人。","source":{"text":"耽山玩水，此是高人雅志。","book":"明·周楫《西湖二集·宿宫嫔情殢新人》"}},{"id":48184,"word":"高人雅致","pinyin":"gāo rén yǎ zhì","abbr":"gryz","explanation":"雅致：高雅的情趣。指品格高尚之人的优雅情趣。","source":{"text":"耽山玩水，此是高人雅致。","book":"明·周楫《西湖二集·宿宫嫔情滞新人》"},"usage":"作宾语、定语；用于书面语"},{"id":48185,"word":"高位厚禄","pinyin":"gāo wèi hòu lù","abbr":"gwhl","explanation":"位：官职，官位；禄：俸禄。官职高贵，俸禄丰厚。","source":{"text":"郡县礼清，终不回顾，高位厚禄，固不动心。","book":"汉·无名氏《玄儒先生娄寿碑》"},"example":{"text":"何必～，役人以自奉养。","book":"宋·苏舜钦《答韩持国书》"},"similar":["高官厚禄","高位重禄"],"usage":"作谓语、宾语；同“高官厚禄”"},{"id":48186,"word":"高位重禄","pinyin":"gāo wèi zhòng lù","abbr":"gwzl","explanation":"官职高贵，俸禄丰厚。同“高位厚禄”。","source":{"text":"圣人知其然，是以去苛礼而务至诚，黜虚名而求实效，不爱高位重禄以致山林之士。","book":"宋·苏轼《策略五》"},"similar":["高位厚禄"],"usage":"作谓语、宾语；同“高官厚禄”"},{"id":48187,"word":"高低不就","pinyin":"gāo dī bù jiù","abbr":"gdbj","explanation":"就：成。高者无力得到，低者又不屑迁就。形容求职或婚姻上的两难处境。","source":{"text":"因此高低不就，把女儿直挨到一十八岁，尚未许人。","book":"明·冯梦龙《喻世明言》第27卷"},"similar":["高不成，低不就"],"usage":"作谓语、宾语、定语；形容进退两难处境"},{"id":48188,"word":"高低贵贱","pinyin":"gāo dī guì jiàn","abbr":"gdgj","explanation":"贵：尊贵。指物体的价值或人的地位的高下等级。","example":{"text":"不论～，你得尽快买一个来替代。"},"usage":"作主语、宾语、定语；用于价格、职位等"},{"id":48189,"word":"高傲自大","pinyin":"gāo ào zì dà","abbr":"gazd","explanation":"自以为了不起，极其骄傲，看不起别人。","source":{"text":"各种业务专长，都可以成为高傲自大轻视旁人的资本。","book":"毛泽东《学习和时局》"},"similar":["自高自大","妄自尊大"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；用于为人"},{"id":48190,"word":"高冠博带","pinyin":"gāo guān bó dài","abbr":"ggbd","explanation":"冠：帽子；博：大；带：衣带。戴着高大的帽子，系着宽阔的衣带。形容儒生的装束。也比喻穿着礼服。","source":{"text":"昔者齐桓公，高冠博带，金剑木盾，以治其国。","book":"《墨子·公孟》"},"similar":["峨冠博带"],"usage":"作宾语、定语；形容儒生的装束"},{"id":48191,"word":"高凤自秽","pinyin":"gāo fèng zì huì","abbr":"gfzh","explanation":"东汉高凤，字文通，执志不仕，太守连召请，恐不得免，自言本巫家，不应为吏，又诈与寡嫂讼田，遂不仕。后用为自诬之典。"},{"id":48192,"word":"高出一筹","pinyin":"gāo chū yī chóu","abbr":"gcyc","explanation":"筹：筹码。比别人高出一个筹码。指比别人高明一些。","source":{"text":"公系我国的政治家，一切设施，比文等高出一筹，文亦不必参议。","book":"蔡东藩《民国通俗演义》第15回"},"example":{"text":"我比你要～。"},"similar":["略胜一筹"],"usage":"作谓语、定语；指比别人高明一些"},{"id":48193,"word":"高出云表","pinyin":"gāo chū yún biǎo","abbr":"gcyb","explanation":"云表：云外。高高直立，伸入云端。形容山峰或建筑物等高峻挺拔。","source":{"text":"回头看隔院时，正有一棵高出云表的老槐树。","book":"张恨水《啼笑姻缘》第13回"},"usage":"作谓语、定语；用于高的物体等"},{"id":48194,"word":"高卧东山","pinyin":"gāo wò dōng shān","abbr":"gwds","explanation":"比喻隐居不仕，生活安闲。","source":{"text":"卿累违朝旨，高卧东山。","book":"《晋书·谢安传》"},"example":{"text":"既以～，不应再为冯妇。","book":"蔡东藩《民国通俗演义》第47回"},"similar":["东山高卧"],"opposite":["东山再起"],"usage":"作谓语、定语；指隐居不仕","story":["东晋时期，贤人谢安坚决辞去官职到会稽附近的东山隐居，经常有文人前来拜访他，与他饮酒赋诗，从不过问朝政。前秦南侵，东晋危在旦夕，谢安临危授命，当了东晋的宰相，率军在淝水成功打败前秦军队，并趁机率军北伐收复失地"]},{"id":48195,"word":"高台厚榭","pinyin":"gāo tái hòu xiè","abbr":"gthx","explanation":"厚：大；榭：建筑在高台上的房屋。指园林中供休息和四周景观的高大建筑物。","source":{"text":"非以高台厚榭邃野之居以为不安也。","book":"《墨子·非乐上》"},"example":{"text":"中国建筑中的～很有讲究"},"similar":["高亭大榭"],"usage":"作主语、宾语、定语；用于建筑"},{"id":48196,"word":"高名上姓","pinyin":"gāo míng shàng xìng","abbr":"gmsx","explanation":"高：敬辞。询问人姓名的客气用语。","example":{"text":"能告知您的～吗？"},"similar":["高姓大名"],"usage":"作宾语、定语；用于客气用语"},{"id":48197,"word":"高名大姓","pinyin":"gāo míng dà xìng","abbr":"gmdx","explanation":"询问人家姓名时的客气用语。","source":{"text":"请问仙乡何处，高名大姓，因甚到此？","book":"元·尚仲贤《柳毅传书》第一折"},"example":{"text":"请写上您的～，然后投进抽奖箱即可"},"similar":["高姓大名"],"usage":"作宾语、定语；用于客气用语"},{"id":48198,"word":"高唱入云","pinyin":"gāo chàng rù yún","abbr":"gcry","explanation":"原形容歌声嘹亮，直上云霄，后也形容一种论调或消息社会上传说很盛。","source":{"text":"后宫齐首高唱，声入云霄。","book":"晋·葛洪《西京杂记》卷一"},"example":{"text":"拔起千仞，～，瑕隙尚不易见。","book":"清·谭嗣同《致刘淞芙书》"},"similar":["响彻云霄"],"usage":"作谓语；形容歌声嘹亮，直上云霄"},{"id":48199,"word":"高垒深堑","pinyin":"gāo lěi shēn qiàn","abbr":"glsq","explanation":"垒：军营四周的堡寨；堑：壕沟。高高的堡垒，深深的护城河。形容防卫坚固。","source":{"text":"郎中郑忠乃说止汉王，使高垒深堑，勿与战。","book":"西汉·司马迁《史记·高祖本纪》"},"similar":["高垒深沟"],"usage":"作宾语、定语；形容防卫坚固"},{"id":48200,"word":"高垒深壁","pinyin":"gāo lěi shēn bì","abbr":"glsb","explanation":"垒：军营的墙壁或工事。修筑起高深的壁垒。形容加强防御。","source":{"text":"王经当高壁深垒，挫其锐气。","book":"《三国志·魏志·陈泰传》"}},{"id":48201,"word":"高垒深沟","pinyin":"gāo lěi shēn gōu","abbr":"glsg","explanation":"垒：壁垒，军营四周所筑围墙。沟：战壕。高筑壁垒，深挖壕沟。指强固防御工事。","source":{"text":"敌虽高垒深沟，不得不与我战者，攻其所必救也。","book":"《孙子·虚实》"},"example":{"text":"明·无名氏《杨家将演义》第七卷：“既爹爹夜梦不祥，且停止不出交兵，～，坐老其师何如？”"},"similar":["高垒深堑","高城深沟"],"usage":"作宾语、定语；形容防卫坚固"},{"id":48202,"word":"高城深堑","pinyin":"gāo chéng shēn qiàn","abbr":"gcsq","explanation":"堑：壕沟。高高的城墙，深深的护城河。形容防卫坚固。","source":{"text":"令室家田作具以备之，以便为之，高城深堑，其外复为一城。","book":"汉·荀悦《汉纪·孝文帝纪》"},"similar":["高城深池","高城深沟"],"usage":"作宾语、定语；形容防卫坚固"},{"id":48203,"word":"高城深池","pinyin":"gāo chéng shēn chí","abbr":"gcsc","explanation":"池：护城河。城墙很高，护城河很深。形容防卫坚固。","source":{"text":"故坚革利兵不足以为胜，高城深池不足以为固，严令繁刑不足以为威。","book":"《荀子·议兵》"},"example":{"text":"虽有～，严法重刑，犹不能禁也。","book":"汉·鼌错《论贵粟疏》"},"similar":["铜墙铁壁"],"usage":"作宾语、定语；形容防卫坚固"},{"id":48204,"word":"高城深沟","pinyin":"gāo chéng shēn gōu","abbr":"gcsg","explanation":"高高的城墙，深深的护城河。形容防卫坚固。","source":{"text":"项城小邑，无长戟劲弩，高城深沟之固，贼气吞焉。","book":"唐·李翱《杨烈妇传》"},"similar":["高城深池","高城深堑"],"usage":"作宾语、定语；形容防卫坚固"},{"id":48205,"word":"高堂大厦","pinyin":"gāo táng dà shà","abbr":"gtds","explanation":"指高耸的楼房。同“高楼大厦”。","source":{"text":"师父，此处索是幽静，弟子不恋高堂大厦。","book":"元·杨暹《刘行首》第四折"},"example":{"text":"少不得把他做个少奶奶，住着～，锦衣肉食的享用不了。","book":"《何典》第八回"},"similar":["高楼大厦","高堂广厦"],"usage":"作主语、宾语、定语；指高大的建筑"},{"id":48206,"word":"高堂广厦","pinyin":"gāo táng guǎng shà","abbr":"gtgs","explanation":"厦：高大的房屋。指高大豪华的房屋建筑。","source":{"text":"高堂广厦，玉宇琼楼，是坟山上起得的享堂。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"similar":["高堂大厦","高楼大厦"],"usage":"作主语、宾语、定语；指高大的建筑"},{"id":48207,"word":"高壁深垒","pinyin":"gāo bì shēn lěi","abbr":"gbsl","explanation":"垒：军营的墙壁或工事。修筑起高深的壁垒。形容加强防御。","source":{"text":"王经当高壁深垒，挫其锐气。","book":"《三国志·魏志·陈泰传》"},"similar":["高壁深堑"],"usage":"作宾语、定语；用于比喻句"},{"id":48208,"word":"高壁深堑","pinyin":"gāo bì shēn qiàn","abbr":"gbsq","explanation":"壁：营垒；堑：护城河，壕沟。筑起高深的营寨，深挖壕沟。形容加强防御。","source":{"text":"若以万人为垒，下窒其口，高壁深堑，勿与之战，忽有败负，势惊洛师。","book":"唐·杜牧《上司徒李相公论用兵书》"},"similar":["高壁深垒"],"usage":"作宾语、定语；用于比喻句"},{"id":48209,"word":"高处不胜寒","pinyin":"gāo chù bù shèng hán","abbr":"gcbsh","explanation":"胜：承受，经得起。站在高处经不起风寒。比喻人身居高位感觉到孤单寂寞。","source":{"text":"我欲乘风归去，又恐琼楼玉宇，高处不胜寒。","book":"宋·苏轼《水调歌头·丙辰中秋兼怀子由》词"},"usage":"作宾语、定语；用于慨叹"},{"id":48210,"word":"高天厚地","pinyin":"gāo tiān hòu dì","abbr":"gthd","explanation":"①比喻长久。②比喻深重。","source":{"text":"高天厚地，共启长年。","book":"明·吴承恩《贺金耻齐翁媪齐寿障词》引"},"example":{"text":"幸蒙莫大之恩，～岂能酬，粉骨碎身何足报。","book":"《水浒传》第一一九回"},"similar":["天高地厚"],"usage":"作宾语、定语；用于比喻句"},{"id":48211,"word":"高头大马","pinyin":"gāo tóu dà mǎ","abbr":"gtdm","explanation":"指体形高大健壮的好马。","source":{"text":"只见门前来了一伙骑马的客人，共是十一个，个个骑的是自购的高头骏马。","book":"明·凌濛初《初刻拍案惊奇·刘东山夸技顺城门》"},"example":{"text":"盖上雕刻着一个带刀的将军，骑着匹～。","book":"清·曾朴《孽海花》第十五回"},"similar":["人高马大"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":48212,"word":"高头讲章","pinyin":"gāo tóu jiǎng zhāng","abbr":"gtjz","explanation":"经书正文上端留有较宽空白，刊印讲解文字，这些文字称为“高头讲章”。后来泛指这类格式的经书。","source":{"text":"先生见了那没头没脑辟空而来的十五个大字，正不知从那里开口，才入得进这中庸两个字，只得先看了一遍高头讲章，照着那讲章往下敷衍半日，才得讲完。","book":"《儿女英雄传》第十八回"},"example":{"text":"鬼嗫嚅良久曰：‘昨过君塾，君方昼寝。见君胸中～一部。’","book":"清·纪昀《阅微草堂笔记·滦阳消夏录一》"},"usage":"作宾语、定语；用于经文等"},{"id":48213,"word":"高头骏马","pinyin":"gāo tóu jùn mǎ","abbr":"gtjm","explanation":"指体形高大健壮的好马。","source":{"text":"只见门前来了一伙骑马的客人，共是十一个，个个骑的是自购的高头骏马。","book":"明·凌濛初《初刻拍案惊奇·刘东山夸技顺城门》"}},{"id":48214,"word":"高姓大名","pinyin":"gāo xìng dà míng","abbr":"gxdm","explanation":"询问人家姓名时的客气用语。同“高名大姓”。","source":{"text":"宋江、花荣慌忙下马，扶起那两位壮士道：‘且请问二位壮士高姓大名？’","book":"明·施耐庵《水浒传》第三十五回"},"example":{"text":"多蒙恩公的美意，改日相谢。不知恩公～，贵府何处？","book":"《粉妆楼》第二十一回"},"similar":["高名上姓"],"usage":"作宾语、定语；用于客气用语"},{"id":48215,"word":"高官厚禄","pinyin":"gāo guān hòu lù","abbr":"gghl","explanation":"禄：俸禄。泛指职位高，待遇优。","source":{"text":"下之不能积日累劳，取尊官厚禄，以为宗族交游光宠。","book":"《荀子·议兵》：“是高爵丰禄之所加也，荣孰大焉。”汉·司马迁《报任少卿书》"},"example":{"text":"假如有一等做官的，误国欺君，侵剥百姓，虽然～，难道不是大盗。","book":"明·凌濛初《初刻拍案惊奇》卷八"},"similar":["宾客盈门"],"opposite":["门可罗雀"],"usage":"作主语、宾语、定语；指职位高，待遇优"},{"id":48216,"word":"高官尊爵","pinyin":"gāo guān zūn jué","abbr":"ggzj","explanation":"显贵的官职和爵位。","source":{"text":"今世之人居高官尊爵者，皆重失之。","book":"《庄子·让王》"},"similar":["高官显爵"],"usage":"作谓语、宾语、定语；指官位高"},{"id":48217,"word":"高官显爵","pinyin":"gāo guān xiǎn jué","abbr":"ggxj","explanation":"显：显要，显赫；爵：爵位，官爵。官职很高，爵们显赫。","source":{"text":"顺吾者高官显爵，逆吾者灭族亡身，正是一朝一权在手，便把令来行。","book":"明·徐元《八义记·猜忌赵宣》"},"example":{"text":"前者老大人～，贫道怎敢相认？","book":"清·曹雪芹《红楼梦》第120回"},"similar":["高官尊爵","高官显宦","贵官显宦"],"opposite":["平民百姓"],"usage":"作谓语、宾语、定语；指官位高"},{"id":48218,"word":"高官极品","pinyin":"gāo guān jí pǐn","abbr":"ggjp","explanation":"官位居最高等。","source":{"text":"虽高官极品，不能一日养亲，亦有何味。","book":"清·李汝珍《镜花缘》第八十五回"},"usage":"作主语、宾语、定语；用于官场等"},{"id":48219,"word":"高官重禄","pinyin":"gāo guān zhòng lù","abbr":"ggzl","explanation":"禄：俸禄。泛指职位高，待遇优。同“高官厚禄”。","source":{"text":"任使高官重禄，金鱼袋、肥马轻裘。","book":"金·丘处机《满庭芳·述怀》词"},"example":{"text":"今之患得患失，志于～，好田宅，美风水，以为子孙荫者，皆其托名于林汝宁，以为舍不得李卓老者也。","book":"明·李贽《又与焦弱侯书》"},"similar":["高官厚禄","厚禄高官"],"usage":"作主语、宾语、定语；指职位高，待遇优"},{"id":48220,"word":"高尚娴雅","pinyin":"gāo shàng xián yǎ","abbr":"gsxy","explanation":"文雅、优美的动作与才艺。","example":{"text":"他爱上一位～的姑娘。"},"usage":"作谓语、定语；指动作与才艺"},{"id":48221,"word":"高居深拱","pinyin":"gāo jū shēn gǒng","abbr":"gjsg","explanation":"指高居帝位，垂拱而治。","source":{"text":"若上贤右能，使百司善职，则高居深拱，畴敢犯之？","book":"《新唐书·张玄素传》"},"example":{"text":"官乱于上，民贫于下，风俗日以薄，才力日以困穷，而陛下～，未尝有询考讲求之意。","book":"宋·王安石《上时政疏》"},"similar":["垂拱而治"],"usage":"作谓语、定语；用于帝王统治"},{"id":48222,"word":"高屋建瓴","pinyin":"gāo wū jiàn líng","abbr":"gwjl","explanation":"建：倒水，泼水；瓴：盛水的瓶子。把瓶子里的水从高层顶上倾倒。比喻居高临下，不可阻遏。","source":{"text":"地势便利，其以下兵于诸侯，譬犹居高屋之上建瓴水也。","book":"《史记·高祖本纪》"},"example":{"text":"革命的豪情和革命的气魄，使他的史剧气势恢阔，振摆超腾，～，雄浑奔放。","book":"《郭沫若剧作全集编后记》"},"similar":["居高临下","建瓴高屋"],"usage":"作谓语、定语、状语；比喻居高临下","story":["西汉初期，刘邦听信谗言，用谋士陈平的计谋，在陈地诱扣楚王韩信，将他贬为淮阴侯。大臣田肯向刘邦道贺，建议刘邦在关中建都，那样就像站在高屋之上向下泼水那样势不可挡。刘邦十分高兴，大赏了田肯"]},{"id":48223,"word":"高山仰之","pinyin":"gāo shān yǎng zhī","abbr":"gsyz","explanation":"高山：比喻高尚的品德。比喻对高尚的品德的仰慕。同“高山仰止”。","source":{"text":"高山仰之可极，深渊度之可测，神明之德术正静，其莫之极。","book":"《管子·九守》：“高山仰之，不可极也。”《鬼谷子·符言》"},"similar":["高山仰止，景行行止"],"usage":"作宾语、定语；用于比喻句"},{"id":48224,"word":"高山仰止","pinyin":"gāo shān yǎng zhǐ","abbr":"gsyz","explanation":"高山：比喻高尚的品德。比喻对高尚的品德的仰慕。","source":{"text":"高山仰止，景行行止。","book":"《诗经·小雅·车辖》"},"example":{"text":"夫岂不怀，～，愿言敏德，啜菽饮水。","book":"唐·王勃《倬彼我系》"},"similar":["高山仰之"],"usage":"作谓语、分句；常与“景行行止”连用"},{"id":48225,"word":"高山仰止，景行行止","pinyin":"gāo shān yǎng zhǐ，jǐng xíng xíng zhǐ","abbr":"gsyzjxxz","explanation":"高山：比喻道德崇高；景行：大路，比喻行为正大光明。指值得效法的崇高德行。","source":{"text":"高山仰止，景行行止。","book":"《诗经·小雅·车辖》"},"example":{"text":"西汉·司马迁《史记·孔子世家》：“诗有之：‘～。’虽不能至，然心乡往之。”"},"usage":"作宾语、定语、分句；用于书面语"},{"id":48226,"word":"高山低头，河水让路","pinyin":"gāo shān dī tóu，hé shuǐ ràng lù","abbr":"gsdthsrl","explanation":"比喻人民群众征服自然，改造社会的无穷力量。","source":{"text":"人们常说的‘高山低头，河水让路’的奇迹，在宝成路上真正实现了。","book":"邓拓《英雄的路》"},"usage":"作宾语、定语；用于比喻句"},{"id":48227,"word":"高山大川","pinyin":"gāo shān dà chuān","abbr":"gsdc","explanation":"高高的山岭，奔流的大河。","source":{"text":"所见不过数百里之间，无高山大野，可登览以自广。","book":"宋·苏轼《上枢密韩大尉书》"},"example":{"text":"他失去镇定，他的心由家中跳到那～，又由～跳回小羊圈。","book":"老舍《四世同堂》八十四"}},{"id":48228,"word":"高山大野","pinyin":"gāo shān dà yě","abbr":"gsdy","explanation":"高高的山岭，广袤的原野。","source":{"text":"所见不过数百里之间，无高山大野，可登览以自广。","book":"宋·苏轼《上枢密韩大尉书》"},"usage":"作主语、宾语、定语；用于地貌等"},{"id":48229,"word":"高山密林","pinyin":"gāo shān mì lín","abbr":"gsml","explanation":"高峻的山岭，茂密的森林。","source":{"text":"猛虎，必须依靠高山密林，才能威震山峦。","book":"《星火燎原·毛委员率领我们上井冈山》"}},{"id":48230,"word":"高山峻岭","pinyin":"gāo shān jùn lǐng","abbr":"gsjl","explanation":"峻：山高而陡。又高又险的山岭。","source":{"text":"众人打一看时，四面尽是高山，左右是悬崖峭壁，只见高山峻岭，无路可登。","book":"明·施耐庵《水浒传》第八十六回"},"example":{"text":"三峡之中，唯巫峡最长。两岸都是～，古木阴森，映蔽江面，止露得中间一线的青天。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"similar":["崇山峻岭"],"usage":"作主语、宾语、定语；用于地势等"},{"id":48231,"word":"高山景行","pinyin":"gāo shān jǐng xíng","abbr":"gsjx","explanation":"高山：比喻道德崇高；景行：大路，比喻行为正大光明。指值得效法的崇高德行。","source":{"text":"高山仰止，景行行止。","book":"《诗经·小雅·车辖》"},"example":{"text":"若夫清风明月，必思玄度，～，独仰仲尼。","book":"宋·杨万里《与余丞相》"},"usage":"作谓语、定语；指崇高德行"},{"id":48232,"word":"高山流水","pinyin":"gāo shān liú shuǐ","abbr":"gsls","explanation":"比喻知己或知音。也比喻乐曲高妙。","source":{"text":"伯牙鼓琴，志在登高山，钟子期曰：‘善哉，峨峨兮若泰山。’志在流水，曰：‘善哉，洋洋兮若江河。’","book":"《列子·汤问》"},"example":{"text":"孔圣人尚学琴于师襄，一操便知其为文王。～，得遇知音。","book":"清·曹雪芹《红楼梦》第八十六回"},"similar":["知音难觅"],"usage":"作宾语；比喻乐曲高妙","story":["春秋时期，晋国大夫俞伯牙很擅长弹琴，他到楚国马鞍山遇到钟子期，两人谈论琴律很投机。伯牙看到高山流水就弹奏一曲，钟子期高兴地说泰山江河。两人结为知己。第二年伯牙去拜会钟子期，得知钟子期病故，就在坟前伤心地毁琴"]},{"id":48233,"word":"高山深涧","pinyin":"gāo shān shēn jiàn","abbr":"gssj","explanation":"涧：夹在两山之间的水沟。指山很高，山间的水沟很深。形容地势险要。"},{"id":48234,"word":"高岸为谷","pinyin":"gāo àn wéi gǔ","abbr":"gawg","explanation":"谷：两山间的凹处。高岸变成山谷。比喻世事变迁巨大或事物在一定条件下向其相反方向转化。","source":{"text":"自去年以来，灾谴频数，地坼天崩，高岸为谷。","book":"南朝·宋·范晔《后汉书·翟酺传》"},"similar":["沧海桑田","高岸为谷，深谷为陵"],"usage":"作宾语、定语；用于书面语"},{"id":48235,"word":"高岸为谷，深谷为陵","pinyin":"gāo àn wéi gǔ，shēn gǔ wéi líng","abbr":"gawgsgwl","explanation":"高岸变成深谷，深谷变成丘陵。也比喻事物的巨大变化。","source":{"text":"高岸为谷，深谷为陵。","book":"《诗经·小雅·十月之交》"},"example":{"text":"晋·张华《博物志·山水总论》：“～，小人握命，君子陵迟，白黑不分，大乱之征也。”"},"similar":["高岸为谷","高岸成谷，深谷为陵"],"usage":"作宾语、定语；用于书面语"},{"id":48236,"word":"高岸成谷，深谷为陵","pinyin":"gāo àn chéng gǔ，shēn gǔ wéi líng","abbr":"gacgsgwl","explanation":"谷：两山间的凹处；陵：大山。高岸变成山谷，深谷变为高山。比喻世事变迁巨大或事物在一定条件下向其相反方向转化。","source":{"text":"高岸成谷，深谷为陵，即秉烛刻阴，岂足以老伶之一泣也。","book":"清·侯方域《赠江伶序》"},"similar":["高岸为谷，深谷为陵","高岸为谷"],"usage":"作宾语、定语；用于书面语"},{"id":48237,"word":"高岸深谷","pinyin":"gāo àn shēn gǔ","abbr":"gasg","explanation":"指幽僻的处所。形容幽峭深邃。也比喻事物的巨大变化。","source":{"text":"子若处高岸深谷，人道不通，谁能见子？","book":"《诗经·小雅·十月之交》：“高岸为谷，深谷为陵。”《晋·皇甫谧《高士传》"},"example":{"text":"不少贤达圣士，当时为人宗物望所归者，～，忽然湮灭。","book":"清·黄宗羲《与孝杲堂、陈介眉书》"},"similar":["高岸为谷","沧海桑田"],"usage":"作宾语、定语；比喻事物的巨大变化"},{"id":48238,"word":"高悬秦镜","pinyin":"gāo xuán qín jìng","abbr":"gxqj","explanation":"秦镜：秦始皇时的能照见人心善恶的镱子。高挂能照见人心善恶的镜子。后用以比喻官吏断案公正，执法严明。","source":{"text":"（咸阳宫）有方镜，广四尺，高五尺九寸……人有疾病在内则掩心而照之，则知病之所在。又女子有邪心，是胆张心动。秦始皇常以照宫人，胆张心动者则杀之。","book":"晋·葛洪《西京杂记》第三卷"},"similar":["明镜高悬","秦镜高悬"],"usage":"作谓语、宾语；指公正严明","story":["传说秦朝咸阳宫中有一面神奇的镜子，他宽四尺，高五尺，正反两面都能照人，人在镜前镜中影子是倒立的，用手按住胸口照镜可以显示五脏六腑，可以看出人体内的病灶，还能看出那些心术不正的人，秦始皇经常用该镜对付身边的人"]},{"id":48239,"word":"高情厚意","pinyin":"gāo qíng hòu yì","abbr":"gqhy","explanation":"指深厚的情谊。","source":{"text":"既承员外高情厚意，待老汉去叫小女出来拜见。","book":"清·褚人获《隋唐演义》第42回"},"similar":["高情厚爱","高情厚谊"],"usage":"作宾语、定语；用于客套话等"},{"id":48240,"word":"高情厚爱","pinyin":"gāo qíng hòu ài","abbr":"gqha","explanation":"指深厚的情谊。","source":{"text":"非是小弟深谋远虑，一则承单二哥高情厚爱，不忍轻抛此地，二则小女在单二哥处打扰，颇有内顾萦心。","book":"清·褚人获《隋唐演义》第37回"},"similar":["高情厚谊","高情厚意"],"usage":"作宾语、定语；用于客套话等"},{"id":48241,"word":"高情厚谊","pinyin":"gāo qíng hòu yì","abbr":"gqhy","explanation":"谊：交情。高盛的情意，深厚的友谊。","source":{"text":"久闻潞州单二哥高情厚谊，恨不能相见，今日这桩事，却为人谋而不忠。","book":"清·褚人获《隋唐演义》第13回"},"example":{"text":"我不会忘记你的～。"},"similar":["深情厚谊","高情厚爱","高情厚意"],"usage":"作宾语、定语；指情意深"},{"id":48242,"word":"高情迈俗","pinyin":"gāo qíng mài sú","abbr":"gqms","explanation":"高情：高雅的情趣；迈：超脱。情致高雅脱俗。","source":{"text":"陈谭工山水，德宗除连州刺史，令写彼处山水之状，每岁贡献。野逸不群，高情迈俗，张藻之亚也。","book":"元·夏文彦《图绘宝鉴·唐》"},"similar":["高节迈俗"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":48243,"word":"高情远意","pinyin":"gāo qíng yuǎn yì","abbr":"gqyy","explanation":"高、远：形容高尚；情、意：情趣。高尚的品格或情趣。","source":{"text":"高情远致，弟子蚤已服膺；一吟一咏，许将北面。","book":"南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"盖俗学只见其皮肤，其～，皆不识也。","book":"宋·胡仔《苕溪渔隐丛话前集·西昆体》"},"similar":["高情远致","高情远韵"],"usage":"作宾语、定语；用于书面语"},{"id":48244,"word":"高情远致","pinyin":"gāo qíng yuǎn zhì","abbr":"gqyz","explanation":"高、远：形容高尚；情、致：情趣。高尚的品格或情趣。","source":{"text":"高情远致，弟子早已伏膺；然一咏一吟，许将北面矣。","book":"《晋书·孙绰传》"},"similar":["高情远意","高情远韵"],"usage":"作谓语、定语；指高尚的品格或情趣"},{"id":48245,"word":"高情远韵","pinyin":"gāo qíng yuǎn yùn","abbr":"gqyy","explanation":"高尚的品格或情趣。同“高情远致”。","source":{"text":"独陶元亮天分之高……直超建安而上之，高情远韵，殆犹大羹充铏，不假盐醯而至味自存者也。","book":"明·宋濂《答张秀才认诗书》"},"similar":["高情远意","高情远致"],"usage":"作宾语、定语；用于书面语"},{"id":48246,"word":"高情逸兴","pinyin":"gāo qíng yì xīng","abbr":"gqyx","explanation":"清高超逸的情致。","source":{"text":"尝谓其弟曰：‘吾诗思若在三峡之间闻猿声时。’其高情逸兴如此。","book":"《宣和画谱·胡擢》"},"example":{"text":"视世之规规谫谫，无居士之～，虽为官，岂能辨治哉？","book":"明·归有光《洧南居士传》"},"similar":["闲情逸趣"],"usage":"作宾语、定语；用于人的兴致等"},{"id":48247,"word":"高情逸态","pinyin":"gāo qíng yì tài","abbr":"gqyt","explanation":"高情：高雅的情趣；逸态：安闲的神态。高雅的情致，安逸的仪态。","source":{"text":"姿质秾艳，一生未见；高情逸态，事事过人。","book":"明·汤显祖《紫钗记·谒鲍述娇》"},"usage":"作宾语、定语；用于书面语"},{"id":48248,"word":"高才卓识","pinyin":"gāo cái zhuó shí","abbr":"gczs","explanation":"才能高超，见识深远。同“高才远识”。","source":{"text":"[上官昭容]果是高才卓识，即沈宋二人，尚且服其公明，何况臣等。","book":"《隋唐演义》第七六回"},"example":{"text":"我最先所认识的律师、都是有～的，他们都是从西洋政大学毕业回来的。","book":"包天笑《钏影楼回忆录续编·护花律师》"},"similar":["高才远识"],"usage":"作谓语、宾语、定语；用于人的才识等"},{"id":48249,"word":"高才博学","pinyin":"gāo cái bó xué","abbr":"gcbx","explanation":"高才：才能杰出；博学：学识渊博。才能高超，学识渊博。","source":{"text":"且夫周孔，盖是高才大学之深远者耳。","book":"《抱朴子·辨问》"},"example":{"text":"州举～者为秀才，郡举经明行修者为孝廉，上州、上郡岁一人，下州、下郡三岁一人。","book":"《周书·宣帝纪》"},"similar":["高才大学","高才硕学"],"usage":"作宾语、定语；指人的学识"},{"id":48250,"word":"高才大学","pinyin":"gāo cái dà xué","abbr":"gcdx","explanation":"高才：才能杰出；大学：学识渊博。才能高超，学识渊博。","source":{"text":"且夫周孔，盖是高才大学之深远者耳。","book":"《抱朴子·辨问》"},"similar":["高才博学","高才硕学"],"usage":"作宾语、定语；指人的学识"},{"id":48251,"word":"高才大德","pinyin":"gāo cái dà dé","abbr":"gcdd","explanation":"高才：有杰出的才能；大德：有极高尚的品德。形容才能和品德都很好。","source":{"text":"贤弟，论你高才大德，博学广文，为何不进取功名。","book":"元·马致远《荐福碑》第一折"},"example":{"text":"明·无名氏《暗度陈仓》第四折：“我有甚～，仰荷着圣主仁威，安邦智量多，报国当劳力，对人前不敢闲题。”"},"similar":["德才兼备"],"usage":"作宾语、定语；用于称赞人"},{"id":48252,"word":"高才捷足","pinyin":"gāo cái jié zú","abbr":"gcjz","explanation":"才：才能；捷：迅速，快捷。形容人才能出众，行动快。","source":{"text":"有力量者十二首都做也可；不能的作一首也可。高才捷足者为尊。","book":"清·曹雪芹《红楼梦》第37回"},"similar":["高材疾足"],"usage":"作谓语、定语、补语；指人才能出众行事敏捷"},{"id":48253,"word":"高才疾足","pinyin":"gāo cái jí zú","abbr":"gcjz","explanation":"形容人才能出众，行动快。同“高才捷足”。","source":{"text":"高才疾足长叹息，御卿无权挽无力。","book":"宋·陈杰《金石客》诗"},"example":{"text":"明·无名氏《暗度陈仓》第一折：“自因秦失其鹿，天下大乱，～者先得之。”"},"similar":["高材疾足","高材捷足"],"usage":"作谓语、定语、补语；形容人才能出众"},{"id":48254,"word":"高才硕学","pinyin":"gāo cái shuò xué","abbr":"gcsx","explanation":"高才：才能杰出；硕学：学识渊博。才能高超，学识渊博。","source":{"text":"且夫周孔，盖是高才大学之深远者耳。","book":"《抱朴子·辨问》"},"example":{"text":"～，犹滞草莱。","book":"唐·李纲《谏高祖不以伶人为近侍疏》"},"similar":["高才大学","高才博学"],"usage":"作宾语、定语；指人的学识"},{"id":48255,"word":"高才绝学","pinyin":"gāo cái jué xué","abbr":"gcjx","explanation":"①犹言才学高超。②指才学高超的人。","source":{"text":"唐柳宗元、刘禹锡使不陷叔文之党，其高才绝学，亦足以为唐名臣矣。","book":"宋·苏轼《续欧阳子〈朋党论〉》"},"example":{"text":"如今果是杨国忠为相，贿赂公行，不知埋没了多少～。","book":"《醒世恒言·李汧公穷邸遇侠客》"},"usage":"作宾语、定语；用于人的学识等"},{"id":48256,"word":"高才远识","pinyin":"gāo cái yuǎn shí","abbr":"gcys","explanation":"才能高超，见识深远。","source":{"text":"召陵谢子微，高才远识。","book":"《三国志·魏志·和洽传》“清醇有鉴识”裴松之注引三国·魏·周斐《汝南先贤传》"},"similar":["高才卓识"],"usage":"作宾语、定语；用于人的才识等"},{"id":48257,"word":"高抬明镜","pinyin":"gāo tái míng jìng","abbr":"gtmj","explanation":"秦始皇有一方镜，能照见人心等。比喻执法者判案公正严明。","source":{"text":"有方镜，广四尺，高五尺九寸，表里有明，人直来照之，影则倒见。以手扪心而来，则见肠胃五脏，历然无碍。","book":"《西京杂记》卷三"},"example":{"text":"与小妇人并无干涉，只望大人～替小妇人做主咱。","book":"元·关汉卿《窦娥冤》第二折"},"similar":["明镜高悬"],"usage":"作谓语、宾语；用于比喻句"},{"id":48258,"word":"高抬贵手","pinyin":"gāo tái guì shǒu","abbr":"gtgs","explanation":"旧时恳求人原谅或饶恕的话。意思是您一抬手我就过去了。","source":{"text":"能斟时事高抬贵手，善酌人情略拨头。","book":"宋·邵雍《伊川击壤集·谢宁寺丞惠希夷》"},"example":{"text":"娘是小的一个主儿，娘不～，小的一时儿存站不的。","book":"明·兰陵笑笑生《金瓶梅词话》第二十三回"},"opposite":["绝不轻饶"],"usage":"作谓语；用于恳求人原谅或饶恕"},{"id":48259,"word":"高掌远跖","pinyin":"gāo zhǎng yuǎn zhí","abbr":"gzyz","explanation":"比喻开拓，开辟。","source":{"text":"缀以二华，巨灵赑屃，高掌远跖，以流河曲。","book":"汉·张衡《西京赋》"},"example":{"text":"茅盾《子夜》五：“外国的企业家果然有～的气魄和铁一样的手腕。”"}},{"id":48260,"word":"高掌远蹠","pinyin":"gāo zhǎng yuǎn zhí","abbr":"gzyz","explanation":"掌：用手擘开；蹠：用脚踢。传说华岳本为一山，河神手擘脚踢，将其分开为二。比喻规模巨大、气魄雄伟的经营。","source":{"text":"缀以二华，巨灵赑屃，高掌远蹠，以流河曲。","book":"汉·张衡《西京赋》"},"example":{"text":"外国的企业家果然有～的气魄和铁一样的手腕，却也有忠实而能干的部下，这样才能应付自如，所向必利。","book":"茅盾《子夜》五"},"usage":"作谓语、补语；比喻开拓，开辟"},{"id":48261,"word":"高攀不上","pinyin":"gāo pān bù shàng","abbr":"gpbs","explanation":"不能同等与地位、名誉较自己高的人结交或攀亲。","source":{"text":"你们钟府上是做官的仕宦之家，我们做买卖的，恐怕高攀不上吧？","book":"李六如《六十年的变迁》"},"example":{"text":"王朔《我是你爸爸》：“万一她觉得～呢？这岂不是弄巧成拙？”"},"opposite":["攀龙附凤"],"usage":"作谓语、宾语；用于自谦"},{"id":48262,"word":"高文典册","pinyin":"gāo wén diǎn cè","abbr":"gwdc","explanation":"指封建朝廷的重要文书、诏令。","source":{"text":"军旅之际，戎马之间，飞书驰檄用枚皋；廊庙之下，朝廷之中，高文典册用相如。","book":"《西京杂记》卷三"},"example":{"text":"不知古之闻人，何乐辍其～，而以翰墨为游戏也。","book":"清·高尚缙《万国演义序》"},"similar":["高文典策"],"usage":"作宾语；指经典性著作"},{"id":48263,"word":"高文典策","pinyin":"gāo wén diǎn cè","abbr":"gwdc","explanation":"指封建朝廷的重要文书、诏令。同“高文典册”。","source":{"text":"闳言崇议，足以经纶王家；高文典策，足以鼓动当世。","book":"宋·王安石《翰林学士除三司使制》"},"similar":["高文大册","高文典册"],"usage":"作宾语；指经典性著作"},{"id":48264,"word":"高文大册","pinyin":"gāo wén dà cè","abbr":"gwdc","explanation":"原指朝廷发布的重要文书，如诏今制诰等。引申为经典性著述。","source":{"text":"宋·汪藻《序》一时高文大册，悉出其手。”"},"example":{"text":"方欲以高文大册自鸣天子之前，而又溘然长往矣。","book":"清·汪琬《后序》"},"similar":["高文典册","高文典策"],"usage":"作宾语；指经典性著作"},{"id":48265,"word":"高文宏议","pinyin":"gāo wén hóng yì","abbr":"gwhy","explanation":"高明的文章，恢宏的议论。","source":{"text":"有志于改革者，倘不深知民众的心，设法利导，改进，则无论怎样的高文宏议，浪漫古典，都和他们无干。","book":"鲁迅《习惯与改革》"}},{"id":48266,"word":"高文雅典","pinyin":"gāo wén yǎ diǎn","abbr":"gwyd","explanation":"雅：雅正；典：典籍。高深的文章，雅正的典籍。","source":{"text":"自然之情中所发自然之文，较高文雅典尤有价值多多也。","book":"恽代英《致沈葆秀书》"},"usage":"作主语、宾语、定语；指文章等"},{"id":48267,"word":"高斋学士","pinyin":"gāo zhāi xué shì","abbr":"gzxs","explanation":"南朝梁庾肩吾等十人的别号。"},{"id":48268,"word":"高明妇人","pinyin":"gāo míng fù rén","abbr":"gmfr","explanation":"旧指有见识的妇女。","source":{"text":"孝伯妻崔赜女，高明妇人，生一子元显。","book":"《魏书·李孝伯传》"}},{"id":48269,"word":"高明远见","pinyin":"gāo míng yuǎn jiàn","abbr":"gmyj","explanation":"高明：精明高妙。指见识精明高远。","source":{"text":"大王是高明远见的，不消乡民多说。","book":"清·吴敬梓《儒林外史》第一回"},"similar":["高明远识"],"usage":"作宾语、定语；用于夸奖人"},{"id":48270,"word":"高明远识","pinyin":"gāo míng yuǎn shí","abbr":"gmys","explanation":"高明：高超；远识：远大的眼光。指见识高远。","source":{"text":"公高明远识，洞鉴古今，知国家大事，必至于斯乎？","book":"宋·钱世昭《钱氏私志·蔡鲁公》"},"similar":["高明远见"],"usage":"作宾语、定语；用于夸奖人"},{"id":48271,"word":"高曾规矩","pinyin":"gāo zēng guī jǔ","abbr":"gcgj","explanation":"高曾：曾祖。祖宗留下来的成法。","source":{"text":"商修族世之所鬻，工用高曾之规矩。","book":"《后汉书·班固传》"},"usage":"作主语、宾语、定语；用于口语"},{"id":48272,"word":"高朋故戚","pinyin":"gāo péng gù qī","abbr":"gpgq","explanation":"高贵的朋友，至近的亲戚。指至亲好友。","source":{"text":"悦高朋故戚，共谈玄讲理，办登山玩水，早休官去职，远红尘是非。","book":"元·张可久《翻归去来辞》"},"similar":["亲朋戚友"],"usage":"作主语、宾语、定语；指至亲好友"},{"id":48273,"word":"高朋满座","pinyin":"gāo péng mǎn zuò","abbr":"gpmz","explanation":"高：高贵。高贵的朋友坐满了席位。形容宾客很多。","source":{"text":"千里逢迎，高朋满座。","book":"唐·王勃《滕王阁序》"},"example":{"text":"邕～，闻粲至，倒履迎之。","book":"明·罗贯中《三国演义》第四十回"},"similar":["宾客盈门"],"opposite":["门庭冷落"],"usage":"作谓语；形容宾客很多","story":["“初唐四杰”的王勃因《檄英王鸡》得罪了唐高宗而被放逐，他到交趾探望父亲路经洪州，恰逢重阳节，洪州都督阎伯屿大宴宾客，高朋满座，吟诗作乐，王勃即兴作《滕王阁序》：“物华天宝，龙光射斗牛之墟，人杰地灵，徐孺下陈蕃之榻。”"]},{"id":48274,"word":"高材捷足","pinyin":"gāo cái jié zú","abbr":"gcjz","explanation":"高材：才能高；捷足：迈步快。形容人才能出众，行事敏捷。","source":{"text":"秦失其鹿，天下共逐之，于是高材疾足者先得焉。","book":"《史记·淮阴侯列传》"},"example":{"text":"有力量者十二首都作也可；不能的作一首也可。～者为尊。","book":"清·曹雪芹《红楼梦》第三十七回"},"similar":["高才捷足"],"usage":"作谓语、定语、补语；形容人才能出众","story":["楚汉相争时期，刘邦与项羽争夺王位一直不分胜负，韩信可以与他们三分鼎足，蒯通劝他说：“秦失其鹿，天下共逐之，只有高材捷足者先得之。”韩信却选择了帮助刘邦，结果被吕后骗进长乐宫杀害。韩信到临死时才后悔没听蒯通的话"]},{"id":48275,"word":"高材疾足","pinyin":"gāo cái jí zú","abbr":"gcjz","explanation":"高材：才能高；疾足：迈步快。形容人才能出众，行事敏捷。","source":{"text":"秦失其鹿，天下共逐之，于是高材疾足者先得焉。","book":"《史记·淮阴侯列传》"},"example":{"text":"明·无名氏《杨家将演义》第一卷：“鹿之逸奔，～者得之。”"},"similar":["高材捷足","高才疾足"],"usage":"作谓语、定语、补语；形容人才能出众","story":["楚汉相争时期，刘邦与项羽争夺王位一直不分胜负，韩信可以与他们三分鼎足，蒯通劝他说：“秦失其鹿，天下共逐之，只有高材捷足者先得之。”韩信却选择了帮助刘邦，结果被吕后骗进长乐宫杀害。韩信到临死时才后悔没听蒯通的话"]},{"id":48276,"word":"高枕不虞","pinyin":"gāo zhěn bù yú","abbr":"gzby","explanation":"虞：忧患。垫高枕头睡觉，无忧无虑。比喻思想麻痹，丧失警惕。","source":{"text":"戎狄弃甲而远遁，朝廷高枕而不虞。","book":"唐·韩愈《与风翔刑尚书书》"},"similar":["高枕无虞","高枕无事","高枕无忧"],"usage":"作谓语、定语、状语；用于劝告、指责等场合"},{"id":48277,"word":"高枕勿忧","pinyin":"gāo zhěn wù yōu","abbr":"gzwy","explanation":"犹言高枕无忧。","source":{"text":"比丘曰：‘娘亲高枕勿忧。自古云兵来将挡，水来土淹。’","book":"《四游记·玉帝起来赛宝通明会》"},"similar":["高枕无忧","高枕无事","高枕无虞"],"usage":"作谓语、状语；用于劝告、指责等场合"},{"id":48278,"word":"高枕安卧","pinyin":"gāo zhěn ān wò","abbr":"gzaw","explanation":"垫高枕头安心地睡觉。形容无忧无虑。平安无事。","source":{"text":"止久至于太旱，试使人君高枕安卧，旱犹自雨。","book":"汉·王充《论衡·顺鼓》"},"similar":["高枕安寝","高枕而卧"],"usage":"作谓语；指无忧无虑"},{"id":48279,"word":"高枕安寝","pinyin":"gāo zhěn ān qǐn","abbr":"gzaq","explanation":"垫高枕头安心地睡觉。形容无忧无虑。平安无事。同“高枕而卧”。","source":{"text":"故北狄不服，中国未得高枕安寝也。","book":"《汉书·匈奴传下》"},"example":{"text":"与妇共视被中人，～，正是其形，了无一异。","book":"晋·陶潜《搜神后记》卷三"},"similar":["高枕而卧"],"usage":"作谓语、宾语；指无忧无虑"},{"id":48280,"word":"高枕无事","pinyin":"gāo zhěn wú shì","abbr":"gzws","explanation":"垫高了枕头睡觉，无忧无虑。比喻平安无事，不用担忧。","source":{"text":"度令分守边郡，贼迁可以计日成擒，朝廷可以高枕无事矣。","book":"宋·杨亿《论灵州事宜》"},"similar":["高枕无忧","高枕无虞","高枕勿忧"],"usage":"作谓语、定语、状语；用于劝告、指责等场合"},{"id":48281,"word":"高枕无忧","pinyin":"gāo zhěn wú yōu","abbr":"gzwy","explanation":"垫高枕头睡觉，无忧无虑。比喻思想麻痹，丧失警惕。","source":{"text":"事秦，则楚韩必不敢动，无楚韩之患，则大王高枕而卧，国必无忧矣。","book":"《战国策·魏策一》"},"example":{"text":"孔明已死，我等皆～矣。","book":"明·罗贯中《三国演义》第一百四回"},"similar":["无忧无虑","麻痹大意"],"opposite":["枕戈待旦"],"usage":"作谓语、状语；用于劝告、指责等场合","story":["战国时期，齐国丞相孟尝君叫门客冯谖到薛地去收债并顺便带回家里没有的东西，冯谖到了薛地以孟尝君的名义免除了他们所有的债务，回来报告说买回一个“义”字。孟尝君被免职后回薛地居住，百姓热烈欢迎，冯谖建议还要办两件大事"]},{"id":48282,"word":"高枕无虞","pinyin":"gāo zhěn wú yú","abbr":"gzwy","explanation":"虞：忧患。垫高枕头睡觉，无忧无虑。","source":{"text":"戎狄弃甲而远遁，朝廷高枕而不虞。","book":"唐·韩愈《与风翔刑尚书书》"},"example":{"text":"天子惟务择人而任之，则～矣。","book":"唐·陆贽《请减京东水运收脚价于松边州镇储蓄军粮事宜状》"},"similar":["高枕不虞","高枕无忧","高枕无事"],"usage":"作谓语、定语、状语；用于劝告、指责等场合"},{"id":48283,"word":"高枕而卧","pinyin":"gāo zhěn ér wò","abbr":"gzew","explanation":"垫高枕头安心地睡觉。形容无忧无虑。平安无事。","source":{"text":"事秦，则楚韩必不敢动；无楚韩之患，则大王高枕而卧，国必无忧矣。","book":"《战国策·魏策一》"},"example":{"text":"有贤于此，朝廷之上始可～，岂可遽以和好自安妥也？","book":"明·李贽《续焚书·杂著汇》"},"similar":["高枕无忧"],"opposite":["忧心忡忡","提心吊胆"],"usage":"作谓语；指无忧无虑","story":["战国时期齐国相国孟尝君叫门客冯湲去薛地收债并顺便买回家里缺的东西，冯湲假借孟尝君的命令把债契全部烧毁，借债的百姓对孟尝君感激涕零。冯湲回来说：“狡兔有三窟，仅得免其死耳；今君有一窟，未得高枕而卧也。”"]},{"id":48284,"word":"高标卓识","pinyin":"gāo biāo zhuó shí","abbr":"gbzs","explanation":"卓：卓越。高深的造诣，卓越的才识。","source":{"text":"因读明翁绝句，有云：‘留取葡萄浮大白，肯将容易博凉州。’叹其高标卓识，为之爽然自失。","book":"宋·刘克庄《跋赵明翁诗稿》"}},{"id":48285,"word":"高楼大厦","pinyin":"gāo lóu dà shà","abbr":"glds","explanation":"厦：高大的房子。指高耸的楼房。","source":{"text":"为开第康庄之衢，高门大屋，尊宠之。","book":"《史记·孟子荀卿列传》"},"example":{"text":"亲戚同～，朋友共肥马轻车。","book":"元·无名氏《九世同居》第一折"},"similar":["高堂大厦","高堂广厦"],"usage":"作主语、宾语、定语；指高大的建筑"},{"id":48286,"word":"高歌猛进","pinyin":"gāo gē měng jìn","abbr":"ggmj","explanation":"高声歌唱，勇猛前进。形容在前进的道路上，充满乐观精神。","source":{"text":"我国广告业高歌猛进。","book":"《解放日报》1996.6.13"},"example":{"text":"中国的体育健儿正再接再厉，高歌猛进。"},"similar":["勇往直前","一往直前"],"opposite":["裹足不前","垂头丧气"],"usage":"作谓语；形容情绪高涨"},{"id":48287,"word":"高步云衢","pinyin":"gāo bù yún qú","abbr":"gbyq","explanation":"步：行走；衢：大路；云衢：云中大路，比喻显位。原指官居显位。后也指科举登第。","source":{"text":"郤诜工韫价州里，褎然应召，对扬天问，高步云衢，求之前哲，亦足称矣。","book":"《晋书·郤诜传论》"},"example":{"text":"《晋书·郤诜传论》：“郤诜工韫价州里，褎然应召，对扬天问，高步云衢，求之前哲，亦足称矣。”"},"similar":["高步通衢"],"usage":"作谓语；指官居显位"},{"id":48288,"word":"高步通衢","pinyin":"gāo bù tōng qú","abbr":"gbtq","explanation":"衢：大路。原指官居显位。后也指科举登第。同“高步云衢”。","source":{"text":"朕闻良臣如猛兽，高步通衢而豺狼避路，信矣哉！","book":"《石季龙载记上》"},"similar":["高步云衢"],"usage":"作谓语；指官居显位"},{"id":48289,"word":"高步阔视","pinyin":"gāo bù kuò shì","abbr":"gbks","explanation":"形容气慨不凡或态度傲慢。同“高视阔步”。","source":{"text":"果见一丈夫魋肩昂背，高步阔视，持大扇击手作拍板，口唱《大江东》，于于然来。群鬼尽散。","book":"清·袁枚《新齐谐·冷秋江》"},"example":{"text":"闻一多《红烛·雪》：“～的风霜蹂躏世界。”"},"similar":["高视阔步"],"usage":"作谓语、定语、状语；指人的风度"},{"id":48290,"word":"高深莫测","pinyin":"gāo shēn mò cè","abbr":"gsmc","explanation":"高深的程度无法揣测。形容使人难以理解。","source":{"text":"吏民莫能测其意深浅，战栗不敢犯禁。","book":"《汉书·严延年传》"},"example":{"text":"他说话常故弄玄虚，使人感到～。"},"similar":["深不可测","不可捉摸"],"opposite":["一目了然"],"usage":"作谓语、定语；形容使人难以理解","story":["西汉时期，刚正不阿的涿郡太守严延年到任不久，听说地方高氏家族无恶不作，就派属官赵绣前去查办。赵绣想暗中包庇被严延年斩首。严延年断案与其他官员不同，专门治那些地方豪强。不论官吏还是老百姓都不能揣测出他的真实心思"]},{"id":48291,"word":"高深远度","pinyin":"gāo shēn yuǎn duǒ","abbr":"gsyd","explanation":"见识高超，忖度深远。","source":{"text":"宇文公文足经国，武可定乱。至于高识远度，非愚管所测。","book":"《周书·张轨传》"}},{"id":48292,"word":"高爵丰禄","pinyin":"gāo jué fēng lù","abbr":"gjfl","explanation":"爵：爵位；禄：古代官吏的俸给。爵位高，俸禄多。","source":{"text":"是高爵丰禄之所加也，荣孰大焉。将以为害邪？则高爵丰禄以持养之，生民之属，孰不愿也。","book":"战国·赵·荀况《荀子·议兵》"},"similar":["高爵厚禄","高爵重禄"],"usage":"作主语、宾语、定语；用于地位、待遇等"},{"id":48293,"word":"高爵厚禄","pinyin":"gāo jué hòu lù","abbr":"gjhl","explanation":"泛指爵位高，俸禄厚。同“高爵重禄”。","source":{"text":"盖恃宫掖之宠，接宴私之欢，高爵厚禄骄其内，声色服玩惑于外，莫知师友之训，不达危亡之道。","book":"《旧唐书·外威传序》"},"example":{"text":"～居不忝，腰悬金印称公侯。","book":"清·林昌彝《亭槛词》"},"similar":["高爵丰禄","高爵重禄"],"usage":"作主语、宾语、定语；用于地位、待遇等"},{"id":48294,"word":"高爵显位","pinyin":"gāo jué xiǎn wèi","abbr":"gjxw","explanation":"爵：爵位，官爵；显：显要，显赫。官职很高，爵位显赫。","source":{"text":"由是观之，则今之高爵显位，一旦抵罪，或脱身以逃……其辱人贱行，视五人之銕，轻重固何如哉？","book":"明·张溥《五人墓碑记》"},"similar":["高官尊爵","高官显爵","贵官显宦"],"usage":"作谓语、宾语、定语；指官位高"},{"id":48295,"word":"高爵重禄","pinyin":"gāo jué zhòng lù","abbr":"gjzl","explanation":"爵：爵位，官爵；禄：俸禄。泛指爵位高，俸禄厚。","source":{"text":"看官们，你道征伐是一刀一枪事业，胜负未分，晋王乃隋亲王，高爵重禄，有甚不安逸，却要做此事？","book":"清·褚人获《隋唐演义》第一回"},"example":{"text":"宋·王安石《第四札子》：“人臣自度其智力足以胜任而塞责，故受其～而无愧。”"},"similar":["高爵丰禄","高爵厚禄"],"usage":"作主语、宾语、定语；用于地位、待遇等"},{"id":48296,"word":"高牙大纛","pinyin":"gāo yá dà dào","abbr":"gydd","explanation":"纛：古代军队里的大旗。指军中的旗帜。比喻声势显赫。","source":{"text":"然则高牙大纛，不足为公荣。","book":"宋·欧阳修《相州昼锦堂记》"},"example":{"text":"～，来威江汉之滨；闲馆珍台，去蹑星辰之上。","book":"宋·张孝祥《荆南宴交代方阁学》"},"usage":"作宾语；指居高位者的仪仗"},{"id":48297,"word":"高睨大谈","pinyin":"gāo nì dà tán","abbr":"gndt","explanation":"睨：视。眼睛看着上面，在发议论。形容举动言论气慨不凡。","source":{"text":"方将师天老而友地典，与之乎高睨而大谈。","book":"汉·张衡《应间》"},"example":{"text":"平居爱客置酒，雅歌投壶，～，终日不倦。","book":"清·黄宗羲《蒋氏三世传》"},"similar":["高谈阔论"],"usage":"作谓语；形容举止气慨不凡"},{"id":48298,"word":"高瞻远瞩","pinyin":"gāo zhān yuǎn zhǔ","abbr":"gzyz","explanation":"瞻：视，望；瞩：注视。站得高，看得远。比喻眼光远大。","source":{"text":"夫闭户塞意，不高瞻览者，死人之徒也哉。","book":"汉·王充《论衡·别通篇》"},"example":{"text":"他们的切身的问题，也使他们无暇去～的去关心与分析世界问题。","book":"老舍《四世同堂》七十三"},"similar":["登高望远"],"opposite":["鼠目寸光","目光如豆"],"usage":"作谓语、状语、定语；比喻目光远大"},{"id":48299,"word":"高翔远引","pinyin":"gāo xiáng yuǎn yǐn","abbr":"gxyy","explanation":"形容避世隐居。","source":{"text":"向使郭隗倒悬而王不解，临溺而王不拯，则士亦将高翔远引，莫有北首燕路者矣。","book":"汉·孔融《与曹操论盛孝章书》"},"example":{"text":"象您这样的人才，要是～，就太可惜了。"},"similar":["高翔远翥"],"usage":"作谓语；指避世隐居"},{"id":48300,"word":"高翔远翥","pinyin":"gāo xiáng yuǎn zhù","abbr":"gxyz","explanation":"形容避世隐居。","source":{"text":"向使郭隗倒悬而王不解，临溺而王不拯，则士亦将高翔远引，莫有北首燕路者矣。","book":"汉·孔融《与曹操论盛孝章书》"},"example":{"text":"灵乌灵乌尔之为禽兮，何不高翔而远翥，何为号呼于人兮。","book":"宋·范仲淹《灵乌赋》"},"similar":["高翔远引"],"usage":"作谓语；指避世隐居"},{"id":48301,"word":"高而不危","pinyin":"gāo ér bù wēi","abbr":"gebw","explanation":"身居高位而没有倾覆的危险。","source":{"text":"高而不危，所以常守贵也；满而不溢，所以长守富也。","book":"《孝经·诸侯章》"},"example":{"text":"《新五代史·高从诲传》：“在上不骄，～，制节谨度，满而不溢。”"},"usage":"作谓语、定语；用于为人"},{"id":48302,"word":"高耸入云","pinyin":"gāo sǒng rù yún","abbr":"gsry","explanation":"耸：直立，高起。高高地直立，直入云端。形容建筑物、山峰等高峻挺拔。","source":{"text":"翻越了高耸入云的雪山，跋涉了渺无人烟的草原。","book":"刘伯承《回忆长征》"},"example":{"text":"～的世贸大厦已经在911中消失了。"},"similar":["直插云霄","高耸云霄"],"usage":"作谓语、定语；形容建筑物、山峰等"},{"id":48303,"word":"高自位置","pinyin":"gāo zì wèi zhì","abbr":"gzwz","explanation":"比喻自己把自己看得很了不起。","source":{"text":"恒温尝问惔：‘会稽王谈更进邪？’惔曰：‘极进，然故第三流耳。’温曰：‘第一复谁？’惔曰：‘故在我辈。’其高自标置如此。","book":"《晋书·刘惔传》"},"example":{"text":"但是他又～，目空一切，自以为他的学问，谁都及不了他。","book":"清·吴趼人《二十年目睹之怪现状》第一○一回"},"similar":["自以为是","高自标置","高自期许"],"usage":"作谓语；指自己把自己看得很了不起"},{"id":48304,"word":"高自期许","pinyin":"gāo zì qī xǔ","abbr":"gzqx","explanation":"比喻自高自大，自以为是。","source":{"text":"而且高自期许，不肯屈居人下。","book":"蔡东藩《民国通俗演义》第123回"},"similar":["高自位置","高自标树","高自标置"],"opposite":["谦虚谨慎"],"usage":"作谓语；指自己把自己看得很了不起"},{"id":48305,"word":"高自标树","pinyin":"gāo zì biāo shù","abbr":"gzbs","explanation":"比喻自己把自己看得很了不起。同“高自标置”。","source":{"text":"淹究经术，性謇特，高自标树。","book":"《新唐书·王义方传》"},"similar":["高自标誉","高自标置","高自位置"],"usage":"作谓语；指自以为是"},{"id":48306,"word":"高自标置","pinyin":"gāo zì biāo zhì","abbr":"gzbz","explanation":"标置：放在某种位置。比喻自己把自己看得很了不起。","source":{"text":"恒温尝问惔：‘会稽王谈更进邪？’惔曰：‘极进，然故第三流耳。’温曰：‘第一复谁？’惔曰：‘故在我辈。’其高自标置如此。","book":"《晋书·刘惔传》"},"example":{"text":"只是为人却～的很，等闲的人，也入不得他的眼，其学问便可知了！","book":"清·文康《儿女英雄传》第四十回"},"similar":["自以为是","高自标树","高自标誉"],"opposite":["谦虚谨慎"],"usage":"作谓语；指自以为是"},{"id":48307,"word":"高自标誉","pinyin":"gāo zì biāo yù","abbr":"gzby","explanation":"比喻自己把自己看得很了不起。同“高自标置”。","source":{"text":"元美兄弟继作，高自标誉，大声壮语，吴中绮靡之习，因之一变。","book":"明·袁宏道《叙姜陆二公同适稿》"},"similar":["高自标置","高自标树","高自位置"],"usage":"作谓语；指自以为是"},{"id":48308,"word":"高自骄大","pinyin":"gāo zì jiāo dà","abbr":"gzjd","explanation":"自高自大。","source":{"text":"扬言两戎，高自骄大，罪五也。","book":"《魏书·沮渠蒙逊传》"},"similar":["自高自大"],"usage":"作谓语、定语、宾语；用于为人"},{"id":48309,"word":"高节清风","pinyin":"gāo jié qīng fēng","abbr":"gjqf","explanation":"高节：高尚的气节；清风：清廉的作风。气节高尚，作风清廉。比喻人品高洁。","source":{"text":"高节清风今已矣，英雄须识时宜。","book":"明·孙明孺《东郭记·人之所以求富贵利达者》"},"example":{"text":"正排着低品走狗奴才队，都做了～大英雄。","book":"清·孔尚任《桃花扇·听稗》"},"similar":["高风亮节"],"usage":"作谓语、宾语、定语；指人品"},{"id":48310,"word":"高节迈俗","pinyin":"gāo jié mài sú","abbr":"gjms","explanation":"高节：高尚的气节；迈俗：脱俗，超俗。气节高尚，超脱世俗。","source":{"text":"惇字思悛，孝友淳粹，高节迈俗。","book":"《晋书·江统传》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":48311,"word":"高见远识","pinyin":"gāo jiàn yuǎn shí","abbr":"gjys","explanation":"指见识高远。","source":{"text":"圣人高见远识，固不可以小智测度也。","book":"宋·赵彥卫《云麓漫钞》卷十"},"example":{"text":"元直如此～，谅此有何难哉！","book":"《三国演义》第四八回"},"similar":["卓见远识"],"opposite":["短见拙识"],"usage":"作谓语、宾语、定语；用于夸奖称赞等"},{"id":48312,"word":"高视阔步","pinyin":"gāo shì kuò bù","abbr":"gskb","explanation":"眼睛向上看，迈大步走路。形容气慨不凡或态度傲慢。","source":{"text":"俄而抵掌扬眉，高视阔步。","book":"《隋书·卢思道传》"},"example":{"text":"那黑猫是不能久在矮墙上～的了，我决定的想。于是又不由的一瞥那藏在书箱里的一瓶青酸钾。","book":"鲁迅《呐喊·兔和猫》"},"similar":["昂首阔步","神气活现"],"opposite":["鹅行鸭步","低三下四"],"usage":"作谓语、定语、状语；指人的风度"},{"id":48313,"word":"高识远度","pinyin":"gāo shí yuǎn duǒ","abbr":"gsyd","explanation":"度：揣度，忖度。见识高超，思虑深远。","source":{"text":"宇文公文足经国，武可定乱。至于高识远度，非愚管所测。","book":"《周书·张轨传》"},"similar":["高识远见"],"usage":"作谓语、宾语、定语；用于夸奖人"},{"id":48314,"word":"高识远见","pinyin":"gāo shí yuǎn jiàn","abbr":"gsyj","explanation":"指见识高远。同“高见远识”。","source":{"text":"其高识远见，甚非常人所能及者。","book":"宋·王楙《野客丛书·王珪母妻识见》"},"example":{"text":"况他元是鄱阳大盗出身，无甚么～。","book":"元·尚仲贤《气英布》第二折"},"similar":["高识远度","高见远识"],"opposite":["短见拙识"],"usage":"作谓语、宾语、定语；用于夸奖人"},{"id":48315,"word":"高谈剧论","pinyin":"gāo tán jù lùn","abbr":"gtjl","explanation":"剧：剧烈，激烈。高深空洞的言谈，激烈的辩论。","source":{"text":"相对围棋看胜负，更听弹琴一曲。尔汝忘形，高谈剧论，莫遣人来促。","book":"宋·沈赢《念奴娇》词"},"similar":["高谈阔论"],"usage":"作谓语、宾语、定语；指空谈"},{"id":48316,"word":"高谈大论","pinyin":"gāo tán dà lùn","abbr":"gtdl","explanation":"指不切实际的言谈、议论。","source":{"text":"江西学者自以为得陆删定之学，便高谈大论，略无忌惮。","book":"宋·朱熹《朱子语类》第120卷"},"example":{"text":"我常想着到村里听庄稼人说两句愚拙的话语，胜过在都邑里领受那些智者底～。","book":"许地山《空山灵雨·乡曲底狂言》"},"similar":["高谈阔论"],"opposite":["沉默寡言"],"usage":"作谓语、宾语；指不切实际的言谈"},{"id":48317,"word":"高谈弘论","pinyin":"gāo tán hóng lùn","abbr":"gthl","explanation":"弘：大。高深空洞不切实际的谈论。","source":{"text":"尝疾俗儒高谈弘论，不切时务。","book":"晋·袁宏《后汉记》第四卷"},"example":{"text":"你最好不要在这样发～。"},"similar":["高谈大论"],"usage":"作宾语；指指不切实际的言谈"},{"id":48318,"word":"高谈虚论","pinyin":"gāo tán xū lùn","abbr":"gtxl","explanation":"高妙空洞、不切空际的议论。","source":{"text":"不图大事，贪利而动，以高谈虚论，说于人主，王者慎勿使。","book":"《六韬·上贤》"},"example":{"text":"是知济弱扶倾术，不属～人。","book":"唐·周昙《咏史诗·晋六·王夷甫》"},"similar":["高谈虚辞","高谈虚议","虚谈高论"],"usage":"作谓语、宾语、定语；用于谈话等"},{"id":48319,"word":"高谈虚辞","pinyin":"gāo tán xū cí","abbr":"gtxc","explanation":"虚：空虚。高妙空洞，不切实际的言辞。","source":{"text":"不图大事得利，而动以高谈虚论说于人主，王者慎勿使。","book":"《六韬·文韬·上贤》"},"example":{"text":"故货食者，人事之确论，非～之可致也。","book":"宋·张方平《论国什》"},"similar":["高谈虚论","虚论高议","虚谈高论"],"usage":"作谓语、宾语、定语；用于谈话等"},{"id":48320,"word":"高谈阔论","pinyin":"gāo tán kuò lùn","abbr":"gtkl","explanation":"高：高深；阔：广阔。多指不着边际地大发议论。","source":{"text":"高谈阔论若无人，可惜明君不遇真。","book":"唐·吕岩《徽宗斋会》"},"example":{"text":"柴进～，一片言语，娄敏中大喜，就留柴进在相府管待。","book":"明·施耐庵《水浒全传》第一百十六回"},"similar":["夸夸其谈","侃侃而谈"],"opposite":["一言不发","沉默寡言"],"usage":"作谓语、宾语、定语；指范围广泛地谈论"},{"id":48321,"word":"高谈雄辩","pinyin":"gāo tán xióng biàn","abbr":"gtxb","explanation":"大发议论，长于说理。形容能言善辩。","source":{"text":"焦遂五斗方卓然，高谈雄辩惊四筵。","book":"唐·杜甫《饮中八仙歌》"},"example":{"text":"周庸祐与各亲朋正自～，忽冯少伍走近身旁，附耳说了几句话，周庸祐登时面色变了。","book":"清·黄小配《廿载繁华梦》第二十八回"},"similar":["能言善辩"],"usage":"作谓语；形容能言善辩"},{"id":48322,"word":"高谈雅步","pinyin":"gāo tán yǎ bù","abbr":"gtyb","explanation":"高谈：广博无拘束的谈论；雅步：文雅的举止。无拘无束地谈论，举止文雅。","source":{"text":"光车骏马游都城，高谈雅步何盈盈。","book":"晋·陆机《百年歌》"},"usage":"作宾语、定语；用于人的言行"},{"id":48323,"word":"高谭清论","pinyin":"gāo tán qīng lùn","abbr":"gtql","explanation":"谭：同“谈”。高妙清正而空泛不实的言谈。","source":{"text":"到叶见霸，不问县事，但高谭清论，以激励之。","book":"《东观汉记·赵勤传》"},"usage":"作宾语、定语；用于说话等"},{"id":48324,"word":"高足弟子","pinyin":"gāo zú dì zǐ","abbr":"gzdz","explanation":"高足：高才，称呼别人学生的敬辞。成绩优异的学生。","source":{"text":"郑玄在马融门下，三年不得相见，高足弟子传授而已。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"亨阳则李安溪～。","book":"清·陈康祺《郎潜纪闻》第九卷"},"similar":["得意门生","高业弟子"],"usage":"作宾语；指成绩优异的学生"},{"id":48325,"word":"高蹈远举","pinyin":"gāo dǎo yuǎn jǔ","abbr":"gdyj","explanation":"意为隐居避世。","source":{"text":"穆生高蹈远举，意盖有在，逆知异日必不能免，非知几畴克尔哉。","book":"宋·王楙《野客丛书·穆生邹阳》"},"example":{"text":"是以～，全身远害，飘然不恋爵禄，走上太行。","book":"明·无名氏《杨家将演义》第五十八回"},"similar":["高举远蹈"],"usage":"作谓语；指隐居避世"},{"id":48326,"word":"高蹈远引","pinyin":"gāo dǎo yuǎn yǐn","abbr":"gdyy","explanation":"蹈：踩上；引：避开。指远离官场，隐居起来。","source":{"text":"况乎以一时之喜怒，以一人之爱憎，而欲视天下高蹈远引之士，混俗和光之徒，皮毛臭秽之夫，如周丘其人者哉！","book":"明·李贽《焚书·复焦弱侯》"},"similar":["高举远蹈","高举远去","高蹈远举"],"usage":"作谓语、宾语、定语；指退隐"},{"id":48327,"word":"高躅大年","pinyin":"gāo zhú dà nián","abbr":"gzdn","explanation":"躅：足迹，引申为行为，品行。品德高尚而年纪高迈。","source":{"text":"虽高躅大年，不复劳以朝请，而国有大故，当就咨询。","book":"陶菊隐《北洋军阀统治时期史话》第17章"},"usage":"作宾语、定语；用于书面语"},{"id":48328,"word":"高车大马","pinyin":"gāo chē dà mǎ","abbr":"gcdm","explanation":"高车：车盖很高的车。四匹马驾驶的、车盖很高的车。形容高官显贵的阔绰。","source":{"text":"诘旦天门传奏章，高车大马来煌煌。","book":"唐·李商隐《偶成赠四同舍》"},"example":{"text":"不过头儿尖些，手儿长些，心儿黑些，便一个个～，鼎烹肉食起来！","book":"曾朴《孽海花》第五回"},"similar":["高车驷马"],"usage":"作宾语、定语；形容高官显贵的阔绰"},{"id":48329,"word":"高车驷马","pinyin":"gāo chē sì mǎ","abbr":"gcsm","explanation":"四匹马驾驶的、车盖很高的车。旧时形容高官显贵的阔绰。","source":{"text":"范睢归取大车驷马，为须贾御之，入秦相府。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"～，金章紫绶，传语渠侬稳便。","book":"宋·辛弃疾《鹊桥仙·席上和赵晋臣敷文》"},"similar":["高车大马"],"usage":"作宾语、定语；形容高官显贵的阔绰"},{"id":48330,"word":"高遏行云","pinyin":"gāo è xíng yún","abbr":"gexy","explanation":"形容歌声高亢嘹亮。","source":{"text":"偶学念奴声调，有时高遏行云。","book":"宋·晏殊《山亭柳》词"},"similar":["响遏行云"],"usage":"作宾语、定语、补语；形容歌声嘹亮"},{"id":48331,"word":"高门大屋","pinyin":"gāo mén dà wū","abbr":"gmdw","explanation":"高门：指富贵之家；大屋：高大的房屋。指豪门之家。","source":{"text":"皆命曰列大夫，为开第康庄之衢，高门大屋，尊宠之。","book":"西汉·司马迁《史记·孟子荀卿列传》"},"similar":["高门大族"],"usage":"作宾语、定语；指有钱有势的人家"},{"id":48332,"word":"高门大户","pinyin":"gāo mén dà hù","abbr":"gmdh","explanation":"高门：旧时指富贵之家；大户：声势显赫的家族。有钱有势的人家。","source":{"text":"为开第康庄之衢，高门大屋，尊宠之。","book":"《史记·孟子荀卿列传》"},"example":{"text":"因他是个市户出身，一时没有高门大族来求他的。","book":"明·凌濛初《二刻拍案惊奇·满少卿饥附饱扬》"},"similar":["名门大户","高门大屋"],"usage":"作宾语、定语；指有钱有势的人家"},{"id":48333,"word":"高门大族","pinyin":"gāo mén dà zú","abbr":"gmdz","explanation":"高门：显贵的家族；大族：声势煊赫的家族。高贵的、地位显要的家庭或有特权的家族。","source":{"text":"因他是个市户出身，一时没有高门大族来求他的。","book":"明·凌濛初《二刻拍案惊奇》第11卷"},"similar":["名门大族","高门巨族"],"usage":"作主语、宾语、定语；指有名望的人"},{"id":48334,"word":"高门巨族","pinyin":"gāo mén jù zú","abbr":"gmjz","explanation":"高门：显贵的家族。高贵的、地位显要的家庭或有特权的家族。","source":{"text":"所描写的绝不相同的人物，也就是世态的一角，高门巨族的精魂。","book":"鲁迅《小说二集序》"},"similar":["高门大族"],"usage":"作主语、宾语、定语；指有名望的人"},{"id":48335,"word":"高阳公子","pinyin":"gāo yáng gōng zǐ","abbr":"gygz","explanation":"高阳：地名，在今河南杞县。用以指嗜酒而放荡不羁的人。","source":{"text":"高阳公子休闲过，不比寻常卖酒家。","book":"元·康进之《李逵负荆》第一折"},"similar":["高阳酒徒"],"usage":"作主语、宾语、定语；指嗜酒而放荡不羁的人"},{"id":48336,"word":"高阳酒徒","pinyin":"gāo yáng jiǔ tú","abbr":"gyjt","explanation":"高阳：古乡名，在今河南杞县西南。秦末郦食其即此乡人，对刘邦自称“高阳酒徒”。用以指嗜酒而放荡不羁的人。","source":{"text":"走！复入言沛公，吾高阳酒徒也，非儒人也。","book":"《史记·郦生陆贾列传》"},"example":{"text":"君不见～起草中，长揖山东隆准公。","book":"唐·李白《梁甫吟》"},"similar":["高阳公子"],"usage":"作主语、宾语、定语；指嗜酒而放荡不羁的人","story":["秦朝末年，刘邦驻守陈留县，当地穷书生郦食其才学过人，前去投奔刘邦，刘邦听说来者是儒生就不接见。郦食其气愤地握剑对侍者说自己是高阳酒徒，刘邦一听赶忙接见。后来郦食其成为刘邦的得力谋士，为刘邦一统天下而出谋划策"]},{"id":48337,"word":"高雅闲淡","pinyin":"gāo yǎ xián dàn","abbr":"gyxd","explanation":"高妙雅正，安闲恬淡。","source":{"text":"其五言诗，又高雅闲淡，自成一家之体。","book":"唐·白居易《与元九书》"},"usage":"作谓语、定语；用于作品或生活等"},{"id":48338,"word":"高雅闲谈","pinyin":"gāo yǎ xián tán","abbr":"gyxt","explanation":"高奥奇妙，儒雅端正，安闲恬淡。一般多形容诗文风格。","source":{"text":"其五言诗，又高雅闲淡，自成一家之体。","book":"唐·白居易《与元九书》"}},{"id":48339,"word":"高顾遐视","pinyin":"gāo gù xiá shì","abbr":"ggxs","explanation":"向高远处看。意谓志向高远，傲视流俗。","source":{"text":"某鄙朴戆讷，言行不能及古人，器识不足以达时务，然守愚，孑然莫与，徒望望然高顾遐视而不合于时，此固流俗之所笑且讪，士君子之所不敢自是者也。","book":"明·方孝孺《答俞敬德书》"},"usage":"作谓语、定语；用于为人"},{"id":48340,"word":"高风亮节","pinyin":"gāo fēng liàng jié","abbr":"gflj","explanation":"高风：高尚的品格；亮节：坚贞的节操。形容道德和行为都很高尚。","source":{"text":"余谓渊明高风峻节，固已无愧于四皓，然犹仰慕之，尤见其好贤尚友之情也。","book":"宋·胡仔《苕溪渔隐从话后集》卷一"},"example":{"text":"蓝先生不佩服世界史中的任何圣哲与伟人，因而也就不去摹仿他们的～。","book":"老舍《四世同堂》二十三"},"similar":["高风峻节"],"opposite":["卑鄙无耻","卑鄙龌龊"],"usage":"作主语、宾语、定语；形容道德和行为","story":["汉武帝时，匈奴单于即位，想与汉朝改善关系。汉武帝派苏武作为使节访问匈奴，由于匈奴内部变故，单于扣押了苏武，百般折磨他，让降将张胜、李陵来劝降他，苏武坚贞不屈，高风亮节，誓死不降，受到人们的尊重和爱戴"]},{"id":48341,"word":"高风伟节","pinyin":"gāo fēng wěi jié","abbr":"gfwj","explanation":"高风：高尚的品格。高尚的品德，坚贞的节操。比喻道德和行为都很高尚。","source":{"text":"先生暮年虽复见扼于用事者，屏置海外以殁，而高风伟节讫今传述于吴越人士之口。","book":"清·汪琬《耒虞先生年谱后序》"},"similar":["高风亮节"],"usage":"作主语、宾语、定语；形容道德和行为"},{"id":48342,"word":"高风劲节","pinyin":"gāo fēng jìn jié","abbr":"gfjj","explanation":"形容高尚坚贞的风骨节操。同“高风峻节”。","source":{"text":"那饮药谯玄，纳肝弘演，高风劲节真堪羡，沧溟波浪能几枯，岁寒松柏何曾变。","book":"明·邵璨《香囊记·潜回》"},"example":{"text":"五十年～，可以想见。","book":"明·归有光《曹节妇碑阴》"},"similar":["高风峻节"],"usage":"作宾语、定语；指人品"},{"id":48343,"word":"高风峻节","pinyin":"gāo fēng jùn jié","abbr":"gfjj","explanation":"高风：纯洁清高的风格；峻节：坚定不移的节操。形容高尚坚贞的风骨节操。","source":{"text":"余谓渊明高风峻节，固已无愧于四皓，然犹仰慕之，尤见其好贤尚友之情也。","book":"宋·胡仔《苕溪渔隐从话后集》卷一"},"similar":["高风亮节","高风劲节"],"opposite":["卑鄙无耻"],"usage":"作宾语、定语；指人品"},{"id":48344,"word":"高飞远举","pinyin":"gāo fēi yuǎn jǔ","abbr":"gfyj","explanation":"举：飞、去。飞得又高又远。比喻前程远大。","source":{"text":"鸿鹄高飞远翔，其所恃者六翮也。","book":"汉·刘向《说苑·八·尊贤·十三节》"},"example":{"text":"中多可用之材，而视此畏途，～。","book":"明·徐光启《钦奉明旨条画屯田疏》"},"similar":["远走高飞","远举高飞"],"usage":"作谓语；指前程广大"},{"id":48345,"word":"高飞远翔","pinyin":"gāo fēi yuǎn xiáng","abbr":"gfyx","explanation":"飞得既高有远。比喻前程远大。","source":{"text":"鸿鹄高飞远翔，其所恃对者六翮也。","book":"汉·刘向《说苑·尊贤》"},"similar":["鹏程万里"],"usage":"作谓语、状语；用于比喻句"},{"id":48346,"word":"高飞远走","pinyin":"gāo fēi yuǎn zǒu","abbr":"gfyz","explanation":"形容离开某地，逃避到远处去。","source":{"text":"汝独不欲修之，宁能高飞远走，不在人间邪?","book":"《后汉书·卓茂传》"},"example":{"text":"《后汉书·卓茂传》：“汝独不欲修之，宁能高飞远走，不在人间邪?”"},"similar":["远走高飞"],"usage":"作主语、宾语、定语；形容彻底离开某地"},{"id":48347,"word":"高飞远遁","pinyin":"gāo fēi yuǎn dùn","abbr":"gfyd","explanation":"躲避到远方去，摆脱不利环境。","source":{"text":"欲高飞而远集兮，君罔谓女何之？","book":"战国·楚·屈原《九章·惜诵》"},"example":{"text":"事不宜迟，趁早～，不要连累别人。","book":"清·孔尚任《桃花扇·辞院》"},"similar":["高飞远集","高飞远走"],"usage":"作谓语、宾语、定语；用于处事"},{"id":48348,"word":"高飞远集","pinyin":"gāo fēi yuǎn jí","abbr":"gfyj","explanation":"制摆脱不利的环境，躲避到远防去。","source":{"text":"欲高飞而远集兮，恐离罔而灭败。","book":"语出战国·楚·屈原《九章·惜诵》：“欲高飞而远集兮，君罔谓女何之？”汉·东方朔《七谏·怨世》"},"example":{"text":"汉·东方朔《七谏·怨世》：“欲～兮，恐离罔而灭败。”"},"similar":["高飞远遁","高飞远走","高飞远举"],"usage":"作谓语、宾语、定语；用于处事"},{"id":48349,"word":"高高兴兴","pinyin":"gāo gāo xìng xìng","abbr":"ggxx","explanation":"由来自乐观的性情或由一些特殊的快乐原因产生的生气勃勃和乐观的高兴情绪。","source":{"text":"且说薛姨妈闻知湘莲已说定了尤三姐为妻，心中甚喜，正是高高兴兴要打算替他买房子，治家伙，择吉迎娶。","book":"清·曹雪芹《红楼梦》第67回"},"example":{"text":"在气象一新、大家都满意、大家～的情况下，工作好做。","book":"邓小平《提倡深入细致的工作》"},"similar":["兴高采烈"],"opposite":["愁眉苦脸"],"usage":"作谓语、定语、状语；指人的情绪"},{"id":48350,"word":"高高在上","pinyin":"gāo gāo zài shàng","abbr":"ggzs","explanation":"原指地位高，现在形容领导者脱离实际，脱离群众。","source":{"text":"无曰高高在上，陟降厥士，日监在兹。","book":"《诗经·周颂·敬之》"},"example":{"text":"有着理智的青年朋友们眼看部长～，“三青团”爪牙虎视眈眈，也只有沉默装傻而已。","book":"邹韬奋《患难余生记》第二章"},"similar":["居高临下","不可一世"],"opposite":["打成一片"],"usage":"作谓语、定语；形容领导者脱离实际"},{"id":48351,"word":"高鸟尽，良弓藏","pinyin":"gāo niǎo jìn，liáng gōng cáng","abbr":"gnjlgc","explanation":"比喻功成事定之后，出力的人反而见弃，没有好下场。","source":{"text":"狡兔得而猎犬烹，高鸟尽而良弓藏，名成功遂身退，天道然也。","book":"《文子·上德》"},"example":{"text":"鄙语有之：‘～；狡兔殚，猎犬烹。’故文种诛于句践，韩白戮于秦汉。","book":"《晋书·刘牢之传》"},"similar":["鸟尽弓藏","飞鸟尽，良弓藏"],"usage":"作宾语、定语；用于处事"},{"id":48352,"word":"鬓丝禅榻","pinyin":"bìn sī chán tà","abbr":"bsct","explanation":"鬓丝：鬓发如丝；禅榻：僧床。本指老僧的生活。也指老年人所过的近似僧徒的清静生活。","source":{"text":"今日鬓丝禅榻畔，茶烟轻飏落花风。","book":"唐·杜牧《题禅院》"},"example":{"text":"～寻常死，凑绝南朝第一僧。","book":"柳亚子《哭苏曼殊》"},"usage":"作宾语；用于老年人"},{"id":48353,"word":"鬓乱钗横","pinyin":"bìn luàn chāi héng","abbr":"blch","explanation":"鬓：耳边的头发；钗：妇女的首饰，由两股合成。耳边的头发散乱，首饰横在一边。形容妇女睡眠初醒时未梳妆的样子。","source":{"text":"青冥风霜非人世，鬓乱钗横特地寒。","book":"宋·王安石《扇子词》"},"example":{"text":"争奈一段伤心画不能，肋斗上泪痕粉渍定，没颜色～。","book":"元·乔孟符《两世姻缘》第二折"},"similar":["钗横鬓乱"],"usage":"作谓语、定语；用于女性"},{"id":48354,"word":"鬓影衣香","pinyin":"bìn yǐng yī xiāng","abbr":"byyx","explanation":"鬓：耳边的头发。形容女人的美丽和香艳。","source":{"text":"荡出兰挠挂楫，于意云何；传来鬓影衣香，谁能遣此？","book":"清·百一居士《壶天录》上卷"},"usage":"作宾语、定语；用于女性"},{"id":48355,"word":"鬻儿卖女","pinyin":"yù ér mài nǚ","abbr":"yemn","explanation":"鬻：卖。指生活无依，被迫卖掉自己的儿女。","source":{"text":"破家荡产，鬻儿卖女，时有所闻。","book":"清·李宝嘉《官场现形记》第47回"},"example":{"text":"旧社会老百姓～也还得不到温饱。"},"similar":["卖儿鬻女"],"usage":"作谓语、宾语、定语；指被生活所困"},{"id":48356,"word":"鬻声钓世","pinyin":"yù shēng diào shì","abbr":"ysds","explanation":"犹言沽名钓誉。","source":{"text":"诸子之徒，心非郁陶，苟驰夸饰，鬻声钓世，此为文而造情也。","book":"南朝·梁·刘勰《文心雕龙·情采》"},"similar":["沽名钓誉"],"usage":"作谓语、定语；用于处事"},{"id":48357,"word":"鬻官卖爵","pinyin":"yù guān mài jué","abbr":"ygmj","explanation":"鬻：卖。买卖官爵来收取钱财。","source":{"text":"朝廷乃至鬻官卖爵，以救灾困。","book":"《宋史·吴喜传》"},"similar":["卖官卖爵","卖官鬻爵"],"opposite":["任人唯贤"],"usage":"作谓语、定语；指官场腐败"},{"id":48358,"word":"鬻宠擅权","pinyin":"yù chǒng shàn quán","abbr":"ycsq","explanation":"凭借宠幸以卖弄权势。","source":{"text":"鬻宠擅权，矫外以胜内，险言祸福得失之形，以阿主之好恶。","book":"《韩非子·三守》"},"usage":"作谓语、定语；用于处事"},{"id":48359,"word":"鬻文获财","pinyin":"yù wén huò cái","abbr":"ywhc","explanation":"鬻：卖。指以写文章来换取财物。","source":{"text":"时议以为自古鬻文获财，未有如邕者。","book":"《旧唐书·文苑传·李邕》"}},{"id":48360,"word":"鬻矛誉楯","pinyin":"yù máo yù dùn","abbr":"ymyd","explanation":"指自相矛盾，不能两立。","source":{"text":"楚人有鬻楯与矛者，誉之曰：‘吾楯之坚，物莫能陷也。’又誉其矛曰：‘吾矛之利，於物无不陷也。’或曰：‘以子之矛陷子之楯何如？’其人弗能应也。","book":"语出《韩非子·难一》"},"example":{"text":"是楚人～，誉两难得而俱售也。","book":"南朝·梁·刘勰《文心雕龙·定势》"}},{"id":48361,"word":"鬻矛誉榡","pinyin":"yù máo yù dùn","abbr":"ymyd","explanation":"指自相矛盾，不能两立。","source":{"text":"楚人有鬻榡与矛者，誉之曰‘吾榡之坚，物莫能陷也。’又誉其矛曰‘吾矛之利，於物无不陷也。’或曰‘以子之矛陷子之榡何如？’其人弗能应也。","book":"语出《韩非子·难一》"},"quote":{"text":"是楚人～，誉两难得而俱售也。","book":"南朝·梁·刘勰《文心雕龙·定势》"}},{"id":48362,"word":"鬻矛誉盾","pinyin":"yù máo yù dùn","abbr":"ymyd","explanation":"鬻：卖；誉：赞美。自相矛盾，不能两立","source":{"text":"战国·韩·韩非《韩非子·难一》：“楚人有鬻盾与矛者，誉之曰：‘吾盾之坚，物莫能陷也。’又誉其矛曰：‘吾矛之利，于物无不陷也。’或曰：‘以子之矛陷子之盾何如？’其人弗能应"},"example":{"text":"南朝·梁·刘勰《文心雕龙·定势》：“是楚人～，两难得而俱售也。”"},"similar":["自相矛盾"],"usage":"作谓语、定语；用于处事","story":["战国时期，韩非子曾讲有一个卖矛和盾的人，见人推销他的矛是世界上最尖利的矛，没有穿不透的东西；一会又向人推销他的盾是世界上最坚硬的盾，没有什么东西能戳穿它。人群中有人问他用他的矛戳他的盾，他只好落荒而逃"]},{"id":48363,"word":"鬻良杂苦","pinyin":"yù liáng zá kǔ","abbr":"ylzk","explanation":"指出售货物时弄虚作假，以次充好。","source":{"text":"良，善也，先见良物，价定，而杂与恶物，以期惑下士之人。","book":"《文选·张衡〈西京赋〉》：“而乃商贾百族，裨贩夫妇，鬻良杂苦，蚩眩边鄙。”薛综注"},"usage":"作谓语、定语；用于处事"},{"id":48364,"word":"鬻驽窃价","pinyin":"yù nǔ qiè jià","abbr":"ynqj","explanation":"谦词。指劣货而获优评。","source":{"text":"昨者赍持恶赋，刺谒清尘，本期刘子俊待以盖瓯之地，陆士衡处置于抚掌之间，岂期以寸获长，鬻驽窃价。","book":"唐·黄滔《蒋先锋》"},"usage":"作谓语、定语；用于自谦"},{"id":48365,"word":"鬻鸡为凤","pinyin":"yù jī wéi fèng","abbr":"yjwf","explanation":"指以次充好，混淆优劣。","source":{"text":"伏念鬻鸡为凤，有识咸惊，投砾参琼，良知足鄙。","book":"唐·黄滔《谢试官》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":48366,"word":"鬼使神差","pinyin":"guǐ shǐ shén chāi","abbr":"gssc","explanation":"使、差：指使。好像有鬼神在支使着一样，不自觉地做了原先没想到要做的事。","source":{"text":"这一场悄促促似鬼使神差。","book":"元·无名氏《碧桃花》第四折"},"example":{"text":"正是呢，这是一高兴起灶，～来了这些人。","book":"清·曹雪芹《红楼梦》第四十九回"},"similar":["情不自禁","不由自主","身不由己"],"usage":"作谓语、宾语、状语；形容不由自主"},{"id":48367,"word":"鬼出电入","pinyin":"guǐ chū diàn rù","abbr":"gcdr","explanation":"比喻变化巧妙迅速，不易捉摸。","source":{"text":"鬼出电入，龙兴鸾集。","book":"《淮南子·原道训》"},"example":{"text":"～，不可端倪。","book":"清·纪昀《阅微草堂笔记·槐西杂志》"},"similar":["千变万化","鬼出神入","变幻莫测"],"usage":"作定语；形容变幻莫测"},{"id":48368,"word":"鬼出神入","pinyin":"guǐ chū shén rù","abbr":"gcsr","explanation":"比喻变化巧妙迅速，不易捉摸。同“鬼出电入”。","source":{"text":"饴蜜非甘，山川未阻，千变万化，鬼出神入。","book":"《隋书·卢思道传》"},"similar":["鬼出电入"],"usage":"作宾语、定语；形容变幻莫测"},{"id":48369,"word":"鬼刻神劖","pinyin":"guǐ kè shén chán","abbr":"gksc","explanation":"犹言鬼斧神工。形容艺术技巧高超，不是人力所能达到的。","source":{"text":"不知天壤此尤物，鬼刻神劖通有几？","book":"金·元好问《云峡》诗"},"example":{"text":"天荒地老无从问，～未解奇。","book":"元·刘边《伏羲洞》诗"},"similar":["鬼斧神工","鬼工雷斧"],"usage":"作宾语、定语；用于比喻句"},{"id":48370,"word":"鬼功神力","pinyin":"guǐ gōng shén lì","abbr":"ggsl","explanation":"形容事物精妙高超，非人力所能为。","source":{"text":"鬼功神力古未有，地维欲绝还钩连。","book":"元·郝经《赵州石桥》诗"}},{"id":48371,"word":"鬼吒狼嚎","pinyin":"guǐ zhà láng háo","abbr":"gzlh","explanation":"怪声怪气地呼喊嚎叫。","source":{"text":"好吧，我只管去说说看，可你大清早，鬼吒狼嚎嚷什么呢？叫人听了好听！","book":"欧阳山《三家巷》十四"},"similar":["鬼哭狼嚎","鬼抓狼嚎"],"usage":"作谓语、定语、补语；指大声哭叫"},{"id":48372,"word":"鬼吵鬼闹","pinyin":"guǐ chǎo guǐ nào","abbr":"gcgn","explanation":"乱吵乱闹。","example":{"text":"请不要这样～的。"},"usage":"作谓语、状语；用于方言"},{"id":48373,"word":"鬼咤狼嚎","pinyin":"guǐ zhà láng háo","abbr":"gzlh","explanation":"怪声怪气地呼喊嚎叫。"},{"id":48374,"word":"鬼哭天愁","pinyin":"guǐ kū tiān chóu","abbr":"gktc","explanation":"形容悲惨凄凉。","source":{"text":"鬼哭天愁冷雨斜，黄龙晋酒恨徒赊。","book":"高旭《五月十九日和巢南韵即寄越中》"},"similar":["鬼哭神愁"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":48375,"word":"鬼哭狼号","pinyin":"guǐ kū láng háo","abbr":"gklh","explanation":"号：大声哭喊。形容大声哭叫，声音凄厉。","source":{"text":"又神差鬼使，叫他里面嚷打做鬼哭狼号。","book":"清·西周生《醒世姻缘传》第20回"},"similar":["鬼哭狼嚎","鬼哭神号","鬼哭神嚎"],"usage":"作谓语、定语、补语；指大声哭叫"},{"id":48376,"word":"鬼哭狼嗥","pinyin":"guǐ kū láng háo","abbr":"gklh","explanation":"①形容哭叫悲惨凄厉。②形容声音大而杂乱，令人惊恐。","source":{"text":"有的钻到汽车下，有的往坦克的后面涌，鬼哭狼嗥，乱成一片。","book":"魏巍《东方》第三部第六章"},"example":{"text":"忽然，三架飞机掠过头上，～一般往北山飞去。","book":"管桦《惩罚》五"},"similar":["鬼哭狼嚎","鬼哭神号"],"usage":"作谓语、定语、状语；指大声哭叫"},{"id":48377,"word":"鬼哭狼嚎","pinyin":"guǐ kū láng háo","abbr":"gklh","explanation":"形容大声哭叫，声音凄厉。","source":{"text":"可怎生神嚎鬼哭，雾惨云昏，白日为幽。","book":"元·无名氏《马陵道》第二折"},"example":{"text":"况且宝玉才好了些，连我们也不敢说话，你反打的人～的！","book":"清·曹雪芹《红楼梦》第五十八回"},"similar":["狼号鬼哭","鬼哭神号","鬼哭狼号"],"opposite":["欢天喜地"],"usage":"作谓语、定语、补语；指大声哭叫","story":["战国时期，鬼谷子的弟子庞涓学成被魏王封为武阴君、兵马大元帅，他借机使自己的师弟孙膑中计受诛。被砍了双腿的孙膑被齐国拜为军师，他以添兵减灶之计，在马陵道上把庞涓杀得鬼哭狼嚎，庞涓只好拔出佩剑自杀身亡"]},{"id":48378,"word":"鬼哭神号","pinyin":"guǐ kū shén hào","abbr":"gksh","explanation":"①形容哭叫悲惨凄厉。②形容声音大而杂乱，令人惊恐。","source":{"text":"则听得鬼哭神号，休猜做三唱《阳关》出霸桥。","book":"元·杨暹《西游记》第三本第九出"},"example":{"text":"那浪掀天括地，～，惊怕杀人。","book":"《古今小说·杨谦之客舫遇侠僧》"},"similar":["鬼哭狼嚎","鬼哭神嚎"],"usage":"作定语、状语；指大声哭叫"},{"id":48379,"word":"鬼哭神嚎","pinyin":"guǐ kū shén háo","abbr":"gksh","explanation":"号：哭。形容大声哭叫，声音凄厉。","source":{"text":"可怎生神嚎鬼哭，雾惨云昏，白日为幽。","book":"元·无名氏《马陵道》第二折"},"example":{"text":"此时大名城内百姓黎民，一个个鼠窜狼奔，一家家～。","book":"明·施耐庵《水浒全传》第六十六回"},"similar":["鬼哭狼嚎"],"usage":"作谓语、定语；形容大声哭叫，声音凄厉"},{"id":48380,"word":"鬼哭神惊","pinyin":"guǐ kū shén jīng","abbr":"gksj","explanation":"形容极度惊恐。","source":{"text":"张清带住枪杆，去锦袋中摸出一石子。手起处真似流星掣电，石子来吓得鬼哭神惊。","book":"《水浒传》第七十回"},"usage":"作谓语、定语、状语；用于比喻句"},{"id":48381,"word":"鬼哭神愁","pinyin":"guǐ kū shén chóu","abbr":"gksc","explanation":"形容惊恐忧愁。","source":{"text":"我想做丞相时威灵震主，权势倾朝。手指一挥，两班里鸟惊鱼骇；眉头半锁，满朝中鬼哭神愁。","book":"明·陈汝元《金莲花·释愤》"},"example":{"text":"明·冯梦龙《警世通言》第40卷：“出匣时，霜寒雪凛，耀光处，～，乃天赐之至宝也。”"},"similar":["鬼哭天愁"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":48382,"word":"鬼哭粟飞","pinyin":"guǐ kū sù fēi","abbr":"gksf","explanation":"传说苍颉造字，惊天动地，天雨粟，鬼夜哭。","source":{"text":"苍颉造之，鬼哭粟飞；黄帝用之，官治民察。","book":"南朝·梁·刘勰《文心雕龙·练字》"},"usage":"作宾语、定语；用于书面语"},{"id":48383,"word":"鬼头滑脑","pinyin":"guǐ tóu huá nǎo","abbr":"gthn","explanation":"形容行为举止诡秘，不光明正大。同“鬼头鬼脑”。","source":{"text":"冯福合是做小买卖的，有些鬼头滑脑，对他的话不能全信。","book":"马云鹏《雁塞游击队》第十七章"},"similar":["鬼头鬼脑"],"usage":"作谓语、定语；指举止诡秘"},{"id":48384,"word":"鬼头鬼脑","pinyin":"guǐ tóu guǐ nǎo","abbr":"gtgn","explanation":"鬼：形容人阴险狡诈。形容行为举止诡秘，不光明正大。","source":{"text":"巢氏有兄弟巢大郎，是一个鬼头鬼脑的人，奉承的姊夫姊姊好。","book":"明·凌濛初《二刻拍案惊奇》卷二十"},"example":{"text":"又～，不知说了些甚么，便叫请出大爷来。","book":"清·吴敬梓《儒林外史》第四十六回"},"similar":["鬼鬼祟祟","鬼头滑脑"],"opposite":["光明正大","堂堂正正","光明磊落"],"usage":"作谓语、定语；指举止诡秘"},{"id":48385,"word":"鬼子敢尔","pinyin":"guǐ zǐ gǎn ěr","abbr":"gzge","explanation":"鬼子：骂人的话；敢尔：竟敢如此。斥责人竟敢如此大胆。","source":{"text":"士衡正色曰：‘我祖父名播海内，宁有不知，鬼子敢尔。’","book":"南朝·宋·刘义庆《世说新语·方正》"}},{"id":48386,"word":"鬼工神力","pinyin":"guǐ gōng shén lì","abbr":"ggsl","explanation":"形容技艺精巧超群，非人力所及。","source":{"text":"鬼工神力古未有，地维欲绝不钩连。","book":"元·郝经《赵州石桥》诗"},"similar":["鬼工雷斧","鬼斧神工"],"usage":"作宾语、定语；用于比喻句"},{"id":48387,"word":"鬼工雷斧","pinyin":"guǐ gōng léi fǔ","abbr":"gglf","explanation":"形容艺术技巧高超，不是人力所能达到的。同“鬼斧神工”。","source":{"text":"鬼工雷斧琢削古，天光电影生新容。","book":"明·宋濂《滩哥石砚歌》"},"similar":["鬼工神力","鬼斧神工"],"usage":"作宾语、定语；用于比喻句"},{"id":48388,"word":"鬼形怪状","pinyin":"guǐ xíng guài zhuàng","abbr":"gxgz","explanation":"犹言奇形怪状。指不同一般的，奇奇怪怪的形状。","source":{"text":"看看走近城边，蓦然城门开处，突出四个夜叉，生得鬼形怪状，面目狰狞，种种奇异之像。","book":"《禅真逸史》第二十回"},"similar":["奇形怪状","佹形僪状"],"usage":"作谓语、定语、状语；形容物体的外形"},{"id":48389,"word":"鬼怕恶人","pinyin":"guǐ pà èr én","abbr":"gper","explanation":"比喻凶恶的人惧怕更凶恶者。","source":{"text":"王曰‘前人已不住矣，又安敢祸之？’艾子曰：‘真是鬼怕恶人也。’","book":"旧题宋·苏轼《艾子杂说》"},"example":{"text":"他也不免有些～，席上有他内侄连赵完在内，那个主子一团性气，料得也不是善查。","book":"《醒世姻缘传》第三九回"},"usage":"作宾语、定语；用于口语"},{"id":48390,"word":"鬼怪妖魔","pinyin":"guǐ guài yāo mó","abbr":"ggym","explanation":"泛指各种害人的妖怪，比喻社会上作恶害人的恶势力和坏人。","source":{"text":"原来是鬼怪妖魔都来拜我生日。","book":"《说唐》第62回"},"example":{"text":"一派讲私利的，就是阿修罗部下的～。","book":"清·刘鹗《老残游记》第11回"},"similar":["妖魔鬼怪"],"usage":"作主语、宾语、定语；比喻坏人"},{"id":48391,"word":"鬼抓狼嚎","pinyin":"guǐ zhuā láng háo","abbr":"gzlh","explanation":"形容哭叫悲惨凄厉。同“鬼哭神号”。","source":{"text":"任桂花听见他这么鬼抓狼嚎，心乱得不知怎样才好。","book":"欧阳山《高干大》第十九章"},"similar":["鬼哭狼嚎"],"usage":"作谓语、定语、状语；指大声哭叫"},{"id":48392,"word":"鬼斧神工","pinyin":"guǐ fǔ shén gōng","abbr":"gfsg","explanation":"象是鬼神制作出来的。形容艺术技巧高超，不是人力所能达到的。","source":{"text":"梓庆削木为鐻，鐻成，见者惊忧鬼神。","book":"《庄子·达生》"},"example":{"text":"这种编织技术，给人以“浪漫主义手法”、“～”的印象。","book":"秦牧《巧匠和竹》"},"similar":["神工鬼斧","巧夺天工"],"opposite":["粗制滥造"],"usage":"作主语、宾语；形容技艺非常精巧","story":["鲁国技艺非常高超的木匠梓庆，用木头雕成一个鐻，它外形精美，花纹精细，人们一致夸它好，认为不是人工做出来的，像出自鬼神之手。鲁国的国君见后连声叫绝，问梓庆是如何制作出来的，梓庆说只要忘记一切、专心致志就可以了"]},{"id":48393,"word":"鬼泣神号","pinyin":"guǐ qì shén hào","abbr":"gqsh","explanation":"形容哭叫悲惨凄厉。同“鬼哭神号”。","source":{"text":"一丛白草杂黄沙，鬼泣神嚎心乱麻。","book":"清·感惺《游侠传·侠圆》"},"similar":["鬼泣神嚎","鬼哭狼嚎","鬼哭神嚎"],"usage":"作谓语、定语、宾语；指大声哭叫"},{"id":48394,"word":"鬼泣神嚎","pinyin":"guǐ qì shén háo","abbr":"gqsh","explanation":"形容哭叫悲惨凄厉。同“鬼哭神号”。","source":{"text":"江淮南北化为鱼，鬼泣神嚎天暗黑。","book":"清·陈梦雷《行路难》诗"},"similar":["鬼哭狼嚎","鬼哭神嚎","鬼哭狼号"],"usage":"作谓语、定语、宾语；指大声哭叫"},{"id":48395,"word":"鬼火狐鸣","pinyin":"guǐ huǒ hú míng","abbr":"ghhm","explanation":"鬼火闪烁，野狐悲鸣。形容阴森恐怖的荒野夜晚。","source":{"text":"人烟犬吠西山麓，鬼火狐鸣春竹丛。","book":"宋·黄庭坚《追忆余泊舟西江事次韵》"},"example":{"text":"但见坟兆万接，迷目榛荒，～，骇人心目。","book":"清·蒲松龄《聊斋志异·公孙九娘》"}},{"id":48396,"word":"鬼烂神焦","pinyin":"guǐ làn shén jiāo","abbr":"glsj","explanation":"形容火灾惨烈，众多的人被烧死。","source":{"text":"截然高周烧四垣，神焦鬼烂无逃门。","book":"唐·韩愈《陆浑山火和皇甫湜用其韵》"},"example":{"text":"天荒地老余圜土，～见积尸。","book":"清·钱谦益《狱中杂诗》"},"similar":["神焦鬼烂"],"usage":"作谓语、定语；形容火灾惨烈，众多的人被烧"},{"id":48397,"word":"鬼画符","pinyin":"guǐ huà fú","abbr":"ghf","explanation":"好像鬼画的咒语，胡乱涂抹。比喻潦草难认的字迹。也比喻乌七八糟不知再搞什么。","source":{"text":"万古文章有坦途，纵横谁似玉川卢？真书不入今人眼，儿辈从教鬼画符。","book":"金·元好问《论诗三十首》"},"example":{"text":"这个时候，抚台和伊大人心上都是明白的，不过借着这个题目～而已。","book":"清·吴趼人《糊涂世界》第一回"},"usage":"作宾语、定语；指人做事或写字"},{"id":48398,"word":"鬼瞰其室","pinyin":"guǐ kàn qí shì","abbr":"gkqs","explanation":"指鬼神窥望显达富贵人家，将祸害其满盈之志。","source":{"text":"是知高明富贵之家，鬼神窥望其室，将害其满盈之志矣。","book":"《文选·扬雄〈解嘲〉》：“高明之家，鬼瞰其室。”李善注引李奇曰：“鬼神害盈而福谦。”刘良注"},"example":{"text":"国这将兴，朝有正色；国之将亡，～。","book":"《醒世恒言·栖霞岭铁桧成精》"},"similar":["鬼瞰高明"],"usage":"作宾语、定语；用于书面语"},{"id":48399,"word":"鬼瞰高明","pinyin":"guǐ kàn gāo míng","abbr":"gkgm","explanation":"指鬼神窥望显达富贵人家，将祸害其满盈之志。同“鬼瞰其室”。","source":{"text":"窃见高熲以天挺良才，元勋佐命，陛下光宠，亦已优隆。但鬼瞰高明，世疵俊异，侧目求其长短者，岂可胜道哉！","book":"《隋书·裴肃传》"},"example":{"text":"天留淳朴与遗人，～悲巨室。","book":"清·屈大均《广东新语·石语·端石》"},"similar":["鬼瞰其室"],"usage":"作宾语、定语；用于书面语"},{"id":48400,"word":"鬼神不测","pinyin":"guǐ shén bù cè","abbr":"gsbc","explanation":"测：猜想，估计。鬼神也预料不到。形容极其神奇奥妙。","source":{"text":"真个军师妙算，鬼神莫测。","book":"无·无名氏《马陵道》第四折"},"example":{"text":"此人有夺天地造化之法、～之术！若留此人，乃东吴祸根也。”（明·罗贯中《三国演义》第四十九回","book":"瑜骇然曰"},"similar":["鬼神莫测"],"usage":"作宾语、补语；形容极其神奇奥妙"},{"id":48401,"word":"鬼神莫测","pinyin":"guǐ shén mò cè","abbr":"gsmc","explanation":"鬼神也揣测不到。形容非常神奇奥妙，谁也摸不清底细。","source":{"text":"真个军师妙算，鬼神莫测。","book":"无·无名氏《马陵道》第四折"},"example":{"text":"妙哉妙哉，此主不惟朝廷不知，抑且～。","book":"明·王世贞《鸣凤记》"},"similar":["鬼神不测"],"usage":"作宾语、补语；形容极其神奇奥妙"},{"id":48402,"word":"鬼蜮伎俩","pinyin":"guǐ yù jì liǎng","abbr":"gyjl","explanation":"鬼蜮：阴险害人之物；伎俩：花招，手段。比喻用心险恶，暗中伤人的卑劣手段。","source":{"text":"为鬼为蜮，则不可得。","book":"《诗经·小雅·何人斯》"},"example":{"text":"这般胥役棍徒，但知鹜利，不知畏法，逞其鬼蜮之伎俩，则法令亦有时而穷。","book":"清·彭养鸥《黑籍冤魂》第四回"},"similar":["阴谋诡计","居心叵测","心怀鬼胎"],"opposite":["光明正大","光明磊落","襟怀坦白"],"usage":"作主语、宾语；指人的动机"},{"id":48403,"word":"鬼蜮技俩","pinyin":"guǐ yù jì liǎng","abbr":"gyjl","explanation":"比喻用心险恶，暗中伤人的卑劣手段。同“鬼蜮伎俩”。","source":{"text":"古人常说‘鬼蜮技俩’，其实世间何尝真有鬼蜮，那所指点的，不过是这类东西罢了。","book":"鲁迅《华盖集续编·并非闲话（三）》"},"similar":["鬼蜮伎俩","鬼魅伎俩"],"usage":"作主语、宾语；用于人的动机"},{"id":48404,"word":"鬼计多端","pinyin":"guǐ jì duō duān","abbr":"gjdd","explanation":"鬼：指人狡诈，阴险；计：计谋。形容狡诈的计谋很多，坏主意很多","source":{"text":"暗含着恶态，叠暴着环睛，明露着鬼计多端。","book":"清·石玉昆《三侠五义》第40回"},"example":{"text":"老舍《赵子曰》：“李瘦猴有些～呢！”"},"similar":["诡计多端","鬼计百端"],"usage":"作谓语、定语；指坏主意很多"},{"id":48405,"word":"鬼计百端","pinyin":"guǐ jì bǎi duān","abbr":"gjbd","explanation":"指狡诈的计策很多，坏主意多。同“鬼计多端”。","source":{"text":"关云长《三上张翼德书》云：‘操之鬼计百端，非羽智缚，安有今日！’","book":"清·周亮工《书影》卷十"},"similar":["鬼计多端"],"usage":"作谓语、定语；指坏主意很多"},{"id":48406,"word":"鬼设神使","pinyin":"guǐ shè shén shǐ","abbr":"gsss","explanation":"指天造地设，非人力所能成就。","source":{"text":"鬼设神使，浑认作、天限南疆北界。","book":"宋·陈亮《念奴娇·登多景楼》词"},"similar":["鬼设神施","神施鬼设"],"usage":"作谓语、定语、宾语；指安排极为巧妙"},{"id":48407,"word":"鬼设神施","pinyin":"guǐ shè shén shī","abbr":"gsss","explanation":"设、施：指设计。如神鬼所做的一般。形容诗文十分精妙。","source":{"text":"神施鬼设，间见层出。","book":"唐·韩愈《贞曜先生墓志铭》"},"example":{"text":"～浑认作，无限南江北界。","book":"宋·陈亮《念奴娇·登多景楼》"},"similar":["神施鬼设","鬼设神使"],"usage":"作谓语、定语、宾语；指安排极为巧妙"},{"id":48408,"word":"鬼话连篇","pinyin":"guǐ huà lián piān","abbr":"ghlp","explanation":"鬼话：不真实的话。连篇：一篇接一篇。满口说的全是蒙骗人的胡言乱语。","source":{"text":"鬼话连篇，捏造出许多洞府，许多法术。","book":"蔡东藩《前汉演义》第四回"},"example":{"text":"他最爱瞎掰，经常～。"},"similar":["谎话连篇"],"opposite":["实话实说"],"usage":"作状语、定语、宾语；指谎话连篇"},{"id":48409,"word":"鬼迷心窍","pinyin":"guǐ mí xīn qiào","abbr":"gmxq","explanation":"鬼怪迷惑住心窍。指对问题认识不清。","source":{"text":"一时鬼迷心窍，后悔不及。","book":"清·李绿园《歧路灯》第六十回"},"example":{"text":"我真象从前的人说的“～”了，现在可算把鬼打跑了！","book":"赵树理《表明态度》"},"similar":["执迷不悟","糊里糊涂"],"opposite":["迷途知返"],"usage":"作谓语、宾语；指人的思维不正常"},{"id":48410,"word":"鬼门关","pinyin":"guǐ mén guān","abbr":"gmg","explanation":"迷信传说中的阴阳交界的关口。比喻凶险的地方。","source":{"text":"那知越吃越离‘鬼门关’近，这样治病，无怪又生出斗殴的事来。","book":"清·李汝珍《镜花缘》第95回"},"example":{"text":"泄滩青滩不算滩，崆岭才是～。","book":"刘白羽《长江三峡》"},"usage":"作宾语、定语；多用于口语"},{"id":48411,"word":"鬼门占卦","pinyin":"guǐ mén zhān guà","abbr":"gmzg","explanation":"鬼门：卜筮中的术语；卦：古代的占卜符号。指表示不吉利和灾难的爻象。","source":{"text":"岂知本妇已约秉中等了二夜，可不是鬼门占卦。","book":"明·冯梦龙《警世通言》卷三十八"}},{"id":48412,"word":"鬼鬼祟祟","pinyin":"guǐ guǐ suì suì","abbr":"ggss","explanation":"祟：古人想象中的鬼怪或鬼怪出而祸人。指行动偷偷摸摸，不光明正大。","source":{"text":"别叫我替你们害臊了，你们鬼鬼祟祟干的那些事，也瞒不过我去。","book":"清·曹雪芹《红楼梦》第三十一回"},"example":{"text":"我看瑞贞这些日子是有点邪，～，交些乱朋友。","book":"曹禺《北京人》第三幕"},"similar":["鬼头鬼脑","偷偷摸摸"],"opposite":["正大光明","光明磊落"],"usage":"作谓语、定语、状语；指人的行动","story":["晴雯得了伤寒，头痛脑热，宝玉让她躺在房内不要声张，就叫人偷偷去请大夫为她诊治。老婆子给晴雯煎药。宝玉待晴雯服完药后，就去给贾母、王夫人去请安，见两个小丫头在鬼鬼祟祟地议论什么，宝玉也不计较那些"]},{"id":48413,"word":"鬼魅伎俩","pinyin":"guǐ mèi jì liǎng","abbr":"gmjl","explanation":"比喻用心险恶，暗中伤人的卑劣手段。同“鬼蜮伎俩”。","source":{"text":"这些衙役鬼魅伎俩，千人一状，原也不必挂齿。","book":"《歧路灯》第九五回"},"similar":["鬼蜮伎俩","鬼蜮技俩"],"usage":"作主语、宾语；用于人的动机"},{"id":48414,"word":"魁垒之士","pinyin":"kuí lěi zhī shì","abbr":"klzs","explanation":"魁垒：光明磊落；士：旧时指读书人。为人正直，胸怀坦荡的人。","source":{"text":"白首耆艾，魁垒之士。","book":"《汉书·鲍宣传》"}},{"id":48415,"word":"魁垒挤摧","pinyin":"kuí lěi jǐ cuī","abbr":"kljc","explanation":"魁垒：心中郁积不平；挤：排挤；摧：破坏。受到排挤打击而心中郁积不平。","source":{"text":"年齿尽兮命迫促，魁垒挤摧兮常困辱。","book":"《楚辞·九思·悯上》"}},{"id":48416,"word":"魁梧奇伟","pinyin":"kuí wǔ qí wěi","abbr":"kwqw","explanation":"魁梧：壮实高大的样子；奇伟：非常高大。身材健壮高大。","source":{"text":"余以为其人，计魁梧奇伟，至见其图，状貌如妇人好女。","book":"《史记·留侯世家》"},"example":{"text":"方德义本是哥老会的会员，在湘军里充过管带，年纪不过三十来岁，为人勇敢忠直，相貌也～。","book":"清·曾朴《孽海花》第三十二回"},"similar":["高大魁梧"],"usage":"作谓语、定语；指人的身材"},{"id":48417,"word":"魂不守宅","pinyin":"hún bù shǒu zhái","abbr":"hbsz","explanation":"指人之将死。也形容精神恍惚。“魂不守舍”。","source":{"text":"何（何晏）之视候，则魂不守宅，血不华色，精爽烟浮，容若槁木，谓之鬼幽。","book":"《三国志·魏志·管辂传》：“闻晏、飏皆诛，然后舅氏乃服”宋·裴松之注引三国·魏·管辰《管辂别传》"},"similar":["魂不守舍"],"usage":"作谓语、状语、定语；形容精神不集中"},{"id":48418,"word":"魂不守舍","pinyin":"hún bù shǒu shè","abbr":"hbss","explanation":"舍：住宅，比喻人的躯壳。灵魂离开了躯壳。指人之将死。也形容精神恍惚。","source":{"text":"何之视侯，则魂不守宅，血不华色，精爽烟浮，容若槁木，谓之鬼幽。","book":"《三国志·管辂传》裴松之注引《辂别传》"},"example":{"text":"我看宝玉竟是～，起动是不怕的。","book":"清·曹雪芹《红楼梦》第十五回"},"similar":["失魂落魄","魂不守宅"],"opposite":["聚精会神"],"usage":"作谓语、状语、定语；形容精神不集中"},{"id":48419,"word":"魂不着体","pinyin":"hún bù zhuó tǐ","abbr":"hbzt","explanation":"形容极端惊恐或在某种事物诱惑下失去常态。同“魂不附体”。","source":{"text":"只见两个黄巾力士，押着李逵，耳边只听得风雨之声，不觉径到蓟州地界，吓得魂不着体，手脚摇战。","book":"《前汉书平话》卷上：“吓高皇魂不着体。”明·施耐庵《水浒传》第五十三回"},"example":{"text":"谁何错认做小姐有意，一发～，接过来一头抹手，一头说道，‘烦姐姐致谢小姐，多蒙美情，承借汗巾了。’","book":"《石点头·莽书生强图鸳侣》"},"similar":["魂不著体","魂不守舍"],"usage":"作谓语、定语、状语；用于恐惧等"},{"id":48420,"word":"魂不著体","pinyin":"hún bù zhuó tǐ","abbr":"hbzt","explanation":"形容极端惊恐或在某种事物诱惑下失去常态。同“魂不附体”。","source":{"text":"师师闻道，吓得魂不著体。","book":"《宣和遗事》前集"},"similar":["魂不着体","魂不守宅"],"usage":"作谓语、定语、状语；用于恐惧等"},{"id":48421,"word":"魂不负体","pinyin":"hún bù fù tǐ","abbr":"hbft","explanation":"形容极端惊恐或在某种事物诱惑下失去常态。同“魂不附体”。","source":{"text":"这里知观正待进房，又听得本家门首锣响……惊得魂不负体，也不及开一句口，掇转身望外就走。","book":"明·凌蒙初《二刻拍案惊奇》卷十七"},"example":{"text":"宝玉立刻吓的～，秋纹和晴雯赶忙给他穿好衣裳。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["魂不附体","魂不赴体"],"usage":"作谓语、状语、补语；形容受刺激而失去常态"},{"id":48422,"word":"魂不赴体","pinyin":"hún bù fù tǐ","abbr":"hbft","explanation":"形容极端惊恐或在某种事物诱惑下失去常态。同“魂不附体”。","source":{"text":"只见两个力士，捉一个后生……霎时间把刀破开肚皮，取出心肝，呈上娘娘，惊得宣赞魂不赴体。","book":"明·洪楩《清平山堂话本·西湖三塔记》"},"example":{"text":"那厮道：‘我从来爱取笑人，昨日不合撩拨了这妇人，吃胡子打了一顿拳头；又吃他惊了，交我～。","book":"《平妖传》第六回"},"similar":["魂不负体","魂不附体"],"usage":"作谓语、状语、补语；形容受刺激而失去常态"},{"id":48423,"word":"魂不附体","pinyin":"hún bù fù tǐ","abbr":"hbft","explanation":"附：依附。灵魂离开了身体。形容极端惊恐或在某种事物诱惑下失去常态。","source":{"text":"使小生魂不附体。","book":"元·乔梦符《金钱记》第一折"},"example":{"text":"承惊觉，不见诏书，～，手脚慌乱。","book":"明·罗贯中《三国演义》第二十回"},"similar":["丧魂失魄","六神无主","魂飞魄散"],"opposite":["无动于衷","悠闲自得","神态自若"],"usage":"作谓语、状语、补语；形容受刺激而失去常态"},{"id":48424,"word":"魂丧神夺","pinyin":"hún sàng shén duó","abbr":"hssd","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"［优童］妖态艳妆，逾于秦楼楚馆，初入都者，鲜不魂丧神夺，挟资营干，至有罄其囊而不得旋归者。","book":"清·无名氏《燕京杂记》"},"similar":["魂飘神荡","魂消魄夺"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":48425,"word":"魂亡胆落","pinyin":"hún wáng dǎn luò","abbr":"hwdl","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"鲁肃曰：‘闻皇叔用诸葛孔明之谋，两场火烧得曹操魂亡胆落。","book":"《三国演义》第四二回"},"similar":["魂惊胆落","魂飞魄散"],"usage":"作谓语、定语、状语；用于惊恐时"},{"id":48426,"word":"魂亡魄失","pinyin":"hún wáng pò shī","abbr":"hwps","explanation":"魂、魄：即迷信所说的灵魂。形容万分惊恐，不知所措；有时也指受到了极大诱惑而不能自持。","source":{"text":"魂亡魄失。","book":"汉·杨雄《羽猎赋》"},"similar":["魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48427,"word":"魂劳梦断","pinyin":"hún láo mèng duàn","abbr":"hlmd","explanation":"形容日夜思念，精神困乏。","source":{"text":"不料东人妹淑兰留心于那生身上，终日魂劳梦断。","book":"元·王实甫《西厢记》第二本第四折：“小生为小姐，昼夜忘餐废寝，魂劳梦断，常忽忽如有所失。”明·贾仲名《萧淑兰》第二折"},"example":{"text":"香消玉减因谁害，废寝忘飧为谁来，～无聊赖。","book":"明·冯梦龙《挂枝儿·不凑巧》"},"usage":"作谓语、定语；用于思念"},{"id":48428,"word":"魂惊胆落","pinyin":"hún jīng dǎn luò","abbr":"hjdl","explanation":"形容惊恐万分。","source":{"text":"目连虽是圣人，亦得魂惊胆落。","book":"《敦煌变文集·大目乾连冥间救母变文》"},"example":{"text":"番子正在～，又见山后那二百人，摇旗呐喊飞杀上来。","book":"清·吴敬梓《儒林外史》第三十九回"},"similar":["魂惊魄落","魂亡胆落"],"usage":"作谓语、定语、状语；用于惊恐时"},{"id":48429,"word":"魂惊胆颤","pinyin":"hún jīng dǎn chàn","abbr":"hjdc","explanation":"形容惊恐万分。","source":{"text":"薛举一枝画戟，神出鬼没，若舞梨花，遍身解数。官军看了，个个魂惊胆颤。","book":"明·方汝浩《禅真逸史》第三十三回"},"similar":["魂飞胆颤"],"usage":"作谓语、定语、状语；指害怕"},{"id":48430,"word":"魂惊魄惕","pinyin":"hún jīng pò tì","abbr":"hjpt","explanation":"形容十分震惊。","source":{"text":"又《十三只做式图》一册……予见之而魂惊魄惕，此予响者意地中固有之局，何斯人之先得我心邪？","book":"清·刘献廷《广阳杂记》卷三"},"usage":"作谓语、定语、状语；用于处事"},{"id":48431,"word":"魂惊魄落","pinyin":"hún jīng pò luò","abbr":"hjpl","explanation":"形容极度惊恐。","source":{"text":"此本一上，这厮不独削籍清朝，抑且置身圜土，使众人魂惊魄落，舌结口钳。","book":"明·陈汝元《金莲记·诗案》"},"similar":["魂惊胆落"],"usage":"作谓语、定语、状语；用于惊恐时"},{"id":48432,"word":"魂惭色褫","pinyin":"hún cán sè chǐ","abbr":"hcsc","explanation":"指惶愧失色，惊恐不安。","source":{"text":"二子魂惭色褫，跼听玉音。","book":"唐·司空图《释怨》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":48433,"word":"魂慑色沮","pinyin":"hún shè sè jǔ","abbr":"hssj","explanation":"形容惊恐万状。","source":{"text":"及兵交之后，被铁骑唐突，飞矢如雨，皆魂慑色沮，望贼奔散。","book":"《旧唐书·忠义传下·李憕》"},"usage":"作谓语、定语；用于书面语"},{"id":48434,"word":"魂慴色沮","pinyin":"hún shè sè jǔ","abbr":"hssj","explanation":"形容惊恐万状。"},{"id":48435,"word":"魂摇魄乱","pinyin":"hún yáo pò luàn","abbr":"hypl","explanation":"神魂颠倒，不能自持。","source":{"text":"梦中亲见，诉不出许多情话，魂摇魄乱，那些儿一刻千金价。","book":"明·张伯起《泣颜回·题恨》套曲"},"usage":"作谓语、定语；用于书面语"},{"id":48436,"word":"魂梦为劳","pinyin":"hún mèng wéi láo","abbr":"hmwl","explanation":"念念不忘，在睡梦中都还惦记着。"},{"id":48437,"word":"魂消胆丧","pinyin":"hún xiāo dǎn sàng","abbr":"hxds","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"［段恺］使人探知大军离城不远，遥望水陆路上，旌旗蔽日，船马相连，吓得魂消胆丧。","book":"明·施耐庵《水浒传》第一百十四回"},"example":{"text":"夫人听说，吓得目瞪口呆，～。","book":"清·佚名《说呼全传》第五回"},"similar":["魂飞魄散","魂飞胆丧"],"usage":"作谓语、定语；用于书面语"},{"id":48438,"word":"魂消魄丧","pinyin":"hún xiāo pò sàng","abbr":"hxps","explanation":"形容惊恐万分，极端害怕。","source":{"text":"为首的是大将李元霸，成都看见，吓得魂消魄丧。","book":"明·施耐庵《水浒传》第一百十七回：“那火炮飞将起去，震的天崩地动，岳撼山摇，城中军马，惊得魂消魄丧，不杀自乱。”《说唐》第四十一回"},"example":{"text":"只见微风动处，那青草已摇摆不休，虽说是一枝小草，又无花朵，其妩媚之态，不禁心动神怡，～。","book":"清·曹雪芹《红楼梦》第一一六回"},"similar":["魂消胆丧","魂消魄夺"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":48439,"word":"魂消魄夺","pinyin":"hún xiāo pò duó","abbr":"hxpd","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"季斯看了多时，又阅其容色之美，服饰之华，不觉手麻脚软，目睁口呆，意乱神迷，魂消魄夺。","book":"《东周列国志》第七十九回"},"similar":["魂丧神夺"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":48440,"word":"魂消魄散","pinyin":"hún xiāo pò sàn","abbr":"hxps","explanation":"吓得连魂魄都离开人体飞散了。形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"李明见先折了一个，却待也要拨回马走时，被杨志大喝一声，惊得魂消魄散，胆颤心寒，手中那条枪，不知颠倒。","book":"明·施耐庵《水浒传》第七十七回"},"example":{"text":"人虽不过六百，其中玄妙不啻百万之众，纵是神仙，入此亦～。","book":"明·许仲琳《封神演义》第五十回"},"similar":["魂飞魄散","魂销魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48441,"word":"魂牵梦萦","pinyin":"hún qiān mèng yíng","abbr":"hqmy","explanation":"形容万分思念。","source":{"text":"思君忆君，魂牵梦萦。","book":"宋·刘过《醉太平》词"},"example":{"text":"近乡情怯，是为什么呢？为的是多年～在作还乡梦。","book":"高阳《乾隆韵事》"},"similar":["日思夜梦","神魂颠倒"],"opposite":["大梦初醒","恍然大悟"],"usage":"作谓语、状语；指十分思念"},{"id":48442,"word":"魂祈梦请","pinyin":"hún qǐ mèng qǐng","abbr":"hqmq","explanation":"形容时时刻刻都在祈求。","source":{"text":"魂祈梦请卜之。","book":"清·黄宗羲《万里寻兄记》"}},{"id":48443,"word":"魂耗神丧","pinyin":"hún hào shén sàng","abbr":"hhss","explanation":"耗：减损，消耗；丧：丧失。吓得魂魄都飞散了。形容极为惊恐，不知所措。","source":{"text":"其视州县守令，若鹓鸾之视腐鼠，一或得之，魂耗神丧，对妻子失色，甚至昏夜乞哀以求免。","book":"明·沈德符《野获编·府县·邑令轻重》"},"similar":["魂飞神丧"],"usage":"作谓语、定语、状语；用于书面语"},{"id":48444,"word":"魂耗魄丧","pinyin":"hún hào pò sàng","abbr":"hhps","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"其视州县守令，若鹓鸾之视腐鼠，一或得之，魂耗魄丧，对妻子失色，甚至昏夜乞哀以求免。盖当时邑令之轻如此。","book":"明·沈德符《野获编·府县·邑令轻重》"},"similar":["魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48445,"word":"魂销目断","pinyin":"hún xiāo mù duàn","abbr":"hxmd","explanation":"指情思凄苦。","source":{"text":"终日斋心祷玉宸，魂销目断未逢真。","book":"唐·严休复《唐昌观玉蕊花折有心人游怅然成二绝》之一"},"similar":["魂销肠断"],"usage":"作谓语、宾语；用于书面语"},{"id":48446,"word":"魂销肠断","pinyin":"hún xiāo cháng duàn","abbr":"hxcd","explanation":"指情思凄苦。同“魂销目断”。","source":{"text":"衣袂京尘曾染处，空有香红尚软。料彼此，魂销肠断。","book":"宋·刘过《贺新郎》词"},"similar":["魂销目断"],"usage":"作谓语、宾语；用于书面语"},{"id":48447,"word":"魂销魄散","pinyin":"hún xiāo pò sàn","abbr":"hxps","explanation":"吓得连魂魄都离开人体飞散了。形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"众官一见，俱皆魂销魄散，目荡神移。","book":"清·李百川《绿野仙踪》第二十六回"}},{"id":48448,"word":"魂颠梦倒","pinyin":"hún diān mèng dǎo","abbr":"hdmd","explanation":"犹言神魂颠倒。精神恍惚，颠三倒四，失去常态。","source":{"text":"魂颠梦倒神未宁，忽听雨骤风狂闹五更。","book":"明·冯梦龙《锦堂月·金闾纪遇》套曲"},"example":{"text":"又说吕相公不喜二位，一心想念着他，故此把这位佳人弄得～，不肯改嫁别人。","book":"清·李渔《凰求凤·悟奸》"},"similar":["神魂颠倒"],"usage":"作谓语、定语、状语；指人精神恍惚"},{"id":48449,"word":"魂飘神荡","pinyin":"hún piāo shén dàng","abbr":"hpsd","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"吴衙内看了，不觉魂飘神荡，恨不得就到他身边，搂在怀中。","book":"明·冯梦龙《醒世恒言》第二十八卷"},"similar":["魂飞魄散","魂丧神夺"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":48450,"word":"魂飘魄散","pinyin":"hún piāo pò sàn","abbr":"hpps","explanation":"形容惊恐万状。","source":{"text":"娘娘见说，魂飘魄散，急下亭抱起，紧搂在怀。","book":"明·吴承恩《西游记》第三十八回"},"example":{"text":"两个儿子虽然性恶，但赵阴阳四十多年前就预测到他们的作孽，也顿时胆颤心惊，～。","book":"贾平凹《妊娠》第二章二"},"similar":["魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48451,"word":"魂飞天外","pinyin":"hún fēi tiān wài","abbr":"hftw","explanation":"形容万分恐惧，或受到某种刺激而失去了主宰。","source":{"text":"听说罢，魂飞天外，好教我心惊失色。","book":"汉·扬雄《羽猎赋》：“魂亡魄失。”元·李文蔚《张子房圯桥进履》第二折"},"example":{"text":"尤二姐露出脸来，胡君荣一见，早已～，那里还能辨气色？","book":"清·曹雪芹《红楼梦》第六十九回"},"similar":["魂不守舍","魂飞魄散","魂不附体"],"opposite":["行若无事","不动声色","泰然自若"],"usage":"作谓语、补语；形容万分恐惧"},{"id":48452,"word":"魂飞天外，魄散九霄","pinyin":"hún fēi tiān wài，pò sàn jiǔ xiāo","abbr":"hftwpsjx","explanation":"魂：灵魂；魄：依附形体而显现的精神。形容惊恐到了极点或受到了极大诱惑而不能自持。","source":{"text":"梁中书看了，吓得魂飞天外，魄散九霄。","book":"明·施耐庵《水浒传》第63回"},"usage":"作定语、状语；形容万分恐惧"},{"id":48453,"word":"魂飞目断","pinyin":"hún fēi mù duàn","abbr":"hfmd","explanation":"形容十分心向往之，不能自持。","source":{"text":"娇容转盛，艳质更丰……远看时意散心惊，近睹者魂飞目断。","book":"《敦煌变文集·维摩诘经讲经文》"},"usage":"作谓语、定语；用于书面语"},{"id":48454,"word":"魂飞神丧","pinyin":"hún fēi shén sàng","abbr":"hfss","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"遂裂衣化为老猿，追笑者跃树而去……恪乃惊惧，若魂飞神丧，良久抚二子一恸。","book":"唐·裴铏《传奇·孙恪》"},"similar":["魂飞魄越","魂飞魄散"],"usage":"作谓语、定语、状语；用于书面语"},{"id":48455,"word":"魂飞胆丧","pinyin":"hún fēi dǎn sàng","abbr":"hfds","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"［段恺］使人探知大军离城不远，遥望水陆路上，旌旗蔽日，船马相连，吓得魂消胆丧。","book":"明·施耐庵《水浒传》第一百十四回"},"example":{"text":"几个敌人吓的～，抱头逃跑。","book":"陈其通《万水千山》第一幕"},"similar":["魂飞胆裂","魂飞胆战","魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48456,"word":"魂飞胆战","pinyin":"hún fēi dǎn zhàn","abbr":"hfdz","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"怕怖莫知为计，魂飞胆战心惟。","book":"《敦煌变言集·难陀出家缘起》"},"example":{"text":"清·贪梦道人《彭公案》第28回：“把那管虎的海户兵丁，吓得～。”"},"similar":["魂飞胆裂","魂飞胆丧","魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48457,"word":"魂飞胆破","pinyin":"hún fēi dǎn pò","abbr":"hfdp","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"田龙秋听说，惊得魂飞胆破，放马逃生。","book":"明·方汝浩《禅真逸史》第三十四回"},"similar":["魂飞胆裂","魂飞胆丧","魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48458,"word":"魂飞胆落","pinyin":"hún fēi dǎn luò","abbr":"hfdl","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"回顾元营，火光四起，愈觉得魂飞胆落。","book":"清·吴趼人《痛史》第三回"},"similar":["魂飞胆裂","魂飞胆破","魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48459,"word":"魂飞胆裂","pinyin":"hún fēi dǎn liè","abbr":"hfdl","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"小岛左堵右挡支持不住，看到刘铁冲在前边直取他来，吓的他魂飞胆裂，关山一群保护着小岛狂跑猛窜！","book":"向春《煤城怒火》第二十章"},"example":{"text":"把敌人打得落花流水，～，伤亡惨重。","book":"《人民日报》1968.2.2"},"similar":["魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48460,"word":"魂飞胆颤","pinyin":"hún fēi dǎn chàn","abbr":"hfdc","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"正有些心虚，忽然见床下钻出一个披头黑鬼来。二人惊得毛骨悚然，魂飞胆颤，大叫有鬼，戒尺乱打。","book":"明·方汝浩《禅真逸史》第二十二回"},"similar":["魂飞魄散","魂惊胆颤"],"usage":"作谓语、定语、状语；指害怕"},{"id":48461,"word":"魂飞魄丧","pinyin":"hún fēi pò sāng","abbr":"hfps","explanation":"比喻非常恐惧害怕。","source":{"text":"惊的我魂飞魄丧，走的我力尽筋舒。","book":"元·关汉卿《蝴蝶梦》第二折"},"example":{"text":"众小厮们见他说出来的话有天没日的，吓得～。","book":"清·曹雪芹《红楼梦》第七回"},"similar":["魂飞魄散","魂飞魄越"],"usage":"作谓语、定语、状语；指害怕"},{"id":48462,"word":"魂飞魄散","pinyin":"hún fēi pò sàn","abbr":"hfps","explanation":"吓得连魂魄都离开人体飞散了。形容惊恐万分，极端害怕。","source":{"text":"心之精爽，是谓魂魄；魂魄去之，何以能久？","book":"《左传·昭公二十五年》"},"example":{"text":"猛然间一个人从身后冒冒失失的按住，也不出声，二人唬得～。","book":"清·曹雪芹《红楼梦》第十五回"},"similar":["魂不附体","魂不守舍","失魂落魄"],"opposite":["处之泰然","泰然自若","镇定自若"],"usage":"作谓语、定语、状语；指害怕","story":["北宋时期，洛阳女子贺怜怜与汴梁才子王涣一见钟情就订了婚。贺家嫌王涣家贫就把怜怜另许配给种师道手下军需官高常彬。王涣装作卖查梨的前去承天寺里见怜怜，遇到高常彬回家，王涣吓得魂飞魄散。王涣后来参军立下军功，夺回怜怜白头到老"]},{"id":48463,"word":"魂飞魄荡","pinyin":"hún fēi pò dàng","abbr":"hfpd","explanation":"形容受外界刺激、诱惑而精神不能集中。亦形容惊恐万状。","source":{"text":"说不尽百媚千娇，魂飞魄荡。","book":"《后水浒传》第六回：“那马上的官人，忽见楼窗中一位美貌妇人，生得标致非凡，不胜惊喜……那官人在马上，一时看得魂飞魄荡。”明·冯梦龙《醒世恒言》第二十三卷"},"example":{"text":"吕胜不看则已，看时～，惊得呆了，身子先酥软下来，嘴唇张着，喝声彩不知高低。","book":"郭戈《金瓶梅传奇》第二十一回"},"similar":["魂飞魄散","魂飞胆破"],"usage":"作谓语、定语、状语；用于不能自持"},{"id":48464,"word":"魂飞魄越","pinyin":"hún fēi pò yuè","abbr":"hfpy","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"谁知不翻犹可，只这一翻，吓得我：魂飞魄越心无主，胆裂肝摧痛欲号！","book":"清·吴研人《二十年目睹之怪现状》第十六回"},"similar":["魂飞魄丧","魂飞神丧"],"usage":"作谓语、定语、状语；用于书面语"},{"id":48465,"word":"魂飞魄飏","pinyin":"hún fēi pò yáng","abbr":"hfpy","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"雪白玉体透帘帏，禁不住魂飞魄飏。","book":"明·兰陵笑笑生《金瓶梅词话》第十七回"},"similar":["魂飞魄散"],"usage":"作谓语、定语、状语；用于书面语"},{"id":48466,"word":"魂驰梦想","pinyin":"hún chí mèng xiǎng","abbr":"hcmx","explanation":"形容思念万分。","source":{"text":"向在宅上扰聒，自别来魂驰梦想，此心无时无刻得离左右也。","book":"元·马致远《青衫泪》第二折"},"usage":"作谓语、定语；用于思念"},{"id":48467,"word":"魄散魂消","pinyin":"pò sàn hún xiāo","abbr":"pshx","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"口儿甜，庞儿俏……引的人魄散魂消。","book":"元·张鸣善《普天乐·赠妓》"},"example":{"text":"管贤士一见杜伏威走到，惊得～，正待往窗外逃生，被杜伏威拦腰一斧砍倒。","book":"明·方汝浩《禅真逸史》第25回"},"similar":["魄散魂飞","魄消魂散"],"usage":"作谓语、状语；用于惊恐"},{"id":48468,"word":"魄散魂飘","pinyin":"pò sàn hún piāo","abbr":"pshp","explanation":"形容人临死时神志昏迷、人事不省。","source":{"text":"双手攥定了这根九环锡杖，谨照着他的腰眼骨儿，着实断送他一下，把个孽畜打得一个星飞缭乱，魄散魂飘。","book":"《三宝太监西洋记通俗演义》第七回"},"example":{"text":"明·冯梦龙《喻世明言》第38卷：“看的人惊得四分五落，～。”"},"similar":["魂飞魄散","魄荡魂摇","魄消魂散"],"opposite":["镇定自若"],"usage":"作谓语、定语、状语；指害怕"},{"id":48469,"word":"魄散魂飞","pinyin":"pò sàn hún fēi","abbr":"pshf","explanation":"形容非常恐惧害怕。","source":{"text":"听说罢心悲痛，骇得我魄散魂飞似痴。","book":"元·无名氏《百花亭》第三折：“可正是船至江心补漏迟，只着我魄散魂飞。”明·徐霖《绣襦记》第三十出"},"example":{"text":"那女学生见逢之在前探头探脑，便也停住脚步，望了他几眼，更把他弄得～。","book":"清·李宝嘉《文明小史》第四十回"},"similar":["魂飞魄散"],"opposite":["镇定自若"],"usage":"作定语、状语；同“魂飞魄散”"},{"id":48470,"word":"魄消魂散","pinyin":"pò xiāo hún sàn","abbr":"pxhs","explanation":"形容惊恐万分，极端害怕。同“魂飞魄散”。","source":{"text":"袭人听了这话，吓得魄消魂散，只叫‘神天菩薩，坑死我了！’","book":"清·曹雪芹《红楼梦》第三十二回"},"similar":["魄散魂飘","魂飞魄散","魄散魂消"],"usage":"作谓语、定语、状语；指害怕"},{"id":48471,"word":"魄荡魂摇","pinyin":"pò dàng hún yáo","abbr":"pdhy","explanation":"形容受外界刺激、诱惑而精神不能集中。","source":{"text":"雪岩左顾右盼的赏鉴了一回，想起隋炀帝的乌铜镜屏的艳事，便不禁魄荡魂摇起来。","book":"《雪岩外传》第六回"},"similar":["魄荡魂飞","魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48472,"word":"魄荡魂飞","pinyin":"pò dàng hún fēi","abbr":"pdhf","explanation":"形容惊恐万状。","source":{"text":"到如今烟鬼满天下，闻得国家要行禁烟的命令，都吓得魄荡魂飞。","book":"《黑籍冤魂》第三回"},"similar":["魄散魂消","魄散魂飞","魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":48473,"word":"魅力四射","pinyin":"mèi lì sì shè","abbr":"mlss","explanation":"形容富有魅力，极有吸引力。","usage":"可用于人，也可用于其他事物。多用于褒义。"},{"id":48474,"word":"魆风骤雨","pinyin":"zhuō fēng zhòu yǔ","abbr":"xfzy","explanation":"犹暴风骤雨。比喻声势浩大，发展急速而猛烈。","source":{"text":"魆风骤雨，不入寡妇之门。","book":"明·无名氏《白兔记·私会》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":48475,"word":"魏紫姚黄","pinyin":"wèi zǐ yáo huáng","abbr":"wzyh","explanation":"魏紫：千叶肉红牡丹，出于魏仁溥家；姚黄：千叶黄花牡丹，出于姚氏民家。原指宋代洛阳两种名贵的牡丹品种。后泛指名贵的花卉。","source":{"text":"姚黄魏紫开次第，不觉成恨俱零凋。","book":"宋·欧阳修《绿竹堂独饮》诗"},"example":{"text":"你素魄儿十分媚，慧心儿百和香，更压着～。","book":"元·吴昌龄《东坡梦》第三折"},"similar":["姚黄魏紫"],"usage":"作宾语；指牡丹花"},{"id":48476,"word":"魏颗结草","pinyin":"wèi kē jié cǎo","abbr":"wkjc","explanation":"表示受恩深重，竭力报效之意。","source":{"text":"春秋晋魏颗不从父以嬖妾殉葬之命而遣嫁之，后与秦将杜回战于辅氏，“颗见老人结草以亢杜回，杜回踬而颠，故获之。夜梦之曰：‘余，而所嫁妇人之父也……余是以报。’”见《左传·宣公十五年》。"},"example":{"text":"五代·李瀚《蒙求》诗：“灵辄扶轮，～。”"},"similar":["结草衔环"],"usage":"作宾语、定语；用于书面语","story":["春秋时期，晋国大夫魏颗没有按照父亲神志不清的遗愿，让父亲的小妾去陪葬而让她改嫁他人。后来在同秦将杜回作战时，那小妾父亲的灵魂在战场上把草打结绊倒秦国大将杜回，帮助魏颗擒拿杜回，算是对他的报答"]},{"id":48477,"word":"魏鹊无枝","pinyin":"wèi què wú zhī","abbr":"wqwz","explanation":"比喻贤才无所依存。","source":{"text":"月明星稀，乌鹊南飞，绕树三匝，何枝可依。","book":"语出三国·魏·曹操《短歌行》"},"example":{"text":"宋·李曾伯《临江仙·甲寅中秋和刘舍人赏月》词：“我有芳尊供玩事，从渠～。”"},"usage":"作宾语、定语；多用于比喻句"},{"id":48478,"word":"魑魅罔两","pinyin":"chī mèi wǎng liǎng","abbr":"cmwl","explanation":"传说中山林中的妖怪。后比喻形形色色的坏人。","source":{"text":"余此物名为匕首，其利难俦，水断虬龙，陆斩虎兕，魑魅罔两，莫能逢之。","book":"晋·王嘉《拾遗记·前汉上》"},"example":{"text":"以前虽无成例，却是留给后来的宝贝，其功用与铸了～的形状的禹鼎相同。","book":"鲁迅《且介亭杂文二集·“题未定”草（八）》"},"similar":["魑魅魍魉","螭魅罔两"],"usage":"作主语、宾语、定语；用于书面语"},{"id":48479,"word":"魑魅魍魉","pinyin":"chī mèi wǎng liǎng","abbr":"cmwl","explanation":"原为古代传说中的鬼怪。指各种各样的坏人。","source":{"text":"魑魅魍魉，莫能逢之。","book":"《左传·宣公三年》"},"example":{"text":"如今把事实指出，愈使～无所遁形于光天化日之下了！","book":"邹韬奋《患难余生记·进步文化的遭难》"},"similar":["牛鬼蛇神","为鬼为蜮"],"opposite":["志士仁人"],"usage":"作主语、宾语、定语；用于书面语","story":["春秋五霸之一的楚庄王率军征讨小国陆浑，路过洛阳城旁的洛水时，公然在周王室境内陈兵示威，周定王派大夫王孙满去慰劳楚庄王。楚庄王无礼地问周王室的鼎有多重，王孙满解释说鼎是国家的象征，国家强大任何魑魅魍魉都不敢接近"]},{"id":48480,"word":"魔高一尺，道高一丈","pinyin":"mó gāo yī chǐ，dào gāo yī zhàng","abbr":"mgycdgyz","explanation":"魔：恶鬼；道：道行，道法。比喻正义始终压倒邪恶。","source":{"text":"魔高一尺，道高一丈。在粉碎日寇‘驻屯清剿’的斗争中，冀中人民的天才创造——地道战，大显神威。","book":"杨成武《层层火阵烧野牛》"},"similar":["邪不压正"],"opposite":["道高一尺，魔高一丈"],"usage":"作分句；指正邪较量"},{"id":48481,"word":"鱼与熊掌","pinyin":"yú yǔ xióng zhǎng","abbr":"yyxz","explanation":"比喻俱为所欲，难于取舍之物。","source":{"text":"鱼我所欲也，熊掌亦我所欲也；二者不可得兼，舍鱼而取熊掌者也。","book":"语本《孟子·告子上》"}},{"id":48482,"word":"鱼书雁信","pinyin":"yú shū yàn xìn","abbr":"ysyx","explanation":"泛指书信。","source":{"text":"总是伤情别离，则这鱼书雁信，冷清清杳无踪迹。","book":"《雍熙乐府·古调石榴花·闺思》"},"similar":["鱼书雁帖","鱼书雁帛","鱼封雁帖"],"usage":"作宾语、定语；用于书面语"},{"id":48483,"word":"鱼书雁帖","pinyin":"yú shū yàn tiě","abbr":"ysyt","explanation":"泛指书信。","source":{"text":"盼征鸿在天外，行列，烦寄却鱼书雁帖。","book":"明·高濂《绛都春序·题情》套曲：“空接，鱼书雁帖，反教人添哽咽。”明·王九思《绛都春序·四时闺怨》套曲"},"similar":["鱼书雁帛","鱼书雁信","鱼肠尺素"],"usage":"作宾语、定语；用于书面语"},{"id":48484,"word":"鱼书雁帛","pinyin":"yú shū yàn bó","abbr":"ysyb","explanation":"泛指书信。","source":{"text":"则笺简二字中，便有无穷本义，鱼书雁帛而外，不有竹刺之式可为乎？","book":"清·李渔《闲情偶寄·器玩·制度》"},"similar":["鱼书雁帖","鱼书雁信","鱼肠雁足"],"usage":"作宾语、定语；用于书面语"},{"id":48485,"word":"鱼书雁足","pinyin":"yú shū yàn zú","abbr":"ysyz","explanation":"鱼书、雁足：古代传说指书信的传递者。后多用以指书信。","source":{"text":"尺素在鱼肠，寸心凭雁足。","book":"南朝·梁·王僧孺《捣衣》诗"}},{"id":48486,"word":"鱼传尺素","pinyin":"yú chuán chǐ sù","abbr":"yccs","explanation":"尺素：古代用绢帛书写，通常长一尺，因此称书信。指传递书信。","source":{"text":"客从远方来，遗我双鲤鱼。呼儿烹鲤鱼，中有尺素书。","book":"古乐府《饮马长城窟行》"},"example":{"text":"驿寄梅花，～，砌成此恨无重数。","book":"宋·秦观《踏莎行》词"},"similar":["鸿雁传情"],"usage":"作宾语、定语；指传递书信","story":["汉代乐府民歌《饮马长城窟行》描写妻子对远方丈夫的思念之情，靠鱼传尺素来传递感情，原诗：“枯桑知天风，海水知天寒。入门各自媚，谁肯相为言！客从远方来，遗我双鲤鱼。呼儿烹鲤鱼，中有尺素书。长跪读素书，书中竟何如？”"]},{"id":48487,"word":"鱼信雁书","pinyin":"yú xìn yàn shū","abbr":"yxys","explanation":"鱼信、雁书：古代指书信。后多用以指书信。","source":{"text":"尺素在鱼肠，寸心凭雁足。","book":"南朝·梁·王僧孺《捣衣》诗"}},{"id":48488,"word":"鱼升龙门","pinyin":"yú shēng lóng mén","abbr":"yslm","explanation":"比喻举业成功或地位高升。","source":{"text":"河津一名龙门，禹凿山开门，阔一里馀，黄河自中流下，而岸不通车马。每逢春之际，有黄鲤鱼逆流而上，得过者便化为龙。","book":"语出《辛氏三秦记》"},"similar":["鱼跃龙门"],"usage":"作宾语、定语；用于书面语"},{"id":48489,"word":"鱼县鸟窜","pinyin":"yú xiàn niǎo cuàn","abbr":"yxnc","explanation":"鱼被钓，鸟逃窜。比喻或受制于人，或飘泊流离，处境十分险困。县，通“悬”。"},{"id":48490,"word":"鱼大水小","pinyin":"yú dà shuǐ xiǎo","abbr":"ydsx","explanation":"比喻生产不够消费。也比喻机构臃肿，行动不灵。","source":{"text":"假若我们缩小自己的机构，使兵精政简，我们的战争机构虽然小了，仍然是有力量的；而因克服了鱼大水小的矛盾，使我们的战争的机构适合战争的情况，我们就将显得越发有力量……","book":"毛泽东《〈农村调查〉的序言和跋》"},"example":{"text":"我们尽力消除～的局面。"},"similar":["僧多粥少"],"usage":"作定语；指人浮于事"},{"id":48491,"word":"鱼封雁帖","pinyin":"yú fēng yàn tiē","abbr":"yfyt","explanation":"泛指书信。","source":{"text":"伤秋宋玉悲何切，盼征鸿在天外行列，烦寄却鱼封雁帖。","book":"《吴骚·步步娇·闺怨》：“湘江竭，燕山截，断鱼封雁帖。”《南宫词纪·绛都春·四时怨别》"},"example":{"text":"《南宫词纪·绛都春·四时怨别》：“伤秋宋玉悲何切，盼征鸿在天外行列，烦寄却～。”"},"similar":["鱼肠尺素","鱼肠雁足"],"usage":"作宾语、定语；用于书面语"},{"id":48492,"word":"鱼尾雁行","pinyin":"yú wěi yàn xíng","abbr":"ywyx","explanation":"指兵轮行进之队列，一轮居中为首，其它轮船按人字形两旁依次排列，状如鱼尾，又如雁阵。"},{"id":48493,"word":"鱼帛狐声","pinyin":"yú bó hú shēng","abbr":"ybhs","explanation":"指借助鬼神制造舆论，以便起事。","source":{"text":"陈胜吴广喜，念鬼，曰：‘此教我先威众耳。’乃丹书帛曰‘陈胜王’，置人所罾鱼腹中。卒买鱼烹食，得鱼腹中书，固以怪之矣。又閒令吴广之次所旁丛祠中，夜篝火，狐鸣呼曰：‘大楚兴，陈胜王’。卒皆夜惊恐……","book":"《史记·陈涉世家》"}},{"id":48494,"word":"鱼帛狐篝","pinyin":"yú bó hú gōu","abbr":"ybhg","explanation":"指借助鬼神制造舆论，以便起事。","source":{"text":"陈胜吴广喜，念鬼，曰：‘此教我先威众耳。’乃丹书帛曰‘陈胜王’，置人所罾鱼腹中。卒买鱼烹食，得鱼腹中书，固以怪之矣。又閒令吴广之次所旁丛祠中，夜篝火，狐鸣呼曰：‘大楚兴，陈胜王’。卒皆夜惊恐……","book":"《史记·陈涉世家》"},"example":{"text":"益之民穷变易煽，～竞潜结。","book":"清·丘逢甲《戊申广州五月五日作》诗"},"usage":"作宾语、定语；用于书面语","story":["秦朝末年，陈胜、吴广被抓去当兵，因大雨耽误了行程，只好起来造反。造反前陈胜请算命先生算了一卦，在白绸子写“陈胜王”塞入鱼腹，半夜在古庙用竹笼罩上篝火，学狐狸叫“陈胜王”，为起来造势，第二天就起义，建立张楚政权"]},{"id":48495,"word":"鱼悬甘饵","pinyin":"yú xuán gān ěr","abbr":"yxge","explanation":"鱼被钓上来是因为受了甜美的鱼饵和诱惑。比喻因贪利而丧生。","source":{"text":"臣闻鱼悬由于甘饵，勇夫死于重报。","book":"《晋书·段灼传》"}},{"id":48496,"word":"鱼惊鸟散","pinyin":"yú jīng niǎo sàn","abbr":"yjns","explanation":"指像鱼腐烂鸟溃散。比喻迅即崩溃，完全失败。","source":{"text":"公以国盗边警，知无不为，恤是同盟，诛其丑类，莫不鱼惊鸟散，面缚头悬。","book":"《陈书·高祖纪上》"},"similar":["鱼溃鸟散","鱼溃鸟离"],"usage":"作宾语、状语；用于比喻句"},{"id":48497,"word":"鱼惊鸟溃","pinyin":"yú jīng niǎo kuì","abbr":"yjnk","explanation":"象鸟惊飞，象鱼溃散而逃。比喻军队溃败。也比喻因受惊扰而乱纷纷地四下溃散。","source":{"text":"公以国盗边警，知无不为，恤是同盟，诛其丑类，莫不鱼惊鸟散，面缚头悬。","book":"南朝·陈·徐陵《陈公九锡文》"},"similar":["鱼惊鸟散"],"usage":"作宾语、状语；用于比喻句"},{"id":48498,"word":"鱼死网破","pinyin":"yú sǐ wǎng pò","abbr":"yswp","explanation":"不是鱼死，就是网破。指拼个你死我活。","source":{"text":"他就是张网捕鱼，我也拼他个鱼死网破。","book":"《杜鹃山》第五场"},"example":{"text":"我就是碰了个～，也不会回头。"},"similar":["以死相拼","你死我活","鹬蚌相争"],"opposite":["和平共处","同舟共济","和衷共济"],"usage":"作谓语、补语；常与“拼”连用"},{"id":48499,"word":"鱼水之情","pinyin":"yú shuǐ zhī qíng","abbr":"yszq","explanation":"象鱼儿离不开水那样，关系密切，感情深厚。","source":{"text":"鱼水之情，极其娱乐。","book":"明·赵弼《蓬莱先生传》"},"similar":["鱼水情深"],"usage":"作谓语、定语；用于关系等"},{"id":48500,"word":"鱼水之欢","pinyin":"yú shuǐ zhī huān","abbr":"yszh","explanation":"比喻夫妻是感情亲密。","source":{"text":"同谐鱼水之欢，共效于飞之愿。","book":"元·王实甫《西厢记》第二本第二折"},"example":{"text":"若是你心中情愿，与我暂效～，我便赦你。","book":"明·许仲琳《封神演义》第五十四回"}},{"id":48501,"word":"鱼水之爱","pinyin":"yú shuǐ zhī ài","abbr":"ysza","explanation":"比喻夫妻是感情亲密。","source":{"text":"仙尘路隔，不能相依。妾亦不忍以鱼水之爱，夺膝下之欢。","book":"清·蒲松龄《聊斋志异·罗刹海市》"}},{"id":48502,"word":"鱼水和谐","pinyin":"yú shuǐ hé xié","abbr":"yshx","explanation":"形容夫妇关系和好谐调如鱼水。","source":{"text":"今日也鱼水和谐，燕莺成对，琴瑟相调。","book":"元·王子一《误人桃源》第四折"},"example":{"text":"记得当初花正开，遇乔才，在阳台，～呀鱼水和谐。","book":"明·无名氏《鸣凤记·拜谒忠灵》"},"similar":["鱼水相欢"],"usage":"作宾语、定语；用于比喻句"},{"id":48503,"word":"鱼水情深","pinyin":"yú shuǐ qíng shēn","abbr":"ysqs","explanation":"象鱼儿离不开水那样，关系密切，感情深厚。","source":{"text":"鱼水之情，极其娱乐。","book":"明·赵弼《蓬莱先生传》"},"example":{"text":"沙钵略得了佳妇，正是新婚燕尔，～。","book":"蔡东藩《南北史演义》第八十三回"},"similar":["鱼水之情"],"usage":"作谓语、定语；用于关系等"},{"id":48504,"word":"鱼水深情","pinyin":"yú shuǐ shēn qíng","abbr":"yssq","explanation":"象鱼儿离不开水那样，关系密切，感情深厚。","source":{"text":"鱼水之情，极其娱乐。","book":"明·赵弼《蓬莱先生传》"}},{"id":48505,"word":"鱼水相投","pinyin":"yú shuǐ xiāng tóu","abbr":"ysxt","explanation":"形容夫妇关系和好谐调如鱼水。","source":{"text":"冤家聚首，似漆胶相和，鱼水相投。","book":"明·袁凫公《八声甘州·代周非月赋别阿蝉》套曲"},"similar":["鱼水和谐","鱼水相欢"],"usage":"作宾语、定语；用于比喻句"},{"id":48506,"word":"鱼水相欢","pinyin":"yú shuǐ xiāng huān","abbr":"ysxh","explanation":"形容夫妇关系和好谐调如鱼水。","source":{"text":"着甚来由，晓夜无休，又不是鱼水相欢，胶漆相投。","book":"明·沈仕《新水令·闺情》套曲"},"similar":["鱼水和谐","鱼水相投"],"usage":"作宾语、定语；用于比喻句"},{"id":48507,"word":"鱼沉雁杳","pinyin":"yú chén yàn yǎo","abbr":"ycyy","explanation":"比喻书信不通，音信断绝。","source":{"text":"鱼沉雁杳天涯路，始信人间别离苦。","book":"唐·戴叔伦《相思曲》"},"example":{"text":"源（刘源）出门年余，～。","book":"清·王韬《凇滨琐话·刘大复》"},"similar":["杳无音信","鱼沉鸿断","鱼沉雁静"],"usage":"作谓语、定语、状语；多用于比喻句"},{"id":48508,"word":"鱼沉雁渺","pinyin":"yú chén yàn miǎo","abbr":"ycym","explanation":"比喻书信不通，音信断绝。","source":{"text":"谡如蒿目时艰，空自拊髀，兼之宝山僻在海隅，文报不通，迢递并云，鱼沉雁渺，十分懊恼。","book":"清·魏秀仁《花月痕》第四十二回"},"similar":["鱼沉鸿断","鱼沉雁杳","鱼沉雁静"],"usage":"作宾语、定语；用于书面语"},{"id":48509,"word":"鱼沉雁落","pinyin":"yú chén yàn luò","abbr":"ycyl","explanation":"形容女子容貌美丽。","source":{"text":"毛嫱丽姬，人之所美也，鱼见之深入，鸟见之高飞，麋鹿见之决骤，四者孰知天下之正色哉！","book":"《庄子·齐物论》"},"example":{"text":"说甚么如花殿脚多奇妙，那《菱歌》起处，却也～。","book":"明·汤显祖《邯郸记·东巡》"},"similar":["沉鱼落雁"],"usage":"作谓语、宾语、定语；用于比喻句","story":["春秋时期，越国倾国倾城的美女西施在故乡溪边浣纱时，溪中游动的鱼儿见了她都羞愧得沉入水底，不敢浮出水面。汉元帝时绝色美女王昭君在她出塞嫁给匈奴王时，天空飞过的大雁惊讶她的美丽，忘了飞行跌落到树林里"]},{"id":48510,"word":"鱼沉雁静","pinyin":"yú chén yàn jìng","abbr":"ycyj","explanation":"比喻书信不通，音信断绝。","source":{"text":"未知道自别来他心可至诚，他应恨鱼沉雁静。","book":"明·高濂《瓦盆儿·题情》套曲"},"similar":["鱼沉鸿断","鱼沉雁杳"],"usage":"作宾语、定语；用于比喻句"},{"id":48511,"word":"鱼沉鸿断","pinyin":"yú chén hóng duàn","abbr":"ychd","explanation":"比喻书信不通，音信断绝。","source":{"text":"又恐鱼沉鸿断，阻隔云山，衔悲饮泪有万千。","book":"明·王玉峰《焚香记·饯别》"},"similar":["鱼沉雁静","鱼沉雁杳"],"usage":"作宾语、定语；用于比喻句"},{"id":48512,"word":"鱼游沸釜","pinyin":"yú yóu fèi fǔ","abbr":"yyff","explanation":"鱼在锅里游。比喻处境十分危险，有行将灭亡之虞。","source":{"text":"傀儡儿一场热闹，依旧的鱼游沸釜，燕处危巢。","book":"清·南荃外史《叹老》"},"similar":["鱼游沸鼎","鱼游釜底","鱼游釜中"],"usage":"作谓语、宾语、定语；指快要灭亡"},{"id":48513,"word":"鱼游沸釜，燕处危巢","pinyin":"yú yóu fèi fǔ，yàn chǔ wēi cháo","abbr":"yyffycwc","explanation":"沸釜：滚开的锅。鱼在滚开的锅里游，燕子在飘荡不定的帐幕上筑巢。比喻身处绝境，极其危险。","source":{"text":"若乃居安而不思危，寇至不知惧，此谓燕巢于幕，鱼游于鼎，亡不俟夕矣。","book":"三国·蜀·诸葛亮《将苑·戒备》"},"similar":["鱼游沸鼎，燕巢飞幕"],"usage":"作宾语、定语；指处境非常危险"},{"id":48514,"word":"鱼游沸鼎","pinyin":"yú yóu fèi dǐng","abbr":"yyfd","explanation":"鱼在锅里游。比喻处境十分危险，有行将灭亡之虞。","source":{"text":"鱼游沸鼎知无日，鸟覆危巢岂待风。","book":"唐·李商隐《行次昭应县道上》诗"},"example":{"text":"～中，烹燖化为汁。","book":"清·张鹏翀《和歧亭戒杀诗》之二"},"similar":["鱼游釜中","鱼游釜底","鱼游沸釜"],"usage":"作谓语、宾语、定语；指快要灭亡"},{"id":48515,"word":"鱼游沸鼎，燕巢飞幕","pinyin":"yú yóu fèi dǐng，yàn cháo fēi mù","abbr":"yyfdycfm","explanation":"沸鼎：滚开的锅；飞幕：飞动不定的帐幕。鱼在滚开的锅里游，燕子在飘荡不定的帐幕上筑巢。比喻身处绝境，极其危险。","source":{"text":"若乃居安而不思危，寇至不知惧，此谓燕巢于幕，鱼游于鼎，亡不俟夕矣。","book":"三国·蜀·诸葛亮《将苑·戒备》"},"similar":["鱼游沸釜，燕处危巢"],"usage":"作宾语、定语；指处境非常危险"},{"id":48516,"word":"鱼游濠上","pinyin":"yú yóu háo shàng","abbr":"yyhs","explanation":"表示纵情山水、逍遥遨游。","source":{"text":"《庄子·秋水》：“庄子与惠子游于濠梁之上，庄子曰：‘儵鱼出游从容，是鱼之乐也。’惠子曰：‘子非鱼，安知鱼之乐？’庄子曰：‘子非我，安知我不知鱼之乐？’惠子曰：‘我非子，固不知子矣；子固非鱼也，子之不知鱼之乐全矣。’ [下续示例]"},"example":{"text":"[上接出处] 庄子曰：‘请循其本，子曰“汝安知鱼乐”云者，既已知吾知之而问我，我知之濠上也。’”"}},{"id":48517,"word":"鱼游燋釜","pinyin":"yú yóu zhuó fǔ","abbr":"yyzf","explanation":"比喻处境危险，快要灭亡。燋，同“灼”，火烧。同“鱼游釜中”。"},{"id":48518,"word":"鱼游釜中","pinyin":"yú yóu fǔ zhōng","abbr":"yyfz","explanation":"釜：锅。鱼在锅里游。比喻处境危险，快要灭亡。","source":{"text":"若鱼游釜中，喘息须臾间耳。","book":"《后汉书·张纲传》"},"example":{"text":"姜尚进山，似～，肉在几上。","book":"明·许仲琳《封神演义》第九十一回"},"similar":["瓮中之鳖","鱼游沸鼎"],"usage":"作谓语、宾语、定语；指快要灭亡","story":["东汉顺帝时期，张婴聚众杀了残暴的广陵太守，转战于扬州、徐州一带，朝廷对他无可奈何。大将军梁冀任命张纲为广陵太守，张纲改用抚慰的手段，张婴主动带领义军投降说：不堪忍受前太守的压榨才起义的，这样做如鱼游釜中不能长久"]},{"id":48519,"word":"鱼游釜内","pinyin":"yú yóu fǔ nèi","abbr":"yyfn","explanation":"鱼在锅里游。比喻处境十分危险，有行将灭亡之虞。","source":{"text":"缘江焚毁，靡使所遗。建业穷蹙，鱼游釜内。","book":"《魏书·中山王英传》"},"similar":["鱼游釜底","鱼游釜中","鱼游沸釜"],"usage":"作谓语、宾语、定语；指快要灭亡"},{"id":48520,"word":"鱼游釜底","pinyin":"yú yóu fǔ dǐ","abbr":"yyfd","explanation":"鱼在锅里游。比喻处境十分危险，有行将灭亡之虞。","source":{"text":"夫鱼游釜底，燕处焚巢，旦夕偷生，不自知其频于外殆，我同胞其何以异是耶？","book":"清·秋瑾《普告同胞檄稿》"},"example":{"text":"～难持久。","book":"清·洪楝园《后南柯·宫议》"},"similar":["鱼游沸釜","鱼游沸鼎","鱼游釜中"],"usage":"作谓语、宾语、定语；指快要灭亡"},{"id":48521,"word":"鱼溃鸟散","pinyin":"yú kuì niǎo sàn","abbr":"ykns","explanation":"比喻军队溃败。","source":{"text":"番禺之功，浮级万数，左里之捷，鱼溃鸟散。","book":"《宋书·武帝纪中》"},"example":{"text":"兵刃暂交，～，僵尸蔽野，积甲若山。","book":"《隋书·杨素传》"},"similar":["鱼溃鸟离"],"usage":"作谓语、宾语；用于人群等"},{"id":48522,"word":"鱼溃鸟离","pinyin":"yú kuì niǎo lí","abbr":"yknl","explanation":"指像鱼腐烂鸟溃散。比喻迅即崩溃，完全失败。","source":{"text":"一击而鱼溃鸟离，四合而豕分蛇断。","book":"《周书·武帝纪下》：“王威既振，鱼溃鸟离，破竹更难，见瓴非易。”后蜀·何光远《鉴诫录·知机对》"},"example":{"text":"后蜀·何光远《鉴诫录·知机对》：“一击而～，四合而豕分蛇断。”"},"similar":["鱼惊鸟散","鱼溃鸟散"],"usage":"作宾语、状语；用于比喻句"},{"id":48523,"word":"鱼烂取亡","pinyin":"yú làn qǔ wáng","abbr":"ylqw","explanation":"鱼烂自内而发。比喻因内部腐败而自取灭亡。","source":{"text":"即微外国债主之干涉，而鱼烂取亡之气象，犹岌岌不可终日也。","book":"梁启超《中国国债史》"},"similar":["鱼烂而亡"],"usage":"作宾语、定语；用于书面语"},{"id":48524,"word":"鱼烂土崩","pinyin":"yú làn tǔ bēng","abbr":"yltb","explanation":"鱼烂：鱼腐烂从内脏起。比喻国家内部发生动乱。","source":{"text":"百姓一乱，则鱼烂土崩，莫之匡救。","book":"汉·荀悦《汉纪无侯传》"},"example":{"text":"自辰逾午，～。","book":"唐·骆宾王《兵部奏姚州破贼设蒙俭露布》"},"similar":["鱼烂而亡","鱼烂瓦解"],"usage":"作宾语、定语；指内乱"},{"id":48525,"word":"鱼烂河决","pinyin":"yú làn hé jué","abbr":"ylhj","explanation":"鱼肉腐烂，黄河溃决。比喻因自身原因溃败灭亡而不可挽救。","source":{"text":"河决不可复壅，鱼烂不可复全。","book":"语出《史记·秦始皇本纪论》附录汉班固曰"},"example":{"text":"～，不可救药，君子每为之太息。","book":"明·宋濂《傅守刚墓碣》"},"usage":"作宾语、定语；用于书面语"},{"id":48526,"word":"鱼烂瓦解","pinyin":"yú làn wǎ jiě","abbr":"ylwj","explanation":"犹言鱼烂土崩。","source":{"text":"余又告以鱼烂瓦解，其实未见，今外弱而形饥，非也。","book":"宋·叶適《朝请大夫陈公墓志铭》"},"similar":["鱼烂土崩"],"usage":"作宾语、定语；用于书面语"},{"id":48527,"word":"鱼烂而亡","pinyin":"yú làn ér wáng","abbr":"ylew","explanation":"鱼腐烂从内脏起。比喻国家因内部祸乱而灭亡。","source":{"text":"梁亡。此未有伐者。其言梁亡何？自亡也。其自亡奈何？鱼烂而亡也。","book":"《公羊传·僖公十九年》"},"similar":["鱼烂取亡"],"usage":"作宾语；指内部祸乱"},{"id":48528,"word":"鱼生空釜","pinyin":"yú shēng kōng fǔ","abbr":"yskf","explanation":"指贫穷得无粮可炊。","source":{"text":"羊踏寒蔬新少梦，鱼生空釜久谙穷。","book":"宋·陆游《独立》诗"},"similar":["釜中生鱼","鱼釜尘甑"],"usage":"作宾语、定语；用于书面语"},{"id":48529,"word":"鱼目乱珠","pinyin":"yú mù luàn zhū","abbr":"ymlz","explanation":"以鱼眼为珍珠。比喻以假乱真。","source":{"text":"有取世智称为佛智，犹如鱼目而乱明珠，不可雷同事须甄别。","book":"汉·魏伯阳《参同契》卷上：“鱼目岂为珠？蓬蒿不成槚。”宋·释道原《景德传灯录》卷二十八"}},{"id":48530,"word":"鱼目混珍","pinyin":"yú mù hùn zhēn","abbr":"ymhz","explanation":"比喻以假乱真。","source":{"text":"蝘蜓嘲龙，鱼目混珍。","book":"《参同契》上：“鱼目岂为珠，蓬蒿不成槚。”唐·李白《鸣皋歌送岑徵君》"},"similar":["鱼目混珠","鱼目间珠"],"usage":"作谓语、定语、状语；指以假乱真"},{"id":48531,"word":"鱼目混珎","pinyin":"yú mù hùn zhū","abbr":"ymhz","explanation":"比喻用假的冒充真的。同“鱼目混珠”。"},{"id":48532,"word":"鱼目混珠","pinyin":"yú mù hùn zhū","abbr":"ymhz","explanation":"混：搀杂，冒充。拿鱼眼睛冒充珍珠。比喻用假的冒充真的。","source":{"text":"鱼目岂为珠？蓬蒿不成槚。","book":"汉·魏伯阳《参同契》卷上"},"example":{"text":"可是这些卖国的老爷们不是也在～，也在自称为爱国忧民的志士吗？","book":"杨沫《青春之歌》第二部第三十八章"},"similar":["以假乱真","冒名顶替","滥竽充数"],"opposite":["黑白分明","泾渭分明","是非分明"],"usage":"作谓语、定语、状语；指以假乱真","story":["从前满愿在市场买了一颗直径约一寸的珍珠，特别喜欢就藏了起来。邻居寿量在路上发现一颗很大的鱼眼睛，便误以为是珍珠就捡回家收藏。后来他们两人得了同一种病需要用珍珠的粉末和药材才能治好。寿量取出那颗叫人辨认是鱼眼睛"]},{"id":48533,"word":"鱼目间珠","pinyin":"yú mù jiān zhū","abbr":"ymjz","explanation":"比喻以假乱真。","source":{"text":"珷玞乱玉，鱼目间珠，泥沙涨者其泉混，莨莠茂者其谷芜。","book":"《参同契》上：“鱼目岂为珠，蓬蒿不成槚。”宋·司马光《稷下赋》"},"similar":["鱼目混珍","鱼目混珠"],"usage":"作谓语、定语、状语；指以假乱真"},{"id":48534,"word":"鱼瞵鹗睨","pinyin":"yú lín è nì","abbr":"ylen","explanation":"像鱼和鹗那样瞪眼注视。比喻瞠目而视。","source":{"text":"盖士大夫沉浮里閈，其制行稍岸异者，未有不使流俗人鱼瞵鹗睨者也。","book":"清·陈康祺《郎潜纪闻》卷八"},"usage":"作宾语、定语；用于书面语"},{"id":48535,"word":"鱼笺雁书","pinyin":"yú jiān yàn shū","abbr":"yjys","explanation":"泛指书信。","source":{"text":"泪痕一线罗裙绣裾，相思两字鱼笺雁书。","book":"明·史叔考《醉罗歌·题情》套曲"},"similar":["鱼肠尺素","鱼肠雁足","鱼封雁帖"],"usage":"作宾语、定语；用于书面语"},{"id":48536,"word":"鱼米之乡","pinyin":"yú mǐ zhī xiāng","abbr":"ymzx","explanation":"指盛产鱼和稻米的富饶地方。","source":{"text":"谄以缯帛之利，示以麋鹿之饶，说其鱼米之乡，陈其畜牧之地。","book":"唐·王睃《清移突厥降人于南中安置疏》"},"example":{"text":"我知江州是个好地面，～，特地使钱买将那里去。","book":"明·施耐庵《水浒全传》第三十六回"},"similar":["洞天福地","天府之国","世外桃源"],"opposite":["万丈深渊","穷乡僻壤","穷途末路"],"usage":"作主语、宾语；指江南"},{"id":48537,"word":"鱼米之地","pinyin":"yú mǐ zhī dì","abbr":"ymzd","explanation":"盛产鱼和稻米的地方。指土地肥沃，物产丰富的地方。","source":{"text":"谄以缯帛之利，示以麋鹿之饶，说其鱼米之乡，陈其畜牧之地。","book":"唐·王睃《清移突厥降人于南中安置疏》"},"example":{"text":"按俗以土沃为～。","book":"清·翟灏《风俗通·禽鱼》"},"similar":["鱼米之乡"],"usage":"作宾语；用于书面语"},{"id":48538,"word":"鱼米乡","pinyin":"yú mǐ xiāng","abbr":"ymx","explanation":"指盛产鱼和稻米的富饶地方","source":{"text":"人人都说天堂美，怎比我洪湖鱼米乡。","book":"《洪湖赤卫队》第三场"},"similar":["鱼米之乡","鱼米之地"],"usage":"作主语、宾语；指江南"},{"id":48539,"word":"鱼纵大壑","pinyin":"yú zòng dà hè","abbr":"yzdh","explanation":"壑：大水坑。鱼跳进了大水坑。比喻遇到了施展才能的场所或时机。","source":{"text":"翼乎如鸿毛遇顺风，沛乎若巨鱼纵大壑。其得意如此，则胡禁不止，曷令不行？","book":"汉·王褒《圣主得贤臣颂》"},"example":{"text":"巨～，遂性似乘时。","book":"唐·钱起《巨鱼纵大壑》"}},{"id":48540,"word":"鱼网鸿离","pinyin":"yú wǎng hóng lí","abbr":"ywhl","explanation":"鸿：鸿雁；离：遭受。张网捕鱼，捉到的是鸿雁。比喻得到的不是自己想要的。","source":{"text":"鱼网之设，鸿则离之，燕婉之求，得此戚施。","book":"《诗经·邶风·新台》"},"similar":["鸿离鱼网"],"usage":"作宾语、定语；指不如意"},{"id":48541,"word":"鱼肉乡里","pinyin":"yú ròu xiāng lǐ","abbr":"yrxl","explanation":"鱼肉：指受宰割者。后比喻用暴力欺凌，任意残害无辜的人们。","source":{"text":"于是骄逸自恣，志意无厌，鱼肉百姓，以盈其欲。","book":"《后汉书·仲长统传》"},"example":{"text":"无非是包揽词讼，干预公事，～。","book":"清·吴趼人《二十年目睹之怪现状》第九十八回"},"similar":["胡作非为","为非作歹","横行霸道"],"opposite":["与人为善","相濡以沫","雪中送炭"],"usage":"作谓语、定语；指坏人"},{"id":48542,"word":"鱼肉百姓","pinyin":"yú ròu bǎi xìng","abbr":"yrbx","explanation":"鱼肉：指受宰割者。后比喻用暴力欺凌，任意残害无辜的人们。","source":{"text":"于是骄逸自恣，志意无厌，鱼肉百姓，以盈其欲。","book":"《后汉书·仲长统传》"},"example":{"text":"所率部队，毫不训练，本不打算作战，故亦不能作战，只是用做搜刮地方，～的工具而已。","book":"冯玉祥《我的生活》第二十二章"},"similar":["鱼肉乡里"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":48543,"word":"鱼肠尺素","pinyin":"yú cháng chǐ sù","abbr":"yccs","explanation":"指书信。","source":{"text":"鱼肠尺素，凤足数行，书此谢辞，终知不尽。","book":"北周·庾信《谢滕王集序启》"},"similar":["鱼肠雁足","鱼笺雁书","鱼封雁帖"],"usage":"作宾语、定语；用于书面语"},{"id":48544,"word":"鱼肠雁足","pinyin":"yú cháng yàn zú","abbr":"ycyz","explanation":"泛指书信。","source":{"text":"尺素在鱼肠，寸心凭雁足。","book":"南朝·梁·王僧孺《捣衣》诗"},"example":{"text":"～望缄封，地远三江岭万重。鱼跃岂通清远峡，雁飞难渡漳江东。","book":"唐·李绅《逾岭峤止荒陬抵高要》诗"},"similar":["鱼肠尺素","鱼笺雁书","鱼封雁帖"],"usage":"作宾语、定语；用于书面语"},{"id":48545,"word":"鱼菽之祭","pinyin":"yú shū zhī jì","abbr":"yszj","explanation":"菽：指豆类；祭：祭品，祭奠。以鱼和豆类作祭品。借指礼仪不周。","source":{"text":"常之母有鱼菽之祭，愿诸大夫之化我也。","book":"《公羊传·哀公六年》"},"example":{"text":"古者，庶人～，春秋修其祖祠。","book":"汉·桓宽《盐铁论·散不足》"}},{"id":48546,"word":"鱼质龙文","pinyin":"yú zhì lóng wén","abbr":"yzlw","explanation":"鱼的实质，龙的外表。谓虚有其表。","source":{"text":"夫鱼质龙文，似是而非。遭木而喜，见獭即悲。","book":"语出晋·葛洪《抱朴子·吴失》"},"usage":"作宾语、定语；用于书面语"},{"id":48547,"word":"鱼贯成行","pinyin":"yú guàn chéng xíng","abbr":"ygch","explanation":"比喻像鱼一样一人挨一个地排列着前行。","source":{"text":"而玄冬之月，沔汉干涸，皆当鱼贯而行，推难而进。","book":"晋·范汪《清严诏谕庾翼还镇疏》"}},{"id":48548,"word":"鱼贯而入","pinyin":"yú guàn ér rù","abbr":"yger","explanation":"象游鱼一样一个跟着一个地接连着走。形容一个接一个地依次序进入。","source":{"text":"将士皆攀木缘崖，鱼贯而进。","book":"《三国志·魏志·邓艾传》"},"example":{"text":"众才女除卞、孟两家姊妹在后，其余都是按名～。","book":"清·李汝珍《镜花缘》第六十七回"},"similar":["井然有序","有条不紊","鱼贯而前"],"opposite":["一拥而入","破门而入"],"usage":"作谓语、定语；指人或动物","story":["东晋集团苟安江南，南昌守将庾翼率军向北挺进，准备收复北方，统一中国，驻守襄阳一带。他手下官吏范汪向晋成帝上书说当前任务是练兵，积蓄粮草，待时机成熟再兴兵北伐。他说：“沔汉干涸，皆当鱼贯而行，推排而进”，反对北伐"]},{"id":48549,"word":"鱼贯而出","pinyin":"yú guàn ér chū","abbr":"ygec","explanation":"像游鱼那样连贯着出现。","source":{"text":"三人急不暇择，从窦中鱼贯而出，外面正是一条逼狭的胡同，还静悄悄的没人阻住。","book":"蔡东藩、许廑父《民国通俗演义》第八回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第58回：“然后叫一众搭客，十个一起的，～。”"},"usage":"作谓语、状语；用于书面语"},{"id":48550,"word":"鱼贯而前","pinyin":"yú guàn ér qián","abbr":"ygeq","explanation":"像游鱼一样连贯地向前行进。","source":{"text":"广武将军桓宝为前锋，摧锋陷阵，杀贼甚多，而塘路迮狭，琰军鱼贯而前，贼于舰中傍射之，前后断绝。","book":"《晋书·谢琰传》"},"example":{"text":"东南各有水门，崖壁峭绝，下临大河，贼缘崖腹微径～，城上矢石乱下，贼死伤殆尽。","book":"清·毕沅《续资治通鉴》卷四十三"},"similar":["鱼贯而进","鱼贯而入","鱼贯而行"],"usage":"作谓语；形容一个跟一个单行前进"},{"id":48551,"word":"鱼贯而行","pinyin":"yú guàn ér xíng","abbr":"ygex","explanation":"象游鱼一样一个跟着一个地接连着走。形容一个跟一个单行前进。","source":{"text":"而玄冬之月，沔汉乾涸，皆当鱼贯而行，排推而进。","book":"晋·范汪《请严诏谕庾翼还镇疏》"},"example":{"text":"提点使又将五色旗旛总来一展，那些将官又一一～，序立在坛边，向军师总行了礼。","book":"明·郭勋《英烈传》第三十八回"},"similar":["鱼贯而进","鱼贯而入","鱼贯而前"],"usage":"作谓语；形容一个跟一个单行前进"},{"id":48552,"word":"鱼贯而进","pinyin":"yú guàn ér jìn","abbr":"ygej","explanation":"象游鱼头尾相接一样。形容连续行进。","source":{"text":"将士皆攀木缘崖，鱼贯而进。","book":"《三国志·魏志·邓艾传》"},"similar":["鱼贯而前","鱼贯而行","鱼贯而入"],"usage":"作谓语；形容一个跟一个单行前进"},{"id":48553,"word":"鱼贯雁比","pinyin":"yú guàn yàn bǐ","abbr":"ygyb","explanation":"比喻连续而进，犹如鱼群相接，雁阵行进。","source":{"text":"余所见者，惟西湖春、秦淮夏、虎丘秋，差足比拟，然彼皆团簇一块，如画家横披，此独鱼贯雁比，舒长且三十里焉，则画家之手卷矣。","book":"清·张岱《陶庵梦忆·扬州清明》"},"similar":["鱼贯雁行"],"usage":"作宾语、状语；用于比喻句"},{"id":48554,"word":"鱼贯雁行","pinyin":"yú guàn yàn xíng","abbr":"ygyx","explanation":"比喻连续而进，犹如鱼群相接，雁阵行进。","source":{"text":"所隶之舰即可成队合操，水师之鱼贯雁行，即陆军之步伐止齐。","book":"清·马建忠《上李伯相复议何学士如璋奏设水师书》"},"similar":["鱼贯而入","鱼贯雁比"],"usage":"作宾语；比喻连续而进"},{"id":48555,"word":"鱼跃鸢飞","pinyin":"yú yuè yuān fēi","abbr":"yyyf","explanation":"指万物各得其所。","source":{"text":"鸢飞戾天，鱼跃于渊。","book":"《诗经·大雅·旱麓》"},"example":{"text":"龙跳虎伏归毫底，～入兴么。","book":"太平天国·洪仁玕《军次实录》"},"similar":["鸡飞狗跳","鸢飞鱼跃"],"usage":"作谓语、定语、状语；指局面"},{"id":48556,"word":"鱼跃龙门","pinyin":"yú yuè lóng mén","abbr":"yylm","explanation":"比喻举业成功或地位高升。","source":{"text":"语出《辛氏三秦记》：“河津一名龙门，禹凿山开门，阔一里馀，黄河自中流下，而岸不通车马。每逢春之际，有黄鲤鱼逆流而上，得过者便化为龙。”唐·元弼有《鱼跃龙门赋》。"},"example":{"text":"俗说～，过而为龙，唯鲤或然。","book":"宋·陆佃《埤雅·释鱼》"},"similar":["鱼升龙门"],"usage":"作宾语、定语；用于书面语"},{"id":48557,"word":"鱼轩莅止","pinyin":"yú xuān lì zhǐ","abbr":"yxlz","explanation":"鱼轩：古时候专门供诸侯夫人乘坐的车，用鱼皮装饰；莅：到。贵夫人的车停在前面。形容场面非常热闹。","source":{"text":"清·曾朴《孽海花》第三十回“这日官家如此热闹的场面，不用说老早的鱼轩莅止了。”"},"example":{"text":"我竟未想到，敝眷不在这里，～，何以应酬？","book":"高阳《草莽英雄》第三十二章"}},{"id":48558,"word":"鱼釜尘甑","pinyin":"yú fǔ chén zèng","abbr":"yfcz","explanation":"指贫穷的无粮可炊。","source":{"text":"（范冉）遭党人禁锢，遂推鹿车，载妻子，捃拾自资，或寓息客庐，或依宿树廕。如此十馀年，乃结草室而居焉。所止单陋，有时粮粒尽，穷居自若，言貌无改，闾里歌之曰：‘甑中生尘范史云，釜中生鱼范莱芜。’","book":"《后汉书·独行传·范冉》"},"example":{"text":"甘守着裙布钗荆，甘受尽～，不惭愧牛衣对影，也惟愿鹿车挽并。","book":"清·陈烺《梅喜缘·情诉》曲"},"similar":["釜中生鱼"],"usage":"作宾语、定语；用于生活","story":["汉朝时期，范冉遭到阉党的禁锢，只好弃官推鹿车载着妻子进行云游，经常是走到哪里无钱住店就在树荫下休息。十多年后终于自己盖了一间茅草屋，经常是断粮，靠吃野菜为生。同乡人嘲笑他说：“甑中生尘范史云，釜中生鱼范莱芜。”"]},{"id":48559,"word":"鱼雁沉杳","pinyin":"yú yàn chén yǎo","abbr":"yycy","explanation":"杳：远得不见踪影。比喻书信断绝。","source":{"text":"鱼沉雁杳天涯路，始信人间别离苦。","book":"唐·戴淑伦《相思曲》"}},{"id":48560,"word":"鱼馁肉败","pinyin":"yú něi ròu bài","abbr":"ynrb","explanation":"馁：鱼臭烂；败：肉腐烂。鱼烂肉腐。泛指变质的食物。","source":{"text":"食不厌精，脍不厌细。食饐而餲，鱼馁而肉败，不食。","book":"《论语·乡党》"},"usage":"作谓语、宾语、定语；指变质的食物"},{"id":48561,"word":"鱼鱼雅雅","pinyin":"yú yú yǎ yǎ","abbr":"yyyy","explanation":"形容车驾前行威仪整肃的样子。","source":{"text":"驾龙十二，鱼鱼雅雅。","book":"唐·韩愈《元和圣德诗》"},"example":{"text":"‘鱼以雅’者，言朱鹭之威仪，～也。","book":"明·杨慎《升庵诗话》第九卷"},"usage":"作谓语、定语；指队列等"},{"id":48562,"word":"鱼鲁帝虎","pinyin":"yú lǔ dì hǔ","abbr":"yldh","explanation":"指将鱼误写作鲁，帝误写作虎。泛指文字错讹。","source":{"text":"余家向有钞本，承讹踵谬，不无鱼鲁帝虎之失，恨不能一一订正之。","book":"清·金桌《〈南海百咏〉跋》"},"similar":["鲁鱼帝虎"],"usage":"作宾语、定语；用于书面语"},{"id":48563,"word":"鱼龙变化","pinyin":"yú lóng biàn huà","abbr":"ylbh","explanation":"指鱼变化为龙。比喻世事或人的根本性变化。","source":{"text":"任蛙蟆胜负，鱼龙变化，侬方在、华胥国。","book":"宋·刘克庄《水龙吟》词"},"example":{"text":"社会现象……又好像长江、大河，滚滚而下，旁流齐汇，泥沙毕集，任你～也逃不出这河流域以外。","book":"瞿秋白《饿乡纪程》二"},"usage":"作谓语、宾语；用于书面语"},{"id":48564,"word":"鱼龙曼延","pinyin":"yú lóng màn yán","abbr":"ylmy","explanation":"①古代百戏杂耍名。由艺人执持制作的珍异动物模型表演，有幻化的情节。鱼龙即所谓猞猁之兽，曼延亦兽名。②喻虚假多变，玩弄权术。亦作“鱼龙漫衍”。亦作“鱼龙"},{"id":48565,"word":"鱼龙曼羡","pinyin":"yú lóng màn xiàn","abbr":"ylmx","explanation":"比喻世事变幻。","source":{"text":"顽仙一觉浑瞒过，不在鱼龙曼羡中。","book":"清·龚自珍《小游仙词》之六"},"similar":["鱼龙曼衍"],"usage":"作宾语、定语；用于书面语"},{"id":48566,"word":"鱼龙曼衍","pinyin":"yú lóng màn yǎn","abbr":"ylmy","explanation":"鱼龙：是古代百戏的名称；漫衍：指巨兽的名称，古指百戏的名字。原指各种杂戏同时演出。后形容事物杂乱。也比喻变化很多。","source":{"text":"设酒池肉林以飨四夷之客，作巴俞都户、海中砀极、漫衍鱼龙、鱼抵之戏以观视之。","book":"《汉书·西域传赞》"},"example":{"text":"纵然气象万千，然辞语太没范围，不免～。","book":"清·曾朴《孽海花》第三十五回"},"similar":["鱼龙曼羡"],"usage":"作宾语；指事物"},{"id":48567,"word":"鱼龙混杂","pinyin":"yú lóng hùn zá","abbr":"ylhz","explanation":"比喻坏人和好人混在一起。","source":{"text":"风搅长空浪搅风，鱼龙混杂一川中。","book":"唐·张志和《和渔夫词》十三"},"example":{"text":"现在人多手乱，鱼龙混杂，倒是这么着，他们也洗洗清。","book":"清·曹雪芹《红楼梦》第九十四回"},"similar":["鱼目混珠","滥竽充数"],"opposite":["泾渭分明","黑白分明"],"usage":"作谓语、定语；指好坏在一起","story":["春秋时期，伍子胥因父与兄被楚平王所杀逃到吴国，对吴王阖庐说楚国黑白不分，人妖颠倒，鱼龙混杂。鼓动吴王攻打楚国，五战五胜，打到楚国都城郢城，楚平王已死，伍子胥为报杀父之仇，掘坟鞭尸"]},{"id":48568,"word":"鱼龙漫衍","pinyin":"yú lóng màn yǎn","abbr":"ylmy","explanation":"古代百戏杂耍名。由艺人执持制作的珍异动物模型表演，有幻化的情节。鱼龙即所谓猞猁之兽，曼延亦兽名。后多比喻虚假多变，玩弄权术。漫，通“曼”。","source":{"text":"设酒池肉林以飨四夷之客，作巴俞都户、海中砀极、漫衍鱼龙、鱼抵之戏以观视之。","book":"《汉书·西域传赞》"},"example":{"text":"暗尘浮动，正鱼龙曼衍，戏车交作。","book":"宋·无名氏《汉宫春（江月初圆）》"},"similar":["鱼龙曼衍"],"usage":"作宾语；指事物"},{"id":48569,"word":"鱼龙百变","pinyin":"yú lóng bǎi biàn","abbr":"ylbb","explanation":"像鱼龙那样变化多端。","source":{"text":"譬其毫翰，则风雨争飞；论其文采，则鱼龙百变。","book":"北周·庾信《谢滕王集序启》"},"example":{"text":"昌黎（韩愈）文无不根据经典，而议论仍未尝袭前人陈言，故下笔如～。","book":"清·何焯《义门读书记·昌黎集》"},"usage":"作宾语、定语；用于书面语"},{"id":48570,"word":"鲁人回日","pinyin":"lǔ rén huí rì","abbr":"lrhr","explanation":"指力挽危局。同“鲁阳挥戈”。","source":{"text":"徒怀汉臣伏阙之诚，竞无鲁人回日之感。","book":"南朝·梁·江淹《萧拜太尉扬州牧表》"},"similar":["鲁戈回日","鲁阳挥戈"],"usage":"作宾语、定语；用于挽救危局","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":48571,"word":"鲁卫之政","pinyin":"lǔ wèi zhī zhèng","abbr":"lwzz","explanation":"比喻情况相同或相似。","source":{"text":"语出《论语·子路》：“鲁卫之政，兄弟也。”鲁是周朝周公的封国，卫是周公之弟康叔的封国，两国的政治情况也像兄弟一样差不多。"},"example":{"text":"大家都在争夺出版处。‘有奶便是娘’，于是便生出了在文化强盗颐使下从事文化运动的滑稽现象。这种滑稽和所谓‘官民合办’其实是～。","book":"郭沫若《从典型说起》"},"usage":"作宾语；用于书面语"},{"id":48572,"word":"鲁女泣荆","pinyin":"lǔ nǚ qì jīng","abbr":"lnqj","explanation":"比喻留恋旧物，勾起对往事的缅怀。","source":{"text":"予所以玩之者，实锺鲁女泣荆之情。","book":"宋·释惠洪《石门文字禅·跋山谷字》"}},{"id":48573,"word":"鲁戈回日","pinyin":"lǔ gē huí rì","abbr":"lghr","explanation":"指力挽危局。同“鲁阳挥戈”。","source":{"text":"鲁戈回日难中天，潮生潮落穹碑前。","book":"清·丘逢甲《和平里行》"},"similar":["鲁戈挥日"],"usage":"作宾语、定语；用于挽救危局","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":48574,"word":"鲁戈挥日","pinyin":"lǔ gē huī rì","abbr":"lghr","explanation":"指力挽危局。同“鲁阳挥戈”。","source":{"text":"鬼斧凿空通鸟道，鲁戈挥日驻云梯。","book":"明·李东阳《登五显庙瑞芝亭》诗"},"similar":["挥戈反日","鲁戈回日"],"usage":"作宾语、定语；用于挽救危局","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":48575,"word":"鲁斤燕削","pinyin":"lǔ jīn yàn xuē","abbr":"ljyx","explanation":"鲁之削（小刀），宋之斤（斧头），质量都很好；如易地生产，在鲁造斤而在燕制削，质量不会优良。比喻由于地域等条件限制，学习模仿达不到原来水平。","source":{"text":"其《京舵子》、《起字调》、《马头调》、《南京调》之类，传自四方，间亦效之，而鲁斤燕削，迁地不能为良矣。","book":"清·李斗《扬州画舫录·虹桥录下》"},"usage":"作宾语、定语；用于比喻句"},{"id":48576,"word":"鲁殿灵光","pinyin":"lú diàn líng guāng","abbr":"ldlg","explanation":"灵光：汉代殿名。比喻仅存的有声望的人或事物。","source":{"text":"鲁灵光殿者，盖景帝程姬之子恭王余之所立也。……","book":"汉·王延寿《鲁灵光殿赋》序"},"example":{"text":"缶庐不作茫夫逝，～白石翁。","book":"柳亚子《六月一日初谒白石老人齐璜于快车胡同赋呈一首时老人年八十有九矣》"},"usage":"作宾语；比喻硕果仅存的人或事物"},{"id":48577,"word":"鲁灵光殿","pinyin":"lǔ líng guāng diàn","abbr":"llgd","explanation":"①汉代著名宫殿名。在曲阜（今山东曲阜）。②比喻硕果仅存的人或事物。","source":{"text":"鲁灵光殿者，盖景帝程姬之子恭王余之所立也。……","book":"汉·王延寿《鲁灵光殿赋》序"}},{"id":48578,"word":"鲁缟齐纨","pinyin":"lǔ gǎo qí wán","abbr":"lgqw","explanation":"古代齐国和鲁国生产的白色细绢。后也泛指名贵的丝织品。","source":{"text":"荀针秦缕，因制缉而成文；鲁缟齐纨，藉馨浆而受彩。","book":"南朝·梁·简文帝《谢敕赍纳袈裟启》"}},{"id":48579,"word":"鲁莽从事","pinyin":"lǔ mǎng cóng shì","abbr":"lmcs","explanation":"鲁莽：轻率。指说话做事不经过考虑。"},{"id":48580,"word":"鲁莽灭裂","pinyin":"lǔ mǎng miè liè","abbr":"lmml","explanation":"鲁莽：粗鲁莽撞；灭裂：轻率。形容行动粗鲁莽撞，做事草率，不负责任。","source":{"text":"君为政焉勿卤莽，治民焉勿灭裂。","book":"《庄子·则阳》"},"example":{"text":"惟时文之义理格律乃能入细，凡文之不从时文出者，尽～耳。","book":"严复《道学外传》"},"similar":["卤莽灭裂"],"usage":"作谓语、定语；指人草率"},{"id":48581,"word":"鲁连蹈海","pinyin":"lǔ lián dǎo hǎi","abbr":"lldh","explanation":"战国时齐国人鲁仲连不满秦王称帝的计划，曾说，秦如称帝，则蹈东海而死。后以之表示宁死而不受强敌屈辱的气节、情操。","source":{"text":"弃礼义而尚有功，鲁连蹈海；堕名城以杀豪杰，李耳出关。","book":"明·许时泉《武陵春》"},"example":{"text":"毕竟此生耻秦帝，忍学～计。","book":"庞树柏《朱舜水祠落成征诗敬赋》"},"similar":["宁死不屈"],"usage":"作宾语、定语；用于处事","story":["战国时期，秦昭王有称帝的野心，派秦国军队攻打赵国，齐国人鲁仲连以利害劝说赵魏两国大臣，阻止秦昭王称帝，并表示如果秦昭王称帝，他就跳海而死。秦军败退后，赵国的平原君拿出千金酬谢他，他拒不接受"]},{"id":48582,"word":"鲁阳回日","pinyin":"lǔ yáng huí rì","abbr":"lyhr","explanation":"指力挽危局。同“鲁阳挥戈”。","source":{"text":"此言酣饮与音乐……良辰之所以觉也。故追述鲁阳回日之意，而将转西日于中盛之时，以适己之盛观也。","book":"《文选·左思〈吴都赋〉》：“酣湑半，八音并，欢情留，良辰征，鲁阳挥戈而高麾，回曜灵于太清，将转西日而再中，齐既往之精诚。”刘逵注"},"similar":["鲁阳挥日"],"usage":"作宾语、定语；用于挽救危局","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":48583,"word":"鲁阳挥戈","pinyin":"lǔ yáng huī gē","abbr":"lyhg","explanation":"指力挽危局。","source":{"text":"鲁阳公与韩构难，战酣日暮，援戈而之，日为之反三舍。","book":"《淮南子·览冥训》"},"example":{"text":"至乃邹衍吹律而寒谷暖，～而暮景回……不测此何故也。","book":"唐·白居易《礼部试策第四道》"},"similar":["鲁人回日","鲁阳麾戈"],"usage":"作宾语、定语；用于挽救危局","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":48584,"word":"鲁阳挥日","pinyin":"lǔ yáng huī rì","abbr":"lyhr","explanation":"指力挽危局。同“鲁阳挥戈”。","source":{"text":"我歌又竟君不来，欲效鲁阳挥日暮。","book":"明·李东阳《得文敬双塔寺和章招之不至四叠韵奉答》"},"example":{"text":"～日难回，杞人忧天天不坠。","book":"蒋同超《题葛痴人仰天长笑图》诗"},"similar":["鲁阳挥戈","鲁阳回日"],"usage":"作宾语、定语；用于挽救危局","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":48585,"word":"鲁阳麾戈","pinyin":"lǔ yáng huī gē","abbr":"lyhg","explanation":"指力挽危局。同“鲁阳挥戈”。","source":{"text":"鲁阳麾戈兮转于西日，陶侃折翼兮登于上玄。","book":"唐·杨炯《浑天赋》"},"similar":["鲁阳挥戈","鲁阳挥日"],"usage":"作宾语、定语；用于挽救危局","story":["传说周武王率领诸侯讨伐殷纣王，旌旗飘扬，杀声四起，战斗非常激烈，周武王的部下鲁阳公愈战愈勇，敌人望风披靡，眼看天色已晚，鲁阳公举起长戈向日挥舞，吼声如雷，太阳又倒退三个星座，恢复了光明，终于全歼了敌军"]},{"id":48586,"word":"鲁鱼亥豕","pinyin":"lǔ yú hài shǐ","abbr":"lyhs","explanation":"把“鲁”字错成“鱼”字，把“亥”字错成“豕”字。指书籍在传写或刻印过程中的文字错误。","source":{"text":"有读史记者曰：‘晋师三豕涉河。’子夏曰：‘非也，是己亥也。夫己与三相近，豕与亥相似。’","book":"晋·葛洪《抱朴子》：“谚云：‘书三写，鱼成鲁，帝成虎。’”《吕氏春秋·察传》"},"example":{"text":"因取历朝著录，略其～之细，而特以部次条别，疏通伦类，考其得失之故，而为之校雠。","book":"清·章学诚《校雠通义》"},"similar":["阴阳背谬","阴差阳错","豕亥鱼鲁"],"usage":"作宾语、定语；指文字错误"},{"id":48587,"word":"鲁鱼帝虎","pinyin":"lǔ yú dì hǔ","abbr":"lydh","explanation":"指文字传抄错误。","source":{"text":"谚云：‘书三写，鱼成鲁，帝成虎。’","book":"晋·葛洪《抱朴子》"},"example":{"text":"较之西域元文，已经三易。其中舛讹，不但～而已。","book":"清·阮葵生《茶余客话》第14卷"},"similar":["鲁鱼亥豕","鱼鲁帝虎"],"usage":"作宾语、定语；指传抄及刊印的文字错误"},{"id":48588,"word":"鲁鱼陶阴","pinyin":"lǔ yú táo yīn","abbr":"lyty","explanation":"“鲁”和“鱼”、“陶”和“阴”字形相近易混。指传抄刊印中的文字错误。","source":{"text":"‘六经’本皆古文，自唐天宝三年，诏集贤学士卫包改古文，更作楷文，以便习读，而俗书始杂之。至今则魯魚陶陰，字既差讹；聖圣體体，书复苟简矣。","book":"明·焦竑《焦氏笔乘·卫包改古文》"},"similar":["鲁鱼陶陰","鲁鱼帝虎"],"usage":"作宾语、定语；指传抄及刊印的文字错误"},{"id":48589,"word":"鲂鱼赪尾","pinyin":"fáng yú chēng wěi","abbr":"fycw","explanation":"鲂：鱼名，体似鳊鱼；赪：赤色；赪尾：红色的尾巴。鲂鱼的尾巴红了。比喻人们忧劳国事，非常辛苦，就象鲂鱼尾巴累红了一样。","source":{"text":"鲂鱼赪尾，王室如毁。","book":"《麻经·周南·汝坟》"},"example":{"text":"既而～，四郊多垒。","book":"北周·庾信《哀江南赋》"},"usage":"作谓语、定语；指人辛劳"},{"id":48590,"word":"鲂鱼趙尾","pinyin":"fáng yú chēng wěi","abbr":"fycw","explanation":"趙红色。形容人困苦劳累，负担过重。","source":{"text":"鲂鱼趙尾，王室如爏。毛传趙，赤也；鱼劳则尾赤。朱熹集传鲂尾本白而今赤，则劳甚矣。","book":"《诗·周南·汝坟》"}},{"id":48591,"word":"鲇鱼上竹","pinyin":"nián yú shàng zhú","abbr":"nysz","explanation":"比喻本想前进反而后退。","source":{"text":"君于仕宦，亦何异鲇鱼上竹竿耶？","book":"宋·欧阳修《归田录》"},"example":{"text":"许多时打哄，～，被人弄，知多少。","book":"宋·张兹《水龙吟》词"},"usage":"作宾语、定语；用于比喻句"},{"id":48592,"word":"鲇鱼上竹竿","pinyin":"nián yú shàng zhú gān","abbr":"nyszg","explanation":"俗说鲇鱼能上竹竿，但鲇鱼黏滑无鳞，爬竿毕竟困难。后以之比喻上升艰难。"},{"id":48593,"word":"鲇鱼上竿","pinyin":"nián yú shàng gān","abbr":"nysg","explanation":"比喻上升艰难。同“鲇鱼上竹竿”。","source":{"text":"君于仕宦，亦何异鲇鱼上竹竿耶？","book":"宋·欧阳修《归田录》"},"example":{"text":"老人家益贫而官益拙，～，可笑，可悯。","book":"金·王若虚《答张仲杰书》"}},{"id":48594,"word":"鲇鱼缘竹竿","pinyin":"nián yú yuán zhú gān","abbr":"nyyzg","explanation":"比喻上升艰难。同“鮎鱼上竹竿”。"},{"id":48595,"word":"鲍子知我","pinyin":"bào zǐ zhī wǒ","abbr":"bzzw","explanation":"指彼此相互了解而情谊深切。","source":{"text":"管仲曰：‘……生我者父母，知我者鲍子也。’","book":"《史记·管晏列传》"},"example":{"text":"平远丁文诚公，清风亮节，冠绝一时，平生赋性鲠直，不谙世故，持节二十年，与连圻诸将帅有公义而无私交，独于合肥兄弟，深～之感。","book":"陈夔龙《梦蕉亭杂记》"},"similar":["管鲍之交"],"usage":"作宾语、定语；指彼此了解","story":["春秋时期，齐国管仲与鲍叔牙关系特别好，他们合伙做生意，鲍叔牙总是多出本钱少分利，乐意帮助贫寒的管仲。管仲率军打仗兵败，只有鲍叔牙了解他的苦衷。小白执政齐国后，鲍叔牙把相国的位子让给管仲，管仲说：“知我者鲍子也。”"]},{"id":48596,"word":"鲍鱼之次","pinyin":"bào yú zhī cì","abbr":"byzc","explanation":"卖咸鱼的店铺。鱼常腐臭，因以喻恶人之所或小人聚集之地。亦作“鲍鱼之次”。","source":{"text":"次，若今市亭然。","book":"《大戴礼记·曾子疾病》：“与君子游，苾乎如入兰芷之室，久而不闻，则与之化矣；与小人游，贷乎如入鲍鱼之次，久而不闻，则与之化矣。”王聘珍解诂"},"similar":["鲍鱼之肆"],"usage":"作宾语；指坏人聚积的地方"},{"id":48597,"word":"鲍鱼之肆","pinyin":"bào yú zhī sì","abbr":"byzs","explanation":"鲍：咸鱼；肆：店铺。卖咸鱼的店。比喻坏人成堆的地方。","source":{"text":"与恶人居，如入鲍鱼之肆，久而不闻其臭，亦与之化矣。","book":"汉·刘向《说苑·杂言》"},"example":{"text":"智者见智，仁者见仁，入～，而不自知其臭，其斯之谓乎？","book":"清·忧患余生《〈官场现形记〉序》"},"similar":["鲍鱼之次"],"opposite":["芝兰之室"],"usage":"作宾语；指坏人聚积的地方"},{"id":48598,"word":"鲐背苍耈","pinyin":"tái bèi cāng gǒu","abbr":"tbcg","explanation":"鲐背：指老人背上生斑如鲐鱼背，因用以称长寿老人；耈：老年人。泛指老年人。","source":{"text":"黄耈台背，以引以翼，寿考维祺，以介景福","book":"《诗经·大雅·行苇》"}},{"id":48599,"word":"鲜为人知","pinyin":"xiǎn wéi rén zhī","abbr":"xwrz","explanation":"很少被人知道。鲜：少；为：被","source":{"text":"后来伴着主人度过了那段漫长的鲜为人知的冷宫生活不知洒上了多少珍妃泪。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"这是一个～的故事。"},"similar":["默默无闻"],"opposite":["赫赫有名"],"usage":"作谓语、定语；用于人或事物等"},{"id":48600,"word":"鲜廉寡耻","pinyin":"xiān lián guǎ chǐ","abbr":"xlgc","explanation":"无廉洁之操守且不知羞耻。","source":{"text":"朝廷不复敦尚名节，故士大夫鲜廉寡耻，不知君臣之义。","book":"宋·李纲《建炎进退志总叙上之上》"},"example":{"text":"觍然向敌国的平沼与倭皇献媚，～，已达极点。","book":"邹韬奋《全国舆论对汪逆的愤慨》"},"similar":["寡廉鲜耻"],"usage":"作谓语、定语；指人没有廉耻"},{"id":48601,"word":"鲜有其比","pinyin":"xiǎn yǒu qí bǐ","abbr":"xyqb","explanation":"鲜：少。很少有能够与之相比的。","source":{"text":"偓，庄宗之外孙，汉祖之婿，女即孝章皇后，近代贵盛，鲜有其比。","book":"《宋史·宋偓传》"},"example":{"text":"余尝乞其画佛像一幅，绝似丁南羽，近时～。","book":"清·钱泳《履园丛话·画学·画中人》"},"usage":"作谓语、定语；用于人或事等"},{"id":48602,"word":"鲜眉亮眼","pinyin":"xiān méi liàng yǎn","abbr":"xmly","explanation":"犹言眉清目秀。形容容貌漂亮。","source":{"text":"虽则做个小丑脚色，脸嘴原好，鲜眉亮眼，是个乖巧的人。","book":"《快心编三集》第四回"},"similar":["眉清目秀"],"usage":"作谓语、定语、状语；用于书面语"},{"id":48603,"word":"鲜艳夺目","pinyin":"xiān yàn duó mù","abbr":"xydm","explanation":"色彩鲜美艳丽，十分引人注目。","source":{"text":"底下绿裤红鞋，鲜艳夺目。","book":"清·曹雪芹《红楼梦》第六十五回"},"example":{"text":"顾八奶由右门出，她穿戴仍然～，气势汹汹地走进来。","book":"曹禺《日出》第四幕"},"similar":["五彩缤纷"],"opposite":["暗淡无光"],"usage":"作谓语、定语、状语；指引人注目"},{"id":48604,"word":"鲜血淋漓","pinyin":"xiān xuè lín lí","abbr":"xxll","explanation":"淋漓：不停往下滴落的样子。形容鲜血流淌不止。","source":{"text":"也有打破头的，鲜血淋漓，好不惨伤。","book":"元·金仁杰《追韩信》第四折：“猿背弯躬，醉眼朦胧，腰项斜称，呀！他可早鲜血淋漓了战袍领！”清·钱彩《说岳全传》第七十一回"},"example":{"text":"始缠之时，其女百般痛苦，抚足哀号，甚至皮腐肉败，～。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["血流如注"],"usage":"作谓语、定语；用于流血场面"},{"id":48605,"word":"鲜衣凶服","pinyin":"xiān yī xiōng fú","abbr":"xyxf","explanation":"鲜：艳丽；凶服：素色的丧服。用鲜艳的衣料作丧服，成了违反风俗的奇装异服。后多形容放浪无赖的装饰打扮。","source":{"text":"乃部户曹掾史，与乡吏、亭长、里正、父老、伍人，杂举长安中轻薄少年恶子，无市籍商贩作务，而鲜衣凶服被铠扞持刀兵者，悉籍记之，得数百人。","book":"《汉书·酷吏传·尹赏》"}},{"id":48606,"word":"鲜衣好食","pinyin":"xiān yī hǎo shí","abbr":"xyhs","explanation":"鲜：有光彩的。穿的是华丽的衣服，吃的是美味的食品。形容生活优裕。","source":{"text":"逢吉性侈靡，好鲜衣美食，中书公膳，鄙而不食，私庖供馔，务尽甘珍。","book":"《旧五代史·汉书·苏逢吉传》"},"example":{"text":"诸子以～进者，辄屏不御。","book":"清·汪琬《顾徐赤墓志铭》"},"similar":["锦衣玉食","鲜衣美食"],"usage":"作宾语、定语；指奢华的生活"},{"id":48607,"word":"鲜衣怒马","pinyin":"xiān yī nù mǎ","abbr":"xynm","explanation":"美服壮马。谓服饰豪奢。","source":{"text":"群盗得志，弥横恣为推埋，鲜衣怒马，以游侠为称，其魁名朱国臣者，初亦宰夫也。","book":"明·沈德符《野获编·刑部·冤狱》"},"example":{"text":"鸦片洋标束锦装，～浮云队。","book":"清·陈寅《驭仆篇》"},"similar":["鲜衣良马"],"usage":"作宾语、定语；用于书面语"},{"id":48608,"word":"鲜衣美食","pinyin":"xiān yī měi shí","abbr":"xyms","explanation":"鲜：有光彩的。穿的是华丽的衣服，吃的是美味的食品。形容生活优裕。","source":{"text":"德称此时虽然借寓僧房，图书满案，鲜衣美食，已不似在先了。","book":"明·冯梦龙《警世通言》第17卷"},"example":{"text":"往往以为白种人都是对人来讲耶稣道理或开洋行的，～，一不高兴就用皮鞋向人乱踢。","book":"鲁迅《且介亭杂文末编·写于深夜里》"},"similar":["锦衣玉食"],"usage":"作主语、宾语、定语；形容生活优裕"},{"id":48609,"word":"鲜衣良马","pinyin":"xiān yī liáng mǎ","abbr":"xylm","explanation":"美服壮马。谓服饰豪奢。同“鲜车怒马”。","source":{"text":"汝阴男子姓许，少孤，为人白皙，有姿调，好鲜衣良马，游骋无度。","book":"宋·李昉《太平广记》卷第三一○引唐·载孚《广异记·汝阴人》"},"similar":["鲜衣怒马"],"usage":"作宾语、定语；用于书面语"},{"id":48610,"word":"鲜规之兽","pinyin":"xiān guī zhī shòu","abbr":"xgzs","explanation":"鲜：小；鲜规：渺小。指小虫小兽。比喻弱小势力。","source":{"text":"鲜规之兽，莫得安其性命有情者。","book":"战国·宋·庄周《庄子·天运》"},"usage":"作宾语；用于书面语"},{"id":48611,"word":"鲜蹦活跳","pinyin":"xiān bèng huó tiào","abbr":"xbht","explanation":"指鱼、禽等乱蹦乱跳而有生气。","source":{"text":"秋水茫茫，在水一方，一尾尾鲜蹦活跳的鲈鱼，引来了多少美食之客。","book":"吴趋《姑苏野史·秋风江南话鲈鱼》"},"usage":"作定语、状语；用于动物等"},{"id":48612,"word":"鲜车健马","pinyin":"xiān chē jiàn mǎ","abbr":"xcjm","explanation":"谓车辆鲜丽，辕马壮健。形容豪富。同“鲜车怒马”。","source":{"text":"唐·康骈《剧谈录·曲江》:“彩幄翠帱，匝于堤岸，鲜车健马，比肩击毂。”"},"similar":["鲜车怒马"],"usage":"作宾语、定语；形容生活豪华"},{"id":48613,"word":"鲜车怒马","pinyin":"xiān yī nù mǎ","abbr":"xcnm","explanation":"怒：气势强盛。华丽的衣服，肥壮的马。形容服用讲究，生活豪华。","source":{"text":"蜀地肥饶，掾史家赀多至千万，皆鲜车怒马，以财货自达。","book":"《后汉书·第五伦传》"},"example":{"text":"一年升参，两年讨缺，三年转考，俱得个好房科。～，把个寒儒，不放在眼里。","book":"明·东鲁古狂生《醉醒石》第十四回"},"similar":["鲜车健马"],"usage":"作宾语、定语；形容生活豪华"},{"id":48614,"word":"鲤鱼跳龙门","pinyin":"lǐ yú tiào lóng mén","abbr":"lytlm","explanation":"古代传说黄河鲤鱼跳过龙门，就会变化成龙。比喻中举、升官等飞黄腾达之事。也比喻逆流前进，奋发向上。","source":{"text":"俗说鱼跃龙门，过而为龙，唯鲤或然。","book":"《埤雅·释鱼》"},"example":{"text":"～，一个接一个；木船上险滩，一波盖一波。","book":"梁上泉《水运图》"},"usage":"作宾语；比喻中举、升官等飞黄腾达之事"},{"id":48615,"word":"鲧殛禹兴","pinyin":"gǔn jí yú xīng","abbr":"gjyx","explanation":"鲧：古人名，禹的父亲；殛：杀死；禹兴：禹治水成功，并得到帝位。鲧治水无功被杀，其子禹治水成功。比喻一人有罪不能株连亲属。","source":{"text":"鲧殛而禹兴，伊尹放大甲而相之，卒无怨。","book":"《左传·襄公二十一年》"}},{"id":48616,"word":"鲸吞虎噬","pinyin":"jīng tūn hǔ shì","abbr":"jths","explanation":"像鲸鱼和老虎一样吞食。多比喻吞并土地财物。","source":{"text":"前代乱离，鲸吞虎噬，无卜世卜年之意，故斯道久缺，反为不急之务。","book":"宋·范仲淹《上执政书》"},"example":{"text":"他谋多中伤，威权明仗，～，谁敢拦挡？","book":"明·张景《飞丸记·明廷张胆》"},"similar":["鲸吞蛇噬","鲸吞虎据"],"usage":"作宾语、定语；用于比喻句"},{"id":48617,"word":"鲸吞虎据","pinyin":"jīng tūn hǔ jù","abbr":"jthj","explanation":"据：占据。象鲸鱼那样吞食，如老虎那样占据着。比喻强者兼并弱者。","source":{"text":"自隋朝维绝，宇县瓜分，小则鼠窃狗偷，大则鲸吞虎据。","book":"《旧唐书·萧铣等传论》"},"similar":["鲸吞虎噬"],"usage":"作宾语、定语；用于比喻句"},{"id":48618,"word":"鲸吞蚕食","pinyin":"jīng tūn cán shí","abbr":"jtcs","explanation":"像鲸鱼吞食一口吞下，像蚕吃桑叶逐步侵占。比喻用各种手段侵吞。","source":{"text":"若土耳机三土一旦为俄所鲸吞蚕食，则地兼三海，拓疆万里。","book":"清·王韬《英宜保土》"},"example":{"text":"～言终验，敌弱朋强局已更。","book":"柳亚子《屈辱》诗"},"similar":["蚕食鲸吞"],"usage":"作谓语、宾语；指侵吞"},{"id":48619,"word":"鲸吞蛇噬","pinyin":"jīng tūn shé shì","abbr":"jtss","explanation":"像鲸鱼和蛇一样吞食。比喻侵吞兼并。","source":{"text":"秦人一出其师以挠山东，诸侯莫能支，鲸吞蛇噬，不及百年，天下席卷而入于秦矣。","book":"清·鲁一同《秦论》"},"similar":["鲸吞虎噬"],"usage":"作宾语、定语；用于比喻句"},{"id":48620,"word":"鲸吸牛饮","pinyin":"jīng xī niú yǐn","abbr":"jxny","explanation":"鲸吸：像鲸鱼吸水一样。如鲸吸百川，似牛饮池水。比喻放量狂饮。","source":{"text":"汉·韩婴《韩诗外传》第四卷：“桀为酒池，可以运舟，糟丘足以道望十里，一鼓而牛饮者三千人。” 唐·杜甫《饮中八仙歌》：“饮如长鲸吸百川。："},"usage":"作宾语、定语；用于比喻句"},{"id":48621,"word":"鲸呿鳌掷","pinyin":"jīng qù áo zhì","abbr":"jqaz","explanation":"呿：张口。鲸鱼张口，海龟腾跃。比喻诗文气势雄伟奇特，意境荒诞虚幻。","source":{"text":"鲸呿鳌掷，牛鬼蛇神，不足为奇虚荒诞幻也。","book":"唐·杜牧《李贺集序》"},"example":{"text":"笔扛龙文百斛鼎，～风雨惊。","book":"宋·张淏《云谷杂记》卷一"}},{"id":48622,"word":"鲸波怒浪","pinyin":"jīng bō nù làng","abbr":"jbnl","explanation":"犹言惊涛骇浪。比喻险恶的环境或尖锐激烈的斗争。","source":{"text":"乾隆初，上于端午日命内侍习竞渡于福海中，皆画船箫鼓，飞龙鷁首，络绎于鲸波怒浪间。","book":"清·昭梿《啸亭续录·端午龙舟》"},"similar":["鲸波鳄浪","鲸波鼍浪","惊涛骇浪"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":48623,"word":"鲸波鳄浪","pinyin":"jīng bō è làng","abbr":"jbel","explanation":"犹惊涛骇浪。亦作“鲸波鼍浪”、“鲸涛鼍浪”。","source":{"text":"望鲸波鳄浪连天涌，莽天涯沓沓濛濛。","book":"清·南荃居士《海侨春传奇·疯诉》"},"similar":["惊涛骇浪","鲸波鼍浪"],"usage":"作主语、宾语、定语；用于斗争等"},{"id":48624,"word":"鲸波鼍浪","pinyin":"jīng bō tuó làng","abbr":"jbtl","explanation":"比喻险恶的环境或尖锐激烈的斗争。同“鲸涛鼍浪”。","source":{"text":"逮至明代，欧洲诸国日强，精于驾舟，不惮远涉，往往于鲸波鼍浪中探测新地，以为通商互市之区。","book":"清·王韬《西人重日轻华》"},"similar":["鲸波鳄浪","鲸波怒浪","惊涛骇浪"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":48625,"word":"鲸涛鼍浪","pinyin":"jīng tāo tuó làng","abbr":"jttl","explanation":"犹言惊涛骇浪。比喻险恶的环境或尖锐激烈的斗争。","source":{"text":"苟其不死也，则如从军者掷身于硝烟弹雨之间，航海者赌命于鲸涛鼍浪之窟，其不死自若也。","book":"梁启超《覆金山中华会馆书》"},"similar":["鲸波鼍浪"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":48626,"word":"鲽离鹣背","pinyin":"dié lí jiān bèi","abbr":"dljb","explanation":"比喻夫妻或恋人分离。"},{"id":48627,"word":"鳃鳃过虑","pinyin":"xǐ xǐ guò lǜ","abbr":"ssgl","explanation":"鳃鳃：恐惧的样子。形容过于忧虑和恐惧的样子。","source":{"text":"故虽地广兵强，鳃鳃常恐天下之一合而共轧己也。","book":"东汉·班固《汉书·刑法志》"},"usage":"作定语、状语；用于书面语"},{"id":48628,"word":"鳄鱼眼泪","pinyin":"è yú yǎn lèi","abbr":"eyyl","explanation":"鳄鱼：一种生性凶残，捕食人、畜的爬行动物。传说鳄鱼在吞食人畜时，边吃边流眼泪。比喻恶人的假慈悲。","example":{"text":"他终于挤出了几滴～。"},"usage":"作主语、宾语；指假慈悲"},{"id":48629,"word":"鳌头独占","pinyin":"áo tóu dú zhàn","abbr":"atdz","explanation":"比喻占首位或第一名。","source":{"text":"殿前曾献升平策，独占鳌头第一名。","book":"元·无名氏《陈州粜米》楔子"},"example":{"text":"我国目前蚕茧总产量已超过了日本，国际蚕丝市场上，我们已～了。","book":"《新华文摘》1987年第5期"},"similar":["独占鳌头"],"usage":"作谓语；指取第一名"},{"id":48630,"word":"鳌愤龙愁","pinyin":"áo fèn lóng chóu","abbr":"aflc","explanation":"如鼍愤怒，如龙忧愁。比喻乐曲的情调悲愤。","example":{"text":"这是一首～音乐，你想听吗？"}},{"id":48631,"word":"鳌掷鲸吞","pinyin":"áo zhì jīng tūn","abbr":"azjt","explanation":"比喻文辞气势磅礴，跌宕起伏。亦作“鳌掷鲸呿”。","source":{"text":"龙浮马负之图，已曾抉奥运会；鳌掷鲸吞之句，无不深研。","book":"明·陈汝元《金莲记·偕计》"},"example":{"text":"至于杜之海涵地负，韩之鳌掷鲸呿，尚有所未逮。","book":"清宋荦《漫堂说诗》三"},"similar":["鳌掷鲸呿"],"usage":"作定语；用于文章等"},{"id":48632,"word":"鳌掷鲸呿","pinyin":"áo zhì jīng qù","abbr":"azjq","explanation":"比喻文辞气势磅礴，跌宕起伏。同“鳌掷鲸吞”。","source":{"text":"鲸呿鳌掷，牛鬼蛇神，不足为奇虚荒诞幻也。","book":"唐·杜牧《李贺集序》"},"example":{"text":"至于杜之海涵地负，韩之～，尚有所未逮。","book":"清·宋荦《漫堂说诗》三"},"similar":["鳌掷鲸吞"],"usage":"作定语；用于文章等"},{"id":48633,"word":"鳌里夺尊","pinyin":"áo lǐ duó zūn","abbr":"aldz","explanation":"犹言出类拔萃。","source":{"text":"大家给他祝寿，他大模大样的承受，仿佛觉出自己是鳌里夺尊的一位老英雄。","book":"老舍《骆驼祥子》"},"example":{"text":"我们希望你能～。"},"similar":["出类拔萃"],"usage":"作谓语、定语；指出类拔萃"},{"id":48634,"word":"鳌鸣鳖应","pinyin":"áo míng biē yīng","abbr":"amby","explanation":"比喻声气相通，互相感应。","example":{"text":"这两只小动物在一起时间久了，表现得非常默契，严然是～。"}},{"id":48635,"word":"鳏寡孤惸","pinyin":"guān guǎ gū dì","abbr":"gggq","explanation":"泛指没有劳动力而又没有亲属供养的人。惸，无兄弟。同“鳏寡孤独”。"},{"id":48636,"word":"鳏寡孤独","pinyin":"guān guǎ gū dú","abbr":"gggd","explanation":"泛指没有劳动力而又没有亲属供养的人。","source":{"text":"老而无妻曰鳏，老而无夫曰寡，老而无子曰独，幼而无父曰孤；此四者，天下之穷民而无告者。","book":"战国·邹·孟轲《孟子·梁惠王下》"},"example":{"text":"如果是～，真正失去劳动力的老人家，政府和农业社，都会保障他们的生活的。","book":"周立波《禾场上》"},"similar":["孤苦伶仃","无依无靠","举目无亲"],"opposite":["荣华富贵","五世同堂","五世其昌"],"usage":"作主语、宾语、定语；不专指一个","story":["战国时期，有人劝齐宣王毁掉周天子巡狩朝见诸侯的明堂，他征询孟子的意见，孟子认为如果要实行王政就不能毁，因为周文王当年靠施行王政才统一天下，他除给予当官的优惠外，也对鳏夫、寡妇、独夫、孤儿这种无助的人特殊照顾，齐宣王认为言之有理"]},{"id":48637,"word":"鳏寡孤茕","pinyin":"guān guǎ gū qióng","abbr":"gggq","explanation":"茕，无兄弟。泛指没有劳动力而又没有亲属供养的人。同“鳏寡孤独”。","source":{"text":"赈赐贫人，先尽鳏寡孤茕目下不济者。","book":"唐·陆贽《赐京畿及同华等州百姓种子赈给贫人诏》"},"similar":["鳏寡孤独","鳏寡茕独"],"usage":"作主语、宾语、定语；不专指一个"},{"id":48638,"word":"鳏寡惸独","pinyin":"guān guǎ gū dú","abbr":"ggqd","explanation":"泛指没有劳动力而又没有亲属供养的人。惸，无兄弟。同“鳏寡孤独”。。"},{"id":48639,"word":"鳏寡茕独","pinyin":"guān guǎ qióng dú","abbr":"ggqd","explanation":"茕，无兄弟。泛指没有劳动力而又没有亲属供养的人。同“鳏寡孤独”。","source":{"text":"公勖之亲邻，厄以凶事，而鳏寡茕独，众所赖焉。","book":"唐·李白《虞诚令李公去思颂碑》"},"example":{"text":"或～，无所告者，仰所在各议拯救。","book":"《旧五代史·唐书·庄宗纪四》"},"similar":["鳏寡孤独","鳏寡孤茕"],"usage":"作主语、宾语、定语；不专指一个"},{"id":48640,"word":"鳏鱼渴凤","pinyin":"guān yú kě fèng","abbr":"gykf","explanation":"比喻独身的男子急于求得配偶。","source":{"text":"清澄有馀幽素香，鳏鱼渴凤真珠房。","book":"唐·李商隐《李夫人歌》之三"},"example":{"text":"～无如我，奈霎时中热，蓦地偷过。","book":"明·许自昌《水浒记·计迓》"},"usage":"作宾语、定语；用于比喻句"},{"id":48641,"word":"鳞次栉比","pinyin":"lín cì zhì bǐ","abbr":"lczb","explanation":"栉：梳篦的总称。象鱼鳞和梳子齿那样有次序地排列着。多用来形容房屋或船只等排列得很密很整齐。","source":{"text":"京城十二衢，飞甍各鳞次。","book":"《诗经·周颂·良耜》：“穫之挃挃。积之粟粟。其崇如墉，其比如栉，以开百室。”南朝宋·鲍照《咏史》诗"},"example":{"text":"东关外羊毛衖左右，闽粤游民群聚于此，赌馆烟舍，～。","book":"清·王韬《瀛壖杂志》"},"similar":["密密麻麻","密密层层"],"opposite":["参差不齐","杂乱无章"],"usage":"作谓语、定语；形容建筑物多而集中"},{"id":48642,"word":"鳞次相比","pinyin":"lín cì xiāng bǐ","abbr":"lcxb","explanation":"多用来形容房屋或船只等排列得很密很整齐。同“鳞次栉比”。","source":{"text":"细视之，乃群小蛤，鳞次相比，绸缪巩固。","book":"宋·沈括《梦溪笔谈·神奇》"},"example":{"text":"今府城西平地泉源觱涌，雪涛数尺，声如隐雷，泉凡三穴，～，稍施人力矣。","book":"清·阮元《小沧浪笔谈》卷二"},"similar":["鳞萃比栉"],"usage":"作谓语、定语；用于比喻句"},{"id":48643,"word":"鳞萃比栉","pinyin":"lín cuì bǐ zhì","abbr":"lcbz","explanation":"犹言鳞次栉比。多用来形容房屋或船只等排列得很密很整齐。","source":{"text":"前门左右旧有东西荷包巷，顾绣荷包诸肆，鳞萃比栉，潮流士女日往游观，巷外车马日甚。","book":"夏仁虎《旧京琐记·城厢》"},"similar":["鳞次栉比"],"usage":"作谓语、定语；形容建筑物多而集中"},{"id":48644,"word":"鳞集仰流","pinyin":"lín jí yǎng liú","abbr":"ljyl","explanation":"如鱼群迎向上流。比喻人心归向。","source":{"text":"四面风德，二方之君鳞集仰流，愿得受号者以亿计。","book":"《史记·司马相如列传》"}},{"id":48645,"word":"鳞集毛萃","pinyin":"lín jí máo cuì","abbr":"ljmc","explanation":"指如鱼鸟成群而至。","source":{"text":"肩摩踵曳，鳞集毛萃。","book":"金·王若虚《送王士衡赴举序》"},"usage":"作谓语；用于成群的东西"},{"id":48646,"word":"鳞集麇至","pinyin":"lín jí qún zhì","abbr":"ljjz","explanation":"像鱼鳞一样稠密地聚集，像麞鹿一样成群地到来。","source":{"text":"怀书捧檄者鳞集麇至。","book":"唐·贾至《旌儒庙颂》"},"example":{"text":"自君退居凤岗，创立吁江书院，远近生徒之聚而讲贯者，几于～。","book":"清·李来奉《宋泰伯公文集原叙》"}},{"id":48647,"word":"鳞鸿杳绝","pinyin":"lín hóng yǎo jué","abbr":"lhyj","explanation":"杳：遥远。形容音信断绝。","source":{"text":"老父阿兄，远游渔海，鳞鸿杳绝。","book":"明·天然智叟《石头点·侯官县烈女歼仇》"}},{"id":48648,"word":"鶗鴂雕卉","pinyin":"tí jué diāo huì","abbr":"tjdh","explanation":"比喻谗言伤害正直的人。鶗鴂，鸟名，杜鹃。","source":{"text":"鶗鴂，鸟名，喻谗人也。","book":"《后汉书·张衡传》：“恃己知而华予兮，鶗鴂鸣而不芳。”李贤注"}},{"id":48649,"word":"鸟为食亡","pinyin":"niǎo wéi shí wáng","abbr":"nwsw","explanation":"鸟儿为了吃食而死。比喻人为了名利而丧失生命。","source":{"text":"‘人为财死，鸟为食亡。’当时袁伯珍听得这些话，便要从此发一宗洋财。","book":"清·无名氏《官场维新记》第13回"},"example":{"text":"人为财死，～，也显示底层百姓的无奈。"},"similar":["人为财死"],"usage":"作宾语、定语；指本能"},{"id":48650,"word":"鸟伏兽穷","pinyin":"niǎo fú shòu qióng","abbr":"nfsq","explanation":"如飞鸟栖伏，野兽奔走无路。形容势竭力穷，处境困难。","source":{"text":"贼景鸟伏兽穷，频击频挫，奸竭诈尽，深沟自固。","book":"《梁书·元帝纪》"},"usage":"作宾语、定语；用于人的处境"},{"id":48651,"word":"鸟入樊笼","pinyin":"niǎo rù fán lóng","abbr":"nrfl","explanation":"樊笼：鸟笼，比喻不自由的境地。飞鸟进了笼子。比喻自投罗网，陷入困境。","source":{"text":"恰便似鱼钻入丝网，鸟扑入樊笼。","book":"元·尚仲贤《单鞭夺槊》第三折"},"example":{"text":"入宋三载，度日如年，～，甚少乐趣，今日求为一布衣亦不可得，每念及兹，便痛彻肝肠。","book":"任崇岳《李后主》七"},"similar":["自投罗网"],"usage":"作宾语、定语；用于比喻句"},{"id":48652,"word":"鸟兽散","pinyin":"niǎo shòu sàn","abbr":"nss","explanation":"形容成群的人象鸟兽逃散一样纷乱地散去（多形容敌人溃逃）。","source":{"text":"今无兵复战，天明坐受缚矣；各鸟兽散，犹有得脱报天子者。","book":"东汉·班固《汉书·李陵传》"},"example":{"text":"他们如～般四处逃散。"},"usage":"作谓语、宾语；多形容敌人溃逃"},{"id":48653,"word":"鸟兽率舞","pinyin":"niǎo shòu shuài wǔ","abbr":"nslw","explanation":"率：一起。飞鸟走兽一齐婆娑起舞。形容政治清明，鸟兽也受到感化。","source":{"text":"曾不得与鸟兽率舞、蛮夷纵观为比，衔酸抱痛，且耻且惭！","book":"唐·韩愈《贺册尊号表》"},"example":{"text":"山峙川流，草木蕃庶、～之成形于天下，变化而不穷者，地之文也。","book":"清·方宗诚《序》"},"usage":"作宾语、定语；用于比喻句"},{"id":48654,"word":"鸟兽行","pinyin":"niǎo shòu xíng","abbr":"nsx","explanation":"像禽兽一样的行为。指乱伦。","source":{"text":"外内乱，鸟兽行，则灭亡。","book":"《周礼·夏官·大司马》"},"example":{"text":"连骞势出鱼龙变，蹀躞骄生～。","book":"唐·张说《舞马千秋万岁乐府词》"},"usage":"作宾语、定语；用于比喻句"},{"id":48655,"word":"鸟哭猿啼","pinyin":"niǎo kū yuán tí","abbr":"nkyt","explanation":"泛指禽兽悲鸣。形容悲凉的情景。","source":{"text":"山崩川竭，鸟哭猿啼。","book":"唐·王维《能禅师碑》"},"usage":"作宾语、定语；指动物哀鸣"},{"id":48656,"word":"鸟啼花怨","pinyin":"niǎo tí huā yuàn","abbr":"nthy","explanation":"形容悲伤怨恨。","source":{"text":"今日呵，只落得鸟啼花怨。","book":"明·徐复祚《红梨记·请成》"},"usage":"作定语、状语；用于凄凉的场面"},{"id":48657,"word":"鸟啼花落","pinyin":"niǎo tí huā luò","abbr":"nthl","explanation":"形容凄凉的情景。","source":{"text":"惜鸾帷，孤玉绦，几度凄凉。断肠的鸟啼花落，满目心伤。","book":"明·汪廷讷《种玉记·促晤》"},"example":{"text":"良缘自有三生约，好把心猿意马收。且听岭南莺弄舌，～不知愁。","book":"清·佚名《说呼全传》第七回"},"usage":"作宾语、定语；用于凄凉场面"},{"id":48658,"word":"鸟声兽心","pinyin":"niǎo shēng shòu xīn","abbr":"nssx","explanation":"比喻言辞动听而心怀阴毒。","source":{"text":"四方私言，云角等窃入京师，战视朝政，鸟声兽心，私共鸣呼。","book":"南朝·宋·范晔《后汉书·刘陶传》"},"usage":"作宾语、定语；指为人"},{"id":48659,"word":"鸟尽弓藏","pinyin":"niǎo jìn gōng cáng","abbr":"njgc","explanation":"鸟没有了，弓也就藏起来不用了。比喻事情成功之后，把曾经出过力的人一脚踢开。","source":{"text":"蜚（飞）鸟尽，良弓藏；狡兔死，走狗烹。","book":"《史记·越王勾践世家》"},"example":{"text":"小弟从征方腊回来，苦劝我东人隐逸。明知有“～”之祸。","book":"清·陈忱《水浒后传》第二十二回"},"similar":["兔死狗烹","过河拆桥"],"opposite":["知恩图报"],"usage":"作谓语、定语；常与“兔死狗烹”连用","story":["春秋末期，楚国范蠡和文种到越国去做官，辅佐被吴王夫差打败的勾践，他们发奋图强，使越国强大，灭了吴国。范蠡深知勾践的为人就到齐国隐姓埋名经商，他写信劝文种离开说：“飞鸟尽，良弓藏，狡兔死，走狗烹”。文种不信被杀"]},{"id":48660,"word":"鸟尽弓藏，兔死狗烹","pinyin":"niǎo jìn gōng cáng，tù sǐ gǒu pēng","abbr":"njgctsgp","explanation":"烹：煮烧。飞鸟打尽，弓被搁置不用；兔被捕杀后，猎狗则被烹食。比喻事情办成，功臣被害。","source":{"text":"倘有不识时务者问：‘如果那时并不鸟尽弓藏，兔死狗烹，而且汉人也配享太庙……则将如何？’我觉得颇费唇舌。","book":"鲁迅《立此存照》"},"similar":["鸟尽弓藏","兔死狗烹"],"usage":"作宾语、定语；用于处事"},{"id":48661,"word":"鸟得弓藏","pinyin":"niǎo dé gōng cáng","abbr":"ndgc","explanation":"比喻事情成功之后，把曾经出过力的人一脚踢开。同“鸟尽弓藏”。","source":{"text":"淮阴五刑，鸟得弓藏；保身全名，独有子房。","book":"三国·魏·曹丕《煌煌京洛行》"},"similar":["鸟尽弓藏","兔死狗烹","过河拆桥"],"opposite":["知恩图报"],"usage":"作谓语、定语；用于比喻句"},{"id":48662,"word":"鸟惊兽骇","pinyin":"niǎo jīng shòu hài","abbr":"njsh","explanation":"形容成群的人象受尽的鸟兽一样逃散。","source":{"text":"当秦罢候置守之后，民疲秦役，天下土崩；或岁改主，或月易公，鸟惊兽骇，莫知所从，于是豪强并争，虎裂狼分，疾搏者获多，迟后者见吞。","book":"《三国志·蜀志·谯周传》"},"example":{"text":"两支练勇的队伍崩溃了，好像～，拼命逃窜，有的人连手中的兵器也抛掉了。","book":"姚雪垠《李自成》第三卷第三章"}},{"id":48663,"word":"鸟惊鱼散","pinyin":"niǎo jīng yú sàn","abbr":"njys","explanation":"形容军队因受惊扰而乱纷纷地四下溃散。同“鸟散鱼溃”。","source":{"text":"番禺之功，俘级万数，左里之捷，鸟散鱼溃。","book":"《南史·宋武帝纪》"},"example":{"text":"彼吐谷浑等各有部落，见利则锐敏争进，不利则～，各走巢穴，安肯守死为国家用！","book":"《资治通鉴·唐纪·唐文宗开成三年》"},"similar":["鸟惊鱼溃","鸟散鱼溃"],"usage":"作宾语、定语、状语；用于失败"},{"id":48664,"word":"鸟惊鱼溃","pinyin":"niǎo jīng yú kuì","abbr":"njyk","explanation":"溃：溃散。象鸟惊飞，象鱼溃散而逃。形容军队因受惊扰而乱纷纷地四下溃散。","source":{"text":"民为凋尽，徭戍无期，率土之心，鸟惊鱼溃。","book":"《隋书·杨玄感传论》"},"example":{"text":"日本鬼子被八路军打得～了"},"similar":["鸟惊鱼散","鸟惊鼠窜","鸟散鱼溃"],"usage":"作谓语、定语、状语；用于失败"},{"id":48665,"word":"鸟惊鱼骇","pinyin":"niǎo jīng yú hài","abbr":"njyh","explanation":"像鸟、鱼那种受惊的样子。","source":{"text":"蜀地岩邻番，其民犷悍易动，大抵綏之则靖，扰之则乱，怠则顿网诡衍，急则鸟惊鱼骇。","book":"明·张居正《答蜀中开府谭二华书》"},"usage":"作定语、状语；用于惊慌"},{"id":48666,"word":"鸟惊鼠窜","pinyin":"niǎo jīng shǔ cuàn","abbr":"njsc","explanation":"形容惊恐逃窜。同“鸟骇鼠窜”。","source":{"text":"贼衣食易尽，生理一绝，鸟惊鼠窜。","book":"《明史·艾万年传》"},"similar":["鸟骇鼠窜","鸟惊鱼溃"],"usage":"作谓语、定语、状语；用于失败"},{"id":48667,"word":"鸟散鱼溃","pinyin":"niǎo sàn yú kuì","abbr":"nsyk","explanation":"溃：溃散。象鸟惊飞，象鱼溃散而逃。形容军队因受惊扰而乱纷纷地四下溃散。","source":{"text":"番禺之功，俘级万数，左里之捷，鸟散鱼溃。","book":"《南史·宋武帝纪》"},"example":{"text":"遣庸懦之贞阳，任骄贪之胡赵，才见旗鼓，～，慕容绍宗，席卷涡阳，诸镇靡不弃甲，疾雷不及掩耳。","book":"蔡东藩《南北史演义》六十回"},"usage":"作定语、状语；用于战败时"},{"id":48668,"word":"鸟枪换炮","pinyin":"niǎo qiāng huàn pào","abbr":"nqhp","explanation":"形容情况或条件有很大的好转。","source":{"text":"那个气好比烟袋换吹筒，吹筒换鸟枪，鸟枪换炮，越吹越壮了。","book":"清·文康《儿女英雄传》第36回"},"example":{"text":"几天不见，你就～了。"},"usage":"作谓语、宾语、定语；指情况或条件有大变化"},{"id":48669,"word":"鸟枪换砲","pinyin":"niǎo qiāng huàn pào","abbr":"nqhp","explanation":"比喻情况或条件有很大好转。砲，同“炮”。"},{"id":48670,"word":"鸟焚其巢","pinyin":"niǎo fén qí cháo","abbr":"nfqc","explanation":"比喻人处的地位高有倾倒的危险。","source":{"text":"上九，鸟焚其巢，旅人先笑后号啕，丧牛于易。凶。","book":"《周易·旅》"}},{"id":48671,"word":"鸟焚鱼烂","pinyin":"niǎo fén yú làn","abbr":"nfyl","explanation":"指因内乱而覆亡。","source":{"text":"其言梁亡何？自亡也。其自亡奈何？鱼烂而亡也。","book":"《易·旅》：“鸟焚其巢，旅人先笑后号咷。”《公羊传·僖公十九年》"},"example":{"text":"初则狐假鸱张，自谓骁雄莫敌；旋则～，无非破败而终。","book":"《旧唐书·僖宗记》"},"usage":"作宾语、定语；用于比喻句"},{"id":48672,"word":"鸟穷则啄","pinyin":"niǎo qióng zé zhuó","abbr":"nqzz","explanation":"鸟陷于绝境就要反啄。比喻人走投无路就会冒险。","source":{"text":"鸟穷则啄，兽穷则攫。","book":"《荀子·哀公》"},"example":{"text":"责以重礼，古者以禽鱼畜之，必绝其类，恐兽穷则攫，～，甚非计也。","book":"蔡东藩《唐史演义》第二十二回"},"similar":["狗急跳墙"],"usage":"作谓语、定语；指狗急跳墙"},{"id":48673,"word":"鸟覆危巢","pinyin":"niǎo fù wēi cháo","abbr":"nfwc","explanation":"鸟巢因建于弱枝而倾覆。比喻处境极端危险。","source":{"text":"鱼游沸鼎知无日，鸟覆危巢岂待风。","book":"唐·李商隐《行次昭应县道上，送户部李郎中充昭义攻讨》诗"},"example":{"text":"谅～岂待风。釜底鱼，迹漫逃，负嵎虎，势莫容。","book":"《清史稿·乐志五》"},"similar":["鱼游釜中"],"usage":"作宾语、定语；用于人的处境"},{"id":48674,"word":"鸟语花香","pinyin":"niǎo yǔ huā xiāng","abbr":"nyhx","explanation":"鸟叫得好听，花开得喷香。形容春天的美好景象。","source":{"text":"鸟语花香变夕阴，稍闲复恐病相寻。","book":"宋·吕本中《紫薇·庵居》"},"example":{"text":"一路行来，山青水绿，～，真是个好风景也。","book":"清·李渔《比目鱼·肥遁》"},"similar":["山清水秀"],"opposite":["穷乡僻壤"],"usage":"作定语、宾语；形容春天的美好景象"},{"id":48675,"word":"鸟迹虫丝","pinyin":"niǎo jì chóng sī","abbr":"njcs","explanation":"比喻极易消失的事物。","source":{"text":"养娘真信人也，多劳，可怜他把鸟迹虫丝收护的牢。你可也月夕花晨一再瞧。","book":"清·蒋士铨《临川梦·了梦》"},"usage":"作宾语、定语；指短暂的事物"},{"id":48676,"word":"鸟道羊肠","pinyin":"niǎo dào yáng cháng","abbr":"ndyc","explanation":"狭险典折的山路。","source":{"text":"世人休说路行难，鸟道羊肠咫尺间。","book":"《五灯会元·睡龙溥禅师法嗣·保福清豁禅师》"},"example":{"text":"～，春彩驮来驿路长。连山铃铎频摇响，看日近帝都旁。","book":"清·洪昇《长生殿·献饭》"},"similar":["羊肠鸟道"],"opposite":["康庄大道"],"usage":"作主语、宾语、定语；用于山路等"},{"id":48677,"word":"鸟钞求饱","pinyin":"niǎo chāo qiú bǎo","abbr":"ncqb","explanation":"钞：强取，掠夺。如同飞鸟掠夺食物一样求饱腹。","source":{"text":"群小竞起，进秉国之位，鹰扬天下，鸟钞求饱，吞肌及骨。","book":"南朝·宋·范晔《后汉书·刘陶传》"},"usage":"作宾语、定语；用于谋生"},{"id":48678,"word":"鸟集鳞萃","pinyin":"niǎo jí lín cuì","abbr":"njlc","explanation":"鳞：鱼；萃：聚集。象鸟类或鱼类那样聚集在一起。形容聚集得很多。","source":{"text":"瓌货方至，鸟集鳞萃。","book":"汉·张衡《西京赋》"},"usage":"作宾语、定语；形容聚集得很多"},{"id":48679,"word":"鸟面鹄形","pinyin":"niǎo miàn hú xíng","abbr":"nmgx","explanation":"形容由于饥饿而身体软弱，面容枯瘦。","source":{"text":"死者蔽野。富室无食，皆鸟面鹄形。","book":"宋·司马光《资治通鉴·梁简文帝大宝元年》"},"example":{"text":"可怜个个衣不蔽体，饿得～。","book":"清·褚人获《隋唐演义》第44回"},"usage":"作定语、状语；指人的面相"},{"id":48680,"word":"鸟革翚飞","pinyin":"niǎo gé huī fēi","abbr":"nghf","explanation":"革：鸟张翅；翚：羽毛五彩的野鸡。如同鸟儿张开双翼，野鸡展翅飞翔一般。旧时形容宫室华丽。","source":{"text":"如鸟斯革，如翚斯飞。","book":"《诗经·小雅·斯干》"},"example":{"text":"～，谓创造之尽善。","book":"清·程允升《幼学琼林·宫室》"},"usage":"作宾语、定语；指宫室华丽"},{"id":48681,"word":"鸟骇鼠窜","pinyin":"niǎo hài shǔ cuàn","abbr":"nhsc","explanation":"形容惊恐逃窜。","source":{"text":"彼知已负有司之禁，则必鸟骇鼠窜，窃弄锄梃于草茅之中，以扞游徼之吏。","book":"宋·曾巩《救灾议》"},"similar":["鸟惊鼠窜","抱头鼠窜"],"usage":"作谓语、定语、状语；用于失败"},{"id":48682,"word":"鸠僭鹊巢","pinyin":"jiū jiàn què cháo","abbr":"jjqc","explanation":"比喻强占他人的居处或措置不当等。","source":{"text":"若是小婿承受，外人必有逐子爱婿之谤。鸠僭鹊巢，小婿亦被人谈论。","book":"明·冯梦龙《醒世恒言》第十七卷"},"similar":["鸠居鹊巢"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":48683,"word":"鸠占鹊巢","pinyin":"jiū zhàn què cháo","abbr":"jzqc","explanation":"斑鸠不会做窠，常强占喜鹊的窠。比喻强占别人的住屋。","source":{"text":"维鹊有巢，维鸠居之。","book":"《诗经·召南·鹊巢》"},"example":{"text":"袁世凯失败，在于动了～之念。","book":"爱新觉罗·溥仪《我的前半生》第三章"},"similar":["坐享其成","渔人得利","鸠居鹊巢"],"usage":"作谓语、宾语、定语；指强占别人的住所"},{"id":48684,"word":"鸠夺鹊巢","pinyin":"jiū duó què cháo","abbr":"jdqc","explanation":"斑鸠抢占喜鹊窝。比喻强占他人的居处或措置不当等。","source":{"text":"维雀有巢，维鸠居上。","book":"《诗经·召南·鹊巢》"},"example":{"text":"今袁熙、袁尚兵败将亡，无处依栖，来此相投，是～之意也。","book":"明·罗贯中《三国演义》第三十三回"},"similar":["雀占鸠巢","鸠居鹊巢","鸠僭鹊巢"],"usage":"作定语、宾语；指强占别人的地方"},{"id":48685,"word":"鸠居鹊巢","pinyin":"jiū jú què cháo","abbr":"jjqc","explanation":"比喻强占他人的居处或措置不当等。","source":{"text":"鳲鸠不自为巢，居鹊之成巢。","book":"《诗·召南·鹊巢》：“维鹊有巢，维鸠居之。”毛传"},"example":{"text":"且其书上自庖牺，下穷嬴氏，不言汉事，而编入《汉书》，～，茑施松上，附生疣赘，不知剪截，何断而为限乎。","book":"唐·刘知幾《史通·表历》"},"similar":["鸠僭鹊巢","鸠占鹊巢"],"usage":"作谓语、宾语、定语；指强占别人的住所"},{"id":48686,"word":"鸠巢计拙","pinyin":"jiū cháo jì zhuō","abbr":"jcjz","explanation":"鸠：布谷鸟；拙：笨。形容人不善经营，拙于生计。","source":{"text":"鸠：布谷鸟；拙：笨。形容人不善经营，拙于生计。"},"usage":"作谓语、宾语；用于自谦"},{"id":48687,"word":"鸠工庀材","pinyin":"jiū gōng pǐ cái","abbr":"jgpc","explanation":"庀：准备、具备。招集工匠，准备材料。","source":{"text":"岂可不成耶？遂鸠工庀材，四旬而就。","book":"唐·李方郁《修中岳庙记》"},"example":{"text":"该报购进东邻薛宝润地皮一块，即～，翻造五层楼大厦。","book":"陶菊隐《记者生活三十年》"},"similar":["兴师动众","大兴土木"],"usage":"作谓语、宾语；指准备工程等"},{"id":48688,"word":"鸠形鹄面","pinyin":"jiū xíng hú miàn","abbr":"jxgm","explanation":"鸠形：斑鸠的形状，腹部低陷，胸骨突出；鹄面：黄鹄的面色。形容身体消瘦，面容憔悴。","source":{"text":"死者蔽野，富室无食，皆鸟面鹄形。","book":"《资治通鉴·梁纪·简文帝大宝元年》"},"example":{"text":"日对～之众，愧无活人手段。","book":"清·陆陇其《答沈友圣》"},"similar":["形容枯槁","面黄肌瘦"],"opposite":["脑满肠肥","大腹便便"],"usage":"作谓语、定语；指人的长相"},{"id":48689,"word":"鸠车竹马","pinyin":"jiū chē zhú mǎ","abbr":"jczm","explanation":"鸠车、竹马：儿童玩具。借指童年。","source":{"text":"鸠车竹马曾经处，鲐背庞眉识此生。","book":"清·曹寅《集余园看梅同人限字赋诗追忆昔游有感而作》"},"similar":["青梅竹马"],"usage":"作主语、宾语、定语；借指童年"},{"id":48690,"word":"鸠集凤池","pinyin":"jiū jí fèng chí","abbr":"jjfc","explanation":"鸠：斑鸠，比喻凡才；集：聚集；凤池：凤凰池的简称，为皇帝禁苑中的池沼，是中书省所在的地方。比喻庸才居要位。","source":{"text":"《朝野佥载》曰：‘王及善才行庸猥，风神钝浊，为内史时，人号为“鸠集凤池”。’","book":"《资治通鉴·唐纪则天后圣历二年》：“内史王及善虽无学术，然清正难夺，有大臣之节。”胡三省注"},"usage":"作宾语；指庸才身居要位"},{"id":48691,"word":"鸡不及凤","pinyin":"jī bù jí fèng","abbr":"jbjf","explanation":"鸡赶不上凤凰。比喻儿子不如父亲。","source":{"text":"谢超宗尝谓慈曰：‘卿书何当及虔公？’慈曰：‘我之不得仰及，犹鸡之不及凤也。’","book":"《南齐书·王慈传》"},"example":{"text":"谁说～，要从不同角度看待这个问题。"},"usage":"作宾语、定语；用于父子之间"},{"id":48692,"word":"鸡争鹅斗","pinyin":"jī zhēng é dòu","abbr":"jzed","explanation":"比喻吵吵闹闹，彼此不和。","source":{"text":"从今咱们两个丢开手，省得鸡争鹅斗，叫别人笑。","book":"清·曹雪芹《红楼梦》第21回"},"example":{"text":"我们何必这样～的。"},"similar":["鸡声鹅斗"],"usage":"作谓语、宾语、定语；比喻争吵"},{"id":48693,"word":"鸡伏鹄卵","pinyin":"jī fú fú luǎn","abbr":"jfgl","explanation":"伏：鸟孵卵；鹄：天鹅。鸡孵天鹅的蛋。比喻小才难当重任。","source":{"text":"奔蜂不能化藿蠋，越鸡不能伏鹄卵。","book":"《庄子·庚桑楚》"},"usage":"作宾语、定语；用于比喻句"},{"id":48694,"word":"鸡口牛后","pinyin":"jī kǒu niú hòu","abbr":"jknh","explanation":"宁愿做小而洁的鸡嘴，而不愿做大而臭的牛肛门。比喻宁在局面小的地方自主，不愿在局面大的地方听人支配。","source":{"text":"臣闻鄙语曰：‘宁为鸡口，无为牛后，今大王西面交臂而臣事秦，何以异于牛后乎？’","book":"西汉·刘向《战国策·韩策》"},"example":{"text":"他已经明白～的道理。"},"similar":["宁为鸡口，无为牛后"],"usage":"作宾语、定语；指应作主动","story":["战国时期，苏秦来到韩国游说韩宣惠王抗秦，他说：“韩国地理位置优越，拥有最先进的弩机，士兵十分勇敢，可以一当面。如此强盛的国家却要向秦国称臣屈服让人耻笑，俗话说：‘宁可当鸡的嘴巴不要当牛的肛门。”宣惠王同意抗秦"]},{"id":48695,"word":"鸡声断爱","pinyin":"jī shēng duàn ài","abbr":"jsda","explanation":"雄鸡报晓，情人就要上路，欢爱从而中断。","source":{"text":"欢寝方浓，恨鸡声之断爱。恩怜未洽，叹马足无情。","book":"五代·王仁裕《开元天宝遗事·鸡声断爱》"},"example":{"text":"世徒以勾栏中人，鸡声断爱，马足无情，多致讥讽。","book":"清·王韬《淞滨琐话·刘淑芳》"}},{"id":48696,"word":"鸡声鹅斗","pinyin":"jī shēng é dòu","abbr":"jsed","explanation":"比喻吵吵闹闹，彼此不和。","source":{"text":"从今咱们两个撂开手，省得鸡声鹅斗，叫别人笑话。","book":"清·曹雪芹《红楼梦》第二十一回"},"similar":["鸡争鹅斗"],"usage":"作谓语、宾语、定语；比喻争吵"},{"id":48697,"word":"鸡头鱼刺","pinyin":"jī tóu yú cì","abbr":"jtyc","explanation":"比喻轻微而不被重视的的事物。","source":{"text":"龙舟渡口的李托塔、熊大力和金磙子，率领保土安民义和团奔赴萍水县城，只留下胭脂虎和她那一伙鸡头鱼刺，鬼吹灯夏三给她当狗头军师。","book":"刘绍棠《狼烟》二十三"}},{"id":48698,"word":"鸡尸牛从","pinyin":"jī shī niú cóng","abbr":"jsnc","explanation":"比喻宁在局面小的地方自主，不愿在局面大的地方听人支配。","source":{"text":"臣闻鄙语曰：‘宁为鸡口，无为牛后。’","book":"《战国策·韩策》"}},{"id":48699,"word":"鸡栖凤巢","pinyin":"jī qī fèng cháo","abbr":"jqfc","explanation":"栖：居住。鸡住在凤凰的窝里。比喻才德卑下的人占据高位。","source":{"text":"鸡栖凤巢，非其同类出去。","book":"宋·释道原《景德传灯录》第16卷"},"example":{"text":"我们用人不能出现～的局面。"},"similar":["雀占鸠巢"],"usage":"作宾语、定语；指小人得势"},{"id":48700,"word":"鸡栖凤食","pinyin":"jī qī fèng shí","abbr":"jqfs","explanation":"栖：栖身，居住。凤凰在鸡住的地方吃食。比喻尊居高位的人陷入困境，与位卑者同处共食。","source":{"text":"牛骥同一皂，鸡栖凤凰食。","book":"宋·文天祥《正气歌》"}},{"id":48701,"word":"鸡毛蒜皮","pinyin":"jī máo suàn pí","abbr":"jmsp","explanation":"比喻无关紧要的琐碎事情。","source":{"text":"目前大敌当前，同心协力还怕迟误，谁还记着那些鸡毛蒜皮的小事儿。","book":"姚雪垠《李自成》第一卷第18章"},"example":{"text":"他们是为了报答你的恩情，才送给你；你倒说是～。","book":"孙犁《白洋淀纪事·石猴》"},"similar":["鸡零狗碎"],"opposite":["荦荦大端","硕大无朋"],"usage":"作主语、宾语、定语；指毫无价值的东西"},{"id":48702,"word":"鸡烂嘴巴硬","pinyin":"jī làn zuǐ bā yìng","abbr":"jlzby","explanation":"比喻自知理亏，还要强辩。","example":{"text":"你真是～，不要再强词夺理了。"},"usage":"作宾语、定语；用于口语"},{"id":48703,"word":"鸡犬不宁","pinyin":"jī quǎn bù níng","abbr":"jqbn","explanation":"宁：安宁。形容骚扰得厉害，连鸡狗都不得安宁。","source":{"text":"哗然而骇者，虽鸡狗不得宁焉。","book":"唐·柳宗元《捕蛇者说》"},"example":{"text":"你弟兄窝藏强盗，闹了两座军州，自去落草。官府着落地方搜缉，搅得～！","book":"清·陈忱《水浒后传》第十六回"},"similar":["鸡飞狗走","鸡狗不宁"],"opposite":["鸡犬不惊"],"usage":"作谓语、定语、状语；指军队挠民","story":["公元805年，唐朝著名的文学家柳宗元被贬到永州做司马，他目睹了民间哀鸿遍野、民不聊生的悲惨局面，写了一篇《捕蛇者说》。该散文描述一个捕蛇者宁愿冒着生命危险捕蛇，也不愿种地，因为贪官污吏们搞得当地鸡犬不宁"]},{"id":48704,"word":"鸡犬不安","pinyin":"jī quǎn bù ān","abbr":"jqba","explanation":"形容骚扰得厉害，连鸡狗都不得安宁。同“鸡犬不宁”。","source":{"text":"我凭什么信他？当二毛子，等义和拳来砍头？再把野蛮的鬼子兵招来，弄得九城鸡犬不安！","book":"萧乾《皈依》"},"example":{"text":"其虐待工人及附近居民（～，惨无人理），我父兄弟所亲见尝者，胡不自救耶！","book":"宋嘉珍《敬告全滇父老缴款赎路意见书》"},"similar":["鸡犬不宁"],"usage":"作谓语、定语、状语；指军队挠民"},{"id":48705,"word":"鸡犬不惊","pinyin":"jī quǎn bù jīng","abbr":"jqbj","explanation":"形容行军纪律严明，连鸡狗都没有受到惊动。也指平安无事。","source":{"text":"翁见一笑大欢足，鸡犬不惊仁意多。","book":"宋·彭龟年《止堂集·一八·寿张京尹十首》"},"example":{"text":"文王与子牙放炮起兵。一路上父老相迎，～。","book":"明·许仲琳《封神演义》第二十八回"},"similar":["不惊鸡犬","秋毫无犯"],"opposite":["鸡飞狗走","鸡犬不宁"],"usage":"作谓语、宾语、分句；形容军纪严明"},{"id":48706,"word":"鸡犬不留","pinyin":"jī quǎn bù liú","abbr":"jqbl","explanation":"形容屠杀残酷，连鸡狗都不能幸免。","source":{"text":"引军从泗南攻取虑、睢陵、夏丘诸县，皆屠之，鸡犬亦尽，墟邑无复行人。","book":"《三国志·荀彧传》"},"example":{"text":"这是一笔永远算不清的债！以言杀戮，确是～。","book":"老舍《吐了一口气》"},"similar":["斩尽杀绝","寸草不留","一干二净"],"opposite":["秋毫无犯","鸡犬不惊"],"usage":"作谓语、宾语、补语；指斩尽杀绝","story":["春秋时期，孔子在鲁国遭到排挤后，带领弟子们周游列国，先后在卫、宋、郑等地碰壁与受到磨难后，弟子劝阻他不要赴晋，他一意孤行，在中牟城见到阳虎屠城，城内鸡犬不留的惨象，终于让孔子放弃去晋国的念头，一心去陈国推销“仁政”"]},{"id":48707,"word":"鸡犬不闻","pinyin":"jī quǎn bù wén","abbr":"jqbw","explanation":"形容极为荒凉冷僻。","source":{"text":"百姓久被贼人伤残，又闻得大兵厮杀，凡冲要通衢大路，都没一个人烟，静悄悄地，鸡犬不闻，就要一滴水，也没喝处，那讨酒食来？","book":"明·施耐庵《水浒传》第一百九回"},"similar":["荒无人烟"],"opposite":["鸡犬相闻"],"usage":"作宾语、定语；指荒凉冷僻"},{"id":48708,"word":"鸡犬之声相闻，老死不相往来","pinyin":"jī quǎn zhī shēng xiāng wén，lǎo sǐ bù xiāng wǎng lái","abbr":"jqzsxwlsbxwl","explanation":"鸡鸣狗吠的声音都能听到，可是一辈子也不互相来往。现在形容彼此不了解，不互通音讯。","source":{"text":"邻国相望，鸡犬之声相闻，民至老死不相往来。","book":"春秋·楚·李耳《老子》第80回"},"example":{"text":"有些人不是这样做，而是像老子说的‘～’。","book":"毛泽东《党委会的工作方法》"},"similar":["鸡犬相闻"],"usage":"作宾语、定语、分句；指彼此不往来","story":["春秋时期，思想家老子认为相邻的两个国家彼此可以望见，两国鸡狗的叫声都可以听见，各自吃自己的国家丰富的食物，穿自己的衣服，按照自己的风俗生活，直到老死都不互相往来。司马迁认为这种老死不相往来的思想行不通"]},{"id":48709,"word":"鸡犬升天","pinyin":"jī quǎn shēng tiān","abbr":"jqst","explanation":"传说汉朝淮南王刘安修炼成仙后，把剩下的药撒在院子里，鸡和狗吃了，也都升天了。后比喻一个人做了官，和他有关的人也跟着得势。","source":{"text":"淮南王刘安坐反而死，天下并闻，当时并见，儒书尚有言其得道仙去，鸡犬升天者。","book":"东汉·王充《论衡·道虚》"},"example":{"text":"这事一办成，你就一步登天，你们一家人的日子也马上苦尽甜来。古话说的好：一人得道，～。","book":"姚雪垠《李自成》第二卷第二章"},"similar":["淮南鸡犬"],"usage":"作宾语、定语；常与“一人得势”连用","story":["汉高祖刘邦的孙子淮南王刘安十分信奉道教，为了长生不老，他找到八公仙翁，按照八公仙翁的话炼制仙丹。丹药炼成后，刘安吃下觉得自己轻飘飘的升天而去。庭院里的鸡狗抢着吃剩下的丹药也纷纷飞上天成了仙"]},{"id":48710,"word":"鸡犬新丰","pinyin":"jī quǎn xīn fēng","abbr":"jqxf","explanation":"刘邦在长安仿造家乡新丰，将新丰的鸡犬也一块取来，都各自认识自己的家。比喻虽在异乡，却感觉很亲切，就象在家乡一样。","source":{"text":"高祖乃作新丰，移诸故人实之，太上皇乃悦。","book":"晋·葛洪《西京杂记》卷二"},"example":{"text":"～乐故乡，万岁千魂渺茫。","book":"清·严遂成《歌风台》"}},{"id":48711,"word":"鸡犬无惊","pinyin":"jī quǎn wú jīng","abbr":"jqwj","explanation":"形容行军纪律严明，连鸡狗都没有受到惊动。也指平安无事。同“鸡犬不惊”。","source":{"text":"事定，文光被举为滇西都督，市井晏然，鸡犬无惊。","book":"李根源《记云南起义》"},"similar":["鸡犬不惊"],"usage":"作谓语、宾语、补语、分句；形容军纪严明"},{"id":48712,"word":"鸡犬桑麻","pinyin":"jī quǎn sāng má","abbr":"jqsm","explanation":"形容乡村的安静生活。","source":{"text":"田里种着菜，篱笆里栽着花，大有鸡犬桑麻光景。","book":"清·李宝嘉《文明小史》第五十三回"},"usage":"作宾语、定语；形容乡村的安静生活"},{"id":48713,"word":"鸡犬皆仙","pinyin":"jī quǎn jiē xiān","abbr":"jqjx","explanation":"传说汉朝淮南王刘安修炼成仙后，把剩下的药撒在院子里，鸡和狗吃了，也都升天了。后比喻一个人做了官，和他有关的人也跟着得势。","source":{"text":"淮南王刘安坐反而死，天下并闻，当时并见，儒书尚有言其得道仙去，鸡犬升天者。","book":"汉·王充《论衡·道虚》"},"similar":["鸡犬升天"],"usage":"作宾语、定语；用于官场等"},{"id":48714,"word":"鸡犬相闻","pinyin":"jī quǎn xiāng wén","abbr":"jqxw","explanation":"指人烟稠密。","source":{"text":"甘其食，美其服，安其居，乐其俗。邻国相望，鸡犬之声相闻，民至老死不相往来。","book":"先秦·李耳《老子》"},"example":{"text":"阡陌交通，～。","book":"晋·陶潜《桃花源记》"},"opposite":["鸡犬不闻"],"usage":"作谓语；指人烟稠密"},{"id":48715,"word":"鸡皮疙瘩","pinyin":"jī pí gē dā","abbr":"jpgd","explanation":"受到惊吓或寒冷在人的皮肤上出现的类似鸡皮上的小疙瘩。","source":{"text":"孙玉亭惊得目瞪口呆，兴奋使他浑身冒起一层鸡皮疙瘩。","book":"路遥《平凡的世界》第五卷第14章"},"example":{"text":"他被吓得浑身长满了～。"},"usage":"作宾语、定语；形容害怕"},{"id":48716,"word":"鸡皮鹤发","pinyin":"jī pí hè fà","abbr":"jphf","explanation":"皮肤发皱，头发苍白。指老人。","source":{"text":"子老矣，鹤发鸡皮，蓬头历齿。","book":"北周·庾信《竹杖赋》"},"example":{"text":"刻木牵丝作老翁，～与真同。","book":"唐玄宗《傀儡吟》"},"similar":["鸡肤鹤发"],"usage":"作宾语、定语；形容衰老"},{"id":48717,"word":"鸡肠狗肚","pinyin":"jī cháng gǒu dù","abbr":"jcgd","explanation":"比喻狭窄的度量，狠毒的心肠。","source":{"text":"据你这淫妇的鸡肠狗肚，容不得人，把儿媳都逼了出门。","book":"清·陶贞怀《天雨花》第二回"},"example":{"text":"你那～能容人吗？"},"similar":["小肚鸡肠"],"opposite":["宽宏大量"],"usage":"作主语、宾语、定语；指气量小"},{"id":48718,"word":"鸡肠鼠腹","pinyin":"jī cháng shǔ fù","abbr":"jcsf","explanation":"小鸡的肠子，老鼠的肚子。比喻人的气量狭小","source":{"text":"他还重点朋情，背间说几句抱不平的议论，与那些转眼忘恩鸡肠鼠腹的小辈大不相同。","book":"清·李百川《绿野仙踪》第50回"},"similar":["小肚鸡肠"],"opposite":["宽宏大量"],"usage":"作宾语、定语；多用于比喻句"},{"id":48719,"word":"鸡肤鹤发","pinyin":"jī fū hè fà","abbr":"jfhf","explanation":"皮肤发皱，头发苍白。指老人。同“鸡皮鹤发”。","source":{"text":"虫臂鼠肝犹不怪，鸡肤鹤发复何伤。","book":"唐·白居易《老病相仍以诗自解》"},"similar":["鸡皮鹤发"],"usage":"作宾语、定语；形容衰老"},{"id":48720,"word":"鸡肥不下蛋","pinyin":"jī féi bù xià dàn","abbr":"jfbxd","explanation":"比喻条件太好了反而做不出成绩。","example":{"text":"～，你不能对他太好了。"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":48721,"word":"鸡胸龟背","pinyin":"jī xiōng guī bèi","abbr":"jxgb","explanation":"凸胸驼背。","source":{"text":"《说文》：‘奚，大腹也。’今人谓匈（胸）腹间大者为奚匈，呼如鸡匈，遂有‘鸡胸龟背’之语。","book":"章炳麟《新方言·释形体》"},"example":{"text":"～的外貌实在难看。"},"usage":"作主语、宾语、定语；指人的外表"},{"id":48722,"word":"鸡虫得丧","pinyin":"jī chóng dé sàng","abbr":"jcds","explanation":"比喻微小的得失，无关紧要。同“鸡虫得失”。","source":{"text":"鸡虫得丧成恩怨，鸟鼠因缘见短长。","book":"清·蒋士铨《临川梦·了梦》"},"similar":["鸡虫得失"],"usage":"作主语、宾语、分句；用于书面语"},{"id":48723,"word":"鸡虫得失","pinyin":"jī chóng dé shī","abbr":"jcds","explanation":"象鸡啄虫，人缚鸡那样的得失。比喻微小的得失，无关紧要。","source":{"text":"鸡虫得失无了时，注目寒江倚山阁。","book":"唐·杜甫《缚鸡行》诗"},"example":{"text":"～，蜗角争持，闹得天翻地覆，日月无光。","book":"蔡东藩、许厪父《民国通俗演义》第一百二十五回"},"similar":["鸡虫得丧"],"opposite":["斤斤计较","锱铢必较"],"usage":"作主语、宾语、分句；用于书面语","story":["唐代大诗人杜甫在夔州时写下《缚鸡行》诗：“小奴缚鸡向市卖，鸡被缚急相喧争。家中厌鸡食虫蚁，不知鸡卖还遭烹。虫鸡于人何厚薄，吾叱奴人解其缚。鸡虫得失无了时，注目寒江倚山阁。”","他认为鸡虫得失与治理国家比起来微不足道"]},{"id":48724,"word":"鸡蛋里找骨头","pinyin":"jī dàn lǐ zhǎo gǔ tóu","abbr":"jdlzgt","explanation":"比喻故意挑剔。","source":{"text":"姑母常闹脾气。她单在鸡蛋里找骨头。她是我家中的阎王。直到我入了中学，她才死去，我可是没有看见母亲反抗过。","book":"老舍《老舍自传》第一章第三节"},"example":{"text":"你就是～也找不出他的毛病"},"similar":["鸡蛋里挑骨头"],"usage":"作宾语、定语；用于口语"},{"id":48725,"word":"鸡豚之息","pinyin":"jī tún zhī xī","abbr":"jtzx","explanation":"比喻微小的收益。","source":{"text":"夫伐冰之家，不利鸡豚之息；委积之臣，不操市井之利。","book":"《韩诗外传》卷四：“驷马之家不恃鸡豚之息，伐冰之家不图牛羊之入。”《后汉书·冯衍传下》"},"example":{"text":"南朝·宋·范晔《后汉书·冯衍传》：“夫伐冰之家，不利～；委积之臣，不操市井之利。”"},"usage":"作宾语；用于比喻句"},{"id":48726,"word":"鸡豚同社","pinyin":"jī tún tóng shè","abbr":"jtts","explanation":"比喻同乡人畅叙久别后的情怀。","source":{"text":"愿为同社人，鸡豚燕春秋。","book":"唐·韩愈《南溪始泛》"}},{"id":48727,"word":"鸡零狗碎","pinyin":"jī líng gǒu suì","abbr":"jlgs","explanation":"形容事物零碎细小，不成系统。","source":{"text":"则此一特点不能不有一佳名，故拟题曰：'鸡零狗碎'云尔。","book":"茅盾《雨天杂写》"},"example":{"text":"那～的事，恕不细说，但值得大书特书的奇迹，放过未免可惜。","book":"高晓声《李顺大造屋》"},"similar":["七零八碎","鸡毛蒜皮"],"opposite":["荦荦大端"],"usage":"作谓语、宾语、定语、状语；指零碎"},{"id":48728,"word":"鸡飞狗叫","pinyin":"jī fēi gǒu jiào","abbr":"jfgj","explanation":"把鸡吓得飞起来，把狗吓得直叫唤。形容乱成一团。","source":{"text":"忽然，邻庄鸡飞狗叫，老乡们拖着孩子向庄外奔跑。","book":"吴运铎《把一切献给党·反“扫荡”》"},"example":{"text":"这里让你搞得～，永不安宁。"},"similar":["鸡飞狗跳"],"opposite":["鸡犬不惊"],"usage":"作谓语、定语、状语；指乱成一团"},{"id":48729,"word":"鸡飞狗窜","pinyin":"jī fēi gǒu cuàn","abbr":"jfgc","explanation":"比喻受到惊动而引起骚乱。","source":{"text":"日寇投降后，这个大佐特务，被人们撵的鸡飞狗窜，他的党羽，纷纷落网。","book":"曲波《林海雪原》"},"example":{"text":"他把这地方弄得～的。"},"similar":["鸡飞狗跳","鸡飞狗走"],"usage":"作定语、状语；指惊乱"},{"id":48730,"word":"鸡飞狗走","pinyin":"jī fēi gǒu zǒu","abbr":"jfgz","explanation":"走：跑。鸡乱飞，狗乱跑。形容因极端惊恐而混乱不堪。","source":{"text":"你看前两天那种搜索的样子，只就我们歇宿的那一家客寓，已经是闹得鸡飞狗走，鬼哭神号。","book":"清·吴趼人《痛史》第13回"},"example":{"text":"因为孩子们的魂灵，要摄去垫鹿台脚了，真吓得大家～，赶忙做起符袋来，给孩子们带上。","book":"鲁迅《故事新编·起死》"},"similar":["鸡飞狗跳"],"opposite":["鸡犬不惊"],"usage":"作谓语、定语；形容因极端惊恐而混乱不堪"},{"id":48731,"word":"鸡飞狗跳","pinyin":"jī fēi gǒu tiào","abbr":"jfgt","explanation":"把鸡吓得飞起来，把狗吓得到处乱跳。形容惊慌得乱成一团。","source":{"text":"然而陈克明却在这里想象，一方面疑神疑鬼，又一方面畏惧怨恨所造成的鸡飞狗跳、人人自危的情形。","book":"茅盾《锻炼》"},"example":{"text":"我们人多，很快就把他们赶得～的。"},"similar":["鸡飞狗叫"],"opposite":["鸡犬不惊"],"usage":"作定语、状语；指惊乱","story":["春秋时期，鲁国政局动荡，权利由季氏、孟氏及叔孙氏三家轮流执掌，鲁君只是一个傀儡。后来季平子势力大增，敢于与鲁昭公对抗，在一次斗鸡会上，他让狗咬了昭公的鸡。鲁昭公忍无可忍，为这鸡飞狗跳之事出兵攻打季平子，结果大败，流亡齐国"]},{"id":48732,"word":"鸡飞蛋打","pinyin":"jī fēi dàn dǎ","abbr":"jfdd","explanation":"鸡飞走了，蛋打破了。比喻两头落空，一无所得。","source":{"text":"人之无良，舍其旧而新是谋，卒之卵覆鸟亦飞，天之所报亦惨矣。","book":"清·蒲松龄《聊斋志异·阿霞》"},"example":{"text":"只要他一进关抄了咱们的后路，那就～，不可收拾了。","book":"周骥良《吉鸿昌》"},"similar":["人财两空","两败俱伤"],"opposite":["一箭双雕","一举两得"],"usage":"作谓语、宾语；比喻两头落空，一无所得"},{"id":48733,"word":"鸡骨支床","pinyin":"jī gǔ zhī chuáng","abbr":"jgzc","explanation":"原意是因亲丧悲痛过度而消瘦疲惫在床席之上。后用来比喻在父母丧中能尽孝道。也形容十分消瘦。","source":{"text":"王戎和峤同时遭大丧，俱以孝称，王鸡骨支床，和哭泣备礼。","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"积数日，～，较前尤甚。","book":"清·蒲松龄《聊斋志异·寄生》"},"similar":["瘦骨嶙峋"],"usage":"作谓语；形容十分消瘦","story":["古代有名的孝子王戎与和峤两人同时丧父母，和峤按照风俗习惯，守孝三年，神气丝毫没有损伤。而王戎则不同，他在父母的灵前搭了一个小棚，整天陪伴父母的灵，十分伤心，而且吃的很少，整个身体变成骨瘦如柴，三年后经很长时间调养才恢复"]},{"id":48734,"word":"鸡鸣之助","pinyin":"jī míng zhī zhù","abbr":"jmzz","explanation":"比喻妻子对丈夫的帮助。","source":{"text":"内助曰得鸡鸣之助。","book":"《诗经·齐风·鸡鸣》载：妻子催促丈夫早起，如同鸡鸣所起的作用。宋·胡继宗《书言故事·禽兽比喻类》"}},{"id":48735,"word":"鸡鸣候旦","pinyin":"jī míng hòu dàn","abbr":"jmhd","explanation":"怕失晓而耽误正事，天没亮就起身。同“鸡鸣戒旦”。","source":{"text":"鸡鸣候旦宁辞晦，松节凌霜几换秋。","book":"宋·徐铉《和张先辈见寄》之二"},"similar":["鸡鸣戒旦"],"usage":"作谓语、定语；形容过度紧张"},{"id":48736,"word":"鸡鸣戒旦","pinyin":"jī míng jiè dàn","abbr":"jmjd","explanation":"怕失晓而耽误正事，天没亮就起身。","source":{"text":"《鸡鸣》，思贤妃也。哀公荒淫怠慢，故陈贤妃贞女夙夜警戒相成之道焉。","book":"《诗经·齐风·鸡鸣序》"},"example":{"text":"～，则飘尔晨征；日薄西山，则马首靡托。","book":"《晋书·文苑传·赵至》"},"similar":["鸡鸣候旦"],"usage":"作谓语、定语；形容过度紧张"},{"id":48737,"word":"鸡鸣犬吠","pinyin":"jī míng quǎn fèi","abbr":"jmqf","explanation":"比喻聚居在一处的人口稠密。同“鸡鸣狗吠”。","source":{"text":"齐郡败乱，遭离盗贼，不闻鸡鸣犬吠之音。","book":"《后汉书·吴良传》：“举觞上寿，谄称太守功德”李贤注引《东观汉记》"},"example":{"text":"二百五十余年，契丹始讲和好，德明亦受约束，而天下销锋灌燧，无～之惊，以迄于今。","book":"宋·曾巩《移沧州过阙上殿札子》"},"similar":["鸡鸣狗吠"],"usage":"作定语、宾语；形容百姓安居乐业"},{"id":48738,"word":"鸡鸣狗吠","pinyin":"jī míng gǒu fèi","abbr":"jmgf","explanation":"鸡啼狗叫彼此都听得到。比喻聚居在一处的人口稠密。","source":{"text":"鸡鸣狗吠相闻，而达乎四境，而齐有其民矣。","book":"战国·邹·孟轲《孟子·公孙丑上》"},"example":{"text":"窃念国家炽昌熙洽，无～之警。","book":"清·梅曾亮《上方尚书书》"},"similar":["鸡鸣犬吠"],"usage":"作定语、宾语；形容百姓安居乐业"},{"id":48739,"word":"鸡鸣狗盗","pinyin":"jī míng gǒu dào","abbr":"jmgd","explanation":"鸣：叫；盗：偷东西。指微不足道的本领。也指偷偷摸摸的行为。","source":{"text":"《史记·孟尝君列传》载：齐孟尝君出使秦被昭王扣留，孟一食客装狗钻入秦营偷出狐白裘献给昭王妾以说情放孟。孟逃至函谷关时昭王又令追捕。另一食客装鸡叫引众鸡齐鸣骗开城门，孟得以逃回齐。"},"example":{"text":"报仇的这桩事，是桩光明磊落，见得天地鬼神的事，何须这等～，遮遮掩掩。","book":"清·文康《儿女英雄传》第二十七回"},"similar":["旁门左道"],"opposite":["正人君子"],"usage":"作主语、宾语、定语；指小本事","story":["战国时期齐国相国孟尝君出访秦国，秦国的相国出于嫉妒劝秦昭王杀死他，秦昭王把他关了起来。孟尝君的门客晚上装成一条狗混进秦宫偷白狐袍子送给燕姬，燕姬求情放走了孟尝君。孟尝君一行深夜逃到函谷关，门客学鸡叫骗开城门逃跑"]},{"id":48740,"word":"鸡鸣而起","pinyin":"jī míng ér qǐ","abbr":"jmeq","explanation":"鸡叫时就起床。形容勤奋不怠。","source":{"text":"鸡鸣而起，孳孳为善者，舜之徒也。","book":"《孟子·尽心上》"},"example":{"text":"～，孜孜焉，亦不为利。","book":"唐·韩愈《上宰相书》"},"similar":["闻鸡起舞"],"usage":"作谓语、分句；形容勤奋不怠"},{"id":48741,"word":"鸡鸣起舞","pinyin":"jī míng qǐ wǔ","abbr":"jmqw","explanation":"指胸怀大志、及时奋发的豪壮气概。","source":{"text":"都莫问功名事，白发渐星星如许。任鸡鸣起舞，乡关何在。凭高目尽孤鸿去。","book":"宋·韩元吉《薄幸》词"},"similar":["闻鸡起舞"],"usage":"作谓语、定语；指人勤奋"},{"id":48742,"word":"鸡鸣馌耕","pinyin":"jī míng gǒu gēng","abbr":"jmyg","explanation":"比喻妇女勤俭治家。","source":{"text":"馌彼南亩，田畯至喜。","book":"语出《诗·郑风·女曰鸡鸣》：“女曰鸡鸣，士曰昧旦。”又《豳风·七月》"},"example":{"text":"承德公老于场屋，不事生产，朝齑暮盐，黾勉有无，白首相庄，有～之德，此夫人之为妻也。","book":"清·钱谦益《诰封安人熊母皮夫人墓志铭》"},"usage":"作宾语、定语；用于女性持家等"},{"id":48743,"word":"鸡鹜争食","pinyin":"jī wù zhēng shí","abbr":"jwzs","explanation":"鸡鹜：比喻平庸的人。旧指小人互争名利。","source":{"text":"宁与黄鹄比翼乎？将与鸡鹜争食乎？","book":"战国·楚·屈原《卜居》"},"similar":["鸡鹜相争"],"usage":"作宾语、定语；用于处事"},{"id":48744,"word":"鸡鹜相争","pinyin":"jī wù xiāng zhēng","abbr":"jwxz","explanation":"鸡鹜：比喻平庸的人。旧指小人互争名利。","source":{"text":"宁与黄鹄比翼乎？将与鸡鹜争食乎？","book":"战国·楚·屈原《卜居》"},"example":{"text":"～，终无了期，虽有文治派之徐世昌，亦奚补乎？","book":"蔡东藩、许廑父《民国通俗演义》第一百零二回"},"similar":["鸡鹜争食"],"usage":"作宾语、定语；用于处事"},{"id":48745,"word":"鸡鹜翔舞","pinyin":"jī wù xiáng wǔ","abbr":"jwxw","explanation":"鹜：鸭子。鸡鸭狂飞乱舞。比喻平庸无为的人得势后，乐不可支。"},{"id":48746,"word":"鸡黍之膳","pinyin":"jī shǔ zhī shàn","abbr":"jszs","explanation":"鸡黍：招待客人的饭菜。杀鸡作黍饭。引申为盛情款待宾客。","source":{"text":"止子路宿，杀鸡为黍而食之。","book":"《论语·微子》"},"example":{"text":"《北史·卢思道传》：“道虔为尚书，同僚于草屋下设～。”"},"usage":"作宾语；用于生活等"},{"id":48747,"word":"鸡黍深盟","pinyin":"jī shǔ shēn méng","abbr":"jssm","explanation":"鸡黍：招待客人的饭菜；深盟：深厚的交情。指朋友之间交情深厚。","source":{"text":"因此乞天恩先到泉台上，才留的这鸡黍深盟与那后人讲。","book":"《论语·微子》：“止子路宿，杀鸡为黍而食之。”元·宫大用《范张鸡黍》第四折"},"usage":"作宾语、定语；用于书面语"},{"id":48748,"word":"鸢堕腐鼠","pinyin":"yuān duò fǔ shǔ","abbr":"ydfs","explanation":"鸢：老鹰。老鹰扔下腐烂的老鼠。比喻骄傲的人必然失败。","source":{"text":"鸢堕腐鼠，而虞氏以亡。","book":"《淮南子·人间训》"},"usage":"作宾语、定语；用于书面语"},{"id":48749,"word":"鸢肩火色","pinyin":"yuān jiān huǒ sè","abbr":"yjhs","explanation":"鸢：老鹰。像鹰之飞扬双肩上耸，如火之腾焰面呈红光。相术上旨飞黄腾达的征兆。","source":{"text":"然鸢肩火色，腾上必速，恐不能久耳。","book":"《旧唐书·马周传》"},"example":{"text":"我只愁他这个样子，怎生合方才那班～的矫矫虎臣会弄得到一处？","book":"清·文康《儿女英雄传》第三十四回"}},{"id":48750,"word":"鸢肩羔膝","pinyin":"yuān jiān gāo xī","abbr":"yjgx","explanation":"肩似鸢耸，膝屈似羔。形容卑微之态。","source":{"text":"不复能鸢肩羔膝，卑声诡笑，曲身俯首，称诵人美而求其喜悦。","book":"明·方孝孺《答俞子严书》"},"usage":"作宾语、定语；用于比喻句"},{"id":48751,"word":"鸢肩豺目","pinyin":"yuān jiān chái mù","abbr":"yjcm","explanation":"耸肩似鹰，目凶如豺。形容人相貌阴险凶恶。","source":{"text":"为人鸢肩豺目。","book":"《后汉书·梁冀传》"},"usage":"作宾语、定语；指人的长相"},{"id":48752,"word":"鸢肩鹄颈","pinyin":"yuān jiān hú jǐng","abbr":"yjhj","explanation":"如鸢之耸肩，如鹄之伸颈。形容伏案苦思的样子。","source":{"text":"鸢肩鹄颈作诗苦，寒不能衣饥不煮。","book":"李涵秋《杂咏》之三"},"usage":"作宾语、定语；用于书面语"},{"id":48753,"word":"鸢飞戾天","pinyin":"yuān fēi lì tiān","abbr":"yflt","explanation":"鸢：又名黑耳鸢，一种凶猛的鸟；戾：至，到。比喻为功名利禄而极力高攀。","source":{"text":"鸢飞戾天，鱼跃于渊。","book":"《诗经·大雅·旱麓》"},"example":{"text":"～者，望峰息心。","book":"吴均《与朱元思书》"},"usage":"作谓语、定语；指势利小人"},{"id":48754,"word":"鸢飞鱼跃","pinyin":"yuān fēi yú yuè","abbr":"yfyy","explanation":"鸢：老鹰。鹰在天空飞翔，鱼在水中腾跃。形容万物各得其所。","source":{"text":"鸢飞戾天，鱼跃于渊。","book":"《诗经·大雅·旱麓》"},"example":{"text":"清水池塘傍茅舍，～竹万竿。","book":"陈毅《由北京到广州》诗"},"similar":["鱼跃鸢飞"],"usage":"作谓语、定语；指局势"},{"id":48755,"word":"鸣于乔木","pinyin":"míng yú qiáo mù","abbr":"myqm","explanation":"比喻仕进达于高位。","source":{"text":"伐木丁丁，鸟鸣嘤嘤。出自幽谷，迁于乔木。","book":"《诗经·小雅·伐木》"},"example":{"text":"～，乃金声而玉振之。","book":"《后汉书·张衡传》"},"usage":"作谓语、定语；用于书面语"},{"id":48756,"word":"鸣冤叫屈","pinyin":"míng yuān jiào qū","abbr":"myjq","explanation":"指申诉冤屈。","source":{"text":"我写《家》，也只是为了向腐朽的封建制度提出控诉，替横遭摧残的年轻生命鸣冤叫屈。","book":"巴金《后记》"},"example":{"text":"他整天都在～。"},"similar":["叫屈鸣冤"],"opposite":["无冤无仇"],"usage":"作谓语、宾语；指申诉冤屈"},{"id":48757,"word":"鸣凤朝阳","pinyin":"míng fèng zhāo yáng","abbr":"mfzy","explanation":"正直敢言的贤士。比喻贤臣遇明君。","source":{"text":"李善感直言不讳，竞称鸣凤朝阳。","book":"《诗经·大雅·卷阿》：“凤皇鸣矣，于彼高冈。梧桐生矣，于彼朝阳。”《幼学琼林·卷一·文臣类》"},"example":{"text":"～尺五天，匆匆忽过白鸥边。","book":"宋·范成大《刘德修少卿避暑惠山因便寄赠》诗"},"similar":["朝阳鸣凤"],"usage":"作宾语、定语；用于人才得以重用"},{"id":48758,"word":"鸣剑抵掌","pinyin":"míng jiàn dǐ zhǎng","abbr":"mjdz","explanation":"抵掌：击掌。用击剑来表示志向。比喻勇士非常勇敢。","source":{"text":"臧宫、马武之徒，抚鸣剑而抵掌，志驰于伊吾之北矣。","book":"《后汉书·臧宫传论》"}},{"id":48759,"word":"鸣玉曳履","pinyin":"míng yù yè lǚ","abbr":"myyl","explanation":"佩玉饰曳丝履。指获高官厚禄。","source":{"text":"今超授高爵，与外廷朝会，驺竖倡子，鸣玉曳履，臣窃耻之。","book":"《新唐书·马周传》"},"example":{"text":"纵使技能出众，正可赉之金帛，岂得超授官爵，～，与士君子比肩而立，同坐而食？","book":"《资治通鉴·唐纪十·太宗贞观六年》"},"usage":"作谓语、定语；用于生活"},{"id":48760,"word":"鸣玉曳组","pinyin":"míng yù yè zǔ","abbr":"myyz","explanation":"佩玉饰曳印组。指任高官。","source":{"text":"今新造天下，开太平之基，功臣赏未及遍，高才犹伏草茅，而先令舞胡鸣玉曳组，位五品，趋丹地，殆非创业垂统，贻子孙之道也。","book":"《新唐书·李纲传》"},"usage":"作谓语、定语；用于官场"},{"id":48761,"word":"鸣珂锵玉","pinyin":"míng kē qiāng yù","abbr":"mkqy","explanation":"玉珂鸣响，佩玉铿锵。比喻显贵。","source":{"text":"寻尚主，拜驸马都尉，鸣珂锵玉，出入禁挞，良田甲第，珍宝奇玩，豪华富贵，冠于一时。","book":"宋·王辟之《渑水燕谈录·先兆》"},"usage":"作谓语、定语；用于比喻句"},{"id":48762,"word":"鸣琴而治","pinyin":"míng qín ér zhì","abbr":"mqez","explanation":"指以礼乐教化人民，达到“政简刑清”的统治效果。旧时常用做称颂地方官的谀词。","source":{"text":"宓子贱治单父，弹鸣琴，身不下堂，而单父治。","book":"《吕氏春秋·察贤》"},"usage":"作谓语、定语；用做称颂地方官的谀词"},{"id":48763,"word":"鸣谦接下","pinyin":"míng qiān jiē xià","abbr":"mqjx","explanation":"以谦虚的态度接待下宾。","source":{"text":"至公以奉上，鸣谦以接下。","book":"南朝·梁·沈约《齐故安陆昭王碑文》"}},{"id":48764,"word":"鸣野食苹","pinyin":"míng yě shí píng","abbr":"mysp","explanation":"比喻诚心待人，同甘共苦。","source":{"text":"呦呦鹿鸣，食野之苹。","book":"《诗经·小雅·鹿鸣》"},"example":{"text":"醉酒饱德，虽喜太平之风；～，未展尽心之报。","book":"宋·苏辙《笏记》"},"usage":"作谓语；指待人诚心"},{"id":48765,"word":"鸣金收兵","pinyin":"míng jīn shōu bīng","abbr":"mjsb","explanation":"用敲锣等发出信号撤兵回营。比喻战斗暂时结束。","source":{"text":"闻鼓声而进，闻金声而退。","book":"《荀子·议兵》"},"example":{"text":"见孙安勇猛，卢先锋令～。","book":"明·施耐庵《水浒全传》第九十七回"},"similar":["鸣金收军"],"usage":"作谓语；指撤军","story":["古代军队行军作战都离不开“金”与“鼓”，命令军队行动与进攻就打鼓，即鸣鼓而攻，而命令军队停止或退回就击钲，即鸣金收兵。这种击鼓而攻、鸣金收兵的做法在各个朝代基本上是通行的，到了明朝时，有时也会金鼓齐鸣"]},{"id":48766,"word":"鸣金收军","pinyin":"míng jīn shōu jūn","abbr":"mjsj","explanation":"古时作战用敲锣等方式发出信号撤军回营。","source":{"text":"恐张飞有失，急鸣金收军。","book":"明·罗贯中《三国演义》第65回"},"example":{"text":"天色已大明，各自～。","book":"清·钱采《说岳全传》第77回"},"similar":["鸣金收兵","打退堂鼓"],"opposite":["吹冲锋号"],"usage":"作谓语；指撤军"},{"id":48767,"word":"鸣钟列鼎","pinyin":"míng zhōng liè dǐng","abbr":"mzld","explanation":"钟，打击乐器，泛指一般乐器；鼎，盛物食器。谓用食时身边响着乐器，眼前列着鼎器。后形容古代贵族高官生活的豪奢。","source":{"text":"击钟鼎食，连骑相过。","book":"汉·张衡《西京赋》"},"example":{"text":"丰屋华榱，顾蓬蒿而徙眷；～，想藜藿而移交。","book":"唐·王绩《与陈叔达重借〈隋纪〉书》"},"similar":["鸣钟食鼎"],"usage":"作宾语、定语；用于生活"},{"id":48768,"word":"鸣钟食鼎","pinyin":"míng zhōng shí dǐng","abbr":"mzsd","explanation":"钟，打击乐器，泛指一般乐器；鼎，盛物食器。谓用食时身边响着乐器，眼前列着鼎器。形容古代贵族高官生活的豪奢。","source":{"text":"击钟鼎食，连骑相过。","book":"汉·张衡《西京赋》"},"example":{"text":"～，积代衣缨；长戟高门，因循礼乐。","book":"唐·张鷟《游仙窟》"},"similar":["鸣钟列鼎"],"usage":"作宾语、定语；用于生活"},{"id":48769,"word":"鸣锣喝道","pinyin":"míng luó hè dào","abbr":"mlhd","explanation":"封建时代官吏出门时，前面开路的人敲锣喝令行人让路。比喻为某种事物的出现，制造声势，开辟道路。","source":{"text":"买盐销票驰如飞，鸣锣喝道长官妇。","book":"清·陈偕仙《官查盐》诗"},"example":{"text":"时而作一得意想，便仿佛坐在四人大轿里，鸣锣开道的去接印一般。","book":"清·吴趼人《糊涂世界》卷六"},"similar":["摇旗呐喊","鸣锣开道"],"opposite":["无声无息"],"usage":"作谓语、定语；指官员出行"},{"id":48770,"word":"鸣锣开道","pinyin":"míng luó kāi dào","abbr":"mlkd","explanation":"封建时代官吏出门时，前面开路的人敲锣喝令行人让路。比喻为某种事物的出现，制造声势，开辟道路。","source":{"text":"大凡官府出街，一定是鸣锣开道的。","book":"清·吴趼人《二十年目睹之怪现状》第99回"},"example":{"text":"为共产主义的新生事物～，鞭挞、清除一切剥削阶级的腐朽事物。","book":"秦牧《艺海拾贝·核心》"},"similar":["摇旗呐喊"],"opposite":["无声无息"],"usage":"作谓语、定语；指官员出行"},{"id":48771,"word":"鸣雁直木","pinyin":"míng yàn zhí mù","abbr":"myzm","explanation":"古人认为雁随阳而处，木随阳而直。比喻良才。","source":{"text":"臣东国贱人，学行何取，既殊鸣雁直木，故无结绶弹冠。","book":"《梁书·袁昂传》"},"usage":"作宾语、定语；指贤人"},{"id":48772,"word":"鸣鹤之应","pinyin":"míng hè zhī yīng","abbr":"mhzy","explanation":"比喻诚笃之心相互应和。","source":{"text":"处于幽昧而行不失信，则声闻于外，为同类之所应焉。","book":"《易·中孚》：“鹤鸣在阴，其子和之。”王弼注：“立诚笃至，虽在闇昧，物亦应焉。”孔颖达疏"},"example":{"text":"乃今穴居名彥，大夫垂访，诸君感～，邕邕焉，锵锵焉。夫亦行古之道也。","book":"明·张居正《〈玉林清赏诗〉序》"},"usage":"作宾语；用于书面语"},{"id":48773,"word":"鸣鼓而攻","pinyin":"míng gǔ ér gōng","abbr":"mgeg","explanation":"比喻宣布罪状，加以遣责或讨伐。","source":{"text":"季氏富于周公，而求也为之聚敛而附益之。子曰：‘非吾徒也，小子鸣鼓而攻之可也。’","book":"先秦·孔子《论语·先进》"},"example":{"text":"不惜～，这倒不仅是一种曲解，简直是一种诬蔑！","book":"郭沫若《沸羹集·新文艺的使命》"},"similar":["兴师问罪"],"usage":"作谓语、宾语；用于战争等","story":["春秋时期，鲁国的季康子主张改革农田制度，承认私人可以拥有土地，想试行按亩征税，他的属下冉求是孔子的学生，就让冉求去征询孔子的意见。孔子反对改变王法，冉求支持季康子的改革，孔子就号召他的其他学生敲着鼓去进攻冉求"]},{"id":48774,"word":"鸣鼓而攻之","pinyin":"míng gǔ ér gōng zhī","abbr":"mgegz","explanation":"比喻宣布罪状，遣责或声讨。","source":{"text":"非吾徒也，小子鸣鼓而攻之可也。","book":"《论语·先进》"},"example":{"text":"此秀才中之异端，尔其～！但念在天色已晚，可与同居中国，速领他到西小房去！","book":"清·李百川《绿野仙踪》第七回"},"similar":["鸣鼓而攻"],"usage":"作谓语；指公开声讨","story":["春秋时期，鲁国的季康子主张改革农田制度，承认私人可以拥有土地，想试行按亩征税，他的属下冉求是孔子的学生，就让冉求去征询孔子的意见。孔子反对改变王法，冉求支持季康子的改革，孔子就号召他的其他学生敲着鼓去进攻冉求"]},{"id":48775,"word":"鸥水相依","pinyin":"ōu shuǐ xiāng yī","abbr":"osxy","explanation":"比喻离不开赖以生存的环境。","source":{"text":"我老生涯鸥水相依，他旧风流鸿塞荒投。","book":"明·陈汝元《金莲记·蜀晤》"},"usage":"作谓语、宾语；指互相依赖"},{"id":48776,"word":"鸥波萍迹","pinyin":"ōu bō píng jì","abbr":"obpj","explanation":"比喻闲适自由的隐者生活。","source":{"text":"事在身外，身在世外，鸥波萍迹，足寄此生。","book":"清·王士禛《池北偶谈·谈献二·王公家书》"},"usage":"作宾语、定语；指隐居者的生活"},{"id":48777,"word":"鸥鸟不下","pinyin":"ōu niǎo bù xià","abbr":"onbx","explanation":"鸥鸟不肯飞下来。比喻觉察别人将加害于自己，注意防范。","source":{"text":"海上之人有好鸥鸟者，每旦之海上，从鸥鸟游。鸥鸟之至者百住而不止。其父曰：‘吾闻鸥鸟皆从汝游，汝取来，吾玩之。’明日之海上，鸥鸟舞而不上也。","book":"《列子·黄帝》"},"example":{"text":"夫贞夫之一，则天地可动，机心内萌，则～。","book":"《三国志·魏志·高柔传》裴松之注"},"usage":"作谓语、宾语；用于书面语"},{"id":48778,"word":"鸥鸟忘机","pinyin":"ōu niǎo wàng jī","abbr":"onwj","explanation":"机：巧诈或权变之心。指像鸥鸟一样，日与白沙云天相伴，完全忘掉心计。比喻淡泊隐居，不以世事为怀。","source":{"text":"鸥鸟忘机翻浃洽，交亲得路昧平生。","book":"唐·李商隐《赠田叟》诗"},"similar":["鸥鹭忘机"],"usage":"作宾语、定语；用于书面语"},{"id":48779,"word":"鸥鹭忘机","pinyin":"ōu lù wàng jī","abbr":"olwj","explanation":"指人无巧诈之心，异类可以亲近。后比喻淡泊隐居，不以世事为怀。","source":{"text":"海上之人有好沤鸟者，每旦之海上，从沤鸟游，沤鸟之至者百住而不止。其父曰：‘吾闻沤鸟皆从汝游，汝取来，吾玩之。’明日之海上，沤鸟舞而不下也。","book":"《列子·黄帝》"},"example":{"text":"只闲闲～，去水任宽窄。","book":"清·王鹏运《红情·苇湾观荷与乙庵分赋红情绿意》词"},"similar":["鸥鸟忘机"],"usage":"作宾语、定语；用于书面语"},{"id":48780,"word":"鸦巢生凤","pinyin":"yā cháo shēng fèng","abbr":"ycsf","explanation":"乌鸦的窝里生出了凤凰。比喻贫苦人家培养出了才化的人物。","source":{"text":"僧问：‘如何是异类？’显端曰：‘鸦巢生凤。’","book":"宋·释普济《五灯会元》"},"example":{"text":"她出身于偏远山区的农民家庭，这次考入北京，人称她父母～"},"usage":"作宾语、定语；用于比喻句"},{"id":48781,"word":"鸦没鹊静","pinyin":"yā méi què jìng","abbr":"ymqj","explanation":"形容没有一点声息。同“鸦默雀静”。","source":{"text":"我因为到了老祖宗那里，鸦没鹊静的，问小丫头子们，他又不肯叫我到园里来。","book":"《红楼梦》第五十回"},"similar":["鸦默雀静","鸦默鹊静"],"opposite":["沸沸扬扬"],"usage":"作谓语、定语、状语；用于书面语"},{"id":48782,"word":"鸦窝里出凤凰","pinyin":"yā wō lǐ chū fèng huáng","abbr":"ywlcfh","explanation":"乌鸦的窝里生出了凤凰。比喻贫苦人家培养出了才化的人物。","source":{"text":"僧问：‘如何是异类？’显端曰：‘鸦巢生凤。’","book":"宋·释普济《五灯会元》卷十二"},"example":{"text":"老的每道，这个是谁，是陈妈妈家大的个孩儿。嗨！～。","book":"元·关汉卿《陈母教子》第二折"}},{"id":48783,"word":"鸦雀无声","pinyin":"yā què wú shēng","abbr":"yqws","explanation":"连乌鸦麻雀的声音都没有。形容非常静。","source":{"text":"天风吹雨入阑干，乌鹊无声夜向阑。","book":"宋·释道原《景德传灯录》卷四：“公曰：‘鸦去无声，又何言闻？’”宋·苏轼《绝句三首》"},"example":{"text":"直等到大众去净之后，静悄悄的～。","book":"清·李宝嘉《官场现形记》第三十三回"},"similar":["鸦默雀静","万籁俱寂"],"opposite":["人声鼎沸","沸反盈天"],"usage":"作谓语、定语、状语；形容非常静"},{"id":48784,"word":"鸦雀无闻","pinyin":"yā què wú wén","abbr":"yqww","explanation":"连乌鸦麻雀的声音都没有。形容非常静。","source":{"text":"天风吹雨入阑干，乌鹊无声夜向阑。","book":"宋·苏轼《绝句三首》"},"example":{"text":"仔细再听，外面～，不但并无炮声，连报喜的也不见了。","book":"清·李汝珍《镜花缘》第六十六回"},"similar":["鸦雀无声","鸦默雀静"],"opposite":["沸沸扬扬"],"usage":"作谓语、定语、状语；形容非常静"},{"id":48785,"word":"鸦飞雀乱","pinyin":"yā fēi què luàn","abbr":"yfql","explanation":"形容十分纷乱的样子。","source":{"text":"最可笑那些提调、教习以及高等科学员，一个个跑得精光，只剩了些寻常科的学生，在那里鸦飞雀乱。","book":"清·华伟生《开国奇冤·约叙》"},"similar":["鸦飞鹊乱"],"usage":"作谓语、定语；指杂乱"},{"id":48786,"word":"鸦飞鹊乱","pinyin":"yā fēi què luàn","abbr":"yfql","explanation":"①犹言絮絮咶耳。②形容纷乱。","source":{"text":"一张嘴尝是鸦飞鹊乱，久惯是牛皮鸟筋。","book":"明·冯梦龙《山歌·鱼船妇打生人相骂》"},"example":{"text":"早被赵德胜、廖永忠杀入老营，就将火四散放起，烈焰冲天，吴兵～的逃走。","book":"《英烈传》第二三回"},"similar":["鸦飞雀乱"],"usage":"作定语、状语；用于比喻句"},{"id":48787,"word":"鸦鹊无声","pinyin":"yā què wú shēng","abbr":"yqws","explanation":"形容非常静。同“鸦雀无声”。","source":{"text":"此时只觉得静悄悄的鸦鹊无声。","book":"《痛史》第二回"},"example":{"text":"～。回答这卑鄙的劝诱的是：道静的沉默，小俞也沉默。","book":"杨沫《青春之歌》第二部第二十章"},"similar":["鸦雀无声"],"opposite":["沸反盈天"],"usage":"作谓语、定语、状语；形容非常静"},{"id":48788,"word":"鸦默雀静","pinyin":"yā mò què jìng","abbr":"ymqj","explanation":"连乌鸦麻雀的声音都没有。形容没有一点声息。","source":{"text":"天风吹雨入阑干，乌鹊无声夜向阑。","book":"宋·苏轼《绝句三首》"},"example":{"text":"贺老师说完了，三个人～地戳在路灯底下。","book":"陈建功《找乐》第五章"},"similar":["鸦雀无声","万籁俱寂","鸦默鹊静"],"opposite":["沸反盈天","沸沸扬扬"],"usage":"作谓语、定语、状语；用于书面语"},{"id":48789,"word":"鸦默鹊静","pinyin":"yā mò què jìng","abbr":"ymqj","explanation":"形容没有一点声息。同“鸦默雀静”。","source":{"text":"会议室里，鸦默鹊静，只有那口小白钟发出嘀嘀哒哒的，很有规则的微响。","book":"周立波《山乡巨变》上三"},"similar":["鸦没鹊静","鸦默雀静"],"opposite":["热热闹闹"],"usage":"作谓语、定语、状语；用于书面语"},{"id":48790,"word":"鸨合狐绥","pinyin":"bǎo hé hú suí","abbr":"bhhs","explanation":"合：融洽；绥：独来独往，急于求偶的样子；鸨：比雁略大的一种鸟。比喻男女之间发生不正当的关系。","source":{"text":"女父母适并外出，招之入室，鸨合狐绥，遂成缱绻。","book":"清·王韬《淞隐漫录·夜来香》"}},{"id":48791,"word":"鸭步鹅行","pinyin":"yā bù é xíng","abbr":"ybex","explanation":"鸭和鹅行八字步，因用以形容人走路迟缓摇晃的样子。","source":{"text":"我觑不的你梢宽也那褶下，肚迭胸高，鸭步鹅行。","book":"元·秦简夫《东堂老》第二折"},"example":{"text":"她～的样子滑稽可笑。"},"similar":["鸭行鹅步"],"usage":"作定语、状语；用于老年人"},{"id":48792,"word":"鸭行鹅步","pinyin":"yā xíng é bù","abbr":"yxeb","explanation":"步：走。象鹅和鸭子那样的走路。比喻步行缓慢。","source":{"text":"我觑不的你梢宽也那褶下，肚迭胸高，鸭步鹅行。","book":"元·秦简夫《东堂老》第二折"},"similar":["鸭步鹅行"],"usage":"作谓语、定语；指行动缓慢"},{"id":48793,"word":"鸮啼鬼啸","pinyin":"xiǎo tí guǐ xiào","abbr":"xtgx","explanation":"像鸮鸟啼叫、怨鬼呼号。形容声音凄厉幽怨。","source":{"text":"声调哀怨，幽幽然鸮啼鬼啸，闻之者莫不歔欷。","book":"唐·无名氏《冥音录》"},"usage":"作谓语、定语；用于书面语"},{"id":48794,"word":"鸮心鸝舌","pinyin":"xiāo xīn lí shé","abbr":"xxls","explanation":"鸮鸟的心，黄鹂的鸣声。比喻居心狠毒，但说话动听。"},{"id":48795,"word":"鸮心鹂舌","pinyin":"xiǎo xīn lí shé","abbr":"xxls","explanation":"鸮鸟的心，黄鹂的鸣声。比喻居心狠毒，但说话动听。","source":{"text":"这绍闻当不住鸮心鹂舌的话。真乃是看其形状，令人能种种不乐；听其巧言，却又挂板儿声声打入心坎。","book":"清·李绿园《歧路灯》第七十二回"},"usage":"作宾语、定语；用于比喻句"},{"id":48796,"word":"鸮心鹺舌","pinyin":"xiāo xīn lí shé","abbr":"xxls","explanation":"鸮鸟的心，黄鹂的鸣声。比喻居心狠毒，但说话动听。"},{"id":48797,"word":"鸮鸟生翼","pinyin":"xiǎo niǎo shēng yì","abbr":"xnsy","explanation":"旧传鸮鸟不孝，母哺翼成，啄母睛而去。比喻忘恩负义。","source":{"text":"今老幼皆以温饱，遂如鸮鸟生翼，欲啄母睛邪！","book":"清·蒲松龄《聊斋志异·青蛙神》"},"similar":["忘恩负义"],"usage":"作宾语、定语；指人忘恩负义"},{"id":48798,"word":"鸮鸣鼠暴","pinyin":"zhāng míng shǔ bào","abbr":"xmsb","explanation":"鸮鸟鸣叫，老鼠肆暴。比喻恶人气焰嚣张。"},{"id":48799,"word":"鸱张蚁聚","pinyin":"chī zhāng yǐ jù","abbr":"czyj","explanation":"喻指如鸱嚣张，如蚁聚集。","source":{"text":"晃之谋主苏涣、骑将王明悦，鸱张蚁聚，皆据厄害。","book":"唐·权德舆《唐故光禄大夫检校尚书右仆射兼右卫将军南充郡王赠太子少保伊公神道碑铭》序"},"usage":"作比喻、定语；用于书面语"},{"id":48800,"word":"鸱张门户","pinyin":"chī zhāng mén hù","abbr":"czmh","explanation":"树立门户，标榜门庭。","source":{"text":"余雅不喜诗坛吟社之说，大概起于前明末年鸱张门户之恶习。","book":"清·袁枚《随园诗话补遗》卷九"},"usage":"作谓语、定语；用于书面语"},{"id":48801,"word":"鸱张鱼烂","pinyin":"chī zhāng yú làn","abbr":"czyl","explanation":"比喻外表嚣张，内则溃烂而自行覆灭。","source":{"text":"初则狐假鸱张，自谓骁雄莫敌；旋则鸟焚鱼烂，无非破败而终。","book":"《旧唐书·僖宗纪》"},"example":{"text":"是以苗志得气盈，～，不可收拾。","book":"清·魏源《圣武记》卷七"},"usage":"作比喻、定语；用于书面语"},{"id":48802,"word":"鸱张鼠伏","pinyin":"chī zhāng shǔ fú","abbr":"czsf","explanation":"比喻时而嚣张，时而隐蔽。","source":{"text":"蛮人鸱张鼠伏，自其常态。","book":"《明史·贵州土司传序》"},"usage":"作谓语、定语；用于为人"},{"id":48803,"word":"鸱目虎吻","pinyin":"chī mù hǔ wěn","abbr":"cmhw","explanation":"鸱：鹞鹰，一种猛禽；吻：嘴唇边。形容人相貌阴险凶恶。","source":{"text":"莽所谓鸱目虎吻豺狼之声者也，故能食人，亦当为人所食。","book":"东汉·班固《汉书·王莽传中》"},"example":{"text":"王莽非直～，亦紫色蛙声。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作定语；形容奸狠凶恶的样子","story":["西汉时期，鸱目虎吻豺狼的王莽处心积虑，沽名钓誉，以抚育亡兄的儿子，衣不解带侍侯生病的伯父，博得了“孝”名，被伯父推荐给孝元太后和皇帝，被封黄门郎，他广泛交际，后来成为大司马以及称帝，一旦掌权就十分凶残，大开杀戒"]},{"id":48804,"word":"鸱视狼顾","pinyin":"chī shì láng gù","abbr":"cslg","explanation":"如鸱鸟举首而视，如狼反顾。形容人的凶狠贪戾。","source":{"text":"鱼鳖禽兽闻之者，莫不张耳鹿骇，熊经鸟伸，鸱视狼顾拊噪踊跃。","book":"《文选·马融》"},"example":{"text":"建～，唯利是赖。","book":"《新唐书·叛臣传下·陈敬瑄》"},"similar":["鸱视虎顾"],"usage":"作谓语、宾语、定语；用于为人"},{"id":48805,"word":"鸱视虎顾","pinyin":"chī shì hǔ gù","abbr":"cshg","explanation":"如鸱鸟举首而视，如虎反顾。","source":{"text":"真人之所游，若吹呴呼吸，吐故纳新，凫浴猿躩，熊经鸟伸，鸱视虎顾，是养形之人也，不以滑心。","book":"《淮南子·精神训》"},"similar":["鸱视狼顾"],"usage":"作谓语、宾语、定语；用于为人"},{"id":48806,"word":"鸱鸦嗜鼠","pinyin":"chī yā shì shǔ","abbr":"cyss","explanation":"比喻嗜好各不相同。","source":{"text":"民食刍豢，麋鹿食荐，  且甘带，鸱鸦嗜鼠，四者孰知正味。","book":"《庄子·齐物论》"},"usage":"作宾语、定语；比喻爱好各不相同"},{"id":48807,"word":"鸱鸮弄舌","pinyin":"chī xiāo nòng shé","abbr":"cxns","explanation":"鸱鸮：猫头鹰一类的鸟，比喻小人。鸱鸮卖弄口舌。比喻小人拨弄是非，得以逞强。","source":{"text":"枉了你扬威耀武，尽忠竭节，定国安邦，偏容他鸱鸮弄舌，乌鸦展翅，强配鸾凰。","book":"元·无名氏《连环计》第三折"},"usage":"作宾语；指逞强"},{"id":48808,"word":"鸳俦凤侣","pinyin":"yuān chóu fèng lǚ","abbr":"ycfl","explanation":"形容男女欢爱似鸳鸯、凤凰般相偕作伴。","source":{"text":"谩说鸳俦凤侣，惹起蜂争蝶忌。","book":"明·王玉峰《焚香记·离间》"},"usage":"作宾语、定语；用于书面语"},{"id":48809,"word":"鸷击狼噬","pinyin":"zhì jī láng shì","abbr":"zjls","explanation":"指凶狠地残害人。","source":{"text":"林甫方兴大狱，撼东宫，诛不附己者，以鉷险刻，可动以利，故倚之，使鸷击狼噬。","book":"《新唐书·王鉷传》"},"usage":"作宾语、定语；用于比喻句"},{"id":48810,"word":"鸷狠狼戾","pinyin":"zhì hěn láng lì","abbr":"zhll","explanation":"形容凶狠乖戾。","source":{"text":"塔为人鸷狠狼戾，好结小人，不听朝廷节制。","book":"元·脱脱《金史》卷一百十一"}},{"id":48811,"word":"鸷鸟不双","pinyin":"zhì niǎo bù shuāng","abbr":"znbs","explanation":"鸷鸟：凶猛的鸟。凶猛的鸟不成双。比喻正直的人不与世俗同流合污。","source":{"text":"鸷鸟之不群兮，自前世而固然。","book":"战国·楚·屈原《楚辞·离骚》"},"example":{"text":"日月不并出，狐不二雄，神龙不匹，猛兽不群，～。（《淮南子·说林训》）"},"similar":["鸷鸟不群"],"usage":"作宾语、定语；指不合群"},{"id":48812,"word":"鸷鸟不群","pinyin":"zhì niǎo bù qún","abbr":"znbq","explanation":"鸷鸟：猛禽。鸷鸟不合群。比喻忠正刚强的人不合于世俗。","source":{"text":"鸷鸟之不群兮，自前世而固然。","book":"战国·楚·屈原《楚辞·离骚》"},"similar":["鸷鸟不双"],"opposite":["同流合污"],"usage":"作宾语、定语；指不合群"},{"id":48813,"word":"鸷鸟将击，卑飞敛翼","pinyin":"zhì niǎo jiāng jī，bēi fēi liǎn yì","abbr":"znjjbfly","explanation":"比喻欲擒故纵，伺机而后发。","source":{"text":"鸷鸟将击，卑飞敛翼；猛兽将搏，弭耳俯伏。","book":"《六韬·发启》"},"example":{"text":"贤弟，且不要使性气，～。","book":"明·无名氏《鸣凤记·南北分别》"},"usage":"作宾语、定语、分句；用于处事"},{"id":48814,"word":"鸷鸟累百，不如一鹗","pinyin":"zhì niǎo lèi bǎi，bù rú yī è","abbr":"znlbbrye","explanation":"犹言诸侯百人不如天子一人。","source":{"text":"《史记》赵简子曰：鸷鸟累百，不如一鹗。","book":"《汉书·邹阳传》:“臣闻鸷鸟累百，不如一鹗。”颜师古注引如淳曰：“鸷鸟比诸侯，鹗比天子。”《文选·孔融〈荐祢衡表〉》：“鸷鸟累百，不如一鹗，使衡立朝，必有可观。”李善注"},"example":{"text":"《元典章·吏部·令史》：“日近之间，江南大小诸衙门，不思‘～’之意，其于吏员不为精择，依例选用，往往推称旧弊，乞照详事。”"},"usage":"作宾语、定语；用于书面语"},{"id":48815,"word":"鸾交凤俦","pinyin":"luán jiāo fèng chóu","abbr":"ljfc","explanation":"比喻优秀人物交友或才子佳人结为夫妻。同“鸾交凤友”。","source":{"text":"中宫位卸，便做鸾交凤俦；衾裯伴少，便做莺栖燕游。","book":"清·李渔《慎鸾交·却媒》"},"similar":["鸾交凤友"],"usage":"作宾语；比喻情侣、夫妻"},{"id":48816,"word":"鸾交凤友","pinyin":"luán jiāo fèng yǒu","abbr":"ljfy","explanation":"比喻优秀人物交友或才子佳人结为夫妻。","source":{"text":"来时节画堂箫鼓鸣春昼，列着一对儿鸾交凤友。","book":"元·王实甫《西厢记》第四本第二折"},"example":{"text":"从前上个陈情表，少不得，成就～缘。","book":"清·陈瑞生《再生缘》第12回"},"similar":["鸾交凤俦"],"usage":"作宾语；比喻情侣、夫妻"},{"id":48817,"word":"鸾俦凤侣","pinyin":"luán chóu fèng lǚ","abbr":"lcfl","explanation":"指男女欢爱如鸾凤般相谐作伴。","source":{"text":"何不与舍侄女竟成鸾俦凤侣，便完了一件百年的大事？","book":"《好逑传》第16回"},"similar":["男女欢爱"],"usage":"作宾语；指男欢女爱"},{"id":48818,"word":"鸾停鹄峙","pinyin":"luán tíng hú zhì","abbr":"lthz","explanation":"用以比喻子孙贤俊。同“鸾鹄停峙”。","source":{"text":"退见少傅，翠竹碧梧，鸾鹄停峙，能守其业者也。","book":"唐·韩愈《殿中少监马君墓志铭》"},"example":{"text":"今伯母之膝下，跪而称觞者，子十有一人，孙三十有许人，～，琼芬蕙列，又长支中最繁盛者。","book":"明·袁宏道《寿洪太母七十序》"},"similar":["鹄峙鸾停","鸾鹄停峙"],"usage":"作谓语、定语；用于书面语"},{"id":48819,"word":"鸾凤分飞","pinyin":"luán fèng fēn fēi","abbr":"lfff","explanation":"比喻夫妻或情侣离散。","source":{"text":"鸾凤分飞海树秋，忍听钟鼓越王楼。","book":"唐·房千里《寄妾赵氏》诗"},"similar":["劳燕分飞"],"usage":"作谓语、宾语；指情侣离散"},{"id":48820,"word":"鸾凤和鸣","pinyin":"luán fèng hè míng","abbr":"lfhm","explanation":"和：应和。比喻夫妻相亲相爱。旧时常用于祝人新婚。","source":{"text":"是谓凤凰于飞，和鸣锵锵。","book":"《左传·庄公二十二年》"},"example":{"text":"夜同寢，昼同行，恰似～。","book":"元·白朴《梧桐雨》第一折"},"similar":["夫唱妇随"],"usage":"作谓语、宾语；用于祝人新婚"},{"id":48821,"word":"鸾分凤离","pinyin":"luán fēn fèng lí","abbr":"lffl","explanation":"比喻夫妻或情侣离散。同“鸾凤分飞”。","source":{"text":"鸾凤分飞海树秋，忍听钟鼓越王楼。","book":"唐·房千里《寄妾赵氏》诗"},"example":{"text":"自从他～，到如今雁断鱼稀。","book":"明·李开先《宝剑记传奇》第四十八出"},"similar":["鸾凤分飞"],"usage":"作谓语、定语；用于夫妻或情侣等"},{"id":48822,"word":"鸾只凤单","pinyin":"luán zhī fèng dān","abbr":"lzfd","explanation":"孤独的鸾凤。比喻夫妻或情侣离散后的孤单情形。","source":{"text":"恨当初鸾只凤单，喜今日夫荣妻显。","book":"明·高濂《玉簪记·合庆》"},"similar":["鸾孤凤只","形只影单"],"opposite":["成双成对"],"usage":"作谓语、定语；指夫妻离异"},{"id":48823,"word":"鸾吟凤唱","pinyin":"luán yín fèng chàng","abbr":"lyfc","explanation":"鸾凤鸣叫相和。比喻优美的乐曲。","source":{"text":"鸾吟凤唱听无拍，多似霓裳散序声。","book":"唐·白居易《王子晋庙》诗"}},{"id":48824,"word":"鸾回凤翥","pinyin":"luán huí fèng zhù","abbr":"lhfz","explanation":"形容舞姿优美。","source":{"text":"风引宝衣疑欲舞，鸾回凤翥堪惊。","book":"前蜀·牛希济《临江仙》词之五"},"usage":"作宾语、定语；用于舞蹈等"},{"id":48825,"word":"鸾回凤舞","pinyin":"luán huí fèng wǔ","abbr":"lhfw","explanation":"鸾：传说中像凤凰的鸟；回：旋转。比喻书法笔势优美飞动。","source":{"text":"字画遒劲，鸾回凤舞，濡毫挥洒，顷刻而成。","book":"明·于慎行《毂山笔塵·纪述》"},"similar":["鸾飞凤舞"],"usage":"作定语、状语；用于书法等"},{"id":48826,"word":"鸾姿凤态","pinyin":"luán zī fèng tài","abbr":"lzft","explanation":"比喻神仙的仪态。","source":{"text":"弟子十八人，并皆殊秀，然鸾姿凤态，眇映云松者，有韦法昭、司马子微、郭崇真。","book":"《云笈七签》卷五"},"usage":"作宾语、定语；用于人的神态"},{"id":48827,"word":"鸾孤凤只","pinyin":"luán gū fèng zhī","abbr":"lgfz","explanation":"比喻夫妻离散。也比喻人失偶孤居。","source":{"text":"从来我意，镇有心，便欲求伊姻契，谁知到此，情一似凤孤鸾只。","book":"宋·无名氏《张协状元》第二十九出"},"example":{"text":"吕温侯～，烦恼杀情分两处旧娇妻。","book":"元·无名氏《连环计》第四折"},"similar":["形单影只","鸾孤凤寡"],"usage":"作宾语、定语；比喻夫妻或情侣离散"},{"id":48828,"word":"鸾孤凤寡","pinyin":"luán gū fèng guǎ","abbr":"lgfg","explanation":"比喻夫妻离散。也比喻人失偶孤居。同“鸾孤凤只”。","source":{"text":"从来我意，镇有心，便欲求伊姻契，谁知到此，情一似凤孤鸾只。","book":"宋·无名氏《张协状元》第二十九出"},"example":{"text":"叹～，啼痕愠透香罗帕。","book":"明·吴廷翰《集贤宾·题情》"},"similar":["鸾孤凤只"],"usage":"作宾语、定语；比喻夫妻或情侣离散"},{"id":48829,"word":"鸾枭并栖","pinyin":"luán xiāo bìng qī","abbr":"lxbq","explanation":"枭：鸱鸮，指恶鸟。鸾凤和鸱鸮一起停在一棵树上。比喻好坏混杂。","source":{"text":"至于李廷机与陈新甲同传，未免鸾枭并栖，殊无分晰，不如忠臣之分传也。","book":"清·昭梿《啸亭杂录·续录·明史稿》"}},{"id":48830,"word":"鸾歌凤吹","pinyin":"luán gē fèng chuí","abbr":"lgfc","explanation":"指笙箫等乐曲声。","source":{"text":"临高台，高台迢递绝浮埃。瑶轩绮构何崔嵬，鸾歌凤吹清且哀。","book":"唐·王勃《临高台》"}},{"id":48831,"word":"鸾歌凤舞","pinyin":"luán gē fèng wǔ","abbr":"lgfw","explanation":"比喻美妙的歌舞。","source":{"text":"爰有歌舞之鸟，鸾鸟自歌，凤鸟自舞。","book":"《山海经·大荒南经》"},"example":{"text":"～集天台，金阙银宫相向开。","book":"南朝·陈·张正见《神仙篇》"},"similar":["轻歌曼舞"],"usage":"作宾语；比喻美妙的歌舞"},{"id":48832,"word":"鸾漂凤泊","pinyin":"luán piāo fèng bó","abbr":"lpfb","explanation":"①形容书法的笔势神奇飘逸。②比喻夫妻或情侣离散，天各一方。亦泛指身世沦落，漂泊不定。亦作“凤泊鸾飘”、“飘鸾泊凤”。"},{"id":48833,"word":"鸾翔凤翥","pinyin":"luán xiáng fèng zhù","abbr":"lxfz","explanation":"翔：盘旋而飞；翥：高飞。比喻书法笔势飞动舒展。","source":{"text":"鸾翔凤翥，鸿惊鹤飞，鲸鲵溯波，鲛鳄冲道。","book":"晋·陆机《浮云赋》"},"example":{"text":"～众仙下，珊瑚碧树交枝柯。","book":"唐·韩愈《石鼓歌》"},"similar":["龙飞凤舞"],"usage":"作谓语、宾语；比喻书法字体飘逸，笔势飞动"},{"id":48834,"word":"鸾翔凤集","pinyin":"luán xiáng fèng jí","abbr":"lxfj","explanation":"集：群鸟停歇在树上。鸾鸟在飞翔，凤凰成群地歇在这里。比喻优秀的人才汇聚到一起。","source":{"text":"穆穆清禁，济济群英。鸾翔凤集，羽仪上亲。","book":"晋·傅咸《申怀赋》"},"usage":"作谓语、宾语；比喻人才汇聚到一起"},{"id":48835,"word":"鸾翱凤翥","pinyin":"luán áo fèng zhù","abbr":"lafz","explanation":"比喻字体飘逸，笔势飞动。","source":{"text":"鸾翱凤翥众仙下，珊瑚碧树交枝柯。","book":"唐·韩愈《石鼓歌》"},"similar":["鸾翔凤翥"],"usage":"作宾语、定语；用于书法等"},{"id":48836,"word":"鸾胶再续","pinyin":"luán jiāo zài xù","abbr":"ljzx","explanation":"鸾胶：传说中的一种胶，能把弓弦断处粘在一起。后用以指男子续娶。","source":{"text":"西海献鸾胶，武帝弦断，以胶续之，弦两头遂两著。终日射，不断。帝大悦。","book":"《汉武外传》"},"example":{"text":"虽然是～琵琶，却胜似当年萼绿华。","book":"梁羽生《剑网尘缘》第一回"}},{"id":48837,"word":"鸾胶凤丝","pinyin":"luán jiāo fèng sī","abbr":"ljfs","explanation":"指续娶的后妻。","source":{"text":"虽然如此，只怕春风暗里恨弃鱼，当垆偷写文君句，谩重寻鸾胶凤丝，谩重寻鸾胶凤丝。","book":"明·陈汝元《金莲记·湖赏》"},"usage":"作宾语、定语；用于比喻句"},{"id":48838,"word":"鸾舆凤驾","pinyin":"luán yú fèng jià","abbr":"lyfj","explanation":"指华丽的宫廷车乘。","source":{"text":"金樽玉杯，不能使薄洒更厚；鸾舆凤驾，不能使驽马健捷。","book":"南朝·梁·梁元帝《金楼子·立言》"},"usage":"作宾语、定语；用于比喻句"},{"id":48839,"word":"鸾跂鸿惊","pinyin":"luán qí hóng jīng","abbr":"lqhj","explanation":"比喻书法笔势飞举之态。","source":{"text":"才披尺许目增明，鸾跂鸿惊欲飞逝。","book":"宋·黄伯恩《法帖刊误·王大令书上》"},"usage":"作宾语、定语；用于书法等"},{"id":48840,"word":"鸾音鹤信","pinyin":"luán yīn hè xìn","abbr":"lyhx","explanation":"比喻仙界的音信。","source":{"text":"鸾音鹤信杳难回，凤驾龙车早晚来。","book":"唐·罗隐《淮南高骈所造迎仙楼》诗"},"example":{"text":"～须凝睇，好把唏嘘答上苍。","book":"清·曹雪芹《红楼梦》第五十回"},"usage":"作宾语、定语；用于比喻句"},{"id":48841,"word":"鸾颠凤倒","pinyin":"luán diān fèng dǎo","abbr":"ldfd","explanation":"指男女欢合。","source":{"text":"喜孜孜鸾颠凤倒，美津津露涩花娇。","book":"明·谢谠《四喜记·仁主赐婚》"},"example":{"text":"清·褚人获《隋唐演义》第31回：“心字香烧，谁敢望～。”"},"similar":["颠鸾倒凤"],"usage":"作谓语、宾语、定语；指男女欢合"},{"id":48842,"word":"鸾飘凤泊","pinyin":"luán piāo fèng bó","abbr":"lpfb","explanation":"飘、泊：随流飘荡。原形容书法笔势潇洒飘逸，后比喻夫妻离散或文人失意。","source":{"text":"科斗拳身薤倒披，鸾飘凤泊拏虎螭。","book":"唐·韩愈《峋嵝山》诗"},"example":{"text":"～寻常事，一堕迷楼最可怜。","book":"清·钱泳《履园丛话·茞香校书》"},"similar":["凤泊鸾飘"],"usage":"作谓语、宾语；比喻夫妻、情侣离散天各一方"},{"id":48843,"word":"鸾飞凤翥","pinyin":"luán fēi fèng zhù","abbr":"lffz","explanation":"鸾凤飞举。比喻仕途得意。","source":{"text":"及夫棘寺之锡，乌台之命，鸾飞凤翥，蔚乎其相宣也。","book":"明·李东阳《祭李都宪母文》"},"usage":"作谓语、定语；用于仕途等"},{"id":48844,"word":"鸾飞凤舞","pinyin":"luán fēi fèng wǔ","abbr":"lffw","explanation":"形容祥瑞和平的环境。","source":{"text":"有鸾鸟自歌，凤鸟自舞……见则天下和。","book":"《山海经·海内经》"},"example":{"text":"况兰亭定武，更宣和书谱，老笔霜花艳吐，写得～。","book":"清·吴梅《霜厓曲录·北越调斗鹌鹑·黄蔷薇》"},"usage":"作定语、状语；用于书面语"},{"id":48845,"word":"鸾鸣凤奏","pinyin":"luán míng fèng zòu","abbr":"lmfz","explanation":"弹奏演唱的美称。","source":{"text":"某相遇之初，每闻绝调，辄不禁神魂之飞动。心事多违，彼此郁郁，鸾鸣凤奏，久矣不闻。","book":"明·冯梦龙《警世通言》第三十二卷"},"usage":"作宾语、定语；用于书面语"},{"id":48846,"word":"鸾鹄停峙","pinyin":"luán hú tíng zhì","abbr":"lhtz","explanation":"停：停留止息；峙：耸立。像鸾鹄一样停息和耸立着。多用以喻称他人子孙俊秀。","source":{"text":"退见少傅，翠竹碧梧，鸾鹄停峙，能守其业者也。","book":"唐·韩愈《殿中少监马君墓志铭》"},"similar":["鸾停鹄峙"],"usage":"作谓语、定语；用于书面语"},{"id":48847,"word":"鸾鹄在庭","pinyin":"luán hú zài tíng","abbr":"lgzt","explanation":"指鸾鹄峙立于庭。比喻子孙贤俊。","source":{"text":"寿考之馀，报施亦丰。一子四孙，鸾鹄在庭，以华其终。","book":"宋·苏轼《祭张文定公文》"},"similar":["鸾鹄停峙"],"usage":"作谓语、定语；用于书面语"},{"id":48848,"word":"鸿业远图","pinyin":"hóng yè yuǎn tú","abbr":"hyyt","explanation":"鸿：大。宏伟的事业，远大的志向或谋划。","source":{"text":"若国家不为体恤，不为保护，则小者无以觅蝇头微利，大者无以展鸿业远图。","book":"孙中山《上李鸿章书》"},"example":{"text":"你的～是什么？"},"usage":"作主语、宾语；指人的理想"},{"id":48849,"word":"鸿俦鹤侣","pinyin":"hóng chóu hè lǚ","abbr":"hchl","explanation":"鸿、鹤皆为群居高飞之鸟，因用以比喻高洁、杰出之辈。","source":{"text":"今则凝神注目，无非绣户金铺；接踵比肩，尽是鸿俦鹤侣。","book":"唐·黎逢《贡举人见于含元殿赋》"},"usage":"作宾语、定语；用于书面语"},{"id":48850,"word":"鸿儒硕学","pinyin":"hóng rú shuò xué","abbr":"hrsx","explanation":"鸿儒：大儒；硕学：有很多学问的人。泛指学识渊博、造诣很深的学者。","source":{"text":"朝多君子，鸿儒硕学，无乏于时。","book":"《晋书·儒林传序》"},"example":{"text":"考试之法，政府先聘～，谙练政事者，以为考官。","book":"章炳麟《与章行严论改革国会书》"},"usage":"作主语、宾语；泛指学者"},{"id":48851,"word":"鸿儒硕辅","pinyin":"hóng rú shuò fǔ","abbr":"hrsf","explanation":"学识渊博的学者，功勋卓著的臣士。","example":{"text":"～对朝廷的贡献不可忽视。"},"similar":["鸿儒硕学"],"usage":"作宾语、定语；用于书面语"},{"id":48852,"word":"鸿函钜椟","pinyin":"hóng hán jù dú","abbr":"hhjd","explanation":"指丰富的藏书。"},{"id":48853,"word":"鸿商富贾","pinyin":"hóng shāng fù gǔ","abbr":"hsfj","explanation":"鸿：大；商、贾：商人。十分富有，资财雄厚的大商人。","source":{"text":"鸿商富贾，舞女成群。","book":"清·梁章钜《称谓录·商贾·鸿商富贾》"}},{"id":48854,"word":"鸿图华构","pinyin":"hóng tú huá gòu","abbr":"hthg","explanation":"宏大华美的建筑景观。","source":{"text":"高皇帝定鼎金陵，文皇帝建都燕蓟，我皇上龙飞襄郢，三大都在寰宇间，皆据百二之雄胜，萃岳渎之灵秀。鸿图华构，鼎峙于南北。","book":"明·张居正《宫殿纪》"},"usage":"作宾语、定语；用于建筑等"},{"id":48855,"word":"鸿均之世","pinyin":"hóng jūn zhī shì","abbr":"hjzs","explanation":"鸿：大；均：平。指天下太平，人心安定。","source":{"text":"夫鸿均之世，何物不乐。","book":"汉·王褒《四子讲德论》"},"similar":["太平盛世"],"usage":"作主语、宾语；指太平盛世"},{"id":48856,"word":"鸿才大略","pinyin":"hóng cái dà lüè","abbr":"hcdl","explanation":"非常杰出的才智和谋略。","source":{"text":"虽有鸿才大略，丽句丰辞，发言盈乎百代，濡翰周乎四时，略无益于今日，而适足以怫之。","book":"唐·卢照邻《对蜀父老问》"}},{"id":48857,"word":"鸿断鱼沉","pinyin":"hóng duàn yú chén","abbr":"hdyc","explanation":"书信断绝，音讯全无。"},{"id":48858,"word":"鸿案相庄","pinyin":"hóng àn xiāng zhuāng","abbr":"haxz","explanation":"①表示夫妻和好相敬。②指结为伉俪。","source":{"text":"鸿案相庄廿有三年，年愈久而情愈密。","book":"据《后汉书·逸民传·梁鸿》载：“鸿家贫而有节操。妻孟光，有贤德。每食，光必对鸿举案齐眉，以示敬重。”清·沈复《浮生六记·闺房记乐》"},"example":{"text":"仆初日封卿，本思偕老，然以长卿家徒四壁，子敬座剩一毡，而遽欲～，鸩媒是遣，谁其信之哉。","book":"清·王韬《凇滨琐话·金玉蟾》"},"usage":"作宾语、定语；用于夫妻间","story":["东汉书生梁鸿读完太学回家务农，与县上孟财主的30岁女儿孟光结婚，婚后他们抛弃孟家的富裕生活，到霸陵山区隐居，后来帮皋伯通打短工。每次孟光给梁鸿送饭时把托盘举得跟眉毛一样高，眉来眼去，夫妻十分恩爱"]},{"id":48859,"word":"鸿案鹿车","pinyin":"hóng àn lù chē","abbr":"halc","explanation":"鸿案：指梁鸿妻举案齐眉的事；鹿车：指鲍宣与妻共驾鹿车归乡的事。比喻夫妻相互敬重，同甘共苦。","source":{"text":"《后汉书·梁鸿传》及《后汉书·钱包宣妻传》载"},"example":{"text":"剑云是寒士生涯，租定了四斜街一所小小四合房子，夫妻团聚，却俨然～。","book":"清·曾朴《孽海花》第十四回"},"usage":"作宾语、定语；用于夫妻间","story":["东汉时期穷书生梁鸿与30岁孟光结婚，抛弃孟家的富裕生活，到霸陵山区隐居，帮皋伯通打短工，孟光给梁鸿送饭时把托盘举到眉毛一样高，眉来眼去，十分恩爱。汉朝的鲍宣的妻子与丈夫共挽鹿车回到故乡，两人同甘共苦传为佳话"]},{"id":48860,"word":"鸿毛泰山","pinyin":"hóng máo tài shān","abbr":"hmts","explanation":"比喻轻重相差极大。","source":{"text":"人固有一死，或重于泰山，或轻于鸿毛，用之所趋异也。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"若必选择死所，而谓～，轻重有异，则虽值当死之事，恐亦不能死矣。","book":"章炳麟《敢死论跋语》"},"similar":["鸿毛泰岱"],"usage":"作宾语、定语；比喻人死的价值轻重悬殊"},{"id":48861,"word":"鸿毛泰岱","pinyin":"hóng máo tài dài","abbr":"hmtd","explanation":"比喻轻重相差极大。同“鸿毛泰山”。","source":{"text":"四十六年余一死，鸿毛泰岱早安排。","book":"郭沫若《战声集·〈归国杂吟〉之三》"},"similar":["鸿毛泰山"],"usage":"作宾语、定语；比喻人死的价值轻重悬殊"},{"id":48862,"word":"鸿毳沉舟","pinyin":"hóng cuì chén zhōu","abbr":"hccz","explanation":"毳：鸟兽的细毛。鸿雁细毛虽轻，堆积过多也能使船沉没。比喻小问题不解决，积累多了就要出大问题。","source":{"text":"鸿毳性轻，积之沉舟。","book":"《新论·慎隙》"},"similar":["积羽沉舟"],"usage":"作宾语、定语；用于劝诫人"},{"id":48863,"word":"鸿泥雪爪","pinyin":"hóng ní xuě zhǎo","abbr":"hnxz","explanation":"比喻往事留下的痕迹。同“鸿爪雪泥”。","source":{"text":"使君蒿目意不愉，遣兴忽写卧游图。鸿泥雪爪无处无，一一俱请丹青摹。","book":"《筱园诗话》卷四引清·吴牧驺《题吴和甫学使纪游图》诗"},"similar":["鸿爪雪泥","鸿爪春泥","鸿爪留泥"],"usage":"作主语、宾语；指往事遗留的痕迹"},{"id":48864,"word":"鸿消鲤息","pinyin":"hóng xiāo lǐ xī","abbr":"hxlx","explanation":"指断绝音信。亦指死。"},{"id":48865,"word":"鸿渐之仪","pinyin":"hóng jiàn zhī yí","abbr":"hjzy","explanation":"对人风采才能的赞词。","source":{"text":"鸿渐于陆，其羽可用为仪，吉。","book":"《周易·渐》"},"example":{"text":"幸惟俯谅，天衢广阔，～，岂有量哉。","book":"明·张居正《答南列卿陈我度书》"},"usage":"作宾语；对人风采才能的赞词"},{"id":48866,"word":"鸿渐之翼","pinyin":"hóng jiàn zhī yì","abbr":"hjzy","explanation":"鸿鹄凭借羽翼而高飞远行，因以之比喻大才；高才。","source":{"text":"渐，进也，鸿一举而进千里者，羽翼之材也。弘等皆以大材初为俗所薄，若燕爵不知鸿志也。","book":"《汉书·公孙弘卜式等传赞》：“公孙弘、卜式、兒宽皆以困于燕爵，远迹羊豕之间，非遇其时，焉能致此位乎？”颜师古注引李奇曰"},"example":{"text":"公以～，困于燕雀，兹膺特简，允惬舆情。","book":"明·张居正《答保定巡抚孙立亭书》"},"usage":"作宾语；用于书面语"},{"id":48867,"word":"鸿渐于干","pinyin":"hóng jiàn yú gàn","abbr":"hjyg","explanation":"以次而进，渐至高处。后指始入仕途。","source":{"text":"《易·渐》：“初六，鸿渐于干”，“六二，鸿渐于磐”，“九三，鸿渐于陆”。"},"example":{"text":"回思子平日节概，痴人说梦，尚是～而已，无足为异。","book":"明·海瑞《与博白大尹林仲和书》"},"usage":"作宾语、定语；用于比喻句"},{"id":48868,"word":"鸿爪春泥","pinyin":"hóng zhǎo chūn ní","abbr":"hzcn","explanation":"比喻往事留下的痕迹。同“鸿爪雪泥”。","source":{"text":"苕生乃寄余诗云：‘鸿爪春泥迹偶存，三生文字系精魂。’","book":"清·袁枚《随园诗话》卷一"},"similar":["鸿爪雪泥","鸿爪留泥","鸿泥雪爪"],"usage":"作主语、宾语；指往事遗留的痕迹"},{"id":48869,"word":"鸿爪留泥","pinyin":"hóng zhǎo liú ní","abbr":"hzln","explanation":"比喻往事留下的痕迹。同“鸿爪雪泥”。","source":{"text":"癸酉夏秋间，余寓居此巷。","book":"清·查慎行《顾侠君庶常招饮晚翠阁》诗之二：“依稀宣北坊西角，鸿爪留泥我亦曾。”自注"},"similar":["鸿爪春泥","鸿爪雪泥","鸿泥雪爪"],"usage":"作主语、宾语；指往事遗留的痕迹"},{"id":48870,"word":"鸿爪雪泥","pinyin":"hóng zhǎo xuě ní","abbr":"hzxn","explanation":"比喻往事留下的痕迹。","source":{"text":"人生到处知何似，应似飞鸿踏雪泥，雪上偶然留爪印。","book":"语出宋·苏轼《和子由渑池怀旧》"},"example":{"text":"追忆当年留宿，或提灯而采荷叶，或曳足而仰星河，呼茶命短腿之胡奴，烧韭烦庞眉之老姊，忽忽四五年，～，都为陈迹。","book":"清·袁枚《答何献葵明府书》"},"similar":["雪泥鸿爪","鸿泥雪爪"],"usage":"作主语、宾语；指往事遗留的痕迹","story":["宋朝时期，苏轼与苏辙兄弟曾在渑池一寺院住过，与寺院老和尚关系很好，并在寺内墙上题诗。后苏轼故地重游作《和子由渑池怀旧》诗大发感慨：“人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。”"]},{"id":48871,"word":"鸿离鱼网","pinyin":"hóng lí yú wǎng","abbr":"hlyw","explanation":"离：遭受；鸿：鸿雁。张网捕鱼，捉到的是鸿雁。比喻得到的不是自己想要的。","source":{"text":"鱼网之设，鸿则离之，燕婉之求，得此戚施。","book":"《诗经·邶风·新台》"},"example":{"text":"～惊相避，无信凭谁寄与渠。","book":"清·黄遵宪《己亥杂诗》"},"similar":["鱼网鸿离"],"usage":"作宾语、定语；指不如意"},{"id":48872,"word":"鸿稀鳞绝","pinyin":"hóng xī lín jué","abbr":"hxlj","explanation":"比喻音信极少。","source":{"text":"客从远方来，遗我双鲤鱼，呼儿烹鲤鱼，中有尺素书。","book":"汉·蔡邕《饮马长城窟行》"},"example":{"text":"自别颜范，～，悲怆不胜。","book":"元·王实甫《西厢记》第三本第一折"},"usage":"作谓语、宾语；比喻书信极少"},{"id":48873,"word":"鸿章钜字","pinyin":"hóng zhāng jù zì","abbr":"hzjz","explanation":"犹鸿文。比喻巨著、大作。","source":{"text":"前由陈中书所递至赐书，伏读数过，鸿章钜字，光辉薄星辰，声气谐《韶》《濩》。","book":"清·梅曾亮《复上汪尚书书》"},"similar":["鸿篇巨制"],"usage":"作宾语、定语；指作品"},{"id":48874,"word":"鸿笔丽藻","pinyin":"hóng bǐ lì zǎo","abbr":"hblz","explanation":"形容诗文笔力雄健，词藻华丽。","source":{"text":"枢纽经典，畴咨故实，理例锋颖，词韵膏腴，则司戎之称鸿笔丽藻矣。","book":"唐·源直心《议释道不应拜俗状》"},"example":{"text":"必资乎～，刻乎贞金翠珉，然后可以充足人天，发挥龙象。","book":"唐·李商隐《上河东公启》"},"usage":"作宾语、定语；用于说话或作文"},{"id":48875,"word":"鸿篇巨制","pinyin":"hóng piān jù zhì","abbr":"hpjz","explanation":"鸿：巨，大。形容工程大，功夫深的著作。","source":{"text":"今鸿篇巨制，照耀寰区。","book":"清·皮锡瑞《经学历史·经学复盛时代》"},"example":{"text":"那时候，～如《世界文学》和《世界文库》之类，还没有诞生。","book":"鲁迅《且介亭杂文末篇·〈译文〉复刊词》"},"similar":["巨制鸿篇","鸿篇巨著"],"opposite":["片言之语","言简意赅"],"usage":"作主语、宾语；形容篇幅长的作品"},{"id":48876,"word":"鸿篇巨帙","pinyin":"hóng piān jù zhì","abbr":"hpjz","explanation":"鸿：巨大。形容规模宏大的著作。","source":{"text":"循是以论，则古来鸿篇巨帙，其沿讹踵缪，而莫从纠勘者，可胜道也。","book":"傅增湘《校永乐大典本》"},"similar":["鸿篇巨制","鸿篇巨著"],"usage":"作主语、宾语；形容篇幅长的作品"},{"id":48877,"word":"鸿篇巨着","pinyin":"hóng piān jù zhù","abbr":"hpjz","explanation":"①杰作。敬称他人的作品。②规模宏大的著作。同“鸿篇钜制”。"},{"id":48878,"word":"鸿篇巨著","pinyin":"hóng piān jù zhù","abbr":"hpjz","explanation":"指规模宏大的著作。同“鸿篇钜制②”。","source":{"text":"我们这时代是产生鸿篇巨著的时代，是产生诗的时代，也是产生绚烂多采、争妍斗胜的散文的时代。","book":"柯灵《香雪海·散文——文学的轻骑队》"},"similar":["鸿篇巨制"],"usage":"作主语、宾语；形容篇幅长的作品"},{"id":48879,"word":"鸿篇钜制","pinyin":"hóng piān jù zhì","abbr":"hpjz","explanation":"①杰作。敬称他人的作品。②规模宏大的著作。","source":{"text":"观察所征鸿篇钜制已多。","book":"清·叶迁琯《吹网录·魏太和铜熨人款识》"},"example":{"text":"其～，洋洋洒者，行将别裒录之为一集。","book":"梁启超《饮冰室诗话》"}},{"id":48880,"word":"鸿翔鸾起","pinyin":"hóng xiáng luán qǐ","abbr":"hxlq","explanation":"如鸿雁高翔，如凤鸾振起。比喻奋发有为，仕途得意。"},{"id":48881,"word":"鸿蒙初辟","pinyin":"hóng méng chū pì","abbr":"hmcp","explanation":"鸿蒙：古人认为天地开辟之前是一团浑沌的元气。开天辟地。指刚刚开始出现人类世界。","source":{"text":"太初始分别天地清浊，剖判涬溟鸿蒙。","book":"宋·张君房《云笈七签·太上君开天经》"}},{"id":48882,"word":"鸿衣羽裳","pinyin":"hóng yī yǔ shang","abbr":"hyys","explanation":"以羽毛为衣裳。指神仙的衣着。","source":{"text":"岩堂之内，每时见神人往还矣，盖鸿衣羽裳之士，练精饵食之夫耳。","book":"北魏·郦道元《水经注·河水二》"},"usage":"作宾语、定语；用于穿着"},{"id":48883,"word":"鸿轩凤翥","pinyin":"hóng xuān fèng zhù","abbr":"hxfz","explanation":"比喻举止高尚。","source":{"text":"而祠部君克承善志，鸿轩凤翥，有风采于朝廷。","book":"宋·范仲淹《滕公夫人刁氏墓志铭》"},"usage":"作宾语、定语；用于比喻句"},{"id":48884,"word":"鸿运当头","pinyin":"hóng yùn dāng tóu","abbr":"hydt","explanation":"鸿运：大好的运气。正是走好运的时候。","source":{"text":"雪公，你鸿运当头，做事千万要漂亮。","book":"高阳《胡雪岩全传·平步青云》上册"},"opposite":["生不逢辰"],"usage":"作谓语、定语；多用于口语"},{"id":48885,"word":"鸿都买第","pinyin":"hóng dōu mǎi dì","abbr":"hdmd","explanation":"以之泛指买官行贿。","source":{"text":"时生徒对策，多行贿赂，文豪请具束脩，君正曰：‘我岂能用钱为兒买第耶？’","book":"《后汉书·崔寔传》：“灵帝时，开鸿都门榜卖官爵，公卿州郡下至黄绶各有差。”《陈书·袁宪传》"},"example":{"text":"君不见～归来客，驷马轩车胡辟易。","book":"清·吴伟业《赠陆生》诗"},"usage":"作宾语、定语；用于官场"},{"id":48886,"word":"鸿门宴","pinyin":"hóng mén yàn","abbr":"hmy","explanation":"鸿门：地名，今陕西临潼东北。指不怀好意的宴请或加害客人的宴会。","source":{"text":"沛公旦日从百余骑来见项王。至鸿门，谢曰：……","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"我不会参加你的～。"},"usage":"作主语、宾语、定语；指加害客人的宴会","story":["公元前206年，项羽率大军入关进驻鸿门，准备消灭刘邦。经项羽叔父项伯的调解，刘邦亲赴鸿门去拜见项羽，项羽设宴相待。席间项羽谋士范增命项庄舞剑，伺机刺杀刘邦。项伯见势不妙，也拔剑起舞掩护刘邦。刘邦乘机入厕，在樊哙等掩护下逃回大本营"]},{"id":48887,"word":"鸿隐凤伏","pinyin":"hóng yǐn fèng fú","abbr":"hyff","explanation":"比喻贤才不遇。","source":{"text":"尽当鸿隐凤伏，斥鷃得而笑之，而不知一朝奋迹，阊阖可叫而开不难也。","book":"清·蒲松龄《贺章丘县周素心入泮序》"},"usage":"作宾语、定语；用于比喻句"},{"id":48888,"word":"鸿雁哀鸣","pinyin":"hóng yàn āi míng","abbr":"hyam","explanation":"哀：悲哀。比喻流离失所的灾民生活凄惨。","source":{"text":"鸿雁于飞，哀鸣嗸嗸。","book":"《诗经·小雅·鸿雁》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“～，此小民之失所；狡兔三窟，诮贪人之巧营。”"},"usage":"作宾语、定语；用于比喻句"},{"id":48889,"word":"鸿飞冥冥","pinyin":"hóng fēi míng míng","abbr":"hfmm","explanation":"冥冥：遥空。大雁飞向远空。比喻远走避祸。","source":{"text":"鸿飞冥冥，弋人何篡焉？","book":"汉·扬雄《法言·问明》"},"example":{"text":"康有为等早已避至六国饭店，俟军事粗定，溜出都门，～，弋人何篡，眼见是无从缉获了。","book":"蔡东藩、许廑父《民国通俗演义》八十七回"},"similar":["远走高飞","逃之夭夭"],"usage":"作谓语；比喻远走避祸"},{"id":48890,"word":"鸿飞冥冥，弋人何慕","pinyin":"hóng fēi míng míng，yì rén hé mù","abbr":"hfmmyrhm","explanation":"冥冥：高远；弋人：射猎的人。大雁飞向远空，猎人没法得到。比喻隐者远走高飞，全身避害。或比喻隐者的高远踪迹。","source":{"text":"不然如两生、四皓、伏生之流，鸿飞冥冥，弋人何慕，肯摇唇鼓吻，自投于陷穽哉！","book":"元·陶宗仪《南村辍耕录·论秦蜀》"},"similar":["鸿飞冥冥，弋人何篡"],"usage":"作宾语、定语；用于书面语"},{"id":48891,"word":"鸿飞冥冥，弋人何篡","pinyin":"hóng fēi míng míng，yì rén hé cuàn","abbr":"hfmmyrhc","explanation":"冥冥：远空；弋人：猎人；篡：非法夺取，此指猎取。大雁飞向远空，猎人就无法获得它了。比喻远走避祸。","source":{"text":"鸿飞冥冥，弋人何篡焉？","book":"汉·扬雄《法言·问明》"},"example":{"text":"康有为等早已避至六国饭店，俟军事粗定，溜出都门，～，眼见是无从缉获了。","book":"蔡东藩、许廑父《民国通俗演义》第八十七回"},"similar":["鸿飞冥冥，弋人何慕"],"usage":"作宾语、定语；用于书面语"},{"id":48892,"word":"鸿飞雪爪","pinyin":"hóng fēi xuě zhǎo","abbr":"hfxz","explanation":"用以指世事变易。","source":{"text":"人生到处知何似，应似飞鸿踏雪泥，泥上偶然留爪印，鸿飞那复计东西。","book":"宋·苏轼《和子由渑池怀旧》"},"example":{"text":"阑干酬拍，～，往事难留。","book":"清·陈维崧《金菊对芙蓉·南归前一日侯氏堂中观演〈西厢记〉》词"},"similar":["鸿爪雪泥"],"usage":"作主语、宾语；指往事遗留的痕迹","story":["宋朝时期，苏轼与苏辙兄弟曾在渑池一寺院住过，与寺院老和尚关系很好，并在寺内墙上题诗。后苏轼故地重游作《和子由渑池怀旧》诗大发感慨：“人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。”"]},{"id":48893,"word":"鸿飞霜降","pinyin":"hóng fēi shuāng jiàng","abbr":"hfsj","explanation":"鸿雁为候鸟，每年深秋归飞，其时开始霜降，因用以指时序的变化和年岁的更换。"},{"id":48894,"word":"鸿鳦满纸","pinyin":"hóng yǐ mǎn zhǐ","abbr":"hymz","explanation":"形容书写潦草，随意涂抹。亦作“鸿乙满纸”。"},{"id":48895,"word":"鸿鴆满纸","pinyin":"hóng yǐ mǎn zhǐ","abbr":"hymz","explanation":"形容书写潦草，随意涂抹。亦作鸿乙满纸”。"},{"id":48896,"word":"鸿鶱凤立","pinyin":"hóng xiān fèng lì","abbr":"hxfl","explanation":"鸿鹄高飞，凤凰挺立。比喻超卓突出。","source":{"text":"鸿鶱凤立，不循常流。","book":"唐·李白《秋夜于安府送孟赞府兄还都序》"},"usage":"作谓语、定语；用于书面语"},{"id":48897,"word":"鸿鶱凤逝","pinyin":"hóng xiān fèng shì","abbr":"hxfs","explanation":"鸿鹄高飞，凤凰远逝。比喻毅然远行。","source":{"text":"年十三，让产伯兄，鸿鶱凤逝，去之无迹。","book":"清·龚自珍《海门先啬陈君祠堂碑文》"},"usage":"作谓语、定语；用于书面语"},{"id":48898,"word":"鸿鷑凤立","pinyin":"hóng xiān fèng lì","abbr":"hxfl","explanation":"鸿鹄高飞，凤凰挺立。比喻超卓突出。","source":{"text":"鸿鷑凤立，不循常流。","book":"唐·李白《秋夜于安府送孟赞府兄还都序》"}},{"id":48899,"word":"鸿鷑凤逝","pinyin":"hóng xiān fèng shì","abbr":"hxfs","explanation":"鸿鹄高飞，凤凰远逝。比喻毅然远行。","source":{"text":"年十三，让产伯兄，鸿鷑凤逝，去之无迹。","book":"清·龚自珍《海门先啬陈君祠堂碑文》"}},{"id":48900,"word":"鸿鹄与鸡","pinyin":"hóng hú yǔ jī","abbr":"hgyj","explanation":"形容认真考察身边的有用之材。","source":{"text":"君尤贵之，以其所从来远也。臣请鸿鹄举矣。","book":"《新序·杂事第五》"},"usage":"作宾语、主语、定语；指人的区别","story":["田饶侍奉鲁哀公多年没有受到重用就对鲁哀公说要像鸿鹄那样远走高飞。鲁哀公不解。田饶婉转说：鸡虽然具有文、武、勇、仁、信五德，被你宰杀是因为离你近，而鸿鹄没有这五德，吞食您的五谷反而被您认为高贵，所以我要学鸿鹄高飞"]},{"id":48901,"word":"鸿鹄之志","pinyin":"hóng hú zhī zhì","abbr":"hgzz","explanation":"鸿鹄：天鹅，比喻志向远大的人；志：志向。比喻远大志向。","source":{"text":"嗟乎！燕雀安知鸿鹄之志哉！","book":"《吕氏春秋·士容》：“夫骥骜之气，鸿鹄之志，有谕乎人心者，诚也。”《史记·陈涉世家》"},"example":{"text":"大丈夫仗～，据英杰之才。","book":"元·郑德辉《王粲登楼》第一折"},"similar":["雄心壮志","胸怀大志"],"opposite":["碌碌无为","无所事事","胸无大志"],"usage":"作主语、宾语；指大志","story":["秦朝末年，老百姓生活在水深火热之中，阳城雇农陈胜在劳作休息时说：“各位兄弟，将来富贵了不能相互忘记。”其他雇农笑他无知。陈胜叹气道：“燕子与麻雀是不可能知道鸿鹄的远大志向的。”"]},{"id":48902,"word":"鸿鹄将至","pinyin":"hóng hú jiāng zhì","abbr":"hhjz","explanation":"鸿鹄：天鹅。天鹅马上就要飞来了。指学习不专心。现表示将有所得。","source":{"text":"使奕秋诲二人奕，其一人专心致志，惟奕秋之为听。一人虽听之，一心以为有鸿鹄将至，思援弓缴而射之，虽与之俱学，弗若之矣。","book":"《孟子·告子上》"},"example":{"text":"世不可半途而废，蹈为山九仞之辙；更不可见异而迁，萌～之心。","book":"清·无名氏《照世杯》四"},"usage":"作宾语、定语；指学习不专心"},{"id":48903,"word":"鸿鹄高翔","pinyin":"hóng hú gāo xiáng","abbr":"hggx","explanation":"鸿鹄：天鹅。像天鹅那样飞得又高又远。比喻人的志向远大。","source":{"text":"鸿鹄高飞，一举千里。","book":"《史记·留侯世家》"}},{"id":48904,"word":"鸿鹄高飞，一举千里","pinyin":"hóng hú gāo fēi，yī jǔ qiān lǐ","abbr":"hggfyjql","explanation":"鸿鹄：天鹅。天鹅高高飞翔，一飞千里。指人有雄才大略。","source":{"text":"鸿鹄高飞，一举千里。","book":"西汉·司马迁《史记·留侯世家》"},"usage":"作宾语、分句；指人有雄才大略","story":["西汉时期，刘邦当上皇帝后立吕后的儿子刘盈为太子，因为宠幸戚夫人而想改立刘如意为太子。吕后听从张良的主意，让太子刘盈请出商山四位贤士。刘邦看到太子有商山四贤辅佐，羽翼已成，对戚夫人唱道：“鸿鹄高飞，一举千里。羽挧已就，横绝四海。"]},{"id":48905,"word":"鹄峙鸾停","pinyin":"hú zhì luán tíng","abbr":"hzlt","explanation":"形容人仪态端庄，姿容秀美。","source":{"text":"看他眉儿秀，额儿嶢，鹄峙鸾停一俊髦。","book":"明无名氏《四贤记·会母》"},"similar":["鸾停鹄峙"],"usage":"作宾语、定语；用于比喻句"},{"id":48906,"word":"鹄峙鸾翔","pinyin":"hú zhì luán xiáng","abbr":"hzlx","explanation":"形容笔势挺拔而飘逸。","source":{"text":"迨后羲献齐名，喜行间之萦蛇绾蚓；柳颜并著，惊纸上之鹄峙鸾翔。","book":"清蒲松龄《拟上万几之暇临摹法书特赐诸臣御书各一幅群臣谢表》"},"usage":"作宾语、定语；用于比喻句"},{"id":48907,"word":"鹄形菜色","pinyin":"hú xíng cài sè","abbr":"gxcs","explanation":"形容面黄肌瘦的样子。","source":{"text":"塞上孑遗，鹄形菜色，相从沟壑者亦比比也。","book":"明卢象昇《经理崇祯十一年屯政疏》"},"example":{"text":"有些人衣衫褴褛，～，像叫化子一样。","book":"陈残云《山谷风烟》第二三章。"},"similar":["面黄肌瘦"],"usage":"作谓语、定语；指人的脸色"},{"id":48908,"word":"鹄形鸟面","pinyin":"hú xíng niǎo miàn","abbr":"gxnm","explanation":"指饥疲瘦削的样子。","source":{"text":"岁复荐饥，侯加意抚恤，向之逃亡者，鹄形鸟面，争出供役。","book":"明归有光《送宋知县序》"},"similar":["鹄面鸟形","鹄面鸠形"],"usage":"作宾语、状语；指人的外形憔悴"},{"id":48909,"word":"鹄面鸟形","pinyin":"hú miàn niǎo xíng","abbr":"gmnx","explanation":"鹄：天鹅。形容面容憔悴，身体瘦弱。","source":{"text":"死者蔽野，富室无食，皆鸟面鹄形。","book":"《南史·侯景传》：“死者涂地……其绝粒久者鸟面鹄形。”《资治通鉴·梁纪·简文帝大宝元年》"},"example":{"text":"扶羸载瘠总南逋，～犹努力。","book":"元·王恽《入奏行》"},"similar":["鹄形鸟面"],"usage":"作宾语、状语；指人的外形憔悴"},{"id":48910,"word":"鹄面鸠形","pinyin":"hú miàn jiū xíng","abbr":"gmjx","explanation":"①面容枯樵，形体瘦削。形容饥疲的样子。②指枯樵瘦削的人。","source":{"text":"小怨必报，何不大用于断头饮血之元凶；私恩必酬，何不广用于鹄面鸠形之赤子。","book":"《明史·忠义传七·耿廷箓》"},"example":{"text":"熏天毒雾白昼黑，～奔络绎。","book":"清李光昭《阿芙蓉歌》"},"similar":["鹄形鸟面","鹄面鸟形"],"usage":"作宾语、定语；指人的外形憔悴"},{"id":48911,"word":"鹅存礼废","pinyin":"é cún lǐ fèi","abbr":"eclf","explanation":"存：保存。指古代礼节形式已经消亡，仅存食物。","source":{"text":"如今却把这奠雁的古制化雅为俗，差个家人送来，叫作通信，这就叫做鹅存礼废。","book":"清·文康《儿女英雄传》第27回"},"usage":"作宾语、定语；指已经名不副实了"},{"id":48912,"word":"鹅毛大雪","pinyin":"é máo dà xuě","abbr":"emdx","explanation":"像鹅毛一样的雪花。形容雪下得大而猛。","source":{"text":"可怜今夜鹅毛雪，引得高情鹤氅人。","book":"唐·白居易《雪夜喜李郎中见访》"},"example":{"text":"不一会，又变成～，真是瞬息万变。","book":"田国浩《六月雪》"},"usage":"作主语、宾语；形容大雪"},{"id":48913,"word":"鹅湖之会","pinyin":"é hú zhī huì","abbr":"ehzh","explanation":"比喻具有开创性的辩论会。","source":{"text":"南宋淳熙二年（1175年）在信州（今江西上饶）鹅湖寺举行的一次著名的哲学辩论会。由吕祖谦邀集，意图调和朱熹和陆九渊两派争执。实质上是朱的客观唯心主义和陆的主观唯心主义的一场争论。它是中国哲学史上一次堪称典范的学术讨论会，首开书院会讲之先河。"}},{"id":48914,"word":"鹅王择乳","pinyin":"é wáng zé rǔ","abbr":"ewzr","explanation":"比喻择其上乘精华。","source":{"text":"《宗镜》删订，非鹅王择乳不能具此心眼。","book":"水乳同置一器，鹅王仅饮乳汁而留其水。事见《祖庭事苑》卷五。清·钱谦益《与素华禅师书》"},"example":{"text":"鹅王为择乳，鸡粒莫相争。","book":"清·查慎行《鹤雏和院长作》"},"usage":"作宾语、定语；用于做事"},{"id":48915,"word":"鹅笼书生","pinyin":"é lóng shū shēng","abbr":"elss","explanation":"比喻幻中生幻，变化无常。","source":{"text":"晋·荀氏《灵鬼志》"}},{"id":48916,"word":"鹅行鸭步","pinyin":"é xíng yā bù","abbr":"exyb","explanation":"步：走。象鹅和鸭子那样的走路。比喻步行缓慢。","source":{"text":"见一人光纱帽，黑布衫，鹰头雀脑将身探，狼心狗行潜踪阚，鹅行鸭步怀愚滥。","book":"元·杨景贤《西游记·妖猪幻惑》"},"example":{"text":"你两个闲常在镇里抬轿时，只是～，如今却怎地这等走得快？","book":"明·施耐庵《水浒全传》第三十二回"},"similar":["蜗行牛步"],"opposite":["大步流星"],"usage":"作宾语、定语、补语；比喻步行缓慢"},{"id":48917,"word":"鹊反鸾惊","pinyin":"què fǎn luán jīng","abbr":"qflj","explanation":"形容字写得神采飞动，如盘旋往复的鹊鸟和鸾鸟。同“鹊返鸾回”。"},{"id":48918,"word":"鹊垒巢鸠","pinyin":"què lěi cháo jiū","abbr":"qlcj","explanation":"本喻女子出嫁，住在夫家。后比喻强占别人的房屋、土地、妻室等。同“鹊巢鸠居”。","source":{"text":"有甚仇，无端暗把机锋构，硬将人排挤，叫把鹊垒巢鸠。","book":"清·李渔《慎鸾交·贿篾》"},"similar":["鹊巢鸠占","鹊巢鸠据"],"usage":"作宾语、定语；用于比喻句"},{"id":48919,"word":"鹊巢知风","pinyin":"què cháo zhī fēng","abbr":"qczf","explanation":"喜鹊在窝里知道将要和风。比喻人有预见性。也比喻能预见远患而看不到近忧。","source":{"text":"鹊巢知风之所起，獭穴知水之高下，晖目知晏，阴谐知雨，为是谓人智不如鸟兽，则不然。","book":"《淮南子·缪称训》"},"example":{"text":"～起，獭穴知水生。","book":"明·杨慎《升庵诗话》卷一"}},{"id":48920,"word":"鹊巢鸠主","pinyin":"què cháo jiū zhǔ","abbr":"qcjz","explanation":"本喻女子出嫁，住在夫家。后比喻强占别人的房屋、土地、妻室等。同“鹊巢鸠居”。","source":{"text":"费商量、虎威狐假，鹊巢鸠主。","book":"清·蒋士铨《贺新凉·再叠韵束心斋》"},"similar":["鹊巢鸠占"],"usage":"作宾语、补语、定语；指占有别人的东西"},{"id":48921,"word":"鹊巢鸠佔","pinyin":"què cháo jiū zhàn","abbr":"qcjz","explanation":"本喻女子出嫁，住在夫家。后比喻强占别人的房屋、土地、妻室等。同“鹊巢鸠居”。"},{"id":48922,"word":"鹊巢鸠占","pinyin":"què cháo jiū zhàn","abbr":"qcjz","explanation":"斑鸠不会做窠，常强占喜鹊的窠。本指女子出嫁，定居于夫家。后比喻强占别人的住处。","source":{"text":"维鹊有巢，维鸠居之。","book":"《诗经·召南·鹊巢》"},"example":{"text":"验先朝牒状，红泥出印床，无奈～，不认关防。","book":"清·蒋士铨《第二碑·题坊》"},"similar":["鹊巢鸠居"],"usage":"作宾语、补语；指占有别人的东西","story":["我国最早的诗歌总集《诗经》中讲到鹊巢鸠占的事情，原诗《召南·鹊巢》如下：“维鹊有巢，维鸠居之；之子于归，百辆御之。维鹊有巢，维鸠方之；之子于归，百辆将之。维鹊有巢，维鸠盈之；之子于归，百辆成之。”"]},{"id":48923,"word":"鹊巢鸠居","pinyin":"què cháo jiū jū","abbr":"qcjj","explanation":"本喻女子出嫁，住在夫家。后比喻强占别人的房屋、土地、妻室等。","source":{"text":"维鹊有巢，维鸠居之。","book":"《诗经·召南·鹊巢》"},"example":{"text":"虽已经过了一个短时期，然而‘～’，现在有人补缺了。","book":"李六如《六十年的变迁》第二卷第九章"},"similar":["鹊巢鸠占","鹊巢鸠踞"],"usage":"作宾语、补语；指占有别人的东西","story":["我国最早的诗歌总集《诗经》中讲到鹊巢鸠占的事情，原诗《召南·鹊巢》如下：“维鹊有巢，维鸠居之；之子于归，百辆御之。维鹊有巢，维鸠方之；之子于归，百辆将之。维鹊有巢，维鸠盈之；之子于归，百辆成之。”"]},{"id":48924,"word":"鹊巢鸠据","pinyin":"què cháo jiū jù","abbr":"qcjj","explanation":"本喻女子出嫁，住在夫家。后比喻强占别人的房屋、土地、妻室等。同“鹊巢鸠居”。","source":{"text":"维雀有巢，维鸠居上。","book":"《诗经·召南·鹊巢》"},"example":{"text":"夫～，事理本然。","book":"清·纪昀《阅微草堂笔记·如是我闻二》"},"similar":["鹊巢鸠居","鹊巢鸠占"],"usage":"作宾语、补语；指占有别人的东西"},{"id":48925,"word":"鹊巢鸠踞","pinyin":"què cháo jiū jù","abbr":"qcjj","explanation":"本喻女子出嫁，住在夫家。后比喻强占别人的房屋、土地、妻室等。同“鹊巢鸠居”。","source":{"text":"甚至鹊巢鸠踞，故为失昼之枭，蛇与龟盘，反作旁观之鳖。","book":"清·黄六鸿《福惠全书·奸情总论》"},"similar":["鹊巢鸠据","鹊巢鸠主"],"usage":"作宾语、补语、定语；指占有别人的东西"},{"id":48926,"word":"鹊桥相会","pinyin":"què qiáo xiāng huì","abbr":"qqxh","explanation":"鹊桥：古代民间传说阴历七月初七晚上喜鹊在银河上搭桥，让牛郎、织女在桥上相会。比喻情人或夫妻久别之后的团聚。","source":{"text":"今日云耕渡鹊桥，应非脉脉与迢迢。","book":"唐·权德舆《七夕》"}},{"id":48927,"word":"鹊笑鸠舞","pinyin":"què xiào jiū wǔ","abbr":"qxjw","explanation":"喜鹊欢叫，斑鸠飞舞。旧时用作喜庆的祝辞。","source":{"text":"鹊笑鸠舞，来遗我酒。","book":"汉·焦延寿《易林》卷六"},"usage":"作谓语；用作喜庆的祝辞"},{"id":48928,"word":"鹊返鸾回","pinyin":"què fǎn luán huí","abbr":"qflh","explanation":"形容字写得神采飞动，如盘旋往复的鹊鸟和鸾鸟。","source":{"text":"我无鹊返鸾回字，我无金章玉句子。","book":"宋·杨万里《谢胡子远郎中惠蒲大韶墨报以龙涎心字香》"},"usage":"作定语、状语；用于比喻句"},{"id":48929,"word":"鹍鹏得志","pinyin":"kūn péng dé zhì","abbr":"kpdz","explanation":"鹍鹏：传说中的极大的鱼和鸟。比喻有大志的人得到施展的机会。","source":{"text":"您端的似鹍鹏得志秋云长。","book":"元·关汉卿《陈母教子》第一折"},"usage":"作宾语、定语；指人成功"},{"id":48930,"word":"鹏抟九天","pinyin":"péng tuán jiǔ tiān","abbr":"ptjt","explanation":"抟：盘旋；九天：高空。比喻人奋发有为。","source":{"text":"神鹰梦泽，不顾鸱鸢。为君一击，鹏抟九天。","book":"《庄子·逍遥游》：“鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里。”唐·李白《独漉篇》"}},{"id":48931,"word":"鹏抟鹢退","pinyin":"péng tuán huā tuì","abbr":"ptyt","explanation":"喻指宦海的浮沉，仕途的进退。","source":{"text":"鹏抟，出《庄子·逍遥游》；鹢退，出《左传·僖公十六年》“六鹢退飞过宋都”。"},"example":{"text":"余以馀生颓景，尸居假息，亦不复知海内故人～，近作何状。","book":"清·钱谦益《陈昌箕记诗叙》"},"usage":"作谓语、定语；用于书面语"},{"id":48932,"word":"鹏游蝶梦","pinyin":"péng yóu dié mèng","abbr":"pydm","explanation":"指变幻夸诞之谈。","source":{"text":"《庄子·逍遥游》载鲲化为鹏徙于南溟之事，又《齐物论》载庄周梦为胡蝶之事。"},"example":{"text":"昨夜又迟黄石，今朝重叩鸿濛。碧桃花下醉相逢。说尽～。","book":"宋·刘辰翁《忆秦娥·忆仙》词"},"usage":"作宾语、定语；用于书面语"},{"id":48933,"word":"鹏程万里","pinyin":"péng chéng wàn lǐ","abbr":"pcwl","explanation":"相传鹏鸟能飞万里路程。比喻前程远大。","source":{"text":"鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里。","book":"《庄子·逍遥游》"},"example":{"text":"俺也曾蠹简三冬依雪聚，怕不的～信风扶。","book":"元·无名氏《渔樵记》第一折"},"similar":["前程万里","前程似锦"],"opposite":["走投无路","日暮途穷"],"usage":"作谓语、宾语；指前程远大","story":["战国时期道家代表庄周在《庄子·逍遥游》中记载：北方大海里有种很大的鱼叫“鲲”，时间长了就变成很大的鸟叫“鹏”，它的翅膀像天上的云彩那么大，一飞起来就是九万里高，后来飞到南海里去了"]},{"id":48934,"word":"鹏路翱翔","pinyin":"péng lù áo xiáng","abbr":"plax","explanation":"鹏路：远大前程；翱翔：飞翔。比喻人奋进在远大前程上。","source":{"text":"柴荆寄乐土，鹏路观翱翔。","book":"唐·杜甫《入衡州》诗"},"usage":"作谓语；用于祝愿等"},{"id":48935,"word":"鹏霄万里","pinyin":"péng xiāo wàn lǐ","abbr":"pxwl","explanation":"比喻前程远大。","source":{"text":"献替频陈忠誉播，鹏霄万里展雄飞。","book":"南唐·李中《献张拾遗》诗"},"similar":["鹏程万里"],"opposite":["走投无路","日暮途穷"],"usage":"作谓语、宾语；指前程远大"},{"id":48936,"word":"鹏鴳齐致","pinyin":"péng yàn qí zhì","abbr":"pyqz","explanation":"鹏：鹏鸟；鴳：即鷃雀，小鸟，飞不到一尺高。指两种不同的事物一并而来。","source":{"text":"鹏鴳齐致，江湖两忘。","book":"唐·杨炯《从弟溢墓志铭》"}},{"id":48937,"word":"鹑居鷇食","pinyin":"chún jū kòu shí","abbr":"cjks","explanation":"鷇：待母哺食的幼鸟，它不挑拣食物。如鹌鹑一样居无定所，象幼雏一样饥不择食。比喻生活俭朴，不求享受。","source":{"text":"夫圣人鹑居而鷇食，鸟行而无彰。","book":"《庄子·天地》"},"similar":["鹑居鷇饮"],"usage":"作宾语、定语；指生活俭朴"},{"id":48938,"word":"鹑居鷇饮","pinyin":"chún jú kòu yǐn","abbr":"cjky","explanation":"比喻生活俭朴，不求享受。同“鹑居鷇食”。","source":{"text":"鹑居鷇饮，不殊于羽族。","book":"《隋书·薛道衡传》"},"similar":["鹑居鷇食"],"usage":"作宾语、定语；指生活俭朴"},{"id":48939,"word":"鹑衣百结","pinyin":"chún yī bǎi jié","abbr":"cybj","explanation":"鹑：鹌鹑鸟；结：悬挂连缀。鹌鹑的尾巴短而秃，象打满补丁一样。形容衣服非常破烂。","source":{"text":"子夏贫，衣若县鹑。","book":"《荀子·大略》"},"example":{"text":"～走风尘，落魄谁怜此一身？","book":"清·程麟《此中人语·乞丐风流》"},"similar":["衣衫蓝缕","覆穿踵决"],"opposite":["衣冠楚楚"],"usage":"作谓语、定语、补语；比喻衣服破烂"},{"id":48940,"word":"鹑衣鷇食","pinyin":"chún yī kòu shí","abbr":"cyks","explanation":"指衣不蔽体，食不果腹。形容生活极端贫困。","source":{"text":"籍名收养，多至数千馀人，岁费当若干！此外，又有舍饭，而鹑衣鷇食，扶携颠连，号呼衢路者，犹然在也。","book":"明·沈榜《宛署杂记·养济院》"},"similar":["鹑居鷇食"],"usage":"作宾语、定语；用于生活贫困"},{"id":48941,"word":"鹑衣鹄面","pinyin":"chún yī hú miàn","abbr":"cygm","explanation":"破烂的衣服，瘦削的面形。形容穷苦落魄之状。","source":{"text":"尝见某者，鹑衣鹄面，行泮宫前。","book":"清·捧花生《画舫馀谭》"},"usage":"作谓语、定语；用于人落魄"},{"id":48942,"word":"鹑鹊之乱","pinyin":"chún què zhī luàn","abbr":"cqzl","explanation":"鹑：鹌鹑；鹊：喜鹊。鹌鹑与喜鹊的乱交。指亲人之间的乱伦。","source":{"text":"那夜，武三思候父母睡着，悄悄挨进媚娘房中，成了鹑鹊之乱。","book":"清·褚人获《隋唐演义》第70回"},"usage":"作宾语；指乱伦"},{"id":48943,"word":"鹓动鸾飞","pinyin":"yuān dòng luán fēi","abbr":"ydlf","explanation":"鹓、鸾在传说中都是瑞鸟。比喻高贵的人。","example":{"text":"～一词很少在现代汉语中出现。"},"usage":"作主语、宾语、定语；用于书面语"},{"id":48944,"word":"鹓班鹭序","pinyin":"yuān bān lù xù","abbr":"yblx","explanation":"鹓鹭飞行皆有行序。比喻百官朝见时非常有秩序。","source":{"text":"北面并臣肩，共事春丁荣典，趋跑环佩，鹓班鹭序。","book":"清·孔尚任《桃花扇·哄丁》"},"example":{"text":"北面并臣肩，共事春丁荣典；趋跄环佩，～旋转。","book":"清·孔尚任《桃花扇·哄丁》"},"similar":["鹓鹭成行"],"usage":"作宾语、定语；用于比喻句"},{"id":48945,"word":"鹓鹭成行","pinyin":"yuān lù chéng háng","abbr":"ylch","explanation":"鹓鹭飞行皆有行序。比喻百官朝见时非常有秩序。","source":{"text":"怀黄绾白，鹓鹭成行。","book":"《隋书·音乐志》"},"example":{"text":"嵩呼万岁欢，～拥百官。","book":"《清史稿·乐志四》"},"similar":["鹓班鹭序"],"usage":"作宾语、定语；用于比喻句"},{"id":48946,"word":"鹗心鹂舌","pinyin":"è xīn lí shé","abbr":"exls","explanation":"鹗：鱼鹰；鹂：黄莺。比喻嘴甜心狠，阴险狡诈。","source":{"text":"这绍闻当不住鹗心鹂舌的话。","book":"清·李绿园《歧路灯》第72回"},"usage":"作定语；指人很阴险"},{"id":48947,"word":"鹘仑吞枣","pinyin":"hú lún tūn zǎo","abbr":"gltz","explanation":"把枣子整个儿吞下，不细嚼辨味。常比喻在学习上食而不化，不加分析。","source":{"text":"今动不动便先说个本末精粗无二致，正是鹘仑吞枣。","book":"宋·朱熹《答许顺之书》"},"similar":["囫囵吞枣"],"usage":"作谓语、宾语、状语；形容读书不认真"},{"id":48948,"word":"鹘入鸦群","pinyin":"hú rù yā qún","abbr":"gryq","explanation":"鹘：同“隼”，一种凶猛的大鸟。比喻骁勇无敌。","source":{"text":"尔击贼如鹘入鸦群，宜思好事。","book":"《北齐书·南安王思好传》"},"example":{"text":"左盘右射红尘中，～有谁敌。","book":"唐·韩翃《寄哥舒仆射》诗"},"usage":"作宾语；指人很勇敢"},{"id":48949,"word":"鹡鸰在原","pinyin":"xià líng zài yuán","abbr":"jlzy","explanation":"亦作“脊令”。比喻兄弟友爱之情。","source":{"text":"脊令在原，兄弟急难。","book":"《诗·小雅·常棣》"}},{"id":48950,"word":"鹤乘轩","pinyin":"hè chéng xuān","abbr":"hcx","explanation":"卫懿公让鹤乘坐大夫坐的车子。比喻滥用官位，滥竽充数。","source":{"text":"卫懿公好鹤，鹤有乘轩者。","book":"春秋·鲁·左丘明《左传》"},"usage":"作宾语、定语；指人滥竽充数","story":["公元前668年，卫惠公的儿子姬赤成为卫懿公后，不思富国强兵之道，整天喜欢养鹤，甚至荒唐到给鹤封官位，享官禄，专门把大夫乘坐的车子给鹤乘坐。百姓怨声载道。北方狄国借机出兵攻打卫国，卫国士兵根本不抵抗就逃散，卫懿公被狄兵所杀"]},{"id":48951,"word":"鹤亦败道","pinyin":"hè yì bài dào","abbr":"hybd","explanation":"仙鹤败坏仙道。指万物皆遵循一定的客观规律，不以人的意志为转移。","source":{"text":"渊材嗟咨曰：‘鹤亦败道！’","book":"《冷斋夜话》"},"usage":"作宾语、定语；用于书面语","story":["刘渊材性情迂腐又好怪诞，他家养两只鹤，每当客人到来均要夸耀它们是仙鹤，是胎生动物。园丁跑来报告鹤夜里下了一个大蛋，让刘渊材羞愧难当，于是跑去看，果见鹤又下了一个蛋。刘渊材只好自我解嘲地说：“仙鹤也败坏仙道。”"]},{"id":48952,"word":"鹤势螂形","pinyin":"hè shì láng xíng","abbr":"hslx","explanation":"指腰肢纤袅，体态轻盈。","source":{"text":"[湘云]腰里紧紧束着一条蝴蝶结子长穗五色宫绦，脚下也穿着鹿皮小靴：越显得蜂腰猿背，鹤势螂形。","book":"《红楼梦》第四九回"},"similar":["蜂腰猿背"],"usage":"作宾语、定语；用于比喻句"},{"id":48953,"word":"鹤发松姿","pinyin":"hè fà sōng zī","abbr":"hfsz","explanation":"白色的头发，松树的姿态。形容人虽老犹健。","source":{"text":"千章古木散岩谷，鹤发松姿馀典刑。","book":"金·元好问《紫微刘丈山水为济川赋》诗"},"usage":"作宾语、定语；用于老年人"},{"id":48954,"word":"鹤发童颜","pinyin":"hè fà tóng yán","abbr":"hfty","explanation":"仙鹤羽毛般雪白的头发，儿童般红润的面色。形容老年人气色好。","source":{"text":"自言非神亦非仙，鹤发童颜古无比。","book":"唐·田颖《梦游罗浮》"},"example":{"text":"（华佗）童颜鹤发，飘然有出世之姿。","book":"明·罗贯中《三国演义》第十五回"},"similar":["返老还童","老当益壮"],"opposite":["未老先衰","老态龙钟"],"usage":"作谓语、定语；指老年人"},{"id":48955,"word":"鹤发鸡皮","pinyin":"hè fà jī pí","abbr":"hfjp","explanation":"鹤发：白发；鸡皮：形容皮肤有皱纹。皮肤发皱，头发苍白。形容老人年迈的相貌。","source":{"text":"刻木牵丝作老翁，鸡皮鹤发与真同。","book":"北周·庾信《竹杖赋》：“子老矣，鹤发鸡皮，蓬头历齿。”唐玄宗《傀儡吟》"},"example":{"text":"于禅堂中见一老尼，～。","book":"明·张岱《越山五佚记·吼山》"},"usage":"作谓语、定语；形容老人年迈的相貌"},{"id":48956,"word":"鹤吊陶母","pinyin":"hè diào táo mǔ","abbr":"hdtm","explanation":"白鹤吊唁陶侃之母。指吊丧。","source":{"text":"忽有二客来吊，不哭而退，仪服鲜异，知非常人，遣随视之，但见双鹤冲天而去。","book":"南朝·宋·刘义庆《世说新语·贤媛》"},"usage":"作宾语、定语；指吊丧","story":["晋朝时期，孝廉范逵赴京上任，路过陶侃家。陶母剪下长发卖钱来招待客人，让范逵深受感动，就举荐陶侃为广州刺史。陶侃当官后，十分孝顺母亲。母亲去世时，陶侃在墓前守候，见两个衣着鲜艳的人来拜祭，他暗中察看，两人化鹤冲天而去"]},{"id":48957,"word":"鹤唳华亭","pinyin":"hè lì huá tíng","abbr":"hlht","explanation":"表现思念、怀旧之意。亦为慨叹仕途险恶、人生无常之词。","source":{"text":"陆平原河桥败，为卢志所谗，被诛。临刑叹曰：‘欲闻华亭鹤唳，可复得乎！’","book":"南朝·宋·刘义庆《世说新语·尤悔》"},"example":{"text":"但～，贵何似贱，珠沉金谷，富不如贫。","book":"宋·刘辰翁《沁园春·再和槐城自寿韵》词"},"usage":"作谓语；表现思念、怀旧之意"},{"id":48958,"word":"鹤唳猿声","pinyin":"hè lì yuán shēng","abbr":"hlys","explanation":"鹤鸣猿啼。形容凄清孤寂的景象。","source":{"text":"早除却花魔酒病，惯闻他鹤唳猿声，守清夜药垆丹鼎。","book":"明·梅鼎祚《玉合记·酧负》"},"usage":"作宾语、定语；用于书面语"},{"id":48959,"word":"鹤唳风声","pinyin":"hè lì fēng shēng","abbr":"hlfs","explanation":"唳：鸟鸣。听到风声和鹤叫声，都疑心是追兵。形容人在惊慌时疑神疑鬼。","source":{"text":"闻风声鹤唳，皆以为王师已至。","book":"《晋书·谢玄传》"},"example":{"text":"忙追去，片甲莫教除，～，元兵胆碎。","book":"明·周履靖《锦笺记·败北》"},"similar":["风声鹤唳"],"usage":"作宾语；同“风声鹤唳”","story":["东晋时期，前秦国王苻坚企图消灭东晋，东晋宰相谢安派谢石为征讨大都督，分兵三路夹击秦军。苻坚登上寿阳城，看见晋君阵容整齐有些畏惧。晋军用计围攻苻坚的秦军，秦军大败，在溃逃的过程中听到风声或鹤叫声，都以为是追兵"]},{"id":48960,"word":"鹤困鸡群","pinyin":"hè kùn jī qún","abbr":"hkjq","explanation":"比喻才能出众的人沦落于平庸之辈当中。","source":{"text":"苟得其人，必破优伶之格以待之，不则鹤困鸡群，与侪众无异。","book":"清·李渔《闲情偶寄·演习·教白》"},"usage":"作宾语、定语；用于比喻句"},{"id":48961,"word":"鹤处鸡群","pinyin":"hè chǔ jī qún","abbr":"hcjq","explanation":"比喻一个人的仪表或才能在周围一群人里显得很突出。同“鹤立鸡群”。","source":{"text":"遥望而清风宛在，鹤处鸡群；近观而光彩射人，龙来洞口。","book":"《敦煌变文集·维摩诘经讲经文》"},"example":{"text":"鲲为鱼队潜鳞困，～病翅低。","book":"唐·郑启《严塘经乱书事》诗"},"similar":["鹤立鸡群"],"usage":"作宾语、定语、状语；指出众"},{"id":48962,"word":"鹤子梅妻","pinyin":"hè zǐ méi qī","abbr":"hzmq","explanation":"指宋隐士林逋以鹤为子、以梅为妻事。亦喻指妻子儿女。","source":{"text":"若比孤山林处士，但非鹤子梅妻。","book":"清·董以宁《河满子·同程村闲话》词"},"example":{"text":"健儿拥护出京都，～又橘奴。","book":"清·复侬氏等《都门纪变百咏》之六四"},"similar":["梅妻鹤子"],"usage":"作宾语、定语；指隐士的生活"},{"id":48963,"word":"鹤归华表","pinyin":"hè guī huá biǎo","abbr":"hghb","explanation":"感叹人世的变迁。","source":{"text":"丁令威，本辽东人，学道于灵虚山。後化鹤归辽，集城门华表柱。时有少年，举弓欲射之。鹤乃飞，徘徊空中而言曰：‘有鸟有鸟丁令威，去家千年今始归。城郭如故人民非，何不学仙冢垒垒。’遂高上冲天。","book":"晋·陶潜《搜神後记》卷一"},"example":{"text":"念亲恩主德总来难报，须教，枕戈汗马，努力塞云边草，儿时得功成大漠，～。","book":"明·屠隆《昙花记·公子受封》"},"usage":"作宾语、定语；用于感叹人生","story":["传说古代辽东人丁令威在灵虚山学道，后来道成化鹤飞回辽东，落在城门华表柱上，当时一个少年见到想举弓射之。鹤立即飞向天空徘徊，作诗：“有鸟有鸟丁令威，去家千年今始归。城郭如故人民非，何不学仙冢累累。”然后高飞而去"]},{"id":48964,"word":"鹤怨猿啼","pinyin":"hè yuàn yuán tí","abbr":"hyyt","explanation":"形容凄凉悲惨的场景。多用以指战乱、灾祸后哀鸿遍野的凄惨景象。","source":{"text":"锦树莺嘲蝶弄，翠萝鹤怨猿啼。","book":"元·张可久《木兰花慢》词"},"example":{"text":"牢着眼看鸟飞兔走，急回头怕～。","book":"明·陶宗仪《南村辍耕录·连枝秀》"}},{"id":48965,"word":"鹤怨猿惊","pinyin":"hè yuàn yuán jīng","abbr":"hyyj","explanation":"形容对官场厌倦，有意归隐的心情。","source":{"text":"三径初成，鹤怨猿惊，稼轩未来。","book":"宋·辛弃疾《沁园春·带湖新居将成》词"},"example":{"text":"搔首倚薰风，一幅画图尘土中。～人去也，潜龙。谁绞香车起蛰松。","book":"宋·王奕《南乡子·和谢潜庵蒋山》词"},"usage":"作宾语、定语；用于比喻句"},{"id":48966,"word":"鹤知夜半","pinyin":"hè zhī yè bàn","abbr":"hzyb","explanation":"鹤夜半而鸣。比喻各有专长。也比喻偏知一隅。","source":{"text":"鸡知将旦，鹤知夜半，而不免于鼎俎。","book":"《淮南子·说山训》"},"example":{"text":"适偶有所偏解，犹～，燕知戊己，而示必达于他事也。","book":"晋·葛洪《抱朴子·至理》"},"usage":"作宾语、定语；用于书面语"},{"id":48967,"word":"鹤短凫长","pinyin":"hè duǎn fú cháng","abbr":"hdfc","explanation":"比喻颠倒是非，妄加评论。","source":{"text":"凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"《庄子·骈拇》"},"example":{"text":"且齐之年世不可屈，而燕独可屈，～，妄分厚薄，又何理也？","book":"清·魏源《孟子年表考第二》"},"usage":"作宾语、定语；用于评论事物"},{"id":48968,"word":"鹤立企伫","pinyin":"hè lì qǐ zhù","abbr":"hlqz","explanation":"企：踮起脚后跟；伫：久立而等待。像鹤一样伸长脖子，踮起脚跟，长时间地站着等待。形容急切的盼望等待。","source":{"text":"窃所独守，实怀鹤立企伫之心。","book":"《三国志·魏志·陈思王植传》"},"usage":"作定语；用于书面语"},{"id":48969,"word":"鹤立鸡群","pinyin":"hè lì jī qún","abbr":"hljq","explanation":"象鹤站在鸡群中一样。比喻一个人的仪表或才能在周围一群人里显得很突出。","source":{"text":"嵇延祖卓卓如野鹤之在鸡群。","book":"晋·戴逵《竹林七贤论》：“嵇绍入洛，或谓王戎曰：‘昨于稠人中始见嵇绍，昂昂然若野鹤之在鸡群。’”南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"正在谈论，谁知女儿国王忽见林之洋杂在众人中，如～一般。","book":"清·李汝珍《镜花缘》第三十九回"},"similar":["出类拔萃","超群绝伦"],"opposite":["相形见绌","滥竽充数"],"usage":"作宾语、定语、状语；指出众","story":["三国时期魏国文学家嵇康的儿子嵇绍很有才学，身材魁梧，仪表堂堂。他无论在哪里都显得超群。有人对王戎说他在人群中就像一只仙鹤站在鸡群里那样突出。司马衷继位后，他担任侍中，为保护卫惠帝而战死，赢得人们的尊敬"]},{"id":48970,"word":"鹤算龟龄","pinyin":"hè suàn guī líng","abbr":"hsgl","explanation":"算：数。比喻人的寿命很长。","source":{"text":"但愿鹤算龟龄，地久天长。","book":"明·胡文焕《群音类选·》"},"similar":["龟鹤之年","龟龄鹤算","龟鹤遐寿"],"usage":"作宾语、定语；用于祝寿等"},{"id":48971,"word":"鹤背扬州","pinyin":"hè bèi yáng zhōu","abbr":"hbyz","explanation":"比喻利欲之心。","source":{"text":"有客相从，各言所志：或原为扬州刺史，或原多赀财，或原骑鹤上升，其一人曰：‘腰缠十万贯，骑鹤上扬州。’欲兼三者。","book":"南朝·梁·殷芸《小说》卷六"},"example":{"text":"无愿何求，笑时人～。","book":"元·王德信《集贤宾·退隐》套曲"},"similar":["骑鹤上扬州"],"usage":"作谓语、宾语；指人贪心","story":["传说古代赵钱孙李四公子在扬州痩西湖畔饮酒谈志向，赵某说自己有幸结识朋友，但愿能混个扬州刺史。孙某则想骑上红顶白羽的仙鹤去琼楼玉宇渡余生。李某说要腰缠十万贯，骑上仙鹤去扬州赴任。众人戏他性急喝不得热粥"]},{"id":48972,"word":"鹤膝蜂腰","pinyin":"hè xī fēng yāo","abbr":"hxfy","explanation":"①这是指诗歌声律八病的两种。泛指诗歌声律上所犯的毛病。②书法中的两种病笔。","source":{"text":"三曰蜂腰，第二字不得与第五字同声……四曰鹤膝，第五字不得与第十五字同声。","book":"宋·魏庆之《诗人玉屑·诗病·诗病有八》"},"example":{"text":"近来诗思殊无況，苦被时流不相放。云腾浪走势未衰，～岂能障。","book":"唐·李渤《喜弟淑再至为长歌》"},"similar":["蜂腰鹤膝"],"usage":"作宾语、定语；多用于比喻句"},{"id":48973,"word":"鹤行鸡群","pinyin":"hè xíng jī qún","abbr":"hxjq","explanation":"比喻一个人的仪表或才能在周围一群人里显得很突出。同“鹤立鸡群”。","source":{"text":"君才最高峙，鹤行鸡群中。","book":"宋·苏辙《次韵子瞻感旧见寄》"},"similar":["鹤立鸡群"],"usage":"作宾语、定语、状语；指出众"},{"id":48974,"word":"鹤长凫短","pinyin":"hè cháng fú duǎn","abbr":"hcfd","explanation":"比喻事物各有特点。","source":{"text":"凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"《庄子·骈拇》"},"example":{"text":"～不能齐，到头来不知谁是谁。","book":"元·吕止庵《集贤宾·叹世》套曲"},"usage":"作宾语、定语；用于处事"},{"id":48975,"word":"鹤骨松姿","pinyin":"hè gǔ sōng zī","abbr":"hgsz","explanation":"清奇不凡的气质。多指修道者的形貌。","source":{"text":"鹤骨松姿又一奇，化身千亿更无疑。","book":"金·元好问《普照范炼师写真》诗之三"},"example":{"text":"操请人。见其人～，形貌苍古。问之，乃京兆人也，隐居终南山。","book":"《三国演义》第五九回"},"usage":"作宾语、定语；用于比喻句"},{"id":48976,"word":"鹤骨松筋","pinyin":"hè gǔ sōng jīn","abbr":"hgsj","explanation":"指修道者的形貌气质。","source":{"text":"鹤骨松筋风貎殊，不言名姓绝荣枯。","book":"前蜀·贯休《遇道者》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":48977,"word":"鹤骨霜髯","pinyin":"hè gǔ shuāng rán","abbr":"hgsr","explanation":"瘦骨白须。形容年老。","source":{"text":"鹤骨霜髯心已灰，青松合抱手亲栽。","book":"宋·苏轼《赠岭老人》诗"},"usage":"作宾语、定语；用于老年人"},{"id":48978,"word":"鹤骨鸡肤","pinyin":"hè gǔ jī fū","abbr":"hgjf","explanation":"伶仃瘦骨，多皱的皮肤。形容年老。","source":{"text":"鹤骨鸡肤不耐寒，那堪癣疥更斑烂。","book":"宋·王炎《病中书怀》诗"},"example":{"text":"你看这位～，腰弯背驼，其貎不扬吧，那唱的可是正经的‘杨派’。","book":"《小说月报》1984年第10期"},"usage":"作宾语、定语；用于老年人"},{"id":48979,"word":"鹤骨龙筋","pinyin":"hè gǔ lóng jīn","abbr":"hglj","explanation":"指瘦挺虬曲的样子。","source":{"text":"道人手种几生前，鹤骨龙筋尚宛然。","book":"宋·苏轼《孤山二咏·柏堂》"},"usage":"作宾语、定语；用于比喻句"},{"id":48980,"word":"鹤鸣之叹","pinyin":"hè míng zhī tàn","abbr":"hmzt","explanation":"旧时比喻有才德、有名望而而没有出来作官的人，不能为当权者所重用的慨叹。","source":{"text":"留神万机，诚慎拜爵，减省献御，损节征发，令野无鹤鸣之叹。","book":"《后汉书·杨震传》"}},{"id":48981,"word":"鹤鸣之士","pinyin":"hè míng zhī shì","abbr":"hmzs","explanation":"指有才德声望的隐士。","source":{"text":"鹤鸣在阴，其子和之；我有好爵，吾与尔靡之。","book":"《周易·中孚》"},"example":{"text":"惟陛下慎经典之诫，图变复之道。斥远佞巧之臣，速征～。","book":"《后汉书·杨赐传》"},"usage":"作主语、宾语；指有才德声望的隐士"},{"id":48982,"word":"鹤鸣九皋","pinyin":"hè míng jiǔ gāo","abbr":"hmjg","explanation":"九皋：深泽。鹤鸣于湖泽的深处，它的声音很远都能听见。比喻贤士身隐名著。","source":{"text":"鹤鸣于九皋，声闻于野。","book":"《诗经·小雅·鹤鸣》"},"example":{"text":"～，犹载厥声。况乃海隅，播名上京。","book":"晋·潘岳《为贾谧作赠陆机》诗"},"usage":"作宾语；指隐士"},{"id":48983,"word":"鹦鹉学舌","pinyin":"yīng wǔ xué shé","abbr":"ywxs","explanation":"鹦鹉学人说话。比喻人家怎么说，他也跟着怎么说。","source":{"text":"如鹦鹉只学人言，不得人意。经传佛意；不得佛意而但诵，是学语人，所以不许。","book":"宋·释道原《景德传灯录》卷二十八"},"example":{"text":"领导说什么，他就说什么，简直是～。"},"similar":["拾人牙慧"],"opposite":["独辟蹊径"],"usage":"作谓语、状语；指人云亦云"},{"id":48984,"word":"鹦鹉学语","pinyin":"yīng wǔ xué yǔ","abbr":"ywxy","explanation":"鹦鹉：一种能学人发音的鸟。鹦鹉模仿人学习讲话。比喻没有主见，人云亦云。亦作“鹦鹉学舌”。","source":{"text":"僧问：‘何故不许诵经，唤作客语？’师曰：‘如鹦鹉只学人言，不得人意。经传佛意，不得佛意而但诵，是学语人，所以不许。’","book":"《景德传灯录·越州大殊慧海和尚》"}},{"id":48985,"word":"鹦鹉能言","pinyin":"yīng wǔ néng yán","abbr":"ywny","explanation":"鹦鹉也能学人说话。比喻谨防走漏消息。","source":{"text":"鹦鹉能言，而不可使长。是何则？得其所言，而不得其所以言。","book":"《淮南子·说山训》"},"example":{"text":"乌龙未睡定惊猜，～防漏泄。","book":"宋·柳永《玉楼春》词"},"usage":"作宾语、定语；用于劝诫人"},{"id":48986,"word":"鹪巢蚊睫","pinyin":"jiāo cháo wén jié","abbr":"jcwj","explanation":"极言细微。鹪，通“焦”。指焦螟。","source":{"text":"公曰：‘天下有极细乎？’晏子对曰：‘有。东海有虫，巢于睫，再乳再飞，而不为惊。臣婴不知其名，而东海渔者命曰焦冥。’","book":"《晏子春秋·外篇下十四》"},"example":{"text":"柱国赵国公发言为论，下笔成章……论其壮也，则鹏起半天；语其细也，则～。","book":"北周·庚信《〈赵国公集〉序》"},"usage":"作宾语、定语；用于比喻句"},{"id":48987,"word":"鹪鹩一枝","pinyin":"jiāo liáo yī zhī","abbr":"jlyz","explanation":"鹪鹩：小鸟名，以麻发为窝，系于树枝。鹪鹩做窝，只占用一根树枝。比喻一个安身之处或一个工作位置。","source":{"text":"鹪鹩巢于深林，不过一枝；偃鼠饮河，不过满腹。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"暂足为寄足，有似～。","book":"清·程允升《幼学故事琼林·人事》"},"similar":["偃鼠饮河"],"usage":"作宾语、定语；比喻欲望有限，极为满足"},{"id":48988,"word":"鹬蚌持争，渔翁得利","pinyin":"yù bàng xiāng zhēng，yú wēng dé lì","abbr":"ybczywdl","explanation":"比喻双方争执不下，两败俱伤，让第三者占了便宜。","source":{"text":"蚌方出曝，而鹬啄其肉，蚌合而蘁其喙。鹬曰：‘今日不雨，明日不雨，即有死蚌。’蚌亦谓鹬曰：‘今日不出，明日不出，即有死鹬。’两者不肯相舍，渔者得而并禽之。","book":"《战国策·燕策二》"}},{"id":48989,"word":"鹬蚌相争","pinyin":"yù bàng xiāng zhēng","abbr":"ybxz","explanation":"“鹬蚌相争，渔翁得利”的省语。比喻双方相持不下，而使第三者从中得利。","source":{"text":"波翻血海全球悯，问谁敢野蛮法律骂强秦？笑他鹬蚌相争演出风云阵。","book":"清·湘灵子《轩亭冤·哭墓》"},"example":{"text":"清·湘灵子《轩亭冤·哭墓》：“波翻血海全球悯，问谁敢野蛮法律骂强秦？笑他鹬蚌相争演出风云阵。”"},"similar":["鹬蚌相危"],"usage":"作宾语、定语；用于处事"},{"id":48990,"word":"鹬蚌相争，坐收渔翁之利","pinyin":"yù bàng xiāng zhēng，zuò shōu yú wēng zhī lì","abbr":"ybxzzsywzl","explanation":"鹬：长嘴水鸟；蚌：有贝壳的软体动物。比喻双方争执不下，两败俱伤，让第三者占了便宜","source":{"text":"俟关中平定，据险养威，看他鹬蚌相争，坐收渔翁之利，也不为迟呢？","book":"蔡东藩《唐史演义》第三回"},"similar":["鹬蚌相争，渔人获利"],"usage":"作宾语、定语；用于劝诫人"},{"id":48991,"word":"鹬蚌相争，渔人获利","pinyin":"yù bàng xiāng zhēng，yú rén huò lì","abbr":"ybxzyrhl","explanation":"鹬：长嘴水鸟；蚌：有贝壳的软体动物。比喻双方争执不下，两败俱伤，让第三者占了便宜","source":{"text":"西汉·刘向《战国策·燕策二》：“而鹬啄其肉，蚌合而钳其喙。鹬曰：‘今日不雨，明日不雨，即有死蚌。’蚌亦曰：‘今日不雨，明日不雨，即有死鹬。’两者不肯相舍，渔者得而并禽。"},"example":{"text":"梁启超《新中国未来记》第三回：“这越发～，外国乘势诱胁，那瓜分政策，更是行所无事。”"},"similar":["鹬蚌相争，渔翁得利"],"usage":"作谓语、定语；用于劝诫人","story":["战国时期，赵国准备攻打燕国，燕王派苏代去赵国游说赵王不要战争，讲述一只河蚌在岸上夹住一只鹬鸟的长嘴，双方争执不让，最后被一个渔翁轻易擒住。如果燕赵发生战争，秦国就像渔翁那样轻易吞并燕赵。赵王只好放弃战争的打算"]},{"id":48992,"word":"鹬蚌相争，渔翁得利","pinyin":"yù bàng xiāng zhēng，yú wēng dé lì","abbr":"ybxzywdl","explanation":"鹬：长嘴水鸟；蚌：有贝壳的软体动物。比喻双方争执不下，两败俱伤，让第三者占了便宜。","source":{"text":"西汉·刘向《战国策·燕策二》：“而鹬啄其肉，蚌合而钳其喙。鹬曰：‘今日不雨，明日不雨，即有死蚌。’蚌亦曰：‘今日不雨，明日不雨，即有死鹬。’两者不肯相舍，渔者得而并禽。"},"example":{"text":"～留给我们的启示意义深刻。"},"similar":["渔人得利","两败俱伤","从中渔利"],"opposite":["相辅相成","相得益彰"],"usage":"作谓语、定语；用于劝诫人","story":["战国时期赵国准备攻打燕国，燕王派苏代去赵国游说赵王不要战争，讲述一只河蚌在岸上夹住一只鹬鸟的长嘴，双方争执不让，最后被一个渔翁轻易擒住。如果燕赵发生战争，秦国就像渔翁那样轻易吞并燕赵。赵王只好放弃战争的打算"]},{"id":48993,"word":"鹬蚌相危","pinyin":"yù bàng xiāng wēi","abbr":"ybxw","explanation":"比喻双方相持不下，而使第三者从中得利。","source":{"text":"鹬蚌相危，我乘其弊。","book":"北齐·魏收《为东魏檄梁文》"},"similar":["鹬蚌相斗","鹬蚌相争"],"usage":"作宾语、定语；用于处事"},{"id":48994,"word":"鹬蚌相持","pinyin":"yù bàng xiāng chí","abbr":"ybxc","explanation":"《战国策·燕策二》记载：蚌张开壳晒太阳，鹬去啄它，嘴被蚌壳夹住，两方都不相让。渔翁来后把两个都捉住。比喻双方争执两败俱伤，便宜第三者。","source":{"text":"权待他鹬蚌相持俱毙日，也等咱渔人含笑再中兴。","book":"元·尚仲贤《气英布》第二折"},"example":{"text":"～，自己渔人得利。","book":"明·冯梦龙《醒世恒言·乔太守乱点鸳鸯谱》"},"similar":["鹬蚌相争"],"opposite":["相辅相成"],"usage":"作宾语、定语；指两者相争","story":["战国时期赵国准备攻打燕国，燕王派苏代去赵国游说赵王不要战争，讲述一只河蚌在岸上夹住一只鹬鸟的长嘴，双方争执不让，最后被一个渔翁轻易擒住。如果燕赵发生战争，秦国就像渔翁那样轻易吞并燕赵。赵王只好放弃战争的打算"]},{"id":48995,"word":"鹬蚌相持，渔人得利","pinyin":"yù bàng xiāng chí，yú rén dé lì","abbr":"ybxcyrdl","explanation":"比喻双方相持不下，而使第三者从中得利。","source":{"text":"《战国策·燕策二》记载：蚌张开壳晒太阳，鹬去啄它，嘴被蚌壳夹住，两方面都不相让。渔翁来了，把两个都捉住了。"},"example":{"text":"这真叫做‘～’。若是倪善继存心忠厚，兄弟和睦，肯将家私平等分析，这千两黄金，弟兄大家该五百两，怎到得滕大尹之手？","book":"《古今小说·滕大尹鬼断家私》"},"similar":["鹬蚌相持，渔翁得利"],"usage":"作谓语、定语；用于劝诫人","story":["战国时期，赵国准备攻打燕国，燕王派苏代去赵国游说赵王不要战争，讲述一只河蚌在岸上夹住一只鹬鸟的长嘴，双方争执不让，最后被一个渔翁轻易擒住。如果燕赵发生战争，秦国就像渔翁那样轻易吞并燕赵。赵王只好放弃战争的打算"]},{"id":48996,"word":"鹬蚌相持，渔翁得利","pinyin":"yù bàng xiāng chí，yú wēng dé lì","abbr":"ybxcywdl","explanation":"比喻双方争执不下，两败俱伤，让第三者占了便宜。","source":{"text":"蚌方出曝……蚌合而钳其喙。鹬曰：‘今日不雨，明日不雨，即有死蚌。’蚌亦曰：‘今日不雨，明日不雨，即有死鹬。’两者不肯相舍，渔者得而并禽。","book":"西汉·刘向《战国策·燕策》"},"example":{"text":"我们要记住“～”的道理，不能让他享渔人之利。"},"similar":["鹬蚌相争，渔翁得利"],"opposite":["相辅相成"],"usage":"作谓语、定语；用于劝诫人","story":["战国时期，赵国准备攻打燕国，燕王派苏代去赵国游说赵王不要战争，讲述一只河蚌在岸上夹住一只鹬鸟的长嘴，双方争执不让，最后被一个渔翁轻易擒住。如果燕赵发生战争，秦国就像渔翁那样轻易吞并燕赵。赵王只好放弃战争的打算"]},{"id":48997,"word":"鹬蚌相斗","pinyin":"yù bàng xiāng dòu","abbr":"ybxd","explanation":"比喻双方相持不下，而使第三者从中得利。","source":{"text":"要之蛮触相争，原无关于轻重，鹬蚌相斗，要自互有损伤。","book":"清·百一居士《壶天录》卷下"},"similar":["鹬蚌相危","鹬蚌相争"],"usage":"作宾语、定语；用于处事"},{"id":48998,"word":"鹭序鸳行","pinyin":"lù xù yuān xíng","abbr":"lxyx","explanation":"白鹭、鸳鸯群飞有序。比喻百官上朝时的行列。","source":{"text":"悲伤，鹭序鸳行，怎如乌鸟反哺能终养？","book":"元本高明《琵琶记·伯喈思家》"},"similar":["鹭序鹓行"],"usage":"作宾语、定语；用于比喻句"},{"id":48999,"word":"鹭序鹓行","pinyin":"lù xù yuān xíng","abbr":"lxyx","explanation":"比喻百官上朝时的行列。同“鹭序鸳行”。","source":{"text":"这须是野鸥席上，又不比鹭序鹓行。","book":"明·郑须德《真傀儡》"},"similar":["鹭序鸳行"],"usage":"作宾语、定语；用于比喻句"},{"id":49000,"word":"鹭朋鸥侣","pinyin":"lù péng ōu lǚ","abbr":"lpol","explanation":"指与鹭、鸥为友。比喻隐居生活。","source":{"text":"指与鹭、鸥为友。比喻隐居生活。"},"example":{"text":"宋·方岳《送史子贯归觐且迎妇也》诗：“久住西湖梦亦佳，鹭朋鸥侣自烟沙。”"},"usage":"作宾语；指隐居"},{"id":49001,"word":"鹭约鸥盟","pinyin":"lù yuē ōu méng","abbr":"lyom","explanation":"指与鹭、鸥相约结盟。比喻隐居者的生活。","source":{"text":"一堤风月，六桥烟水，鹭约鸥盟在。","book":"宋·高观国《青玉案》词"},"usage":"作宾语、定语；用于书面语"},{"id":49002,"word":"鹯视狼顾","pinyin":"zhān shì láng gù","abbr":"zslg","explanation":"指如同鹯狼视物。形容目光贪婪。","source":{"text":"其余锋捍特起，鹯视狼顾，争为袅雄者，不可胜数。","book":"汉·陈琳《檄吴将校部曲文》"},"usage":"作谓语、定语；用于比喻句"},{"id":49003,"word":"鹰击毛挚","pinyin":"yīng jī máo zhì","abbr":"yjmz","explanation":"击：搏击；挚：凶猛。鸷鸟扑击其他动物时，羽毛都张着。比喻严酷凶悍。","source":{"text":"而纵以鹰击毛挚为治。","book":"《史记·酷吏列传》"},"usage":"作宾语；指人"},{"id":49004,"word":"鹰击长空","pinyin":"yīng jī cháng kōng","abbr":"yjck","explanation":"指雄鹰振翅飞翔于辽阔的天空。亦比喻有雄心壮志的人在广阔的领域中施展自己的才能。","source":{"text":"鹰击长空，鱼翔浅底，万类霜天竞自由。","book":"毛泽东《沁园春·长沙》词"}},{"id":49005,"word":"鹰化为鸠，众鸟犹恶其眼","pinyin":"yīng huà wéi jiū，zhòng niǎo yóu wù qí yǎn","abbr":"yhwjznyeqy","explanation":"鸠：斑鸠；憎：憎恨。鹰变化为斑鸠，其他的斑鸠仍厌恶它的目光。比喻外表变化，凶恶的本性不改，仍遭厌恶","source":{"text":"鹰化为鸠，至于识者犹憎其眼。","book":"南朝·宋·刘义庆《世说新语·方正》"},"similar":["鹰化为鸠，犹憎其眼"],"usage":"作宾语、定语；用于书面语"},{"id":49006,"word":"鹰化为鸠，犹憎其眼","pinyin":"yīng huà wéi jiū，yóu zēng qí yǎn","abbr":"yhwjyzqy","explanation":"鸠：鸽子一类的鸟；憎：憎恨。即使老鹰变成了鸠鸟，众鸟仍然讨厌其眼睛。比喻外表虽然有所改变，但改变不了其凶恶本性。","source":{"text":"虽阳和布气，鹰化为鸠，至于识者，犹憎其眼。","book":"南朝·宋·刘义庆《世说新语·方正》"},"similar":["鹰化为鸠，众鸟犹恶其眼"],"usage":"作宾语、定语；用于书面语"},{"id":49007,"word":"鹰嘴鹞目","pinyin":"yīng zuǐ yào mù","abbr":"yzym","explanation":"形容外貌奸诈凶狠。","source":{"text":"那老头有五个儿子,个个鹰嘴鹞目如狼似虎。","book":"于劭溯《月落屋梁》"},"example":{"text":"他长着一幅～的嘴脸。"},"similar":["鹰鼻鹞眼"],"usage":"作宾语、定语、状语；指坏人的嘴脸"},{"id":49008,"word":"鹰头之蝇","pinyin":"yīng tóu zhī yíng","abbr":"ytzy","explanation":"老鹰头上的苍蝇。旧比喻倚仗帝王权势擅自作威作福的小人。","source":{"text":"君侧之人，众所畏惧，所谓鹰头之蝇、庙垣之鼠者也。","book":"《新唐书·魏元忠传》"}},{"id":49009,"word":"鹰头雀脑","pinyin":"yīng tóu què nǎo","abbr":"ytqn","explanation":"形容相貌丑陋而神情狡猾。","source":{"text":"见一人光纱帽，黑布衫，鹰头雀脑将身探。","book":"元·杨暹《西游记》第四本第十三出"},"usage":"作宾语、定语、状语；用于书面语"},{"id":49010,"word":"鹰心雁爪","pinyin":"yīng xīn yàn zhǎo","abbr":"yxyz","explanation":"比喻心灵手快。","source":{"text":"你待要使用金银，打通关节，救拔囚牢，则俺燕青呵！须不是鹰心雁爪，早跳出虎穴狼巢。","book":"元·李文蔚《燕青博鱼》第四折"},"usage":"作宾语、定语；用于比喻句"},{"id":49011,"word":"鹰扬虎噬","pinyin":"yīng yáng hǔ shì","abbr":"yyhs","explanation":"如鹰飞扬，似虎噬咬。形容耀武扬威，穷凶极恶。","source":{"text":"散散、王士宏等，不体圣天子抚绥元元之意，鹰扬虎噬，雷厉风飞。","book":"明·陶宗仪《辍耕录·阑驾上书》"},"usage":"作宾语、定语；用于比喻句"},{"id":49012,"word":"鹰扬虎视","pinyin":"yīng yáng hǔ shì","abbr":"yyhs","explanation":"象鹰那样飞翔，如虎一般雄视。形容十分威武。","source":{"text":"虎视耽耽，其欲逐逐。","book":"《诗经·大雅·大明》：“维师尚父，时维鹰扬。”《周易·颐》"},"example":{"text":"王肃以宿德显授，何曾以后进见拔，皆～，有万里之望。","book":"三国·魏·应璩《与侍郎曹长思书》"},"usage":"作谓语、定语；指人威武"},{"id":49013,"word":"鹰拿燕雀","pinyin":"yīng ná yàn què","abbr":"ynyq","explanation":"比喻捉拿毫不费力。","source":{"text":"士真分付把李参军拿下。左右就在席上，如鹰拿雁雀，楸了下来听令。士真道：‘且收郡狱！’左右即牵了李参军衣袂，付在狱中，来回话了。","book":"明·凌濛初《初刻拍案惊奇》卷三十"},"example":{"text":"他使出了～的招式。"},"usage":"作宾语、定语；指毫不费力"},{"id":49014,"word":"鹰拿雁捉","pinyin":"yīng ná yàn zhuō","abbr":"ynyz","explanation":"比喻缉捕时的快速凶猛。","source":{"text":"圣旨一下，早有锦衣卫官已将窦国一、宋信鹰拿雁捉的拖了出来。","book":"《平山冷燕》第五回"},"similar":["鹰拿燕雀"],"usage":"作定语；比喻捉拿毫不费力"},{"id":49015,"word":"鹰挚狼食","pinyin":"yīng zhì láng shí","abbr":"yzls","explanation":"比喻凶狠地攫取和吞没。"},{"id":49016,"word":"鹰撮霆击","pinyin":"yīng cuō tíng jī","abbr":"yctj","explanation":"像老鹰攫食，雷霆猛击。形容气势威猛。"},{"id":49017,"word":"鹰派人物","pinyin":"yīng pài rén wù","abbr":"yprw","explanation":"采取好战态度并且拥护直接强硬行动的人。比喻立场强硬，行动直接，且好战、勇猛。","example":{"text":"美国的～都是好战分子。"},"usage":"作宾语、定语；指好战分子"},{"id":49018,"word":"鹰犬之任","pinyin":"yīng quǎn zhī rèn","abbr":"yqzr","explanation":"鹰犬：猎人驯养的鹰与猎犬。可以任用之为鹰犬。旧指为君主尽忠的重任。","source":{"text":"臣无清高之行，横蒙鹰犬之任。","book":"《后汉书·酷吏传·阳球》"}},{"id":49019,"word":"鹰犬之才","pinyin":"yīng quǎn zhī cái","abbr":"yqzc","explanation":"鹰犬：猎人驯养的鹰与猎狗，打猎时用于追捕猎物。用作鹰犬之才。比喻供驱使、能出力的人。","source":{"text":"幕府董统鹰扬，埽夷凶逆，续遇董卓侵官暴国，于是提剑挥鼓，发命东夏，广罗英雄，弃瑕录用，故遂与操参咨策略，谓其鹰犬之才，爪牙可任。","book":"汉·陈琳《为袁绍传檄各州郡文》"},"example":{"text":"方今多士盈朝，当择贤者居其任，奈何以弦歌～侍侧，至令致此？乃陛下训导不足，岂太子之罪耶！","book":"《旧唐书·李纲传》"}},{"id":49020,"word":"鹰犬之用","pinyin":"yīng quǎn zhī yòng","abbr":"yqzy","explanation":"鹰犬：猎人驯养的鹰与猎犬。起到鹰犬的作用。旧指为君主尽忠。","source":{"text":"臣龟蒙恩累世，驰骋边垂，虽展鹰犬之用，顿毙胡虏之庭，魂骸不返，荐享狐狸，犹无以塞厚责，荅万分也。","book":"《后汉书·陈龟传》"},"example":{"text":"臣承指授，效～耳，有何勋劳而恃功肆意，宁敢昧利而违圣诏。","book":"《晋书·王濬传》"}},{"id":49021,"word":"鹰犬塞途","pinyin":"yīng quǎn sāi tú","abbr":"yqst","explanation":"鹰犬：打猎时追捕禽兽的鹰和猎犬，比喻爪牙；塞：堵塞；途：道路。坏人的爪牙塞满道路。","source":{"text":"这是后来和现在的话，当时可不然，鹰犬塞途，干儿当道，魏忠贤不是活着就配享了孔庙么？","book":"鲁迅《伪自由书·文章与题目》"},"similar":["豺狼当道"],"usage":"作谓语、定语；指豺狼当道"},{"id":49022,"word":"鹰睃狼顾","pinyin":"yīng suō láng gù","abbr":"yslg","explanation":"形容目光锐利，为人狠戾。同“鹰视狼顾”。","source":{"text":"鹰睃狼顾为非善，柳黛蛾眉杀气横。","book":"《天雨花》第二一回"},"similar":["鹰视狼顾"],"usage":"作谓语、定语；用于为人"},{"id":49023,"word":"鹰瞵虎攫","pinyin":"yīng lín hǔ jué","abbr":"ylhj","explanation":"形容心怀不善，伺机攫取。同“鹰瞵虎视”。","source":{"text":"列强鹰瞵虎攫，日追一日，动辄以兵事相恐吓。","book":"赵汉卿《宣言书》"},"similar":["鹰瞵虎视"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":49024,"word":"鹰瞵虎视","pinyin":"yīng lín hǔ shì","abbr":"ylhs","explanation":"像鹰和虎一样凶狠贪婪地注视着。形容心怀不善，伺机攫取。","source":{"text":"俄罗斯政府，以鹰瞵虎视之势，震慑五陆，而其人民称罪恶之府，黑暗无复天日，（日本人有《露西亚亡国论》，穷形尽相。）亦生计沈窘之影响也。","book":"梁启超《论私德》二"},"example":{"text":"张继煦《叙论》：“～者数强国，四顾皇皇，无所用其武。”"},"similar":["鹰瞵虎攫"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":49025,"word":"鹰瞵鹗视","pinyin":"yīng lín è shì","abbr":"yles","explanation":"鹰、鹗：两种猛禽；瞵：眼光闪闪地看。形容用凶狠的目光盯视着。","source":{"text":"狂  犷狯，鹰瞵鹗视。","book":"晋·左思《吴都赋》"},"example":{"text":"其中最活跃的是有几位没有制服的外国巡捕，两手都握着手枪，～地东奔西突。","book":"郭沫若《创造十年续篇》四"},"similar":["鹰觑鹘望"],"usage":"作定语、状语；指人的目光"},{"id":49026,"word":"鹰视狼步","pinyin":"yīng shì láng bù","abbr":"yslb","explanation":"象鹰那样看东西，象狼那样走路。形容为人阴险狠毒。","source":{"text":"夫越王为人，长颈鸟喙，鹰视狼步，可以共患难，而不可共处乐，可与履危，不可与安。","book":"汉·赵晔《吴越春秋·勾践伐吴外传》"},"example":{"text":"司马懿～，不可付与兵权，久必为国家之大祸。","book":"明·罗贯中《三国演义》第九十一回"},"similar":["鹰视虎步"],"usage":"作定语、宾语；指人举止"},{"id":49027,"word":"鹰视狼顾","pinyin":"yīng shì láng gù","abbr":"yslg","explanation":"形容目光锐利，为人狠戾。","source":{"text":"司马懿鹰视狼顾，不可付以兵权；久必为国家大祸。","book":"明·罗贯中《三国演义》第九十一回"},"example":{"text":"袁世凯～，久蓄逆谋，故景月汀谓其为仲达第二。","book":"溥伟《让国御前会议日记》"},"similar":["鹰睃狼顾"],"usage":"作谓语、定语；用于为人"},{"id":49028,"word":"鹰视虎步","pinyin":"yīng shì hǔ bù","abbr":"yshb","explanation":"象鹰那样看东西，象老虎那样走路。形容为人阴险狠毒。","source":{"text":"吾观喜之为人鹰视虎步，专功杀之性，不可亲也。","book":"汉·赵晔《吴越春秋·阖闾内传》"},"similar":["鹰视狼步"],"usage":"作定语、宾语；指人举止"},{"id":49029,"word":"鹰觑鹘望","pinyin":"yīng qù hú wàng","abbr":"yqhw","explanation":"觑：看；鹘：一种猛禽。目光像鹰、鹘一样，十分敏锐。形容视觉敏锐。","source":{"text":"崔生鹰觑鹘望，去门缝里一瞧，那笑的却是一个女孩儿，约有十六岁。","book":"明·冯梦龙《警世通言》卷三十"},"similar":["鹰瞵鹗视"],"usage":"作定语；形容视觉敏锐"},{"id":49030,"word":"鹰飞鱼跃","pinyin":"yīng fēi yú yuè","abbr":"yfyy","explanation":"老鹰飞，游鱼跳。形容自然界的活跃景象。","example":{"text":"青山不换绿常在，～会有时。"}},{"id":49031,"word":"鹰鼻鹞眼","pinyin":"yīng bí yào yǎn","abbr":"ybyy","explanation":"鹞：一种形体像鹰而比鹰小的凶猛的鸟，背灰褐色，以小鸟、小鸡为食。形容奸诈凶狠的相貌。","source":{"text":"我倒是觉得敬轩的那位摇鹅毛扇子的军师，生得鹰鼻子鹞眼，不是个善良家伙。","book":"姚雪垠《李自成》第十九章"},"example":{"text":"这个人～，一看就知道是恶人。"},"usage":"作宾语、定语；形容的外表"},{"id":49032,"word":"鹿伏鹤行","pinyin":"lù fú hè xíng","abbr":"lfhx","explanation":"像鹿那样潜伏，像鹤一样飞行。形容小心警惕的样子。","example":{"text":"瞧他那～的样子，真可笑。"},"usage":"作宾语、定语；用于比喻句"},{"id":49033,"word":"鹿死不择荫","pinyin":"lù sǐ bù zé yīn","abbr":"lsbzy","explanation":"比喻只求安身，不择处所。亦比喻情况危急，无法慎重考虑。","source":{"text":"见“鹿死不择音”。"},"example":{"text":"不则，职之重命，必且重于官，～，微臣有褫，无以加焉，在台台必有大不忍者。","book":"明·袁宏道《乞改稿三》"},"similar":["鹿死不择音"],"usage":"作宾语；比喻只求安身，不择地方"},{"id":49034,"word":"鹿死不择音","pinyin":"lù sǐ bù zé yīn","abbr":"lsbzy","explanation":"指庇荫的地方。音，通“荫”。比喻只求安身，不择处所。亦比喻情况危急，无法慎重考虑。","source":{"text":"又曰：‘鹿死不择音。’小国之事大国也，德，则其人也；不德，则其鹿也。铤而走险，急何能择。","book":"《左传·文公十七年》"},"example":{"text":"传称：‘～’，谨冒昧略上。","book":"《后汉书·皇甫规传》"},"similar":["鹿死不择荫"],"usage":"作宾语；比喻只求安身，不择地方"},{"id":49035,"word":"鹿死谁手","pinyin":"lù sǐ shuí shǒu","abbr":"lsss","explanation":"原比喻不知政权会落在谁的手里。现在也泛指在竞赛中不知谁会取得最后的胜利。","source":{"text":"朕若逢高皇，当北面而事之，与韩、彭鞭而争先耳；脱遇光武，当并驱于中原，未知鹿死谁手。","book":"《晋书·石勒载记下》"},"example":{"text":"古人把争天下比做“逐鹿中原”。也只有稳据中原，才能定～。","book":"姚雪垠《李自成》第二卷第四十七章"},"similar":["龙争虎斗","明争暗斗"],"opposite":["和衷共济","和平共处"],"usage":"作宾语；用于比赛","story":["晋朝时北方的五胡十六国中赵国国王石勒十分有才干，但自以为是，有一次他问大臣徐光他能与历史上哪位皇帝相提并论。徐光答复为汉高祖刘邦。他笑道他只能做刘邦的部下，但与刘秀并驱于中原，相互较量，那就不知鹿死谁手了"]},{"id":49036,"word":"鹿皮苍璧","pinyin":"lù pí cāng bì","abbr":"lpcb","explanation":"形容本末不相称。","source":{"text":"上（汉武帝）与汤（张汤）既造白鹿皮币，问异（颜异）。异曰：‘今王侯朝贺以仓璧，直数千，而其皮荐反四十万，本末不相称。’","book":"《汉书·食货志下》"},"example":{"text":"烟薰屋漏装玉轴，～知谁贤。","book":"宋·苏轼《仆曩于长安陈汉卿家见吴道子画佛碎烂可惜其后十馀年复见之于鲜于骏家则已装背完好子骏以见遗作诗谢之》"},"usage":"作宾语、定语；用于不协调的事物"},{"id":49037,"word":"鹿裘不完","pinyin":"lù qiú bù wán","abbr":"lqbw","explanation":"比喻检朴节俭。","source":{"text":"昔晏婴辅齐，鹿裘不完。","book":"《汉书·虞延传》"},"usage":"作谓语、定语；指生活节俭"},{"id":49038,"word":"鹿走苏台","pinyin":"lù zǒu sū tái","abbr":"lzst","explanation":"比喻国家败亡，宫殿荒废。","source":{"text":"臣今见麋鹿游姑苏之台也。","book":"《汉书·伍被传》"},"example":{"text":"不能勾鲸吞越国，翻教～，鸱泛江风。","book":"明 ·陈所闻《驻马听·吴山拜伍相庙》曲"},"usage":"作宾语；比喻国家败亡，宫殿荒废","story":["西汉时期，淮南王刘安想当皇帝，在东宫召见伍被一起议事，封伍被为将军。伍被说：“王安得亡国之言乎？昔子胥谏吴王，吴王不用，乃曰：‘臣今见麋鹿游姑苏之台也。’今臣亦将见宫中生荆棘，露沾衣也。”刘安不听劝阻，结果叛乱失败"]},{"id":49039,"word":"鹿车共挽","pinyin":"lù chē gòng wǎn","abbr":"lcgw","explanation":"鹿车：古时的一种小车；挽：拉。旧时称赞夫妻同心，安贫乐道。","source":{"text":"妻乃悉归侍御服饰，更著短布裳，与宣共挽鹿车归乡里。","book":"《后汉书·鲍宣妻传》"},"similar":["共挽鹿车"],"usage":"作谓语；用于夫妻"},{"id":49040,"word":"鹿驯豕暴","pinyin":"lù xùn shǐ bào","abbr":"lxsb","explanation":"意指一会儿像鹿一样柔驯，一会儿像猪一样凶暴。形容狡诈。"},{"id":49041,"word":"麇至沓来","pinyin":"qún zhì tà lái","abbr":"qztl","explanation":"犹言群集纷至。","source":{"text":"自登甲科、入仕版，蛇神牛鬼麇至沓来。","book":"清·魏秀仁《花月痕》第一回"},"similar":["纷至沓来"],"usage":"作谓语、定语；用于书面语"},{"id":49042,"word":"麇集蜂萃","pinyin":"qún jí fēng cuì","abbr":"jjfc","explanation":"麇：通“群”，成群；萃：汇集。像蜜蜂一样成群结队地聚集在一起。","source":{"text":"贼船自新洲大胜至七里洲，麇集蜂萃，莫纪其数。","book":"清·薛福成《书沔阳陆帅失陷江宁事》"},"usage":"作谓语、宾语、定语；用于聚会"},{"id":49043,"word":"麇骇雉伏","pinyin":"jūn hài zhì fú","abbr":"jhzf","explanation":"形容惊怕躲藏。麇，古书上指獐子。","source":{"text":"自关中薄青齐，南缭荆郢，北亘卫滑，皆麇骇雉伏，至千里无舍烟。","book":"《新唐书·秦宗权》"},"usage":"作宾语、状语；用于惊慌害怕等"},{"id":49044,"word":"麈尾之诲","pinyin":"zhǔ wěi zhī huì","abbr":"zwzh","explanation":"指高明的教诲。"},{"id":49045,"word":"麋沸蚁动","pinyin":"mí fèi yǐ dòng","abbr":"mfyd","explanation":"比喻社会秩序很乱。","source":{"text":"天下为之麋沸蚁动，云彻席卷。","book":"《淮志子·兵略训》"},"similar":["麋沸蚁聚"],"usage":"作谓语、定语；指社会动乱"},{"id":49046,"word":"麋沸蚁聚","pinyin":"mí fèi yǐ jù","abbr":"mfyj","explanation":"麋：通“糜”，粥；聚：会集。比喻社会局势动荡，纷乱不堪。","source":{"text":"无故移都，恐百姓惊动，麋沸蚁聚为乱。","book":"晋·陈寿《三国志·魏志·董卓传》裴松之注引华峤《汉书》"},"similar":["麋沸蚁动"],"usage":"作谓语、定语；指社会动乱"},{"id":49047,"word":"麋蒙虎皮，攻之者众","pinyin":"mí méng hǔ pí，gōng zhī zhě zhòng","abbr":"mmhpgzzz","explanation":"麋：麋鹿。麋鹿如果披上虎皮，攻击者比攻击真老虎还多。比喻诸侯掠取天子之位必然会引起众怒而群起攻之。","source":{"text":"臣请譬之，夫虎肉臊，其兵利身，人犹攻之也。若使泽中麋蒙虎之皮，人之攻必万于虎矣。","book":"《史记·楚世家》"}},{"id":49048,"word":"麒麒楦","pinyin":"qí lín xuàn","abbr":"qqx","explanation":"麒麒：传说中的一种代表吉祥的神兽；楦：楦头，楦鞭子用的木制模型，这里指驴子。指装扮成麒麒的驴子。形容徒有其表的人。","source":{"text":"唐杨炯每呼朝士为麒麒楦。","book":"唐·张鷟《朝野佥载》"}},{"id":49049,"word":"麒麟楦","pinyin":"qí lín xuàn","abbr":"qlx","explanation":"麒麟：传说的灵兽；楦：做鞋的木头模型，指驴子。假扮成麒麟的驴子。比喻虚有其表的人。","source":{"text":"忽思麒麟楦，突兀使人惊。","book":"宋·黄庭坚《山谷外集·次韵谢外舅食驴肠》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":49050,"word":"麒麟皮下","pinyin":"qí lín pí xià","abbr":"qlpx","explanation":"麒麒：传说中的一种代表吉祥的神兽；麒麒皮：喻指伪装。形容伪装之下的真实面目。","example":{"text":"我觉悟了，所以要常用，尤其是用于使～露出马脚。","book":"鲁迅《华盖集续编·我还不能“带住”》"}},{"id":49051,"word":"麒麟阁","pinyin":"qí lín gé","abbr":"qlg","explanation":"汉代阁名，供奉功臣。指卓越的功勋或最高的荣誉。","source":{"text":"今代麒麟阁，何人第一功。","book":"唐·杜甫《投赠哥舒开府翰》诗"},"usage":"作主语、宾语、定语；指最高荣誉"},{"id":49052,"word":"麕集蜂萃","pinyin":"qún jí fēng cuì","abbr":"jjfc","explanation":"麕：成群；萃：如草丛生。指聚集。","source":{"text":"贼船自新洲大胜关至七里洲，麕集蜂萃，莫纪其数。","book":"清·薛福成《书沔阳陆帅失陷江宁事》"}},{"id":49053,"word":"麟凤一毛","pinyin":"lín fèng yī máo","abbr":"lfym","explanation":"比喻好东西无论巨细都搜罗进来了。","source":{"text":"麟凤一毛，龟龙片甲，亦无所不录。。","book":"唐·张怀谨《书议》"},"usage":"作宾语、定语；用于比喻句"},{"id":49054,"word":"麟凤芝兰","pinyin":"lín fèng zhī lán","abbr":"lfzl","explanation":"麟凤：麒麟、凤凰，比喻高尚的人；芝兰：比喻才质之美。指人的品德高尚，气质优美。","source":{"text":"岂寻常等伦可比耶！故余每以麟凤芝兰拟之。","book":"明·李贽《焚书·杂说》"}},{"id":49055,"word":"麟凤龟龙","pinyin":"lín fèng guī lóng","abbr":"lfgl","explanation":"此四种神灵动物，象征吉兆。比喻稀有珍贵的东西。也比喻品格高尚、受人敬仰的人。","source":{"text":"麟凤龟龙，谓之四灵。","book":"《礼记·礼运》"},"example":{"text":"这四位仙长，乃～四灵之主。","book":"清·李汝珍《镜花缘》第一回"},"usage":"作宾语；比喻稀有珍贵的东西"},{"id":49056,"word":"麟子凤雏","pinyin":"lín zǐ fèng chú","abbr":"lzfc","explanation":"比喻贵族子孙或称誉佳子弟。","source":{"text":"麟子凤雏，生长家国。","book":"汉·焦延寿《易林》卷二"},"similar":["凤雏麟子"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":49057,"word":"麟肝凤髓","pinyin":"lín gān fèng suí","abbr":"lgfs","explanation":"麒麟的肝，凤凰的髓。比喻珍稀的食物。","source":{"text":"麟肝凤髓，不登于俎者，其唯蒋君乎！","book":"五代·王定保《唐摭言·载应不捷声价益振》"},"example":{"text":"真个鹿脯豹胎，～，无一不陈。","book":"清·何镛《乘龙佳话·宾筵》"},"similar":["龙肝凤髓"],"usage":"作主语、宾语；指珍贵的东西"},{"id":49058,"word":"麟角凤嘴","pinyin":"lín jiǎo fèng zuǐ","abbr":"ljfz","explanation":"嘴：鸟嘴。麒麟的角，凤凰的嘴。比喻稀罕名贵的东西。","source":{"text":"煮凤喙及麟角，合煎作膏，名之为续弦胶，或名连金泥。此胶能续弓驽已断之弦，刀剑断折之金。","book":"汉·东方朔《海内十洲记》"}},{"id":49059,"word":"麟角凤毛","pinyin":"lín jiǎo fèng máo","abbr":"ljfm","explanation":"麟的角，凤的毛。比喻稀有而又难得之人才或事物。","source":{"text":"龙驹汗血，麟角凤毛，跨灶文孙。","book":"元·王逢《奉寄兀颜子忠廉使》诗：“君侯素是骨鲠臣，麟角凤毛为世珍。”明·吾邱瑞《运甓记》第九出"},"example":{"text":"可惜这种个人捐献在我们国家里还只是～，还没蔚成风气。","book":"萧乾《一本褪色的相册·在康奈尔校园里》"},"similar":["麟角凤觜","凤毛麟角"],"usage":"作宾语、定语；指稀有之物"},{"id":49060,"word":"麟角凤觜","pinyin":"lín jiǎo fèng zuǐ","abbr":"ljfz","explanation":"觜：鸟嘴。麒麟的角，凤凰的嘴。比喻稀罕名贵的东西。","source":{"text":"煮凤喙及麟角，合煎作膏，名之为续弦胶，或名连金泥。此胶能续弓驽已断之弦，刀剑断折之金。","book":"汉·东方朔《海内十洲记》"},"example":{"text":"～世莫识，煎胶续弦奇自见。","book":"唐·杜甫《病后遇王倚饮赠歌》诗"},"similar":["凤毛麟角"],"usage":"作宾语；比喻稀罕名贵的东西"},{"id":49061,"word":"麟角凤距","pinyin":"lín jiǎo fèng jù","abbr":"ljfj","explanation":"距：鸟的脚爪。麒麟的角，凤凰的爪。比喻备而不必用的珍贵东西。","source":{"text":"距：鸟的脚爪。麒麟的角，凤凰的爪。比喻备而不必用的珍贵东西。"},"usage":"作主语、宾语；比喻备而不必用的珍贵东西"},{"id":49062,"word":"麟角虎翅","pinyin":"lín jiǎo hǔ chì","abbr":"ljhc","explanation":"麟之角，虎之翅。比喻世间不可多得的人才。","source":{"text":"府中从事杜与李，麟角虎翅相过摩。","book":"唐·李商隐《安平公诗》"},"usage":"作宾语、定语；用于比喻句"},{"id":49063,"word":"麟趾呈祥","pinyin":"lín zhǐ chéng xiáng","abbr":"lzcx","explanation":"旧时用于贺人生子。","source":{"text":"然则关雎麟趾之化，王者之风，故系之周公。","book":"《诗经·周南·关雎序》"},"example":{"text":"称人有令子，曰～。","book":"清·程允升《幼学琼林·祖孙父子》"},"similar":["龙凤呈祥"],"usage":"作宾语、定语；指子孙昌盛"},{"id":49064,"word":"麦丘之祝","pinyin":"mài qiū zhī zhù","abbr":"mqzz","explanation":"指直言之谏。","source":{"text":"忘其出位，贡此狂言，请赋《祈招》之诗，以代麦丘之祝。","book":"清·顾炎武《答徐甥公肃书》"},"example":{"text":"请接受我的～。"},"usage":"作宾语；指直言之谏","story":["春秋时期，齐桓公到麦丘，看到一个83岁的老人。桓公命令老人用他的高寿为桓公祝福。麦丘老人一祝主君高寿，金玉是贱人为宝；二祝主君无羞学，无恶下问，贤者在傍，谏者得人；三祝主君无得罪于臣下和百姓"]},{"id":49065,"word":"麦秀两岐","pinyin":"mài xiù liǎng qí","abbr":"mxlq","explanation":"岐，同“歧”。一株麦子长出两个穗子。为丰收之兆，多用来称颂吏治成绩卓著。同“麦秀两歧”。"},{"id":49066,"word":"麦秀两歧","pinyin":"mài xiù liǎng qí","abbr":"mxlq","explanation":"①一株麦子长出两个穗子。为丰收之兆，多用来称颂吏治成绩卓著。②唐教坊曲名。","source":{"text":"麦秀两歧，棠敷千里，治最当今黄颍川。","book":"《艺文类聚》卷十九引《东观汉记》：“张湛为渔阳太守，开田八千余顷，劝民耕种，以致殷富。百姓歌曰：桑无附枝，麦秀两歧，张君为政，乐不可欺。”宋·无名氏《沁园春》词"},"example":{"text":"乾兴元年五月，南剑州麦一本五穗，锦州～。","book":"《宋史·五行志二下》"},"similar":["麦穗两歧"],"usage":"作宾语、定语；比喻年成好，粮食丰收"},{"id":49067,"word":"麦秀黍离","pinyin":"mài xiù shǔ lí","abbr":"mxsl","explanation":"哀伤亡国之辞。","source":{"text":"麦秀渐渐兮，禾黍油油。彼狡僮兮，不与我好兮。","book":"《诗经·王风·黍离》：“彼黍离离，彼稷之苗。行迈靡磨，中心摇摇。”《史记·宋微子世家》"},"example":{"text":"诗多残山剩水之思，～之感。","book":"清·平步青《霞外捃屑·屈悔翁》"}},{"id":49068,"word":"麦穗两岐","pinyin":"mài suì liǎng qí","abbr":"mslq","explanation":"①一麦两穗。旧时以为祥瑞，以兆丰年。亦用以称颂吏治成绩卓著。②比喻相像的两样事物。","source":{"text":"［堪］乃于狐奴开稻田八千余顷，劝民耕种，以致殷富。百姓歌曰：‘桑无附枝，麦穗两岐。张君为政，乐不可支。’","book":"《后汉书·张堪传》"},"example":{"text":"～，农人难辨。","book":"明·冯梦龙《警世通言》第八卷"}},{"id":49069,"word":"麦穗两歧","pinyin":"mài suì liǎng qí","abbr":"mslq","explanation":"一根麦长两个穗。比喻年成好，粮食丰收。","source":{"text":"百姓歌曰：‘桑无附枝，麦穗两岐。张君为政，乐不可支。’","book":"南朝·宋·范晔《后汉书·张堪传》"},"example":{"text":"～，农人难辨。","book":"《京本通俗小说·碾玉观音》"},"similar":["麦秀两歧"],"usage":"作宾语、定语；比喻年成好，粮食丰收"},{"id":49070,"word":"麦舟之赠","pinyin":"mài zhōu zhī zèng","abbr":"mzzz","explanation":"麦：麦子；舟：船。以一船麦子作为赠品。指助人丧葬的费用。","source":{"text":"尧夫以所载麦舟付之。到家，文正曰：‘东吴见故旧乎？’曰：‘曼卿为三丧未举，方滞舟丹阳。’公曰：‘何不以麦舟与之？’尧夫曰：‘?坟之矣。’","book":"宋·释惠洪《冷斋夜话》卷十"},"example":{"text":"见赵令妻子羁广柳车中，凄其可悯，乃出己囊为代偿，而复以百金这～。","book":"明·张岱《家传》"}},{"id":49071,"word":"麦饭豆羹","pinyin":"mài fàn dòu gēng","abbr":"mfdg","explanation":"羹：汤。指粗劣食品。用来比喻生活水平低下。","source":{"text":"饼饵麦饭甘豆羹。","book":"汉·史游《急就篇》"},"example":{"text":"木床石枕冷家风，拥衾时魂梦亦爽；～淡滋味，放箸处齿颊犹香。","book":"明·洪应明《菜根谭·闲适》"},"usage":"作宾语、定语；用于生活"},{"id":49072,"word":"麻中之蓬","pinyin":"má zhōng zhī péng","abbr":"mzzp","explanation":"麻：泛指麻类植物；蓬：飞蓬。生长在麻中的飞蓬。麻是直立向上生长的，故飞蓬也随之直立生长。形容在良好的环境中受到好的影响。","source":{"text":"蓬生麻中，不扶而直。","book":"《荀子·劝学》"}},{"id":49073,"word":"麻姑掷米","pinyin":"má gū zhì mǐ","abbr":"mgzm","explanation":"指神仙用法术点化事物。也比喻运笔法点缀文字，使诗文作品新颖，别具一格。","source":{"text":"即求少许米，得米便撒之掷地，视其米，皆成真珠矣。","book":"晋·葛洪《神仙传》"},"example":{"text":"公为诗如～，粒粒皆成丹砂，然不自爱惜，缘手辄散去。","book":"清·王士禛《带经堂诗话·指数类上》"}},{"id":49074,"word":"麻姑掷豆","pinyin":"má gū zhì dòu","abbr":"mgzd","explanation":"指神仙用法术点化事物。也比喻运笔法点缀文字，使诗文作品新颖，别具一格。","source":{"text":"即求少许米，得米便撒之掷地，视其米，皆成真珠矣。","book":"晋·葛洪《神仙传》"},"example":{"text":"若学论二义论及策之一二三，则全出拙笔也，～，犹作狡狯变态，可笑，可笑。","book":"明·张居正《答关中宪使李义河术时政》"}},{"id":49075,"word":"麻姑献寿","pinyin":"má gū xiàn shòu","abbr":"mgxs","explanation":"献：把东西送给尊长或敬爱的人。指祝贺寿辰。","source":{"text":"麻姑，建昌人，修道于牟州东南余姑山。三月三日西王母寿辰，麻姑在绛珠河畔以灵芝酿酒，为王母祝寿。","book":"晋·葛洪《神仙传》卷七"},"example":{"text":"管家递过来一张纸，王雄看时，帽子戏是《～》。","book":"二月河《乾隆皇帝》三十八"}},{"id":49076,"word":"麻木不仁","pinyin":"má mù bù rén","abbr":"mmbr","explanation":"不仁：没有感觉。肢体麻痹，失去知觉。比喻对外界事物反应迟钝或漠不关心。","source":{"text":"一日皮死麻木不仁，二日肉死针刺不痛。","book":"明·薛己《医案·总论》"},"example":{"text":"没有同情，没有热，是～？还是忘恩负义。","book":"闻一多《伟大的事实，不朽的意义》"},"similar":["无动于衷"],"opposite":["耳聪目明","见微知著","眼疾手快"],"usage":"作谓语、定语、补语；指反应迟钝"},{"id":49077,"word":"麻痹不仁","pinyin":"má bì bù rén","abbr":"mbbr","explanation":"指对外界事物反应迟钝或没有感觉。","source":{"text":"今但以仁体称兄，恐合邑士大夫皆以为我麻痹不仁之人矣。","book":"明·李贽《寄答留都书》"},"example":{"text":"他现在快成为～的人。"},"similar":["麻木不仁"],"usage":"作谓语、定语；指人反应迟钝"},{"id":49078,"word":"麻痹大意","pinyin":"má bì dà yì","abbr":"mbdy","explanation":"麻痹：肢体失去知觉和运动机能障碍，比喻失去警觉。指粗心、疏忽，对事物不敏感，失去警惕性。","source":{"text":"我要当心，不能麻痹大意，我应当找个隐蔽的地方。","book":"巴金《坚强战士》"},"example":{"text":"我们不能～让他如意算盘打成。"},"similar":["掉以轻心","漫不经心","粗心大意"],"opposite":["全神贯注","专心致志"],"usage":"作谓语、定语、分句；指粗心大意"},{"id":49079,"word":"麻痺不仁","pinyin":"má bì bù rén","abbr":"mbbr","explanation":"对外界事物反应迟钝或没有感情。"},{"id":49080,"word":"麻雀虽小，五脏俱全","pinyin":"má què suī xiǎo，wǔ zàng jù quán","abbr":"mqsxwzjq","explanation":"比喻事物体积或规模虽小，具备的内容却很齐全。","source":{"text":"‘麻雀虽小，五脏俱全。’机器当然应有尽有，就是不大牢。","book":"钱钟书《围城》"},"example":{"text":"我们生产小组是“～”"},"similar":["麻雀虽小，肝胆俱全"],"usage":"作宾语、分句；用于小而全的机构"},{"id":49081,"word":"麻雀虽小，肝胆俱全","pinyin":"má què suī xiǎo，gān dǎn jù quán","abbr":"mqsxgdjq","explanation":"比喻事物体积或规模虽小，具备的内容却很齐全。","source":{"text":"有儿女的用功室，是所谓‘麻雀虽小而肝胆俱全’的。","book":"郭沫若《革命春秋·鸡之归去来》"},"example":{"text":"我们这个单位真是～，配置很齐全。"},"similar":["麻雀虽小，五脏俱全"],"usage":"作宾语、分句；用于小而全的机构"},{"id":49082,"word":"麾之即去","pinyin":"huī zhī jì qù","abbr":"hzjq","explanation":"命令他走就离开。形容服从指挥，听候调遣。","source":{"text":"杯再拜，道：‘麾之即去，招之须来。’","book":"宋·辛弃疾《沁园春·将止酒戒酒杯勿使近》词"},"example":{"text":"此时招之使来，他日不能～。","book":"清·夏燮《中西纪事》第20卷"},"similar":["挥之即去"],"opposite":["呼之即来"],"usage":"作谓语；指服从指挥"},{"id":49083,"word":"麾斥八极","pinyin":"huī chì bā jí","abbr":"hcbj","explanation":"麾斥：奔放。形容人气概非凡，不可一世。","source":{"text":"麾斥八极，群雄云从。","book":"明·宋濂《国朝名臣序颂·张献武王宏范》"},"similar":["挥斥八极"],"usage":"作谓语、定语；指人的气概"},{"id":49084,"word":"黄中内润","pinyin":"huáng zhōng nèi rùn","abbr":"hznr","explanation":"黄：美。指德才深藏不外露。","source":{"text":"清河崔玄伯见而异之，叹曰：‘高子黄中内润，文明外照，必为一代伟器，但恐吾不见耳。’","book":"《魏书·高允传》"}},{"id":49085,"word":"黄中通理","pinyin":"huáng zhōng tōng lǐ","abbr":"hztl","explanation":"理：玉石的纹路，引申为物的纹理或事的条理。以黄色居中而兼有四方之色。指通晓事物的道理。","source":{"text":"君子黄中通理，正位居体，美在其中而畅于四支，发于事业，美之至也。","book":"《周易·坤》"}},{"id":49086,"word":"黄云白草","pinyin":"huáng yún bái cǎo","abbr":"hybc","explanation":"形容边塞荒漠凄凉的景象。","source":{"text":"白草黄云塞上秋，曾随骠骑出并州。","book":"唐·权德舆《赠老将》诗"},"similar":["白草黄云"],"usage":"作宾语、定语；指荒凉的地方"},{"id":49087,"word":"黄人守日","pinyin":"huáng rén shǒu rì","abbr":"hrsr","explanation":"用以比喻朝政清明，国力强盛。","source":{"text":"日，二黄人守者，外国人方自来降也。","book":"《太平御览》卷八七二引《符瑞图》"},"example":{"text":"俨威容而青女司霜，荐祥瑞而～。","book":"宋·王禹偁《授御史大夫可司徒门下侍郎平平章事制》"},"similar":["黄人捧日"],"usage":"作宾语、定语；用于书面语"},{"id":49088,"word":"黄人捧日","pinyin":"huáng rén pěng rì","abbr":"hrpr","explanation":"比喻朝政清明，国力强盛。同“黄人守日”。","source":{"text":"苍龙东阙转春旂，綷羽林梢最早知。青帝回风还习习，黄人捧日故迟迟。","book":"宋·宋祁《春帖子词·〈皇帝阁〉之六》"},"similar":["黄人守日"],"usage":"作宾语、定语；用于书面语"},{"id":49089,"word":"黄公好谦","pinyin":"huáng gōng hào qiān","abbr":"hghq","explanation":"指人过分谦虚。","source":{"text":"齐有黄公者，好谦卑。有二女，皆国色。","book":"《尹文子·大道上》"},"usage":"作宾语、定语；指人过分谦虚","story":["齐国黄公为人爱谦让，他有两个容貌超群的女儿，经常谦虚地贬低她们为丑八怪，别人都不来向她们求婚，以致错过最佳结婚年龄，卫国一个老光棍冒冒失失娶了过去，发现原是绝色美人，他逢人便说：“黄公好谦让，故意说女儿不美。”"]},{"id":49090,"word":"黄公酒垆","pinyin":"huáng gōng jiǔ lú","abbr":"hgjl","explanation":"垆：酒肆放置酒坛的土台子，借指酒店，酒馆。又见到了黄公开的那个酒馆。比喻人见景物，而哀伤旧友，或作为伤逝忆旧之辞。","source":{"text":"王浚冲为尚书令，著公服，乘轺车，经黄公酒垆下过。顾谓后车客：‘……，今日视虽近，邈若山河。’","book":"南朝·宋·刘义庆《世说新语·伤逝》"},"example":{"text":"山阳笛声之感，～之忆，为之悠悠上心。","book":"元·戴表元《剡源集·题萧子西诗卷后》"},"usage":"作宾语、定语；指朋友聚会的场所","story":["西晋时期，“竹林七贤”之一尚书令王戎穿着华贵的衣服，乘车经过当时有名的黄公酒垆，这是他与嵇康、阮籍他们以前经常畅饮的地方，不禁感慨万分，心中也十分悲伤，就对身后客人说：“嵇康夭折，阮籍亡故，我被俗务缠身，再也不能一起喝酒了。”"]},{"id":49091,"word":"黄冠草履","pinyin":"huáng guàn cǎo lǚ","abbr":"hgcl","explanation":"粗劣的衣着。借指平民百姓。有时指草野高逸。同“黄冠草服”。","source":{"text":"黄冠草履之民，谁无尊亲之血气；四海九州之内，何非故国之山河。","book":"曹亚伯《武昌起义·宣布满清罪状檄》"},"similar":["黄冠草服","黄冠野服"],"usage":"作主语、宾语、定语；用于衣着"},{"id":49092,"word":"黄冠草服","pinyin":"huáng guàn cǎo fú","abbr":"hgcf","explanation":"粗劣的衣着。借指平民百姓。有时指草野高逸。","source":{"text":"而所谓磊落超脱者，往往出于黄冠草服之间。","book":"明·唐顺之《与洪方洲郎中书》"},"example":{"text":"纯客道：“壮丽哉，王居也！～，哪里配进去呢！”","book":"清·曾朴《孽海花》第二十回"},"similar":["黄冠草履"],"usage":"作主语、宾语、定语；用于衣着"},{"id":49093,"word":"黄冠野服","pinyin":"huáng guàn yě fú","abbr":"hgyf","explanation":"粗劣的衣着。借指平民百姓。有时指草野高逸。同“黄冠草服”。","source":{"text":"黄冠野服山家容，意欲置我山岩中。","book":"宋·苏轼《赠写真何充秀才》"},"example":{"text":"二月梅江波滟滟，～期许剑。","book":"古直《冷圃曲》"},"similar":["黄冠草服","黄冠草履"],"usage":"作主语、宾语、定语；用于衣着"},{"id":49094,"word":"黄卷幼妇","pinyin":"huáng juàn yòu fù","abbr":"hjyf","explanation":"“绝妙”二字的隐语。","source":{"text":"黄绢，色丝也，于字为绝。幼妇，少女也，于字为妙。外孙，女子也，于字为好。蒱臼，受辛也，于字为辞。所谓绝妙好辞也。","book":"南朝·宋·刘义庆《世说新语·捷悟》"}},{"id":49095,"word":"黄卷青灯","pinyin":"huáng juàn qīng dēng","abbr":"hjqd","explanation":"黄卷：古代书籍用黄低缮写，因指书籍；青灯：油灯发青色的灯光，指油灯。灯光映照着书籍。形容深夜苦读，或修行学佛的孤寂生活。","source":{"text":"苍颜白发人衰境，黄卷青灯空苦心。","book":"宋·陆游《剑南诗篇·客愁》"},"example":{"text":"越显得文风盛，受用足，珠围翠绕，结果了～。","book":"元·王实甫《西厢记》第二本第二折"},"similar":["青灯黄卷"],"usage":"作宾语、定语；指修行学佛的孤寂生活"},{"id":49096,"word":"黄发儿齿","pinyin":"huáng fà ér chǐ","abbr":"hfec","explanation":"比喻人长寿。"},{"id":49097,"word":"黄发台背","pinyin":"huáng fā tái bèi","abbr":"hftb","explanation":"指长寿的老人。后亦泛指老年人。黄发，指老年人头发由白转黄。台背，指老年人背上生斑如鲐鱼背。台，通“鲐”。","source":{"text":"黄发台背，皆寿征也。","book":"《诗·鲁颂·閟宫》：“黄发台背，寿胥与试。”郑玄笺"},"similar":["黄发鲐背"],"usage":"作宾语、定语；用于老年人"},{"id":49098,"word":"黄发垂髫","pinyin":"huáng fà chuí tiáo","abbr":"hfct","explanation":"黄发：老年人头发由白转黄；垂髫：古时单童子未冠者头发下垂。指老人与儿童。","source":{"text":"垂髫总发。","book":"《诗经·鲁颂·閟宫》：“黄发台背。”晋·潘岳《藉田赋》"},"example":{"text":"男女衣著，悉如外人；～，并怡然自乐。","book":"晋·陶潜《桃花源诗并记》"},"similar":["黄童白叟"],"usage":"作宾语、定语；指老人和儿童"},{"id":49099,"word":"黄发骀背","pinyin":"huáng fā tái bèi","abbr":"hfdb","explanation":"指长寿的老人。后亦泛指老年人。同“黄发台背”。","source":{"text":"于是服冕之士，戴鹖之伦，暨藩侯邦伯，黄发骀背，不谋而进曰……","book":"唐·李德裕《上尊号玉册文（会昌二年奉敕撰）》"},"similar":["黄发台背","黄发鲐背"],"usage":"作宾语、定语；用于老年人"},{"id":49100,"word":"黄发鲐背","pinyin":"huáng fā tái bèi","abbr":"hftb","explanation":"黄发：老年人头发由白转黄，后常指老年人。鲐背；鲐鱼背上有黑斑，老人背上也有，因常借指老人。指长寿老人，也泛指老年人。亦作“黄发台背”、“黄发骀背”。","source":{"text":"虽复黄发鲐背，犹自觉所经俄顷，况其短者乎？","book":"南朝·宋·宗炳《明佛论》"},"example":{"text":"百馀年间，圣祖神孙三举盛典，使～者欢饮殿庭。","book":"清·昭槤《啸亭续录·千叟宴》"},"similar":["黄发台背","黄发骀背"],"usage":"作宾语、定语；用于老年人"},{"id":49101,"word":"黄口孺子","pinyin":"huáng kǒu rú zǐ","abbr":"hkrz","explanation":"黄口：儿童；孺子：小孩子。常用以讥讽别人年幼无知。","source":{"text":"父去里所，复返，曰：‘孺子可教矣。’","book":"《淮南子·氾论训》：“古之伐国，不杀黄口。”《史记·留侯世家》"},"example":{"text":"似你这等黄口孺子，定然不认得，吾是西歧大将军南宫适。","book":"明·许仲琳《封神演义》第八十四回"},"similar":["黄口小儿"],"usage":"作主语、宾语、定语；讥讽别人年幼无知"},{"id":49102,"word":"黄口小儿","pinyin":"huáng kǒu xiǎo ér","abbr":"hkxe","explanation":"黄口：儿童；小儿：小孩子。常用以讥讽别人年幼无知。","source":{"text":"孔子见罗崔者，所得皆黄口小雀。夫子问之曰：‘大雀独不得，何也？’罗曰：‘大雀善惊而难得，黄口贪食而易得。’","book":"《孔子家语·六本》"},"example":{"text":"其中自然有古典，为“～”所不知。","book":"鲁迅《华盖集续编·古书与白话》"},"similar":["黄口孺子"],"usage":"作宾语、定语；用以讥讽别人年幼无知"},{"id":49103,"word":"黄台之瓜","pinyin":"huáng tái zhī guā","abbr":"htzg","explanation":"黄台：指《黄台瓜辞》，为唐李贤所作，希望以此感悟高宗及武则天不能再废太子。比喻不堪再摘。","source":{"text":"贤终日忧惕，每侍上，不敢有言，乃作乐章，使工歌之。其言曰：‘种瓜黄台下，瓜熟子离离。一摘使瓜好，再摘令瓜稀，三摘犹云可，四摘抱蔓归。’","book":"《新唐书·承天皇帝倓传》"},"usage":"作宾语；指被屠杀的人","story":["唐高宗时期，朝政由皇后武则天代为处理，武后的野心很大，手段十分残忍。她废太子李忠立李弘做太子，后把太子弘毒死，立李贤为太子。他日夜忧思作《黄台瓜辞》：“种瓜黄台下，瓜熟子离离。一摘使瓜好，再摘令瓜稀，三摘犹自可，摘绝抱蔓归。”"]},{"id":49104,"word":"黄垆之痛","pinyin":"huáng lú zhī tòng","abbr":"hlzt","explanation":"垆：放酒瓮的土墩子；黄垆：黄公酒垆；痛：悲痛。收集亡友的话。","source":{"text":"王睿冲为尚书令，著公服，乘轺车，经黄公酒垆下过。","book":"南朝·宋·刘义庆《世说新语·伤逝》"},"example":{"text":"人总免不了有～。"},"usage":"作宾语；指失去故友之痛","story":["西晋时期，“竹林七贤”之一的尚书令王戎穿着华贵的衣服，乘车经过当时有名的黄公酒垆，这是他与嵇康、阮籍他们以前经常畅饮的地方，不禁感慨万分，心中也十分悲伤，就对身后的客人说：“嵇康夭折，阮籍亡故，我被俗务缠身，再也不能一起喝酒了"]},{"id":49105,"word":"黄天焦日","pinyin":"huáng tiān jiāo rì","abbr":"htjr","explanation":"犹大天白日。指白天。","source":{"text":"如今的时新，黄天焦日，男的女的在一起，嘻嘻哈哈，像个什么？","book":"周立波《山乡巨变》下一"},"similar":["青天白日","光天化日"],"usage":"作宾语、分句；指大白天"},{"id":49106,"word":"黄尘清水","pinyin":"huáng chén qīng shuǐ","abbr":"hcqs","explanation":"比喻变化迅速。","source":{"text":"黄尘清水三山下，更变千年如走马。","book":"唐·李贺《梦天》诗"}},{"id":49107,"word":"黄屋左纛","pinyin":"huáng wū zuǒ dào","abbr":"hwzd","explanation":"黄屋：古代皇帝车上用黄缯做里子的车盖；左纛：古代皇帝车上用犛牛尾做的装饰物，设在车衡的左边。旧指帝王的车辆。","source":{"text":"乃乘黄屋左纛，称制。","book":"《史记·南越列传》"},"example":{"text":"赵佗之去～也，此在文帝世也。","book":"清·汪琬《代寿洪太傅七十序》"},"usage":"作宾语、定语；用于书面语"},{"id":49108,"word":"黄帝子孙","pinyin":"huáng dì zǐ sūn","abbr":"hdzs","explanation":"黄帝：古代传说中中华民族的共同祖先，姬姓，号轩辕氏、有熊氏。黄帝轩辕氏的子孙后代。指每个中国人或所有的中国人。","source":{"text":"……仍需要全国同胞，每一个热血的黄帝子孙，坚韧不拔地努力奋斗。","book":"周恩来《中共中央为公布国共合作宣言》"},"similar":["炎黄子孙"],"usage":"作主语、宾语、定语；指中华儿女"},{"id":49109,"word":"黄干黑廋","pinyin":"huáng gān hēi sōu","abbr":"hghs","explanation":"面容憔悴的样子。","source":{"text":"你恋着红裙翠袖，折倒的你黄干黑廋。","book":"元·张国宾《罗李郎》第一折"},"example":{"text":"我我我折倒的骨捱身似柴蓬，是是是俺可也病恹恹～。","book":"元·无名氏《千里独行》第二折"}},{"id":49110,"word":"黄干黑廲","pinyin":"huáng gān hēi sōu","abbr":"hghs","explanation":"面容憔悴的样子。","source":{"text":"第一折你恋着红裙翠袖，折倒的你黄干黑廲。","book":"元·张国宾《罗李郎》"},"quote":{"text":"我我我折倒的骨捱身似柴蓬，是是是俺可也病恹恹～。","book":"元·无名氏《千里独行》第二折"}},{"id":49111,"word":"黄干黑瘦","pinyin":"huáng gān hēi shòu","abbr":"hghs","explanation":"指人面容憔悴的样子。","source":{"text":"你恋着红裙翠袖，折倒的你黄干黑瘦。","book":"元·张国宾《罗李郎》第一折"},"example":{"text":"她憔悴得～了。"},"similar":["黄皮寡瘦"],"opposite":["膘肥体壮"],"usage":"作谓语、状语、定语；用于人憔悴的样子"},{"id":49112,"word":"黄旗紫盖","pinyin":"huáng qí zǐ gài","abbr":"hqzg","explanation":"天空中出现状如黄旗紫盖的云气。旧为皇帝出世的征兆。","source":{"text":"黄旗紫病见于东南，终有天下者，荆、杨之君乎？","book":"《三国志·吴志·孙皓传》：“三年春正月晦。”裴松之注引《江表传》"},"example":{"text":"～，已绝东南，白马素车，将降轵道。","book":"《北齐书·文苑传·樊逊》"},"usage":"作宾语、定语；旧为皇帝出世的征兆"},{"id":49113,"word":"黄杨厄闰","pinyin":"huáng yáng è rùn","abbr":"hyer","explanation":"黄杨：树木名；厄：困苦；闰：闰年。旧时传说，黄杨木难长，遇到闰年，非但不长，反而会缩短。比喻境遇困难。","source":{"text":"园中草木春无数，只有黄杨厄闰年。","book":"宋·苏轼《监洞霄宫俞康直郎中所居四咏》"},"example":{"text":"愁如碧草逢春长，身似～频。”（清·梁绍壬《两般秋雨庵随笔》卷五","book":"王澹音《病中述怀》云"},"usage":"作宾语；比喻境遇困难"},{"id":49114,"word":"黄梁一梦","pinyin":"huáng liáng yī mèng","abbr":"hlym","explanation":"黄米饭尚未蒸熟，一场好梦已经做醒。原比喻人生虚幻。后比喻不能实现的梦想。","source":{"text":"卢生欠伸而寤，见方偃于邸中，顾吕翁在旁，主人蒸黄梁尚未熟，触类如故，蹶然而兴曰：岂其梦寐耶？","book":"唐·李泌《枕中记》"},"example":{"text":"得遇正阳子师父点化，～遂成仙道。 ◎元·范子安《竹叶舟》第一折"}},{"id":49115,"word":"黄梁美梦","pinyin":"huáng liáng měi mèng","abbr":"hlmm","explanation":"黄米饭尚未蒸熟，一场好梦已经做醒。原比喻人生虚幻。后比喻不能实现的梦想。","source":{"text":"卢生欠伸而寤，见方偃于邸中，顾吕翁在旁，主人蒸黄梁尚未熟，触类如故，蹶然而兴曰：岂其梦寐耶？","book":"唐·李泌《枕中记》"},"example":{"text":"他规划的远景不过是～罢了。"}},{"id":49116,"word":"黄梅不落青梅落","pinyin":"huáng méi bù luò qīng méi luò","abbr":"hmblqml","explanation":"比喻青年人比老年人早亡。","source":{"text":"正是古人云：黄梅不落青梅落，老天偏害没儿人。","book":"明·吴承恩《西游记》第四十七回"}},{"id":49117,"word":"黄毛丫头","pinyin":"huáng máo yā tóu","abbr":"hmyt","explanation":"年幼不明事理的女孩子。","source":{"text":"为了一个黄毛丫头，就那么愤世嫉俗，真是小题大做！","book":"钱钟书《围城》"},"example":{"text":"你不能相信那～的话。"},"usage":"作主语、宾语、定语；用于女孩"},{"id":49118,"word":"黄汤淡水","pinyin":"huáng tāng dàn shuǐ","abbr":"htds","explanation":"泛指饮食。同“黄汤辣水”。","source":{"text":"比不的你们心宽闲散。我这两日只有口游气儿，黄汤淡水谁尝着来？我成日睁着脸儿过日子哩！","book":"明·兰陵笑笑生《金瓶梅词话》第三十八回"},"similar":["黄汤辣水"],"usage":"作宾语、定语；用于生活"},{"id":49119,"word":"黄汤辣水","pinyin":"huáng tāng là shuǐ","abbr":"htls","explanation":"泛指饮食。","source":{"text":"三两夜没睡，头也没梳，脸也还没洗，乱了恁五更，黄汤辣水还没尝着，就是铁人也禁不的。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"},"example":{"text":"咱们奶奶万金之体，劳乏了几日，～没吃，咱们哄他欢喜的，说这些话做什么？","book":"清·曹雪芹《红楼梦》第七十一回"},"similar":["黄汤淡水","清汤寡水"],"usage":"作宾语、定语；用于生活"},{"id":49120,"word":"黄河水清","pinyin":"huáng hé shuǐ qīng","abbr":"hhsq","explanation":"黄河之水常年混浊，如果变得清澈则被视为祥瑞的征兆。也比喻罕见的、难得的事情。","source":{"text":"夫黄河清而圣人生。","book":"三国·魏·李康《运命论》"},"usage":"作定语；多用于期待等"},{"id":49121,"word":"黄泉之下","pinyin":"huáng quán zhī xià","abbr":"hqzx","explanation":"黄泉：指地下之泉，人死埋于地下。指人死后埋葬的地方。","source":{"text":"誓之曰：‘不及黄泉，无相见也。’","book":"《左传·隐公元年》"},"example":{"text":"在那不识不知的～，好不逍遥快乐。","book":"清·文康《儿女英雄传》第十八回"},"similar":["九泉之下"],"usage":"作宾语；形容人死后在地下的用语"},{"id":49122,"word":"黄牌警告","pinyin":"huáng pái jǐng gào","abbr":"hpjg","explanation":"指足球比赛中裁判员对有较严重犯规行为的运动员出示黄牌以示警告，也借指对人的提醒、警告。","example":{"text":"我已经～他了。"},"usage":"作谓语、宾语、定语；指提醒"},{"id":49123,"word":"黄狸黑狸，得鼠者雄","pinyin":"huáng lí hēi lí，dé shǔ zhě xióng","abbr":"hlhldszx","explanation":"狸：野猫，山猫；雄：威武，借喻杰出的人物或国家。比喻不论是什么办法，只要能取得好的或预期的效果，就是好办法。","source":{"text":"异史氏曰：‘黄狸黑狸，得鼠者雄。’此非空言也。","book":"清·蒲松龄《聊斋志异·驱怪》"},"example":{"text":"～演化为现代的白猫黑猫论。"},"usage":"作宾语、定语、分句；指取得好效果的方法","story":["清朝时期，徐秀才不愿为清廷服务，就改学道术为人驱鬼，一个朝廷大员请他驱鬼，好酒好菜侍侯，闭口不谈驱鬼事情。晚上一头兽头人身的怪物来舔食剩菜剩饭。徐秀才吓得拼命狂叫吓跑了那怪物，后来再也没发现了，人们感叹：“黄狸黑狸，得鼠者雄。"]},{"id":49124,"word":"黄白之术","pinyin":"huáng bái zhī shù","abbr":"hbzs","explanation":"黄白：黄金和白银。相传道家有烧炼丹药点化金银的法术。指道家的炼丹术。","source":{"text":"又有《中篇》八卷，言神仙黄白之术，亦二十余万言。","book":"《汉书·淮南王安传》"},"example":{"text":"能以药草炼成丹药，铅铁为金，死汞为银，名为“～”。","book":"明·凌濛初《初刻拍案惊奇》卷十八"}},{"id":49125,"word":"黄皮刮廋","pinyin":"huáng pí guā sōu","abbr":"hpgs","explanation":"形容面黄肌瘦的样子。","source":{"text":"形容面黄肌瘦的样子。"},"example":{"text":"余辰《蚕》六：“一天过去了，蚕完全绝食啦，一个个饿得黄皮刮廋，眼看就要死了。”"}},{"id":49126,"word":"黄皮刮廲","pinyin":"huáng pí guā sōu","abbr":"hpgs","explanation":"形容面黄肌瘦的样子。","source":{"text":"六一天过去了，蚕完全绝食啦，一个个饿得黄皮刮廲，眼看就要死了。","book":"余辰《蚕》"}},{"id":49127,"word":"黄皮刮瘦","pinyin":"huáng pí guā shòu","abbr":"hpgs","explanation":"形容面黄肌瘦的样子。","source":{"text":"一天过去了，蚕完全绝食啦，一个个饿得黄皮刮瘦，眼看就要死了。","book":"余辰《蚕》"},"similar":["黄皮寡瘦"],"usage":"作谓语、状语、定语；用于人憔悴的样子"},{"id":49128,"word":"黄皮寡廋","pinyin":"huáng pí guǎ sōu","abbr":"hpgs","explanation":"形容面黄肌瘦的样子。同“黄皮刮廋”。","source":{"text":"一群饿得黄皮寡廋的人，伸着两只皮包骨头的手。","book":"熊伯涛《宁都兵暴前后》"}},{"id":49129,"word":"黄皮寡廲","pinyin":"huáng pí guǎ sōu","abbr":"hpgs","explanation":"形容面黄肌瘦的样子。同黄皮刮廲”。","source":{"text":"一群饿得黄皮寡廲的人，伸着两只皮包骨头的手。","book":"熊伯涛《宁都兵暴前后》"}},{"id":49130,"word":"黄皮寡瘦","pinyin":"huáng pí guǎ shòu","abbr":"hpgs","explanation":"形容面黄肌瘦的样子。","source":{"text":"一群饿得黄皮寡瘦的人，伸着两只皮包骨头的手。","book":"熊伯涛《宁都兵暴前后》"},"example":{"text":"对面来了一个～的人。"},"similar":["黄干黑瘦","面黄肌瘦","黄皮刮瘦"],"opposite":["肥头大耳"],"usage":"作谓语、状语、定语；用于人憔悴的样子"},{"id":49131,"word":"黄童白叟","pinyin":"huáng tóng bái sǒu","abbr":"htbs","explanation":"黄发儿童，白发老人。泛指老人与孩子。","source":{"text":"卿士庶人，黄童白叟，踊跃欢呀，失熹噎欧。","book":"唐·韩愈《元和圣德诗》"},"example":{"text":"远方，近方，～知名望。","book":"元·汤式《一枝花·赠人》"},"similar":["老老少少","黄童皓首"],"usage":"作主语、宾语；泛指老人与孩子"},{"id":49132,"word":"黄童白颠","pinyin":"huáng tóng bái diān","abbr":"htbd","explanation":"泛指老人与孩子。同“黄童白叟”。","source":{"text":"夫今之黄童白颠，犹昔氓也；高冠长裾，犹昔士也。","book":"明·袁宏道《邑钱侯直指疏荐序》"},"similar":["黄童白叟","黄童皓首"],"usage":"作主语、宾语；泛指老人与孩子"},{"id":49133,"word":"黄童皓首","pinyin":"huáng tóng hào shǒu","abbr":"hths","explanation":"泛指老人与孩子。见“黄童白叟”。","source":{"text":"黄童皓首接手而游嬉。","book":"宋·司马光《送伊阙王大夫歌》"},"similar":["黄童白颠","黄童白叟"],"usage":"作主语、宾语；泛指老人与孩子"},{"id":49134,"word":"黄粱一梦","pinyin":"huáng liáng yī mèng","abbr":"hlym","explanation":"黄粱：小米。比喻虚幻不能实现的梦想。","source":{"text":"怪曰：‘岂其梦寐耶？’翁笑曰：‘人世之事亦犹是矣。’","book":"唐·沈既济《枕中记》"},"example":{"text":"应举不第，道经邯郸，得遇正阳子师父，点化～，遂成仙道。","book":"元·范康《竹叶舟》第一折"},"similar":["黄粱美梦"],"opposite":["如梦方醒"],"usage":"作主语、宾语、定语；指不能实现的梦想","story":["从前有一个穷困潦倒的书生卢生，在邯郸一个客店遇见道士吕翁。吕翁送他一个枕头，这时店主正开始做黄粱饭，卢生小睡一会，在梦中他中进士做宰相娶美妻，儿孙满堂，生活美满。梦醒后，主人的黄粱饭都还没做熟"]},{"id":49135,"word":"黄粱梦","pinyin":"huáng liáng mèng","abbr":"hlm","explanation":"黄粱：小米。比喻虚幻不能实现的梦想。","source":{"text":"死去生来不一身，定知谁妄复谁真？邯郸今日题诗客，犹是黄粱梦里人。","book":"金·元好问《过邯郸四绝》"},"example":{"text":"你的～醒了没有？"},"similar":["邯郸梦","黄粱一梦"],"usage":"作主语、宾语、定语；指不能实现的梦想","story":["从前有一个穷困潦倒的书生卢生，在邯郸一个客店遇见道士吕翁。吕翁送他一个枕头，这时店主正开始做黄粱饭，卢生小睡一会，在梦中他中进士做宰相娶美妻，儿孙满堂，生活美满。梦醒后，主人的黄粱饭都还没做熟"]},{"id":49136,"word":"黄粱美梦","pinyin":"huáng liáng měi mèng","abbr":"hlmm","explanation":"黄米饭尚未蒸熟，一场好梦已经做醒。原比喻人生虚幻。后比喻不能实现的梦想。","source":{"text":"卢生欠伸而寤，见方偃于邸中，顾吕翁在旁，主人蒸黄梁尚未熟，触类如故，蹶然而兴曰：岂其梦寐耶？","book":"唐·李泌《枕中记》"},"example":{"text":"他规划的远景不过是～罢了。"},"similar":["南柯一梦","白日做梦","黄粱一梦"],"opposite":["如梦方醒"],"usage":"作主语、宾语、定语；指不能实现的梦想","story":["从前有一个穷困潦倒的书生卢生，在邯郸一个客店遇见道士吕翁。吕翁送他一个枕头，这时店主正开始做黄粱饭，卢生小睡一会，在梦中他中进士做宰相娶美妻，儿孙满堂，生活美满。梦醒后，主人的黄粱饭都还没做熟"]},{"id":49137,"word":"黄绢幼妇","pinyin":"huáng juàn yòu fù","abbr":"hjyf","explanation":"“绝妙”二字的隐语。","source":{"text":"文妙黄绢幼妇，赋高乌有子虚。","book":"宋·金盈之《醉翁谈录·约朋友结果檄书》"},"example":{"text":"～很少人明白它的意思。"},"usage":"作宾语；指“绝妙”二字的隐语","story":["从前曹公到江南，读到《曹娥碑》文中“黄绢幼妇，外孙齑臼”八字时不能理解它的意思，就去问德祖。德祖想了一会就回答道：“黄绢就是色丝，是绝字；幼妇是少女，是妙字；外孙是女子，是好字；齑臼是受辛，是辞字。就是绝妙好辞"]},{"id":49138,"word":"黄绵袄子","pinyin":"huáng mián ǎo zǐ","abbr":"hmaz","explanation":"比喻冬天的太阳。","source":{"text":"壬寅正月，雨雪连旬，忽尔开霁。闾里翁媪相呼贺曰：‘黄绵袄子出矣。’","book":"宋·罗大经《鹤林玉露》卷一"},"usage":"作主语、宾语；指太阳"},{"id":49139,"word":"黄羊任人","pinyin":"huáng yáng rèn rén","abbr":"hyrr","explanation":"比喻大公无私、任人唯贤。","source":{"text":"晋平公问于祁黄羊曰：‘南阳无令，其谁可而为之？’祁黄羊对曰：‘解狐可。’","book":"战国·卫·吕不韦《吕氏春秋》"},"similar":["任人唯贤"],"opposite":["任人唯亲"],"usage":"作宾语、定语；指任人唯贤","story":["春秋时期，晋平公问大夫祁黄羊谁担任南阳县令合适，祁黄羊推荐解狐，晋平公问他怎么推荐仇人，他说任人唯贤，解狐不负众望。朝廷缺一个军中尉，祁黄羊推荐儿子祁午，祁午也干得相当出色。孔子说祁黄羊推荐人才真是大公无私"]},{"id":49140,"word":"黄耳传书","pinyin":"huáng ěr chuán shū","abbr":"hecs","explanation":"黄耳：犬名；书：书信。黄犬为主人往返传书。后比喻传递家信。","source":{"text":"初机有俊犬，名曰黄耳，甚爱之。既而羁寓京师，久无家问，……机乃为书以竹筩盛之而系其颈，犬寻路南走，遂至其家，得报还洛。其后因以为常。","book":"《晋书·陆机传》"},"similar":["黄耳寄书"],"usage":"作宾语、定语；指传递家信","story":["西晋时期，著名文学家陆机离开家乡浙江会华亭到京城洛阳做官。他很久没有收到家信，就写好一封信装入竹筒套到猎犬黄耳的脖子上，让它送到浙江老家，聪明的黄耳一路风尘仆仆地赶到会华亭并索取回信，来回只用25天时间"]},{"id":49141,"word":"黄耳寄书","pinyin":"huáng ěr jì shū","abbr":"hejs","explanation":"黄耳：犬名；书：书信。黄耳为主人传递家信。指传递家信。","source":{"text":"初机有骏犬，名黄耳，甚爱之。……其后因以为常。","book":"《晋书·陆机传》"},"example":{"text":"～并不神奇。"},"similar":["黄耳传书"],"usage":"作宾语、定语；指传递家信","story":["西晋时期，著名文学家陆机离开家乡浙江会华亭到京城洛阳做官。他很久没有收到家信，就写好一封信装入竹筒套到猎犬黄耳的脖子上，让它送到浙江老家，聪明的黄耳一路风尘仆仆地赶到会华亭并索取回信，来回只用25天时间"]},{"id":49142,"word":"黄花女儿","pinyin":"huáng huā nǚ ér","abbr":"hhne","explanation":"旧指未婚的青年女子。","source":{"text":"况且你身子已被人捉弄过了，就是今夜嫁人，叫不得个黄花女儿。","book":"明·冯梦龙《醒世恒言》卷三"},"example":{"text":"况且我看这人也是个～，岂有远路深更，和位公子同行之理。","book":"清·文康《儿女英雄传》第八回"},"similar":["黄花闺女"],"opposite":["半老徐娘"],"usage":"作主语、宾语、定语；指未婚女子"},{"id":49143,"word":"黄花晚节","pinyin":"huáng huā wǎn jié","abbr":"hhwj","explanation":"黄花：菊花；晚节：晚年的节操。比喻人晚节高尚。","source":{"text":"莫嫌老圃秋容淡，且看寒花晚节香。","book":"宋·韩琦《九日小阁》诗"},"example":{"text":"从教苍狗浮云过，留行～香。","book":"元·张伯游《次韵完颜经历》"},"opposite":["晚节不保"],"usage":"作宾语；指人的节操"},{"id":49144,"word":"黄茅白苇","pinyin":"huáng máo bái wěi","abbr":"hmbw","explanation":"本指盐碱地里生长的茅草和芦苇。后比喻平庸之人或物。","source":{"text":"荒瘠斥卤之地，弥望皆黄茅白苇。","book":"宋·苏轼《答张文潜书》"},"example":{"text":"夫了翁，百世师也；下视时辈，如～耳。","book":"宋·张元干《宣政间名贤题跋》"},"usage":"作宾语、定语；用于比喻句"},{"id":49145,"word":"黄衣使者","pinyin":"huáng yī shǐ zhě","abbr":"hysz","explanation":"指出使宫市的太监。","source":{"text":"黄衣使者白衫儿。","book":"唐·白居易《卖炭翁》"},"usage":"作主语、宾语、定语；指太监"},{"id":49146,"word":"黄袍加体","pinyin":"huáng páo jiā tǐ","abbr":"hpjt","explanation":"比喻发动政变获得成功。同“黄袍加身”。","source":{"text":"五代干戈未肯休，黄袍加体始无忧。","book":"清·钱彩《说岳全传》第一回"},"similar":["黄袍加身"],"usage":"作谓语、宾语、定语；指登基"},{"id":49147,"word":"黄袍加身","pinyin":"huáng páo jiā shēn","abbr":"hpjs","explanation":"五代后周时，赵匡胤在陈桥兵变，部下诸将给他披上黄袍，拥立为天子。后比喻发动政变获得成功。","source":{"text":"诸校露刃列于庭曰：‘诸军无主，愿策太尉为天子。’未及对，有以黄衣加太祖身，众皆罗拜呼万岁。","book":"《宋史·太祖本纪》"},"example":{"text":"～御海宇，五代纷争从此休。","book":"清·陈忱《水浒后传》第一回"},"similar":["自封为王","称王称霸","黄袍加体"],"usage":"作谓语、宾语、定语；指登基","story":["宋太祖赵匡胤原为周世宗手下的都点检，周世宗死后，周恭帝即位，赵匡胤掌握兵权。960年，北汉和契丹侵略中原，赵匡胤率军还击，驻军陈桥时，将士将一件黄袍披在赵匡胤身上，拥立他为皇帝，建立宋朝"]},{"id":49148,"word":"黄道吉日","pinyin":"huáng dào jí rì","abbr":"hdjr","explanation":"迷信的人认为可以办事的吉利日子。","source":{"text":"今日是皇道吉日，满朝众公卿都在银台门，敦请太师入朝授禅。","book":"元·无名氏《连环计》第四折"},"example":{"text":"次日是～，就着杨老妈为媒，说不舍得放女儿出门，把张幼谦赘了过来。","book":"明·凌濛初《初刻拍案惊奇》卷二十九"},"similar":["吉日良辰"],"usage":"作宾语；指好日子"},{"id":49149,"word":"黄金世界","pinyin":"huáng jīn shì jiè","abbr":"hjsj","explanation":"形容美好完善的境地。"},{"id":49150,"word":"黄金失色","pinyin":"huáng jīn shī sè","abbr":"hjss","explanation":"黄金失去了其明亮的色彩。旧时比喻人的命运不佳，有再大的才能也不能显示出来。","source":{"text":"运退黄金失色，时来顽铁生辉。","book":"明·凌濛初《初刻拍案惊奇·转运汉巧遇洞庭红》"},"usage":"作宾语、定语、状语；指人倒霉时"},{"id":49151,"word":"黄金时代","pinyin":"huáng jīn shí dài","abbr":"hjsd","explanation":"指人一生中最为宝贵的时期。也指国家政治、经济、文化最繁荣的时期。","source":{"text":"自己不想个正当方法奋斗去，却敛着手等候那黄金时代来碰他。","book":"廖仲恺《中国人民和领土在新国家建设上之关系》"},"example":{"text":"青少年时期是我们每个人的～。"},"similar":["豆蔻年华"],"opposite":["不惑之年"],"usage":"作宾语；指好的时期"},{"id":49152,"word":"黄金时间","pinyin":"huáng jīn shí jiān","abbr":"hjsj","explanation":"指广播电视在一天中收听、收视人数最多的时间。","source":{"text":"黄金时间黄金节目……欢迎中外厂商特约播出广告。","book":"《文汇报》"},"example":{"text":"我们要把握好这段～的广告效应。"},"usage":"作宾语、定语；指好时间"},{"id":49153,"word":"黄金铸象","pinyin":"huáng jīn zhù xiàng","abbr":"hjzx","explanation":"铸：铸造。用黄金铸造人像。表示对某人的敬仰或纪念。","source":{"text":"遂乘轻舟，以浮于五湖，莫知其所终极。王命金工以良金写范蠡之状，而朝礼之。","book":"《国语·越语下》"},"example":{"text":"伯国黄金闻铸象，王门白玉想为标。","book":"元·陈基《垂虹桥》诗"},"usage":"作宾语、定语；用于要人等"},{"id":49154,"word":"黄钟大吕","pinyin":"huáng zhōng dà lǚ","abbr":"hzdl","explanation":"黄钟：我国古代音韵十二律中六种阳律的第一律。大吕：六种阴律的第四律。形容音乐或言辞庄严、正大、高妙、和谐。","source":{"text":"以黄钟之钟，大吕之声为均者，黄钟阳声之首，大吕为之合。","book":"《周礼·春官·大司乐》：“乃奏黄钟，歌大吕，舞云门，以祀天神。”郑玄注"},"example":{"text":"先生之文如～，发达九地，黄启洙泗邹鲁之秘，其可不传耶？","book":"宋·陆九渊《语录下》"},"similar":["洪钟大吕"],"usage":"作宾语；形容音乐或文辞庄严"},{"id":49155,"word":"黄钟毁弃","pinyin":"huáng zhōng huǐ qì","abbr":"hzhq","explanation":"黄钟：黄铜铸的钟，我国古代音乐有十二律，阴阳各六，黄钟为阳六律的第一律；毁：毁坏；弃：抛弃。比喻贤人遭受摈斥。","source":{"text":"黄钟毁弃，瓦缶雷鸣；谗人高张，贤士无名。","book":"战国·楚·屈原《卜居》"},"example":{"text":"噫！鼠辈邸张，其若是哉！～，瓦缶雷鸣，蠢兹幺么，毒害乃尔。","book":"清·汇阴百一居士《壶天录》"},"similar":["本末倒置","混淆是非","颠倒黑白"],"usage":"作谓语、定语；指贤人不被所用"},{"id":49156,"word":"黄钟毁弃，瓦缶雷鸣","pinyin":"huáng zhōng huǐ qì，wǎ fǒu léi míng","abbr":"hzhqwflm","explanation":"黄钟：大钟；瓦缶：瓦锅。黄钟被砸烂抛置一边，把泥制的锅敲得很响。比喻有才德的人被弃置不用，而无才德的人却身居高位。","source":{"text":"鼠辈鸱张其若是哉！黄钟毁弃，瓦缶雷鸣。蠢兹幺幺，毒害乃尔。","book":"清·百一居士《壶天录》下卷"},"similar":["黄钟毁弃，瓦釜雷鸣"],"usage":"作定语、分句；指贤人不被所用"},{"id":49157,"word":"黄钟毁弃，瓦釜雷鸣","pinyin":"huáng zhōng huǐ qì，wǎ fǔ léi míng","abbr":"hzhqwflm","explanation":"黄钟被砸烂并被抛置一边，而把泥制的锅敲得很响。比喻有才德的人被弃置不用，而无才德的平庸之辈却居于高位。","source":{"text":"黄钟毁弃，瓦釜雷鸣；谗人高张，贤士无名。","book":"战国·楚·屈原《楚辞·卜居》"},"example":{"text":"在～的时代，对于瓦釜加以不恤的打击。","book":"郭沫若《批评——欣赏——检察》"},"similar":["黄钟毁弃，瓦缶雷鸣"],"usage":"作定语、分句；指贤人不被所用"},{"id":49158,"word":"黄钟瓦缶","pinyin":"huáng zhōng wǎ fǒu","abbr":"hzwf","explanation":"比喻艺术性较高和较低的文艺作品。","source":{"text":"试诵我诗一篇或一联，以见黄钟瓦缶，声调同异，则工拙两存乎心，所论公平，靡不服矣。","book":"明·谢榛《四溟诗话》卷三"},"similar":["黄钟瓦釜"],"usage":"作主语、宾语、定语；指贤才和庸才"},{"id":49159,"word":"黄钟瓦釜","pinyin":"huáng zhōng wǎ fǔ","abbr":"hzwf","explanation":"瓦釜：泥土烧成的大锅，用作乐器，音调最为低。比喻高雅优秀的或庸俗低劣的；贤才和庸才。","source":{"text":"黄钟毁弃，瓦釜雷鸣；谗人高张，贤士无名。","book":"战国·楚·屈原《楚辞·卜居》"},"example":{"text":"形象思维谁好，典型塑造孰优。～待搜求，不宜强分先后。","book":"茅盾《西江月·为新刊作》"},"similar":["黄钟瓦缶"],"usage":"作主语、宾语、定语；指贤才和庸才"},{"id":49160,"word":"黄钟长弃","pinyin":"huáng zhōng cháng qì","abbr":"hzcq","explanation":"比喻贤才不用。同“黄锺毁弃”。","source":{"text":"公一日谓生曰：‘君出余绪，遂使孺子成名。然黄钟长弃若何！’","book":"清·蒲松龄《聊斋志异·叶生》"},"similar":["黄钟毁弃，瓦缶雷鸣"],"usage":"作宾语、定语；用于比喻句"},{"id":49161,"word":"黄锺毁弃","pinyin":"huáng zhōng huǐ qì","abbr":"hzhq","explanation":"比喻贤才不用。"},{"id":49162,"word":"黄锺瓦缶","pinyin":"huáng zhōng wǎ fǒu","abbr":"hzwf","explanation":"比喻艺术性较高和较低的文艺作品。"},{"id":49163,"word":"黄门驸马","pinyin":"huáng mén fù mǎ","abbr":"hmfm","explanation":"黄门：宫庭禁门，后成为官署名；驸马：转指皇帝女婿。汉代掌管皇帝出行车马的官。指依靠婚姻而上的人。","source":{"text":"宦骑与黄门驸马争船。","book":"东汉·班固《汉书·李广苏建传》"},"example":{"text":"我们看不起这些～。"},"similar":["驸马都尉"],"usage":"作主语、宾语、定语；指靠婚姻的男人"},{"id":49164,"word":"黄雀伺蝉","pinyin":"huáng què sì chán","abbr":"hqsc","explanation":"螳螂正要捉蝉，不知黄雀在它后面正要吃它。比喻祸事临头还不知道。","source":{"text":"螳螂委身曲附欲取蝉，而不知黄雀在其旁也。黄雀延颈欲啄螳螂，而不知弹丸在其下也。","book":"汉·刘向《说苑·正谏》"},"example":{"text":"譬如～，不知随弹应至。青鹯逐兔，讵识扛鼎方前。","book":"南朝·梁元帝《荆州放生亭碑》"},"similar":["黄雀在后"],"usage":"作分句、定语；指灾祸即将来临","story":["春秋时期，吴王寿梦要攻打楚国，并禁止大臣提反对意见，有一个大臣的儿子听说后，带上弹弓到王宫花园去打鸟。吴王问他干什么，他说在看螳螂捕树上的蝉，而黄雀在后面等着吃螳螂。吴王觉得自己的处境同螳螂差不多，就只好取消计划"]},{"id":49165,"word":"黄雀在后","pinyin":"huáng què zài hòu","abbr":"hqzh","explanation":"比喻伺机从后面袭击，也比喻有后顾之忧。","source":{"text":"园中有树，其上有蝉，蝉高居悲鸣饮露，不知螳螂在其后也！螳螂委身曲跗欲取蝉，而不知黄雀在其傍也。","book":"汉·刘向《说苑·正谏》"},"example":{"text":"大家都知道～的道理，可就是容易忽视这一点。"},"similar":["后顾之忧","黄雀伺蝉"],"usage":"作分句、定语；指后顾之忧","story":["春秋时期，吴王寿梦要攻打楚国，并禁止大臣提反对意见，有一个大臣的儿子听说后，带上弹弓到王宫花园去打鸟。吴王问他干什么，他说在看螳螂捕树上的蝉，而黄雀在后面等着吃螳螂。吴王觉得自己的处境同螳螂差不多，就只好取消计划"]},{"id":49166,"word":"黄雀衔环","pinyin":"huáng què xián huán","abbr":"hqxh","explanation":"黄雀衔着银环以报答恩人。指报恩。","source":{"text":"吾西王母使者，蒙君拯救，实感仁恩。今赠白环四枚，令君子孙洁白，位登三公，一如此环。","book":"南朝·梁·吴均《续齐谐记》"},"example":{"text":"适在海中取参，见一大蚌，特取其珠，以为～之报，望恩人笔纳。","book":"清·李汝珍《镜花缘》第十三回"},"similar":["结草衔环"],"opposite":["恩将仇报"],"usage":"作宾语、定语；指报恩","story":["从前杨宝9岁时到华阴山，看见一只黄雀与老鹰搏斗而受伤掉到地上，就抱回家放到箱中，用黄花喂养100多天，黄雀伤好羽毛长成就飞去。当夜杨宝做了一个梦，见一个黄衣小童说是王母娘娘的使者给他送来4只玉环，第二天在院内果见玉环"]},{"id":49167,"word":"黄风雾罩","pinyin":"huáng fēng wù zhào","abbr":"hfwz","explanation":"犹言不守本分，胡乱行事。","source":{"text":"他决不容让生宝这样黄风雾罩地闹腾。","book":"柳青《创业史》第一部第十七章"},"usage":"作定语、状语；用于口语"},{"id":49168,"word":"黄麻紫书","pinyin":"huáng má zǐ shū","abbr":"hmzs","explanation":"皇帝的文告，用黄麻纸书写，用紫泥封缄，故称。同“黄麻紫泥”。","source":{"text":"黄麻紫书，照耀夜壑。","book":"清·钱谦益《福建道监察御史赠通议大夫太仆寺卿谥忠毅李公墓志铭》"},"similar":["黄麻紫泥"],"usage":"作宾语、定语；用于书面语"},{"id":49169,"word":"黄麻紫泥","pinyin":"huáng má zǐ ní","abbr":"hmzn","explanation":"皇帝的文告，用黄麻纸书写，用紫泥封缄，故称。","source":{"text":"圣明朝褒功尚贤，黄麻紫泥丹凤传，仙槎使节来九天。","book":"明·邵璨《香囊记·褒封》"},"similar":["黄麻紫书"],"usage":"作宾语、定语；用于书面语"},{"id":49170,"word":"黄齑淡饭","pinyin":"huáng jī dàn fàn","abbr":"hjdf","explanation":"指粗恶的饭食。同“黄齑白饭”。","source":{"text":"房德日常不过黄齑淡饭，尚且自不全，间或觅得些酒肉，也不能勾趁心醉饱。","book":"明·冯梦龙《醒世恒言》第三十卷"},"example":{"text":"叹寒儒，红炉缺炭冷难当，无奈何，拆了竹篱煎茶汤，～且充肠。","book":"《白雪遗音·八角鼓·雪映竹窗》"},"similar":["黄齑白饭"],"usage":"作主语、宾语、定语；用于生活"},{"id":49171,"word":"黄齑白饭","pinyin":"huáng jī bái fàn","abbr":"hjbf","explanation":"指粗恶的饭食。","source":{"text":"风雨萧条，衡门暂留，黄齑白饭度春秋。","book":"明·陈汝元《金莲记·焚券》"},"similar":["黄齑淡饭"],"usage":"作主语、宾语、定语；用于生活"},{"id":49172,"word":"黄龙痛饮","pinyin":"huáng lóng tòng yǐn","abbr":"hlty","explanation":"指彻底击败敌人，欢庆胜利。","source":{"text":"是以都门学界，纠合学界同志，连络全国人民，黄龙痛饮，岳武穆之是法；马革裹尸，汉伏波之未死。","book":"宋金交战，岳飞曾说要直捣黄龙府，与人痛饮。龚振黄《青岛潮》第十五章"},"example":{"text":"～炮千鸣，好与先生祝寿考。","book":"续范亭《五百字诗》序"},"similar":["痛饮黄龙"],"opposite":["败走麦城"],"usage":"作宾语、定语；指攻克敌人的首都","story":["北宋末年，北方女真族建立金国大举进攻北宋，消灭了北宋。宋钦宗的弟弟宋高宗建立南宋，南宋朝廷软弱无能，步步退让。岳飞指挥岳家军英勇抗金，金国士兵闻风丧胆，岳飞乘胜追击，他对将士们说：“我一定要直捣黄龙和你们痛饮。”"]},{"id":49173,"word":"黍油麦秀","pinyin":"shǔ yóu mài xiù","abbr":"symx","explanation":"以之为亡国之痛的感叹。","source":{"text":"《尚书大传》卷二：“微子朝周，过殷故墟，见麦秀之蕲蕲兮……曰：此父母之国。乃为《麦秀之歌》，曰：‘麦秀渐渐兮，禾黍油油。彼狡童兮，不我好仇！’”按，《史记·宋微子世家》亦载此事，“微子”作“箕子”。"},"example":{"text":"清·程秉钊《琼州杂事诗》：“大海西流近越裳，～事堪伤。”"},"similar":["黍离麦秀"],"usage":"作宾语、定语；用于哀伤亡国之辞","story":["西周灭亡后，周大夫长途跋涉来到西周都城，看到过去的宗庙宫室都成了长满禾黍的田地，触景伤怀作《黍离》诗。后来微子朝见周王时，路过殷墟，看到宫室毁坏，长满禾黍，作《麦秀》歌：“麦秀渐渐兮，禾黍油油。彼狡僮兮，不我好仇。”"]},{"id":49174,"word":"黍离之悲","pinyin":"shǔ lí zhī bēi","abbr":"slzb","explanation":"黍离：《诗经》篇名；悲：怜悯。指对国家残破，今非昔比的哀叹。","source":{"text":"黍离，闵宗周也。周大夫行役于宗周，过故宗庙宫室，尽为禾黍，闵周室之颠覆，彷徨不忍去，而作是诗也。","book":"《诗经·王风·黍离》序"},"example":{"text":"担心自己的生前会遭逢“～”，于是就换上青衣小帽，到午门前边谢恩。","book":"姚雪垠《李自成》第二卷第三十三章"},"similar":["禾黍之悲","禾黍之伤"],"usage":"作宾语；用于感伤等"},{"id":49175,"word":"黍离麦秀","pinyin":"shǔ lí mài xiù","abbr":"slmx","explanation":"哀伤亡国之辞。","source":{"text":"麦秀渐渐兮，禾黍油油。彼狡僮兮，不与我好兮。","book":"《诗经·王风·黍离》：“彼黍离离，彼稷之苗。行迈靡磨，中心摇摇。”西汉·司马迁《史记·宋微子世家》"},"example":{"text":"陛下试念《两都》、《～》之悲，则居处必不安。","book":"《清史稿·庄元辰》"},"similar":["故宫禾黍"],"usage":"作定语；用于哀伤亡国之辞","story":["相传西周灭亡后，周大夫长途跋涉来到西周都城，看到过去的宗庙宫室都成了长满禾黍的田地，触景伤怀，无限感慨，就作《黍离》诗一首。后来微子朝见周王时，路过殷墟，看到宫室毁坏，长满禾黍，非常哀伤，就作一首《麦秀》歌"]},{"id":49176,"word":"黍秀宫庭","pinyin":"shǔ xiù gōng tíng","abbr":"sxgt","explanation":"相传西周亡后，所有旧时的宗庙宫室尽为禾黍之地。后以之作为感慨亡国之词。","source":{"text":"麦秀渐渐兮，禾黍油油。彼狡僮兮，不与我好兮。","book":"《诗经·王风·黍离》：“彼黍离离，彼稷之苗。行迈靡磨，中心摇摇。”西汉·司马迁《史记·宋微子世家》"},"example":{"text":"机春水沚犹传晋，～孰悯周。","book":"宋·岳飞《题骤马冈》"},"similar":["黍离麦秀","故宫禾黍"],"usage":"作宾语、定语；用于哀伤亡国之辞","story":["相传西周灭亡后，周大夫长途跋涉来到西周都城，看到过去的宗庙宫室都成了长满禾黍的田地，触景伤怀，无限感慨，就作《黍离》诗一首。后来微子朝见周王时，路过殷墟，看到宫室毁坏，长满禾黍，非常哀伤，就作一首《麦秀》歌"]},{"id":49177,"word":"黎丘丈人","pinyin":"lí qiū zhàng rén","abbr":"lqzr","explanation":"黎丘：古地名，在今河南省城县北；丈人：古时对老人的统称。比喻困于假象、不察真情而陷入错误的人。","source":{"text":"梁北有黎丘部，有奇鬼焉，喜效人之子侄昆弟之状。邑丈人有之市而醉归者，黎丘之鬼效其子之状扶而道苦之。……丈人智惑于似其子者而杀其真子。","book":"《吕氏春秋·疑似》"},"usage":"作主语、宾语、定语；指人易迷惑","story":["春秋时期，魏国都城大梁北面黎丘山有一个黎丘丈人外出喝醉酒回家，遇到奇鬼变成他儿子的模样对他又打又踢。他回家后见儿子对他好好的，明白是奇鬼在作怪。第二天他想去杀奇鬼，竟把前来接他的儿子给杀了"]},{"id":49178,"word":"黎庶涂炭","pinyin":"lí shù tú tàn","abbr":"lstt","explanation":"形容人们处于水深火热的境地。","source":{"text":"黎庶涂炭，靡所控告。","book":"《晋书·刘元海载记》"},"example":{"text":"陛下以全国之势，不能一拒敌，弃国远遁，使～。","book":"清·毕沅《续资治通鉴》卷九十四"},"similar":["生灵涂炭"],"usage":"作宾语；指处于水深火热的境地"},{"id":49179,"word":"黎明即起，洒扫庭除","pinyin":"lí míng jí qǐ，sǎ sǎo tíng chú","abbr":"lmjqsstc","explanation":"黎明：天刚亮；庭：厅堂；除：台阶。天刚亮就起来，打扫庭堂院落。指治家过日子很勤谨。","source":{"text":"黎明即起，洒扫庭除，要内外整洁。","book":"明·朱伯庐《治家格言》"}},{"id":49180,"word":"黎民百姓","pinyin":"lí mín bǎi xìng","abbr":"lmbx","explanation":"指普通老百姓。","source":{"text":"那六街三市勋卫宰臣，黎民百姓，奉天子之命，与民同乐。","book":"清·褚人获《隋唐演义》第17回"},"similar":["平民百姓"],"opposite":["达官贵人"],"usage":"作主语、宾语、定语；指普通百姓"},{"id":49181,"word":"黏吝缴绕","pinyin":"nián lìn jiǎo rào","abbr":"nljr","explanation":"指胶着在一起，纠缠不休。","source":{"text":"善棋者，觉一处少屈，则经营他处，率以取胜；不善棋者，黏吝缴绕，不肯暂舍，率以取败。","book":"宋·李纲《与吕安老书》"},"similar":["粘吝缴绕"],"usage":"作谓语、定语；用于下棋等"},{"id":49182,"word":"黏皮带骨","pinyin":"nián pí dài gǔ","abbr":"npdg","explanation":"比喻拖沓，不洒脱。","source":{"text":"此来更自知所作韵俗，下笔不浏离，如禅家黏皮带骨语。","book":"宋·黄庭坚《钟离跋尾》"},"example":{"text":"不过一字一句，对偶雕琢之工，而天真兴致，则未可与道，其高者失之捕风捉影，而卑者坐于～。","book":"明·李东阳《麓堂诗话》"},"similar":["粘皮带骨","黏皮着骨"],"usage":"作宾语、定语；指人办事刻板"},{"id":49183,"word":"黏皮着骨","pinyin":"nián pí zhe gǔ","abbr":"npzg","explanation":"比喻拖沓，不洒脱。同“黏皮带骨”。","source":{"text":"此理本常理，但异端说得黏皮着骨。","book":"宋·罗大经《鹤林玉露》第十卷"},"similar":["黏皮带骨"],"usage":"作宾语、定语、状语；指人办事刻板","story":["相传宋朝时期，晁文元曾经多次问大隐者刘海蟾怎样才能求得长生不死的法子。刘海蟾大笑说：“人何曾死，而君乃畏之求生乎！所可死者，形也，不与俱灭者，固常在也。此理本常理，但异端说得黏皮着骨。”"]},{"id":49184,"word":"黏黏糊糊","pinyin":"nián nián hú hú","abbr":"nnhh","explanation":"指两者关系暧昧不清或办事粘连。","example":{"text":"她办事老是～的。"},"similar":["粘粘糊糊"],"usage":"作谓语、定语、状语；指关系粘"},{"id":49185,"word":"黑不溜秋","pinyin":"hēi bù liū qiū","abbr":"hblq","explanation":"形容黑得很难看。","source":{"text":"一个夏天过去，都晒得黑不溜秋。","book":"路遥《平凡的世界》第一卷第11章"},"example":{"text":"他长得～，十分难看。"},"opposite":["白白净净"],"usage":"作定语、状语；用于口语"},{"id":49186,"word":"黑云压城城欲摧","pinyin":"hēi yún yā chéng chéng yù cuī","abbr":"hyyccyc","explanation":"摧：毁坏。黑云密布在城的上空，好像要把城墙压塌似的。比喻恶势力一时嚣张造成的紧张局面。","source":{"text":"黑云压城城欲摧，甲光向日金鳞开。","book":"唐·李贺《雁门太守行》诗"},"example":{"text":"在～的关头上，郭老虽已高龄，但他忠贞之心坚如金石。","book":"刘白羽《雷电颂》"},"similar":["山雨欲来风满楼"],"opposite":["风平浪静"],"usage":"作定语；指紧张局面","story":["唐朝时期，国内藩镇割据，边境也不安宁，经常战火不断，将士们英勇抗击外族入侵。诗人李贺见此情景，深表忧虑，同时对将士们由衷敬佩。他即兴作诗《雁门太守行》：“黑云压城城欲摧，甲光向日金鳞开。”"]},{"id":49187,"word":"黑价白日","pinyin":"hēi jià bái rì","abbr":"hjbr","explanation":"不分昼夜，整天整夜。同“黑家白日”。","source":{"text":"萧队长黑价白日地工作。","book":"周立波《暴风骤雨》第一部六"},"similar":["黑家白日"],"usage":"作状语；用于口语"},{"id":49188,"word":"黑咕隆咚","pinyin":"hēi gū lōng dōng","abbr":"hgld","explanation":"很黑暗。","source":{"text":"他进了玉亭的家，窑里黑咕隆咚，弥漫着湿柴烧出的死烟。","book":"路遥《平凡的世界》第一卷第24章"},"example":{"text":"外面～的，没有手电可不成。"},"similar":["漆黑一团"],"usage":"作谓语、定语；形容很黑，用于口语"},{"id":49189,"word":"黑地昏天","pinyin":"hēi dì hūn tiān","abbr":"hdht","explanation":"形容极其黑暗腐朽。亦比喻黑暗腐朽的社会。","source":{"text":"然野蛮政府，黑地昏天，如此收场，弟来恐亦难免也。","book":"清·孙雨林《皖江血·狱会》"},"example":{"text":"唉唉，老梁呀老梁！深更半夜，～，你跑进那灵堂去干甚么？","book":"郭澄清《大刀记》开篇二"},"similar":["昏天黑地"],"usage":"作宾语、定语；用于天气等"},{"id":49190,"word":"黑天半夜","pinyin":"hēi tiān bàn yè","abbr":"htby","explanation":"指深更半夜。","source":{"text":"一个老汉说：‘黑天半夜怕什么！红星社不会有人来。’","book":"马烽《三年早知道》"},"example":{"text":"在这～里，坏人经常出来干坏事。"},"similar":["深更半夜"],"usage":"作宾语、定语；指深夜，用于口语"},{"id":49191,"word":"黑天墨地","pinyin":"hēi tiān mò dì","abbr":"htmd","explanation":"谓漆黑一团。同“黑天摸地”。","source":{"text":"张漆匠黑天墨地，心下慌张道：‘不知是恁缘故，叫我到此？’","book":"《西湖二集·天台匠误招乐趣》"},"example":{"text":"～的，不上床睡觉，还出去东串西串的？","book":"周克芹《山月不知心里事》"},"similar":["黑天摸地"],"usage":"作状语、定语；形容天黑得什么也看不见"},{"id":49192,"word":"黑天摸地","pinyin":"hēi tiān mō dì","abbr":"htmd","explanation":"形容天黑得什么也看不见。","source":{"text":"众军黑天摸地，不辨东西，只得下马受降。","book":"明·施耐庵《水浒传》第87回"},"example":{"text":"那王小二听言，一毂辘爬起来，～，又是着忙的人，捞着裤子当衫子，左穿也穿不上，右套也套不上。","book":"明·吴承恩《西游记》第84回"},"similar":["黑灯瞎火","漆黑一团"],"usage":"作状语、定语；形容天黑得什么也看不见"},{"id":49193,"word":"黑天白日","pinyin":"hēi tiān bái rì","abbr":"htbr","explanation":"白天和黑夜；整日整夜。","source":{"text":"工作队和农工会，黑天白日，川流不息地有人看望。","book":"周立波《暴风骤雨》第一部十五"},"example":{"text":"老婆子纺呀纺呀，～地纺。老头子织呀织呀，～地织，才织成了布。","book":"梁斌《播火记》二"},"similar":["没日没夜"],"usage":"作宾语、状语；用于口语"},{"id":49194,"word":"黑家白日","pinyin":"hēi jiā bái rì","abbr":"hjbr","explanation":"指白天夜间均是如此。形容某种活动持续不断而且不分昼夜。","source":{"text":"姐妹们和气，也有个分寸儿，也没个黑家白日闹的。凭人怎么劝，都是耳旁风。","book":"清·曹雪芹《红楼梦》第二回"},"example":{"text":"明日叫你～跟着我，我倒常笑笑儿，也不许你回屋里去。","book":"清·曹雪芹《红楼梦》第三十八回"},"similar":["黑价白日"],"usage":"作状语；用于口语"},{"id":49195,"word":"黑更半夜","pinyin":"hēi gēng bàn yè","abbr":"hgby","explanation":"指深夜。","source":{"text":"有好差使就派了别人；这样黑更半夜送人，就派我，没良心的忘八羔子！","book":"清·曹雪芹《红楼梦》第七回"},"example":{"text":"清·曹雪芹《红楼梦》第七回：“有好差使就派了别人；这样黑更半夜送人，就派我，没良心的忘八羔子！”"},"similar":["深更半夜"],"usage":"作宾语、定语；指深夜"},{"id":49196,"word":"黑汁白汗","pinyin":"hēi zhī bái hàn","abbr":"hzbh","explanation":"形容辛勤劳动的汗水。","source":{"text":"他又想起在朱家扛活时，掌柜们在大麦天，看着别人黑汁白汗干活，王老三也是摇着扇子站在一边看。","book":"李凖《不能走那条路》"},"usage":"作宾语、状语；用于口语"},{"id":49197,"word":"黑漆一团","pinyin":"hēi qī yī tuán","abbr":"hqyt","explanation":"①指墨团。②形容非常黑暗，没有一点光明。或对人对事一无所知。","source":{"text":"但是作为读者，我受不了那接连不断的黑漆一团的结尾。","book":"巴金《谈〈秋〉》"},"example":{"text":"可是社会和家庭一样，依然到处发着腐朽霉烂的臭味，～。","book":"杨沫《青春之歌》第一部第六章"},"similar":["漆黑一团"],"usage":"作谓语、定语；指黑暗"},{"id":49198,"word":"黑漆皮灯","pinyin":"hēi qī pí dēng","abbr":"hqpd","explanation":"不透光亮的灯笼。比喻糊涂、昏庸，不明事理。也指贪赃枉法的官吏，掩盖民间疾苦，对下只干坏事，对上只言好事。","source":{"text":"又歌曰：‘官吏黑漆皮灯笼，奉使来时添一重。’如此怨谣，未能枚举。","book":"明·陶宗仪《阑驾上书》"},"example":{"text":"这萧颖士又非～，泥塞竹管，是那一窃不通的蠢物。","book":"明·冯梦龙《醒世恒言》卷三十五卷"},"similar":["黑漆皮灯笼"],"usage":"作宾语；用于比喻句"},{"id":49199,"word":"黑漆皮灯笼","pinyin":"hēi qī pí dēng lóng","abbr":"hqpdl","explanation":"①涂以黑漆的灯笼。形容社会腐败黑暗。②形容懵然无知。","source":{"text":"赃吏贪婪而不问，良民涂炭而罔知。闾阎失望，田里寒心，乃歌曰：九重丹诏颁恩至，万两黄金奉使回……又歌曰：官吏黑漆皮灯笼，奉使来时添一重。","book":"明·陶宗仪《辍耕录·阑驾上书》"},"example":{"text":"手拿～，彼此都莫明其妙。","book":"鲁迅《花边文学·一思而行》"},"similar":["黑漆皮灯"],"usage":"作宾语、定语；用于比喻句"},{"id":49200,"word":"黑灯下火","pinyin":"hēi dēng xià huǒ","abbr":"hdxh","explanation":"形容黑暗没有灯光的情景。","source":{"text":"你始终也没进去。黑灯下火的教鞭教我和太太瞎抓。","book":"老舍《骆驼样子》十二"},"example":{"text":"下地做话，～走回来，一进门，有饭吃，一拎壶，有水渴。","book":"梁斌《红旗谱》十三"},"similar":["黑灯瞎火"],"usage":"作宾语、定语；形容黑暗没有灯光的情景"},{"id":49201,"word":"黑灯瞎火","pinyin":"hēi dēng xiā huǒ","abbr":"hdxh","explanation":"形容黑暗没有灯光。","source":{"text":"呵，你这个时侯，走什么，黑灯瞎火的。","book":"端木蕻良《科尔沁旗草原》八"},"example":{"text":"老二，这是怎么回事，～的把我找来。","book":"老舍《神拳》第二幕"},"similar":["漆黑一团","黑灯下火"],"opposite":["灯火辉煌"],"usage":"作宾语、定语；形容黑暗没有灯光的情景"},{"id":49202,"word":"黑牛生白犊","pinyin":"hēi niú shēng bá dǔ","abbr":"hnsbd","explanation":"黑色的母牛产下白色的牛犊。旧时迷信，指吉祥的预兆。","source":{"text":"宋人有好行仁义者，三世不懈。家无故黑牛生白犊，以问孔子。孔子曰：‘此吉祥也，以荐上帝。’","book":"《列子·说符》"}},{"id":49203,"word":"黑牛白角","pinyin":"hēi niú bái jiǎo","abbr":"hnbj","explanation":"形容办事一定要遵循一定的客观规律。","source":{"text":"詹何坐，弟子侍，有牛鸣于门外。","book":"战国·韩·韩非《韩非子·解老》"},"usage":"作宾语、定语；指恰中主观意想","story":["古代詹何坐在家里讲学，弟子们侍侯在一旁。有牛的叫唤声自门外传来，一弟子猜说是头黑牛，其前额是白色的。詹何用道术算了一下承认是黑牛，但白色的东西在牛角上，派人去验证原来是一头黑牛，牛角上包着一块白布"]},{"id":49204,"word":"黑甜一觉","pinyin":"hēi tián yī jiào","abbr":"htyj","explanation":"黑甜：酣睡。形容美美地睡了一大觉。","source":{"text":"三杯软饱后，一枕黑甜余。","book":"宋·苏轼《发广州》"},"example":{"text":"大家～，不知所之。","book":"清·曹雪芹《红楼梦》第六十三回"}},{"id":49205,"word":"黑白不分","pinyin":"hēi bái bù fēn","abbr":"hbbf","explanation":"不能分辨黑色和白色。比喻不辨是非，不分好坏。","source":{"text":"今贤不肖浑淆，白黑不分，邪正杂糅，忠谗并进。","book":"《汉书·楚元王传》"},"example":{"text":"可惜一个卖土委员的调查，一个小毛的申明，把事情弄得～了。","book":"赵树理《李家庄的变迁》十二"},"similar":["黑白混淆"],"opposite":["黑白分明"],"usage":"作谓语、定语、宾语；指故意制造混乱"},{"id":49206,"word":"黑白分明","pinyin":"hēi bái fēn míng","abbr":"hbfm","explanation":"黑色与白色对比鲜明。比喻事非界限很清楚。也形容字迹、画面清楚。","source":{"text":"黑白分明，然后民知所去就。","book":"汉·董仲舒《春秋繁露·保位权》"},"example":{"text":"再翻下去是穆少英先生的《墨绿衫的小姐》里，有三幅插画，有些象麦绥莱勒的手笔，～。","book":"鲁迅《花边文学·奇怪（三）》"},"similar":["泾渭分明","一清二楚"],"opposite":["不分皂白","混淆是非","颠倒黑白"],"usage":"作谓语、定语、状语；形容字迹、画面等","story":["隋唐时期，单雄信被尉迟恭打败回营，找到一字并肩王罗成。罗成听说战败的消息，就带兵出城迎战，只见尉迟恭一张黑脸非常难看，二话不说就上去厮打，几个回合下来，尉迟恭大败而逃"]},{"id":49207,"word":"黑白混淆","pinyin":"hēi bái hùn xiáo","abbr":"hbhx","explanation":"把黑的说成白的，将白的说成黑的。比喻故意颠倒是非，制造混乱。","source":{"text":"白黑溷淆，清浊同源。","book":"《后汉书·杨震传》"},"example":{"text":"……君子见斥，不人骤迁，章奏多决中旨，～，邪正倒置。","book":"《明史·聊让传》"},"similar":["混淆黑白","是非不分"],"opposite":["黑白分明"],"usage":"作谓语、宾语；指故意制造混乱","story":["东汉时期，太尉杨震为人正直，廉洁奉公，声望很高，被人称为“关西孔子”。汉安帝的乳母王圣和中常侍樊丰贪侈骄横，大兴土木，浪费惊人。杨震十分痛恨这种奢侈浪费的做法就上奏疏道：“如今白黑混淆，清浊不分，人们纷纷指责这种贪污风气。”"]},{"id":49208,"word":"黑眉乌嘴","pinyin":"hēi méi wū zuǐ","abbr":"hmwz","explanation":"眉毛和嘴脸都布满了黑灰。形容脸上很脏，很难看。","source":{"text":"弄的你黑眉乌嘴的，那里还象个大家子念书的孩子。","book":"清·曹雪芹《红楼梦》第二十四回"},"usage":"作谓语、定语；用于人的面貌等"},{"id":49209,"word":"黑眼定心","pinyin":"hēi yǎn dìng xīn","abbr":"hydx","explanation":"指看到某些事情后心里生气。","source":{"text":"我老汉一辈子就懂得大吃大喝，自在逍遥，无忧无虑，有些乡亲见了，虽然黑眼定心，我也不管他。","book":"韩起祥《刘巧团圆》"},"usage":"作宾语；用于口语"},{"id":49210,"word":"黑言诳语","pinyin":"hēi yán kuáng yǔ","abbr":"hyky","explanation":"犹言胡言乱语。指没有根据，不符实际的瞎说，或说胡话。","source":{"text":"异端乃曰道生天地，曰有物混成，先天地生。是道为天地前一物矣。天地尚未有，是物安在哉？且独成而非共由者矣，何以谓之道哉？谁生之哉？道家黑言诳语，大率类此。","book":"清·李塨《原道》"},"similar":["胡言乱语"],"usage":"作谓语、宾语；用于说话等"},{"id":49211,"word":"黑貂之裘","pinyin":"hēi diāo zhī qiú","abbr":"hdzq","explanation":"用黑貂皮做成的衣服。指豪华昂贵的衣服。","source":{"text":"明日来，抵掌而谈。李兑送苏秦明月之珠，和氏之璧，黑貂之裘，黄金百镒。","book":"《战国策·赵策一》"}},{"id":49212,"word":"黑风孽海","pinyin":"hēi fēng niè hǎi","abbr":"hfnh","explanation":"比喻环境、遭遇的险恶。","source":{"text":"噫，黑风孽海，飘泊多矣！珑（王珑）以稚齿韶颜，独能早登彼岸，度亦有善根哉！","book":"清·珠泉居士《雪鸿小记》"},"usage":"作宾语、定语；用于比喻句"},{"id":49213,"word":"黔突暖席","pinyin":"qián tū nuǎn xí","abbr":"qtnx","explanation":"原意是孔子、墨子四处周游，每到一处，坐席没有坐暖，灶突没有熏黑，又匆匆地到别处去了。形容忙于世事，各处奔走。","source":{"text":"是以圣哲之治，栖栖遑遑，孔席不暖，墨突不黔。","book":"《淮南子·修务训》：“孔子无黔突，墨子无暖席。”汉·班固《答宾戏》"},"usage":"作宾语、定语；用于处事"},{"id":49214,"word":"黔驴之技","pinyin":"qián lǘ zhī jì","abbr":"qlzj","explanation":"比喻有限的一点本领。","source":{"text":"唐·柳宗元《三戒·黔之驴》：“黔无驴，有好事者船载以入……放之山下。虎见之，庞然大物也，以为神……，驴一鸣，虎大骇……然往来视之，觉无异能者。……稍近益狎，荡倚冲冒，驴不胜怒，蹄之。虎因喜，计之曰：‘技止此耳！’因跳踉大啃，断其喉"},"example":{"text":"柳宗元曾经描写的～，也是一个很好的教训。","book":"毛泽东《一个极其重要的政策》"},"similar":["束手无策","无计可施","黔驴技穷"],"opposite":["力大无穷","神通广大"],"usage":"作主语、宾语；指有限的一点本领","story":["从前贵州一带没有毛驴，有一个好事者从北方运来一头毛驴放到山脚下吃草，山上的老虎发现了这个怪物，开始只有远远的望着，然后慢慢地靠近毛驴，被毛驴大叫吓了一跳，最后发现毛驴只能用蹄踢，再也没有别的本事就跳上去饱餐一顿"]},{"id":49215,"word":"黔驴之计","pinyin":"qián lǘ zhī jì","abbr":"qlzj","explanation":"比喻虚有其表，本领有限。","source":{"text":"唐·柳宗元《三戒·黔之驴》"},"example":{"text":"这些不法分子的～，早已被公安人员识破了。"},"similar":["黔驴技穷"],"usage":"作宾语；指人的本事"},{"id":49216,"word":"黔驴技孤","pinyin":"qián lǘ jì gū","abbr":"qljg","explanation":"比喻有限的一点本领。同“黔驴之技”。","source":{"text":"腐鼠堪惊，黔驴技孤。","book":"明·孙仁孺《东郭记·妾妇之道》"},"similar":["黔驴技尽"],"usage":"作主语、宾语、定语；指没有计谋了"},{"id":49217,"word":"黔驴技尽","pinyin":"qián lǘ jì jìn","abbr":"qljj","explanation":"黔：贵州。比喻有限的一点本领也已经用完了。","source":{"text":"特恐黔驴技尽，为诸乡亲羞耳。","book":"清·朱之瑜《答王师吉书》"},"similar":["黔驴技穷","黔驴技孤"],"usage":"作主语、宾语、定语；指没有计谋了"},{"id":49218,"word":"黔驴技穷","pinyin":"qián lǘ jì qióng","abbr":"qljq","explanation":"黔：今贵州省一带；技：技能；穷：尽。比喻有限的一点本领也已经用完了。","source":{"text":"唐·柳宗元《三戒·黔之驴》"},"example":{"text":"他们不过是～，想求个活命罢了。","book":"陈立德《前驱》三十八"},"similar":["无计可施","束手无策","黔驴技尽"],"opposite":["神通广大","力大无穷"],"usage":"作主语、宾语；指没有计谋了","story":["从前贵州一带没有毛驴，有一个好事者从北方运来一头毛驴放到山脚下吃草，山上的老虎发现了这个怪物，开始只有远远的望着，然后慢慢地靠近毛驴，被毛驴大叫吓了一跳，最后发现毛驴只能用蹄踢，再也没有别的本事就跳上去饱餐一顿"]},{"id":49219,"word":"默不作声","pinyin":"mò bù zuò shēng","abbr":"mbzs","explanation":"默：沉默。沉默不说一句话。","source":{"text":"秦守本默不作声。","book":"吴强《红日》第11章"},"example":{"text":"讨论会上，大家都对提出的问题踊跃发表意见，而他却一直～。"},"similar":["沉默寡言","默不做声"],"opposite":["口若悬河"],"usage":"作谓语、定语；指人不说话"},{"id":49220,"word":"默不做声","pinyin":"mò bù zuò shēng","abbr":"mbzs","explanation":"默：沉默。沉默不说一句话","source":{"text":"有片刻工夫，崇祯默不做声，","book":"姚雪垠《李自成》第一卷第一章"},"example":{"text":"林海音《孟珠的旅程》：“原来是我来了，把那个～的客人给冷落了。”"},"similar":["默不作声"],"opposite":["滔滔不绝"],"usage":"作谓语、定语；指人不说话"},{"id":49221,"word":"默化潜移","pinyin":"mò huà qián yí","abbr":"mhqy","explanation":"指人的思想或性格不知不觉受到感染、影响而发生了变化。同“潜移默化”。","source":{"text":"然后民知善之当为，恶之可耻，默化潜移，而服从乎圣人。","book":"明·吕坤《呻吟语·治道》"},"example":{"text":"其于风教，～，正自不小。","book":"清·黄六鸿《福惠全书·莅任·待绅士》"},"similar":["潜移默化","默换潜移"],"opposite":["无动于衷"],"usage":"作定语、状语；用于人的思想、作风等"},{"id":49222,"word":"默契神会","pinyin":"mò qì shén huì","abbr":"mqsh","explanation":"指从意识深处默默领会和揣摩事物所蕴含的精神气韵。","source":{"text":"然而骨法用笔以下一者可学，如其气韵，必在生知，固不可以巧密得，复不可以岁月到，默契神会，不知然而然也。","book":"宋·郭若虚《图画见闻志·论气韵非师》"},"example":{"text":"作诗者以此二种心法，～。","book":"清·叶燮《原诗》卷三"},"usage":"作谓语、宾语；用于交往等"},{"id":49223,"word":"默换潜移","pinyin":"mò huàn qián yí","abbr":"mhqy","explanation":"指暗中转换移易。","source":{"text":"喜得男儿争气，把红颜命格，默换潜移。","book":"清·李渔《奈何天·闹封》"},"similar":["默化潜移","潜移默化","默转潜移"],"opposite":["无动于衷"],"usage":"作定语、状语；用于人的思想、作风等"},{"id":49224,"word":"默然无声","pinyin":"mò rán wú shēng","abbr":"mrws","explanation":"默：静默。不声不响，一句话也不说。","source":{"text":"于是景帝默默无声。","book":"西汉·司马迁《史记·梁孝王世家》"},"similar":["默然无语","默默无声"],"usage":"作谓语、定语；指没有声音"},{"id":49225,"word":"默然无语","pinyin":"mò rán wú yǔ","abbr":"mrwy","explanation":"默：静默。不声不响，一句话也不说。","source":{"text":"鲁肃吃了一惊，默然无语。","book":"明·罗贯中《三国演义》第52回"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“但对胡雪岩来说，这数目太小了，不值一谈，所以乌先生佯作不知，～。”"},"similar":["默然无声"],"opposite":["滔滔不绝"],"usage":"作谓语、定语；指没有声音"},{"id":49226,"word":"默而识之","pinyin":"mò ér shí zhī","abbr":"mesz","explanation":"默：不语，不说话。识：记。把所见所闻默默记在心里。","source":{"text":"默而识之，学而不厌，诲人不倦，何有于我哉？","book":"《论语·述而》"},"example":{"text":"良哉孔子之言！～，一以贯之，故目击而道存，指掌而意喻。","book":"宋·释普济《五灯会元》卷十六"}},{"id":49227,"word":"默转潜移","pinyin":"mò zhuǎn qián yí","abbr":"mzqy","explanation":"指暗中转换移易。","source":{"text":"然试办采办羁縻东省运道，三年后采买有效，再议进止，是亦默转潜移之一术，执事以为何如？","book":"清·冯桂芬《致李伯相书》"},"similar":["默化潜移","潜移默化","默换潜移"],"opposite":["无动于衷"],"usage":"作定语、状语；用于人的思想、作风等"},{"id":49228,"word":"默默不语","pinyin":"mò mò bù yǔ","abbr":"mmby","explanation":"默默：不说话的样子。沉默着不说一句话。","source":{"text":"他见郭安默默不语，如有所思，便知必有心事。","book":"清·石玉昆《三侠五义》第40回"},"example":{"text":"他把手托住头额～的半天。","book":"老舍《老张的哲学》"},"similar":["默默无语"],"usage":"作谓语、定语、状语；指沉默"},{"id":49229,"word":"默默无声","pinyin":"mò mò wú shēng","abbr":"mmws","explanation":"默默：幽寂，没有声音。不声不响，一句话也不说。没有名声，不为人所知。","source":{"text":"于是景帝默默无声。","book":"西汉·司马迁《史记·梁孝王世家》"},"example":{"text":"他们是历史上无名无姓、～的奉献者。"},"similar":["默默无语","默默无闻"],"usage":"作谓语、定语；指没有名声"},{"id":49230,"word":"默默无言","pinyin":"mò mò wú yán","abbr":"mmwy","explanation":"默默：不出声。不声不响，闭口无言。","source":{"text":"今兹危蹙，赖尔筹谋，而竟默默无言，坐观成败。","book":"《维摩诘所说经·入不二法门品》：“时维摩诘默然无言。”《旧五代史·唐庄宗记》"},"example":{"text":"忧的我神思竭，～；愁的我魂胆丧，兢兢打战。","book":"元·无名氏《连环计》第二折"},"similar":["嘿嘿无言","默默无语"],"usage":"作谓语、宾语；指沉默不说话"},{"id":49231,"word":"默默无语","pinyin":"mò mò wú yǔ","abbr":"mmwy","explanation":"默默：不说话的样子。不声不响，闭口无言。","source":{"text":"杨御史见苏御史词色不顺，便默默无语。","book":"清·荑荻散人《玉娇梨》第一回"},"example":{"text":"山小姐看完，～。","book":"清·荻岸山人《平山冷燕》第15回"},"similar":["默默无言"],"usage":"作谓语、宾语；指沉默不说话"},{"id":49232,"word":"默默无闻","pinyin":"mò mò wú wén","abbr":"mmww","explanation":"无声无息，没人知道。指没有什么名声。","source":{"text":"仆虽无无，非志不立，故疾没世而无闻焉。","book":"《晋书·祖纳传》"},"example":{"text":"现在不知道他怎样，久没有听到消息了，那～的原因，或者就因为中国人还没有死完的缘故吧。","book":"鲁迅《华盖集·并非闲话（二）》"},"similar":["无声无息","昧昧无闻"],"opposite":["赫赫有名","大名鼎鼎"],"usage":"作谓语、定语、状语；指无声无息"},{"id":49233,"word":"黜奢崇俭","pinyin":"chù shē chóng jiǎn","abbr":"cscj","explanation":"革除奢华，崇尚俭仆。","source":{"text":"革除奢华，崇尚俭仆。"},"example":{"text":"本无所谓奢俭，而妄生分别以为之名，又为之教曰～。","book":"清·谭嗣同《仁学》二十"},"usage":"作谓语、宾语、定语；用于处世"},{"id":49234,"word":"黜幽陟明","pinyin":"chù yōu zhì míng","abbr":"cyzm","explanation":"指黜退昏愚的官员，晋升贤明的官员。","source":{"text":"孤以不才，任居藩长，大惧宗稷，歼覆待日。故招徒楚郢，飞檄京甸，志遵前典，黜幽陟明，庶七庙复安，海昏有绍。","book":"《宋书·邓琬传》"},"example":{"text":"有光等与于南宫之试，亲见天子～之典。","book":"明·归有光《送昆山县令朱侯序》"},"similar":["黜陟幽明"],"usage":"作谓语、宾语、定语；用于官场"},{"id":49235,"word":"黜昏启圣","pinyin":"chù hūn qǐ shèng","abbr":"chqs","explanation":"贬退昏庸，开启圣明。","source":{"text":"谢晦以佐命之功，当顾托之重，殷忧在日，黜昏启圣，于社稷之计，盖为大矣。","book":"《南史·谢灵运传论》"},"usage":"作谓语、定语；用于书面语"},{"id":49236,"word":"黜衣缩食","pinyin":"chù yī suō shí","abbr":"cyss","explanation":"节衣缩食，指在生活上省穿省吃，力求节约。","source":{"text":"于是黜衣缩食，重创大雄殿五楹间。","book":"明·宋濂《重建龙德大雄殿碑》"},"similar":["节衣缩食"],"usage":"作谓语、定语；同“节衣缩食”"},{"id":49237,"word":"黜邪崇正","pinyin":"chù xié chóng zhèng","abbr":"cxcz","explanation":"斥退奸邪，崇尚正直。","source":{"text":"庶几黜邪崇正，以为遐迩亲疏之永鉴云尔。","book":"太平天国·林一环《贬妖穴为罪恶隶论》"},"usage":"作谓语、宾语、定语；用于处世"},{"id":49238,"word":"黜陟幽明","pinyin":"chù zhì yōu míng","abbr":"czym","explanation":"指黜退昏愚的官员，晋升贤明的官员。","source":{"text":"黜退其幽者，升进其明者。","book":"《书·舜典》：“三载考绩，三考黜陟幽明。”孔传"},"example":{"text":"昔尧舜氏不下席而天下理者，盖～能折中尔。","book":"唐·陈子昂《上军国利害事·出使》"},"similar":["黜幽陟明"],"usage":"作谓语、宾语、定语；用于官场"},{"id":49239,"word":"黜陟赏罚","pinyin":"chù zhì shǎng fá","abbr":"czsf","explanation":"黜陟：官吏的进退升降。指官吏的赏赐、惩罚和官职的升降。","source":{"text":"巡察州镇十有余所，黜陟赏罚莫不咸允。","book":"《魏书·宋世景传》"},"example":{"text":"非天子～之臣，而得以论百官之长短。","book":"宋·苏辙《进策五道·第一道》"}},{"id":49240,"word":"黩武穷兵","pinyin":"dú wǔ qióng bīng","abbr":"dwqb","explanation":"黩：随便，任意；穷：竭尽。随意使用武力，不断发动侵略战争。形容极其好战。","source":{"text":"若使翌日之瘳无爽，经营之志获申，黩武穷兵，虽见讥于良吏。","book":"《周书·武帝纪论》"},"example":{"text":"予谓孝文之仁德如此，与武帝～。","book":"宋·洪迈《容斋三笔·汉文帝不用兵》"},"similar":["穷兵黩武","兴师动众"],"opposite":["和平共处"],"usage":"作谓语、定语、宾语；指发动战争","story":["三国时期，吴国皇帝孙皓是一个十足的暴君，他任用那些拍马屁的小人做大官，大兴土木，建豪华宫殿。同时还不断扩充军队，使军队的人数占百姓人数的十分之一，军费开支庞大，陆抗打败晋军的进攻后上书孙皓，让他不要再继续穷兵黩武"]},{"id":49241,"word":"黯晦消沉","pinyin":"àn huì xiāo chén","abbr":"ahxc","explanation":"指湮没消失。","source":{"text":"凡有绝大之战争，往往赖有雄伟之文，淋漓之诗歌，而后其印象日留于国民心目之间。否则，不数年间而黯晦消沉以尽。","book":"蒋智由《序》"},"usage":"作谓语、定语；指消失"},{"id":49242,"word":"黯淡无光","pinyin":"àn dàn wú guāng","abbr":"adwg","explanation":"黯淡：同“暗淡”，不明亮，昏暗。形容失去光彩。","source":{"text":"头上戴一个黯淡无光的亮蓝顶儿，那枝俏摆春风的孔雀瓴已经虫蛀的剩了光杆儿了。","book":"清·文康《儿女英雄传》第三十四回"},"example":{"text":"但是这个电报却又引起了张勋的不愉快，因为，他的十三省盟主地位因此而～。","book":"陶菊隐《北洋军阀统治时期史话》第二十四章"},"similar":["暗淡无光","黯然无光"],"opposite":["金光灿烂"],"usage":"作谓语、定语；指自然或社会"},{"id":49243,"word":"黯然伤神","pinyin":"àn rán shāng shén","abbr":"arss","explanation":"沮丧的样子。情绪低沉，心神忧伤。","source":{"text":"黯然销魂者，惟别而已矣。","book":"梁·江淹《别赋》"},"example":{"text":"篝灯询母，如秋蝶～。","book":"清·淮阳百一居士《壶天录》上卷"},"similar":["黯然神伤"],"usage":"作谓语、定语；用于个人情绪不好"},{"id":49244,"word":"黯然失色","pinyin":"àn rán shī sè","abbr":"arss","explanation":"黯然：心里不舒服、情绪低落的样子；失色：因惊恐而变以脸色。本指心怀不好，脸色难看。后多比喻相形之下很有差距，远远不如。","source":{"text":"黯然，失色貌","book":"南朝·梁·江淹《别赋》：“黯然销魂者，惟别而已矣。”李善注"},"example":{"text":"所有同类题材的绘画和它比较起来，都～。","book":"秦牧《艺海拾贝·〈最后的晚餐〉》"},"similar":["相形见绌","大相径庭"],"opposite":["光彩夺目","不相上下"],"usage":"作谓语、宾语；用于两者比较，差的更差"},{"id":49245,"word":"黯然无光","pinyin":"àn rán wú guāng","abbr":"arwg","explanation":"失去光彩。","source":{"text":"因为思想水平低下，作品也就难免黯然无光。","book":"秦牧《哲人·小孩》"},"similar":["黯淡无光"],"opposite":["光彩夺目"],"usage":"作谓语、定语；指没有光彩"},{"id":49246,"word":"黯然无神","pinyin":"àn rán wú shén","abbr":"arws","explanation":"黯然：心情抑郁沮丧的样子。无精打采。","source":{"text":"一双聪颖的眼睛显得黯然无神，那顽皮的嘴角也流露出一种无法诉说的焦急。","book":"何为《第二次考试》"},"similar":["无精打采"],"opposite":["精神抖擞"],"usage":"作谓语、定语；指人的外表"},{"id":49247,"word":"黯然无色","pinyin":"àn rán wú sè","abbr":"arws","explanation":"指事物失去原有光彩，变得暗淡无光。","source":{"text":"昔东坡居士作枯木竹石，使有枯木石而无竹，则黯然无色矣。","book":"清·郑燮《题画竹》"},"example":{"text":"阳光孤零零地落在街心上，也觉～。","book":"邓宁《红色故乡随笔》"},"similar":["暗淡无光"],"opposite":["绚丽多彩"],"usage":"作谓语、定语；一般指物体"},{"id":49248,"word":"黯然神伤","pinyin":"àn rán shén shāng","abbr":"arss","explanation":"指心神悲沮的样子。","source":{"text":"女更黯然神伤，泫然流涕。","book":"清·百一居士《壶天录》"},"example":{"text":"这个满脸胡须的中年人，扫头看见了船尾妇妇，～的目光突然发亮了。","book":"从维煕《遗落在海滩上的脚印》"},"similar":["黯然泪下"],"opposite":["悠然自得"],"usage":"作谓语、定语；形容极度悲伤或忧愁"},{"id":49249,"word":"黯然销魂","pinyin":"àn rán xiāo hún","abbr":"arxh","explanation":"黯然：心怀沮丧、面色难看的样子；销魂：灵魂离开肉体。心怀沮丧得好像丢了魂似的。形容非常悲伤或愁苦。","source":{"text":"黯然销魂者，惟别而已矣。","book":"南朝·梁·江淹《别赋》"},"example":{"text":"“无言独上西楼”，深闺的空寥，弥漫在漠漠的冥色里，离情别绪，～！","book":"郭枫《且饮一杯寂寞》"},"similar":["六神无主","丧魂失魄","失魂落魄"],"opposite":["怡然自得","洋洋得意"],"usage":"作谓语、宾语、定语；形容人悲伤或愁苦"},{"id":49250,"word":"黯然魂消","pinyin":"àn rán hún xiāo","abbr":"arhx","explanation":"心神极度沮丧，好像失去了灵魂。","source":{"text":"悲者黯然魂消而不致反有喜色，欢者恰然自得而不见稍有瘁容。","book":"清·李渔《闲情偶寄·授曲第三》"}},{"id":49251,"word":"黯然魂销","pinyin":"àn rán hún xiāo","abbr":"arhx","explanation":"黯然：心神沮丧的样子；魂销：灵魂离开了躯壳。形容心情极其沮丧、哀痛，以致心神无主的样子。","source":{"text":"悲者黯然魂销而不致反有喜色，欢者怡然自得而不见稍有瘁容。","book":"清·李渔《闲情偶寄·授曲第三》"},"similar":["黯然销魂"],"opposite":["洋洋得意"],"usage":"作谓语、宾语、定语；形容人悲伤或愁苦"},{"id":49252,"word":"黼国黻家","pinyin":"fǔ guó fú jiā","abbr":"fgfj","explanation":"指国家文教之治，美如锦绣。"},{"id":49253,"word":"黼蔀黻纪","pinyin":"fǔ bù fú jì","abbr":"fbfj","explanation":"指锦绣美好的年代。","source":{"text":"自古重熙累洽之朝，则有康疆竺巩之佐，赞醲迪薰，黼蔀黻纪，相一人而寿世，为百族之福宗。","book":"清·龚自珍《阮尚书年谱第一序》"},"usage":"作谓语、宾语；用于书面语"},{"id":49254,"word":"黼衣方领","pinyin":"fǔ yī fāng lǐng","abbr":"fyfl","explanation":"华贵的服饰。借指王公显贵。"},{"id":49255,"word":"黼黻文章","pinyin":"fǔ fú wén zhāng","abbr":"ffwz","explanation":"古代礼服上所绣的色彩绚丽的花纹。泛指华美鲜艳的色彩。","source":{"text":"故赠人以言，重于金石珠玉；观人以言，美于黼黻文章。","book":"《荀子非相》"},"example":{"text":"内坐一女，年纪三十许，～，光明夺目。","book":"清·程麟《此中人语·曾睹瑶池仙客》"},"usage":"作宾语、定语；用于色彩等"},{"id":49256,"word":"黼黻皇猷","pinyin":"fǔ fú huáng yóu","abbr":"ffhy","explanation":"犹言辅佐朝廷。"},{"id":49257,"word":"黾勉从事","pinyin":"mǐn miǎn cóng shì","abbr":"mmcs","explanation":"黾勉：努力。努力工作。","source":{"text":"黾勉从事，不敢告劳》","book":"《诗经·小雅·十月之交》"},"example":{"text":"虽～，人不告劳，而悯悼积哀，余实知愧。","book":"唐·陆贽《重优复兴元府及洋凤州百姓等诏》"},"similar":["僶俛从事"],"usage":"作谓语；指努力工作"},{"id":49258,"word":"黾穴鸲巢","pinyin":"měng xué qú cháo","abbr":"mxqc","explanation":"蚌洞鸟窝。比喻贫民的居处。"},{"id":49259,"word":"鼋鸣鳖应","pinyin":"yuán míng biē yìng","abbr":"ymby","explanation":"鼋：一种生水动物，也称“绿团鱼”。鼋一叫，鳖就答应。比喻互相感应，一倡一和。","source":{"text":"高祖踞洗，以对郦生，当此之会，乃鼋鸣而鳖应也，故能同心戮力。","book":"《后汉书·张衡传》"},"example":{"text":"～，见机而作，宜各鸠率子弟，共建功名。","book":"《旧唐书·李密传》"},"usage":"作宾语、定语；指一倡一和"},{"id":49260,"word":"鼍愤龙愁","pinyin":"tuó fèn lóng chóu","abbr":"tflc","explanation":"鼍：扬子鳄。如鼍愤怒，如龙忧愁。比喻乐曲的情调悲愤。","source":{"text":"谁言万方声一概，鼍愤龙愁为余变。","book":"宋·苏轼《过江夜行武昌山上闻黄州鼓角》诗"},"usage":"作宾语、定语；用于书面语"},{"id":49261,"word":"鼍鸣鳖应","pinyin":"tuó míng biē yìng","abbr":"tmby","explanation":"鼍：扬子鳄。比喻声气相通互相感应。","source":{"text":"豹变鹊起，今也其时，鼍鸣鳖应，见机而作。","book":"《旧唐书·李密传》"},"usage":"作宾语、定语；用于书面语"},{"id":49262,"word":"鼎分三足","pinyin":"dǐng fēn sān zú","abbr":"dfsz","explanation":"比喻三方分立，互相抗衡。同“鼎足三分”。","source":{"text":"今番克敌制胜，谁人及得先生良法。正是鼎分三足，缺一不可。先生不必推却。","book":"《水浒传》第二十回"},"similar":["鼎足三分"],"usage":"作宾语、定语；指三方分立"},{"id":49263,"word":"鼎力扶持","pinyin":"dǐng lì fú chí","abbr":"dlfc","explanation":"鼎力：大力；扶持：帮助，支持。大力支持帮助。一般用于请人帮助时的客气话。"},{"id":49264,"word":"鼎力相助","pinyin":"dǐng lì xiāng zhù","abbr":"dlxz","explanation":"鼎力：大力；助：帮助，支持。大力支持帮助。一般用于请人帮助时的客气话。"},{"id":49265,"word":"鼎成龙升","pinyin":"dǐng chéng lóng shēng","abbr":"dcls","explanation":"指帝王去世。同“鼎成龙去”。","source":{"text":"高庙鼎成龙升之日，建文即位，成祖以燕王来，奔而不朝，盖以叔不拜侄也。","book":"明·郎瑛《七修类稿·国事一·象简龙衣联》"},"similar":["鼎成龙去","鼎湖龙去"],"usage":"作宾语、定语；指帝王去世"},{"id":49266,"word":"鼎成龙去","pinyin":"dǐng chéng lóng qù","abbr":"dclq","explanation":"指帝王去世。","source":{"text":"黄帝采首山铜，铸鼎於荆山下。鼎既成，有龙垂胡曈下迎黄帝。黄帝上骑，群臣后宫从上者七十馀人，龙乃上去。","book":"《史记·封禅书》"},"example":{"text":"已被昭阳人妒，更那堪、～。","book":"宋·刘克庄《水龙吟》词"},"similar":["鼎成龙升"],"usage":"作宾语、定语；指帝王去世"},{"id":49267,"word":"鼎折覆餗","pinyin":"dǐng shé fù sù","abbr":"dsfs","explanation":"比喻力薄任重，必致灾祸。","source":{"text":"施之于人，知小而谋大，力薄而任重，如此必受其至辱，灾及其身也，故曰其形渥，凶。","book":"《易·鼎》：“九四，鼎折足，覆公餗，其形渥，凶。”孔颖达疏"},"example":{"text":"或纯任权术，或曲谨小廉，依恃宽大，自命贤相，恐～之讥，不待终日矣，可不危与！","book":"清·陈康祺《郎潜纪闻》卷九"},"similar":["鼎折餗覆"],"usage":"作宾语、定语；用于书面语"},{"id":49268,"word":"鼎折覆餸","pinyin":"dǐng shé fù sù","abbr":"dsfs","explanation":"比喻力薄任重，必致灾祸。","source":{"text":"九四，鼎折足，覆公餸，其形渥，凶。孔颖达疏施之于人，知小而谋大，力薄而任重，如此必受其至辱，灾及其身也，故曰其形渥，凶。","book":"《易·鼎》"},"quote":{"text":"或纯任权术，或曲谨小廉，依恃宽大，自命贤相，恐～之讥，不待终日矣，可不危与！","book":"清·陈康祺《郎潜纪闻》卷九"}},{"id":49269,"word":"鼎折餗覆","pinyin":"dǐng shé sù fù","abbr":"dssf","explanation":"比喻力薄任重，必致灾祸。","source":{"text":"参见“鼎折覆餗”。"},"example":{"text":"如吾子言，几欲举全国命脉托诸此辈，一旦～，后事云胡可问。","book":"梁启超《中国立国大方针》"},"similar":["鼎折覆餗"],"usage":"作宾语、定语；用于书面语"},{"id":49270,"word":"鼎折餸覆","pinyin":"dǐng shé sù fù","abbr":"dssf","explanation":"比喻力薄任重，必致灾祸。","source":{"text":"参见鼎折覆餸。"},"quote":{"text":"如吾子言，几欲举全国命脉托诸此辈，一旦～，后事云胡可问。","book":"梁启超《中国立国大方针》"}},{"id":49271,"word":"鼎新革故","pinyin":"dǐng xīn gé gù","abbr":"dxgg","explanation":"旧指朝政变革或改朝换代。现泛指除掉旧的，建立拳的。","source":{"text":"革，去故也，鼎，取新也。","book":"《周易·杂卦》"},"example":{"text":"速沾雨露，以就去邪归正之心；毋犯雷霆，当效～之意。","book":"明·施耐庵《水浒全传》第八十回"},"similar":["推陈出新","涤故更新","破旧立新"],"opposite":["因循守旧"],"usage":"作谓语、定语；形容破旧立新"},{"id":49272,"word":"鼎水之沸","pinyin":"dǐng shuǐ zhī fèi","abbr":"dszf","explanation":"像鼎中的水沸腾一样。形容局势不安定。有时也用以形容人声嘈杂。","source":{"text":"既非秦末鼎沸之时，实有六国并据之势。","book":"《三国志·蜀志·谯周传》"}},{"id":49273,"word":"鼎湖龙去","pinyin":"dǐng hú lóng qù","abbr":"dhlq","explanation":"指帝王去世。同“鼎成龙去”。","source":{"text":"鼎湖龙去远，银海雁飞深。","book":"唐·杜甫《骊山》诗"},"example":{"text":"～不复返，只有雁鹜飞茫茫。","book":"明·秦夔《同金广信宗器游番湖》诗"}},{"id":49274,"word":"鼎玉龟符","pinyin":"dǐng yù guī fú","abbr":"dygf","explanation":"旧指传国之宝及受命之符箓。","source":{"text":"干戈揖让取之也殊途，鼎玉龟符成之也一致。","book":"清·叶廷琯《海录碎事·帝王上》"},"usage":"作宾语、定语；用于书面语"},{"id":49275,"word":"鼎足三分","pinyin":"dǐng zú sān fēn","abbr":"dzsf","explanation":"鼎：古代炊具，三足两耳。比喻三方分立，互相抗衡。","source":{"text":"臣愿披腹心，输肝胆，效愚计，恐足下不能用也。诚能听臣之计，莫若两利而俱存之，三分天下，鼎足而居，其势莫敢先动。","book":"《史记·淮阴侯列传》"},"example":{"text":"汉家王气已将尽，～各自雄。","book":"元·无名氏《隔江斗智》第二折"},"similar":["三足鼎立","鼎足而三"],"usage":"作宾语、定语；指三方分立"},{"id":49276,"word":"鼎足之势","pinyin":"dǐng zú zhī shì","abbr":"dzzs","explanation":"比喻三方面并立的局面。","source":{"text":"臣愿披腹心，输肝胆，效愚计，恐足下不能用也。诚能听臣之计，莫若两利而俱存之，三分天下，鼎足而居，其势莫敢先动。","book":"《史记·淮阴侯列传》"},"example":{"text":"先取荆州为家，后即取四川建基业，以成～，然后可图中原也。","book":"明·罗贯中《三国演义》第三十八回"},"similar":["鼎足而立"],"usage":"作宾语；指三方面相持","story":["公元前203年，汉将韩信灭了齐国，被刘邦封为齐王，韩信的谋士蒯通分析天下形势后认为韩信是一个举足轻重的人物，劝他不要跟随刘邦自立为王，可以与楚汉三分天下，跟随刘邦最多也只能封为诸侯。韩信不听蒯通的意见，最后被吕后诱杀"]},{"id":49277,"word":"鼎足而三","pinyin":"dǐng zú ér sān","abbr":"dzes","explanation":"比喻三方面对立的局势。也泛指三个方面。","source":{"text":"臣愿披腹心，输肝胆，效愚计，恐足下不能用也。诚能听臣之计，莫若两利而俱存之，三分天下，鼎足而居，其势莫敢先动。","book":"《史记·淮阴侯列传》"},"example":{"text":"老头儿在席上，看着安老夫妻的这个佳儿，这双佳妇，～，未免因羡生感，因感生叹。","book":"清·文康《儿女英雄传》第三十二回"},"similar":["鼎足而立"],"usage":"作谓语、定语；指三分天下"},{"id":49278,"word":"鼎足而居","pinyin":"dǐng zú ér jū","abbr":"dzej","explanation":"像鼎的三足分立那样。比喻三方面对立的局势。","source":{"text":"臣愿披腹心，输肝胆，效愚计，恐足下不能用也。诚能听臣之计，莫若两利而俱存之，三分天下，鼎足而居，其势莫敢先动。","book":"西汉·司马迁《史记·淮阴侯列传》"},"similar":["鼎足而立"],"usage":"作谓语、定语；用于书面语","story":["公元前203年，汉将韩信灭了齐国，被刘邦封为齐王，韩信的谋士蒯通分析天下形势后认为韩信是一个举足轻重的人物，劝他不要跟随刘邦自立为王，可以与楚汉三分天下，跟随刘邦最多也只能封为诸侯。韩信不听蒯通的意见，最后被吕后诱杀"]},{"id":49279,"word":"鼎足而立","pinyin":"dǐng zú ér lì","abbr":"dzel","explanation":"象鼎的三只脚一样，三者各立一方。比喻三方面分立相持的局面。","source":{"text":"方今为足下计，莫若两利而俱存之，叁分天下，鼎足而立，其势莫敢先动。","book":"东汉·班固《汉书·蒯通传》"},"example":{"text":"三个主峰，高风峻骨，～，撑起青天。","book":"徐迟《黄山记》"},"similar":["三足鼎立","鼎足而三","相持不下"],"opposite":["归于一统","合而为一","定于一尊"],"usage":"作谓语、定语；用于书面语","story":["公元前203年，汉将韩信灭了齐国，被刘邦封为齐王，韩信的谋士蒯通分析天下形势后认为韩信是一个举足轻重的人物，劝他不要跟随刘邦自立为王，可以与楚汉三分天下，跟随刘邦最多也只能封为诸侯。韩信不听蒯通的意见，最后被吕后诱杀"]},{"id":49280,"word":"鼎铛有耳","pinyin":"dǐng chēng yǒu ěr","abbr":"dcye","explanation":"鼎、铛：均为两耳三足的金属炊具。电鼎和铛都有耳朵。指某人或某事影响大，凡是长耳朵的都应该听说、知道。","source":{"text":"太祖宠待赵韩王（普）如左右手。御史中丞雷德骧劾奏赵普擅市人第宅，聚敛财贿。上怒叱曰：‘鼎铛尚有耳，汝不闻赵普吾之社稷臣乎？’","book":"宋·司马光《涑水记闻》"},"usage":"作宾语、定语；用于反问句"},{"id":49281,"word":"鼎铛玉石","pinyin":"dǐng chēng yù shí","abbr":"dcys","explanation":"视鼎如铛，视玉如石。形容生活极端奢侈。","source":{"text":"鼎铛玉石，金块珠砾。","book":"唐·杜牧《阿房宫赋》"},"similar":["穷奢极侈"],"usage":"作宾语、定语；形容生活奢侈"},{"id":49282,"word":"鼎镬刀锯","pinyin":"dǐng huò dāo jù","abbr":"dhdj","explanation":"鼎：古代烹用的青铜器物。镬：大锅。鼎镬：是古代的酷刑刑具，用以把人煮死。指古代四种酷刑的刑具，引用指称最残酷的刑罚。","source":{"text":"真知夫进退得丧死生祸福之不足以累吾心，则虽鼎镬刀锯，视之如寝饭之安矣。","book":"宋·罗大经《鹤林玉露》第四卷"},"example":{"text":"恬然坐受其～，不以为怪，固已大可怪矣。","book":"清·谭嗣同《仁学》"},"similar":["刀锯鼎镬"],"usage":"作主语、宾语；指酷刑"},{"id":49283,"word":"鼎镬如饴","pinyin":"dǐng huò rú yí","abbr":"dhry","explanation":"饴：麦芽糖，糖浆。受酷刑像吃糖一样。形容无所畏惧，视死如归。","source":{"text":"鼎镬甘如饴，求之不可得。","book":"宋·文天祥《正气歌》"},"usage":"作宾语、定语；用于对待死的态度"},{"id":49284,"word":"鼎食钟鸣","pinyin":"dǐng shí zhōng míng","abbr":"dszm","explanation":"钟：古代乐器；鼎：古代炊器。击钟列鼎而食。形容贵族的豪华排场。","source":{"text":"闾阎扑地，钟鸣鼎食之家。","book":"《史记·货殖列传》：“洒削，薄技也，而郅氏鼎食。马医浅方，张里击钟。”唐·王勃《滕王阁序》"}},{"id":49285,"word":"鼎食鸣钟","pinyin":"dǐng shí míng zhōng","abbr":"dsmz","explanation":"鼎：古代炊器；钟：古代乐器。击钟列鼎而食。形容贵族的豪华生活排场。","source":{"text":"将期乎鼎食鸣钟，宁虞往吝。","book":"宋·王禹偁《贤人不家食赋》"},"example":{"text":"拥侯封～，赖朝廷破格推崇。","book":"明·张景《飞丸记·埋轮没产》"},"similar":["钟鸣鼎食"],"usage":"作宾语、定语；形容贵族的豪华生活排场"},{"id":49286,"word":"鼎食鸣锺","pinyin":"dǐng shí míng zhōng","abbr":"dsmz","explanation":"击钟列鼎而食。形容贵族的豪华生活排场。同“鼎食鸣钟”。"},{"id":49287,"word":"鼎鱼幕燕","pinyin":"dǐng yú mù yàn","abbr":"dymy","explanation":"宛如鼎中游动的鱼，帷幕上筑巢的燕子。比喻处于极危险境地的人或事物。","source":{"text":"而将军鱼游于沸鼎之中，燕巢于飞幕之上，不亦惑乎。","book":"南朝·梁·丘迟《与陈伯之书》"},"example":{"text":"～，亡在旦夕。","book":"《元史·外夷传》"},"similar":["釜底游鱼"],"usage":"作定语、宾语；比喻极其危险"},{"id":49288,"word":"鼎鼎大名","pinyin":"dǐng dǐng dà míng","abbr":"dddm","explanation":"形容名气很大。","source":{"text":"你一到京打听人家，像他这样大名鼎鼎，还怕有不晓得的。","book":"清·李宝嘉《官场现形记》第二十四回"},"example":{"text":"为我们讲经学的一位～的成都名士只拿着一本《左传事纬》照本宣科。","book":"郭沫若《少年时代·反正前后》"},"similar":["赫赫有名","闻名遐尔","举世闻名"],"opposite":["无名鼠辈","无声无息","不见经传"],"usage":"作宾语、定语；指名气大"},{"id":49289,"word":"鼎鼎有名","pinyin":"dǐng dǐng yǒu míng","abbr":"ddym","explanation":"鼎鼎：盛大的样子。非常有名。","source":{"text":"残岁堂堂去，新春鼎鼎来。","book":"宋·陆游《岁晚书怀》"},"example":{"text":"走在最后的两个穿布长衫的老头子，是～的委员呢。","book":"叶圣陶《某镇纪事》"},"similar":["赫赫有名","举世闻名","如雷贯耳"],"opposite":["默默无闻","无声无息","碌碌无为"],"usage":"作谓语、定语；指出名"},{"id":49290,"word":"鼎鼐调和","pinyin":"dǐng nai tiáo hé","abbr":"dnth","explanation":"比喻处理国政。","source":{"text":"相传商武丁问傅说治国之方，傅以如何调和鼎中之味喻说，遂辅武丁以治国。"},"example":{"text":"～理庶民，安邦定国立功勋。","book":"元·郑光祖《老君堂》第二折"},"usage":"作宾语、定语；用于比喻句"},{"id":49291,"word":"鼓乐喧天","pinyin":"gǔ yuè xuān tiān","abbr":"gyxt","explanation":"鼓：弹奏。喧天：声音大而嘈杂。弹奏着各种乐器，声响大得直冲云天。形容十分欢乐热闹。","source":{"text":"笙歌聒地，鼓乐喧天。","book":"《五代史平话·汉史》"},"example":{"text":"郭小川《厦门风姿》：“我们城里的市声啊，烘托得有如～。”"},"similar":["鼓吹喧阗"],"usage":"作谓语、定语、宾语；用于热闹场面"},{"id":49292,"word":"鼓乐齐鸣","pinyin":"gǔ yuè qí míng","abbr":"gyqm","explanation":"击鼓和奏乐声一齐响。形容热闹景象。","source":{"text":"群众起来，鼓乐齐鸣。","book":"郭沫若《虎符》第二幕"},"example":{"text":"一时间，张灯结彩，～，大街上热闹非凡。"},"similar":["锣鼓喧天"],"usage":"作谓语、定语；指气氛热烈"},{"id":49293,"word":"鼓刀屠者","pinyin":"gǔ dāo tú zhě","abbr":"gdtz","explanation":"鼓刀：操刀。宰杀牲口的屠夫。旧指社会地位低下的人。","source":{"text":"君乃市井鼓刀屠者，而公子亲数存之。","book":"《史记·信陵君列传》"},"example":{"text":"西汉·司马迁《史记·信陵君列传》：“朱亥笑曰：‘臣乃市井～，而公子亲数存之。’”"},"usage":"作主语、宾语、定语；指屠夫"},{"id":49294,"word":"鼓吹喧阗","pinyin":"gǔ chuī xuān tián","abbr":"gcxt","explanation":"形容音乐演奏的声音嘈杂热闹。","source":{"text":"离店家不上五六里之地，只是后面鼓吹喧阗，回头观看，灯火烛天。","book":"《醒世姻缘传》第九三回"},"example":{"text":"家中早已挂灯结彩，～。","book":"《孽海花》第三回"},"similar":["鼓乐喧天"],"usage":"作谓语、定语、状语；用于热闹场面"},{"id":49295,"word":"鼓吻奋爪","pinyin":"gǔ wěn fèn zhǎo","abbr":"gwfz","explanation":"犹言张牙舞爪。形容猛兽凶恶可怕。也比喻猖狂凶恶。","source":{"text":"言下狼复鼓吻奋爪以向先生。","book":"明·马中锡《中山狼传》"},"usage":"作谓语、定语；用于猛兽等"},{"id":49296,"word":"鼓吻弄舌","pinyin":"gǔ wěn nòng shé","abbr":"gwns","explanation":"指鼓弄唇舌。","source":{"text":"又有一个枭鸟，在秋心院上，鼓吻弄舌，叫得跛脚毛发森竖！","book":"《花月痕》第四四回"},"usage":"作谓语、宾语；用于说话等"},{"id":49297,"word":"鼓唇咋舌","pinyin":"gǔ chún zǎ shé","abbr":"gczs","explanation":"形容耍弄嘴皮进行挑拨煽动。同“鼓唇摇舌”。","source":{"text":"而胥吏衙役辈鼓唇咋舌，欲以罔利。","book":"清·钱泳《履园丛话·旧闻·席氏多贤》"},"similar":["鼓唇弄舌","鼓唇摇舌","鼓舌摇唇"],"usage":"作谓语、宾语；指挑拨是非"},{"id":49298,"word":"鼓唇弄舌","pinyin":"gǔ chún nòng shé","abbr":"gcns","explanation":"鼓：拨动，振动。振动嘴唇，拨弄舌头。形容凭口舌挑拨、煽动或进行游说。","source":{"text":"……，而胥吏衙役辈鼓唇咋舌欲以罔利，且言贼非真，器械自所制也。","book":"清·钱泳《履园丛话·旧闻·席氏多贤》"},"example":{"text":"今已陷之于丧亡，尚不自耻，犹敢～于众诸侯之前耶？","book":"《封神演义》第九四回"},"similar":["鼓唇摇舌","鼓唇咋舌"],"usage":"作谓语、宾语；指挑拨是非"},{"id":49299,"word":"鼓唇摇舌","pinyin":"gǔ chún yáo shé","abbr":"gcys","explanation":"耍嘴皮，嚼舌头。形容耍弄嘴皮进行挑拨煽动。","source":{"text":"何必借我们，你鼓唇摇舌的，自己开心作戏，却说是称功颂德呢。","book":"清·曹雪芹《红楼梦》第六十三回"},"example":{"text":"清·曹雪芹《红楼梦》第63回：“何必借我们，你～的，自己开心作戏，却说是称功颂德呢。”"},"similar":["摇唇鼓舌","鼓唇咋舌"],"usage":"作谓语、宾语、定语；指卖弄口才"},{"id":49300,"word":"鼓噪四起","pinyin":"gǔ zào sì qǐ","abbr":"gzsq","explanation":"鼓噪：鸣鼓喧哗。四面战鼓响起，声势浩大。","source":{"text":"如遇魏兵，不可大击，只鼓噪呐喊，以疑兵惊之。","book":"明·罗贯中《三国演义》"},"usage":"作谓语、定语；用于战争等"},{"id":49301,"word":"鼓噪而起","pinyin":"gǔ zào ér qǐ","abbr":"gzeq","explanation":"鼓噪：喧闹，大喊大叫。喧叫闹哄起来。","source":{"text":"两君就坛，两君相揖，齐人鼓噪而起，欲以执鲁君。","book":"《谷梁传·定公十年》"},"usage":"作谓语、定语；用于场面"},{"id":49302,"word":"鼓噪而进","pinyin":"gǔ zào ér jìn","abbr":"gzej","explanation":"鼓：敲鼓；噪：高声叫喊。敲鼓呐喊，大张声势地向前进。","source":{"text":"越子伐吴，吴子御之笠泽，夹水而阵。越子为左右句卒，使夜或左或右，鼓噪而进。","book":"《左传·哀公十七年》"},"example":{"text":"《洪秀全演义》第33回：“三军一齐奋勇～。”"},"usage":"作谓语；用于战争等"},{"id":49303,"word":"鼓旗相当","pinyin":"gǔ qí xiāng dāng","abbr":"gqxd","explanation":"两军对敌；对抗。比喻双方力量不相上下。同“旗鼓相当”。","source":{"text":"如令子阳到汉中、三辅，愿因将军兵马，鼓旗相当。","book":"《后汉书·隗嚣传》"},"similar":["旗鼓相当"],"opposite":["天差地别"],"usage":"作谓语、定语；指势均力敌"},{"id":49304,"word":"鼓盆之戚","pinyin":"gǔ pén zhī qī","abbr":"gpzq","explanation":"旧指死了妻子。","source":{"text":"庄子妻死，惠子吊之，庄子则方箕踞鼓盆而歌。","book":"《庄子·至乐》"},"example":{"text":"家綦贫，又有～。","book":"清·蒲松龄《聊斋志异·小谢》"},"similar":["丧妻之痛"],"usage":"作宾语；指死了妻子很悲伤","story":["战国时期，著名哲学家庄子有一个贤惠能干的妻子，两人一生都恩恩爱爱，他的妻子因病去世。庄子的朋友惠子前来吊唁，见庄子左手拿着瓦盆，右手拿着木棍敲着，边敲边唱，惠子不解。庄子说人都有生死的，如同四季交替一样"]},{"id":49305,"word":"鼓眼努睛","pinyin":"gǔ yǎn nǔ jīng","abbr":"gynj","explanation":"眼睛张大、凸起的样子。指使眼色。","source":{"text":"‘你跟我来，有句话问你。’他鼓眼努睛，对她这样说。","book":"周立波《山乡巨变》上七"},"usage":"作谓语、定语；用于人的神态"},{"id":49306,"word":"鼓睛暴眼","pinyin":"gǔ jīng bào yǎn","abbr":"gjby","explanation":"指眼睛突出的样子。","source":{"text":"中国的鼓睛暴眼的文字实在是比穿山甲、比猬毛还要难于接近的逆鳞。","book":"郭沫若《〈中国古代社会研究〉自序》"},"usage":"作谓语、定语；用于人的神态"},{"id":49307,"word":"鼓破众人捶","pinyin":"gǔ pò zhòng rén chuí","abbr":"gpzrc","explanation":"指众人群起攻击落魄失势之人。","example":{"text":"这真是墙倒众人推，～，看见我软弱，你们就欺侮。"},"similar":["墙倒众人推"],"usage":"作宾语、分句；指群起攻击失势之人"},{"id":49308,"word":"鼓脑争头","pinyin":"gǔ nǎo zhēng tóu","abbr":"gnzt","explanation":"争着出头；要冒尖，强出头。","source":{"text":"勤儿每正鼓脑争头，斗喧呼谢馆秦楼。","book":"《全元散曲·柳营曲·风月担》"},"usage":"作谓语、定语；用于口语"},{"id":49309,"word":"鼓腹击壤","pinyin":"gǔ fù jī rǎng","abbr":"gfjr","explanation":"原指人民吃得饱，有余闲游戏。后用为称颂太平盛世之典。同“击壤鼓腹”。","source":{"text":"凿井耕田者不知自然，鼓腹击壤者不知帝力。","book":"《隋书·儒林传·何妥》：“上古之时，未有音乐，鼓腹击壤，乐在期间。”唐·卢照邻《益州至真观主黎君碑》"},"example":{"text":"普天之下，率土之滨，蟠木距于流沙，瀚海穷于丹穴，莫不～，凿井耕田，治致升平，驱之仁寿。","book":"《旧唐书·李密传》"},"similar":["击壤而歌","击壤鼓腹"],"usage":"作谓语、定语；指太平盛世"},{"id":49310,"word":"鼓腹含和","pinyin":"gǔ fù hán hé","abbr":"gfhh","explanation":"吃饱肚子，和乐相处。形容太平欢乐。","source":{"text":"煕皞之民，耕三馀一，鼓腹含和，无过庶过富之通患。","book":"严复《主客平议》"},"usage":"作谓语、定语；用于书面语"},{"id":49311,"word":"鼓腹含哺","pinyin":"gǔ fù hán bǔ","abbr":"gfhb","explanation":"鼓腹：鼓起肚子，即饱食；哺：口中所含的食物。口含食物，手拍肚子。形容太平时代无忧无虑的生活。","source":{"text":"夫赫胥氏之时，民居不知所为，行不知所之，含哺而熙，鼓腹而游，民能以此矣。","book":"《庄子·马蹄》"},"example":{"text":"尧天舜日庆三多，～遍地歌。","book":"清·钱彩《说岳全传》第一回"},"similar":["鼓腹含和"],"usage":"作谓语、定语；指生活太平"},{"id":49312,"word":"鼓腹而游","pinyin":"gǔ fù ér yóu","abbr":"gfey","explanation":"鼓腹：鼓起肚子，即饱食。拍打肚皮四处游逛。形容闲暇无事，自得其乐。","source":{"text":"夫赫胥氏之时，民居不知所为，行不知所之，含哺而熙，鼓腹而游，民能以此矣。","book":"《庄子·马蹄》"},"example":{"text":"归来饭饱黄昏后，曲肱而枕，～。","book":"明·冯惟敏《中吕粉蝶儿·五岳游囊杂咏》"},"similar":["鼓腹含哺"],"usage":"作谓语、定语；指生活太平"},{"id":49313,"word":"鼓腹讴歌","pinyin":"gǔ fù ōu gē","abbr":"gfog","explanation":"鼓：拍打；讴：歌唱。一边拍肚皮，一边唱歌。形容豪放不羁，闲散自乐。","source":{"text":"鼓腹讴歌笑不彻。","book":"宋·释普济《五灯会元·文准禅师》"},"example":{"text":"～的日子越来越近了"},"similar":["鼓腹击壤"],"usage":"作谓语、定语；指太平盛世"},{"id":49314,"word":"鼓舌扬唇","pinyin":"gǔ shé yáng chún","abbr":"gsyc","explanation":"转动舌头，张开嘴唇。形容开口说唱。","source":{"text":"鼓舌扬唇，唱一年家春尽一年家春。","book":"元·张国宾《合汗衫》第一折"},"usage":"作谓语、宾语；用于说唱"},{"id":49315,"word":"鼓舌掀簧","pinyin":"gǔ shé xiān huáng","abbr":"gsxh","explanation":"掉动舌头，掀动乐器中的簧片。指用动人的言辞蛊惑人。","source":{"text":"笔墨久抛荒，懒劳神雕虫小技，鼓舌掀簧。","book":"清·胡泉《貂裘换酒·题〈聊斋志异〉》词"},"similar":["鼓唇摇舌"],"usage":"作谓语、宾语、定语；指卖弄口才"},{"id":49316,"word":"鼓舌摇唇","pinyin":"gǔ shé yáo chún","abbr":"gsyc","explanation":"鼓动嘴唇，摇动舌头。形容利用口才进行煽动或游说。亦泛指大发议论（多含贬义）。","source":{"text":"几时行通利方，凭着咱鼓舌摇唇，立取他封侯拜将。","book":"元·高文秀《谇范叔》第二折"},"example":{"text":"引线针儿，伐柯斧具，～，婚男嫁女，花红羊酒是常仪。","book":"明·周履靖《锦笺记·联姻》"},"similar":["鼓唇摇舌","鼓唇咋舌","鼓唇摇舌"],"usage":"作谓语、宾语；指挑拨是非"},{"id":49317,"word":"鼓舞人心","pinyin":"gǔ wǔ rén xīn","abbr":"gwrx","explanation":"鼓舞：振作，奋发。振奋人们的信心。增强人们的勇气。","source":{"text":"鼓舞万物者，雷风乎？鼓舞万从者，号令乎？","book":"汉·扬雄《法言·先知》"},"example":{"text":"也不过四处游说，～。","book":"清·岭南羽衣女士《东欧女豪杰》第四回"},"similar":["振奋人心"],"usage":"作谓语、定语；指消息、政策等"},{"id":49318,"word":"鼓舞欢忻","pinyin":"gǔ wǔ huān xīn","abbr":"gwhx","explanation":"形容高兴而振奋。同“欢欣鼓舞”。"},{"id":49319,"word":"鼓舞欢欣","pinyin":"gǔ wǔ huān xīn","abbr":"gwhx","explanation":"形容高兴而振奋。同“欢欣鼓舞”。","source":{"text":"一个个鼓舞欢欣，出门上马而去。","book":"《儿女英雄传》第二一回"},"example":{"text":"然后～，跟了请来做翻译那位教习，一同出去。","book":"《官场现形记》第五五回"},"similar":["欢欣鼓舞"],"usage":"作谓语、宾语、定语；指非常高兴"},{"id":49320,"word":"鼓衰力尽","pinyin":"gǔ shuāi lì jìn","abbr":"gslj","explanation":"鼓：战鼓声；衰：微弱。战鼓声音微弱，力量已经用尽。形容战争接近失败时的惨状。也形容文章的末尾松懈无力。","source":{"text":"鼓衰兮力尽，矢竭兮弦绝。","book":"唐·李华《吊古战场文》"}},{"id":49321,"word":"鼓衰力竭","pinyin":"gǔ shuāi lì jié","abbr":"gslj","explanation":"鼓：战鼓声；衰：微弱。战鼓声音微弱，力量已经用尽。形容战争接近失败时的惨状。也形容文章的末尾松懈无力。","source":{"text":"鼓衰兮力尽，矢竭兮弦绝。","book":"唐·李华《吊古战场文》"},"example":{"text":"又放翁古今体诗，每结处必有兴会，有意味，绝无～之态。","book":"清·赵翼《瓯北诗话·陆放翁诗》"}},{"id":49322,"word":"鼓衰气竭","pinyin":"gǔ shuāi qì jié","abbr":"gsqj","explanation":"比喻力量耗尽，不能再有作为。","source":{"text":"夫战，勇气也。一鼓作气，再而衰，三而竭。","book":"《左传·庄公十年》"},"example":{"text":"抑又不知～，自此为迁延之役耶？","book":"唐·白居易《因继集重续》"}},{"id":49323,"word":"鼓角相闻","pinyin":"gǔ jiǎo xiāng wén","abbr":"gjxw","explanation":"鼓：战鼓；角：号角。战鼓声、号角声不断传出。形容军队驻地警戒，备战不懈，纪律森严。","source":{"text":"山下旌旗在望，山头鼓角相闻。","book":"毛泽东《西江月·井冈山》词"},"usage":"作谓语、定语；用于军队或集体等"},{"id":49324,"word":"鼓角齐鸣","pinyin":"gǔ jiǎo qí míng","abbr":"gjqm","explanation":"鼓：战鼓；角：古代军队中的乐器，即号角。战鼓响，号角鸣。形容军队出击时的雄壮阵势。","source":{"text":"前面鼓角齐鸣，一彪军出，放过马谡，拦住张郃。","book":"明·罗贯中《三国演义》第七十九回"},"similar":["鼓乐齐鸣"],"usage":"作谓语；形容军队出击时的雄壮情景"},{"id":49325,"word":"鼓足干劲","pinyin":"gǔ zú gàn jìn","abbr":"gzgj","explanation":"鼓：鼓动，振作。把劲头鼓足，准备做事。","source":{"text":"青年子弟多豪俊，鼓足干劲建家乡。","book":"朱德《上黔灵山》"},"usage":"作谓语、状语；用于做事"},{"id":49326,"word":"鼓足干劲，力争上游","pinyin":"gǔ zú gàn jìn，lì zhēng shàng yóu","abbr":"gzgjlzsy","explanation":"鼓：鼓动，振作；上游：比喻前列或高位。把劲头鼓足，努力争取进入先进行列。","source":{"text":"在1958年党的八大二次会议上，通过了‘鼓足干劲，力争上游，多快好省地建设社会主义’的总路线。","book":"毛泽东《在扩大的中央工作会议上的讲话》"},"example":{"text":"～是热，没有冲天的干劲、争上游的决心，一切都无从谈起。","book":"谢觉哉《冷和热》"},"usage":"作谓语、宾语、定语；可分开使用"},{"id":49327,"word":"鼓馁旗靡","pinyin":"gǔ něi qí mí","abbr":"gnqm","explanation":"鼓点无力，旗帜歪倒。形容军队士气不振。","source":{"text":"凡行阵参伍弥缝之际，略觉鼓馁旗靡处，得健锐兵数十屹立其间，则整而复进。","book":"清·魏源《圣武记》卷一"},"similar":["鼓衰力尽"],"usage":"作谓语、定语；用于士气等"},{"id":49328,"word":"鼓鼓囊囊","pinyin":"gǔ gǔ nāng nāng","abbr":"ggnn","explanation":"软外皮中塞得圆鼓鼓的；藏物凸起的样子。","source":{"text":"看见皮瓠藤篮之类，鼓鼓囊囊的装着许多东西。","book":"清·李宝嘉《文明小史》第四十九回"},"example":{"text":"把他们～的一小袋金子往柜台上一扔。"},"opposite":["空空如也"],"usage":"作定语、状语；指塞得满满的"},{"id":49329,"word":"鼠偷狗盗","pinyin":"shǔ tōu gǒu dào","abbr":"stgd","explanation":"像鼠狗那样奔窜偷盗。同“鼠窃狗盗”。","source":{"text":"遍地腥膻，直弄得江翻海扰，鼠偷狗盗，大劫何日了？","book":"清·无名氏《陆沉痛》楔子一出"},"similar":["鼠窃狗偷","鼠窃狗盗"],"usage":"作宾语、定语；指小偷小摸"},{"id":49330,"word":"鼠入牛角","pinyin":"shǔ rù niú jiǎo","abbr":"srnj","explanation":"比喻势力愈来愈小。","source":{"text":"奈何吾子孙不肖，后世如鼠入牛角，势当渐小尔！","book":"《新五代史·南汉世家·刘玢》"},"example":{"text":"徒守则积弱可虞，而不免成～之势。","book":"清·王韬《俄人志在并兼》"},"usage":"作宾语、定语；用于比喻句"},{"id":49331,"word":"鼠凭社贵","pinyin":"shǔ píng shè guì","abbr":"spsg","explanation":"老鼠把窝做在土地庙下面，使人不敢去挖掘。比喻坏人仗势欺人。","source":{"text":"鼠凭社贵，狐藉虎威。","book":"南朝梁·沈约《恩悻传论》"},"similar":["狐假虎威"],"usage":"作谓语、补语、分句；指仗势欺人"},{"id":49332,"word":"鼠啮虫穿","pinyin":"shǔ niè chóng chuān","abbr":"sncc","explanation":"指鼠咬虫蛀。"},{"id":49333,"word":"鼠啮蠹蚀","pinyin":"shǔ niè dù shí","abbr":"snds","explanation":"指鼠咬虫蛀。"},{"id":49334,"word":"鼠屎汙羹","pinyin":"shǔ shǐ wū gēng","abbr":"sswg","explanation":"比喻加进了不好的东西，从而破坏了原来美的事物。"},{"id":49335,"word":"鼠屎污羹","pinyin":"shǔ shǐ wū gēng","abbr":"sswg","explanation":"比喻加进了不好的东西，从而破坏了原来美的事物。","source":{"text":"吴公前辈盛德，予宿昔所敬慕，制一偈自赞，皆佛菩萨语，启诵三过，欲下一句而家有识真者，恐得鼠屎污羹之诮。","book":"宋·孙觌《跋吴省元真赞》"},"usage":"作宾语、定语；多用于比喻句"},{"id":49336,"word":"鼠心狼肺","pinyin":"shǔ xīn láng fèi","abbr":"sxlf","explanation":"形容心肠阴险狠毒。","source":{"text":"丈丈翁，得钱归，鼠心狼肺，侧目吞肥，千谋万算伏危机。","book":"清·郑燮《后孤儿行》"},"similar":["狼心狗肺"],"opposite":["菩萨心肠"],"usage":"作谓语、定语、宾语；指人的心肠坏"},{"id":49337,"word":"鼠技虎名","pinyin":"shǔ jì hǔ míng","abbr":"sjhm","explanation":"只有老鼠之流的雕虫小技敢冒老虎的威名。指当权者作威作福欺压百姓。","source":{"text":"夫至于挟鼠技，冒虎名，立民上者皆鼠辈。","book":"《雪涛小说》"},"usage":"作宾语、定语；指冒别人的名行恶","story":["楚地人称老虎为老虫，姑苏人称老鼠为老虫。一个人在长州当官，因公去娄东去办事，夜宿驿站中，刚吹灯入睡，门外有声响，他问看门人是什么东西。看门人说是老虫，他吓得想逃跑。看门人说不必惊慌，只不过是区区老鼠而矣，鼠冒虎名真有威名"]},{"id":49338,"word":"鼠撺狼奔","pinyin":"shǔ cuān láng bēn","abbr":"sclb","explanation":"形容狼狈逃跑的情景。","source":{"text":"北京城内百姓黎民一个个鼠撺狼奔，一家家神号鬼哭。","book":"明·施耐庵《水浒传》第66回"},"similar":["鼠窜狼奔"],"usage":"作谓语、宾语、状语；用于书面语"},{"id":49339,"word":"鼠牙雀角","pinyin":"shǔ yá què jiǎo","abbr":"syqj","explanation":"鼠、雀：比喻强暴者。原意是因为强暴者的欺凌而引起争讼。后比喻打官司的事。","source":{"text":"谁谓雀无角，何以穿我屋？……谁谓鼠无牙，何以穿我墉？","book":"《诗经·召南·行露》"},"example":{"text":"咽泪吞声，甘为奸人所卖，诚欲以礼相始终也。～，适足增羞。","book":"清·徐瑶《太恨生传》"},"similar":["鼠雀之牙","雀角鼠牙"],"usage":"作宾语、定语；指细微小事"},{"id":49340,"word":"鼠盗狗窃","pinyin":"shǔ dào gǒu qiè","abbr":"sdgq","explanation":"像鼠狗那样奔窜偷盗。同“鼠窃狗盗”。","source":{"text":"杲鼠盗狗窃，非有远志，宜先讨颢。","book":"《北齐书·薛琡传》"},"similar":["鼠窃狗盗"],"usage":"作宾语、定语；指小偷小摸"},{"id":49341,"word":"鼠目寸光","pinyin":"shǔ mù cùn guāng","abbr":"smcg","explanation":"老鼠的眼睛只能看到一米远。形容目光短浅，没有远见。","source":{"text":"吓得那一班鼠目寸光的时文朋友，拜倒辕门，盲称瞎赞。","book":"清·蒋士铨《临川梦·隐奸》"},"example":{"text":"我们从小就应树立远大理想，努力学习科学知识，决不做～的庸人。"},"similar":["目光如豆","目光短浅"],"opposite":["神通广大","高瞻远瞩"],"usage":"作谓语、定语、宾语；指没有远见"},{"id":49342,"word":"鼠目獐头","pinyin":"shǔ mù zhāng tóu","abbr":"smzt","explanation":"眼睛像老鼠那样又小又圆，脑袋象獐子那样又小又尖。形容人相貌丑陋，神情狡滑。","source":{"text":"龙章凤姿之士不见用，獐头鼠目之子乃求官。","book":"《旧唐书·李揆传》"},"example":{"text":"我～，强似他面如傅粉。","book":"明·无心子《金雀记·掷果》"},"similar":["獐头鼠目"],"usage":"作宾语、定语；用于比喻句"},{"id":49343,"word":"鼠目麞头","pinyin":"shǔ mù zhāng tóu","abbr":"smzt","explanation":"麞，同“獐”。形容人相貌丑陋，神情狡滑。同“鼠目獐头”。"},{"id":49344,"word":"鼠穴寻羊","pinyin":"shǔ xué xún yáng","abbr":"sxxy","explanation":"比喻没有功效的做法。","source":{"text":"有某公课士，以赋得蜻蜓立钓丝，限‘蜻’字，七排四十韵。人以为难。余笑曰：‘此之谓鼠穴寻羊，蜂窠唱戏，非以诗学教人之道也。’","book":"清·袁枚《随园诗话补遗》卷四"},"similar":["缘木求鱼"],"usage":"作宾语、定语；用于比喻句"},{"id":49345,"word":"鼠窃狗偷","pinyin":"shǔ qiè gǒu tōu","abbr":"sqgt","explanation":"象老鼠少量窃取，象狗钻油偷盗。指小偷小摸。","source":{"text":"此特群盗鼠窃狗盗尔，何足置之齿牙间。","book":"《史记·刘敬书孙通列传》"},"example":{"text":"～之徒，何足虑哉。","book":"明·施耐庵《水浒全传》第七十五回"},"similar":["鼠窃狗盗","鸡鸣狗盗","梁上君子"],"opposite":["正人君子"],"usage":"作宾语、定语；指小偷小摸"},{"id":49346,"word":"鼠窃狗盗","pinyin":"shǔ qiè gǒu dào","abbr":"sqgd","explanation":"象老鼠少量窃取，象狗钻油偷盗。指小偷小摸。","source":{"text":"此特群盗鼠窃狗盗耳，何足置之齿牙间。","book":"西汉·司马迁《史记·刘敬叔孙通列传》"},"example":{"text":"数年来无～之扰者，皆我夜夜逻察故也。","book":"清·青城子《志异续编·丐报恩》"},"similar":["鸡鸣狗盗","梁上君子"],"opposite":["正人君子"],"usage":"作宾语、定语；指小偷小摸","story":["秦朝末年，各地农民纷纷起义造反。丞相赵高却指鹿为马说传信人在造谣生事，并把他们投入大牢。秦二世胡亥问有关农民起义的事情，叔孙通则说是鼠窃狗盗罢了，不必惊慌。二世升了他的官。然而不久秦朝就被农民起义所推翻"]},{"id":49347,"word":"鼠窜狗盗","pinyin":"shǔ cuàn gǒu dào","abbr":"scgd","explanation":"像鼠狗那样奔窜偷盗。","source":{"text":"历阳、广陵，窥觎相继，或谋图城邑，或动剥吏人，昼伏夜游，鼠窜狗盗。","book":"《隋书·高祖纪下》"},"usage":"作宾语、定语；用于比喻句"},{"id":49348,"word":"鼠窜狼奔","pinyin":"shǔ cuàn láng bēn","abbr":"sclb","explanation":"形容狼狈逃跑的情景。","source":{"text":"果然百姓扶老挈幼，鼠窜狼奔，都奔东平府来。","book":"明·施耐庵《水浒传》第六十九回"},"example":{"text":"谁知智不及此，只是～，那里挡得住。","book":"《英烈传》第三十回"},"similar":["狼奔鼠窜"],"usage":"作谓语、宾语、状语；用于逃跑的情景"},{"id":49349,"word":"鼠窜蜂逝","pinyin":"shǔ cuàn fēng shì","abbr":"scfs","explanation":"形容纷纷跑散。","source":{"text":"乃大呼曰：‘所诛者此逆贼耳，他人无与焉。’稍稍鼠窜蜂逝，帖如也。","book":"元·曹居一《李伯渊奇节传》"},"usage":"作宾语、定语；用于比喻句"},{"id":49350,"word":"鼠肚鸡肠","pinyin":"shǔ dù jī cháng","abbr":"sdjc","explanation":"比喻气量狭小，只考虑小事，不顾大体。","source":{"text":"妇人拍了拍那个小胸脯。‘把这个放宽点，别鼠肚鸡肠的。’","book":"萧乾《矮檐》"},"example":{"text":"我不喜欢与～的人打交道。"},"similar":["鼠腹鸡肠"],"opposite":["宽宏大度"],"usage":"作宾语、定语；指气量狭小"},{"id":49351,"word":"鼠肝虫臂","pinyin":"shǔ gān chóng bì","abbr":"sgcb","explanation":"庄子原意为人世间事物变化无定则，像人那样大的形体也能变成微小的东西。比喻极微小而无价值的东西。","source":{"text":"以汝为汝肝乎？以汝为虫臂乎？","book":"《庄子·大宗师》"},"example":{"text":"～原无择，遇酒犹能罄一欢。","book":"宋·陆游《成都岁暮始微寒小酌遣兴》诗"},"similar":["鼠臂虮肝"],"usage":"作宾语、定语；指小人或物","story":["子祀、子舆、子犁、子来四人都是达观生死的高士，他们情同淡水，置生死于度外。子舆生病，子祀去问候他，他十分高兴。子来生病，子犁去慰问，他支走了他的家人对他说：大自然真是神奇，你死了要把你变成鼠肝还是变成虫臂呢？"]},{"id":49352,"word":"鼠腹蜗肠","pinyin":"shǔ fù wō cháng","abbr":"sfwc","explanation":"鼹鼠的肚子，蜗牛的肠子。比喻所求有限或气量狭小。","source":{"text":"鹪鹩巢于深林，不过一枝；偃鼠饮河，不过满腹。","book":"《庄子·逍遥游》"},"example":{"text":"大圣啊，只说你是个宽洪海量之仙，谁知是个～之辈。","book":"明·吴承恩《西游记》第七十六回"},"similar":["鼠腹鸡肠"],"opposite":["宽宏大量"],"usage":"作谓语、定语、宾语；指气量狭小"},{"id":49353,"word":"鼠腹鸡肠","pinyin":"shǔ fù jī cháng","abbr":"sfjc","explanation":"比喻气量狭小，只考虑小事，不顾大体。","source":{"text":"不是说这贼三寸货强盗，那鼠腹鸡肠的心儿，只好有三寸大一般。","book":"明·兰陵笑笑生《金瓶梅》第三十一回"},"similar":["小肚鸡肠","鼠肚鸡肠"],"opposite":["宽宏大量"],"usage":"作谓语、定语；指气量狭小"},{"id":49354,"word":"鼠臂虮肝","pinyin":"shǔ bì jǐ gān","abbr":"sbjg","explanation":"犹言鼠肝虫臂。指或为鼠臂或为虮肝，指人世变化无常。","source":{"text":"生尝畏世谙谈虎，术不逢时学豢龙。鼠臂虮肝更何有，从今一一听天工。","book":"清·钱谦益《仙坛唱和诗》之六"},"usage":"作宾语、定语；多用于比喻句"},{"id":49355,"word":"鼠迹狐踪","pinyin":"shǔ jì hú zōng","abbr":"sjhz","explanation":"比喻人行踪鬼祟。","source":{"text":"羽精忠大节，而世有责之备者；蒙鼠迹狐踪，而世有赞其能者。吾所为废书太息也。","book":"明·胡应麟《少室山房笔丛·史书估毕二》"},"usage":"作宾语、定语；用于比喻句"},{"id":49356,"word":"鼠雀之牙","pinyin":"shǔ què zhī yá","abbr":"sqzy","explanation":"指争讼之事。","source":{"text":"学生失于龙蛇之辨，致有鼠雀之牙，抚己多惭，见公甚愧。","book":"元·柯丹邱《荆钗记·奸诘》"},"similar":["鼠牙雀角"],"usage":"作宾语、定语；指细微小事"},{"id":49357,"word":"鼠雀之辈","pinyin":"shǔ què zhī bèi","abbr":"sqzb","explanation":"蔑视他人之词。指鄙陋卑微之徒。","source":{"text":"量鼠雀之辈，何足汗刀！","book":"明·罗贯中《三国演义》第二十三回"},"example":{"text":"这些～，我们不必在意"},"usage":"作主语、宾语；用于口语"},{"id":49358,"word":"鼠首偾事","pinyin":"shǔ shǒu fèn shì","abbr":"ssfs","explanation":"坏了事情。比喻人办事没决断，就象胆小的老鼠，在出洞时头在洞口伸伸缩缩一样。","source":{"text":"笑人齿缺，曰狗窦大开；讥人不决，曰鼠首偾事。","book":"清·程允升《幼学琼林·身体》"}},{"id":49359,"word":"鼠齧虫穿","pinyin":"shǔ niè chóng chuān","abbr":"sncc","explanation":"指鼠咬虫蛀。"},{"id":49360,"word":"鼠齧蠹蚀","pinyin":"shǔ niè dù shí","abbr":"snds","explanation":"指鼠咬虫蛀。"},{"id":49361,"word":"鼪鼬之径","pinyin":"tiān yòu zhī jìng","abbr":"syzj","explanation":"鼠鼬类往来的小路。引申为荒凉偏僻的小道。","source":{"text":"夫逃虚空者，藜藿柱乎鼪鼬之径，踉位其空，闻人足音跫然而喜矣。","book":"《庄子·徐无鬼》"},"similar":["鼪鼯之径"],"usage":"作宾语；用于比喻句"},{"id":49362,"word":"鼪鼬之迳","pinyin":"tiān yòu zhī jìng","abbr":"syzj","explanation":"鼠鼬类往来的小路。引申为荒凉偏僻的小道。"},{"id":49363,"word":"鼪鼯之径","pinyin":"wéi wú zhī jìng","abbr":"swzj","explanation":"引申为荒凉偏僻的小道。同“鼪鼬之径”。","source":{"text":"时姬又恶嚣，非受縻于炎炙，则必逃之鼪鼯之径。","book":"清·张明弼《冒姬董小宛传》"},"similar":["鼪鼬之径"],"usage":"作宾语；用于比喻句"},{"id":49364,"word":"鼯鼠之丑","pinyin":"wú shǔ zhī chǒu","abbr":"wszc","explanation":"鼯：鼠名，形似松鼠，毛多褐色，尾巴很长，前后肢之间有薄膜，能从树上飞降下来，住在树沿中，昼伏夜出。比喻丑陋低下的才艺。","example":{"text":"一点～，献丑了。"},"similar":["鼯鼠之技"],"usage":"作宾语；用于比喻句"},{"id":49365,"word":"鼯鼠之技","pinyin":"wú shǔ zhī jì","abbr":"wszj","explanation":"鼯：鼠名，形似松鼠，毛多褐色，尾巴很长，前后肢之间有薄膜，能从树上飞降下来，住在树沿中，昼伏夜出。比喻丑陋低下的才艺","source":{"text":"黔驴之技，技止此耳；鼯鼠之技，技亦穷乎。","book":"明·程登吉《幼学琼林》第四卷"},"similar":["鼯鼠之丑"],"usage":"作宾语；用于比喻句"},{"id":49366,"word":"鼷腹鹪枝","pinyin":"xī fù jiāo zhī","abbr":"xfjz","explanation":"比喻欲望有限。","source":{"text":"鹪鹩巢于深林，不过一枝。偃鼠饮河，不过满腹。","book":"《庄子·逍遥游》"},"example":{"text":"读书不成，学仙寡效，～，从吾所好。","book":"明·袁宏道《善哉行》"},"similar":["鼷鼠饮河"],"usage":"作宾语、定语；多用于比喻句"},{"id":49367,"word":"鼷鼠食牛","pinyin":"xī shǔ shí niú","abbr":"xssn","explanation":"鼷鼠：鼠类中最小的一种，咬人及牛马时不易被发现，被咬者毫无感觉，所咬伤口即成疮。鼷鼠咬牛。比喻暗中害人。","source":{"text":"七年春王正月，鼷鼠食郊牛角，改卜牛。鼷鼠又食其角，乃免牛。","book":"《左传·成公七年》"},"example":{"text":"是以～，改卜非礼。","book":"《宋书·礼志四》"}},{"id":49368,"word":"鼷鼠饮河","pinyin":"xī shǔ yǐn hé","abbr":"xsyh","explanation":"比喻欲望有限。","source":{"text":"驱尔如尔首俯，羊鼷鼠饮河只满腹。","book":"清·刘文培《南山虎》"},"example":{"text":"清·刘文培《南山虎》：“驱尔如羊尔首俯，～只满腹。”"},"similar":["鼷腹鹪枝","偃鼠饮河"],"usage":"作宾语、定语；多用于比喻句"},{"id":49369,"word":"鼹鼠易盈","pinyin":"yǎn shǔ yì yíng","abbr":"ysyy","explanation":"田鼠到河边喝水，喝一些就饱了。比喻所需极有限。","source":{"text":"鹪鹩巢于深林，不过一枝；偃鼠饮河，不过满腹。","book":"《庄子·逍遥游》"},"example":{"text":"自渐乎～，非嗜其熊蹯独美。","book":"《十国春秋·韦庄传》"}},{"id":49370,"word":"鼹鼠饮河","pinyin":"yǎn shǔ yǐn hé","abbr":"ysyh","explanation":"田鼠到河边喝水，喝一些就饱了。比喻所需极有限。","source":{"text":"鹪鹩巢于深林，不过一枝；偃鼠饮河，不过满腹。","book":"《庄子·逍遥游》"},"example":{"text":"鹪鹩巢林，不过一枝；～，不过满腹。","book":"清·程允升《幼学琼林·鸟兽》"}},{"id":49371,"word":"鼻坍嘴歪","pinyin":"bí tān zuǐ wāi","abbr":"btzw","explanation":"形容脸部伤势严重或人长得很丑","source":{"text":"两个武人都被他三拳两脚打得鼻坍嘴歪，爬不起身。","book":"清·无垢道人《八仙全传》第五回"},"similar":["鼻塌嘴歪"],"usage":"作定语、状语；形容人的伤势"},{"id":49372,"word":"鼻垩挥斤","pinyin":"bí è huī jīn","abbr":"behj","explanation":"挥舞斧头削除鼻端之垩。比喻指正错误。","source":{"text":"郢人垩漫其鼻端，若蝇翼，使匠石斫之，匠石运斤成风，听而斫之，尽垩而鼻不伤。","book":"典出《庄子·徐无鬼》"},"example":{"text":"平生师友凋零尽，～未有人。","book":"宋·陆游《叹老》诗"},"similar":["成风尽垩"],"usage":"作谓语、定语；指指正错误"},{"id":49373,"word":"鼻塌唇青","pinyin":"bí tā chún qīng","abbr":"btcq","explanation":"形容脸部伤势严重。","source":{"text":"想罢再看看严大成，已打得鼻塌唇青，简直不成模样。","book":"李涵秋《广陵潮》第六五回"},"similar":["鼻塌嘴歪"],"usage":"作定语、状语；形容人的伤势"},{"id":49374,"word":"鼻塌嘴歪","pinyin":"bí tā zuǐ wāi","abbr":"btzw","explanation":"形容脸部伤势严重。","source":{"text":"那里禁得萧云仙的弹子打来，打得鼻塌嘴歪，无处躲藏。","book":"《儒林外史》第三九回"},"example":{"text":"只见两个人搀着那鸟教头走出庙来，打得～。","book":"《荡寇志》第七二回"},"similar":["鼻蹋嘴歪","鼻坍嘴歪"],"usage":"作定语、状语；形容人的伤势"},{"id":49375,"word":"鼻塌脣青","pinyin":"bí tǎ chún qīng","abbr":"btcq","explanation":"形容脸部伤势严重。","source":{"text":"想罢再看看严大成，已打得鼻塌脣青，简直不成模样。","book":"李涵秋《广陵潮》第六五回"}},{"id":49376,"word":"鼻头出火","pinyin":"bí tóu chū huǒ","abbr":"btch","explanation":"形容意气风发；情绪激昂。","source":{"text":"甜如甘露浆，觉耳后生风，鼻头出火，此乐使人忘死。","book":"《南史·曹景宗》"},"example":{"text":"《南史·曹景宗传》：“我昔在乡里，骑快马如龙，与年少辈数十骑，拓弓弦作礔砺声，箭如饿鸱叫，平泽中逐獐，数肋射之，渴饮其血，饥食其脯，甜如甘露浆，觉耳后生风，鼻头出火，此乐使人忘死。”"},"similar":["鼻端出火"],"usage":"作谓语、定语；指年轻气盛","story":["南北朝时期，曹景宗曾经对手下说他年少时在乡村里时与几十个年轻的朋友骑着矫健的快马猎獐的故事，当时年轻气盛，把弓拉得发响，跑到平原上去竞射獐，渴了就喝獐子的血，十分甘甜，喝后觉得耳后生风，鼻头出火，十分快活"]},{"id":49377,"word":"鼻孔撩天","pinyin":"bí kǒng liáo tiān","abbr":"bklt","explanation":"仰起头来鼻孔朝天。形容高傲自大。","source":{"text":"荆州绝无禅林，惟二圣而已。然蜀僧出关，必走江浙，回者又已自谓有得，不复参叩。故语云：‘下江者疾走如烟，上江者鼻孔撩天。徒劳他二佛打供，了不见一僧坐禅。’","book":"宋陆游《入蜀记》卷五"},"similar":["鼻孔辽天","鼻孔朝天"],"usage":"作谓语、定语；指人自大"},{"id":49378,"word":"鼻孔朝天","pinyin":"bí kǒng cháo tiān","abbr":"bkct","explanation":"仰起头来鼻孔朝天。形容高傲自大。","source":{"text":"见“鼻孔撩天”。"},"example":{"text":"[李嵩平]平常那种～的凌人盛气，不知跑到哪里去了。","book":"《花城》1981年第3期"},"similar":["鼻孔撩天"],"usage":"作谓语、定语；指人自大"},{"id":49379,"word":"鼻孔辽天","pinyin":"bí kǒng liáo tiān","abbr":"bklt","explanation":"仰起头来鼻孔朝天。形容高傲自大。","source":{"text":"见“鼻孔撩天”。"},"example":{"text":"诸佛不曾出世，人人～；祖师不曾西来，个个壁立千仞。","book":"《五灯会元·临济宗·蒋山善直禅师》"},"similar":["鼻孔撩天"],"usage":"作谓语、定语；指人自大"},{"id":49380,"word":"鼻息如雷","pinyin":"bí xī rú léi","abbr":"bxrl","explanation":"鼻息：鼾声。打呼噜的声音就象打雷一样响。形容熟睡时鼾声大作。","source":{"text":"上使人微觇准所为，而准方酣寝于中书，鼻息如雷。","book":"宋·沈括《梦溪笔谈·人事》"},"example":{"text":"伏枕听时，军中鼓打二更，起视残灯尚明。看周瑜时，～。","book":"明·罗贯中《三国演义》第四十五回"},"similar":["鼾声如雷"],"usage":"作谓语、状语；形容熟睡"},{"id":49381,"word":"鼻端出火","pinyin":"bí duān chū huǒ","abbr":"bdch","explanation":"形容意气风发；情绪激昂。","source":{"text":"见“鼻头出火”。"},"example":{"text":"写少时豪侠，有～之概。","book":"苏轼《方山子传》清·沈德潜评"},"similar":["鼻头出火"],"usage":"作谓语、定语；指年轻气盛"},{"id":49382,"word":"鼻端生火","pinyin":"bí duān shēng huǒ","abbr":"bdsh","explanation":"以之形容马行疾速。","source":{"text":"我昔在乡里，骑快马如龙……觉耳后生风，鼻头出火。","book":"语出《南史·曹景宗传》"},"example":{"text":"西家骁骑绕如龙，～耳生风。","book":"元·杨维桢《奉题子昂骝马图》诗"},"similar":["鼻端出火","鼻头出火"],"usage":"作谓语、定语；指年轻气盛"},{"id":49383,"word":"鼻肿眼青","pinyin":"bí zhǒng yǎn qīng","abbr":"bzyq","explanation":"鼻子肿起，眼圈发青。形容脸部伤势严重。","source":{"text":"一伙人疾忙扶起，只见他鼻肿眼青。","book":"清·蒲松龄《寒森曲》第五回"},"similar":["鼻青眼肿"],"usage":"作定语、状语；形容人的伤势"},{"id":49384,"word":"鼻蹋嘴歪","pinyin":"bí tā zuǐ wāi","abbr":"btzw","explanation":"形容疲累不堪或十分狼狈的样子。","example":{"text":"这几天我忙得～。"},"similar":["狼狈不堪"],"opposite":["五关端正"],"usage":"作定语、状语；指人的长相"},{"id":49385,"word":"鼻青眼乌","pinyin":"bí qīng yǎn wū","abbr":"bqyw","explanation":"鼻子发青，眼圈发黑。形容脸部伤势严重。","source":{"text":"若不趁早回头……肯定有跌大跤子、鼻青眼乌的时侯。","book":"古华《水酒湾纪事》"},"similar":["鼻青眼肿","鼻青眼紫"],"usage":"作定语、状语；形容人的伤势"},{"id":49386,"word":"鼻青眼紫","pinyin":"bí qīng yǎn zǐ","abbr":"bqyz","explanation":"鼻子发青，眼圈发紫。形容脸部伤势严重。","source":{"text":"果然，没隔几天，场里打麦子的时候，四黑牛找个碴儿，劈头盖脑地把甜苣儿打个鼻青眼紫。","book":"张石山《甜苣儿》"},"similar":["鼻青眼乌"],"usage":"作定语、状语；形容人的伤势"},{"id":49387,"word":"鼻青眼肿","pinyin":"bí qīng yǎn zhǒng","abbr":"bqyz","explanation":"鼻子发青，眼睛肿起。形容脸部伤势严重。亦比喻遭受严重打击、挫折的狼狈相。","source":{"text":"众人齐上，把一个德行之儒做下了个胯下之客，打得鼻青眼肿。","book":"《醒世姻缘传》第三五回"},"example":{"text":"现在蒋介石在其他各战场，碰得～。","book":"杜鹏程《保卫延安》第二章"},"similar":["鼻青眼紫"],"usage":"作定语、状语；形容人的伤势"},{"id":49388,"word":"鼻青脸肿","pinyin":"bí qīng liǎn zhǒng","abbr":"bqlz","explanation":"鼻子发青，脸部肿起。形容脸部伤势严重。","source":{"text":"这恶贼原想着是个暗算，趁着军官作下揖去，不能防备，这一脚定然鼻青脸肿。","book":"《三侠五义》第四四回"},"example":{"text":"两条大汉子飞步闯出来，把沈建华拉下去，打得～。","book":"杨大群《草头屯恩仇》第十四回"},"similar":["鼻青眼肿"],"usage":"作定语、状语；形容人被打"},{"id":49389,"word":"鼻青额肿","pinyin":"bí qīng é zhǒng","abbr":"bqez","explanation":"鼻子发青，额头肿起。形容脸部伤势严重。","source":{"text":"只有十多岁的娃娃们不知利害，不肯就范，但愿经过几回鼻青额肿的教训后，才不再作超越父母社会级别的轻举妄为。","book":"古华《芙蓉镇》第三章"},"similar":["鼻青脸肿"],"usage":"作定语、状语；形容人被打"},{"id":49390,"word":"鼾声如雷","pinyin":"hān shēng rú léi","abbr":"hsrl","explanation":"鼾声：熟睡时发出的鼻息声。形容睡得很深，鼾声很大。","source":{"text":"上使人微觇准所为，而准方酣寝于中书，鼻息如雷。","book":"宋·沈括《梦溪笔谈》第九章"},"example":{"text":"众宫娥……各去睡了，不多时，～。","book":"清·李汝珍《镜花缘》第三十七回"},"similar":["酣声如雷"],"usage":"作谓语；形容熟睡时鼾声很大"},{"id":49391,"word":"齐世庸人","pinyin":"qí shì yōng rén","abbr":"qsyr","explanation":"齐世：同于世俗的；庸人：平庸的人，也指见识短浅的人。比喻与世俗同俯仰或见识短浅的人。","source":{"text":"今齐世庸士之人，不好学问，专以己之愚而荷负巨任。","book":"汉·桓宽《盐铁论·殊路》"}},{"id":49392,"word":"齐东野语","pinyin":"qí dōng yě yǔ","abbr":"qdyy","explanation":"齐东：齐国的东部；野语：乡下人的话。孟子蔑视农民，认为他们说的话没有根据，听信不得。比喻荒唐而没有根据的话。","source":{"text":"此非君子之言，齐东野人之语也。","book":"《孟子·万章上》"},"example":{"text":"听说明的方孝孺，就被永乐皇帝灭十族，其一是“师”，但也许是～，我没有考查过这事的真伪。","book":"鲁迅《两地书》二六"},"similar":["道听途说"],"usage":"作宾语；比喻荒唐而没有根据的话"},{"id":49393,"word":"齐人攫金","pinyin":"qí rén jué jīn","abbr":"qrjj","explanation":"攫：夺取。比喻利欲熏心而不顾一切。","source":{"text":"昔齐人有欲金者，清旦衣冠而之市，适鬻金者之所，因攫金而去。","book":"战国·郑·列御寇《列子·说符》"},"example":{"text":"你知道“～”的故事？"},"usage":"作宾语、定语；指人贪财","story":["从前齐国有一个人整天想着要有许多金子发大财。他打扮得整整齐齐来到集市一家金店，见各种各样的金器陈列在那里，他二话不说揣起金器回头便走。几个巡吏把他抓获，问他为什么当着众人面偷金，他说：“我只见金子不见人。”"]},{"id":49394,"word":"齐傅楚咻","pinyin":"qí fù chǔ xiū","abbr":"qfcx","explanation":"傅：辅助，教导；咻：吵闹。齐人辅导，楚人干扰。比喻势孤力单，观点或意见支持的人很少。","source":{"text":"一齐人傅之，众楚人咻之，虽日挞而求其齐也，不可得矣；引而置之庄岳之间数年，虽日挞而求其楚，亦不可得矣。","book":"《孟子·滕文公下》"}},{"id":49395,"word":"齐名并价","pinyin":"qí míng bìng jià","abbr":"qmbj","explanation":"有同等的名望和身价。","source":{"text":"而二公齐名并价，莫可轩轾。","book":"明·李东阳《怀麓堂诗话》"},"usage":"作谓语、定语；指同等"},{"id":49396,"word":"齐大非偶","pinyin":"qí dà fēi ǒu","abbr":"qdfo","explanation":"指辞婚者表示自己门第或势位卑微，不敢高攀。","source":{"text":"齐侯欲以文姜妻郑大子忽，大子忽辞。人问其故，大子曰：‘人各有耦，齐大，非吾耦也。’","book":"先秦·左丘明《左传·桓公六年》"},"example":{"text":"陆徉为不知，以～，再以年貌悬殊，故意峻拒。","book":"《扫迷帚》第七回"},"similar":["齐大非耦"],"usage":"作谓语、宾语；表示不敢高攀的谦词","story":["春秋时期，强大的齐国国君想把女儿文姜嫁给郑国的公子忽，郑国比较弱小，担心其中有诈，公子忽就婉言谢绝了这门亲事。别人奇怪问他为什么。他说每个人都有适合于他的配偶，齐国那么强大，与我门不当户不对，怎能结亲呢？"]},{"id":49397,"word":"齐大非耦","pinyin":"qí dà fēi ǒu","abbr":"qdfo","explanation":"旧时凡因不是门当户对而辞婚的，常用此话表示不敢高攀的意思。","source":{"text":"齐侯欲以文姜妻郑大子忽，大子忽辞。人问其故，大子曰：‘人各有耦，齐大，非吾耦也。’","book":"《左传·桓公六年》"},"example":{"text":"臣闻～，著者前诰。辞霍不婚，垂称往烈。","book":"南朝梁·沈约《奏弹王源》"},"similar":["齐大非偶"],"usage":"作谓语、宾语；表示不敢高攀的谦词","story":["春秋时期，强大的齐国国君想把女儿文姜嫁给郑国的公子忽，郑国比较弱小，担心其中有诈，公子忽就婉言谢绝了这门亲事。别人奇怪问他为什么。他说每个人都有适合于他的配偶，齐国那么强大，与我门不当户不对，怎能结亲呢？"]},{"id":49398,"word":"齐天大圣","pinyin":"qí tiān dà shèng","abbr":"qtds","explanation":"指神通广大的人。","source":{"text":"小圣弟兄、姊妹五人，大姊骊山老母，二妹巫枝祗圣母，大兄齐天大圣，小圣通天大圣，三弟耍耍三郎。","book":"元·杨景贤《西游记》第三本第九出"},"example":{"text":"其实是主考的车子一过了卢沟桥，就送关节的送关节，交条子的交条子，一个个～，大圣齐天了。","book":"清·王濬卿《冷眼观》第十七回"},"usage":"作宾语、定语；指神通广大的人"},{"id":49399,"word":"齐天洪福","pinyin":"qí tiān hóng fú","abbr":"qthf","explanation":"洪：大。旧时颂扬人福气极大。","source":{"text":"这南阳排叟村诸葛，辅佐着洪福齐天汉帝王。","book":"元·关汉卿《西蜀梦》"},"similar":["洪福齐天"],"usage":"作谓语、宾语；用于祝福等"},{"id":49400,"word":"齐头并进","pinyin":"qí tóu bìng jìn","abbr":"qtbj","explanation":"多方面同时前进。多形容几件事情或几项工作同时进行。","source":{"text":"实事求是，循序前进，齐头并进，迎头赶上。","book":"周恩来《在上海科学技术工作会议上的讲话》"},"example":{"text":"实事求是，循序渐进，～，迎头赶上。"},"similar":["并肩前进","并驾齐驱"],"opposite":["参差错落"],"usage":"作谓语、定语；指同步进行"},{"id":49401,"word":"齐家治国","pinyin":"qí jiā zhì guó","abbr":"qjzg","explanation":"整治家庭和治理国家。","source":{"text":"所谓治国必先齐其家者，其家不可教，而能教人者，无之。故君子不出家而成教于国。","book":"西汉·戴圣《礼记·大学》"},"example":{"text":"君臣父子全忠孝，～谙经略。","book":"明·冯惟敏《点绛唇·改官谢恩》"},"usage":"作谓语、定语；指整治家庭和治理国家"},{"id":49402,"word":"齐州九点","pinyin":"qí zhōu jiǔ diǎn","abbr":"qzjd","explanation":"齐州：指中国。俯视九州，小如烟点。","source":{"text":"遥望齐州九点烟，一泓海水杯中泻。","book":"唐·李贺《梦天》诗"},"similar":["齐烟九点"],"usage":"作宾语；指看中国"},{"id":49403,"word":"齐心一力","pinyin":"qí xīn yī lì","abbr":"qxyl","explanation":"形容认识一致，共同努力。同“齐心协力”。","source":{"text":"凡我同盟，齐心一力，以致臣节，陨首丧元，必无二志。","book":"南朝·宋·范晔《后汉书·臧洪传》"},"similar":["齐心合力","齐心协力"],"usage":"作谓语、定语、状语；指共同努力"},{"id":49404,"word":"齐心一致","pinyin":"qí xīn yī zhì","abbr":"qxyz","explanation":"众人心齐，一致向一个目标。","source":{"text":"此时我们的任务，在于动员全国民众，齐心一致，绝不动摇地坚持战争，把统一战线扩大和巩固起来。","book":"毛泽东《论持久战》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“难道就不能自己人～，从洋人手里把便宜占回来？”"},"similar":["万众一心"],"usage":"作谓语、定语、状语；用于团体等"},{"id":49405,"word":"齐心併力","pinyin":"qí xīn bìng lì","abbr":"qxbl","explanation":"形容认识一致，共同努力。同“齐心协力”。"},{"id":49406,"word":"齐心协力","pinyin":"qí xīn xié lì","abbr":"qxxl","explanation":"形容认识一致，共同努力。","source":{"text":"《汤誓》曰：‘聿求元圣，与之戮力同心，以治天下。’","book":"《墨子·尚贤》"},"example":{"text":"往后咱们～，一块打反动派！","book":"冯德英《迎春花》第十九章"},"similar":["齐心合力","同心同德","万众一心"],"opposite":["离心离德","貌合神离"],"usage":"作谓语、定语、状语；指共同努力","story":["西汉末年，王莽代汉称帝，改国号新，他残暴统治引起绿林、赤眉等大型农民起义。刘秀兄弟乘机加入绿林军，他们联合下江军王常、成丹、张卬。两军合并齐心同力、锐气益壮，没几天就歼灭了王莽的精锐部队甄阜和梁丘赐"]},{"id":49407,"word":"齐心合力","pinyin":"qí xīn hé lì","abbr":"qxhl","explanation":"形容认识一致，共同努力。","source":{"text":"《汤誓》曰：‘聿求元圣，与之戮力同心，以治天下。’","book":"《墨子·尚贤》"},"example":{"text":"工人们～，只用一天时间就把道路修好了。"},"similar":["戮力同心","矢力同心"],"opposite":["貌合神离"],"usage":"作谓语、状语；指共同努力","story":["夏朝末年，末代君主夏桀非常残暴，对内实行残酷统治，百姓怨声载道，民不聊生。诸侯小国商的国君汤是一个贤明的君主，他找到大贤人伊尹辅佐，商国实力空前强大，汤见时机成熟，君臣戮力同心，齐心合力，终于灭掉夏朝"]},{"id":49408,"word":"齐心同力","pinyin":"qí xīn tóng lì","abbr":"qxtl","explanation":"形容认识一致，共同努力。同“齐心协力”。","source":{"text":"齐心同力，锐气益壮。","book":"南朝·宋·范晔《后汉书·王常传》"},"similar":["齐心协力","万众一心"],"opposite":["离心离德","各自为政"],"usage":"作谓语、定语、状语；指共同努力","story":["西汉末年，王莽代汉称帝，改国号新，他残暴统治引起绿林、赤眉等大型农民起义。刘秀兄弟乘机加入绿林军，他们联合下江军王常、成丹、张卬。两军合并齐心同力、锐气益壮，没几天就歼灭了王莽的精锐部队甄阜和梁丘赐"]},{"id":49409,"word":"齐心并力","pinyin":"qí xīn bìng lì","abbr":"qxbl","explanation":"众人一心，共同努力。亦作“齐心同力”、“朋心合力”、“齐心协力”、“齐心合力”。","source":{"text":"即引兵与汉军及新市、平林合。于是诸部齐心同力，锐气益壮，遂俱进，破杀甄阜、梁丘赐。","book":"《后汉书·王常传》"},"example":{"text":"今夜只看红灯为号，～捉拿梁山泊贼人解官请赏。","book":"明·施耐庵《水浒全传》第四十六回"},"similar":["齐心同力","齐心协力"],"usage":"作谓语、定语、状语；指共同努力"},{"id":49410,"word":"齐心戮力","pinyin":"qí xīn lù lì","abbr":"qxll","explanation":"戮：合。指同心合力。","source":{"text":"《汤誓》曰：‘聿求元圣，与之戮力同心，以治天下。’","book":"《墨子·尚贤》"},"example":{"text":"凡我同盟，～，以致臣节，必无二志。","book":"明·罗贯中《三国演义》第五回"},"similar":["齐心协力"],"opposite":["貌合神离"],"usage":"作谓语、定语；指共同努力","story":["夏朝末年，末代君主夏桀非常残暴，对内实行残酷统治，百姓怨声载道，民不聊生。诸侯小国商的国君汤是一个贤明的君主，他找到大贤人伊尹辅佐，商国实力空前强大，汤见时机成熟，君臣戮力同心，齐心合力，终于灭掉夏朝"]},{"id":49411,"word":"齐心涤虑","pinyin":"qí xīn dí lǜ","abbr":"qxdl","explanation":"净洁身心，清除杂念。同“斋心涤虑”。"},{"id":49412,"word":"齐整如一","pinyin":"qí zhěng rú yī","abbr":"qzry","explanation":"整齐一律。","source":{"text":"入魏群界，村落齐整如一，民得财足用饶。","book":"《三国志·魏志·郑浑传》"},"similar":["整整齐齐","整齐划一"],"opposite":["参差不齐"],"usage":"作谓语、定语、状语；用于秩序等"},{"id":49413,"word":"齐梁世界","pinyin":"qí liáng shì jiè","abbr":"qlsj","explanation":"齐、梁是六朝时的两个王朝，因为政治腐败，故统治时间短暂。比喻国家衰弱混乱。","source":{"text":"本朝若不是永乐振作一番，信着建文软弱，久已弄成个齐梁世界了。","book":"清·吴敬梓《儒林外史》第二十九回"},"usage":"作宾语、定语；多用于比喻句"},{"id":49414,"word":"齐烟九点","pinyin":"qí yān jiǔ diǎn","abbr":"qyjd","explanation":"齐：齐州，指中国。俯视九州，小如烟点。","source":{"text":"遥望齐州九点烟，一泓海水杯中泻。","book":"唐·李贺《梦天》诗"},"example":{"text":"再瞧那渺渺茫茫的天边，扬起一带烟尘。那不是什么“～”，同伴告诉我说那也许是炼铁厂。","book":"杨朔《泰山极顶》"},"similar":["齐州九点"],"usage":"作宾语；指看中国"},{"id":49415,"word":"齐王舍牛","pinyin":"qí wáng shě niú","abbr":"qwsn","explanation":"比喻帝王对臣民怀有恻隐之心。","source":{"text":"王（齐宣王）坐于堂上，有牵牛而过堂下者，王见之，曰：‘牛何之？’对曰：‘将以衅钟。’王曰：‘舍之。吾不忍其觳觫，若无罪而就死地。’对曰：‘然则废衅钟与？’曰：‘何可废也？以羊易之。’","book":"《孟子·梁惠王上》"},"example":{"text":"联祇膺灵命，抚遂群生，言念亭育，无忘鉴眛。殷帝去网，庶踵前修；～，实符本志。","book":"唐·高祖《禁行刑屠杀诏》"},"usage":"作宾语、定语；用于比喻句","story":["战国时期，齐宣王看到有人牵一头牛从堂前走过，便问要把牛牵到哪里去。牵牛人回答说：“将要杀掉它用来祭钟。”齐宣王说：“我不忍心看到牛被杀时发抖的样子，还是用一只羊来代替牛吧。”"]},{"id":49416,"word":"齐眉举案","pinyin":"qí méi jǔ àn","abbr":"qmja","explanation":"案：古时有脚的托盘。送饭时把托盘举得跟眉毛一样高。后形容夫妻互相尊敬。","source":{"text":"为人赁舂，每归，妻为具食，不敢于鸿前仰视，举案齐眉。","book":"《后汉书·梁鸿传》"},"example":{"text":"叹人间美中不足今方信。纵然是～，到底意难平。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["举案齐眉"],"opposite":["琴瑟不调"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":49417,"word":"齐纨鲁缟","pinyin":"qí wán lǔ gǎo","abbr":"qwlg","explanation":"古代齐国和鲁国生产的白色细绢。后也泛指名贵的丝织品。","source":{"text":"齐纨鲁缟车班班，男耕女桑不相失。","book":"南朝·梁·简文帝《谢敕赍纳袈裟启》：“荀针秦缕，因制缉而成文；鲁缟齐纨，藉馨浆而受彩。”唐·杜甫《忆昔》诗"},"example":{"text":"衣服轻细如雾，非～之比。","book":"唐·郑还古《博异记·岑文本》"},"usage":"作宾语、定语；用于书面语"},{"id":49418,"word":"齐趋并驾","pinyin":"qí qū bìng jià","abbr":"qqbj","explanation":"犹言并驾齐驱。比喻彼此的力量或才能不分高下。","source":{"text":"甲寅以后为文明华敷之世，虽灿烂可观，尚不足与他国齐趋并驾。","book":"清·刘鹗《老残游记》第11回"},"similar":["齐驱并驾","并驾齐驱"],"usage":"作谓语、定语；用于人或其他事物"},{"id":49419,"word":"齐足并驰","pinyin":"qí zú bìng chí","abbr":"qzbc","explanation":"齐足：前进的速度相同；并驰：共同快跑。比喻齐头并进，不分前后。","source":{"text":"咸以自骋骥騄于千里，仰齐足而并驰。","book":"三国·魏·曹丕《典论·论文》"},"similar":["齐足并驱","并驾齐驱"],"usage":"作谓语、定语、状语；用于书面语"},{"id":49420,"word":"齐足并驱","pinyin":"qí zú bìng qū","abbr":"qzbq","explanation":"指齐头并进，不分高下。","source":{"text":"卿才具秀拔，主公相待至重，谓卿当与孔明、孝直诸人齐足并驱。","book":"《三国志·蜀书·彭羕传》"},"similar":["齐足并驰","并驾齐驱"],"usage":"作谓语、定语、状语；用于书面语"},{"id":49421,"word":"齐轨连辔","pinyin":"qí guǐ lián pèi","abbr":"qglp","explanation":"犹言并驾齐驱。比喻彼此的力量或才能不分高下。","source":{"text":"且吾数人暂合于此，一日别去，将欲从数百里外齐轨连辔，复为此穷日之游，其又可得邪？","book":"清·王灼《游歙西徐氏园记》"},"similar":["并驾齐驱"],"usage":"作谓语、定语；多用于比喻句"},{"id":49422,"word":"齐量等观","pinyin":"qí liàng děng guān","abbr":"qldg","explanation":"指对有差别的事物同等看待。同“等量齐观”。","source":{"text":"齐量等观，则词林诸公，安非出于造物之戏也？","book":"清·蒲松龄《聊斋志异·王子安》清·何守奇评"},"example":{"text":"这两个问题不能～。"},"similar":["等量齐观"],"usage":"作谓语；多用于否定句"},{"id":49423,"word":"齐镳并驱","pinyin":"qí biāo bìng qū","abbr":"qbbq","explanation":"比喻彼此的力量或才能不分高下。同“齐驱并驾”。","source":{"text":"吾尝览《后魏书》，见杨大眼者，武伎绝伦，战功居最，其妻潘氏，颇善骑射，至于攻战游猎之际，潘于戎装，齐镳并驱。","book":"清·俞樾《茶香室丛钞·刘将军》"},"similar":["并驾齐驱"],"usage":"作谓语、定语；用于人或其他事物"},{"id":49424,"word":"齐驱并进","pinyin":"qí qū bìng jìn","abbr":"qqbj","explanation":"多方面同时前进。多形容几件事情或几项工作同时进行。同“齐头并进”。","source":{"text":"在进行当中就又逐渐分化起来，谈话的便变成了好几组了，各不相涉地齐驱并进。","book":"沙汀《淘金记》"},"similar":["齐头并进"],"usage":"作谓语、定语；指同步进行"},{"id":49425,"word":"齐驱并驾","pinyin":"qí qū bìng jià","abbr":"qqbj","explanation":"比喻彼此的力量或才能不分高下。同“齐驱并驾”。","source":{"text":"气象廓然，可与《两都》、《三京》齐驱并驾矣。","book":"宋·张戒《岁寒堂诗话》下卷"},"example":{"text":"清·无垢道人《八仙全传》第五回：“至于各地各洞的地仙散仙，以及各处各山的妖魔鬼怪，最高的不过和他～罢了。”"},"similar":["并驾齐驱","并辔齐驱","方驾齐驱"],"usage":"作谓语、定语；用于人或其他事物"},{"id":49426,"word":"齐驱并骤","pinyin":"qí qū bìng zhòu","abbr":"qqbz","explanation":"比喻彼此的力量或才能不分高下。同“齐驱并驾”。","source":{"text":"则韩、李、蒋邵之名，各齐驱并骤，与此金石之刻不朽矣。","book":"宋·王安石《上邵学士书》"},"similar":["齐趋并驾","并驾齐驱","方驾齐驱"],"usage":"作谓语、定语；用于人或其他事物"},{"id":49427,"word":"齐齐整整","pinyin":"qí qí zhěng zhěng","abbr":"qqzz","explanation":"保持整洁和有条不紊。","source":{"text":"正说着，忽见史湘云穿的齐齐整整的走来辞说家里打发人来接他。","book":"清·曹雪芹《红楼梦》第36回"},"example":{"text":"清·曹雪芹《红楼梦》第36回：“正说着，忽见史湘云穿的～的走来辞说家里打发人来接他。”"},"similar":["整整齐齐"],"opposite":["参差不齐"],"usage":"作谓语、定语、状语；指有条理"},{"id":49428,"word":"齑盐自守","pinyin":"jī yán zì shǒu","abbr":"jyzs","explanation":"比喻坚持过清贫淡泊的生活。","source":{"text":"四川成都府一秀士司马长卿，双名相如，自父母双亡，孤身无倚，齑盐自守。","book":"明·冯梦龙《警世通言》第六卷"},"example":{"text":"我再也不想过～的生活。"},"similar":["齑盐苦守"],"usage":"作宾语、定语；用于生活"},{"id":49429,"word":"齑身粉骨","pinyin":"jī shēn fěn gǔ","abbr":"jsfg","explanation":"犹言粉身碎骨。","source":{"text":"臣世受国恩，齑身粉骨，亦无以报。","book":"明王守仁《辞封爵普恩赏以彰国典疏》"},"similar":["粉身碎骨"],"usage":"作谓语、宾语；指粉身碎骨"},{"id":49430,"word":"齰舌缄唇","pinyin":"zé shé jiān chún","abbr":"zsjc","explanation":"“齰”念zé。咬舌闭口。形容闭口不言。唇，同“脣”。","source":{"text":"况怀抱之内，冰火铄脂膏，腠理之间，风霜侵骨髓，安可齰舌缄脣（唇），吞声饮气，恶呻吟之响，忍酸辛之酷哉！","book":"《隋书·王孝籍传》"}},{"id":49431,"word":"齿亡舌存","pinyin":"chǐ wáng shé cún","abbr":"cwsc","explanation":"亡：脱落，不存在。牙齿都掉了，舌头还存在。比喻刚硬的容易折断，柔软的常能保全。","source":{"text":"夫舌之存也，岂非以其柔耶？齿之亡也，岂非以其刚耶？","book":"汉·刘向《说苑·敬慎》"},"example":{"text":"你不了解～的道理吗？"},"similar":["柔能克刚","齿敝舌存"],"usage":"作定语；比喻刚硬的易折断，柔软的能保全"},{"id":49432,"word":"齿剑如归","pinyin":"chǐ jiàn rú guī","abbr":"cjrg","explanation":"犹言视死如归。","source":{"text":"比夫悬梁靡顾，齿剑如归，异日齐风，可以激扬千载矣。","book":"《晋书·列女传论》"},"similar":["视死如归"],"opposite":["贪生怕死"],"usage":"作谓语、定语；用于书面语"},{"id":49433,"word":"齿危发秀","pinyin":"chǐ wēi fā xiù","abbr":"cwfx","explanation":"指年高眉秀。","source":{"text":"至若齿危发秀之老，含经味道之生，莫不北面人宗，自同资敬。","book":"《文选·任昉》"},"example":{"text":"零陵古郡，湘水通州，有～之徒，凡四百人相与歌咏。","book":"宋·陈瞻《宣抚记》"},"usage":"作谓语、定语；用于老年人"},{"id":49434,"word":"齿如含贝","pinyin":"chǐ rú hán bèi","abbr":"crhb","explanation":"形容牙齿整齐洁白。贝，白色螺壳。","source":{"text":"腰如束素，齿如含贝。","book":"《文选·宋玉》"},"similar":["齿如齐贝","齿如编贝"],"usage":"作谓语、定语、状语；形容牙齿整齐洁白"},{"id":49435,"word":"齿如瓠犀","pinyin":"chǐ rú hù xī","abbr":"crhx","explanation":"瓠犀：瓠瓜的籽。形容牙齿洁白整齐。","source":{"text":"领如蝤蛴，齿如瓠犀。","book":"《诗经·卫风·硕人》"}},{"id":49436,"word":"齿如编贝","pinyin":"chǐ rú biān bèi","abbr":"crbb","explanation":"形容牙齿整齐洁白。贝，白色螺壳。","source":{"text":"齿如编贝汉东方，不学咿嚘况对扬。屋瓦自惊天滓，丹毫圆折露华瀼。","book":"清·龚自珍《己亥杂诗》之五二"},"similar":["齿若编贝","齿如齐贝"],"usage":"作谓语、定语、状语；形容牙齿整齐洁白"},{"id":49437,"word":"齿如齐贝","pinyin":"chǐ rú qí bèi","abbr":"crqb","explanation":"形容牙齿整齐洁白。贝，白色螺壳。","source":{"text":"唇如激丹，齿如含贝。","book":"《庄子·盗跖》"},"similar":["齿如含贝","齿若编贝"],"usage":"作谓语、定语、状语；形容牙齿整齐洁白"},{"id":49438,"word":"齿少心锐","pinyin":"chǐ shǎo xīn ruì","abbr":"csxr","explanation":"指年轻气盛，锐意进取。","source":{"text":"宗元曩者齿少心锐，径行高步，不知道之艰以陷于大厄。","book":"唐·柳宗元《上门下李夷简相公陈情书》"},"similar":["齿少气锐"],"usage":"作谓语、定语；用于年轻人"},{"id":49439,"word":"齿少气锐","pinyin":"chǐ shǎo qì ruì","abbr":"csqr","explanation":"指年轻气盛，锐意进取。","source":{"text":"夫刚直之名，吾诚有之。盖嫉恶过当，而贤、不肖太分，亦天性然也。而又齿少气锐，勇于立事，今四十有三矣。","book":"宋·王禹偁《答丁谓书》"},"similar":["齿少心锐"],"usage":"作谓语、定语；用于年轻人"},{"id":49440,"word":"齿弊舌存","pinyin":"chǐ bì shé cún","abbr":"cbsc","explanation":"指刚者易折，柔者难毁。","source":{"text":"老子曰：‘夫舌之存也，岂非以其柔耶？齿之亡也，岂非以其刚耶？’","book":"语出汉·刘向《说苑·敬慎》"},"example":{"text":"～，含垢藏疾。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["齿敝舌存"],"usage":"作宾语、定语；多用于比喻句"},{"id":49441,"word":"齿德俱尊","pinyin":"chǐ dé jù zūn","abbr":"cdjz","explanation":"齿：指人的年龄。年龄和德行都很高。常指年高德重的长者。","source":{"text":"有虞氏贵德而尚齿。","book":"《礼记·祭弋》"}},{"id":49442,"word":"齿敝舌存","pinyin":"chǐ bì shé cún","abbr":"cbsc","explanation":"牙齿都掉了，舌头还留存。比喻刚硬的容易折断，柔软的常能保全。","source":{"text":"素暴悍者，欲其观古人之小心黜己，齿敝舌存，含垢藏疾，尊贤容众，苶然沮丧，若不胜衣也。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["齿亡舌存"],"usage":"作宾语、定语；多用于比喻句"},{"id":49443,"word":"齿牙为猾","pinyin":"chǐ yá wéi huá","abbr":"cywh","explanation":"指谗言造成灾祸。","source":{"text":"献公卜伐骊戎，史苏占之，曰：‘胜而不吉。’公曰：‘何谓也？’对曰：‘遇兆，挟以衔骨，齿牙为猾。","book":"《国语·晋语一》"},"similar":["齿牙之猾"],"usage":"作宾语、定语；用于书面语"},{"id":49444,"word":"齿牙为祸","pinyin":"chǐ yá wéi huò","abbr":"cywh","explanation":"齿牙：比喻谗言。指谗言拨弄，造成灾祸。","source":{"text":"初，献公将伐骊戎，卜曰：‘齿牙为祸。’及破骊戎，获骊姬，爱之，竟以乱晋。","book":"西汉·司马迁《史记·晋世家》"},"example":{"text":"他深知～的道理，因此经常沉默寡言的。"},"similar":["祸从口出"],"usage":"作宾语；指祸从口出"},{"id":49445,"word":"齿牙之猾","pinyin":"chǐ yá zhī huá","abbr":"cyzh","explanation":"指谗言造成灾祸。","source":{"text":"然以忧栗间于多虞，卒成耳环目之塞，道致齿牙之猾。","book":"唐·柳宗元《唐故邕管招讨副使试大理司直兼贵州刺史邓君墓志铭》"},"similar":["齿牙为猾"],"usage":"作宾语、定语；用于书面语"},{"id":49446,"word":"齿牙余惠","pinyin":"chǐ yá yú huì","abbr":"cyyh","explanation":"惠：给人好处。指帮人说好话","source":{"text":"屡通媒妁，辄以无尊长之命为辞。幸无惜齿牙余惠。","book":"清·蒲松龄《聊斋志异·公孙九娘》"},"similar":["齿牙余慧"],"usage":"作宾语、定语；用于说好话"},{"id":49447,"word":"齿牙余慧","pinyin":"chǐ yá yú huì","abbr":"cyyh","explanation":"慧：通“惠”，好处。指帮人说好话","source":{"text":"夫隐恶扬善，现在功德，何惜齿牙余慧，而必以朴讷为耻。","book":"清·和邦额《夜谭随录·苏仲芬》"},"similar":["齿牙余慧"],"usage":"作宾语、定语；用于说好话"},{"id":49448,"word":"齿牙余论","pinyin":"chǐ yá yú lùn","abbr":"cyyl","explanation":"微末的赞扬言辞。比喻不费力的奖励的话。","source":{"text":"士子声名未立，应共奖成，无惜齿牙余论。","book":"《南史·谢眺传》"},"example":{"text":"欲烦先生不惜～，使令弟弃刘备而事东吴。","book":"明·罗贯中《三国演义》第四十四回"},"similar":["齿牙馀论"],"usage":"作宾语；指随口称誉的话"},{"id":49449,"word":"齿牙春色","pinyin":"chǐ yá chūn sè","abbr":"cycs","explanation":"形容爽朗地大笑。","source":{"text":"娄师德位贵而性通豁，尤善捧腹大笑。人谓师德笑，为齿牙春色。","book":"宋·陶穀《清异录·作用》"},"example":{"text":"我不能忘记他的～。"},"usage":"作宾语；指笑"},{"id":49450,"word":"齿牙馀惠","pinyin":"chǐ yá yú huì","abbr":"cyyh","explanation":"指帮人说好话。","source":{"text":"生乃坐，请所命。曰：‘令女甥寡居无耦，仆欲得主中馈。屡通媒妁，辄以无尊长之命为辞。幸无惜齿牙馀惠。’","book":"清·蒲松龄《聊斋志异·公孙九娘》"}},{"id":49451,"word":"齿牙馀慧","pinyin":"chǐ yá yú huì","abbr":"cyyh","explanation":"指帮人说好话。","source":{"text":"夫隐恶杨善，现在功德，何惜齿牙馀慧，而必以朴讷为耻。","book":"清·和邦额《夜谭随录·苏仲芬》"}},{"id":49452,"word":"齿牙馀论","pinyin":"chǐ yá yú lùn","abbr":"cyyl","explanation":"比喻随口称誉的话。","source":{"text":"士子声名未立，应共奖成，无惜齿牙馀论。","book":"《南史·谢脁传》"},"example":{"text":"今幸至江东，欲烦先生不惜～，使令弟弃刘备而事东吴。","book":"明·罗贯中《三国演义》第44回"}},{"id":49453,"word":"齿甘乘肥","pinyin":"chǐ gān chéng féi","abbr":"cgcf","explanation":"食美味，骑骏马。形容生活豪奢。","source":{"text":"而游惰者且齿甘乘肥，三代下之国家，所以有岌岌之势也。","book":"清·王韬《原士》"},"similar":["轻裘肥马"],"usage":"作谓语、定语；用于生活"},{"id":49454,"word":"齿白唇红","pinyin":"chǐ bái chún hóng","abbr":"cbch","explanation":"牙齿白，嘴唇红。形容面容美。","source":{"text":"只见唇红齿白，桃花脸，绿鬓朱颜柳叶眉，因此不忍而去。","book":"明·胡文焕《琼琚记·桑下戏妻》"},"example":{"text":"那厮唤做“小张三”，生得眉清目秀，～。","book":"明·施耐庵《水浒全传》第二十回"},"similar":["眉清目秀"],"usage":"作状语、定语；形容年轻貌美"},{"id":49455,"word":"齿若编贝","pinyin":"chǐ ruò biān bèi","abbr":"crbb","explanation":"编：顺次第排列；贝：贝壳。形容牙齿整齐洁白。","source":{"text":"目若玄珠，齿若编贝。","book":"《汉书·东方朔传》"},"similar":["齿如齐贝","齿如编贝","齿如含贝"],"opposite":["犬牙交错"],"usage":"作定语、状语；形容牙齿整齐洁白"},{"id":49456,"word":"齿落舌钝","pinyin":"chǐ luò shé dùn","abbr":"clsd","explanation":"指年老掉齿，说话不清楚。","source":{"text":"那老僧既聋且昏，又齿落舌钝，所答非所问。","book":"《红楼梦》第二回"},"opposite":["伶牙俐齿"],"usage":"作谓语、定语；用于老年人"},{"id":49457,"word":"齿豁头童","pinyin":"chǐ huō tóu tóng","abbr":"chtt","explanation":"齿缺发秃。指老态。","source":{"text":"卧埋尘叶走烟，齿豁头童不计年。","book":"宋·陈师道《宿柴城》诗"},"example":{"text":"～方吾此，乃翁见事可怜迟。","book":"宋·陆游《示儿》诗"},"similar":["老态龙钟"],"opposite":["生机勃勃"],"usage":"作谓语、定语、宾语；用于老年人"},{"id":49458,"word":"齿过肩随","pinyin":"chǐ guò jiān suí","abbr":"cgjs","explanation":"《梁书·文学传下·陆云公》：“见与齿过肩随，礼殊拜绝，怀抱相得，忘其年义。”","source":{"text":"见与齿过肩随，礼殊拜绝，怀抱相得，忘其年义。","book":"《梁书·文学传·陆云公》"},"usage":"作谓语、定语；用于交往等"},{"id":49459,"word":"齿颊挂人","pinyin":"chǐ jiá guà rén","abbr":"cjgr","explanation":"指为人们所称道。","source":{"text":"及知名之国皆有可取之物，齿颊挂人，多者二十馀种，再次亦数种，惟中国则无一见称焉。","book":"何启、胡礼垣《新政论义》"},"similar":["赞口不绝"],"usage":"作谓语、定语；用于人或事等"},{"id":49460,"word":"齿颊生香","pinyin":"chǐ jiá shēng xiāng","abbr":"cjsx","explanation":"嘴边觉有香气生出。形容谈及之事使人产生美感。","source":{"text":"怜他齿颊生香处，不在枝头在担头。","book":"清·黄景仁《即席分赋得卖花声》之二"},"example":{"text":"我只爱駪夫家的双红姐，说着还～。","book":"《儒林外史》第三四回"},"usage":"作谓语、定语；用于事情等"},{"id":49461,"word":"龃龉不入","pinyin":"jǔ yǔ bù rù","abbr":"jybr","explanation":"龃龉：上下牙齿不相配合。比喻互相抵触。常指见解不同，难于相容。","source":{"text":"吾固知其鉏铻而难入。","book":"《楚辞·九辨》"},"example":{"text":"司李与萧师争论再三，～。","book":"明·张岱《家传》"}},{"id":49462,"word":"龃龉不合","pinyin":"jǔ yǔ bù hé","abbr":"jybh","explanation":"龃龉：上下牙齿不相配合。喻意思不合，有分歧。","source":{"text":"今世之士大夫，好同而恶异，疾成而喜败，事苟不出于己，小有龃龉不合，则群起而噪之。","book":"宋·苏辙《上皇帝书》"},"example":{"text":"然贤能之进，常龃龉而不合，亦稀阔而难遭。","book":"宋·陆游《贺吏部陈侍郎启》"},"usage":"作谓语、定语；指意见不合"},{"id":49463,"word":"龃龉难入","pinyin":"jǔ yǔ nán rù","abbr":"jynr","explanation":"龃龉：上下牙齿不齐，比喻相互抵触。形容见解不合，互不相容。","source":{"text":"吾固知其鉏铻而难入。","book":"《楚辞·九辨》"},"example":{"text":"趾肇仍循唐人之风格，毋乃龃龉而难入乎？","book":"清·朱彝尊《张趾肇诗序》"},"usage":"作谓语；指意见不一致"},{"id":49464,"word":"龆年稚齿","pinyin":"tiáo nián zhì chǐ","abbr":"tnzc","explanation":"龆：儿童换齿。指童稚之年。","source":{"text":"龆年稚齿，养器深宫，习趋拜之仪，受文句之学。","book":"《南齐书·武十七王传论》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":49465,"word":"龇牙咧嘴","pinyin":"zī yá liě zuǐ","abbr":"zylz","explanation":"龇：露齿。张着嘴巴，露出牙齿。形容凶狠或疼痛难忍的样子。","source":{"text":"即咨牙咧嘴道：‘不好吃！不好吃！’","book":"明·吴承恩《西游记》第五回"},"example":{"text":"濰河两岸上的狗，吃死尸都吃红了眼，见了生人就～。","book":"峻青《秋色赋·故乡杂忆》"},"similar":["挤眉弄眼","咨牙俫嘴","龇牙裂嘴"],"usage":"作谓语、状语；指人的外貌"},{"id":49466,"word":"龇牙裂嘴","pinyin":"zī yá liè zuǐ","abbr":"zylz","explanation":"露出牙，张开嘴。形容凶狠难看的样子。","source":{"text":"杨雄、石秀都跟出前厅来看时，只见杜兴下了马，入得庄门，见他模样，气得紫涨了面皮，龇牙露嘴，半晌说不的话。","book":"明·施耐庵《水浒传》第四十七回"},"example":{"text":"吃饭一拿起饭碗，就～装鬼脸说：“怎么净吃小米，还不敌猪食。人家那边一天两顿面，我还嫌不合口味。”","book":"杨朔《熔炉》"},"similar":["龇牙咧嘴","咨牙俫嘴"],"usage":"作定语、状语；用于书面语"},{"id":49467,"word":"龈齿弹舌","pinyin":"yín chǐ dàn shé","abbr":"ycds","explanation":"龇牙咧嘴地咒骂。","source":{"text":"所饷不满所望，必龈齿弹舌，狞凶万状。","book":"明·沈德符《野获编·妇女·燕姬》"},"usage":"作谓语；指破口大骂"},{"id":49468,"word":"龈龈计较","pinyin":"yín yín jì jiào","abbr":"yyjj","explanation":"指对无关紧要的事过分计较。同“斤斤计较”。","source":{"text":"以吾两国唇齿兄弟之交就情分上原可不必龈龈计较。","book":"梁启超《中日交涉汇评·解决悬案耶新要求耶》"},"usage":"作谓语、状语；用于书面语"},{"id":49469,"word":"龌龌龊龊","pinyin":"wò wò chuò chuò","abbr":"wwcc","explanation":"指肮脏，不干净。比喻人的品质卑劣。","source":{"text":"若是龌龌龊龊的父母，必定生个邋邋遢遢的儿子。","book":"清·无名氏《说呼全传》第15回"},"example":{"text":"来里乡下勿比仔上海，随便陆里小烟间才是～个场花。","book":"清·韩邦庆《海上花列传》第58回"},"similar":["邋邋遢遢","龌里龌龊"],"usage":"作定语、状语；用于口语"},{"id":49470,"word":"龙举云兴","pinyin":"lóng jǔ yún xīng","abbr":"ljyx","explanation":"比喻王者兴起则必遇贤臣良将。同“龙兴云属”。","source":{"text":"帝既有仁圣之明，气势形体，天然之姿，固非人之敌，翕然龙举云兴，三雨而济，天下荡荡，人无能名焉。","book":"《东观汉记·光武皇帝纪》"},"similar":["龙举云属"],"usage":"作宾语、定语；用于君臣关系"},{"id":49471,"word":"龙举云属","pinyin":"lóng jǔ yún shǔ","abbr":"ljys","explanation":"比喻王者兴起则必遇贤臣良将。同“龙兴云属”。","source":{"text":"麾旆所临，风行草靡，神算所指，龙举云属。","book":"《南齐书·高帝纪上》"},"similar":["龙举云兴"],"usage":"作宾语、定语；用于君臣关系"},{"id":49472,"word":"龙争虎战","pinyin":"lóng zhēng hǔ zhàn","abbr":"lzhz","explanation":"形容斗争或竞赛很激烈。同“龙争虎斗”。","source":{"text":"春秋五伯之后，又有战国七雄，天下龙争虎战，干戈涂炭，未肯休歇。","book":"宋·孙光宪《河传》词：“龙争虎战分中土，人无主，桃叶江南渡。”《秦并六国平话》卷上"},"example":{"text":"《秦并六国平话》上卷：“春秋五伯之后，又有战国七雄，天下～，干戈涂炭，未肯休歇。”"},"similar":["龙争虎斗"],"opposite":["和平共处"],"usage":"作谓语、定语、分句；指斗争激烈"},{"id":49473,"word":"龙争虎斗","pinyin":"lóng zhēng hǔ dòu","abbr":"lzhd","explanation":"形容斗争或竞赛很激烈。","source":{"text":"分裂诸夏，龙战虎争。","book":"汉·班固《答宾戏》"},"example":{"text":"我不信你敢差排吕太后，枉以后～，都是俺鸾交凤友。","book":"元·马致远《汉宫秋》第二折"},"similar":["鹿死谁手","明争暗斗","钩心斗角"],"opposite":["团结友爱","和平共处"],"usage":"作谓语、定语、分句；指斗争激烈"},{"id":49474,"word":"龙伯钓鳌","pinyin":"lóng bó diào áo","abbr":"lbda","explanation":"龙伯：传说中的国名；鳌：大龟。龙伯国的人钓起六条鳌。比喻非凡的事业。","source":{"text":"而龙伯之国有大人，举足不盈数步，而暨五山之所，一钓而连六鳌，合负而趣归其国，灼其骨以数焉。于是岱舆、员峤二山，流于北极，沉于大海。","book":"《列子·汤问》"},"example":{"text":"～时，蓬莱一峰坼。飞来碧海畔，遂与三山隔。","book":"唐·李德裕《重忆山居六首·罗浮山》"},"usage":"作宾语、定语；指人的事业","story":["传说古代渤海东面有五座山，常随波涛浮动。上帝命15只巨鳌用头顶着，山才固定不动。龙伯国有一个人由于出门要经过这五座山，觉得十分不方便，得知其是用鳌头顶着，就用鱼饵将这鳌钓起，一连钓了六只鳌，于是这两座山就沉入大海"]},{"id":49475,"word":"龙伸蠖屈","pinyin":"lóng shēn huò qū","abbr":"lshq","explanation":"形容笔势飞动，书法高超。","source":{"text":"三台妙迹，龙伸蠖屈之书；五色华笺，河北胶东之纸。","book":"南朝·陈·徐陵《〈玉台新咏〉序》"},"usage":"作宾语、定语；用于比喻句"},{"id":49476,"word":"龙兴云属","pinyin":"lóng xīng yún shǔ","abbr":"lxys","explanation":"比喻王者兴起则必遇贤臣良将。","source":{"text":"云从龙，风从虎。","book":"《易·干》"},"example":{"text":"夫虎啸风驰，～，故重华立而元凯升，辛受生而飞廉进。","book":"南朝·梁·刘孝标《辩命论》"},"similar":["龙举云属"],"usage":"作宾语、定语；用于君臣关系"},{"id":49477,"word":"龙兴凤举","pinyin":"lóng xīng fèng jǔ","abbr":"lxfj","explanation":"比喻王者兴起。","source":{"text":"皇帝以圣德灵威，龙兴凤举，率宛叶之众，将散乱之兵，喢血昆阳，长驱武关，破百万之阵，摧九虎之军，雷震四海，席卷天下，攘除祸乱，诛灭无道。","book":"《东观汉记·冯衍传》"},"usage":"作谓语、定语；用于比喻句"},{"id":49478,"word":"龙凤呈祥","pinyin":"lóng fèng chéng xiáng","abbr":"lfcx","explanation":"指吉庆之事。","source":{"text":"天子布德，将致太平，则麟凤龟龙先为之呈祥。","book":"汉·孔鲋《孔丛子·记问》"},"example":{"text":"这是～，请相公夫人同饮太平酒。","book":"明·汪道昆《远山戏》"},"usage":"作宾语、补语；指吉庆之事"},{"id":49479,"word":"龙化虎变","pinyin":"lóng huà hǔ biàn","abbr":"lhhb","explanation":"比喻变化莫测。","source":{"text":"大人虎变，其文炳也。”《史记·老子韩非列传》“（孔子）谓弟子曰：‘鸟，吾知其能飞；鱼，吾知其能游；兽，吾知其能走。走者可以为罔，游者可以为纶，飞者可以为矰。至于龙，吾不能知其乘风云而上天。’","book":"《易·革》"},"example":{"text":"～，可以哸虚空，虚空非无也；可以贯金石，金石非有也。……知此道者形不可得毙，神不可得逝。","book":"南唐·谭峭《谭子化书·道化·龙虎》"},"similar":["千变万化"],"usage":"作宾语、定语；用于比喻句"},{"id":49480,"word":"龙去鼎湖","pinyin":"lóng qù dǐng hú","abbr":"lqdh","explanation":"指帝王去世。","source":{"text":"典出《史记·封禅书》：“黄帝采首山铜，铸鼎于荆山下。鼎既成，有龙垂胡涘下迎黄帝。黄帝上骑，群臣后宫从上者七十馀人，龙乃上去。馀小臣不得上，乃悉持龙涘，龙涘拔，堕，堕黄帝之弓。百姓仰望黄帝既上天，乃抱其弓与胡涘号，故后世因名其处曰鼎"}},{"id":49481,"word":"龙口夺食","pinyin":"lóng kǒu duó shí","abbr":"lkds","explanation":"指庄稼收获期内于连雨天抢收粮食。","example":{"text":"夏收季节，连续暴雨，我们只好～了。"},"similar":["虎口夺食"],"usage":"作谓语、宾语；用于农活"},{"id":49482,"word":"龙吟虎啸","pinyin":"lóng yīn hǔ xiào","abbr":"lyhx","explanation":"象龙在鸣，虎在啸。比喻相关的事物互相感应。也形容人发迹。","source":{"text":"尔乃龙吟方泽，虎啸山丘。","book":"汉·张衡《归田赋》"},"example":{"text":"～，鹤唳莺鸣。","book":"明·吴承恩《西游记》第六十回"},"similar":["响彻云霄","震耳欲聋"],"opposite":["不绝如缕"],"usage":"作宾语、定语、状语；指响声很大"},{"id":49483,"word":"龙多乃旱","pinyin":"lóng duō nǎi hàn","abbr":"ldnh","explanation":"比喻人多互相依赖，反而办不成事。","source":{"text":"炉火盛，爇炉木，至一边尽，众客环视，莫令止之。直舍吏至，始扑灭……徐笑谓邻坐曰：‘一二客在，岂至是乎？今不救之，罪分于众而难责，则皆莫之顾，况横身犯众，为人肩利害事耶？谚所谓龙多乃旱是也。’","book":"宋·李季可《松窗百说·恃众》"},"usage":"作宾语、定语；用于处事","story":["古代时候，人们在烤火，炉火很盛，将炉旁边的木头烧着了，众客在一旁观看，不知如何处理。直到仆人们赶到，才把火扑灭。大伙还在议论，其中一个说：“今不救之，罪分于众而难责，则皆莫之顾，况横身犯众，为人肩利害事耶？谚所谓龙多乃旱是也。"]},{"id":49484,"word":"龙头蛇尾","pinyin":"lóng tóu shé wěi","abbr":"ltsw","explanation":"比喻开头盛大，结尾衰减。","source":{"text":"如在欧公文集序，先说得许多天来底大，恁地好了，到结束处，却只如此，盖不止龙头蛇尾矣。","book":"宋·朱熹《朱子语类》第130卷"},"example":{"text":"闹了七八年，才～地告了终结。","book":"郭沫若《历史人物·隋代大音乐家万家常》"},"similar":["虎头蛇尾"],"usage":"作宾语、定语；同“虎头蛇尾”"},{"id":49485,"word":"龙头锯角","pinyin":"lóng tóu jù jiǎo","abbr":"ltjj","explanation":"比喻大胆冒险。","source":{"text":"我也不敢在虎口拔须，龙头锯角。","book":"《再生缘》第五十五回"},"similar":["虎口拔牙"],"usage":"作宾语、定语；用于冒险事情"},{"id":49486,"word":"龙姿凤采","pinyin":"lóng zī fèng cǎi","abbr":"lzfc","explanation":"形容姿态风采非凡。","source":{"text":"陶安见太祖龙姿凤采，也自羡得所主。","book":"《英烈传》第十五回"},"usage":"作宾语、定语；用于人的精神状态"},{"id":49487,"word":"龙威燕颔","pinyin":"lóng wēi yàn hàn","abbr":"lwyh","explanation":"形容威严雄武的相貌。","source":{"text":"乾隆五十四年四月，文成奉命勘荆州堤工。余时在毕秋帆尚书幕下，见之，乃身裁短小，弱不胜衣，并无龙威燕颔之相也，亦奇矣哉！","book":"清·钱泳《履园丛话·杂记·阿文成公》"},"usage":"作宾语、定语；用于比喻句"},{"id":49488,"word":"龙威虎振","pinyin":"lóng wēi hǔ zhèn","abbr":"lwhz","explanation":"形容气势奔放雄壮。常形容书法笔势的遒劲有力，灵活舒展。","source":{"text":"韦诞书如龙威虎振，剑拔弩张。","book":"南朝·梁·袁昂《古今书评》"}},{"id":49489,"word":"龙威虎震","pinyin":"lóng wēi hǔ zhèn","abbr":"lwhz","explanation":"形容气势奔放雄壮。常形容书法笔势的遒劲有力，灵活舒展。","source":{"text":"［袁昂《书评》：］梁鹄书，如龙威虎震，剑拔弩张。","book":"宋·赵与时《宾退录》卷二"},"example":{"text":"北魏书……《张公清颂》、《贾使君》、《魏灵藏》、《杨大眼》、《始平公》各造像为一种，皆出《孔羡》，具～之规。","book":"清·包世臣《安吴论书·历下笔谭》"},"usage":"作宾语、定语；用于比喻句"},{"id":49490,"word":"龙子龙孙","pinyin":"lóng zǐ lóng sūn","abbr":"lzls","explanation":"借指权贵人家的子弟。","source":{"text":"俺虽然是旧忠臣，则是四海他人。比他是龙子龙孙，则军师想度，元帅寻思，休休是他每亲的到头来也则是亲，怎辨清浑。","book":"元·尚仲贤《三鞭夺槊》第三折"},"example":{"text":"你们这些～是接受不了这个现实的。"},"similar":["金枝玉叶"],"usage":"作主语、宾语、定语；指权贵的子弟"},{"id":49491,"word":"龙屈蛇伸","pinyin":"lóng qū shé shēn","abbr":"lqss","explanation":"比喻君子受屈而小人得志。","source":{"text":"毛摧羽落君莫叹，龙屈蛇伸自终古。","book":"清·陈恭尹《送雪公归耕苍梧歌》"},"usage":"作宾语、定语；用于人"},{"id":49492,"word":"龙山落帽","pinyin":"lóng shān luò mào","abbr":"lslm","explanation":"在龙山上被风吹掉了帽子。形容人气度恢宏，临乱不惊。","example":{"text":"你听说～的事吗？"},"usage":"作宾语、定语；指人的气度","story":["东晋时期，大将军桓温在重阳佳节带上手下一行到龙山游玩，并设宴畅饮。席间，才学过人的幕僚孟嘉因戴不惯军帽，帽子被风吹落。桓温让参军孙盛写一篇文章与他的帽子放在一块嘲笑他。孟嘉立即从容地写出一篇理由充分的答文"]},{"id":49493,"word":"龙幡虎纛","pinyin":"lóng fān hǔ dào","abbr":"lfhd","explanation":"指将帅之旗。","source":{"text":"明·陈子龙《少将行》:“五营画戟青茫茫，龙幡虎纛云霞墙。”"},"usage":"作宾语、定语；用于书面语"},{"id":49494,"word":"龙归大海","pinyin":"lóng guī dà hǎi","abbr":"lgdh","explanation":"比喻摆脱困境，回到了自由自在的广阔天地。","source":{"text":"这一去正如龙投大海，虎奔高山。","book":"明·周楫《西湖二集·寄梅花鬼闹西阁》"},"example":{"text":"突然摆脱敌人安排的一切阴谋，象～似的，从人丛中逃出敌人的控制。","book":"罗广斌、杨益言《红岩》第十八章"}},{"id":49495,"word":"龙御上宾","pinyin":"lóng yù shàng bīn","abbr":"lysb","explanation":"此为皇帝之死的讳饰语。意为乘龙升天，为天帝之宾。同“龙驭上宾”。","source":{"text":"黄帝采首山铜，铸鼎于荆山下。鼎既成，有龙垂胡涘下迎黄帝。黄帝上骑，群臣后宫从上者七十馀人，龙乃上去。","book":"《史记·封禅书》"},"example":{"text":"尼古拉二世‘～’之后，罗马诺夫氏竟已‘覆宗绝祀’了。","book":"鲁迅《坟·春末闲谈》"},"similar":["龙驭上宾"],"usage":"作谓语、定语；用于皇帝死的讳饰语"},{"id":49496,"word":"龙德在田","pinyin":"lóng dé zài tián","abbr":"ldzt","explanation":"指恩德广被，无所不在。","source":{"text":"‘见龙在田’，德施普也。","book":"《易·干》"}},{"id":49497,"word":"龙心凤肝","pinyin":"lóng xīn fèng gān","abbr":"lxfg","explanation":"喻指极珍贵稀有的名菜。","source":{"text":"想咱们这样人家，吃的是鸡鸭鱼肉，也就是啦，难道说，还要吃什么龙心凤肝不成吗？","book":"京剧《乌龙院》第三场"},"example":{"text":"老头忙说：‘别价别价！我满肚子是气，就是～也吃不下去。’","book":"《中国民间故事选·大师兄闹衙门》"},"similar":["龙肝凤髓"],"usage":"作主语、宾语；指珍贵的东西"},{"id":49498,"word":"龙性难驯","pinyin":"lóng xìng nán xún","abbr":"lxnx","explanation":"驯：顺服。比喻人的修改倔强，不屈服于任何外力。","source":{"text":"鸾翻有时铩，龙性谁能驯。","book":"晋·颜延之《五君咏》"},"example":{"text":"～，肤挠不受。","book":"清·黄宗羲《黄季真先生墓志铭》"}},{"id":49499,"word":"龙战于野","pinyin":"lóng zhàn yú yě","abbr":"lzyy","explanation":"群龙在荒野大战。比喻群雄角逐。","source":{"text":"龙战于野，其血玄黄。","book":"《周易·坤》"},"example":{"text":"风波水火，～，其血玄黄。朋党之祸，与国家相始终。","book":"明·张岱《与李砚翁》"},"similar":["野战群龙"],"usage":"作宾语、定语；用于比喻句"},{"id":49500,"word":"龙战玄黄","pinyin":"lóng zhàn xuán huáng","abbr":"lzxh","explanation":"比喻战争激烈，血流成河。同“龙血玄黄”。","source":{"text":"不过，当那一声焦雷打到我们面前时，童稚之心也曾欢喜而鼓舞，也曾睁大了惊异的眼睛，痴望着‘龙战玄黄’的天地，好像这一切本在意中，要来的总归要来，而现在是终于来了而已。","book":"茅盾《回忆之类》"},"similar":["龙血玄黄"],"usage":"作宾语、定语；用于比喻句"},{"id":49501,"word":"龙战虎争","pinyin":"lóng zhàn hǔ zhēng","abbr":"lzhz","explanation":"比喻势均力敌的各方之间，斗争或竞赛十分激烈。","source":{"text":"于是七雄虓阚，分裂诸夏，龙战虎争。","book":"汉·班固《答宾戏》"},"example":{"text":"三国·魏·邓艾《报后主降书》：“王纲失道，群英并起，～，终归真主。”"},"usage":"作宾语、定语；用于比喻句"},{"id":49502,"word":"龙战鱼骇","pinyin":"lóng zhàn yú hài","abbr":"lzyh","explanation":"比喻战争激烈。","source":{"text":"以视建武元年以后，十二年以前，龙战虎骇，盖不侔矣。","book":"《中国近代思想史参考资料简编·驳革命可以内乱说》"},"usage":"作宾语、定语；用于比喻句"},{"id":49503,"word":"龙投大海，虎奔高山","pinyin":"lóng tóu dà hǎi，hǔ bèn gāo shān","abbr":"ltdhhbgs","explanation":"比喻摆脱困境，回到了自由自在的广阔天地。","source":{"text":"这一去正如龙投大海，虎奔高山。","book":"明·周楫《西湖二集·寄梅花鬼闹西阁》"}},{"id":49504,"word":"龙拏虎掷","pinyin":"lóng ná hǔ zhì","abbr":"lnhz","explanation":"犹言龙争虎斗。","source":{"text":"笑云此公大肚皮，龙拏虎掷填胸胄。","book":"宋·喻汝砺《八阵图》诗"},"example":{"text":"自汉迄今，全史之大，部分，皆演于江河间之原野，被～，甲兴乙仆，殆未有出山东、安徽、江苏、河南、湖北数省外者也。","book":"梁启超《中国地理大势论》"},"similar":["龙拏虎跳","龙争虎斗"],"usage":"作谓语、定语、宾语；指斗争激烈"},{"id":49505,"word":"龙拏虎攫","pinyin":"lóng ná hǔ jué","abbr":"lnhj","explanation":"犹言龙争虎斗。比喻笔势遒劲、奔放。","source":{"text":"新城王西樵阮亭，每过邮亭夜店，辄题诗壁上，诗既惊人，使笔斗大，龙拏虎攫。","book":"清·王晫《今世说·企羡》"},"similar":["龙拿虎攫","龙争虎斗","龙拏虎跳"],"usage":"作宾语、定语；用于比喻句"},{"id":49506,"word":"龙拏虎跳","pinyin":"lóng ná hǔ tiào","abbr":"lnht","explanation":"犹言龙争虎斗。","source":{"text":"说霸争王各不让，龙拏虎跳旦复昏。","book":"俞锷《醉歌行》"},"example":{"text":"我以为这并不比～的战斗场面少些激动人心的力量。","book":"茅盾《北方的原野》"},"similar":["龙拏虎攫","龙拿虎跳","龙争虎斗"],"usage":"作宾语、定语；用于比喻句"},{"id":49507,"word":"龙拿虎掷","pinyin":"lóng ná hǔ zhì","abbr":"lnhz","explanation":"像龙一样抓取，像虎一样跳跃。比喻威武勇猛。","source":{"text":"正是龙拿虎掷、燕叱莺嗔、天地无声、风云异色的时候。","book":"清·曾朴《孽海花》第十七回"},"example":{"text":"以～之加里波的，一旦投闲置散于故乡万里之外……蹉跎岁月，何以为情。","book":"清·梁启超《意大利建国三杰传》第五章"}},{"id":49508,"word":"龙拿虎跳","pinyin":"lóng ná hǔ tiào","abbr":"lnht","explanation":"像龙一样抓取，像虎一样跳跃。比喻威武勇猛。","source":{"text":"飞电马，追风马，跨上时电卷风驰；龙骧军，虎贲军，用着他龙拿虎跳。","book":"清·文康《儿女英雄传》缘起首回"},"similar":["龙拏虎跳","龙争虎斗"],"usage":"作宾语、定语；用于比喻句"},{"id":49509,"word":"龙攀凤附","pinyin":"lóng pān fèng fù","abbr":"lpff","explanation":"犹言攀龙附凤。指巴结投靠有权势的人以获取富贵。","source":{"text":"攀龙鳞，附凤翼，巽以扬之，勃勃乎其不可及也。","book":"汉·扬雄《法言·渊骞》"},"similar":["攀龙附凤"],"usage":"作谓语、宾语、定语；指巴结别人"},{"id":49510,"word":"龙斗虎争","pinyin":"lóng dòu hǔ zhēng","abbr":"ldhz","explanation":"比喻势均力敌的各方之间，斗争或竞赛十分激烈。","source":{"text":"于是七雄虓阚，分裂诸夏，龙战虎争。","book":"汉·班固《答宾戏》"}},{"id":49511,"word":"龙断之登","pinyin":"lóng duàn zhī dēng","abbr":"ldzd","explanation":"指谋利求财。龙，通“垄”。","source":{"text":"豪侠之质，可与入圣人之道者，约有数端。侠者薄视财利，弃万金而不眄；而圣贤则富贵不处，贫贱不去，痛恶夫播间之食、龙断之登。","book":"曾国藩《笔记·劝学篇示直隶士子》"}},{"id":49512,"word":"龙断可登","pinyin":"lóng duàn kě dēng","abbr":"ldkd","explanation":"指可经营得利。龙，通“垄”。"},{"id":49513,"word":"龙标夺归","pinyin":"lóng biāo duó guī","abbr":"lbdg","explanation":"科举时代指状元及第。","source":{"text":"大魁首夺龙标，卢肇黄颇缘宜春人，同举。郡守独饯颇，明年，肇状元及第。归。郡守接甚厚。向道是龙刚不信，果然夺得锦标归，守大惭。","book":"宋·胡继宗《书言故事·科第类》"}},{"id":49514,"word":"龙楼凤城","pinyin":"lóng lóu fèng chéng","abbr":"llfc","explanation":"犹言龙楼凤池。指禁省，皇宫。","source":{"text":"论文章围棘堪驰骋，愿藏身龙楼凤城。","book":"明·陈汝元《金莲记·偕计》"},"similar":["龙楼凤池"],"usage":"作主语、宾语；指皇宫"},{"id":49515,"word":"龙楼凤池","pinyin":"lóng lóu fèng shi","abbr":"llfc","explanation":"指禁省，皇宫。","source":{"text":"念生长在香闰绣帏，念出入在龙楼凤池。","book":"明·梁辰鱼《浣纱记·送钱》"},"similar":["龙楼凤城","龙楼凤阁"],"usage":"作主语、宾语；指皇宫"},{"id":49516,"word":"龙楼凤阁","pinyin":"lóng lóu fèng gé","abbr":"llfg","explanation":"①帝王的宫殿、楼阁。②喻指封建统治者的巢穴。","source":{"text":"纵有些燕友莺朋，似望着龙楼凤阁。","book":"元·马致远《拨不断》曲：“九重天，二十年，龙楼凤阁都曾见。”元·石德玉《紫云亭》第三折"},"example":{"text":"～都抛却，梦绕荒山夜月寒。","book":"吴梅《风洞山留驾》诗"},"similar":["龙楼凤池","龙楼凤阙"],"usage":"作主语、宾语；指皇宫"},{"id":49517,"word":"龙楼凤阙","pinyin":"lóng lóu fèng què","abbr":"llfq","explanation":"指帝王宫阙。","source":{"text":"龙楼凤阙郁峥嵘，深宫不闻更漏声。","book":"宋·欧阳修《鹎鵊词》诗"},"similar":["龙楼凤阁"],"usage":"作主语、宾语；指皇宫"},{"id":49518,"word":"龙江虎浪","pinyin":"lóng jiāng hǔ làng","abbr":"ljhl","explanation":"形容惯于兴风作浪。","source":{"text":"［蕙莲］性明敏，善机变，会妆饰，龙江虎浪，就是嘲汉子的班头，坏家规的领袖。","book":"明·兰陵笑笑生《金瓶梅词话》第二十二回"},"usage":"作宾语；用于作乱"},{"id":49519,"word":"龙泉太阿","pinyin":"lóng quán tài ē","abbr":"lqte","explanation":"指古代的两件宝剑。","example":{"text":"我真想拥有～这两把宝剑。"},"similar":["干将莫邪"],"usage":"作主语、宾语、定语；指古代宝剑","story":["三国后期，中书令张华主张晋武帝司马炎攻打东吴。灭了东吴后，张华成为宰相。他找来懂星象学的雷焕，让他去做丰城县令。雷焕在一个牢房下面挖出两口宝剑，即“龙泉”和“太阿”，它们是春秋时期最名贵的宝剑干将莫邪"]},{"id":49520,"word":"龙游曲沼","pinyin":"lóng yóu qū zhǎo","abbr":"lyqz","explanation":"传说龙耀五彩，所以以游龙为喻。沼：池子。","source":{"text":"其素若何，春梅绽雪。其洁若何，秋菊被霜。其静若何，松生空谷。其艳若何，霞映澄塘。其文若何，龙游曲沼。其神若何，月射寒江。","book":"清·曹雪芹《红楼梦》第五回"}},{"id":49521,"word":"龙潜凤采","pinyin":"lóng qián fèng cǎi","abbr":"lqfc","explanation":"比喻英俊之士才能未展现。"},{"id":49522,"word":"龙潭虎穴","pinyin":"lóng tán hǔ xué","abbr":"lthx","explanation":"龙潜居的深水坑，老虎藏身的巢穴。比喻极险恶的地方。","source":{"text":"不甫能撞开了天关地户，跳出这龙潭虎窟。","book":"元·无名氏《昊天塔》第三折"},"example":{"text":"你父亲因他不是个诗书礼乐之门，一面推辞，便要离了这～。","book":"清·文康《儿女英雄传》第十九回"},"similar":["悬崖峭壁","刀山火海"],"opposite":["洞天福地","鱼米之乡"],"usage":"作主语、宾语、定语；比喻极险恶的地方"},{"id":49523,"word":"龙潭虎窟","pinyin":"lóng tán hǔ kū","abbr":"lthk","explanation":"潭：深水池；窟：洞穴。龙居住的深水潭，虎栖身的巢穴。比喻极其凶险的地方。","source":{"text":"不甫能撞开了天关地户，跳出这龙潭虎窟。","book":"元·朱凯《昊天塔》第三折"},"example":{"text":"你便是那汑太子，怎逃地网天罗？火首金刚，难脱～！","book":"明·施耐庵《水浒传》第59回"},"similar":["龙潭虎穴"],"usage":"作主语、宾语、定语；比喻极险恶的地方"},{"id":49524,"word":"龙生九子","pinyin":"lóng shēng jiǔ zǐ","abbr":"lsjz","explanation":"古代传说，龙生有九子，九子不成龙，各有所好。比喻同胞兄弟品质、爱好各不相同。","source":{"text":"龙生九子不成龙，各有所好。","book":"明·徐应秋《玉芝堂谈荟·龙生九子》"},"example":{"text":"真是～，各有所长。"},"similar":["龙生九种"],"usage":"作主语、宾语、定语；用于兄弟等比较","story":["传说东海龙王生了九个儿子，性格各异，各有所长。大儿子囚牛喜欢音乐，老二虫睚眦嗜好攻杀，老三嘲风喜欢探险，老四蒲牢喜爱鸣叫，老五狻猊好坐，老六霸下喜爱负重，老七狴犴喜好诉讼，老八赑屃好文，老九虫吻好吞"]},{"id":49525,"word":"龙生九种","pinyin":"lóng shēng jiǔ zhǒng","abbr":"lsjz","explanation":"比喻同胞兄弟品质、爱好各不相同。同“龙生九子”。","source":{"text":"此正谓‘龙生九种，九种各别。’","book":"明·吴承恩《西游记》第四十三回：“敖顺道"},"example":{"text":"原来这学中虽都是本族人丁与些亲戚的子弟，俗语说的好：“一～，种种各别。 ”未免人多了，就有龙蛇混杂，下流人物在内。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["龙生九子"],"usage":"作主语、宾语、定语；用于兄弟等比较","story":["传说东海龙王生了九个儿子，性格各异，各有所长。大儿子囚牛喜欢音乐，老二虫睚眦嗜好攻杀，老三嘲风喜欢探险，老四蒲牢喜爱鸣叫，老五狻猊好坐，老六霸下喜爱负重，老七狴犴喜好诉讼，老八赑屃好文，老九虫吻好吞"]},{"id":49526,"word":"龙生龙，凤生凤","pinyin":"lóng shēng lóong，fèng shēng fèng","abbr":"lslfsf","explanation":"原用以宣扬血统论。后也指家族环境对人的影响。","source":{"text":"师曰：‘龙生龙子，凤生凤儿。’","book":"宋·释道原《景德传灯录》卷十四"},"example":{"text":"正所谓～，福临生长在龙凤之家，他又能差到哪里去呢？","book":"杨立平《顺治皇帝》十"}},{"id":49527,"word":"龙盘凤翥","pinyin":"lóng pán fèng zhù","abbr":"lpfz","explanation":"比喻山势雄壮蜿蜒。指王者的气象。亦比喻书法笔势飞动。","source":{"text":"初，上皇亲拜五陵，至桥陵，见金粟山有龙盘凤翥之势。","book":"后晋·沈昫《旧唐书·玄宗纪》"},"example":{"text":"诏二臣共作《艮岳百咏诗》以进……《草圣亭》：落笔纵横走电光，近臣时得赐云章。～皆天纵，渴骥惊蛇不足方。","book":"宋·王明清《挥尘后录》卷二"},"similar":["龙盘凤舞"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":49528,"word":"龙盘凤舞","pinyin":"lóng pán fèng wǔ","abbr":"lpfw","explanation":"比喻山川雄踞蜿蜒，有王者气象。","source":{"text":"都会地，东南王气须记。龙盘凤舞到钱塘，瑞烟回起。","book":"宋·方千里《西河·钱塘》词"},"usage":"作宾语、定语；用于比喻句"},{"id":49529,"word":"龙盘凤逸","pinyin":"lóng pán fèng yì","abbr":"lpfy","explanation":"比喻怀才不遇。","source":{"text":"一登龙门，即声誉十倍，所以龙盘凤逸之士，皆欲收名定价于君侯。","book":"唐·李白《与韩荆州书》"},"similar":["龙蟠凤逸"],"usage":"作谓语、宾语；比喻有才能而没有人赏识"},{"id":49530,"word":"龙盘虎拏","pinyin":"lóng pán hǔ ná","abbr":"lphn","explanation":"虬曲苍劲的样子。","source":{"text":"龙盘虎拏终有神，白骨苍鳞半枯死。","book":"明·何景明《古松歌》"},"similar":["龙盘虎拿"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":49531,"word":"龙盘虎踞","pinyin":"lóng pán hǔ jù","abbr":"lphj","explanation":"盘：曲折环绕；踞：蹲、坐。好像盘绕的龙，蹲伏的虎。特指南京。亦形容地势雄伟险要。","source":{"text":"条枝摧折，既剥且刊，见其文章，或如龙盘虎踞，复似鸾集凤翔。","book":"汉·刘胜《文本赋》"},"example":{"text":"紫髯碧眼号英雄，能使臣僚肯尽忠。二十四年兴大业，～在江东。","book":"明·罗贯中《三国演义》第108回"},"similar":["虎跨龙盘","龙蟠虎踞"],"opposite":["一马平川"],"usage":"作谓语、定语；指地势险要"},{"id":49532,"word":"龙眉凤目","pinyin":"lóng méi fèng mù","abbr":"lmfm","explanation":"形容人英俊，气度不凡。","source":{"text":"马上那人，生得龙眉凤目，皓齿朱唇。","book":"明·施耐庵《水浒传》第九回"},"example":{"text":"众人看时，只见生得～，举止不凡。","book":"清·李汝珍《镜花缘》第56回"},"usage":"作宾语、定语；多用于男性"},{"id":49533,"word":"龙眉豹颈","pinyin":"lóng méi bào jǐng","abbr":"lmbj","explanation":"形容勇士的长相。","source":{"text":"昂字敖曹，乾第三弟。幼稚时，便有壮气。长而俶傥，胆力过人，龙眉豹颈， 姿体雄异。","book":"《北齐书·高昂传》"},"usage":"作宾语、定语；用于比喻句"},{"id":49534,"word":"龙睁虎眼","pinyin":"lóng zhēng hǔ yǎn","abbr":"lzhy","explanation":"形容蛮横霸道。","source":{"text":"你而今作速和彭三老爷去商议。他家一门都是龙睁虎眼的脚色，只有三老还是个盛德人。","book":"清·吴敬梓《儒林外史》第四十五回"},"usage":"作谓语、定语；用于比喻句"},{"id":49535,"word":"龙神马壮","pinyin":"lóng shén mǎ zhuàng","abbr":"lsmz","explanation":"谓像骏马一样的有精神。","source":{"text":"那时候，一个个青年人都是龙神马壮，气吞牛斗，争论起世界国家大事来，都是口若悬河，当当不断，慷慨激昂，谁也不让谁。","book":"欧阳山《苦斗》四六"},"usage":"作定语、状语；用于人的精神"},{"id":49536,"word":"龙章凤函","pinyin":"lóng zhāng fèng hán","abbr":"lzfh","explanation":"比喻文采炳焕。","source":{"text":"龙章凤函，天子有诰。","book":"明·李东阳《赠太子太保镇远侯顾公合葬墓志铭》"},"usage":"作宾语、定语；用于比喻句"},{"id":49537,"word":"龙章凤姿","pinyin":"lóng zhāng fèng zī","abbr":"lzfz","explanation":"章：文采。蛟龙的文采，凤凰的姿容。比喻风采出众。","source":{"text":"康长七尺八寸，伟容色，土木形骸，不加饰厉，而龙章凤姿，天质自然。","book":"南朝·宋·刘义庆《世说新语·容止》刘孝标注"},"example":{"text":"～士不见用；獐头鼠目乃欲求官耶？","book":"清·袁枚《随园诗话》卷十四"},"similar":["龙章凤彩"],"usage":"作宾语、定语；指人的风采"},{"id":49538,"word":"龙章凤彩","pinyin":"lóng zhāng fèng cǎi","abbr":"lzfc","explanation":"不凡的仪表风采。","source":{"text":"君纯德天资，大材灵降，龙章凤彩，凝脂点漆。","book":"唐·邵混之《元氏县令庞君清德碑》"},"usage":"作宾语、定语；用于比喻句"},{"id":49539,"word":"龙章秀骨","pinyin":"lóng zhāng xiù gǔ","abbr":"lzxg","explanation":"比喻文章秀逸遒劲。","source":{"text":"龙章秀骨苦轻时，继作五弦须款款。","book":"宋·梅尧臣《读黄莘秘校卷》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":49540,"word":"龙章麟角","pinyin":"lóng zhāng lín jiǎo","abbr":"lzlj","explanation":"比喻珍希，不凡。","source":{"text":"天下规矩见卓绝，龙章麟角诸公子。","book":"元·杨应登《寄赵梅州》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":49541,"word":"龙精虎猛","pinyin":"lóng jīng hǔ měng","abbr":"ljhm","explanation":"比喻精力旺盛，斗志昂扬。","source":{"text":"大家一夜没睡觉，到如今还是龙精虎猛，表现了兄弟姐妹们对地主的仇恨。","book":"陈残云《山谷风烟》第二一章"},"usage":"作谓语、宾语；用于人的精神状态"},{"id":49542,"word":"龙翔凤翥","pinyin":"lóng xiáng fèng zhù","abbr":"lxfz","explanation":"①比喻瀑布飞泻奔腾。②比喻神采飞扬。","source":{"text":"宋世都临安，江山已失据。犹夸天目山，龙翔而凤翥。","book":"清·顾炎武《杭州》诗之一"},"example":{"text":"～君堪喜，骥附骖随我敢吁？","book":"柳亚子《十月六日题毛主席之绘像》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":49543,"word":"龙翔凤舞","pinyin":"lóng xiáng fèng wǔ","abbr":"lxfw","explanation":"犹言龙飞凤舞。原形容山势的蜿蜒雄壮，后也形容书法笔势有力，灵活舒展。","source":{"text":"山势自西北来，如龙翔凤舞，掀腾而下，至凤凰山止。","book":"宋·赵彦卫《云麓漫钞》卷三"},"example":{"text":"但我们之间……自己仅仅经过手，签个名，只考究自己签名的字，是否～，足够威势，也算是用过笔了。","book":"巴人《况钟的笔》"},"similar":["龙翔凤跃"],"usage":"作宾语、定语；用于比喻句"},{"id":49544,"word":"龙翔凤跃","pinyin":"lóng xiáng fèng yuè","abbr":"lxfy","explanation":"原形容山势的蜿蜒雄壮，后也形容书法笔势有力，灵活舒展。同“龙翔凤舞”。","source":{"text":"诡然如龙翔凤跃，纯乎玉振而金声。","book":"宋·苏轼《告文宣王文》"},"similar":["龙翔凤舞"],"usage":"作宾语、定语；用于比喻句"},{"id":49545,"word":"龙翔虎跃","pinyin":"lóng xiáng hǔ yuè","abbr":"lxhy","explanation":"比喻奋发有为。","source":{"text":"其盖世之姿，雄伟之志，用天下国家之心，得不发为千汇万状之奇而龙翔虎跃也。","book":"明·叶蕃《〈写情集〉序》"},"similar":["龙腾虎跃"],"usage":"作宾语、定语；用于比喻句"},{"id":49546,"word":"龙翰凤翼","pinyin":"lóng hàn fèng yì","abbr":"lhfy","explanation":"比喻杰出的人才。","source":{"text":"徵事邴原、议郎张范，皆秉德纯懿，志行忠方，清净足以厉俗，贞固足以干事，所谓龙翰凤翼，国之重宝。举而用之，不仁者远。","book":"《三国志·魏志·邴原传》"},"similar":["龙翰凤雏"],"usage":"作宾语、定语；用于比喻句"},{"id":49547,"word":"龙翰凤雏","pinyin":"lóng hàn fèng chú","abbr":"lhfc","explanation":"比喻杰出的人才。","source":{"text":"习凿齿《襄阳记》曰：‘旧目诸葛孔明为卧龙，庞士元为凤雏。’","book":"《文选·刘孝标〈广绝交论〉》：“颜冉龙翰凤雏，曾史兰薰雪白。”李善注"},"similar":["龙翰凤翼"],"usage":"作宾语、定语；用于比喻句"},{"id":49548,"word":"龙肝凤胆","pinyin":"lóng gān fèng dǎn","abbr":"lgfd","explanation":"比喻极难得的珍贵食品。","source":{"text":"海错山珍锦盘中，捧着龙肝凤胆；金波玉液银壶内，泛出青黄碧绿。","book":"明·罗贯中《粉妆楼》第七十九回"},"example":{"text":"今日能够见到老兄，畅快谈心，比吃～还要快意。","book":"姚雪垠《李自成》第一卷第二十六章"}},{"id":49549,"word":"龙肝凤脑","pinyin":"lóng gān fèng nǎo","abbr":"lgfn","explanation":"比喻极难得的珍贵食品。","source":{"text":"玄德曰：‘备闻公将去，如失左右手。虽龙肝凤髓，亦不甘味。","book":"明·罗贯中《三国演义》第三十六回"},"similar":["龙肝凤髓"],"usage":"作主语、宾语；指珍贵的东西"},{"id":49550,"word":"龙肝凤髓","pinyin":"lóng gān fèng suǐ","abbr":"lgfs","explanation":"比喻极难得的珍贵食品。","source":{"text":"虽龙肝凤髓，有不及者。","book":"宋·苏轼《江瑶柱传》"},"example":{"text":"～寻不见，粗茶淡饭也觉甜。","book":"《小说选刊》"},"similar":["龙肝豹胎","龙心凤肝"],"usage":"作主语、宾语；指珍贵的东西"},{"id":49551,"word":"龙肝豹胎","pinyin":"lóng gān bào tāi","abbr":"lgbt","explanation":"比喻极难得的珍贵食品。","source":{"text":"厥肴伊何？龙肝豹胎。","book":"《晋书·潘尼传》"},"similar":["龙肝凤髓"],"usage":"作宾语；比喻极难得的珍贵食品"},{"id":49552,"word":"龙胡之痛","pinyin":"lóng hú zhī tòng","abbr":"lhzt","explanation":"指丧亲之痛。","source":{"text":"黄帝采首山铜，铸鼎于荆山下。鼎既成，有龙垂胡涘下迎黄帝。黄帝上骑，群臣后宫从上龙七十馀人，龙乃上去……百姓卬望黄帝既上天，乃抱其弓与龙涘号。","book":"《汉书·郊祀志上》"},"example":{"text":"顾此襢编之锡，曾不间于乌鸟之怀；是各簪履之遗，益无解于～。","book":"清·钱谦益《尚宝司少卿袁可立前母陆氏加赠宜人制》"},"usage":"作宾语；用于书面语","story":["传说上古时期，黄帝带领百姓在首山采铜，到荆山下铸鼎。鼎铸成后，有龙垂下胡髯来迎接黄帝，黄帝立即骑上龙髯，群臣与后宫等70多人随从也上了龙髯，龙开始飞上天，百姓仰望黄帝上天，纷纷抱着弓与龙髯哭泣"]},{"id":49553,"word":"龙腾凤集","pinyin":"lóng téng fèng jí","abbr":"ltfj","explanation":"比喻王业兴盛，英雄会合。","source":{"text":"气凌云天，龙腾凤集，尽为风消土吃，狐掇蚁拾。","book":"前蜀·贯休《相和歌辞·蒿里》"},"usage":"作谓语、定语；用于英雄聚会"},{"id":49554,"word":"龙腾虎啸","pinyin":"lóng téng hǔ xiào","abbr":"lthx","explanation":"声势壮盛的样子。","source":{"text":"龙腾虎啸势莫当，谁知芒砀云飞扬？","book":"明·陈子龙《望下邳作七言古》"},"example":{"text":"旌旗招展，围场横开，～，不足比其雄。","book":"清·百一居士《壶天录》卷下"},"similar":["龙骧虎啸"],"usage":"作宾语、定语；用于气势"},{"id":49555,"word":"龙腾虎掷","pinyin":"lóng téng hǔ zhì","abbr":"lthz","explanation":"比喻勇猛冲击，势不可当。同“龙腾虎蹴”。","source":{"text":"战鼓三挝，龙腾虎掷挪。","book":"清·夏清贻《何日醒·东三省》"},"similar":["龙腾虎蹴","龙腾虎踯"],"usage":"作定语、状语；用于比喻句"},{"id":49556,"word":"龙腾虎跃","pinyin":"lóng téng hǔ yuè","abbr":"lthy","explanation":"象龙在飞腾，虎在跳跃。形容跑跳时动作矫健有力。也比喻奋起行动，有所作为。","source":{"text":"圣人受命，贤人受任，龙腾虎跃，风流云蒸，求之精微，其道莫不咸系乎天者也。","book":"唐·严从《拟三国名臣赞序》"},"example":{"text":"但是他的心情十分敞朗，坚信只要度过这段困难日子，局势就会好转，任自己～。","book":"姚雪垠《李自成》第二卷第二十七章"},"similar":["英姿勃勃","生龙活虎"],"opposite":["温文尔雅","暮色沉沉","死气沉沉"],"usage":"作谓语、定语；指十分活跃"},{"id":49557,"word":"龙腾虎踞","pinyin":"lóng téng hǔ jù","abbr":"lthj","explanation":"势力强盛，雄据一方。","source":{"text":"彼虽降高抑满，以贵下贱，终亦并目以远其明，假耳以广其聪，龙腾虎踞，宜其然也。","book":"晋·葛洪《抱朴子·钦士》"},"usage":"作宾语、定语；用于比喻句"},{"id":49558,"word":"龙腾虎踯","pinyin":"lóng téng hǔ zhí","abbr":"lthz","explanation":"比喻勇猛冲击，势不可当。同“龙腾虎蹴”。","source":{"text":"有拿破仑之龙腾虎踯，而后率轻躁之拉丁人震慑全欧。","book":"诤民《五月二十一日上谕恭注》"},"similar":["龙腾虎蹴","龙腾虎掷"],"usage":"作定语、状语；用于比喻句"},{"id":49559,"word":"龙腾虎蹴","pinyin":"lóng téng hǔ cù","abbr":"lthc","explanation":"比喻勇猛冲击，势不可当。","source":{"text":"［太祖］与一弟三侍卫弃军先进，渡河冲阵，龙腾虎蹴以四人败敌八百。","book":"清·魏源《圣武记》卷一"},"similar":["龙腾虎踯"],"usage":"作定语、状语；用于比喻句"},{"id":49560,"word":"龙腾豹变","pinyin":"lóng téng bào biàn","abbr":"ltbb","explanation":"比喻议论风发，能言善变。","source":{"text":"高谈则龙腾豹变，下笔则烟飞雾凝。","book":"唐·卢照邻《五悲·悲才难》"},"usage":"作谓语、宾语；用于人的口才"},{"id":49561,"word":"龙荒朔漠","pinyin":"lóng huāng shuò mò","abbr":"lhsm","explanation":"北方塞外荒漠之地。亦指在这些地方的少数民族国家。","source":{"text":"中宗明明，寅用刑名。时举傅纳，听断惟精。柔远能迩，燀燿威灵。龙荒朔漠，莫不来庭。丕显烈祖，尚於有成。","book":"汉·班固《宣帝述》"},"example":{"text":"遂乃三俘伪主，开涤五都，雕颜卉服之乡，～之长，莫不回首朝阳，沐浴玄泽。","book":"《宋书·武帝纪中》"},"similar":["龙荒蛮甸"],"usage":"作宾语、定语；用于比喻句"},{"id":49562,"word":"龙荒蛮甸","pinyin":"lóng huāng mán diàn","abbr":"lhmd","explanation":"指边远蛮荒之地。亦指边远之地的少数民族国家。","source":{"text":"明·宋濂《法海精舍记》：“远而龙荒蛮甸，弁韩巴■(↑棘↓乂)之人，莫不持芗膜拜。"},"example":{"text":"明·宋濂《法海精舍记》：“远而～，弁韩巴之人，莫不持芗膜拜。”"},"similar":["龙荒朔漠"],"usage":"作宾语、定语；用于比喻句"},{"id":49563,"word":"龙虎榜","pinyin":"lóng hǔ bǎng","abbr":"lhb","explanation":"榜：揭示的名单。指一个时期内的知名人士同登一榜。","source":{"text":"举进士，与韩愈、崔群、王涯、冯宿、庚承定联第，皆天下选，时称‘龙虎榜’。","book":"《新唐书·欧阳詹传》"},"example":{"text":"翰林高谈～，中书冒占凤凰池。","book":"清·吴敬梓《儒林外史》第四十九回"}},{"id":49564,"word":"龙虎风云","pinyin":"lóng hǔ fēng yún","abbr":"lhfy","explanation":"①比喻英雄豪杰际遇得时。②指君臣遇合。","source":{"text":"云从龙，风从虎。","book":"《易·干》"},"example":{"text":"善教他，归厚德，太平时～会。","book":"元·马致远《粉蝶儿》套曲"},"usage":"作宾语、定语；用于比喻句"},{"id":49565,"word":"龙蛇不辨","pinyin":"lóng shé bù biàn","abbr":"lsbb","explanation":"比喻分不清好人和坏人。","source":{"text":"大唐家，朝冶里龙蛇不辨，禁帏中共猪狗同眠。河洛间图书皆现，日月下清浑不辨。","book":"元·王伯成《李太白贬夜郎》第四折"},"example":{"text":"禅语有声东击西之类，学者亦有野狐口头之徒，假若～，自然临歧徘徊。","book":"《佛学问答类编·禅观第九》"}},{"id":49566,"word":"龙蛇混杂","pinyin":"lóng shé hùn zá","abbr":"lshz","explanation":"比喻好人和坏人混在一起。","source":{"text":"凡圣同居，龙蛇混杂。","book":"《敦煌变文集·伍子胥变文》：“皂帛难分，龙蛇混杂。”宋·释道元《景德传灯录·文殊》"},"example":{"text":"此时～，是非莫辨，安知我辈不是姜尚之所使耳？在将军不得不疑。","book":"明·许仲琳《封神演义》第九十三回"},"similar":["鱼龙混杂"],"usage":"作谓语、定语；比喻好人和坏人混杂在一起"},{"id":49567,"word":"龙蛇飞动","pinyin":"lóng shé fēi dòng","abbr":"lsfd","explanation":"仿佛龙飞腾，蛇游动。形容书法气势奔放，笔力劲健。","source":{"text":"十年不见老仙翁，壁上龙蛇飞动。","book":"宋·苏轼《西江月·平山堂》词"},"example":{"text":"道士卷起袍口，磨得墨浓，蘸得笔饱，在照壁上～，挥下碗口大小的二十八字。","book":"清·陈忱《水浒后传》第三十七回"},"similar":["龙飞凤舞","龙蛇飞舞"],"usage":"作宾语；形容书法气势奔放","story":["唐朝张丞相字写得不好，却偏偏喜欢写草书，他不是按正规的草书去写，而是自创，把字写得龙蛇飞动，让人辨认不出，这苦了帮他抄稿的侄儿。一次他侄儿帮他抄诗作时，字认不出就去问他，他自己也认不出来，却责怪侄儿怎么不早问他"]},{"id":49568,"word":"龙蛇飞舞","pinyin":"lóng shé fēi wǔ","abbr":"lsfw","explanation":"形容书法笔势遒劲生动。","source":{"text":"闺臣听了，把神凝了一凝，只得打起精神，举起笔来，刷、刷、刷如龙蛇飞舞一般，一连写了几句。","book":"清·李汝珍《镜花缘》第八十八回"},"example":{"text":"只记得纸上～，笔势很好看的。（冰心《往事·六一姊》）"},"similar":["龙蛇飞动"],"usage":"作谓语、定语、状语；形容书法气势奔放"},{"id":49569,"word":"龙蛰蠖屈","pinyin":"lóng zhé huò qū","abbr":"lzhq","explanation":"比喻隐居不仕。","source":{"text":"尺蠖之屈，以求信也；龙蛇之蛰，以存身也。","book":"语出《易·系辞下》"},"example":{"text":"今岁传胪小儿，即少时妄对隐士绝无才者也。公当盛汉之隆，而，不一建立于时，得无为儿曹所诮乎？一笑。","book":"明·张居正《答司空陆五台书》"},"usage":"作谓语、定语；用于比喻句"},{"id":49570,"word":"龙蟠凤翥","pinyin":"lóng pán fèng zhù","abbr":"lpfz","explanation":"指贤者遁世归隐。","source":{"text":"古来云海茫茫，道山绛阙知何处？人间自有，赤城居士，龙蟠凤翥。清净无为，坐忘遗照，八篇奇语。","book":"宋·苏轼《水龙吟》词"},"similar":["凤翥龙蟠","龙盘凤翥"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":49571,"word":"龙蟠凤逸","pinyin":"lóng pán fèng yì","abbr":"lpfy","explanation":"如龙盘曲，如凤深藏。比喻有才能而没有人赏识。","source":{"text":"所以龙蟠凤逸之士，皆欲收名定价于君侯。","book":"唐·李白《与韩刑州书》"},"example":{"text":"岂和壁隋珠，赏识无人那？抑～，埋光邱壑耶？","book":"清·李百川《绿野仙踪》第四回"},"similar":["龙盘凤逸"],"usage":"作谓语、宾语；比喻有才能而没有人赏识"},{"id":49572,"word":"龙蟠虎伏","pinyin":"lóng pán hǔ fú","abbr":"lphf","explanation":"雄踞的样子。","source":{"text":"看吧看，那一群庞然大物——黑压压，龙蟠虎伏。","book":"郭小川《夜进塔里木》诗"},"usage":"作宾语、定语；用于雄健的事物"},{"id":49573,"word":"龙蟠虎绕","pinyin":"lóng pán hǔ rào","abbr":"lphr","explanation":"犹言龙盘虎踞。形容地势雄伟险要。","source":{"text":"物外新闻，凤歌鸾翥，龙蟠虎绕。","book":"宋·范成大《水龙吟·寿留寺》词"},"similar":["龙盘虎踞"],"usage":"作谓语、定语；用于形容地势"},{"id":49574,"word":"龙蟠虎踞","pinyin":"lóng pán hǔ jù","abbr":"lphj","explanation":"象龙盘着，象虎蹲着。形容地势雄伟险要。特指南京。","source":{"text":"刘备曾使诸葛亮至京，因睹秣陵山阜，叹曰：‘钟山龙盘，石头虎踞，此帝王之宅。’","book":"晋·吴勃《吴录》"},"example":{"text":"～帝王州，帝子金陵访古丘。","book":"唐·李白《永王东巡歌》"},"similar":["龙盘虎踞"],"usage":"作宾语、定语；指地势险要","story":["三国时期，刘备为了联吴抗曹，派诸葛亮去吴都建业去游说孙权。诸葛亮到了建业，看到秣陵的山势地形，感慨地说：“紫金山山势险峻，像一条龙环绕建业，石头城很威武，像老虎蹲踞着，这是帝王建都的好地方。”"]},{"id":49575,"word":"龙蟠虬结","pinyin":"lóng pán qiú jié","abbr":"lpqj","explanation":"犹言旋绕纠结。","source":{"text":"南汇一团镇西有银杰树，高六七丈，围数抱，悬瘘累节……根中生古藤，大亦合围，龙蟠虬结而上。","book":"徐珂《清稗类钞·植物·银杏》"},"usage":"作宾语、定语；用于比喻句"},{"id":49576,"word":"龙血凤髓","pinyin":"lóng xuè fèng suǐ","abbr":"lxfs","explanation":"比喻高贵的血统。","source":{"text":"难道那龙血凤髓当真会在这名革命女战士身上起作用吗？","book":"赵大年《公主的女儿》五：“决不能叫心爱的二妞儿、龙血凤髓的布衣公主，再去跳一次护城河！”又"},"example":{"text":"他幻想有～般的血统而成为贵族"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":49577,"word":"龙血玄黄","pinyin":"lóng xuě xuán huáng","abbr":"lxxh","explanation":"比喻战争激烈，血流成河。","source":{"text":"龙战于野，其血玄黄。","book":"《周易·坤》"},"example":{"text":"当是时，～，战争方始，革命工作，热烈进行。","book":"周素园《贵州民党痛史》第三篇第17章"},"similar":["龙战玄黄"],"usage":"作宾语；比喻战争激烈，血流成河"},{"id":49578,"word":"龙行虎变","pinyin":"lóng xíng hǔ biàn","abbr":"lxhb","explanation":"比喻帝王革故鼎新，创制建业。","source":{"text":"损益前王，创制立法，有文章之美，焕然可观，有似虎变，其文彪炳。","book":"《易·干》：“飞龙在天……云从龙。风从虎，圣人作而万物睹。”又《革》：“大人虎变。”孔颖达疏"},"example":{"text":"《易·干》：“飞龙在天……云从龙。风从虎，圣人作而万物睹。”又《革》：“大人虎变。”孔颖达疏：“损益前王，创制立法，有文章之美，焕然可观，有似虎变，其文彪炳。”"},"usage":"作宾语、定语；用于比喻句"},{"id":49579,"word":"龙行虎步","pinyin":"lóng xíng hǔ bù","abbr":"lxhb","explanation":"原形容帝王的仪态不同一般。后也形容将军的英武姿态。","source":{"text":"刘裕龙行虎步，视瞻不凡，恐不为人下，宜早为其所。","book":"《宋书·武帝纪上》"},"example":{"text":"黄君总率六师，～，苟军人受谣成惑，当明谕晓导，以解群疑。","book":"章炳麟《驳黄兴主张南都电》"},"similar":["器宇不凡","气宇轩昂"],"opposite":["卑躬屈膝","低三下四"],"usage":"作宾语、状语；指人的气度","story":["晋朝时期，刘裕仪表不凡，走路像龙在行走、虎在迈步，气概威风雄壮，他看问题与众不同。桓玄篡夺晋朝政权，刘裕起兵讨伐，迎立安帝，被封为宋公。他平定南燕、后燕、秦这些自立为王的国家。公元420年，他废晋而建立宋朝，为宋武帝"]},{"id":49580,"word":"龙言凤语","pinyin":"lóng yán fèng yǔ","abbr":"lyfy","explanation":"比喻轻松悠扬的音乐之声。","source":{"text":"轻轻濛濛，龙言凤语何从容，耳有响兮目无踪。","book":"唐·鲍溶《会仙歌》"}},{"id":49581,"word":"龙跃云津","pinyin":"lóng yuè yún jīn","abbr":"lyyj","explanation":"比喻杰出的人物崛起。","source":{"text":"君兄弟龙跃云津，顾彦先凤鸣朝阳，谓东南之宝已尽，不意复见褚生。","book":"《晋书·褚陶传》"}},{"id":49582,"word":"龙跃凤鸣","pinyin":"lóng yuè fèng míng","abbr":"lyfm","explanation":"象龙在腾跃，凤凰在高鸣。比喻才华出众。","source":{"text":"君兄弟龙跃云津，顾彦先凤鸣朝阳，谓东南之宝已尽，不意复见褚生。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"usage":"作谓语、定语；指人才华出众"},{"id":49583,"word":"龙跃虎卧","pinyin":"lóng yuè hǔ wò","abbr":"lyhw","explanation":"比喻笔势纵横驰骋，自在有力。","source":{"text":"梁武帝评之曰：‘势如龙跃天门，虎跃凤阁，是故历代宝之，永以为训。","book":"宋·赵佶《宣和书谱》卷十五"}},{"id":49584,"word":"龙跃虎踞","pinyin":"lóng yuè hǔ jù","abbr":"lyhj","explanation":"比喻超逸雄奇。","source":{"text":"至若泾阳先生，以龙跃虎踞之才，左宜右有，随手合辙，意至而词随，更不劳其拣择。非读书见道者，未许涉其津涘。","book":"清·王夫之《夕堂永日绪论外编》"},"usage":"作宾语、定语；用于比喻句"},{"id":49585,"word":"龙跃鸿矫","pinyin":"lóng yuè hóng jiǎo","abbr":"lyhj","explanation":"比喻高举远逝。","source":{"text":"东方朔、阮籍其善处难者乎？既弗能避，又弗欲浼，曷不龙跃鸿矫哉？","book":"明·王世贞《说部》"},"usage":"作谓语、定语；用于比喻句"},{"id":49586,"word":"龙跧虎卧","pinyin":"lóng quán hǔ wò","abbr":"lqhw","explanation":"犹言龙蟠虎踞。比喻山势逶迤起伏。","source":{"text":"龙跧虎卧起且伏，旁睨沫水，沱江潮。","book":"宋·范成大《小峨眉》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":49587,"word":"龙跳虎伏","pinyin":"lóng tiào hǔ fú","abbr":"lthf","explanation":"犹言龙腾虎卧。比喻笔势。","source":{"text":"龙跳虎伏归毫底，鱼跃鸢飞入兴么。","book":"太平天国·洪仁玕《军次实录》"},"similar":["龙跳虎卧"],"usage":"作谓语、定语；用于比喻句"},{"id":49588,"word":"龙跳虎卧","pinyin":"lóng tiào hǔ wò","abbr":"lthw","explanation":"比喻文笔、书法纵逸雄劲。","source":{"text":"萧思话书走墨连绵，字势屈强若龙跳天门，虎卧凤阁。","book":"南朝·梁·袁昂《古今书评》"},"example":{"text":"灵庆池则有腾掷之势，略见～气象，尤为妙品。","book":"清·康有为《广艺舟双楫·取隋》"},"similar":["龙腾虎跃","龙跳虎伏"],"usage":"作谓语、定语；比喻文笔、书法纵逸雄劲"},{"id":49589,"word":"龙踚虎卧","pinyin":"lóng quán hǔ wò","abbr":"lqhw","explanation":"犹言龙蟠虎踞。比喻山势逶迤起伏。"},{"id":49590,"word":"龙蹲虎踞","pinyin":"lóng dūn hǔ jù","abbr":"ldhj","explanation":"犹言龙盘虎踞。好像盘绕的龙，蹲伏的虎。特指南京。亦形容地势雄伟险要。","source":{"text":"龙蹲虎踞江山大，马去牛来社稷空。","book":"宋·丁开《建业》诗"},"similar":["龙盘虎踞","龙蟠虎踞"],"usage":"作宾语、定语；指地势险要"},{"id":49591,"word":"龙钟潦倒","pinyin":"lóng zhōng liǎo dǎo","abbr":"lzld","explanation":"龙钟：行动不灵便的样子；潦倒：失意颓丧。形容老年人衰老颓丧的样子。","source":{"text":"华也潦倒龙钟，百疾丛体，衣无完帛，器无兼蔬。","book":"唐·李华《卧疾舟中相里范二侍御先行赠别序》"}},{"id":49592,"word":"龙钟老态","pinyin":"lóng zhōng lǎo tài","abbr":"lzlt","explanation":"龙钟：行动不灵便的样子。形容年老体衰，行动不灵便。","source":{"text":"交结惭时辈，龙钟似老翁。","book":"唐·李端《赠谢戴》"}},{"id":49593,"word":"龙门点额","pinyin":"lóng mén diǎn é","abbr":"lmde","explanation":"比喻仕路失意或科场落第。","source":{"text":"《尔雅》曰：‘鳣，有也。’出巩穴三月，则上渡龙门，得渡为龙矣，否则点额而还。","book":"北魏·郦道元《水经注·河水四》"},"example":{"text":"俞良八千有馀多路，来到临安，指望一举成名。争奈时运未至，～，金榜无名。","book":"《警世通言·俞仲举题诗遇上皇》"},"similar":["金榜无名","名落孙山"],"opposite":["金榜题名"],"usage":"作谓语、定语、宾语；用于考试等"},{"id":49594,"word":"龙阳之兴","pinyin":"lóng yáng zhī xìng","abbr":"lyzx","explanation":"兴：嗜好，雅兴。战国时龙阳君以男色事魏王而得宠。指喜好男色。","source":{"text":"原来薛蟠自来王夫人处住后，便知有一家学，学中广有青年子弟，不免偶动了龙阳之兴，因此也假来上学读书。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["断袖之宠"],"usage":"作主语、宾语；指男妓","story":["薛蟠从老家来到大观园住下后，打听到贾府有一所家学，学校里有许多年轻人，就动了龙阳之兴，假装去上学，不过是三日打鱼，两日晒网而已。学校里有些学生图薛蟠的钱财就被上了他的贼船。秦钟与贾宝玉来上学，薛蟠立刻就打他们的主意"]},{"id":49595,"word":"龙阳泣鱼","pinyin":"lóng yáng qì yú","abbr":"lyqy","explanation":"后以之为失宠之典。","source":{"text":"《战国策·魏策四》：“魏王与龙阳君共船而钓，龙阳君得十馀鱼而涕下。……王曰：‘然则何为出涕？’曰：‘臣为王之所得鱼也。’王曰：‘何谓也？’对曰：‘臣之始得鱼也，臣甚喜，后得又益大，今臣直欲弃臣前之所得矣。……臣亦将弃矣，臣安能无涕"},"example":{"text":"妾蒙主人恩宠无比，但恐春老花残，主上恩移宠衰，使妾有～之悲，班姬题扇之怨，奈何？","book":"元·白朴《梧桐雨》第一折"},"usage":"作宾语、定语；用于处事","story":["战国时期，魏王封一个能言善辩的宫女为龙阳君妃子，经常陪她钓鱼，开始她看到魏王钓上鱼十分高兴。后来就没有笑声。魏王问她如何？她哭着说：“大王不断地钓鱼，爱好随之改变。美丽的女人想方设法接近你，我会像鱼一样被遗弃。”"]},{"id":49596,"word":"龙隐弓坠","pinyin":"lóng yǐn gōng zhuì","abbr":"lygz","explanation":"旧时比喻皇帝死。","source":{"text":"黄帝上骑，群臣后宫从上者巧干余人，龙乃上去。余小臣不得上，乃悉持龙髯，龙髯拔，堕，堕黄帝之弓。","book":"《史记·封禅书》"}},{"id":49597,"word":"龙雏凤种","pinyin":"lóng chú fèng zhǒng","abbr":"lcfz","explanation":"指帝王后裔。","source":{"text":"更有那两个儿，又不是别树上花，都总是姓刘的亲骨肉在宫中长大，却怎生把龙雏凤种做一瓮鲊鱼虾。","book":"明·徐渭《渔阳三弄》"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":49598,"word":"龙雕凤咀","pinyin":"lóng diāo fèng jǔ","abbr":"ldfj","explanation":"比喻辞藻之美。","source":{"text":"一日觞於湖上，多多许余《泽秀集》，即席口授千言序之，故不窜一字，灿然龙雕凤咀，是捷悟伟人。","book":"明·顾起纶《国雅品·士品四》"}},{"id":49599,"word":"龙韬豹略","pinyin":"lóng tāo bào lüè","abbr":"ltbl","explanation":"指兵法。","source":{"text":"笔阵词锋明藻色，龙韬豹略系安危。","book":"宋·张元干《代上折枢彦质生朝》"},"example":{"text":"你八面威风大，端的是将相才，则你那～人难赛。","book":"元·陈以仁《雁门关存孝打虎》第一折"},"similar":["六韬三略"],"usage":"作宾语；指兵法"},{"id":49600,"word":"龙颜凤姿","pinyin":"lóng yán fèng zī","abbr":"lyfz","explanation":"指帝王之相。","source":{"text":"陛下享天下之富贵，圣貌轩逸，龙颜凤姿，而不自爱重。","book":"唐·韩偓《迷楼记》"},"usage":"作宾语、定语；用于人的长相"},{"id":49601,"word":"龙飞凤翔","pinyin":"lóng fēi fèng xiáng","abbr":"lffx","explanation":"①指帝王的兴起。②比喻仕途得意，飞黄腾达。","source":{"text":"曹烈、曹丹，加以公室支庶，骨肉旧恩，其龙飞凤翔，实其分也。","book":"三国·魏·吴质《答文帝笺》"},"example":{"text":"惟汉光武～，举新市之八千，破王寻之百万，则南阳之佐命动于天矣。","book":"唐·杨炯《泸洲都督王湛神道碑》"},"usage":"作谓语、宾语；用于比喻句"},{"id":49602,"word":"龙飞凤翥","pinyin":"lóng fēi fèng zhù","abbr":"lffz","explanation":"形容笔势雄奇飞动。","source":{"text":"其文龙飞凤翥，不足拟其势。","book":"明·沈德符《野获编补遗·玩具·秦玺始末》"},"similar":["龙飞凤舞"],"usage":"作谓语、状语、定语；用于书法等"},{"id":49603,"word":"龙飞凤舞","pinyin":"lóng fēi fèng wǔ","abbr":"lffw","explanation":"原形容山势的蜿蜒雄壮，后也形容书法笔势有力，灵活舒展。","source":{"text":"天目之山，苕水出焉，龙飞凤舞，萃于临安。","book":"汉·张衡《东京赋》：“我世祖龙飞白水，凤翔参墟。”宋·苏轼《表忠观碑》"},"example":{"text":"抬头看见北墙上挂着四幅大屏，草书得～，出色惊人。","book":"清·刘鹗《老残游记》第九回"},"similar":["挥洒自如","无拘无束"],"usage":"作谓语、宾语、定语；形容书法笔势有力"},{"id":49604,"word":"龙飞凤起","pinyin":"lóng fēi fèng qǐ","abbr":"lffq","explanation":"比喻帝王或圣人兴起。","source":{"text":"我世祖忿上，乃龙飞白水，凤翔参墟。","book":"汉·张衡《东京赋》"},"example":{"text":"则当摅不朽之功，畅不羁之志，～，修摄君司，佐天理物。","book":"三国·魏·麋元《讥许由》"}},{"id":49605,"word":"龙飞虎跳","pinyin":"lóng fēi hǔ tiào","abbr":"lfht","explanation":"比喻笔势遒劲奔放。","source":{"text":"右将军（王羲之）陶铸百家，出入万类，信手拈来，无不如意。龙飞虎跳之喻，尚未足云，洵书中集大成手也。","book":"明·谢肇淛《五杂俎·人部三》"},"similar":["龙飞凤舞"],"usage":"作定语、状语；用于书法等"},{"id":49606,"word":"龙首豕足","pinyin":"lóng shǒu shǐ zú","abbr":"lssz","explanation":"犹言牛头不对马嘴。指对书义的解释与原旨相去甚远，风马牛不相及。","source":{"text":"夫今之俗，搢绅稚齿，闾巷小生，学以浮动为贵。用百家则多尚轻侧，涉经记则不通大旨，苟取成章，贵在悦目。龙首豕足，随时之义；牛头马髀，强相附会。","book":"南朝·梁元帝《金楼子·立言下》"},"similar":["牛头不对马嘴"],"usage":"作宾语、定语；用于比喻句"},{"id":49607,"word":"龙马精神","pinyin":"lóng mǎ jīng shén","abbr":"lmjs","explanation":"龙马：古代传说中形状象龙的骏马。比喻人精神旺盛。","source":{"text":"四朝忧国鬓如丝，龙马精神海鹤姿。","book":"唐·李郢《上裴晋公》诗"},"example":{"text":"见那些大哥哥还在～地说话，她也听不出味道，就打了两个哈欠，悄悄溜了出来。","book":"欧阳山《三家巷》九"},"similar":["精力充沛"],"usage":"作宾语；用于祝词"},{"id":49608,"word":"龙驭上宾","pinyin":"lóng yù shàng bīn","abbr":"lysb","explanation":"此为皇帝之死的讳饰语。意为乘龙升天，为天帝之宾。","source":{"text":"黄帝采首山铜，铸鼎于荆山下。鼎既成，有龙垂胡涘下迎黄帝。黄帝上骑，群臣后宫从上者七十馀人，龙乃上去。","book":"《史记·封禅书》"},"example":{"text":"盖有意大用，未几而～矣。","book":"明·李东阳《张公墓志铭》"},"similar":["龙御上宾"],"usage":"作谓语、定语；用于皇帝死的讳饰语","story":["传说上古时期，黄帝带领百姓在首山采铜，到荆山下铸鼎。鼎铸成后，有龙垂下胡髯来迎接黄帝，黄帝立即骑上龙髯，群臣与后宫等70多人随从也上了龙髯，龙开始飞上天，百姓仰望黄帝上天，纷纷抱着弓与龙髯哭泣"]},{"id":49609,"word":"龙驭宾天","pinyin":"lóng yù bīn tiān","abbr":"lybt","explanation":"乘龙升天，作天上的宾客。旧指皇帝死。"},{"id":49610,"word":"龙驰虎骤","pinyin":"lóng chí hǔ zhòu","abbr":"lchz","explanation":"指群雄逐鹿。","source":{"text":"龙驰虎骤真人出，手挽经纶分乱麻。","book":"明·沈寿民《江上行》"},"usage":"作宾语、定语；用于乱世等"},{"id":49611,"word":"龙驹凤雏","pinyin":"lóng jū fèng chú","abbr":"ljfc","explanation":"驹：小马；雏：细鸟。比喻英俊秀颖的少年。常作恭维语。","source":{"text":"云字士龙，六岁能属文，性清正，有才理。少与兄机齐名，虽文章不及机，而持论过之，号曰‘二陆’。幼时吴尚书广陵闵鸿见而奇之，曰：‘此儿若非龙驹，当是凤雏。’","book":"《晋书·陆云传》"},"example":{"text":"令郎真乃～，非小王在世翁前唐突，将来“雏凤清于老凤声”，未可量也。","book":"清·曹雪芹《红楼梦》第十五回"},"usage":"作宾语；比喻英俊秀颖的少年","story":["晋朝时期，陆机的弟弟陆云六岁时就能作文，文气很好。因此年少时就与哥哥齐名，虽然文章没有陆机那么优美，但是论点十分犀利。一次吴尚书广陵闵鸿看见陆云感慨地说：“此儿若非龙驹，当是凤雏。”"]},{"id":49612,"word":"龙骧凤矫","pinyin":"lóng xiāng fèng jiǎo","abbr":"lxfj","explanation":"龙腾凤飞。喻指行动迅猛。","source":{"text":"公龙骧凤矫咫尺八纮，括囊四海，折冲无外。","book":"《宋书·武帝纪中》"},"usage":"作谓语、定语；用于比喻句"},{"id":49613,"word":"龙骧虎啸","pinyin":"lóng xiāng hǔ xiào","abbr":"lxhx","explanation":"比喻气概威武。","source":{"text":"忽必烈坐定帐龙骧虎啸，占住了燕京城铁裹铜包。","book":"清·汉血愁予《崖山哀·胡闹》"},"example":{"text":"持节江皋，～，忧国事，不顾残躯，双鬓苍白了。","book":"清·孔尚任《桃花扇·争位》"},"similar":["龙腾虎啸"],"usage":"作宾语、定语；用于气势"},{"id":49614,"word":"龙骧虎峙","pinyin":"lóng xiāng hǔ zhì","abbr":"lxhz","explanation":"骧：马昂首的样子；峙：耸立。雄踞的样子。","source":{"text":"龙骧虎峙，蛇豕屏窜。","book":"明·方孝孺《春秋诸君子赞·公子友》"},"similar":["龙蟠虎伏"],"usage":"作宾语、定语；用于雄健的事物"},{"id":49615,"word":"龙骧虎步","pinyin":"lóng xiāng hǔ bù","abbr":"lxhb","explanation":"龙：高大的马，古称八尺以上的马为龙；骧：马高扬着头的样子。象龙马昂首，如老虎迈步。形容气慨威武雄壮。","source":{"text":"今将军总皇威，握兵要，龙骧虎步，高下在心。","book":"三国·魏·嵇康《卜疑》：“将如毛公蔺生之龙骧虎步，慕为壮士乎？”《三国志·魏书·陈琳传》"},"example":{"text":"公～，啸咤风云。","book":"《宋书·高祖纪》"},"usage":"作谓语、定语；形容气慨威武雄壮"},{"id":49616,"word":"龙骧虎视","pinyin":"lóng xiāng hǔ shì","abbr":"lxhs","explanation":"象龙马高昂着头，象老虎注视着猎物。形容人的气慨威武。也比喻雄才大略。","source":{"text":"亮之素志，进欲龙骧虎视，苞括四海。","book":"汉·潘勗《册魏公九锡文》：“君龙骧虎视，旁眺八维，揜讨逆节，折冲四海。”《三国志·蜀书·诸葛亮传》"},"example":{"text":"～安乾坤，万古千秋名不朽。","book":"明·罗贯中《三国演义》第三十八回"},"usage":"作谓语、定语；形容人的气慨威武","story":["三国时期，蜀国军师诸葛亮54岁病死在征战之中，根据他的遗命，安葬在汉中定军山。他不要风光大葬与建碑立庙，蜀后主照办。中书郎向充联名要求给他立庙，后主才同意在沔阳修建诸葛亮庙，评价他：“亮之素志，进欲龙骧虎视，苞括四海。”"]},{"id":49617,"word":"龙骧虎跱","pinyin":"lóng xiāng hǔ zhì","abbr":"lxhz","explanation":"雄踞的样子。","source":{"text":"龙骧虎跱，蛇豕屏窜。","book":"明·方孝孺《春秋诸君子赞·公子友》"}},{"id":49618,"word":"龙骧虎踤","pinyin":"lóng xiāng hǔ jià","abbr":"lxhj","explanation":"雄踞的样子。"},{"id":49619,"word":"龙骧蠖屈","pinyin":"lóng xiāng huò qū","abbr":"lxhq","explanation":"比喻随时屈伸、上下。","source":{"text":"班固《汉书·韩彭》述曰：‘云起龙骧，化为侯王。’《周易》曰：‘尺蠖之屈，以求伸也。’","book":"《文选·刘孝标〈广绝交论〉》：“盖圣人握金镜，阐风烈，龙驤蠖屈，从道污隆。”李善注"},"usage":"作谓语、定语；用于比喻句"},{"id":49620,"word":"龙骧豹变","pinyin":"lóng xiāng bào biàn","abbr":"lxbb","explanation":"比喻书法气势壮盛而善于变化。","source":{"text":"［张伯英］尤善章草，书出诸杜社，孤崔瑗云：龙骧豹变，青出于蓝。","book":"唐·张怀瓘《书断·神品》"},"usage":"作宾语、定语；用于比喻句"},{"id":49621,"word":"龙骧麟振","pinyin":"lóng xiāng lín zhèn","abbr":"lxlz","explanation":"龙骧，昂举腾跃的样子。比喻将军恩威兼备。","source":{"text":"麟，信而应礼，以足至者也。振振，信厚也。","book":"麟振，语出《诗·周南·麟之趾》：“鳞之趾，振振公子，于嗟麟兮。”毛传"},"example":{"text":"[邓艾]受命忘身，～，前无坚敌。","book":"《晋书·段灼传》"},"usage":"作宾语、定语；指人恩威并用","story":["圣德之君周文王与圣女姒氏结婚，生下的孩子非常仁厚，被人们比作麟之趾。麟是吉祥动物，性灵仁慈、厚道。文王后妃德修于身，他们的子孙也受到圣德的感化，子孙能成为有德行的君主，周文王开创的事业就能延续下去"]},{"id":49622,"word":"龙鬼蛇神","pinyin":"lóng guǐ shé shén","abbr":"lgss","explanation":"比喻奇诡怪僻。","source":{"text":"张伯雨序其《乐府》云……廉夫又纵横其间，上法汉魏，而出入于少陵、二李之间，所作古乐府辞，隐然有旷世金石声。又时出龙鬼蛇神，以眩荡一世之耳目。斯亦奇矣。","book":"清·钱谦益《列朝诗集小传·铁崖先生杨维桢》"},"usage":"作宾语、定语；用于怪异的事物"},{"id":49623,"word":"龙鸣狮吼","pinyin":"lóng míng shī hǒu","abbr":"lmsh","explanation":"比喻沉郁雄壮的声音。","source":{"text":"王子乔墓在京茂陵，国乱时，有人盗发之，都无所见，唯有一剑，悬在空中，欲取之，剑便作龙鸣虎吼。","book":"南朝·宋·刘义庆《世说新语》"},"example":{"text":"高歌梵唱声相杂，～成须臾。","book":"陈世宜《醉歌》"},"usage":"作宾语；比喻沉郁雄壮的声音"},{"id":49624,"word":"龚行天罚","pinyin":"gōng xíng tiān fá","abbr":"gxtf","explanation":"奉天之命进行惩罚。","source":{"text":"皇矣汉祖，龚行天罚，赫赫明明。","book":"东汉·班固《汉书·叙传下》"},"example":{"text":"手握牙璋，～。","book":"清·陈康祺《燕下乡脞录》第二卷"},"similar":["替天行道","恭行天罚"],"usage":"作谓语、宾语；指替天行道"},{"id":49625,"word":"龟冷搘床","pinyin":"guī lěng zhī chuáng","abbr":"glzc","explanation":"比喻壮志未酬，蛰居待时。","source":{"text":"南方老人用龟支床足，行二十余岁，老人死，移床，龟尚生不死。","book":"西汉·司马迁《史记·龟策列传褚少孙论》"},"example":{"text":"骥衰伏枥心千里，～寿百年。","book":"宋·陆游《杂兴》诗"},"similar":["壮志未酬"],"usage":"作谓语；比喻壮志未酬，蛰居待时"},{"id":49626,"word":"龟冷支床","pinyin":"guī lěng zhī chuáng","abbr":"glzc","explanation":"比喻壮志未酬，蛰居待时。","source":{"text":"南方老人用龟支床足，行二十余岁，老人死，移床，龟尚生不死。","book":"《史记·龟策列传褚少孙论》"},"similar":["龟冷搘床"],"usage":"作谓语；比喻壮志未酬，蛰居待时"},{"id":49627,"word":"龟厌不告","pinyin":"guī yàn bù gào","abbr":"gybg","explanation":"指屡加龟卜，致使龟灵厌恶，不再以吉凶告人。比喻很有效的东西，过度使用也会失灵。","source":{"text":"我龟既厌，不我告犹。","book":"《诗经·小雅·小旻》"},"example":{"text":"～，《诗》以为刺。","book":"东汉·班固《汉书·艺文志》"},"usage":"作定语、分句；指劝诫人"},{"id":49628,"word":"龟年鹤寿","pinyin":"guī nián hè shòu","abbr":"gnhs","explanation":"相传龟、鹤寿有千百之数，而用于比喻人之长寿。或用作祝寿之词。","source":{"text":"神道甚微，天理难究，桂蠹兰败，龟年鹤寿。","book":"唐·李商隐《祭张书记文》"},"example":{"text":"祝老爷爷～。"},"similar":["龟鹤之年","龟鹤遐寿","龟龄鹤算"],"usage":"作宾语、定语；用于祝寿等"},{"id":49629,"word":"龟年鹤算","pinyin":"guī nián hè suàn","abbr":"gnhs","explanation":"比喻人之长寿。或用作祝寿之词。同“龟年鹤寿”。","source":{"text":"惟愿增高，龟年鹤算，鸿恩紫诏。","book":"宋·韦骧《醉蓬莱·廷评庆寿》词"},"similar":["龟龄鹤算","龟年鹤寿"],"usage":"作宾语、定语；用于祝寿等"},{"id":49630,"word":"龟文鸟迹","pinyin":"guī wén niǎo jì","abbr":"gwnj","explanation":"指古代的象形文字。","source":{"text":"颉首四目，通于神明，仰观奎星圆曲之势，俯察龟文鸟迹之象，博彩众美，合而为字，是曰古文。","book":"唐·张彦远《法书要录》第七卷"},"usage":"作宾语；指古代的象形文字"},{"id":49631,"word":"龟毛兔角","pinyin":"guī máo tù jiǎo","abbr":"gmtj","explanation":"乌龟身上生毛，兔子头上长角。比喻不可能存在或有名无实的东西。","source":{"text":"商纣之时，大龟生毛兔生角，兵甲将兴之象也。","book":"晋·干宝《搜神记》卷六"},"example":{"text":"～，岂是有邪？","book":"宋·释普济《五灯会元》卷五"},"similar":["兔角龟毛"],"usage":"作宾语；比喻有名无实的东西"},{"id":49632,"word":"龟玉毁椟","pinyin":"guī yù huǐ dú","abbr":"gyhd","explanation":"龟甲和宝玉在匣中被毁坏。比喻辅佐之臣失职而使国运毁败。","source":{"text":"虎兕出於柙，龟玉毁于椟中，是谁之过与？","book":"春秋·鲁·孔丘《论语·季氏》"},"example":{"text":"且授任分忧，叨荣冒宠，～，谁之咎欤！","book":"《旧五代史·唐书·武皇纪下》"},"usage":"作谓语、宾语；比喻辅佐之臣失职而使国运毁"},{"id":49633,"word":"龟鹤之年","pinyin":"guī hè zhī nián","abbr":"ghzn","explanation":"龟鹤的寿命很长。比喻人的寿命很长。","example":{"text":"他已经到了～，还是那样精神抖擞。"},"similar":["龟年鹤寿","龟龄鹤算","龟鹤遐寿"],"usage":"作宾语、定语；用于祝寿等"},{"id":49634,"word":"龟鹤遐寿","pinyin":"guī hè xiá shòu","abbr":"ghxs","explanation":"遐：长久。祝人长寿的颂辞。","source":{"text":"知龟鹤之遐寿，故效其道引以增年。","book":"《抱朴子·对俗》"},"similar":["龟年鹤寿","龟龄鹤算","鹤算龟龄"],"usage":"作谓语、宾语；祝人长寿的颂辞"},{"id":49635,"word":"龟鹤遐龄","pinyin":"guī hè xiá líng","abbr":"ghxl","explanation":"遐：长久。遐龄：高寿。传说龟、鹤都能活一千年。比喻长寿。亦作“龟龄鹤算”。"},{"id":49636,"word":"龟龄鹤算","pinyin":"guī líng hè suàn","abbr":"glhs","explanation":"比喻人之长寿。或用作祝寿之词。同“龟年鹤寿”。","source":{"text":"坐享龟龄鹤算，稳佩金鱼玉带，常近赭黄袍。","book":"宋·侯寘《水调歌头·为郑子礼提刑寿》词"},"example":{"text":"表长年。傲～，永劫绵绵。","book":"金·王丹桂《瑶台第一层·崔大师生辰》词"},"similar":["龟鹤之年","龟鹤遐寿","鹤算龟龄"],"usage":"作宾语、定语；用于祝寿等"},{"id":49637,"word":"龟龙片甲","pinyin":"guī lóng piàn jiǎ","abbr":"glpj","explanation":"比喻无论巨细都搜罗进来的好东西。","source":{"text":"麟凤一毛，龟龙片甲，亦无所不录。","book":"唐·张怀瓘《书议》"},"usage":"作宾语；比喻无论巨细都搜罗进来的好东西"},{"id":49638,"word":"龟龙鳞凤","pinyin":"guī lóng lín fèng","abbr":"gllf","explanation":"传统上用来象征高寿、尊贵、吉祥的四种动物。比喻身处高位德盖四海的人。","source":{"text":"太皇太后临政，有龟龙鳞凤之应。","book":"《汉书·翟方进传》"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":49639,"word":"龟龙麟凤","pinyin":"guī lóng lín fèng","abbr":"gllf","explanation":"传统上用来象征高寿、尊贵、吉祥的四种动物。比喻身处高位德盖四海的人。","source":{"text":"太皇太后临政，有龟龙麟凤之应。","book":"东汉·班固《汉书·翟方进传》"},"example":{"text":"风雨以时，草木不落，～在效薮矣。","book":"唐·陈子昂《谏政理书》"},"usage":"作主语、宾语；比喻品德高尚的人"}]
