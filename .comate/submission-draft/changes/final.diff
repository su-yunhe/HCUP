+[{"id":22501,"word":"摘山煮海","pinyin":"zhāi shān zhǔ hǎi","abbr":"zszh","explanation":"摘：开发。指开山炼矿，煮海成盐。比喻开发矿藏。","source":{"text":"至于摘山煮海，冶铸之事，他日吏缘以为奸者，临遣信臣，更定其法。","book":"宋·秦观《国论》"},"example":{"text":"允恭有心计，好言事，是时～，方舟之漕，规制未备，故因其建白而从之，利甚博焉。","book":"《宋史·王延德等传论》"},"usage":"作谓语、定语；用于处事"},{"id":22502,"word":"摘瑕指瑜","pinyin":"tì xiá zhǐ yú","abbr":"zxzy","explanation":"指揭示优缺点。","source":{"text":"士之执举子业者盈庭，公摘瑕指瑜，无不心折。","book":"明·袁宏道《送徐太府见可入计序》"},"example":{"text":"先帝一日与忞评论古今名臣宿将，～，纤悉无遗。","book":"明·张同奎《上六部禀帖》"},"usage":"作谓语、宾语；指指出别人的优缺点"},{"id":22503,"word":"摘瓜抱蔓","pinyin":"zhāi guā bào màn","abbr":"zgbm","explanation":"比喻一扫而空。","source":{"text":"种瓜黄台下，瓜熟子离离。一摘使瓜好，再摘令瓜稀，三摘犹尚可，四摘抱蔓归。","book":"语本唐·李贤《黄台瓜辞》"},"example":{"text":"狡日思逞，岂仅得一青岛而可以餍其欲哉？将见～，舐糠及米，着着进逼，而无已时。","book":"《“五四”爱国运动资料·陕西学生一九一九年五月三十日通启》"},"similar":["抱蔓摘瓜"],"usage":"作宾语、定语；用于比喻句","story":["唐高宗时期，朝政由皇后武则天代为处理，武后的野心很大，手段十分残忍。她废太子李忠立李弘做太子，后把太子弘毒死，立李贤为太子。他日夜忧思作《黄台瓜辞》：“种瓜黄台下，瓜熟子离离。一摘使瓜好，再摘令瓜稀，三摘犹自可，摘绝抱蔓归。”"]},{"id":22504,"word":"摘胆剜心","pinyin":"zhāi dǎn wān xīn","abbr":"zdwx","explanation":"摘：取。剜：用刀剜。用刀子将胆和心取出。形容非常痛苦。","source":{"text":"（马武云）贤士，你怕甚么？（正末唱）想着你那摘胆剜心处。","book":"元·秦简夫《赵礼让肥》第四折"},"usage":"作宾语、定语；用于比喻句"},{"id":22505,"word":"摘艳熏香","pinyin":"zhāi yàn xūn xiāng","abbr":"zyxx","explanation":"形容文辞华美。","source":{"text":"经书括根本，史书阅兴亡。高摘屈宋艳，浓熏班马香。","book":"唐·杜牧《冬至日寄小侄阿宜》诗"},"example":{"text":"簇锦绣于良时，赏心乐事；悟文章于大块，～。","book":"清·玉鲸生《海陬冶游录序》"}},{"id":22506,"word":"摘艳薰香","pinyin":"zhāi yàn xūn xiāng","abbr":"zyxx","explanation":"形容文辞华美。","source":{"text":"高摘屈宋艳，浓薰班马香。","book":"唐·杜牧《冬至日寄小侄阿宜》诗"}},{"id":22507,"word":"摛文掞藻","pinyin":"chī wén yàn zǎo","abbr":"cwsz","explanation":"摛、掞：发舒，铺陈。施展文采，铺陈辞藻。","source":{"text":"托乘同舟，连舆接席，摛文掞藻，飞觞泛醳。","book":"南朝·齐·谢朓《齐敬皇后策文》"}},{"id":22508,"word":"摛章绘句","pinyin":"chī zhāng huì jù","abbr":"czhj","explanation":"铺张辞藻，雕琢文句。形容以华丽的辞章写作诗文。","source":{"text":"当时轻薄之徒，摛章绘句，聱牙崛奇，讥讽时事，尔后鼓扇名声，谓之‘元和体’。","book":"宋·王谠《唐语林·文学》"}},{"id":22509,"word":"摛翰振藻","pinyin":"chī hàn zhèn zǎo","abbr":"chzz","explanation":"翰：毛笔，引申为文词；振：发舒。施展文采，铺陈辞藻。","source":{"text":"又尔时颠沛，普唤文士，黄门中书，靡不毕集，摛翰振藻，非为乏人。","book":"《南齐书·丘巨源传》"},"similar":["摛文掞藻"],"usage":"作谓语、定语；用于作文"},{"id":22510,"word":"摛藻绘句","pinyin":"chī zǎo huì jù","abbr":"czhj","explanation":"摛：铺陈；藻：文采。铺陈辞藻，描绘句子。形容以华丽的辞藻写作。","source":{"text":"当时轻薄之徒，摛藻绘句，聱牙崛奇，讥讽时事。","book":"宋·王谠《唐语林·文学》"},"similar":["摛藻雕章"],"usage":"作谓语、宾语；用于写作"},{"id":22511,"word":"摛藻雕章","pinyin":"chī zǎo diāo zhāng","abbr":"czdz","explanation":"铺张辞藻，雕琢文句。形容以华丽的辞章写作诗文。","source":{"text":"君以为摛藻雕章，研几之余事；知来藏往，探赜之所宗。","book":"唐·杨炯《王勃集序》"},"similar":["摛藻绘句"],"usage":"作谓语、宾语；用于写作"},{"id":22512,"word":"摧兰折玉","pinyin":"cuī lán zhé yù","abbr":"clzy","explanation":"摧：摧残，毁掉。毁坏兰花，折断美玉。比喻摧残和伤害女子。","source":{"text":"某本非风流佳客，谬称浪子端庄，……用诱秦诓楚之计，作摧兰折玉之谋。","book":"清·余怀《板桥杂记·丽品》"},"similar":["摧花斫柳"],"usage":"作谓语、定语；指伤害女性"},{"id":22513,"word":"摧刚为柔","pinyin":"cuī gāng wéi róu","abbr":"cgwr","explanation":"摧：挫败。变刚强为柔顺。","source":{"text":"上乃赦季布，当是时，诸公皆多季布能摧刚为柔，朱家亦以此名闻当时。","book":"《史记·季布栾布列传》"},"usage":"作谓语、定语；用于磨练人的性格"},{"id":22514,"word":"摧坚殪敌","pinyin":"cuī jiān yì dí","abbr":"cjyd","explanation":"摧毁和歼灭强敌。","source":{"text":"尔能躬将士徒，摧坚殪敌，斩捕甚众，鼓行无前。","book":"宋·曾巩《曲珍四厢都指挥使绛州防御使制》"},"similar":["摧坚陷敌"],"usage":"作谓语、定语；指破敌深入"},{"id":22515,"word":"摧坚获丑","pinyin":"cuī jiān huò chǒu","abbr":"cjhc","explanation":"摧坚：击溃敌精锐部队。丑：众，指敌人。挫败敌方精锐的军队，俘获敌寇。形容作战十分英勇。","source":{"text":"开通道途，收复贼聚，摧坚获丑，尔功居多。","book":"宋·曾巩《折克行彭保传官制》"},"usage":"作谓语、定语；用于战争等"},{"id":22516,"word":"摧坚陷敌","pinyin":"cuī jiān xiàn dí","abbr":"cjxd","explanation":"摧：摧毁；坚：军事工事；陷：攻陷。击败敌人的精锐，摧毁敌军的阵地。","source":{"text":"我从军三十年，大小四十余战，多摧坚陷敌，未尝妄杀一人。","book":"《宋史·张令铎传》"},"similar":["摧坚陷阵"],"usage":"作谓语；指破敌深入"},{"id":22517,"word":"摧坚陷阵","pinyin":"cuī jiān xiàn zhèn","abbr":"cjxz","explanation":"摧：击溃；坚：锋芒，引伸为精锐；陷：攻入。攻入并摧毁敌军的阵地。","source":{"text":"随世祖起义，摧坚陷阵，膂力过人，所经村邑，恣行暴害。","book":"《南齐书·桓康传》"},"example":{"text":"梁晋相拒河上十余年，其～，归化一军为最。","book":"《新五代史·杂传七·周知裕》"},"similar":["摧锋陷阵"],"usage":"作谓语；指破敌深入"},{"id":22518,"word":"摧山搅海","pinyin":"cuī shān jiǎo hǎi","abbr":"csjh","explanation":"摧：毁坏；搅：搅动。摧毁高山，搅动大海。形容神通极大，声势吓人。","source":{"text":"到来日战鼓连天，喊声振地，猛烈神摧山搅海，连珠炮有似轰雷。","book":"明·无名氏《齐天大圣》第二折"},"similar":["排山倒海"],"usage":"作谓语、定语；用于声势等"},{"id":22519,"word":"摧心剖肝","pinyin":"cuī xīn pōu gān","abbr":"cxpg","explanation":"摧：折。剖：划开。心肝断裂剖开。比喻极度悲伤和痛苦。","source":{"text":"耳存遗响，目想余颜，寝度伏枕，摧心剖肝。","book":"晋·潘岳《为任子咸妻作孤女泽兰哀辞》"},"similar":["摧胸破肝"],"usage":"作谓语、定语；指十分悲伤"},{"id":22520,"word":"摧志屈道","pinyin":"cuī zhì qū dào","abbr":"czqd","explanation":"摧：摧折，放弃；道：道德。抛弃理想追求，失去道义节操。形容身处逆境，不能守操如一。","source":{"text":"夫独往之人，不能摧志屈道，借誉期通。","book":"《宋书·隐逸传论》"},"example":{"text":"我们不能干～的事情。"},"usage":"作谓语、定语；指没有节操"},{"id":22521,"word":"摧折恶类","pinyin":"cuī zhé è lèi","abbr":"csel","explanation":"摧折：折断。打击丑恶的事物。","source":{"text":"摧折恶类。","book":"《后汉书·朱晖传》"}},{"id":22522,"word":"摧折豪强","pinyin":"cuī zhé háo qiáng","abbr":"czhq","explanation":"摧：折断。打击依仗权势横行不法的人。","source":{"text":"其治务在摧折豪强，扶助贫弱。","book":"《汉书·严延年传》"},"usage":"作谓语、定语；用于处世"},{"id":22523,"word":"摧朽拉枯","pinyin":"cuī xiǔ lā kū","abbr":"cxlk","explanation":"摧折枯朽的草木。形容轻而易举。也比喻摧毁腐朽势力的强大气势。","source":{"text":"国初豫通王下江南时，所至摧朽拉枯，无不立下。","book":"清·昭槤《啸亭杂录·江阴口谈之诬》"},"similar":["摧枯振朽","摧枯拉朽"],"usage":"作谓语、定语；形容极容易办到"},{"id":22524,"word":"摧枯折腐","pinyin":"cuī kū zhé fǔ","abbr":"ckzf","explanation":"折断枯树枝烂木头。比喻极容易做到。","source":{"text":"归发突骑，以辚乌合之众，如摧枯折腐耳。","book":"《后汉书·耿弇传》"},"similar":["摧枯拉朽","摧枯拉腐"],"opposite":["坚不可摧"],"usage":"作谓语、定语；形容极容易办到"},{"id":22525,"word":"摧枯拉朽","pinyin":"cuī kū lā xiǔ","abbr":"cklx","explanation":"枯、朽：枯草朽木。摧折枯朽的草木。形容轻而易举。也比喻摧毁腐朽势力的强大气势。","source":{"text":"将军之举武昌，若摧枯拉朽。","book":"《后汉书·耿弇传》：“归发突骑，以辚乌合之众，如摧枯折腐耳。”《晋书·甘卓传》"},"example":{"text":"拣着个精壮的村夫，赶上一拳打去，只望先打倒一个硬的，其余的便如～了。","book":"明·冯梦龙《醒世恒言》卷三十四"},"similar":["势如破竹","不堪一击"],"opposite":["坚不可摧"],"usage":"作谓语、定语；指毫不费力地摧毁","story":["晋武帝司马炎的女婿王敦因建立东晋居功自傲，在晋元帝时以杀刁协清除皇帝身边的恶人为名起兵反叛朝廷。他一边拉拢梁州刺史甘卓联合起兵，湘州刺史司马承派副将邓骞劝甘卓出兵攻打王敦，形容甘出兵打王像摧枯拉朽一样容易"]},{"id":22526,"word":"摧枯拉腐","pinyin":"cuī kū lā fǔ","abbr":"cklf","explanation":"折断枯树枝烂木头。比喻极容易做到。","source":{"text":"摧枯拉腐，破釜沉舟。","book":"《三合会讨满清檄文》"},"similar":["摧枯折腐"],"usage":"作谓语、定语；形容极容易办到"},{"id":22527,"word":"摧枯振朽","pinyin":"cuī kū zhèn xiǔ","abbr":"ckzx","explanation":"犹摧枯拉朽。形容轻而易举。","source":{"text":"悠悠邃古，未闻斯酷。岂非摧枯振朽，易为力乎。","book":"《周书·文闵明武宣诸子传论》"},"similar":["摧枯拉腐","摧枯拉朽"],"usage":"作谓语、定语；形容极容易办到"},{"id":22528,"word":"摧毁廓清","pinyin":"cuī huǐ kuò qīng","abbr":"chkq","explanation":"摧毁：彻底破坏；廓清：肃清。攻破敌阵，并加以扫荡。比喻彻底破处，肃清积弊或陈言。","source":{"text":"洋八股和洋教条在全国许多人中间的影响，也就不能进行有力的斗争，也就达不到加以摧毁廓清的目的。","book":"毛泽东《反对党八股》"},"similar":["摧陷廓清"],"usage":"作谓语、定语；用于处事"},{"id":22529,"word":"摧眉折腰","pinyin":"cuī méi zhé yāo","abbr":"cmzy","explanation":"低眉弯腰。形容没有骨气，巴结奉承。","source":{"text":"安能摧眉折腰事权贵，使我不得开心颜。","book":"唐·李白《梦游天姥吟留别》"},"example":{"text":"男儿委身事权贵，～诚可怜。","book":"明·何景明《归来篇》"},"similar":["奴颜媚骨","奴颜婢膝","卑躬屈膝"],"opposite":["刚正不阿"],"usage":"作谓语、定语；形容没有骨气"},{"id":22530,"word":"摧紧获丑","pinyin":"cuī jiān huò chǒu","abbr":"cjhc","explanation":"摧坚：击溃敌精锐部队；丑：众，指敌人。挫败敌方精锐的军队，俘获敌寇。形容作战十分英勇。","source":{"text":"开通道途，收复贼聚，摧坚获丑，尔功居多。","book":"宋·曾巩《折克行彭保转官制》"}},{"id":22531,"word":"摧胸破肝","pinyin":"cuī xiōng pò gān","abbr":"cxpg","explanation":"心肝断裂剖开。比喻极度悲伤和痛苦。同“摧心剖肝”。","source":{"text":"讣来逾年，一恸海徼，摧胸破肝，痛我令妹。","book":"宋·苏轼《祭柳仲远文》"},"similar":["摧心剖肝"],"usage":"作谓语、定语；指十分悲伤"},{"id":22532,"word":"摧花斫柳","pinyin":"cuī huā zhuó liǔ","abbr":"chzl","explanation":"比喻摧残女子。","source":{"text":"僵桃代李诚无与，摧花斫柳夫何取？","book":"清·嬴宗季女《六月霜·对簿》"},"similar":["摧兰折玉"],"usage":"作谓语、定语、宾语；比喻摧残女性"},{"id":22533,"word":"摧身碎首","pinyin":"cuī shēn suì shǒu","abbr":"csss","explanation":"即粉身碎骨。","source":{"text":"臣愚驽垢秽，才质疵下，过受陛下日月之恩，不能摧身碎首，以答陛下厚德。","book":"三国·魏·曹植《谢封甄城王表》"},"similar":["粉身碎骨"],"usage":"作谓语、定语；指粉身碎骨"},{"id":22534,"word":"摧锋陷坚","pinyin":"cuī fēng xiàn jiān","abbr":"cfxj","explanation":"摧：摧毁；锋：锋利；陷：攻陷；坚：坚锐。破敌深入。","source":{"text":"城孤粮尽，外救不至，犹奋羸起病，摧锋陷坚。","book":"《新唐书·文苑传下·李翰》"},"example":{"text":"忠以诸弟给事幕下，～，与有劳绩。","book":"明·唐顺之《指挥佥事汤雪江墓碑铭》"},"similar":["摧锋陷阵"],"usage":"作谓语；用于军事等"},{"id":22535,"word":"摧锋陷阵","pinyin":"cuī fēng xiàn zhèn","abbr":"cfxz","explanation":"摧：击溃；锋：锋芒，引申为精锐；陷：攻入。攻入并摧毁敌军的阵地。","source":{"text":"高祖常披皯执锐，为士卒先，每战辄摧锋陷阵。","book":"《宋书·武帝纪上》"},"example":{"text":"乃与骁骑十余～，所向披靡，遂引去。","book":"《晋书·景帝纪》"},"similar":["冲锋陷阵"],"usage":"作谓语；指破敌深入"},{"id":22536,"word":"摧陷廓清","pinyin":"cuī xiàn kuò qīng","abbr":"cxkq","explanation":"摧陷：摧毁；廓清：肃清。攻破敌阵，肃清残敌。比喻写文章打破陈规。","source":{"text":"先生于文，摧陷廓清之功，比于武事，可谓雄伟不常者也。","book":"唐·李汉《昌黎先生集序》"},"example":{"text":"凭实验不凭虚境，举一切神鬼妖狐之见，～。","book":"《晚清文学丛钞·扫迷帚》第一回"},"similar":["摧毁廓清"],"usage":"作谓语、定语；比喻写文章打破常规"},{"id":22537,"word":"摩乾轧坤","pinyin":"mó qián yà kūn","abbr":"mqyk","explanation":"乾、坤：天、地；轧：压。指顶天立地。","source":{"text":"于赫龙虎之台，摩塌轧坤。魁群山而独尊。","book":"明·刘基《龙虎台赋》"}},{"id":22538,"word":"摩厉以需","pinyin":"mó lì yǐ xū","abbr":"mlyx","explanation":"磨快刀子等待。比喻做好准备，等待时机。同“摩厉以须”。","source":{"text":"媳妇有妖胎，会将摩厉以需，毋复聒之使不安静也。","book":"清·和邦额《夜谭随录·朱佩茞》"},"similar":["摩砺以须","摩厉以须","磨厉以须"],"usage":"作谓语；比喻做好准备，等待时机"},{"id":22539,"word":"摩厉以须","pinyin":"mó lì yǐ xū","abbr":"mlyx","explanation":"磨快刀子等待。比喻做好准备，等待时机。","source":{"text":"摩厉以须，王出，吾刃将斩矣。","book":"《左传·昭公十二年》"},"example":{"text":"至是始得以间道生还之故迁拜拾遗，得居言路，～。","book":"清·无名氏《杜诗言志》卷五"},"similar":["摩厉以需","摩砺以须"],"usage":"作谓语；比喻做好准备，等待时机"},{"id":22540,"word":"摩口膏舌","pinyin":"mó kǒu gāo shé","abbr":"mkgs","explanation":"磨练口舌。形容讲话很厉害，善于挑拨诬陷。","source":{"text":"羊胜之徒，摩口膏舌；邹阳自明，入狱复出。","book":"汉·王充《论衡·自纪》"},"usage":"作宾语、定语；指人的口才好"},{"id":22541,"word":"摩天碍日","pinyin":"mó tiān ài rì","abbr":"mtar","explanation":"碍：遮蔽。触摩着天，遮蔽着太阳。形容山或建筑物非常高大。","source":{"text":"忽又见一座高山，真是摩天碍日。","book":"明·吴承恩《西游记》第四十回"},"usage":"作宾语、定语；用于书面语"},{"id":22542,"word":"摩拳擦掌","pinyin":"mó quán cā zhǎng","abbr":"mqcz","explanation":"形容战斗或劳动之前，人们精神振奋，跃跃欲试的样子。","source":{"text":"俺可也摩拳擦掌，行行里按不住莽撞心头气。","book":"元·康进之《李逵负荆》第二折"},"example":{"text":"这是第一次出马，人们都～，心里突突跳着准备战斗。","book":"梁斌《红旗谱》四十八"},"similar":["跃跃欲试","磨拳擦掌"],"opposite":["按兵不动"],"usage":"作谓语、状语、补语；指跃跃欲试的样子"},{"id":22543,"word":"摩挲赏鉴","pinyin":"mó suō shǎng jiàn","abbr":"mssj","explanation":"摩挲：用手抚摸；赏鉴：欣赏鉴别。。用手抚摸着欣赏鉴别。形容对古董、书画、工艺美术品等的喜爱和欣赏。","example":{"text":"就是流寓上海，也一定得生活较为安闲，在客栈里有一间长包的房子，书桌一顶，烟榻一张，瘾足心闲，～。","book":"鲁迅《小品文的危机》"}},{"id":22544,"word":"摩砺以须","pinyin":"mó lì yǐ xū","abbr":"mlyx","explanation":"磨快刀子等待。比喻做好准备，等待时机。同“摩厉以须”。","source":{"text":"盖示余勇，摩砺以须我耳。","book":"唐·白居易《重序》"},"similar":["摩厉以需","摩厉以须","磨厉以须"],"usage":"作谓语；比喻做好准备，等待时机"},{"id":22545,"word":"摩肩击毂","pinyin":"mó jiān jī gǔ","abbr":"mjjg","explanation":"肩膀和肩膀相摩，车轮和车轮相撞。形容行人车辆往来拥挤。","source":{"text":"临淄之途，车毂击，人肩摩。","book":"《战国策·齐策一》"},"example":{"text":"帝城才过元宵节，～何更迭。","book":"清·王位坤《燕九竹枝词》"},"similar":["摩肩接踵"],"usage":"作定语；用于人多的场合"},{"id":22546,"word":"摩肩如云","pinyin":"mó jiān rú yún","abbr":"mjry","explanation":"摩：摩擦。肩碰肩，如云一样密集。形容人多拥挤。","source":{"text":"临淄之途，车毂击，人肩摩。","book":"《战国策·齐策一》"},"example":{"text":"许多碧眼紫髯的的伟男，蜷发蜂腰的仕女，正是～，挥汗成雨的时候，烦渴的了不得。","book":"清·曾朴《孽海花》第十回"},"similar":["摩肩擦背"],"usage":"作谓语、定语、状语；用于人多时"},{"id":22547,"word":"摩肩接毂","pinyin":"mó jiān jiē gǔ","abbr":"mjjg","explanation":"肩挨着肩，车轮挨着车轮。形容人多拥挤。","source":{"text":"伊阙摩肩接毂，为楚豫大道。","book":"明·徐弘祖《徐霞客游记·游嵩山日记》"},"similar":["挨肩搭背"],"usage":"作谓语、定语；形容人多拥挤"},{"id":22548,"word":"摩肩接踵","pinyin":"mó jiān jiē zhǒng","abbr":"mjjz","explanation":"肩碰着肩，脚碰着脚。形容人多拥挤。","source":{"text":"入城，宣布德意，不戮一人，中原归附者踵接。","book":"《战国策·齐策一》：“临淄之途，车毂击，人肩摩。”《宋史·李显忠传》"},"example":{"text":"节日的公园里，游人～，十分拥挤。"},"similar":["熙熙攘攘","熙来攘往"],"opposite":["地广人稀"],"usage":"作谓语、定语、状语；形容人多时","story":["春秋时期，齐国相国晏婴奉命出使楚国，楚王存心侮辱他，不给他走正门，说齐国没人就派这个矮人来。晏婴说齐国街上的人摩肩接踵，挥汗成雨。齐国的出使规矩就是无能的使臣只能去见无能的国君。楚王自取其辱，只好隆重接待"]},{"id":22549,"word":"摩肩擦背","pinyin":"mó jiān cā bèi","abbr":"mjcb","explanation":"摩：摩擦。肩碰肩，背靠背。形容人多拥挤。","source":{"text":"我发现我摩肩擦背的人群中，穿蓝衣衫者毕竟是少数。","book":"章武《北京的色彩》"},"similar":["摩肩接踵"],"usage":"作谓语、定语、状语；用于人多时"},{"id":22550,"word":"摩肩擦踵","pinyin":"mó jiān cā zhǒng","abbr":"mjcz","explanation":"形容来往行人众多，很拥挤。","example":{"text":"大街上人来人往，～，十分热闹。"}},{"id":22551,"word":"摩顶放踵","pinyin":"mó dǐng fàng zhǒng","abbr":"mdfz","explanation":"从头顶到脚跟都擦伤了。形容不辞劳苦，不顾身体。","source":{"text":"墨子兼爱，摩顶放踵，利天下为之。","book":"《孟子·尽心上》"},"example":{"text":"故～以拯生民之陆沉，前者踣，后者继，百挫而无反顾，终以集事。","book":"章炳麟《变法箴言》"},"similar":["摩顶至踵"],"usage":"作谓语、定语；形容人不辞劳苦"},{"id":22552,"word":"摩顶至足","pinyin":"mó dǐng zhì zú","abbr":"mdzz","explanation":"犹摩顶放踵。形容不辞劳苦，不顾身体。","source":{"text":"摩顶至足买片言，开胸沥胆取一顾。","book":"南朝·梁·吴均《行路难》诗"},"example":{"text":"上启陈诗，唯希咳唾之泽；～，冀荷提携之恩。","book":"《旧唐书·恭登传》"},"similar":["摩顶至踵"],"usage":"作谓语、定语、状语；形容人不辞劳苦"},{"id":22553,"word":"摩顶至踵","pinyin":"mó dǐng zhì zhǒng","abbr":"mdzz","explanation":"犹摩顶放踵。形容不辞劳苦，不顾身体。","source":{"text":"墨子兼爱，摩顶放踵，利天下为之。","book":"《孟子·尽心上》"},"example":{"text":"幸蒙大王忆念上皇，远垂救援，使臣应死复生，臣虽～，尚难报德。","book":"蔡东藩《唐史演义》第五十六回"},"similar":["摩顶放踵","摩顶至足"],"usage":"作谓语、定语、状语；形容人不辞劳苦"},{"id":22554,"word":"摭华损实","pinyin":"zhí huā sǔn shí","abbr":"zhss","explanation":"摭：指摘取；华：同“花”。摘取花朵，损失果实。比喻只顾表面，忘记实质。","source":{"text":"名流先达，部执交驰，趋末忘本，摭华损实。","book":"唐·张说《大唐西域记序》"},"usage":"作谓语、定语；用于书面语"},{"id":22555,"word":"摸不着头脑","pinyin":"mō bù zháo tóu nǎo","abbr":"mbztn","explanation":"指弄不清是怎么回事。","source":{"text":"当时同多九公议定，把兰音，若花送了过去。二人摸不着头脑，又不敢违拗，只得暂且住下。","book":"清·李汝珍《镜花缘》第四十回"},"example":{"text":"那人低着头，亦看不出面貌。羊统领满腹狐疑更是～。","book":"清·李宝嘉《官场现形记》第三十一回"},"similar":["糊里糊涂","摸头不着"],"opposite":["了如指掌","一目了然"],"usage":"作谓语、状语；指不知是怎么回事","story":["贾宝玉被父亲贾政严管读书，他自己根本没心思读，翻开《古乐府》，看到曹操“对酒当歌，人生几何”时，顿时感慨万千，就放下一本又拿另一本，来回翻阅，根本不认真。袭人一时摸不着头脑，也只管站在旁边呆呆的看着他，后来干脆放他出去玩"]},{"id":22556,"word":"摸不着边","pinyin":"mō bù zháo biān","abbr":"mbzb","explanation":"不着边际，接触不到实际问题。","example":{"text":"咱别谈～的事了。"},"similar":["摸头不着"],"usage":"作状语、定语；指不着边际"},{"id":22557,"word":"摸头不着","pinyin":"mō tóu bù zháo","abbr":"mtbz","explanation":"指莫名其妙，不知所措。","source":{"text":"赵氏听了这话，摸头不着，只得依着言语，写了一封字。","book":"清·吴敬梓《儒林外史》第六回"},"example":{"text":"我刚到此还～。"},"similar":["莫名其妙","找不到北"],"opposite":["洞若观火"],"usage":"作谓语、状语；指莫名其妙"},{"id":22558,"word":"摸棱两可","pinyin":"mō léng liǎng kě","abbr":"mllk","explanation":"握持棱角，两端皆可。比喻遇事不决断可否，不分是非。","source":{"text":"处事不欲决断明白，若有错误，必贻咎谴，但摸棱以持两端可矣。","book":"《旧唐书·苏味道传》"},"example":{"text":"我对这个问题一直是～。"},"similar":["模棱两可"],"opposite":["旗帜鲜明"],"usage":"作谓语、定语；指态度不明确","story":["唐朝时期，武则天任命苏味道为宰相，他处世十分圆滑，从不表明自己的看法，他认为这样不会得罪人，他把这种圆滑的方法说成“决事不欲明白，误则有悔，模棱特两端可也。”人们送他一个外号叫“苏模棱”。后因犯错而降职到四川眉州"]},{"id":22559,"word":"摸着石头过河","pinyin":"mō zhe shí tóu guò hé","abbr":"mzstgh","explanation":"比喻办事谨慎，边干边摸索经验。","example":{"text":"我们只有～，谨慎从事。"},"similar":["稳扎稳打"],"usage":"作谓语、定语、宾语；比喻办事谨慎"},{"id":22560,"word":"摸索门径","pinyin":"mō suǒ nén jìng","abbr":"msmj","explanation":"探索途径，寻找解决的办法。"},{"id":22561,"word":"摸金校尉","pinyin":"mō jīn xiào wèi","abbr":"mjxw","explanation":"校尉：古代军官职称。指掠夺财物的军官。","source":{"text":"操又特置发丘中郎将，摸金校尉，所过隳突，无骸不露。","book":"汉·陈琳《为袁绍檄豫州》"},"example":{"text":"不啻～，何殊发丘中郎。括尽前朝翰墨，搜穷历代彝章。","book":"明·东鲁古狂生《醉醒石》第八回"},"usage":"作宾语；指掠夺财物的官员"},{"id":22562,"word":"摸门不着","pinyin":"mō mén bù zháo","abbr":"mmbz","explanation":"指莫名其妙。","source":{"text":"一顿夹七夹八，骂的范进摸门不着。辞了丈人回来。","book":"清·吴敬梓《儒林外史》第三回"},"example":{"text":"他被她整得～。"},"similar":["摸头不着","莫名其妙"],"opposite":["洞若观火"],"usage":"作谓语、状语；指莫名其妙"},{"id":22563,"word":"摸鸡偷狗","pinyin":"mō jī tōu gǒu","abbr":"mjtg","explanation":"指小偷小摸。也指不正当的男女关系。","source":{"text":"在此帮那强盗摸鸡偷狗的，一旦有失，落个骂名千古。","book":"清·钱彩《说岳全传》第29回"},"similar":["偷鸡摸狗"],"usage":"作谓语、定语、宾语；指偷窃"},{"id":22564,"word":"摽末之功","pinyin":"biào mò zhī gōng","abbr":"bmzg","explanation":"摽：通“镖”，刀刃，比喻微末。比喻很小的功劳。","source":{"text":"乃至青戎，摽末之功，一言之劳，然犹皆蒙丘山之赏。","book":"《汉书·五莽传》"}},{"id":22565,"word":"摽梅之年","pinyin":"biào méi zhī nián","abbr":"bmzn","explanation":"摽梅：梅子成熟后落下来。比喻女子已到了出嫁的年龄。有时也指男子婚配的年龄。","source":{"text":"摽有梅，其实七兮。求我庶士，迨其吉兮。","book":"《诗经·召南·摽有梅》"},"example":{"text":"凭一年纪，尚不曾娶，也是男子摽梅之候了。","book":"清·吴敬梓《儒林外史》第十二四回"},"usage":"作宾语；比喻女子已到了出嫁的年龄"},{"id":22566,"word":"撅坑撅堑","pinyin":"jué kēng jué qiàn","abbr":"jkjq","explanation":"撅：挖。掘深坑。比喻设计害人。","source":{"text":"抡的柄铜揪分外里险，撅坑撅堑。","book":"元·曾瑞《斗鹌鹑·风情》"},"usage":"作谓语；指设计害人"},{"id":22567,"word":"撅天扑地","pinyin":"juē tiān pū dì","abbr":"jtpd","explanation":"形容尽量搜括。","source":{"text":"见倈子撅天扑地，不弱如打家劫舍杀人贼。","book":"元·武汉臣《玉壶春》第四折"},"usage":"作谓语；用于贪官"},{"id":22568,"word":"撅竖小人","pinyin":"juē shù xiǎo rén","abbr":"jsxr","explanation":"撅竖：卑鄙，恶劣。对卑劣小人的蔑称。","source":{"text":"撅竖小人，无大经略，正可残暴，终为人所灭耳。","book":"《魏书·崔诰传》"},"example":{"text":"～，虽能纵暴一时，终当为人所吞食耳。","book":"《资治通鉴·晋记》"}},{"id":22569,"word":"撇呆打堕","pinyin":"piě dāi dǎ duò","abbr":"pddd","explanation":"装呆作痴。","source":{"text":"撇呆打堕，早被那人瞧破。要同归知爹肯么？料他每，不见许。","book":"明·高明《琵琶记·牛小姐谏父》"}},{"id":22570,"word":"撑天拄地","pinyin":"chēng tiān zhǔ dì","abbr":"ctzd","explanation":"犹言顶天立地。","source":{"text":"圣人只是常欲扶持这个道理，教他撑天拄地。","book":"《朱子全书》卷九"},"similar":["顶天立地"],"usage":"作谓语、宾语；多用于男人"},{"id":22571,"word":"撑天柱地","pinyin":"chēng tiān zhù dì","abbr":"ctzd","explanation":"上顶着天，下及于地。比喻起大作用，维持某种局面。也形容形体极大。","source":{"text":"圣人只是常欲扶持这个道理，教他撑天柱地。","book":"宋·朱熹《朱子全书》卷九"},"example":{"text":"尝闻龙会变化，要大便～，要小便芥子藏身。","book":"明·许仲琳《封神演义》第十三回"},"similar":["柱地撑天","顶天立地"],"usage":"作谓语、定语；指高大"},{"id":22572,"word":"撑岸就船","pinyin":"chēng àn jiù chuán","abbr":"cajc","explanation":"比喻颠倒主从，不合情理。","source":{"text":"只见说撑船就岸，几曾有撑岸就船。你不来睬我，老娘倒落得。","book":"《水浒传》第二一回"},"similar":["缘木求鱼"],"usage":"作宾语、定语；指主从颠倒"},{"id":22573,"word":"撑眉努眼","pinyin":"chēng méi nǔ yǎn","abbr":"cmny","explanation":"竖起眉毛，瞪大眼睛。形容态度严厉而专横。","source":{"text":"其知之者撑眉努眼，喝骂将去，便谓只此便是良心本性，无有不善，却不知道。","book":"宋·朱熹《答或人》"},"usage":"作谓语；指人蛮横"},{"id":22574,"word":"撑肠拄肚","pinyin":"chēng cháng zhǔ dù","abbr":"cczd","explanation":"腹中饱满。比喻容受很多。","source":{"text":"撑肠拄肚礌傀如山丘，自可饱死更不偷。","book":"唐·卢仝《月蚀诗》"},"example":{"text":"如吃物事相似，将甚么杂物事，不是时节，一顿都吃了，便被他～，没奈何他。","book":"《朱子语类》卷十一"},"similar":["撑肠拄腹"],"usage":"作谓语、状语；形容吃得很饱"},{"id":22575,"word":"撑肠拄腹","pinyin":"chēng cháng zhǔ fù","abbr":"cczf","explanation":"比喻容受很多。也形容肚子吃得非常饱。","source":{"text":"不用撑肠拄腹文字五千卷，但愿一瓯常及睡足日高时。","book":"唐·卢仝《月蚀》诗：“撑肠拄肚礧傀如山丘，自可饱死更不偷。”宋·苏轼《试院煎茶》诗"},"example":{"text":"这家子将酝下的杜茅酒不住的荡来，吃得东倒西歪，～。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["撑肠拄肚"],"usage":"作谓语、状语；形容吃得很饱"},{"id":22576,"word":"撑门拄户","pinyin":"chēng mén zhǔ hù","abbr":"cmzh","explanation":"撑：支持；拄：支撑。支撑门户。指独立主持或担当某一方面的工作。","source":{"text":"猛火然铛著佛喋，恁公作用，方可撑门拄户。","book":"宋·释惟白《续传灯录》第31卷"},"usage":"作谓语、定语；用于主心骨等"},{"id":22577,"word":"撑霆裂月","pinyin":"chēng tíng liè yuè","abbr":"ctly","explanation":"形容声气惊人。","source":{"text":"吾适又自编《一鸣集》，且云撑霆裂月，劫作者之肝脾，亦当吾言之无怍也。","book":"唐·司空图《与王驾评诗》"},"usage":"作宾语、定语；用于人的气势等"},{"id":22578,"word":"撒丫子","pinyin":"sā yā zǐ","abbr":"syz","explanation":"抬腿走开或奔跑，开溜。","example":{"text":"每到关键时刻，他就～了。"},"similar":["撒鸭子"],"usage":"作谓语、状语；用于方言"},{"id":22579,"word":"撒娇使性","pinyin":"sā jiāo shǐ xìng","abbr":"sjsx","explanation":"指儒恃宠爱而任性行事。","example":{"text":"想当年我也曾～，到如今只落得旧衣破裙。","book":"京剧《锁麟囊》"}},{"id":22580,"word":"撒娇卖俏","pinyin":"sā jiāo mài qiào","abbr":"sjmq","explanation":"撒：尽量施展。尽量施展娇态，卖弄俏丽。","source":{"text":"穿了极华丽的衣裳，打扮得娇滴滴的，在那公子王孙面前撒娇卖俏。","book":"清·西周生《醒世姻缘传》第八回"},"example":{"text":"她～，为的是求一碗饭而已。"},"similar":["撒娇卖乖"],"usage":"作谓语、宾语、定语；指施展娇态"},{"id":22581,"word":"撒娇撒痴","pinyin":"sā jiāo sā chī","abbr":"sjsc","explanation":"撒：尽量使出来或施展出来；娇：娇气；痴：憨痴。形容仗着受人宠爱，故意做作。","source":{"text":"那婆娘不达时务，指望煨热老公，重做夫妻，紧捱着酒壶，撒娇撒痴，甜言美语。","book":"明·冯梦龙《警世通言》卷二"},"example":{"text":"你伏侍别人，还象在我手里，那等～，好也罢，歹也罢，谁人容的你。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"},"similar":["撒痴撒娇"],"usage":"作谓语、定语；指故意做作"},{"id":22582,"word":"撒开鸭子","pinyin":"sā kāi yā zǐ","abbr":"skyz","explanation":"放开脚步快走。","example":{"text":"他～地跑向终点。"},"similar":["撒鸭子","撒丫子"],"usage":"作定语、状语；用于口语"},{"id":22583,"word":"撒手人寰","pinyin":"sā shǒu rén huán","abbr":"ssrh","explanation":"人寰：人世。指离开人世。","source":{"text":"程继先、王凤卿也撒手人寰。","book":"章诒和《往事并不如烟·君子之交》"},"usage":"作谓语、定语；用于死亡"},{"id":22584,"word":"撒手尘寰","pinyin":"sā shǒu ché huán","abbr":"ssch","explanation":"撒手：放手而去；尘寰：尘世。指人去世。","source":{"text":"日暮途穷寄身异域，水流花谢撒手尘寰。","book":"蔡东藩《清史演义》第二十回"}},{"id":22585,"word":"撒手锏","pinyin":"sā shǒu jiǎn","abbr":"ssj","explanation":"小说中搏斗时突然用锏投杀敌人的绝招，比喻在危急时拿出看家本领。","example":{"text":"把你的～尽管使出来吧，我们不怕。"},"similar":["杀手锏"],"usage":"作主语、宾语、定语；指绝招"},{"id":22586,"word":"撒手长逝","pinyin":"sā shǒu cháng shì","abbr":"sscs","explanation":"撒：放开；长：永远。放开手永远离去。指死亡。","source":{"text":"哀哉数朝卧病，何意撒手竟长逝。","book":"清·秋瑾《挽母联》"}},{"id":22587,"word":"撒手闭眼","pinyin":"sā shǒu bì yǎn","abbr":"ssby","explanation":"撒手：放开手，指不管；闭眼：闭着眼睛，看不见。形容对事情不再负责，不再插手。"},{"id":22588,"word":"撒村发野","pinyin":"sā cūn fā yě","abbr":"scfy","explanation":"撒村：说粗野话；发野：撒野。指用粗鲁下流话当众谩骂、撒野。","source":{"text":"绍闻方欲推托，被管贻安几句撒村发野的话弄住了。","book":"清·李绿园《歧路灯》第三十四回"}},{"id":22589,"word":"撒村骂街","pinyin":"sā cūn mà jiē","abbr":"scmj","explanation":"撒村：说粗野话；骂街：不指明对象当众谩骂。指用粗鲁下流话当众谩骂。","source":{"text":"绍闻方欲推托，被管贻安几句撒村发野的话弄住了。","book":"清·李绿园《歧路灯》第三十四回"},"example":{"text":"自己的妻子呢，只会赶小鸡，叫猪，和大声吓唬孩子，还会～呢。","book":"老舍《离婚》"},"similar":["泼妇骂街"],"usage":"作谓语、宾语、定语；用于为人"},{"id":22590,"word":"撒水拿鱼","pinyin":"sā shuǐ ná yú","abbr":"ssny","explanation":"抽干水捉鱼。比喻事情容易做，不费气力。","example":{"text":"～的事谁不会？"},"usage":"作宾语、定语；用于处事"},{"id":22591,"word":"撒泼打滚","pinyin":"sā pō dǎ gǔn","abbr":"spdg","explanation":"嘴里骂着泼辣的话，躺倒在地上打滚。同“打滚撒泼”。","source":{"text":"他虽不敢还手，便也撒泼打滚，寻死觅活。","book":"清·曹雪芹《红楼梦》第八十回"},"similar":["撒泼放刁"],"usage":"作谓语、定语；用于为人"},{"id":22592,"word":"撒泼放刁","pinyin":"sā pō fàng diāo","abbr":"spfd","explanation":"耍赖撒野。举动粗蛮，无理取闹。","source":{"text":"你却如此撒泼放刁，快快出去便休。","book":"《平妖传》第四回"},"example":{"text":"清·曹雪芹《红楼梦》第100回：“那薛蝌却只躲着；有时遇见，也不敢不周旋一二，只怕他～的意思。”"},"similar":["撒泼打滚"],"usage":"作谓语、宾语、定语；多用于女性"},{"id":22593,"word":"撒泼行凶","pinyin":"sā pō xíng xiōng","abbr":"spxx","explanation":"放刁逞蛮，打人以至杀人。","source":{"text":"浪荡乾坤，怎敢行凶撒泼，擅自勒死平民！","book":"元·关汉卿《窦娥冤》第二折"},"example":{"text":"这件事实在是小老婆～，把大老婆的脸都抓破，男人制伏不下，所以大老婆来告状的。","book":"清·李宝嘉《官场现形记》第四十回"}},{"id":22594,"word":"撒痴撒娇","pinyin":"sā chī sā jiāo","abbr":"scsj","explanation":"形容仗着受人宠爱，故意做作。同“撒娇撒痴”。","source":{"text":"觉得自己太没脸，也觉得人家对他只有虚情假意，所以撒痴撒娇，定要问个明白。","book":"茅盾《参孙的复仇》"},"similar":["撒娇撒痴"],"usage":"作谓语、定语；指故意做作"},{"id":22595,"word":"撒科打诨","pinyin":"sā kē dǎ hùn","abbr":"skdh","explanation":"穿插在戏曲表演中，使观众发笑的动作与道白。亦泛指引人发笑的言语、动作。","source":{"text":"秀才，与你这一间幽静的房儿，随你自去打斛斗，学踢弄，舞地鬼，乔扮神，撒科打诨，乱作胡为。","book":"元·李好古《张生煮海》第一折"},"example":{"text":"戏剧中少不了～。"},"similar":["插科打诨","打诨插科"],"usage":"作谓语、宾语；泛指引人发笑的动作与言谈"},{"id":22596,"word":"撒诈捣虚","pinyin":"sā zhà dǎo xū","abbr":"szdx","explanation":"指说谎骗人。","source":{"text":"祖师喝令：赶出去！他本是个撒诈捣虚之徒，那里修甚么道果。","book":"明·吴承恩《西游记》第一回"},"usage":"作谓语、定语、宾语；用于为人"},{"id":22597,"word":"撒豆成兵","pinyin":"sǎ dòu chéng bīng","abbr":"sdcb","explanation":"撒放豆子，变成军队。传说中谓散布豆类即能变成军队的一种魔法。旧小说戏曲中所说的一种法术。","source":{"text":"变昼为夜，撒豆成兵，挥剑成河，呼风唤雨。","book":"元·无名氏·《十样锦》第二折"},"example":{"text":"既有这剪草为马，～的本事，何忧大事不成！","book":"《平妖传》第三十一回"},"usage":"作宾语、定语；用于迷信说法"},{"id":22598,"word":"撒赖放泼","pinyin":"sā lài fàng pō","abbr":"slfp","explanation":"形容耍无赖，瞎胡闹。","example":{"text":"茶壶的碎瓷片，散在地上，仰着死白色的破脸，像是十分委曲，又像是～的神气。","book":"茅盾《蚀》一"}},{"id":22599,"word":"撒酒疯儿","pinyin":"sā jiǔ fēng ér","abbr":"sjfe","explanation":"喝醉酒后任性胡闹。","source":{"text":"千不该，万不该，前天吃醉了酒，在你荐的人那里撒酒风，叫你下不去！真正对你不住！","book":"清·李宝嘉《官场现形记》第25回"},"example":{"text":"她一喝酒就爱～，借酒闹事。"},"similar":["撒酒疯"],"usage":"作谓语、宾语、定语；用于口语"},{"id":22600,"word":"撒骚放屁","pinyin":"sā sāo fàng pì","abbr":"ssfp","explanation":"胡说八道。","source":{"text":"《醒世姻缘传》第三十四回：“咱这里小人口面多，俺摇旗打鼓的吃了你的酒，再有人撒骚放屁，俺不便出头管你。”"}},{"id":22601,"word":"撞倒南墙","pinyin":"zhuàng dǎo nán qiáng","abbr":"zdnq","explanation":"比喻态度生硬，行动固执，不知变通。","source":{"text":"我看你这位老爷子也是年高有德的人，你两句浊语丧的去了。你就撞倒南墙吧。","book":"清·西周生《醒世姻缘传》第八十回"}},{"id":22602,"word":"撞头搕脑","pinyin":"zhuàng tóu kē nǎo","abbr":"ztkn","explanation":"犹言到处碰壁。搕通“磕”。","source":{"text":"政如义理，只理会得三二分，便道只恁地得了，却不知前面撞头搕脑。","book":"宋·朱熹《朱子语类》卷四十九"},"similar":["撞头磕脑"],"usage":"作谓语、定语；指行不通"},{"id":22603,"word":"撞头磕脑","pinyin":"zhuàng tóu kē nǎo","abbr":"ztkn","explanation":"比喻碰壁，行不通。","source":{"text":"政如义理。只理会得三二分，便道只恁地得了，却不知前面撞头磕脑。","book":"《朱子语类》"},"similar":["撞头搕脑"],"usage":"作谓语、定语；指行不通"},{"id":22604,"word":"撞府冲州","pinyin":"zhuàng fǔ chōng zhōu","abbr":"zfcz","explanation":"犹言走江湖，跑码头。也形容经历丰富，见过世面。","source":{"text":"则被你坑杀人燕侣莺俦。婆婆也，你岂不知羞！俺公公撞府冲州。","book":"元·关汉卿《窦娥冤》第一折"},"similar":["撞府穿州"],"usage":"作谓语、定语；用于书面语"},{"id":22605,"word":"撞府穿州","pinyin":"zhuàng fǔ chuān zhōu","abbr":"zfcz","explanation":"撞：闯。指在江湖上东游西荡，行踪无定","source":{"text":"咳，你费工夫去撞府穿州，不如依本分登科及第。","book":"明·汤显祖《牡丹亭·诀谒》"},"similar":["撞府冲州"],"usage":"作谓语、定语；用于书面语"},{"id":22606,"word":"撞破烟楼","pinyin":"zhuàng pò yān lóu","abbr":"zpyl","explanation":"烟楼：灶上的烟囱。比喻子辈胜过父辈，后人超越前人。","source":{"text":"在定日作《松醪赋》一首，今写寄择等，庶以发后生妙思，着鞭一路，当撞破烟楼也。","book":"宋·苏轼《答陈季常书》"}},{"id":22607,"word":"撞钟伐鼓","pinyin":"zhuàng zhōng fá gǔ","abbr":"zzfg","explanation":"指奏乐或敲击寺院的钟鼓。","source":{"text":"故儒术诚行，则天下大而富，使而功，撞钟击鼓而和。","book":"《墨子·非乐上》：“撞巨钟，击鸣鼓。”《荀子·富国》"},"example":{"text":"羽林军后，尽是左右金枪班。殿上～。","book":"清·俞万春《荡寇志》第七十一回"},"similar":["撞钟击鼓"],"usage":"作宾语、定语；用于书面语"},{"id":22608,"word":"撞钟击鼓","pinyin":"zhuàng zhōng jī gǔ","abbr":"zzjg","explanation":"指奏乐或敲击寺院的钟鼓。","source":{"text":"故儒术诚行，则天下大而富，使而功，撞钟击鼓而和。","book":"《墨子·非乐上》：“撞巨钟，击鸣鼓。”《荀子·富国》"},"example":{"text":"转到山门外，只听寺内～，众僧出来迎接，向前与宋江、鲁智深等施了礼。","book":"明·施耐庵《水浒全传》第九十回"},"similar":["撞钟伐鼓"],"usage":"作宾语、定语；用于书面语"},{"id":22609,"word":"撞钟吹螺","pinyin":"zhuàng zhōng chuī luó","abbr":"zzcl","explanation":"敲击寺院的钟，吹响螺号。指奏乐。","source":{"text":"街东街西讲佛经，撞钟吹螺闹宫庭。","book":"唐·韩愈《华山女》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":22610,"word":"撞钟舞女","pinyin":"zhuàng zhōng wǔ nǚ","abbr":"zzwn","explanation":"撞钟：奏乐；舞女：伴以美女跳舞。形容恣意行乐的生活","source":{"text":"为人主者，诚明于臣之所言，则虽毕戈驰骋，撞钟舞女，国犹且存也。","book":"战国·韩·韩非《韩非子·说疑》"},"usage":"作宾语、定语；用于书面语"},{"id":22611,"word":"撞阵冲军","pinyin":"zhuàng zhèn chōng jūn","abbr":"zzcj","explanation":"撞开敌阵地，冲向敌军。形容作战勇猛。","source":{"text":"想我那撞阵冲军，百战功名百战身。","book":"元·尚仲贤《三夺槊》第三折"},"example":{"text":"你不肯～，你可便临崖勒马。","book":"明·无名氏《怒斩关平》第三折"},"usage":"作谓语、定语；用于书面语"},{"id":22612,"word":"撧耳挠腮","pinyin":"juē ěr náo sāi","abbr":"jens","explanation":"形容焦急无计的样子。","source":{"text":"你这般撧耳挠腮，可又便怎生。","book":"元·秦简夫《东堂老》第二折"},"similar":["抓耳挠腮"],"usage":"作宾语、状语；指焦急无计的样子"},{"id":22613,"word":"撧耳揉腮","pinyin":"yōng ěr róu sāi","abbr":"jers","explanation":"形容焦急无计的样子。同“撧耳挠腮”。","source":{"text":"我撧耳揉腮，有口难开。","book":"元·王实甫《破窑记》第三折"},"similar":["撧耳挠腮"],"usage":"作宾语、状语；指焦急无计的样子"},{"id":22614,"word":"撧耳顿足","pinyin":"yǎn ěr dùn zú","abbr":"jedz","explanation":"用手抓耳，以脚顿地。形容束手无策。","source":{"text":"张立于屏风后见之，撧耳顿足。","book":"宋·王铚《默记》上卷"},"similar":["抓耳挠腮"],"usage":"作谓语、状语；用于人的困境"},{"id":22615,"word":"撩云拨雨","pinyin":"liáo yún bō yǔ","abbr":"lyby","explanation":"指人调弄风情。","source":{"text":"只亏你撩云拨雨不胡颜，我自有偷香手段，窃玉机关。","book":"明·徐复祚《投梭记·折齿》"},"example":{"text":"董官人弱冠之年，初晓得～。","book":"明·天然痴叟《石点头》"},"usage":"作谓语、宾语；指人调弄风情"},{"id":22616,"word":"撩是生非","pinyin":"liáo shì shēng fēi","abbr":"lssf","explanation":"惹是生非，造成麻烦后果。","example":{"text":"他就是爱～的人。"},"similar":["惹是生非"],"usage":"作谓语、宾语；指制造麻烦"},{"id":22617,"word":"撩火加油","pinyin":"liáo huǒ jiā yóu","abbr":"lhjy","explanation":"犹言火上加油。在一旁助威增加他人的愤怒或助长事态的发展。","example":{"text":"你不要帮他干～的事情。"},"similar":["火上加油"],"usage":"作宾语、定语；用于比喻句"},{"id":22618,"word":"撩虎须","pinyin":"liáo hǔ xū","abbr":"lhx","explanation":"捋虎须。指冒犯老虎，担受风险。","example":{"text":"他最喜欢干～之类的冒险事情。"},"similar":["捋虎须"],"usage":"作宾语、定语；用于处事"},{"id":22619,"word":"撩蜂剔蝎","pinyin":"liáo fēng tì xiē","abbr":"lftx","explanation":"比喻招惹恶人，自讨苦吃。","source":{"text":"撩蜂剔蝎，打草惊蛇，坏了咱墙头上传情简帖。","book":"元·白朴《墙头马上》第三折"},"example":{"text":"却怕他没人做主，恶了西门庆，却不是去～。","book":"明·施耐庵《水浒传》第26回"},"similar":["寻事生非"],"usage":"作谓语、定语；比喻招惹恶人，自讨苦吃"},{"id":22620,"word":"撩蜂吃螫","pinyin":"liáo fēng chī shì","abbr":"lfcs","explanation":"犹言撩蜂剔蝎。比喻惹犯恶人，自取祸殃。","source":{"text":"清·西周生《醒世姻缘传》第十一回：“那晁住娘子是刘六、刘七裹革出来的婆娘，他肯去撩蜂吃螫？说道：‘你不好问去？只是指使我！’”"},"usage":"作宾语、定语；用于自取其祸"},{"id":22621,"word":"撩蜂拨刺","pinyin":"liáo fēng bō cì","abbr":"lfbc","explanation":"撩：挑逗。引逗蜜蜂拨开刺儿。比喻挑起事端。","source":{"text":"你倒先来撩蜂拨刺，此仇如何不报？","book":"清·俞万春《荡寇志》第89回"},"similar":["撩蜂剔蝎"],"usage":"作谓语、定语；用于好事的人"},{"id":22622,"word":"撩衣奋臂","pinyin":"liáo yī fèn bì","abbr":"lyfb","explanation":"撩：揭起；奋：举起。揭开衣服，举起胳膊。形容准备动手的样子。","source":{"text":"这些番役都撩衣奋臂，专等旨意。","book":"清·曹雪芹《红楼梦》第一百五回"}},{"id":22623,"word":"撬窗挖壁","pinyin":"qiào chuāng wā bì","abbr":"qcwb","explanation":"撬开门窗，挖开墙壁进行偷窃。","source":{"text":"偷东西自是个贼，然而他总是扮了嫖客去的多。若是撬窗挖壁的，那又不奇了。","book":"清·吴趼人《二十年目睹之怪现状》第28回"},"similar":["溜门撬锁"],"usage":"作谓语、定语、宾语；指小偷"},{"id":22624,"word":"播土扬尘","pinyin":"bō tǔ yáng chén","abbr":"btyc","explanation":"播：扬。指尘土飞扬。形容飞奔。","source":{"text":"恨不得播土扬尘，又无个过性的人。","book":"元·王仲文《救孝子》第二折"},"example":{"text":"却早黑气冲天，狂风大作，飞砂走石，～。","book":"明·施耐庵《水浒传》第54回"},"similar":["尘土飞扬","飞砂走石"],"usage":"作宾语、定语；指尘土飞扬"},{"id":22625,"word":"播弄是非","pinyin":"bō nòng shì fēi","abbr":"bnsf","explanation":"挑拨是非。是非：纠纷，口舌。","source":{"text":"疑她播弄是非，所以处心积虑，徐图报复。","book":"《两晋演义》八回"}},{"id":22626,"word":"播恶遗臭","pinyin":"bō è yí chòu","abbr":"beyc","explanation":"传播恶事，遗留臭闻。指所干恶事和坏名声，传播到远地或遗留给后世。","source":{"text":"其在高位者，足以播恶遗臭，贻君子监戒而已。","book":"宋·陆九渊《与黄循中书》"},"usage":"作谓语、定语；指干坏事"},{"id":22627,"word":"播穅眯目","pinyin":"bō kāng mǐ mù","abbr":"bkmm","explanation":"散布糠屑以迷人目。比喻被外物蒙蔽而迷失方向。","source":{"text":"夫播穅眯目，则天地四方易位矣。","book":"《庄子天运》"},"example":{"text":"夫意之所蔽以恶为美者多矣，何特眇倡之事哉？传曰：‘～，则天地四方易位。’余尝三复其言而悲之。","book":"宋·秦观《眇倡传》"}},{"id":22628,"word":"播糠眯目","pinyin":"bō kāng mǐ mù","abbr":"bkmm","explanation":"撒播糠秕眯住别人的眼睛。比喻外物虽小，但造成的危害却很大。","source":{"text":"夫播糠眯目，则天地四方易位矣。","book":"战国·宋·庄周《庄子·天运》"},"example":{"text":"夫意之所蔽以恶为美者多矣，何特眇倡之事哉？传曰：‘～，则天地四方易位。’余尝三复其言而悲之。","book":"宋·秦观《眇倡传》"},"usage":"作谓语；用于蒙蔽别人"},{"id":22629,"word":"撮土为香","pinyin":"cuō tǔ wéi xiāng","abbr":"ctwx","explanation":"撮土：用手把土聚拢成堆。指以撮土代替烧香敬神。","source":{"text":"二人遂向林中去，下马来，撮土为香，对天八拜。","book":"清·钱彩《说岳全传》第四十三回"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“两人对拜了一拜，连‘～’都用不着，就结成了异性手足。”"},"similar":["撮土焚香"],"usage":"作谓语；指烧香敬神"},{"id":22630,"word":"撮土焚香","pinyin":"cuō gǔ fén xiāng","abbr":"ctfx","explanation":"撮土：用手把土聚拢成堆。指旧时迷信的人在野外撮土代替香炉，烧香敬神。","source":{"text":"三藏……急忙撮土焚香，望东恳恳礼拜。","book":"明·吴承恩《西游记》第十四回"},"similar":["撮土为香"],"usage":"作谓语；指烧香敬神"},{"id":22631,"word":"撮盐入水","pinyin":"cuō yán rù shuǐ","abbr":"cyrs","explanation":"①形容立刻消灭干净。②形容大而化之，什么都不在乎。","source":{"text":"[张驴儿做怕科云]有鬼有鬼，撮盐入水，太上老君，急急如律令，敕。","book":"元·关汉卿《窦娥冤》第四折"},"example":{"text":"谁不知老汉是不怕鬼的张撇古，俺的性儿～。","book":"元·无名氏《盆儿鬼》第二折"},"similar":["水中著盐"],"usage":"作谓语、定语；比喻迅速消失"},{"id":22632,"word":"撮盐入火","pinyin":"cuō yán rù huǒ","abbr":"cyrh","explanation":"撮：以指取物。盐一放在火里就爆裂。比喻性情急躁。","source":{"text":"待去呵，小姐性儿撮盐入火。","book":"元·王实甫《西厢记》三本二折"},"example":{"text":"为是他性急，～，为国家面上只要争气，当先厮杀，以此人都叫他做“急先锋”。","book":"明·施耐庵《水浒全传》第十三回"},"similar":["火上浇油"],"usage":"作谓语、定语；比喻性情急躁"},{"id":22633,"word":"撮科打哄","pinyin":"cuō kē dǎ hòng","abbr":"ckdh","explanation":"犹言插科打诨。戏曲、曲艺演员在表演中穿插进去的引人发笑的动作或语言。","source":{"text":"自家扬州城中有名的一个溜二便是。一生浪荡，半世风流。但是晦气的人家，便请我撮科打哄；不管有趣的子弟，都与他钻懒帮闲。","book":"明·汤显祖《南柯记·漫遣》"},"similar":["插科打诨"],"usage":"作主语、谓语、宾语；泛指开玩笑逗乐"},{"id":22634,"word":"撮科打閧","pinyin":"cuō kē dǎ hòng","abbr":"ckdh","explanation":"犹言插科打诨。戏曲、曲艺演员在表演中穿插进去的引人发笑的动作或语言。閧，同“哄”，喧闹。"},{"id":22635,"word":"撮要删繁","pinyin":"cuō yào shān fán","abbr":"cysf","explanation":"撮：抓住；要：主要的；删：去掉；繁：繁琐。抓住主要的，去除繁的。","source":{"text":"要有颦儿这促狭鬼，他用春秋的法子，把世俗粗话，撮其要，删其繁，再加润色，比方出来，一句是一句。","book":"清·曹雪芹《红楼梦》第四十二回"}},{"id":22636,"word":"撺哄鸟乱","pinyin":"cuān hòng niǎo luàn","abbr":"chnl","explanation":"撺哄：怂恿，起哄。形容人多起哄，七嘴八舌，像鸟聚集在一起一般噪乱。","source":{"text":"众人起初吃酒写合同时，大家撺哄鸟乱，心下还有信有不信的意思。","book":"明·凌濛初《初刻拍案惊奇》第一卷"},"example":{"text":"我无法适应这～的局面。"},"usage":"作谓语、定语；指混乱局面"},{"id":22637,"word":"撺拳拢袖","pinyin":"cuān quán lǒng xiù","abbr":"cqlx","explanation":"捏紧拳头，卷起袖口。形容准备动武的样子。","source":{"text":"出到大门外，汪为露还撺拳拢袖要打那侯小槐。","book":"清·西周生《醒世姻缘传》第35回"},"example":{"text":"他急得要～。"},"similar":["擦掌磨拳"],"usage":"作谓语、状语；指要打架"},{"id":22638,"word":"撼地摇天","pinyin":"hàn dì yáo tiān","abbr":"hdyt","explanation":"撼：摇动。把天地都抖动起来。形容力气、本领和声势极大。","source":{"text":"有分教，李逵施为撼地摇天手，来斗巴山跳涧虫。","book":"明·施耐庵《水浒传》第41回"},"example":{"text":"我没有～的本事。"},"similar":["撼天动地"],"usage":"作谓语、状语、定语；指人的声势"},{"id":22639,"word":"撼天动地","pinyin":"hàn tiān dòng dì","abbr":"htdd","explanation":"撼：摇动。震动了天地。形容声音或声势极大。","source":{"text":"涛涌波襄，雷奔电泄，震天动地。","book":"《三国志·魏志·文帝纪》裴松之注：“惟黄初七年五月七日，大行皇帝崩，呜呼哀哉！于时天震地骇。”《水经注·河水》"},"example":{"text":"战场上喊杀声～。"},"similar":["撼地摇天"],"usage":"作谓语、状语；指人的声势"},{"id":22640,"word":"撼天震地","pinyin":"hàn tiān zhèn dì","abbr":"htzd","explanation":"撼：摇动；震：震动。震动了天地。形容声音或声势极大。","source":{"text":"涛涌波襄，雷奔电泄，震天动地。","book":"《三国志·魏志·文帝纪》裴松之注：“惟黄初七年五月七日，大行皇帝崩，呜呼哀哉！于时天震地骇。”《水经注·河水》"},"example":{"text":"一语未了，不提防西边树林里，陡起了一阵～的狂风，飞沙走石，直向东边路上刮剌剌的卷去。","book":"清·曾朴《孽海花》第二十三回"},"similar":["惊天动地"],"usage":"作谓语、定语；形容声音或声势极大"},{"id":22641,"word":"撼山拔树","pinyin":"hàn shān bá shù","abbr":"hsbs","explanation":"摇动山岳，拔起树木。形容威势之大。","source":{"text":"风呵，兀的不傒幸杀人也，方才撼山拔树，飞沙走石般起，投至央及你，可倒定息了。","book":"明·李唐宾《梧桐叶》第二折"},"usage":"作谓语、定语；用于势力等"},{"id":22642,"word":"撼树蚍蜉","pinyin":"hàn shù bí fú","abbr":"hspf","explanation":"撼：摇动。蚍蜉：大蚂蚁。想把大树摇动的大蚂蚁。比喻自不量力者。","source":{"text":"蚍蜉撼大树，可笑不自量。","book":"唐·韩愈《调张籍》诗"},"example":{"text":"应变若机张，马策元驹，车抗螳螂，撼树蚍蜉，更分遣随营相向。","book":"清·洪楝园《后南柯·伐檀》"},"similar":["蚍蜉撼树"],"usage":"作宾语；指自不量力者","story":["唐朝时期，李白、杜甫刚去世不久，就有人对这两位诗人的作品妄加诋毁，韩愈对此很不满意，就写给好友《调张籍》一诗：“李杜文章在，光焰万丈长，不知群儿愚，那用故谤伤，蚍蜉撼大树，可笑不自量。”得到张籍的赞同"]},{"id":22643,"word":"擂天倒地","pinyin":"léi tiān dǎo dì","abbr":"ltdd","explanation":"呼天抢地，形容哭喊。","source":{"text":"江老夫妻女儿三口，杀猪也似的叫喊，擂天倒地价哭。","book":"明·凌濛初《二刻拍案惊奇》卷十五"},"example":{"text":"才出城门，只听得草地里有小儿啼哭之声，急往前一看，只是一个小儿眠在草里，～价哭。","book":"明·凌濛初《二刻拍案惊奇》卷三十八"},"similar":["呼天唤地"],"usage":"作谓语、状语；指哭叫"},{"id":22644,"word":"擂鼓筛锣","pinyin":"léi gǔ shāi luó","abbr":"lgsl","explanation":"擂鼓：急击鼓。筛锣：敲锣。敲锣打鼓。形容大声吵闹。也比喻竭力把事情夸大。","source":{"text":"抬头觑是个钟楼模样，往下觑却是人旋窝。见几个妇女向台儿上坐，又不是迎神赛社，不住的擂鼓筛锣。","book":"元·杜仁杰《耍孩儿·庄家不识构阑》曲"},"example":{"text":"前门里你出不去！那些大小妖精，都在门外摇旗呐喊，～，助着大王，与你徒弟厮杀哩。","book":"明·吴承恩《西游记》第二十九回"},"similar":["筛锣擂鼓"],"usage":"作谓语；指虚张声势"},{"id":22645,"word":"擂鼓鸣金","pinyin":"léi gǔ míng jīn","abbr":"lgmj","explanation":"金：指锣。指战场上击鼓打锣，以壮声势。","source":{"text":"我今日传了将令，则要您记的叮咛：也不许摇旗呐喊，也不许擂鼓鸣金。","book":"元·无名氏《午时牌》第二折"},"example":{"text":"次日，四更造饭，五更结束已定，早听得水寨中～。","book":"明·罗贯中《三国演义》第四十八回"},"similar":["擂鼓筛锣"],"usage":"作谓语、宾语；指战场上击鼓打锣"},{"id":22646,"word":"擅作威福","pinyin":"shàn zuò wēi fú","abbr":"szwf","explanation":"擅：自作主张。滥用职权，作威作福。","source":{"text":"又达等数以憎爱擅作威福，宜检治之。","book":"《三国志·魏志·高柔传》"},"example":{"text":"方今汉朝献帝在位，被那董卓专权，～，生杀由己。","book":"元·无名氏《连环计》第一折"},"similar":["作威作福"],"usage":"作谓语；指滥用职权"},{"id":22647,"word":"擅壑专丘","pinyin":"shàn hè zhuān qiū","abbr":"shzq","explanation":"指放情山水。"},{"id":22648,"word":"擅离职守","pinyin":"shàn lí zhí shǒu","abbr":"slzs","explanation":"擅：随意，任意。指未经许可即离开自己的工伤岗位。","source":{"text":"见面之后，不由分说，拿随大爷一把辫子，说他擅离职守，捏称回任，定要扭他到堂翁跟前，请堂翁禀明太尊。","book":"清·李宝嘉《官场现形记》第四十四回"},"opposite":["忠于职守"],"usage":"作谓语；指不尽责"},{"id":22649,"word":"擅自为谋","pinyin":"shàn zì wéi móu","abbr":"szwm","explanation":"擅自：自作主张；谋：打算。超越权限而自作主张地进行谋划。"},{"id":22650,"word":"擅行不顾","pinyin":"shàn xíng bù gù","abbr":"sxbg","explanation":"形容独断专行，不顾一切。","source":{"text":"今太后擅行不顾，穰侯出使不报，华阳、泾阳等击断无讳，高陵进退不请。四贵备而国不危者，未之有也。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"今太后恃国母之尊，～者四十余年。","book":"明·冯梦龙《东周列国志》第九十七回"}},{"id":22651,"word":"操之过切","pinyin":"cāo zhī guò qiè","abbr":"czgq","explanation":"指处事过于急切。","source":{"text":"我个人看来，目前的民主运动的确战斗性不够，也许有些老辈人认为操之过切，反而不好。","book":"闻一多《论文艺的民主问题》"},"similar":["操之过急","操切从事"],"usage":"作谓语、宾语；用于劝诫别人不要鲁莽"},{"id":22652,"word":"操之过急","pinyin":"cāo zhī guò jí","abbr":"czgj","explanation":"操：做，从事。处理事情，解决问题过于急躁。","source":{"text":"遂要崤阸，以败秦师，匹马觭轮无反者，操之急也。","book":"《汉书·五行志中之下》"},"example":{"text":"杨嗣昌和高起潜都没生气，劝他不要～，对作战方略要慢慢详议。","book":"姚雪垠《李自成》第一卷第二章"},"similar":["急于求成","急功近利"],"opposite":["处之泰然","措置裕如"],"usage":"作谓语、宾语；用于劝诫别人不要鲁莽"},{"id":22653,"word":"操之过激","pinyin":"cāo zhī guò jī","abbr":"czgj","explanation":"指处事过于激烈。","source":{"text":"鄂督瑞澂操之过激，捕杀民党无虚日。","book":"文公直《辛亥革命运动中这新军》"},"example":{"text":"日本于此，颇惧～，招列强之反感。","book":"李大钊《国民与薪胆》"},"similar":["操之过急"],"usage":"作谓语、宾语；用于劝诫别人不要鲁莽"},{"id":22654,"word":"操之过蹙","pinyin":"cāo zhī guò cù","abbr":"czgc","explanation":"犹言操之过急。指处理事情，解决问题过于急躁。","source":{"text":"扞齐人伐山戎呴，此齐侯也，其称人何？贬。曷为贬？子司马子曰：‘盖以操之为已蹙矣！’","book":"语出《公羊传·庄公三十年》"},"example":{"text":"若中路封关，～，而东西各路得以偷贩出洋，则正税徒亏，而漏卮依然莫塞。","book":"清·林则徐《复奏曾望颜条陈封关禁海事宜折》"},"similar":["操之过急","操之过激"],"usage":"作谓语、宾语；用于劝诫别人不要鲁莽"},{"id":22655,"word":"操其奇赢","pinyin":"chao qi ji ying","abbr":"cqqy","explanation":"操纵市场上货物奇缺以及过剩情况，以获暴利。"},{"id":22656,"word":"操刀不割","pinyin":"cāo dāo bù gē","abbr":"cdbg","explanation":"操：操持，拿着。手里拿着刀而不割东西。比喻做事不及时，坐失良机。","source":{"text":"操刀不割。","book":"《资治通鉴·汉纪·文帝六年》"}},{"id":22657,"word":"操刀伤锦","pinyin":"cāo dāo shāng jǐn","abbr":"cdsj","explanation":"操刀和割锦本不是一回事，后人并而为一，比喻才能太低，不能胜任责任重大的事情。","source":{"text":"今吾子爱人则以政，犹未能操刀而使割也，其伤实多。子之爱人，伤之而已，其谁敢求爱于子？","book":"春秋·鲁·左丘明《左传·襄公三十一年》"},"example":{"text":"常恐执辔轻轮，～。","book":"北朝·后魏·温子昇《为西河王谢太尉表》"},"similar":["操刀制锦"],"usage":"作谓语；指不谙政事而出任官职"},{"id":22658,"word":"操刀制锦","pinyin":"cāo dāo zhì jǐn","abbr":"cdzj","explanation":"比喻出仕从政。","source":{"text":"实谓枢机八座，上下三阶，岂惟缚柱鞭丝，操刀制锦。","book":"唐·杨炯《益州温江县令任君神道碑》"},"example":{"text":"操刀之能制锦，素显殊勋；弹琴之不下堂，行闻异政。","book":"宋·王安石《贺知县启》"},"similar":["操刀伤锦"],"usage":"作谓语；指出任官职"},{"id":22659,"word":"操刀必割","pinyin":"cāo dāo bì gē","abbr":"cdbg","explanation":"操：持。手里拿着刀，一定要割物。比喻办事必须及时。","source":{"text":"日中必彗，操刀必割，执斧必伐。日中不彗，是谓失时；操刀不割，失利之期；执斧不伐，贼人将来。","book":"《六韬·守土》"},"example":{"text":"日中必熭，～。","book":"汉·贾谊《新书·宗首》"},"similar":["当机立断"],"opposite":["操刀不割","犹豫不决"],"usage":"作谓语；比喻办事果断"},{"id":22660,"word":"操切从事","pinyin":"cāo qiē cóng shì","abbr":"cqcs","explanation":"操：做。处理事情或解决问题过于急躁。","source":{"text":"第一须用上些水磨功夫，叫他们潜移默化，断不可操切从事。","book":"清·李宝嘉《文明小史》第一回"},"similar":["操之过切"],"usage":"作谓语、宾语；用于劝诫别人不要鲁莽"},{"id":22661,"word":"操券而取","pinyin":"cāo quàn ér qǔ","abbr":"cqeq","explanation":"执持契券，凭证在手。比喻事成有把握。","source":{"text":"明朝制艺，确有分两，作文与阅者皆可操券而取。","book":"清·李调元《制义科琐记·元可操券》"}},{"id":22662,"word":"操奇计赢","pinyin":"cāo qí jì yíng","abbr":"cqjy","explanation":"奇：奇货；赢：盈利。掌握难得的货物，计算盈利。形容商人囤积货物，谋取厚利。","source":{"text":"而商贾大者积贮倍息，小者坐列贩卖，操其奇赢，日游都市。","book":"汉·鼌错《论贵粟疏》"},"example":{"text":"虽闭关绝市，裹商人之足焉可也，又安得夫～，以成轻重之势者哉！（清·章炳麟《读管子书后》）"},"similar":["操奇逐嬴","囤积居奇"],"opposite":["薄利多销"],"usage":"作谓语；指商人囤积断缺物资而牟利"},{"id":22663,"word":"操奇逐赢","pinyin":"cāo qì zhù yíng","abbr":"cqzy","explanation":"指商贾居奇牟利。","source":{"text":"奇赢，谓有馀财而蓄聚奇异之物也。","book":"语出《汉书·食货志上》：“商贾大者积贮倍息，小者坐列贩卖，操其奇赢。”颜师古注"},"example":{"text":"使豁然于～之故，而后分者可合，散者可聚。","book":"郑观应《盛世危言·商务三》"},"similar":["操奇计赢","操赢致奇"],"usage":"作谓语、定语、宾语；用于商业等"},{"id":22664,"word":"操履无玷","pinyin":"cāo lǚ wú diàn","abbr":"clwd","explanation":"操履：操行；玷：白玉上的污点。操守洁白，没有一点污点。","source":{"text":"洁操履之拘苦者，所以全拔萃之业。","book":"《抱朴子·博喻》"},"example":{"text":"太宗尝谓宰相曰：“微之～，儒雅士也。”","book":"明·彭大翼《山堂肆考·史官》"}},{"id":22665,"word":"操必胜之券","pinyin":"cāo bì shèng zhī quàn","abbr":"cbszq","explanation":"操：持有；券：凭证。手里拿着兑现的凭证。比喻所办的事情有必定成功的把握。","source":{"text":"故明主操必胜之数，以治必用之民。","book":"春秋·齐·管仲《管子·明法解》"},"similar":["稳操胜券"],"usage":"作谓语、定语；用于处事"},{"id":22666,"word":"操戈入室","pinyin":"cāo gē rù shì","abbr":"cgrs","explanation":"比喻深入了解对方，找出其纰漏，又以对方的论点来批驳对方。","source":{"text":"论者以柳操戈入室，弗察者又群然和之。然则文之工者，伤理倍道，皆弗论乎！","book":"明·胡应麟《少室山房笔丛·史书佔毕一》"},"example":{"text":"本为小人之交，岂能责以君子之道，～，理所必然。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录四》"},"similar":["操矛入室","入室操戈"],"usage":"作谓语、定语；用于言辞、学问等","story":["东汉时期，郑玄从师于孔融，深受孔融的喜爱，夸他能真正带走他的学问。郑玄征对学者何休的《公羊墨守》、《左氏膏肓》等文章写《墨守》、《废疾》来发表自己的意见，击中要害。何休看后感叹地说：“郑玄进了我的屋子操起我的矛来讨伐我！”"]},{"id":22667,"word":"操戈同室","pinyin":"cāo gē tóon shì","abbr":"cgts","explanation":"指兄弟相残或内部纷争。","source":{"text":"以满人窃位之私心，开汉族仇杀之惨祸，操戈同室，贻笑外人。","book":"孙中山《大总统劝告北军将士书》"},"similar":["同室操戈","兄弟阋墙"],"usage":"作谓语、宾语；指内部斗争"},{"id":22668,"word":"操揉磨治","pinyin":"cāo róu mó zhì","abbr":"crmz","explanation":"犹言反复磨练。"},{"id":22669,"word":"操斧伐柯","pinyin":"cāo fù fá kē","abbr":"cffk","explanation":"执斧砍伐斧柄。比喻可就近取法。","source":{"text":"柯，斧柄。则，法也……言人执柯伐木以为柯者，彼柯长短之法，在此柯耳。","book":"语出《诗·豳风·伐柯》：“伐柯伐柯，其则不远。”《中庸》引此文，朱熹集注"},"example":{"text":"至于～，虽取则不远，若夫随手之变，良难以辞逮。","book":"晋·陆机《文赋》"},"usage":"作宾语、定语；用于处事"},{"id":22670,"word":"操矛入室","pinyin":"cāo máo rù shì","abbr":"cmrs","explanation":"比喻深入了解对方，找出其纰漏，又以对方的论点来批驳对方。","source":{"text":"时任城何休好《公羊》学，遂著《公羊墨守》、《左氏膏肓》、《穀梁废疾》。玄乃发《墨守》，针《膏肓》，起《废疾》。休见而叹曰：‘康成入吾室，操吾矛以伐我乎！’","book":"语出《后汉书·郑玄传》"},"example":{"text":"淳熙初，都下禅讲尚多宿旧名人，师年少，～，援据古今，中其机要，咸相顾叹骇曰：‘信书厨，不可与争也！’”","book":"宋·叶適《题端信师帖》"},"similar":["操戈入室"],"usage":"作谓语、定语；用于言辞、学问等","story":["东汉时期，郑玄从师于孔融，深受孔融的喜爱，夸他能真正带走他的学问。郑玄征对学者何休的《公羊墨守》、《左氏膏肓》等文章写《墨守》、《废疾》来发表自己的意见，击中要害。何休看后感叹地说：“郑玄进了我的屋子操起我的矛来讨伐我！”"]},{"id":22671,"word":"操纵如意","pinyin":"cāo zòng rú yì","abbr":"czry","explanation":"如意：满意。形容十分自如地用不正当的手段对某事某人进行控制，处理。","source":{"text":"所以太阿下移，而忠贤辈得以操纵如意也。","book":"明·文秉《先拨志始》卷上"},"similar":["操纵自如"],"usage":"作谓语、宾语；用于使用不正当的手段"},{"id":22672,"word":"操纵自如","pinyin":"cāo zòng zì rú","abbr":"czzr","explanation":"掌握运用或驾驭得心应手，毫无阻碍。","source":{"text":"所以太阳下移，而忠贤辈得以操纵如意也。","book":"明·文秉《先拨志始》卷上"},"example":{"text":"他驾驶的情状亦有～之妙，不意今日遇见这么大的风浪，所以都毛了手脚。","book":"清·刘鹗《老残游记》"},"similar":["随心所欲","运用自如"],"usage":"作谓语、宾语；指能完全控制"},{"id":22673,"word":"操纵适宜","pinyin":"cāo zòng shì yí","abbr":"czsy","explanation":"操纵：原意指收与放，引申为掌握处理。对某事的掌握处理适度。多用天贬义，含把持的意思。","source":{"text":"顷又思夷情变态不常，在我处之，亦不宜定为一例，贵随机应变，操纵适宜可也。","book":"明·张居正《答宜府巡抚张崌崃言虏情》"},"similar":["操纵自如"],"usage":"作谓语、宾语；用于处事"},{"id":22674,"word":"操翰成章","pinyin":"cāo hàn chéng zhāng","abbr":"chcz","explanation":"翰：鸟毛，借指毛笔。拿起笔来就写成文章，形容文思敏捷，有文才。","source":{"text":"幹清玄体道，六行修备，聪识洽闻，操翰成章。","book":"《三国志·魏书·徐幹传》：“幹为司空军谋祭酒掾属，五官将文学。”裴松之注引《先贤行状》"},"similar":["下笔成文"],"opposite":["不识之无"],"usage":"作谓语；指文思敏捷"},{"id":22675,"word":"操觚染翰","pinyin":"cāo gū rǎn hàn","abbr":"cgrh","explanation":"觚，木简；翰，长而硬的鸟羽。指写作。","source":{"text":"松拜而更之，乃操觚染翰；表成，呈于王。","book":"宋·无名氏《灯下闲谈·梦与神交》"},"example":{"text":"～，骚客之所用心也；呻章吟句，童子之所业习也。","book":"明·张居正《翰林院读书说》"},"usage":"作谓语、宾语；用于写作等"},{"id":22676,"word":"操赢致奇","pinyin":"cāo yíng zhì qí","abbr":"cyzq","explanation":"指商贾居奇牟利。","source":{"text":"商贾，大者积贮信息，小者坐列贩卖，操其奇赢。","book":"东汉·班固《汉书·食货志》"},"example":{"text":"商人既能～，转输乎远方，以供中国，则市无不足矣。","book":"清·王韬《平贼议》"},"similar":["囤积居奇","操奇逐赢"],"usage":"作谓语、定语、宾语；用于商业等"},{"id":22677,"word":"操身行世","pinyin":"cāo shēn xíng shì","abbr":"csxs","explanation":"犹言立身处世。","source":{"text":"痛以礼义自绳约，既率己之顽惰，又以化顽惰者，使之知操身行世之大方，孝亲忠君之大节。","book":"明·方孝孺《与卢编修希鲁书》"},"similar":["立身处世"],"usage":"作主语、宾语；指人待人接物的态度"},{"id":22678,"word":"擎天一柱","pinyin":"qíng tiān yī zhù","abbr":"qtyz","explanation":"擎：托起。一根柱托住天。比喻人能担当天下重任。","source":{"text":"卿五山镇地，一柱擎天；气压乾坤，量含宇宙。","book":"唐·张固《独秀山》诗：“会得乾坤融结意，擎天一柱在南州。”《唐·大诏令集·赐陈敬瑄铁券文》"}},{"id":22679,"word":"擎天之柱","pinyin":"qíng tiān zhī zhù","abbr":"qtzz","explanation":"擎：向上托。能托住天空的大柱子。古代神话传说昆仑山有八柱擎天。后用以比喻能负担重任的人。","source":{"text":"擎天之柱著功勋，包罗大海佐明君。","book":"宋·张君房《云笈七签》卷一○三"},"example":{"text":"现在～，为何不用邪？","book":"明·罗贯中《三国演义》第八十三回"},"similar":["擎天柱","擎天玉柱"],"usage":"作主语、宾语；指肩负重任的人"},{"id":22680,"word":"擎天架海","pinyin":"qíng tiān jià hǎi","abbr":"qtjh","explanation":"擎天：支撑着天；架海：跨越过海。形容本领非凡。多用于担当国家重任的人和非常杰出的人才。","source":{"text":"你这个将军休左猜，俺可便专心等待，等待你个擎天架海栋梁材。","book":"元·陈以仁《存孝打虎》第一折"},"example":{"text":"贤弟有～之才，四海孰不钦敬！","book":"明·罗贯中《三国演义》第三回"},"similar":["擎天驾海","架海擎天"],"usage":"作谓语、定语；用于人的能力"},{"id":22681,"word":"擎天柱","pinyin":"qíng tiān zhù","abbr":"qtz","explanation":"古代传说昆仑山有八根柱子支撑着天。比喻担负重任的人。","source":{"text":"只见两条红标注，恰与坊巷牌额一般相似，上立一面粉牌，写道：‘太原相扑擎天柱任原’。","book":"明·施耐庵《水浒传》第74回"},"usage":"作宾语、定语；多用于比喻句"},{"id":22682,"word":"擎天玉柱","pinyin":"qíng tiān yù zhù","abbr":"qtyz","explanation":"支撑天的柱子。比喻担负重任的人。","source":{"text":"敝省有一位参戎，叫林士豪，文武全才，也算一根擎天玉柱。","book":"清·夏敬渠《野叟曝言》第52回"},"example":{"text":"清·夏敬渠《野叟曝言》第52回：“敝省有一位参戎，叫林士豪，文武全才，也算一根～。”"},"similar":["擎天之柱"],"usage":"作主语、宾语；指肩负重任的人"},{"id":22683,"word":"擎天驾海","pinyin":"qíng tiān jià hǎi","abbr":"qtjh","explanation":"擎天：支撑上天。形容本领大，能力非凡。","source":{"text":"陛下，你便似砍折条擎天驾海紫金梁。","book":"元·孔文卿《东床事犯》第一折"},"similar":["檠天架海","擎天架海"],"usage":"作谓语、定语；用于人的能力"},{"id":22684,"word":"擎苍牵黄","pinyin":"qíng cāng qiān huáng","abbr":"qcqh","explanation":"擎：举；苍：指苍鹰；黄：黄犬，指猎狗。形容带着鹰和犬出猎时的姿态。","source":{"text":"老夫聊发少年狂，左牵黄，右擎苍，锦帽貂裘，千骑卷平冈。","book":"宋·苏轼《江城子·密州出猎》词"},"example":{"text":"纺及之《骑射图》，～，挽强驰驱，笔力豪逸极妙。","book":"宋·赵佶《宣和画谱·畜兽二·张及之》"}},{"id":22685,"word":"擐甲执兵","pinyin":"huàn jiǎ zhí bīng","abbr":"hjzb","explanation":"擐：穿；兵：武器。身披铠甲，手拿武器。指准备战斗。","source":{"text":"擐甲执兵，固即死也；病未及死，吾子勉之。","book":"《左传·成公二年》"},"example":{"text":"～，人之重任，赏信而速，所以劝功。","book":"宋·曾巩《李德明遥郡团练使制》"},"similar":["擐甲披袍"],"usage":"作谓语、定语；用于战争等"},{"id":22686,"word":"擐甲执锐","pinyin":"huàn jiǎ zhí ruì","abbr":"hjzr","explanation":"擐：穿；锐：兵器。身披铠甲，手拿武器。指准备战斗。","source":{"text":"擐甲执兵，固即死也；病未及死，吾子勉之。","book":"《左传·成公二年》"},"example":{"text":"豹三十四岁挂印。母尝从之南征，每临巨敌，辄～，为子接应。","book":"清·蒲松龄《聊斋志异·夜叉国》"}},{"id":22687,"word":"擐甲披袍","pinyin":"huàn jiǎ pī páo","abbr":"hjpp","explanation":"擐：套；披：穿。套上铠甲，穿上战袍。指做好战斗准备。","source":{"text":"有英雄虎将，开弓蹬弩，擐甲披袍。","book":"元·无名氏《破天阵》第三折"},"example":{"text":"～大丈夫，英雄敢勇有谁知。","book":"明·无名氏《万国来朝》第三折"},"similar":["擐甲执兵"],"usage":"作谓语、定语；用于战争等"},{"id":22688,"word":"擐甲挥戈","pinyin":"huàn jiǎ huī gē","abbr":"hjhg","explanation":"擐：穿，套。穿上铠甲，手拿武器。形容全副武装的样子。","source":{"text":"擐甲挥戈，单骑先入，唯有军主蔡三虎副之，余人无有及者。","book":"《魏书·傅永传》"},"similar":["擐甲执兵"],"usage":"作谓语、定语；用于战争等"},{"id":22689,"word":"擐甲操戈","pinyin":"huàn jiǎ cāo gē","abbr":"hjcg","explanation":"擐：穿，套。穿上铠甲，手拿武器。形容全副武装的样子。","source":{"text":"擐甲挥戈，单骑先入，唯有军主蔡三虎副之，余人无有及者。","book":"《魏书·傅永传》"}},{"id":22690,"word":"擒奸摘伏","pinyin":"qín jiān tī fú","abbr":"qjzf","explanation":"擒获暴露的坏人，揭露隐藏着的歹徒。","source":{"text":"擒奸摘伏，抚弱遏强，井邑肃然。","book":"《续古文苑·无名氏》"},"similar":["擒奸擿伏"],"usage":"作谓语、定语；指惩治坏人"},{"id":22691,"word":"擒奸擿伏","pinyin":"qín jiān tī fú","abbr":"qjtf","explanation":"擿：揭发。捉拿暴露的坏人，揭发隐伏的歹徒。","source":{"text":"无名历官所在，擒奸擿伏有名。每偷，至无名前，无得过者。","book":"《太平广记》卷一七一引《纪闻·苏无名》"},"example":{"text":"～抚弱遏强，井邑肃然。","book":"《续古文苑·无名氏〈唐莫州唐兴军都虞候兼押衙试鸿胪卿郑府君墓志铭〉》"},"similar":["擒奸摘伏"],"usage":"作谓语、定语；指惩治坏人"},{"id":22692,"word":"擒奸讨暴","pinyin":"qín jiān tǎo bào","abbr":"qjtb","explanation":"奸、暴：指坏人和豪强。捉拿、制服坏人与豪强。","source":{"text":"卿在郡以来，擒奸讨暴，百姓获安。","book":"汉·曹操《褒扬泰山友谊赛吕虔令》"},"similar":["锄奸惩暴"],"usage":"作谓语、定语；指讨伐坏人"},{"id":22693,"word":"擒纵自如","pinyin":"qín zòng zì rú","abbr":"qzzr","explanation":"擒：捉住；纵：放。捕捉、释放都随心所欲。比喻完全控制了局势。","source":{"text":"亮笑，纵使更战，七纵七擒，而亮犹遣获。","book":"《三国志·蜀志·诸葛亮传》：“亮率众南征，其秋悉平。”裴松之注引《汉晋春秋》"}},{"id":22694,"word":"擒虎拿蛟","pinyin":"qín hǔ ná jiāo","abbr":"qhnj","explanation":"擒捉猛虎和蛟龙。比喻制服战胜强敌。","source":{"text":"准备擒虎拿蛟计，银山铁壁撞将来。","book":"元·无名氏《暗度陈仓》第二折"},"similar":["降龙伏虎","擒龙缚虎"],"usage":"作谓语、宾语、定语；用于人的本事"},{"id":22695,"word":"擒贼先擒王","pinyin":"qín zéi xiān qín wáng","abbr":"qzxqw","explanation":"指作战要先抓主要敌手。也比喻做事首先要抓关键。","source":{"text":"射人先射马，擒贼先擒王。","book":"唐·杜甫《前出塞》诗之六"},"example":{"text":"～，把主使人拿住，学生自然就老实了。","book":"老舍《且说屋里》"},"similar":["擒贼擒王"],"usage":"作宾语、定语、分句；比喻做事先要抓关键"},{"id":22696,"word":"擒贼擒王","pinyin":"qín zéi qín wáng","abbr":"qzqw","explanation":"擒：抓，捉。指作战要先抓主要敌手。比喻作事要抓住要害。","source":{"text":"射人先射马，擒贼先擒王。","book":"唐·杜甫《前出塞》诗之六"},"example":{"text":"所谓～，这就是办事的诀窍。","book":"清·李宝嘉《文明小史》第四十四回"},"similar":["擒贼先擒王"],"usage":"作谓语、定语；比喻做事先要抓关键"},{"id":22697,"word":"擒龙捉虎","pinyin":"qín lóng zhuō hǔ","abbr":"qlzh","explanation":"擒住老虎捉拿蛟龙。比喻降伏强敌，本领高强。","source":{"text":"要图定国安邦计，预备擒龙捉虎人。","book":"清·钱彩《说岳全传》第17回"},"example":{"text":"清·钱彩《说岳全传》第17回：“要图定国安邦计，预备～人。”"},"similar":["擒龙缚虎"],"usage":"作谓语、宾语、定语；用于人的本事"},{"id":22698,"word":"擒龙缚虎","pinyin":"qín lóng fù hǔ","abbr":"qlfh","explanation":"捉拿蛟龙，缚住猛虎。比喻制服战胜强敌。","source":{"text":"准备擒虎拿蛟计，银山铁壁撞将来。","book":"元·无名氏《暗度陈仓》第二折"},"example":{"text":"定下～万全计，看他遭罗网怎生避。","book":"明·沈璟《义侠记·秘计》"},"similar":["擒虎拿蛟","擒龙捉虎"],"usage":"作谓语、宾语、定语；用于人的本事"},{"id":22699,"word":"擗踊号叫","pinyin":"pǐ yǒng háo jiào","abbr":"pyhj","explanation":"擗：以手拍击胸膛；踊：用脚顿地。捶着胸跺着脚大哭。形容极度哀伤地痛哭。","source":{"text":"七岁遭母忧，擗踊号叫，哀感旁邻。","book":"《晋书·刘元海载记》"},"similar":["擗踊号呼","擗踊哭泣","辟踊哭泣"],"usage":"作谓语、宾语；用于悲伤时"},{"id":22700,"word":"擗踊号呼","pinyin":"pǐ yǒng háo hū","abbr":"pyhh","explanation":"擗：以手拍击胸脯；踊：以足顿地；号：痛哭。拍胸跺脚，哀痛号哭。旧时多形容父母去世时子女的哀哭。","source":{"text":"衰绖菅屦，辟踊哭泣，所以谕哀也。","book":"《淮南子·主术训》"},"example":{"text":"先生～，几绝者数矣。","book":"清·汪琬《诰封陈母张淑人墓志铭》"},"similar":["擗踊号叫","擗踊哭泣"],"usage":"作谓语、宾语；用于悲伤时"},{"id":22701,"word":"擗踊哀号","pinyin":"pǐ yǒng āi háo","abbr":"pyah","explanation":"擗：以手拍击胸膛；踊：用脚顿地。捶着胸跺着脚大哭。形容极度哀伤地痛哭。","source":{"text":"衰绖菅屦，辟踊哭泣，所以谕哀也。","book":"《淮南子·主术训》"},"example":{"text":"王冕～，哭得那邻舍之人，无不落泪。","book":"清·吴敬梓《儒林外史》第一回"},"similar":["擗踊哭泣"],"usage":"作谓语、宾语；用于悲伤时"},{"id":22702,"word":"擗踊哭泣","pinyin":"pǐ yǒng kū qì","abbr":"pykq","explanation":"擗：以手拍击胸膛；踊：用脚顿地。捶着胸跺着脚大哭。形容极度哀伤地痛哭。","source":{"text":"擗踊哭泣，哀以送之。","book":"《孝经·丧亲》"},"example":{"text":"力士母表氏卒，百献被发受吊，～；过于己亲。","book":"宋·孔平仲《续世说·邪谄》"},"similar":["擗踊哀号","擗踊号呼","擗踊号叫"],"usage":"作谓语、宾语；用于悲伤时"},{"id":22703,"word":"擗踊拊心","pinyin":"pǐ yǒng fǔ xīn","abbr":"pyfx","explanation":"擗：以手拍击胸脯；踊：以足顿地；拊：敲击。指捶胸顿足，打击心口，尽情悲哀。","source":{"text":"四海伤怀，擗踊拊心，若丧考妣。","book":"《孝经·丧亲》：“擗踊哭泣，哀以送之。”汉国。　扬雄《元后诔》"},"similar":["擗踊哀号"],"usage":"作谓语、定语、状语；用于书面语"},{"id":22704,"word":"擘两分星","pinyin":"bó liǎng fēn xīng","abbr":"blfx","explanation":"指很小的重量都分辨得清清楚楚。比喻准确清楚。两，较小的重量单位；星，秤杆上标记斤两的小点子。","source":{"text":"只我问他个擘两分星，说一段从头的至尾。","book":"元·李寿卿《伍员吹箫》第三折"},"similar":["斤斤计较"],"usage":"作谓语、定语；指分得很清"},{"id":22705,"word":"擘肌分理","pinyin":"bò jī fēn lǐ","abbr":"bjfl","explanation":"擘：分开；理：肌肤的纹理。比喻分析事理十分细致。","source":{"text":"剖析毫厘，擘肌分理。","book":"汉·张衡《西京赋》"},"example":{"text":"同之与异，不屑古今；～，唯务折衷。","book":"南朝·梁·刘勰《文心雕龙·序志》"},"similar":["条理清晰","有条不紊"],"usage":"作谓语；形容分析思路清晰"},{"id":22706,"word":"擢发抽肠","pinyin":"zhuó fà chō cháng","abbr":"zfcc","explanation":"擢：拔。拔下头发，抽出肚肠。形容自引罪责，表示悔恨，以求宽恕。","source":{"text":"岂有人臣奉如此之诏而不亡魂破胆，归罪有司，擢发抽肠，少自论谢？","book":"《梁书·伏暅传》"},"usage":"作谓语、定语；用于书面语"},{"id":22707,"word":"擢发莫数","pinyin":"zhuó fà mò shǔ","abbr":"zfms","explanation":"擢：拔；莫：不能。拔下全部头发，也难以数清。形容罪行多得数不清。","source":{"text":"擢贾之发以续贾之罪，尚未足。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"方尚乃口穷之时，盖～其罪。","book":"宋·苏轼《到惠州谢表》"},"similar":["擢发难数"],"usage":"作谓语、宾语、定语；指数量多"},{"id":22708,"word":"擢发难数","pinyin":"zhuó fà nán shǔ","abbr":"zfns","explanation":"擢：拔。拔下全部头发，难以数清。形容罪行多得数不清。","source":{"text":"擢贾之发以续贾之罪，尚未足。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"可死之罪，～。","book":"清·蒲松龄《聊斋志异·续黄梁》"},"similar":["罄竹难书","数不胜数","不胜枚举"],"opposite":["微不足道","屈指可数","微乎其微"],"usage":"作谓语、宾语、定语；指数量多","story":["战国时期，魏国大夫须贾门客范雎跟随须贾出访齐国，受到齐襄王的称赞。须贾回国后告诉相国魏齐，魏齐要杀范雎。范雎大难不死，逃到秦国改名张禄当上相国，须贾到秦国求秦不要攻魏，须贾向张禄忏悔说自己的罪太多，擢发难数"]},{"id":22709,"word":"擢筋剥肤","pinyin":"zhuó jīn bō fū","abbr":"zjbf","explanation":"抽筋剥皮。比喻剥削深重残酷。","source":{"text":"吾之民反戚戚不乐，常若擢筋剥肤以供亿其上。","book":"宋·苏洵《田制》"},"similar":["擢筋割骨"],"usage":"作宾语、定语；用于比喻句"},{"id":22710,"word":"擢筋割骨","pinyin":"zhuó jīn gē gǔ","abbr":"zjgg","explanation":"犹言擢筋剥肤。","source":{"text":"自近岁以来，蜀人不知有勤恤之，如擢筋割骨以奉其上，而不免于刑罚。","book":"宋·苏轼《上知府王龙图书》"},"similar":["擢筋剥肤"],"usage":"作宾语、定语；用于比喻句"},{"id":22711,"word":"擦亮眼睛","pinyin":"cā liàng yǎn jīng","abbr":"clyj","explanation":"保持高度的警觉，不被蒙骗。","example":{"text":"我们必须要～，防止敌人乘机破坏。"},"opposite":["睁只眼，闭只眼"],"usage":"作谓语、定语、宾语；用于处事"},{"id":22712,"word":"擦屁股","pinyin":"cā pì gǔ","abbr":"cpg","explanation":"比喻收拾烂摊子。","example":{"text":"你不要留下一个烂摊子让我来～。"},"usage":"作谓语、定语、状语；多用于口语"},{"id":22713,"word":"擦拳抹掌","pinyin":"cā quán mò zhǎng","abbr":"cqmz","explanation":"形容战斗或劳动之前，人们精神振奋，跃跃欲试的样子。同“摩拳擦掌”。","source":{"text":"场外那一起报喜的，一个个擦拳抹掌的，都在那里盼里头的信。","book":"清·文康《儿女英雄传》第35回"},"example":{"text":"你这样～也无济于事。"},"similar":["擦拳磨掌"],"usage":"作谓语、定语；指准备动手干某事"},{"id":22714,"word":"擦拳磨掌","pinyin":"cā quán mó zhǎng","abbr":"cqmz","explanation":"形容准备动武，准备动手干或焦灼不安的样子。","source":{"text":"一个个擦拳磨掌，吊胆提心的。","book":"《儿女英雄传》第二五回"},"example":{"text":"他说话时卷起袖子～，好像要和谁打架似的。","book":"巴金《死去的太阳》四"},"similar":["擦掌磨拳","擦拳抹掌"],"usage":"作谓语、定语；指准备动手干某事"},{"id":22715,"word":"擦掌磨拳","pinyin":"cā zhǎng mó quán","abbr":"czmq","explanation":"形容准备动武，准备动手干或焦灼不安的样子。","source":{"text":"那大圣护了唐僧……见八戒与那怪交战，就恨得咬牙切齿，擦掌磨拳，忍不住要去打他。","book":"《西游记》第二二回"},"example":{"text":"俞实夫猛然地站起来，寿美子～地要奔出去，静子拉住了她。","book":"夏衍《法西斯细菌》第二幕"},"similar":["擦拳磨掌","擦拳抹掌"],"usage":"作谓语、定语；指准备动手干某事"},{"id":22716,"word":"擦肩而过","pinyin":"cā jiān ér guò","abbr":"cjeg","explanation":"擦：挨。挨着肩而溜走。指没有抓住机会。","source":{"text":"后来彼此又擦肩而过。","book":"清·李宝嘉《官场现形记》第32回"},"example":{"text":"‘没干嘛，出去了一趟。’贾玲淡淡地应了一声，和我们～。","book":"王朔《过把瘾就死》"},"similar":["当面错过"],"usage":"作谓语、定语；多借指机会等"},{"id":22717,"word":"擦脂抹粉","pinyin":"cā zhī mǒ fěn","abbr":"czmf","explanation":"犹言涂脂抹粉。","source":{"text":"原来这海马周三，名叫周得胜，便是那年被十三妹姑娘刀断钢鞭，打倒在地，要给他擦脂抹粉，然后饶他性命，立了罚约的那个人。","book":"《儿女英雄传》第二一回"},"example":{"text":"花枝招展，～的太太小姐，在洋广杂货店穿进穿出。","book":"《中国民间故事选·打绥定》"},"similar":["涂脂抹粉","浓妆艳抹"],"usage":"作谓语、定语；指化装打扮"},{"id":22718,"word":"擦边球","pinyin":"cā biān qiú","abbr":"cbq","explanation":"擦过边缘的球。比喻刚刚满足条件的事物。","example":{"text":"我们要吃透政策，多打～。"},"usage":"作宾语、定语；多用于比喻句"},{"id":22719,"word":"擿伏发奸","pinyin":"tī fú fā jiān","abbr":"tffj","explanation":"揭露检举坏人和隐藏的坏事。"},{"id":22720,"word":"擿伏发隐","pinyin":"tī fú fā yǐn","abbr":"tffy","explanation":"擿：揭露。伏：隐藏。发：揭发。隐：隐蔽。揭露检举坏人和隐藏的坏事。亦作“擿奸发伏”、“擿伏发奸”。","source":{"text":"或治身清白，或擿奸发伏，咸为良二千石。","book":"《汉书·赵广汉传》：“其发奸擿伏如神，皆此类也。”《三国志·魏志·仓慈传》"},"example":{"text":"莅任之手，～，不畏豪横，不上半年，治得县中奸宄敛迹，盗贼潜踪，人民悦服。","book":"明·冯梦龙《醒世恒言》卷三十九"},"usage":"作谓语、定语；用于处事"},{"id":22721,"word":"擿埴冥行","pinyin":"zhì zhí míng xíng","abbr":"tzmx","explanation":"擿埴：敲地。指盲人用杖点地探求道路。比喻暗中摸索，事不易成","source":{"text":"岂日本语通儒其材力必不汉人若？正由素未识字，故擿埴冥行如此也。","book":"章炳麟《论汉字统一会》"},"similar":["擿埴索涂"],"usage":"作谓语、宾语；指暗中摸索"},{"id":22722,"word":"擿埴索涂","pinyin":"zhì zhí suǒ tú","abbr":"zzst","explanation":"擿埴：敲地；索：探求；涂：道路。指盲人用杖点地探求道路。比喻暗中摸索，事不易成。","source":{"text":"擿埴索涂，冥行而已矣。","book":"汉·扬雄《法言·修身》"},"example":{"text":"近时杂志之作者亦伙矣，姱词以为美，嚣听而无所终，～，不获则反复其词而自惑。","book":"孙中山《民报发刊词》"},"similar":["擿埴冥行","摘埴索涂","擿植索涂"],"usage":"作谓语、宾语；指暗中摸索"},{"id":22723,"word":"擿埴索途","pinyin":"zhāi zhí suǒ tú","abbr":"zzst","explanation":"指盲人以杖点地摸索道路。常喻暗中求索。同“擿埴索涂”。","source":{"text":"钧曰：‘水之患，天数也。’按行者驾轻舟于汪洋之陂，视之茫然，犹擿埴索途，以为不可治也。","book":"《苏轼集·录单锷吴中水利书》"}},{"id":22724,"word":"擿奸发伏","pinyin":"tī jiān fā fú","abbr":"tjff","explanation":"揭露举发隐秘的奸人和坏事。","source":{"text":"自太祖迄于咸熙，魏郡太守陈国吴瓘、清河太守乐安任燠、京兆太守济北颜斐、弘农太守太原令狐邵、济南相鲁国孔乂，或哀矜折狱，或推诚惠爱，或治身清白，或擿奸发伏，咸为良二千石。","book":"《三国志·任苏杜郑仓传》"},"example":{"text":"孙元规知杭州，～，号为神明。","book":"宋·彭乘《墨客挥犀》卷九"},"similar":["摘奸发伏"],"usage":"作谓语、定语；用于书面语"},{"id":22725,"word":"擿抉细微","pinyin":"tī jué xì wēi","abbr":"tjxw","explanation":"擿抉：挑剔。挑剔细微小事，专指小毛病，","source":{"text":"伏闻诸典校擿抉细微，吹毛求疵，重案深诬，辄欲陷人，以成威福。","book":"《三国志·吴志·步骘传》"}},{"id":22726,"word":"擿植索涂","pinyin":"zhāi zhí suǒ tú","abbr":"zzst","explanation":"谓盲人以杖点地摸索道路。常喻暗中求索。同“擿埴索涂”。","source":{"text":"方蒙袂辑履，有愤于黔娄，擿植索涂，见称于扬子，差不同耳。","book":"唐·段成式《西阳杂俎续集·支诺皋上》"},"similar":["擿埴索涂","摘埴索涂"],"usage":"作谓语、宾语；指暗中摸索"},{"id":22727,"word":"攀云追月","pinyin":"pān yún zhuī yuè","abbr":"pyzy","explanation":"攀：攀附。攀援青云而上天。比喻仕宦登进。","source":{"text":"我心何踊跃，思欲攀云追。","book":"三国·魏·曹植《苦思行》诗"},"usage":"作谓语、宾语；用于仕途"},{"id":22728,"word":"攀亲托熟","pinyin":"pān qīn tuō shú","abbr":"pqts","explanation":"认作亲戚朋友。","source":{"text":"他与那猪八戒当时寻到我的门前，讲甚么攀亲托热之言。","book":"明·吴承恩《西游记》第四十二回"},"similar":["攀亲道故"],"usage":"作谓语、宾语、定语；指拉关系"},{"id":22729,"word":"攀亲道故","pinyin":"pān qīn dào gù","abbr":"pqdg","explanation":"故：故旧，老朋友。拉亲戚论故交。指跟地位高的人拉关系。","example":{"text":"你这小子是刚出道的雏儿吗？我们在这里“剪径”，难道你以为我是要和你～么？","book":"梁羽生《风云雷电》第十五回"},"similar":["攀亲托熟"],"usage":"作谓语、宾语、定语；指拉关系"},{"id":22730,"word":"攀今吊古","pinyin":"pān jīn diào gǔ","abbr":"pjdg","explanation":"犹言谈今说古。从今到古无所不谈，无不评论。","source":{"text":"元·关汉卿《单刀会》第四折：“你这般攀今揽古，分甚枝叶。我要前使不着你之乎者也，诗云子曰。”更兼他腹中全无滴墨，纸上难成片语，偏好～，卖弄才学。 ★明·冯梦龙《醒世恒言》卷七"},"example":{"text":"更兼他腹中全无滴墨，纸上难成片语，偏好～，卖弄才学。","book":"明·冯梦龙《醒世恒言》卷七"},"similar":["攀今掉古"],"usage":"作谓语、宾语；用于书面语"},{"id":22731,"word":"攀今掉古","pinyin":"pān jīn diào gǔ","abbr":"pjdg","explanation":"从今到古无所不谈，无不评论。同“攀今吊古”。","source":{"text":"更兼他腹中全无滴墨，纸上难成片语，偏好攀今掉古，卖弄才学。","book":"《醒世恒言·钱秀才错占凤凰俦》"},"similar":["谈古论今","攀今吊古"],"usage":"作谓语、宾语；用于书面语"},{"id":22732,"word":"攀今揽古","pinyin":"pān jīn lǎn gǔ","abbr":"pjlg","explanation":"攀：攀谈；揽：扯说。指谈话的内容兼及古今。","source":{"text":"你这般攀今揽古，分甚枝叶。我要前使不着你之乎者也，诗云子曰。","book":"元·关汉卿《单刀会》第四折"},"similar":["攀今览古","攀今掉古"],"usage":"作谓语、宾语；用于说话或写作等"},{"id":22733,"word":"攀今比昔","pinyin":"pān jīn bǐ xī","abbr":"pjbx","explanation":"同今人或古人相比。","source":{"text":"你攀今比昔，那樊将军他殢把鸿门碎，关大王面赤非干醉，比周瑜饮醇醪量难及。","book":"明·汤显祖《南柯记·系帅》"},"usage":"作谓语；用于古今对比"},{"id":22734,"word":"攀今览古","pinyin":"pān jīn lǎn gǔ","abbr":"pjlg","explanation":"谈今说古。谈话的内容兼及古今。","source":{"text":"释卷挑灯，攀今览古。","book":"元·周文质《斗鹌鹑·咏小卿》套曲"},"similar":["攀今揽古"],"usage":"作谓语、宾语；用于说话或写作等"},{"id":22735,"word":"攀援桂枝","pinyin":"pān yuán guì zhī","abbr":"pygz","explanation":"旧指科举及第。","source":{"text":"攀援桂枝兮聊淹留。","book":"《楚辞·招隐士》"}},{"id":22736,"word":"攀炎附热","pinyin":"pān yán fù rè","abbr":"pyfr","explanation":"犹言趋炎附势。奉承和依附有权有势的人。"},{"id":22737,"word":"攀花折柳","pinyin":"pān huā zhé liǔ","abbr":"phsl","explanation":"花、柳：借指妓女。比喻男子狎妓。","source":{"text":"则为我攀花折柳，致令的有国难投。","book":"元·无名氏《百花亭》第二折"},"example":{"text":"他喜欢～，不干正经事。"},"similar":["眠花卧柳","攀花问柳"],"usage":"作谓语、宾语；指男子狎妓"},{"id":22738,"word":"攀花问柳","pinyin":"pān huā wèn liǔ","abbr":"phwl","explanation":"比喻狎妓。同“攀花折柳”。","source":{"text":"殷勤领命到荒山，心事未相关；攀花问柳，勾莺引燕，方寸心间。","book":"明·陆采《明珠记·写诏》"},"similar":["攀花折柳"],"usage":"作谓语、宾语；指男子狎妓"},{"id":22739,"word":"攀葛附藤","pinyin":"pān gě fù téng","abbr":"pgft","explanation":"攀：抓着东西向上爬；葛：多年生草本植物；附：靠着。比喻拉拢关系，趋附权势。","example":{"text":"安本意欲～，想靠王太后为护符，偏偏王太后告崩，无势可援。","book":"蔡东藩《前汉演义》第六十八回"}},{"id":22740,"word":"攀藤揽葛","pinyin":"pān téng lǎn gě","abbr":"ptlg","explanation":"攀：用手拉住他物向上爬；揽：指在胸前拉。手拉葛藤向上。形容在险峻的山路上攀登。","source":{"text":"峨嵋岭下，攀藤揽葛采樵人。","book":"元·无名氏《暗度陈仓》第三折"},"example":{"text":"～，上到庵前，推开门看时，是个泗洲大圣祠堂，面前只有个石香炉。","book":"明·施耐庵《水浒全传》第四十二回"},"similar":["攀藤附葛"],"usage":"作宾语、定语、状语；用于旅行等"},{"id":22741,"word":"攀藤附葛","pinyin":"pān téng fù gě","abbr":"ptfg","explanation":"攀附着藤葛前进。极言道路艰难。","source":{"text":"峨嵋岭下，攀藤揽葛采樵人。","book":"元·无名氏《暗度陈仓》第三折"},"example":{"text":"孔明～而到，见一石屋之中，塑一将军端坐，旁有石碑，乃汉伏波将军马援之庙。","book":"明·罗贯中《三国演义》第八十九回"},"similar":["攀藤揽葛"],"usage":"作宾语、定语、状语；用于旅行等"},{"id":22742,"word":"攀蟾折桂","pinyin":"pān chán zhé guì","abbr":"pcsg","explanation":"攀登蟾宫，折取月桂。比喻科举登第。","source":{"text":"休为那约雨期云龙氏女，送了个攀蟾折桂俊多才。","book":"元·马致远《荐福碑》第四折：“当日个废寝忘食，铸铁砚长分磨剑的水；到今日攀蟾折桂，步金价才觅着上天梯。”元·李好古《张生煮海》第二折"},"example":{"text":"则见他抄定～手。","book":"元·杨显之《潇湘雨》第一折"},"similar":["蟾宫折桂"],"usage":"作谓语、宾语、定语；指考试高中"},{"id":22743,"word":"攀车卧辙","pinyin":"pān chē wò zhé","abbr":"pcwz","explanation":"攀住车子，横卧车道。指百姓挽留清廉爱民的官吏。","source":{"text":"麾旆每反，行悲道泣，攀车卧辙之恋，争涂忘远；去思一借之情，愈久弥结。","book":"南朝·梁·沈约《齐故安陆昭王碑文》"},"example":{"text":"繁阳令以叔父忧去官，吏民～，不得去。","book":"宋·王楙《野客丛书·杨牧二子》"},"similar":["攀辕卧辙"],"usage":"作谓语、定语；指好官离任","story":["汉朝时期，侯霸做淮平大尹时，处理政事十分注重老百姓的利益，爱民如子。刘秀当上皇帝后，调侯霸当大司徒，派使者去请霸，老百姓纷纷扶老携幼号哭，挡住使者的车子，甚至有卧到车子底下不让他离开，都希望他能留在当地任官"]},{"id":22744,"word":"攀辕卧辙","pinyin":"pān yuán wò zhé","abbr":"pywz","explanation":"拉住车辕，躺在车道上，不让车走。旧时用作挽留好官的谀词。","source":{"text":"攀车卧辙之恋，争涂不忘。","book":"南朝梁·沈约《齐故安陆昭王碑》"},"example":{"text":"侯霸字君房，临淮太守，被征，百姓～不许去。","book":"唐·白居易《白氏六帖》卷二十一"},"similar":["攀车卧辙","扳辕卧辙"],"usage":"作谓语、定语；指好官离任"},{"id":22745,"word":"攀辕扣马","pinyin":"pān yuán kòu mǎ","abbr":"pykm","explanation":"攀：牵挽；扣：套住。拉住车辕牵住马匹。形容热情挽留，不肯放行。","source":{"text":"第五伦为会稽太守，为事征，百姓攀辕扣马呼曰：‘舍我何之？’","book":"《东观汉记》"},"usage":"作谓语、定语；指热情挽留"},{"id":22746,"word":"攀高接贵","pinyin":"pān gāo jiē guì","abbr":"pgjg","explanation":"攀附接近高中的人。","source":{"text":"不是我攀高接贵，由他每说短论长。","book":"元·李行道《灰阑记》第一折"},"example":{"text":"但他坐他的朝，我赶我的车，何必拉着皇帝叫姊夫，～呢。","book":"蔡东藩、许廑父《民国通俗演义》第四十回"},"similar":["攀高结贵"],"usage":"作谓语、定语、宾语；指巴结权贵"},{"id":22747,"word":"攀高枝儿","pinyin":"pān gāo zhī ér","abbr":"pgze","explanation":"指跟社会地位比自己高的人交朋友或结成亲戚。比喻人想往高处攀。","example":{"text":"她虚荣心强，好～。"},"similar":["巴高枝儿","攀龙附凤"],"usage":"作谓语、宾语、定语；指往高处攀"},{"id":22748,"word":"攀高结贵","pinyin":"pān gāo jié guì","abbr":"pgjg","explanation":"指攀附结交高贵的人。同“攀高接贵”。","source":{"text":"我死之后，你一满了服，就急急的要寻一头亲事，总要穷人家的儿女，万不可贪图富贵，攀高结贵。","book":"《儒林外史》第十七回"},"example":{"text":"这老小子，专爱～，是把拍马屁的好手！","book":"郭澄清《大刀记》第二章"},"similar":["巴高望上","攀高接贵"],"opposite":["刚正不阿"],"usage":"作谓语、宾语、定语；指依附权势"},{"id":22749,"word":"攀高谒贵","pinyin":"pān gāo yè guì","abbr":"pgyg","explanation":"攀：攀附；谒：进见。攀附结交地位高贵的人。","source":{"text":"嫁寒儒客店里孤栖，又著他攀高谒贵。","book":"明·汤显祖《牡丹亭·遇母》"},"similar":["攀高接贵"],"usage":"作谓语、定语、宾语；指巴结权贵"},{"id":22750,"word":"攀鳞附翼","pinyin":"pān lín fù yì","abbr":"plfy","explanation":"攀：攀援；附：依附。指巴结投靠有权势的人以获取富贵。","source":{"text":"攀龙鳞，附凤翼，巽以扬之，勃勃乎其不可及也。","book":"汉·扬雄《法言·渊骞》"},"example":{"text":"欣戴大弟，～。唯弟早膺图箓，以宁兆民，宗盟之长，属籍见容，复封于唐，斯荣足矣。","book":"蔡东藩《唐史演义》第三回"},"similar":["攀龙附凤"],"usage":"作谓语、定语、宾语；用于为人"},{"id":22751,"word":"攀龙托凤","pinyin":"pān lóng tuō fèng","abbr":"pltf","explanation":"攀：高攀，接近；托：依附。比喻巴结投靠有权势声望的人。","source":{"text":"次有攀龙托凤，自致于属车者，盖将百计。","book":"南朝·梁·钟嵘《诗品·总论》"},"example":{"text":"他靠～赢得了一官半职。"},"similar":["攀龙附凤","扳龙附凤"],"opposite":["敬而远之","视同路人"],"usage":"作谓语、宾语、定语；指巴结别人"},{"id":22752,"word":"攀龙讬凤","pinyin":"pān lóng xiù fèng","abbr":"pltf","explanation":"犹言攀龙附凤。指巴结投靠有权势的人以获取富贵。"},{"id":22753,"word":"攀龙附凤","pinyin":"pān lóng fù fèng","abbr":"plff","explanation":"指巴结投靠有权势的人以获取富贵。","source":{"text":"攀龙鳞，附凤翼。","book":"汉·扬雄《法言·渊骞》"},"example":{"text":"～势莫当，天下尽化为侯王。","book":"唐·杜甫《洗兵马》诗"},"similar":["趋炎附势","曲意逢迎"],"opposite":["敬而远之","视同路人"],"usage":"作谓语、宾语、定语；指巴结别人","story":["秦末汉初，出身平民的樊哙、郦商、夏侯婴、灌婴四人因为投靠刘邦而成为显赫人物。樊哙原是杀狗的屠夫，因娶了吕后的妹妹而“附凤”被封舞阳侯。郦商被赐信成君，夏侯婴因救了刘邦的妻儿被封汝阴侯，灌婴被封宣陵君"]},{"id":22754,"word":"攀龙附骥","pinyin":"pān lóng fù jì","abbr":"plfj","explanation":"攀：攀附；骥：好马。比喻攀附圣贤，归附俊杰。","source":{"text":"当垂宿念，为之先后，使获攀龙附骥，永自固定。其为分惠，岂有量哉！","book":"《三国志·吴志·吴主孙权传》：“此言之诚，有如大江。”裴松之注引《魏略·孙权与浩周书》"},"example":{"text":"将来直上青云，攀龙附骥，不意如此议论，乃碌碌庸夫之所不为，岂所望于哥等哉。","book":"清·墨憨斋《醒名花》第十二回"},"similar":["攀龙附凤"],"usage":"作谓语、宾语、定语；指依附有权势的人"},{"id":22755,"word":"攒三聚五","pinyin":"cuán sān jù wǔ","abbr":"csjw","explanation":"三三五五聚在一起。","source":{"text":"每作竹，必乘醉大呼，然后落笔。不可求，或强求之，心诟骂而走。然有愧宅相者，于攒三聚五太拘拘耳。","book":"宋·邓椿《画继》卷四"},"example":{"text":"因见暖阁之中有一玉石条盆，里面～栽着一盆单瓣水仙。","book":"清·曹雪芹《红楼梦》第五十二回"},"similar":["攒三集五","三五成群"],"usage":"作谓语、定语；指三三五五聚在一起"},{"id":22756,"word":"攒三集五","pinyin":"cuán sān jí wǔ","abbr":"csjw","explanation":"指三五成堆或成群地聚集在一起。","source":{"text":"忆起昨夜那些小孩子，接过礼物，攒三集五，聚精凝神，一层层打开包裹的光景。","book":"冰心《寄小读者》十一"},"similar":["攒三聚五"],"usage":"作谓语、定语；指三三五五聚在一起"},{"id":22757,"word":"攒眉苦脸","pinyin":"cuán méi kǔ liǎn","abbr":"zmkl","explanation":"攒：紧皱眉头。眉头紧蹙，苦着脸儿。形容面部表情极其愁苦。","source":{"text":"且说邹太爷拎了衣包，一走走到当铺里。柜上朝奉打开来一看，只肯当四百铜钱、禁不住邹太爷攒眉苦脸，求他多当两个，总算当了四百五十钱。","book":"清·李宝嘉《官场现形记》第十一回"},"similar":["愁眉苦脸"],"usage":"作谓语、定语；用于书面语"},{"id":22758,"word":"攒眉蹙额","pinyin":"cuán méi cù é","abbr":"cmce","explanation":"攒眉：皱眉。蹙额：皱额头。眉头额头紧皱。形容愁闷的表情。","source":{"text":"只见那女郎侧身西坐，攒眉蹙额，有不胜怨恨的意思。","book":"明·冯梦龙《醒世恒言》卷二十五"},"example":{"text":"龚公以事涉两难，～问计于弟。","book":"明·周顺昌《与朱德升书》"},"similar":["攒眉苦脸"],"usage":"作谓语、定语；用于人发愁时"},{"id":22759,"word":"攒锋聚镝","pinyin":"cuán fēng jù dí","abbr":"cfjd","explanation":"受到众多的刀箭围攻。比喻备受舆论斥责。","source":{"text":"四明在位久，卒被恶声以去，归里至与玺丞不相见。初不难借其子以市公，终于攒锋聚镝，受前人未有之弹射。","book":"明·沈德符《野获编·科场二·宰相子应举》"},"similar":["腹背受敌"],"usage":"作谓语；指陷入困境"},{"id":22760,"word":"攒零合整","pinyin":"cuán líng hé zhěng","abbr":"clhz","explanation":"攒：聚，凑集。把零碎的拼凑成整数。","source":{"text":"庄院里攒零合整，收拾的这几两银子粜米。","book":"元·无名氏《陈州粜米》"}},{"id":22761,"word":"攘为己有","pinyin":"rǎng wéi jǐ yǒu","abbr":"rwjy","explanation":"窃夺别人的东西，据为己有。","source":{"text":"就如人家做文，往往窃取陈编，攘为己有，惟恐别人看出，不免又添些自己意思，杂七杂八，强为贯串，以为掩人耳目。","book":"清·李汝珍《镜花缘》第73回"},"example":{"text":"他经常把别人的功劳～。"},"similar":["据为己有"],"usage":"作谓语；指占有别人的东西"},{"id":22762,"word":"攘人之美","pinyin":"rǎng rén zhī měi","abbr":"rrzm","explanation":"夺取别人的好处。","source":{"text":"譬之人，自无善事，攘人之美者，如鹈在人之梁。","book":"宋·王谠《唐语林·文学》"}},{"id":22763,"word":"攘外安内","pinyin":"rǎng wài ān nèi","abbr":"rwan","explanation":"攘：排除。原就药的疗效而言。后多指安定内部，排除外患。","source":{"text":"甘草甘平，有安内攘外之能。","book":"汉·张仲景《伤寒论·太阳病上》"},"example":{"text":"管仲一匡九合，～，其功甚大。","book":"清·夏敬渠《野叟曝言》卷七十二"},"similar":["安内攘外"],"usage":"作谓语、定语；指处理内外关系"},{"id":22764,"word":"攘往熙来","pinyin":"rǎng wǎng xī lái","abbr":"rwxl","explanation":"形容人来人往，喧闹纷杂。","source":{"text":"天下熙熙，皆为利来；天下攘攘，皆为利往。","book":"西汉·司马迁《史记·货殖列传》"},"example":{"text":"～于通衢大道之中，指天画地于密室之内。","book":"黄远庸《铸党论》"},"similar":["攘来熙往"],"usage":"作谓语、定语；形容非常热闹拥挤"},{"id":22765,"word":"攘攘熙熙","pinyin":"rǎng rǎng xī xī","abbr":"rrxx","explanation":"喧嚷纷杂的样子。","source":{"text":"果然蜂趋蚁附，攘攘熙熙，诚不出神灵所料者矣。","book":"《三元里抗英社学史料·太和市联升社学序》"},"example":{"text":"～半鲁蠢，醉生梦死叹蒙蒙。","book":"泣红《胭脂血弹词·牧羊》"},"similar":["熙熙攘攘"],"usage":"作谓语、定语；形容人多喧闹"},{"id":22766,"word":"攘权夺利","pinyin":"rǎng quán duó lì","abbr":"rqdl","explanation":"犹言争权夺利。争夺权力和利益。","source":{"text":"坐是抢攘月余，势成坐困，老师匮财，攘权夺利，凡种种不良之现象，皆缘是以生。","book":"白蕉《袁世凯与中华民国》"},"similar":["争权夺利"],"opposite":["明哲保身"],"usage":"作主语、谓语、宾语、定语；用于处事"},{"id":22767,"word":"攘来熙往","pinyin":"rǎng lái xī wǎng","abbr":"rlxw","explanation":"形容人来人往，非常热闹拥挤。","source":{"text":"天下熙熙，皆为利来；天下攘攘，皆为利往。","book":"《史记·货殖列传》"},"similar":["攘往熙来"],"usage":"作谓语；指非常热闹拥挤"},{"id":22768,"word":"攘肌及骨","pinyin":"rǎng jī jí gǔ","abbr":"rjjg","explanation":"比喻侵及腹地。","source":{"text":"是以四疆之内，各以其力来侵，攘肌及骨，而赧独何以制秦乎？","book":"汉·扬雄《法言·重黎》"},"usage":"作谓语、定语、宾语；用于比喻句"},{"id":22769,"word":"攘臂一呼","pinyin":"rǎng bì yī hū","abbr":"rbyh","explanation":"攘：挥动。挥动手臂呼喊（多用在号召）。","source":{"text":"然陵振臂一呼，创病皆起。","book":"汉·李陵《答苏武书》"},"example":{"text":"皆能～，聚众千百，杀掠吏民，死且不顾，重烦大兵剪灭而后已，是岂理所当然者哉。","book":"宋·辛弃疾《淳熙己亥论盗贼札子》"},"similar":["振臂一呼"],"usage":"作谓语、定语；指大声号召"},{"id":22770,"word":"攘臂嗔目","pinyin":"rǎng bì chēn mù","abbr":"rbcm","explanation":"攘：捋；瞋：发怒时瞪大眼睛。捋袖伸臂，瞪着眼睛。比喻人发怒时的样子。","source":{"text":"于是韩王勃然作色，攘臂瞋目。","book":"《史记·苏秦列传》"}},{"id":22771,"word":"攘臂而起","pinyin":"rǎng bì ér qǐ","abbr":"rbeq","explanation":"攘臂：捋起袖子，伸出手臂；起：站起。形容兴奋、激动地站起来，准备行动。","source":{"text":"向日胡海、张军之变，为害甚于金，今若不早为之图，则两淮日见荒墟，卒有警急，攘臂而起矣。","book":"《宋史·黄干传》"},"example":{"text":"将来工业之衰盛，几一系于占领支那之得失，遂～，惧为人先。","book":"鲁迅《集外集拾遗补编·中国地质略论》"}},{"id":22772,"word":"攘袂切齿","pinyin":"rǎng mèi qiè chǐ","abbr":"rmqc","explanation":"攘袂：捋起衣袖；切齿：咬紧牙齿。形容愤怒、激动的样子。","source":{"text":"吏士攘袂切齿，皆欲犁其庭而扫其闾。","book":"宋·秦观《进策·边防上》"},"usage":"作谓语、定语、状语；用于愤怒等"},{"id":22773,"word":"攘袂引领","pinyin":"rǎng mèi yǐn lǐng","abbr":"rmyl","explanation":"揎袖捋臂，伸长头颈。形容激奋盼望貌。","source":{"text":"天下学士有志于圣人者，莫不攘袂引领，愿受指教，听教诲。","book":"宋·曾巩《上欧阳学士第一书》"},"similar":["翘首引领","翘足引领"],"usage":"作谓语、定语、状语；用于处事"},{"id":22774,"word":"攘袂扼腕","pinyin":"rǎng mèi è wàn","abbr":"rmew","explanation":"攘袂：捋起袖子；扼腕：用手握住手腕。形容激动和气愤。","source":{"text":"立朝之际，或攘袂扼腕，自公卿已下，皆颐指气使，无不詟惮。","book":"《旧唐书·杨国忠传》"},"example":{"text":"神龟之间，张仲瑀铨削先格，排抑武人，不使预清品，一时武人，～，至无所泄其愤。","book":"宋·王楙《野客丛书·不可为已甚》"}},{"id":22775,"word":"攞袖揎拳","pinyin":"luǒ xiù xuān quán","abbr":"lxxq","explanation":"挽起袖子，露出拳头，准备动武。","source":{"text":"一个个气昂昂性儿不善，他每都叫吼吼攞袖揎拳。","book":"元·无名氏《碧桃花》第三折"},"similar":["揎拳攞袖"],"usage":"作谓语、状语；指准备动武"},{"id":22776,"word":"攧唇簸嘴","pinyin":"diān chún bǒ zuǐ","abbr":"dcbz","explanation":"攧：同“颠”。上下摆动嘴唇。形容搬弄是非，说长道短。","source":{"text":"耳根边又听得徐言弟兄在背后攧唇搬嘴，愈加烦恼。","book":"明·冯梦龙《醒世恒言》卷三十五"},"similar":["说长道短"],"usage":"作谓语；指说长道短"},{"id":22777,"word":"攧手攧脚","pinyin":"diān shǒu diān jiǎo","abbr":"dsdj","explanation":"跌跌撞撞。","example":{"text":"他～地跑向会议大厅。"},"similar":["跌跌撞撞"],"usage":"作状语；指不顺畅"},{"id":22778,"word":"攧扑不破","pinyin":"diān pū bù pò","abbr":"dpbp","explanation":"无论怎样摔打都不破。比喻道理正确，推翻不了。"},{"id":22779,"word":"攫为己有","pinyin":"jué wéi jǐ yǒu","abbr":"jwjy","explanation":"攫：夺取。有强行手段夺取别人的东西，占为己有。","source":{"text":"昔齐人有欲金者，清旦衣冠而之市，适鬻金者之所，因攫其金而去。","book":"《列子·说符》"},"example":{"text":"大不列颠的毒枭们对这座占尽地利的天然深水良港垂涎不已，把它从大清帝国的版图上～。","book":"霍达《补天裂》第五章"},"similar":["据为己有"],"usage":"作谓语、宾语；指将不是自己的东西占有"},{"id":22780,"word":"攫戾执猛","pinyin":"jué lì zhí měng","abbr":"jlzm","explanation":"攫：夺取；戾：暴；执：捉住。能扑取或捉住强暴凶猛的敌人。形容英勇无敌。","source":{"text":"谋臣武将，皆能攫戾执猛，破坚摧刚。","book":"汉·张衡《南都赋》"},"usage":"作谓语、定语；指人勇敢"},{"id":22781,"word":"攫金不见人","pinyin":"jué jīn bù jiàn rén","abbr":"jjbjr","explanation":"比喻为了满足个人的欲望而不顾一切。","source":{"text":"取金之时不见人，徒见金。","book":"《列子·说符》"},"usage":"作宾语、定语；用于比喻句"},{"id":22782,"word":"支分族解","pinyin":"zhī fē zú jiě","abbr":"zfzj","explanation":"把肢体与关节一一分开。族，骨节交错盘结之处。比喻剖析义理，详尽中肯。同“支分节解”。","source":{"text":"又善于诱掖，其言批豁畅朗，支分族解，騃童钝夫闻之，咸如梦寐惊觉。","book":"清·刘大櫆《乌程闵君墓志铭》"},"similar":["支分节解"],"usage":"作谓语、定语；用于书面语"},{"id":22783,"word":"支分节解","pinyin":"zhī fēn jié jiě","abbr":"zfjj","explanation":"把肢体与关节一一分开。节，关节。比喻剖析义理，详尽中肯。亦作“支分族解”。","source":{"text":"然后此书之旨支分节解，脉络贯通，详略相因，巨细毕举。","book":"宋·朱熹《〈中庸章句〉序》"},"example":{"text":"自六籍播于秦火，汉世摄拾残遗，征诸儒能通其读者，～，于是有章句之学。","book":"清·曾国藩《〈经史百家简编〉序》"},"similar":["支分族解"],"usage":"作谓语、定语；用于书面语"},{"id":22784,"word":"支叶扶疏","pinyin":"zhī yè fú shū","abbr":"zyfs","explanation":"支：同“枝”。枝叶繁茂四布，高下疏密有致。形容树木茂盛。也比喻宗支繁衍鼎盛。","source":{"text":"高皇帝，览踪迹，观得失，见秦见本非是，故改其路，规土连城，布王子孙，是以支叶扶疏，异姓不得间也。","book":"《汉书·武五子传》"},"similar":["枝叶扶疏"],"usage":"作主语、宾语；形容树木长势良好"},{"id":22785,"word":"支叶硕茂","pinyin":"zhī yè shuò mào","abbr":"zysm","explanation":"支：同“枝”；硕：大；茂：茂盛。枝叶大而茂密。比喻子孙繁衍，家族兴旺。","source":{"text":"侯王之祉，祚及宗子，公族蕃滋，支叶硕茂。","book":"《汉书·叙传下》"},"similar":["支叶扶疏"],"usage":"作谓语、定语；用于书面语"},{"id":22786,"word":"支吾其词","pinyin":"zhī wū qí cí","abbr":"zwqc","explanation":"支吾：说话含混躲闪。指用含混的话搪塞应付，以掩盖真实情况。","source":{"text":"这句话不便向时筱仁说明，只得支吾其词道。","book":"清·李宝嘉《官场现形记》第28回"},"example":{"text":"周炳找不着什么得体的话说，就含含糊糊地～。","book":"欧阳山《苦斗》"},"similar":["含糊其词","闪烁其词","吞吞吐吐"],"opposite":["一针见血","一语道破","开门见山"],"usage":"作谓语、状语；指言语含糊"},{"id":22787,"word":"支吾其辞","pinyin":"zhī wū qí cí","abbr":"zwqc","explanation":"支吾：说话含混躲闪。指用含混的话搪塞应付，以掩盖真实情况。","source":{"text":"余荩臣见王小五子揭出他的短处，只得支吾其词道：‘他的差使本来要委的了。银子是他该我的，如今他还我，并不是花了钱买差使的。’","book":"清·李宝嘉《官场现形记》第三十二回"},"example":{"text":"所以岳维峻遂以重兵防守鄂豫边境，不许吴军出武胜关一步，吴天天派员疏通豫岳，岳则日日～。（丁中江《北洋军阀史话》二三二）"},"similar":["支吾其词"],"opposite":["开门见山"],"usage":"作谓语、状语；指言语含糊"},{"id":22788,"word":"支左屈右","pinyin":"zhī zuǒ qū yòu","abbr":"zzqy","explanation":"左：左手；屈：弯；右：右手。伸左手，弯右手。指射箭的姿势。","source":{"text":"我不能教子支左屈右。夫射柳叶者，百发百中，而不已善息，少焉气力倦，弓拨矢钩，一发不中，前功尽矣。","book":"《战国策·西周策》"},"example":{"text":"～的日子真是难过"},"similar":["左支右绌"],"usage":"作谓语、宾语、定语；指穷于应付"},{"id":22789,"word":"支床叠屋","pinyin":"zhī chuáng dié wū","abbr":"zcdw","explanation":"犹叠床架屋。喻重复。","source":{"text":"其《通志·二十略》，以论断为主，以记述为辅，实为中国史界放一光明也。惜其为太史公范围所困，以纪传十之七、八，填塞全书，支床叠屋，为大体玷。","book":"梁启超《中国之旧史》"},"similar":["叠床架屋"],"usage":"作谓语、定语；指累赘"},{"id":22790,"word":"支床迭屋","pinyin":"zhī chuáng dié wū","abbr":"zcdw","explanation":"犹迭床架屋。比喻重复。"},{"id":22791,"word":"支手舞脚","pinyin":"zhī shǒu wǔ jiǎo","abbr":"zswj","explanation":"犹言指手画脚。","source":{"text":"王悛有了酒意，做出财主的样式，支手舞脚的发挥。","book":"明·凌濛初《二刻拍案惊奇》卷三十一"},"example":{"text":"连那些狼虎家人，妖精仆妇，也都没个敢上前～的。","book":"清·西周生《醒世姻缘传》第九回"},"similar":["指手划脚"],"usage":"作谓语、状语；用于书面语"},{"id":22792,"word":"支支吾吾","pinyin":"zhī zhī wú wú","abbr":"zzww","explanation":"指说话吞吞吐吐，含混躲闪。亦作“支支梧梧”。","source":{"text":"我既这等苦苦相问，你自然就该侃侃而谈，怎么问了半日，你一味的吞吞吐吐，支支吾吾？","book":"清·文康《儿女英雄传》第五回"},"example":{"text":"指导员觉得黄金宝有点反常，两只眼映着灯闪光，好像含着泪，问他又～地不肯明说。","book":"杨朔《熔炉》"},"similar":["支吾其词"],"opposite":["清清楚楚"],"usage":"作定语、状语；指言语含糊"},{"id":22793,"word":"支支梧梧","pinyin":"zhī zhī wú wú","abbr":"zzww","explanation":"指说话吞吞吐吐，含混躲闪。同“支支吾吾”。","source":{"text":"[后羿]坐在对面的铺着脱毛的旧豹皮的木榻上，搔着头皮，支支梧梧地说——‘今天的运气仍旧不见佳，还是只有乌鸦。’","book":"鲁迅《故事新编·奔月》"},"similar":["支支吾吾"],"usage":"作定语、状语；指言语含糊"},{"id":22794,"word":"支离拥肿","pinyin":"zhī lí yōng zhǒng","abbr":"zlyz","explanation":"支离：分散。指分散的东西聚合在一起","source":{"text":"夏侯玄以才望被戮，无支离拥肿之鉴也。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作定语；用于书面语"},{"id":22795,"word":"支离破碎","pinyin":"zhī lí pò suì","abbr":"zlps","explanation":"支离：零散，残缺。形容事物零散破碎，不完整。","source":{"text":"而及其求之以道，则小者多支离破碎而不合，大者乃敢于披猖磔裂，尽决去圣人畔岸，而剪拔其藩篱。","book":"清·魏僖《尧峰文钞·答陈霭公论文书一》"},"example":{"text":"我们不要把文章分析得～。"},"similar":["七零八落","四分五裂","一鳞半爪"],"opposite":["浑然一体","完美无缺","金瓯无缺"],"usage":"作谓语、定语、补语；指不成整体"},{"id":22796,"word":"支离繁碎","pinyin":"zhī lí fán suì","abbr":"zlfs","explanation":"支离：零散，残缺。形容事物零散破碎，不完整。","source":{"text":"一则径趋简约，脱略过高；一则专务外驰，支离繁碎。","book":"《庄子·人间世》：“夫支离其形者，犹足以养其身，终其天年，又况支离其德者乎？”明·朱国桢《涌幢小品·为学两端》"},"example":{"text":"《易》道渊深，包罗众义，随得一隙而入，皆能宛转关通，有所阐发，亦不必尽以～斥也。（《四库全书总目提要·经部》卷五）"},"similar":["支离破碎"],"usage":"作谓语、定语、补语；指不成整体"},{"id":22797,"word":"支离臃肿","pinyin":"zhī lí yōng zhǒng","abbr":"zlyz","explanation":"支离：残缺；臃肿：过度肥胖。形体残缺而又肥胖。形容非常丑陋。","source":{"text":"夏侯玄以才望被戮，无支离臃肿之鉴也。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"未来衰老病死苦，先是～人。（《台湾文献丛刊·有感书臆》）"}},{"id":22798,"word":"支策据梧","pinyin":"zhī cè jù wú","abbr":"zcjw","explanation":"此指昭文弹琴、师旷持杖击节、惠子倚在梧桐树下辩论，三人的技艺几乎都算得上登峰造极，所以载誉于晚年。后形容用心劳神。","source":{"text":"昭文之鼓琴也，师旷之枝策也，惠子之据梧也，三子之知，几乎皆其盛者也，故载之末年。","book":"语本《庄子·齐物论》"},"example":{"text":"范容期见郗超俗情不淡，戏之曰：“夷、齐、巢、许，一诣垂名。何必劳神苦形，～邪？”","book":"南朝·宋·刘义庆《世说新语·排调》"},"usage":"作谓语、宾语；用于书面语"},{"id":22799,"word":"支纷节解","pinyin":"zhī fēn jié jiě","abbr":"zfjj","explanation":"分解肢体；剁成碎塊。犹言碎尸万段。","source":{"text":"汉·荀悦《汉纪·平帝纪》：“校尉公孙宾就斩莽头，军人争莽身，支纷节解，肌肉脔切。”按，《汉书·王莽传下》“公孙宾就”作“公宾就”。"},"usage":"作谓语、定语；用于书面语"},{"id":22800,"word":"收之桑榆","pinyin":"shōu zhī sāng yú","abbr":"szsy","explanation":"指初虽有失，而终得补偿。后指事犹未晚，尚可补救。","source":{"text":"始虽垂翅回溪，终能奋翼黾池，可谓失之东隅，收之桑榆。","book":"南朝·宋·范晔《后汉书·冯异传》"},"example":{"text":"这于我是很不好的，所以赶紧订正宁此，庶几‘～’云。","book":"鲁迅《后记》"},"similar":["亡羊补牢"],"usage":"作宾语、定语；常与“失之东隅”连用","story":["东汉初年，光武帝刘秀派大将冯异与邓禹去围剿赤眉农民起义军，邓禹与义军交战后不幸损兵折将，冯异命令部队加强防御，收拢溃散的散兵，同时派军装成赤眉军打入其内部，结果大获全胜。朝廷下文书表彰他们的战斗是失之东隅，收之桑榆"]},{"id":22801,"word":"收买人心","pinyin":"shōu mǎi rén xīn","abbr":"smrx","explanation":"指用金钱、感情等笼络人心。","source":{"text":"他也知道收买民心，开仓赈济，并恤被兵之家，四县亦如此行事。","book":"清·李百川《绿野仙踪》第31回"},"example":{"text":"你不要再～了。"},"similar":["笼络人心"],"usage":"作谓语、宾语、定语；指笼络人心","story":["三国时期，赵云与刘备的两位夫人及小主人阿斗失散后，四处打听，终于找到了甘夫人及阿斗。曹操的追兵赶到，赵云英勇杀敌，突出重围终于到达刘备身边，哭诉没有救下糜夫人，刘备感动得痛哭流涕，当场要摔死阿斗，被众将劝止"]},{"id":22802,"word":"收兵回营","pinyin":"shōu bīng huí yíng","abbr":"sbhy","explanation":"召集正在战斗或值勤的士兵返回营地。后也指停止某项活动或工作，把人员召集回来。","source":{"text":"战到黄昏时分，忽然下起大雨，双方才各自收兵回营。","book":"明·罗贯中《三国演义》第一回"},"example":{"text":"二人大战三百余合，不分胜负，看看天色已晚，各自～。","book":"清·钱彩《说岳全传》第四十七回"},"similar":["鸣金收兵"],"usage":"作谓语、宾语；用于军事等"},{"id":22803,"word":"收刀检卦","pinyin":"shōu dāo jiǎn guà","abbr":"sdjg","explanation":"指停止胡作非为。","source":{"text":"大路不平旁人铲，识向的各自收刀检卦，走你的清秋大路。","book":"李劼人《死水微澜》第五部分九"},"usage":"作谓语、定语；用于书面语"},{"id":22804,"word":"收合余烬","pinyin":"shōu hé yú jìn","abbr":"shyj","explanation":"比喻（战败后）收集残余的士卒。","source":{"text":"子又不许，请收合余烬，背城借一，敝邑之幸，亦云从也，况其不幸，敢不唯命是听。","book":"《左传·成公二年》"},"example":{"text":"昔春秋之时，郑小国也，介居晋、楚之间，城下之盟，君臣同耻；～，尚能成功。","book":"宋·洪适《亲征诏》"},"usage":"作谓语、定语；用于比喻句"},{"id":22805,"word":"收合余烬，背城借一","pinyin":"shōu hé yú jìn，bèi chéng jiè yī","abbr":"shyjbcjy","explanation":"收合：收聚，整理；余烬：火烧后的残留物，指残兵；借一：借此一战。收拾剩余力量，在城下和敌人决一死战。","source":{"text":"请收合余烬，背城借一。","book":"《左传·成公二年》"},"example":{"text":"伪安德王高延宗，扰攘之间，遂窃名号，与伪齐昌王莫多娄敬显等，～。","book":"《北史·周本纪》"}},{"id":22806,"word":"收回成命","pinyin":"shōu huí chéng mìng","abbr":"shcm","explanation":"取消已公布的命令或决定。","source":{"text":"伏望明府，哀其弗及，收回成命。","book":"《诗经·周颂·昊天有成命》：“昊天有成命，二后受之。”清·黄宗羲《辞张郡候请修郡志书》"},"example":{"text":"初，林公遣戍，御史陈庆镛抗疏力争，请上～。","book":"清·黄钧宰《金壶七墨·吴门秀士书》"},"usage":"作谓语；指取消已公布的命令或决定"},{"id":22807,"word":"收回成涣","pinyin":"shōu huí chéng huàn","abbr":"shch","explanation":"涣：涣汗。比喻君主发号施令，如汗出于身，难于收回。","source":{"text":"欲望朝廷，特赐敷奏，收回成涣，改畀名流。","book":"宋·崔与之《辞免除兼太子侍讲》"}},{"id":22808,"word":"收因种果","pinyin":"shōu yīn zhǒng guǒ","abbr":"syzg","explanation":"指了却前缘，得到结果。旧有因果报应之说，指前有因缘则必有相对的后果。同“收因结果”。","source":{"text":"当日要一文钱没处求，今日享千钟粟还嫌薄……权做个收因种果。","book":"元·石德玉《曲江池》第四折"},"similar":["收因结果","收园结果","收缘结果"],"usage":"作谓语、宾语；用于书面语"},{"id":22809,"word":"收因结果","pinyin":"shōu yīn jié guǒ","abbr":"syjg","explanation":"指了却前缘，得到结果。旧有因果报应之说，指前有因缘则必有相对的后果。","source":{"text":"共伊合下，深盟厚约，比望收因结果。","book":"宋·晁端礼《柳初新》词"},"similar":["收因种果","收缘结果","收园结果"],"usage":"作谓语、宾语；用于书面语"},{"id":22810,"word":"收园结果","pinyin":"shōu yuán jié guǒ","abbr":"syjg","explanation":"旧有因果报应之说，指前有因缘则必有相对的后果。同“收因结果”。","source":{"text":"想着他开疆展土将君王佐，这的是收园结果。","book":"元·无名氏《赚蒯通》第三折"},"similar":["收因结果","收因种果","收缘结果"],"usage":"作谓语、宾语；用于书面语"},{"id":22811,"word":"收成弃败","pinyin":"shōu chéng qì bài","abbr":"scqb","explanation":"趋附得势的人，轻视遭贬黜的人。","source":{"text":"俗性贪进忽退，收成弃败。","book":"汉·王充《论衡·自纪》"},"usage":"作谓语；指小人"},{"id":22812,"word":"收拾余烬，背城借一","pinyin":"shōu shí yú jìn，bèi chéng jiè yī","abbr":"ssyjbcjy","explanation":"收拾：收聚，整理；余烬：火烧后的残留物，指残兵；借一：借此一战。收拾剩余力量，在城下和敌人决一死战。","source":{"text":"请收合余烬，背城借一。","book":"《左传·成公二年》"},"example":{"text":"时国论纷纷未决，咸欲收拾余烬，与奥军背城借一。","book":"清·梁启超《意大利建国三杰传》第十节"}},{"id":22813,"word":"收揽人心","pinyin":"shōu lǎn rén xīn","abbr":"slrx","explanation":"收揽：招纳。收买拉拢众人，以取得好感。","source":{"text":"不可不收揽人心也。","book":"《旧唐书·韩思复传》"},"example":{"text":"陛下进北京后，对官民行宽仁之政，～，并将人马驻扎城外。","book":"姚雪垠《李自成》第四卷第十章"}},{"id":22814,"word":"收揽英奇","pinyin":"shōu lǎn yīng qí","abbr":"slyq","explanation":"收揽：招纳。招纳英雄奇才。","source":{"text":"收揽英才，遂续汉业，以美中兴之功。","book":"《晋书·周嵩传》"}},{"id":22815,"word":"收旗卷伞","pinyin":"shōu qí juàn sǎn","abbr":"sqjs","explanation":"比喻停止活动。"},{"id":22816,"word":"收残缀轶","pinyin":"shōu cán zhuì yì","abbr":"sczy"},{"id":22817,"word":"收离纠散","pinyin":"shōu lí jiū sàn","abbr":"sljs","explanation":"收集离散者。","source":{"text":"若绍收离纠散，乘虚以出，则公之事去矣。","book":"《后汉书·荀彧传》"},"similar":["收离聚散"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":22818,"word":"收离聚散","pinyin":"shōu lí jù sàn","abbr":"sljs","explanation":"收集离散者。同“收离纠散”。","source":{"text":"收离聚散，咸安其居。","book":"晋·孙楚《为石仲容与孙皓书》"},"similar":["收离纠散"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":22819,"word":"收缘结果","pinyin":"shōu yuán jié guǒ","abbr":"syjg","explanation":"指了却前缘，得到结果。旧有因果报应之说，指前有因缘则必有相对的后果。同“收因结果”。","source":{"text":"[空空道人]见后面偈文后又历叙了多少收缘结果的话头。","book":"《红楼梦》第一二○回"},"similar":["收园结果","收因结果","收因种果"],"usage":"作谓语、宾语；用于书面语"},{"id":22820,"word":"收视反听","pinyin":"shōu shì fǎn tīng","abbr":"ssft","explanation":"不视不听。指不为外物所惊扰。","source":{"text":"其始也，皆收视反听，耽思傍讯。","book":"晋·陆机《文赋》"},"example":{"text":"逢一灾，偶一异，则～。","book":"唐·白居易《辨水旱之灾，明存救之术》"},"similar":["收视返听"],"usage":"作谓语、定语、状语；用于人对事物的看法"},{"id":22821,"word":"收视返听","pinyin":"shōu shì fǎn tīng","abbr":"ssft","explanation":"收：停止；返：还。不视不听。指人对事物的看法不为外物所惊扰。","source":{"text":"其祈焉则必收视返听，清其心以对越于神明。","book":"梁启超《新民说》"},"similar":["收视反听"],"usage":"作谓语、定语；用于人对事物的看法"},{"id":22822,"word":"收锣罢鼓","pinyin":"shōu luó bà gǔ","abbr":"slbg","explanation":"停止敲击锣鼓。比喻结束，结尾。","source":{"text":"骨肉团聚，不过欢笑一场，以此收锣罢鼓，有何趣味。","book":"清·李渔《闲情偶寄·词曲·格局》"},"similar":["偃旗息鼓"],"usage":"作谓语、定语、宾语；比喻停止活动等"},{"id":22823,"word":"改俗迁风","pinyin":"gǎi sú qiān fēng","abbr":"gsqf","explanation":"迁：改。改变风俗习气。","source":{"text":"兼以世道浇暮，争诈繁起，改俗迁风，良有未易。","book":"《梁书·何胤传》"},"similar":["移风易俗"],"usage":"作谓语；指改变风俗习气"},{"id":22824,"word":"改口沓舌","pinyin":"gǎi kǒu tà shé","abbr":"gkts","explanation":"重新转动舌头，改变原来的说法。","source":{"text":"尉数之曰：‘若复敢姗笑刘侍御文章耶？’景休仰而对曰：‘民宁再受笞数十，终不能改口沓舌，妄谀刘侍御也！’","book":"清·周亮工《书影》卷三"},"usage":"作谓语、宾语；指改变原来的说法"},{"id":22825,"word":"改名换姓","pinyin":"gǎi míng huàn xìng","abbr":"gmhx","explanation":"改换了原来的姓名。多指为了隐瞒真实身份而改变原来的姓名。","source":{"text":"乃乘扁舟浮于江湖，变名易姓。","book":"《史记·货殖列传》"},"example":{"text":"不必如此隐讳遮蔽，～，欲以欺人，而人不可欺。","book":"宋·朱熹《答孙敬甫》"},"similar":["改头换面","改名易姓"],"usage":"作谓语、定语；指改换了原来的姓名"},{"id":22826,"word":"改名易姓","pinyin":"gǎi míng yì xìng","abbr":"gmyx","explanation":"改换原来的姓名。多指为了隐瞒原来的身分。同“改名换姓”。","source":{"text":"其后往往私创庵院，滥将无籍之徒收充，亦有逃军囚匠改名易姓，削发顶冠，人莫之识。","book":"明·余继登《典故纪闻》卷十三"},"example":{"text":"明·余继登《典故纪闻》第13卷：“亦有逃军囚匠～，削发顶冠，人莫之识。”"},"similar":["变名易姓","更名改姓","改姓更名"],"usage":"作谓语、宾语、定语；指人改变名字"},{"id":22827,"word":"改天换地","pinyin":"gǎi tiān huàn dì","abbr":"gthd","explanation":"彻底改变原来的面貌。指改造社会，改造自然。","source":{"text":"站在我面前的正是两位扭转乾坤，改天换地，领导我党我国人民推翻了三座大山，缔造了社会主义新中国的伟大领袖、历史巨人。","book":"朱敏《深情忆念周伯伯》"},"example":{"text":"理直气壮，猛然回击，坚持了～的战斗。","book":"郭小川《登九山》"},"similar":["改头换面"],"usage":"作谓语、定语；指改造社会，改造自然"},{"id":22828,"word":"改头换尾","pinyin":"gǎi tóu huàn wěi","abbr":"gthw","explanation":"指改变原来的面目。比喻只作形式上的变动，而实质内容不变。","source":{"text":"增加卷轴，添足篇章，依傍佛经，改头换尾。","book":"唐·彦惾《唐护法沙门法琳别传》下卷"},"similar":["改头换面"],"usage":"作谓语、定语、状语；同“改头换面”"},{"id":22829,"word":"改头换面","pinyin":"gǎi tóu huàn miàn","abbr":"gthm","explanation":"原指人的容貌发生了改变。现多比喻只改外表和形式，内容实质不变。","source":{"text":"改头换面孔，不离旧时人。","book":"唐·寒山《诗三百三首》第二一四首"},"example":{"text":"冤债原从隔世深，相逢便起杀心。～犹相报，何况容颜俨在今。","book":"明·凌濛初《初刻拍案惊奇》卷三十"},"similar":["乔装打扮","面目一新"],"opposite":["依然如故","原封不动"],"usage":"作谓语、定语、状语；指外表化妆"},{"id":22830,"word":"改姓易代","pinyin":"gǎi xìng yì dài","abbr":"gxyd","explanation":"指朝代改换。泛指政权更替。","source":{"text":"岁星入太微，内有兵乱，人主以弱。三者，汉改姓易代之异也。","book":"《宋书·符瑞志上》"},"similar":["改朝换代","改朝换姓"],"usage":"作宾语、定语；指政权更替"},{"id":22831,"word":"改姓更名","pinyin":"gǎi xìng gēng míng","abbr":"gxgm","explanation":"改换原来的姓名。多指为了隐瞒原来的身分。同“改名换姓”。","source":{"text":"则今日辞别尊兄疾去忙，改姓更名离水乡。","book":"明·无名氏《闹铜台》楔子"},"similar":["改名易姓"],"usage":"作谓语、宾语、定语；指人改变名字"},{"id":22832,"word":"改容易貌","pinyin":"gǎi róng yì mào","abbr":"grym","explanation":"改、易：改变；容、貌：神色、相貌。变了神色或模样。","source":{"text":"‘吾与夫子游十九年，而未尝知吾兀者也。今子与我游于形骸之内，而子学我于形骸之外，不亦过乎？’子产蹴然改容更貌，曰：‘子无乃称。’","book":"战国·宋·庄周《庄子·德充符》"},"example":{"text":"你就是～，我还是能认识你。"},"similar":["改容更貌"],"usage":"作谓语；指改变了神色"},{"id":22833,"word":"改容更貌","pinyin":"gǎi róng gēng mào","abbr":"grgm","explanation":"改、更：改变；容、貌：神色、相貌。变了神色或模样。","source":{"text":"‘吾与夫子游十九年，而未尝知吾兀者也。今子与我游于形骸之内，而子索我于形骸之外，不亦过乎？’子产蹴然改容更貌，曰：‘子无乃称。’","book":"《庄子·德充符》"},"similar":["改容易貌"],"usage":"作谓语、宾语；指改变了神色"},{"id":22834,"word":"改张易调","pinyin":"gǎi zhāng yì diào","abbr":"gzyd","explanation":"更换琴弦，变换声调。比喻改变方针、做法或态度。","source":{"text":"正是匡矫末俗，改张易调之时，而犹当竭已罢之人，营无益之事，殚已困之财，修无用之费，此固臣之所不敢安也。","book":"《晋书·琅邪悼王焕传》"},"example":{"text":"至于取士之途不溥，沙汰之理未精。而舅属当铨衡，宜须～。","book":"《北史·崔亮传》"},"similar":["改弦易调","改弦易张"],"usage":"作谓语、宾语、定语；用于行为等"},{"id":22835,"word":"改弦易张","pinyin":"gǎi xián yì zhāng","abbr":"gxyz","explanation":"犹改弦更张。比喻改革制度或变更计划、方法。","source":{"text":"休以旧爱宿恩，任用兴布，不能拔进良才，改弦易张，虽志善好学，何益救知己乎？","book":"《三国志·吴志·孙休传论》"},"example":{"text":"《三国志·吴志·孙休传论》：“休以旧爱宿恩，任用兴布，不能拔进良才，改弦易张，虽志善好学，何益救知己乎？”"},"similar":["改弦更张","改弦易调"],"usage":"作谓语、宾语；用于处事"},{"id":22836,"word":"改弦易调","pinyin":"gǎi xián yì diào","abbr":"gxyd","explanation":"调整乐弦，更换曲调。比喻改变态度或做法。","source":{"text":"正是匡矫末俗，改张易调之时，而犹当竭以罢之人，营无益之事，殚已困之财，修无用之费，此固臣之不敢安也。","book":"《晋书·忠敬王遵传》"},"example":{"text":"请复为相州，～，庶有以变其风俗，上答隆恩。","book":"《隋书·梁彦光传》"},"similar":["改弦更张","改曲易调","改弦易张"],"usage":"作谓语、宾语、定语；用于行为等"},{"id":22837,"word":"改弦易辙","pinyin":"gǎi xián yì zhé","abbr":"gxyz","explanation":"辙：车轮轧过的痕迹。琴换弦，车改道。比喻改变原来的方向、计划、办法等。","source":{"text":"使其子孙改弦易辙，务从宽厚，亦足以盖其父之愆。","book":"唐·白居易《王公亮可商州刺史制》：“况商土瘠，商人贫，可以静理而阜安，不宜改弦而易辙。”宋·王楙《野客丛书·张杜皆有后》"},"example":{"text":"殿下放心，待老臣同进朝歌，直谏天子，～，以救祸乱。","book":"明·许仲琳《封神演义》第八回"},"similar":["改弦更张"],"opposite":["旧调重弹"],"usage":"作谓语、状语；比喻改变方向、计划和态度","story":["西汉时期，酷吏张汤在担任御史期间，处理案件中每次株连处死很多人，最后自己因为个案被逼自杀。张汤的儿子张安世为人忠厚，谨慎用刑，得到汉武帝、昭帝、宣帝的重用。宋代王楙评价张安世像乐器换弦车改道一样救了他们家"]},{"id":22838,"word":"改弦更张","pinyin":"gǎi xián gēng zhāng","abbr":"gxgz","explanation":"更：改换；张：给乐器上弦。改换、调整乐器上的弦，使声音和谐。比喻改革制度或变更计划、方法。","source":{"text":"窃譬之琴瑟不调，甚者必解而更张之，乃可鼓也。","book":"《汉书·董仲舒传》"},"example":{"text":"不～，使吏有士君子之行，而欲民生蒙福，教化淳美，犹欲其入而闭之门也。","book":"清·阮葵生《茶余客话》卷七"},"similar":["改弦易辙","改邪归正"],"opposite":["旧调重弹"],"usage":"作谓语、宾语；用于处事","story":["西汉时期，儒学家董仲舒读书与做学问十分刻苦，他读书时曾经三年不到自家花园里看一眼。汉武帝十分欣赏他的为人，让他提供施政方略。董仲舒认为秦朝的一些旧制度已经不适应了，就好比琴上的旧弦必须要换掉一样"]},{"id":22839,"word":"改往修来","pinyin":"gǎi wǎng xiū lái","abbr":"gwxl","explanation":"指改变以往的错误，修治来日的善行。","source":{"text":"愿改往修来，自求多福。","book":"《后汉书·方术传下·公沙穆》"},"example":{"text":"是后又望将军～，克己复礼，追还孔怀如初之爱。","book":"《三国志·魏志·袁绍传》“太祖乃还救谭，十月至黎阳”裴松之注引晋·习凿齿《汉晋春秋》"},"usage":"作谓语、定语、宾语；用于行为等"},{"id":22840,"word":"改恶为善","pinyin":"gǎi è wéi shàn","abbr":"gews","explanation":"不再作恶，重新做人。","source":{"text":"动，动人心也；变，改恶为善也。","book":"《礼记·中庸》“明则动，动则变”汉·郑玄注"},"similar":["改恶从善","改恶向善","改恶行善"],"usage":"作谓语、定语；指转好"},{"id":22841,"word":"改恶从善","pinyin":"gǎi è cóng shàn","abbr":"gecs","explanation":"指不再作恶犯罪，重做好人。","source":{"text":"务益兴礼让，讲信修睦，以为改恶从善者之倡。","book":"明·王守仁《告谕安义等县渔户》"},"example":{"text":"既肯～，也不与你一般样见识。","book":"清·张南庄《何典》第八回"},"similar":["改过迁善","改邪归正","弃暗投明"],"opposite":["负隅顽抗","顽固不化","死不改悔"],"usage":"作谓语、定语；指转好"},{"id":22842,"word":"改恶向善","pinyin":"gǎi è xiàng shàn","abbr":"gexs","explanation":"指不再做恶，重新做好人。","source":{"text":"尊上帝好生之德，再休题妄想贪嗔，从今改恶向善，朝上帝礼拜三清。","book":"明·无名氏《齐天大圣》第四折"},"example":{"text":"皇上犹冀其～，由赐矜全，乃士俊丧心病狂，妄发悖论，请明正其罪。","book":"《清史稿·王士俊传》"},"similar":["改恶从善"],"opposite":["死不悔改"],"usage":"作谓语、定语；指重新做好人"},{"id":22843,"word":"改恶行善","pinyin":"gǎi è xíng shàn","abbr":"gexs","explanation":"不再做恶，转做好事。","source":{"text":"夫欲修学，熟寻此文，改恶行善，速登神仙。","book":"宋·张君房《云笈七签》第九十一卷"},"similar":["改恶从善"],"opposite":["死不悔改"],"usage":"作谓语；指重新做好人"},{"id":22844,"word":"改换头面","pinyin":"gǎi huàn tóu miàn","abbr":"ghtm","explanation":"比喻改变身份。","source":{"text":"却说鲜于同自吟了这八句诗，其志愈锐。怎奈时运不利，看看五十齐头，‘苏秦还是旧苏秦’，不能勾改换头面。","book":"明·冯梦龙《警世通言》第十八卷"},"usage":"作谓语、定语；用于处世"},{"id":22845,"word":"改换家门","pinyin":"gǎi huàn jiā mén","abbr":"ghjm","explanation":"提高家庭的社会地位。","source":{"text":"若到阵上一战成功，但得一官半职，改换家门，可也母亲训子有功也。","book":"元·王仲文《救孝子》第一折"},"example":{"text":"着孙荣兄弟进取功名去，得一官半职，～，可不好那。","book":"明·无名氏《勘金环》楔子"},"similar":["改换门庭"],"usage":"作谓语、宾语、定语；指改换门庭"},{"id":22846,"word":"改换门庭","pinyin":"gǎi huàn mén tíng","abbr":"ghmt","explanation":"比喻另择新主，另找依靠。","source":{"text":"如今长期失业在家，回英国府的希望越来越渺茫了，得早日改换门庭，另找洋主子才好。","book":"老舍《四世同堂》九四"},"example":{"text":"老舍《四世同堂》：“如今长期失业在家，回英国府的希望越来越渺茫了，得早日～，另找洋主子才好。”"},"similar":["改换家门","改换门闾"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":22847,"word":"改换门楣","pinyin":"gǎi huàn mén méi","abbr":"ghmm","explanation":"门楣：门框上的横木。改变门第出身，提高家庭的社会地位。","source":{"text":"为士者，日思居官清要，而畎亩庶人，日督其稚顽子弟儒冠儒服，梦想科第，改换门楣。","book":"明·宋应星《风俗议》"},"similar":["改换门闾","改换门庭"],"usage":"作谓语、宾语、定语；指改换门庭"},{"id":22848,"word":"改换门闾","pinyin":"gǎi huàn mén lǘ","abbr":"ghml","explanation":"闾：里巷的门。改变门第出身，提高家庭的社会地位。","source":{"text":"[外怒介]畜生，我教你去赴选，也只是要改换门闾，光显祖宗，你却七推八阻，有许多说话。","book":"宋·无名氏《张协状元》戏文第四六出：“一意要读诗书，一身望改换门闾。”元·高明《琵琶记》第四出"},"example":{"text":"风云太蹊跷后庭炎热，前院萧条无端避湿争趋燥，做个狗尾儿郎去续貂，我和你～定在这遭。","book":"清·李渔《凰求凤·货谋》"},"similar":["改换家门","改换门庭"],"usage":"作谓语、宾语、定语；指改换门庭"},{"id":22849,"word":"改操易节","pinyin":"gǎi cāo yì jié","abbr":"gcyj","explanation":"改、易：改变。改变原来的操行和志向。","source":{"text":"自春讫夏，寇乱尽平，诸幽邃巴、醴、由、诞邑侯君长，皆改操易节，奉礼请见，郡境遂清。","book":"《三国志·吴志·黄盖传》"},"similar":["改节易操"],"usage":"作谓语、宾语、定语；用于行为改变等"},{"id":22850,"word":"改政移风","pinyin":"gǎi zhèng yí fēng","abbr":"gzyf","explanation":"改变风气习俗。","source":{"text":"夫改政移风，必有其本。长安语曰：‘城中好高髻，四方高一尺；城中好广眉，四方且半额；城中好广袖，四方用匹帛。’","book":"《东观汉记·马廖传》"},"similar":["移风易俗"],"usage":"作谓语、宾语、定语；用于风俗等"},{"id":22851,"word":"改是成非","pinyin":"gǎi shì chéng fēi","abbr":"gscf","explanation":"是：正确的，对的；非：错误的。把正确的改成错误的。指颠倒是非。","source":{"text":"俺请受了人几文钱改是成非，似这般所为，碜可可的话取民心髓。","book":"元·岳伯川《铁拐李》第三折"},"similar":["颠倒是非"],"usage":"作谓语、定语；用于处事"},{"id":22852,"word":"改曲易调","pinyin":"gǎi qǔ yì diào","abbr":"gqyd","explanation":"比喻改变策略或做法。","source":{"text":"臣窃亮陛下潜神默思，公听并观，若事有未尽于理而物有未周于用，将改曲易调，远与黄唐角功，近昭武文之迹，岂近习而已哉！","book":"《三国志·魏志·蒋济传》"},"similar":["改弦易调","改弦更张"],"usage":"作谓语、宾语、定语；用于行为等"},{"id":22853,"word":"改朝换代","pinyin":"gǎi cháo huàn dài","abbr":"gchd","explanation":"旧的朝代为新的朝代所代替。","source":{"text":"总是在革命中和革命后被地主和贵族利用了去，当作他们改朝换代的工具。","book":"毛泽东《中国革命和中国共产党》"},"example":{"text":"真是～了。学生也来管闲事！他们要到苏货铺里检查东洋货。","book":"茅盾《虹》"},"similar":["改头换面"],"opposite":["铁打江山"],"usage":"作宾语、定语；指政权更替","story":["赵匡胤帮助周世宗打了很多胜仗，立了许多功劳，被周世宗封为殿前都点检。周世宗病故，8岁的梁王宗训当皇帝，北汉刘钧和辽兵联合入侵，赵匡胤奉命率军出征，到了陈桥驿，亲信楚昭辅、苗训、赵匡义拥立他为皇帝，改国号宋"]},{"id":22854,"word":"改朝换姓","pinyin":"gǎi cháo huàn xìng","abbr":"gchx","explanation":"旧的朝代为新的朝代所代替。同“改朝换代”。","source":{"text":"中国历代改朝换姓的时侯，兵权大的就争王争侯。","book":"孙中山《民权主义》第一讲"},"similar":["改朝换代"],"usage":"作宾语、定语；指政权更替"},{"id":22855,"word":"改柯易叶","pinyin":"gǎi kē yì yè","abbr":"gkyy","explanation":"指枝叶凋败。比喻人品蜕变。","source":{"text":"其在人也，如竹箭之有筠也，如松柏之有心也；二者居天下之大端矣，故贯四时而不改柯易叶。","book":"《礼记·礼器》"},"example":{"text":"言必信，行必果，久要不忘平生之言，贯四时而不～者，盖有之矣，我未见之也。","book":"章炳麟《革命道德说》"},"similar":["改柯易节"],"usage":"作谓语、定语；用于行为等"},{"id":22856,"word":"改柯易节","pinyin":"gǎi kē yì jié","abbr":"gkyj","explanation":"改变枝叶。比喻改变操行、气节。","source":{"text":"其在人也，如竹箭之有筠也，如松柏之有心也，二者居天下之大端矣，故贯四时而不改枝易叶。","book":"《礼记·礼器》"},"example":{"text":"凡立身行己，利物济人，皆吾本分内事，即便磨竭终身，必不～。","book":"清·李盘《与李仲林》"},"similar":["改柯易叶"],"usage":"作谓语、定语；用于行为等"},{"id":22857,"word":"改柱张弦","pinyin":"gǎi zhù zhāng xián","abbr":"gzzx","explanation":"改换琴柱，另张琴弦。比喻改革制度或变更方法。","source":{"text":"玉陛舒奇抱，看琐尾啼饥众纷扰，惟改柱张弦，抡才访道。","book":"明·陈汝元《金莲记·射策》"},"usage":"作谓语、宾语、定语；用于行为等"},{"id":22858,"word":"改梁换柱","pinyin":"gǎi liáng huàn zhù","abbr":"glhz","explanation":"比喻玩弄手法，暗中改变事物的内容或事情的性质。","source":{"text":"便是胡適和梁任也都很知道他这种宗教的循环论证不足以满足我们近代人的要求，所以极力在用改梁换柱的方法，要把他的根本观念改移到另一个较为好看一点的节目上去。","book":"郭沫若《文艺论集读·梁任公〈墨子新社会之组织法〉》"},"example":{"text":"他极力用～的办法来推销他的强盗逻辑"},"similar":["偷梁换柱"],"usage":"作谓语、定语、宾语；指以假代真"},{"id":22859,"word":"改步改玉","pinyin":"gǎi bù gǎi yù","abbr":"gbgy","explanation":"步：古代祭祀时祭者与尸相距的步数，以地位排列。改变步数，改换玉饰。指死者身份改变，安葬礼数也应变更。","source":{"text":"六月，季平子行东野，还，未至；丙申，卒于房。阳虎将以玙璠（君所配玉）敛，仲梁怀弗与，曰：‘改步改玉。’","book":"《左传·定公五年》"},"similar":["改玉改步","改玉改行","改朝换代"],"usage":"作谓语、宾语；借指改朝换代","story":["春秋时期，鲁定公五年六月，季平子到东野视察回来，还没有到家就死在路上。家臣阳虎将玙璠与季平子一起入殓，仲梁怀不同意，他认为该改步改玉了，因为昭公已去，现在是定公执位，所以要改变制度了"]},{"id":22860,"word":"改玉改步","pinyin":"gǎi yù gǎi bù","abbr":"gygb","explanation":"步：古代祭祀时祭者与尸相距的步数，以地位排列。改换玉饰，改变步数。指地位身份改变，礼数也应变更。","source":{"text":"六月，季平子行东野，还，未至；丙申，卒于房。阳虎将以玙璠敛，仲梁怀弗与，曰：‘改步改玉。’","book":"《左传·定公五年》"},"example":{"text":"～，人无异心。","book":"清·章炳麟《革命之道德》"},"similar":["改玉改行","改步改玉"],"usage":"作谓语、宾语；借指改朝换代"},{"id":22861,"word":"改玉改行","pinyin":"gǎi yù gǎi xíng","abbr":"gygx","explanation":"指死者身份改变，安葬礼数也应变更。后指改变制度或改朝换代。同“改步改玉”。","source":{"text":"改玉改行。”’","book":"《国语·周语中》：“晋文公既定襄王于郏，王劳之以地，辞，请隧焉。王不许，曰：‘……先民有言曰"},"similar":["改玉改步","改步改玉"],"usage":"作谓语、宾语；借指改朝换代"},{"id":22862,"word":"改而更张","pinyin":"gǎi ér gèng zhāng","abbr":"gegz","explanation":"比喻改革制度或变更计划、方法。同“改弦更张”。","source":{"text":"琴瑟不调，改而更张，虽明旨已行，犹宜消息。","book":"《北史·崔鸿传》"},"similar":["改弦更张","改弦易张"],"usage":"作谓语、宾语；用于处事"},{"id":22863,"word":"改节易操","pinyin":"gǎi jié yì cāo","abbr":"gjyc","explanation":"改、易：改变。改变原来的操行和志向。","source":{"text":"自春讫夏，寇乱尽平，诸幽邃巴、醴、由、诞邑侯君长，皆改操易节，奉礼请见，郡境遂清。","book":"《三国志·吴志·黄盖传》"},"example":{"text":"彼有～者，必其始非真性，有矫而为之者。","book":"明·归有光《上王御史书》"},"similar":["改操易节"],"usage":"作谓语、宾语、定语；用于行为改变等"},{"id":22864,"word":"改行为善","pinyin":"gǎi xíng wéi shàn","abbr":"gxws","explanation":"改变不良行为，诚心向善。","source":{"text":"天子悲怜其意，遂下令曰：‘夫训导不纯，而愚民陷焉。或欲改行为善，其道无由也。’","book":"汉·荀悦《汉纪·文帝纪下》"},"similar":["改行迁善"],"usage":"作谓语、定语、宾语；用于行为等"},{"id":22865,"word":"改行从善","pinyin":"gǎi xíng cóng shàn","abbr":"gxcs","explanation":"改变不良行为，诚心向善。同“改行为善”。","source":{"text":"不若改行从善，做个小小经纪，也得过养身活命。","book":"《京本通欲小说·错斩崔宁》"},"similar":["改行迁善","改行为善"],"usage":"作谓语、定语、宾语；用于行为等"},{"id":22866,"word":"改行自新","pinyin":"gǎi xíng zì xīn","abbr":"gxzx","explanation":"改变行为，重新做人。","source":{"text":"今闻王改行自新，尊修经术，亲近仁人……朕甚嘉焉。","book":"《汉书·东平思王刘宇传》"},"example":{"text":"湖东路见今盗贼啸聚，动以数万……其间若有能～之人，未委合与不合招安？","book":"宋·岳飞《招安寇盗状》"},"similar":["改过自新"],"usage":"作谓语、定语、宾语；用于行为等"},{"id":22867,"word":"改行迁善","pinyin":"gǎi xíng qiān shàn","abbr":"gxqs","explanation":"改变不良行为，诚心向善。同“改行为善”。","source":{"text":"巡下车，以法诛之，赦余党，莫不改行迁善。","book":"《新唐书·张巡传》"},"similar":["改行为善"],"usage":"作谓语、定语、宾语；用于行为等"},{"id":22868,"word":"改辕易辙","pinyin":"gǎi yuán yì zhé","abbr":"gyyz","explanation":"辕：车辕；辙：车走过的痕迹，借指道路。改变车辕的方向，走新的路。比喻改变原来的态度和做法。","source":{"text":"其初改辕易辙，如枯弦敝轸，虽成声而跌宕不满人耳；少焉遂使师旷忘味，钟期改容也。","book":"宋·魏庆之《诗人玉屑·张秦》"},"example":{"text":"幸亏仙人搭救，教以～，寻师学艺，得于无意之间夫妻相遇，岂非时来福凑耶？（清·张南庄《何典》第六回）"},"similar":["改弦更张"],"usage":"作谓语、宾语；指改变原来的态度和做法"},{"id":22869,"word":"改辙易途","pinyin":"gǎi zhé yì tú","abbr":"gzyt","explanation":"辙：车行过的痕迹，指道路。改变行车道路，另走别的路。比喻改变方向、目标或做法。","source":{"text":"前车已覆，后车岂可蹑而行之，固当改辙易途，以取其不倾不蹶；道路之人，亦知此为至计，况廊庙帷幄之画，岂不以是为急哉。","book":"唐·杨夔《复宫阙后上执政书》"},"example":{"text":"勉吾子～而合同乎世俗，则告朋友不信，将如何而可？（明·朱之瑜《端亭记》）"},"similar":["改途易辙"],"usage":"作谓语、定语、宾语；用于行为等"},{"id":22870,"word":"改过不吝","pinyin":"gǎi guò bù lìn","abbr":"ggbl","explanation":"吝：可惜。改正错误态度坚决，不犹豫。","source":{"text":"用人惟己，改过不吝。","book":"《尚书·仲虺之诰》"},"example":{"text":"失之东隅，收之桑榆，则～，有光古人。","book":"清·陈梦雷《绝交书》"},"opposite":["死不悔改"],"usage":"作谓语、定语；指彻底改正错误"},{"id":22871,"word":"改过从善","pinyin":"gǎi guò cóng shàn","abbr":"ggcs","explanation":"改正错误，变成好的。指去恶就善。","source":{"text":"迁善改过，益莫大焉。","book":"《周易·益》：“君子以见善则迁，有过则改。”三国·魏·王弼注"},"example":{"text":"不知大舅怎生样劝喻，便能～。如此可见好人原容易做的，只在一转念耳。","book":"明·冯梦龙《醒世恒言》卷二十七"},"similar":["改过迁善"],"usage":"作谓语、宾语、定语；指去恶就善"},{"id":22872,"word":"改过从新","pinyin":"gǎi guò cóng xīn","abbr":"ggcx","explanation":"改正错误，重新做人。","source":{"text":"今当改过从新，毋敢再起。","book":"元·王实甫《西厢记》第一本第二折"}},{"id":22873,"word":"改过作新","pinyin":"gǎi guò zuò xīn","abbr":"ggzx","explanation":"指毫无保留地改正过错。同“改过自新”。","source":{"text":"陀满兴福，父母妻儿都杀戮，逃命潜奔，哨聚山林暂隐身，心阑意卸，天幸遭逢颁大赦，改过作新，作个清平无事人。","book":"元·施惠《幽闺记·会赦更新》"},"similar":["改过自新"],"usage":"作谓语、宾语；指重新做好人"},{"id":22874,"word":"改过自新","pinyin":"gǎi guò zì xīn","abbr":"ggzx","explanation":"自新：自觉改正，重新做人。改正错误，重新做起。","source":{"text":"妾伤夫死者不可复生，刑者不可复属，虽复欲改过自新，其道无由也。","book":"《史记·孝文本纪》"},"example":{"text":"子能～，弃越归吴，寡人必当重用。","book":"明·冯梦龙《东周列国志》第八十回"},"similar":["改过迁善","改邪归正","痛改前非"],"opposite":["顽固不化","死不改悔"],"usage":"作谓语、宾语；指重新做好人","story":["西汉名医淳于意一次犯法，官府把他押往长安，等待行剕刑和劓刑。他的女儿缇萦不忍父亲受极刑，给汉文帝上书，说：“一个犯罪的人也想改过自新……”汉文帝深受感动，就赦免了他的父亲，同时废除了宫剕、劓、耶、大辟等酷刑"]},{"id":22875,"word":"改过迁善","pinyin":"gǎi guò qiān shàn","abbr":"ggqs","explanation":"改正错误，变成好的。指去恶就善。","source":{"text":"迁善改过，益莫大焉。","book":"《周易·益》：“君子以见善则迁，有过则改。”三国·魏·王弼注"},"example":{"text":"此病云，自能～，服圣贤之训，得师友之益。","book":"宋·陆九渊《与张辅之书》其二"},"similar":["改恶从善"],"opposite":["顽固不化"],"usage":"作谓语、宾语、定语；指去恶就善"},{"id":22876,"word":"改途易辙","pinyin":"gǎi tú yì zhé","abbr":"gtyz","explanation":"改变行车轨道，另走一条路。比喻改变方向、目标或做法。同“改辙易途”。","source":{"text":"勉吾子改途易辙而合同乎世俗，则告朋友不信，将如何而可？","book":"清·朱之瑜《端亭记》"},"similar":["改辙易途"],"usage":"作谓语、定语、宾语；用于行为等"},{"id":22877,"word":"改邪归正","pinyin":"gǎi xié guī zhèng","abbr":"gxgz","explanation":"邪：不正当、不正派；归：回到。从邪路上回到正路上来，不再做坏事。","source":{"text":"将军弃邪归正，与宋某等同替国家出力，朝廷自当重用。","book":"明·施耐庵《水浒全传》第九十一回"},"example":{"text":"这才叫～，惩创善心。","book":"明·吴承恩《西游记》第十四回"},"similar":["改过自新","弃暗投明","舍邪归正"],"opposite":["执迷不悟","死不改悔"],"usage":"作谓语、宾语；指重新做人"},{"id":22878,"word":"攻乎异端","pinyin":"gōng hū yì duān","abbr":"ghyd","explanation":"《论语·为政》：“子曰：‘攻乎异端，斯害也已。’”","source":{"text":"既是儒流，读圣贤之书，焉有～之理。 ★清·石玉昆《三侠五义》第四回"},"example":{"text":"南朝·梁·任昉《王文宪集序》：“约己不以廉物，弘量不以容非。～，归之正义。”"},"usage":"作谓语、定语；用于书面语"},{"id":22879,"word":"攻其一点，不及其余","pinyin":"gōng qí yī diǎn，bù jí qí yú","abbr":"gqydbjqy","explanation":"对于人或事不从全面看，只是抓住一点就攻击。多指有偏见的批评。","source":{"text":"那些还不觉悟的人就冷眼旁观，吹毛求疵，攻其一点，不及其余。","book":"《新华半月刊》1959年第2期"},"usage":"作宾语、分句；指有偏见的批评"},{"id":22880,"word":"攻其不备","pinyin":"gōng qí bù bèi","abbr":"gqbb","explanation":"其：代词，指敌人。趁敌人还没有防备时进攻。","source":{"text":"攻其无备，出其不意。","book":"《孙子·计篇》"},"example":{"text":"素知此处庶民都是正人君子，所以不肯～，暗下毒手取鱼。","book":"清·李汝珍《镜花缘》第十三回"},"similar":["攻其无备"],"usage":"作主语、定语；用于军事上"},{"id":22881,"word":"攻其无备","pinyin":"gōng qí wú bèi","abbr":"gqwb","explanation":"其：代词，指敌人。趁敌人还没有防备时进攻。","source":{"text":"攻其无备，出其不意。","book":"春秋·齐·孙武《孙子·计篇》"},"example":{"text":"军志有之曰：‘～，出其不意。’","book":"晋·陈寿《三国志·魏志·邓艾传》"},"similar":["攻其不备"],"usage":"作主语、定语；用于军事上"},{"id":22882,"word":"攻其无备，出其不意","pinyin":"gōng qí wú bèi，chū qí bù yì","abbr":"gqwbcqby","explanation":"其：代词，指敌人；不意：没有料到。趁敌人还没有防备或没有意料时就采取行动。","source":{"text":"攻其无备，出其不意。此兵家之胜，不可先传也。","book":"《孙子·计篇》"},"example":{"text":"明·罗贯中《三国演义》第56回：“等主公出城劳军，乘势拿下，杀入城来，‘～也’。”"},"similar":["攻其无备","出其不意"],"usage":"作宾语、定语、分句；可分开使用"},{"id":22883,"word":"攻城夺地","pinyin":"gōng chéng duó dì","abbr":"gcdd","explanation":"攻：攻打，进攻。攻打城市，掠夺土地。","source":{"text":"那二十四员番将，又必各有跟随的番汉军士，共计当有万余人，行动与攻城夺地者何异！","book":"清·褚人获《隋唐演义》第87回"},"example":{"text":"他才觉出来日本人的～并不是与他毫无关系。","book":"老舍《四世同堂》"},"similar":["攻城掠地","攻城略地","攻城徇地"],"usage":"作谓语、宾语、定语；指征战"},{"id":22884,"word":"攻城徇地","pinyin":"gōng chéng xùn dì","abbr":"gcxd","explanation":"略：掠夺。攻打城市，掠夺土地。","source":{"text":"樊崇以穷困为寇，无攻城徇地之计。","book":"《后汉书·刘盆子传》"},"similar":["攻城略地","攻城掠地","攻城夺地"],"usage":"作谓语、宾语、定语；指征战"},{"id":22885,"word":"攻城掠地","pinyin":"gōng chéng lüě dì","abbr":"gcld","explanation":"掠夺土地。同“攻城略地”。","source":{"text":"李密诸将士，当时攻城掠地，倚着金帛来得易，也用得易。","book":"清·褚人获《隋唐演义》第54回"},"example":{"text":"好像在执行什么～的庄严神圣而又刻不容缓的使命，大有非把敌人逐出国门并踏为齑粉不可之势。","book":"孙荪《云赋》"},"similar":["攻城略地","攻城夺地","攻城徇地"],"usage":"作谓语、宾语、定语；指征战"},{"id":22886,"word":"攻城略地","pinyin":"gōng chéng lüè dì","abbr":"gcld","explanation":"《淮南子·兵略训》：“攻城略地，莫不降下。”","source":{"text":"英法联军侵华的那几年，法国海军附带在越南～。 ★高阳《清宫外史》下册"},"example":{"text":"元·杨显之《酷寒亭》第四折：“今天下事势方多，四下里竞起干戈，其大者～，小可的各有巢窠。”"},"similar":["攻城掠地","攻城夺地","攻城徇地"],"usage":"作谓语、宾语；指征战"},{"id":22887,"word":"攻城野战","pinyin":"gōng chéng yě zhàn","abbr":"gcyz","explanation":"城：城池。攻打城池，野外作战。","source":{"text":"攻城野战死者，不可胜数。","book":"《墨子·节用上》"},"example":{"text":"外之不能备行武，～，有斩将搴旗之功。","book":"汉·司马迁 《报任少卿书》"},"usage":"作谓语、定语；指四处打仗"},{"id":22888,"word":"攻大磨坚","pinyin":"gōng dà mó jiān","abbr":"gdmj","explanation":"攻打强大的力量，削磨坚硬的东西。形容做很难做到的事情。","source":{"text":"攻大磨坚，莫能与之争。","book":"《淮南子·原道训》"},"usage":"作宾语、定语；用于做事"},{"id":22889,"word":"攻守同盟","pinyin":"gōng shǒu tóng méng","abbr":"gstm","explanation":"原指国与国之间订立盟约，战时彼此联合进攻或防卫。现多指坏人互相订约，为掩盖罪恶而一致行动。","source":{"text":"可惜后来伊藤博文到津，何太真受了北洋之命，与彼立了攻守同盟的条约，我恐朝鲜将来有事，中、日两国，必然难免争端吧。","book":"清·曾朴《孽海花》第十八回"},"example":{"text":"日本既与英结英日同盟，及日俄战役方酣，又与韩结日韩～。","book":"清·梁启超《中国外交方针私议》"},"usage":"作宾语；指同伙间的串通合作"},{"id":22890,"word":"攻心为上","pinyin":"gōng xīn wèi shàng","abbr":"gxws","explanation":"从思想上瓦解敌人的斗志为上策。","source":{"text":"用兵之道，攻心为上，攻城为下。心战为上，兵战为下。","book":"《三国志·蜀志·马谡传》：“每引见谈论，自昼达夜。”裴松之注引《襄阳记》"},"example":{"text":"姐姐这叫做兵法～。","book":"清·文康《儿女英雄传》第三十回"},"usage":"作谓语、定语；指从思想上瓦解敌人的斗志"},{"id":22891,"word":"攻心扼吭","pinyin":"gōng xīn è kēng","abbr":"gxek","explanation":"比喻攻击要害。吭，指咽喉。","source":{"text":"先取山海关，则关外诸城唾手可得，此攻心扼吭之法也。","book":"清·魏源《圣武纪》卷一"},"usage":"作谓语、定语；用于斗争等"},{"id":22892,"word":"攻必克，守必固","pinyin":"gōng bì kè，shǒu bì gù","abbr":"gbksbg","explanation":"克：攻下据点，战胜；固：牢固，坚固。进攻没有打不下来的，防守没有不稳固的。形容战斗力极强。","source":{"text":"他才觉出来日本人的～并不是与他毫无关系。 ★老舍《四世同堂》"}},{"id":22893,"word":"攻无不克","pinyin":"gōng wú bù kè","abbr":"gwbk","explanation":"克：攻下。没有攻占不下来的。形容力量无比强大。","source":{"text":"是知秦战未尝不胜，攻未尝不取，所当未尝不破也。","book":"《战国策·秦策二》"},"example":{"text":"中国人民解放军～，战无不胜，所向披靡。"},"similar":["战无不胜"],"opposite":["望风而逃"],"usage":"作谓语、定语；形容力量无比强大"},{"id":22894,"word":"攻无不克，战无不胜","pinyin":"gōng wú bù kè，zhàn wú bù shèng","abbr":"gwbkzwbs","explanation":"攻：攻打；克：攻克。没有攻占不下来的。形容力量无比强大。","source":{"text":"是知秦战未尝不胜，攻未尝不取，所当未尝不破也。","book":"西汉·刘向《战国策·秦策一》"},"example":{"text":"把这支部队说成是～的天将神兵。","book":"吴强《红日》"},"similar":["百战百胜"],"usage":"作谓语、定语、分句；形容力量无比强大"},{"id":22895,"word":"攻无不取，战无不胜","pinyin":"gōng wú bù qǔ，zhàn wú bù shèng","abbr":"gwbqzwbs","explanation":"没有攻占不下来的。形容力量无比强大。","source":{"text":"是知秦战未尝不胜，攻未尝不取，所当未尝不破也。","book":"《战国策·秦策二》"},"example":{"text":"中国人民解放军～，所向披靡。"},"similar":["攻无不克，战无不胜"],"usage":"作谓语、定语、分句；形容力量无比强大"},{"id":22896,"word":"攻玉以石","pinyin":"gōng yù yǐ shí","abbr":"gyys","explanation":"攻：加工，制造；以：借用。加工璞玉需借用他山之石。比喻以他人之长，治自己之短。","source":{"text":"它山之石，可以攻玉。","book":"《诗经·小雅·鹤鸣》"},"example":{"text":"《诗经·小雅·鹤鸣》：“它山之石，可以攻玉。”"},"usage":"作宾语、定语；用于比喻句"},{"id":22897,"word":"攻瑕指失","pinyin":"gōng xiá zhǐ shī","abbr":"gxzs","explanation":"批评缺点，指出失误。","source":{"text":"今此旧编，有尘清览。知我者当为攻瑕指失，俾得刊改以遗诸后人。","book":"清·顾炎武《与友人书》"},"usage":"作谓语、宾语；用于交往"},{"id":22898,"word":"攻瑕索垢","pinyin":"gōng xiá suǒ gòu","abbr":"gxsg","explanation":"批评不足，寻找缺点。","source":{"text":"吾侪本相好，攻瑕索垢，当猛鸷如寇雠，毋留纤尘，为后人口实。","book":"清·王晫《今世说·规箴》"},"usage":"作谓语、定语；用于书面语"},{"id":22899,"word":"攻瑕蹈隙","pinyin":"gōng xiá dǎo xì","abbr":"gxdx","explanation":"瑕：瑕疵；蹈：踩。攻击瑕疵，蹈住缝隙。比喻利用对方的弱点进行攻击。","source":{"text":"忠愤者因是以攻瑕蹈隙，欲致届幕府而先倡攮夷之议。","book":"章炳麟《读》"},"usage":"作谓语、定语、宾语；用于行动策略"},{"id":22900,"word":"攻疾防患","pinyin":"gōng jí fáng huàn","abbr":"gjfh","explanation":"匡正过失，防止祸患。","source":{"text":"箴者，所以攻疾防患，喻针石也。","book":"南朝·梁·刘勰《文心雕龙·铭箴》"},"usage":"作谓语、定语；用于书面语"},{"id":22901,"word":"攻苦茹酸","pinyin":"gōng kǔ rú suān","abbr":"gkrs","explanation":"指劳苦艰辛。","source":{"text":"母攻苦茹酸，和丸课子。","book":"明·袁宏道《寿洪太母七十序》"},"similar":["攻苦如酸"],"usage":"作谓语、定语；用于书面语"},{"id":22902,"word":"攻苦食俭","pinyin":"gōng kǔ shí jiǎn","abbr":"gksj","explanation":"犹攻苦食淡。形容刻苦自励。","source":{"text":"余举进士，不能攻苦食俭。","book":"明·王世贞《觚不觚录》"},"similar":["攻苦食淡","攻苦食啖"],"usage":"作谓语、定语；用于生活"},{"id":22903,"word":"攻苦食啖","pinyin":"gōng kǔ shí dàn","abbr":"gksd","explanation":"做艰苦的工作，吃清淡的食物。形容刻苦自励。啖，亦作“淡”。同“攻苦食淡”。","source":{"text":"吕后与陛下攻苦食啖，其可背哉。","book":"《史记·刘敬叔孙通列传》"},"similar":["攻苦食淡"],"usage":"作谓语、定语；用于生活"},{"id":22904,"word":"攻苦食淡","pinyin":"gōng kǔ shí dàn","abbr":"gksd","explanation":"攻：做；若：艰苦；淡：清淡。做艰苦的工作，吃清淡的食物。形容刻苦自励。","source":{"text":"吕后与陛下攻苦食啖（淡）。","book":"《史记·刘敬叔孙通列传》"},"example":{"text":"得瑗所授经，熟读精思，～，夏不扇，冬不炉，夜不安枕者逾年。","book":"《宋史·徐中行传》"},"similar":["攻苦食啖"],"usage":"作谓语；形容不求享乐，辛勤自励"},{"id":22905,"word":"攻过箴阙","pinyin":"gōng guò zhēn què","abbr":"ggzq","explanation":"指责过错，针砭缺失。","source":{"text":"进则切辞正论，攻过箴阙；退则端诚杜私，知无不为者。","book":"晋·葛洪《抱朴子·汉过》"},"usage":"作谓语、宾语；用于书面语"},{"id":22906,"word":"放下包袱","pinyin":"fàng xià bāo fú","abbr":"fxbf","explanation":"放：安放，搁置。丢开思想包袱，消除精神上的负担。","source":{"text":"为了争取新的胜利，要在党的干部中间提倡放下包袱和开动机器。","book":"毛泽东《学习和时局》"},"example":{"text":"中国不在意这个问题，请他们～。","book":"邓小平《我们有信心把中国的事情做得更好》"},"opposite":["忍辱负重"],"usage":"作谓语；指消除精神上的负担"},{"id":22907,"word":"放下屠刀","pinyin":"fàng xià tú dāo","abbr":"fxtd","explanation":"放：安放，搁置；屠刀：宰杀牲畜的刀。佛教语，劝人改恶从善。比喻作恶的人决心改过。","source":{"text":"只不迁不贰，是甚力量，便见工夫，佛家所谓放下屠刀，立地成佛。","book":"宋·朱熹《朱子语类》第30卷"},"example":{"text":"帝国主义分子决不肯～，他们也决不能成佛，直至他们的灭亡。","book":"毛泽东《丢掉幻想，准备斗争》"},"usage":"作谓语、定语；用于劝诫人"},{"id":22908,"word":"放下屠刀，立便成佛","pinyin":"fàng xià tú dāo，lì biàn chéng fó","abbr":"fxtdlbcf","explanation":"放：安放，搁置；屠刀：宰杀牲畜的刀。佛教语，劝人改恶从善。比喻作恶的人决心改过，就能变成好人。","source":{"text":"屠儿在涅槃会上，放下屠刀，立便成佛。","book":"明·彭大翼《山堂肆考·微集》第一卷"},"similar":["放下屠刀，立地成佛"],"opposite":["屡教不改"],"usage":"作谓语、定语、分句；用于劝诫人"},{"id":22909,"word":"放下屠刀，立地成佛","pinyin":"fàng xià tú dāo，lì dì chéng fó","abbr":"fxtdldcf","explanation":"佛家劝人改恶从善的话。比喻作恶的人一旦认识了自己的罪行，决心改过，仍可以很快变成好人。","source":{"text":"广额正是个杀人不眨眼底汉，放下屠刀，立地成佛。","book":"宋·释普济《五灯会元》卷五十三"},"example":{"text":"从来说：“孽海茫茫，回头是岸；放下屠刀，立地成佛。”","book":"清·文康《儿女英雄传》第二十一回"},"similar":["痛改前非","放下屠刀，立便成佛"],"opposite":["死不改悔","屡教不改"],"usage":"作谓语、分句；可以分开使用"},{"id":22910,"word":"放之四海而皆准","pinyin":"fàng zhī sì hǎi ér jiē zhǔn","abbr":"fzshejz","explanation":"四海：古人认为中国四境有海环绕，故称全国为“四海”；准：准确。比喻具有普遍性的真理到处都适用。","source":{"text":"推而放诸东海而准，推而放诸西海而准，推而放诸南海而准，推而放诸北海而准。","book":"《礼记·祭义》"},"example":{"text":"马克思、恩格斯、列宁、斯大林的理论，是“～”的理论。","book":"毛泽东《中国共产党在民族战争中的地位》"},"similar":["放诸四海而皆准"],"usage":"作谓语、定语；指普遍性的真理"},{"id":22911,"word":"放任自流","pinyin":"fàng rèn zì liú","abbr":"frzl","explanation":"听凭自然的发展，不加领导或过问。","source":{"text":"夫地势水东流，人必事焉，然后水潦得谷行；禾稼春生，人必加功焉，故五谷得遂长。听其自流，待其自生，则鲧禹之功不立，而后稷之智不用。","book":"《淮南子·修务训》"},"example":{"text":"对中小学生的校外活动，要加强辅导，不能～。"},"similar":["听之任之","任其所为"],"opposite":["防微杜渐","防患未然"],"usage":"作谓语、宾语、定语；指听之任之"},{"id":22912,"word":"放僻淫佚","pinyin":"fàng pì yín yì","abbr":"fpyy","explanation":"肆意为非作歹。亦指肆无忌惮、邪恶不正。","source":{"text":"若开其锐端，而纵之放僻淫佚，而禁之以法，随之以刑，虽残贼天下，不能禁其奸矣。","book":"《文子·下德》"},"similar":["放辟淫侈"],"usage":"作谓语、定语；多用于坏人"},{"id":22913,"word":"放僻邪侈","pinyin":"fàng pì xié chǐ","abbr":"fpxc","explanation":"宋·王安石《上仁宗皇帝言事书》：“人情足于财而无礼以节之，则又放僻邪侈，无所不至。”","source":{"text":"院中肄业生……虽所讲亦不过俗学，然所汲汲在此，则一切～之事，究竟无暇兼为之。 ★清·梁章钜《归田锁记·读书》"},"example":{"text":"清·梁章钜《归田琐记·读书》：“虽所讲亦不过俗学，然所汲汲在此，则一切～之事，究竟无暇兼为之。”"},"similar":["放辟邪侈"],"usage":"作谓语、定语；指肆意作恶"},{"id":22914,"word":"放冷箭","pinyin":"fàng lěng jiàn","abbr":"flj","explanation":"乘人不备，放箭伤人。比喻暗中伤人。冷箭：暗箭。","source":{"text":"你们休放冷箭，报复去，道有孔目孙荣特地拜见哥哥来。","book":"元·高文秀《黑旋风》第一折"},"example":{"text":"我对于‘～’的解释，颇有些和他们一流不同，是说有人受伤，而不知这箭从什么地方射出。","book":"鲁迅《华盖集续编·无花的蔷薇》"},"similar":["暗箭伤人"],"usage":"作谓语、宾语、定语；用于处事"},{"id":22915,"word":"放刁把滥","pinyin":"fàng diāo bǎ làn","abbr":"fdbl","explanation":"指刁难敲诈，胡作非为。","source":{"text":"他父亲王砉是东京大户，专一打点衙门，擸唆结讼，放刁把滥，排陷良善，因此人都让他些个。","book":"明·施耐庵《水浒传》第一○一回"},"usage":"作谓语、定语；用于为人处世"},{"id":22916,"word":"放刁撒泼","pinyin":"fàng diāo sā pō","abbr":"fdsp","explanation":"放：使用；刁：无赖，刁滑；撒泼：蛮不讲理。指使用刁钻狡猾的一套手段。形容极不讲理。","source":{"text":"俺两个全仗俺父亲的虎威，拿粗挟细，揣歪捏怪，帮闲钻懒，放刁撒泼。","book":"元·无名氏《陈州粜米》楔子"},"example":{"text":"那陈师叟怎么肯罢，～，别着晁梁足足的赔了他一千“老黄边”才走散了。","book":"清·西周生《醒世姻缘传》第九十二回"},"similar":["蛮横无理"],"usage":"作谓语、宾语、定语；指不讲理"},{"id":22917,"word":"放在眼里","pinyin":"fàng zài yǎn lǐ","abbr":"fzyl","explanation":"指重视，看得起。","source":{"text":"赵温虽说新中举，无奈他是少年新进，王乡绅还不把他放在眼里。","book":"清·李宝嘉《官场现形记》第一回"}},{"id":22918,"word":"放屁添风","pinyin":"fàng pì tiān fēng","abbr":"fptf","explanation":"比喻在一边助威。","source":{"text":"兄弟，你虽无甚本事，好道也是个人。俗云：‘放屁添风。’你也可壮我些胆气。","book":"明·吴承恩《西游记》第七十五回"},"similar":["推波助澜"],"usage":"作谓语、宾语、定语；用于助势"},{"id":22919,"word":"放心剚刃","pinyin":"fàng xīn zì rèn","abbr":"fxzr","explanation":"剚刃：用刀束进去。放心大胆地用刀刺人身体。比喻给人扣上大罪名，明目张胆地把人置于死地。","source":{"text":"梁叟患夫黎丘兮，丁厥子而剚刃。","book":"汉·张衡《思玄赋》"}},{"id":22920,"word":"放心托胆","pinyin":"fàng xīn tuō dǎn","abbr":"fxtd","explanation":"放得下心，无所顾忌而胆大。指因无牵挂不存戒备。","source":{"text":"料必不敢来割稻，所以放心托胆。","book":"明·冯梦龙《醒世恒言》卷三十四"},"example":{"text":"如今且把关前关后各路地面都收服了，使无后顾之忧，方可～杀向前去。","book":"清·张南庄《何典》第九回"},"usage":"作谓语、宾语、状语；指放心"},{"id":22921,"word":"放心解体","pinyin":"fàng xīn jiě tǐ","abbr":"fxjt","explanation":"指人心离散、瓦解。","source":{"text":"《墨子·尚贤下》：“是故以赏不当贤，罚不当暴，其所赏者已无故矣，其所罚者亦无罪，是以使百姓皆放心解体。”“放”，一本作“攸”。"},"usage":"作谓语、定语；用于团体"},{"id":22922,"word":"放情丘壑","pinyin":"fàng qíng qiū hè","abbr":"fqqh","explanation":"指纵情游山玩水，不以世务为念。丘壑，泛指山水。","source":{"text":"安虽放情丘壑，然每游赏，必以妓女从。","book":"《晋书·谢安传》"},"usage":"作谓语、宾语；用于人"},{"id":22923,"word":"放意肆志","pinyin":"fàng yì sì zhì","abbr":"fysz","explanation":"纵情而无所顾忌。","source":{"text":"时相与登览，放意肆志焉。","book":"宋·苏轼《超然台记》"},"example":{"text":"极而至于颐丰之尚同，犹未若今日之～以侮玩圣言也。","book":"宋·陈亮《传注策》"},"usage":"作谓语、定语；用于处事"},{"id":22924,"word":"放枭囚凤","pinyin":"fàng xiāo qiú fèng","abbr":"fxqf","explanation":"枭：鸱鸮，猫头鹰一类，被认为是恶鸟。把鸱鸮放走，却关起了凤凰。比喻纵容凶恶，虐待贤良。","source":{"text":"耽与议郎曹操上言：公卿所举，率党其私，所谓放鸮枭而囚鸾凤。","book":"《后汉书·刘陶传》"}},{"id":22925,"word":"放歌纵酒","pinyin":"fàng gē zòng jiǔ","abbr":"fgzj","explanation":"放歌：高声歌唱；纵酒：任意饮酒，不加节制。尽情歌唱，放量地饮酒。形容开怀畅饮尽兴欢乐。","source":{"text":"白日放歌须纵酒，青春作伴好还乡。","book":"唐·杜甫《闻官军收河南河北》"},"usage":"作谓语；形容开怀畅饮尽兴欢乐"},{"id":22926,"word":"放泼撒豪","pinyin":"fàng pō sā háo","abbr":"fpsh","explanation":"耍无赖，仗势压人。","source":{"text":"决心放泼撒豪的李胡子，伸手抓下头上的垮皮帽，在方桌上使劲一掼，冲着孟二胡子喊：‘出去！’","book":"克非《春潮急》三十"},"similar":["仗势欺人"],"usage":"作谓语、宾语、定语；用于为人"},{"id":22927,"word":"放浪不拘","pinyin":"fàng làng bù jū","abbr":"flbj","explanation":"放纵任性，不加检点，不受约束。同“放浪不羁”。","source":{"text":"她又常和妓女们来往，她满意自己的权威，可是也羡慕她们的放浪不拘。","book":"老舍《四世同堂》三七"},"similar":["放浪无羁","放浪无拘","放荡不羁"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":22928,"word":"放浪不羁","pinyin":"fàng làng bù jī","abbr":"flbj","explanation":"羁：约束。放纵任性，不加检点，不受约束。","source":{"text":"少以才学知名，而放荡不羁，州府辟命皆不就。","book":"《晋书·王长文传》"},"example":{"text":"他是个～的人，便辞了职，游山水，喝酒，作诗。","book":"朱自清《诗第十二》"},"similar":["放荡不羁"],"usage":"作定语、宾语；指行为放纵"},{"id":22929,"word":"放浪形骸","pinyin":"fàng làng xíng hái","abbr":"flxh","explanation":"放浪：放荡；形骸：人的形体。指行动不受世俗礼节的束缚。","source":{"text":"或因寄所托，放浪形骸之外。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"惟有与宝在一起，他才可以忘却自己的身份，～，领略“人贵适意”的真趣。","book":"高阳《玉座珠帘》上册"},"similar":["放荡不羁","倜傥不羁"],"opposite":["循规蹈矩","规行矩步"],"usage":"作谓语、定语；形容人很放荡"},{"id":22930,"word":"放浪无拘","pinyin":"fàng làng wú jū","abbr":"flwj","explanation":"放纵任性，不加检点，不受约束。同“放浪不羁”。","source":{"text":"建性耽酒，放浪无拘。","book":"元·辛文房《唐才子传·王建》"},"similar":["放浪无羁","放诞不拘"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":22931,"word":"放浪无羁","pinyin":"fàng làng wú jī","abbr":"flwj","explanation":"放纵任性，不加检点，不受约束。同“放浪不羁”。","source":{"text":"法朋半是奇逸者，我亦放浪无羁人。","book":"宋·惠洪《遇如无象于石霜，如与睿廓然相好，故赠之》诗"},"similar":["放浪不拘","放浪无拘","放荡不羁"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":22932,"word":"放浪江湖","pinyin":"fàng làng jiāng hú","abbr":"fljh","explanation":"放浪：放纵，不受任何约束。在江湖各地无拘无束地生活。","source":{"text":"翱翔天地，放浪江湖。","book":"元·谷子敬《城南柳》第一折"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第11卷：“抑且幼无父母，无些拘束，终日吟风弄月，～。”"},"similar":["浪迹江湖"],"usage":"作谓语、定语；形容人生飘泊"},{"id":22933,"word":"放火烧山","pinyin":"fàng huǒ shāo shān","abbr":"fhss","explanation":"比喻煽风点火，挑拨离间。","source":{"text":"你不知道，那狼叼豹咬的齐占杰，前一阵可光在我面前放火烧山呀！","book":"康濯《东方红》"},"example":{"text":"他尽干些～的事情。"},"similar":["煽风点火"],"usage":"作谓语、宾语；指挑拨离间"},{"id":22934,"word":"放烟幕弹","pinyin":"fàng yān mù dàn","abbr":"fymd","explanation":"比喻制造假象，掩盖真相。","example":{"text":"她这样做叫做故意～。"},"usage":"作谓语、宾语；指制造假象"},{"id":22935,"word":"放牛归马","pinyin":"fàng niú guī mǎ","abbr":"fngm","explanation":"把作战用的牛马牧放。比喻战争结束，不再用兵。","source":{"text":"乃偃武修文，归马于华山之阳，放牛于桃林之野，示天下弗服。","book":"《尚书·武成》"},"example":{"text":"吾祖父遭明代盛时，二百年之间，～，天下习之。","book":"清·侯方域《赠季弟序》"},"similar":["偃武修文"],"usage":"作谓语、定语；指不再用兵","story":["商朝末年，商纣王荒淫无度，百姓怨声载道。周武王率领大军把商都包围起来，商纣王登上鹿台放火自杀。周武王建立周朝，定都镐京，让士兵回家从事农业生产，把征用的牛马全部退还，让全国老百姓过上安居乐业的日子"]},{"id":22936,"word":"放眼世界","pinyin":"fàng yǎn shì jiè","abbr":"fysj","explanation":"放眼：放开眼界，目光不局限在狭小范围内。放开眼界，纵观天下。也作“放眼乾坤”。","source":{"text":"要从大局看问题，放眼世界，放眼未来，也放眼当前，放眼一切方面。","book":"邓小平《组成一个实行改革的有希望的领导集体》"},"example":{"text":"青年人应～，放眼未来。"},"usage":"作谓语、宾语、定语；指看问题"},{"id":22937,"word":"放空气","pinyin":"fàng kōng qì","abbr":"fkq","explanation":"比喻有意制造某种气氛或散布某种消息。","example":{"text":"他又在故意～，你得提防。"},"usage":"作谓语、宾语、定语；用于散布消息"},{"id":22938,"word":"放空炮","pinyin":"fàng kōng pào","abbr":"fkp","explanation":"发射出去的炮弹未击中目标。比喻说话未达到目标。","example":{"text":"他尽在这里～。"},"usage":"作谓语、宾语；指说空话"},{"id":22939,"word":"放纵不拘","pinyin":"fàng zòng bù jū","abbr":"fzbj","explanation":"指恣意行事，不受约束。同“放纵不羁”。","source":{"text":"竦博学通达，以谦俭自守，而遵放纵不拘，操行虽异，然相亲友。","book":"《汉书·游侠传·陈遵》"},"similar":["放纵不羁"],"opposite":["安分守己"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":22940,"word":"放纵不羁","pinyin":"fàng zòng bù jī","abbr":"fzbj","explanation":"指恣意行事，不受约束。","source":{"text":"濛少时放纵不羁，不为乡曲所齿，晚节始克己励行，有风流美誉。","book":"《晋书·外戚传·王濛》"},"example":{"text":"有一少年子，～……乃不娶妻，不事生产作业，每以轻财仗义为志。","book":"明·陶宗仪《辍耕录·飞云渡》"},"similar":["放荡不羁","放纵不拘"],"opposite":["安分守己"],"usage":"作谓语、定语、宾语；指不受约束","story":["晋朝时期，哀靖皇后的父亲王濛年轻时行为放纵不羁，经常惹出一些事来，邻居远远逃避他，年纪大了后他决定不再虚度年华，严格要求自己，检点言行。他的隶书和绘画都非常好，志趣高远，受到世人的尊敬"]},{"id":22941,"word":"放纵驰荡","pinyin":"fàng zòng chí dàng","abbr":"fzcd","explanation":"放纵：无拘束。驰：乱跑。荡：游荡。没有管束地乱跑乱逛。形容不求进步，到处游荡。","source":{"text":"近来仗着祖母的溺爱，父母亦不能十分严紧拘管，更觉放纵驰荡，任情恣性，最不喜务正。","book":"清·曹雪芹《红楼梦》第十九回"}},{"id":22942,"word":"放羊拾柴","pinyin":"fàng yáng shí chái","abbr":"fysc","explanation":"指老人娶妻，有意不加管束，希望能怀孕，从而得到名份上的儿子。","example":{"text":"～的典故很少有人知道。"},"usage":"作宾语、定语；用于比喻句"},{"id":22943,"word":"放荡不羁","pinyin":"fàng dàng bù jī","abbr":"fdbj","explanation":"羁：约束。放纵任性，不加检点，不受约束。","source":{"text":"少以才学知名，而放荡不羁，州府辟命皆不就。","book":"《晋书·王长文传》"},"example":{"text":"平时与一班好朋友，只以诗酒娱心，或以山水纵目，～。","book":"明·凌濛初《初刻拍案惊奇》卷十六"},"similar":["放浪形骸"],"opposite":["循规蹈矩","规行矩步"],"usage":"作谓语、定语、宾语；指不受约束","story":["晋朝时期，王长文自幼刻苦好学，性格孤僻，放荡不羁，从不把州府的征召放在眼里。州里召他为别驾，他偷偷地出走。他闭门不出潜心写字，他著书四卷《通玄经》。晋武帝时四川天旱，官府开仓借粮，他借了很多无法偿还而惹官司"]},{"id":22944,"word":"放荡形骸","pinyin":"fàng dàng xíng hái","abbr":"fdxh","explanation":"行为放纵，不拘礼节。","source":{"text":"尽着他放荡形骸，我可也万千事，不折证。","book":"元·无名氏《争报恩》第二折"},"example":{"text":"彼～者，安得如此肉锅子以锔之哉！","book":"清·和邦额《夜谭随录·锔人》"},"similar":["放荡不羁"],"opposite":["规行矩步"],"usage":"作谓语、定语；指放纵自己"},{"id":22945,"word":"放荡驰纵","pinyin":"fàng dàng chí zòng","abbr":"fdcz","explanation":"驰：乱跑。没有管束地乱跑乱逛。形容不求进步，到处游荡。","source":{"text":"近来仗着祖母的溺爱，父母亦不能十分严紧拘管，更觉放荡驰纵，任性恣情，最不喜务正。","book":"清·曹雪芹《红楼梦》第19回"},"usage":"作谓语、宾语；用于为人"},{"id":22946,"word":"放虎归山","pinyin":"fàng hǔ guī shān","abbr":"fhgs","explanation":"把老虎放回山去。比喻把坏人放回老巢，留下祸根。","source":{"text":"璋遣法正迎刘备，巴谏曰：‘备，雄人也，入必为害，不可内也。’既入，巴复谏曰：‘若使备讨张鲁，是放虎于山林也。’璋不听。","book":"晋·司马彪《零陵先贤传》"},"quote":{"text":"倘若一朝走了，便如～，纵龙归海，是自遗害也！","book":"明·朱有燉《义勇辞金》楔子"},"similar":["养虎为患","养虎遗患"],"opposite":["除恶务尽","斩草除根"],"usage":"作谓语、定语、宾语；指自留祸根","story":["东汉末年，刘备处境艰难就去投奔曹操。曹操的谋士程昱知道刘备不是等闲之辈，劝曹操尽早除掉刘备。刘备为麻痹曹操，装做种菜不问政治。曹操灭了吕布后，刘备请求带兵攻打袁术，曹操给了五万军马，刘备离开曹操自立旗号"]},{"id":22947,"word":"放虎自卫","pinyin":"fàng hǔ zì wèi","abbr":"fhzw","explanation":"放出老虎来保卫自己。比喻利用坏人而自招灾祸。","source":{"text":"此所谓独坐穷山，放虎自卫者也。","book":"晋·常璩《华阳国志·公孙述刘二牧志》"},"example":{"text":"得缓须臾策亦妙，～且勿消。","book":"清·许楣《粮勇歌》"},"usage":"作宾语、补语；比喻利用坏人而自招灾祸"},{"id":22948,"word":"放虎遗患","pinyin":"fàng hǔ yí huàn","abbr":"fhyh","explanation":"放掉老虎，留下后患。","source":{"text":"夫蕃戎之性，人面兽心，亲之则顺，疑之则乱……今阻其善，逆其欢心，古人所谓放虎遗患，不可不察。","book":"唐·陈子昂《上西蕃边州安危事》之一"},"similar":["放虎归山"],"usage":"作谓语、定语、宾语；指自留祸根"},{"id":22949,"word":"放言遣辞","pinyin":"fàng yán qiǎn cí","abbr":"fyqc","explanation":"放言：敞开说；遣辞：用词造句。指无拘无束地说话或写文章。","source":{"text":"放言遣辞，良多变矣。","book":"晋·陆机《文赋》"},"similar":["遣词造句"],"usage":"作谓语、宾语；用于说话作文"},{"id":22950,"word":"放言高论","pinyin":"fàng yán gāo lùn","abbr":"fygl","explanation":"指毫无顾忌地大发议论。","source":{"text":"尝读《孔子世家》，观其言语文章，循循莫不有规矩，不敢放言高论。","book":"宋·苏轼《荀卿论》"},"example":{"text":"见集于都下诸名士，终日惟酒食游戏征逐，～，自负不可一世。","book":"清·王韬《淞滨琐话·李延庚》"},"opposite":["缄口不言"],"usage":"作谓语、定语；用于说话"},{"id":22951,"word":"放诞不拘","pinyin":"fàng dàn bù jū","abbr":"fdbj","explanation":"放纵任性，不加检点，不受约束。同“放荡不羁”。","source":{"text":"韩退处士，绛州人，放诞不拘，浪迹秦晋间，以诗自名。","book":"宋·司马光《温公续诗话》"},"similar":["放浪不拘","放诞不羁","放浪不羁"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":22952,"word":"放诞不羁","pinyin":"fàng dàn bù jī","abbr":"fdbj","explanation":"放纵任性，不加检点，不受约束。同“放荡不羁”。","source":{"text":"王濛字仲祖，晋阳人，放诞不羁。书比庚翼，丹青甚妙，颇希高远。","book":"《太平广记》卷二一○引唐·张彦远《历代名画记·王濛》"},"example":{"text":"这赤龙子年纪最小，却也最～的。","book":"《老残游记续集遗稿》第五回"},"similar":["放荡不羁","放诞不拘","放浪不羁"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":22953,"word":"放诞任气","pinyin":"fàng dàn rèn qì","abbr":"fdrq","explanation":"放诞：行为放荡，言语荒唐；任气：纵任意气。放纵任性，不守规矩。","source":{"text":"超少好文学，放诞任气。","book":"《南齐书·檀超传》"},"similar":["放荡不羁"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":22954,"word":"放诞风流","pinyin":"fàng dàn fēng liú","abbr":"fdfl","explanation":"指有文采，言行不受礼法束缚。","source":{"text":"文君姣好，眉色如望远山，脸际常若芙蓉，肌肤柔滑如脂，十七而寡，为人放诞风流，故悦长卿之才而越礼焉。","book":"《西京杂记》卷二"},"example":{"text":"花史年少，～，既为情死，眉黛间常有恨色。","book":"清·尤侗《瑶宫花史小传》"},"similar":["放诞不拘"],"usage":"作谓语、定语、宾语；指不受约束"},{"id":22955,"word":"放诸四夷","pinyin":"fàng zhū sì yí","abbr":"fzsy","explanation":"四夷：统治者对少数民族的蔑称，指东夷、西戎、南蛮、北狄，泛指四方边远地区。放逐到各地非华夏族居住的边远地区。","source":{"text":"出洋留学和放诸四夷的区别，笋和竹的区别。","book":"鲁迅《对于批评家的希望》"},"similar":["放诸四裔"],"usage":"作谓语、宾语；指放逐"},{"id":22956,"word":"放诸四海而皆准","pinyin":"fàng zhū sì hǎi ér jiē zhǔn","abbr":"fzshejz","explanation":"比喻具有普遍性的真理到处都适用。同“放之四海而皆准”。","source":{"text":"推而放诸东海而准，推而放诸西海而准，推而放诸南海而准，推而放诸北海而准。","book":"《礼记·祭义》"},"example":{"text":"使人增长其幸福者，谓之善；使人减障其幸福者，谓之恶。此主义～，俟诸百世而不惑。","book":"梁启超《乐利主义泰斗边沁之学说·边沁之伦理说》"},"similar":["放之四海而皆准"],"usage":"作谓语、定语；指普遍性的真理"},{"id":22957,"word":"放诸四裔","pinyin":"fàng zhū sì yì","abbr":"fzsy","explanation":"放：放逐；四裔：四方边远之地。指放逐到四方边远地区。","source":{"text":"那也可以临末声明：‘君子不为己甚，窃以为放诸四裔可矣’的。","book":"鲁迅《做古文和做好人的秘诀》"},"similar":["放诸四夷"],"usage":"作谓语、宾语；指放逐"},{"id":22958,"word":"放辟淫侈","pinyin":"fàng pì yín chǐ","abbr":"fpyc","explanation":"肆意为非作歹。亦指肆无忌惮、邪恶不正。同“放僻淫佚”。","source":{"text":"清·刘大櫆《序》：余观今之为友者，无故而聚于一室，酒食嬉戏，相与为放辟淫侈之谈。”"},"similar":["放僻淫佚"],"usage":"作谓语、定语；多用于坏人"},{"id":22959,"word":"放辟邪侈","pinyin":"fàng pì xié chǐ","abbr":"fpxc","explanation":"放、侈：放纵；辟、邪：不正派，不正当。指肆意作恶。","source":{"text":"苟无恒心，放辟邪侈，无不为己。","book":"《孟子·梁惠王上》"},"example":{"text":"然而民不知义，复迫困穷，～而入于罪者，非陛下陷之乎？","book":"宋·程颐《上仁宗皇帝书》"},"similar":["为非作歹","肆无忌惮","放僻邪侈"],"usage":"作谓语、定语；指肆意作恶"},{"id":22960,"word":"放达不羁","pinyin":"fàng dá bù jī","abbr":"fdbj","explanation":"纵放旷达，不受拘束。","source":{"text":"[卢柟]一生好酒任侠，放达不羁，不轻财傲物之志。","book":"《醒世恒言·卢太学诗酒傲王侯》"},"example":{"text":"久闻唐伯虎～，难道华安就是他？","book":"《警世通言·唐解元一笑姻缘》"},"similar":["放浪不羁"],"usage":"作定语、宾语；指行为放纵"},{"id":22961,"word":"放长线钓大鱼","pinyin":"fáng cháng xiàn diào dà yú","abbr":"fcxddy","explanation":"比喻做事从长远打算，虽然不能立刻收效，但将来能得到更大的好处。","source":{"text":"线儿放得长，鱼儿钓得大。","book":"清·石成金《传家宝三集·俗谚》"},"example":{"text":"办这种事，要～。","book":"罗丹《风雨的黎明》"},"similar":["从长计议"],"opposite":["竭泽而渔"],"usage":"作分句、定语；指从长远考虑"},{"id":22962,"word":"放饭流歠","pinyin":"fàng fàn liú chuò","abbr":"fflc","explanation":"歠：喝，饮。大口吃饭，大口喝汤。旧指没有礼貌。","source":{"text":"不能三年之丧，而缌小功之察；放饭流歠，而问无齿决，是之谓不知务。","book":"《孟子·尽心上》"},"example":{"text":"真所谓～而问无齿决者也，亦不知其类甚矣。","book":"清·陈确《葬书下·甚次》"},"similar":["不识大体"],"usage":"作谓语；指没有礼貌"},{"id":22963,"word":"放马华阳","pinyin":"fàng mǎ huá yáng","abbr":"fmhy","explanation":"指不再用兵。","source":{"text":"乃偃武修文，归马于华阳之阳，放牛于桃林之野，示天下弗服。","book":"《尚书·武成》"},"example":{"text":"武王伐纣，天下既定，王巡岳渎，～，散牛桃林，即此处也，其中多野马。","book":"北魏·郦道元《水经注·河水》"},"similar":["马放南山","归马放牛"],"usage":"作宾语、定语；用于战后","story":["商朝末年，商纣王荒淫无度，百姓怨声载道。周武王率领大军把商都包围起来，商纣王登上鹿台放火自杀。周武王建立周朝，定都镐京，让士兵回家从事农业生产，把征用的牛马全部退还，让全国老百姓过上安居乐业的日子"]},{"id":22964,"word":"放马后炮","pinyin":"fàng mǎ hòu pào","abbr":"fmhp","explanation":"比喻事情已过去才发议论。","source":{"text":"人已死了，在这里放马后炮，可是迟了。","book":"清·夏敬渠《野叟曝言》第29回"},"example":{"text":"切忌不要使问题成了堆，才来一个总结，～。","book":"毛泽东《农业合作化的一场辩论的当前的阶级斗争》"},"similar":["事后诸葛亮"],"usage":"作谓语、宾语；指事后诸葛亮"},{"id":22965,"word":"放鱼入海","pinyin":"fàng yú rù hǎi","abbr":"fyrh","explanation":"比喻放走敌人，留下祸根。","source":{"text":"今刘备釜中之鱼，阱中之虎，若不就此时擒捉，如放鱼入海，纵虎归山矣。","book":"《三国演义》第四二回"},"example":{"text":"如果捉不住打不死，让他们逃走了，就等于～，纵虎归山。","book":"周玉清《晋西事变中的一夜》"},"similar":["放虎归山"],"usage":"作谓语、定语、宾语；指自留祸根"},{"id":22966,"word":"放鹰逐犬","pinyin":"fàng yīng zhú quǎn","abbr":"fyzq","explanation":"指打猎。","source":{"text":"《明史·韩文传》“击球走马，放鹰逐犬，俳优杂剧，错陈于前。”"},"example":{"text":"忽一日带了二三百家将，往乡村打围作乐，一路来到一个地方，名为孟家庄。一众人～。","book":"清·钱彩《说岳全传》第三十二回"},"usage":"作谓语、宾语、定语；指打猎"},{"id":22967,"word":"放龙入海","pinyin":"fàng lóng rù hǎi","abbr":"flrh","explanation":"比喻放走敌人，留下后患。","source":{"text":"此放龙入海，纵虎归山也，后欲治之，其可得乎？","book":"明·罗贯中《三国演义》第21回"},"example":{"text":"我们不能干～的事情。"},"similar":["放虎归山"],"usage":"作谓语、定语、宾语；指留下后患"},{"id":22968,"word":"政令不一","pinyin":"zhèng lìng bù yī","abbr":"zlby","explanation":"发出的命令不统一。形容军务或政务混乱。","source":{"text":"吾知绍之为人，志大而智小，色厉而胆薄，忌克而少威，兵多而分画不明，将骄而政令不一，土地虽广粮食虽丰，适足以为吾奉也。","book":"《左传·昭公二十三年》：“帅贱多宠，政令不壹。”《三国志·魏志·武帝纪 》"},"example":{"text":"时～，诸蛮怨望，并谋背叛。","book":"《晋书·应詹传》"},"usage":"作谓语、定语；用于时局等"},{"id":22969,"word":"政以贿成","pinyin":"zhèng yǐ huì chéng","abbr":"zyhc","explanation":"形容旧社会政治腐败，官场黑暗，不行贿就办不成事。","source":{"text":"政以贿成，而刑放于宠。","book":"《左传·襄公十年》"},"example":{"text":"目下～，豺狼当道，我即或在这里再多住几时，也不见得有甚么利益。","book":"《晚清文学丛钞·冷眼观》第二十七回"},"similar":["贿赂公行"],"usage":"作定语、宾语；指政治腐败"},{"id":22970,"word":"政出多门","pinyin":"zhèng chū duō mén","abbr":"zcdm","explanation":"政：政令；门：部门。原意是政令出自几个卿大夫的门下。指中央领导软弱，国家权力分散。","source":{"text":"鲁之有季孟，犹晋之有栾范也，政令于是乎成。今其谋曰：‘晋政多门，不可从也。’","book":"《左传·成公十六年》"},"example":{"text":"古者一相，专任贤也，今宰执员多，～，转相疑忌，请损之。","book":"《元史·何玮传》"},"similar":["各自为政","一国三公","各行其是"],"opposite":["一统天下"],"usage":"作谓语、分句；指政局混乱"},{"id":22971,"word":"政平讼息","pinyin":"zhèng píng sòng xī","abbr":"zpsx","explanation":"政平：政治安定；讼息：官司得到调解。国家安定，官司很快得到正确处理。形容政治清明。","source":{"text":"庶民所以安其田里而亡叹息愁恨之心者，政平讼理也。","book":"《汉书·循吏传》"},"example":{"text":"及典濠、舒二州，出入七年，又不能副陛下～、与吾共此之叹。（唐·独孤及《谢常州刺史表》）"},"similar":["政平讼理"],"usage":"作谓语、定语；用于书面语"},{"id":22972,"word":"政平讼理","pinyin":"zhèng píng sòng lǐ","abbr":"zpsl","explanation":"政平：政治安定；讼理：官司得到调解。国家安定，官司很快得到正确处理。形容政治清明。","source":{"text":"庶民所以安其田里而亡叹息愁恨之心者，政平讼理也。","book":"《汉书·循吏传》"},"example":{"text":"朕闻～，则民安其业；告讦易俗，则礼义兴行。（清·毕沅《续资治通鉴》卷一百七十五）"},"similar":["政平讼息"],"usage":"作谓语、定语；用于书面语"},{"id":22973,"word":"政庞土裂","pinyin":"zhèng páng tǔ liè","abbr":"zptl","explanation":"庞：庞杂；裂：分裂。政策杂乱，国土分裂。指政治混乱，地方势力割据。","source":{"text":"夫政庞而土裂，三光五岳之气分，太音不完，故必混一而后大振。","book":"唐·刘禹锡《唐故柳州刺史柳君集纪》"}},{"id":22974,"word":"政清人和","pinyin":"zhèng qīng rén hé","abbr":"zqrh","explanation":"政治清明，人心归向，上下团结。","source":{"text":"会稽内史诸葛恢莅官三年，政清人和，为诸郡首。","book":"《晋书·诸葛恢传》"},"usage":"作谓语、定语、状语；用于时局等"},{"id":22975,"word":"政清狱简","pinyin":"zhèng qīng yù jiǎn","abbr":"zqyj","explanation":"政治清明，刑狱简省。","source":{"text":"裁缺，改授永新知县，政清狱简，与民休息。","book":"《清史稿·黎士弘传》"},"similar":["政简刑清"],"usage":"作谓语、定语、状语；用于时局等"},{"id":22976,"word":"政由己出","pinyin":"zhèng yóu jǐ chū","abbr":"zyjc","explanation":"政令由一己发出。指把持大权，独断专行。","source":{"text":"三年，遂将五诸侯灭秦，分裂天下，而封王侯，政由羽出，号为‘霸王’。","book":"《史记·项羽本纪》"},"example":{"text":"独有为贵大臣告者，台阁之上，～，龙行虎步，高下在心。","book":"章炳麟《为民报封禁事移让日本内务大臣平田东助书·三"},"similar":["独断专行"],"usage":"作宾语、定语；指独断专行"},{"id":22977,"word":"政简刑清","pinyin":"zhèng jiǎn xíng qīng","abbr":"zjxq","explanation":"旧时形容法令简省，社会风气好，犯罪的人少。常用作称道地方官政绩的话。","source":{"text":"那官人为官清正，单吃德化县中一口水；又且听讼明快，雪冤理滞，果然政简刑清，民安盗息。","book":"明·冯梦龙《醒世恒言》卷一"},"example":{"text":"安太爷做了一年嘉兴县令，倒是～，上司很说他能干。","book":"《晚清文学丛钞·中国现在记》第十一回"},"similar":["政清狱简"],"usage":"作宾语、定语；常用作称道地方官政绩的话"},{"id":22978,"word":"政荒民弊","pinyin":"zhèng huāng mín bì","abbr":"zhmb","explanation":"荒：荒废；弊：困疲。政治荒废，百姓劳困。","source":{"text":"君贤臣忠，国之盛也；父慈子孝，家之盛也。今政荒民弊，覆亡是惧，臣何敢言盛！","book":"南朝·宋·刘义庆《世说新语·箴规》"},"usage":"作谓语、定语；用于时局"},{"id":22979,"word":"政通人和","pinyin":"zhèng tōng rén hé","abbr":"ztrh","explanation":"政事通达，人心和顺。形容国家稳定，人民安乐。","source":{"text":"越明年，政通人和，百废俱兴。","book":"宋·范仲淹《岳阳楼记》"},"quote":{"text":"及擢守严陵，～，始从事于梨枣。","book":"清·鲍廷博《青本刻纪事》"},"similar":["安居乐业","政修人和","国泰民安"],"opposite":["颠沛流离"],"usage":"作谓语、定语；指政治局面"},{"id":22980,"word":"故交新知","pinyin":"gù jiāo xīn zhī","abbr":"gjxz","explanation":"故：过去的；交：有交情的人；知：知己。指新朋老友。"},{"id":22981,"word":"故人之情","pinyin":"gù rén zhī qíng","abbr":"grzq","explanation":"故人：老朋友。老朋友之间的感情。","source":{"text":"浮云游子意，落日故人情。","book":"唐·李白《送友人》"},"example":{"text":"与公共事先帝，独无～乎？","book":"《新五代史·汉臣传》"},"similar":["故人之意"],"usage":"作宾语；指老朋友的情意"},{"id":22982,"word":"故人之意","pinyin":"gù rén zhī yì","abbr":"grzy","explanation":"故人：旧友。指老朋友的情意。","source":{"text":"然公之所以得无死者，以绨袍恋恋，有故人之意，故释公。","book":"西汉·司马迁《史记·范雎蔡泽列传》"},"similar":["故人之情"],"usage":"作宾语；指老朋友的情意"},{"id":22983,"word":"故伎重演","pinyin":"gù jì zhòng yǎn","abbr":"gjzy","explanation":"老花招或老手法又重新施展。同“故技重演”。","source":{"text":"孙少平为讨得他舅和他妗子的欢心，又故伎重演，赶忙提了桶担去给这家人担水。","book":"路遥《平凡的世界》第三卷第17章"},"example":{"text":"一对盗贼～，但被当场抓获。"},"similar":["故技重演"],"usage":"作谓语、宾语；形容继续玩老花样"},{"id":22984,"word":"故作姿态","pinyin":"gù zuò zī tài","abbr":"gzzt","explanation":"故意作出某种样子。指装模作样，并非真心诚意。","source":{"text":"‘我就喜欢你这样。’我冲她背影嚷，‘不怕说实话，就怕故作姿态。’","book":"王朔《永失我爱》"},"example":{"text":"故意作出某种样子。指装模作样，并非真心诚意。"},"similar":["装模作样"],"usage":"作谓语、宾语；指故意做出某种样子"},{"id":22985,"word":"故作玄虚","pinyin":"gù zuò xuán xū","abbr":"gzxx","explanation":"犹故弄玄虚。指故意玩弄花招，迷惑人，欺骗人。","source":{"text":"‘你知道我们两个之间的关系吗？’我眉毛一扬，故作玄虚地问她。","book":"《十月》1981年第1期"},"similar":["故弄玄虚"],"usage":"作谓语、宾语、状语；指故意玩弄花招"},{"id":22986,"word":"故作镇静","pinyin":"gù zuò zhèn jìng","abbr":"gzzj","explanation":"指故意装做心情安定。","example":{"text":"你～也不能掩饰自己。"},"usage":"作谓语、定语；指伪装自己"},{"id":22987,"word":"故作高深","pinyin":"gù zuò gāo shēn","abbr":"gzgs","explanation":"本来并不高深，故意装出高深的样子。多指文章故意用些艰深词语，掩饰内容的浅薄。","example":{"text":"你不要～，装作很有水平。"},"usage":"作谓语、定语；用于文章及说话等"},{"id":22988,"word":"故入人罪","pinyin":"gù rù rén zuì","abbr":"grrz","explanation":"断案不当，故意把罪名加于人。","source":{"text":"若于本状之外，别求他罪者，以故入人罪论。","book":"《唐律疏议·断狱》"},"example":{"text":"清·名教中人《好逑传》第一回：“若是父亲造捏假名，果属乌有，～，便是欺君。”"},"similar":["出入人罪"],"opposite":["拿贼要赃，拿奸要双"],"usage":"作谓语、宾语；指妄自给人加罪名"},{"id":22989,"word":"故出人罪","pinyin":"gù chū rén zuì","abbr":"gcrz","explanation":"故：故意；出：越出标准。指判案不合理，或重罪轻罚，或轻罪重罚。","source":{"text":"故：故意；出：越出标准。指判案不合理，或重罪轻罚，或轻罪重罚。"}},{"id":22990,"word":"故剑之求","pinyin":"gù jiàn zhī qiú","abbr":"gjzq","explanation":"故剑：比喻结发之妻。结发夫妻情意浓厚。指不喜新厌旧。","source":{"text":"公卿议更立皇后，皆心仪霍将军女，亦未有言。上乃诏求微时故剑，大臣知指，白立许倢伃为皇后。","book":"《汉书·外戚传上》"},"example":{"text":"自遭强暴，无意人世，郎君今贵，乃无～，抑何忍也。","book":"清·王韬《淞隐漫录·鹃红女史》"}},{"id":22991,"word":"故剑情深","pinyin":"gù jiàn qíng shēn","abbr":"gjqs","explanation":"故剑：比喻结发之妻。结发夫妻情意浓厚。指不喜新厌旧。","source":{"text":"公卿议更立皇后，皆心仪霍将军女，亦未有言。上乃诏求微时故剑，大臣知指，白立许婕妤为皇后。","book":"东汉·班固《汉书·外戚传上》"},"example":{"text":"如今却说李彦青探明曹三意旨，知他～，不忘喜奎。","book":"蔡东藩《民国通俗演义》第128回"},"similar":["深情故剑"],"opposite":["喜新厌旧"],"usage":"作宾语；用于夫妻间","story":["汉宣帝时期，大将军霍光封宣帝做平民时所娶的妻子许平君为婕妤，将自己的幼女嫁给宣帝准备立为皇后。宣帝心中不乐意，下令寻求过去作平民时的旧剑，目的明确，立许婕妤为皇后。霍光的妻子霍显买通御医害死许皇后"]},{"id":22992,"word":"故土难离","pinyin":"gù tǔ nán lí","abbr":"gtnl","explanation":"故土：出生地，或过去住过的地方，这里指故乡、祖国。难于离开故乡的土地。形容对家乡或祖国有无限的眷恋之情。","example":{"text":"真是～，我还是要落叶归根。"},"similar":["乡土难离"],"usage":"作宾语、定语；用于人的心境等"},{"id":22993,"word":"故地重游","pinyin":"gù dì chóng yóu","abbr":"gdzy","explanation":"故地：曾经居住过的地方。重又回到过去生活过的地方游览。"},{"id":22994,"word":"故宫离黍","pinyin":"gù gōng lí shǔ","abbr":"ggls","explanation":"故宫：从前的宫殿；黍：指粮食作物。比喻怀念故国的情思。","source":{"text":"梦绕神州路。怅秋风，连营画角，故宫离黍。","book":"宋·张元干《贺新郎·送胡邦衡待制赴新州》"},"similar":["故宫禾黍"],"usage":"作宾语；指怀念故国的情思"},{"id":22995,"word":"故宫禾黍","pinyin":"gù gōng hé shǔ","abbr":"gghs","explanation":"比喻怀念祖国的情思。","source":{"text":"周大夫行役，至于宗周，过宗庙宫室，尽为禾黍，闵周室之颠覆。","book":"《诗经·王风·黍离》序"},"example":{"text":"一路上晓行夜宿，只觉得景物都非，不胜～之感。","book":"清·吴趼人《痛史》第十七回"},"similar":["故宫离黍"],"usage":"作宾语；指怀念故国的情思","story":["相传西周灭亡后，周大夫长途跋涉来到西周都城，看到过去的宗庙宫室都成了长满禾黍的田地，触景伤怀，无限感慨，就作《黍离》诗一首。后来微子其朝见周王时，路过殷墟，看到宫室毁坏，长满禾黍，非常哀伤，就作一首《麦秀》歌"]},{"id":22996,"word":"故家乔木","pinyin":"gù jiā qiáo mù","abbr":"gjqm","explanation":"①指世家的人才、器物必定出众。②喻指乡贤。","source":{"text":"故家乔木。”果然不差。就如尊府这灯，我县里没不第二副。’","book":"《儒林外史》第四回：“余大先生道：‘自古说"},"example":{"text":"～今谁在？永日残棋局更新。","book":"清·曹寅《读葛庄诗有感》诗"},"usage":"作主语、宾语；用于口语"},{"id":22997,"word":"故家子弟","pinyin":"gù jiā zǐ dì","abbr":"gjzd","explanation":"故家：指世家大族。指出身高贵，有社会地位人家的子弟。","source":{"text":"我也是个故家子弟，好模好样，不想遭这一场，反被那小子逼勒。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["公子哥儿"],"usage":"作宾语、定语；指曾经为官宦子弟"},{"id":22998,"word":"故封识","pinyin":"gu feng zhi","abbr":"gfs","explanation":"原来封存的标记。"},{"id":22999,"word":"故弄玄虚","pinyin":"gù nòng xuán xū","abbr":"gnxx","explanation":"故：故意；弄：玩弄；玄虚：用来掩盖真相，使人迷惑的欺骗手段。故意玩弄花招，迷惑人，欺骗人。","source":{"text":"圣人观其玄虚，用其周行，强字之曰道。","book":"《韩非子·解老》"},"example":{"text":"似乎在～，不叫人懂，真使人纳闷。","book":"邓拓《你看山水风景美不美》"},"similar":["弄虚作假"],"opposite":["实事求是"],"usage":"作谓语、宾语、状语；指故意玩弄花招"},{"id":23000,"word":"故弄虚玄","pinyin":"gù nòng xū xuán","abbr":"gnxx","explanation":"犹故弄玄虚。指故意玩弄花招，迷惑人，欺骗人。","source":{"text":"他既不满意吕康的故弄虚玄，对于吴楣也有一点讨厌，觉得他太张巴，太繁琐。","book":"沙汀《困兽记》十一"},"similar":["故弄玄虚"],"usage":"作谓语、宾语、状语；指故意玩弄花招"},{"id":23001,"word":"故态复作","pinyin":"gù tài fù zuò","abbr":"gtfz","explanation":"指旧的习气或毛病等又出现了。同“故态复萌”。","source":{"text":"今老将就木，潦倒不能横飞，故态复作，我自不懈耳。","book":"清·蒲松龄《聊斋志异·八大王》"},"similar":["故态复萌","故态复还"],"usage":"作谓语、宾语；用于指坏的东西"},{"id":23002,"word":"故态复萌","pinyin":"gù tài fù méng","abbr":"gtfm","explanation":"故态：老脾气，老样子；复：又；萌：发生。指旧的习气或毛病等又出现了。","source":{"text":"不欺师父，韩郎遣信到此，不觉故态复萌，情缘难断。","book":"明·梅鼎祚《玉合记·嗣音》"},"example":{"text":"马阮心上好不痛快。便又～，横征暴敛，报复冤仇，享受着这小朝廷的大臣们的最高权威。","book":"郑振铎《毁灭》八"},"similar":["故态复还","复为故态","故态复作"],"usage":"作谓语、宾语；用于指坏的东西"},{"id":23003,"word":"故态复还","pinyin":"gù tài fù huán","abbr":"gtfh","explanation":"指旧的习气或毛病等又出现了。同“故态复萌”。","source":{"text":"故态复还，宝心再起。既赋形而终用，一蒙垢焉何耻？","book":"唐·刘禹锡《砥石赋》"},"similar":["故态复萌","故态复作"],"usage":"作谓语、宾语；用于指坏的东西"},{"id":23004,"word":"故意刁难","pinyin":"gù yì diāo nàn","abbr":"gydn","explanation":"指有意为难别人。","example":{"text":"他～你，让你知难而退。"},"usage":"作谓语、定语；指有意为难"},{"id":23005,"word":"故我依然","pinyin":"gù wǒ yī rán","abbr":"gwyr","explanation":"故我：旧日的我。仍旧是过去的我。指自己的境况和从前一样，没有变化。","source":{"text":"说这次必要高中了。究竟到了出榜还是个依然故我，也无味的很。","book":"清·文康《儿女英雄传》第一回"},"example":{"text":"自己一动不动，～，姓名却已经历了几回升沉冷暖。","book":"鲁迅《革“首领”》"},"similar":["依然故我"],"usage":"作宾语；指自己的境况和从前一样"},{"id":23006,"word":"故技重演","pinyin":"gù jì chóng yǎn","abbr":"gjcy","explanation":"技：同“伎”，花招。老花招或老手法再耍一次","source":{"text":"所谓‘停止轰炸’，这不过是约翰逊政府的故技重演。","book":"《人民日报》1966.1.7"},"example":{"text":"他又在～"},"similar":["故伎重演"],"usage":"作谓语、宾语；形容继续玩老花样"},{"id":23007,"word":"故旧不弃","pinyin":"gù jiù bù qì","abbr":"gjbq","explanation":"故旧：旧交，旧部下；弃：抛弃。不轻易抛弃老朋友、老部下。","source":{"text":"故旧无大故，则不弃也；无求备于一人。","book":"《论语·微子》"},"usage":"作谓语；指不轻易抛弃老朋友、老部下"},{"id":23008,"word":"故步不离","pinyin":"gù bù bù lí","abbr":"gbbl","explanation":"故步：旧的步法。比喻因循守旧，安于现状，不求上进。","source":{"text":"学者凡事执一时之偶见，信一己之偏私，沾沾自得，吝不肯舍者，率因无所进步，是以故步不离耳。","book":"清·张履祥《与陈乾初书》"},"similar":["故步自封","因循守旧"],"usage":"作谓语、定语；指人守旧"},{"id":23009,"word":"故步自封","pinyin":"gù bù zì fēng","abbr":"gbzf","explanation":"故：旧；故步：旧时行步之法，引伸为旧法；封：限制在一定的范围内。比喻守着老一套，不求进步。","source":{"text":"昔有学步于邯郸者，曾未得其仿佛，又复失其故步，遂匍匐而归耳。","book":"《汉书·叙传上》"},"example":{"text":"你心胸开阔，气度那么从容！你不随波逐流，也不～。","book":"郭沫若《屈原》第一幕"},"similar":["墨守成规","抱残守缺","因循守旧"],"opposite":["勇往直前","一往无前"],"usage":"作谓语、定语；指人守旧"},{"id":23010,"word":"故步自画","pinyin":"gù bù zì huà","abbr":"gbzh","explanation":"犹故步自封。比喻守着老一套，不求进步。","source":{"text":"我国自印度思想输入以后，几千年来溺佛者遁世无营，避佛者亦故步自画。","book":"郭沫若《文艺论集·论中德文化书》"},"similar":["故步自封","因循守旧","故步不离"],"usage":"作谓语、定语；指人守旧"},{"id":23011,"word":"故甚其词","pinyin":"gù shèn qí cí","abbr":"gsqc","explanation":"指说话故意夸大，脱离事实。","source":{"text":"盖我军所用侦探，率以数百钱，遣无赖小民，道听途说，或且故甚其词，以恫喝将士，摇动人心。","book":"清·黄钧宰《金壶浪墨·汉奸》"},"usage":"作谓语；用于说话等"},{"id":23012,"word":"故纸堆","pinyin":"gù zhǐ duī","abbr":"gzd","explanation":"指大量的古旧书籍、资料。含贬义。比喻人埋首研读古书，不知人情世故。","source":{"text":"百年钻故纸，何日出头时？在这些故纸堆中，有发掘不尽的知识宝藏。","book":"《五灯会元·古灵神赞禅师》"},"example":{"text":"于是剩下了希腊和外国故事，也是可怜的很，从外国～中零星地捡来的。"},"usage":"作主语、宾语、定语；指古书"},{"id":23013,"word":"效命疆场","pinyin":"xiào mìng jiāng chǎng","abbr":"xmjc","explanation":"到边疆拼死报效国家。","source":{"text":"虽执殳荷戈，效死疆场，亦所弗避。","book":"明·张居正《再乞休致疏》"},"example":{"text":"书生典兵，会办南洋，大不了～，一死就可报答皇恩，不负平生。","book":"高阳《慈禧全传》五十七"},"similar":["效死疆场"],"usage":"作谓语、宾语；用于处事等"},{"id":23014,"word":"效死勿去","pinyin":"xiào sǐ wù qù","abbr":"xswq","explanation":"指竭尽忠诚。","source":{"text":"世守也，非身之所能为也，效死勿去。","book":"《孟子梁惠王下》"},"example":{"text":"设在围城中，内无粮刍，外无救援，当如何？先生应声曰：“～”。","book":"清王士禛《池北偶谈·谈献三·苏门孙先生言行》"},"similar":["效死弗去"],"usage":"作谓语、定语、宾语；用于处事"},{"id":23015,"word":"效死弗去","pinyin":"xiào sǐ fú qù","abbr":"xsfq","explanation":"拼死报效，不肯离去。","source":{"text":"效死而民弗去。","book":"《孟子·梁惠王上》"},"example":{"text":"越境而侵入，不能援城亡亦亡之义，负嵎而祸众，更难以～为宜。","book":"丁中江《北洋军阀史话》二百五十二"},"similar":["效死勿去"],"usage":"作谓语、定语、宾语；用于处事"},{"id":23016,"word":"效死疆场","pinyin":"xiào sǐ jiāng chǎng","abbr":"xsjc","explanation":"到边疆拼死报效国家。","source":{"text":"虽执殳荷戈，效死疆场，亦所弗避。","book":"明·张居正《再乞休致疏》"},"example":{"text":"八旗士卒，多争先用命，～，丁口稀少。","book":"清·昭梿《啸亭杂录·一·爱惜满州士卒》"},"similar":["效命疆场"],"usage":"作谓语、宾语；用于处事等"},{"id":23017,"word":"效死输忠","pinyin":"xiào sǐ shū zhōng","abbr":"xssz","explanation":"指竭尽忠诚。","source":{"text":"若乃世道方泰，则席宠恃禄者实繁；世运既屯，则效死输忠无几。","book":"《旧五代史·晋书·皇甫遇王清等传伦》"},"usage":"作谓语、定语；用于处事等"},{"id":23018,"word":"效犬马力","pinyin":"xiào quǎn mǎ lì","abbr":"xqml","explanation":"效劳的谦词。意思是效犬马之劳。","source":{"text":"臣旧岁统率大军前去征进，非不效犬马力，奈缘暑热，军士不伏水土。","book":"《水浒传》第八二回"},"usage":"作谓语；用于谦词"},{"id":23019,"word":"效颦学步","pinyin":"xiào pín xué bù","abbr":"xpxb","explanation":"比喻盲目模仿而弄巧成拙。亦作“东施效颦”、“邯郸学步”。","source":{"text":"且子独不闻夫寿陵余子之学行于邯郸与？未得国能，又失其故行矣，直匍匐而归耳。","book":"《庄子·天运》：“故西施病心而矉其里，其里之丑人见而美之，归亦捧心而矉其里。”《庄子·秋水》"},"example":{"text":"而我今日乃欲摹就衰之仪式，为～之下策，其毋乃可不必乎。","book":"清·梁启超《保教所以尊孔论》"},"similar":["东施效颦","邯郸学步"],"usage":"作宾语、定语；用于处事等"},{"id":23020,"word":"敌不可假","pinyin":"dí bù kě jiǎ","abbr":"dbkj","explanation":"指不可宽容敌人。","source":{"text":"臣闻之，敌不可假，时不可失。","book":"西汉·司马迁《史记·春申君列传》"},"example":{"text":"我们切记～的原则。"},"opposite":["放虎归山"],"usage":"作宾语、定语；指不能轻敌"},{"id":23021,"word":"敌不可纵","pinyin":"dí bù kě zòng","abbr":"dbkz","explanation":"对敌人不能放纵。","source":{"text":"奉不可失，敌不可纵。","book":"《左传·僖公三十三年》"},"example":{"text":"古谚有之：～。夫以一酌之水，或有不测之渊，如不时灭，恐同草原。","book":"《魏书·郭祚传》"},"usage":"作宾语、定语；用于战争等"},{"id":23022,"word":"敌众我寡","pinyin":"dí zhòng wǒ guǎ","abbr":"dzwg","explanation":"敌方人数多，我方人数少。形容双方对峙，众寡悬殊。","source":{"text":"然则小固不可以敌大，寡固不可以敌众，弱固不可以敌强。","book":"战国·邹·孟轲《孟子·梁惠王上》"},"example":{"text":"我们处在～的不利情况中。"},"similar":["众寡悬殊","寡不敌众"],"opposite":["势均力敌","旗鼓相当","棋逢对手"],"usage":"作定语、分句；指众寡悬殊"},{"id":23023,"word":"敌力角气","pinyin":"dí lì jiǎo qì","abbr":"dljq","explanation":"指以力气相斗。","source":{"text":"敌力角气，能以小胜大者希，争强量功，能以寡胜众者鲜。","book":"汉·王充《论衡·譋时》"},"usage":"作宾语、定语；用于较量"},{"id":23024,"word":"敌变我变","pinyin":"dí biàn wǒ biàn","abbr":"dbwb","explanation":"敌方情况发生了变化，我方对策也要随之作相应变化。形容机动灵活，随机应变。"},{"id":23025,"word":"敌国同舟","pinyin":"dí guó tóng zhōu","abbr":"dgtz","explanation":"同舟共济的人成了敌人。","source":{"text":"若君不修德，舟中之人尽为敌国也。","book":"《史记·孙子吴起列传》"},"example":{"text":"～今日事，太仓稊米自家身。","book":"清·黄遵宪《由轮舟抵天津作》诗"}},{"id":23026,"word":"敌国外患","pinyin":"dí guó wài huàn","abbr":"dgwh","explanation":"指来自敌对国家的侵略骚扰。","source":{"text":"入则无法家拂士，出则无敌国外患者，国恒亡。","book":"《孟子·告子下》"},"example":{"text":"～，日冯陵而无已。","book":"章炳麟《藩镇论》"},"usage":"作宾语、定语；用于国家局势"},{"id":23027,"word":"敌国通舟","pinyin":"dí guó tōng zhōu","abbr":"dgtz","explanation":"同船的人都成了敌人。比喻众叛亲离。","source":{"text":"敌国通舟今日事，太仓稊米自家身。","book":"清·黄遵宪《由轮舟抵天津作》诗"},"similar":["众叛亲离"],"usage":"作宾语、定语；用于人际关系等"},{"id":23028,"word":"敌存灭祸，敌去召过","pinyin":"dí cún miè huò，dí qù zhāo guò","abbr":"dcmhdqzg","explanation":"召：即“招”，招来。敌人存在，威胁便存在，可使人提高警惕，免除灾祸；放松警惕，便会招来祸害。比喻胜利后不能放松警惕。"},{"id":23029,"word":"敌忾同仇","pinyin":"dí kài tóng chóu","abbr":"dktc","explanation":"全体一致痛恨敌人。","source":{"text":"《诗经·秦风·无衣》：“修我戈矛，与子同仇”。《左传·文公四年》：“诸侯敌王所忾，而献其功”。"},"example":{"text":"如蒙皇上乾纲立断，速谕停工，天下臣民，知皇上有卧薪尝胆之思，必共振～之气。","book":"《清史稿·李宗羲传》"},"similar":["同仇敌忾"],"usage":"作谓语；指一致痛恨敌人"},{"id":23030,"word":"敌惠敌怨","pinyin":"dí huì dí yuàn","abbr":"dhdy","explanation":"犹言报德报怨。","source":{"text":"夷之蒐，贾季戮臾骈，臾骈之人欲尽杀贾氏以报焉，臾骈曰：‘不可，吾闻前志有之曰：敌惠敌怨，不在后嗣，忠之道也。’","book":"《左传·文公六年》"},"example":{"text":"夫古人～，不及其子。","book":"明·张居正《答江兵宪蔡春壹书》"},"usage":"作宾语、定语；用于人际交往"},{"id":23031,"word":"敌王所忾","pinyin":"dí wáng suǒ kài","abbr":"dwsk","explanation":"指把天子所痛恨的人作为自己的敌人而加以讨伐。","source":{"text":"王之所恨怒者，诸侯亦以之为仇敌而伐之。","book":"《左传·文公四年》：“诸侯敌王所忾，而献其功。”杨伯峻注"},"example":{"text":"尔诸将尚迪果毅，一乃心力，各以其兵，～。","book":"《宋史·度宗纪》"},"usage":"作谓语、定语；用于战争等"},{"id":23032,"word":"敏于事，慎于言","pinyin":"mǐn yú shì，shèn yú yán","abbr":"myssyy","explanation":"敏：奋勉，慎：小心。办事勤勉，说话谨慎。","source":{"text":"君子食无求饱，居无求安，敏于事而慎于言。","book":"《论语·学而》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":23033,"word":"敏而好古","pinyin":"mǐn ér hào gǔ","abbr":"mehg","explanation":"敏：勤勉。指勤勉钻研古代文化。","source":{"text":"好古，敏以求之者也。","book":"《论语·述而》"},"example":{"text":"先生～，尝病乡射仪节未备，又以诗有燕享通用之乐而无声谱，爰自考定，皆有成书可诵。","book":"明·郎瑛《七修类稿》卷四十七"}},{"id":23034,"word":"敏而好学","pinyin":"mǐn ér hào xué","abbr":"mehx","explanation":"敏：聪明；好：喜好。天资聪明而又好学。","source":{"text":"子曰：‘敏而好学，不耻下问，是以谓之文也。’","book":"《论语·公冶长》"},"example":{"text":"唐春早心灵内秀，～，学而不厌。","book":"刘绍棠《蛾眉》一"},"usage":"作谓语、定语；指聪明好学"},{"id":23035,"word":"救世主","pinyin":"jiù shì zhǔ","abbr":"jsz","explanation":"基督徒对耶酥的称呼。比喻挽救世界的人物。","source":{"text":"即刻钻进了驾驶楼，像救世主一样微笑着向他招招手，就坐着汽车跑得一溜烟不见了踪影。","book":"路遥《平凡的世界》第六卷第34章"},"usage":"作宾语、定语；用于口语"},{"id":23036,"word":"救世济民","pinyin":"jiù shì jì mín","abbr":"jsjm","explanation":"挽救天下，拯济百姓。","source":{"text":"桓桓武王，继世灭殷。咸任尚父，且作商臣。功冒四海，救世济民。天下宗周，万国是宾。","book":"三国·魏·曹植《周武王赞》"},"example":{"text":"对于这个计划，胡雪岩最感兴趣，认为是～、鼓励士气最切实的一件事。","book":"高阳《红顶商人胡雪岩》第五章"},"similar":["救民济世"],"usage":"作宾语、定语；用于书面语"},{"id":23037,"word":"救乱除暴","pinyin":"jiù luàn chú bào","abbr":"jlcb","explanation":"救：拯救；除：铲除。禁除暴行，治理混乱的局面。","source":{"text":"其强也，禁暴诛乱而天下服，其弱也，五伯征而诸侯从。","book":"汉·贾谊《过秦论》"},"example":{"text":"盖～，谓之义兵。","book":"明·罗贯中《三国演义》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":23038,"word":"救亡图存","pinyin":"jiù wáng tú cún","abbr":"jwtc","explanation":"救：拯救；亡：危亡；图：谋求；存：生存。拯救国家的危亡，谋求国家的生存。","source":{"text":"夫欲救亡图存，非仅恃一二才士所能为也。","book":"清·王无生《论小说与改良社会之关系》"},"example":{"text":"使得今天处在民族敌人侵入的紧急关头的中国有了～的条件。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["存亡断绝","吊民伐罪","拨乱反正"],"opposite":["闭关自守"],"usage":"作谓语、宾语、定语；指挽救国家"},{"id":23039,"word":"救人一命，胜造七级浮图","pinyin":"jiù rén yī mìng，shèng zào qī jí fú tú","abbr":"jrymszqjft","explanation":"指救人性命功德无量。"},{"id":23040,"word":"救人一命，胜造七级浮屠","pinyin":"jiù rén yī mìng，shèng zào qī jí fú tú","abbr":"jrymszqjft","explanation":"指救人性命功德无量。","source":{"text":"官人差矣！不忍之心，人皆有之。救人一命，胜造七级浮屠。若说报答，就是为利了，岂是老汉的本念！","book":"明·冯梦龙《醒世恒言》第十卷"},"example":{"text":"大哥不要性急，待我摸摸，还有气息没有。岂不闻～吗？","book":"清·石玉昆《三侠五义》第九十一回"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":23041,"word":"救人救彻","pinyin":"jiù rén jiù chè","abbr":"jrjc","explanation":"比喻帮助人要帮到底，不能半途而废。","source":{"text":"元来和关胜一伙，都是梁山泊上好汉。救人须救彻。我有心救了关胜，怎好不救他。","book":"元·无名氏《争报恩》第一折"},"example":{"text":"俏逸云除欲除尽，德惠生～。","book":"清·刘鹗《老残游记》第五回"}},{"id":23042,"word":"救人救彻，救火救灭","pinyin":"jiù rén jiù chè，jiù huǒ jiù miè","abbr":"jrjcjhjm","explanation":"比喻帮助人要帮到底，不能半途而废。","source":{"text":"元来和关胜一伙，都是梁山泊上好汉。救人须救彻。我有心救了关胜，怎好不救他。","book":"元·无名氏《争报恩》第一折"},"example":{"text":"自己也就～，不枉费这番心力。","book":"清·文康《儿女英雄传》第十回"}},{"id":23043,"word":"救人须救彻","pinyin":"jiù rén xū jiù chè","abbr":"jrxjc","explanation":"比喻帮助人要帮到底，不能半途而废。","source":{"text":"元来和关胜一伙，都是梁山泊上好汉。救人须救彻。我有心救了关胜，怎好不救他。","book":"元·无名氏《争报恩》第一折"},"example":{"text":"自古道～，叫当直的，银子取五两过来。","book":"明·沈受先《三元记·毁券》"},"similar":["救火须救灭"],"usage":"作宾语、定语；用于处事"},{"id":23044,"word":"救偏补弊","pinyin":"jiù piān bǔ bì","abbr":"jpbb","explanation":"纠正偏向，补救弊端。","source":{"text":"与其高谈性命，而无益于用，不如救偏补弊，随事干蛊，为有实效也。","book":"明·谢肇淛《五杂俎·事部》"},"usage":"作宾语、定语；用于处事"},{"id":23045,"word":"救命稻草","pinyin":"jiù mìng dào cǎo","abbr":"jmdc","explanation":"借以活命的稻草。指人在困境时希望抓住借以活命的微小的东西。","source":{"text":"我可知道人抓住救命稻草是什么手劲儿了。","book":"王朔《永失我爱》"},"example":{"text":"当初心里想得和现在不一样，在当初那可是～。","book":"余华《活着》"},"usage":"作宾语、定语；多用于比喻句"},{"id":23046,"word":"救困扶危","pinyin":"jiù kùn fú wēi","abbr":"jkfw","explanation":"救济、扶助陷于危难的人。","source":{"text":"则为我救困扶危，疏财仗义。","book":"元·无名氏《来生债》第四折"},"example":{"text":"念刘备、关羽、张飞，虽然异姓，既结为兄弟，则同心协力，～；上报国家，下安黎庶。","book":"明·罗贯中《三国演义》第一回"},"similar":["救苦救难"],"usage":"作谓语、宾语、定语；指救济扶助陷于困境"},{"id":23047,"word":"救寒莫如重裘","pinyin":"jiù hán mò rú chóng qiú","abbr":"jhmrcq","explanation":"比喻处事须敦本务实。","source":{"text":"语称：‘救寒莫如重裘，止谤莫如修身，疗暑莫如亲冰。’信矣哉！","book":"汉·徐幹《中论·虚道》"},"usage":"作宾语、定语；用于处事"},{"id":23048,"word":"救急不救穷","pinyin":"jiù jí bù jiù qióng","abbr":"jjbjq","explanation":"指只能解除他人一时的急难，而不能救其长时间的穷困。","source":{"text":"俗话说是救急不救穷，我啊，只能救你的急，不会救你的穷。","book":"余华《活着》"},"example":{"text":"自古救急不救穷，他就是一身是铁，也打不了几颗钉的。","book":"陈世旭《将军镇》第二十三章"},"usage":"作谓语、宾语、定语；用于处事"},{"id":23049,"word":"救急扶伤","pinyin":"jiù jí fú shāng","abbr":"jjfs","explanation":"救济危急，扶助伤病。","source":{"text":"救急扶伤，一不小心，向来就很容易被人所诬陷。","book":"鲁迅《南腔北调集·经验》"},"similar":["救死扶伤"],"usage":"作谓语、宾语、定语；指救济危急，扶助伤病"},{"id":23050,"word":"救患分灾","pinyin":"jiù huàn fēn zāi","abbr":"jhfz","explanation":"解除别人的祸患，分担别人的困苦。","source":{"text":"凡侯伯救患分灾讨罪，礼也。","book":"《左传·僖公元年》"},"example":{"text":"行人失辞，～，系邻国常理，奈何来索重赂呢？","book":"蔡东藩《两晋演义》第六十一回"}},{"id":23051,"word":"救时厉俗","pinyin":"jiù shí lì sú","abbr":"jsls","explanation":"匡救时弊，纠正风气。","source":{"text":"先秦学者生当乱世，目击民艰，其立论大率以救时厉俗为主。","book":"梁启超《中国学术思想变迁之大势》第三章"},"usage":"作宾语、定语；用于处事"},{"id":23052,"word":"救死扶伤","pinyin":"jiù sǐ fú shāng","abbr":"jsfs","explanation":"扶：扶助，照料。抢救生命垂危的人，照顾受伤的人。现形容医务工作者全心全意为人民服务的精神。","source":{"text":"与单于连战，十有余日，所杀过半当，虏救死扶伤不给。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"做外科医生的能够以肉补肉，以血补血，则～，造福人群，岂不大哉！","book":"姚雪垠《李自成》第二卷第十四章"},"similar":["治病救人"],"opposite":["落井下石"],"usage":"作定语、宾语、分句；指医生的职责","story":["西汉时期，史学家司马迁因李陵事件被汉武帝打入大牢，被处以腐刑。他的朋友任安来信要他“慎于接物，推贤进士”。任安也因事下狱当斩，司马迁给他写信，叙述自己是怎样忍受痛苦活下来。他当时为李陵辩护，说他英勇善战，使敌人无暇救死扶伤"]},{"id":23053,"word":"救死扶危","pinyin":"jiù sǐ fú wēi","abbr":"jsfw","explanation":"救护生命垂危者，照顾危亡者。","source":{"text":"重人贱畜，往哲之嘉猷；救死扶危，明王之盛事。","book":"唐·张鷟《龙筋凤髓判·左右骁卫》"},"similar":["救死扶伤"],"usage":"作定语、宾语、分句；多指医生的职责"},{"id":23054,"word":"救民于水火","pinyin":"jiù mín yú shuǐ huǒ","abbr":"jmysh","explanation":"救：拯救；水火：比喻灾难。把人民从深重的灾难中拯救出来。","source":{"text":"救民于水火之中，取其残而已矣。","book":"《孟子·滕文公下》"},"example":{"text":"清·褚人获《隋唐演义》第37回：“若二位兄长皆～，出去谋为一番，弟现有千余人，屯扎在高鸡泊，专望驾临动手。”"},"similar":["救民水火"],"usage":"作谓语、定语、宾语；形容灾难深重"},{"id":23055,"word":"救民水火","pinyin":"jiù mín shuǐ huǒ","abbr":"jmsh","explanation":"水火：比喻深重的灾难。把老百姓从深重的灾难中拯救出来。","source":{"text":"救民于水火之中，取其残而已矣。","book":"《孟子·滕文公下》"},"example":{"text":"谡如此来，是要～，不想无民可救，只有贼可杀呢。","book":"清·魏秀仁《花月痕》"},"similar":["救世济民"],"opposite":["烧杀抢掠"],"usage":"作谓语、定语、宾语；形容灾难深重"},{"id":23056,"word":"救民济世","pinyin":"jiù mín jì shì","abbr":"jmjs","explanation":"挽救天下，拯济百姓。","source":{"text":"桓桓武王，继世灭殷。咸任尚父，且作商臣。功冒四海，救世济民。天下宗周，万国是宾。","book":"三国·魏·曹植《周武王赞》"},"example":{"text":"尧、舜、禹、汤、周、孔，时刻以～为心。","book":"清·曹雪芹《红楼梦》第一百一十八回"}},{"id":23057,"word":"救火扬沸","pinyin":"jiù huǒ yáng fèi","abbr":"jhyf","explanation":"沸：开水。比喻不从根本上解决问题。也形容情况危急。","source":{"text":"当是之时，吏治若救火扬沸，非武健严酷，恶能胜其任而愉快乎？","book":"《史记·酷吏列传》"},"opposite":["釜底抽薪"],"usage":"作谓语、定语；比喻不从根本上解决问题"},{"id":23058,"word":"救火投薪","pinyin":"jiù huò tóu xīn","abbr":"jhtx","explanation":"为了扑灭火焰而将木柴扔进火中。比喻采取错误的办法，不但解决不了问题，反而会使问题变得更加严重。","source":{"text":"不治其本而务其末，譬如拯溺而硾之以石，救火而投之以薪。","book":"《邓析子·无厚篇》"},"similar":["救焚投薪"],"usage":"作定语、宾语；指方法不对"},{"id":23059,"word":"救火拯溺","pinyin":"jiù huǒ zhěng nì","abbr":"jhzn","explanation":"形容紧急救助陷于困境中的人。同“救焚拯溺”。","source":{"text":"今燕虐其民，王往而征之，民以为将拯己于水火之中也，箪食壶将以迎王师。","book":"战国·邹·孟轲《孟子·梁惠王》"},"example":{"text":"～，义不得好，辩论是非，言不得巧。","book":"汉·王充《论衡·自纪》"},"similar":["救焚拯溺"],"usage":"作谓语、定语、宾语；指救助陷于困境中的人"},{"id":23060,"word":"救火追亡","pinyin":"jiù huǒ zhuī wáng","abbr":"jhzw","explanation":"亡：指逃跑的人。像救火和追赶逃犯一样。比喻事情紧迫，不可延缓。","source":{"text":"臣闻从时者，犹救火追亡人也，蹶而趋之，唯恐弗及。","book":"《国语·越语》"},"example":{"text":"究之未上榻时，觉得吾身事忙犹如～，一刻难缓。","book":"元·黄元吉《乐育堂语录》卷一"}},{"id":23061,"word":"救灾恤患","pinyin":"jiù zāi xù huàn","abbr":"jzxh","explanation":"恤：救济。指解救他人或他方的灾难祸患。","source":{"text":"今得人钱财，视同粪土，岂为谋王图霸，用之以结客乎？抑救灾恤患，而激于义之不能以己也？","book":"明·李贽《焚书·杂述·寒灯小话》"},"example":{"text":"今焚戍谷伐宋，生事中原，此天授我以救灾恤患之名也。","book":"明·冯梦龙《东周列国志》第三十九回"},"usage":"作谓语、定语；用于书面语"},{"id":23062,"word":"救灾恤邻","pinyin":"jiù zāi xù lín","abbr":"jzxl","explanation":"恤：救济。解救百姓的灾难，解除周围邻国的祸患。后表示邻国或邻居间互相帮助的义务。","source":{"text":"天灾流行，国家代有。救灾恤邻，道也。行道，有福。","book":"《左传·僖公十三年》"},"example":{"text":"明公英名盖世，仁义为怀，湘鄂壤地相接，～，古人所许，何乃自馁若是？","book":"蔡东藩、许廑父《民国通俗演义》第一百二十五回"},"usage":"作谓语、定语；用于书面语"},{"id":23063,"word":"救焚投薪","pinyin":"jiù fén tóu xīn","abbr":"jftx","explanation":"焚：火灾；薪：柴草。投进木柴去救火。比喻采取错误的方法使问题更加严重。","source":{"text":"不治其本而务其末，譬如拯溺锤之以石，救火投之以薪。","book":"《邓析子·无厚》"},"similar":["救焚益薪"],"usage":"作宾语、定语；指方法不对头"},{"id":23064,"word":"救焚拯溺","pinyin":"jiù fén zhěng nì","abbr":"jfzn","explanation":"焚：火灾；溺：水灾。救人于水火之中。形容紧急救助陷于困境中的人。","source":{"text":"救火拯溺，义不得好，辩论是非，言不得巧。","book":"汉·王充《论衡·自纪》"},"example":{"text":"将佐诸人，皆极一时之选，抵川之后，必能～，捍患卫民。","book":"郭孝成《云南光复记》"},"similar":["救火拯溺"],"opposite":["水深火热"],"usage":"作谓语、定语；指救助陷于困境中的人"},{"id":23065,"word":"救焚益薪","pinyin":"jiù fén yì xīn","abbr":"jfyx","explanation":"焚：火灾；薪：柴草。添加木柴去救火。比喻采取错误的方法使问题更加严重。","source":{"text":"所派之营务处何道台，则人更阴狡，以之自辅，是犹救焚而益薪。","book":"清·刘坤一《复李少荃制军》"},"similar":["火上浇油","救焚投薪"],"usage":"作宾语、定语；指方法不对"},{"id":23066,"word":"救燎助薪","pinyin":"jiù liáo zhù xīn","abbr":"jlzx","explanation":"比喻采取错误的办法，不但解决不了问题，反而会使问题变得更加严重。同“救火投薪”。","source":{"text":"名为息黥补劓，实则救燎助薪，宜人心之不服者也。","book":"明·张煌言《答越安抚书》"},"similar":["抱薪救焚"],"usage":"作宾语、定语；用于处事"},{"id":23067,"word":"救经引足","pinyin":"jiù jīng yǐn zú","abbr":"jjyz","explanation":"引：拉；经：缢死。救上吊的人却去拉他的脚。比喻行动与目的相反，越做越离目的越远。","source":{"text":"志不免乎奸心，行不免乎奸道，而求有君子圣人之名，辟之是犹伏而咶天，救经而引其足也。","book":"战国·赵·荀况《荀子·仲尼》"},"example":{"text":"而乃置教官数十员，何异适楚而北辕，救经而引其足耶！","book":"宋·张守《毗陵集·再论增置教授状》"},"similar":["事与愿违","南辕北辙"],"usage":"作宾语、定语；比喻行动与目的相反"},{"id":23068,"word":"救苦弭灾","pinyin":"jiù kǔ mǐ zāi","abbr":"jkmz","explanation":"解脱苦难，消除灾祸。","source":{"text":"谓善者如此收场，不善者如此结果，使人知所趋避，是药人寿世之方，救苦弭灾之具也。","book":"清·李渔《闲情偶寄·词曲·结构》"},"usage":"作谓语、定语；用于书面语"},{"id":23069,"word":"救苦救难","pinyin":"jiù kǔ jiù nàn","abbr":"jkjn","explanation":"佛经中的话。拯救在苦难中的人。","source":{"text":"普度众生，救苦救难，诸佛菩萨！","book":"明·施耐庵《水浒传》第四十五回"},"example":{"text":"弟子虔诚拜祷，伏望菩萨大慈大悲，～，广大灵感，使夫妻再得相见！","book":"明·凌濛初《初刻拍案惊奇》卷八"},"similar":["助人为乐","救困扶危"],"opposite":["杀人放火","投井下石","嫁祸于人"],"usage":"作宾语、定语；常与“大慈大悲”连用"},{"id":23070,"word":"救过不暇","pinyin":"jiù guò bù xiá","abbr":"jgbx","explanation":"补救过失都来不及。同“救过不赡”。","source":{"text":"九卿碌碌奉其官，救过不赡，何暇论绳墨之外乎！","book":"《史记·酷吏列传》"},"example":{"text":"符檄督责，终日憔悴，而～，惘然自疑，何智之于前而愚于此？","book":"宋·苏舜钦《上三司副使段公书》"},"similar":["救过不给","救过不遑"],"usage":"作谓语；用于劝诫等"},{"id":23071,"word":"救过不给","pinyin":"jiù guò bù gěi","abbr":"jgbg","explanation":"犹救过不赡。补救过失都来不及。","source":{"text":"群臣百姓救过不给，何变之敢图？","book":"《史记·李斯列传》"},"example":{"text":"时会计法严，钱粮完欠，每项各限十分定考成，条例繁赜，有司～。","book":"《清史稿·姜希辙传》"},"similar":["后悔不及","救过不暇"],"usage":"作谓语；用于劝诫等"},{"id":23072,"word":"救过不赡","pinyin":"jiù guò bù shàn","abbr":"jgbs","explanation":"赡：足。弥补、改正自己的罪过唯恐来不及。形容法网深密或处境危殆时惴惴不安，惧怕获罪的惶恐情态。","source":{"text":"九卿碌碌奉其官，救过不赡，何暇论绳墨之外乎！","book":"《史记·酷吏列传》"},"example":{"text":"百职庶司，～，上下睽孤，足为隐虑。","book":"《明史·郑三俊传》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":23073,"word":"救过不遑","pinyin":"jiù guò bù huáng","abbr":"jgbh","explanation":"救：挽救；遑：闲暇。补救过失都来不及。","source":{"text":"上方综核名实，分别功罪，群臣救过不遑。","book":"清·黄宗羲《子刘子行状》上卷"},"similar":["救过不暇"],"usage":"作谓语；用于劝诫等"},{"id":23074,"word":"救过补阙","pinyin":"jiù guò bǔ quē","abbr":"jgbq","explanation":"阙：同“缺”，不足，缺点。挽救过错，弥补不足。","source":{"text":"故箴规之兴，将以救过补阙，然犹依违讽喻，使言之者无罪，闻之者足以自诫。","book":"《晋书·潘岳传》"},"usage":"作谓语、宾语；指挽救过错，弥补不足"},{"id":23075,"word":"救难解危","pinyin":"jiù nán jiě wēi","abbr":"jnjw","explanation":"帮助陷入困境的人解除危难。","source":{"text":"这两个女子，便都有些盗贼意思，不比前边这几个报仇雪耻，救难解危，方是修仙正路。","book":"明·凌濛初《初刻拍案惊奇》第34回"},"usage":"作谓语、宾语、定语；用于处世"},{"id":23076,"word":"救饥拯溺","pinyin":"jiù jī zhěng nì","abbr":"jjzn","explanation":"指拯救饥饿和危急中的人。","source":{"text":"除暴安良，乃革命真谛；救饥拯溺，实吾辈天职。","book":"罗正纬《滦州革命纪实初稿》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":23077,"word":"救黥医劓","pinyin":"jiù qíng yī yì","abbr":"jqyy","explanation":"黥，刺面；劓，割鼻。均为古代刑罚。指医治刺面之伤，补上割掉之鼻，比喻恢复本来面目。","source":{"text":"庸讵知夫造物者之不息我黥而补我劓，使我乘成以随先生邪？","book":"语出《庄子·大宗师》"},"example":{"text":"～世无方，断简陈编付药房。","book":"宋·王安石《生日次韵南郭子》之一"},"usage":"作宾语、定语；用于处事"},{"id":23078,"word":"敕始毖终","pinyin":"chì shǐ bì zhōng","abbr":"csbz","explanation":"自始至终警饬谨慎。","source":{"text":"凡综理彭氏家政七十余年，敕始毖终，内外秩秩。","book":"清·曾国藩《户部员外郎彭君墓表》"},"usage":"作谓语；指谨慎"},{"id":23079,"word":"敖不可长","pinyin":"ào bù kě zhǎng","abbr":"abkz","explanation":"敖：通“傲”，傲慢。傲慢之心不可以滋长。","source":{"text":"敖不可长，欲不可从，志不可满，乐不可极。","book":"西汉·戴圣《礼记·曲礼上》"},"example":{"text":"我们要教育他～的道理。"},"similar":["欲不可从"],"usage":"作谓语、定语；指戒骄戒躁"},{"id":23080,"word":"敖世轻物","pinyin":"áo shì qīng wù","abbr":"asqw","explanation":"敖，通“傲”。鄙弃世俗，看不起别人。也指高傲自大。","source":{"text":"敖世轻物，不污于俗。","book":"《淮南子·齐俗训》"}},{"id":23081,"word":"教一识百","pinyin":"jiāo yī shí bǎi","abbr":"jysb","explanation":"形容具有特殊的才能、智慧。","source":{"text":"文王生而明圣，太任教之，以一而识百。","book":"汉·刘向《列女传·母仪》"},"usage":"作定语、宾语；多用于学生"},{"id":23082,"word":"教亦多术","pinyin":"jiào yì duō shù","abbr":"jyds","explanation":"教：教诲；术：方法。教诲人有多种方法。","source":{"text":"教亦多术矣，予不屑之教诲也者，是亦教诲之而已矣。","book":"《孟子·告子下》"},"usage":"作宾语、定语；指教诲人有多种方法"},{"id":23083,"word":"教妇初来，教儿婴孩","pinyin":"jiào fù chū lái，jiào ér yīng hái","abbr":"jfcljeyh","explanation":"指对一个人施加教育应该及时及早。","source":{"text":"俗谚曰：‘教妇初来，教儿婴孩。诚哉斯语。’","book":"北齐·颜之推《颜氏家训·教子》"},"usage":"作谓语、分句；指对一个人施教应该及早"},{"id":23084,"word":"教学相长","pinyin":"jiào xué xiāng zhǎng","abbr":"jxxz","explanation":"教和学两方面互相影响和促进，都得到提高。","source":{"text":"是故学然后知不足，教然后知困。知不足然后能自反也，知困然后能自强也。故曰教学相长也。","book":"《礼记·学记》"},"example":{"text":"再如教员天天在堂上给大家讲，不特不能减其所有，反可得～的益处。","book":"清·梁启超《“知不可而为”主义与“为而不有”主义》"},"similar":["互教互学","敩学相长"],"opposite":["兼容并包"],"usage":"作谓语、宾语、定语；表示教与学相互促进"},{"id":23085,"word":"教导有方","pinyin":"jiào dǎo yǒu fāng","abbr":"jdyf","explanation":"教育引导很有办法。","source":{"text":"虽然是他叔祖教导有方，也是他福至心灵，官星透露，才得一变而为闻一知十的聪明人。","book":"清·吴趼人《二十年目睹之怪现状》第99回"},"example":{"text":"他老人家～，我们才能赢得比赛。"},"usage":"作谓语、宾语；用于老师、长辈等"},{"id":23086,"word":"教无常师","pinyin":"jiào wú cháng shī","abbr":"jwcs","explanation":"受教育不必有固定的老师。","source":{"text":"德无常师，主善为师。","book":"《尚书·咸有一德》"},"example":{"text":"～，道在则是。","book":"晋·潘岳《归田赋》"},"usage":"作谓语、宾语；指凡有长处者都可以为师"},{"id":23087,"word":"教条主义","pinyin":"jiào tiáo zhǔ yì","abbr":"jtzy","explanation":"不对具体事物进行调查研究，只是生搬硬套现成原则、概念来处理问题的思想作风。","source":{"text":"我们的教条主义者在这个问题上的错误，就是，一方面，不懂得必须研究矛盾的特殊性，认识各别事物的特殊的本质。","book":"毛泽东《矛盾论》"},"example":{"text":"章诒和《往事并不如烟·两片落叶，偶尔吹在一起》：“那样的话，我们的盟就要变成～者。”"},"similar":["本本主义"],"usage":"作主语、宾语、定语；用于处事"},{"id":23088,"word":"教猱升木","pinyin":"jiāo náo shēng mù","abbr":"jnsm","explanation":"猱：猴子的一种。教猴子爬树。比喻指使坏人干坏事。","source":{"text":"毋教猱升木，如涂涂附。","book":"《诗经·小雅·角弓》"},"example":{"text":"虽是少数人代理国事，却不是少数人把持国事，怎么好藉口于天然不平等，替民贼～呢？","book":"清·梁启超《新中国未来记》第三回"},"usage":"作谓语、宾语；比喻教唆坏人干坏事"},{"id":23089,"word":"敛发谨饬","pinyin":"liǎn fā jǐn chì","abbr":"lfjc","explanation":"敛：收集；发：散发；谨饬：认真仔细。指对粮食、物资的收集与发放认真仔细。","source":{"text":"乡为义廪，敛发谨饬。","book":"唐·柳宗元《贞符》"},"usage":"作宾语、定语；用于管理"},{"id":23090,"word":"敛后疏前","pinyin":"liǎn hòu shū qián","abbr":"lhsq","explanation":"敛：收束；疏：稀，疏朗。收束尾部，展开前部。古代的一种阵法。列阵周密牢固，疏利于战斗","source":{"text":"若舍舟楫，即平原，敛后疏前，则江淮之所短；弃车马，游飞浪，乘流驰逐，非中国之所长。","book":"《魏书·李苗传》"},"usage":"作宾语、定语；用于处事"},{"id":23091,"word":"敛声匿迹","pinyin":"liǎn shēng nì jì","abbr":"lsnj","explanation":"不声张，不露面。形容隐藏起来，不公开出现。","source":{"text":"这样，识时务的就不得不敛声匿迹。","book":"《解放日报》1944.8.18"},"usage":"作谓语；指藏匿起来"},{"id":23092,"word":"敛声屏息","pinyin":"liǎn shēng bǐng xī","abbr":"lspx","explanation":"抑制语声和呼吸。形容畏惧、小心的样子。同“敛声屏气”。","source":{"text":"三十万军民敛声屏息地倾听领袖的庄严洪亮的宣告。","book":"周立波《李大贵观礼》"},"similar":["敛声屏气"],"usage":"作谓语、宾语、状语；形容精神集中"},{"id":23093,"word":"敛声屏气","pinyin":"liǎn shēng bǐng qì","abbr":"lsbq","explanation":"敛：收入束；屏：抑止。抑制语声和呼吸。形容畏惧、小心的样子。","source":{"text":"这些人个个皆敛声屏气如此。","book":"清·曹雪芹《红楼梦》第三回"},"example":{"text":"萧队长走到屋子当间，大伙都～，李毛驴也停止唠嗑。","book":"周立波《暴风骤雨》第二部"},"similar":["敛色屏气"],"usage":"作谓语、宾语；形容精神集中"},{"id":23094,"word":"敛容屏气","pinyin":"liǎn róng bǐng qì","abbr":"lrbq","explanation":"敛容：收起笑容，态度变得严肃。屏气：闭住气不敢出声。比喻有所畏惧而恭敬谨慎，不敢稍微放肆。","source":{"text":"鞠躬如也，屏气似不息者。","book":"《论语·乡党》"},"similar":["敛色屏气"],"usage":"作谓语、定语、状语；用于处事"},{"id":23095,"word":"敛容息气","pinyin":"liǎn róng xī qì","abbr":"lrxq","explanation":"收起笑容，屏住呼吸。形容谨慎畏惧，不敢放肆。同“敛色屏气”。","source":{"text":"光每朝见，上虚已敛容，礼下之已甚。","book":"《论语·乡党》：“鞠躬如也，屏气似不息者。”《汉书·霍光传》"},"example":{"text":"及至到了公堂，他才～。","book":"清·石玉昆《三侠五义》第八十三回"},"similar":["敛色屏气"],"opposite":["嬉皮笑脸"],"usage":"作谓语、宾语；形容态度严肃"},{"id":23096,"word":"敛影逃形","pinyin":"liǎn yǐng táo xíng","abbr":"lytx","explanation":"隐蔽身形。比喻隐居不出。","source":{"text":"方敛影逃形，匡坐编蓬之下，遂遭烟露余彩，日月末光。","book":"南朝·梁·江淹《奏记诣南徐州新安王》"},"usage":"作谓语、定语；用于处事"},{"id":23097,"word":"敛怨求媚","pinyin":"liǎn yuàn qiú mèi","abbr":"lyqm","explanation":"指因向上献媚，不顾人民怨恨而征收钱物。","source":{"text":"上生日，诸道节度使献金帛、器服、珍玩、骏马为寿，共直缗钱二十四万。常衮上言，以为‘节度使非能男耕女织，必取之于人，敛怨求媚，不可长也。’","book":"《资治通鉴·唐代宗大历元年》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":23098,"word":"敛手屏足","pinyin":"liǎn shǒu bǐng zú","abbr":"lspz","explanation":"缩手止步。形容不敢妄为。","source":{"text":"列强自知理屈，亦渐为之敛手屏足。","book":"《辛亥革命前十年间时论选集·滇越铁路问题》"},"usage":"作谓语、定语；用于处事"},{"id":23099,"word":"敛手待毙","pinyin":"liǎn shǒu dài bì","abbr":"lsdb","explanation":"毙：死。捆起手来等死。比喻遇到困难不积极想办法，坐着等失败。","source":{"text":"予顷修《靖康实录》，窃痛一时之祸，以堂堂大邦，中外之兵数十万，曾不能北向发一矢、获一胡，端坐都城，束手就毙。","book":"宋·洪迈《容斋续笔·靖康时事》"},"example":{"text":"天下哪有～的。","book":"清·黄小配《廿载繁华梦》第三十四回"},"similar":["束手待毙"],"usage":"作谓语、定语；指等死"},{"id":23100,"word":"敛手束脚","pinyin":"liǎn shǒu shù jiǎo","abbr":"lssj","explanation":"敛：收，约束。形容因寒冷而四肢伸展不开的样子。也形容做事顾虑多，不敢大胆放手。","source":{"text":"敛：收，约束。形容因寒冷而四肢伸展不开的样子。也形容做事顾虑多，不敢大胆放手。"}},{"id":23101,"word":"敛翼待时","pinyin":"liǎn yì dài shí","abbr":"lyds","explanation":"敛：收敛；翼：翅膀。收束翅膀等待起飞的时机。比喻收敛锋芒才华，等待时机。","source":{"text":"敛：收敛；翼：翅膀。收束翅膀等待起飞的时机。比喻收敛锋芒才华，等待时机。"}},{"id":23102,"word":"敛色屏气","pinyin":"liǎn sè bǐng qì","abbr":"lsbq","explanation":"收起笑容，屏住呼吸。形容谨慎畏惧，不敢放肆。","source":{"text":"县之奸豪，皆敛色屏气，指权相戒，不可犯公法。","book":"宋·欧阳修《江宁府句容县令赠尚书兵部员外郎王公墓志铭》"},"similar":["敛声屏气"],"opposite":["嬉皮笑脸"],"usage":"作谓语；形容谨慎"},{"id":23103,"word":"敛锷韬光","pinyin":"liǎn è tāo guāng","abbr":"letg","explanation":"比喻隐匿锋芒，才气不外露。","source":{"text":"仍乞敛锷韬光，以绝敌人窥伺。","book":"明·张煌言《上鲁国主启二》"},"similar":["锋芒不露"],"opposite":["锋芒毕露"],"usage":"作谓语；指人谦虚"},{"id":23104,"word":"敛骨吹魂","pinyin":"liǎn gǔ chuí hún","abbr":"lgch","explanation":"指再造生灵，使死者复生。敛骨，使散掉的骨骼集结起来。吹魂，把散走的魂魄吹送回体。","source":{"text":"幸因约法之弘，承解网之宥，犹当降等薪粲，遂乃顿释钳赭，敛骨吹魂，还编黔庶。","book":"《南史·袁昂传》"},"usage":"作谓语、定语；用于比喻句"},{"id":23105,"word":"敝帚千金","pinyin":"bì zhǒu qiān jīn","abbr":"bzqj","explanation":"一把破扫帚，当千金那样贵重。比喻东西虽不好，但自己十分珍惜。","source":{"text":"帝闻之，下诏让吴汉副将刘禹曰：‘城降，婴儿老母，口以万数，一旦放兵纵火，闻之可谓酸鼻。家有敝帚，享之千金。禹宗室子孙，故尝更职，何忍行此！’","book":"汉·刘珍《东观汉记·光武帝纪》"},"example":{"text":"因循守旧，～的态度是要不得的。"},"similar":["敝帚自珍"],"opposite":["弃若敝屣"],"usage":"作谓语、定语、状语；用于劝诫、责备和批评","story":["东汉初年，光武帝刘秀派大司马吴汉与征南大将军岑彭去攻打在成都称帝的公孙述，汉军进兵神速，与公孙述进行了殊死搏斗才攻占成都，吴汉下令屠城。刘秀指责他，说老百姓家里有破扫帚也价值千金，不能掠夺他们的财产失去民心"]},{"id":23106,"word":"敝帚自享","pinyin":"bì zhǒu zì xiǎng","abbr":"bzzx","explanation":"犹言敝帚自珍。比喻东西虽不好，自己却很珍惜。","source":{"text":"唯余事斯，素有微契，而敝帚自享，从无连篇累牍之作。","book":"清·包世臣《艺舟双楫·书刘文清后》"},"similar":["敝帚自珍"],"opposite":["视若敝屣"],"usage":"作谓语、定语、状语；指爱惜自己的东西"},{"id":23107,"word":"敝帚自珍","pinyin":"bì zhǒu zì zhēn","abbr":"bzzz","explanation":"敝：破的，坏的；珍：爱惜。把自己家里的破扫帚当成宝贝。比喻东西虽然不好，自己却很珍惜。","source":{"text":"遗簪见取终安用，敝帚虽微亦自珍。","book":"汉·刘珍《东观汉纪·光武帝纪》：“一量放兵纵火，闻之可以酸鼻。家有敝帚，享之千金。”宋·陆游《秋思》"},"example":{"text":"但写出以后，却不很爱惜羽毛，有所谓“～”的意思。","book":"鲁迅《华盖集·并非闲话〈三〉》"},"similar":["敝帚千金","爱惜羽毛"],"opposite":["视如敝屣","在所不惜"],"usage":"作谓语、定语、状语；指爱惜自己的东西","story":["东汉初年，光武帝刘秀派大司马吴汉与征南大将军岑彭去攻打在成都称帝的公孙述，汉军进兵神速，与公孙述进行了殊死搏斗才攻占成都，吴汉下令屠城。刘秀指责他，说老百姓家里有破扫帚也价值千金，不能掠夺他们的财产失去民心"]},{"id":23108,"word":"敝帷不弃","pinyin":"bǐ wéi bù qì","abbr":"bwbq","explanation":"指破旧之物也自有用处。","source":{"text":"仲尼之畜狗死，使子贡埋之，曰：‘吾闻之也，敝帷不弃，为埋马也；敝盖不弃，为埋狗也。’","book":"《礼记·檀弓下》"},"similar":["敝盖不弃"],"usage":"作宾语、定语；指爱惜物品"},{"id":23109,"word":"敝盖不弃","pinyin":"bǐ gài bù qì","abbr":"bgbq","explanation":"指破旧之物也自有其用。","source":{"text":"仲尼之畜狗死，使子贡埋之，曰：‘吾闻之也，敝帷不弃，为埋马也；敝盖不弃，为埋狗也。’","book":"《礼记·檀弓下》"},"similar":["敝帷不弃"],"usage":"作宾语、定语；指爱惜物品"},{"id":23110,"word":"敝綈恶粟","pinyin":"bì tì è sù","abbr":"btes","explanation":"指衣食粗劣。","source":{"text":"翼翼公子，敝綈恶粟。","book":"宋·王安石《祭范颖州文》"}},{"id":23111,"word":"敝绨恶粟","pinyin":"bì tí è sù","abbr":"btes","explanation":"指衣食粗劣。","source":{"text":"翼翼公子，敝绨恶粟。","book":"宋·王安石《祭范颖州文》"},"similar":["敝衣粝食"],"opposite":["锦衣玉食"],"usage":"作宾语、定语；指艰苦生活"},{"id":23112,"word":"敝衣枵腹","pinyin":"bì yī xiāo fù","abbr":"byxf","explanation":"衣破肚饥。形容生活困顿。","source":{"text":"故富者贫而贫者死，其不死者敝衣枵腹，横被苛敛。","book":"明·归有光《上总制书》"},"similar":["穷困潦倒"],"usage":"作谓语、定语；指生活穷困"},{"id":23113,"word":"敝衣粝食","pinyin":"bì yī lì shí","abbr":"byls","explanation":"破衣粗食。形容生活困顿。","source":{"text":"穷阎漏屋，敝衣粝食，或至于不能自给，未尝动其意也。","book":"宋·曾巩《徐复传》"},"example":{"text":"其在方氏者，虽未死，而～，几无以为生。","book":"清·刘大櫆《谢氏妹六十寿辰序》"},"similar":["敝绨恶粟"],"opposite":["锦衣玉食"],"usage":"作宾语、定语；指艰苦生活"},{"id":23114,"word":"敝车羸马","pinyin":"bì chē léi mǎ","abbr":"bclm","explanation":"敝：破；羸：瘦弱。破车劣马。比喻清廉俭朴。","source":{"text":"上以廉取人，则敝车羸马，恶衣菲食，凡可以中上意者，无所不至。","book":"梁启超《王荆公传》第12章"},"similar":["弊车驽马"],"usage":"作主语、宾语、定语；指装备差"},{"id":23115,"word":"敝鼓丧豚","pinyin":"bì gǔ sàng tún","abbr":"bgst","explanation":"敝：破，坏；丧：失去；豚：猪。指击破鼓、烹掉猪以求神治病，病仍未治好。形容费而无益。","source":{"text":"故丧于湿而击鼓鼓痹，则必有敝鼓丧豚之费矣，而未有俞疾之福也。","book":"《荀子·解蔽》"},"similar":["徒劳无益"],"usage":"作谓语、定语；指办事方式不对"},{"id":23116,"word":"敞胸露怀","pinyin":"chǎng xiōng lù huái","abbr":"cxlh","explanation":"敞开衣服，露出胸部。亦形容作风粗野，没有礼貌。","source":{"text":"被搜检的那些士子也有解开衣裳敞胸露怀的，也有被那班下役伸手到满身上混掏的。","book":"清·文康《儿女英雄传》第三十四回"},"example":{"text":"在他对面这个人是个黄白净子，有二十几根儿胡子，穿绸裹缎，～，歪戴帽子，斜瞪眼睛，后边跟着一帮打手，一个个拧眉瞪眼，咋咋唬唬的。","book":"单田芳《童林传》第二二三回"}},{"id":23117,"word":"敢不听命","pinyin":"gǎn bù tīng mìng","abbr":"gbtm","explanation":"敢：反语，“怎敢”、“不敢”之意。怎么敢不遵照你的命令办呢？。","source":{"text":"齐侯次于虢，燕人行成，曰：‘敝邑知罪，敢不听命！’","book":"春秋·鲁·左丘明《左传·昭公七年》"},"similar":["敢不唯命","敢不如命","敢不承命"],"usage":"作谓语、定语；指不敢推辞"},{"id":23118,"word":"敢不唯命","pinyin":"gǎn bù wéi mìng","abbr":"gbwm","explanation":"敢：反语，“怎敢”、“不敢”之意。怎么敢不遵照你的命令办呢？。","source":{"text":"万超奋然谓其部下曰：‘非止逃生，我足建勋，汝曹能乎？’众皆跃然喜曰：‘敢不唯命！’","book":"《宋史·李万超传》"},"similar":["敢不承命","敢不听命","敢不如命"],"usage":"作谓语、定语；指不敢推辞"},{"id":23119,"word":"敢不如命","pinyin":"gǎn bù rú mìng","abbr":"gbrm","explanation":"敢：反语，“怎敢”、“不敢”之意。怎么敢不遵照你的命令办呢？。","source":{"text":"玄微道：‘此乃易事，敢不如命。’","book":"明·冯梦龙《醒世恒言》第四卷"},"example":{"text":"夫人斟情酌理，两得其中，～！","book":"清·名教中人《好逑传》第17回"},"similar":["敢不承命","敢不听命","敢不唯命"],"usage":"作谓语、定语；指不敢推辞"},{"id":23120,"word":"敢不承命","pinyin":"gǎn bù chéng mìng","abbr":"gbcm","explanation":"敢：反语，“怎敢”、“不敢”之意；承：接受。怎么敢不承受你的命令呢？或怎么敢不接受你的意见呢？。","source":{"text":"吾君子顺先典，贶某重礼，某不敢辞，敢不承命。","book":"《仪礼·士昏礼》"},"example":{"text":"苟列定矣，～。","book":"春秋·鲁·左丘明《左传·僖公十五年》"},"similar":["敢不如命"],"usage":"作谓语、定语；指不敢推辞"},{"id":23121,"word":"敢为敢做","pinyin":"gǎn wéi gǎn zuò","abbr":"gwgz","explanation":"做事勇敢，无所畏惧。同“敢作敢为”。","source":{"text":"这的是败坏风俗，那一个敢为敢做！","book":"元·关汉卿《鲁斋郎》第三折"},"example":{"text":"那计氏虽也还敢怒敢言，当不起晁大舍也就～。","book":"清·西周生《醒世姻缘传》第一回"}},{"id":23122,"word":"敢作敢为","pinyin":"gǎn zuò gǎn wéi","abbr":"gzgw","explanation":"指行事不怕风险，无所顾忌。","source":{"text":"逞刁顽全不想他妻我妇，这的是败坏风俗，那一个敢为敢做？","book":"元·关汉卿《包待制智斩鲁斋郎》第三折"},"example":{"text":"唐俭点选进宫，敕赐才人，性格聪敏，凡诸音乐，一习便能，～，并不知宫中忌惮。","book":"清·禇人获《隋唐演义》第六十九回"},"similar":["敢做敢当"],"opposite":["谨小慎微","胆小怕事"],"usage":"作谓语、定语；指无所顾忌"},{"id":23123,"word":"敢作敢当","pinyin":"gǎn zuò gǎn dāng","abbr":"gzgd","explanation":"敢于放手做事，也敢于承担责任。","source":{"text":"敢作敢当，才是英雄好汉。","book":"清·石玉昆《三侠五义》第75回"},"example":{"text":"他在单位很有魄力，做任何事情都～。"},"similar":["敢作敢为"],"usage":"作谓语、定语；指敢于承担责任"},{"id":23124,"word":"敢做敢为","pinyin":"gǎn zuò gǎn wéi","abbr":"gzgw","explanation":"做事勇敢，无所畏惧","source":{"text":"石湖(范成大)、诚斋(杨万里)……与放翁(陆游)并称，而诚斋较之石湖，更有敢作敢为之色，颐指气使，似乎无不如意，所以其名尤重。","book":"清·翁方纲《石洲诗话》"},"similar":["敢作敢为"],"usage":"作谓语、定语；指敢于承担责任"},{"id":23125,"word":"敢做敢当","pinyin":"gǎn zuò gǎn dāng","abbr":"gzgd","explanation":"敢于放手做事，也敢于承担责任","source":{"text":"可喜他心直口快最相热，敢做敢当报不平。","book":"清·无名氏《刘公案》第35回"},"example":{"text":"王朔《过把瘾就死》：“瞧人潘佑军，多男子汉，～。”"},"similar":["敢做敢为"],"usage":"作谓语、宾语、定语；指人敢于承担责任"},{"id":23126,"word":"敢勇当先","pinyin":"gǎn yǒng dāng xiān","abbr":"gydx","explanation":"犹奋勇当先。比喻勇于承担重任，领头去干。","source":{"text":"若不是老相国雄才大略，和鏄诸敢勇当先，岂有今日。","book":"元·李寿卿《伍员吹箫》第四折"},"example":{"text":"他每都能骑战马，出来的～。","book":"明·无名氏《紫泥宣》第一折"},"usage":"作谓语、宾语；用于处事"},{"id":23127,"word":"敢布腹心","pinyin":"gǎn bù fù xīn","abbr":"gbfx","explanation":"敢：谦词，表示自己很冒昧；布：阐述、表述；腹心：比喻诚意。至诚的话。旧时表示恭敬谨慎地陈述自己内心深处的话。","source":{"text":"敢布腹心，君实图之。","book":"《左传·宣公十二年》"},"example":{"text":"西汉·司马迁《史记·楚世家》：“若君不忘厉、宣、桓、武，不绝其社稷，使改事君，孤之愿也，非敢望也。～。”"},"similar":["敬布腹心"],"usage":"作谓语；用于自谦"},{"id":23128,"word":"敢怒不敢言","pinyin":"gǎn nù bù gǎn yán","abbr":"gnbgy","explanation":"敢：胆量大；言：说。内心愤怒但不敢说出来。","source":{"text":"珍哥、晁住虽是心里不愿意，也只得敢怒不敢言的。","book":"清·西周生《醒世姻缘传》第七回"},"example":{"text":"高阳《胡雪岩全传·灯火楼台》：“曾笑苏求功心切，不免责骂叱喝，工匠～。”"},"similar":["敢怒而不敢言"],"opposite":["敢怒敢言"],"usage":"作谓语、定语、补语、分句；指胸中愤怒"},{"id":23129,"word":"敢怒敢言","pinyin":"gǎn nù gǎn yán","abbr":"gngy","explanation":"敢于愤怒，又敢于说出来。","source":{"text":"那计氏虽也还敢怒敢言，当不起晁大舍也敢为敢做。","book":"清·西周生《醒世姻缘传》第一回"},"example":{"text":"我就喜欢她～的性格。"},"similar":["敢作敢为"],"usage":"作谓语、定语；指敢说"},{"id":23130,"word":"敢怒而不敢言","pinyin":"gǎn nù ér bù gǎn yán","abbr":"gnebgy","explanation":"心里愤怒而嘴上不敢说。指慑于威胁，胸中愤怒不敢吐露。","source":{"text":"使天下之人，不敢言而敢怒。","book":"唐·杜牧《阿房宫赋》"},"example":{"text":"李忠见鲁达凶猛，～，只得陪笑道，好性急的人。","book":"明·施耐庵《水浒》第三回"},"similar":["敢怒不敢言"],"usage":"作谓语、定语、状语；指胸中愤怒"},{"id":23131,"word":"敢怨而不敢言","pinyin":"gǎn yuàn ér bù gǎn yán","abbr":"gyebgy","explanation":"内心怨恨但不敢说出来。","source":{"text":"吏无避忌，白昼肆行，使天下敢怨而不敢言，敢怒而不敢诛。","book":"宋·邓牧《伯牙琴·吏道》"},"similar":["敢怒而不敢言"],"usage":"作谓语、定语、补语、分句；指胸中愤怒"},{"id":23132,"word":"敢想敢干","pinyin":"gǎn xiǎng gǎn gàn","abbr":"gxgg","explanation":"敢于冲破某种束缚去思考问题和大胆实践。","source":{"text":"其实既是个细琢细磨的能人巧匠，也有着敢想敢干的猛劲儿。","book":"康濯《太阳初升的时候》"},"example":{"text":"年轻人应～，有股闯劲"},"similar":["敢想敢说"],"usage":"作谓语、定语；用于为人"},{"id":23133,"word":"敢想敢说","pinyin":"gǎn xiǎng gǎn shuō","abbr":"gxgs","explanation":"敢于冲破某种束缚去思考问题和发表见解。","source":{"text":"敢想敢说也是一种斗争，首先要和自己的旧思想作斗争。","book":"谢常见哉《青年人怎样锻炼自己》"},"similar":["敢想敢干"],"usage":"作谓语、定语；用于为人"},{"id":23134,"word":"散伤丑害","pinyin":"sǎn shāng chǒu hài","abbr":"ssch","explanation":"形容不和谐的声音。","source":{"text":"散伤丑害，不知之音，音气不和必与彼乖，故言其必逆于耳。","book":"《鬼谷子·中经》：“是以声散伤丑害者，言必逆于耳也。”陶弘景注"},"usage":"作宾语、定语；用于书面语"},{"id":23135,"word":"散兵游勇","pinyin":"sǎn bīng yóu yǒng","abbr":"sbyy","explanation":"勇：清代指战争期间临时招募的士兵。原指没有统帅的逃散士兵。现有指没有组织的集体队伍里独自行动的人。","source":{"text":"为着确保城乡治安、安定社会秩序的目的，一切散兵游勇，均应向当地人民解放军或人民政府投诚报到。","book":"毛泽东《中国人民解放军布告》"},"example":{"text":"余汉谋的参谋长叶肇，要逃去海南逃不出，就带领一些～和一些地方的土匪头子，逃到深山里。","book":"陈残云《山谷风烟》"},"similar":["残兵败将"],"opposite":["坚甲利兵"],"usage":"作主语、宾语；指没有统帅的逃散士兵"},{"id":23136,"word":"散发披襟","pinyin":"sàn fà pī jīn","abbr":"sfpj","explanation":"蓬松着头发，敞开衣襟。形容不修边幅的的悠闲神态。","source":{"text":"回首江乡，月观风亭，不边石上，幸有散发披襟处。","book":"宋·柳永《过涧歇近》"},"example":{"text":"夏，夏，雨余亭厦，纨扇轻，煎风乍，～，弹棋打马。","book":"明·冯梦龙《警世通言》卷十九"}},{"id":23137,"word":"散发抽簪","pinyin":"sàn fà chōu zān","abbr":"sfcz","explanation":"指弃官隐居，逍遥自在。","source":{"text":"散发抽簪，永纵一壑。","book":"三国·魏·锤会《遗荣赋》"},"usage":"作宾语、定语；用于生活"},{"id":23138,"word":"散带衡门","pinyin":"sǎn dài héng mén","abbr":"sdhm","explanation":"指退官闲居或过隐居生活。衡门，简陋的门户。","source":{"text":"衡门之下，可以栖迟。","book":"语出《诗·陈风·衡门》"},"example":{"text":"充居宰辅之重，权倾一时，而准～，不及人事，唯诵佛经，修营塔庙而已。","book":"《晋书·外戚传·何准》"},"usage":"作宾语、定语；用于书面语"},{"id":23139,"word":"散摊子","pinyin":"sàn tān zǐ","abbr":"stz","explanation":"散伙，解体。","example":{"text":"他苦心经营的企业就这样～了。"},"usage":"作谓语、定语；用于口语"},{"id":23140,"word":"散木不材","pinyin":"sǎn mù bù cái","abbr":"smbc","explanation":"比喻没有用处的事物。","source":{"text":"已矣，勿言之矣，散木也！以为舟则沉，以为棺槨则速腐，以为器则速毁，以为门户则速構，以为柱则蠹。是不材之木也，无所可用。","book":"《庄子·人间世》"}},{"id":23141,"word":"散灰扃户","pinyin":"sàn huī jiōng hù","abbr":"shjh","explanation":"在地上撒灰，将门户关锁。旧时用来讥讽防闲妻妾的病态心理与可笑行为。","source":{"text":"然少有痴病，而多猜忌，防闲妻妾，过为苛酷，而有散灰扃户之谭闻于时。故时谓妒痴为‘李益疾’。","book":"《旧唐书·李益传》"},"usage":"作宾语、定语；用于书面语"},{"id":23142,"word":"散言碎语","pinyin":"sǎn yán suì yǔ","abbr":"sysy","explanation":"犹言闲言碎语。唠叨些与正事无关的话。","source":{"text":"今被他一篇散言碎语带去，却又不是劳而无功？","book":"明·吴承恩《西游记》第80回"},"example":{"text":"我向来不喜欢他的～。"},"similar":["闲言碎语"],"usage":"作主语、宾语、定语；指闲言碎语"},{"id":23143,"word":"散闷消愁","pinyin":"sàn mèn xiāo chóu","abbr":"smxc","explanation":"指通过消遣，解除愁闷。","source":{"text":"待去歌楼作乐，散闷消愁，倦游柳陌恋烟花。","book":"元·高安道《哨遍·嗓淡行院》套数"},"usage":"作谓语、宾语；用于书面语"},{"id":23144,"word":"散阵投巢","pinyin":"sàn zhèn tóu cháo","abbr":"sztc","explanation":"指群鸟分散，各投窠巢。","source":{"text":"醉客散了，如同散阵投巢的乌鸦。","book":"闻一多《红独·李白之死》"},"usage":"作谓语、定语；用于鸟类"},{"id":23145,"word":"散马休牛","pinyin":"sàn mǎ xiū niú","abbr":"smxn","explanation":"指不兴战事。","source":{"text":"《书·武成》：“归马于华山之阳，放牛于桃林之野，示天下弗服”。蔡沈集传引《乐记》：“武王胜商，渡河而西，马散之华山之阳而弗复乘，牛放之桃林之野而弗复服”。"},"example":{"text":"南朝·陈·徐陵《为陈主答周主论和亲书》：“虽毁戈铸戟，未拟上皇，～，载怀偃伯。”"},"similar":["马放南山","刀枪入库","归马放牛"],"opposite":["穷兵黩武"],"usage":"作谓语、定语、宾语；用于战后","story":["商朝末年，商纣王荒淫无度，百姓怨声载道。周武王率领大军把商都包围起来，商纣王登上鹿台放火自杀。周武王建立周朝，定都镐京，让士兵回家从事农业生产，把征用的牛马全部退还，让全国老百姓过上安居乐业的日子"]},{"id":23146,"word":"敦世厉俗","pinyin":"dūn shì lì sú","abbr":"dsls","explanation":"敦：促成；厉：激励。促使社会风俗纯朴起来。","source":{"text":"恬既孝行殊异，声著邦壤，敦风厉俗，弘益兹多。","book":"《梁书·甄恬传》"},"example":{"text":"欲轻赋税，则财不足；欲威四海，则兵不强；欲兴利除害，则无其人；欲～，则无其具。","book":"宋·苏轼《御试制科策》"},"similar":["敦风厉俗"],"usage":"作谓语、宾语；用于书面语"},{"id":23147,"word":"敦庞之朴","pinyin":"dūn páng zhī pǔ","abbr":"dpzp","explanation":"敦庞：敦厚；朴：没有加工过的，不加修饰。比喻质朴敦厚。","source":{"text":"货华虚之文，有敦庞之朴。","book":"汉·王充《论衡·自纪》"},"usage":"作宾语；用于人"},{"id":23148,"word":"敦敦实实","pinyin":"dūn dūn shí shí","abbr":"ddss","explanation":"指人长得结实粗壮。","source":{"text":"起先她认不出来这个敦敦实实的青年是谁，但觉得有点面熟。","book":"路遥《平凡的世界》第一卷第12章"},"similar":["结结实实"],"usage":"作定语、状语；用于口语"},{"id":23149,"word":"敦本务实","pinyin":"dūn běn wù shí","abbr":"dbws","explanation":"崇尚根本，注重实际。","source":{"text":"二三子不思敦本务实，以眇眇之身，任天下之重。","book":"明·张居正《翰林院读书说》"},"example":{"text":"明·张居正《翰林院读书说》：“二三子不思敦本务实，以眇眇之身，任天下之重。”"},"similar":["实事求是"],"usage":"作谓语、定语、宾语；指注重实际"},{"id":23150,"word":"敦睦邦交","pinyin":"dūn mù bāng jiāo","abbr":"dmbj","explanation":"敦：纯厚，诚恳；睦：和睦。保全国家之间的关系诚挚友好。","source":{"text":"但就大体而言，是极有益于敦睦邦交的。","book":"鲁迅《“立此存照”（七）》"},"example":{"text":"这样可以～，又能加深双边友谊。"},"usage":"作宾语、定语；用于国家交往"},{"id":23151,"word":"敦诗说礼","pinyin":"dūn shī shuō lǐ","abbr":"dssl","explanation":"敦：敦厚。诗：《诗经》。诚恳地学《诗》，大力讲《礼》。旧时统治阶级表示要按照《诗经》温柔敦厚的精神和古礼的规定办事。","source":{"text":"假使人来查办，一领他们到这敦诗说礼之堂来看看，捐册、帐本、褒奖状……他们还能指摘什么？","book":"许地山《在费总理的客厅里》"},"example":{"text":"～在现代社会还可以行得通。"},"similar":["知书达理"],"usage":"作谓语、定语；指注重精神等"},{"id":23152,"word":"敦风厉俗","pinyin":"dūn fēng lì sú","abbr":"dfls","explanation":"使民风纯朴敦厚。","source":{"text":"恬既孝行殊异，声著邦壤，敦风厉俗，弘益兹多。","book":"《梁书·甄恬传》"},"example":{"text":"皆所以谋其始迹，访厥成罪，～，永资世范者也。","book":"《魏书·郭祚传》"},"similar":["敦世厉俗"],"usage":"作谓语、宾语；用于书面语"},{"id":23153,"word":"敦默寡言","pinyin":"dūn mò guǎ yán","abbr":"dmgy","explanation":"稳重而少言语。","source":{"text":"回回、博果密之子，库库之兄也，敦默寡言，嗜学能文。","book":"《续资治通鉴·元泰定帝泰定元年》"},"similar":["沉默寡言"],"usage":"作谓语、状语；用于处事"},{"id":23154,"word":"敩学相长","pinyin":"zuàn xué xiāng cháng","abbr":"xxxc","explanation":"指教与学相互促进。","source":{"text":"使吾而是也，因得以明其是五，而非也，因得以去其非，盖敩学相长也。","book":"明·王守仁《教条示龙场诸生·责善》"},"similar":["教学相长"],"usage":"作谓语、宾语、定语；表示教与学相互促进"},{"id":23155,"word":"敬上接下","pinyin":"jìng shàng jiē xià","abbr":"jsjx","explanation":"尊敬在己之上者，爱护在己之下者。形容待人谦恭有礼。同“敬上爱下”。","source":{"text":"安贫乐道，忽于时荣。敬上接下，温故知新。","book":"《隶释·汉金乡长侯成碑》"},"similar":["敬上爱下"],"usage":"作谓语、宾语；用于书面语"},{"id":23156,"word":"敬上爱下","pinyin":"jìng shàng ài xià","abbr":"jsax","explanation":"敬：尊敬。尊敬在己之上者，爱护在己之下者。形容待人谦恭有礼。","source":{"text":"孝弟忠恕，敬上爱下，博通旧闻，德行醇备，至于黄发，靡有愆失。","book":"《汉书·王莽传下》"},"example":{"text":"儿臣生性不如弟弟们聪敏，办差或者出了差错。但儿臣自问～，并没有什么大错。","book":"二月河《雍正皇帝》第一百三十四回"},"similar":["敬上接下"],"usage":"作谓语、宾语；指人的待人接物"},{"id":23157,"word":"敬业乐群","pinyin":"jìng yè yào qún","abbr":"jylq","explanation":"敬业：违心于学业；乐群：乐于与好朋友相处。专心学习，和同学融洽相处。","source":{"text":"一年视离经辨志，三年视敬业乐群。","book":"《礼记·学记》"},"example":{"text":"自己调整心境，朋友之间、社会之间，可以～而不孤立，所谓以文会友。","book":"南怀瑾《论语别裁·阳货第十七》"},"usage":"作谓语、定语；指乐于与朋友探讨学问"},{"id":23158,"word":"敬之如宾","pinyin":"jìng zhī rú bīn","abbr":"jzrb","explanation":"敬：尊敬；宾：宾客。像对待宾客那样尊敬对方。","source":{"text":"故谏议大夫李行修娶江西廉使王仲舒女。贞懿贤淑，行修敬之如宾。","book":"唐·温奢《续定命录》"},"example":{"text":"有个侍御李十一郎，名行修，妻王氏夫人，乃是江西廉使王仲舒女，贞懿贤淑，行修～。","book":"明·凌濛初《二刻拍案惊奇》卷二十三"},"usage":"作谓语；用于尊敬对方"},{"id":23159,"word":"敬事不暇","pinyin":"jìng shì bù xiá","abbr":"jsbx","explanation":"事：侍奉；暇：空闲。恭敬地为人做事，忙得没有闲暇。形容百依百顺，竭尽全力地效劳。","source":{"text":"时议皆以为安重诲方弄国权，从荣诸王敬事不暇，独忌从珂威名，每于帝前屡言其短，巧作窥图，冀能倾陷。","book":"《旧五代史·唐书·明宗纪》"},"example":{"text":"至是，重诲用事，自皇子从荣、从厚皆～。","book":"《资治通鉴·后唐纪六》"},"usage":"作谓语、定语；用于处事"},{"id":23160,"word":"敬事后食","pinyin":"jìng shì hòu shí","abbr":"jshs","explanation":"指凡事应当先尽力去做，待有功绩后才能享受俸禄。","source":{"text":"语出《论语·卫灵公》：“事君敬其事，而后其食”。邢昺疏：“言当先尽力敬其职事，必有勋绩而后食禄也”。"},"example":{"text":"但臣等窃以～者，人臣靖共之心。","book":"明·张居正《请叙录日讲诸臣疏》"},"usage":"作谓语、定语；用于处事"},{"id":23161,"word":"敬天爱民","pinyin":"jìng tiān ài mín","abbr":"jtam","explanation":"敬奉天命，爱护百姓。","source":{"text":"及问为治之方，则对以敬天爱民为本。","book":"《元史·释老传·丘处机》"},"example":{"text":"陛下嗣位以来，非不～，而天变民穷特甚者，臣窃恐圣德虽修而未至，大伦虽正而未笃。","book":"《明史·王竑传》"},"usage":"作谓语、定语；用于称赞君王等"},{"id":23162,"word":"敬如上宾","pinyin":"jìng rú shàng bīn","abbr":"jrsb","explanation":"上宾：尊贵之客。像对待尊贵的客人那样敬重某人。","source":{"text":"故谏议大夫李行修娶江西廉使王仲舒女。贞懿贤淑，行修敬之如宾。","book":"唐·温奢《续定命录》"},"example":{"text":"北侠父子在任，太守～。","book":"清·石玉昆《三侠五义》第八十四回"},"usage":"作谓语；指十分尊贵"},{"id":23163,"word":"敬姜犹绩","pinyin":"jìng jiāng yóu jì","abbr":"jjyj","explanation":"以之为富贵而不忘根本、不求安逸的典实。","source":{"text":"今我，寡也，尔又在下位，朝夕处事，犹恐忘先人之业，况有怠惰，其何以避辟！","book":"《国语·鲁语下》载，春秋时文伯歜已为鲁相，其母敬姜犹纺绩不辍，歜问之，敬姜曰"},"example":{"text":"娄樗道：‘我爹叫我买两件农器儿，还买一盘弹花的弓弦。’孝移道：‘此～意也。’","book":"《歧路灯》第三回"},"usage":"作宾语、定语；用于书面语","story":["春秋时期，鲁国文伯歜的母亲敬姜早年守寡，靠缉麻线为生。文伯歜做了鲁相后，她仍旧操劳纺织。文伯歜认为她的这种行为与他现今的地位不相符。敬姜回答道：“今我，寡也，尔又在下位，朝夕处事，犹恐忘先人之业，况有怠惰，其何以避辟。”"]},{"id":23164,"word":"敬守良箴","pinyin":"jìng shǒu liáng zhēn","abbr":"jslz","explanation":"箴：规劝，劝告。认真听取、遵守有益的规戒。","source":{"text":"非素日恪遵女诫，敬守良箴，何能至此。","book":"清·李汝珍《镜花缘》第一回"}},{"id":23165,"word":"敬小慎微","pinyin":"jìng xiǎo shèn wēi","abbr":"jxsw","explanation":"敬：谨慎小心；小、微：指细小、不起眼的东西。对细微的事物也采取小心谨慎的态度。形容待人处事非常谨慎。","source":{"text":"圣人敬小慎微，动不失时，百射重戒，祸乃不滋。","book":"汉·刘安《淮南子·人间训》"},"example":{"text":"故为人君者，谨本详始，～，志如死灰，形如委衣，安精养神，寂寞无为，休形无见影，揜声无出响。","book":"汉·董仲舒《春秋繁露》卷六"},"similar":["谨小慎微"],"usage":"作谓语、宾语；指非常慎重"},{"id":23166,"word":"敬布腹心","pinyin":"jìng bù fù xīn","abbr":"jbfx","explanation":"敬：恭敬；布：阐述、表述；腹心：比喻诚意。至诚的话。旧时表示恭敬谨慎地陈述自己内心深处的话。","source":{"text":"敢布腹心，君实图之。","book":"《左传·宣公十二年》"},"example":{"text":"～，伏惟鉴烛。","book":"清·纪昀《阅微草堂笔记·如是我闻二》"},"similar":["敢布腹心"],"usage":"作谓语；用于自谦"},{"id":23167,"word":"敬恭桑梓","pinyin":"jìng gōng sāng zǐ","abbr":"jgsz","explanation":"敬恭：尊敬，热爱；桑梓：桑树和梓树，古时家宅旁边常栽的树木，比喻故乡。热爱故乡和尊敬故乡的人。","source":{"text":"维桑与梓，必恭敬之。","book":"《诗经·小雅·小弁》"},"example":{"text":"富贵还乡，格外要～，，也是雯青一点厚道。","book":"清·曾朴《孽海花》第七回"},"usage":"作谓语、宾语；指热爱故乡和尊敬故乡的人"},{"id":23168,"word":"敬授人时","pinyin":"jìng shòu rén shí","abbr":"jsrs","explanation":"指将历法付予百姓，使知时令变化，不误农时。后以之指颁布历书。亦作“敬授民时”。","source":{"text":"《书·尧典》：“乃命羲和，钦若昊天，历象日月星辰，敬授人时”。蔡沉集传：“人时，谓耕获之候”。《史记·五帝本纪》引作“敬授民时”。"},"example":{"text":"卿其～，益修臣职，毋替尔祖事大之诚，以副朕不忘柔远之意。","book":"《元史·仁宗纪一》"},"similar":["敬授民时"],"usage":"作谓语、宾语；用于书面语"},{"id":23169,"word":"敬授民时","pinyin":"jìng shòu mín shí","abbr":"jsms","explanation":"指将历法付予百姓，使知时令变化，不误农时。后以之指颁布历书。同“敬授人时”。","source":{"text":"伏惟陛下，敬授民时，造幄籍圃。","book":"《史记·五帝本纪》：“乃命羲、和，敬顺昊天，数法日月星辰，敬授民时。”《艺文类聚》卷三五引南朝·梁元帝《庆东耕启》"},"example":{"text":"食乃民天，农为治本，垂之千载，贻诸百王，莫不～，躬耕帝籍。","book":"《梁书·元帝纪》"},"similar":["敬授人时"],"usage":"作谓语、宾语；用于书面语"},{"id":23170,"word":"敬时爱日","pinyin":"jìng shí ài rì","abbr":"jsar","explanation":"指珍惜时间。","source":{"text":"故敬时爱日，非老不休，非疾不息，非死不舍。","book":"《吕氏春秋·上农》"},"usage":"作宾语、定语；用于书面语"},{"id":23171,"word":"敬终慎始","pinyin":"jìng zhōng shèn shǐ","abbr":"jzss","explanation":"为人处事小心谨慎。","source":{"text":"事君慎始而敬终。","book":"西汉·戴圣《礼记·表记》"},"example":{"text":"～，研核微章。","book":"南朝·梁·慧皎《高僧传·义解·康法朗》"},"similar":["谨小慎微"],"usage":"作谓语、定语；指为人处世始终小心谨慎"},{"id":23172,"word":"敬老尊贤","pinyin":"jìng lǎo zūn xián","abbr":"jlzx","explanation":"尊敬年纪大的或品德高尚、才能出众的人。","source":{"text":"入其境，土地辟除，敬老尊贤，则有庆，益其地。","book":"汉·刘向《说苑·修文》"},"example":{"text":"又～，凡国中年七十以上，月致粟帛，加以饮食珍味，使人慰问安否。","book":"《东周列国志》第四十九回"},"similar":["尊老爱幼"],"usage":"作谓语、定语；指尊敬年长和贤良的人"},{"id":23173,"word":"敬老怜贫","pinyin":"jìng lǎo lián pín","abbr":"jllp","explanation":"老：年老的人；怜：怜恤。尊敬老人，怜恤家境困苦的人。形容人有恭谨慈爱的美好品德。","source":{"text":"吾神又将小女桂花配与奇童为妻，则为你恤孤念寡，敬老怜贫，因此感动天地也。","book":"元·无名氏《刘弘嫁婢》第四折"},"example":{"text":"闻知张公艺长者，恤孤念寡，～，出无倚之丧，嫁孤寒之女。","book":"元·无名氏《九世同居》第一折"},"similar":["敬老恤贫"],"usage":"作谓语、定语、宾语；指人的品德"},{"id":23174,"word":"敬老恤贫","pinyin":"jìng lǎo xù pín","abbr":"jlxp","explanation":"老：年老的人。尊敬老人，怜恤家境困苦的人。形容人有恭谨慈爱的美好品德。","source":{"text":"吾神又将小女桂花配与奇童为妻，则为你恤孤念寡，敬老怜贫，因此感动天地也。","book":"元·无名氏《刘弘嫁婢》第四折"},"example":{"text":"于是以文种治国政，以范蠡治军旅，尊贤礼士，～，百姓大悦。","book":"明·冯梦龙《东周列国志》第八十回"},"similar":["敬老怜贫"],"usage":"作谓语、定语、宾语；指敬老怜贫"},{"id":23175,"word":"敬老慈少","pinyin":"jìng lǎo cí shǎo","abbr":"jlcs","explanation":"尊敬老人，爱护儿童。同“敬老慈幼”。","source":{"text":"敬老慈少，使诡猾暴横者不得自肆，平民安之，而官事赖以省。","book":"宋·陈亮《蔡元德墓碣铭》"},"similar":["敬老慈幼","敬老慈稚"],"usage":"作谓语、定语、宾语；指尊老爱小"},{"id":23176,"word":"敬老慈幼","pinyin":"jìng lǎo cí yòu","abbr":"jlcy","explanation":"敬：尊敬；慈：怜爱。尊敬老人，爱护儿童。","source":{"text":"敬老慈幼，无忘宾旅。","book":"《孟子·告子下》"},"example":{"text":"臣闻先王之政，～，罪人不孥，鳏寡孤独，时时矜恤。","book":"清·禇人获《隋唐演义》第十五回"},"similar":["敬老爱幼","敬老慈小"],"usage":"作谓语、定语、宾语；指尊敬老人爱护儿童"},{"id":23177,"word":"敬老慈稚","pinyin":"jìng lǎo cí zhì","abbr":"jlcz","explanation":"尊敬老人，爱护儿童。同“敬老慈幼”。","source":{"text":"尚贤睦族，以任门户；敬老慈稚，爰及行路。","book":"宋·陈亮《祭妻弟何少嘉文》"},"similar":["敬老慈少","敬老慈幼"],"usage":"作谓语、定语、宾语；指尊老爱小"},{"id":23178,"word":"敬老慈穉","pinyin":"jìng lǎo cí zhì","abbr":"jlcz","explanation":"尊敬老人，爱护儿童。同“敬老慈幼”。"},{"id":23179,"word":"敬老爱幼","pinyin":"jìng lǎo ài yòu","abbr":"jlay","explanation":"敬：尊敬；爱：怜爱。尊敬老人，爱护儿童。","source":{"text":"敬老慈幼，无忘宾旅。","book":"《孟子·告子下》"},"similar":["尊老爱幼"],"usage":"作主语、宾语、定语；用于处世等"},{"id":23180,"word":"敬而远之","pinyin":"jìng ér yuǎn zhī","abbr":"jeyz","explanation":"表面上表示尊敬，实际上不愿接近。也用作不愿接近某人的讽刺话。","source":{"text":"务民之义，敬鬼神而远之。","book":"《论语·雍也》"},"example":{"text":"若遇此等人，～，以免杀身之祸。","book":"清·刘鹗《老残游记》第十一回"},"similar":["敬若神明","若即若离"],"opposite":["平易近人","和蔼可亲","形影相随"],"usage":"作谓语、宾语、定语；指有顾虑不愿接近","story":["春秋时期，孔子认为仁包括恭、宽、信、敏、惠、智、勇、忠、恕、孝、悌等，实行的方法是“己所不欲，勿施于人”和“己欲立而立人，己欲达而达人”。学生樊迟问怎样才算智，孔子说：“务民之义，敬鬼神而远之，可谓知矣。”"]},{"id":23181,"word":"敬若神明","pinyin":"jìng ruò shén míng","abbr":"jrsm","explanation":"神明：泛指神，像敬重神一样敬重对方。形容对某人或某物崇拜到了极点。多用作贬义。","source":{"text":"民率其君，爱之如父母，仰之如日月，敬之如神明，畏之如雷霆。","book":"春秋·鲁·左丘明《左传·襄公十四年》"},"example":{"text":"是以爱之如父母，敬之若神明，用能享国多年。","book":"《旧唐书·李密传》"},"usage":"作谓语；形容极其尊重"},{"id":23182,"word":"敬谢不敏","pinyin":"jìng xiè bù mǐn","abbr":"jxbm","explanation":"谢：推辞；不敏：不聪明，没有才能。恭敬地表示能力不够或不能接受。多作推辞做某事的婉辞。","source":{"text":"买羊沽酒谢不敏，偶逢明月曜桃李。","book":"唐·韩愈《寄卢仝》诗"},"example":{"text":"若曰凡为诗者，必须意深思远，神韵悠然，则～矣。","book":"清·得硕亭《〈草珠一串〉一序》"},"similar":["无能为力","力所不及"],"opposite":["责无旁贷","当仁不让","敬事不暇"],"usage":"作谓语、宾语；多作推辞做某事的婉辞"},{"id":23183,"word":"敬贤下士","pinyin":"jìng xián xià shì","abbr":"jxxs","explanation":"尊敬贤者，屈身交接士人。旧时谓封建帝王或官员重视人才。","source":{"text":"敬贤下士，乐善不倦。","book":"《汉书·谷永传》"},"similar":["礼贤下士"],"usage":"作谓语、宾语；用于尊重人才"},{"id":23184,"word":"敬贤爱士","pinyin":"jìng xián ài shì","abbr":"jxas","explanation":"尊重和爱护有才德的人。","source":{"text":"实子安逊，学尚明察，敬贤爱士，以秀才为郎中。","book":"《晋书·张轨传》"},"example":{"text":"阎立本知道这武后娘娘为人～，阎立本虽想欲整理朝纲，无奈一人力薄。","book":"清·无名氏《狄公案》第二十九回"},"similar":["敬贤礼士"],"usage":"作谓语、宾语；指尊重人才"},{"id":23185,"word":"敬贤礼士","pinyin":"jìng xián lǐ shì","abbr":"jxls","explanation":"礼：以礼相待，尊重；士：古时称有学问的人。尊重品德高尚、学识出众的人。","source":{"text":"实子安逊，学尚明察，敬贤爱士，以秀才为郎中。","book":"《晋书·张轨传》"},"example":{"text":"玄德公纳谏如流，～。","book":"明·无名氏《庞掠四郡》第四折"},"similar":["礼贤下士","敬贤重士"],"usage":"作谓语、定语；指尊重人才"},{"id":23186,"word":"敬贤重士","pinyin":"jìng xián zhòng shì","abbr":"jxzs","explanation":"尊重和爱护有才德的人。同“敬贤爱士”。","source":{"text":"元帅宽仁厚德，敬贤重士，岂肯记旧仇，并不挟冤。","book":"明·无名氏《四马投唐》第四折"},"similar":["敬贤礼士"],"usage":"作谓语、定语；指尊重人才"},{"id":23187,"word":"敬酒不吃吃罚酒","pinyin":"jìng jiǔ bù chī chī fá jiǔ","abbr":"jjbccfj","explanation":"比喻不受抬举。","source":{"text":"鸠山（威胁地）老朋友，要是敬酒不吃吃罚酒的话，可别怪我不懂得交情！","book":"京剧《红灯记·赴宴斗鸠山》"},"example":{"text":"异口同声大骂老牛筋，说他不识抬举，说他敬酒不吃偏要吃罚酒。","book":"马烽《结婚现场会》"},"usage":"作宾语、分句；指人的处世"},{"id":23188,"word":"敬陈管见","pinyin":"jìng chén guǎn jiàn","abbr":"jcgj","explanation":"敬陈：恭敬地陈述；管见：从管子里观看东西，所见极小，指浅陋的见解。毕恭毕敬地阐明自己浅陋的见解或建议。多用于自谦词。","example":{"text":"因御史董元醇～一折，内称请皇太后暂时权理朝政，俟数年后，朕能亲裁庶务，再行归政。","book":"蔡东藩《清史演义》第七十一回"},"usage":"作宾语、定语；多用于自谦词"},{"id":23189,"word":"敬鬼神而远之","pinyin":"jìng guǐ shén ér yuǎn zhī","abbr":"jgseyz","explanation":"敬之而不亲近之意。指对某些人所持的一种态度，即不愿理睬他，又怕得罪他，对他客客气气，绝不接近。","source":{"text":"务民之义，敬鬼神而远之，可谓知矣。","book":"春秋·鲁·孔丘《论语·雍也》"},"example":{"text":"他对人始终是～的态度。"},"similar":["敬而远之"],"usage":"作宾语、定语；用于比喻句","story":["春秋时期，孔子带领弟子周游列国，两度在卫国没能推销他的“仁政”，只好去陈国，经过宋、郑两地的劫难后，孔子继司马牛病后也相继得病，一度昏迷。子路让他向鬼神求祷，孔子则一向敬鬼神而远之，坚持他的“富贵在天，生死有命”的观点而不求祷"]},{"id":23190,"word":"数一数二","pinyin":"shǔ yī shǔ èr","abbr":"syse","explanation":"不算第一也算第二。形容突出。","source":{"text":"这门亲原是老亲，且又和我们是同在户部挂名行商，也是数一数二的大门户。","book":"清·曹雪芹《红楼梦》第七十九回"},"example":{"text":"他的学习成绩在班里是～的。"},"similar":["名列前茅","出类拔萃","首屈一指"],"opposite":["平淡无奇","不足为奇","不见经传"],"usage":"作谓语、定语；指十分突出"},{"id":23191,"word":"数不胜数","pinyin":"shǔ bù shèng shǔ","abbr":"sbss","explanation":"数：计算。数都数不过来。形容数量极多，很难计算。","source":{"text":"类似这样的奇迹灵异，还数不胜数，所以一年四季，方岩香火不绝，而尤以春秋为盛。","book":"《方岩记静》"},"example":{"text":"我们决不能像旧学校那样，用～的，九分无用一分曲了的知识来充塞青年的头脑。","book":"《论学习共产主义》"},"similar":["不计其数","多如牛毛"],"opposite":["屈指可数","寥寥无几"],"usage":"作谓语、定语、状语；形容数量极多"},{"id":23192,"word":"数东瓜，道茄子","pinyin":"shǔ dōng guā，dào qié zǐ","abbr":"sdgdqz","explanation":"形容说话罗唆，没完没了。","source":{"text":"那珍哥狂荡了一日回来，正要数东瓜，道茄子，讲说打围的故事。","book":"《醒世姻缘》第二回"},"example":{"text":"你不要在这里～了。"},"similar":["说东道西"],"usage":"作谓语、状语；指说话罗唆"},{"id":23193,"word":"数九寒天","pinyin":"shǔ jiǔ hán tiān","abbr":"sjht","explanation":"数九：从冬至起，每九天为一“九”，三九、四九最寒冷。最寒冷的那些日子。","source":{"text":"数九寒天下大雪，天气虽冷心内热。","book":"《刘胡兰》第一幕"},"example":{"text":"我最怕北方的～。"},"similar":["数九天"],"opposite":["三伏天"],"usage":"作宾语、定语；指冷天"},{"id":23194,"word":"数以万计","pinyin":"shù yǐ wàn jì","abbr":"sywj","explanation":"以万来计算。形容极多。","source":{"text":"监局内臣数以万计，利源兵柄尽以付之，犯法纵奸，一切容贷，此防微之道未终也。","book":"《明史·彭韶传》"},"example":{"text":"这里的鱼儿～，打捞十分容易。"},"similar":["数不胜数"],"opposite":["寥寥无几"],"usage":"作谓语、定语；指数量多"},{"id":23195,"word":"数典忘祖","pinyin":"shǔ diǎn wàng zǔ","abbr":"sdwz","explanation":"数：数着说；典：指历来的制度、事迹。谈论历来的制度、事迹时，把自己祖先的职守都忘了。比喻忘本。也比喻对于本国历史的无知。","source":{"text":"籍父其无后乎！数典而忘其祖。","book":"《左传·昭公十五年》"},"example":{"text":"我们要重视中国历史知识的学习，免得出现～的笑话。"},"similar":["崇洋媚外"],"opposite":["饮水思源"],"usage":"作谓语、宾语、定语；用于人","story":["周朝时期，晋国典籍官籍谈被派遣到周朝去参加葬礼。周景王设宴招待他，并问为什么没有礼物朝贡。籍谈说晋国在受封时就没得到朝廷的赏赐，因此不必朝贡。周景王驳得他体无完肤，并指责他是数典而忘其祖"]},{"id":23196,"word":"数墨寻行","pinyin":"shǔ mò xún háng","abbr":"smxx","explanation":"数墨：一字字地读；寻行：一行行地读。指只会诵读文句，而不能理解义理。也指专在文字上下功夫。","source":{"text":"口内诵经千卷，体上问经不识。不解佛法圆通，徒劳寻行数墨。","book":"宋·释道原《景德传灯录》卷二十九"},"example":{"text":"也不须昼夜，～。","book":"元·刘处玄《满庭芳》词"}},{"id":23197,"word":"数奇不偶","pinyin":"shù jī bù ǒu","abbr":"sqbo","explanation":"奇：单数，古人认为单数不吉；不偶：不遇。指命运不好，事多不顺利。用以形容人的经历坎坷，潦倒失意。","source":{"text":"官止于协领，年止于下寿，抑何数奇命偶也？","book":"清·汪琬《资政大夫驻防京口协领祖公墓志铭》"},"example":{"text":"吴玉帅以命世之才，抱救国之志，～，养晦黄州，志士仁人无不扼腕。","book":"丁中江《北洋军阀史话》二三七"},"usage":"作谓语、定语；用于书面语"},{"id":23198,"word":"数奇不遇","pinyin":"shù jī bù yù","abbr":"sqby","explanation":"奇：单数，古人认为单数不吉。指命运不好，事多不顺利。用以形容人的经历坎坷，潦倒失意。","source":{"text":"数奇不遇高皇封，时去反遭醉尉骂。","book":"清·尤侗《虎头诗》"}},{"id":23199,"word":"数奇命蹇","pinyin":"shù jī mìng jiǎn","abbr":"sqmj","explanation":"奇：单数，古人认为单数不吉；蹇：不顺利。指命运不好，事多乖违。","source":{"text":"数奇命蹇，遂无望于高门；日往月来，竟消声于下邑。","book":"唐·杨炯《原州百泉县令李君神道碑》"},"usage":"作谓语、定语；用于书面语"},{"id":23200,"word":"数往知来","pinyin":"shǔ wǎng zhī lái","abbr":"swzl","explanation":"数：计算；往：过去；来：未来。明了过去，可以推知未来。","source":{"text":"数往者顺，知来者逆。","book":"《周易·说卦》"},"example":{"text":"洪武中，朝廷访求通晓历数，～，试无不验者，必封侯，食禄千五百石。","book":"明·陆容《菽园杂记》卷一"},"usage":"作谓语、定语；指知道前事，可以推知未来"},{"id":23201,"word":"数白论黄","pinyin":"shǔ bái lùn huáng","abbr":"sblh","explanation":"比喻计较金钱。","source":{"text":"那吃敲才怕不口里嚼蛆，那厮待数黑论黄，恶紫夺朱。","book":"元·王实甫《西厢记》第五本第四折"},"example":{"text":"～，脱不了只多着我！你不如把我打发了，你老婆还是老婆，汉子还是汉子。","book":"清·西周生《醒世姻缘传》第三回"},"similar":["论黄数白"],"usage":"作谓语、定语；指计较金钱"},{"id":23202,"word":"数短论长","pinyin":"shǔ duǎn lùn cháng","abbr":"sdlc","explanation":"犹言说长道短，说三道四。","source":{"text":"无道人之短，无说己之长。","book":"汉·崔瑗《座佑铭》"},"example":{"text":"我当初梁山要强，受不的闲言剩语，～。","book":"明·无名氏《九宫八卦阵》第三折"},"similar":["说长道短","说三道四"],"usage":"作谓语、宾语、定语；指说长道短"},{"id":23203,"word":"数米而炊","pinyin":"shǔ mǐ ér chuī","abbr":"smec","explanation":"炊：烧火做饭。数着米粒做饭。比喻计较小利。也形容生活困难。","source":{"text":"简发而栉，数米而炊。","book":"《庄子·庚桑楚》"},"example":{"text":"积财聚谷，日不暇给，真个是～，称柴而爨。","book":"明·冯梦龙《警世通言》卷五"},"similar":["数米量柴"],"usage":"作谓语；指生活贫困","story":["唐朝时期，著名诗人韦庄出身贫寒，成名后还保持俭朴的生活。经常数着米粒来做饭，用秤称好柴禾来烧火，经常被人耻笑，这样的节俭已经到了可鄙的地步"]},{"id":23204,"word":"数米而炊，称柴而爨","pinyin":"shǔ mǐ ér chuī，chēng chái ér cuàn","abbr":"smecccec","explanation":"爨：烧火煮饭。指称柴草，数米粒做饭。比喻只注意小事，不从大处着眼。","source":{"text":"称薪而爨，数米而炊，可以治小而未可以治大也。","book":"《淮南子·泰族训》"},"example":{"text":"因有这四愿、五恨，心常不足，积财聚谷，日不暇给，真个是～。","book":"明·冯梦龙《警世通言》卷五"}},{"id":23205,"word":"数米量柴","pinyin":"shǔ mǐ ér chái","abbr":"smlc","explanation":"比喻过分计较琐碎之事。也形容生活困窘。","source":{"text":"积财聚谷，日不暇给，真个是数米而炊，称柴而爨。","book":"明·冯梦龙《警世通言》卷五"},"example":{"text":"只因这一番，有分教；风尘恶俗之中，亦藏俊彦；～之外，别有经纶。","book":"清·吴敬梓《儒林外史》第四十五回"},"similar":["数米而炊"],"usage":"作谓语、定语；指生活贫困"},{"id":23206,"word":"数罪并罚","pinyin":"shù zuì bìng fá","abbr":"szbf","explanation":"对前犯数罪的犯人并合处罚。","source":{"text":"我们对他～，让他服务公众240小时。"},"example":{"text":"我们对他～，让他服务公众240小时"},"usage":"作宾语、定语、谓语；用于法律文书"},{"id":23207,"word":"数见不鲜","pinyin":"shuò jiàn bù xiān","abbr":"sjbx","explanation":"数：屡次；鲜：新杀的禽兽，引伸为新鲜。本指对于常来之客，就不宰杀禽兽招待。后指常常见到，并不新奇。","source":{"text":"一岁中往来过他客，率不过再三过，数见不鲜，无久慁公为也。","book":"《史记·郦生陆贾列传》"},"example":{"text":"这种谣言，在各处所发生的真～了。","book":"鲁迅《集外集拾遗·启事》"},"similar":["屡见不鲜"],"usage":"作谓语、定语；指司空见惯"},{"id":23208,"word":"数黄道白","pinyin":"shǔ huáng dào bái","abbr":"shdb","explanation":"背后乱加评论，肆意诽谤别人。同“数黄道黑”。","source":{"text":"元来那王尼有一身奢嘛的本事，第一件一张花嘴，数黄道白，指东话西，专一在官宦人家打踅，那女眷们没一个不被他哄得投机的。","book":"明·凌濛初《初刻拍案惊奇》卷三十四"},"similar":["数黑论白","数黄道黑"],"usage":"作谓语、定语；指说长道短"},{"id":23209,"word":"数黄道黑","pinyin":"shǔ huáng dào hēi","abbr":"shdh","explanation":"数落着黄的又说着黑的。形容说话罗索，东拉西扯。","source":{"text":"口里不住的絮絮叨叨，数黄道黑，真个象死了人的一般。","book":"明·吴承恩《西游记》第三十九回"},"example":{"text":"再说薛夫人合薛如卞弟兄三个并家中一切上下的人，各人忙乱正经的事，凭那龙氏～的嚎丧。","book":"清·西周生《醒世姻缘传》第六十回"},"similar":["数黑论黄"],"usage":"作谓语、定语；指说长道短"},{"id":23210,"word":"数黑论白","pinyin":"shǔ hēi lùn bái","abbr":"shlb","explanation":"背后乱加评论，肆意诽谤别人。同“数黑论黄”。","source":{"text":"非是俺巧言令色，索与您数黑论白。这囊呵，有图书万卷收，只青毡一片来。","book":"明·康海《中山狼》第二折"},"similar":["数黑论黄","数黄道白"],"usage":"作谓语、定语；指说长道短"},{"id":23211,"word":"数黑论黄","pinyin":"shǔ hēi lùn huáng","abbr":"shlh","explanation":"数：数落，批评。背后乱加评论，肆意诽谤别人。","source":{"text":"你入门来便闹起，有甚的论黄数黑。","book":"元·杨文奎《儿女团圆》第一折"},"example":{"text":"那喫敲才怕不口里嚼蛆，那厮待～，恶紫夺珠。","book":"元·王实甫《西厢记》第五本第四折"},"similar":["说长道短","挑拔是非","数黑论白"],"usage":"作谓语、定语；指说长道短"},{"id":23212,"word":"敲冰戛玉","pinyin":"qiāo bīng jiá yù","abbr":"qbjy","explanation":"戛：打击。形容声音清脆，宛如敲击玉石和冰块发出的声响。","source":{"text":"听敲冰戛玉，恨云怨雨，声声总在愁处。","book":"宋·杨无咎《垂丝钓·邓端友席上赠吕倩倩》词"},"usage":"作宾语、定语；用于声音等"},{"id":23213,"word":"敲冰求火","pinyin":"qiāo bīng qiú huǒ","abbr":"qbqh","explanation":"敲开冰找火。比喻不可能实现的事。","source":{"text":"敲冰求火，论功不遂。","book":"《大光明藏经》下卷"},"similar":["缘木求鱼"],"usage":"作谓语、宾语；比喻不可能实现的事"},{"id":23214,"word":"敲冰玉屑","pinyin":"qiāo bīng yù xiè","abbr":"qbyx","explanation":"泛指精美的纸张。","source":{"text":"后三年，当予亡命，萧永言同醉，见予举似，急索纸而恨无敲冰玉屑，以备恶语。","book":"元·刘埙《隐居通议·诗歌》"},"usage":"作宾语、定语；指纸张"},{"id":23215,"word":"敲冰索火","pinyin":"qiāo bīng suǒ huǒ","abbr":"qbsh","explanation":"比喻行动和目的相反，一定不会成功。","source":{"text":"若敲冰而索火，类缘木以求鱼。","book":"《永明智觉禅师唯心诀》第四卷"},"similar":["缘木求鱼","敲冰求火"],"usage":"作宾语、定语；用于处事"},{"id":23216,"word":"敲山振虎","pinyin":"qiāo shān zhèn hǔ","abbr":"qszh","explanation":"指故意示警，使人震动。","source":{"text":"这要不用个敲山振虎的主意，怎的是个了当？","book":"清·文康《儿女英雄传》第31回"},"similar":["敲山震虎"],"usage":"作谓语、定语；指间接警告对方"},{"id":23217,"word":"敲山震虎","pinyin":"qiāo shān zhèn hǔ","abbr":"qszh","explanation":"指故意示警，使人震动。同“敲山振虎”。","source":{"text":"不怕你敲山震虎，等你打过枪以后，你放心大胆往前走，老子才捧你哩！","book":"刘流《烈火金钢》第12回"},"example":{"text":"她这样做为的是～。"},"similar":["杀鸡警猴"],"usage":"作谓语、定语；指间接警告对方"},{"id":23218,"word":"敲敲打打","pinyin":"qiāo qiāo dǎ dǎ","abbr":"qqdd","explanation":"比喻用言语刺激人。","source":{"text":"如果不是开发，我们生产汽车还会像过去一样用锤子敲敲打打，现在大不相同了，这是质的变化。","book":"邓小平《视察上海时的谈话》"},"example":{"text":"这种人需要别人经常～。"},"similar":["敲打敲打"],"usage":"作谓语、宾语；指用言语刺激人"},{"id":23219,"word":"敲榨勒索","pinyin":"qiāo zhà lè suǒ","abbr":"qzls","explanation":"依仗权势或抓住别人的把柄，用威胁手段逼取财物","source":{"text":"这是大明大白的敲榨勒索，逼人上吊，把穷人往死路上推。","book":"陈登科《赤龙与丹凤》第一部"},"similar":["敲诈勒索"],"usage":"作谓语、定语；指用威胁手段逼取财物"},{"id":23220,"word":"敲牛宰马","pinyin":"qiāo niú zǎi mǎ","abbr":"qnzm","explanation":"敲：指杀。指宰杀家畜牲口。","source":{"text":"俺这里敲牛宰马，做个庆喜的筵席。","book":"元·无名氏《黄花峪》第二折"},"example":{"text":"俺如今～将苍天告，则愿的共死同生未为老。","book":"明·无名氏《桃园结义》第三折"},"similar":["杀猪宰羊"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":23221,"word":"敲竹杠","pinyin":"qiāo zhū gàng","abbr":"qzg","explanation":"比喻利用别人的弱点或以某种口实为借口来索取财物。","source":{"text":"兄弟敲竹杠，也算会敲的了，难道这里头还有竹杠不成？","book":"清·李宝嘉《官场现形记》第17回"},"example":{"text":"《木刻纪程》是用原木版印的，因为版面不平，被印刷厂大～，上当不浅。","book":"鲁迅《书信集·致郑振铎》"},"similar":["敲诈勒索"],"opposite":["拾金不昧"],"usage":"作谓语、宾语；指勒索"},{"id":23222,"word":"敲脂吸髓","pinyin":"qiāo zhī xī suǐ","abbr":"qzxs","explanation":"脂：油脂。比喻剥削压迫极其残酷。","source":{"text":"便可饶了那些助饷的百姓，偏要献勤解到金营，敲脂吸髓，竭尽无余。","book":"清·陈忱《水浒后传》第24回"},"similar":["敲骨吸髓","敲膏吸髓"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":23223,"word":"敲膏吸髓","pinyin":"qiāo gāo xī suǐ","abbr":"qgxs","explanation":"犹敲骨吸髓。比喻剥削压榨极其残酷。","source":{"text":"其取之于民间，前时不过什二，今则几至于敲膏吸髓，取之尽锱铢，用之如泥沙。","book":"清·王韬《西人重日轻华》"},"similar":["敲骨吸髓","敲骨剥髓"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":23224,"word":"敲诈勒索","pinyin":"qiāo zhà lè suǒ","abbr":"qzls","explanation":"依仗势力或抓住把柄进行恐吓，用威胁手段索取财物。","source":{"text":"专门纠察库仑比的淘金工人和山林工人，为非作歹，敲诈勒索，无恶不作。","book":"曲波《林海雪原》"},"example":{"text":"专会苛刻穷人，～，淫人妻女。","book":"姚雪垠《李自成》"},"similar":["巧取豪夺","仗势欺人","敲榨勒索"],"opposite":["拾金不昧"],"usage":"作谓语、定语；指用威胁手段逼取财物"},{"id":23225,"word":"敲边鼓","pinyin":"qiāo biān gǔ","abbr":"qbg","explanation":"比喻从旁帮腔、撺掇或助势。","source":{"text":"这话须得你老哥自己去找他，我们旁人只能敲敲边鼓。","book":"清·李宝嘉《官场现形记》第34回"},"example":{"text":"每天又有帮闲的～，给人们听惯了，就不但做得出，而且也行得通。","book":"鲁迅《伪自由书·文章与题目》"},"similar":["打边鼓"],"usage":"作谓语、宾语；比喻从旁帮腔或助势"},{"id":23226,"word":"敲金击玉","pinyin":"qiāo jīn jī yù","abbr":"qjjy","explanation":"敲钟击磬。喻诗文声调铿锵动听。","source":{"text":"展嘲风咏月长才思，吐敲金击玉款言词。","book":"元·汪元亨《醉太平·警世》曲"},"example":{"text":"说的是～叙家风；唱的是风花雪月梨园乐。","book":"明·施耐庵《水浒传》第八十三回"},"similar":["敲金击石","敲金戛玉"],"usage":"作宾语、定语；用于声音等"},{"id":23227,"word":"敲金击石","pinyin":"qiāo jīn jī shí","abbr":"qjjs","explanation":"金、石：指钟磬一类的乐器。演奏钟磬等乐器。也形容声音铿锵。","source":{"text":"阁下凭几而听之，未必不如听吹竹弹丝、敲金击石也。","book":"唐·韩愈《代张籍与李浙东书》"},"similar":["敲金击玉"],"usage":"作谓语、宾语、定语；用于诗文、声音等"},{"id":23228,"word":"敲金戛玉","pinyin":"qiāo jīn jiá yù","abbr":"qjjy","explanation":"指演奏钟磬等乐器。也形容声音铿锵。同“敲金击石”。","source":{"text":"敲金戛玉之间，忽与瓦缶竞，白璧微瑕，固是恨事。","book":"清·陈廷焯《白雨斋词话》第五卷"},"example":{"text":"清·李百川《绿野仙踪》第三回：“见头场七篇，～，句句皆盛世元音。”"},"similar":["敲金击玉"],"usage":"作宾语、定语；用于声音等"},{"id":23229,"word":"敲锣打鼓","pinyin":"qiāo luó dǎ gǔ","abbr":"qldg","explanation":"①指欢庆祝贺。②形容大造声势，大肆进行舆论宣扬。","source":{"text":"我们取得那么大的胜利，人家服服贴贴，敲锣打鼓。","book":"毛泽东《做革命的促进派》"},"example":{"text":"当年刚刚问世的时候，～，闹得沸沸扬扬。","book":"秦牧《艺海拾贝·惠能和尚的偈语》"},"similar":["锣鼓喧天"],"usage":"作谓语、定语；用于欢庆的场面"},{"id":23230,"word":"敲锣放炮","pinyin":"qiāo luó fàng pào","abbr":"qlfp","explanation":"指大张旗鼓地活动。","source":{"text":"还不是他用狗头军师自作主张自讨好、敲锣放炮的硬出头！","book":"洪深《香稻米》第三幕"},"example":{"text":"他们～，把气氛推向高潮。"},"similar":["敲锣打鼓"],"usage":"作谓语、宾语；指造势"},{"id":23231,"word":"敲锣放砲","pinyin":"qiāo luó fàng pào","abbr":"qlfp","explanation":"指大张旗鼓地活动。","source":{"text":"老实说，外国人会自己下乡来和我们作对么！还不是他用狗头军师自作主张自讨好、敲锣放砲的硬出头！","book":"洪深《香稻米》第三幕"}},{"id":23232,"word":"敲门砖","pinyin":"qiāo mén zhuān","abbr":"qmz","explanation":"敲门的砖石，门敲开后就被抛弃。比喻骗取名利的初步的工具。","source":{"text":"一日，冲元自窗外往来，东坡问：‘何为？’冲元曰：‘绥来。’东坡曰：‘可谓奉大福以来绥。’盖冲元登科时赋句也。冲元曰：‘敲门瓦砾，公尚记忆耶！’","book":"宋·曾敏行《独醒杂志》卷五"},"example":{"text":"其未得第也，则名之曰撞太岁，其既得第也，则号之曰～。","book":"明·田艺蘅《留青日札摘抄·非文事》"},"similar":["垫脚石"],"usage":"作宾语；比喻借以谋取名利的工具","story":["古代科举考试，往往要考八股文，应考的人把八股文的套路练熟，以便在考场上应用。如果没考中，就说“撞太岁”，冒险撞运气；如果考中了，就把八股文的那一套程式称之“敲门砖”，进了门完全可以扔掉敲门的砖头"]},{"id":23233,"word":"敲骨剥髓","pinyin":"qiāo gǔ bāo suǐ","abbr":"qgbs","explanation":"犹敲骨吸髓。比喻剥削压榨极其残酷。","source":{"text":"昔人求道，敲骨吸髓，刺血济饥。","book":"宋·释普济《五灯会元》卷一"},"example":{"text":"假天子之命令，～，尽民之力肥润私家，陷君不义，忍心丧节，如令兄者。","book":"明·许仲琳《封神演义》第二十九回"},"similar":["敲骨吸髓","敲骨榨髓"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":23234,"word":"敲骨取髓","pinyin":"qiāo gǔ qǔ suǐ","abbr":"qgqs","explanation":"敲碎骨头，取出骨髓。①禅宗用语，意指为了求道而不惜自残身体。②比喻残酷地剥削。亦作“敲骨吸髓”、“刮骨吸髓”、“敲脂吸髓”、“槌骨沥髓”、“吸髓吮脂”","source":{"text":"古人求法，敲骨取髓，刺血图像，布发淹泥，投崖饲虎。","book":"《祖堂集·达摩和尚》"},"example":{"text":"先照后用有人在，先用后照有法在，照用同时，驱耕夫之牛，夺饥人之食，～，痛下针锥。","book":"宋·释普济《五灯会元》卷十一"}},{"id":23235,"word":"敲骨吸髓","pinyin":"qiāo gǔ xī suǐ","abbr":"qgxs","explanation":"敲碎骨头来吸骨髓。比喻剥削压榨极其残酷。","source":{"text":"昔人求道，敲骨吸髓，刺血济饥。","book":"宋·释道原《景德传灯录·第二十八祖菩提达摩》"},"example":{"text":"向来暴敛横征之吏，所谓～者，至此而亦无骨可敲无髓可吸矣。","book":"清·冯桂芬《请减苏松太浮粮疏》"},"similar":["刮骨吸髓","巧取豪夺"],"opposite":["乐善好施"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":23236,"word":"敲骨榨髓","pinyin":"qiāo gǔ zhà suǐ","abbr":"qgzs","explanation":"犹敲骨吸髓。比喻剥削压榨极其残酷。","source":{"text":"一个资本主义原始积累敲骨榨髓，受尽欺凌的阿琦婆。","book":"柯岩《天涯何处无芳草》"},"similar":["敲骨吸髓"],"usage":"作谓语、定语、状语；指残酷剥削"},{"id":23237,"word":"敲髓洒膏","pinyin":"qiāo suǐ sǎ gāo","abbr":"qssg","explanation":"比喻倾家荡产。","source":{"text":"其最为民害者，一曰吏，一曰役，一曰官之亲属，一曰官之仆隶，是四种人……怙势作威，足使人敲髓洒膏，吞声泣血。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录六》"},"similar":["倾家荡产"],"usage":"作谓语、定语；比喻倾家荡产"},{"id":23238,"word":"整军经武","pinyin":"zhěng jūn jīng wǔ","abbr":"zjjw","explanation":"经：治理。整顿军队，经营武备。","source":{"text":"见可而进，知难而退，军之善政也；兼弱攻昧，武之善经也。子姑整军而经武乎。","book":"《左传·宣公十二年》"},"example":{"text":"一旦国家无内顾之忧，陛下可以～，对东虏大张挞伐，以雪今日之耻，永绝边境之患。","book":"姚雪垠《李自成》第一卷第三章"},"similar":["整军饬武"],"usage":"作谓语、定语；用于军事"},{"id":23239,"word":"整军饬武","pinyin":"zhěng jūn chì wǔ","abbr":"zjcw","explanation":"整顿军队，治理武备","source":{"text":"清廷鉴于甲午之败，认为非整军饬武，不足以图存，乃于光绪乙未（1895年），命温台处道袁世凯督练新军。","book":"章裕昆《武昌首义纪实》"},"similar":["整军经武"],"usage":"作谓语、定语；用于军事"},{"id":23240,"word":"整冠纳履","pinyin":"zhěng guàn nà lǚ","abbr":"zgnl","explanation":"比喻易招惹嫌疑的行动。","source":{"text":"君子防未然，不处嫌疑间，瓜田不纳履，李下不正冠。","book":"语本《乐府诗集·相和歌辞七·君子行》"},"example":{"text":"此所谓蹊田夺牛，岂得谓无过！而～，当避嫌疑者也。","book":"《续资治通鉴·宋仁宗嘉祐四年》"},"usage":"作宾语、定语；用于书面语"},{"id":23241,"word":"整年累月","pinyin":"zhěng nián lèi yuè","abbr":"znly","explanation":"一年又一年，一月又一月。形容时间长久。","source":{"text":"他们不能眼看着孩子整年累月受病的折磨，也不能让自己的同志为了这样的事苦恼，得好好想想办法。","book":"贺宜《天竺葵和制鞋工人的女儿》"},"example":{"text":"他～与小朋友打交道。"},"similar":["长年累月"],"usage":"作状语；泛指长时期"},{"id":23242,"word":"整整截截","pinyin":"zhěng zhěng jié jié","abbr":"zzjj","explanation":"形容端庄严肃。","source":{"text":"入其门，升其堂，整整截截，动有条理。","book":"宋·曾敏行《独醒杂志》卷八"},"usage":"作定语、状语；用于书面语"},{"id":23243,"word":"整整齐齐","pinyin":"zhěng zhěng qí qí","abbr":"zzqq","explanation":"保持整洁和有条不紊。","source":{"text":"长老选了吉日良时，教鸣钟击鼓，就法堂内会集大众，整整齐齐，五六百僧人，尽披袈裟，都到法座下合掌作礼，分作两班。","book":"明·施耐庵《水浒传》第四回"},"example":{"text":"请把座位排得～。"},"similar":["有条不紊"],"opposite":["杂乱无章","参差不齐"],"usage":"作谓语、定语、状语；指有条理"},{"id":23244,"word":"整旅厉卒","pinyin":"zhěng lǚ lì zú","abbr":"zllz","explanation":"整训军队，激励士卒。","source":{"text":"周文帝军出函谷，景与高昂议整旅厉卒，以待其至。","book":"《北齐书·莫多娄贷文传》"},"usage":"作谓语、定语；用于军事等"},{"id":23245,"word":"整旧如新","pinyin":"zhěng jiù rú xīn","abbr":"zjrx","explanation":"修整陈旧的、破损的东西，使之如同新的一样。","source":{"text":"行者却将芝草把十三层塔层层扫过……这才是整旧如新，霞光万道，瑞气千条，依然八方共睹，四国同瞻。","book":"明·吴承恩《西游记》第六十三回"},"usage":"作谓语、宾语；用于处事"},{"id":23246,"word":"整本大套","pinyin":"zhěng běn dà tào","abbr":"zbdt","explanation":"指有计划、有条理、全面。","source":{"text":"中国的老事儿有许多是合乎科学原理的，不过是没有整本大套的以科学始，以科学终而已。","book":"老舍《赵子曰》第十七：“如今叫我整本大套的去和女怪交际，你想想，端翁，我老赵受得了受不了？！”又《文博士》三"},"usage":"作定语、状语；用于书面语"},{"id":23247,"word":"整瓶不摇半瓶摇","pinyin":"zhěng píng bù yáo bàn píng yáo","abbr":"zpbybpy","explanation":"比喻真正有学问的人很谦虚，知识浅薄的人才自以为了不起。","source":{"text":"刚才俺同那些生童讲话，倒不见他有甚通文，谁知酒保倒通起文来，真是‘整瓶不摇半瓶摇’！","book":"清·李汝珍《镜花缘》第二十三回"}},{"id":23248,"word":"整甲缮兵","pinyin":"zhěng jiǎ shàn bīng","abbr":"zjsb","explanation":"整顿甲胄，修理兵器。谓作好战备。","source":{"text":"斥候之郊，非耕牧之所；转战之地，非耕桑之邑。故坚壁清野，以俟其来，整甲缮兵，以乘其敝。虽时有古今，保民全境，不出此途。","book":"《宋书·何承天传》"},"usage":"作谓语、定语、宾语；用于比喻句"},{"id":23249,"word":"整篓洒油，满地拣芝麻","pinyin":"zhěng lǒu sǎ yóu，mǎn dì jiǎn zhī má","abbr":"zlsymdjzm","explanation":"篓：竹篓子。形容不看大处，却只注重小利。","source":{"text":"你真是‘整篓洒油，满地拣芝麻’，大处不算小处算咧！一个篓能值几何？一分家私省了，岂不乐吗！","book":"清·石玉昆《三侠五义》第二回"}},{"id":23250,"word":"整纷剔蠹","pinyin":"zhěng fēn tī dù","abbr":"zftd","explanation":"谓整治纷乱，清除弊害。","source":{"text":"德枢请往抚字之，授辽兴军节度使。下车整纷剔蠹，恩煦信孚，劝农桑，兴教化，期月民获苏息。","book":"元·脱脱《辽史·韩德枢传》"},"usage":"作谓语、定语；用于书面语"},{"id":23251,"word":"整衣危坐","pinyin":"zhěng yī wēi zuò","abbr":"zywz","explanation":"危坐：端正地坐着。整理服装仪容，端正地坐着。形容严肃或拘谨的样子。","source":{"text":"周文乃起，整衣危坐，不觉膝之前席。","book":"《史记·日者列传》：“宋忠、贾谊瞿然而悟，猎缨正襟危坐。”《北史·苏绰传》"},"example":{"text":"他～的样子让人发笑"},"similar":["整襟危坐","正襟危坐"],"usage":"作谓语、定语、状语；形容恭敬严肃地坐着"},{"id":23252,"word":"整衣敛容","pinyin":"zhěng yī liǎn róng","abbr":"zylr","explanation":"整理衣裳，端正仪容。","source":{"text":"沉吟放拨插弦中，整顿衣裳起敛容。","book":"语出唐·白居易《琵琶行》"},"example":{"text":"提刑王某之弟妇得疾，为物冯焉，斥王君姓名，呼骂不绝口……良久，～如平时。","book":"宋·洪迈《夷坚丁志·孙士道》"},"usage":"作谓语、定语；用于书面语"},{"id":23253,"word":"整装待发","pinyin":"zhěng zhuāng dài fā","abbr":"zzdf","explanation":"整理好行装，等待出发。","source":{"text":"但是浙江公民代表请愿团还未启程北上，上海方面北军第四师整装待发的消息已传到浙江来。","book":"陶菊隐《北洋军阀统治时期史话》第23章"},"example":{"text":"我们已经～，向五指山主峰挺进。"},"usage":"作谓语、定语；指做好充分准备"},{"id":23254,"word":"整襟危坐","pinyin":"zhěng jīn wēi zuò","abbr":"zjwz","explanation":"整衣端坐。形容严肃拘谨。","source":{"text":"道传少庄重，稍长读河南程氏书，玩索义理，至忘寝食，虽处暗室，整襟危坐，肃如也。","book":"元·脱脱 《宋史·儒林传六·李道传》"},"similar":["正襟危坐","正襟安坐"],"usage":"作谓语、定语、状语；形容恭敬严肃地坐着"},{"id":23255,"word":"整躬率物","pinyin":"zhěng gōng shuài wù","abbr":"zgsw","explanation":"整饬自身做出榜样，以为下属示范。","source":{"text":"为此拿定了主意，想把这些做官的先陶熔到一个程度，好等他们出去，整躬率物，出身加民。","book":"清·李宝嘉《官场现形记》第六十回"},"similar":["以身作则","正身率下"],"usage":"作谓语、定语；用于处事"},{"id":23256,"word":"整顿乾坤","pinyin":"zhěng dùn qián kūn","abbr":"zdqk","explanation":"乾、坤：八卦中的两个卦名，指天和地。指整顿混乱局面，使天下恢复应有的秩序，社会趋于安定。","source":{"text":"心如金石气如虹，整顿乾坤指顾中。","book":"宋·汪藻《退老堂》诗之一"},"example":{"text":"宋·汪藻《退老堂》诗：“心如金石气如虹，～指顾中。”"},"usage":"作谓语、宾语；用于书面语"},{"id":23257,"word":"整顿干坤","pinyin":"zhěng dùn gàn kūn","abbr":"zdgk","explanation":"乾坤：卦名，象征天地，阴阳等。治理国家，使混乱的局面变得有秩序。"},{"id":23258,"word":"整齐划一","pinyin":"zhěng qí huà yī","abbr":"zqhy","explanation":"有秩序，协调一致。","source":{"text":"纪律方面，提高到整齐划一令行禁止的程度，消灭自由和散漫的现象。","book":"毛泽东《抗日游击战争的战略问题》"},"similar":["整整齐齐"],"opposite":["杂乱无章"],"usage":"作谓语、定语、状语；用于秩序等"},{"id":23259,"word":"整齐画一","pinyin":"zhěng qí huà yī","abbr":"zqhy","explanation":"画一：一致。形容有秩序，不凌乱。","example":{"text":"因为是悬了赏，财帛动人心，堂下不约而同地嗷然应声，～，如打了个暴雷似地。（高阳《草莽英雄》第四章）"}},{"id":23260,"word":"敷张扬厉","pinyin":"fū zhāng yáng lì","abbr":"fzyl","explanation":"敷：通“铺”；敷张：铺陈渲染；扬厉：发扬光大。形容过分讲究排场。","source":{"text":"文之敷张而扬厉者赋之变体。","book":"清·章学诚《文史通义·诗教》"},"usage":"作谓语、定语；用于处事"},{"id":23261,"word":"敷衍了事","pinyin":"fū yǎn liǎo shì","abbr":"fyls","explanation":"敷衍：做事不认真；了：完。指办事马马虎虎，只求应付过去就算完事。","source":{"text":"也有先作揖，后磕头的，也有磕起头来，再作一个揖的。礼生见他们参差不齐，也只好由他们敷衍了事。","book":"清·李宝嘉《官场现形记》第一回"},"example":{"text":"我们办事要认真负责，不应采取～的态度。"},"similar":["敷衍塞责"],"opposite":["尽心竭力"],"usage":"作谓语、状语、定语；指办事不认真"},{"id":23262,"word":"敷衍塞责","pinyin":"fū yǎn sè zé","abbr":"fysz","explanation":"敷衍：马虎，不认真，表面上应付；塞责：搪塞责任。指工作不认真负责，表面应付了事。","source":{"text":"委员共知其事体之难，始克竣事，半属敷衍塞责。","book":"清·张集馨《道咸宦海见闻录》"},"example":{"text":"官僚主义的表现，一种是不理不睬或～的怠工现象。","book":"毛泽东《必须注意经济工作》"},"similar":["敷衍了事"],"opposite":["尽心竭力"],"usage":"作谓语、宾语、定语；指人办事不认真"},{"id":23263,"word":"敷衍搪塞","pinyin":"fū yǎn táng sè","abbr":"fyts","explanation":"做事马马虎虎应付一下，塞责了事。","source":{"text":"抄上几十联，也可以敷衍搪塞。","book":"《文明小史》第十一回"},"example":{"text":"蔡东藩《民国通俗演义》第71回：“都是一班负恩忘义的人物，还要把这等电文～，真是令人气极了。”"},"similar":["敷衍塞责"],"usage":"作谓语、宾语、定语；指人办事不认真"},{"id":23264,"word":"敷衍门面","pinyin":"fū yǎn mén miàn","abbr":"fymm","explanation":"敷衍：将就应付。只做表面的应付，而不认真解决实际问题。","source":{"text":"就将这正经拳法收起不传，只用些外面光、不管事的拳法敷衍门面而已。","book":"清·刘鹗《老残游记》第七回"},"example":{"text":"这样～的做法让人气愤。"},"similar":["敷衍了事"],"usage":"作谓语、宾语、定语；用于不负责任"},{"id":23265,"word":"文不加点","pinyin":"wén bù jiā diǎn","abbr":"wbjd","explanation":"点：涂上一点，表示删去。文章一气呵成，无须修改。形容文思敏捷，写作技巧纯熟。","source":{"text":"衡因为赋，笔不停辍，文不加点。","book":"汉·祢衡《鹦鹉赋序》"},"example":{"text":"援笔一挥，～。","book":"明·洪楩《清平山堂话本·夔关姚卞吊诸葛》"},"similar":["一气呵成"],"usage":"作谓语、宾语；指作文一气呵成"},{"id":23266,"word":"文不对题","pinyin":"wén bù duì tí","abbr":"wbdt","explanation":"文章里的意思跟题目对不上。指人说话或写文章不能针对主题。","source":{"text":"所以太炎先生的第三道策，其实是文不对题的。","book":"鲁迅《且介亭杂文二集·名人和名言》"},"example":{"text":"她睡梦中常说英语——有时～的使人发笑。","book":"冰心《我的学生》"},"similar":["离题万里","答非所问"],"opposite":["探骊得珠"],"usage":"作谓语、定语、状语；指人说话或写文章"},{"id":23267,"word":"文不尽意","pinyin":"wén bù jìn yì","abbr":"wbjy","explanation":"文章未能完全表达出心意。","source":{"text":"圆光如日，有炎如烟，周绕我体，如同金刚，文不尽意，犹待诀言。","book":"宋·张君房《云笈七签》卷四十三"},"usage":"作谓语、定语；用于作文等"},{"id":23268,"word":"文业砚田","pinyin":"wén yè yàn tián","abbr":"wyyt","explanation":"砚田：旧时读书人依文墨为生计，因将砚台比作田地。旧指以文墨为生的读书人。","source":{"text":"以文为业砚为田。","book":"宋·苏轼《次韵孔毅甫久旱已而甚雨》：“我生无田食破砚，尔来砚枯磨不出。”宋·戴复古《寄王溪林逢吉》"}},{"id":23269,"word":"文东武西","pinyin":"wén dōng wǔ xī","abbr":"wdwx","explanation":"本指汉初叔孙通所定的朝仪，文官位东，武将居西。指文武官员的排列位次。","source":{"text":"功臣列侯诸将军军吏以次陈西方，东乡；文官丞相以下陈东方，西乡。","book":"《史记·刘敬叔孙通列传》"},"example":{"text":"《南齐书·邱巨源传》：“仰观天纬，则右将而左相，俯察人序，则～。”"},"usage":"作宾语、定语；用于书面语"},{"id":23270,"word":"文丝不动","pinyin":"wén sī bù dòng","abbr":"wsbd","explanation":"一点儿也不动。","source":{"text":"路边几棵见了风，最爱噪嘴的小叶杨也那么安生，文丝不动。","book":"杨朔《三千里江山》"},"similar":["文风不动","纹丝不动"],"usage":"作谓语、定语；形容稳固"},{"id":23271,"word":"文人墨士","pinyin":"wén rén mò shì","abbr":"wrms","explanation":"泛指文人、文士。","source":{"text":"那知百花仙子忽然命他把那泣红亭的碑记付给文人墨士去做稗官野史；他捧了这碑记日日寻访，何能凑巧？","book":"清·李汝珍《镜花缘》第一百回"},"example":{"text":"一来使情人见了，也好当面招魂，二来使～闻之，也好做几首诗文，留个不朽！","book":"清·李渔《比目鱼》第七回"},"similar":["文人墨客"],"usage":"作主语、宾语、定语；指文人"},{"id":23272,"word":"文人墨客","pinyin":"wén rén mò kè","abbr":"wrmk","explanation":"泛指文人、文士。","source":{"text":"而那些封建旧文化培养出来的文人墨客、风流雅士，置国事于不问，整天吃花酒，作艳诗。","book":"清·韩邦庆《海上花列传》"},"example":{"text":"～大概是感性太锐敏了之故罢，向来就很娇气，什么也给他说不得，见不得，听不得，想不得。","book":"《鲁迅全集·坟》"},"similar":["文人墨士","骚人墨客"],"usage":"作主语、宾语、定语；指文人"},{"id":23273,"word":"文人学士","pinyin":"wén rén xué shì","abbr":"wrxs","explanation":"泛指文人、文士。","source":{"text":"昔之文人学士，平生精力，咸萃兹途。","book":"明·胡应麟《诗薮·遗逸中》"},"example":{"text":"鲁迅《书信集·致黎烈文》：“除《铸剑》外，都不免油滑，然而有些～，却又不免头痛。”"},"similar":["文人墨士","文人墨客"],"usage":"作主语、宾语、定语；指文人"},{"id":23274,"word":"文人无行","pinyin":"wén rén wú xíng","abbr":"wrwx","explanation":"喜欢玩弄文字的人，品行常常不端正。","source":{"text":"文人无行，信乎？","book":"明·胡应麟《少室山房笔丛》"},"example":{"text":"我们必须把‘～’这句丑话刷洗干净，连一点痕迹也不留。","book":"老舍《反对文人无行》"},"usage":"作谓语；指文人作风"},{"id":23275,"word":"文人相轻","pinyin":"wén rén xiāng qīng","abbr":"wrxq","explanation":"轻：轻视。指文人之间互相看不起。","source":{"text":"文人相轻，自古而然。","book":"三国·魏·曹丕《典论·论文》"},"example":{"text":"虽文人相轻，自古而然，而谓三公必传，可与松雪、恩翁争席者，则吾未敢信也。","book":"清·钱泳《履园丛话·书学·总论》"},"usage":"作主语、宾语、定语；指文人之间互相看不起","story":["北宋时期，张耒做一首诗送给苏东坡过目，苏东坡笑他：“天边赵盾益可畏，水府右军方熟眠。这是热汤清炖王羲之。”张耒心中不服，也指出苏东坡的诗中人名用得不当，苏则要他去找曹操理论。这正是曹丕《典论》：“文人相轻，自古而然。”"]},{"id":23276,"word":"文人雅士","pinyin":"wén rén yǎ shì","abbr":"wrys","explanation":"有学问和处事修养的孤高的人。","example":{"text":"他可算作～了。"},"similar":["文人学士"],"usage":"作宾语、定语；指文人"},{"id":23277,"word":"文从字顺","pinyin":"wén cóng zì shùn","abbr":"wczs","explanation":"唐·韩愈《南阳樊绍述墓志铭》：“文从字顺各识职，有欲求之此其躅。”","source":{"text":"这贾家呢，第二个儿子今年廿四岁，在家读书，人也长得清清秀秀的，笔下也还～。 ★清·刘鹗《老残游记》第十五回"},"example":{"text":"鲁迅《书信集·致姚克》：“词、曲之始，也都～，并不艰难。”"},"similar":["不蔓不枝","顺理成章"],"opposite":["狗屁不通"],"usage":"作谓语、定语；指文章用词妥贴通顺"},{"id":23278,"word":"文以载道","pinyin":"wén yǐ zài dào","abbr":"wyzd","explanation":"载：装载，引伸为阐明；道：道理，泛指思想。指文章是为了说明道理的。","source":{"text":"文所以载道也。轮辕饰而人弗庸，徒饰也，况虚车乎。","book":"宋·周敦颐《通书·文辞》"},"example":{"text":"古人说“～”，用现在的话说，写文章就是表达思想。","book":"郭沫若《关于文风问题答〈新观察〉记者问》"},"usage":"作谓语；指用文章来说明道理"},{"id":23279,"word":"文似其人","pinyin":"wén sì qí rén","abbr":"wsqr","explanation":"文章的风格与作者本人相似。","source":{"text":"文似其人，数公道德文章之蕴，亦自有充积流露者。","book":"清·薛福成《庸庵笔记·史料·谈相》"},"similar":["文如其人"],"usage":"作谓语、定语、宾语；用于写作等"},{"id":23280,"word":"文修武偃","pinyin":"wén xiū wǔ yǎn","abbr":"wxwy","explanation":"礼乐教化大行而武力征伐偃息。指天下太平。","source":{"text":"我皇仁洽道丰，文修武偃，要荒毕服。","book":"唐·王起《鼋鼌为梁赋》"},"example":{"text":"明·谢谠《四喜记·诗咏花鱼》：“四海安康，边疆安静，～堪悦。”"},"similar":["武偃文修"],"usage":"作宾语、定语；用于书面语"},{"id":23281,"word":"文修武备","pinyin":"wén xiū wǔ bèi","abbr":"wxwb","explanation":"文：指教化。修：指走上正规，已符合标准。备：准备完毕。谓文治和军备都已达到了理想的要求。","source":{"text":"见如今大开学校，文修武备显英豪。","book":"明·无名氏《十样锦》第一折"},"usage":"作宾语、定语；用于书面语"},{"id":23282,"word":"文友诗敌","pinyin":"wén yǒu shī dí","abbr":"wysd","explanation":"敌：对手。文中好友，诗中对手。","source":{"text":"仆与足下二十年来为文友诗敌，幸也，亦不幸也。","book":"唐·白居易《刘白唱和集解》"}},{"id":23283,"word":"文君司马","pinyin":"wén jūn sī mǎ","abbr":"wjsm","explanation":"后指相爱的情人或夫妻。","source":{"text":"《史记·司马相如列传》载：汉代辞赋家司马相如，在宴席上以琴音挑动临邛富商卓王孙寡居的女儿卓文君；文君夜奔相如，与之结为夫妇。卓王孙不认这门亲事，司马相如与卓文君开了个酒馆，文君当炉卖酒，相如穿着犊鼻裤与奴仆一道洗器皿，卓王孙感到耻"},"example":{"text":"明·胡文焕《群音类选·清腔类·石竹花》：“常言道爱他反着他，怎学得～，俏冤家。”"},"usage":"作宾语、定语；指相亲相爱的夫妇或情侣","story":["西汉辞赋家司马相如回到成都老家，邻邛县令王吉邀请他去大财主卓王孙家去做客。他看上了卓王孙的寡妇女儿卓文君，两人私订终身并私奔回到他那家徒四壁的家，他们开了个酒店，文君当炉卖酒，相如亲自做酒，夫妻俩相亲相爱"]},{"id":23284,"word":"文君新寡","pinyin":"wén jūn xīn guǎ","abbr":"wjxg","explanation":"文君：汉朝的卓文君。原指卓文君刚死去丈夫。后泛指妇女死去丈夫不久。","source":{"text":"是时卓王孙有女文君，新寡，好音，故相如缪与令相重，而以琴心挑之。……既罢，相如乃使人重赐文君侍者通殷勤。文君夜亡奔相如，相如乃与驰归成都。","book":"《史记·司马相如列传》"},"example":{"text":"间有倩女离魂，～，亦效颦为之。","book":"明·张岱《陶庵梦忆·烟雨楼》"},"similar":["文君早寡"],"usage":"作宾语；指妇女死去丈夫不久","story":["西汉辞赋家司马相如在梁孝王死后回到成都老家，他的朋友临邛县令王吉邀请他去大财主卓王孙家做客。他看上了卓王孙的寡妇女儿卓文君，两人私订终身并私奔回到他那家徒四壁的家，两人开一家酒店，开始过他们清苦的生活"]},{"id":23285,"word":"文君新醮","pinyin":"wén jūn xīn jiào","abbr":"wjxj","explanation":"醮：旧指女子出嫁，这里指再嫁。原指汉代卓文君嫁司马相如事。后指寡妇再嫁。","source":{"text":"是时卓王孙有女文君，新寡，好音，故相如缪与令相重，而以琴心挑之。……既罢，相如乃使人重赐文君侍者通殷勤。文君夜亡奔相如，相如乃与驰归成都。","book":"《史记·司马相如列传》"},"similar":["文君新寡"],"usage":"作宾语；指妇女再婚","story":["西汉辞赋家司马相如在梁孝王死后回到成都老家，他的朋友临邛县令王吉邀请他去大财主卓王孙家做客。他看上了卓王孙的寡妇女儿卓文君，两人私订终身并私奔回到他那家徒四壁的家，两人开一家酒店，开始过他们清苦的生活"]},{"id":23286,"word":"文君早寡","pinyin":"wén jūn zǎo guǎ","abbr":"wjzg","explanation":"文君：汉临邛富商卓王孙之女卓文君，死了丈夫就与司马相如私奔。指年轻女子丧夫寡居。","source":{"text":"奴家杨氏，幼适裴门，琴断朱弦，不幸文君早寡，香含青琐，肯容韩椽轻偷？","book":"清·洪昇《长生殿·幸恩》"},"similar":["文君新寡"],"usage":"作宾语；指妇女死去丈夫不久","story":["西汉时期，辞赋家司马相如在梁孝王死后回到成都老家，临邛县令王吉邀请他去大财主卓王孙家做客。他看上了卓王孙的寡妇女儿卓文君，两人私订终身并私奔回到他老家，文君当炉卖酒，相如与奴仆一起劳动，卓王孙终于被迫承认他们的婚姻"]},{"id":23287,"word":"文圆质方","pinyin":"wén yuán zhì fāng","abbr":"wyzf","explanation":"指外表随和而内心方正。"},{"id":23288,"word":"文场笔苑","pinyin":"wén chǎng bǐ yuàn","abbr":"wcby","explanation":"苑：荟萃的地方。指文学界。","source":{"text":"文场笔苑，有术有门。务先大体，鉴必穷源。乘一总万，举要治繁。思无定契，理有恒存。","book":"南朝·梁·刘勰《文心雕龙·总术赞》"}},{"id":23289,"word":"文奸济恶","pinyin":"wén jiān jì è","abbr":"wjje","explanation":"掩饰奸诈，助长恶行。","source":{"text":"盖其心术不谨，趋向一差，则要利盗名，文奸济恶，皆学之力也。","book":"金·王若虚《论语辨惑》"},"usage":"作谓语、定语；用于处事"},{"id":23290,"word":"文如其人","pinyin":"wén rú qí rén","abbr":"wrqr","explanation":"指文章的风格同作者的性格特点相似。","source":{"text":"子由之文实胜仆，而世俗不知，乃以为不如；其为人深不愿人知之，其文如其为人。","book":"宋·苏轼《答张文潜书》"},"example":{"text":"古人每爱说“～”，然如像光慈的为人与其文章之相似，在我的经验上，却是很少见的。","book":"郭沫若《革命春秋·创造十年续篇》"},"similar":["文似其人"],"usage":"作谓语、定语、宾语；用于写作等"},{"id":23291,"word":"文如春华","pinyin":"wén rú chūn huá","abbr":"wrch","explanation":"华：同“花”。文章词藻像春天盛开的鲜花争奇斗艳。形容文章词汇丰富华丽。","source":{"text":"强记洽闻，幽赞微言；文若春华，思若涌泉。","book":"三国·魏·曹植《王仲宣诔》"}},{"id":23292,"word":"文婪武嬉","pinyin":"wén lán wǔ xī","abbr":"wlwx","explanation":"指文武官员习于安逸，贪婪成性。","source":{"text":"黄殿、李勇、吴外等，因民弗忍，又窥台吏文婪武嬉，遂谋变也。","book":"清·魏源《圣武记》第八卷"},"usage":"作谓语、定语；用于书面语"},{"id":23293,"word":"文子同升","pinyin":"wén zǐ tóng shēng","abbr":"wzts","explanation":"指家臣奴仆与主人同居官职。","source":{"text":"公叔文子之臣大夫僎与文子同升诸公。子闻之，曰：‘可以为文矣。’","book":"语出《论语·宪问》"},"example":{"text":"清·李渔《奈何天·助边》：“不但家主身荣，连你也有好处，少不得仿前徽，～，与伊行，并事公家。”"},"usage":"作宾语、定语；用于书面语"},{"id":23294,"word":"文子文孙","pinyin":"wén zǐ wén sūn","abbr":"wzws","explanation":"指周文王的子孙。后泛用为称美帝王的子孙。","source":{"text":"《书·立政》：“继自今，文子文孙其勿误于庶狱庶慎，惟正是乂之。”孔传：“文子文孙，文王之子孙。”一说为守文之子孙。见孙星衍疏。"}},{"id":23295,"word":"文字狱","pinyin":"wén zì yù","abbr":"wzy","explanation":"统治者从作者的诗文中摘取字句，罗织罪名而造成的冤狱。","source":{"text":"避席畏闻文字狱，著书都为稻粱谋。","book":"清·龚自珍《咏史》诗"},"example":{"text":"清政府大兴～，害死了很多有识之士。"},"usage":"作主语、宾语、定语；用于社会"},{"id":23296,"word":"文宗学府","pinyin":"wén zōng xué fǔ","abbr":"wzxf","explanation":"文章的宗伯，学问的渊府。比喻学问渊博的人。","source":{"text":"文宗学府。腾斑马而孤上；英规胜范，凌、许、郭而独高。","book":"北魏·杨衒之《洛阳伽蓝记·景明寺》"},"example":{"text":"唐·刘知畿《史通·人物》：“鲍照～，驰名海内。”"},"usage":"作宾语、定语；用于书面语"},{"id":23297,"word":"文山会海","pinyin":"wén shān huì hǎi","abbr":"wshh","explanation":"形容文件会议多得泛滥成灾。","source":{"text":"机关干部解脱了文山会海之后，获得更多时间和精力，该是一件幸事。","book":"《人民日报》1988年11月26日"},"example":{"text":"我们要坚决抵制～。"},"usage":"作宾语、定语；指行政事务太多"},{"id":23298,"word":"文川武乡","pinyin":"wén chuān wǔ xiāng","abbr":"wcwx","explanation":"原指出文臣武将的地区。后指教化普及，风俗纯正的地区。","source":{"text":"梁州唯有文川武乡，廉泉让水。","book":"《南史·胡谐之传》"}},{"id":23299,"word":"文弛武玩","pinyin":"wén chí wǔ wán","abbr":"wcww","explanation":"文武官员玩忽职守。","source":{"text":"成庙暮年，深见承平日久，文弛武玩，禁烟之令稍以操切治之，辄启边衅。","book":"清·夏燮《中西纪事·剿抚异同》"},"usage":"作定语；用于局面等"},{"id":23300,"word":"文弱书生","pinyin":"wén ruò shū shēng","abbr":"wrss","explanation":"文弱：文雅而体弱。举目文雅，身体柔弱的读书人。","source":{"text":"士龙为人，文弱可爱。","book":"南朝·宋·刘义庆《世说新语·赏誉下》"},"opposite":["彪形大汉"],"usage":"作宾语、定语；用于读书人"},{"id":23301,"word":"文彩四溢","pinyin":"wén cǎi sì yì","abbr":"wcsy","explanation":"形容作品典雅。","example":{"text":"我十分喜欢这本妙趣横生、～的小说。"},"similar":["才华横溢"],"usage":"作定语；指作品"},{"id":23302,"word":"文德武功","pinyin":"wén dé wǔ gōng","abbr":"wdwg","explanation":"治理国家恩德昭著，对外用兵成绩斐然。旧时多用为赞誉帝王或重臣的颂词。","source":{"text":"示之以文德，陈之以武功。","book":"唐·杨炯《原州百泉县令李君神道碑》"},"example":{"text":"陛下千年膺运，一国称尊，～，经天纬地。","book":"宋·李昉《太平御览》卷二百四十一引《闻见录》"},"similar":["文治武功"],"usage":"作宾语、定语；用于赞誉帝王或重臣"},{"id":23303,"word":"文思敏捷","pinyin":"wén sī mǐn jié","abbr":"wsmj","explanation":"形容写文章的思路迅速而灵敏。","source":{"text":"扆文思敏速，初无思虑，挥翰如飞，文理俱惬。","book":"《旧唐书·陆扆传》"},"example":{"text":"章秋谷本来～，这几篇“四书”又那里在他心上，提起笔来，一挥而就。","book":"清·张春帆《九尾龟》第一百八十三回"}},{"id":23304,"word":"文思敏速","pinyin":"wén sī mǐn sù","abbr":"wsms","explanation":"形容写文章的思路迅速而灵敏。","source":{"text":"扆文思敏速，初无思虑，挥翰如飞，文理俱惬。","book":"《旧唐书·陆扆传》"},"example":{"text":"亿天性颖悟，于书无所不览，～，不加点窜，对客谈笑，挥毫无废，而精密有规裁。","book":"清·毕沅《续资治通鉴》卷三十五"}},{"id":23305,"word":"文恬武嬉","pinyin":"wén tián wǔ xī","abbr":"wtwx","explanation":"恬：安闲；嬉：玩乐。文官安闲自得，武官游荡玩乐。指官吏只知贪图安逸享受，吃喝玩乐，不关心国事。","source":{"text":"相臣将臣，文恬武嬉，习熟见闻，以为当然。","book":"唐·韩愈《平淮西碑》"},"example":{"text":"今者～，宜若可为安静之计。","book":"宋·陈亮《与章德茂侍郎》二"},"similar":["上恬下嬉","尸位素餐"],"opposite":["文治武功","克己奉公"],"usage":"作谓语、定语；指文官武将安闲自得"},{"id":23306,"word":"文情并茂","pinyin":"wén qíng bìng mào","abbr":"wqbm","explanation":"文章写得不仅富有文采，而且感情也很丰富。","example":{"text":"那封～的信，最让他感动至深的是最后一段。","book":"琼瑶《匆匆，太匆匆》十七"}},{"id":23307,"word":"文房四侯","pinyin":"wén fáng sì hòu","abbr":"wfsh","explanation":"指笔、砚、纸、墨。古人戏称笔为管城侯毛元锐，砚为即墨侯石虚中，纸为好畤侯楮知白，墨为松滋侯易玄光，故称。","source":{"text":"参阅宋·苏易简《文房四谱》引文嵩《四侯传》。"},"example":{"text":"～很少人能数全"},"similar":["文房四宝","文房四士","文房四物"],"usage":"作主语、宾语；指书写工具"},{"id":23308,"word":"文房四士","pinyin":"wén fáng sì shì","abbr":"wfss","explanation":"俗指笔、墨、纸、砚。同“文房四宝”。","source":{"text":"水复山重客到稀，文房四士独相依。","book":"宋·陆游《闲居无客所与度日笔砚纸墨而已戏作长句》诗"},"similar":["文房四宝","文房四侯","文房四物"],"usage":"作主语、宾语；指书写工具"},{"id":23309,"word":"文房四宝","pinyin":"wén fáng sì bǎo","abbr":"wfsb","explanation":"俗指笔、墨、纸、砚。","source":{"text":"文房四宝出二郡，迩来赏玩君与予。","book":"宋·梅尧臣《再和潘歙州纸砚》诗"},"example":{"text":"天子被逼不过，只得命取绝笔。奶子随即取捧过～。","book":"明·施耐庵《水浒全传》第八十一回"},"similar":["文房四士","笔墨纸砚","文房四物"],"usage":"作主语、宾语；指书写工具"},{"id":23310,"word":"文房四物","pinyin":"wén fáng sì wù","abbr":"wfsw","explanation":"俗指笔、墨、纸、砚。同“文房四宝”。","source":{"text":"张、李氏之墨，吴、唐、蜀、闽、两越之纸，端溪、歙穴之砚，鼠须栗尾狸毫兔颖之笔，所谓文房四物，山藏海蓄，极天下之选。","book":"宋·陈师道《〈寇参军集〉序》"},"similar":["文房四宝","文房四士","文房四侯"],"usage":"作主语、宾语、定语；用于书面语"},{"id":23311,"word":"文房四艺","pinyin":"wén fáng sì yì","abbr":"wfsy","explanation":"指琴、棋、书、画。","source":{"text":"自古书、画、琴、棋，谓之文房四艺。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"similar":["琴棋书画"],"usage":"作主语、宾语、定语；用于书面语"},{"id":23312,"word":"文才武略","pinyin":"wén cái wǔ lüè","abbr":"wcwl","explanation":"武略：军事方面的才能。既有文学才能，又有军事才能。形容文武兼备。","example":{"text":"黄岛主博大精深，～，无所不通，无所谓绝技不绝技。","book":"金庸《神雕侠侣》第二十三回"}},{"id":23313,"word":"文抄公","pinyin":"wén chāo gōng","abbr":"wcg","explanation":"指那些剽窃别人作品的人。","example":{"text":"我痛恨那些～的偷窃行为。"},"usage":"作宾语、定语；用于写作等"},{"id":23314,"word":"文搜丁甲","pinyin":"wén sōu dīng jiǎ","abbr":"wsdj","explanation":"文章精妙感动神灵。丁甲，神名，即六丁六甲神。","source":{"text":"诗泣鬼神，宝气腾吴练；文搜丁甲，精芒全烁秦金。","book":"明·陈汝元《金莲记·偕计》"},"usage":"作宾语、定语；用于作文等"},{"id":23315,"word":"文擅雕龙","pinyin":"wén shàn diāo lóng","abbr":"wsdl","explanation":"比喻文章写得极好。","source":{"text":"寘、憕并学称该博，文擅雕龙，或挥翰凤池，或著书麟阁，咸居禄位，各逞琳琅。","book":"《北史·薛憕传论》"},"similar":["文炳雕龙"],"usage":"作宾语、定语；用于书面语"},{"id":23316,"word":"文无加点","pinyin":"wén wú jiā diǎn","abbr":"wwjd","explanation":"形容文思敏捷，写作技巧纯熟。同“文不加点”。","source":{"text":"衡因为赋，笔不停辍，文不加点。","book":"汉·祢衡《鹦鹉赋序》"},"example":{"text":"思道援笔立成，～，神举嘉而宥之。","book":"《隋书·卢思道传》"},"similar":["文不加点"],"usage":"作谓语、宾语；指作文一气呵成"},{"id":23317,"word":"文无定法","pinyin":"wén wú dìng fǎ","abbr":"wwdf","explanation":"写文章没有一定的固定不变的规程。指文章写作方法可以多种多样，不拘一格。"},{"id":23318,"word":"文无点易","pinyin":"wén wú diǎn yì","abbr":"wwdy","explanation":"点：涂改；易：改动。形容作文一气呵成，不加改动。","source":{"text":"时荆州信去倚待，脁执笔便成，文无点易。","book":"《南史·谢脁传》"},"similar":["文无加点","文不加点"],"usage":"作谓语、宾语；指作文一气呵成"},{"id":23319,"word":"文星高照","pinyin":"wén xīng gāo zhào","abbr":"wxgz","explanation":"比喻文运亨通。","source":{"text":"只好偷偷地翻开第一页，看那题着‘文星高照’四个字的恶鬼一般的魁星像。","book":"鲁迅《朝花夕拾·二十四孝图》"},"example":{"text":"邹韬奋《抗战以来》：“这总算是欧阳山先生的～。”"},"usage":"作宾语、定语；用于作文等"},{"id":23320,"word":"文昭武穆","pinyin":"wén zhāo wǔ mù","abbr":"wzwm","explanation":"原指文王的子孙众多，后则泛称子孙繁衍。","source":{"text":"古代宗法制度，宗庙位次，始祖庙居中，以下父子递为昭穆，左为昭，右为穆。祭祀时，子孙也按昭穆，左右排列行礼。周文王于周为穆，文王之子武王则为昭，而武王之子成王又为穆。"},"example":{"text":"其～，跗萼也如彼；天平地成，功业也如此。","book":"南朝·陈·徐陵《劝进梁元帝表》"},"usage":"作宾语、定语；用于书面语"},{"id":23321,"word":"文期酒会","pinyin":"wén qī jiǔ huì","abbr":"wqjh","explanation":"旧时文人定期举行的诗酒集会。","source":{"text":"难忘，文期酒会，几孤风月，屡变星霜。","book":"宋·柳永《玉蝴蝶》"}},{"id":23322,"word":"文武两全","pinyin":"wén wǔ liǎng quán","abbr":"wwlq","explanation":"文：文才；武：武艺。能文能武，文才和武艺都很出众。","source":{"text":"蕴孙、吴之略、有文武之才。","book":"《旧唐书·李光弼传》"},"example":{"text":"这高知府上马管军，下马管民，～。","book":"明·施耐庵《水浒全传》第五十二回"}},{"id":23323,"word":"文武之道","pinyin":"wén wǔ zhī dào","abbr":"wwzd","explanation":"指周文王、周武王治理国家的方法。","source":{"text":"文武之道未坠于地，在人，贤者识其大者。","book":"先秦·孔子《论语·子张》"},"example":{"text":"～，厥猷未坠。","book":"晋·应贞《晋武帝华林园集诗》"},"usage":"作宾语；指宽严相结合治理国家的方法","story":["周朝时期，民间有一个祭祀百神的“蜡”节日，孔子带弟子子贡去看热闹。子贡担心百姓只顾玩乐而会有危险。孔子给子贡解释道：“百姓成年累月在田间劳作，让他们放松一下，有张有驰，这是周文王与武王定下的规矩，这样便于更好地生产。”"]},{"id":23324,"word":"文武之道，一张一弛","pinyin":"wén wǔ zhī dào，yī zhāng yī chí","abbr":"wwzdyzyc","explanation":"文、武：指周文王和周武王。意思是宽严相结合，是文王武王治理国家的方法。现用来比喻生活的松紧和工作的劳逸要合理安排。","source":{"text":"张而不弛，文武弗能也；弛而不张，文武弗为也。一张一弛，文武之道也。","book":"《礼记·杂记下》"},"example":{"text":"古人说：“～。”现在“弛”一下，同志们会清醒起来。","book":"毛泽东《对晋绥日报编辑人员的谈话》"},"usage":"作宾语、分句；用于劝诫人","story":["周朝时期，民间有一个祭祀百神的“蜡”节日，孔子带弟子子贡去看热闹。子贡担心百姓只顾玩乐而会有危险。孔子给子贡解释道：“百姓成年累月在田间劳作，让他们放松一下，有张有驰，这是周文王与武王定下的规矩，这样便于更好地生产。”"]},{"id":23325,"word":"文武全才","pinyin":"wén wǔ quán cái","abbr":"wwqc","explanation":"文才与武功同时具备的人才。","source":{"text":"和公文武全才而有志气，后必享重位，尔宜谨事之。","book":"《旧五代史·和凝传》"},"example":{"text":"那是难得的一位～啦。","book":"郭沫若《孔雀胆》第一幕"},"similar":["文武双全","能文能武"],"opposite":["一无所能","有勇无谋"],"usage":"作谓语、定语、宾语；指能文能武"},{"id":23326,"word":"文武兼全","pinyin":"wén wǔ jiān quán","abbr":"wwjq","explanation":"同时具有文才和武才。指文武双全。","source":{"text":"杨文德志气果到，文武兼全，乘机潜奋，殊功仍集，告捷归诚，献俘万里，朝无暂土，树难自肃，休烈昭著，朕甚嘉焉。","book":"《宋书·氐胡传》"},"example":{"text":"本院向来久闻令师～，朝廷几次差官聘他做官，他只是不肯出来。","book":"清·钱彩《说岳全传》第七回"}},{"id":23327,"word":"文武兼备","pinyin":"wén wǔ jiān bèi","abbr":"wwjb","explanation":"同时具有文才和武才，文武双全。亦作“文武兼济”、“文武兼全”。","source":{"text":"文武兼备，惟所施设。","book":"汉·荀悦《汉纪·宣帝纪》"},"example":{"text":"我们已经做好～的打算。"},"similar":["文武双全","文武兼济"],"usage":"作谓语、定语；指做好谈与打两手准备"},{"id":23328,"word":"文武兼济","pinyin":"wén wǔ jiān jì","abbr":"wwjj","explanation":"同时具有文才和武才。指文武双全。","source":{"text":"世祖即位，每与群臣谈宴，未尝不叹惜殷勤，以为自泰常以来，佐命勋臣文武兼济无及之者，见称如此。","book":"《魏书·穆崇传》"},"example":{"text":"主帅所料极是，此会犹范增鸿门设宴之意，须～的辅从，方保无虞。","book":"明·徐渭《英烈传》第十一回"},"similar":["文武兼备","文武兼资"],"usage":"作谓语、定语；用于处事"},{"id":23329,"word":"文武兼资","pinyin":"wén wǔ jiān zī","abbr":"wwjz","explanation":"资：具备。具有文才和武艺。指人文武全才。","source":{"text":"汉高、宋武虽缺章句，歌大风以还沛，好清淡于暮年，夫成天德之大功，膺乐推之宝运，未或不文武兼资，能事斯毕者也。","book":"南朝·梁·沈约《梁武帝集序》"},"example":{"text":"年兄具王佐之才，～，愚弟素所钦仰，即闯王亦慕名久矣。","book":"姚雪垠《李自成》第二卷第四十四章"},"similar":["文武兼备","文武双全"],"usage":"作谓语、定语；用于人的才能"},{"id":23330,"word":"文武双全","pinyin":"wén wǔ shuāng quán","abbr":"wwsq","explanation":"文：文才；武：武艺。能文能武，文才和武艺都很出众。","source":{"text":"蕴孙、吴之略、有文武之才。","book":"《旧唐书·李光弼传》"},"example":{"text":"此人姓姜，名维，字伯约，天水冀人也；事母至孝，～，智勇足备，真当世之英杰也。","book":"明·罗贯中《三国演义》第九十三回"},"similar":["文武全才","能文能武"],"opposite":["不文不武"],"usage":"作谓语、定语、宾语；指能文能武"},{"id":23331,"word":"文武如雨","pinyin":"wén wǔ rú yǔ","abbr":"wwry","explanation":"形容谋士武将非常多，人才济济。","source":{"text":"当此之时，猛将如云，谋臣如雨，然犹七日不食仅乃得免。","book":"汉·李陵《答苏武书》"}},{"id":23332,"word":"文武差事","pinyin":"wén wǔ chà shì","abbr":"wwcs","explanation":"比喻明劫暗偷。","source":{"text":"倘若瞒着他，走一趟私盐，或是打一趟文武差事，轻则剜眼睛，重则废命。","book":"《冷眼观》第12回"},"usage":"作宾语、定语；用于处事"},{"id":23333,"word":"文武并用","pinyin":"wén wǔ bìng yòng","abbr":"wwby","explanation":"《史记·郦生陆贾列传》：“且汤武逆取而以顺守之，文武并用，长久之术也。”","source":{"text":"自古～，向在中都设学养士，犹未尝废，况今日乎？其仍旧给之。 ★清·毕沅《续资治通鉴》卷一百六十"}},{"id":23334,"word":"文武皇皇","pinyin":"wén wǔ huáng huáng","abbr":"wwhh","explanation":"皇皇：非常显赫的样子。形容文武双全，非常显赫。","source":{"text":"君臣穆穆，指青鸟以来临；文武皇皇，乘白云而至止。","book":"清·孔尚任《桃花扇·人通》"}},{"id":23335,"word":"文江学海","pinyin":"wén jiāng xué hǎi","abbr":"wjxh","explanation":"比喻文章和学问似长江、大海般深广博大。","source":{"text":"文江学海恩济航。","book":"唐·郑愔《柏梁体联句》"},"example":{"text":"崇文院之列三馆，国子监之印群书，虽唐汉之盛，无以加此，故天下之人，始知文有江而学有海。","book":"宋·姚铉《〈唐文粹〉序》"},"usage":"作宾语、定语；多用于比喻句"},{"id":23336,"word":"文治武力","pinyin":"wén zhì wǔ lì","abbr":"wzwl","explanation":"以文治国的盛绩与以武禁暴的伟力。","source":{"text":"文王以文治，武王以武功，去民之灾。","book":"西汉·戴圣《礼记·祭法》"},"example":{"text":"鲁迅《呐喊·一件小事》：“几年来的～，在我早如幼小时候所读过的‘子曰诗云’一般，背不上半句了。”"},"usage":"作宾语、定语；用于书面语"},{"id":23337,"word":"文治武功","pinyin":"Wén zhì wǔ gōng","abbr":"wzwg","explanation":"比喻政治与军事。","source":{"text":"文王以文治，武王以武治，去民之灾，比皆有功烈于民者也。","book":"《礼记·祭法》"},"example":{"text":"唐太宗雄才大略，～都有辉煌的成就。"},"similar":["经国济世","太平盛世"],"opposite":["文恬武嬉","兵荒马乱"],"usage":"作主语、宾语；用于用兵打仗"},{"id":23338,"word":"文深网密","pinyin":"wén shēn wǎng mì","abbr":"wswm","explanation":"用法严刻，法网严密。","source":{"text":"刀笔之吏，寡识水体，断狱能者，名在急刻，文深网密，则共称至公。","book":"唐·陈子昂《谏用刑书》"},"example":{"text":"清·戴名世《李太常案牍序》：“～，使人无所措手足。”"},"usage":"作宾语、定语；用于书面语"},{"id":23339,"word":"文炳雕龙","pinyin":"wén bǐng diāo lóng","abbr":"wbdl","explanation":"炳：形容有文采；雕龙：擅长写文章。文章写得很出色，极富文采。","source":{"text":"炳：形容有文采；雕龙：擅长写文章。文章写得很出色，极富文采。"},"example":{"text":"《魏书·高允传》：“质侔和璧，文炳雕龙，耀姿天邑，衣锦旧邦。”"},"similar":["文炳雕龙"],"usage":"作宾语、定语；用于书面语"},{"id":23340,"word":"文牍主义","pinyin":"wén dú zhǔ yì","abbr":"wdzy","explanation":"一种官僚主义作风。不下基层搞调查而在办公室签发文件，想以此来解决实际问题。","example":{"text":"领导必须下基层了结，否则会犯～的错误。"},"usage":"作主语、宾语、定语；用于书面语"},{"id":23341,"word":"文献之家","pinyin":"wén xiàn zhī jiā","abbr":"wxzj","explanation":"指博学多闻、熟悉典章掌故的人。"},{"id":23342,"word":"文理不通","pinyin":"wén lǐ bù tōng","abbr":"wlbt","explanation":"指文章在词句和内容方面都行不通。","source":{"text":"况此等多不究义，唯攻帖书，文理既不甚通，名第岂可妄与？","book":"《旧五代史·选举志》"},"example":{"text":"很难想象，有的人连写信都～，怎么能准确、简炼、明白地写出科学论文呢？"},"usage":"作谓语、定语；用于文章等"},{"id":23343,"word":"文理俱惬","pinyin":"wén lǐ jù qiè","abbr":"wljq","explanation":"文、理：指文辞表达和思想内容；惬：满足、满意。文章的形式和内容都令人满意。","source":{"text":"扆文思敏速，初无思虑，挥翰如飞，文理俱惬。","book":"《旧唐书·陆扆传》"}},{"id":23344,"word":"文章宗匠","pinyin":"wén zhāng zōng jiàng","abbr":"wzzj","explanation":"为人宗仰的文章巨匠。","source":{"text":"而独称王仁裕、和凝为文章宗匠，以饶著作故。","book":"明·胡应麟《诗薮·五代》"},"similar":["文章宗工","文章巨公"],"usage":"作宾语、定语；指人文才好"},{"id":23345,"word":"文章宗工","pinyin":"wén zhāng zōng gōng","abbr":"wzzg","explanation":"为人所宗的文章高手。","source":{"text":"以先生为文章宗工，景仰已非一日。","book":"《颜氏家藏尺牍·曾处士灿》"},"similar":["文章宗匠","文章巨公"],"usage":"作宾语、定语；指人文才好"},{"id":23346,"word":"文章宿老","pinyin":"wén zhāng sù lǎo","abbr":"wzsl","explanation":"宿：年老的，长期从事的。指擅长文章的大师。","source":{"text":"李峤富才思，然其仕前与王勃、杨盈川接，中与崔融、苏味道齐名，晚诸人没，而为文章宿老，一时学者取法焉。","book":"《新唐书·李峤传》"},"similar":["文章星斗","文章巨公"],"usage":"作宾语、定语；指人文才好"},{"id":23347,"word":"文章山斗","pinyin":"wén zhāng shān dòu","abbr":"wzsd","explanation":"指文章为人所宗仰。","source":{"text":"自愈之没，其言大行，学者仰之如泰山北斗云。","book":"语本《新唐书·韩愈传》"},"example":{"text":"宋·辛弃疾《水龙吟》词：“况有～，对桐阴，满庭清昼。”"},"similar":["文章魁首","文章巨公"],"usage":"作宾语、定语；指人文才好"},{"id":23348,"word":"文章巨公","pinyin":"wén zhāng jù gōng","abbr":"wzjg","explanation":"巨：大。文章大家。形容文才出众。","source":{"text":"马蹄隐耳声隆隆，入门下马气如虹，云是东京才子，文章巨公。","book":"唐·李贺《高轩过》"},"example":{"text":"其他诗亦甚佳，如云：“含风广开闻棋响，度日长廊转柳阴。”颇似～所作，殊不类衲子。","book":"宋·许顗《彦周诗话》"},"similar":["文章钜公","文章魁首"],"usage":"作宾语、定语；指人善于作文"},{"id":23349,"word":"文章憎命","pinyin":"wén zhāng zèng mìng","abbr":"wzzm","explanation":"憎：厌恶。文章厌恶命运好的人。形容有才能的人遭遇不好。","source":{"text":"文章憎命达，魑魅喜人过。","book":"唐·杜甫《天末怀李白》诗"},"example":{"text":"见是如此，不禁气愤填膺，不怪自己错了韵，反骂主司去取不公，叹自己～。","book":"清·李宝嘉《官场现形记》第五十四回"},"usage":"作宾语；指有文才的人遭遇不好"},{"id":23350,"word":"文章憎命达","pinyin":"wén zhāng zēng mìng dá","abbr":"wzzmd","explanation":"憎：恨，厌恶；达：显达。文章厌恶命运好的人。形容有才能的人遭遇不好。","source":{"text":"文章憎命达，魑魅喜人过。","book":"唐·杜甫《天末怀李白》诗"}},{"id":23351,"word":"文章星斗","pinyin":"wén zhāng xīng dòu","abbr":"wzxd","explanation":"是文章之冠首，形容人文章写得漂亮，超群出众。","source":{"text":"元自有，谈天口。初不负，经纶手。更诗书万卷，文章星斗。","book":"元·魏初《满堂红·为双溪丞相寿》词"},"similar":["文章山斗"],"usage":"作宾语、定语；指人文才好"},{"id":23352,"word":"文章盖世","pinyin":"wén zhāng gài shì","abbr":"wzgs","explanation":"盖世：超过世人。指文章好得无与伦比，谁都赶不上。","source":{"text":"韩愈文章盖世，谢安情性风流。","book":"宋·吴曾《能改斋漫录·苏琼善词》"},"example":{"text":"清·褚人获《隋唐演义》第82回：“臣知此人～，学问惊人，诸子百家，无书不览。”"},"usage":"作谓语、定语；用于作文等","story":["宋朝时期，蔡元长路过苏州，太守宴请他，听说苏州官奴老九苏琼善于作词，就让她即席以九字为韵作词。词为：“韩愈文章盖世，谢安性情风流。良辰美景在西楼，敢劝一卮芳酒。记得南宫高选。弟兄争占鳌头。金炉玉殿瑞烟浮，高占甲科第九。”"]},{"id":23353,"word":"文章经济","pinyin":"wén zhāng jīng jì","abbr":"wzjj","explanation":"文章和经世济民之才。","source":{"text":"世兄是锦衣玉衾，无不遂心的，必是文章经济，高出人上。","book":"清·曹雪芹《红楼梦》第115回"},"usage":"作宾语、定语；用于书面语"},{"id":23354,"word":"文章绝唱","pinyin":"wén zhāng jué chàng","abbr":"wzjc","explanation":"绝唱：指文艺创作所达到的空前造诣。形容文艺作品绝妙无比。","source":{"text":"太史公《伯夷传》，苏东坡《赤壁赋》，文章绝唱也。","book":"宋·罗大经《鹤林玉露·伯夷传·赤壁赋》"}},{"id":23355,"word":"文章钜公","pinyin":"wén zhāng jù gōng","abbr":"wzjg","explanation":"文章大家。形容文才出众。同“文章巨公”。"},{"id":23356,"word":"文章魁首","pinyin":"wén zhāng kuí shǒu","abbr":"wzks","explanation":"魁首：为首的，这里指名列第一。形容文章写得最好，文才极高。","source":{"text":"秀才是文章魁首，姐姐是仕女班头；一个通彻三教九流，一个晓尽描鸾刺绣。","book":"元·王实甫《西厢记》第四本第二折"},"example":{"text":"清·李汝珍《镜花缘》第81回：“‘连元’二字，打‘又是一个～’。”"},"similar":["文章巨公","文章山斗"],"usage":"作宾语、定语；指人文才好"},{"id":23357,"word":"文笔流畅","pinyin":"wén bǐ liú chàng","abbr":"wblc","explanation":"文字通顺，读起来不费力。","example":{"text":"他～，文思敏捷。"},"similar":["文思敏捷"],"usage":"作谓语；用于写作"},{"id":23358,"word":"文籍先生","pinyin":"wén jí xiān shēng","abbr":"wjxs","explanation":"称熟悉文献典籍的人。"},{"id":23359,"word":"文籍满腹","pinyin":"wén jí mǎn fù","abbr":"wjmf","explanation":"汉·赵壹《疾邪诗二首》：“文籍中满腹，不如一囊钱。”","source":{"text":"方追始皇之迹，虽复～，何救社庙之墟。 ★《南史·梁本纪下》"}},{"id":23360,"word":"文经武略","pinyin":"wén jīng wǔ lüè","abbr":"wjwl","explanation":"经世的文才和军事谋略。","source":{"text":"伊我祖考之代，任寄已深，入掌禁兵，外司籓政，文经武略，久播朝野。","book":"《隋书·高祖纪》"},"example":{"text":"好把～，换取碧幢红旆，谈笑扫胡尘。","book":"宋·张孝祥《水调歌头》词"},"usage":"作宾语、定语；用于书面语"},{"id":23361,"word":"文经武纬","pinyin":"wén jīng wǔ wěi","abbr":"wjww","explanation":"经、纬：编织物的纵线与横线。指从文武两方面治理国家。","source":{"text":"文经武纬，训徒陟步。","book":"唐·颜真卿《郭公庙碑铭》"},"example":{"text":"两子都有～之才，博古通今之学，同科及第，名重朝廷，俱拜翰林学士之职。","book":"明·冯梦龙《醒世恒言》卷十一"},"similar":["经文纬武"],"usage":"作谓语、定语；指文武兼备"},{"id":23362,"word":"文能附众，武能威敌","pinyin":"wén néng fù zhòng，wǔ néng wēi dí","abbr":"wnfzwnwd","explanation":"文：文德，指政治；武：武功，指军事；附众：使大家亲近；威：威服。旧指在政治上能团结部下，在军事上能威震敌人。","source":{"text":"晏婴乃荐田穰苴曰：‘穰苴虽田氏庶孽,然其人文能附众，武能威敌，愿君试之。’","book":"《史记·司马穰苴列传》"},"example":{"text":"朕每论将帅，须责其挽弓骑马，人未知朕意，必谓古有～，不在弓马之间。","book":"清·毕沅《续资治通鉴》卷一百十九"}},{"id":23363,"word":"文致太平","pinyin":"wén zhì tài píng","abbr":"wztp","explanation":"意思是作文章粉饰太平。","source":{"text":"春秋定、哀之间，文致太平。","book":"《公羊传·定公四年》注"},"example":{"text":"帝亦慕箫韶九成之盛，剬诗缉颂，勇于改为，欲以～。","book":"《清史稿·乐志一》"}},{"id":23364,"word":"文行出处","pinyin":"wén xíng chū chǔ","abbr":"wxcc","explanation":"文：学问；行：品行；出：作官；处：隐居。旧指文人的学问、品行和对待出仕隐退的态度。","source":{"text":"子以四教，文、行、忠、信。","book":"《周易·系辞上》：“君子之道，或出或处。”《论语·述而》"},"example":{"text":"这个法却定的不好！将来读书人既有此一条荣身之路，把那～都看的轻了。","book":"清·吴敬梓《儒林外史》第一回"},"usage":"作宾语、定语；用于书面语"},{"id":23365,"word":"文觌武匿","pinyin":"wén dí wǔ nì","abbr":"wdwn","explanation":"艺文兴而武道隐。指尚文之风大盛。","source":{"text":"武不可觌，文不可匿。","book":"语出《国语·周语中》"}},{"id":23366,"word":"文责自负","pinyin":"wén zé zì fù","abbr":"wzzf","explanation":"作者对其发表的文章所引起的一切问题，承担全部责任。","example":{"text":"女医生兴奋起来，这是一个练手的好机会。但是要分清责任，类似～。","book":"毕淑敏《生生不已》"},"usage":"作宾语、定语；用于作文、出版等"},{"id":23367,"word":"文质彬彬","pinyin":"wén zhì bīn bīn","abbr":"wzbb","explanation":"文：文采；质：实质；彬彬：形容配合适当。原形容人既文雅又朴实，后形容人文雅有礼貌。","source":{"text":"质胜文则野，文胜质则史，文质彬彬，然后君子。","book":"《论语·雍也》"},"example":{"text":"唐敖看那尹玉生得～，极其清秀。","book":"清·李汝珍《镜花缘》第十五回"},"similar":["温文尔雅","彬彬有礼"],"opposite":["野调无腔","出言不逊"],"usage":"作谓语、定语、补语；用于男性"},{"id":23368,"word":"文质斌斌","pinyin":"wén zhì bīn bīn","abbr":"wzbb","explanation":"原形容人既文雅又朴实，后形容人文雅有礼貌。同“文质彬彬”。","source":{"text":"怀珍宗族文质斌斌，自宋至梁，时移三代，或从隐节取高。","book":"《南史·庾杲之刘怀珍等传论》"},"similar":["文质彬彬","彬彬文质"],"opposite":["出言不逊"],"usage":"作谓语、定语；用于男性"},{"id":23369,"word":"文贵天成","pinyin":"wén guì tiān chéng","abbr":"wgtc","explanation":"贵：以某种情况为可贵。指有时写出的文章最自然最好。","source":{"text":"李元宾言文贵天成，强不高也。","book":"宋·钱易《南部新书》丙"},"usage":"作宾语、定语；用于写作等"},{"id":23370,"word":"文身剪发","pinyin":"wén shēn jiǎn fā","abbr":"wsjf","explanation":"常用以指较落后地区的民俗。同“文身断发”。","source":{"text":"夫越亦周室之列封也……文身剪发而后处焉。","book":"《韩诗外传》第八卷"},"example":{"text":"西汉·刘向《说苑·善说》：“越～，范蠡、大夫种出焉。”"},"similar":["文身断发"],"usage":"作宾语、定语；用于书面语"},{"id":23371,"word":"文身断发","pinyin":"wén shēn duàn fā","abbr":"wsdf","explanation":"古代荆楚、南越一带的习俗。身刺花纹，截短头发，以为可避水中蛟龙的伤害。后常用以指较落后地区的民俗。","source":{"text":"大伯端委以治周礼，仲雍嗣之，断发文身，裸以为饰，岂礼也哉。","book":"《左传·哀公七年》"},"similar":["文身剪发","被发文身"],"usage":"作宾语、定语；用于书面语"},{"id":23372,"word":"文身翦发","pinyin":"wén shēn jiǎn fā","abbr":"wsjf","explanation":"常用以指较落后地区的民俗。同“文身断发”。"},{"id":23373,"word":"文轨攸同","pinyin":"wén guǐ yōu tóng","abbr":"wgyt","explanation":"文：文字；轨：车的轨迹；攸：语助词，无义；同：相同。书牍的文字相同，车辙痕迹相同。比喻国家统一。","source":{"text":"方今区宇平壹，文轨攸同，十步之内，必有芳草；四海之中，岂无孝、秀。","book":"《礼记·中庸》：“今天下车同轨，书同文。”《隋书·炀帝纪》"}},{"id":23374,"word":"文过其实","pinyin":"wén guò qí shí","abbr":"wgqs","explanation":"文辞浮夸，不切实际。","source":{"text":"显宗即位，又多短衍以文过其实，遂废于家。","book":"《后汉书·冯衍传下》"},"usage":"作谓语、定语；用于作文等"},{"id":23375,"word":"文过遂非","pinyin":"wén guò suí fēi","abbr":"wgsf","explanation":"掩饰过失，顺随错误。","source":{"text":"而近日之事，乃有文过遂非之风，此臣之所以愤懑太息而不能已也。","book":"宋·苏轼《论时政状》"},"similar":["文过饰非"],"usage":"作谓语、定语、宾语；用于处事"},{"id":23376,"word":"文过饰非","pinyin":"wén guò shì fēi","abbr":"wgsf","explanation":"文、饰：掩饰；过、非：错误。用漂亮的言词掩饰自己的过失和错误。","source":{"text":"岂与夫庸儒末学，文过饰非，使夫问者缄辞社口，怀疑不展，若斯而已哉？","book":"《论语·子张》：“小人之过也必文。”《庄子·盗跖》：“辩足以饰非。”唐·刘知几《史通·惑经》"},"example":{"text":"其实错了就老实自己承认，倒是精神安泰的事情；～是最苦痛的勾当。","book":"邹韬奋《论文、杂感、随笔·硬吞香蕉皮》"},"similar":["讳疾忌医","涂脂抹粉","护过饰非"],"opposite":["欲盖弥彰"],"usage":"作谓语、宾语、定语；指掩饰自己的过失和错"},{"id":23377,"word":"文选烂，秀才半","pinyin":"wén xuǎn làn，xiù cái bàn","abbr":"wxlxcb","explanation":"文选：指《昭明文选》。意思是熟读了《文选》，就可以成为半个秀才。讽刺科举取士的话。现也含有熟读诗文对写作有益之意。","source":{"text":"方其盛时，士子至为之语曰：文选烂，秀才半。","book":"宋·陆游《老学庵笔记》"}},{"id":23378,"word":"文通武达","pinyin":"wén tōng wǔ dá","abbr":"wtwd","explanation":"以文学通登显贵，以武略位居达官。指不管学文学武，只要为国出力，就都有前途。也形容文武双全的人。","source":{"text":"檀珪与僧虔书曰：‘仆一门虽谢文通，乃忝武达。","book":"《南史·檀珪传》"}},{"id":23379,"word":"文通残锦","pinyin":"wén tōng cán jǐn","abbr":"wtcj","explanation":"比喻剩下不多的才华。","source":{"text":"典出《南史·江淹传》。南朝梁江淹，字文通，年轻时就很有才华。传说他晚年梦见晋张协对他说：“前以一匹锦相寄，今可见还。”江淹把几尺残锦奉还，张大怒说：“那得割截都尽。”江淹的文才从此大不如前。"},"similar":["江郎才尽"],"usage":"作宾语、定语；多用于比喻句","story":["南朝时期，文学家江淹年轻时很有才华，晚年他梦见晋人张协对他说：“前以一匹锦相寄，今可见还。”江淹把几尺残锦奉还。张协大怒说：“那得割截都尽。”从此以后，江淹的文才就大不如以前了"]},{"id":23380,"word":"文采炳焕","pinyin":"wén cǎi bǐng huàn","abbr":"wcbh","explanation":"本指豹身花纹，光彩四溢。后形容书法精技艺湛，光彩照人。","source":{"text":"狄伯奇小僧游猎得豹，见其文采炳焕，遂自感叹，始学书艺。","book":"《后秦记》"}},{"id":23381,"word":"文采缘饰","pinyin":"wén cǎi yuán shì","abbr":"wcys","explanation":"文采：指文章精采；缘饰：指衣物镶缀的花边。指花边文学，文笔精美。","source":{"text":"习文法吏事，缘饰以儒术。","book":"《汉书·公孙弘传》"},"example":{"text":"非有～。","book":"宋·苏轼《策略》"}},{"id":23382,"word":"文采风流","pinyin":"wén cǎi fēng liú","abbr":"wcfl","explanation":"横溢的才华与潇洒的风度。亦指才华横溢与风度潇洒的人物。","source":{"text":"夫士大夫登朝之后，大都为世事牵挽，一二有性情者，方能以文采风流、友朋意气相尚。","book":"唐·杜甫《丹青引赠曹将军霸》诗：“英雄割据虽已矣，文采风流今尚存。”清·恽敬《同游海幢寺记》"},"example":{"text":"金陵古称佳丽地，衣冠文物，盛于江南；～，甲于海内。","book":"清·余怀《〈板桥杂记〉序》"},"usage":"作谓语、定语；用于书面语"},{"id":23383,"word":"文阵雄帅","pinyin":"wén zhèn xióng shuài","abbr":"wzxs","explanation":"文人行列中的统帅。指文才出众，在文坛上居首位的人。","source":{"text":"张九龄尝览颋文卷，谓同列曰：‘苏生之俊胆无敌，真文阵雄帅也。’","book":"《新唐书·苏颋传》"}},{"id":23384,"word":"文韬武略","pinyin":"wén tāo wǔ lüè","abbr":"wtwl","explanation":"韬：指《六韬》，古代兵书，内容分文、武、龙、虎、豹、犬六韬；略：指《三略》，古代兵书，凡三卷。比喻用兵的谋略。","source":{"text":"威镇家邦四海清，文韬武略显英雄。全凭智勇安天下，统领雄师百万兵。","book":"元·李文蔚《蒋神灵应》楔子"},"example":{"text":"你便有～，怎逃出地网天罗。","book":"明·施耐庵《水浒全传》第四十七回"},"similar":["文武双全","文韬武韬"],"usage":"作主语、宾语、定语；指用兵的谋略"},{"id":23385,"word":"文韬武韬","pinyin":"wén tāo wǔ tāo","abbr":"wtwt","explanation":"韬：古代兵书《六韬》，即文韬、武韬、龙韬、虎韬、豹韬、犬韬。指文武两方面的谋略。","source":{"text":"上略中略，奏山石之奇谋；文韬武韬，奉川璜之秘诀。","book":"唐·杨炯《原州百泉县令李君神道碑》"},"similar":["文韬武略"],"usage":"作主语、宾语、定语；指用兵的谋略"},{"id":23386,"word":"文风不动","pinyin":"wén fēng bù dòng","abbr":"wfbd","explanation":"一点儿也不动。形容没有丝毫损坏或改变。","source":{"text":"偏生那玉坚硬非常，摔了一下，竟文风不动。","book":"清·曹雪芹《红楼梦》第二十九回"},"example":{"text":"尽管外面闹翻了天，他在屋里仍然～，照旧读他的书。"},"similar":["纹丝不动","文丝不动"],"opposite":["东摇西摆"],"usage":"作谓语、定语；形容没有丝毫损坏或改动"},{"id":23387,"word":"文鸟之梦","pinyin":"wén niǎo zhī mèng","abbr":"wnzm","explanation":"形容人的文思新颖。","source":{"text":"少有志尚，尝昼卧，梦一鸟文彩异常，飞入口中，因起惊说之。朱氏曰：‘鸟有文彩，汝后必有文章。’自此后藻思日新。","book":"《晋书·罗含传》"}},{"id":23388,"word":"文齐福不齐","pinyin":"wén qī fú bǔ qí","abbr":"wqfbq","explanation":"文：文才；齐：全。文才足够崭露头角，可是命运不济。","source":{"text":"你休忧文齐福不齐，我只怕你停妻再娶妻。","book":"元·王实甫《西厢记》第四本第三折"},"usage":"作谓语、定语；用于人的命运"},{"id":23389,"word":"斋居蔬食","pinyin":"zhāi jū shū shí","abbr":"zjss","explanation":"斋居：家居，闲居；蔬食：粗食，素食。闲居在家，粗茶淡饭。形容生活俭朴。","source":{"text":"虽位极人臣，而斋居蔬食，终日淡然，不异平昔。","book":"《元史·刘秉忠传》"},"usage":"作宾语、定语；指生活俭朴"},{"id":23390,"word":"斋心涤虑","pinyin":"zhāi xīn dí lǜ","abbr":"zxdl","explanation":"净洁身心，清除杂念。","source":{"text":"方斋心涤虑，以俟陛下反复诘难，庶几竭尽愚衷。","book":"宋叶適《辩兵部郎官朱元晦状》"},"similar":["洗心涤虑"],"usage":"作谓语、定语；用于书面语"},{"id":23391,"word":"斐然乡风","pinyin":"fěi rán xiāng fēng","abbr":"frxf","explanation":"翩然地闻风归向。"},{"id":23392,"word":"斐然可观","pinyin":"fěi rán kě guān","abbr":"frkg","explanation":"斐然：有文采的样子。形容才干或声名显著。","source":{"text":"这方面努力的不少，成绩也斐然可观。","book":"朱自清《经典常谈·尚书第三》"},"similar":["斐然成章"],"usage":"作谓语、定语、分句；用于书面语"},{"id":23393,"word":"斐然向风","pinyin":"fěi rán xiàng fēng","abbr":"frxf","explanation":"翩然地闻风归向。","source":{"text":"天下之士，斐然向风，若是者何也？","book":"汉·贾谊《过秦论下》"},"example":{"text":"使海内～，则远人不服可以文德以来之。","book":"《三国志·魏志·袁涣传》"},"usage":"作谓语、定语；用于政治等"},{"id":23394,"word":"斐然成章","pinyin":"fěi rán chéng zhāng","abbr":"frcz","explanation":"斐、章：文采。形容文章富有文采，很值得看。","source":{"text":"吾党之小子狂简，斐然成章，不知所以载之。","book":"《论语·公冶长》"},"example":{"text":"一二小友以为此虽不足以饷名家，或尚非无稗于初学，助之编定，～。","book":"鲁迅《小说旧闻钞·序言》"},"similar":["情文并茂","奇文瑰句"],"opposite":["废话连篇","词不达意","平铺直叙"],"usage":"作谓语、定语、分句；用于书面语"},{"id":23395,"word":"斑斑斓斓","pinyin":"bān bān lán lán","abbr":"bbll","explanation":"色彩错杂灿烂的样子。","source":{"text":"恰是十个队长五十个什长，斑斑斓斓的摆了一天井，都叩了头。","book":"清·褚人获《隋唐演义》第25回"},"similar":["五彩斑斓"],"usage":"作谓语、定语；用于色彩等"},{"id":23396,"word":"斑斑点点","pinyin":"bān bān diǎn diǎn","abbr":"bbdd","explanation":"物体的表面颜色不纯净，颜色杂乱或凹凸不平。","source":{"text":"他的衣服被雨淋得～。"},"example":{"text":"清·李汝珍《镜花缘》第八回：“头上～，有许多花文，都在那里啄石，来往飞腾。”"},"similar":["麻麻点点"],"usage":"作定语、状语；用于物体的表面或颜色"},{"id":23397,"word":"斑衣戏彩","pinyin":"bān yī xì cǎi","abbr":"byxc","explanation":"指身穿彩衣，作婴兒戏耍以娱父母。后以之为老养父母的孝亲典故。","source":{"text":"《北堂书钞》卷一二九引《孝子传》言老莱子年七十，父母尚在，因常服斑衣，为婴兒戏以娱父母。"},"example":{"text":"那二十四孝上～，他们不能来戏彩引老祖宗笑一笑，我这里好容易引的老祖宗笑一笑……难道反笑我不成？","book":"《红楼梦》第五四回"},"similar":["班衣戏彩"],"usage":"作宾语、定语；指讨父母欢心"},{"id":23398,"word":"斑驳陆离","pinyin":"bān bó lù lí","abbr":"bbll","explanation":"斑驳：色彩杂乱；陆离：参差不一。形容色彩纷杂。","source":{"text":"纷总总其离合兮，斑陆离其上下。","book":"战国·楚·屈原《离骚》"},"example":{"text":"铜器一，器大可合抱，重数十斤，侧有双环，不知何用，～，瓶亦古。","book":"清·蒲松龄《聊斋志异·古瓶》"},"similar":["五彩缤纷","五光十色","光怪陆离"],"opposite":["清一色"],"usage":"作谓语、定语；形容景物","story":["战国时期，屈原怀才不遇，他多次向楚怀王提出很多建议没有被采纳，与那些贵族阶级的政治主张存在很大的分歧。他在《离骚》中写道：“纷总总其离合兮，斑驳陆离其上下。吾令帝阍开关兮，倚阊阖而望予。”"]},{"id":23399,"word":"斗丽争妍","pinyin":"dòu lì zhēng yán","abbr":"dlzy","explanation":"竞相比赛艳丽。","source":{"text":"每会至坛，箫鼓悠扬，旌旗璀璨，卤簿台阁，斗丽争妍。","book":"清·顾禄《清嘉录·山塘看会》"},"usage":"作谓语、定语；用于花草或女性"},{"id":23400,"word":"斗升之水","pinyin":"dǒu shēng zhī shuǐ","abbr":"dszs","explanation":"比喻微薄的资助。","source":{"text":"我东海之波臣，君岂有斗升之水而活我哉？","book":"《庄子·外物》"},"similar":["杯水车薪"],"usage":"作宾语；指微薄的资助","story":["战国时期，思想家庄周在《庄子》中运用寓言故事，他在《外物》篇中讲到：庄周在旅行途中听到有声音叫他，他在车辙中发现一条鲋鱼，鲋鱼即将缺水请求帮助，庄周准备取一杯水救它，鲋鱼说他是东海的波臣，哪里是这斗升之水能够生活下去的"]},{"id":23401,"word":"斗升之禄","pinyin":"dǒu shēng zhī lù","abbr":"dszl","explanation":"斗升：古代容量单位，1斛＝10斗，1斗＝10升；禄：官员的俸给。微薄的薪俸。","source":{"text":"向之来，非有取于斗升之禄。","book":"宋·苏轼《上枢密韩太尉书》"},"similar":["斗斛之禄"],"usage":"作宾语、定语；用于收入"},{"id":23402,"word":"斗南一人","pinyin":"dǒu nán yī rén","abbr":"dnyr","explanation":"斗南：北斗星以南。指天下，海内。指天下绝无仅有的人才。形容品德或才识独一无二。","source":{"text":"狄公之贤，北斗之南，一人而已。","book":"《新唐书·狄仁杰传》"},"example":{"text":"他向往成为这方面的～。"},"similar":["盖世无双"],"usage":"作宾语；指才德独一无二"},{"id":23403,"word":"斗唇合舌","pinyin":"dòu chún hé shé","abbr":"dchs","explanation":"犹言耍嘴皮子，卖弄口才。","source":{"text":"韩三十五老大汉向同年觅得一副使，而更学斗唇合舌。","book":"南唐·刘崇远《金华子杂编》卷上"},"usage":"作谓语、宾语；用于说话"},{"id":23404,"word":"斗媚争妍","pinyin":"dòu mèi zhēng yán","abbr":"dmzy","explanation":"竞相比赛妩媚艳丽。","source":{"text":"[鱼轩]中有二女，装束艳冶……斗媚争妍，堪称双绝。","book":"清·王韬《淞滨琐话·画船纪艳》"},"similar":["斗美夸丽","斗色争妍"],"usage":"作谓语、定语；用于比美"},{"id":23405,"word":"斗巧争新","pinyin":"dòu qiǎo zhēng xīn","abbr":"dqzx","explanation":"斗、争：比赛争胜。比新奇，赛巧妙。"},{"id":23406,"word":"斗志昂扬","pinyin":"dòu zhì áng yáng","abbr":"dzay","explanation":"昂扬：情绪高涨。斗争的意志旺盛。","source":{"text":"从来也没有看见人民群众像现在这样精神振奋，斗志昂扬，意气风发。","book":"毛泽东《介绍一个合作社》"},"example":{"text":"同学们听了英雄的报告后个个～、争当“活雷锋”"},"similar":["意气风发","生气勃勃","生龙活虎"],"opposite":["精疲力竭","委靡不振","无精打采"],"usage":"作谓语、定语、状语；形容人的精神"},{"id":23407,"word":"斗怪争奇","pinyin":"dòu guài zhēng qí","abbr":"dgzq","explanation":"指以奇怪取胜。","source":{"text":"铜箍铁镯俨刑人，斗怪争奇事事新。","book":"清·郁永河《土番竹枝词》之八"},"similar":["争奇斗怪"],"usage":"作谓语、宾语；用于处事等"},{"id":23408,"word":"斗折蛇行","pinyin":"dǒu zhé shé xíng","abbr":"dzsx","explanation":"斗折：像北斗星的排列一样曲折。像北斗星一样弯曲，像蛇一样曲折行进。形容道路曲折蜿蜒。","source":{"text":"漂西南而望，斗折蛇行，明灭可见。","book":"唐·柳宗元《永州八记·小石潭记》"},"usage":"作谓语、定语；形容道路曲折蜿蜒"},{"id":23409,"word":"斗挹箕扬","pinyin":"dǒu yì jī yáng","abbr":"dyjy","explanation":"比喻无实用。斗、箕皆星宿名，一象斗，一象箕，故以为名。","source":{"text":"维南有箕，不可以簸扬；维北有斗，不可以挹酒浆。","book":"语出《诗·小雅·大东》"},"example":{"text":"浮名～，世岂有明珠百斛量。","book":"宋·刘克庄《沁园春·三和林卿韵》词"},"usage":"作宾语、定语；指无用的东西"},{"id":23410,"word":"斗斛之禄","pinyin":"dǒu hú zhī lù","abbr":"dhzl","explanation":"斗、斛：量器，十升为一斗，十斗为一斛。形容微薄的俸禄。","source":{"text":"吾与汝俱少年，以为虽暂相别，终当久相与处，故舍汝而旅食京师，以求斗斛之禄。诚知其如此，虽万乘之公相，吾不以一日辍汝而就也。","book":"唐·韩愈《祭十二郎文》"},"similar":["斗升之禄"],"usage":"作宾语、定语；用于收入"},{"id":23411,"word":"斗方名士","pinyin":"dǒu fāng míng shì","abbr":"dfms","explanation":"斗方：一二尺见方的诗幅或书画页；名士：知名而未出仕的人。好在斗方上写诗或作画以标榜的“名士”。旧指冒充风雅的人。","source":{"text":"那一班斗方名士，结识了两个报馆主笔，天天弄些诗去登报，要借此博个诗翁的名色。","book":"清·吴趼人《二十年目睹之怪现状》第九回"},"example":{"text":"你来四川五年，现在可以回南京作～去了。","book":"张恨水《八十一梦》"},"usage":"作宾语、定语；指无聊之人"},{"id":23412,"word":"斗智斗力","pinyin":"dòu zhì dòu lì","abbr":"dzdl","explanation":"斗；争斗；智：智慧，聪明；力：气力。用智谋来争胜负，凭力气分胜负。","source":{"text":"汉王笑谢曰：‘吾宁斗智，不能斗力。’","book":"西汉·司马迁《史记·项羽本纪》"},"similar":["斗智斗勇"],"usage":"作谓语、定语；指竞争"},{"id":23413,"word":"斗柄指东","pinyin":"dǒu bǐng zhǐ dōng","abbr":"dbzd","explanation":"北斗星的柄指向东方。指节气已到立春。","source":{"text":"斗柄东指，天下皆春。","book":"《鹖冠子·环流》"}},{"id":23414,"word":"斗榫合缝","pinyin":"dǒu sǔn hé fèng","abbr":"dshf","explanation":"榫：榫头，竹、木、石制器物或构件上利用凹凸相接处凸出的部分榫头和卯眼非常适合，不露缝隙。形容手艺高超。","source":{"text":"一金身，琉璃砖十数块凑成之，其衣褶不爽分，其面目不爽毫，其须眉不爽忽，斗笋合缝信属鬼工。","book":"明·张岱《陶庵梦忆·报恩塔》"}},{"id":23415,"word":"斗水活鳞","pinyin":"dòu shuǐ huó lín","abbr":"dshl","explanation":"比喻得到微薄的资助而解救眼前的危急。","source":{"text":"周昨来，有中道而呼者。周顾视车辙中，有鲋鱼焉。周问之曰：‘鲋鱼来！子何为者邪？’对曰：‘我，东海之波臣也。君岂有斗升之水而活我哉？’","book":"语出《庄子·外物》"},"example":{"text":"闻说道卢家广施，我挈儿女从乡来至，但只愿～，敢指望千金布地。","book":"明·徐复祚《一文钱》第五出"},"usage":"作宾语、定语；用于求助","story":["战国时期，思想家庄周在《庄子》中运用寓言故事，他在《外物》篇中讲到：庄周在旅行途中听到有声音叫他，他在车辙中发现一条鲋鱼，鲋鱼即将缺水请求帮助，庄周准备取一杯水救它，鲋鱼说他是东海的波臣，哪里是这斗升之水能够生活下去的"]},{"id":23416,"word":"斗牙拌齿","pinyin":"dòu yá bàn chǐ","abbr":"dybc","explanation":"犹言斗口齿。以戏言相挑逗。斗，通“逗”。","source":{"text":"众人虽俱是珍哥的旧日相知，只因从良以后便也不好十分斗牙拌齿，说了几句正经话，吃了几杯壮行酒。","book":"《醒世姻缘传》第一回"},"usage":"作谓语、宾语；指争吵"},{"id":23417,"word":"斗笋合缝","pinyin":"dòu sǔn hé fèng","abbr":"dshf","explanation":"笋：通“榫”。榫头和卯眼完全密合，没有缝隙。形容技艺高超。","source":{"text":"一金身，琉璃砖十数块凑成之，其衣褶不爽分，其面目不爽毫，其须眉不爽忽，斗笋合颖，信属鬼工。","book":"明·张岱《报恩塔》"}},{"id":23418,"word":"斗筲之人","pinyin":"dǒu shāo zhī rén","abbr":"dszr","explanation":"斗：容器，一斗＝十升；筲：竹器，容一斗两升。形容人的气量狭小，见识短浅。","source":{"text":"斗筲之人，何足算也。","book":"先秦·孔子《论语·子路》"},"example":{"text":"臣虽～，诚窃怀怪，以为笃、景亲近贵臣，当为百僚表仪。","book":"南朝·宋·范晔《后汉书·何敞传》"},"similar":["斗筲之辈","斗筲之器"],"opposite":["宽宏大量"],"usage":"作主语、宾语；指人的气量狭小","story":["春秋时期，孔子带领弟子周游列国，在陈国闲居无事，与弟子讨论修身之事。他说做“士”要做到“仁者不忧、知者不惑、勇者不惧”三好，分“不辱君命，为国效力；孝悌兼备，乡邻模范；言信行果，千金一诺。”三类，“斗筲之人，何足算也。”"]},{"id":23419,"word":"斗筲之器","pinyin":"dǒu shāo zhī qì","abbr":"dszq","explanation":"筲：仅容一斗二升的竹器。比喻气量狭窄的人。","source":{"text":"子曰：‘噫！斗筲之人，何足算也。’","book":"《论语·子路》"},"example":{"text":"今照奸臣秦桧，～，闾闾小人。","book":"清·钱彩《说岳全传》第七十三回"},"similar":["斗筲之辈","小肚鸡肠"],"opposite":["宽宏大量"],"usage":"作主语、宾语；指心胸狭隘"},{"id":23420,"word":"斗筲之役","pinyin":"dǒu shāo zhī yì","abbr":"dszy","explanation":"指报酬极少的劳役。","source":{"text":"大丈夫焉能处斗筲之役乎？","book":"《后汉书·郭太传》"},"example":{"text":"太夫在堂，有羸老之疾，尚何能违膝下色养，而屑屑从～乎。","book":"晋·潘岳《闲居赋》"}},{"id":23421,"word":"斗筲之徒","pinyin":"dǒu shāo zhī tú","abbr":"dszt","explanation":"比喻气量狭小，才识短浅的人。同“斗筲之人”。","source":{"text":"斗筲之徒，何足选也。","book":"《汉书·公孙贺刘屈氂等传赞》"},"similar":["斗筲之器","斗筲之人","斗筲之才"],"usage":"作主语、宾语；指人的气量狭小"},{"id":23422,"word":"斗筲之才","pinyin":"dǒu shāo zhī cái","abbr":"dszc","explanation":"比喻气量狭小，才识短浅的人。同“斗筲之人”。","source":{"text":"至于桑弘羊，斗筲之才，穿窬之智，无足言者。","book":"宋·苏轼《商鞅论》"},"similar":["斗筲之材","斗筲之辈","斗筲之人"],"usage":"作主语、宾语；指人的气量狭小"},{"id":23423,"word":"斗筲之材","pinyin":"dǒu shāo zhī cái","abbr":"dszc","explanation":"比喻气量狭小，才识短浅的人。同“斗筲之人”。","source":{"text":"永斗筲之材，质薄学朽，无一日之雅，左右之介。","book":"东汉·班固《汉书·谷永传》"},"example":{"text":"又托日月未光，以～，乘君子之器。","book":"晋·袁宏《后汉纪·顺帝纪》"},"similar":["斗筲之徒","斗筲之器","斗筲之人"],"usage":"作主语、宾语；指人的气量狭小"},{"id":23424,"word":"斗筲之辈","pinyin":"dǒu shāo zhī bèi","abbr":"dszb","explanation":"比喻气量狭小，才识短浅的人。同“斗筲之人”。","source":{"text":"囊瓦乃斗筲之辈，贪功侥幸，今史皇小挫，未有亏损，今夜必来掩袭大寨，不可不备。","book":"《东周列国志》第七十六回"},"similar":["斗筲之人","斗筲之才","斗筲之材"],"usage":"作主语、宾语；指人的气量狭小"},{"id":23425,"word":"斗筲小人","pinyin":"dǒu shāo xiǎo rén","abbr":"dsxr","explanation":"比喻气量狭小，才识短浅的人。同“斗筲之人”。","source":{"text":"委任臣僚，非才者众，如陈平章、姚平章，皆斗筲小人，而使之秉钧轴，握兵符。","book":"《剪灯余话·秋夕访琵琶亭记》"},"similar":["斗筲之辈","斗筲之才","斗筲之材"],"usage":"作主语、宾语；指人的气量狭小"},{"id":23426,"word":"斗筲小器","pinyin":"dǒu shāo xiǎo qì","abbr":"dsxq","explanation":"比喻气量狭小，才识短浅的人。同“斗筲之人”。","source":{"text":"况乎行陈凡才，斗筲小器，而怀问鼎之志，敢构无君之逆哉？","book":"《宋书·沈攸之传》"},"example":{"text":"王充～，遭逢时幸，俱蒙奖擢，礼越旧臣。","book":"《隋书·宇文化及等传论》"},"similar":["斗筲小人","斗筲之辈","斗筲之才"],"usage":"作主语、谓语、宾语；指人的气量狭小"},{"id":23427,"word":"斗筲穿窬","pinyin":"dǒu shāo chuān yú","abbr":"dscy","explanation":"筲：竹器，容十二升。斗筲：喻人气度狭小，见识浅陋。穿：穿墙。窬：翻墙。亦借指鄙陋苟且的人。","source":{"text":"公之所为，必将惊世绝俗，使斗筲穿窬之流心破胆裂。","book":"《论语·子路》：“子曰：‘噫！斗筲之人，何足算也。’”《论语·阳货》：“色厉而内荏，譬诸小人，其穿窬之盗也与。”宋·苏轼《王元之画像赞》"},"example":{"text":"西汉之末，敢言者惟王章、朱云二人，章死而云废，则公卿持禄保妻子如张禹、孔光之流耳。故王莽以～之才，盗取神器如反诸掌。","book":"宋·苏轼《张九龄不肯用张守珪牛仙客》"},"usage":"作宾语、定语；用于气量小的人"},{"id":23428,"word":"斗米尺布","pinyin":"dǒu mǐ chǐ bù","abbr":"dmcb","explanation":"指少量的粮食与布匹。","source":{"text":"其一余不知名，亦不识面貌，每日以沉湎为工课。凡所得斗米尺布，尽以沽酒。","book":"明·袁宏道《碧晖上人修净室引》"},"similar":["斗粟尺布"],"usage":"作宾语、定语；指少量的粮食与布匹"},{"id":23429,"word":"斗粟尺布","pinyin":"dǒu sù chǐ bù","abbr":"dscb","explanation":"比喻兄弟间因利害冲突而不和。","source":{"text":"一尺布，尚可缝；一斗粟，尚可春；兄弟二人不相容。","book":"《史记·淮南衡山列传》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“煮豆燃箕，谓其相害；～，讥其不容。”"},"similar":["尺布斗粟"],"usage":"作主语、宾语、定语；比喻兄弟不和","story":["西汉时期，汉文帝的弟弟淮南厉王刘长因为谋反事败后，被汉文帝贬放蜀郡，他在路上绝食而死。人们对此大发感慨，流传一首民谣：“一尺布，尚可缝；一斗粟，尚可舂；兄弟二人不相容。”来讽刺兄弟不合"]},{"id":23430,"word":"斗绝一隅","pinyin":"dǒu jué yī yú","abbr":"djyy","explanation":"孤悬边远之地；僻处边远之地。","source":{"text":"焉耆为国，斗绝一隅，不乱日久。","book":"《魏书·西域传·焉耆》"},"example":{"text":"李公～，安得此文士，如吾之智算，得袭吉之笔才，虎傅翼矣！","book":"《旧五代史·唐书·李袭吉传》"},"usage":"作宾语、定语；用于书面语"},{"id":23431,"word":"斗美夸丽","pinyin":"dòu měi kuā lì","abbr":"dmkl","explanation":"指比赛美丽以争胜。","source":{"text":"有一等晚年后生，不体旧规，裹厅巾异服，三五为群，斗美夸丽，殊令人厌见。","book":"宋·吴自牧《梦梁录·民俗》"},"similar":["斗媚争妍"],"usage":"作谓语、定语；用于比美"},{"id":23432,"word":"斗而铸兵","pinyin":"dòu ér zhù bīng","abbr":"dezb","explanation":"临到打仗才去铸造兵器。比喻行动不及时。同“斗而铸锥”。","source":{"text":"《素问·四气调神大论》：“夫病已成而后药之，乱已成而后治之，譬犹渴而穿井，斗而铸锥，不亦晚呼？”一本作“斗而铸兵”。"},"similar":["斗而铸锥","临渴掘井"],"usage":"作谓语、定语；用于处事"},{"id":23433,"word":"斗而铸锥","pinyin":"dòu ér zhù zhuī","abbr":"dezz","explanation":"临到打仗才去铸造兵器。比喻行动不及时。","source":{"text":"夫病已成而后药之，乱已成而后治之，譬犹渴而穿井，斗而铸锥，不亦晚呼？","book":"《素问·四气调神大论》"},"similar":["斗而铸兵"],"usage":"作谓语、定语；用于处事"},{"id":23434,"word":"斗色争妍","pinyin":"dòu sè zhēng yán","abbr":"dszy","explanation":"形容花盛开，竞相逞美。","source":{"text":"巡檐一笑卿相慰，斗色争妍非尔时。","book":"明·何景明《二月见梅》诗"},"similar":["斗媚争妍"],"usage":"作谓语、定语；用于比美"},{"id":23435,"word":"斗艳争妍","pinyin":"dòu yàn zhēng yán","abbr":"dyzy","explanation":"竞相比赛艳丽。同“斗艳争妍”。","source":{"text":"因思春夏秋之花，斗艳争妍，逾旬则色衰态倦，甚且有一日半日而谢者。","book":"清·归庄《看寒花记》"},"example":{"text":"众香国里品名葩，～第一家。","book":"清·周友良《珠江梅柳记》"},"similar":["斗艳争辉","斗艳争芳"],"usage":"作谓语、定语、状语；用于比美"},{"id":23436,"word":"斗艳争芳","pinyin":"dòu yàn zhēng fāng","abbr":"dyzf","explanation":"竞相比赛艳丽、散发芳香。","source":{"text":"斗艳争芳惟粉黛，当年大小慕乔公。","book":"《白雪遗音·玉蜻蜓·游庵》"},"similar":["争芳斗艳","斗媚争妍","斗艳争辉"],"usage":"作谓语、定语；用于比美"},{"id":23437,"word":"斗艳争辉","pinyin":"dòu yàn zhēng huī","abbr":"dyzh","explanation":"竞相比赛美丽、焕发容光。","source":{"text":"只趁事持夸窈窕，斗艳争辉呈面峭（俏）。","book":"《敦煌变文集·无常经讲经文》"},"similar":["斗艳争芳","斗艳争妍"],"usage":"作谓语、定语；用于比美"},{"id":23438,"word":"斗转参斜","pinyin":"dǒu zhuǎn shēn xié","abbr":"dzcx","explanation":"斗：北斗星；参：星名，28宿之一，白虎七宿的末一宿。北斗转向，参星横斜。指天快亮的时候。","source":{"text":"急回头斗转参斜，酒杯儿倒手都休撤。","book":"明·冯惟敏《柳摇金·风情》"},"similar":["斗转参横"],"usage":"作宾语、定语；指天将亮"},{"id":23439,"word":"斗转参横","pinyin":"dǒu zhuǎn shēn héng","abbr":"dzsh","explanation":"北斗转向，参星打横。指天快亮的时候。","source":{"text":"斗转参横将旦，天开地辟如春。","book":"三国·魏·曹操《善哉行》：“月没参横，北斗阑干。”《宋史·乐志》"},"example":{"text":"二人坐了许久，看看～，大约已是半夜光景。","book":"清·吴趼人《痛史》第十回"},"similar":["斗转参斜"],"usage":"作宾语、定语；指天将亮"},{"id":23440,"word":"斗转星移","pinyin":"dǒu zhuǎn xīng yí","abbr":"dzxy","explanation":"星斗变动位置。指季节或时间的变化。","source":{"text":"直睡的陵迁谷变，石烂松枯，斗转星移。","book":"元·马致远《陈抟高卧》第三折"},"example":{"text":"直吃的昏惨惨更阑夜深，直熬的明皎皎～。","book":"明·无名氏《锁白猿》第一折"},"similar":["光阴似苒","物转星移"],"opposite":["停滞不前"],"usage":"作状语、定语；指季节或时间的变化"},{"id":23441,"word":"斗酒双柑","pinyin":"dòu jiǔ shuāng gān","abbr":"djsg","explanation":"指春日胜游。","source":{"text":"戴颙春携双柑斗酒，人问何之。曰：‘往听黄鹂声。’","book":"《高隐外传》"},"example":{"text":"～快听莺，扁舟一棹闲放鹤。","book":"汪文溥《题亚子分湖旧隐图》"},"usage":"作宾语、定语；指春日漫游"},{"id":23442,"word":"斗酒只鸡","pinyin":"dǒu jiǔ zhī jī","abbr":"djzj","explanation":"斗：酒器。古人祭亡友，携鸡酒到墓前行礼。后作为追悼亡友的话。","source":{"text":"殂逝之后，路有经由，不以斗酒只鸡过相沃酹，车过三步，腹痛勿怪。","book":"汉·曹操《祀故太尉桥玄文》"},"example":{"text":"既然肯来赴约呵，您兄弟～，等待我的哥哥也。","book":"元·宫大用《范张鸡黍》楔子"},"similar":["只鸡斗酒"],"usage":"作宾语、定语；指作为追悼亡友的话"},{"id":23443,"word":"斗酒学士","pinyin":"dǒu jiǔ xué shì","abbr":"djxs","explanation":"指酒量大的文士或名臣。","source":{"text":"以前官待诏门下省，故事，官给酒日三升。或问：‘待诏何乐邪？’答曰：‘良酝可恋耳。’侍中陈叔达闻之，日给一斗，时称‘斗酒学士’。","book":"《新唐书·王绩传》"},"example":{"text":"他曾有～的美名。"},"similar":["斗酒百篇"],"usage":"作宾语；指酒量大的文士或官员的称谓"},{"id":23444,"word":"斗酒百篇","pinyin":"dǒu jiǔ bǎi piān","abbr":"djbp","explanation":"饮一斗酒，作百篇诗。形容才思敏捷。","source":{"text":"李白斗酒诗百篇，长安市上酒家眠。","book":"唐·杜甫《饮中八仙歌》"},"example":{"text":"房师孙瑞人先生，文章淹雅，而性嗜酒，醉后所作与醒时无异，馆阁诸公以为～之亚也。","book":"清·纪昀《阅微草堂笔记》卷十一"},"usage":"作定语、状语；指能诗善饮"},{"id":23445,"word":"斗重山齐","pinyin":"dǒu zhòng shān qí","abbr":"dzsq","explanation":"像北斗星一样令人敬仰，如泰山一样崇高。形容人德才兼备，享有很高的威望。","source":{"text":"痛追思旧日相随，德业文章，斗重山齐。","book":"《群英类选·〈鸣凤记·典刑死节〉》"},"usage":"作谓语、定语；用于祝福"},{"id":23446,"word":"斗量筲计","pinyin":"dǒu liáng shāo jì","abbr":"dlsj","explanation":"用斗量，用筲计。形容数量很多。","source":{"text":"南渡后，江湖流派，斗量筲计，风轨荡然矣。","book":"明·胡应麟《诗薮·杂编》"},"usage":"作谓语、定语；指数量多"},{"id":23447,"word":"斗量车载","pinyin":"dǒu liáng chē zài","abbr":"dlcz","explanation":"载：装载。用车载，用斗量。形容数量很多，不足为奇。","source":{"text":"向来珠履簪人，颇觉斗量车载满。","book":"宋·辛弃疾《玉楼春·用韵答子似》"},"example":{"text":"月白风清其有意，～已无名。","book":"清·梁绍壬《两般秋雨庵随笔》第三卷"},"similar":["车载斗量","数不胜数"],"opposite":["寥寥无几","屈指可数"],"usage":"作谓语、定语；形容数量很多"},{"id":23448,"word":"斗霜傲雪","pinyin":"dòu shuāng ào xuě","abbr":"dsax","explanation":"形容在严酷的环境中敢于斗争，不屈不挠。"},{"id":23449,"word":"斗鸡养狗","pinyin":"dòu jī yǎng gǒu","abbr":"djyg","explanation":"指旧时剥削阶级子弟游手好闲的无聊游戏。同“斗鸡走狗”。","source":{"text":"他兄弟在家开赌场，斗鸡养狗，人不敢惹他。","book":"《金瓶梅词话》第九八回"},"similar":["斗鸡走犬","斗鸡走马","斗鸡走狗"],"usage":"作谓语、定语；用于书面语"},{"id":23450,"word":"斗鸡走犬","pinyin":"dòu jī zǒu quǎn","abbr":"djzq","explanation":"指旧时剥削阶级子弟游手好闲的无聊游戏。同“斗鸡走狗”。","source":{"text":"临淄甚富而实，其民无不吹竽鼓瑟、击筑弹琴、斗鸡走犬、六博蹋踘者。","book":"《战国策·齐策一》"},"similar":["斗鸡养狗","斗鸡走狗"],"usage":"作谓语、定语；用于书面语"},{"id":23451,"word":"斗鸡走狗","pinyin":"dòu jī zǒu gǒu","abbr":"djzg","explanation":"使公鸡相斗，使狗赛跑。指旧时剥削阶级子弟游手好闲的无聊游戏。","source":{"text":"盎病免居家，与阊里淝枕，相随行斗鸡走狗。","book":"《史记·袁盎晁错列传》"},"example":{"text":"虽然应名来上学，亦不过虚掩眼目而已，仍是～，赏花阅柳为事。","book":"清·曹雪芹《红楼梦》第九回"},"similar":["游手好闲","寻欢作乐","无所事事"],"opposite":["埋头苦干","日理万机"],"usage":"作谓语、定语；用于书面语"},{"id":23452,"word":"斗鸡走马","pinyin":"dòu jī zǒu mǎ","abbr":"djzm","explanation":"斗鸡赛马。古代的赌博游戏。","source":{"text":"[宣帝]受《诗》于东海澓中翁，高材好学，然亦喜游侠，斗鸡走马。","book":"《汉书·宣帝纪》"},"example":{"text":"鸣鸾佩玉青云间，～红尘里。","book":"明·何景明《邯郸行》"},"similar":["斗鸡养狗","斗鸡走狗","斗鸡走犬"],"usage":"作谓语、定语；用于书面语"},{"id":23453,"word":"料事如神","pinyin":"liào shì rú shén","abbr":"lsrs","explanation":"料：预料。预料事情象神仙一样准确。形容预料事情非常准确。","source":{"text":"公器识宏深，襟度宽博，议论施加人数等，料事如神，物无遁情。","book":"宋·杨万里《提刑徽猷检正王公墓志铭》"},"example":{"text":"我又不能～，除了硬挺之外，总不免要吃点小亏。","book":"清·吴趼人《近十年之怪现状》第四回"},"similar":["心中有数","先见之明"],"opposite":["鼠目寸光","目光如豆"],"usage":"作谓语、宾语、定语；指分析问题很准","story":["春秋时期，孔子带领弟子们周游列国，在陈国闲居时，弟子冉求从鲁国回来，说鲁国宗庙失火之事，孔子说一定烧了桓公、僖公的庙。冉求说夫子料事如神，果然是烧了这两座。孔子说桓公杀兄夺位，僖公杀弟篡国，这是天意"]},{"id":23454,"word":"料峭春寒","pinyin":"liào qiào chūn hán","abbr":"lqch","explanation":"料峭：微寒。形容初春的寒冷。","source":{"text":"春寒料峭，冻杀年少。","book":"宋·释普济《五灯会元》卷十九"},"example":{"text":"～中酒，交加晓梦啼莺。","book":"宋·吴文英《风入松》词"},"similar":["春寒料峭"],"usage":"作谓语、定语；形容春天的寒冷天气"},{"id":23455,"word":"料峭春风","pinyin":"liào qiào chūn fēng","abbr":"lqcf","explanation":"料峭：微寒。形容初春的寒冷。","source":{"text":"料峭春风吹酒醒，微冷，山头斜照却相迎。","book":"宋·苏轼《定风波》词"}},{"id":23456,"word":"料戾彻鉴","pinyin":"liào lì chè jiàn","abbr":"llcj","explanation":"料戾：小窗隙。孔洞虽小，却可以把外面看得清清楚楚。","source":{"text":"衷料戾以彻鉴。","book":"晋·潘岳《射雉赋》"}},{"id":23457,"word":"料敌制胜","pinyin":"liào dí zhì shèng","abbr":"ldzs","explanation":"准确地判断敌情，并蠃得胜利。","source":{"text":"料敌制胜，计险厄远近，上将之道也。","book":"春秋·齐·孙武《孙子·地形》"},"example":{"text":"臣才不足以～，力不足以督励诸将，有负委任，罪合首坐。","book":"明·唐顺之《三沙贼遁疏》"},"usage":"作宾语、定语；指准确判断敌情"},{"id":23458,"word":"料敌如神","pinyin":"liào dí rū shén","abbr":"ldrs","explanation":"料：预料。形容对敌方活动预料非常准确。","source":{"text":"故太尉、兼中书令、上柱国、汾阳郡王、尚父子仪，天降人杰，生知王佐，训师如子，料敌若神。","book":"《旧唐书·郭子仪传》"},"example":{"text":"他很有计谋，经常～。"},"similar":["料事如神","先见之明"],"usage":"作谓语、定语；指善于用兵","story":["唐朝时期，节度使安禄山起兵叛乱，唐玄宗任命朔方节度使郭子仪去讨伐安禄山，他料敌如神，斩叛将周万顷，击退高秀岩，收复方中、马邑等地。又与河东节度使李光弼一起击败史思明，受到唐肃宗的重用"]},{"id":23459,"word":"料敌若神","pinyin":"liào dí ruò shén","abbr":"ldrs","explanation":"料：预料。形容对敌方活动预料非常准确。","source":{"text":"故太尉、兼中书令、上柱国、汾阳郡王、尚父子仪，天降人杰，生知王佐，训师如子，料敌如神。","book":"《旧唐书·郭子仪传》"},"example":{"text":"御众如一，～；大伸于楚，小挫于秦。","book":"明·冯梦龙《东周列国志》第七十七"},"similar":["料敌如神"],"usage":"作谓语；指知己知彼","story":["唐朝时期，节度使安禄山起兵叛乱，唐玄宗任命朔方节度使郭子仪去讨伐安禄山，他料敌如神，斩叛将周万顷，击退高秀岩，收复方中、马邑等地。又与河东节度使李光弼一起击败史思明，受到唐肃宗的重用"]},{"id":23460,"word":"料远若近","pinyin":"liào yuǎn ruò jìn","abbr":"lyrj","explanation":"远、近：分别指将来和目前的事物。预料未来的事态发展，就像看眼前的事物一样清楚。","source":{"text":"谋虑渊深，料远若近，视昧而察，筹不虚运。","book":"《三国志·魏志·王昶传》"},"similar":["高瞻远瞩"],"usage":"作谓语、定语；用于人有远见"},{"id":23461,"word":"斜头歪脑","pinyin":"xié tóu wāi nǎo","abbr":"xtwn","explanation":"比喻相貌不周正。","source":{"text":"阎王爷叫你当穷汉，斜头歪脑还想把身翻。","book":"李季《王贵与李香香》第三部"},"usage":"作定语、状语；用于人的外貌等"},{"id":23462,"word":"斜行横阵","pinyin":"xié xíng héng zhèn","abbr":"xxhz","explanation":"指飞行的雁阵。大雁飞行时或为“人”字形，或为“一”字形，故称。","source":{"text":"万重云外，斜行横阵，才疏又缀。","book":"宋·苏轼《水龙吟》词"},"usage":"作宾语、定语；用于书面语"},{"id":23463,"word":"斜风细雨","pinyin":"xié fēng xì yǔ","abbr":"xfxy","explanation":"形容微风夹着毛毛雨的天气。也比喻用温和舒缓的语气批评别人。","source":{"text":"青箬笠，绿蓑衣，斜风细雨不须归。","book":"唐·张志和《渔歌子》"},"example":{"text":"江上撑开一叶舟，竿头收起钓鱼钩，箬笠蓑衣随意有，～不须忧。","book":"元·范子安《竹叶舟》第三折"},"similar":["微风小雨","细雨斜风"],"opposite":["狂风暴雨"],"usage":"作主语、宾语；形容微风细雨的天气"},{"id":23464,"word":"斟酌损益","pinyin":"zhēn zhuó sǔn yì","abbr":"zzsy","explanation":"斟酌：考虑；损：减少；益：增加。仔细考虑，斟情酌理，掌握分寸。","source":{"text":"至于斟酌损益，进尽忠言，则攸之、祎、允之任也。","book":"三国·蜀·诸葛亮《出师表》"},"example":{"text":"兹据另议章程五条，无非就自然之利～。","book":"清·林则徐《查勘矿厂情形试行开采折》"},"usage":"作谓语、宾语；指认真考虑"},{"id":23465,"word":"斠然一概","pinyin":"jiào rán yī gài","abbr":"jryg","explanation":"持平一致。斠，古通“校”，校正。","example":{"text":"我们处事要做得～，不能偏袒。"},"similar":["持平一致"],"usage":"作谓语、定语、状语；用于书面语"},{"id":23466,"word":"斠若画一","pinyin":"jiào ruò huà yī","abbr":"jrhy","explanation":"公平持正；整齐画一。","source":{"text":"萧河为法，斠若画一。","book":"唐·程晏《萧何求继论》"},"example":{"text":"吾以为火器之穷，人人殚精竭思而无所进，万国之强弱，～。","book":"章炳麟《訄书》"},"usage":"作谓语；用于书面语"},{"id":23467,"word":"斤斤自守","pinyin":"jīn jīn zì shǒu","abbr":"jjzs","explanation":"斤斤：拘谨的样子。谨小慎微，自求无过。","source":{"text":"生斤斤自守，不敢少致差（蹉）跌。","book":"清·蒲松龄《聊斋志异·锦瑟》"},"similar":["谨小慎微"],"usage":"作谓语、宾语；指人谨小慎微"},{"id":23468,"word":"斤斤计较","pinyin":"jīn jīn jì jiào","abbr":"jjjj","explanation":"斤斤：形容明察，引伸为琐碎细小。指对无关紧要的事过分计较。","source":{"text":"自彼成康，奄有四方，斤斤其明。","book":"《诗经·周颂·执竞》"},"example":{"text":"至于梦中的“苦乐”，则照我素人的见解，毕竟是梦中的“苦乐”，不必～的。","book":"朱自清《说梦》"},"similar":["锱铢必较"],"opposite":["宽宏大量","毫不介意"],"usage":"作谓语、定语；指人气量小"},{"id":23469,"word":"斤斤较量","pinyin":"jīn jīn jiào liàng","abbr":"jjjl","explanation":"指在琐细的小事上过分计较。","source":{"text":"至于文理浮泛些，或是用的典故不的当，他老人家却也不甚斤斤较量。","book":"清·李宝嘉《官场现形记》第四十二回"},"example":{"text":"我做官是为什么呢？无非是为两个钱。倘或一定为着百姓，同教士～，我们这一任就怕不得期满。","book":"清·吴趼人《糊涂世界》第十回"},"similar":["斤斤计较"],"opposite":["宽宏大量"],"usage":"作谓语、定语；指人气量小"},{"id":23470,"word":"斤车御史","pinyin":"jīn chē yù shǐ","abbr":"jcys","explanation":"斤车：隐喻“斩”；御史：古代官名。指办案果敢神速的法官。","source":{"text":"御史席平因鞫诏狱毕，上殿，仁宗问其事，平曰：‘已从车边斤矣。’时谓之斤车御史。","book":"宋·魏泰《东轩笔录》"}},{"id":23471,"word":"斧凿痕","pinyin":"fǔ záo hén","abbr":"fzh","explanation":"斧：斧头；凿：凿子；痕：痕迹。原指用斧头、凿子在木石上加工留下的痕迹。多用来比喻诗文字画等造作，不自然。","source":{"text":"徒观斧凿痕，不瞩治水航。","book":"唐·韩愈《调张籍》"},"example":{"text":"老苏文字，篇篇无～。","book":"宋·韩淲《涧泉日记》下"}},{"id":23472,"word":"斧凿痕迹","pinyin":"fǔ záo hén jì","abbr":"fzhj","explanation":"斧：斧头；凿：凿子；痕：痕迹。原指用斧头、凿子在木石上加工留下的痕迹。多用来比喻诗文字画等造作，不自然。","source":{"text":"古语云：大匠不示人以璞。盖恐人见其斧凿痕迹也。","book":"唐·韩愈《调张籍》：“徒观斧凿痕，不瞩治水航。”宋·朱弁《曲洧旧闻》"},"example":{"text":"余最爱《绣孺记》中《鹅毛雪》一折，皆乞儿家常口头话，熔铸浑成，不见～。","book":"明·沈德符《顾曲杂言〈拜月亭〉》"}},{"id":23473,"word":"斧破斨缺","pinyin":"fǔ pò qiāng quē","abbr":"fpqq","explanation":"斨：古代一种斧子。指武器破损残缺。","source":{"text":"既破我斧， 又缺我斨。","book":"《诗·豳风·破斧》"},"example":{"text":"结果是怎样呢？他一去便打了三年，弄得来～，一般的士兵都怨望起来了。","book":"郭沫若《中国古代社会研究》第二篇第一章第二节"},"usage":"作宾语、状语、定语；指兵器破烂"},{"id":23474,"word":"斧钺之人","pinyin":"fǔ yuè zhī rén","abbr":"fyzr","explanation":"钺：古代兵器，像大斧。应该用斧钺杀死的人。泛指因罪应当受死刑的人。","source":{"text":"斧钺之人也，幸以获生。","book":"《管子·小匡》"},"usage":"作主语、宾语；用于罪犯等"},{"id":23475,"word":"斧钺之诛","pinyin":"fǔ yuè zhī zhū","abbr":"fyzz","explanation":"《庄子·至乐》：“钺：古代兵器，像大斧；诛：杀戮，杀死。用斧、钺杀人的刑罚。泛指死刑。","source":{"text":"庄子之楚，见空髑髅髐然有形，撽以马捶，因而问之曰：‘夫子贪生失理而为此乎？将子有亡国之事、斧钺之诛而此乎？’","book":"《庄子·至乐》"},"example":{"text":"明·冯梦龙《喻世明言》第22卷：“台臣复交章劾奏，请加～。”"},"usage":"作宾语；泛指死刑"},{"id":23476,"word":"斧钺刀墨","pinyin":"fǔ yuè dāo mò","abbr":"fydm","explanation":"斧钺：古代军法用来杀人的斧子，泛指刑罚中的杀戮；刀墨：指黥刑，泛指罪犯。对罪犯施以刑罚。","source":{"text":"有斧钺刀墨之民。","book":"《国语·周语上》"}},{"id":23477,"word":"斧钺汤镬","pinyin":"fǔ yuè tāng huò","abbr":"fyth","explanation":"斧钺：古代军中刑戮。汤：滚开的水。镬：古代的大锅。汤镬：古代一种酷刑，把犯人投入滚水中煮死。指各种酷刑。","source":{"text":"虽蒙斧钺汤镬，诚甘乐之。","book":"《汉书·苏武传》"},"usage":"作主语、宾语、定语；用于刑罚"},{"id":23478,"word":"斩关夺隘","pinyin":"zhǎn guān duó ài","abbr":"zgda","explanation":"砍断门闩，攻破城门，夺取关隘。形容军队作战勇敢，势不可挡。","source":{"text":"长征中，红军斩关夺隘，抢险飞渡，杀退了千万追兵阻敌。","book":"刘伯承《回顾长征》"},"example":{"text":"［红三军］一路上克服了……严重困难，跋山涉水，～，粉碎了敌人的前堵后追，消灭许多敌人。","book":"许光达等《湘鄂西和湘鄂川黔的武装斗争》"},"usage":"作谓语、宾语、定语；用于军事等"},{"id":23479,"word":"斩头去尾","pinyin":"zhǎn tóu qù wěi","abbr":"ztqw","explanation":"斩掉头部，除去尾部。指将整体分割。也指剩下中间部分。","source":{"text":"由于我军执行了上述方针，华北敌人即被我军斩头去尾，一截一截地被各个歼灭。","book":"叶剑英《伟大的战略决战》"},"similar":["掐头去尾"],"usage":"作谓语、状语；指中间部分"},{"id":23480,"word":"斩头沥血","pinyin":"zhǎn tóu lì xuè","abbr":"ztlx","explanation":"形容为匡扶正义而不顾生死。","source":{"text":"我是斩头沥血的人，何肯戏弄良人！","book":"明·施耐庵《水浒传》第二十七回"},"example":{"text":"在今日算是一个～的人儿。","book":"清·感惺《游侠传·侠议》"},"usage":"作谓语、定语；用于书面语"},{"id":23481,"word":"斩将刈旗","pinyin":"zhǎn jiàng yì qí","abbr":"zjyq","explanation":"砍杀敌将，拔取敌旗。形容勇猛善战。同“斩将搴旗”。","source":{"text":"今日固决死，愿为诸君快战，必三胜之，为诸君溃围，斩将刈旗，令诸君知天亡我，非战之罪也。","book":"西汉·司马迁《史记·项羽本纪》"},"similar":["斩将夺旗","斩将搴旗"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":23482,"word":"斩将夺旗","pinyin":"zhǎn jiàng duó qí","abbr":"zjdq","explanation":"砍杀敌将，拔取敌旗。形容勇猛善战。同“斩将搴旗”。","source":{"text":"只消受得瘗粉埋香，索强似斩将夺旗。","book":"《群音类选·官腔类·八义记·拷问如姬》"},"example":{"text":"为文者调和鼎鼐，燮理阴阳。为武者冲围破阵，～。","book":"《孤本元明杂剧·万国来朝》第一折"},"similar":["斩将刈旗","斩将搴旗"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":23483,"word":"斩将搴旗","pinyin":"zhǎn jiàng qiān qí","abbr":"zjqq","explanation":"搴：拔取。拔取敌旗，斩杀敌将。形容勇猛善战。","source":{"text":"然则一军之中，必有虎贲之士，力轻抗鼎，足轻戎马，搴旗斩将，必有能者。","book":"《吴子·料敌》"},"example":{"text":"即使～，威振疆场，亦偏将之任，非主公所宜也。","book":"明·罗贯中《三国演义》第五十三回"},"similar":["斩将夺旗"],"usage":"作谓语、定语；指作战勇猛"},{"id":23484,"word":"斩尽杀绝","pinyin":"zhǎn jìn shā jué","abbr":"zjsj","explanation":"全部杀光。比喻做事不留余地。","source":{"text":"小官今日将秦国二将活挟将来了，将众兵斩尽杀绝也。","book":"元·高文秀《渑池会》第四折"},"example":{"text":"元·高文秀《渑池会》第四折：“小官今日将秦国二将活挟将来了，将众兵斩尽杀绝也。”"},"similar":["斩草除根","除恶务尽"],"opposite":["养虎遗患","放虎归山"],"usage":"作谓语、宾语；指不留余地"},{"id":23485,"word":"斩岸堙溪","pinyin":"zhǎn àn yīn xī","abbr":"zayx","explanation":"堙：堵塞、填满。铲平高岸，填塞河沟。比喻修整与开辟道路","source":{"text":"中山之国有夙繇者，智伯欲攻之而无道也。为铸大钟，方车二轨以遗之。夙繇之君，将斩岸堙溪以迎钟。","book":"战国·卫·吕不韦《吕氏春秋·权勋》"},"usage":"作定语、状语；用于书面语"},{"id":23486,"word":"斩木为兵，揭竿为旗","pinyin":"zhǎn mù wéi bīng，jiē gān wéi qí","abbr":"zmwbjgwq","explanation":"揭：举起；竿：竹竿。砍削树木当兵器，举起竹竿作军旗。比喻武装起义。","source":{"text":"斩木为兵，揭竿为旗，天下云合响应，赢粮而景从，山东豪杰并起而亡秦族矣。","book":"汉·贾谊《过秦论》"},"similar":["斩木揭竿","斩竿揭木"],"usage":"作谓语、定语；用于书面语"},{"id":23487,"word":"斩木揭竿","pinyin":"zhǎn mù jiē gān","abbr":"zmjg","explanation":"揭：举起；竿：竹竿。砍削树木当兵器，举起竹竿作军旗。比喻武装起义。","source":{"text":"斩木为兵，揭竿为旗，天下云合响应，赢粮而景从，山东豪杰并起而亡秦族矣。","book":"汉·贾谊《过秦论》"},"example":{"text":"臣闻田虎～之势，今已燎原，非猛将雄兵，难以剿灭。","book":"明·施耐庵《水浒全传》第九十一回"},"similar":["斩木为兵，揭竿为旗"],"usage":"作谓语、宾语、定语；指造反"},{"id":23488,"word":"斩竿揭木","pinyin":"zhǎn gān jiē mù","abbr":"zgjm","explanation":"犹言斩木揭竿。","source":{"text":"维兹六月，忽有斩竿揭木之事。","book":"清·褚人获《坚瓠补集·关社引》"},"similar":["斩木为兵，揭竿为旗","斩木揭竿"],"usage":"作谓语、宾语、定语；指造反"},{"id":23489,"word":"斩荆披棘","pinyin":"zhǎn jīng pī jí","abbr":"zjpj","explanation":"斩除荆棘。比喻在前进道路上或创业过程中扫除障碍，克服困难。同“披荆斩棘”。","source":{"text":"吾民族以不挠不屈之气概，与外族战，与吐蕃战，与寒暑战，卒能斩荆披棘，蕃育子孙至数百万。","book":"清·陈天华《论中国宜改创民主政体》"},"similar":["披荆斩棘","劈荆斩棘"],"usage":"作谓语、宾语、状语；形容创业的艰苦"},{"id":23490,"word":"斩草除根","pinyin":"zhǎn cǎo chú gēn","abbr":"zccg","explanation":"除草时要连根除掉，使草不能再长。比喻除去祸根，以免后患。","source":{"text":"若抽薪止沸，剪草除根。","book":"《左传·隐公六年》：“为国家者，见恶如农夫之务去草焉，芟夷蕰崇之，绝其本根，勿使能殖，则善者信矣。”北齐·魏收《为侯景叛移梁朝文》"},"example":{"text":"～，萌芽不发；斩草若不除根，春至萌芽再发。","book":"明·冯梦龙《警世通言》卷三十七"},"similar":["剪草除根","削株掘根"],"opposite":["放虎归山","养痈贻患"],"usage":"作谓语、宾语；指彻底成事","story":["隐公六年，卫国与陈国联合伐郑，郑庄公请求陈桓公讲和，陈桓公不答应。两年后，郑国强大起来，派兵侵袭陈国，大败陈军，邻国坐视不救，纷纷议论这是陈国自讨苦吃，长期做恶的报应，对待恶事应该斩草除根，才能消除后患"]},{"id":23491,"word":"斩蛇逐鹿","pinyin":"zhǎn shé zhú lù","abbr":"zszl","explanation":"斩杀蛇，追逐鹿。比喻群雄角逐，争权夺势。","source":{"text":"秦失其鹿，天下共逐之，于是高材疾足者先得焉。","book":"《史记·高祖纪》：“乃前，拔剑击斩蛇。”《史记·淮阴侯列传》"},"example":{"text":"风尘暗四郊，奋英豪，～谁能料？（明·张凤翼《红拂记·揭果》）"},"usage":"作宾语、定语；用于书面语"},{"id":23492,"word":"斩钉切铁","pinyin":"zhǎn dīng qiē tiě","abbr":"zdqt","explanation":"比喻坚定不移或果断利落。亦比喻雄健有力。同“斩钉截铁”。","source":{"text":"又是一声‘不许动！’那么斩钉切铁，比前几次严厉多了。","book":"李劼人《大波》第三部第一章"},"example":{"text":"‘要是他不理你呢？’‘你也不理他。’邓秀梅～地干脆回说。","book":"周立波《山乡巨变》上三"},"similar":["斩钉截铁","斩钢截铁"],"opposite":["拖泥带水"],"usage":"作定语、状语；指干脆"},{"id":23493,"word":"斩钉截铁","pinyin":"zhǎn dīng jié tiě","abbr":"zdjt","explanation":"形容说话或行动坚决果断，毫不犹豫。","source":{"text":"君来惟是孟子说得斩钉截铁。","book":"宋·释道原《景德传灯录》卷十七：“师谓众曰：‘学佛法底人如斩钉截铁始得时。’”《朱子全书·孟子》"},"example":{"text":"我喜欢那种～的作风。"},"similar":["斩钢截铁","斩钉切铁"],"opposite":["拖泥带水"],"usage":"作定语、状语；指干脆"},{"id":23494,"word":"斩钢截铁","pinyin":"zhǎn gāng jié tiě","abbr":"zgjt","explanation":"比喻干脆利落，坚决果断。","source":{"text":"邓九公看他作的这等斩钢截铁，心里想到昨日安老爷的话，真是大有见识，暗暗的佩服。","book":"清·文康《儿女英雄传》第十七回"},"example":{"text":"李自成～地说：‘我不亲自去，敬轩不会起义。天下大局，决于此行！’","book":"姚雪垠《李自成》第一卷第十五章"},"similar":["斩钉截铁","斩钉切铁"],"opposite":["拖泥带水"],"usage":"作定语、状语；指干脆"},{"id":23495,"word":"斫方为圆","pinyin":"zhuó fāng wéi yuán","abbr":"zfwy","explanation":"把方的东西砍削成圆的。比喻人变方正为圆滑。","source":{"text":"挠直为曲，斫方为圆，秽素丝之洁，推亮直之心。","book":"汉·荀悦《汉纪·成帝纪二》"},"usage":"作谓语、定语；用于书面语"},{"id":23496,"word":"斫琱为朴","pinyin":"zhuó diāo wéi pǔ","abbr":"zdwp","explanation":"指去掉雕饰，崇尚质朴。亦指斫理雕弊之俗，使返质朴。同“斫雕为朴”。","source":{"text":"汉兴，破觚而为圜，斫琱而为朴，号为罔漏吞舟之鱼。","book":"《汉书·酷吏传·序》"}},{"id":23497,"word":"斫轮老手","pinyin":"zhuó lún lǎo shǒu","abbr":"zlls","explanation":"斫轮：斫木制造车轮。指对某种事情经验丰富的人。","source":{"text":"是以行年七十而老斫轮。","book":"《庄子·天道》"},"example":{"text":"两人不来多嘴，全凭那～徐世昌及倚马长才王式通悉心研究。","book":"蔡东藩、许廑父《民国通俗演义》第六十七回"},"usage":"作主语、宾语、定语；用于夸奖人"},{"id":23498,"word":"斫雕为朴","pinyin":"zhuó diāo wéi pǔ","abbr":"zdwp","explanation":"指去掉雕饰，崇尚质朴。亦指斫理雕弊之俗，使返质朴。","source":{"text":"汉兴，破觚而为圜，斫雕而为朴。","book":"《史记·酷吏列传》"},"example":{"text":"解而更手，～，自非可以奉粢盛，修黻冕习礼乐之容，缮甲兵之备，此外众费一皆禁绝。","book":"南朝·梁·任昉《为梁武帝禁奢令》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":23499,"word":"断乎不可","pinyin":"duàn hū bù kě","abbr":"dhbk","explanation":"断乎：果断的样子；可：可以，能够。指坚决或绝对不能。","source":{"text":"如何扫除？万万不能，也断乎不可！","book":"鲁迅《随感录》"},"similar":["断然不可"],"usage":"作谓语、定语；用于处事"},{"id":23500,"word":"断事以理","pinyin":"duān shì yǐ lǐ","abbr":"dsyl","explanation":"断：判断。根据道理来判断事情的是非曲直。","source":{"text":"陈义设法，断事以理。","book":"《管子·版法解》"},"usage":"作谓语、宾语；用于处事"},{"id":23501,"word":"断事如神","pinyin":"duàn shì rú shén","abbr":"dsrs","explanation":"断：判断。形容判断事情非常准确。","source":{"text":"先生真是断事如神！但是照这个断法，在我是别人的事，在先生只怕是自己的事呢。","book":"清·吴趼人《二十年目睹之怪现状》第34回"},"example":{"text":"他一向～，我们不必担心。"},"similar":["料事如神"],"usage":"作谓语、宾语、定语；指分析问题很准"},{"id":23502,"word":"断井颓垣","pinyin":"duàn jǐng tuí yuán","abbr":"djty","explanation":"井：指井栏；垣：短墙。断了的井栏，倒塌的短墙。形容庭院破败的景象。","source":{"text":"原来姹紫嫣红开遍，似这般都付与断井颓垣。","book":"明·汤显祖《牡丹亭》第十出"},"example":{"text":"但系～，夸苔砌草，却怎便零落到这般田地呀！","book":"清·梁启超《新罗马·吊古》"},"similar":["断垣残壁"],"usage":"作宾语、定语；形容庭院破败的景象"},{"id":23503,"word":"断决如流","pinyin":"duàn jué rú liú","abbr":"djrl","explanation":"如流 ：像流水一样多而迅速。决断事务多而快。","source":{"text":"彦在尚书十有五载，，属军国草创，庶务殷繁，留心省阅，未尝懈怠，断决如流，略无疑滞。","book":"《周书·李彦传》"},"example":{"text":"每视事，自旦至暮，或通夕，～，无有凝滞，当时称为能吏。","book":"《宋史·杨克让传》"},"similar":["决断如流"],"usage":"作谓语、定语；指处事果断"},{"id":23504,"word":"断凫续鹤","pinyin":"duàn fú xù hè","abbr":"dfxh","explanation":"凫：野鸭；续：接续；鹤：仙鹤。截断野鸭的短腿接到仙鹤的长腿。比喻做事违反自然规律。","source":{"text":"今我国于此种机关，百不一具，而惟断凫续鹤，欲袭取其企业之形式以移植于我国，是以格格而不入也。","book":"梁启超《政闻时言·外债平议》"},"similar":["断鹤续凫"],"usage":"作谓语、定语；比喻行事违反自然规律"},{"id":23505,"word":"断发文身","pinyin":"duàn fà wén shēn","abbr":"dfws","explanation":"剪短头发，身上刺着花纹。是古代某些民族的风俗。","source":{"text":"东方曰夷，被发文身，有不火食者矣。","book":"《左传·哀公七年》：“大伯端委以治周礼，仲雍嗣之，断发文身，祼以为饰，岂礼也哉。”《礼记·王制》"},"example":{"text":"太伯仲雍，王德之仁。行施百世，～。","book":"汉·曹操《善哉行》诗"},"similar":["断发纹身"],"usage":"作谓语、定语；用于人的装束"},{"id":23506,"word":"断发纹身","pinyin":"duàn fā wén shēn","abbr":"dfws","explanation":"剪短头发，身上刺着花纹。是古代某些民族的风俗。同“断发文身”。","source":{"text":"在吴越的边境上还有许多野人，他们是断发纹身的。","book":"冯至《伍子胥》九"},"similar":["断发文身"],"usage":"作谓语、定语；用于人的装束"},{"id":23507,"word":"断发请战","pinyin":"duàn fà qǐng zhàn","abbr":"dfqz","explanation":"断：割断。割下头发，请求出战。旧时指将士急于出征，士气高昂。","source":{"text":"合战良久，霸军中将士路润等数十人断发请战。","book":"《后汉书·王霸传》"}},{"id":23508,"word":"断圭碎璧","pinyin":"duàn guī suì bì","abbr":"dgsb","explanation":"圭：古代帝王诸侯举行礼仪时所用的玉器；璧：璧玉。残缺不全的圭宝和璧玉。比喻残缺不全而又珍贵的文字。","source":{"text":"虽寂寥片言，断圭碎璧，犹可宝也。","book":"宋·王应麟《困学纪闻·仪礼》"},"example":{"text":"余近得拓本，字虽漫漶，其存者尚有神采。～，弥见珍奇。","book":"清·叶廷琯《吹网录·二础去麾碑》"},"similar":["断缣零璧","断珪缺璧"],"usage":"作宾语、定语；用于比喻句"},{"id":23509,"word":"断垣残壁","pinyin":"duàn yuán cán bì","abbr":"dycb","explanation":"形容房屋倒塌残破的景象。","source":{"text":"灰红的火焰渐渐熄灭，留下一片瓦砾场，断垣残壁。","book":"徐迟《火中的凤凰》"},"example":{"text":"地震后的城市到处都是～。"},"similar":["断井颓垣"],"usage":"作宾语、定语；形容残破的景象"},{"id":23510,"word":"断墨残楮","pinyin":"duàn mò cán chǔ","abbr":"dmcc","explanation":"指残缺不全的典籍。","source":{"text":"子中独能寻考遗则于断墨残楮，遂与仲温并驱。","book":"明·王世贞《题俞紫芝急救章》"},"similar":["断简残编"],"usage":"作宾语、定语；指残缺不全的典籍"},{"id":23511,"word":"断壁残垣","pinyin":"duàn bì cán yuán","abbr":"dbcy","explanation":"残垣：倒了的短墙。残存和坍塌了的墙壁。形容残败的景象。","source":{"text":"几年后，秦始皇驾崩，秦二世登极。朱贤始得返回家乡。可家里人不见，唯剩一片断壁残垣。","book":"《新民晚报》1987.2.8"},"example":{"text":"面对这～，他感慨万分。"},"similar":["断壁颓垣"],"usage":"作宾语、定语；指残破"},{"id":23512,"word":"断壁残璋","pinyin":"duàn bì cán zhāng","abbr":"dbcz","explanation":"壁：圆形扁平中间有孔的玉器；璋：象半个圭的玉器。残缺不全的璋壁。比喻虽然残缺仍然是很珍贵的东西。","source":{"text":"蛮珍分到谪仙家，断壁残璋裹绛纱。","book":"宋·孙觌《李茂嘉寄茶》"}},{"id":23513,"word":"断壁颓垣","pinyin":"duàn bì tuí yuán","abbr":"dbty","explanation":"颓垣：倒了的矮墙。坍塌的墙壁，残毁的矮墙。形容残败的景象。","source":{"text":"走到也是园滨文述农门首，抬头一看，只见断壁颓垣，荒凉满目，看那光景是被火烧的。","book":"清·吴趼人《二十年目睹之怪现状》第一百八回"},"example":{"text":"便是屈服了的奴隶也只得栖息在～下面，他们有的那一点东西也给高国兵士拿走了。","book":"巴金《海的梦》三"},"similar":["断壁残垣"],"usage":"作宾语、定语；指残破的景象"},{"id":23514,"word":"断头将军","pinyin":"duàn tóu jiāng jūn","abbr":"dtjj","explanation":"比喻坚决抵抗，宁死不屈的将领。","source":{"text":"卿等无状，侵夺我州，我州但有断头将军，无有降将军也。","book":"《三国志·蜀书·张飞传》"},"example":{"text":"大小三军都来看～呀！（清·孔尚任《桃花扇·劫宝》）"},"usage":"作宾语、定语；形容英雄","story":["东汉末年，刘备取得荆州以后，担心曹操进犯，就听从诸葛亮与庞统的建议，向四川进军。刘璋担心曹操进犯，就给了刘备一些钱粮，让他据守益州抗曹。刘备派张飞进兵成都，在巴郡活捉太守严颜。严颜拒不投降说：只有断头将军，没有投降将军"]},{"id":23515,"word":"断子绝孙","pinyin":"duàn zǐ jué sūn","abbr":"dzjs","explanation":"没有儿子，也没有孙子。指没有后代。","source":{"text":"你再不娶亲，我只愁你断子绝孙谁拜坟。","book":"元·柯丹邱《荆钗记·执柯》"},"example":{"text":"‘～的阿Q！’远远地听得小尼姑的带哭的声音。","book":"鲁迅《呐喊·阿Q正传》"},"similar":["后继无人","孤家寡人"],"opposite":["后继有人","承欢膝下","子孙满堂"],"usage":"作谓语、定语、宾语；多用于诅咒语"},{"id":23516,"word":"断尾雄鸡","pinyin":"duàn wěi xióng jī","abbr":"dwxj","explanation":"断尾：断去尾巴。雄鸡因怕做祭祀的贡品而自残其身。比喻人怕被杀而自尽或装傻。","source":{"text":"断尾雄鸡本畏烹，年来听法伴修行。","book":"宋·苏轼《僧爽白鸡》"},"similar":["雄鸡断尾"],"usage":"作宾语、定语；指装疯卖傻"},{"id":23517,"word":"断幅残纸","pinyin":"duàn fú cán zhǐ","abbr":"dfcz","explanation":"幅：指小笺。指残留或星散的写有诗文墨迹的小幅纸。","source":{"text":"故当时名臣碑刻，往往得其书则夸以为荣，至于文稿，断幅残纸争传之。","book":"宋·赵佶《宣和画谱·行书三·吴通玄》"},"usage":"作宾语、定语；用于文章等"},{"id":23518,"word":"断弦再续","pinyin":"duàn xián zài xù","abbr":"dxzx","explanation":"断弦：指丧妻。指男子丧妻后再娶。也用以比喻夫妻离散后得以重聚。","source":{"text":"二人缺月重圆，断弦再续，大喜不胜。","book":"明·熊龙峰《四种小说·张生彩鸾灯传》"},"usage":"作谓语、宾语、定语；指男子再娶"},{"id":23519,"word":"断怪除妖","pinyin":"duàn guài chú yāo","abbr":"dgcy","explanation":"指铲除妖魔鬼怪。","source":{"text":"我我我，仗神锋断怪除妖，是是是，赁道法驱邪斩虎。","book":"明·无名氏《大破蚩尤》第二折"},"example":{"text":"据着他～，我道来恰便似班门弄斧。","book":"明·无名氏《锁白猿》第三折"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":23520,"word":"断恶修善","pinyin":"duàn è xiū shàn","abbr":"dexs","explanation":"断：断绝；恶：坏事；修：候行。断绝坏事，修行善业，做好事。","source":{"text":"明王四弘愿天：见我身者发菩提心，闻吾名者断恶修善，闻我说者得大智慧，知我心者即成佛。","book":"《胜军明王四十八使者秘密成就仪轨》"}},{"id":23521,"word":"断手续玉","pinyin":"duān shóu xù yù","abbr":"dsxy","explanation":"断：砍下；续：接上。砍下手来再接上一块玉。比喻得不偿失。","source":{"text":"不察私门之内，轻虑重事，厚德迫祸，是断手而续以玉也，故世有易身之祸。","book":"《韩非子·用人》"},"usage":"作宾语、定语；用于处事"},{"id":23522,"word":"断断休休","pinyin":"duàn duàn xiū xiū","abbr":"ddxx","explanation":"断断：专诚守一。专诚守一，快乐和善的样子。","source":{"text":"如有一介臣，断断猗，无他伎，其心休休焉，其如有容。","book":"《尚书·秦誓》"},"example":{"text":"使归子而得志，所谓～，其人与。","book":"明·高攀龙《陶庵先生传》"}},{"id":23523,"word":"断断继继","pinyin":"duàn duàn jì jì","abbr":"ddjj","explanation":"时断时续，断断续续。","source":{"text":"到了四更，又是一声狂雨直打入纱窗来，一会尚有那断断继继的檐漏，不想醒来，却是红日上窗，天早开霁。","book":"清·魏子安《花月痕》第十八回"}},{"id":23524,"word":"断断续续","pinyin":"duàn duàn xù xù","abbr":"ddxx","explanation":"时断时续地接连下去。","source":{"text":"而且所收到的印本断断续续，也提不起兴趣来。","book":"鲁迅《致台静农》"},"example":{"text":"我实在忍不住打断她～的谈话。"},"similar":["时断时续"],"opposite":["连续不断"],"usage":"作谓语、定语；指不连贯"},{"id":23525,"word":"断无此理","pinyin":"duàn wú cǐ lǐ","abbr":"dwcl","explanation":"断：绝对，一定。绝对没有这样的道理。","source":{"text":"一个少年妇女，独自在外，又无同伴，靠卖诗文过日子，恐怕世上断无此理。","book":"清·吴敬梓《儒林外史》第41回"},"example":{"text":"让你亲自来送我，真是～。"},"similar":["岂有此理"],"usage":"作谓语；指肯定没有这样的道理"},{"id":23526,"word":"断木掘地","pinyin":"duàn mù jué dì","abbr":"dmjd","explanation":"上古时代，断木为杵，掘地为臼。虽粗拙，亦适用。","source":{"text":"掘地与断木，智不如机春。","book":"语出《易·系辞下》。宋·黄庭坚《题王黄州墨迹后》诗"},"example":{"text":"尝观孔融《肉刑论》云：贤者所制，或逾圣人，水碓之巧，胜于～。","book":"宋·王应麟《困学纪闻·评诗》"},"usage":"作宾语、定语；用于比喻句"},{"id":23527,"word":"断杼择邻","pinyin":"duàn zhù zé lín","abbr":"dzzl","explanation":"孟母为了教育孟子不要中途荒废学业，用被割断的纱不成布来做比喻；孟母三迁居处，选择良好的环境，来影响孟子的成长。","source":{"text":"孟子之少也，既学而归，孟母方绩，问曰：‘学何所至矣？’孟子曰：‘自若也。’孟母以刀断其织。孟子惧而问其故，孟母曰：‘子之学，若吾断斯织也。’","book":"汉·刘向《列女传·母仪传》"},"usage":"作宾语、定语；用于教育","story":["战国时期，孟子小时候非常聪明，经常模仿送葬人吹喇叭，孟母担心他荒废学业就把家搬到城里，刚好旁边是一个屠宰场，孟子很快就学会了杀猪宰羊，孟母只好搬家到一个学校附近，从此孟子就开始学习孔子的思想而成为一代思想家"]},{"id":23528,"word":"断根绝种","pinyin":"duàn gēn jué zhǒng","abbr":"dgjz","explanation":"断绝后代，即断子绝孙。","source":{"text":"真人甲乙，上帝已徵，身佩玉符丹文金章，列名元图，三欲已忘，元始符命，斩灭尸形，断根绝种，勿得飞扬。","book":"宋·张君房《云笈七签》第81卷"},"example":{"text":"防止～的思想还在左右大多数人。"},"similar":["断子绝孙"],"opposite":["儿孙满堂"],"usage":"作谓语、定语；指没有后代"},{"id":23529,"word":"断梗流萍","pinyin":"duàn gěng liú píng","abbr":"dglp","explanation":"梗：植物的枝茎；萍：浮萍。像枯折的枝茎，漂流的浮萍一样。比喻生活飘泊不定。","source":{"text":"人生百龄同臂伸，断梗流萍暂相亲。","book":"宋·秦观《别贾耘老》诗"},"similar":["断梗浮萍","断梗飘萍"],"usage":"作宾语、定语；指生活不固定"},{"id":23530,"word":"断梗浮萍","pinyin":"duàn gěng fú píng","abbr":"dgfp","explanation":"比喻漂泊不定。","source":{"text":"人生百龄同臂伸，断梗浮萍暂相亲。","book":"宋·秦观《别贾耘老》诗"},"example":{"text":"白小姐道：‘苏郎～，一去杳然，似不以我为念。’","book":"《玉娇梨》第十六回"},"similar":["断梗飘萍","断梗飞蓬"],"usage":"作宾语、定语；指生活不固定"},{"id":23531,"word":"断梗飘萍","pinyin":"duàn gěng piāo píng","abbr":"dgpp","explanation":"比喻漂泊不定。同“断梗浮萍”。","source":{"text":"想归海楼船未有期，梦与飘风会，似断梗飘萍谁可系。","book":"明·梅鼎祚《玉合记·祝发》"},"similar":["断梗流萍","断梗浮萍"],"usage":"作宾语、定语；指生活不固定"},{"id":23532,"word":"断梗飘蓬","pinyin":"duàn gěng piāo péng","abbr":"dgpp","explanation":"梗：植物的枝茎；蓬：蓬蒿，遇风常吹折离根，飞转不已。如同折断的枝茎，飘飞的蓬蒿一般。形容人东奔西走，生活不固定。","source":{"text":"自怜俗状尘容，几年断梗飘蓬。","book":"宋·石孝友《清平乐》词"},"example":{"text":"一个世家千金小姐，弄得一生伶仃孤苦，有如～，生死存亡，竟难预定。","book":"清·文康《儿女英雄传》第二十二回"},"similar":["漂泊不定","萍踪浪迹"],"opposite":["安家乐业"],"usage":"作宾语、定语；指生活不固定"},{"id":23533,"word":"断梗飞蓬","pinyin":"duàn gěng fēi péng","abbr":"dgfp","explanation":"如同折断的枝茎，飘飞的蓬蒿一般。形容人东奔西走，生活不固定。同“断梗飘蓬”。","source":{"text":"飘零随处是生涯，断梗飞蓬但可嗟。","book":"宋·陆游《拆号前一日作》诗"},"similar":["断梗飘蓬"],"usage":"作宾语、定语；指生活不固定"},{"id":23534,"word":"断港绝潢","pinyin":"duàn gǎng jué huáng","abbr":"dgjh","explanation":"潢：低洼的积水坑。无法通行的水路。比喻错误的，不可能达到目的的办法。","source":{"text":"道于杨、墨、老、庄、佛之学，而欲之圣人之道，犹航断港绝潢，以望至于海也。","book":"唐·韩愈《送王秀才序》"},"similar":["断潢绝港"],"usage":"作宾语、定语；用于书面语"},{"id":23535,"word":"断潢绝港","pinyin":"duàn huáng jué gǎng","abbr":"dhjg","explanation":"潢：低洼的水坑；港：与江河相通的小河。比喻错误的无法达到的目的地的道路。","source":{"text":"虽日諰諰以求其合，必如断潢绝港，其何由达其流而究其源哉！","book":"元·贡师泰《玩斋集·送宗人贡仲归丹阳序》"},"similar":["断港绝潢"],"usage":"作宾语、定语；用于书面语"},{"id":23536,"word":"断烂朝报","pinyin":"duàn làn cháo bào","abbr":"dlcb","explanation":"断烂：形容陈腐杂乱；朝报：古代传抄皇帝诏令和官员奏章之类的文件。指陈旧、残缺，没有参考价值的历史记载。","source":{"text":"黜《春秋》之书，不使列于学官，至戏目为断烂朝报。","book":"《宋史·王安石传》"},"example":{"text":"真令人莫名其妙。无怪朱子疑心他不可解，王安石蔑视他为～，要束诸高阁了。","book":"清·曾朴《孽海花》第三十四回"},"opposite":["典册高文"],"usage":"作宾语、定语；指无用的资料"},{"id":23537,"word":"断然不可","pinyin":"duàn rán bù kě","abbr":"drbk","explanation":"断然：坚决果断的样子；可：可以，能够。指坚决或绝对不能。","source":{"text":"景清道：‘贤侄，此事断然不可。’","book":"明·冯梦龙《警世通言》第21卷"},"example":{"text":"苟乘于理、事、情，是谓不通，不通则杜撰，杜撰则～。","book":"清·叶燮《原诗·外篇》"},"similar":["断乎不可"],"usage":"作谓语、定语；用于处事"},{"id":23538,"word":"断然处置","pinyin":"duàn rán chǔ zhì","abbr":"drcz","explanation":"断然：坚决，果断。坚决果断地处理。","source":{"text":"大敌当前，只能断然处置。","book":"罗广斌、杨益言《红岩》第八章"},"similar":["断然措施"],"usage":"作谓语、宾语、定语；指解决办法"},{"id":23539,"word":"断然措施","pinyin":"duàn rán cuò shī","abbr":"drcs","explanation":"断然：果断坚决。坚决果断的解决方法。","source":{"text":"必要时，将采取断然措施，严厉处置害群之马！","book":"罗广斌《红岩》第17章"},"example":{"text":"我们得尽快采取～。"},"similar":["断然处置"],"usage":"作宾语、定语；指解决办法"},{"id":23540,"word":"断珪缺璧","pinyin":"duàn guī quē bì","abbr":"dgqb","explanation":"喻指片段而珍贵的文字。同“断圭碎璧”。","source":{"text":"余近得拓本，字虽漫漶，其存者尚有神采。断珪缺璧，弥见珍奇。","book":"清·叶廷琯《吹网录·二础云麾碑》"},"similar":["断圭碎璧"],"usage":"作宾语、定语；用于比喻句"},{"id":23541,"word":"断璧残璋","pinyin":"duàn bì cán zhāng","abbr":"dbcz","explanation":"璧：圆形扁平中间有孔的玉器；璋：像半个圭的玉器。残缺不全的璋璧。比喻虽然残缺仍然是很珍贵的东西。","source":{"text":"蛮珍分到谪仙家，断璧残璋裹绛纱。","book":"宋·孙觌《李茂嘉寄茶》"},"usage":"作宾语、定语；多用于比喻句"},{"id":23542,"word":"断瓦残垣","pinyin":"duàn wǎ cán yuán","abbr":"dwcy","explanation":"形容建筑物倒塌残破的景象。","example":{"text":"地震过后，到处是～的景象。"},"similar":["残垣断壁"],"usage":"作宾语、定语；指残破的景象"},{"id":23543,"word":"断章取义","pinyin":"duàn zhāng qǔ yì","abbr":"dzqy","explanation":"断：截断；章：音乐一曲为一章。指不顾全篇文章或谈话的内容，孤立地取其中的一段或一句的意思。指引用与原意不符。","source":{"text":"赋诗断章，余取所求焉。","book":"《左传·襄公二十八年》"},"example":{"text":"宋人攻击王介甫，说他将明妃写成一个不忠君不爱国的人，其实是～，故入人罪。","book":"朱自清《清华的一日》"},"similar":["望文生义","穿凿附会"],"opposite":["实事求是"],"usage":"作宾语、定语、状语；指歪曲原意","story":["春秋后期，崔杼和庆封杀死齐庄公，拥立齐景公杵舀。庄公的卫士卢薄癸和王何外逃他国。卢的弟弟卢薄弊悄悄取得庆封的信任，用计除掉崔杼一家，并把自己的妻子进献给庆封，他找回卢薄癸及王何，成功杀死庆封一家为庄公报仇"]},{"id":23544,"word":"断章取意","pinyin":"duàn zhāng qǔ yì","abbr":"dzqy","explanation":"断：割断；章：文章。指不顾全文或原话上下前后的联系，孤立地取其中的一部分，从而歪曲原意","source":{"text":"断章取意，唯须得情，若不惬当，罪有科罚。","book":"唐·张鷟《游仙窟》"},"example":{"text":"清·曹雪芹《红楼梦》第56回：“如今只～，念出底下一句，我自己骂我自己不成？”"},"similar":["断章取义"],"usage":"作宾语、定语、状语；指歪曲原意"},{"id":23545,"word":"断章截句","pinyin":"duàn zhāng jié jù","abbr":"dzjj","explanation":"不顾上下文义，截取文章的一段或一句，而弯曲原意。断、截：割裂。","source":{"text":"断章截句，破坏义理。","book":"《宋史·选举志二》"},"similar":["断章摘句"],"usage":"作谓语、定语；指抄袭"},{"id":23546,"word":"断章摘句","pinyin":"duàn zhāng zhāi jù","abbr":"dzzj","explanation":"裁断章节，取缀成文。亦有割裂全文，取其所需之意。","source":{"text":"断章摘句，如娠如生。","book":"唐·李商隐《唐容州经略使后序》"},"example":{"text":"写作文不能把别人的文章～抄袭成文。"},"similar":["断章截句"],"usage":"作谓语、定语；指抄袭"},{"id":23547,"word":"断竹续竹","pinyin":"duàn zhú xù zhú","abbr":"dzxz","explanation":"指砍竹作弓矢。","source":{"text":"故歌曰：‘断竹续竹，飞土逐肉’之谓也。","book":"先秦·无名氏《弹歌》：“断竹续竹。飞土逐宍。”汉·赵晔《吴越春秋·勾践阴谋外传》"}},{"id":23548,"word":"断简残编","pinyin":"duàn jiǎn cán biān","abbr":"djcb","explanation":"简：古代用来写字的竹片；编：穿简的细长皮条。指残缺不全的书籍。","source":{"text":"北周·庚信《谢滕王集序启》：“某本乏财用，无多作述……至如残编落简，并入尘埃；赤轴青箱，多从灰烬。"},"example":{"text":"～中虽有一二歌诀，亦不祥其说。","book":"清·李汝珍《镜花缘》第九十五回"},"similar":["片纸只字","片言之语"],"opposite":["长篇大论","连篇累牍"],"usage":"作主语、宾语；指残缺的书"},{"id":23549,"word":"断简遗编","pinyin":"duàn jiǎn yí biān","abbr":"djyb","explanation":"简：古时用以书写的竹片。编：穿简的皮条。指残缺不全的古籍。","source":{"text":"青箱有意终须续，断简遗编一半通。","book":"唐·陆龟蒙《药名离合夏日即事三首》诗之三"}},{"id":23550,"word":"断管残沈","pinyin":"duàn guǎn cán shěn","abbr":"dgcs","explanation":"残缺不全的字画。管，笔；沈，墨汁。","source":{"text":"宋元丰间，禁长公之笔墨，家藏墨妙，抄割殆尽，见者若祟。不逾时而征求鼎沸，断管残沈，等于吉光片羽。","book":"明·焦竑《李氏〈焚书〉序》"},"usage":"作宾语、定语；指残缺的东西"},{"id":23551,"word":"断管残渖","pinyin":"duàn guǎn cán shěn","abbr":"dgcs","explanation":"残缺不全的字画。管，笔；渖，墨汁。"},{"id":23552,"word":"断纸余墨","pinyin":"duàn zhǐ yú mò","abbr":"dzym","explanation":"断、余：残存的。零星或残存的墨迹。","source":{"text":"彩鸾以书《唐韵》名于时，至今断纸余墨，人传宝之。","book":"宋·赵舍《宣和画谱·行书六·詹鸾》"},"example":{"text":"古代的～真迹现在可价值连城"},"usage":"作宾语、定语；指残存的文稿等"},{"id":23553,"word":"断纸馀墨","pinyin":"duàn zhǐ yú mò","abbr":"dzym","explanation":"零星或残存的墨迹。","source":{"text":"彩鸾以书《唐韵》名于时，至今断纸馀墨，人传宝之。","book":"《宣和书·詹鸾》"},"example":{"text":"至于～，人争宝焉。","book":"《蔡京》"}},{"id":23554,"word":"断线偶戏","pinyin":"duàn xiàn ǒu xì","abbr":"dxox","explanation":"像断了线的木偶，不能动弹。","source":{"text":"犹如断线偶戏，手足掸软，连话都无了。","book":"明·冯梦龙《醒世恒言》卷六"},"usage":"作宾语、定语；多用于比喻句"},{"id":23555,"word":"断线珍珠","pinyin":"duàn xiàn zhēn zhū","abbr":"dxzz","explanation":"比喻眼泪像断了线的珍珠一般纷纷落下。","source":{"text":"泪痕流，滴破芙蓉面，却似珍珠断线头。","book":"元·关汉卿《仙吕·桂枝香》"},"example":{"text":"却一字说不出，那眼泪一似～一般，只将一只手回过去指着黛玉。","book":"清·曹雪芹《红楼梦》第九十七回"}},{"id":23556,"word":"断线风筝","pinyin":"duàn xiàn fēng zhēng","abbr":"dxfz","explanation":"象放上天断了线的风筝一样。比喻一去不回来的人或东西。","source":{"text":"掴着手分开云雨，腾的似线断风筝。","book":"元·关汉卿《金线池》第三折"},"example":{"text":"去了多时，约摸四更天气，却似石沉沧海，～，不见回来。","book":"明·冯梦龙《醒世恒言》卷二十一"},"similar":["一去不返","断线鹞子"],"usage":"作宾语、定语；比喻不回来的事物"},{"id":23557,"word":"断线鹞子","pinyin":"duàn xiàn yào zǐ","abbr":"dxyz","explanation":"犹言断线风筝。鹞子，指纸鸢，鸟形风筝。","source":{"text":"若是这厮识局知趣，见机而作，恰是断线鹞子，一般再也不来，落得先前受用一番，且又完名全节。","book":"《醒世恒言·勘皮靴单证二郎神》"},"similar":["断线风筝"],"usage":"作宾语、定语；比喻不回来的事物"},{"id":23558,"word":"断织之诫","pinyin":"duàn zhī zhī jiè","abbr":"dzzj","explanation":"孟子的母亲用割断织布机上的纱，使机上的纱不能成布的损失来告诫中途放弃学业的儿子。后用这个故事告诫中途辍学的人。","source":{"text":"孟子之少也，既学而归，孟母方绩，问曰：‘学何所至矣？’孟子曰：‘自若也。’孟母以刀断其织。孟子惧而问其故，孟母曰：‘子之学，若吾断斯织也。’","book":"汉·刘向《列女传·母仪传》"},"usage":"作宾语；用于劝诫人"},{"id":23559,"word":"断织劝学","pinyin":"duàn zhī quàn xué","abbr":"dzqx","explanation":"原指东汉时乐羊子妻借切断织机上的线，来讽喻丈夫不可中途废学。后比喻劝勉学习。","source":{"text":"远寻师，一年来归，妻跪问其故，羊子曰：‘久行怀思，无它异也。’妻乃引刀趋机而言曰：‘……，今若断斯织也，则损失成功，……，若中道而归，何异断斯织乎？’","book":"《后汉书：乐羊子妻传》载"},"usage":"作谓语、宾语、定语；用于劝诫人","story":["东汉时期，书生乐羊子一次拾到一块金子回家交给妻子，妻子告诫他不要贪图意外之财。他从那以后就外出求学，一年后回家不想再去，妻子用剪刀剪织布机上的绸子来打比方，希望他要持之以恒，不能前功尽弃。他坚持了七年终于学成归来"]},{"id":23560,"word":"断编残简","pinyin":"duàn biān cán jiǎn","abbr":"dbcj","explanation":"编：穿简的细长皮条；简：古代用来写字的竹片。指残缺不全的书籍文章。","source":{"text":"身入群径作蠹鱼，断编残简伴闲居。","book":"宋·黄庭坚《读书呈几复》"},"example":{"text":"金石遗文，～，一切掇拾。","book":"《宋史·欧阳修传》"},"similar":["断简残编"],"usage":"作宾语、定语；指残缺不全的书籍文章"},{"id":23561,"word":"断缣寸纸","pinyin":"duàn jiān cùn zhǐ","abbr":"djcz","explanation":"指残缺不全的书画。","source":{"text":"收藏古画，往往断缣寸纸，皆可珍惜。","book":"宋·邓椿《画继》卷一"},"similar":["断缣尺楮"],"usage":"作宾语、定语；用于书画等"},{"id":23562,"word":"断缣尺楮","pinyin":"duàn jiān chǐ chǔ","abbr":"djcc","explanation":"断缣：残缺不全的画幅；楮：纸。指残缺不全的书画。","source":{"text":"收藏古画，往往断缣寸纸，皆可珍惜。","book":"宋·邓椿《画继》卷一"},"example":{"text":"今人间往往有其所画梅花，～，人争宝之，多元章自画所题其上。","book":"明·叶盛《水东日记·王元章画梅》"},"similar":["断缣寸纸"],"usage":"作宾语、定语；用于书画等"},{"id":23563,"word":"断缣零璧","pinyin":"duàn jiān líng bì","abbr":"djlb","explanation":"比喻片段而珍贵的文字。","source":{"text":"辛亥以后，会面甚稀，今得于断缣零璧中温其绪论，斯诚光绪以来读书明理之君子矣。","book":"叶景葵《〈忘山庐日记〉序》"},"similar":["断圭碎璧"],"usage":"作宾语、定语；用于文字等"},{"id":23564,"word":"断羽绝鳞","pinyin":"duàn yǔ jué lín","abbr":"dyjl","explanation":"断绝书信。羽鳞，犹鱼雁。","source":{"text":"因科举离乡半春，从别后断羽绝鳞。今日天教遇你们，趁良使附归音信。","book":"元·柯丹邱《荆钗记·套书》"},"usage":"作谓语、定语；指断绝音信等"},{"id":23565,"word":"断而敢行","pinyin":"duàn ér gǎn xíng","abbr":"degx","explanation":"断：果断。果断而敢于行动。","source":{"text":"顾汪而忘大，后必有善；狐疑犹豫，后必有悔；断而敢行，鬼神避之，后有成功。","book":"《史记·李斯列传》"}},{"id":23566,"word":"断脰决腹","pinyin":"duàn dòu jué fù","abbr":"ddjf","explanation":"脰：颈；决：破。杀掉头，剖开腹。形容惨烈的死难。","source":{"text":"有断脰决腹，一瞑而万世不视，不知所益，以忧社稷者。","book":"西汉·刘向《战国策·楚策一》"},"example":{"text":"及其亡也，一二孤忠间出，～，一瞑而万世不视。","book":"清·戴名世《王养正传》"},"usage":"作谓语；形容惨烈而死"},{"id":23567,"word":"断臂燃身","pinyin":"duàn bì rán shēn","abbr":"dbrs","explanation":"断臂：砍断手臂。砍断手臂，燃肉身灯。指做事专诚。","source":{"text":"断臂燃身未足夸，何当垂老问年华。","book":"明·李贽《咏古》"}},{"id":23568,"word":"断蛟刺虎","pinyin":"duàn jiāo cì hǔ","abbr":"djch","explanation":"指武艺高强，行为侠义。","source":{"text":"南朝·宋·刘义庆《世说新语·自新》载：相传晋周处曾射蛟杀虎，为民除害。"},"example":{"text":"～好身手，碧瞳如水涵清秋。","book":"元·师严《蔺五见访》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":23569,"word":"断袖之宠","pinyin":"duàn xiù zhī chǒng","abbr":"dxzc","explanation":"断：截断；宠：宠爱，宠幸。指男子搞同性恋的行径，指男宠。","source":{"text":"常与上卧起。尝昼寝，偏藉上袖，上欲起，贤未觉，不欲动贤，乃断袖而起。","book":"东汉·班固《汉书·董贤传》"},"example":{"text":"绍闻每日在碧草轩戏谑调笑，九娃儿居然～。","book":"清·李绿园《歧路灯》第24回"},"similar":["龙阳之兴"],"usage":"作宾语；指男宠"},{"id":23570,"word":"断袖之癖","pinyin":"duàn xiù zhī pǐ","abbr":"dxzp","explanation":"指男子搞同性恋的丑恶行径。","source":{"text":"常与上卧起。尝昼寝，偏藉上袖，上欲起，贤未觉，不欲动贤，乃断袖而起。","book":"《汉书·董贤传》"},"usage":"作宾语；指男同性恋"},{"id":23571,"word":"断袖余桃","pinyin":"duàn xiù yú táo","abbr":"dxyt","explanation":"指男性之间的同性恋。同“断袖之癖”。"},{"id":23572,"word":"断袖分桃","pinyin":"duàn xiù fēn táo","abbr":"dxft","explanation":"借指男宠。","source":{"text":"异日，与君游于果园，食桃而甘，不尽，以其半啖君。","book":"《汉书·董贤传》：“常与上卧起。尝昼寝，偏藉上袖，上欲起，贤未觉，不欲动贤，乃断袖而起。”《韩非子·说难》"},"example":{"text":"其艳而慧者，类为要津所据，～之际，赉以酒赀仕牒，既充功曹，加纳候选。","book":"明·沈德符《万历野获编·小唱》"},"similar":["断袖余桃"],"usage":"作宾语、定语；指男宠"},{"id":23573,"word":"断还归宗","pinyin":"duàn huán guī zōng","abbr":"dhgz","explanation":"指出嫁或被卖的女子由官府判决归还母家。","source":{"text":"如今认定我是你失去的妹子，我认定你是哥哥，两口同声当官去告理，一定断还归宗。","book":"明·凌濛初《初刻拍案惊奇》第二卷"},"usage":"作谓语、定语；用于口语"},{"id":23574,"word":"断送一生惟有酒","pinyin":"duàn sòng yī shēng wéi yǒu jiǔ","abbr":"dsyswyj","explanation":"断送：葬送，消磨。喝酒消磨人的意志，足可以断送人的一生前程。","source":{"text":"断送一生惟有酒，寻思百计不如闲。莫忧世事兼身事，须著人间比梦间。","book":"唐·韩愈《游城南十六首·遣兴》"}},{"id":23575,"word":"断送老头皮","pinyin":"duàn sòng lǎo tóu pí","abbr":"dsltp","explanation":"断送了老头的性命。借指被官事所束缚，不能自由自在地生活。","source":{"text":"更休落魄耽杯酒，且莫猖狂爱咏诗。今日提将官里去，这回断送老头皮。","book":"宋·苏轼《东坡志林》卷六"},"example":{"text":"戏与山妻谈故事，试吟～。","book":"清·林则徐《赴戍登程口占示家人》"}},{"id":23576,"word":"断金之交","pinyin":"duàn jīn zhī jiāo","abbr":"djzj","explanation":"指情深谊厚的朋友。","source":{"text":"二人同心，其利断金。","book":"《周易·系辞上》"}},{"id":23577,"word":"断金零粉","pinyin":"duàn jīn líng fěn","abbr":"djlf","explanation":"断折的花钿和零散的铅粉。借指因遭横逆而结局不圆满的风流韵事。","source":{"text":"龙华劫换，问何人料理，断金零粉。","book":"清·龚自珍《百字令》词"},"usage":"作宾语、定语；用于比喻句"},{"id":23578,"word":"断钗重合","pinyin":"duàn chāi chóng hé","abbr":"dcch","explanation":"比喻夫妻离散而又重新团聚。也指感情破裂后又重归于好。","source":{"text":"几年间破镜重圆，今日里断钗重合。","book":"元·施惠《幽闺记·洛珠双合》"},"similar":["破镜重圆"],"opposite":["覆水难收"],"usage":"作谓语、宾语、定语；指重新团聚"},{"id":23579,"word":"断长续短","pinyin":"duàn chāng xù duǎn","abbr":"dcxd","explanation":"续：接、补。截断长的来补短的。比喻取别人的长处，来补自己的短处。","source":{"text":"礼者，断长续短，损有余，益不足，达敬爱之文，而滋成行义之美者也。","book":"战国·赵·荀况《荀子·礼论》"},"example":{"text":"今秦地形，～，方数千里，名师数百万。","book":"西汉·刘向《战国策·秦策一》"},"similar":["断长补短"],"usage":"作谓语、宾语；用于学习等"},{"id":23580,"word":"断长补短","pinyin":"duàn chāng bǔ duǎn","abbr":"dcbd","explanation":"截断长的来补短的。比喻取别人的长处，来补自己的短处。","source":{"text":"凡四海之内，断长补短，方三千里，为田八十万亿一万亿亩。","book":"西汉·戴圣《礼记·王制》"},"example":{"text":"～，方数千里，皆尔伯仲，又何加焉！","book":"唐·元稹《授李愿检校司空宣武军节度使制》"},"similar":["取长补短"],"usage":"作谓语、宾语；用于学习等"},{"id":23581,"word":"断雁孤鸿","pinyin":"duàn yàn gū hóng","abbr":"dygh","explanation":"鸿：鸿雁。离了群的孤独大雁。比喻孤身独处，多指未成婚的男子。","source":{"text":"徐生，你一向断雁孤鸿，可曾寻偶否？","book":"明·张凤翼《红拂记·杨公完偶》"},"example":{"text":"他至今未婚，成了～。"},"usage":"作宾语、定语；指未成婚的男子"},{"id":23582,"word":"断雨残云","pinyin":"duàn yǔ cán yún","abbr":"dycy","explanation":"比喻男女的爱情被阻隔或断绝。","source":{"text":"短松明月易陈迹，断雨残云难觅踪。","book":"宋·刘克庄《西楼》诗"},"example":{"text":"孤帏再把重门掩，不堪离恨寄冰弦，～思黯然。","book":"明·徐霖《绣孺记·剔目劝学》"},"usage":"作宾语、定语；用于书面语"},{"id":23583,"word":"断香零玉","pinyin":"duàn xiāng líng yù","abbr":"dxly","explanation":"比喻女子的尸骸。","source":{"text":"这是我断香零玉沉埋处，好结果一场厮耨，空落得薄命留。","book":"清·洪昇《长生殿·尸解》"},"usage":"作宾语、定语；多用于比喻句"},{"id":23584,"word":"断鳌立极","pinyin":"duàn áo lì jí","abbr":"dalj","explanation":"比喻开创新局面，创建伟业，树立最高准则。","source":{"text":"于是女娲炼五色石以补苍天，断鳌足以立四极。","book":"《淮南子·览冥训》"},"example":{"text":"～万万古，争遣起灭如浮沤。","book":"金·元好问《游龙山》"}},{"id":23585,"word":"断鹤继凫","pinyin":"duàn hè jì fú","abbr":"dhjf","explanation":"截短鹤的长腿，接长野鸭的短腿。比喻违反自然规律，办不成的事。"},{"id":23586,"word":"断鹤续凫","pinyin":"duàn hè xù fú","abbr":"dhxf","explanation":"断：截断；续：接；凫：野鸭。截断鹤的长腿去接续野鸭的短腿。比喻行事违反自然规律。","source":{"text":"长者不为有余，短者不为不足。是故凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"《庄子·骈拇》"},"example":{"text":"～，娇作者妄；移花接木，创始者奇。","book":"清·蒲松龄《聊斋志异·陆判》"},"similar":["揠苗助长"],"usage":"作谓语、定语；比喻行事违反自然规律","story":["传说古代有个愚蠢而善良的人看到郊外一群群野鸭子和白鹤在水里啄食嬉戏。他发现鹤腿长，野鸭的脚杆很短。他想这样一起走路不路不方便，就把他们捉来，砍下鹤的一截腿杆接到野鸭的脚上，这样他们都不能走路了"]},{"id":23587,"word":"断齑块粥","pinyin":"duàn jī kuài zhōu","abbr":"djkz","explanation":"指食物粗简微薄。形容贫苦力学。同“断齑画粥”。","source":{"text":"少陵秋风茅屋，而有广厦万间之愿；希文断齑块粥，而有先忧后乐之志。","book":"清·冯桂芬《潘绂庭京卿五十寿序》"},"similar":["断齑画粥"],"usage":"作谓语、定语；指生活贫困"},{"id":23588,"word":"断齑画粥","pinyin":"duàn jī huà zhōu","abbr":"djhz","explanation":"断：切断；齑：酱菜或腌菜之类。指食物粗简微薄。形容贫苦力学。","source":{"text":"惟煮粟米二升，作粥一器，经宿遂凝，以刀画为四块，早晚取二块，断齑数十茎，酢汁半盂，入少盐，暖而啖之。","book":"宋·魏泰《东轩笔录》"},"example":{"text":"贫而力学，～。","book":"《书言故事·苦学·断齑画粥》"},"similar":["节衣缩食","断齑块粥"],"opposite":["挥霍无度","挥金如土"],"usage":"作谓语、定语；指生活贫困","story":["北宋时期，范仲淹小时家贫，他只好住在庙里读书，昼夜不息，每日生活十分清苦，用两升小米煮粥，隔夜粥凝固后用刀一切为四，早晚各吃两块，再切一些腌菜佐食。经过苦读终于被录取为官员，他的至理名言是：先天下之忧而忧，后天下之乐而乐"]},{"id":23589,"word":"斯事体大","pinyin":"sī shì tǐ dà","abbr":"sstd","explanation":"斯：此；体：体制，规模。这件事性质重要，关系重大。","source":{"text":"兹事体大而允，寤寐次于圣心。","book":"汉·班固《典引》"},"example":{"text":"武王克殷，至周公相成王，始制礼乐。～，不可速成。","book":"《隋书·音乐志中》"},"similar":["此事体大"],"usage":"作分句；用于书面语"},{"id":23590,"word":"斯抬斯敬","pinyin":"sī tái sī jìng","abbr":"stsj","explanation":"形容双方客客气气，很有礼貌。","source":{"text":"要象如今这样斯抬斯敬，那里能把这些东西白遭塌了呢。","book":"清·曹雪芹《红楼梦》第八十七回"}},{"id":23591,"word":"斯文一派","pinyin":"sī wén yī pài","abbr":"swyp","explanation":"斯文：指文人或儒者。指文人学者或学问归属同一流派。","source":{"text":"功名万里忙如燕，斯文一脉微如线，光阴寸隙流如电，风雪两鬓白如练。","book":"元·薛昂夫《塞鸿秋》曲"},"example":{"text":"今日萍水相逢，忽然见这等一个～的少年公子，自然不觉得眼光一闪。","book":"清·文康《儿女英雄传》第八回"}},{"id":23592,"word":"斯文一脉","pinyin":"sī wén yī mài","abbr":"swym","explanation":"斯文：指文人或儒者。指文人学者或学问归属同一流派。","source":{"text":"赵世兄他目前虽说是新中举，总是我们斯文一派，将来昌明圣教，继往开来，舍我其谁？","book":"清·李宝嘉《官场现形记》第二回"}},{"id":23593,"word":"斯文委地","pinyin":"sī wén wěi dì","abbr":"swwd","explanation":"犹斯文扫地。指文化或文人不受尊重或文人自甘堕落。","source":{"text":"由杜子美以来，四百余年，斯文委地，文章之士，随世所能，杰出时辈，末有升子美之堂者，况室家之好邪！","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵一》"},"similar":["斯文扫地"],"usage":"作谓语、定语、状语；指文人自甘堕落"},{"id":23594,"word":"斯文扫地","pinyin":"sī wén sǎo dì","abbr":"swsd","explanation":"斯文：指文化或文人；扫地：比喻名誉、信用、地位等完全丧失。指文化或文人不受尊重或文人自甘堕落。","source":{"text":"巡检作巡抚，一步登天；监生作监临，斯文扫地。","book":"《论语·子罕》：“天之将丧斯文也，后死者不得与于斯文也。”清·徐坷《清稗类钞·三十四》"},"example":{"text":"完全应当罢课抗议！真是～，～。","book":"杨沫《青春之歌》第二部第四十三章"},"similar":["名誉扫地","声名狼藉"],"opposite":["显亲扬名"],"usage":"作谓语、定语、状语；指文人自甘堕落"},{"id":23595,"word":"斯斯文文","pinyin":"sī sī wén wén","abbr":"ssww","explanation":"形容举目文雅。","source":{"text":"人家的孩子都是斯斯文文的惯了，乍见了你这破落户，还被人笑话死了呢。","book":"清·曹雪芹《红楼梦》第七回"},"example":{"text":"我不喜欢故意装作～的样子。"},"similar":["温文尔雅"],"opposite":["粗声大气"],"usage":"作定语、状语；指人的举止","story":["贾宝玉随凤姐、贾母等去宁国府做客，宝玉要见秦可卿的弟弟，秦可卿叫他不要着急，尤氏说秦钟斯斯文文，不象宝玉那样胡打海摔的。宝玉顾不了这么多就自己去找，家人带秦钟来客厅。宝玉一眼就喜欢上他，要他来伴读"]},{"id":23596,"word":"斯须之报","pinyin":"sī xū zhī bào","abbr":"sxzb","explanation":"斯须：短暂；报：报答。短暂的报答。指报答很微小。","source":{"text":"不敢，向蒙莫之之恩，未展斯须之报。","book":"明·吴承恩《西游记》第六十三回"},"usage":"作宾语；用于书面语"},{"id":23597,"word":"新亭之泪","pinyin":"xīn tíng zhī lèi","abbr":"xtzl","explanation":"新亭：古地名，故址在今南京市的南面。表示痛心国难而无可奈何的心情。","source":{"text":"过江诸人，每至美日，辄相邀新亭，藉卉饮宴。周侯中坐而叹曰：‘风景不殊，正自有山河之异。’皆相视流泪。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"当下死友之哀才减，～重挥，却是仲池到了。","book":"清·魏子安《花月痕》第四十七回"},"similar":["新亭对泣"],"usage":"作宾语；表示怀念故国","story":["公元316年，刘曜率军灭了西晋。司马睿在王导的拥护下在建康建立了东晋王朝。一些贵族及大臣每当天气晴朗时到建康城外的新亭饮酒，武城侯周凯发感慨引发大家都哭了起来，丞相王导说要收复神州，不能像楚囚那样相对哭泣"]},{"id":23598,"word":"新亭堕泪","pinyin":"xīn tíng duò lèi","abbr":"xtdl","explanation":"新亭：古地名，故址在今南京市的南面；堕泪：流泪。表示痛心国难而无可奈何的心情。","source":{"text":"过江诸人，每至美日，辄相邀新亭，藉卉饮宴。周侯中坐而叹曰：‘风景不殊，正自有山河之异。’皆相视流泪。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"回首洛阳花世界，烟渺黍离之地。更不复、～。","book":"宋·文及翁《贺新郎·西湖》词"}},{"id":23599,"word":"新亭对泣","pinyin":"xīn tíng duì qì","abbr":"xtdq","explanation":"新亭：古地名，故址在今南京市的南面；泣：小声哭。表示痛心国难而无可奈何的心情。","source":{"text":"过江诸人，每至美日，辄相邀新亭，藉卉饮宴。周侯中坐而叹曰：‘风景不殊，正自有山河之异。’皆相视流泪。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"～惭名士，稍喜娇雏脸晕酡。","book":"柳亚子《夜宴双清阁》诗"},"similar":["楚囚对泣"],"opposite":["谈笑风生"],"usage":"作谓语、定语；表示怀念故国","story":["公元316年，刘曜率军灭了西晋。司马睿在王导的拥护下在建康建立了东晋王朝。一些贵族及大臣每当天气晴朗时到建康城外的新亭饮酒，武城侯周凯发感慨引发大家都哭了起来，丞相王导说要收复神州，不能像楚囚那样相对哭泣"]},{"id":23600,"word":"新亭泪","pinyin":"xīn tíng lèi","abbr":"xtl","explanation":"新亭：古地名，故址在今南京市的南面。表示痛心国难而无可奈何的心情。","source":{"text":"过江诸人，每至美日，辄相邀新亭，藉卉饮宴。周侯中坐而叹曰：‘风景不殊，正自有山河之异。’皆相视流泪。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"诸君漫洒～，好向中原识范阳！","book":"明·张家玉《读史》"}},{"id":23601,"word":"新人新事","pinyin":"xīn rén xīn shì","abbr":"xrxs","explanation":"具有新的道德品质的人和体现新的高尚社会风尚的事。","source":{"text":"全国各处的工厂里、农村里、部队里、学校里、商店里、家庭里都有新人新事出现吗？","book":"老舍《剧本习作的一些经验》"},"example":{"text":"我认为我们近代的散文不是没有成绩的，特别是解放后，全国遍地的～，影响鼓舞了许多作者。","book":"冰心《我们把春天吵醒了》"},"usage":"作宾语、定语；用于书面语"},{"id":23602,"word":"新仇旧恨","pinyin":"xīn chóu jiù hèn","abbr":"xcjh","explanation":"新仇加旧恨。形容仇恨深。","source":{"text":"新愁旧恨真无奈，须就邻家瓮底眠。","book":"唐·韩偓《三月》"},"example":{"text":"斗争起来了，这是发泄～的不顾一切的斗争。","book":"周立波《纪念》"},"similar":["深仇大恨","血海深仇"],"opposite":["大恩大德","恩重如山"],"usage":"作主语、宾语；指仇恨"},{"id":23603,"word":"新发于硎","pinyin":"xīn fā yú xíng","abbr":"xfyx","explanation":"新发：刚磨过；硎：磨刀石。刀刚在磨刀石上磨过。形容非常锋利或初露锋芒。","source":{"text":"今臣之刀十九年矣，所解数千牛矣，而刀刃若新发于硎。","book":"先秦·庄周《庄子·养生主》"},"example":{"text":"今有同乡马孝廉，～，索长安知交书。","book":"清·龚自珍《与吴虹生书》"},"similar":["新来乍到","初生牛犊"],"opposite":["老气横秋","饱经风霜"],"usage":"作谓语、定语、宾语；用于书"},{"id":23604,"word":"新婚宴尔","pinyin":"xīn hūn yàn ěr","abbr":"xhye","explanation":"宴尔：快乐愉悦，亦作“燕尔”。形容新婚快乐。亦作“燕尔新婚”、“新婚燕尔”。","source":{"text":"必须用此悲感，方可领略，则适当良友乍逢及新婚宴尔之人，必不信矣。","book":"清·章学诚《文史通义·文理》"},"similar":["新婚燕尔"],"usage":"作谓语、定语；用于新婚夫妻"},{"id":23605,"word":"新婚燕尔","pinyin":"xīn hūn yàn ěr","abbr":"xhye","explanation":"原为弃妇诉说原夫再娶与新欢作乐，后反其意，用作庆贺新婚之辞。形容新婚时的欢乐。","source":{"text":"燕尔新婚，如兄如弟。","book":"《诗经·邶风·谷风》"},"example":{"text":"俺两个相见时，则他那旧性全无，共妾身～。","book":"元·戴善夫《风光好》第四折"},"similar":["洞房花烛"],"opposite":["老夫老妻"],"usage":"作谓语、定语；用于新婚夫妻"},{"id":23606,"word":"新学小生","pinyin":"xīn xué xiǎo shēng","abbr":"xxxs","explanation":"指治学时间不长，见闻浅陋、经验不足的后生晚辈。","source":{"text":"新学小生，乱道误人，宜无信用，以经术断之。","book":"《汉书·张禹传》"},"usage":"作宾语、定语；用于书面语"},{"id":23607,"word":"新官上任三把火","pinyin":"xīn guān shàng rèn sān bǎ huǒ","abbr":"xgsrsbh","explanation":"指官员上任之初采取新的措施或政策。","source":{"text":"福军。你新官上任三把火，乱烧一通，迟早要犯大错误呀！","book":"路遥《平凡的世界》第三卷第六章"},"example":{"text":"～，我得多点几把火。"},"usage":"作宾语、定语、分句；用于刚上任的官员"},{"id":23608,"word":"新愁旧恨","pinyin":"xīn chóu jiù hèn","abbr":"xcjh","explanation":"愁：忧烦苦闷；恨：遗憾悔恨。新增添的忧烦苦闷和旧有的遗憾悔恨。形容思虑现状，回忆往事而无限忧伤、怨恨的情绪。","source":{"text":"新愁旧恨真无奈，须就邻家瓮底眠。","book":"唐·韩偓《三月》诗"},"example":{"text":"～都莫说，怎捱过今夜这时节也。","book":"明·胡文焕《群音类选·清腔类·香罗带》"},"similar":["新愁旧憾"],"usage":"作主语、宾语、定语；用于处事"},{"id":23609,"word":"新愁旧憾","pinyin":"xīn chóu jiù hàn","abbr":"xcjh","explanation":"愁：忧烦苦闷；憾：遗憾悔恨。新增添的忧烦苦闷和旧有的遗憾悔恨。形容思虑现状，回忆往事而无限忧伤、怨恨的情绪。","source":{"text":"新愁旧恨真无奈，须就邻家瓮底眠。","book":"唐·雍陶《忆山寄僧》：“新愁旧恨多难说，半在眉间关在胸。”唐·韩偓《三月》诗"},"example":{"text":"～不须提。","book":"明·胡文焕《群音类选·〈牧羊记·驿馆相逢〉》"},"similar":["新愁旧恨"],"usage":"作主语、宾语、定语；用于处事"},{"id":23610,"word":"新故代谢","pinyin":"xīn gù dài xiè","abbr":"xgdx","explanation":"指生物体不断用新物质代替旧物质的过程。也指新事物不断产生发展，代替旧的事物。同“新陈代谢”。","source":{"text":"新故代谢，四时次也。","book":"汉·蔡邕《兰赋》"},"similar":["新陈代谢"],"usage":"作宾语、定语；用于书面语"},{"id":23611,"word":"新昏宴尔","pinyin":"xīn hūn yàn ěr","abbr":"xhye","explanation":"极言新婚欢乐。燕，宴，安乐的样子。同“新婚燕尔”。","source":{"text":"以谓凡对明月与听霖雨，必须用此悲感，方可领略，则适当良友乍逢及新昏宴尔之人，必不信矣。","book":"清·章学诚《文史通义·文理》"},"similar":["新婚燕尔","新婚宴尔"],"usage":"作谓语、定语；用于新婚夫妻"},{"id":23612,"word":"新来乍到","pinyin":"xīn lái zhà dào","abbr":"xlzd","explanation":"乍：刚才，起初。形容为时不久或刚刚来到一个新地方。","source":{"text":"况且你二姐姐是新媳妇，孙姑爷也还是年轻的人，各人有各人的脾气，新来乍到，自然要有些别扭的。","book":"清·曹雪芹《红楼梦》第八十一回"},"example":{"text":"春兰看这人～，倒不怯生。","book":"梁斌《红旗谱》六"},"similar":["人生地疏"],"opposite":["故地重游","常来常往"],"usage":"作谓语、定语；指人地生疏"},{"id":23613,"word":"新沐弹冠","pinyin":"xīn mǔ tán guān","abbr":"xmdg","explanation":"沐：洗头发，刚刚洗完头发的人一定要把帽子上的尘土弹去。比喻人要洁身自好。","source":{"text":"新沐者必弹冠，新浴者必振衣，安能以身之察祭，受物之汶汶者乎？","book":"战国·楚·屈原《渔父》"},"usage":"作宾语、定语；用于书面语"},{"id":23614,"word":"新沐者必弹冠","pinyin":"xīn mǔ zhě bì tán guān","abbr":"xmzbdg","explanation":"沐：洗头发，刚刚洗完头发的人一定要把帽子上的尘土弹去。比喻人要洁身自好。","source":{"text":"新沐者必弹冠，新浴者必振衣，安能以身之察祭，受物之汶汶者乎？","book":"战国·楚·屈原《渔父》"}},{"id":23615,"word":"新淫之声","pinyin":"xīn yín zhī shēng","abbr":"xyzs","explanation":"淫：淫荡。新制作的淫靡颓废的歌曲。","source":{"text":"新淫之声，北鄙之曲。","book":"汉·刘向《列女传·孽糪传》"},"usage":"作主语、宾语；用于音乐等"},{"id":23616,"word":"新益求新","pinyin":"xīn yì qiú xīn","abbr":"xyqx","explanation":"已经新了，还要求更新。","source":{"text":"西国船制，日有变更，精益求精，新益求新。","book":"清·王韬《练水师》"},"example":{"text":"陶行知《教学做合一下之教科书》：“看它有没有引导人产生～的新价值的力量。”"},"usage":"作谓语、定语；用于书面语"},{"id":23617,"word":"新硎初发","pinyin":"xīn xíng chū fā","abbr":"xxcf","explanation":"硎：磨刀石；新硎：新磨出的刀刃。象新磨的刀那样锋利。比喻刚参加工作就显露出出色的才干。","source":{"text":"是以十九年而刀刃若新发于硎。","book":"《庄子·养生主》"},"example":{"text":"一个是～，努力钻研，一个是久旱逢甘，尽情领受。","book":"蔡东藩《明史演义》第四十回"}},{"id":23618,"word":"新硎初试","pinyin":"xīn xíng chū shì","abbr":"xxcs","explanation":"硎：磨刀石；新硎：新磨出的刀刃。象新磨的刀那样锋利。比喻刚参加工作就显露出出色的才干。","source":{"text":"是以十九年而刀刃若新发于硎。","book":"《庄子·养生主》"},"example":{"text":"这五百和尚，都是侠禅亲自教出来的，操练了几年，今日～，勇气百倍。","book":"清·吴趼人《二十年目睹之怪现状》第二十五回"},"similar":["初出茅庐","新官上任"],"opposite":["老成持重","饱经风霜"],"usage":"作谓语、定语；指新官上任"},{"id":23619,"word":"新酒旧瓶","pinyin":"xīn jiǔ jiù píng","abbr":"xjjp","explanation":"比喻用旧的形式表现新的内容。","source":{"text":"尽管‘新酒旧瓶’之讥，在所难免，但主观愿望还是想依主席‘古为今用’的方针做一点推陈出新的工作。","book":"赵朴初《片石集·前言》"},"example":{"text":"我不喜欢这种～的做法。"},"similar":["旧瓶装新酒"],"usage":"作宾语、定语；指换汤不换药"},{"id":23620,"word":"新陈代谢","pinyin":"xīn chén dài xiè","abbr":"xcdx","explanation":"陈：陈旧的；代：替换；谢：凋谢，衰亡。指生物体不断用新物质代替旧物质的过程。也指新事物不断产生发展，代替旧的事物。","source":{"text":"新故代谢，四时之次也。","book":"《淮南子·兵略训》：“若春秋有代谢，若日月有昼夜，终而复始，明而复晦。”汉·蔡邕《笔赋》"},"example":{"text":"世界上总是这样以新的代替旧的，总是这样～、除旧布新或推陈出新的。","book":"毛泽东《矛盾论》"},"similar":["吐故纳新","推陈出新"],"opposite":["停滞不前"],"usage":"作主语、谓语、定语；指生物体的更替"},{"id":23621,"word":"方丈盈前","pinyin":"fāng zhàng yíng qián","abbr":"fzyq","explanation":"方丈：一丈见方；盈：满。吃饭时食物摆满一丈见方的地方。形容饮食奢华。","source":{"text":"于是旨酒嘉肴，方丈盈前，浮枣绛水。","book":"汉·杜笃《柭稧赋》"},"similar":["食前方丈"],"usage":"作谓语、定语；形容吃的阔气"},{"id":23622,"word":"方以类聚","pinyin":"fāng yǐ lèi jù","abbr":"fylj","explanation":"指同类事物相聚一处。方：办法，做法，技巧。","source":{"text":"方以类聚，物以群分，吉凶生矣。","book":"《易·系辞上》"},"example":{"text":"土有常产，俗有旧风；～，物以群分。","book":"晋·皇甫谧《三都赋》序"},"similar":["方以类聚，物以群分"],"usage":"作宾语、分句；用于人或事物等"},{"id":23623,"word":"方以类聚，物以群分","pinyin":"fāng yǐ lèi jù，wù yǐ qún fēn","abbr":"fyljwyqf","explanation":"方：方术；物：事物。原指各种方术因种类相同聚在一起，各种事物因种类不同而区分开。后指人或事物按其性质分门别类各自聚集。","source":{"text":"方以类聚，物以群分，吉凶生矣。","book":"《周易·系辞上》"},"example":{"text":"所谓～，原是声应气求的兄弟，焉有不伤心的道理。","book":"清·石玉昆《三侠五义》第一○七回"},"similar":["人以类聚，物以群分"],"usage":"作宾语、分句；用于人或事物等"},{"id":23624,"word":"方便之门","pinyin":"fāng biàn zhī mén","abbr":"fbzm","explanation":"方便：本佛家语，指灵活对待。原是佛教指引人入教的门径，后指给人方便的门路。","source":{"text":"维摩见柄，盖申方便之门；道安谢归，思远朝廷之事。","book":"唐·王勃《广州宝庄严寺舍利塔碑》"},"example":{"text":"谁想巡捕老爷大开～，放俺还俗，便成配偶。","book":"明·冯惟敏《僧尼共祀》第四折"},"similar":["终南捷径"],"opposite":["山穷水尽","走头无路"],"usage":"作宾语；与“开”连用"},{"id":23625,"word":"方便门","pinyin":"fāng biàn mén","abbr":"fbm","explanation":"方便：便利。佛教语，指引人入教的门径，后指给人便利的门路。","source":{"text":"所以诸佛慈悲，见汝不奈何，开方便门，示真实相。","book":"宋·释道原《景德传灯录·漳州罗汉桂琛和尚》"},"similar":["方便之门"],"usage":"作宾语；与“开”连用"},{"id":23626,"word":"方兰生门，不得不锄","pinyin":"fāng lán shēng mén，bù dé bù chú","abbr":"flsmbdbc","explanation":"香草生长在门户之中，地方不适当，不得不锄掉。比喻人虽有才，但行为不轨，只好忍痛舍掉。","source":{"text":"先生答曰：‘芳兰生门，不得不锄。’裕遂弃市。","book":"《三国志·蜀志·周群传》"}},{"id":23627,"word":"方兴未已","pinyin":"fāng xīng wèi yǐ","abbr":"fxwy","explanation":"事物正在发展，尚未达到止境。同“方兴未艾”。","source":{"text":"世变茫茫，方兴未已。","book":"铁郎《二十世纪之湖南》"},"similar":["方兴未艾","方滋未艾"],"usage":"作谓语、定语；指事物正在发展"},{"id":23628,"word":"方兴未艾","pinyin":"fāng xīng wèi ài","abbr":"fxwa","explanation":"方：正在；兴：兴起；艾：停止。事物正在发展，尚未达到止境。","source":{"text":"天下非有豪猾不可制之奸，虏人非有方兴未艾之势，而何必用此哉！","book":"宋·陈亮《戊申再上孝宗皇帝书》"},"example":{"text":"正当辽沈战役～之时，毛泽东同志在华东人民解放军取得了济南战役胜利以后，又组织了淮海战役。","book":"叶剑英《伟大的战略决战》"},"similar":["方滋未艾","方兴未已","蒸蒸日上"],"opposite":["日暮途穷","穷途末路"],"usage":"作谓语、定语；指事物正在发展"},{"id":23629,"word":"方凿圆枘","pinyin":"fāng záo yuán ruì","abbr":"fzyr","explanation":"凿：榫眼；枘：榫头。方枘装不进圆凿。比喻格格不入，不能相合。","source":{"text":"圆凿而方枘兮，吾固知其龃龉而难入。","book":"战国·楚·宋玉《九辨》"},"example":{"text":"然杂取《公羊》《谷梁》以释《左氏》，此乃以冠双屦，将丝综麻，～，其可入呼？","book":"唐·孔颖达《春秋正义序》"},"similar":["方枘圆凿"],"usage":"作宾语、定语；指不相投合"},{"id":23630,"word":"方刚血气","pinyin":"fāng gāng xuè qì","abbr":"fgxq","explanation":"方：正；刚：强劲；血气：精力。形容年青人精力正旺盛。","source":{"text":"及其壮也，血气方刚，戒之在斗。","book":"《论语·季氏》"},"example":{"text":"少觅蝇头利，聊资瓮底春，我～不惮多劳顿。","book":"清·朱素臣《十五贯·泣别》"}},{"id":23631,"word":"方员可施","pinyin":"fāng yuán kě shī","abbr":"fyks","explanation":"随处可用。形容人多才多艺。"},{"id":23632,"word":"方命圮族","pinyin":"fāng mìng pǐ zú","abbr":"fmpz","explanation":"方命：不遵守命令；圮：毁坏；族：同族。不遵守命令，危害同族的人。也用来指民族的败类。","source":{"text":"吁！弗哉，方命圮族。","book":"《尚书·尧典》"},"example":{"text":"是对唯欲神州宁恤，汉族全制，诚不意狂狡据之以～也。","book":"清·章炳麟《终制》"},"usage":"作宾语、定语；用于书面语"},{"id":23633,"word":"方圆可施","pinyin":"fāng yuán kě shī","abbr":"fyks","explanation":"施：施行，使用。不论方的，圆的，都适合使用。比喻人有多种才能。","source":{"text":"补乌程令，甚著政绩。太守褚渊叹之曰：‘此人方圆可施。","book":"《南齐书·沈宪传》"},"usage":"作谓语、定语；用于人的才能"},{"id":23634,"word":"方圆殊趣","pinyin":"fāng yuán shū qù","abbr":"fysq","explanation":"殊趣：不同的志趣。方形和圆形不同，其意趣就大不相同。比喻不同的人或事物各有其不同的特点。","source":{"text":"今者见生，或年在扦格，方圆殊趣，宜听其去就，各从所安。","book":"《宋书·礼志一》"},"usage":"作谓语、定语；用于书面语"},{"id":23635,"word":"方圆难周，异道不安","pinyin":"fāng yuán nán zhōu，yì dào bù ān","abbr":"fynzydba","explanation":"周：调和，方和圆难于相互通融，政治道路不同的人不能和平相处。也指不与世俗同流合污的高尚品德。","source":{"text":"鸷鸟之不群兮，自前世百固然。何方圆之能周兮，未孰异道而相安？","book":"战国·楚·屈原《离骚》"}},{"id":23636,"word":"方土异同","pinyin":"fāng tǔ yì tóng","abbr":"ftyt","explanation":"方土：指各地地形、物产、风俗、人情。各地地形、物产、风俗、人情的不同。","source":{"text":"可令中书指宣明诏，问方土异同，贤才秀异，风俗好尚，农桑本务。","book":"《晋书·王浑传》"},"usage":"作宾语、定语；用于风土人情等"},{"id":23637,"word":"方外之人","pinyin":"fāng wài zhī rén","abbr":"fwzr","explanation":"方外：世外。原指言行超脱于世俗礼教之外的人。后指僧道。","source":{"text":"彼游方之外者也。","book":"《庄子·大宗师》"},"example":{"text":"侄女出家多年，乃～，岂可擅离此庵。尚求伯母原谅。","book":"清·李汝珍《镜花缘》第五十六回"},"similar":["方外人","方外之士"],"usage":"作宾语；指僧道"},{"id":23638,"word":"方外之国","pinyin":"fāng wài zhī guó","abbr":"fwzg","explanation":"方外：指中原地区以外的区域。旧指我国少数民族地区建立的小国。","source":{"text":"朕既不明，不能远德，使方外之国或不宁息。","book":"《汉书·文帝纪》"}},{"id":23639,"word":"方外之士","pinyin":"fāng wài zhī shì","abbr":"fwzs","explanation":"方外：世外。原指言行超脱于世俗礼教之外的人。后指僧道。","source":{"text":"彼游方之外者也，而丘游方之内者也。","book":"《庄子·大宗师》"},"similar":["方外之人"],"usage":"作宾语；指僧道"},{"id":23640,"word":"方外人","pinyin":"fāng wài rén","abbr":"fwr","explanation":"方外：世外。指言行超脱于世俗礼教之外的人。后指僧道等出家人。","source":{"text":"你究竟是方外人。岂有个才明保了的就撤省的道理呢？","book":"清·刘鹗《老残游记》第19回"},"similar":["方外之人"],"usage":"作主语、宾语；指僧道"},{"id":23641,"word":"方外司马","pinyin":"fāng wài sī mǎ","abbr":"fwsm","explanation":"方外：指世外，超脱了世俗礼教之外；司马：古代官名。虽然当了官，却不拘于礼教法规。","source":{"text":"俄而引奕为司马，奕既上，犹推布衣交。在温坐，岸帻啸咏，无异常日。宣武每曰：‘我方外司马。’","book":"南朝·宋·刘义庆《世说新语·简傲》"}},{"id":23642,"word":"方头不劣","pinyin":"fāng tóu bù liè","abbr":"ftbl","explanation":"方头：俗指不通时宜；不劣：倔强不驯顺。形容人性格倔强、顽固。","source":{"text":"俺这里有个裴炎，好生方头不劣。","book":"元·关汉卿《钱大尹智勘绯衣梦》第四折"},"similar":["方头不律"],"usage":"作谓语、定语；用于指人的个性"},{"id":23643,"word":"方头不律","pinyin":"fāng tóu bù lǜ","abbr":"ftbl","explanation":"形容人性格倔强、顽固。同“方头不劣”。","source":{"text":"见一个方头不律的人，欺侮一个老年，打扯他跳河。","book":"元·郑廷玉《金凤钗》"},"similar":["方头不劣"],"usage":"作谓语、定语；指人固执"},{"id":23644,"word":"方寸万重","pinyin":"fāng cùn wàn chóng","abbr":"fcwc","explanation":"方寸：指心。万重：多话。心里头有千言万语。","source":{"text":"方寸万重，悉候晤语。","book":"皇甫牧《步非烟》"},"usage":"作谓语、定语；用于书面语"},{"id":23645,"word":"方寸不乱","pinyin":"fāng cùn bù luàn","abbr":"fcbl","explanation":"方寸：指心。心绪不乱。形容人遇到特殊紧急的情况时能够从容镇定。","source":{"text":"亡家徇国，方寸不乱。","book":"唐·吕温《凌烟阁勋臣赞·屈突蒋公通》"},"example":{"text":"他在危难时经常处事不惊，～。"},"similar":["坐怀不乱"],"opposite":["方寸已乱"],"usage":"作谓语、定语；指人有定性"},{"id":23646,"word":"方寸之地","pinyin":"fāng cùn zhī dì","abbr":"fczd","explanation":"指心。","source":{"text":"文挚乃命龙叔背明而立，文挚自后向明而望之，既而曰：‘嘻！吾见子之心矣：方寸之地虚矣。","book":"《列子·仲尼篇》"},"example":{"text":"寻省遭罹，万重不幸。～，自不能言；求人见谅，岂复容易？","book":"唐·刘禹锡《上杜司徙启》"},"similar":["方寸地"],"usage":"作宾语；指心","story":["春秋时期，道家学者龙叔去请教宋国名医文挚。龙叔讲述他的病情，荣誉与指责对他是无动于衷，财物得失他不以为然，利害得失也影响不了他，感情也不能左右他。文挚仔细观察他一会，忽然惊喜地说：“你的方寸之地已经空虚，你是圣人了。”"]},{"id":23647,"word":"方寸之木，高于岑楼","pinyin":"fāng cùn zhī mù，gāo yú cén lóu","abbr":"fczmgycl","explanation":"岑楼：尖顶的高楼。把一寸高的木块放在高楼顶上，它就会比高楼还高。比喻不把二者放在一个标准上进行比较，就会得出错误的结论。","source":{"text":"不揣其本而齐其末，方寸之木可使高于岑楼。","book":"《孟子·告子下》"},"usage":"作宾语、定语；用于比较"},{"id":23648,"word":"方寸地","pinyin":"fāng cùn dì","abbr":"fcd","explanation":"原指很小的地方，借指心。","source":{"text":"俗语云：‘但存方寸地，留与子孙耕’。指心而言也。","book":"宋·罗大经《鹤林玉露》第六卷"},"similar":["方寸之地"],"usage":"作宾语；指心"},{"id":23649,"word":"方寸已乱","pinyin":"fāng cùn yǐ luàn","abbr":"fcyl","explanation":"心已经乱了。","source":{"text":"今已失老母，方寸乱矣。","book":"《三国志·蜀书·诸葛亮传》"},"example":{"text":"我的～，断无道理可计议了。","book":"清·文康《儿女英雄传》第三回"},"similar":["心神不定","如坐针毡"],"opposite":["无动于衷","心安理得"],"usage":"作谓语、宾语；指人定性不足","story":["三国时期，刘备的军师徐庶辅佐刘备有功，曹操一心想网罗他，就把他的母亲骗来，要她写信召徐庶回来。徐庶接到信后，知道这是曹操要挟他，无奈地对刘备说他方寸已乱不能兴汉除暴了，只有回去救母，然后把诸葛亮推荐给刘备"]},{"id":23650,"word":"方巾长袍","pinyin":"fāng jīn cháng páo","abbr":"fjcp","explanation":"方形头巾，长袍子。古代儒生的装束。指儒生。","source":{"text":"国画呢，方巾长袍，或短褐椎髻，从没有见过一条我所记得的辫子。","book":"鲁迅《病后杂谈之余》"},"similar":["方领圆冠","方巾阔服"],"usage":"作宾语、定语；用于口语"},{"id":23651,"word":"方巾阔服","pinyin":"fāng jīn kuò fú","abbr":"fjkf","explanation":"方巾：古代秀才戴的方形软帽。方形帽子，宽松的衣服。古代儒生的装束。指儒生。","source":{"text":"正说得热闹，街上又遇着两个方巾阔服的。","book":"清·吴敬梓《儒林外史》第18回"},"similar":["方巾长袍","方领圆冠"],"usage":"作宾语、定语；用于口语"},{"id":23652,"word":"方底圆盖","pinyin":"fāng dǐ yuán gài","abbr":"fdyg","explanation":"方底器皿，圆形盖子。比喻事物不相合。","source":{"text":"今使疏薄之人而节量亲厚之恩，犹方底而圆盖，必不合矣。","book":"北齐·颜之推《颜氏家训·兄弟》"},"similar":["方枘圆凿"],"usage":"作宾语、定语；指事物不投合"},{"id":23653,"word":"方斯蔑如","pinyin":"fāng sī miè rú","abbr":"fsmr","explanation":"方：比；斯：此；蔑：没有。与此相比，没有比得上的。多指为人的情操。","source":{"text":"昔保衡翼殷，博陆匡汉，方斯蔑如也。","book":"《南齐书·高帝纪上》"},"example":{"text":"虽伊尹之执兹壹德，姬旦之光于四海，～也。","book":"《梁书·武帝纪上》"},"usage":"作谓语、分句；用于书面语"},{"id":23654,"word":"方方正正","pinyin":"fāng fāng zhèng zhèng","abbr":"ffzz","explanation":"四四方方，规规矩矩。","example":{"text":"他做得～、规规矩矩的。"},"similar":["四四方方"],"usage":"作定语、状语；用于口语"},{"id":23655,"word":"方方面面","pinyin":"fāng fāng miàn miàn","abbr":"ffmm","explanation":"指各个方面。","example":{"text":"指各个方面。"},"usage":"作主语、宾语、定语；指各种情况"},{"id":23656,"word":"方来未艾","pinyin":"fāng lái wèi ài","abbr":"flwa","explanation":"指（恩泽）方始来到尚未止歇。","source":{"text":"霈如霖雨，润泽天下，而民被其惠者，方来而未艾也。","book":"明·方孝孺《凝命神宝颂》"},"example":{"text":"滔滔庆泽，～。","book":"明·吴承恩《贺思翁受封障词》"},"similar":["方兴未艾"],"usage":"作谓语、定语；指事物正在发展"},{"id":23657,"word":"方枘圆凿","pinyin":"fāng ruì yuán záo","abbr":"fryz","explanation":"枘：榫头；凿：榫眼。方枘装不进圆凿。比喻格格不入，不能相合。","source":{"text":"持方枘欲内圜凿，其能入乎？","book":"西汉·司马迁《史记·孟子荀卿列传》"},"example":{"text":"～匪所用，顾者却避多猜嫌。","book":"清·金农《秋雨坐槐树下书怀》诗"},"similar":["格格不入","大相径庭","方枘圜凿"],"opposite":["丝丝入扣","水乳交融"],"usage":"作宾语、定语；比喻格格不入"},{"id":23658,"word":"方枘圜凿","pinyin":"fāng ruì huán záo","abbr":"frhz","explanation":"方枘装不进圆凿。比喻格格不入，不能相合。同“方枘圆凿”。","source":{"text":"梁惠王谋欲攻赵，孟轲称大王去邠，此……持方枘欲内圜凿，其能入乎？","book":"《史记·孟子荀卿列传》"},"similar":["方枘圆凿","方凿圆枘"],"usage":"作宾语、定语；比喻格格不入"},{"id":23659,"word":"方桃譬李","pinyin":"fāng táo pì lǐ","abbr":"ftpl","explanation":"方：比。可同美艳的桃李相比。形容美丽娇艳。","source":{"text":"乃有燕馀丽妾，方桃譬李，本住南城，经居东里。","book":"南朝·梁·萧纲《筝赋》"},"example":{"text":"乃有燕余丽妾，～，本在南城，今居东里。","book":"唐·欧阳洵《艺文类聚》卷四十四"},"usage":"作谓语、定语；用于人等"},{"id":23660,"word":"方正不苟","pinyin":"fāng zhèng bù gǒu","abbr":"fzbg","explanation":"方正：正直；苟：苟且，不正派。指为人品行正直，不逢迎诌媚。","source":{"text":"嘉定有老儒，名朱纲，为人方正不苟，颇信佛老之说。","book":"清·钱泳《履园丛话·者者居》"},"similar":["方正不阿","刚正不阿"],"usage":"作谓语、定语；指为人品行正直"},{"id":23661,"word":"方正不阿","pinyin":"fāng zhèng bù ē","abbr":"fzbe","explanation":"方正：品行正直；阿：阿谀，诌媚。指为人品行正直，不逢迎诌媚。","source":{"text":"有方正不阿者，即以为不肖，而朝夕谗谤之，日加浸润，来免改疑。","book":"《明史·王徽传》"},"example":{"text":"嘉定有老儒，名朱纲，为人～，颇信佛老之说。","book":"清·钱泳《履园丛话·者者居》"},"similar":["刚正不阿"],"opposite":["阿谀逢迎"],"usage":"作谓语、定语；指为人品行正直"},{"id":23662,"word":"方正之士","pinyin":"fāng zhèng zhī shì","abbr":"fzzs","explanation":"方正：品行端正。品行端正不阿的读书人。","source":{"text":"言行若此，可谓方正之士。","book":"《汉书·晁错传》"}},{"id":23663,"word":"方正贤良","pinyin":"fāng zhèng xián liáng","abbr":"fzxl","explanation":"方正：正直；贤良：才能，德行好。汉武帝时推选的一种举荐官吏后备人员的制度，唐宋沿用，设贤良方正科。指德才兼备的好人品。","source":{"text":"当是之时，招尊方正贤良文学之士，或至公卿大夫。","book":"《史记·平准书》"},"similar":["贤良方正"],"usage":"作宾语、定语；指有才有德的人"},{"id":23664,"word":"方滋未艾","pinyin":"fāng zī wèi ài","abbr":"fzwa","explanation":"事物正在发展，尚未达到止境。同“方兴未艾”。","source":{"text":"咳，权相所为，一无忌惮至此。主少国疑之祸，方滋未艾矣！","book":"清·蒋士铨《临川梦·拒弋》"},"similar":["方兴未艾","方兴未已"],"usage":"作谓语、定语；指事物正在发展"},{"id":23665,"word":"方生方死","pinyin":"fāng shēng fāng sǐ","abbr":"fsfs","explanation":"方：正在。指万物万事正在在不断地出生成长，也在不断地死亡消失。","source":{"text":"方生方死，方死方生。","book":"《庄子·齐物论》"},"example":{"text":"我们是处在～之间的……我们要使方死的迅速死去，方生的蓬勃成长。","book":"郭沫若《苏联纪行·八月九日》"},"usage":"作谓语、定语、宾语；用于人或事物等"},{"id":23666,"word":"方言矩行","pinyin":"fāng yán jǔ xíng","abbr":"fyjx","explanation":"指言行方正，合乎规范。","source":{"text":"彭一庵，名珑，字云客，长洲人，方言矩行，士林推重。","book":"清·钱泳《履园丛话·科第·孝感》"},"usage":"作谓语、宾语；用于人的言行"},{"id":23667,"word":"方足圆颅","pinyin":"fāng zú yuán lú","abbr":"fzyl","explanation":"方形脚、圆形头为人的特征，因以指人类。同“方趾圆颅”。","source":{"text":"茫茫宇宙，惵惵黎元，方足圆颅，万不遗一。","book":"《陈书·高祖纪上》"},"similar":["方趾圆颅"],"usage":"作宾语、定语；指人类"},{"id":23668,"word":"方趾圆颅","pinyin":"fāng zhǐ yuán lú","abbr":"fzyl","explanation":"方脚圆头。指人类。","source":{"text":"方趾圆颅，万不遗一。","book":"《淮南子·精神训》：“故头之圆也象天，足之方也象地。”《南史·陈高祖纪》"},"example":{"text":"～，万不遗一。","book":"《南史·陈本纪上》"},"similar":["方足圆颅"],"usage":"作宾语、定语；指人类"},{"id":23669,"word":"方闻之士","pinyin":"fāng wén zhī sh","abbr":"fwzs","explanation":"有道而博闻的人。","source":{"text":"详延天下方闻之士，咸荐诸朝。","book":"《汉书·武帝纪》"},"usage":"作宾语、定语；用于书面语"},{"id":23670,"word":"方面大耳","pinyin":"fāng miàn dà ěr","abbr":"fmde","explanation":"方面：方脸。方脸盘，大耳朵。旧时形容富贵之相。","source":{"text":"帝王之闪，自有天命，周世宗见诸将方面大耳皆杀之，我终日侍侧，不能害也。","book":"《宋史·太祖记三》"},"example":{"text":"你不看见城里张府上那些老爷，都有万贯家私，　一个个～。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["方头大耳"],"usage":"作谓语、定语；用于人的长相"},{"id":23671,"word":"方领圆冠","pinyin":"fāng lǐng yuán guàn","abbr":"flyg","explanation":"方形的衣领和圆形的帽冠，为古代儒生的服饰。亦借指儒生。","source":{"text":"方领圆冠，金口木舌。谈章句之远旨，构纷纶之雅说。","book":"南朝·梁·何逊《七召·儒学》"},"similar":["方巾长袍","方巾阔服"],"usage":"作宾语、定语；用于口语"},{"id":23672,"word":"方领矩步","pinyin":"fāng lǐng jǔ bù","abbr":"fljb","explanation":"方领：直的衣领；矩步：行步合乎规矩。指古代儒者的服饰和容态。","source":{"text":"服方领习矩步者，委它乎其中。","book":"《后汉书·儒林传序》"},"example":{"text":"且说这位郑伯才君，单名一个雄字，乃是湖南湘潭县人，向来是个讲宋学的，～，不苟言笑。","book":"梁启超《新中国未来记》第五回"},"usage":"作定语；指古代儒者的服饰和容态"},{"id":23673,"word":"方驾齐驱","pinyin":"fāng jià qí qū","abbr":"fjqq","explanation":"方驾：并排驾马车；齐驱：一齐快跑。并排套着几匹马一齐快跑。比喻彼此力量、地位、才能等不相上下。","source":{"text":"令四后方驾齐驱，或有先后，便加谴责。","book":"《北史·周宣帝纪》"},"example":{"text":"文昭武穆，～；公子王孙，朱轮华榖。","book":"唐·杨炯《唐右将军魏哲神道碑》"},"similar":["并驾齐驱"],"usage":"作谓语、定语；用于人或其他事物"},{"id":23674,"word":"方骖并路","pinyin":"fāng cān bìng lù","abbr":"fcbl","explanation":"犹并驾齐驱。","source":{"text":"与袁粲群公方骖并路，倾覆之灾，庶几可免。","book":"《宋书·王景文传论》"},"example":{"text":"及太和之辰，虽复崇尚文雅，～，多乖往辙。","book":"《周书·庚信传论》"},"similar":["齐头并进"],"usage":"作谓语；用于书面语"},{"id":23675,"word":"於乎哀哉","pinyin":"wū hū āi zāi","abbr":"yhaz","explanation":"於乎：文言叹词；哉：语助词。用以指死亡或完蛋。","source":{"text":"於乎哀哉！维今之人，不尚有旧。","book":"《诗经·大雅·召旻》"},"example":{"text":"乱世恶善，不此听也，～，不得成也。","book":"战国·荀况《荀子·乐论》"},"similar":["呜呼哀哉"],"usage":"作谓语；含讽刺意味"},{"id":23676,"word":"施不望报","pinyin":"shī bù wàng bào","abbr":"sbwb","explanation":"放惠于人而不望报答。指轻财仗义。","source":{"text":"折节为恭，留意于宾客，轻财尚义，施不忘报。","book":"《三国志·吴志·朱治传》裴松之注引《吴书》"},"similar":["仗义疏财"],"usage":"作谓语、定语；指仗义疏财"},{"id":23677,"word":"施丹傅粉","pinyin":"shī dān fù fěn","abbr":"sdff","explanation":"丹：红，指胭脂；傅：搽。搽粉抹胭脂。泛指修饰打扮。","source":{"text":"无不熏衣剃面，傅粉施朱。","book":"战国·楚·宋玉《登徒子好色赋》：“著粉则太白，施朱则太赤。眉如翠羽，肌如白雪。”北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"更胜似～，果然是万花中惟此特尊。","book":"明·无名氏《八仙过海》第一折"},"similar":["施朱傅粉","涂脂抹粉"],"usage":"作谓语、定语；多用于女性"},{"id":23678,"word":"施仁布德","pinyin":"shī rén bù dé","abbr":"srbd","explanation":"指实行仁义，布施恩德，多行善事。","source":{"text":"他为甚施仁布德，也则要博一个孝子和贤妻。","book":"元·无名氏《看钱奴》楔子"},"example":{"text":"明·无名氏《贫富兴衰》第二折：“全不肯～行方便，那里有仗义疏财发好心，不由人雨泪纷纷。”"},"similar":["施恩布德","施仁布恩"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":23679,"word":"施仁布恩","pinyin":"shī rén bù ēn","abbr":"srbe","explanation":"给人以仁德和恩惠。","source":{"text":"刘皇叔施仁布恩，爱惜军卒养下民。","book":"明·无名氏《太平宴》头折"},"similar":["施仁布德","施仁布泽"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":23680,"word":"施仁布泽","pinyin":"shī rén bù zé","abbr":"srbz","explanation":"给人以仁德和恩惠。","source":{"text":"冯商的，冯商的，积功累德；冯商的，冯商的，施仁布泽。","book":"明·沈受先《三元记》第二十三出"},"similar":["施仁布德","施仁布恩"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":23681,"word":"施号发令","pinyin":"shī hào fā lìng","abbr":"shfl","explanation":"发布号令。","source":{"text":"每天子临轩，公卿拜授，施号发令，宣扬诏册，愔辞气温辩，神仪秀发，百僚观听，莫不悚动。","book":"《北齐书·杨愔传》"},"similar":["发令施号","施命发号"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":23682,"word":"施命发号","pinyin":"shī mìng fā hào","abbr":"smfh","explanation":"发布号令。","source":{"text":"选贤建戚，则宅之于茂典；施命发号，必酌之于故实。","book":"南朝宋颜延之《三月三日曲水诗序》"},"similar":["发号施令","施号发令"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":23683,"word":"施恩不望报","pinyin":"shī ēn bù wàng bào","abbr":"sebwb","explanation":"施：给予；报：报答。给予人恩惠，不期望得到报答","source":{"text":"惟其如此，愈见君夫妇盛德仁心、施恩不望报之君子也。","book":"清·无垢道人《八仙全传》第十回"},"opposite":["施恩图报","施恩望报"],"usage":"作谓语、定语、宾语；用于处事"},{"id":23684,"word":"施恩布德","pinyin":"shī ēn bù dé","abbr":"sebd","explanation":"指实行仁义，布施恩德，多行善事。","source":{"text":"他为甚施仁布德，也则要博一个孝子和贤妻。","book":"元·无名氏《看钱奴》楔子"},"example":{"text":"明·无名氏《魏征改诏》第一折：“我言语可使无虚谬，不脱空，元帅你～可便相知重。”"},"similar":["施仁布德","施仁布恩"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":23685,"word":"施恩望报","pinyin":"shī ēn wàng bào","abbr":"sewb","explanation":"给予别人恩惠，期望得到报答。","source":{"text":"赵某是顶天立地的男子，一生正直，并无邪佞。你把我看做施恩望报的小辈，假公济私的好人，是何道理？","book":"明·冯梦龙《警世通言》卷二十一"},"example":{"text":"可都是那个甚么～不望报的这个脾气儿闹的。","book":"清·文康《儿女英雄传》第十九回"},"similar":["施恩图报"],"opposite":["施恩不望报"],"usage":"作谓语、定语、宾语；用于处事"},{"id":23686,"word":"施施而行","pinyin":"shī shī ér xíng","abbr":"ssex","explanation":"形容走路缓慢。彼留子嗟，将其来施施。","source":{"text":"《诗经·王风·丘中有麻》"}},{"id":23687,"word":"施朱傅粉","pinyin":"shī zhū fù fěn","abbr":"szff","explanation":"朱：红，指胭脂；傅：搽。搽粉抹胭脂。泛指修饰打扮。","source":{"text":"无不熏衣剃面，傅粉施朱。","book":"战国·楚·宋玉《登徒子好色赋》：“著粉则太白，施朱则太赤。眉如翠羽，肌如白雪。”北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"其尼～，冶容艳佚，如介人之妇，其内服殷红，下饰亦红，二尼悉然。","book":"宋·丁用晦《芝田录·贾耽》"},"similar":["施丹傅粉"],"usage":"作谓语、定语；多用于女性"},{"id":23688,"word":"施绯拖绿","pinyin":"shī fēi tuō lǜ","abbr":"sftl","explanation":"形容衣衫不整。","source":{"text":"袒呼不辨王与李，施绯拖绿须眉张。","book":"清曹寅《呼卢歌》"},"usage":"作谓语、定语；指人的穿戴"},{"id":23689,"word":"施而不费","pinyin":"shī ér bù fèi","abbr":"sebf","explanation":"施：给人好处；费：耗费。给人好处，自己却无所损失。","source":{"text":"广而不宣，施而不费。","book":"《论语·尧曰》：“因民之所利而利之，斯不亦惠而不费乎？”《史记·吴太伯世家》"},"example":{"text":"西汉·司马迁《史记·吴太伯世家》：“广而不宣，～，取而不贪，处而不底。”"},"usage":"作宾语、定语；用于处事"},{"id":23690,"word":"施衿结褵","pinyin":"shī jīn jié lí","abbr":"sjjl","explanation":"本指古代女子出嫁，母亲将五彩丝绳和佩巾结于其身。后比喻父母对子女的教训。","source":{"text":"母施衿结帨，曰：‘勉之敬之。夙夜毋违宫事。’","book":"语出《诗·豳风·东山》：“之子于归，皇驳其马，亲结其缡，九十其仪。”又《仪礼·士昏礼》"},"example":{"text":"～，虔恭中馈。","book":"晋张华《女史箴》"},"usage":"作宾语、定语；用于书面语"},{"id":23691,"word":"施谋用智","pinyin":"shī móu yòng zhì","abbr":"smyz","explanation":"智：智慧，计谋。运用策略计谋。","source":{"text":"两阵之间，怎生施谋用智，你说一遍，老夫试听着。","book":"明·无名氏《破天阵》第四折"},"similar":["施谋设计","施谋用计"],"usage":"作谓语、宾语；指人运用计谋"},{"id":23692,"word":"施谋用计","pinyin":"shī móu yòng jì","abbr":"smyj","explanation":"施：施行；计：计谋。运用策略计谋。","source":{"text":"凭着您孩儿舌剑唇枪，施谋用计，我稳情取进贡到来。","book":"明·黄元吉《流星马》第一折"},"similar":["施谋用智"],"usage":"作谓语、宾语；指人运用计谋"},{"id":23693,"word":"施谋设计","pinyin":"shī móu shè jì","abbr":"smsj","explanation":"运用策略计谋。","source":{"text":"谁想太监三保，施谋设计，乘舟骗海，取了许多宝物。","book":"元·无名氏《下西洋》第四折"},"similar":["施谋用智","施谋用计"],"usage":"作谓语、定语；用于处事"},{"id":23694,"word":"旁午构扇","pinyin":"bàng wǔ gòu shān","abbr":"pwgs","explanation":"旁午：交错，纷繁；扇：通“煽”；构扇：连接，煽动。形容相互构陷、煽惑。","source":{"text":"以此大罪之外，诋诃万端，旁午构扇，便为敌仇。","book":"唐·柳宗元《寄许京兆孟容书》"}},{"id":23695,"word":"旁午走急","pinyin":"bàng wǔ zǒu jí","abbr":"pwzj","explanation":"旁午：交错，纷繁。纵横交错，往来奔赴。","source":{"text":"旁午走急，数十万之众，积于北方，天下安得食而馈之。","book":"汉·贾谊《新书·匈奴》"}},{"id":23696,"word":"旁引曲证","pinyin":"páng yǐn qǔ zhèng","abbr":"pyqz","explanation":"广泛征引，委曲证明。","source":{"text":"而遽欲取喻立说，旁引曲证，以强附于其事之已然。","book":"宋·朱熹《楚辞集注序》"},"example":{"text":"又有禹贡长笺十二卷，作于胡渭禹贡锥指之前，虽不及渭书，而备论古今利害，～，亦多创获。","book":"《清史稿·硃鹤龄传》"},"usage":"作谓语、定语；用于说话与文章等"},{"id":23697,"word":"旁征博引","pinyin":"páng zhēng bó yǐn","abbr":"pzby","explanation":"旁：广泛；征：寻求；博：广博；引：引证。指说话、写文章引用材料作为依据或例证。","source":{"text":"生数典已穷，而女博引旁征，滔滔不竭，计女多于生凡十四侧。","book":"清·王韬《淞隐漫录·红芸别墅》"},"example":{"text":"宝钗妙玉则从徐说，～，用罚甚勤。","book":"鲁迅《中国小说史略·清之人情小说》"},"similar":["引经据典","旁求博考"],"opposite":["理屈词穷"],"usage":"作谓语、定语、状语；用于说话或写文章","story":["唐高宗下令处死不小心看伐了昭陵的柏树的武卫大将军权善才，大臣狄仁杰认为权善才罪不至死，就举张释之劝汉文帝释放偷汉高祖庙里玉环的小偷，辛毗拉魏文帝的衣服看迁民布告等例证明贤明君主必须依法治国，终于救了权善才"]},{"id":23698,"word":"旁征博访","pinyin":"páng zhèng bó fǎng","abbr":"pzbf","explanation":"旁：广泛；征：征求；博：广博。指大量地引用材料作为依据或例证。","source":{"text":"无论读，无论做，倘若旁征博访，结果是往往会弄到抬驴子走的。","book":"鲁迅《读书杂谈》"},"similar":["旁征博引","旁求博考"],"usage":"作谓语、定语、状语；用于说话或写文章"},{"id":23699,"word":"旁得香气","pinyin":"páng dé xiāng qì","abbr":"pdxq","explanation":"在一旁的人也能嗅到香味。喻指无关的人，由于条件便利，同样得到好处。","source":{"text":"譬如妙香，一人卖，一人买，旁人在边，亦得香气。","book":"清·翟灏《通俗编·交际·旁得香气》"}},{"id":23700,"word":"旁指曲谕","pinyin":"páng zhǐ qǔ yù","abbr":"pzqy","explanation":"从侧面委婉启发晓谕。","source":{"text":"知属吏过失，未尝面言，必因公宴引数十年前事，曰某人尝为某过得某罪，旁指曲谕，微警戒之。","book":"宋·王禹偁《故商州团练使翟公墓志铭》"},"usage":"作谓语、定语、状语；用于说话等"},{"id":23701,"word":"旁推侧引","pinyin":"páng tuī cè yǐn","abbr":"ptcy","explanation":"从侧面启发引导。","source":{"text":"我旁推侧引地转着问了半天，他只说些革命的道理，不说出他们的根柢在什么地方。","book":"梁斌《红旗谱》"},"usage":"作定语、状语；用于说话等"},{"id":23702,"word":"旁搜博采","pinyin":"páng sōu bó cǎi","abbr":"psbc","explanation":"广泛地搜集。","source":{"text":"其始也，淹贯诸子百家，旁及老释二氏，旁搜博采，晚而敛博归约，落华就实。","book":"宋·魏了翁《苏和父墓志铭》"},"example":{"text":"他也有三四百通，还不住的～，十年之后，差不多要汗牛充栋了。","book":"清·李宝嘉《文明小史》第六十回"},"similar":["旁征博引"],"usage":"作谓语、宾语、定语；用于写作等"},{"id":23703,"word":"旁搜远绍","pinyin":"páng sōu yuǎn shào","abbr":"psys","explanation":"旁：广泛；搜：搜集；绍：继承。广泛地搜集引证资料，穷本溯源地说明来历，以进行论证。","source":{"text":"以旁搜远绍之才，寄情长短句。","book":"宋·刘肃《片玉集序》"},"example":{"text":"遇事与心会，辄忻然忘倦，其或抽思杂著，～，夜以继日。","book":"元·王恽《扶疏轩记》"},"usage":"作谓语、宾语、定语；用于写作等"},{"id":23704,"word":"旁摇阴煽","pinyin":"páng yáo yīn shān","abbr":"pyys","explanation":"指到处暗中煽动。","source":{"text":"追忆庀事之初，言者蜂起，妒功幸败者旁摇阴煽，盖不啻筑室道谋而已。","book":"明·张居正《答河道潘印川论河道就功书》"},"similar":["煽风点火"],"usage":"作谓语、定语、状语；用于处事"},{"id":23705,"word":"旁收博采","pinyin":"páng shōu bó cǎi","abbr":"psbc","explanation":"广泛收集采纳。","source":{"text":"裴松之之注《三国》也，刘孝标之注《世说》也，偏记杂谈，旁收博采。","book":"明·胡应麟《少室山房笔丛·史书怗毕》"},"similar":["旁搜博采"],"usage":"作谓语、宾语、定语；用于写作等"},{"id":23706,"word":"旁敲侧击","pinyin":"páng qiāo cè jī","abbr":"pqcj","explanation":"侧：旁边；击：敲打。比喻说话、写文章不从正面直接点明，而是从侧面曲折地加以讽刺或抨击。","source":{"text":"只不过不应该这样旁敲侧击，应该要明亮亮的叫破了他。","book":"清·吴趼人《二十年目睹之怪现状》第二十回"},"example":{"text":"不堂堂正正辩论是非，而～中伤对手，最是卑劣。","book":"清·梁启超《教育与政治》"},"similar":["拐弯抹角"],"opposite":["直言不讳","直截了当"],"usage":"作谓语、定语、状语；指从侧面含蓄表达"},{"id":23707,"word":"旁文剩义","pinyin":"páng wén shèng yì","abbr":"pwsy","explanation":"次要的文字和内容。"},{"id":23708,"word":"旁枝末节","pinyin":"páng zhī mò jié","abbr":"pzmj","explanation":"比喻不重要。"},{"id":23709,"word":"旁求俊彦","pinyin":"páng qiú jùn yàn","abbr":"pqjy","explanation":"旁：广；俊彦：才智过人的人。向各方面征求贤才。","source":{"text":"旁求俊彦，启迪后人。","book":"《尚书·太甲上》"},"usage":"作谓语；指向多方面征求贤才"},{"id":23710,"word":"旁求博考","pinyin":"páng qiú bó kǎo","abbr":"pqbk","explanation":"多方搜求，广泛考证。","source":{"text":"引用书目多至一百余种，旁求博考，洵大观也。","book":"鲁迅《“皇汉医学”》"},"similar":["旁征博引","旁征博访"],"usage":"作谓语、定语、状语；用于说话或写文章"},{"id":23711,"word":"旁若无人","pinyin":"páng ruò wú rén","abbr":"prwr","explanation":"身旁好像没有人。形容态度傲慢，不把别人放在眼里。","source":{"text":"荆轲嗜酒，日与狗屠及高渐离饮于燕市，酒酣以往，高渐离击筑，荆柯和而歌市中，相乐也，已而相泣，旁若无人者。","book":"《史记·刺客列传》"},"example":{"text":"陈太尉初下船时，昂昂然，～，坐在中间。","book":"明·施耐庵《水浒全传》第七十五回"},"similar":["目中无人"],"opposite":["众目睽睽"],"usage":"作谓语、定语、状语；指人的态度","story":["战国后期，卫国人庆卿（荆轲）到处游说六国抗秦，遭到赵国的轻视，就去燕国，结识了乐师高渐离，他们志趣相投，经常在一起喝酒唱歌，唱到高兴时，旁若无人。燕太子丹在田光的引见下，劝说荆轲去刺杀秦王，他们都没有成功"]},{"id":23712,"word":"旁蒐远绍","pinyin":"páng sōu yuǎn shào","abbr":"psys","explanation":"广泛搜集，远承古人。同“旁搜远绍”。"},{"id":23713,"word":"旁蒷远绍","pinyin":"páng sōu yuǎn shào","abbr":"psys","explanation":"广泛搜集，远承古人。同旁搜远绍”。"},{"id":23714,"word":"旁行斜上","pinyin":"páng xíng xié shàng","abbr":"pxxs","explanation":"原指《史记》中的《三代世表》、《十二诸侯年表》等。后泛指用表格行式排列的系表、谱牒等。","source":{"text":"桓谭《新论》云，太史《三代世表》，帝行邪（斜）上，并效周谱。","book":"《梁书·刘杳传》"},"example":{"text":"手书细密百十万言，无一潦草。增益者～，……","book":"清·平步清《霞外捃屑》卷六"},"usage":"作宾语；泛指列表编排的谱系等文字"},{"id":23715,"word":"旁见侧出","pinyin":"páng jiàn cè chū","abbr":"pjcc","explanation":"从不同的角度和侧面表现的形象。","source":{"text":"道子画人物，如以灯取影，逆来顺往，旁见侧出除。","book":"宋·苏轼《书吴道子画后》"},"example":{"text":"止为一线到底，并无～之情。","book":"清·李渔《闲情偶记·诗曲·结构》"},"usage":"作宾语、定语；指从侧面表现"},{"id":23716,"word":"旁观者清","pinyin":"páng guān zhě qīng","abbr":"pgzq","explanation":"当事人被碰到的问题搞糊涂了，旁边观看的人却看得很清楚。","source":{"text":"当局称迷，傍观见审。","book":"《旧唐书·元行冲传》"},"example":{"text":"俗话说：“～。”这几年姑娘冷眼看着，或有该添减的去处，二奶奶没行到，姑娘竟一添减。","book":"清·曹雪芹《红楼梦》第五十五回"},"similar":["了如指掌","洞烛其奸"],"opposite":["当局者迷"],"usage":"作宾语、定语；常与“当局者迷”连用","story":["唐朝大臣魏光上书唐玄宗要求把魏征整理修订的《类礼》列为经书。唐玄宗命元澹校阅，右丞相张说认为已经有郑玄作注成为经书。元澹写《释疑》表明自己观点：郑玄的注过时了，魏征不是下棋人，他是旁观者所以注解得比较真实"]},{"id":23717,"word":"旁观袖手","pinyin":"páng guān xiù shǒu","abbr":"pgxs","explanation":"把手笼在袖子里在旁观看。比喻置身事外，不过问也不协助。","source":{"text":"勇退激流，虽具衲子参寻之眼；旁观袖手，要非邦人向慕之诚。","book":"宋·陆游《福州清仁王坚老疏》"},"similar":["袖手旁观"],"usage":"作谓语、宾语、定语；指不过问"},{"id":23718,"word":"旁蹊曲径","pinyin":"páng xī qū jìng","abbr":"pqqj","explanation":"大道旁边狭小而弯曲的路径。比喻不正当的途径。","source":{"text":"人才所以立国，今旁蹊曲径，幸门四辟；言路所以通下情，今媕阿循嘿，囊括不言。","book":"宋·魏了翁《故参知政事兼同知枢密院事赠少保陈公神道碑》"},"example":{"text":"读书当从六经，而后史汉，而后韩欧诸大家，浸灌之久，由是而发为诗文，始为正路，舍是则～矣。","book":"清·黄宗羲《高旦中墓志铭》"}},{"id":23719,"word":"旁通曲畅","pinyin":"páng tōng qǔ chàng","abbr":"ptqc","explanation":"普遍通达。亦作“旁通曲鬯”。"},{"id":23720,"word":"旁通曲鬯","pinyin":"páng tōng qǔ chàng","abbr":"ptqc","explanation":"普遍通达。同“旁通曲畅”。"},{"id":23721,"word":"旁逸斜出","pinyin":"páng yì xié chū","abbr":"pyxc","explanation":"逸：引申为超出。指树枝从树干旁边伸出。","source":{"text":"它所有的丫枝一律向上，而且紧紧靠拢，也象加过人工似的，成为一束，绝不旁逸斜出。","book":"茅盾《白杨礼赞》"},"example":{"text":"王朔《修改后发表》：“俟其终篇，回头一看，本属～的一枝竟百花丛生独成蓬伞大树，余者皆在荫下。”"},"usage":"作谓语、定语；用于树木等"},{"id":23722,"word":"旁逸横出","pinyin":"páng yì héng chū","abbr":"pyhc","explanation":"犹言到处出没。"},{"id":23723,"word":"旁门外道","pinyin":"páng mén wài dào","abbr":"pmwd","explanation":"原指不正派的宗教派别。借指不正派的学术派别。现泛指不正派的东西。","source":{"text":"左道旁门乱似麻，只因昏主起波查。","book":"《礼记·王制》：“执左道以乱政，杀。”明·许仲琳《封神演义》第三十四回"},"example":{"text":"盖谭诗论文，有粗鄙熟烂者，有～者，有泥古至死不悟者，最足损人神智。","book":"清·郑燮《花间堂诗草跋》"},"similar":["旁门左道","旁门邪道"],"usage":"作宾语、定语；指不正经的东西"},{"id":23724,"word":"旁门小道","pinyin":"páng mén xiǎo dào","abbr":"pmxd","explanation":"犹旁门左道。泛指不正派的东西。","source":{"text":"苏溪作歌之意，正谓旁门小道，似是而非者。","book":"宋·姚宽《西溪丛语》上卷"},"example":{"text":"日与其徒研覆妙旨，凡～，力排斥。","book":"明·宋濂《宏道法师碑》"},"similar":["旁门左道","旁门邪道","旁门外道"],"usage":"作宾语、定语；指不正经的东西"},{"id":23725,"word":"旁门左道","pinyin":"páng mén zuǒ dào","abbr":"pmzd","explanation":"原指不正派的宗教派别。借指不正派的学术派别。现泛指不正派的东西。","source":{"text":"左道旁门乱似麻，只因昏主起波查。","book":"《礼记·王制》：“执左道以乱政，杀。”明·许仲琳《封神演义》第三十四回"},"example":{"text":"但所谓“洞主，岛主”，只不过是一批既不属任何门派、又不隶什么帮会的～之士。","book":"金庸《天龙八部》第三十三章"},"similar":["歪门邪道","左道旁门","旁门小道"],"opposite":["不二法门"],"usage":"作宾语、定语；指不正经的东西"},{"id":23726,"word":"旁门歪道","pinyin":"páng mén wāi dào","abbr":"pmwd","explanation":"指不正经的东西。","example":{"text":"我们不能走～。"},"similar":["旁门左道","歪门邪道"],"usage":"作宾语、定语；指不正经的东西"},{"id":23727,"word":"旁门邪道","pinyin":"páng mén xié dào","abbr":"pmxd","explanation":"泛指不正派的东西。同“旁门左道”。","source":{"text":"他就是想靠旁门邪道一举‘成名’。","book":"萧乾《一本褪色的相册·》"},"similar":["旁门外道"],"usage":"作宾语、定语；指不正经的东西"},{"id":23728,"word":"旅进旅退","pinyin":"lǚ jìn lǚ tuì","abbr":"ljlt","explanation":"旅：共，同。与众人一起进退。形容跟着大家走，自己没有什么主张。","source":{"text":"吾不欲匹夫之勇也，欲其旅进旅退也。","book":"《礼记·乐记》：“今夫古乐，进旅退旅。”《国语·越语上》"},"example":{"text":"复有无毁无誉，～，窃位而苟禄，备员而全身者，亦无所取焉。","book":"宋·王禹偁《待漏院记》"},"similar":["共同进退"],"opposite":["独树一帜"],"usage":"作谓语；形容跟着大家走，自己没有什么主张"},{"id":23729,"word":"旋乾转坤","pinyin":"xuán qián zhuǎn kūn","abbr":"xqzk","explanation":"扭转天地。比喻从根本上改变社会面貌或已成的局面。也指人魄力极大。","source":{"text":"陛下即位以来，躬亲听断，旋乾转坤。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"我是不相信文艺的～的力量的，但倘有人要在别方面应用他，我以为也可以。譬如“宣传”就是。","book":"鲁迅《三闲集·文艺与革命》"},"similar":["改天换地","回天之力"],"opposite":["回天乏术"],"usage":"作谓语、定语；指人魄力极大"},{"id":23730,"word":"旋复回皇","pinyin":"xuán fù huí huáng","abbr":"xfhh","explanation":"旋复：回旋往复；回皇：盘旋，回转。形容乐声的回旋往复、抑扬髙下","source":{"text":"泛缆溥漠，浩浩洋洋，长远广引，旋复回皇。","book":"汉·马融《长笛赋》"},"usage":"作谓语、定语；用于书面语"},{"id":23731,"word":"旋干转坤","pinyin":"xuán qián zhuǎn kūn","abbr":"xgzk","explanation":"扭转天地。比喻从根本上改变社会面貌或已成的局面。也指人魄力极大。","source":{"text":"陛下即位以来，躬亲听断，旋干转坤。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"无论何人当此难局，亦无～之手腕。","book":"黄远庸《政界内形记》"}},{"id":23732,"word":"旋得旋失","pinyin":"xuán dé xuán shī","abbr":"xdxs","explanation":"很快得到，不久又失去。形容得失都很快。","source":{"text":"十数州县，但都旋得旋失，没有得到巩固。","book":"吴玉章《荣县独立》"},"usage":"作谓语、定语；用于书面语"},{"id":23733,"word":"旋生旋灭","pinyin":"xuán shēng xuán miè","abbr":"xsxm","explanation":"指产生不久随即消亡。","source":{"text":"这种小册子，历来他们出得不少，大抵旋生旋灭，没有较永久的。","book":"鲁迅《书信集·致陶亢德》"},"similar":["朝生暮死"],"usage":"作谓语、定语；用于书面语"},{"id":23734,"word":"旋踵即逝","pinyin":"xuán zhǒng jí shì","abbr":"xzjs","explanation":"踵：脚后跟；旋踵：旋脚之间，形容极短的时间；逝：过去。转身就不见了。形容消失得非常快。","source":{"text":"往年吴公吮其父，其父战不旋踵，遂死于敌。","book":"西汉·司马迁《史记·吴起传》"},"similar":["转瞬即逝"],"usage":"作谓语、定语；用于书面语"},{"id":23735,"word":"旋转乾坤","pinyin":"xuán zhuǎn qián kūn","abbr":"xzqk","explanation":"扭转天地。比喻从根本上改变社会面貌或已成的局面。也指人魄力极大。","source":{"text":"陛下即位以来，躬亲听断，旋乾转坤。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"菶如自以为用了背城借一的力量，必然有～的功劳。","book":"清·曾朴《孽海花》第二十四回"},"similar":["旋乾转坤"],"usage":"作谓语、定语；指人魄力极大"},{"id":23736,"word":"旋转干坤","pinyin":"xuán zhuǎn gàn kūn","abbr":"xzgk","explanation":"扭转天地。比喻从根本上改变社会面貌或已成的局面。也指人魄力极大"},{"id":23737,"word":"旌善惩恶","pinyin":"jīng shàn chéng è","abbr":"jsce","explanation":"表彰好人好事，惩办恶人恶事。","source":{"text":"陛下自返宫阙，勋臣已蒙官爵，唯旌善惩恶，未有区分。","book":"《旧唐书·萧复传》"},"example":{"text":"呜呼，～，申公匪私，生者享爵禄之荣，死者沐恩光之贲。","book":"明·王士桢《鸣凤记·封赠忠臣》"},"similar":["奖善惩恶","扬善惩恶"],"usage":"作谓语、定语；用于处事"},{"id":23738,"word":"旌旗卷舒","pinyin":"jīng qí juǎn shū","abbr":"jqjs","explanation":"舒：展开。战旗随风飘动，有时卷起，有时展开。比喻战事持续。","source":{"text":"扫除凶逆，芟荑遗寇，旌旗卷舒，日不暇给。","book":"《三国志·魏书·傅嘏传》"},"usage":"作宾语、定语；用于书面语"},{"id":23739,"word":"旌旗蔽天","pinyin":"jīng qí bì tiān","abbr":"jqbt","explanation":"旌旗：旗帜；蔽：遮蔽。旌旗繁多遮蔽天空。比喻军队阵容的盛大壮观。","source":{"text":"戈甲耀日，旌旗蔽天，连亘二十余里，粲如锦绣。","book":"宋·周密《武林旧事·御教》"},"example":{"text":"因率城中将士，鼓噪而出，声震山谷，～，无不以一当百，斩首万级。","book":"明·郭勋《英烈传》第44回"},"similar":["旌旗蔽空","旌旗蔽日"],"usage":"作谓语、宾语、定语；用于军事"},{"id":23740,"word":"旌旗蔽日","pinyin":"jīng qí bì rì","abbr":"jqbr","explanation":"旌旗：旗帜的通称，这里特指战旗。战旗遮住了日光。形容军队数量众多，阵容雄壮整齐。","source":{"text":"于是楚王游于云梦，结驷千乘，旌旗蔽日。","book":"西汉·刘向《战国策·楚策一》"},"example":{"text":"今有西秦苻坚，领兵入寇，统兵百万，～。","book":"元·李文蔚《蒋神灵应》第二折"},"similar":["旌旗蔽天","旌旗蔽空"],"usage":"作谓语、宾语、定语；用于军事"},{"id":23741,"word":"旌旗蔽空","pinyin":"jīng qí bì kōng","abbr":"jqbk","explanation":"旌旗：旗帜；蔽：遮蔽。旌旗繁多遮蔽天空。比喻军队阵容的盛大壮观。","source":{"text":"旌旗蔽空，酾酒临江，横槊赋诗，固一世之雄也，而今安在哉？","book":"宋·苏轼《前赤壁赋》"},"similar":["旌旗蔽日","旌旗蔽天"],"usage":"作谓语、宾语、定语；用于军事"},{"id":23742,"word":"旖旎风光","pinyin":"yǐ nǐ fēng guāng","abbr":"ynfg","explanation":"旖旎：柔和美丽。柔和而美丽的韵致风采或自然风景。","source":{"text":"一霎时局已到齐，真正是翠绕珠围，金迷纸醉，说不尽温柔景象，旖旎风光。","book":"清·李宝嘉《官场现形记》第七回"},"example":{"text":"我被七仙岭的～迷住了。"},"similar":["山明水秀","锦绣河山","湖山如画"],"opposite":["草木凋零","残山剩水","满目疮痍"],"usage":"作谓语、宾语；指风景"},{"id":23743,"word":"旗布星峙","pinyin":"qí bù xīng zhì","abbr":"qbxz","explanation":"犹言星罗棋布。形容数量很多，分布很广。","source":{"text":"若夫长洲别岛，旗布星峙。","book":"汉·王粲《游海赋》"},"similar":["星罗棋布"],"usage":"作谓语、定语；用于书面语"},{"id":23744,"word":"旗帜鲜明","pinyin":"qí zhì xiān míng","abbr":"qzxm","explanation":"本指军旗耀眼，军容整齐。现比喻立场、观点、态度等十分明确。","source":{"text":"曹操指山下颜良排的阵势，旗帜鲜明，枪刀森布，严整有威。","book":"明·罗贯中《三国演义》第二十五回"},"example":{"text":"兀术好生疑惑，忙出营前观看；果然依旧～，枪刀密布，不知何故。（清·钱彩《说岳全传》第五十七回）"},"similar":["爱憎分明"],"opposite":["模棱两可"],"usage":"作谓语、定语；指政治态度明确"},{"id":23745,"word":"旗开取胜","pinyin":"qí kāi qǔ shèng","abbr":"qkqs","explanation":"形容战斗顺利，一出兵就取得了胜利。比喻事情刚一开始就取得成功。","source":{"text":"虎旅醒醒士气盈，旗开取胜虏尘清。","book":"清·钱彩《说岳全传》第80回"},"similar":["旗开得胜"],"opposite":["一触即溃"],"usage":"作谓语、定语；指顺利成功"},{"id":23746,"word":"旗开得胜","pinyin":"qí kāi dé shèng","abbr":"qkds","explanation":"刚一打开旗帜进入战斗，就取得了胜利。比喻事情刚一开始，就取得好成绩。","source":{"text":"托赖主人洪福，旗开得胜，马到成功。","book":"元·无名氏《射柳捶丸》第四折"},"example":{"text":"～姜文焕，一怒横行劈董忠。","book":"明·许仲琳《封神演义》第九十四回"},"similar":["马到成功","百战百胜"],"opposite":["一溃千里","一触即溃"],"usage":"作谓语、定语；指顺利成功"},{"id":23747,"word":"旗开得胜，马到成功","pinyin":"qí kāi dé shèng，mǎ dào chéng gōng","abbr":"qkdsmdcg","explanation":"令旗一挥，战马一到就取得了胜利。比喻事情进展顺利，一开始就取得成功。","source":{"text":"所以旗开得胜，马到成功，攻城略地如风卷残云。","book":"明·周楫《西湖二集·刘伯温荐贤平浙中》"},"example":{"text":"叶赫也出兵二万名，会合前进，只望～。","book":"《慈禧太后演义》第一回"},"similar":["旗开马到"],"opposite":["出师不利"],"usage":"作宾语、定语、分句；用于顺利时"},{"id":23748,"word":"旗开马到","pinyin":"qí kāi mǎ dào","abbr":"qkmd","explanation":"令旗一挥，战马一到就取得了胜利。比喻事情进展顺利，一开始就取得成功。","source":{"text":"某今下战书去，单搦大宋家名将出马，与某交战，别辨输赢，方显威风北虏强，密排剑戟迸寒光，旗开马到施骁勇，大宋英雄拱手降。","book":"元·无名氏《射柳捶丸》第一折"},"example":{"text":"听的将孟海公擒拿靖边疆，今日个～雄威壮。","book":"明·无名氏《魏征改诏》第三折"},"similar":["旗开得胜，马到成功"],"usage":"作谓语、定语；用于事情开始时"},{"id":23749,"word":"旗旆成阴","pinyin":"qí pèi chéng yīn","abbr":"qpcy","explanation":"旆：旆旗。指众多的旗帜遮住太阳。形容旗帜很多。因古时为官的人才能树旗，故又引申为做官的人很多。","source":{"text":"韦氏自居京兆，代有人物。世康昆季，馀庆所钟，或入处礼闱，或出总方岳，硃输接轸，旗旆成阴，在周暨隋，勋庸并茂，盛矣！","book":"《隋书·韦世康传》"}},{"id":23750,"word":"旗靡辙乱","pinyin":"qí mí zhé luàn","abbr":"qmzl","explanation":"指阵脚已乱，抵挡不住。","source":{"text":"吾视其辙乱，望其旗靡，故逐之。","book":"春秋·鲁·左丘明《左传·庄公十年》"},"example":{"text":"谓栎下未必～，但全师未尽出耳。","book":"清·周亮工《与方与三书》"},"similar":["辙乱旗靡"],"usage":"作谓语、状语、定语；指失败"},{"id":23751,"word":"旗鼓相当","pinyin":"qí gǔ xiāng dāng","abbr":"qgxd","explanation":"比喻双方力量不相上下。","source":{"text":"如令子阳到汉中、三辅，愿因将军兵马，鼓旗相当。","book":"《后汉书·隗嚣传》"},"example":{"text":"单说何孝先自办此事以来，居然别开生路，与申大善士一帮～，彼此各不相干。","book":"清·李宝嘉《官场现形记》第三十五回"},"similar":["势均力敌","旗鼓相当"],"opposite":["相形失色","天差地别"],"usage":"作谓语、定语；指势均力敌","story":["西汉末年，王莽篡位改国号“新”，刘秀起兵反对，实力不断壮大。后来当上皇帝，建立东汉，为了稳住隗嚣，派大司徒邓禹宣布封隗嚣为西川大将军，让他去牵制四川与他旗鼓相当的蜀王公孙述。隗嚣与公孙述打了两年仗后就投靠他"]},{"id":23752,"word":"旗鼓相望","pinyin":"qí gǔ xiāng wàng","abbr":"qgxw","explanation":"军队行列很长，战旗军鼓前后相接。形容队列绵延不绝，严整有气势。","source":{"text":"桓公终举兵攻莱，战于莒必市里，众少未相知，而莱人大遁。故遂破其军，兼其地，而虏其将。","book":"《管子·轻重》"},"example":{"text":"坚南伐司马昌明，戎卒六十万，骑二十七万，前后千里，～。","book":"《魏书·苻坚传》"},"usage":"作谓语、定语；用于声势等"},{"id":23753,"word":"无一不备","pinyin":"wú yī bù bèi","abbr":"wybb","explanation":"指样样齐全。","source":{"text":"真是：吃的，喝的，穿的，戴的，无一不精，无一不备。","book":"清·李汝珍《镜花缘》第二十一回"},"similar":["一应俱全"],"usage":"作谓语、宾语、定语；同“一应俱全”"},{"id":23754,"word":"无一不知","pinyin":"wú yī bù zhī","abbr":"wybz","explanation":"没有什么不知道的。形容知识丰富。","source":{"text":"知一者，无一之不知也。不知一者，无一能知也。一者，至贵无偶之号也。","book":"宋·张君房《云笈七签》第49卷引《五符经》"},"example":{"text":"凡是他问的，那先生～，无一不能。","book":"清·文康《儿女英雄传》第18回"},"similar":["无所不知"],"opposite":["胸无点墨"],"usage":"作谓语、定语；指没有什么不知道的"},{"id":23755,"word":"无一可","pinyin":"wú yī kě","abbr":"wyk","explanation":"没有一点是可取的。","source":{"text":"彰君恶，伤私义。二者无一可，而先生行之，必且轻于齐而累于楚矣。","book":"汉·司马相如《子虚赋》"},"example":{"text":"穆又奏记极谏，冀终不悟。报书云：“如此，仆亦～邪？”","book":"《后汉书·朱穆传》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":23756,"word":"无一尘染","pinyin":"wú yī chén rǎn","abbr":"wycr","explanation":"原指佛教徒修行时，排除物欲，保持心地洁净。现泛指丝毫不受坏习惯，坏风气的影响。也用来形容非常清洁、干净。","source":{"text":"花朝月夕，独自爽怀，一尘不染，万念胥空。","book":"唐·田颖《揽云台记》"}},{"id":23757,"word":"无一是处","pinyin":"wú yī shì chù","abbr":"wysc","explanation":"宋·欧阳修《与王懿敏公》：“事与心违，无一是处，未知何日遂得释然。”","source":{"text":"事与心违，无一是处，未知何日遂得释然。","book":"宋·欧阳修《与王懿敏公》"},"example":{"text":"但这所谓“～”者，也只是对于“聪明绝顶的人”而言；在“蠢笨如牛的人”，却是“正当”的教育。","book":"鲁迅《而已集·卢梭和胃口》"}},{"id":23758,"word":"无万大千","pinyin":"wú wàn dà qiān","abbr":"wwdq","explanation":"不可以千万计，极言数量之多。","source":{"text":"今俗有无万大千语。大千本佛经三千大千。","book":"清·翟灏《通俗编·数目》"},"similar":["成千上万"],"opposite":["寥寥无几"],"usage":"作宾语、定语；指数量多"},{"id":23759,"word":"无上上品","pinyin":"wú shàng shàng pǐn","abbr":"wssp","explanation":"指物品中最佳的。","source":{"text":"隐显度世，以待天符。白日飞升，不露圭角。此方为无上上品真人，历万劫而不坏者也。","book":"明·张三丰《大道论》上篇"},"example":{"text":"这出唱过，又看了陆素兰的《舞盘》、金漱芳的《题曲》、李玉林的《偷诗》，都是～，香艳绝伦。","book":"清·陈森《品花宝鉴》第六回"}},{"id":23760,"word":"无下箸处","pinyin":"wú xià zhù chǔ","abbr":"wxzc","explanation":"晋武帝时，何曾生活豪奢，食日费万钱，犹云无下箸处。后用以形容富人饮食奢侈无度。","source":{"text":"性奢豪，务在华侈。帷帐车服，穷极绮丽，厨膳滋味，过于王者。……食恨钱，犹曰无下箸处。","book":"《晋书·何曾传》"},"example":{"text":"清·钱泳《履园丛话·杂记·四字》：“每一日餐费，至十余金，犹嫌～。”"},"usage":"作宾语、定语；用于生活等","story":["西晋武帝时期，位列三公号称孝子仁人的何曾标榜自己按礼法行事，他就是对自己的妻子说话也要衣冠整齐。他曾指责名士阮籍在守孝期间大吃大喝，大违孝道，而他自己却十分讲究吃喝，每顿饭要吃掉一万铜钱还说没有下筷子的地方"]},{"id":23761,"word":"无与为比","pinyin":"wú yǔ wéi bǐ","abbr":"wywb","explanation":"犹无与伦比，无可比拟。","source":{"text":"汉朝委质，既愿礼禅之速定也，天祚率土，必将有主；主率土者，非陛下其孰能任之？所谓论德无与为比，考功无推让矣。","book":"《三国志·魏志·文帝纪》"},"example":{"text":"开元初，擢为太府少卿，虽钱帛充牣，丈尺间皆躬自省阅，时议以为前后为太府者～。","book":"《旧唐书·杨慎矜传》"},"similar":["无可比拟"],"usage":"作谓语、定语；用于比较等"},{"id":23762,"word":"无与伦比","pinyin":"wú yǔ lún bǐ","abbr":"wylb","explanation":"伦比：类比，匹敌。指事物非常完美，没有能跟它相比的。","source":{"text":"数千百年以来，未有伦比。","book":"唐·韩愈《论佛骨表》"},"example":{"text":"在这段时间里，他受到祖国人民～的最热情的接待。","book":"魏巍《东方·归来》"},"similar":["无可比拟","前所未有"],"opposite":["不相上下","同日而语"],"usage":"作谓语、定语；指没有能跟它相比的"},{"id":23763,"word":"无与比伦","pinyin":"wú yǔ bǐ lún","abbr":"wybl","explanation":"指事物非常完美，没有能跟它相比的。同“无与伦比”。","source":{"text":"永宫宠遇，无与比伦。","book":"宋·王禹偁《西京谢上表》"},"similar":["无与伦比","无有伦比"],"usage":"作谓语、定语；用于书面语"},{"id":23764,"word":"无业游民","pinyin":"wú yè yóu mín","abbr":"wyym","explanation":"没有固定职业、住所而到处流浪的人。","source":{"text":"他说这班都是无业游民，往往有打个半死的。","book":"清·李宝嘉《官场现形记》第47回"},"example":{"text":"我们要注意这些～的动向。"},"usage":"作主语、宾语、定语；指到处流浪的人"},{"id":23765,"word":"无丝有线","pinyin":"wú sī yǒu xiàn","abbr":"wsyx","explanation":"丝：通私，私情；线：线索。指虽没有私情，仍有嫌疑。","source":{"text":"娘子可速回。倘有外人见之，无丝有线，吾之清德一旦休矣。","book":"明·冯梦龙《醒世恒言·佛印师四调琴娘》"},"similar":["无私有弊"],"usage":"作谓语；指有嫌疑"},{"id":23766,"word":"无中生有","pinyin":"wú zhōng shēng yǒu","abbr":"wzsy","explanation":"道家认为，天下万物生于有，有生于无。把没有的说成有。比喻毫无事实，凭空捏造。","source":{"text":"天下万物生于有，有生于无。","book":"《老子》"},"example":{"text":"子息从来天数，原非人力能为。最是～，堪令耳目新奇。","book":"明·凌濛初《初刻拍案惊奇》卷三十八"},"similar":["造谣生事","信口雌黄","捕风捉影"],"opposite":["确凿无疑","铁证如山","事出有因"],"usage":"作谓语、宾语；指凭空捏造","story":["春秋时期，大哲学家老子提出他的宇宙论。他认为宇宙的形成过程是道生天地，天地生万物，循环往复是道的运动，柔弱是道的运用，天下万物生于有形体的天地，有形体的天地生于无形体的道"]},{"id":23767,"word":"无为之治","pinyin":"wú wéi zhī zhì","abbr":"wwzz","explanation":"指道家顺应自然，不求有所作为的治理方法。","source":{"text":"既能夺他们之权，生他们之利，岂不能行无为之治？","book":"清·曹雪芹《红楼梦》第56回"},"usage":"作宾语；用于书面语"},{"id":23768,"word":"无为而成","pinyin":"wú wéi ér chéng","abbr":"wwec","explanation":"指不倚外力而自然有所成就。","source":{"text":"不见而章，不动而变，无为而成。","book":"西汉·戴圣《礼记·中庸》"},"similar":["无为自成"],"usage":"作宾语、定语；用于处事"},{"id":23769,"word":"无为而治","pinyin":"wú wéi ér zhì","abbr":"wwez","explanation":"无为：无所作为；治：治理。自己无所作为而使天下得到治理。原指舜当政的时候，沿袭尧的主张，不做丝毫改变。后泛指以德化民。","source":{"text":"无为而治者，其舜也与？","book":"春秋·鲁·孔丘《论语·卫灵公》"},"example":{"text":"故儒家主张‘恭已正南面，垂拱而治’道家主张‘～’。","book":"郭沫若《十批判书·吕不韦和秦王政的批判》"},"similar":["无为自化"],"usage":"作宾语、定语；指以德化民"},{"id":23770,"word":"无为自化","pinyin":"wú wéi zì huà","abbr":"wwzh","explanation":"指无为而治。","source":{"text":"道常无为，而无不为。侯王若能守之，尤物将自化。","book":"《老子》第三十七章"},"example":{"text":"李耳～，清静自正。","book":"《史记·老子韩非列传》"},"similar":["无为而治"],"usage":"作谓语、定语；用于处事"},{"id":23771,"word":"无为自成","pinyin":"wú wéi zì chéng","abbr":"wwzc","explanation":"指不倚外力而自然有所成就。同“无为而成”。","source":{"text":"物者春也，吐华夏也，布叶秋也，凋零冬也，成实斯无为而自成者也。","book":"汉·徐干《中论·考伪》"},"similar":["无为而成"],"usage":"作宾语、定语；用于处事"},{"id":23772,"word":"无乎不可","pinyin":"wú hū bù kě","abbr":"whbk","explanation":"犹无可无不可。指听任。","source":{"text":"他们的老子要他们读这些；我是别人，无乎不可的。","book":"鲁迅《彷徨·在酒楼上》"},"similar":["无可无不可"],"usage":"作谓语、定语；用于口语"},{"id":23773,"word":"无了无休","pinyin":"wú le wú xiū","abbr":"wlwx","explanation":"没完没了，没有终了。","source":{"text":"忘了时依然还又，恶思量无了无休。","book":"元·王实甫《西厢记》第五本第一折"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第35回：“上海的吃花酒，只要三天吃过，以后便～的了。”"},"similar":["无休无了","没完没了"],"usage":"作谓语、定语；用于书面语"},{"id":23774,"word":"无了根蒂","pinyin":"wú le gēn dì","abbr":"wlgd","explanation":"比喻无所凭依；没有本源。","source":{"text":"徒乐枕经籍书，纡体衡门，上无所蒂，下无所根。独摅意呼宇宙之外，锐思于豪芒之内。","book":"语出《汉书·叙传上》"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第22卷：“寺僧看见他～，渐渐怠慢，不肯相留。”"},"usage":"作谓语、定语；用于书面语"},{"id":23775,"word":"无事不登三宝殿","pinyin":"wú shì bù dēng sān bǎo diàn","abbr":"wsbdsbd","explanation":"三宝殿：泛指佛殿。比喻没事不上门。","source":{"text":"白娘子道：‘无事不登三宝殿，去做什么？’","book":"明·冯梦龙《警世通言·白娘子永镇雷锋塔》"},"example":{"text":"所以你一进门，我就知道你是有为而来的了。这才是～啊。","book":"清·吴趼人《二十年目睹之怪现状》第六十六回"},"usage":"作谓语、分句；比喻没事不上门"},{"id":23776,"word":"无事忙","pinyin":"wú shì máng","abbr":"wsm","explanation":"不干正事，但又忙乱。","source":{"text":"一年到头无事忙，白天孵茶馆，晚上‘摆一碗’。","book":"高阳《胡雪岩全传·平步青云》中册"},"example":{"text":"我是个～的人。"},"usage":"作宾语、定语；多用于自谦"},{"id":23777,"word":"无事生事","pinyin":"wú shì shēng shì","abbr":"wsss","explanation":"犹言无事生非。无缘无故找岔子，存心制造麻烦。","source":{"text":"无风扬波，无事生事。","book":"明·李贽《读》"},"similar":["无事生非"],"usage":"作谓语、定语、宾语；用于处事"},{"id":23778,"word":"无事生非","pinyin":"wú shì shēng fēi","abbr":"wssf","explanation":"无缘无故找岔子，存心制造麻烦。","source":{"text":"有不安本分的强盗，有无事生非的强盗。","book":"清·李汝珍《镜花缘》第58回"},"example":{"text":"～哩，没狼撵狼呗。","book":"柳青《创业史》第一部第21章"},"similar":["无中生有"],"opposite":["安分守己","息事宁人"],"usage":"作主语、谓语、定语；指故意捣乱"},{"id":23779,"word":"无亲无故","pinyin":"wú qīn wú gù","abbr":"wqwg","explanation":"没有亲属和故旧。形容孤单。","source":{"text":"她一个单身人，无亲无故，带着一个孩子在外乡，什么都做。","book":"曹禺《雷雨》第二幕"},"example":{"text":"路遥《平凡的世界》第二卷第42章：“我在这世界上要是～，孤单一人就好了！”"},"similar":["非亲非故"],"opposite":["沾亲带故"],"usage":"作谓语、定语；用于人际关系等"},{"id":23780,"word":"无人不晓","pinyin":"wú rén bù xiǎo","abbr":"wrbx","explanation":"晓：知晓。没有人不知道。形容很有名气。","example":{"text":"这事已经是～了。"},"similar":["赫赫有名","举世闻名"],"opposite":["默默无闻"],"usage":"作谓语、定语；指很出名"},{"id":23781,"word":"无人不知","pinyin":"wú rén bù zhī","abbr":"wrbz","explanation":"到尽人皆知的地步。","source":{"text":"‘卖朝报’的人为广招徕，必然大声吆喝，以至于大街小巷，无人不知。","book":"高阳《胡雪岩全传·灯火楼台》"},"example":{"text":"他的臭事到了～的地步。"},"similar":["无人不晓","家喻户晓"],"usage":"作谓语、定语；指众人皆知"},{"id":23782,"word":"无人之地","pinyin":"wú rén zhī dì","abbr":"wrzd","explanation":"没有人居住的地方。同“无人之境”。","source":{"text":"艾自阴平道行无人之地七百里。","book":"《三国志·魏志·邓艾传》"},"example":{"text":"《英烈传》第九回：“便抖擞精神，保了太祖横冲直撞，如入～。”"},"similar":["无人之境"],"opposite":["通都大邑"],"usage":"作宾语；指荒野"},{"id":23783,"word":"无人之境","pinyin":"wú rén zhī jìng","abbr":"wrzj","explanation":"没有人居住的地方。","source":{"text":"不茸一垒，不置一卒，使寇之去来，如入无人之境。","book":"宋·杨万里《国势中》"},"example":{"text":"只是镇静地缓缓前行，坦然如入～。","book":"鲁迅《彷徨·伤逝》"},"similar":["荒无人烟","无人之地"],"opposite":["熙熙攘攘"],"usage":"作宾语；指没有人居住的地方","story":["三国时期，魏国尚书郎邓艾很有谋略而且英勇善战，被任命为征西将军。他向魏元帝上书乘势攻击蜀军，他率军从阴平小路进步，经过700里无人之境出其不意到达江油，并轻取该城与绵竹，迫使蜀后主刘禅亲自向邓艾投降"]},{"id":23784,"word":"无人问津","pinyin":"wú rén wèn jīn","abbr":"wrwj","explanation":"问津：询问渡口。比喻没有人来探问、尝试或购买。","source":{"text":"南阳刘子骥，高尚士也，闻之，欣然规往，未果，寻病终。后遂无问津者。","book":"晋·陶潜《桃花源记》"},"example":{"text":"晋·陶潜《桃花源记》：“南阳刘子骥，高尚士也，闻之，欣然规往，未果，寻病终。后遂无问津者。”"},"similar":["置之不理"],"opposite":["门庭若市"],"usage":"作宾语；指被人冷落"},{"id":23785,"word":"无从下手","pinyin":"wú cóng xià shǒu","abbr":"wcxs","explanation":"无从：没有门径或难以理出头绪；下手：着手。指事物头绪杂乱，无法着手处理。","source":{"text":"那三姐儿却只是淡淡相对，只有二姐儿也十分有意，但只是眼目众多，无从下手。","book":"清·曹雪芹《红楼梦》第六十四回"},"example":{"text":"相传曹操怕死后被人掘坟，造了七十二疑冢，令人～。","book":"鲁迅《花边文学·清明时节》"}},{"id":23786,"word":"无从企及","pinyin":"wú cóng qǐ jí","abbr":"wcqj","explanation":"无从：没有门径；企及：盼望达到。没有办法赶上。","example":{"text":"渔仲、亭林诸公，我以为今人～。此时代不同，环境所致，亦无可奈何。","book":"鲁迅《书信集·致曹聚仁》"}},{"id":23787,"word":"无从措手","pinyin":"wú cóng cuò shǒu","abbr":"wccs","explanation":"无从：没有门径或难以理出头绪；措：安置；措手：着手。指事物头绪杂乱，无法着手处理。","source":{"text":"试观间于齐楚三章，孟子亦无从措手，只教其为善死守，存亡听天而已。","book":"清·龚炜《巢林笔谈》卷三"},"example":{"text":"但是这件事情，是～的，我就和你们讲了，你们也不能帮我的忙。","book":"清·张春帆《九尾龟》第一百三十七"}},{"id":23788,"word":"无从置喙","pinyin":"wú cóng zhì huì","abbr":"wczh","explanation":"没有话可说，没有可插嘴的。","source":{"text":"卢年禾三旬，断狱精严，令人无从置喙。","book":"清·庆兰《莹窗异草三编·宠眉叟》"},"similar":["无可置喙"],"opposite":["议论纷纷"],"usage":"作谓语、定语；用于书面语"},{"id":23789,"word":"无从说起","pinyin":"wú cóng shuō qǐ","abbr":"wcsq","explanation":"无从：没有门径或难以理出头绪。指事情太繁杂，要说的话很多，但不知道该从哪里说起。","example":{"text":"我只恨着我自家命苦，两年以前没有遇着你这样的一个人，到了如今也是～的了。","book":"清·张春帆《九尾龟》第八十八回"}},{"id":23790,"word":"无以塞责","pinyin":"wú yǐ sè zé","abbr":"wysz","explanation":"自谦之语。无法弥补自己应负的责任。","source":{"text":"妾幸蒙陛下厚恩，先帝遗德，奉朝请之礼，备臣妾之仪，列为公主，赏赐邑人，隆天重地，死无以塞责。","book":"《汉书·东方朔传》"},"example":{"text":"汤无尺寸功，起刀笔吏，陛下幸致为三公，～。","book":"《史记·酷吏列传》"},"usage":"作谓语、定语；用于处事"},{"id":23791,"word":"无以复加","pinyin":"wú yǐ fù jiā","abbr":"wyfj","explanation":"不可能再增加。指程度达到了极点。","source":{"text":"且令万世之后无以复加也。","book":"《左传·文公十七年》：“今大国曰：‘尔未逞吾志。’敝邑有亡，无以加焉。”《汉书·王莽传下》"},"example":{"text":"其便捷之法，殆～。","book":"清·王韬《瀛壖杂志》"},"similar":["登峰造极","叹为观止"],"opposite":["人外有人"],"usage":"作谓语、定语、补语；指程度达到了极点","story":["公元9年，王莽改汉为新朝，自己称帝，为了显示自己能够建立万世帝业，下令给自己修宗庙，在长安城郊划出数百顷土地开工建设，大臣崔发、张邯讨好他说：“您的宗庙应造得气势恢宏才行，即使千秋万代以后，在后人眼里仍然是无以复加、举世无双的"]},{"id":23792,"word":"无以自容","pinyin":"wú yǐ zì róng","abbr":"wyzr","explanation":"容：容纳。没有地方可以让自己容身。形容非常羞愧。","source":{"text":"此皆臣等无状，不足以启圣心，保初政。忧愧之至，无以自容。","book":"《明史·徐溥传》"},"example":{"text":"生惶愧～，恨天公之缺陷而已。","book":"清·蒲松龄《聊斋志异·巧娘》"},"usage":"作谓语、定语；用于处事"},{"id":23793,"word":"无以自解","pinyin":"wú yǐ zì jiě","abbr":"wyzj","explanation":"自己没有能够用来排解的办法。","source":{"text":"然怀恩怏怏，又性强固，不肯为谗毁屈，无以自解，乃上书陈情。","book":"《新唐书·叛臣上》"},"example":{"text":"阿里虎向闻海陵善嬲戏，好美色，恨天各一方，不得与之接欢，至是沉郁烦懑，～。","book":"明·冯梦龙《醒世恒言》卷二十三"}},{"id":23794,"word":"无以自遣","pinyin":"wú yǐ zì qiǎn","abbr":"wyzq","explanation":"遣：排遣。没有办法排遣。形容百无聊赖，没有办法打发日子。","source":{"text":"无以自遣，乃和渊明二篇，随意所寓，无复伦次也。","book":"宋·苏轼《和郭主簿二首》"},"example":{"text":"方贬夷陵时，～，因取旧案反覆观之，见其枉直乖错不可胜数。","book":"《宋史·欧阳修传》"}},{"id":23795,"word":"无价之宝","pinyin":"wú jià zhī bǎo","abbr":"wjzb","explanation":"无法估价的宝物。指极珍贵的东西。","source":{"text":"易求无价宝，难得有心郎。","book":"唐·鱼玄机《赠邻女》诗"},"example":{"text":"我这珠衣是～哩。","book":"元·王实甫《丽春堂》第二折"},"similar":["价值连城"],"opposite":["粪土不如","一文不值"],"usage":"作宾语；指极珍贵的东西","story":["战国时期，魏国一农民锄草时发现一块玉石，拿回家请邻居鉴定。邻居知道是宝石就骗他不是吉祥之物，让他放回原处，自己则偷偷拿回家里，担心获祸或获罪，就进献给魏王。经鉴定为无价之宝，魏王一高兴就赏他很多金银珠宝"]},{"id":23796,"word":"无任之禄","pinyin":"wú rèn zhī lù","abbr":"wrzl","explanation":"指不做事或不会做事但得到禄位。","source":{"text":"子顺相魏，改嬖宠之官，以事贤才，夺无任之禄，以赐有功。","book":"《孔丛子·陈士义》"},"example":{"text":"宋·司马光《资治通鉴·周赧王五十六年》：“夺～，以赐有功。”"},"usage":"作主语、宾语；用于书面语"},{"id":23797,"word":"无休无了","pinyin":"wú xiū wú le","abbr":"wxwl","explanation":"没完没了，没有终了。同“无了无休”。","source":{"text":"可怜那死的倒未必知道，这活的真是苦恼伤心，无休无了，算来竟不如草木石头，无知无觉，倒也心中干净。","book":"清·曹雪芹《红楼梦》第113回"},"similar":["无了无休","没完没了"],"usage":"作谓语、定语；用于书面语"},{"id":23798,"word":"无休无止","pinyin":"wú xiū wú zhǐ","abbr":"wxwz","explanation":"休：停止。指没完没了。","example":{"text":"但李秋水的说话竟～，一个时辰又一个时辰的说下去。","book":"金庸《天龙八部》第三十七回"}},{"id":23799,"word":"无伤大体","pinyin":"wú shāng dà tǐ","abbr":"wsdt","explanation":"伤：伤害；大体：指事物的主要方面。对于事物的主要方面没有什么妨害。","source":{"text":"即忿狷、惑溺，迹涉风刺，要无伤于大雅。","book":"清·毛际可《今世说序》"},"example":{"text":"而那向上的精神还是始终一贯，不见得弛懈，自然，偶而也免不了有些很想勒转马头的，可是这也～。","book":"鲁迅《华盖集·我观北大》"},"similar":["无伤大雅"],"opposite":["事关重大"],"usage":"作谓语、定语；指没有大的妨碍"},{"id":23800,"word":"无伤大雅","pinyin":"wú shāng dà yǎ","abbr":"wsdy","explanation":"大雅：《诗经》的组成部分之一，这里指雅正、文雅大方。指虽有影响但对主要方面没有妨害。","source":{"text":"即忿狷、惑溺，迹涉风刺，要无伤于大雅。","book":"清·毛际可《今世说序》"},"example":{"text":"就是甜味，也各具特色，有些是蜜糖般甜，有些是在甜中略带一点轻微的，“～”和酸味。","book":"秦牧《“果王”的美号》"},"similar":["无关大局","无足挂齿"],"opposite":["损伤根本","元气大伤"],"usage":"作谓语、定语；指不碍事"},{"id":23801,"word":"无伤无臭","pinyin":"wú shēng wú xiù","abbr":"wswx","explanation":"没有声音，没有气味。比喻没有名声，不被人知道。"},{"id":23802,"word":"无何有之乡","pinyin":"wú hé yǒu zhī xiāng","abbr":"whyzx","explanation":"无何有：即无有。原指什么都没有的地方，后指虚幻的境界。","source":{"text":"今子有大树，患其无用，何不树之于无何有之乡，广莫之野？","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"古今来这些艺术家所以要建设这～，追寻那梦里的青花的原因，究竟在什么地方呢？","book":"郁达夫《文学上的阶级斗争》"},"similar":["无何有乡"],"usage":"作宾语；指空无所有的地方"},{"id":23803,"word":"无何有乡","pinyin":"wú hé yǒu xiāng","abbr":"whyx","explanation":"无何有之乡。","source":{"text":"我们小小一点沉闷会被它荡到无何有乡去了。","book":"郭沫若《文艺论集·读梁任公》"},"similar":["无何有之乡"],"usage":"作宾语；指空无所有的地方"},{"id":23804,"word":"无佛处称尊","pinyin":"wú fó chù chēng zūn","abbr":"wfccz","explanation":"在没有能手的地方逞强。","source":{"text":"应笑我于无佛处称尊也。","book":"宋·黄庭坚《跋东坡书寒食诗》"},"usage":"作谓语、宾语；指在没有能手的地方逞强"},{"id":23805,"word":"无使滋蔓","pinyin":"wu shi zi man","abbr":"wszm","explanation":"不要让他扩展势力。"},{"id":23806,"word":"无依无靠","pinyin":"wú yī wú kào","abbr":"wywk","explanation":"形容孤苦而无所依靠。","source":{"text":"献帝又无靠无依，董卓又不仁不义，吕布又一冲一撞。","book":"元·关汉卿《单刀会》第三折"},"example":{"text":"天啊！只道与你一竹竿到底，白头相守，那里说起半路上就抛撇了，遗下许多儿女，～。","book":"明·冯梦龙《醒世恒言》卷三十五"},"similar":["孤苦伶仃"],"opposite":["大有靠山","有人撑腰"],"usage":"作谓语、宾语；用于人或物"},{"id":23807,"word":"无倚无靠","pinyin":"wú yǐ wú kào","abbr":"wywk","explanation":"形容孤苦无依。同“无依无靠”。","source":{"text":"近因父母双亡，无倚无靠，今已取到寓所。","book":"明·罗贯中《平妖传》第14回"},"example":{"text":"老舍《全家福》第三幕：“她听说您死在外边，～，能不找一条活路儿吗？”"},"similar":["无依无靠"],"usage":"作谓语、宾语；用于人或物"},{"id":23808,"word":"无偏无倚","pinyin":"wú piān wú yǐ","abbr":"wpwy","explanation":"指笔直而无偏斜。","source":{"text":"当中却有一条无偏无倚的荡平大路。","book":"清·文康《儿女英雄传》第一回"},"similar":["不偏不倚"],"usage":"作定语、状语；用于处事"},{"id":23809,"word":"无偏无党","pinyin":"wú piān wú dǎng","abbr":"wpwd","explanation":"偏：不公正；党：偏私。形容处事公正，没有偏向。","source":{"text":"无偏无党，王道荡荡。","book":"《书·洪范》"},"example":{"text":"～，无反无侧，以会天下于有极而已。","book":"宋·陈亮《廷对》"},"similar":["刚正不阿"],"opposite":["徇私舞弊"],"usage":"作谓语、定语；指公正"},{"id":23810,"word":"无偏无陂","pinyin":"wú piān wú bēi","abbr":"wpwb","explanation":"不偏向；不邪曲。","source":{"text":"无偏无陂，遵王之义。","book":"《尚书·洪范》"},"example":{"text":"宋·曾巩《洪范传》：“其先后次序然也，～，遵王之义。”"},"similar":["无偏无颇","公正无私","不偏不倚"],"usage":"作谓语、定语、状语；用于书面语"},{"id":23811,"word":"无偏无颇","pinyin":"wú piān wú pō","abbr":"wpwp","explanation":"不偏向；不邪曲。同“无偏无陂”。","source":{"text":"无偏无颇，亲疏同也。","book":"汉·王符《潜夫记·释难》"},"example":{"text":"唐·韦肇《沙堤赋》：“～，庶托情于王道。”"},"similar":["无偏无陂","不偏不倚"],"usage":"作谓语、定语、状语；用于书面语"},{"id":23812,"word":"无兄盗嫂","pinyin":"wú xiōng dào sǎo","abbr":"wxds","explanation":"指无中生有的毁谤。","source":{"text":"人或毁不疑曰：‘不疑状貌甚美，然特毋柰其善盗嫂何！’不疑闻，曰：‘我乃无兄。’然终不自明。","book":"语本《汉书·直不疑传》"},"example":{"text":"昔直不疑无兄，世人谓之盗嫂……此皆以白为黑，欺天罔上者也。","book":"三国·魏·曹操《劐整齐风俗令》"},"usage":"作宾语、定语；用于书面语","story":["汉朝时期，有个美男子叫直不疑，他的兄长因病去世，与嫂子一起生活，招致当时的好事之徒的讥笑，说他与嫂子私通。直不疑听了这些流言蜚语，有理也讲不清，也就不搭理他们。人们以为他默认了，因此就流传他无兄盗嫂的典故"]},{"id":23813,"word":"无党无偏","pinyin":"wú dǎng wú piān","abbr":"wdwp","explanation":"形容处事公正，没有偏向。同“无偏无党”。","source":{"text":"无偏无党，王道荡荡；无党无偏，王道平平；无反无侧，王道正直。","book":"《尚书·洪范》"},"example":{"text":"所宜分多益寡，均利同恩，冀～，以劝勋效。","book":"《旧五代史·太祖纪》"},"similar":["不偏不倚","公正无私"],"usage":"作谓语、定语；用于处世"},{"id":23814,"word":"无关大体","pinyin":"wú guān dà tǐ","abbr":"wgdt","explanation":"比喻没有多大关系。","source":{"text":"这正叫做事属偶然，无关大体。","book":"清·文康《儿女英雄传》第39回"},"example":{"text":"虽然偶有些‘耳食之言’，又大抵是～的事。","book":"鲁迅《华盖集续编·不是信》"},"similar":["无关大局","无关大雅"],"opposite":["牵一发而动全身"],"usage":"作谓语；指不影响全局"},{"id":23815,"word":"无关大局","pinyin":"wú guān dà jú","abbr":"wgdj","explanation":"对整个局势没有关系或没有影响。","source":{"text":"至死不变，愿意带着花岗岩头脑去见上帝的人，肯定是有的，那也无关大局。","book":"毛泽东《介绍一个合作社》"},"example":{"text":"他的临阵脱逃对整个队来说是～的。"},"similar":["无关宏旨","无关大体"],"opposite":["举足轻重"],"usage":"作谓语、定语；比喻并不要紧"},{"id":23816,"word":"无关宏旨","pinyin":"wú guān hóng zhǐ","abbr":"wghz","explanation":"宏：大；旨：意义，目的。和主要意思没有关系。指意义不大或关系不大。","source":{"text":"宋儒所争，只今文古文字句，亦无关宏旨，均姑置弗议。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录一》"},"example":{"text":"《大乘缘起说》者，无过考证之文，不关宏旨。","book":"清·章炳麟《答梦庵》"},"similar":["无足轻重","无伤大雅"],"opposite":["至关紧要","举足轻重"],"usage":"作谓语、定语；指意义或关系不大"},{"id":23817,"word":"无关痛痒","pinyin":"wú guān tòng yǎng","abbr":"wgty","explanation":"痛痒：比喻疾苦或紧要的事。指与自身利害没有关系或无足轻重。","source":{"text":"那不关痛痒底是不仁。","book":"《朱子语类》卷一０一"},"example":{"text":"政府当初虽只不理那些招人头痛的教员，后来竟不理到～的官吏。","book":"鲁迅《呐喊·端午节》"},"similar":["无关紧要","无关大局"],"opposite":["事关全局","切肤之痛","息息相关"],"usage":"作谓语、定语；用于人或集体"},{"id":23818,"word":"无关紧要","pinyin":"wú guān jǐn yào","abbr":"wgjy","explanation":"紧要：急切的，重要的。不重要，不会影响大局。","source":{"text":"至其随手记注，平常率笔，无关紧要，盖亦有之。","book":"清·冯镇蛮《读〈聊斋〉杂说》"},"example":{"text":"可见字音一道，乃读书人不可忽略的。大贤学问渊博，故视为～；我们后学，却是不可少的。","book":"清·李汝珍《镜花缘》第十七回"},"similar":["无关大局"],"opposite":["中流砥柱","至关重要"],"usage":"作谓语、定语；指不会影响大局"},{"id":23819,"word":"无关重轻","pinyin":"wú guān zhòng qīng","abbr":"wgzq","explanation":"形容无关紧要，不值得重视。","source":{"text":"尚论者如略心术而以为无关重轻也，夫亦谁能尼之，但使其言而见重于社会也，吾不知于社会全体之心术，所影响何如耳。","book":"清·梁启超《论私德》"},"example":{"text":"而作为近支亲贵的醇王，在一般人心目中是个不容易想得起来的、～的人物。","book":"高阳《慈禧全传》六"}},{"id":23820,"word":"无其伦比","pinyin":"wú qí lún bǐ","abbr":"wqlb","explanation":"指事物非常完美，没有能跟它相比的。同“无与伦比”。","source":{"text":"海岳之才，无其伦比。","book":"清·陈田《明诗纪事丁签·边贡》"},"similar":["无与伦比"],"usage":"作谓语、定语；用于书面语"},{"id":23821,"word":"无其奈何","pinyin":"wú qí nài hé","abbr":"wqnh","explanation":"犹言无可奈何。指感到没有办法，只有这样了。","source":{"text":"朝廷无其奈何，只得出榜招谕宋江等。","book":"《宣和遗事》前集"},"example":{"text":"《白雪遗音·马头调·扯平》：“失烦与奴行方便，我也～，权说与他配成姻缘。”"},"similar":["无可奈何"],"usage":"作谓语、定语；用于书面语"},{"id":23822,"word":"无冬历夏","pinyin":"wú dōng lì xià","abbr":"wdlx","explanation":"指一年到头。","source":{"text":"这水呀，无冬历夏，总是一个劲儿地淌。","book":"《中国民间故事选·天池水》"},"usage":"作定语、状语；用于书面语"},{"id":23823,"word":"无冬无夏","pinyin":"wú dōng wú xià","abbr":"wdwx","explanation":"无论冬天还是夏天。指一年四季从不间断。","source":{"text":"无冬无夏，值其鹭羽。","book":"《诗经·陈风·宛丘》"},"example":{"text":"爱情本来是无日无夜，～的，但萧涧秋好像没有爱情。","book":"柔石《二月》五"},"similar":["连续不断","无间冬夏"],"usage":"作谓语、定语；指不分寒暑"},{"id":23824,"word":"无凭无据","pinyin":"wú píng wú jù","abbr":"wpwj","explanation":"没有凭证和根据。","source":{"text":"只要梦翁把用他的钱给了他，其余无凭无据的事，也断不能容他放肆。","book":"清·李宝嘉《官场现形记》第六回"},"example":{"text":"我们～，拿她也没办法。"},"similar":["无稽之谈"],"opposite":["真凭实据","有凭有据"],"usage":"作谓语、状语；指无凭证"},{"id":23825,"word":"无出其右","pinyin":"wú chū qí yòu","abbr":"wcqy","explanation":"出：超出；右：上，古代以右为尊。没有能超过他的。","source":{"text":"贤赵臣田叔、孟舒等十人，如见与语，汉庭臣无能出其右者。","book":"《史记·田叔列传》：“上尽召见，与语，汉廷臣毋能出其右者。”《汉书·高帝纪下》"},"example":{"text":"此二方专治一切肿毒，初起者速服速消，已溃者亦能败毒收口，大约古人痈疽各方，～了。","book":"清·李汝珍《镜花缘》第三十回"},"similar":["天下第一"],"usage":"作定语、谓语；指没有能超过他","story":["汉高祖刘邦北征匈奴回来路过赵地他女婿张敖处，张敖十分谦卑地接待他。刘邦故意傲慢无礼，破口大骂，张敖忍气吞声，手下贯高不堪受辱密谋刺杀刘邦。刘邦扣押了张敖和贯高，郎中田叔为张敖鸣冤。刘邦认为田叔的才能是无出其右的"]},{"id":23826,"word":"无利不起早","pinyin":"wú lì bù qǐ zǎo","abbr":"wlbqz","explanation":"指有利可图就很早起来。比喻为了图利而从事某事。","source":{"text":"我们都是急性子，无利不起早，讲究的是空手套白狼。","book":"王朔《玩儿的就是心跳》"},"usage":"作宾语、定语；用于口语"},{"id":23827,"word":"无利可图","pinyin":"wú lì kě tú","abbr":"wlkt","explanation":"图：谋取。没有利益可谋求。","source":{"text":"这两样事业，一时都无利可图，完全是为了公益，我开典当是为方便穷人。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"她从不干～的事情。"},"opposite":["有利可图"],"usage":"作谓语、定语；指人或事情"},{"id":23828,"word":"无功受禄","pinyin":"wú gōng shòu lù","abbr":"wgsl","explanation":"禄：旧时官吏的薪俸。没有功劳而得到报酬。","source":{"text":"在位贪鄙，无功而受禄，君子不得进仕尔。","book":"《诗·魏风·伐檀序》"},"example":{"text":"依我看来，这银子虽非是你设心谋得来的，也不是你辛苦挣来的，只怕～，反受其殃。","book":"明·冯梦龙《古今小说》卷二"},"similar":["坐享其成"],"opposite":["按劳分配"],"usage":"作谓语、宾语；用于自谦","story":["我国最早的诗歌总集《诗经》中有一首诗《伐檀》，深刻揭示当时的农奴主无功受禄、剥削奴隶的情景。奴隶们在烈日下挥汗如雨伐树，而腹中空空，抬眼望对岸奴隶主的深宅大院，堆满了粮食和猎物，心中有无限的悲愤"]},{"id":23829,"word":"无功而禄","pinyin":"wú gōng ér lù","abbr":"wgel","explanation":"没有功劳而得到报酬。同“无功受禄”。","source":{"text":"在位贪鄙，无功而受禄，君子不得进仕尔。","book":"《诗经·魏风·伐檀序》"},"similar":["无功受禄"],"usage":"作谓语、宾语；用于自谦"},{"id":23830,"word":"无功而返","pinyin":"wú gōng ér fǎn","abbr":"wgef","explanation":"指没有任何成效而回来。","source":{"text":"攸县、安仁均须越过茶陵，派人去过，无功而返。","book":"毛泽东《井冈山的斗争》"},"example":{"text":"高阳《胡雪岩全传·烟消云散》：“相继回店复命，却是～。”"},"similar":["白跑一趟"],"opposite":["满载而归"],"usage":"作谓语、宾语；用于处事"},{"id":23831,"word":"无动为大","pinyin":"wú dòng wéi dà","abbr":"wdwd","explanation":"以不变动为至善。“无为而治”的一种政治主张。"},{"id":23832,"word":"无动于中","pinyin":"wú dòng yú zhōng","abbr":"wdyz","explanation":"心里一点儿也没有触动。指对应该关心、注意的事情毫不关心，置之不理。","source":{"text":"以至顶到如今，偏偏碰着这位制军是不轻容易见客的，他见也好，不见也好，便也漠然无动于中了。","book":"清·李宝嘉《官场现形记》第三十三回"},"example":{"text":"面对集体财产遭到大火的威胁，我们怎么能～呢？"},"similar":["无动于衷"],"usage":"作谓语、定语；指没有反应"},{"id":23833,"word":"无动于衷","pinyin":"wú dòng yú zhōng","abbr":"wdyz","explanation":"衷：内心。心里一点儿也没有触动。指对应该关心、注意的事情毫不关心，置之不理。","source":{"text":"以至顶到如今，偏偏碰着这位制军是不轻容易见客的，他见也好，不见也好，便也漠然无动于中了。","book":"清·李宝嘉《官场现形记》第三十三回"},"example":{"text":"面对集体财产遭到大火的威胁，我们怎么能～呢？"},"similar":["无动于中","不动声色","麻木不仁"],"opposite":["感人肺腑"],"usage":"作谓语、定语；指漠不关心"},{"id":23834,"word":"无千待万","pinyin":"wú qiān dài wàn","abbr":"wqdw","explanation":"指不计其数；极多。同“无千无万”。","source":{"text":"黄科才听老爷分付，就狠跑到法场里。去看的无千待万，都说屈的多。","book":"明·徐渭《女状元》第三出"},"similar":["无千无万"],"usage":"作宾语、定语；指极多"},{"id":23835,"word":"无千无万","pinyin":"wú qiān wú wàn","abbr":"wqww","explanation":"指不计其数；极多。","source":{"text":"杨提辖，且住!你听我说：我在东京太师府里做奶公时，门下官军，见了无千无万，都向着我喏喏连声。","book":"明·施耐庵《水浒传》第十七回"},"example":{"text":"清·张南庄《何典》第二回：“那四面八方来看戏的野鬼，～，几乎把一片势利场都挤满了。”"},"similar":["成千上万","无千待万"],"usage":"作宾语、定语；指极多"},{"id":23836,"word":"无可不可","pinyin":"wú kě bù kě","abbr":"wkbk","explanation":"①无所不可，都能做到。②犹言不知如何是好。形容情绪激动至极。","source":{"text":"我则异于是，是无可无不可。","book":"《论语·微子》"},"example":{"text":"老太太见了，喜得～，见人就说：“到底是宝玉孝顺我，连一枝花儿也想的到。”","book":"清·曹雪芹《红楼梦》第三十七回"},"similar":["无可无不可"],"usage":"作谓语、定语、状语；用于兴奋"},{"id":23837,"word":"无可争辩","pinyin":"wú kě zhēng biàn","abbr":"wkzb","explanation":"没有什么可争辨的。表示确实无疑。","source":{"text":"太社不立于京都，当安所立。尤无可置辩矣。","book":"清·陈澧《东塾读书记》卷十六"},"example":{"text":"我们应该用～的道理说服人，而不是装腔作势，借以吓人。"},"similar":["无庸置辩"],"usage":"作谓语、定语；指确实无疑"},{"id":23838,"word":"无可厚非","pinyin":"wú kě hòu fēi","abbr":"wkhf","explanation":"厚：深重；非：非议，否定。不能过分责备。指说话做事虽有缺点，但还有可取之处，应予谅解。","source":{"text":"莽怒，免英官。后颇觉悟，曰：‘英亦未可厚非。’","book":"《汉书·王莽传中》"},"example":{"text":"作者的动机～，但客观效果则不尽符合作者的动机。","book":"茅盾《一九六０年短篇小说漫评》"},"similar":["无可非议","未可厚非"],"opposite":["评头品足"],"usage":"作谓语；用于人或事情等","story":["新朝时期，王莽推行一些改革措施，把西汉分封的各诸侯王降为平民，将周边分封的少数民族王降为侯，句町王不服，就派廉丹和史熊去攻打句町，他们强征民夫加重捐税，都大夫冯英上书劝他不要劳民伤财。王莽罢免了他，后又觉得冯英无可厚非"]},{"id":23839,"word":"无可名状","pinyin":"wú kě míng zhuàng","abbr":"wkmz","explanation":"没法形容。","source":{"text":"自由了，一种无可名状的轻松感，像一股热流涌上了我的心头。","book":"《花城》"},"similar":["不可名状"],"usage":"作谓语、定语；用于口语"},{"id":23840,"word":"无可否认","pinyin":"wú kě fǒu rèn","abbr":"wkfr","explanation":"不可能不承认。","source":{"text":"这是无可否认的事实。","book":"郭沫若《新文艺的使命》"},"example":{"text":"一般的作家们受着战争的强烈刺激，都显示着异常的激越，而较少平衡的静观。这是～的事实。","book":"郭沫若《新文艺的使命》"},"opposite":["矢口否认"],"usage":"作谓语、定语；用于事情等"},{"id":23841,"word":"无可奈何","pinyin":"wú kě nài hé","abbr":"wknh","explanation":"奈何：如何，怎么办。指感到没有办法，只有这样了。","source":{"text":"祸成矣，载可奈何。","book":"《战国策·燕策三》：“太子闻之，弛往，伏尸而哭极哀。既已无可奈何，乃遂收盛樊於期之首，函封之。”《史记·周本纪》"},"example":{"text":"大哥同杨太守来拿我，实是一毫不知，既被他连累，也～了。","book":"清·陈忱《水浒后传》第三回"},"similar":["百般无奈","迫不得已"],"opposite":["诚心诚意"],"usage":"作谓语、宾语、定语；形容毫无办法","story":["汉武帝对内实行严酷统治，对外不断扩张，对百姓横征暴敛，人们怨声载道，到了忍无可忍的地步，只好揭竿而起。汉武帝派兵镇压没有效果，就出台《沈命法》规定凡有起义军的地方的地方官一起治罪。地方官无可奈何只好隐瞒不报"]},{"id":23842,"word":"无可奈何花落去","pinyin":"wú kě nài hé huā luò qù","abbr":"wknhhlq","explanation":"对春花的凋落感到没有办法。形容留恋春景而又无法挽留的心情。后来泛指怀念已经消逝了的事物的惆怅心情。","source":{"text":"对春花的凋落感到没有办法。形容留恋春景而又无法挽留的心情。后来泛指怀念已经消逝了的事物的惆怅心情。"},"example":{"text":"对春花的凋落感到没有办法。形容留恋春景而又无法挽留的心情。后来泛指怀念已经消逝了的事物的惆怅心情。"},"similar":["无可奈何"],"usage":"作宾语、分句；指不能挽回"},{"id":23843,"word":"无可奉告","pinyin":"wú kě fèng gào","abbr":"wkfg","explanation":"没有什么可以告诉对方的。","source":{"text":"记者们七嘴八舌地提问。元豹一言不发。白度连声回答：‘无可奉告。’","book":"王朔《千万别把我当人》"},"example":{"text":"事关公司的财务机密，因此～。"},"usage":"作谓语；多用于外交辞令"},{"id":23844,"word":"无可如何","pinyin":"wú kě rú hé","abbr":"wkrh","explanation":"没有什么办法。","source":{"text":"若尽与之，则典章大怀，又不感恩；不与，则厚薄有殊，或生怨望。幸门一启，无可如何。","book":"《资治通鉴·唐纪·宪宗元和元年》"},"example":{"text":"知道事已～，只得叫他写了一张纸，自己带着女儿养活去了。","book":"清·吴敬梓《儒林外史》第五十四回"},"similar":["无可奈何","莫可奈何"],"usage":"作宾语、定语、状语；形容毫无办法"},{"id":23845,"word":"无可把握","pinyin":"wú kě bǎ wò","abbr":"wkbw","explanation":"把握：抓住。无法抓住。","source":{"text":"现在故乡的春天又在这异地的空中了，既给我久经逝去的儿时的回忆，而一蹶也带着无可把握的悲哀。","book":"鲁迅《风筝》"},"usage":"作谓语、定语；用于处事等"},{"id":23846,"word":"无可指摘","pinyin":"wú kě zhǐ zhāi","abbr":"wkzz","explanation":"指摘：责备，批评。没有什么可以指责的。表示做得妥当。","source":{"text":"刘大侉子进来坐定之后，署院先同别位候补道闲谈了几句，回过脸来看看刘大侉子浑身上下，倒也无可指摘。","book":"清·李宝嘉《官场现形记》第二十回"},"example":{"text":"～无可指摘了。","book":"蔡东藩《唐史演义》第八十回"}},{"id":23847,"word":"无可救药","pinyin":"wú kě jiù yào","abbr":"wkjy","explanation":"药：治疗。病已重到无法用药医治的程度。比喻已经到了无法挽救的地步。","source":{"text":"匪我言耄，尔用忧谑。多将熇熇，不可救药。","book":"《诗经·大雅·板》"},"example":{"text":"但彼此内溃已久，～，只能听之而已。","book":"鲁迅《书信集·致许寿裳》"},"similar":["病入膏肓","不可救药"],"opposite":["药到病除"],"usage":"作谓语；用于人或事"},{"id":23848,"word":"无可无不可","pinyin":"wú kě wú bù kě","abbr":"wkwbk","explanation":"表示怎样办都行，没有一定的主见。","source":{"text":"我则异于是，是无可无不可。","book":"《论语·微子》"},"example":{"text":"薛姨妈是个～的人，倒还易说。","book":"清·曹雪芹《红楼梦》第五十七回"},"similar":["可有可无","固执己见","模棱两可"],"opposite":["旗帜鲜明"],"usage":"作谓语、定语；指没有主见"},{"id":23849,"word":"无可柰何","pinyin":"wú kě nài hé","abbr":"wknh","explanation":"柰，同“奈”，怎样，如何。指感到没有办法，只有这样了。同“无可奈何”。"},{"id":23850,"word":"无可比伦","pinyin":"wú kě bǐ lún","abbr":"wkbl","explanation":"没有可以相比的。","source":{"text":"皇唐帝功，瑰特奇伟，前古无可比伦。","book":"唐·李翱《序》"},"similar":["无有伦比","无与伦比"],"usage":"作谓语、定语；用于书面语"},{"id":23851,"word":"无可比拟","pinyin":"wú kě bǐ nǐ","abbr":"wkbn","explanation":"比拟：比较。没有可以相比的。","source":{"text":"穷外无方，穷内非里，应有万般，无可比拟。","book":"宋·释惟白《续传灯录·江陵护国齐月禅师》"},"example":{"text":"这是一个绝大的变化，这是自有世界历史和中国历史以来～的大变化。","book":"毛泽东《新民主主义论》"},"similar":["无与伦比","举世无双","无可比伦"],"opposite":["不相上下","等量齐观"],"usage":"作谓语、定语；指没有可以相比的"},{"id":23852,"word":"无可比象","pinyin":"wú kě bǐ xiàng","abbr":"wkbx","explanation":"没有什么可与譬比。","source":{"text":"焕彻如寒霜素雪之状，又似钟乳垂穗之形，五色备具，无可比象。","book":"宋·张君房《云笈七签》卷七十一"},"similar":["无可比拟"],"usage":"作谓语、定语；指没有可以相比的"},{"id":23853,"word":"无可置喙","pinyin":"wú kě zhì huì","abbr":"wkzh","explanation":"犹言没话可说。","source":{"text":"则上下猜疑尽释，谗口无可置喙，身名俱泰，爵位永保，岂不善哉！","book":"清·褚人获《隋唐演义》第88回"},"similar":["无庸置言"],"usage":"作谓语、定语；用于书面语"},{"id":23854,"word":"无可置疑","pinyin":"wú kě zhì yí","abbr":"wkzy","explanation":"事实明显或理由充足，没有什么可以怀疑的。","source":{"text":"战国时某些地区已能制钢，无可置疑。","book":"范文澜《中国通史》第一编第五章第二节"},"example":{"text":"我对此事～。"},"similar":["无可争辩"],"usage":"作谓语；表示确凿不容怀疑"},{"id":23855,"word":"无可置辩","pinyin":"wú kě zhì biàn","abbr":"wkzb","explanation":"置辩：辩论，申辩（用于否定）。没有什么可以争辩的。表示确凿无疑。","source":{"text":"太社不立于京都，当安所立。尤无可置辩矣。","book":"清·陈澧《东塾读书记》卷十六"},"example":{"text":"我们应该用～的道理说服人，而不是装腔作势，借以吓人。"},"similar":["无可置疑"],"usage":"作谓语；表示确实无疑"},{"id":23856,"word":"无可言状","pinyin":"wú kě yán zhuàng","abbr":"wkyz","explanation":"不可以用言语表达。","example":{"text":"这场面～，十分悲惨。"},"similar":["不可言状"],"usage":"作谓语、定语；指不可以用言语表达"},{"id":23857,"word":"无可讳言","pinyin":"wú kě huì yán","abbr":"wkhy","explanation":"讳言：不敢说或不愿说。没有什么不可以直说的。指可以坦率地说。","source":{"text":"一步一步前进的现象却不能否认，而思想紊乱摇荡不定，也无可讳言。","book":"瞿秋白《饿乡纪程》"},"example":{"text":"～，闭关锁国对一国的经济发展没有好处。"},"similar":["直言相告","实话实说"],"usage":"作谓语；指可以坦率地说"},{"id":23858,"word":"无可辩驳","pinyin":"wú kě biàn bó","abbr":"wkbb","explanation":"辩驳：提出理由或根据来否定对方的意见。没有理由或根据来否定对方的意见。形容事实确凿，理由充足。","example":{"text":"他问一句，澄观点一下头，只觉他每一句话都是～。","book":"金庸《鹿鼎记》第二十三回"}},{"id":23859,"word":"无可非议","pinyin":"wú kě fēi yì","abbr":"wkfy","explanation":"非议：责备，批评。没有什么可以指责的。表示做得妥当。","source":{"text":"观《明夷待访录》所持重人民，轻君主，固无可非议也。","book":"清·章炳麟《王夫之从祀与杨度参机要》"},"example":{"text":"你们的盛情是可感的，动机是～的。","book":"欧阳山《三家巷》三一"},"similar":["无可厚非"],"opposite":["评头品足"],"usage":"作主语、宾语；形容人、事、思想等"},{"id":23860,"word":"无可非难","pinyin":"wú kě fēi nàn","abbr":"wkfn","explanation":"无可指责。","example":{"text":"他做事一向都～。"},"similar":["无可厚非"],"usage":"作谓语；指无可指责"},{"id":23861,"word":"无名之师","pinyin":"wú míng zhī shī","abbr":"wmzs","explanation":"没有正当理由出征的军队。","source":{"text":"今弃万安之术，而兴无名之师，窃为公惧之。","book":"《后汉书·袁绍传》"},"example":{"text":"他三镇知你远去，也不能兴～了，将军以为何如？","book":"清·孔尚任《桃花扇·移防》"},"usage":"作主语、宾语；用于军事等"},{"id":23862,"word":"无名之朴","pinyin":"wú míng zhī pǔ","abbr":"wmzp","explanation":"①道家指质朴自然、玄默无为之“道”为“无名之朴”。②未出名的璞玉。比喻不为人知的才识之士。亦作“无名之璞”。","source":{"text":"化而欲作，吾将镇之以无名之朴。","book":"春秋·楚·李耳《老子》"},"similar":["无名之璞"],"usage":"作宾语；用于书面语"},{"id":23863,"word":"无名之璞","pinyin":"wú míng zhī pú","abbr":"wmzp","explanation":"指未出名的璞玉。比喻不为人知的才识之士。同“无名之朴”。","source":{"text":"又马氏巧名已定，犹忽而不察，况幽深之才，无名之璞乎？","book":"晋·傅玄《赠扶风马钧序》"},"example":{"text":"唐·元稹《镇圭赋》：“苟能据于道而依于德，亦可以执～而逍遥乎大庭。”"},"similar":["无名之朴"],"usage":"作宾语；用于书面语"},{"id":23864,"word":"无名之辈","pinyin":"wú míng zhī bèi","abbr":"wmzb","explanation":"不出名的小人物。比喻没有名望或地位的人。","source":{"text":"小姐虽千金之躯，不才亦非无名之辈，也不辱没了你。","book":"明·许仲琳《封神演义》第五十六回"},"example":{"text":"你问的这人，你既称到他是个豪杰，大约也不是甚么～，你说给我听听。","book":"清·文康《儿女英雄传》第十五回"}},{"id":23865,"word":"无名孽火","pinyin":"wú míng niè huǒ","abbr":"wmnh","explanation":"名：称呼；孽：邪。说不出的邪火。指极大的怒气。","source":{"text":"那里我一把无名孽火，从脚跟下直透顶门，只得碍着众亲友不好动粗。","book":"清·文康《儿女英雄传》第十五回"},"usage":"作宾语、定语；指极大的怒气"},{"id":23866,"word":"无名小卒","pinyin":"wú míng xiǎo zú","abbr":"wmxz","explanation":"卒：古时指士兵。不出名的小兵。比喻没有名望或地位的人。","source":{"text":"只见城内一将飞马引军而出，大喝：‘魏延无名小卒，安敢造乱！’","book":"明·罗贯中《三国演义》第四十一回"},"example":{"text":"那些～，尽都解甲投降。","book":"清·张南庄《何典》第十回"},"similar":["无名鼠辈","芸芸众生"],"opposite":["英雄好汉","英雄豪杰","大名鼎鼎"],"usage":"作主语、宾语；指没有名望或地位的人"},{"id":23867,"word":"无名小辈","pinyin":"wú míng xiǎo bèi","abbr":"wmxb","explanation":"对平凡人物的蔑称。","source":{"text":"俺只道是蓝骁那厮，原来是个无名小辈！","book":"《龙图耳象》第92回"},"example":{"text":"清·姜振名《永庆升平前传》第68回：“好一个～，也来在我跟前送死！”"},"similar":["无名小卒"],"usage":"作宾语、定语；用于蔑称"},{"id":23868,"word":"无名火气","pinyin":"wú míng huǒ qì","abbr":"wmhq","explanation":"说不出来由的火气。"},{"id":23869,"word":"无名火起","pinyin":"wú míng huǒ qǐ","abbr":"wmhq","explanation":"无名火：怒火。形容发怒的样子。","source":{"text":"与君一把无名火，烧尽千愁万恨心。","book":"元·陶宗仪《南村辍耕录》卷十五"},"example":{"text":"四人只为～，眼前要定雌雄。","book":"明·许仲琳《封神演义》第七十五回"}},{"id":23870,"word":"无名英雄","pinyin":"wú míng yīng xióng","abbr":"wmyx","explanation":"姓名不被人知道的英雄人物。也指埋头苦干的人。","source":{"text":"诚以他日救此一方民者，必当赖将来无名之英雄。","book":"清·梁启超《新中国未来记·绪言》"},"example":{"text":"他做了好事从不留名，甘当～。"},"similar":["无名小卒"],"opposite":["赫赫有名"],"usage":"作宾语；用于人"},{"id":23871,"word":"无名鼠辈","pinyin":"wú míng shǔ bèi","abbr":"wmsb","explanation":"不出名的小人物。旧小说中经常出现的对敌方的蔑视称呼。","source":{"text":"吾被妖道邪术遭擒，岂有屈膝于你无名鼠辈？","book":"明·许仲琳《封神演义》第九十三回"},"example":{"text":"在他的眼里，冯国璋简直是个～，根本无法和他相比。","book":"刘凤舞《民国春秋》第二十六章"}},{"id":23872,"word":"无后为大","pinyin":"wú hòu wéi dà","abbr":"whwd","explanation":"旧时认为没有子孙后代是最为不孝的事。","source":{"text":"不孝有三，无后为大。","book":"《孟子·离娄上》"},"example":{"text":"凡乡愚误将子女送人空门的，本地父老即将“寿夭有命”以及“～”之义，向其父母恺切劝谕。","book":"清·李汝珍《镜花缘》第十二回"},"usage":"作宾语、定语；用于书面语"},{"id":23873,"word":"无咎无誉","pinyin":"wú jiù wú yù","abbr":"wjwy","explanation":"咎：过失；誉：称扬、赞美。既没有错误，也没有功绩。比喻工作表现一般。","source":{"text":"问武始侯昌，曰：‘无咎无誉。’上曰：‘如是可矣。’","book":"东汉·班固《汉书·赵敬肃王刘彭祖传》"},"example":{"text":"邓张作傅，～。","book":"南朝·宋·范晔《后汉书·邓彪张禹传赞》"},"usage":"作谓语、定语；比喻工作表现一般"},{"id":23874,"word":"无善可述","pinyin":"wú shàn kě shù","abbr":"wsks","explanation":"没有什么好处可说。"},{"id":23875,"word":"无噍类","pinyin":"wú jiào lèi","abbr":"wjl","explanation":"噍类：咬东西的动物，指活人。比喻没有一个人生存。","source":{"text":"尝攻襄城，襄城无噍类，所过无不残灭。","book":"东汉·班固《汉书·高帝纪》"},"usage":"作谓语；指没有活人"},{"id":23876,"word":"无噍类矣","pinyin":"wú jiào lèi yǐ","abbr":"wjly","explanation":"比喻没有一个人生存。","source":{"text":"尝攻襄城，襄城无噍类，所过无不残灭。","book":"《汉书·高帝纪》"}},{"id":23877,"word":"无地可容","pinyin":"wú dì kě róng","abbr":"wdkr","explanation":"指无处藏身，形容慌乱、羞愧至极，处境窘迫。","source":{"text":"李纨正要劝解，丫头来说，太太来了。袭人等此时无地可容，宝玉等赶忙出来迎接。","book":"清·曹雪芹《红楼梦》第94回"},"example":{"text":"回到故乡之后，又受着轻蔑、排斥、迫害，几乎～。","book":"鲁迅《朝花夕拾·范爱农》"},"similar":["无地自容"],"usage":"作谓语、定语、状语；形容非常羞愧"},{"id":23878,"word":"无地自厝","pinyin":"wú dì zì cuò","abbr":"wdzc","explanation":"犹无地自容。形容非常羞愧。","source":{"text":"夙宵战怖，无地自厝。","book":"晋·陈寿《三国志·魏志·管宁传》"},"similar":["无地自处","无地自容"],"usage":"作谓语、定语；用于处事"},{"id":23879,"word":"无地自处","pinyin":"wú dì zì chǔ","abbr":"wdzc","explanation":"犹无地自容。形容非常羞愧。","source":{"text":"合门惭惧，无地自处。","book":"《宋书·刘堪传》"},"example":{"text":"唐·韩愈《元和圣德诗》：“辟穷见窘，～。”"},"similar":["无地可容","无地自容","无地自厝"],"usage":"作谓语、定语；用于处事"},{"id":23880,"word":"无地自容","pinyin":"wú dì zì róng","abbr":"wdzr","explanation":"没有地方可以让自己容身。形容非常羞愧。","source":{"text":"夙宵战怖，无地自厝。","book":"《三国志·魏志·管宁传》"},"example":{"text":"大娘搜捉以出。女乃指福唾骂，福渐汗～。","book":"清·蒲松龄《聊斋志异·仇大娘》"},"similar":["问心有愧","无处藏身"],"opposite":["问心无愧","理直气壮","厚颜无耻"],"usage":"作谓语、定语、状语；形容非常羞愧"},{"id":23881,"word":"无坚不摧","pinyin":"wú jiān bù cuī","abbr":"wjbc","explanation":"形容力量非常强大，没有什么坚固的东西不能摧毁。","source":{"text":"（田）悦酒酣，自其骑之艺，拳勇之略，因曰：‘若蒙见用，无坚不摧。’","book":"《旧唐书·孔巢文传》"},"example":{"text":"其神勇艰苦的精神，充分显示了共产主义运动顽强的生命力，表现了共产党领导的军队～的战斗力量。","book":"刘伯承《回顾长征》"},"similar":["战无不胜","所向无敌"],"opposite":["不堪一击"],"usage":"作谓语、定语；指力量非常强大"},{"id":23882,"word":"无坚不陷","pinyin":"wú jiān bù xiàn","abbr":"wjbx","explanation":"形容力量非常强大，没有什么坚固的东西不能摧毁。同“无坚不摧”。","source":{"text":"每临战攻，常为率督，奋强突固，无坚不陷。","book":"三国·魏·曹操《表称乐进、于禁、张辽》"},"similar":["无坚不摧"],"usage":"作谓语、定语；用于书面语"},{"id":23883,"word":"无声无息","pinyin":"wú shēng wú xī","abbr":"wswx","explanation":"息：气息。没有什么动静。比喻没有名声，不被人知道。","source":{"text":"上天之载，无声无臭。","book":"《诗经·大雅·文王》"},"example":{"text":"一到里面去，即酱在无聊的纠纷中，～。","book":"鲁迅《书信集·致胡风》"},"similar":["默默无闻","无声无臭"],"opposite":["大名鼎鼎","举世闻名"],"usage":"作谓语、状语；用于人、事、物"},{"id":23884,"word":"无声无臭","pinyin":"wú shēng wú xiù","abbr":"wswx","explanation":"臭：气味。没有声音，没有气味。比喻没有名声，不被人知道。","source":{"text":"上天之载，无声无臭。","book":"《诗经·大雅·文王》"},"example":{"text":"我还要去找找经理，我请他答应在报上公布出来。我就怕他们蒙住搞，～就把你干了。","book":"沙汀《老烟的故事》"},"similar":["无声无息","默默无闻"],"opposite":["举世闻名"],"usage":"作状语；指默默无闻"},{"id":23885,"word":"无声无色","pinyin":"wú shēng wú sè","abbr":"wsws","explanation":"没有声音和色彩。形容平淡不动人。","source":{"text":"影片并没有真实地反映这场轰轰烈烈的群众运动，而把它写得冷冷清清，无声无色。","book":"《新华月报》1965年第9期"},"example":{"text":"一部～的作品是不会招人喜欢的"},"opposite":["有声有色"],"usage":"作谓语、定语；多用于作品等"},{"id":23886,"word":"无复孑遗","pinyin":"wú fù jié yí","abbr":"wfjy","explanation":"孑遗：遗留，剩余。没有再留下什么。","source":{"text":"周岁无复孑遗，水银后亦失所在。","book":"唐·牛峤《居延部落主》"},"example":{"text":"宋·张君房《云笈七签》第51卷：“山林草木，人民屋宅，兵寇鬼气，尽令消灭，～，四道豁然。”"},"usage":"作谓语、定语；用于书面语"},{"id":23887,"word":"无大不大","pinyin":"wú dà bù dà","abbr":"wdbd","explanation":"指极大。","source":{"text":"这仇用不着你报，早有一位天大地大，无大不大的盖世英雄，你报了仇去了。","book":"清·文康《儿女英雄传》第十八回"},"example":{"text":"朱自清《“海阔天空”与“古今中外”》：“世界是一张～的大网；‘我’只是一个极微的结子。”"},"usage":"作定语；用于书面语"},{"id":23888,"word":"无大无小","pinyin":"wú dà wú xiǎo","abbr":"wdwx","explanation":"①无论大小。指举国上下。②不分年长年幼、辈份大辈份小。","source":{"text":"公昔居管辖，恩信著闻，今无大无小，藏愿推奉。","book":"《周书·文帝纪上》"},"example":{"text":"这个人～的，很不讲礼貌。"},"similar":["无小无大","没大没小"],"usage":"作谓语、定语；指不礼貌"},{"id":23889,"word":"无天于上，无地于下","pinyin":"wú tiān yú shàng，wú dì yú xià","abbr":"wtyswdyx","explanation":"原指军将临战奋不顾身。","source":{"text":"将者死官也。故不得已而用之。无天於上，无地於下，无主於后，无敌於前。","book":"《尉缭子·武议》"},"example":{"text":"其临敌决战，不顾必死，无有二心。是故～，无敌於前，无主於後，进不求名，退不避罪。","book":"《淮南子·兵略训》"},"usage":"作宾语、定语；用于处事"},{"id":23890,"word":"无天无日","pinyin":"wú tiān wú rì","abbr":"wtwr","explanation":"犹言不见天日。比喻社会黑暗，见不到一点光明。","source":{"text":"况是人间瞻仰地，无天无日有何因之句，多及朝廷休咎，仁宗不之罪。","book":"清·唐训方《里语徵实》下卷"},"similar":["没日没夜"],"usage":"作定语、状语；用于书面语"},{"id":23891,"word":"无头告示","pinyin":"wú tóu gào shì","abbr":"wtgs","explanation":"用意不明的文告。也指缺乏主要内容的官样文章。","example":{"text":"你不要拿这～吓唬人。"},"similar":["官样文章","没头告示"],"usage":"作宾语、定语；指缺乏主要内容的官样文章"},{"id":23892,"word":"无头无尾","pinyin":"wú tóu wú wěi","abbr":"wtww","explanation":"没有线索；没有来由。","source":{"text":"这官司无头无尾，那贼人难捉难拿。","book":"元·郑廷玉《后庭花》第三折"},"example":{"text":"王杏元《天板蓝蓝》：“金枝听丈夫～捅出这么一句，就瞪着眼问起什么事。”"},"usage":"作谓语、定语、状语；多用于口语"},{"id":23893,"word":"无奇不有","pinyin":"wú qí bù yǒu","abbr":"wqby","explanation":"什么奇怪的事物都有。","source":{"text":"上海地方，无奇不有，倘能在那里多盘桓些日子，新闻还多着呢。","book":"清·吴趼人《二十年目睹之怪现状》第九回"},"example":{"text":"海底世界～，光是已知的动物就有三万多种。"},"similar":["稀奇古怪","千姿百态"],"opposite":["平淡无奇"],"usage":"作谓语、宾语、定语；用于奇异的现象"},{"id":23894,"word":"无奈我何","pinyin":"wú nài wǒ hé","abbr":"wnwh","explanation":"不能把我怎么样。即无法对付我。","source":{"text":"我主意拿的老老的，你纵有通天本领，也无奈我何。","book":"清·李汝珍《镜花缘》第84回"},"example":{"text":"你最终还是～。"},"similar":["没法奈何"],"usage":"作谓语；指不能把我怎么样"},{"id":23895,"word":"无好无恶","pinyin":"wú hào wú wù","abbr":"whwe","explanation":"好：喜爱；恶：憎恨，讨厌。指既不喜爱，也不憎恨。形容感情藏而不露。也指态度不明朗。","source":{"text":"无德无怨，无好无恶，万物崇一，阴阳同度，曰道，刑以弊之，政以命之，法以遏之，德以养之，道以明之。","book":"《左传·僖公九年》：“无好无恶，不忌不克之谓也。”《管子·正第》"},"example":{"text":"这三相中，还算宗勉清谨守法，若行简遇事模棱，无好无恶，嵩之执拗任性，恶问直言。","book":"蔡东藩《宋史演义》第九十三回"}},{"id":23896,"word":"无如之何","pinyin":"wú rú zhī hé","abbr":"wrzh","explanation":"没有任何办法。","source":{"text":"小人之使为国家。灾害并至，虽有善者，亦无如之何矣。","book":"《礼记·大学》"},"example":{"text":"楚势虽盛，若不乞降，早晚打破城池，虽晋亦～矣。","book":"明·冯梦龙《东周列国志》第四十八回"},"similar":["无如奈何","无如之奈"],"usage":"作谓语、宾语、定语；用于处事"},{"id":23897,"word":"无如之奈","pinyin":"wú rú zhī nài","abbr":"wrzn","explanation":"犹无如之何。没有任何办法。","source":{"text":"也是他买了个赔钱货，无如之奈。","book":"元·乔吉《两世姻缘》第四折"},"similar":["无如之何","无可奈何"],"usage":"作谓语、宾语、定语；用于处事"},{"id":23898,"word":"无如奈何","pinyin":"wú rú nài hé","abbr":"wrnh","explanation":"指无可奈何。","source":{"text":"小人之使为国家。灾害并至，虽有善者，亦无如之何矣。","book":"《礼记·大学》"},"example":{"text":"力士正欲下坑，倏然地裂复合，澹然也～。","book":"明·清溪道人《禅真逸史》第十七回"},"similar":["无可奈何","无如之何"],"usage":"作谓语、宾语、定语；用于处事"},{"id":23899,"word":"无妄之忧","pinyin":"wú wàng zhī yōu","abbr":"wwzy","explanation":"平白无故遭灾的忧虑。","source":{"text":"无妄之忧勿药喜，一善自足禳千灾。","book":"唐·韩愈《忆昨行和张十一》"},"usage":"作主语、宾语；用于书面语"},{"id":23900,"word":"无妄之灾","pinyin":"wú wàng zhī zāi","abbr":"wwzz","explanation":"无妄：意想不到的。指平白无故受到的灾祸或损害。","source":{"text":"六三，无妄之灾。或系之牛，行人之得。邑人之灾。","book":"《周易·无妄》"},"example":{"text":"能解百冤之结，能消～。","book":"明·吴承恩《西游记》第十二回"},"similar":["飞来横祸","飞灾横祸"],"opposite":["安居乐道"],"usage":"作主语、宾语；指受到的灾祸或损害","story":["战国时期，楚考烈王为没有儿子而发愁，相国春申君为他挑选很多女子均没有生儿子。春申君门客李园把妹妹李嫣送给春申君做妾，李嫣怀孕后就让春申君把她送给楚王。楚王得子后就立他为太子。朱英认为春申君有无妄之灾，李园就杀了他"]},{"id":23901,"word":"无妄之祸","pinyin":"wú wàng zhī huò","abbr":"wwzh","explanation":"犹无妄之灾。指平白无故受到的灾祸或损害。","source":{"text":"《战国策·楚策四》：“世有无妄之福，又有无妄之祸。今君处无妄之世，以事无妄之主，安不有无妄之人乎。”《晋书·戴若思传》：”自顷国遭无妄之祸，社稷有缀旒之危。“"},"example":{"text":"君不幸得～，闻之太息。","book":"清·蒲松龄《聊斋志异·神女》"},"similar":["毋妄之祸"],"opposite":["无妄之福"],"usage":"作主语、宾语；用于书面语"},{"id":23902,"word":"无妄之福","pinyin":"wú wàng zhī fú","abbr":"wwzf","explanation":"不期望获得而得到的幸福。","source":{"text":"世有无妄之福，又有无妄之祸。今君处无妄之世，以事无妄之主，安不有无妄之人乎。","book":"《战国策·楚策四》"},"example":{"text":"今楚王病久不愈，一旦宫车晏驾，少主嗣位，而君辅之，如伊尹、周公，俟王之年长，而反其政；若天与人归，遂南面即真。此所谓‘～’也。","book":"《东周列过志》第一百三回"},"similar":["毋妄之福"],"opposite":["无妄之祸"],"usage":"作主语、宾语；用于书面语"},{"id":23903,"word":"无始无终","pinyin":"wú shǐ wú zhōng","abbr":"wswz","explanation":"无起始，无终了。表示无丝毫时间限制的状态。","source":{"text":"无古无今，无始无终。","book":"战国·宋·庄周《庄子·知北游》"},"example":{"text":"做事不能～，没完没了。"},"similar":["没完没了"],"usage":"作谓语、定语；指没有时间限制"},{"id":23904,"word":"无始无边","pinyin":"wú shǐ wú biān","abbr":"wswb","explanation":"没有开始，没有边际。形容极其悠久广大。","source":{"text":"佛法者，理寂乎万古，迹兆乎中世，渊源浩博，无始无边，宇宙之所不知，数量之所不尽，盛乎哉！","book":"《南齐书·高逸传》"}},{"id":23905,"word":"无孔不入","pinyin":"wú kǒng bù rù","abbr":"wkbr","explanation":"孔：小洞。比喻有空子就钻。","source":{"text":"况且上海办捐的人，钻头觅缝，无孔不入。","book":"清·李宝嘉《官场现形记》第三十五回"},"example":{"text":"帝国主义对其殖民地的经济掠夺是～的。"},"similar":["见缝就钻","无空不入"],"opposite":["无懈可击"],"usage":"作谓语、定语、状语；指人爱钻营"},{"id":23906,"word":"无孔不钻","pinyin":"wú kǒng bù zuān","abbr":"wkbz","explanation":"比喻善于钻营。","source":{"text":"凡钻谋的人是无孔不钻的，就如这回出了买军装的事，不定有人走到他的门路，他也不免有点晓得，所以伍太守故意提出一声军装买办来，就惹起他何必委人到上海去买的话。","book":"清·吴趼人《近代社会龌龊史》第十六回"},"example":{"text":"我们都知道商人贩贱卖贵，追求赢利……走私的时候，漏税偷关，又是～，他们的足迹决不是政治力量所能阻止得住的。","book":"苏雪林《屈赋之谜》七"},"similar":["无孔不入"],"usage":"作谓语、定语、宾语；用于处世"},{"id":23907,"word":"无官一身轻","pinyin":"wú guān yī shēn qīng","abbr":"wgysq","explanation":"不做官了，感到一身轻松。封建官僚官以后常用这句话来自我安慰。现也泛指卸去责任后一时感到轻松。","source":{"text":"无官一身轻，有子万事足。","book":"宋·苏轼《贺子由生第四孙》诗"},"example":{"text":"交卸之后，又在长沙住了些时。常言道“～”，刘蕃台此时却有此等光景。","book":"清·李宝嘉《官场现形记》第三十七回"},"usage":"作定语、宾语、分句；用于自我安慰"},{"id":23908,"word":"无家可奔","pinyin":"wú jiā kě bēn","abbr":"wjkb","explanation":"没有家可回。指流离失所。同“无家可归”。","source":{"text":"然冥数已定，吾岂敢违?况我妻男并丧,无家可奔。","book":"明·冯梦龙《警世通言》卷二十五"},"example":{"text":"如今四海飘荡，～。","book":"清·俞万春《荡寇志》第七十六回"},"similar":["无家可归"],"usage":"作谓语、定语；用于人的处境等"},{"id":23909,"word":"无家可归","pinyin":"wú jiā kě guī","abbr":"wjkg","explanation":"没有家可回。指流离失所。","source":{"text":"如无家可归者，给田宅，使得存济。","book":"唐·陆贽《平朱泚后车驾还京大赦制》"},"example":{"text":"寺僧见了他无了根蒂，渐渐怠慢，不肯相留。要回故乡，已此～。","book":"明·凌濛初《初刻拍案惊奇》卷二十二"},"similar":["流离失所","离乡背井"],"opposite":["安居乐业"],"usage":"作谓语、定语；指无依无靠"},{"id":23910,"word":"无家无室","pinyin":"wú jiā wú shì","abbr":"wjws","explanation":"指孤身一人，无妻小。","source":{"text":"宋信虽是山东人，却无家无室，故一身流落京师，在缙绅门下游荡过日。","book":"明·罗贯中《平山冷燕》第五回"},"example":{"text":"我孑然一身，～，又无行李，除掉带在身边，更把他放在何处。","book":"清·李宝嘉《官场现形记》第三十回"},"similar":["孑然一身"],"opposite":["儿孙满堂"],"usage":"作谓语、定语；指人的处境"},{"id":23911,"word":"无容置疑","pinyin":"wú róng zhì yí","abbr":"wrzy","explanation":"不会错，毫无疑问。","example":{"text":"中国对保持着～的优势。"},"similar":["毫无疑问","不容置疑"],"opposite":["无稽之谈"],"usage":"作谓语、定语、状语；形容真实正确可靠"},{"id":23912,"word":"无容身之地","pinyin":"wú róng shēn zhī dì","abbr":"wrszd","explanation":"①指没有栖身立脚的地方。②指羞愧而无处可以藏身。","source":{"text":"臣昔忝近侍，豫蒙天恩，若其罪迹炳明，文字有证，非但显戮司败，以正国典，普天之下，自无容身之地。","book":"《宋书·谢灵运传》"},"example":{"text":"读书人全要养其廉耻，他没奈何来谢我。我若再从这话，～了。","book":"清·吴敬梓《儒林外史》第三十七回"},"similar":["无置锥之地"],"usage":"作谓语、定语；用于人的处境"},{"id":23913,"word":"无寇暴死","pinyin":"wu kou bào shi","abbr":"wkbs","explanation":"在没有变乱的情况下就死于非命"},{"id":23914,"word":"无尤无怨","pinyin":"wú yóu wú yuàn","abbr":"wywy","explanation":"尤：怨恨。毫无怨恨。","source":{"text":"他的态度是随便饮酒，乞食，高兴的时候就谈论和作文章，无尤无怨。","book":"鲁迅《而已集·魏晋风度及文章与药及酒之关系》"},"usage":"作谓语、定语；用于处事"},{"id":23915,"word":"无尽宝藏","pinyin":"wú jìn bǎo zàng","abbr":"wjbz","explanation":"形容物产或知识非常丰富，没有穷尽。","source":{"text":"如妙东之世，穰住之国，则有自然稻米，无尽宝藏，安求田蚕之利乎？","book":"北齐·颜之推《颜氏家训·归心》"},"example":{"text":"一名众宝积聚，二名～，三名远炽然，四名一切庄严聚。","book":"唐·释道世《法苑珠林》卷二十八"}},{"id":23916,"word":"无尽无休","pinyin":"wú jìn wú xiū","abbr":"wjwx","explanation":"没完没了。","source":{"text":"只见滔滔流水，无尽无休，彻夜车舟，熬尽人间万古。","book":"明·许仲琳《封神演义》第23回"},"example":{"text":"终于沉闷地听着远处的更锣声、风声、树叶声，和偶尔才肯留心到的身旁思懿的～的言语。","book":"曹禺《北京人》第三幕"},"similar":["没完没了"],"opposite":["到此为止"],"usage":"作谓语、定语；指没完没了"},{"id":23917,"word":"无尽无穷","pinyin":"wú jìn wú qióng","abbr":"wjwq","explanation":"没有止境，没有限度。同“无穷无尽”。","source":{"text":"无穷无尽是离愁，天涯地角寻思遍。","book":"宋·晏殊《踏莎行》"},"example":{"text":"你也不知吾所练阵中～之妙。非我逼你，是你等自取大厄！","book":"明·许仲琳《封神演义》第四十五回"},"similar":["无穷无尽"],"usage":"作谓语、定语、状语；形容没有限度"},{"id":23918,"word":"无巧不成书","pinyin":"wú qiǎo bù chéng shū","abbr":"wqbcs","explanation":"没有巧事就编不成书。比喻事情十分凑巧。","source":{"text":"东宫巧于捉弄，公主巧于动人，田生巧于委禽，宫女巧于假冒，所谓无巧不成书也。","book":"清·洪楝园《后南柯·招附》"},"example":{"text":"真是～，说曹操，曹操就到。"},"similar":["无巧不成话"],"usage":"作宾语、分句；比喻事情十分凑巧"},{"id":23919,"word":"无巧不成话","pinyin":"wú qiǎo bù chéng huà","abbr":"wqbch","explanation":"比喻事情十分凑巧。同“无巧不成书”。","source":{"text":"自古道：‘无巧不成话。’恰好有一人从墙下而过。","book":"明·冯梦龙《醒世恒言》卷三"},"example":{"text":"又道是“～”，其时同里有个人，姓胡名绥，有妻门氏，也生得十分娇丽。","book":"明·凌濛初《初刻拍案惊奇》卷三十二"},"similar":["无巧不成书"],"usage":"作宾语、分句；比喻事情十分凑巧"},{"id":23920,"word":"无师自通","pinyin":"wú shī zì tōng","abbr":"wszt","explanation":"没有老师的传授就能通晓。","source":{"text":"无师禅自解，有格句堪夸。","book":"唐·贾岛《送贺兰上人》诗"},"example":{"text":"这没有危险，又不犯法，资金也可多可少，而且任何人都可～。","book":"沙汀《淘金记》"},"similar":["自学成才"],"usage":"作谓语、定语；指自学"},{"id":23921,"word":"无平不陂","pinyin":"wú píng bù bēi","abbr":"wpbb","explanation":"陂：倾斜不平。没有哪一块平地是绝对平坦的。比喻事情再顺利也会有小的起伏。","source":{"text":"无平不陂，无往不复，艰贞无咎。","book":"《周易·泰》"},"example":{"text":"六解咨我三公，及尔庶司。岂敢怠安，～。","book":"《清史稿·乐志七》"}},{"id":23922,"word":"无平不陂，无往不复","pinyin":"wú píng bù bēi，wú wǎng bù fù","abbr":"wpbbwwbf","explanation":"陂：倾斜不平。没有哪一块平地是绝对平坦的，没有什么是直线向前而不会反复折回的。比喻事情再顺利也会有小的起伏。","source":{"text":"无平不陂，无往不复，艰贞无咎。","book":"《周易·泰》"}},{"id":23923,"word":"无平不颇","pinyin":"wú píng bù pō","abbr":"wpbp","explanation":"指凡事没有始终平直而不遇险阻的。","source":{"text":"九三，无平不颇，无往不复。","book":"《周易·泰》"},"example":{"text":"我们～，拿她也没办法。"},"usage":"作定语；用于书面语"},{"id":23924,"word":"无幽不烛","pinyin":"wú yōu bù zhú","abbr":"wybz","explanation":"黝暗处无不被照亮。比喻明察隐微。","source":{"text":"但神道聪明，无幽不烛，感公至诚，甘泽斯应。","book":"《周书·达奚武传》"},"example":{"text":"唐·李白《崇明寺佛顶尊胜陀罗尼幢颂》：“圣君垂拱南面，穆清而居，大明广运，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":23925,"word":"无底止","pinyin":"wú dǐ zhǐ","abbr":"wdz","explanation":"没有止境。","source":{"text":"胡转予于恤，靡所底止。","book":"《诗经·小雅·祈父》"},"example":{"text":"只见十阵内黑气迷天，阴云布合，悲风飒飒，冷雾飘飘，有无限鬼哭神嚎，竟～。","book":"明·许仲琳《封神演义》第四十四回"}},{"id":23926,"word":"无底洞","pinyin":"wú dǐ dòng","abbr":"wdd","explanation":"无法填满的洞。比喻满足不了的物质要求或者做不完的事。","source":{"text":"我说这些人，是个无底洞，多给他多要，少给他少要。","book":"清·李宝嘉《官场现形记》第三十五回"},"example":{"text":"不能再往里投资了，这样亏损下去简直是个～。"},"usage":"作宾语、定语；多用于厌弃的事"},{"id":23927,"word":"无庸争辩","pinyin":"wú yōng zhēng biàn","abbr":"wyzb","explanation":"无庸：无须，不用。无须争辩。"},{"id":23928,"word":"无庸置疑","pinyin":"wú yōng zhì yí","abbr":"wyzy","explanation":"事实明显或理由充足，没有什么可以怀疑的。","source":{"text":"无庸置疑，处在他眼下的地位，这种被别人关怀所引起的美好情感，简直无法用言语来表达……","book":"路遥《平凡的世界》第三卷第14章"},"example":{"text":"～，我是不会去的。"},"similar":["无庸置辩","千真万确"],"usage":"作谓语、补语；指用不着争辩"},{"id":23929,"word":"无庸置辩","pinyin":"wú yōng zhì biàn","abbr":"wyzb","explanation":"事实明显或理由充足，用不着争辩。","source":{"text":"尊重民族形式并不是复古，那是无庸置辩的。","book":"郭沫若《抗战以来的文艺思潮》"},"example":{"text":"这事～是你的错。"},"similar":["无可置疑","千真万确"],"usage":"作谓语、补语；指用不着争辩"},{"id":23930,"word":"无庸讳言","pinyin":"wú yōng huì yán","abbr":"wyhy","explanation":"没有什么不可以直说的。指可以坦率地说。","source":{"text":"亚非各国在社会制度方面的差异是无庸讳言的。","book":"周恩来《关于亚非会议的报告》"},"example":{"text":"～，现实生活还存在着歪风邪气。"},"similar":["直言不讳","直截了当"],"opposite":["讳莫如深","避而不谈"],"usage":"作谓语、分句；指可以坦率地说"},{"id":23931,"word":"无庸赘述","pinyin":"wú yōng zhuì shù","abbr":"wyzs","explanation":"用不着多说。","example":{"text":"这个道理简单明了，无庸赘述。"},"usage":"作谓语、定语；指用不着多说"},{"id":23932,"word":"无形之中","pinyin":"wú xíng zhī zhōng","abbr":"wxzz","explanation":"指不知不觉的情况下，无名义而有实质的情况下。","example":{"text":"～，她成为他贪污受贿的帮凶。"},"usage":"作状语；用于口语"},{"id":23933,"word":"无形之罪","pinyin":"wú xíng zhī zuì","abbr":"wxzz","explanation":"犹言莫须有之罪。指凭空捏造的罪行。","source":{"text":"绩著经纶，或恶其直道，或忿其正议，求其无形之罪，加以刎颈之诛。","book":"《隋书·炀帝纪》"},"usage":"作宾语；用于书面语"},{"id":23934,"word":"无形无影","pinyin":"wú xíng wú yǐng","abbr":"wxwy","explanation":"①不见形迹；完全消失。②形容虚构的事物。","source":{"text":"无形无影透人怀，四季能吹万物开。","book":"明·无名氏《破风诗》第三折"},"example":{"text":"郭沫若《行路难》：“他要走的心事消灭得～的。”"},"similar":["无影无形"],"usage":"作定语、状语；用于书面语"},{"id":23935,"word":"无影无形","pinyin":"wú yǐng wú xíng","abbr":"wywx","explanation":"不同形迹；完全消失。也形容虚构的事物。见“无形无影”。","source":{"text":"宋·朱熹《论语集注·述而篇》：“圣人全不曾说这话与人，这处无形无影，亦自难说。"},"example":{"text":"料斗他不过，即便取出芭蕉扇，幌一幌，一扇阴风，把行者扇得～，莫想收留得住。","book":"明·吴承恩《西游记》第五十九回"},"similar":["无形无影"],"usage":"作定语、状语；用于书面语"},{"id":23936,"word":"无影无踪","pinyin":"wú yǐng wú zōng","abbr":"wywz","explanation":"踪：踪迹。没有一点踪影。形容完全消失，不知去向。","source":{"text":"你那里挨挨桚桚，闪闪藏藏，无影无踪。","book":"元·吴昌龄《东坡梦》第三折"},"example":{"text":"那贾芸早说了几个“不用费事”，去的～了。","book":"清·曹雪芹《红楼梦》第二十四回"},"similar":["荡然无存","烟消云散"],"opposite":["有迹可寻","蛛丝马迹"],"usage":"作谓语、状语、定语；形容人或物体"},{"id":23937,"word":"无往不克","pinyin":"wú wǎng bù kè","abbr":"wwbk","explanation":"无论到哪里，没有不胜利的。","source":{"text":"以此乘吴，无往而不克矣。","book":"《通典·食货》"},"similar":["无往不胜"],"usage":"作谓语、定语；用于处事等"},{"id":23938,"word":"无往不利","pinyin":"wú wǎng bù lì","abbr":"wwbl","explanation":"所到之处，没有不顺利的。指处处行得通，办得好。","source":{"text":"所谓推之天地之间，无往而不利。","book":"宋·朱熹《朱子语类·孟子·问夫子加齐之卿相章》"},"example":{"text":"贫道今日幸把些尘垢全都拭净，此后是皓月当空，一无渣滓，诸位才女定是～。","book":"清·李汝珍《镜花缘》第九十回"},"similar":["战无不胜","一帆风顺"],"opposite":["进退两难","骑虎难下"],"usage":"作谓语；指处处行得通"},{"id":23939,"word":"无往不复","pinyin":"wú wǎng bù fù","abbr":"wwbf","explanation":"指未有往而不返的。指事物的运动是循环反复的。同“无平不顾”。","source":{"text":"初始往者必将有反复也。","book":"《易·泰》：“无平不陂，无往不复。”孔颖达疏"},"example":{"text":"而物极必反，亦往往于所备之外，有智出其上者，突起而胜之。～，天之道也。","book":"清·纪昀《阅微草堂笔记·姑妄听之四》"},"usage":"作宾语、定语；用于书面语"},{"id":23940,"word":"无往不胜","pinyin":"wú wǎng bù shèng","abbr":"wwbs","explanation":"无论到哪儿没有不胜利的。","source":{"text":"连长，我们军民一心，就无往不胜！","book":"京剧《红色娘子军》第二场"},"similar":["战无不胜","无往不利"],"opposite":["屡战屡败"],"usage":"作谓语；指所向无敌"},{"id":23941,"word":"无往而不胜","pinyin":"wú wǎng ér bù shèng","abbr":"wwebs","explanation":"往：到。无论到哪儿都能取得胜利。形容在任何情况下都能取得胜利。"},{"id":23942,"word":"无征不信","pinyin":"wú zhēng bù xìn","abbr":"wzbx","explanation":"征：证据，验证。没有证据的话或事不可信。","source":{"text":"上焉者，虽善无征，无征不信，不信民弗从。","book":"《礼记·中庸》"},"example":{"text":"所谓夏礼、殷礼都已文献无征。“～”，故他所重视的是“郁郁乎文哉”的周礼。","book":"郭沫若《十批判书·孔墨的批判二》"},"usage":"作谓语、宾语；用于书面语"},{"id":23943,"word":"无待蓍龟","pinyin":"wú dài shī guī","abbr":"wdsg","explanation":"待：等待；蓍龟：蓍草和龟甲，古人用以占卜。不等着用蓍草和龟甲占卜，而吉凶已经大白。表示事态发展显而易见。","source":{"text":"探赜索隐，钩深致远，以定天下吉凶，成天下之娓娓者，莫大乎蓍龟。","book":"《周易·系辞上》"},"example":{"text":"夫以中华全力，受制潢池，而欲从江左一隅，兼支大国，胜负之数，～矣。","book":"《清史稿·睿忠亲王多尔衮传》"}},{"id":23944,"word":"无得无丧","pinyin":"wú dé wú sàng","abbr":"wdws","explanation":"没有得也没有失。","source":{"text":"无得无丧，天长地久。","book":"五代·王定保《唐摭言·气义》"},"example":{"text":"明·无名氏《南牢记》第三折：“只愿的无是无非，无忧无喜，～。”"},"opposite":["有得有失"],"usage":"作谓语、定语；用于书面语"},{"id":23945,"word":"无微不至","pinyin":"wú wēi bù zhì","abbr":"wwbz","explanation":"微：微细；至：到。没有一处细微的地方不照顾到。形容关怀、照顾得非常细心周到。","source":{"text":"臣窃念主忧臣辱，义不得辞，跼蹐受命，退而差辟官吏、条列事目、调遣将士，凡所以为速发之计者，靡微不周。","book":"宋·魏了翁《辞免督视军马乞以参赞军事从丞相行奏札》"},"example":{"text":"还是在剑波十八岁的时候，要到战斗部队去，姐姐对这将要离开自己的弟弟，照顾得～。","book":"曲波《林海雪原》一"},"similar":["无所不知","关怀备至"],"opposite":["漠不关心"],"usage":"作谓语、定语、状语；指非常细心周到"},{"id":23946,"word":"无德而称","pinyin":"wú dé ér chēng","abbr":"wdec","explanation":"①无何恩德可以称道。②指德高不可言状。","source":{"text":"齐景公有马千驷，死之日，民无德而称焉。","book":"春秋·鲁·孔丘《论语·季氏》"},"example":{"text":"南朝·宋·范晔《后汉书·黄宪传论》：“将以道周性全，～乎？”"},"usage":"作谓语、定语；用于书面语"},{"id":23947,"word":"无心之过","pinyin":"wú xīn zhī guò","abbr":"wxzg","explanation":"过：过失，错误。不是有意识犯的错误。","source":{"text":"他既不知，也难谴责，此乃无心之过也。","book":"清·石玉昆《三侠五义》第三十一回"},"example":{"text":"雯青一生精研西北地理，不料得此结果，真是可叹！但平心而论，总是书生～罢了。","book":"清·曾朴《孽海花》第二十一回"}},{"id":23948,"word":"无心出岫","pinyin":"wú xīn chū xiù","abbr":"wxcx","explanation":"岫：山洞、峰峦。比喻无意出来做官。","source":{"text":"云无心以出岫，鸟倦飞而知还。","book":"晋·陶潜《归去来兮辞》"},"example":{"text":"随风万里，已～，浮游天地。","book":"宋·张炎《湘月·赋云溪》词"}},{"id":23949,"word":"无心恋战","pinyin":"wú xīn liàn zhàn","abbr":"wxlz","explanation":"没有心情去留恋战事。指不想做某事。","source":{"text":"那道人见倒了和尚，无心恋战，卖个破绽便走。","book":"明·施耐庵《水浒传》第六回"},"example":{"text":"我们军士，只认真是主帅被擒，军士都～。","book":"清·褚人获《隋唐演义》第53回"},"usage":"作谓语、定语；用于处事"},{"id":23950,"word":"无忧无虑","pinyin":"wú yōu wú lǜ","abbr":"wywl","explanation":"没有一点忧愁和顾虑。","source":{"text":"我做了个草庵中无忧无虑的僧家。","book":"元·郑廷玉《忍字记》第二折"},"example":{"text":"所以虽没有在家里自在，我也算是～的过着了。","book":"朱自清《笑的历史》"},"similar":["无牵无挂"],"opposite":["心事重重","忧心忡忡"],"usage":"作谓语、宾语、定语；用于人或动物"},{"id":23951,"word":"无怀葛天","pinyin":"wú huái gě tiān","abbr":"whgt","explanation":"无怀氏和葛天氏，传说中的上古帝王。后用以指上古淳朴之世。","source":{"text":"无怀葛天古遗民，种畲归来束涧薪。","book":"晋·陶潜《五柳先生传》：“衔觞赋诗，以乐其志，无怀氏之民欤？葛天氏之民欤？”宋·陆游《村舍》"},"example":{"text":"田野这样平静，河流这样柔和，一簇一簇的村子里好像都住着～之民，隐士生活的条件完全具备了。","book":"叶圣陶《倪焕之》二十一"}},{"id":23952,"word":"无思无虑","pinyin":"wú sī wú lǜ","abbr":"wswl","explanation":"没有什么可放在心上的。形容胸襟开阔，也形容无所用心。","source":{"text":"德人者，居无思，行无虑，不藏是非美恶。","book":"战国·宋·庄周《庄子·天地》"},"example":{"text":"～，这真是田家乐呵！","book":"鲁迅《呐喊·风波》"},"similar":["无忧无虑","清心寡欲"],"usage":"作谓语、定语；形容无所用心"},{"id":23953,"word":"无怠之声","pinyin":"wú dài zhī shēng","abbr":"wdzs","explanation":"没有怠惰的声音。形容自强不息。","source":{"text":"吾又奏之以无怠之声，调之以自然之命。","book":"《庄子·天运》"}},{"id":23954,"word":"无怨无德","pinyin":"wú yuàn wú dé","abbr":"wywd","explanation":"既没有怨恨，也没有恩德。指彼此间没有恩怨关系。","source":{"text":"无怨无德，不知所报。","book":"《左传·成公三年》"},"usage":"作谓语、定语；用于交往等"},{"id":23955,"word":"无恒安息","pinyin":"wu heng an xi","abbr":"whax","explanation":"不要长期贪求安逸。"},{"id":23956,"word":"无恨九泉","pinyin":"wú hèn jiǔ quán","abbr":"whjq","explanation":"九：虚数，指极深；九泉：也称“黄泉”，人死后埋葬的地方。指死而无恨。","source":{"text":"陛下若能哀其所请，留心览察，则臣夕陨于地，无恨九泉。","book":"《宋书·范泰传》"}},{"id":23957,"word":"无恶不为","pinyin":"wú è bù wéi","abbr":"webw","explanation":"没有哪件坏事不干的。指干尽了坏事。同“无恶不作”。","source":{"text":"嫉妒于弟，无恶不为，无孔怀之情也。","book":"《隋书·杨秀传》"},"similar":["无恶不造","无恶不作"],"usage":"作谓语、定语；指干尽了坏事"},{"id":23958,"word":"无恶不作","pinyin":"wú è bù zuò","abbr":"webz","explanation":"没有哪件坏事不干的。指干尽了坏事。","source":{"text":"宋自绍兴以来，主和议，增岁币，送尊号，处卑朝，括民膏，戮大将，无恶不作，无陋不为。","book":"清·郑燮《范县署中寄舍弟墨书》五"},"example":{"text":"八国联军侵略中国时，在北京杀人放火，～。"},"similar":["作恶多端","恶贯满盈"],"opposite":["乐善好施"],"usage":"作谓语、定语；指干尽了坏事"},{"id":23959,"word":"无恶不造","pinyin":"wú è bù zào","abbr":"webz","explanation":"没有哪件坏事不干的。指干尽了坏事。同“无恶不作”。","source":{"text":"然杀众生，加诸楚毒，妄自称善，无恶不造，如彼愚人。","book":"《百喻经·诈言马死喻》"},"similar":["无恶不为","无恶不作"],"usage":"作谓语、定语；指干尽了坏事"},{"id":23960,"word":"无患之患","pinyin":"wú huàn zhī huàn","abbr":"whzh","explanation":"潜伏的，还没有显露出来的祸患。","source":{"text":"圣人者，常治无患之患，故无患也。","book":"《淮南子·说山训》"}},{"id":23961,"word":"无情少面","pinyin":"wú qíng shǎo miàn","abbr":"wqsm","explanation":"不讲情面。","source":{"text":"我又见他几遍，不是无情少面之人。","book":"《西游补》第二回"},"similar":["六亲不认"],"usage":"作谓语、定语；用于为人等"},{"id":23962,"word":"无情无义","pinyin":"wú qíng wú yì","abbr":"wqwy","explanation":"没有一点情义。形容冷酷无情。","source":{"text":"你直如此狠毒，也被人笑话，说你无情无义。","book":"明·冯梦龙《古今小说·蒋兴哥重会珍珠衫》"},"example":{"text":"莫怪我～。","book":"巴金《沉默集·知识阶级》"},"similar":["绝情寡义"],"opposite":["柔情万种","一往情深"],"usage":"作谓语、定语；指人冷酷"},{"id":23963,"word":"无情无彩","pinyin":"wú qíng wú cǎi","abbr":"wqwc","explanation":"犹无精打彩。形容不高兴，提不起劲儿。","source":{"text":"又听的，寒风吹送鸿雁来。似俺这独自一个无情无彩。","book":"《白雪遗音·马头调·一轮明月》"},"similar":["无精打采"],"opposite":["兴高采烈"],"usage":"作宾语、定语；用于书面语"},{"id":23964,"word":"无情无绪","pinyin":"wú qíng wú xù","abbr":"wqwx","explanation":"没有心思，苦闷无聊。","source":{"text":"姐姐往常不曾如此无情无绪。","book":"元·王实甫《西厢记》第二本第一折"},"example":{"text":"只～，闲吟闲咏，江草江花。","book":"清·黄景仁《木兰花慢·京口清明》词"},"usage":"作谓语、状语；用于人的情绪等"},{"id":23965,"word":"无惜齿牙余论","pinyin":"wú xī chǐ yá yú lùn","abbr":"wxcyyl","explanation":"请人帮忙说好话。","source":{"text":"士子声名未立，应共奖成，无惜齿牙余论。","book":"《南史·谢脁传》"}},{"id":23966,"word":"无愧屋漏","pinyin":"wú kuì wū lòu","abbr":"wkwl","explanation":"屋漏：古代室内西北角。原指独处于室时慎守善德，无愧于心。后转义为心地光明，在暗中也不做坏事，不起邪念。","source":{"text":"惟存一矢慎之心，无愧屋漏。","book":"清·颜光敏《颜氏家藏尺牍·劳副都之辨》"},"similar":["不愧屋漏","不欺室漏"],"usage":"作谓语；形容为人正直"},{"id":23967,"word":"无愧衾影","pinyin":"wú kuì qīn yǐng","abbr":"wkqy","explanation":"表示没有做亏心事。","source":{"text":"刎行不愧影，独寝不愧衾。","book":"《宋史·蔡元定传》"},"usage":"作谓语、定语；用于处事"},{"id":23968,"word":"无懈可击","pinyin":"wú xiè kě jī","abbr":"wxkj","explanation":"懈：松懈，引伸为漏洞、破绽。没有一点弱点可以让人攻击。形容十分严密，找不到一点漏洞。","source":{"text":"击其懈怠，出其空虚。","book":"《孙子·计》：“攻其无备，出其不意。”曹操注"},"example":{"text":"前后不过四五个钟头。却也办得细密周到，～。","book":"蔡东藩、许廑父《民国通俗演义》第一二二回"},"similar":["天衣无缝","无隙可乘"],"opposite":["破绽百出","矛盾百出","有机可乘"],"usage":"作谓语、定语、状语；指十分严密"},{"id":23969,"word":"无所不为","pinyin":"wú suǒ bù wéi","abbr":"wsbw","explanation":"没有不干的事情。指什么坏事都干。","source":{"text":"揆其奸心，无所不为。","book":"《三国志·吴书·张温传》"},"example":{"text":"今专务游荡，～，老夫所以忧耳。","book":"明·罗贯中《三国演义》第二十八回"},"similar":["无恶不作","为所欲为","靡所不为"],"opposite":["循规蹈矩","安分守己"],"usage":"作谓语、定语；指什么坏事都干"},{"id":23970,"word":"无所不作","pinyin":"wú suǒ bù zuò","abbr":"wsbz","explanation":"没有不干的事情。指什么坏事都干。同“无所不为”。","source":{"text":"此人无所不作，欲效曳尾龟，岂可致邪。","book":"宋·李昉《太平广记》卷十五"},"example":{"text":"变诈奇哀，～。苟或败露，立便逃亡。","book":"宋·苏舜钦《论五事》"},"similar":["无所不为"],"usage":"作谓语、定语；指什么坏事都干"},{"id":23971,"word":"无所不包","pinyin":"wú suǒ bù bāo","abbr":"wsbb","explanation":"没有什么不被包括。形容包含的东西非常多。","source":{"text":"‘荡胸’句，言其量之无所不包。","book":"清·无名氏《杜诗言志》卷一"},"example":{"text":"写总结要突出重点，不要面面俱到，～。"},"similar":["包罗万象","无所不有"],"opposite":["一贫如洗","一无所有"],"usage":"作谓语；指包含的东西非常多"},{"id":23972,"word":"无所不及","pinyin":"wú suǒ bù jí","abbr":"wsbj","explanation":"没有地方不能达到。","source":{"text":"终身之命，无时成者也。故命无所不在，无所不施，无所不及，时或后而得之命也。","book":"《鹖冠子·环流五》"},"example":{"text":"宋·李清臣《欧阳文忠公谥议》：“其文卓然自成一家，比司马迁、扬雄、韩愈，～而有过之。”"},"usage":"作谓语、定语；用于书面语"},{"id":23973,"word":"无所不可","pinyin":"wú suǒ bù kě","abbr":"wsbk","explanation":"没有什么不可的。","source":{"text":"蚡事魏其侯无所不可，而爱数顷田？","book":"汉·荀悦《前汉记·武帝纪一》"},"example":{"text":"罪状就罪状，本来也～，不过近于无聊。（鲁迅《书信集·致章廷谦》）"},"similar":["无所不为"],"usage":"作谓语；指没有什么不可以的"},{"id":23974,"word":"无所不在","pinyin":"wú suǒ bù zài","abbr":"wsbz","explanation":"到处都存在，到处都有。","source":{"text":"或存太一在兆左右，坐卧背向无所不在也。","book":"宋·张君房《云笈七签》第44卷"},"example":{"text":"电灯光死去时发出的凄惨的叫声还在空中荡漾，虽然声音很低，却是～。","book":"巴金《家》四"},"usage":"作谓语、定语；形容到处都有"},{"id":23975,"word":"无所不备","pinyin":"wú suǒ bù bèi","abbr":"wsbb","explanation":"没有什么不具备的。","source":{"text":"前栽榆柳，后种松楠，桃李枣梅，无所不备，逍遥自在，乐业安居不题。","book":"《旧唐书·霍王元轨传》：“夫人有短，所以见其长，至于霍王，无所不备。”明·吴承恩《西游记》第二十八回"},"example":{"text":"有乘机应变攻守之法，避实击虚，投间抵隙，兼弱取乱之道，～。","book":"明·刘基《赠奕棋相子先序》"},"usage":"作宾语、定语；用于人或事物等"},{"id":23976,"word":"无所不备，则无所不寡","pinyin":"wú suǒ bù bèi，zé wú suǒ bù guǎ","abbr":"wsbbzwsbg","explanation":"寡：少，薄弱。没有不防备的地方，就没有不薄弱的地方。原指应重点设防，不宜分散兵力。后指不能面面俱到，要保证重点。","source":{"text":"故备前则后寡，备后则前寡；备左则右寡，备右则左寡；无所不备，则无所不寡。","book":"《孙子·虚实篇》"}},{"id":23977,"word":"无所不容","pinyin":"wú suǒ bù róng","abbr":"wsbr","explanation":"没有什么不能容纳。极言其宽广。","source":{"text":"是故君父之慈臣子，无所不容，教诲委曲，至夫斯极。","book":"清·龚自珍《太仓五中堂奏疏书后》"},"example":{"text":"他的气量大，几乎是～。"},"similar":["无所不包","宽宏大量"],"opposite":["小肚鸡肠"],"usage":"作谓语、定语；指人的气量等","story":["三国时期，魏文帝曹丕十分嫉妒他弟弟曹植的才华，担心他会造反，于是让他出京去自己的封地，同时派监国谒者监视他的一举一动。一次监国谒者诬陷曹植。曹丕迫于太后的压力，只好降他为安乡侯，标榜自己对天下无所不容，何况是骨肉兄弟呢"]},{"id":23978,"word":"无所不尽其极","pinyin":"wú suǒ bù jìn qí jí","abbr":"wsbjqj","explanation":"犹言竭尽其所有。","source":{"text":"《诗》曰：‘周虽旧邦，其命维新’，是故君子无所不用其极。","book":"《礼记·大学》"},"example":{"text":"他～的嘲弄，笑骂，攻击大赤包，而每一段这样的嘲骂都分行写下来，寄到报馆去，在文艺栏里登载出来。","book":"老舍《四世同堂》六十九"},"usage":"作定语、状语；用于处事等"},{"id":23979,"word":"无所不晓","pinyin":"wú suǒ bù xiǎo","abbr":"wsbx","explanation":"什么事情都知道，没有不懂得的。","source":{"text":"此女甚是聪慧……便是三教九流的说话，无所不通，无所不晓。","book":"元·吴昌龄《东坡梦》第一折"},"example":{"text":"章诒和《往事并不如烟·君子之交》：“形容才子不是常用‘诗词歌赋，～，琴棋书画，无所不通’吗？”"},"similar":["无所不通","无所不知"],"opposite":["一无所知"],"usage":"作谓语、定语；形容人的广见博识"},{"id":23980,"word":"无所不有","pinyin":"wú suǒ bù yǒu","abbr":"wsby","explanation":"什么都有（多指不好的事物）。","source":{"text":"始见台阁相向，门户千万，奇草珍木，无所不有。","book":"唐·李朝威《柳毅传》"},"example":{"text":"此录二十卷，天上天下，方内方外，～。","book":"明·毛晋《酉阳杂俎后识》"},"similar":["包罗万象","无所不包"],"opposite":["一无所有"],"usage":"作谓语、定语；形容非常全"},{"id":23981,"word":"无所不用其极","pinyin":"wú suǒ bù yòng qí jí","abbr":"wsbyqj","explanation":"极：穷尽。原意是无处不用尽心力。现指做坏事时任何极端的手段都使出来。","source":{"text":"《诗》曰：‘周虽旧邦，其命维新’，是故君子无所不用其极。","book":"《礼记·大学》"},"example":{"text":"日本侵略军所到之处，烧杀抢掠，～。"},"usage":"作谓语；指任何极端手段都使"},{"id":23982,"word":"无所不知","pinyin":"wú suǒ bù zhī","abbr":"wsbz","explanation":"什么事情都知道，没有不懂得的。","source":{"text":"圣人无所不知，无所不通，故得引而使之焉。","book":"《列子·黄帝》"},"example":{"text":"知之者为主，是故虽～，而有所不能行。","book":"宋·苏轼《中庸论上》"},"similar":["无所不晓"],"opposite":["一无所知"],"usage":"作谓语、定语；指万事通"},{"id":23983,"word":"无所不窥","pinyin":"wú suǒ bù kuī","abbr":"wsbk","explanation":"窥：看。没有什么不看的。形容人见得多。","source":{"text":"大师字君威，幼而爽悟，神情警发，标格严峻，人并敬惮之。身长七尺五寸，风仪甚伟。好学，无所不窥，善缀文。","book":"《北史·李大师传》"},"example":{"text":"我少年读书，～，本求一举成名，与朝家出力；因屡次不第，牢骚失意，变为词人。","book":"明·冯梦龙《喻世明言》卷十二"}},{"id":23984,"word":"无所不能","pinyin":"wú suǒ bù néng","abbr":"wsbn","explanation":"没有什么不能做的。指样样能做。","source":{"text":"近岁迎紫姑者极多，大率多能文章歌诗，有极工者，予屡见之，多自称蓬莱谪仙，医卜无所不能，棋与国手为敌。","book":"宋·沈括《梦溪笔谈》卷二十一"},"example":{"text":"从小风流俊雅，～。","book":"明·冯梦龙《醒世恒言》卷十三"},"similar":["神通广大"],"opposite":["无所事事","一无所长"],"usage":"作谓语、定语；指样样能做"},{"id":23985,"word":"无所不至","pinyin":"wú suǒ bù zhì","abbr":"wsbz","explanation":"至：到。指没有不到的地方。也指什么坏事都做绝了。","source":{"text":"既得之，患失之，苟患失之，无所不至矣。","book":"《论语·阳货》"},"example":{"text":"夜间絮絮叨叨，你问我答，凡街坊秽亵之谈，～。","book":"明·冯梦龙《古今小说》卷一"},"similar":["无所不为","为所不为","无微不至"],"opposite":["无恶不作"],"usage":"作谓语、状语；指没有不到的地方"},{"id":23986,"word":"无所不谈","pinyin":"wú suǒ bù tán","abbr":"wsbt","explanation":"没有什么不谈论。即什么都谈。","source":{"text":"他们无所不谈，谈主义，谈问题。","book":"叶圣陶《微波》"},"example":{"text":"他们～，谈主义，谈问题。","book":"叶圣陶《微波》"},"similar":["无话不谈"],"usage":"作谓语、定语；用于交际等"},{"id":23987,"word":"无所不通","pinyin":"wú suǒ bù tōng","abbr":"wsbt","explanation":"通：通晓。没有什么不通晓。形容知道的东西很多。","source":{"text":"孝悌之至，通于神明，光于四海，无所不通。","book":"《孝经·感应》"},"example":{"text":"便是三教九流的说话，～，无所不晓。","book":"元·吴昌龄《东坡梦》第一折"},"similar":["无所不知","无所不晓"],"opposite":["一窍不通"],"usage":"作谓语、定语；形容人的广见博识"},{"id":23988,"word":"无所事事","pinyin":"wú suǒ shì shì","abbr":"wsss","explanation":"事事：前一“事”为动词，做；后一“事”为名词，事情。闲着什么事都不干。","source":{"text":"其人为诗者，亦必闲散放荡，岩居川观，无所事事而后可。","book":"清·黄宗羲《万贞一诗序》"},"example":{"text":"上承总统指挥，下受委员成议，镇（整）日间～，反象似赘瘤一般。","book":"蔡东藩、许廑父《民国通俗演义》第一五回"},"similar":["无所作为","游手好闲"],"opposite":["有所作为","废寝忘食"],"usage":"作谓语、定语、状语；指无事可干"},{"id":23989,"word":"无所作为","pinyin":"wú suǒ zuò wéi","abbr":"wszw","explanation":"作为：作出成绩。没有做出任何成绩。指工作中安于现状，缺乏创造性。","source":{"text":"纵黄帝亦曾用兵战斗，亦不是全然无所作为也。","book":"宋·朱熹《朱子语类·论语七》"},"example":{"text":"停止的论点，悲观的论点，～和骄傲自满的论点，都是错误的。"},"similar":["无所事事","听天由命"],"opposite":["有所作为","知难而退"],"usage":"作谓语、定语、补语；指缺乏创造性"},{"id":23990,"word":"无所依归","pinyin":"wú suǒ yī guī","abbr":"wsyg","explanation":"没有依靠和归宿。","source":{"text":"是以皇天震怒，火烧其殿，六年之间大命不遂，祸殃仍重，竟令孝哀帝受其余灾，大失天心，夭命暴崩，又令共王祭祀绝废，精魂无所依归。","book":"《汉书·外戚传》"},"example":{"text":"老叔已去，小侄从今～矣！","book":"清·吴敬梓《儒林外史》第四十六回"},"similar":["无依无靠"],"usage":"作谓语、定语；用于人的处境"},{"id":23991,"word":"无所可否","pinyin":"wú suǒ kě fǒu","abbr":"wskf","explanation":"不赞同也不反对。","source":{"text":"李绛、李吉甫数争论于上前，礼部尚书同平章事权德舆居中无所可否，上鄙之。","book":"金·王若虚《君事实辨下》"},"example":{"text":"洪深《电影戏剧表演术》第一章：“本来是～的，现在有了确定的态度。”"},"similar":["不置可否"],"usage":"作谓语、定语；用于处事"},{"id":23992,"word":"无所回避","pinyin":"wú suǒ huí bì","abbr":"wshb","explanation":"回避：避忌。没有什么避忌或讳言的。","source":{"text":"茂辄纠案，无所回避。","book":"《后汉书·蔡茂传》"},"example":{"text":"欲以立懦夫，定民志，故辞多瓷肆，～，然得无恶其不文耶？","book":"章炳麟《革命军序》"},"similar":["无所顾忌"],"usage":"作谓语、定语；指不需要回避的"},{"id":23993,"word":"无所容心","pinyin":"wú suǒ róng xīn","abbr":"wsrx","explanation":"不在意，不留意。","source":{"text":"然而我向来无所容心于其间。","book":"鲁迅《呐喊·兔和猫》"},"example":{"text":"叶圣陶《老太太的头发》：“女儿来了以后，李太太作～的神态说，但语调实在不很自然。”"},"similar":["毫不在乎"],"usage":"作谓语、定语；用于处事"},{"id":23994,"word":"无所忌惮","pinyin":"wú suǒ jì dàn","abbr":"wsjd","explanation":"惮：怕。毫无顾忌，任意妄为。","source":{"text":"自江祏、始安王遥光等诛后，无所忌惮，日夜于后堂戏马，鼓噪为乐。","book":"《南史·齐本纪下》"},"example":{"text":"以其至刚蔑视于事而～也。","book":"《二程全书·伊川易传三》"},"similar":["肆无忌惮","无所畏惮"],"opposite":["瞻前顾后"],"usage":"作谓语、定语、状语；指毫无顾忌"},{"id":23995,"word":"无所忌讳","pinyin":"wú suǒ jì huì","abbr":"wsjh","explanation":"没有什么顾虑。","source":{"text":"《皮氏文薮》，陆氏丛书，皆句句明白，剔奸塞回，无所忌讳。","book":"宋·种放《退士传》"},"similar":["无所顾忌"],"usage":"作谓语、定语；指毫无顾忌"},{"id":23996,"word":"无所措手","pinyin":"wú suǒ cuò shǒu","abbr":"wscs","explanation":"形容没有办法，不知如何是好。同“无所错手足”。","source":{"text":"迨置市易务，而小商细民，无所措手。","book":"《宋史·韩琦传》"},"similar":["无所错手足","无所措手足"],"usage":"作谓语；指不知如何是好"},{"id":23997,"word":"无所措手足","pinyin":"wú suǒ cuò shǒu zú","abbr":"wscsz","explanation":"措：放置。手脚没有地方放。形容没有办法，不知如何是好。","source":{"text":"刑罚不中则民无所措手足。","book":"《论语·子路》"},"example":{"text":"至于个人缺点，如果不是与政治的和组织的错误有联系，则不必多所指摘，使同志们～。","book":"毛泽东《关于纠正党内的错误思想》"},"similar":["手足无措","无所措手"],"usage":"作谓语；指不知如何是好"},{"id":23998,"word":"无所施其伎","pinyin":"wú suǒ shī qí jì","abbr":"wssqj","explanation":"没有办法施展其伎俩手段。同“无所施其技”。","source":{"text":"争取了他们，帝国主义就完全孤立了，艾奇逊的一套就无所施其伎了。","book":"毛泽东《丢掉幻想，准备斗争》"},"similar":["无所施其技"],"usage":"作谓语；用于处事"},{"id":23999,"word":"无所施其技","pinyin":"wú suǒ shī qí jì","abbr":"wssqj","explanation":"没有办法施展其伎俩手段。","source":{"text":"虽狡狯，与李成寸步不离，他亦无所施其技。","book":"清·梁章钜《归田琐记·奴仆》"},"similar":["无所施其伎"],"usage":"作谓语；用于处事"},{"id":24000,"word":"无所施其术","pinyin":"wú suǒ shī qí shù","abbr":"wssqs","explanation":"施：实施。没有办法施展他的手腕。","source":{"text":"及至，婢缚既释，无所施其术。","book":"宋·洪迈《夷坚甲志·杨道人》"},"example":{"text":"今兵多而民不足，使萧何、刘晏复生，亦～，况于臣者何能为哉。","book":"《金史·侯挚传》"}},{"id":24001,"word":"无所用之","pinyin":"wú suǒ yòng zhī","abbr":"wsyz","explanation":"没有地方可以用上它。","source":{"text":"得志于齐，犹获石田也，无所用之。","book":"《左传·哀公十一年》"},"example":{"text":"魏虽有武士千群，～。江南人物如此，未可图也！","book":"明·罗贯中《三国演义》第八十六回"},"similar":["一无所用"],"usage":"作谓语、宾语；用于书面语"},{"id":24002,"word":"无所用心","pinyin":"wú suǒ yòng xīn","abbr":"wsyx","explanation":"没有地方用他的心。指不动脑筋，什么事情都不关心。","source":{"text":"饱食终日，无所用心，难矣哉。","book":"《论语·阳货》"},"example":{"text":"至于那些下民，他们有的是榆叶和海苔，他们“饱食终日，～”—就是并不劳心，原只要吃这些就够。","book":"鲁迅《故事新编·理水》"},"similar":["无所事事","无所作为"],"opposite":["有所作为","事必躬亲"],"usage":"作谓语、宾语、定语；指不动脑筋","story":["春秋时期，孔子经常教育他的学生向颜回学习，不要追慕富贵与享受，用心读书。孔子说如果一个人一天到晚吃得饱饱的没有事可干，不去用心思考问题，那就没有造就了。下棋的人虽然悠闲但也要用心，比起那些饱食终日、无所用心的人来要强多了"]},{"id":24003,"word":"无所畏忌","pinyin":"wú suǒ wèi jì","abbr":"wswj","explanation":"没有什么畏惧和顾忌。","source":{"text":"专权擅势，大作威福，纵姿不制，无所畏忌，为海内患害。","book":"汉·班固《汉书·王尊传》"},"example":{"text":"董艾放纵，～，中丞按奏，而取退免。","book":"《晋书·齐王冏传》"},"similar":["胆大妄为","无所畏惧","无所顾忌"],"opposite":["胆小怕事","瞻前顾后"],"usage":"作谓语、定语；指人胆大妄为","story":["汉元帝时期，中书谒者令石显依仗皇帝的宠信独断专行、作威作福、胡作非为、无所畏忌，百官都很畏惧他，连丞相匡衡、御史大夫张谭对他也要拍马奉承，敢怒不敢言。汉成帝即位后，降石显为中太仆，司隶校尉王尊才敢上书攻击匡衡等人不敢主持公道"]},{"id":24004,"word":"无所畏惧","pinyin":"wú suǒ wèi jù","abbr":"wswj","explanation":"畏惧：害怕。什么也不怕。形容非常勇敢。","source":{"text":"此是绍之壮辞，云巴人劲勇，见敌无所畏惧，非实瞎也。","book":"《魏书·董绍传》"},"example":{"text":"为了达到建设新中国的目的，对于什么困难我们共产党人也是～。","book":"毛泽东《在中国共产党全国宣传工作会议上的讲话》"},"similar":["无私无畏","所向无敌","临危不惧"],"opposite":["谨小慎微","胆小如鼠","畏首畏尾"],"usage":"作谓语、定语；指非常勇敢","story":["南北朝时期，北魏发生内乱，董绍上书希望能统率三千瞎眼的巴人定能将叛军消灭，肃宗看了奏折问太监徐绍巴人是否瞎眼，徐绍对肃宗说这是董绍的豪言壮语，说巴人非常骁勇凶悍，见了敌人无所畏惧，奋勇杀敌。肃宗下令让董绍立刻去平叛"]},{"id":24005,"word":"无所畏惮","pinyin":"wú suǒ wèi dàn","abbr":"wswd","explanation":"什么都不惧怕；什么都不顾忌。","source":{"text":"三河太守皆内倚中贵人，与三公有亲属，无所畏惮。","book":"西汉·司马迁《史记·田叔列传》"},"example":{"text":"宋·陆游《老学庵笔记》第六卷：“无畏者，许之～也。”"},"similar":["无所忌惮","无所顾惮","无所顾忌"],"opposite":["畏首畏尾","瞻前顾后"],"usage":"作谓语、定语、状语；用于处事"},{"id":24006,"word":"无所适从","pinyin":"wú suǒ shì cóng","abbr":"wssc","explanation":"适：归向；从：跟从。不知听从哪一个好。指不知怎么办才好。","source":{"text":"源殊派异，无所适从。","book":"《左传·僖公五年》：“一国三公，吾谁适从。”宋·姚宽《西溪从语》卷上"},"example":{"text":"某书应读某音，敝处未得高明指教，往往读错，以致后学～。","book":"清·李汝珍《镜花缘》第十六回"},"similar":["莫衷一是","不知所措"],"opposite":["择善而从"],"usage":"作谓语、宾语、定语；形容不知怎么办","story":["晋献公命令大夫士在浦池、屈地分别为晋公子重耳和夷吾修建城池。夷吾认为城池修得不好，就到晋献公那里告状。晋献公问士为什么不认真修。士说主太多让他无所适从。晋献公认为有道理，就逼太子申生自杀，并把重耳赶到狄国"]},{"id":24007,"word":"无所逃于天地之间","pinyin":"wú suǒ táo yú tiān dì zhī jiān","abbr":"wstytdzj","explanation":"在天地间没有可以逃避的地方。","source":{"text":"天下有大戒二：其一命也，其一义也。子之爱亲，命也，不可解于心；臣之君，义也，无适而非君也，无所逃于天地之间。","book":"《庄子·人间世》"},"example":{"text":"况古为列国之君臣，可去此适彼；今则一统之君臣，～。","book":"《明史·黄道周传》"}},{"id":24008,"word":"无所重轻","pinyin":"wú suǒ zhòng qīng","abbr":"wszq","explanation":"没有什么重要。","source":{"text":"我想一去不知道甚时才能回来（生命于我无所重轻），暂时须得像永告诀别似的，完一番‘人间的’手续。","book":"瞿秋白《饿乡纪程》"},"similar":["无足轻重"],"opposite":["举足轻重"],"usage":"作谓语、定语；用于人或事情等"},{"id":24009,"word":"无所错手足","pinyin":"wú suǒ cuò shǒu zú","abbr":"wscsz","explanation":"不知如何安放手足。形容没有办法，不知如何是好。","source":{"text":"刑罚不中，则民无所错手足矣。","book":"春秋·鲁·孔丘《论语·子路》"},"similar":["无所措手","无所措手足"],"usage":"作谓语；指不知如何是好"},{"id":24010,"word":"无所顾忌","pinyin":"wú suǒ gù jì","abbr":"wsgj","explanation":"顾：顾虑；忌：忌惮。没有什么顾虑、畏惧。","source":{"text":"称肆纵丑言，无所顾忌，要给诸将，欲阻兵构难。","book":"《晋书·陶侃传》"},"example":{"text":"等到后来张太太把抵押的凭据禀了上头存了案，他却～了。","book":"清·李宝嘉《官场现形记》第五十一回"},"similar":["肆无忌惮","毫不在乎"],"opposite":["畏首畏尾"],"usage":"作谓语、宾语；指没有什么顾虑"},{"id":24011,"word":"无所顾惮","pinyin":"wú suǒ gù dàn","abbr":"wsgd","explanation":"没有什么顾虑、畏惧。同“无所顾忌”。","source":{"text":"转司徒左长史，复为中庶子，领前军将军，迁侍中。每正言得失，无所顾惮，由是失旨。","book":"《宋书·蔡廓传》"},"example":{"text":"出身事主，期之效命，当职之日，～。","book":"《旧唐书·冯立传》"},"similar":["无所顾忌","肆无忌惮"],"opposite":["瞻前顾后","畏首畏尾"],"usage":"作谓语、宾语、状语；指没有什么顾虑"},{"id":24012,"word":"无拘无束","pinyin":"wú jū wú shù","abbr":"wjws","explanation":"拘、束：限制、约束。形容自由自在，没有牵挂。","source":{"text":"逐日家无拘无束，自在逍遥此一长生之美。","book":"明·吴承恩《西游记》第二回"},"example":{"text":"他放开缰绳，任由枣红马～和驰骋。"},"similar":["自由自在"],"opposite":["缩手缩脚"],"usage":"作谓语、定语；形容人或动物"},{"id":24013,"word":"无拘无碍","pinyin":"wú jū wú ài","abbr":"wjwa","explanation":"没有拘束，没有阻碍。形容悠然自得。","source":{"text":"日日深杯酒满，朝朝小圃花开，自歌自舞自开怀，且喜无拘无碍。","book":"宋·朱敦儒《西江月》词"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第一卷：“自歌自舞自开怀，且喜～。”"},"similar":["无拘无束","自由自在","无拘无缚"],"opposite":["碍手碍脚"],"usage":"作宾语、定语、状语；用于处事"},{"id":24014,"word":"无拘无缚","pinyin":"wú jū wú fù","abbr":"wjwf","explanation":"形容自由自在，没有牵挂。同“无拘无束”。","source":{"text":"山林之人，无拘无缚，得自在度日，故虽不求趣而趣近。","book":"明·袁宏道《叙陈正甫》"},"similar":["无拘无碍","无拘无束","自由自在"],"opposite":["碍手碍脚"],"usage":"作定语、状语；用于处事"},{"id":24015,"word":"无拳无勇","pinyin":"wú quán wú yǒng","abbr":"wqwy","explanation":"拳：力气，力量。没有武力，也没有勇气。","source":{"text":"彼何人斯，居河之麋；无拳无勇，职为乱阶。","book":"《诗经·小雅·巧言》"},"example":{"text":"我又～，真没有法，在手头的只有笔墨，能写这封信一类的不得要领的东西而已。","book":"鲁迅《两地书》八"},"usage":"作谓语、定语；指没有力量和勇气"},{"id":24016,"word":"无挂无碍","pinyin":"wú guà wú ài","abbr":"wgwa","explanation":"没有任何牵挂。同“无罣无碍”。","source":{"text":"想俺这出家儿的，要无挂无碍，无是无非。","book":"明·无名氏《拔宅飞升》第二折"},"example":{"text":"周立波《山那面人家》：“青春，康健，～的农业社里的生活……无一不是他们快活的源泉。”"},"similar":["无牵无挂","一无牵挂"],"opposite":["牵肠挂肚"],"usage":"作谓语、定语、状语；用于处事"},{"id":24017,"word":"无故呻吟","pinyin":"wú gù shēn yín","abbr":"wgsy","explanation":"犹言无病呻吟。比喻无真情实感而故弄文墨。","source":{"text":"感怀触绪，聊赋四章，匪曰无故呻吟，亦长歌当哭之意耳。","book":"清·曹雪芹《红楼梦》第87回"},"similar":["无病呻吟"],"opposite":["有感而发","见景生情"],"usage":"作谓语、宾语、定语；指装腔作势"},{"id":24018,"word":"无敌于天下","pinyin":"wú dí yú tiān xià","abbr":"wdytx","explanation":"天下都没有对手。形容力量强大无比。","source":{"text":"无敌于天下者，天吏也。","book":"战国·邹·孟轲《孟子·公孙丑上》"},"example":{"text":"只有国家强大才能～。"},"similar":["天下无敌"],"usage":"作谓语、定语；指天下无敌","story":["战国时期，孟子的学生向孟子请教如何才能使国家昌盛强大与无敌于天下。孟子回答他：首先是尊重、任用有德有才的贤人，带动士人为国效力；其次为商人提供场地，不征赋税；边境卡哨对旅客不收税，对农田不征税，免除劳役等"]},{"id":24019,"word":"无敌天下","pinyin":"wú dí tiān xià","abbr":"wdtx","explanation":"天下都没有对手。","source":{"text":"则无敌于天下。","book":"先秦·孟轲《孟子·公孙丑上》"},"example":{"text":"秦人以君言为必信，法令大行，国富兵强，～。","book":"唐·韩愈《论捕贼行赏表》"},"similar":["天下无敌"],"usage":"作谓语；指天下都没有对手"},{"id":24020,"word":"无斧凿痕","pinyin":"wú fù záo hén","abbr":"wfzh","explanation":"斧、凿：木工用的斧头和凿子。没有用斧头、凿子削刻的痕迹。比喻艺术品达到天然浑成的境界。","source":{"text":"观子美到州以后诗，简易纯熟，无斧凿痕，信是如弹丸矣。","book":"宋·蔡梦弼《杜工部草堂诗话》卷一"},"example":{"text":"大抵精于设色，如良工之～耳。","book":"宋·赵佶《宣和画谱·花鸟》"}},{"id":24021,"word":"无方之民","pinyin":"wú fāng zhī mín","abbr":"wfzm","explanation":"古指不知礼法的人。","source":{"text":"不隆礼，不由礼，谓之无方之民。","book":"《礼记·经解》"},"usage":"作宾语；用于书面语"},{"id":24022,"word":"无施不可","pinyin":"wú shī bù kě","abbr":"wsbk","explanation":"用在任何地方均甚得当。","source":{"text":"退之笔力，无施不可，而尝以诗为文章末事。","book":"宋·欧阳修《六一诗话》"},"usage":"作谓语、定语；用于书面语"},{"id":24023,"word":"无施不效","pinyin":"wú shī bù xiào","abbr":"wsbx","explanation":"指施行的每项策略都收效。","source":{"text":"与彧戮力同心，左右王略，发言授策，无施不效。","book":"《荀彧别传》"},"usage":"作宾语、定语；用于书面语"},{"id":24024,"word":"无旧无新","pinyin":"wú jiù wú xīn","abbr":"wjwx","explanation":"不分是旧交还是新交。","source":{"text":"各安其宅，各田其田，毋故毋新。","book":"《尚书大传》第二卷上"},"example":{"text":"周公摄政，听言下贤，均权布宠，～，唯仁是亲。","book":"南朝·宋·范晔《后汉书·申屠刚传》"},"similar":["一视同仁"],"usage":"作谓语、分句；指不分是旧交还是新交"},{"id":24025,"word":"无时无刻","pinyin":"wú shí wú kè","abbr":"wswk","explanation":"时时刻刻。表示毫不间断。","source":{"text":"自是行忘止，食忘餐，却象掉下了一件什么东西的，无时无刻不在心上。","book":"明·凌濛初《初刻拍案惊奇》卷六"},"example":{"text":"半个月来，她老是偷偷地看着剑波，她的心～不在恋着剑波，就好像是生活中不可缺少的空气一样。","book":"曲波《林海雪原》九"},"similar":["每时每刻"],"opposite":["三年五载"],"usage":"作状语；同“每时每刻”"},{"id":24026,"word":"无明业火","pinyin":"wú míng yè huǒ","abbr":"wmyh","explanation":"指怒火。","source":{"text":"休起无明业火，更休思，名利相干。","book":"金·马钰《满庭芳·赠赵雷二先生》词"},"example":{"text":"武松听了，心头那把～，高三千丈，冲破了青天。","book":"明·施耐庵《水浒全传》第三十一回"},"similar":["无名孽火"],"usage":"作宾语、定语；用于书面语"},{"id":24027,"word":"无明无夜","pinyin":"wú míng wú yè","abbr":"wmwy","explanation":"犹言不分昼夜。","source":{"text":"所以一耽了这件的滋味，定是无明无夜，抛家失业，失魂落魄，忘飧废寝的。","book":"《二刻拍案惊奇》卷八"},"similar":["没日没夜"],"usage":"作定语、状语；用于处事等"},{"id":24028,"word":"无明火","pinyin":"wú míng huǒ","abbr":"wmh","explanation":"无明：佛教中指“痴”或“愚昧”。指怒火。","source":{"text":"李逵听了这句话，那把无明火，高举三千丈，按纳不住，掿两斧抢上前，一斧一个，劈下头来。","book":"明·施耐庵《水浒传》第93回"},"example":{"text":"我一时心中泛起了～，顿时爆发。"},"similar":["无明业火"],"usage":"作宾语、定语；用于口语"},{"id":24029,"word":"无明火起","pinyin":"wú míng huǒ qǐ","abbr":"wmhq","explanation":"无明火：怒火。形容发怒。","source":{"text":"与君一把无明火，烧尽千愁万恨心。","book":"明·陶宗仪《辍耕录》第15卷"},"usage":"作谓语、定语；用于人的情绪"},{"id":24030,"word":"无是无非","pinyin":"wú shì wú fēi","abbr":"wswf","explanation":"没有是也没有不是。比喻空闲，没有事情。","source":{"text":"冷清清无是无非诵《南华》，就里乾坤大。","book":"元·贯石屏《村里迓鼓·隐逸》曲"},"example":{"text":"明·无名氏《宝光殿》第二折：“他故来仙人斗气，俺清闲～。”"},"similar":["无所事事"],"usage":"作谓语、宾语；用于书面语"},{"id":24031,"word":"无昼无夜","pinyin":"wú zhòu wú yè","abbr":"wzwy","explanation":"不分日夜；日日夜夜。","source":{"text":"再不到丁家来了，无昼无夜，一心只痴想着赵县君，思量寻机会挨光。","book":"明·凌濛初《二刻拍案惊奇》第14卷"},"example":{"text":"周立波《山乡巨变》：“～，你都要经心经意。”"},"similar":["没日没夜"],"usage":"作定语、状语；用于书面语"},{"id":24032,"word":"无暇顾及","pinyin":"wú xiá gù jí","abbr":"wxgj","explanation":"暇：闲暇；顾及：照顾到。没有功夫顾及到。","example":{"text":"那时只要一个“俄”字，已够惊心动魄，自然～时代和内容。","book":"鲁迅《而已集·扣丝杂感》"}},{"id":24033,"word":"无有乡","pinyin":"wú yǒu xiāng","abbr":"wyx","explanation":"原指什么都没有的地方，后指虚幻的境界。","source":{"text":"今子有大树，患其无用，何不树之于无何有之乡，广莫之野？","book":"《庄子·逍遥游》"},"example":{"text":"本是～，亦名不用处。","book":"唐·白居易《睡起晏坐》"}},{"id":24034,"word":"无有伦比","pinyin":"wú yǒu lún bǐ","abbr":"wylb","explanation":"没有比得上。","source":{"text":"祖宗封禅，自古帝王，无有伦比。","book":"唐·李翱《卓异记·叙封禅并两朝》"},"example":{"text":"清·张三礼《序》：“《琵琶》词意深挚，质朴高华，～。”"},"similar":["无与伦比"],"usage":"作谓语、定语；用于书面语"},{"id":24035,"word":"无服之丧","pinyin":"wú fú zhī sàng","abbr":"wfzs","explanation":"指有悲恻之心而无服丧之举。","source":{"text":"凡民有丧，匍匐救之，无服之丧也。","book":"《礼记·孔子闲居》"},"usage":"作宾语；用于书面语"},{"id":24036,"word":"无服之殇","pinyin":"wú fú zhī shāng","abbr":"wfzs","explanation":"古指未满八岁而夭折。因未成年，无丧服之礼，故称。","source":{"text":"不满八岁以下，皆为无服之殇。无服之殇，以日易月；以日易月之殇，殇而无服。","book":"《仪礼·丧服》"},"example":{"text":"太常礼院言准礼为～，诏特举哀成服。","book":"清·毕沅《续资治通鉴》卷七十二"},"usage":"作宾语；用于书面语"},{"id":24037,"word":"无本之木","pinyin":"wú běn zhī mù","abbr":"wbzm","explanation":"本：根；木：树。没有根的树。比喻没有基础的事物。"},{"id":24038,"word":"无本生意","pinyin":"wú běn shēng yì","abbr":"wbsy","explanation":"没有成本的买卖。","source":{"text":"继续无忧无虑地往返于省城和黄原的大小城镇，做他的无本生意。","book":"路遥《平凡的世界》第四卷第29章"},"example":{"text":"很多人都想做～。"},"similar":["无本买卖"],"opposite":["赔本买卖"],"usage":"作主语、宾语、定语；用于口语"},{"id":24039,"word":"无机可乘","pinyin":"wú jī kě chéng","abbr":"wjkc","explanation":"没有空子可钻。","example":{"text":"我让你～。"},"opposite":["有机可乘"],"usage":"作谓语、宾语；指没有空子可钻"},{"id":24040,"word":"无束无拘","pinyin":"wú shù wú jū","abbr":"wswj","explanation":"形容自由自在，没有牵挂。同“无拘无束”。","source":{"text":"你看这荒郊野外，走马射箭，舞剑抡枪，无束无拘，多少快活。","book":"清·褚人获《隋唐演义》第15回"},"similar":["无拘无束","无拘无缚","自由自在"],"opposite":["碍手碍脚"],"usage":"作谓语、定语；形容人或动物等"},{"id":24041,"word":"无根之木，无源之水","pinyin":"wú gēn zhī mù，wú yuán zhī shuǐ","abbr":"wgzmwyzs","explanation":"比喻没有根据的事物。","source":{"text":"我在伯父，犹衣服之有冠冕，木水之有本原。","book":"语出《左传·昭公九年》"},"similar":["无源之水，无本之木"],"usage":"作宾语；用于比喻句"},{"id":24042,"word":"无根无绊","pinyin":"wú gēn wú bàn","abbr":"wgwb","explanation":"绊：羁绊。孤单一个人没有牵挂。","source":{"text":"我老拙见是这般一个无根无绊的人，就招了他。","book":"明·吴承恩《西游记》第十八回"},"example":{"text":"我想，柳絮原是一件轻薄～的东西，然依我的主意，偏要把他说好了，才不落套。","book":"清·曹雪芹《红楼梦》第七十回"}},{"id":24043,"word":"无根无蒂","pinyin":"wú gēn wú dì","abbr":"wgwd","explanation":"蒂：花或瓜果与枝茎相连的部分。比喻没有依靠，没有牵累。","source":{"text":"徒乐枕经籍书，纡体衡门，上无所蒂，下无所根。","book":"东汉·班固《汉书·叙传上》"},"example":{"text":"新的艺术，没有一种是～，突然发生的。","book":"鲁迅《书信集·致魏猛克》"},"similar":["无依无靠","无了根蒂"],"usage":"作谓语、定语；指没有依靠"},{"id":24044,"word":"无根而固","pinyin":"wú gēn ér gù","abbr":"wgeg","explanation":"固：牢固。没有根柢却能牢固。比喻有共同的思想感情作基础。","source":{"text":"管仲复于桓公曰：‘无翼而飞者，声也；无根而固者，情也。’","book":"《管子·戒》"},"usage":"作定语；用于比喻句"},{"id":24045,"word":"无欺暗室","pinyin":"wú qī àn shì","abbr":"wqas","explanation":"欺：欺骗自己；暗室：人家看不见的地方。在没有人看见的地方，也不做见不得人的事。","source":{"text":"藻镜官方，品裁人物，门惊如市，不惭屋漏，心抱如冰，无欺暗室。","book":"唐·欧阳询《艺文类聚》卷四十八"},"example":{"text":"若果如县臣所称，窥探而～，则又擅千古风化之美，而流一时名教有光者也。","book":"清·明教中人《好逑传》第十八回"}},{"id":24046,"word":"无毁无誉","pinyin":"wú huǐ wú yù","abbr":"whwy","explanation":"既无毁谤，也无称誉。形容很平常。","source":{"text":"无誉无訾，一龙一蛇，与时俱化，而无肯专为。","book":"《庄子·山木》"},"example":{"text":"将以乡党自好，～者为完人乎？则趼人怒目翕张，不屑为也。","book":"鲁迅《小说旧闻钞·二十年目睹之怪现状》"},"similar":["普普通通"],"usage":"作谓语、定语；指非常一般"},{"id":24047,"word":"无毒不丈夫","pinyin":"wú dú bù zhàng fū","abbr":"wdbzf","explanation":"要成就大事业必须手段毒辣，技高一筹。","source":{"text":"你不辩贤愚，无毒不丈夫。","book":"元·王实甫《西厢记》第五本第四折"},"example":{"text":"那姪少爷见如此情形，又羞又怒又怕，回去之后，忽然生了一个‘～’的主意来。","book":"清·吴趼人《二十年目睹之怪现状》"},"similar":["恨小非君子"],"usage":"作宾语、分句；用于劝诫人"},{"id":24048,"word":"无毛大虫","pinyin":"wú máo dà chóng","abbr":"wmdc","explanation":"没有毛的老虎。比喻光从表面不易看破的凶恶之物。","source":{"text":"四件事无毛大虫，再休与酒色财气相逢。","book":"元·史九敬先《庄周梦》第一折"},"usage":"作宾语、定语；用于比喻句"},{"id":24049,"word":"无法可施","pinyin":"wú fǎ kě shī","abbr":"wfks","explanation":"法：办法；施：施展。没有办法可用。","source":{"text":"马元无法可施，莫能挣扎。","book":"明·许仲琳《封神演义》第六十一回"},"example":{"text":"且说贾琏打听得父兄之事不很妥，～，只得回到家中。","book":"清·曹雪芹《红楼梦》第一百六回"}},{"id":24050,"word":"无法无天","pinyin":"wú fǎ wú tiān","abbr":"wfwt","explanation":"法：法纪；天：天理。旧指不顾国法和天理，任意干坏事。现多形容违法乱纪，不受管束。","source":{"text":"你在家不读书也罢了，怎么又做出这无法无天的事来。","book":"清·曹雪芹《红楼梦》第三十三回"},"example":{"text":"统领的兵，一个个～，我们的苦头也吃够了，实在说不出一个“好”字。","book":"清·李宝嘉《官场现形记》第十五回"},"similar":["胡作非为","为非作歹"],"opposite":["安分守己","循规蹈矩"],"usage":"作谓语、定语、补语；指违法乱纪"},{"id":24051,"word":"无波古井","pinyin":"wú bō gǔ jǐng","abbr":"wbgj","explanation":"古井：枯井。比喻内心恬静，情感不为外界事物所动。","source":{"text":"无波古井水，有节秋竹竿。","book":"唐·白居易《赠元稹》诗"}},{"id":24052,"word":"无洞掘蟹","pinyin":"wú dòng jué xiè","abbr":"wdjx","explanation":"比喻无事生非，故意找岔子。","source":{"text":"在城棍徒无风起浪，无洞掘蟹，亏得当时立地就认了，这些人还道放了空箭，未肯住手，致有今日之告。","book":"明·凌濛初《二刻拍案惊奇》第十卷"},"similar":["无事生非"],"usage":"作宾语、定语；多用于比喻句"},{"id":24053,"word":"无济于事","pinyin":"wú jì yú shì","abbr":"wjys","explanation":"济：补益，帮助。对事情没有什么帮助或益处。比喻不解决问题。","source":{"text":"如今远水救不得近火，就是我们再帮点忙，至多再凑了几百银子，也无济于事。","book":"清·李宝嘉《官场现形记》第五十二回"},"example":{"text":"遇事需当机立断，任何犹豫和怯懦都是～的。"},"similar":["杯水车薪","于事无补"],"opposite":["行之有效","立竿见影"],"usage":"作谓语；比喻不解决问题"},{"id":24054,"word":"无涯之戚","pinyin":"wú yá zhī qī","abbr":"wyzq","explanation":"无尽的忧伤。涯：边际。戚：忧伤。","source":{"text":"吾不可去，汝不肯来，恐旦暮死，而汝抱无涯之戚也。","book":"唐·韩愈《蔡十二郎文》"},"example":{"text":"他陷入～之中"},"usage":"作宾语；用于书面语"},{"id":24055,"word":"无涯无际","pinyin":"wú yá wú jì","abbr":"wywj","explanation":"涯：边际，极限；际：边缘处。形容范围极为广阔。","source":{"text":"好好的平原旷野，却怎么弥弥漫漫，一望都是白浪滔天，无涯无际，却似个东洋大海。","book":"明·施耐庵《水浒传》第95回"},"example":{"text":"清·无垢道人《八仙全传》第20回：“出入于四维，往来于八极，冥冥茫茫，～。”"},"similar":["无边无际"],"usage":"作谓语、定语；形容广阔"},{"id":24056,"word":"无源之水，无本之木","pinyin":"wú yuán zhī shuǐ，wú běn zhī mù","abbr":"wyzswbzm","explanation":"源：水源；本：树根。没有源头的水，没有根的树。比喻没有基础的事物。","source":{"text":"我在伯父，犹衣服之有冠冕，木水之有本原。","book":"《左传·昭公九年》"},"example":{"text":"理性的东西所以靠得住，正是由于它来源于感性，否则理性的东西就成了～。","book":"毛泽东《实践论》"},"similar":["无根之木，无源之水"],"usage":"作宾语；指没有基础的事物"},{"id":24057,"word":"无源之水，无本之末","pinyin":"wú yuán zhī shuǐ，wú běn zhī mò","abbr":"wyzswbzm","explanation":"没有源头的水，没有根的树。比喻没有基础的事物。"},{"id":24058,"word":"无烦复往","pinyin":"wú fán fù wǎng","abbr":"wffw","explanation":"不用烦劳再来往了。","source":{"text":"王家见二谢，倾筐倒庋；见汝辈来，平平尔。汝可无烦复往。","book":"南朝·宋·刘义庆《世说新语·贤媛》"}},{"id":24059,"word":"无父挝翁","pinyin":"wú fù zhuā wēng","abbr":"wfww","explanation":"挝：打；翁：指岳父。妻子的父亲已过逝，可是人却说他打岳父。比喻无故受人诽谤中伤。","source":{"text":"尝见，上曰：‘闻卿为使，挝妇翁，不过从兄饭，宁有之邪？’对曰：‘臣三娶妻，皆无父。’","book":"《东观汉纪·第五伦传》"}},{"id":24060,"word":"无父无君","pinyin":"wú fù wú jūn","abbr":"wfwj","explanation":"孟轲斥责墨翟、杨朱之语。后以讥刺无伦常者。","source":{"text":"杨氏为我，是无君也；墨氏兼爱，是无父也。无父无君，是禽兽也。","book":"战国·邹·孟轲《孟子·滕文公》"},"example":{"text":"冰心《斯人独憔悴》：“率性连白鞋白帽，都穿戴起来，这便是～的证据了。”"},"usage":"作宾语、定语；用于讽刺人"},{"id":24061,"word":"无牵无挂","pinyin":"wú qiān wú guà","abbr":"wqwg","explanation":"形容没有拖累，非常放心。","source":{"text":"北侠原是无牵无挂之人，不能推辞，同上茉花村去了。","book":"清·石玉昆《三侠五义》第61回"},"example":{"text":"他只想往前走，仿佛走到什么地方他必能找回原来的自己，那个～，纯洁，要强，处处努力的祥子。","book":"老舍《骆驼祥子》"},"similar":["无忧无虑"],"opposite":["牵肠挂肚","魂牵梦绕"],"usage":"作谓语、定语；形容没有拖累"},{"id":24062,"word":"无独有偶","pinyin":"wú dú yǒu ǒu","abbr":"wdyo","explanation":"独：一个；偶：一双。不只一个，竟然还有配对的。表示两事或两人十分相似。","source":{"text":"闻简某系蜀人，而此女亦是蜀人，可谓无独有偶。","book":"清·壮者《扫迷帚》第十三回"},"example":{"text":"先生与这位老夫子，可称～。","book":"刘半农《奉答王敬轩先生》"},"similar":["成双成对"],"opposite":["独一无二","举世无双"],"usage":"作宾语、定语、分句；指不只一个"},{"id":24063,"word":"无理取闹","pinyin":"wú lǐ qǔ nào","abbr":"wlqn","explanation":"毫无理由地跟人吵闹。指故意捣乱。","source":{"text":"鸣声相呼和，无理只取闹。周公所不堪，洒灰垂典教。","book":"唐·韩愈《答柳州食虾蟆》诗"},"example":{"text":"对那些～的人，我们决不应该迁就。"},"similar":["无事生非","寻事生非"],"opposite":["息事宁人"],"usage":"作谓语、宾语、状语；指故意吵闹"},{"id":24064,"word":"无瑕可击","pinyin":"wú xiá kě jī","abbr":"wxkj","explanation":"瑕：比喻事物的缺点。完美无缺，无可指责。","source":{"text":"关于人物的性格、心理、习惯，时代的风俗、制度、精神，总要尽可能的收集材料，务求其无瑕可击。","book":"郭沫若《历史·史剧、现实》"},"example":{"text":"这东西到了～的地步。"},"similar":["无懈可击"],"usage":"作谓语、定语；指无可指责"},{"id":24065,"word":"无瑕白玉","pinyin":"wú xiá bái yù","abbr":"wxby","explanation":"明·施耐庵《水浒全传》第八十八回：“足穿云霞珍珠履，手执无瑕白玉圭。”","source":{"text":"足穿云霞珍珠履，手执无瑕白玉圭。","book":"明·施耐庵《水浒全传》第八十八回"},"example":{"text":"好一似，～遭泥陷，又何须，王孙公子叹无缘。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["白玉无瑕"],"usage":"作宾语、定语；指人或事物"},{"id":24066,"word":"无用武之地","pinyin":"wú yòng wǔ zhī dì","abbr":"wywzd","explanation":"没有使用武力的地方。比喻无法施展才能。","source":{"text":"近又新破荆州，威震海内，纵有英雄，无用武之地。","book":"明·罗贯中《三国演义》第43回"},"example":{"text":"钱钟书《围城》：“因为不能到孙家去吵，不能回方家去吵，不宜在路上吵，所以舌剑唇枪～。”"},"usage":"作谓语、定语；用于处事"},{"id":24067,"word":"无疆之休","pinyin":"wú jiāng zhī xiū","abbr":"wjzx","explanation":"无限美好；无穷幸福。","source":{"text":"皇天眷佑有商，俾嗣王克终厥德，实万世无疆之休。","book":"《尚书·太甲中》"},"example":{"text":"宋·秦观《代贺明堂礼毕表》：“实万世～，盖千载不逢之会。”"},"usage":"作宾语；用于书面语"},{"id":24068,"word":"无疆之寿","pinyin":"wú jiāng zhī shòu","abbr":"wjzs","explanation":"疆：界限。没有界限的寿命。形容长寿。","source":{"text":"凡言为寿，谓进爵于尊者而献无疆之寿。","book":"《汉书·高帝纪》"},"example":{"text":"天地泰交，日月同陵，上万年悠久～。","book":"明·罗贯中《平山冷燕》第一回"}},{"id":24069,"word":"无疾而终","pinyin":"wú jí ér zhōng","abbr":"wjez","explanation":"没有病就死了，比喻事物未受外力干扰就自行消灭。","source":{"text":"到三十六岁，忽对人说：‘玉帝命我为江涛之神，三日后，必当赴任。’至期无疾而终。","book":"明·冯梦龙《喻世明言》第18卷"},"example":{"text":"他身体一直很好，90岁才～。"},"usage":"作谓语；指死"},{"id":24070,"word":"无病呻吟","pinyin":"wú bìng shēn yīn","abbr":"wbsy","explanation":"呻吟：病痛时的低哼。没病瞎哼哼。比喻没有值得忧伤的事情而叹息感慨。也比喻文艺作品没有真实感情，装腔作势。","source":{"text":"百年光景百年心，更欢须叹息，无病也呻吟。","book":"宋·辛弃疾《临江仙》词"},"example":{"text":"后来的叹老嗟卑也正是～。","book":"朱自清《论书生的酸气》"},"similar":["矫柔造作"],"opposite":["直抒脑臆"],"usage":"作谓语、宾语；指装腔作势"},{"id":24071,"word":"无病自炙","pinyin":"wú bìng zì jiǔ","abbr":"wbzz","explanation":"灸：灼，多指中医用艾叶等灼烧身体某一部分的医疗方法。比喻自找苦吃或自寻烦脑。","source":{"text":"柳下季曰：‘跖得无逆汝意若前乎？’孔子曰：‘然，丘所谓无病而自炙也。’","book":"《庄子·盗跖》"},"similar":["自找苦吃"],"usage":"作宾语、谓语；指自找苦吃或自寻烦脑"},{"id":24072,"word":"无的放矢","pinyin":"wú dì fàng shǐ","abbr":"wdfs","explanation":"的：靶心；矢：箭。没有目标乱射箭。比喻说话做事没有明确目的，或不切合实际。","source":{"text":"吾深望西国当局者声明一言以解众惑，如是，则吾本篇所论纯为无的放矢，直拉杂摧烧之可耳。","book":"清·梁启超《中日交涉汇评》"},"example":{"text":"不是有的放矢，而是～。","book":"毛泽东《改造我们的学习》"},"similar":["对牛弹琴"],"opposite":["有的放矢"],"usage":"作谓语、定语、宾语；指没有目标的行动"},{"id":24073,"word":"无盐不解淡","pinyin":"wú yán bù jiě dàn","abbr":"wybjd","explanation":"比喻不下本钱就办不成事。","source":{"text":"但是无盐不解淡，总还得带些银子去，抚台的是垫了。","book":"清·吴趼人《糊涂世界》第三卷"},"usage":"作宾语、定语；指不下本钱就办不成事"},{"id":24074,"word":"无相无作","pinyin":"wú xiāng wú zuò","abbr":"wxwz","explanation":"①佛教语。指弃绝众相，不事造作。②泛指不务空言。"},{"id":24075,"word":"无知妄作","pinyin":"wú zhī wàng zuò","abbr":"wzwz","explanation":"缺乏知识、不明事理而胡为。","source":{"text":"讥其无知妄作，以取谮窃之罪。","book":"春秋·鲁·孔丘《论语·八》：“奚取于三家之堂。”宋·朱熹集注"},"example":{"text":"明·刘若愚《酌中志·大内规制纪略》：“～，此其一也。”"},"usage":"作谓语、宾语、定语；用于处事"},{"id":24076,"word":"无知妄说","pinyin":"wú zhī wàng shuō","abbr":"wzws","explanation":"妄说：胡说。缺乏知识，随意瞎说。","source":{"text":"因为这种议论或批评，没有经过周密调查，不过是无知妄说。","book":"毛泽东《“农村调查”序言》"},"usage":"作谓语、宾语、定语；用于处事等"},{"id":24077,"word":"无知无识","pinyin":"wú zhī wú shí","abbr":"wzws","explanation":"指没有知识。","source":{"text":"你看这丁言志无知无识的，走来说是莺豆湖的大会，是胡三公子的主人。","book":"清·吴敬梓《儒林外史》第五十四回"},"example":{"text":"自己也有错处，为什么始终看儿子还是个～的小孩子！","book":"老舍《二马》第三段"}},{"id":24078,"word":"无私之光","pinyin":"wú sī zhī guāng","abbr":"wszg","explanation":"比喻帝王的德泽。","source":{"text":"天无私覆，地无私载，日月无私照。","book":"语本《礼记·孔子闲居》"},"example":{"text":"唐·白居易《鸦九剑》诗：“为君使～及万物，蛰虫昭苏萌草出。”"},"usage":"作宾语；用于比喻句"},{"id":24079,"word":"无私无畏","pinyin":"wú sī wú wèi","abbr":"wsww","explanation":"因为不自私而无所畏惧。","example":{"text":"他～，勇往直前。"},"usage":"作谓语、定语；指人公正"},{"id":24080,"word":"无私有弊","pinyin":"wú sī yǒu bì","abbr":"wsyb","explanation":"私：私心；弊：欺骗、蒙混的事情。因处在嫌疑之地，虽然没有私弊，但容易被人猜疑。","source":{"text":"可是这个风声出去，人家一定说是无私无弊，况且以后，你们头儿们捉到了人，都来照顾小店里，小店还能开得下去么？","book":"清·李宝嘉《活地狱》第二十六回"},"similar":["无丝有线"],"usage":"作谓语；指人办事"},{"id":24081,"word":"无私有意","pinyin":"wú sī yǒu yì","abbr":"wsyy","explanation":"自己虽无私心，别人则将认为有意。意为要避嫌疑。","source":{"text":"他是梁山泊造反的人，我如何与他厮见！无私有意，你可回他话道，只说我卧病在床，动止不得，难以相见。","book":"明·施耐庵《水浒传》第48回"},"usage":"作宾语、定语；用于处事"},{"id":24082,"word":"无稽之言","pinyin":"wú jī zhī yán","abbr":"wjzy","explanation":"没有根据、无从查证的话。","source":{"text":"无稽之言，不见之行，不闻之谋，君之慎之。","book":"《荀子·正名》"},"example":{"text":"清·刘鹗《老残游记续集遗稿》第八回：“若听旁人～随便传说，其罪减造谣者一等。”"},"similar":["无稽之谈"],"usage":"作主语、宾语；指流言等"},{"id":24083,"word":"无稽之谈","pinyin":"wú jī zhī tán","abbr":"wjzt","explanation":"无稽：无法考查。没有根据的说法。","source":{"text":"无稽之言勿听。","book":"《尚书·大禹漠》"},"example":{"text":"既无其说，是为～。","book":"清·李汝珍《镜花缘》第十七回"},"similar":["流言蜚语","不经之谈"],"opposite":["言之凿凿","言之有理"],"usage":"作主语、宾语；指流言等","story":["上古时代，大禹治水有功，舜帝认为他最有资格接受帝位，就准备禅位给他，并告诫他：“你不骄不躁，天下没人与你争高下，你不夸耀自己，天下没人与你争功名。人心很险恶，道心很深微，所以要做圣人必须做到无稽之言勿听。”"]},{"id":24084,"word":"无穷无尽","pinyin":"wú qióng wú jìn","abbr":"wqwj","explanation":"穷：完。没有止境，没有限度。","source":{"text":"无穷无尽是离愁，天涯地角寻思遍。","book":"宋·晏殊《踏莎行》"},"example":{"text":"那西天路～，几时能到得！","book":"明·吴承恩《西游记》第四十回"},"similar":["无边无际","应有尽有"],"opposite":["寥寥无几","寥若晨星"],"usage":"作谓语、定语、状语；形容没有限度"},{"id":24085,"word":"无空不入","pinyin":"wú kōng bù rù","abbr":"wkbr","explanation":"比喻有空子就钻。同“无孔不入”。","source":{"text":"种种法规，一切措施，马上又变活了，投机是满天飞跃，无空不入。","book":"茅盾《清明前后》第四幕"},"similar":["无孔不入"],"usage":"作谓语、定语、状语；指人爱钻营"},{"id":24086,"word":"无立足之地","pinyin":"wú lì zú zhī dì","abbr":"wlzzd","explanation":"没有立脚的地方。比喻连极小的地方也没有。形容在某处无法生活或工作下去。也可形容惭愧得无地自容。","source":{"text":"无立锥之地，至贫也。","book":"《庄子·盗跖》：“尧舜有天下，子孙无置锥之地。”《吕氏春秋·为欲》"},"example":{"text":"母亲如此说，儿子～了。","book":"清·曹雪芹《红楼梦》第三十三回"},"similar":["无立锥之地","亡立锥之地"],"usage":"作谓语、定语、状语；指没有立足的地方"},{"id":24087,"word":"无立锥之地","pinyin":"wú lì zhuī zhī dì","abbr":"wlzzd","explanation":"没有立锥子的地方。比喻连极小的地方也没有。后常形容贫穷。","source":{"text":"今秦失德弃义，侵伐诸侯社稷，灭六国之后，使无立锥之地。","book":"西汉·司马迁《史记·留侯世家》"},"example":{"text":"他穷得上无片瓦，下～。"},"similar":["无立足之地","亡立锥之地"],"usage":"作谓语、定语、状语；指没有立足的地方","story":["楚汉相争时，刘邦被项羽打败，就向谋士郦食其讨教。郦生给刘邦出主意分封六国那些无立锥之地的后人，讨取民心就可以战胜项羽。张良坚决反对郦生的这种做法，认为刘邦天下都还没得到，分封他们，他们就各自为政，没人帮他打天下了"]},{"id":24088,"word":"无立锥地","pinyin":"wú lì zhuī dì","abbr":"wlzd","explanation":"没有立锥子的地方。比喻连极小的地方也没有。后常形容贫穷。","source":{"text":"无立锥之地，至贫也。","book":"《庄子·盗跖》：“尧舜有天下，子孙无置锥之地。”《吕氏春秋·为欲》"},"example":{"text":"我本～，汝又拙于女红，度老母必以冻馁死。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录五》"}},{"id":24089,"word":"无端生事","pinyin":"wú duān shēng shì","abbr":"wdss","explanation":"无端：没有理由。无缘无故地捣乱闹事。","example":{"text":"自家是规规矩矩的生意人，又没犯法，只要生意好，不欠人家的钱，难道好～，自诈他不成。","book":"茅盾《林家铺子》"},"similar":["无事生非"],"usage":"作谓语、定语、宾语；用于处事"},{"id":24090,"word":"无米之炊","pinyin":"wú mǐ zhī chuī","abbr":"wmzc","explanation":"炊：做饭。比喻缺少必要条件无法办成的事。","source":{"text":"晏景初尚书，请僧住院，僧辞以穷陋不可为。景初曰：‘高才固易耳。’僧曰：‘巧妇安能作无面汤饼乎？’","book":"宋·陆游《老学庵笔记》卷三"},"example":{"text":"～，是人力所做不到的。","book":"鲁迅《两地书》八三"},"similar":["无源之水","无本之木"],"usage":"作宾语；比喻缺少必要条件无法办成的事"},{"id":24091,"word":"无精嗒彩","pinyin":"wú jīng dā cǎi","abbr":"wjdc","explanation":"形容不高兴，提不起劲儿。同“无精打彩”。","source":{"text":"枝条一动也懒得动的，无精嗒彩地低垂着。","book":"老舍《骆驼祥子》"},"similar":["无精打彩","无精打采"],"usage":"作定语、状语；用于书面语"},{"id":24092,"word":"无精打彩","pinyin":"wú jīng dǎ cǎi","abbr":"wjdc","explanation":"打：打消。形容精神不振，提不起劲头","source":{"text":"说得宝玉也不敢作声，坐了一回，无精打彩的出来了。","book":"清·曹雪芹《红楼梦》第81回"},"example":{"text":"曹禺《北京人》第一幕：“打过二更他才～地回到房里。”"},"similar":["无精打采","无精嗒彩"],"opposite":["神采奕奕"],"usage":"作谓语、宾语；指精神不振"},{"id":24093,"word":"无精打采","pinyin":"wú jīng dǎ cǎi","abbr":"wjdc","explanation":"采：兴致。形容精神不振，提不起劲头。","source":{"text":"小红待要过去，又不敢过去，只得悄悄向潇湘馆，取了喷壶而回，无精打采，自向房内躺着。","book":"清·曹雪芹《红楼梦》第二十五回"},"example":{"text":"这时候贾大少爷见人家的条子都已到齐，瞧着眼热，自己一个人坐在那里，甚觉～。","book":"清·李宝嘉《官场现形记》第二十四回"},"similar":["有气无力","无精打彩"],"opposite":["精神抖擞","神采奕奕"],"usage":"作谓语、宾语；指精神不振","story":["贾宝玉从外边回来，见袭人不在，晴雯也不在，要喝茶与洗澡，小红立即上前献殷勤。这时秋纹、碧痕两个人共提着一桶水嘻嘻哈哈的说笑着进来，小红只好知趣地走开。袭人回来叫小红去潇湘馆去取喷壶，她见自己的绝好献媚机会被破坏，无精打采地歇息"]},{"id":24094,"word":"无缘无故","pinyin":"wú yuán wú gù","abbr":"wywg","explanation":"没有一点原因。","source":{"text":"好好儿的，从那里说起！无缘无故白受了一场气！","book":"清·曹雪芹《红楼梦》第四十四回"},"example":{"text":"他的力量，力气，一向使他自尊自傲，可是在过去的这些日子，～的他受尽了委曲与困苦。","book":"老舍《骆驼祥子》三"},"similar":["平白无故"],"opposite":["事出有因"],"usage":"作谓语、定语；用于人"},{"id":24095,"word":"无缚鸡之力","pinyin":"wú fù jī zhī lì","abbr":"wfjzl","explanation":"连捆鸡的力气都没有。比喻体弱无力。","source":{"text":"那韩信手无缚鸡之力。","book":"元·《赚蒯通》第一折"},"example":{"text":"这个品貌，原是个奇人，不是那～的。","book":"清·吴敬梓《儒林外史》第四十九回"},"similar":["手无缚鸡之力"],"usage":"作谓语、宾语、定语；指身体虚弱"},{"id":24096,"word":"无缝天衣","pinyin":"wú féng tiān yī","abbr":"wfty","explanation":"神话指仙女穿的天衣，不用针线缝合，没有缝儿。常以比喻诗文等事物没有一点瑕疵。","source":{"text":"次韵之作，能如无缝天衣，自非老手莫办。","book":"清·梁章钜《归田琐记·南万柳堂》"},"example":{"text":"清·无垢道人《八仙全传》第三回：“正如～，瞧不出一些痕迹。”"},"similar":["天衣无缝"],"usage":"作宾语、定语；多用于比喻句"},{"id":24097,"word":"无罣无碍","pinyin":"wú guà wú ài","abbr":"wgwa","explanation":"没有任何牵挂。","source":{"text":"想俺这出家儿的，要无罣无碍，无是无非。","book":"明·无名氏《拔宅飞升》第二折"}},{"id":24098,"word":"无置锥之地","pinyin":"wú zhì zhuī zhī dì","abbr":"wzzzd","explanation":"没有放置锥子的地方。比喻连极小的地方也没有。后常形容贫穷。","source":{"text":"尧舜有天下，子孙无置锥之地。","book":"《庄子·盗跖》"},"example":{"text":"尧无百户之郭，舜～，以有天下；禹无十人之众，汤无七里之分，以王诸侯。","book":"《淮南子·氾论训》"},"similar":["无立锥之地","无置锥地"],"usage":"作谓语、定语、状语；指没有立足的地方"},{"id":24099,"word":"无置锥地","pinyin":"wú zhì zhuī dì","abbr":"wzzd","explanation":"没有立锥子的地方。比喻连极小的地方也没有。后常形容贫穷。同“无立锥之地”。","source":{"text":"况本濩落人，归无置锥地。","book":"唐·韦应物《答故人见谕》诗"},"similar":["无置锥之地","无立锥之地"],"usage":"作谓语、定语、宾语；指没有立足的地方"},{"id":24100,"word":"无羐无碍","pinyin":"wú guà wú ài","abbr":"wgwa","explanation":"没有任何牵挂。"},{"id":24101,"word":"无翼而飞","pinyin":"wú yì ér fēi","abbr":"wyef","explanation":"翼：翅膀。没有翅膀却飞走了。比喻事物很快地传播开来。","source":{"text":"众口所移，毋翼而飞。","book":"《管子·戒》：“无翼而飞者声也。”《战国策·秦策三》"},"example":{"text":"足足的一百六十块钱就那样～了。","book":"郭沫若《革命春秋·创造十年》"},"similar":["不翼而飞"],"usage":"作谓语；同“不翼而飞”"},{"id":24102,"word":"无耻下流","pinyin":"wú chǐ xià liú","abbr":"wcxl","explanation":"无耻：不知耻辱；下流：引起性欲或绘声绘色地描述色情。指不知羞耻，低级下流。","example":{"text":"他一向都爱讲～的笑话。"},"similar":["下流无耻"],"usage":"作谓语、定语；指人没修养"},{"id":24103,"word":"无耻之尤","pinyin":"wú chǐ zhī yóu","abbr":"wczy","explanation":"尤：突出的。最无耻的。形容无耻到了极点。","source":{"text":"这班人可以算得无耻之尤。","book":"清·吴趼人《二十年目睹之怪现状》第三十六回"},"example":{"text":"至于替魏忠贤建立生祠，更被人们认为是“～”（姚雪垠《李自成》第二卷第十八章）"},"similar":["厚颜无耻","寡廉鲜耻"],"opposite":["廉洁奉公","廉明公正"],"usage":"作宾语；指十分无耻"},{"id":24104,"word":"无耻之徒","pinyin":"wú chǐ zhī tú","abbr":"wczt","explanation":"不知耻辱或不要脸的人。","example":{"text":"他们简直就是～。"},"similar":["无耻之尤"],"usage":"作宾语；用于骂人"},{"id":24105,"word":"无耻谰言","pinyin":"wú chǐ lán yán","abbr":"wcly","explanation":"谰言：诬蔑的话，毫无根据的话。指不知羞耻的无赖话。"},{"id":24106,"word":"无聊赖","pinyin":"wú liáo lài","abbr":"wll","explanation":"聊赖：依赖。精神上无所寄托，感到什么都没意思。","source":{"text":"惟朕一身，独无聊赖。","book":"《晋书·慕容德载记》"},"example":{"text":"我已侵寻七秩，况复轮囷万感，合恨更分愁。先自～，雨意得能稠。","book":"宋·吴潜《水调歌头·己未中秋无月》"},"usage":"作谓语、定语、状语；用于口语"},{"id":24107,"word":"无肠公子","pinyin":"wú cháng gōng zǐ","abbr":"wcgz","explanation":"指螃蟹。","source":{"text":"称无肠公子者，蟹也。","book":"晋·葛洪《抱朴子·登涉》"},"example":{"text":"饕餮王孙应有酒，横行公子竟无肠。","book":"清·曹雪芹《红楼梦》第三十八回"},"usage":"作宾语、定语；指螃蟹"},{"id":24108,"word":"无肠可断","pinyin":"wú cháng kě duàn","abbr":"wckd","explanation":"比喻悲痛之极。","source":{"text":"衰草低衬斜阳。斜阳外，水冷云黄。借使有肠也须断，况无肠。","book":"宋·石孝祥《愁倚阑》词"},"usage":"作谓语、定语；用于处事"},{"id":24109,"word":"无背无侧","pinyin":"wú bèi wú cè","abbr":"wbwc","explanation":"不能辨清背叛倾仄之人。"},{"id":24110,"word":"无胫而来","pinyin":"wú jìng ér lái","abbr":"wjel","explanation":"犹无胫而行。常以喻良才不招而自至爱贤者之门。同“无胫而至”。","source":{"text":"珠雄于此，玉峙于彼，无胫而来，以宠爱人寰之中。","book":"明·宋应星《天工开物·珠玉》"},"similar":["无胫而至"],"usage":"作谓语、定语；用于书面语"},{"id":24111,"word":"无胫而至","pinyin":"wú jìng ér zhì","abbr":"wjez","explanation":"犹无胫而行。常以喻良才不招而自至爱贤者之门。","source":{"text":"珠玉无胫而自至者，以人好之也，况贤者之有卒乎！","book":"汉·孔融《论盛孝章书》"},"similar":["无胫而来"],"usage":"作谓语、定语；用于书面语"},{"id":24112,"word":"无胫而行","pinyin":"wú jìng ér xíng","abbr":"wjex","explanation":"胫：小腿。没有腿而能行走。比喻事物用不着推行，能迅速传播。","source":{"text":"珠玉无胫而自至者，以人好之也。","book":"汉·孔融《论盛孝章书》"},"example":{"text":"每一章一句出，～，疾于珠玉。","book":"唐·白居易《元公墓志铭》"},"similar":["不翼而飞","无胫而走"],"usage":"作谓语、定语；用于消息等"},{"id":24113,"word":"无胫而走","pinyin":"wú jìng ér zǒu","abbr":"wjez","explanation":"犹无胫而行。常以喻良才不招而自至爱贤者之门。同“无胫而行”。","source":{"text":"珠玉无胫而自至者，以人好之也。","book":"汉·孔融《论盛孝章书》"},"example":{"text":"第一章一句同，～，疾于珠玉。","book":"唐·白居易《元公墓志铭》"},"similar":["无胫而行"],"usage":"作谓语、定语；用于书面语"},{"id":24114,"word":"无能为力","pinyin":"wú néng wéi lì","abbr":"wnwl","explanation":"不能施展力量。指使不上劲或没有能力去做好某件事情、解决某个问题。","source":{"text":"此罪至重，微我难解脱，即释迦牟尼亦无能为力也。","book":"清·纪昀《阅微草堂笔记》卷十四"},"example":{"text":"使兵饷顿竭，忠臣流涕顿足而叹，～，惟有一死以报国，不亦大可哀乎？","book":"清·梁绍壬《两般秋雨庵随笔·卷八·史阁部书》"},"similar":["力不从心","力不能及","无计可施"],"opposite":["得心应手"],"usage":"作谓语、宾语、定语；用于推辞"},{"id":24115,"word":"无能为役","pinyin":"wú néng wéi yì","abbr":"wnwy","explanation":"役：役使。简直连供给他们役使都不配。自谦才干远不能和别人相比。","source":{"text":"此城濮之赋也。有先君之明与先大夫之肃，故捷。克于先大夫，无能为役。","book":"春秋·鲁·左丘明《左传·成公二年》"},"example":{"text":"少陵出而瑰奇鸿丽，后此～。","book":"清·沈德潜《说诗晬语》上卷"},"usage":"作谓语；用于自谦","story":["春秋时期，鲁国和卫国遭受攻击，他们向晋国求救，晋景公愿意以兵车700乘相助，命大将翖克为主帅。翖克认为：我们已经有城濮一战的经验，如果有先君的英明和以前大夫的认真，一定能胜。我不能与先前大夫相比，请发800乘兵"]},{"id":24116,"word":"无能之辈","pinyin":"wú néng zhī bèi","abbr":"wnzb","explanation":"笨拙、没有能力或容易犯错误的人。","source":{"text":"岳飞真乃无能之辈。","book":"清·钱彩《说岳全传》第51回"},"example":{"text":"他们大多是三流人物的～。"},"similar":["等闲之辈"],"usage":"作宾语；指没有能力的人"},{"id":24117,"word":"无般不识","pinyin":"wú bān bù shí","abbr":"wbbs","explanation":"犹百般，用尽方法。"},{"id":24118,"word":"无虑无忧","pinyin":"wú lǜ wú yōu","abbr":"wlwy","explanation":"没有一点忧愁和顾虑。同“无忧无虑”。","source":{"text":"我做了个草庵中无忧无虑的僧家。","book":"元·郑廷玉《忍字记》第二折"},"example":{"text":"说这唐长老～，相随八戒上大路。","book":"明·吴承恩《西游记》第八十五回"},"similar":["无忧无虑"],"opposite":["忧心忡忡"],"usage":"作谓语、宾语、定语；用于处事"},{"id":24119,"word":"无虑无思","pinyin":"wú lǜ wú sī","abbr":"wlws","explanation":"犹言无忧无虑。没有一点忧愁和顾虑。","source":{"text":"德人者，居无思，行无虑，不藏是非美恶。","book":"《周易·系辞下》：“天下何思何虑，天下同归而殊途，一致而百虑。”《庄子·天地》"},"example":{"text":"山林纵卧，～真快活。纵卧山林，一点灵光无物侵。","book":"元·尹志平《减字木兰花》词"},"similar":["无思无虑"],"usage":"作谓语、定语；形容无所用心"},{"id":24120,"word":"无衣之赋","pinyin":"wú yī zhī fù","abbr":"wyzf","explanation":"以之为出师相援、同仇敌忾之典。","source":{"text":"春秋末，吴破楚，楚大夫申包胥乞师秦廷，倚庭墙而哭，七日勺饮不入。秦哀公乃赋《无衣》诗，并出兵救楚。事见《左传·定公四年》。"}},{"id":24121,"word":"无衣无褐","pinyin":"wú yī wú hè","abbr":"wywh","explanation":"褐：本指粗毛布，引申为粗布衣服。没有御寒的衣服。形容生活贫困艰辛。","source":{"text":"无衣无褐，何以卒岁。","book":"《诗经·豳风·七月》"}},{"id":24122,"word":"无补于世","pinyin":"wú bǔ yú shì","abbr":"wbys","explanation":"世：时代。对时势没有什么帮助。","source":{"text":"至于谐言短韵，无补于世，不当于齿牙间，使人传言。","book":"宋·苏舜钦《上杜侍郎启》"},"similar":["无补于时"],"usage":"作谓语、定语；用于书面语"},{"id":24123,"word":"无补于事","pinyin":"wú bǔ yú shì","abbr":"wbys","explanation":"补：益处，裨益，对事情没有什么益处。","source":{"text":"诗之工者，无若三百篇，皆国人作之以刺美时政，王者采之以观风俗耳，不闻王者为诗也。后代辞人之诗，华而不实，无补于事。","book":"《资治通鉴·唐纪·文宗太和八年》"},"example":{"text":"你此刻官微职小，如何斗得他过？枉是送了性命，仍旧～。","book":"清·俞万春《荡寇志》第八十一回"},"similar":["于事无补"],"usage":"作谓语；用于口语"},{"id":24124,"word":"无补于时","pinyin":"wú bǔ yú shí","abbr":"wbys","explanation":"对时事形势没有什么帮助。","source":{"text":"处虽为难，退亦未易。今虽能倖然引去，无补于时，亦安足以为嘉事。","book":"宋·苏舜钦《答杜公书》"},"similar":["无补于世"],"usage":"作谓语、定语；用于书面语"},{"id":24125,"word":"无言以对","pinyin":"wú yán yǐ duì","abbr":"wyyd","explanation":"没有理由和语言来反驳。","similar":["哑口无言"],"opposite":["振振有词"]},{"id":24126,"word":"无言可对","pinyin":"wú yán kě duì","abbr":"wykd","explanation":"对：对答，回答。没有话来回答。","source":{"text":"师曰：‘这老和尚被我一问直得无言可对。’","book":"宋·释普济《五灯会元》卷四"},"example":{"text":"明·施耐庵《水浒传》第46回：“那妇人看了，飞红了脸，～。”"},"similar":["无言以对"],"usage":"作谓语；指无话可说"},{"id":24127,"word":"无言可答","pinyin":"wú yán kě dá","abbr":"wykd","explanation":"答：回答。没有话来回答。","source":{"text":"师曰：‘这老和尚被我一问直得无言可对。’","book":"宋·释普济《五灯会元》卷四"},"example":{"text":"腾曰：“面带春色，未见病容。”承～。","book":"明·罗贯中《三国演义》第二十回"}},{"id":24128,"word":"无誉无咎","pinyin":"wú yù wú jiù","abbr":"wywj","explanation":"既无称誉，也无毁谤。形容很平常。","source":{"text":"无誉无訾，一龙一蛇，与时俱化，而无肯专为。","book":"《庄子·山木》"}},{"id":24129,"word":"无计可奈","pinyin":"wú jì kě nài","abbr":"wjkn","explanation":"指无法可施。同“无计奈何”。","source":{"text":"此时长老见那国王敬重，无计可奈，只得勉强随喜，诚是外喜而内忧也。","book":"明·吴承恩《西游记》第94回"},"similar":["无计奈何"],"usage":"作谓语、定语、状语；用于处事"},{"id":24130,"word":"无计可施","pinyin":"wú jì kě shī","abbr":"wjks","explanation":"计：策略、办法；施：施展。没有办法可用。","source":{"text":"王允日：‘贼臣董卓，将欲篡位，朝中文武，无计可施。’","book":"明·罗贯中《三国演义》第八回"},"example":{"text":"每个干部如果都能做到清正廉洁，行贿者也就～了。"},"similar":["束手无策","走投无路","黔驴技穷"],"opposite":["得心应手","一帆风顺","急中生智"],"usage":"作谓语、定语；指一点办法也没有","story":["东汉末年，董卓率军进入洛阳，废汉少帝，立汉献帝刘协，曹操和袁绍起兵反对，董卓挟献帝至长安，自任太师。董卓残暴与专权，引起朝中文武大臣的不满，但又无计可施。司徒王允把府中的美女貂禅许给吕布，然后再献董卓，借吕布之手除掉董卓"]},{"id":24131,"word":"无计可生","pinyin":"wú jì kě shēng","abbr":"wjks","explanation":"计：策略、办法；生：产生。想不出办法来。","source":{"text":"家缘家计，都被火烧的光光了。无计可生，与这大户人家放牛，讨碗饭吃。","book":"元·无名氏《货郎旦》第三折"},"example":{"text":"惠养民～，遂道：“你就说，我往乡里去了。”","book":"清·李绿园《歧路灯》第四十一回"},"similar":["无计可施"],"usage":"作谓语、定语；指一点办法也没有"},{"id":24132,"word":"无计奈何","pinyin":"wú jì nài hé","abbr":"wjnh","explanation":"指无法可施。","source":{"text":"愁倚画楼无计奈，乱红飘过秋塘外。","book":"宋·欧阳修《渔家傲》词"},"example":{"text":"明·施耐庵《水浒传》第二回：“高俅～，只得来淮西临淮州，投奔一个开赌坊的闲汉柳大郎。”"},"similar":["无计可奈","无计所奈"],"usage":"作谓语、定语、状语；用于处事"},{"id":24133,"word":"无计所奈","pinyin":"wú jì suǒ nài","abbr":"wjsn","explanation":"指无法可施。同“无计奈何”。","source":{"text":"我今日无计所奈，砍了这一束荆枝，负在背上，回山寨见俺公明哥哥去也呵。","book":"元·康进之《李逵负荆》第四折"},"similar":["无计奈何","无计可奈"],"usage":"作谓语、定语、状语；用于处事"},{"id":24134,"word":"无论如何","pinyin":"wú lùn rú hé","abbr":"wlrh","explanation":"不管怎样。表示不管条件怎样变化，其结果始终不变。","source":{"text":"要之，中国一切旧物，无论如何，定必崩溃。","book":"鲁迅《书信集·致宋崇义》"},"example":{"text":"可是她知道有你在，便推托身子不好，～不肯来了。","book":"茅盾《色盲》"},"usage":"作分句；指不管怎样"},{"id":24135,"word":"无话不谈","pinyin":"wú huà bù tán","abbr":"whbt","explanation":"没有不说的话。指彼此之间没有保留。","source":{"text":"两个人的名字，我可记不清楚了，单记得一个姓朱的，一个姓赵的，两个人是拜把子的兄弟，非常要好，平日无话不谈。","book":"清·吴趼人《二十年目睹之怪现状》第五十四回"},"example":{"text":"咱们军中的老人，都是生死一心，在你面前～。","book":"姚雪垠《李自成》第二卷第五十四章"}},{"id":24136,"word":"无诤三昧","pinyin":"wú zhèng sān mèi","abbr":"wzsm","explanation":"诤：直言劝人改正错误；昧：昏暗，糊涂。没有什么争论，什么都马马虎虎。","source":{"text":"无可无不可曰无诤三昧。","book":"《金刚经》：“世尊！佛说我得无诤三昧，人中最为第一，是第一离欲阿罗汉。”宋·胡继宗《书言故事·拾遗》"},"example":{"text":"凌晨视之，殊有月夜之思，因此学画而得其无诤三昧，名播于世。","book":"元·王冕《竹斋集·梅谱》"}},{"id":24137,"word":"无谎不成媒","pinyin":"wú huǎng bù chéng méi","abbr":"whbcm","explanation":"旧时媒人说亲，多以谎言欺骗。","source":{"text":"常言‘无谎不成媒。’，你与我包谎，只说十二分人才，或者该是我的姻缘，一说便就，不要面看，也不可知。","book":"明·冯梦龙《醒世恒言》卷七"},"usage":"作宾语、定语；用于书面语"},{"id":24138,"word":"无赖之徒","pinyin":"wú lài zhī tú","abbr":"wlzt","explanation":"指游手好闲，品行不端的人。","source":{"text":"唯樊襄已南，仁乖道政，被拘隔化，非民之咎。而无赖之徒，轻相劫掠，屠害良善，离人父兄。","book":"《魏书·世宗纪》"},"example":{"text":"他于四更时分，又引数个～，不知何处去了。","book":"明·罗贯中《三国演义》第二十八回"}},{"id":24139,"word":"无赖小人","pinyin":"wú lài xiǎo rén","abbr":"wlxr","explanation":"指游手好闲，品行不端的人。","source":{"text":"且弘妻，陛下之弟妇也；弘女，陛下之侄女也。奈何使无赖小人辱为婢妾。天地神明，岂忍见此！","book":"《晋书·吕纂传》"},"example":{"text":"潘华益无顾忌，日逐与～酒食游戏。","book":"明·冯梦龙《醒世恒言》卷一"}},{"id":24140,"word":"无足挂齿","pinyin":"wú zú guà chǐ","abbr":"wzgc","explanation":"足：值得；挂齿：提及，谈及。哪里值得挂在嘴上。不值一提的意思。","source":{"text":"《史记·刘敬叔孙通列传》： “此特群盗鼠窃狗盗，何足置齿牙间哉？”"},"example":{"text":"四子尚系乳抱，～。","book":"清·李百川《绿野仙踪》第四回"}},{"id":24141,"word":"无足轻重","pinyin":"wú zú qīng zhòng","abbr":"wzqz","explanation":"足：足以。没有它并不轻些，有它也并不重些。指无关紧要。","source":{"text":"王文成后日功名不必言，即扬廉亦至南礼部尚书，谥文恪，则言官白简，亦未足轻重也。","book":"明·沈德符《万历野获编·京考官劾》"},"example":{"text":"这次清算对蒋殿人来说真可谓牛身失毛，～。","book":"冯德英《迎春花》第四章"},"similar":["无关宏旨","无关大局","无关紧要"],"opposite":["举足轻重"],"usage":"作谓语、定语；用于人、事、物"},{"id":24142,"word":"无足重轻","pinyin":"wú zú zhòng qīng","abbr":"wzzq","explanation":"没有它并不轻些，有它也并不重些。指无关紧要。同“无足轻重”。","source":{"text":"又想及山东关拿武举，老婆已成破货，无足重轻。","book":"清·李百川《绿野仙踪》第二十五回"},"example":{"text":"所以我以为不能据缺笔字便确定为某朝刻，尤其是当时视为～的小说和剧曲之类。","book":"鲁迅《华盖集续编补编·关于〈三藏取经记〉等》"},"similar":["无足轻重"],"usage":"作谓语、定语；用于人、事、物"},{"id":24143,"word":"无路可走","pinyin":"wú lù kě zǒu","abbr":"wlkz","explanation":"处于极限，到达不可能逾越之处。","example":{"text":"处于极限，到达不可能逾越之处。"},"similar":["逼上绝路"],"usage":"作谓语、状语；指绝境"},{"id":24144,"word":"无路求生","pinyin":"wú lù qiú shēng","abbr":"wlqs","explanation":"指没有活路。","source":{"text":"吾不忍见王，王若无路求生，当踣面以俟。","book":"《新五代史·唐家人传》"},"example":{"text":"陛下虽则恩深，但事已至此，～。","book":"清·洪昇《长生殿·埋玉》"}},{"id":24145,"word":"无路请缨","pinyin":"wú lù qǐng yīng","abbr":"wlqy","explanation":"缨：绳子；请缨：指投军报国。没有立功报国的时机。","source":{"text":"勃，三尺微命，一介书生。无路请缨，等终军之弱冠；有怀投笔，慕宗悫之长风。","book":"唐·王勃《滕王阁序》"}},{"id":24146,"word":"无踪无影","pinyin":"wú zōng wú yǐng","abbr":"wzwy","explanation":"没有一点痕迹、影子。形容完全消失。","source":{"text":"说毕，一阵香风，无踪无影去了。","book":"清·曹雪芹《红楼梦》第六十六回"},"example":{"text":"端甫道：“此刻～的，往哪里去访寻呢。只得破了脸，追问景翼。”","book":"清·吴趼人《二十年目睹之怪现状》第三十三回"},"similar":["无影无踪"],"opposite":["有迹可寻"],"usage":"作谓语、状语、定语；形容人或物体"},{"id":24147,"word":"无边无垠","pinyin":"wú biān wú yín","abbr":"wbwy","explanation":"形容范围极为广阔。同“无边无际”。","source":{"text":"只见浪滔滔无边无际。","book":"胡·胡文焕《群音类选·牧羊记·北海牧羝》"},"similar":["无边无沿","无边无际","无边无涯"],"usage":"作谓语、定语；形容广阔"},{"id":24148,"word":"无边无沿","pinyin":"wú biān wú yán","abbr":"wbwy","explanation":"形容范围极为广阔。同“无边无际”。","source":{"text":"有的幸福得无边无沿，使她自己也不会相信了的。","book":"端木蕻良《科尔沁旗草原》"},"similar":["无边无际","无边无涯","无边无垠"],"usage":"作谓语、定语；形容广阔"},{"id":24149,"word":"无边无涯","pinyin":"wú biān wú yá","abbr":"wbwy","explanation":"形容范围极为广阔。","source":{"text":"小梁，你看这草地，无边无涯，没个尽头。","book":"《金色的鱼钩》"},"similar":["无边无际","无边无沿","无边无垠"],"usage":"作谓语、定语；形容广阔"},{"id":24150,"word":"无边无际","pinyin":"wú biān wú jì","abbr":"wbwj","explanation":"际：边缘处。形容范围极为广阔。","source":{"text":"白茫茫一片无边无际，原来是太湖边上。","book":"清·钱采《说岳全传》第66回"},"example":{"text":"山路通过涧上一座毛竹小桥，重又隐没到～的大竹林里了。","book":"《霹雳》"},"similar":["一望无际","不着边际"],"opposite":["立锥之地","弹丸之地"],"usage":"作谓语、定语；形容广阔"},{"id":24151,"word":"无边无限","pinyin":"wú biān wú xiàn","abbr":"wbwx","explanation":"开阔得望不到尽头。","source":{"text":"只见浪滔滔无边无际。","book":"胡·胡文焕《群音类选·牧羊记·北海牧羝》"},"example":{"text":"她望着这一切，她斗胆地想啊，和这～的狼狈相比，她也许更愿意潜人她的眩晕症。","book":"铁凝《大浴女》第二章"}},{"id":24152,"word":"无边苦海","pinyin":"wú biān kǔ hǎi","abbr":"wbkh","explanation":"原为佛家语，形容深重无比的苦难。","source":{"text":"苦海无边，爱河无底，流浪看成百漏船。","book":"宋·陆游《大圣乐》词"},"example":{"text":"你可也戒了贪嗔除烦恼，～回头早，急忙里诵弥陀把罪孽消，守清规将因缘觉。","book":"清·方成培《雷峰塔》第二出"},"similar":["苦海无涯","苦海无边"],"usage":"作主语、宾语、定语；用于安慰人"},{"id":24153,"word":"无边风月","pinyin":"wú biān fēng yuè","abbr":"wbfy","explanation":"无边：无限；岁月：风和月亮，泛指景色。原指北宋哲学家周敦颐死后影响深广。后形容无限的美好风景。","source":{"text":"风月无边，庭草交翠。","book":"宋·朱熹《六先生画像赞·濂溪先生》"},"example":{"text":"元·白挺《西湖赋》：“春雨为观，香月为邻，水竹院落，～，见天下地心以志之。”"},"similar":["风光迤逦"],"usage":"作宾语；形容无限的美好风景"},{"id":24154,"word":"无远不届","pinyin":"wú yuǎn bù jiè","abbr":"wybj","explanation":"不管多远之处，没有不到的。同“无远弗届”。","source":{"text":"用能百揆时序，四门允穆，无恩不服，无远不届。","book":"《南史·陈纪·武帝》"},"similar":["无远弗届"],"usage":"作谓语、定语；用于书面语"},{"id":24155,"word":"无远弗届","pinyin":"wú yuǎn fú jiè","abbr":"wyfj","explanation":"不管多远之处，没有不到的。","source":{"text":"惟德动天，无远弗届。","book":"《尚书·大雨谟》"},"example":{"text":"清·谭嗣同《仁学》：“通者如电线四达，～。”"},"similar":["无远不届"],"usage":"作谓语、定语；用于书面语"},{"id":24156,"word":"无迹可寻","pinyin":"wú jì kě xún","abbr":"wjkx","explanation":"没有踪迹可以寻求。多指处事为文不着痕迹。","source":{"text":"有必宜改者，则以渐移变，使无迹可寻。","book":"《宋书·谢方明传》"},"similar":["无迹可求"],"usage":"作谓语、定语；用于处事等"},{"id":24157,"word":"无迹可求","pinyin":"wú jì kě qiú","abbr":"wjkq","explanation":"没有踪迹可以寻求。多指处事为文不着痕迹。同“无迹可寻”。","source":{"text":"盛唐诸人，惟在兴趣，羚羊挂角，无迹可求。","book":"宋·严羽《沧浪诗话·诗辩》"},"similar":["无迹可寻"],"usage":"作谓语、定语；用于处事等"},{"id":24158,"word":"无适无莫","pinyin":"wú shì wú mò","abbr":"wswm","explanation":"适：厚；莫：薄。待人处事不分厚薄，没有偏向。","source":{"text":"君子之于天下也，无适也，无莫也，义之于此。","book":"《论语·里仁》"},"example":{"text":"心平志论，～，期于得道而已矣。","book":"三国·魏·刘劭《人物志·材理》"},"usage":"作谓语、定语；用于书面语"},{"id":24159,"word":"无適无莫","pinyin":"wú dí wú mò","abbr":"wdwm","explanation":"適：厚；莫：薄。对人没有什么亲疏厚薄。","source":{"text":"是以君子之于事也，无適无莫，必考之以义焉。","book":"《论语·里仁》：“君子之于天下也，无適也，无莫也，义之与比。”《后汉书·刘梁传》"}},{"id":24160,"word":"无遮大会","pinyin":"wú zhē dà huì","abbr":"wzdh","explanation":"无遮：没有遮拦，指不分贵贱、僧俗、智愚、善恶，平等看待。佛家语，原指布施僧俗的大会。后也用作其它的泛称。","source":{"text":"舆驾幸同泰寺，设四部无遮大会。","book":"《梁书·武帝本纪》"},"usage":"作宾语；指布施僧俗的大会"},{"id":24161,"word":"无长物","pinyin":"wú zhàng wù","abbr":"wcw","explanation":"长物：多余的东西。没有多余的东西。原指生活俭朴。现形容贫穷。","source":{"text":"（王恭）对曰：‘ 丈人不悉恭，恭作人无长物。’","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"眼前～，窗下有清风。","book":"唐·白居易《销暑》"}},{"id":24162,"word":"无间冬夏","pinyin":"wú jiān dōng xià","abbr":"wjdx","explanation":"无论冬天还是夏天。指一年四季从不间断。同“无冬无夏”。","source":{"text":"无间冬夏，读书恒至夜半。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"usage":"作定语、状语；用于书面语"},{"id":24163,"word":"无间可乘","pinyin":"wú jiān kě chéng","abbr":"wjkc","explanation":"犹无隙可乘。没有空子可钻。","source":{"text":"向使中国无间可乘，吾又知其未至此也。","book":"明·刘基《春秋明经·蔡侯郑伯会于邓公及我盟于唐公至自唐》"},"example":{"text":"清·夏燮《中西纪事·漏卮本末》：“见粤东自烧烟以后，海口严密，～，而闵浙之师起矣。”"},"similar":["无隙可乘","无间可伺"],"opposite":["有隙可乘","有机可乘"],"usage":"作谓语、定语；用于处事"},{"id":24164,"word":"无间可伺","pinyin":"wú jiān kě sì","abbr":"wjks","explanation":"犹无隙可乘。没有空子可钻。","source":{"text":"禅宗论云间有三种语……其三为函盖乾坤句，谓泯然皆契，无间可伺。","book":"宋·叶梦得《石林诗话》卷上"},"similar":["无间可乘"],"opposite":["有机可乘"],"usage":"作谓语、定语；用于处事"},{"id":24165,"word":"无间是非","pinyin":"wú jiàn shì fēi","abbr":"wjsf","explanation":"指不分别是非。","example":{"text":"林林之民，咸致同情于不平者，凡有能阻泥教旨，抗拒法皇，～，辄与赞和。","book":"鲁迅《文化偏至论》"},"similar":["是非不分"],"opposite":["是非分明"],"usage":"作谓语、定语；用于书面语"},{"id":24166,"word":"无际可寻","pinyin":"wú jì kě xún","abbr":"wjkx","explanation":"找不出缺漏之处。","source":{"text":"人参心膂，出干政事，献可替否，无际可寻。","book":"《魏书·李孝伯李冲传论》"},"example":{"text":"《儒林传·卢景裕》：“景裕神采俨然，风调如一，从容往复，～，由是士君子嗟美之。”"},"similar":["无懈可击"],"opposite":["有机可乘"],"usage":"作谓语、定语；用于书面语"},{"id":24167,"word":"无隙可乘","pinyin":"wú xì kě chéng","abbr":"wxkc","explanation":"隙：空子、机会；乘：利用。没有空子可钻。","source":{"text":"臣其历七曜，咸始上元，无隙可乘。","book":"《宋书·律历志下》"},"example":{"text":"每羡暹罗繁富之国，要来吞并，只是～。","book":"清·陈忱《水浒后传》第三十五回"},"similar":["无懈可击","天衣无缝"],"opposite":["有机可乘","破绽百出"],"usage":"作谓语；指没有空子可钻"},{"id":24168,"word":"无靠无依","pinyin":"wú kào wú yī","abbr":"wkwy","explanation":"指孤苦而无所依赖。","source":{"text":"献帝又无靠无依，董卓又不仁不义，吕布又一冲一撞。","book":"元·关汉卿《单刀会》第三折"},"example":{"text":"清·钱彩《说岳全传》第26回：“被你这个贼子送了性命，叫我孤单一人，～！”"},"similar":["无依无靠"],"usage":"作谓语、宾语；用于人或物"},{"id":24169,"word":"无面目见江东父老","pinyin":"wú miàn mù jiàn jiāng dōng fù lǎo","abbr":"wmmjjdfl","explanation":"以之为羞见故乡人之典实。","source":{"text":"於是项王乃欲东渡乌江。乌江亭长檥船待……项王笑曰：‘天之亡我，我何渡为！且籍与江东子弟八千人渡江而西，今无一人还，纵江东父兄怜而王我，我何面目见之？’","book":"语本《史记·项羽本纪》"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第37卷：“程宰兄弟两人因是做折了本钱，怕归来受人笑话，羞惭惨沮，～，不思量还乡去了。”"},"similar":["无颜见江东父老"],"usage":"作谓语、定语；用于有愧时","story":["楚汉相争时期，项羽率领8000江东子弟组成的部队攻打秦军，他们越战越勇，势力也越来越大。由于项羽刚愎自用，听不进部下的意见，一意孤行，被刘邦的汉军围困在垓下乌江边，四面楚歌，江东子弟死伤无数，项羽感觉没脸见江东父老就拔剑自刎"]},{"id":24170,"word":"无面馎饦","pinyin":"wú miàn bó tuō","abbr":"wmbt","explanation":"馎饦：古代一种煮熟的面食，没有面则无从做。指没有必要条件就办不成事情。","source":{"text":"富家之积蓄皆尽矣，若今更不雨，恐巧妇做不得无面馎饦。","book":"宋·陈亮《壬寅答朱元晦秘书》"}},{"id":24171,"word":"无须之祸","pinyin":"wú xū zhī huò","abbr":"wxzh","explanation":"指无辜受累而遭祸。","source":{"text":"扞绍呴遂勒兵捕诸阉人，无少长皆杀之，或有无须而误死者。","book":"《三国志·魏志·袁绍传》"},"example":{"text":"宋·陈亮《送吴允成运干序》：“及其徒既衰，而异时熟视不平者合力共攻之，～滥及平人。”"},"usage":"作宾语；用于书面语"},{"id":24172,"word":"无颜落色","pinyin":"wú yán luò sè","abbr":"wyls","explanation":"失色，面无人色。","source":{"text":"唬得他无颜落色，惊得他手脚难抬。","book":"元·武汉臣《玉壶春》第三折"},"similar":["面无人色"],"usage":"作谓语、定语；用于书面语"},{"id":24173,"word":"无颜见江东父老","pinyin":"wú yán jiàn jiāng dōng fù lǎo","abbr":"wyjjdfl","explanation":"江东：借指家乡。指因自己的失败而感到羞愧，再也没脸见家乡父老。","source":{"text":"项王笑曰：‘且籍与江东子弟八千人渡江而西，今无一人还，纵江东父老怜而王我，我何面目见之？’","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"我现在失败了，～。"},"similar":["无面目见江东父老"],"opposite":["衣锦还乡"],"usage":"作谓语、定语；用于有愧时","story":["楚汉相争时期，项羽率领8000江东子弟组成的部队攻打秦军，他们越战越勇，势力也越来越大。由于项羽刚愎自用，听不进部下的意见，一意孤行，被刘邦的汉军围困在垓下乌江边，四面楚歌，江东子弟死伤无数，项羽感觉没脸见江东父老就拔剑自刎"]},{"id":24174,"word":"无颠无倒","pinyin":"wú diān wú dǎo","abbr":"wdwd","explanation":"犹言颠颠倒倒。指精神错乱。无，语助词，无义。","source":{"text":"老儿也似这般烦恼的无颠无倒，越惹你揉眵抹泪哭嚎啕。","book":"元·康进之《李逵负荆》第三折"},"similar":["颠颠倒倒"],"usage":"作宾语、定语；用于书面语"},{"id":24175,"word":"无风三尺浪","pinyin":"wú fēng sān chǐ làng","abbr":"wfscl","explanation":"比喻无缘无故也会生出事来。","example":{"text":"这真是～。"},"similar":["无事生非","无风起浪"],"usage":"作宾语、分句；指无事生非"},{"id":24176,"word":"无风不起浪","pinyin":"wú fēng bù qǐ làng","abbr":"wfbql","explanation":"没有风不会起波浪。比喻事情发生，总有个原因。","source":{"text":"无风不起浪，咱能听说，想必不会在天外头，只要下狠心，不愁找不着。","book":"高玉宝《高玉宝》第十章"},"example":{"text":"～，这不是无稽之谈。"},"similar":["事出有因"],"opposite":["无事生非"],"usage":"作宾语、分句；指事出有因"},{"id":24177,"word":"无风作有","pinyin":"wú fēng zuò yǒu","abbr":"wfzy","explanation":"把没风当作有风。比喻平白无故地生出事来。有故意制造事端的意思。","source":{"text":"就如世上的流嘴滑舌之人，无风作有，信着伶口俐舌，长篇大论，胡扳乱扯，敷演出一篇话来。","book":"清·曹雪芹《红楼梦》第七十八回"}},{"id":24178,"word":"无风作浪","pinyin":"wú fēng zuò làng","abbr":"wfzl","explanation":"比喻平白无故地生出事来。有故意制造事端的意思。同“无风起浪”。","source":{"text":"原文云：却于‘她’字没有讽过。答曰：那是译 She 的，并非无风作浪。","book":"鲁迅《集外集·咬嚼未始“乏味”》"},"similar":["无风起浪","无风生浪"],"usage":"作宾语、定语；用于处事"},{"id":24179,"word":"无风扬波","pinyin":"wú fēng yáng bō","abbr":"wfyb","explanation":"犹言无风起浪。比喻无端生事。","source":{"text":"无风扬波，无事生事，一人好名，毒流万世，卒使管叔流言，新莽藉口。","book":"明·李贽《读》"},"similar":["无风生浪","无风作浪"],"usage":"作宾语、定语；用于处事"},{"id":24180,"word":"无风生浪","pinyin":"wú fēng shēng làng","abbr":"wfsl","explanation":"比喻平白无故地生出事来。有故意制造事端的意思。同“无风起浪”。","source":{"text":"洋澜左蠡，无风浪起。","book":"唐·希运《黄檗断际禅师宛陵录》：“达摩西来，无风起浪；世尊拈花，一场败缺。”宋·释道原《景德传灯录》卷二十六"},"example":{"text":"而施氏～，激夫主以兴波；借剑杀人，逼嫡妻以自尽。","book":"清·西周生《醒世姻缘传》第十三回"},"similar":["无风起浪","无风作浪"],"usage":"作宾语、定语；用于处事"},{"id":24181,"word":"无风起浪","pinyin":"wú fēng qǐ làng","abbr":"wfql","explanation":"没有风却起了波浪。比喻平白无故地生出事来。有故意制造事端的意思。","source":{"text":"洋澜左蠡，无风浪起。","book":"唐·希运《黄檗断际禅师宛陵录》：“达摩西来，无风起浪；世尊拈花，一场败缺。”宋·释道原《景德传灯录》卷二十六"},"example":{"text":"没来由打水不浑，平白地～。","book":"明·胡文焕《群音类选·清腔类·桂枝香》"},"similar":["惹是生非","无理取闹"],"opposite":["息事宁人"],"usage":"作谓语、宾语；指凭空故意制造事端"},{"id":24182,"word":"无馨无臭","pinyin":"wú xīn wú xiù","abbr":"wxwx","explanation":"馨：香。没有香味，也没有臭味。比喻没有名声，不被人知道。","source":{"text":"庶勖将来，无馨无臭。","book":"三国·魏·嵇康《幽愤》"},"example":{"text":"不悴不荣，曾草木之不若；～，与瓦砾其何算。","book":"《南齐书·周颙传》"}},{"id":24183,"word":"既冠之年","pinyin":"jì guān zhī nián","abbr":"jgzn","explanation":"古代男子二十岁行加冠礼，指已成年。","example":{"text":"你已到了～，该自食其力了。"},"usage":"作宾语；指男子20岁"},{"id":24184,"word":"既在矮檐下，怎敢不低头","pinyin":"jì zài ǎi yán xià，zěn gǎn bù dī tóu","abbr":"jzayxzgbdt","explanation":"既：已经，已然；檐：屋檐。比喻在强大的压力之下，不得不向对方屈服。指依附或有求于人，只得委曲求全。","source":{"text":"‘这是既在矮檐下，怎敢不低头。’三藏只得双手合着与他见个礼。","book":"明·吴承恩《西游记》第28回"},"similar":["在人屋檐下，怎敢不低头"],"usage":"作宾语、定语、分句；用于处事"},{"id":24185,"word":"既往不咎","pinyin":"jì wǎng bù jiù","abbr":"jwbj","explanation":"咎：责怪。原指已经做完或做过的事，就不必再责怪了。现指对以往的过错不再责备。","source":{"text":"成事不说，逐事不谏，既往不咎。","book":"《论语·八佾》"},"example":{"text":"～，以后再办起事来，审慎点就是了。","book":"清·吴趼人《痛史》第十三回"},"similar":["既往不究"],"opposite":["赏罚分明","信赏必罚"],"usage":"作谓语、定语；指对以往的错不再责备","story":["春秋时期，鲁哀公问孔子的弟子宰我用什么树木制作土地神神主，宰我回答夏朝人用松木，殷代人用柏木，周代人用栗木，栗木就是让人害怕。孔子听到这种回答十分不满，责备宰我说：“成事不说，遂事不谏，既往不咎。”"]},{"id":24186,"word":"既得利益","pinyin":"jì dé lì yì","abbr":"jdly","explanation":"指人们或集团已经获得的，法定的某种特别权益。","source":{"text":"凡在国内和平开始时，属于边区管辖地域内，一切已经分配过的土地房屋和已经废除过的债务，本府本处当保护人民既得利益，不准擅自变更。","book":"毛泽东《陕甘宁边区政府第八路军后方留守处布告》"},"example":{"text":"这既然是他的～，他当然不会轻言放弃。"},"usage":"作主语、宾语、定语；用于处事"},{"id":24187,"word":"既成事实","pinyin":"jì chéng shì shí","abbr":"jcss","explanation":"既成：已成。已经形成的事实。","source":{"text":"鸣雨既过渐细微，映空摇扬如丝飞。","book":"唐·杜甫《雨不绝》诗"},"example":{"text":"对于～的婚姻，我们要通过法律手段解决。"},"similar":["木已成舟"],"usage":"作定语、宾语；指已经形成的事实"},{"id":24188,"word":"既有今日，何必当初","pinyin":"jì yǒu jīn rì，hé bì dāng chū","abbr":"jyjrhbdc","explanation":"既然现在后悔，当初为什么要那样做？。","source":{"text":"曰：‘中下之流，如何领会？’师曰：‘伏尸万里。’曰：‘早知今日事，悔不慎当初。’","book":"宋·释普济《五灯会元·天衣怀禅师法嗣·惠林宗本禅师》"},"example":{"text":"宝玉在身后面叹道：“～？”","book":"清·曹雪芹《红楼梦》第二十八回"},"similar":["早知如此，何必当初"],"usage":"作谓语、分句；用于数落人"},{"id":24189,"word":"既来之，则安之","pinyin":"jì lái zhī，zé ān zhī","abbr":"jlzzaz","explanation":"既：已经；来之：使之来；安之：使之安。原意是既然把他们招抚来，就要把他们安顿下来。后指既然来了，就要在这里安下心来。","source":{"text":"夫如是，故远人不服，则修文德以来之。既来之，则安之。","book":"《论语·季氏》"},"example":{"text":"但～，姑且住下再说。","book":"清·吴趼人《二十年目睹之怪现状》第一○二回"},"similar":["随遇而安"],"opposite":["来无影，去无踪"],"usage":"作状语；表示既然来了就要安心"},{"id":24190,"word":"日上三竿","pinyin":"rì shàng sān gān","abbr":"rssg","explanation":"太阳升起有三根竹竿那样高。形容太阳升得很高，时间不早了。也形容人起床太晚。","source":{"text":"日上三竿。古诗云：日上三竿风露消。","book":"《南齐书·天文志上》：“永明五年十一月丁亥，日出高三竿，朱色赤黄。”唐·韩愈《岁华纪丽》卷一"},"example":{"text":"及～，方有旨意出来道：“朕心不快，众官免朝。”","book":"明·吴承恩《西游记》第十回"},"similar":["日已三竿"],"opposite":["半夜三更"],"usage":"作谓语、定语；形容太阳升得很高"},{"id":24191,"word":"日下无双","pinyin":"rì xià wú shuāng","abbr":"rxws","explanation":"日下：指京城。京城无人可比。比喻才能出众。","source":{"text":"父友人乐安任昉深相叹异，常曰：‘此子日下无双。’","book":"《梁书·伏挺传》"},"example":{"text":"江东第一家传正始之音，～誉重名流之首。","book":"唐·王勃《上明员外启》"},"similar":["天下无双"],"usage":"作谓语、定语；指才能出众"},{"id":24192,"word":"日不我与","pinyin":"rì bù wǒ yǔ","abbr":"rbwy","explanation":"时日不等待我。极言应抓紧时间。","source":{"text":"然日不我与，曜灵急节，面有过景之速，别有参商之阔。","book":"三国·魏·曹植《与吴季重书》"},"similar":["时不我待"],"usage":"作宾语、定语、分句；指要抓紧时间"},{"id":24193,"word":"日不暇给","pinyin":"rì bù xiá jǐ","abbr":"rbxj","explanation":"暇：空闲；给：足够。指事情繁多，时间不够，来不及做完。","source":{"text":"虽日不暇给，规摹宏远矣。","book":"《汉书·高帝纪下》"},"example":{"text":"谁知一个传十，十个传百，官幕两途拿轿子来接的渐渐有～之势。","book":"清·刘鹗《老残游记》第三回"},"similar":["日理万机","日夜操劳"],"opposite":["无所事事"],"usage":"作谓语、定语；指没有时间休息","story":["公元前202年，刘邦战胜了项羽建立汉朝。他把全国分封给有战功的人，封他为诸侯。废除秦朝的各种旧制，命丞相萧何制订国家根本大法《九章律》，让韩信制订军法，让大夫陆贾负责制订礼制，他每天忙得一点空闲时间都没有"]},{"id":24194,"word":"日不移影","pinyin":"rì bù yí yǐng","abbr":"rbyy","explanation":"日影没有移动。形容时间极短。","source":{"text":"自到都下，撺过卷子。小官日不移影，应对万言，圣人大喜。","book":"元·郑光祖《倩女离魂》第三折"},"example":{"text":"不期世充手下秦书宝英雄，～，败唐将数十余员。","book":"明·无名氏《智降秦叔宝》第四折"},"similar":["日不移晷"],"usage":"作谓语、定语；比喻非常迅速"},{"id":24195,"word":"日不移晷","pinyin":"rì bù yí guǐ","abbr":"rbyg","explanation":"比喻只一刹那，非常迅速。","source":{"text":"人不还踵，日不移晷。","book":"《汉书·王莽传上》"},"example":{"text":"《隶释·汉巴郡太守张纳碑》：“～，收功献捷。”"},"similar":["转瞬之间","弹指之间","日不移影"],"usage":"作谓语、定语；比喻只一刹那，非常迅速"},{"id":24196,"word":"日东月西","pinyin":"rì dōng yuè xī","abbr":"rdyx","explanation":"比喻远隔两地，不能相聚。","source":{"text":"十六拍兮思茫茫，我与儿兮各一方。日东月西兮徒相望，不得相随兮空断肠。","book":"汉·蔡琰《胡茄十八拍》"},"similar":["天各一方"],"usage":"作定语；比喻远隔两地，不能相聚"},{"id":24197,"word":"日中为市","pinyin":"rì zhōng wéi shì","abbr":"rzws","explanation":"日中：太阳当头，指正午；市：做买卖。中午进行交易做生意。原指古代物物交换的集市方式。后也形容偏僻地区的商业活动情形。","source":{"text":"日中为市，致天下之民，聚天下之货，交易而退，各得其所。","book":"《周易·系辞下》"},"example":{"text":"草林圩上逢圩（～，三天一次），到圩两万人，为从来所未有。","book":"毛泽东《井冈山的斗争》"},"usage":"作宾语、定语；形容偏僻地区的商业活动"},{"id":24198,"word":"日中则昃","pinyin":"rì zhōng zé zè","abbr":"rzzz","explanation":"昃：太阳偏西。太阳到了正午就要偏西。比喻事物发展到一定程度，就会向相反的方向转化。","source":{"text":"日中则昃，月盈则食，天地盈虚，与时消息，而况乎人乎！","book":"《易·丰》"},"example":{"text":"夫～，盛衰必复。","book":"《新五代史·司天考二》"},"usage":"作谓语；指太阳到了正午就要西斜"},{"id":24199,"word":"日中则昃，月满则亏","pinyin":"rì zhōng zé zè，yuè mǎn zé kuī","abbr":"rzzzymzk","explanation":"太阳到了正午就要偏西，月亮盈满就要亏缺。比喻事物发展到一定程度，就会向相反的方向转化。","source":{"text":"日中则昃，月盈则食，天地盈虚，与时消息，而况乎人乎！","book":"《易·丰》"},"example":{"text":"你但看～，月满则亏，这都是无往不复。","book":"元·无名氏《来生债》第二折"},"similar":["日中则昃，月盈则食"],"usage":"作宾语、定语、定语；用于劝诫人"},{"id":24200,"word":"日中则昃，月盈则食","pinyin":"rì zhōng zé zè，yuè yíng zé shí","abbr":"rzzzyyzs","explanation":"昃：太阳偏西。太阳到了正午就要偏西，月亮到了最圆时就必定开始亏缺。比喻事物发展到一定程度，就会向相反的方向转化。","source":{"text":"日中则昃，月盈则食，天地盈虚，与时消息，而况乎人乎！","book":"《周易·丰》"},"similar":["日中则昃，月满则亏"],"usage":"作宾语、定语、定语；用于劝诫人"},{"id":24201,"word":"日中则移","pinyin":"rì zhōng zé yí","abbr":"rzzy","explanation":"比喻事物发展到一定程度，就会向相反的方向转化。同“日中则昃”。","source":{"text":"语曰：‘日中则移，月满则亏。’物盛则衰，天之常数也；进退、盈缩、变化，圣人之常道也。","book":"《战国策·秦策三》"},"example":{"text":"臣闻峻高者隤，茂叶者摧，～，月满则亏。四时不并盛，五行不俱弛。阴阳更倡，气有盛衰。","book":"汉·赵晔《吴越春秋·勾践归国外传》"},"similar":["日中则昃","日中将昃","日中必移"],"usage":"作宾语、定语；用于比喻句"},{"id":24202,"word":"日中则移，月满则亏","pinyin":"rì zhōng zé yí，yuè mǎn zé kuī","abbr":"rzzyymzk","explanation":"移：迁移。太阳到了正午就要西斜，月亮满圆就要亏缺。比喻事物盛极必衰，或发展到一定限度就会向相反方向转化。","source":{"text":"语曰：‘日中则移，月满则亏。’物盛则衰，天之常数也。","book":"西汉·刘向《战国策·秦策》"},"example":{"text":"臣闻峻高者聩，茂叶者摧，～。","book":"汉·赵晔《吴越春秋·勾践归国外传》"},"similar":["日中必移，月满必亏"],"usage":"作宾语、定语、分句；用于书面语"},{"id":24203,"word":"日中将昃","pinyin":"rì zhōng jiāng zè","abbr":"rzjz","explanation":"比喻事物盛极将衰。同“日中则昃”。","source":{"text":"世界文明史之第五段，实惟阿利安族中罗马人与条顿人争长时代。而罗马人达于全盛，为日中将昃之形；条顿人气象方新，有火然泉达之观。","book":"梁启超《新史学·历史与人种之关系》"},"similar":["日中则昃","日中则移"],"usage":"作宾语、定语；用于比喻句"},{"id":24204,"word":"日中必彗","pinyin":"rì zhōng bì huì","abbr":"rzbh","explanation":"彗：晒干。太阳到中午正好晒东西。比喻做事应该当机立断，不失时机。","source":{"text":"日中必彗，操刀必割。","book":"《六韬·文韬·守土》"},"usage":"作谓语、补语；比喻做事要及时"},{"id":24205,"word":"日中必昃","pinyin":"rì zhōng bì zè","abbr":"rzbz","explanation":"比喻事物发展到一定程度，就会向相反的方向转化。同“日中则昃”。","source":{"text":"日中必昃，月满必亏。明公功名到此，已无可加，急流勇退，此其时矣。","book":"《二刻拍案惊奇》卷十九"},"similar":["日中则昃","日中必移"],"usage":"作宾语、定语；用于比喻句"},{"id":24206,"word":"日中必昃，月满必亏","pinyin":"rì zhōng bì zè，yuè mǎn bì kuī","abbr":"rzbzymbk","explanation":"昃：太阳偏西。太阳到了正午就要西斜，月亮满圆就要亏缺。比喻事物盛极必衰，或发展到一定限度就会向相反方向转化。","source":{"text":"日中必昃，月满必亏。明公功名到此，已无可加，急流勇退，此其时矣。","book":"明·凌濛初《二刻拍案惊奇》第19卷"},"similar":["日中则昃，月盈则食"],"usage":"作宾语、定语、定语；用于劝诫人"},{"id":24207,"word":"日中必湲","pinyin":"rì zhōng bì tóng","abbr":"rzby","explanation":"比喻做事应该当机立断，不失时机。同“日中必彗”。"},{"id":24208,"word":"日中必移","pinyin":"rì zhōng bì yí","abbr":"rzby","explanation":"比喻事物发展到一定程度，就会向相反的方向转化。同“日中则昃”。","source":{"text":"日中必移，月满必亏；先王之道，乍存乍亡。","book":"《史记·日者列传》"},"similar":["日中必昃","日中则昃"],"usage":"作宾语、定语；用于比喻句"},{"id":24209,"word":"日中必移，月满必亏","pinyin":"rì zhōng bì yí，yuè mǎn bì kuī","abbr":"rzbyymbk","explanation":"移：迁移。太阳到了正午就要西斜，月亮满圆就要亏缺。比喻事物盛极必衰，或发展到一定限度就会向相反方向转化。","source":{"text":"日中必移，月满必亏；先王之道，乍存乍亡。","book":"西汉·司马迁《史记·日者列传》"},"similar":["日中必移，月满则亏"],"usage":"作宾语、定语、分句；用于书面语"},{"id":24210,"word":"日丽风和","pinyin":"rì lì fēng hé","abbr":"rlfh","explanation":"和风习习，阳光灿烂。形容晴朗暖和的天气。","source":{"text":"那时节和风丽日满东园，花共柳红娇绿软。","book":"元·李爱山《集贤宾·春日伤别》"},"example":{"text":"这日正是清明佳节，～。","book":"清·曾朴《孽海花》第七回"},"similar":["风和日丽"],"opposite":["狂风暴雨"],"usage":"作谓语、定语；指很好的天气"},{"id":24211,"word":"日丽风清","pinyin":"rì lì fēng qīng","abbr":"rlfq","explanation":"阳光明丽，清风送爽。形容天气晴和。","source":{"text":"外面日丽风清，蓝天如洗，是一个典型的明净的秋日。","book":"魏巍《东方》第五部第十五章"},"similar":["日丽风和"],"usage":"作谓语、定语；指很好的天气"},{"id":24212,"word":"日久天长","pinyin":"rì jiǔ tiān cháng","abbr":"rjtc","explanation":"时间长，日子久。","source":{"text":"日久天长，这些奴才们跟前，怎么说嘴呢？","book":"清·曹雪芹《红楼梦》第六十九回"},"example":{"text":"学习外语没有什么诀窍，只有靠～地积累。"},"similar":["天长地久","长年累月"],"opposite":["一朝一夕","弹指之间"],"usage":"作状语、分句；形容经过很长时间"},{"id":24213,"word":"日久岁深","pinyin":"rì jiǔ suì shēn","abbr":"rjss","explanation":"岁：年；深：长久。指时间长久。","source":{"text":"总是汝把取翻覆思量，看日久岁深自然有个入路。","book":"宋·释普济《五灯会元·云门文偃禅师》"},"example":{"text":"你将为常言俗语道‘呼蛇容易遣蛇难’，怕～，盘费重大。","book":"《京本通俗小说·志诚张主管》"},"similar":["日久年深"],"usage":"作宾语、定语；指年代久远"},{"id":24214,"word":"日久岁长","pinyin":"rì jiǔ suì cháng","abbr":"rjsc","explanation":"时间长，日子久。同“日久天长”。","source":{"text":"我虽是不好嫁得你出家人，只是认做兄妹往来，谁禁得我？这便可以日久岁长的了。","book":"《初刻拍案惊奇》卷十七"},"similar":["日久岁深"],"usage":"作宾语、定语；指年代久远"},{"id":24215,"word":"日久年深","pinyin":"rì jiǔ nián shēn","abbr":"rjns","explanation":"指日子长，时间久。","source":{"text":"我这病，年深日久，数个良医，不曾医的好。","book":"明·无名氏《打韩通》"},"example":{"text":"这庙～失修已经破烂不堪了。"},"similar":["日久天长","日积月累"],"opposite":["一朝一夕","一时半刻"],"usage":"作宾语、状语、分句；用于时间的久远"},{"id":24216,"word":"日久忘怀","pinyin":"rì jiǔ wàng huái","abbr":"rjwh","explanation":"时间长久就不太介意而忘掉了。"},{"id":24217,"word":"日久月深","pinyin":"rì jiǔ yuè shēn","abbr":"rjys","explanation":"深：长久。指时间长久。","source":{"text":"又在京之官，积年一考……虽当时文簿，记其殿最，日久月深，驳落都尽，人有去留，谁复掌其勤堕？","book":"《魏书·萧宝夤传》"},"example":{"text":"若坐想存神，志羸气惫，纵使宣明口势，吐纳开张，皆须～，倦于赊阔。","book":"宋·张君房《云笈七签》六十"},"similar":["日久岁深"],"usage":"作宾语、定语；指时间久远"},{"id":24218,"word":"日久玩生","pinyin":"rì jiǔ wán shēng","abbr":"rjws","explanation":"玩：忽视。日子长久了，种种弊病便相继发生。","source":{"text":"十一年，谕沿海疆吏，当乾隆五十五年，曾严饬统兵官实力训练舟师，乃日久玩生，弁兵于操驾事宜，全不练习，遇放洋之时，雇用舵工，名为舟师，不谙水务。","book":"《清史稿·兵志六》"},"example":{"text":"并且，在群众性的社会运动中，有些坏现象即便匿迹于一时，而～，又可能重新出现。","book":"马南邨《燕山夜话·为什么会吵嘴》"}},{"id":24219,"word":"日久见人心","pinyin":"rì jiǔ jiàn rén xīn","abbr":"rjjrx","explanation":"日子长了，就可以看出一个人的为人怎样。","source":{"text":"路遥知马力，事久见人心。","book":"宋·陈元靓《事林广记》卷九"},"example":{"text":"我少不得报答姐姐之恩，可不道路遥知马力，～。(元·无名氏《争报恩》第一折"},"similar":["路遥知马力"],"usage":"作分句；指时间可以证明一切"},{"id":24220,"word":"日乾夕惕","pinyin":"rì qián xī tì","abbr":"rqxt","explanation":"形容自早至晚勤奋谨慎，不敢懈怠。乾乾，自强不息貌；惕，小心谨慎。","source":{"text":"君子终日乾乾，夕惕若厉，无咎。","book":"语出《易·乾》"},"example":{"text":"良由大政亲裁，～。","book":"清·陈康祺《郎潜纪闻》卷一"},"usage":"作谓语、定语；用于书面语"},{"id":24221,"word":"日亲以察","pinyin":"rì qīn yǐ chá","abbr":"rqyc","explanation":"每天亲自观察。","source":{"text":"象载昭庭，日亲以察。","book":"《汉书·礼乐志二》"}},{"id":24222,"word":"日亲日近","pinyin":"rì qīn rì jìn","abbr":"rqrj","explanation":"近：亲近。经常在一起就越来越亲近。","source":{"text":"自此高俅遭际在王都尉府中，出入如同家人一般。自古道：‘日远日疏，日亲日近。’","book":"明·施耐庵《水浒全传》第一回"},"example":{"text":"况且昨日叨扰宝云姐姐，既无一人做假，无不尽欢，无不尽量，我们～，安有今日倒来做假之理。","book":"清·李汝珍《镜花缘》第八十三回"},"similar":["日远日疏，日亲日近"],"usage":"作定语；用于交往等"},{"id":24223,"word":"日以为常","pinyin":"rì yǐ wéi cháng","abbr":"rywc","explanation":"经常做某件事，成了惯例常规。","source":{"text":"不然则予之耽寝，日以为常，记者语简而不尽其详，亦不可知。","book":"金·王若虚《〈论语〉辨惑二》"},"example":{"text":"妪往来两地，～。","book":"清·珠泉居士《续板桥杂记·轶事》"},"similar":["习以为常"],"usage":"作谓语、定语；用于人或事"},{"id":24224,"word":"日以继夜","pinyin":"rì yǐ jì yè","abbr":"ryjy","explanation":"晚上连着白天。形容加紧工作或学习。","source":{"text":"孤日夜相继，匍匐就君。","book":"春秋·鲁·左丘明《国语·吴语》"},"example":{"text":"他们～，夜以继日，栖在小房子里。","book":"丁玲《韦护》第三章"},"similar":["夜以继日"],"usage":"作状语；指日夜不停"},{"id":24225,"word":"日修夜短","pinyin":"rì xiū yè duǎn","abbr":"rxyd","explanation":"修：长。指夏至前后的几个月昼长夜短。","source":{"text":"阳气胜则日修而夜短，阴气胜则日短而夜修。","book":"西汉·刘安《淮南子·天文训》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":24226,"word":"日出三竿","pinyin":"rì chū sān gān","abbr":"rcsg","explanation":"太阳升起来离地面已有三根竹竿那样高。约为午前八、九点钟。形容天已大亮，时间不早了。也形容人起床太晚。","source":{"text":"永明五年十一月丁亥，日出高三竿，朱色赤黄，日晕，虹抱珥直背。","book":"《南齐书·天文志上》"},"example":{"text":"～春雾消，江头蜀客驻兰桡。","book":"唐·刘禹锡《竹枝词》之四"},"similar":["日上三竿"],"usage":"作定语、宾语；指时间不早了"},{"id":24227,"word":"日出不穷","pinyin":"rì chū bù qióng","abbr":"rcbq","explanation":"形容接连不断地出现。","source":{"text":"而新书新报日出不穷者，无愚智皆读之。","book":"清·裘廷梁《论白话为维新之本》"},"example":{"text":"新的尊严者～，对于旧的尊严者就不利，而且知道文字的人们一多，也会损伤神秘性的。鲁迅《且介亭杂文·门外文谈》"},"similar":["层出不穷"],"opposite":["断断续续"],"usage":"作谓语、定语；表示连续不断地出现"},{"id":24228,"word":"日出冰消","pinyin":"rì chū bīng xiāo","abbr":"rcbx","explanation":"消：溶解。太阳一出来冰就溶解。形容一下子消失了。","source":{"text":"石敬瑭见张守一说了这四句，心下自晓得这意义了，那病忽然更醒，如风行云卷，日出冰消。","book":"《新编五代史评话·晋史》"},"usage":"作宾语、定语；多用于比喻句"},{"id":24229,"word":"日出而作","pinyin":"rì chū ér zuò","abbr":"rcez","explanation":"作：劳动。太阳出来就出去劳动。指古人纯朴简单的劳动生活。","source":{"text":"日出而作，日入而息。逍遥于天下之间，而心意自得。","book":"《庄子·让王》"}},{"id":24230,"word":"日出而作，日入而息","pinyin":"rì chū ér zuò，rì rù ér xī","abbr":"rcezrrex","explanation":"太阳升起就起来劳动，太阳下山就休息。原指上古人民的生活方式，后亦泛指单纯简朴的生活。","source":{"text":"日出而作，日入而息，逍遥于天地之间而心意自得。","book":"《庄子·让王》"},"example":{"text":"席匠铺的人～，按节令耕种收打，按政策交售爱国粮，过着平平静静的生活。","book":"《花城》1981年第6期"},"similar":["日出而作，日落而息"],"usage":"作谓语、宾语、定语；用于简朴的生活"},{"id":24231,"word":"日出而作，日落而息","pinyin":"rì chū ér zuò，rì luò ér xī","abbr":"rcezrlex","explanation":"作：做工。太阳升起就做工，太阳下山就休息。泛指简朴单纯的生活。","source":{"text":"如果你从小就在这个天地里日出而作，日落而息，那你现在就会和众乡亲抱同一理想。","book":"路遥《平凡的世界》第三卷第12章"},"similar":["日出而作，日入而息"],"usage":"作谓语、宾语、定语；用于简朴的生活"},{"id":24232,"word":"日削月割","pinyin":"rì xuē yuè gē","abbr":"rxyg","explanation":"每日每月割让土地。形容一味割地求和。","source":{"text":"日削月割，以趋于亡。","book":"宋·苏洵《六国论》"},"similar":["日削月朘"],"usage":"作谓语；指被蚕食"},{"id":24233,"word":"日削月朘","pinyin":"rì xuē yuè juān","abbr":"rxyj","explanation":"朘：缩小，减少。日日削减，月月缩小。形容逐渐缩小。也指时时受到搜刮。","source":{"text":"民日削月朘，寖以大穷。","book":"汉·班固《汉书·董仲舒传》"},"example":{"text":"民～，未知救弊之术。","book":"宋·洪迈《容斋五笔·卷二》"},"similar":["日朘月削","日削月减"],"opposite":["日积月累"],"usage":"作谓语、定语；形容逐渐缩小"},{"id":24234,"word":"日削月杒","pinyin":"rì xuē yuè juān","abbr":"rxyj","explanation":"杒缩小，减少。日日削减，月月缩小。形容逐渐缩小。也指时时受到搜刮。","source":{"text":"民日削月杒，寖以大穷。","book":"汉·班固《汉书·董仲舒传》"},"quote":{"text":"民～，未知救弊之术。","book":"宋·洪迈《容斋五笔·卷二》"}},{"id":24235,"word":"日升月恒","pinyin":"rì shēng yuè gèng","abbr":"rsyh","explanation":"恒：音“更”，月上弦。如同太阳刚刚升起，月亮初上弦一般。比喻事物正当兴旺的时候。旧时常用作祝颂语。","source":{"text":"如月之恒，如日之升。","book":"《诗经·小雅·天保》"},"example":{"text":"德与年而俱进，如～。","book":"明·归有光《震川集·少傅陈公六十寿辰》"},"usage":"作定语、补语；比喻事物正当兴旺的时期"},{"id":24236,"word":"日和风暖","pinyin":"rì hé fēng nuǎn","abbr":"rhfn","explanation":"形容天气晴好。同“日暖风和”。","source":{"text":"腊后春前暖律催，日和风暖欲开梅。","book":"宋·范纯仁《鹧鸪天·和韩持国》词"},"similar":["日暖风和","风和日暖","日暖风恬"],"usage":"作谓语、定语；指好天气"},{"id":24237,"word":"日图三餐，夜图一宿","pinyin":"rì tú sān cān，yè tú yī sù","abbr":"rtscytyx","explanation":"图：盼望；宿：住宿。每天只盼望有饭吃，晚上有睡觉的地方。形容胸无大志，安于现状。"},{"id":24238,"word":"日坐愁城","pinyin":"rì zuò chóu chéng","abbr":"rzcc","explanation":"愁城：比喻为忧愁所包围。整天沉浸在愁苦之中。","source":{"text":"一曲红窗声里怨，如今分作两愁城。","book":"宋·范成大《次韵代答刘文潜》诗"},"example":{"text":"缘贫病交浸，～苦海故也。","book":"清·高咏《致颜逊甫书》"},"usage":"作谓语；指整天沉浸在愁苦之中"},{"id":24239,"word":"日堙月塞","pinyin":"rì yīn yuè sāi","abbr":"ryys","explanation":"一天天堵塞，不通畅。","source":{"text":"举国尚俭，则举国之地利日堙月塞，驯至穷蹙不可终日。东方诸国之瘠亡，盖以此也。","book":"梁启超《〈史记·货殖列传〉今义》"},"usage":"作谓语、宾语；用于书面语"},{"id":24240,"word":"日增月益","pinyin":"rì zēng yuè yì","abbr":"rzyy","explanation":"一天天一月月地增添、加多。","source":{"text":"自时厥后，国用寖广。除税粮、科差二者之外，凡课之入，日增月益。至于天历之际，视至元、大德之数，盖增二十倍矣。","book":"《元史·食货志序》"},"example":{"text":"岁时颁赐，库藏为虚。而四方奇珍异宝、名禽殊兽进献上方者，亦～。","book":"《明史·西域传四·刊城》"},"similar":["日益月滋"],"opposite":["日朘月削"],"usage":"作谓语、定语；用于数量增加"},{"id":24241,"word":"日增月盛","pinyin":"rì zēng yuè shèng","abbr":"rzys","explanation":"一天天一月月地增加、兴盛。","source":{"text":"明崇祯时，麻荫朱实立第一印书局，印器从英运至，其后日增月盛。","book":"清·王韬《瓮牖馀谈·西国印书考》"},"example":{"text":"日本近来著东洋史者，～，实则中国史之异名耳。","book":"梁启超《中国史叙论》第二节"},"similar":["日新月盛","日增月益"],"usage":"作定语、状语；用于事物等"},{"id":24242,"word":"日复一日","pinyin":"rì fù yī rì","abbr":"rfyr","explanation":"复：再，又。过了一天又一天。比喻日子久，时间长。也形容光阴白白地过去。","source":{"text":"天下重器，常恐不任，日复一日，安敢远期十岁乎？","book":"《后汉书·光武帝纪》"},"example":{"text":"年复一年，～，生涯几何，宁堪此弃掷哉？","book":"清·无名氏《杜诗言志》卷一"},"similar":["年复一年"],"usage":"作分句、状语；形容时光流逝"},{"id":24243,"word":"日夜兼程","pinyin":"rì yè jiān chéng","abbr":"ryjc","explanation":"不分白天黑夜拼命赶路。","source":{"text":"第一批中国人民志愿军平山部，日夜兼程开到东北某地。","book":"袁静《伏虎记》第四回"},"example":{"text":"我们～，很快就到达目的地。"},"similar":["昼夜兼程"],"usage":"作谓语、宾语、状语；指赶路"},{"id":24244,"word":"日夜如梭","pinyin":"rì yè rú suō","abbr":"ryrs","explanation":"白天和黑夜像穿梭一样，形容时间过得很快。","example":{"text":"～，很快就到月底了。"},"similar":["日月如梭"],"usage":"作宾语、分句；形容时间过得很快"},{"id":24245,"word":"日夜警戒","pinyin":"rì yè jǐng jiè","abbr":"ryjj","explanation":"白天黑夜不断警戒或监视。","example":{"text":"她～着丈夫有外遇。"},"opposite":["麻痹大意"],"usage":"作谓语；指高度警惕"},{"id":24246,"word":"日富月昌","pinyin":"rì fù yuè chāng","abbr":"rfyc","explanation":"富：富裕；昌：昌盛。一天天地富裕昌盛起来。","source":{"text":"捷慑逐物，日富月昌。","book":"《后汉书·赵壹传》"}},{"id":24247,"word":"日就月将","pinyin":"rì jiù yuè jiāng","abbr":"rjyj","explanation":"就：成就；将：进步。每天有成就，每月有进步。形容精进不止。也日积月累。","source":{"text":"日就月将，学有缉熙于光明。","book":"《诗经·周颂·敬之》"},"example":{"text":"～，渐益堆积。","book":"宋·李清照《金石录后序》"},"usage":"作谓语；用于学习"},{"id":24248,"word":"日居月诸","pinyin":"rì jī yuè zh","abbr":"rjyz","explanation":"居：音“积”，语助词，同“乎”；诸：语助词。指光阴的流逝。","source":{"text":"日居月诸，照临下土。","book":"《诗经·邶风·日月》"},"example":{"text":"～，见一心之妙用。","book":"清·钱彩《说岳全传》第73回"},"usage":"作分句；指光阴的流逝"},{"id":24249,"word":"日居衡茅","pinyin":"rì jū héng máo","abbr":"rjhm","explanation":"晶：每天；衡茅：用衡木做门的茅草屋。每天居住在简陋的茅草屋中，不知天下大事。","source":{"text":"弟日居衡茅，故不知仕途之关窍耳。","book":"清·蒲松龄《聊斋志异·梦狼》"}},{"id":24250,"word":"日已三竿","pinyin":"rì yǐ sān gān","abbr":"rysg","explanation":"形容太阳升得很高，时间不早了。也形容人起床太晚。同“日上三竿”。","source":{"text":"你看日已三竿，且到佛殿前探望一回何如？","book":"明·王錂《春芜记·探遗》"},"similar":["日上三竿","日出三竿"],"usage":"作谓语、定语；形容太阳升得很高"},{"id":24251,"word":"日异月新","pinyin":"rì yì yuè xīn","abbr":"ryyx","explanation":"指发展或进步迅速，不断出现新事物、新气象。同“日新月异”。","source":{"text":"近年以来，殊诡制，日异月新。","book":"明·顾起元《客座赘语·巾履》"},"example":{"text":"幽斋陈设，妙在～。","book":"清·李渔《闲情偶寄·器玩·位置》"},"similar":["日新月异"],"usage":"作谓语、宾语、定语；指变化大"},{"id":24252,"word":"日异月更","pinyin":"rì yì yuè gèng","abbr":"ryyg","explanation":"日日不同，月月改变。形容变化快。","source":{"text":"文字之变，日异月更，不可穷诘。","book":"明·谢肇淛《五杂俎·事部三》"},"similar":["日新月异"],"usage":"作谓语、定语；指变化快"},{"id":24253,"word":"日异月殊","pinyin":"rì yì yuè shū","abbr":"ryys","explanation":"每天每月都有差异。形容变化大。","source":{"text":"农工商贾，厮养皂隶，所作之事，日化月迁，所说之语，亦日异月殊，以其新也。","book":"明·袁宗道《论隐者异趣》"},"similar":["日异月更"],"usage":"作谓语、定语；指变化快"},{"id":24254,"word":"日引月长","pinyin":"rì yǐn yuè cháng","abbr":"ryyc","explanation":"引：延伸，这里有增加的意思。指事物随着时光的流逝而日渐增长。","source":{"text":"是以国家不日引，不月长。","book":"《国语·齐语》"},"example":{"text":"始于洒扫应对进退而不急于道，使其来者自尽于学，～而道自至。","book":"宋·朱熹《读苏氏纪年》"},"usage":"作谓语、定语；用于书面语"},{"id":24255,"word":"日往月来","pinyin":"rì wǎng yuè lái","abbr":"rwyl","explanation":"形容岁月流逝。","source":{"text":"日往则月来，月往则日来，日月相推而明生焉。","book":"《周易·系辞下》"},"example":{"text":"～，暑退寒袭。","book":"晋·潘岳《夏侯常侍诔》"},"similar":["寒来暑往","日来月往"],"usage":"作分句；形容岁月不断流逝"},{"id":24256,"word":"日征月迈","pinyin":"rì zhēng yuè mài","abbr":"rzym","explanation":"喻指时间不断推移。","source":{"text":"迈、征、皆行也。","book":"语出《诗·小雅·小宛》：“我日斯迈，而月斯征。”郑玄笺"},"example":{"text":"～，寒暑衣褐。","book":"明·沈榜《宛署杂记·宣谕》"},"similar":["日月逾迈"],"usage":"作宾语、定语；用于时间飞逝"},{"id":24257,"word":"日慎一日","pinyin":"rì shèn yī rì","abbr":"rsyr","explanation":"慎：谨慎。一天比一天谨慎。形容做事十分小心。","source":{"text":"战战栗栗，日慎一日。","book":"《韩非子·初见秦》"},"example":{"text":"八年于兹，业业兢兢，～。","book":"《旧五代史·梁书·末帝纪下》"},"usage":"作谓语、状语；用于为人"},{"id":24258,"word":"日拙心劳","pinyin":"rì zhuō xīn láo","abbr":"rzxl","explanation":"日：逐日；拙：笨拙；心劳：费尽心机。现多指做坏事的人，虽然使尽坏心眼，到头来不但捞不到好处，处境反而一天比一天糟。","source":{"text":"作德，心逸日休，作伪，心劳日拙。","book":"《尚书·周官》"},"example":{"text":"戴天履地，宁忍同诬，～，徒唱尔伪。","book":"宋·邵博《闻见后录》卷二十三"}},{"id":24259,"word":"日新月异","pinyin":"rì xīn yuè yì","abbr":"rxyy","explanation":"新：更新；异：不同。每天都在更新，每月都有变化。指发展或进步迅速，不断出现新事物、新气象。","source":{"text":"苟日新，日日新，又日新。","book":"《礼记·大学》"},"example":{"text":"教授之术，亦采法列强，教科之书，～。","book":"清·吴趼人《痛史·原叙》"},"similar":["一日千里","与日俱进"],"opposite":["一成不变","故步自封","依然如故"],"usage":"作谓语、宾语、定语；指变化大"},{"id":24260,"word":"日新月盛","pinyin":"rì xīn yuè shèng","abbr":"rxys","explanation":"每天每月都有变化、增加。形容不断发展。","source":{"text":"而异端之说，日新月盛。","book":"宋·朱熹《〈中庸章句〉序》"},"example":{"text":"天地之生才无穷，而文章之变，～，有非古人所能限者，此亦以见斯文之广大。","book":"清·郭嵩焘《〈古微堂诗集〉序》"},"similar":["日增月盛"],"usage":"作定语、状语；用于事物等"},{"id":24261,"word":"日新月著","pinyin":"rì xīn yuè zhù","abbr":"rxyz","explanation":"日日更新，月月显著。形容蓬勃发展。","source":{"text":"臣备位词林，以文字为职业，亲见圣德大业日新月著，于是与僚属谋取其有关政要者，编集成书，列为上下卷，凡七类合若干条，名曰《洪武圣政记》。","book":"明·宋濂《〈洪武圣政记〉序》"},"usage":"作谓语、定语；用于事物变化等"},{"id":24262,"word":"日无暇晷","pinyin":"rì wú xiá guǐ","abbr":"rwxg","explanation":"晷：日影，指时光。形容没有一点空闲的时候。","source":{"text":"文忠有世交侄某，乞文忠为之汲引。时值军书旁午，文忠日无暇晷，亦遂亡之。","book":"清·李宝嘉《南亭笔记》九"},"example":{"text":"清·李宝嘉《官场现形记》第57回：“他自从接了这四个差使之后，一天到晚真正是～，没有一天不上院。”"},"similar":["日理万机"],"usage":"作谓语、定语、状语；形容没有一点空闲"},{"id":24263,"word":"日日夜夜","pinyin":"rì rì yè yè","abbr":"rryy","explanation":"每天每夜。形容延续的时间长。","source":{"text":"这里，刘秀三日日夜夜的车水，车的晕倒在水车上。","book":"洪深《青龙潭》第二幕"},"example":{"text":"在重庆红岩的～，你英勇斗争，临危不惧。","book":"郭小川《痛悼敬爱的周总理》诗"},"similar":["每天每夜"],"usage":"作宾语、状语；形容时间长"},{"id":24264,"word":"日旰不食","pinyin":"rì gàn bù shí","abbr":"rgbs","explanation":"形容专心致志，勤勉不懈。同“日旰忘食”。","source":{"text":"故王之忧国者日旰不食，士之忧位者载贽出疆。","book":"唐·皮日休《忧赋》"},"similar":["日旰忘食","废寝忘食"],"usage":"作谓语、定语、状语；用于处事等"},{"id":24265,"word":"日旰忘食","pinyin":"rì gàn wàng shí","abbr":"rgws","explanation":"天色已晚仍顾不上吃饭。形容专心致志，勤勉不懈。","source":{"text":"与班彪亲善，每相遇，辄日旰忘食，夜分不寝。","book":"《后汉书·儒林传上·尹敏》"},"example":{"text":"天子未明求衣，～，犹恐万机不理，天下拥滞。","book":"《周书·乐运传》"},"similar":["日旰不食","废寝忘食","日旰忘餐"],"usage":"作谓语、定语、状语；用于处事等"},{"id":24266,"word":"日旰忘餐","pinyin":"rì gàn wàng cān","abbr":"rgwc","explanation":"旰：天色晚。形容工作勤劳，忘了时间，忘了吃饭。","source":{"text":"日旰忘食，夜分不寝。","book":"《后汉书·尹敏传》"},"example":{"text":"天子未明求衣，～，犹恐万机不理，天下拥滞。","book":"《周书·颜之仪传》"},"similar":["日旰忘食","废寝忘食","日旰不食"],"usage":"作谓语、状语；用于工作与学习"},{"id":24267,"word":"日昃不食","pinyin":"rì zè bù shí","abbr":"rzbs","explanation":"太阳已偏西还不吃饭。形容专心致志，勤勉不懈。","source":{"text":"尧步、舜趋、禹驰、汤骤，世愈降则愈劳。况欲以过门不入、日昃不食之世，反诸标枝野鹿，其不为西晋者几希？","book":"清·魏源《默觚下·治篇二》"},"similar":["日昃旰食","日昃忘食"],"usage":"作谓语、定语；用于指人勤奋"},{"id":24268,"word":"日昃之劳","pinyin":"rì zè zhī láo","abbr":"rzzl","explanation":"昃：太阳西斜。从早晨到午后一直顾不上吃饭。形容工作繁忙。","source":{"text":"文王有日昃之劳，周公执吐握之恭。","book":"《后汉书·陈元传》"}},{"id":24269,"word":"日昃之离","pinyin":"rì zè zhī lí","abbr":"rzzl","explanation":"昃：太阳西斜；离：附着。太阳西斜附在天边，不久将落。","source":{"text":"日昃之离，不鼓缶而歌，则大耄之嗟，凶。","book":"《周易·离》"}},{"id":24270,"word":"日昃忘食","pinyin":"rì zè wàng shí","abbr":"rzws","explanation":"太阳已偏西还顾不上吃饭。形容专心致志，勤勉不懈。","source":{"text":"未能雪天人之大耻，解众庶之倒悬，日昃忘食，枕戈待旦。","book":"《晋书·张轨传》"},"example":{"text":"是用～，中宵愤惋者也。","book":"《魏书·鹿愈传》"},"similar":["日昃不食"],"usage":"作谓语、定语；用于指人勤奋"},{"id":24271,"word":"日昃旰食","pinyin":"rì zè gàn shí","abbr":"rzgs","explanation":"太阳偏西天色晚了才吃饭。形容勤于政事。","source":{"text":"王者临深履尾，不足喻危，假寢待旦，日昃旰食，将何为惧祸及也？","book":"晋·葛洪《抱朴子·诘鲍》"},"similar":["日昃忘食"],"usage":"作谓语、定语；用于指人勤奋"},{"id":24272,"word":"日暖风和","pinyin":"rì nuǎn fēng hé","abbr":"rnfh","explanation":"阳光温暖，微风各煦。形容天气晴好。","source":{"text":"不久，海上风和日暖。","book":"宋·刘斧《青琐高义·别集》卷二"},"example":{"text":"玉勒雕鞍争驰，佳时～。","book":"明·胡文焕《群音类选·清腔类·夜行船》"},"similar":["风和日暖","日和风暖","日暖风恬"],"usage":"作谓语、定语；指好天气"},{"id":24273,"word":"日暖风恬","pinyin":"rì nuǎn fēng tián","abbr":"rnft","explanation":"形容天气晴好。同“日暖风和”。","source":{"text":"日暖风恬种药时，红泉翠壁薜萝垂。","book":"唐·钱起《山中酬杨补阙见访》诗"},"similar":["日和风暖"],"usage":"作谓语、定语；指好天气"},{"id":24274,"word":"日暮路远","pinyin":"rì mù lù yuǎn","abbr":"rmly","explanation":"比喻处境十分困难，到了末日。也形容穷困到极点。同“日暮途远”。","source":{"text":"日暮路远，还有挫气；师老将贪，争掠易败。","book":"《尉缭子·兵教下》"},"similar":["日暮道远"],"usage":"作谓语、定语、状语；用于人的处境"},{"id":24275,"word":"日暮途穷","pinyin":"rì mù tú qióng","abbr":"rmtq","explanation":"暮：傍晚；途：路。天已晚了，路已走到了尽头。比喻处境十分困难，到了末日。也形容穷困到极点。","source":{"text":"几年春草歇，今日暮途穷。","book":"《史记·伍子胥列传》：“吾日暮途远，吾故倒行而逆施之。”唐·杜甫《投赠哥舒开府翰二十韵》"},"example":{"text":"匪徒们真是～，矛盾百出。","book":"曲波《林海雪原》二十九"},"similar":["穷途末日","山穷水尽","穷途末路"],"opposite":["前程万里"],"usage":"作谓语、宾语、定语；指陷于绝境","story":["春秋时期，楚平王听信大臣费无忌的谗言，杀害大臣伍奢及他的儿子伍尚。伍奢的二儿子伍子胥历尽千辛万苦把太子建的儿子带到吴国，辅佐吴王阖闾。后来伍子胥率军讨伐楚国，将楚平王鞭尸，申包胥反对，伍子胥说他日暮途穷要倒行逆施"]},{"id":24276,"word":"日暮途远","pinyin":"rì mù tú yuǎn","abbr":"rmty","explanation":"暮：傍晚；途：路。天已晚了，路已走到了尽头。比喻处境十分困难，到了末日。也形容穷困到极点。","source":{"text":"吾日暮途远，吾故倒行而逆施之。","book":"西汉·司马迁《史记·伍子胥列传》"},"example":{"text":"他们已是～，挣扎不了几天。"},"similar":["日暮道远"],"usage":"作谓语、宾语、定语；指无可奈何"},{"id":24277,"word":"日暮道远","pinyin":"rì mù dào yuǎn","abbr":"rmdy","explanation":"比喻处境十分困难，到了末日。也形容穷困到极点。同“日暮途远”。","source":{"text":"日暮道远，必数上下；宁劳于人，慎用无劳马。","book":"《吴子·治兵》"},"example":{"text":"明·冯梦龙《喻世明言》第13卷：“～，二公将何之？”"},"similar":["日暮路远"],"usage":"作谓语、状语；用于人的处境"},{"id":24278,"word":"日月不可逾","pinyin":"rì yuè bù kě yú","abbr":"rybky","explanation":"逾：超越。太阳月亮都不能超过。形容高不可及。","source":{"text":"万乘至重，天王至尊，身为圣躬，国为神器，陛级县远，禄位限绝。犹天之不可阶，日月之不可逾也。","book":"《后汉书·孔融传》"}},{"id":24279,"word":"日月不居","pinyin":"rì yuè bù jū","abbr":"rybj","explanation":"形容时光流逝。","source":{"text":"日月不居，倏经三纪，追惟曩昔，不可复希。","book":"《北史·隋纪下·炀帝》"},"similar":["日月如梭"],"usage":"作宾语、定语；用于时间流逝"},{"id":24280,"word":"日月丽天","pinyin":"rì yuè lì tiān","abbr":"rylt","explanation":"丽：附着。象日月悬挂在天空。比喻永恒不变。","source":{"text":"日月丽乎天，百谷草木丽乎土。","book":"《周易·离》"},"example":{"text":"易云～，传称星辰合度，丽加妃号，自我为初。","book":"唐·张说《和丽妃神道碑》"},"usage":"作谓语；比喻永恒不变"},{"id":24281,"word":"日月交食","pinyin":"rì yuè jiāo shí","abbr":"ryjs","explanation":"指日蚀和月蚀；比喻彼此争斗，做了冤家对头。","source":{"text":"爷！怪事，怪事！只见日月交食，不曾见辘轴退皮。","book":"元·武汉臣《生金阁》第二折"},"example":{"text":"俺两个半生来岂有些嫌隙，到今日却做了～。","book":"元·康进之《李逵负荆》第二折"},"similar":["日月参辰"],"usage":"作谓语；比喻彼此争斗"},{"id":24282,"word":"日月入怀","pinyin":"rì yuè rù huái","abbr":"ryrh","explanation":"旧称生贵子的吉兆。形容心胸开阔。也比喻光彩夺目。","source":{"text":"时人目夏侯太初（玄）朗朗如日月之入怀。","book":"南朝宋·刘义庆《世说新语·容止》"},"usage":"作谓语、定语；指生贵子的吉兆","story":["东汉末年，吴地将军孙坚的夫人吴氏做梦梦见月亮进入她的怀中，不久后怀孕生下孙策。后来她又做梦梦见太阳钻入她的怀中，怀孕后就告诉孙坚说：“以前我怀孙策时梦见月亮入怀，今梦到太阳入怀会怎样？”孙坚说这是帝王出世的预兆"]},{"id":24283,"word":"日月其除","pinyin":"rì yuè qí chú","abbr":"ryqc","explanation":"日月流逝。指光阴不待人。","source":{"text":"日月，指时光；除，去也。","book":"《诗·唐风·蟋蟀》：“蟋蟀在堂，岁聿其莫。今我不乐，日月其除。”孔颖达疏：“日月其将过去。”高亨注"},"example":{"text":"岁云秋矣，～。寿非金石，命也何如。","book":"唐·杨炯《唐昭武校曹君神道碑》"},"similar":["时不我待"],"usage":"作定语、状语；用于书面语"},{"id":24284,"word":"日月参辰","pinyin":"rì yuè shēn chén","abbr":"rysc","explanation":"比喻不合，作对。","source":{"text":"也不是我特故的把哥哥来恨，他他他不思忖一爷娘骨肉，却和我做日月参辰。","book":"元·萧得祥《杀狗劝夫》第一折"},"similar":["日月交食"],"usage":"作宾语；比喻双方隔绝不得相见或作对成冤家"},{"id":24285,"word":"日月合壁","pinyin":"rì yuè hé bì","abbr":"ryhb","explanation":"日月同时上升，出现于阴历的朔日。古人以为是国家的瑞兆。","source":{"text":"日月如合壁，五星如连珠。","book":"《汉书·律历志上》"},"example":{"text":"建物旗者，其制有黄龙负图，君王万岁，天文彩绣，～，五星连珠，重轮庆云……（宋·吴自牧《梦梁录·驾诣景灵宫仪杖》）"}},{"id":24286,"word":"日月合璧","pinyin":"rì yuè hé bì","abbr":"ryhb","explanation":"指地球进入太阳与月球之间或月球进入地球与太阳之间所发生的现象。“日月合璧”在朔发生日食，在望发生月食。","source":{"text":"宦者淳于陵渠复覆《太初历》晦朔弦望，皆最密，日月合璧，五星如连珠。","book":"《汉书·律历志上》"},"example":{"text":"乾隆二十五年八月，钦天监奏称：明年元日午时，～，五星连珠。清·钱泳《履园从话·祥异·日月合璧五星连珠》"},"usage":"作宾语、定语；指国家的瑞兆"},{"id":24287,"word":"日月如梭","pinyin":"rì yuè rú suō","abbr":"ryrs","explanation":"梭：织布时牵引纬线的工具。太阳和月亮象穿梭一样地来去。形容时间过得很快。","source":{"text":"织乌，日也，往来如梭之织。","book":"宋·赵德麟《侯鲭录》卷二"},"example":{"text":"我想这光阴似水，～。","book":"元·郑廷玉《忍字记》第四折"},"similar":["光阴似箭"],"opposite":["度日如年"],"usage":"作谓语、宾语；形容时间过得飞快"},{"id":24288,"word":"日月如流","pinyin":"rì yuè rú liú","abbr":"ryrl","explanation":"时光像流水一样迅速消逝。","source":{"text":"日月如流不可招，富贵荣华不能保。","book":"明·无名氏《三化邯郸》第二折"},"example":{"text":"[公子]今留齐七载，偷安惰志，～，吾等十日不能一见，安能成其大事哉？","book":"《东周列国志》第三四回"},"similar":["日月如箭"],"usage":"作谓语、宾语；形容时间过得飞快"},{"id":24289,"word":"日月如箭","pinyin":"rì yuè rú jiàn","abbr":"ryrj","explanation":"比喻光阴很快地飞逝。","source":{"text":"俗云日月如箭……转瞬便隔了年头。","book":"清·李绿园《歧路灯》第18回"},"similar":["日月如梭","日月如流"],"usage":"作谓语、宾语；形容时间过得飞快"},{"id":24290,"word":"日月无光","pinyin":"rì yuè wú guāng","abbr":"rywg","explanation":"连太阳和月亮都失去了光彩。比喻极其黑暗。","source":{"text":"所谓白日陆沉，日月无光，人鬼不能见也。","book":"晋·葛洪《抱朴子·内篇·登涉》"},"example":{"text":"其日坏了太子，感得天昏地暗，～，天雷大震，惨雾漫漫。","book":"《武王伐纣平话》中卷"},"similar":["天昏地暗"],"opposite":["阳光灿烂"],"usage":"作宾语、定语、状语；多用于比喻句"},{"id":24291,"word":"日月无私","pinyin":"rì yuè wú sī","abbr":"ryws","explanation":"太阳和月亮无私地普照大地。比喻普遍施与恩惠。","source":{"text":"天无私覆，地无私载，日月无私照。","book":"《礼记·孔子闲居》"},"example":{"text":"～，普人间，添甲子。","book":"《清史稿·乐志五》"}},{"id":24292,"word":"日月无私照","pinyin":"rì yuè wú sī zhào","abbr":"rywsz","explanation":"太阳和月亮无私地普照大地。比喻普遍施与恩惠。","source":{"text":"天无私覆，地无私载，日月无私照。","book":"《礼记·孔子闲居》"}},{"id":24293,"word":"日月经天","pinyin":"rì yuè jīng tiān","abbr":"ryjt","explanation":"日月每天都经过天空。比喻光明正大，历久不衰。","source":{"text":"其事昭昭，日月经天，河海带地，不足以比。","book":"南朝·宋·范晔《后汉书·冯衍传上》"},"example":{"text":"《魏书·萧衍传》：“言之旦旦，～，举世所知，义非徒语。”"},"similar":["江河行地","一成不变"],"opposite":["变化多端"],"usage":"作宾语、定语；常与“江河行地”连用"},{"id":24294,"word":"日月经天，江河行地","pinyin":"rì yuè jīng tiān，jiāng hé xíng dì","abbr":"ryjtjhxd","explanation":"太阳和月亮每天经过天空，江河永远流经大地。比喻人或事物的永恒、伟大。","source":{"text":"其事昭昭，日月经天，江海带地，不足以比。","book":"《后汉书·桓谭冯衍传》"},"example":{"text":"譬之六经，犹苍蝇声耳，岂得为～哉。","book":"清·郑燮《焦山别峰庵雨中无事书寄舍弟墨》"},"similar":["日月经天，河海带地"],"usage":"作宾语、分句；可分开使用"},{"id":24295,"word":"日月经天，河海带地","pinyin":"rì yuè jīng tiān，hé hǎi dài dì","abbr":"ryjthhdd","explanation":"经：经过。太阳和月亮每天经过天空，江河永远流经大地。比喻人或事物的永恒、伟大。","source":{"text":"其事昭昭，日月经天，河海带地，不足以比。","book":"《后汉书·桓谭冯衍传》"},"similar":["日月经天，江河行地"],"usage":"作宾语、分句；用于书面语"},{"id":24296,"word":"日月跳丸","pinyin":"rì yuè tiào wán","abbr":"rytw","explanation":"跳丸：跳动的弹丸。形容时间过得极快。","source":{"text":"忧愁费晷景，日月如跳丸。","book":"唐·韩愈《秋怀》诗"},"similar":["日月如梭"],"usage":"作宾语、定语；用于时间飞逝"},{"id":24297,"word":"日月蹉跎","pinyin":"rì yuè cuō tuó","abbr":"ryct","explanation":"蹉跎：时光白白过去。把时光白白地耽误过去。指虚度光阴。","source":{"text":"娱乐未终极，白日忽蹉跎。","book":"晋·阮籍《咏怀》诗"},"example":{"text":"徒使度外之士，摈弃而不得骋，～而老将至矣。","book":"宋·陈亮《上孝宗皇帝第一书》"},"similar":["蹉跎岁月"],"opposite":["分秒必争"],"usage":"作谓语、分句；指虚度光阴"},{"id":24298,"word":"日月逾迈","pinyin":"rì yuè yú mài","abbr":"ryym","explanation":"日月前行。指时光流逝。","source":{"text":"言日月益为疾行，并皆过去。","book":"《书·秦誓》：“我心之忧，日月逾迈，若弗云来。”孔颖达疏"},"example":{"text":"～，荣落相推。","book":"唐·张说《唐玉泉寺大通禅师铭序》"},"similar":["日征月迈"],"usage":"作宾语、定语；用于时间飞逝"},{"id":24299,"word":"日月重光","pinyin":"rì yuè chóng guāng","abbr":"rycg","explanation":"重光：重放光芒。太阳月亮重放光芒。比喻经过一番动乱后出现新的清明局面。","source":{"text":"日月为重光。","book":"三国·魏·缪袭《魏鼓吹曲》"},"example":{"text":"皇家造宋，～，璇玑得序，五星顺命。","book":"《宋书·孝武帝纪》"},"similar":["重见天日"],"usage":"作谓语；指新的清明局面"},{"id":24300,"word":"日有万机","pinyin":"rì yǒu wàn jī","abbr":"rywj","explanation":"形容政务繁忙，工作辛苦。同“日理万机”。","source":{"text":"每患迁固以来，文字繁多，自布衣之士，读之不遍；况于人主，日有万机，何暇周览？","book":"宋·司马光《进〈资治通鉴〉表》"},"similar":["日理万机"],"opposite":["无所事事"],"usage":"作谓语、定语、宾语；指政务繁忙"},{"id":24301,"word":"日有长短，月有死生","pinyin":"rì yǒu cháng duǎn，yuè yǒu sǐ shēng","abbr":"rycdyyss","explanation":"死生：指月亮有缺有圆。同样的一天有时长有时短，同一个月亮有时缺有时圆。指随自然界的不断变化，情况也有所变化。","source":{"text":"四时无常位，日有长短，月有死生。","book":"《孙子·虚实篇》"}},{"id":24302,"word":"日朘月减","pinyin":"rì juān yuè jiǎn","abbr":"rjyj","explanation":"朘：缩小，减少。形容逐渐缩小。也指时时受到搜刮。形容逐渐缩小。也指时时受到搜刮。同“日削月朘”。","source":{"text":"又顷岁以来，自转运使知州以下，白直及迎送之人，日朘月减，出入导从，大为萧条。","book":"宋·司马光《气罢将官状》"},"similar":["日朘月削"],"opposite":["日积月累"],"usage":"作谓语、定语；形容逐渐缩小"},{"id":24303,"word":"日朘月削","pinyin":"rì juān yuè xuē","abbr":"rjyx","explanation":"朘：缩小，减少。形容逐渐缩小。也指时时受到搜刮。同“日削月朘”。","source":{"text":"私谒开而正言塞，日朘月削，卒见凋弊。","book":"《新唐书·萧至忠传》"},"example":{"text":"～，而不复能国其国也。","book":"梁启超《俄土战纪叙》"},"similar":["日削月朘","日朘月减"],"usage":"作谓语、定语；形容逐渐缩小"},{"id":24304,"word":"日杒月减","pinyin":"rì juān yuè jiǎn","abbr":"rjyj","explanation":"?昂缩小，减少。形容逐渐缩小。也指时时受到搜刮。形容逐渐缩小。也指时时受到搜刮。同日削月杒”。"},{"id":24305,"word":"日杒月削","pinyin":"rì juān yuè xuē","abbr":"rjyx","explanation":"杒缩小，减少。形容逐渐缩小。也指时时受到搜刮。同日削月杒”。"},{"id":24306,"word":"日来月往","pinyin":"rì lái yuè wǎng","abbr":"rlyw","explanation":"形容岁月流逝。同“日往月来”。","source":{"text":"日来月往相催迁，迢迢星岁欲周天。","book":"唐·刘商《胡笳十八拍》之十二"},"example":{"text":"不去营运，～，手内使得没了。","book":"《警世通言·小夫人金钱赠年少》"},"similar":["寒来暑去","冬来秋去"],"usage":"作宾语、状语；用于岁月流逝"},{"id":24307,"word":"日清月结","pinyin":"rì qīng yuè jié","abbr":"rqyj","explanation":"每天每月都结算清楚了。形容财务人员的工作认真，帐目清楚。","example":{"text":"关税账目献项收支虽然烦琐，都有章程规矩管着，～明白。","book":"二月河《乾隆皇帝》第九章"}},{"id":24308,"word":"日渐月染","pinyin":"rì jiàn yuè rǎn","abbr":"rjyr","explanation":"濡：浸润。染：熏染。天长日久地渐渐熏染。指受外界事物的影响而发生逐渐的变化。同“日濡月染”。","source":{"text":"招之得其地矣，又当各分其屯，无杂官军，盖一与之染，则日渐月染，尽成弃甲之人，不幸有警，则彼此相持，莫肯先进；一有微功，则彼此交集，反戈自戕，岂暇向敌哉。","book":"宋·程珌《丙子轮对札子》"},"usage":"作宾语、状语；用于逐渐改变"},{"id":24309,"word":"日湮月塞","pinyin":"rì yān yuè sè","abbr":"ryys","explanation":"湮：堵塞；塞：堵。每天每月都堵塞。","source":{"text":"举国尚俭，则举国之地利日湮月塞，驯至穷蹙不可终日。","book":"梁启超《今义》"}},{"id":24310,"word":"日滋月益","pinyin":"rì zī yuè yì","abbr":"rzyy","explanation":"一天天一月月地增添、加多。同“日益月滋”。","source":{"text":"凡此六者，其初甚微，朝夕狎玩，未睹其害，日滋月益，遂至深固，比知而革之，则用力百倍矣。","book":"宋·司马光《重微》"},"example":{"text":"故圣人之教循循有序……使之得寸则守其寸，得尺则守其尺，如是久之，～，然后道之全体，乃有所向望而渐可识，有所循习而渐可能。","book":"宋·朱熹《答林退思书》"},"similar":["日益月滋"],"usage":"作谓语、定语；用于数量增加"},{"id":24311,"word":"日濡月染","pinyin":"rì rú yuè rǎn","abbr":"rryr","explanation":"濡：浸润。染：熏染。天长日久地渐渐熏染。指受外界事物的影响而发生逐渐的变化。亦作“日渐月染”。","source":{"text":"其他赵冯邓唐诸氏皆汉人，因避徭赋诛求，举家窜入，日濡月染，凡饮食衣服器用，皆与真瑶无异。","book":"清·魏祝亭《两粤瑶俗记》"},"similar":["耳濡目染","日渐月染"],"usage":"作谓语、定语、分句；指逐渐地改变"},{"id":24312,"word":"日炙风吹","pinyin":"rì zhì fēng chuī","abbr":"rzfc","explanation":"日晒风吹。形容长途跋涉之苦。","source":{"text":"万里驱驰，二年经纪，非容易，受了些日炙风吹，今日个才盼得还乡地。","book":"明·无名氏《锁白猿》第一折"},"example":{"text":"受了些眠霜卧雪，～。","book":"明·无名氏《聚兽牌》第一折"},"similar":["日炙风筛"],"usage":"作宾语、定语；用于口语"},{"id":24313,"word":"日炙风筛","pinyin":"rì zhì fēng shāi","abbr":"rzfs","explanation":"日晒风吹。形容长途跋涉之苦。","source":{"text":"哎哟儿也，知他那里日炙风筛，博功名苦尽甘来。","book":"元·张国宾《薛仁贵》第二折"},"example":{"text":"看了这山遥路远，更和那～，一骑马直临苏武坡，半天云遮尽李陵台。","book":"元·陈以仁《存孝打虎》第一折"},"similar":["日炙风吹"],"usage":"作宾语、定语；用于口语"},{"id":24314,"word":"日理万机","pinyin":"rì lǐ wàn jī","abbr":"rlwj","explanation":"理：处理，办理；万机：种种事务。形容政务繁忙，工作辛苦。","source":{"text":"相国、丞相，皆秦官，金印紫绶，掌丞天子助理万机。","book":"《尚书·皋陶谟》：“兢兢业业，一日二日万机。”《汉书·百官公卿表上》"},"example":{"text":"建国以后，我们敬爱的周总理～，夜以继日，成年很少有休息的机会。","book":"余敏《深情忆念周伯伯》"},"similar":["全力以赴","宵衣旰食"],"opposite":["无所事事"],"usage":"作谓语、定语、宾语；指政务繁忙"},{"id":24315,"word":"日甚一日","pinyin":"rì shèn yī rì","abbr":"rsyr","explanation":"甚：加深，胜似。一天比一天厉害。形容事物发展的程度越来越加深或日渐严重。","source":{"text":"徒以今年以来，病疾浸加，不任劳剧，比尝粗陈恳款，未蒙陛下矜从，故复黾勉至今，而所苦日甚一日。","book":"宋·王安石《乞解机务札子》"},"example":{"text":"遂借公举以媒重贿，～，至于子孙微弱，则所列木主，庋置高阁间，供斋役爨矣。（明·沈德符《万历野获编·乡贤》）"},"similar":["每况愈下"],"opposite":["蒸蒸日上"],"usage":"作谓语、状语；指情况严重"},{"id":24316,"word":"日益月滋","pinyin":"rì yì yuè zī","abbr":"ryyz","explanation":"一天天一月月地增添、加多。","source":{"text":"稹自御史府谪官，于今十馀年矣，闲诞无事，遂专力于诗章。日益月滋，有诗向千余首。","book":"唐·元稹《上令狐相公诗启》"},"similar":["日滋月益","日增月益"],"opposite":["日朘月削"],"usage":"作谓语、定语；用于数量增加"},{"id":24317,"word":"日省月修","pinyin":"rì xǐng yuè xiū","abbr":"rxyx","explanation":"天天反省，月月修身。","source":{"text":"使本官读书进学，日省月修，待其老成，然后授以任事之职。","book":"清·严有禧《漱华随笔·知县改授》"},"usage":"作谓语、宾语；用于学习等"},{"id":24318,"word":"日省月试","pinyin":"rì xǐng yuè shì","abbr":"rxys","explanation":"省：检查；试：考核。每天检查，每月考核。形容经常查考。","source":{"text":"日省月试，既禀称事，所以劝百工也。","book":"《礼记·中庸》"},"similar":["日省月课"],"usage":"作谓语、宾语；形容经常查考"},{"id":24319,"word":"日省月课","pinyin":"rì xǐng yuè kè","abbr":"rxyk","explanation":"形容经常查考。同“日省月试”。","source":{"text":"陛下幼蒙鞠诲，圣敬之跻，及储宫诞育，复亲抚诰，日省月课，实劳神虑。","book":"《魏书·李彪传》"},"similar":["日省月试"],"usage":"作谓语、宾语；形容经常查考"},{"id":24320,"word":"日短夜修","pinyin":"rì duǎn yè xiū","abbr":"rdyx","explanation":"指冬至前后几个月白天短夜晚长。","source":{"text":"望孟夏之短夜兮，何晦明之若岁？","book":"战国·楚·屈原《九章·抽思》"}},{"id":24321,"word":"日短心长","pinyin":"rì duǎn xīn cháng","abbr":"rdxc","explanation":"时间少，心里想要做的事情多。指心愿一时难以实现。","source":{"text":"惟是旦中生平之志，不安于九品之下中，故铭言日短心长，身名就剥，所以哀之者至矣。","book":"清·黄宗羲《与李杲堂陈介眉书》"},"example":{"text":"王梦楼云：‘……未吸神髓，故易于决舍；如果深造有得，必愁～，孜孜不及，焉有馀功，旁求考据乎？’","book":"清·袁枚《随园诗话》卷六"},"usage":"作宾语、定语；用于人的愿望"},{"id":24322,"word":"日积月累","pinyin":"rì jī yuè lěi","abbr":"rjyl","explanation":"一天一天地、一月一月地不断积累。指长时间不断地积累。","source":{"text":"日积月累，有了一大包银子。","book":"明·冯梦龙《醒世恒言》卷三"},"example":{"text":"自是以后，～，千百成群，其为国之蠹害甚矣。","book":"清·顾炎武《日知录》卷九"},"similar":["积少成多","成年累月"],"opposite":["一曝十寒","挥霍无度"],"usage":"作谓语、定语、状语；指长时间不断地积累"},{"id":24323,"word":"日积月聚","pinyin":"rì jī yuè jù","abbr":"rjyj","explanation":"指长时间不断地积累。同“日积月累”。","source":{"text":"使州县无妄用，归其馀于监司；监司无妄用，归其馀于朝廷；朝廷无横费，日积月聚，惟军须是虑，中兴之业可致也。","book":"《宋史·张致远传》"},"similar":["日积月累"],"usage":"作谓语、定语、状语；指长时间不断地积累"},{"id":24324,"word":"日程月课","pinyin":"rì chéng yuè kè","abbr":"rcyk","explanation":"每日每月按一定的程序课试。形容因循守旧，无所创新。","source":{"text":"[子尹]不肯以诗人自居。当其兴到，顷刻千言；无所感触，或经时不作一字，又脱稿不自收拾，子弟钞存十之三四而已。而其盘盘之气，熊熊之光，浏漓顿挫，不主故常，以视近世日程月课，楦酿篇牍，自张风雅者，其贵贱何如也？","book":"清·莫友芝《〈巢经堂诗钞〉序》"},"usage":"作宾语、定语；用于处事等"},{"id":24325,"word":"日累月积","pinyin":"rì lèi yuè jī","abbr":"rlyj","explanation":"指长时间不断地积累。同“日积月累”。","source":{"text":"先帝于大臣好为形迹，小过皆含容不言，日累月积，以致祸败。","book":"《资治通鉴·唐文宗开成五年》"},"similar":["日积月累"],"usage":"作谓语、定语、状语；指长时间不断地积累"},{"id":24326,"word":"日臻完善","pinyin":"rì zhēn wán shàn","abbr":"rzws","explanation":"臻：达到。一天天逐步达到完美的境地。"},{"id":24327,"word":"日莫途远","pinyin":"rì mò tú yuǎn","abbr":"rmty","explanation":"比喻处境十分困难，到了末日。也形容穷困到极点。同“日暮途远”。"},{"id":24328,"word":"日落千丈","pinyin":"rì luò qiān zhàng","abbr":"rlqz","explanation":"形容景况急剧下降。同“一落千丈”。","source":{"text":"人事变迁，真是谁也不能前料。回想起来仅仅是两年间的岁月，而我这两年间的生涯真正是日落千丈了。","book":"郭沫若《塔·喀尔萝姑娘》"},"similar":["一落千丈"],"usage":"作谓语、定语；指声誉、地位或经济状况等"},{"id":24329,"word":"日落西山","pinyin":"rì luò xī shān","abbr":"rlxs","explanation":"太阳快要落山。比喻人到老年将死或事物接近衰亡。","source":{"text":"‘栖鸟夜飞’，沈攸之元微五年所作也。攸之未败前，思归京师，故歌和云：‘日落西山还去来。’","book":"《上唐书·音乐志》"},"example":{"text":"财主们已经是～，红不过一会儿了。","book":"丁玲《太阳照在桑干河上》"},"similar":["人命危浅","日暮途穷"],"opposite":["如日方升","日升月恒"],"usage":"作谓语、宾语、补语；指临近死亡"},{"id":24330,"word":"日薄崦嵫","pinyin":"rì bó yān zī","abbr":"rbyz","explanation":"日：指太阳；薄：迫近；崦嵫：山名，在今甘肃省天山县西，古指太阳落下的地方。太阳迫近崦嵫山。比喻人已到暮年或事物已到尽头。","source":{"text":"日薄崦嗞，茫茫落落，吊古之士，登斯台者，辄低回睠顾。","book":"战国·楚·屈原《离骚》：“吾令羲和弭节兮，望崦嵫而勿迫。”明·蒋一葵《长安客话·黄金台》"},"example":{"text":"消停一会，～。尹痴鸳约齐在席众人，特地过访张秀英，惟齐府几个亲戚辞谢不去。","book":"清·韩邦庆《海上花列传》第四十回"}},{"id":24331,"word":"日薄桑榆","pinyin":"rì báo sāng yú","abbr":"rbsy","explanation":"犹日薄西山。比喻老年的时光。","source":{"text":"臣日薄桑榆，位高轩冕，经邦论道，自顾缺然。","book":"《隋书·李穆传》"},"similar":["日薄西山"],"usage":"作谓语、定语；多用于老年人"},{"id":24332,"word":"日薄虞渊","pinyin":"rì báo yú yuān","abbr":"rbyy","explanation":"犹日薄西山。比喻人已经衰老或事物衰败腐朽，临近死亡。虞渊，神话传说中日入之处。","source":{"text":"《太平御览》作‘薄于虞渊’。","book":"《淮南子·天文训》：“扞日呴至于虞渊，是谓黄昏。”庄逵吉校"},"example":{"text":"谢震《发刊词》：“大率昙花一现，即归乌有，其存焉者，亦大有～之景象。”"},"usage":"作谓语、定语；用于书面语"},{"id":24333,"word":"日薄西山","pinyin":"rì bó xī shān","abbr":"rbxs","explanation":"薄：迫近。太阳快落山了。比喻人已经衰老或事物衰败腐朽，临近死亡。","source":{"text":"但以刘日薄西山，气息奄奄，人命危浅，朝不虑夕。","book":"晋·李密《陈情表》"},"example":{"text":"君须听取：怕～，易生愁阻。","book":"明·瞿佑《剪灯新话·爱卿传》"},"similar":["日薄崦嵫","气息奄奄"],"opposite":["朝气蓬勃","蒸蒸日上"],"usage":"作谓语、宾语、补语；指临近死亡"},{"id":24334,"word":"日行千里","pinyin":"rì xíng qiān lǐ","abbr":"rxql","explanation":"一天能走一千里。形容速度惊人。","source":{"text":"吐谷浑尝得波斯草马，放入海，因生骢驹，能日行千里，世传青海骢者是也。","book":"《魏书·吐谷浑传》"},"example":{"text":"云锦队中曾赛，每闻伯乐声嘶，登山度岭去如飞，真个～。","book":"《平妖传》第28回"},"similar":["一日千里","急若流星"],"opposite":["慢条斯理","蜗行牛步"],"usage":"作谓语、定语；指速度快"},{"id":24335,"word":"日角偃月","pinyin":"rì jiǎo yǎn yuè","abbr":"rjyy","explanation":"旧时相术家称极贵之相。偃月，指额角似半弦月。","source":{"text":"[梁后]选入掖庭，相工茅通见之，惊曰：‘此所谓日角偃月，相之极贵，臣未尝见之。’于是以为贵人。","book":"晋·袁宏《后汉纪·顺帝纪上》"},"similar":["日角珠庭"],"usage":"作宾语、定语；用于人的长相"},{"id":24336,"word":"日角珠庭","pinyin":"rì jiǎo zhū tíng","abbr":"rjzt","explanation":"形容人额角宽阔，天庭饱满，相貌不凡。","source":{"text":"是以维岳降神，自天生德，凝脂点漆，日角珠庭，为子则名高五都，为臣则光照千里。","book":"北周·庚信《周大将军赵公墓志铭》"},"example":{"text":"甫冠，举明经，李绛为华州刺史，见之曰：‘～，非庸人相，明经碌碌，非子所宜。’乃更举进士高第。","book":"《新唐书·李珏传》"},"similar":["日角偃月"],"usage":"作宾语、定语；用于人的长相"},{"id":24337,"word":"日角龙庭","pinyin":"rì jiǎo lóng tíng","abbr":"rjlt","explanation":"旧时相术家指天庭隆起为龙庭。称之为帝王的贵相。","source":{"text":"[高祖]密访时事，俭曰：‘明公日角龙庭，李氏又在图牒，天下属望，非在今朝。’","book":"《旧唐书·唐俭传》"},"similar":["日角龙颜"],"usage":"作谓语、宾语、定语；多用于算命"},{"id":24338,"word":"日角龙颜","pinyin":"rì jiǎo lóng yán","abbr":"rjly","explanation":"旧时相术家指额头隆起为龙颜。称之为为帝王的贵相。日角，额角中央部分隆起，形状如日。","source":{"text":"陛下日角龙颜之姿，表于徇齐之日；彤云素气之瑞，基于应物之初。","book":"《梁书·元帝纪》"},"example":{"text":"身长七尺五寸，～，垂手过膝。","book":"《陈书·高祖纪上》"},"similar":["日角龙庭"],"usage":"作谓语、宾语、定语；多用于算命"},{"id":24339,"word":"日计不足，岁计有余","pinyin":"rì jì bù zú，suì jì yǒu yú","abbr":"rjbzsjyy","explanation":"每天算下来没有多少，一年算下来就很多了。比喻积少成多。也比喻凡事只要持之以恒，就能有很大收获。","source":{"text":"其道可以大美兴，而难以算计举也。是故日计之不足，而岁计之有余。","book":"《庄子·庚桑楚》：“今吾日计之而不足，岁计之而有余，庶几其圣人乎？”《淮南子·俶真训》"},"example":{"text":"陈晋之一日只读一百二十字，后遂无书不读，所谓～者。","book":"宋·陈善《扪虱新话》上集卷四"},"usage":"作宾语、分句；指平日积累"},{"id":24340,"word":"日许多时","pinyin":"rì xǔ duō shí","abbr":"rxds","explanation":"估量时间的词。指已有许多时光。","source":{"text":"花前月下，好景良辰，厮守日许多时。","book":"宋·石孝友《声声慢》词"},"example":{"text":"忆自伊家赴上都，～，夜夜魂劳梦役。","book":"金·董解元《西厢记诸宫调》卷八"},"similar":["日许时间"],"usage":"作宾语、状语；用于时间"},{"id":24341,"word":"日许时间","pinyin":"rì xǔ shí jiān","abbr":"rxsj","explanation":"估量时间的词。指已有许多时光。同“日许多时”。","source":{"text":"一船最后知何故，日许时间独不来。","book":"宋·杨万里《过吕城闸》诗"},"similar":["日许多时"],"usage":"作宾语、状语；用于时间"},{"id":24342,"word":"日试万言","pinyin":"rì shì wàn yán","abbr":"rswy","explanation":"一日写上万字的文章。形容富有才华，思路敏捷。","source":{"text":"必若接之以高宴，纵之以清谈，请日试万言，倚马可待。","book":"唐·李白《与韩荆州书》"},"example":{"text":"涉依国学为诸生讲说，稍迁国子博士，亦能为文，尝请有司～，时呼张万言。","book":"《旧唐书·张涉传》"},"similar":["下笔千言"],"usage":"作谓语、定语；指人文思敏捷"},{"id":24343,"word":"日诵五车","pinyin":"rì sòng wǔ chē","abbr":"rswc","explanation":"一天诵读好多书。五车，形容书多。","source":{"text":"抑读书之法要，当循序而有常，致一而不懈，从容乎句读文义之间，而体验乎操存践履之实，然后心静理明，渐见意味。不然，则虽广求博取，日诵五车，亦奚益于学哉？","book":"宋·朱熹《答陈师德书》"},"usage":"作谓语、定语；用于书面语"},{"id":24344,"word":"日转千街","pinyin":"rì zhuǎn qiān jiē","abbr":"rzqj","explanation":"指乞丐沿街行乞。","source":{"text":"哎！婆婆也，咱去来波，可则索与他日转千街。","book":"元·张国宾《合汗衫》第三折"},"usage":"作谓语、定语；多用于乞丐"},{"id":24345,"word":"日转千阶","pinyin":"rì zhuǎn qiān jiē","abbr":"rzqj","explanation":"转：升迁；阶：官阶。一天里升迁多次。比喻官职提升的极快。","source":{"text":"但有日官居八座，位列三台，日转千阶，直头上打下一轮皂盖，那其间谁道我负薪来。","book":"《元曲选·渔樵记》"},"example":{"text":"您都是良将沉埋，尽忠显耀胸怀，因董卓专权变乱，论官爵～。（明·无名氏《单战吕布》第四折）"},"similar":["连升三级","青云直上"],"usage":"作谓语、补语；比喻官职提升得极快"},{"id":24346,"word":"日迈月征","pinyin":"rì mài yuè zhēng","abbr":"rmyz","explanation":"日月不停地运转。比喻时间不断推移。","source":{"text":"迈、征，皆行也。","book":"语出《诗·小雅·小宛》：“我日斯迈，而月斯征。”郑玄笺"},"example":{"text":"但不知能脱然家累否？～，所事未就，兄宜痛割俗缠可也。","book":"清·韩廷锡《山中寄衡之伯兄》"},"usage":"作宾语、状语；用于时间流逝"},{"id":24347,"word":"日近长安远","pinyin":"rì jìn cháng ān yuǎn","abbr":"rjcay","explanation":"长安：西安，古都城名，后为国都的统称。旧指向往帝都而不能达到。","source":{"text":"因问明帝：‘汝意谓长安何如日远？’答曰：‘日远。不闻人从日边来，居然可知。’……更重问之，乃答曰：‘日近。’","book":"南朝·宋·刘义庆《世说新语·夙惠》"},"example":{"text":"眼见的天阔雁书迟，赤紧的～。","book":"元·乔孟符《两世姻缘》第一折"},"usage":"作宾语、分句；指愿望没达到","story":["晋朝时期，晋明帝小时坐在晋元帝膝上，刚好有人从长安来，就问明帝：“长安与太阳哪一个远些？”明帝说：“没听说人从太阳上来。”第二天，元帝召集群臣开宴会，夸耀明帝聪明，当场问谁近，明帝说：“日近，举目见日，不见长安。"]},{"id":24348,"word":"日进不衰","pinyin":"rì jìn bù shuāi","abbr":"rjbs","explanation":"衰：减。一天天有增无减。","source":{"text":"高后自临事，不幸有疾，日进不衰，以故悖暴乎治。","book":"汉·刘桓《赐南奥王赵佗传》"},"usage":"作谓语、宾语；用于书面语"},{"id":24349,"word":"日进斗金","pinyin":"rì jìn dǒu jīn","abbr":"rjdj","explanation":"一天能收进一斗黄金。形容发大财。","source":{"text":"这个职位，一望而知是日进斗金的好差使。","book":"《胡雪岩》"},"example":{"text":"我们希望能有～的好差使。"},"similar":["大发其财","腰缠万贯"],"opposite":["软囊羞涩","入不敷出"],"usage":"作谓语、定语；指发大财"},{"id":24350,"word":"日进有功","pinyin":"rì jìn yǒu gōng","abbr":"rjyg","explanation":"日：天；进：上进；功：成就。天天上进就会成功。指学术、技艺的成就是在持之以恒的勤学苦练中取得的。"},{"id":24351,"word":"日远日疏，日亲日近","pinyin":"rì yuǎn rì shū，rì qīn rì jìn","abbr":"ryrsrqrj","explanation":"疏：疏远；近：亲近。不经常在一起就日益疏远，经常在一起就越来越亲近。","source":{"text":"自此高俅遭际在王都尉府中，出入如同家人一般。自古道：‘日远日疏，日亲日近。’","book":"明·施耐庵《水浒全传》第一回"},"similar":["日亲日近"],"usage":"作宾语、定语、分句；用于交往等"},{"id":24352,"word":"日销月铄","pinyin":"rì xiāo yuè shuò","abbr":"rxys","explanation":"一天天一月月地销熔、减损。","source":{"text":"日销月铄就埋没，六年西顾空吟哦。","book":"唐·韩愈《石鼓歌》"},"example":{"text":"清·王夫之《读通鉴论·陈宣帝》：“无财无以养兵，无人无以守国，坐困而待其吞吸，～，而无如之何，自亡而已矣。”"},"usage":"作定语、状语；用于书面语"},{"id":24353,"word":"日锻月炼","pinyin":"rì duàn yuè liàn","abbr":"rdyl","explanation":"指长期下苦功磨练，以求达到精熟的地步。","source":{"text":"天下事有意为之，辄不能尽妙，而文章尤然。文章之间，诗尤然。世乃有日锻月炼之说，此所以用功者虽多，而名家者终少也。","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵三》"},"example":{"text":"大抵作诗当～，非欲夸奇斗异，要当淘汰出合用字。","book":"宋·魏庆之《诗人玉屑·锻炼·王平甫》"},"usage":"作宾语、定语；用于比喻句等"},{"id":24354,"word":"日长一线","pinyin":"rì cháng yī xiàn","abbr":"rcyx","explanation":"指冬至以后白昼渐长。","source":{"text":"何人却忆穷愁日，日日愁随一线长。","book":"唐·杜甫《至日遣兴奉寄北省旧阁老两院故人》诗"},"usage":"作定语；用于书面语"},{"id":24355,"word":"日长似岁","pinyin":"rì cháng sì suì","abbr":"rcss","explanation":"一天像一年一样长。形容时间过得太慢。","source":{"text":"日长似岁闲方觉，事大如天醉亦休。","book":"宋·陆游《秋思》诗"}},{"id":24356,"word":"日长如小年","pinyin":"rì cháng rú xiǎo nián","abbr":"rzrxn","explanation":"一天长的就像一年。形容白昼时间长。","source":{"text":"山静似太古，日长如小年。","book":"宋·唐庚《醉眠》"}},{"id":24357,"word":"日陵月替","pinyin":"rì líng yuè tì","abbr":"rlyt","explanation":"指逐渐衰落、弛退。","source":{"text":"徵曰：‘观自古帝王，在于忧危之间，则任贤受谏。及至安乐，必怀宽怠，言事者惟令兢惧，日陵月替，以至危亡。’","book":"唐·吴兢《贞观政要·君道》"},"usage":"作谓语、定语；用于政局"},{"id":24358,"word":"日食万钱","pinyin":"rì shí wàn qián","abbr":"rswq","explanation":"每天吃喝花费上万钱财。形容生活极其奢侈。","source":{"text":"食日万钱，犹曰无下箸处。","book":"《晋书·何曾传》"},"example":{"text":"有个王涯丞相，官居一品，权压百僚，僮仆千数，～。","book":"明·冯梦龙《警世通言》卷十七"},"similar":["奢侈浪费"],"opposite":["节衣缩食"],"usage":"作补语、定语；形容饮食极奢侈"},{"id":24359,"word":"日饮亡何","pinyin":"rì yǐn wáng hé","abbr":"rywh","explanation":"每天饮酒，不过问其它的事情。","source":{"text":"语出《汉书·爰盎传》：“南方卑湿，丝能日饮，亡何，说王毋反而已。如此幸得脱”。颜师古注：“无何，言更无馀事”。"},"example":{"text":"宋·辛弃疾《玉蝴蝶·叔高书来戒酒用韵》词：“算从来，人生行乐，休更说、～。”"},"similar":["日饮无何"],"usage":"作谓语、定语；用于书面语"},{"id":24360,"word":"日饮无何","pinyin":"rì yǐn wú hé","abbr":"rywh","explanation":"每天饮酒，不过问其它的事情。同“日饮亡何”。","source":{"text":"酸寒可笑分一斗，日饮无何足袁盎。","book":"宋·苏轼《赵既见和复次韵答之》"},"similar":["日饮亡何"],"usage":"作谓语、定语；用于书面语"},{"id":24361,"word":"日高三丈","pinyin":"rì gāo sān zhàng","abbr":"rgsz","explanation":"犹日上三竿。形容太阳升得很高，时间不早了。也形容人起床太晚。","source":{"text":"日高三丈，还不见六房站班，可恶可恶！","book":"明·汤显祖《南柯记·录摄》"},"example":{"text":"金和尚他们一伙五六十个火柴厂工人到了老板周仲伟住宅附近的时候，已经～。","book":"茅盾《子夜》十六"},"similar":["日上三竿"],"usage":"作谓语、定语；形容太阳升得很高"},{"id":24362,"word":"日高日上","pinyin":"rì gāo rì shàng","abbr":"rgrs","explanation":"一天一天高起来，一天比一天向上长。","source":{"text":"及其茎叶既生，则又日高日上。","book":"清·李渔《闲情偶寄·种植部》"},"similar":["蒸蒸日上"],"opposite":["每况愈下"],"usage":"作谓语、定语；指一天比一天向上长"},{"id":24363,"word":"旦夕之危","pinyin":"dàn xī zhī wěi","abbr":"dxzw","explanation":"旦夕：比喻短时间内。危：危险。形容危险逼近。","source":{"text":"旦夕之危，倒悬之急。","book":"《三国志·蜀志·孟光传》"},"usage":"作宾语；指危险迫在眉睫"},{"id":24364,"word":"旦夕之费","pinyin":"dàn xī zhī fèi","abbr":"dxzf","explanation":"早晚的费用。指一天正常的日用花费。","source":{"text":"汝旦夕之费自给为难，今遣此力，助汝薪水之劳，此亦人子也，可善遇之。","book":"《南史·隐逸·陶潜传》"}},{"id":24365,"word":"旦夕之间","pinyin":"dàn xī zhī jiān","abbr":"dxzj","explanation":"旦：早晨。夕：晚上。早晚之间，形容在很短时间内。","source":{"text":"蒲苇一时纫，便作旦夕间。","book":"汉·无名氏《焦仲卿妻》"},"example":{"text":"清·褚人获《隋唐演义》第98回：“～，与梅同落。随逐花魂，渺焉空际。”"},"similar":["转瞬之间"],"opposite":["天长地久"],"usage":"作宾语；用于时间短"},{"id":24366,"word":"旦日日夕","pinyin":"dàn rì rì xī","abbr":"drrx","explanation":"旦日：明天；日夕：晚上。指明天晚上。","source":{"text":"臣意复诊之曰：‘当旦日日夕死。’","book":"《史记·扁鹊仓公列传》"}},{"id":24367,"word":"旦旦信誓","pinyin":"dàn dàn xìn shì","abbr":"ddxs","explanation":"旦旦：诚恳的样子。指誓言诚恳可信。同“信誓旦旦”。","source":{"text":"求名检事，殊为未孚。将旦旦信誓，有时而爽，駉駉之牧，不能复嗣。","book":"《南齐书·王融传》"},"example":{"text":"她～地向我保证一定要还我的钱。"},"similar":["信誓旦旦"],"usage":"作状语、定语；用于表决心"},{"id":24368,"word":"旦旦而伐","pinyin":"dàn dàn ér fá","abbr":"ddef","explanation":"多比喻天天损害或斫丧。","source":{"text":"亦犹斧斤之于森也，旦旦而伐之，可以为美乎？","book":"《孟子·告子上》"},"usage":"作谓语；指损害"},{"id":24369,"word":"旦暮之业","pinyin":"dàn mù zhī yè","abbr":"dmzy","explanation":"指日常凡庸事务。","source":{"text":"农夫无草莱之事则不比，商贾无市井之事则不比，庶人有旦暮事业则劝，百工有器械之巧则壮。","book":"《庄子·徐无鬼》"}},{"id":24370,"word":"旦暮入地","pinyin":"dàn mù rù dì","abbr":"dmrd","explanation":"旦：早晨；暮：晚；地：地府。早晚就要进入地府。表示年龄已高，随时都可能死去。","source":{"text":"吾受汉家厚恩，无以报，今年老矣，旦暮入地，谊岂以一身事二姓，下见故主哉。","book":"《汉书·龚胜传》"},"example":{"text":"炎武年近七旬，～。","book":"清·顾炎武《与中馆诸君书》"},"similar":["日暮西山"],"usage":"作谓语、定语；指即将死亡"},{"id":24371,"word":"旦种暮成","pinyin":"dàn zhòng mù chéng","abbr":"dzmc","explanation":"比喻收效极快。","source":{"text":"旦树椒豆，暮成藿羹。心之所愿，志快意惬。","book":"汉·焦延寿《易林》卷九"},"similar":["立杆见影"],"usage":"作宾语、定语；指收效极快"},{"id":24372,"word":"旧事重提","pinyin":"jiù shì zhòng tí","abbr":"jszt","explanation":"把已经搁置的事情重新提出。","example":{"text":"过去的恩恩怨怨早已时过境迁，又何必～呢？"}},{"id":24373,"word":"旧仇宿怨","pinyin":"jiù chóu sù yuàn","abbr":"jcsy","explanation":"结了很久的怨仇。","example":{"text":"他们终于化解了祖辈留下的～。"},"similar":["深仇大恨"],"usage":"作宾语、定语；用于书面语"},{"id":24374,"word":"旧地重游","pinyin":"jiù dì chóng yóu","abbr":"jdcy","explanation":"重新来到曾经居住过或游览过的地方。","source":{"text":"广州，在1926年北伐的那一年，我是住过三个多月的，整整隔了十二年又到旧地重游了。","book":"郭沫若《洪波曲》第一章"},"example":{"text":"他此番～，感慨万千。"},"similar":["故地重游"],"usage":"作主语、宾语；指重新来到曾经居住过的地方"},{"id":24375,"word":"旧家行径","pinyin":"jiù jiā xíng jìng","abbr":"jjxj","explanation":"指平素一贯的行为。","source":{"text":"向鸡园托迹，虎口逃生，眉愁翠敛，容羞红润，怕难藏旧家行径。","book":"明·梅鼎祚《玉合记·逃禅》"},"usage":"作主语、宾语；用于书面语"},{"id":24376,"word":"旧念复萌","pinyin":"jiù niàn fù máng","abbr":"jnfm","explanation":"萌：开始，发生。旧时的念头或想法又重新发生。多指重犯旧时的缺点或错误。","source":{"text":"此妇今虽放回，恐其旧念复萌，为害不小。","book":"明·汪廷讷《狮吼记·摄对》"},"similar":["旧病复发"],"usage":"作谓语、宾语；指重犯老毛病"},{"id":24377,"word":"旧态复萌","pinyin":"jiù tài fù méng","abbr":"jtfm","explanation":"旧态：老脾气，老样子；复：又；萌：发生。指旧的习气或毛病等又出现了。","source":{"text":"不欺师父，韩郎遣信到此，不觉故态复萌，情缘难断。","book":"明·梅鼎祚《玉合记·嗣音》"},"example":{"text":"只是齐国远、李如珪两个粗人，～，以膂力方刚，把些人都挨倒，挤将进去，看圆情玩耍。","book":"清·禇人获《隋唐演义》第十七回"},"similar":["故态复萌"],"usage":"作谓语、宾语；指旧的习气或毛病"},{"id":24378,"word":"旧恨新仇","pinyin":"jiù hèn xīn chóu","abbr":"jhxc","explanation":"新仇加旧恨。形容仇恨深。","source":{"text":"旧愁新恨知多少，目断遥天。","book":"南唐·冯延巳《采桑子·二》词"},"example":{"text":"斜月残灯，半明不灭。～，连绵郁结。","book":"元·王实甫《西厢记》第四本第四折"},"similar":["新仇旧恨"],"usage":"作主语、宾语；指仇恨深"},{"id":24379,"word":"旧恨新愁","pinyin":"jiù hèn xīn chóu","abbr":"jhxc","explanation":"新的愁苦和以前未排解的苦闷。","source":{"text":"旧恨新愁无际，近水远山都是，西北有高楼，正好行藏独倚。","book":"宋·向滈《如梦令·道人书郡楼》词"},"example":{"text":"伤心处，提起～，多少泪滴。","book":"明·范受益《寻亲记·诳妻》"},"similar":["旧愁新恨"],"usage":"作宾语；形容不愉快的心情"},{"id":24380,"word":"旧愁新恨","pinyin":"jiù chóu xīn hèn","abbr":"jcxh","explanation":"指久积心头和新近产生的愁怨。","source":{"text":"旧愁新恨知多少，目断遥天，独立花前，更听笙歌满画船。","book":"南唐·冯延巳《采桑子》词"},"example":{"text":"独自临池，闷来强把阑干凭。～，耗却年时兴。","book":"宋·舒氏《点绛唇》词"},"similar":["新愁旧恨"],"opposite":["重归于好"],"usage":"作主语、宾语；形容不愉快的事情"},{"id":24381,"word":"旧时风味","pinyin":"jiù shí fēng wèi","abbr":"jsfw","explanation":"风味：风度，风采。从前的风采。","source":{"text":"春风也到江南路，小槛花深处。对人不是忆姚黄，实是旧时风味、老难忘。","book":"宋·吕本中《虞美人》词"},"example":{"text":"怀金黛，想玉鬟，～尚依然，云笼宝髻凭谁掠，月觑纱窗只自眠。","book":"明·陈汝元《金莲记·外谪》"},"usage":"作主语、宾语、定语；指过去的东西"},{"id":24382,"word":"旧欢新宠","pinyin":"jiù huān xīn chǒn","abbr":"jhxc","explanation":"欢：指所喜爱的人。过去喜欢的和再现受宠的人。","source":{"text":"凭朱槛，把金卮，对芳丛、惆怅多时。何况旧欢新宠阻心期，满眼是相思。","book":"宋·晏殊《凤衔杯》词"}},{"id":24383,"word":"旧燕归巢","pinyin":"jiù yàn guī cháo","abbr":"jygc","explanation":"从前的燕子又飞回老巢了。比喻客居在外的游子喜归故里。","source":{"text":"似旧燕归巢，双语檐前。","book":"明·顾大典《青衫记·裴兴归衡》"},"usage":"作宾语、定语；用于游子等"},{"id":24384,"word":"旧爱宿恩","pinyin":"jiù ài sù ēn","abbr":"jase","explanation":"旧：已往；宿：通“夙”，平常。以往的眷爱和恩情。","source":{"text":"休以旧爱宿恩，任用兴、布，不能拔进良才。","book":"晋·陈寿《三国志·吴志·孙皓传》"},"usage":"作宾语、定语；用于以前的恩爱"},{"id":24385,"word":"旧物青毡","pinyin":"jiù wù qīng zhān","abbr":"jwqz","explanation":"青毡子是家传的故物。比喻珍贵之物。","source":{"text":"偷儿，青毡我家旧物，可特置之。","book":"《晋书·王献之传》"},"example":{"text":"千金敝帚殊高价，～亦庆余。","book":"邓雅声《避地》"},"similar":["青毡旧物"],"usage":"作主语、宾语、定语；比喻珍贵之物","story":["东晋时期，大书法家王献之为人宽宏大量。一天夜晚，他因工作到深夜就睡在书房，恰好那天晚上有几个小偷潜入书房，大肆把书房内值钱的东西都装了起来，当他偷一块旧毡子时，王献之说：“你们把值钱的东西拿走，青毡子留下。”"]},{"id":24386,"word":"旧瓶新酒","pinyin":"jiù píng xīn jiǔ","abbr":"jpxj","explanation":"比喻旧形式，新内容的意思。","source":{"text":"工商改造，旧瓶新酒，愿长芳冽。","book":"茅盾《桂枝香·为商务印书馆八十周年纪念作》"},"example":{"text":"用传统的艺术形式，表现新的内容不正是～吗？"},"similar":["旧瓶装新酒"],"usage":"作宾语、定语；比喻用旧的形式表现新的内容"},{"id":24387,"word":"旧瓶装新酒","pinyin":"jiù píng zhuāng xīn jiǔ","abbr":"jpzxj","explanation":"比喻用旧的形式表现新的内容。","source":{"text":"没有人把新酒装在旧皮袋里；若是这样，皮袋就裂开，酒漏出来，连皮袋也坏了。唯独把新酒装在新皮袋里，两样就都保全了。","book":"《新约·马太福音》第九章。耶稣说"},"example":{"text":"印刷格式都照现行下等小说——所谓～，使人看了不疑。","book":"朱自清《笑的历史·民众文学谈》"},"similar":["旧调重弹","旧瓶新酒"],"usage":"作宾语、定语；比喻用旧的形式表现新的内容"},{"id":24388,"word":"旧病复发","pinyin":"jiù bìng fù fā","abbr":"jbff","explanation":"原来的病又犯了。","source":{"text":"哥哥果然要经历正事，倒也罢了；只是他在家里说着好听，到了外头，旧病复发，难拘束他了。","book":"清·曹雪芹《红楼梦》第48回"},"example":{"text":"他～，一命呜呼。"},"similar":["旧念复萌"],"usage":"作谓语；指老毛病又犯了","story":["薛蟠在酒席上调戏柳湘莲，遭到柳湘莲的一顿毒打后，觉得没有面子在京城呆下去，于是想与手下员工一起外出做生意，请示薛母，母亲没有主意，宝钗认为应该让他去试一试，如果旧病复发也没办法，如果彻底改变同性恋倒也是好事"]},{"id":24389,"word":"旧病难医","pinyin":"jiù bìng nán yī","abbr":"jbny","explanation":"老毛病难于医治。比喻过去的缺点错误难以改正。","source":{"text":"则待作抱官囚，觅不着逃生计，急回头待悔来应迟，又不将心猿意马牢拴系，也不是你本性难移，旧病难医。","book":"明·无名氏《三化邯郸》第三折"},"similar":["旧病复发"],"usage":"作宾语、定语；用于习性难改"},{"id":24390,"word":"旧的不去新的不来","pinyin":"jiù de bù qù xīn de bù lái","abbr":"jdbqxdbl","explanation":"旧的没有了，只好被迫去买新的，坏事变成了好事。","example":{"text":"～，这也是一件好事。"},"similar":["推陈出新"],"usage":"作宾语、分句；用于安慰人"},{"id":24391,"word":"旧荣新辱","pinyin":"jiù róng xīn rǔ","abbr":"jrxr","explanation":"过去的荣耀和现在的耻辱。形容人生无常，变化多端。","source":{"text":"感今怀古，旧荣新辱，都装入酒葫芦。","book":"元·王实甫《丽人堂》第三折"}},{"id":24392,"word":"旧识新交","pinyin":"jiù shí xīn jiāo","abbr":"jsxj","explanation":"老相识，新相交。比喻结交的朋友众多。","source":{"text":"旧识新交遍天下，可如亲戚话依依。","book":"清·黄遵宪《乡人经余远归争来询问》诗"},"usage":"作主语、宾语、定语；用于朋友"},{"id":24393,"word":"旧话重提","pinyin":"jiù huà chóng tí","abbr":"jhct","explanation":"过去说过的，现在又提起了。","source":{"text":"迟威他们不再决定调吴家驹时就抛这个材料，现在都旧话重提，原因何在呢？","book":"柯岩《寻找回来的世界》"},"example":{"text":"我不想～。"},"similar":["老生常谈","旧事重提"],"opposite":["闻所未闻"],"usage":"作谓语、分句；指说话"},{"id":24394,"word":"旧调重弹","pinyin":"jiù diào chóng tán","abbr":"jdct","explanation":"老调子重弹。比喻把老的一套又重新搬出来。","source":{"text":"北平早就被称为‘大学城’和‘文化城’，这原是旧调重弹，不过似乎弹得更响了。","book":"朱自清《回来杂记》"},"example":{"text":"我们希望你不要～了。"},"similar":["因循守旧","老调重弹"],"opposite":["改弦易辙","改弦易张"],"usage":"作谓语、宾语；指缺乏新意"},{"id":24395,"word":"旧雨今雨","pinyin":"jiù yǔ jīn yǔ","abbr":"jyjy","explanation":"原意是，旧时，每逢下雨宾客也来，而现在一遇雨就不来了。后以“旧雨新雨”代指老友新交。","source":{"text":"常时车马之客，旧，雨来；今，雨不来。","book":"唐·杜甫《秋述》"},"example":{"text":"冷暖～，是非一波万波。","book":"宋·范成大《题清息斋六言十首》"},"usage":"作主语、宾语、定语；代指老友新交"},{"id":24396,"word":"旧雨新知","pinyin":"jiù yǔ xīn zhī","abbr":"jyxz","explanation":"旧相识和新朋友。","source":{"text":"新知何脉脉，旧雨何悠悠。","book":"元·刘将孙《养吾斋集·樵川再病》"},"example":{"text":"十年不踏软红尘土，～，履舃交错，宴会几于虚夕。","book":"清·张集馨《道咸宦海见闻录》"}},{"id":24397,"word":"旧雨重逢","pinyin":"jiù yǔ chóng féng","abbr":"jycf","explanation":"旧雨：老朋友的代称。指老朋友又相遇了。","source":{"text":"比想旧雨重逢，促膝谈心，亦大兄闲居之一快也。","book":"清·尹会一《与王罕皆太史》"},"example":{"text":"今年夏天在罗马尼亚纪念卡拉迦列的大会上结交，现在是～了。","book":"陈白尘《五十年集》"},"similar":["久别重逢","不期而遇"],"opposite":["冤家路窄","失之交臂"],"usage":"作宾语、定语；指老朋友又相遇了"},{"id":24398,"word":"旨酒嘉肴","pinyin":"zhǐ jiǔ jiā yáo","abbr":"zjjy","explanation":"旨：味美；嘉：好，美；肴：荤菜。指美酒好菜。","source":{"text":"子有旨酒嘉肴，某既赐矣，又重以乐，敢辞！","book":"西汉·戴圣《礼记·投壶》"},"similar":["美酒佳肴"],"opposite":["粗茶淡饭"],"usage":"作主语、宾语、定语；指美酒好菜"},{"id":24399,"word":"早为之所","pinyin":"zǎo wéi zhī suǒ","abbr":"zwzs","explanation":"为：安排；所：处所。及早为他安排一个场所。","source":{"text":"不如早为之所，无使滋蔓，蔓难图也。","book":"《左传·隐公元年》"},"example":{"text":"贼焰方张，不如～。（《明史·列女传·关陈谏妻吕氏》）"},"usage":"作谓语、定语；用于处事"},{"id":24400,"word":"早作夜息","pinyin":"zǎo zuò yè xī","abbr":"zzyx","explanation":"清早就开始工作，直到夜晚才休息。形容非常勤奋。","example":{"text":"一年以来，公恶衣菲食以戕其身，～以伤其神。（丁中江《北洋军阀史话》一百）"}},{"id":24401,"word":"早出晚归","pinyin":"zǎo chū wǎn guī","abbr":"zcwg","explanation":"早晨出动，晚上归来。","source":{"text":"女朝出而晚来，则吾倚门而望。","book":"《战国策·齐策六》"},"example":{"text":"他按照～捕鱼撒网那股悠闲的心情撑着船，编算着使自己高兴也使别人高兴的事情。","book":"孙犁《芦花荡》"},"similar":["早出暮归"],"usage":"作谓语、定语、状语；指人的作息"},{"id":24402,"word":"早出暮归","pinyin":"zǎo chū mù guī","abbr":"zcmg","explanation":"暮：晚上。早晨出门，晚上归来。","source":{"text":"女朝出而晚来，则吾倚门而望；女暮出而不还，则吾倚闾而望。","book":"《战国策·齐策六》"},"example":{"text":"～，提竹筒铜丝笼，于败堵丛草处，探石发穴，靡计不施，迄无济。","book":"清·蒲松龄《聊斋志异·促织》"},"similar":["早出晚归"],"usage":"作谓语、定语、状语；指人的作息"},{"id":24403,"word":"早占勿药","pinyin":"zǎo zhān wù yào","abbr":"zzwy","explanation":"不用服药而病愈。祝人早日病愈的话。","source":{"text":"无妄之疾，勿药有喜。","book":"《易·无妄》"},"example":{"text":"为了祈求皇帝～，她心甘情愿地拈香磕头，念念有词地祷祝了许久。","book":"高阳《玉座珠帘》下册"}},{"id":24404,"word":"早朝晏罢","pinyin":"zǎo cháo yàn bà","abbr":"zcyb","explanation":"很早上朝，很迟退朝。指勤于政事。","source":{"text":"早朝晏罢，以告制兵者。","book":"《吕氏春秋·禁塞》"},"example":{"text":"陛下～，以冀中兴日月之功。","book":"宋·陈亮《上孝宗皇帝第一书》"},"similar":["蚤朝晏退"],"usage":"作谓语、定语；用于书面语"},{"id":24405,"word":"早知今日，何必当初","pinyin":"zǎo zhī jīn rì，hé bì dāng chū","abbr":"zzjrhbdc","explanation":"既然现在后悔，当初为什么要那样做？","source":{"text":"曰：‘中下之流，如何领会？’师曰：‘伏尸万里。’曰：‘早知今日事，悔不慎当初。’","book":"宋·释普济《五灯会元》卷十六"},"example":{"text":"还有好几个侍卫，留管前后门，准备查抄。～。（蔡东藩《清史演义》第四十三回）"},"similar":["早知今日，悔不当初"],"usage":"作宾语、定语、分句；用于处事"},{"id":24406,"word":"早知今日，悔不当初","pinyin":"zǎo zhī jīn rì，huǐ bù dāng chū","abbr":"zzjrhbdc","explanation":"既然现在后悔，当初为什么要那样做？。","source":{"text":"曰：‘中下之流，如何领会？’师曰：‘伏尸万里。’曰：‘早知今日事，悔不慎当初。’","book":"宋·释普济《五灯会元·天衣怀禅师法嗣·惠林宗本禅师》"},"example":{"text":"性命既失，钱财又无，～。","book":"清·李渔《比目鱼·征利》"},"similar":["早知如此，何必当初"],"usage":"作谓语、分句；指悔恨以前的失误或过错"},{"id":24407,"word":"早韭晚菘","pinyin":"zǎo jiǔ wǎn sōng","abbr":"zjws","explanation":"菘：蔬菜名，品种较多。初春的韭菜和秋末的菘菜。泛指应时的蔬菜。","source":{"text":"文惠太子问颙菜食何味最胜，颙曰：‘春初早韭，秋末晚菘。’","book":"《南史·周颙传》"},"similar":["春韭秋菘"],"usage":"作宾语、定语；指应时的蔬菜"},{"id":24408,"word":"旬月之间","pinyin":"xún yuè zhī jiān","abbr":"xyzj","explanation":"旬：十天。十天到一个月之间","source":{"text":"旬月之间，并各拔擢。","book":"南朝·宋·范晔《后汉书·杨赐传》"},"example":{"text":"晋·陈寿《三国志·凉茂传》：“～，襁负而至者千余家。”"},"usage":"作宾语、状语；用于短时间"},{"id":24409,"word":"旬输月送","pinyin":"xún shū yuè sòng","abbr":"xsys","explanation":"形容赋敛繁苛。","source":{"text":"百姓受命而供之，沥膏血，鬻亲爱，旬输月送无休息。","book":"《旧唐书·杨炎传》"},"usage":"作主语、宾语、定语；指税赋繁重"},{"id":24410,"word":"旭日东升","pinyin":"xù rì dōng shēng","abbr":"xrds","explanation":"旭日：初升的太阳。早上太阳从东方升起。形容朝气蓬勃的气象。也比喻艰苦的岁月已过去，美好的日子刚刚来到。","source":{"text":"旭日始旦。","book":"《诗经·邶风·匏有苦叶》"},"example":{"text":"我描写了她们怎么在黑暗中挣扎和怎样看到了～，破涕为笑。（老舍《最值得歌颂的事》）"},"similar":["生机勃勃","如日方升","蒸蒸日上"],"opposite":["日薄西山","气息奄奄"],"usage":"作宾语、定语；指有生气"},{"id":24411,"word":"旭日初升","pinyin":"xù rì chū shēng","abbr":"xrcs","explanation":"早晨的太阳刚刚从东方升起。比喻充满活力、生气勃勃的景象。","source":{"text":"旭日始旦。","book":"《诗经·邶风·匏有苦叶》"},"example":{"text":"新政如～，群贤并进，内外协力，宏济艰难，遂启中兴之治。","book":"清·薛福成《咸丰季年三奸伏诛》"},"similar":["旭日东升"],"usage":"作宾语、定语；指有生气"},{"id":24412,"word":"旮旮旯旯","pinyin":"gā gā lá lá","abbr":"ggll","explanation":"房屋、庭院、街道的所有角落及曲折隐蔽之处。","example":{"text":"请把房间的～打扫干净。"},"usage":"作宾语、定语；指细小角落"},{"id":24413,"word":"旰食之劳","pinyin":"gàn shí zhī láo","abbr":"gszl","explanation":"天色已晚才吃饭。形容勤于政事。","source":{"text":"不然，恐将来必有愆阳苦雨之灾，崩震薄蚀之变，狂狡蠹戾之妖，以益陛下旰食之劳也。","book":"《晋书·郭璞传》"},"example":{"text":"恭惟皇帝陛下天仁博施，神智曲成，躬忘～，坐讲日新之政。","book":"宋·王安石《乞皇帝御正殿复常膳表》"},"usage":"作主语、宾语；用于书面语"},{"id":24414,"word":"旰食宵衣","pinyin":"gàn shí xiāo yī","abbr":"gsxy","explanation":"天色很晚才吃饭，天不亮就穿衣起来。形容勤于政事。","source":{"text":"勤民听政，旰食宵衣。","book":"南朝·陈·徐陵《陈文帝哀策文》"},"example":{"text":"奋乾纲～，持国柄敬天慰庙。","book":"明·陈汝元《金莲记·射策》"},"similar":["宵衣旰食","日理万机"],"opposite":["游手好闲","无所事事"],"usage":"作谓语、定语；指勤于政事"},{"id":24415,"word":"旱涝保收","pinyin":"hàn lào bǎo shōu","abbr":"hlbs","explanation":"指土地灌溉及排水情况良好，不论天旱或多雨，都能得到好收成。泛指获利有保证的事情。","example":{"text":"端上铁饭碗就～的日子已经过去了。"},"usage":"作谓语、定语；泛指获利有保证的事情"},{"id":24416,"word":"旱苗得雨","pinyin":"hàn miáo dé yǔ","abbr":"hmdy","explanation":"将要枯死的禾苗得到地场好雨。比喻在危难中得到援助。","source":{"text":"七八月之间旱，则苗槁矣。天油然作云，沛然下雨，则苗然兴之矣。","book":"《孟子·梁惠王上》"},"example":{"text":"天幸今得贤弟来此间镇守，正如“锦上添花，～。”","book":"明·施耐庵《水浒全传》第五十回"},"similar":["枯木逢春","雪中送炭"],"usage":"作宾语；比喻在危难中得到援助"},{"id":24417,"word":"旱魃为灾","pinyin":"hàn bá wèi zāi","abbr":"hbwz","explanation":"旱魃：传说中能引起旱灾的怪物。指发生旱灾。","source":{"text":"又今旱魃为灾，濒河人迹所至之处，禾稼仅有存者。","book":"明·归有光《论三区赋役水利书》"},"similar":["旱魃为虐"],"opposite":["河伯为患"],"usage":"作谓语、宾语；指发生旱灾"},{"id":24418,"word":"旱魃为虐","pinyin":"hàn bá wèi nüè","abbr":"hbwn","explanation":"旱魃：古代传说中能赞成旱灾的怪物；虐：灾害。指旱灾。","source":{"text":"旱魁为虐，如惔如焚。","book":"《诗·大雅·云汉》"},"example":{"text":"而地震之后，雾气白浊，日月不光，～，大贼从横，流血丹野，庶品不安，谴诫累至，殆以奸臣权重之所致也。","book":"《后汉书·皇甫规传》"},"similar":["旱魃为灾"],"opposite":["河伯为患"],"usage":"作谓语、宾语；指发生旱灾","story":["传说黄帝的女儿魃因为身体里有大量的热能，她所到之处就经常发生旱灾，人们很不欢迎她，认为她是瘟神。黄帝把她安置在赤水北方。她只好夜间出来活动，与那些夜叉们在一起，但是他们也经常干坏事，旱灾也时常发生"]},{"id":24419,"word":"旱魃拜夜叉","pinyin":"hàn bá bài yè chā","abbr":"hbbyc","explanation":"旱魃：传说中引起旱灾的怪物；夜叉：能啖鬼或捷疾鬼。指坏人相互勾结狼狈为奸。","example":{"text":"你听说～的故事吗？"},"similar":["旱魃为虐"],"usage":"作宾语、定语；指狼狈为奸","story":["传说黄帝的女儿魃因为身体里有大量的热能，她所到之处就经常发生旱灾，人们很不欢迎她，认为她是瘟神。黄帝把她安置在赤水北方。她只好夜间出来活动，与那些夜叉们在一起，但是他们也经常干坏事，旱灾也时常发生"]},{"id":24420,"word":"时不久留","pinyin":"shí bù jiǔ liú","abbr":"sbjl","explanation":"时机不会长久等待。意思是要抓紧时机。","source":{"text":"天下再兴，时不久留。","book":"《吕氏春秋·首时》"}},{"id":24421,"word":"时不再来","pinyin":"shí bù zài lái","abbr":"sbzl","explanation":"时：时机。时机错过就不会再来了。指行事不要放过时机。","source":{"text":"得时无怠，时不再来，天予不取，反为之灾。","book":"《国语·越语下》"},"example":{"text":"事机一失，～，惟望宸断。","book":"清·陈忱《水浒后传》第七回"},"similar":["机不可失","时不我待"],"usage":"作宾语、分句；指行事不要放过时机"},{"id":24422,"word":"时不再至","pinyin":"shí bù zài zhì","abbr":"sbzz","explanation":"时：时机。时机错过就不会再来了。指行事不要放过时机。","source":{"text":"良时不再至，离别在须臾。","book":"汉·李陵《与苏武诗》"}},{"id":24423,"word":"时不可失","pinyin":"shí bù kě shī","abbr":"sbks","explanation":"时：时机，机会；失：错过。抓住时机，不可错过。","source":{"text":"臣闻敌不可易，时不可失。","book":"《战国策·秦策四》"},"example":{"text":"此天遣我以报复之机，～。","book":"明·冯梦龙《东周列国志》第四十九回"},"similar":["机不可失"],"usage":"作宾语、定语；指要及时抓住时机"},{"id":24424,"word":"时不可逢","pinyin":"shí bù kě féng","abbr":"sbkf","explanation":"逢：遭遇，遇见。大好时机平日不易遇到。","source":{"text":"机事难遇，时不可逢。","book":"《魏书·薛安都传》"},"similar":["机不可失"],"usage":"作宾语、定语；用于劝诫人"},{"id":24425,"word":"时不我与","pinyin":"shí bù wǒ yǔ","abbr":"sbwy","explanation":"我与：“与我”的倒装；与：等待。时间不会等待我们的。嗟叹时机错过，追悔不及。","source":{"text":"日月逝矣，岁不我与。","book":"《论语·阳货》"},"example":{"text":"副总统执事：～，岁且更新，烈士暮年，壮心不已，以此为公祝。","book":"章炳麟《致黎元洪书》"},"similar":["时不我待"],"usage":"作宾语、分句；同“时不我待”"},{"id":24426,"word":"时不我待","pinyin":"shí bù wǒ dài","abbr":"sbwd","explanation":"我待：“待我”的倒装，等待我。时间不会等待我们。指要抓紧时间。","source":{"text":"日月逝矣，岁不我与。","book":"《论语·阳货》"},"example":{"text":"这项任务十分紧迫，～。"},"similar":["时不再来","争分夺秒"],"opposite":["无所事事","得过且过"],"usage":"作宾语、定语、分句；指要抓紧时间"},{"id":24427,"word":"时乖命蹇","pinyin":"shí guāi mìng jiǎn","abbr":"sgmj","explanation":"时：时运，时机；乖：不顺利；蹇：一足偏废，引伸为不顺利。时运不好，命运不佳。这是唯心主义宿命论的观点。","source":{"text":"早是抱闲怨，时乖运蹇。","book":"元·白仁甫《墙头马上》"},"example":{"text":"人人只知道～，那知生活的帐子里有巨大的毒虫，以至于蚊蚋。","book":"瞿秋白《饿乡纪程》"},"similar":["生不逢时","命途多舛"],"opposite":["万事亨通","吉祥如意"],"usage":"作谓语、宾语；指时运不好"},{"id":24428,"word":"时乖运乖","pinyin":"shí guāi yùn guāi","abbr":"sgyg","explanation":"时运不顺，命运不佳。指处境不顺利。","source":{"text":"念奴家时乖运乖，告求人出于无奈。","book":"明·范受益《寻亲记·告借》"},"similar":["时乖运舛","时乖运拙"],"opposite":["时亨运泰"],"usage":"作谓语、定语；用于人的处境等"},{"id":24429,"word":"时乖运拙","pinyin":"shí guāi yùn zhuō","abbr":"sgyz","explanation":"拙：劣，不好。时运不顺，命运不佳。指处境不顺利。","source":{"text":"争奈我时乖运拙难前进，几时能够朝帝阙受君恩。","book":"元·无名氏《娶小乔》头折"},"example":{"text":"你～遭磨障，你处交友无终姓，断义疏亲绝故乡，将三教恶言谤，怎生得全家富贵，永远荣昌。","book":"明·无名氏《贫富兴衰》第三折"},"similar":["时乖运蹇"],"opposite":["时亨运泰"],"usage":"作谓语、定语；用于人处境等"},{"id":24430,"word":"时乖运舛","pinyin":"shí guāi yùn chuǎn","abbr":"sgyc","explanation":"舛：违背，不相合。时运不顺，命运不佳。指处境不顺利。","source":{"text":"不意时乖运舛，登时也就遇害。","book":"清·李汝珍《镜花缘》第五十六回"},"similar":["时乖命蹇"],"opposite":["时亨运泰"],"usage":"作谓语、宾语；指时运不好"},{"id":24431,"word":"时乖运蹇","pinyin":"shí guāi yùn jiǎn","abbr":"sgyj","explanation":"时：时运，时机；乖：不顺利；蹇：一足偏废，引伸为不顺利。时运不好，命运不佳。这是唯心主义宿命论的观点。","source":{"text":"早是抱闲怨，时乖运蹇。又添这害相思，月值年灾。","book":"元·白朴《墙头马上》第二折"},"example":{"text":"言之不尽，自从父亲亡故之后，～，一向流落江湖。","book":"明·施耐庵《水浒全传》第五十六回"},"similar":["时乖命蹇","时乖运拙"],"usage":"作谓语；指时运不好"},{"id":24432,"word":"时亨运泰","pinyin":"shí hēng yùn tai","abbr":"shyt","explanation":"旧时指命运亨通。","source":{"text":"也是宋金时亨运泰，恰好有一只大船，因逆浪冲坏了舵，停泊于岸下修舵。","book":"明·冯梦龙《警世通言》第二十二卷"},"similar":["时运亨通"],"opposite":["时乖远舛","时乖运乖","时乖运拙"],"usage":"作谓语、定语；用于书面语"},{"id":24433,"word":"时光似箭，日月如梭","pinyin":"shí guāng sì jiàn，rì yuè rú suō","abbr":"sgsjryrs","explanation":"形容光阴过得很快。","source":{"text":"时光似箭，日月如梭，也有一年之上。","book":"《京本通俗小说·碾玉观音》"},"example":{"text":"不觉～，玉帝化身，在哥阇国为王，享太平天下有十年矣。","book":"《四游记·天尊点化玉帝》第四回"},"similar":["光阴似箭，日月如梭"],"usage":"作宾语、定语、分句；可分开使用"},{"id":24434,"word":"时势造英雄","pinyin":"shí shì zào yīng xióng","abbr":"sszyx","explanation":"时势：一段时期内的客观形势。特定的历史条件，如社会动荡，使人的聪明才智显露出来，并相互作用，使之成为英雄人物。","source":{"text":"以我这样的少年，回到少年时代大有作为的中国，正合了‘英雄造时势，时势造英雄’那两句话。","book":"冰心《去国》"},"example":{"text":"他的成功，只能说是时势造英雄的结果。"},"usage":"作宾语、分句；指社会造就人才"},{"id":24435,"word":"时去时来","pinyin":"shí qù shí lái","abbr":"sqsl","explanation":"有时去，有时来，来去不定。","source":{"text":"时去时来，来则风肃然也。","book":"《史记·孝武本纪》"},"example":{"text":"育至百日，便能飞翔。～，杨宝十分珍重。","book":"明·冯梦龙《醒世恒言》卷六"}},{"id":24436,"word":"时变之应","pinyin":"shí biàn zhī yìng","abbr":"sbzy","explanation":"顺应时势的变化，采取适当的措施。","source":{"text":"此四者，义兵之助也，时变之应也。","book":"《吕氏春秋·简选》"}},{"id":24437,"word":"时变是守","pinyin":"shí biàn shì shǒu","abbr":"sbss","explanation":"顺应时势的变化，采取适当的措施。","source":{"text":"有法无法，因时为业；有度无度，因物与合。故曰‘圣人不朽，时变是守。虚者道之常也，因者君之纲’也。","book":"《史记·太史公自序》"}},{"id":24438,"word":"时和岁丰","pinyin":"shí hé suì fēng","abbr":"shsf","explanation":"和：和平；岁：年成；丰：盛，多。时代太平，风调雨顺，五谷丰登。","source":{"text":"万物盛多，人民忠孝，则致时和年丰，故次华黍，岁丰宜黍稷也。","book":"《诗经·小雅·华黍》孔颖达疏"},"example":{"text":"今～，边鄙不耸，亦古之所谓小康者。","book":"宋·陈亮《廷对》"},"similar":["时和岁稔","时和年丰"],"usage":"作谓语、定语、宾语；称颂太平盛世"},{"id":24439,"word":"时和岁稔","pinyin":"shí hé suì rěn","abbr":"shsr","explanation":"四时和顺，五谷丰收。用以称颂太平盛世。同“时和年丰”。","source":{"text":"救民拯弊，莫过减赋。时和岁稔，尚尔虚乏，傥值水旱，宁可熟念？","book":"《南齐书·王敬则传》"},"example":{"text":"上乐～，万物得其宜；下乐名遂官闲，一身得其所。","book":"唐·白居易《泛渭赋》序"},"similar":["时和岁丰","时和年丰"],"usage":"作谓语、定语、宾语；称颂太平盛世"},{"id":24440,"word":"时和年丰","pinyin":"shí hé nián fēng","abbr":"shnf","explanation":"和：和平；年：年成；丰：盛，多。风调雨顺，五谷丰登。","source":{"text":"万物盛多，人民忠孝，则致时和年丰，故次《华黍》，岁丰宜黍稷也。","book":"《诗经·小大雅谱》唐·孔颖达疏"},"example":{"text":"～，百宝告成。","book":"清·姚莹《噶玛兰台异记》"},"similar":["时和岁丰","时和岁稔"],"usage":"作谓语、定语；称颂太平盛世"},{"id":24441,"word":"时异事异","pinyin":"shí yì shì yì","abbr":"sysy","explanation":"时代不同，事情也不相同。","source":{"text":"使苏秦、张仪与仆并生于今之世，曾不得掌故，安敢望常侍郎乎？故曰：时异事异。","book":"汉·东方朔《答客难》"},"example":{"text":"尝窃原祖宗之意，盖以谓三代旧典，～，不可复行。","book":"宋·苏辙《论合祭天地札子》"}},{"id":24442,"word":"时异事殊","pinyin":"shí yì shì shū","abbr":"syss","explanation":"殊：不同。时间不同，事情也和以前不一样。形容事物随时间推移而发生变化。","source":{"text":"尚恐议者曰：‘时异事殊。’臣请复为陛下粗举近效之尤章者以辩焉。","book":"唐·陆贽《奉天论延访朝臣表》"},"example":{"text":"清·褚人获《隋唐演义》第61回：“～，我心匪石，不可转也。”"},"similar":["时移世易"],"usage":"作宾语、定语；用于书面语"},{"id":24443,"word":"时异势殊","pinyin":"shí yì shì shū","abbr":"syss","explanation":"指时代、情势等都已起了变化。","source":{"text":"不独此也，举一人而言，在仲由则为当行，而在冉求则为不当行矣，盖时异势殊，则言者变矣。","book":"明·张居正《答朱谨吾辞建亭》：“时异事殊，陵谷迁变。”明·李贽《焚书·杂述·先行录序》"},"example":{"text":"即使起公于九原，复理当日之坠绪，～，吾知其有所不能也。","book":"清·黄宗羲《霍丘名宦录序》"},"similar":["时异事殊"],"usage":"作宾语、定语；用于书面语"},{"id":24444,"word":"时政利病","pinyin":"shí zhèng lì bìng","abbr":"szlb","explanation":"时政：目前的政局；病：毛病，弊病。当前政治方面的优点和弊病。","source":{"text":"甲午，诏自今百官朝对，须陈时政利病，无以触讳为惧。","book":"《宋史·太祖纪一》"}},{"id":24445,"word":"时断时续","pinyin":"shí duàn shí xù","abbr":"sdsx","explanation":"不连续的，具有无条理的和不连贯的特性。","source":{"text":"虽然这样时断时续地学，但他实际上早可以独立开汽车了。","book":"路遥《平凡的世界》第四卷第36章"},"example":{"text":"看台上人声如潮夹着裁判的哨音和～的喇叭声。","book":"王朔《玩儿的就是心跳》"},"similar":["断断续续"],"opposite":["连续不断"],"usage":"作谓语、定语；指不连贯"},{"id":24446,"word":"时无再来","pinyin":"shí wú zài lái","abbr":"swzl","explanation":"时机错过，不会再来。激励人要抓紧时机。","source":{"text":"春无再至，花无再开；人无再少，时无再来。","book":"宋·邵雍《不再吟》"},"similar":["时不再来"],"usage":"作宾语、定语、分句；指行事不要放过时机"},{"id":24447,"word":"时无英雄，使竖子成名","pinyin":"shí wú yīng xióng，shǐ shù zǐ chéng míng","abbr":"swyxsszcm","explanation":"竖子：小子，有轻蔑之意。时代无英雄，使无名之辈成了豪杰。指无能者侥幸得以成名。","source":{"text":"尝登广武，观楚汉战处，叹曰：‘时无英雄，使竖子成名。’","book":"《晋书·阮籍传》"}},{"id":24448,"word":"时日曷丧","pinyin":"shí rì hé sàng","abbr":"srhs","explanation":"表示誓不与其共存。形容痛恨到极点。","source":{"text":"众下相率为怠情，不与上和合，比桀于日，曰：‘是日何时丧，我与汝俱亡！’欲杀身以丧桀。","book":"语出《书·汤誓》“有众率怠，弗协，曰：‘时日曷丧，予及汝皆亡！’”孔传"},"example":{"text":"城市村落，搜括无遗。遂使江东父老有～之悲。武官爱钱之祸，一至于此！","book":"清·张岱《石匮书后集·流寇死战诸臣列传·总论》"},"usage":"作宾语、定语；用于书面语"},{"id":24449,"word":"时时刻刻","pinyin":"shí shí kè kè","abbr":"sskk","explanation":"每时每刻或每一个时刻。","source":{"text":"因此他两个日夜趋奉，时时刻刻赶着凑趣不迭，都想着要从山西发发财。","book":"清·李百川《绿野仙踪》第47回"},"example":{"text":"她～都保持高度警惕。"},"similar":["每时每刻"],"usage":"作状语；指每时每刻"},{"id":24450,"word":"时易世变","pinyin":"shí yì shì biàn","abbr":"sysb","explanation":"时代变迁，世事也不一样。","source":{"text":"当今之急，何用清谈？时易世变，古今异俗。","book":"晋·鲁褒《钱神论》"},"similar":["时移世易","时移世变"],"usage":"作宾语、定语；用于书面语"},{"id":24451,"word":"时有终始","pinyin":"shí yǒu zhōng shǐ","abbr":"syzs","explanation":"时节有结束有开始。指凡事都有开头结尾。","source":{"text":"理道不私，故无名，无名故无为，无为而无不为，时有终始，世有变化。","book":"《庄子·则阳》"}},{"id":24452,"word":"时望所归","pinyin":"shí wàng suǒ guī","abbr":"swsg","explanation":"声望很高，为世人所敬仰。","source":{"text":"卿时望所归，今欲屈卿同受顾托。","book":"《晋书·阮籍传》"},"example":{"text":"这是～的人。"},"similar":["众望所归"],"usage":"作谓语、定语；指声望高"},{"id":24453,"word":"时来运旋","pinyin":"shí lái yùn xuán","abbr":"slyx","explanation":"本来处境不利，遇到机会，命运开始好转。同“时来运转”。","source":{"text":"问何年是你的运来时旋？","book":"明·王玉峰《焚香记·相决》"},"similar":["时来运来","时来运转"],"usage":"作谓语、定语、宾语；指转好"},{"id":24454,"word":"时来运来","pinyin":"shí lái yùn lái","abbr":"slyl","explanation":"本来处境不利，遇到机会，命运开始好转。同“时来运转”。","source":{"text":"阿大利时来运来，首先挑着粪担，到租界出粪。","book":"清·姬文《市声》第十七回"},"example":{"text":"曾朴《孽海花》第八回：“也是雯青～，又有潘八瀛、龚和甫这班大帽子替他揄扬帮衬，声誉日高一日。”"},"similar":["时来运旋","时来运转"],"usage":"作谓语、定语、宾语；指转好"},{"id":24455,"word":"时来运转","pinyin":"shí lái yùn zhuǎn","abbr":"slyz","explanation":"旧指时机来了，命运也有了转机。指境况好转。","source":{"text":"奴怎比韩氏素梅，生在烟花，时来运转，贵人提拔，才把君恩拜。","book":"《白雪遗音·马头调·麻衣神相》"},"example":{"text":"然后渐渐～，建功立业，加官进爵。","book":"清·褚人获《隋唐演义》第八十三回"},"similar":["苦尽甘来","鸿运高照","时来运来"],"opposite":["祸不单行","生不逢时"],"usage":"作谓语、定语；指转好"},{"id":24456,"word":"时殊风异","pinyin":"shí shū fēng yì","abbr":"ssfy","explanation":"时：时代。风：风俗。殊、异：不同。时代不同，风俗也不同。","source":{"text":"虽世代不同，至于主运臣赞，古今一揆。","book":"《宋书·徐羡之传》"}},{"id":24457,"word":"时清海宴","pinyin":"shí qīng hǎi yàn","abbr":"sqhy","explanation":"时世清平，四方安定。","source":{"text":"时清海宴定风波，恩光六塞，瑞气遍山坡。","book":"《敦煌曲子词·献忠心》"},"usage":"作谓语、定语；用于局面等"},{"id":24458,"word":"时祀尽敬，而不祈喜","pinyin":"shí sì jìn jìng，ér bù qǐ xǐ","abbr":"ssjjebqx","explanation":"祀：祭祀；祈：向神求祷。按四时去祭祀钦敬，并没有求来好事。形容祈求诸神鬼也无济于事。","source":{"text":"昔者神农之有天下也，时祀尽敬而不祈喜；其于人也，忠信尽治而无求焉。","book":"《庄子·让王》"}},{"id":24459,"word":"时移世变","pinyin":"shí yí shì biàn","abbr":"sysb","explanation":"时代变迁，世事也不一样。同“时易世变”。","source":{"text":"朝当晏驾，时移世变，遂出掾高要，佐浔阳。","book":"唐·白居易《唐淮南节度使李公家庙碑铭序》"},"example":{"text":"～，社会进步很快"},"similar":["时易世变","时移世易","时移世异"],"usage":"作宾语、定语；用于书面语"},{"id":24460,"word":"时移世异","pinyin":"shí yí shì yì","abbr":"sysy","explanation":"那个时间已成过去，世情或处境也都已改变了。","source":{"text":"忆儿貌，念儿心，望儿不见泪沾襟，时移世异难相见，弃谢此生当重寻。","book":"唐·牛僧孺《玄怪录·顾揔》"},"example":{"text":"朱自清《诗教》：“汉以后～，又书籍渐多，学者不必专读经，经学便衰了下来。”"},"similar":["时移世易","时移世变"],"usage":"作宾语、定语；用于书面语"},{"id":24461,"word":"时移世换","pinyin":"shí yí shì huàn","abbr":"sysh","explanation":"时移：时代变迁。随着时代的变迁，世事也发生了变化。","source":{"text":"湖山如故，风景不殊，但时移世换，令人有黍离之悲。","book":"明·瞿佑《剪灯新话·滕穆醉游聚景园记》"}},{"id":24462,"word":"时移世改","pinyin":"shí yí shì gǎi","abbr":"sysg","explanation":"时代变了，世事也在改变。","source":{"text":"且夫古者事事醇素，今则莫不雕饰，时移世改，理自然也。","book":"《抱朴子·钧世》"}},{"id":24463,"word":"时移世易","pinyin":"shí yí shì yì","abbr":"sysy","explanation":"易：变。时光推移，世事随之改变。","source":{"text":"假使日往月来，时移世易，门无强荫，家有幼孤，犹加璧不遗，分宅相济，无忘先德，以恤后人。","book":"《梁书·侯景传》"},"example":{"text":"《梁书·侯景传》：“假使日往月来，～，门无强荫，家有幼孤，犹加壁不遗，分宅相济，无忘先德，以恤后人。”"},"similar":["时移世变","时易世变"],"usage":"作宾语、定语；用于书面语"},{"id":24464,"word":"时移事去","pinyin":"shí yí shì qù","abbr":"sysq","explanation":"随着时间的推移，事情已经过去。","source":{"text":"时移事去，乐尽悲来。","book":"唐·陈鸿《长恨歌传》"}},{"id":24465,"word":"时移事改","pinyin":"shí yí shì gǎi","abbr":"sysg","explanation":"随着时间的流逝，世事也在改变。","source":{"text":"然则君臣无常位，陵谷有变迁，或棰塞长河，泥封函谷，时移世改，理有万珠。","book":"《旧五代史·唐书·武皇纪下》"}},{"id":24466,"word":"时移事迁","pinyin":"shí yí shì qiān","abbr":"sysq","explanation":"随着时间的流逝，世事也在改变。","source":{"text":"说甚么宦室门楣，寒士寻常，望若云霄；时移事迁，为地覆天翻，君去民逃。","book":"元·施惠《幽闺记·招商谐偶》"}},{"id":24467,"word":"时移俗易","pinyin":"shí yí sú yì","abbr":"sysy","explanation":"移：变动；易：改换。时代变了，社会风气也变了。","source":{"text":"今夫世异则事变，事变则时移，时移则俗易。","book":"《淮南子·齐俗训》：“时移则俗易。”汉·刘向《说苑·杂言》"},"example":{"text":"及～，则通变适用，是以周、汉俶迁，随世轻重。","book":"《宋史·颜竣传》"},"usage":"作谓语；指时世、风俗等都起了变化"},{"id":24468,"word":"时移势易","pinyin":"shí yí shì yì","abbr":"sysy","explanation":"指时代、情势等都已发生变化。","source":{"text":"时移势易，踵事增华，亦不得独罪商君矣。","book":"清·杭世骏《质疑·诸史》"},"similar":["时移势迁","时移势变"],"usage":"作谓语、定语；指时代不同情况也发生了变化"},{"id":24469,"word":"时移势迁","pinyin":"shí yí shì qiān","abbr":"sysq","explanation":"时候不同，情况也发生了变化。","source":{"text":"然则君臣无常位，陵谷有变迁，或棰塞长河，泥封函谷，时移世改，理有万珠。","book":"《旧五代史·唐书·武皇纪下》"},"example":{"text":"说甚么宦室门楣，寒士寻常，望若云霄；～，为地覆天翻，君去民逃。（元·施惠《幽闺记·招商谐偶》）"},"similar":["时移势易"],"usage":"作谓语、宾语；指时候不同"},{"id":24470,"word":"时移物换","pinyin":"shí yí wù huàn","abbr":"sywh","explanation":"时：时代；移：变迁；换：变换。由于时代变迁，一切景物也变了样。","source":{"text":"宋公明费许多心机，才招聚得一百八人，死的死，散的散。时移物换，哪里还兴得？","book":"清·陈忱《水浒后传》第十回"},"example":{"text":"鼎革以来，～。十年旧梦，依约扬州。","book":"清·余怀《板桥杂记》"}},{"id":24471,"word":"时穷节乃见","pinyin":"shí qióng jié nǎi xiàn","abbr":"sqjnj","explanation":"时穷：最危急的时刻；节：气节。在危难的关头，一个人的节操才能显现出来。","source":{"text":"时穷节乃见，一一垂丹青。","book":"宋·文天祥《正气歌》"}},{"id":24472,"word":"时绌举盈","pinyin":"shí chù jǔ yíng","abbr":"scjy","explanation":"绌：不足、不够。盈：有余、多余。当衰败之时，而强作奢侈之事。盈，通“赢”。同“时绌举赢”。","source":{"text":"度所费不下数千金，时绌举盈，极为民害。","book":"清·吕留良《与董方白书》"},"similar":["时绌举赢"],"usage":"作宾语、定语；用于处事"},{"id":24473,"word":"时绌举赢","pinyin":"shí chù jǔ yíng","abbr":"scjy","explanation":"在困难的时候而做奢侈的事情。","source":{"text":"今年旱，昭侯不以此时恤民之急，而顾益奢，此谓时绌举赢。","book":"西汉·司马迁《史记·韩世家》"},"example":{"text":"盖言劳民伤财，～也。","book":"宋·郑兴裔《请罢建康行宫疏》"},"similar":["时绌举盈"],"usage":"作谓语、宾语、定语；指勉强维持"},{"id":24474,"word":"时羞之奠","pinyin":"shí xiū zhī diàn","abbr":"sxzd","explanation":"羞：同“馐”，食品。用应时的食品祭祀鬼神。旧时迷信，所谓虔诚的祭奠。","source":{"text":"乃能衔哀臻诚，使建中远具时羞之奠，告汝十二郎之灵。","book":"唐·韩愈《蔡十二郎文》"}},{"id":24475,"word":"时者难得而易失","pinyin":"shí zhě nán dé ér yì shī","abbr":"szndeys","explanation":"时机难以得到而容易失掉。","source":{"text":"夫功者难成而易败，时者难得而易失也。时乎时，不再来。","book":"《史记·淮阴侯列传》"}},{"id":24476,"word":"时至运来","pinyin":"shí zhì yùn lái","abbr":"szyl","explanation":"时机来了，运气也有了转机。指由逆境转为顺境。","source":{"text":"时至运来，当在三五。","book":"南朝·宋·颜延之《大筮箴》"}},{"id":24477,"word":"时苗留犊","pinyin":"shí miáo liú dú","abbr":"smld","explanation":"时苗：东汉时人名。时苗曾是寿春令，上任时乘母牛驾的车，后牛生一犊，时苗离任时将牛犊留下，不肯带走。比喻为官清廉。","source":{"text":"时苗留犊，羊续悬鱼。","book":"唐·李瀚《蒙求》"}},{"id":24478,"word":"时见一斑","pinyin":"shí jiàn yī bān","abbr":"sjyb","explanation":"只看到一部分，看不到整体。","source":{"text":"此郎亦管中窥豹，时见一斑。","book":"南朝·宋·刘义庆《世说新语·方正》"}},{"id":24479,"word":"时诎举赢","pinyin":"shí qū jǔ yíng","abbr":"sqjy","explanation":"在困难的时候而做奢侈的事情。同“时绌举赢”。","source":{"text":"君必不出此门。何也？不时。吾所谓时者，非时日也。夫人固有利、不利时。往者君尝利矣，不作高门。前年秦拔宜阳，今年旱，君不以此时恤民之急而顾益奢，此所谓时诎举赢者也。故曰不时。","book":"《资治通鉴·周显王三十五年》"}},{"id":24480,"word":"时谈物议","pinyin":"shí tán wù yì","abbr":"stwy","explanation":"时：时人；物：人。指他人的议论。","source":{"text":"凡此不可，其流实多，一言以蔽，三隅自反。而时谈物议焉得笑仆编次无闻者哉？","book":"唐·刘子玄《论史上萧至书》"},"similar":["街谈巷议"],"usage":"作宾语、定语；用于书面语"},{"id":24481,"word":"时过境迁","pinyin":"shí guò jìng qiān","abbr":"sgjq","explanation":"迁：变动。随着时间的推移，情况发生变化。","source":{"text":"如此歇了好几日，黄绣球与黄通理事过境迁，已不在心上。","book":"清·颐琐《黄绣球》"},"example":{"text":"～，色衰爱驰，我对它们也失去了兴趣。","book":"孙犁《秀露集·石子》"},"similar":["时移俗易"],"opposite":["一如既往","依然如故","一成不变"],"usage":"作谓语；指时间变化"},{"id":24482,"word":"时运不济","pinyin":"shí yùn bù jì","abbr":"sybj","explanation":"时机和命运不佳。","source":{"text":"先对莫翁道：‘寄儿蒙公公相托，一向看牛不差。近来时运不济，前日失了两牛，今蹇驴又生病，寄儿看管不来。’","book":"明·凌濛初《二刻拍案惊奇》卷十九"},"example":{"text":"有一次他替一位病妇半夜里去请医生，医生困眼朦胧的下错了药，而人们全埋怨赵四～至于把有名的医生连累的下错了药！","book":"老舍《老张的哲学》第二九"},"similar":["时运不齐"],"opposite":["时运亨通"],"usage":"作谓语、定语；指运气不好"},{"id":24483,"word":"时运不齐","pinyin":"shí yùn bù jì","abbr":"sybj","explanation":"齐：同“济”。遭遇逆境，命运不好。亦作“时运不济”。","source":{"text":"怀帝阍而不见，奉宣室以何年。嗟乎！时运不齐，命途多舛。","book":"唐·王勃《滕王阁诗序》"},"example":{"text":"明·胡文焕《群音类选·》：“此际青衫湿更多，～奈若何。”"},"similar":["时运不济"],"usage":"作谓语、定语；指运气不好"},{"id":24484,"word":"时运亨通","pinyin":"shí yùn hēng tōng","abbr":"syht","explanation":"指时运好，诸事顺利。","source":{"text":"终有日时运亨通，封侯拜相，扬名六国。","book":"元·无名氏《冻苏秦》第一折"},"example":{"text":"我们希望自己将来～。"},"similar":["时亨运泰"],"opposite":["时运不济"],"usage":"作谓语；指时运好"},{"id":24485,"word":"时运则存，不用则亡","pinyin":"shí yùn zé cún，bù yòng zé wáng","abbr":"syzcbyzw","explanation":"时：经常。原指铁针要经常使用，不用就要生锈，成为没用的东西。后指技术、知识越用越熟练、丰富，不使用就要生疏、遗忘。","source":{"text":"功业甚博，不见贤良。时用则存，不用则亡。","book":"《荀子·赋篇》"}},{"id":24486,"word":"时通运泰","pinyin":"shí tōng yùn tài","abbr":"styt","explanation":"泰：平安，安宁。指时运好，诸事顺利。","source":{"text":"且忍耐在家，俟时通运泰，必有发迹的分也。","book":"《新编五代史平话·周史》"},"usage":"作宾语、定语；用于书面语"},{"id":24487,"word":"时隐时现","pinyin":"shí yǐn shí xiàn","abbr":"sysx","explanation":"一会儿隐没，一会儿出现。","source":{"text":"子房当烹狗藏弓之世，时隐时现，托赤松以自保。","book":"明·袁宏道《广庄·人间世》"},"example":{"text":"基干部分采取～的方式最为有利。","book":"邓小平《敌占区的组织工作与政策运用》"},"similar":["若隐若现"],"usage":"作谓语、定语、状语；用于远处的事物"},{"id":24488,"word":"时隐时见","pinyin":"shí yǐn shí xiàn","abbr":"sysj","explanation":"隐：隐没。见：同“现”；出现。有时隐没，有时出现。远处事物忽明忽暗。","source":{"text":"其间林木荟蔚，云烟掩映，高楼曲榭，时隐时见，使画工极思不可图。","book":"宋·邵伯温《闻见后录》卷二十五"},"similar":["时隐时现"],"usage":"作谓语、定语；指不清晰"},{"id":24489,"word":"时难得而易失","pinyin":"shí nán dé ér yì shī","abbr":"sndeys","explanation":"时机难以得到而容易失掉。","source":{"text":"吾闻，时难得而易失，客寡甚安，殆非就国者也。","book":"《史记·齐世家》"},"example":{"text":"～，民难安而易危。","book":"宋·苏轼《除范纯仁特授太中大夫守尚书右仆射兼中书侍郎进封高平郡开国侯加食邑实封余如故制》"}},{"id":24490,"word":"时雨春风","pinyin":"shí yǔ chūn fēng","abbr":"sycf","explanation":"及时的雨，春天的风。泛指能使万物生长的雨和风。比喻良好教育的普遍深入。用来称颂师长的教诲。","source":{"text":"君子之所以教者五，有如时雨化之者。","book":"《孟子·尽心上》"},"example":{"text":"万里江山重见尧天舜月，九州草木共裕～。"}},{"id":24491,"word":"旷世不羁","pinyin":"kuàng shì bù jī","abbr":"ksbj","explanation":"旷世：从未有过；羁：束缚。从来不受束缚。旧时指藩属不受管辖。","source":{"text":"东夷献其乐器，肃慎贡其楛矢，旷世不羁，应化而至。","book":"晋·孙楚《为石苞与孙皓书》"},"usage":"作谓语、定语；用于书面语"},{"id":24492,"word":"旷世奇才","pinyin":"kuàng shì qí cái","abbr":"ksqc","explanation":"旷世：当代没有能相比的。指当代少见的奇才。","source":{"text":"李公旷世奇才，正宜匡扶社稷。","book":"明·屠隆《彩毫记·祖饯都门》"},"example":{"text":"还有邬思道这位才思敏捷、谋事深远的～。","book":"二月河《雍正皇帝》第十五回"},"similar":["旷世逸才"],"usage":"作宾语；指才能出众的人"},{"id":24493,"word":"旷世无匹","pinyin":"kuàng shì wú pǐ","abbr":"kswp","explanation":"匹：相当。独一无二，异常出色。","source":{"text":"至夜，焚香坐伺，妇果携女至。态度娴婉，旷世无匹。","book":"清·蒲松龄《聊斋志异·狐梦》"},"similar":["盖世无双","独一无二"],"opposite":["比比皆是"],"usage":"作谓语、定语；用于书面语"},{"id":24494,"word":"旷世逸才","pinyin":"kuàng shì yì cái","abbr":"ksyc","explanation":"旷世：绝代；空前。逸才：超人的才智。当代少见的出众的才能。","source":{"text":"伯喈旷世逸才，若使续成汉史，诚为盛事。","book":"明·罗贯中《三国演义》第九回"},"example":{"text":"明·罗贯中《三国演义》第九回：“伯喈～，若使续成汉史，诚为盛事。”"},"similar":["旷世奇才"],"usage":"作宾语；指才能出众的人"},{"id":24495,"word":"旷古一人","pinyin":"kuàng gǔ yī rén","abbr":"kgyr","explanation":"旷古：空前；从古到今。自古以来只此一人。形容绝无仅有。","source":{"text":"北面而师之者，可谓旷古一人而已！","book":"五代·王定保《唐摭言·以其人不称才试而后惊》"},"similar":["旷古绝伦","盖世无双"],"opposite":["比比皆是"],"usage":"作宾语、定语；用于独特的人"},{"id":24496,"word":"旷古奇闻","pinyin":"kuàng gǔ qí wén","abbr":"kgqw","explanation":"旷古：自古所没有的。自古以来从未听到过的奇异事情。","example":{"text":"这真是旷古奇闻，要不是亲眼所见，我还不会相信。"},"similar":["光怪陆离"],"opposite":["司空见惯"],"usage":"作宾语；形容罕见的奇事"},{"id":24497,"word":"旷古无两","pinyin":"kuàng gǔ wú liǎng","abbr":"kgwl","explanation":"旷古：自古以来所没有的。自古以来没有第二个。形容独一无二，绝无仅有。","source":{"text":"北面而师之者，可谓旷古一人而已。","book":"五代·王定保《唐摭言·以其人不称才试而后惊》"},"similar":["旷古绝伦","盖世无双"],"opposite":["比比皆是"],"usage":"作定语；指盖世无双"},{"id":24498,"word":"旷古未有","pinyin":"kuàng gǔ wèi yǒu","abbr":"kgwy","explanation":"旷古：自古以来所没有的。自古以来从来不曾有过。形容极为罕见。","source":{"text":"冒死效命之士反见屠戮，旷古未有此事。","book":"《北齐书·王纮传》"},"example":{"text":"臣受殿下隆礼深恩，～，虽肝脑涂地，不能补报。","book":"清·夏敬渠《野叟曝言》第八十八回"},"similar":["旷古未闻"],"opposite":["司空见惯"],"usage":"作谓语、定语；形容极为罕见"},{"id":24499,"word":"旷古未闻","pinyin":"kuàng gǔ wèi wéi","abbr":"kgww","explanation":"旷古：自古以来。自古以来没有听说过。","source":{"text":"人臣而代天子，旷世也所罕闻。","book":"《诗经·周颂·敬之》孔颖达疏"},"example":{"text":"吴江阙大尹接得南阳卫文书，拆开看时，深以为奇。此事～。","book":"明·冯梦龙《警世通言》卷三十四"},"similar":["前所未闻"],"opposite":["司空见惯"],"usage":"作谓语、宾语、定语；指自古以来没有听说过"},{"id":24500,"word":"旷古绝伦","pinyin":"kuàng gǔ jué lún","abbr":"kgjl","explanation":"旷古：古来所无；绝伦：超过同辈。空前未有，超出一般。","source":{"text":"彦深小心恭慎，旷古绝伦。","book":"《北史·赵彦深传》"},"example":{"text":"“二战”是一场～的世界大战。"},"similar":["空前绝后","绝无仅有"],"opposite":["世代相传"],"usage":"作定语；指盖世无双"},{"id":24501,"word":"旷大之度","pinyin":"kuàng dà zhī dù","abbr":"kdzd","explanation":"旷大：宽阔；度：度量。宏大宽阔的度量。","source":{"text":"加之旷大之度，励以公平之诚。","book":"《三国志·魏志·文帝丕传评》"}},{"id":24502,"word":"旷夫怨女","pinyin":"kuàng fū yuàn nǚ","abbr":"kfyn","explanation":"旷夫：大龄而未娶妻室的男子；怨女：大龄而未嫁人的女子。指年龄已大，尚未婚配的男女。","source":{"text":"内无怨女，外无旷夫。","book":"《孟子·梁惠王下》"},"example":{"text":"他两个正是～，相见如饿虎逢羊，苍蝇见血，那有工夫问名叙礼。","book":"明·冯梦龙《喻世明言》第二十三卷"},"similar":["痴男怨女","怨女旷夫"],"usage":"作宾语、定语；指大龄未婚的人"},{"id":24503,"word":"旷岁持久","pinyin":"kuàng suì chí jiǔ","abbr":"kscj","explanation":"岁：年。指相持很久，耽搁了很多时间。","source":{"text":"师徒之众寡不敌，然尚旷岁持久，师老费财。","book":"唐·陆贽《论两河及淮西利害状》"},"similar":["旷日持久","旷日经久"],"opposite":["转瞬之间","昙花一现"],"usage":"作谓语、宾语、定语；指长期拖延"},{"id":24504,"word":"旷心怡神","pinyin":"kuàng xīn yí shén","abbr":"kxys","explanation":"舒畅心胸，愉悦精神。","source":{"text":"得其片言只字，自令旷心怡神，非必商彝周鼎之为宝也。","book":"明·沈榜《宛署杂记·古墨斋》"},"similar":["心旷神怡","旷性怡情"],"opposite":["心烦意乱"],"usage":"作谓语、状语；用于人的心境"},{"id":24505,"word":"旷志怡神","pinyin":"kuàng zhì yí shén","abbr":"kzys","explanation":"旷：开阔；怡：愉快。心境开阔，精神愉快。","source":{"text":"有藏歌贮舞，流连光景者；有旷志怡神，浮游尘外者；有澄想遐观，运量宇宙，而游特其寄焉者。","book":"宋·周密《齐东野语·贾氏池园》"}},{"id":24506,"word":"旷性怡情","pinyin":"kuàng xìng yí qíng","abbr":"kxyq","explanation":"旷：开朗；怡：快乐。指心情开朗，精神愉快。","source":{"text":"贾妃挨次看姊妹们的题咏，写道是：旷性怡情（扁额）。","book":"清·曹雪芹《红楼梦》第十八回"},"similar":["旷心怡神","心旷神怡"],"opposite":["心烦意乱"],"usage":"作谓语、状语；用于人的心境"},{"id":24507,"word":"旷日引久","pinyin":"kuàng rì yǐn jiǔ","abbr":"kryj","explanation":"引：迁延。历时长久。","source":{"text":"旷日引久，士卒劳倦。","book":"《汉书·严助传》"},"example":{"text":"既除丧矣，而继以疾病，又念心之曲折，造次不足以自达，故～，而阙然不即叙感，实冀宽大仁明有以容而察之而已。","book":"宋·王安石《上富相公书》"},"similar":["旷日引月"],"usage":"作谓语、宾语；用于书面语"},{"id":24508,"word":"旷日引月","pinyin":"kuàng rì yǐn yuè","abbr":"kryy","explanation":"引：迁延。历时长久。同“旷日引久”。","source":{"text":"旷日引月，不闻进发之期。","book":"宋·朱熹《与黄枢密书》"},"similar":["旷日引久"],"usage":"作谓语、宾语；用于书面语"},{"id":24509,"word":"旷日弥久","pinyin":"kuàng rì mí jiǔ","abbr":"krmj","explanation":"旷：耽搁荒废。指时间拖得很久。","source":{"text":"太子丹曰：‘太傅这计，旷日弥久，心惛然，恐不能须臾。’","book":"《战国策·赵策三》"},"example":{"text":"恐～，民累愈深，上下交受其害。","book":"《清史稿·宣统皇帝纪》"},"similar":["旷日离久"],"usage":"作谓语、宾语；用于书面语"},{"id":24510,"word":"旷日持久","pinyin":"kuàng rì chí jiǔ","abbr":"krcj","explanation":"旷：荒废，耽误。荒废时间，拖得很久。","source":{"text":"今得强赵之兵，以杜燕将，旷日持久，数岁，令士大夫余子之力，尽于沟垒。","book":"《战国策·赵策四》"},"example":{"text":"这厮们死守不出，便要～。","book":"清·陈忱《水浒后传》第十八回"},"similar":["经年累月","长此以往","长年累月"],"opposite":["昙花一现","弹指之间","电光火石"],"usage":"作谓语、宾语、定语；指长期拖延","story":["战国时期，燕国把有勇有谋的荣封为高阳君，让他带兵攻打赵国。赵王听说后便与平原君赵胜商量，准备割三座城池给齐国以换取齐国大将安平君田单做赵国的大将。赵国大将马服君赵奢不服，坚持要打一场旷日持久的战争，赵王不允"]},{"id":24511,"word":"旷日离久","pinyin":"kuàng rì lí jiǔ","abbr":"krlj","explanation":"耗费时日，拖延很久。犹言旷日持久。","source":{"text":"夫旷日离久，而周泽既渥，深计而不疑，引争而不罪，则明割利害以致其功，直指是非以饰其身，以此相持，此说之成也。","book":"《韩非子·说难》"},"similar":["旷日弥久"],"usage":"作谓语、宾语；用于书面语"},{"id":24512,"word":"旷日积晷","pinyin":"kuàng rì jī guǐ","abbr":"krjg","explanation":"久经时日。","source":{"text":"若旷日积晷，则铅刀效于一割，驽马可致千里。故曰兵宁拙速，未睹巧之迟也。","book":"明·张居正《种莲子戊午稿序》"},"similar":["旷日持久","旷岁持久","旷日经久"],"usage":"作宾语、定语、状语；用于时间等"},{"id":24513,"word":"旷日累时","pinyin":"kuàng rì lěi shí","abbr":"krls","explanation":"累：积累。耗费时日，拖延很久。","source":{"text":"今世议者纷纷，至于旷日累时，不知所决者，盖由不考于礼，而率其私见也。","book":"宋·曾巩《为人后议》"},"usage":"作谓语；指拖延时间"},{"id":24514,"word":"旷日经久","pinyin":"kuàng rì jīng jiǔ","abbr":"krjj","explanation":"犹言旷日持久。","source":{"text":"自非天姿茂异，旷日经久，以所进业发闻于乡闾……则不可得而齿乎国学矣。","book":"唐·韩愈《省试学生代斋郎议》"},"similar":["旷日持久","旷岁持久","旷日积晷"],"usage":"作谓语、宾语、定语、状语；指长期拖延"},{"id":24515,"word":"旷日经年","pinyin":"kuàng rì jīng nián","abbr":"krjn","explanation":"久经时日。","source":{"text":"旷日经年，靡有毫厘之验，足以揆今。","book":"汉·班固《汉书·郊祀志下》"},"similar":["旷日持久"],"usage":"作谓语；指经历很久"},{"id":24516,"word":"旷日长久","pinyin":"kuàng rì cháng jiǔ","abbr":"krcj","explanation":"历时长久，久经时日。","source":{"text":"是以君子为国，观之上古，验之当世，参以人事，察盛衰之理，审权势之宜，去就有序，变化有时，故旷日长久而社稷安矣。","book":"汉·司马迁《史记·秦始皇本纪》"},"similar":["旷日持久"],"usage":"作谓语；指长久"},{"id":24517,"word":"旷绝一世","pinyin":"kuàng jué yī shì","abbr":"kjys","explanation":"当代没有能相比的。形容举世无双。","source":{"text":"奇服旷世，骨像应图。","book":"三国·魏·曹植《洛神赋》"}},{"id":24518,"word":"旷职偾事","pinyin":"kuàng zhí fèn shì","abbr":"kzfs","explanation":"偾事：把事情搞坏。不尽责守职，把事情搞坏。","source":{"text":"文武臣旷职偾事，虚糜廪禄者，宁可不黜。","book":"《明史·刘健传》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":24519,"word":"旷若发矇","pinyin":"kuàng ruò fā méng","abbr":"krfm","explanation":"旷：开朗；矇：眼睛失明。眼前突然开朗。比喻人头脑开窍，明达起来。","source":{"text":"闲者此游，喜欢无量，登芒济河，旷若发矇。","book":"三国·魏·应璩《与从弟君苗君胄书》"},"similar":["旷若发蒙"],"usage":"作谓语、定语；用于比喻句"},{"id":24520,"word":"旷若发蒙","pinyin":"kuàng ruò fā méng","abbr":"krfm","explanation":"旷：空旷；开阔。蒙：眼睛失明。眼前突然开阔明朗，好像双目失明的人忽然看见了东西。亦比喻使人头脑忽然开窍，明达起来。","source":{"text":"闲者此游，喜欢无量，登芒济河，旷若发蒙。","book":"三国·魏·应璩《与从弟君苗君胄书》"},"example":{"text":"忽奉手笔，～。","book":"宋·苏轼《与佛印禅师书》"},"similar":["旷若发矇"],"usage":"作谓语、定语；用于比喻句"},{"id":24521,"word":"旷达不羁","pinyin":"kuàng dá bù jī","abbr":"kdbj","explanation":"旷达：心胸开阔，想得开；不羁：不受束缚。心胸开阔达观，不受拘束。","source":{"text":"籍旷达不羁，不拘礼俗。","book":"《三国志·魏志·王卫二刘傅传》裴松之注引《魏氏春秋》"},"example":{"text":"贤弟弥郎，意识深远，～。","book":"《北史·崔晞传》"},"similar":["豁达不羁"],"usage":"作谓语、定语；用于书面语"},{"id":24522,"word":"旷邈无家","pinyin":"kuàng miǎo wú jiā","abbr":"kmwj","explanation":"旷：空阔；邈：遥远。远离故土，没有妻室。","source":{"text":"兄旷邈无家，我夙夜代筹久矣，行当为君谋一佳耦。","book":"清·蒲松龄《聊斋志异·娇娜》"},"usage":"作谓语、定语；用于书面语"},{"id":24523,"word":"昂头天外","pinyin":"áng tóu tiān wài","abbr":"attw","explanation":"昂：抬起。抬起头望着天边。形容态度傲慢或做事脱离实际。","source":{"text":"他们昂头天外，评论之后，不知那里去了。","book":"鲁迅《书信集·致萧军、萧红》"},"similar":["昂首天外"],"usage":"作谓语、定语；指人的态度"},{"id":24524,"word":"昂头挺胸","pinyin":"áng tóu tǐng xiōng","abbr":"attx","explanation":"抬起头，挺起胸膛。形容斗志高，士气旺。参见“昂首挺胸”。","source":{"text":"她伸开两手昂首挺胸，狂了似的往外跑。","book":"语出欧阳予情《小英姑娘》"},"example":{"text":"“你看！提到内战，就连妇人女子都反对啦……”～，老老师欣喜地叫出来。","book":"沙汀《范老老师》"},"similar":["昂首挺胸"],"usage":"作谓语、状语；指人的神态"},{"id":24525,"word":"昂头阔步","pinyin":"áng tóu kuò bù","abbr":"atkb","explanation":"昂：仰，高抬。抬起头迈开大步向前。形容精神备发或态度傲慢。参见“昂首阔步”。","source":{"text":"他们昂头阔步，带着一种藐视中国人不屑与中国人为伍的神气，总引起我心里的愤愤不平。","book":"方志敏《可爱的中国》"},"similar":["卬头阔步"],"opposite":["缩头缩脑"],"usage":"作谓语、定语；指人的精神"},{"id":24526,"word":"昂昂不动","pinyin":"áng áng bù dòng","abbr":"aabd","explanation":"昂昂：大模大样地。形容目中无人，十分傲慢的样子。","source":{"text":"见了旁人一礼，要还我一礼；见了员外，（他）昂昂不动，岂不是丢了一个揖？","book":"楚剧《葛麻》第一场"},"usage":"作谓语、定语；指人傲慢"},{"id":24527,"word":"昂昂之鹤","pinyin":"áng áng zhī hè","abbr":"aazh","explanation":"高于鸡群的鹤。比喻德行高洁的人。","source":{"text":"霸越平吴，扁舟五湖，昂昂之鹤，泛泛之凫，功成身退，辞荣避位。","book":"明·瞿佑《剪灯新话·龙堂灵会录》"}},{"id":24528,"word":"昂昂自若","pinyin":"áng áng zì roò","abbr":"aazr","explanation":"昂昂：气概昂扬，大模大样；自若：象平常一样。形容无所顾虑，从容自如。","source":{"text":"三士带剑立于殿下，昂昂自若。","book":"明·冯梦龙《古今小说·晏平仲二桃杀三士》"},"similar":["昂然自若"],"usage":"作谓语、定语；形容人的气度"},{"id":24529,"word":"昂然挺立","pinyin":"áng rán tǐng lì","abbr":"artl","explanation":"昂首挺胸地直立着。形容精神昂扬，无所畏惧的样子。"},{"id":24530,"word":"昂然直入","pinyin":"áng rán zhí rù","abbr":"arzr","explanation":"昂首挺胸地径直走进去。形容傲然威武的样子。","source":{"text":"何进昂然直入。","book":"明·罗贯中《三国演义》第三回"},"similar":["昂然而入"],"usage":"作谓语；指人的态度"},{"id":24531,"word":"昂然而入","pinyin":"áng rán ér rù","abbr":"arer","explanation":"仰头挺胸地走进来。形容态度傲慢。","source":{"text":"须臾，李恢昂然而入。","book":"明·罗贯中《三国演义》第65回"},"similar":["昂然直入"],"usage":"作谓语；指人的傲慢态度"},{"id":24532,"word":"昂然自得","pinyin":"áng rán zì dé","abbr":"arzd","explanation":"自得：自己感到舒适。指大模大样，满不在乎的样子。","source":{"text":"今乃不然，反昂然自得，了无愧畏。","book":"宋·欧阳修《与高司谏书》"}},{"id":24533,"word":"昂然自若","pinyin":"áng rán zì ruò","abbr":"arzr","explanation":"形容气宇轩昂满不在乎的样子。","source":{"text":"昂然自若，并不畏缩。","book":"蔡东藩《民国通俗演义》第31回"},"similar":["昂昂自若"],"usage":"作谓语、定语；指大模大样"},{"id":24534,"word":"昂藏七尺","pinyin":"áng cáng qī chǐ","abbr":"acqc","explanation":"昂藏：登记表雄伟、气度不凡的样子；七尺：七尺高的身躯。指轩昂伟岸的男子汉。","source":{"text":"月淡黄昏欲雪时，小窗犹欠岁寒枝。昂藏七尺无人处，唯有西湖处士知。","book":"宋·辛弃疾《和傅岩叟梅花》"},"example":{"text":"徒负～身，实只太仓一稊米。","book":"清·赵翼《放歌》"},"similar":["七尺之躯"],"usage":"作主语、定语；指高大的男人"},{"id":24535,"word":"昂霄耸壑","pinyin":"áng xiāo sǒng hè","abbr":"axsh","explanation":"昂：高；壑：峪。高出霄汉，耸立山壑。形容才能杰出，建树宏大功业。也形容志气高昂，胸怀广阔。","source":{"text":"古来豪杰少人知，昂霄耸壑宁自期。","book":"宋·陆游《剑南诗稿·凌霄花》卷三十四"},"example":{"text":"昔余识夫人之子稚年，固已得其～之气。","book":"宋·陈亮《祭叶正则母夫人文》"},"usage":"作谓语、定语；指人的气度与才能"},{"id":24536,"word":"昂首伸眉","pinyin":"áng shǒu shēn méi","abbr":"assm","explanation":"伸：扬。抬头扬眉。形容意气昂扬的样子。","source":{"text":"乃欲仰首伸眉，论列是非，不亦轻朝廷，羞当世之士耶！","book":"汉·司马迁《报任少卿书》"},"example":{"text":"他们获得了比赛的胜利，～地回来了。"},"similar":["卬首信眉"],"usage":"作谓语、定语；形容人精神状态"},{"id":24537,"word":"昂首天外","pinyin":"áng shǒu tiān wài","abbr":"astw","explanation":"抬起头望着天边。形容态度傲慢，或做事脱离实际。","source":{"text":"昂其首，睅其目，举觞而望青天者，是为王大痴。","book":"清·归庄《王大痴像赞》"},"example":{"text":"某些人做事不从实际出发，往往～。"},"similar":["昂头天外"],"usage":"作谓语、定语；指人的态度"},{"id":24538,"word":"昂首挺胸","pinyin":"áng shǒu tǐng xiōng","abbr":"astx","explanation":"抬起头，挺起胸膛。形容斗志高，士气旺。","source":{"text":"她伸开两手昂首挺胸，狂了似的往外跑。","book":"欧阳予情《小英姑娘》"},"example":{"text":"个个视死如归，坚贞不屈，～站在那里。王之燕同志领头高呼起口号。","book":"《上饶集中营·浩气长存》"},"similar":["昂首阔步"],"opposite":["低眉顺眼"],"usage":"作谓语、定语；用于人的精神状态"},{"id":24539,"word":"昂首望天","pinyin":"áng shǒu wàng tiān","abbr":"aswt","explanation":"仰起头，望着天。喻指眼光向上，作风浮泛，不肯放下架子、深入基层。","source":{"text":"昂其首，睅其目，举觞而望青天者，是为王大痴。","book":"清·归庄《王大痴像赞》"},"example":{"text":"要做这件事，第一是眼睛向下，不要只是～。","book":"毛泽东《〈农村调查〉的序言和跋》"},"similar":["昂然不见","气宇轩昂","自视甚高"],"opposite":["眼睛向下"],"usage":"作谓语、定语；比喻眼光向上而脱离群众"},{"id":24540,"word":"昂首阔步","pinyin":"áng shǒu kuò bù","abbr":"askb","explanation":"昂：仰，高抬。抬起头迈开大步向前。形容精神抖擞，意气风发。","source":{"text":"惟有昂首阔步，独往独来，何待他人之援手。","book":"李大钊《青春》"},"example":{"text":"他还是～，爱理不理。","book":"司马文森《风雨桐江》"},"similar":["高视阔步","昂首挺胸"],"opposite":["低头碎步","畏缩不前","垂头丧气"],"usage":"作谓语、状语、定语；形容人的精神振奋"},{"id":24541,"word":"昃食宵衣","pinyin":"zè shí xiāo yī","abbr":"zsxy","explanation":"入夜才吃晚饭，天不亮就穿衣起床。指勤于政务。","source":{"text":"勤民听政，昃食宵衣。","book":"南朝陈徐陵《陈文皇帝哀册文》"},"similar":["宵衣旰食"],"usage":"作谓语、定语；用于书面语"},{"id":24542,"word":"昆仑之球琳","pinyin":"kūn lún zhī qiú lín","abbr":"klzql","explanation":"球琳：美玉。昆仑山上的美玉。比喻极为珍贵的物品。","source":{"text":"西北方之美者，有昆仑之球琳、琅玕焉。","book":"西汉·刘安《淮南子·坠形训》"},"similar":["昆山之玉"],"usage":"作宾语；用于比喻句"},{"id":24543,"word":"昆仑失火，玉石俱焚","pinyin":"kūn lún shī huǒ，yù shí jù fén","abbr":"klshysjf","explanation":"昆仑山失火，将玉和石头一起烧掉。比喻不分好坏，同归于尽。","source":{"text":"火焱昆冈，玉石俱焚。","book":"《尚书·胤征》"}},{"id":24544,"word":"昆冈之火","pinyin":"kūn gāng zhī huǒ","abbr":"kgzh","explanation":"昆仑山失火，将玉和石头一起烧掉。比喻不分好坏，同归于尽。","source":{"text":"及残寇乘之，倒山倾海，昆冈之火，自兹自焚，版荡之篇，于焉而极。","book":"《尚书·胤征》：“火焱昆冈，玉石俱焚。”《后汉书·董卓传》"}},{"id":24545,"word":"昆山之下，以玉抵鸟","pinyin":"kūn shān zhī xià，yǐ yù dǐ niǎo","abbr":"kszxyydn","explanation":"昆山：昆仑山；抵：抵挡，投击。昆仑山下的人，用玉石投击鸟。形容尽管是的东西，但多了就不足为奇了。","source":{"text":"昆山之下，以玉抵鸟；彭蠡之滨，以鱼食犬。","book":"汉·桓谭《新论·辩施》"}},{"id":24546,"word":"昆山之玉","pinyin":"kūn shān zhī yù","abbr":"kszy","explanation":"昆山：昆仑山。昆仑山的美玉。比喻杰出的人才。","source":{"text":"今陛下致昆山之玉，有随和之宝。","book":"秦·李斯《上书秦始皇》"},"example":{"text":"～，邓林之大木，生非不材也。","book":"清·曾国藩《郭璧斋先生六十寿序》"},"similar":["昆山片玉","昆仑之球琳"],"usage":"作宾语；用于比喻句"},{"id":24547,"word":"昆山片玉","pinyin":"kūn shān piàn yù","abbr":"kspy","explanation":"昆仑山上的一块玉。原是一种谦虚的说法，意思是只是许多美好者当中的一个，后比喻许多美好事物中突出的。","source":{"text":"臣举贤良对策，为天下第一，犹桂林之一枝，昆山之片玉。","book":"《晋书·郤诜传》"},"example":{"text":"五行相配，真如桂林一枝，～。","book":"清·无名氏《玉娇梨》第二回"},"similar":["奇珍异宝"],"usage":"作宾语、定语；比喻珍贵稀有之物","story":["晋朝时期，晋武帝在各地大肆选拔人才，郤诜被选中，后来升为雍州刺史。武帝在东堂巡游时接见了郤诜，问他自己感觉如何。郤诜回答说：“臣举贤良对策，为天下第一，犹桂林之一枝，昆山之片玉。”"]},{"id":24548,"word":"昆弟之好","pinyin":"kūn dì zhī hǎo","abbr":"kdzh","explanation":"昆：哥哥。像兄弟一样要好。","source":{"text":"今秦楚嫁女娶妇，结昆弟之好，三晋莫不悚惧，争献地以事秦。","book":"明·冯梦龙《东周列国志》第九十二回"},"example":{"text":"今秦、楚嫁女娶妇，结～。","book":"清·杨景淐《鬼谷四友志》卷三"},"similar":["兄弟之好"],"usage":"作宾语；指像兄弟一样要好"},{"id":24549,"word":"昊天不吊","pinyin":"hào tiān bù diào","abbr":"htbd","explanation":"指苍天不怜悯保佑。后以之为哀悼死者之辞。","source":{"text":"吊，愍。","book":"语出《诗·小雅·节南山》：“不吊昊天，不宜空我师”。朱熹集传"},"example":{"text":"九族咸育于仁，四海仰遵其化。～，景命靡融。","book":"《元史·后妃传一·庄懿慈圣皇后》"},"usage":"作宾语、分句；多作为哀悼之辞"},{"id":24550,"word":"昊天罔极","pinyin":"hào tiān wǎng jí","abbr":"htwj","explanation":"原指天空广大无边，后比喻父母的恩德极大。","source":{"text":"欲报之德，昊天罔极。","book":"《诗经·小雅·蓼莪》"},"example":{"text":"亏得祖父抚养成人，以有今日！这～之恩，无从补报万一，思之真是令人愧恨欲死！","book":"清·吴趼人《二十年目睹之怪现状》第七十四回"},"similar":["无边无际","茫茫无际","恩重如山"],"usage":"作谓语；比喻父母的恩德极大"},{"id":24551,"word":"昌亭之客","pinyin":"cháng tíng zhī kè","abbr":"ctzk","explanation":"下乡（属江苏省淮阴市）南昌亭长的食客。原指汉淮阴侯韩信。后以借指怀才未遇而暂寄人篱下者。","source":{"text":"韩信，淮阴人。家贫无行，不得推择为吏……从下乡南昌亭长食。","book":"《汉书·韩信传》"},"example":{"text":"若使恩裁口腹，空留安邑之宾；惠阙始终，取恨～。","book":"唐·王勃《为人与蜀城父老第二书》"},"usage":"作宾语；指寄人篱下的人"},{"id":24552,"word":"昌亭旅食","pinyin":"cháng tíng lǚ shí","abbr":"ctls","explanation":"寄食南昌亭长处。借指寄人篱下。","source":{"text":"下驿穷交日，昌亭旅食年。","book":"唐·王勃《白下驿饯别唐少府》诗"},"similar":["寄人篱下"],"usage":"作宾语；指寄人篱下"},{"id":24553,"word":"昌歜羊枣","pinyin":"chāng chù yáng zǎo","abbr":"ccyz","explanation":"据传周文王嗜昌歜，春秋鲁曾点嗜羊枣。后用以指人所偏好之物。","source":{"text":"不肖为人所憎，而二子独喜见誉，如人嗜昌歜羊枣，未易诘其所以然者。","book":"宋·苏轼《答李端淑书》"},"example":{"text":"三子皆鸿生硕彦，目无古今，乃～，异代同心，何哉？","book":"明·胡应麟《少室山房笔丛·九流绪论》"},"similar":["羊枣昌歜"],"usage":"作宾语、定语；用于个人所好"},{"id":24554,"word":"昌言无忌","pinyin":"chāng yán wú jì","abbr":"cywj","explanation":"昌言：原指善言，引伸为直言。敢于直言，无所顾忌。","source":{"text":"昌言无忌，希赐裁答。","book":"清·汪琬《答李举人论以史证经书》"},"example":{"text":"主张变更国体，～。","book":"蔡东藩《民国通俗演义》第45回"},"similar":["直言不讳"],"usage":"作宾语；指敢于直言"},{"id":24555,"word":"明争暗斗","pinyin":"míng zhēng àn dòu","abbr":"mzad","explanation":"明里暗里都在进行争斗。形容各用心思，互相排挤。","source":{"text":"于是两方明争暗斗，各不相让，一天利害一天，闹成所谓‘府院之争’。","book":"冯玉祥《我的生活》"},"example":{"text":"明明是一家人，然而没有一天不在～，其实不过是争点家产。","book":"巴金《家》三"},"similar":["明枪暗箭","尔虞我诈","钩心斗角"],"opposite":["肝胆相照","同心协力"],"usage":"作谓语、宾语、定语；指内部争斗"},{"id":24556,"word":"明于治乱","pinyin":"míng yú zhì luàn","abbr":"myzl","explanation":"明晓国家治乱的道理。","source":{"text":"博闻彊志，明于治乱，娴于辞令。","book":"西汉·司马迁《史记·屈原贾生列传》"},"usage":"作谓语；指明晓国家治乱的道理"},{"id":24557,"word":"明人不作暗事","pinyin":"míng rén bù zuò àn shì","abbr":"mrbzas","explanation":"心地光明的人不做偷偷摸摸的事。","source":{"text":"这伙计既到上海之后，心想不要把他冒冒失失的一告，他其中怕别有因由。而且明人不作暗事。","book":"清·吴趼人《二十年目睹之怪现状》第29回"},"example":{"text":"清·石玉昆《小五义》第45回：“我～，我是用薰香把你薰过去了。”"},"similar":["明人不做暗事"],"usage":"作宾语、定语；指为人的准则"},{"id":24558,"word":"明人不做暗事","pinyin":"míng rén bù zuò àn shì","abbr":"mrbzas","explanation":"心地光明的人不做偷偷摸摸的事。","source":{"text":"常言道：'明人不做那暗事'，则俺这闭月羞花绝代姿，到如今自做出自当之，妆甚的谎子！","book":"元·吴昌龄《张天师》第三折"},"example":{"text":"～，您这样叫我们小孩子瞧着也不好！","book":"冰心《冬儿姑娘》"},"similar":["光明正大","明人不作暗事"],"opposite":["暗室欺心"],"usage":"作分句、宾语；指为人的准则"},{"id":24559,"word":"明人不说暗话","pinyin":"míng rén bù shuō àn huà","abbr":"mrbsah","explanation":"明：光明正大。光明正大的人说实在话，不转弯抹角。","source":{"text":"明人不说暗话，雪岩的靠山是王抚台，如今已不在人世。","book":"高阳《胡雪岩全传·红顶商人》"},"usage":"作宾语、定语；用于口语"},{"id":24560,"word":"明信公子","pinyin":"míng xìn gōng zǐ","abbr":"mxgz","explanation":"印章的别名。","source":{"text":"名篆，字少章，号明信公子。","book":"清·厉荃《事物异名录·文具·图章》"}},{"id":24561,"word":"明修暗度","pinyin":"míng xiū àn dù","abbr":"mxad","explanation":"比喻用明显的假象迷惑对方，而暗中却采取出人意料的行动打击对方。","source":{"text":"伺隙忽为叠陈冲，捣虚又遏夹寨固。明修暗度诡道攻，声东击西多方误。","book":"清·赵翼《行围即景·相扑》"},"similar":["明修栈道，暗度陈仓"],"usage":"作宾语、定语；用于战争、商业等方面"},{"id":24562,"word":"明修栈道，暗度陈仓","pinyin":"míng xiū zhàn dào，àn dù chén cāng","abbr":"mxzdadcc","explanation":"指刘邦将从汉中出兵攻项羽时，故意明修栈道，迷惑对方，暗中绕道奔袭陈仓，取得胜利。陈仓，古县名，在今陕西省宝鸡市东。","source":{"text":"孤家用韩信之计，明修栈道，暗度陈仓，攻完三秦，劫取五国。","book":"元·尚仲贤《气英布》第一折"},"example":{"text":"莫非他心里有这段姻缘，自己不好开口，却‘～’，先说定了我的事。","book":"清·文康《儿女英雄传》第九回"},"similar":["明争暗斗"],"usage":"作宾语、定语、分句；用于战争、商业等方面","story":["秦末项羽灭了秦以后，自封西楚霸王，背叛谁先攻入咸阳的人为王的约定，刘邦极为不满，领兵进入四川，沿途烧了巴蜀的栈道，封为汉王，刘邦得到韩信的帮助，明里在修栈道，背地绕道轻取项羽的大将章邯，进而取得中原为王"]},{"id":24563,"word":"明修栈道，暗渡陈仓","pinyin":"míng xiū zhàn dào，àn dù chén cāng","abbr":"mxzdadcc","explanation":"比喻用一种假象迷惑对方，实际上却另有打算。","source":{"text":"着樊哙明修栈道，俺可暗度陈仓古道。这楚兵不知是智，必然排兵在栈道守把。俺往陈仓古道抄截，杀他个措手不及也。","book":"元·无名氏《暗度陈仓》第二折"},"example":{"text":"孤家用韩信之计，明修栈道，～，攻定三秦，动取五国。","book":"元·无名氏《气英布》第一折"},"similar":["明修栈道，暗度陈仓"],"usage":"作宾语、定语、分句；用于战争、商业等方面"},{"id":24564,"word":"明光烁亮","pinyin":"míng guāng shuò liàng","abbr":"mgsl","explanation":"指光亮耀眼。","source":{"text":"牛小水他们往他俩身上一搜，马上把那两卷票子，两个宝石戒指，一条明光烁亮的金链子搜了出来。","book":"孔厥《新儿女英雄传》第七回"},"similar":["明光锃亮","明光铮亮"],"opposite":["暗淡无光"],"usage":"作谓语、定语；用于物体等"},{"id":24565,"word":"明光铮亮","pinyin":"míng guāng zhēng liàng","abbr":"mgzl","explanation":"指光亮耀眼。同“明光烁亮”。","source":{"text":"窗户上的大玻璃明光铮亮。","book":"西虹《家》"},"similar":["明光锃亮","明光烁亮"],"opposite":["暗淡无光"],"usage":"作谓语、定语；用于物体等"},{"id":24566,"word":"明光锃亮","pinyin":"míng guāng zèng liàng","abbr":"mgzl","explanation":"指光亮耀眼。同“明光烁亮”。","source":{"text":"又站在一旁端详一会儿，确信自行车已经明光锃亮，纤尘不染，才古怪地嘘了一口长气。","book":"《新华文摘》1983年第3期"},"similar":["明光烁亮","明光铮亮"],"opposite":["暗淡无光"],"usage":"作谓语、定语；用于物体等"},{"id":24567,"word":"明公正义","pinyin":"míng gōng zhèng yì","abbr":"mgzy","explanation":"犹言正式；公开；堂堂正正。同“明公正气”。","source":{"text":"若遇着买花儿东西，明公正义问他要。","book":"明·兰陵笑笑生《金瓶梅词话》第77回"},"similar":["明公正气"],"usage":"作定语、状语；用于口语"},{"id":24568,"word":"明公正气","pinyin":"míng gōng zhèng qì","abbr":"mgzq","explanation":"犹言正式；公开；堂堂正正。","source":{"text":"此女不但才高，而词意甚正，要我明公正气去求亲，而不要私相挑引。","book":"明·无名氏《人中画· 风流配》二"},"example":{"text":"这会儿，鬼使神差，活该败露！爽性～的把簪儿拿出手来。","book":"清·曾朴《孽海花》第五回"},"similar":["明公正道","明公正义"],"usage":"作定语、状语；用于口语"},{"id":24569,"word":"明公正道","pinyin":"míng gōng zhèng dào","abbr":"mgzd","explanation":"犹言正式；公开；堂堂正正。同“明公正气”。","source":{"text":"此女不但才高，而词意甚正，要我明公正气去求亲，而不要私相挑引。","book":"明·无名氏《人中画· 风流配》二"},"example":{"text":"～的，连个姑娘还没挣上去呢，也不过和我似的，那里就称起“我们”来了。","book":"清·曹雪芹《红楼梦》第三十一回"},"similar":["明公正气"],"usage":"作定语、状语；用于口语","story":["端阳节贾府自然大摆筵席，筵席散后，贾宝玉去找林黛玉，黛玉只是闷闷不乐不理他，晴雯上来给宝玉换衣服，不幸把扇子掉地损坏，宝玉气得骂她顾前不顾后。晴雯毫不示弱与他顶嘴，袭人忙上来解围，晴雯则说袭人明公正道连个姑娘还没挣上去"]},{"id":24570,"word":"明刑不戮","pinyin":"míng xíng bù lù","abbr":"mxbl","explanation":"指刑罚严明，人民就很少犯法而被杀。","source":{"text":"故禁奸止过，莫若重刑；刑重而必得，则民不敢试，故国无刑民。国无刑民，故曰：‘明刑不戮。’","book":"《商君书·赏刑》"},"usage":"作宾语、定语；指刑罚严明"},{"id":24571,"word":"明刑弼教","pinyin":"míng xíng bì jiào","abbr":"mxbj","explanation":"弼：辅助。用刑法晓喻人民，使人们都知法、畏法而守法，以达到教化所不能收到的效果。","source":{"text":"明于五刑，以弼五教，期于予治。","book":"《尚书·大禹漠》"},"example":{"text":"～，道尊老氏。","book":"唐·张说《起义堂颂》"},"usage":"作谓语；用于治理国家"},{"id":24572,"word":"明升暗降","pinyin":"míng shēng àn jiàng","abbr":"msaj","explanation":"指表面上升官，而实际上被削去权力。","source":{"text":"就是再添一千个都老爷，也抵不上两个监督、一个织造的好：这叫做‘明升暗降’。","book":"清·李宝嘉《官场现形记》第36回"},"example":{"text":"明眼人可以看出你这是～的把戏。"},"usage":"作宾语、定语；用于官场"},{"id":24573,"word":"明参日月","pinyin":"míng cān rì yuè","abbr":"mcry","explanation":"光辉灿烂可以与日月相比拟。旧时多用于称颂圣贤、帝王。","source":{"text":"天子者，与天地参，故德配天地，兼利万物，与日月并明，明照四海而不遗微小。","book":"《礼记·经解》"},"example":{"text":"岩岩孔圣，异世称杰，量合乾坤，～。","book":"汉·张超《尼父颂》"}},{"id":24574,"word":"明发不寐","pinyin":"míng fā bù mèi","abbr":"mfbm","explanation":"明发：破晓，天色发亮；寐：昨。通宵未睡。","source":{"text":"明发不寐，有怀二人。","book":"《诗经·小雅·小宛》"},"example":{"text":"伏愿淑慎威仪，万邦作式，躬致郊庙之虔，亲纡朔望之礼，释奠成均，竭心千亩，～，洁诚禋稞。","book":"《魏书·张普惠传》"},"usage":"作谓语、定语；用于书面语"},{"id":24575,"word":"明哲保身","pinyin":"míng zhé bǎo shēn","abbr":"mzbs","explanation":"明智的人善于保全自己。现指因怕连累自己而回避原则斗争的处世态度。","source":{"text":"既明且哲，以保其身，夙夜匪懈，以事一人。","book":"《诗·大雅·烝民》"},"example":{"text":"高节更只能造就一些～的自了汉，甚至于一些虚无主义者。","book":"朱自清《论气节》"},"similar":["洁身自好"],"opposite":["同流合污"],"usage":"作谓语、定语；指不管闲事","story":["周朝时，宣王重视任用德才兼备的人，因此他的王朝得到振兴。当外族不断入侵时，周宣王派大臣仲山甫到齐地建筑城池。大臣尹吉甫写诗赞美仲山甫：“既明且哲，以保其身，夙夜匪解，以事一人。”赞扬仲山甫不辞辛劳"]},{"id":24576,"word":"明堂正道","pinyin":"míng táng zhèng dào","abbr":"mtzd","explanation":"犹言正式；公开；堂堂正正。同“明公正气”。","source":{"text":"温柔安静，差不多的主子姑娘还跟不上他，才摆酒请客的费事，明堂正道的给他做了屋里人。","book":"清·曹雪芹《红楼梦》第16回"},"similar":["光明正大","明公正道"],"usage":"作宾语、定语、状语；用于口语"},{"id":24577,"word":"明如指掌","pinyin":"míng rú zhǐ zhǎng","abbr":"mrzz","explanation":"形容对情况非常清楚，好像指着自己的手掌给人看。","source":{"text":"予于《聊斋》，钩清段明，明如指掌。","book":"清·冯镇峦《读杂说》"},"example":{"text":"况汉口有极大市街，依托掩护，逸以待劳，持久之力，～。","book":"杨玉如《辛亥革命先著记》第六章第二节"},"usage":"作谓语、定语；用于书面语"},{"id":24578,"word":"明婚正娶","pinyin":"míng hūn zhèng qǔ","abbr":"mhzq","explanation":"指经过正式手续的婚姻，现指符合婚姻法规定的合法婚姻。","source":{"text":"那里是明婚正娶，公然的伤风败俗。","book":"元·关汉卿《救风尘》第四折"},"example":{"text":"那曹家女子，或者说是～，又且结发在先。","book":"清·李渔《凰求凤·作难》"},"similar":["明婚正配","明媒正娶"],"usage":"作谓语、宾语；指合法婚姻"},{"id":24579,"word":"明婚正配","pinyin":"míng hūn zhèng pèi","abbr":"mhzp","explanation":"指经过正式手续的婚姻，现指符合婚姻法规定的合法婚姻。","source":{"text":"你小姐元是我崔文远明婚正配许与侄儿崔通的。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"后来虽然做了亲，元不是～。","book":"明·冯梦龙《二刻拍案惊奇》第11卷"},"similar":["明婚正娶"],"opposite":["私订终身"],"usage":"作谓语、宾语；指合法婚姻"},{"id":24580,"word":"明媒正娶","pinyin":"míng méi zhèng qǔ","abbr":"mmzq","explanation":"明、正：形容正大光明。旧指正式婚姻。","source":{"text":"现放着保亲的堪为凭据，怎当他抢亲的百计亏图；那里是明媒正娶，公然的伤风败俗。","book":"元·关汉卿《救风尘》第四折"},"example":{"text":"这平氏到是～，又且平氏年长一岁，让平氏为正房，王氏反做偏房，两个姐妹相称。","book":"明·冯梦龙《古今小说》卷一"},"similar":["明媒正礼"],"opposite":["私订终身"],"usage":"作宾语、定语；指正式婚姻"},{"id":24581,"word":"明媒正礼","pinyin":"míng méi zhèng lǐ","abbr":"mmzl","explanation":"犹言明媒正娶。旧指正式婚姻。","source":{"text":"老爷老奶奶明媒正礼与大爷娶的正头妻，上边放着老爷老奶奶，谁敢休？","book":"清·西周生《醒世姻缘传》第九回"},"similar":["明媒正娶"],"usage":"作宾语、定语；指正式婚姻"},{"id":24582,"word":"明察暗访","pinyin":"míng chá àn fǎng","abbr":"mcaf","explanation":"察：仔细看，调查研究；访：向人询问调查。从明里细心察看，从暗里询问了解。指用各种方法进行调查研究。","source":{"text":"我住在此处，徒占一席，于事无济，倒不如仍然到外面去，明察暗访。","book":"清·吴趼人《痛史》第十一回"},"example":{"text":"丈夫的品行也丢了，她的名声也丢了，她还在那里贼去关门，～。","book":"清·文康《儿女英雄传》第二十七回"},"similar":["明察秋毫","明查暗访"],"opposite":["不见薪新"],"usage":"作谓语、定语；用于颂扬"},{"id":24583,"word":"明察秋毫","pinyin":"míng chá qiū háo","abbr":"mcqh","explanation":"明察：看清；秋毫：秋天鸟兽身上新长的细毛。原形容人目光敏锐，任何细小的事物都能看得很清楚。后多形容人能洞察事理。","source":{"text":"明足以察秋毫之末，而不见舆薪，则王许之乎？","book":"《孟子·梁惠王上》"},"example":{"text":"余忆童稚时，能张目对日，～，见藐小微物，必细察其纹理。","book":"清·沈复《浮生六记·闲情记趣》"},"similar":["洞若观火","明查暗访"],"opposite":["不见舆薪"],"usage":"作谓语、定语；指人的洞察力","story":["战国时期，齐宣王田辟想学齐桓公那样做霸主，他向孟子请教如何才能做上霸王。孟子告诉他要用仁义道德的力量统一天下，同时要对国情明察秋毫，体察民情，现在是能干不能干的事情，而是您愿干不愿干的事情"]},{"id":24584,"word":"明察秋毫之末，而不见舆薪","pinyin":"míng chá qiū háo zhī mò，ér bù jiàn yú xīn","abbr":"mcqhzmebjyx","explanation":"眼力能看到一根毫毛的末梢，而看不到一车柴草。比喻只看到小处，看不到大处。","source":{"text":"明足以察秋毫之末，而不见舆薪，则王许之乎？","book":"《孟子·梁惠王上》"}},{"id":24585,"word":"明察秋毫，不见舆薪","pinyin":"míng chá qiū háo，bù jiàn yú xīn","abbr":"mcqhbjyx","explanation":"目光敏锐，可以看清鸟兽的毫毛，而看不到一车柴草。比喻为人精明，只看到小节，看不到大处。","source":{"text":"明足以察秋毫之末，而不见舆薪，则王许之乎？","book":"先秦·孟轲《孟子·梁惠王上》"},"usage":"作分句；指人眼光短浅"},{"id":24586,"word":"明尚夙达","pinyin":"míng shàng sù dá","abbr":"mssd","explanation":"夙：早；达：对事理了解透彻。明智的人贵在事先估计事物发展的趋势。","source":{"text":"夫智贵免祸，明尚夙达，仆揆汉中王虑定于内，疑生于外矣。","book":"《三国志·蜀志·刘封传》"}},{"id":24587,"word":"明并日月","pinyin":"míng bìng rì yuè","abbr":"mbry","explanation":"并：齐。光辉灿烂可以与日月相比拟。旧时多用于称颂圣贤、帝王。","source":{"text":"天子者，与天地参，故德配天地，兼利万物，与日月并明，明照四海而不遗微小。","book":"《礼记·经解》"},"example":{"text":"陛下～，无幽不烛；深谋远虑，出自胸怀。","book":"晋·刘琨《对进表》"},"usage":"作谓语、定语；用于称颂君王等"},{"id":24588,"word":"明廉暗察","pinyin":"míng lián àn chá","abbr":"mlac","explanation":"犹言明察暗访。指用各种方法进行调查研究。","source":{"text":"正不怕明廉暗察，信不让于春秋里季札，治不让颖川黄霸。","book":"金·董解元《西厢记诸宫调》第八卷"},"similar":["明访暗察"],"usage":"作谓语、宾语、定语；用于调查"},{"id":24589,"word":"明弃暗取","pinyin":"míng qì àn qǔ","abbr":"mqaq","explanation":"表面上推辞放弃而暗中偷偷拿取。","source":{"text":"明弃暗取攘窃蒙赃，外亲内疏图谋挟质。","book":"清·韩邦庆《海上花列传》四十九回"}},{"id":24590,"word":"明德惟馨","pinyin":"míng dé wéi xīn","abbr":"mdwx","explanation":"明德：美德；惟：是；馨：散发的香气。真正能够发出香气的是美德。","source":{"text":"至治馨香，感于神明。黍稷非馨，明德惟馨。","book":"《尚书·君陈》"},"example":{"text":"知几其神乎！古人以为难。交疏吐诚，今人以为难。今君一面尽二难之道，可谓～。","book":"南朝宋·刘义庆《世说新语·规箴》"},"usage":"作谓语、宾语；指人的德行"},{"id":24591,"word":"明德慎罚","pinyin":"míng dé shèn fá","abbr":"mdsf","explanation":"慎：谨慎。多行恩惠，少用刑罚。","source":{"text":"惟乃丕显考文王，克明德慎罚。","book":"《尚书·康诰》"},"example":{"text":"《书》云：～。方春东作，育微敬始。其敕有司，罪非殊死，且勿案验，以崇其宽。","book":"《后汉书·质帝纪》"},"usage":"作宾语、定语；用于施政"},{"id":24592,"word":"明心见性","pinyin":"míng xīn jiàn xìng","abbr":"mxjx","explanation":"指摒弃世俗的一切意识，大彻大悟，显现人的本性。","source":{"text":"仁宗天性慈孝，聪明恭俭，通达儒术，妙语释典，尝曰：‘明心见性，佛教为深；修身治国，儒道为切。’","book":"《元史·仁宗纪三》"},"example":{"text":"他说了半天，并没个～之谈，不过说些什么“文章经济”。","book":"清·曹雪芹《红楼梦》第一百十五回"},"usage":"作谓语、定语；用于书面语"},{"id":24593,"word":"明打明敲","pinyin":"míng dǎ míng qiāo","abbr":"mdmq","explanation":"指人说话直接与做事率直。","example":{"text":"我就喜欢～地说话。"},"similar":["明敲明打"],"usage":"作状语、宾语、定语；指人说话与做事"},{"id":24594,"word":"明扬仄陋","pinyin":"míng yáng zè lòu","abbr":"myzl","explanation":"明察荐举出身微贱而德才兼备的人。同“明扬侧陋”。","source":{"text":"二三子其佐我明扬仄陋，唯才是举，吾得而用之。","book":"三国·魏·曹操《求贤令》"},"example":{"text":"故宜～，登庸贤隽使筑有冲天之举，渭滨无垂竿之逸。","book":"《晋书·桓彝传》"},"similar":["明扬侧陋"],"usage":"作谓语；指明察举荐并重用出身寒微的贤人"},{"id":24595,"word":"明扬侧陋","pinyin":"míng yáng cè lòu","abbr":"mycl","explanation":"侧陋：之地位低下而才德兼备的贤人。明察荐举出身微贱而德才兼备的人。","source":{"text":"明明，扬侧陋。","book":"《尚书·尧典》"},"example":{"text":"～，简能而任，是许多怀才不遇之人期盼的人生际遇。"},"similar":["明扬仄陋"],"usage":"作谓语；指明察举荐并重用出身寒微的贤人"},{"id":24596,"word":"明抢暗偷","pinyin":"míng qiǎng àn tōu","abbr":"mqat","explanation":"公开抢劫，暗中偷盗。","source":{"text":"最使她痛恨的是，有些坏人滥伐森林，把木材明抢暗偷运出山去贩卖。","book":"碧野《大巴山人》"},"example":{"text":"我们坚决打击那些～的盗猎分子。"},"usage":"作谓语、定语、宾语；指干坏事"},{"id":24597,"word":"明推暗就","pinyin":"míng tuī àn jiù","abbr":"mtaj","explanation":"表面上推拒，暗地里接受。形容装腔作势、假意拒绝的样子。","source":{"text":"那老婆子走来央求我，被我故意作难，说了几句明推暗就的话，少不得我前脚走到，他后脚自会赶来。","book":"清·李渔《慎鸾交·债饵》"},"example":{"text":"他～地接受了贿赂。"},"similar":["半推半就"],"usage":"作定语、状语；指假意拒绝的样子"},{"id":24598,"word":"明效大验","pinyin":"míng xiào dà yà","abbr":"mxdy","explanation":"效、验：效果。显著而又巨大的效验。","source":{"text":"是非其明效大验邪？","book":"《汉书·贾谊传》"},"example":{"text":"六年三月，逆贼复陷扬州，终不敢越湾头、万福桥一步，是未堵各坝足以扼贼之～。","book":"《清史稿·郭沛霖传》"},"similar":["明验大效"],"usage":"作宾语、定语；指显著而又巨大的效验"},{"id":24599,"word":"明教不变","pinyin":"míng jiào bù biàn","abbr":"mjbb","explanation":"教令明确，让老百姓有所适从，便不会发生变乱。","source":{"text":"夫明赏不费，明刑不戮，明教不变，而民知于民务，国无异俗。","book":"《商君书·赏刑》"},"usage":"作宾语、定语；用于书面语"},{"id":24600,"word":"明敲明打","pinyin":"míng qiāo míng dǎ","abbr":"mqmd","explanation":"指人说话直接与做事率直，不搞背后动作。","example":{"text":"我喜欢～的做法。"},"similar":["明打明敲"],"usage":"作状语、宾语、定语；指人说话与做事"},{"id":24601,"word":"明日黄花","pinyin":"míng rì huáng huā","abbr":"mrhh","explanation":"黄花：菊花。原指重阳节过后逐渐萎谢的菊花。后多比喻过时的事物或消息。","source":{"text":"相逢不用忙归去，明日黄花蝶也愁。","book":"宋·苏轼《九日次韵王巩》诗"},"example":{"text":"过时之物，曰～。","book":"宋·胡继宗《书言故事·花木类》"},"usage":"作宾语；比喻迟暮不遇"},{"id":24602,"word":"明明庙谟","pinyin":"míng míng miào mò","abbr":"mmmm","explanation":"谟：计策；庙谟：朝廷的谋略。非常明显的国家大计。","source":{"text":"明明庙谟，纠纠雄断。","book":"《后汉书·光武帝赞》"}},{"id":24603,"word":"明明白白","pinyin":"míng míng bái bái","abbr":"mmbb","explanation":"清清楚楚，明确无误；正大光明。","source":{"text":"账目已明明白白，并无分文来去。","book":"明·施耐庵《水浒传》第45回"},"example":{"text":"但须不设暗计，～，有手段平空拿我，吾即拜降。","book":"《杨家将演义》第13回"},"similar":["清清楚楚","清清白白"],"opposite":["糊里糊涂"],"usage":"作谓语、定语、状语；指十分清楚"},{"id":24604,"word":"明明赫赫","pinyin":"míng míng hè hè","abbr":"mmhh","explanation":"形容光亮夺目，声势显赫。","source":{"text":"明明在下，赫赫在上。","book":"《诗经·大雅·大明》"},"example":{"text":"天上之日月风雷、雨雪寒暑，～，不可胜述矣。","book":"《太平天国·军次实录》"},"opposite":["暗淡无光"],"usage":"作谓语、定语；指声势显赫"},{"id":24605,"word":"明昭昏蒙","pinyin":"míng zhāo hūn méng","abbr":"mzhm","explanation":"昭：明白；蒙：愚昧无知。聪明而通晓事理，愚昧而不明事理。","source":{"text":"众万之生，谁非天邪？明昭昏蒙，谁使然邪？","book":"唐·韩愈《独孤申叔哀辞》"}},{"id":24606,"word":"明月不常圆","pinyin":"míng yuè bù cháng yuán","abbr":"mybcy","explanation":"比喻人生不能事事完美无缺。","source":{"text":"明月不常圆，彩云容易散，乐极生悲，否极泰来，自然之理。","book":"明·兰陵笑笑生《金瓶梅词话》第七十八回"}},{"id":24607,"word":"明月与砾同囊","pinyin":"míng yuè yǔ lì tóng náng","abbr":"myyltn","explanation":"明月：明月珠，夜光珠；砾：瓦砾或碎石；囊：袋子。明月珠与瓦砾装在同一个袋子里。比喻好与坏混杂在一起。","source":{"text":"垂棘与瓦同椟，明月与砾同囊。","book":"汉·王充《论衡·自纪》"}},{"id":24608,"word":"明月之诗","pinyin":"míng yuè zhī shī","abbr":"myzs","explanation":"描写明月的诗。","source":{"text":"清风徐来，水波不兴。举酒属客，诵明月之诗，歌窈窕之章。","book":"宋·苏轼《前赤壁赋》"}},{"id":24609,"word":"明月入怀","pinyin":"míng yuè rù huái","abbr":"myrh","explanation":"比喻人心胸开阔。","source":{"text":"朱城九门门九闺，愿逐明月入君怀。","book":"南朝·宋·鲍照《代淮王》诗"},"example":{"text":"香亭佐刘太守于徐州，见之者都有～，清风投座之意。","book":"清·袁枚《小仓山房尺牍》三十七首"},"similar":["日月入怀"],"usage":"作宾语、定语；比喻人心胸开朗"},{"id":24610,"word":"明月入抱","pinyin":"míng yuè rù bào","abbr":"myrb","explanation":"抱：怀抱。比喻美好的情景进入心怀，心胸开阔明朗。","source":{"text":"吾友王子佑遐，明月入抱，蕙风在襟。","book":"清·缪荃孙《序》"},"similar":["明月入怀"],"usage":"作宾语、定语；比喻人心胸开朗"},{"id":24611,"word":"明月清风","pinyin":"míng yuè qīng fēng","abbr":"myqf","explanation":"只与清风、明月为伴。比喻不随便结交朋友。也比喻清闲无事。","source":{"text":"恋功名水上鸥，俏芒鞋尘内走，怎如明月清风随地有，到头来消受。","book":"明·沈采《千金记·遇仙》"},"example":{"text":"歌楼舞厅的豪华享受更使我向往～的生活。"},"similar":["清风明月"],"usage":"作宾语、定语；比喻超尘脱俗的悠闲生活"},{"id":24612,"word":"明月芦花","pinyin":"míng yuè lú huā","abbr":"mylh","explanation":"形容虚无缥缈，夜色凄迷的境界。也比喻杳无踪迹。","source":{"text":"休论佛意祖意，谩谓言端语端。铁牛放去无踪迹，明月芦花君自看。","book":"宋·释普济《五灯会元》卷十四"},"example":{"text":"平湖八月浩无津，～思煞人。","book":"清·黄景仁《湖上阻风杂诗》其三"},"usage":"作宾语、定语；用于比喻句"},{"id":24613,"word":"明来明去","pinyin":"míng lái míng qù","abbr":"mlmq","explanation":"光明正大地交往。","example":{"text":"我喜欢～地交往。"},"similar":["明来明往"],"usage":"作定语、状语；用于交往"},{"id":24614,"word":"明来暗往","pinyin":"míng lái àn wǎng","abbr":"mlaw","explanation":"公开或暗地里来往。形容关系密切，往来频繁。","example":{"text":"他们～地进行非法交易，胆大妄为。"},"similar":["来来往往"],"usage":"作状语；指关系密切"},{"id":24615,"word":"明枪好躲，暗箭难防","pinyin":"míng qiāng hǎo duǒ，àn jiàn nán fáng","abbr":"mqhdajnf","explanation":"指公开攻击容易对付，暗地陷害劫难于防备。亦作“明枪易躲，暗箭难防”。","source":{"text":"孩儿也，一了说：明枪好躲，暗箭难防。","book":"元·无名氏《独角牛》第二折"},"similar":["明枪易躲，暗箭难防"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":24616,"word":"明枪容易躲，暗剑最难防","pinyin":"míng qiāng róng yì duǒ，àn jiàn zuì nán fáng","abbr":"mqrydajznf","explanation":"指公开攻击容易对付，暗地陷害劫难于防备。同“明枪容易躲，暗箭最难防”。","source":{"text":"待我到丞相跟前去，背他一场是非，叫他明枪容易躲，暗箭最难防。","book":"明·叶宪祖《鸾鎞记·挫权》"},"similar":["明枪好躲，暗箭难防"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":24617,"word":"明枪容易躲，暗箭最难防","pinyin":"míng qiāng róng yì duǒ，àn jiàn zuì nán fáng","abbr":"mqrydajznf","explanation":"指公开攻击容易对付，暗地陷害劫难于防备。同“明枪好躲，暗箭难防”。","source":{"text":"‘定要废了他，教他这太子做不成……’这是：明枪容易躲，暗剑最难防。","book":"明·周楫《西湖二集·觉阇黎一念错投胎》"},"similar":["明枪容易躲，暗剑最难防"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":24618,"word":"明枪易躲，暗箭难防","pinyin":"míng qiāng yì duǒ，àn jiàn nán fáng","abbr":"mqydajnf","explanation":"明处来的枪容易躲开，暗中射来的箭难以提防。比喻种种公开的和隐蔽的攻击。","source":{"text":"孩儿也，一了说明枪好躲，暗箭难防。","book":"元·无名氏《独角牛》"},"example":{"text":"～，不如跳入水内浮出去罢。（明·无名氏《闹铜台》）"},"similar":["明枪好躲，暗箭难防"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":24619,"word":"明枪暗箭","pinyin":"míng qiāng àn jiàn","abbr":"mqaj","explanation":"明处来的枪容易躲开，暗中射来的箭难以提防。比喻种种公开的和隐蔽的攻击。","source":{"text":"孩儿也，一了说明枪好躲，暗箭难防。","book":"元·无名氏《独角牛》"},"example":{"text":"现在正有许多正人君子和革命文学家，用～，在办我革命及不革命之罪。","book":"鲁迅《三闲集·通信》"},"similar":["明争暗斗","明枪好躲，暗箭难防"],"opposite":["开诚布公","光明磊落"],"usage":"作主语、宾语；用于较量的场合"},{"id":24620,"word":"明查暗访","pinyin":"míng chá àn fǎng","abbr":"mcaf","explanation":"明里调查，暗中访问。指多方面调查了解情况。","source":{"text":"差你往齐东村明查暗访，这十三条命案是否服毒？","book":"清·刘鹗《老残游记》第18回"},"example":{"text":"你到下面去～，查清是谁在搞破坏。"},"similar":["明察暗访"],"usage":"作谓语、定语；指调查了解情况"},{"id":24621,"word":"明正典刑","pinyin":"míng zhèng diǎn xíng","abbr":"mzdx","explanation":"明：表明；正：治罪；典刑：法律。依照法律处以极刑。旧时多用于处决犯人的公文或布告中。","source":{"text":"如是托疾，自当明正典刑；如委实抱病，伏望天慈，放臣闲退。","book":"宋·吕颐浩《辞免赴召乞纳节致仕札子》"},"example":{"text":"故户部尚书租庸使刘震，忘累朝之厚恩，受逆贼之伪命，除将～外，妻子俱合随坐。","book":"明·陆采《明珠记·伪敕》"},"usage":"作谓语；指依照法律公开处以极刑"},{"id":24622,"word":"明法审令","pinyin":"míng fǎ shěn lìng","abbr":"mfsl","explanation":"审：谨慎。申明法令，使人人遵守，谨慎发布命令，避免出现差错。","source":{"text":"明法审令，不卜筮而事吉；贵功养劳，不祷祠而得福。","book":"《尉缭子·战威》"},"example":{"text":"故任贤使能，不时日而利；～，不卜筮而吉；养劳贵功，不祷祠而福。","book":"《新唐书·卢藏用传》"},"usage":"作宾语、定语；用于书面语"},{"id":24623,"word":"明火执仗","pinyin":"míng huǒ zhí zhàng","abbr":"mhzz","explanation":"点着火把，拿着武器。原指公开抢劫。后比喻公开地、毫不隐藏地干坏事。","source":{"text":"我在这瓦窑居住，做些本份生涯，何曾明火执仗 ，无非赤手求财。","book":"元·无名氏《盆儿鬼》第二折"},"example":{"text":"并非～，怎么便算是强盗呢？","book":"清·曹雪芹《红楼梦》第一百一十回"},"similar":["明目张胆","明火执杖"],"opposite":["鬼鬼祟祟"],"usage":"作谓语、定语、状语；指肆无忌惮"},{"id":24624,"word":"明火执杖","pinyin":"míng huǒ zhí zhàng","abbr":"mhzz","explanation":"打着火把，拿着武器，公开活动。指肆无忌惮地干坏事","source":{"text":"那借金银人，身贫无计，结成凶党，明火执杖，白日杀上我门。","book":"明·吴承恩《西游记》第40回"},"example":{"text":"夏衍《秋瑾传》：“昨天南乡的愚民听信了谣言，～的去攻打教堂。”"},"similar":["明火执仗","明目张胆"],"opposite":["鬼鬼祟祟"],"usage":"作谓语、定语、状语；指干坏事"},{"id":24625,"word":"明火执械","pinyin":"míng huǒ zhí xiè","abbr":"mhzx","explanation":"形容公开抢劫或肆无忌惮地干坏事。同“明火执仗”。","source":{"text":"即募死士百人，明火执械为前锋，千军后随。","book":"清·毛祥麟《对山余墨·石洞绣鞋记》"},"similar":["明火持杖","明火执杖"],"usage":"作谓语、定语、状语；指干坏事"},{"id":24626,"word":"明火持杖","pinyin":"míng huǒ chí zhàng","abbr":"mhcz","explanation":"形容公开抢劫或肆无忌惮地干坏事。同“明火执仗”。","source":{"text":"从贼孙伯奴、孟干儿与首贼朱伴儿、李佛保等四人明火持杖强劫梁贤十家。","book":"《元典章·刑部·从贼不得财者免刺》"},"example":{"text":"我是首将来皮豹，善晓六韬知三略，～打劫人，随着展雄做强盗。","book":"明·无名氏《临潼斗宝》楔子"},"similar":["明火执械","明火执杖"],"usage":"作谓语、定语、状语；指干坏事"},{"id":24627,"word":"明灭可见","pinyin":"míng miè kě jiàn","abbr":"mmkj","explanation":"形容忽明忽暗。","source":{"text":"斗折蛇行，明灭可见。","book":"唐·柳宗元《小石潭记》"}},{"id":24628,"word":"明烛天南","pinyin":"míng zhú tiān nán","abbr":"mztn","explanation":"烛：照耀。光照亮了南面的天空。","source":{"text":"及既上，苍山负雪，明烛天南。","book":"清·姚鼐《登泰山记》"},"usage":"作谓语；指光照亮南方的天空"},{"id":24629,"word":"明珠之颣","pinyin":"míng zhū zhī léi","abbr":"mzzl","explanation":"颣：丝上的疙瘩。夜明珠上的小疙瘩。比喻完美中稍有欠缺。","source":{"text":"此亦明珠之颣，美玉之瑕。","book":"北齐·颜之推《颜氏家训·文章》"}},{"id":24630,"word":"明珠出老蚌","pinyin":"míng zhū chū lǎo bèng","abbr":"mzclb","explanation":"明珠生于老蚌。比喻杰出的儿子生于出色的父亲。","source":{"text":"昨日仲将来，文敏笃诚，保家之主也。不意双珠近出老蚌。","book":"晋·赵岐《三辅决录》"}},{"id":24631,"word":"明珠夜投","pinyin":"míng zhū yè tóu","abbr":"mzyt","explanation":"投：抛掷，丢弃。比喻有才能的人得不到重用和赏识，或好人误入歧途。也比喻珍贵的东西落入不识货人的手里。","source":{"text":"《六经》虽美，不通其义，不识其字，则如明珠夜投，按剑而怒也。","book":"梁启超《译印政治小说序》"},"similar":["明珠暗投","明珠投暗"],"opposite":["弃暗投明"],"usage":"作谓语、宾语、定语；指误入歧途"},{"id":24632,"word":"明珠弹雀","pinyin":"míng zhū tán què","abbr":"mztq","explanation":"用珍珠打鸟雀。比喻得到的补偿不了失去的。","source":{"text":"《庄子·让王》：“今且有人于此，以隋侯之珠弹千仞之雀，世必笑之，是何也？则其所用者重，而所要者轻也。”汉·扬雄《太玄经·唐》：“明珠弹于飞肉，其得不复。测曰：明珠弹肉，费不当也。"},"example":{"text":"将明珠而弹雀，所得者少，所失者多。","book":"宋·邵伯温《河南邵氏闻见录》卷六"},"similar":["大材小用","得不偿失"],"usage":"作谓语、宾语；指做法不当","story":["鲁哀公听说颜阖非常贤明，就派人给他送礼物请他出山。贫穷的颜阖不受。庄子就此事发表感慨，颜阖无意于富贵，富资送上门，他不欢迎。这样的人难得。而那些不惜牺牲生命去追求富贵就如同“以隋侯之珠，弹千仞之雀”一样不值得"]},{"id":24633,"word":"明珠投暗","pinyin":"míng zhū tóu àn","abbr":"mzta","explanation":"比喻有才能的人得不到重视。也比喻好东西落入不识货人的手里。同“明珠暗投”。","source":{"text":"但一面又很为我的那两本书痛惜；落到捕房的手里，真是明珠投暗了。","book":"鲁迅《南腔北调集·为了忘却的记念》"},"example":{"text":"鲁迅《南腔北调集·为了忘却的记念》：“但一面又很为我的那两本书痛惜；落到捕房的手里，真是～了。”"},"similar":["明珠暗投"],"opposite":["弃暗投明"],"usage":"作宾语、定语；指误入歧途"},{"id":24634,"word":"明珠按剑","pinyin":"míng zhū àn jiàn","abbr":"mzaj","explanation":"一方以夜明珠相投，另一方则用手压住剑柄。比喻一方事前未申明自己的举动出于好意，另一方因误会而反以敌意回报。","source":{"text":"今与贤之相知也新，而又语言不能通，不当有明珠按剑之举。","book":"明·朱之瑜《朱舜永集·德始堂记》"},"example":{"text":"如予此篇，～及鲲鹏斥鷃，皆与流萤无效涉，可以知诗之难矣。","book":"明·杨慎《升庵诗话》卷十三"},"usage":"作宾语、定语；用于书面语"},{"id":24635,"word":"明珠暗投","pinyin":"míng zhū àn tóu","abbr":"mzat","explanation":"原意是明亮的珍珠，暗里投在路上，使人看了都很惊奇。比喻有才能的人得不到重视。也比喻好东西落入不识货人的手里。","source":{"text":"臣闻明月之珠，夜光的璧，以暗投于道路，人无不按剑相眄者。何则？无因而至前也。","book":"《史记·鲁仲连邹阳列传》"},"example":{"text":"又在扬州商家见有虞山客携送黄杨翠柏各一盆，惜乎～。","book":"清·沈复《浮生六记·闲情记趣》"},"similar":["弃明投暗","明珠投暗"],"opposite":["弃暗投明"],"usage":"作谓语、宾语、定语；指误入歧途","story":["西汉时期邹阳原在吴王刘濞手下做事，发现吴王想谋反，就改投奔梁孝王。羊胜对邹阳有偏见，就在梁孝王面前挑拨离间，邹阳被投入监狱准备处死，他给梁孝王写信说如果有人把“明月之珠”偷偷扔在路上，就会引起人们的警惕而不敢上前"]},{"id":24636,"word":"明珠生蚌","pinyin":"míng zhū shēng bèng","abbr":"mzsb","explanation":"明珠生于老蚌。比喻杰出的儿子生于出色的父亲。","source":{"text":"昨日仲将来，文敏笃诚，保家之主也。不意双珠近出老蚌。","book":"晋·赵岐《三辅决录》"},"example":{"text":"荷皇天宠赐，一子承宗，纵休夸佳兆为熊，尤幸似～。","book":"明·胡文焕《群音类选·百顺记·王曾得子》"},"usage":"作宾语、定语；用于比喻句","story":["东汉末年，孔融朋友有两个儿子，大儿子韦康，字元将，小儿子韦诞，字仲将。两人都很优秀，孔融特别器重他们，在给他们的父亲信中写道：“前日元将来，渊材亮茂，雅度弘毅，伟世之器也；昨日仲将来，文敏笃诚，保家之主也，不意双珠近出老蚌。”"]},{"id":24637,"word":"明白了当","pinyin":"míng bái liǎo dàng","abbr":"mbld","explanation":"形容说话或做事干净利落。","source":{"text":"我见算书中差分法，有递减，倍减、三七、四六等名，纷纷不一，何能及得这个明白了当。","book":"清·李汝珍《镜花缘》第七十九回"}},{"id":24638,"word":"明白如画","pinyin":"míng bái rú huà","abbr":"mbrh","explanation":"像画一样清楚明白。","example":{"text":"他这人是怎样的无主张，无定见，专门逢迎上层，以图固宠持禄，是～的。","book":"郭沫若《前期法家的批判·申不害》"}},{"id":24639,"word":"明白如话","pinyin":"míng bái rú huà","abbr":"mbrh","explanation":"形容诗文通俗易懂，像唠家常一样。","source":{"text":"放翁诗明白如话，然浅中有深，平中有奇，故足令人咀味。","book":"清·刘熙载《艺概·诗概》"},"example":{"text":"说是白话文应该“～”，已经要算唱厌了老调了，但其实，现在的许多白话文却连“～”也没有做到。","book":"鲁迅《人生识字糊涂始》"}},{"id":24640,"word":"明白易晓","pinyin":"míng bái yì xiǎo","abbr":"mbyx","explanation":"晓:知晓，明白。形容明白清楚，容易弄懂。","source":{"text":"不刊之典，明白易晓，非若前代之冗泛云。","book":"宋·洪迈《容斋随笔》卷二"},"example":{"text":"余每爱此言简切，～，但观者未尝留意耳。","book":"宋·叶梦得《石林诗话》卷中"}},{"id":24641,"word":"明白晓畅","pinyin":"míng bái xiǎo chàng","abbr":"mbxc","explanation":"晓：知晓，知道；畅：畅达。形容非常明白清楚。","example":{"text":"最可信的最古的一篇文字乃是《甘誓》，但就其～的一点来看，至少有后人必定的痕迹。","book":"郑振铎《插图本中国文学史·古的记载》"}},{"id":24642,"word":"明目张胆","pinyin":"míng mù zhāng dǎn","abbr":"mmzd","explanation":"明目：睁亮眼睛；张胆：放开胆量。原指有胆识，敢做敢为。后形容公开放肆地干坏事。","source":{"text":"今日之事，明目张胆，为六军之首，宁忠臣而死，不无赖而生矣。","book":"《晋书·王敦传》"},"example":{"text":"近日京师奔竞之风，是～，冠冕堂皇做的。","book":"清·吴趼人《二十年目睹之怪现状》第三一百三回"},"similar":["明火执杖"],"opposite":["鬼鬼祟祟"],"usage":"作谓语、定语、状语；指肆无忌惮","story":["唐高宗时监察御史韦思谦上书弹劾中书令褚遂良压低地价强买人土地。唐高宗贬褚遂良为同州刺史。一年后褚遂良又恢复中书令的职务，他借机打击报复韦思谦。韦思谦说：“男子汉大丈夫应当敢说敢做，明目张胆地报答国家的恩惠。”"]},{"id":24643,"word":"明目达聪","pinyin":"míng mù dá cōng","abbr":"mmdc","explanation":"眼睛明亮，耳朵灵敏。形容力图透彻了解。","source":{"text":"《书·舜典》： “明四目，达四聪”。"},"example":{"text":"当此际者，正宜～，励精图治。","book":"清·无名氏《杜诗言志》卷五"},"usage":"作谓语、定语；形容力图透彻了解"},{"id":24644,"word":"明眸善睐","pinyin":"míng móu shàn lài","abbr":"mmsl","explanation":"形容女子的眼睛明亮而灵活。","source":{"text":"丹唇外朗，皓齿内鲜。明眸善睐，靥辅承权。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"马四，苏州人，身躯弱小，～。","book":"清·珠泉居士《续板桥杂记·丽品》"},"similar":["眉目传情"],"usage":"作宾语、定语；形容女子的眼睛明亮而灵活"},{"id":24645,"word":"明眸皓齿","pinyin":"míng móu hào chǐ","abbr":"mmhc","explanation":"明亮的眼睛，洁白的牙齿。形容女子容貌美丽，也指美丽的女子。","source":{"text":"丹唇外朗，皓齿内鲜，明眸善睐，靥辅承权。","book":"三国魏·曹植《洛神赋》"},"example":{"text":"～今何在，血污游魂归不得。","book":"唐·杜甫《哀江头》诗"},"similar":["眉清目秀"],"opposite":["青面獠牙"],"usage":"作谓语、定语、补语；指美女"},{"id":24646,"word":"明知故犯","pinyin":"míng zhī gù fàn","abbr":"mzgf","explanation":"明明知道不能做，却故意违犯。","source":{"text":"问：‘一切含灵具有佛性，既有佛性，为甚么却撞入驴胎马腹？’师曰：‘知而故犯。’","book":"宋·释普济《五灯会元》卷十九"},"example":{"text":"此物既与人无益，如何令尊伯伯却又栽这许多？岂非～么？","book":"清·李汝珍《镜花缘》第六十一回"},"similar":["知法犯法"],"opposite":["知过必改"],"usage":"作谓语、定语、状语；指故意违犯"},{"id":24647,"word":"明知故问","pinyin":"míng zhī gù wèn","abbr":"mzgw","explanation":"明明知道，还故意问人。","source":{"text":"然则此时夫子又何以明知故问呢？","book":"清·文康《儿女英雄传》第三十九回"},"example":{"text":"明人何必细说。你也知道是谁，却就是～呢！（清·无名氏《绣花鞋》）"},"similar":["多此一举"],"opposite":["不闻不问"],"usage":"作谓语、定语；含讽刺意味"},{"id":24648,"word":"明码实价","pinyin":"míng mǎ shí jià","abbr":"mmsj","explanation":"明码：指标明的价格。指公开标明的真实价格或处事不折不扣。","source":{"text":"好在日本是个明码实价的国家，只要你肯卖，任何东西都可以标出一个价格，一律用日元付酬，不至于最后给你奖状或荣誉称号了事。","book":"王朔《许爷》"},"similar":["不折不扣"],"usage":"作宾语、定语、状语；用于商业或处事"},{"id":24649,"word":"明窗净几","pinyin":"míng chuāng jìng jī","abbr":"mcjj","explanation":"形容室内明亮、整洁。","source":{"text":"苏子美尝言，明窗净几，笔砚纸墨皆极精良，亦自是人生一乐。","book":"宋·欧阳修《试笔》"},"example":{"text":"欣然为我解东阁，～舒华茵。","book":"宋·苏澈《寄范文景仁》诗"},"similar":["窗明几净"],"usage":"作谓语、定语；形容室内明亮、整洁"},{"id":24650,"word":"明罚敕法","pinyin":"míng fá chì fǎ","abbr":"mfcf","explanation":"罚：刑罚；敕：整饬。严明刑罚，整顿法度。","source":{"text":"雷电噬嗑，先王以明罚敕法。","book":"《周易·噬嗑》"},"example":{"text":"然后～，以肃理官，克厌天心，慰塞人事。","book":"《晋书·郭璞传》"},"usage":"作谓语、宾语；用于治政"},{"id":24651,"word":"明耻教战","pinyin":"míng chǐ jiào zhàn","abbr":"mcjz","explanation":"教导士兵作战，使他们知道退缩就是耻辱，因而能够奋勇向前，杀敌取胜。","source":{"text":"明耻教战，求杀敌也。","book":"春秋·鲁·左丘明《左传·僖公二十二年》"},"example":{"text":"文武之道，自昔成规；～，振古常轨。","book":"《魏书·张普惠传》"},"usage":"作谓语；用于带兵等方面"},{"id":24652,"word":"明若观火","pinyin":"míng ruò guān huǒ","abbr":"mrgh","explanation":"象看火那样清楚。形容看事物十分明晰。","source":{"text":"我视汝情，明若观火。","book":"《尚书·盘庚上》：“予若观火。”宋·蔡沈集传"},"example":{"text":"善恶从类，端如贯珠，成败象行，～。","book":"唐·陆贽《奉天论前所答奏未施行状》"},"similar":["洞若观火","明如指掌"],"usage":"作谓语；指看得清楚"},{"id":24653,"word":"明见万里","pinyin":"míng jiàn wàn lǐ","abbr":"mjwl","explanation":"对于外界或远方的情况，知道得很清楚。也比喻人有预见。","source":{"text":"真可谓明见万里，智察秋毫。","book":"清·李渔《比目鱼·征利》"},"example":{"text":"老先生台论，可谓～。","book":"清·名教中人《好逑传》第13回"},"similar":["料事如神"],"usage":"作谓语、定语；比喻人有预见性"},{"id":24654,"word":"明赏不费","pinyin":"míng shǎng bù fèi","abbr":"msbf","explanation":"赏赐得当，就不浪费财物。","source":{"text":"善因天下之货，以赏天下之人。故曰：‘明赏不费。’","book":"《商君书·赏刑》"},"usage":"作宾语、定语；指奖赏等"},{"id":24655,"word":"明赏慎罚","pinyin":"míng shǎng shèn fá","abbr":"mssf","explanation":"奖赏严明，处罚慎重。","source":{"text":"兴利除害，明赏慎罚，直言极谏，补主之过，德匡天下，威正诸侯，此人臣极谏直言之功也。","book":"汉·荀悦《汉纪·文帝纪下》"},"usage":"作谓语、宾语；用于统治者等"},{"id":24656,"word":"明辨是非","pinyin":"míng biàn shì fēi","abbr":"mbsf","explanation":"分清楚是和非、正确和错误。","source":{"text":"失祀者，所以定亲疏，决嫌疑，别同异，明是非也。","book":"《礼记·中庸》：“慎思之，明辩之，笃行之。”《礼记·曲礼上》"},"example":{"text":"八、九年的部队生活和她的特殊地位，养成她举止老练、大方、～。","book":"姚雪垠《李自成》第一卷第四章"},"similar":["是非分明"],"opposite":["是非莫辨"],"usage":"作谓语、定语；指清楚地辨别出是和非"},{"id":24657,"word":"明道指钗","pinyin":"míng dào zhǐ chāi","abbr":"mdzc","explanation":"泛指婴儿聪明。","source":{"text":"程明道未能方言时，叔母抱之游戏，不觉堕钗，后数日乃觉。寻不获，明道以手指示这。叔母抱随所指而往，至原游戏处，寻之，乃获。","book":"明·彭大翼《山堂肆考·微集》卷三十八"}},{"id":24658,"word":"明里抱拳，暗里踢腿","pinyin":"míng lǐ bào quán，àn lǐ tī tuǐ","abbr":"mlbqaltt","explanation":"抱拳：古代的一种礼节。比喻当面恭维，背后使坏。"},{"id":24659,"word":"明鉴万里","pinyin":"míng jiàn wàn lǐ","abbr":"mjwl","explanation":"明：眼睛亮；鉴：洞察。对外面或远方的情况了解得很清楚。形容人料事准确，识见高明。","source":{"text":"玺书既至，河西咸惊，以为天子明见万里之外。","book":"《后汉书·窦融传》"},"example":{"text":"谭道台昨夜筹画，果然～。","book":"清·李绿园《歧路灯》第八十九回"},"similar":["明见万里"],"usage":"作谓语、定语；比喻人有预见性"},{"id":24660,"word":"明鉴未远","pinyin":"míng jiàn wèi yuǎn","abbr":"mjwy","explanation":"明鉴：明显的鉴戒。明显的教训没过多久，不要忘记。","source":{"text":"明鉴未远，覆车如昨，而近习之权，复相扇结。","book":"《后汉书·陈蕃传》"},"example":{"text":"慎狱重刑，著于往诰。朕御兹宝历，～，断决烦疑，实有攸愧。","book":"《魏书·世宗纪》"}},{"id":24661,"word":"明镜不疲","pinyin":"míng jìng bù pí","abbr":"mjbp","explanation":"明亮的镜子不为频繁地照人而疲劳。比喻人的智慧不会因使用而受损害。","source":{"text":"何尝见明镜疲于照，清流惮于惠风。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"竞尚佳章，曰洛阳纸贵；不嫌问难，曰～。","book":"清·程允升《幼学琼林·文事》"}},{"id":24662,"word":"明镜止水","pinyin":"míng jìng zhǐ shuǐ","abbr":"mjzs","explanation":"比喻人心体明净。","source":{"text":"人莫见于流水，而鉴于止水，唯止能止众止。","book":"《庄子·德充符》"},"example":{"text":"～，喻心体也。","book":"明·陆树声《清署笔谈》"}},{"id":24663,"word":"明镜照形","pinyin":"míng jìng zhào xíng","abbr":"mjzx","explanation":"比喻了解过去就可以知道现在。","source":{"text":"明镜所以照形也，往古所以知今也。","book":"汉·刘向《说苑·尊贤》"}},{"id":24664,"word":"明镜鉴形","pinyin":"míng jìng jiàn xíng","abbr":"mjjx","explanation":"明亮的镜子照出自己的言行。比喻身边有人经常指出自己的言行是否适当。","source":{"text":"常念魏征随事谏正，多中朕失，如明镜鉴形，美恶必见。","book":"唐·吴兢《贞观政要·求谏》"},"example":{"text":"敕以芳香馥身，喻以～，此言过矣，未获我心也。","book":"唐·欧阳洵《艺文类聚》卷三十二"}},{"id":24665,"word":"明镜高悬","pinyin":"míng jìng gāo xuán","abbr":"mjgx","explanation":"传说秦始皇有一面镜子，能照人心胆。比喻官员判案公正廉明。","source":{"text":"有方镜，广四尺，高五尺九寸，表里有明，人直来照之，影则倒见。以手扪心而来，则见肠胃五脏，历然无碍。","book":"《西京杂记》卷三"},"example":{"text":"只除非天见怜，奈天天又远，今日个幸对清官，～。","book":"元·关汉卿《望江亭》第四折"},"similar":["铁面无私"],"opposite":["贪赃枉法"],"usage":"作谓语、定语；指执法判案","story":["传说秦朝咸阳宫中有一面神奇的镜子，他宽四尺，高五尺，正反两面都能照人，人在镜前镜中影子是倒立的，用手按住胸口照镜可以显示五脏六腑，可以看出人体内的病灶，还能看出那些心术不正的人，秦始皇经常用该镜对付身边的人"]},{"id":24666,"word":"明验大效","pinyin":"míng yàn dà xiào","abbr":"mydx","explanation":"显著而又巨大的效验。同“明效大验”。","source":{"text":"后十五年，无一不如公料者，至今明验大效，与始言若符节。","book":"宋·张琰《序》"},"similar":["明效大验"],"usage":"作宾语、定语；指显著而又巨大的效验"},{"id":24667,"word":"明鼓而攻之","pinyin":"míng gǔ ér gōng zhī","abbr":"mgegz","explanation":"宣布罪状，遣责或声讨。","source":{"text":"非吾徒也，小子鸣鼓而攻之可也。","book":"《论语·先进》"}},{"id":24668,"word":"明齐日月","pinyin":"míng qí rì yuè","abbr":"mqry","explanation":"光辉灿烂可以与日月相比拟。旧时多用于称颂圣贤、帝王。","source":{"text":"天子者，与天地参，故德配天地，兼利万物，与日月并明，明照四海而不遗微小。","book":"《礼记·经解》"},"example":{"text":"皇矣尼父，圣哲之杰，德比天地，～。","book":"晋·孙楚《尼父颂》"}},{"id":24669,"word":"昏垫之厄","pinyin":"hūn diàn zhī è","abbr":"hdze","explanation":"昏垫：迷惘沉溺，指困于水灾；厄：苦难。指受困于水灾。","source":{"text":"人有昏垫之厄，主有畴咨之忧。","book":"《尚书·益稷》：“洪水滔天，浩浩怀山襄陵，下民昏垫。”《后汉书·崔骃传》"}},{"id":24670,"word":"昏天暗地","pinyin":"hūn tiān àn dì","abbr":"htad","explanation":"形容天色昏暗。也比喻社会黑暗混乱。同“昏天黑地”。","source":{"text":"鬼帅再变五色云雾，昏天暗地。","book":"明·冯梦龙《喻世明言》第十三卷"},"similar":["昏天黑地"],"usage":"作谓语、定语、状语；指天气或世局"},{"id":24671,"word":"昏天黑地","pinyin":"hūn tiān hēi dì","abbr":"hthd","explanation":"形容天色昏暗。也比喻社会黑暗混乱。","source":{"text":"郑蕊珠昏天黑地，不认得这条路是那里，离家是近是远。","book":"明·凌濛初《二刻拍案惊奇》卷二十五"},"example":{"text":"加以象现在的～，你若打开窗子说亮话，还是免不了做牺牲。","book":"鲁迅《两地书》九"},"similar":["天昏地暗","神志不清"],"opposite":["一清二楚"],"usage":"作谓语、定语、状语；指天气或世局"},{"id":24672,"word":"昏头打脑","pinyin":"hūn tóu dǎ nǎo","abbr":"htdn","explanation":"形容头脑昏沉，糊里糊涂。同“昏头搭脑”。","source":{"text":"祥子几乎没有力量迈出大门坎去。昏头打脑的，脚还在门坎内，借着街上的灯光，已看见了刘姑娘。","book":"老舍《骆驼祥子》九"},"similar":["昏头昏脑","昏头晕脑","昏头搭恼"],"usage":"作谓语、定语；形容头脑发昏，晕头转向"},{"id":24673,"word":"昏头搭恼","pinyin":"hūn tóu dā nǎo","abbr":"htdn","explanation":"形容头脑昏沉，糊里糊涂。同“昏头搭脑”。","source":{"text":"他撮空布桥，我昏头搭恼。","book":"明·史槃《鹣钗记·萧豪》"},"similar":["昏头昏脑","昏头晕脑","昏头晕脑"],"usage":"作谓语、定语；形容头脑发昏，晕头转向"},{"id":24674,"word":"昏头搭脑","pinyin":"hūn tóu dā nǎo","abbr":"htdn","explanation":"形容头脑发昏，晕头转向。","source":{"text":"却说八戒跌得昏头昏脑，猛抬头，见丝篷丝索俱无，他才一步一探，爬将起来，忍着疼，找回原路。","book":"明·吴承恩《西游记》第七十二回"},"example":{"text":"因被宗泽发作了一场，气得～。","book":"清·钱彩《说岳全传》第十一回"},"similar":["昏头昏脑","昏头打脑","昏头搭恼"],"usage":"作谓语、定语；形容头脑发昏，晕头转向"},{"id":24675,"word":"昏头昏脑","pinyin":"hūn tóu hūn nǎo","abbr":"hthn","explanation":"形容头脑发昏，晕头转向。","source":{"text":"却说八戒跌得昏头昏脑，猛抬头，见丝篷丝索俱无，他才一步一探，爬将起来，忍着疼，找回原路。","book":"明·吴承恩《西游记》第七十二回"},"example":{"text":"一个新年里，弄得～，没些清楚。","book":"清·禇人获《隋唐演义》第十一回"},"similar":["昏昏欲睡"],"opposite":["神志清醒"],"usage":"作谓语、定语；形容头脑发昏，晕头转向"},{"id":24676,"word":"昏头晕脑","pinyin":"hūn tóu yūn nǎo","abbr":"htyn","explanation":"形容头脑发昏，晕头转向。同“昏头昏脑”。","source":{"text":"每日骑着这个驴上县下乡，跑得昏头晕脑。","book":"清·吴敬梓《儒林外史》第二回"},"similar":["昏头昏脑","昏头打脑","昏头搭恼"],"usage":"作谓语、定语；形容头脑发昏，晕头转向"},{"id":24677,"word":"昏头转向","pinyin":"hūn tóu zhuǎn xiàng","abbr":"htzx","explanation":"头脑发昏，迷失方向。","source":{"text":"城一破，温绍原拔腿就逃，逃啊，逃啊，昏头转向，一头冲到个塘里，淹死了。","book":"《太平天国歌谣传说集·智破六合城》"},"example":{"text":"你晓得这几天简直把人忙得～的。","book":"艾芜《百炼成钢》第三章"},"similar":["晕头转向"],"usage":"作谓语、定语、状语；指找不到方向"},{"id":24678,"word":"昏定晨省","pinyin":"hūn dìng chén xǐng","abbr":"hdcx","explanation":"昏：天刚黑；省：探望、问候。晚间服侍就寝，早上省视问安。旧时侍奉父母的日常礼节。","source":{"text":"凡为人子之礼，冬温而夏清，昏定而晨省。","book":"《礼记·曲礼上》"},"example":{"text":"不但将亲戚朋友一概杜绝了，而且连家庭中～，一发都随他的便了。","book":"清·曹雪芹《红楼梦》第三十六回"},"usage":"作谓语、定语；子女侍奉父母的礼节"},{"id":24679,"word":"昏庸无道","pinyin":"hūn yōng wú dào","abbr":"hywd","explanation":"糊涂平庸，凶狠残暴，不讲道义，多用指糊涂无能且残暴凶狠的帝王。","example":{"text":"商纣王～，人们苦不堪言。"},"usage":"作谓语、定语；用于无能的领导者"},{"id":24680,"word":"昏愦胡涂","pinyin":"hūn kuì hú tú","abbr":"hkht","explanation":"昏愦：昏乱。形容头脑糊涂，不明事理。","source":{"text":"被批评家们痛驳，谓‘久已如此，而还要多说，实属不明大势，昏愦胡涂。’","book":"鲁迅《拟豫言》"},"usage":"作谓语、定语；用于口语"},{"id":24681,"word":"昏昏噩噩","pinyin":"hūn hūn è è","abbr":"hhee","explanation":"形容糊涂、无知的样子。","source":{"text":"这两句话像两根铁扫把，把他的脑子搅得昏昏噩噩，好大一阵子不能进行思维活动。","book":"叶君健《曙光》四"},"example":{"text":"但是封建统治阶级中当权的大多数，却仍然是文恬武嬉，～。","book":"《新华月报》1979年第1期"},"similar":["浑浑噩噩"],"usage":"作谓语、定语、宾语；指人的头脑"},{"id":24682,"word":"昏昏暗暗","pinyin":"hūn hūn àn àn","abbr":"hhaa","explanation":"指光线十分微弱。","source":{"text":"昏昏暗暗，灵前灯火失光明；惨惨幽幽，壁上纸钱飞散乱。","book":"明·施耐庵《水浒传》第26回"},"example":{"text":"月亮在黑白相间的云彩里游移，大地上～。","book":"路遥《平凡的世界》第三卷第16章"},"opposite":["灯火通明"],"usage":"作定语、状语；用于光线等"},{"id":24683,"word":"昏昏欲睡","pinyin":"hūn hūn yù shuì","abbr":"hhys","explanation":"昏昏沉沉，只想睡觉。形容极其疲劳或精神不振。也比喻诗文、谈话等内容空洞乏味，使人提不起兴趣。","source":{"text":"袅袅浑无力，昏昏只欲眠。","book":"宋·王阮《代胡仓进圣德惠民诗》"},"example":{"text":"以为诗能散人襟怀，顾览他人诗，～又何也？（清·归庄《许更生诗序》）"},"similar":["无精打采","昏头昏脑","委靡不振"],"opposite":["朝气勃勃","精神抖擞","生气勃勃"],"usage":"作谓语、分句；形容非常疲劳"},{"id":24684,"word":"昏昏沉沉","pinyin":"hūn hūn chén chén","abbr":"hhcc","explanation":"形容人神志不清的样子。","source":{"text":"准备着被儿枕儿，则索昏昏沉沉的睡。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"我努力睁大眼睛，我～地捱着时刻。","book":"巴金《第四病室》"},"similar":["浑浑噩噩"],"opposite":["神清气爽"],"usage":"作状语、补语；指人的头脑"},{"id":24685,"word":"昏昏浩浩","pinyin":"hūn hūn hào hào","abbr":"hhhh","explanation":"苍茫浩渺。","source":{"text":"彼河之流，彼天之高，宛宛转转，昏昏浩浩，有怪有灵，时颠时倒，而子浮泛其间，能不手足之骇，神魂之掉者乎？","book":"唐·罗隐《谗书·槎客喻》"},"usage":"作定语、状语；用于口语"},{"id":24686,"word":"昏昏默默","pinyin":"hūn hūn mò mò","abbr":"hhmm","explanation":"①看不见听不到的状态。指至道难见莫测。②迷糊，不知所以。","source":{"text":"至道之精，窈窈冥冥；至道之极，昏昏默默。","book":"《庄子·在宥》"},"example":{"text":"眼看着入殓，又抚棺大哭一场，方告辞而去。出门正无所之，～，自想方才之事……也不自知了。","book":"清·曹雪芹《红楼梦》第六十六回"},"similar":["迷迷糊糊"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":24687,"word":"昏眊重膇","pinyin":"hūn mào zhòng zhuì","abbr":"hmzz","explanation":"眊：眼睛失神；膇：脚肿。视力模糊，腿脚肿胀。形容精神不济，身体衰老。","source":{"text":"昏眊重膇，意以为常。","book":"唐·柳宗元《与萧翰林俛书》"}},{"id":24688,"word":"昏聩无能","pinyin":"hūn kuì wú néng","abbr":"hkwn","explanation":"昏：眼睛看不清楚；聩：耳朵听不清楚。眼花耳聋，没有能力。比喻头脑糊涂，没有能力，分不清是非。","example":{"text":"我们不能提拔那些～的人当干部。"},"usage":"作谓语、定语；用于人的能力"},{"id":24689,"word":"昏聩胡涂","pinyin":"hūn kuì hú tú","abbr":"hkht","explanation":"昏：眼花；聩：耳聋。形容头脑糊涂，不分是非。","source":{"text":"被批评家们痛驳，谓‘久已如此，而还要多说，实属不明大势，昏聩胡涂。’","book":"鲁迅《拟豫言》"}},{"id":24690,"word":"昏迷不省","pinyin":"hūn mí bù xǐng","abbr":"hmbx","explanation":"神志昏沉，不省人事。同“昏迷不醒”。","source":{"text":"度桥便入黑洞中……但觉腥秽特甚，水如潮涌，将身滚出于外，昏迷不省。","book":"清·东轩主人《述异记·蛇异》"},"similar":["昏迷不醒"],"usage":"作谓语、定语；指不省人事"},{"id":24691,"word":"昏迷不醒","pinyin":"hūn mí bù xǐng","abbr":"hmbx","explanation":"昏昏沉沉，失去知觉。","source":{"text":"即如桑椹，人能久服，则延年益寿。斑鸠食之，则昏迷不醒。","book":"清·李汝珍《镜花缘》第四十四回"},"example":{"text":"流血和过多疲劳，使他～，脸色煞白。","book":"杜鹏程《保卫延安》第五章"},"similar":["不省人事","昏迷不省"],"usage":"作谓语、定语；指不省人事"},{"id":24692,"word":"昏镜重明","pinyin":"hūn jìng chóng míng","abbr":"hjcm","explanation":"将昏暗的铜镜重新打磨光亮。比喻重见光明。","source":{"text":"今日投至见大人，似那拨云见日，昏镜重明。","book":"元·无名氏《神奴儿》第四折"},"similar":["昏镜重磨"],"usage":"作谓语；比喻重见光明"},{"id":24693,"word":"昏镜重磨","pinyin":"hūn jìng chóng mó","abbr":"hjcm","explanation":"昏镜：昏暗的铜镜。将昏暗的铜镜重新磨光。比喻重见光明。","source":{"text":"投至今日，得见孔目哥哥呵！似那拨云见日，昏镜重磨。","book":"元·孙仲章《勘头巾》第三折"},"similar":["昏镜重明"],"usage":"作谓语；比喻重见光明"},{"id":24694,"word":"易于反手","pinyin":"yì yú fǎn shǒu","abbr":"yyfs","explanation":"犹易如反掌。比喻事情非常容易做。","source":{"text":"夫清忠之士，乃千人之表，万人之英。得其人则事易于反手；不得其人，则难于拔筋。","book":"晋·杨泉《物理论》"},"example":{"text":"晋·杨泉《物理论》：“得其人则事～；不得其人，则难于拔筋。”"},"similar":["易如反掌","易如翻掌","异同反掌"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":24695,"word":"易于反掌","pinyin":"yì yú fǎn zhǎng","abbr":"yyfz","explanation":"犹易如反掌。比喻事情非常容易做。","source":{"text":"一得一失，易于反掌，一兴一亡，疾如旋踵，为国家者可不务乎？","book":"汉·枚乘《上书谏吴王》：“必若所欲为，危于累卵，难于上天；变所欲为，易于反掌，安于泰山。”唐·冯用之《机论上》"},"example":{"text":"天下无难事，得其人则～。","book":"宋·秦观《李训论》"},"similar":["易于反手","易如反掌","易如翻掌"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":24696,"word":"易于拾遗","pinyin":"yì yú shí yí","abbr":"yysy","explanation":"犹易如反掌。比喻事情非常容易做。","source":{"text":"新都袭汉，易于拾遗也。","book":"晋·陆机《五等诸侯论》"},"example":{"text":"《宋书·王景文传》：“诸将咸云：‘平殄小贼，～。’”"},"similar":["易如反掌"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":24697,"word":"易于破竹","pinyin":"yì yú pò zhú","abbr":"yypz","explanation":"轻松得就象劈竹子。比喻节节胜利，毫无阻碍。","source":{"text":"开幸人之志，兆乱臣之心，遂使侯景被吾甲而寇王城，驱我入而围天阙，势如破竹，易若转圈，万里糜沸，四方瓦解。","book":"南朝·陈·何元之《梁典总论》"}},{"id":24698,"word":"易俗移风","pinyin":"yì sú yí fēng","abbr":"ysyf","explanation":"改变习俗，转移风气。","source":{"text":"其高者，则严君味道，易俗移风。","book":"晋·常璩《华阳国志·梓童士女》"},"example":{"text":"陈去病《论戏剧之有益》：“惟兹新戏，最洽人情，～，于是焉在。”"},"similar":["移风易俗"],"usage":"作谓语、定语、宾语；指改变风俗等"},{"id":24699,"word":"易口以食","pinyin":"yì kǒu yǐ shí","abbr":"ykys","explanation":"犹易子而食。口，丁口。形容灾民极其悲惨的生活。","source":{"text":"城中栈而处，粮尽，易口以食。","book":"《新唐书·逆臣传上·安庆绪》"},"similar":["易子而食"],"usage":"作谓语、定语；形容灾后的惨状"},{"id":24700,"word":"易同反掌","pinyin":"yì tóng fǎn zhǎng","abbr":"ytfz","explanation":"比喻事情及容易办成，不必费很大力气。同“易如反掌”。","source":{"text":"此州控带淮南，邻接强寇，欲为身计，易同反掌。","book":"《北史·王轨传》"},"similar":["易于反手","易如反掌","易如翻掌"],"usage":"作谓语、定语、状语；用于比喻句"},{"id":24701,"word":"易地则皆然","pinyin":"yì dì zé jiē rán","abbr":"ydzjr","explanation":"易：更换；皆然：都一样。改换到别人的环境，也会像别人那样看待问题","source":{"text":"禹、稷、颜子易地则皆然。","book":"战国·邹·孟轲《孟子·离娄下》"},"example":{"text":"鲁迅《端午节》：“现在学生出身的官僚就不少，和老官僚有什么两样呢？‘～’。”"},"similar":["易地皆然"],"usage":"作谓语、定语；用于书面语"},{"id":24702,"word":"易地皆然","pinyin":"yì dì jiē rán","abbr":"ydjr","explanation":"易地：更换位置。只要人的信仰一致，即使更换位置使之处于不同的环境，他们的表现也一样。","source":{"text":"禹、稷、颜回同道。禹思天下有溺者，由己溺之也；稷思天下有饥者，由己饥之也，是以如是其急也。禹、稷、颜子易地则皆然。","book":"《孟子·离娄下》"},"example":{"text":"及入他境，对人言之而人不解，始知其为方言者，诸如此类，～。","book":"清·李渔《闲情偶寄·词曲部·宾白》"},"similar":["易地则皆然"],"usage":"作谓语、定语；用于书面语"},{"id":24703,"word":"易地而处","pinyin":"yì dì ér chǔ","abbr":"ydec","explanation":"换一换所处的地位。比喻为对方想一想。","source":{"text":"社稷几倾，若与少康易地而处，或未能复大禹之绩也。","book":"三国·魏·曹髦《少康、汉高祖论》"},"example":{"text":"若使司马迁～，撰成《汉书》，将恐多言费辞。","book":"唐·刘知畿《史通·杂说上》"},"similar":["设身处地"],"usage":"作谓语；比喻为对方想一想"},{"id":24704,"word":"易如反掌","pinyin":"yì rú fǎn zhǎng","abbr":"yrfz","explanation":"象翻一下手掌那样容易。比喻事情非常容易做。","source":{"text":"必若所欲为，危于累卵，难于上天；变所欲为，易如反掌，安于泰山。","book":"《孟子·公孙丑上》：“以齐王，由反手也。”又，“武丁朝诸侯，有天下，犹运之掌也。”汉·枚乘《上书谏吴王》"},"example":{"text":"藩台又叫首府、首县写信出去，向外府、县替他张罗，大约一二千金，～。","book":"清·李宝嘉《官场现形记》第十九回"},"similar":["一挥而就","轻而易举","信手拈来"],"opposite":["来之不易","难于登天"],"usage":"作谓语、定语、状语；比喻事情非常容易做","story":["战国时期大思想家主张推行“仁政”、“王道”，他的弟子公孙丑问他到齐国去能否像管仲、晏婴一样有所作为。孟子很不高兴，说：“管仲辅佐齐桓公，晏婴辅佐齐景公，是因为齐国地广人多，推行王道统一天下就像翻转手掌那样容易。”"]},{"id":24705,"word":"易如拾芥","pinyin":"yì rú shí jiè","abbr":"yrsj","explanation":"容易得如同拾芥子一样。比喻事情极容易办成。","source":{"text":"以先生之才，怕不进取功名易如拾芥。","book":"语出《汉书·夏侯胜传》：“经术苟明，其取青紫如俯拾地芥耳。”元·无名氏《冻苏秦》第一折"},"example":{"text":"顾先生道：“要学‘万人敌’，却也～。”","book":"清·文康《儿女英雄传》第十八回"},"similar":["易如反掌"],"usage":"作谓语、定语；用于书面语"},{"id":24706,"word":"易如破竹","pinyin":"yì rú pò zhú","abbr":"yrpz","explanation":"像劈竹子那样容易。形容办事顺利，毫无阻碍。","source":{"text":"厥角稽首，迎我前矛。后实先声，易如破竹。","book":"明·陶宗仪《辍耕录·檄》"},"usage":"作谓语、定语；用于书面语"},{"id":24707,"word":"易如翻掌","pinyin":"yì rú fān zhǎng","abbr":"yrfz","explanation":"比喻事情及容易办成，不必费很大力气。同“易如反掌”。","source":{"text":"某领大势雄兵，军行策应，擒拿王彦章易如翻掌。","book":"元·关汉卿《五侯宴》第三折"},"example":{"text":"明·冯梦龙《醒世恒言》第20卷：“倘得侥幸连科及第，那时救父报仇，岂不～！”"},"similar":["易如反掌","易于反手","异同反掌"],"usage":"作谓语、定语、状语；比喻事情非常容易做"},{"id":24708,"word":"易子析骸","pinyin":"yì zǐ xī hái","abbr":"yzxh","explanation":"指易子而食，析骸而爨。极言天灾人祸所造成的惨状。","source":{"text":"易子析骸，厥祸亦巨。","book":"汉·应劭《风俗通·皇霸·五伯》"},"example":{"text":"如或固守穷城，不识天命，必使覆巢破卵，～。","book":"唐·赵元一《奉天录》卷二"},"similar":["析骸易子"],"usage":"作谓语、定语；用于书面语","story":["春秋时期，楚庄王因宋国杀了楚国过境使臣申舟而出兵攻打宋国，围困宋国首都半年之久，并准备长久围困下去，宋国人害怕了，宋王派元帅华元只身潜入楚国元帅子反的卧室，挟持子反说宋国人就是易子而食、析骸而炊也不投降"]},{"id":24709,"word":"易子而教","pinyin":"yì zǐ ér jiào","abbr":"yzej","explanation":"易：交换。交换孩子进行教育。"},{"id":24710,"word":"易子而食","pinyin":"yì zǐ ér shí","abbr":"yzes","explanation":"子：指儿女。原指春秋时宋国被围，城内粮尽，百姓交换子女以当食物。后形容灾民极其悲惨的生活。","source":{"text":"易子而食之，析骸而炊之。","book":"《公羊传·宣公十五年》"},"example":{"text":"有的是报告灾荒的严重情形，充满了“赤地千里”、“人烟断绝”和“～”等触目惊心的字句。","book":"姚雪垠《李自成》第二卷第二十二章"},"similar":["析骸以爨","析骸易子"],"usage":"作谓语、定语；形容灾后的惨状","story":["春秋时期，楚庄王因宋国杀了楚国过境使臣申舟而出兵攻打宋国，围困宋国首都半年之久，并准备长久围困下去，宋国人害怕了，宋王派元帅华元只身潜入楚国元帅子反的卧室，挟持子反说宋国人就是易子而食、析骸而炊也不投降"]},{"id":24711,"word":"易放难收","pinyin":"yì fàng nán shōu","abbr":"yfns","explanation":"放：发出，开放。话说出去容易，收回来就难了。告诫人说话要谨慎。","source":{"text":"所谓修辞立诚以居业者，欲吾之谨夫所发以致其实，而尤先于言语之易放而难收也。","book":"宋·朱熹《答巩仲至》"},"usage":"作谓语、定语；用于说话或处事"},{"id":24712,"word":"易箦之际","pinyin":"yì zé zhī jì","abbr":"yzzj","explanation":"箦：竹席。调换竹席的工夫。比喻老人病危将死的时刻。","source":{"text":"言人临终曰易箦之际。","book":"宋·葛立方《韵语阳秋》卷五：“今观易箦之际，神色不乱如此，不应于此而至于发狂恸哭也。”宋·胡继宗《书言故事·凶事类》"},"example":{"text":"是的，是有人到了～，朋友们才急急忙忙的为他赶办退休手续。","book":"梁实秋《退休》"}},{"id":24713,"word":"易若转圈","pinyin":"yì ruò zhuàn quān","abbr":"yrzq","explanation":"转圈：转动圆体的器物。像转动圆形的器物一样容易。比喻轻而易举且顺畅无阻。","source":{"text":"开幸人之志，兆乱臣之心，遂使侯景被吾甲而寇王城，驱我入而围天阙，势如破竹，易若转圈，万里糜沸，四方瓦解。","book":"南朝·陈·何元之《梁典总论》"}},{"id":24714,"word":"易衣而出，并日而食","pinyin":"yì yī ér chū，bìng rì ér shí","abbr":"yyecbres","explanation":"易：更换；并日：两天并成一天。只有一件衣服比较体面，谁外出就换上；一天的饭食分作两天吃。比喻非常穷困。","source":{"text":"儒有一亩之宫，环堵之室，筚门圭窬，蓬户瓮牖；易衣而出，并日而食，上答之不敢以疑，上不答不敢以谄，其仕有如此者。","book":"《礼记·儒行》"},"example":{"text":"事觉，策免，章自杀。家无余财，诸子～。","book":"《后汉书·周章传》"},"usage":"作谓语、定语；用于书面语"},{"id":24715,"word":"易辙改弦","pinyin":"yì zhé gǎi xián","abbr":"yzgx","explanation":"变更车道，改换琴弦。比喻改变方向、计划、做法或态度。","source":{"text":"若一旦易辙改弦，以其材力聪明置之于有用之地，安见其必逊于西人也哉？","book":"清·王韬《〈火器略说〉后跋》"},"similar":["改弦易辙"],"usage":"作谓语、状语；用于处事"},{"id":24716,"word":"易道良马","pinyin":"yì dào liáng mǎ","abbr":"ydlm","explanation":"易道：平坦的道路；良马：好马。坦途骏马，便于驰骋。比喻可以迅速前进，毫无阻碍。","source":{"text":"易道良马，使人欲驰；饮酒而乐，使人欲謌。","book":"《淮南子·说林训》"}},{"id":24717,"word":"昙花一现","pinyin":"tán huā yī xiàn","abbr":"thyx","explanation":"昙花：即优昙钵花，开放时间很短。比喻美好的事物或景象出现了一下，很快就消失。","source":{"text":"佛告舍利佛，如是妙法，诸佛如来，时乃说之，如优昙钵花，时一现耳。","book":"《妙法莲华经·方便品》"},"example":{"text":"这种盛况，只是～。"},"similar":["稍纵即逝","好景不长"],"opposite":["万古长青"],"usage":"作谓语、宾语、定语；指很快就消失的"},{"id":24718,"word":"星列棋布","pinyin":"xīng liè qí bù","abbr":"xlqb","explanation":"列：罗列；布：分布。象天空的星星和棋盘上的棋子那样分布着。形容数量很多，分布很广。","source":{"text":"列卒周匝，星罗云布。","book":"汉·班固《西都赋》"}},{"id":24719,"word":"星前月下","pinyin":"xīng qián yuè xià","abbr":"xqyx","explanation":"指月夜良宵。亦作“月下星前”。","source":{"text":"五百年欢喜冤家，正好星前月下。","book":"元·吕止庵《风入松》套曲：“常欢喜星前月下，休等闲间面北眉南。”元·乔吉《水仙子》曲"},"example":{"text":"传杯弄盏，知音品题，～，青鸾共骑，好一似摘天仙子下瑶池。","book":"《群音类选·〈玉环记·玉箫春怨〉》"},"similar":["月下星前"],"usage":"作宾语、定语；用于书面语"},{"id":24720,"word":"星夜兼路","pinyin":"xīng yè jiān lù","abbr":"xyjl","explanation":"星夜：有星光的夜路；兼路：走双倍的路程。形容连夜加倍地赶路。","source":{"text":"岱自表辄行，星夜兼路。","book":"《三国志·吴志·吕岱传》"}},{"id":24721,"word":"星奔川骛","pinyin":"xīng bēn chuān wù","abbr":"xbcw","explanation":"像流星飞驰，如江河涌流。形容迅速疾快。","source":{"text":"靡不望影星奔，藉响川骛，鸡人始唱，鹤盖成阴，高门旦开，流水接轸。","book":"南朝·梁·刘孝标《广绝交论》"},"example":{"text":"算存亡在鱼笺雁书，仗雄心要～。","book":"明·胡文焕《群音类选·》"},"usage":"作宾语、定语；用于比喻句"},{"id":24722,"word":"星奔川鹜","pinyin":"xīng bēn chuān wù","abbr":"xbcw","explanation":"像流星尽驰，如江河涌流。形容迅疾。","source":{"text":"靡不望影星奔，藉响川鹜。","book":"南朝·梁·刘峻《广绝交论》"},"example":{"text":"算存亡在鱼笺雁书，仗雄心要～。","book":"明·胡文焕《群音类选·八义记·平原发书》"}},{"id":24723,"word":"星奔电迈","pinyin":"xīng bēn diàn mài","abbr":"xbdm","explanation":"像流星飞奔，像闪电疾驰。形容非常迅疾。","source":{"text":"若敌泛舟顺流，舳舻千里，星奔电迈，俄然行至，非可恃援他部以救倒悬也。","book":"《三国志·吴志·陆抗传》"},"usage":"作宾语、定语；用于比喻句"},{"id":24724,"word":"星旗电戟","pinyin":"xīng qí diàn jǐ","abbr":"xqdj","explanation":"军旗象繁星，剑戟如闪电。比喻军容之盛。","example":{"text":"阅兵仪式上，我军～般的威武让人肃然起敬。"},"usage":"作宾语、定语；比喻军容之盛"},{"id":24725,"word":"星星之火","pinyin":"xīng xīng zhī huǒ","abbr":"xxzh","explanation":"一点点小火星。比喻开始时策小，但有远大发展前途的新事物。","source":{"text":"若火之燎于原，不可向迩。","book":"《书·盘庚上》"},"example":{"text":"～，可以燎原。"},"similar":["星火燎原"],"usage":"作主语、宾语；用于新生事物","story":["明朝时期，宰相张居正起用名将戚继光练兵对付倭寇的侵略，起用潘季驯治理黄河水灾。少数民族地区发生叛乱，他认为是贪官与无赖所为，起义军的力量是星星之火可以燎原，下令惩治贪官悍将，迅速平息了叛乱"]},{"id":24726,"word":"星星之火，可以燎原","pinyin":"xīng xīng zhī huǒ，kě yǐ liáo yuán","abbr":"xxzhkyly","explanation":"一点点小火星可以烧掉大片原野。比喻开始时微小，但有远大发展前途的新事物。","source":{"text":"若火之燎于原，不可向迩。","book":"《尚书·盘庚上》"},"example":{"text":"你不轻视了。～，不晓得怎么结局呢！","book":"张鸿《续孽海花》第57回"},"similar":["星火燎原"],"usage":"作宾语、定语、分句；用于新生事物","story":["明朝时期，宰相张居正起用名将戚继光练兵对付倭寇的侵略，起用潘季驯治理黄河水灾。少数民族地区发生叛乱，他认为是贪官与无赖所为，起义军的力量是星星之火可以燎原，下令惩治贪官悍将，迅速平息了叛乱"]},{"id":24727,"word":"星星之火，遂成燎原","pinyin":"xīng xīng zhī huǒ，suì chéng liáo yuán","abbr":"xxzhscly","explanation":"一点点小火星可以烧掉大片原野。比喻开始时微小，但有远大发展前途的新事物","source":{"text":"究观近年之事，皆起于不才武职、贪黩有司及四方无赖奸徒窜入其中激而构扇之，星星之火，遂成燎原。","book":"明·张居正《答云南巡抚何莱山论夷情》"},"similar":["星星之火，可以燎原"],"usage":"作宾语、定语、分句；用于新生事物","story":["明朝时期，宰相张居正起用名将戚继光练兵对付倭寇的侵略，起用潘季驯治理黄河水灾。少数民族地区发生叛乱，他认为是贪官与无赖所为，起义军的力量是星星之火可以燎原，下令惩治贪官悍将，迅速平息了叛乱"]},{"id":24728,"word":"星星点点","pinyin":"xīng xīng diǎn diǎn","abbr":"xxdd","explanation":"①形容多而分散。②形容少许或细碎。","source":{"text":"无数星星点点的火把在雾里闪耀着。","book":"曹禺《王昭君》第四幕"},"example":{"text":"对面的山坡上点缀着～的小花。"},"similar":["零零散散"],"opposite":["密密麻麻"],"usage":"作定语；形容数量小"},{"id":24729,"word":"星星落落","pinyin":"xīng xīng luò luò","abbr":"xxll","explanation":"形容少而分散。","source":{"text":"四周的田野上，已星星落落地有人在劳动了。","book":"《解放日报》1982.7.7"},"similar":["星星点点"],"usage":"作定语、状语；用于口语"},{"id":24730,"word":"星月交辉","pinyin":"xīng yuè jiāo huī","abbr":"xyjh","explanation":"星星和月亮交相照耀。","source":{"text":"至正月十五夜，天色晴霁，星月交辉，六行走三市，竞放花灯。","book":"宋·欧阳修《秋声赋》：“星月皎洁，明河在天。” 明·罗贯中《三国演义》第六十九回"},"example":{"text":"这三月十四日晚上，～，风清气爽。","book":"清·西周生《醒世姻缘传》第九十回"},"usage":"作谓语、定语；用于景物描写"},{"id":24731,"word":"星月皎洁","pinyin":"xīng yuè jiǎo jié","abbr":"xyjj","explanation":"星星和月亮明亮洁净。","source":{"text":"星月皎洁，明河在天。","book":"宋·欧阳修《秋声赋》"},"example":{"text":"我窗外没有花草，～的时候，我正在和蚊子战斗，后来又睡着了。","book":"鲁迅《集外集拾遗补编·无题》"},"usage":"作宾语、定语；用于景物描写"},{"id":24732,"word":"星桥火树","pinyin":"xīng qiáo huǒ shù","abbr":"xqhs","explanation":"形容节日的夜晚灯火辉煌的景色。","source":{"text":"火树银花合，星桥铁锁开。","book":"唐·苏味道《正月十五夜》诗"},"example":{"text":"～，长安一夜，开遍红莲万蕊。","book":"宋·张先《鹊桥仙》词"},"usage":"作宾语、定语；用于焰火或灯火"},{"id":24733,"word":"星流影集","pinyin":"xīng liú yǐng jí","abbr":"xlyj","explanation":"集：聚集，会合。像流星飞驰，影子汇聚。形容行动迅速","source":{"text":"星流景集，飙雷霆击，长驱山河，朝至暮捷若今者也。","book":"汉·陈琳《为曹洪与魏文帝书》"},"usage":"作宾语、状语；用于比喻句"},{"id":24734,"word":"星流电击","pinyin":"xīng liú diàn jī","abbr":"xldj","explanation":"形容迅猛异常。同“星流霆击”。","source":{"text":"更集诸部，倾国齐至，星流电击，数道俱进。","book":"《周书·晋荡公护传》"},"similar":["星流霆击"],"usage":"作宾语、状语；用于比喻句"},{"id":24735,"word":"星流电激","pinyin":"xīng liú diàn jī","abbr":"xldj","explanation":"激：急疾。像流星飞驰，闪电疾逝。形容迅疾","source":{"text":"故絪缊相感，雾涌云蒸，嘤鸣相召，星流电激。","book":"南朝·梁·刘峻《广绝交论》"},"similar":["星流电击"],"usage":"作宾语、状语；用于比喻句"},{"id":24736,"word":"星流霆击","pinyin":"xīng liú tíng jī","abbr":"xltj","explanation":"指如流星闪电。形容迅猛异常。","source":{"text":"乘遗风，射游骐，倏眒倩浰雷动猋至，星流霆击","book":"汉·司马相如《子虚赋》"},"similar":["星流电击","星流电激"],"usage":"作宾语、状语；用于比喻句"},{"id":24737,"word":"星火燎原","pinyin":"xīng huǒ liáo yuán","abbr":"xhly","explanation":"一点儿小火星可以把整个原野烧起来。常比喻新生事物开始时力量虽然很小，但有旺盛的生命力，前途无限。","source":{"text":"若火之燎于原，不可向迩。","book":"《尚书·盘庚上》"},"example":{"text":"‘～’的话，正是时局发展的适当的描写。","book":"毛泽东《星星之火，可以燎原》"},"similar":["星星之火","水滴石穿"],"usage":"作主语、谓语、定语；指新生事物"},{"id":24738,"word":"星灭光离","pinyin":"xīng miè guāng lí","abbr":"xmgl","explanation":"比喻朋友关系不能继续。","source":{"text":"昔君与我兮金石无亏，今君与我兮星灭光离。","book":"晋·傅玄《昔思君篇》"},"usage":"作谓语、定语；用于朋友间"},{"id":24739,"word":"星燧贸迁","pinyin":"xīng suí mào qiān","abbr":"xsmq","explanation":"燧：火镜，古代的取火器；贸：交易。比喻岁月变迁。","source":{"text":"星燧贸迁，江山阻隔。","book":"宋·叶廷珪《海录碎事·天·光景》引唐·段成式语"}},{"id":24740,"word":"星牖月窗","pinyin":"xīng yǒu yuè chuāng","abbr":"xyyc","explanation":"牖：窗户。指岩洞石窟前通光的孔窍。","source":{"text":"凡山洞岩穴，有窍通明，小者曰星牖，大者曰月窗。","book":"明·杨慎《艺林伐山·星牖月窗》"},"usage":"作宾语、定语；用于比喻句"},{"id":24741,"word":"星眸皓齿","pinyin":"xīng móu hào chǐ","abbr":"xmhc","explanation":"眸：眼珠；皓：白的样子。明亮的眼睛，洁白的牙齿。形容女子容貌美丽。比喻美女。","source":{"text":"家破人亡不为别，舍性命轻抛撇，则恋着星眸皓齿，杏脸莺舌。","book":"元·杨暹《刘行首》第三折"},"similar":["皓齿星眸"],"usage":"作宾语、定语、状语；用于女性"},{"id":24742,"word":"星离云散","pinyin":"xīng lí yún sàn","abbr":"xlys","explanation":"像流星和风雨一样迅速离散。比喻在一起的人纷纷别离了。","source":{"text":"当筵意气凌九宵，星离雨散不终朝。","book":"唐·李白《忆旧游寄谯郡元参军》诗"},"example":{"text":"往事像～般，转瞬即逝"},"usage":"作宾语、状语；用于比喻句"},{"id":24743,"word":"星离月会","pinyin":"xīng lí yuè huì","abbr":"xlyh","explanation":"犹言时分时合，时去时来。","source":{"text":"从此星离月会，积有年余。","book":"清·蒲松龄《聊斋志异·鬼妻》"},"usage":"作谓语、宾语；用于书面语"},{"id":24744,"word":"星离雨散","pinyin":"xīng lí yǔ sàn","abbr":"xlys","explanation":"比喻在一起的人纷纷别离了。","source":{"text":"当筵意气凌九宵，星离雨散不终朝。","book":"唐·李白《忆旧游寄谯郡元参军》诗"},"similar":["烟消云散"],"usage":"作谓语、定语；指事物迅速消失"},{"id":24745,"word":"星移斗换","pinyin":"xīng yí dǒu huàn","abbr":"xydh","explanation":"斗：北斗星。星斗变动位置。指季节或时间的变化。","source":{"text":"直睡的陵迁谷变，石烂松枯，斗转星移。","book":"元·马致远《陈抟高卧》第三折"},"example":{"text":"日往月来，星移斗换，不觉又十载有余。","book":"明·冯梦龙《喻世明言》卷三十"}},{"id":24746,"word":"星移斗转","pinyin":"xīng yí dǒu zhuǎn","abbr":"xydz","explanation":"斗：北斗星。星斗变动位置。指季节或时间的变化。","source":{"text":"直睡的陵迁谷变，石烂松枯，斗转星移。","book":"元·马致远《陈抟高卧》第三折"},"example":{"text":"抬头观看，～，正是三更时分。","book":"明·冯梦龙《醒世恒言·吕洞宾飞剑斩黄龙》"},"similar":["物换星移","斗转参横","斗转星移"],"usage":"作宾语、分句；用于时间或季节的变化"},{"id":24747,"word":"星移漏转","pinyin":"xīng yí lòu zhuǎn","abbr":"xylz","explanation":"星位移位，更漏转换。谓夜深。","source":{"text":"夜何其，星移漏转，凉蟾照无睡。","book":"明·刘基《花犯·秋夜》词"},"usage":"作宾语、定语；用于书面语"},{"id":24748,"word":"星移物换","pinyin":"xīng yí wù huàn","abbr":"xywh","explanation":"星移：星辰移位；物换：景物变幻。景物改变了，星辰的位置也移动了。比喻时间的变化。","source":{"text":"闲云潭影日悠悠，物换星移几度秋。","book":"唐·王勃《秋日登洪府滕王阁饯别序》"},"example":{"text":"任寒来暑往，～，得高眼昼。","book":"金·丘处机《水龙吟·春兴》词"},"usage":"作宾语、定语；用于书面语"},{"id":24749,"word":"星移电掣","pinyin":"xīng yí diàn chè","abbr":"xydc","explanation":"像流星闪电一样快速。形容速度很快。","source":{"text":"说时迟，那时疾，正如空中星移电掣相似，些儿迟慢不得。","book":"明·施耐庵《水浒传》第74回"},"similar":["星驰电掣"],"usage":"作宾语、状语；用于比喻句"},{"id":24750,"word":"星罗云布","pinyin":"xīng luó yún bù","abbr":"xlyb","explanation":"犹星罗棋布。形容数量很多，分布很广。","source":{"text":"列卒周匝，星罗云布。","book":"汉·班固《西都赋》"},"example":{"text":"地宝天花，～。","book":"唐·卢照邻《益州长史胡树礼为亡女造画赞》"},"similar":["星罗棋布"],"usage":"作宾语、定语、状语；用于书面语"},{"id":24751,"word":"星罗棋布","pinyin":"xīng luó qí bù","abbr":"xlqb","explanation":"罗：罗列；布：分布。象天空的星星和棋盘上的棋子那样分布着。形容数量很多，分布很广。","source":{"text":"列卒周匝，星罗云布。","book":"汉·班固《西都赋》"},"example":{"text":"到了晚上，那电气灯，自来火，～，照耀得彻夜通明，光辉如同白昼。","book":"清·彭养鸥《黑籍冤魂》第十五回"},"similar":["浩如烟海","漫山遍野","鳞次栉比"],"opposite":["寥若晨星"],"usage":"作谓语、定语、状语；形容数量多分布广"},{"id":24752,"word":"星落云散","pinyin":"xīng luò yún sàn","abbr":"xlys","explanation":"比喻惨败。","source":{"text":"这大圣把金箍棒幌一幌，碗来粗细，把那伙贼打得星落云散。","book":"明·吴承恩《西游记》第五十六回"},"example":{"text":"杀的童贯三军人马，大败亏输，～，七损八伤。","book":"明·施耐庵《水浒传》第七十七回"},"similar":["七零八落"],"usage":"作谓语、定语；指零乱"},{"id":24753,"word":"星行夜归","pinyin":"xīng xíng yè guī","abbr":"xxyg","explanation":"天没亮就出去，天黑了才回来。","source":{"text":"幼孤贫，养亲以孝闻，睦于兄弟，每采梠求食，星行夜归。","book":"《晋书·隐逸传·夏统传》"},"usage":"作谓语、状语；用于处事"},{"id":24754,"word":"星行电征","pinyin":"xīng xíng diàn zhēng","abbr":"xxdz","explanation":"象流星闪电。比喻奔驰迅速。","source":{"text":"望自劾去，星行电征，数日归，趋诣府。","book":"汉·应劭《风俗通·十反》"},"usage":"作谓语、定语；比喻行动非常迅速"},{"id":24755,"word":"星言夙驾","pinyin":"xīng yán sù jià","abbr":"xysj","explanation":"言：语助词，无义；夙：早。星夜驾车行驶。","source":{"text":"星言夙驾，说于桑田。","book":"《诗经·鄘风·定之方中》"},"example":{"text":"公宜露营野次，～，伏轼怒蛙以募勇士，悬胆于庭以表辛苦。","book":"《晋书·顾荣传》"},"similar":["星陈夙驾"],"usage":"作谓语；用于书面语"},{"id":24756,"word":"星辰夙驾","pinyin":"xīng chén sù jià","abbr":"xcsj","explanation":"陈：列；夙：早。星夜驾车行驶。","source":{"text":"肃承明诏，应会皇都，星陈夙驾，秣马脂车。","book":"《三国志·魏志·陈思王植传》"}},{"id":24757,"word":"星陈夙驾","pinyin":"xīng chén sù jià","abbr":"xcsj","explanation":"陈：列；夙：早。星夜驾车行驶。","source":{"text":"肃承明诏，应会皇都，星陈夙驾，秣马脂车。","book":"三国·魏·曹植《应诏》"},"example":{"text":"仲秋之晨，启明始出。～，灵舆结驷。","book":"《晋书·左贵嫔传》"},"similar":["星言夙驾"],"usage":"作谓语、宾语；用于书面语"},{"id":24758,"word":"星霜屡移","pinyin":"xīng shuāng lǚ yí","abbr":"xsly","explanation":"星霜：星辰运转，一年循环一次，每年秋季降霜，因此以星霜指代年岁。表示岁月更换。","source":{"text":"星霜屡移，书奏仍阙。","book":"唐·高适《为东平薛太守进王氏瑞诗表》"},"usage":"作宾语；表示岁月更换"},{"id":24759,"word":"星霜荏苒","pinyin":"xīng shuāng rěn rǎn","abbr":"xsrr","explanation":"星霜：星辰运转一年一次循环，每年秋季始降霜，因以批岁月。指岁月渐渐流逝。","source":{"text":"星霜荏苒无音信，烟水微茫变姓名。","book":"唐·温庭筠《寄崔先生》"},"similar":["岁月荏苒","光阴荏苒"],"usage":"作宾语、定语；指时间飞快地流逝"},{"id":24760,"word":"星飞云散","pinyin":"xīng fēi yún sàn","abbr":"xfys","explanation":"比喻事物四处分散或四散消失。","source":{"text":"自唐以后至于本朝，以和戎为国是，千里之州……无有捍蔽，一旦胡尘猝起，星飞云散，无有能自保者。","book":"宋·叶適《安集两淮申省状》"},"example":{"text":"普风招呼众军上前冲杀一阵，杀得宋兵～，往后逃命不及。","book":"清·钱彩《说岳全传》第七十八回"},"usage":"作宾语、状语；用于书面语"},{"id":24761,"word":"星飞电急","pinyin":"xīng fēi diàn jí","abbr":"xfdj","explanation":"如流星飞落，如闪电急驰。形容十分急速或事情非常紧急。","source":{"text":"合火速便驰驿，等回音，星飞电急。","book":"元·施惠《拜月亭·奉命和番》"},"similar":["星驰电掣"],"usage":"作宾语、状语；用于比喻句"},{"id":24762,"word":"星驰电发","pinyin":"xīng chí diàn fā","abbr":"xcdf","explanation":"指迅速如流星闪电。","source":{"text":"若星驰电发，出其不虞，精骑五百，自足平殄。","book":"北魏·高允《北伐颂》：“跃马裹粮，星驰电发。”《周书·段永传》"},"example":{"text":"清·李调元《尾蔗丛谈·复社事实》：“或号行舟太保，传檄则～，宴会则酒池肉林。”"},"similar":["星驰电掣","星驰电走"],"opposite":["磨磨蹭蹭"],"usage":"作宾语、定语；指迅速","story":["南北朝时期，叛乱首领元伯生在边关作乱，魏孝武帝决定派京畿大都督匹娄昭去平叛。匹娄昭要求派5000精兵，而段永认为这些人是乌合之众，对付他们的办法是星驰电发般的速度。他带领500精兵在叛军不设防的情况下一举全歼灭"]},{"id":24763,"word":"星驰电掣","pinyin":"xīng chí diàn chè","abbr":"xcdc","explanation":"驰：奔驰。象星疾驰，如电急闪。形容极其迅速。","source":{"text":"若星驰电发，出其不虞，精骑五百，自足平殄。","book":"《周书·段永传》"},"example":{"text":"好容易才把贵廷拉出旅馆，拖上火车，～的赶到前方。","book":"蔡东藩、许廑父《民国通俗演义》第一二三回"},"similar":["星移电掣"],"usage":"作宾语、状语；用于比喻句"},{"id":24764,"word":"星驰电走","pinyin":"xīng chí diàn zǒu","abbr":"xcdz","explanation":"驰：奔驰；走：跑。象星疾驰，如电急闪。形容极其迅速。","source":{"text":"腿上无毛嘴有髭，星驰电走不违时，沿河两岸长巡哨，以此加为排岸司。","book":"元·杨显之《潇湘雨》楔子"},"example":{"text":"好容易才把贵廷拉出旅馆，拖上火车，星驰电掣的赶到前方。","book":"蔡东藩、许廑父《民国通俗演义》第一二三回"},"similar":["星驰电发","星驰电掣"],"usage":"作定语、状语；形容极其迅速"},{"id":24765,"word":"星驾席卷","pinyin":"xīng jià xí juǎn","abbr":"xjxj","explanation":"星驾：连夜驾车出行；席卷：像卷席子一样，包括无余。指连夜驾车，全部出动，迅速驰行。","source":{"text":"会公孙瓒师旅南驰，陆掠北境，臣即星驾席卷，与瓒交锋。","book":"《后汉书·袁绍传》"},"usage":"作谓语；用于书面语"},{"id":24766,"word":"映月读书","pinyin":"yìng yuè dú shū","abbr":"yyds","explanation":"利用月光来照明读书。形容家境清贫，勤学苦读。","source":{"text":"泌少贫，昼日斫屧为业，夜读书随月光，光斜则握卷升屋，睡极堕地则更登。","book":"《南齐书·江泌传》"},"example":{"text":"休强呵～，且免了这扫雪烹茶。","book":"元·苏彦文《冬景》"},"similar":["映雪读书"],"usage":"作谓语、定语；指勤奋读书","story":["南朝人江泌小时家贫，白天要帮助家里做些杂活维持生计，晚上他抓紧时间来学习，由于买不起烛火，就只有站在月光底下读书，月亮西坠。他爬上梯子接着读，经常因困倦从梯子上摔下，爬起来后接着读书"]},{"id":24767,"word":"映雪囊萤","pinyin":"yìng xuě náng yíng","abbr":"yxny","explanation":"形容夜以继日，苦学不倦。","source":{"text":"既笔耕为养，亦拥书成学，至乃集萤映雪，编蒲辑柳。","book":"南朝·梁·任昉《为萧扬州荐士表》"},"example":{"text":"十年～，苦学干禄，幸首获州庠乡举。","book":"元·施惠《幽闺记·书帏自叹》"},"usage":"作宾语、定语；用于书面语"},{"id":24768,"word":"映雪读书","pinyin":"yìng xuě dú shū","abbr":"yxds","explanation":"利用雪的反光读书。形容读书刻苦。","source":{"text":"晋孙康家贫，常映雪读书，清介，交游不杂。","book":"南朝·梁·任彦升《为萧扬州荐士表》：“至乃集萤映雪，编蒲缉柳。”注引《孙氏世录》"},"example":{"text":"孙康，晋京兆人，性敏好学，家贫无没，尝于冬月～。","book":"明·廖用贤《尚友录》卷四"},"similar":["孙康映雪"],"usage":"作谓语、定语；指勤奋读书","story":["晋代孙康因为家贫没钱买灯油，晚上不能看书，他觉得非常可惜，白白地浪费光阴。一天外面下起了很大的雪，半夜梦醒，见一丝亮光从窗缝里钻进来，原来是大雪映出来的，他起身对着亮光看起书来。经过他刻苦努力终于成为饱学之士"]},{"id":24769,"word":"春事阑珊","pinyin":"chūn shì lán shān","abbr":"csls","explanation":"阑珊：将尽，将衰。指春天就要过去了。","source":{"text":"柳絮绵花飘瓣，又一番春事阑珊。","book":"元·方伯成《端正好·忆别》套曲"},"similar":["春意阑珊"],"usage":"作谓语、定语、状语；用于描写春天"},{"id":24770,"word":"春光如海","pinyin":"chūn guāng rú hǎi","abbr":"cgrh","explanation":"形容大地充满了明媚的春光。","source":{"text":"不知什么地方送来蜜蜂的嗡嗡声，似乎带着花和香气；正所谓春光如海呢！","book":"叶圣陶《春光不是她的了》"},"usage":"作宾语、定语；用于景物等"},{"id":24771,"word":"春光明媚","pinyin":"chūn guāng míng mèi","abbr":"cgmm","explanation":"明媚：美好，可爱。形容春天的景物鲜明可爱。","source":{"text":"时遇着春光明媚，人贺丰年，民乐雍熙。","book":"元·宋方壶《斗鹌鹑·踏青》套曲"},"example":{"text":"行够多少山原，历尽无穷水道，不觉的秋去冬残，又值～。","book":"明·吴承恩《西游记》第七十二回"},"similar":["春暖花开","花红柳绿"],"opposite":["天寒地冻"],"usage":"作谓语、状语、定语；形容春天的风光"},{"id":24772,"word":"春光漏泄","pinyin":"chūn guāng lòu xiè","abbr":"cglx","explanation":"原指柳枝泛绿，透露了春天将至的信息。比喻秘密或男女的私情被泄漏出来。","source":{"text":"侵陵雪色还萱草，漏泄春光有柳条。","book":"唐·杜甫《腊日》"},"example":{"text":"呀，这～，怎地开交？","book":"清·洪昇《长生殿·絮阁》"},"similar":["泄漏春光"],"usage":"作宾语；指男女私情"},{"id":24773,"word":"春兰秋菊","pinyin":"chūn lán qiū jú","abbr":"clqj","explanation":"春天的兰花，秋天的菊花。比喻各有值得称道的地方。","source":{"text":"春兰兮秋菊，长无绝兮终古。","book":"战国·楚·屈原《九歌·礼魂》"},"example":{"text":"所恨芳林寥落甚，～不同时。","book":"鲁迅《偶成》诗"},"similar":["各有千秋","各有所长"],"opposite":["半斤八两"],"usage":"作主语、宾语；比喻各有特色和专长"},{"id":24774,"word":"春冰虎尾","pinyin":"chūn bīng hǔ wěi","abbr":"cbhw","explanation":"踩着老虎尾巴，走在春天将解冻的冰上。比喻处境非常危险。","source":{"text":"心之忧危，若蹈虎尾，涉于春冰。","book":"《尚书·君牙》"},"example":{"text":"延光等深言邪蒿～之戒，欲惊悟上意。","book":"宋·孙光宪《北梦琐言》卷二十"},"similar":["虎尾春冰"],"usage":"作定语、宾语；指危险的边缘"},{"id":24775,"word":"春华秋实","pinyin":"chūn huá qiū shí","abbr":"chqs","explanation":"华：花。春天开花，秋天结果。比喻人的文采和德行。现也比喻学习有成果。","source":{"text":"《三国志·魏志·刑颙传》：“而桢礼遇殊荣，颙反疏简，私惧观者将谓君侯习近不肖，礼贤不足，采庶子之春华，忘家丞之秋实。”《后汉书》卷五十二：“春发其华，秋收其实，有始有极，爱登其质。"},"example":{"text":"～，没有那浩荡的春风，又哪里会有这满野秋色和大好的收成呢？","book":"峻青《秋色赋》"},"similar":["开花结果"],"opposite":["华而不实"],"usage":"作主语、宾语、分句；用于比喻句"},{"id":24776,"word":"春去冬来","pinyin":"chūn qù dōng lái","abbr":"cqdl","explanation":"春天过去，冬天来临。形容时光流逝。","source":{"text":"不然，厉兵秣马，春去冬来，使贼兵疲于奔命，俟其势衰，收之未晚。","book":"宋·无名氏《新编五代史平话·周史》"},"example":{"text":"～事宛然也。","book":"宋·释普济《五灯会元》卷五十一"},"similar":["春来秋去"],"usage":"作状语、分句；指时光流逝"},{"id":24777,"word":"春去夏来","pinyin":"chūn qù xià lái","abbr":"cqxl","explanation":"春天过去，夏天到来。形容时光流逝。","example":{"text":"～年复年，生歌死哭长相守。"},"similar":["秋去冬来"],"usage":"作宾语、状语；形容时光流逝"},{"id":24778,"word":"春去秋来","pinyin":"chūn qù qiū lái","abbr":"cqql","explanation":"春天过去，秋天到来。形容时光流逝。","source":{"text":"春去秋来年复年，生歌死哭长相守。","book":"明·刘基《大堤曲》"},"example":{"text":"～，他觉得自己真的老了。"},"similar":["春去夏来"],"usage":"作状语、分句；指时光流逝"},{"id":24779,"word":"春和景明","pinyin":"chūn hé jǐng míng","abbr":"chjm","explanation":"春光和煦，风景鲜明艳丽。","source":{"text":"至若春和景明，波澜不惊，上下天光，一碧万顷。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"小生许久不与他会面。喜今日～，昼闲无事，不免去看他一遭。","book":"明·王錂《春芜记·访友》"},"similar":["春光明媚"],"usage":"作谓语、定语；指春天"},{"id":24780,"word":"春回大地","pinyin":"chūn huí dà dì","abbr":"chdd","explanation":"好像春天又回到大地。形容严寒已过，温暖和生机又来到人间。","source":{"text":"树头雪过梅犹在，地上春回柳未知。","book":"宋·周紫芝《太仓稊米集·岁杪雨雪连日闷题二首》"},"example":{"text":"广乐奏钧天，万国衣冠。同瞻旭日，阳～。","book":"清·梁章钜《楹联丛话·应制·养性殿》"},"similar":["大地回春"],"usage":"作宾语、定语；多用于比喻句"},{"id":24781,"word":"春困秋乏","pinyin":"chūn kùn qiū fá","abbr":"ckqf","explanation":"困：困倦；乏：疲劳。春秋季节天气容易使人感到困倦疲乏。"},{"id":24782,"word":"春夏秋冬","pinyin":"chūn xià qiū dōng","abbr":"cxqd","explanation":"指四季或一年。","source":{"text":"只见绿一团，红一簇，也不分春夏秋冬，万卉千花，尽皆铺缀。","book":"清·褚人获《隋唐演义》第28回"},"example":{"text":"钱钟书《围城》：“好比女人穿中西各色～的服装，做出支颐扭额、行立坐卧种种姿态，照成一张张送人留念的照相。”"},"usage":"作宾语、定语；用于时间"},{"id":24783,"word":"春宵一刻","pinyin":"chūn xiāo yī kè","abbr":"cxyk","explanation":"欢娱难忘的美好时刻。","source":{"text":"春宵一刻值千金，花有清香月有阴。","book":"宋·苏轼《春夜》"},"example":{"text":"～价难求，莫将春误，徒为春愁。","book":"明·胡文焕《群音类选·完扇记·携美游春》"},"usage":"作主语、宾语；指美好的时刻"},{"id":24784,"word":"春宵苦短","pinyin":"chūn xiāo kǔ duǎn","abbr":"cxkd","explanation":"为春天的夜晚太短而苦恼。形容人处在欢乐之中，觉得时间过得很快。","source":{"text":"春宵苦短日高起，从此君王不早朝。","book":"唐·白居易《长恨歌》"}},{"id":24785,"word":"春寒料峭","pinyin":"chūn hán liào qiào","abbr":"chlq","explanation":"料峭：微寒。形容初春的寒冷。","source":{"text":"春寒料峭，冻杀年少。","book":"宋·释普济《五灯会元》卷十九"},"example":{"text":"那是一个阴冷的漆黑之夜。～，风雨凄凄。","book":"何为《春夜的沉思和回忆》"},"similar":["料峭轻寒"],"opposite":["春风和煦"],"usage":"作谓语、定语；形容春天的寒冷天气"},{"id":24786,"word":"春山八字","pinyin":"chūn shān bā zì","abbr":"csbz","explanation":"八字：喻指眉毛。漂亮的眉毛，宛如淡淡的春山。形容女子眉毛秀美。","source":{"text":"春山八字争妍媚，姨姨妹妹皆殊丽。","book":"明·李昌祺《剪灯余话·江庙泥神记》"},"usage":"作宾语、定语；用于书面语"},{"id":24787,"word":"春山如笑","pinyin":"chūn shān rú xiào","abbr":"csrx","explanation":"形容春天的山色明媚。","source":{"text":"春山澹冶而如笑，夏山苍翠而如滴，秋山明净而如妆，冬山惨淡而如睡。","book":"宋·郭熙《林泉高致·山水训》"},"usage":"作谓语、宾语；指春天"},{"id":24788,"word":"春归人老","pinyin":"chūn guī rén lǎo","abbr":"cgrl","explanation":"春：春光，比喻花容月貌。指女人青春已过，人老珠黄。","source":{"text":"柳翠也。只怕你春归人老，花残月缺，树倒根催。","book":"元·李寿卿《度柳翠》第三折"},"similar":["人老珠黄"],"usage":"作谓语、定语；多用于女性"},{"id":24789,"word":"春意盎然","pinyin":"chūn yì àng rán","abbr":"cyar","explanation":"意：意味；盎然：洋溢，深厚。春天的意味正浓。","source":{"text":"阿七笑了，笑得极甜，加上她那水银流转似的秋波，春意盎然。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"北国依然春寒料峭，南国却已～了。"},"similar":["春色满园"],"opposite":["春寒料峭","春意阑珊"],"usage":"作谓语、定语、状语；用于描写春天"},{"id":24790,"word":"春意阑珊","pinyin":"chūn yì lán shān","abbr":"cyls","explanation":"阑珊：将尽，将衰。指春天就要过去了。","source":{"text":"帘外雨潺潺，春意阑珊。","book":"南唐·李煜《浪淘沙》"},"example":{"text":"柳飞绵花瓢瓣，又一番～。(元·方伯成《端正好·忆别》)"},"similar":["春事阑珊"],"usage":"作谓语、定语、状语；用于描写春天"},{"id":24791,"word":"春晖寸草","pinyin":"chūn huī cùn cǎo","abbr":"chcc","explanation":"春晖：春天的阳光；比喻父母对儿女的慈爱抚养。寸草：一寸长的小草；比喻子女对父母的养育之恩的无限感戴心情。","source":{"text":"谁言寸草心，报得三春晖。","book":"唐·孟郊《游子吟》"},"example":{"text":"～恋亲慈，百蹈危机总未知。","book":"柳亚子《吊刘烈士炳生》"},"similar":["寸草春晖"],"usage":"作宾语、定语；指亲情"},{"id":24792,"word":"春暖花开","pinyin":"chūn nuǎn huā kāi","abbr":"cnhk","explanation":"春天气候温暖，百花盛开，景色优美。比喻游览、观赏的大好时机。","source":{"text":"明·朱国祯《涌幢小品·南内》：“春暖花开，命中贵陪内阁儒臣宴赏。"},"example":{"text":"～，我好引着孩子们园里做活。","book":"清·李绿园《歧路灯》第40回"},"similar":["大地回春","百花齐放"],"opposite":["天寒地冻","冰天雪地"],"usage":"作主语、分句、定语；比喻良好的时机"},{"id":24793,"word":"春暖花香","pinyin":"chūn nuǎn huā xiāng","abbr":"cnhx","explanation":"春天气候温暖，百花盛开，花香袭人。","source":{"text":"春暖花香，岁稔时康。","book":"元·奥敦周卿《蟾宫曲》"},"example":{"text":"～，和风淡荡。我则见东郊上，男女成行，处处闲游赏。","book":"明·无名氏《打韩通》"},"similar":["春暖花开"],"usage":"作宾语、定语；形容春天美丽的景色"},{"id":24794,"word":"春来秋去","pinyin":"chūn lái qiū qù","abbr":"clqq","explanation":"去：过去。春天到来，秋天过去。形容岁月流逝。","source":{"text":"春来秋去泉东泻，芳颜不似前潇洒。","book":"明·胡文焕《群音类选·清腔类·山坡羊》"},"example":{"text":"～容易过，思儿念女泪沾裳。","book":"明·高濂《玉簪记·合庆》"},"similar":["春去秋来","春去冬来"],"usage":"作状语、分句；指时光流逝"},{"id":24795,"word":"春树暮云","pinyin":"chūn shù mù yún","abbr":"csmy","explanation":"表示对远方友人的思念。","source":{"text":"渭北春天树，江东日暮云。何时一樽酒，重与细论文？","book":"唐·杜甫《春日忆李白》诗"},"example":{"text":"诵～之句。","book":"宋·胡继宗《书言故事·瞻仰》"},"similar":["暮云春树"],"usage":"作宾语、定语；表示对远方友人的思念"},{"id":24796,"word":"春梦一场","pinyin":"chūn mèng yī chǎng","abbr":"cmyc","explanation":"比喻过去的一切转眼成空。也比喻不切实际的想法落了空。","source":{"text":"倚柱寻思倍惆怅，一场春梦不分明。","book":"唐·张泌《寄人》诗"},"example":{"text":"人生数十年，宛如～。","book":"金庸《碧血剑》第二十回"}},{"id":24797,"word":"春梦无痕","pinyin":"chūn mèng wú hén","abbr":"cmwh","explanation":"比喻世事变幻，如春夜的梦境一样容易消逝，不留一点痕迹。","source":{"text":"人似秋鸿来有信，事如春梦了无痕。","book":"宋·苏轼《与潘郭二生出郊寻春》诗"},"usage":"作宾语；比喻世事变幻"},{"id":24798,"word":"春深似海","pinyin":"chūn shēn sì hǎi","abbr":"cssh","explanation":"春天美丽的景色像大海一样深广。形容到处充满了明媚的春光。","source":{"text":"这屋里那块‘四乐堂’的匾，可算挂定了！不然，这‘春深似海’的屋子，也就难免‘愁深似海’。","book":"清·文康《儿女英雄传》第30回"},"example":{"text":"不见茶花，你是不容易懂得‘～’这句诗的妙处的。","book":"阳朔《茶花赋》"},"similar":["春光如海"],"usage":"作定语、补语；指春天"},{"id":24799,"word":"春满人间","pinyin":"chūn mǎn rén jiān","abbr":"cmrj","explanation":"生机勃勃的春意溢满人间。","source":{"text":"山亭尝自绝浮埃，山路辉光五马来。春满人间不知主，谁言炉冶此中开？","book":"宋·曾巩《元丰类稿·班春亭》"},"example":{"text":"流莺恰似无机械，～亦未知。","book":"宋·彭汝砺《鄱阳集·二月己亥晓出城祀高禖》"},"similar":["大地回春"],"opposite":["暮气沉沉"],"usage":"作主语、宾语；指有生气"},{"id":24800,"word":"春生夏长，秋收冬藏","pinyin":"chūn shēng xià zhǎng，qiū shōu dōng cáng","abbr":"csxzqsdc","explanation":"春天萌生，夏天滋长，秋天收获，冬天储藏。指农业生产的一般过程。亦比喻事物的发生、发展过程。","source":{"text":"夫春生夏长，秋收冬藏，此天道之大经也。弗顺则无以为天下纲纪。","book":"《史记·太史公自序》"},"usage":"作主语、宾语、分句；比喻事物的发生、发展"},{"id":24801,"word":"春生秋杀","pinyin":"chūn shēng qiū shā","abbr":"csqs","explanation":"春天万物萌生，秋天万物凋零。","source":{"text":"伏惟文武孝德皇帝陛下：君临八表，子育群生，合天覆地载之德，顺春生秋杀之令。","book":"唐·白居易《贺杀贼表》"},"usage":"作定语；指自然规律"},{"id":24802,"word":"春祈秋报","pinyin":"chūn qí qiū bào","abbr":"cqqb","explanation":"祈：迷信的人向神恳求。古时春秋两季祭祀土神，春耕时祈祷风调雨顺，秋季报答神功。","source":{"text":"既谋事求助，致敬民神，春祈秋报，故次《载芟》《良吕也》。","book":"唐·孔颖达《诗经·周颂谱》疏"},"usage":"作宾语、定语；用于祈祷等"},{"id":24803,"word":"春秋之义","pinyin":"chūn qiū zhī yì","abbr":"cqzy","explanation":"春秋时代通行的义法，即以王命为重，处理好上下、大小的关系。","source":{"text":"春秋之义，不以家事废王事，今子以兄弟私恩，而绝父不灭基，可谓智乎？","book":"《后汉书·丁鸿传》"}},{"id":24804,"word":"春秋无义战","pinyin":"chūn qiū wú yì zhàn","abbr":"cqwyz","explanation":"春秋时代没有正义的战争。也泛指非正义战争。","source":{"text":"孟子曰：‘春秋无义战。’","book":"《孟子·尽心下》"},"example":{"text":"古人说：“～。”于今帝国主义则更加无义战，只有被压迫民族和被压迫阶级有义战。","book":"毛泽东《论反对日本帝国主义的策略》"},"usage":"作宾语；指非正义战争"},{"id":24805,"word":"春秋积序","pinyin":"chūn qiū jī xù","abbr":"cqjx","explanation":"春秋：指时间、年龄。年龄一年又一年的累积增加。","source":{"text":"以其春秋积序，容状不衰。","book":"唐·李朝威《柳毅传》"}},{"id":24806,"word":"春秋笔法","pinyin":"chūn qiū bǐ fá","abbr":"cqbf","explanation":"指寓褒贬于曲折的文笔之中。","source":{"text":"孔子在位听讼，文辞有可与人共者，弗独有也。至于为《春秋》，笔则笔，削则削，子夏之徒不能赞一词。","book":"《史记·孔子世家》"},"example":{"text":"初意却不过贪图少写一个字，并非有什么～。","book":"鲁迅《热风·反对“含泪”的批评家》"},"usage":"作主语、宾语；指曲折的文字"},{"id":24807,"word":"春秋责备贤者","pinyin":"chūn qiū zé bèi xián zhě","abbr":"cqzbxz","explanation":"春秋：孔子修订《春秋》书；贤者：指才德兼备的人。指《春秋》书对贤者常常责备，严格要求。","source":{"text":"然《春秋》书中，常责备贤者，是以后世君子之欲成人之美者，莫不叹息于斯焉。","book":"《新唐书·太宗纪赞》"},"example":{"text":"～，未可以士大夫之义律儿女子。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录》"},"usage":"作宾语、定语；用于批评"},{"id":24808,"word":"春秋鼎盛","pinyin":"chūn qiū dǐng shèng","abbr":"cqds","explanation":"春秋：指年龄；鼎盛：正当旺盛之时。比喻正当壮年。","source":{"text":"天子春秋鼎盛，行义未过，德泽有加焉。","book":"汉·贾谊《新书·宗首》"},"example":{"text":"及入宫庭，见王～，妾非敢怨王，但自叹生不及时耳！","book":"明·冯梦龙《东周列国志》第七十一回"},"similar":["年富力强","年轻力壮"],"opposite":["奄奄一息","风中残烛","日落西山"],"usage":"作谓语、定语；比喻正当壮年"},{"id":24809,"word":"春笋怒发","pinyin":"chūn sǔn mù fā","abbr":"csnf","explanation":"春天的竹笋迅速茂盛地生长。比喻好事层出不穷地产生。"},{"id":24810,"word":"春色恼人","pinyin":"chūn sè nǎo rén","abbr":"csnr","explanation":"恼：撩拔，挑逗。春天的景色引起人们的兴致。","source":{"text":"金炉香尽漏声残，翦翦轻风阵阵寒；春色恼人眠不得，月移花影上栏干。","book":"宋·王安石《夜直》诗"},"similar":["春色撩人"],"usage":"作宾语、定语；用于春天的景色"},{"id":24811,"word":"春色撩人","pinyin":"chūn sè liáo rén","abbr":"cslr","explanation":"撩：撩拔，挑逗、招惹。春天的景色引起人们的兴致。","source":{"text":"桃花烂漫杏花稀，春色撩人不忍为。","book":"宋·陆游《剑南诗稿·山园杂咏五首》"},"example":{"text":"老穷只是诗困我，～又成句。","book":"宋·杨万里《长句寄周人子充》"},"similar":["春色恼人"],"usage":"作宾语、定语；用于春天的景色"},{"id":24812,"word":"春色满园","pinyin":"chūn sè mǎn yuán","abbr":"csmy","explanation":"园内到处都是春天美丽的景色。比喻欣欣向荣的景象。","source":{"text":"应怜屐齿印苍苔，小扣柴扉久不开。春色满园关不住，一枝红杏出墙来。","book":"宋·叶绍翁《游小园不值》诗"},"example":{"text":"繁荣的市场如同～，橱窗就像一枝红杏。"},"similar":["万紫千红"],"opposite":["冰天雪地","天寒地冻"],"usage":"作谓语、定语、宾语；用于春天的景象"},{"id":24813,"word":"春花秋实","pinyin":"chūn huā qiū shí","abbr":"chqs","explanation":"春天开花，秋天结果。比喻人的文采和德行。现也比喻学习有成果。","source":{"text":"杨州钞关官署东隅，有银杏树一株，其大数围，直干凌霄，春花秋实。","book":"清·钱泳《履园丛活·梦幻·永和银杏》"},"similar":["春华秋实"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":24814,"word":"春花秋月","pinyin":"chūn huā qiū yuè","abbr":"chqy","explanation":"春天的花朵，秋天的月亮。泛指春秋美景。","source":{"text":"春花秋月何时了，往事知多少。","book":"南唐·李煜《虞美人》词"},"example":{"text":"冬天去了，春天又回来了。吟诵这些诗句，～，一年四季都沉醉在诗的意境里。","book":"于漪《我与〈千家诗〉》"},"usage":"作主语、宾语；指春秋佳景","story":["公元960年，赵匡胤陈桥兵变建立宋朝，大举进攻与消灭了南平、后蜀、南汉等国。南唐后主李煜不问朝政，只会吟诗作词，被宋朝打败，投降后被封为违命侯。李煜感慨地作词：“春花秋月何时了，往事知多少！”"]},{"id":24815,"word":"春葩丽藻","pinyin":"chūn pā lì zǎo","abbr":"cplz","explanation":"比喻美妙的言谈。","source":{"text":"李白与人谈论，皆成句读，如春葩丽藻，粲于齿牙，时号李白粲花之论。","book":"唐·冯贽《云仙杂记·粲花》"},"usage":"作宾语、定语；用于说话等"},{"id":24816,"word":"春蚓秋蛇","pinyin":"chūn yǐn qiū shé","abbr":"cyqs","explanation":"比喻字写得不好，弯弯曲曲，象蚯蚓和蛇爬行的痕迹。","source":{"text":"行之若萦春蚓，字字如绾秋蛇。","book":"《晋书·王羲之传》"},"example":{"text":"蜂腰鹤膝嘲希逸，～病子云。","book":"宋·苏轼《和孔密州五绝·和流杯石上草书小诗》"},"similar":["春蛇秋蚓"],"usage":"作宾语、定语；用于书法等"},{"id":24817,"word":"春蚕到死丝方尽","pinyin":"chūn cán dào sǐ sī fāng jìn","abbr":"ccdssfj","explanation":"丝：双关语，“思”的谐音。比喻情深谊长，至死不渝。","source":{"text":"春蚕到死丝方尽，蜡炬成灰泪始干。","book":"唐·李商隐《无题》诗"},"example":{"text":"人都有～的时候。"},"similar":["蜡烛成灰泪始干"],"usage":"作宾语、定语；指竭力奉献"},{"id":24818,"word":"春蚕抽丝","pinyin":"chūn cán chōu sī","abbr":"cccs","explanation":"蚕：昆虫名；抽：拔出。形容人的思绪、言谈牵扯无尽。","source":{"text":"聊起来也定会如春蚕抽丝，而总无尽意吧。","book":"陈波《漫谈聊天》"},"usage":"作宾语、定语；用于比喻句"},{"id":24819,"word":"春蚕自缚","pinyin":"chūn cán zì fù","abbr":"cczf","explanation":"缚：缠束，捆绑。像春天的蚕作茧那样，自己把自己缠束起来。","source":{"text":"掉句文，便叫做痴鼠拖姜，春蚕自缚。","book":"清·文康《儿女英雄传》第二十二回"},"similar":["作茧自缚"],"usage":"作宾语、定语；用于处事"},{"id":24820,"word":"春蛇秋蚓","pinyin":"chūn shé qiū yǐn","abbr":"csqy","explanation":"比喻字写得不好，弯弯曲曲，象蚯蚓和蛇爬行的痕迹。","source":{"text":"近世以来，徇末而忘本，濡毫行墨，春蛇秋蚓之连翩。","book":"明·宋濂《序》"},"similar":["春蚓秋蛇"],"usage":"作宾语、定语；用于书法等"},{"id":24821,"word":"春蛙秋蝉","pinyin":"chūn wā qiū chán","abbr":"cwqc","explanation":"春天蛙叫，秋天蝉鸣。比喻喧闹夸张、空洞无物的言谈。","source":{"text":"夫虚无之谈，尚其华藻，此无异于春蛙秋蝉，聒舌而已。","book":"晋·杨泉《物理论》"},"usage":"作主语、宾语；指空洞无物的言谈"},{"id":24822,"word":"春袗轻筇","pinyin":"chūn zhěn qīng qióng","abbr":"czqq","explanation":"袗：单衣；筇：竹子的一种，可做手杖。单衣轻杖。形容身体轻快。"},{"id":24823,"word":"春诵夏弦","pinyin":"chūn sòng xià xián","abbr":"csxx","explanation":"诵、弦：古代学校里读诗，只口诵的叫“诵”，用乐器配合的叫“弦”。原指应根据季节采取不同的学习方式。后泛指读书、学习。","source":{"text":"春诵夏弦，大师诏之。","book":"《礼记·文王世子》"},"example":{"text":"入于门墙，如造阙里。～，载飏淑声。","book":"唐·刘禹锡《许州文宣王新庙碑》"},"usage":"作谓语；泛指读书学习"},{"id":24824,"word":"春雨如油","pinyin":"chūn yǔ rú yóu","abbr":"cyry","explanation":"春雨贵如油。形容春雨可贵。","source":{"text":"春雨贵如油，下得满街流，滑倒解学士，笑坏一群牛。","book":"宋·释道原《景德传灯录》卷一：“春雨一滴滑如油。”  明·解缙《春雨》"},"similar":["春雨贵如油"],"usage":"作谓语；比喻春天的雨水稀少"},{"id":24825,"word":"春露秋霜","pinyin":"chūn lù qiū shuāng","abbr":"clqs","explanation":"比喻恩泽与威严。也用在怀念先人。","source":{"text":"眚灾肆赦，则文有春露之滋；明罚敕法，则辞有秋霜之烈。","book":"南朝·梁·刘勰《文心雕龙·诏策》"},"example":{"text":"他本是曲园太史的女公子，凡属诗词歌赋，无不家学渊源，因此～，益增感慨。","book":"《晚清文学丛钞·冷眼观》第二十八回"},"usage":"作宾语、定语；指怀念先人"},{"id":24826,"word":"春韭秋菘","pinyin":"chūn jiǔ qiū sōng","abbr":"cjqs","explanation":"韭：韭菜；菘：一种阔叶蔬菜名。泛指时新蔬菜。","source":{"text":"文惠太子问颙：‘菜食何味最胜？’颙曰：‘春初早韭，秋末晚菘。’","book":"《南齐书·周颙传》"},"example":{"text":"平章～味，拆补天吴紫凤图。","book":"宋·陆游《自笑》诗"},"similar":["早韭晚菘"],"usage":"作主语、宾语、定语；用于时菜"},{"id":24827,"word":"春风一度","pinyin":"chūn fēng yī dù","abbr":"cfyd","explanation":"度：次，回。比喻领略一番美妙的生活情趣。亦借指男女合欢。","source":{"text":"老夫为官，不如在此闲居也……到今日身无所如，想天公也有安排我处，可不道吕望严陵自千古，这便算的我春风一度。","book":"元·王实甫《四丞相高会丽春堂》第三折"},"example":{"text":"～，即别东西，何劳审究，岂将留名字作贞坊耶？","book":"清·蒲松龄《聊斋志异·荷花三娘子》"},"usage":"作宾语；指男女的私情幽欢"},{"id":24828,"word":"春风不入驴耳","pinyin":"chūn fēng bù rù lǘ ěr","abbr":"cfbrle","explanation":"比喻好话听不进去。","source":{"text":"谁知对牛弹琴，春风不入驴耳，口里阳为答应，背后依旧打点做滑家的新郎。","book":"清·西周生《醒世姻缘传》第九十四回"}},{"id":24829,"word":"春风中坐","pinyin":"chūn fēng zhōng zuò","abbr":"cfzz","explanation":"像置身于春风中一样。比喻良师的教诲。比喻受到良好的教育。","source":{"text":"朱公掞来见明道于汝，归，谓人曰：‘光庭在春风中坐了一个月。’","book":"宋·程颢、程颐《二程全书·外书十二》"}},{"id":24830,"word":"春风化雨","pinyin":"chūn fēng huà yǔ","abbr":"cfhy","explanation":"化：化生和养育。指适宜于草木生长的风雨。比喻良好的薰陶和教育。","source":{"text":"有如时春风雨化之者。","book":"《孟子·尽心上》"},"example":{"text":"满想在这～的环境里，多受一些教益，哪知道刚入党后的一点钟内，就要离开这块令人陶醉的土地。","book":"李英儒《野火春风斗古城》十二章"},"similar":["化雨春风"],"usage":"作定语；用于赞颂师长的教诲得当"},{"id":24831,"word":"春风和气","pinyin":"chūn fēng hé qì","abbr":"cfhq","explanation":"春天和煦的春风吹拂着人们。比喻对人态度和蔼可亲。","source":{"text":"学者一以春风和气期之，凡忿疾讥斥之辞。","book":"金·王若虚《总论》"},"example":{"text":"既唐公不念前仇，你放些个～将他来待，免得咱一度可喜两度丑。","book":"明·无名氏《四马投唐》第二折"},"usage":"作宾语、定语；指人的态度"},{"id":24832,"word":"春风夏雨","pinyin":"chūn fēng xià yǔ","abbr":"cfxy","explanation":"春风和煦，夏雨滋润，足以养育万物。常比喻及时给人以教益和帮助。","source":{"text":"吾不能以春风风人，吾不能以夏雨雨人，吾穷必矣。","book":"汉·刘向《说苑·贵德》"},"similar":["春风风人，夏雨雨人"],"usage":"作宾语、定语；指有益的东西","story":["春秋时期，梁国相国孟简子因罪逃到齐国，齐国相国管仲亲自出迎，他看到孟简子只有三个随从就询问情况，联想到他在齐国变法革新，得罪了不少人，他不能像春风吹拂每一个人，不能像夏雨滋润每一个人，他的来日一定很穷困"]},{"id":24833,"word":"春风得意","pinyin":"chūn fēng dé yì","abbr":"cfdy","explanation":"得意：扬扬自得的样子。旧时形容考中进士后的兴奋心情。后形容职位升迁顺利。","source":{"text":"春风得意马蹄疾，一日看尽长安花。","book":"唐·孟郊《登科后》诗"},"example":{"text":"在这些“伸手”派心目中，新社会也不过是一个猎场，可以任由他们在其中践踏一切，呼朋引类，～，纵马狩猎。","book":"秦牧《手莫伸》"},"similar":["春风满面","眉飞色舞","趾高气扬"],"opposite":["愁眉不展","愁眉苦脸","灰心丧气"],"usage":"作谓语、定语；形容如愿以偿，心情欢畅","story":["唐朝诗人孟郊年轻时隐居嵩山，过着清贫闲淡的生活，在母亲的鼓励下，他多次进京赶考没有考中，直到41岁时才考取进士，他写诗“昔日龌龊不足夸，今朝放荡思无涯。春风得意马蹄疾，一日看尽长安花”来抒发自己的喜悦心情"]},{"id":24834,"word":"春风报罢","pinyin":"chūn fēng bào bà","abbr":"cfbb","explanation":"报罢：考试不中。指考试落第。","source":{"text":"恰好春风报罢，即拟整顿行装，起身回去。","book":"清·李宝嘉《官场现形记》第三回"},"usage":"作宾语、定语；用于考试落榜"},{"id":24835,"word":"春风沂水","pinyin":"chūn fēng yí shuǐ","abbr":"cfys","explanation":"原意是大人和儿童在沂水洗个澡，在舞雩台上吹吹风。指放情自然，旷达高尚的生活乐趣。","source":{"text":"莫春者，春服既成，冠者五六人，童子六七人，浴乎沂，风乎舞雩，咏而归。","book":"《论语·先进》"},"example":{"text":"古今为学之人不少，研精则或乏～之致，萧疏则或难致知深造之诚。","book":"明·朱之渝《朱舜永集·咏归亭》"},"usage":"作宾语、定语；指放情自然"},{"id":24836,"word":"春风满面","pinyin":"chūn fēng mǎn miàn","abbr":"cfmm","explanation":"春风：指笑容。比喻人喜悦舒畅的表情。形容和霭愉快的面容。","source":{"text":"满面春风，一团和气，发露胸中书与诗。","book":"宋·程节斋《沁园春》词"},"example":{"text":"～乐醄醄，一场长笑海山高。","book":"元·无名氏《九世同堂》第四折》"},"similar":["笑容满面","春风得意"],"opposite":["愁眉不展","愁眉苦脸"],"usage":"作谓语、定语、补语；形容人和蔼"},{"id":24837,"word":"春风野火","pinyin":"chūn fēng yě huǒ","abbr":"cfyh","explanation":"比喻迅猛之势。","source":{"text":"左齐《南泥湾屯垦》；“劳动竞赛的热潮，像春风野火一样，迅速遍及整个工地。”"},"usage":"作宾语、定语；用于气势等"},{"id":24838,"word":"春风雨露","pinyin":"chūn fēng yǔ lù","abbr":"cfyl","explanation":"像春天的风和雨滴露水那样滋润着万物的生长。旧常用以比喻恩泽。","source":{"text":"曾记得，春风雨露，玉楼金阙。","book":"宋·王清惠《满江红·题驿壁》"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":24839,"word":"春风风人","pinyin":"chūn fēng fèng rén","abbr":"cffr","explanation":"风人：吹拂人。和煦的春风吹拂着人们。比喻及时给人教益和帮助。","source":{"text":"管仲上车曰：‘嗟兹乎，我穷必矣！吾不能以春风风人，吾不能以夏雨雨人，吾穷必矣。’","book":"汉·刘向《说苑·贵德》"},"example":{"text":"他给人有～的印象。"},"similar":["夏雨雨人"],"usage":"作谓语、定语；比喻及时给人以良好的教育","story":["春秋时期，梁国相国孟简子因罪逃到齐国，齐国相国管仲亲自出迎，他看到孟简子只有三个随从就询问情况，联想到他在齐国变法革新，得罪了不少人，他不能像春风吹拂每一个人，不能像夏雨滋润每一个人，他的来日一定很穷困"]},{"id":24840,"word":"春风风人，夏雨雨人","pinyin":"chūn fēng fèng rén，xià yǔ yǔ rén","abbr":"cffrxyyr","explanation":"春风：春天的和风；风：吹人。和煦的春风吹拂着人们，夏天的雨水滋养人。比喻帮助了别人，人家也会给予回报。","source":{"text":"管仲上车曰：‘嗟兹乎，我穷必矣！吾不能以春风风人，吾不能以夏雨雨人，吾穷必矣。’","book":"汉·刘向《说苑·贵德》"},"usage":"作宾语、定语、分句；指给人帮助","story":["春秋时期，梁国相国孟简子因罪逃到齐国，齐国相国管仲亲自出迎，他看到孟简子只有三个随从就询问情况，联想到他在齐国变法革新，得罪了不少人，他不能像春风吹拂每一个人，不能像夏雨滋润每一个人，他的来日一定很穷困"]},{"id":24841,"word":"昧地瞒天","pinyin":"mèi dì mán tiān","abbr":"mdmt","explanation":"瞒、昧：隐瞒，欺骗。昧着良心隐瞒真实情况，以谎言骗人。","source":{"text":"昧地谩天，多能已会，以巧翻为拙。","book":"金·侯善渊《酹江月》词"},"example":{"text":"你这般～，谄佞奸僻。","book":"明·无名氏《活拿肖天佑》第一折"},"similar":["昧地谩天"],"usage":"作谓语、定语；用于欺骗"},{"id":24842,"word":"昧地谩天","pinyin":"mèi dì mán tiān","abbr":"mdmt","explanation":"比喻昧着良心隐瞒真实情况，用谎言欺骗他人。亦作“昧地瞒天”。","source":{"text":"昧地谩天，多能已会，以巧翻为拙。","book":"金侯善渊《酹江月》词"},"example":{"text":"你这般昧地瞒天，诌佞奸僻。","book":"明无名氏《活拿肖天佑》头折"},"similar":["昧地瞒天"],"usage":"作谓语、定语；用于欺骗"},{"id":24843,"word":"昧己瞒心","pinyin":"mèi jǐ mán xīn","abbr":"mjmx","explanation":"指违背自己的良心干坏事。","source":{"text":"他他他，忒很毒，敢敢敢，昧己满心，将我图。","book":"元杨显之《潇湘雨》第三折"},"example":{"text":"况且骨肉之间，如此～，最伤元气。","book":"《初刻拍案惊奇》卷三三"},"usage":"作谓语、定语、宾语；用于处事"},{"id":24844,"word":"昧旦丕显","pinyin":"mèi dàn pī xiǎn","abbr":"mdpx","explanation":"昧旦：天色尚未明的时候；丕：大；显：显扬。天尚未亮时就起床，思考怎样才能使德业发扬光大。","source":{"text":"昧旦丕显，后世犹怠。","book":"《尚书·太甲上》：“先王爽昧丕显，坐以待旦。”《左传·昭公三年》"},"example":{"text":"臣闻～，后世犹怠，作法于理，其弊犹乱。","book":"唐·吴兢《贞观政要·奢纵》"},"usage":"作谓语、定语；用于书面语"},{"id":24845,"word":"昧旦晨兴","pinyin":"mèi dàn chún xīng","abbr":"mdcx","explanation":"指天不亮就起来。多形容勤劳或忧心忡忡难以入睡。昧旦，天将明未明；破晓。","source":{"text":"何尝不昧旦晨兴，夜分忘寝。","book":"《晋书·简文帝纪》"},"example":{"text":"若乃赵王既虏，迁于房陵，薄心动念，～，别艳姬与美女，丧金舆及玉乘，置洒欲饮，悲来填膺，千秋万岁，为怨难胜。","book":"南朝梁江淹《恨赋》"},"usage":"作谓语；指人勤劳"},{"id":24846,"word":"昧昧无闻","pinyin":"mèi mèi wú wén","abbr":"mmww","explanation":"闻：出名。指无声无息，无人知晓。","source":{"text":"而使之昧昧无闻，安得不饮恨于九泉，抱痛于百世哉？","book":"《剪灯余话·长安夜行录》"},"similar":["默默无闻","没没无闻"],"opposite":["鼎鼎有名"],"usage":"作谓语、定语、状语；指无声无息"},{"id":24847,"word":"昧昧芒芒","pinyin":"mèi mèi máng máng","abbr":"mmmm","explanation":"昧昧：浑朴的样子；芒芒：广大深远的样子。形容纯朴广远的原始状态。","source":{"text":"至伏羲氏，其道昧昧芒芒然。","book":"《淮南子·俶真训》"}},{"id":24848,"word":"昧死以闻","pinyin":"mèi sǐ yǐ wén","abbr":"msyw","explanation":"昧：冒。闻：使听到。冒着死罪来禀告您。表示谨慎惶恐。","source":{"text":"老臣贱息舒祺最少，不肖，而臣衰，窃怜爱之，愿得补黑衣之缺以卫王宫，昧死以闻。","book":"《史记·赵世家》"},"example":{"text":"庞言息而人心一，天下久安，永誉无极。谨～。","book":"蔡东藩《前汉演义》第五回"},"usage":"作谓语、定语；用于书面语"},{"id":24849,"word":"昨非今是","pinyin":"zuó fēi jīn shì","abbr":"zfjs","explanation":"非：不对，错误；是：对，正确。现在是对的，过去是错的。","source":{"text":"老子开年年五十，依前恁地痴顽。昨非今是有无间。","book":"宋·郭应祥《临江仙·丙寅生日自作》词"},"example":{"text":"着什么～于中战，岂如俺月光常是照金尊。","book":"明·胡文焕《群音类选·点绛唇》"},"similar":["今是昨非"],"usage":"作谓语、定语、分句；形容人悔恨以前的错误"},{"id":24850,"word":"昭如日星","pinyin":"zhāo rú rì xīng","abbr":"zrrx","explanation":"昭：明显。像太阳和星星那样明显。形容丰功伟业，人所共见。亦作“昭如日月”。","source":{"text":"呜呼曼卿！生而为英，死而为灵。其同乎万物生死，而复归于无物者，暂聚之形；不与万物共尽，而卓然其不朽者，后世之名。此自古圣贤，莫不皆然。而著在简册者，昭如日星。","book":"宋·欧阳修《祭石曼卿文》"}},{"id":24851,"word":"昭如日月","pinyin":"zhāo rú rì yuè","abbr":"zrry","explanation":"昭：明显。像太阳和星星那样明显。形容丰功伟业，人所共见。同“昭如日星”。","source":{"text":"《尚书大传》曰：子夏读书毕，见夫子，夫子问之，何为於书，子夏曰：书之论事，昭昭如日月之代明，离离如参辰之错行，商所受於夫子者，志之於心，不敢忘也。"},"example":{"text":"光灵在上，徽音流千古，～丽层穹。","book":"宋·范祖禹《六州》词"}},{"id":24852,"word":"昭威耀武","pinyin":"zhāo wēi yào wǔ","abbr":"zwyw","explanation":"昭：明显；耀：显扬。炫耀武力，显示威风。形容得意夸耀的神态。","source":{"text":"昭威耀武，震动遐荒。楚以定霸，越以取强。","book":"唐·欧阳询《艺文类聚》卷六十"}},{"id":24853,"word":"昭德塞违","pinyin":"zhāo dé sè wéi","abbr":"zdsw","explanation":"彰明美德，杜绝错误。","source":{"text":"昭德，谓昭明善德，使德益彰闻也；塞违，谓闭塞违邪，使违命止息也。","book":"《左传·恒公二年》：“君人者将昭德塞违，以临照百官。”孔颖达疏"},"example":{"text":"要选择典型，广泛进行宣传，予以表扬，～，以正党风。","book":"《天津日报》1979.12.31"},"usage":"作谓语、定语；用于书面语"},{"id":24854,"word":"昭昭之宇","pinyin":"zhāo zhāo zhī yǔ","abbr":"zzzy","explanation":"昭昭：光明；宇：宇宙，指世界。指光明的世界","source":{"text":"甘瞑于太霄之宅，而觉视于昭昭之宇。","book":"西汉·司马迁《淮南子·精神训》"},"usage":"作宾语；用于书面语"},{"id":24855,"word":"昭昭之明","pinyin":"zhāo zhāo zhī míng","abbr":"zzzm","explanation":"昭昭：明亮。形容人能够明察秋毫，明辨是非。","source":{"text":"是故无冥冥之志者，无昭昭之明；无惛惛之事者，无赫赫之功。","book":"《荀子·劝学》"},"usage":"作宾语；用于书面语"},{"id":24856,"word":"昭昭在目","pinyin":"zhāo zhāo zài mù","abbr":"zzzm","explanation":"形容大家看得明明白白。","source":{"text":"贾谊之文，化成之文也，铺陈帝王之道，昭昭在目。","book":"唐·裴度《寄李翱书》"},"similar":["昭然在目"],"usage":"作谓语、定语；指十分明白"},{"id":24857,"word":"昭然可见","pinyin":"zhāo rán kě jiàn","abbr":"zrkj","explanation":"昭然：明白的样子。指明明白白，可以着见","source":{"text":"明暗之效，葬之吉凶，昭然可见矣。","book":"东汉·班固《汉书·刘向传》"},"usage":"作谓语、定语；用于书面语"},{"id":24858,"word":"昭然在目","pinyin":"zhāo rán zài mù","abbr":"zrzm","explanation":"形容大家看得明明白白","source":{"text":"若率众一临，方寸各乱，人人思归，则郡围自解。不战而胜，昭然在目。","book":"《魏书·杨播传》"},"similar":["昭昭在目"],"usage":"作谓语、定语；指十分明白"},{"id":24859,"word":"昭然若揭","pinyin":"zhāo rán ruò jiē","abbr":"zrrj","explanation":"昭然：明显、显著的样子；揭：原意为高举，现也指揭开。形容真相全部暴露，一切都明明白白。","source":{"text":"昭昭乎若揭日月而行也。","book":"《庄子·达生》"},"example":{"text":"承电示撤消军院，爱国之忱，～。","book":"蔡东藩、许廑父《民国通俗演义》第七七回"},"similar":["彰明较著","众目昭彰"],"opposite":["真伪莫辨"],"usage":"作谓语、定语；指已经很明白","story":["春秋时期鲁国人孙休与老师扁庆子探讨修身处世的问题，孙休抱怨没有遇到英明的国君，有怀才不遇之感。扁庆子认为只有凡人天天想着满足自己的欲望，就像高举太阳和月亮那样一点也不掩盖，这样是成不了圣人的"]},{"id":24860,"word":"昭然著闻","pinyin":"zhāo rán zhù wén","abbr":"zrzw","explanation":"昭然：明白的样子；著闻：众所闻知。指明明白白，大家都知道","source":{"text":"符瑞之应，昭然著闻。","book":"南朝·宋·范晔《后汉书·光武帝传》"},"usage":"作谓语、定语；用于书面语"},{"id":24861,"word":"昭穆伦序","pinyin":"zhāo mù lú xù","abbr":"zmlx","explanation":"昭穆：宗庙或墓地的辈次排列；伦序：伦常次序。指家族中的长幼辈分。","source":{"text":"夫祭有昭穆。昭穆者，所以别父子、远近、长幼、亲疏之序而无乱也。","book":"《礼记·祭统》"},"usage":"作宾语、定语；用于书面语"},{"id":24862,"word":"昭聋发聩","pinyin":"zhāo lóng fā kuì","abbr":"zlfk","explanation":"使耳聋的人也能够听到。比喻用语言文字等给人以极大的启发，即使糊涂麻木的人也会清醒过来。","source":{"text":"巴县邹烈士容首起大呼，昭聋发聩，正义浃乎寰宇，回响振乎栈峡。","book":"《天讨·望帝〈四川讨满州檄〉》"},"similar":["振聋发聩"],"usage":"作谓语、定语；用于书面语"},{"id":24863,"word":"是事可可","pinyin":"shì shì kě kě","abbr":"sskk","explanation":"是：凡是，所有；可可：不在意。对什么事情都不关心，不在意。","source":{"text":"自春来，惨绿愁红，芳心是事可可。","book":"样·柳永《定风波》词"}},{"id":24864,"word":"是亦因彼","pinyin":"shì yì yīn bǐ","abbr":"syyb","explanation":"是：此，这个；彼：那个。这个也是因为那个。即二者互为因果。","source":{"text":"彼出于此，是亦因彼。","book":"《庄子·齐物论》"}},{"id":24865,"word":"是古之罪","pinyin":"shì gǔ zhī zuì","abbr":"sgzz","explanation":"是古：认为古代的事就是对的。指犯了推崇古代的罪过。即是古非今之罪。","source":{"text":"设挟书之法，行是古之罪，道术由是遂减。","book":"《汉书·刘向传》附刘歆"}},{"id":24866,"word":"是古非今","pinyin":"shì gǔ fēi jīn","abbr":"sgfj","explanation":"是：认为对；非：认为不对，不以为然。指不加分析地肯定古代的，否定现代的。","source":{"text":"俗儒不达时宜，好是古非今，使人眩于名实，不知所守，何足委任？","book":"《史记·秦始皇本纪》：“有敢偶语《诗》《书》者弃市。以古非今者族。吏见知不举者与同罪。”《汉书·元帝纪》"},"example":{"text":"这句言语，也是古人传下来的，那些叫做～。","book":"明·邵璨《香囊记·途叙》"},"similar":["厚古薄今"],"opposite":["厚今薄古"],"usage":"作谓语、定语；指保守复古"},{"id":24867,"word":"是可忍，孰不可容","pinyin":"shì kě rěn，shú bù kě róng","abbr":"skrsbkr","explanation":"如果这个都可以容忍，还有什么不可容忍的呢？意思是绝不能容忍。同“是可忍，孰不可忍”。","source":{"text":"毕、原、酆、郇，并离祸患，凡、蒋、邢、茅，皆伏鈇鑚，是是可忍也，孰不可容！","book":"《梁书·元帝纪》"},"example":{"text":"况明皇旧宫，天井内地，跨连河北，胁倚山东，岂可行有匪坐为污俗，若～？","book":"唐·郑亚《唐丞太尉卫国公李德裕会昌一品制集序》"},"similar":["是可忍，孰不可忍"],"usage":"作宾语、分句；指绝不能容忍"},{"id":24868,"word":"是可忍，孰不可忍","pinyin":"shì kě rěn，shú bù kě rěn","abbr":"skrsbkr","explanation":"是：这个；孰：那个。如果这个都可以容忍，还有什么不可容忍的呢？意思是绝不能容忍。","source":{"text":"孔子谓季氏，八佾舞于庭，是可忍也，孰不可忍也。","book":"《论语·八佾》"},"example":{"text":"小小三岛之国，如此欺辱我有五千年文明历史的中华古国，～？","book":"杨沫《青春之歌》第二部第二十三章"},"similar":["一不做，二不休"],"usage":"作分句；指绝不能容忍","story":["春秋末年，鲁国贵族季孙氏操纵朝政大权，把鲁昭公赶到齐国，把鲁哀公赶往卫国。他更为放肆，在家设置“八佾”这个只有太子才能享用的大型舞乐队，严重违背了周礼，孔子气愤地说：“八佾舞于庭，是可忍也，孰不可忍也！”"]},{"id":24869,"word":"是是非非","pinyin":"shì shì fēi fēi","abbr":"ssff","explanation":"是是：第一个“是”表示肯定，第二个“是”指正确的东西。把对的认为是对的，把错的认为是错的。比喻是非、好坏分得非常清楚。","source":{"text":"是是非非谓之知，非是是非谓之愚。","book":"《荀子·修身》"},"example":{"text":"孝悌忠信，刚毅质直，笃于为义，勇予疾恶，～，终身不假人以色词。","book":"宋·陆游《曾文清公墓志铭》"},"similar":["是非曲直"],"usage":"作主语、宾语、定语；指是非、好坏分得清"},{"id":24870,"word":"是而非之，非而是之","pinyin":"shì ér fēi zhī，fēi é shì zhī","abbr":"sefzfesz","explanation":"对的以为不对，不对的以为对。指是非不分。","source":{"text":"婴闻之，是而非之，非而是之，犹非也，孔丘必据处此一心矣。","book":"《晏子·不合经术者》"}},{"id":24871,"word":"是耶非耶","pinyin":"shì yē fēi yē","abbr":"syfy","explanation":"耶：语助词，表疑问。是呢？不是呢？","source":{"text":"是邪非邪？立而望之，偏何姗姗其来迟？","book":"《汉书·孝武李夫人传》"}},{"id":24872,"word":"是长是短","pinyin":"shì cháng shì duǎn","abbr":"szsd","explanation":"指说长道短。","source":{"text":"满生若是个有主意的，此时便该把凤翔流落，得遇焦氏之事，是长是短，备细对叔父说一遍。","book":"明·凌濛初《二刻拍案惊奇》卷十一"}},{"id":24873,"word":"是非不分","pinyin":"shì fēi bù fēn","abbr":"sfbf","explanation":"分辨不出正确与错误。","source":{"text":"正领而诵之，此见是非之分不明。","book":"西汉·刘安《淮南子·修务训》"},"example":{"text":"实际上，对方不只是一些～的群众，还有一批造反派和大量的社会渣滓。","book":"邓小平《在接见首都戒严部队军以上干部时的讲话》"},"similar":["黑白不分"],"opposite":["是非分明"],"usage":"作谓语、宾语、定语；指分辨不出正确与错误"},{"id":24874,"word":"是非之地","pinyin":"shì fēi zhī dì","abbr":"sfzd","explanation":"有麻烦或争议的地方。","source":{"text":"我想第一步只有让你师父跳出是非之地，哪一方面都不帮。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"～不宜久留。"},"usage":"作主语、宾语；指有麻烦或争议的地方"},{"id":24875,"word":"是非之心","pinyin":"shì fēi zhī xīn","abbr":"sfzx","explanation":"分辨是非得失的能力。","source":{"text":"是非之心，人皆有之。","book":"《孟子·告子上》"},"example":{"text":"清·朱彝尊《跋王氏诗疑》：“世之儒者，以其渊源出于朱子，而不敢议，则亦无～者也。”"},"usage":"作主语、宾语；用于书面语"},{"id":24876,"word":"是非人我","pinyin":"shì fēi rén wǒ","abbr":"sfrw","explanation":"正确与错误，他人与自己。泛指人与人之间的种种复杂关系。","source":{"text":"不会深穷造化，随缘且度朝昏，是非人我绝谈论，复返生前混沌。","book":"元·丘处机《玉炉三涧雪·自咏》词"},"example":{"text":"你做了酒色财气，你辞了～，今日个老乡惹上仙风，和小桃都成正果。","book":"元·谷子敬《城南柳》第四折"},"usage":"作宾语、定语；用于交往等"},{"id":24877,"word":"是非分明","pinyin":"shì fēi fēn míng","abbr":"sffm","explanation":"正确与错误非常分明。","source":{"text":"故贤圣之君，博观始终，穷极事情，而是非分明。","book":"东汉·班固《汉书·刘向传》"},"example":{"text":"他处理问题上一向～。"},"similar":["是是非非"],"opposite":["不辨是非","是非不分"],"usage":"作谓语、定语；指正确与错误非常分明"},{"id":24878,"word":"是非口舌","pinyin":"shì fēi kǒu shé","abbr":"sfks","explanation":"因说话引起的误会或纠纷。","source":{"text":"若是为田地上坏了手足亲情，到不如穷汉赤光光没得承受，反为干净，省了许多是非口舌。","book":"明·冯梦龙《古今小说·滕大尹鬼断家私》"},"example":{"text":"这是哪里的晦气！事情不曾办成，倒弄了一窝子的～。","book":"清·吴趼人《二十年目睹之怪现状》第三十五回"},"usage":"作主语、宾语、定语；用于交往等"},{"id":24879,"word":"是非只为多开口","pinyin":"shì fēi zhī wèi duō kāi kǒu","abbr":"sfzwdkk","explanation":"纠纷争端都是说话太多引起的。","source":{"text":"是非只为多开口，烦恼皆因强出头。","book":"宋·陈元靓《事林广记·人事下·处世警言》"},"example":{"text":"可甚么～，倒道我女大不中留。","book":"元·杨显之《潇湘雨》第一折"},"similar":["祸从口出"],"usage":"作宾语、定语；用于劝诫人"},{"id":24880,"word":"是非好歹","pinyin":"shì fēi hǎo dǎi","abbr":"sfhd","explanation":"歹：坏。正确与错误，好的与坏的。指对事情的评价。","source":{"text":"大都来一时事，搬弄出千载因，辨是非好歹清浑。","book":"元·贾仲名《双调》"},"example":{"text":"酒醉三分醒，这么大一个人，连～也不分么？","book":"金庸《笑傲江湖》第三回"}},{"id":24881,"word":"是非得失","pinyin":"shì fēi dé shī","abbr":"sfds","explanation":"正确与错误，所得与所失。","source":{"text":"奉圣旨不允者沥恳控陈，必期从欲，闻命悚惕，不知所言，重念臣愚，素无史学，然于是非得失之故，实有善善恶恶之心。","book":"宋·朱熹《辞免兼实录院同修撰奏状二》"},"example":{"text":"钱仲联《人境庐诗草·黄公度年谱》：“逮穷年累月，深稽博考，然后乃晓然于～之宜，长短取舍之要。”"},"usage":"作主语、宾语、定语；用于处事等"},{"id":24882,"word":"是非曲直","pinyin":"shì fēi qū zhí","abbr":"sfqz","explanation":"正确还是不正确，有理还是无理。","source":{"text":"二论各有所见，故是非曲折未有所定。","book":"汉·王充《论衡·说日篇》"},"example":{"text":"我奉着玉帝天符非轻慢，将～分明看。","book":"元·无名氏《硃砂担》第三折"},"similar":["大是大非","青红皂白"],"opposite":["混淆是非","混为一谈"],"usage":"作主语、宾语、定语；指对事物的评断"},{"id":24883,"word":"是非混淆","pinyin":"shì fēi hùn xiáo","abbr":"sfhx","explanation":"混淆：使界限不清。故意把正确的说成错误的，把错误的说成正确的。","source":{"text":"绍是非混淆，公法度严明，此文胜也。","book":"明·罗贯中《三国演义》第十八回"},"example":{"text":"乃至黑白颠倒，～，楚才有今日之悲惨結局。","book":"曹尧德《屈子传》第二十四章"},"similar":["混淆是非"],"usage":"作谓语、定语；指故意制造混乱"},{"id":24884,"word":"是非自有公论","pinyin":"shì fēi zì yǒu gōng lùn","abbr":"sfzygl","explanation":"事情的是非曲直，公众自会作出恰当的评判。","source":{"text":"扞庾公呴又问：‘何者居其右？’王曰：‘自有人。’又问：‘何者是？’王曰：‘噫！其自有公论。’","book":"语出南朝·宋·刘义庆《世说新语·品藻》"}},{"id":24885,"word":"是非轻重","pinyin":"shì fēi qīng zhòng","abbr":"sfqz","explanation":"正确和谬误，事情的重要与不重要。","source":{"text":"当然还是要分别是非轻重，要以事实为根据，以法律为准绳，还是要讲坦白从宽抗拒从严的政策。","book":"邓小平《第三代领导集体的当务之急》"},"usage":"作宾语、定语；用于口语"},{"id":24886,"word":"是非长短","pinyin":"shì fēi cháng duǎn","abbr":"sfcd","explanation":"正确还是不正确，有理还是无理。","source":{"text":"二论各有所见，故是非曲折未有所定。","book":"汉·王充《论衡·说日篇》"},"example":{"text":"你二位今日这场斗，我也不问他们～。","book":"清·文康《儿女英雄传》第十五回"}},{"id":24887,"word":"是非颠倒","pinyin":"shì fēi diān dǎo","abbr":"sfdd","explanation":"是：对；非：错。把错的说成对的，对的说成错的。把是非弄颠倒了。","source":{"text":"古圣人言，其旨密微，笺注纷罗，颠倒是非。","book":"唐·韩愈《施先生墓铭》"},"example":{"text":"阳世全凭一张纸，～多因此。","book":"明·凌濛初《二刻拍案惊奇》卷十六"},"similar":["颠倒是非","是非不分"],"opposite":["是非分明"],"usage":"作谓语、宾语、定语；指分辨不出正确与错误"},{"id":24888,"word":"昼乾夕惕","pinyin":"zhòu qián xī tì","abbr":"zqxt","explanation":"形容日夜勤勉戒慎。","source":{"text":"昼乾夕惕，焦劳而腠理愆和旰食宵衣，忧轸而寒暄爽候。","book":"语出《周易·乾》：“君子终日乾乾，夕惕若，厉无咎。”前蜀·杜光庭《贺臣体渐痊愈表》"},"example":{"text":"前蜀·杜光庭《贺圣体渐痊愈表》：“～，焦劳而腠理愆和；旰食宵衣，忧珍而寒暄爽候。”"},"usage":"作谓语、定语；用于书面语"},{"id":24889,"word":"昼伏夜动","pinyin":"zhòu fú yè dòng","abbr":"zfyd","explanation":"白天埋伏，夜晚活动。","source":{"text":"夫鼠昼伏夜动，不穴于寝庙，畏人故也。","book":"《左传·襄公二十三年》"},"similar":["昼伏夜游","昼伏夜行"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":24890,"word":"昼伏夜游","pinyin":"zhòu fú yè yóu","abbr":"zfyy","explanation":"犹昼伏夜动。","source":{"text":"历阳广陵，窥觎相继，或谋图城邑，或劫剥吏人，昼伏夜游，鼠窃狗盗。","book":"《隋书·高祖纪下》"},"similar":["昼伏夜动","昼伏夜行"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":24891,"word":"昼伏夜行","pinyin":"zhòu fú yè xíng","abbr":"zfyx","explanation":"伏：躲藏；行：赶路。白天躲藏，夜间赶路。指为避免被敌人发现所采取的秘密活动。","source":{"text":"伍子胥橐载而出昭关，夜行而昼伏，至于蓤夫。","book":"西汉·刘向《战国策·秦策》"},"example":{"text":"风吹雨打露沾衣，～人迹稀。","book":"陈毅《寄友》"},"similar":["昼伏夜动","昼伏夜游"],"opposite":["日夜兼程"],"usage":"作谓语、定语；指秘密赶路","story":["春秋时期，楚平王十分昏庸荒淫，竟霸占自己的儿媳妇，太子老师伍奢认为不妥被抓起来，楚平王命他写信叫回外地的儿子伍尚与伍员（伍子胥）。伍尚回去后与父亲被杀，伍子胥历尽艰辛，昼伏夜行，十分小心风吹草动，终于逃到吴国"]},{"id":24892,"word":"昼修夜短","pinyin":"zhòu xiū yè duǎn","abbr":"zxyd","explanation":"修：长。白天长夜间短","example":{"text":"夏天来了，～"},"usage":"作宾语、定语；用于书面语"},{"id":24893,"word":"昼吟宵哭","pinyin":"zhòu yín xiāo kū","abbr":"zyxk","explanation":"昼夜哀叹、哭泣。","source":{"text":"［棼冒勃苏］七日而薄秦王之朝，雀立不转，昼吟宵哭，七日不得告。","book":"《战国策·楚策一》"},"usage":"作定语、状语；用于书面语"},{"id":24894,"word":"昼夜不息","pinyin":"zhòu yè bù xī","abbr":"zybx","explanation":"息：停止。从白天到夜晚一直不停。","source":{"text":"子在川上曰：‘逝者如斯夫，不舍昼夜。’","book":"《论语·子罕》"},"example":{"text":"这底下有三丈多深，槃成的九间朝殿，内有四个大缸，缸内满注清油，点着灯火，～。（明·吴承恩《西游记》第六十九回）"},"similar":["昼夜不舍"],"usage":"作定语、状语；用于书面语"},{"id":24895,"word":"昼夜不舍","pinyin":"zhòu yè bù shě","abbr":"zybs","explanation":"舍：放弃。不放弃白天和黑夜。比喻夜以继日。","source":{"text":"子在川上曰：‘逝者如斯夫，不舍昼夜。’","book":"《论语·子罕》"},"example":{"text":"两人情好越深，俨如一对患难夫妻，～。（蔡东藩《前汉演义》第四十一回）"},"similar":["昼夜不息"],"usage":"作谓语、状语、定语；用于书面语"},{"id":24896,"word":"昼夜兼程","pinyin":"zhòu yè jiān chéng","abbr":"zyjc","explanation":"昼夜：白天和黑夜；兼：加倍；程：行程。白天黑夜不停地赶路。形容急速地赶路。","source":{"text":"使白衣摇橹作商贾人服，昼夜兼行。","book":"《三国志·吴志·吕蒙传》"},"example":{"text":"范翁方才同女儿进发，～，行到衙中，择吉成亲。","book":"明·凌濛初《二刻拍案惊奇》卷三十二"},"similar":["昼夜兼行"],"usage":"作谓语、状语；用于旅行等"},{"id":24897,"word":"昼夜兼行","pinyin":"zhòu yè jiān xíng","abbr":"zyjx","explanation":"昼夜：白天和黑夜；兼：加倍；行：行走。白天黑夜不停地行走。形容急速地赶路。","source":{"text":"使白衣摇橹作商贾人服，昼夜兼行。","book":"《三国志·吴志·吕蒙传》"},"example":{"text":"遂出令选骑兵善射惯战者万人为前锋，大军在后，衔枚卷甲，～。","book":"明·冯梦龙《东周列国志》第九十六回"},"similar":["日夜兼程"],"usage":"作谓语、宾语、状语；指赶路"},{"id":24898,"word":"昼干夕惕","pinyin":"zhòu gàn xī tì","abbr":"zgxt","explanation":"日夜勤勉戒慎。","source":{"text":"君子终日干干，夕惕若，厉无咎。","book":"语出《易·干》"}},{"id":24899,"word":"昼度夜思","pinyin":"zhòu duó yè sī","abbr":"zdys","explanation":"日夜思量。","source":{"text":"君尊如天，臣卑如地，加有雷霆之威，彼将昼度夜思，始欲陈十事，俄而去五六，及将以闻，则有惮而削其半，故上达者财十二。","book":"《新唐书·李绛传》"},"usage":"作谓语、定语；用于处事"},{"id":24900,"word":"昼思夜想","pinyin":"zhòu sī yè xiǎng","abbr":"zsyx","explanation":"昼：白天。日月想念。形容思念极深。","example":{"text":"她昼思夜想，食不甘味，卧不安席。"},"similar":["寤寐思之","朝思暮想"],"opposite":["置之脑后"],"usage":"作谓语；形容思念极深"},{"id":24901,"word":"昼想夜梦","pinyin":"zhòu xiǎng yè mèng","abbr":"zxym","explanation":"①日有所思，夜有所梦。②指日夜梦想，殷切追求。","source":{"text":"神遇为梦，形接为事，昼想夜梦，神行所遇。","book":"《列子·周穆王》"},"example":{"text":"彼其数十年来吞声饮泪、停幸伫苦、～之事业，一旦涌现于眼前，英雄快心，孰有过此者耶？","book":"梁启超《意大利建国三杰传》第十六节"},"usage":"作宾语、定语；用于书面语"},{"id":24902,"word":"昼慨宵悲","pinyin":"zhòu kǎi xiāo bēi","abbr":"zkxb","explanation":"慨：慨叹。白天慨叹，夜晚悲戚。形容心情十分烦闷。","source":{"text":"嵩霍咫尺，山河匪遥，夷庚壅塞，隔同天地，痛心疾首，昼慨宵悲。","book":"《宋书·鲁爽传》"},"usage":"作定语；用于书面语"},{"id":24903,"word":"昼日三接","pinyin":"zhòu rì sān jiē","abbr":"zrsj","explanation":"一日之间三次接见。形容深受宠爱礼遇。","source":{"text":"昼日三接者，言非惟蒙赐蕃多，又被亲宠频数，一昼之间，三度接见也。","book":"《易·晋》：“康侯用锡马蕃庶，昼日三接。”孔颖达疏"},"example":{"text":"摘笔摛词，当筵授简，叨陪～。","book":"明·汪道昆《高唐梦》"},"usage":"作宾语、定语；用于书面语"},{"id":24904,"word":"昼日昼夜","pinyin":"zhòu rì zhòu yè","abbr":"zrzy","explanation":"犹言日日夜夜；没日没夜。","source":{"text":"都要我写字、做诗，还有那分了题、限了韵来要求教的。昼日昼夜打发不清。","book":"清·吴敬梓《儒林外史》第二十二回"},"similar":["没日没夜","日日夜夜"],"usage":"作定语、状语；用于书面语"},{"id":24905,"word":"昼耕夜诵","pinyin":"zhòu gēng yè sòng","abbr":"zgys","explanation":"白天耕种，夜晚读书。比喻读书勤奋。","source":{"text":"家贫好学，昼耕夜诵，佣书以养父母。","book":"《魏书·崔光传》"},"similar":["悬梁刺骨","好学不倦"],"usage":"作谓语、定语；指边读书边劳动"},{"id":24906,"word":"昼警夕惕","pinyin":"zhòu jǐng xī tì","abbr":"zjxt","explanation":"日夜警惕戒慎。","source":{"text":"敢不尽虑力行，求神圣责任之实；昼警夕惕，思天地亭育之恩。","book":"宋·沈括《延州谢到任表》"},"usage":"作谓语、定语、状语；用于处事"},{"id":24907,"word":"昼警暮巡","pinyin":"zhòu jǐng mù xún","abbr":"zjmx","explanation":"白天黑夜警戒。比喻防范严密。","source":{"text":"公家之事，知无不为，昼警暮巡，考课尤著。","book":"宋·戴少平《王荣神道碑》"},"usage":"作宾语、定语；指日夜警戒"},{"id":24908,"word":"昼锦之荣","pinyin":"zhòu jǐn zhī róng","abbr":"zjzr","explanation":"白天穿着锦绣的衣服，光彩耀目。比喻因做官或地位显赫而荣耀之极。","source":{"text":"或者献诗于魏公劝得辞分陕之重，而为昼锦之荣，可谓能规劝矣。","book":"宋·胡仔《苕溪渔隐丛话后集·本朝杂记上》"},"usage":"作宾语；用于书面语"},{"id":24909,"word":"昼锦荣归","pinyin":"zhòu jǐn róng guī","abbr":"zjrg","explanation":"大白天穿着锦绣衣裳回归故里。比喻做官后重回故乡，显耀之极。","source":{"text":"承恩亲自是边来，端的喝声采，昼锦荣归宠光大。","book":"明·王彦贞《雍熙乐府·小桃红·西厢百咏》"},"similar":["衣锦还乡"],"opposite":["锦衣夜行"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":24910,"word":"昼阴夜阳","pinyin":"zhòu yīn yè yáng","abbr":"zyyy","explanation":"依我国古代阴阳之说，昼属阳，夜属阴。“昼阴夜阳”表示天道反常，将有灾异。","source":{"text":"月犯执法，彗孛仍见，昼阴夜阳，雾气交侵。","book":"《后汉书·王允传》"},"usage":"作宾语、定语；用于书面语"},{"id":24911,"word":"显亲扬名","pinyin":"xiǎn qīn yáng míng","abbr":"xqym","explanation":"显：显赫；亲：父母；扬：传扬。指使双亲显耀，名声传扬。","source":{"text":"立身行道，扬名于后世，以显父母，孝之终也。","book":"《孝经·开宗明义》"},"example":{"text":"倘得一官半职，～，封妻荫子，光耀门闾，乃儿之志也。","book":"明·吴承恩《西游记》第九回"},"similar":["光宗耀祖"],"usage":"作谓语、宾语；形容人的人生观"},{"id":24912,"word":"显处视月","pinyin":"xiǎn chù shì yuè","abbr":"xcsy","explanation":"比喻治学的范围广但不精深。","source":{"text":"圣贤固所忘言，自中人以还，北人看书，如显处视月；南人学问，如牖中窥日。","book":"南朝·宋·刘义庆《世说新语·文学》"}},{"id":24913,"word":"显姓扬名","pinyin":"xiǎn xìng yáng míng","abbr":"xxym","explanation":"指显耀门第，传扬名声。","source":{"text":"咱祖父乃文林华胄，况外戚是儒业簪缨，哀先相几乎绝嗣，使小姐振厥家声，又何须悬头刺股、积雪囊萤，那里也齐家治国、显姓扬名。","book":"元·郑光祖《梅香》第一折"},"example":{"text":"明·胡文焕《分钗记·分钗夜别》：“你是人间豪俊，当思～，须听，再休折章台杨柳。”"},"similar":["出人头地"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":24914,"word":"显山露水","pinyin":"xiǎn shān lù shuǐ","abbr":"xsls","explanation":"比喻出名，显露才能。","source":{"text":"他在其中虽然不怎么显山露水，却也不是庸碌之徒。","book":"《南方周末》1991.9.27"},"example":{"text":"他的才能已经开始～了。"},"similar":["初露锋芒"],"opposite":["不露锋芒"],"usage":"作谓语；指开始显现"},{"id":24915,"word":"显微阐幽","pinyin":"xiǎn wēi chǎn yōu","abbr":"xwcy","explanation":"显示细微之事，说明隐幽之理，使之显见著明。","source":{"text":"夫《易》彰往而察来，而微显阐幽。","book":"《周易·系辞下》"},"example":{"text":"然则诗话之作，集思广益，～，宁滥毋遗，不亦可乎？","book":"清·袁枚《随园诗话补遗》第四卷"},"similar":["阐幽显微"],"usage":"作谓语；指揭示隐藏的东西"},{"id":24916,"word":"显显令德","pinyin":"xiǎn xiǎn lìng dé","abbr":"xxld","explanation":"显显：盛大明亮的样子。显明辉煌的美德。","source":{"text":"假乐君子，显显令德。","book":"《诗经·大雅·假乐》"},"example":{"text":"于惟曾皇，～。","book":"《乐府诗集·京兆府君登歌》"}},{"id":24917,"word":"显祖扬名","pinyin":"xiǎn zǔ yáng míng","abbr":"xzym","explanation":"指使祖宗显耀，使名声传扬。","source":{"text":"及吴诸顾、陆旧族长者，世有高位，当报汉德，显祖扬名。","book":"汉·陈琳《檄吴将校部曲文》"},"example":{"text":"清·钱彩《说岳全传》第47回：“况为人在世，须要烈烈轰轰做一番事业，～，岂肯老死蓬蒿！”"},"similar":["显祖荣宗","显祖扬宗"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":24918,"word":"显祖扬宗","pinyin":"xiǎn zǔ yáng zōng","abbr":"xzyz","explanation":"指使祖宗的名声显耀传扬。","source":{"text":"博得个官高禄重，都则要敬于事上要摅忠，咱人要立身行道，显祖扬宗。","book":"明·无名氏《魏征改诏》第一折"},"example":{"text":"明·冯梦龙《醒世恒言》第19卷：“何不觅便逃归，图个～。”"},"similar":["显祖荣宗","显祖扬名"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":24919,"word":"显祖荣宗","pinyin":"xiǎn zǔ róng zōng","abbr":"xzrz","explanation":"指使祖宗的名声显耀传扬。同“显祖扬宗”。","source":{"text":"博得个官高禄重，都则要敬于事上要摅忠，咱人要立身行道，显祖扬宗。","book":"明·无名氏《魏征改诏》第一折"},"example":{"text":"如君臣际会，受于君王奉禄，忠事于君，后来封妻荫子，～，皆是君王赐的厚恩。","book":"清·西湖渔隐主人《欢喜冤家》第十九回"},"similar":["显祖扬宗","光宗耀祖"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":24920,"word":"显而易见","pinyin":"xiǎn ér yì jiàn","abbr":"xeyj","explanation":"形容事情或道理很明显，极容易看清楚。","source":{"text":"此显而易见之事，从无一人辩之。","book":"清·李渔《闲情偶寄·结构第一》"},"example":{"text":"日本帝国主义和中国讨伐派的失望，已～。","book":"毛泽东《关于蒋介石声明的声明》"},"similar":["昭然若揭","有目共睹"],"opposite":["模棱两可","高深莫测"],"usage":"作宾语、定语、分句；用于说话、写文章等"},{"id":24921,"word":"显赫一时","pinyin":"xiǎn hè yī shí","abbr":"xhys","explanation":"显赫：有名声有权势地位的。在一个短时期内名声权势极大。","source":{"text":"权贵显赫，倾动京都。","book":"南朝·宋·范晔《后汉书·窦宪传》"},"example":{"text":"他的名气～。"},"similar":["烜赫一时"],"opposite":["默默无闻"],"usage":"作谓语、定语；指一时名气"},{"id":24922,"word":"显赫人物","pinyin":"xiǎn hè rén wù","abbr":"xhrw","explanation":"名人，有权势的人物。","source":{"text":"从此，刘麻子就成了双水村一个显赫人物。","book":"路遥《平凡的世界》第四卷第41章"},"example":{"text":"他在这个小地方属～了。"},"similar":["头面人物"],"usage":"作主语、宾语、定语；指有权势的人物"},{"id":24923,"word":"显露头角","pinyin":"xiǎn lù tóu jiǎo","abbr":"xltj","explanation":"露：显露。头上的角已明显地突出来了。指初显露优异的才能。","source":{"text":"虽少年，已自成人，能取进士第，崭然见头角焉。","book":"唐·韩愈《柳子厚墓志铭》"},"similar":["崭露头角"],"usage":"作谓语、定语；指初显才华"},{"id":24924,"word":"显露端倪","pinyin":"xiǎn lù duān ní","abbr":"xldn","explanation":"端倪：线索，头绪。已经看到了事情的头绪或线索。","example":{"text":"那些坐享其成等待观望的人，在一次～的时候，跳出来摘桃子，晚了！","book":"毕淑敏《原始股》八"}},{"id":24925,"word":"晋惠闻蛙","pinyin":"jìn huì wén wā","abbr":"jhww","explanation":"比喻愚昧寡闻。","source":{"text":"何不食肉糜？","book":"语出《晋书·惠帝记》：晋惠帝昏庸愚昧，尝在华林园听到蛙声，谓左右，曰：“此鸣者为官乎？私乎？”及天下大荒乱，百姓饿死，曰"},"example":{"text":"羡杀那知祸福塞翁失马，堪笑他问公私～。","book":"元王子一《误入桃源》第一折。"},"usage":"作宾语、定语；指人愚昧","story":["晋朝时期，晋惠帝十分昏庸愚昧，曾经在华林园听到蛙声就问左右说：“它们这样叫是为了要官做还是别的原因。”后来天下大乱，很多百姓饿死，百官上朝时把情况报告给他，惠帝竟然说他们为什么不吃肉呢？百官哭笑不得"]},{"id":24926,"word":"晋用楚材","pinyin":"jìn yòng chǔ cái","abbr":"jycc","explanation":"指一国聘用别国的人材。","source":{"text":"国之官事，晋用楚材，古今有之，而未闻监榷之政付之他国之吏者也。","book":"严复《按语》"},"similar":["楚材晋用"],"usage":"作宾语；指引进人才"},{"id":24927,"word":"晋阳之甲","pinyin":"jìn yáng zhī jiǎ","abbr":"jyzj","explanation":"指地方官吏因不满朝廷而举兵为兴“晋阳之甲”。","source":{"text":"《公羊传·定公十三年》载：晋赵鞅兴晋阳之甲，以清君侧为名，逐荀寅、士吉射。"},"example":{"text":"殷荆州兴～，往与觊别，涕零。","book":"南朝宋刘义庆《世语新说·规畿》"},"usage":"作宾语；指战士","story":["春秋时期，晋国内政昏乱，争权夺利的杀戮时常出现。大夫赵鞅因不满时政，兴晋阳之甲，打着“清君侧”的旗号进行举兵反叛，杀入国都，驱逐了当年晋王身边的宠臣荀寅、士吉射等"]},{"id":24928,"word":"晏婴之狐裘","pinyin":"yàn yīng zhī hú qiú","abbr":"yyzhq","explanation":"晏婴一件狐裘穿了三十年。比喻生活节俭。","source":{"text":"子一狐裘三十年，遣车一乘。","book":"《礼记·檀弓下》"}},{"id":24929,"word":"晏安酖毒","pinyin":"yàn ān dān dú","abbr":"yadd","explanation":"指贪图安逸享乐等于饮毒酒自杀。同“宴安鸩毒”。"},{"id":24930,"word":"晏安醙毒","pinyin":"yàn ān dān dú","abbr":"yadd","explanation":"指贪图安逸享乐等于饮毒酒自杀。同宴安鸩毒”。"},{"id":24931,"word":"晏安鸩毒","pinyin":"yàn ān zhèn dú","abbr":"yazd","explanation":"晏：安逸；鸩：传说中的毒鸟，用其羽毛泡酒，有剧毒。指贪图享乐等于喝毒酒自杀。","source":{"text":"宴安鸩毒，不可怀也。","book":"春秋·鲁·左丘明《左传·闵公元年》"},"example":{"text":"～，满盈所宜敬忌。","book":"唐·吴兢《乐府古题要解·君子有所思行》"},"similar":["宴安鸩毒"],"usage":"作宾语、定语；用于劝诫人","story":["春秋时期，邢国遭到北方的狄人的侵略，其向齐国求救。相国管仲立即向齐桓公报告。齐桓公有些犹豫不决。管仲说：“我们对周公的后代不能不管，一个国家如果沉湎于安乐当中，就像鸩毒一样。”齐桓公决定发兵救邢国"]},{"id":24932,"word":"晏开之警","pinyin":"yàn kāi zhī jǐng","abbr":"ykzj","explanation":"晏，晚也。有警急则门开得晚也。形容时世不安宁。","source":{"text":"北拒匈奴，率厉四夷，完复边郡，使塞下无晏开之警，万世有安宁之策也。","book":"南朝·宋·范晔《后汉书·耿国传》"},"example":{"text":"我们需要和平，不想有～。"},"usage":"作宾语；指报警","story":["东汉初年，光武帝封知识渊博的耿国为黄门侍郎，后来升他为五官郎将。在对待匈奴呼韩邪单于上书称臣的问题上，耿国认为可以采纳，让其去抵御鲜卑、乌桓，使中原无晏开之警，是一个万世有安宁之策。刘秀才能他的意见"]},{"id":24933,"word":"晏然自若","pinyin":"yàn rán zì ruò","abbr":"yrzr","explanation":"晏然：平静安定的样子；自若：不变常态。形容在紧张状态下沉静如常。","source":{"text":"南阳太守张咨，闻军至，晏然自若。","book":"《三国志·吴志·孙坚传》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":24934,"word":"晓以利害","pinyin":"xiǎo yǐ lì hài","abbr":"xylh","explanation":"晓：使人知道。把事情的利害关系给人讲清楚。","source":{"text":"遂轻诣垒下，晓以利害。","book":"《北齐书·薛修义传》"},"usage":"作谓语、定语；用于劝诫人"},{"id":24935,"word":"晓以大义","pinyin":"xiǎo yǐ dà yì","abbr":"xydy","explanation":"晓：使人明白。把道理对人讲清楚。","source":{"text":"林时爽误信其中颇有党人，合欲晓以大义。","book":"吴玉章《从甲午战争前后到辛亥革命前后的回忆》第十四篇"},"example":{"text":"王朔《谁比谁傻多少》：“‘应与什么血型的女人结合’以及‘夫妻房事应有节制’之类的既～又循循善诱的科学文章。”"},"usage":"作谓语、定语；用于处事等"},{"id":24936,"word":"晓行夜住","pinyin":"xiǎo xíng yè zhù","abbr":"xxyz","explanation":"白天赶路，晚上投宿。形容旅途奔波劳苦。","source":{"text":"赵旭词毕，作别亲友，起程而行。于路饥餐渴饮，夜住晓行。不则一日，来到东京。","book":"明·冯梦龙《喻世明言》第十一卷"},"example":{"text":"清·文康《儿女英雄传》第19回：“那沿途的～，摆渡过桥，岂是一人能够照料？”"},"similar":["晓行夜宿"],"usage":"作谓语、宾语、定语；形容长途跋涉"},{"id":24937,"word":"晓行夜宿","pinyin":"xiǎo xíng yè sù","abbr":"xxys","explanation":"晓：天明。一早起来赶路，到夜里才住宿下来。形容旅途奔波劳苦。","source":{"text":"但愿你晓行晚宿无辞惮。","book":"元·郑廷玉《楚昭公》第一折"},"example":{"text":"庄昭光从水路过了黄河，雇了一辆车，～，一路来到山东地方。","book":"清·吴敬梓《儒林外史》第三十四回"},"similar":["晓行夜住"],"opposite":["游山玩水"],"usage":"作谓语、宾语、定语；形容长途跋涉"},{"id":24938,"word":"晓风残月","pinyin":"xiǎo fēng cán yuè","abbr":"xfcy","explanation":"拂晓风起，残月将落。常形容冷落凄凉的意境。也指歌妓的清唱。","source":{"text":"今宵酒醒何处，杨柳岸，晓风残月。","book":"宋·柳永《雨霖铃》词"},"example":{"text":"今日红梅之下，梨园可省，倒少不了一声“～”哩。","book":"清·孔尚任《桃花扇》第二十一出"},"similar":["青灯古佛"],"opposite":["繁花闹市"],"usage":"作主语、宾语；形容冷落清凉的意境"},{"id":24939,"word":"晕头转向","pinyin":"yūn tóu zhuàn xiàng","abbr":"ytzx","explanation":"晕：头发昏；转向：辨不清方向。头脑发晕，辨不清方向。形容糊里糊涂或惊惶失措。","source":{"text":"巧珠奶奶听得晕头转向。完全出乎他的意料，儿子居然变了，而且变得这么快！","book":"周而复《上海的早晨》第三部"},"example":{"text":"我被你整得～。"},"similar":["昏头昏脑"],"opposite":["头脑清醒"],"usage":"作谓语、定语、状语、补语；用于人"},{"id":24940,"word":"晕晕乎乎","pinyin":"yūn yūn hū hū","abbr":"yyhh","explanation":"指头脑不清醒。","source":{"text":"越走近她们，我脑袋里越是晕晕乎乎的。","book":"余华《活着》"},"similar":["晕晕忽忽"],"usage":"作宾语、定语、状语；用于口语"},{"id":24941,"word":"晕晕忽忽","pinyin":"yūn yūn hū hū","abbr":"yyhh","explanation":"指人头脑不清醒。","example":{"text":"我已经喝得～了。"},"opposite":["清清楚楚"],"usage":"作定语、状语；指头脑不清醒"},{"id":24942,"word":"晕晕沉沉","pinyin":"yūn yūn chén chén","abbr":"yycc","explanation":"形容眩晕而神志不清。"},{"id":24943,"word":"晖光日新","pinyin":"huī guāng rì xīn","abbr":"hgrx","explanation":"指进德修业不懈，日日更新。","source":{"text":"苟日新，日日新，又日新。","book":"《孟子·尽心下》：“充实而有光辉之谓大。”《易·系辞上》：“日新之谓盛德。”《礼记·大学》"},"example":{"text":"进德修业，～。","book":"晋张华《励志》诗"},"similar":["辉光日新"],"usage":"作分句；指人的学业等"},{"id":24944,"word":"晚生后学","pinyin":"wǎn shēng hòu xué","abbr":"wshx","explanation":"泛指学习同一技艺或同一学问的后生晚辈。","source":{"text":"梁室乱离，天下糜沸，书史残缺，礼乐崩沦，晚生后学，匪无墙面，卓尔出群，斯人而已。","book":"唐·姚思廉《陈书·陆瑜传》"},"example":{"text":"是知翼之书固自超绝，［庾翼］其为当日书家名流所推先如此，其自许亦自高，要是，其所得非～浅浅所能追逐也。","book":"《宣和书谱·庾翼》"},"similar":["晚生末学"],"usage":"作主语、宾语、定语；多用于自谦"},{"id":24945,"word":"晚生末学","pinyin":"wǎn shēng mò xué","abbr":"wsmx","explanation":"指书生的自谦。","source":{"text":"晚生末学，虽窃慕之，而愧非其人。","book":"清·荑荻散人《玉娇梨》第18回"},"example":{"text":"～，‘巴人下里’之词，只好涂饰闾里，怎敢陈于老太师山斗之下。","book":"清·荻岸山人《平山冷燕》第17回"},"usage":"作主语、宾语、定语；用于自谦"},{"id":24946,"word":"晚节不保","pinyin":"wǎn jíe bù bǎo","abbr":"wjbb","explanation":"晚节：指晚年的节操。已经到了晚年却未能保住自己的节操。也指事情快成功的时候却失败了。","source":{"text":"愿坚晚节于岁寒。","book":"宋·杨万里《清虚子此君轩赋》"},"example":{"text":"有些节操高尚的人，晚年时倒未能经受住考验，～，弄得身败名裂。"},"similar":["晚节不终"],"usage":"作谓语、定语、宾语；用于处事"},{"id":24947,"word":"晚节不终","pinyin":"wǎn jié bù zhōng","abbr":"wjbz","explanation":"晚节：指晚年的节操。指到了晚年却不能保持节操。","source":{"text":"疏论都御史吴时来晚节不终，不当谥忠恪。","book":"《明史·于孔兼传》"},"example":{"text":"但这也不过白圭之玷，并非～。","book":"鲁迅《且介亭杂文末编·关于太炎先生二三事》"},"similar":["晚节不保"],"usage":"作谓语、定语、宾语；用于处事"},{"id":24948,"word":"晚节末路","pinyin":"wǎn jié mò lù","abbr":"wjml","explanation":"末世；一代将终之时。","source":{"text":"他日若获宁瘳，顾虽晚节末路，尚知补报，惟所驱策，岂敢辞免？","book":"汉·邹阳《上书吴王》：“至其晚节末路，张耳、陈胜连从兵之据，以叩函关，咸阳遂危。”宋·王安石《乞宫观札子五则》之四"},"example":{"text":"死生祸福，相去有差，～，共此叹嗟。","book":"宋·陈亮《祭彭子复父文》"},"usage":"作宾语、定语；用于书面语"},{"id":24949,"word":"晚节黄花","pinyin":"wǎn jié huáng huā","abbr":"wjhh","explanation":"黄花：菊花；晚节：晚年的节操。比喻人晚节高尚。","source":{"text":"莫嫌老圃秋容淡，且看寒花晚节香。","book":"宋·韩琦《九日小阁》诗"},"example":{"text":"须信苦尽甘来，～无既。","book":"明·王世贞《鸣凤记》第三十八出"},"usage":"作主语、宾语；指人晚节高尚"},{"id":24950,"word":"晚食当肉","pinyin":"wǎn shí dàng ròu","abbr":"wsdr","explanation":"饿了再吃，味道就象吃肉一样。后泛指不热衷名利。","source":{"text":"晚食以当肉，安步以当车。","book":"《战国策·齐策四》"},"usage":"作宾语、定语；指不热衷名利"},{"id":24951,"word":"晦盲否塞","pinyin":"huì máng pǐ sè","abbr":"hmps","explanation":"国政混乱，下情不能上达。","source":{"text":"晦盲否塞，反覆沉痼，以及五季之衰，而坏乱极矣。","book":"宋·朱熹《大学章句序》"}},{"id":24952,"word":"晦迹韬光","pinyin":"huì jì tāo guāng","abbr":"hjtg","explanation":"晦、韬：隐藏；迹：踪迹；光：指才华。指将自己的才华隐藏起来，不使外露。","source":{"text":"粤若高祖文皇帝，诞圣降灵则赤光照室，韬神晦迹则紫气腾天。","book":"《隋书·薛道衡传》"},"example":{"text":"～为隐居，结茅成舍自耕锄。","book":"明·无名氏《太平宴》第一折"},"similar":["韬光晦迹"],"opposite":["锋芒毕露"],"usage":"作谓语；指隐藏才华"},{"id":24953,"word":"晨光熹微","pinyin":"chén guāng xī wēi","abbr":"cgxw","explanation":"熹微：天色微明。早上天色微明。","source":{"text":"问征夫以前路，恨晨光之熹微。","book":"晋·陶潜《归去来辞》"},"example":{"text":"未几雄鸡报晓，～，大家立即起床，动身上路。"},"usage":"作宾语、定语；指早上天色微明"},{"id":24954,"word":"晨兢夕厉","pinyin":"chén jīng xī lì","abbr":"cjxl","explanation":"兢，小心谨慎；厉，严格。指终日勤勉谨慎。","source":{"text":"朕以眇疚，未弘政道，囹圄尚繁，枉滞犹积，晨兢夕厉，每恻于怀。","book":"《宋书·袁粲传》"},"usage":"作谓语、宾语；用于处世"},{"id":24955,"word":"晨兴夜寐","pinyin":"chén xīng yè mèi","abbr":"cxym","explanation":"兴：起。早起晚睡。形容勤劳辛苦。","source":{"text":"故勉精历操，晨兴夜寐不遑宁息，经之以岁月，累之以日力。","book":"《三国志·吴书·韦曜传》"},"example":{"text":"生不忍以家政累之，仍欲自任，女又不肯。～，经纪弥勤。","book":"清·蒲松龄《聊斋志异·细柳》"},"similar":["起早贪黑"],"usage":"作状语；形容整日勤劳辛苦"},{"id":24956,"word":"晨参暮省","pinyin":"chén cān mù shěng","abbr":"ccms","explanation":"按礼节朝暮参拜问安。","source":{"text":"夫人既去，王乃难留。便使嫔妃，相随至舍。莫不晨参暮省，送药送茶。","book":"《敦煌变文集·欢喜国王缘》"},"similar":["晨参暮礼","晨昏定省"],"usage":"作宾语、定语；指礼节"},{"id":24957,"word":"晨参暮礼","pinyin":"chén cān mù lǐ","abbr":"ccml","explanation":"指早晚参拜。","source":{"text":"从今日起，那有心弹琴讲书，只索每日晨参暮礼，将此香囊供养者。","book":"元·郑光祖《梅香》第一折"},"similar":["暮礼晨参","朝参暮礼"],"usage":"作谓语、宾语、定语；用于交往"},{"id":24958,"word":"晨提夕命","pinyin":"chén tí xī mìng","abbr":"ctxm","explanation":"犹言朝夕教诲。","source":{"text":"子龙得备吏于越，得侍先生左右，晨提夕命者且三载，又岂易遇哉！","book":"明·陈子龙《应本序》"},"usage":"作宾语、定语；用于教诲等"},{"id":24959,"word":"晨昏定省","pinyin":"chén hūn dìng xǐng","abbr":"chdx","explanation":"晚间服侍就寝，早上省视问安。旧时侍奉父母的日常礼节。","source":{"text":"凡为人子之礼，冬温而夏清，昏定而晨省。","book":"《礼记·曲礼上》"},"example":{"text":"不但将亲戚朋友一概杜绝了，而且连家庭中～，一发都随他的便了。","book":"清·曹雪芹《红楼梦》第三十六回"},"similar":["昏定晨省","晨参暮礼","晨参暮省"],"usage":"作谓语、定语；指子女慰问父母"},{"id":24960,"word":"晨炊星饭","pinyin":"chén chuī xīng fàn","abbr":"ccxf","explanation":"清晨烧早饭，入夜才吃晚饭。形容早出晚归，整日辛勤劳苦。","source":{"text":"又役鬼不可，唯人是营，通计工匠，率多贫窭，,朝驱暮役，劳筋苦骨，箪食瓢饮，晨炊星饭，饥渴所致，疾疹交集。","book":"《旧唐书·张廷珪传》"},"similar":["早出晚归"],"usage":"作宾语、定语；用于生活等"},{"id":24961,"word":"晨秦暮楚","pinyin":"chén qín mù chǔ","abbr":"cqmc","explanation":"犹言朝秦暮楚。比喻反复无常。","source":{"text":"乃游士之失守者，唯恐不得为臣而蚤定臣礼，于是晨秦暮楚，无国而不为臣，无君而非其君。","book":"清·王夫之《读四书大全说·孟子·公丑下二》"},"similar":["朝秦暮楚"],"usage":"作谓语、定语；比喻反复无常"},{"id":24962,"word":"晨钟暮鼓","pinyin":"chén zhōng mù gǔ","abbr":"czmg","explanation":"暮：傍晚。佛教规矩，寺里晚上打鼓，晚上敲钟。比喻可以使人警觉醒悟的话。","source":{"text":"朝钟暮鼓不到耳，明月孤云长挂情。","book":"唐·李咸用《山中》诗"},"example":{"text":"但见丹霞翠壁远近映楼阁，～杳霭罗幡幢。","book":"宋·欧阳修《庐山高》诗"},"similar":["暮鼓晨钟"],"usage":"作主语、宾语、定语；比喻令人警悟的话","story":["洛阳附近龙门石窟始建于北魏孝文帝，在长约一公里山崖上，共雕刻佛像近十万尊，艺术水平最高的是奉先寺，寺内供奉的是卢舍那佛，高17米。杜甫作《游龙门奉先寺》描写僧侣的晨钟暮鼓生活：“天阙象纬逼，云卧衣裳冷。欲觉闻晨钟，令人发深省。”"]},{"id":24963,"word":"晨风零雨","pinyin":"chén fēng líng yǔ","abbr":"cfly","explanation":"晨风：即鹯，一种猛禽。形容亲友离散，天各一方。","source":{"text":"我来自东，零雨其蒙。","book":"《诗经·国风·秦风·晨风》：“鴥彼晨风，郁彼北林。未见君子，忧心钦钦。”又《诗经·国风·豳风·东山》"},"example":{"text":"天涯兄弟，晨夕过从，谊同手足，一旦～，天各一方，人孰无情，能不蕴结？","book":"清·王士慎《将出都与茗文》"}},{"id":24964,"word":"晬面盎背","pinyin":"zuì miàn àng bèi","abbr":"zmab","explanation":"指德性表现于外，而有温润之貎，敦厚之态。指有德性者的仪态。","source":{"text":"君子所性，仁义利智根于心。其生色也，晬然见于面，盎于背，施于四体，四体不言而喻。","book":"语出《孟子·尽心上》"},"example":{"text":"～，阳发其华，归根复命，阴结其根也。","book":"宋·袁甫《马实夫君子堂记》"},"usage":"作宾语、定语；指有德之人"},{"id":24965,"word":"普天之下","pinyin":"pǔ tiān zhī xià","abbr":"ptzx","explanation":"指整个天下；遍天下。","source":{"text":"溥天之下，莫非王土；率土之滨，莫非王臣。","book":"《诗经·小雅·北山》"},"example":{"text":"～，我当真拿不出的物事却也不多，你尽管狮子大开口便了。","book":"金庸《天龙八部》第五十章"},"usage":"作宾语、定语；指整个天下"},{"id":24966,"word":"普天之下，莫非王土","pinyin":"pǔ tiān zhī xià，mò fēi wáng tǔ","abbr":"ptzxmfwt","explanation":"普：普遍，全。苍天之下都是天子的辖地。指大一统思想。","source":{"text":"故《诗》曰：‘普天之下，莫非王土；率土之滨，莫非王臣。’","book":"春秋·鲁·左丘明《左传·昭公七年》"},"example":{"text":"～；率土之滨，莫非王臣。","book":"汉·司马相如《难蜀父老》"},"similar":["溥天之下，莫非王土"],"usage":"作宾语、定语；用于书面语"},{"id":24967,"word":"普天匝地","pinyin":"pǔ tiān zā dì","abbr":"ptzd","explanation":"满天遍地，普天下。","source":{"text":"百尺竿头更移步，普天匝地生清风。","book":"元·耶律楚材《和南质张学士敏之见赠》诗"},"example":{"text":"举起如来一卷经，～放光辉。","book":"《药师本愿功德宝卷》"},"usage":"作宾语、定语；用于书面语"},{"id":24968,"word":"普天同庆","pinyin":"pǔ tiān tóng qìng","abbr":"pttq","explanation":"天下的人或全国的人共同庆祝。","source":{"text":"今溥（普）天同庆而卿最留迟，何也？","book":"《三国志·魏书·郭淮传》"},"example":{"text":"大街上搭起几坐彩坊，中间还有四个字道：“～”，据说这算是过年。","book":"鲁迅《华盖集续编·杂论管闲事·做学问·灰色等》"},"similar":["额手称庆","拍手称快"],"opposite":["哀鸿遍野","怨声载道"],"usage":"作谓语、宾语、分句；指国家有喜事"},{"id":24969,"word":"普天率土","pinyin":"pǔ tiān shuài tǔ","abbr":"ptst","explanation":"普天：整个天下；率土：指四海之内。指全中国或全世界。","source":{"text":"溥天之下，莫非王土；率土之滨，莫非王臣。","book":"《诗·小雅·北山》"},"example":{"text":"～，各以其职。","book":"汉·班固《明堂》诗"},"similar":["溥天率土"],"usage":"作宾语、定语；指全中国或全世界"},{"id":24970,"word":"普度众生","pinyin":"pǔ dù zhòng shēng","abbr":"pdzs","explanation":"佛家语，认为大众营营扰扰，如溺海中，佛以慈悲为怀，施宏大法力，尽力救济他们以便登上彼岸。","source":{"text":"普欲度脱一切众生。","book":"《佛说无量寿经》"},"example":{"text":"丈六金身，能变能化，无大无不大，无通无不通，～，号作天人师。","book":"明·冯梦龙《警世通言》卷四十"},"similar":["普渡众生"],"usage":"作谓语、定语；形容佛家子弟"},{"id":24971,"word":"普度群生","pinyin":"pǔ dù qún shēng","abbr":"pdqs","explanation":"佛教语。指广济一切生死苦海中的众生。","source":{"text":"讲经说法，广开方便之门；普度群生，接引菩提之路。","book":"明·冯梦龙《警世通言·吕洞宾飞剑斩黄龙》"},"similar":["普度众生"],"usage":"作谓语、定语；形容佛家子弟"},{"id":24972,"word":"普普通通","pinyin":"pǔ pǔ tōng tōng","abbr":"pptt","explanation":"指平常的，一般的。","source":{"text":"他一个普普通通的庄稼人，能有多少本事呢！","book":"路遥《平凡的世界》第一卷第十章"},"example":{"text":"不老实，也不浮滑，～，是不是呢？","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["平平常常"],"opposite":["出类拔萃"],"usage":"作定语、状语；用于口语"},{"id":24973,"word":"普济众生","pinyin":"pǔ jì zhòng shēng","abbr":"pjzs","explanation":"佛家语，认为大众营营扰扰，如溺海中，佛以慈悲为怀，施宏大法力，尽力救济他们以便登上彼岸。也泛指救济帮助群众。","source":{"text":"应即往精舍中，见竺昙境。镜曰：‘普济众生，但君当一心受持耳。’","book":"《辩证论》"},"similar":["普济群生"],"usage":"作谓语、定语、宾语；用于佛教等"},{"id":24974,"word":"普济群生","pinyin":"pǔ jì qún shēng","abbr":"pjqs","explanation":"佛家语，认为大众营营扰扰，如溺海中，佛以慈悲为怀，施宏大法力，尽力救济他们以便登上彼岸。同“普度众生”。","source":{"text":"应即往精舍中，见竺昙境。镜曰：‘普济众生，但君当一心受持耳。’","book":"宋·李昉《太平广记》卷一百六十一引《辨证论》"},"example":{"text":"九幽拔苦消灾障，～佑下方。","book":"明·无名氏《庆长生》第一折"},"similar":["普济众生"],"usage":"作谓语、定语、宾语；用于佛教等"},{"id":24975,"word":"普渡众生","pinyin":"pǔ dù zhòng shēng","abbr":"pdzs","explanation":"众生：指一切有生命的动物及人。佛教语。普遍引渡所有的人，使他们脱离苦海，登上彼岸。","source":{"text":"丈六金身，能变能化，无大无不大，无通无不通，普渡众生，号作无人师。","book":"明·冯梦龙《警世通言》"},"example":{"text":"所谓文学上的人道主义，当然不是庸俗的～，也不是惩恶劝善。","book":"孙犁《秀露集·文学和生活的路》"},"similar":["救苦救难","博施济众"],"opposite":["乘人之危","趁火打劫","落井下石"],"usage":"作谓语、定语；形容佛家子弟"},{"id":24976,"word":"景从云集","pinyin":"yǐng cóng yún jí","abbr":"jcyj","explanation":"景：同“影”。如影随形，如云聚集。形容很快聚集了许多追逐者","source":{"text":"且天下诸侯景从云集，随大王以伐无道，其爱戴之心，盖有自也。","book":"明·许仲琳《封神演义》第98回"},"example":{"text":"清·洪昇《长生殿·收京》：“佐中兴昇平泰运，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":24977,"word":"景入桑榆","pinyin":"jǐng rù sāng yú","abbr":"jrsy","explanation":"比喻垂老之年。","source":{"text":"年在桑榆间，影响不能追。","book":"《淮南子·天文训》：“日西垂，景在树端，谓之桑榆。”三国·魏·曹植《赠白马王彪》诗"},"example":{"text":"孩儿只因老身～，他又身多疾病，故此不能从征。","book":"清·褚人获《隋唐演义》第三十七回"}},{"id":24978,"word":"景公求雨","pinyin":"jǐng gōng qiú yǔ","abbr":"jgqy","explanation":"祈求龙王降雨的迷信活动。比喻统治者体恤民情，顺应民意。","source":{"text":"于是景公出野暴露。三日，天果大雨，民尽得种时。","book":"春秋·齐·晏婴《晏子春秋·内篇谏上》"},"example":{"text":"领导干部应该学习～，体恤民情。"},"usage":"作宾语、定语；指不能脱离群众","story":["春秋时期，齐国发生大旱，百姓错过播种季节。齐景公召集群臣商议加赋求雨之事，晏子坚决反对景公求山神与河伯这些没用的神鬼，要他亲自走出宫去与百姓一道抗旱。景公听从晏子的话，来到荒野察看民情，三天后终于下起了大雨来"]},{"id":24979,"word":"景升豚犬","pinyin":"jǐng shēng tún quǎn","abbr":"jstq","explanation":"景升，东汉末年荆州牧刘表字。表与其子琦琮皆碌碌无为。故世人用“景升豚犬”谦称自己的子女。","source":{"text":"生子当如孙仲谋，刘景升儿子若豚犬耳！","book":"《吴历》"},"example":{"text":"诞而待孕者，尚不一其人，虽尽属～，然得此以慰桑榆，不忧穷民之无告矣！","book":"清·李渔《闲情偶寄·词曲·结构》"},"usage":"作宾语、定语；用于自谦","story":["东汉末年，曹操率军进攻东吴，孙权亲率7万军队迎战，曹操打了败仗就屯兵江北不出战，孙权乘船刺探军情，曹操见孙权军纪严明，感慨地说：“生子当如孙仲谋，刘表的儿子不过像猪狗罢了。”双方对峙一月，曹操就撤军回北方"]},{"id":24980,"word":"景星凤凰","pinyin":"jǐng xīng fèng huáng","abbr":"jxfh","explanation":"传说太平之世才能见到景星和凤凰。后用以比喻美好的事物或杰出的人才。同“景星凤皇”。","source":{"text":"景星凤凰，以见为宠。","book":"宋·苏轼《梦作司马相如求画赞》"},"example":{"text":"学者仰之，如～，争先见之为快。","book":"《宣和书谱·隶书叙论》"},"similar":["景星凤皇"],"usage":"作宾语、定语；用于比喻句"},{"id":24981,"word":"景星凤皇","pinyin":"jǐng xīng fèng huáng","abbr":"jxfh","explanation":"传说太平之世才能见到景星和凤凰。后用以比喻美好的事物或杰出的人才。","source":{"text":"朝廷之士，引颈东望，若景星凤皇之始见也，争先睹之为快。","book":"唐韩愈《与少室李拾遗书》"},"example":{"text":"景星凤凰，以见为宠。","book":"宋苏轼《梦作司马相如求画赞》"},"similar":["景星麟凤","景星庆云"],"usage":"作宾语、定语；用于比喻句"},{"id":24982,"word":"景星庆云","pinyin":"jǐng xīng qìng yún","abbr":"jxqy","explanation":"比喻吉祥的征兆。庆云，五色云，祥瑞之云。","source":{"text":"惟天不言，以象示人，锡羡垂光，景星庆云。","book":"明方孝孺《御书赞》"},"example":{"text":"有泰山北斗，～之语。清恽敬《答姚秋农书》"},"similar":["景星凤皇","景星麟凤"],"usage":"作宾语、定语；指吉祥的征兆"},{"id":24983,"word":"景星麟凤","pinyin":"jǐng xīng lín fèng","abbr":"jxlf","explanation":"犹言景星凤凰。比喻杰出的人才。","source":{"text":"朝廷之士，引颈东望，若景星凤皇之始见也，争先睹之为快。","book":"唐·韩愈《与少室李拾遗书》"},"example":{"text":"恕自京还，家居十三年，缙绅望之若～，乡里称为先生而不姓。","book":"《元史·周恕传》"},"similar":["景星凤皇","景星庆云"],"usage":"作宾语、定语；用于比喻句"},{"id":24984,"word":"晰毛辨发","pinyin":"xī máo biàn fà","abbr":"xmbf","explanation":"连毛发也能清楚地分辨。形容析理入微。","source":{"text":"圣叹之评《西厢》，可谓晰毛辩发，穷幽极微，无复有遗议于其间矣。","book":"清·李渔《闲情偶寄·词曲·格局》"},"usage":"作宾语、定语；指明辨事理"},{"id":24985,"word":"晴云秋月","pinyin":"qíng yún qiū yuè","abbr":"qyqy","explanation":"晴空飘浮的白云，秋高气爽时的明月。比喻人胸襟高洁明朗。","source":{"text":"与可襟韵洒落，如晴云秋月，尘埃不到。","book":"《宋史·文同传》"},"usage":"作宾语、定语；用于景物或为人"},{"id":24986,"word":"晴天打霹雳","pinyin":"qíng tiān dǎ pī lì","abbr":"qtdpl","explanation":"晴天打响雷。比喻突然发生意外的令人震惊的事件。","source":{"text":"猛听叫喜儿顶租子，好比晴天打霹雳！","book":"贺敬之《白毛女》"},"similar":["晴天霹雳","青天霹雳"],"usage":"作宾语、定语；指令人震惊"},{"id":24987,"word":"晴天霹雳","pinyin":"qíng tiān pī lì","abbr":"qtpl","explanation":"霹雳：响雷。晴天打响雷。比喻突然发生意外的，令人震惊的事件。","source":{"text":"放翁病过秋，忽起作醉墨。正如久蛰龙，青天飞霹雳。","book":"宋·陆游《四日夜鸡未鸣起作》诗"},"example":{"text":"猝闻这信，真是～，人人裂目，个个椎心。","book":"清·曾朴《孽海花》第十七回"},"similar":["祸从天降","晴天打霹雳"],"opposite":["司空见惯"],"usage":"作主语、宾语、定语；指令人震惊"},{"id":24988,"word":"晴空万里","pinyin":"qíng kōng wàn lǐ","abbr":"qkwl","explanation":"晴空：晴朗的天空。形容天空晴朗，没有一点云彩。","source":{"text":"这里却像中国仲秋的天气，秋高气爽，晴空万里。","book":"曹靖华《碧海墨林油香飘》"},"example":{"text":"天气十分好，～。"},"similar":["碧空万里"],"usage":"作谓语、定语；指晴朗天气"},{"id":24989,"word":"智以利昏","pinyin":"zhì yǐ lì hūn","abbr":"zylh","explanation":"智：理智；昏：昏乱，神智不清。因贪图私利而失去理智，把什么都忘了。","source":{"text":"机过患生，吉凶相拂；智以利昏，识由情屈。","book":"晋·孙绰《答许询诗》其二"}},{"id":24990,"word":"智出乎争","pinyin":"zhì chū hū zhēng","abbr":"zchz","explanation":"争：斗争。聪明才智是在反复斗争中锻炼出来的。比喻智慧来源于实践。","source":{"text":"德荡乎名，知出乎争。名也者，相轧也；知也者，争之器也。","book":"《庄子·人间世》"}},{"id":24991,"word":"智勇兼全","pinyin":"zhì yǒng jiān quán","abbr":"zyjq","explanation":"既有智谋，又有勇气，二者兼备。","source":{"text":"我一向颇有窥西京之意，叵耐杨素那老儿威名甚重，智勇兼全，故此掩甲收兵，未遂所愿。","book":"明·张凤翼《红拂记·奸宄觊觎》"},"example":{"text":"若得似二位兄长这样～的出来，倡义领众，四方之人，自然闻风响应。","book":"清·褚人获《隋唐演义》第三十七回"},"similar":["智勇双全"],"opposite":["有勇无谋"],"usage":"作谓语、定语；指人的个性"},{"id":24992,"word":"智勇兼备","pinyin":"zhì yǒng jiān bèi","abbr":"zyjb","explanation":"形容人既有智谋，又很勇敢。","source":{"text":"段孝先忠亮仁厚，智勇兼备，亲戚之中，唯有此子，军旅大事，宜共筹之。","book":"《北齐书·段韶传》"},"example":{"text":"此女独从容就义，～，即史册亦仅见。（明·沈德符《万历野获编·妇女》）"},"similar":["智勇兼全","智勇双全"],"opposite":["有勇无谋"],"usage":"作谓语、定语；指人的个性"},{"id":24993,"word":"智勇双全","pinyin":"zhì yǒng shuāng quán","abbr":"zysq","explanation":"又有智谋，又很勇敢。","source":{"text":"某文通三略，武解六韬，智勇双全 。","book":"元·关汉卿《五侯宴》第三折"},"example":{"text":"要讲究策略，有勇有谋，～。"},"similar":["大智大勇"],"opposite":["有勇无谋"],"usage":"作谓语、定语；指人的个性"},{"id":24994,"word":"智名勇功","pinyin":"zhì míng yǒng gōng","abbr":"zmyg","explanation":"有谋略、有胆量和功夫。形容人文武兼备。","source":{"text":"子房计谋其事，无知名，无勇功。","book":"《史记·太史公自序》"},"example":{"text":"～不入眼，可用折箠笞羌胡。（宋·黄庭坚《送范德孺知庆州》）"},"usage":"作宾语、定语；用于书面语"},{"id":24995,"word":"智周万物","pinyin":"zhì zhōu wàn wù","abbr":"zzww","explanation":"天下万物无所不知。形容知识渊博。","source":{"text":"知周乎万物而道济天下。","book":"《周易·系辞上》"},"example":{"text":"道洽十方，～。","book":"唐·辩机《赞》"},"usage":"作谓语、定语；指有学问"},{"id":24996,"word":"智圆行方","pinyin":"zhì yuán xíng fāng","abbr":"zyxf","explanation":"圆：圆满，周全；方：端正，不苟且。知识要广博周备，行事要方正不苟。","source":{"text":"老子曰：凡人之道，心欲小，志欲大；智欲圆，行欲方。","book":"《文子·微明》"},"example":{"text":"维公之德，～，忠不近名，言不泥常。","book":"明·张居正《襄毅杨公墓志铭》"},"similar":["智欲圆而行欲方"],"usage":"作谓语、定语；指人洒脱"},{"id":24997,"word":"智均力敌","pinyin":"zhì jūn lì dí","abbr":"zjld","explanation":"指双方的智略或势力旗鼓相当。","source":{"text":"假使权亲与蜀贼相持，搏战旷日，智均力敌，兵不速决，当须军兴以成其势者，然后宜选持重之将，承寇贼之要，相时而后动，择地而后行，一举更无余事。","book":"《三国志·魏书·王朗传》"},"example":{"text":"《宣和书谱·行书·虞世南》：“当时与欧阳询皆以书称，议者以谓欧之与虞～。”"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":24998,"word":"智小言大","pinyin":"zhì xiǎo yán dà","abbr":"zxyd","explanation":"指才智低下，说话口气却很大。","source":{"text":"君集智小言大，举止不伦，以臣观之，必为戎首。","book":"《旧唐书·江夏王道宗传》"},"similar":["知小言大"],"usage":"作谓语、定语；用于书面语"},{"id":24999,"word":"智小谋大","pinyin":"zhì xiǎo móu dà","abbr":"zxmd","explanation":"指能力低下而谋划很大。","source":{"text":"宇文夏州才略冠世，德义可宗。侯英陈公智小谋大，岂能自保。","book":"《晋书·庾亮传论》：“智小谋大，昧经邦之远图；才高识寡，阙安国之长算。”《周书·李弼传》"},"example":{"text":"《周书·李弼传》：“侯英陈公～，岂能自保。”"},"similar":["知小谋大"],"usage":"作谓语、定语；用于书面语"},{"id":25000,"word":"智尽力穷","pinyin":"zhì jìn lì qióng","abbr":"zjlq","explanation":"智慧和能力都已用尽。","source":{"text":"世充得地虽多，率皆羁属，号令所行，唯洛阳一城而已，智尽力穷，克在朝夕。今若旋师，贼势复振，更相连接，后必难图！","book":"《资治通鉴·唐纪·高祖武德四年》"},"example":{"text":"这天空中又接连霪雨，淋漓了三四十日，弓脱胶，箭离干，马乏刍，弄得～，无法可施。（蔡东藩《明史演义》第九十四回）"},"similar":["智尽能索","知尽能索"],"usage":"作谓语、定语；指没办法了"}]
